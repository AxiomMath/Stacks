module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.SymmetricAlgebraGrading

/-!
# The symmetric algebra is generated in degree one

`Sym_R(M)` is generated as an algebra over its degree-zero part `Sym⁰_R(M)` by its degree-one
part `Sym¹_R(M) = M`. This is immediate from the induction principle for the symmetric algebra:
a scalar lies in the degree-zero part, a generator in the degree-one part, and the subalgebra
generated by the latter is closed under sums and products.

Degree-one generation is the hypothesis under which the geometry of `Proj` of a graded ring is
accessible — it is what makes the standard opens of the degree-one elements cover `Proj`, and
hence what `AlgebraicGeometry.ProjectiveSpectrum.Proj.span_degreeOne_eq_irrelevant` and
`AlgebraicGeometry.ProjectiveSpectrum.Proj.degreeSection_eq_zero_of_annihilating_degree` ask
for. This file supplies it for the symmetric algebra, so that `Proj(Sym_R(M))` can be worked
with for an arbitrary module `M`.

## Main results

* `SymmetricAlgebra.adjoin_symmetricPower_one_eq_top`: `Sym_R(M)` is generated by `Sym¹_R(M)`
  over `Sym⁰_R(M)`.

## References

* [Stacks Project, Section 17.21](https://stacks.math.columbia.edu/tag/01CF)
* [Stacks Project, Tag 01CH](https://stacks.math.columbia.edu/tag/01CH)
-/

@[expose] public section

namespace SymmetricAlgebra

variable (R M : Type*) [CommRing R] [AddCommGroup M] [Module R M]

/-- **The symmetric algebra is generated in degree one**: `Sym_R(M)` is generated as an algebra
over `Sym⁰_R(M)` by `Sym¹_R(M)`. -/
theorem adjoin_symmetricPower_one_eq_top :
    Algebra.adjoin (SymPow.symmetricPower 0 R M)
      (SymPow.symmetricPower 1 R M : Set (SymmetricAlgebra R M)) = ⊤ := by
  refine Algebra.eq_top_iff.mpr fun x => ?_
  induction x using SymmetricAlgebra.induction with
  | algebraMap r =>
      have h : algebraMap R (SymmetricAlgebra R M) r ∈ SymPow.symmetricPower 0 R M := by
        rw [SymPow.symmetricPower, pow_zero, Submodule.one_eq_range]
        exact ⟨r, rfl⟩
      exact Subalgebra.algebraMap_mem _ (⟨_, h⟩ : SymPow.symmetricPower 0 R M)
  | ι m =>
      refine Algebra.subset_adjoin ?_
      rw [SetLike.mem_coe, SymPow.symmetricPower, pow_one]
      exact LinearMap.mem_range_self _ m
  | mul a b ha hb => exact mul_mem ha hb
  | add a b ha hb => exact add_mem ha hb

end SymmetricAlgebra

end
