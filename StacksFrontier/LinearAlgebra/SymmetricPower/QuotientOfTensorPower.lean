module

public import Mathlib.Algebra.DirectSum.Module
public import Mathlib.Algebra.Exact.Basic
public import Mathlib.Algebra.Module.Submodule.Bilinear
public import Mathlib.GroupTheory.Perm.Sign
public import Mathlib.LinearAlgebra.ExteriorPower.Basic
public import Mathlib.LinearAlgebra.Multilinear.Curry
public import Mathlib.LinearAlgebra.TensorPower.Basic
public import Mathlib.LinearAlgebra.TensorPower.Symmetric

/-!
# Exterior and symmetric powers as quotients of the tensor power

Let `R` be a ring, `M` an `R`-module, and `xᵢ`, `i ∈ I`, a system of generators
of `M`. Let `n ≥ 2`. There are canonical exact sequences presenting the `n`th
exterior and symmetric powers as quotients of the `n`th tensor power.

For the exterior power:

  `(⊕_{j₁<j₂} ⊕_{i₁,i₂} Tⁿ⁻²(M)) ⊕ (⊕_{j₁<j₂} ⊕_{i} Tⁿ⁻²(M)) → Tⁿ(M) → ⋀ⁿ(M) → 0`

where a pure tensor `m₁ ⊗ ⋯ ⊗ mₙ₋₂` in the first summand (indexed by slots
`j₁ < j₂` and generator indices `i₁, i₂`) maps to the symmetrised relator
`(⋯ x_{i₁} ⋯ x_{i₂} ⋯) + (⋯ x_{i₂} ⋯ x_{i₁} ⋯)` (the `x`'s occupying slots
`j₁, j₂`), and a pure tensor in the second summand (indexed by `j₁ < j₂` and a
single `i`) maps to the diagonal relator `(⋯ x_i ⋯ x_i ⋯)`.

For the symmetric power:

  `(⊕_{j₁<j₂} ⊕_{i₁,i₂} Tⁿ⁻²(M)) → Tⁿ(M) → Symⁿ(M) → 0`

where a pure tensor maps to the antisymmetrised relator
`(⋯ x_{i₁} ⋯ x_{i₂} ⋯) - (⋯ x_{i₂} ⋯ x_{i₁} ⋯)`.

The indices are reindexed `n ↦ n + 2`, so the top power is `n + 2`, ranging over all `n ≥ 2`,
and the source tensor power is `Tⁿ`. The relator-source maps are pinned down by their values on
the spanning pure tensors `⨂ₜ`, and so are the projections (`⨂ₜ ↦ ιMulti` on the exterior side,
`⨂ₜ ↦ ⨂ₛ` on the symmetric side).

Exactness is proved through the universal properties of the two quotients: the relators with
arbitrary elements (rather than generators) in the two slots lie in the span of the given ones
by bilinearity, and every permutation of the slots is a product of transpositions.
-/

@[expose] public section

open TensorProduct

universe u v

/-- Two tensors have the same image in the symmetric power if and only if they are related by the
additive congruence generated by permuting the factors. -/
theorem SymmetricPower.mk_eq_mk_iff {R ι : Type u} [CommSemiring R] {M : Type v} [AddCommMonoid M]
    [Module R M] {x y : ⨂[R] _ : ι, M} :
    SymmetricPower.mk R ι M x = SymmetricPower.mk R ι M y ↔
      addConGen (SymmetricPower.Rel R ι M) x y :=
  AddCon.eq _

section semiring

variable {R : Type*} [CommSemiring R]
variable {M : Type*} [AddCommMonoid M] [Module R M]

/-- The set of ordered pairs of distinct slots `1 ≤ j₁ < j₂ ≤ n + 2`, used to
index the relators. -/
abbrev SlotPair (n : ℕ) : Type := {p : Fin (n + 2) × Fin (n + 2) // p.fst < p.snd}

/-- Insert two values `a, b` into the slots `j₁ < j₂` of an `(n + 2)`-tuple,
filling the remaining `n` slots in order with `f`. Concretely `a` lands at slot
`j₁`, `b` lands at slot `j₂`, and the order-preserving complement carries `f`. -/
def insTwo {n : ℕ} (j₁ j₂ : Fin (n + 2)) (hlt : j₁ < j₂) (a b : M) (f : Fin n → M) :
    Fin (n + 2) → M :=
  Fin.insertNth (α := fun _ => M) j₂ b
    (Fin.insertNth (α := fun _ => M) (j₁.castPred (Fin.ne_last_of_lt hlt)) a f)

section insTwo

variable {n : ℕ} {j₁ j₂ : Fin (n + 2)} {hlt : j₁ < j₂}

section

omit [AddCommMonoid M]

/-- The tuple `insTwo j₁ j₂ hlt a b f` takes the value `b` at slot `j₂`. -/
@[simp]
lemma insTwo_apply_snd (a b : M) (f : Fin n → M) : insTwo j₁ j₂ hlt a b f j₂ = b := by
  unfold insTwo
  exact Fin.insertNth_apply_same _ _ _

/-- The tuple `insTwo j₁ j₂ hlt a b f` takes the value `a` at slot `j₁`. -/
@[simp]
lemma insTwo_apply_fst (a b : M) (f : Fin n → M) : insTwo j₁ j₂ hlt a b f j₁ = a := by
  have := Fin.insertNth_apply_succAbove (α := fun _ => M) j₂ b
    (Fin.insertNth (α := fun _ => M) (j₁.castPred (Fin.ne_last_of_lt hlt)) a f)
    (j₁.castPred (Fin.ne_last_of_lt hlt))
  rw [Fin.succAbove_castPred_of_lt _ _ hlt, Fin.insertNth_apply_same] at this
  unfold insTwo
  exact this

/-- The tuple `insTwo j₁ j₂ hlt a b f` is `insTwo j₁ j₂ hlt a b' f` updated to `b` at slot `j₂`. -/
lemma insTwo_eq_update_snd (a b b' : M) (f : Fin n → M) :
    insTwo j₁ j₂ hlt a b f = Function.update (insTwo j₁ j₂ hlt a b' f) j₂ b := by
  unfold insTwo
  exact (Fin.update_insertNth _ _ _ _).symm

/-- The tuple `insTwo j₁ j₂ hlt a b f` is `insTwo j₁ j₂ hlt a' b f` updated to `a` at slot `j₁`. -/
lemma insTwo_eq_update_fst (a a' b : M) (f : Fin n → M) :
    insTwo j₁ j₂ hlt a b f = Function.update (insTwo j₁ j₂ hlt a' b f) j₁ a := by
  have := Fin.insertNth_update (α := fun _ => M) j₂ b (j₁.castPred (Fin.ne_last_of_lt hlt)) a
    (Fin.insertNth (α := fun _ => M) (j₁.castPred (Fin.ne_last_of_lt hlt)) a' f)
  rw [Fin.succAbove_castPred_of_lt _ _ hlt, Fin.update_insertNth] at this
  unfold insTwo
  exact this

/-- Precomposing `insTwo j₁ j₂ hlt a b f` with the transposition of `j₁` and `j₂` exchanges `a`
and `b`. -/
lemma insTwo_comp_swap (a b : M) (f : Fin n → M) :
    insTwo j₁ j₂ hlt a b f ∘ Equiv.swap j₁ j₂ = insTwo j₁ j₂ hlt b a f := by
  ext k
  rcases eq_or_ne k j₁ with rfl | h₁
  · simp
  rcases eq_or_ne k j₂ with rfl | h₂
  · simp
  rw [Function.comp_apply, Equiv.swap_apply_of_ne_of_ne h₁ h₂, insTwo_eq_update_fst a b,
    Function.update_of_ne h₁, insTwo_eq_update_snd b b a, Function.update_of_ne h₂]

/-- Every `(n + 2)`-tuple `f` is `insTwo j₁ j₂ hlt (f j₁) (f j₂) g` for some `n`-tuple `g`. -/
lemma exists_eq_insTwo (hlt : j₁ < j₂) (f : Fin (n + 2) → M) :
    ∃ g, f = insTwo j₁ j₂ hlt (f j₁) (f j₂) g := by
  refine ⟨(j₁.castPred (Fin.ne_last_of_lt hlt)).removeNth (j₂.removeNth f), ?_⟩
  have h : f j₁ = j₂.removeNth f (j₁.castPred (Fin.ne_last_of_lt hlt)) := by
    rw [Fin.removeNth_apply, Fin.succAbove_castPred_of_lt _ _ hlt]
  rw [insTwo, h, Fin.insertNth_self_removeNth, Fin.insertNth_self_removeNth]

end

variable (R) in
/-- The multilinear map `f ↦ ⨂ₜ (insTwo j₁ j₂ a b f)`. -/
noncomputable def insTwoTprod (j₁ j₂ : Fin (n + 2)) (hlt : j₁ < j₂) (a b : M) :
    MultilinearMap R (fun _ : Fin n => M) (⨂[R]^(n + 2) M) :=
  ((PiTensorProduct.tprod R (s := fun _ : Fin (n + 2) => M)).curryMid j₂ b).curryMid
    (j₁.castPred (Fin.ne_last_of_lt hlt)) a

/-- The value of `insTwoTprod R j₁ j₂ hlt a b` at `f` is `⨂ₜ (insTwo j₁ j₂ hlt a b f)`. -/
@[simp]
lemma insTwoTprod_apply (a b : M) (f : Fin n → M) :
    insTwoTprod R j₁ j₂ hlt a b f = ⨂ₜ[R] k, insTwo j₁ j₂ hlt a b f k := by
  simp [insTwoTprod, insTwo]

variable (R) in
/-- The bilinear map `(a, b) ↦ ⨂ₜ (insTwo j₁ j₂ a b f)`. -/
noncomputable def insTwoBil (j₁ j₂ : Fin (n + 2)) (hlt : j₁ < j₂) (f : Fin n → M) :
    M →ₗ[R] M →ₗ[R] ⨂[R]^(n + 2) M :=
  LinearMap.mk₂ R (fun a b => ⨂ₜ[R] k, insTwo j₁ j₂ hlt a b f k)
    (fun a a' b => by
      rw [insTwo_eq_update_fst (a + a') 0, insTwo_eq_update_fst a 0, insTwo_eq_update_fst a' 0,
        MultilinearMap.map_update_add])
    (fun c a b => by
      rw [insTwo_eq_update_fst (c • a) 0, insTwo_eq_update_fst a 0,
        MultilinearMap.map_update_smul])
    (fun a b b' => by
      rw [insTwo_eq_update_snd a (b + b') 0, insTwo_eq_update_snd a b 0,
        insTwo_eq_update_snd a b' 0, MultilinearMap.map_update_add])
    (fun c a b => by
      rw [insTwo_eq_update_snd a (c • b) 0, insTwo_eq_update_snd a b 0,
        MultilinearMap.map_update_smul])

/-- The value of `insTwoBil R j₁ j₂ hlt f` at `(a, b)` is `⨂ₜ (insTwo j₁ j₂ hlt a b f)`. -/
@[simp]
lemma insTwoBil_apply (f : Fin n → M) (a b : M) :
    insTwoBil R j₁ j₂ hlt f a b = ⨂ₜ[R] k, insTwo j₁ j₂ hlt a b f k := by
  simp [insTwoBil]

end insTwo

/-- A bilinear map sending all pairs of generators into a submodule sends everything there. -/
lemma bilin_mem_of_generators {I N : Type*} [AddCommMonoid N] [Module R N] {x : I → M}
    (hx : Submodule.span R (Set.range x) = ⊤) (B : M →ₗ[R] M →ₗ[R] N) (P : Submodule R N)
    (h : ∀ i k, B (x i) (x k) ∈ P) (a b : M) : B a b ∈ P := by
  have hle : Submodule.map₂ B ⊤ ⊤ ≤ P := by
    rw [← hx, Submodule.map₂_span_span, Submodule.span_le]
    rintro _ ⟨_, ⟨i, rfl⟩, _, ⟨k, rfl⟩, rfl⟩
    exact h i k
  exact hle (Submodule.apply_mem_map₂ _ Submodule.mem_top Submodule.mem_top)

section relators

variable {I : Type*} {x : I → M} {n : ℕ}

/-- A submodule containing the symmetrised and the diagonal relators on generators contains every
pure tensor with two equal entries. -/
lemma tprod_mem_of_apply_eq (hx : Submodule.span R (Set.range x) = ⊤)
    (P : Submodule R (⨂[R]^(n + 2) M))
    (hsym : ∀ (jp : SlotPair n) (i₁ i₂ : I) (g : Fin n → M),
      (⨂ₜ[R] k, insTwo jp.1.1 jp.1.2 jp.2 (x i₁) (x i₂) g k)
        + (⨂ₜ[R] k, insTwo jp.1.1 jp.1.2 jp.2 (x i₂) (x i₁) g k) ∈ P)
    (hdiag : ∀ (jp : SlotPair n) (i : I) (g : Fin n → M),
      (⨂ₜ[R] k, insTwo jp.1.1 jp.1.2 jp.2 (x i) (x i) g k) ∈ P)
    (f : Fin (n + 2) → M) {i j : Fin (n + 2)} (hf : f i = f j) (hij : i ≠ j) :
    (⨂ₜ[R] k, f k) ∈ P := by
  wlog hlt : i < j generalizing i j
  · exact this hf.symm hij.symm (lt_of_le_of_ne (not_lt.1 hlt) hij.symm)
  have hsym' (g : Fin n → M) (a b : M) :
      insTwoBil R i j hlt g a b + insTwoBil R i j hlt g b a ∈ P := by
    simpa using bilin_mem_of_generators hx (insTwoBil R i j hlt g + (insTwoBil R i j hlt g).flip)
      P (fun i₁ i₂ => by simpa using hsym ⟨(i, j), hlt⟩ i₁ i₂ g) a b
  have hdiag' (g : Fin n → M) (a : M) : insTwoBil R i j hlt g a a ∈ P := by
    have ha : a ∈ Submodule.span R (Set.range x) := hx ▸ Submodule.mem_top
    induction ha using Submodule.span_induction with
    | mem _ h =>
      obtain ⟨k, rfl⟩ := h
      simpa using hdiag ⟨(i, j), hlt⟩ k g
    | zero => simp
    | add a a' _ _ ha ha' =>
      have key : insTwoBil R i j hlt g (a + a') (a + a') = insTwoBil R i j hlt g a a
          + insTwoBil R i j hlt g a' a' + (insTwoBil R i j hlt g a a'
            + insTwoBil R i j hlt g a' a) := by
        simp only [map_add, LinearMap.add_apply]
        abel
      rw [key]
      exact P.add_mem (P.add_mem ha ha') (hsym' g a a')
    | smul c a _ ha =>
      simp only [map_smul, LinearMap.smul_apply, smul_smul]
      exact P.smul_mem _ ha
  obtain ⟨g, hg⟩ := exists_eq_insTwo hlt f
  rw [hg, hf]
  simpa using hdiag' g (f j)

end relators

/-- A map out of the tensor power is exact after `Φ` if its kernel lies in the range of `Φ` and it
kills the images of all pure tensors under `Φ`. -/
private theorem exact_of_ker_le_range_of_tprod {ι : Type*} [DecidableEq ι] {n : ℕ}
    {N P : Type*} [AddCommMonoid N] [Module R N] [AddCommMonoid P] [Module R P]
    (Φ : DirectSum ι (fun _ => ⨂[R]^n M) →ₗ[R] N) (π : N →ₗ[R] P)
    (hker : LinearMap.ker π ≤ LinearMap.range Φ)
    (h : ∀ (c : ι) (g : Fin n → M), π (Φ (DirectSum.lof R _ _ c (⨂ₜ[R] k, g k))) = 0) :
    Function.Exact Φ π := by
  rw [LinearMap.exact_iff]
  exact le_antisymm hker (LinearMap.range_le_ker_iff.2 (DirectSum.linearMap_ext R fun c =>
    PiTensorProduct.ext (MultilinearMap.ext fun g => h c g)))

end semiring

section ring

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
variable {I : Type*} {x : I → M} {n : ℕ}

/-- A submodule containing the antisymmetrised relators on generators contains the difference of
every pure tensor and its permutation. -/
lemma tprod_sub_tprod_perm_mem (hx : Submodule.span R (Set.range x) = ⊤)
    (P : Submodule R (⨂[R]^(n + 2) M))
    (hanti : ∀ (jp : SlotPair n) (i₁ i₂ : I) (g : Fin n → M),
      (⨂ₜ[R] k, insTwo jp.1.1 jp.1.2 jp.2 (x i₁) (x i₂) g k)
        - (⨂ₜ[R] k, insTwo jp.1.1 jp.1.2 jp.2 (x i₂) (x i₁) g k) ∈ P)
    (e : Equiv.Perm (Fin (n + 2))) (f : Fin (n + 2) → M) :
    (⨂ₜ[R] k, f k) - (⨂ₜ[R] k, f (e k)) ∈ P := by
  have hlt_swap (f : Fin (n + 2) → M) {i j : Fin (n + 2)} (hlt : i < j) :
      (⨂ₜ[R] k, f k) - (⨂ₜ[R] k, f (Equiv.swap i j k)) ∈ P := by
    obtain ⟨g, hg⟩ := exists_eq_insTwo hlt f
    have hmem := bilin_mem_of_generators hx
      (insTwoBil R i j hlt g - (insTwoBil R i j hlt g).flip) P
      (fun i₁ i₂ => by simpa using hanti ⟨(i, j), hlt⟩ i₁ i₂ g) (f i) (f j)
    have hsw (k : Fin (n + 2)) : insTwo i j hlt (f i) (f j) g (Equiv.swap i j k)
        = insTwo i j hlt (f j) (f i) g k :=
      congrFun (insTwo_comp_swap (f i) (f j) g) k
    rw [hg]
    simpa [hsw] using hmem
  have hswap (f : Fin (n + 2) → M) {i j : Fin (n + 2)} (hij : i ≠ j) :
      (⨂ₜ[R] k, f k) - (⨂ₜ[R] k, f (Equiv.swap i j k)) ∈ P := by
    rcases lt_or_gt_of_ne hij with h | h
    · exact hlt_swap f h
    · simpa [Equiv.swap_comm] using hlt_swap f h
  induction e using Equiv.Perm.swap_induction_on generalizing f with
  | one => simp
  | swap_mul e i j hij ih =>
    have hmem := P.add_mem (hswap f hij) (ih fun k => f (Equiv.swap i j k))
    rw [sub_add_sub_cancel] at hmem
    simpa using hmem

end ring

section symmetric

-- `Sym[R]^(n + 2) M` needs `R : Type`: Mathlib's `SymmetricPower` takes `(R ι : Type u)`.
variable {R : Type} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]

/-- The two presentations of Stacks Tag 00DP for a ring `R : Type` in universe `0`. Let `M` be
a module over a commutative ring `R : Type` with a generating system `x : I → M`, and let
`n + 2 ≥ 2`. There are canonical exact sequences

  `(⊕ relators) → Tⁿ⁺²(M) → ⋀ⁿ⁺²(M) → 0`   and
  `(⊕ relators) → Tⁿ⁺²(M) → Symⁿ⁺²(M) → 0`,

with the relator maps and projections determined by their values on pure tensors
as described in the module docstring. The statement of Tag 00DP for a ring in any universe is
`exists_presentation_exteriorPower_and_symmetricPower_univ`
(`StacksFrontier.LinearAlgebra.SymmetricPower.TensorPowerPresentation`). -/
theorem exists_presentation_exteriorPower_and_symmetricPower {I : Type*} [DecidableEq I] (x : I → M)
    (hx : Submodule.span R (Set.range x) = ⊤) (n : ℕ) :
    -- exterior power presentation
    (∃ (Φ : DirectSum ((SlotPair n × I × I) ⊕ (SlotPair n × I)) (fun _ => ⨂[R]^n M)
              →ₗ[R] ⨂[R]^(n + 2) M)
       (π : ⨂[R]^(n + 2) M →ₗ[R] ⋀[R]^(n + 2) M),
        (∀ (jp : SlotPair n) (i₁ i₂ : I) (f : Fin n → M),
          Φ (DirectSum.lof R _ _ (Sum.inl (jp, i₁, i₂)) (⨂ₜ[R] k, f k))
            = (⨂ₜ[R] k, insTwo jp.1.1 jp.1.2 jp.2 (x i₁) (x i₂) f k)
              + (⨂ₜ[R] k, insTwo jp.1.1 jp.1.2 jp.2 (x i₂) (x i₁) f k)) ∧
        (∀ (jp : SlotPair n) (i : I) (f : Fin n → M),
          Φ (DirectSum.lof R _ _ (Sum.inr (jp, i)) (⨂ₜ[R] k, f k))
            = (⨂ₜ[R] k, insTwo jp.1.1 jp.1.2 jp.2 (x i) (x i) f k)) ∧
        (∀ f : Fin (n + 2) → M, π (⨂ₜ[R] k, f k) = exteriorPower.ιMulti R (n + 2) f) ∧
        Function.Exact Φ π ∧ Function.Surjective π) ∧
    -- symmetric power presentation
    (∃ (Ψ : DirectSum (SlotPair n × I × I) (fun _ => ⨂[R]^n M) →ₗ[R] ⨂[R]^(n + 2) M)
       (ρ : ⨂[R]^(n + 2) M →ₗ[R] Sym[R]^(n + 2) M),
        (∀ (jp : SlotPair n) (i₁ i₂ : I) (f : Fin n → M),
          Ψ (DirectSum.lof R _ _ (jp, i₁, i₂) (⨂ₜ[R] k, f k))
            = (⨂ₜ[R] k, insTwo jp.1.1 jp.1.2 jp.2 (x i₁) (x i₂) f k)
              - (⨂ₜ[R] k, insTwo jp.1.1 jp.1.2 jp.2 (x i₂) (x i₁) f k)) ∧
        (∀ f : Fin (n + 2) → M, ρ (⨂ₜ[R] k, f k) = ⨂ₛ[R] k, f k) ∧
        Function.Exact Ψ ρ ∧ Function.Surjective ρ) := by
  refine ⟨?_, ?_⟩
  · let Φ : DirectSum ((SlotPair n × I × I) ⊕ (SlotPair n × I)) (fun _ => ⨂[R]^n M)
        →ₗ[R] ⨂[R]^(n + 2) M :=
      DirectSum.toModule R _ _ fun c => Sum.elim
        (fun p : SlotPair n × I × I => PiTensorProduct.lift
          (insTwoTprod R p.1.1.1 p.1.1.2 p.1.2 (x p.2.1) (x p.2.2)
            + insTwoTprod R p.1.1.1 p.1.1.2 p.1.2 (x p.2.2) (x p.2.1)))
        (fun p : SlotPair n × I => PiTensorProduct.lift
          (insTwoTprod R p.1.1.1 p.1.1.2 p.1.2 (x p.2) (x p.2))) c
    let π : ⨂[R]^(n + 2) M →ₗ[R] ⋀[R]^(n + 2) M :=
      PiTensorProduct.lift (exteriorPower.ιMulti R (n + 2)).toMultilinearMap
    have hΦ₁ (jp : SlotPair n) (i₁ i₂ : I) (f : Fin n → M) :
        Φ (DirectSum.lof R _ _ (Sum.inl (jp, i₁, i₂)) (⨂ₜ[R] k, f k))
          = (⨂ₜ[R] k, insTwo jp.1.1 jp.1.2 jp.2 (x i₁) (x i₂) f k)
            + (⨂ₜ[R] k, insTwo jp.1.1 jp.1.2 jp.2 (x i₂) (x i₁) f k) := by
      simp [Φ]
    have hΦ₂ (jp : SlotPair n) (i : I) (f : Fin n → M) :
        Φ (DirectSum.lof R _ _ (Sum.inr (jp, i)) (⨂ₜ[R] k, f k))
          = (⨂ₜ[R] k, insTwo jp.1.1 jp.1.2 jp.2 (x i) (x i) f k) := by
      simp [Φ]
    have hπ (f : Fin (n + 2) → M) : π (⨂ₜ[R] k, f k) = exteriorPower.ιMulti R (n + 2) f := by
      simp [π]
    refine ⟨Φ, π, hΦ₁, hΦ₂, hπ, ?_, ?_⟩
    · refine exact_of_ker_le_range_of_tprod Φ π ?_ ?_
      · have hE := tprod_mem_of_apply_eq hx (LinearMap.range Φ)
          (fun jp i₁ i₂ g => LinearMap.mem_range.2 ⟨_, hΦ₁ jp i₁ i₂ g⟩)
          (fun jp i g => LinearMap.mem_range.2 ⟨_, hΦ₂ jp i g⟩)
        let A : M [⋀^Fin (n + 2)]→ₗ[R] (⨂[R]^(n + 2) M ⧸ LinearMap.range Φ) :=
          { (LinearMap.range Φ).mkQ.compMultilinearMap (PiTensorProduct.tprod R) with
            map_eq_zero_of_eq' := fun f i j hf hij => by
              simpa [Submodule.Quotient.mk_eq_zero] using hE f hf hij }
        have hL : exteriorPower.alternatingMapLinearEquiv A ∘ₗ π = (LinearMap.range Φ).mkQ :=
          PiTensorProduct.ext (MultilinearMap.ext fun f => by simp [hπ, A])
        intro z hz
        have hz' := LinearMap.congr_fun hL z
        rw [LinearMap.comp_apply, LinearMap.mem_ker.1 hz, map_zero, Submodule.mkQ_apply] at hz'
        exact (Submodule.Quotient.mk_eq_zero _).1 hz'.symm
      · rintro (⟨jp, i₁, i₂⟩ | ⟨jp, i⟩) g
        · have := (exteriorPower.ιMulti R (n + 2)).map_swap_add
            (v := insTwo jp.1.1 jp.1.2 jp.2 (x i₁) (x i₂) g) jp.2.ne
          rw [insTwo_comp_swap] at this
          simpa [hΦ₁, hπ, add_comm] using this
        · simpa [hΦ₂, hπ] using (exteriorPower.ιMulti R (n + 2)).map_eq_zero_of_eq
            (insTwo jp.1.1 jp.1.2 jp.2 (x i) (x i) g)
            ((insTwo_apply_fst _ _ _).trans (insTwo_apply_snd _ _ _).symm) jp.2.ne
    · rw [← LinearMap.range_eq_top, eq_top_iff, ← exteriorPower.ιMulti_span R (n + 2) M,
        Submodule.span_le]
      rintro _ ⟨f, rfl⟩
      exact LinearMap.mem_range.2 ⟨_, hπ f⟩
  · let Ψ : DirectSum (SlotPair n × I × I) (fun _ => ⨂[R]^n M) →ₗ[R] ⨂[R]^(n + 2) M :=
      DirectSum.toModule R _ _ fun p => PiTensorProduct.lift
        (insTwoTprod R p.1.1.1 p.1.1.2 p.1.2 (x p.2.1) (x p.2.2)
          - insTwoTprod R p.1.1.1 p.1.1.2 p.1.2 (x p.2.2) (x p.2.1))
    let ρ := SymmetricPower.mk R (Fin (n + 2)) M
    have hΨ (jp : SlotPair n) (i₁ i₂ : I) (f : Fin n → M) :
        Ψ (DirectSum.lof R _ _ (jp, i₁, i₂) (⨂ₜ[R] k, f k))
          = (⨂ₜ[R] k, insTwo jp.1.1 jp.1.2 jp.2 (x i₁) (x i₂) f k)
            - (⨂ₜ[R] k, insTwo jp.1.1 jp.1.2 jp.2 (x i₂) (x i₁) f k) := by
      simp [Ψ]
    have hρ (f : Fin (n + 2) → M) : ρ (⨂ₜ[R] k, f k) = ⨂ₛ[R] k, f k := by
      simp [ρ, SymmetricPower.tprod]
    refine ⟨Ψ, ρ, hΨ, hρ, ?_, LinearMap.range_eq_top.1 (SymmetricPower.range_mk R _ M)⟩
    refine exact_of_ker_le_range_of_tprod Ψ ρ ?_ ?_
    · intro z hz
      have hle : addConGen (SymmetricPower.Rel R (Fin (n + 2)) M)
          ≤ AddCon.ker (LinearMap.range Ψ).mkQ := by
        refine AddCon.addConGen_le.2 fun _ _ h => ?_
        obtain ⟨e, f⟩ := h
        rw [AddCon.ker_rel, Submodule.mkQ_apply, Submodule.mkQ_apply, Submodule.Quotient.eq]
        exact tprod_sub_tprod_perm_mem hx _
          (fun jp i₁ i₂ g => LinearMap.mem_range.2 ⟨_, hΨ jp i₁ i₂ g⟩) e f
      have hrel : addConGen (SymmetricPower.Rel R (Fin (n + 2)) M) z 0 :=
        SymmetricPower.mk_eq_mk_iff.1 ((LinearMap.mem_ker.1 hz).trans (map_zero ρ).symm)
      simpa using (AddCon.ker_rel _).1 (hle hrel)
    · rintro ⟨jp, i₁, i₂⟩ g
      have := SymmetricPower.tprod_equiv (R := R) (Equiv.swap jp.1.1 jp.1.2)
        (insTwo jp.1.1 jp.1.2 jp.2 (x i₁) (x i₂) g)
      simp only [← Function.comp_apply (f := insTwo jp.1.1 jp.1.2 jp.2 (x i₁) (x i₂) g),
        insTwo_comp_swap] at this
      simpa [hΨ, hρ, sub_eq_zero] using this.symm

end symmetric
