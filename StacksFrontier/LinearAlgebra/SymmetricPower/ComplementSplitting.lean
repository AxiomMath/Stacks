module

public import Mathlib.Algebra.MvPolynomial.Equiv
public import Mathlib.LinearAlgebra.Basis.Prod
public import Mathlib.LinearAlgebra.Basis.VectorSpace
public import Mathlib.LinearAlgebra.Projection
public import Mathlib.LinearAlgebra.SymmetricAlgebra.Basis
public import Mathlib.RingTheory.Polynomial.Quotient
public import StacksFrontier.LinearAlgebra.SymmetricPower.Presentation

/-!
# The symmetric algebra of a vector space as a polynomial ring over that of a subspace

Let `W` be a subspace of a vector space `V`. The inclusion induces `Sym(W) ⟶ Sym(V)`, and
choosing a complement `U` of `W` together with bases of `W` and `U` identifies that homomorphism
with the inclusion of the coefficients `Sym(W) ⟶ Sym(W)[x_u : u ∈ basis of U]`: a basis of `V`
adapted to the decomposition presents `Sym(V)` as a polynomial ring in the two families of
variables, and `Sym(W)` as the polynomial ring in the first family.

The consequence recorded here is that the ideal of `Sym(V)` generated by a prime ideal of
`Sym(W)` is again prime. Together with the fact that it contracts along the inclusion to the
prime it came from — which needs no polynomial structure, only a retraction `V ⟶ W` — this says
that the inclusion carries a point of `Proj Sym(W)` to a point of `Proj Sym(V)` lying over it:
the generic point of the cone over a closed subvariety of `P(W)`, which is what the proof of
Stacks 0B0E needs of it.

## Main results

* `MvPolynomial.isPrime_map_C`: the ideal generated by a prime ideal of the coefficient ring is
  prime.
* `MvPolynomial.isPrime_map_rename_inr`: the ideal generated by a prime ideal along the inclusion
  of the variables indexed by the right summand is prime.
* `SymPow.isPrime_map_symAlgMap_subtype`: the ideal of `Sym(V)` generated by a prime ideal of
  `Sym(W)` is prime.

## Implementation notes

The content is the quotient computation `Sym(V) ⧸ p·Sym(V) ≅ (Sym(W) ⧸ p)[x_u]`, which Mathlib's
`MvPolynomial.quotientEquivQuotientMvPolynomial` performs in the polynomial presentation; the
transport to `Sym` is along `SymmetricAlgebra.equivMvPolynomial` of an adapted basis, and
`MvPolynomial.sumRingEquiv` is what turns the inclusion of a subfamily of variables into the
inclusion of the coefficients.
-/

@[expose] public noncomputable section

namespace MvPolynomial

/-- **The ideal generated by a prime ideal of the coefficient ring is prime.** The quotient of
the polynomial ring by it is the polynomial ring over the quotient, which is a domain. -/
public theorem isPrime_map_C {R : Type*} [CommRing R] {σ : Type*} {I : Ideal R}
    (hI : I.IsPrime) : (I.map (C : R →+* MvPolynomial σ R)).IsPrime := by
  have hdom : IsDomain (R ⧸ I) := (Ideal.Quotient.isDomain_iff_prime I).mpr hI
  have e : (MvPolynomial σ R ⧸ (Ideal.map C I : Ideal (MvPolynomial σ R))) ≃*
      MvPolynomial σ (R ⧸ I) :=
    (quotientEquivQuotientMvPolynomial (σ := σ) I).symm.toRingEquiv.toMulEquiv
  have hq : IsDomain (MvPolynomial σ R ⧸ (Ideal.map C I : Ideal (MvPolynomial σ R))) :=
    e.isDomain _
  exact (Ideal.Quotient.isDomain_iff_prime _).mp hq

/-- **Adjoining variables to a prime ideal keeps it prime.** The ideal generated in
`MvPolynomial (S₁ ⊕ S₂) R` by a prime ideal of `MvPolynomial S₂ R` is prime: the isomorphism
`MvPolynomial.sumRingEquiv` turns the inclusion of the variables indexed by `S₂` into the
inclusion `C` of the coefficients. -/
public theorem isPrime_map_rename_inr {R : Type*} [CommRing R] {S₁ S₂ : Type*}
    {q : Ideal (MvPolynomial S₂ R)} (hq : q.IsPrime) :
    (q.map ((rename (R := R) (Sum.inr : S₂ → S₁ ⊕ S₂)).toRingHom)).IsPrime := by
  have hsymm : (((sumRingEquiv R S₁ S₂).symm :
        MvPolynomial S₁ (MvPolynomial S₂ R) →+* MvPolynomial (S₁ ⊕ S₂) R).comp
      (C : MvPolynomial S₂ R →+* MvPolynomial S₁ (MvPolynomial S₂ R)))
      = (rename (R := R) (Sum.inr : S₂ → S₁ ⊕ S₂)).toRingHom := by
    refine ringHom_ext (fun r => ?_) (fun j => ?_)
    · simp
    · simp
  have hmap : q.map ((rename (R := R) (Sum.inr : S₂ → S₁ ⊕ S₂)).toRingHom)
      = Ideal.map ((sumRingEquiv R S₁ S₂).symm :
          MvPolynomial S₁ (MvPolynomial S₂ R) →+* MvPolynomial (S₁ ⊕ S₂) R)
        (q.map (C : MvPolynomial S₂ R →+* MvPolynomial S₁ (MvPolynomial S₂ R))) := by
    rw [Ideal.map_map, hsymm]
  rw [hmap]
  have := isPrime_map_C (σ := S₁) hq
  exact Ideal.map_isPrime_of_equiv _

end MvPolynomial

namespace SymPow

open SymmetricAlgebra

section Splitting

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]
  {N P : Submodule R M} {ιN ιP : Type*}

/-- The ideal generated by a prime ideal of `Sym(N)` in `Sym(M)` is prime, for a direct summand
`N` of `M` with free complement: an adapted basis presents the inclusion as the inclusion of the
coefficients of a polynomial ring. -/
private theorem isPrime_map_symAlgMap_subtype_of_isCompl (h : IsCompl N P)
    (bN : Module.Basis ιN R ↥N) (bP : Module.Basis ιP R ↥P)
    {p : Ideal (SymmetricAlgebra R ↥N)} (hp : p.IsPrime) :
    (p.map (symAlgMap N.subtype).toRingHom).IsPrime := by
  classical
  set bM : Module.Basis (ιP ⊕ ιN) R M :=
    (bP.prod bN).map (Submodule.prodEquivOfIsCompl P N h.symm) with hbMdef
  have hbM : ∀ j : ιN, bM (Sum.inr j) = N.subtype (bN j) := by
    intro j
    have h1 : (bP.prod bN) (Sum.inr j) = (0, bN j) :=
      Prod.ext (Module.Basis.prod_apply_inr_fst bP bN j)
        (Module.Basis.prod_apply_inr_snd bP bN j)
    rw [hbMdef, Module.Basis.map_apply, h1, Submodule.coe_prodEquivOfIsCompl']
    simp
  have hsq : ∀ x : SymmetricAlgebra R ↥N,
      equivMvPolynomial bM ((symAlgMap N.subtype) x)
        = MvPolynomial.rename Sum.inr (equivMvPolynomial bN x) := by
    have hA : (equivMvPolynomial bM).toAlgHom.comp (symAlgMap N.subtype)
        = (MvPolynomial.rename (R := R) (Sum.inr : ιN → ιP ⊕ ιN)).comp
          (equivMvPolynomial bN).toAlgHom := by
      refine algHom_ext (bN.ext fun j => ?_)
      change equivMvPolynomial bM ((symAlgMap N.subtype) (ι R ↥N (bN j)))
          = MvPolynomial.rename Sum.inr (equivMvPolynomial bN (ι R ↥N (bN j)))
      rw [symAlgMap_ι, ← hbM j, equivMvPolynomial_ι_apply, equivMvPolynomial_ι_apply,
        MvPolynomial.rename_X]
    intro x
    exact DFunLike.congr_fun hA x
  have hmap : p.map (symAlgMap N.subtype).toRingHom
      = Ideal.map (equivMvPolynomial bM).symm.toAlgHom.toRingHom (Ideal.map
          ((MvPolynomial.rename (R := R) (Sum.inr : ιN → ιP ⊕ ιN)).toRingHom)
          (Ideal.map (equivMvPolynomial bN).toAlgHom.toRingHom p)) := by
    rw [Ideal.map_map, Ideal.map_map]
    congr 1
    refine RingHom.ext fun x => ?_
    change _ = (equivMvPolynomial bM).symm
      (MvPolynomial.rename Sum.inr (equivMvPolynomial bN x))
    rw [← hsq x, AlgEquiv.symm_apply_apply]
    rfl
  have := hp
  have : (Ideal.map (equivMvPolynomial bN).toAlgHom.toRingHom p).IsPrime :=
    Ideal.map_isPrime_of_equiv (equivMvPolynomial bN)
  have := MvPolynomial.isPrime_map_rename_inr (S₁ := ιP) this
  rw [hmap]
  exact Ideal.map_isPrime_of_equiv (equivMvPolynomial bM).symm

end Splitting

section Field

variable {k : Type*} [Field k] {V : Type*} [AddCommGroup V] [Module k V]

/-- **The ideal of `Sym(V)` generated by a prime ideal of `Sym(W)` is prime.** Writing
`V = W ⊕ U`, a basis of `V` adapted to the decomposition presents `Sym(V)` as a polynomial ring
over `Sym(W)` in the variables of a basis of `U`, and adjoining variables to a prime ideal keeps
it prime. -/
public theorem isPrime_map_symAlgMap_subtype (W : Submodule k V)
    {p : Ideal (SymmetricAlgebra k ↥W)} (hp : p.IsPrime) :
    (p.map (symAlgMap W.subtype).toRingHom).IsPrime := by
  obtain ⟨U, hU⟩ := exists_isCompl W
  exact isPrime_map_symAlgMap_subtype_of_isCompl hU (Module.Basis.ofVectorSpace k ↥W)
    (Module.Basis.ofVectorSpace k ↥U) hp

end Field

end SymPow

end
