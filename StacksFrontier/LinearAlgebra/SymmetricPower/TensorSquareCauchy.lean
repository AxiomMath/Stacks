module

public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.LinearAlgebra.FreeModule.Basic
public import Mathlib.LinearAlgebra.TensorProduct.Basis
public import StacksFrontier.LinearAlgebra.SymmetricPower.SquareFiltration

/-!
# The Cauchy sequence for the symmetric square of a tensor product

Let `S` be a commutative ring and `E`, `F` two `S`-modules. There is a sequence

`0 → ⋀²E ⊗ ⋀²F --α--> Sym²(E ⊗ F) --φ--> Sym²E ⊗ Sym²F → 0`,

`φ((e ⊗ f) · (e' ⊗ f')) = (e · e') ⊗ (f · f')`,
`α((e ∧ e') ⊗ (f ∧ f')) = (e ⊗ f) · (e' ⊗ f') - (e ⊗ f') · (e' ⊗ f)`.

It is exact at `Sym²(E ⊗ F)` and at `Sym²E ⊗ Sym²F` for arbitrary modules, and `α` is injective
when `E` and `F` are free. No hypothesis on `2` is made.

## Main definitions

* `SymPow.ιOneExt`: the degree-one generator `E → ⋀¹E`.
* `SymPow.wedgeMul`: the multiplication `E ⊗ E → ⋀²E`, `e ⊗ e' ↦ e ∧ e'`.
* `SymPow.sqLift`: the linear map `Sym²E → M` induced by a symmetric bilinear map.
* `SymPow.wedgeLift`: the linear map `⋀²E → M` induced by an alternating bilinear map.
* `SymPow.cauchyφ`: the map `φ : Sym²(E ⊗ F) → Sym²E ⊗ Sym²F`.
* `SymPow.cauchyα`: the map `α : ⋀²E ⊗ ⋀²F → Sym²(E ⊗ F)`.

## Main results

* `SymPow.cauchyφ_surjective`: `φ` is surjective.
* `SymPow.cauchyφ_comp_cauchyα`: `φ ∘ α = 0`.
* `SymPow.range_cauchyα`: **the image of `α` is the kernel of `φ`**, for arbitrary `E` and `F`.
* `SymPow.cauchyα_injective`: **`α` is injective when `E` and `F` are free.**

## References

* [Stacks Project, Tag 0FEJ](https://stacks.math.columbia.edu/tag/0FEJ)
-/

@[expose] public noncomputable section

open TensorProduct

namespace SymPow

variable {S : Type*} [CommRing S] {E F M : Type*} [AddCommGroup E] [Module S E]
  [AddCommGroup F] [Module S F] [AddCommGroup M] [Module S M]

/-! ### Maps out of `Sym²` and `⋀²` -/

/-- The operators `L_e : (a, x, m) ↦ (0, a e, B(e, x))` on `S × E × M` attached to a bilinear map
`B : E × E → M`. -/
def sqOp (B : E →ₗ[S] E →ₗ[S] M) : E →ₗ[S] Module.End S (S × E × M) where
  toFun e :=
    { toFun := fun v => (0, v.1 • e, B e v.2.1)
      map_add' := fun v w => by simp [add_smul]
      map_smul' := fun c v => by simp [smul_smul] }
  map_add' e e' := LinearMap.ext fun v => by simp [smul_add]
  map_smul' c e := LinearMap.ext fun v => by simp [smul_smul, mul_comm]

/-- `L_e L_{e'} (a, x, m) = (0, 0, a B(e, e'))`. -/
theorem sqOp_mul_apply (B : E →ₗ[S] E →ₗ[S] M) (e e' : E) (v : S × E × M) :
    (sqOp B e * sqOp B e') v = (0, 0, v.1 • B e e') := by
  simp [sqOp]

/-- Evaluation of an operator on `S × E × M` at `(1, 0, 0)`, followed by the projection to `M`. -/
def evalOp : Module.End S (S × E × M) →ₗ[S] M where
  toFun T := (T (1, 0, 0)).2.2
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- `L_e L_{e'}` evaluated at `(1, 0, 0)` is `B(e, e')`. -/
theorem evalOp_sqOp_mul (B : E →ₗ[S] E →ₗ[S] M) (e e' : E) :
    evalOp (sqOp B e * sqOp B e') = B e e' := by
  show ((sqOp B e * sqOp B e') (1, 0, 0)).2.2 = _
  rw [sqOp_mul_apply, one_smul]

/-- The subalgebra generated by the operators `L_e` of a symmetric bilinear map is
commutative. -/
theorem isMulCommutative_adjoin_sqOp (B : E →ₗ[S] E →ₗ[S] M) (hB : ∀ e e', B e e' = B e' e) :
    IsMulCommutative (Algebra.adjoin S (Set.range (sqOp B))) :=
  Algebra.isMulCommutative_adjoin S (by
    rintro _ ⟨e, rfl⟩ _ ⟨e', rfl⟩ -
    exact LinearMap.ext fun v => by rw [sqOp_mul_apply, sqOp_mul_apply, hB])

/-- The operators `L_e`, with values in the subalgebra they generate. -/
def sqOpAdjoin (B : E →ₗ[S] E →ₗ[S] M) : E →ₗ[S] Algebra.adjoin S (Set.range (sqOp B)) where
  toFun e := ⟨sqOp B e, Algebra.subset_adjoin ⟨e, rfl⟩⟩
  map_add' e e' := Subtype.ext (map_add _ e e')
  map_smul' c e := Subtype.ext (map_smul _ c e)

open scoped IsMulCommutative in
/-- **The universal property of `Sym²E`**: the linear map `Sym²E → M`, `e · e' ↦ B(e, e')`,
induced by a symmetric bilinear map `B`. -/
def sqLift (B : E →ₗ[S] E →ₗ[S] M) (hB : ∀ e e', B e e' = B e' e) :
    symmetricPower (1 + 1) S E →ₗ[S] M :=
  haveI := isMulCommutative_adjoin_sqOp B hB
  evalOp ∘ₗ (Algebra.adjoin S (Set.range (sqOp B))).val.toLinearMap ∘ₗ
    (SymmetricAlgebra.lift (sqOpAdjoin B)).toLinearMap ∘ₗ
    (symmetricPower (1 + 1) S E).subtype

/-- `sqLift B` composed with the multiplication `E ⊗ E → Sym²E` is `B`. -/
theorem sqLift_comp_sqMul (B : E →ₗ[S] E →ₗ[S] M) (hB : ∀ e e', B e e' = B e' e) :
    sqLift B hB ∘ₗ sqMul LinearMap.id = TensorProduct.lift B := by
  refine TensorProduct.ext' fun e e' => ?_
  simp only [sqLift, LinearMap.comp_apply, Submodule.subtype_apply, sqMul_tmul, LinearMap.id_apply,
    AlgHom.toLinearMap_apply, map_mul, SymmetricAlgebra.lift_ι_apply, lift.tmul]
  exact evalOp_sqOp_mul B e e'

/-- `sqLift B (e · e') = B(e, e')`. -/
theorem sqLift_sqMul_tmul (B : E →ₗ[S] E →ₗ[S] M) (hB : ∀ e e', B e e' = B e' e) (e e' : E) :
    sqLift B hB (sqMul LinearMap.id (e ⊗ₜ e')) = B e e' := by
  rw [← LinearMap.comp_apply, sqLift_comp_sqMul, lift.tmul]

/-- Two linear maps out of `Sym²E` agreeing on the products `e · e'` are equal. -/
theorem sqMul_ext {f g : symmetricPower (1 + 1) S E →ₗ[S] M}
    (h : ∀ e e', f (sqMul LinearMap.id (e ⊗ₜ e')) = g (sqMul LinearMap.id (e ⊗ₜ e'))) :
    f = g :=
  (LinearMap.cancel_right sqMul_id_surjective).1 (TensorProduct.ext' h)

/-- The products in `Sym²E` commute. -/
theorem sqMul_swap (e e' : E) :
    sqMul (LinearMap.id : E →ₗ[S] E) (e ⊗ₜ e') = sqMul LinearMap.id (e' ⊗ₜ e) :=
  Subtype.ext (by rw [sqMul_tmul, sqMul_tmul, mul_comm]; rfl)

/-! ### The degree-two exterior power -/

/-- The generators `ι e` lie in `⋀¹E`. -/
theorem ι_mem_exteriorPower_one (e : E) : ExteriorAlgebra.ι S e ∈ ⋀[S]^1 E :=
  (pow_one (LinearMap.range (ExteriorAlgebra.ι S : E →ₗ[S] ExteriorAlgebra S E))).ge
    (LinearMap.mem_range_self _ e)

variable (S E) in
/-- The degree-one generator `E → ⋀¹E`. -/
def ιOneExt : E →ₗ[S] ⋀[S]^1 E :=
  (ExteriorAlgebra.ι S).codRestrict (⋀[S]^1 E) ι_mem_exteriorPower_one

/-- `ιOneExt S E e` is `ι e` in the exterior algebra. -/
theorem ιOneExt_coe (e : E) : (ιOneExt S E e : ExteriorAlgebra S E) = ExteriorAlgebra.ι S e :=
  rfl

/-- **The generator `E → ⋀¹E` is bijective.** -/
theorem ιOneExt_bijective : Function.Bijective (ιOneExt S E) := by
  refine ⟨fun e e' h => ExteriorAlgebra.ι_leftInverse.injective
    (congrArg Subtype.val h), ?_⟩
  rintro ⟨y, hy⟩
  obtain ⟨e, rfl⟩ :=
    (pow_one (LinearMap.range (ExteriorAlgebra.ι S : E →ₗ[S] ExteriorAlgebra S E))).le hy
  exact ⟨e, rfl⟩

/-- The multiplication `E ⊗ E → ⋀²E`, `e ⊗ e' ↦ e ∧ e'`. -/
def wedgeMul : E ⊗[S] E →ₗ[S] ⋀[S]^(1 + 1) E :=
  ExtPow.beta 1 LinearMap.id ∘ₗ LinearMap.lTensor E (ιOneExt S E)

/-- `wedgeMul (e ⊗ e') = e ∧ e'` in the exterior algebra. -/
theorem wedgeMul_tmul (e e' : E) :
    (wedgeMul (S := S) (e ⊗ₜ e') : ExteriorAlgebra S E) =
      ExteriorAlgebra.ι S e * ExteriorAlgebra.ι S e' :=
  rfl

/-- **The multiplication `E ⊗ E → ⋀²E` is surjective.** -/
theorem wedgeMul_surjective : Function.Surjective (wedgeMul (S := S) (E := E)) := by
  intro y
  have hle : ⋀[S]^(1 + 1) E ≤ (LinearMap.range (wedgeMul (S := S) (E := E))).map
      (Submodule.subtype _) := by
    show (LinearMap.range (ExteriorAlgebra.ι S : E →ₗ[S] ExteriorAlgebra S E)) ^ (1 + 1) ≤ _
    rw [pow_succ, pow_one, Submodule.mul_le]
    rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    exact ⟨wedgeMul (a ⊗ₜ b), LinearMap.mem_range_self _ _, rfl⟩
  obtain ⟨z, ⟨w, rfl⟩, hz⟩ := hle y.2
  exact ⟨w, Subtype.ext hz⟩

/-- `e ∧ e = 0`. -/
theorem wedgeMul_self (e : E) : wedgeMul (S := S) (e ⊗ₜ e) = 0 :=
  Subtype.ext (by rw [wedgeMul_tmul, ExteriorAlgebra.ι_sq_zero]; rfl)

/-- `e' ∧ e = -(e ∧ e')`. -/
theorem wedgeMul_swap (e e' : E) : wedgeMul (S := S) (e' ⊗ₜ e) = -wedgeMul (e ⊗ₜ e') :=
  Subtype.ext (by
    rw [wedgeMul_tmul, Submodule.coe_neg, wedgeMul_tmul, eq_neg_iff_add_eq_zero, add_comm,
      ExteriorAlgebra.ι_add_mul_swap])

/-- **The universal property of `⋀²E`**: the linear map `⋀²E → M`, `e ∧ e' ↦ B(e, e')`, induced
by an alternating bilinear map `B`. -/
def wedgeLift (B : E →ₗ[S] E →ₗ[S] M) (hB : ∀ e, B e e = 0) :
    ⋀[S]^(1 + 1) E →ₗ[S] M :=
  evalOp ∘ₗ (ExteriorAlgebra.lift S ⟨sqOp B, fun e => LinearMap.ext fun v => by
      rw [sqOp_mul_apply, hB, smul_zero]; rfl⟩).toLinearMap ∘ₗ
    (⋀[S]^(1 + 1) E).subtype

/-- `wedgeLift B (e ∧ e') = B(e, e')`. -/
theorem wedgeLift_wedgeMul_tmul (B : E →ₗ[S] E →ₗ[S] M) (hB : ∀ e, B e e = 0) (e e' : E) :
    wedgeLift B hB (wedgeMul (e ⊗ₜ e')) = B e e' := by
  simp only [wedgeLift, LinearMap.comp_apply, Submodule.subtype_apply, wedgeMul_tmul,
    AlgHom.toLinearMap_apply, map_mul, ExteriorAlgebra.lift_ι_apply]
  exact evalOp_sqOp_mul B e e'

/-- `wedgeLift B` composed with the multiplication `E ⊗ E → ⋀²E` is `B`. -/
theorem wedgeLift_comp_wedgeMul (B : E →ₗ[S] E →ₗ[S] M) (hB : ∀ e, B e e = 0) :
    wedgeLift B hB ∘ₗ wedgeMul = TensorProduct.lift B :=
  TensorProduct.ext' fun e e' => by
    rw [LinearMap.comp_apply, wedgeLift_wedgeMul_tmul, lift.tmul]

/-- Two linear maps out of `⋀²E` agreeing on the products `e ∧ e'` are equal. -/
theorem wedgeMul_ext {f g : ⋀[S]^(1 + 1) E →ₗ[S] M}
    (h : ∀ e e', f (wedgeMul (e ⊗ₜ e')) = g (wedgeMul (e ⊗ₜ e'))) : f = g :=
  (LinearMap.cancel_right wedgeMul_surjective).1 (TensorProduct.ext' h)

/-! ### The map `φ` -/

/-- The bilinear map `(e ⊗ f, e' ⊗ f') ↦ (e e') ⊗ (f f')` on `E ⊗ F`. -/
def cauchyφBil :
    E ⊗[S] F →ₗ[S] E ⊗[S] F →ₗ[S] symmetricPower (1 + 1) S E ⊗[S] symmetricPower (1 + 1) S F :=
  TensorProduct.curry (TensorProduct.map (sqMul LinearMap.id) (sqMul LinearMap.id) ∘ₗ
    (TensorProduct.tensorTensorTensorComm S E F E F).toLinearMap)

/-- `cauchyφBil (e ⊗ f) (e' ⊗ f') = (e e') ⊗ (f f')`. -/
theorem cauchyφBil_tmul (e e' : E) (f f' : F) :
    cauchyφBil (e ⊗ₜ f) (e' ⊗ₜ f') =
      sqMul LinearMap.id (e ⊗ₜ e') ⊗ₜ[S] sqMul LinearMap.id (f ⊗ₜ f') :=
  rfl

/-- `cauchyφBil` is symmetric. -/
theorem cauchyφBil_symm (x y : E ⊗[S] F) :
    cauchyφBil (S := S) x y = cauchyφBil y x := by
  have h : cauchyφBil (S := S) (E := E) (F := F) = cauchyφBil.flip :=
    TensorProduct.ext' fun e f => TensorProduct.ext' fun e' f' => by
      rw [LinearMap.flip_apply, cauchyφBil_tmul, cauchyφBil_tmul, sqMul_swap e e',
        sqMul_swap f f']
  exact DFunLike.congr_fun (DFunLike.congr_fun h x) y

/-- The map `φ : Sym²(E ⊗ F) → Sym²E ⊗ Sym²F`, `(e ⊗ f) · (e' ⊗ f') ↦ (e e') ⊗ (f f')`. -/
def cauchyφ :
    symmetricPower (1 + 1) S (E ⊗[S] F) →ₗ[S]
      symmetricPower (1 + 1) S E ⊗[S] symmetricPower (1 + 1) S F :=
  sqLift cauchyφBil cauchyφBil_symm

/-- **`φ((e ⊗ f) · (e' ⊗ f')) = (e e') ⊗ (f f')`.** -/
theorem cauchyφ_comp_sqMul :
    cauchyφ ∘ₗ sqMul (LinearMap.id : E ⊗[S] F →ₗ[S] E ⊗[S] F) =
      TensorProduct.map (sqMul LinearMap.id) (sqMul LinearMap.id) ∘ₗ
        (TensorProduct.tensorTensorTensorComm S E F E F).toLinearMap := by
  rw [cauchyφ, sqLift_comp_sqMul]
  exact TensorProduct.ext' fun x y => by rw [lift.tmul]; rfl

/-- `φ((e ⊗ f) · (e' ⊗ f')) = (e e') ⊗ (f f')`, on elements. -/
theorem cauchyφ_sqMul_tmul (e e' : E) (f f' : F) :
    cauchyφ (sqMul LinearMap.id ((e ⊗ₜ f) ⊗ₜ (e' ⊗ₜ f'))) =
      sqMul LinearMap.id (e ⊗ₜ e') ⊗ₜ[S] sqMul LinearMap.id (f ⊗ₜ f') := by
  rw [← LinearMap.comp_apply, cauchyφ_comp_sqMul]
  rfl

/-- **`φ` is surjective.** -/
theorem cauchyφ_surjective : Function.Surjective (cauchyφ (S := S) (E := E) (F := F)) := by
  have h : Function.Surjective (TensorProduct.map (sqMul LinearMap.id) (sqMul LinearMap.id) ∘ₗ
      (TensorProduct.tensorTensorTensorComm S E F E F).toLinearMap) :=
    (TensorProduct.map_surjective sqMul_id_surjective sqMul_id_surjective).comp
      (TensorProduct.tensorTensorTensorComm S E F E F).surjective
  rw [← cauchyφ_comp_sqMul, LinearMap.coe_comp] at h
  exact h.of_comp

/-! ### The map `α` -/

/-- The map `(E ⊗ E) ⊗ (F ⊗ F) → Sym²(E ⊗ F)`,
`(e ⊗ e') ⊗ (f ⊗ f') ↦ (e ⊗ f)(e' ⊗ f') - (e ⊗ f')(e' ⊗ f)`. -/
def cauchyαQuad : (E ⊗[S] E) ⊗[S] (F ⊗[S] F) →ₗ[S] symmetricPower (1 + 1) S (E ⊗[S] F) :=
  sqMul (LinearMap.id : E ⊗[S] F →ₗ[S] E ⊗[S] F) ∘ₗ
    ((TensorProduct.tensorTensorTensorComm S E E F F).toLinearMap -
      (TensorProduct.tensorTensorTensorComm S E E F F).toLinearMap ∘ₗ
        LinearMap.lTensor (E ⊗[S] E) (TensorProduct.comm S F F).toLinearMap)

/-- The value of `cauchyαQuad` on a pure tensor. -/
theorem cauchyαQuad_tmul (e e' : E) (f f' : F) :
    cauchyαQuad ((e ⊗ₜ e') ⊗ₜ (f ⊗ₜ f')) =
      sqMul LinearMap.id ((e ⊗ₜ f) ⊗ₜ[S] (e' ⊗ₜ f')) -
        sqMul LinearMap.id ((e ⊗ₜ f') ⊗ₜ[S] (e' ⊗ₜ f)) := by
  simp [cauchyαQuad]

/-- `cauchyαQuad`, as an alternating bilinear map on `F` with values in maps out of `E ⊗ E`. -/
def cauchyαF : F →ₗ[S] F →ₗ[S] E ⊗[S] E →ₗ[S] symmetricPower (1 + 1) S (E ⊗[S] F) :=
  TensorProduct.curry (TensorProduct.curry cauchyαQuad).flip

/-- `cauchyαF f f' z = cauchyαQuad (z ⊗ (f ⊗ f'))`. -/
theorem cauchyαF_apply (f f' : F) (z : E ⊗[S] E) :
    cauchyαF (S := S) f f' z = cauchyαQuad (z ⊗ₜ (f ⊗ₜ f')) :=
  rfl

/-- `cauchyαF` is alternating. -/
theorem cauchyαF_self (f : F) : cauchyαF (S := S) (E := E) f f = 0 :=
  LinearMap.ext fun z => by
    simp [cauchyαF_apply, cauchyαQuad]

/-- The map `⋀²F → Hom(E ⊗ E, Sym²(E ⊗ F))` induced by `cauchyαF`. -/
def cauchyαK : ⋀[S]^(1 + 1) F →ₗ[S] E ⊗[S] E →ₗ[S] symmetricPower (1 + 1) S (E ⊗[S] F) :=
  wedgeLift cauchyαF cauchyαF_self

/-- `cauchyαK (f ∧ f') (e ⊗ e') = cauchyαQuad ((e ⊗ e') ⊗ (f ⊗ f'))`. -/
theorem cauchyαK_apply (e e' : E) (f f' : F) :
    cauchyαK (wedgeMul (S := S) (f ⊗ₜ f')) (e ⊗ₜ e') = cauchyαQuad ((e ⊗ₜ e') ⊗ₜ (f ⊗ₜ f')) := by
  rw [cauchyαK, wedgeLift_wedgeMul_tmul, cauchyαF_apply]

/-- `cauchyαK`, as an alternating bilinear map on `E`. -/
def cauchyαE : E →ₗ[S] E →ₗ[S] ⋀[S]^(1 + 1) F →ₗ[S] symmetricPower (1 + 1) S (E ⊗[S] F) :=
  TensorProduct.curry cauchyαK.flip

/-- `cauchyαE` is alternating. -/
theorem cauchyαE_self (e : E) : cauchyαE (S := S) (F := F) e e = 0 :=
  wedgeMul_ext fun f f' => by
    show cauchyαK (wedgeMul (f ⊗ₜ f')) (e ⊗ₜ e) = 0
    rw [cauchyαK_apply, cauchyαQuad_tmul, sqMul_swap (e ⊗ₜ f), sub_self]

/-- The map `α : ⋀²E ⊗ ⋀²F → Sym²(E ⊗ F)`,
`(e ∧ e') ⊗ (f ∧ f') ↦ (e ⊗ f)(e' ⊗ f') - (e ⊗ f')(e' ⊗ f)`. -/
def cauchyα : ⋀[S]^(1 + 1) E ⊗[S] ⋀[S]^(1 + 1) F →ₗ[S] symmetricPower (1 + 1) S (E ⊗[S] F) :=
  TensorProduct.lift (wedgeLift cauchyαE cauchyαE_self)

/-- **`α((e ∧ e') ⊗ (f ∧ f')) = (e ⊗ f)(e' ⊗ f') - (e ⊗ f')(e' ⊗ f)`.** -/
theorem cauchyα_comp_map_wedgeMul :
    cauchyα ∘ₗ TensorProduct.map wedgeMul wedgeMul =
      sqMul (LinearMap.id : E ⊗[S] F →ₗ[S] E ⊗[S] F) ∘ₗ
        ((TensorProduct.tensorTensorTensorComm S E E F F).toLinearMap -
          (TensorProduct.tensorTensorTensorComm S E E F F).toLinearMap ∘ₗ
            LinearMap.lTensor (E ⊗[S] E) (TensorProduct.comm S F F).toLinearMap) := by
  refine TensorProduct.ext_fourfold' fun e e' f f' => ?_
  rw [LinearMap.comp_apply, TensorProduct.map_tmul, cauchyα, lift.tmul,
    wedgeLift_wedgeMul_tmul]
  exact cauchyαK_apply e e' f f'

/-- `α((e ∧ e') ⊗ (f ∧ f')) = (e ⊗ f)(e' ⊗ f') - (e ⊗ f')(e' ⊗ f)`, on elements. -/
theorem cauchyα_wedgeMul_tmul (e e' : E) (f f' : F) :
    cauchyα (wedgeMul (e ⊗ₜ e') ⊗ₜ wedgeMul (f ⊗ₜ f')) =
      sqMul LinearMap.id ((e ⊗ₜ f) ⊗ₜ[S] (e' ⊗ₜ f')) -
        sqMul LinearMap.id ((e ⊗ₜ f') ⊗ₜ[S] (e' ⊗ₜ f)) := by
  rw [← TensorProduct.map_tmul, ← LinearMap.comp_apply, cauchyα_comp_map_wedgeMul]
  exact cauchyαQuad_tmul e e' f f'

/-- The map `(E ⊗ E) ⊗ (F ⊗ F) → ⋀²E ⊗ ⋀²F` is surjective. -/
theorem map_wedgeMul_surjective :
    Function.Surjective (TensorProduct.map (wedgeMul (S := S) (E := E))
      (wedgeMul (S := S) (E := F))) :=
  TensorProduct.map_surjective wedgeMul_surjective wedgeMul_surjective

/-- **`φ ∘ α = 0`.** -/
theorem cauchyφ_comp_cauchyα : cauchyφ ∘ₗ cauchyα (S := S) (E := E) (F := F) = 0 := by
  refine (LinearMap.cancel_right map_wedgeMul_surjective).1 ?_
  refine TensorProduct.ext_fourfold' fun e e' f f' => ?_
  rw [LinearMap.comp_apply, LinearMap.comp_apply, TensorProduct.map_tmul, cauchyα_wedgeMul_tmul,
    map_sub, cauchyφ_sqMul_tmul, cauchyφ_sqMul_tmul, sqMul_swap f' f, sub_self,
    LinearMap.zero_comp, LinearMap.zero_apply]

/-! ### Exactness in the middle -/

section Exactness

/-- The map `(E ⊗ E) ⊗ (F ⊗ F) → Sym²(E ⊗ F) / im α`, `(e ⊗ e') ⊗ (f ⊗ f') ↦ [(e ⊗ f)(e' ⊗ f')]`.
-/
def cauchyψQuad : (E ⊗[S] E) ⊗[S] (F ⊗[S] F) →ₗ[S]
    symmetricPower (1 + 1) S (E ⊗[S] F) ⧸ LinearMap.range (cauchyα (S := S) (E := E) (F := F)) :=
  (LinearMap.range cauchyα).mkQ ∘ₗ sqMul LinearMap.id ∘ₗ
    (TensorProduct.tensorTensorTensorComm S E E F F).toLinearMap

/-- The value of `cauchyψQuad` on a pure tensor. -/
theorem cauchyψQuad_tmul (e e' : E) (f f' : F) :
    cauchyψQuad ((e ⊗ₜ e') ⊗ₜ (f ⊗ₜ f')) =
      (LinearMap.range cauchyα).mkQ (sqMul LinearMap.id ((e ⊗ₜ f) ⊗ₜ[S] (e' ⊗ₜ f'))) :=
  rfl

/-- `[(e ⊗ f')(e' ⊗ f)] = [(e ⊗ f)(e' ⊗ f')]` modulo the image of `α`. -/
theorem cauchyψQuad_swap_right (e e' : E) (f f' : F) :
    cauchyψQuad (S := S) ((e ⊗ₜ e') ⊗ₜ (f' ⊗ₜ f)) = cauchyψQuad ((e ⊗ₜ e') ⊗ₜ (f ⊗ₜ f')) := by
  rw [cauchyψQuad_tmul, cauchyψQuad_tmul, eq_comm, ← sub_eq_zero, ← map_sub,
    ← cauchyα_wedgeMul_tmul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  exact LinearMap.mem_range_self _ _

/-- `cauchyψQuad` is symmetric in the two factors of `F ⊗ F`. -/
theorem cauchyψQuad_swap_right' (z : E ⊗[S] E) (f f' : F) :
    cauchyψQuad (S := S) (z ⊗ₜ (f' ⊗ₜ f)) = cauchyψQuad (z ⊗ₜ (f ⊗ₜ f')) := by
  induction z using TensorProduct.induction_on with
  | zero => rw [TensorProduct.zero_tmul, TensorProduct.zero_tmul]
  | tmul e e' => exact cauchyψQuad_swap_right e e' f f'
  | add x y hx hy => rw [TensorProduct.add_tmul, TensorProduct.add_tmul, map_add, map_add, hx, hy]

/-- `cauchyψQuad`, as a symmetric bilinear map on `F` with values in maps out of `E ⊗ E`. -/
def cauchyψF : F →ₗ[S] F →ₗ[S] E ⊗[S] E →ₗ[S]
    symmetricPower (1 + 1) S (E ⊗[S] F) ⧸ LinearMap.range (cauchyα (S := S) (E := E) (F := F)) :=
  TensorProduct.curry (TensorProduct.curry cauchyψQuad).flip

/-- `cauchyψF` is symmetric. -/
theorem cauchyψF_symm (f f' : F) : cauchyψF (S := S) (E := E) f f' = cauchyψF f' f :=
  LinearMap.ext fun z => cauchyψQuad_swap_right' z f' f

/-- The map `Sym²F → Hom(E ⊗ E, Sym²(E ⊗ F) / im α)` induced by `cauchyψF`. -/
def cauchyψK : symmetricPower (1 + 1) S F →ₗ[S] E ⊗[S] E →ₗ[S]
    symmetricPower (1 + 1) S (E ⊗[S] F) ⧸ LinearMap.range (cauchyα (S := S) (E := E) (F := F)) :=
  sqLift cauchyψF cauchyψF_symm

/-- `cauchyψK (f f') (e ⊗ e') = cauchyψQuad ((e ⊗ e') ⊗ (f ⊗ f'))`. -/
theorem cauchyψK_apply (e e' : E) (f f' : F) :
    cauchyψK (sqMul (S := S) LinearMap.id (f ⊗ₜ f')) (e ⊗ₜ e') =
      cauchyψQuad ((e ⊗ₜ e') ⊗ₜ (f ⊗ₜ f')) := by
  rw [cauchyψK, sqLift_sqMul_tmul]
  rfl

/-- `cauchyψK`, as a symmetric bilinear map on `E`. -/
def cauchyψE : E →ₗ[S] E →ₗ[S] symmetricPower (1 + 1) S F →ₗ[S]
    symmetricPower (1 + 1) S (E ⊗[S] F) ⧸ LinearMap.range (cauchyα (S := S) (E := E) (F := F)) :=
  TensorProduct.curry cauchyψK.flip

/-- `cauchyψE` is symmetric. -/
theorem cauchyψE_symm (e e' : E) : cauchyψE (S := S) (F := F) e e' = cauchyψE e' e :=
  sqMul_ext fun f f' => by
    show cauchyψK (sqMul LinearMap.id (f ⊗ₜ f')) (e ⊗ₜ e') =
      cauchyψK (sqMul LinearMap.id (f ⊗ₜ f')) (e' ⊗ₜ e)
    rw [cauchyψK_apply, cauchyψK_apply, cauchyψQuad_tmul, cauchyψQuad_tmul, sqMul_swap (e' ⊗ₜ f),
      ← cauchyψQuad_tmul, ← cauchyψQuad_tmul, cauchyψQuad_swap_right]

/-- The map `ψ : Sym²E ⊗ Sym²F → Sym²(E ⊗ F) / im α`, `(e e') ⊗ (f f') ↦ [(e ⊗ f)(e' ⊗ f')]`. -/
def cauchyψ : symmetricPower (1 + 1) S E ⊗[S] symmetricPower (1 + 1) S F →ₗ[S]
    symmetricPower (1 + 1) S (E ⊗[S] F) ⧸ LinearMap.range (cauchyα (S := S) (E := E) (F := F)) :=
  TensorProduct.lift (sqLift cauchyψE cauchyψE_symm)

/-- **`ψ ∘ φ` is the quotient map.** -/
theorem cauchyψ_comp_cauchyφ :
    cauchyψ ∘ₗ cauchyφ = (LinearMap.range (cauchyα (S := S) (E := E) (F := F))).mkQ := by
  refine (LinearMap.cancel_right sqMul_id_surjective).1 ?_
  refine TensorProduct.ext_fourfold' fun e f e' f' => ?_
  rw [LinearMap.comp_apply, LinearMap.comp_apply, cauchyφ_sqMul_tmul, cauchyψ, lift.tmul,
    sqLift_sqMul_tmul]
  exact cauchyψK_apply e e' f f'

end Exactness

/-- **Exactness in the middle: the image of `α` is the kernel of `φ`**, for arbitrary
modules `E` and `F`. -/
theorem range_cauchyα :
    LinearMap.range (cauchyα (S := S) (E := E) (F := F)) = LinearMap.ker cauchyφ := by
  refine le_antisymm ?_ fun x hx => ?_
  · rintro _ ⟨x, rfl⟩
    rw [LinearMap.mem_ker, ← LinearMap.comp_apply, cauchyφ_comp_cauchyα, LinearMap.zero_apply]
  · have h := DFunLike.congr_fun cauchyψ_comp_cauchyφ x
    rwa [LinearMap.comp_apply, LinearMap.mem_ker.1 hx, map_zero, eq_comm, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero] at h

/-! ### Injectivity for free modules -/

section Free

variable {I J : Type*} [LinearOrder I] [LinearOrder J]

/-- The coefficient pairing on basis vectors
`(eₐ ⊗ f_b, e_c ⊗ f_d) ↦ (eₐ ∧ e_c) ⊗ (f_b ∧ f_d)` when `a < c` and `b < d`, or `c < a` and
`d < b`, and `0` otherwise. -/
def cauchyRetractPair (bE : Module.Basis I S E) (bF : Module.Basis J S F) (x y : I × J) :
    ⋀[S]^(1 + 1) E ⊗[S] ⋀[S]^(1 + 1) F :=
  if (x.1 < y.1 ∧ x.2 < y.2) ∨ (y.1 < x.1 ∧ y.2 < x.2) then
    wedgeMul (bE x.1 ⊗ₜ bE y.1) ⊗ₜ wedgeMul (bF x.2 ⊗ₜ bF y.2)
  else 0

/-- `cauchyRetractPair` is symmetric. -/
theorem cauchyRetractPair_symm (bE : Module.Basis I S E) (bF : Module.Basis J S F) (x y : I × J) :
    cauchyRetractPair bE bF x y = cauchyRetractPair bE bF y x := by
  unfold cauchyRetractPair
  rw [wedgeMul_swap (bE x.1), wedgeMul_swap (bF x.2), TensorProduct.neg_tmul,
    TensorProduct.tmul_neg, neg_neg]
  exact if_congr or_comm rfl rfl

/-- The symmetric bilinear map on `E ⊗ F` extending `cauchyRetractPair` from the tensor basis. -/
def cauchyRetractBil (bE : Module.Basis I S E) (bF : Module.Basis J S F) :
    E ⊗[S] F →ₗ[S] E ⊗[S] F →ₗ[S] ⋀[S]^(1 + 1) E ⊗[S] ⋀[S]^(1 + 1) F :=
  (bE.tensorProduct bF).constr S fun x =>
    (bE.tensorProduct bF).constr S fun y => cauchyRetractPair bE bF x y

/-- The value of `cauchyRetractBil` on a pair of tensor basis vectors. -/
theorem cauchyRetractBil_basis (bE : Module.Basis I S E) (bF : Module.Basis J S F)
    (a c : I) (b d : J) :
    cauchyRetractBil bE bF (bE a ⊗ₜ bF b) (bE c ⊗ₜ bF d) =
      cauchyRetractPair bE bF (a, b) (c, d) := by
  rw [cauchyRetractBil, ← Module.Basis.tensorProduct_apply, ← Module.Basis.tensorProduct_apply,
    Module.Basis.constr_basis, Module.Basis.constr_basis]

/-- `cauchyRetractBil` is symmetric. -/
theorem cauchyRetractBil_symm (bE : Module.Basis I S E) (bF : Module.Basis J S F) (u v : E ⊗[S] F) :
    cauchyRetractBil bE bF u v = cauchyRetractBil bE bF v u := by
  have h : cauchyRetractBil bE bF = (cauchyRetractBil bE bF).flip :=
    (bE.tensorProduct bF).ext fun x => (bE.tensorProduct bF).ext fun y => by
      rw [LinearMap.flip_apply, cauchyRetractBil, Module.Basis.constr_basis,
        Module.Basis.constr_basis, Module.Basis.constr_basis, Module.Basis.constr_basis,
        cauchyRetractPair_symm]
  exact DFunLike.congr_fun (DFunLike.congr_fun h u) v

/-- The left inverse `ρ : Sym²(E ⊗ F) → ⋀²E ⊗ ⋀²F` of `α` attached to ordered bases. -/
def cauchyRetract (bE : Module.Basis I S E) (bF : Module.Basis J S F) :
    symmetricPower (1 + 1) S (E ⊗[S] F) →ₗ[S] ⋀[S]^(1 + 1) E ⊗[S] ⋀[S]^(1 + 1) F :=
  sqLift (cauchyRetractBil bE bF) (cauchyRetractBil_symm bE bF)

/-- **`ρ ∘ α = 1`** for ordered bases of `E` and `F`. -/
theorem cauchyRetract_comp_cauchyα (bE : Module.Basis I S E) (bF : Module.Basis J S F) :
    cauchyRetract bE bF ∘ₗ cauchyα = LinearMap.id := by
  refine (LinearMap.cancel_right map_wedgeMul_surjective).1 ?_
  refine ((bE.tensorProduct bE).tensorProduct (bF.tensorProduct bF)).ext fun ⟨⟨a, c⟩, ⟨b, d⟩⟩ => ?_
  rw [LinearMap.id_comp, Module.Basis.tensorProduct_apply, Module.Basis.tensorProduct_apply,
    Module.Basis.tensorProduct_apply, LinearMap.comp_apply, LinearMap.comp_apply,
    TensorProduct.map_tmul, cauchyα_wedgeMul_tmul, map_sub, cauchyRetract, sqLift_sqMul_tmul,
    sqLift_sqMul_tmul, cauchyRetractBil_basis, cauchyRetractBil_basis]
  unfold cauchyRetractPair
  rcases lt_trichotomy a c with hac | rfl | hac <;>
    rcases lt_trichotomy b d with hbd | rfl | hbd <;> first
    | (simp [wedgeMul_self]; done)
    | (simp [hac, hbd, hac.not_gt, hbd.not_gt]; done)
    | simp [hac, hbd, hac.not_gt, hbd.not_gt, wedgeMul_swap (bF d) (bF b), TensorProduct.tmul_neg]

/-- `α` is injective for modules with bases. -/
theorem cauchyα_injective_of_basis (bE : Module.Basis I S E) (bF : Module.Basis J S F) :
    Function.Injective (cauchyα (S := S) (E := E) (F := F)) :=
  Function.LeftInverse.injective (g := cauchyRetract bE bF) fun z =>
    DFunLike.congr_fun (cauchyRetract_comp_cauchyα bE bF) z

end Free

/-- **`α : ⋀²E ⊗ ⋀²F → Sym²(E ⊗ F)` is injective when `E` and `F` are free.** -/
theorem cauchyα_injective [Module.Free S E] [Module.Free S F] :
    Function.Injective (cauchyα (S := S) (E := E) (F := F)) := by
  let := IsWellOrder.linearOrder (WellOrderingRel : Module.Free.ChooseBasisIndex S E → _ → Prop)
  let := IsWellOrder.linearOrder (WellOrderingRel : Module.Free.ChooseBasisIndex S F → _ → Prop)
  exact cauchyα_injective_of_basis (Module.Free.chooseBasis S E) (Module.Free.chooseBasis S F)

end SymPow

end
