module

public import Mathlib.Algebra.Module.ZMod
public import Mathlib.Algebra.Field.ZMod
public import Mathlib.LinearAlgebra.Dimension.Free
public import Mathlib.LinearAlgebra.Dimension.Finite
public import Mathlib.LinearAlgebra.FiniteDimensional.Defs
public import Mathlib.LinearAlgebra.Basis.VectorSpace

/-!
# Generators of `A / ℓA` for a torsion-free abelian group of finite rank

Let `A` be an abelian group without `ℓ`-torsion, `ℓ` a prime, with `rank_ℤ A ≤ r` (the rank of
a torsion-free group is its rational rank `dim_ℚ (A ⊗ ℚ)`). Then `A / ℓA` is generated by at most
`r` elements: there are `d ≤ r` and `β_1, …, β_d ∈ A` such that every `γ ∈ A` is
`∑ mᵢ βᵢ + ℓ δ`. Indeed, lifts to `A` of `𝔽_ℓ`-linearly independent elements of `A / ℓA` are
`ℤ`-linearly independent: a relation `∑ gᵢ βᵢ = 0` with not all `gᵢ` divisible by `ℓ` reduces to
a nontrivial relation modulo `ℓ`, and if all are divisible one divides by `ℓ` (no `ℓ`-torsion)
and concludes by induction on `∑ |gᵢ|`. Hence `dim_{𝔽_ℓ} (A / ℓA) ≤ rank_ℤ A ≤ r`.

## Main results

* `AddCommGroup.linearIndependent_of_linearIndependent_mod`: lifting linear independence.
* `AddCommGroup.exists_generators_mod_nsmul`: `A / ℓA` has at most `r` generators.
-/

@[expose] public noncomputable section

namespace AddCommGroup

variable {A : Type*} [AddCommGroup A] {ℓ : ℕ}

/-- `A / ℓA` as an `𝔽_ℓ`-vector space. -/
abbrev ModNSMul (A : Type*) [AddCommGroup A] (ℓ : ℕ) : Type _ :=
  A ⧸ (nsmulAddMonoidHom (α := A) ℓ).range

/-- The `ZMod ℓ`-module structure of `A / ℓA`. -/
instance instModuleModNSMul [NeZero ℓ] : Module (ZMod ℓ) (ModNSMul A ℓ) :=
  AddCommGroup.zmodModule fun q ↦ by
    induction q using QuotientAddGroup.induction_on with
    | H x =>
      rw [← QuotientAddGroup.mk_nsmul, QuotientAddGroup.eq_zero_iff]
      exact ⟨x, rfl⟩

/-- **Lifts of `𝔽_ℓ`-independent elements of `A / ℓA` are `ℤ`-independent** when `A` has no
`ℓ`-torsion. -/
theorem linearIndependent_of_linearIndependent_mod [NeZero ℓ] (hℓ : ℓ.Prime)
    (htf : ∀ x : A, ℓ • x = 0 → x = 0) {ι : Type*} [Finite ι] (f : ι → A)
    (hli : LinearIndependent (ZMod ℓ) fun i ↦ (QuotientAddGroup.mk (f i) : ModNSMul A ℓ)) :
    LinearIndependent ℤ f := by
  let _ := Fintype.ofFinite ι
  rw [Fintype.linearIndependent_iff] at hli ⊢
  suffices h : ∀ N : ℕ, ∀ g : ι → ℤ, ∑ i, (g i).natAbs = N → ∑ i, g i • f i = 0 →
      ∀ i, g i = 0 from fun g hg ↦ h _ g rfl hg
  intro N
  induction N using Nat.strong_induction_on with
  | _ N ih =>
  intro g hN hg
  by_cases hdiv : ∀ i, (ℓ : ℤ) ∣ g i
  · choose g' hg' using hdiv
    have hsum : ℓ • ∑ i, g' i • f i = 0 := by
      rw [Finset.smul_sum, ← hg]
      refine Finset.sum_congr rfl fun i _ ↦ ?_
      rw [hg' i, mul_smul, natCast_zsmul, smul_comm]
    have hg'0 := htf _ hsum
    have hN' : ∑ i, (g' i).natAbs * ℓ = N := by
      rw [← hN]
      refine Finset.sum_congr rfl fun i _ ↦ ?_
      rw [hg' i, Int.natAbs_mul, Int.natAbs_natCast, mul_comm]
    rcases Nat.eq_zero_or_pos (∑ i, (g' i).natAbs) with h0 | hpos
    · intro i
      have : (g' i).natAbs = 0 :=
        Finset.sum_eq_zero_iff.mp h0 i (Finset.mem_univ i)
      rw [hg' i, Int.natAbs_eq_zero.mp this, mul_zero]
    · have hlt : ∑ i, (g' i).natAbs < N := by
        rw [← hN', ← Finset.sum_mul]
        exact lt_mul_of_one_lt_right hpos hℓ.one_lt
      intro i
      rw [hg' i, ih _ hlt g' rfl hg'0 i, mul_zero]
  · exfalso
    push Not at hdiv
    obtain ⟨i, hi⟩ := hdiv
    apply hi
    have hz := hli (fun j ↦ (g j : ZMod ℓ)) (by
      have : (QuotientAddGroup.mk (∑ j, g j • f j) : ModNSMul A ℓ) = 0 := by rw [hg]; rfl
      rw [← this, QuotientAddGroup.mk_sum]
      refine Finset.sum_congr rfl fun j _ ↦ ?_
      rw [Int.cast_smul_eq_zsmul, QuotientAddGroup.mk_zsmul]) i
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd _ _).mp hz

/-- **`A / ℓA` is generated by at most `rank_ℤ A` elements** for an abelian group `A` without
`ℓ`-torsion. -/
theorem exists_generators_mod_nsmul (hℓ : ℓ.Prime) (htf : ∀ x : A, ℓ • x = 0 → x = 0)
    {r : ℕ} (hrank : Module.rank ℤ A ≤ r) :
    ∃ d ≤ r, ∃ β : Fin d → A, ∀ γ : A, ∃ (m : Fin d → ℕ) (δ : A),
      γ = ∑ i, m i • β i + ℓ • δ := by
  have : Fact ℓ.Prime := ⟨hℓ⟩
  have : NeZero ℓ := ⟨hℓ.ne_zero⟩
  have hrankQ : Module.rank (ZMod ℓ) (ModNSMul A ℓ) ≤ r := by
    refine rank_le fun s hs ↦ ?_
    choose f hf using fun i : s ↦ QuotientAddGroup.mk_surjective (i : (ModNSMul A ℓ))
    have hli : LinearIndependent ℤ f :=
      linearIndependent_of_linearIndependent_mod hℓ htf f (by
        have hfun : (fun i ↦ (QuotientAddGroup.mk (f i) : ModNSMul A ℓ)) =
            fun i : s ↦ (i : ModNSMul A ℓ) := funext hf
        rw [hfun]
        exact hs)
    have := hli.cardinal_le_rank
    rw [Cardinal.mk_coe_finset] at this
    exact_mod_cast this.trans hrank
  have : Module.Finite (ZMod ℓ) (ModNSMul A ℓ) :=
    Module.rank_lt_aleph0_iff.mp (hrankQ.trans_lt (Cardinal.natCast_lt_aleph0))
  have hd : Module.finrank (ZMod ℓ) (ModNSMul A ℓ) ≤ r := by
    have := Module.finrank_eq_rank (R := ZMod ℓ) (M := (ModNSMul A ℓ))
    rw [← this] at hrankQ
    exact_mod_cast hrankQ
  set b := Module.finBasis (ZMod ℓ) (ModNSMul A ℓ)
  choose β hβ using fun i ↦ QuotientAddGroup.mk_surjective (b i)
  refine ⟨_, hd, β, fun γ ↦ ?_⟩
  refine ⟨fun i ↦ (b.repr (QuotientAddGroup.mk γ) i).val, ?_⟩
  have hsum : (QuotientAddGroup.mk γ : (ModNSMul A ℓ)) =
      QuotientAddGroup.mk (∑ i, (b.repr (QuotientAddGroup.mk γ) i).val • β i) := by
    conv_lhs => rw [← b.sum_repr (QuotientAddGroup.mk γ)]
    rw [QuotientAddGroup.mk_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [QuotientAddGroup.mk_nsmul, hβ i, ← Nat.cast_smul_eq_nsmul (ZMod ℓ), ZMod.natCast_zmod_val]
  obtain ⟨δ, hδ⟩ := AddMonoidHom.mem_range.mp ((QuotientAddGroup.eq_iff_sub_mem).mp hsum)
  refine ⟨δ, ?_⟩
  rw [nsmulAddMonoidHom_apply] at hδ
  rw [hδ]
  abel

end AddCommGroup

end
