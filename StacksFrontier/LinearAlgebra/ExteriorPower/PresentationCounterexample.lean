module

public import Mathlib.Algebra.Polynomial.Coeff
public import Mathlib.Data.ZMod.Basic
public import StacksFrontier.LinearAlgebra.ExteriorPower.Presentation

/-!
# The printed form of Stacks 0H1C fails for `n = 2`

Stacks 0H1C asserts that, for a ring map `A → B`, a `B`-module `M` and `n > 1`, the kernel of
the canonical `A`-linear map `M ⊗_A ⋯ ⊗_A M → ⋀[B]^n M` is generated as an `A`-module by the
pure tensors with two equal entries together with the differences
`m₁ ⊗ ⋯ ⊗ b mᵢ ⊗ ⋯ ⊗ mₙ - m₁ ⊗ ⋯ ⊗ b mⱼ ⊗ ⋯ ⊗ mₙ`.  This holds for `n ≥ 3`
(`exteriorPower.ker_eq_span_of_tprod_eq_ιMulti_of_two_lt`) and, with first family
`mᵢ = b • mⱼ`, for all `n ≥ 1` (`exteriorPower.ker_eq_span_of_tprod_eq_ιMulti`); this file shows
that it fails for `n = 2`, with `A = ℤ` and `B = M = ℤ[X]`.

## Main results

* `exteriorPower.ker_ne_span_of_tprod_eq_ιMulti_two`: the counterexample.
* `exteriorPower.not_forall_ker_eq_span_of_tprod_eq_ιMulti`: the printed statement is false.

## References

* [Stacks 0H1C](https://stacks.math.columbia.edu/tag/0H1C)
-/

@[expose] public section

open scoped TensorProduct

open Function PiTensorProduct

namespace exteriorPower

open Polynomial

/-- The `ℤ`-linear form on `ℤ[X] ⊗_ℤ ℤ[X]` sending `f ⊗ g` to the coefficient of `X` in `f g`,
reduced mod `2`. -/
private noncomputable def coeffOneModTwo : (⨂[ℤ]^2 ℤ[X]) →ₗ[ℤ] ZMod 2 :=
  lift (((Int.castAddHom (ZMod 2)).toIntLinearMap ∘ₗ Polynomial.lcoeff ℤ 1).compMultilinearMap
    (MultilinearMap.mkPiAlgebra ℤ (Fin 2) ℤ[X]))

private lemma coeffOneModTwo_tprod (m : Fin 2 → ℤ[X]) :
    coeffOneModTwo (tprod ℤ m) = ((m 0 * m 1).coeff 1 : ZMod 2) := by
  simp [coeffOneModTwo, Fin.prod_univ_two]

/-- For `A = ℤ`, `B = ℤ[X]`, `M = B` and `n = 2`, the kernel of the canonical map
`B ⊗_ℤ B → ⋀²_B B` is not generated by the tensors with two equal entries together with the
scaling differences: the tensor `1 ⊗ X` lies in the kernel, since `⋀²_B B = 0`, but the
`ℤ`-linear form `f ⊗ g ↦ (coefficient of X in f g) mod 2` kills every `f ⊗ f` (on which it is
`2 f₀ f₁`) and every `(b f) ⊗ g - f ⊗ (b g)`, while it sends `1 ⊗ X` to `1`. -/
theorem ker_ne_span_of_tprod_eq_ιMulti_two (φ : (⨂[ℤ]^2 ℤ[X]) →ₗ[ℤ] ⋀[ℤ[X]]^2 ℤ[X])
    (hφ : ∀ m : Fin 2 → ℤ[X], φ (tprod ℤ m) = exteriorPower.ιMulti ℤ[X] 2 m) :
    LinearMap.ker φ ≠
      Submodule.span ℤ
        ({x | ∃ (m : Fin 2 → ℤ[X]) (i j : Fin 2), i ≠ j ∧ m i = m j ∧ tprod ℤ m = x} ∪
          {x | ∃ (m : Fin 2 → ℤ[X]) (i j : Fin 2) (b : ℤ[X]), i ≠ j ∧
              tprod ℤ (update m i (b • m i)) - tprod ℤ (update m j (b • m j)) = x}) := by
  intro h
  have hmem : tprod ℤ ![1, X] ∈ LinearMap.ker φ := by
    rw [LinearMap.mem_ker, hφ]
    exact (exteriorPower.ιMulti ℤ[X] 2).map_eq_zero_of_eq_smul_self (i := 1) (j := 0)
      (by decide) X (by simp)
  have hle : LinearMap.ker φ ≤ LinearMap.ker coeffOneModTwo := by
    rw [h, Submodule.span_le]
    rintro x (⟨m, i, j, hij, hm, rfl⟩ | ⟨m, i, j, b, hij, rfl⟩)
    · simp only [SetLike.mem_coe, LinearMap.mem_ker, coeffOneModTwo_tprod]
      have h01 : m 0 = m 1 := by
        fin_cases i <;> fin_cases j <;> simp_all
      have hc : (m 1 * m 1).coeff 1 = 2 * ((m 1).coeff 0 * (m 1).coeff 1) := by
        rw [Polynomial.coeff_mul, Finset.Nat.antidiagonal_succ]
        simp
        ring
      rw [h01, hc]
      push_cast
      rw [show (2 : ZMod 2) = 0 from rfl, zero_mul]
    · simp only [SetLike.mem_coe, LinearMap.mem_ker, map_sub, coeffOneModTwo_tprod, sub_eq_zero]
      fin_cases i <;> fin_cases j <;> simp_all <;> ring_nf
  simpa [coeffOneModTwo_tprod] using hle hmem

end exteriorPower

/-- **Stacks 0H1C, as printed, is false for `n = 2`.**  The literal statement — for every ring
map `A → B`, every `B`-module `M` and every `n > 1`, the kernel of the canonical `A`-linear map
`M ⊗_A ⋯ ⊗_A M → ⋀[B]^n M` is generated as an `A`-module by the pure tensors with two equal
entries `mᵢ = mⱼ`, `i ≠ j`, together with the differences
`m₁ ⊗ ⋯ ⊗ b mᵢ ⊗ ⋯ ⊗ mₙ - m₁ ⊗ ⋯ ⊗ b mⱼ ⊗ ⋯ ⊗ mₙ` — fails for `A = ℤ`, `B = M = ℤ[X]`,
`n = 2`, by `exteriorPower.ker_ne_span_of_tprod_eq_ιMulti_two`. -/
@[stacks 0H1C "the stated form is false for `n = 2`"]
theorem exteriorPower.not_forall_ker_eq_span_of_tprod_eq_ιMulti :
    ¬ ∀ (A B M : Type) [CommRing A] [CommRing B] [Algebra A B] [AddCommGroup M] [Module A M]
      [Module B M] [IsScalarTower A B M] (n : ℕ), 1 < n →
      ∀ φ : (⨂[A]^n M) →ₗ[A] ⋀[B]^n M,
        (∀ m : Fin n → M, φ (tprod A m) = exteriorPower.ιMulti B n m) →
        LinearMap.ker φ =
          Submodule.span A
            ({x | ∃ (m : Fin n → M) (i j : Fin n), i ≠ j ∧ m i = m j ∧ tprod A m = x} ∪
              {x | ∃ (m : Fin n → M) (i j : Fin n) (b : B), i ≠ j ∧
                  tprod A (update m i (b • m i)) - tprod A (update m j (b • m j)) = x}) := by
  intro h
  let φ : (⨂[ℤ]^2 (Polynomial ℤ)) →ₗ[ℤ] ⋀[Polynomial ℤ]^2 (Polynomial ℤ) :=
    lift ((exteriorPower.ιMulti (Polynomial ℤ) 2).toMultilinearMap.restrictScalars ℤ)
  have hφ : ∀ m : Fin 2 → Polynomial ℤ, φ (tprod ℤ m) = exteriorPower.ιMulti _ 2 m := fun m ↦ by
    simp [φ]
  exact exteriorPower.ker_ne_span_of_tprod_eq_ιMulti_two φ hφ
    (h ℤ (Polynomial ℤ) (Polynomial ℤ) 2 (by norm_num) φ hφ)
