module

public import Mathlib.LinearAlgebra.TensorProduct.Basic
public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.LinearAlgebra.Span.Basic
public import Mathlib.LinearAlgebra.Isomorphisms

/-!
# Tensoring with a generator of a cyclic module

Let `N` be a cyclic `A`-module generated by `ξ`. Then `N ⊗_A N ≅ N`, and in particular the map
`N ⟶ N ⊗_A N`, `v ↦ ξ ⊗ v`, is injective: the bilinear map `(a ξ, v) ↦ a v` is well defined,
because an element of `A` killing `ξ` kills all of `N`, and it retracts `v ↦ ξ ⊗ v`.

This is the algebra closing the diagonal argument of [Stacks, Tag 0G8J]: there the generator is
the class `ξ = γ^{0,0}(1)` of a section in `Hⁿ(X, Ωⁿ_{X/A})`, and an identity
`ξ ⊗ d(θ) = 0` in the Künneth decomposition of `H^{2n}(X ×_A X, Ω^{2n}_{X ×_A X/A})` forces
`d(θ) = 0`.

## Main results

* `Module.eq_zero_of_tmul_eq_zero_of_span_eq_top`: if `ξ` generates `N` and `ξ ⊗ v = 0` in
  `N ⊗_A N`, then `v = 0`.
* `Module.eq_zero_of_diagonal_identity`: the diagonal argument of [Stacks, Tag 0G8J], in the
  abstract.
-/

@[expose] public noncomputable section

open scoped TensorProduct

universe u v w

namespace Module

variable {A : Type u} [CommRing A] {N : Type v} [AddCommGroup N] [Module A N]

/-- **Scalar multiplication through a generator.** If `ξ` generates `N`, the map `a ↦ a • -`
of `A` into the endomorphisms of `N` factors through `a ↦ a • ξ`: an element of `A` killing `ξ`
kills `N`. -/
def smulOfGenerator (ξ : N) (hξ : Submodule.span A {ξ} = ⊤) : N →ₗ[A] N →ₗ[A] N :=
  let π : A →ₗ[A] N := LinearMap.toSpanSingleton A N ξ
  have hπ : Function.Surjective π := by
    rw [← LinearMap.range_eq_top, LinearMap.range_toSpanSingleton, hξ]
  let φ₀ : A →ₗ[A] N →ₗ[A] N := LinearMap.lsmul A N
  have hker : LinearMap.ker π ≤ LinearMap.ker φ₀ := by
    intro a ha
    rw [LinearMap.mem_ker] at ha ⊢
    ext v
    obtain ⟨b, rfl⟩ := hπ v
    change a • (b • ξ) = 0
    rw [smul_comm, show a • ξ = 0 from ha, smul_zero]
  (π.ker.liftQ φ₀ hker).comp (π.quotKerEquivOfSurjective hπ).symm.toLinearMap

/-- `smulOfGenerator ξ hξ` sends `(a • ξ, v)` to `a • v`. -/
theorem smulOfGenerator_smul (ξ : N) (hξ : Submodule.span A {ξ} = ⊤) (a : A) (v : N) :
    smulOfGenerator ξ hξ (a • ξ) v = a • v := by
  have hπ : Function.Surjective (LinearMap.toSpanSingleton A N ξ) := by
    rw [← LinearMap.range_eq_top, LinearMap.range_toSpanSingleton, hξ]
  have h : ((LinearMap.toSpanSingleton A N ξ).quotKerEquivOfSurjective hπ).symm (a • ξ) =
      Submodule.Quotient.mk a := by
    rw [LinearEquiv.symm_apply_eq]
    rfl
  simp only [smulOfGenerator, LinearMap.coe_comp, LinearEquiv.coe_coe, Function.comp_apply]
  rw [h, Submodule.liftQ_apply]
  rfl

/-- **Tensoring with a generator is injective**: if `ξ` generates `N` and `ξ ⊗ v = 0` in
`N ⊗_A N`, then `v = 0`. -/
theorem eq_zero_of_tmul_eq_zero_of_span_eq_top (ξ : N) (hξ : Submodule.span A {ξ} = ⊤) (v : N)
    (h : ξ ⊗ₜ[A] v = 0) : v = 0 := by
  have h1 := congrArg (TensorProduct.lift (smulOfGenerator ξ hξ)) h
  rw [TensorProduct.lift.tmul, map_zero] at h1
  have h2 := smulOfGenerator_smul ξ hξ 1 v
  rw [one_smul, one_smul] at h2
  rw [← h2, h1]

variable {M : Type w} [AddCommGroup M] [Module A M]
  {T T' : Type*} [AddCommGroup T] [Module A T] [AddCommGroup T'] [Module A T']

/-- **The diagonal argument of [Stacks, Tag 0G8J], in the abstract.** Let `ξ` generate `N`, let
`δ : M ⟶ N` be linear (the de Rham differential `Hⁿ(Ω^{n-1}) ⟶ Hⁿ(Ωⁿ)`), let
`κ : N ⊗ N ⟶ T` be injective and `κ₁ : M ⊗ N ⟶ T'`, `κ₂ : N ⊗ M ⟶ T'` be linear (the Künneth maps
into `H^{2n}(X ×_A X, Ω^{2n})` and `H^{2n}(X ×_A X, Ω^{2n-1})`), and let `D : T' ⟶ T` be additive
(the de Rham differential of the product), with `D ∘ κ₁ = κ ∘ (δ ⊗ 1)` and
`D ∘ κ₂ = ε • κ ∘ (1 ⊗ δ)` for a unit `ε` (the Koszul sign `(-1)ⁿ`). If maps `G : M ⟶ T'` and
`G' : N ⟶ T` (the Gysin maps of the diagonal) satisfy `D ∘ G = G' ∘ δ`,
`G θ = κ₁ (θ ⊗ ξ) + κ₂ (ξ ⊗ θ)` and `G' x = κ (x ⊗ ξ)`, then `δ = 0`. -/
theorem eq_zero_of_diagonal_identity (ξ : N) (hξ : Submodule.span A {ξ} = ⊤) (δ : M →ₗ[A] N)
    (κ : N ⊗[A] N →ₗ[A] T) (hκ : Function.Injective κ) (κ₁ : M ⊗[A] N →ₗ[A] T')
    (κ₂ : N ⊗[A] M →ₗ[A] T') (D : T' →+ T) (ε : Aˣ)
    (hD₁ : ∀ θ x, D (κ₁ (θ ⊗ₜ x)) = κ (δ θ ⊗ₜ x))
    (hD₂ : ∀ x θ, D (κ₂ (x ⊗ₜ θ)) = ε • κ (x ⊗ₜ δ θ)) (G : M → T') (G' : N → T)
    (hDG : ∀ θ, D (G θ) = G' (δ θ)) (hG : ∀ θ, G θ = κ₁ (θ ⊗ₜ ξ) + κ₂ (ξ ⊗ₜ θ))
    (hG' : ∀ x, G' x = κ (x ⊗ₜ ξ)) : δ = 0 := by
  ext θ
  have h := hDG θ
  rw [hG, map_add, hD₁, hD₂, hG', add_eq_left] at h
  have h' : κ (ξ ⊗ₜ δ θ) = 0 := by
    have := congrArg (fun t => ε⁻¹ • t) h
    simp only [smul_zero, inv_smul_smul] at this
    exact this
  exact eq_zero_of_tmul_eq_zero_of_span_eq_top ξ hξ _ (hκ (h'.trans (map_zero κ).symm))

end Module
