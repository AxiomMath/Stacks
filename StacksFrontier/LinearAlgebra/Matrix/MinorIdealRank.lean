module

public import Mathlib
public import StacksFrontier.LinearAlgebra.Matrix.MinorIdeal
public import StacksFrontier.RingTheory.Fitting.Basic

/-!
# The ideal of minors and the rank of a matrix over a field

For a matrix `B` over a field `K` the ideal `I_r(B)` generated by the `r × r` minors of `B` is
either `0` or `K`, and this module identifies which: it is the unit ideal exactly when
`r ≤ rank B`.  This is the determinantal description of the rank, stated so that it transfers
along a ring homomorphism: `I_r(φ(B)) = φ(I_r(B))`.

## Main results

* `StacksDraft.MinorRank.minorIdeal_map`: the ideal of minors of the entrywise image of a matrix
  is the image of the ideal of minors.
* `StacksDraft.MinorRank.fittingIdeal_eq_top_iff_finrank_le`: over a field the `k`-th Fitting
  ideal of a finite-dimensional vector space is the unit ideal exactly when its dimension is at
  most `k`.
* `StacksDraft.MinorRank.minorIdeal_eq_top_iff_le_rank`: over a field, `I_r(B) = K` if and only if
  `r ≤ rank B`.

## Implementation notes

The nontrivial half is `minorIdeal_eq_top_iff_le_rank`, whose usual proof extracts `r`
independent rows and `r` independent columns.  It is obtained here instead from the theory of
Fitting ideals: the cokernel `V` of `B`, viewed as a map `K^a → K^b`, is presented by `B` itself,
so [Stacks, Tag 07Z9] (`fittingIdeal_eq_minorIdeal_of_presentation`) identifies `I_r(B)` with the
Fitting ideal `Fit_{b-r}(V)`, while over a field a vector space of dimension `d` is presented with
no relations at all, so its Fitting ideals are computed by `minorIdeal_zero` and
`minorIdeal_eq_bot_of_card_lt`.  Since `dim V = b - rank B`, the two computations combine to the
statement.

## References

* [Stacks Project, Tag 07Z9](https://stacks.math.columbia.edu/tag/07Z9)
-/

@[expose] public section

namespace StacksDraft.MinorRank

/-! ### Transfer along a ring homomorphism -/

/-- **The ideal of minors of an entrywise image.**  For `φ : R → S` the `r × r` minors of the
matrix `φ(A)` are the images of the `r × r` minors of `A`, so `I_r(φ(A)) = φ(I_r(A))`. -/
theorem minorIdeal_map {R S : Type*} [CommRing R] [CommRing S] {l o : Type*}
    (φ : R →+* S) (A : Matrix l o R) (r : ℕ) :
    minorIdeal (A.map φ) r = Ideal.map φ (minorIdeal A r) := by
  rw [minorIdeal, minorIdeal, Ideal.map_span]
  congr 1
  ext x
  constructor
  · rintro ⟨f, g, rfl⟩
    refine ⟨(A.submatrix f g).det, ⟨f, g, rfl⟩, ?_⟩
    rw [RingHom.map_det, RingHom.mapMatrix_apply, Matrix.submatrix_map]
  · rintro ⟨y, ⟨f, g, rfl⟩, rfl⟩
    exact ⟨f, g, by
      rw [Matrix.submatrix_map, RingHom.map_det, RingHom.mapMatrix_apply]⟩

/-! ### Fitting ideals over a field -/

/-- **Over a field the Fitting ideals detect the dimension.**  For a finite-dimensional vector
space `V` over a field `K`, the `k`-th Fitting ideal of `V` is the unit ideal exactly when
`dim_K V ≤ k`.

A vector space of dimension `d` has the presentation `K^d ⧸ 0`, with no relations, so its `k`-th
Fitting ideal is the ideal of `(d - k) × (d - k)` minors of the matrix with `d` rows and no
columns: the unit ideal when `d ≤ k` and the zero ideal otherwise. -/
theorem fittingIdeal_eq_top_iff_finrank_le {K : Type*} [Field K] {V : Type*}
    [AddCommGroup V] [Module K V] [FiniteDimensional K V] (k : ℕ) :
    fittingIdeal (R := K) (M := V) (k : ℤ) = ⊤ ↔ Module.finrank K V ≤ k := by
  set d := Module.finrank K V
  have hspan : Submodule.span K (Set.range (fun j : Fin 0 =>
      fun i : Fin d => (0 : Matrix (Fin d) (Fin 0) K) i j)) = ⊥ := by
    simp
  let e : ((Fin d → K) ⧸ Submodule.span K (Set.range (fun j : Fin 0 =>
      fun i : Fin d => (0 : Matrix (Fin d) (Fin 0) K) i j))) ≃ₗ[K] V :=
    (Submodule.quotEquivOfEqBot _ hspan).trans (Module.finBasis K V).equivFun.symm
  rw [fittingIdeal_eq_minorIdeal_of_presentation (0 : Matrix (Fin d) (Fin 0) K) k e]
  refine ⟨fun htop => ?_, fun hle => ?_⟩
  · by_contra hlt
    rw [minorIdeal_eq_bot_of_card_lt _ _ (Or.inr (by simp; omega))] at htop
    exact bot_ne_top htop
  · rw [Nat.sub_eq_zero_of_le hle, minorIdeal_zero]

/-! ### The ideal of minors and the rank -/

/-- The span of the columns of a matrix is the range of the associated linear map. -/
theorem span_range_col_eq_range_mulVecLin {K : Type*} [CommRing K] {b a : ℕ}
    (B : Matrix (Fin b) (Fin a) K) :
    Submodule.span K (Set.range (fun j : Fin a => fun i : Fin b => B i j)) =
      LinearMap.range B.mulVecLin := by
  rw [Matrix.range_mulVecLin]
  rfl

/-- **The determinantal description of the rank of a matrix over a field.**  For
`B : Matrix (Fin b) (Fin a) K` over a field `K`, the ideal generated by the `r × r` minors of `B`
is the unit ideal exactly when `r ≤ rank B`.

The cokernel `V = K^b ⧸ im B` is presented by `B`, so `I_r(B) = Fit_{b-r}(V)` by
[Stacks, Tag 07Z9]; by `fittingIdeal_eq_top_iff_finrank_le` that ideal is the unit ideal exactly
when `dim V ≤ b - r`, and `dim V = b - rank B`. -/
theorem minorIdeal_eq_top_iff_le_rank {K : Type*} [Field K] {b a : ℕ}
    (B : Matrix (Fin b) (Fin a) K) (r : ℕ) :
    minorIdeal B r = ⊤ ↔ r ≤ B.rank := by
  have hrkle : B.rank ≤ b := Matrix.rank_le_height B
  by_cases hrb : b < r
  · rw [minorIdeal_eq_bot_of_card_lt _ _ (Or.inl (by simpa using hrb))]
    simp only [bot_ne_top, false_iff, not_le]
    omega
  push Not at hrb
  -- the cokernel of `B`, presented by `B` itself
  set W := LinearMap.range B.mulVecLin with hW
  set V := (Fin b → K) ⧸ W with hV
  have hVdim : Module.finrank K V + B.rank = b := by
    simpa [hV, hW, Matrix.rank] using Submodule.finrank_quotient_add_finrank W
  let e : ((Fin b → K) ⧸ Submodule.span K
      (Set.range (fun j : Fin a => fun i : Fin b => B i j))) ≃ₗ[K] V :=
    Submodule.Quotient.equiv _ _ (LinearEquiv.refl K _)
      (by simpa [hW] using span_range_col_eq_range_mulVecLin B)
  have hfit : fittingIdeal (R := K) (M := V) ((b - r : ℕ) : ℤ) =
      minorIdeal B (b - (b - r)) :=
    fittingIdeal_eq_minorIdeal_of_presentation B (b - r) e
  rw [Nat.sub_sub_self hrb] at hfit
  rw [← hfit, fittingIdeal_eq_top_iff_finrank_le]
  omega

end StacksDraft.MinorRank

end
