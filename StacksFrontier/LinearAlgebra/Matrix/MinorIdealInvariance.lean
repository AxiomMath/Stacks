module

public import StacksFrontier.Algebra.Homology.ProjectiveDimension
public import StacksFrontier.LinearAlgebra.Matrix.MinorIdeal
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Invariance of the ideals of minors under change of presentation

Let `R` be a commutative ring and let `A` and `B` be matrices with `n` and `m` rows whose columns
span submodules `U ⊆ Rⁿ` and `V ⊆ Rᵐ`. If the cokernels `Rⁿ ⧸ U` and `Rᵐ ⧸ V` are isomorphic as
`R`-modules, then `I_{n-k}(A) = I_{m-k}(B)` for every `k`. This is the invariance statement that
makes the Fitting ideals of a finite module well defined: the ideal generated by the
`(n - k) × (n - k)` minors of a presentation matrix depends only on the module presented and on
`k`, not on the presentation.

## Main results

* `minorIdeal_eq_of_quotientLinearEquiv`: two presentation matrices of isomorphic cokernels have
  equal minor ideals in complementary degrees.

## Implementation notes

The proof follows the source. The ideal of minors is first re-described intrinsically, as an
ideal `spanMinorIdeal U r` attached to the column span `U` alone rather than to the matrix: it is
generated by the determinants `det (vᵢ (f j))` for tuples `v` of elements of `U` and index maps
`f`. That this agrees with `minorIdeal A r` for `U = columnSpan A`
(`minorIdeal_eq_spanMinorIdeal`) is the content of the first block of lemmas, and it uses
multilinearity of the determinant in the rows to reduce a tuple drawn from the span to a tuple of
actual columns.

Two invariances of `spanMinorIdeal` are then established: it is unchanged by an automorphism of
`Rⁿ` carrying one submodule onto the other (`spanMinorIdeal_map_eq`, from Stacks 07Z7 part 3), and
it is unchanged by stabilizing, that is by replacing `U ⊆ Rⁿ` with `U × Rᵐ ⊆ Rⁿ⁺ᵐ` and raising
the degree by `m` (`spanMinorIdeal_stabilize`, from Stacks 07Z7 part 4 applied to a block diagonal
matrix with an identity block). Schanuel's lemma (Stacks 00O3, `schanuel`) supplies the
automorphism of `Rⁿ ⊕ Rᵐ` matching the two stabilized submodules, and the two invariances then
identify the two minor ideals.

## References

* [Stacks Project, Tag 07Z8](https://stacks.math.columbia.edu/tag/07Z8)
-/

@[expose] public section

private def columnSpan {R : Type*} [CommRing R] {ι κ : Type*}
    (A : Matrix ι κ R) : Submodule R (ι → R) :=
  Submodule.span R (Set.range fun j : κ => fun i : ι => A i j)

private def rowMatrix {R : Type*} {ι : Type*} {r : ℕ}
    (f : Fin r → ι) (v : Fin r → (ι → R)) : Matrix (Fin r) (Fin r) R :=
  Matrix.of fun i j => v i (f j)

private lemma rowMatrix_update {R : Type*} {ι : Type*} {r : ℕ}
    (f : Fin r → ι) (v : Fin r → (ι → R)) (i : Fin r) (x : ι → R) :
    rowMatrix f (Function.update v i x) =
      Matrix.updateRow (rowMatrix f v) i (fun j => x (f j)) := by
  ext a b
  by_cases h : a = i <;> simp [rowMatrix, Matrix.updateRow, Function.update, h]

private lemma rowMatrix_columns_det {R : Type*} [CommRing R] {ι κ : Type*} (A : Matrix ι κ R)
    {r : ℕ} (f : Fin r → ι) (g : Fin r → κ) :
    (rowMatrix f (fun j i => A i (g j))).det = (A.submatrix f g).det := by
  rw [← Matrix.det_transpose]
  rfl

private lemma rowMatrix_det_mem_minorIdeal {R : Type*} [CommRing R]
    {ι κ : Type*} (A : Matrix ι κ R) (r : ℕ)
    (f : Fin r → ι) (v : Fin r → (ι → R))
    (hv : ∀ i, v i ∈ columnSpan A) :
    (rowMatrix f v).det ∈ minorIdeal A r := by
  classical
  let P : Finset (Fin r) → Prop := fun s =>
    ∀ w : Fin r → (ι → R),
      (∀ i ∈ s, w i ∈ columnSpan A) →
      (∀ i, i ∉ s → ∃ j, w i = fun a => A a j) →
      (rowMatrix f w).det ∈ minorIdeal A r
  have hP : ∀ s : Finset (Fin r), P s := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
        intro w _ hw
        choose g hg using fun i => hw i (by simp)
        obtain rfl : w = fun j i => A i (g j) := funext hg
        rw [rowMatrix_columns_det, minorIdeal]
        exact Ideal.subset_span ⟨f, g, rfl⟩
    | @insert a s ha ih =>
        intro w hw hcols
        have hwa : w a ∈ columnSpan A := hw a (Finset.mem_insert_self a s)
        let Q : (ι → R) → Prop := fun x =>
          (rowMatrix f (Function.update w a x)).det ∈ minorIdeal A r
        have hspan : w a ∈ Submodule.span R
            (Set.range fun j : κ => fun i : ι => A i j) := hwa
        have hQ' : ∀ x, x ∈ Submodule.span R
            (Set.range fun j : κ => fun i : ι => A i j) → Q x := by
          intro x hx
          induction hx using Submodule.span_induction with
          | mem x hx =>
            obtain ⟨j, rfl⟩ := hx
            have hw' : ∀ i ∈ s, Function.update w a (fun b => A b j) i ∈ columnSpan A := by
              intro i hi
              have hia : i ≠ a := fun h => ha (h ▸ hi)
              simpa [Function.update, hia] using hw i (Finset.mem_insert_of_mem hi)
            have hcols'' : ∀ i, i ∉ s → ∃ j',
                Function.update w a (fun b => A b j) i = fun b => A b j' := by
              intro i hi
              by_cases hia : i = a
              · subst i
                exact ⟨j, by simp⟩
              · obtain ⟨j', hj'⟩ := hcols i (by
                  intro his
                  exact hi (by simpa [hia] using his))
                exact ⟨j', by simpa [Function.update, hia] using hj'⟩
            exact ih (Function.update w a (fun b => A b j)) hw' hcols''
          | zero =>
            change (rowMatrix f (Function.update w a 0)).det ∈ _
            rw [rowMatrix_update, Matrix.det_eq_zero_of_row_eq_zero a]
            · exact Ideal.zero_mem _
            · intro j
              simp [Matrix.updateRow, Function.update]
          | add x y hx hy ihx ihy =>
            have hm := Matrix.det_updateRow_add (rowMatrix f w) a
              (fun j => x (f j)) (fun j => y (f j))
            have heval : (fun j => (x + y) (f j)) =
                (fun j => x (f j)) + (fun j => y (f j)) := by ext j; simp
            change (rowMatrix f (Function.update w a (x + y))).det ∈ _
            rw [rowMatrix_update, heval, hm]
            have ihx' : ((rowMatrix f w).updateRow a (fun j => x (f j))).det
                ∈ minorIdeal A r := by simpa [Q, rowMatrix_update] using ihx
            have ihy' : ((rowMatrix f w).updateRow a (fun j => y (f j))).det
                ∈ minorIdeal A r := by simpa [Q, rowMatrix_update] using ihy
            exact Ideal.add_mem _ ihx' ihy'
          | smul c x hx ihx =>
            have hm := Matrix.det_updateRow_smul (rowMatrix f w) a c
              (fun j => x (f j))
            have heval : (fun j => (c • x) (f j)) =
                c • (fun j => x (f j)) := by ext j; simp
            change (rowMatrix f (Function.update w a (c • x))).det ∈ _
            rw [rowMatrix_update, heval, hm]
            have ihx' : ((rowMatrix f w).updateRow a (fun j => x (f j))).det
                ∈ minorIdeal A r := by simpa [Q, rowMatrix_update] using ihx
            exact Ideal.mul_mem_left _ c ihx'
        simpa [Q] using hQ' (w a) hwa
  exact hP Finset.univ v (fun i _ => hv i) fun i hi => absurd (Finset.mem_univ i) hi

private def spanMinorIdeal {R : Type*} [CommRing R] {ι : Type*}
    (U : Submodule R (ι → R)) (r : ℕ) : Ideal R :=
  Ideal.span {x : R | ∃ (f : Fin r → ι) (v : Fin r → (ι → R)),
    (∀ i, v i ∈ U) ∧ x = (rowMatrix f v).det}

private lemma minorIdeal_le_spanMinorIdeal_of_columns {R : Type*} [CommRing R]
    {ι κ : Type*} (A : Matrix ι κ R) (U : Submodule R (ι → R))
    (hA : ∀ j, (fun i => A i j) ∈ U) (r : ℕ) :
    minorIdeal A r ≤ spanMinorIdeal U r := by
  rw [minorIdeal, Ideal.span_le]
  rintro x ⟨f, g, rfl⟩
  exact Ideal.subset_span ⟨f, fun j i => A i (g j), fun j => hA (g j),
    (rowMatrix_columns_det A f g).symm⟩

private lemma minorIdeal_eq_spanMinorIdeal {R : Type*} [CommRing R]
    {ι κ : Type*} (A : Matrix ι κ R) (r : ℕ) :
    minorIdeal A r = spanMinorIdeal (columnSpan A) r := by
  classical
  apply le_antisymm
  · exact minorIdeal_le_spanMinorIdeal_of_columns A (columnSpan A)
      (fun j => Submodule.subset_span ⟨j, rfl⟩) r
  · rw [spanMinorIdeal, Ideal.span_le]
    rintro x ⟨f, v, hv, rfl⟩
    exact rowMatrix_det_mem_minorIdeal A r f v hv

private def linearMatrix {R : Type*} [CommRing R] {ι : Type*} [DecidableEq ι]
    (g : (ι → R) →ₗ[R] (ι → R)) : Matrix ι ι R :=
  fun i j => g (Pi.single j 1) i

private def tupleMatrix {R : Type*} {ι : Type*} {r : ℕ}
    (v : Fin r → (ι → R)) : Matrix ι (Fin r) R :=
  fun i j => v j i

private lemma linearMatrix_mul_tupleMatrix {R : Type*} [CommRing R]
    {ι : Type*} [Fintype ι] [DecidableEq ι] {r : ℕ}
    (g : (ι → R) →ₗ[R] (ι → R))
    (v : Fin r → (ι → R)) :
    linearMatrix g * tupleMatrix v = tupleMatrix (fun j => g (v j)) := by
  classical
  ext i j
  simp only [Matrix.mul_apply, linearMatrix, tupleMatrix]
  have hdecomp : (fun k : ι => v j k) = ∑ k, v j k • Pi.single k (1 : R) := by
    ext k
    classical
    rw [Finset.sum_apply]
    simp only [Pi.smul_apply]
    rw [Finset.sum_eq_single k]
    · simp [Pi.single_eq_same]
    · intro b hb hbk
      simp [Pi.single_eq_of_ne hbk.symm]
    · simp
  calc
    (∑ k, g (Pi.single k 1) i * v j k)
        = ∑ k, v j k * g (Pi.single k 1) i := by
            apply Finset.sum_congr rfl
            intro k hk
            ring
    _ = g (fun k => v j k) i := by
          symm
          calc
            g (fun k => v j k) i = g (∑ k, v j k • Pi.single k 1) i := by rw [← hdecomp]
            _ = ∑ k, v j k * g (Pi.single k 1) i := by simp [map_sum, Pi.smul_apply]

private lemma rowMatrix_det_mem_minorIdeal_of_tupleMatrix {R : Type*} [CommRing R]
    {ι : Type*} {r : ℕ} (V : Matrix ι (Fin r) R)
    (f : Fin r → ι) (v : Fin r → (ι → R))
    (hV : V = tupleMatrix v) :
    (rowMatrix f v).det ∈ minorIdeal V r := by
  classical
  have hdet : (rowMatrix f v).det = (V.submatrix f id).det := by
    subst hV
    exact rowMatrix_columns_det (tupleMatrix v) f id
  rw [hdet, minorIdeal]
  exact Ideal.subset_span ⟨f, id, rfl⟩

private lemma spanMinorIdeal_map_le {R : Type*} [CommRing R]
    {ι : Type*} [Finite ι] (g : (ι → R) ≃ₗ[R] (ι → R))
    (U : Submodule R (ι → R)) (r : ℕ) :
    spanMinorIdeal (U.map g.toLinearMap) r ≤ spanMinorIdeal U r := by
  classical
  have := Fintype.ofFinite ι
  rw [spanMinorIdeal, Ideal.span_le]
  rintro x ⟨f, v, hv, rfl⟩
  choose u hu huval using fun j => (Submodule.mem_map.mp (hv j))
  let V : Matrix ι (Fin r) R := tupleMatrix u
  let W : Matrix ι (Fin r) R := tupleMatrix v
  have hW : W = linearMatrix g.toLinearMap * V := by
    calc
      W = tupleMatrix (fun j => g (u j)) := by
        ext i j
        exact (congrFun (huval j) i).symm
      _ = linearMatrix g.toLinearMap * V := (linearMatrix_mul_tupleMatrix g.toLinearMap u).symm
  have hdetW : (rowMatrix f v).det ∈ minorIdeal W r :=
    rowMatrix_det_mem_minorIdeal_of_tupleMatrix W f v rfl
  rw [hW] at hdetW
  exact minorIdeal_le_spanMinorIdeal_of_columns V U (fun j => hu j) r
    (minorIdeal_mul_le (linearMatrix g.toLinearMap) V r hdetW)

private lemma map_map_symm_eq {R : Type*} [CommRing R] {M N : Type*} [AddCommGroup M]
    [Module R M] [AddCommGroup N] [Module R N] (e : M ≃ₗ[R] N) (U : Submodule R M) :
    (U.map e.toLinearMap).map e.symm.toLinearMap = U := by
  rw [Submodule.map_equiv_eq_comap_symm]
  exact Submodule.comap_map_eq_of_injective e.injective U

private lemma spanMinorIdeal_map_eq {R : Type*} [CommRing R]
    {ι : Type*} [Finite ι] (g : (ι → R) ≃ₗ[R] (ι → R))
    (U : Submodule R (ι → R)) (r : ℕ) :
    spanMinorIdeal (U.map g.toLinearMap) r = spanMinorIdeal U r := by
  refine le_antisymm (spanMinorIdeal_map_le g U r) ?_
  · simpa [map_map_symm_eq] using spanMinorIdeal_map_le g.symm (U.map g.toLinearMap) r

private def piSumEquiv {R : Type*} [CommRing R] (n m : ℕ) :
    ((Fin n ⊕ Fin m) → R) ≃ₗ[R] ((Fin n → R) × (Fin m → R)) where
  toFun v := (fun i => v (Sum.inl i), fun j => v (Sum.inr j))
  invFun p := Sum.elim p.1 p.2
  map_add' x y := by
    ext i <;> cases i <;> simp
  map_smul' c x := by
    ext i <;> cases i <;> simp
  left_inv x := by
    funext i
    cases i <;> rfl
  right_inv p := by
    ext i <;> rfl

private def stabilizedSubmodule {R : Type*} [CommRing R] {n : ℕ}
    (U : Submodule R (Fin n → R)) (m : ℕ) :
    Submodule R ((Fin n ⊕ Fin m) → R) :=
  (U.prod (⊤ : Submodule R (Fin m → R))).comap (piSumEquiv n m).toLinearMap

private def submoduleMatrix {R : Type*} [CommRing R] {n : ℕ}
    (U : Submodule R (Fin n → R)) : Matrix (Fin n) U R :=
  fun i u => u.1 i

private def blockGenerator {R : Type*} [CommRing R] {n : ℕ}
    (U : Submodule R (Fin n → R)) (m : ℕ) :
    Matrix (Fin n ⊕ Fin m) (U ⊕ Fin m) R :=
  Matrix.fromBlocks (submoduleMatrix U) 0 0 (1 : Matrix (Fin m) (Fin m) R)

private lemma submoduleMatrix_columnSpan {R : Type*} [CommRing R] {n : ℕ}
    (U : Submodule R (Fin n → R)) : columnSpan (submoduleMatrix U) = U := by
  refine le_antisymm (Submodule.span_le.mpr ?_) fun x hx => Submodule.subset_span ⟨⟨x, hx⟩, rfl⟩
  rintro x ⟨u, rfl⟩
  exact u.2

private lemma blockGenerator_columnSpan {R : Type*} [CommRing R] {n m : ℕ}
    (U : Submodule R (Fin n → R)) :
    columnSpan (blockGenerator U m) = stabilizedSubmodule U m := by
  classical
  rw [columnSpan]
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro v ⟨c, rfl⟩
    change (piSumEquiv n m) (fun z => blockGenerator U m z c) ∈
      U.prod (⊤ : Submodule R (Fin m → R))
    rcases c with u | j
    · simp [blockGenerator, submoduleMatrix, piSumEquiv, Submodule.mem_prod]
    · simp [blockGenerator, piSumEquiv, Submodule.mem_prod, ← Pi.zero_def]
  · intro v hv
    rw [stabilizedSubmodule, Submodule.mem_comap] at hv
    have hv' : (piSumEquiv n m) v ∈ U.prod (⊤ : Submodule R (Fin m → R)) := by
      simpa [piSumEquiv] using hv
    obtain ⟨hleft, -⟩ : (fun i => v (Sum.inl i)) ∈ U ∧
        (fun j => v (Sum.inr j)) ∈ (⊤ : Submodule R (Fin m → R)) := by
      simpa [Submodule.mem_prod, piSumEquiv] using hv'
    let left : (Fin n ⊕ Fin m) → R := fun z => Sum.elim (fun i => v (Sum.inl i)) (fun _ => 0) z
    let right : (Fin n ⊕ Fin m) → R := fun z => Sum.elim (fun _ => 0) (fun j => v (Sum.inr j)) z
    have hsplit : v = left + right := by
      funext z
      cases z <;> simp [left, right]
    have hleft : left ∈ Submodule.span R
        (Set.range fun c : U ⊕ Fin m => fun z => blockGenerator U m z c) := by
      rw [← columnSpan]
      apply Submodule.subset_span
      refine ⟨Sum.inl ⟨(fun i => v (Sum.inl i)), hleft⟩, ?_⟩
      funext z
      cases z <;> simp [left, blockGenerator, submoduleMatrix, Matrix.fromBlocks]
    have hright : right ∈ Submodule.span R
        (Set.range fun c : U ⊕ Fin m => fun z => blockGenerator U m z c) := by
      rw [← columnSpan]
      have hsum : right = ∑ j : Fin m, v (Sum.inr j) •
          (fun z => blockGenerator U m z (Sum.inr j)) := by
        funext z
        cases z with
        | inl i => simp [right, blockGenerator, Matrix.fromBlocks]
        | inr i =>
          simp [right, blockGenerator, Matrix.fromBlocks, Matrix.one_apply]
      rw [hsum]
      exact Submodule.sum_mem _ fun j _ =>
        Submodule.smul_mem _ _ (Submodule.subset_span ⟨Sum.inr j, rfl⟩)
    rw [hsplit]
    exact Submodule.add_mem _ hleft hright

private lemma minorIdeal_antitone_index {R : Type*} [CommRing R]
    {ι κ : Type*} (A : Matrix ι κ R) {a b : ℕ} (hab : a ≤ b) :
    minorIdeal A b ≤ minorIdeal A a := by
  induction hab with
  | refl => exact le_rfl
  | @step b hab ih =>
      simpa [Nat.succ_eq_add_one] using (minorIdeal_succ_le A b).trans ih

private lemma minorIdeal_identity_eq_top_of_le {R : Type*} [CommRing R]
    (m r : ℕ) (h : r ≤ m) :
    minorIdeal (1 : Matrix (Fin m) (Fin m) R) r = ⊤ := by
  classical
  rw [Ideal.eq_top_iff_one]
  apply Ideal.subset_span
  refine ⟨Fin.castLE h, Fin.castLE h, ?_⟩
  have hsub : (1 : Matrix (Fin m) (Fin m) R).submatrix (Fin.castLE h) (Fin.castLE h) = 1 := by
    ext i j
    simp [Matrix.one_apply, (Fin.castLE_injective h).eq_iff]
  rw [hsub, Matrix.det_one]

private lemma minorIdeal_identity_eq_bot_of_lt {R : Type*} [CommRing R]
    (m r : ℕ) (h : m < r) :
    minorIdeal (1 : Matrix (Fin m) (Fin m) R) r = ⊥ :=
  minorIdeal_eq_bot_of_card_lt _ r (Or.inl (by simpa using h))

private lemma minorIdeal_mul_le_fromBlocks {R : Type*} [CommRing R] {l₁ o₁ l₂ o₂ : Type*}
    (A : Matrix l₁ o₁ R) (B : Matrix l₂ o₂ R) (a b : ℕ) :
    minorIdeal A a * minorIdeal B b ≤ minorIdeal (Matrix.fromBlocks A 0 0 B) (a + b) :=
  fun z hz => minorIdeal_fromBlocks_ge A B (a + b)
    (minorIdeal_mem_antidiagonal_sum A B (a + b) a b rfl z hz)

private lemma minorIdeal_stable_block {R : Type*} [CommRing R] {n m : ℕ} {κ : Type*}
    (A : Matrix (Fin n) κ R) (r : ℕ) :
    minorIdeal (Matrix.fromBlocks A 0 0 (1 : Matrix (Fin m) (Fin m) R)) (r + m) =
      minorIdeal A r := by
  apply le_antisymm
  · rw [minorIdeal_fromBlocks]
    apply Finset.sum_induction _ (· ≤ minorIdeal A r)
      (fun a b ha hb => sup_le ha hb) bot_le
    rintro ⟨a, b⟩ hp
    rw [Finset.mem_antidiagonal] at hp
    by_cases hb : b ≤ m
    · have har : r ≤ a := by omega
      rw [minorIdeal_identity_eq_top_of_le m b hb]
      simpa using minorIdeal_antitone_index A har
    · have hbm : m < b := by omega
      rw [minorIdeal_identity_eq_bot_of_lt m b hbm]
      simp
  · have h := minorIdeal_mul_le_fromBlocks A (1 : Matrix (Fin m) (Fin m) R) r m
    rwa [minorIdeal_identity_eq_top_of_le m m le_rfl, Ideal.mul_top] at h

private lemma spanMinorIdeal_stabilize {R : Type*} [CommRing R] {n : ℕ}
    (U : Submodule R (Fin n → R)) (r m : ℕ) :
    spanMinorIdeal (stabilizedSubmodule U m) (r + m) = spanMinorIdeal U r := by
  let G := submoduleMatrix U
  let H := blockGenerator U m
  calc
    spanMinorIdeal (stabilizedSubmodule U m) (r + m)
        = spanMinorIdeal (columnSpan H) (r + m) := by rw [blockGenerator_columnSpan U]
    _ = minorIdeal H (r + m) := (minorIdeal_eq_spanMinorIdeal H (r + m)).symm
    _ = minorIdeal G r := by
      simpa [G, H, blockGenerator, submoduleMatrix] using minorIdeal_stable_block G r
    _ = spanMinorIdeal (columnSpan G) r := minorIdeal_eq_spanMinorIdeal G r
    _ = spanMinorIdeal U r := by rw [submoduleMatrix_columnSpan U]

private lemma spanMinorIdeal_zero {R : Type*} [CommRing R] {n : ℕ}
    (U : Submodule R (Fin n → R)) : spanMinorIdeal U 0 = ⊤ := by
  rw [← submoduleMatrix_columnSpan U, ← minorIdeal_eq_spanMinorIdeal, minorIdeal_zero]

private lemma minorIdeal_blockGenerator_eq_top_of_le {R : Type*} [CommRing R]
    {n m : ℕ} (U : Submodule R (Fin n → R)) {d : ℕ} (hd : d ≤ m) :
    minorIdeal (blockGenerator U m) d = ⊤ := by
  have h := minorIdeal_mul_le_fromBlocks (submoduleMatrix U) (1 : Matrix (Fin m) (Fin m) R) 0 d
  rw [minorIdeal_zero, minorIdeal_identity_eq_top_of_le m d hd, Ideal.top_mul, zero_add] at h
  exact top_le_iff.mp h

private lemma spanMinorIdeal_stabilize_sub {R : Type*} [CommRing R] {n : ℕ}
    (U : Submodule R (Fin n → R)) (d m : ℕ) :
    spanMinorIdeal (stabilizedSubmodule U m) d = spanMinorIdeal U (d - m) := by
  by_cases hm : m ≤ d
  · calc
      spanMinorIdeal (stabilizedSubmodule U m) d =
          spanMinorIdeal (stabilizedSubmodule U m) ((d - m) + m) := by rw [Nat.sub_add_cancel hm]
      _ = spanMinorIdeal U (d - m) := spanMinorIdeal_stabilize U (d - m) m
  · have hlt : d < m := Nat.lt_of_not_ge hm
    rw [← blockGenerator_columnSpan U, ← minorIdeal_eq_spanMinorIdeal,
      minorIdeal_blockGenerator_eq_top_of_le U hlt.le, Nat.sub_eq_zero_of_le hlt.le,
      spanMinorIdeal_zero]

private def piReindex {R : Type*} [CommRing R] {ι κ : Type*} (e : ι ≃ κ) :
    (ι → R) ≃ₗ[R] (κ → R) where
  toFun v j := v (e.symm j)
  invFun v i := v (e i)
  map_add' v w := by ext i; rfl
  map_smul' c v := by ext i; rfl
  left_inv v := by ext i; simp
  right_inv v := by ext i; simp

private lemma spanMinorIdeal_reindex_le {R : Type*} [CommRing R]
    {ι κ : Type*} (e : ι ≃ κ) (U : Submodule R (ι → R)) (r : ℕ) :
    spanMinorIdeal (U.map (piReindex e).toLinearMap) r ≤ spanMinorIdeal U r := by
  classical
  rw [spanMinorIdeal, Ideal.span_le]
  rintro x ⟨f, v, hv, rfl⟩
  choose u hu huv using fun j => (Submodule.mem_map.mp (hv j))
  apply Ideal.subset_span
  refine ⟨e.symm ∘ f, u, hu, ?_⟩
  congr 1
  ext i j
  simpa [rowMatrix, piReindex, Function.comp_apply] using (congrFun (huv i) (f j)).symm

private lemma spanMinorIdeal_reindex_eq {R : Type*} [CommRing R]
    {ι κ : Type*} (e : ι ≃ κ) (U : Submodule R (ι → R)) (r : ℕ) :
    spanMinorIdeal (U.map (piReindex e).toLinearMap) r = spanMinorIdeal U r := by
  refine le_antisymm (spanMinorIdeal_reindex_le e U r) ?_
  · have h := spanMinorIdeal_reindex_le e.symm (U.map (piReindex e).toLinearMap) r
    rwa [show piReindex e.symm = (piReindex e).symm from rfl, map_map_symm_eq] at h

private lemma stableRight_reindex {R : Type*} [CommRing R] {n m : ℕ}
    (U : Submodule R (Fin m → R)) :
    (((⊤ : Submodule R (Fin n → R)).prod U).comap (piSumEquiv n m).toLinearMap).map
        (piReindex (Equiv.sumComm (Fin n) (Fin m))).toLinearMap =
      stabilizedSubmodule U n := by
  ext v
  rw [Submodule.mem_map_equiv (e := piReindex (Equiv.sumComm (Fin n) (Fin m))) (x := v)]
  simp [stabilizedSubmodule, piSumEquiv, piReindex, Submodule.mem_comap,
    Submodule.mem_prod]


/-- **Stacks 07Z8.** The ideal generated by the `(n - k) × (n - k)` minors of a presentation
matrix of a finite module is independent of the presentation: if `A` has `n` rows, `B` has `m`
rows, and the cokernels of the two column maps are isomorphic `R`-modules, then
`I_{n-k}(A) = I_{m-k}(B)`. This is what makes `fittingIdeal` well defined. -/
@[stacks 07Z8, sga "7 VI 4.16" "Section 5, special case"]
theorem minorIdeal_eq_of_quotientLinearEquiv {R : Type*} [CommRing R]
    {n m : ℕ} {J K : Type*}
    (A : Matrix (Fin n) J R) (B : Matrix (Fin m) K R) (k : ℕ)
    (h : ((Fin n → R) ⧸ Submodule.span R
        (Set.range (fun j : J => fun i : Fin n => A i j))) ≃ₗ[R]
      ((Fin m → R) ⧸ Submodule.span R
        (Set.range (fun j : K => fun i : Fin m => B i j)))) :
    minorIdeal A (n - k) = minorIdeal B (m - k) := by
  classical
  let U := columnSpan A
  let V := columnSpan B
  let QA := (Fin n → R) ⧸ U
  let qA : (Fin n → R) →ₗ[R] QA := U.mkQ
  let qB : (Fin m → R) →ₗ[R] QA := h.symm.toLinearMap.comp V.mkQ
  have hqBker : LinearMap.ker qB = V := (LinearEquiv.ker_comp h.symm V.mkQ).trans V.ker_mkQ
  have hqBsurj : Function.Surjective qB := h.symm.surjective.comp V.mkQ_surjective
  have htopA : Function.Exact U.subtype qA := LinearMap.exact_subtype_mkQ U
  have htopB : Function.Exact V.subtype qB := by
    rw [LinearMap.exact_iff, Submodule.range_subtype, hqBker]
  let topLeft : (U × (Fin m → R)) →ₗ[R] ((Fin n → R) × (Fin m → R)) :=
    U.subtype.prodMap LinearMap.id
  let botLeft : ((Fin n → R) × V) →ₗ[R] ((Fin n → R) × (Fin m → R)) :=
    (LinearMap.id : (Fin n → R) →ₗ[R] (Fin n → R)).prodMap V.subtype
  obtain ⟨φ, ψ, hrowsTop, hrowsBot, hleftSq, _hrightSq⟩ :=
    schanuel U.subtype qA V.subtype qB (inferInstance : Module.Projective R (Fin n → R))
      (inferInstance : Module.Projective R (Fin m → R))
      Subtype.coe_injective U.mkQ_surjective htopA
      Subtype.coe_injective hqBsurj htopB
  have hleft : botLeft.comp φ.toLinearMap = ψ.toLinearMap.comp topLeft := hleftSq
  have hrangeTop : LinearMap.range topLeft = U.prod (⊤ : Submodule R (Fin m → R)) := by
    simp [topLeft]
  have hrangeBot : LinearMap.range botLeft = (⊤ : Submodule R (Fin n → R)).prod V := by
    simp [botLeft]
  have hstableProd : (U.prod (⊤ : Submodule R (Fin m → R))).map ψ.toLinearMap =
      (⊤ : Submodule R (Fin n → R)).prod V := by
    have hcomp := congrArg LinearMap.range hleft
    rw [LinearMap.range_comp, LinearMap.range_comp] at hcomp
    simpa [LinearMap.range_comp, hrangeTop, hrangeBot] using hcomp.symm
  let e : ((Fin n ⊕ Fin m) → R) ≃ₗ[R] ((Fin n → R) × (Fin m → R)) :=
    piSumEquiv n m
  let g : ((Fin n ⊕ Fin m) → R) ≃ₗ[R] ((Fin n ⊕ Fin m) → R) :=
    e.trans (ψ.trans e.symm)
  let stableA := stabilizedSubmodule U m
  let stableB := ((⊤ : Submodule R (Fin n → R)).prod V).comap e.toLinearMap
  have hstable : stableA.map g.toLinearMap = stableB := by
    ext x
    rw [Submodule.mem_map_equiv (e := g)]
    change (e (g.symm x) ∈ U.prod (⊤ : Submodule R (Fin m → R))) ↔
      e x ∈ (⊤ : Submodule R (Fin n → R)).prod V
    have hcoord : e (g.symm x) = ψ.symm (e x) := by
      simp [g, e]
    rw [hcoord, ← hstableProd, Submodule.mem_map_equiv]
  let swap : ((Fin n ⊕ Fin m) → R) ≃ₗ[R] ((Fin m ⊕ Fin n) → R) :=
    piReindex (Equiv.sumComm (Fin n) (Fin m))
  calc
    minorIdeal A (n - k) = spanMinorIdeal U (n - k) := by
      simpa [U] using minorIdeal_eq_spanMinorIdeal A (n - k)
    _ = spanMinorIdeal stableA (n + m - k) := by
      rw [spanMinorIdeal_stabilize_sub U (n + m - k) m, show n + m - k - m = n - k by omega]
    _ = spanMinorIdeal (stableA.map g.toLinearMap) (n + m - k) :=
      (spanMinorIdeal_map_eq g stableA (n + m - k)).symm
    _ = spanMinorIdeal stableB (n + m - k) := by rw [hstable]
    _ = spanMinorIdeal (stableB.map swap.toLinearMap) (n + m - k) :=
      (spanMinorIdeal_reindex_eq (Equiv.sumComm (Fin n) (Fin m)) stableB (n + m - k)).symm
    _ = spanMinorIdeal (stabilizedSubmodule V n) (n + m - k) :=
      congrArg (spanMinorIdeal · (n + m - k)) (stableRight_reindex V)
    _ = spanMinorIdeal V (m - k) := by
      rw [spanMinorIdeal_stabilize_sub V (n + m - k) n, show n + m - k - n = m - k by omega]
    _ = minorIdeal B (m - k) := by
      simpa [V] using (minorIdeal_eq_spanMinorIdeal B (m - k)).symm
