module

public import Mathlib.LinearAlgebra.Matrix.Basis
public import Mathlib.LinearAlgebra.Matrix.Rank
public import Mathlib.LinearAlgebra.Projection
public import Mathlib.LinearAlgebra.Trace
public import Mathlib.RingTheory.LocalRing.Module

/-!
# Idempotent matrices over a local ring are classified by rank
-/

@[expose] public section

open Matrix Module LinearMap

variable {K : Type*} [CommRing K] [IsLocalRing K] {n : ℕ}

/-- Over a local ring, the range of an idempotent endomorphism of a finite projective module
is free. -/
lemma LinearMap.free_range_of_isIdempotentElem {V : Type*} [AddCommGroup V] [Module K V]
    [Module.Projective K V] [Module.Finite K V] {f : V →ₗ[K] V}
    (hf : IsIdempotentElem f) : Module.Free K (range f) := by
  have : Module.Projective K (range f) :=
    Module.Projective.of_split (range f).subtype f.rangeRestrict <| by
      ext x
      simp [hf.mem_range_iff.1 x.2]
  exact Module.free_of_flat_of_isLocalRing

/-- An idempotent matrix `M` admits a basis of `Kⁿ` whose first `rank M` vectors span the image
of `M` (where `M` acts as the identity) and whose remaining vectors span its kernel. -/
lemma exists_basis_mulVecLin_eq_ite_smul {M : Matrix (Fin n) (Fin n) K} (hM : M * M = M) :
    ∃ b : Basis (Fin n) K (Fin n → K),
      ∀ j, M.mulVecLin (b j) = (if (j : ℕ) < M.rank then (1 : K) else 0) • b j := by
  have hf : IsIdempotentElem M.mulVecLin := by
    rw [IsIdempotentElem, Module.End.mul_eq_comp, ← Matrix.mulVecLin_mul, hM]
  have := LinearMap.free_range_of_isIdempotentElem hf
  have : Module.Free K (ker M.mulVecLin) := by
    rw [hf.ker_eq_range_one_sub]
    exact LinearMap.free_range_of_isIdempotentElem hf.one_sub
  have : Module.Finite K (ker M.mulVecLin) := by
    rw [hf.ker_eq_range_one_sub]
    infer_instance
  have hr : finrank K (range M.mulVecLin) = M.rank := by rw [Matrix.rank]
  have hrn : M.rank ≤ n := M.rank_le_width
  have hk : finrank K (ker M.mulVecLin) = n - M.rank := by
    have := (Submodule.prodEquivOfIsCompl _ _ hf.isCompl).finrank_eq
    rw [Module.finrank_prod, Module.finrank_fin_fun] at this
    rw [Matrix.rank]
    omega
  let σ : Fin M.rank ⊕ Fin (n - M.rank) ≃ Fin n := finSumFinEquiv.trans (finCongr (by omega))
  let b := (((finBasisOfFinrankEq K (range M.mulVecLin) hr).prod
    (finBasisOfFinrankEq K (ker M.mulVecLin) hk)).map
      (Submodule.prodEquivOfIsCompl _ _ hf.isCompl)).reindex σ
  refine ⟨b, fun j => ?_⟩
  obtain ⟨k, rfl⟩ := σ.surjective j
  rcases k with k | k
  · have hlt : ((σ (Sum.inl k)) : ℕ) < M.rank := by simp [σ]
    simpa [b, hlt, Basis.prod_apply, Submodule.coe_prodEquivOfIsCompl'] using
      hf.mem_range_iff.1 (finBasisOfFinrankEq K (range M.mulVecLin) hr k).2
  · have hge : ¬((σ (Sum.inr k)) : ℕ) < M.rank := by simp [σ]
    simp [b, hge, Basis.prod_apply, Submodule.coe_prodEquivOfIsCompl']

/-- An idempotent matrix is conjugate to the diagonal matrix `diag(1, …, 1, 0, …, 0)` with
`rank M` ones. -/
lemma isConj_diagonal_of_mul_self_eq {M : Matrix (Fin n) (Fin n) K} (hM : M * M = M) :
    IsConj M (Matrix.diagonal (fun i : Fin n => if (i : ℕ) < M.rank then (1 : K) else 0)) := by
  obtain ⟨b, hb⟩ := exists_basis_mulVecLin_eq_ite_smul hM
  let E := Pi.basisFun K (Fin n)
  have hD : LinearMap.toMatrix b b M.mulVecLin =
      Matrix.diagonal (fun i : Fin n => if (i : ℕ) < M.rank then (1 : K) else 0) := by
    ext i j
    rw [LinearMap.toMatrix_apply, hb, map_smul, b.repr_self, Matrix.diagonal_apply]
    rcases eq_or_ne i j with rfl | hij
    · by_cases hi : (i : ℕ) < M.rank <;> simp [hi]
    · by_cases hj : (j : ℕ) < M.rank <;> simp [hj, hij]
  have hconj := basis_toMatrix_mul_linearMap_toMatrix_mul_basis_toMatrix E b E b M.mulVecLin
  rw [hD, LinearMap.toMatrix_eq_toMatrix', ← Matrix.toLin'_apply', LinearMap.toMatrix'_toLin']
    at hconj
  refine ⟨⟨b.toMatrix E, E.toMatrix b, b.toMatrix_mul_toMatrix_flip E,
    E.toMatrix_mul_toMatrix_flip b⟩, ?_⟩
  rw [SemiconjBy, Units.val_mk]
  conv_lhs => rw [← hconj, ← mul_assoc, ← mul_assoc, b.toMatrix_mul_toMatrix_flip E, one_mul]

/--
**Stacks Tag 00GG** (example of idempotent matrices).

Let `K` be a field and consider the affine scheme of `n × n` idempotent matrices,
i.e. the spectrum of `R = K[{t_{ij}}] / 𝔞` where `𝔞` is the ideal generated by the
entries of `T² - T`. Its `K`-points are exactly the matrices `M` with
`M * M = M`.

The example asserts that, by linear algebra, each idempotent matrix `M` is
conjugate (under the `GLₙ`-action `g, T ↦ g T g⁻¹`) to a diagonal matrix
`diag(1, …, 1, 0, …, 0)` with `r = rank M` ones, and that an idempotent is
*classified up to conjugation by its rank*. Consequently distinct ranks give
distinct conjugation orbits — these are precisely the irreducible components of
the scheme, and orbits of different rank are disjoint.

We record the linear-algebra heart of the example: for idempotent `M, N`,

* `M` and `N` are conjugate iff they have the same rank (classification by rank,
  which makes distinct-rank orbits disjoint), and
* `M` is conjugate to the standard idempotent `diag(1, …, 1, 0, …, 0)` carrying
  `rank M` ones (existence of the diagonal normal form).

This holds over every commutative local ring; the field in the example is a special case.

The geometric statements of the example (the orbit loci are the irreducible components of
`Spec R`, pairwise disjoint, and are separated by polynomial functions: the trace in
characteristic `0`, `tr(⋀³ T)` for `n = 3`) are in
`StacksFrontier.RingTheory.Spectrum.Prime.IdempotentMatrices`.

Here `IsConj M N` unfolds to `∃ g : (Matrix (Fin n) (Fin n) K)ˣ, g * M = N * g`,
i.e. `g * M * g⁻¹ = N`, which is exactly the `GLₙ`-conjugation action of the
statement.
-/
@[stacks 00GG "an idempotent matrix is conjugate to diag(1, …, 1, 0, …, 0), and idempotents are \
conjugate iff they have the same rank"]
theorem idempotent_matrices_classified_by_rank
    (M N : Matrix (Fin n) (Fin n) K) (hM : M * M = M) (hN : N * N = N) :
    (IsConj M N ↔ M.rank = N.rank) ∧
      IsConj M (Matrix.diagonal (fun i : Fin n => if (i : ℕ) < M.rank then (1 : K) else 0)) := by
  refine ⟨⟨fun ⟨c, hc⟩ => ?_, fun h => ?_⟩, isConj_diagonal_of_mul_self_eq hM⟩
  · have hdet : IsUnit (c : Matrix (Fin n) (Fin n) K).det :=
      (Matrix.isUnit_iff_isUnit_det _).1 c.isUnit
    rw [← Matrix.rank_mul_eq_right_of_isUnit_det _ M hdet, hc,
      Matrix.rank_mul_eq_left_of_isUnit_det _ N hdet]
  · exact (isConj_diagonal_of_mul_self_eq hM).trans (h ▸ (isConj_diagonal_of_mul_self_eq hN).symm)

/-- The trace of an idempotent matrix over a commutative local ring is its rank, cast to the
ring. In characteristic zero, distinct ranks therefore give distinct traces. -/
@[stacks 00GG "the trace of an idempotent matrix is its rank"]
lemma Matrix.trace_eq_rank_of_isIdempotentElem (M : Matrix (Fin n) (Fin n) K)
    (hM : IsIdempotentElem M) : M.trace = (M.rank : K) := by
  have hf : IsIdempotentElem M.mulVecLin := by
    rw [IsIdempotentElem, Module.End.mul_eq_comp, ← Matrix.mulVecLin_mul, hM.eq]
  have := LinearMap.free_range_of_isIdempotentElem hf
  have : Module.Free K (ker M.mulVecLin) := by
    rw [hf.ker_eq_range_one_sub]
    exact LinearMap.free_range_of_isIdempotentElem hf.one_sub
  have : Module.Finite K (ker M.mulVecLin) := by
    rw [hf.ker_eq_range_one_sub]
    infer_instance
  rw [← Matrix.trace_toLin'_eq, Matrix.toLin'_apply',
    (LinearMap.IsIdempotentElem.isProj_range _ hf).trace, Matrix.rank]

end
