/-!
# Ideals generated by minors

For a matrix `A` over a commutative ring `R` and `r : ℕ`, the ideal `I_r(A)` is the ideal of `R`
generated by the `r × r` minors of `A`. In particular `I_0(A) = R`, and `I_r(A) = 0` when `r`
exceeds the number of rows or of columns of `A`.

## Main definitions

* `minorIdeal`: the ideal `I_r(A)` generated by the `r × r` minors of `A`.

## Main results

* `minorIdeal_succ_le`: `I_{r+1}(A) ⊆ I_r(A)`.
* `minorIdeal_fromRows_le`: adding `n'` rows to `A` gives a matrix `B` with
  `I_{r+n'}(B) ⊆ I_r(A)`.
* `minorIdeal_mul_le`: `I_r(C * A) ⊆ I_r(A)` for a square matrix `C`.
* `minorIdeal_fromBlocks`: for a block diagonal matrix,
  `I_r(diag(A₁, A₂)) = ∑_{r₁ + r₂ = r} I_{r₁}(A₁) · I_{r₂}(A₂)`.

## Implementation notes

An `r × r` minor is modelled as `(A.submatrix f g).det` for arbitrary maps `f : Fin r → l` and
`g : Fin r → o`, not necessarily injective or monotone. This generates the same ideal: a repeated
row or column gives determinant `0`, and permuting rows or columns changes the determinant only by
a sign.

## References

* [Stacks Project, Tag 07Z7](https://stacks.math.columbia.edu/tag/07Z7)
-/

@[expose] public section

/-- The ideal `I_r(A)` of `R` generated by the determinants `(A.submatrix f g).det` for all
`f : Fin r → l` and `g : Fin r → o`, that is, by the `r × r` minors of `A`. -/
def minorIdeal {R : Type*} [CommRing R] {l o : Type*} (A : Matrix l o R) (r : ℕ) :
    Ideal R :=
  Ideal.span { x : R | ∃ (f : Fin r → l) (g : Fin r → o), x = (A.submatrix f g).det }

/-- The ideal generated by the `0 × 0` minors is the unit ideal: `I_0(A) = R`. -/
theorem minorIdeal_zero {R : Type*} [CommRing R] {l o : Type*} (A : Matrix l o R) :
    minorIdeal A 0 = ⊤ := by
  rw [Ideal.eq_top_iff_one]
  apply Ideal.subset_span
  refine ⟨Fin.elim0, Fin.elim0, ?_⟩
  rw [Matrix.det_fin_zero]

/-- If `r` exceeds the number of rows or the number of columns of `A`, then `I_r(A) = 0`. -/
theorem minorIdeal_eq_bot_of_card_lt {R : Type*} [CommRing R] {l o : Type*}
    [Fintype l] [Fintype o] (A : Matrix l o R) (r : ℕ)
    (hr : Fintype.card l < r ∨ Fintype.card o < r) :
    minorIdeal A r = ⊥ := by
  rw [minorIdeal, Ideal.span_eq_bot]
  rintro x ⟨f, g, rfl⟩
  rcases hr with hr | hr
  · obtain ⟨i, j, hij, h⟩ := Fintype.exists_ne_map_eq_of_card_lt f (by simpa using hr)
    apply Matrix.det_zero_of_row_eq hij
    ext k
    simp [Matrix.submatrix, h]
  · obtain ⟨i, j, hij, h⟩ := Fintype.exists_ne_map_eq_of_card_lt g (by simpa using hr)
    apply Matrix.det_zero_of_column_eq hij
    intro k
    simp [Matrix.submatrix, h]

/-- **Stacks 07Z7** (part 1).
For every `r ≥ 0`, `I_{r+1}(A) ⊆ I_r(A)`; equivalently
`I_0(A) ⊇ I_1(A) ⊇ I_2(A) ⊇ ⋯`. -/
@[stacks 07Z7 "(1)"]
theorem minorIdeal_succ_le {R : Type*} [CommRing R] {l o : Type*}
    (A : Matrix l o R) (r : ℕ) :
    minorIdeal A (r + 1) ≤ minorIdeal A r := by
  rw [minorIdeal, Ideal.span_le]
  rintro x ⟨f, g, rfl⟩
  rw [Matrix.det_succ_row_zero]
  refine Ideal.sum_mem _ fun j _ => ?_
  rw [mul_assoc, Matrix.submatrix_submatrix]
  exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _
    (Ideal.subset_span ⟨f ∘ Fin.succ, g ∘ j.succAbove, rfl⟩))

/-- Every minor of a submatrix `A.submatrix e h` is a minor of `A`, so
`I_r(A.submatrix e h) ⊆ I_r(A)`. -/
theorem minorIdeal_submatrix_le {R : Type*} [CommRing R] {l l' o o' : Type*}
    (A : Matrix l o R) (e : l' → l) (h : o' → o) (r : ℕ) :
    minorIdeal (A.submatrix e h) r ≤ minorIdeal A r := by
  rw [minorIdeal, Ideal.span_le]
  rintro x ⟨f, g, rfl⟩
  exact Ideal.subset_span ⟨e ∘ f, h ∘ g, by rw [Matrix.submatrix_submatrix]⟩

/-- Reindexing the rows of `A` along a bijection `e` does not shrink the ideal of minors:
`I_r(A) ⊆ I_r(A.submatrix e id)`. -/
theorem minorIdeal_reindex_rows_le {R : Type*} [CommRing R] {l l' o : Type*}
    (A : Matrix l o R) (e : l' ≃ l) (r : ℕ) :
    minorIdeal A r ≤ minorIdeal (A.submatrix e (id : o → o)) r := by
  simpa [Matrix.submatrix_submatrix, Equiv.self_comp_symm] using
    minorIdeal_submatrix_le (A.submatrix e (id : o → o)) e.symm (id : o → o) r

/-- Adding one row `c` to `A` lowers the minor index by one:
`I_{s+1}(fromRows A c) ⊆ I_s(A)`. -/
theorem minorIdeal_fromRows_one_le {R : Type*} [CommRing R] {m : Type*}
    {n : ℕ} (A : Matrix (Fin n) m R) (c : Matrix (Fin 1) m R) (s : ℕ) :
    minorIdeal (Matrix.fromRows A c) (s + 1) ≤ minorIdeal A s := by
  rw [minorIdeal, Ideal.span_le]
  rintro x ⟨f, g, rfl⟩
  by_cases hA : ∃ i j : Fin (s+1), i ≠ j ∧ f i = Sum.inr 0 ∧ f j = Sum.inr 0
  · obtain ⟨i, j, hij, hi, hj⟩ := hA
    have hdet : ((Matrix.fromRows A c).submatrix f g).det = 0 := by
      apply Matrix.det_zero_of_row_eq hij
      funext k
      simp only [Matrix.submatrix_apply]
      rw [hi, hj]
    rw [hdet]
    exact Ideal.zero_mem _
  · push Not at hA
    have hinl : ∀ x : Fin n ⊕ Fin 1, x ≠ Sum.inr 0 → ∃ a, x = Sum.inl a := by
      rintro (a | b) h
      · exact ⟨a, rfl⟩
      · exact absurd (by rw [Fin.fin_one_eq_zero b]) h
    by_cases hone : ∃ i₀, f i₀ = Sum.inr 0
    · obtain ⟨i₀, hi₀⟩ := hone
      have hrest : ∀ k : Fin s, f (i₀.succAbove k) ≠ Sum.inr 0 :=
        fun k => hA i₀ (i₀.succAbove k) (Fin.succAbove_ne i₀ k).symm hi₀
      rw [Matrix.det_succ_row _ i₀]
      refine Ideal.sum_mem _ fun j _ => ?_
      rw [mul_assoc]
      refine Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ ?_)
      choose f' hf' using fun k => hinl _ (hrest k)
      have key : (((Matrix.fromRows A c).submatrix f g).submatrix i₀.succAbove j.succAbove)
          = A.submatrix f' (g ∘ j.succAbove) := by
        funext k l
        simp only [Matrix.submatrix_apply, Function.comp_apply, hf' k, Matrix.fromRows_apply_inl]
      rw [key, minorIdeal]
      exact Ideal.subset_span ⟨f', g ∘ j.succAbove, rfl⟩
    · push Not at hone
      choose f' hf' using fun i => hinl _ (hone i)
      have key : ((Matrix.fromRows A c).submatrix f g).det = (A.submatrix f' g).det := by
        congr 1
        funext i l
        simp only [Matrix.submatrix_apply, hf' i, Matrix.fromRows_apply_inl]
      rw [key]
      exact minorIdeal_succ_le A s (Ideal.subset_span ⟨f', g, rfl⟩)

/-- Splitting off the last of the `j + 1` extra rows: `fromRows A C` is a row reindexing of
`fromRows (fromRows A C₀) c`, where `C₀` consists of the first `j` rows of `C` and `c` of its
last row. -/
theorem fromRows_eq_submatrix_fromRows_fromRows_last {R : Type*} {m : Type*} {n j : ℕ}
    (A : Matrix (Fin n) m R) (C : Matrix (Fin (j + 1)) m R) :
    Matrix.fromRows A C
      = (Matrix.fromRows (Matrix.fromRows A (C.submatrix Fin.castSucc id))
          (C.submatrix (fun _ : Fin 1 => Fin.last j) id)).submatrix
        ((Equiv.sumAssoc (Fin n) (Fin j) (Fin 1)).trans
          (Equiv.sumCongr (Equiv.refl (Fin n)) finSumFinEquiv)).symm (id : m → m) := by
  ext i j'
  rcases i with a | b
  · simp only [Matrix.fromRows_apply_inl, Matrix.submatrix_apply, id_eq, Equiv.symm_trans_apply,
      Equiv.sumCongr_symm, Equiv.refl_symm, Equiv.sumCongr_apply, Equiv.coe_refl, Sum.map_inl,
      Equiv.sumAssoc_symm_apply_inl]
  · refine Fin.lastCases ?_ (fun b' => ?_) b
    · simp only [Matrix.fromRows_apply_inr, Matrix.submatrix_apply, id_eq,
        Equiv.symm_trans_apply, Equiv.sumCongr_symm, Equiv.refl_symm, Equiv.sumCongr_apply,
        Sum.map_inr, finSumFinEquiv_symm_last, Equiv.sumAssoc_symm_apply_inr_inr]
    · simp only [Matrix.fromRows_apply_inr, Matrix.fromRows_apply_inl, Matrix.submatrix_apply,
        id_eq, Equiv.symm_trans_apply, Equiv.sumCongr_symm, Equiv.refl_symm,
        Equiv.sumCongr_apply, Sum.map_inr, finSumFinEquiv_symm_apply_castSucc,
        Equiv.sumAssoc_symm_apply_inr_inl]

/-- Reindexing the first block of rows of `fromRows B c` along `finSumFinEquiv`. -/
theorem fromRows_eq_submatrix_fromRows_finSumFinEquiv {R : Type*} {m k : Type*} {a b : ℕ}
    (B : Matrix (Fin a ⊕ Fin b) m R) (c : Matrix k m R) :
    Matrix.fromRows B c
      = (Matrix.fromRows (B.submatrix finSumFinEquiv.symm (id : m → m)) c).submatrix
          (Sum.map finSumFinEquiv (id : k → k)) (id : m → m) := by
  ext i j'
  rcases i with i | i <;> simp

/-- **Stacks 07Z7** (part 2).
If `B = fromRows A C` consists of the `n` rows of `A` followed by `n'` extra rows `C`, then
`I_{r+n'}(B) ⊆ I_r(A)` for every `r ≥ 0`. -/
@[stacks 07Z7 "(2)"]
theorem minorIdeal_fromRows_le {R : Type*} [CommRing R] {m : Type*}
    {n n' : ℕ} (A : Matrix (Fin n) m R) (C : Matrix (Fin n') m R) (r : ℕ) :
    minorIdeal (Matrix.fromRows A C) (r + n') ≤ minorIdeal A r := by
  induction n' with
  | zero =>
    have hsub : Matrix.fromRows A C
        = A.submatrix (Sum.elim (id : Fin n → Fin n) Fin.elim0) (id : m → m) := by
      ext i j
      rcases i with a | b
      · simp [Matrix.fromRows_apply_inl]
      · exact b.elim0
    rw [add_zero, hsub]
    exact minorIdeal_submatrix_le A _ _ r
  | succ j ih =>
    rw [fromRows_eq_submatrix_fromRows_fromRows_last]
    set C₀ : Matrix (Fin j) m R := C.submatrix Fin.castSucc id
    set c : Matrix (Fin 1) m R := C.submatrix (fun _ => Fin.last j) id
    set X : Matrix (Fin (n + j)) m R :=
      (Matrix.fromRows A C₀).submatrix finSumFinEquiv.symm (id : m → m)
    calc minorIdeal ((Matrix.fromRows (Matrix.fromRows A C₀) c).submatrix _ id) (r + (j + 1))
        ≤ minorIdeal (Matrix.fromRows (Matrix.fromRows A C₀) c) (r + (j + 1)) :=
          minorIdeal_submatrix_le _ _ _ _
      _ = minorIdeal ((Matrix.fromRows X c).submatrix (Sum.map finSumFinEquiv id) id)
            ((r + j) + 1) := by
              rw [fromRows_eq_submatrix_fromRows_finSumFinEquiv, Nat.add_succ]
      _ ≤ minorIdeal (Matrix.fromRows X c) ((r + j) + 1) := minorIdeal_submatrix_le _ _ _ _
      _ ≤ minorIdeal X (r + j) := minorIdeal_fromRows_one_le X c (r + j)
      _ ≤ minorIdeal (Matrix.fromRows A C₀) (r + j) :=
          minorIdeal_submatrix_le _ _ _ _
      _ ≤ minorIdeal A r := ih C₀

/-- **Stacks 07Z7** (part 3).
For a square matrix `C` and the product `C * A`,
`I_r(C * A) ⊆ I_r(A)` for every `r ≥ 0`. -/
@[stacks 07Z7 "(3)"]
theorem minorIdeal_mul_le {R : Type*} [CommRing R] {l o : Type*}
    [Fintype l] (C : Matrix l l R) (A : Matrix l o R) (r : ℕ) :
    minorIdeal (C * A) r ≤ minorIdeal A r := by
  classical
  rw [minorIdeal, Ideal.span_le]
  rintro x ⟨f, g, rfl⟩
  have key : ((C * A).submatrix f g).det
      = ∑ φ : Fin r → l, (∏ i, C (f i) (φ i)) * (A.submatrix φ g).det := by
    have h1 : ((C * A).submatrix f g)
        = Matrix.of (fun i k => ∑ j, C (f i) j * A j (g k)) := by
      ext i k
      simp [Matrix.mul_apply, Matrix.submatrix]
    rw [h1]
    change (Matrix.detRowAlternating) (fun i k => ∑ j, C (f i) j * A j (g k)) = _
    have h2 : (fun i => (fun k => ∑ j, C (f i) j * A j (g k)))
        = (fun i => ∑ j, C (f i) j • (fun k => A j (g k))) := by
      funext i
      funext k
      simp [Finset.sum_apply]
    rw [h2]
    change (Matrix.detRowAlternating).toMultilinearMap
        (fun i => ∑ j, C (f i) j • (fun k => A j (g k))) = _
    rw [MultilinearMap.map_sum (Matrix.detRowAlternating).toMultilinearMap
        (fun i j => C (f i) j • (fun k => A j (g k)))]
    apply Finset.sum_congr rfl
    intro φ _
    have heq : (Matrix.of fun i k => C (f i) (φ i) * (A.submatrix φ g) i k).det
        = (∏ i, C (f i) (φ i)) * (A.submatrix φ g).det := Matrix.det_mul_column _ _
    rw [← heq]
    rfl
  rw [key]
  exact Ideal.sum_mem _ fun φ _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨φ, g, rfl⟩)

/-- Selecting rows by `Sum.map f₁ f₂` and columns by `Sum.map g₁ g₂` from the block diagonal
matrix `fromBlocks A₁ 0 0 A₂` gives the block diagonal matrix
`fromBlocks (A₁.submatrix f₁ g₁) 0 0 (A₂.submatrix f₂ g₂)`. -/
theorem fromBlocks_submatrix_sumMap {R : Type*} [CommRing R]
    {l₁ o₁ l₂ o₂ : Type*} {r₁ r₂ : ℕ} (A₁ : Matrix l₁ o₁ R) (A₂ : Matrix l₂ o₂ R)
    (f₁ : Fin r₁ → l₁) (g₁ : Fin r₁ → o₁) (f₂ : Fin r₂ → l₂) (g₂ : Fin r₂ → o₂) :
    (Matrix.fromBlocks A₁ 0 0 A₂).submatrix (Sum.map f₁ f₂) (Sum.map g₁ g₂)
      = Matrix.fromBlocks (A₁.submatrix f₁ g₁) 0 0 (A₂.submatrix f₂ g₂) := by
  ext i j
  rcases i with a | a <;> rcases j with b | b <;>
    simp [Matrix.submatrix, Matrix.fromBlocks]

/-- For the block diagonal matrix `fromBlocks A₁ 0 0 A₂`,
`∑_{r₁ + r₂ = r} I_{r₁}(A₁) · I_{r₂}(A₂) ⊆ I_r(fromBlocks A₁ 0 0 A₂)`. -/
theorem minorIdeal_fromBlocks_ge {R : Type*} [CommRing R] {l₁ o₁ l₂ o₂ : Type*}
    (A₁ : Matrix l₁ o₁ R) (A₂ : Matrix l₂ o₂ R) (r : ℕ) :
    (∑ p ∈ Finset.antidiagonal r, minorIdeal A₁ p.1 * minorIdeal A₂ p.2)
      ≤ minorIdeal (Matrix.fromBlocks A₁ 0 0 A₂) r := by
  apply Finset.sum_induction _ (· ≤ minorIdeal (Matrix.fromBlocks A₁ 0 0 A₂) r)
    (fun a b ha hb => sup_le ha hb) bot_le
  rintro ⟨r₁, r₂⟩ hp
  obtain rfl := Finset.mem_antidiagonal.mp hp
  rw [minorIdeal, minorIdeal, Ideal.span_mul_span, Ideal.span_le]
  rintro z ⟨x, ⟨f₁, g₁, rfl⟩, y, ⟨f₂, g₂, rfl⟩, rfl⟩
  apply Ideal.subset_span
  refine ⟨Sum.map f₁ f₂ ∘ (finSumFinEquiv).symm, Sum.map g₁ g₂ ∘ (finSumFinEquiv).symm, ?_⟩
  rw [← Matrix.submatrix_submatrix, fromBlocks_submatrix_sumMap,
    Matrix.det_submatrix_equiv_self, Matrix.det_fromBlocks_zero₂₁]

/-- An element lying in one product summand `I_a(A₁) · I_b(A₂)` with `a + b = r`
lies in the whole antidiagonal sum. -/
theorem minorIdeal_mem_antidiagonal_sum {R : Type*} [CommRing R] {l₁ o₁ l₂ o₂ : Type*}
    (A₁ : Matrix l₁ o₁ R) (A₂ : Matrix l₂ o₂ R) (r a b : ℕ) (hab : a + b = r) (z : R)
    (hz : z ∈ minorIdeal A₁ a * minorIdeal A₂ b) :
    z ∈ ∑ p ∈ Finset.antidiagonal r, minorIdeal A₁ p.1 * minorIdeal A₂ p.2 := by
  set I : ℕ × ℕ → Ideal R := fun p => minorIdeal A₁ p.1 * minorIdeal A₂ p.2
  have hle : I (a, b) ≤ ∑ p ∈ Finset.antidiagonal r, I p :=
    Finset.single_le_sum (fun _ _ => bot_le) (Finset.mem_antidiagonal.mpr hab)
  exact hle hz

/-- If `B = A.submatrix fl gl` over a finite index type `T` of cardinality `n`, then
`det B` is, after reindexing `T ≃ Fin n`, an `n × n` minor of `A`, hence lies in
`minorIdeal A n`. -/
theorem minorIdeal_det_submatrix_mem {R : Type*} [CommRing R] {l o : Type*}
    (A : Matrix l o R) {T : Type*} [Fintype T] [DecidableEq T] (n : ℕ)
    (hcard : Fintype.card T = n) (B : Matrix T T R) (fl : T → l) (gl : T → o)
    (hB : B = A.submatrix fl gl) : B.det ∈ minorIdeal A n := by
  rw [← Matrix.det_submatrix_equiv_self (Fintype.equivFinOfCardEq hcard).symm B, hB,
    Matrix.submatrix_submatrix, minorIdeal]
  exact Ideal.subset_span ⟨_, _, rfl⟩

/-- If the row index `x` and column index `y` are both `Sum.inl` (block 1), the entry
is the corresponding entry of `A₁`. -/
theorem fromBlocks_diag_left {R : Type*} [CommRing R] {l₁ o₁ l₂ o₂ : Type*}
    (A₁ : Matrix l₁ o₁ R) (A₂ : Matrix l₂ o₂ R)
    (x : l₁ ⊕ l₂) (y : o₁ ⊕ o₂) (hx : x.isLeft) (hy : y.isLeft) :
    Matrix.fromBlocks A₁ 0 0 A₂ x y = A₁ (x.getLeft hx) (y.getLeft hy) := by
  obtain ⟨p, rfl⟩ := Sum.isLeft_iff.mp hx
  obtain ⟨q, rfl⟩ := Sum.isLeft_iff.mp hy
  simp

/-- If the row index `x` and column index `y` are both `Sum.inr` (block 2), the entry
is the corresponding entry of `A₂`. -/
theorem fromBlocks_diag_right {R : Type*} [CommRing R] {l₁ o₁ l₂ o₂ : Type*}
    (A₁ : Matrix l₁ o₁ R) (A₂ : Matrix l₂ o₂ R)
    (x : l₁ ⊕ l₂) (y : o₁ ⊕ o₂) (hx : ¬x.isLeft) (hy : ¬y.isLeft) :
    Matrix.fromBlocks A₁ 0 0 A₂ x y
      = A₂ (x.getRight (Sum.not_isLeft.mp hx)) (y.getRight (Sum.not_isLeft.mp hy)) := by
  obtain ⟨p, rfl⟩ := Sum.isRight_iff.mp (Sum.not_isLeft.mp hx)
  obtain ⟨q, rfl⟩ := Sum.isRight_iff.mp (Sum.not_isLeft.mp hy)
  simp

/-- If `F` sends `α₁` into the first row block and `α₂` into the second, and `G` does likewise
for columns, then `det ((fromBlocks A₁ 0 0 A₂).submatrix F G)` lies in
`I_{|α₁|}(A₁) · I_{|α₂|}(A₂)`. -/
theorem det_fromBlocks_submatrix_mem_mul {R : Type*} [CommRing R] {l₁ o₁ l₂ o₂ : Type*}
    (A₁ : Matrix l₁ o₁ R) (A₂ : Matrix l₂ o₂ R) {α₁ α₂ : Type*} [Fintype α₁] [Fintype α₂]
    [DecidableEq α₁] [DecidableEq α₂] (F : α₁ ⊕ α₂ → l₁ ⊕ l₂) (G : α₁ ⊕ α₂ → o₁ ⊕ o₂)
    (hF₁ : ∀ a, (F (Sum.inl a)).isLeft) (hF₂ : ∀ a, ¬(F (Sum.inr a)).isLeft)
    (hG₁ : ∀ a, (G (Sum.inl a)).isLeft) (hG₂ : ∀ a, ¬(G (Sum.inr a)).isLeft) :
    ((Matrix.fromBlocks A₁ 0 0 A₂).submatrix F G).det
      ∈ minorIdeal A₁ (Fintype.card α₁) * minorIdeal A₂ (Fintype.card α₂) := by
  set N := (Matrix.fromBlocks A₁ 0 0 A₂).submatrix F G
  have h₁₂ : N.toBlocks₁₂ = 0 := by
    ext a b
    obtain ⟨p, hp⟩ := Sum.isLeft_iff.mp (hF₁ a)
    obtain ⟨q, hq⟩ := Sum.isRight_iff.mp (Sum.not_isLeft.mp (hG₂ b))
    simp [N, Matrix.toBlocks₁₂, hp, hq]
  have h₂₁ : N.toBlocks₂₁ = 0 := by
    ext a b
    obtain ⟨p, hp⟩ := Sum.isRight_iff.mp (Sum.not_isLeft.mp (hF₂ a))
    obtain ⟨q, hq⟩ := Sum.isLeft_iff.mp (hG₁ b)
    simp [N, Matrix.toBlocks₂₁, hp, hq]
  rw [← Matrix.fromBlocks_toBlocks N, h₁₂, h₂₁, Matrix.det_fromBlocks_zero₂₁]
  refine Ideal.mul_mem_mul
    (minorIdeal_det_submatrix_mem A₁ _ rfl _ (fun a => (F (.inl a)).getLeft (hF₁ a))
      (fun a => (G (.inl a)).getLeft (hG₁ a)) ?_)
    (minorIdeal_det_submatrix_mem A₂ _ rfl _
      (fun a => (F (.inr a)).getRight (Sum.not_isLeft.mp (hF₂ a)))
      (fun a => (G (.inr a)).getRight (Sum.not_isLeft.mp (hG₂ a))) ?_)
  · ext a a'
    exact fromBlocks_diag_left A₁ A₂ _ _ (hF₁ a) (hG₁ a')
  · ext a a'
    exact fromBlocks_diag_right A₁ A₂ _ _ (hF₂ a) (hG₂ a')

/-- If `f` selects as many rows from the first block as `g` selects columns from it, and likewise
for the second block, then the minor `det ((fromBlocks A₁ 0 0 A₂).submatrix f g)` lies in
`I_{n₁}(A₁) · I_{n₂}(A₂)`, where `n₁` and `n₂` are the numbers of rows selected from the two
blocks. -/
theorem minorIdeal_fromBlocks_le_eqCase {R : Type*} [CommRing R] {l₁ o₁ l₂ o₂ : Type*}
    (A₁ : Matrix l₁ o₁ R) (A₂ : Matrix l₂ o₂ R) (r : ℕ)
    (f : Fin r → l₁ ⊕ l₂) (g : Fin r → o₁ ⊕ o₂)
    (hcard : Fintype.card {i // (f i).isLeft} = Fintype.card {j // (g j).isLeft})
    (hcard2 : Fintype.card {i // ¬(f i).isLeft} = Fintype.card {j // ¬(g j).isLeft}) :
    ((Matrix.fromBlocks A₁ 0 0 A₂).submatrix f g).det
      ∈ minorIdeal A₁ (Fintype.card {i // (f i).isLeft})
        * minorIdeal A₂ (Fintype.card {i // ¬(f i).isLeft}) := by
  classical
  set n₁ := Fintype.card {i // (f i).isLeft}
  set n₂ := Fintype.card {i // ¬(f i).isLeft}
  set M : Matrix (Fin r) (Fin r) R := (Matrix.fromBlocks A₁ 0 0 A₂).submatrix f g with hM
  set eR : Fin r ≃ {i // (f i).isLeft} ⊕ {i // ¬ (f i).isLeft} :=
    (Equiv.sumCompl (fun i => (f i).isLeft)).symm with heR
  set eC : Fin r ≃ {j // (g j).isLeft} ⊕ {j // ¬ (g j).isLeft} :=
    (Equiv.sumCompl (fun j => (g j).isLeft)).symm
  let wL : {j // (g j).isLeft} ≃ {i // (f i).isLeft} := (Fintype.equivOfCardEq hcard.symm)
  let wR : {j // ¬(g j).isLeft} ≃ {i // ¬(f i).isLeft} := (Fintype.equivOfCardEq hcard2.symm)
  set eC'' : Fin r ≃ {i // (f i).isLeft} ⊕ {i // ¬ (f i).isLeft} :=
    eC.trans (Equiv.sumCongr wL wR) with heC''
  set N : Matrix ({i // (f i).isLeft} ⊕ {i // ¬ (f i).isLeft})
      ({i // (f i).isLeft} ⊕ {i // ¬ (f i).isLeft}) R := M.submatrix eR.symm eC''.symm with hN
  set ρ : Equiv.Perm ({i // (f i).isLeft} ⊕ {i // ¬ (f i).isLeft}) := eC''.symm.trans eR with hρ
  have hdetN : N.det = (↑(Equiv.Perm.sign ρ) : R) * M.det := by
    have e1 : N = (M.submatrix eR.symm eR.symm).submatrix id ρ := by
      rw [hN]
      ext a b
      simp only [Matrix.submatrix_apply, id_eq, hρ, Equiv.trans_apply, Equiv.symm_apply_apply]
    rw [e1, Matrix.det_permute', Matrix.det_submatrix_equiv_self]
  have heR_inl : ∀ a : {i // (f i).isLeft}, eR.symm (Sum.inl a) = (a : Fin r) :=
    fun a => by simp [heR, Equiv.sumCompl]
  have heR_inr : ∀ a : {i // ¬(f i).isLeft}, eR.symm (Sum.inr a) = (a : Fin r) :=
    fun a => by simp [heR, Equiv.sumCompl]
  have heC''_inl : ∀ a : {i // (f i).isLeft},
      eC''.symm (Sum.inl a) = ((wL.symm a : {j // (g j).isLeft}) : Fin r) :=
    fun a => by simp [heC'', Equiv.sumCompl, eC]
  have heC''_inr : ∀ a : {i // ¬(f i).isLeft},
      eC''.symm (Sum.inr a) = ((wR.symm a : {j // ¬(g j).isLeft}) : Fin r) :=
    fun a => by simp [heC'', Equiv.sumCompl, eC]
  have hmem : N.det ∈ minorIdeal A₁ n₁ * minorIdeal A₂ n₂ := by
    rw [hN, hM, Matrix.submatrix_submatrix]
    exact det_fromBlocks_submatrix_mem_mul A₁ A₂ _ _
      (fun a => by simpa [heR_inl] using a.2) (fun a => by simpa [heR_inr] using a.2)
      (fun a => by simpa [heC''_inl] using (wL.symm a).2)
      (fun a => by simpa [heC''_inr] using (wR.symm a).2)
  have hMdet : M.det = (↑(Equiv.Perm.sign ρ) : R) * N.det := by
    rcases Int.units_eq_one_or (Equiv.Perm.sign ρ) with h | h <;> simp [hdetN, h]
  rw [hMdet]
  exact Ideal.mul_mem_left _ _ hmem

/-- If `f` selects a different number of rows from the first block than `g` selects columns from
it, then the minor `det ((fromBlocks A₁ 0 0 A₂).submatrix f g)` vanishes. -/
theorem minorIdeal_fromBlocks_le_neCase {R : Type*} [CommRing R] {l₁ o₁ l₂ o₂ : Type*}
    (A₁ : Matrix l₁ o₁ R) (A₂ : Matrix l₂ o₂ R) (r : ℕ)
    (f : Fin r → l₁ ⊕ l₂) (g : Fin r → o₁ ⊕ o₂)
    (hne : Fintype.card {i // (f i).isLeft} ≠ Fintype.card {j // (g j).isLeft}) :
    ((Matrix.fromBlocks A₁ 0 0 A₂).submatrix f g).det = 0 := by
  classical
  rw [Matrix.det_apply]
  refine Finset.sum_eq_zero fun σ _ => ?_
  have hprod : ∏ i, ((Matrix.fromBlocks A₁ 0 0 A₂).submatrix f g) (σ i) i = 0 := by
    by_contra hcontra
    have hall : ∀ i, (f (σ i)).isLeft = (g i).isLeft := by
      intro i
      by_contra hi
      apply hcontra
      apply Finset.prod_eq_zero (Finset.mem_univ i)
      simp only [Matrix.submatrix_apply]
      rcases hfi : f (σ i) with p | p <;> rcases hgi : g i with q | q <;>
        simp_all [Matrix.fromBlocks]
    have heq : {i // (g i).isLeft} ≃ {i // (f i).isLeft} :=
      Equiv.subtypeEquiv σ (fun i => by rw [hall i])
    exact hne (Fintype.card_congr heq).symm
  rw [hprod, smul_zero]

/-- The numbers of indices of `Fin r` sent into the left and right summand add up to `r`. -/
private theorem card_isLeft_add_card_not_isLeft {α β : Type*} {r : ℕ} (h : Fin r → α ⊕ β) :
    Fintype.card {i // (h i).isLeft} + Fintype.card {i // ¬ (h i).isLeft} = r := by
  classical
  rw [← Fintype.card_sum]
  exact (Fintype.card_congr (Equiv.sumCompl (fun i => (h i).isLeft))).trans (Fintype.card_fin r)

/-- For the block diagonal matrix `fromBlocks A₁ 0 0 A₂`,
`I_r(fromBlocks A₁ 0 0 A₂) ⊆ ∑_{r₁ + r₂ = r} I_{r₁}(A₁) · I_{r₂}(A₂)`. -/
theorem minorIdeal_fromBlocks_le {R : Type*} [CommRing R] {l₁ o₁ l₂ o₂ : Type*}
    (A₁ : Matrix l₁ o₁ R) (A₂ : Matrix l₂ o₂ R) (r : ℕ) :
    minorIdeal (Matrix.fromBlocks A₁ 0 0 A₂) r
      ≤ ∑ p ∈ Finset.antidiagonal r, minorIdeal A₁ p.1 * minorIdeal A₂ p.2 := by
  classical
  rw [minorIdeal, Ideal.span_le]
  rintro x ⟨f, g, rfl⟩
  have hsumf := card_isLeft_add_card_not_isLeft f
  by_cases heq : Fintype.card {i // (f i).isLeft} = Fintype.card {j // (g j).isLeft}
  · have hsumg := card_isLeft_add_card_not_isLeft g
    have heq2 : Fintype.card {i // ¬ (f i).isLeft} = Fintype.card {j // ¬ (g j).isLeft} := by
      omega
    exact minorIdeal_mem_antidiagonal_sum A₁ A₂ r _ _ hsumf _
      (minorIdeal_fromBlocks_le_eqCase A₁ A₂ r f g heq heq2)
  · rw [minorIdeal_fromBlocks_le_neCase A₁ A₂ r f g heq]
    exact Submodule.zero_mem _

/-- **Stacks 07Z7** (part 4).
For the block diagonal matrix `diag(A₁, A₂) = fromBlocks A₁ 0 0 A₂`,
`I_r(diag(A₁, A₂)) = ∑_{r₁ + r₂ = r} I_{r₁}(A₁) · I_{r₂}(A₂)`, where the sum runs over all pairs
`(r₁, r₂)` of natural numbers with `r₁ + r₂ = r`. -/
@[stacks 07Z7 "(4)"]
theorem minorIdeal_fromBlocks {R : Type*} [CommRing R] {l₁ o₁ l₂ o₂ : Type*}
    (A₁ : Matrix l₁ o₁ R) (A₂ : Matrix l₂ o₂ R) (r : ℕ) :
    minorIdeal (Matrix.fromBlocks A₁ 0 0 A₂) r =
      ∑ p ∈ Finset.antidiagonal r, minorIdeal A₁ p.1 * minorIdeal A₂ p.2 :=
  le_antisymm (minorIdeal_fromBlocks_le A₁ A₂ r) (minorIdeal_fromBlocks_ge A₁ A₂ r)
