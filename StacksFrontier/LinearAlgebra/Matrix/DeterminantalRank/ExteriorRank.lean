/-!
# Rank and determinantal ideal of a map of finite free modules, via exterior powers

Throughout, `R` is a commutative ring and `φ : R^m → R^n` is an `R`-linear map of finite free
modules, identified with its matrix `A : Matrix (Fin n) (Fin m) R` in the standard bases, with
associated linear map `Matrix.mulVecLin A`.

* The *rank* of `φ` is `max {r ∈ ℕ | ⋀^r φ ≠ 0}`. For `R ≠ 0` it is the largest `r` such that
  `φ` has a nonzero `r × r` minor; it lies in `{0, 1, …, min m n}`.
* With `r = rank φ`, the *determinantal ideal* `I(φ) ⊆ R` is generated by the `r × r` minors of
  `A`. The empty `0 × 0` minor equals `1`, so `I(φ) = R` when `r = 0`.

## Main definitions

* `Stacks.DeterminantalRank.exteriorRank`: the rank, via exterior powers.
* `Stacks.DeterminantalRank.detIdeal`: the determinantal ideal `I(φ)`.

## Main results

* `Stacks.DeterminantalRank.injective_iff_rank_eq_and_annihilator_eq_bot`: over a local ring,
  `φ` is injective if and only if `rank φ = m` and `Ann_R (I(φ)) = 0`.
* `Stacks.DeterminantalRank.injective_iff_rank_eq_and_contains_nonZeroDivisor`: over a
  Noetherian local ring, `φ` is injective if and only if `rank φ = m` and either `I(φ) = R` or
  `I(φ)` contains a nonzerodivisor.

## Implementation notes

The rank is defined by `Nat.findGreatest`, which is total and returns `0` over the zero ring,
where `⋀^0 φ = id_R` vanishes. `[Nontrivial R]` is therefore assumed in the main statements.

## References

* [StacksProject 00MV](https://stacks.math.columbia.edu/tag/00MV)
* [StacksProject 00MX](https://stacks.math.columbia.edu/tag/00MX)
-/

@[expose] public section

namespace Stacks.DeterminantalRank

variable {R : Type*} [CommRing R] {m n : ℕ}

/-! ## Main Definitions -/

/-- The set of `r × r` minors of a matrix `A`: determinants of submatrices obtained
by selecting `r` rows (via `row : Fin r → Fin n`) and `r` columns
(via `col : Fin r → Fin m`).  Non-injective selections contribute determinant `0`,
hence do not change the ideal they generate. -/
def minorSet (A : Matrix (Fin n) (Fin m) R) (r : ℕ) : Set R :=
  {x | ∃ (row : Fin r → Fin n) (col : Fin r → Fin m), x = (A.submatrix row col).det}

open Classical in
/-- The rank of `φ = mulVecLin A`: the largest `r ≤ min m n` such that the `r`-th exterior
power `⋀^r φ` is nonzero. Since `⋀^r φ = 0` for `r > min m n`, and `⋀^0 φ = id ≠ 0` for
nontrivial `R`, this is the largest `r` with `⋀^r φ ≠ 0`. -/
@[stacks 00MV "(1)"]
noncomputable def exteriorRank (A : Matrix (Fin n) (Fin m) R) : ℕ :=
  Nat.findGreatest (fun r => exteriorPower.map r (Matrix.mulVecLin A) ≠ 0) (min m n)

/-- The determinantal ideal `I(φ)`: the ideal generated by the `rank × rank` minors of `A`.
When `rank = 0` the only minor is the empty minor `det (A.submatrix _ _) = 1`, so `I(φ) = R`. -/
@[stacks 00MV "(2)"]
noncomputable def detIdeal (A : Matrix (Fin n) (Fin m) R) : Ideal R :=
  Ideal.span (minorSet A (exteriorRank A))

/-! ## Exterior powers and minors -/

/-- **Coordinate formula.** With the standard bases `Pi.basisFun` of `Fin m → R` and
`Fin n → R`, the `(s, s')`-matrix entry of `⋀^r (mulVecLin A)` in the wedge basis is
the determinant of the corresponding `r × r` submatrix of `A`. -/
theorem exteriorPower_coord_formula (A : Matrix (Fin n) (Fin m) R) (r : ℕ)
    (s : Set.powersetCard (Fin n) r) (s' : Set.powersetCard (Fin m) r) :
    ((Module.Basis.exteriorPower r (Pi.basisFun R (Fin n))).repr
        (exteriorPower.map r (Matrix.mulVecLin A)
          (Module.Basis.exteriorPower r (Pi.basisFun R (Fin m)) s'))) s
      = (A.submatrix (Set.powersetCard.ofFinEmbEquiv.symm s)
          (Set.powersetCard.ofFinEmbEquiv.symm s')).det := by
  rw [exteriorPower.basis_repr_apply, exteriorPower.basis_apply]
  have hmap : exteriorPower.map r (Matrix.mulVecLin A)
        (exteriorPower.ιMulti_family R r (Pi.basisFun R (Fin m)) s')
      = exteriorPower.ιMulti_family R r ((Matrix.mulVecLin A) ∘ (Pi.basisFun R (Fin m))) s' :=
    congrFun (exteriorPower.map_comp_ιMulti_family (R := R) (n := r)
      (Pi.basisFun R (Fin m)) (Matrix.mulVecLin A)) s'
  rw [hmap]
  have hfam : exteriorPower.ιMulti_family R r ((Matrix.mulVecLin A) ∘ (Pi.basisFun R (Fin m))) s'
      = exteriorPower.ιMulti R r (fun i =>
          ((Matrix.mulVecLin A) ∘ (Pi.basisFun R (Fin m)))
            ((Set.powersetCard.ofFinEmbEquiv.symm s') i)) := by
    rw [exteriorPower.ιMulti_family]; rfl
  rw [hfam, exteriorPower.ιMultiDual_apply_ιMulti, ← Matrix.det_transpose]
  congr 1
  ext j i
  simp only [Matrix.transpose_apply, Matrix.of_apply, Matrix.submatrix_apply, Function.comp_apply]
  rw [Matrix.mulVecLin_apply]
  simp [Pi.basisFun_apply, Matrix.mulVec_single]

/-- Two injective families `Fin r → Fin N` with the same range differ by a permutation. -/
theorem exists_perm_of_range_eq {r : ℕ} {N : ℕ} (f g : Fin r → Fin N)
    (hf : Function.Injective f) (hrange : Set.range f = Set.range g) :
    ∃ e : Equiv.Perm (Fin r), f = g ∘ e := by
  have hsub : ∀ i, f i ∈ Set.range g := by
    rw [← hrange]
    exact Set.mem_range_self
  let einv : Fin r → Fin r := fun i => (hsub i).choose
  have heinv : ∀ i, g (einv i) = f i := fun i => (hsub i).choose_spec
  have hinj : Function.Injective einv := fun i j hij => hf (by rw [← heinv i, ← heinv j, hij])
  exact ⟨Equiv.ofBijective einv (Finite.injective_iff_bijective.mp hinj),
    funext fun i => (heinv i).symm⟩

/-- If a minor with injective row/column selections is nonzero, then the minor on the
same index *sets* taken in increasing order (the `powersetCard` enumeration) is also
nonzero (they differ only by a sign). -/
theorem exists_mono_minor_ne_zero (A : Matrix (Fin n) (Fin m) R) (r : ℕ)
    (row : Fin r → Fin n) (col : Fin r → Fin m)
    (hrow : Function.Injective row) (hcol : Function.Injective col)
    (hne : (A.submatrix row col).det ≠ 0) :
    ∃ (s : Set.powersetCard (Fin n) r) (s' : Set.powersetCard (Fin m) r),
      (A.submatrix (Set.powersetCard.ofFinEmbEquiv.symm s)
        (Set.powersetCard.ofFinEmbEquiv.symm s')).det ≠ 0 := by
  have hmemrow : (Finset.univ.image row) ∈ Set.powersetCard (Fin n) r := by
    simp [Finset.card_image_of_injective _ hrow]
  have hmemcol : (Finset.univ.image col) ∈ Set.powersetCard (Fin m) r := by
    simp [Finset.card_image_of_injective _ hcol]
  refine ⟨⟨_, hmemrow⟩, ⟨_, hmemcol⟩, ?_⟩
  set g := Set.powersetCard.ofFinEmbEquiv.symm (⟨_, hmemrow⟩ : Set.powersetCard (Fin n) r) with hg
  set g' := Set.powersetCard.ofFinEmbEquiv.symm (⟨_, hmemcol⟩ : Set.powersetCard (Fin m) r) with hg'
  have hgrange : Set.range g = Set.range row := by
    ext i
    rw [hg, Set.powersetCard.mem_range_ofFinEmbEquiv_symm_iff_mem]
    simp [Set.range]
  have hg'range : Set.range g' = Set.range col := by
    ext i
    rw [hg', Set.powersetCard.mem_range_ofFinEmbEquiv_symm_iff_mem]
    simp [Set.range]
  obtain ⟨e, he⟩ := exists_perm_of_range_eq row g hrow hgrange.symm
  obtain ⟨e', he'⟩ := exists_perm_of_range_eq col g' hcol hg'range.symm
  have hsub : A.submatrix row col = (A.submatrix g g').submatrix e e' := by
    rw [Matrix.submatrix_submatrix, ← he, ← he']
  rw [hsub] at hne
  intro hzero
  apply hne
  rw [show (A.submatrix g g').submatrix (e : Fin r → Fin r) (e' : Fin r → Fin r)
        = ((A.submatrix g g').submatrix e id).submatrix id e' by
        rw [Matrix.submatrix_submatrix]; rfl]
  rw [Matrix.det_permute', Matrix.det_permute, hzero, mul_zero, mul_zero]

/-- A nonzero `r × r` minor of `A` necessarily uses injective row and column selections
(otherwise a repeated row or column forces the determinant to vanish). -/
theorem minor_ne_zero_injective (A : Matrix (Fin n) (Fin m) R) (r : ℕ)
    (row : Fin r → Fin n) (col : Fin r → Fin m)
    (hne : (A.submatrix row col).det ≠ 0) :
    Function.Injective row ∧ Function.Injective col := by
  refine ⟨?_, ?_⟩
  · by_contra h
    rw [Function.not_injective_iff] at h
    obtain ⟨i, j, hij, hne'⟩ := h
    exact hne (Matrix.det_zero_of_row_eq hne'
      (by funext k; simp [Matrix.submatrix_apply, hij]))
  · by_contra h
    rw [Function.not_injective_iff] at h
    obtain ⟨i, j, hij, hne'⟩ := h
    exact hne (Matrix.det_zero_of_column_eq hne'
      (by intro k; simp [Matrix.submatrix_apply, hij]))

/-- The `r`-th exterior power of `mulVecLin A` is nonzero exactly when `A` has a nonzero
`r × r` minor. -/
theorem exteriorPower_map_ne_zero_iff_exists_minor (A : Matrix (Fin n) (Fin m) R)
    (r : ℕ) :
    exteriorPower.map r (Matrix.mulVecLin A) ≠ 0 ↔ ∃ x ∈ minorSet A r, x ≠ 0 := by
  constructor
  · intro hmap
    by_contra hcon
    push Not at hcon
    apply hmap
    apply (Module.Basis.exteriorPower r (Pi.basisFun R (Fin m))).ext
    intro s'
    have hzero : ∀ s, (Module.Basis.exteriorPower r (Pi.basisFun R (Fin n))).repr
        (exteriorPower.map r (Matrix.mulVecLin A)
          (Module.Basis.exteriorPower r (Pi.basisFun R (Fin m)) s')) s = 0 := by
      intro s
      rw [exteriorPower_coord_formula]
      exact hcon _ ⟨_, _, rfl⟩
    exact (Module.Basis.exteriorPower r (Pi.basisFun R (Fin n))).repr.map_eq_zero_iff.mp
      (Finsupp.ext hzero)
  · rintro ⟨x, ⟨row, col, rfl⟩, hxne⟩
    obtain ⟨hrow, hcol⟩ := minor_ne_zero_injective A r row col hxne
    obtain ⟨s, s', hmono⟩ := exists_mono_minor_ne_zero A r row col hrow hcol hxne
    intro hmap0
    apply hmono
    rw [← exteriorPower_coord_formula A r s s', hmap0, LinearMap.zero_apply,
      LinearEquiv.map_zero, Finsupp.zero_apply]

open Classical in
/-- For nontrivial `R`, the exterior-power rank equals the largest `r` admitting a
nonzero `r × r` minor. -/
theorem exteriorRank_eq_findGreatest_minor (A : Matrix (Fin n) (Fin m) R)
    [Nontrivial R] :
    exteriorRank A =
      Nat.findGreatest (fun r => ∃ x ∈ minorSet A r, x ≠ 0) (min m n) := by
  unfold exteriorRank
  have hpred : (fun r => exteriorPower.map r (Matrix.mulVecLin A) ≠ 0)
      = (fun r => ∃ x ∈ minorSet A r, x ≠ 0) := by
    funext r
    exact propext (exteriorPower_map_ne_zero_iff_exists_minor A r)
  simp only [hpred]

open Classical in
/-- The exterior-power rank is at most `min m n`. -/
theorem exteriorRank_le (A : Matrix (Fin n) (Fin m) R) :
    exteriorRank A ≤ min m n :=
  Nat.findGreatest_le _

/-- When `rank φ = 0`, the determinantal ideal is the whole ring. -/
theorem detIdeal_eq_top_of_rank_zero (A : Matrix (Fin n) (Fin m) R)
    (h : exteriorRank A = 0) : detIdeal A = ⊤ := by
  rw [detIdeal, h]
  have h1 : (1 : R) ∈ minorSet A 0 := by
    refine ⟨Fin.elim0, Fin.elim0, ?_⟩
    exact Matrix.det_isEmpty.symm
  rw [Ideal.eq_top_iff_one]
  exact Ideal.subset_span h1

/-! ## Injectivity over a local ring -/

/-- If `rank φ = m`, every element of `I(φ)` annihilates `ker φ`: if `φ x = 0` then
`f • x = 0` for every `f ∈ detIdeal A`. For an `m × m` minor `f = det B` this is the adjugate
identity `adjugate B * B = det B • 1`. -/
theorem detIdeal_smul_eq_zero_of_mulVec_eq_zero (A : Matrix (Fin n) (Fin m) R)
    (hrank : exteriorRank A = m) {x : Fin m → R} (hx : Matrix.mulVecLin A x = 0) :
    ∀ f ∈ detIdeal A, f • x = 0 := by
  have hAx : A.mulVec x = 0 := by
    have := hx
    rwa [Matrix.mulVecLin_apply] at this
  have hsquare : ∀ C : Matrix (Fin m) (Fin m) R, C.mulVec x = 0 → C.det • x = 0 := by
    intro C hC
    have key : (C.adjugate * C).mulVec x = 0 := by
      rw [← Matrix.mulVec_mulVec, hC, Matrix.mulVec_zero]
    rw [Matrix.adjugate_mul, Matrix.smul_mulVec, Matrix.one_mulVec] at key
    exact key
  rw [detIdeal, hrank]
  intro f hf
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hf
  · rintro f ⟨row, col, rfl⟩
    by_cases hdet : (A.submatrix row col).det = 0
    · rw [hdet, zero_smul]
    · have hcol := (minor_ne_zero_injective A m row col hdet).2
      have hbij : Function.Bijective col := (Finite.injective_iff_bijective).mp hcol
      let e : Equiv.Perm (Fin m) := Equiv.ofBijective col hbij
      have hcoe : (e : Fin m → Fin m) = col := rfl
      set C : Matrix (Fin m) (Fin m) R := A.submatrix row id with hCdef
      have hCx : C.mulVec x = 0 := by
        have hmv := Matrix.submatrix_mulVec_equiv A x row (Equiv.refl (Fin m))
        simp only [Equiv.coe_refl, Function.comp_id, Equiv.refl_symm] at hmv
        rw [hCdef, hmv, hAx]
        rfl
      have hCdetx : C.det • x = 0 := hsquare C hCx
      have hperm : (A.submatrix row col).det = (Equiv.Perm.sign e : R) * C.det := by
        have : A.submatrix row col = C.submatrix id e := by
          rw [hCdef]
          ext i j
          simp [Matrix.submatrix_apply, hcoe]
        rw [this, Matrix.det_permute']
      rw [hperm, mul_smul, hCdetx, smul_zero]
  · rw [zero_smul]
  · intro a b _ _ ha hb
    rw [add_smul, ha, hb, add_zero]
  · intro c a _ ha
    rw [smul_eq_mul, mul_smul, ha, smul_zero]

/-- If `rank φ = m` and `Ann_R(I(φ)) = 0`, then `φ` is injective. -/
theorem injective_of_rank_eq_of_annihilator_eq_bot (A : Matrix (Fin n) (Fin m) R)
    (hrank : exteriorRank A = m) (hann : (detIdeal A).annihilator = ⊥) :
    Function.Injective (Matrix.mulVecLin A) := by
  rw [← LinearMap.ker_eq_bot, Submodule.eq_bot_iff]
  intro x hx
  rw [LinearMap.mem_ker] at hx
  have hsmul : ∀ f ∈ detIdeal A, f • x = 0 :=
    detIdeal_smul_eq_zero_of_mulVec_eq_zero A hrank hx
  funext j
  have hmem : x j ∈ (detIdeal A).annihilator := by
    rw [Submodule.mem_annihilator]
    intro f hf
    have := congrFun (hsmul f hf) j
    simpa [Pi.smul_apply, smul_eq_mul, mul_comm] using this
  rw [hann, Submodule.mem_bot] at hmem
  simpa using hmem

/-- An element annihilates the ideal generated by the `r × r` minors iff it annihilates
each minor. -/
theorem annihilator_minorSet_iff (A : Matrix (Fin n) (Fin m) R) (r : ℕ) (c : R) :
    c ∈ (Ideal.span (minorSet A r)).annihilator ↔ ∀ s ∈ minorSet A r, c * s = 0 := by
  rw [Submodule.mem_annihilator]
  constructor
  · exact fun h s hs => by simpa using h s (Ideal.subset_span hs)
  · intro h s hs
    refine Submodule.span_induction h ?_ ?_ ?_ hs
    · simp
    · intro a b _ _ ha hb
      rw [smul_add, ha, hb, add_zero]
    · intro r a _ ha
      rw [smul_comm, ha, smul_zero]

/-- The last column of the adjugate of a `(s+1) × (s+1)` matrix
depends only on the first `s` rows (the `castSucc` rows). -/
theorem mccoy_adj_last_col_eq {s : ℕ} (T T' : Matrix (Fin (s + 1)) (Fin (s + 1)) R)
    (h : ∀ (i : Fin s), T (Fin.castSucc i) = T' (Fin.castSucc i))
    (j : Fin (s + 1)) :
    Matrix.adjugate T j (Fin.last s) = Matrix.adjugate T' j (Fin.last s) := by
  rw [Matrix.adjugate_fin_succ_eq_det_submatrix, Matrix.adjugate_fin_succ_eq_det_submatrix]
  congr 1
  apply congrArg
  ext a b
  simp only [Matrix.submatrix_apply, Fin.succAbove_last_apply]
  rw [h a]

/-- The `i`-th coordinate of `A *ᵥ x`, for `x` the vector supported on the columns `col'` with
values `ct * v j`, is `ct * ∑ j, A i (col' j) * v j`. -/
theorem mccoy_mulVec_border {s : ℕ} (A : Matrix (Fin n) (Fin m) R)
    (col' : Fin (s + 1) → Fin m) (v : Fin (s + 1) → R) (ct : R) (i : Fin n)
    (x : Fin m → R) (hx : x = fun p => ct * ∑ j, (if col' j = p then v j else 0)) :
    A.mulVec x i = ct * ∑ j, A i (col' j) * v j := by
  have h1 : A.mulVec x i = ∑ p, A i p * x p := by
    simp [Matrix.mulVec, dotProduct]
  rw [h1, hx]
  simp only []
  have lhs_eq : (∑ p, A i p * (ct * ∑ j, (if col' j = p then v j else 0)))
      = ∑ p, ∑ j, ct * (A i p * (if col' j = p then v j else 0)) := by
    apply Finset.sum_congr rfl
    intro p _
    rw [Finset.mul_sum, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _; ring
  rw [lhs_eq, Finset.sum_comm, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  rw [Finset.sum_eq_single (col' j)]
  · simp
  · intro p _ hp
    rw [ite_eq_right (by intro h; exact hp h.symm), mul_zero, mul_zero]
  · intro h; exact absurd (Finset.mem_univ _) h

/-- **A bordered-matrix kernel vector.** Given a nonvanishing
`s × s` minor `A.submatrix row₀ col₀` scaled by `ct` (with `ct` annihilating all
`(s+1) × (s+1)` minors), the cofactor expansion produces a nonzero kernel vector
of `A.mulVec`. -/
theorem mccoy_border_kernel {s : ℕ} (A : Matrix (Fin n) (Fin m) R)
    (row₀ : Fin s → Fin n) (col₀ : Fin s → Fin m) (col_extra : Fin m)
    (ct : R)
    (hcol' : Function.Injective (Fin.snoc col₀ col_extra : Fin (s + 1) → Fin m))
    (hann : ∀ d ∈ minorSet A (s + 1), ct * d = 0)
    (hne : ct * (A.submatrix row₀ col₀).det ≠ 0) :
    ∃ x : Fin m → R, x ≠ 0 ∧ A.mulVec x = 0 := by
  classical
  set col' : Fin (s+1) → Fin m := Fin.snoc col₀ col_extra with hcoldef
  set Brow : Fin s → Fin (s+1) → R := fun a b => A (row₀ a) (col' b) with hBrow
  set T : Matrix (Fin (s+1)) (Fin (s+1)) R := Matrix.of (Fin.snoc Brow (fun _ => 0)) with hT
  set v : Fin (s+1) → R := fun j => Matrix.adjugate T j (Fin.last s) with hv
  set x : Fin m → R := fun p => ct * ∑ j, (if col' j = p then v j else 0) with hx
  have hTsub : T.submatrix Fin.castSucc Fin.castSucc = A.submatrix row₀ col₀ := by
    ext a b
    simp only [Matrix.submatrix_apply, hT, Matrix.of_apply, Fin.snoc_castSucc, hBrow]
    simp [hcoldef, Fin.snoc_castSucc]
  have hvlast : v (Fin.last s) = (A.submatrix row₀ col₀).det := by
    rw [hv]
    simp only []
    rw [Matrix.adjugate_fin_succ_eq_det_submatrix]
    have he : ((-1 : R)) ^ ((Fin.last s : ℕ) + (Fin.last s : ℕ)) = 1 := by
      rw [← two_mul, pow_mul]; norm_num
    rw [he, one_mul]
    have hsub2 : T.submatrix (Fin.last s).succAbove (Fin.last s).succAbove
        = T.submatrix Fin.castSucc Fin.castSucc := by
      ext a b; simp
    rw [hsub2, hTsub]
  refine ⟨x, ?_, ?_⟩
  · intro h0
    have hxcorner : x col_extra = ct * (A.submatrix row₀ col₀).det := by
      rw [hx]
      simp only []
      rw [Finset.sum_eq_single (Fin.last s)]
      · rw [ite_eq_left]
        · rw [hvlast]
        · rw [hcoldef, Fin.snoc_last]
      · intro j _ hj
        rw [ite_eq_right]
        exact fun hcontra => hj (hcol' (by rw [hcontra, hcoldef, Fin.snoc_last]))
      · exact fun h => absurd (Finset.mem_univ _) h
    exact hne (hxcorner ▸ congrFun h0 col_extra)
  · funext i
    rw [mccoy_mulVec_border A col' v ct i x hx]
    set Mi : Matrix (Fin (s+1)) (Fin (s+1)) R := A.submatrix (Fin.snoc row₀ i) col' with hMi
    have hdet : Mi.det = ∑ j, A i (col' j) * v j := by
      rw [Matrix.det_eq_sum_mul_adjugate_row Mi (Fin.last s)]
      apply Finset.sum_congr rfl
      intro j _
      have hlast : Mi (Fin.last s) j = A i (col' j) := by
        simp [hMi, Matrix.submatrix_apply, Fin.snoc_last]
      have hadj : Matrix.adjugate Mi j (Fin.last s) = v j := by
        rw [hv]
        apply mccoy_adj_last_col_eq
        intro a
        funext b
        simp [hMi, hT, Matrix.submatrix_apply, Fin.snoc_castSucc, hBrow]
      rw [hlast, hadj]
    rw [← hdet]
    have hkill : ct * Mi.det = 0 := hann Mi.det ⟨Fin.snoc row₀ i, col', rfl⟩
    rw [hkill]; rfl

/-- **McCoy's theorem, forward direction.** Let `A : Matrix (Fin n) (Fin m) R` over a
commutative ring with `m ≤ n`. If there is a *nonzero* `c ∈ R` annihilating *every* `m × m`
minor of `A`, then `φ = mulVecLin A` is not injective.

The argument is by descent on the minor size. Consider the predicate
`P t := ∃ c ≠ 0, ∀ d ∈ minorSet A t, c * d = 0`. `P 0` is false (the empty minor is `1`), and
`P m` is true by hypothesis. Let `t` be least with `P t`, with witness `c_t ≠ 0`; since `P (t-1)`
fails, there is a `(t-1) × (t-1)` submatrix `B` with `c_t * det B ≠ 0`. Border `B` to `t × t`
matrices `M_i` (rows of `B` plus row `i`, on the columns of `B` plus one more) and let `x` be
`c_t` times the cofactors of the last row. Then `(A *ᵥ x)_i = c_t * det M_i = 0`, while the
corner coordinate of `x` is `± c_t * det B ≠ 0`, so `x ≠ 0` lies in `ker φ`. -/
theorem mccoy_core (A : Matrix (Fin n) (Fin m) R) (hmn : m ≤ n)
    (c : R) (hc : c ≠ 0) (hann : ∀ d ∈ minorSet A m, c * d = 0) :
    ¬ Function.Injective (Matrix.mulVecLin A) := by
  classical
  suffices hker : ∃ x : Fin m → R, x ≠ 0 ∧ A.mulVec x = 0 by
    obtain ⟨x, hxne, hx0⟩ := hker
    intro hinj
    apply hxne
    apply hinj
    rw [map_zero, Matrix.mulVecLin_apply, hx0]
  have h1mem : (1 : R) ∈ minorSet A 0 := ⟨Fin.elim0, Fin.elim0, Matrix.det_isEmpty.symm⟩
  have hm1 : 1 ≤ m := by
    rcases Nat.eq_zero_or_pos m with hm0 | hpos
    · subst hm0
      exact absurd (by simpa using hann 1 h1mem) hc
    · exact hpos
  set P : ℕ → Prop := fun t => ∃ c' : R, c' ≠ 0 ∧ ∀ d ∈ minorSet A t, c' * d = 0 with hP
  set Q : ℕ → Prop := fun t => 1 ≤ t ∧ P t with hQ
  have hQm : Q m := ⟨hm1, c, hc, hann⟩
  have hQex : ∃ t, Q t := ⟨m, hQm⟩
  have hQt : Q (Nat.find hQex) := Nat.find_spec hQex
  have htm : Nat.find hQex ≤ m := Nat.find_le hQm
  have hmin : ∀ k, k < Nat.find hQex → ¬ Q k := fun _ => Nat.find_min hQex
  set t := Nat.find hQex with ht
  clear_value t
  obtain ⟨ht1, ct, hctne, hctann⟩ := hQt
  obtain ⟨s, rfl⟩ : ∃ s, t = s + 1 := ⟨t - 1, by omega⟩
  have hQsfalse : ¬ Q s := hmin s (by omega)
  have hnotann : ¬ (∀ d ∈ minorSet A s, ct * d = 0) := by
    rcases Nat.eq_zero_or_pos s with hs0 | hspos
    · subst hs0
      exact fun hcon => hctne (by simpa using hcon 1 h1mem)
    · intro hcon
      exact hQsfalse ⟨hspos, ct, hctne, hcon⟩
  push Not at hnotann
  obtain ⟨d, hdmem, hdne⟩ := hnotann
  obtain ⟨row₀, col₀, rfl⟩ := hdmem
  have hcol₀inj : Function.Injective col₀ :=
    (minor_ne_zero_injective A s row₀ col₀ fun h => hdne (by rw [h, mul_zero])).2
  have hsm : s < m := by omega
  have hexcol : ∃ p : Fin m, ∀ j, col₀ j ≠ p := by
    by_contra hcon
    push Not at hcon
    have hsurj : Function.Surjective col₀ := by
      intro p; obtain ⟨j, hj⟩ := hcon p; exact ⟨j, hj⟩
    have hcard := Fintype.card_le_of_surjective col₀ hsurj
    simp only [Fintype.card_fin] at hcard
    omega
  obtain ⟨col_extra, hcolextra⟩ := hexcol
  have hcol'inj : Function.Injective (Fin.snoc col₀ col_extra : Fin (s+1) → Fin m) := by
    intro a b hab
    induction a using Fin.lastCases with
    | last =>
      induction b using Fin.lastCases with
      | last => rfl
      | cast i =>
        rw [Fin.snoc_last, Fin.snoc_castSucc] at hab
        exact absurd hab.symm (hcolextra i)
    | cast i =>
      induction b using Fin.lastCases with
      | last =>
        rw [Fin.snoc_last, Fin.snoc_castSucc] at hab
        exact absurd hab (hcolextra i)
      | cast j =>
        rw [Fin.snoc_castSucc, Fin.snoc_castSucc] at hab
        rw [hcol₀inj hab]
  exact mccoy_border_kernel A row₀ col₀ col_extra ct hcol'inj hctann hdne

/-- If `φ` is injective, then `rank φ = m` and `Ann_R(I(φ)) = 0`; this is the forward
direction of McCoy's theorem. -/
theorem rank_eq_and_annihilator_eq_bot_of_injective [Nontrivial R]
    (A : Matrix (Fin n) (Fin m) R)
    (hinj : Function.Injective (Matrix.mulVecLin A)) :
    exteriorRank A = m ∧ (detIdeal A).annihilator = ⊥ := by
  classical
  have hmn : m ≤ n := StrongRankCondition.le_of_fin_injective _ hinj
  have hmin : min m n = m := Nat.min_eq_left hmn
  have hexists : ∃ d ∈ minorSet A m, d ≠ 0 := by
    by_contra hcon
    push Not at hcon
    apply mccoy_core A hmn (1 : R) one_ne_zero ?_ hinj
    intro d hd
    rw [hcon d hd, mul_zero]
  have hrank : exteriorRank A = m := by
    rw [exteriorRank_eq_findGreatest_minor A, hmin]
    exact Nat.findGreatest_eq hexists
  refine ⟨hrank, ?_⟩
  rw [detIdeal, hrank, Submodule.eq_bot_iff]
  intro c hc
  rw [annihilator_minorSet_iff] at hc
  by_contra hcne
  exact mccoy_core A hmn c hcne hc hinj

/-- **Injectivity over a local ring.** Let `R` be a commutative local ring and
`φ = mulVecLin A : R^m → R^n`.  Then `φ` is injective if and only if `rank φ = m`
and `Ann_R(I(φ)) = 0`. -/
theorem injective_iff_rank_eq_and_annihilator_eq_bot
    [IsLocalRing R] (A : Matrix (Fin n) (Fin m) R) :
    Function.Injective (Matrix.mulVecLin A) ↔
      exteriorRank A = m ∧ (detIdeal A).annihilator = ⊥ :=
  ⟨rank_eq_and_annihilator_eq_bot_of_injective A,
    fun ⟨hrank, hann⟩ => injective_of_rank_eq_of_annihilator_eq_bot A hrank hann⟩

/-! ## Injectivity over a Noetherian local ring -/

/-- In a Noetherian ring, an ideal containing no nonzerodivisor has a nonzero
annihilator. -/
theorem annihilator_ne_bot_of_forall_notMem_nonZeroDivisors [IsNoetherianRing R]
    {J : Ideal R} (hnzd : ∀ f ∈ nonZeroDivisors R, f ∉ J) :
    J.annihilator ≠ ⊥ := by
  intro hann
  have hsub : (J : Set R) ⊆ ⋃ p ∈ associatedPrimes R R, (p : Set R) := by
    rw [biUnion_associatedPrimes_eq_compl_nonZeroDivisors R]
    exact fun r hr hrnzd => hnzd r hrnzd hr
  rw [Ideal.subset_union_prime_finite (associatedPrimes.finite R R) J J
    fun p hp _ _ => hp.isPrime] at hsub
  obtain ⟨p, hp, hJp⟩ := hsub
  obtain ⟨hpprime, x, hpx⟩ := isAssociatedPrime_iff.mp hp
  have hxne : x ≠ 0 := by
    rintro rfl
    apply hpprime.ne_top
    rw [hpx]
    ext r
    simp [Submodule.mem_colon]
  have hxann : x ∈ J.annihilator := by
    rw [Submodule.mem_annihilator]
    intro a ha
    have hap : a ∈ p := hJp ha
    rw [hpx, Submodule.mem_colon] at hap
    have h0 := hap x (Set.mem_singleton x)
    rw [Submodule.mem_bot] at h0
    simpa [smul_eq_mul, mul_comm] using h0
  exact hxne (by rwa [hann, Submodule.mem_bot] at hxann)

/-- In a Noetherian ring, an ideal `J` has zero annihilator iff `J = ⊤` or `J` contains a
nonzerodivisor. -/
theorem annihilator_eq_bot_iff_eq_top_or_nonZeroDivisor
    [IsNoetherianRing R] (J : Ideal R) :
    J.annihilator = ⊥ ↔ (J = ⊤ ∨ ∃ f ∈ nonZeroDivisors R, f ∈ J) := by
  constructor
  · intro hann
    by_contra hcon
    push Not at hcon
    exact annihilator_ne_bot_of_forall_notMem_nonZeroDivisors hcon.2 hann
  · rintro (rfl | ⟨f, hf, hfJ⟩)
    · rw [Submodule.annihilator_top, Submodule.eq_bot_iff]
      intro r hr
      rw [Module.mem_annihilator] at hr
      simpa using hr 1
    · rw [Submodule.eq_bot_iff]
      intro x hx
      rw [Submodule.mem_annihilator] at hx
      exact (mem_nonZeroDivisors_iff.mp hf).2 x (hx f hfJ)

/-- **Injectivity over a Noetherian local ring.** Let `R` be a Noetherian commutative local
ring and `φ = mulVecLin A : R^m → R^n`. Then `φ` is injective if and only if `rank φ = m` and
either `I(φ) = R` or `I(φ)` contains a nonzerodivisor. -/
theorem injective_iff_rank_eq_and_contains_nonZeroDivisor
    [IsLocalRing R] [IsNoetherianRing R] (A : Matrix (Fin n) (Fin m) R) :
    Function.Injective (Matrix.mulVecLin A) ↔
      exteriorRank A = m ∧
        (detIdeal A = ⊤ ∨ ∃ f ∈ nonZeroDivisors R, f ∈ detIdeal A) := by
  rw [injective_iff_rank_eq_and_annihilator_eq_bot A]
  exact and_congr_right fun _ => annihilator_eq_bot_iff_eq_top_or_nonZeroDivisor (detIdeal A)

end Stacks.DeterminantalRank
