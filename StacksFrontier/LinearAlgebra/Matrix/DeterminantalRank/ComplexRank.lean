/-!
# Complexes of finite free modules: the rank and the ideal `I(φ)` via minors

Throughout, `R` is a nontrivial commutative ring, and a map `φ : R^m → R^n` of finite free
modules is identified with its matrix `φ : Matrix (Fin n) (Fin m) R` in the standard bases.
Here the rank is taken directly in terms of minors: `rank φ` is the largest `r` such that some
`r × r` minor of `φ` is nonzero, and `I(φ)` is the ideal generated by the `r × r` minors for
`r = rank φ`. The empty `0 × 0` minor equals `1`, so `I(φ) = R` when `rank φ = 0`.

This file also sets up complexes `0 → R^{n_e} →^{φ_e} R^{n_{e-1}} → ⋯ → R^{n_1} →^{φ_1} R^{n_0}`
of finite free modules, their isomorphisms, the trivial complexes and their direct sums, and the
basic rank theory: the Cauchy–Binet formula, the bounds it yields on the rank, invariance of the
rank under left and right multiplication by invertible matrices, and invariance of `rank`,
`rIndex` and `minorIdeal` under an isomorphism of complexes.

## Main definitions

* `StacksComplex.rank`, `StacksComplex.minorIdeal`: the rank and `I(φ)`, via minors.
* `StacksComplex.Complex`: a complex of finite free modules of length `e`.
* `StacksComplex.ComplexIso`: an isomorphism of complexes of the same length.
* `StacksComplex.rIndex`: the integer `r_i = ∑_{k=i}^e (-1)^{k-i} n_k`.
* `StacksComplex.IsTrivial`, `StacksComplex.zeroComplex`, `StacksComplex.directSum`,
  `StacksComplex.IsSumOfTrivials`, `StacksComplex.IsoToSumOfTrivials`: being (isomorphic to) a
  direct sum of trivial complexes.

## Main results

* `StacksComplex.rank_conj_eq`: the rank is unchanged by multiplying on either side by an
  invertible matrix.
* `StacksComplex.rank_eq_of_iso`, `StacksComplex.rIndex_eq_of_iso`,
  `StacksComplex.minorIdeal_eq_of_iso`: invariance under an isomorphism of complexes.
-/

@[expose] public section

namespace StacksComplex

variable {R : Type*} [CommRing R] [Nontrivial R] {e : ℕ}

/-! ## The rank and the ideal `I(φ)` of a map of finite free modules -/

/-- Rank of a map of finite free modules: the largest
`r` such that some `r × r` minor of the matrix is nonzero. We model the map
`φ : R^m → R^n` as its matrix `φ : Matrix (Fin n) (Fin m) R`. An `r × r` minor is the
determinant of the submatrix on `r` chosen rows and `r` chosen columns. The set of
such `r` always contains `0` (the empty minor has determinant `1`, nonzero when
`R ≠ 0`) and is bounded above by `min m n`, so the supremum is the maximum. -/
noncomputable def rank {m n : ℕ} (φ : Matrix (Fin n) (Fin m) R) : ℕ :=
  sSup {r | ∃ (rows : Fin r → Fin n) (cols : Fin r → Fin m), (φ.submatrix rows cols).det ≠ 0}

/-- The ideal `I(φ) ⊆ R` generated by the `r × r` minors of `φ`, where
`r = rank φ`. When `rank φ = 0` the only minor is the empty determinant `1`, so
`I(φ) = R`. -/
noncomputable def minorIdeal {m n : ℕ} (φ : Matrix (Fin n) (Fin m) R) : Ideal R :=
  Ideal.span {x : R | ∃ (rows : Fin (rank φ) → Fin n) (cols : Fin (rank φ) → Fin m),
    x = (φ.submatrix rows cols).det}

/-! ## Complexes of finite free modules -/

/-- A complex of finite free modules `0 → R^{n e} → ⋯ → R^{n 0}` concentrated in
degrees `0,…,e`. The data are carried over all of `ℕ`, with `n i = 0` for `i > e`. The
differential `d i : R^{n (i+1)} → R^{n i}` is written as an `n i × n (i+1)` matrix; it is the
map `φ_{i+1}`, so `φ_i : R^{n_i} → R^{n_{i-1}}` is `d (i-1)`. -/
@[sga "4 XVII 0.4" "special case"]
structure Complex (R : Type*) [CommRing R] (e : ℕ) where
  /-- The ranks of the free modules; supported on degrees `0,…,e`. -/
  n : ℕ → ℕ
  /-- The differentials `d i : R^{n (i+1)} → R^{n i}` (matrix `n i × n (i+1)`). -/
  d : ∀ i : ℕ, Matrix (Fin (n i)) (Fin (n (i + 1))) R
  /-- `n` vanishes in degrees `> e`. -/
  vanish : ∀ i : ℕ, e < i → n i = 0
  /-- The complex condition: consecutive differentials compose to zero. -/
  complex : ∀ i : ℕ, (d i) * (d (i + 1)) = 0

/-- For `1 ≤ i ≤ e`, the integer `r_i = ∑_{k=i}^e (-1)^{k-i} n_k`. -/
def rIndex (C : Complex R e) (i : ℕ) : ℤ :=
  ∑ k ∈ Finset.Icc i e, (-1 : ℤ) ^ (k - i) * (C.n k : ℤ)

/-! ## Isomorphism of complexes. -/

/-- An isomorphism of complexes `C ≅ C'` (sharing the same length `e`): a family of
invertible square matrices `ψ i` commuting with the differentials. We record both the
matrix and its two-sided inverse; commutation is `C'.d i * ψ (i+1) = ψ i * C.d i`. -/
structure ComplexIso (C C' : Complex R e) where
  /-- The isomorphism in degree `i`, as a matrix `C'.n i × C.n i`. -/
  ψ : ∀ i : ℕ, Matrix (Fin (C'.n i)) (Fin (C.n i)) R
  /-- Its inverse. -/
  ψinv : ∀ i : ℕ, Matrix (Fin (C.n i)) (Fin (C'.n i)) R
  left : ∀ i : ℕ, ψinv i * ψ i = 1
  right : ∀ i : ℕ, ψ i * ψinv i = 1
  comm : ∀ i : ℕ, C'.d i * ψ (i + 1) = ψ i * C.d i

/-! ## Trivial complexes and direct sums of trivial complexes -/

/-- A complex is *trivial* if it is either:
* `0 → ⋯ → 0 → R →^{id} R → 0 → ⋯ → 0`, i.e. there is an index `k` with `k+1 ≤ e`,
  `n (k+1) = 1`, `n k = 1`, the differential `d k` is the identity `1×1` matrix
  (its unique entry is `1`), and `n j = 0` for all other `j` (here `d k` plays the
  role of `φ_{k+1}`); or
* `0 → ⋯ → 0 → R`, i.e. `n 0 = 1` and `n j = 0` for `j > 0`. -/
def IsTrivial (C : Complex R e) : Prop :=
  (∃ k : ℕ, k + 1 ≤ e ∧ C.n (k + 1) = 1 ∧ C.n k = 1 ∧
      (∀ (a : Fin (C.n k)) (b : Fin (C.n (k + 1))), C.d k a b = 1) ∧
      (∀ j : ℕ, j ≠ k → j ≠ k + 1 → C.n j = 0))
  ∨ (C.n 0 = 1 ∧ ∀ j : ℕ, 0 < j → C.n j = 0)

/-- The zero complex (all modules zero); the empty direct sum. -/
def zeroComplex (R : Type*) [CommRing R] (e : ℕ) : Complex R e where
  n := fun _ => 0
  d := fun _ => 0
  vanish := fun _ _ => rfl
  complex := fun _ => by simp

/-- The (binary) direct sum of two complexes of the same length, with block-diagonal
differentials. -/
@[implicit_reducible]
noncomputable def directSum (C₁ C₂ : Complex R e) : Complex R e where
  n := fun i => C₁.n i + C₂.n i
  d := fun i =>
    (Matrix.fromBlocks (C₁.d i) 0 0 (C₂.d i)).reindex finSumFinEquiv finSumFinEquiv
  vanish := fun i hi => by simp [C₁.vanish i hi, C₂.vanish i hi]
  complex := fun i => by
    simp only [Matrix.reindex_apply]
    rw [Matrix.submatrix_mul_equiv, Matrix.fromBlocks_multiply]
    simp [C₁.complex i, C₂.complex i]

/-- A complex *is a direct sum of trivial complexes*: the smallest class
of complexes containing the zero complex and all trivial complexes, closed under
binary direct sum. -/
inductive IsSumOfTrivials : Complex R e → Prop
  | zero : IsSumOfTrivials (zeroComplex R e)
  | trivial {C : Complex R e} : IsTrivial C → IsSumOfTrivials C
  | sum {C₁ C₂ : Complex R e} : IsSumOfTrivials C₁ → IsSumOfTrivials C₂ →
      IsSumOfTrivials (directSum C₁ C₂)

/-- A complex is *isomorphic to a direct sum of trivial complexes* if it is isomorphic
(as a complex) to some complex that is a direct sum of trivial complexes. -/
def IsoToSumOfTrivials (C : Complex R e) : Prop :=
  ∃ D : Complex R e, IsSumOfTrivials D ∧ Nonempty (ComplexIso C D)

/-! ## Cauchy-Binet and rank theory

The rank is invariant under left and right multiplication by invertible matrices
(`rank_conj_eq`). -/

section Helpers

open Matrix BigOperators

omit [Nontrivial R] in
/-- **Cauchy–Binet formula** (function form): for `A : r×n` and `B : n×r`,
`det (A*B) = ∑_{f : Fin r → Fin n} det (A.submatrix id f) * ∏ i, B (f i) i`. -/
theorem det_mul_eq_sum_det_submatrix_mul_prod {r n : ℕ} (A : Matrix (Fin r) (Fin n) R)
    (B : Matrix (Fin n) (Fin r) R) :
    (A * B).det = ∑ f : Fin r → Fin n, (A.submatrix id f).det * ∏ i, B (f i) i := by
  simp only [Matrix.det_apply, Matrix.mul_apply, Matrix.submatrix_apply, id_eq]
  have key : ∀ σ : Equiv.Perm (Fin r),
      (∏ i, ∑ j, A (σ i) j * B j i)
        = ∑ f : Fin r → Fin n, (∏ i, A (σ i) (f i)) * (∏ i, B (f i) i) := by
    intro σ
    rw [Finset.prod_univ_sum]
    rw [show (Fintype.piFinset (fun _ : Fin r => (Finset.univ : Finset (Fin n))))
          = (Finset.univ : Finset (Fin r → Fin n)) by ext f; simp]
    apply Finset.sum_congr rfl
    intro f _
    rw [Finset.prod_mul_distrib]
  simp only [key]
  simp only [Finset.smul_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro f _
  apply Finset.sum_congr rfl
  intro σ _
  rw [smul_mul_assoc]

omit [Nontrivial R] in
/-- **Cauchy–Binet formula** (transposed function form): for `A : r×n` and `B : n×r`,
`det (A*B) = ∑_{f : Fin r → Fin n} (∏ i, A i (f i)) * det (B.submatrix f id)`. -/
theorem det_mul_eq_sum_prod_mul_det_submatrix {r n : ℕ} (A : Matrix (Fin r) (Fin n) R)
    (B : Matrix (Fin n) (Fin r) R) :
    (A * B).det = ∑ f : Fin r → Fin n, (∏ i, A i (f i)) * (B.submatrix f id).det := by
  have h := det_mul_eq_sum_det_submatrix_mul_prod Bᵀ Aᵀ
  rw [← Matrix.transpose_mul, Matrix.det_transpose] at h
  rw [h]
  apply Finset.sum_congr rfl
  intro f _
  rw [mul_comm]
  congr 1
  rw [← Matrix.det_transpose (B.submatrix f id)]
  congr 1

/-- The set of `r` admitting a nonzero `r×r` minor. -/
def rankSet {m n : ℕ} (φ : Matrix (Fin n) (Fin m) R) : Set ℕ :=
  {r | ∃ (rows : Fin r → Fin n) (cols : Fin r → Fin m), (φ.submatrix rows cols).det ≠ 0}

omit [Nontrivial R] in
/-- The rank is the supremum of the set of sizes admitting a nonzero minor. -/
theorem rank_eq_sSup {m n : ℕ} (φ : Matrix (Fin n) (Fin m) R) :
    rank φ = sSup (rankSet φ) := rfl

/-- `0` always admits a nonzero minor: the empty determinant is `1`. -/
theorem zero_mem_rankSet {m n : ℕ} (φ : Matrix (Fin n) (Fin m) R) :
    0 ∈ rankSet φ := by
  refine ⟨Fin.elim0, Fin.elim0, ?_⟩
  simp [Matrix.det_fin_zero]

omit [Nontrivial R] in
/-- A size admitting a nonzero minor is at most the number of rows. -/
theorem rankSet_le_n {m n r : ℕ} (φ : Matrix (Fin n) (Fin m) R)
    (h : r ∈ rankSet φ) : r ≤ n := by
  obtain ⟨rows, cols, hdet⟩ := h
  have hinj : Function.Injective rows := by
    by_contra hni
    rw [Function.not_injective_iff] at hni
    obtain ⟨a, b, hab, hne⟩ := hni
    apply hdet
    apply Matrix.det_zero_of_row_eq hne
    funext j
    simp [Matrix.submatrix_apply, hab]
  simpa using Fintype.card_le_of_injective rows hinj

omit [Nontrivial R] in
/-- A size admitting a nonzero minor is at most the number of columns. -/
theorem rankSet_le_m {m n r : ℕ} (φ : Matrix (Fin n) (Fin m) R)
    (h : r ∈ rankSet φ) : r ≤ m := by
  obtain ⟨rows, cols, hdet⟩ := h
  have hinj : Function.Injective cols := by
    by_contra hni
    rw [Function.not_injective_iff] at hni
    obtain ⟨a, b, hab, hne⟩ := hni
    apply hdet
    apply Matrix.det_zero_of_column_eq hne
    intro j
    simp [Matrix.submatrix_apply, hab]
  simpa using Fintype.card_le_of_injective cols hinj

omit [Nontrivial R] in
/-- The set of sizes admitting a nonzero minor is bounded above. -/
theorem rankSet_bddAbove {m n : ℕ} (φ : Matrix (Fin n) (Fin m) R) :
    BddAbove (rankSet φ) :=
  ⟨n, fun _ h => rankSet_le_n φ h⟩

/-- The rank itself admits a nonzero minor, so the supremum is attained. -/
theorem rank_mem_rankSet {m n : ℕ} (φ : Matrix (Fin n) (Fin m) R) :
    rank φ ∈ rankSet φ :=
  Nat.sSup_mem ⟨0, zero_mem_rankSet φ⟩ (rankSet_bddAbove φ)

omit [Nontrivial R] in
/-- Any size admitting a nonzero minor is at most the rank. -/
theorem le_rank {m n r : ℕ} (φ : Matrix (Fin n) (Fin m) R)
    (h : r ∈ rankSet φ) : r ≤ rank φ :=
  le_csSup (rankSet_bddAbove φ) h

/-- A bound valid for every size admitting a nonzero minor bounds the rank. -/
theorem rank_le {m n : ℕ} (φ : Matrix (Fin n) (Fin m) R) {b : ℕ}
    (hb : ∀ r ∈ rankSet φ, r ≤ b) : rank φ ≤ b :=
  csSup_le ⟨0, zero_mem_rankSet φ⟩ hb

/-- The rank is at most the number of rows. -/
theorem rank_le_n {m n : ℕ} (φ : Matrix (Fin n) (Fin m) R) :
    rank φ ≤ n := rank_le φ (fun _ h => rankSet_le_n φ h)

/-- The rank is at most the number of columns. -/
theorem rank_le_m {m n : ℕ} (φ : Matrix (Fin n) (Fin m) R) :
    rank φ ≤ m := rank_le φ (fun _ h => rankSet_le_m φ h)

omit [Nontrivial R] in
/-- If every `r×r` minor of `φ` (for the specific `r`) vanishes, then `r ∉ rankSet`. -/
theorem not_mem_rankSet {m n r : ℕ} (φ : Matrix (Fin n) (Fin m) R)
    (h : ∀ (rows : Fin r → Fin n) (cols : Fin r → Fin m), (φ.submatrix rows cols).det = 0) :
    r ∉ rankSet φ := by
  intro ⟨rows, cols, hne⟩
  exact hne (h rows cols)

omit [Nontrivial R] in
/-- If `r` is strictly greater than `rank φ`, then every `r×r` minor of `φ` vanishes. -/
theorem minor_eq_zero_of_rank_lt {m n r : ℕ} (φ : Matrix (Fin n) (Fin m) R)
    (hr : rank φ < r) (rows : Fin r → Fin n) (cols : Fin r → Fin m) :
    (φ.submatrix rows cols).det = 0 := by
  by_contra hne
  have : r ∈ rankSet φ := ⟨rows, cols, hne⟩
  exact absurd (le_rank φ this) (not_le.mpr hr)

omit [Nontrivial R] in
/-- An `r×r` minor of `A*φ` expands as a combination of `r×r` minors of `φ`. -/
theorem minor_mul_left {m n r : ℕ} (A : Matrix (Fin n) (Fin n) R)
    (φ : Matrix (Fin n) (Fin m) R) (ρ : Fin r → Fin n) (γ : Fin r → Fin m) :
    ((A * φ).submatrix ρ γ).det
      = ∑ f : Fin r → Fin n, (∏ i, A (ρ i) (f i)) * (φ.submatrix f γ).det := by
  have hsub : (A * φ).submatrix ρ γ = (A.submatrix ρ id) * (φ.submatrix id γ) := by
    have := Matrix.submatrix_mul_equiv A φ ρ (Equiv.refl (Fin n)) γ
    simpa using this.symm
  rw [hsub, det_mul_eq_sum_prod_mul_det_submatrix]
  apply Finset.sum_congr rfl
  intro f _
  rfl

omit [Nontrivial R] in
/-- An `r×r` minor of `φ*B` expands as a combination of `r×r` minors of `φ`. -/
theorem minor_mul_right {m n r : ℕ} (φ : Matrix (Fin n) (Fin m) R)
    (B : Matrix (Fin m) (Fin m) R) (ρ : Fin r → Fin n) (γ : Fin r → Fin m) :
    ((φ * B).submatrix ρ γ).det
      = ∑ g : Fin r → Fin m, (φ.submatrix ρ g).det * (∏ i, B (g i) (γ i)) := by
  have hsub : (φ * B).submatrix ρ γ = (φ.submatrix ρ id) * (B.submatrix id γ) := by
    have := Matrix.submatrix_mul_equiv φ B ρ (Equiv.refl (Fin m)) γ
    simpa using this.symm
  rw [hsub, det_mul_eq_sum_det_submatrix_mul_prod]
  apply Finset.sum_congr rfl
  intro g _
  rfl

/-- Left multiplication does not increase the rank. -/
theorem rank_mul_left_le {m n : ℕ} (A : Matrix (Fin n) (Fin n) R)
    (φ : Matrix (Fin n) (Fin m) R) : rank (A * φ) ≤ rank φ := by
  apply rank_le
  intro r hr
  by_contra hlt
  push Not at hlt
  refine not_mem_rankSet (A * φ) ?_ hr
  intro rows cols
  rw [minor_mul_left]
  apply Finset.sum_eq_zero
  intro f _
  rw [minor_eq_zero_of_rank_lt φ hlt f cols, mul_zero]

/-- Right multiplication does not increase the rank. -/
theorem rank_mul_right_le {m n : ℕ} (φ : Matrix (Fin n) (Fin m) R)
    (B : Matrix (Fin m) (Fin m) R) : rank (φ * B) ≤ rank φ := by
  apply rank_le
  intro r hr
  by_contra hlt
  push Not at hlt
  refine not_mem_rankSet (φ * B) ?_ hr
  intro rows cols
  rw [minor_mul_right]
  apply Finset.sum_eq_zero
  intro g _
  rw [minor_eq_zero_of_rank_lt φ hlt rows g, zero_mul]

/-- Rank is invariant under multiplication by invertible matrices on both sides:
if `A`, `B` are invertible then `rank (A*φ*B) = rank φ`. -/
theorem rank_conj_eq {m n : ℕ} (A : Matrix (Fin n) (Fin n) R)
    (Ainv : Matrix (Fin n) (Fin n) R) (φ : Matrix (Fin n) (Fin m) R)
    (B : Matrix (Fin m) (Fin m) R)
    (Binv : Matrix (Fin m) (Fin m) R)
    (hA : Ainv * A = 1) (hB : B * Binv = 1) :
    rank (A * φ * B) = rank φ := by
  apply le_antisymm
  · calc rank (A * φ * B) ≤ rank (A * φ) := rank_mul_right_le _ _
      _ ≤ rank φ := rank_mul_left_le _ _
  · have hphi : φ = Ainv * (A * φ * B) * Binv := by
      have h2 : Ainv * (A * φ * B) * Binv = (Ainv * A) * φ * (B * Binv) := by
        simp only [Matrix.mul_assoc]
      rw [h2, hA, hB, Matrix.one_mul, Matrix.mul_one]
    calc rank φ = rank (Ainv * (A * φ * B) * Binv) := by rw [← hphi]
      _ ≤ rank (Ainv * (A * φ * B)) := rank_mul_right_le _ _
      _ ≤ rank (A * φ * B) := rank_mul_left_le _ _

end Helpers

/-! ## Invariance under an isomorphism of complexes

The ranks `rank (· .d k)`, the integers `rIndex` and the ideals `minorIdeal (· .d k)` are
invariant under an isomorphism of complexes. -/

section Reduction

open Matrix

/-- **Dimension matching.** A `ComplexIso C D` carries, in each degree `i`, mutually
inverse matrices `ψ i : D.n i × C.n i` and `ψinv i : C.n i × D.n i`. Over a nontrivial
commutative ring, the existence of mutually inverse rectangular matrices forces the
two index sets to have equal cardinality, hence `C.n i = D.n i`. -/
theorem dim_eq_of_iso {C D : Complex R e} (φ : ComplexIso C D) (i : ℕ) :
    C.n i = D.n i := by
  apply eq_of_fin_equiv R
  exact
  { toFun := fun v => φ.ψ i *ᵥ v
    map_add' := by intro x y; simp [Matrix.mulVec_add]
    map_smul' := by intro c x; simp [Matrix.mulVec_smul]
    invFun := fun w => φ.ψinv i *ᵥ w
    left_inv := by
      intro v
      show φ.ψinv i *ᵥ (φ.ψ i *ᵥ v) = v
      rw [Matrix.mulVec_mulVec, φ.left i, Matrix.one_mulVec]
    right_inv := by
      intro w
      show φ.ψ i *ᵥ (φ.ψinv i *ᵥ w) = w
      rw [Matrix.mulVec_mulVec, φ.right i, Matrix.one_mulVec] }

omit [Nontrivial R] in
/-- Reindexing the row/column index sets by arbitrary bijections (possibly between
different cardinalities) does not change the `rankSet`. -/
theorem rankSet_submatrix_equiv {m n m' n' : ℕ}
    (φ : Matrix (Fin n) (Fin m) R) (eₙ : Fin n' ≃ Fin n) (eₘ : Fin m' ≃ Fin m) :
    rankSet (φ.submatrix eₙ eₘ) = rankSet φ := by
  ext r
  constructor
  · rintro ⟨rows, cols, hdet⟩
    exact ⟨eₙ ∘ rows, eₘ ∘ cols, by rwa [← Matrix.submatrix_submatrix]⟩
  · rintro ⟨rows, cols, hdet⟩
    refine ⟨eₙ.symm ∘ rows, eₘ.symm ∘ cols, ?_⟩
    rwa [Matrix.submatrix_submatrix, ← Function.comp_assoc, ← Function.comp_assoc,
      Equiv.self_comp_symm, Equiv.self_comp_symm, Function.id_comp, Function.id_comp]

omit [Nontrivial R] in
/-- Reindexing the row/column index sets by arbitrary bijections (possibly between
different cardinalities) does not change the `rankSet`, hence not the `rank`. -/
theorem rank_submatrix_equiv {m n m' n' : ℕ}
    (φ : Matrix (Fin n) (Fin m) R) (eₙ : Fin n' ≃ Fin n) (eₘ : Fin m' ≃ Fin m) :
    rank (φ.submatrix eₙ eₘ) = rank φ := by
  rw [rank_eq_sSup, rank_eq_sSup, rankSet_submatrix_equiv]

omit [Nontrivial R] in
/-- Reindexing the row/column index sets by arbitrary bijections (possibly between
different cardinalities) does not change the `minorIdeal`. -/
theorem minorIdeal_submatrix_equiv {m n m' n' : ℕ}
    (φ : Matrix (Fin n) (Fin m) R) (eₙ : Fin n' ≃ Fin n) (eₘ : Fin m' ≃ Fin m) :
    minorIdeal (φ.submatrix eₙ eₘ) = minorIdeal φ := by
  unfold minorIdeal
  set g : Fin (rank φ) ≃ Fin (rank (φ.submatrix eₙ eₘ)) :=
    finCongr (rank_submatrix_equiv φ eₙ eₘ).symm
  congr 1
  ext x
  constructor
  · rintro ⟨rows, cols, rfl⟩
    refine ⟨fun i => eₙ (rows (g i)), fun i => eₘ (cols (g i)), ?_⟩
    have heq : φ.submatrix (fun i => eₙ (rows (g i))) (fun i => eₘ (cols (g i)))
        = ((φ.submatrix eₙ eₘ).submatrix rows cols).submatrix g g := by
      rw [Matrix.submatrix_submatrix, Matrix.submatrix_submatrix]
      rfl
    rw [heq, Matrix.det_submatrix_equiv_self g]
  · rintro ⟨rows, cols, rfl⟩
    refine ⟨fun i => eₙ.symm (rows (g.symm i)), fun i => eₘ.symm (cols (g.symm i)), ?_⟩
    have heq : (φ.submatrix eₙ eₘ).submatrix (fun i => eₙ.symm (rows (g.symm i)))
        (fun i => eₘ.symm (cols (g.symm i)))
        = (φ.submatrix rows cols).submatrix g.symm g.symm := by
      rw [Matrix.submatrix_submatrix]
      congr 1 <;> · ext i; simp
    rw [heq, Matrix.det_submatrix_equiv_self g.symm]

/-- `rIndex` is preserved by an isomorphism of complexes. -/
theorem rIndex_eq_of_iso {C D : Complex R e} (φ : ComplexIso C D) (i : ℕ) :
    rIndex C i = rIndex D i := by
  unfold rIndex
  apply Finset.sum_congr rfl
  intro l _
  rw [dim_eq_of_iso φ l]

/-- An isomorphism of complexes writes `C.d k`, reindexed to the cardinalities of `D`, as
`A * D.d k * B` with `A` and `B` invertible. -/
private theorem exists_conj_of_iso {C D : Complex R e} (φ : ComplexIso C D) (k : ℕ) :
    ∃ (e1 : Fin (D.n k) ≃ Fin (C.n k)) (e2 : Fin (D.n (k + 1)) ≃ Fin (C.n (k + 1)))
      (A Ainv : Matrix (Fin (D.n k)) (Fin (D.n k)) R)
      (B Binv : Matrix (Fin (D.n (k + 1))) (Fin (D.n (k + 1))) R),
      Ainv * A = 1 ∧ B * Binv = 1 ∧ (C.d k).submatrix e1 e2 = A * D.d k * B := by
  have hCd : C.d k = φ.ψinv k * D.d k * φ.ψ (k + 1) := by
    have h := φ.comm k
    have := congrArg (fun M => φ.ψinv k * M) h
    simp only [← Matrix.mul_assoc] at this
    rw [φ.left k, Matrix.one_mul] at this
    exact this.symm
  set e1 : Fin (D.n k) ≃ Fin (C.n k) := finCongr (dim_eq_of_iso φ k).symm
  set e2 : Fin (D.n (k + 1)) ≃ Fin (C.n (k + 1)) := finCongr (dim_eq_of_iso φ (k + 1)).symm
  refine ⟨e1, e2, (φ.ψinv k).submatrix e1 (Equiv.refl _), (φ.ψ k).submatrix (Equiv.refl _) e1,
    (φ.ψ (k + 1)).submatrix (Equiv.refl _) e2, (φ.ψinv (k + 1)).submatrix e2 (Equiv.refl _),
    ?_, ?_, ?_⟩
  · rw [Matrix.submatrix_mul_equiv (φ.ψ k) (φ.ψinv k) (Equiv.refl _) e1 (Equiv.refl _), φ.right k]
    simp
  · rw [Matrix.submatrix_mul_equiv (φ.ψ (k + 1)) (φ.ψinv (k + 1)) (Equiv.refl _) e2
      (Equiv.refl _), φ.right (k + 1)]
    simp
  · rw [hCd, ← Matrix.submatrix_mul_equiv (φ.ψinv k * D.d k) (φ.ψ (k + 1)) e1 (Equiv.refl _) e2,
      ← Matrix.submatrix_mul_equiv (φ.ψinv k) (D.d k) e1 (Equiv.refl _) (Equiv.refl _)]
    simp

/-- **Rank invariance.** An isomorphism of complexes preserves the rank of each differential:
`C.d k = ψinv k * D.d k * ψ (k+1)` with both outer factors invertible. -/
theorem rank_eq_of_iso {C D : Complex R e} (φ : ComplexIso C D) (k : ℕ) :
    rank (C.d k) = rank (D.d k) := by
  obtain ⟨e1, e2, A, Ainv, B, Binv, hAA, hBB, hCd⟩ := exists_conj_of_iso φ k
  rw [← rank_submatrix_equiv (C.d k) e1 e2, hCd, rank_conj_eq A Ainv (D.d k) B Binv hAA hBB]

/-- **Minor-ideal invariance under left multiplication by an invertible.**
If `A` is invertible (`Ainv * A = 1`) then `minorIdeal (A * φ) = minorIdeal φ`. -/
theorem minorIdeal_mul_left {m n : ℕ} (A : Matrix (Fin n) (Fin n) R)
    (Ainv : Matrix (Fin n) (Fin n) R) (φ : Matrix (Fin n) (Fin m) R)
    (hA : Ainv * A = 1) :
    minorIdeal (A * φ) = minorIdeal φ := by
  have hrk : rank (A * φ) = rank φ := by
    have h := rank_conj_eq A Ainv φ (1 : Matrix (Fin m) (Fin m) R) 1 hA (by simp)
    rwa [Matrix.mul_one] at h
  have hphi : φ = Ainv * (A * φ) := by
    rw [← Matrix.mul_assoc, hA, Matrix.one_mul]
  set r := rank φ
  have hset₁ : {x : R | ∃ (rows : Fin (rank (A * φ)) → Fin n)
      (cols : Fin (rank (A * φ)) → Fin m), x = ((A * φ).submatrix rows cols).det}
      = {x : R | ∃ (rows : Fin r → Fin n) (cols : Fin r → Fin m),
        x = ((A * φ).submatrix rows cols).det} := by
    rw [hrk]
  unfold minorIdeal
  rw [hset₁]
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro x ⟨ρ, γ, rfl⟩
    rw [minor_mul_left A φ ρ γ]
    exact Ideal.sum_mem _ fun f _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨f, γ, rfl⟩)
  · rw [Ideal.span_le]
    rintro x ⟨ρ, γ, rfl⟩
    rw [show φ.submatrix ρ γ = (Ainv * (A * φ)).submatrix ρ γ by rw [← hphi],
      minor_mul_left Ainv (A * φ) ρ γ]
    exact Ideal.sum_mem _ fun f _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨f, γ, rfl⟩)

/-- **Minor-ideal invariance under right multiplication by an invertible.** If `B` is
invertible then `minorIdeal (φ * B) = minorIdeal φ`. -/
theorem minorIdeal_mul_right {m n : ℕ} (φ : Matrix (Fin n) (Fin m) R)
    (B : Matrix (Fin m) (Fin m) R) (Binv : Matrix (Fin m) (Fin m) R)
    (hB : B * Binv = 1) :
    minorIdeal (φ * B) = minorIdeal φ := by
  have hrk : rank (φ * B) = rank φ := by
    have h := rank_conj_eq (1 : Matrix (Fin n) (Fin n) R) 1 φ B Binv (by simp) hB
    rwa [Matrix.one_mul] at h
  have hphi : φ = (φ * B) * Binv := by
    rw [Matrix.mul_assoc, hB, Matrix.mul_one]
  set r := rank φ
  have hset₁ : {x : R | ∃ (rows : Fin (rank (φ * B)) → Fin n)
      (cols : Fin (rank (φ * B)) → Fin m), x = ((φ * B).submatrix rows cols).det}
      = {x : R | ∃ (rows : Fin r → Fin n) (cols : Fin r → Fin m),
        x = ((φ * B).submatrix rows cols).det} := by
    rw [hrk]
  unfold minorIdeal
  rw [hset₁]
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro x ⟨ρ, γ, rfl⟩
    rw [minor_mul_right φ B ρ γ]
    exact Ideal.sum_mem _ fun g _ => Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨ρ, g, rfl⟩)
  · rw [Ideal.span_le]
    rintro x ⟨ρ, γ, rfl⟩
    rw [show φ.submatrix ρ γ = ((φ * B) * Binv).submatrix ρ γ by rw [← hphi],
      minor_mul_right (φ * B) Binv ρ γ]
    exact Ideal.sum_mem _ fun g _ => Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨ρ, g, rfl⟩)

/-- **Minor-ideal invariance under an isomorphism of complexes.** An isomorphism of complexes
preserves the ideal of minors of each differential. -/
theorem minorIdeal_eq_of_iso {C D : Complex R e} (φ : ComplexIso C D) (k : ℕ) :
    minorIdeal (C.d k) = minorIdeal (D.d k) := by
  obtain ⟨e1, e2, A, Ainv, B, Binv, hAA, hBB, hCd⟩ := exists_conj_of_iso φ k
  rw [← minorIdeal_submatrix_equiv (C.d k) e1 e2, hCd, Matrix.mul_assoc,
    minorIdeal_mul_left A Ainv (D.d k * B) hAA,
    minorIdeal_mul_right (D.d k) B Binv hBB]

end Reduction

end StacksComplex
