/-!
# Multiplying a tall matrix by the adjugate of its top square block

Fix a commutative ring `R` and natural numbers `m, n` with `n ≥ m ≥ 1`, and let
`A = (aᵢⱼ)` be an `n × m` matrix over `R`. Write `A` in block form `A = (A₁; A₂)`, where
`A₁` consists of the first `m` rows of `A` and `A₂` of the remaining `n - m` rows. Let
`B = adj(A₁)` be the adjugate (the transpose of the cofactor matrix) of `A₁` and let
`f = det(A₁)`, so that `A₁ * adj(A₁) = adj(A₁) * A₁ = det(A₁) • 1`.

For `m + 1 ≤ i ≤ n` and `1 ≤ j ≤ m` let `Mᵢⱼ` be the `m × m` matrix whose rows are, in
order, the rows `1, …, ĵ, …, m, i` of `A` — the first `m` rows with row `j` removed,
followed by row `i` — and whose columns are all `m` columns of `A`.

## Main results

The `n × m` product `A * B` has the block form `A * B = (f • 1ₘ; C)`:

1. (Top block.) For all `1 ≤ i, j ≤ m` we have `(A * B)ᵢⱼ = f * δᵢⱼ`, i.e. the top
   `m × m` block of `A * B` is `A₁ * B = f • 1ₘ`.
2. (Bottom block.) For all `m + 1 ≤ i ≤ n` and `1 ≤ j ≤ m` we have
   `(A * B)ᵢⱼ = (-1) ^ (m - j) * det (Mᵢⱼ)`.

This is Stacks Lemma 10.15.6, tag `080R`.

## Conventions

* Sizes are indexed by a natural number `m₀`, and the number of columns of `A` is
  `m = m₀ + 1`. This encodes the hypothesis `m ≥ 1` and makes deleting a row expressible
  (working with `Fin (m₀ + 1)` and `Fin.succAbove`). The hypothesis `n ≥ m` becomes
  `m₀ + 1 ≤ n`.
* `Fin` is `0`-indexed, so a column index `j : Fin (m₀ + 1)` corresponds to the `1`-indexed
  index `j + 1`, and the sign `(-1) ^ (m - j)` of the source becomes
  `(-1) ^ ((m₀ + 1) - (j + 1)) = (-1) ^ (m₀ - j)`.
* The adjugate is `Matrix.adjugate`, the transpose of the cofactor matrix; it satisfies
  `A * A.adjugate = A.det • 1` (`Matrix.mul_adjugate`).
* The minor `Mᵢⱼ` is built by selecting `m₀ + 1` rows of `A`: the last selected row is
  row `i`, and the first `m₀` are the first `m₀ + 1` rows of `A` with row `j` deleted, in
  increasing order, realized via `Fin.succAbove j`.
-/

@[expose] public section

open Matrix

variable {R : Type*} [CommRing R] {m₀ n : ℕ}

/-- The ordered list of `m₀ + 1` row indices of `A` used to form the minor
`M_{i j}`: the last row is row `i`, and the first `m₀` rows are the first
`m₀ + 1` rows of `A` with row `j` removed (in increasing order). -/
def minorRows (hmn : m₀ + 1 ≤ n) (i : Fin n) (j : Fin (m₀ + 1)) :
    Fin (m₀ + 1) → Fin n :=
  Fin.lastCases i (fun k => Fin.castLE hmn (j.succAbove k))

/-- The `m × m` minor `M_{i j}` of `A` (with `m = m₀ + 1`): the matrix whose
rows are, in order, rows `1, …, ĵ, …, m, i` of `A`, and whose columns are all
`m` columns of `A`. -/
def minorMat (hmn : m₀ + 1 ≤ n) (A : Matrix (Fin n) (Fin (m₀ + 1)) R)
    (i : Fin n) (j : Fin (m₀ + 1)) : Matrix (Fin (m₀ + 1)) (Fin (m₀ + 1)) R :=
  A.submatrix (minorRows hmn i j) id

/-- The top block `A₁` of `A`: the `m × m` matrix consisting of the first `m`
rows of `A` (with `m = m₀ + 1`). -/
def topBlock (hmn : m₀ + 1 ≤ n) (A : Matrix (Fin n) (Fin (m₀ + 1)) R) :
    Matrix (Fin (m₀ + 1)) (Fin (m₀ + 1)) R :=
  A.submatrix (Fin.castLE hmn) id

/-- Determinant of a row-update of a sum over a finset distributes as a sum. -/
theorem det_updateRow_finset_sum {m : ℕ}
    (A : Matrix (Fin m) (Fin m) R) (j : Fin m) (s : Finset (Fin m))
    (w : Fin m → (Fin m → R)) :
    (A.updateRow j (∑ k ∈ s, w k)).det = ∑ k ∈ s, (A.updateRow j (w k)).det := by
  induction s using Finset.induction with
  | empty =>
    simp only [Finset.sum_empty]
    have : (0 : Fin m → R) = (0 : R) • (0 : Fin m → R) := by simp
    rw [this, Matrix.det_updateRow_smul, zero_mul]
  | insert a s ha ih =>
    rw [Finset.sum_insert ha, Finset.sum_insert ha, Matrix.det_updateRow_add, ih]

/-- Linearity of the determinant in the `j`-th row, expanded over single-entry
rows. -/
theorem det_updateRow_linear {m : ℕ}
    (A : Matrix (Fin m) (Fin m) R) (j : Fin m) (v : Fin m → R) :
    (A.updateRow j v).det = ∑ k, v k * (A.updateRow j (Pi.single k 1)).det := by
  have hv : v = ∑ k, (fun k => v k • (Pi.single k 1 : Fin m → R)) k := by
    funext x
    simp only [Finset.sum_apply, Pi.smul_apply, Pi.single_apply, smul_eq_mul]
    rw [Finset.sum_eq_single x]
    · simp
    · intro b _ hb
      rw [ite_eq_right (by simpa [eq_comm] using hb), mul_zero]
    · simp
  conv_lhs => rw [hv]
  rw [det_updateRow_finset_sum]
  apply Finset.sum_congr rfl
  intro k _
  rw [Matrix.det_updateRow_smul]

/-- `(A * adjugate B)_{i j}` equals the determinant of `B` with its `j`-th row
replaced by the `i`-th row of `A`. -/
theorem ab_eq_det_updateRow
    (A : Matrix (Fin n) (Fin (m₀ + 1)) R)
    (i : Fin n) (j : Fin (m₀ + 1)) (B : Matrix (Fin (m₀ + 1)) (Fin (m₀ + 1)) R) :
    (A * B.adjugate) i j = (B.updateRow j (fun k => A i k)).det := by
  rw [det_updateRow_linear, Matrix.mul_apply]
  apply Finset.sum_congr rfl
  intro k _
  rw [Matrix.adjugate_apply]

/-- The determinant of `A₁` with its `j`-th row replaced by the `i`-th row of `A`
equals `(-1)^{m₀ - j}` times the determinant of the minor `M_{i j}`. This is
proved by cofactor expansion of both determinants: the row-updated matrix is
expanded along its `j`-th row, while `M_{i j}` is expanded along its last row.
Both expansions share the same minors (rows of `A₁` with row `j` deleted), so the
two determinants differ only by the sign `(-1)^{m₀ - j}`. -/
theorem det_updateRow_eq (hmn : m₀ + 1 ≤ n) (A : Matrix (Fin n) (Fin (m₀ + 1)) R)
    (i : Fin n) (j : Fin (m₀ + 1)) :
    ((topBlock hmn A).updateRow j (fun k => A i k)).det
      = (-1) ^ (m₀ - (j : ℕ)) * (minorMat hmn A i j).det := by
  rw [Matrix.det_succ_row ((topBlock hmn A).updateRow j (fun k => A i k)) j]
  rw [Matrix.det_succ_row (minorMat hmn A i j) (Fin.last m₀)]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro k _
  have hUR : ((topBlock hmn A).updateRow j (fun k => A i k)) j k = A i k := by
    simp [Matrix.updateRow_self]
  have hMin : (minorMat hmn A i j) (Fin.last m₀) k = A i k := by
    simp [minorMat, minorRows, Matrix.submatrix_apply, Fin.lastCases_last]
  rw [hUR, hMin]
  have hD : ((topBlock hmn A).updateRow j (fun k => A i k)).submatrix j.succAbove
        k.succAbove
      = (minorMat hmn A i j).submatrix (Fin.last m₀).succAbove k.succAbove := by
    ext p q
    simp only [Matrix.submatrix_apply]
    rw [Fin.succAbove_last, Matrix.updateRow_ne (Fin.succAbove_ne j p)]
    simp [topBlock, minorMat, minorRows, Matrix.submatrix_apply,
      Fin.lastCases_castSucc, id]
  rw [hD]
  have hlast : (Fin.last m₀ : ℕ) = m₀ := by simp
  rw [hlast]
  have hj : (j : ℕ) ≤ m₀ := by
    have := j.isLt; omega
  have hsign : (-1 : R) ^ (j : ℕ) = (-1) ^ (m₀ - (j : ℕ)) * (-1) ^ m₀ := by
    rw [← pow_add]
    have : m₀ - (j : ℕ) + m₀ = (j : ℕ) + 2 * (m₀ - (j : ℕ)) := by omega
    rw [this, pow_add, pow_mul]
    simp
  rw [pow_add, pow_add, hsign]
  ring

-- Main Statement(s)

/-- **Top block.** With `B = adj(A₁)` and `f = det(A₁)`, the top `m × m` block of
`A * B` is `f • 1`: for all row/column indices `i, j` in the top block,
`(A * B)_{i j} = f · δ_{i j}`. -/
@[stacks 080R "top block"]
theorem ab_top_block (hmn : m₀ + 1 ≤ n) (A : Matrix (Fin n) (Fin (m₀ + 1)) R)
    (i j : Fin (m₀ + 1)) :
    (A * (topBlock hmn A).adjugate) (Fin.castLE hmn i) j
      = (topBlock hmn A).det • (1 : Matrix (Fin (m₀ + 1)) (Fin (m₀ + 1)) R) i j := by
  have h : (A * (topBlock hmn A).adjugate) (Fin.castLE hmn i) j
      = (topBlock hmn A * (topBlock hmn A).adjugate) i j := by
    simp only [Matrix.mul_apply, topBlock, Matrix.submatrix_apply, id]
  rw [h, Matrix.mul_adjugate]
  simp [Matrix.smul_apply]

/-- **Bottom block.** With `B = adj(A₁)`, for a row index `i` lying in the bottom
block (i.e. `m ≤ i`, here `m₀ + 1 ≤ i`) and any column index `j`,
`(A * B)_{i j} = (-1)^{m - j} · det(M_{i j})`. -/
@[stacks 080R "bottom block"]
theorem ab_bottom_block (hmn : m₀ + 1 ≤ n) (A : Matrix (Fin n) (Fin (m₀ + 1)) R)
    (i : Fin n) (j : Fin (m₀ + 1)) :
    (A * (topBlock hmn A).adjugate) i j
      = (-1) ^ (m₀ - (j : ℕ)) * (minorMat hmn A i j).det := by
  rw [ab_eq_det_updateRow A i j (topBlock hmn A), det_updateRow_eq hmn A i j]
