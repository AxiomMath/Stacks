/-!
# The ideal of maximal minors and one-sided inverses of a tall matrix

Let `R` be a commutative ring with unit, fix integers `n ≥ m ≥ 1`, and let `A` be an `n × m`
matrix with entries in `R`, i.e. `A = (A i j)` with row index `i ∈ {1, …, n}` and column index
`j ∈ {1, …, m}`.

## Definitions

* For a subset `I = {i₁ < i₂ < ⋯ < i_m} ⊆ {1, …, n}` of size `m`, the *row submatrix* `A_I` is
  the `m × m` matrix obtained from `A` by keeping exactly the rows indexed by `I`, in increasing
  order, and all `m` columns. The `m × m` *minors* of `A` are the determinants `det (A_I) ∈ R`,
  as `I` ranges over all `C(n, m)` size-`m` subsets.
* `J ⊆ R` is the ideal generated by the `m × m` minors of `A`.

## Main results

* For any `f ∈ J` there is an `m × n` matrix `B` over `R` with `B * A = f • 1ₘ`.
* If `f ∈ R` and `B * A = f • 1ₘ` for some `m × n` matrix `B`, then `f ^ m ∈ J`.

This is Stacks Lemma 10.15.5, tag 07DQ.

## Conventions

* "Ring" means commutative ring with `1`, following the Stacks Project. Commutativity is
  essential here: determinants, adjugate matrices and Cauchy-Binet all use it.
* Rows are indexed by `Fin n` and columns by `Fin m`. A size-`m` subset of the row index set
  `{1, …, n}`, listed in increasing order, is exactly an order embedding `r : Fin m ↪o Fin n`,
  and the associated `m × m` minor is the determinant of the row submatrix `A.submatrix r id`,
  which selects rows via `r` and keeps all columns.
-/

@[expose] public section

open Matrix

variable {R : Type*} [CommRing R] {n m : ℕ}

/-- The set of `m × m` minors of an `n × m` matrix `A`: the determinants of the
row submatrices `A.submatrix r id`, where `r : Fin m ↪o Fin n` ranges over all
order embeddings, i.e. over all size-`m` subsets of the rows listed in
increasing order. -/
def minorsSet (A : Matrix (Fin n) (Fin m) R) : Set R :=
  Set.range fun r : Fin m ↪o Fin n => (A.submatrix r id).det

/-- The ideal `J` generated by the `m × m` minors of `A`. -/
def maximalMinorsIdeal (A : Matrix (Fin n) (Fin m) R) : Ideal R :=
  Ideal.span (minorsSet A)

/-- **Statement 1.** For any `f` in the ideal `J` generated by the `m × m`
minors of `A`, there is an `m × n` matrix `B` with `B * A = f • 1` (the `m × m`
matrix `f · I_m`). -/
@[stacks 07DQ "(1)"]
theorem exists_matrix_of_mem_minorIdeal (A : Matrix (Fin n) (Fin m) R)
    (f : R) (hf : f ∈ maximalMinorsIdeal A) :
    ∃ B : Matrix (Fin m) (Fin n) R, B * A = f • (1 : Matrix (Fin m) (Fin m) R) := by
  have proj : ∀ r : Fin m ↪o Fin n,
      ((1 : Matrix (Fin n) (Fin n) R).submatrix r id) * A = A.submatrix r id := by
    intro r
    ext l j
    simp [Matrix.mul_apply, Matrix.submatrix_apply, Matrix.one_apply]
  rw [maximalMinorsIdeal, Ideal.span] at hf
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hf
  · rintro x ⟨r, rfl⟩
    refine ⟨(A.submatrix r id).adjugate * ((1 : Matrix (Fin n) (Fin n) R).submatrix r id), ?_⟩
    rw [Matrix.mul_assoc, proj, Matrix.adjugate_mul]
  · exact ⟨0, by simp⟩
  · rintro x y _ _ ⟨Bx, hx⟩ ⟨By, hy⟩
    refine ⟨Bx + By, ?_⟩
    rw [Matrix.add_mul, hx, hy, add_smul]
  · rintro a x _ ⟨Bx, hx⟩
    refine ⟨a • Bx, ?_⟩
    rw [Matrix.smul_mul, hx, smul_smul, smul_eq_mul]

/-- Any injective `g : Fin m → Fin n` factors as an order embedding followed by
a permutation of `Fin m`. -/
private theorem inj_factor (g : Fin m → Fin n) (hg : Function.Injective g) :
    ∃ (r : Fin m ↪o Fin n) (e : Equiv.Perm (Fin m)), g = r ∘ e := by
  classical
  have hcard : (Finset.univ.image g).card = m := by
    rw [Finset.card_image_of_injective _ hg, Finset.card_univ, Fintype.card_fin]
  set r := (Finset.univ.image g).orderEmbOfFin hcard
  have hgmem (i : Fin m) : g i ∈ Set.range r := by
    simp [r, Finset.range_orderEmbOfFin]
  let e0 (i : Fin m) : Fin m := (Equiv.ofInjective r r.injective).symm ⟨g i, hgmem i⟩
  have hre0 (i : Fin m) : r (e0 i) = g i := Equiv.apply_ofInjective_symm r.injective _
  have he0 : Function.Injective e0 := fun i j h => hg (by simpa only [hre0] using congrArg r h)
  exact ⟨r, Equiv.ofBijective e0 (Finite.injective_iff_bijective.mp he0),
    funext fun i => (hre0 i).symm⟩

/-- For any function `g : Fin m → Fin n`, the determinant of the row submatrix
`A.submatrix g id` lies in the minor ideal. -/
private theorem submatrix_det_mem (A : Matrix (Fin n) (Fin m) R)
    (g : Fin m → Fin n) : (A.submatrix g id).det ∈ maximalMinorsIdeal A := by
  classical
  by_cases hg : Function.Injective g
  · obtain ⟨r, e, rfl⟩ := inj_factor g hg
    rw [show A.submatrix (r ∘ e) id = (A.submatrix r id).submatrix e id from rfl,
      Matrix.det_permute]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨r, rfl⟩)
  · obtain ⟨i, j, hij, hne⟩ := Function.not_injective_iff.mp hg
    rw [Matrix.det_zero_of_row_eq hne (funext fun k => by simp [hij])]
    exact zero_mem _

/-- Cauchy–Binet expansion: `det (B * A)` as a sum over functions `g`. -/
private theorem cauchy_binet_expand (B : Matrix (Fin m) (Fin n) R)
    (A : Matrix (Fin n) (Fin m) R) :
    (B * A).det = ∑ g : Fin m → Fin n, (∏ i, B i (g i)) * (A.submatrix g id).det := by
  classical
  have detform : ∀ M : Matrix (Fin m) (Fin m) R,
      M.det = ∑ σ : Equiv.Perm (Fin m), Equiv.Perm.sign σ • ∏ i, M i (σ i) := by
    intro M
    rw [← Matrix.det_transpose M, Matrix.det_apply]
    rfl
  have step1 : ∀ σ : Equiv.Perm (Fin m),
      (∏ i, (B * A) i (σ i)) = ∑ g : Fin m → Fin n, ∏ i, B i (g i) * A (g i) (σ i) := by
    intro σ
    simp_rw [Matrix.mul_apply]
    rw [Finset.prod_univ_sum, Fintype.piFinset_univ]
  rw [detform (B * A)]
  simp_rw [step1, Finset.smul_sum]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun g _ => ?_
  simp_rw [Finset.prod_mul_distrib]
  rw [detform (A.submatrix g id), Finset.mul_sum]
  refine Finset.sum_congr rfl fun σ _ => ?_
  simp only [Matrix.submatrix_apply, id_eq]
  rw [mul_smul_comm]

/-- **Statement 2.** If `B * A = f • 1` for some `m × n` matrix `B`, then
`f ^ m` lies in the ideal `J` generated by the `m × m` minors of `A`. -/
@[stacks 07DQ "(2)"]
theorem pow_mem_minorIdeal_of_matrix (A : Matrix (Fin n) (Fin m) R)
    (f : R) (B : Matrix (Fin m) (Fin n) R)
    (hB : B * A = f • (1 : Matrix (Fin m) (Fin m) R)) :
    f ^ m ∈ maximalMinorsIdeal A := by
  classical
  have hpow : f ^ m = (B * A).det := by
    rw [hB, Matrix.det_smul, Matrix.det_one, mul_one, Fintype.card_fin]
  rw [hpow, cauchy_binet_expand]
  exact Ideal.sum_mem _ fun g _ => Ideal.mul_mem_left _ _ (submatrix_det_mem A g)

