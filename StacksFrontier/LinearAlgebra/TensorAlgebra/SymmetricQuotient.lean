module

public import Mathlib.LinearAlgebra.DFinsupp
public import StacksFrontier.LinearAlgebra.SymmetricPower.Presentation
public import StacksFrontier.LinearAlgebra.TensorAlgebra.SemilinearMap
public import StacksFrontier.LinearAlgebra.TensorAlgebra.ToTensorPowerRange
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The symmetric power of a module as a quotient of its tensor power

Let `R` be a commutative ring and `M` an `R`-module. The canonical surjection
`TensorAlgebra R M ⟶ SymmetricAlgebra R M` restricts in each degree to a surjection

`Tⁿ(M) = TensorAlgebra.gradedPiece R n M ⟶ Symⁿ(M) = SymPow.symmetricPower n R M`,

and this file computes its kernel: it is the sum, over the `n - 1` ways of writing
`n = i + 2 + j`, of the ranges of the `R`-linear endomorphisms

`Tⁱ(M) ⊗ T²(M) ⊗ Tʲ(M) ∋ u ⊗ w ⊗ v ↦ u · (w - σ w) · v`

of `Tⁿ(M)`, where `σ` transposes the two slots of `T²(M)`. This holds over every commutative
ring, with no hypothesis on `M`, and the relator maps commute with base change along semilinear
maps.

## Main definitions

* `TensorAlgebra.commSub`: the submodule of `T(M)` spanned by the commutators
  `ι x · ι y - ι y · ι x` of degree-one generators.
* `TensorAlgebra.symSub`: the two-sided ideal `⊤ * commSub * ⊤` they generate, which is the
  kernel of `SymmetricAlgebra.algHom`.
* `TensorAlgebra.relSub i j`: the degree-`i + 2 + j` relators `Tⁱ · commSub · Tʲ`.
* `TensorAlgebra.swapTwo` and `TensorAlgebra.altTwo`: the transposition of the two slots of
  `T²(M)`, and `𝟙 - swapTwo`.
* `TensorAlgebra.relMap h` for `h : i + 2 + j = k`, and `TensorAlgebra.slotRelMap k p` for
  `p : Fin (k - 1)`: the slot-wise relator endomorphisms of `Tᵏ(M)`.
* `TensorAlgebra.symQuot k`: the surjection `Tᵏ(M) ⟶ Symᵏ(M)`.

## Main results

* `TensorAlgebra.mem_symSub_iff`: `x` lies in the commutator ideal if and only if it dies in the
  symmetric algebra.
* `TensorAlgebra.surjective_symQuot`: `Tᵏ(M) ⟶ Symᵏ(M)` is surjective.
* `TensorAlgebra.symQuot_relMap`: the relator maps land in the kernel.
* `TensorAlgebra.ker_symQuot`: **the kernel of `Tᵏ(M) ⟶ Symᵏ(M)` is the sum of the ranges of
  the `k - 1` slot-wise relator maps.**
* `TensorAlgebra.exists_sum_slotRelMap`: the same, elementwise — an element of the kernel is a
  sum of values of the relator maps, one summand per adjacent slot pair.

## References

* [Stacks Project, Tag 00DP](https://stacks.math.columbia.edu/tag/00DP)
* [Stacks Project, Section 17.21](https://stacks.math.columbia.edu/tag/01CF)
-/

@[expose] public noncomputable section

open scoped TensorProduct

namespace TensorAlgebra

variable {R : Type*} [CommRing R] {M : Type*} [AddCommGroup M] [Module R M]

/-! ### The commutator ideal -/

section Commutators

variable (R M)

/-- The submodule of the tensor algebra spanned by the commutators of degree-one generators. -/
def commSub : Submodule R (TensorAlgebra R M) :=
  Submodule.span R (Set.range fun p : M × M ↦ ι R p.1 * ι R p.2 - ι R p.2 * ι R p.1)

/-- The two-sided ideal of the tensor algebra generated by the commutators of degree-one
generators. -/
@[ega "II 1.7.1" "defining two-sided ideal"]
def symSub : Submodule R (TensorAlgebra R M) := ⊤ * commSub R M * ⊤

variable {R M}

/-- The commutator `ι x · ι y - ι y · ι x` of two degree-one generators lies in `commSub`. -/
theorem commutator_mem_commSub (x y : M) :
    ι R x * ι R y - ι R y * ι R x ∈ commSub R M :=
  Submodule.subset_span ⟨(x, y), rfl⟩

/-- The commutators of degree-one generators are homogeneous of degree two. -/
theorem commSub_le_gradedPiece_two : commSub R M ≤ gradedPiece R 2 M := by
  rw [commSub, Submodule.span_le]
  rintro _ ⟨⟨x, y⟩, rfl⟩
  refine Submodule.sub_mem _ ?_ ?_ <;>
    exact mul_mem_gradedPiece (ι_mem_gradedPiece _) (ι_mem_gradedPiece _)

/-- The commutators lie in the ideal they generate. -/
theorem commSub_le_symSub : commSub R M ≤ symSub R M := fun g hg ↦ by
  have h : (1 : TensorAlgebra R M) * g * 1 ∈ symSub R M :=
    Submodule.mul_mem_mul (Submodule.mul_mem_mul Submodule.mem_top hg) Submodule.mem_top
  simpa using h

/-- The commutator ideal is closed under multiplication on the left. -/
theorem mul_mem_symSub_left (t : TensorAlgebra R M) {x : TensorAlgebra R M}
    (hx : x ∈ symSub R M) : t * x ∈ symSub R M := by
  rw [symSub] at hx ⊢
  refine Submodule.mul_induction_on hx (fun a ha v hv ↦ ?_)
    (fun x y hx hy ↦ by rw [mul_add]; exact Submodule.add_mem _ hx hy)
  rw [← mul_assoc t a v]
  refine Submodule.mul_mem_mul ?_ hv
  refine Submodule.mul_induction_on ha (fun u _ g hg ↦ ?_)
    (fun x y hx hy ↦ by rw [mul_add]; exact Submodule.add_mem _ hx hy)
  rw [← mul_assoc t u g]
  exact Submodule.mul_mem_mul Submodule.mem_top hg

/-- The commutator ideal is closed under multiplication on the right. -/
theorem mul_mem_symSub_right {x : TensorAlgebra R M} (hx : x ∈ symSub R M)
    (t : TensorAlgebra R M) : x * t ∈ symSub R M := by
  rw [symSub] at hx ⊢
  refine Submodule.mul_induction_on hx (fun a ha v _ ↦ ?_)
    (fun x y hx hy ↦ by rw [add_mul]; exact Submodule.add_mem _ hx hy)
  rw [mul_assoc a v t]
  exact Submodule.mul_mem_mul ha Submodule.mem_top

/-- **The quotient of the tensor algebra by the commutator ideal is commutative.** -/
theorem sub_comm_mem_symSub (x y : TensorAlgebra R M) : x * y - y * x ∈ symSub R M := by
  have key : ∀ a b c : TensorAlgebra R M, a * b - b * a ∈ symSub R M →
      a * c - c * a ∈ symSub R M → a * (b * c) - b * c * a ∈ symSub R M := by
    intro a b c hb hc
    have h : a * (b * c) - b * c * a = (a * b - b * a) * c + b * (a * c - c * a) := by
      simp only [mul_sub, sub_mul, mul_assoc]
      abel
    rw [h]
    exact Submodule.add_mem _ (mul_mem_symSub_right hb c) (mul_mem_symSub_left b hc)
  have base : ∀ a : M, ∀ z : TensorAlgebra R M, ι R a * z - z * ι R a ∈ symSub R M := by
    intro a z
    induction z using TensorAlgebra.induction with
    | algebraMap r => rw [Algebra.commutes, sub_self]; exact Submodule.zero_mem _
    | ι b => exact commSub_le_symSub (commutator_mem_commSub a b)
    | mul b c hb hc => exact key _ _ _ hb hc
    | add b c hb hc =>
        have h : ι R a * (b + c) - (b + c) * ι R a =
            (ι R a * b - b * ι R a) + (ι R a * c - c * ι R a) := by
          simp only [mul_add, add_mul]; abel
        rw [h]; exact Submodule.add_mem _ hb hc
  induction x using TensorAlgebra.induction with
  | algebraMap r => rw [Algebra.commutes, sub_self]; exact Submodule.zero_mem _
  | ι a => exact base a y
  | mul b c hb hc =>
      rw [← neg_sub (y * (b * c)) (b * c * y)]
      refine Submodule.neg_mem _ (key y b c ?_ ?_)
      · rw [← neg_sub (b * y) (y * b)]; exact Submodule.neg_mem _ hb
      · rw [← neg_sub (c * y) (y * c)]; exact Submodule.neg_mem _ hc
  | add b c hb hc =>
      have h : (b + c) * y - y * (b + c) = (b * y - y * b) + (c * y - y * c) := by
        simp only [mul_add, add_mul]; abel
      rw [h]; exact Submodule.add_mem _ hb hc

variable (R M)

/-- The ring congruence on the tensor algebra cutting out the commutator ideal. -/
def symSubCon : RingCon (TensorAlgebra R M) where
  r a b := a - b ∈ symSub R M
  iseqv :=
    { refl := fun a ↦ by rw [sub_self]; exact Submodule.zero_mem _
      symm := fun {a b} h ↦ by
        rw [← neg_sub a b]; exact Submodule.neg_mem _ h
      trans := fun {a b c} h₁ h₂ ↦ by
        have h : a - c = (a - b) + (b - c) := by abel
        rw [h]; exact Submodule.add_mem _ h₁ h₂ }
  add' := fun {w x y z} h₁ h₂ ↦ by
    have h : w + y - (x + z) = (w - x) + (y - z) := by abel
    rw [h]; exact Submodule.add_mem _ h₁ h₂
  mul' := fun {w x y z} h₁ h₂ ↦ by
    have h : w * y - x * z = w * (y - z) + (w - x) * z := by
      simp only [mul_sub, sub_mul]; abel
    rw [h]
    exact Submodule.add_mem _ (mul_mem_symSub_left w h₂) (mul_mem_symSub_right h₁ z)

/-- Two elements are related by `symSubCon` exactly when their difference lies in `symSub`. -/
theorem symSubCon_iff {a b : TensorAlgebra R M} :
    symSubCon R M a b ↔ a - b ∈ symSub R M := Iff.rfl

/-- The quotient of the tensor algebra by the commutator ideal, as a commutative semiring.

Built from the `Semiring` instance of the quotient rather than from its `Ring` instance, so that
`CommSemiring.toSemiring` of it is that instance on the nose: the `Algebra R` instance of the
quotient is stated at that spelling, and an intervening `Ring` layer makes instance search fail
to match the two. -/
@[ega "II 1.7.1" "partial"]
abbrev quotCommSemiring : CommSemiring ((symSubCon R M).Quotient) where
  mul_comm := by
    refine Quotient.ind₂ fun x y ↦ ?_
    change ((x * y : TensorAlgebra R M) : (symSubCon R M).Quotient) =
      ((y * x : TensorAlgebra R M) : (symSubCon R M).Quotient)
    exact (symSubCon R M).eq.2 ((symSubCon_iff R M).2 (sub_comm_mem_symSub x y))

variable {R M}

/-- **The commutator ideal is the kernel of the canonical map to the symmetric algebra.** -/
@[ega "II 1.7.1"]
theorem mem_symSub_iff (x : TensorAlgebra R M) :
    x ∈ symSub R M ↔ SymmetricAlgebra.algHom R M x = 0 := by
  refine ⟨fun hx ↦ ?_, fun hx ↦ ?_⟩
  · refine Submodule.mul_induction_on hx (fun a ha v _ ↦ ?_)
      (fun x y hx hy ↦ by rw [map_add, hx, hy, add_zero])
    refine Submodule.mul_induction_on ha (fun u _ g hg ↦ ?_)
      (fun x y hx hy ↦ by rw [add_mul, map_add, hx, hy, add_zero])
    have hg0 : SymmetricAlgebra.algHom R M g = 0 := by
      refine Submodule.span_induction
        (p := fun g _ ↦ SymmetricAlgebra.algHom R M g = 0) ?_ ?_ ?_ ?_ hg
      · rintro _ ⟨⟨x, y⟩, rfl⟩
        rw [map_sub, map_mul, map_mul, mul_comm, sub_self]
      · exact map_zero _
      · intro x y _ _ hx hy; rw [map_add, hx, hy, add_zero]
      · intro r x _ hx; rw [map_smul, hx, smul_zero]
    rw [map_mul, map_mul, hg0, mul_zero, zero_mul]
  · let := quotCommSemiring R M
    let π : TensorAlgebra R M →ₐ[R] (symSubCon R M).Quotient := (symSubCon R M).mkₐ R
    let f : SymmetricAlgebra R M →ₐ[R] (symSubCon R M).Quotient :=
      SymmetricAlgebra.lift (π.toLinearMap ∘ₗ (ι R : M →ₗ[R] TensorAlgebra R M))
    have hcomp : ∀ y : TensorAlgebra R M, f (SymmetricAlgebra.algHom R M y) = π y := by
      intro y
      induction y using TensorAlgebra.induction with
      | algebraMap r => simp only [AlgHom.commutes]
      | ι m =>
          have h1 : SymmetricAlgebra.algHom R M (ι R m) = SymmetricAlgebra.ι R M m := rfl
          rw [h1]
          show SymmetricAlgebra.lift (π.toLinearMap ∘ₗ (ι R : M →ₗ[R] TensorAlgebra R M))
              (SymmetricAlgebra.ι R M m) = π (ι R m)
          rw [SymmetricAlgebra.lift_ι_apply, LinearMap.comp_apply, AlgHom.toLinearMap_apply]
      | mul a b ha hb => rw [map_mul, map_mul, ha, hb, ← map_mul]
      | add a b ha hb => rw [map_add, map_add, ha, hb, ← map_add]
    have hπx : π x = 0 := by rw [← hcomp x, hx, map_zero]
    have h0 : ((x : TensorAlgebra R M) : (symSubCon R M).Quotient) =
        ((0 : TensorAlgebra R M) : (symSubCon R M).Quotient) := by
      rw [RingCon.coe_zero]; exact hπx
    simpa using (symSubCon_iff R M).1 ((symSubCon R M).eq.1 h0)

end Commutators

/-! ### The relator submodules in a fixed degree -/

section RelSub

/-- The relator submodule of degree `i + 2 + j`: a commutator of degree-one generators,
multiplied on the left by a homogeneous element of degree `i` and on the right by one of degree
`j`. -/
def relSub (i j : ℕ) : Submodule R (TensorAlgebra R M) :=
  gradedPiece R i M * commSub R M * gradedPiece R j M

/-- A product `u · g · v` of a degree-`i` element, a commutator and a degree-`j` element is a
relator of degree `i + 2 + j`. -/
theorem mul_mem_relSub {i j : ℕ} {u g v : TensorAlgebra R M} (hu : u ∈ gradedPiece R i M)
    (hg : g ∈ commSub R M) (hv : v ∈ gradedPiece R j M) :
    u * g * v ∈ relSub (R := R) (M := M) i j :=
  Submodule.mul_mem_mul (Submodule.mul_mem_mul hu hg) hv

/-- A submodule containing all products `u · g · v` of a degree-`i` element, a commutator and a
degree-`j` element contains the relators of degree `i + 2 + j`. -/
private theorem relSub_le_of_mul_mem {i j : ℕ} {N : Submodule R (TensorAlgebra R M)}
    (h : ∀ u ∈ gradedPiece R i M, ∀ g ∈ commSub R M, ∀ v ∈ gradedPiece R j M, u * g * v ∈ N) :
    relSub (R := R) (M := M) i j ≤ N :=
  Submodule.mul_le.2 fun a ha v hv ↦
    Submodule.mul_induction_on ha (fun u hu g hg ↦ h u hu g hg v hv)
      (fun x y hx hy ↦ by rw [add_mul]; exact Submodule.add_mem _ hx hy)

/-- The relators of degree `i + 2 + j` are homogeneous of that degree. -/
theorem relSub_le_gradedPiece (i j : ℕ) :
    relSub (R := R) (M := M) i j ≤ gradedPiece R (i + 2 + j) M :=
  relSub_le_of_mul_mem fun _ hu _ hg _ hv ↦
    mul_mem_gradedPiece (mul_mem_gradedPiece hu (commSub_le_gradedPiece_two hg)) hv

/-- The relators lie in the commutator ideal. -/
theorem relSub_le_symSub (i j : ℕ) : relSub (R := R) (M := M) i j ≤ symSub R M :=
  relSub_le_of_mul_mem fun u _ _ hg v _ ↦
    mul_mem_symSub_right (mul_mem_symSub_left u (commSub_le_symSub hg)) v

/-- The decomposition of the tensor algebra into its homogeneous pieces
`TensorAlgebra.gradedPiece`, from `TensorAlgebra.gradedAlgebra`. -/
instance decompositionGradedPieceOfRange :
    DirectSum.Decomposition (fun n : ℕ => gradedPiece R n M) :=
  inferInstanceAs (DirectSum.Decomposition
    ((LinearMap.range (ι R : M →ₗ[R] TensorAlgebra R M) ^ ·) :
      ℕ → Submodule R (TensorAlgebra R M)))

/-- The homogeneous pieces of the tensor algebra span it. -/
theorem iSup_gradedPiece_eq_top : (⨆ n : ℕ, gradedPiece R n M) = ⊤ :=
  DirectSum.IsInternal.submodule_iSup_eq_top
    (DirectSum.Decomposition.isInternal fun n : ℕ ↦ gradedPiece R n M)

/-- The commutator ideal is the sum of the relator submodules of all degrees `i + 2 + j`. -/
theorem symSub_eq_iSup_relSub :
    symSub R M = ⨆ p : ℕ × ℕ, relSub (R := R) (M := M) p.1 p.2 := by
  rw [symSub, ← iSup_gradedPiece_eq_top (R := R) (M := M)]
  simp only [Submodule.iSup_mul, Submodule.mul_iSup]
  exact le_antisymm (iSup_le fun j ↦ iSup_le fun i ↦ le_iSup_of_le (i, j) le_rfl)
    (iSup_le fun p ↦ le_iSup_of_le p.2 (le_iSup_of_le p.1 le_rfl))

end RelSub

/-! ### Slot-wise relator endomorphisms -/

section RelMap

/-- Multiplication `T¹(M) ⊗ T¹(M) ≃ T²(M)`. -/
def mulTwo : gradedPiece R 1 M ⊗[R] gradedPiece R 1 M ≃ₗ[R] gradedPiece R 2 M :=
  powRangeMulEquivOfEq (by omega)

/-- `mulTwo` is multiplication in the tensor algebra. -/
theorem coe_mulTwo (x y : gradedPiece R 1 M) :
    (mulTwo (x ⊗ₜ[R] y) : TensorAlgebra R M) = (x : TensorAlgebra R M) * y :=
  coe_powRangeMulEquivOfEq_tmul _ x y

/-- An induction principle for the degree-two piece: every element is a sum of products of two
degree-one elements. -/
theorem two_ext {p : gradedPiece R 2 M → Prop} (hzero : p 0)
    (hadd : ∀ a b, p a → p b → p (a + b))
    (hmul : ∀ x y : gradedPiece R 1 M, p (mulTwo (x ⊗ₜ[R] y))) (w : gradedPiece R 2 M) : p w := by
  obtain ⟨s, rfl⟩ := (mulTwo (R := R) (M := M)).surjective w
  induction s using TensorProduct.induction_on with
  | zero => simpa only [map_zero] using hzero
  | tmul x y => exact hmul x y
  | add a b ha hb => rw [map_add]; exact hadd _ _ ha hb

/-- The transposition of the two slots of `T²(M)`. -/
def swapTwo : gradedPiece R 2 M →ₗ[R] gradedPiece R 2 M :=
  (mulTwo (R := R) (M := M)).toLinearMap ∘ₗ
    (TensorProduct.comm R (gradedPiece R 1 M) (gradedPiece R 1 M)).toLinearMap ∘ₗ
    (mulTwo (R := R) (M := M)).symm.toLinearMap

/-- `swapTwo` sends `x · y` to `y · x`. -/
theorem coe_swapTwo_mulTwo (x y : gradedPiece R 1 M) :
    (swapTwo (mulTwo (x ⊗ₜ[R] y)) : TensorAlgebra R M) = (y : TensorAlgebra R M) * x := by
  rw [swapTwo]
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply,
    TensorProduct.comm_tmul]
  exact coe_powRangeMulEquivOfEq_tmul _ y x

/-- `𝟙 - swapTwo`, the antisymmetriser of `T²(M)`. -/
def altTwo : gradedPiece R 2 M →ₗ[R] gradedPiece R 2 M :=
  LinearMap.id - swapTwo

/-- `altTwo` sends `x · y` to `x · y - y · x`. -/
theorem coe_altTwo_mulTwo (x y : gradedPiece R 1 M) :
    (altTwo (mulTwo (x ⊗ₜ[R] y)) : TensorAlgebra R M) =
      (x : TensorAlgebra R M) * y - (y : TensorAlgebra R M) * x := by
  rw [altTwo, LinearMap.sub_apply, LinearMap.id_apply, AddSubgroupClass.coe_sub,
    coe_swapTwo_mulTwo]
  exact congrArg (fun z : TensorAlgebra R M ↦ z - (y : TensorAlgebra R M) * x)
    (coe_powRangeMulEquivOfEq_tmul _ x y)

/-- `altTwo` sends an element equal to `ι x · ι y` to the commutator `ι x · ι y - ι y · ι x`. -/
theorem altTwo_of_coe_eq {w : gradedPiece R 2 M} {x y : M}
    (hw : (w : TensorAlgebra R M) = ι R x * ι R y) :
    (altTwo w : TensorAlgebra R M) = ι R x * ι R y - ι R y * ι R x := by
  have hw' : w = mulTwo ((⟨ι R x, ι_mem_gradedPiece x⟩ : gradedPiece R 1 M) ⊗ₜ[R]
      (⟨ι R y, ι_mem_gradedPiece y⟩ : gradedPiece R 1 M)) :=
    Subtype.ext (hw.trans
      (coe_mulTwo (⟨ι R x, ι_mem_gradedPiece x⟩ : gradedPiece R 1 M)
        (⟨ι R y, ι_mem_gradedPiece y⟩ : gradedPiece R 1 M)).symm)
  rw [hw']
  exact coe_altTwo_mulTwo _ _

/-- Multiplication `Tⁱ(M) ⊗ T²⁺ʲ(M) ≃ Tᵏ(M)` for `i + 2 + j = k`. -/
def mulOuter {i j k : ℕ} (h : i + 2 + j = k) :
    gradedPiece R i M ⊗[R] gradedPiece R (2 + j) M ≃ₗ[R] gradedPiece R k M :=
  powRangeMulEquivOfEq (by omega)

/-- Multiplication `T²(M) ⊗ Tʲ(M) ≃ T²⁺ʲ(M)`. -/
def mulInner (j : ℕ) :
    gradedPiece R 2 M ⊗[R] gradedPiece R j M ≃ₗ[R] gradedPiece R (2 + j) M :=
  powRangeMulEquivOfEq rfl

/-- `mulOuter` is multiplication in the tensor algebra. -/
theorem coe_mulOuter {i j k : ℕ} (h : i + 2 + j = k) (u : gradedPiece R i M)
    (z : gradedPiece R (2 + j) M) :
    (mulOuter h (u ⊗ₜ[R] z) : TensorAlgebra R M) = (u : TensorAlgebra R M) * z :=
  coe_powRangeMulEquivOfEq_tmul _ u z

/-- `mulInner` is multiplication in the tensor algebra. -/
theorem coe_mulInner (j : ℕ) (w : gradedPiece R 2 M) (v : gradedPiece R j M) :
    (mulInner j (w ⊗ₜ[R] v) : TensorAlgebra R M) = (w : TensorAlgebra R M) * v :=
  coe_powRangeMulEquivOfEq_tmul _ w v

/-- An induction principle for the degree-`k` piece along a splitting `k = i + 2 + j`: every
element is a sum of products of a degree-`i`, a degree-two and a degree-`j` element. -/
theorem outer_ext {i j k : ℕ} (h : i + 2 + j = k) {p : gradedPiece R k M → Prop} (hzero : p 0)
    (hadd : ∀ a b, p a → p b → p (a + b))
    (hmul : ∀ (u : gradedPiece R i M) (w : gradedPiece R 2 M) (v : gradedPiece R j M),
      p (mulOuter h (u ⊗ₜ[R] mulInner j (w ⊗ₜ[R] v))))
    (t : gradedPiece R k M) : p t := by
  obtain ⟨s, rfl⟩ := (mulOuter (R := R) (M := M) h).surjective t
  induction s using TensorProduct.induction_on with
  | zero => simpa only [map_zero] using hzero
  | tmul u z =>
      obtain ⟨s', rfl⟩ := (mulInner (R := R) (M := M) j).surjective z
      induction s' using TensorProduct.induction_on with
      | zero => simpa only [map_zero, TensorProduct.tmul_zero] using hzero
      | tmul w v => exact hmul u w v
      | add a b ha hb =>
          rw [map_add, TensorProduct.tmul_add, map_add]; exact hadd _ _ ha hb
  | add a b ha hb => rw [map_add]; exact hadd _ _ ha hb

/-- **The slot-wise relator endomorphism of `Tᵏ(M)`** attached to the splitting
`i + 2 + j = k`: under the multiplication identification `Tᵏ ≃ Tⁱ ⊗ T² ⊗ Tʲ` it is
`𝟙 ⊗ altTwo ⊗ 𝟙`. -/
def relMap {i j k : ℕ} (h : i + 2 + j = k) :
    gradedPiece R k M →ₗ[R] gradedPiece R k M :=
  (mulOuter h).toLinearMap ∘ₗ
    LinearMap.lTensor (gradedPiece R i M)
      ((mulInner j).toLinearMap ∘ₗ LinearMap.rTensor (gradedPiece R j M) altTwo ∘ₗ
        (mulInner j).symm.toLinearMap) ∘ₗ
    (mulOuter h).symm.toLinearMap

/-- `relMap` applies `altTwo` to the degree-two factor of the inner part, through `mulInner`. -/
theorem relMap_mulOuter {i j k : ℕ} (h : i + 2 + j = k) (u : gradedPiece R i M)
    (z : gradedPiece R (2 + j) M) :
    relMap h (mulOuter h (u ⊗ₜ[R] z)) =
      mulOuter h (u ⊗ₜ[R] (mulInner j (LinearMap.rTensor (gradedPiece R j M) altTwo
        ((mulInner j).symm z)))) := by
  rw [relMap]
  simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply,
    LinearMap.lTensor_tmul]

/-- `relMap` sends `u · w · v` to `u · altTwo w · v`. -/
theorem coe_relMap_mul {i j k : ℕ} (h : i + 2 + j = k) (u : gradedPiece R i M)
    (w : gradedPiece R 2 M) (v : gradedPiece R j M) :
    (relMap h (mulOuter h (u ⊗ₜ[R] mulInner j (w ⊗ₜ[R] v))) : TensorAlgebra R M) =
      (u : TensorAlgebra R M) * (altTwo w : TensorAlgebra R M) * v := by
  rw [relMap_mulOuter h u (mulInner j (w ⊗ₜ[R] v))]
  simp only [LinearEquiv.symm_apply_apply, LinearMap.rTensor_tmul]
  rw [coe_mulOuter, coe_mulInner, ← mul_assoc]

end RelMap

/-! ### The quotient map in a fixed degree -/

section Quot

/-- The image of `Tᵏ(M)` in the symmetric algebra is `Symᵏ(M)`. -/
theorem map_gradedPiece_eq (k : ℕ) :
    Submodule.map (SymmetricAlgebra.algHom R M).toLinearMap (gradedPiece R k M) =
      SymPow.symmetricPower k R M := by
  have h1 : Submodule.map (SymmetricAlgebra.algHom R M).toLinearMap
      (LinearMap.range (ι R : M →ₗ[R] TensorAlgebra R M)) =
      LinearMap.range (SymmetricAlgebra.ι R M) :=
    (LinearMap.range_comp _ _).symm
  rw [gradedPiece, Submodule.map_pow, h1, SymPow.symmetricPower]

/-- An element of `Tᵏ(M)` maps into `Symᵏ(M)`. -/
theorem algHom_mem_symmetricPower {k : ℕ} {x : TensorAlgebra R M} (hx : x ∈ gradedPiece R k M) :
    SymmetricAlgebra.algHom R M x ∈ SymPow.symmetricPower k R M := by
  rw [← map_gradedPiece_eq k]
  exact Submodule.mem_map_of_mem hx

/-- **The canonical surjection `Tᵏ(M) ⟶ Symᵏ(M)`**, the degree-`k` part of
`SymmetricAlgebra.algHom`. -/
def symQuot (k : ℕ) : gradedPiece R k M →ₗ[R] SymPow.symmetricPower k R M :=
  (SymmetricAlgebra.algHom R M).toLinearMap.restrict
    (fun _ hx ↦ algHom_mem_symmetricPower hx)

/-- `symQuot k` is the restriction of `SymmetricAlgebra.algHom`. -/
@[simp]
theorem coe_symQuot (k : ℕ) (t : gradedPiece R k M) :
    (symQuot k t : SymmetricAlgebra R M) = SymmetricAlgebra.algHom R M t := rfl

/-- **`Tᵏ(M) ⟶ Symᵏ(M)` is surjective.** -/
theorem surjective_symQuot (k : ℕ) :
    Function.Surjective (symQuot (R := R) (M := M) k) := by
  rintro ⟨z, hz⟩
  rw [← map_gradedPiece_eq k] at hz
  obtain ⟨x, hx, hxz⟩ := hz
  exact ⟨⟨x, hx⟩, Subtype.ext hxz⟩

/-- An element of `Tᵏ(M)` dies in `Symᵏ(M)` exactly when it lies in the commutator ideal. -/
theorem symQuot_eq_zero_iff (k : ℕ) (t : gradedPiece R k M) :
    symQuot k t = 0 ↔ (t : TensorAlgebra R M) ∈ symSub R M := by
  rw [mem_symSub_iff]
  refine ⟨fun h ↦ ?_, fun h ↦ Subtype.ext ?_⟩
  · rw [← coe_symQuot k t, h, ZeroMemClass.coe_zero]
  · rw [coe_symQuot, h, ZeroMemClass.coe_zero]

end Quot

/-! ### The kernel of the quotient map -/

section Kernel

/-- The splitting `k = p + 2 + (k - 2 - p)` for `p : Fin (k - 1)`. -/
private theorem fin_add_two_add_sub_eq {k : ℕ} (p : Fin (k - 1)) :
    (p : ℕ) + 2 + (k - 2 - (p : ℕ)) = k := by
  have := p.2; omega

/-- The relator submodule of degree `k`, as the sum over the `k - 1` splittings
`k = i + 2 + j`. -/
def relDeg (k : ℕ) : Submodule R (TensorAlgebra R M) :=
  ⨆ p : Fin (k - 1), relSub (R := R) (M := M) (p : ℕ) (k - 2 - p)

/-- The relators of degree `k` are homogeneous of degree `k`. -/
theorem relDeg_le_gradedPiece (k : ℕ) : relDeg (R := R) (M := M) k ≤ gradedPiece R k M := by
  refine iSup_le fun p ↦ ?_
  have hle := relSub_le_gradedPiece (R := R) (M := M) (p : ℕ) (k - 2 - (p : ℕ))
  rwa [fin_add_two_add_sub_eq p] at hle

/-- The commutator ideal is the sum over all degrees `k` of the relators of degree `k`. -/
theorem symSub_eq_iSup_relDeg : symSub R M = ⨆ k : ℕ, relDeg (R := R) (M := M) k := by
  rw [symSub_eq_iSup_relSub]
  refine le_antisymm (iSup_le fun p ↦ ?_) (iSup_le fun k ↦ iSup_le fun p ↦ ?_)
  · refine le_iSup_of_le (p.1 + 2 + p.2) (le_iSup_of_le ⟨p.1, by omega⟩ ?_)
    rw [show p.1 + 2 + p.2 - 2 - p.1 = p.2 by omega]
  · exact le_iSup_of_le ((p : ℕ), k - 2 - (p : ℕ)) le_rfl

/-- The submodule of elements all of whose homogeneous components are relators. -/
def relDecomp : Submodule R (TensorAlgebra R M) where
  carrier := {x | ∀ k : ℕ, ((DirectSum.decompose (fun n : ℕ ↦ gradedPiece R n M) x k :
    TensorAlgebra R M)) ∈ relDeg (R := R) (M := M) k}
  add_mem' := by
    intro a b ha hb k
    rw [DirectSum.decompose_add, DirectSum.add_apply, Submodule.coe_add]
    exact Submodule.add_mem _ (ha k) (hb k)
  zero_mem' := by
    intro k
    rw [DirectSum.decompose_zero, DirectSum.zero_apply, ZeroMemClass.coe_zero]
    exact Submodule.zero_mem _
  smul_mem' := by
    intro r a ha k
    rw [DirectSum.decompose_smul, DirectSum.smul_apply, SetLike.val_smul]
    exact Submodule.smul_mem _ r (ha k)

/-- Every relator of degree `k` has all its homogeneous components relators. -/
theorem relDeg_le_relDecomp (k : ℕ) :
    relDeg (R := R) (M := M) k ≤ relDecomp := by
  intro x hx m
  rcases eq_or_ne k m with rfl | hkm
  · rw [DirectSum.decompose_of_mem_same _ (relDeg_le_gradedPiece k hx)]
    exact hx
  · rw [DirectSum.decompose_of_mem_ne _ (relDeg_le_gradedPiece k hx) hkm]
    exact Submodule.zero_mem _

/-- A homogeneous element of degree `k` of the commutator ideal is a relator of degree `k`. -/
theorem mem_relDeg_of_mem_symSub {k : ℕ} {x : TensorAlgebra R M} (hx : x ∈ symSub R M)
    (hk : x ∈ gradedPiece R k M) : x ∈ relDeg (R := R) (M := M) k := by
  have h : symSub R M ≤ relDecomp (R := R) (M := M) := by
    rw [symSub_eq_iSup_relDeg]
    exact iSup_le fun m ↦ relDeg_le_relDecomp m
  have hx' := h hx k
  rwa [DirectSum.decompose_of_mem_same _ hk] at hx'

/-- The slot-wise relator endomorphisms of `Tᵏ(M)`, indexed by the `k - 1` adjacent slot
pairs. -/
def slotRelMap (k : ℕ) (p : Fin (k - 1)) :
    gradedPiece R k M →ₗ[R] gradedPiece R k M :=
  relMap (show (p : ℕ) + 2 + (k - 2 - p) = k by have := p.2; omega)

/-- The image of `altTwo` dies in the symmetric algebra. -/
theorem algHom_altTwo (w : gradedPiece R 2 M) :
    SymmetricAlgebra.algHom R M (altTwo w : TensorAlgebra R M) = 0 := by
  refine two_ext (p := fun w ↦ SymmetricAlgebra.algHom R M (altTwo w : TensorAlgebra R M) = 0)
    ?_ ?_ ?_ w
  · rw [map_zero, ZeroMemClass.coe_zero, map_zero]
  · intro a b ha hb
    simp only [map_add, Submodule.coe_add, ha, hb, add_zero]
  · intro x y
    rw [coe_altTwo_mulTwo, map_sub, map_mul, map_mul, mul_comm, sub_self]

/-- **The relator maps land in the kernel of `Tᵏ(M) ⟶ Symᵏ(M)`.** -/
theorem symQuot_relMap {i j k : ℕ} (h : i + 2 + j = k) (t : gradedPiece R k M) :
    symQuot k (relMap h t) = 0 := by
  refine outer_ext h (p := fun t ↦ symQuot k (relMap h t) = 0) ?_ ?_ ?_ t
  · rw [map_zero, map_zero]
  · intro a b ha hb
    rw [map_add, map_add, ha, hb, add_zero]
  · intro u w v
    rw [symQuot_eq_zero_iff, mem_symSub_iff, coe_relMap_mul, map_mul, map_mul, algHom_altTwo w,
      mul_zero, zero_mul]

/-- The relators for the splitting `k = p + 2 + (k - 2 - p)` lie in the range of the `p`-th
slot-wise relator map. -/
theorem relSub_le_map_slotRelMap {k : ℕ} (p : Fin (k - 1)) :
    relSub (R := R) (M := M) (p : ℕ) (k - 2 - (p : ℕ)) ≤
      Submodule.map (gradedPiece R k M).subtype
        (LinearMap.range (slotRelMap (R := R) (M := M) k p)) := by
  have h := fin_add_two_add_sub_eq p
  refine relSub_le_of_mul_mem fun u hu g hg v hv ↦ ?_
  refine Submodule.span_induction
    (p := fun g _ ↦ u * g * v ∈ Submodule.map (gradedPiece R k M).subtype
      (LinearMap.range (slotRelMap (R := R) (M := M) k p))) ?_ ?_ ?_ ?_ hg
  · rintro _ ⟨⟨x, y⟩, rfl⟩
    refine ⟨relMap h (mulOuter h ((⟨u, hu⟩ : gradedPiece R (p : ℕ) M) ⊗ₜ[R]
      mulInner (k - 2 - (p : ℕ))
        ((⟨ι R x * ι R y, mul_mem_gradedPiece (ι_mem_gradedPiece x) (ι_mem_gradedPiece y)⟩ :
          gradedPiece R 2 M) ⊗ₜ[R] ⟨v, hv⟩))), ⟨_, rfl⟩, ?_⟩
    refine (coe_relMap_mul h _ _ _).trans ?_
    rw [altTwo_of_coe_eq (x := x) (y := y) rfl]
  · rw [mul_zero, zero_mul]
    exact Submodule.zero_mem _
  · intro a b _ _ hA hB
    rw [mul_add, add_mul]
    exact Submodule.add_mem _ hA hB
  · intro r a _ hA
    rw [Algebra.mul_smul_comm, Algebra.smul_mul_assoc]
    exact Submodule.smul_mem _ r hA

/-- **The kernel of `Tᵏ(M) ⟶ Symᵏ(M)` is the sum of the ranges of the `k - 1` slot-wise relator
maps.** -/
theorem ker_symQuot (k : ℕ) :
    LinearMap.ker (symQuot (R := R) (M := M) k) =
      ⨆ p : Fin (k - 1), LinearMap.range (slotRelMap (R := R) (M := M) k p) := by
  refine le_antisymm (fun t ht ↦ ?_) (iSup_le fun p ↦ ?_)
  · have ht' : (t : TensorAlgebra R M) ∈ relDeg (R := R) (M := M) k :=
      mem_relDeg_of_mem_symSub ((symQuot_eq_zero_iff k t).1 ht) t.2
    have hle : relDeg (R := R) (M := M) k ≤
        Submodule.map (gradedPiece R k M).subtype
          (⨆ p : Fin (k - 1), LinearMap.range (slotRelMap (R := R) (M := M) k p)) :=
      iSup_le fun p ↦
        (relSub_le_map_slotRelMap p).trans (Submodule.map_mono
          (le_iSup (fun q : Fin (k - 1) ↦
            LinearMap.range (slotRelMap (R := R) (M := M) k q)) p))
    obtain ⟨s, hs, hst⟩ := hle ht'
    rwa [show t = s from Subtype.ext hst.symm]
  · rintro _ ⟨t, rfl⟩
    rw [LinearMap.mem_ker, slotRelMap]
    exact symQuot_relMap _ t

/-- The elementwise form of `TensorAlgebra.ker_symQuot`: an element of `Tᵏ(M)` killed in
`Symᵏ(M)` is a sum of relators, one for each adjacent slot pair. -/
theorem exists_sum_slotRelMap {k : ℕ} (t : gradedPiece R k M) (ht : symQuot k t = 0) :
    ∃ c : Fin (k - 1) → gradedPiece R k M,
      t = ∑ p : Fin (k - 1), slotRelMap k p (c p) := by
  classical
  rw [← LinearMap.mem_ker, ker_symQuot] at ht
  obtain ⟨g, hg, hsum⟩ := (Submodule.mem_iSup_iff_exists_finsupp _ _).1 ht
  choose c hc using fun p ↦ LinearMap.mem_range.1 (hg p)
  refine ⟨c, ?_⟩
  rw [← hsum, Finsupp.sum_fintype _ _ (fun _ ↦ rfl)]
  exact Finset.sum_congr rfl fun p _ ↦ (hc p).symm

end Kernel

/-! ### Base change -/

section BaseChange

variable {S : Type*} [CommRing S] {N : Type*} [AddCommGroup N] [Module S N]

/-- Base change commutes with `mulTwo`. -/
theorem powMapₛₗ_mulTwo (φ : R →+* S) (u : M →ₛₗ[φ] N) (x y : gradedPiece R 1 M) :
    powMapₛₗ 2 φ u (mulTwo (x ⊗ₜ[R] y)) =
      mulTwo (powMapₛₗ 1 φ u x ⊗ₜ[S] powMapₛₗ 1 φ u y) :=
  Subtype.ext (by rw [powMapₛₗ_coe, coe_mulTwo, coe_mulTwo, map_mul, powMapₛₗ_coe, powMapₛₗ_coe])

/-- **The antisymmetriser of the degree-two piece commutes with base change.** -/
theorem coe_altTwo_powMapₛₗ (φ : R →+* S) (u : M →ₛₗ[φ] N) (w : gradedPiece R 2 M) :
    (altTwo (powMapₛₗ 2 φ u w) : TensorAlgebra S N) =
      mapₛₗ φ u (altTwo w : TensorAlgebra R M) := by
  refine two_ext (p := fun w ↦ (altTwo (powMapₛₗ 2 φ u w) : TensorAlgebra S N) =
    mapₛₗ φ u (altTwo w : TensorAlgebra R M)) ?_ ?_ ?_ w
  · simp only [map_zero, ZeroMemClass.coe_zero]
  · intro a b ha hb
    simp only [map_add, Submodule.coe_add, ha, hb]
  · intro x y
    rw [powMapₛₗ_mulTwo, coe_altTwo_mulTwo, coe_altTwo_mulTwo, map_sub, map_mul, map_mul,
      powMapₛₗ_coe, powMapₛₗ_coe]

/-- Base change commutes with the multiplication isomorphisms `mulOuter` and `mulInner`. -/
theorem powMapₛₗ_mulOuter {i j k : ℕ} (h : i + 2 + j = k) (φ : R →+* S) (u : M →ₛₗ[φ] N)
    (a : gradedPiece R i M) (w : gradedPiece R 2 M) (v : gradedPiece R j M) :
    powMapₛₗ k φ u (mulOuter h (a ⊗ₜ[R] mulInner j (w ⊗ₜ[R] v))) =
      mulOuter h (powMapₛₗ i φ u a ⊗ₜ[S]
        mulInner j (powMapₛₗ 2 φ u w ⊗ₜ[S] powMapₛₗ j φ u v)) :=
  Subtype.ext (by
    rw [powMapₛₗ_coe, coe_mulOuter, coe_mulInner, coe_mulOuter, coe_mulInner, map_mul, map_mul,
      powMapₛₗ_coe, powMapₛₗ_coe, powMapₛₗ_coe])

/-- **The slot-wise relator maps commute with base change.** -/
theorem coe_relMap_powMapₛₗ {i j k : ℕ} (h : i + 2 + j = k) (φ : R →+* S) (u : M →ₛₗ[φ] N)
    (t : gradedPiece R k M) :
    (relMap h (powMapₛₗ k φ u t) : TensorAlgebra S N) =
      mapₛₗ φ u (relMap h t : TensorAlgebra R M) := by
  refine outer_ext h (p := fun t ↦ (relMap h (powMapₛₗ k φ u t) : TensorAlgebra S N) =
    mapₛₗ φ u (relMap h t : TensorAlgebra R M)) ?_ ?_ ?_ t
  · simp only [map_zero, ZeroMemClass.coe_zero]
  · intro a b ha hb
    simp only [map_add, Submodule.coe_add, ha, hb]
  · intro a w v
    rw [powMapₛₗ_mulOuter, coe_relMap_mul, coe_relMap_mul, map_mul, map_mul, powMapₛₗ_coe,
      powMapₛₗ_coe, coe_altTwo_powMapₛₗ]

/-- The slot-wise relator maps `slotRelMap` commute with base change. -/
theorem slotRelMap_powMapₛₗ (k : ℕ) (p : Fin (k - 1)) (φ : R →+* S) (u : M →ₛₗ[φ] N)
    (t : gradedPiece R k M) :
    slotRelMap k p (powMapₛₗ k φ u t) = powMapₛₗ k φ u (slotRelMap k p t) :=
  Subtype.ext ((coe_relMap_powMapₛₗ _ φ u t).trans (powMapₛₗ_coe k φ u _).symm)

end BaseChange

end TensorAlgebra

end
