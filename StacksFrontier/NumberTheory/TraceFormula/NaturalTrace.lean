module

public import Mathlib.Algebra.Group.Subgroup.Finite
public import Mathlib.LinearAlgebra.Matrix.ToLin
public import Mathlib.LinearAlgebra.Matrix.Trace
public import StacksCore.Tactic.StacksAttribute

/-!
# Traces of endomorphisms of free modules over a noncommutative ring

Let `Λ` be a ring, not assumed commutative. Write `Λ^♮` for the quotient of the additive group
of `Λ` by the subgroup generated by the commutators `a * b - b * a`; it is an additive group, not
a ring. Since `End_Λ(Λ^⊕m) = Mat_m(Λ)`, with a matrix acting on a left module by right
multiplication, the sum of the diagonal entries of the matrix representing an endomorphism of
`Λ^⊕m` is well defined in `Λ^♮`, and for maps `a : Λ^⊕m → Λ^⊕n` and `b : Λ^⊕n → Λ^⊕m` the two
traces `Tr(ab)` and `Tr(ba)` agree there.

## Main definitions

* `Stacks.TraceFormula.addCommutators`: the additive subgroup of `Λ` generated by the
  commutators `a * b - b * a`.
* `Stacks.TraceFormula.Natural` and `Stacks.TraceFormula.toNatural`: the group `Λ^♮` and the
  canonical additive map `Λ → Λ^♮`.
* `Stacks.TraceFormula.matrixTrace`: the trace of a square matrix over `Λ`, an additive map to
  `Λ^♮`.
* `Stacks.TraceFormula.freeTrace`: the trace of a `Λ`-linear endomorphism of `Λ^⊕m`, computed
  from the matrix representing it.

## Main results

* `Stacks.TraceFormula.toNatural_mul_comm`: `a * b` and `b * a` have the same image in `Λ^♮`.
* `Stacks.TraceFormula.matrixTrace_mul_comm`: `Tr(AB) = Tr(BA)` in `Λ^♮` for rectangular
  matrices `A` and `B` over `Λ`.
* `Stacks.TraceFormula.freeTrace_comp_comm`: `Tr(ab) = Tr(ba)` for `Λ`-linear maps
  `a : Λ^⊕m → Λ^⊕n` and `b : Λ^⊕n → Λ^⊕m`.

## Implementation notes

Endomorphisms of the left module `Λ^⊕m` are identified with matrices through Mathlib's
`LinearMap.toMatrixRight'`, which sends a linear map to the matrix acting by right
multiplication; this is the identification `End_Λ(Λ^⊕m) = Mat_m(Λ)` of the source. Composition
is therefore reversed: the source's `ab`, "first `a`, then `b`", is `b ∘ₗ a`.

For a commutative `Λ` the sharper identity `Matrix.trace (A * B) = Matrix.trace (B * A)` holds
in `Λ` itself, and is Mathlib's `Matrix.trace_mul_comm`.

## References

* [Stacks Project, Tag 03T1](https://stacks.math.columbia.edu/tag/03T1)
* [Stacks Project, Tag 03T0](https://stacks.math.columbia.edu/tag/03T0)
-/

@[expose] public section

namespace Stacks.TraceFormula

/-- The additive subgroup of a ring `Λ` generated by the commutators `a * b - b * a`. -/
public def addCommutators (Λ : Type*) [Ring Λ] : AddSubgroup Λ :=
  AddSubgroup.closure {x | ∃ a b : Λ, a * b - b * a = x}

/-- The group `Λ^♮`, the quotient of the additive group of a ring `Λ` by the subgroup generated
by the commutators. It is an additive group, not a ring. -/
@[sga "4½ Rapport 4.2"]
public abbrev Natural (Λ : Type*) [Ring Λ] : Type _ := Λ ⧸ addCommutators Λ

/-- The canonical additive map `Λ → Λ^♮`. -/
public def toNatural (Λ : Type*) [Ring Λ] : Λ →+ Natural Λ :=
  QuotientAddGroup.mk' (addCommutators Λ)

variable {Λ : Type*} [Ring Λ]

/-- Two elements of `Λ` have the same image in `Λ^♮` exactly when their difference is a sum of
commutators. -/
public theorem toNatural_eq_iff {x y : Λ} :
    toNatural Λ x = toNatural Λ y ↔ x - y ∈ addCommutators Λ := by
  rw [← sub_eq_zero, ← map_sub]
  exact QuotientAddGroup.eq_zero_iff _

/-- The commutators die in `Λ^♮`: the products `a * b` and `b * a` have the same image. -/
public theorem toNatural_mul_comm (a b : Λ) : toNatural Λ (a * b) = toNatural Λ (b * a) :=
  toNatural_eq_iff.2 (AddSubgroup.subset_closure ⟨a, b, rfl⟩)

/-- The trace of a square matrix over a ring `Λ`: the image in `Λ^♮` of the sum of its diagonal
entries, as an additive map. -/
public def matrixTrace (ι : Type*) [Fintype ι] (Λ : Type*) [Ring Λ] :
    Matrix ι ι Λ →+ Natural Λ :=
  (toNatural Λ).comp (Matrix.traceAddMonoidHom ι Λ)

/-- The trace of a square matrix `A` in `Λ^♮` is the image of the ordinary trace of `A`. -/
@[simp]
public theorem matrixTrace_apply {ι : Type*} [Fintype ι] (A : Matrix ι ι Λ) :
    matrixTrace ι Λ A = toNatural Λ A.trace :=
  rfl

/-- **Stacks Project, Tag 03T1.** The trace in `Λ^♮` of a product of rectangular matrices over a
ring `Λ` is unchanged by swapping the factors, since `Tr(AB) - Tr(BA)` is a sum of commutators. -/
@[sga "4½ Rapport 4.2"]
public theorem matrixTrace_mul_comm {ι κ : Type*} [Fintype ι] [Fintype κ]
    (A : Matrix ι κ Λ) (B : Matrix κ ι Λ) :
    matrixTrace ι Λ (A * B) = matrixTrace κ Λ (B * A) := by
  have hAB : (A * B).trace = ∑ i : ι, ∑ j : κ, A i j * B j i := by
    simp [Matrix.trace, Matrix.mul_apply]
  have hBA : (B * A).trace = ∑ i : ι, ∑ j : κ, B j i * A i j := by
    simp only [Matrix.trace, Matrix.diag_apply, Matrix.mul_apply]
    exact Finset.sum_comm
  rw [matrixTrace_apply, matrixTrace_apply, toNatural_eq_iff, hAB, hBA,
    ← Finset.sum_sub_distrib]
  refine AddSubgroup.sum_mem _ fun i _ => ?_
  rw [← Finset.sum_sub_distrib]
  exact AddSubgroup.sum_mem _ fun j _ => AddSubgroup.subset_closure ⟨A i j, B j i, rfl⟩

/-- The trace of a `Λ`-linear endomorphism of the free left module `Λ^⊕m`: the image in `Λ^♮` of
the sum of the diagonal entries of the matrix representing it. -/
public def freeTrace {m : ℕ} (f : (Fin m → Λ) →ₗ[Λ] (Fin m → Λ)) : Natural Λ :=
  matrixTrace (Fin m) Λ (LinearMap.toMatrixRight' f)

/-- **Stacks Project, Tag 03T1.** Given `Λ`-linear maps `a : Λ^⊕m → Λ^⊕n` and
`b : Λ^⊕n → Λ^⊕m` over a ring `Λ`, the traces of `ab` and of `ba` agree in `Λ^♮`. -/
@[stacks 03T1 "Tr(ab) = Tr(ba) in Λ^♮ for a : Λ^⊕m → Λ^⊕n and b : Λ^⊕n → Λ^⊕m, where Λ is a \
ring that is not assumed commutative and Λ^♮ is Λ modulo the additive subgroup generated by the \
commutators"]
public theorem freeTrace_comp_comm {m n : ℕ} (a : (Fin m → Λ) →ₗ[Λ] (Fin n → Λ))
    (b : (Fin n → Λ) →ₗ[Λ] (Fin m → Λ)) :
    freeTrace (b ∘ₗ a) = freeTrace (a ∘ₗ b) := by
  rw [freeTrace, freeTrace, LinearMap.toMatrixRight'_comp, LinearMap.toMatrixRight'_comp]
  exact matrixTrace_mul_comm _ _

end Stacks.TraceFormula

end
