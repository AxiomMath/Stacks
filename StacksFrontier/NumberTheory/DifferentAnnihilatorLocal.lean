module

public import Mathlib.NumberTheory.NumberField.Discriminant.Different
public import StacksFrontier.RingTheory.Kaehler.AnnihilatorEtale
public import StacksFrontier.RingTheory.Kaehler.Monogenic

/-!
# The different and the annihilator of the differentials agree at a prime with a local generator

Let `L/K` be an extension of number fields, let `P` be a maximal ideal of `𝒪_L` and let `x` be an
element of `𝒪_L` whose conductor — the largest ideal of `𝒪_L` contained in `𝒪_K[x]` — is not
contained in `P`. Then the different of `𝒪_L/𝒪_K` and the annihilator of `Ω[𝒪_L⁄𝒪_K]` have the
same image in the localisation of `𝒪_L` at `P`, namely the ideal generated by `f'(x)` for `f` the
minimal polynomial of `x` over `𝒪_K`.

Consequently, if every maximal ideal of `𝒪_L` admits such an `x`, the two ideals are equal: this
is the assertion of Tag 024Z, reduced to the existence of local monogenic generators.

## Main results

* `NumberField.adjoin_eq_top_of_mem_conductor`: a nonzero element of the conductor of `𝒪_K[x]`
  forces `x` to be a primitive element of `L` over `K`.
* `NumberField.differentIdeal_map_atPrime_of_conductor_not_le`: the image of the different in
  `(𝒪_L)_P` is generated by `f'(x)`.
* `NumberField.annihilator_map_atPrime_of_conductor_not_le`: the image of the annihilator of
  `Ω[𝒪_L⁄𝒪_K]` in `(𝒪_L)_P` is generated by `f'(x)`.
* `NumberField.differentIdeal_eq_annihilator_of_forall_exists_conductor_not_le`: if every maximal
  ideal of `𝒪_L` is coprime to the conductor of some `𝒪_K[x]`, the different is the annihilator
  of `Ω[𝒪_L⁄𝒪_K]`.

## Implementation notes

Both sides are compared one maximal ideal of `𝒪_L` at a time, by
`Ideal.eq_of_localization_maximal`. On the side of the Dedekind different the computation is
Mathlib's `conductor_mul_differentIdeal`: the conductor becomes the unit ideal in `(𝒪_L)_P`, so
the different becomes `(f'(x))`. On the side of the Kähler different, a conductor coprime to `P`
makes `(𝒪_L)_P` a localisation of the monogenic ring `𝒪_K[x]` as well as of `𝒪_L`; the
annihilator of the differentials is compatible with both localisations, by
`KaehlerDifferential.annihilator_eq_map_of_isLocalization_top`, and over `𝒪_K[x]` it is `(f'(x))`
by `KaehlerDifferential.annihilator_eq_span_aeval_derivative_minpoly`.

Primitivity of `x` is not assumed: it follows from the hypothesis, since a nonzero element `y` of
the conductor exhibits every element of `𝒪_L` as a quotient of elements of `𝒪_K[x]`.

No Stacks tag is registered here: the hypothesis that every maximal ideal admits a local generator
is not a hypothesis of Tag 024Z.

## References

* [Stacks Project, Tag 024Z](https://stacks.math.columbia.edu/tag/024Z)
-/

@[expose] public section

open NumberField Polynomial

universe u

noncomputable section

namespace NumberField

attribute [local instance] FractionRing.liftAlgebra

variable (K L : Type u) [Field K] [Field L] [NumberField K] [NumberField L] [Algebra K L]

/-- **A conductor with a nonzero element forces a primitive element.** If `y ≠ 0` lies in the
conductor of `𝒪_K[x]` in `𝒪_L`, then every element of `𝒪_L` is `y⁻¹` times an element of
`𝒪_K[x]`, so the `K`-subalgebra of `L` generated by `x` contains `𝒪_L`; being a field it contains
all of `L`. -/
theorem adjoin_eq_top_of_mem_conductor {x y : 𝓞 L} (hy0 : y ≠ 0)
    (hy : y ∈ conductor (𝓞 K) x) :
    Algebra.adjoin K ({algebraMap (𝓞 L) L x} : Set L) = ⊤ := by
  have hle : Algebra.adjoin (𝓞 K) ({algebraMap (𝓞 L) L x} : Set L) ≤
      Subalgebra.restrictScalars (𝓞 K)
        (Algebra.adjoin K ({algebraMap (𝓞 L) L x} : Set L)) := by
    refine Algebra.adjoin_le ?_
    rw [Set.singleton_subset_iff, SetLike.mem_coe, Subalgebra.mem_restrictScalars]
    exact Algebra.self_mem_adjoin_singleton K _
  -- every element of `𝒪_K[x]` maps into the `K`-subalgebra generated by `x`
  have hmem : ∀ b : 𝓞 L, b ∈ Algebra.adjoin (𝓞 K) ({x} : Set (𝓞 L)) →
      algebraMap (𝓞 L) L b ∈ Algebra.adjoin K ({algebraMap (𝓞 L) L x} : Set L) := by
    intro b hb
    rw [Algebra.adjoin_singleton_eq_range_aeval (𝓞 K) x, AlgHom.mem_range] at hb
    obtain ⟨p, rfl⟩ := hb
    refine hle ?_
    rw [Algebra.adjoin_singleton_eq_range_aeval (𝓞 K) (algebraMap (𝓞 L) L x), AlgHom.mem_range]
    exact ⟨p, Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom (𝓞 K) (𝓞 L) L) x p⟩
  have hyL : algebraMap (𝓞 L) L y ≠ 0 := by
    simpa using (FaithfulSMul.algebraMap_injective (𝓞 L) L).ne hy0
  have hyA : algebraMap (𝓞 L) L y ∈ Algebra.adjoin K ({algebraMap (𝓞 L) L x} : Set L) :=
    hmem y (conductor_subset_adjoin hy)
  -- inverses of integral elements of `𝒪_L` stay in the subalgebra once the elements do
  have hinv : ∀ b : 𝓞 L, algebraMap (𝓞 L) L b ∈
      Algebra.adjoin K ({algebraMap (𝓞 L) L x} : Set L) →
      (algebraMap (𝓞 L) L b)⁻¹ ∈ Algebra.adjoin K ({algebraMap (𝓞 L) L x} : Set L) :=
    fun b hb ↦ Algebra.adjoin_le (Set.singleton_subset_iff.mpr hb)
      (IsIntegral.of_finite (R := K) (algebraMap (𝓞 L) L b)).inv_mem_adjoin
  -- hence every element of `𝒪_L` maps into it
  have hall : ∀ b : 𝓞 L, algebraMap (𝓞 L) L b ∈
      Algebra.adjoin K ({algebraMap (𝓞 L) L x} : Set L) := fun b ↦ by
    simpa [hyL] using Subalgebra.mul_mem _ (hinv y hyA) (hmem _ (mem_conductor_iff.mp hy b))
  rw [eq_top_iff]
  intro z _
  obtain ⟨b, s, _, rfl⟩ := IsFractionRing.div_surjective (A := 𝓞 L) z
  rw [div_eq_mul_inv]
  exact Subalgebra.mul_mem _ (hall b) (hinv s (hall s))

/-- **The different at a prime coprime to the conductor.** If the conductor of `𝒪_K[x]` is not
contained in the maximal ideal `P`, the image of the different of `𝒪_L/𝒪_K` in the localisation
of `𝒪_L` at `P` is generated by `f'(x)`: the conductor becomes the unit ideal there, so the
identity `𝔠 · 𝔡 = (f'(x))` of `conductor_mul_differentIdeal` reads `𝔡 = (f'(x))`. -/
theorem differentIdeal_map_atPrime_of_conductor_not_le
    (P : Ideal (𝓞 L)) [P.IsPrime] {x : 𝓞 L} (hx : ¬ conductor (𝓞 K) x ≤ P) :
    (differentIdeal (𝓞 K) (𝓞 L)).map (algebraMap (𝓞 L) (Localization.AtPrime P)) =
      Ideal.span {(algebraMap (𝓞 L) (Localization.AtPrime P)
        (aeval x (derivative (minpoly (𝓞 K) x))))} := by
  obtain ⟨y, hyC, hyP⟩ := SetLike.not_le_iff_exists.mp hx
  have hy0 : y ≠ 0 := fun h ↦ hyP (h ▸ P.zero_mem)
  have hprim := adjoin_eq_top_of_mem_conductor K L hy0 hyC
  have h1 := conductor_mul_differentIdeal (𝓞 K) K L x hprim
  have h2 : (conductor (𝓞 K) x).map (algebraMap (𝓞 L) (Localization.AtPrime P)) = ⊤ :=
    IsLocalization.AtPrime.map_eq_top_of_not_le (Localization.AtPrime P) hx
  have h3 := congrArg (Ideal.map (algebraMap (𝓞 L) (Localization.AtPrime P))) h1
  rwa [Ideal.map_mul, h2, Ideal.top_mul, Ideal.map_span, Set.image_singleton] at h3

/-- **The Kähler different at a prime coprime to the conductor.** If the conductor of `𝒪_K[x]` is
not contained in the maximal ideal `P`, the image of the annihilator of `Ω[𝒪_L⁄𝒪_K]` in the
localisation of `𝒪_L` at `P` is generated by `f'(x)`.

The localisation of `𝒪_L` at `P` is also a localisation of `𝒪_K[x]`, at the prime below `P`:
clearing the denominator `y` of the conductor writes any fraction `b/s` with `s ∉ P` as a
fraction of elements of `𝒪_K[x]` with denominator `y s ∉ P`. The annihilator of the differentials
is compatible with both localisations, and over the monogenic ring `𝒪_K[x]` it is `(f'(x))`. -/
theorem annihilator_map_atPrime_of_conductor_not_le
    (P : Ideal (𝓞 L)) [P.IsPrime] {x : 𝓞 L} (hx : ¬ conductor (𝓞 K) x ≤ P) :
    (Module.annihilator (𝓞 L) Ω[(𝓞 L)⁄(𝓞 K)]).map
        (algebraMap (𝓞 L) (Localization.AtPrime P)) =
      Ideal.span {(algebraMap (𝓞 L) (Localization.AtPrime P)
        (aeval x (derivative (minpoly (𝓞 K) x))))} := by
  obtain ⟨y, hyC, hyP⟩ := SetLike.not_le_iff_exists.mp hx
  set BP := Localization.AtPrime P with hBPdef
  have : Module.Finite (𝓞 K) (𝓞 L) := IsIntegralClosure.finite (𝓞 K) K L (𝓞 L)
  have : Algebra.FiniteType (𝓞 K) (𝓞 L) := Module.Finite.finiteType _
  have : IsScalarTower (𝓞 K) (𝓞 L) BP := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  -- the differentials of `𝒪_L` localise along `𝒪_L → (𝒪_L)_P`
  have hstep1 : (Module.annihilator (𝓞 L) Ω[(𝓞 L)⁄(𝓞 K)]).map (algebraMap (𝓞 L) BP)
      = Module.annihilator BP Ω[BP⁄(𝓞 K)] :=
    (KaehlerDifferential.annihilator_eq_map_of_isLocalization_top
      (𝓞 K) (𝓞 L) BP P.primeCompl).symm
  -- the monogenic subring `𝒪_K[x]`
  have hxint : IsIntegral (𝓞 K) x := IsIntegral.of_finite (𝓞 K) x
  set Rx := Algebra.adjoin (𝓞 K) ({x} : Set (𝓞 L)) with hRxdef
  have hxmem : x ∈ Rx := Algebra.self_mem_adjoin_singleton (𝓞 K) x
  set x' : Rx := ⟨x, hxmem⟩ with hx'def
  have hinjR : Function.Injective (algebraMap Rx (𝓞 L)) := Subtype.coe_injective
  have hgenR : Algebra.adjoin (𝓞 K) ({x'} : Set Rx) = ⊤ := by
    have h := (Algebra.adjoin.powerBasis' hxint).adjoin_gen_eq_top
    rwa [Algebra.adjoin.powerBasis'_gen] at h
  have : Module.Finite (𝓞 K) Rx :=
    Module.Finite.of_basis (Algebra.adjoin.powerBasis' hxint).basis
  have : Algebra.FiniteType (𝓞 K) Rx := Module.Finite.finiteType _
  have hx'int : IsIntegral (𝓞 K) x' := IsIntegral.of_finite (𝓞 K) x'
  have : Module.IsTorsionFree (𝓞 K) Rx :=
    Function.Injective.moduleIsTorsionFree (N := 𝓞 L) (algebraMap Rx (𝓞 L)) hinjR
      fun r z ↦ map_smul (IsScalarTower.toAlgHom (𝓞 K) Rx (𝓞 L)) r z
  -- the prime of `𝒪_K[x]` below `P`, and the localisation at it
  set q : Ideal Rx := P.comap (algebraMap Rx (𝓞 L)) with hqdef
  have : q.IsPrime := Ideal.IsPrime.comap (algebraMap Rx (𝓞 L))
  have : IsScalarTower Rx (𝓞 L) BP := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have : IsScalarTower (𝓞 K) Rx BP := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  have hlocq : IsLocalization q.primeCompl BP := by
    rw [_root_.isLocalization_iff]
    refine ⟨fun s ↦ ?_, fun z ↦ ?_, fun {a b} h ↦ ?_⟩
    · have hs : algebraMap Rx (𝓞 L) (s : Rx) ∉ P := s.2
      exact IsLocalization.map_units BP (⟨algebraMap Rx (𝓞 L) (s : Rx), hs⟩ : P.primeCompl)
    · obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj P.primeCompl z
      have hyb : y * b ∈ Rx := mem_conductor_iff.mp hyC b
      have hys : y * (s : 𝓞 L) ∈ Rx := mem_conductor_iff.mp hyC _
      have hysq : (⟨y * (s : 𝓞 L), hys⟩ : Rx) ∈ q.primeCompl := by
        change (⟨y * (s : 𝓞 L), hys⟩ : Rx) ∉ q
        intro hmem
        have hmem' : y * (s : 𝓞 L) ∈ P := hmem
        rcases Ideal.IsPrime.mem_or_mem ‹P.IsPrime› hmem' with h | h
        · exact hyP h
        · exact s.2 h
      refine ⟨(⟨y * b, hyb⟩, ⟨⟨y * (s : 𝓞 L), hys⟩, hysq⟩), ?_⟩
      change z * algebraMap (𝓞 L) BP (y * (s : 𝓞 L)) = algebraMap (𝓞 L) BP (y * b)
      rw [map_mul, map_mul,
        show z * (algebraMap (𝓞 L) BP y * algebraMap (𝓞 L) BP (s : 𝓞 L))
          = algebraMap (𝓞 L) BP y * (z * algebraMap (𝓞 L) BP (s : 𝓞 L)) by ring, hbs]
    · refine ⟨1, ?_⟩
      have hinj : Function.Injective (algebraMap (𝓞 L) BP) :=
        IsLocalization.injective BP (M := P.primeCompl)
          (Ideal.primeCompl_le_nonZeroDivisors P)
      have : algebraMap Rx (𝓞 L) a = algebraMap Rx (𝓞 L) b := hinj h
      rw [hinjR this]
  -- the differentials of `𝒪_K[x]` localise along `𝒪_K[x] → (𝒪_L)_P`
  have hstep2 : Module.annihilator BP Ω[BP⁄(𝓞 K)]
      = (Module.annihilator Rx Ω[Rx⁄(𝓞 K)]).map (algebraMap Rx BP) :=
    KaehlerDifferential.annihilator_eq_map_of_isLocalization_top
      (𝓞 K) Rx BP q.primeCompl
  -- over `𝒪_K[x]` the annihilator is generated by `f'(x)`
  have hminp : minpoly (𝓞 K) x' = minpoly (𝓞 K) x := by
    have h := minpoly.algebraMap_eq (A := 𝓞 K) hinjR x'
    rw [show algebraMap Rx (𝓞 L) x' = x from rfl] at h
    exact h.symm
  have hstep3 : Module.annihilator Rx Ω[Rx⁄(𝓞 K)]
      = Ideal.span {aeval x' (derivative (minpoly (𝓞 K) x'))} :=
    KaehlerDifferential.annihilator_eq_span_aeval_derivative_minpoly hx'int hgenR
  have hd : algebraMap Rx (𝓞 L) (aeval x' (derivative (minpoly (𝓞 K) x')))
      = aeval x (derivative (minpoly (𝓞 K) x)) := by
    rw [hminp]
    exact (Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom (𝓞 K) Rx (𝓞 L)) x'
      (derivative (minpoly (𝓞 K) x))).symm
  rw [hstep1, hstep2, hstep3, Ideal.map_span, Set.image_singleton]
  congr 1
  rw [show algebraMap Rx BP (aeval x' (derivative (minpoly (𝓞 K) x')))
      = algebraMap (𝓞 L) BP (algebraMap Rx (𝓞 L)
          (aeval x' (derivative (minpoly (𝓞 K) x')))) from rfl, hd]

/-- **The two differents agree at a prime with a local monogenic generator.** -/
theorem differentIdeal_map_eq_annihilator_map_of_conductor_not_le
    (P : Ideal (𝓞 L)) [P.IsPrime] {x : 𝓞 L} (hx : ¬ conductor (𝓞 K) x ≤ P) :
    (differentIdeal (𝓞 K) (𝓞 L)).map (algebraMap (𝓞 L) (Localization.AtPrime P)) =
      (Module.annihilator (𝓞 L) Ω[(𝓞 L)⁄(𝓞 K)]).map
        (algebraMap (𝓞 L) (Localization.AtPrime P)) := by
  rw [differentIdeal_map_atPrime_of_conductor_not_le K L P hx,
    annihilator_map_atPrime_of_conductor_not_le K L P hx]

/-- **The different is the annihilator of the differentials, given local monogenic generators.**
If every maximal ideal `P` of `𝒪_L` is coprime to the conductor of `𝒪_K[x]` for some `x` — that
is, if `(𝒪_L)_P` is a localisation of a monogenic subring `𝒪_K[x]` — then the different of
`𝒪_L/𝒪_K` is the annihilator of `Ω[𝒪_L⁄𝒪_K]`. -/
theorem differentIdeal_eq_annihilator_of_forall_exists_conductor_not_le
    (h : ∀ P : Ideal (𝓞 L), P.IsMaximal → ∃ x : 𝓞 L, ¬ conductor (𝓞 K) x ≤ P) :
    differentIdeal (𝓞 K) (𝓞 L) = Module.annihilator (𝓞 L) Ω[(𝓞 L)⁄(𝓞 K)] :=
  Ideal.eq_of_localization_maximal fun P hP ↦ by
    have := hP
    obtain ⟨x, hx⟩ := h P hP
    exact differentIdeal_map_eq_annihilator_map_of_conductor_not_le K L P hx

end NumberField

end

