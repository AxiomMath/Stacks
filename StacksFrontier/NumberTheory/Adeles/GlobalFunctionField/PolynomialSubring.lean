module

public import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
public import Mathlib.RingTheory.DedekindDomain.IntegralClosure
public import StacksFrontier.RingTheory.Nagata.Examples
public import StacksFrontier.RingTheory.Nagata.Universes
public import StacksFrontier.RingTheory.Nagata.Japanese

/-!
# The integral closure of `k[x]` in a function field

Let `k` be a field, `K` a field extension of `k`, and `x ∈ K` such that `K` is a finite extension
of `k(x)`. The integral closure `B` of `k[x]` in `K` is a finite `k[x]`-module (because `k[x]` is
a Nagata ring), and it is a Dedekind domain with fraction field `K`. No separability of `K` over
`k(x)` is needed.

## Main definitions

* `Stacks.Adeles.GlobalFunctionField.polySubalg` — the subalgebra `k[x] ⊆ K`.
* `Stacks.Adeles.GlobalFunctionField.intClosure` — the integral closure of `k[x]` in `K`.

## Main results

* `Stacks.Adeles.GlobalFunctionField.intClosure_finite` — it is a finite `k[x]`-module.
* `Stacks.Adeles.GlobalFunctionField.intClosure_isDedekindDomain` — it is a Dedekind domain.
* `Stacks.Adeles.GlobalFunctionField.intClosure_isFractionRing` — its fraction field is `K`.
-/

@[expose] public noncomputable section

open Polynomial IntermediateField IntermediateField.algebraAdjoinAdjoin

universe u

namespace Stacks.Adeles.GlobalFunctionField

variable (k : Type u) [Field k] {K : Type u} [Field K] [Algebra k K]

/-- The subalgebra `k[x] ⊆ K` generated by `x`. -/
public abbrev polySubalg (x : K) : Subalgebra k K := Algebra.adjoin k {x}

/-- The integral closure of `k[x]` in `K`. -/
public abbrev intClosure (x : K) : Subalgebra (polySubalg k x) K :=
  integralClosure (polySubalg k x) K

variable {k}

/-- Evaluation at `x`, as a surjection `k[X] → k[x]`. -/
public def polySubalgMap (x : K) : k[X] →ₐ[k] polySubalg k x :=
  (aeval x).codRestrict _ fun _ => aeval_mem_adjoin_singleton k x

/-- The image of `p` under `polySubalgMap x` is the evaluation of `p` at `x`. -/
@[simp]
public theorem coe_polySubalgMap (x : K) (p : k[X]) : (polySubalgMap x p : K) = aeval x p := rfl

/-- Evaluation at `x` maps `k[X]` onto `k[x]`. -/
public theorem polySubalgMap_surjective (x : K) :
    Function.Surjective (polySubalgMap (k := k) x) := by
  rintro ⟨y, hy⟩
  rw [polySubalg, Algebra.adjoin_singleton_eq_range_aeval] at hy
  obtain ⟨p, rfl⟩ := hy
  exact ⟨p, rfl⟩

/-- For transcendental `x`, evaluation at `x` is injective on `k[X]`. -/
public theorem polySubalgMap_injective {x : K} (hx : Transcendental k x) :
    Function.Injective (polySubalgMap (k := k) x) := fun _ _ h =>
  (transcendental_iff_injective.1 hx) (congrArg Subtype.val h)

/-- For transcendental `x`, evaluation at `x` is an isomorphism `k[X] ≃ k[x]`. -/
public def polySubalgEquiv {x : K} (hx : Transcendental k x) : k[X] ≃ₐ[k] polySubalg k x :=
  AlgEquiv.ofBijective (polySubalgMap x) ⟨polySubalgMap_injective hx, polySubalgMap_surjective x⟩

/-- The isomorphism `polySubalgEquiv hx` is evaluation at `x`. -/
@[simp]
public theorem polySubalgEquiv_apply {x : K} (hx : Transcendental k x) (p : k[X]) :
    polySubalgEquiv hx p = polySubalgMap x p := rfl

/-- `k[x]` is a principal ideal ring, being a quotient of `k[X]`. -/
public instance (x : K) : IsPrincipalIdealRing (polySubalg k x) :=
  IsPrincipalIdealRing.of_surjective (polySubalgMap x) (polySubalgMap_surjective x)

/-- `k[x]` is of finite type over `k`, being generated by `x`. -/
public instance (x : K) : Algebra.FiniteType k (polySubalg k x) :=
  ⟨(Subalgebra.fg_top _).2 (by simpa using Subalgebra.fg_adjoin_finset (R := k) {x})⟩

/-- `k[x]` is a Noetherian ring. -/
public instance (x : K) : IsNoetherianRing (polySubalg k x) :=
  Algebra.FiniteType.isNoetherianRing k _

/-- `k[x]` is a Dedekind domain. -/
public instance (x : K) : IsDedekindDomain (polySubalg k x) := inferInstance

/-- `k[x]` is Japanese (N-2): it is of finite type over the field `k`, hence Nagata. -/
public theorem polySubalg_isJapaneseRing (x : K) : IsJapaneseRing (polySubalg k x) := by
  have hN : IsNagataRing (polySubalg k x) :=
    IsNagataRing.of_finiteType (IsNagataRing.of_field (K := k))
  have : (⊥ : Ideal (polySubalg k x)).IsPrime := Ideal.isPrime_bot
  exact IsJapaneseRing.of_ringEquiv (RingEquiv.quotientBot _) (hN.isJapaneseRing_quotient ⊥)

variable (x : K) [FiniteDimensional k⟮x⟯ K]

/-- The integral closure of `k[x]` in `K` is a finite `k[x]`-module. -/
public instance intClosure_finite : Module.Finite (polySubalg k x) (intClosure k x) := by
  have hJ := polySubalg_isJapaneseRing (k := k) x
  exact isN2_apply_of_isFractionRing (polySubalg k x)
    (fun L _ _ _ _ _ => IsJapaneseRing.finite L) k⟮x⟯ K

set_option synthInstance.maxHeartbeats 80000 in
-- Lean v4.35.0: instance search here unfolds the `Subalgebra` carriers of `polySubalg k x`
-- and exceeds the default budget.
/-- The fraction field of the integral closure of `k[x]` in `K` is `K`. -/
public instance intClosure_isFractionRing : IsFractionRing (intClosure k x) K :=
  IsIntegralClosure.isFractionRing_of_finite_extension (polySubalg k x) k⟮x⟯ K (intClosure k x)

set_option synthInstance.maxHeartbeats 80000 in
-- Lean v4.35.0: instance search here unfolds the `Subalgebra` carriers of `polySubalg k x`
-- and exceeds the default budget.
/-- The integral closure of `k[x]` in `K` is a Noetherian ring. -/
public instance intClosure_isNoetherianRing : IsNoetherianRing (intClosure k x) := by
  have := intClosure_finite (k := k) x
  have : IsNoetherian (polySubalg k x) (intClosure k x) := inferInstance
  exact isNoetherianRing_iff.mpr (isNoetherian_of_tower (polySubalg k x) this)

set_option synthInstance.maxHeartbeats 80000 in
-- Lean v4.35.0: instance search here unfolds the `Subalgebra` carriers of `polySubalg k x`
-- and exceeds the default budget.
/-- The integral closure of `k[x]` in `K` is a Dedekind domain. -/
public instance intClosure_isDedekindDomain : IsDedekindDomain (intClosure k x) :=
  have : IsFractionRing (intClosure k x) K := intClosure_isFractionRing x
  have : Algebra.IsIntegral (polySubalg k x) (intClosure k x) :=
    IsIntegralClosure.isIntegral_algebra (polySubalg k x) K
  { intClosure_isNoetherianRing x,
    Ring.DimensionLEOne.of_isIntegral (polySubalg k x) (intClosure k x),
    (isIntegrallyClosed_iff K).mpr fun {y} hy =>
      ⟨IsIntegralClosure.mk' (intClosure k x) y (isIntegral_trans (R := polySubalg k x) _ hy),
        IsIntegralClosure.algebraMap_mk' _ _ _⟩ with : IsDedekindDomain (intClosure k x) }

end Stacks.Adeles.GlobalFunctionField

end
