module

public import Mathlib.Data.Nat.Totient
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.Tactic.LinearCombination
public import Mathlib.Tactic.Linarith

/-!
# Functions on a group that are symmetric under coprime powers and average to a constant

Let `n` be an integer valued function on a group `Γ`, and `c` an integer. Suppose that for every
element `θ` of finite order `d`

* `n (θ ^ b) = n θ` for every `b` prime to `d`, and
* `∑_{i < d} n (θ ^ i) = d c`.

Then `n θ = c` for every element `θ` of finite order. By induction on `d`, the terms of the sum at
the non-generators `θ ^ i` of `⟨θ⟩` are `c`, and the `φ(d)` terms at the generators are all equal
to `n θ`.

This is the counting step in the computation of the Euler characteristic of a sheaf of rank one
and finite order prime to `ℓ` on a curve. Here `Γ` is a group of characters `θ`, and `n θ` is the
Euler characteristic of the sheaf of `θ` (or of its induced representation). The Riemann–Hurwitz
formula computes the sum over the characters of the cyclic group generated by `θ`, which is the
Euler characteristic of the cyclic cover cut out by `θ`. The rationality of L-functions over
cyclotomic integers gives the symmetry under coprime powers
(`Stacks.Drinfeld.sub_eq_of_hasRationalApprox_map`).

## Main results

* `Stacks.Drinfeld.eq_of_forall_sum_pow_eq`: such a function is constant, equal to `c`, on the
  elements of finite order.
-/

@[expose] public noncomputable section

open Finset

namespace Stacks.Drinfeld

/-- **A function symmetric under coprime powers whose sums over cyclic subgroups are `d c` is
constant.** Let `n : Γ → ℤ` and `c : ℤ` be such that for every `θ` of finite order `d`,
`n (θ ^ b) = n θ` for `b` prime to `d` and `∑_{i < d} n (θ ^ i) = d c`. Then `n θ = c` for
every `θ` of finite order. -/
theorem eq_of_forall_sum_pow_eq {Γ : Type*} [Group Γ] (n : Γ → ℤ) (c : ℤ)
    (hM : ∀ θ : Γ, IsOfFinOrder θ →
      ∑ i ∈ range (orderOf θ), n (θ ^ i) = orderOf θ * c)
    (hS : ∀ θ : Γ, IsOfFinOrder θ → ∀ b : ℕ, (orderOf θ).Coprime b → n (θ ^ b) = n θ)
    (θ : Γ) (hθ : IsOfFinOrder θ) : n θ = c := by
  suffices H : ∀ d, ∀ θ : Γ, IsOfFinOrder θ → orderOf θ = d → n θ = c from H _ θ hθ rfl
  intro d
  induction d using Nat.strong_induction_on with
  | _ d ih =>
  intro θ hθ h
  have hd : 0 < d := h ▸ hθ.orderOf_pos
  have key := hM θ hθ
  rw [h, ← sum_filter_add_sum_filter_not (range d) d.Coprime] at key
  have h1 : ∑ i ∈ range d with d.Coprime i, n (θ ^ i) = (Nat.totient d : ℤ) * n θ := by
    rw [sum_congr rfl fun i hi => hS θ hθ i (h ▸ (mem_filter.1 hi).2), sum_const,
      nsmul_eq_mul, Nat.totient_eq_card_coprime]
  have hlt : ∀ i ∈ range d, ¬ d.Coprime i → orderOf (θ ^ i) < d := by
    intro i _ hi
    rcases Nat.eq_zero_or_pos i with rfl | hi0
    · rw [pow_zero, orderOf_one]
      by_contra hle
      have : d = 1 := by omega
      exact hi (this ▸ Nat.coprime_one_left 0)
    · rw [orderOf_pow' θ hi0.ne', h]
      have hg : 1 < d.gcd i := by
        have := Nat.gcd_pos_of_pos_left i hd
        rw [Nat.Coprime] at hi
        omega
      exact Nat.div_lt_self hd hg
  have h2 : ∑ i ∈ range d with ¬ d.Coprime i, n (θ ^ i) =
      ((#{i ∈ range d | ¬ d.Coprime i} : ℕ) : ℤ) * c := by
    rw [sum_congr rfl fun i hi =>
      ih _ (hlt i (mem_filter.1 hi).1 (mem_filter.1 hi).2) (θ ^ i) hθ.pow rfl, sum_const,
      nsmul_eq_mul]
  have hcard : #{i ∈ range d | d.Coprime i} + #{i ∈ range d | ¬ d.Coprime i} = d := by
    rw [card_filter_add_card_filter_not, card_range]
  rw [h1, h2] at key
  rw [← Nat.totient_eq_card_coprime] at hcard
  have htot : (0 : ℤ) < Nat.totient d := by exact_mod_cast Nat.totient_pos.2 hd
  have : (Nat.totient d : ℤ) * (n θ - c) = 0 := by
    have hc : ((#{i ∈ range d | ¬ d.Coprime i} : ℕ) : ℤ) = d - Nat.totient d := by
      omega
    rw [hc] at key
    linear_combination key
  rcases mul_eq_zero.1 this with h0 | h0
  · exact absurd h0 htot.ne'
  · linarith

end Stacks.Drinfeld

end
