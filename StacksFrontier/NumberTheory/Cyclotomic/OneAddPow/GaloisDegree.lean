module

public import StacksFrontier.NumberTheory.Cyclotomic.OneAddPow.QuotientPolynomial

@[expose] public section

set_option backward.isDefEq.respectTransparency false

open Polynomial

/-! ### Ramification of a mixed-characteristic cyclotomic extension

Let `A` be a discrete valuation ring of mixed characteristic `(0, p)` containing a primitive
`p`-th root of unity. If `P` is the cyclotomic quotient polynomial above, then an extension
generated by a root of `P(z) = ξ` is Galois. It is either trivial, unramified of degree `p`,
totally ramified with ramification index `p`, or weakly unramified with a purely inseparable
residue extension of degree `p`; the valuation of `ξ` distinguishes these alternatives. The
ramification alternatives are expressed using the integral closure of `A` in the extension,
its maximal ideals, and their residue fields; the assertion that the extension is generated by
a root is represented by `Algebra.adjoin K {z} = ⊤`, and triviality by surjectivity of the
structure map.

* [Stacks Project, Tag 09F3](https://stacks.math.columbia.edu/tag/09F3)
-/

section CyclotomicQuotientRamification

open scoped IntermediateField

attribute [local instance] FractionRing.liftAlgebra
attribute [local instance] Ideal.Quotient.field

universe uA uK uL

private theorem unramified_or_trivial_of_separable_reduction
    (A : Type uA) (K : Type uK) (L : Type uL)
    [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
    [Field K] [Algebra A K] [IsFractionRing A K]
    [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    [FiniteDimensional K L] [IsGalois K L]
    (p : ℕ) (hp : p.Prime) (Q : Polynomial A) (hQm : Q.Monic)
    (hQsep : (Q.map (IsLocalRing.residue A)).Separable)
    (z : L) (hz : Polynomial.aeval z Q = 0)
    (hgen : Algebra.adjoin K {z} = ⊤)
    (hdegree : Module.finrank K L ∣ p) :
    Function.Surjective (algebraMap K L) ∨
      (Module.finrank K L = p ∧
        ∀ m : Ideal (integralClosure A L), m.IsMaximal →
          ∃ _ : m.LiesOver (IsLocalRing.maximalIdeal A),
            Ideal.ramificationIdx' (IsLocalRing.maximalIdeal A) m = 1 ∧
              @Algebra.IsSeparable
                (A ⧸ IsLocalRing.maximalIdeal A)
                ((integralClosure A L) ⧸ m) _ _
                (Ideal.Quotient.algebraOfLiesOver m (IsLocalRing.maximalIdeal A))) := by
  let B := integralClosure A L
  let mA := IsLocalRing.maximalIdeal A
  have hAK : Function.Injective (algebraMap A K) := IsFractionRing.injective A K
  have hAL : Function.Injective (algebraMap A L) := by
    rw [IsScalarTower.algebraMap_eq A K L]
    exact (algebraMap K L).injective.comp hAK
  let : Module.IsTorsionFree A L :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr hAL
  let : Module.Finite A B := IsIntegralClosure.finite A K L B
  let : IsDedekindDomain B := integralClosure.isDedekindDomain A K L
  let : Algebra.IsIntegral A B := IsIntegralClosure.isIntegral_algebra A L
  have hcase := hp.eq_one_or_self_of_dvd (Module.finrank K L) hdegree
  rcases hcase with htriv | hprime
  · left
    exact (Algebra.finrank_eq_one_iff_bijective_algebraMap.mp htriv).2
  · right
    refine ⟨hprime, ?_⟩
    intro m hm
    let : m.IsPrime := hm.isPrime
    have hunder : m.under A = mA := (IsLocalRing.isMaximal_iff A).mp
      (Ideal.isMaximal_under_of_isIntegral_of_isMaximal (R := A) m)
    have hOver : m.LiesOver mA := ⟨hunder.symm⟩
    have hm0 : m ≠ ⊥ :=
      Ideal.ne_bot_of_liesOver_of_ne_bot (IsDiscreteValuationRing.not_a_field A) m
    have hint : IsIntegral A z := ⟨Q, hQm, hz⟩
    have hsepmin : Polynomial.Separable
        ((minpoly A z).map (Ideal.Quotient.mk (m.under A))) := by
      have hdvd : minpoly A z ∣ Q := minpoly.isIntegrallyClosed_dvd hint hz
      have hsep : (Q.map (Ideal.Quotient.mk (m.under A))).Separable := by rwa [hunder]
      exact hsep.of_dvd (Polynomial.map_dvd _ hdvd)
    have hunr : Algebra.IsUnramifiedAt A m :=
      IsDiscreteValuationRing.unramified_of_separable_minpoly A K L B m hm0 z hint hgen hsepmin
    refine ⟨hOver, ?_, ?_⟩
    · rw [Ideal.ramificationIdx'_eq_ramificationIdx mA m
        (IsDiscreteValuationRing.not_a_field A)]
      exact m.ramificationIdx_eq_one A
    · let : Algebra (Localization.AtPrime mA) (Localization.AtPrime m) :=
        Localization.AtPrime.algebraOfLiesOver mA m
      exact (Algebra.isSeparable_residueField_iff).mp inferInstance

private theorem monic_cyclotomic_quotient {A : Type*} [CommRing A] [IsDomain A] {p : ℕ}
    [Fact p.Prime] (f : CyclotomicRing p ℤ ℚ →+* A) (P : Polynomial A)
    (hP : intProp f P) : P.Monic := by
  rcases hP with ⟨_, hdeg, _, hcoeff⟩
  have hc : P.coeff p = 1 := by simpa using hcoeff p (Fact.out : p.Prime).pos le_rfl
  have hd : P.natDegree = p :=
    le_antisymm hdeg (Polynomial.le_natDegree_of_ne_zero (by simp [hc]))
  simpa [Polynomial.Monic, Polynomial.leadingCoeff, hd] using hc

private theorem cyclotomic_image_primitive
    (A K : Type*) [CommRing A] [IsDomain A]
    [Field K] [Algebra A K] [CharZero K]
    (p : ℕ) [Fact p.Prime]
    (f : CyclotomicRing p ℤ ℚ →+* A) :
    IsPrimitiveRoot (algebraMap A K (zetaA f)) p := by
  let ζ : K := algebraMap A K (zetaA f)
  have hs : ∑ i ∈ Finset.range p, ζ ^ i = 0 := by
    simpa [ζ, map_sum, map_pow] using congrArg (algebraMap A K) (zetaA_geom_sum_eq_zero f)
  have hne : ζ ≠ 1 := by
    intro heq
    have hcast : (p : K) = 0 := by simpa only [heq, one_pow, Finset.sum_const,
      Finset.card_range, nsmul_eq_mul, mul_one] using hs
    exact (Nat.cast_ne_zero.mpr (Fact.out : p.Prime).ne_zero) hcast
  have hgen : IsPrimitiveRoot (zetaGen (p := p)) p :=
    IsCyclotomicExtension.zeta_spec p ℤ _
  have hpgen : (zetaGen (p := p)) ^ p = 1 := hgen.pow_eq_one
  have hpow : ζ ^ p = 1 := by
    simpa [ζ, zetaA, map_pow] using
      congrArg (fun t : CyclotomicRing p ℤ ℚ => algebraMap A K (f t)) hpgen
  exact isPrimitiveRoot_of_mem_nthRootsFinset (Fact.out : p.Prime)
    ((Polynomial.mem_nthRootsFinset (Fact.out : p.Prime).pos 1).2 hpow) hne

private theorem residue_wElt_eq_zero
    (A K : Type*) [CommRing A] [IsDomain A] [IsLocalRing A]
    [Field K] [Algebra A K] [IsFractionRing A K] [CharZero K]
    (p : ℕ) [Fact p.Prime]
    [CharP (IsLocalRing.ResidueField A) p]
    (f : CyclotomicRing p ℤ ℚ →+* A) :
    IsLocalRing.residue A (wElt f) = 0 := by
  have hpowK := (cyclotomic_image_primitive A K p f).pow_eq_one
  have hpowA : (zetaA f) ^ p = 1 := by
    apply IsFractionRing.injective A K
    simpa using hpowK
  have hpowRes : (IsLocalRing.residue A (zetaA f)) ^ p = 1 := by
    simpa only [map_pow, map_one] using congrArg (IsLocalRing.residue A) hpowA
  have hres : IsLocalRing.residue A (zetaA f) = 1 := by
    have hzero : (IsLocalRing.residue A (zetaA f) - 1) ^ p = 0 := by
      rw [sub_pow_char, hpowRes, one_pow, sub_self]
    by_contra h
    exact (pow_ne_zero p (sub_ne_zero.mpr h)) hzero
  simp [wElt, map_sub, hres]

private theorem map_residue_cyclotomic_quotient
    (A K : Type*) [CommRing A] [IsDomain A] [IsLocalRing A]
    [Field K] [Algebra A K] [IsFractionRing A K] [CharZero K]
    (p : ℕ) [Fact p.Prime]
    [CharP (IsLocalRing.ResidueField A) p]
    (f : CyclotomicRing p ℤ ℚ →+* A) (P : Polynomial A)
    (hP : shapeProp f P) :
    P.map (IsLocalRing.residue A) =
      (Polynomial.X : Polynomial (IsLocalRing.ResidueField A)) ^ p - Polynomial.X := by
  obtain ⟨a, ha, hshape⟩ := hP
  have haw : ∀ i, 0 < i → i < p → IsLocalRing.residue A (a i) = 0 := by
    intro i hi hip
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp (ha i hi hip)
    rw [hc, map_mul, residue_wElt_eq_zero A K p f, zero_mul]
  rw [hshape]
  simp only [Polynomial.map_add, Polynomial.map_sub, Polynomial.map_pow,
    Polynomial.map_X, Polynomial.map_sum, Polynomial.map_mul, Polynomial.map_C]
  have hsum :
      (∑ i ∈ Finset.Ioo 0 p,
        Polynomial.C (IsLocalRing.residue A (a i)) *
          (Polynomial.X : Polynomial (IsLocalRing.ResidueField A)) ^ i) = 0 := by
    apply Finset.sum_eq_zero
    intro i hi
    have ⟨hi0, hip⟩ := Finset.mem_Ioo.mp hi
    simp [haw i hi0 hip]
  rw [hsum, add_zero]

private theorem cyclotomic_root_pow
    (A K L : Type*) [CommRing A] [IsDomain A]
    [Field K] [Algebra A K]
    [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    (p : ℕ) [Fact p.Prime]
    (f : CyclotomicRing p ℤ ℚ →+* A) (P : Polynomial A)
    (hP : intProp f P) (ξ : K) (z : L)
    (hz : Polynomial.aeval z P = algebraMap K L ξ) :
    (1 + algebraMap A L (wElt f) * z) ^ p =
      algebraMap K L (1 + (algebraMap A K (wElt f)) ^ p * ξ) := by
  have h := congrArg (Polynomial.aeval z) hP.1
  simp only [map_mul, map_pow, map_sub, map_add, map_one,
    Polynomial.aeval_C, Polynomial.aeval_X] at h
  rw [hz] at h
  rw [map_add, map_one, map_mul, map_pow, ← IsScalarTower.algebraMap_apply A K L]
  linear_combination -h

private theorem cyclotomic_affine_generator
    (A K L : Type*) [CommRing A] [IsDomain A]
    [Field K] [Algebra A K] [CharZero K]
    [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    (p : ℕ) [Fact p.Prime]
    (f : CyclotomicRing p ℤ ℚ →+* A) (z : L)
    (hgen : Algebra.adjoin K {z} = ⊤) :
    Algebra.adjoin K {1 + algebraMap A L (wElt f) * z} = ⊤ := by
  let wK : K := algebraMap A K (wElt f)
  let wL : L := algebraMap K L wK
  let b : L := 1 + wL * z
  have hζ := cyclotomic_image_primitive A K p f
  have hwK : wK ≠ 0 := by
    dsimp [wK, wElt]
    rw [map_sub, map_one]
    exact sub_ne_zero.mpr (Ne.symm (hζ.ne_one (Fact.out : p.Prime).one_lt))
  have hwL : wL ≠ 0 := by
    simpa [wL] using (algebraMap K L).injective.ne hwK
  let S := Algebra.adjoin K {b}
  have hb : b ∈ S := Algebra.subset_adjoin (Set.mem_singleton b)
  have hwi : wL⁻¹ ∈ S := by
    dsimp [wL]
    rw [← map_inv₀ (algebraMap K L) wK]
    exact S.algebraMap_mem (wK⁻¹)
  have hzexpr : z = wL⁻¹ * (b - 1) := by
    dsimp [b]
    field_simp [hwL]
    ring
  have hzS : z ∈ S := by
    rw [hzexpr]
    exact S.mul_mem hwi (S.sub_mem hb S.one_mem)
  have hle : Algebra.adjoin K {z} ≤ S := Algebra.adjoin_le (by simpa using hzS)
  rw [hgen] at hle
  rw [IsScalarTower.algebraMap_apply A K L (wElt f)]
  exact eq_top_iff.mpr hle

open Stacks.FieldTheory.KummerExtension in
/-- A field generated by a root of the cyclotomic quotient polynomial is Galois, and its
degree divides the residue-characteristic prime `p`. -/
theorem cyclotomic_galois_and_degree
    (A K L : Type*) [CommRing A] [IsDomain A]
    [Field K] [Algebra A K] [IsFractionRing A K] [CharZero K]
    [Field L] [Algebra K L] [Algebra A L] [IsScalarTower A K L]
    (p : ℕ) [Fact p.Prime]
    (f : CyclotomicRing p ℤ ℚ →+* A) (P : Polynomial A)
    (hP : intProp f P) (ξ : K) (z : L)
    (hz : Polynomial.aeval z P = algebraMap K L ξ)
    (hgen : Algebra.adjoin K {z} = ⊤) :
    ∃ hfin : Module.Finite K L,
      letI := hfin
      IsGalois K L ∧ Module.finrank K L ∣ p := by
  let ζ : K := algebraMap A K (zetaA f)
  let b : L := 1 + algebraMap A L (wElt f) * z
  have hprim : IsPrimitiveRoot ζ p := cyclotomic_image_primitive A K p f
  have hpow : b ^ p ∈ Set.range (algebraMap K L) :=
    ⟨_, (cyclotomic_root_pow A K L p f P hP ξ z hz).symm⟩
  have hgenb : Algebra.adjoin K {b} = ⊤ :=
    cyclotomic_affine_generator A K L p f z hgen
  rcases isGalois_isCyclic_finrank_dvd_and_kummerCharacter_injective_of_adjoin_root_eq_top
      K L p (Fact.out : p.Prime).two_le ζ hprim b hpow hgenb with
    ⟨hfin, hg, _, hdvd, _⟩
  exact ⟨hfin, hg, hdvd⟩

end CyclotomicQuotientRamification
