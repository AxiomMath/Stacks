module

public import StacksFrontier.NumberTheory.DifferentAnnihilatorLocal
public import StacksFrontier.RingTheory.Kaehler.DedekindAnnihilator

/-!
# A monogenic subring that agrees with `𝒪_L` at one prime

Let `L/K` be an extension of number fields, let `P` be a maximal ideal of `𝒪_L` and let
`x : 𝒪_L`. Suppose that

* `𝒪_K[x]` surjects onto the residue field `𝒪_L/P`;
* `𝒪_K[x]` contains an element of `P` that is not in `P²`;
* every nonzero prime of `𝒪_L` other than `P` contains an element of `𝒪_K[x]` outside `P`.

Then the conductor of `𝒪_K[x]` in `𝒪_L` is not contained in `P`; equivalently `𝒪_K[x]` and
`𝒪_L` have the same localisation at `P`.

## Main results

* `Ideal.le_span_singleton_sup_sq_of_notMem_sq`: an element of a nonzero prime `P` of a Dedekind
  domain which is not in `P²` generates `P` modulo `P²`.
* `NumberField.not_conductor_le_of_residue_surjective`: the statement above.

## Implementation notes

The three hypotheses are exactly what the Nakayama argument consumes. Write `R = 𝒪_K[x]` and
`q = P ∩ R`. The third hypothesis says that every nonzero prime of `𝒪_L` except `P` meets the
image of `R \ q`, so the localisation `C` of `𝒪_L` at that image has `P` as its only maximal
ideal and is therefore the localisation of `𝒪_L` at `P`; this is where the finitely many primes
above `P ∩ 𝒪_K` are disposed of, and it is the step that fails for the naive localisation of the
base, where the other primes above `P ∩ 𝒪_K` survive. The second hypothesis makes the maximal
ideal of `C` generated by an element of `q`, and the first makes `R` surject onto the residue
field of `C`; Nakayama then gives `R_q = C`, and clearing a denominator for a finite generating
set of `𝒪_L` over `R` produces an element of the conductor outside `P`.

No Stacks tag is registered: the hypotheses are on `x`, not those of Tag 024Z.

## References

* [Stacks Project, Tag 024Z](https://stacks.math.columbia.edu/tag/024Z)
-/

@[expose] public section

open NumberField Polynomial

universe u

noncomputable section

/-- **An element of a prime but not of its square generates the prime modulo the square.** For a
maximal ideal `P` of a Dedekind domain and `u ∈ P \ P²` one has `P ≤ (u) + P²`: writing a `π` with
`P ≤ (π) + P²` as `u = cπ + d` with `d ∈ P²`, the coefficient `c` is not in `P`, hence invertible
modulo `P`, and an inverse of `c` carries `u` back to `π` modulo `P²`. -/
theorem Ideal.le_span_singleton_sup_sq_of_notMem_sq {B : Type*} [CommRing B] [IsDedekindDomain B]
    (P : Ideal B) [hP : P.IsMaximal] {u : B} (hu : u ∈ P) (hu2 : u ∉ P ^ 2) :
    P ≤ Ideal.span {u} ⊔ P ^ 2 := by
  have : P.IsPrime := hP.isPrime
  obtain ⟨π, hπP, hπ⟩ := IsDedekindDomain.exists_mem_le_span_singleton_sup_sq P
  have hmul : ∀ a ∈ P, a * π ∈ P ^ 2 := fun a ha ↦ by
    rw [sq]
    exact Ideal.mul_mem_mul ha hπP
  -- write `u = c * π + d` with `d ∈ P²`
  obtain ⟨a, ha, d, hd, hadu⟩ := Submodule.mem_sup.mp (hπ hu)
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha
  have hcP : c ∉ P := fun hcP ↦ hu2 (hadu ▸ Ideal.add_mem _ (hmul c hcP) hd)
  -- invert `c` modulo `P`
  obtain ⟨y, e, he, hye⟩ := hP.exists_inv hcP
  have hπmem : π ∈ Ideal.span {u} ⊔ P ^ 2 := by
    have hkey : π = y * u + (e * π - y * d) := by
      rw [← hadu]
      linear_combination (-π) * hye
    refine hkey ▸ Ideal.add_mem _ (Ideal.mem_sup_left (Ideal.mem_span_singleton'.mpr ⟨y, rfl⟩))
      (Ideal.mem_sup_right (Ideal.sub_mem _ (hmul e he) (Ideal.mul_mem_left _ _ hd)))
  exact hπ.trans (sup_le (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hπmem)) le_sup_right)

namespace NumberField

attribute [local instance] FractionRing.liftAlgebra

variable (K L : Type u) [Field K] [Field L] [NumberField K] [NumberField L] [Algebra K L]

/-- **A monogenic subring with the three local properties has conductor coprime to `P`.** -/
theorem not_conductor_le_of_residue_surjective
    (P : Ideal (𝓞 L)) [hPmax : P.IsMaximal] {x : 𝓞 L}
    (h1 : ∀ b : 𝓞 L, ∃ r ∈ Algebra.adjoin (𝓞 K) ({x} : Set (𝓞 L)), b - r ∈ P)
    (h2 : ∃ u ∈ Algebra.adjoin (𝓞 K) ({x} : Set (𝓞 L)), u ∈ P ∧ u ∉ P ^ 2)
    (h3 : ∀ P' : Ideal (𝓞 L), P'.IsPrime → P' ≠ ⊥ → P' ≠ P →
      ∃ w ∈ Algebra.adjoin (𝓞 K) ({x} : Set (𝓞 L)), w ∉ P ∧ w ∈ P') :
    ¬ conductor (𝓞 K) x ≤ P := by
  classical
  have : Module.Finite (𝓞 K) (𝓞 L) := IsIntegralClosure.finite (𝓞 K) K L (𝓞 L)
  set Rx := Algebra.adjoin (𝓞 K) ({x} : Set (𝓞 L)) with hRxdef
  set q : Ideal Rx := P.comap (algebraMap Rx (𝓞 L)) with hqdef
  have : q.IsPrime := Ideal.IsPrime.comap (algebraMap Rx (𝓞 L))
  set W : Submonoid (𝓞 L) := Algebra.algebraMapSubmonoid (𝓞 L) q.primeCompl with hWdef
  have hWle : W ≤ P.primeCompl := by
    rintro _ ⟨z, hz, rfl⟩
    exact hz
  set C := Localization W with hCdef
  -- every element outside `P` is a unit in `C`
  have hunit : ∀ s ∈ P.primeCompl, IsUnit (algebraMap (𝓞 L) C s) := by
    intro s hs
    by_contra hns
    have hne : Ideal.span {algebraMap (𝓞 L) C s} ≠ ⊤ := fun h ↦
      hns (Ideal.span_singleton_eq_top.mp h)
    obtain ⟨m, hm, hle⟩ := Ideal.exists_le_maximal _ hne
    have := hm
    have hsP' : s ∈ m.comap (algebraMap (𝓞 L) C) :=
      hle (Ideal.mem_span_singleton_self _)
    have hs0 : s ≠ 0 := fun h ↦ hs (h ▸ P.zero_mem)
    have : (m.comap (algebraMap (𝓞 L) C)).IsPrime := Ideal.IsPrime.comap _
    have hbot : m.comap (algebraMap (𝓞 L) C) ≠ ⊥ := fun h ↦ hs0 (by simpa [h] using hsP')
    have hneP : m.comap (algebraMap (𝓞 L) C) ≠ P := fun h ↦ hs (h ▸ hsP')
    obtain ⟨w, hwR, hwP, hwP'⟩ := h3 _ inferInstance hbot hneP
    have hwW : w ∈ W := ⟨⟨w, hwR⟩, hwP, rfl⟩
    exact hm.ne_top (Ideal.eq_top_of_isUnit_mem m (Ideal.mem_comap.mp hwP')
      (IsLocalization.map_units C ⟨w, hwW⟩))
  have hlocC : IsLocalization.AtPrime C P := IsLocalization.of_le W P.primeCompl hWle hunit
  have : IsLocalRing C := IsLocalization.AtPrime.isLocalRing C P
  have : IsNoetherianRing C := IsLocalization.isNoetherianRing W C inferInstance
  have hmax : P.map (algebraMap (𝓞 L) C) = IsLocalRing.maximalIdeal C :=
    IsLocalization.AtPrime.map_eq_maximalIdeal P C
  -- the maximal ideal of `C` is generated by the chosen element of `P \ P²`
  obtain ⟨u, huR, huP, huP2⟩ := h2
  have hgen : P ≤ Ideal.span {u} ⊔ P ^ 2 :=
    Ideal.le_span_singleton_sup_sq_of_notMem_sq P huP huP2
  have hstep : IsLocalRing.maximalIdeal C ≤ Ideal.span {algebraMap (𝓞 L) C u} ⊔
      (IsLocalRing.maximalIdeal C) • (IsLocalRing.maximalIdeal C) := by
    rw [Ideal.smul_eq_mul, ← sq, ← hmax, ← Ideal.map_pow,
      show Ideal.span {algebraMap (𝓞 L) C u} = (Ideal.span {u}).map (algebraMap (𝓞 L) C) by
        rw [Ideal.map_span, Set.image_singleton],
      ← Ideal.map_sup]
    exact Ideal.map_mono hgen
  have huC : IsLocalRing.maximalIdeal C ≤ Ideal.span {algebraMap (𝓞 L) C u} :=
    Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian _)
      (IsLocalRing.maximalIdeal_le_jacobson ⊥) hstep
  -- the localisation of `𝒪_K[x]` at `q`, and the tower
  set Rq := Localization.AtPrime q with hRqdef
  have : IsScalarTower Rx (𝓞 L) C := IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  let : Algebra Rq C := _root_.localizationAlgebra q.primeCompl (𝓞 L)
  have : IsScalarTower Rx Rq C :=
    _root_.isScalarTower_localizationAlgebra q.primeCompl (𝓞 L)
  have : Module.Finite Rx (𝓞 L) := Module.Finite.of_restrictScalars_finite (𝓞 K) Rx (𝓞 L)
  have : Module.Finite Rq C := Module.Finite.of_isLocalization Rx (𝓞 L) q.primeCompl
  -- transport of elements of `Rx` into `Rq` and then into `C`
  have hcast : ∀ z : Rx, algebraMap Rq C (algebraMap Rx Rq z)
      = algebraMap (𝓞 L) C (algebraMap Rx (𝓞 L) z) := by
    intro z
    rw [← IsScalarTower.algebraMap_apply Rx Rq C, ← IsScalarTower.algebraMap_apply Rx (𝓞 L) C]
  -- the image of `P` is absorbed by the maximal ideal of `Rq`
  have humemq : algebraMap Rx Rq ⟨u, huR⟩ ∈ IsLocalRing.maximalIdeal Rq := by
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal q Rq]
    exact Ideal.mem_map_of_mem _ huP
  have hPC : ∀ e ∈ P, ∀ y : C, algebraMap (𝓞 L) C e * y ∈
      (IsLocalRing.maximalIdeal Rq) • (⊤ : Submodule Rq C) := by
    intro e he y
    obtain ⟨d, hd⟩ := Ideal.mem_span_singleton'.mp
      (huC (hmax ▸ Ideal.mem_map_of_mem (algebraMap (𝓞 L) C) he))
    have hrw : algebraMap (𝓞 L) C e * y = (algebraMap Rx Rq ⟨u, huR⟩) • (d * y) := by
      rw [Algebra.smul_def, hcast ⟨u, huR⟩,
        show algebraMap Rx (𝓞 L) (⟨u, huR⟩ : Rx) = u from rfl, ← hd]
      ring
    rw [hrw]
    exact Submodule.smul_mem_smul humemq Submodule.mem_top
  -- Nakayama: `Rq` surjects onto `C`
  have hNak : (⊤ : Submodule Rq C) ≤ (1 : Submodule Rq C) ⊔
      (IsLocalRing.maximalIdeal Rq) • ⊤ := by
    intro z _
    obtain ⟨⟨b, s⟩, hbs⟩ := IsLocalization.surj P.primeCompl z
    obtain ⟨c, e, he, hce⟩ := hPmax.exists_inv s.2
    obtain ⟨r, hrR, hr⟩ := h1 (b * c)
    have hone : algebraMap (𝓞 L) C c * algebraMap (𝓞 L) C (s : 𝓞 L)
        + algebraMap (𝓞 L) C e = 1 := by
      rw [← map_mul, ← map_add, hce, map_one]
    have hbs' : z * algebraMap (𝓞 L) C (s : 𝓞 L) = algebraMap (𝓞 L) C b := hbs
    have hbc : algebraMap (𝓞 L) C (b * c - r)
        = z * algebraMap (𝓞 L) C (s : 𝓞 L) * algebraMap (𝓞 L) C c
          - algebraMap (𝓞 L) C (algebraMap Rx (𝓞 L) ⟨r, hrR⟩) := by
      rw [map_sub, map_mul, hbs']
      rfl
    have hsplit : z = algebraMap (𝓞 L) C (algebraMap Rx (𝓞 L) ⟨r, hrR⟩)
        + (algebraMap (𝓞 L) C (b * c - r) * 1 + algebraMap (𝓞 L) C e * z) := by
      linear_combination (-1 : C) * hbc - z * hone
    rw [hsplit]
    exact Submodule.add_mem_sup (Submodule.mem_one.mpr ⟨algebraMap Rx Rq ⟨r, hrR⟩, hcast _⟩)
      (Submodule.add_mem _ (hPC _ hr 1) (hPC _ he z))
  have htop : (⊤ : Submodule Rq C) ≤ (1 : Submodule Rq C) :=
    Submodule.le_of_le_smul_of_le_jacobson_bot (Module.finite_def.mp inferInstance)
      (IsLocalRing.maximalIdeal_le_jacobson ⊥) hNak
  -- a denominator in `Rx \ q` for every element of `𝒪_L`
  have hinjC : Function.Injective (algebraMap (𝓞 L) C) :=
    IsLocalization.injective C (hWle.trans (Ideal.primeCompl_le_nonZeroDivisors P))
  have hden : ∀ b : 𝓞 L, ∃ w : Rx, w ∈ q.primeCompl ∧
      algebraMap Rx (𝓞 L) w * b ∈ Rx := by
    intro b
    obtain ⟨z, hz⟩ := Submodule.mem_one.mp (htop (Submodule.mem_top (x := algebraMap (𝓞 L) C b)))
    obtain ⟨⟨r, w⟩, hrw⟩ := IsLocalization.surj q.primeCompl z
    refine ⟨w, w.2, ?_⟩
    have key : algebraMap (𝓞 L) C (algebraMap Rx (𝓞 L) w * b)
        = algebraMap (𝓞 L) C (algebraMap Rx (𝓞 L) r) := by
      rw [map_mul, ← hz, ← hcast, ← hcast, ← map_mul, mul_comm, hrw]
    rw [hinjC key]
    exact r.2
  choose wf hwf1 hwf2 using hden
  obtain ⟨T, hT⟩ := Module.finite_def.mp (inferInstance : Module.Finite Rx (𝓞 L))
  set y : Rx := ∏ t ∈ T, wf t with hydef
  have hyq : y ∈ q.primeCompl := Submonoid.prod_mem _ fun t _ ↦ hwf1 t
  have hmul : ∀ t ∈ T, algebraMap Rx (𝓞 L) y * t ∈ Rx := by
    intro t ht
    rw [hydef, ← Finset.prod_erase_mul T _ ht, map_mul, mul_assoc]
    exact Subalgebra.mul_mem _ (∏ s ∈ T.erase t, wf s).2 (hwf2 t)
  have hall : ∀ b : 𝓞 L, algebraMap Rx (𝓞 L) y * b ∈ Rx := by
    intro b
    have hb : b ∈ Submodule.span Rx (T : Set (𝓞 L)) := hT ▸ Submodule.mem_top
    induction hb using Submodule.span_induction with
    | mem t ht => exact hmul t ht
    | zero => simp
    | add b₁ b₂ _ _ hb₁ hb₂ => rw [mul_add]; exact Subalgebra.add_mem _ hb₁ hb₂
    | smul c b _ hb =>
      rw [Algebra.smul_def, ← mul_assoc, mul_comm (algebraMap Rx (𝓞 L) y), mul_assoc]
      exact Subalgebra.mul_mem _ c.2 hb
  intro hcon
  exact hyq (hcon (mem_conductor_iff.mpr hall))

end NumberField

