module

public import Mathlib.FieldTheory.IsAlgClosed.Classification
public import Mathlib.NumberTheory.Padics.Complex
public import Mathlib.Analysis.Complex.Cardinality
public import Mathlib.Topology.Sequences
public import Mathlib.Analysis.Complex.Polynomial.Basic
public import Mathlib.Data.Finsupp.Encodable

/-!
# Extending an embedding `ℚ_ℓ → ℂ` to `ℂ_ℓ`, on countably many elements

An embedding `ι : ℚ_ℓ →+* ℂ` need not extend to `ℂ_ℓ`: `ℂ` may be algebraic over `ι(ℚ_ℓ)`, and
then it has no room for the transcendental elements of `ℂ_ℓ` over `ℚ_ℓ`.  It does extend on any
countable set `s ⊆ ℚ_ℓ`: there is `ι_K : ℂ_ℓ →+* ℂ` with `ι_K x = ι x` for `x ∈ s`.  This
suffices in Weil II, where `ι` is only ever applied to countably many coefficients of
characteristic polynomials of Frobenius elements, while the arguments of Weil II 1.3–1.5 take
place over an algebraically closed complete field `K ⊇ ℚ_ℓ` with an embedding `ι_K : K →+* ℂ`.

The proof is field theory: over the countable ring `R` generated by `s`, `ℂ_ℓ` (of cardinality
at most `𝔠`) and `ℂ` (of cardinality `𝔠`) are algebraically closed, a transcendence basis of `ℂ`
over `R` has cardinality `𝔠`, so a transcendence basis of `ℂ_ℓ` over `R` maps injectively into
it; the resulting embedding of the polynomial ring extends to `ℂ_ℓ`, which is algebraic over it.

## Main results

* `Stacks.LAdic.exists_ringHom_comp_algebraMap_eq_of_countable`: the extension over a countable
  domain.
* `Stacks.LAdic.cardinal_mk_le_of_denseRange`, `Stacks.LAdic.cardinal_mk_padicComplex_le`.
* `Stacks.LAdic.exists_padicComplex_ringHom_eq_on`.
-/

@[expose] public noncomputable section

open Cardinal Filter Topology

universe u

namespace Stacks.LAdic

/-- **Extension of an embedding along a countable domain.**  Let `R` be a countable domain
contained in the algebraically closed fields `K` and `L`, with `#K ≤ #L` and `L` uncountable.
Then there is a ring homomorphism `K →+* L` over `R`. -/
public theorem exists_ringHom_comp_algebraMap_eq_of_countable {R K L : Type u} [CommRing R]
    [IsDomain R] [Countable R] [Field K] [Field L] [Algebra R K] [Algebra R L] [IsAlgClosed K]
    [IsAlgClosed L] (hK : Function.Injective (algebraMap R K))
    (hL : Function.Injective (algebraMap R L)) (hcard : #K ≤ #L) (hL0 : ℵ₀ < #L) :
    ∃ φ : K →+* L, φ.comp (algebraMap R K) = algebraMap R L := by
  classical
  have : FaithfulSMul R K := (faithfulSMul_iff_algebraMap_injective R K).mpr hK
  have : FaithfulSMul R L := (faithfulSMul_iff_algebraMap_injective R L).mpr hL
  obtain ⟨t, ht⟩ := exists_isTranscendenceBasis R K
  obtain ⟨s, hs⟩ := exists_isTranscendenceBasis R L
  have hsc : #s = #L := by
    simpa using (IsAlgClosed.cardinal_eq_cardinal_transcendence_basis_of_aleph0_lt _ hs
      Cardinal.mk_le_aleph0 hL0).symm
  have htc : #t ≤ #s := (Cardinal.mk_set_le t).trans (hcard.trans hsc.ge)
  obtain ⟨emb⟩ := (Cardinal.le_def t s).mp htc
  set w : t → L := fun x => (emb x : L)
  have hw : AlgebraicIndependent R w := hs.1.comp emb emb.injective
  set A := Algebra.adjoin R (Set.range ((↑) : t → K))
  let φA : A →ₐ[R] L := (MvPolynomial.aeval w).comp
    (ht.1.aevalEquiv.symm : A →ₐ[R] MvPolynomial t R)
  have hφA : Function.Injective φA :=
    (algebraicIndependent_iff_injective_aeval.mp hw).comp ht.1.aevalEquiv.symm.injective
  let : Algebra A L := φA.toRingHom.toAlgebra
  have : Module.IsTorsionFree A L := Module.isTorsionFree_iff_algebraMap_injective.mpr hφA
  have : Module.IsTorsionFree A K :=
    Module.isTorsionFree_iff_algebraMap_injective.mpr Subtype.val_injective
  have : Algebra.IsAlgebraic A K := ht.isAlgebraic
  let ψ : K →ₐ[A] L := IsAlgClosed.lift
  refine ⟨ψ.toRingHom, RingHom.ext fun x => ?_⟩
  rw [RingHom.comp_apply, show algebraMap R K x = algebraMap A K (algebraMap R A x) from rfl,
    AlgHom.toRingHom_eq_coe, RingHom.coe_coe, ψ.commutes]
  exact φA.commutes x

/-- A space with a dense sequence-closed image of `α` has at most `#(ℕ → α)` points. -/
public theorem cardinal_mk_le_of_denseRange {α X : Type u} [TopologicalSpace X]
    [FrechetUrysohnSpace X] [T2Space X] {f : α → X} (hf : DenseRange f) : #X ≤ #(ℕ → α) := by
  have hseq (x : X) : ∃ u : ℕ → α, Tendsto (f ∘ u) atTop (𝓝 x) := by
    obtain ⟨v, hv, hlim⟩ := mem_closure_iff_seq_limit.mp (hf x)
    choose u hu using hv
    exact ⟨u, by rwa [show f ∘ u = v from funext hu]⟩
  choose g hg using hseq
  refine Cardinal.mk_le_of_injective (f := g) fun x y hxy => ?_
  exact tendsto_nhds_unique (hg x) (hxy ▸ hg y)

variable (ℓ : ℕ) [Fact ℓ.Prime]

/-- `ℂ_ℓ` has at most `𝔠` elements. -/
public theorem cardinal_mk_padicComplex_le : #ℂ_[ℓ] ≤ 𝔠 := by
  have h1 : #ℚ_[ℓ] ≤ 𝔠 := by
    refine (cardinal_mk_le_of_denseRange (Padic.denseRange_ratCast ℓ)).trans ?_
    rw [← Cardinal.power_def, Cardinal.mkRat, Cardinal.mk_nat, Cardinal.aleph0_power_aleph0]
  have h2 : #(PadicAlgCl ℓ) ≤ 𝔠 :=
    (Algebra.IsAlgebraic.cardinalMk_le_max ℚ_[ℓ] (PadicAlgCl ℓ)).trans
      (max_le h1 Cardinal.aleph0_le_continuum)
  refine (cardinal_mk_le_of_denseRange (X := ℂ_[ℓ])
    UniformSpace.Completion.denseRange_coe).trans ?_
  rw [← Cardinal.power_def, Cardinal.mk_nat]
  calc #(PadicAlgCl ℓ) ^ ℵ₀ ≤ 𝔠 ^ ℵ₀ := Cardinal.power_le_power_right h2
    _ = 𝔠 := Cardinal.continuum_power_aleph0

/-- **An embedding `ι : ℚ_ℓ →+* ℂ` extends to `ℂ_ℓ` on any countable set**: for countable
`s ⊆ ℚ_ℓ` there is `ι_K : ℂ_ℓ →+* ℂ` with `ι_K x = ι x` for every `x ∈ s`. -/
public theorem exists_padicComplex_ringHom_eq_on (ι : ℚ_[ℓ] →+* ℂ) {s : Set ℚ_[ℓ]}
    (hs : s.Countable) :
    ∃ ιK : ℂ_[ℓ] →+* ℂ, ∀ x ∈ s, ιK (algebraMap ℚ_[ℓ] ℂ_[ℓ] x) = ι x := by
  classical
  set R := Algebra.adjoin ℤ s with hR_def
  have : Countable s := hs.to_subtype
  have hRc : ((R : Subalgebra ℤ ℚ_[ℓ]) : Set ℚ_[ℓ]).Countable := by
    rw [hR_def, Algebra.adjoin_eq_range, AlgHom.coe_range]
    exact Set.countable_range _
  have : Countable R := hRc.to_subtype
  let : Algebra R ℂ_[ℓ] := ((algebraMap ℚ_[ℓ] ℂ_[ℓ]).comp R.val.toRingHom).toAlgebra
  let : Algebra R ℂ := (ι.comp R.val.toRingHom).toAlgebra
  have hK : Function.Injective (algebraMap R ℂ_[ℓ]) :=
    (algebraMap ℚ_[ℓ] ℂ_[ℓ]).injective.comp Subtype.val_injective
  have hL : Function.Injective (algebraMap R ℂ) := ι.injective.comp Subtype.val_injective
  obtain ⟨φ, hφ⟩ := exists_ringHom_comp_algebraMap_eq_of_countable hK hL
    ((cardinal_mk_padicComplex_le ℓ).trans_eq mk_complex.symm)
    (aleph0_lt_continuum.trans_eq mk_complex.symm)
  refine ⟨φ, fun x hx => ?_⟩
  exact (RingHom.congr_fun hφ ⟨x, Algebra.subset_adjoin hx⟩ :)

end Stacks.LAdic

end
