module

public import StacksFrontier.NumberTheory.Padics.LAdicDeterminant

/-!
# Transporting the outer-action decomposition along tensor constructions

A *construction* is a pair `(R, D)` of a group homomorphism `R : GL_n(K) → GL_m(K)` and a Lie
algebra homomorphism `D : 𝔤𝔩_n(K) → 𝔤𝔩_m(K)` with `R g = exp (D (log g))` on the disc
`‖g - 1‖ < ℓ⁻¹` (tensor powers, duals, direct sums and their composites are constructions).  The
decomposition `u ^ ℓ ^ N = exp A * exp B` of `Stacks.LAdic.exists_pow_eq_exp_mul_exp_of_normalizes`
for `(G, u)` is carried by a construction to the decomposition
`R u ^ ℓ ^ N = exp (D A) * exp (D B)` for `(R G, R u)`, with the same properties.  Hence the
determinant of `R u ^ ℓ ^ N` on every subspace stable under `R G` and `R u` is that of
`exp (D B)`, for one and the same `B`: this is the simultaneity over the tensor category
generated by a representation, which in Deligne's and Kedlaya's treatments comes from the
Tannakian group (Weil II 1.3.10; Kedlaya, *Fourier transforms and p-adic Weil II*, 6.1).

## Main results

* `Stacks.LAdic.toLinAlgEquiv'_mem_logLieSpan_map`: `D` maps the Lie algebra of `log G` into that
  of `log (R G)`.
* `Stacks.LAdic.det_stabRestrict_construction`: the determinant identity on subspaces of the
  construction.
-/

@[expose] public noncomputable section

open Filter Topology NormedSpace Matrix

namespace Stacks.LAdic

variable {ℓ : ℕ} [Fact ℓ.Prime]

attribute [local instance] Matrix.normedAddCommGroup Matrix.normedSpace Matrix.ultraNormedRing
  Matrix.ultraNormedAlgebra Matrix.isUltrametricDist Matrix.completeSpace_of_ultra

attribute [local instance 100] LieRing.ofAssociativeRing

variable {K : Type*} [NontriviallyNormedField K] [CharZero K] [IsUltrametricDist K]
  [NormedAlgebra ℚ_[ℓ] K] [CompleteSpace K]
  {n m : Type*} [Fintype n] [DecidableEq n] [Fintype m] [DecidableEq m]

/-- The Lie homomorphism `D` read on endomorphisms of `K^n`, `K^m`. -/
def endLieHom (D : Matrix n n K →ₗ⁅K⁆ Matrix m m K) :
    Module.End K (n → K) →ₗ⁅K⁆ Module.End K (m → K) :=
  ((Matrix.toLinAlgEquiv' : Matrix m m K ≃ₐ[K] _).toLieEquiv.toLieHom.comp D).comp
    (Matrix.toLinAlgEquiv' : Matrix n n K ≃ₐ[K] _).symm.toLieEquiv.toLieHom

omit [CharZero K] [IsUltrametricDist K] [CompleteSpace K] in
/-- On the endomorphism of `K^n` given by a matrix `X`, `endLieHom D` is the endomorphism of
`K^m` given by `D X`. -/
theorem endLieHom_toLinAlgEquiv' (D : Matrix n n K →ₗ⁅K⁆ Matrix m m K) (X : Matrix n n K) :
    endLieHom D (Matrix.toLinAlgEquiv' X) = Matrix.toLinAlgEquiv' (D X) := by
  simp [endLieHom]

omit [CharZero K] in
/-- A construction maps the Lie algebra spanned by `log G` into that spanned by `log (R G)`. -/
theorem toLinAlgEquiv'_mem_logLieSpan_map {G : Subgroup (Matrix n n K)ˣ}
    (hG : ∀ g ∈ G, ‖(g : Matrix n n K) - 1‖ < (ℓ : ℝ)⁻¹)
    (R : (Matrix n n K)ˣ →* (Matrix m m K)ˣ) (D : Matrix n n K →ₗ⁅K⁆ Matrix m m K)
    (hD : ∀ X : Matrix n n K, ‖X‖ < (ℓ : ℝ)⁻¹ → ‖D X‖ < (ℓ : ℝ)⁻¹)
    (hR : ∀ g : (Matrix n n K)ˣ, ‖(g : Matrix n n K) - 1‖ < (ℓ : ℝ)⁻¹ →
      (R g : Matrix m m K) = exp (D (ladicLog ℓ (g : Matrix n n K))))
    {A : Matrix n n K} (hA : Matrix.toLinAlgEquiv' A ∈ logLieSpan ℓ G) :
    Matrix.toLinAlgEquiv' (D A) ∈ logLieSpan ℓ (G.map R) := by
  rw [← endLieHom_toLinAlgEquiv']
  suffices h : logLieSpan ℓ G ≤ (logLieSpan ℓ (G.map R)).comap (endLieHom D) from h hA
  refine (LieSubalgebra.lieSpan_le).mpr ?_
  rintro _ ⟨g, hg, rfl⟩
  change endLieHom D _ ∈ logLieSpan ℓ (G.map R)
  rw [endLieHom_toLinAlgEquiv']
  have hlog : ‖ladicLog ℓ (g : Matrix n n K)‖ < (ℓ : ℝ)⁻¹ :=
    (norm_ladicLog_le (hG g hg).le).trans_lt (hG g hg)
  have hRg : ladicLog ℓ (R g : Matrix m m K) = D (ladicLog ℓ (g : Matrix n n K)) :=
    (congrArg (ladicLog ℓ) (hR g (hG g hg))).trans (ladicLog_exp (hD _ hlog))
  refine LieSubalgebra.subset_lieSpan ⟨R g, Subgroup.mem_map_of_mem R hg, ?_⟩
  rw [hRg]

omit [CharZero K] in
/-- A construction sends the elements of the disc into the disc. -/
theorem norm_map_sub_one_lt
    (R : (Matrix n n K)ˣ →* (Matrix m m K)ˣ) (D : Matrix n n K →ₗ⁅K⁆ Matrix m m K)
    (hD : ∀ X : Matrix n n K, ‖X‖ < (ℓ : ℝ)⁻¹ → ‖D X‖ < (ℓ : ℝ)⁻¹)
    (hR : ∀ g : (Matrix n n K)ˣ, ‖(g : Matrix n n K) - 1‖ < (ℓ : ℝ)⁻¹ →
      (R g : Matrix m m K) = exp (D (ladicLog ℓ (g : Matrix n n K))))
    {g : (Matrix n n K)ˣ} (hg : ‖(g : Matrix n n K) - 1‖ < (ℓ : ℝ)⁻¹) :
    ‖(R g : Matrix m m K) - 1‖ < (ℓ : ℝ)⁻¹ := by
  have hlog := hD _ ((norm_ladicLog_le hg.le).trans_lt hg)
  rw [hR g hg]
  exact (norm_exp_sub_one_le hlog).trans_lt hlog

/-- **Simultaneity along a construction.**  Let `u ^ ℓ ^ N = exp A * exp B` be the decomposition
of `Stacks.LAdic.exists_pow_eq_exp_mul_exp_of_normalizes`, with `ℓ ^ N • log u = A + B`, and let
`(R, D)` be a construction.  For every subspace `W ⊆ K^m` stable under `R G` and `R u`, on which
the determinants of `R G` have finite order, `exp (D B)` preserves `W`, commutes with `R G`, and
`det (R u ^ ℓ ^ N |_W) = det (exp (D B) |_W)`. -/
theorem det_stabRestrict_construction [IsAlgClosed K] {G : Subgroup (Matrix n n K)ˣ}
    (hG : ∀ g ∈ G, ‖(g : Matrix n n K) - 1‖ < (ℓ : ℝ)⁻¹)
    (R : (Matrix n n K)ˣ →* (Matrix m m K)ˣ) (D : Matrix n n K →ₗ⁅K⁆ Matrix m m K)
    (hD : ∀ X : Matrix n n K, ‖X‖ < (ℓ : ℝ)⁻¹ → ‖D X‖ < (ℓ : ℝ)⁻¹)
    (hR : ∀ g : (Matrix n n K)ˣ, ‖(g : Matrix n n K) - 1‖ < (ℓ : ℝ)⁻¹ →
      (R g : Matrix m m K) = exp (D (ladicLog ℓ (g : Matrix n n K))))
    {u : (Matrix n n K)ˣ} (hu : ‖(u : Matrix n n K) - 1‖ < (ℓ : ℝ)⁻¹) {N : ℕ}
    {A B : Matrix n n K} (hA : Matrix.toLinAlgEquiv' A ∈ logLieSpan ℓ G)
    (hAn : ‖A‖ < (ℓ : ℝ)⁻¹) (hBn : ‖B‖ < (ℓ : ℝ)⁻¹)
    (hBG : ∀ g ∈ G, Commute B (g : Matrix n n K)) (hAB : Commute A B)
    (hsum : (ℓ ^ N : ℕ) • ladicLog ℓ (u : Matrix n n K) = A + B)
    {W : Submodule K (m → K)}
    (hGW : ∀ g ∈ G, (R g : Matrix m m K) ∈ stabilizerSubalgebra W)
    (huW : (R u : Matrix m m K) ∈ stabilizerSubalgebra W)
    (hdetW : ∀ g ∈ G, ∃ k : ℕ, 0 < k ∧ ∀ hg : (R g : Matrix m m K) ∈ stabilizerSubalgebra W,
      LinearMap.det (stabRestrict (R g : Matrix m m K) hg) ^ k = 1) :
    (∀ g ∈ G, Commute (exp (D B)) (R g : Matrix m m K)) ∧
    ∃ hz : exp (D B) ∈ stabilizerSubalgebra W,
      ∃ hu' : (R u : Matrix m m K) ^ (ℓ ^ N) ∈ stabilizerSubalgebra W,
        LinearMap.det (stabRestrict _ hu') = LinearMap.det (stabRestrict (exp (D B)) hz) := by
  have hG' : ∀ g ∈ G.map R, ‖(g : Matrix m m K) - 1‖ < (ℓ : ℝ)⁻¹ := by
    rintro _ ⟨g, hg, rfl⟩
    exact norm_map_sub_one_lt R D hD hR (hG g hg)
  have hGW' : ∀ g ∈ G.map R, (g : Matrix m m K) ∈ stabilizerSubalgebra W := by
    rintro _ ⟨g, hg, rfl⟩
    exact hGW g hg
  have hdetW' : ∀ g ∈ G.map R, ∃ k : ℕ, 0 < k ∧
      ∀ hg : (g : Matrix m m K) ∈ stabilizerSubalgebra W,
        LinearMap.det (stabRestrict (g : Matrix m m K) hg) ^ k = 1 := by
    rintro _ ⟨g, hg, rfl⟩
    exact hdetW g hg
  have hDA := toLinAlgEquiv'_mem_logLieSpan_map hG R D hD hR hA
  have hDAn := hD A hAn
  have hDBn := hD B hBn
  have hlie : ∀ X Y : Matrix n n K, Commute X Y → Commute (D X) (D Y) := by
    intro X Y hXY
    have h : ⁅X, Y⁆ = 0 := by rw [LieRing.of_associative_ring_bracket, hXY.eq, sub_self]
    have h' : ⁅D X, D Y⁆ = 0 := by rw [← LieHom.map_lie, h, map_zero]
    rw [LieRing.of_associative_ring_bracket, sub_eq_zero] at h'
    exact h'
  have hcomm : ∀ g ∈ G, Commute (exp (D B)) (R g : Matrix m m K) := by
    intro g hg
    rw [hR g (hG g hg)]
    exact (hlie _ _ ((Commute.ladicLog_left (hBG g hg).symm (hG g hg).le).symm)).exp
  refine ⟨hcomm, ?_⟩
  have huN : ‖(u : Matrix n n K) ^ (ℓ ^ N) - 1‖ < (ℓ : ℝ)⁻¹ :=
    (norm_pow_sub_one_le (hu.le.trans (inv_le_one_of_one_le₀ (by
      exact_mod_cast (Fact.out : ℓ.Prime).one_lt.le))) _).trans_lt hu
  have hRuN : (R u : Matrix m m K) ^ (ℓ ^ N) = exp (D A) * exp (D B) := by
    have e1 : (R u : Matrix m m K) ^ (ℓ ^ N) = (R (u ^ (ℓ ^ N)) : Matrix m m K) := by
      rw [map_pow, Units.val_pow_eq_pow_val]
    have e2 : ladicLog ℓ ((u ^ (ℓ ^ N) : (Matrix n n K)ˣ) : Matrix n n K) = A + B := by
      rw [Units.val_pow_eq_pow_val, ladicLog_pow hu.le, hsum]
    rw [e1, hR _ (by rwa [Units.val_pow_eq_pow_val]), e2, map_add]
    exact exp_add_of_commute_of_mem_ball (𝕂 := ℚ_[ℓ]) (hlie _ _ hAB) (mem_eball_expSeries hDAn)
        (mem_eball_expSeries hDBn)
  have hDAS : D A ∈ stabilizerSubalgebra W := fun v hv => by
    have := apply_mem_of_mem_logLieSpan hG' hGW' hDA v hv
    rwa [Matrix.toLinAlgEquiv'_apply] at this
  have hEA : exp (D A) ∈ stabilizerSubalgebra W :=
    NormedSpace.exp_mem (R := K) (isClosed_stabilizerSubalgebra W) hDAS
  have hEA' : exp (-D A) ∈ stabilizerSubalgebra W :=
    NormedSpace.exp_mem (R := K) (isClosed_stabilizerSubalgebra W) (Subalgebra.neg_mem _ hDAS)
  have huNW : (R u : Matrix m m K) ^ (ℓ ^ N) ∈ stabilizerSubalgebra W := Subalgebra.pow_mem _ huW _
  have hEB : exp (D B) ∈ stabilizerSubalgebra W := by
    have e : exp (D B) = exp (-D A) * ((R u : Matrix m m K) ^ (ℓ ^ N)) := by
      rw [hRuN, ← mul_assoc]
      have h := exp_add_of_commute_of_mem_ball (𝕂 := ℚ_[ℓ])
        (Commute.neg_left (Commute.refl (D A))) (mem_eball_expSeries (by rwa [norm_neg]))
        (mem_eball_expSeries hDAn)
      rw [neg_add_cancel, exp_zero] at h
      exact (one_mul _).symm.trans (congrArg (· * exp (D B)) h)
    rw [e]
    exact Subalgebra.mul_mem _ hEA' huNW
  refine ⟨hEB, huNW, ?_⟩
  rw [stabRestrict_congr hRuN huNW (Subalgebra.mul_mem _ hEA hEB), stabRestrict_mul hEA hEB,
    map_mul, det_stabRestrict_exp_eq_one hG' hGW' hdetW' hDA hDAn hDAS hEA, one_mul]

end Stacks.LAdic
