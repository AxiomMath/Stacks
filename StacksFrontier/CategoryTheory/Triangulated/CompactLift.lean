/-! ### A morphism from a compact object to a derived colimit factors through a term -/

section Stage

variable {D : Type u} [Category.{v} D] [Preadditive D] [HasZeroObject D] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]

/-- **A morphism from a compact object to a derived colimit factors through a term**
([Stacks, Tag 094A]): the third map of the defining triangle kills it, because `1 - fₙ` is
injective on morphisms out of the compact object `A⟦-1⟧`, so it comes from `∐ Fₙ`, and then from
a single `Fₙ` by compactness of `A`. -/
lemma exists_fac_of_isHomotopyColimit {F : ℕ ⥤ D} [HasCoproduct F.obj] {X : D}
    (hX : IsHomotopyColimit F X) (A : D) [IsCompactObject.{w} A]
    [IsCompactObject.{w} (A⟦(-1 : ℤ)⟧)] (ζ : A ⟶ X) :
    ∃ (n : ℕ) (ρ : A ⟶ F.obj n) (σ : F.obj n ⟶ X), ρ ≫ σ = ζ := by
  obtain ⟨p, q, hT⟩ := hX
  set t : ∐ F.obj ⟶ ∐ F.obj := Sigma.desc fun n ↦ Sigma.ι F.obj n -
    F.map (homOfLE (Nat.le_succ n)) ≫ Sigma.ι F.obj (n + 1) with ht
  have hσ : IsColimit (Cofan.mk (∐ F.obj) (Sigma.ι F.obj)) := coproductIsCoproduct F.obj
  have ha : ∀ n, Sigma.ι F.obj n ≫ t =
      Sigma.ι F.obj n - F.map (homOfLE (Nat.le_succ n)) ≫ Sigma.ι F.obj (n + 1) := fun n =>
    Sigma.ι_desc _ _
  have h0 : q ≫ t⟦(1 : ℤ)⟧' = 0 := comp_distTriang_mor_zero₃₁ _ hT
  have hζq : ζ ≫ q = 0 := by
    refine eq_zero_of_comp_shift_map_eq_zero (b := t) (fun g hg ↦
      eq_zero_of_comp_eq_zero_of_isColimitCofan F.obj (fun n => F.map (homOfLE (Nat.le_succ n)))
        (Sigma.ι F.obj) hσ ha _ g hg) _ ?_
    rw [assoc, h0, comp_zero]
  obtain ⟨ψ, hψ⟩ := Triangle.coyoneda_exact₃ _ hT ζ hζq
  have h1 : t ≫ p = 0 := comp_distTriang_mor_zero₁₂ _ hT
  have hr : ∀ n : ℕ, Sigma.ι F.obj n ≫ p =
      F.map (homOfLE (Nat.le_succ n)) ≫ Sigma.ι F.obj (n + 1) ≫ p := by
    intro n
    have h := congrArg (fun x => Sigma.ι F.obj n ≫ x) h1
    simp only [comp_zero, ← assoc, ha, sub_comp] at h
    rw [← sub_eq_zero, ← h, assoc]
  obtain ⟨N, ρ, hρ⟩ := exists_factor_comp_of_isColimitCofan F.obj _ (Sigma.ι F.obj) hσ p hr A ψ
  exact ⟨N, ρ, Sigma.ι F.obj N ≫ p, by rw [hψ]; exact hρ.symm⟩

end Stage

/-! ### Neeman's factorization lemma -/

section Factor

variable {D : Type u} [Category.{v} D] [Preadditive D] [HasZeroObject D] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D] [IsTriangulated D]
  [HasCoproducts.{v} D] {ι : Type v} (K : ι → D) [∀ i, IsCompactObject.{v} (K i)]

omit [IsTriangulated D] [∀ i, IsCompactObject.{v} (K i)] in
/-- A direct sum of shifts of the generators, read inside their localizing closure, is a direct
sum of shifts of the generators in the ambient category: the inclusion preserves direct sums and
commutes with the shift. -/
lemma prop_iSup_colimitsOfShape_obj (Y : (ofObj K).localizingClosure.{v}.FullSubcategory)
    (hY : (⨆ J : Type v, ((ofObj (localizingClosureGen K)).shiftClosure ℤ).colimitsOfShape
      (Discrete J)) Y) :
    (⨆ J : Type v, ((ofObj K).shiftClosure ℤ).colimitsOfShape (Discrete J)) Y.obj := by
  simp only [prop_iSup_iff] at hY ⊢
  obtain ⟨J, ⟨h⟩⟩ := hY
  refine ⟨J, ⟨{ toColimitPresentation :=
    h.toColimitPresentation.map (ofObj K).localizingClosure.{v}.ι, prop_diag_obj := fun j => ?_ }⟩⟩
  obtain ⟨Z, n, e, ⟨i⟩⟩ := h.prop_diag_obj j
  exact ⟨K i, n, (ofObj K).localizingClosure.{v}.ι.mapIso e ≪≫
    ((ofObj K).localizingClosure.{v}.ι.commShiftIso n).app _, ofObj_apply K i⟩

/-- **Neeman's factorization lemma.** A morphism from a compact object `c` of `D` to an object of
the localizing subcategory generated by a family of compact objects `K i` factors through an
object of the triangulated envelope of a finite direct sum of the `K i`.

Inside the localizing subcategory, which the `K i` generate and in which they are compact, the
target is a derived colimit of a cell tower ([Stacks, Tag 09SN]); the inclusion carries it to a
derived colimit of a cell tower of `D`; a morphism from `c` factors through a term
(`CategoryTheory.Pretriangulated.exists_fac_of_isHomotopyColimit`), and then through the
envelope of finitely many cells ([Stacks, Tag 09SP]). -/
theorem exists_fac_triangEnvelope_of_localizingClosure {c N : D} [IsCompactObject.{v} c]
    (hN : (ofObj K).localizingClosure.{v} N) (φ : c ⟶ N) :
    ∃ (s : Finset ι) (Z : D), (ObjectProperty.singleton (∐ fun i : s ↦ K i)).triangEnvelope Z ∧
      ∃ (a : c ⟶ Z) (b : Z ⟶ N), a ≫ b = φ := by
  have : ∀ i, IsCompactObject.{v} (localizingClosureGen K i) :=
    isCompactObject_localizingClosureGen K
  have : HasCoproducts.{v} (ofObj K).localizingClosure.{v}.FullSubcategory :=
    fun α ↦ inferInstance
  have : ∀ (i : ι) (α : Type v),
      PreservesColimitsOfShape (Discrete α) (preadditiveCoyoneda.obj (Opposite.op (K i))) :=
    fun i α ↦ preservesColimitsOfShape_discrete_of_isCompactObject (K i) α
  have : PreservesColimitsOfShape (Discrete (ULift.{v} ℕ))
      (ofObj K).localizingClosure.{v}.ι := inferInstance
  have : PreservesColimitsOfShape (Discrete ℕ) (ofObj K).localizingClosure.{v}.ι :=
    preservesColimitsOfShape_of_equiv (Discrete.equivalence Equiv.ulift) _
  obtain ⟨F, hF, h0, hstep⟩ := exists_isHomotopyColimit_of_compactlyGenerated
    (localizingClosureGen K) (isZero_of_rightOrthogonal_shiftClosure_localizingClosureGen K)
    (⟨N, hN⟩ : (ofObj K).localizingClosure.{v}.FullSubcategory)
  have : IsCompactObject.{v} (c⟦(-1 : ℤ)⟧) := isCompactObject_shift inferInstance _
  obtain ⟨n, ρ, σ, hρσ⟩ :=
    exists_fac_of_isHomotopyColimit (hF.map (ofObj K).localizingClosure.{v}.ι) c φ
  obtain ⟨s, Z, hZ, a, b, hab⟩ := exists_fac_triangEnvelope_of_isCompactObject K
    (X := fun n => (F ⋙ (ofObj K).localizingClosure.{v}.ι).obj n)
    (prop_iSup_colimitsOfShape_obj K _ h0) (fun n => by
      obtain ⟨Y, hY, f, g, hT⟩ := hstep n
      exact ⟨Y.obj, prop_iSup_colimitsOfShape_obj K _ hY, _, _, _,
        (ofObj K).localizingClosure.{v}.ι.map_distinguished _ hT⟩) ρ
  exact ⟨s, Z, hZ, a, b ≫ σ, by rw [← assoc, hab, hρσ]⟩

end Factor

/-! ### Thomason's trick -/

section Thomason

variable {D : Type u} [Category.{v} D] [Preadditive D] [HasZeroObject D] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D] [IsTriangulated D]

/-- **The cone of the projection of `P ⊕ C` onto `C` is `P[1] ⊕ P`.** The projection is the
composite `P ⊕ C ⟶ C ⟶ P ⊕ C`, whose two factors have cones `P[1]` and `P`, the second with
vanishing connecting morphism; the octahedral axiom gives a triangle `P[1] ⟶ Z ⟶ P ⟶ P[2]` with
vanishing third map. -/
lemma nonempty_iso_of_distTriang_snd_inr (P C : D) {Z : D} (v : P ⊞ C ⟶ Z)
    (w : Z ⟶ (P ⊞ C)⟦(1 : ℤ)⟧)
    (hT : Triangle.mk (biprod.snd ≫ biprod.inr : P ⊞ C ⟶ P ⊞ C) v w ∈ distTriang D) :
    Nonempty (Z ≅ P⟦(1 : ℤ)⟧ ⊞ P) := by
  have h₁₂ : Triangle.mk (biprod.snd : P ⊞ C ⟶ C) (0 : C ⟶ P⟦(1 : ℤ)⟧)
      (-(biprod.inl : P ⟶ P ⊞ C)⟦(1 : ℤ)⟧') ∈ distTriang D :=
    rot_of_distTriang _ (binaryBiproductTriangle_distinguished P C)
  have h₂₃ : Triangle.mk (biprod.inr : C ⟶ P ⊞ C) (biprod.fst : P ⊞ C ⟶ P)
      (0 : P ⟶ C⟦(1 : ℤ)⟧) ∈ distTriang D := by
    refine isomorphic_distinguished _ (binaryBiproductTriangle_distinguished C P) _ ?_
    refine Triangle.isoMk _ _ (Iso.refl _) (biprod.braiding P C) (Iso.refl _) ?_ ?_ ?_
    · apply biprod.hom_ext <;> simp [binaryBiproductTriangle]
    · simp [binaryBiproductTriangle]
    · simp [binaryBiproductTriangle]
  obtain ⟨e, -⟩ := exists_iso_binaryBiproduct_of_distTriang _
    (Triangulated.someOctahedron rfl h₁₂ h₂₃ hT).mem (by simp)
  exact ⟨e⟩

end Thomason

/-! ### Lifting compact objects -/

/-- If `L` kills an object, it kills every retract of it. -/
private lemma isZero_obj_of_retract {T : Type u} [Category.{v} T] {T' : Type u'} [Category.{v} T']
    [Preadditive T'] (L : T ⥤ T') {X Y : T} (r : Retract X Y) (h : IsZero (L.obj Y)) :
    IsZero (L.obj X) := by
  rw [IsZero.iff_id_eq_zero, ← (r.map L).retract, h.eq_of_src (r.map L).r 0, comp_zero]

/-- If `L` kills an object, it kills its shifts. -/
private lemma isZero_obj_shift {T : Type u} [Category.{v} T] [HasShift T ℤ] {T' : Type u'}
    [Category.{v} T'] [Preadditive T'] [HasShift T' ℤ] [∀ n : ℤ, (shiftFunctor T' n).Additive]
    (L : T ⥤ T') [L.CommShift ℤ] {X : T} (n : ℤ) (h : IsZero (L.obj X)) :
    IsZero (L.obj (X⟦n⟧)) :=
  ((shiftFunctor T' n).map_isZero h).of_iso ((L.commShiftIso n).app X)

section Lift

variable {T : Type u} [Category.{v} T] [Preadditive T] [HasZeroObject T] [HasShift T ℤ]
  [∀ n : ℤ, (shiftFunctor T n).Additive] [Pretriangulated T] [IsTriangulated T]
  [HasCoproducts.{v} T]
  {T' : Type u'} [Category.{v} T'] [Preadditive T'] [HasZeroObject T'] [HasShift T' ℤ]
  [∀ n : ℤ, (shiftFunctor T' n).Additive] [Pretriangulated T'] [IsTriangulated T']
  [HasCoproducts.{v} T']
  {L : T ⥤ T'} {G : T' ⥤ T} (adj : L ⊣ G) [L.CommShift ℤ] [L.IsTriangulated]
  {ι : Type v} (K : ι → T)

omit [IsTriangulated T] [HasCoproducts.{v} T] [IsTriangulated T'] [HasCoproducts.{v} T'] in
include adj in
/-- `L` kills the localizing subcategory generated by objects it kills: its kernel is closed
under isomorphisms, shifts, retracts, extensions and direct sums, `L` being exact and a left
adjoint. -/
lemma isZero_obj_of_localizingClosure (hLK : ∀ i, IsZero (L.obj (K i))) {N : T}
    (hN : (ofObj K).localizingClosure.{v} N) : IsZero (L.obj N) := by
  have := adj.leftAdjoint_preservesColimits
  induction hN with
  | of_mem hX =>
    obtain ⟨i⟩ := hX
    exact hLK i
  | of_iso e _ ih => exact ih.of_iso (L.mapIso e).symm
  | of_shift n _ ih => exact isZero_obj_shift L n ih
  | of_retract r _ ih => exact isZero_obj_of_retract L r ih
  | of_ext T hT _ _ ih₁ ih₃ =>
    exact Triangle.isZero₂_of_isZero₁₃ _ (L.map_distinguished _ hT) ih₁ ih₃
  | of_colimitPresentation pres _ ih =>
    have hc := isColimitOfPreserves L pres.isColimit
    rw [IsZero.iff_id_eq_zero]
    refine hc.hom_ext fun j => ?_
    simp only [Functor.mapCocone_ι_app, comp_zero]
    exact (ih j).eq_of_src _ _

omit [IsTriangulated T'] [HasCoproducts.{v} T'] in
include adj in
/-- **The kernel of `L` is the localizing subcategory generated by the `K i`.** An object `N`
killed by `L` is an extension `N' ⟶ N ⟶ N''` of an object of `N^⊥` by an object `N'` of the
localizing subcategory ([Stacks, Tag 0A8G] through
`ObjectProperty.extensionProduct_localizingClosure_rightOrthogonal_eq_top`); `N''` is right
orthogonal to the `K i`, hence in the image of `G`, and killed by `L`, hence zero. -/
lemma localizingClosure_of_isZero [IsIso adj.counit] (hK : ∀ i, IsCompactObject.{v} (K i))
    (hLK : ∀ i, IsZero (L.obj (K i)))
    (hloc : ∀ E : T, (∀ i (n : ℤ) (g : (K i)⟦n⟧ ⟶ E), g = 0) → IsIso (adj.unit.app E))
    {N : T} (hN : IsZero (L.obj N)) : (ofObj K).localizingClosure.{v} N := by
  have := hK
  have : ∀ (i : ι) (α : Type v),
      PreservesColimitsOfShape (Discrete α) (preadditiveCoyoneda.obj (Opposite.op (K i))) :=
    fun i α ↦ preservesColimitsOfShape_discrete_of_isCompactObject (K i) α
  have hmem : ((ofObj K).localizingClosure.{v}.extensionProduct
      (ofObj K).localizingClosure.{v}.rightOrthogonal) N := by
    rw [extensionProduct_localizingClosure_rightOrthogonal_eq_top K]
    trivial
  obtain ⟨N', N'', f, g, h, hT, hN', hN''⟩ := hmem
  have hortho : ∀ i (n : ℤ) (g : (K i)⟦n⟧ ⟶ N''), g = 0 := fun i n g =>
    hN'' g ((ofObj K).localizingClosure.{v}.le_shift n _
      ((ofObj K).le_localizingClosure _ (ofObj_apply K i)))
  have hη := hloc N'' hortho
  have hLN'' : IsZero (L.obj N'') :=
    Triangle.isZero₃_of_isZero₁₂ _ (L.map_distinguished _ hT)
      (isZero_obj_of_localizingClosure adj K hLK hN') hN
  have : G.IsRightAdjoint := ⟨_, ⟨adj⟩⟩
  have hN''0 : IsZero N'' :=
    (G.map_isZero hLN'').of_iso (asIso (adj.unit.app N''))
  have : IsIso f := (Triangle.isZero₃_iff_isIso₁ _ hT).1 hN''0
  exact (ofObj K).localizingClosure.{v}.prop_of_iso (asIso f) hN'

omit [HasShift T ℤ] [∀ n : ℤ, (shiftFunctor T n).Additive] [Pretriangulated T]
  [IsTriangulated T] [HasCoproducts.{v} T] in
/-- The zero object is compact. -/
lemma isCompactObject_zero' : IsCompactObject.{w} (0 : T) := by
  constructor
  intro I _ E _
  exact ⟨fun a b _ => DFinsupp.ext fun i => (isZero_zero T).eq_of_src _ _,
    fun t => ⟨0, (isZero_zero T).eq_of_src _ _⟩⟩

omit [IsTriangulated T] [HasCoproducts.{v} T] [IsTriangulated T'] [HasCoproducts.{v} T'] in
/-- The kernel of an exact functor, as a property of objects. -/
abbrev kerProp (L : T ⥤ T') : ObjectProperty T := fun X => IsZero (L.obj X)

omit [IsTriangulated T] [HasCoproducts.{v} T] [IsTriangulated T'] [HasCoproducts.{v} T']
  [L.CommShift ℤ] [L.IsTriangulated] in
/-- The kernel of an exact functor is a strictly full, retract-closed triangulated
subcategory. -/
@[sga "4½ Etat_0 2.2" "partial"]
lemma kerProp_isTriangulated [L.CommShift ℤ] [L.IsTriangulated] :
    (kerProp L).IsClosedUnderIsomorphisms ∧ (kerProp L).IsStableUnderRetracts ∧
      (kerProp L).IsTriangulated := by
  have h₁ : (kerProp L).IsClosedUnderIsomorphisms :=
    ⟨fun e hX => (IsZero.of_iso hX (L.mapIso e).symm)⟩
  have h₂ : (kerProp L).IsStableUnderRetracts := ⟨fun r hY => isZero_obj_of_retract L r hY⟩
  have hz : (kerProp L).ContainsZero := ⟨⟨0, isZero_zero T, L.map_isZero (isZero_zero T)⟩⟩
  have hs : (kerProp L).IsStableUnderShift ℤ := ⟨fun n => ⟨fun X hX => isZero_obj_shift L n hX⟩⟩
  have he : (kerProp L).IsTriangulatedClosed₂ := IsTriangulatedClosed₂.mk' fun T hT h₁ h₃ =>
    Triangle.isZero₂_of_isZero₁₃ _ (L.map_distinguished _ hT) h₁ h₃
  exact ⟨h₁, h₂, ⟨⟩⟩

omit [IsTriangulated T'] [HasCoproducts.{v} T'] in
include adj in
/-- **Roofs between images of compact objects** ([Stacks, Tag 08EH] in Neeman's form). Every
morphism `g : L c₁ ⟶ L c₂` with `c₁` compact is `L g' ∘ (L s)⁻¹` for a compact object `c` and
morphisms `s : c ⟶ c₁`, `g' : c ⟶ c₂` with `L s` invertible.

The adjoint `c₁ ⟶ G L c₂` of `g` lifts along the unit `c₂ ⟶ G L c₂` exactly when its composite
with `G L c₂ ⟶ N`, `N` the cone of the unit, vanishes. `N` is killed by `L`, so it lies in the
localizing subcategory generated by the `K i`, and the composite factors through a compact object
`Z` killed by `L` (Neeman's factorization lemma); the fibre `c ⟶ c₁` of `c₁ ⟶ Z` kills it. -/
theorem exists_roof [IsIso adj.counit] (hK : ∀ i, IsCompactObject.{v} (K i))
    (hLK : ∀ i, IsZero (L.obj (K i)))
    (hloc : ∀ E : T, (∀ i (n : ℤ) (g : (K i)⟦n⟧ ⟶ E), g = 0) → IsIso (adj.unit.app E))
    {c₁ c₂ : T} [IsCompactObject.{v} c₁] (g : L.obj c₁ ⟶ L.obj c₂) :
    ∃ (c : T) (s : c ⟶ c₁) (g' : c ⟶ c₂), IsCompactObject.{v} c ∧ IsIso (L.map s) ∧
      L.map g' = L.map s ≫ g := by
  have := hK
  obtain ⟨N, π, δ, hT⟩ := distinguished_cocone_triangle (adj.unit.app c₂)
  have hLη : IsIso (L.map (adj.unit.app c₂)) := by
    have hη : L.map (adj.unit.app c₂) = inv (adj.counit.app (L.obj c₂)) := by
      rw [← cancel_mono (adj.counit.app (L.obj c₂)), adj.left_triangle_components c₂,
        IsIso.inv_hom_id]
      rfl
    rw [hη]
    infer_instance
  have hLN : IsZero (L.obj N) := Triangle.isZero₃_of_isIso₁ _ (L.map_distinguished _ hT) hLη
  have hN := localizingClosure_of_isZero adj K hK hLK hloc hLN
  obtain ⟨σ, Z, hZ, a, b, hab⟩ :=
    exists_fac_triangEnvelope_of_localizingClosure K hN (adj.homEquiv _ _ g ≫ π)
  obtain ⟨hiso, htri, -, -⟩ :
      ObjectProperty.IsClosedUnderIsomorphisms (IsCompactObject.{v, _, _} (C := T)) ∧ _ :=
    isClosedUnderIsomorphisms_isTriangulated_isSaturated_and_isIdempotentComplete_isCompactObject
      (D := T)
  have hret : ObjectProperty.IsStableUnderRetracts (IsCompactObject.{v, _, _} (C := T)) :=
    ⟨fun r hB => isCompactObject_of_retract hB r.i r.r r.retract⟩
  have hZc : IsCompactObject.{v} Z := by
    have hle : (ObjectProperty.singleton (∐ fun i : σ ↦ K i)).triangEnvelope ≤
        IsCompactObject.{v, _, _} (C := T) := by
      rw [triangEnvelope_le_iff, singleton_le_iff]
      exact isCompactObject_sigma (fun i : σ ↦ K i) (fun _ => inferInstance)
    exact hle _ hZ
  obtain ⟨hk₁, hk₂, hk₃⟩ := kerProp_isTriangulated (L := L)
  have hZL : IsZero (L.obj Z) := by
    have hle : (ObjectProperty.singleton (∐ fun i : σ ↦ K i)).triangEnvelope ≤ kerProp L := by
      rw [triangEnvelope_le_iff, singleton_le_iff]
      have := adj.leftAdjoint_preservesColimits
      change IsZero (L.obj _)
      refine IsZero.of_iso ?_ (PreservesCoproduct.iso L _)
      rw [IsZero.iff_id_eq_zero]
      refine Sigma.hom_ext _ _ fun i => ?_
      simp only [comp_id, comp_zero]
      exact (hLK i.1).eq_of_src _ _
    exact hle _ hZ
  obtain ⟨c, s, w, hs⟩ := distinguished_cocone_triangle₁ a
  have hc1 : IsCompactObject.{v} (c⟦(1 : ℤ)⟧) :=
    isCompactObject_obj₃ _ (rot_of_distTriang _ hs) (show IsCompactObject.{v} c₁ from inferInstance)
      hZc
  have hc : IsCompactObject.{v} c :=
    isCompactObject_of_iso ((shiftFunctorCompIsoId T (1 : ℤ) (-1) (by simp)).app c).symm
      (isCompactObject_shift hc1 (-1))
  have hLs : IsIso (L.map s) :=
    (Triangle.isZero₃_iff_isIso₁ _ (L.map_distinguished _ hs)).1 hZL
  have hsa : s ≫ a = 0 := comp_distTriang_mor_zero₁₂ _ hs
  have hz : (s ≫ adj.homEquiv _ _ g) ≫ π = 0 := by
    rw [assoc, ← hab, ← assoc, hsa, zero_comp]
  obtain ⟨g', hg'⟩ := Triangle.coyoneda_exact₂ _ hT (s ≫ adj.homEquiv _ _ g) hz
  refine ⟨c, s, g', hc, hLs, ?_⟩
  apply (adj.homEquiv _ _).injective
  rw [Adjunction.homEquiv_naturality_left, hg', Adjunction.homEquiv_unit]
  exact (adj.unit.naturality g').symm

include adj in
/-- **Lifting a compact object up to its sum with its shift** ([Stacks, Tag 08EK] in the form of
Thomason–Trobaugh and Neeman). Let `L ⊣ G` with `L` exact, `G` fully faithful and commuting with
direct sums, `T` compactly generated by a nonempty family `G₀`, and let the kernel of `L` be
detected by compact objects `K i` killed by `L`. Then for every compact object `P` of `T'` there
is a compact object `c` of `T` with `L c ≅ P ⊕ P[1]`. -/
theorem exists_isCompactObject_iso_biprod_shift [IsIso adj.counit]
    [∀ J : Type v, PreservesColimitsOfShape (Discrete J) G]
    (hK : ∀ i, IsCompactObject.{v} (K i)) (hLK : ∀ i, IsZero (L.obj (K i)))
    (hloc : ∀ E : T, (∀ i (n : ℤ) (g : (K i)⟦n⟧ ⟶ E), g = 0) → IsIso (adj.unit.app E))
    {ι₀ : Type v} [Nonempty ι₀] (G₀ : ι₀ → T) (hG₀c : ∀ j, IsCompactObject.{v} (G₀ j))
    (hG₀ : (ofObj G₀).IsWeakTriangulatedGenerator) (P : T') (hP : IsCompactObject.{v} P) :
    ∃ c : T, IsCompactObject.{v} c ∧ Nonempty (L.obj c ≅ P ⊞ P⟦(1 : ℤ)⟧) := by
  have := hG₀c
  have := hP
  -- the images of compact objects are closed under cones
  have hcone : ∀ {Y₁ Y₂ Z : T'} (f : Y₁ ⟶ Y₂) (v : Y₂ ⟶ Z) (w : Z ⟶ Y₁⟦(1 : ℤ)⟧),
      Triangle.mk f v w ∈ distTriang T' →
      (∃ c₁ : T, IsCompactObject.{v} c₁ ∧ Nonempty (L.obj c₁ ≅ Y₁)) →
      (∃ c₂ : T, IsCompactObject.{v} c₂ ∧ Nonempty (L.obj c₂ ≅ Y₂)) →
      ∃ c₃ : T, IsCompactObject.{v} c₃ ∧ Nonempty (L.obj c₃ ≅ Z) := by
    rintro Y₁ Y₂ Z f v w hT ⟨c₁, hc₁, ⟨e₁⟩⟩ ⟨c₂, hc₂, ⟨e₂⟩⟩
    obtain ⟨c, s, g', hc, hLs, hg'⟩ :=
      exists_roof adj K hK hLK hloc (c₁ := c₁) (c₂ := c₂) (e₁.hom ≫ f ≫ e₂.inv)
    obtain ⟨c₃, _, _, hT₃⟩ := distinguished_cocone_triangle g'
    have eA : Arrow.mk (L.map g') ≅ Arrow.mk f :=
      Arrow.isoMk (asIso (L.map s) ≪≫ e₁) e₂ (by simp [hg'])
    obtain ⟨e', -⟩ := exists_iso_of_arrow_iso _ _ (L.map_distinguished _ hT₃) hT eA
    exact ⟨c₃, isCompactObject_obj₃ _ hT₃ hc hc₂, ⟨Triangle.π₃.mapIso e'⟩⟩
  -- the summands of images of compact objects form a thick subcategory
  let Λ : ObjectProperty T' :=
    fun Y => ∃ c : T, IsCompactObject.{v} c ∧ Nonempty (Retract Y (L.obj c))
  have hΛiso : Λ.IsClosedUnderIsomorphisms := ⟨fun e ⟨c, hc, ⟨r⟩⟩ =>
    ⟨c, hc, ⟨{ i := e.inv ≫ r.i, r := r.r ≫ e.hom, retract := by simp [r.retract_assoc] }⟩⟩⟩
  have hΛret : Λ.IsStableUnderRetracts := ⟨fun r ⟨c, hc, ⟨r'⟩⟩ => ⟨c, hc, ⟨r.trans r'⟩⟩⟩
  have hΛshift : Λ.IsStableUnderShift ℤ := ⟨fun n => ⟨fun Y ⟨c, hc, ⟨r⟩⟩ =>
    ⟨c⟦n⟧, isCompactObject_shift hc n, ⟨(r.map (shiftFunctor T' n)).trans
      (Retract.ofIso ((L.commShiftIso n).app c).symm)⟩⟩⟩⟩
  have hΛ₃ : ∀ (T₀ : Triangle T'), T₀ ∈ distTriang T' → Λ T₀.obj₁ → Λ T₀.obj₂ → Λ T₀.obj₃ := by
    rintro T₀ hT₀ ⟨c₁, hc₁, ⟨r₁⟩⟩ ⟨c₂, hc₂, ⟨r₂⟩⟩
    obtain ⟨Z₂, v₂, w₂, hT₂⟩ := distinguished_cocone_triangle (r₁.r ≫ T₀.mor₁ ≫ r₂.i)
    obtain ⟨c₃, hc₃, ⟨e₃⟩⟩ := hcone _ v₂ w₂ hT₂ ⟨c₁, hc₁, ⟨Iso.refl _⟩⟩ ⟨c₂, hc₂, ⟨Iso.refl _⟩⟩
    obtain ⟨u, hu₁, hu₂⟩ := complete_distinguished_triangle_morphism _ _ hT₀ hT₂ r₁.i r₂.i (by
      dsimp
      rw [r₁.retract_assoc])
    obtain ⟨u', hu'₁, hu'₂⟩ := complete_distinguished_triangle_morphism _ _ hT₂ hT₀ r₁.r r₂.r (by
      dsimp
      rw [assoc, assoc, r₂.retract, comp_id])
    let φ₁ : T₀ ⟶ Triangle.mk _ v₂ w₂ := ⟨r₁.i, r₂.i, u, by simp, hu₁, hu₂⟩
    let φ₂ : Triangle.mk _ v₂ w₂ ⟶ T₀ := ⟨r₁.r, r₂.r, u', by simp, hu'₁, hu'₂⟩
    have h₁ : (φ₁ ≫ φ₂).hom₁ = 𝟙 _ := by simp [φ₁, φ₂, r₁.retract]
    have h₂ : (φ₁ ≫ φ₂).hom₂ = 𝟙 _ := by simp [φ₁, φ₂, r₂.retract]
    have : IsIso (u ≫ u') := isIso₃_of_isIso₁₂ (φ₁ ≫ φ₂) hT₀ hT₀
      (by rw [h₁]; infer_instance) (by rw [h₂]; infer_instance)
    refine ⟨c₃, hc₃, ⟨{ i := u ≫ e₃.inv, r := e₃.hom ≫ u' ≫ inv (u ≫ u'), retract := ?_ }⟩⟩
    simp only [assoc, Iso.inv_hom_id_assoc]
    rw [← assoc, IsIso.hom_inv_id]
  have hΛtri : Λ.IsTriangulated := by
    have hz : Λ.ContainsZero := ⟨⟨L.obj 0, L.map_isZero (isZero_zero T),
      ⟨0, isCompactObject_zero', ⟨Retract.refl _⟩⟩⟩⟩
    have he : Λ.IsTriangulatedClosed₂ := IsTriangulatedClosed₂.mk' fun T₀ hT₀ h₁ h₃ =>
      hΛ₃ _ (inv_rot_of_distTriang _ hT₀) (Λ.le_shift (-1) _ h₃) h₁
    exact ⟨⟩
  -- every compact object of `T'` is a summand of the image of a compact object
  have hgen : (ofObj fun j => L.obj (G₀ j)).IsWeakTriangulatedGenerator :=
    ObjectProperty.isWeakTriangulatedGenerator_ofObj_map_of_reflects_isZero adj
      (ObjectProperty.isZero_of_isZero_obj_of_isIso_counit adj fun _ => inferInstance) G₀ hG₀
  have : G.Additive := adj.right_adjoint_additive
  have : ∀ j, IsCompactObject.{v} (L.obj (G₀ j)) := fun j =>
    isCompactObject_map_of_adjunction adj inferInstance
  have henv := triangEnvelope_eq_isCompactObject_of_isWeakTriangulatedGenerator_ofObj
    (fun j => L.obj (G₀ j)) hgen
  have hle : (ofObj fun j => L.obj (G₀ j)).triangEnvelope ≤ Λ := by
    rw [triangEnvelope_le_iff, ofObj_le_iff]
    exact fun j => ⟨G₀ j, inferInstance, ⟨Retract.refl _⟩⟩
  obtain ⟨c₀, hc₀, ⟨r⟩⟩ : Λ P :=
    hle _ (by rw [henv]; exact (inferInstance : IsCompactObject.{v} P))
  -- Thomason's trick
  obtain ⟨C, q, δ, hT⟩ := distinguished_cocone_triangle r.i
  have : Mono r.i := ⟨fun g h hgh => by simpa using hgh =≫ r.r⟩
  have hδ : δ = 0 := Triangle.mor₃_eq_zero_of_mono₁ _ hT (by dsimp; infer_instance)
  obtain ⟨e, -, -⟩ := exists_iso_binaryBiproduct_of_distTriang _ hT hδ
  obtain ⟨Z, v, w, hZ⟩ := distinguished_cocone_triangle (biprod.snd ≫ biprod.inr : P ⊞ C ⟶ P ⊞ C)
  obtain ⟨c₃, hc₃, ⟨e₃⟩⟩ := hcone _ v w hZ ⟨c₀, hc₀, ⟨e⟩⟩ ⟨c₀, hc₀, ⟨e⟩⟩
  obtain ⟨e'⟩ := nonempty_iso_of_distTriang_snd_inr P C v w hZ
  exact ⟨c₃, hc₃, ⟨e₃ ≪≫ e' ≪≫ biprod.braiding _ _⟩⟩

end Lift

end CategoryTheory.Pretriangulated
