module

public import Mathlib.CategoryTheory.Triangulated.Orthogonal
public import StacksFrontier.CategoryTheory.ObjectProperty.OrthogonalClosure
public import StacksFrontier.CategoryTheory.Triangulated.LocalizingClosure
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Local objects for a localizing subcategory

Let `C` be a pretriangulated category and let `P : ObjectProperty C` be a family of generators.
Write `N = P.localizingClosure` for the localizing subcategory it generates
(`StacksFrontier/CategoryTheory/Triangulated/LocalizingClosure.lean`). The *local* objects for `N`
are the objects of the right orthogonal `N.rightOrthogonal`, written `N^⊥`: those `Y` such that
every morphism `X ⟶ Y` with `X` in `N` vanishes.

The point of this file is that membership in `N^⊥` can be tested on the generators alone, in all
degrees: `Y` is local if and only if every morphism `X⟦n⟧ ⟶ Y`, equivalently every morphism
`X ⟶ Y⟦n⟧`, vanishes for every `X` satisfying `P` and every `n : ℤ`
(`ObjectProperty.rightOrthogonal_localizingClosure_iff` and its primed form). The proof is the
universal property of the localizing closure applied to the left orthogonal of the shifts of
`Y`, which is closed under exactly the five operations that generate `N`: isomorphisms (Mathlib),
shifts (Mathlib), extensions (Mathlib's `ObjectProperty.leftOrthogonal.IsTriangulatedClosed₂`),
retracts and colimits (`StacksFrontier/CategoryTheory/ObjectProperty/OrthogonalClosure.lean`). It is
closure under *colimits* that makes the statement hold for the localizing closure and not only
for the thick subcategory generated by `P`; the thick case is Stacks 09SK, already formalized in
`StacksFrontier/CategoryTheory/Triangulated/Generators.lean`.

The closure properties of `N^⊥` itself are all already available: Mathlib proves that the right
orthogonal of a shift-stable property is a triangulated subcategory, and this repository adds
that it is stable under retracts and closed under limits. They are recorded here as examples, so
that the file can be cited for "`N^⊥` is a localizing-subcategory-like object closed under
limits".

Finally, Mathlib's `ObjectProperty.isLocal_trW` identifies `N^⊥` with the objects that are local
for the class of morphisms `N.trW` inverted by the Verdier quotient, and
`ObjectProperty.rightOrthogonal.map_bijective_of_isTriangulated` says that the quotient functor
is fully faithful on morphisms into a local object. Both are specialized here to a localizing
closure.

## Main results

* `CategoryTheory.ObjectProperty.rightOrthogonal_localizingClosure`: `N^⊥` depends only on the
  shifts of the generators.
* `CategoryTheory.ObjectProperty.rightOrthogonal_localizingClosure_iff` and
  `rightOrthogonal_localizingClosure_iff'`: the degreewise criterion for being local.
* `CategoryTheory.ObjectProperty.isLocal_trW_localizingClosure`: the local objects of `N.trW`.
-/

@[expose] public section

universe w v u

namespace CategoryTheory.ObjectProperty

open Category Limits Pretriangulated

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C] (P : ObjectProperty C)

omit [HasZeroObject C] [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C] in
/-- An object is right orthogonal to the shift closure of `P` exactly when every morphism into
it from a shift of an object satisfying `P` vanishes. -/
lemma rightOrthogonal_shiftClosure_iff (Y : C) :
    (P.shiftClosure ℤ).rightOrthogonal Y ↔
      ∀ (X : C), P X → ∀ (n : ℤ) (f : X⟦n⟧ ⟶ Y), f = 0 := by
  refine ⟨fun h X hX n f ↦ h f ⟨X, n, Iso.refl _, hX⟩, ?_⟩
  rintro h Z f ⟨W, n, e, hW⟩
  rw [← cancel_epi e.inv, comp_zero]
  exact h W hW n _

/-- An object is right orthogonal to the localizing subcategory generated by `P` exactly when it
is right orthogonal to the shifts of the objects satisfying `P`. The nontrivial direction is the
universal property of `P.localizingClosure` applied to the left orthogonal of the shifts of `Y`,
which has all five closure properties. -/
theorem rightOrthogonal_localizingClosure_apply (Y : C) :
    (P.localizingClosure.{w}).rightOrthogonal Y ↔ (P.shiftClosure ℤ).rightOrthogonal Y := by
  refine ⟨fun hY ↦ rightOrthogonal_antitone P.shiftClosure_le_localizingClosure _ hY,
    fun hY ↦ ?_⟩
  have key : P.localizingClosure.{w} ≤ ((singleton Y).shiftClosure ℤ).leftOrthogonal := by
    refine localizingClosure_le fun Z hZ W g hW ↦ ?_
    obtain ⟨V, a, e, hV⟩ := hW
    obtain rfl := (singleton_iff _ _).1 hV
    rw [← cancel_mono e.hom, zero_comp]
    exact (P.shiftClosure ℤ).rightOrthogonal.le_shift a Y hY _
      (le_shiftClosure (A := ℤ) P Z hZ)
  intro X f hX
  exact key X hX f ⟨Y, 0, ((shiftFunctorZero C ℤ).app Y).symm, (singleton_iff Y Y).2 rfl⟩

/-- The right orthogonal of the localizing subcategory generated by `P` is the right orthogonal
of the shift closure of `P`. -/
theorem rightOrthogonal_localizingClosure :
    (P.localizingClosure.{w}).rightOrthogonal = (P.shiftClosure ℤ).rightOrthogonal := by
  ext Y
  exact P.rightOrthogonal_localizingClosure_apply Y

/-- For objects `X` and `Y` of a category with a shift by `ℤ` indexed by an additive group, the
morphisms out of all the shifts of `X` into `Y` vanish exactly when the morphisms from `X` into
all the shifts of `Y` vanish: the two families correspond under the adjunctions given by the
shift equivalences. -/
lemma forall_shift_hom_eq_zero_iff (X Y : C) :
    (∀ (n : ℤ) (f : X⟦n⟧ ⟶ Y), f = 0) ↔ ∀ (n : ℤ) (g : X ⟶ Y⟦n⟧), g = 0 := by
  refine ⟨fun h n g ↦ ?_, fun h n f ↦ ?_⟩
  · let q := (shiftEquiv C n).symm.toAdjunction.homEquiv X Y
    rw [← q.apply_symm_apply g, h (-n) (q.symm g)]
    show q 0 = 0
    simp [q, Adjunction.homEquiv_apply]
  · let p := (shiftEquiv C n).toAdjunction.homEquiv X Y
    rw [← p.symm_apply_apply f, h (-n) (p f)]
    show p.symm 0 = 0
    simp [p, Adjunction.homEquiv_symm_apply]

/-- **The criterion for an object to be local.** An object `Y` lies in the right orthogonal of
the localizing subcategory generated by `P` if and only if every morphism `X⟦n⟧ ⟶ Y` vanishes,
for every object `X` satisfying `P` and every `n : ℤ`. -/
theorem rightOrthogonal_localizingClosure_iff (Y : C) :
    (P.localizingClosure.{w}).rightOrthogonal Y ↔
      ∀ (X : C), P X → ∀ (n : ℤ) (f : X⟦n⟧ ⟶ Y), f = 0 :=
  (P.rightOrthogonal_localizingClosure_apply Y).trans (P.rightOrthogonal_shiftClosure_iff Y)

/-- **The criterion for an object to be local**, in the form in which it is usually stated: `Y`
lies in the right orthogonal of the localizing subcategory generated by `P` if and only if
`Hom(X, Y⟦n⟧) = 0` for every object `X` satisfying `P` and every `n : ℤ`. -/
theorem rightOrthogonal_localizingClosure_iff' (Y : C) :
    (P.localizingClosure.{w}).rightOrthogonal Y ↔
      ∀ (X : C), P X → ∀ (n : ℤ) (f : X ⟶ Y⟦n⟧), f = 0 :=
  (P.rightOrthogonal_localizingClosure_iff Y).trans
    (forall_congr' fun X ↦ forall_congr' fun _ ↦ forall_shift_hom_eq_zero_iff X Y)

section ClosureProperties

variable (Y : C)

example : (P.localizingClosure.{w}).rightOrthogonal.IsClosedUnderIsomorphisms := inferInstance

example : (P.localizingClosure.{w}).rightOrthogonal.IsStableUnderRetracts := inferInstance

example : (P.localizingClosure.{w}).rightOrthogonal.IsStableUnderShift ℤ := inferInstance

example : (P.localizingClosure.{w}).rightOrthogonal.IsTriangulated := inferInstance

example (J : Type*) [Category J] :
    (P.localizingClosure.{w}).rightOrthogonal.IsClosedUnderLimitsOfShape J := inferInstance

end ClosureProperties

section Localization

variable [IsTriangulated C]

omit [IsTriangulated C] in
/-- The objects which are local for the class of morphisms inverted by the Verdier quotient by
the localizing subcategory generated by `P` are exactly the objects `Y` with no nonzero morphism
from a shift of a generator. This is Mathlib's `ObjectProperty.isLocal_trW` combined with
`rightOrthogonal_localizingClosure`. -/
theorem isLocal_trW_localizingClosure :
    (P.localizingClosure.{w}).trW.isLocal = (P.shiftClosure ℤ).rightOrthogonal := by
  rw [isLocal_trW, rightOrthogonal_localizingClosure]

variable {D : Type*} [Category D]

/-- A morphism into a local object is not changed by the Verdier quotient: for `Y` in the right
orthogonal of the localizing subcategory generated by `P`, the localization functor induces a
bijection on morphisms into `Y`. This is Mathlib's
`ObjectProperty.rightOrthogonal.map_bijective_of_isTriangulated`. -/
@[sga "4½ Etat_0 2.5.3" "(b)", sga "4½ Etat_0 2.6.3" "Right clause of 6-3"]
theorem map_bijective_of_rightOrthogonal_localizingClosure {Y : C}
    (hY : (P.localizingClosure.{w}).rightOrthogonal Y)
    (L : C ⥤ D) [L.IsLocalization (P.localizingClosure.{w}).trW] (X : C) :
    Function.Bijective (L.map : (X ⟶ Y) → _) :=
  rightOrthogonal.map_bijective_of_isTriangulated hY L X

end Localization

end CategoryTheory.ObjectProperty
