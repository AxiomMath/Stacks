/-!
# Compactly generated triangulated categories which are only locally small

Several results about compactly generated triangulated categories are stated for a category
whose morphisms live in `Type w` and which has coproducts indexed by `Type w`. A derived category
of the standard model has morphisms one universe up, yet it is `LocallySmall.{w}` and has
`Type w`-indexed coproducts. This file transports three such results to that setting along the
triangulated equivalence with a model with small morphisms,
`CategoryTheory.Pretriangulated.exists_triangulatedEquivalence_of_locallySmall`.

## Main results

* `CategoryTheory.Pretriangulated.exists_isCompactObject_iso_biprod_shift_of_locallySmall`:
  lifting a compact object along a finite localization up to its sum with its shift
  ([Stacks, Tag 08EK] in the form of Thomason–Trobaugh and Neeman).
* `CategoryTheory.Pretriangulated.exists_distTriang_localizingClosure_rightOrthogonal`: every
  object is an extension of an object right orthogonal to a set of compact objects by an object of
  the localizing subcategory they generate.
* `CategoryTheory.Pretriangulated.exists_isTriangulated_rightAdjoint_of_compact_generator`:
  Brown representability ([Stacks, Tag 0A8G]) with the right adjoint exhibited as exact, and
  `CategoryTheory.Pretriangulated.exists_isTriangulated_rightAdjoint_lift_of_compact_generator`,
  its form for a functor restricted to triangulated full subcategories.

## References

* [Stacks Project, Tag 08EK](https://stacks.math.columbia.edu/tag/08EK)
* [Stacks Project, Tag 0A8G](https://stacks.math.columbia.edu/tag/0A8G)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open CategoryTheory.ObjectProperty
open Opposite
open scoped ZeroObject

universe w v v' u u'

namespace CategoryTheory.Pretriangulated

section Transport

variable {C : Type u} {D : Type u'} [Category.{v} C] [Category.{v'} D]
  [Preadditive C] [Preadditive D] [HasShift C ℤ] [HasShift D ℤ]
  (e : C ≌ D) [e.functor.CommShift ℤ] [e.functor.Additive]

/-- Right orthogonality to the shifts of a family transports along an equivalence commuting with
the shift: an object right orthogonal to the shifts of the images `e K i` has its image under the
inverse right orthogonal to the shifts of the `K i`. -/
theorem rightOrthogonal_shiftClosure_ofObj_inverse {ι : Type*} (K : ι → C) (X : D)
    (hX : ((ofObj fun i => e.functor.obj (K i)).shiftClosure ℤ).rightOrthogonal X) :
    ((ofObj K).shiftClosure ℤ).rightOrthogonal (e.inverse.obj X) := by
  rw [rightOrthogonal_shiftClosure_ofObj_iff] at hX ⊢
  intro i a f
  have h := hX i a (((e.functor.commShiftIso a).app (K i)).inv ≫ e.functor.map f ≫
    e.counit.app X)
  have h' : e.functor.map f = 0 := by
    rw [← cancel_epi ((e.functor.commShiftIso a).app (K i)).inv,
      ← cancel_mono (e.counit.app X)]
    simpa using h
  exact e.functor.map_injective (h'.trans (e.functor.map_zero _ _).symm)

/-- A weak triangulated generating family transports along an equivalence commuting with the
shift. -/
theorem isWeakTriangulatedGenerator_ofObj_of_equivalence [HasZeroObject C] [HasZeroObject D]
    {ι : Type*} (K : ι → C) (hK : (ofObj K).IsWeakTriangulatedGenerator) :
    (ofObj fun i => e.functor.obj (K i)).IsWeakTriangulatedGenerator := fun X hX =>
  (Functor.map_isZero e.functor (hK _ (rightOrthogonal_shiftClosure_ofObj_inverse e K X hX))).of_iso
    (e.counitIso.app X).symm

end Transport

section CompactLift

variable {T : Type u} [Category.{v} T] [Preadditive T] [HasZeroObject T] [HasShift T ℤ]
  [∀ n : ℤ, (shiftFunctor T n).Additive] [Pretriangulated T] [IsTriangulated T]
  [LocallySmall.{w} T] [HasCoproducts.{w} T]
  {T' : Type u'} [Category.{v'} T'] [Preadditive T'] [HasZeroObject T'] [HasShift T' ℤ]
  [∀ n : ℤ, (shiftFunctor T' n).Additive] [Pretriangulated T'] [IsTriangulated T']
  [LocallySmall.{w} T'] [HasCoproducts.{w} T']

/-- **Lifting a compact object up to its sum with its shift, for locally small categories**
([Stacks, Tag 08EK] in the form of Thomason–Trobaugh and Neeman). This is
`CategoryTheory.Pretriangulated.exists_isCompactObject_iso_biprod_shift` for triangulated
categories `T` and `T'` whose morphisms are only `w`-small and which have coproducts indexed by
`Type w`, compactness and generation being tested against `Type w`-indexed coproducts. Let
`L ⊣ G` with `L` exact, `G` fully faithful and commuting with direct sums, `T` compactly
generated by a nonempty family `G₀`, and let the kernel of `L` be detected by compact objects
`K i` killed by `L`. Then every compact object `P` of `T'` has `L c ≅ P ⊕ P[1]` for a compact `c`.

The proof transports the statement to the models with small morphisms of
`exists_triangulatedEquivalence_of_locallySmall`. -/
theorem exists_isCompactObject_iso_biprod_shift_of_locallySmall
    {L : T ⥤ T'} {G : T' ⥤ T} (adj : L ⊣ G) [L.CommShift ℤ] [L.IsTriangulated]
    [IsIso adj.counit] [∀ J : Type w, PreservesColimitsOfShape (Discrete J) G]
    {ι : Type w} (K : ι → T)
    (hK : ∀ i, IsCompactObject.{w} (K i)) (hLK : ∀ i, IsZero (L.obj (K i)))
    (hloc : ∀ E : T, (∀ i (n : ℤ) (g : (K i)⟦n⟧ ⟶ E), g = 0) → IsIso (adj.unit.app E))
    {ι₀ : Type w} [Nonempty ι₀] (G₀ : ι₀ → T) (hG₀c : ∀ j, IsCompactObject.{w} (G₀ j))
    (hG₀ : (ofObj G₀).IsWeakTriangulatedGenerator) (P : T') (hP : IsCompactObject.{w} P) :
    ∃ c : T, IsCompactObject.{w} c ∧ Nonempty (L.obj c ≅ P ⊞ P⟦(1 : ℤ)⟧) := by
  obtain ⟨D, _, _, _, _, _, _, e, _, _, _, _, _, _, hD⟩ :=
    exists_triangulatedEquivalence_of_locallySmall.{w} T
  have := hD inferInstance
  obtain ⟨D', _, _, _, _, _, _, e', _, _, _, _, _, _, hD'⟩ :=
    exists_triangulatedEquivalence_of_locallySmall.{w} T'
  have := hD' inferInstance
  have : HasCoproducts.{w} D := fun _ => Adjunction.hasColimitsOfShape_of_equivalence e.inverse
  have : HasCoproducts.{w} D' := fun _ => Adjunction.hasColimitsOfShape_of_equivalence e'.inverse
  let hGff := adj.fullyFaithfulROfIsIsoCounit
  have : G.Full := hGff.full
  have : G.Faithful := hGff.faithful
  let adjs : e.inverse ⋙ L ⋙ e'.functor ⊣ e'.inverse ⋙ G ⋙ e.functor :=
    e.symm.toAdjunction.comp (adj.comp e'.toAdjunction)
  let Ks : ι → D := fun i => e.functor.obj (K i)
  have hKs : ∀ i, IsCompactObject.{w} (Ks i) := fun i =>
    (isCompactObject_iff_isCompactObject_obj e.functor (K i)).1 (hK i)
  have hLKs : ∀ i, IsZero ((e.inverse ⋙ L ⋙ e'.functor).obj (Ks i)) := fun i =>
    Functor.map_isZero e'.functor ((hLK i).of_iso (L.mapIso (e.unitIso.app (K i)).symm))
  have hlocs : ∀ E : D, (∀ i (n : ℤ) (g : (Ks i)⟦n⟧ ⟶ E), g = 0) →
      IsIso (adjs.unit.app E) := by
    intro E hE
    have hE0 := rightOrthogonal_shiftClosure_ofObj_inverse e K E
      ((rightOrthogonal_shiftClosure_ofObj_iff _ _).2 hE)
    rw [rightOrthogonal_shiftClosure_ofObj_iff] at hE0
    have hu : IsIso (adj.unit.app (e.inverse.obj E)) := hloc _ hE0
    obtain ⟨Y, ⟨eY⟩⟩ := (adj.isIso_unit_app_iff_mem_essImage).1 hu
    refine (adjs.isIso_unit_app_iff_mem_essImage).2 ⟨e'.functor.obj Y, ⟨?_⟩⟩
    exact e.functor.mapIso (G.mapIso (e'.unitIso.app Y).symm ≪≫ eY) ≪≫ e.counitIso.app E
  let G₀s : ι₀ → D := fun j => e.functor.obj (G₀ j)
  have hG₀sc : ∀ j, IsCompactObject.{w} (G₀s j) := fun j =>
    (isCompactObject_iff_isCompactObject_obj e.functor (G₀ j)).1 (hG₀c j)
  have hG₀s : (ofObj G₀s).IsWeakTriangulatedGenerator :=
    isWeakTriangulatedGenerator_ofObj_of_equivalence e G₀ hG₀
  have hPs : IsCompactObject.{w} (e'.functor.obj P) :=
    (isCompactObject_iff_isCompactObject_obj e'.functor P).1 hP
  have : IsIso adjs.counit := inferInstance
  obtain ⟨c, hc, ⟨ec⟩⟩ := exists_isCompactObject_iso_biprod_shift adjs Ks hKs hLKs hlocs G₀s
    hG₀sc hG₀s (e'.functor.obj P) hPs
  refine ⟨e.inverse.obj c, (isCompactObject_iff_isCompactObject_obj e.inverse c).1 hc, ⟨?_⟩⟩
  have := preservesBinaryBiproducts_of_preservesBiproducts e'.functor
  refine e'.fullyFaithfulFunctor.preimageIso (ec ≪≫ ?_)
  exact (biprod.mapIso (Iso.refl _) ((e'.functor.commShiftIso (1 : ℤ)).app P).symm) ≪≫
    (e'.functor.mapBiprod P (P⟦(1 : ℤ)⟧)).symm

end CompactLift

section Bousfield

variable {T : Type u} [Category.{v} T] [Preadditive T] [HasZeroObject T] [HasShift T ℤ]
  [∀ n : ℤ, (shiftFunctor T n).Additive] [Pretriangulated T] [IsTriangulated T]
  [LocallySmall.{w} T] [HasCoproducts.{w} T]

omit [IsTriangulated T] [LocallySmall.{w} T] in
/-- An exact equivalence which preserves `Type w`-indexed coproducts carries the localizing
closure of a property to the localizing closure of its image. -/
theorem localizingClosure_obj_of_equivalence {D : Type u'} [Category.{v'} D] [Preadditive D]
    [HasZeroObject D] [HasShift D ℤ] [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
    (F : D ⥤ T) [F.IsEquivalence] [F.CommShift ℤ] [F.IsTriangulated]
    (P : ObjectProperty D) {X : D} (hX : P.localizingClosure.{w} X) :
    (P.map F).localizingClosure.{w} (F.obj X) := by
  induction hX with
  | of_mem hX => exact le_localizingClosure _ _ ⟨_, hX, ⟨Iso.refl _⟩⟩
  | of_iso e _ ih => exact prop_of_iso _ (F.mapIso e) ih
  | of_shift n _ ih =>
    exact prop_of_iso _ ((F.commShiftIso n).app _).symm (le_shift _ n _ ih)
  | of_retract r _ ih => exact prop_of_retract _ (r.map F) ih
  | of_ext T hT _ _ ih₁ ih₃ =>
    exact ext_of_isTriangulatedClosed₂ _ _ (F.map_distinguished _ hT) ih₁ ih₃
  | of_colimitPresentation pres _ ih =>
    exact prop_of_isColimit _ (isColimitOfPreserves F pres.isColimit) ih

/-- **The Bousfield triangle of a set of compact objects, for a locally small category.** Let
`T` be a triangulated category which is `LocallySmall.{w}` and has `Type w`-indexed coproducts,
and let `K : ι → T`, `ι : Type w`, be a family of compact objects. Every object `E` sits in a
distinguished triangle `E' ⟶ E ⟶ E'' ⟶ E'[1]` with `E'` in the localizing subcategory generated
by the `K i` and `E''` right orthogonal to every shift of every `K i`.

This is `CategoryTheory.ObjectProperty.extensionProduct_localizingClosure_rightOrthogonal_eq_top`
transported along the equivalence with a model with small morphisms. -/
theorem exists_distTriang_localizingClosure_rightOrthogonal
    {ι : Type w} (K : ι → T) (hK : ∀ i, IsCompactObject.{w} (K i)) (E : T) :
    ∃ (E' E'' : T) (f : E' ⟶ E) (g : E ⟶ E'') (h : E'' ⟶ E'⟦(1 : ℤ)⟧),
      Triangle.mk f g h ∈ distTriang T ∧ (ofObj K).localizingClosure.{w} E' ∧
        ((ofObj K).shiftClosure ℤ).rightOrthogonal E'' := by
  obtain ⟨D, _, _, _, _, _, _, e, _, _, _, _, _, _, hD⟩ :=
    exists_triangulatedEquivalence_of_locallySmall.{w} T
  have := hD inferInstance
  have : HasCoproducts.{w} D := fun _ => Adjunction.hasColimitsOfShape_of_equivalence e.inverse
  let Ks : ι → D := fun i => e.functor.obj (K i)
  have : ∀ i, IsCompactObject.{w} (Ks i) := fun i =>
    (isCompactObject_iff_isCompactObject_obj e.functor (K i)).1 (hK i)
  have : ∀ (i : ι) (α : Type w),
      PreservesColimitsOfShape (Discrete α) (preadditiveCoyoneda.obj (op (Ks i))) :=
    fun i α => preservesCoproducts_preadditiveCoyoneda_of_isCompactObject (Ks i) α
  have htop := extensionProduct_localizingClosure_rightOrthogonal_eq_top Ks
  have hE : ((ofObj Ks).localizingClosure.{w}.extensionProduct
      (ofObj Ks).localizingClosure.{w}.rightOrthogonal) (e.functor.obj E) := by
    rw [htop]; trivial
  obtain ⟨Y, Z, f, g, h, hT, hY, hZ⟩ := hE
  have hT' : Triangle.mk (e.inverse.map f) (e.inverse.map g)
      (e.inverse.map h ≫ (e.inverse.commShiftIso (1 : ℤ)).hom.app Y) ∈ distTriang T :=
    e.inverse.map_distinguished _ hT
  refine ⟨e.inverse.obj Y, e.inverse.obj Z, e.inverse.map f ≫ e.unitIso.inv.app E,
    e.unitIso.hom.app E ≫ e.inverse.map g,
    e.inverse.map h ≫ (e.inverse.commShiftIso (1 : ℤ)).hom.app Y, ?_, ?_, ?_⟩
  · refine isomorphic_distinguished _ hT' _ (Triangle.isoMk _ _ (Iso.refl _)
      (e.unitIso.app E) (Iso.refl _) ?_ ?_ ?_)
    · simp
    · simp
    · simp
  · have hle : (ofObj Ks).map e.inverse ≤ (ofObj K).localizingClosure.{w} := by
      rintro _ ⟨_, ⟨i⟩, ⟨eX⟩⟩
      exact prop_of_iso _ (e.unitIso.app (K i) ≪≫ eX)
        (le_localizingClosure (ofObj K) (K i) ⟨i⟩)
    exact localizingClosure_le hle _ (localizingClosure_obj_of_equivalence e.inverse _ hY)
  · refine rightOrthogonal_shiftClosure_ofObj_inverse e K Z ?_
    intro A φ hA
    exact hZ φ (shiftClosure_le_localizingClosure _ _ hA)

end Bousfield

section Brown

variable {C : Type u} {D : Type u'} [Category.{v} C] [Category.{v'} D]
  [HasZeroObject C] [HasZeroObject D] [Preadditive C] [Preadditive D]
  [HasShift C ℤ] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [∀ n : ℤ, (shiftFunctor D n).Additive]
  [Pretriangulated C] [Pretriangulated D]

/-- **An exact left adjoint has an exact right adjoint** ([Stacks, Tag 0A8D]): the right adjoint
of an exact functor of pretriangulated categories carries a shift structure for which the
adjunction is triangulated. No universe constraint relates the two categories. -/
@[sga "4 XVII 2.2.13.1" "Triangulated case", sga "4½ Etat_0 2.6.7" "more general"]
theorem exists_isTriangulated_rightAdjoint_of_isLeftAdjoint (F : C ⥤ D) [F.CommShift ℤ]
    [F.IsTriangulated] [F.IsLeftAdjoint] :
    ∃ (G : D ⥤ C) (adj : F ⊣ G) (_ : G.CommShift ℤ), adj.IsTriangulated := by
  let adj : F ⊣ F.rightAdjoint := Adjunction.ofIsLeftAdjoint F
  let := adj.rightAdjointCommShift ℤ
  have := adj.commShift_of_leftAdjoint ℤ
  exact ⟨F.rightAdjoint, adj, inferInstance, Adjunction.IsTriangulated.mk' adj⟩

/-- **Brown representability with an exact right adjoint, for locally small categories**
([Stacks, Tag 0A8G]). Let `C` be a triangulated category which is `LocallySmall.{w}`, has
`Type w`-indexed coproducts and has a compact object which is a weak triangulated generator,
and let `F : C ⥤ D` be an exact functor into a locally small pretriangulated category which
preserves `Type w`-indexed coproducts. Then `F` has a right adjoint `G`, and `G` carries a shift
structure for which the adjunction `F ⊣ G` is triangulated. -/
@[sga "4 XVII 2.2.13.1" "Triangulated case"]
theorem exists_isTriangulated_rightAdjoint_of_compact_generator
    [LocallySmall.{w} C] [LocallySmall.{w} D] [IsTriangulated C] [HasCoproducts.{w} C]
    (F : C ⥤ D) [F.CommShift ℤ] [F.IsTriangulated]
    [∀ I : Type w, PreservesColimitsOfShape (Discrete I) F]
    (generator : C) [IsCompactObject.{w} generator]
    (hgenerator : (ObjectProperty.singleton generator).IsWeakTriangulatedGenerator) :
    ∃ (G : D ⥤ C) (adj : F ⊣ G) (_ : G.CommShift ℤ), adj.IsTriangulated :=
  have : F.IsLeftAdjoint :=
    isLeftAdjoint_of_compact_generator F inferInstance inferInstance generator hgenerator
  exists_isTriangulated_rightAdjoint_of_isLeftAdjoint F

/-- The form of `exists_isTriangulated_rightAdjoint_of_compact_generator` for a functor
restricted to triangulated full subcategories: if an exact functor `F : C ⥤ D` carries a
triangulated full subcategory `P` of `C` into a triangulated full subcategory `Q` of `D`, and the
lift preserves `Type w`-indexed coproducts, then the lift has a right adjoint which is exact for a
shift structure making the adjunction triangulated, as soon as `P.FullSubcategory` is locally
small, has coproducts and has a compact weak generator. -/
theorem exists_isTriangulated_rightAdjoint_lift_of_compact_generator [IsTriangulated C]
    (P : ObjectProperty C) (Q : ObjectProperty D)
    [P.IsTriangulated] [Q.IsTriangulated]
    [P.IsClosedUnderIsomorphisms] [Q.IsClosedUnderIsomorphisms]
    [LocallySmall.{w} P.FullSubcategory] [LocallySmall.{w} Q.FullSubcategory]
    [HasCoproducts.{w} P.FullSubcategory]
    (F : C ⥤ D) [F.CommShift ℤ] [F.IsTriangulated]
    (hF : ∀ X : P.FullSubcategory, Q (F.obj X.obj))
    [∀ I : Type w, PreservesColimitsOfShape (Discrete I) (Q.lift (P.ι ⋙ F) hF)]
    (generator : P.FullSubcategory) [IsCompactObject.{w} generator]
    (hgenerator : (ObjectProperty.singleton generator).IsWeakTriangulatedGenerator) :
    ∃ (_ : (Q.lift (P.ι ⋙ F) hF).CommShift ℤ) (_ : (Q.lift (P.ι ⋙ F) hF).IsTriangulated)
      (G : Q.FullSubcategory ⥤ P.FullSubcategory) (adj : Q.lift (P.ι ⋙ F) hF ⊣ G)
      (_ : G.CommShift ℤ), adj.IsTriangulated := by
  let inclusionIso := Q.liftCompιIso (P.ι ⋙ F) hF
  let : (P.ι ⋙ F).CommShift ℤ := inferInstance
  let : (Q.lift (P.ι ⋙ F) hF).CommShift ℤ := Functor.CommShift.ofComp inclusionIso ℤ
  let : NatTrans.CommShift inclusionIso.hom ℤ :=
    Functor.CommShift.ofComp_compatibility inclusionIso ℤ
  have : (Q.lift (P.ι ⋙ F) hF).IsTriangulated :=
    (Functor.isTriangulated_iff_comp_right inclusionIso).2 inferInstance
  have : (Q.lift (P.ι ⋙ F) hF).IsLeftAdjoint :=
    isLeftAdjoint_lift_of_compact_generator P Q F inferInstance inferInstance hF generator
      hgenerator
  exact ⟨inferInstance, inferInstance,
    exists_isTriangulated_rightAdjoint_of_isLeftAdjoint (Q.lift (P.ι ⋙ F) hF)⟩

end Brown

end CategoryTheory.Pretriangulated

