module

public import StacksFrontier.CategoryTheory.Triangulated.LocallySmallCompactEnvelope

/-!
# Neeman's factorization in a locally small triangulated category

Let `T` be a triangulated category which is `LocallySmall.{w}` and has coproducts indexed by
`Type w`, but whose morphisms may live in a larger universe (a derived category of the standard
model). This file transports Neeman's factorization lemma
`CategoryTheory.Pretriangulated.exists_fac_triangEnvelope_of_localizingClosure` (which packages
[Stacks, Tag 09SN], [Stacks, Tag 094A] and [Stacks, Tag 09SP]) to `T`, along the triangulated
equivalence with a model with small morphisms, and draws from it the consequence used in the proof
of [Stacks, Tag 0AEE].

## Main results

* `CategoryTheory.Pretriangulated.exists_fac_triangEnvelope_of_localizingClosure_of_locallySmall`:
  a morphism from a compact object into an object of the localizing subcategory generated by a
  family of compact objects factors through the triangulated envelope of a finite direct sum of
  the members of the family.
* `CategoryTheory.Pretriangulated.isZero_obj_of_localizingClosure_of_isLeftAdjoint`: an exact
  left adjoint kills the localizing subcategory generated by objects it kills.
* `CategoryTheory.Pretriangulated.exists_distTriang_comp_eq_zero_of_isZero_of_locallySmall`: let
  `L` be an exact left adjoint out of `T` and `G` a compact object killed by `L` which detects the
  zero objects among those killed by `L`. Then every morphism `α : c ⟶ K` from a compact object
  `c` into an object `K` killed by `L` is killed by the first map of a distinguished triangle
  `I ⟶ c ⟶ Z ⟶ I[1]` with `Z` compact and killed by `L`.

## References

* [Stacks Project, Tag 09SN](https://stacks.math.columbia.edu/tag/09SN)
* [Stacks Project, Tag 094A](https://stacks.math.columbia.edu/tag/094A)
* [Stacks Project, Tag 09SP](https://stacks.math.columbia.edu/tag/09SP)
* [Stacks Project, Tag 0AEE](https://stacks.math.columbia.edu/tag/0AEE)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.ObjectProperty
open scoped ZeroObject

universe w v v' u u'

namespace CategoryTheory.Pretriangulated

/-- The triangulated envelope of an object depends only on the object up to isomorphism. -/
theorem triangEnvelope_singleton_le_of_iso {C : Type*} [Category C] [Preadditive C]
    [HasZeroObject C] [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    [IsTriangulated C] {A A' : C} (e : A ≅ A') :
    (ObjectProperty.singleton A).triangEnvelope ≤ (ObjectProperty.singleton A').triangEnvelope := by
  rw [ObjectProperty.triangEnvelope_le_iff, ObjectProperty.singleton_le_iff]
  exact ObjectProperty.prop_of_iso _ e.symm
    (ObjectProperty.le_triangEnvelope _ _ ((ObjectProperty.singleton_iff _ _).2 rfl))

section Factor

variable {T : Type u} [Category.{v} T] [Preadditive T] [HasZeroObject T] [HasShift T ℤ]
  [∀ n : ℤ, (shiftFunctor T n).Additive] [Pretriangulated T] [IsTriangulated T]
  [LocallySmall.{w} T] [HasCoproducts.{w} T]

/-- **Neeman's factorization lemma, for a locally small category.** Let `T` be a triangulated
category which is `LocallySmall.{w}` and has `Type w`-indexed coproducts, and `K : ι → T`,
`ι : Type w`, a family of compact objects. A morphism `φ : c ⟶ N` from a compact object `c` into
an object `N` of the localizing subcategory generated by the `K i` factors through an object of the
triangulated envelope of a finite direct sum of the `K i`.

This is `CategoryTheory.Pretriangulated.exists_fac_triangEnvelope_of_localizingClosure`
transported along the equivalence with a model with small morphisms. -/
theorem exists_fac_triangEnvelope_of_localizingClosure_of_locallySmall {ι : Type w} (K : ι → T)
    (hK : ∀ i, IsCompactObject.{w} (K i)) {c N : T} (hc : IsCompactObject.{w} c)
    (hN : (ofObj K).localizingClosure.{w} N) (φ : c ⟶ N) :
    ∃ (s : Finset ι) (Z : T), (ObjectProperty.singleton (∐ fun i : s ↦ K i)).triangEnvelope Z ∧
      ∃ (a : c ⟶ Z) (b : Z ⟶ N), a ≫ b = φ := by
  obtain ⟨D, _, _, _, _, _, _, e, _, _, _, _, _, _, hD⟩ :=
    exists_triangulatedEquivalence_of_locallySmall.{w} T
  have := hD inferInstance
  have : HasCoproducts.{w} D := fun (J : Type w) =>
    Adjunction.hasColimitsOfShape_of_equivalence (J := Discrete J) e.inverse
  have : LocallySmall.{w} D := inferInstance
  let Ks : ι → D := fun i => e.functor.obj (K i)
  have : ∀ i, IsCompactObject.{w} (Ks i) := fun i =>
    (isCompactObject_iff_isCompactObject_obj e.functor (K i)).1 (hK i)
  have : IsCompactObject.{w} (e.functor.obj c) :=
    (isCompactObject_iff_isCompactObject_obj e.functor c).1 hc
  have hle : (ofObj K).map e.functor ≤ (ofObj Ks).localizingClosure.{w} := by
    rintro _ ⟨_, ⟨i⟩, ⟨eX⟩⟩
    exact prop_of_iso _ eX (le_localizingClosure (ofObj Ks) (Ks i) ⟨i⟩)
  have hN' : (ofObj Ks).localizingClosure.{w} (e.functor.obj N) :=
    localizingClosure_le hle _
      (localizingClosure_obj_of_equivalence (T := D) (D := T) e.functor (ofObj K) hN)
  obtain ⟨s, Z, hZ, a, b, hab⟩ :=
    exists_fac_triangEnvelope_of_localizingClosure Ks hN' (e.functor.map φ)
  have hZ' := triangEnvelope_singleton_le_inverseImage e.inverse _ Z hZ
  rw [ObjectProperty.prop_inverseImage_iff] at hZ'
  let eσ : e.inverse.obj (∐ fun i : s ↦ Ks i) ≅ ∐ fun i : s ↦ K i :=
    PreservesCoproduct.iso e.inverse (fun i : s ↦ Ks i) ≪≫
      Sigma.mapIso fun i => (e.unitIso.app (K i)).symm
  refine ⟨s, e.inverse.obj Z, triangEnvelope_singleton_le_of_iso eσ _ hZ',
    e.unitIso.hom.app c ≫ e.inverse.map a, e.inverse.map b ≫ e.unitIso.inv.app N, ?_⟩
  rw [Category.assoc, ← Functor.map_comp_assoc, hab]
  simp

end Factor

section Kernel

variable {T : Type u} [Category.{v} T] [Preadditive T] [HasZeroObject T] [HasShift T ℤ]
  [∀ n : ℤ, (shiftFunctor T n).Additive] [Pretriangulated T]
  {T' : Type u'} [Category.{v'} T'] [Preadditive T'] [HasZeroObject T'] [HasShift T' ℤ]
  [∀ n : ℤ, (shiftFunctor T' n).Additive] [Pretriangulated T']
  (L : T ⥤ T') [L.CommShift ℤ] [L.IsTriangulated] [L.IsLeftAdjoint]

/-- **An exact left adjoint kills the localizing subcategory generated by objects it kills**: its
kernel is closed under isomorphisms, shifts, retracts, extensions and every direct sum, `L` being
exact and a left adjoint. -/
theorem isZero_obj_of_localizingClosure_of_isLeftAdjoint (P : ObjectProperty T)
    (hP : ∀ X, P X → IsZero (L.obj X)) {N : T} (hN : P.localizingClosure.{w} N) :
    IsZero (L.obj N) := by
  have : PreservesColimitsOfSize.{w, w} L :=
    (Adjunction.ofIsLeftAdjoint L).leftAdjoint_preservesColimits
  induction hN with
  | of_mem hX => exact hP _ hX
  | of_iso e _ ih => exact ih.of_iso (L.mapIso e).symm
  | of_shift n _ ih =>
    exact ((shiftFunctor T' n).map_isZero ih).of_iso ((L.commShiftIso n).app _)
  | of_retract r _ ih =>
    rw [IsZero.iff_id_eq_zero, ← (r.map L).retract, ih.eq_of_src (r.map L).r 0, Limits.comp_zero]
  | of_ext T hT _ _ ih₁ ih₃ =>
    exact Triangle.isZero₂_of_isZero₁₃ _ (L.map_distinguished _ hT) ih₁ ih₃
  | of_colimitPresentation pres _ ih =>
    rw [IsZero.iff_id_eq_zero]
    refine (isColimitOfPreserves L pres.isColimit).hom_ext fun j => ?_
    simp only [Functor.mapCocone_ι_app, Limits.comp_zero]
    exact (ih j).eq_of_src _ _

variable [IsTriangulated T] [LocallySmall.{w} T] [HasCoproducts.{w} T]

/-- **A morphism from a compact object into an object killed by `L` dies on the fibre of a map to
a compact object killed by `L`.** Let `L : T ⥤ T'` be an exact left adjoint out of a triangulated
category `T` which is `LocallySmall.{w}` and has `Type w`-indexed coproducts, and let `G` be a
compact object killed by `L` such that an object killed by `L` and receiving no nonzero morphism
from any shift of `G` is zero. For `c` compact, `K` killed by `L` and `α : c ⟶ K`, there is a
distinguished triangle `I ⟶ c ⟶ Z ⟶ I[1]` with `Z` compact and killed by `L` and `I ⟶ c ⟶ K`
zero. -/
theorem exists_distTriang_comp_eq_zero_of_isZero_of_locallySmall (G : T)
    (hG : IsCompactObject.{w} G) (hLG : IsZero (L.obj G))
    (hdet : ∀ E : T, IsZero (L.obj E) → (∀ (n : ℤ) (g : G⟦n⟧ ⟶ E), g = 0) → IsZero E)
    {c K : T} (hc : IsCompactObject.{w} c) (hK : IsZero (L.obj K)) (α : c ⟶ K) :
    ∃ (I Z : T) (u : I ⟶ c) (v : c ⟶ Z) (w' : Z ⟶ I⟦(1 : ℤ)⟧),
      Triangle.mk u v w' ∈ distTriang T ∧ IsCompactObject.{w} Z ∧ IsZero (L.obj Z) ∧
        u ≫ α = 0 := by
  let G' : PUnit.{w + 1} → T := fun _ => G
  have hG' : ∀ i, IsCompactObject.{w} (G' i) := fun _ => hG
  have hker : ∀ X, (ofObj G') X → IsZero (L.obj X) := by
    rintro _ ⟨_⟩
    exact hLG
  obtain ⟨K₁, K₂, f, g, h, hT, hK₁, hK₂⟩ :=
    exists_distTriang_localizingClosure_rightOrthogonal G' hG' K
  have hLK₂ : IsZero (L.obj K₂) := Triangle.isZero₃_of_isZero₁₂ _ (L.map_distinguished _ hT)
    (isZero_obj_of_localizingClosure_of_isLeftAdjoint L _ hker hK₁) hK
  have hK₂0 : IsZero K₂ := by
    refine hdet K₂ hLK₂ fun n g' => ?_
    rw [rightOrthogonal_shiftClosure_ofObj_iff] at hK₂
    exact hK₂ PUnit.unit n g'
  have hf : IsIso f := (Triangle.isZero₃_iff_isIso₁ _ hT).1 hK₂0
  have hKloc : (ofObj G').localizingClosure.{w} K := prop_of_iso _ (asIso f) hK₁
  obtain ⟨s, Z, hZ, a, b, hab⟩ :=
    exists_fac_triangEnvelope_of_localizingClosure_of_locallySmall G' hG' hc hKloc α
  obtain ⟨_, _, -⟩ : ObjectProperty.IsClosedUnderIsomorphisms
      (IsCompactObject.{w, _, _} (C := T)) ∧
      ObjectProperty.IsTriangulated (IsCompactObject.{w, _, _} (C := T)) ∧ _ :=
    isClosedUnderIsomorphisms_isTriangulated_isSaturated_and_isIdempotentComplete_isCompactObject
  have hZc : IsCompactObject.{w} Z := by
    have hret : ObjectProperty.IsStableUnderRetracts
        (IsCompactObject.{w, _, _} (C := T)) :=
      ⟨fun r hB => isCompactObject_of_retract hB r.i r.r r.retract⟩
    have hle : (ObjectProperty.singleton (∐ fun i : s ↦ G' i)).triangEnvelope ≤
        IsCompactObject.{w, _, _} (C := T) := by
      rw [triangEnvelope_le_iff, singleton_le_iff]
      exact isCompactObject_sigma (fun i : s ↦ G' i) (fun _ => hG)
    exact hle _ hZ
  have hZL : IsZero (L.obj Z) := by
    have hσ : (ofObj G').localizingClosure.{w} (∐ fun i : s ↦ G' i) :=
      (ofObj G').localizingClosure.{w}.prop_of_isColimit
        (coproductIsCoproduct (fun i : s ↦ G' i)) fun j => le_localizingClosure _ _ ⟨j.as.1⟩
    have hle : (ObjectProperty.singleton (∐ fun i : s ↦ G' i)).localizingClosure.{w} ≤
        (ofObj G').localizingClosure.{w} :=
      localizingClosure_le (by rwa [singleton_le_iff])
    exact isZero_obj_of_localizingClosure_of_isLeftAdjoint L (ofObj G') hker
      (hle _ (triangEnvelope_le_localizingClosure _ _ hZ))
  obtain ⟨I, u, w', hT'⟩ := distinguished_cocone_triangle₁ a
  refine ⟨I, Z, u, a, w', hT', hZc, hZL, ?_⟩
  have h0 : u ≫ a = 0 := comp_distTriang_mor_zero₁₂ _ hT'
  rw [← hab, ← Category.assoc, h0, Limits.zero_comp]

end Kernel

end CategoryTheory.Pretriangulated

end
