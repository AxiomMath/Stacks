module

public import Mathlib.CategoryTheory.Triangulated.Generators
public import Mathlib.CategoryTheory.ObjectProperty.ColimitsOfShape

/-!
# The localizing subcategory generated by a property of objects

Let `C` be a pretriangulated category. A *localizing* subcategory of `C` is a strictly full
triangulated subcategory which is stable under direct summands and under those coproducts of
its objects that exist in `C`. This file constructs the smallest one containing a given
`P : ObjectProperty C`, written `P.localizingClosure`, and proves its universal property.

Mathlib already has the corresponding construction without coproducts:
`CategoryTheory.ObjectProperty.triangEnvelope` is the smallest strictly full triangulated
subcategory stable under retracts containing `P` (the *thick*, or *saturated*, subcategory
generated by `P`), characterised by `ObjectProperty.triangEnvelope_le_iff`. The localizing
closure is the analogous object for the larger list of operations, and it contains the
triangulated envelope (`ObjectProperty.triangEnvelope_le_localizingClosure`).

## Implementation notes

`P.localizingClosure` is defined as an inductive predicate with one constructor for each
closure operation: membership in `P`, transport along an isomorphism, shift by an integer,
retracts, extensions in the middle of a distinguished triangle, and colimits of shape
`Discrete J` for `J : Type w`. The universe `w` of the index types of the coproducts is an
explicit universe parameter of the definition; there is no "set of all coproducts" to quantify
over, so this choice has to be made.

No existence hypothesis on coproducts is imposed. The coproduct constructor takes a colimit
presentation, i.e. a cocone together with the datum that it is colimiting, so it only ever
speaks about coproducts that do exist in `C`; if `C` has no infinite coproducts, the
constructor adds nothing beyond the finite ones and `P.localizingClosure` is the triangulated
envelope. Dually, the universal property `ObjectProperty.localizingClosure_le_iff` asks of the
comparison target `Q` only that it be closed under colimits of shape `Discrete J` in the sense
of `ObjectProperty.IsClosedUnderColimitsOfShape`, which is again a statement about the colimits
that exist.

Closure under *extensions* is taken in the middle position (`T.obj₁` and `T.obj₃` in, `T.obj₂`
in). Together with stability under the shift this gives closure under cones: if `T.obj₁` and
`T.obj₂` lie in the closure, so does `T.obj₃`, by `ObjectProperty.IsTriangulatedClosed₃`, which
Mathlib derives from `IsTriangulated`.

The zero object lies in `P.localizingClosure` for any `P`, including the empty one, because the
coproduct of the empty family is a zero object: this is
`ObjectProperty.localizingClosure.instContainsZero`, proved by exhibiting the zero object as the
colimit of the empty diagram of shape `Discrete PEmpty`. Consequently
`P.localizingClosure.IsTriangulated` holds with no `P.Nonempty` hypothesis, unlike Mathlib's
`instIsTriangulatedTriangEnvelope` for the triangulated envelope.

## Main definitions

* `CategoryTheory.ObjectProperty.localizingClosure`: the localizing subcategory generated by a
  property of objects.

## Main results

* `CategoryTheory.ObjectProperty.localizingClosure_le_iff`: the universal property.
* `CategoryTheory.ObjectProperty.localizingClosure.instIsTriangulated`,
  `instIsStableUnderRetracts` and `instIsClosedUnderColimitsOfShape`: the localizing closure is
  a localizing subcategory.
* `CategoryTheory.ObjectProperty.small_hom_of_localizingClosure`: smallness of the morphisms out
  of an object propagates from `P` to `P.localizingClosure.{w}`, in the same universe `w` that
  indexes the coproducts.
-/

@[expose] public section

universe w v u

namespace CategoryTheory.ObjectProperty

open Category Limits Pretriangulated ZeroObject

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C] (P : ObjectProperty C)

/-- The localizing subcategory generated by `P : ObjectProperty C`: the smallest property of
objects containing `P` and closed under isomorphisms, shifts by `ℤ`, retracts, extensions, and
those coproducts indexed by a type in `Type w` which exist in `C`. -/
inductive localizingClosure : ObjectProperty C
  | of_mem {X : C} (hX : P X) : localizingClosure X
  | of_iso {X Y : C} (e : X ≅ Y) (hX : localizingClosure X) : localizingClosure Y
  | of_shift {X : C} (n : ℤ) (hX : localizingClosure X) : localizingClosure (X⟦n⟧)
  | of_retract {X Y : C} (h : Retract X Y) (hY : localizingClosure Y) : localizingClosure X
  | of_ext (T : Triangle C) (hT : T ∈ distTriang C) (h₁ : localizingClosure T.obj₁)
      (h₃ : localizingClosure T.obj₃) : localizingClosure T.obj₂
  | of_colimitPresentation {X : C} {J : Type w} (pres : ColimitPresentation (Discrete J) X)
      (h : ∀ j, localizingClosure (pres.diag.obj j)) : localizingClosure X

/-- Every object satisfying `P` lies in `P.localizingClosure`. -/
lemma le_localizingClosure : P ≤ P.localizingClosure.{w} :=
  fun _ hX ↦ .of_mem hX

/-- The localizing closure is closed under isomorphisms. -/
instance localizingClosure.instIsClosedUnderIsomorphisms :
    P.localizingClosure.{w}.IsClosedUnderIsomorphisms where
  of_iso e hX := .of_iso e hX

/-- The localizing closure is stable under shifts by integers. -/
instance localizingClosure.instIsStableUnderShift :
    P.localizingClosure.{w}.IsStableUnderShift ℤ where
  isStableUnderShiftBy n := ⟨fun _ hX ↦ .of_shift n hX⟩

/-- The localizing closure is stable under retracts. -/
instance localizingClosure.instIsStableUnderRetracts :
    P.localizingClosure.{w}.IsStableUnderRetracts where
  of_retract h hY := .of_retract h hY

/-- The localizing closure is closed under extensions: if `T` is a distinguished triangle whose
objects `T.obj₁` and `T.obj₃` lie in it, then so does `T.obj₂`. -/
instance localizingClosure.instIsTriangulatedClosed₂ :
    P.localizingClosure.{w}.IsTriangulatedClosed₂ where
  ext₂' T hT h₁ h₃ := le_isoClosure _ _ (.of_ext T hT h₁ h₃)

/-- The localizing closure is closed under those coproducts indexed by `J : Type w` which exist
in `C`. -/
instance localizingClosure.instIsClosedUnderColimitsOfShape (J : Type w) :
    P.localizingClosure.{w}.IsClosedUnderColimitsOfShape (Discrete J) where
  colimitsOfShape_le := by
    rintro X ⟨h⟩
    exact .of_colimitPresentation h.toColimitPresentation h.prop_diag_obj

/-- The colimit presentation of a zero object as the coproduct of the empty family. -/
private noncomputable def emptyColimitPresentation :
    ColimitPresentation (Discrete PEmpty.{w + 1}) (0 : C) where
  diag := Discrete.functor fun j ↦ j.elim
  ι := { app := fun j ↦ j.as.elim, naturality := by rintro ⟨⟨⟩⟩ }
  isColimit :=
    { desc := fun _ ↦ 0
      fac := by rintro _ ⟨⟨⟩⟩
      uniq := fun _ _ _ ↦ (isZero_zero C).eq_of_src _ _ }

/-- The localizing closure contains a zero object. -/
instance localizingClosure.instContainsZero : P.localizingClosure.{w}.ContainsZero where
  exists_zero := ⟨0, isZero_zero C,
    .of_colimitPresentation emptyColimitPresentation fun j ↦ j.as.elim⟩

/-- The localizing closure is a triangulated subcategory. -/
instance localizingClosure.instIsTriangulated :
    P.localizingClosure.{w}.IsTriangulated where

variable {P} in
/-- The universal property of the localizing closure: any property of objects which contains
`P` and has the five closure properties contains `P.localizingClosure`. -/
lemma localizingClosure_le {Q : ObjectProperty C} [Q.IsClosedUnderIsomorphisms]
    [Q.IsStableUnderShift ℤ] [Q.IsStableUnderRetracts] [Q.IsTriangulatedClosed₂]
    [∀ (J : Type w), Q.IsClosedUnderColimitsOfShape (Discrete J)] (h : P ≤ Q) :
    P.localizingClosure.{w} ≤ Q := by
  intro X hX
  induction hX with
  | of_mem hX => exact h _ hX
  | of_iso e _ ih => exact Q.prop_of_iso e ih
  | of_shift n _ ih => exact Q.le_shift n _ ih
  | of_retract r _ ih => exact Q.prop_of_retract r ih
  | of_ext T hT _ _ ih₁ ih₃ => exact Q.ext_of_isTriangulatedClosed₂ T hT ih₁ ih₃
  | of_colimitPresentation pres _ ih => exact Q.prop_of_isColimit pres.isColimit ih

/-- The localizing closure of `P` is the smallest localizing subcategory containing `P`. -/
lemma localizingClosure_le_iff {Q : ObjectProperty C} [Q.IsClosedUnderIsomorphisms]
    [Q.IsStableUnderShift ℤ] [Q.IsStableUnderRetracts] [Q.IsTriangulatedClosed₂]
    [∀ (J : Type w), Q.IsClosedUnderColimitsOfShape (Discrete J)] :
    P.localizingClosure.{w} ≤ Q ↔ P ≤ Q :=
  ⟨(P.le_localizingClosure.trans ·), localizingClosure_le⟩

variable {P} in
/-- The localizing closure is monotone: if `P ≤ Q`, then
`P.localizingClosure ≤ Q.localizingClosure`. -/
lemma monotone_localizingClosure {Q : ObjectProperty C} (h : P ≤ Q) :
    P.localizingClosure.{w} ≤ Q.localizingClosure.{w} :=
  localizingClosure_le (h.trans Q.le_localizingClosure)

/-- The localizing closure is nonempty. -/
instance localizingClosure.instNonempty : P.localizingClosure.{w}.Nonempty :=
  ⟨0, P.localizingClosure.prop_zero⟩

/-- The closure of `P` under shifts by `ℤ` is contained in its localizing closure. -/
lemma shiftClosure_le_localizingClosure : P.shiftClosure ℤ ≤ P.localizingClosure.{w} := by
  rw [shiftClosure_le_iff]
  exact P.le_localizingClosure

/-- The triangulated (thick) envelope of `P` is contained in its localizing closure. -/
lemma triangEnvelope_le_localizingClosure : P.triangEnvelope ≤ P.localizingClosure.{w} :=
  (P.triangEnvelope_le_iff).2 P.le_localizingClosure

/-! ### Smallness of the morphisms out of an object of the closure -/

/-- The middle term of a three-term exact sequence of additive commutative groups is `Small.{w}`
as soon as the two outer terms are, where exactness at the middle means that every element of `B`
killed by `φ` is a value of `ψ`. -/
private lemma small_of_exact {A B D : Type*} [AddCommGroup B] [AddCommGroup D]
    (φ : B →+ D) (ψ : A → B) [Small.{w} A] [Small.{w} D]
    (hex : ∀ b : B, φ b = 0 → ∃ a : A, ψ a = b) : Small.{w} B := by
  classical
  set s : D → B := fun d ↦ if h : ∃ b : B, φ b = d then h.choose else 0 with hs
  have hsφ : ∀ b : B, φ (s (φ b)) = φ b := by
    intro b
    have h : ∃ b' : B, φ b' = φ b := ⟨b, rfl⟩
    simp only [hs, dite_eq_left h]
    exact h.choose_spec
  have hker : ∀ b : B, φ (b - s (φ b)) = 0 := by
    intro b
    rw [map_sub, hsφ, sub_self]
  refine small_of_injective (f := fun b : B ↦ (φ b, (hex _ (hker b)).choose)) ?_
  intro b b' hbb'
  obtain ⟨hd, ha⟩ := Prod.mk.injEq .. ▸ hbb'
  have h1 := (hex _ (hker b)).choose_spec
  have h2 := (hex _ (hker b')).choose_spec
  rw [ha] at h1
  rw [h1, hd] at h2
  exact sub_left_injective h2

variable {P} in
/-- **Smallness of the morphisms out of an object propagates along the localizing closure.** If
every object satisfying `P` has `Type w`-small morphism types into every object of `C`, then so
does every object of `P.localizingClosure.{w}`. The universe of the smallness is the universe `w`
indexing the coproducts of the closure. -/
lemma small_hom_of_localizingClosure
    (hP : ∀ X : C, P X → ∀ Y : C, Small.{w} (X ⟶ Y))
    {X : C} (hX : P.localizingClosure.{w} X) (Y : C) :
    Small.{w} (X ⟶ Y) := by
  revert Y
  induction hX with
  | of_mem hX => exact hP _ hX
  | of_iso e _ ih =>
      intro Y
      have := ih Y
      exact small_of_injective (f := fun g ↦ e.hom ≫ g) fun _ _ h ↦ (cancel_epi e.hom).1 h
  | of_shift n _ ih =>
      intro Y
      have := ih ((shiftEquiv C n).inverse.obj Y)
      exact small_of_injective ((shiftEquiv C n).toAdjunction.homEquiv _ Y).injective
  | of_retract r _ ih =>
      intro Y
      have := ih Y
      refine small_of_injective (f := fun g ↦ r.r ≫ g) fun g g' h ↦ ?_
      simpa [reassoc_of% r.retract] using congrArg (r.i ≫ ·) h
  | of_ext T hT _ _ ih₁ ih₃ =>
      intro Y
      have := ih₁ Y
      have := ih₃ Y
      exact small_of_exact (Preadditive.leftComp Y T.mor₁) (fun g ↦ T.mor₂ ≫ g)
        fun b hb ↦ (T.yoneda_exact₂ hT b hb).imp fun _ h ↦ h.symm
  | @of_colimitPresentation X J pres _ ih =>
      intro Y
      have hsmall : ∀ j : J, Small.{w} (pres.diag.obj ⟨j⟩ ⟶ Y) := fun j ↦ ih ⟨j⟩ Y
      have : Small.{w} (∀ j : J, pres.diag.obj ⟨j⟩ ⟶ Y) :=
        small_of_injective (Equiv.piCongrRight fun j ↦ equivShrink.{w} _).injective
      exact small_of_injective (f := fun f j ↦ pres.ι.app ⟨j⟩ ≫ f)
        fun f f' h ↦ pres.isColimit.hom_ext fun j ↦ congrFun h j.as

end CategoryTheory.ObjectProperty
