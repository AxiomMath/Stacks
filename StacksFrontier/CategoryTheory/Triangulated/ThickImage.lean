module

public import Mathlib.CategoryTheory.Triangulated.Functor
public import Mathlib.CategoryTheory.Triangulated.Subcategory

/-!
# The thick subcategory generated by the image of a thick subcategory

Let `F : C ⥤ D` be a fully faithful exact functor of pretriangulated categories commuting with
the shift, and let `P : ObjectProperty C` be *thick* — closed under isomorphisms, a triangulated
subcategory, and closed under retracts. The image `P.map F` of `P` is not thick: a retract in `D`
of an object `F X` need not be in the image of `F` at all, since that would make idempotents of
`X` split in `C`. What is thick is its retract closure `(P.map F).retractClosure`, and this file
proves that, together with the statement that makes it useful:

`(P.map F).retractClosure (F.obj X) ↔ P X`.

So the smallest thick subcategory of `D` containing `F(P)` meets the image of `F` in exactly
`F(P)`, even though it is strictly larger than `F(P)` in general.

## Why the two steps are separate

Closure of `P.map F` under extensions (`isTriangulatedClosed₂_map`) is the uniqueness of cones:
given a distinguished triangle of `D` whose outer terms are `F X₁` and `F X₃` up to isomorphism,
its connecting morphism `F X₃ ⟶ (F X₁)⟦1⟧ ≅ F (X₁⟦1⟧)` comes from a morphism `X₃ ⟶ X₁⟦1⟧` of `C`
because `F` is full; the cone of that morphism is an extension of `X₁` by `X₃` in `C`, hence
satisfies `P`, and `F` carries its triangle to a distinguished triangle of `D` with the same
outer terms and the same connecting morphism. The five lemma for triangles
(`CategoryTheory.Pretriangulated.isIso₂_of_isIso₁₃`) then identifies the two middle terms. Only
fullness is used here, not faithfulness.

Passing from `P.map F` to its retract closure is then formal, and is where the retract closure
has to be taken at every stage rather than once at the end: the content is
[Stacks, Tag 0FX2] (`ObjectProperty.extensionProduct_retractClosure_retractClosure_le`), that an
extension of a retract by a retract is a retract of an extension.

Faithfulness enters only in the last statement, `prop_of_retractClosure_map_obj`: a retract of
`F X'` in `D` whose source is `F X` is, by full faithfulness, the image of a retract of `X'` in
`C`, so `P X` follows from `P X'`.

## Main results

* `CategoryTheory.ObjectProperty.isTriangulatedClosed₂_map`: the image of a triangulated
  subcategory under a full exact functor is closed under extensions.
* `CategoryTheory.ObjectProperty.isTriangulated_retractClosure_map`: the retract closure of that
  image is a triangulated subcategory, hence thick.
* `CategoryTheory.ObjectProperty.prop_of_retractClosure_map_obj` and
  `CategoryTheory.ObjectProperty.retractClosure_map_obj_iff`: an object of `C` whose image lies
  in that thick subcategory satisfies `P`.

## References

* [Stacks project, Tag 0FX2](https://stacks.math.columbia.edu/tag/0FX2)
-/

@[expose] public section

universe v' u' v u

namespace CategoryTheory.ObjectProperty

open Category Limits Pretriangulated ZeroObject

/-! ### Closure properties of a retract closure -/

section RetractClosure

variable {C : Type u} [Category.{v} C] (P : ObjectProperty C)

/-- The retract closure of a property containing a zero object contains one. -/
instance retractClosure.instContainsZero [P.ContainsZero] : P.retractClosure.ContainsZero where
  exists_zero := by
    obtain ⟨Z, hZ, hP⟩ := P.exists_prop_of_containsZero
    exact ⟨Z, hZ, P.le_retractClosure _ hP⟩

variable {A : Type*} [AddMonoid A] [HasShift C A]

/-- The retract closure of a property stable under the shift by `a` is stable under it: the
shift functor carries a retract to a retract. -/
instance retractClosure.instIsStableUnderShiftBy (a : A) [P.IsStableUnderShiftBy a] :
    P.retractClosure.IsStableUnderShiftBy a where
  le_shift := by
    rintro X ⟨Y, hY, ⟨r⟩⟩
    exact ⟨Y⟦a⟧, P.le_shift a _ hY, ⟨r.map (shiftFunctor C a)⟩⟩

variable (A) in
/-- The retract closure of a shift-stable property is shift-stable. -/
instance retractClosure.instIsStableUnderShift [P.IsStableUnderShift A] :
    P.retractClosure.IsStableUnderShift A where

end RetractClosure

/-! ### The image of a thick subcategory -/

section Map

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
  {D : Type u'} [Category.{v'} D] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
  (P : ObjectProperty C) (F : C ⥤ D)

/-- The image of a shift-stable property under a functor commuting with the shift is
shift-stable. -/
instance map.instIsStableUnderShiftBy (a : ℤ) [P.IsStableUnderShiftBy a] [F.CommShift ℤ] :
    (P.map F).IsStableUnderShiftBy a where
  le_shift := by
    rintro Y ⟨X, hX, ⟨e⟩⟩
    exact ⟨X⟦a⟧, P.le_shift a _ hX,
      ⟨((F.commShiftIso a).app X).trans ((shiftFunctor D a).mapIso e)⟩⟩

/-- The image of a shift-stable property under a functor commuting with the shift is
shift-stable. -/
instance map.instIsStableUnderShift [P.IsStableUnderShift ℤ] [F.CommShift ℤ] :
    (P.map F).IsStableUnderShift ℤ where

/-- **The image of a triangulated subcategory under a full exact functor is closed under
extensions.** Let `T` be a distinguished triangle of `D` whose outer terms are `F X₁` and `F X₃`
up to isomorphism. Its connecting morphism, read as a morphism `F X₃ ⟶ F (X₁⟦1⟧)` through the
isomorphisms and through `F.commShiftIso`, comes from a morphism `g : X₃ ⟶ X₁⟦1⟧` by fullness;
the cone of `g` satisfies `P`, and `F` carries the triangle of `g` to a distinguished triangle of
`D` with the same outer terms and the same connecting morphism. The five lemma for distinguished
triangles identifies the middle terms. -/
lemma isTriangulatedClosed₂_map [P.IsClosedUnderIsomorphisms] [P.IsTriangulatedClosed₂]
    [F.Full] [F.CommShift ℤ] [F.IsTriangulated] : (P.map F).IsTriangulatedClosed₂ := by
  refine IsTriangulatedClosed₂.mk' fun T hT h₁ h₃ ↦ ?_
  obtain ⟨X₁, hX₁, ⟨e₁⟩⟩ := h₁
  obtain ⟨X₃, hX₃, ⟨e₃⟩⟩ := h₃
  obtain ⟨g, hg⟩ := F.map_surjective
    (e₃.hom ≫ T.mor₃ ≫ e₁.inv⟦(1 : ℤ)⟧' ≫ ((F.commShiftIso (1 : ℤ)).app X₁).inv)
  obtain ⟨X₂, a, b, hT'⟩ := distinguished_cocone_triangle₂ g
  have hX₂ : P X₂ := P.ext_of_isTriangulatedClosed₂ _ hT' hX₁ hX₃
  have hFT' : Triangle.mk (F.map a) (F.map b)
      (F.map g ≫ (F.commShiftIso (1 : ℤ)).hom.app X₁) ∈ distTriang D :=
    F.map_distinguished _ hT'
  have hcomm : (F.map g ≫ (F.commShiftIso (1 : ℤ)).hom.app X₁) ≫ e₁.hom⟦(1 : ℤ)⟧'
      = e₃.hom ≫ T.mor₃ := by
    rw [hg]
    simp
  obtain ⟨β, hβ₁, hβ₂⟩ := complete_distinguished_triangle_morphism₂
    (Triangle.mk (F.map a) (F.map b) (F.map g ≫ (F.commShiftIso (1 : ℤ)).hom.app X₁)) T
    hFT' hT e₁.hom e₃.hom hcomm
  have hβ : IsIso β :=
    isIso₂_of_isIso₁₃
      (T := Triangle.mk (F.map a) (F.map b) (F.map g ≫ (F.commShiftIso (1 : ℤ)).hom.app X₁))
      (T' := T)
      { hom₁ := e₁.hom
        hom₂ := β
        hom₃ := e₃.hom
        comm₁ := hβ₁
        comm₂ := hβ₂
        comm₃ := hcomm }
      hFT' hT (inferInstanceAs (IsIso e₁.hom)) (inferInstanceAs (IsIso e₃.hom))
  exact ⟨X₂, hX₂, ⟨asIso β⟩⟩

/-- **The retract closure of the image of a thick subcategory is a triangulated subcategory.**
Closure under extensions is [Stacks, Tag 0FX2]: an extension of a retract of an object of
`P.map F` by another is a retract of an extension inside `P.map F`, and `P.map F` is closed under
extensions by `isTriangulatedClosed₂_map`. -/
lemma isTriangulated_retractClosure_map [P.IsClosedUnderIsomorphisms] [P.IsTriangulated]
    [F.Full] [F.CommShift ℤ] [F.IsTriangulated] :
    (P.map F).retractClosure.IsTriangulated := by
  have := isTriangulatedClosed₂_map P F
  have : (P.map F).retractClosure.IsTriangulatedClosed₂ := by
    refine IsTriangulatedClosed₂.mk' fun T hT h₁ h₃ ↦ ?_
    have hep : extensionProduct (P.map F).retractClosure (P.map F).retractClosure T.obj₂ :=
      ⟨T.obj₁, T.obj₃, T.mor₁, T.mor₂, T.mor₃, hT, h₁, h₃⟩
    refine monotone_retractClosure
      (extensionProduct_le_of_isTriangulatedClosed₂ le_rfl le_rfl) _
      (extensionProduct_retractClosure_retractClosure_le (P.map F) (P.map F) _ hep)
  exact ⟨⟩

omit [HasZeroObject C] [HasShift C ℤ] [Preadditive C] [∀ n : ℤ, (shiftFunctor C n).Additive]
  [Pretriangulated C] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D] in
/-- **An object lies in `P` as soon as its image lies in the thick closure of the image of `P`.**
The image is a retract of some `F X'` with `P X'`, and full faithfulness turns that retract in
`D` into a retract in `C`. -/
lemma prop_of_retractClosure_map_obj [P.IsStableUnderRetracts] [F.Full] [F.Faithful] {X : C}
    (hX : (P.map F).retractClosure (F.obj X)) : P X := by
  obtain ⟨Y, ⟨X', hX', ⟨e⟩⟩, ⟨r⟩⟩ := hX
  have r' : Retract (F.obj X) (F.obj X') := r.trans (Retract.ofIso e.symm)
  refine P.prop_of_retract ⟨F.preimage r'.i, F.preimage r'.r, ?_⟩ hX'
  refine F.map_injective ?_
  rw [F.map_comp, F.map_preimage, F.map_preimage, r'.retract, F.map_id]

omit [HasZeroObject C] [HasShift C ℤ] [Preadditive C] [∀ n : ℤ, (shiftFunctor C n).Additive]
  [Pretriangulated C] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D] in
/-- **The thick closure of the image of a thick subcategory meets the image of `F` in the image
of `P`.** The two directions are `prop_of_retractClosure_map_obj` and the fact that the image of
`P` is contained in its own retract closure. -/
lemma retractClosure_map_obj_iff [P.IsStableUnderRetracts] [F.Full] [F.Faithful] (X : C) :
    (P.map F).retractClosure (F.obj X) ↔ P X :=
  ⟨prop_of_retractClosure_map_obj P F, fun hX ↦
    (P.map F).le_retractClosure _ (P.prop_map_obj F hX)⟩

end Map

end CategoryTheory.ObjectProperty

end
