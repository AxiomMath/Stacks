module

public import StacksFrontier.CategoryTheory.Triangulated.LocalizingAdmissible
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The reflector onto a left admissible subcategory

Let `C` be a pretriangulated category and let `B : ObjectProperty C` be a subcategory whose
inclusion `B.ι : B.FullSubcategory ⥤ C` has a left adjoint — for instance a left admissible
subcategory in the sense of
`StacksFrontier/CategoryTheory/Triangulated/AdmissibleSubcategories.lean`. Composing the left
adjoint with the inclusion gives an endofunctor `B.reflector : C ⥤ C` of `C` landing in `B`,
together with the unit `B.reflectorUnit : 𝟭 C ⟶ B.reflector`. This is the "localization functor
`L` with unit `M ⟶ L M`" of [Stacks, Tag 09LK], step 1.

Three facts about it are proved here.

* `ObjectProperty.bijective_precomp_reflectorUnit`: for `Y` in `B`, precomposition with the unit
  is a bijection `Hom(L X, Y) ≅ Hom(X, Y)`. This is the adjunction read through the fully
  faithful inclusion, and it is the universal property of the unit.
* `ObjectProperty.leftOrthogonal_of_distTriang_reflectorUnit`: the cone of the unit, shifted back
  by one, lies in the left orthogonal `ᗮB`. Equivalently, every `X` sits in a distinguished
  triangle `Z ⟶ X ⟶ L X ⟶ Z⟦1⟧` with `Z` in `ᗮB` and `L X` in `B`, and the second morphism is
  the unit itself — not merely some morphism. The proof is [Stacks, Tag 0H0M],
  `Stacks.Triangulated.AdmissibleSubcategories.isLeftOrthogonal_iff_bijective_precompMap`,
  applied to that triangle with the previous bijection as its hypothesis.
* `ObjectProperty.exists_isTriangulated_leftAdjoint_ι` and
  `ObjectProperty.exists_isTriangulated_reflector`: the reflector is exact. This is the dual of
  [Stacks, Tag 0A8D]: the left adjoint of an exact functor between pretriangulated categories
  carries a unique commutation with the shift making the adjunction triangulated, and for it it
  is exact.

The last section specializes all of this to the localizing subcategory `N` generated by a set of
compact objects, where `B = N^⊥` is left admissible by
`ObjectProperty.isLeftAdmissible_rightOrthogonal_localizingClosure` and `ᗮB = N` by
`ObjectProperty.localizingClosure_eq_leftOrthogonal_rightOrthogonal`. The result,
`ObjectProperty.exists_isTriangulated_reflector_localizingClosure`, is the whole of step 1 of
[Stacks, Tag 09LK] with its hypothesis made explicit: an exact `L : C ⥤ C` with a unit
`𝟭 C ⟶ L`, landing in `N^⊥`, whose unit has cone in `N` and is universal among morphisms into
local objects.

## Main results

* `CategoryTheory.ObjectProperty.reflector` and `CategoryTheory.ObjectProperty.reflectorUnit`.
* `CategoryTheory.ObjectProperty.bijective_precomp_reflectorUnit`.
* `CategoryTheory.ObjectProperty.leftOrthogonal_of_distTriang_reflectorUnit`.
* `CategoryTheory.ObjectProperty.exists_isTriangulated_leftAdjoint_ι`.
* `CategoryTheory.ObjectProperty.exists_isTriangulated_reflector_localizingClosure`.
-/

@[expose] public section

universe v u

namespace CategoryTheory.ObjectProperty

open Category Limits Opposite Pretriangulated

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C]

section Reflector

variable (B : ObjectProperty C) [B.ι.IsRightAdjoint]

/-- The reflector onto a subcategory whose inclusion has a left adjoint: the left adjoint
followed by the inclusion, as an endofunctor of the ambient category. -/
noncomputable abbrev reflector : C ⥤ C := B.ι.leftAdjoint ⋙ B.ι

/-- The unit of the reflection, `𝟭 C ⟶ B.reflector`. -/
noncomputable abbrev reflectorUnit : 𝟭 C ⟶ B.reflector :=
  (Adjunction.ofIsRightAdjoint B.ι).unit

omit [HasZeroObject C] [HasShift C ℤ] [Preadditive C] [∀ (n : ℤ), (shiftFunctor C n).Additive]
  [Pretriangulated C] in
/-- For every object `X`, the object `B.reflector.obj X` lies in `B`. -/
lemma prop_reflector_obj (X : C) : B (B.reflector.obj X) :=
  (B.ι.leftAdjoint.obj X).property

omit [HasZeroObject C] [HasShift C ℤ] [Preadditive C] [∀ (n : ℤ), (shiftFunctor C n).Additive]
  [Pretriangulated C] in
/-- **The universal property of the unit.** For an object `Y` of `B`, precomposition with
`B.reflectorUnit.app X` is a bijection from the morphisms `B.reflector.obj X ⟶ Y` to the
morphisms `X ⟶ Y`: it is the adjunction bijection read through the fully faithful inclusion. -/
lemma bijective_precomp_reflectorUnit {Y : C} (hY : B Y) (X : C) :
    Function.Bijective (fun φ : B.reflector.obj X ⟶ Y ↦ B.reflectorUnit.app X ≫ φ) := by
  exact ((B.fullyFaithfulι.homEquiv (X := B.ι.leftAdjoint.obj X) (Y := ⟨Y, hY⟩)).symm.trans
    ((Adjunction.ofIsRightAdjoint B.ι).homEquiv X ⟨Y, hY⟩)).bijective

/-- **The cone of the unit lies in the left orthogonal.** If `Z ⟶ X ⟶ B.reflector.obj X ⟶ Z⟦1⟧`
is a distinguished triangle whose second morphism is the unit, then `Z` is left orthogonal to
`B`: this is [Stacks, Tag 0H0M] applied to that triangle, whose hypothesis is
`ObjectProperty.bijective_precomp_reflectorUnit`. -/
lemma leftOrthogonal_of_distTriang_reflectorUnit [B.IsStableUnderShift ℤ] {X Z : C} (f : Z ⟶ X)
    (g : B.reflector.obj X ⟶ Z⟦(1 : ℤ)⟧)
    (hT : Triangle.mk f (B.reflectorUnit.app X) g ∈ distTriang C) :
    B.leftOrthogonal Z := by
  have hB : Stacks.Triangulated.AdmissibleSubcategories.ShiftInvariant (fun W : C ↦ B W) :=
    fun W hW n ↦ B.le_shift n W hW
  have key := (Stacks.Triangulated.AdmissibleSubcategories.isLeftOrthogonal_iff_bijective_precompMap
      (fun W : C ↦ B W) hB (Triangle.mk f (B.reflectorUnit.app X) g) hT).2
    (fun b hb ↦ B.bijective_precomp_reflectorUnit hb X)
  intro Y φ hY
  exact key Y hY φ

/-- The left adjoint of the inclusion carries a shift commutation making the adjunction
triangulated. -/
private theorem exists_commShift_isTriangulated_ofIsRightAdjoint [B.IsTriangulated] :
    ∃ (_ : B.ι.leftAdjoint.CommShift ℤ), (Adjunction.ofIsRightAdjoint B.ι).IsTriangulated := by
  let adj : B.ι.leftAdjoint ⊣ B.ι := Adjunction.ofIsRightAdjoint B.ι
  let := adj.leftAdjointCommShift ℤ
  have := adj.commShift_of_rightAdjoint ℤ
  exact ⟨inferInstance, Adjunction.IsTriangulated.mk'' adj⟩

/-- **The reflector factors through an exact left adjoint of the inclusion.** This is the dual of
[Stacks, Tag 0A8D]: a left adjoint of an exact functor between pretriangulated categories carries
a commutation with the shift for which the adjunction, and hence the left adjoint, is
triangulated. -/
@[sga "4½ Etat_0 2.6.7" "more general"]
theorem exists_isTriangulated_leftAdjoint_ι [B.IsTriangulated] :
    ∃ (F : C ⥤ B.FullSubcategory) (adj : F ⊣ B.ι) (_ : F.CommShift ℤ), adj.IsTriangulated := by
  obtain ⟨_, h⟩ := B.exists_commShift_isTriangulated_ofIsRightAdjoint
  exact ⟨_, _, _, h⟩

/-- **The reflector is exact.** -/
theorem exists_isTriangulated_reflector [B.IsTriangulated] :
    ∃ (_ : B.reflector.CommShift ℤ), B.reflector.IsTriangulated := by
  obtain ⟨_, h⟩ := B.exists_commShift_isTriangulated_ofIsRightAdjoint
  exact ⟨inferInstance, inferInstance⟩

end Reflector

section LocalizingClosure

variable [IsTriangulated C] [HasCoproducts.{v} C] {ι : Type v} (G : ι → C)
  [∀ (i : ι) (α : Type v),
    PreservesColimitsOfShape (Discrete α) (preadditiveCoyoneda.obj (op (G i)))]

/-- **Step 1 of [Stacks, Tag 09LK], with the hypothesis it leaves implicit made explicit.** Let
`C` be a triangulated category with coproducts indexed by its morphism universe, and let `N` be
the localizing subcategory generated by a family `G` of objects indexed by a type of that
universe, each of which is compact. Then there is an exact functor `L : C ⥤ C` and a unit
`η : 𝟭 C ⟶ L` such that

* every `L X` is local, i.e. lies in `N^⊥`;
* `η` is universal among morphisms into a local object: precomposition with `η.app X` is a
  bijection `Hom(L X, Y) ≅ Hom(X, Y)` for `Y` in `N^⊥`;
* the cone of `η.app X`, shifted back by one, lies in `N`.

Compactness is the only hypothesis beyond the triangulated structure and the coproducts, and it
is not automatic: without it the reflector need not exist, the obstruction being exactly
`N ⋆ N^⊥ = ⊤` (`ObjectProperty.extensionProduct_localizingClosure_rightOrthogonal_eq_top`). -/
theorem exists_isTriangulated_reflector_localizingClosure :
    ∃ (L : C ⥤ C) (_ : L.CommShift ℤ) (_ : L.IsTriangulated) (η : 𝟭 C ⟶ L),
      (∀ X : C, (ofObj G).localizingClosure.{v}.rightOrthogonal (L.obj X)) ∧
      (∀ Y : C, (ofObj G).localizingClosure.{v}.rightOrthogonal Y → ∀ X : C,
        Function.Bijective fun φ : L.obj X ⟶ Y ↦ η.app X ≫ φ) ∧
      (∀ (X Z : C) (f : Z ⟶ X) (g : L.obj X ⟶ Z⟦(1 : ℤ)⟧),
        Triangle.mk f (η.app X) g ∈ distTriang C → (ofObj G).localizingClosure.{v} Z) := by
  have := isLeftAdmissible_rightOrthogonal_localizingClosure G
  obtain ⟨hcs, htri⟩ :=
    (ofObj G).localizingClosure.{v}.rightOrthogonal.exists_isTriangulated_reflector
  refine ⟨_, hcs, htri, (ofObj G).localizingClosure.{v}.rightOrthogonal.reflectorUnit,
    (ofObj G).localizingClosure.{v}.rightOrthogonal.prop_reflector_obj,
    fun Y hY X ↦ (ofObj G).localizingClosure.{v}.rightOrthogonal.bijective_precomp_reflectorUnit
      hY X, fun X Z f g hT ↦ ?_⟩
  rw [localizingClosure_eq_leftOrthogonal_rightOrthogonal G]
  exact (ofObj G).localizingClosure.{v}.rightOrthogonal.leftOrthogonal_of_distTriang_reflectorUnit
    f g hT

end LocalizingClosure

end CategoryTheory.ObjectProperty

end
