module

public import Mathlib.CategoryTheory.Triangulated.Pretriangulated
public import Mathlib.GroupTheory.FreeAbelianGroup
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The zeroth `K`-group of a (pre)triangulated category

Let `C` be a pretriangulated category. Its zeroth `K`-group `K₀(C)` is the free abelian group
on the objects of `C` modulo the relations `[Y] - [X] - [Z] = 0`, one for each distinguished
triangle `X ⟶ Y ⟶ Z ⟶ X⟦1⟧`. Equivalently, `K₀(C)` is presented by
`⨁_{T dist. triangle} ℤ[T] ⟶ ⨁_{X : C} ℤ[X] ⟶ K₀(C) ⟶ 0`, the first map sending `T` to
`[T.obj₂] - [T.obj₁] - [T.obj₃]`.

## Main definitions

* `CategoryTheory.Pretriangulated.K0`: the zeroth `K`-group `K₀(C)` of a pretriangulated
  category `C`.

## References

* [Stacks, Tag 0FCN](https://stacks.math.columbia.edu/tag/0FCN)
-/

@[expose] public section

namespace CategoryTheory.Pretriangulated

open Limits

universe v u

/-- The **zeroth `K`-group** `K₀(C)` of a pretriangulated category `C`: the free abelian group
on the objects of `C` modulo the subgroup generated by the elements `[Y] - [X] - [Z]`, one for
each distinguished triangle `X ⟶ Y ⟶ Z ⟶ X⟦1⟧` of `C`. The class of an object `X` is
`QuotientAddGroup.mk (FreeAbelianGroup.of X)`. -/
@[stacks 0FCN "generalized from a triangulated to a pretriangulated category: the generators \
  are the objects of `C` and there is one relation `[Y] - [X] - [Z] = 0` for each distinguished \
  triangle `X ⟶ Y ⟶ Z ⟶ X⟦1⟧`, as in Stacks",
  sga "6 I 6.3" "triangulated case", sga "6 IV 1.1" "the group k(C)"]
abbrev K0 (C : Type u) [Category.{v} C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
    [∀ n : ℤ, (CategoryTheory.shiftFunctor C n).Additive] [Pretriangulated C] : Type u :=
  FreeAbelianGroup C ⧸
    AddSubgroup.closure
      {x | ∃ T ∈ distTriang C,
        x = FreeAbelianGroup.of T.obj₂ - FreeAbelianGroup.of T.obj₁ - FreeAbelianGroup.of T.obj₃}

end CategoryTheory.Pretriangulated

end
