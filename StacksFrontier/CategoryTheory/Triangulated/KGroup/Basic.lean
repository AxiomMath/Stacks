@[expose] public section

/-
# Problem Description

This formalizes Stacks Lemma 13.28.4 (tag `0FCR`): a homological functor
`H : D → A` from a triangulated category `D` to an abelian category `A`, with
the property that for every object `X` only finitely many of the objects
`H(X[i])` (`i ∈ ℤ`) are nonzero, induces a group homomorphism
`K_0(D) → K_0(A)` characterized on generators by
`[X] ↦ ∑_{i ∈ ℤ} (-1)^i [H(X[i])]`.

## Main Definitions

- A *homological functor* `H : D → A` is an additive functor carrying every
  distinguished triangle `(X, Y, Z, f, g, h)` to an exact sequence
  `H(X) → H(Y) → H(Z)`. In Mathlib this is `CategoryTheory.Functor.IsHomological`.
- `K_0(D)` (zeroth `K`-group of a triangulated category): the quotient of the
  free abelian group on objects of `D` by the subgroup generated by
  `[Y] - [X] - [Z]` for each distinguished triangle `X → Y → Z`. (Stacks
  Definition 13.28.1.)
- `K_0(A)` (zeroth `K`-group of an abelian category): the quotient of the free
  abelian group on objects of `A` by the subgroup generated by `[B] - [A] - [C]`
  for each short exact sequence `0 → A → B → C → 0`.

## Main Statement

There exists a group homomorphism `K_0(D) → K_0(A)` sending `[X]` to the Euler
characteristic `∑_{i ∈ ℤ} (-1)^i [H(X[i])]`.

## Notes

- We use the free abelian group on *objects*; the relations force isomorphic
  objects to have equal classes, so this agrees with the free abelian group on
  isomorphism classes.
- The alternating sum is taken with `finsum` (`∑ᶠ`); the finiteness hypothesis
  `hfin` guarantees that only finitely many summands are nonzero (the class of a
  zero object is `0`), so the sum is an honest finite sum.
- The sign `(-1)^i` for `i ∈ ℤ` is encoded as `(-1 : ℤ) ^ i.natAbs`, which
  equals `(-1)^i` since `(-1)` is its own inverse.
-/

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated

variable (D : Type*) [Category D] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
variable (A : Type*) [Category A] [Abelian A]

-- Main Definition(s)

/-- The Euler characteristic class `∑_{i ∈ ℤ} (-1)^i [H(X[i])] ∈ K_0(A)`
attached to an object `X` of `D` by a functor `H : D → A`. The sign `(-1)^i`
for `i ∈ ℤ` is encoded by `(-1 : ℤ) ^ i.natAbs`. -/
@[sga "6 0 2.9" "more general"]
noncomputable def eulerClass (H : D ⥤ A) (X : D) : KZero A :=
  ∑ᶠ i : ℤ, ((-1 : ℤ) ^ i.natAbs) • KZero.mk A (H.obj ((shiftFunctor D i).obj X))

-- Main Statement(s)

/-- The alternating family `(-1)^i • [Q i]` has finite support if `Q i` is zero whenever `P i`
is, and only finitely many `P i` are nonzero. -/
private theorem finite_support_sign_smul_mk (P Q : ℤ → A)
    (hfin : {i : ℤ | ¬ IsZero (P i)}.Finite) (hQ : ∀ i, IsZero (P i) → IsZero (Q i)) :
    (Function.support fun i : ℤ => ((-1 : ℤ) ^ i.natAbs) • KZero.mk A (Q i)).Finite := by
  apply Set.Finite.subset hfin
  intro i hi
  simp only [Function.mem_support, ne_eq] at hi
  simp only [Set.mem_ofPred_eq]
  intro hZ
  apply hi
  rw [KZero.mk_eq_zero_of_isZero (hQ i hZ), smul_zero]

omit [HasZeroObject D] [Preadditive D] [∀ (n : ℤ), (shiftFunctor D n).Additive]
    [Pretriangulated D] in
/-- Part (1): for each object `X`, the Euler characteristic sum is finite, so it
defines a genuine element of `K_0(A)`. Concretely, the family of summands has
finite support. -/
theorem eulerClass_finite_support (H : D ⥤ A)
    (hfin : ∀ X : D, {i : ℤ | ¬ IsZero (H.obj ((shiftFunctor D i).obj X))}.Finite) (X : D) :
    (Function.support
      fun i : ℤ =>
        ((-1 : ℤ) ^ i.natAbs) • KZero.mk A (H.obj ((shiftFunctor D i).obj X))).Finite :=
  finite_support_sign_smul_mk A _ _ (hfin X) fun _ => id

/-!
### Decomposition of Part (2): the Euler-characteristic telescoping argument

We must prove, for a distinguished triangle `X → Y → Z` in `D`,
`χ(Y) = χ(X) + χ(Z)` in `K_0(A)`, where `χ(W) = ∑ᶠ i, (-1)^i [H(W[i])]`.

**Rigorous informal proof.**

Write `H^i(W) := H(W[i]) = (H.shift i).obj W` (definitionally equal under the
tautological `H.ShiftSequence ℤ`). Since `H` is homological, applying it to the
distinguished triangle `T = (X → Y → Z)` and all of its rotations yields the
*long exact sequence* in `A`:
```
  ⋯ → H^i(X) --a^i--> H^i(Y) --b^i--> H^i(Z) --δ^i--> H^{i+1}(X) → ⋯
```
where `a^i = (H.shift i).map T.mor₁`, `b^i = (H.shift i).map T.mor₂`, and
`δ^i = H.homologySequenceδ T i (i+1) _` is the connecting map. Exactness at the
three kinds of spots is `homologySequence_exact₂` (at `H^i(Y)`),
`homologySequence_exact₃` (at `H^i(Z)`), and `homologySequence_exact₁`
(at `H^{i+1}(X)`).

For each `i` set `Kᵢ := ker(a^i : H^i(X) → H^i(Y))`. By exactness at `H^i(X)`
(i.e. `homologySequence_exact₁` for the index pair `(i-1, i)`), `Kᵢ` is also the
image of `δ^{i-1} : H^{i-1}(Z) → H^i(X)`. The long exact sequence then splits, in
each degree `i`, into three short exact sequences in `A`:
  1.  `0 → Kᵢ → H^i(X) → im(a^i) → 0`              (`im(a^i) = ker(b^i)`)
  2.  `0 → im(a^i) → H^i(Y) → im(b^i) → 0`          (`im(b^i) = ker(δ^i)`)
  3.  `0 → im(b^i) → H^i(Z) → Kᵢ₊₁ → 0`             (`Kᵢ₊₁ = im(δ^i) = ker(a^{i+1})`)
Each of these feeds `KZero.mk_of_shortExact`, giving in `K_0(A)`:
```
  [H^i(X)] = [Kᵢ] + [im(a^i)]
  [H^i(Y)] = [im(a^i)] + [im(b^i)]
  [H^i(Z)] = [im(b^i)] + [Kᵢ₊₁]
```
Subtracting the second from the sum of the first and third, the `im(a^i)` and
`im(b^i)` terms cancel and we obtain the **per-degree relation**
```
  [H^i(X)] - [H^i(Y)] + [H^i(Z)] = [Kᵢ] + [Kᵢ₊₁]      (★)
```
(This is `homological_perDegree_relation` below.)

Multiplying `(★)` by `(-1)^i` and summing over `i ∈ ℤ` (a finite sum: only
finitely many `H^i(W)` are nonzero by `hfin`, and the `Kᵢ` are subobjects of the
`H^i(X)` hence also finitely many are nonzero):
```
  χ(X) - χ(Y) + χ(Z) = ∑ᶠ i, (-1)^i ([Kᵢ] + [Kᵢ₊₁]).
```
The right-hand side **telescopes to `0`**: writing `kᵢ := (-1)^i [Kᵢ]`,
```
  ∑ᶠ i, (-1)^i [Kᵢ] + ∑ᶠ i, (-1)^i [Kᵢ₊₁]
    = ∑ᶠ i, kᵢ + ∑ᶠ i, (-1)^i [K_{i+1}]
    = ∑ᶠ i, kᵢ - ∑ᶠ i, (-1)^{i+1} [K_{i+1}]      (since (-1)^{i+1} = -(-1)^i)
    = ∑ᶠ i, kᵢ - ∑ᶠ j, kⱼ                          (reindex j = i+1)
    = 0.
```
The sign-flip `(-1)^{(i+1).natAbs} = -(-1)^{i.natAbs}` (proved in
`sign_flip_natAbs`) is exactly what makes the connecting-map degree shift cancel.
Hence `χ(X) - χ(Y) + χ(Z) = 0`, i.e. `χ(Y) = χ(X) + χ(Z)`. ∎

The decomposition below isolates: (i) the algebraic sign identity, (ii) the
per-degree class relation `(★)` (the homological heart), and (iii) the finsum
telescoping bookkeeping.
-/

/-- The sign `(-1)^i` (encoded as `(-1)^i.natAbs`) flips when the degree shifts by
one. This is the algebraic fact that makes the alternating sum of the long exact
sequence telescope to zero. -/
theorem sign_flip_natAbs (i : ℤ) :
    (-1 : ℤ) ^ (i + 1).natAbs = -((-1 : ℤ) ^ i.natAbs) := by
  -- Proof: `|i+1|` and `|i|` differ by exactly 1 (case-split on `0 ≤ i`), so the
  -- powers of `-1` differ by a factor of `-1`.
  --   `by_cases h : 0 ≤ i` then `have : (i+1).natAbs = i.natAbs + 1 := by omega`
  --   (resp. `i.natAbs = (i+1).natAbs + 1`), `rw [this, pow_succ]; ring`.
  by_cases h : 0 ≤ i
  · have he : (i + 1).natAbs = i.natAbs + 1 := by omega
    rw [he, pow_succ]
    ring
  · have he : i.natAbs = (i + 1).natAbs + 1 := by omega
    rw [he, pow_succ]
    ring

/-- Exactness gives `coker S.f ≅ image S.g`: if `S : ShortComplex A` is exact at
`S.X₂`, then `cokernel S.f ≅ Abelian.image S.g`. Reusable identification used to
match `coker(a^i)` with `im(b^i)` and `coker(b^i)` with `im(δ^i)`.
Mathlib path: `S.Exact` ↔ `image S.f = kernel S.g` as subobjects of `X₂`; then
`coker S.f ≅ coker(image.ι S.f) ≅ coker(kernel.ι S.g) = coimage S.g ≅ image S.g`
(`Abelian.coimageImageComparison` is an iso). -/
noncomputable def ShortComplex.cokernelIsoImage_of_exact {S : ShortComplex A} (hS : S.Exact) :
    cokernel S.f ≅ Abelian.image S.g := by
  -- Dual of `imageIsoKernel_of_exact`. We first build `cokernel S.f ≅ coimage S.g`
  -- using the two quotient maps of `S.X₂`, then compose with the (iso) comparison
  -- `coimage S.g ≅ image S.g`.
  have hk : kernel.ι S.g ≫ cokernel.π S.f = 0 :=
    (ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero S).1 hS
  -- `S.f` factors through `kernel S.g`, so the coimage quotient `coimage.π S.g`
  -- (= `cokernel.π (kernel.ι S.g)`) kills `S.f`.
  have hf : S.f ≫ cokernel.π (kernel.ι S.g) = 0 := by
    rw [← kernel.lift_ι S.g S.f S.zero, Category.assoc, cokernel.condition, comp_zero]
  refine Iso.trans ?_ (asIso (Abelian.coimageImageComparison S.g))
  exact
    { hom := cokernel.desc S.f (cokernel.π (kernel.ι S.g)) hf
      inv := cokernel.desc (kernel.ι S.g) (cokernel.π S.f) hk
      hom_inv_id := by
        apply (cancel_epi (cokernel.π S.f)).1
        simp
      inv_hom_id := by
        apply (cancel_epi (cokernel.π (kernel.ι S.g))).1
        simp }

/-- Exactness gives `image S.f ≅ kernel S.g`: if `S : ShortComplex A` is exact at
`S.X₂`, then `Abelian.image S.f ≅ kernel S.g` (the two subobjects of `X₂`
coincide). Used to match `im(δ^i)` with `ker(a^{i+1}) = Kobj(i+1)`. -/
noncomputable def ShortComplex.imageIsoKernel_of_exact {S : ShortComplex A} (hS : S.Exact) :
    Abelian.image S.f ≅ kernel S.g := by
  have hg : Abelian.image.ι S.f ≫ S.g = 0 := by
    rw [← cancel_epi (Abelian.factorThruImage S.f), reassoc_of% (Abelian.image.fac S.f),
      S.zero, comp_zero]
  have hk : kernel.ι S.g ≫ cokernel.π S.f = 0 :=
    (ShortComplex.exact_iff_kernel_ι_comp_cokernel_π_zero S).1 hS
  refine
    { hom := kernel.lift S.g (Abelian.image.ι S.f) hg
      inv := kernel.lift (cokernel.π S.f) (kernel.ι S.g) hk
      hom_inv_id := ?_
      inv_hom_id := ?_ }
  · apply (cancel_mono (Abelian.image.ι S.f)).1
    simp [kernel.lift_ι]
  · apply (cancel_mono (kernel.ι S.g)).1
    simp [kernel.lift_ι]

/-- **Per-degree class relation (the homological heart, `(★)`).**
For a distinguished triangle `T = (X → Y → Z)` and a degree `i`, there exist
objects `Kᵢ, Kᵢ₊₁ : A` — namely the kernels of `a^i = (H.shift i).map T.mor₁` and
`a^{i+1} = (H.shift (i+1)).map T.mor₁` — such that in `K_0(A)`
`[H^i(X)] - [H^i(Y)] + [H^i(Z)] = [Kᵢ] + [Kᵢ₊₁]`, AND `Kᵢ` is functorial in the
sense that the `Kᵢ₊₁` produced at degree `i` coincides with the `Kᵢ` produced at
degree `i+1` (so the telescoping makes sense). We package this as a single family
`Kobj : ℤ → A` together with the per-degree relation.

Informal proof: split the long exact sequence at degree `i` into the three short
exact sequences (1),(2),(3) described above (using `homologySequence_exact₁/₂/₃`,
`homologySequenceδ`, and the abelian-category image/kernel factorization
`ShortComplex.Exact.shortExact`), then apply `KZero.mk_of_shortExact` to each and
combine. The kernel/image objects: `im(a^i) = ker(b^i)` and `im(b^i) = ker(δ^i)`,
with `Kᵢ := kernel ((H.shift i).map T.mor₁)`; exactness of the LES identifies
`ker(a^{i+1}) = im(δ^i)` so SES (3) closes with `Kᵢ₊₁`. -/
theorem homological_perDegree_relation (H : D ⥤ A) (hH : H.IsHomological)
    (T : Triangle D) (hT : T ∈ distinguishedTriangles (C := D)) :
    ∃ Kobj : ℤ → A, (∀ i : ℤ,
      KZero.mk A (H.obj ((shiftFunctor D i).obj T.obj₁))
        - KZero.mk A (H.obj ((shiftFunctor D i).obj T.obj₂))
        + KZero.mk A (H.obj ((shiftFunctor D i).obj T.obj₃))
        = KZero.mk A (Kobj i) + KZero.mk A (Kobj (i + 1)))
      ∧ (∀ i : ℤ, IsZero (H.obj ((shiftFunctor D i).obj T.obj₁)) → IsZero (Kobj i)) := by
  -- SANITY CHECK PASSED (existence statement; witness Kobj i := kernel a^i.
  -- Key fact verified: KZero.mk is iso-invariant, so SES(3) closes on Kobj(i+1)).
  let := Functor.ShiftSequence.tautological H ℤ
  -- Witness family: Kᵢ := kernel of a^i = (H.shift i).map T.mor₁.
  -- Vanishing: when `H^i(T.obj₁)` is zero, so is its kernel.
  refine ⟨fun j => kernel ((H.shift j).map T.mor₁), fun i => ?_,
    fun i hzero => IsZero.of_mono (kernel.ι ((H.shift i).map T.mor₁)) hzero⟩
  -- Abbreviations for the three maps at degree i (and a^{i+1}).
  set a : (H.shift i).obj T.obj₁ ⟶ (H.shift i).obj T.obj₂ := (H.shift i).map T.mor₁
  set b : (H.shift i).obj T.obj₂ ⟶ (H.shift i).obj T.obj₃ := (H.shift i).map T.mor₂
  set δ : (H.shift i).obj T.obj₃ ⟶ (H.shift (i + 1)).obj T.obj₁ :=
    H.homologySequenceδ T i (i + 1) rfl
  set a' : (H.shift (i + 1)).obj T.obj₁ ⟶ (H.shift (i + 1)).obj T.obj₂ :=
    (H.shift (i + 1)).map T.mor₁
  -- Object-level identifications from exactness (as classes in K_0(A)).
  have hca : KZero.mk A (cokernel a) = KZero.mk A (Abelian.image b) :=
    KZero.mk_eq_of_iso (ShortComplex.cokernelIsoImage_of_exact A (H.homologySequence_exact₂ T hT i))
  have hcb : KZero.mk A (cokernel b) = KZero.mk A (Abelian.image δ) :=
    KZero.mk_eq_of_iso (ShortComplex.cokernelIsoImage_of_exact A
      (H.homologySequence_exact₃ T hT i (i + 1) rfl))
  have hid : KZero.mk A (Abelian.image δ) = KZero.mk A (kernel a') :=
    KZero.mk_eq_of_iso (ShortComplex.imageIsoKernel_of_exact A
      (H.homologySequence_exact₁ T hT i (i + 1) rfl))
  -- Generic kernel/image and image/cokernel decompositions.
  have hX : KZero.mk A ((H.shift i).obj T.obj₁)
      = KZero.mk A (kernel a) + KZero.mk A (Abelian.image a) := KZero.mk_eq_kernel_add_image a
  have hY : KZero.mk A ((H.shift i).obj T.obj₂)
      = KZero.mk A (Abelian.image a) + KZero.mk A (cokernel a) := KZero.mk_eq_image_add_cokernel a
  have hZ : KZero.mk A ((H.shift i).obj T.obj₃)
      = KZero.mk A (Abelian.image b) + KZero.mk A (cokernel b) := KZero.mk_eq_image_add_cokernel b
  -- Assemble: rewrite the goal objects (defeq to (H.shift ·).obj ·) and combine.
  show KZero.mk A ((H.shift i).obj T.obj₁) - KZero.mk A ((H.shift i).obj T.obj₂)
      + KZero.mk A ((H.shift i).obj T.obj₃)
      = KZero.mk A (kernel a) + KZero.mk A (kernel a')
  rw [hX, hY, hZ, hca, hcb, hid]
  abel


omit [HasZeroObject D] [∀ (n : ℤ), (shiftFunctor D n).Additive] [Pretriangulated D]
    [Preadditive D] in
/-- The family `Kobj` of kernel objects from `homological_perDegree_relation` has
the property that only finitely many `Kᵢ` have nonzero class in `K_0(A)`. This is
needed so the telescoping finsum manipulation is valid. Informal: each `Kᵢ` is a
subobject (kernel) of `H^i(X) = H(X[i])`; when `H^i(X)` is a zero object so is its
kernel, and by `hfin X` only finitely many `H^i(X)` are nonzero. -/
theorem homological_kernelClass_finite (H : D ⥤ A)
    (hfin : ∀ X : D, {i : ℤ | ¬ IsZero (H.obj ((shiftFunctor D i).obj X))}.Finite)
    (T : Triangle D)
    (Kobj : ℤ → A)
    (hKzero : ∀ i : ℤ, IsZero (H.obj ((shiftFunctor D i).obj T.obj₁)) → IsZero (Kobj i)) :
    (Function.support fun i : ℤ => ((-1 : ℤ) ^ i.natAbs) • KZero.mk A (Kobj i)).Finite := by
  -- `Kobj i` is zero whenever `H^i(T.obj₁)` is zero (hypothesis `hKzero`).
  exact finite_support_sign_smul_mk A _ _ (hfin T.obj₁) hKzero

/-- **Telescoping bookkeeping.** Given a family `g : ℤ → KZero A` with finite
support, the alternating sum `∑ᶠ i, (-1)^i (g i + g (i+1))` telescopes to `0`.
Informal: `∑ᶠ (-1)^i g i + ∑ᶠ (-1)^i g(i+1)`; reindex the second sum by `j=i+1`
(a bijection of `ℤ` preserving finsums) and use `sign_flip_natAbs` to turn
`(-1)^i` into `-(-1)^{i+1}`, so the two sums cancel. Key Mathlib lemmas:
`finsum_add_distrib` (needs both supports finite), `finsum_comp_equiv` /
`Equiv.addRight` reindexing, `smul_add`, `neg_smul`. -/
theorem alternating_telescope (g : ℤ → KZero A)
    (hg : (Function.support fun i : ℤ => ((-1 : ℤ) ^ i.natAbs) • g i).Finite) :
    (∑ᶠ i : ℤ, ((-1 : ℤ) ^ i.natAbs) • (g i + g (i + 1))) = 0 := by
  -- Step 1: support of g itself is finite (since (-1)^k is a unit).
  have hsmul_zero_iff : ∀ (k : ℕ) (x : KZero A), ((-1 : ℤ) ^ k) • x = 0 → x = 0 := by
    intro k x h
    have h2 : ((-1 : ℤ) ^ k) • (((-1 : ℤ) ^ k) • x) = ((-1 : ℤ) ^ k) • (0 : KZero A) := by
      rw [h]
    rw [smul_smul, smul_zero, ← pow_add, ← two_mul, pow_mul] at h2
    simpa using h2
  have hsupp_g : (Function.support g).Finite := by
    apply hg.subset
    intro i hi
    simp only [Function.mem_support] at hi ⊢
    intro h
    exact hi (hsmul_zero_iff i.natAbs (g i) h)
  -- Step 2: support of `fun i => (-1)^|i| • g (i+1)` is finite.
  have hsuppB : (Function.support fun i : ℤ => ((-1 : ℤ) ^ i.natAbs) • g (i + 1)).Finite := by
    apply Set.Finite.subset ((hsupp_g.preimage (Set.injOn_of_injective (add_left_injective 1))))
    intro i hi
    simp only [Function.mem_support] at hi
    simp only [Set.mem_preimage, Function.mem_support]
    intro h
    exact hi (by rw [h, smul_zero])
  -- Step 3: distribute via smul_add, split the finsum.
  have hsplit : (∑ᶠ i : ℤ, ((-1 : ℤ) ^ i.natAbs) • (g i + g (i + 1)))
      = (∑ᶠ i : ℤ, ((-1 : ℤ) ^ i.natAbs) • g i)
        + (∑ᶠ i : ℤ, ((-1 : ℤ) ^ i.natAbs) • g (i + 1)) := by
    simp only [smul_add]
    rw [finsum_add_distrib hg hsuppB]
  -- Step 4: reindex B by j = i + 1 and use sign flip; show B = -A.
  have hB : (∑ᶠ i : ℤ, ((-1 : ℤ) ^ i.natAbs) • g (i + 1))
      = -(∑ᶠ i : ℤ, ((-1 : ℤ) ^ i.natAbs) • g i) := by
    rw [← finsum_comp_equiv (Equiv.subRight (1 : ℤ))
      (f := fun i : ℤ => ((-1 : ℤ) ^ i.natAbs) • g (i + 1))]
    simp only [Equiv.subRight_apply, sub_add_cancel]
    rw [← finsum_neg_distrib]
    refine finsum_congr fun j => ?_
    have hsf : (-1 : ℤ) ^ (j - 1).natAbs = -((-1 : ℤ) ^ j.natAbs) := by
      have := sign_flip_natAbs (j - 1)
      rw [sub_add_cancel] at this
      linarith
    rw [hsf, neg_smul]
  rw [hsplit, hB, add_neg_cancel]

/-- Part (2): the Euler characteristic respects the defining relations of
`K_0(D)`. For every distinguished triangle `X → Y → Z` in `D`,
`χ(Y) = χ(X) + χ(Z)` in `K_0(A)`. -/
theorem eulerClass_additive_on_triangles (H : D ⥤ A) (hH : H.IsHomological)
    (hfin : ∀ X : D, {i : ℤ | ¬ IsZero (H.obj ((shiftFunctor D i).obj X))}.Finite)
    (T : Triangle D) (hT : T ∈ distinguishedTriangles (C := D)) :
    eulerClass D A H T.obj₂ = eulerClass D A H T.obj₁ + eulerClass D A H T.obj₃ := by
  -- SANITY CHECK PASSED.
  -- Assembly from the three sub-lemmas. It suffices to show
  --   χ(X) - χ(Y) + χ(Z) = 0   (then rearrange with `sub_eq_zero`/`abel`).
  -- Obtain `Kobj` and the per-degree relation `(★)`:
  obtain ⟨Kobj, hK, hKzero⟩ := homological_perDegree_relation D A H hH T hT
  -- The three eulerClass'es are finsums (def `eulerClass`); using
  -- `eulerClass_finite_support` for each of T.obj₁,₂,₃ and `finsum_add_distrib`,
  -- combine into a single finsum of the per-degree LHS, then rewrite by `hK`:
  --   χ(X) - χ(Y) + χ(Z)
  --     = ∑ᶠ i, (-1)^i ([H^i(X)] - [H^i(Y)] + [H^i(Z)])
  --     = ∑ᶠ i, (-1)^i ([Kobj i] + [Kobj (i+1)])
  --     = 0                                   (by `alternating_telescope`)
  -- Then `χ(Y) = χ(X) + χ(Z)` follows by `abel`/`sub_eq_zero`.
  -- Needed finsum lemmas: `finsum_add_distrib`, `finsum_sub_distrib` (or rewrite
  -- subtraction via `neg`+add), `smul_sub`, `smul_add`, distributing `(-1)^i •`
  -- over the per-degree relation; finiteness from `eulerClass_finite_support` and
  -- `homological_kernelClass_finite`.
  have htel := alternating_telescope A (fun i => KZero.mk A (Kobj i))
    (homological_kernelClass_finite D A H hfin T Kobj hKzero)
  -- Abbreviate the three families of summands.
  set fX : ℤ → KZero A :=
    fun i => ((-1 : ℤ) ^ i.natAbs) • KZero.mk A (H.obj ((shiftFunctor D i).obj T.obj₁)) with hfX
  set fY : ℤ → KZero A :=
    fun i => ((-1 : ℤ) ^ i.natAbs) • KZero.mk A (H.obj ((shiftFunctor D i).obj T.obj₂)) with hfY
  set fZ : ℤ → KZero A :=
    fun i => ((-1 : ℤ) ^ i.natAbs) • KZero.mk A (H.obj ((shiftFunctor D i).obj T.obj₃)) with hfZ
  have hsX : (Function.support fX).Finite := eulerClass_finite_support D A H hfin T.obj₁
  have hsY : (Function.support fY).Finite := eulerClass_finite_support D A H hfin T.obj₂
  have hsZ : (Function.support fZ).Finite := eulerClass_finite_support D A H hfin T.obj₃
  -- The combined per-degree family equals `fX - fY + fZ` and its finsum is `0`.
  have hcomb : (∑ᶠ i : ℤ, (fX i - fY i + fZ i)) = 0 := by
    have hstep : (∑ᶠ i : ℤ, (fX i - fY i + fZ i))
        = ∑ᶠ i : ℤ, ((-1 : ℤ) ^ i.natAbs) •
            ((fun i => KZero.mk A (Kobj i)) i + (fun i => KZero.mk A (Kobj i)) (i + 1)) := by
      apply finsum_congr
      intro i
      simp only [hfX, hfY, hfZ]
      rw [← smul_sub, ← smul_add]
      congr 1
      exact hK i
    rw [hstep, htel]
  -- Split the combined finsum into the three eulerClass'es.
  have hsplit : (∑ᶠ i : ℤ, (fX i - fY i + fZ i))
      = (∑ᶠ i : ℤ, fX i) - (∑ᶠ i : ℤ, fY i) + (∑ᶠ i : ℤ, fZ i) := by
    have hsub : (∑ᶠ i : ℤ, (fX i - fY i)) = (∑ᶠ i : ℤ, fX i) - (∑ᶠ i : ℤ, fY i) :=
      finsum_sub_distrib hsX hsY
    rw [finsum_add_distrib ((hsX.union hsY).subset (Function.support_sub _ _)) hsZ, hsub]
  -- Conclude.
  rw [hsplit] at hcomb
  -- hcomb : eulerClass X - eulerClass Y + eulerClass Z = 0
  have heq : (∑ᶠ i : ℤ, fY i) = (∑ᶠ i : ℤ, fX i) + (∑ᶠ i : ℤ, fZ i) := by
    have h2 : (∑ᶠ i : ℤ, fX i) + (∑ᶠ i : ℤ, fZ i) - (∑ᶠ i : ℤ, fY i) = 0 := by
      rw [← hcomb]
      abel
    exact (sub_eq_zero.mp h2).symm
  simpa only [eulerClass, hfX, hfY, hfZ] using heq

/-- A homomorphism out of the free abelian group on the objects of a triangulated category
kills the subgroup of relations if it kills each generator `[Y] - [X] - [Z]`. -/
private theorem eq_zero_of_mem_closure_triangle_rel {C : Type*} [Category C] [HasZeroObject C]
    [HasShift C ℤ] [Preadditive C] [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]
    {G : Type*} [AddCommGroup G] (f : FreeAbelianGroup C →+ G)
    (h : ∀ T ∈ distTriang C, f (FreeAbelianGroup.of T.obj₂) - f (FreeAbelianGroup.of T.obj₁) -
      f (FreeAbelianGroup.of T.obj₃) = 0) :
    ∀ x ∈ AddSubgroup.closure {x | ∃ T ∈ distTriang C,
      x = FreeAbelianGroup.of T.obj₂ - FreeAbelianGroup.of T.obj₁ -
        FreeAbelianGroup.of T.obj₃}, f x = 0 := fun x hx => by
  refine (AddSubgroup.closure_le (K := f.ker)).2 ?_ hx
  rintro _ ⟨T, hT, rfl⟩
  rw [SetLike.mem_coe, AddMonoidHom.mem_ker, map_sub, map_sub]
  exact h T hT

/-- **Stacks Lemma 13.28.4 (tag `0FCR`).** Let `H : D → A` be a homological
functor from a triangulated category to an abelian category, such that for every
object `X` of `D` only finitely many of the objects `H(X[i])`, `i ∈ ℤ`, are
nonzero. Then there is a well-defined group homomorphism `K_0(D) → K_0(A)`
characterized by `[X] ↦ ∑_{i ∈ ℤ} (-1)^i [H(X[i])]`. -/
@[stacks 0FCR]
theorem K0_homomorphism_of_homological (H : D ⥤ A) (hH : H.IsHomological)
    (hfin : ∀ X : D, {i : ℤ | ¬ IsZero (H.obj ((shiftFunctor D i).obj X))}.Finite) :
    ∃ φ : K0 D →+ KZero A, ∀ X : D, φ (K0.cls X) = eulerClass D A H X := by
  -- The lift of `eulerClass` from the free abelian group.
  set f : FreeAbelianGroup D →+ KZero A := FreeAbelianGroup.lift (eulerClass D A H) with hf
  -- `f` kills the triangle relations.
  have hker := eq_zero_of_mem_closure_triangle_rel f fun T hT => by
    rw [hf, FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of,
      FreeAbelianGroup.lift_apply_of, eulerClass_additive_on_triangles D A H hH hfin T hT]
    abel
  exact ⟨QuotientAddGroup.lift _ f hker, fun X => by simp [K0.cls, hf]⟩

end

end

section

@[expose] public section

set_option backward.isDefEq.respectTransparency false

/-
# Problem Description

This problem concerns the zeroth `K`-group of a triangulated category, following
Stacks Tag 0FCT (Lemma 13.28.6) and Definition 13.28.1 (Tag 0FCN).

A *triangulated category* is an additive category `D` with an additive
auto-equivalence `[1]` and a collection of *distinguished triangles*
`X → Y → Z → X[1]` satisfying axioms TR1–TR4 (Tag 0145).  In Mathlib this is
captured by the typeclass bundle
`[Category D] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]`
`[∀ n, (shiftFunctor D n).Additive] [Pretriangulated D]`.

An *exact (triangulated) functor* `F : D → D'` (Tag 014V) is a functor equipped
with functorial isomorphisms `ξ_X : F(X[1]) → F(X)[1]` carrying distinguished
triangles to distinguished triangles.  In Mathlib this is `[F.CommShift ℤ]`
together with `F.IsTriangulated`.

The *zeroth `K`-group* `K_0(D)` (Tag 0FCN / Definition 13.28.1) is the free
abelian group on the objects of `D`, with the class of `X` written `[X]`,
modulo the relations `[Y] - [X] - [Z] = 0` coming from distinguished triangles
`X → Y → Z → X[1]`.

# Main Statement (Stacks Tag 0FCT, Lemma 13.28.6)

Given triangulated categories `D`, `D'`, `D''` and a functor
`⊗ : D × D' → D''` (here modelled as a curried bifunctor `D ⥤ (D' ⥤ D'')`)
that is exact in each variable separately, the functor `⊗` induces a bilinear
map `K_0(D) × K_0(D') → K_0(D'')` sending `([X], [X'])` to `[X ⊗ X']`.

A map `b : A × B → C` of abelian groups is bilinear if it is additive in each
variable separately.  We encode such a bilinear map as an additive group
homomorphism `K_0(D) →+ (K_0(D') →+ K_0(D''))`: additivity of `b` in its first
argument is the statement that `fun a => b a c` is additive, and the codomain
being an `AddMonoidHom` encodes additivity in the second argument.
-/

open CategoryTheory CategoryTheory.Pretriangulated

namespace CategoryTheory.Pretriangulated.K0

universe v u v' u' v'' u''

variable
  (D : Type u) [Category.{v} D] [Limits.HasZeroObject D] [HasShift D ℤ]
    [Preadditive D] [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
  (D' : Type u') [Category.{v'} D'] [Limits.HasZeroObject D'] [HasShift D' ℤ]
    [Preadditive D'] [∀ n : ℤ, (shiftFunctor D' n).Additive] [Pretriangulated D']
  (D'' : Type u'') [Category.{v''} D''] [Limits.HasZeroObject D''] [HasShift D'' ℤ]
    [Preadditive D''] [∀ n : ℤ, (shiftFunctor D'' n).Additive] [Pretriangulated D'']

/-- **Stacks Tag 0FCT (Lemma 13.28.6).**
Let `D`, `D'`, `D''` be triangulated categories and let `F : D ⥤ (D' ⥤ D'')` be a
(curried) bifunctor `⊗ : D × D' → D''`.  Assume that

1. for each object `X` of `D`, the partial functor `X ⊗ - = F.obj X : D' → D''`
   is an exact functor of triangulated categories (it admits a shift-commutation
   structure `csR X` and is triangulated for it), and
2. for each object `X'` of `D'`, the partial functor `- ⊗ X' = F.flip.obj X' : D → D''`
   is an exact functor of triangulated categories (it admits a shift-commutation
   structure `csL X'` and is triangulated for it).

Then `⊗` induces a bilinear map `K_0(D) × K_0(D') → K_0(D'')` sending the pair of
classes `([X], [X'])` to `[X ⊗ X']`.

The bilinear map is encoded as `b : K0 D →+ (K0 D' →+ K0 D'')`: additivity of `b`
in the second variable is built into the `AddMonoidHom` codomain, and additivity
in the first variable is built into `b` itself being an `AddMonoidHom`. -/
@[stacks 0FCT]
theorem exists_bilinear_of_bifunctor
    (F : D ⥤ (D' ⥤ D''))
    (csR : ∀ X : D, (F.obj X).CommShift ℤ)
    (hR : ∀ X : D, letI := csR X; (F.obj X).IsTriangulated)
    (csL : ∀ X' : D', (F.flip.obj X').CommShift ℤ)
    (hL : ∀ X' : D', letI := csL X'; (F.flip.obj X').IsTriangulated) :
    ∃ b : K0 D →+ (K0 D' →+ K0 D''),
      ∀ (X : D) (X' : D'), b (cls X) (cls X') = cls ((F.obj X).obj X') := by
  let partialR : D → (K0 D' →+ K0 D'') := fun X =>
    let := csR X; let := hR X; map (F.obj X)
  have hPR : ∀ (X : D) (X' : D'), partialR X (cls X') = cls ((F.obj X).obj X') := by
    intro X X'
    let := csR X
    let := hR X
    exact map_cls (F.obj X) X'
  have hPL : ∀ (X' : D') (X : D),
      (let := csL X'; let := hL X'; map (F.flip.obj X')) (cls X) = cls ((F.obj X).obj X') := by
    intro X' X
    let := csL X'
    let := hL X'
    exact map_cls (F.flip.obj X') X
  let B : FreeAbelianGroup D →+ (K0 D' →+ K0 D'') := FreeAbelianGroup.lift partialR
  have hB := eq_zero_of_mem_closure_triangle_rel B fun T hT => by
    simp only [B, FreeAbelianGroup.lift_apply_of]
    refine hom_ext fun X' => ?_
    rw [AddMonoidHom.sub_apply, AddMonoidHom.sub_apply, AddMonoidHom.zero_apply, hPR, hPR, hPR,
      ← hPL X' T.obj₂, ← hPL X' T.obj₁, ← hPL X' T.obj₃, ← map_sub, ← map_sub, cls_rel T hT,
      map_zero]
  exact ⟨QuotientAddGroup.lift _ B hB, fun X X' => by simpa [B, cls] using hPR X X'⟩

end CategoryTheory.Pretriangulated.K0

end

end
