/-
# Problem Description

We work with (pre-)triangulated categories and exact (triangulated) functors as
in the Stacks project (Chapter 13, "Derived Categories").

* Definition 1 (Triangulated category, Stacks 0145): an additive category `D`
  equipped with a shift auto-equivalence `[1]` and a set of distinguished
  triangles `(X, Y, Z, f, g, h)` (with `f : X ⟶ Y`, `g : Y ⟶ Z`,
  `h : Z ⟶ X[1]`) satisfying TR1–TR4.

* Definition 2 (Exact / triangulated functor, Stacks 014V): a functor
  `F : D ⥤ D'` together with functorial isomorphisms `ξ_X : F(X[1]) ⟶ F(X)[1]`
  such that the image of every distinguished triangle is distinguished.

* Definition 3 (Zeroth `K`-group, Stacks 0FCN): the abelian group
  `K_0(D) = Z^{(Ob D)} / R`, the free abelian group on the objects of `D` modulo
  the subgroup `R` generated by the elements `[Y] - [X] - [Z]` for every
  distinguished triangle `(X, Y, Z, f, g, h)` of `D`.

## Main Statement (Stacks 0FCQ, Lemma 13.28.3)

Let `F : D ⥤ D'` be an exact functor of triangulated categories. Then there is a
unique group homomorphism `K_0(F) : K_0(D) ⟶ K_0(D')` with
`K_0(F)([X]) = [F(X)]` for every object `X` of `D`.

## Mathlib alignment

We use Mathlib's `CategoryTheory.Pretriangulated` for triangulated categories and
`CategoryTheory.Functor.IsTriangulated` (with `[F.CommShift ℤ]`) for exact functors. The zeroth
`K`-group is the draft's `CategoryTheory.Pretriangulated.K0` of 0FCN.
-/

open CategoryTheory CategoryTheory.Pretriangulated

universe v u v' u'

namespace CategoryTheory.Pretriangulated.K0

variable {C : Type u} [Category.{v} C] [Limits.HasZeroObject C] [HasShift C ℤ]
  [Preadditive C] [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]

/-- The class `[X] ∈ K₀(C)` of an object `X` of `C`. -/
def cls (X : C) : K0 C := QuotientAddGroup.mk (FreeAbelianGroup.of X)

/-- For a distinguished triangle `X ⟶ Y ⟶ Z ⟶ X⟦1⟧`, `[Y] - [X] - [Z] = 0` in `K₀(C)`. -/
theorem cls_rel (T : Triangle C) (hT : T ∈ distTriang C) :
    cls T.obj₂ - cls T.obj₁ - cls T.obj₃ = 0 := by
  simp only [cls, ← QuotientAddGroup.mk_sub]
  exact (QuotientAddGroup.eq_zero_iff _).2 (AddSubgroup.subset_closure ⟨T, hT, rfl⟩)

/-- Two homomorphisms out of `K₀(C)` that agree on all classes of objects are equal. -/
theorem hom_ext {A : Type*} [AddCommGroup A] {f g : K0 C →+ A}
    (h : ∀ X : C, f (cls X) = g (cls X)) : f = g := by
  ext X
  exact h X

variable {D : Type u'} [Category.{v'} D] [Limits.HasZeroObject D] [HasShift D ℤ]
  [Preadditive D] [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]

/-- The homomorphism `K₀(F) : K₀(C) → K₀(D)`, `[X] ↦ [F(X)]`, induced by an exact functor
`F : C ⥤ D`: the image under `F` of a distinguished triangle is distinguished, so the lift of
`X ↦ [F(X)]` to the free abelian group kills the defining relations. -/
@[stacks 0FCQ "the homomorphism itself; `map_cls` is its defining property and `map_unique` is
its uniqueness", sga "6 I 6.3" "triangulated case"]
noncomputable def map (F : C ⥤ D) [F.CommShift ℤ] [F.IsTriangulated] : K0 C →+ K0 D :=
  QuotientAddGroup.lift _ (FreeAbelianGroup.lift fun X => cls (F.obj X)) fun x hx => by
    refine (AddSubgroup.closure_le
      (K := (FreeAbelianGroup.lift fun X => cls (F.obj X)).ker)).2 ?_ hx
    rintro _ ⟨T, hT, rfl⟩
    rw [SetLike.mem_coe, AddMonoidHom.mem_ker, map_sub, map_sub, FreeAbelianGroup.lift_apply_of,
      FreeAbelianGroup.lift_apply_of, FreeAbelianGroup.lift_apply_of]
    exact cls_rel (F.mapTriangle.obj T) (F.map_distinguished T hT)

/-- `K₀(F)` sends the class of an object `X` of `C` to the class of `F(X)`. -/
@[simp, stacks 0FCQ "the defining property of `map`"]
theorem map_cls (F : C ⥤ D) [F.CommShift ℤ] [F.IsTriangulated] (X : C) :
    map F (cls X) = cls (F.obj X) :=
  FreeAbelianGroup.lift_apply_of _ _

/-- `K₀(F)` is the only homomorphism `K₀(C) → K₀(D)` sending `[X]` to `[F(X)]` for every object
`X` of `C`. -/
@[stacks 0FCQ "uniqueness of `map`"]
theorem map_unique (F : C ⥤ D) [F.CommShift ℤ] [F.IsTriangulated] (φ : K0 C →+ K0 D)
    (hφ : ∀ X : C, φ (cls X) = cls (F.obj X)) : φ = map F :=
  hom_ext fun X => by rw [hφ, map_cls]

end CategoryTheory.Pretriangulated.K0

end

end

