module

public import Mathlib.CategoryTheory.Triangulated.LocalizingSubcategory
public import StacksFrontier.CategoryTheory.Triangulated.CompactObjects
public import StacksFrontier.CategoryTheory.Triangulated.LocalObjects

/-!
# Verdier's localizing condition for a subcategory generated by compact objects

Let `C` be a pretriangulated category, let `A` be a strictly full triangulated subcategory all
of whose objects are compact, and let `N = G.localizingClosure` be the localizing subcategory
generated by a property `G` of objects. Mathlib's `ObjectProperty.IsVerdierLeftLocalizing A N`
asks that every morphism `X ⟶ Y` with `X` in `A` and `Y` in `N` factor through an object lying
in both `A` and `N`; when it holds, `ObjectProperty.IsVerdierLeftLocalizing.fullyFaithful` makes
the comparison functor `A/(A ⊓ N) ⟶ C/N` of Verdier quotients fully faithful.

This file proves that condition by induction over the generation of `N`. The property of an
object `Y` that every morphism into it from an object of `A` factors through a given
triangulated `D ≤ A` is `ObjectProperty.leftFactoring A D`, and the content of the file is that
this property is itself localizing:

* it is closed under isomorphisms and under retracts for trivial reasons;
* it is stable under the shift because `A` and `D` are;
* it is closed under the coproducts that exist because the objects of `A` are compact, so a
  morphism into a coproduct is a *finite* sum of morphisms into the summands, and a finite sum
  of morphisms factoring through `D` factors through a finite direct sum of objects of `D`;
* and it is closed under extensions. This last step is the one with content, and is where the
  hypothesis `D ≤ A` is used.

## The extension step

Let `T = (M₁ ⟶ M₂ ⟶ M₃ ⟶ M₁⟦1⟧)` be distinguished with `M₁` and `M₃` in `leftFactoring A D`,
and let `f : c ⟶ M₂` with `c` in `A`. Then `f ≫ T.mor₂` factors as `c ⟶ Z₃ ⟶ M₃` through some
`Z₃` in `D`. One would like to lift `Z₃ ⟶ M₃` to `M₂`; the obstruction is its composite with
`T.mor₃`, which can be killed by replacing `Z₃` with the fibre of a map `Z₃ ⟶ W` to an object
of `D`, but that replacement destroys the lift of `f` unless the map `Z₃ ⟶ W` kills `c ⟶ Z₃`.

Both demands are met at once by factoring through the *cone* of `c ⟶ Z₃`: that cone lies in
`A`, because `D ≤ A` and `A` is triangulated — this is the only use of `D ≤ A` — so the
hypothesis on `M₁⟦1⟧` applies to the induced map out of it, and the resulting `Z₃ ⟶ W` is a
composite through the cone, hence annihilates `c ⟶ Z₃` by construction. What is left of `f`
after subtracting the lift is a morphism through `M₁`, which the hypothesis on `M₁` factors.

## Main definitions

* `CategoryTheory.ObjectProperty.FactorsThrough`: a morphism factors through an object with a
  given property.
* `CategoryTheory.ObjectProperty.leftFactoring`: the objects into which every morphism from an
  object of `A` factors through `D`.

## Main results

* `CategoryTheory.ObjectProperty.localizingClosure_le_leftFactoring`: the induction.
* `CategoryTheory.ObjectProperty.isVerdierLeftLocalizing_localizingClosure`: Verdier's
  condition for the localizing subcategory generated by `G`.
* `CategoryTheory.ObjectProperty.isVerdierLeftLocalizing_localizingClosure_of_le`: the case of
  generators lying in `A`.
* `CategoryTheory.ObjectProperty.prop_leftFactoring_triangEnvelope_of_rightOrthogonal` and
  `CategoryTheory.ObjectProperty.isVerdierLeftLocalizing_localizingClosure_triangEnvelope`: the
  case of extra generators lying outside `A` but receiving no nonzero morphism from a shift of
  a generator of `A`.
-/

@[expose] public section

universe w v u

namespace CategoryTheory.ObjectProperty

open Category Limits Preadditive Pretriangulated ZeroObject

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ (n : ℤ), (shiftFunctor C n).Additive] [Pretriangulated C]

/-! ### Morphisms factoring through a property of objects -/

section FactorsThrough

variable (D : ObjectProperty C)

/-- A morphism `f : X ⟶ Y` *factors through* `D : ObjectProperty C` if it is a composite
`X ⟶ Z ⟶ Y` with `D Z`. -/
def FactorsThrough {X Y : C} (f : X ⟶ Y) : Prop :=
  ∃ (Z : C) (a : X ⟶ Z) (b : Z ⟶ Y), D Z ∧ a ≫ b = f

variable {D}

omit [HasZeroObject C] [HasShift C ℤ] [Preadditive C] [∀ (n : ℤ), (shiftFunctor C n).Additive]
  [Pretriangulated C] in
/-- Any morphism into an object of `D` factors through `D`. -/
lemma FactorsThrough.of_prop {X Y : C} (hY : D Y) (f : X ⟶ Y) : D.FactorsThrough f :=
  ⟨Y, f, 𝟙 Y, hY, comp_id f⟩

omit [HasZeroObject C] [HasShift C ℤ] [∀ (n : ℤ), (shiftFunctor C n).Additive]
  [Pretriangulated C] in
/-- The zero morphism factors through any `D` containing a zero object. -/
lemma FactorsThrough.zero [D.ContainsZero] {X Y : C} : D.FactorsThrough (0 : X ⟶ Y) := by
  obtain ⟨O, _, hOD⟩ := D.exists_prop_of_containsZero
  exact ⟨O, 0, 0, hOD, by simp⟩

omit [HasZeroObject C] [HasShift C ℤ] [Preadditive C] [∀ (n : ℤ), (shiftFunctor C n).Additive]
  [Pretriangulated C] in
/-- Postcomposing a morphism that factors through `D` with any morphism again factors
through `D`. -/
lemma FactorsThrough.comp_right {X Y Y' : C} {f : X ⟶ Y} (hf : D.FactorsThrough f)
    (g : Y ⟶ Y') : D.FactorsThrough (f ≫ g) := by
  obtain ⟨Z, a, b, hZ, hab⟩ := hf
  exact ⟨Z, a, b ≫ g, hZ, by rw [← assoc, hab]⟩

omit [HasZeroObject C] [HasShift C ℤ] [Preadditive C] [∀ (n : ℤ), (shiftFunctor C n).Additive]
  [Pretriangulated C] in
/-- Precomposing a morphism that factors through `D` with any morphism again factors
through `D`. -/
lemma FactorsThrough.comp_left {X' X Y : C} (g : X' ⟶ X) {f : X ⟶ Y}
    (hf : D.FactorsThrough f) : D.FactorsThrough (g ≫ f) := by
  obtain ⟨Z, a, b, hZ, hab⟩ := hf
  exact ⟨Z, g ≫ a, b, hZ, by rw [assoc, hab]⟩

/-- A sum of two morphisms factoring through a triangulated subcategory factors through it:
the two intermediate objects are replaced by their direct sum, which lies in `D` because a
strictly full triangulated subcategory is closed under binary direct sums. -/
lemma FactorsThrough.add [D.IsClosedUnderIsomorphisms] [D.IsTriangulated] {X Y : C}
    {f g : X ⟶ Y} (hf : D.FactorsThrough f) (hg : D.FactorsThrough g) :
    D.FactorsThrough (f + g) := by
  obtain ⟨Z₁, a₁, b₁, hZ₁, h₁⟩ := hf
  obtain ⟨Z₂, a₂, b₂, hZ₂, h₂⟩ := hg
  exact ⟨Z₁ ⊞ Z₂, biprod.lift a₁ a₂, biprod.desc b₁ b₂,
    D.ext_of_isTriangulatedClosed₂ _ (binaryBiproductTriangle_distinguished Z₁ Z₂) hZ₁ hZ₂,
    by rw [biprod.lift_desc, h₁, h₂]⟩

end FactorsThrough

/-! ### The objects all of whose morphisms from `A` factor through `D` -/

variable (A D : ObjectProperty C)

/-- The property of an object `Y` that every morphism to `Y` from an object satisfying `A`
factors through `D`. Verdier's left localizing condition for `A` and `B` says exactly that
every object of `B` has this property for `D = A ⊓ B`. -/
def leftFactoring : ObjectProperty C :=
  fun Y ↦ ∀ ⦃X : C⦄, A X → ∀ (f : X ⟶ Y), D.FactorsThrough f

variable {A D}

omit [HasZeroObject C] [HasShift C ℤ] [Preadditive C] [∀ (n : ℤ), (shiftFunctor C n).Additive]
  [Pretriangulated C] in
/-- Unfolding `ObjectProperty.leftFactoring`. -/
lemma prop_leftFactoring_iff (Y : C) :
    A.leftFactoring D Y ↔ ∀ ⦃X : C⦄, A X → ∀ (f : X ⟶ Y), D.FactorsThrough f :=
  Iff.rfl

variable (A D)

omit [HasZeroObject C] [HasShift C ℤ] [Preadditive C] [∀ (n : ℤ), (shiftFunctor C n).Additive]
  [Pretriangulated C] in
/-- Every object of `D` has the property: a morphism into it factors through itself. -/
lemma le_leftFactoring : D ≤ A.leftFactoring D :=
  fun _ hY _ _ f ↦ FactorsThrough.of_prop hY f

variable {A D}

omit [HasZeroObject C] [HasShift C ℤ] [∀ (n : ℤ), (shiftFunctor C n).Additive]
  [Pretriangulated C] in
/-- An object receiving only zero morphisms from `A` has the property, as soon as `D`
contains a zero object. -/
lemma prop_leftFactoring_of_forall_eq_zero [D.ContainsZero] {Y : C}
    (hY : ∀ ⦃X : C⦄, A X → ∀ (f : X ⟶ Y), f = 0) : A.leftFactoring D Y := by
  intro X hX f
  rw [hY hX f]
  exact FactorsThrough.zero

variable (A D)

/-- `A.leftFactoring D` is closed under isomorphisms. -/
instance leftFactoring.instIsClosedUnderIsomorphisms :
    (A.leftFactoring D).IsClosedUnderIsomorphisms where
  of_iso {Y Y'} e hY := by
    intro X hX f
    have h := (hY hX (f ≫ e.inv)).comp_right e.hom
    rwa [assoc, e.inv_hom_id, comp_id] at h

/-- `A.leftFactoring D` is stable under retracts. -/
instance leftFactoring.instIsStableUnderRetracts :
    (A.leftFactoring D).IsStableUnderRetracts where
  of_retract {Y Y'} r hY' := by
    intro X hX f
    have h := (hY' hX (f ≫ r.i)).comp_right r.r
    rwa [assoc, r.retract, comp_id] at h

/-- If `A` and `D` are stable under shifts, then so is `A.leftFactoring D`. -/
instance leftFactoring.instIsStableUnderShift [A.IsStableUnderShift ℤ]
    [D.IsStableUnderShift ℤ] : (A.leftFactoring D).IsStableUnderShift ℤ where
  isStableUnderShiftBy n := ⟨by
    intro Y hY
    intro X hX f
    obtain ⟨g, hg⟩ := (shiftFunctor C n).map_surjective
      ((shiftFunctorCompIsoId C (-n) n (neg_add_cancel n)).hom.app X ≫ f)
    obtain ⟨Z, a, b, hZ, hab⟩ := hY (A.le_shift (-n) _ hX) g
    refine ⟨Z⟦n⟧, (shiftFunctorCompIsoId C (-n) n (neg_add_cancel n)).inv.app X ≫ a⟦n⟧',
      b⟦n⟧', D.le_shift n _ hZ, ?_⟩
    rw [assoc, ← Functor.map_comp, hab, hg, Iso.inv_hom_id_app_assoc]⟩

/-! ### Closure under extensions -/

/-- **The extension step.** If `D ≤ A` are strictly full triangulated subcategories, the
objects into which every morphism from `A` factors through `D` are closed under extensions.

See the module docstring for the shape of the argument: the obstruction to lifting a
factorisation of `f ≫ T.mor₂` along `T.mor₂` is killed by passing to the fibre of a map
constructed through the cone of `c ⟶ Z₃`, which lies in `A` because `D ≤ A`. -/
lemma isTriangulatedClosed₂_leftFactoring [A.IsClosedUnderIsomorphisms] [A.IsTriangulated]
    [D.IsClosedUnderIsomorphisms] [D.IsTriangulated] (hDA : D ≤ A) :
    (A.leftFactoring D).IsTriangulatedClosed₂ where
  ext₂' T hT h₁ h₃ := by
    refine le_isoClosure _ _ ?_
    intro c hc f
    obtain ⟨Z₃, α, β, hZ₃, hαβ⟩ := h₃ hc (f ≫ T.mor₂)
    obtain ⟨Cn, hCn, p, w₃, hTα⟩ := A.distinguished_cocone_triangle α hc (hDA _ hZ₃)
    have hα0 : α ≫ (β ≫ T.mor₃) = 0 := by
      rw [← assoc, hαβ, assoc, comp_distTriang_mor_zero₂₃ _ hT, comp_zero]
    obtain ⟨ψ, hψ⟩ := Triangle.yoneda_exact₂ _ hTα (β ≫ T.mor₃) hα0
    replace hψ : β ≫ T.mor₃ = p ≫ ψ := hψ
    obtain ⟨W, ψ₁, ψ₂, hW, hψ₁₂⟩ :=
      (A.leftFactoring D).le_shift (1 : ℤ) _ h₁ hCn ψ
    obtain ⟨Zf, hZf, s, δ, hTZ⟩ := D.distinguished_cocone_triangle₁ (p ≫ ψ₁) hZ₃ hW
    have hsc : s ≫ p ≫ ψ₁ = 0 := comp_distTriang_mor_zero₁₂ _ hTZ
    have hαp : α ≫ p = 0 := comp_distTriang_mor_zero₁₂ _ hTα
    have hαc : α ≫ p ≫ ψ₁ = 0 := by rw [← assoc, hαp, zero_comp]
    obtain ⟨α', hα'⟩ := Triangle.coyoneda_exact₂ _ hTZ α hαc
    replace hα' : α = α' ≫ s := hα'
    have hsβ : (s ≫ β) ≫ T.mor₃ = 0 :=
      calc (s ≫ β) ≫ T.mor₃ = s ≫ p ≫ ψ := by rw [assoc, hψ]
        _ = (s ≫ p ≫ ψ₁) ≫ ψ₂ := by rw [← hψ₁₂, assoc, assoc]
        _ = 0 := by rw [hsc, zero_comp]
    obtain ⟨φ, hφ⟩ := Triangle.coyoneda_exact₃ _ hT (s ≫ β) hsβ
    have hkey : (f - α' ≫ φ) ≫ T.mor₂ = 0 := by
      rw [sub_comp, assoc, ← hφ, ← assoc, ← hα', hαβ, sub_self]
    obtain ⟨e, he⟩ := Triangle.coyoneda_exact₂ _ hT (f - α' ≫ φ) hkey
    obtain ⟨Z₁, γ, δ₁, hZ₁, hγδ⟩ := h₁ hc e
    have hf : f = α' ≫ φ + γ ≫ δ₁ ≫ T.mor₁ := by
      rw [← assoc, hγδ, ← he]
      abel
    rw [hf]
    exact FactorsThrough.add ⟨Zf, α', φ, hZf, rfl⟩ ⟨Z₁, γ, δ₁ ≫ T.mor₁, hZ₁, rfl⟩

/-! ### Closure under coproducts -/

/-- A colimit presentation of `X` indexed by a discrete category, read as a colimit cofan. -/
private noncomputable def isColimitCofanOfColimitPresentation {J : Type w} {X : C}
    (pres : ColimitPresentation (Discrete J) X) :
    IsColimit (Cofan.mk X fun j ↦ pres.ι.app ⟨j⟩) :=
  Cofan.IsColimit.mk _
    (fun t ↦ pres.isColimit.desc (Cocone.mk t.pt (Discrete.natTrans fun j ↦ t.inj j.as)))
    (fun _ j ↦ pres.isColimit.fac _ ⟨j⟩)
    (fun t m hm ↦ pres.isColimit.uniq
      (Cocone.mk t.pt (Discrete.natTrans fun j ↦ t.inj j.as)) m fun j ↦ hm j.as)

/-- **The coproduct step.** If every object of `A` is compact for `Type w`-indexed coproducts
and `D` is a strictly full triangulated subcategory, the objects into which every morphism
from `A` factors through `D` are closed under those `Type w`-indexed coproducts that exist.

A morphism from a compact object into a coproduct is a finite sum of morphisms into the
summands, by `CategoryTheory.bijective_cofanMap`; the induction over that direct sum is
`DirectSum.induction_on`, whose three cases are
`CategoryTheory.ObjectProperty.FactorsThrough.zero`, the hypothesis on a single summand, and
`CategoryTheory.ObjectProperty.FactorsThrough.add`. -/
lemma isClosedUnderColimitsOfShape_leftFactoring [D.IsClosedUnderIsomorphisms]
    [D.IsTriangulated] (hA : ∀ X : C, A X → IsCompactObject.{w} X) (J : Type w) :
    (A.leftFactoring D).IsClosedUnderColimitsOfShape (Discrete J) where
  colimitsOfShape_le := by
    classical
    rintro Y ⟨pres⟩
    intro c hc f
    obtain ⟨x, hx⟩ := (bijective_cofanMap c (hA c hc)
      (fun j ↦ pres.ι.app ⟨j⟩ : ∀ j, pres.diag.obj ⟨j⟩ ⟶ Y)
      (isColimitCofanOfColimitPresentation pres.toColimitPresentation)).2 f
    rw [← hx]
    clear hx
    induction x using DirectSum.induction_on with
    | zero => simpa using FactorsThrough.zero (D := D) (X := c) (Y := Y)
    | of j y =>
      rw [cofanMap_of]
      exact (pres.prop_diag_obj ⟨j⟩ hc y).comp_right _
    | add x₁ x₂ h₁ h₂ => simpa using h₁.add h₂

/-! ### Verdier's condition -/

/-- **The induction.** Let `D ≤ A` be strictly full triangulated subcategories of `C` with
every object of `A` compact for `Type w`-indexed coproducts. If every object of `G` receives
only morphisms from `A` that factor through `D`, then so does every object of the localizing
subcategory generated by `G`. -/
theorem localizingClosure_le_leftFactoring {G : ObjectProperty C}
    [A.IsClosedUnderIsomorphisms] [A.IsTriangulated]
    [D.IsClosedUnderIsomorphisms] [D.IsTriangulated] (hDA : D ≤ A)
    (hA : ∀ X : C, A X → IsCompactObject.{w} X) (hG : G ≤ A.leftFactoring D) :
    G.localizingClosure.{w} ≤ A.leftFactoring D :=
  have := isTriangulatedClosed₂_leftFactoring A D hDA
  have := fun J : Type w ↦ isClosedUnderColimitsOfShape_leftFactoring A D hA J
  localizingClosure_le hG

/-- **Verdier's left localizing condition for a localizing subcategory generated by objects
into which the morphisms from `A` are already controlled.** Let `A` be a strictly full
triangulated subcategory of `C` all of whose objects are compact for `Type w`-indexed
coproducts, let `G : ObjectProperty C` and let `N = G.localizingClosure` be the localizing
subcategory it generates. If every morphism from an object of `A` to an object of `G` factors
through `A ⊓ N`, then `A` is left `N`-localizing in the sense of Verdier, so that
`ObjectProperty.IsVerdierLeftLocalizing.fullyFaithful` makes `A/(A ⊓ N) ⟶ C/N` fully
faithful. -/
theorem isVerdierLeftLocalizing_localizingClosure {G : ObjectProperty C}
    [A.IsClosedUnderIsomorphisms] [A.IsTriangulated]
    (hA : ∀ X : C, A X → IsCompactObject.{w} X)
    (hG : G ≤ A.leftFactoring (A ⊓ G.localizingClosure.{w})) :
    A.IsVerdierLeftLocalizing G.localizingClosure.{w} where
  fac {X Y} f hX hY := by
    obtain ⟨Z, a, b, ⟨hZA, hZN⟩, hab⟩ :=
      localizingClosure_le_leftFactoring A _ inf_le_left hA hG Y hY hX f
    exact ⟨Z, a, b, hZA, hZN, hab⟩

/-- **Verdier's left localizing condition for a localizing subcategory generated by compact
objects of `A`.** If `A` is a strictly full triangulated subcategory all of whose objects are
compact for `Type w`-indexed coproducts and the generators `G` lie in `A`, then `A` is left
`G.localizingClosure`-localizing. -/
theorem isVerdierLeftLocalizing_localizingClosure_of_le {G : ObjectProperty C}
    [A.IsClosedUnderIsomorphisms] [A.IsTriangulated]
    (hA : ∀ X : C, A X → IsCompactObject.{w} X) (hG : G ≤ A) :
    A.IsVerdierLeftLocalizing G.localizingClosure.{w} :=
  isVerdierLeftLocalizing_localizingClosure A hA
    (le_trans (le_inf hG (G.le_localizingClosure)) (le_leftFactoring A _))

/-! ### Generators outside `A`, controlled by orthogonality -/

variable {A D}

/-- An object `Y` right orthogonal to every shift of every object of `P` receives only zero
morphisms from `P.triangEnvelope`, so it has the left-factoring property for any `D`
containing a zero object.

Together with `ObjectProperty.isVerdierLeftLocalizing_localizingClosure`, this is what lets
Verdier's condition be verified for a localizing subcategory with generators *outside* `A`:
such a generator need not lie in `A ⊓ N`, it is enough that no nonzero morphism reach it from
a shift of a generator of `A`. -/
lemma prop_leftFactoring_triangEnvelope_of_rightOrthogonal (P : ObjectProperty C)
    (D : ObjectProperty C) [D.ContainsZero] {Y : C}
    (hY : (P.shiftClosure ℤ).rightOrthogonal Y) :
    P.triangEnvelope.leftFactoring D Y := by
  have key : P.triangEnvelope ≤ ((singleton Y).shiftClosure ℤ).leftOrthogonal := by
    refine (triangEnvelope_le_iff _).2 fun Z hZ W g hW ↦ ?_
    obtain ⟨V, a, e, hV⟩ := hW
    obtain rfl := (singleton_iff _ _).1 hV
    rw [← cancel_mono e.hom, zero_comp]
    exact (P.shiftClosure ℤ).rightOrthogonal.le_shift a Y hY _
      (le_shiftClosure (A := ℤ) P Z hZ)
  refine prop_leftFactoring_of_forall_eq_zero fun X hX f ↦ ?_
  exact key X hX f ⟨Y, 0, ((shiftFunctorZero C ℤ).app Y).symm, (singleton_iff Y Y).2 rfl⟩

/-- **Verdier's left localizing condition for generators of two kinds.** Let `P` be a nonempty
property of objects of a triangulated category `C`, let `A = P.triangEnvelope` be the thick
subcategory it generates and suppose every object of `A` is compact for `Type w`-indexed
coproducts. Let `Ac` be a second property, every object of which is right orthogonal to all
shifts of the objects of `P`. Then `A` is left `N`-localizing for `N` the localizing
subcategory generated by `P ⊔ Ac`.

This is the shape of the hypothesis in [Stacks, Tag 09LK]: `P` is the representable
differential graded modules, whose thick envelope is the image of the homotopy category of
complexes, and `Ac` is the acyclic modules, which receive no nonzero morphism from a shift of
a representable. The resulting Verdier quotient `C/N` is the quotient of the derived category
by the part of `N` generated by the representables. -/
theorem isVerdierLeftLocalizing_localizingClosure_triangEnvelope {P Ac : ObjectProperty C}
    [P.Nonempty] [IsTriangulated C]
    (hA : ∀ X : C, P.triangEnvelope X → IsCompactObject.{w} X)
    (hAc : ∀ Y : C, Ac Y → (P.shiftClosure ℤ).rightOrthogonal Y) :
    P.triangEnvelope.IsVerdierLeftLocalizing (P ⊔ Ac).localizingClosure.{w} := by
  refine isVerdierLeftLocalizing_localizingClosure _ hA fun Y hY ↦ ?_
  obtain hY | hY := hY
  · exact le_leftFactoring _ _ Y ⟨le_triangEnvelope P Y hY,
      (P ⊔ Ac).le_localizingClosure Y (Or.inl hY)⟩
  · exact prop_leftFactoring_triangEnvelope_of_rightOrthogonal P _ (hAc Y hY)

end CategoryTheory.ObjectProperty

end
