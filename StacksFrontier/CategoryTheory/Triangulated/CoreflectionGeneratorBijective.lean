module

public import StacksFrontier.CategoryTheory.Sites.Cohomology.CompactObjects.RightAdjointCoproducts
public import StacksFrontier.CategoryTheory.Sites.Modules.BaseRingTensorInverseLimitCoherator
public import StacksFrontier.CategoryTheory.Triangulated.HomFiveLemma

/-!
# Testing maps out of a coreflective subcategory against a generator

Let `ι : 𝒞 ⥤ 𝒟` be a fully faithful functor with a right adjoint `DQ`, where `𝒞` is
pre-triangulated and weakly generated by a single object `G` (for instance `ι` the inclusion
`D_QCoh(𝒪_X) ⥤ D(𝒪_X)` of a quasi-compact quasi-separated algebraic space, `DQ = DQ_X` the
derived coherator of Stacks 0CR4, and `G` the perfect generator of Stacks 09IY). For an object
`A` of `𝒞`, an object `B` of `𝒟` and a morphism `g : ι A ⟶ B`, composition with `g` is bijective
on morphisms out of `ι E` for **every** object `E` of `𝒞` as soon as it is bijective on morphisms
out of `ι (G⟦n⟧)` for every integer `n`.

This is the first sentence of the proof of Stacks 0D3F: "Since `D_QCoh(𝒪_X)` has a perfect
generator it suffices to check this for perfect `E`".

## Main results

* `CategoryTheory.Adjunction.bijective_comp_of_bijective_comp_generator_shift`: the reduction.

## Implementation notes

The transpose `A ⟶ DQ B` of `g` turns composition with `g` into composition with the transpose,
so bijectivity against the shifts of `G` says that the transpose is an isomorphism, by
`CategoryTheory.Pretriangulated.isIso_of_generator_hom_bijective`; and an isomorphism transpose is
bijectivity against every object, by
`CategoryTheory.Adjunction.bijective_comp_map_iff_isIso_homEquiv`. Only `𝒞` is required to be
pre-triangulated; nothing is asked of `𝒟` or of `ι` beyond full faithfulness.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace CategoryTheory.Adjunction

variable {𝒞 : Type*} [Category 𝒞] [Preadditive 𝒞] [HasZeroObject 𝒞] [HasShift 𝒞 ℤ]
  [∀ n : ℤ, (shiftFunctor 𝒞 n).Additive] [Pretriangulated 𝒞]
  {𝒟 : Type*} [Category 𝒟] {ι : 𝒞 ⥤ 𝒟} [ι.Full] [ι.Faithful] {DQ : 𝒟 ⥤ 𝒞}

omit [Preadditive 𝒞] [HasZeroObject 𝒞] [HasShift 𝒞 ℤ] [∀ (n : ℤ), (shiftFunctor 𝒞 n).Additive]
  [Pretriangulated 𝒞] in
/-- Composition with the transpose of `g` on morphisms out of `E` is composition with `g` on
morphisms out of `ι E`, up to the bijections given by `ι` and by the adjunction. -/
theorem bijective_comp_homEquiv_iff (adj : ι ⊣ DQ) {A : 𝒞} {B : 𝒟} (g : ι.obj A ⟶ B) (E : 𝒞) :
    Function.Bijective (fun a : E ⟶ A => a ≫ adj.homEquiv A B g) ↔
      Function.Bijective (fun a : ι.obj E ⟶ ι.obj A => a ≫ g) := by
  have hmap : Function.Bijective (ι.map : (E ⟶ A) → (ι.obj E ⟶ ι.obj A)) :=
    ⟨fun _ _ h => ι.map_injective h, fun a => ι.map_surjective a⟩
  have hcomp : (fun a : E ⟶ A => a ≫ adj.homEquiv A B g) =
      (adj.homEquiv E B) ∘ ((fun a : ι.obj E ⟶ ι.obj A => a ≫ g) ∘ ι.map) := by
    funext a
    exact (adj.homEquiv_naturality_left a g).symm
  rw [hcomp, (adj.homEquiv E B).bijective.of_comp_iff', hmap.of_comp_iff]

/-- **Reduction to the shifts of a generator.** Let `ι : 𝒞 ⥤ 𝒟` be fully faithful with right
adjoint `DQ`, with `𝒞` pre-triangulated and weakly generated by `G`. If composition with
`g : ι A ⟶ B` is bijective on morphisms out of `ι (G⟦n⟧)` for every `n`, then it is bijective on
morphisms out of `ι E` for every object `E` of `𝒞`. -/
theorem bijective_comp_of_bijective_comp_generator_shift (adj : ι ⊣ DQ) (G : 𝒞)
    (hG : (ObjectProperty.singleton G).IsWeakTriangulatedGenerator) {A : 𝒞} {B : 𝒟}
    (g : ι.obj A ⟶ B)
    (hg : ∀ n : ℤ, Function.Bijective (fun a : ι.obj (G⟦n⟧) ⟶ ι.obj A => a ≫ g)) (E : 𝒞) :
    Function.Bijective (fun a : ι.obj E ⟶ ι.obj A => a ≫ g) := by
  refine (bijective_comp_map_iff_isIso_homEquiv adj A B g).2 ?_ E
  refine Pretriangulated.isIso_of_generator_hom_bijective G hG _ fun X hX => ?_
  obtain ⟨Y, n, e, hY⟩ := hX
  obtain rfl := (ObjectProperty.singleton_iff G Y).1 hY
  exact (Pretriangulated.bijective_comp_iff_of_source_iso e.symm _).1
    ((bijective_comp_homEquiv_iff adj g _).2 (hg n))

end CategoryTheory.Adjunction

end
