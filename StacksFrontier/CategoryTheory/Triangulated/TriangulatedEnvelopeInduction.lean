module

public import StacksFrontier.CategoryTheory.Triangulated.Generators

/-!
# Induction over the subcategory generated by one object

Let `𝒟` be a triangulated category, `E` an object of `𝒟` and `T` a property of objects of `𝒟`.
Suppose that `T` is inherited by finite direct sums, satisfies the two-out-of-three property for
distinguished triangles, is inherited by direct summands, and holds on every shift `E⟦n⟧`. Then
`T` holds for every object of `⟨E⟩`, the smallest strictly full saturated triangulated
subcategory of `𝒟` containing `E`.

## Main results

* `CategoryTheory.ObjectProperty.triangEnvelope_singleton_le_of_sums_of_extensions_of_summands`:
  the induction principle above.

## Implementation notes

`⟨E⟩` is Mathlib's `(ObjectProperty.singleton E).triangEnvelope`, and the conclusion "`T` holds
for all objects of `⟨E⟩`" is the inequality of object properties
`(ObjectProperty.singleton E).triangEnvelope ≤ T`. The source's hypothesis on finite direct sums
is taken in its binary form: the empty and one-element cases are not needed, since `T 0` already
follows from the two-out-of-three property applied to the contractible triangle on `E`, and the
binary case gives every finite case by induction. The hypothesis on direct summands is the
source's, phrased with the binary biproduct; stability under retracts, which is what Mathlib's
triangulated envelope is built from, is not assumed but obtained from it through the saturation
of [Stacks, Tag 05RB] and the universal property of [Stacks, Tag 0ATG]. Accordingly the ambient
category is triangulated and not merely pretriangulated, as in the source.

Nothing is assumed about `T` beyond the four listed closure properties: that `T` is closed under
isomorphisms and under shifts of *arbitrary* objects are consequences, derived below from the
two-out-of-three property and the contractible triangles.

## References

* [Stacks, Tag 0ATH](https://stacks.math.columbia.edu/tag/0ATH)
-/

@[expose] public section

universe v u

namespace CategoryTheory.ObjectProperty

open Category Limits Preadditive Pretriangulated Triangulated ZeroObject

variable {C : Type u} [Category.{v} C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ n : ℤ, (CategoryTheory.shiftFunctor C n).Additive] [Pretriangulated C]

/-- Let `E` be an object of a triangulated category and let `T` be a property of objects which
is inherited by finite direct sums, satisfies the two-out-of-three property for distinguished
triangles, is inherited by direct summands, and holds on all shifts of `E`. Then `T` holds on
every object of the triangulated subcategory `⟨E⟩` generated by `E`. -/
@[stacks 0ATH]
theorem triangEnvelope_singleton_le_of_sums_of_extensions_of_summands
    [IsTriangulated C] (E : C) (T : ObjectProperty C)
    (_hsum : ∀ K L : C, T K → T L → T (K ⊞ L))
    (hext₁ : ∀ Tr ∈ distTriang C, T Tr.obj₂ → T Tr.obj₃ → T Tr.obj₁)
    (hext₂ : ∀ Tr ∈ distTriang C, T Tr.obj₁ → T Tr.obj₃ → T Tr.obj₂)
    (hext₃ : ∀ Tr ∈ distTriang C, T Tr.obj₁ → T Tr.obj₂ → T Tr.obj₃)
    (hsummand : ∀ K L : C, T (K ⊞ L) → T K ∧ T L)
    (hshift : ∀ n : ℤ, T ((CategoryTheory.shiftFunctor C n).obj E)) :
    (ObjectProperty.singleton E).triangEnvelope ≤ T := by
  -- The zero object satisfies `T`, by the contractible triangle on a shift of `E`.
  have hzero : T 0 :=
    hext₃ _ (contractible_distinguished ((CategoryTheory.shiftFunctor C (0 : ℤ)).obj E))
      (hshift 0) (hshift 0)
  -- Hence `T` is closed under isomorphisms: an isomorphism `X ≅ Y` sits in a distinguished
  -- triangle `X ⟶ Y ⟶ 0 ⟶ X⟦1⟧`.
  have hiso : T.IsClosedUnderIsomorphisms := by
    refine ⟨fun {X Y} e hX => hext₂ (Triangle.mk e.hom (0 : Y ⟶ 0) 0) ?_ hX hzero⟩
    exact isomorphic_distinguished _ (contractible_distinguished X) _
      (Triangle.isoMk (contractibleTriangle X) (Triangle.mk e.hom (0 : Y ⟶ 0) 0)
        (Iso.refl X) e (Iso.refl 0) rfl ((isZero_zero C).eq_of_tgt _ _)
        ((isZero_zero C).eq_of_src _ _)).symm
  -- And `T` is stable under shifts, by the distinguished triangles `X ⟶ 0 ⟶ X⟦1⟧ ⟶ X⟦1⟧`.
  have hup : ∀ X : C, T X → T (X⟦(1 : ℤ)⟧) := fun X hX =>
    hext₃ _ (contractible_distinguished₂ X) hX hzero
  have hdown : ∀ X : C, T X → T (X⟦(-1 : ℤ)⟧) := fun X hX =>
    hext₁ _ (contractible_distinguished₂ (X⟦(-1 : ℤ)⟧)) hzero
      (T.prop_of_iso ((shiftFunctorCompIsoId C (-1 : ℤ) 1 (by ring)).symm.app X) hX)
  have hstable : T.IsStableUnderShift ℤ := by
    refine ⟨fun a => ⟨fun X hX => ?_⟩⟩
    show T (X⟦a⟧)
    induction a using Int.induction_on with
    | zero => exact T.prop_of_iso ((shiftFunctorZero C ℤ).symm.app X) hX
    | succ n ih =>
        exact T.prop_of_iso
          ((shiftFunctorAdd' C (n : ℤ) 1 ((n : ℤ) + 1) rfl).symm.app X) (hup _ ih)
    | pred n ih =>
        exact T.prop_of_iso
          ((shiftFunctorAdd' C (-(n : ℤ)) (-1) (-(n : ℤ) - 1) (by ring)).symm.app X)
          (hdown _ ih)
  have hcontainsZero : T.ContainsZero := ⟨⟨0, isZero_zero C, hzero⟩⟩
  have hclosed₂ : T.IsTriangulatedClosed₂ := IsTriangulatedClosed₂.mk' hext₂
  have htriangulated : T.IsTriangulated := ⟨⟩
  have hsaturated : T.IsSaturated :=
    { isoClosure_of_biprod_left := fun h => by
        rw [T.isoClosure_eq_self] at h ⊢
        exact (hsummand _ _ h).1
      isoClosure_of_biprod_right := fun h => by
        rw [T.isoClosure_eq_self] at h ⊢
        exact (hsummand _ _ h).2 }
  have hne : (ObjectProperty.singleton E).Nonempty := ⟨E, by simp⟩
  refine ((triangEnvelope_eq_iSup_and_isSaturated_and_le_iff
    (ObjectProperty.singleton E)).2.2.2.2 T hiso hsaturated htriangulated).2 (fun X hX => ?_)
  rw [ObjectProperty.singleton_iff] at hX
  exact T.prop_of_iso ((shiftFunctorZero C ℤ).app E ≪≫ eqToIso hX) (hshift 0)

end CategoryTheory.ObjectProperty
