module

public import StacksFrontier.CategoryTheory.DifferentialGraded.RightModule.AcyclicTriangulated
public import StacksFrontier.CategoryTheory.DifferentialGraded.RightModule.EvaluationAcyclic

/-!
# Evaluation at `K` on the derived categories

Let `C` be a differential graded category over a commutative ring `R` and let `K` be an object
of `C`, with `E = C(K, K)` the one-object differential graded subcategory on `K`. Evaluation
at `K` is the exact functor `ev_K : K(Mod^dg(C)) ⥤ K(Mod^dg(E))` of
`StacksFrontier.CategoryTheory.DifferentialGraded.RightModule.Evaluation`, and it carries acyclic
modules to acyclic modules
(`DGCategory.isAcyclic_evaluation`). It therefore inverts the morphisms whose cone is acyclic,
and descends to an exact functor

`ev_K : D(C) ⟶ D(E)`

of the derived categories of
`StacksFrontier.CategoryTheory.DifferentialGraded.RightModule.AcyclicTriangulated`. This is the
sentence "restriction along the one-object differential graded subcategory `E = C(K, K) → C`
is an exact functor `ev_K : D(C) → D(E)`" of step 2 of the replacement proof of
[Stacks, Tag 09LK], with nothing left implicit.

## The quotient that is being passed, and the one that is not

Two different subcategories of `K(Mod^dg(C))` appear in that proof and only one of them is
passed here. `D(C)` is the quotient by the *acyclic* modules; the localizing subcategory `N`
generated by the representables `h_B` is a different thing, and evaluation at `K` does **not**
descend past it, because `ev_K h_X` is the complex `C(K, X)`, which is neither zero nor
acyclic in general. Nothing in this file quotients by `N`. What is proved is exactly the
descent past the acyclics, which is the one step 2 of the argument asks for.

## Main definitions

* `DGCategory.derivedEvaluation`: the functor `ev_K : D(C) ⥤ D(E)`.
* `DGCategory.derivedEvaluationCompIso`: the isomorphism `Q_C ⋙ ev_K ≅ ev_K ⋙ Q_E`
  identifying it on the image of the quotient functor.

## Main results

* `DGCategory.isZero_derivedQ_evaluation`: an acyclic module evaluates to a zero object of
  `D(E)`.
* The instances `(derivedEvaluation C K).CommShift ℤ` and
  `(derivedEvaluation C K).IsTriangulated`: the descended functor is exact.

## References

* [Stacks Project, Tag 09LK](https://stacks.math.columbia.edu/tag/09LK)
-/

@[expose] public section

namespace DGCategory

universe v u r

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open CategoryTheory.ObjectProperty

variable {R : Type r} [CommRing R] (C : DGCategory.{v, u} R) (K : C.Obj)

/-- **Evaluation at `K` kills the acyclics of `D(E)`.** An acyclic right differential graded
`C`-module evaluates at `K` to an acyclic right differential graded `E`-module, hence to a
zero object of the derived category `D(E)`. -/
theorem isZero_derivedQ_evaluation (M : (rightModuleCategory.{v} C).K)
    (hM : RightModule.acyclicProperty C M) :
    IsZero ((evaluationOnK.{v} C K ⋙ RightModule.derivedQ (endDGCategory C K)).obj M) :=
  RightModule.isZero_derivedQ_obj _ (isAcyclic_evaluation.{v} C K hM)

/-- **Evaluation at `K` on the derived categories**, `ev_K : D(C) ⥤ D(E)`: the descent of
`ev_K : K(Mod^dg(C)) ⥤ K(Mod^dg(E))` followed by the quotient functor of `D(E)` through the
quotient functor of `D(C)`. It exists because evaluation at `K` preserves acyclicity. -/
noncomputable def derivedEvaluation :
    RightModule.derivedCategory C ⥤ RightModule.derivedCategory (endDGCategory C K) :=
  (RightModule.acyclicProperty C).descend (RightModule.derivedQ C)
    (evaluationOnK.{v} C K ⋙ RightModule.derivedQ (endDGCategory C K))
    (isZero_derivedQ_evaluation C K)

/-- **Evaluation at `K` on the derived categories agrees with evaluation at `K`.** Restricting
`DGCategory.derivedEvaluation` along the quotient functor of `D(C)` gives back evaluation at
`K` followed by the quotient functor of `D(E)`. -/
noncomputable def derivedEvaluationCompIso :
    RightModule.derivedQ C ⋙ derivedEvaluation C K ≅
      evaluationOnK.{v} C K ⋙ RightModule.derivedQ (endDGCategory C K) :=
  (RightModule.acyclicProperty C).descendCompIso (RightModule.derivedQ C)
    (evaluationOnK.{v} C K ⋙ RightModule.derivedQ (endDGCategory C K))
    (isZero_derivedQ_evaluation C K)

/-- `DGCategory.derivedEvaluation` is a lift of evaluation at `K` followed by the quotient
functor of `D(E)` along the localization functor `K(Mod^dg(C)) ⥤ D(C)`. -/
noncomputable instance : Localization.Lifting (RightModule.derivedQ C)
    (RightModule.acyclicProperty C).trW
    (evaluationOnK.{v} C K ⋙ RightModule.derivedQ (endDGCategory C K))
    (derivedEvaluation C K) :=
  inferInstanceAs (Localization.Lifting (RightModule.derivedQ C)
    (RightModule.acyclicProperty C).trW
    (evaluationOnK.{v} C K ⋙ RightModule.derivedQ (endDGCategory C K))
    ((RightModule.acyclicProperty C).descend (RightModule.derivedQ C)
      (evaluationOnK.{v} C K ⋙ RightModule.derivedQ (endDGCategory C K))
      (isZero_derivedQ_evaluation C K)))

/-- `DGCategory.derivedEvaluation` commutes with the shift functors on `D(C)` and `D(E)`. -/
noncomputable instance : (derivedEvaluation C K).CommShift ℤ :=
  Functor.commShiftOfLocalization (RightModule.derivedQ C)
    (RightModule.acyclicProperty C).trW ℤ
    (evaluationOnK.{v} C K ⋙ RightModule.derivedQ (endDGCategory C K))
    (derivedEvaluation C K)

/-- **Evaluation at `K` on the derived categories is exact.** -/
instance isTriangulated_derivedEvaluation : (derivedEvaluation C K).IsTriangulated :=
  (RightModule.acyclicProperty C).isTriangulated_descend (RightModule.derivedQ C)
    (evaluationOnK.{v} C K ⋙ RightModule.derivedQ (endDGCategory C K))
    (isZero_derivedQ_evaluation C K)

end DGCategory

end
