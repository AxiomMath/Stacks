module

public import StacksFrontier.CategoryTheory.DifferentialGraded.RightModule.Cohomology
public import StacksFrontier.CategoryTheory.DifferentialGraded.RightModule.YonedaVerdier

/-!
# Acyclicity is orthogonality to the representables

Let `C` be a differential graded category over a commutative ring `R` and let `M` be a right
differential graded `C`-module. This file proves that `M` is acyclic — every complex `M X` has
vanishing cohomology, in the sense of
`StacksFrontier.CategoryTheory.DifferentialGraded.RightModule.Cohomology` — exactly when no
nonzero morphism of `K(Mod^dg(C))` reaches `M` from a shift of a representable:

`IsAcyclic M ↔ ∀ X n, ∀ f : (h_X)⟦n⟧ ⟶ M, f = 0`.

Both implications hold. The proof is the differential graded Yoneda lemma, which identifies the
Hom complex `Hom^•(h_X, M)` with the complex `M X` (`DGCategory.yonedaEval` and
`DGCategory.yonedaEval_homD`): morphisms of the homotopy category out of `h_X` are the
degree-zero cohomology of that Hom complex, hence the degree-zero cohomology of `M X`, and the
shift in the source moves the degree.

With it, the enlarged form of the essential standard fact of [Stacks, Tag 09LK] proved in
`StacksFrontier.CategoryTheory.DifferentialGraded.RightModule.YonedaVerdier` is stated with
genuine acyclicity as its hypothesis rather than with the orthogonality condition as a
stand-in: `N' = ⟨representables ⊔ acyclics⟩` has `K(Mod^dg(C))/N' = D(C)/N`, and
`DGCategory.RightModule.fullyFaithfulVerdierEmbeddingAcyclic` is the fully faithful
`A/(A ⊓ N') ⥤ D(C)/N` of step 1.

## Main definitions

* `DGCategory.RightModule.acyclicProperty`: the acyclic modules, as a property of objects of
  `K(Mod^dg(C))`.

## Main results

* `DGCategory.RightModule.forall_hom_eq_zero_iff_isAcyclic`: a module is acyclic exactly when
  every morphism to it from a shift of a representable vanishes.
* `DGCategory.RightModule.isVerdierLeftLocalizing_acyclic` and
  `DGCategory.RightModule.fullyFaithfulVerdierEmbeddingAcyclic`: Verdier's left localizing
  condition and the fully faithful embedding, for `N'` generated by the representables together
  with the acyclic modules.

## Implementation notes

The shift is removed from the source rather than carried through the Yoneda lemma: the shift
functors of `K(Mod^dg(C))` are an equivalence, so `Hom((h_X)⟦n⟧, M)` and `Hom(h_X, M⟦-n⟧)` are
in bijection, and only the unshifted Yoneda lemma is needed. Transferring the *vanishing* of a
Hom group across that bijection costs nothing, because it is transferred as
`Subsingleton`, which an arbitrary bijection preserves; no additivity of the bijection is
required.

The two halves of the Yoneda computation are the two halves of degree-zero cohomology. A closed
degree-zero morphism `h_X ⟶ M` is an element of `M X` killed by the differential, by
`DGCategory.RightModule.homD_eq_zero_iff`; and it is null-homotopic exactly when that element is
a boundary, by `DGCategory.yonedaEval_dPrime`. The coboundary `d'` of a degree `-1` morphism is
where the degree `-1` of the development's conventions enters; `DGCategory.yonedaEval_dPrime`
substitutes the degree equation `(-1) + 1 = 0` away, which is what keeps the rest of the file
free of transports.
-/

@[expose] public section

namespace DGCategory

universe v u r

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open CategoryTheory.ObjectProperty

variable {R : Type r} [CommRing R] {C : DGCategory.{v, u} R}

/-! ### The Yoneda lemma in degree zero -/

/-- Evaluation at the identity commutes with the coboundary `d'` of `Mod^dg(C)`, which is the
differential of a homogeneous morphism read in a prescribed degree. -/
theorem yonedaEval_dPrime (M : RightModule.{v} C) (X : C.Obj) {m n : ℤ} (e : m + 1 = n)
    (φ : RightModule.HomogeneousMap (yonedaRightModule C X) M m) :
    yonedaEval M X n ((rightModuleCategory.{v} C).d' e φ) = M.d e (yonedaEval M X m φ) := by
  subst e
  exact yonedaEval_homD M X m φ

/-- A homogeneous morphism `h_X ⟶ M` is closed exactly when the element of `M X` it evaluates
to is. -/
theorem homD_eq_zero_iff (M : RightModule.{v} C) (X : C.Obj) {p : ℤ}
    (φ : RightModule.HomogeneousMap (yonedaRightModule C X) M p) :
    RightModule.homD φ = 0 ↔ M.d (rfl : p + 1 = p + 1) (yonedaEval M X p φ) = 0 := by
  rw [← yonedaEval_homD M X p φ]
  exact (LinearEquiv.map_eq_zero_iff _).symm

namespace RightModule

attribute [local implicit_reducible] DGCategory.K

/-- A group has one element exactly when all its elements vanish. -/
private theorem forall_eq_zero_iff_subsingleton {G : Type*} [AddCommGroup G] :
    (∀ g : G, g = 0) ↔ Subsingleton G :=
  ⟨fun h => ⟨fun a b => (h a).trans (h b).symm⟩, fun h g => h.elim g 0⟩

/-- A shift in the source of a Hom group may be moved to the target, inverted: the shift
functors are an equivalence. -/
theorem subsingleton_hom_shift_iff {D : Type*} [Category D] [HasShift D ℤ] (A B : D) (n : ℤ) :
    Subsingleton (A⟦n⟧ ⟶ B) ↔ Subsingleton (A ⟶ B⟦-n⟧) :=
  Equiv.subsingleton_congr ((shiftEquiv D n).toAdjunction.homEquiv A B)

/-- **The Yoneda lemma in degree zero.** There is no nonzero morphism `h_X ⟶ M` in
`K(Mod^dg(C))` exactly when the complex `M X` is exact in degree zero: a closed degree-zero
morphism is a cocycle of `M X`, and it is null-homotopic exactly when that cocycle is a
coboundary. -/
theorem subsingleton_hom_yonedaObjK_iff (M : (rightModuleCategory.{v} C).K) (X : C.Obj) :
    Subsingleton (yonedaObjK X ⟶ M) ↔ (cochainComplex M X).ExactAt 0 := by
  have e : (-1 : ℤ) + 1 = 0 := by omega
  rw [exactAt_cochainComplex_iff M X e]
  constructor
  · intro hs a ha
    have hev : yonedaEval M X 0 (yonedaOfElem (M := M) (X := X) (p := 0) a) = a :=
      (yonedaEval M X 0).apply_symm_apply a
    have hcl : homD (yonedaOfElem (M := M) (X := X) (p := 0) a) = 0 := by
      rwa [homD_eq_zero_iff, hev]
    have hq : (Quotient.mk _ ⟨yonedaOfElem a, hcl⟩ : yonedaObjK X ⟶ M) =
        Quotient.mk _ ⟨0, (rightModuleCategory.{v} C).d_zero⟩ := hs.elim _ _
    obtain ⟨h, hh⟩ := Quotient.exact hq
    refine ⟨yonedaEval M X (-1) h, ?_⟩
    have hcong := congrArg (yonedaEval M X 0) hh
    rw [map_sub, yonedaEval_dPrime M X e h, hev, map_zero,
      sub_zero] at hcong
    exact hcong.symm
  · intro H
    refine ⟨fun α β => Quotient.inductionOn₂ α β fun f g => Quotient.sound ?_⟩
    obtain ⟨b, hb⟩ := H (yonedaEval M X 0 f.1 - yonedaEval M X 0 g.1) (by
      rw [M.d_sub, (homD_eq_zero_iff M X f.1).1 f.2, (homD_eq_zero_iff M X g.1).1 g.2, sub_zero])
    refine ⟨(yonedaEval M X (-1)).symm b, (yonedaEval M X 0).injective ?_⟩
    rw [map_sub, yonedaEval_dPrime M X e,
      LinearEquiv.apply_symm_apply]
    exact hb.symm

/-! ### The bridge -/

/-- **Acyclicity is orthogonality to the shifts of the representables.** A right differential
graded `C`-module `M` is acyclic — every complex `M X` is exact — exactly when every morphism
`(h_X)⟦n⟧ ⟶ M` of `K(Mod^dg(C))` vanishes, for every object `X` of `C` and every integer `n`.

This is the differential graded Yoneda lemma: morphisms out of `h_X` in the homotopy category
are the degree-zero cohomology of `Hom^•(h_X, M) ≅ M X`, and the shift in the source selects
the degree. -/
theorem forall_hom_eq_zero_iff_isAcyclic (M : (rightModuleCategory.{v} C).K) :
    (∀ (X : C.Obj) (n : ℤ) (f : (yonedaObjK X)⟦n⟧ ⟶ M), f = 0) ↔ IsAcyclic M := by
  have key : ∀ (X : C.Obj) (n : ℤ),
      (∀ f : (yonedaObjK X)⟦n⟧ ⟶ M, f = 0) ↔ (cochainComplex M X).ExactAt (-n) := fun X n =>
    forall_eq_zero_iff_subsingleton.trans
      ((subsingleton_hom_shift_iff _ _ _).trans
        ((subsingleton_hom_yonedaObjK_iff _ X).trans
          (exactAt_cochainComplex_shift_iff M (-n) X (show (0 : ℤ) + -n = -n by omega))))
  refine ⟨fun H X => (HomologicalComplex.acyclic_iff _).2 fun i => ?_,
    fun H X n => (key X n).2 ((HomologicalComplex.acyclic_iff _).1 (H X) (-n))⟩
  simpa only [neg_neg] using (key X (-i)).1 (H X (-i))

/-! ### The essential standard fact with acyclicity as its hypothesis -/

/-- The acyclic right differential graded modules, as a property of objects of
`K(Mod^dg(C))`. -/
def acyclicProperty (C : DGCategory.{v, u} R) : ObjectProperty (rightModuleCategory.{v} C).K :=
  fun M => IsAcyclic M

/-- A module satisfies `acyclicProperty C` exactly when it is acyclic. -/
@[simp] theorem acyclicProperty_iff (M : (rightModuleCategory.{v} C).K) :
    acyclicProperty C M ↔ IsAcyclic M := Iff.rfl

variable (C) [Nonempty C.Obj]

/-- **Verdier's left localizing condition for the representables and the acyclic modules.**
Let `A` be the triangulated envelope of the representables in `K(Mod^dg(C))` and let `N'` be
the localizing subcategory generated by the representables together with the acyclic modules.
Then `A` is left `N'`-localizing. -/
theorem isVerdierLeftLocalizing_acyclic :
    (yonedaEnvelope C).IsVerdierLeftLocalizing
      (yonedaProperty C ⊔ acyclicProperty C).localizingClosure.{v} :=
  isVerdierLeftLocalizing_sup_of_forall_hom_eq_zero C _
    fun M => (forall_hom_eq_zero_iff_isAcyclic M).2

/-- **The essential standard fact of [Stacks, Tag 09LK], with acyclicity as its hypothesis.**
Let `N'` be the localizing subcategory of `K(Mod^dg(C))` generated by the representables
together with the acyclic right differential graded modules, so that `K(Mod^dg(C))/N'` is the
quotient `D(C)/N` of the derived category by the localizing subcategory generated by the
representables. Then the functor

`J : A/(A ⊓ N') ⥤ K(Mod^dg(C))/N'`

is fully faithful, where `A` is the triangulated envelope of the representables. -/
noncomputable def fullyFaithfulVerdierEmbeddingAcyclic :
    (verdierEmbedding (yonedaEnvelope C)
      (yonedaProperty C ⊔ acyclicProperty C).localizingClosure.{v}
      (((yonedaProperty C ⊔ acyclicProperty C).localizingClosure.{v}.inverseImage
        (yonedaEnvelope C).ι).trW.Q)).FullyFaithful :=
  fullyFaithfulVerdierEmbeddingSup C _
    fun M => (forall_hom_eq_zero_iff_isAcyclic M).2

end RightModule

end DGCategory

end
