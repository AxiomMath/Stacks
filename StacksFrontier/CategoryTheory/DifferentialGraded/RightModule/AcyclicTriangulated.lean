module

public import StacksFrontier.CategoryTheory.DifferentialGraded.RightModule.YonedaAcyclic
public import StacksFrontier.CategoryTheory.Triangulated.VerdierLocalizingQuotient

/-!
# The derived category of right differential graded modules

Let `C` be a differential graded category over a commutative ring `R`. The acyclic right
differential graded `C`-modules form a property `DGCategory.RightModule.acyclicProperty` of
objects of the homotopy category `K(Mod^dg(C))`, and the *derived category* `D(C)` is the
Verdier quotient of `K(Mod^dg(C))` by that property. The acyclic modules form a strictly
full triangulated subcategory of `K(Mod^dg(C))`, so this quotient is a triangulated category.

## Main definitions

* `DGCategory.RightModule.derivedCategory`: `D(C)`, the Verdier quotient of `K(Mod^dg(C))` by
  the acyclic modules.
* `DGCategory.RightModule.derivedQ`: the quotient functor `K(Mod^dg(C)) ⥤ D(C)`.

## Main results

* `DGCategory.RightModule.acyclicProperty_eq_rightOrthogonal`: the acyclic modules are the
  right orthogonal of the localizing subcategory generated by the representables.
* The instances `(acyclicProperty C).IsClosedUnderIsomorphisms` and
  `(acyclicProperty C).IsTriangulated`, obtained from that identification.
* `DGCategory.RightModule.isZero_derivedQ_obj`: an acyclic module becomes a zero object of
  `D(C)`.

## Implementation notes

No long exact cohomology sequence is used. By
`DGCategory.RightModule.forall_hom_eq_zero_iff_isAcyclic` a module is acyclic exactly when no
nonzero morphism reaches it from a shift of a representable, that is, when it lies in the right
orthogonal of the localizing subcategory generated by all the representables. A right
orthogonal is strictly full, stable under shifts and triangulated, so every closure property of
the acyclic modules follows from this identification.

## References

* [Stacks Project, Tag 09LK](https://stacks.math.columbia.edu/tag/09LK)
-/

@[expose] public section

namespace DGCategory

universe v u r

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open CategoryTheory.ObjectProperty

namespace RightModule

variable {R : Type r} [CommRing R]

/-- **The acyclic modules are the right orthogonal of the representables.** A right
differential graded `C`-module is acyclic exactly when it lies in `N^⊥` for `N` the localizing
subcategory of `K(Mod^dg(C))` generated by every representable `h_X = C(-, X)`. -/
theorem acyclicProperty_eq_rightOrthogonal (C : DGCategory.{v, u} R) :
    acyclicProperty C = (yonedaProperty C).localizingClosure.{v}.rightOrthogonal := by
  ext M
  rw [acyclicProperty_iff, ← forall_hom_eq_zero_iff_isAcyclic,
    rightOrthogonal_localizingClosure_iff]
  refine ⟨fun h X hX n f => ?_, fun h X n f => h _ ((ofObj_iff _ _).2 ⟨X, rfl⟩) n f⟩
  obtain ⟨Y, rfl⟩ := (ofObj_iff _ _).1 hX
  exact h Y n f

variable {C : DGCategory.{v, u} R}

/-- The acyclic modules are closed under isomorphisms in `K(Mod^dg(C))`. -/
instance : (acyclicProperty C).IsClosedUnderIsomorphisms := by
  rw [acyclicProperty_eq_rightOrthogonal]; infer_instance

/-- The acyclic modules are stable under all shifts in `K(Mod^dg(C))`. -/
instance : (acyclicProperty C).IsStableUnderShift ℤ := by
  rw [acyclicProperty_eq_rightOrthogonal]; infer_instance

/-- The acyclic modules form a triangulated subcategory of `K(Mod^dg(C))`. -/
instance : (acyclicProperty C).IsTriangulated := by
  rw [acyclicProperty_eq_rightOrthogonal]; infer_instance

variable (C)

/-- **The derived category `D(C)`** of right differential graded `C`-modules: the Verdier
quotient of the homotopy category `K(Mod^dg(C))` by the acyclic modules, that is its
localization at the class of morphisms whose cone is acyclic. -/
abbrev derivedCategory : Type _ := (acyclicProperty C).trW.Localization

/-- The quotient functor `K(Mod^dg(C)) ⥤ D(C)`. -/
noncomputable abbrev derivedQ :
    (rightModuleCategory.{v} C).K ⥤ derivedCategory C := (acyclicProperty C).trW.Q

/-- An acyclic right differential graded module becomes a zero object of `D(C)`. -/
theorem isZero_derivedQ_obj {M : (rightModuleCategory.{v} C).K} (hM : IsAcyclic M) :
    IsZero ((derivedQ C).obj M) :=
  isZero_trW_Q_obj (acyclicProperty C) hM

end RightModule

end DGCategory

end
