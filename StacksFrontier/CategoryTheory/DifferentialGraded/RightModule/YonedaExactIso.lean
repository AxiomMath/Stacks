module

public import StacksFrontier.CategoryTheory.DifferentialGraded.RightModule.YonedaExact
public import StacksFrontier.CategoryTheory.DifferentialGraded.RightModule.YonedaShiftIso

/-!
# Steps 1 and 2 of 09LK for an isomorphism-valued comparison

`DGCategory.exists_isTriangulated_derivedHomReflector_yoneda` assembles steps 1 and 2 of
[Stacks, Tag 09LK] for the differential graded Yoneda functor under two hypotheses that the
differential graded category of complexes does not satisfy on the nose: a
`DGCategory.ConeSituation`, whose axiom (B) asks for the strict equalities `X[0] = X` and
`X[n + m] = X[n][m]`, and `DGCategory.ShiftAxiomB.IsStrictRepresentable`.

This file states the same conclusion for a `DGCategory.ConeSituationIso`, whose axiom (B)
carries isomorphisms `X[0] ≅ X` and `X[n + m] ≅ X[n][m]` instead, together with the round-trip
coherence and the hypothesis `DGCategory.DGFunctor.CommShiftKIso` for `X ↦ h_X` — the two
coherences of the comparison isomorphisms with the `ℤ`-action data of the translations, which
`DGCategory.isTriangulated_yonedaOnK_of_commShiftKIso` explains cannot follow from axiom (B)
alone. For the differential graded category of complexes those data are
`CochainComplex.dgConeSituationIso`, `CochainComplex.dgShiftAxiomBIso_roundTripCoherent` and
`CochainComplex.commShiftKIso_yonedaDGFunctor`.

## Main results

* `DGCategory.exists_isTriangulated_derivedHomReflector_yoneda_of_commShiftKIso`: steps 1 and 2
  of [Stacks, Tag 09LK] with `Φ = K(h)`, for an isomorphism-valued axiom (B).

## Implementation notes

The body is that of `DGCategory.exists_isTriangulated_derivedHomReflector_yoneda`: the only
thing the exactness of the source functor is used for is
`DGCategory.exists_isTriangulated_derivedHomReflector`, which takes it as an instance, so
replacing `DGCategory.isTriangulated_yonedaOnK` by
`DGCategory.isTriangulated_yonedaOnK_of_commShiftKIso` is the whole difference. No
strictification occurs on either side, so the triangulated structure on `K(C)` here is the one
`DGCategory.homotopyPretriangulatedIso` attaches to the given cone situation itself.

## References

* [Stacks Project, Tag 0FQF](https://stacks.math.columbia.edu/tag/0FQF)
* [Stacks Project, Tag 09LK](https://stacks.math.columbia.edu/tag/09LK)
-/

@[expose] public section

namespace DGCategory

universe v₂ u₂ v u r

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open CategoryTheory.ObjectProperty

variable {R : Type r} [CommRing R]

/-- **Steps 1 and 2 of [Stacks, Tag 09LK] for the differential graded Yoneda functor, with an
isomorphism-valued axiom (B).** Let `C` be a differential graded category whose objects and
whose morphism modules live in one universe, satisfying axioms (A), (B) and (C) in the form
`DGCategory.ConeSituationIso`, with the round-trip coherence of its shift, and let the
comparison isomorphisms of `X ↦ h_X` be coherent with the `ℤ`-action data of the two
translations. Let `K` be an object of `C` and `G` a family of objects of `C`, let `Z` be a
triangulated subcategory of `K(C)` and `q : K(C) ⥤ D(A)` a localization at the morphisms whose
cone lies in `Z`, and suppose that `h_X` lies in the localizing subcategory generated by the
`h_{G i}` whenever `X` lies in `Z`. Then there are an exact reflector `L` with unit `η`, an
exact functor

`R̃ : D(A) ⥤ D(E)`

with values in the derived category of right differential graded modules over the endomorphism
complex `E = C(K, K)`, and a natural transformation `K(h) ⋙ ev_K ⋙ Q_E ⟶ q ⋙ R̃`; and the
restriction of `R̃` along `q` is the reflected evaluation.

This is `DGCategory.exists_isTriangulated_derivedHomReflector` with its exactness hypothesis on
the source functor discharged by
`DGCategory.isTriangulated_yonedaOnK_of_commShiftKIso`. -/
theorem exists_isTriangulated_derivedHomReflector_yoneda_of_commShiftKIso
    (C : DGCategory.{v, v} R) (K : C.Obj) {ι : Type v} (G : ι → C.Obj) (CC : ConeSituationIso C)
    (hCC : CC.shift.RoundTripCoherent)
    (hK : (yonedaDGFunctor C).CommShiftKIso CC.shift
      (rightModuleShiftAxiomB.{v} C).toShiftAxiomBIso) :
    letI : Preadditive C.K := homotopyPreadditive C
    letI : HasZeroObject C.K := homotopyHasZeroObjectIso C CC
    letI : HasShift C.K ℤ := CC.shift.kShift
    letI : ∀ n : ℤ, (shiftFunctor C.K n).Additive := fun n => homotopyShiftAdditiveIso C CC n
    letI : Pretriangulated C.K := homotopyPretriangulatedIso C CC hCC
    letI : IsTriangulated C.K := homotopyCategory_isTriangulatedIso C CC hCC
    letI : (yonedaDGFunctor C).onK.CommShift ℤ := hK.commShift
    letI : (yonedaDGFunctor C).onK.IsTriangulated :=
      isTriangulated_yonedaOnK_of_commShiftKIso CC hCC hK
    ∀ (Z : ObjectProperty C.K) [Z.IsTriangulated] {DA : Type u₂} [Category.{v₂} DA]
      [HasZeroObject DA] [HasShift DA ℤ] [Preadditive DA]
      [∀ n : ℤ, (shiftFunctor DA n).Additive] [Pretriangulated DA] (q : C.K ⥤ DA)
      [q.IsLocalization Z.trW] [q.CommShift ℤ] [q.IsTriangulated],
      (∀ X, Z X → RightModule.yonedaLocalizing C G (((yonedaDGFunctor C).onK).obj X)) →
      ∃ (L : (rightModuleCategory.{v} C).K ⥤ (rightModuleCategory.{v} C).K)
        (_ : L.CommShift ℤ) (_ : L.IsTriangulated) (_ : 𝟭 _ ⟶ L)
        (Rt : DA ⥤ RightModule.derivedCategory (endDGCategory C K))
        (_ : Rt.CommShift ℤ) (_ : Rt.IsTriangulated)
        (_ : (yonedaDGFunctor C).onK ⋙ evaluationOnK.{v} C K ⋙
          RightModule.derivedQ (endDGCategory C K) ⟶ q ⋙ Rt),
        Nonempty (q ⋙ Rt ≅ (yonedaDGFunctor C).onK ⋙ L ⋙ evaluationOnK.{v} C K ⋙
          RightModule.derivedQ (endDGCategory C K)) := by
  let : Preadditive C.K := homotopyPreadditive C
  let : HasZeroObject C.K := homotopyHasZeroObjectIso C CC
  let : HasShift C.K ℤ := CC.shift.kShift
  let : ∀ n : ℤ, (shiftFunctor C.K n).Additive := fun n => homotopyShiftAdditiveIso C CC n
  let : Pretriangulated C.K := homotopyPretriangulatedIso C CC hCC
  let : IsTriangulated C.K := homotopyCategory_isTriangulatedIso C CC hCC
  let : (yonedaDGFunctor C).onK.CommShift ℤ := hK.commShift
  let : (yonedaDGFunctor C).onK.IsTriangulated :=
    isTriangulated_yonedaOnK_of_commShiftKIso CC hCC hK
  intro Z _ DA _ _ _ _ _ _ q _ _ _ hZ
  exact exists_isTriangulated_derivedHomReflector C K G ((yonedaDGFunctor C).onK) Z q hZ

end DGCategory

end
