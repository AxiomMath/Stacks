module

public import StacksFrontier.CategoryTheory.DifferentialGraded.RightModule.Triangulated
public import StacksFrontier.CategoryTheory.DifferentialGraded.RightModule.YonedaVerdier
public import StacksFrontier.CategoryTheory.Triangulated.LocalReflectorHom

/-!
# The unit of the reflector of step 1 of Tag 09LK is inverted in `K(Mod^dg(C))/N`

Let `C` be a differential graded category over a commutative ring `R` whose objects and whose
morphism modules live in one universe, let `G` be a family of objects of `C` indexed by that
universe, and let `N` be the localizing subcategory of `K(Mod^dg(C))` generated by the
representables `h_{G i}`
(`StacksFrontier.CategoryTheory.DifferentialGraded.RightModule.YonedaVerdier`).

Step 1 of [Stacks, Tag 09LK]
(`DGCategory.RightModule.exists_isTriangulated_reflector_yonedaObjK_of_dgCategory`) produces an
exact reflector `L` with a unit `η : 𝟭 ⟶ L` and three conclusions: every `L X` is `N`-local, `η`
is universal among morphisms into an `N`-local object, and the *fibre* of `η.app X` lies in `N`.
The third conclusion is the one that makes `η.app X` a morphism inverted by the Verdier quotient
at `N`; it is also the one that is easiest to drop, because the descent of a functor along `L`
does not use it.

This file keeps it and uses it. It restates step 1 with the fibre condition replaced by its
consequence `N.trW (η.app X)`, and reads off from
`CategoryTheory.ObjectProperty.homEquivReflectorShift` the identification

`Hom_{K(Mod^dg(C))}(A, (L X)⟦n⟧) ≃ Hom_{K(Mod^dg(C))/N}(Q A, (Q X)⟦n⟧)`

in which neither the reflector nor its unit appears on the right. At `A = h_K` and `X = h_X`
this is the second link of the chain computing `H^n(ev_K(L h_X))`: the first link is the
differential graded Yoneda lemma, and the third — the comparison of `K(Mod^dg(C))/N` with
`D(A)` — is not proved here.

## Main results

* `DGCategory.RightModule.exists_isTriangulated_reflector_yonedaObjK_trW_of_dgCategory`: step 1
  with the fibre condition on the unit replaced by `N.trW (η.app X)`.
* `DGCategory.RightModule.exists_reflector_homEquiv_yonedaObjK`: the displayed identification.

## Implementation notes

The universe condition is the one inherited from step 1: `C : DGCategory.{v, v} R`, with the
generating family indexed by `Type v`. Nothing here adds to it.

## References

* [Stacks Project, Tag 09LK](https://stacks.math.columbia.edu/tag/09LK)
-/

@[expose] public section

namespace DGCategory

universe v' u' v r

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open CategoryTheory.ObjectProperty

variable {R : Type r} [CommRing R]

namespace RightModule

/-- **Step 1 of [Stacks, Tag 09LK], with the unit exhibited as a `trW`-morphism.** Let `N` be
the localizing subcategory of `K(Mod^dg(C))` generated by the representables `h_{G i}`. There
are an exact reflector `L` and a unit `η : 𝟭 ⟶ L` such that every `L X` is `N`-local, `η` is
universal among morphisms into an `N`-local object, and every `η.app X` is inverted by the
Verdier quotient at `N`.

The third conclusion is the third conclusion of
`DGCategory.RightModule.exists_isTriangulated_reflector_yonedaObjK_of_dgCategory` — that the
fibre of `η.app X` lies in `N` — passed through
`CategoryTheory.ObjectProperty.trW_localizingClosure_unit_app`. -/
theorem exists_isTriangulated_reflector_yonedaObjK_trW_of_dgCategory (C : DGCategory.{v, v} R)
    {ι : Type v} (G : ι → C.Obj) :
    ∃ (L : (rightModuleCategory.{v} C).K ⥤ (rightModuleCategory.{v} C).K)
      (_ : L.CommShift ℤ) (_ : L.IsTriangulated) (η : 𝟭 _ ⟶ L),
      (∀ X, (yonedaLocalizing C G).rightOrthogonal (L.obj X)) ∧
      (∀ Y, (yonedaLocalizing C G).rightOrthogonal Y →
        ∀ X, Function.Bijective fun φ : L.obj X ⟶ Y => η.app X ≫ φ) ∧
      (∀ X, (yonedaLocalizing C G).trW (η.app X)) := by
  obtain ⟨L, cs, tri, η, h₁, h₂, h₃⟩ :=
    exists_isTriangulated_reflector_yonedaObjK_of_dgCategory C G
  exact ⟨L, cs, tri, η, h₁, h₂,
    trW_localizingClosure_unit_app (ofObj fun i => yonedaObjK (G i)) h₃⟩

/-- **The second link of the chain of [Stacks, Tag 09LK].** Let `N` be the localizing
subcategory of `K(Mod^dg(C))` generated by the representables `h_{G i}` and let
`Q : K(Mod^dg(C)) ⥤ D` be a Verdier quotient at `N`, commuting with the shift. Then there are an
exact reflector `L` with unit `η : 𝟭 ⟶ L` such that every `L X` is `N`-local, every `η.app X` is
inverted by `Q`, and for every pair of objects `A`, `X` of `K(Mod^dg(C))` and every integer `n`

`Hom_{K(Mod^dg(C))}(A, (L X)⟦n⟧) ≃ Hom_D(Q A, (Q X)⟦n⟧)`.

Neither `L` nor `η` appears on the right-hand side. At `A = h_K` and `X = h_X` the left-hand
side is the group that the differential graded Yoneda lemma identifies with `H^n((L h_X)(K))`,
and the right-hand side is a Hom group of the Verdier quotient. -/
theorem exists_reflector_homEquiv_yonedaObjK (C : DGCategory.{v, v} R) {ι : Type v}
    (G : ι → C.Obj) {D : Type u'} [Category.{v'} D] [HasShift D ℤ]
    (Q : (rightModuleCategory.{v} C).K ⥤ D)
    [Q.IsLocalization (ofObj fun i => yonedaObjK (G i)).localizingClosure.{v}.trW]
    [Q.CommShift ℤ] :
    ∃ (L : (rightModuleCategory.{v} C).K ⥤ (rightModuleCategory.{v} C).K)
      (_ : L.CommShift ℤ) (_ : L.IsTriangulated) (η : 𝟭 _ ⟶ L),
      (∀ X, (yonedaLocalizing C G).rightOrthogonal (L.obj X)) ∧
      (∀ X, (yonedaLocalizing C G).trW (η.app X)) ∧
      ∀ (A X : (rightModuleCategory.{v} C).K) (n : ℤ),
        Nonempty ((A ⟶ (L.obj X)⟦n⟧) ≃ (Q.obj A ⟶ (Q.obj X)⟦n⟧)) := by
  obtain ⟨L, cs, tri, η, h₁, h₂, h₃⟩ :=
    exists_isTriangulated_reflector_yonedaObjK_of_dgCategory C G
  refine ⟨L, cs, tri, η, h₁,
    trW_localizingClosure_unit_app (ofObj fun i => yonedaObjK (G i)) h₃,
    fun A X n => ⟨homEquivReflectorShift (ofObj fun i => yonedaObjK (G i)) Q h₁ h₃ A X n⟩⟩

end RightModule

end DGCategory

end
