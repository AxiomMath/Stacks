module

public import StacksFrontier.CategoryTheory.DifferentialGraded.RightModule.YonedaVerdier
public import StacksFrontier.CategoryTheory.Triangulated.VerdierLocalizingHom

/-!
# Hom groups in the Verdier quotient of the triangulated envelope of the representables

Let `C` be a differential graded category over a commutative ring `R` with at least one object, let
`G` be a family of objects of `C`, and let

* `K = K(Mod^dg(C))` be the homotopy category of right differential graded `C`-modules,
* `N` be the localizing subcategory of `K` generated by the representables `h_{G i}`,
* `A` be the triangulated envelope of *all* the representables `h_X`,
* `Q : K ⥤ K/N` be the Verdier quotient functor and `q : A ⥤ A/(A ⊓ N)` be the quotient
  functor of `A`.

This file proves, for all objects `x`, `y` of `C` and every integer `n`,

`Hom_{A/(A ⊓ N)}(q h_x, (q h_y)⟦n⟧) ≃ Hom_{K/N}(Q h_x, (Q h_y)⟦n⟧)`.

It also proves that if `N'` is the localizing subcategory generated by all the representables
together with any further property `Ac` of objects, then `A ⊓ N' = A` and the quotient functor of
`A` by `A ⊓ N'` sends every object to zero.

## Main definitions

* `DGCategory.RightModule.yonedaEnvelopeQ`: the quotient functor `q : A ⥤ A/(A ⊓ N)`.
* `DGCategory.RightModule.yonedaEnvelopeObj`: an object of `C`, as an object of `A` through its
  representable.
* `DGCategory.RightModule.homEquivYonedaEnvelopeVerdier`: the displayed bijection for arbitrary
  objects of `A`.
* `DGCategory.RightModule.homEquivDerivedYonedaVerdier`: the displayed bijection at the
  representables.
* `DGCategory.RightModule.homEquivDerivedYonedaVerdier'`: the same, with the localizing
  subcategory `N` written out as a localizing closure.

## Main results

* `DGCategory.RightModule.yonedaEnvelope_le_sup_localizingClosure`: `A` lies in `N'`.
* `DGCategory.RightModule.isZero_yonedaEnvelopeQ_sup_obj`: the quotient functor of `A` by
  `A ⊓ N'` sends every object to zero.

## References

* [Stacks Project, Tag 09LK](https://stacks.math.columbia.edu/tag/09LK)
-/

@[expose] public section

namespace DGCategory

universe v u r

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open CategoryTheory.ObjectProperty

variable {R : Type r} [CommRing R] (C : DGCategory.{v, u} R) [Nonempty C.Obj]

namespace RightModule

variable {ι : Type*} (G : ι → C.Obj)

/-- **The quotient functor `q : A ⥤ A/(A ⊓ N)`.** Here `A` is the triangulated envelope of the
representables and `N` the localizing subcategory generated by the `h_{G i}`; the morphisms
inverted are those of `A` whose cone lies in `A ⊓ N`, by
`CategoryTheory.ObjectProperty.trW_inverseImage_ι_iff`. It is the source of the functor `J` of
`DGCategory.RightModule.yonedaVerdierEmbedding`. -/
noncomputable abbrev yonedaEnvelopeQ :
    (yonedaEnvelope C).FullSubcategory ⥤
      ((yonedaLocalizing C G).inverseImage (yonedaEnvelope C).ι).trW.Localization :=
  ((yonedaLocalizing C G).inverseImage (yonedaEnvelope C).ι).trW.Q

/-- An object `x` of `C`, as an object of the triangulated envelope `A` of the representables:
the representable `h_x` is one of the generators of `A`. -/
def yonedaEnvelopeObj (x : C.Obj) : (yonedaEnvelope C).FullSubcategory :=
  ⟨yonedaObjK x, le_triangEnvelope _ _ (ofObj_apply _ x)⟩

omit [Nonempty C.Obj] in
/-- The underlying module of `yonedaEnvelopeObj C x` is the representable `h_x`. -/
@[simp] theorem yonedaEnvelopeObj_obj (x : C.Obj) :
    (yonedaEnvelopeObj C x).1 = yonedaObjK x := rfl

/-- **Hom groups of `A/(A ⊓ N)` are Hom groups of the Verdier quotient by `N`.** Let `N` be the
localizing subcategory of `K(Mod^dg(C))` generated by the representables `h_{G i}`, let `A` be the
triangulated envelope of all the representables, let `q : A ⥤ A/(A ⊓ N)` be the quotient functor of
`A` and let `Q : K(Mod^dg(C)) ⥤ K(Mod^dg(C))/N` be the Verdier quotient functor. Then for all
objects `x`, `y` of `A` and every integer `n`,

`Hom_{A/(A ⊓ N)}(q x, (q y)⟦n⟧) ≃ Hom_{K(Mod^dg(C))/N}(Q x, (Q y)⟦n⟧)`. -/
noncomputable def homEquivYonedaEnvelopeVerdier (x y : (yonedaEnvelope C).FullSubcategory)
    (n : ℤ) :
    ((yonedaEnvelopeQ C G).obj x ⟶ ((yonedaEnvelopeQ C G).obj y)⟦n⟧) ≃
      ((yonedaLocalizing C G).trW.Q.obj x.1 ⟶
        ((yonedaLocalizing C G).trW.Q.obj y.1)⟦n⟧) :=
  haveI := isVerdierLeftLocalizing_yonedaLocalizing C G
  homEquivVerdierEmbeddingShift (yonedaEnvelope C) (yonedaLocalizing C G)
    (yonedaEnvelopeQ C G) x y n

/-- **Hom groups of `A/(A ⊓ N)` between representables are Hom groups of the Verdier quotient by
`N`.** With `N` the localizing subcategory of `K(Mod^dg(C))` generated by the representables
`h_{G i}` and `A` the triangulated envelope of all the representables, for all objects `x`, `y` of
`C` and every integer `n`

`Hom_{A/(A ⊓ N)}(q h_x, (q h_y)⟦n⟧) ≃ Hom_{K(Mod^dg(C))/N}(Q h_x, (Q h_y)⟦n⟧)`. -/
noncomputable def homEquivDerivedYonedaVerdier (x y : C.Obj) (n : ℤ) :
    ((yonedaEnvelopeQ C G).obj (yonedaEnvelopeObj C x) ⟶
        ((yonedaEnvelopeQ C G).obj (yonedaEnvelopeObj C y))⟦n⟧) ≃
      ((yonedaLocalizing C G).trW.Q.obj (yonedaObjK x) ⟶
        ((yonedaLocalizing C G).trW.Q.obj (yonedaObjK y))⟦n⟧) :=
  homEquivYonedaEnvelopeVerdier C G (yonedaEnvelopeObj C x) (yonedaEnvelopeObj C y) n

/-- **Hom groups of `A/(A ⊓ N)` between representables, with `N` written out as a localizing
closure.** The same bijection as `DGCategory.RightModule.homEquivDerivedYonedaVerdier`, with
`DGCategory.RightModule.yonedaLocalizing` unfolded on the right-hand side. -/
noncomputable def homEquivDerivedYonedaVerdier' (x y : C.Obj) (n : ℤ) :
    ((yonedaEnvelopeQ C G).obj (yonedaEnvelopeObj C x) ⟶
        ((yonedaEnvelopeQ C G).obj (yonedaEnvelopeObj C y))⟦n⟧) ≃
      ((ofObj fun i ↦ yonedaObjK (G i)).localizingClosure.{v}.trW.Q.obj (yonedaObjK x) ⟶
        ((ofObj fun i ↦ yonedaObjK (G i)).localizingClosure.{v}.trW.Q.obj
          (yonedaObjK y))⟦n⟧) :=
  homEquivDerivedYonedaVerdier C G x y n

/-! ### Enlarging the generators to all the representables collapses the source -/

omit [Nonempty C.Obj] in
/-- **The triangulated envelope of the representables lies in the localizing subcategory generated
by the representables together with any property `Ac` of objects.** -/
theorem yonedaEnvelope_le_sup_localizingClosure
    (Ac : ObjectProperty (rightModuleCategory.{v} C).K) :
    yonedaEnvelope C ≤ (yonedaProperty C ⊔ Ac).localizingClosure.{v} :=
  le_trans (triangEnvelope_le_localizingClosure.{v} (yonedaProperty C))
    (monotone_localizingClosure le_sup_left)

/-- **The Verdier quotient of `A` by `A ⊓ N'` is the zero category when `N'` is generated by all
the representables together with any property `Ac` of objects.** Here `A` is the triangulated
envelope of the representables, and the quotient functor of `A` by `A ⊓ N'` sends every object of
`A` to zero. -/
theorem isZero_yonedaEnvelopeQ_sup_obj (Ac : ObjectProperty (rightModuleCategory.{v} C).K)
    (x : (yonedaEnvelope C).FullSubcategory) :
    IsZero ((((yonedaProperty C ⊔ Ac).localizingClosure.{v}.inverseImage
      (yonedaEnvelope C).ι).trW.Q).obj x) :=
  isZero_trW_Q_obj _ (yonedaEnvelope_le_sup_localizingClosure C Ac x.1 x.2)

end RightModule

end DGCategory

end
