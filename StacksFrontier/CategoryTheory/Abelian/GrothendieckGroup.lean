module

public import Mathlib.Algebra.Homology.ShortComplex.ShortExact
public import Mathlib.GroupTheory.FreeAbelianGroup
public import Mathlib.GroupTheory.QuotientGroup.Defs
public import Mathlib.Tactic.Abel
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The Grothendieck group K₀ of an abelian category

Stacks, Homological Algebra, Section 12.11: the zeroth K-group `K₀(𝒜)` of an abelian category
(02MU), its universal property, the first relations between classes of objects, and the
homomorphism of K-groups induced by an exact functor (02MV).
-/

@[expose] public section

open CategoryTheory Limits

variable (𝒜 : Type*) [Category 𝒜] [Abelian 𝒜]

/-- The subgroup of `FreeAbelianGroup 𝒜` generated by the elements
`[X₂] − [X₁] − [X₃]` coming from short exact sequences `0 → X₁ → X₂ → X₃ → 0`
in the abelian category `𝒜`. Quotienting by this subgroup yields `K₀(𝒜)`. -/
noncomputable def kZeroRelations : AddSubgroup (FreeAbelianGroup 𝒜) :=
  AddSubgroup.closure
    { x | ∃ (S : ShortComplex 𝒜) (_ : S.ShortExact),
        x = FreeAbelianGroup.of S.X₂
              - FreeAbelianGroup.of S.X₁
              - FreeAbelianGroup.of S.X₃ }

/-- The zeroth K-group `K₀(𝒜)` of an abelian category `𝒜` (Stacks tag 02MU).
It is the free abelian group on the objects of `𝒜`, modulo the relation
`[B] - [A] - [C] = 0` for every short exact sequence `0 → A → B → C → 0`. -/
@[stacks 02MU, sga "6 0 3.1" "more general"]
noncomputable abbrev KZero : Type _ :=
  FreeAbelianGroup 𝒜 ⧸ kZeroRelations 𝒜

namespace KZero

/-- The class `[X]` of an object `X` of `𝒜` in `K₀(𝒜)`. -/
noncomputable def mk (X : 𝒜) : KZero 𝒜 :=
  QuotientAddGroup.mk' (kZeroRelations 𝒜) (FreeAbelianGroup.of X)

variable {𝒜}

/-- **The defining relation of `K₀(𝒜)`.** For a short exact sequence `0 → X₁ → X₂ → X₃ → 0`,
`[X₂] = [X₁] + [X₃]` in `K₀(𝒜)`. -/
theorem mk_of_shortExact (S : ShortComplex 𝒜) (hS : S.ShortExact) :
    mk 𝒜 S.X₂ = mk 𝒜 S.X₁ + mk 𝒜 S.X₃ := by
  rw [mk, mk, mk, ← map_add, QuotientAddGroup.mk'_eq_mk']
  refine ⟨-(FreeAbelianGroup.of S.X₂ - FreeAbelianGroup.of S.X₁ - FreeAbelianGroup.of S.X₃),
    AddSubgroup.neg_mem _ (AddSubgroup.subset_closure ⟨S, hS, rfl⟩), by abel⟩

section lift

variable {G : Type*} [AddCommGroup G] (f : 𝒜 → G)
  (hf : ∀ (S : ShortComplex 𝒜), S.ShortExact → f S.X₂ = f S.X₁ + f S.X₃)

/-- The homomorphism `K₀(𝒜) →+ G` induced by a function `f` on the objects of `𝒜` which is
additive along short exact sequences. -/
noncomputable def lift : KZero 𝒜 →+ G :=
  QuotientAddGroup.lift (kZeroRelations 𝒜) (FreeAbelianGroup.lift f) <|
    (AddSubgroup.closure_le _).mpr <| by
      rintro x ⟨S, hS, rfl⟩
      simp [AddMonoidHom.mem_ker, hf S hS]

/-- The homomorphism `KZero.lift f hf` sends the class `[X]` to `f X`. -/
@[simp]
theorem lift_mk (X : 𝒜) : lift f hf (mk 𝒜 X) = f X :=
  FreeAbelianGroup.lift_apply_of f X

end lift

/-- Two homomorphisms out of `K₀(𝒜)` agreeing on the classes of objects are equal. -/
theorem hom_ext {G : Type*} [AddCommGroup G] {F F' : KZero 𝒜 →+ G}
    (h : ∀ X : 𝒜, F (mk 𝒜 X) = F' (mk 𝒜 X)) : F = F' :=
  QuotientAddGroup.addMonoidHom_ext _ (FreeAbelianGroup.lift_ext _ _ h)

/-- **Universal property of `K₀(𝒜)`.** A function `f` on the objects of `𝒜` which is additive
along short exact sequences factors through a unique homomorphism `K₀(𝒜) →+ G` sending `[X]` to
`f X`. -/
theorem universal {G : Type*} [AddCommGroup G] (f : 𝒜 → G)
    (hf : ∀ (S : ShortComplex 𝒜), S.ShortExact → f S.X₂ = f S.X₁ + f S.X₃) :
    ∃! F : KZero 𝒜 →+ G, ∀ X : 𝒜, F (mk 𝒜 X) = f X :=
  ⟨lift f hf, lift_mk f hf, fun _ hF' => hom_ext fun X => by rw [hF', lift_mk]⟩

/-- For a monomorphism `i : X ⟶ Y`, `[Y] = [X] + [coker i]` in `K₀(𝒜)`. -/
theorem mk_eq_add_cokernel {X Y : 𝒜} (i : X ⟶ Y) [Mono i] :
    mk 𝒜 Y = mk 𝒜 X + mk 𝒜 (cokernel i) :=
  mk_of_shortExact (ShortComplex.mk i (cokernel.π i) (by simp))
    (ShortComplex.ShortExact.mk' (ShortComplex.exact_of_g_is_cokernel _ (cokernelIsCokernel _))
      (by dsimp; infer_instance) (by dsimp; infer_instance))

/-- The class of a zero object in `K₀(𝒜)` is `0`. -/
theorem mk_eq_zero_of_isZero {X : 𝒜} (hX : IsZero X) : mk 𝒜 X = 0 := by
  have : Mono (0 : X ⟶ X) := ⟨fun _ _ _ => hX.eq_of_tgt _ _⟩
  have : Epi (0 : X ⟶ X) := ⟨fun _ _ _ => hX.eq_of_src _ _⟩
  exact left_eq_add.mp <| mk_of_shortExact (ShortComplex.mk (0 : X ⟶ X) (0 : X ⟶ X) (by simp))
    (ShortComplex.ShortExact.mk' (ShortComplex.exact_of_isZero_X₂ _ hX) inferInstance
      inferInstance)

/-- Isomorphic objects have the same class in `K₀(𝒜)`. -/
theorem mk_eq_of_iso {X Y : 𝒜} (e : X ≅ Y) : mk 𝒜 X = mk 𝒜 Y := by
  rw [mk_eq_add_cokernel e.hom, mk_eq_zero_of_isZero (isZero_cokernel_of_epi e.hom), add_zero]

/-- For a morphism `f : X ⟶ Y`, `[X] = [ker f] + [im f]` in `K₀(𝒜)`. -/
theorem mk_eq_kernel_add_image {X Y : 𝒜} (f : X ⟶ Y) :
    mk 𝒜 X = mk 𝒜 (kernel f) + mk 𝒜 (Abelian.image f) := by
  rw [mk_eq_add_cokernel (kernel.ι f)]
  exact congrArg _ (mk_eq_of_iso (Abelian.coimageIsoImage f))

/-- For a morphism `f : X ⟶ Y`, `[Y] = [im f] + [coker f]` in `K₀(𝒜)`. -/
theorem mk_eq_image_add_cokernel {X Y : 𝒜} (f : X ⟶ Y) :
    mk 𝒜 Y = mk 𝒜 (Abelian.image f) + mk 𝒜 (cokernel f) :=
  mk_of_shortExact
    (ShortComplex.mk (Abelian.image.ι f) (cokernel.π f) (kernel.condition (cokernel.π f)))
    (ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ (kernelIsKernel _))
      (by dsimp; infer_instance) (by dsimp; infer_instance))

end KZero

/-- **Stacks Tag 02MV.** An exact functor `F : C ⥤ D` between abelian categories
induces a unique homomorphism of K-groups `K₀(F) : K₀(C) → K₀(D)` satisfying
`K₀(F)([A]) = [F(A)]` for every object `A`. -/
@[stacks 02MV]
theorem exactFunctor_induces_kZeroHom {C D : Type*} [Category C] [Abelian C] [Category D]
    [Abelian D] (F : C ⥤ D) [F.Additive] [PreservesFiniteLimits F] [PreservesFiniteColimits F] :
    ∃! (φ : KZero C →+ KZero D), ∀ A : C, φ (KZero.mk C A) = KZero.mk D (F.obj A) :=
  KZero.universal _ fun _ hS => KZero.mk_of_shortExact _ (hS.map_of_exact F)
