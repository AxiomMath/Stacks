module

public import Mathlib.CategoryTheory.Abelian.Basic
public import Mathlib.CategoryTheory.Preadditive.AdditiveFunctor
public import Mathlib.CategoryTheory.Limits.Preserves.Shapes.Biproducts
public import Mathlib.CategoryTheory.Preadditive.Biproducts

/-!
# Subobjects generated by a jointly epimorphic family, along an exact functor

Let `ι : N ⟶ M` be a monomorphism of an abelian category through which a finite family of
morphisms `fⱼ = eⱼ ≫ ι : Aⱼ ⟶ M` factors with `(eⱼ)` jointly epimorphic, so that `N` is the image
of `(fⱼ)`.  An additive functor `Φ` preserving epimorphisms and monomorphisms carries `N` to the
image of `(Φ fⱼ)`: if on the target side `N' ⟶ Φ M` is a monomorphism through which the `Φ fⱼ`
factor, up to isomorphisms of their sources, by a jointly epimorphic family, then `Φ N ≅ N'` over
`Φ M`.  Both are image factorisations of one morphism out of the biproduct.

This is how a twist `− ⊗ ℒ` by an invertible module is seen to carry the submodule `Iⁿ F` to
`Iⁿ (F ⊗ ℒ)` in the proof of Stacks 0D39.

## Main definitions

* `Stacks.Abelian.subobjectIsoOfJointlyEpi`: the isomorphism `Φ N ≅ N'`, and
  `Stacks.Abelian.subobjectIsoOfJointlyEpi_hom_comp`: its compatibility with the inclusions.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe v₁ v₂ u₁ u₂

namespace Stacks.Abelian

attribute [local instance] HasFiniteBiproducts.of_hasFiniteProducts

variable {𝒜 : Type u₁} [Category.{v₁} 𝒜] [Abelian 𝒜] {ℬ : Type u₂} [Category.{v₂} ℬ] [Abelian ℬ]
  (Φ : 𝒜 ⥤ ℬ) [Φ.Additive] [Φ.PreservesEpimorphisms]
  {J : Type} [Finite J] [DecidableEq J]

omit [DecidableEq J] in
/-- In an abelian category a finite family of morphisms into `N` is jointly epimorphic exactly
when the morphism out of their biproduct is an epimorphism. -/
theorem epi_biproduct_desc_of_jointlyEpi {A : J → 𝒜} {N : 𝒜} (e : ∀ j, A j ⟶ N)
    (he : ∀ ⦃Q : 𝒜⦄ (g : N ⟶ Q), (∀ j, e j ≫ g = 0) → g = 0) : Epi (biproduct.desc e) :=
  Preadditive.epi_of_cancel_zero _ fun {Q} g hg =>
    he g fun j => by rw [← biproduct.ι_desc_assoc e j, hg, comp_zero]

variable {A : J → 𝒜} {N M : 𝒜} (e : ∀ j, A j ⟶ N) (ι : N ⟶ M) [Mono ι]
  (he : ∀ ⦃Q : 𝒜⦄ (g : N ⟶ Q), (∀ j, e j ≫ g = 0) → g = 0)
  {A' : J → ℬ} {N' : ℬ} (e' : ∀ j, A' j ⟶ N') (ι' : N' ⟶ Φ.obj M) [Mono ι']
  (he' : ∀ ⦃Q : ℬ⦄ (g : N' ⟶ Q), (∀ j, e' j ≫ g = 0) → g = 0)
  (α : ∀ j, Φ.obj (A j) ≅ A' j) (hα : ∀ j, Φ.map (e j ≫ ι) = (α j).hom ≫ e' j ≫ ι')

omit [Φ.PreservesEpimorphisms] [DecidableEq J] [Mono ι] [Mono ι'] in
include hα in
/-- Up to the comparison `Φ (⨁ Aⱼ) ≅ ⨁ A'ⱼ` built from the `αⱼ`, the morphism out of the biproduct
of the `A'ⱼ` into `Φ M` is the image under `Φ` of the morphism out of the biproduct of the `Aⱼ`
into `M`. -/
theorem map_biproduct_desc_comp_eq :
    (Φ.mapBiproduct A ≪≫ biproduct.mapIso α).hom ≫ biproduct.desc e' ≫ ι' =
      Φ.map (biproduct.desc e ≫ ι) := by
  rw [← cancel_epi (Φ.mapBiproduct A).inv]
  refine biproduct.hom_ext' _ _ fun j => ?_
  rw [Iso.trans_hom, Category.assoc, Iso.inv_hom_id_assoc, biproduct.mapIso_hom,
    biproduct.ι_map_assoc, biproduct.ι_desc_assoc, Φ.map_comp, ← Category.assoc,
    ← Category.assoc (Φ.mapBiproduct A).inv,
    biproduct.mapBiproduct_inv_map_desc, biproduct.ι_desc_assoc, ← Φ.map_comp, hα,
    Category.assoc]

include he he' hα in
/-- **The image of a jointly epimorphic family is carried to the image of its image.** -/
def subobjectIsoOfJointlyEpi [Φ.PreservesMonomorphisms] : Φ.obj N ≅ N' :=
  haveI := epi_biproduct_desc_of_jointlyEpi e he
  haveI := epi_biproduct_desc_of_jointlyEpi e' he'
  haveI : StrongEpi (Φ.map (biproduct.desc e)) := strongEpi_of_epi _
  haveI : StrongEpi ((Φ.mapBiproduct A ≪≫ biproduct.mapIso α).hom ≫ biproduct.desc e') :=
    strongEpi_of_epi _
  image.isoStrongEpiMono (Φ.map (biproduct.desc e)) (Φ.map ι) (Φ.map_comp _ _).symm ≪≫
    (image.isoStrongEpiMono ((Φ.mapBiproduct A ≪≫ biproduct.mapIso α).hom ≫ biproduct.desc e')
      ι' (by rw [Category.assoc]; exact map_biproduct_desc_comp_eq Φ e ι e' ι' α hα)).symm

omit [DecidableEq J] in
/-- The isomorphism `subobjectIsoOfJointlyEpi` is compatible with the inclusions `Φ ι` and `ι'`
into `Φ M`. -/
@[reassoc (attr := simp)]
theorem subobjectIsoOfJointlyEpi_hom_comp [Φ.PreservesMonomorphisms] :
    (subobjectIsoOfJointlyEpi Φ e ι he e' ι' he' α hα).hom ≫ ι' = Φ.map ι := by
  simp [subobjectIsoOfJointlyEpi]

end Stacks.Abelian

end
