module

public import Mathlib.Algebra.Homology.ShortComplex.ShortExact
public import Mathlib.CategoryTheory.Abelian.Basic
public import Mathlib.Algebra.Homology.ShortComplex.Exact
public import Mathlib.Data.Finset.Lattice.Fold
public import Mathlib.Order.Basic

/-!
# Uniform vanishing for families with commuting maps generated in bounded degree

Let `𝒜` be an abelian category.  A *commuting family* of rank `r` is a sequence of objects
`G₀, G₁, …` of `𝒜` together with `r` families of maps `μᵢ : Gₙ ⟶ Gₙ₊₁` that commute with one
another — the shape of a graded module over a polynomial ring in `r` variables, all of whose
generators have degree one.  It is *generated in degrees `≤ N`* when for every `n ≥ N` the map
`∐ᵢ Gₙ ⟶ Gₙ₊₁` with components the `μᵢ` is an epimorphism.

This file proves the formal part of the uniform vanishing statement that the proof of
Stacks 0897, part (2), produces and that the proof of Stacks 0D39 consumes: given a family of
exact endofunctors `Φ_d` of `𝒜` (the twists `- ⊗ ℒ^{⊗ d}`) and a family of functors `H^p`
satisfying the two halves of the long exact cohomology sequence that the argument uses, if every
member `A` of a class of objects `P` closed under kernels and cokernels has `H^p(Φ_d A) = 0` for
`p > 0` and `d ≫ 0`, and if the kernel family of the last map of a generated `P`-family is again
generated (the Noetherian input), then for every generated `P`-family there is **one** `d₀` with
`H^p(Φ_d Gₙ) = 0` for every `p > 0`, every `d ≥ d₀` and **every** `n`.

## Main definitions

* `Stacks.CommutingFamily`: a family of objects with `r` commuting maps of degree one.
* `Stacks.CommutingFamily.GeneratedFrom`, `Stacks.CommutingFamily.IsGenerated`: generation in
  bounded degree.
* `Stacks.CommutingFamily.kernelFamily` and `Stacks.CommutingFamily.cokernelFamily`: the kernels
  and the cokernels of the last map `μ_r`, which are commuting families of rank `r - 1`.

## Main results

* `Stacks.CommutingFamily.generatedFrom_cokernelFamily`: the cokernel family of a family
  generated in degrees `≤ N` is generated in degrees `≤ N`.
* `Stacks.CommutingFamily.exists_forall_isZero_of_isGenerated`: **the uniform vanishing.**

## The argument

By induction on `r`.  For `r = 0` generation in degrees `≤ N` says `Gₙ = 0` for `n > N`, and the
finitely many remaining members are handled one at a time.  For `r + 1`, write `μ = μ_{r+1}`,
`Kₙ = ker(μ : Gₙ ⟶ Gₙ₊₁)` and `Cₙ = coker(μ : Gₙ ⟶ Gₙ₊₁)`; the other maps make `K` and `C`
commuting families of rank `r`, generated by hypothesis and by
`generatedFrom_cokernelFamily` respectively, so by induction there is one `d₀` serving both, and
also `G₀`.  The two short exact sequences `0 ⟶ Kₙ ⟶ Gₙ ⟶ Iₙ ⟶ 0` and `0 ⟶ Iₙ ⟶ Gₙ₊₁ ⟶ Cₙ ⟶ 0`,
with `Iₙ` the image of `μ`, stay short exact after applying `Φ_d`, and the two halves of the long
exact sequence then carry the vanishing of `H^p(Φ_d Gₙ)` to `H^p(Φ_d Iₙ)` and to `H^p(Φ_d Gₙ₊₁)`.

## References

* [Stacks Project, Tag 0897](https://stacks.math.columbia.edu/tag/0897)
* [Stacks Project, Tag 0D39](https://stacks.math.columbia.edu/tag/0D39)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe v u v' u'

namespace Stacks

/-- A sequence of objects `G₀, G₁, …` with `r` families of maps `μᵢ : Gₙ ⟶ Gₙ₊₁` that commute
with one another. -/
structure CommutingFamily (𝒜 : Type u) [Category.{v} 𝒜] (r : ℕ) where
  /-- The members of the family. -/
  obj : ℕ → 𝒜
  /-- The `r` families of maps of degree one. -/
  act : Fin r → ∀ n, obj n ⟶ obj (n + 1)
  /-- The maps commute. -/
  comm : ∀ i j n, act i n ≫ act j (n + 1) = act j n ≫ act i (n + 1)

namespace CommutingFamily

variable {𝒜 : Type u} [Category.{v} 𝒜] [Abelian 𝒜] {r : ℕ}

/-- The family is *generated in degrees `≤ N`*: for every `n ≥ N` the maps `Gₙ ⟶ Gₙ₊₁` of the
family are jointly epimorphic, that is, a map out of `Gₙ₊₁` killed by all of them is zero.  In an
abelian category this is surjectivity of `∐ᵢ Gₙ ⟶ Gₙ₊₁`. -/
def GeneratedFrom (G : CommutingFamily 𝒜 r) (N : ℕ) : Prop :=
  ∀ n, N ≤ n → ∀ ⦃Q : 𝒜⦄ (g : G.obj (n + 1) ⟶ Q), (∀ i, G.act i n ≫ g = 0) → g = 0

/-- The family is *generated in bounded degree*. -/
def IsGenerated (G : CommutingFamily 𝒜 r) : Prop :=
  ∃ N, G.GeneratedFrom N

/-- The kernels of the last map of a commuting family of rank `r + 1`, with the other maps,
form a commuting family of rank `r`. -/
abbrev kernelFamily (G : CommutingFamily 𝒜 (r + 1)) : CommutingFamily 𝒜 r where
  obj n := kernel (G.act (Fin.last r) n)
  act i n := kernel.lift _ (kernel.ι _ ≫ G.act i.castSucc n) (by
    rw [Category.assoc, G.comm, ← Category.assoc, kernel.condition, zero_comp])
  comm i j n := by
    apply equalizer.hom_ext
    simp only [Category.assoc, kernel.lift_ι]
    rw [← Category.assoc (kernel.lift _ _ _), kernel.lift_ι, Category.assoc, G.comm,
      ← Category.assoc (kernel.lift _ _ _), kernel.lift_ι, Category.assoc]

/-- The structure maps of the kernel family are the restrictions of those of the family. -/
@[reassoc]
theorem kernelFamily_act_ι (G : CommutingFamily 𝒜 (r + 1)) (i : Fin r) (n : ℕ) :
    G.kernelFamily.act i n ≫ kernel.ι (G.act (Fin.last r) (n + 1)) =
      kernel.ι (G.act (Fin.last r) n) ≫ G.act i.castSucc n :=
  kernel.lift_ι _ _ _

/-- The map `coker(Gₙ ⟶ Gₙ₊₁) ⟶ coker(Gₙ₊₁ ⟶ Gₙ₊₂)` induced by the `i`-th of the other maps
of a commuting family of rank `r + 1`. -/
def cokernelAct (G : CommutingFamily 𝒜 (r + 1)) (i : Fin r) (n : ℕ) :
    cokernel (G.act (Fin.last r) n) ⟶ cokernel (G.act (Fin.last r) (n + 1)) :=
  cokernel.desc _ (G.act i.castSucc (n + 1) ≫ cokernel.π (G.act (Fin.last r) (n + 1)))
    (by rw [← Category.assoc, G.comm, Category.assoc, cokernel.condition, comp_zero])

/-- The induced map on cokernels is induced by the map of the family. -/
@[reassoc]
theorem π_cokernelAct (G : CommutingFamily 𝒜 (r + 1)) (i : Fin r) (n : ℕ) :
    cokernel.π (G.act (Fin.last r) n) ≫ G.cokernelAct i n =
      G.act i.castSucc (n + 1) ≫ cokernel.π (G.act (Fin.last r) (n + 1)) :=
  cokernel.π_desc _ _ _

/-- The cokernels of the last map of a commuting family of rank `r + 1`, with the maps induced
by the other maps, form a commuting family of rank `r`.  The `n`-th member is the cokernel of
the last map `Gₙ ⟶ Gₙ₊₁`. -/
abbrev cokernelFamily (G : CommutingFamily 𝒜 (r + 1)) : CommutingFamily 𝒜 r where
  obj n := cokernel (G.act (Fin.last r) n)
  act i n := G.cokernelAct i n
  comm i j n := by
    apply coequalizer.hom_ext
    rw [π_cokernelAct_assoc, π_cokernelAct, π_cokernelAct_assoc, π_cokernelAct,
      ← Category.assoc, G.comm, Category.assoc]

/-- The structure maps of the cokernel family are induced by those of the family. -/
@[reassoc]
theorem π_cokernelFamily_act (G : CommutingFamily 𝒜 (r + 1)) (i : Fin r) (n : ℕ) :
    cokernel.π (G.act (Fin.last r) n) ≫ G.cokernelFamily.act i n =
      G.act i.castSucc (n + 1) ≫ cokernel.π (G.act (Fin.last r) (n + 1)) :=
  π_cokernelAct G i n

/-- **The cokernel family of a family generated in degrees `≤ N` is generated in degrees
`≤ N`.**  A map out of `Cₙ₊₁ = coker(Gₙ₊₁ ⟶ Gₙ₊₂)` killed by the induced maps gives, after the
projection from `Gₙ₊₂`, a map killed by all the maps of the family — the last one because it
factors through the projection — which is therefore zero. -/
theorem generatedFrom_cokernelFamily (G : CommutingFamily 𝒜 (r + 1)) {N : ℕ}
    (hG : G.GeneratedFrom N) : G.cokernelFamily.GeneratedFrom N := by
  intro n hn Q g hg
  have h : cokernel.π (G.act (Fin.last r) (n + 1)) ≫ g = 0 := by
    refine hG (n + 1) (by omega) _ fun i => ?_
    refine Fin.lastCases ?_ (fun i => ?_) i
    · rw [← Category.assoc, cokernel.condition, zero_comp]
    · rw [← Category.assoc, ← π_cokernelFamily_act, Category.assoc, hg i, comp_zero]
  exact (cancel_epi (cokernel.π (G.act (Fin.last r) (n + 1)))).1 (h.trans (comp_zero).symm)

/-- A commuting family of rank `0` generated in degrees `≤ N` vanishes above `N`: there are no
maps, so the identity of `Gₙ₊₁` is killed by all of them. -/
theorem isZero_obj_of_generatedFrom_zero (G : CommutingFamily 𝒜 0) {N : ℕ}
    (hG : G.GeneratedFrom N) {n : ℕ} (hn : N < n) : IsZero (G.obj n) := by
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  exact (IsZero.iff_id_eq_zero _).2 (hG m (by omega) (𝟙 _) fun i => i.elim0)

/-- The short exact sequence `0 ⟶ ker f ⟶ A ⟶ im f ⟶ 0` of a morphism in an abelian category. -/
theorem shortExact_kernel_ι_factorThruImage {A B : 𝒜} (f : A ⟶ B) :
    (ShortComplex.mk (kernel.ι f) (Abelian.factorThruImage f) (by
      rw [← cancel_mono (Abelian.image.ι f), Category.assoc, Abelian.image.fac,
        kernel.condition, zero_comp])).ShortExact where
  exact := ShortComplex.exact_of_f_is_kernel _
    (isKernelOfComp (Abelian.image.ι f) f (kernelIsKernel f) _ (Abelian.image.fac f))

/-- The short exact sequence `0 ⟶ im f ⟶ B ⟶ coker f ⟶ 0` of a morphism in an abelian
category. -/
theorem shortExact_image_ι_cokernel_π {A B : 𝒜} (f : A ⟶ B) :
    (ShortComplex.mk (Abelian.image.ι f) (cokernel.π f)
      (kernel.condition (cokernel.π f))).ShortExact where
  exact := ShortComplex.exact_of_f_is_kernel _ (kernelIsKernel (cokernel.π f))

section Vanishing

variable {𝒟 : Type u'} [Category.{v'} 𝒟] [HasZeroMorphisms 𝒟]

omit [HasZeroMorphisms 𝒟] in
/-- **Uniform vanishing for commuting families generated in bounded degree.**

Let `Φ_d` be exact endofunctors of `𝒜` and `H^p` functors to `𝒟` satisfying the two halves of the
long exact cohomology sequence used below (`hE₁`: on a short exact sequence `0 → A → B → C → 0`,
`H^p(B) = 0` and `H^{p+1}(A) = 0` give `H^p(C) = 0`; `hE₂`: `H^p(A) = 0` and `H^p(C) = 0` give
`H^p(B) = 0`; both for `p > 0`).  Let `P` be a class of objects closed under kernels and
cokernels, each of whose members `A` has `H^p(Φ_d A) = 0` for `p > 0` and `d` large
(`hbase`), and assume the Noetherian property `hnoeth`: the kernel family of the last map of a
generated `P`-family is generated.  Then every `P`-family generated in bounded degree has one
`d₀` with `H^p(Φ_d Gₙ) = 0` for every `d ≥ d₀`, every `n` and every `p > 0`. -/
theorem exists_forall_isZero_of_isGenerated
    (H : ℕ → 𝒜 ⥤ 𝒟) (hH0 : ∀ p (A : 𝒜), IsZero A → IsZero ((H p).obj A))
    (hE₁ : ∀ S : ShortComplex 𝒜, S.ShortExact → ∀ p, 0 < p →
      IsZero ((H p).obj S.X₂) → IsZero ((H (p + 1)).obj S.X₁) → IsZero ((H p).obj S.X₃))
    (hE₂ : ∀ S : ShortComplex 𝒜, S.ShortExact → ∀ p, 0 < p →
      IsZero ((H p).obj S.X₁) → IsZero ((H p).obj S.X₃) → IsZero ((H p).obj S.X₂))
    (Φ : ℕ → 𝒜 ⥤ 𝒜) (hΦ0 : ∀ d (A : 𝒜), IsZero A → IsZero ((Φ d).obj A))
    (hΦ : ∀ d (S : ShortComplex 𝒜), S.ShortExact → ∃ T : ShortComplex 𝒜, T.ShortExact ∧
      T.X₁ = (Φ d).obj S.X₁ ∧ T.X₂ = (Φ d).obj S.X₂ ∧ T.X₃ = (Φ d).obj S.X₃)
    (P : ObjectProperty 𝒜)
    (hPker : ∀ ⦃A B : 𝒜⦄ (f : A ⟶ B), P A → P B → P (kernel f))
    (hPcoker : ∀ ⦃A B : 𝒜⦄ (f : A ⟶ B), P A → P B → P (cokernel f))
    (hbase : ∀ A, P A → ∃ d₀ : ℕ, ∀ d, d₀ ≤ d → ∀ p, 0 < p → IsZero ((H p).obj ((Φ d).obj A)))
    (hnoeth : ∀ (r : ℕ) (G : CommutingFamily 𝒜 (r + 1)), (∀ n, P (G.obj n)) → G.IsGenerated →
      G.kernelFamily.IsGenerated) :
    ∀ (r : ℕ) (G : CommutingFamily 𝒜 r), (∀ n, P (G.obj n)) → G.IsGenerated →
      ∃ d₀ : ℕ, ∀ d, d₀ ≤ d → ∀ n p, 0 < p → IsZero ((H p).obj ((Φ d).obj (G.obj n))) := by
  intro r
  induction r with
  | zero =>
    rintro G hP ⟨N, hN⟩
    choose e he using fun n => hbase (G.obj n) (hP n)
    refine ⟨(Finset.range (N + 1)).sup e, fun d hd n p hp => ?_⟩
    by_cases hn : n ≤ N
    · exact he n d (le_trans (Finset.le_sup (Finset.mem_range.2 (by omega))) hd) p hp
    · exact hH0 _ _ (hΦ0 _ _ (isZero_obj_of_generatedFrom_zero G hN (by omega)))
  | succ r ih =>
    rintro G hP ⟨N, hN⟩
    obtain ⟨dK, hK⟩ := ih G.kernelFamily (fun n => hPker _ (hP n) (hP (n + 1)))
      (hnoeth r G hP ⟨N, hN⟩)
    obtain ⟨dC, hC⟩ := ih G.cokernelFamily (fun n => hPcoker _ (hP n) (hP (n + 1)))
      ⟨N, G.generatedFrom_cokernelFamily hN⟩
    obtain ⟨d0, h0⟩ := hbase (G.obj 0) (hP 0)
    refine ⟨max (max dK dC) d0, fun d hd n => ?_⟩
    have hdK : dK ≤ d := by omega
    have hdC : dC ≤ d := by omega
    have hd0 : d0 ≤ d := by omega
    induction n with
    | zero => exact h0 d hd0
    | succ n ihn =>
      intro p hp
      obtain ⟨T₁, hT₁, h₁₁, h₁₂, h₁₃⟩ :=
        hΦ d _ (shortExact_kernel_ι_factorThruImage (G.act (Fin.last r) n))
      obtain ⟨T₂, hT₂, h₂₁, h₂₂, h₂₃⟩ :=
        hΦ d _ (shortExact_image_ι_cokernel_π (G.act (Fin.last r) n))
      have hI := hE₁ T₁ hT₁ p hp (h₁₂ ▸ ihn p hp) (h₁₁ ▸ hK d hdK n (p + 1) (by omega))
      exact h₂₂ ▸ hE₂ T₂ hT₂ p hp (h₂₁ ▸ h₁₃ ▸ hI) (h₂₃ ▸ hC d hdC n p hp)

end Vanishing

end CommutingFamily

end Stacks

end
