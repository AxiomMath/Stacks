module

public import Mathlib.CategoryTheory.Functor.EpiMono
public import Mathlib.CategoryTheory.Subobject.WellPowered

/-!
# Well-poweredness transfers along a fully faithful functor preserving monomorphisms

If `G : D ⥤ C` is fully faithful and preserves monomorphisms, then `Subobject Y` injects into
`Subobject (G.obj Y)` for every `Y : D`, by sending a subobject to the subobject generated by the
image of its arrow. So `D` is well-powered as soon as `C` is and `D` is locally small.

## Main results

* `Stacks.WellPoweredTransfer.le_of_map_le`: a fully faithful functor preserving monomorphisms
  reflects the subobject order.
* `Stacks.WellPoweredTransfer.small_subobject_of_fullyFaithful`: `Subobject Y` is `w`-small.
* `Stacks.WellPoweredTransfer.wellPowered_of_fullyFaithful`: `D` is `WellPowered.{w}`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe v₁ v₂ w u₁ u₂

namespace Stacks.WellPoweredTransfer

variable {D : Type u₁} [Category.{v₁} D] {C : Type u₂} [Category.{v₂} C]
  (G : D ⥤ C) [G.Full] [G.Faithful] [G.PreservesMonomorphisms]

include G

/-- A fully faithful functor preserving monomorphisms reflects the subobject order. -/
theorem le_of_map_le {Y : D} {S T : Subobject Y}
    (h : Subobject.mk (G.map S.arrow) ≤ Subobject.mk (G.map T.arrow)) : S ≤ T :=
  Subobject.le_of_comm (G.preimage (Subobject.ofMkLEMk _ _ h)) <|
    G.map_injective <| by rw [G.map_comp, G.map_preimage]; exact Subobject.ofMkLEMk_comp h

/-- The subobjects of `Y` are `w`-small when the subobjects of `G.obj Y` are. -/
theorem small_subobject_of_fullyFaithful [LocallySmall.{w} C] [WellPowered.{w} C] (Y : D) :
    Small.{w} (Subobject Y) :=
  small_of_injective (f := fun S : Subobject Y => Subobject.mk (G.map S.arrow))
    fun _ _ hst => le_antisymm (le_of_map_le G hst.le) (le_of_map_le G hst.ge)

/-- Well-poweredness transfers along a fully faithful functor preserving monomorphisms. -/
theorem wellPowered_of_fullyFaithful [LocallySmall.{w} C] [WellPowered.{w} C]
    [LocallySmall.{w} D] : WellPowered.{w} D where
  subobject_small Y := small_subobject_of_fullyFaithful G Y

end Stacks.WellPoweredTransfer
