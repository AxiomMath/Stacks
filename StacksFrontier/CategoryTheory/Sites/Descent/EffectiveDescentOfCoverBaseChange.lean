module

public import StacksFrontier.CategoryTheory.Sites.Stack.CartesianSquareDescent
public import StacksFrontier.CategoryTheory.Sites.Descent.PrestackOfCover
public import StacksFrontier.CategoryTheory.Sites.Descent.OfRefinement
public import StacksFrontier.CategoryTheory.Sites.Descent.SingletonDescentBaseChange

/-!
# Effective descent along a morphism, tested after base change along a cover

Let `F` be a pseudofunctor from the locally discrete bicategory on `Cᵒᵖ` to `Cat`, where `C`
has fibre products, and let `f : X ⟶ Y` and `g : Z ⟶ Y` be morphisms. If descent along `g` is
effective, if `F` is a prestack for every pullback of the sieve generated by `g`, and if descent
is effective along the base changes `X ×_Y Z ⟶ Z` and `X ×_Y (Z ×_Y Z) ⟶ Z ×_Y Z` of `f`, then
descent along `f` is effective, provided morphisms out of an inverse image along the projection
`Z ×_Y Z ×_Y Z ⟶ Z ×_Y Z` are detected after base change to `X ×_Y (Z ×_Y Z ×_Y Z)`. This is the
formal part of [Stacks, Tag 0GF1].

## Main results

* `CategoryTheory.Pseudofunctor.isEquivalence_toDescentData_of_baseChange`: the criterion.
* `CategoryTheory.Pseudofunctor.eq_of_map_eq_of_isIso_mateEquiv`: morphisms out of an inverse
  image along `f` are detected after base change along `i` in a square `i ≫ f = f' ≫ g` whose
  base-change map `g^* f_* ⟶ f'_* i^*` is invertible, once `g^*` is faithful; this is how the
  detection hypothesis of the criterion is verified in practice.

## Implementation notes

Full faithfulness of the descent functor along `f` is
`CategoryTheory.Pseudofunctor.isPrestackFor_of_cover`. For essential surjectivity, a descent
datum `D` for `{f}` is restricted to `{X ×_Y Z ⟶ Z}` and descended there to an object `G` over
`Z`. Over `Z ×_Y Z` the two pullbacks of `G` are glued by the morphism `ψ` descended along
`X ×_Y (Z ×_Y Z) ⟶ Z ×_Y Z` from the comparisons of `G` with `D`; `ψ` is the identity along the
diagonal and satisfies the cocycle condition over `Z ×_Y Z ×_Y Z`. Together with `D` this is a
descent datum for the two-member family `{f, g}`
(`CategoryTheory.Pseudofunctor.CoverDescent.glued`), whose restriction to `{g}` is effective;
since restriction from `{f, g}` to `{g}` is fully faithful, the glued datum is effective, and
its component over `X` is the required object.

## References

* [Stacks Project, Tag 0GF1](https://stacks.math.columbia.edu/tag/0GF1)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe v' u' v u

namespace CategoryTheory.Pseudofunctor

open LocallyDiscreteOpToCat

variable {C : Type u} [Category.{v} C] [HasPullbacks C]
  {F : Pseudofunctor (LocallyDiscrete Cᵒᵖ) Cat.{v', u'}}

omit [HasPullbacks C] in
/-- The gluing morphisms of the canonical descent datum of an object. -/
lemma toDescentData_obj_hom {ι : Type*} {S : C} {Xi : ι → C} (fi : ∀ i, Xi i ⟶ S)
    (M : F.obj (.mk (op S))) {W : C} (q : W ⟶ S) {i₁ i₂ : ι} (f₁ : W ⟶ Xi i₁)
    (f₂ : W ⟶ Xi i₂) (hf₁ : f₁ ≫ fi i₁ = q) (hf₂ : f₂ ≫ fi i₂ = q) :
    ((F.toDescentData fi).obj M).hom q f₁ f₂ hf₁ hf₂ =
      (F.mapComp' (fi i₁).op.toLoc f₁.op.toLoc q.op.toLoc
          (by rw [← hf₁]; rfl)).inv.toNatTrans.app M ≫
        (F.mapComp' (fi i₂).op.toLoc f₂.op.toLoc q.op.toLoc
          (by rw [← hf₂]; rfl)).hom.toNatTrans.app M :=
  DescentData.ofObj_hom _ _ _ _ _ _ _ _ _

omit [HasPullbacks C] in
/-- **Morphisms out of an inverse image are detected after a base change with invertible
base-change map.** Let `i ≫ f = f' ≫ g` be a commutative square, let `f^*` and `f'^*` have
right adjoints, and suppose that the base-change map `g^* f_* N ⟶ f'_* i^* N` is invertible and
that `g^*` is faithful on morphisms `M ⟶ f_* N`. Then two morphisms `f^* M ⟶ N` with the same
inverse image along `i` are equal. -/
theorem eq_of_map_eq_of_isIso_mateEquiv {X₁ X₂ Y₁ Y₂ : C} {i : X₂ ⟶ X₁} {f' : X₂ ⟶ Y₂}
    {f : X₁ ⟶ Y₁} {g : Y₂ ⟶ Y₁} (w : i ≫ f = f' ≫ g)
    {R : F.obj (.mk (op X₁)) ⥤ F.obj (.mk (op Y₁))} (adj : (F.map f.op.toLoc).toFunctor ⊣ R)
    {R' : F.obj (.mk (op X₂)) ⥤ F.obj (.mk (op Y₂))} (adj' : (F.map f'.op.toLoc).toFunctor ⊣ R')
    {M : F.obj (.mk (op Y₁))} {N : F.obj (.mk (op X₁))}
    (hβ : IsIso ((mateEquiv adj adj' (commSqTwoSquare F w)).app N))
    (hg : ∀ a b : M ⟶ R.obj N, (F.map g.op.toLoc).toFunctor.map a =
      (F.map g.op.toLoc).toFunctor.map b → a = b)
    (u v : (F.map f.op.toLoc).toFunctor.obj M ⟶ N)
    (huv : (F.map i.op.toLoc).toFunctor.map u = (F.map i.op.toLoc).toFunctor.map v) :
    u = v := by
  have key : ∀ u' : (F.map f.op.toLoc).toFunctor.obj M ⟶ N,
      (F.map g.op.toLoc).toFunctor.map (adj.homEquiv _ _ u') ≫
          (mateEquiv adj adj' (commSqTwoSquare F w)).app N =
        adj'.unit.app _ ≫ R'.map ((commSqTwoSquare F w).app M ≫
          (F.map i.op.toLoc).toFunctor.map u') := by
    intro u'
    have h := (mateEquiv adj adj' (commSqTwoSquare F w)).naturality u'
    simp only [Functor.comp_map] at h
    rw [adj.homEquiv_unit, Functor.map_comp, Category.assoc, h,
      reassoc_of% (unit_mateEquiv adj adj' (commSqTwoSquare F w) M), Functor.map_comp]
  apply (adj.homEquiv _ _).injective
  apply hg
  rw [← cancel_mono ((mateEquiv adj adj' (commSqTwoSquare F w)).app N), key, key, huv]

namespace CoverDescent

variable {X Y Z : C} {f : X ⟶ Y} {g : Z ⟶ Y}

/-- The first projection `X ×_Y (Z ×_Y Z) ⟶ X ×_Y Z`, keeping the first factor of `Z ×_Y Z`. -/
abbrev a₁ (f : X ⟶ Y) (g : Z ⟶ Y) :
    pullback f (pullback.fst g g ≫ g) ⟶ pullback f g :=
  pullback.lift (pullback.fst _ _) (pullback.snd _ _ ≫ pullback.fst g g)
    (by rw [Category.assoc]; exact pullback.condition)

/-- The second projection `X ×_Y (Z ×_Y Z) ⟶ X ×_Y Z`, keeping the second factor of
`Z ×_Y Z`. -/
abbrev a₂ (f : X ⟶ Y) (g : Z ⟶ Y) :
    pullback f (pullback.fst g g ≫ g) ⟶ pullback f g :=
  pullback.lift (pullback.fst _ _) (pullback.snd _ _ ≫ pullback.snd g g)
    (by rw [Category.assoc, ← pullback.condition (f := g) (g := g)]; exact pullback.condition)

/-- Restriction of descent data for `{f}` to descent data for the base change
`{X ×_Y Z ⟶ Z}`. -/
abbrev restr (f : X ⟶ Y) (g : Z ⟶ Y) :
    F.DescentData (fun _ : Unit ↦ f) ⥤ F.DescentData (fun _ : Unit ↦ pullback.snd f g) :=
  DescentData.pullFunctor F (p := g) (α := fun _ ↦ ()) (p' := fun _ ↦ pullback.fst f g)
    (fun _ ↦ pullback.condition)

/-- The composite of `a₁` with the first projection is the first projection. -/
@[reassoc (attr := simp)]
lemma a₁_fst : a₁ f g ≫ pullback.fst f g = pullback.fst f (pullback.fst g g ≫ g) :=
  pullback.lift_fst _ _ _

/-- The composite of `a₁` with the second projection is the projection to the first factor of
`Z ×_Y Z`. -/
@[reassoc (attr := simp)]
lemma a₁_snd :
    a₁ f g ≫ pullback.snd f g = pullback.snd f (pullback.fst g g ≫ g) ≫ pullback.fst g g :=
  pullback.lift_snd _ _ _

/-- The composite of `a₂` with the first projection is the first projection. -/
@[reassoc (attr := simp)]
lemma a₂_fst : a₂ f g ≫ pullback.fst f g = pullback.fst f (pullback.fst g g ≫ g) :=
  pullback.lift_fst _ _ _

/-- The composite of `a₂` with the second projection is the projection to the second factor of
`Z ×_Y Z`. -/
@[reassoc (attr := simp)]
lemma a₂_snd :
    a₂ f g ≫ pullback.snd f g = pullback.snd f (pullback.fst g g ≫ g) ≫ pullback.snd g g :=
  pullback.lift_snd _ _ _

variable (D : F.DescentData (fun _ : Unit ↦ f))

/-- The gluing morphisms of the restriction of `D` to `{X ×_Y Z ⟶ Z}`, in terms of those of `D`. -/
lemma restr_hom {W : C} (q : W ⟶ Z) (c d : W ⟶ pullback f g)
    (hc : c ≫ pullback.snd f g = q) (hd : d ≫ pullback.snd f g = q)
    (x₁ x₂ : W ⟶ X) (h₁ : c ≫ pullback.fst f g = x₁) (h₂ : d ≫ pullback.fst f g = x₂) :
    ((restr (F := F) f g).obj D).hom q (i₁ := ()) (i₂ := ()) c d hc hd =
      (F.mapComp' (pullback.fst f g).op.toLoc c.op.toLoc x₁.op.toLoc
          (by rw [← h₁]; rfl)).inv.toNatTrans.app _ ≫
        D.hom (q ≫ g) x₁ x₂ (by rw [← h₁, ← hc, Category.assoc, Category.assoc,
          pullback.condition]) (by rw [← h₂, ← hd, Category.assoc, Category.assoc,
          pullback.condition]) ≫
        (F.mapComp' (pullback.fst f g).op.toLoc d.op.toLoc x₂.op.toLoc
          (by rw [← h₂]; rfl)).hom.toNatTrans.app _ := by
  exact DescentData.pullFunctorObjHom_eq (p := g) (α := fun _ ↦ ())
      (p' := fun _ ↦ pullback.fst f g) (fun _ : Unit ↦
      (pullback.condition : pullback.fst f g ≫ f = pullback.snd f g ≫ g)) D
      (c ≫ pullback.snd f g) (j₁ := ()) (j₂ := ()) c d (q ≫ g) x₁ x₂ rfl (hd.trans hc.symm)
      (by rw [hc]) h₁ h₂

variable {D}
variable {G : F.obj (.mk (op Z))}
  (e : (F.toDescentData (fun _ : Unit ↦ pullback.snd f g)).obj G ≅ (restr f g).obj D)

/-- The component over `X ×_Y Z` of the comparison of the descended object with the restricted
descent datum. -/
def eHom : (F.map (pullback.snd f g).op.toLoc).toFunctor.obj G ⟶
    (F.map (pullback.fst f g).op.toLoc).toFunctor.obj (D.obj ()) :=
  e.hom.hom ()

/-- The inverse of `eHom`. -/
def eInv : (F.map (pullback.fst f g).op.toLoc).toFunctor.obj (D.obj ()) ⟶
    (F.map (pullback.snd f g).op.toLoc).toFunctor.obj G :=
  e.inv.hom ()

/-- `eInv` is a right inverse of `eHom`. -/
@[reassoc (attr := simp)]
lemma eHom_eInv : eHom e ≫ eInv e = 𝟙 _ :=
  congrArg (fun φ ↦ DescentData.Hom.hom φ ()) e.hom_inv_id

/-- `eInv` is a left inverse of `eHom`. -/
@[reassoc (attr := simp)]
lemma eInv_eHom : eInv e ≫ eHom e = 𝟙 _ :=
  congrArg (fun φ ↦ DescentData.Hom.hom φ ()) e.inv_hom_id

/-- The compatibility of `eHom` with the two descent data, at two maps to `X ×_Y Z` over the same
map to `Z`. -/
lemma eHom_comm {W : C} (q : W ⟶ Z) (c d : W ⟶ pullback f g)
    (hc : c ≫ pullback.snd f g = q) (hd : d ≫ pullback.snd f g = q)
    (x₁ x₂ : W ⟶ X) (h₁ : c ≫ pullback.fst f g = x₁) (h₂ : d ≫ pullback.fst f g = x₂) :
    (F.map c.op.toLoc).toFunctor.map (eHom e) ≫
        (F.mapComp' (pullback.fst f g).op.toLoc c.op.toLoc x₁.op.toLoc
          (by rw [← h₁]; rfl)).inv.toNatTrans.app _ ≫
        D.hom (q ≫ g) x₁ x₂ (by rw [← h₁, ← hc, Category.assoc, Category.assoc,
          pullback.condition]) (by rw [← h₂, ← hd, Category.assoc, Category.assoc,
          pullback.condition]) ≫
        (F.mapComp' (pullback.fst f g).op.toLoc d.op.toLoc x₂.op.toLoc
          (by rw [← h₂]; rfl)).hom.toNatTrans.app _ =
      ((F.mapComp' (pullback.snd f g).op.toLoc c.op.toLoc q.op.toLoc
          (by rw [← hc]; rfl)).inv.toNatTrans.app G ≫
        (F.mapComp' (pullback.snd f g).op.toLoc d.op.toLoc q.op.toLoc
          (by rw [← hd]; rfl)).hom.toNatTrans.app G) ≫
        (F.map d.op.toLoc).toFunctor.map (eHom e) := by
  have h := e.hom.comm q (i₁ := ()) (i₂ := ()) c d hc hd
  rwa [restr_hom D q c d hc hd x₁ x₂ h₁ h₂, toDescentData_obj_hom] at h

/-- The comparison of the descended object with the descent datum, pulled back along two maps
to `X ×_Y Z` over the same map to `Z`, intertwines the descent datum. -/
lemma pullHom_eHom_comp_hom {W : C} (q : W ⟶ Z) (c d : W ⟶ pullback f g)
    (hc : c ≫ pullback.snd f g = q) (hd : d ≫ pullback.snd f g = q)
    (x₁ x₂ : W ⟶ X) (h₁ : c ≫ pullback.fst f g = x₁) (h₂ : d ≫ pullback.fst f g = x₂)
    (q' : W ⟶ Y) (hq : q ≫ g = q') :
    pullHom (eHom e) c q x₁ hc h₁ ≫
        D.hom q' x₁ x₂ (by rw [← h₁, ← hq, ← hc, Category.assoc, Category.assoc,
          pullback.condition]) (by rw [← h₂, ← hq, ← hd, Category.assoc, Category.assoc,
          pullback.condition]) =
      pullHom (eHom e) d q x₂ hd h₂ := by
  subst hq
  have h := eHom_comm e q c d hc hd x₁ x₂ h₁ h₂
  simp only [pullHom]
  rw [← cancel_mono ((F.mapComp' (pullback.fst f g).op.toLoc d.op.toLoc x₂.op.toLoc
    (by rw [← h₂]; rfl)).hom.toNatTrans.app _)]
  simp only [Category.assoc, Cat.Hom.inv_hom_id_toNatTrans_app]
  rw [h]
  simp

/-- `eInv` is inverse to `eHom` after any base change. -/
@[reassoc]
lemma pullHom_eInv_comp_pullHom_eHom {W : C} (c : W ⟶ pullback f g) (t : W ⟶ Z) (x : W ⟶ X)
    (hc : c ≫ pullback.snd f g = t) (hx : c ≫ pullback.fst f g = x) :
    pullHom (eInv e) c x t hx hc ≫ pullHom (eHom e) c t x hc hx = 𝟙 _ := by
  rw [pullHom_comp, eInv_eHom, pullHom_id_self]

/-- `eHom` is inverse to `eInv` after any base change. -/
@[reassoc]
lemma pullHom_eHom_comp_pullHom_eInv {W : C} (c : W ⟶ pullback f g) (t : W ⟶ Z) (x : W ⟶ X)
    (hc : c ≫ pullback.snd f g = t) (hx : c ≫ pullback.fst f g = x) :
    pullHom (eHom e) c t x hc hx ≫ pullHom (eInv e) c x t hx hc = 𝟙 _ := by
  rw [pullHom_comp, eHom_eInv, pullHom_id_self]

/-- The inverse comparison, pulled back along two maps to `X ×_Y Z` over the same map to `Z`,
intertwines the descent datum. -/
lemma hom_comp_pullHom_eInv {W : C} (q : W ⟶ Z) (c d : W ⟶ pullback f g)
    (hc : c ≫ pullback.snd f g = q) (hd : d ≫ pullback.snd f g = q)
    (x₁ x₂ : W ⟶ X) (h₁ : c ≫ pullback.fst f g = x₁) (h₂ : d ≫ pullback.fst f g = x₂)
    (q' : W ⟶ Y) (hq : q ≫ g = q') :
    D.hom q' x₁ x₂ (by rw [← h₁, ← hq, ← hc, Category.assoc, Category.assoc,
          pullback.condition]) (by rw [← h₂, ← hq, ← hd, Category.assoc, Category.assoc,
          pullback.condition]) ≫ pullHom (eInv e) d x₂ q h₂ hd =
      pullHom (eInv e) c x₁ q h₁ hc := by
  have : IsIso (pullHom (eHom e) c q x₁ hc h₁) :=
    ⟨_, pullHom_eHom_comp_pullHom_eInv e c q x₁ hc h₁,
      pullHom_eInv_comp_pullHom_eHom e c q x₁ hc h₁⟩
  rw [← cancel_epi (pullHom (eHom e) c q x₁ hc h₁),
    reassoc_of% (pullHom_eHom_comp_hom e q c d hc hd x₁ x₂ h₁ h₂ q' hq),
    pullHom_eHom_comp_pullHom_eInv, pullHom_eHom_comp_pullHom_eInv]

/-- The morphism over `X ×_Y (Z ×_Y Z)` from which the gluing isomorphism over `Z ×_Y Z` is
descended: the comparison along the first factor followed by the inverse comparison along the
second. -/
def sZZ : (F.map (pullback.snd f (pullback.fst g g ≫ g) ≫ pullback.fst g g).op.toLoc).toFunctor.obj
      G ⟶
    (F.map (pullback.snd f (pullback.fst g g ≫ g) ≫ pullback.snd g g).op.toLoc).toFunctor.obj G :=
  pullHom (eHom e) (a₁ f g) _ (pullback.fst f (pullback.fst g g ≫ g)) (pullback.lift_snd _ _ _)
      (pullback.lift_fst _ _ _) ≫
    pullHom (eInv e) (a₂ f g) (pullback.fst f (pullback.fst g g ≫ g)) _ (pullback.lift_fst _ _ _)
      (pullback.lift_snd _ _ _)

/-- The pullback of `sZZ` along a map to `X ×_Y (Z ×_Y Z)` is the pullback of `eHom` along its
composite with `a₁` followed by the pullback of `eInv` along its composite with `a₂`. -/
lemma pullHom_sZZ {W : C} (k : W ⟶ pullback f (pullback.fst g g ≫ g)) (t₁ t₂ : W ⟶ Z)
    (x : W ⟶ X) (c d : W ⟶ pullback f g)
    (ht₁ : k ≫ pullback.snd f (pullback.fst g g ≫ g) ≫ pullback.fst g g = t₁)
    (ht₂ : k ≫ pullback.snd f (pullback.fst g g ≫ g) ≫ pullback.snd g g = t₂)
    (hc : k ≫ a₁ f g = c) (hd : k ≫ a₂ f g = d)
    (hcz : c ≫ pullback.snd f g = t₁) (hcx : c ≫ pullback.fst f g = x)
    (hdz : d ≫ pullback.snd f g = t₂) (hdx : d ≫ pullback.fst f g = x) :
    pullHom (sZZ e) k t₁ t₂ ht₁ ht₂ =
      pullHom (eHom e) c t₁ x hcz hcx ≫ pullHom (eInv e) d x t₂ hdx hdz := by
  have hx : k ≫ pullback.fst f (pullback.fst g g ≫ g) = x := by
    rw [← hcx, ← hc, Category.assoc, pullback.lift_fst]
  rw [sZZ, ← pullHom_comp _ _ k t₁ x t₂ ht₁ hx ht₂, pullHom_pullHom, pullHom_pullHom]
  exact congrArg₂ (· ≫ ·) (pullHom_congr _ hc _ _ _ _ _ _) (pullHom_congr _ hd _ _ _ _ _ _)

variable (hZZ : (F.toDescentData (fun _ : Unit ↦
  pullback.snd f (pullback.fst g g ≫ g))).FullyFaithful)

include hZZ in
/-- `sZZ` is the pullback along `X ×_Y (Z ×_Y Z) ⟶ Z ×_Y Z` of a morphism over `Z ×_Y Z`. -/
lemma exists_pullHom_eq_sZZ :
    ∃ ψ : (F.map (pullback.fst g g).op.toLoc).toFunctor.obj G ⟶
        (F.map (pullback.snd g g).op.toLoc).toFunctor.obj G,
      pullHom ψ (pullback.snd f (pullback.fst g g ≫ g)) _ _ rfl rfl = sZZ e := by
  obtain ⟨ψ, hψ⟩ := exists_pullHom_eq_of_fullyFaithful
    (fun _ : Unit ↦ pullback.snd f (pullback.fst g g ≫ g)) hZZ G G
    (pullback.fst g g) (pullback.snd g g) (fun _ ↦ sZZ e) (by
      intro W q i j g₁ g₂ h₁ h₂
      have l : ∀ (g' : W ⟶ pullback f (pullback.fst g g ≫ g)) (a : _ ⟶ pullback f g)
          (p : pullback g g ⟶ Z),
          a ≫ pullback.snd f g = pullback.snd f (pullback.fst g g ≫ g) ≫ p →
          g' ≫ pullback.snd f (pullback.fst g g ≫ g) = q →
          (g' ≫ a) ≫ pullback.snd f g = q ≫ p := fun g' a p ha hg' ↦ by
        rw [Category.assoc, ha, ← Category.assoc, hg']
      have m : ∀ (g' : W ⟶ pullback f (pullback.fst g g ≫ g)) (a : _ ⟶ pullback f g),
          a ≫ pullback.fst f g = pullback.fst f (pullback.fst g g ≫ g) →
          (g' ≫ a) ≫ pullback.fst f g = g' ≫ pullback.fst f (pullback.fst g g ≫ g) :=
        fun g' a ha ↦ by rw [Category.assoc, ha]
      rw [pullHom_sZZ e g₁ _ _ _ _ _ _ _ rfl rfl (l _ _ _ a₁_snd h₁) (m g₁ _ a₁_fst)
          (l _ _ _ a₂_snd h₁) (m g₁ _ a₂_fst),
        pullHom_sZZ e g₂ _ _ _ _ _ _ _ rfl rfl (l _ _ _ a₁_snd h₂) (m g₂ _ a₁_fst)
          (l _ _ _ a₂_snd h₂) (m g₂ _ a₂_fst),
        ← pullHom_eHom_comp_hom e (q ≫ pullback.fst g g) (g₂ ≫ a₁ f g) (g₁ ≫ a₁ f g)
          (l _ _ _ a₁_snd h₂) (l _ _ _ a₁_snd h₁) _ _ (m g₂ _ a₁_fst) (m g₁ _ a₁_fst)
          (q ≫ pullback.fst g g ≫ g) (Category.assoc _ _ _),
        ← hom_comp_pullHom_eInv e (q ≫ pullback.snd g g) (g₁ ≫ a₂ f g) (g₂ ≫ a₂ f g)
          (l _ _ _ a₂_snd h₁) (l _ _ _ a₂_snd h₂) _ _ (m g₁ _ a₂_fst) (m g₂ _ a₂_fst)
          (q ≫ pullback.fst g g ≫ g) (by rw [Category.assoc, ← pullback.condition]),
        Category.assoc, D.hom_comp_assoc, D.hom_self, Category.id_comp]
      rw [← h₂, Category.assoc, Category.assoc, pullback.condition (f := f)])
  exact ⟨ψ, hψ ()⟩

/-- The gluing morphism over `Z ×_Y Z`. -/
def ψ : (F.map (pullback.fst g g).op.toLoc).toFunctor.obj G ⟶
    (F.map (pullback.snd g g).op.toLoc).toFunctor.obj G :=
  (exists_pullHom_eq_sZZ e hZZ).choose

/-- The pullback of `ψ` along `X ×_Y (Z ×_Y Z) ⟶ Z ×_Y Z` is `sZZ`. -/
lemma pullHom_ψ_fZZ :
    pullHom (ψ e hZZ) (pullback.snd f (pullback.fst g g ≫ g)) _ _ rfl rfl = sZZ e :=
  (exists_pullHom_eq_sZZ e hZZ).choose_spec

/-- The gluing morphism, pulled back along a map to `Z ×_Y Z` which lifts to
`X ×_Y (Z ×_Y Z)`. -/
lemma pullHom_ψ {W : C} (t : W ⟶ pullback g g) (k : W ⟶ pullback f (pullback.fst g g ≫ g))
    (hk : k ≫ pullback.snd f (pullback.fst g g ≫ g) = t) (t₁ t₂ : W ⟶ Z)
    (ht₁ : t ≫ pullback.fst g g = t₁) (ht₂ : t ≫ pullback.snd g g = t₂)
    (x : W ⟶ X) (c d : W ⟶ pullback f g) (hc : k ≫ a₁ f g = c) (hd : k ≫ a₂ f g = d)
    (hcz : c ≫ pullback.snd f g = t₁) (hcx : c ≫ pullback.fst f g = x)
    (hdz : d ≫ pullback.snd f g = t₂) (hdx : d ≫ pullback.fst f g = x) :
    pullHom (ψ e hZZ) t t₁ t₂ ht₁ ht₂ =
      pullHom (eHom e) c t₁ x hcz hcx ≫ pullHom (eInv e) d x t₂ hdx hdz := by
  subst hk
  rw [← pullHom_pullHom (ψ e hZZ) (pullback.snd f (pullback.fst g g ≫ g)) _ _ k t₁ t₂ rfl rfl
    (by rw [← Category.assoc, ht₁]) (by rw [← Category.assoc, ht₂]), pullHom_ψ_fZZ]
  exact pullHom_sZZ e k t₁ t₂ x c d _ _ hc hd hcz hcx hdz hdx

variable (hZ : (F.toDescentData (fun _ : Unit ↦ pullback.snd f g)).Faithful)

include hZ in
/-- The gluing morphism restricts to the identity along the diagonal of `Z ×_Y Z`. -/
lemma pullHom_ψ_diag :
    pullHom (ψ e hZZ) (pullback.lift (𝟙 Z) (𝟙 Z) rfl) (𝟙 Z) (𝟙 Z)
      (pullback.lift_fst _ _ _) (pullback.lift_snd _ _ _) = 𝟙 _ := by
  refine eq_of_pullHom_eq_of_faithful (fun _ : Unit ↦ pullback.snd f g) _ _ (fun _ ↦ ?_)
  rw [pullHom_pullHom, pullHom_id_self]
  let k : pullback f g ⟶ pullback f (pullback.fst g g ≫ g) :=
    pullback.lift (pullback.fst f g) (pullback.snd f g ≫ pullback.lift (𝟙 Z) (𝟙 Z) rfl)
      (by rw [Category.assoc, pullback.lift_fst_assoc, Category.id_comp, pullback.condition])
  have hk₁ : k ≫ pullback.fst f (pullback.fst g g ≫ g) = pullback.fst f g :=
    pullback.lift_fst _ _ _
  have hk₂ : k ≫ pullback.snd f (pullback.fst g g ≫ g) =
      pullback.snd f g ≫ pullback.lift (𝟙 Z) (𝟙 Z) rfl := pullback.lift_snd _ _ _
  have hk₃ : k ≫ a₁ f g = 𝟙 _ := pullback.hom_ext (by rw [Category.assoc, a₁_fst, hk₁,
    Category.id_comp]) (by rw [Category.assoc, a₁_snd, reassoc_of% hk₂, pullback.lift_fst,
    Category.comp_id, Category.id_comp])
  have hk₄ : k ≫ a₂ f g = 𝟙 _ := pullback.hom_ext (by rw [Category.assoc, a₂_fst, hk₁,
    Category.id_comp]) (by rw [Category.assoc, a₂_snd, reassoc_of% hk₂, pullback.lift_snd,
    Category.comp_id, Category.id_comp])
  rw [pullHom_ψ e hZZ _ k hk₂ (pullback.snd f g ≫ 𝟙 Z) (pullback.snd f g ≫ 𝟙 Z) _ _
    (pullback.fst f g) (𝟙 _) (𝟙 _) hk₃ hk₄ (by rw [Category.id_comp, Category.comp_id])
    (Category.id_comp _) (by rw [Category.id_comp, Category.comp_id]) (Category.id_comp _)]
  exact pullHom_eHom_comp_pullHom_eInv e _ _ _ _ _

section Cocycle

variable (g) in
/-- The map `Z ×_Y Z ×_Y Z ⟶ Z ×_Y Z` onto the first and third factors. -/
abbrev l₁₃ : pullback (pullback.fst g g ≫ g) g ⟶ pullback g g :=
  pullback.lift (pullback.fst _ _ ≫ pullback.fst g g) (pullback.snd _ _)
    (by rw [Category.assoc]; exact pullback.condition)

variable (g) in
/-- The map `Z ×_Y Z ×_Y Z ⟶ Z ×_Y Z` onto the second and third factors. -/
abbrev l₂₃ : pullback (pullback.fst g g ≫ g) g ⟶ pullback g g :=
  pullback.lift (pullback.fst _ _ ≫ pullback.snd g g) (pullback.snd _ _)
    (by rw [Category.assoc, ← pullback.condition (f := g) (g := g)]; exact pullback.condition)

/-- A lift to `X ×_Y (Z ×_Y Z)` of a map to `Z ×_Y Z` through `X ×_Y (Z ×_Y Z ×_Y Z)`. -/
abbrev liftZZ {W : C} (x : W ⟶ X) (t : W ⟶ pullback g g)
    (h : x ≫ f = t ≫ pullback.fst g g ≫ g) : W ⟶ pullback f (pullback.fst g g ≫ g) :=
  pullback.lift x t h

/-- A lift to `X ×_Y Z`. -/
abbrev liftZ {W : C} (x : W ⟶ X) (t : W ⟶ Z) (h : x ≫ f = t ≫ g) : W ⟶ pullback f g :=
  pullback.lift x t h

/-- The composite of `liftZZ x t h` with `a₁` is the lift of `x` and `t ≫ pullback.fst g g`. -/
lemma liftZZ_a₁ {W : C} (x : W ⟶ X) (t : W ⟶ pullback g g)
    (h : x ≫ f = t ≫ pullback.fst g g ≫ g) :
    liftZZ x t h ≫ a₁ f g = liftZ x (t ≫ pullback.fst g g) (by rw [h, Category.assoc]) :=
  pullback.hom_ext (by rw [Category.assoc, a₁_fst, pullback.lift_fst, pullback.lift_fst])
    (by rw [Category.assoc, a₁_snd, pullback.lift_snd_assoc, pullback.lift_snd])

/-- The composite of `liftZZ x t h` with `a₂` is the lift of `x` and `t ≫ pullback.snd g g`. -/
lemma liftZZ_a₂ {W : C} (x : W ⟶ X) (t : W ⟶ pullback g g)
    (h : x ≫ f = t ≫ pullback.fst g g ≫ g) :
    liftZZ x t h ≫ a₂ f g = liftZ x (t ≫ pullback.snd g g)
      (by rw [h, Category.assoc, pullback.condition]) :=
  pullback.hom_ext (by rw [Category.assoc, a₂_fst, pullback.lift_fst, pullback.lift_fst])
    (by rw [Category.assoc, a₂_snd, pullback.lift_snd_assoc, pullback.lift_snd])

/-- The gluing morphism, pulled back along a map to `Z ×_Y Z` given with a lift of its
composite to `Y` through `X`. -/
lemma pullHom_ψ_of_lift {W : C} (t : W ⟶ pullback g g) (x : W ⟶ X)
    (h : x ≫ f = t ≫ pullback.fst g g ≫ g) (t₁ t₂ : W ⟶ Z)
    (ht₁ : t ≫ pullback.fst g g = t₁) (ht₂ : t ≫ pullback.snd g g = t₂) :
    pullHom (ψ e hZZ) t t₁ t₂ ht₁ ht₂ =
      pullHom (eHom e) (liftZ x t₁ (by rw [h, ← ht₁, Category.assoc])) t₁ x
          (pullback.lift_snd _ _ _) (pullback.lift_fst _ _ _) ≫
        pullHom (eInv e) (liftZ x t₂ (by rw [h, ← ht₂, Category.assoc, pullback.condition]))
          x t₂ (pullback.lift_fst _ _ _) (pullback.lift_snd _ _ _) :=
  pullHom_ψ e hZZ t (liftZZ x t h) (pullback.lift_snd _ _ _) t₁ t₂ ht₁ ht₂ x _ _
    (by rw [liftZZ_a₁]; subst ht₁; rfl) (by rw [liftZZ_a₂]; subst ht₂; rfl) _ _ _ _

variable (hZZZ : ∀ (M : F.obj (.mk (op (pullback g g))))
  (N : F.obj (.mk (op (pullback (pullback.fst g g ≫ g) g))))
  (u v : (F.map (pullback.fst (pullback.fst g g ≫ g) g).op.toLoc).toFunctor.obj M ⟶ N),
  (F.map (pullback.snd f
    (pullback.fst (pullback.fst g g ≫ g) g ≫ pullback.fst g g ≫ g)).op.toLoc).toFunctor.map u =
  (F.map (pullback.snd f
    (pullback.fst (pullback.fst g g ≫ g) g ≫ pullback.fst g g ≫ g)).op.toLoc).toFunctor.map v →
  u = v)

include hZZZ in
/-- The cocycle condition of the gluing morphism over `Z ×_Y Z ×_Y Z`. -/
lemma ψ_cocycle :
    pullHom (ψ e hZZ) (pullback.fst (pullback.fst g g ≫ g) g) _ _ rfl rfl ≫
        pullHom (ψ e hZZ) (l₂₃ g) _ (pullback.snd _ _) (pullback.lift_fst _ _ _)
          (pullback.lift_snd _ _ _) =
      pullHom (ψ e hZZ) (l₁₃ g) _ (pullback.snd _ _) (pullback.lift_fst _ _ _)
          (pullback.lift_snd _ _ _) := by
  set r := pullback.fst (pullback.fst g g ≫ g) g
  set i := pullback.snd f (r ≫ pullback.fst g g ≫ g)
  set x := pullback.fst f (r ≫ pullback.fst g g ≫ g)
  have hx : x ≫ f = i ≫ r ≫ pullback.fst g g ≫ g := pullback.condition
  have H : pullHom (pullHom (ψ e hZZ) r _ _ rfl rfl ≫
        pullHom (ψ e hZZ) (l₂₃ g) _ (pullback.snd _ _) (pullback.lift_fst _ _ _)
          (pullback.lift_snd _ _ _)) i (i ≫ r ≫ pullback.fst g g) (i ≫ pullback.snd _ _)
          rfl rfl =
      pullHom (pullHom (ψ e hZZ) (l₁₃ g) _ (pullback.snd _ _) (pullback.lift_fst _ _ _)
          (pullback.lift_snd _ _ _)) i (i ≫ r ≫ pullback.fst g g) (i ≫ pullback.snd _ _)
          rfl rfl := by
    rw [← pullHom_comp _ _ i _ (i ≫ r ≫ pullback.snd g g) _ rfl rfl rfl,
      pullHom_pullHom, pullHom_pullHom, pullHom_pullHom,
      pullHom_ψ_of_lift e hZZ (i ≫ r) x (by rw [hx, Category.assoc]),
      pullHom_ψ_of_lift e hZZ (i ≫ l₂₃ g) x
        (by rw [hx, Category.assoc, pullback.lift_fst_assoc, Category.assoc,
          ← pullback.condition (f := g) (g := g)]),
      pullHom_ψ_of_lift e hZZ (i ≫ l₁₃ g) x
        (by rw [hx, Category.assoc, pullback.lift_fst_assoc, Category.assoc]),
      Category.assoc, pullHom_eInv_comp_pullHom_eHom_assoc]
  have hmap := map_eq_pullHom (pullHom (ψ e hZZ) r _ _ rfl rfl ≫
        pullHom (ψ e hZZ) (l₂₃ g) _ (pullback.snd _ _) (pullback.lift_fst _ _ _)
          (pullback.lift_snd _ _ _)) i (i ≫ r ≫ pullback.fst g g) (i ≫ pullback.snd _ _) rfl rfl
  rw [H, ← map_eq_pullHom] at hmap
  let c := (Cat.Hom.toNatIso (F.mapComp' (pullback.fst g g).op.toLoc r.op.toLoc
    (r ≫ pullback.fst g g).op.toLoc rfl)).app G
  rw [← cancel_epi c.inv]
  exact hZZZ _ _ _ _ (by
    rw [Functor.map_comp _ c.inv, Functor.map_comp _ c.inv]
    exact congrArg (_ ≫ ·) hmap)

variable (X Z) in
/-- The two sources of the family `{f, g}`. -/
abbrev famObj : Bool → C
  | true => X
  | false => Z

variable (f g) in
/-- The family `{f : X ⟶ Y, g : Z ⟶ Y}`. -/
abbrev fam : ∀ b, famObj X Z b ⟶ Y
  | true => f
  | false => g

variable (D G) in
/-- The objects of the glued descent datum. -/
abbrev tObj : ∀ b, F.obj (.mk (op (famObj X Z b)))
  | true => D.obj ()
  | false => G

/-- The gluing morphisms of the glued descent datum. -/
def tHom {T : C} (q : T ⟶ Y) : ∀ (b₁ b₂ : Bool) (t₁ : T ⟶ famObj X Z b₁)
    (t₂ : T ⟶ famObj X Z b₂), t₁ ≫ fam f g b₁ = q → t₂ ≫ fam f g b₂ = q →
    ((F.map t₁.op.toLoc).toFunctor.obj (tObj D G b₁) ⟶
      (F.map t₂.op.toLoc).toFunctor.obj (tObj D G b₂))
  | true, true, t₁, t₂, h₁, h₂ => D.hom q (i₁ := ()) (i₂ := ()) t₁ t₂ h₁ h₂
  | true, false, t₁, t₂, h₁, h₂ => pullHom (eInv e) (liftZ t₁ t₂ (h₁.trans h₂.symm)) t₁ t₂
      (pullback.lift_fst _ _ _) (pullback.lift_snd _ _ _)
  | false, true, t₁, t₂, h₁, h₂ => pullHom (eHom e) (liftZ t₂ t₁ (h₂.trans h₁.symm)) t₁ t₂
      (pullback.lift_snd _ _ _) (pullback.lift_fst _ _ _)
  | false, false, t₁, t₂, h₁, h₂ => pullHom (ψ e hZZ) (pullback.lift t₁ t₂ (h₁.trans h₂.symm))
      t₁ t₂ (pullback.lift_fst _ _ _) (pullback.lift_snd _ _ _)

/-- The gluing morphisms `tHom` are compatible with pullback. -/
lemma tHom_pullHom {T T' : C} (k : T' ⟶ T) (q : T ⟶ Y) (q' : T' ⟶ Y) (hq : k ≫ q = q')
    (b₁ b₂ : Bool) (t₁ : T ⟶ famObj X Z b₁) (t₂ : T ⟶ famObj X Z b₂)
    (h₁ : t₁ ≫ fam f g b₁ = q) (h₂ : t₂ ≫ fam f g b₂ = q)
    (kt₁ : T' ⟶ famObj X Z b₁) (kt₂ : T' ⟶ famObj X Z b₂)
    (hk₁ : k ≫ t₁ = kt₁) (hk₂ : k ≫ t₂ = kt₂) :
    pullHom (tHom e hZZ q b₁ b₂ t₁ t₂ h₁ h₂) k kt₁ kt₂ hk₁ hk₂ =
      tHom e hZZ q' b₁ b₂ kt₁ kt₂ (by rw [← hk₁, Category.assoc, h₁, hq])
        (by rw [← hk₂, Category.assoc, h₂, hq]) := by
  subst hk₁ hk₂ hq
  cases b₁ <;> cases b₂ <;> first
    | simp only [tHom]
      rw [pullHom_pullHom]
      exact pullHom_congr _ (pullback.hom_ext
        (by rw [Category.assoc, pullback.lift_fst, pullback.lift_fst])
        (by rw [Category.assoc, pullback.lift_snd, pullback.lift_snd])) _ _ _ _ _ _
    | exact D.pullHom_hom _ _ _ rfl (i₁ := ()) (i₂ := ()) _ _ h₁ h₂ _ _ rfl rfl

include hZ in
/-- The gluing morphism `tHom` of a map with itself is the identity. -/
lemma tHom_self {T : C} (q : T ⟶ Y) (b : Bool) (t : T ⟶ famObj X Z b)
    (h : t ≫ fam f g b = q) : tHom e hZZ q b b t t h h = 𝟙 _ := by
  cases b
  · simp only [tHom]
    rw [pullHom_congr _ (show pullback.lift t t (h.trans h.symm) =
        t ≫ pullback.lift (𝟙 Z) (𝟙 Z) rfl from pullback.hom_ext
          (by rw [pullback.lift_fst, Category.assoc, pullback.lift_fst, Category.comp_id])
          (by rw [pullback.lift_snd, Category.assoc, pullback.lift_snd, Category.comp_id]))
        _ _ _ _ (by rw [Category.assoc, pullback.lift_fst, Category.comp_id])
        (by rw [Category.assoc, pullback.lift_snd, Category.comp_id]),
      ← pullHom_pullHom (ψ e hZZ) (pullback.lift (𝟙 Z) (𝟙 Z) rfl) (𝟙 Z) (𝟙 Z) t t t
        (pullback.lift_fst _ _ _) (pullback.lift_snd _ _ _) (Category.comp_id _)
        (Category.comp_id _), pullHom_ψ_diag e hZZ hZ, pullHom_id_self]
  · exact D.hom_self _ (i := ()) _ h

include hZZZ in
/-- The cocycle condition of `ψ`, pulled back along any map to `Z ×_Y Z ×_Y Z`. -/
lemma ψ_cocycle_of_eq {T : C} (m : T ⟶ pullback (pullback.fst g g ≫ g) g)
    (t₁ t₂ t₃ : T ⟶ Z) (t₁₂ t₂₃ t₁₃ : T ⟶ pullback g g)
    (h₁₂ : m ≫ pullback.fst _ _ = t₁₂) (h₂₃ : m ≫ l₂₃ g = t₂₃) (h₁₃ : m ≫ l₁₃ g = t₁₃)
    (ht₁₂ : t₁₂ ≫ pullback.fst g g = t₁) (ht₂₁ : t₁₂ ≫ pullback.snd g g = t₂)
    (ht₂₃ : t₂₃ ≫ pullback.fst g g = t₂) (ht₃₂ : t₂₃ ≫ pullback.snd g g = t₃)
    (ht₁₃ : t₁₃ ≫ pullback.fst g g = t₁) (ht₃₁ : t₁₃ ≫ pullback.snd g g = t₃) :
    pullHom (ψ e hZZ) t₁₂ t₁ t₂ ht₁₂ ht₂₁ ≫ pullHom (ψ e hZZ) t₂₃ t₂ t₃ ht₂₃ ht₃₂ =
      pullHom (ψ e hZZ) t₁₃ t₁ t₃ ht₁₃ ht₃₁ := by
  subst h₁₂ h₂₃ h₁₃
  rw [← pullHom_pullHom (ψ e hZZ) (pullback.fst _ _) _ _ m t₁ t₂ rfl rfl
      (by rw [← Category.assoc, ht₁₂]) (by rw [← Category.assoc, ht₂₁]),
    ← pullHom_pullHom (ψ e hZZ) (l₂₃ g) _ _ m t₂ t₃ (pullback.lift_fst _ _ _)
      (pullback.lift_snd _ _ _) (by rw [← ht₂₃, Category.assoc, pullback.lift_fst])
      (by rw [← ht₃₂, Category.assoc, pullback.lift_snd]),
    ← pullHom_pullHom (ψ e hZZ) (l₁₃ g) _ _ m t₁ t₃ (pullback.lift_fst _ _ _)
      (pullback.lift_snd _ _ _) (by rw [← ht₁₃, Category.assoc, pullback.lift_fst])
      (by rw [← ht₃₁, Category.assoc, pullback.lift_snd]),
    pullHom_comp, ψ_cocycle e hZZ hZZZ]

include hZZZ in
/-- The gluing morphisms `tHom` satisfy the cocycle condition. -/
lemma tHom_comp {T : C} (q : T ⟶ Y) (b₁ b₂ b₃ : Bool) (t₁ : T ⟶ famObj X Z b₁)
    (t₂ : T ⟶ famObj X Z b₂) (t₃ : T ⟶ famObj X Z b₃) (h₁ : t₁ ≫ fam f g b₁ = q)
    (h₂ : t₂ ≫ fam f g b₂ = q) (h₃ : t₃ ≫ fam f g b₃ = q) :
    tHom e hZZ q b₁ b₂ t₁ t₂ h₁ h₂ ≫ tHom e hZZ q b₂ b₃ t₂ t₃ h₂ h₃ =
      tHom e hZZ q b₁ b₃ t₁ t₃ h₁ h₃ := by
  cases b₁ <;> cases b₂ <;> cases b₃ <;> simp only [tHom]
  · exact ψ_cocycle_of_eq e hZZ hZZZ
      (pullback.lift (pullback.lift t₁ t₂ (h₁.trans h₂.symm)) t₃
        (by rw [pullback.lift_fst_assoc, h₁, h₃])) t₁ t₂ t₃ _ _ _
      (pullback.lift_fst _ _ _)
      (pullback.hom_ext (by rw [Category.assoc, pullback.lift_fst, pullback.lift_fst,
        pullback.lift_fst_assoc, pullback.lift_snd])
        (by rw [Category.assoc, pullback.lift_snd, pullback.lift_snd, pullback.lift_snd]))
      (pullback.hom_ext (by rw [Category.assoc, pullback.lift_fst, pullback.lift_fst,
        pullback.lift_fst_assoc, pullback.lift_fst])
        (by rw [Category.assoc, pullback.lift_snd, pullback.lift_snd, pullback.lift_snd]))
      _ _ _ _ _ _
  · rw [pullHom_ψ_of_lift e hZZ _ t₃ (by rw [h₃, pullback.lift_fst_assoc, h₁]) t₁ t₂
      (pullback.lift_fst _ _ _) (pullback.lift_snd _ _ _), Category.assoc,
      pullHom_eInv_comp_pullHom_eHom, Category.comp_id]
  · rw [pullHom_ψ_of_lift e hZZ _ t₂ (by rw [h₂, pullback.lift_fst_assoc, h₁]) t₁ t₃
      (pullback.lift_fst _ _ _) (pullback.lift_snd _ _ _)]
  · exact pullHom_eHom_comp_hom e t₁ _ _ (pullback.lift_snd _ _ _) (pullback.lift_snd _ _ _)
      t₂ t₃ (pullback.lift_fst _ _ _) (pullback.lift_fst _ _ _) q h₁
  · rw [pullHom_ψ_of_lift e hZZ _ t₁ (by rw [h₁, pullback.lift_fst_assoc, h₂]) t₂ t₃
      (pullback.lift_fst _ _ _) (pullback.lift_snd _ _ _), pullHom_eInv_comp_pullHom_eHom_assoc]
  · rw [← pullHom_eHom_comp_hom e t₂ _ _ (pullback.lift_snd _ _ _) (pullback.lift_snd _ _ _)
      t₁ t₃ (pullback.lift_fst _ _ _) (pullback.lift_fst _ _ _) q h₂,
      pullHom_eInv_comp_pullHom_eHom_assoc]
    exact h₁.trans h₂.symm
  · exact hom_comp_pullHom_eInv e t₃ _ _ (pullback.lift_snd _ _ _) (pullback.lift_snd _ _ _)
      t₁ t₂ (pullback.lift_fst _ _ _) (pullback.lift_fst _ _ _) q h₃
  · exact D.hom_comp q (i₁ := ()) (i₂ := ()) (i₃ := ()) t₁ t₂ t₃ h₁ h₂ h₃

include hZ hZZZ in
/-- The descent datum for the family `{f, g}` glued from a descent datum for `{f}`. -/
def glued : F.DescentData (fam f g) where
  obj := tObj D G
  hom _ q b₁ b₂ t₁ t₂ h₁ h₂ := tHom e hZZ q b₁ b₂ t₁ t₂ h₁ h₂
  pullHom_hom _ _ k q q' hq b₁ b₂ t₁ t₂ h₁ h₂ kt₁ kt₂ hk₁ hk₂ :=
    tHom_pullHom e hZZ k q q' hq b₁ b₂ t₁ t₂ h₁ h₂ kt₁ kt₂ hk₁ hk₂
  hom_self _ q b t h := tHom_self e hZZ hZ q b t h
  hom_comp _ q b₁ b₂ b₃ t₁ t₂ t₃ h₁ h₂ h₃ := tHom_comp e hZZ hZZZ q b₁ b₂ b₃ t₁ t₂ t₃ h₁ h₂ h₃

end Cocycle

end CoverDescent

open CoverDescent in
/-- **Effective descent along `f`, tested after base change along `g`.** Let `F` be a
pseudofunctor from `LocallyDiscrete Cᵒᵖ` to `Cat`, `C` with fibre products, and let
`f : X ⟶ Y` and `g : Z ⟶ Y` be morphisms. Assume that descent along `g` is effective, that `F`
is a prestack for the pullback along any morphism of the sieve generated by `g`, that descent
along the base changes `X ×_Y Z ⟶ Z` and `X ×_Y (Z ×_Y Z) ⟶ Z ×_Y Z` of `f` is effective, and
that morphisms out of an inverse image along the projection `Z ×_Y Z ×_Y Z ⟶ Z ×_Y Z` are
determined by their inverse images along `X ×_Y (Z ×_Y Z ×_Y Z) ⟶ Z ×_Y Z ×_Y Z`. Then descent
along `f` is effective. -/
theorem isEquivalence_toDescentData_of_baseChange {X Y Z : C} (f : X ⟶ Y) (g : Z ⟶ Y)
    (hg : (F.toDescentData (fun _ : Unit ↦ g)).IsEquivalence)
    (hgT : ∀ ⦃T : C⦄ (t : T ⟶ Y),
      F.IsPrestackFor (Sieve.pullback t (Sieve.ofArrows _ (fun _ : Unit ↦ g))).arrows)
    (hZ : (F.toDescentData (fun _ : Unit ↦ pullback.snd f g)).IsEquivalence)
    (hZZ : (F.toDescentData (fun _ : Unit ↦
      pullback.snd f (pullback.fst g g ≫ g))).IsEquivalence)
    (hZZZ : ∀ (M : F.obj (.mk (op (pullback g g))))
      (N : F.obj (.mk (op (pullback (pullback.fst g g ≫ g) g))))
      (u v : (F.map (pullback.fst (pullback.fst g g ≫ g) g).op.toLoc).toFunctor.obj M ⟶ N),
      (F.map (pullback.snd f
        (pullback.fst (pullback.fst g g ≫ g) g ≫ pullback.fst g g ≫ g)).op.toLoc).toFunctor.map u =
      (F.map (pullback.snd f
        (pullback.fst (pullback.fst g g ≫ g) g ≫ pullback.fst g g ≫ g)).op.toLoc).toFunctor.map v →
      u = v) :
    (F.toDescentData (fun _ : Unit ↦ f)).IsEquivalence := by
  have hpre : F.IsPrestackFor (Sieve.ofArrows _ (fun _ : Unit ↦ f)).arrows :=
    isPrestackFor_of_cover F (fun _ : Unit ↦ g) (fun _ _ ↦ .ofHasPullback g g) _
      (isPrestackFor_of_equivalence F _ hg) (fun t ↦ hgT t)
      (fun _ ↦ isPrestackFor_pullback_of_equivalence F (fun _ : Unit ↦ f) g
        (fun _ ↦ pullback f g) (fun _ ↦ pullback.snd f g) (fun _ ↦ pullback.fst f g)
        (fun _ ↦ (IsPullback.of_hasPullback f g).flip) hZ)
      (fun _ _ ↦ isPrestackFor_pullback_of_equivalence F (fun _ : Unit ↦ f)
        (pullback.fst g g ≫ g) (fun _ ↦ pullback f (pullback.fst g g ≫ g))
        (fun _ ↦ pullback.snd _ _) (fun _ ↦ pullback.fst _ _)
        (fun _ ↦ (IsPullback.of_hasPullback _ _).flip) hZZ)
  obtain ⟨hff⟩ : Nonempty (F.toDescentData (fun _ : Unit ↦ f)).FullyFaithful := by
    rwa [Sieve.ofArrows, F.IsPrestackFor_generate_iff, F.isPrestackFor_ofArrows_iff] at hpre
  have := hff.full
  have := hff.faithful
  have : (F.toDescentData (fun _ : Unit ↦ f)).EssSurj := ⟨fun D ↦ by
    let e := (F.toDescentData (fun _ : Unit ↦ pullback.snd f g)).objObjPreimageIso
      ((restr f g).obj D)
    let hZZ' := Functor.FullyFaithful.ofFullyFaithful
      (F.toDescentData (fun _ : Unit ↦ pullback.snd f (pullback.fst g g ≫ g)))
    have hw : ∀ _ : Unit, 𝟙 Z ≫ fam f g false = g := fun _ ↦ Category.id_comp _
    obtain ⟨hΨ⟩ := DescentData.nonempty_fullyFaithful_pullFunctor (F := F) (f := fam f g)
      (f' := fun _ : Unit ↦ g) (α := fun _ ↦ false) (p' := fun _ ↦ 𝟙 Z) hw
      (fun _ _ i ↦ (F.isPrestackFor_iff_isSheafFor' _).1 (hgT (fam f g i)) _ _ _)
      (fun _ _ ↦ .ofHasPullback _ _)
      (fun _ _ i₁ i₂ ↦ ((F.isPrestackFor_iff_isSheafFor' _).1
        (hgT (ChosenPullback.ofHasPullback (fam f g i₁) (fam f g i₂)).p) _ _ _).isSeparatedFor)
    have w' := DescentData.w_comp_id (f := fam f g) (f' := fun _ : Unit ↦ g)
      (α := fun _ ↦ false) (p' := fun _ ↦ 𝟙 Z) hw
    let Ψ := DescentData.pullFunctor F (f := fam f g) (f' := fun _ : Unit ↦ g)
      (α := fun _ ↦ false) (p' := fun _ ↦ 𝟙 Z) (p := 𝟙 Y) w'
    let D' := glued e hZZ' inferInstance hZZZ
    let E := (F.toDescentData (fun _ : Unit ↦ g)).objPreimage (Ψ.obj D')
    let ι : F.toDescentData (fam f g) ⋙ Ψ ≅ F.toDescentData (fun _ : Unit ↦ g) :=
      DescentData.toDescentDataCompPullFunctorIso F w' ≪≫
        Functor.isoWhiskerRight (Cat.Hom.toNatIso (F.mapId _)) _ ≪≫ Functor.leftUnitor _
    let θ := hΨ.preimageIso (ι.app E ≪≫
      (F.toDescentData (fun _ : Unit ↦ g)).objObjPreimageIso (Ψ.obj D'))
    exact ⟨E, ⟨DescentData.isoMk (fun _ ↦
      { hom := θ.hom.hom true
        inv := θ.inv.hom true
        hom_inv_id := congrArg (fun φ ↦ DescentData.Hom.hom φ true) θ.hom_inv_id
        inv_hom_id := congrArg (fun φ ↦ DescentData.Hom.hom φ true) θ.inv_hom_id })
      (fun W q _ _ f₁ f₂ hf₁ hf₂ ↦ θ.hom.comm q (i₁ := true) (i₂ := true) f₁ f₂ hf₁ hf₂)⟩⟩⟩
  exact { }

end CategoryTheory.Pseudofunctor
