module

public import StacksFrontier.CategoryTheory.Sites.Descent.IsStack.MapIota

/-!
# Local closedness applied to a covering sieve

A covering sieve is generated by the family of all its arrows, so `LocallyClosed`, stated for
covering families, applies to covering sieves: an object of a fibre is isomorphic over the
identity to one of the subcategory as soon as all its chosen pullbacks along the sieve are.

## Main results

* `CategoryTheory.Functor.mem_of_generate_ofArrows_arrows`: the family of all arrows of a covering
  sieve generates a covering sieve.
* `CategoryTheory.Functor.isoOverId_pullbackFiber`: the chosen pullback `f^* x` is isomorphic over
  the identity to an object with property `P` when some such object maps cartesianly to `x`.
* `CategoryTheory.Functor.isoOverId_of_locallyClosed`: `LocallyClosed` applied to a covering
  sieve.
-/

@[expose] public section

namespace CategoryTheory

open Limits Opposite

universe v₁ v₂ u₁ u₂

namespace Functor

variable {𝒮 : Type u₁} [Category.{v₁} 𝒮] {𝒳 : Type u₂} [Category.{v₂} 𝒳]

/-- The sieve generated by the family of all arrows of a covering sieve `R` is covering. -/
theorem mem_of_generate_ofArrows_arrows (J : GrothendieckTopology 𝒮) {U : 𝒮} {R : Sieve U}
    (hR : R ∈ J U) :
    Sieve.generate (Presieve.ofArrows
      (fun (i : Σ V : 𝒮, {f : V ⟶ U // R.arrows f}) => i.1)
      (fun i => i.2.val)) ∈ J U := by
  have heq : (Presieve.ofArrows
      (fun (i : Σ V : 𝒮, {f : V ⟶ U // R.arrows f}) => i.1)
      (fun i => i.2.val)) = R.arrows := by
    funext V f
    exact propext ⟨fun ⟨i⟩ => i.2.property,
      fun hf => Presieve.ofArrows.mk (⟨V, f, hf⟩ : Σ V : 𝒮, {f : V ⟶ U // R.arrows f})⟩
  rwa [heq, Sieve.generate_sieve]

/-- If some object with property `P` admits a cartesian morphism to `x` over `f`, then the chosen
pullback `f^* x` is isomorphic over the identity to an object with property `P`. -/
theorem isoOverId_pullbackFiber (p : 𝒳 ⥤ 𝒮) (P : ObjectProperty 𝒳) [p.IsPreFibered]
    {V U : 𝒮} (x : p.Fiber U) (f : V ⟶ U) {a : 𝒳} (ζ : a ⟶ x.1)
    (hζ : p.IsCartesian f ζ) (hPa : P a) :
    IsoOverId p P (pullbackFiber p x f).1 := by
  have : p.IsCartesian f ζ := hζ
  have : p.IsCartesian f (IsPreFibered.pullbackMap x.2 f) :=
    IsPreFibered.pullbackMap.IsCartesian x.2 f
  refine ⟨a, hPa, IsCartesian.domainUniqueUpToIso p f ζ (IsPreFibered.pullbackMap x.2 f), ?_⟩
  rw [show p.obj (pullbackFiber p x f).1 = V from (pullbackFiber p x f).2]
  exact IsCartesian.domainUniqueUpToIso_inv_isHomLift p f ζ (IsPreFibered.pullbackMap x.2 f)

/-- If `P` is locally closed and every chosen pullback of `x` along a covering sieve `R` is
isomorphic over the identity to an object with property `P`, then so is `x`. -/
theorem isoOverId_of_locallyClosed (p : 𝒳 ⥤ 𝒮) [p.IsPreFibered]
    (P : ObjectProperty 𝒳) (J : GrothendieckTopology 𝒮)
    (h3 : LocallyClosed p P J) {U : 𝒮} {R : Sieve U} (hR : R ∈ J U) (x : p.Fiber U)
    (hpull : ∀ i : (Σ V : 𝒮, {f : V ⟶ U // R.arrows f}),
      IsoOverId p P (pullbackFiber p x i.2.val).1) :
    IsoOverId p P x.1 :=
  h3 (fun (i : Σ V : 𝒮, {f : V ⟶ U // R.arrows f}) => i.1)
    (fun (i : Σ V : 𝒮, {f : V ⟶ U // R.arrows f}) => i.2.val)
    (mem_of_generate_ofArrows_arrows J hR) x hpull

end Functor

end CategoryTheory
