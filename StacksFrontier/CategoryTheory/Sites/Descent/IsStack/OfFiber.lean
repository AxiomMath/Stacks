module

public import StacksFrontier.CategoryTheory.Sites.Descent.IsStack.SieveDescentDatum
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The descent datum of an object, and the content of the cocycle condition

The chosen pullbacks of a single object `x` of the fibre over `U`, glued by the canonical
comparisons `CategoryTheory.Functor.pullbackFiberComparison`, form a descent datum
(`CategoryTheory.Functor.SieveDescentDatum.ofFiber`, Mathlib's
`CategoryTheory.Pseudofunctor.DescentData.ofObj`), and it is effective. Composing these canonical
comparisons with the base change of an automorphism `α` of `x` instead gives a family of gluing
isomorphisms that satisfies the cocycle condition only when `α` is the identity.

## Main definitions

* `CategoryTheory.Functor.SieveDescentDatum.ofFiber`, the descent datum of an object of a fibre.

## Main results

* `CategoryTheory.Functor.SieveDescentDatum.ofFiber_isEffective`, that it is effective;
* `CategoryTheory.Functor.SieveDescentDatum.eq_id_of_cocycle_twist`, that the canonical
  comparisons twisted by an automorphism `α` satisfy the cocycle condition only when `α` is the
  identity.
-/

@[expose] public section

-- Needed throughout: the transfer lemmas below relate `p` and `P.ι ⋙ p`, and the instance
-- arguments of `IsHomLift` and `IsCartesian` are only found after unfolding the composite.
set_option backward.isDefEq.respectTransparency false

namespace CategoryTheory

open Limits Opposite

universe v₁ v₂ u₁ u₂

namespace Functor

variable {𝒮 : Type u₁} [Category.{v₁} 𝒮] {𝒳 : Type u₂} [Category.{v₂} 𝒳]

namespace SieveDescentDatum

variable {p : 𝒳 ⥤ 𝒮} [p.IsFibered] {U : 𝒮}

/-- The descent datum of an object `x` of the fibre over `U`: its chosen pullbacks, glued by the
canonical comparisons of their iterated chosen pullbacks. -/
@[stacks 026E "(1) and (2) are one construction, read at two sieves: the trivial descent datum
  `(X, id_X)` on `{𝟙 U}` is this datum at the sieve generated by `𝟙 U`, and the canonical descent
  datum `(f_i^* X, can)` on `{f_i : U_i → U}` is this datum at the sieve that family generates,
  with `can` the canonical comparison `CategoryTheory.Functor.pullbackFiberComparison`.",
  implicit_reducible, sga "3 IV 2.1" "canonical descent datum"]
noncomputable def ofFiber (x : p.Fiber U) (R : Sieve U) : SieveDescentDatum p R where
  obj {V} f _ := pullbackFiber p x f
  iso {V W Z} {f} _ {g} _ ε ε' heq := pullbackFiberComparison x ε ε' heq
  cocycle {V W X Z} {f} hf {g} hg {h} hh ε₁ ε₂ ε₃ h₁₂ h₂₃ h₁₃ := by
    have hc : p.IsCartesian (ε₁ ≫ f)
        (IsPreFibered.pullbackMap (pullbackFiber p x h).2 ε₃ ≫
          IsPreFibered.pullbackMap x.2 h) := by
      have : p.IsCartesian ε₃ (IsPreFibered.pullbackMap (pullbackFiber p x h).2 ε₃) :=
        IsPreFibered.pullbackMap.IsCartesian _ _
      have : p.IsCartesian h (IsPreFibered.pullbackMap x.2 h) :=
        IsPreFibered.pullbackMap.IsCartesian _ _
      rw [h₁₃]; infer_instance
    refine fiber_hom_ext_of_cartesian (ε₁ ≫ f) _ hc _ _ ?_
    simp [Functor.map_comp, Category.assoc, pullbackFiberComparison_hom_fac]
  iso_pullback {V W Z Z'} {f} hf {g} hg ε ε' heq γ := by
    have hc : p.IsCartesian ((γ ≫ ε) ≫ f)
        (IsPreFibered.pullbackMap (pullbackFiber p x g).2 (γ ≫ ε') ≫
          IsPreFibered.pullbackMap x.2 g) := by
      have : p.IsCartesian (γ ≫ ε')
          (IsPreFibered.pullbackMap (pullbackFiber p x g).2 (γ ≫ ε')) :=
        IsPreFibered.pullbackMap.IsCartesian _ _
      have : p.IsCartesian g (IsPreFibered.pullbackMap x.2 g) :=
        IsPreFibered.pullbackMap.IsCartesian _ _
      have h0 : p.IsCartesian ((γ ≫ ε') ≫ g)
          (IsPreFibered.pullbackMap (pullbackFiber p x g).2 (γ ≫ ε') ≫
            IsPreFibered.pullbackMap x.2 g) := inferInstance
      rwa [Category.assoc, ← heq, ← Category.assoc] at h0
    refine fiber_hom_ext_of_cartesian ((γ ≫ ε) ≫ f) _ hc _ _ ?_
    simp [Functor.map_comp, Category.assoc, pullbackFiberIso_hom,
      pullbackFiberCompIso_hom_fac_assoc, pullbackFiberCompIso_inv_fac_assoc,
      pullbackFiberComparison_hom_fac, pullbackFiberHom_fac_assoc]

/-- The family of gluing isomorphisms over the identity of `T` obtained by composing the canonical
comparisons of `CategoryTheory.Functor.SieveDescentDatum.ofFiber` with the base change of an
automorphism `α` of an object of the fibre satisfies the cocycle condition only when `α` is the
identity. -/
lemma eq_id_of_cocycle_twist {T : 𝒮} (x : p.Fiber T) (α : x ≅ x)
    (hcocycle : (pullbackFiberComparison x (f := 𝟙 T) (g := 𝟙 T) (𝟙 T) (𝟙 T) rfl ≪≫
          pullbackFiberIso (pullbackFiberIso α (𝟙 T)) (𝟙 T)).hom ≫
        (pullbackFiberComparison x (f := 𝟙 T) (g := 𝟙 T) (𝟙 T) (𝟙 T) rfl ≪≫
          pullbackFiberIso (pullbackFiberIso α (𝟙 T)) (𝟙 T)).hom =
      (pullbackFiberComparison x (f := 𝟙 T) (g := 𝟙 T) (𝟙 T) (𝟙 T) rfl ≪≫
          pullbackFiberIso (pullbackFiberIso α (𝟙 T)) (𝟙 T)).hom) :
    α.hom = 𝟙 x := by
  rw [Iso.trans_hom, pullbackFiberComparison_self, Category.id_comp] at hcocycle
  have key : ∀ {y : p.Fiber T} (β : y ≅ y), (pullbackFiberIso β (𝟙 T)).hom = 𝟙 _ →
      β.hom = 𝟙 y := fun {y} β h => by
    rw [pullbackFiberIso_hom, ← pullbackFiberHom_id (b := 𝟙 T) (y := y)] at h
    exact eq_of_pullbackFiberHom_eq _ _ (𝟙 T) h
  exact key α (key _ (eq_id_of_comp_self_eq _ hcocycle))

/-- The descent datum of an object is effective: the chosen cartesian lifts descend it to the
object it came from. -/
lemma ofFiber_isEffective (x : p.Fiber U) (R : Sieve U) : (ofFiber x R).IsEffective := by
  refine ⟨x, fun {V} f _ => IsPreFibered.pullbackMap x.2 f, fun {V} f _ => ?_, fun {V W Z} {f} hf
    {g} hg ε ε' heq => ?_⟩
  · exact IsPreFibered.pullbackMap.IsCartesian x.2 f
  · exact fiberIsoOfCartesian_hom_fac _ _ _ _ _

end SieveDescentDatum

end Functor

end CategoryTheory
