module

public import StacksFrontier.CategoryTheory.Sites.Descent.IsStack.Defs

/-!
# Descent of one object along one arrow

Let `p : 𝒳 ⥤ 𝒮` be a fibred category, let `q : U₀ ⟶ U` be an arrow of the base and let `ξ` be an
object of the fibre over `U₀`. A descent datum for `ξ` along `q` is classically a gluing
isomorphism between the two pullbacks of `ξ` to `U₀ ×_U U₀` satisfying the cocycle condition on
`U₀ ×_U U₀ ×_U U₀`. This file supplies the same thing in the indexing that
`CategoryTheory.Functor.SieveDescentDatum` uses, where no fibre product of the base is assumed to
exist: a **gluing system** is a family of isomorphisms

`θ ε ε' : ε^* ξ ≅ ε'^* ξ`

between the chosen pullbacks, one for each pair of arrows `ε, ε' : Z ⟶ U₀` which agree after `q`,
required to compose (`hθtrans`) and to be compatible with base change (`hθpull`). Over a base with
fibre products the data of a gluing system and the data of one isomorphism over `U₀ ×_U U₀` agree,
because such a pair `(ε, ε')` factors uniquely through `U₀ ×_U U₀`; nothing below uses that.

`CategoryTheory.Functor.SieveDescentDatum.ofSingletonGluing` turns a gluing system into a descent
datum relative to any sieve each of whose arrows factors through `q`, the factorization being
supplied as data. When `p` is a stack the datum is effective, and
`CategoryTheory.Functor.exists_iso_pullbackFiber_of_gluing` reads the resulting object back as what
the gluing system is *for*: an object `x` of the fibre over `U` whose pullback along `q` is `ξ`.

The gluing system attached to an object of the fibre over `U` — pull it back to `U₀` and take the
canonical comparisons — recovers `CategoryTheory.Functor.SieveDescentDatum.ofFiber`; the content of
the two conditions is exactly what
`CategoryTheory.Functor.SieveDescentDatum.eq_id_of_cocycle_twist` records about that datum.

## Main definitions

* `CategoryTheory.Functor.SieveDescentDatum.ofSingletonGluing`: the descent datum of a gluing
  system along one arrow.

## Main results

* `CategoryTheory.Functor.exists_iso_pullbackFiber_of_gluing`: a gluing system along `q` for a
  covering sieve whose arrows factor through `q` descends `ξ` to the fibre over `U`;
* `CategoryTheory.Functor.exists_iso_pullbackFiber_of_gluing_generate`: the same for the sieve
  generated by `q` alone, whose factorizations are produced by choice.

## Implementation notes

The objects of the datum are the chosen pullbacks `ε₀ f ^* ξ` along the given factorizations, so
the gluing isomorphism between two of them is the gluing isomorphism of the system conjugated by
the contractions `CategoryTheory.Functor.pullbackFiberCompIso` of the iterated chosen pullbacks.
Both conditions of the datum then reduce to the corresponding condition on the system: the cocycle
condition because the middle contractions cancel, and compatibility with base change by the
pentagon `CategoryTheory.Functor.pullbackFiberCompIso_pentagon`, which is the only place the
bracketing of a threefold composite of base morphisms enters. That bracketing is why `hθpull` is
restated as `CategoryTheory.Functor.gluingSystem_pullback'` with the two composites named, in the
style of `CategoryTheory.Functor.pullbackFiberCompIso'`: the two contractions of a threefold chosen
pullback land over the two bracketings, which are equal morphisms but not the same term.

Reading the descended object back off effectivity uses no property of the chosen factorization of
`q` through itself: whatever `ε₀ q` is, the cartesian morphism effectivity supplies over `q`
identifies `ε₀ q ^* ξ` with `q^* x`, and the gluing system identifies it with `𝟙 U₀ ^* ξ`, which is
`ξ` by `CategoryTheory.Functor.pullbackFiberIdIso`.

## References

* [Stacks Project, Tag 026B](https://stacks.math.columbia.edu/tag/026B)
* [Stacks Project, Tag 026F](https://stacks.math.columbia.edu/tag/026F)
-/

@[expose] public section

namespace CategoryTheory

open Limits Opposite

universe v₁ v₂ u₁ u₂

namespace Functor

variable {𝒮 : Type u₁} [Category.{v₁} 𝒮] {𝒳 : Type u₂} [Category.{v₂} 𝒳]

/-- One half of a commuting square of isomorphisms, solved for the inverse of its left edge.

Stated for an abstract category because the terms it is used on have base morphisms of the
ambient site as indices: a rewrite by associativity in the composite proof below would try to
re-bracket one of those indices, on which the type of a gluing isomorphism depends. -/
private lemma inv_comp_eq_hom_comp_inv {𝒞 : Type u₁} [Category.{v₁} 𝒞] {W X Y V : 𝒞}
    (d : W ≅ X) (c : W ⟶ Y) (e : Y ≅ V) (f : X ≅ V) (h : c ≫ e.hom = d.hom ≫ f.hom) :
    d.inv ≫ c = f.hom ≫ e.inv := by
  rw [Iso.inv_comp_eq, ← Category.assoc, ← h, Category.assoc, Iso.hom_inv_id,
    Category.comp_id]

/-- The other half of the same square, solved for the left edge's inverse composed with the
square's upper edge; `hc` is the retraction of `c` that base change along a morphism supplies for
the inverse of an isomorphism of a fibre. -/
private lemma comp_hom_eq_hom_comp_inv {𝒞 : Type u₁} [Category.{v₁} 𝒞] {W X Y V : 𝒞}
    (d : W ≅ X) (c : W ⟶ Y) (c' : Y ⟶ W) (e : Y ≅ V) (f : X ≅ V)
    (h : c ≫ e.hom = d.hom ≫ f.hom) (hc : c' ≫ c = 𝟙 Y) :
    c' ≫ d.hom = e.hom ≫ f.inv := by
  rw [show d.hom = (c ≫ e.hom) ≫ f.inv by rw [h, Category.assoc, Iso.hom_inv_id,
      Category.comp_id], Category.assoc, ← Category.assoc c' c, hc, Category.id_comp]

/-- The base-change condition on a gluing system, with the two composites of base morphisms given
names rather than written out.

This is the form in which the condition is consumed: the pentagon for the contractions of a
threefold chosen pullback produces the contraction over `(γ ≫ ε) ≫ ε₀ f`, while the condition as
stated speaks of `γ ≫ (ε ≫ ε₀ f)`. -/
theorem gluingSystem_pullback' {p : 𝒳 ⥤ 𝒮} [p.IsFibered] {U U₀ : 𝒮} (q : U₀ ⟶ U)
    (ξ : p.Fiber U₀)
    (θ : ∀ ⦃Z : 𝒮⦄ (ε ε' : Z ⟶ U₀), ε ≫ q = ε' ≫ q →
      (pullbackFiber p ξ ε ≅ pullbackFiber p ξ ε'))
    (hθpull : ∀ ⦃Z Z' : 𝒮⦄ (ε ε' : Z ⟶ U₀) (h : ε ≫ q = ε' ≫ q) (γ : Z' ⟶ Z),
      (pullbackFiberCompIso ξ ε γ).inv ≫ pullbackFiberHom (θ ε ε' h).hom γ ≫
          (pullbackFiberCompIso ξ ε' γ).hom =
        (θ (γ ≫ ε) (γ ≫ ε') (by rw [Category.assoc, Category.assoc, h])).hom)
    ⦃Z Z' : 𝒮⦄ (ε ε' : Z ⟶ U₀) (h : ε ≫ q = ε' ≫ q) (γ : Z' ⟶ Z) (δ δ' : Z' ⟶ U₀)
    (hδ : γ ≫ ε = δ) (hδ' : γ ≫ ε' = δ') (h' : δ ≫ q = δ' ≫ q) :
    (pullbackFiberCompIso' ξ ε γ δ hδ).inv ≫ pullbackFiberHom (θ ε ε' h).hom γ ≫
        (pullbackFiberCompIso' ξ ε' γ δ' hδ').hom = (θ δ δ' h').hom := by
  subst hδ
  subst hδ'
  exact hθpull ε ε' h γ

namespace SieveDescentDatum

/-- **The descent datum of a gluing system along one arrow.** Let `q : U₀ ⟶ U`, let `ξ` be an
object of the fibre over `U₀`, let `R` be a sieve on `U` together with a factorization `ε₀ f` of
each of its arrows through `q`, and let `θ` be a gluing system for `ξ` along `q`. The chosen
pullbacks `ε₀ f ^* ξ`, glued by `θ` conjugated by the contractions of the iterated chosen
pullbacks, form a descent datum relative to `R`.

For `U₀ = U`, `q = 𝟙 U` and `θ` the canonical comparisons this is
`CategoryTheory.Functor.SieveDescentDatum.ofFiber`. -/
noncomputable def ofSingletonGluing {p : 𝒳 ⥤ 𝒮} [p.IsFibered] {U U₀ : 𝒮} (q : U₀ ⟶ U)
    (R : Sieve U) (ε₀ : ∀ ⦃V : 𝒮⦄ (f : V ⟶ U), R f → (V ⟶ U₀))
    (hε₀ : ∀ ⦃V : 𝒮⦄ (f : V ⟶ U) (hf : R f), ε₀ f hf ≫ q = f)
    (ξ : p.Fiber U₀)
    (θ : ∀ ⦃Z : 𝒮⦄ (ε ε' : Z ⟶ U₀), ε ≫ q = ε' ≫ q →
      (pullbackFiber p ξ ε ≅ pullbackFiber p ξ ε'))
    (hθtrans : ∀ ⦃Z : 𝒮⦄ (ε₁ ε₂ ε₃ : Z ⟶ U₀) (h₁₂ : ε₁ ≫ q = ε₂ ≫ q)
      (h₂₃ : ε₂ ≫ q = ε₃ ≫ q) (h₁₃ : ε₁ ≫ q = ε₃ ≫ q),
      (θ ε₁ ε₂ h₁₂).hom ≫ (θ ε₂ ε₃ h₂₃).hom = (θ ε₁ ε₃ h₁₃).hom)
    (hθpull : ∀ ⦃Z Z' : 𝒮⦄ (ε ε' : Z ⟶ U₀) (h : ε ≫ q = ε' ≫ q) (γ : Z' ⟶ Z),
      (pullbackFiberCompIso ξ ε γ).inv ≫ pullbackFiberHom (θ ε ε' h).hom γ ≫
          (pullbackFiberCompIso ξ ε' γ).hom =
        (θ (γ ≫ ε) (γ ≫ ε') (by rw [Category.assoc, Category.assoc, h])).hom) :
    SieveDescentDatum p R where
  obj _ f hf := pullbackFiber p ξ (ε₀ f hf)
  iso {_ _ _} {f} hf {g} hg ε ε' heq :=
    pullbackFiberCompIso ξ (ε₀ f hf) ε ≪≫
      θ (ε ≫ ε₀ f hf) (ε' ≫ ε₀ g hg)
        (by rw [Category.assoc, Category.assoc, hε₀ f hf, hε₀ g hg, heq]) ≪≫
      (pullbackFiberCompIso ξ (ε₀ g hg) ε').symm
  cocycle {_ _ _ _} {f} hf {g} hg {h} hh ε₁ ε₂ ε₃ h₁₂ h₂₃ h₁₃ := by
    have key := hθtrans (ε₁ ≫ ε₀ f hf) (ε₂ ≫ ε₀ g hg) (ε₃ ≫ ε₀ h hh)
      (by rw [Category.assoc, Category.assoc, hε₀ f hf, hε₀ g hg, h₁₂])
      (by rw [Category.assoc, Category.assoc, hε₀ g hg, hε₀ h hh, h₂₃])
      (by rw [Category.assoc, Category.assoc, hε₀ f hf, hε₀ h hh, h₁₃])
    simp only [Iso.trans_hom, Iso.symm_hom, Category.assoc, Iso.inv_hom_id_assoc]
    rw [reassoc_of% key]
  iso_pullback {_ _ _ _} {f} hf {g} hg ε ε' heq γ := by
    have hpa := pullbackFiberCompIso_pentagon ξ (ε₀ f hf) ε γ
    have hpb := pullbackFiberCompIso_pentagon ξ (ε₀ g hg) ε' γ
    have hleft := inv_comp_eq_hom_comp_inv
      (pullbackFiberCompIso (pullbackFiber p ξ (ε₀ f hf)) ε γ)
      (pullbackFiberHom (pullbackFiberCompIso ξ (ε₀ f hf) ε).hom γ)
      (pullbackFiberCompIso' ξ (ε ≫ ε₀ f hf) γ ((γ ≫ ε) ≫ ε₀ f hf)
        (Category.assoc _ _ _).symm)
      (pullbackFiberCompIso ξ (ε₀ f hf) (γ ≫ ε)) hpa
    have hright := comp_hom_eq_hom_comp_inv
      (pullbackFiberCompIso (pullbackFiber p ξ (ε₀ g hg)) ε' γ)
      (pullbackFiberHom (pullbackFiberCompIso ξ (ε₀ g hg) ε').hom γ)
      (pullbackFiberHom (pullbackFiberCompIso ξ (ε₀ g hg) ε').inv γ)
      (pullbackFiberCompIso' ξ (ε' ≫ ε₀ g hg) γ ((γ ≫ ε') ≫ ε₀ g hg)
        (Category.assoc _ _ _).symm)
      (pullbackFiberCompIso ξ (ε₀ g hg) (γ ≫ ε')) hpb
      (pullbackFiberHom_inv_hom_id (pullbackFiberCompIso ξ (ε₀ g hg) ε') γ)
    have hmid := gluingSystem_pullback' q ξ θ hθpull (ε ≫ ε₀ f hf) (ε' ≫ ε₀ g hg)
      (by rw [Category.assoc, Category.assoc, hε₀ f hf, hε₀ g hg, heq]) γ
      ((γ ≫ ε) ≫ ε₀ f hf) ((γ ≫ ε') ≫ ε₀ g hg) (Category.assoc _ _ _).symm
      (Category.assoc _ _ _).symm
      (by simp only [Category.assoc, hε₀ f hf, hε₀ g hg, heq])
    simp only [Iso.trans_hom, Iso.symm_hom, pullbackFiberIso_hom, Category.assoc,
      pullbackFiberHom_comp]
    rw [reassoc_of% hleft, hright, reassoc_of% hmid]

end SieveDescentDatum

/-- **A gluing system along `q` for a covering sieve descends its object.** Let `p` be a stack
over `(𝒮, J)`, let `q : U₀ ⟶ U`, let `R` be a covering sieve of `U` each of whose arrows is given a
factorization through `q`, and let `θ` be a gluing system for the object `ξ` of the fibre over `U₀`
along `q`. Then `ξ` is the pullback along `q` of an object of the fibre over `U`. -/
theorem exists_iso_pullbackFiber_of_gluing {p : 𝒳 ⥤ 𝒮} {J : GrothendieckTopology 𝒮}
    (hp : p.IsStack J) {U U₀ : 𝒮} (q : U₀ ⟶ U) (R : Sieve U) (hRJ : R ∈ J U) (hRq : R q)
    (ε₀ : ∀ ⦃V : 𝒮⦄ (f : V ⟶ U), R f → (V ⟶ U₀))
    (hε₀ : ∀ ⦃V : 𝒮⦄ (f : V ⟶ U) (hf : R f), ε₀ f hf ≫ q = f)
    (ξ : p.Fiber U₀)
    (θ : ∀ ⦃Z : 𝒮⦄ (ε ε' : Z ⟶ U₀), ε ≫ q = ε' ≫ q →
      haveI := hp.isFibered
      (pullbackFiber p ξ ε ≅ pullbackFiber p ξ ε'))
    (hθtrans : haveI := hp.isFibered
      ∀ ⦃Z : 𝒮⦄ (ε₁ ε₂ ε₃ : Z ⟶ U₀) (h₁₂ : ε₁ ≫ q = ε₂ ≫ q)
        (h₂₃ : ε₂ ≫ q = ε₃ ≫ q) (h₁₃ : ε₁ ≫ q = ε₃ ≫ q),
        (θ ε₁ ε₂ h₁₂).hom ≫ (θ ε₂ ε₃ h₂₃).hom = (θ ε₁ ε₃ h₁₃).hom)
    (hθpull : haveI := hp.isFibered
      ∀ ⦃Z Z' : 𝒮⦄ (ε ε' : Z ⟶ U₀) (h : ε ≫ q = ε' ≫ q) (γ : Z' ⟶ Z),
        (pullbackFiberCompIso ξ ε γ).inv ≫ pullbackFiberHom (θ ε ε' h).hom γ ≫
            (pullbackFiberCompIso ξ ε' γ).hom =
          (θ (γ ≫ ε) (γ ≫ ε') (by rw [Category.assoc, Category.assoc, h])).hom) :
    haveI := hp.isFibered
    ∃ x : p.Fiber U, Nonempty (ξ ≅ pullbackFiber p x q) := by
  have := hp.isFibered
  obtain ⟨x, ζ, hζ, -⟩ := hp.hasEffectiveDescent R hRJ
    (SieveDescentDatum.ofSingletonGluing q R ε₀ hε₀ ξ θ hθtrans hθpull)
  refine ⟨x, ⟨(pullbackFiberIdIso ξ).symm ≪≫
    θ (𝟙 U₀) (ε₀ q hRq) (by rw [Category.id_comp, hε₀ q hRq]) ≪≫
    fiberIsoOfCartesian q (ζ q hRq) (IsPreFibered.pullbackMap x.2 q) (hζ q hRq)
      (IsPreFibered.pullbackMap.IsCartesian x.2 q)⟩⟩

/-- Every arrow of the sieve generated by a single arrow `q` factors through `q`. -/
theorem exists_fac_of_generate_singleton {U U₀ V : 𝒮} (q : U₀ ⟶ U) (f : V ⟶ U)
    (hf : Sieve.generate (Presieve.singleton q) f) : ∃ ε : V ⟶ U₀, ε ≫ q = f := by
  obtain ⟨_, h, g, hg, hcomp⟩ := hf
  cases hg
  exact ⟨h, hcomp⟩

/-- **`CategoryTheory.Functor.exists_iso_pullbackFiber_of_gluing` for the sieve generated by `q`
alone.** The factorization of an arbitrary arrow of that sieve through `q` is not unique, and is
produced by choice; nothing in the conclusion depends on it. -/
theorem exists_iso_pullbackFiber_of_gluing_generate {p : 𝒳 ⥤ 𝒮} {J : GrothendieckTopology 𝒮}
    (hp : p.IsStack J) {U U₀ : 𝒮} (q : U₀ ⟶ U)
    (hq : Sieve.generate (Presieve.singleton q) ∈ J U) (ξ : p.Fiber U₀)
    (θ : ∀ ⦃Z : 𝒮⦄ (ε ε' : Z ⟶ U₀), ε ≫ q = ε' ≫ q →
      haveI := hp.isFibered
      (pullbackFiber p ξ ε ≅ pullbackFiber p ξ ε'))
    (hθtrans : haveI := hp.isFibered
      ∀ ⦃Z : 𝒮⦄ (ε₁ ε₂ ε₃ : Z ⟶ U₀) (h₁₂ : ε₁ ≫ q = ε₂ ≫ q)
        (h₂₃ : ε₂ ≫ q = ε₃ ≫ q) (h₁₃ : ε₁ ≫ q = ε₃ ≫ q),
        (θ ε₁ ε₂ h₁₂).hom ≫ (θ ε₂ ε₃ h₂₃).hom = (θ ε₁ ε₃ h₁₃).hom)
    (hθpull : haveI := hp.isFibered
      ∀ ⦃Z Z' : 𝒮⦄ (ε ε' : Z ⟶ U₀) (h : ε ≫ q = ε' ≫ q) (γ : Z' ⟶ Z),
        (pullbackFiberCompIso ξ ε γ).inv ≫ pullbackFiberHom (θ ε ε' h).hom γ ≫
            (pullbackFiberCompIso ξ ε' γ).hom =
          (θ (γ ≫ ε) (γ ≫ ε') (by rw [Category.assoc, Category.assoc, h])).hom) :
    haveI := hp.isFibered
    ∃ x : p.Fiber U, Nonempty (ξ ≅ pullbackFiber p x q) := by
  classical
  have := hp.isFibered
  exact exists_iso_pullbackFiber_of_gluing hp q (Sieve.generate (Presieve.singleton q)) hq
    ⟨U₀, 𝟙 U₀, q, Presieve.singleton.mk, Category.id_comp q⟩
    (fun _ f hf => Classical.choose (exists_fac_of_generate_singleton q f hf))
    (fun _ f hf => Classical.choose_spec (exists_fac_of_generate_singleton q f hf))
    ξ θ hθtrans hθpull

end Functor

end CategoryTheory

end
