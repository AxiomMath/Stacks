module

public import StacksFrontier.CategoryTheory.Sites.Descent.SubPseudofunctorDescentData
public import Mathlib.CategoryTheory.ObjectProperty.Equivalence

/-!
# Effective descent passes to a sub-pseudofunctor whose property is local for the family

Let `F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat` be a pseudofunctor, let `P : F.ObjectProperty` be a property
of objects preserved by the functors `F.map`
(`CategoryTheory.Pseudofunctor.ObjectProperty.IsClosedUnderMapObj`) and closed under isomorphism,
and let `f i : X i ⟶ S` be a family of morphisms.  If `F` has effective descent along `f` and if
`P` can be *detected* on the family — an object of `F.obj S` all of whose pullbacks along the
`f i` satisfy `P` itself satisfies `P` — then the sub-pseudofunctor
`CategoryTheory.Pseudofunctor.ObjectProperty.fullsubcategory` has effective descent along `f`
as well.

## Main results

* `Stacks.Descent.isEquivalence_toDescentData_fullsubcategory`: the canonical descent functor of
  the sub-pseudofunctor is an equivalence of categories as soon as that of `F` is and `P` is
  detected on the family.
* `Stacks.Descent.isStackFor_fullsubcategory`: the same statement phrased with
  `CategoryTheory.Pseudofunctor.IsStackFor` for the presieve generated by the family.

## Implementation notes

The whole argument is a change of category along the isomorphism of
`StacksFrontier.CategoryTheory.Sites.Descent.SubPseudofunctorDescentData`: composing the canonical
descent functor of `P.fullsubcategory` with `Stacks.Descent.subDescentDataFunctor` gives, by
`Stacks.Descent.toDescentData_comp_subDescentDataFunctor`, the lift of
`ι ⋙ F.toDescentData f` to the descent data all of whose components satisfy `P`.  Mathlib's
`CategoryTheory.Equivalence.congrFullSubcategory` says exactly that such a lift of an equivalence
is an equivalence, provided the property on the target is the inverse image of the one on the
source and is closed under isomorphism; the two inclusions of that equality are the hypothesis
`hP` and the closure of `P` under the functors `F.map`.  Since `subDescentDataFunctor` is an
isomorphism of categories, `CategoryTheory.Functor.isEquivalence_of_comp_right` then returns the
statement for the canonical descent functor itself.

That the property "all components satisfy `P`" is closed under isomorphism is the only thing
proved here from scratch: an isomorphism of descent data is an isomorphism in each component,
whose inverse is the corresponding component of the inverse.  It is kept `private` and local
rather than being made a global instance, because it is needed at exactly one place.

The hypothesis `hP` is the per-family form of what Mathlib's
`Mathlib/CategoryTheory/Bicategory/Functor/Cat/ObjectProperty.lean` records as an open `TODO`
under the name `IsLocal P J`, namely a property that holds as soon as it holds locally.  The
per-family form is the one a single covering needs, and it is weaker than a condition quantified
over a whole topology: it never mentions a Grothendieck topology, so it is available for a single
presieve whose topology is not known to have effective descent.

Relation to the other formalism in this repository.  The same mathematics for *fibred categories*
rather than pseudofunctors is Stacks 04TU,
`CategoryTheory.Functor.IsStack.fullSubcategory`, which concludes
`CategoryTheory.Functor.IsStack` for a whole Grothendieck topology from the three conditions of
Stacks 026F.  Neither statement implies the other: that one needs the global stack condition and
the fibrewise reading of its conditions (1) and (3), this one needs only the single presieve and
detects `P` on the given family.  No Stacks tag is claimed here: 04TU is already tagged at that
declaration, and this is a different hypothesis set in a different formalism.

A witness that the two hypotheses are simultaneously satisfiable, for an arbitrary `F` and an
arbitrary `P`: take the one-element family consisting of `𝟙 S`.  Then
`Stacks.Descent.isStackFor_of_isSplitEpi_mem` supplies the stack condition and `F.mapId` supplies
`hP`.

## References

* [Stacks Project, Tag 026F](https://stacks.math.columbia.edu/tag/026F)
* [Stacks Project, Tag 04TU](https://stacks.math.columbia.edu/tag/04TU)
-/

@[expose] public section

open CategoryTheory Opposite Bicategory CategoryTheory.Pseudofunctor

universe t v' v u' u

namespace Stacks.Descent

variable {C : Type u} [Category.{v} C] {F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat.{v', u'}}
  (P : F.ObjectProperty) [P.IsClosedUnderMapObj]
  {ι : Type t} {S : C} {X : ι → C} (f : ∀ i, X i ⟶ S)

omit [P.IsClosedUnderMapObj] in
/-- If `P` is closed under isomorphism in every fibre, then so is the property of a descent datum
that all of its components satisfy `P`: an isomorphism of descent data is componentwise an
isomorphism, with the components of the inverse as inverses. -/
private lemma isClosedUnderIsomorphisms_subDescentDataProp [P.IsClosedUnderIsomorphisms] :
    (subDescentDataProp P f).IsClosedUnderIsomorphisms where
  of_iso {_ _} e h i :=
    ObjectProperty.prop_of_iso _
      { hom := e.hom.hom i
        inv := e.inv.hom i
        hom_inv_id := by
          rw [← Pseudofunctor.DescentData.comp_hom, e.hom_inv_id,
            Pseudofunctor.DescentData.id_hom]
        inv_hom_id := by
          rw [← Pseudofunctor.DescentData.comp_hom, e.inv_hom_id,
            Pseudofunctor.DescentData.id_hom] }
      (h i)

/-- **Effective descent along a family passes to a sub-pseudofunctor detected on that family.**
Let `P` be a property of objects of `F` preserved by the functors `F.map` and closed under
isomorphism, and suppose an object of `F.obj S` satisfies `P` as soon as all of its pullbacks
along a family `f i : X i ⟶ S` do.  If the canonical descent functor of `F` for that family is an
equivalence of categories, then so is the canonical descent functor of the sub-pseudofunctor cut
out by `P`. -/
theorem isEquivalence_toDescentData_fullsubcategory [P.IsClosedUnderIsomorphisms]
    (hP : ∀ M : F.obj (.mk (op S)),
      (∀ i, (P.prop (.mk (op (X i)))) ((F.map (f i).op.toLoc).toFunctor.obj M)) →
        (P.prop (.mk (op S))) M)
    [(F.toDescentData f).IsEquivalence] :
    ((P.fullsubcategory).toDescentData f).IsEquivalence := by
  have := isClosedUnderIsomorphisms_subDescentDataProp P f
  have heq : (subDescentDataProp P f).inverseImage (F.toDescentData f) =
      P.prop (.mk (op S)) := by
    ext M
    exact ⟨hP M, fun hM i ↦ P.map_obj hM _⟩
  have h₁ : (P.fullsubcategory.toDescentData f ⋙ subDescentDataFunctor P f).IsEquivalence := by
    rw [toDescentData_comp_subDescentDataFunctor]
    exact Equivalence.isEquivalence_functor
      ((F.toDescentData f).asEquivalence.congrFullSubcategory heq)
  exact Functor.isEquivalence_of_comp_right _ (subDescentDataFunctor P f)

/-- **The stack condition for a presieve passes to a sub-pseudofunctor detected on a generating
family.**  This is `Stacks.Descent.isEquivalence_toDescentData_fullsubcategory` phrased with
`CategoryTheory.Pseudofunctor.IsStackFor`, through
`CategoryTheory.Pseudofunctor.isStackFor_ofArrows_iff`. -/
theorem isStackFor_fullsubcategory [P.IsClosedUnderIsomorphisms]
    (hP : ∀ M : F.obj (.mk (op S)),
      (∀ i, (P.prop (.mk (op (X i)))) ((F.map (f i).op.toLoc).toFunctor.obj M)) →
        (P.prop (.mk (op S))) M)
    (hF : F.IsStackFor (Presieve.ofArrows X f)) :
    (P.fullsubcategory).IsStackFor (Presieve.ofArrows X f) := by
  rw [Pseudofunctor.isStackFor_ofArrows_iff] at hF ⊢
  have := hF
  exact isEquivalence_toDescentData_fullsubcategory P f hP

end Stacks.Descent

end
