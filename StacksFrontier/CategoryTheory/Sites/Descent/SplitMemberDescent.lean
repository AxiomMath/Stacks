module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.PullbackStalk.SheafDescent

/-!
# Effective descent along a family with a split member

Let `F` be a pseudofunctor from the locally discrete bicategory on `Cᵒᵖ` to `Cat` and let
`f i : X i ⟶ S` be a family of morphisms one member of which admits a section. Then the sieve
generated by the family contains the identity of `S`, so it is the maximal sieve, and descent
along the family is effective: it is the same as descent along that single split member, which
is the categorical core of Stacks 0GEY,
`CategoryTheory.Pseudofunctor.DescentData.isEquivalence_toDescentData_of_section`.

## Main results

* `CategoryTheory.Pseudofunctor.DescentData.sieve_ofArrows_eq_top_of_section`: the sieve of a
  family with a split member is the maximal sieve.
* `CategoryTheory.Pseudofunctor.DescentData.isEquivalence_toDescentData_of_section_mem`:
  descent along a family with a split member is effective.
* `CategoryTheory.Pseudofunctor.DescentData.isEquivalence_toDescentData_pullback_snd_of_fac`:
  descent along the base change of a family along a morphism factoring through one of its
  members is effective, that member's base change having a section.

## References

* [Stacks Project, Tag 0GEY](https://stacks.math.columbia.edu/tag/0GEY)
-/

@[expose] public section

universe t v' u' v u

namespace CategoryTheory.Pseudofunctor.DescentData

variable {C : Type u} [Category.{v} C]

/-- The sieve generated by a family of morphisms one member of which admits a section is the
maximal sieve. -/
theorem sieve_ofArrows_eq_top_of_section {ι : Type t} {S : C} {X : ι → C} (f : ∀ i, X i ⟶ S)
    (i : ι) (s : S ⟶ X i) (hs : s ≫ f i = 𝟙 S) :
    Sieve.ofArrows X f = ⊤ := by
  rw [← Sieve.id_mem_iff_eq_top, ← hs]
  exact (Sieve.ofArrows X f).downward_closed (Sieve.ofArrows_mk X f i) s

/-- **Effective descent along a family with a split member.** If some member `f i` of a family
`f i : X i ⟶ S` admits a section, then the canonical functor from the fibre over `S` to descent
data for the family is an equivalence. -/
theorem isEquivalence_toDescentData_of_section_mem
    (F : Pseudofunctor (LocallyDiscrete Cᵒᵖ) Cat.{v', u'})
    {ι : Type t} {S : C} {X : ι → C} (f : ∀ i, X i ⟶ S)
    (i : ι) (s : S ⟶ X i) (hs : s ≫ f i = 𝟙 S) :
    (F.toDescentData f).IsEquivalence := by
  have h : Sieve.ofArrows X f = Sieve.ofArrows (fun _ : Unit ↦ X i) (fun _ ↦ f i) := by
    rw [sieve_ofArrows_eq_top_of_section f i s hs,
      sieve_ofArrows_eq_top_of_section (fun _ : Unit ↦ f i) () s hs]
  exact (isEquivalence_toDescentData_iff_of_sieve_eq F f _ h).2
    (isEquivalence_toDescentData_of_section F (f i) s hs)

/-- **Descent along a base change through a member.** If `t : T ⟶ Y` factors through the member
`f i₀` of a family `f i : X i ⟶ Y`, the member `X i₀ ×_Y T ⟶ T` of the base-changed family has
a section, so descent along the base-changed family is effective. -/
theorem isEquivalence_toDescentData_pullback_snd_of_fac [Limits.HasPullbacks C]
    (F : Pseudofunctor (LocallyDiscrete Cᵒᵖ) Cat.{v', u'})
    {ι : Type t} {Y T : C} {X : ι → C} (f : ∀ i, X i ⟶ Y) (t : T ⟶ Y) (i₀ : ι) (a : T ⟶ X i₀)
    (ha : a ≫ f i₀ = t) :
    (F.toDescentData (fun i ↦ Limits.pullback.snd (f i) t)).IsEquivalence :=
  isEquivalence_toDescentData_of_section_mem F (fun i ↦ Limits.pullback.snd (f i) t) i₀
    (Limits.pullback.lift a (𝟙 T) (by rw [ha, Category.id_comp])) (Limits.pullback.lift_snd _ _ _)

end CategoryTheory.Pseudofunctor.DescentData

end
