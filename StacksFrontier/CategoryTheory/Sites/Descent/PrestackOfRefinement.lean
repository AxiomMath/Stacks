module

public import StacksFrontier.CategoryTheory.Sites.Descent.OfRefinement
import all StacksFrontier.CategoryTheory.Sites.Descent.OfRefinement

/-!
# Descent of morphisms along a family, from descent along a refinement

Let `F : LocallyDiscrete Cᵒᵖ ⥤ᵖ Cat` be a pseudofunctor, let `f i : X i ⟶ S` be a family of
morphisms with fixed target and let `f' j : X' j ⟶ S` be a refinement of it, given by a
reindexing `α : ι' → ι` and morphisms `p' j : X' j ⟶ X (α j)` over `S`.  This file transfers the
descent of morphisms — full faithfulness of `CategoryTheory.Pseudofunctor.toDescentData` — from
the refinement `f'` back to `f`.

## Main results

* `CategoryTheory.Pseudofunctor.DescentData.nonempty_fullyFaithful_toDescentData_of_refinement`:
  if `F.toDescentData f'` is fully faithful, if the descent of morphisms holds along the pullback
  of the sieve generated by `f'` to each `X i`, and if it is separated along the pullback of that
  sieve to each chosen fibre product `X i₁ ×_S X i₂`, then `F.toDescentData f` is fully faithful.
* `CategoryTheory.Pseudofunctor.isPrestackFor_of_refinement` is the same statement phrased with
  `CategoryTheory.Pseudofunctor.IsPrestackFor` for the presieves generated by the two families.

## Implementation notes

This is the prestack analogue of Mathlib's
`CategoryTheory.Pseudofunctor.DescentData.isEquivalence_toDescentData_of_sieve_le`, and the
difference is the point of the file.  That lemma, and
`CategoryTheory.Pseudofunctor.IsStackFor.of_le` which packages it, both assume a *global*
`[F.IsPrestack J]`: they use it exactly once, to get
full faithfulness of the refinement functor out of
`CategoryTheory.Pseudofunctor.DescentData.fullyFaithfulPullFunctor`.  So neither can be used to
*establish* `F.IsPrestack J` in the first place, which is what a pseudofunctor's first descent
obligation is.  Here that one use is replaced by
`CategoryTheory.Pseudofunctor.DescentData.nonempty_fullyFaithful_pullFunctor`, whose hypotheses
are the two *local* sheaf conditions at `X i` and at `X i₁ ×_S X i₂`, so the conclusion is
available before any global prestack condition is known.

Given full faithfulness of the refinement functor, the transfer itself is the standard
two-out-of-three argument on `F.toDescentData f ⋙ pullFunctor F w ≅ F.toDescentData f'`
(`CategoryTheory.Pseudofunctor.DescentData.toDescentDataCompPullFunctorIso`, composed with the
unit comparison of `F` at the identity of `S`): a composite that is faithful has a faithful first
factor, and a composite that is full with a faithful second factor has a full first factor.

The chosen fibre products are taken as data (`CategoryTheory.Limits.ChosenPullback`) rather than
assumed to exist, so that `HasPullbacks C` is not needed; use
`CategoryTheory.Limits.ChosenPullback.ofHasPullback` when it is available.

No Stacks tag is claimed: the statement is a transfer principle for the descent of morphisms, not
one of the project's mathematical results.
-/

@[expose] public section

universe t t' v' v u' u

namespace CategoryTheory

open Opposite Limits Pseudofunctor Pseudofunctor.LocallyDiscreteOpToCat

variable {C : Type u} [Category.{v} C]

namespace Pseudofunctor

variable {F : Pseudofunctor (LocallyDiscrete Cᵒᵖ) Cat.{v', u'}}
  {ι : Type t} {S : C} {X : ι → C} {f : ∀ i, X i ⟶ S}
  {ι' : Type t'} {X' : ι' → C} {f' : ∀ j, X' j ⟶ S}
  {α : ι' → ι} {p' : ∀ j, X' j ⟶ X (α j)}

namespace DescentData

/-- **Descent of morphisms along a family, from descent along a refinement.**
Let `f' j : X' j ⟶ S` refine `f i : X i ⟶ S` through `α` and `p'`.  Assume that the descent of
morphisms holds along the pullback of the sieve generated by `f'` to each `X i`, that it is
separated along the pullback of that sieve to each chosen fibre product `X i₁ ×_S X i₂`, and that
`F.toDescentData f'` is fully faithful.  Then `F.toDescentData f` is fully faithful.

Unlike `CategoryTheory.Pseudofunctor.DescentData.isEquivalence_toDescentData_of_sieve_le`, no
global `F.IsPrestack J` is assumed; see the implementation notes of this file. -/
lemma nonempty_fullyFaithful_toDescentData_of_refinement
    (w : ∀ j, p' j ≫ f (α j) = f' j)
    (H₃ : ∀ (i : ι) (M N : F.obj (.mk (op (X i)))),
      Presieve.IsSheafFor (F.presheafHom M N) (refSieve f' (𝟙 (X i)) (f i)).arrows)
    (sq : ∀ i₁ i₂, ChosenPullback (f i₁) (f i₂))
    (H₄ : ∀ (i₁ i₂ : ι) (M N : F.obj (.mk (op (X i₁)))),
      Presieve.IsSeparatedFor (F.presheafHom M N)
        (refSieve f' (sq i₁ i₂).p₁ (sq i₁ i₂).p).arrows)
    (h : Nonempty (F.toDescentData f').FullyFaithful) :
    Nonempty (F.toDescentData f).FullyFaithful := by
  have hpull := (nonempty_fullyFaithful_pullFunctor w
    (fun D₁ D₂ i ↦ H₃ i (D₁.obj i) (D₂.obj i)) sq
    (fun D₁ D₂ i₁ i₂ ↦ H₄ i₁ i₂ (D₁.obj i₁) (D₂.obj i₁))).some
  have hf' := h.some
  have := hpull.full
  have := hpull.faithful
  have := hf'.full
  have := hf'.faithful
  have e : F.toDescentData f ⋙ pullFunctor F (f := f) (p := 𝟙 _) (f' := f') (p' := p')
      (by cat_disch) ≅ F.toDescentData f' :=
    toDescentDataCompPullFunctorIso _ _ ≪≫
      Functor.isoWhiskerRight (Cat.Hom.toNatIso (F.mapId _)) _ ≪≫ Functor.leftUnitor _
  have := Functor.Faithful.of_comp_iso e
  have := Functor.Full.of_comp_faithful_iso e
  exact ⟨.ofFullyFaithful _⟩

end DescentData

/-- **The descent of morphisms for a presieve, from a refinement of it.**  This is
`CategoryTheory.Pseudofunctor.DescentData.nonempty_fullyFaithful_toDescentData_of_refinement`
stated for the presieves generated by the two families, in the form in which
`CategoryTheory.Pseudofunctor.IsPrestack.of_precoverage` consumes it. -/
lemma isPrestackFor_of_refinement
    (w : ∀ j, p' j ≫ f (α j) = f' j)
    (H₃ : ∀ (i : ι) (M N : F.obj (.mk (op (X i)))),
      Presieve.IsSheafFor (F.presheafHom M N)
        (DescentData.refSieve f' (𝟙 (X i)) (f i)).arrows)
    (sq : ∀ i₁ i₂, ChosenPullback (f i₁) (f i₂))
    (H₄ : ∀ (i₁ i₂ : ι) (M N : F.obj (.mk (op (X i₁)))),
      Presieve.IsSeparatedFor (F.presheafHom M N)
        (DescentData.refSieve f' (sq i₁ i₂).p₁ (sq i₁ i₂).p).arrows)
    (h : F.IsPrestackFor (Presieve.ofArrows X' f')) :
    F.IsPrestackFor (Presieve.ofArrows X f) := by
  rw [isPrestackFor_ofArrows_iff] at h ⊢
  exact DescentData.nonempty_fullyFaithful_toDescentData_of_refinement w H₃ sq H₄ h

end Pseudofunctor

end CategoryTheory

end
