module

public import Mathlib.CategoryTheory.Comma.StructuredArrow.Small
public import Mathlib.CategoryTheory.Limits.Constructions.LimitsOfProductsAndEqualizers
public import Mathlib.CategoryTheory.Sites.Pullback
public import Mathlib.Combinatorics.Quiver.ReflQuiver
public import Mathlib.Order.CompletePartialOrder
public import StacksCore.Tactic.StacksAttribute

/-!
# Quasi-morphisms of sites

Stacks 00WZ and 00X8, the two remarks that weaken continuity to *quasi*-continuity: the first
introduces the notion and observes that 00WW and 00WX survive it, the second defines a
quasi-morphism of sites and states the quasi-continuous analogue of Proposition 00X6.
A functor `u : C ⥤ D` between sites presented by pretopologies is
*quasi-continuous* when the image of every covering family is tautologically equivalent to a
covering family of `D` and `u` preserves the fibre products occurring in covering families.
Such a `u` is continuous, so restriction of sheaves of sets along `u` has a left adjoint `u_s`;
if in addition `u` preserves the terminal object and fibre products, then `u_s` is exact, i.e.
`u` defines a quasi-morphism of sites `D → C`.

Sites are modelled by `CategoryTheory.Pretopology`, whose definition presupposes
`[HasPullbacks]`; that hypothesis is part of the model rather than an extra assumption.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe v u

namespace QuasiMorphismOfSites

/-!
## Definition 1 (Tautologically equivalent families; Stacks 00VU = Def 7.8.2)

A *family of morphisms with common target* `X` in a category `E` is an indexed
collection `{φ_i : Y_i -> X}_{i in ι}`.
-/

/-- A family of morphisms with a common, fixed target `X`. This is the Stacks
notion of a "family of morphisms with fixed target". -/
structure ArrowFamily (E : Type u) [Category.{v} E] (X : E) where
  /-- The index set of the family. -/
  ι : Type v
  /-- The source object of the `i`-th morphism. -/
  obj : ι → E
  /-- The `i`-th morphism `obj i ⟶ X`. -/
  hom : (i : ι) → obj i ⟶ X

/-- **Definition 1 (Tautologically equivalent families).** Two families
`U = {φ_i : U_i -> U}` and `V = {ψ_j : V_j -> U}` with a common target are
*tautologically equivalent* if there are maps `α : I → J` and `β : J → I`
together with, for every `i` and every `j`, isomorphisms `U_i ≅ V_{α i}` and
`V_j ≅ U_{β j}` that are morphisms over the common target `U` (i.e. the evident
triangles commute). -/
def TautologicallyEquivalent {E : Type u} [Category.{v} E] {X : E}
    (U V : ArrowFamily E X) : Prop :=
  ∃ (α : U.ι → V.ι) (β : V.ι → U.ι)
    (gU : (i : U.ι) → U.obj i ≅ V.obj (α i))
    (gV : (j : V.ι) → V.obj j ≅ U.obj (β j)),
    (∀ i, (gU i).hom ≫ V.hom (α i) = U.hom i) ∧
    (∀ j, (gV j).hom ≫ U.hom (β j) = V.hom j)

/-- The presieve generated by an `ArrowFamily` (i.e. `Presieve.ofArrows`). This
lets us compare families against the covering presieves recorded by a
`Pretopology`. -/
def ArrowFamily.toPresieve {E : Type u} [Category.{v} E] {X : E}
    (S : ArrowFamily E X) : Presieve X :=
  Presieve.ofArrows S.obj S.hom

/-- The image `{u(Y_i) -> u(X)}` of an `ArrowFamily` under a functor `u`. -/
def ArrowFamily.map {C : Type u} [Category.{v} C] {D : Type u} [Category.{v} D]
    (u : C ⥤ D) {X : C} (S : ArrowFamily C X) : ArrowFamily D (u.obj X) where
  ι := S.ι
  obj i := u.obj (S.obj i)
  hom i := u.map (S.hom i)

/-!
## Definition 2 (Continuous functor; Stacks 00WV/00WW)

We take *continuity* in the source/Mathlib sense: `u : C → D` is continuous if
for every sheaf `F` on `D`, the restriction presheaf `u^p F` is a sheaf on `C`.
This is `CategoryTheory.Functor.IsContinuous`, which we use directly. We expose
it under the project name below for readability.
-/

/-- **Definition 2 (Continuous functor).** `u` is continuous for the topologies
`JC`, `JD` iff precomposition with `u` preserves sheaves; this is Mathlib's
`Functor.IsContinuous`. -/
@[sga "4 III 1.1", sga "4 III 1.11", sga "4 IV 4.9.1"]
abbrev IsContinuous {C : Type u} [Category.{v} C] {D : Type u} [Category.{v} D]
    (u : C ⥤ D) (JC : GrothendieckTopology C) (JD : GrothendieckTopology D) : Prop :=
  Functor.IsContinuous.{v} u JC JD

/-!
## Definition 3 (Quasi-continuous functor; Stacks 00WZ = Remark 7.13.6)

`u : C → D` is *quasi-continuous* if for every covering family
`V = {V_i -> V}` of `C`:
1. the image family `{u(V_i) -> u(V)}` is tautologically equivalent to some
   covering family of `D`; and
2. for every morphism `T -> V` in `C`, the canonical morphism
   `u(T ×_V V_i) -> u(T) ×_{u(V)} u(V_i)` is an isomorphism.
-/

/-- **Definition 3 (Quasi-continuous functor).** Here sites are presented by
pretopologies `PC` (on `C`) and `PD` (on `D`). The first clause is the relaxation
of the pretopological continuity condition: the image family need only be
*tautologically equivalent* to a covering family of `D`, rather than itself being
one. The second clause says `u` preserves the fibre products appearing in
covering families, expressed via the pullback comparison morphism being an
isomorphism. -/
@[stacks 00WZ "the definition of quasi-continuous"]
def IsQuasiContinuous {C : Type u} [Category.{v} C] {D : Type u} [Category.{v} D]
    [HasPullbacks C] [HasPullbacks D] (u : C ⥤ D)
    (PC : Pretopology C) (PD : Pretopology D) : Prop :=
  ∀ ⦃V : C⦄ (𝒱 : ArrowFamily C V), 𝒱.toPresieve ∈ PC V →
    (∃ 𝒰 : ArrowFamily D (u.obj V),
        𝒰.toPresieve ∈ PD (u.obj V) ∧
        TautologicallyEquivalent (𝒱.map u) 𝒰) ∧
    (∀ ⦃T : C⦄ (a : T ⟶ V) (i : 𝒱.ι),
        IsIso (pullbackComparison u a (𝒱.hom i)))

/-!
## Definition 4 (Exact functor; Stacks 0034 = Def 4.23.1)

A functor between categories with finite limits and finite colimits is *exact*
if it preserves both finite limits and finite colimits.
-/

/-- **Definition 4 (Exact functor).** `F` is exact iff it preserves finite
limits and preserves finite colimits. -/
@[sga "1 V 6.1", sga "4 I 2.4.1", sga "4 XVII 7.3.3"]
def IsExact {A : Type*} [Category A] {B : Type*} [Category B] (F : A ⥤ B) : Prop :=
  PreservesFiniteLimits F ∧ PreservesFiniteColimits F

/-!
## Background Lemma A (Quasi-continuous ⇒ continuous; Stacks 00WZ)

If `u` is quasi-continuous then `u^p` carries sheaves to sheaves, i.e. `u` is
continuous in the sense of Definition 2 (for the associated Grothendieck
topologies). Consequently the restriction-on-sheaves functor `u^s` has a left
adjoint `u_s = (u_p -)^#` (supplied by Mathlib's `Functor.sheafAdjunctionContinuous`
once continuity is known). We record the continuity conclusion as a lemma (it is
an invoked result, not a definition); it is used internally to form `u_s` in the
definition of a quasi-morphism of sites and in the main statements. -/

/-!
### Decomposition of Background Lemma A

The Mathlib definition `Functor.IsContinuous u J K` says: for every `K`-sheaf `G`
of types, the restriction presheaf `u.op ⋙ G.obj` is a `J`-sheaf (here
`J = PC.toGrothendieck`, `K = PD.toGrothendieck`). Because both topologies come
from pretopologies, `Presieve.isSheaf_pretopology` reduces the `J`-sheaf condition
on `u.op ⋙ G.obj` to: *for every covering presieve `R ∈ PC X`,
`IsSheafFor (u.op ⋙ G.obj) R`*. A covering presieve `R ∈ PC X` is, up to the
canonical encoding, `𝒱.toPresieve` for an `ArrowFamily 𝒱` (its index is the total
space of arrows in `R`). So the whole lemma reduces to:

  for every covering family `𝒱` of `C` (i.e. `𝒱.toPresieve ∈ PC V`) and every
  `PD.toGrothendieck`-sheaf `G`, `IsSheafFor (u.op ⋙ G.obj) 𝒱.toPresieve`.

This is precisely the zeroth-Čech-cohomology computation of Stacks 00WZ:

  H⁰(𝒱, u^p G) = H⁰(u(𝒱), G) = H⁰(𝒰, G) = G(u V),

where `𝒰` is a `PD`-cover tautologically equivalent to the image family
`u(𝒱) = 𝒱.map u`. We isolate the two non-formal steps as named sub-lemmas:

* `isSheafFor_image_of_pullbackComparison` — the first equality
  `H⁰(𝒱, u^p G) = H⁰(u(𝒱), G)`: it uses quasi-continuity **clause (2)** (the
  pullback comparisons `u(T ×_V V_i) → u T ×_{u V} u V_i` are isomorphisms) to
  transfer the sheaf/amalgamation condition from the image family `u(𝒱)` back to
  `𝒱` along restriction by `u`. Compatible families and their (unique)
  amalgamations correspond bijectively because the relevant fibre products are
  preserved.

* `isSheafFor_iff_tautologicallyEquivalent` — the equality
  `H⁰(u(𝒱), G) = H⁰(𝒰, G)`: tautologically equivalent families (Definition 1)
  have the same zeroth Čech cohomology / sheaf condition, because the chosen
  isomorphisms-over-the-common-target set up a bijection between compatible
  families and between their amalgamations (Stacks Remark 7.10.7).

Given these, the proof glues: take the `PD`-cover `𝒰 ~ u(𝒱)` from clause (1);
`G` is a sheaf for `𝒰` because `𝒰.toPresieve ∈ PD`; hence (Čech invariance) `G`
is a sheaf for `u(𝒱)`; hence (clause (2) transfer) `u.op ⋙ G.obj` is a sheaf
for `𝒱`. -/

/-- **Sub-lemma (clause (2) / Čech transfer along `u`).** If, for the covering
family `𝒱 = {V_i → V}`, every pullback comparison `pullbackComparison u a (𝒱.hom i)`
is an isomorphism (quasi-continuity clause (2)), then the restriction presheaf
`u.op ⋙ G.obj` is a sheaf for `𝒱.toPresieve` whenever `G.obj` is a sheaf for the
image family `(𝒱.map u).toPresieve`.

Mathematically this is the first Čech equality `H⁰(𝒱, u^p G) = H⁰(u(𝒱), G)`. A
compatible family `x` for `u.op ⋙ G.obj` on `𝒱` is the same data as a family of
elements `x i ∈ G(u V_i)`; its compatibility is governed by the fibre products
`V_i ×_V V_j` of `C`, which `u` carries (via the pullback comparisons being iso,
applied with `a = 𝒱.hom j : V_j → V`) to the fibre products `u V_i ×_{u V} u V_j`
of `D`. Hence `x` is compatible for `u.op ⋙ G.obj` on `𝒱` **iff** the same
elements form a compatible family for `G.obj` on `u(𝒱)`, and amalgamations
(elements of `G(u V)`) correspond identically. Unique amalgamation for `u(𝒱)`
therefore transports to unique amalgamation for `𝒱`.

Formal strategy: use `Presieve.isSheafFor_arrows_iff_pullbacks` on both sides
(both `𝒱.toPresieve` and `(𝒱.map u).toPresieve` are `ofArrows`), and use the
`pullbackComparison ... IsIso` witnesses to identify `Arrows.PullbackCompatible`
on the two sides. The element-level data `(i : 𝒱.ι) → G(u V_i)` is literally the
same on both sides since `(u.op ⋙ G.obj).obj (op V_i) = G.obj (op (u V_i))`. -/
theorem isSheafFor_image_of_pullbackComparison
    {C : Type u} [SmallCategory C] {D : Type u} [SmallCategory D]
    [HasPullbacks C] [HasPullbacks D] (u : C ⥤ D) {V : C} (𝒱 : ArrowFamily C V)
    (G : Dᵒᵖ ⥤ Type u)
    (hpb : ∀ ⦃T : C⦄ (a : T ⟶ V) (i : 𝒱.ι),
        IsIso (pullbackComparison u a (𝒱.hom i)))
    (hG : Presieve.IsSheafFor G (𝒱.map u).toPresieve) :
    Presieve.IsSheafFor (u.op ⋙ G) 𝒱.toPresieve := by
  -- Rewrite both sides with `Presieve.isSheafFor_arrows_iff_pullbacks`
  -- (both `𝒱.toPresieve` and `(𝒱.map u).toPresieve` are `ofArrows`).
  rw [ArrowFamily.toPresieve, Presieve.isSheafFor_arrows_iff_pullbacks]
  rw [ArrowFamily.toPresieve, ArrowFamily.map,
      Presieve.isSheafFor_arrows_iff_pullbacks] at hG
  intro x hx
  -- Transfer pullback-compatibility from `𝒱` (in `C`) to its image `u(𝒱)` (in `D`),
  -- using that each `pullbackComparison u (𝒱.hom i) (𝒱.hom j)` is an iso, hence
  -- `G.map (·).op` of it is a bijection on the `Type`-valued sections.
  have hxD : Presieve.Arrows.PullbackCompatible G (fun i => u.map (𝒱.hom i)) x := by
    intro i j
    have hc : IsIso (pullbackComparison u (𝒱.hom i) (𝒱.hom j)) := hpb (𝒱.hom i) j
    have hinj : Function.Injective
        (G.map (pullbackComparison u (𝒱.hom i) (𝒱.hom j)).op) :=
      (ConcreteCategory.bijective_of_isIso _).injective
    apply hinj
    have key := hx i j
    simp only [Functor.comp_obj, Functor.comp_map, Functor.op_obj, Functor.op_map,
      Quiver.Hom.unop_op] at key ⊢
    rw [← Functor.map_comp_apply, ← Functor.map_comp_apply, ← op_comp, ← op_comp,
        pullbackComparison_comp_fst, pullbackComparison_comp_snd]
    exact key
  -- The amalgamation statements coincide definitionally
  -- (`(u.op ⋙ G).map (𝒱.hom i).op = G.map (u.map (𝒱.hom i)).op`).
  exact hG x hxD

/-- **Sub-lemma (tautological invariance of the sheaf condition; Stacks 7.10.7).**
Two tautologically equivalent families with common target have the same zeroth
Čech cohomology, i.e. the same `IsSheafFor` condition for any presheaf.

If `U ~ V` (Definition 1), the chosen isomorphisms `gU i : U.obj i ≅ V.obj (α i)`
and `gV j : V.obj j ≅ U.obj (β j)`, which are morphisms over the common target,
induce mutually inverse bijections between `FamilyOfElements P U.toPresieve` and
`FamilyOfElements P V.toPresieve` that preserve compatibility and amalgamations
(precompose by the isomorphism, which `P` turns into a bijection on sections).
Hence `P` is a sheaf for `U.toPresieve` iff it is a sheaf for `V.toPresieve`.

Formal strategy: reduce both `toPresieve` to `ofArrows` and use
`Presieve.isSheafFor_arrows_iff` together with the iso data; an element family
`x : (i) → P(U_i)` corresponds to `y : (j) → P(V_j)` via `y j = P(gV j).hom.op (x (β j))`
and back, with the over-`U` triangle equalities ensuring the amalgamation
conditions `P(φ_i)·t = x i` and `P(ψ_j)·t = y j` match. (`Presieve.isSheafFor_pullback_iff`
handles the single-arrow iso case; here we package the family-level bijection
directly.) -/
theorem isSheafFor_iff_tautologicallyEquivalent
    {E : Type u} [SmallCategory E] {X : E} (P : Eᵒᵖ ⥤ Type u)
    (U V : ArrowFamily E X) (h : TautologicallyEquivalent U V) :
    Presieve.IsSheafFor P U.toPresieve ↔ Presieve.IsSheafFor P V.toPresieve := by
  -- `IsSheafFor` depends only on the generated sieve, via `Presieve.isSheafFor_iff_generate`
  -- (`IsSheafFor P R ↔ IsSheafFor P (Sieve.generate R).arrows`). So it suffices to show
  -- `Sieve.generate U.toPresieve = Sieve.generate V.toPresieve`, by `le_antisymm`:
  -- for `generate U ≤ generate V`, each generator `U.hom i = (gU i).hom ≫ V.hom (α i)`
  -- (hypothesis `hU i`) factors through `V.hom (α i)`, so lies in `generate V`; the
  -- reverse uses `hV j`. (Iso-over-X is only needed for the symmetry; a morphism over X
  -- suffices for each inclusion.) Then rewrite both sides of the goal with
  -- `isSheafFor_iff_generate` and the sieve equality.
  -- Empty/repeated-index edge cases are handled automatically since the argument quantifies over
  -- generated-sieve arrows.
  obtain ⟨α, β, gU, gV, hU, hV⟩ := h
  have hsieve : Sieve.generate U.toPresieve = Sieve.generate V.toPresieve := by
    refine le_antisymm ((Sieve.generate_le_iff _ _).2 ?_) ((Sieve.generate_le_iff _ _).2 ?_)
    · rintro Y f ⟨i⟩
      exact ⟨V.obj (α i), (gU i).hom, V.hom (α i), Presieve.ofArrows.mk (α i), hU i⟩
    · rintro Y f ⟨j⟩
      exact ⟨U.obj (β j), (gV j).hom, U.hom (β j), Presieve.ofArrows.mk (β j), hV j⟩
  rw [Presieve.isSheafFor_iff_generate U.toPresieve,
    Presieve.isSheafFor_iff_generate V.toPresieve, hsieve]

/-- **Background Lemma A.** A quasi-continuous functor `u : C ⥤ D` is continuous, so
restriction of sheaves of sets along `u` is defined and has a left adjoint `u_s`.

For a `PD`-sheaf `G` and a covering presieve `R ∈ PC X`, repackage `R` as an `ArrowFamily 𝒱`;
quasi-continuity supplies a `PD`-covering tautologically equivalent to `u(𝒱)`, so `G` is a sheaf
for `u(𝒱)` by `isSheafFor_iff_tautologicallyEquivalent`, and preservation of the relevant fibre
products carries that back to `u.op ⋙ G.obj` and `𝒱` via
`isSheafFor_image_of_pullbackComparison`. -/
@[stacks 00WZ, sga "4 III 1.6" "iii) ⇒ i)"]
theorem isContinuous_of_isQuasiContinuous
    {C : Type u} [SmallCategory C] {D : Type u} [SmallCategory D]
    [HasPullbacks C] [HasPullbacks D] (u : C ⥤ D)
    (PC : Pretopology C) (PD : Pretopology D)
    (hu : IsQuasiContinuous u PC PD) :
    u.IsContinuous PC.toGrothendieck PD.toGrothendieck := by
  -- The continuity class field is stated for `Type (max u₁ v₁ u₂ v₂)` sheaves; with
  -- `SmallCategory C/D` (`v = u`) this is `Type u`. We prove the (equivalent) field.
  -- It suffices, for every `PD.toGrothendieck`-sheaf `G`, that `u.op ⋙ G.obj` is a
  -- `PC.toGrothendieck`-sheaf; by `Presieve.isSheaf_pretopology` this reduces to
  -- `IsSheafFor (u.op ⋙ G.obj) R` for every covering presieve `R ∈ PC X`.
  refine ⟨fun G => ?_⟩
  rw [Presieve.isSheaf_pretopology]
  intro X R hR
  -- Encode the covering presieve `R ∈ PC X` as `𝒱.toPresieve` for an `ArrowFamily 𝒱`
  -- (canonical family: index = total space of arrows of `R`). Then
  -- `𝒱.toPresieve ∈ PC X`, and quasi-continuity applies to `𝒱`.
  -- `R = ofArrows` of its canonical family; `ArrowFamily.toPresieve` is `ofArrows`,
  -- so this is `Presieve.ofArrows_surj` / a direct repackaging.
  obtain ⟨𝒱, h𝒱R⟩ :
      ∃ 𝒱 : ArrowFamily C X, 𝒱.toPresieve = R := by
    -- Every presieve is `Presieve.ofArrows` of a canonical family
    -- (`Presieve.exists_eq_ofArrows`); repackage that family as an `ArrowFamily`.
    -- With `SmallCategory C` the index lives in `Type u`, matching `ArrowFamily.ι`.
    obtain ⟨ι, Y, f, rfl⟩ := R.exists_eq_ofArrows
    exact ⟨⟨ι, Y, f⟩, rfl⟩
  rw [← h𝒱R] at hR ⊢
  -- Apply quasi-continuity to the covering family `𝒱`.
  obtain ⟨⟨𝒰, h𝒰PD, htaut⟩, hpb⟩ := hu 𝒱 hR
  -- `G` is a sheaf for the `PD`-cover `𝒰` (since `𝒰.toPresieve ∈ PD (u.obj X)`).
  have hGsheaf : Presieve.IsSheafFor G.obj 𝒰.toPresieve := by
    have hGtype : Presieve.IsSheaf PD.toGrothendieck G.obj :=
      (isSheaf_iff_isSheaf_of_type _ _).1 G.2
    exact (Presieve.isSheaf_pretopology PD).1 hGtype 𝒰.toPresieve h𝒰PD
  -- Čech invariance under tautological equivalence: `G` is a sheaf for `u(𝒱)`.
  have hGimage : Presieve.IsSheafFor G.obj (𝒱.map u).toPresieve :=
    (isSheafFor_iff_tautologicallyEquivalent G.obj (𝒱.map u) 𝒰 htaut).2 hGsheaf
  -- Clause (2) transfer along `u`: `u.op ⋙ G.obj` is a sheaf for `𝒱`.
  exact isSheafFor_image_of_pullbackComparison u 𝒱 G.obj hpb hGimage

/-!
## Definition 5 (Quasi-morphism of sites; Stacks 00X8 = Remark 7.14.9)

A *quasi-morphism of sites* `f : D → C` is given by a quasi-continuous functor
`u : C → D` such that the induced functor `u_s` (the left adjoint of the
restriction `u^s`) is exact (Definition 4).

We package this for set-valued (`Type u`) sheaves. The continuity instance needed
to form `u_s = u.sheafPullback` is *derived internally* from quasi-continuity via
Background Lemma A (`isContinuous_of_isQuasiContinuous`); it is **not** an extra
hypothesis. Accordingly the definition is parameterized by the quasi-continuity
witness `hqc`, and the continuity instance is introduced with `letI` before
forming the sheaf pullback.
-/

/-- **Definition 5 (Quasi-morphism of sites).** Given a quasi-continuous functor
`u : C → D` (witnessed by `hqc`), `u` defines a quasi-morphism of sites
`f : D → C` if the induced left adjoint `u_s : Sh(C) → Sh(D)` on set-valued
sheaves is exact. The continuity instance needed to form
`u_s = u.sheafPullback` is derived from `hqc` via Background Lemma A, not
assumed. -/
@[stacks 00X8 "the definition of quasi-morphism of sites"]
def IsQuasiMorphismOfSites
    {C : Type u} [SmallCategory C] {D : Type u} [SmallCategory D]
    [HasPullbacks C] [HasPullbacks D] (u : C ⥤ D)
    (PC : Pretopology C) (PD : Pretopology D)
    (hqc : IsQuasiContinuous u PC PD) : Prop :=
  let : u.IsContinuous PC.toGrothendieck PD.toGrothendieck :=
    isContinuous_of_isQuasiContinuous u PC PD hqc
  IsExact (u.sheafPullback (Type u) PC.toGrothendieck PD.toGrothendieck)

/-!
## The quasi-morphism criterion

**Statement 1 (Quasi-morphism analogue of Stacks Proposition 7.14.7).**
Let `C`, `D` be sites and `u : C → D` quasi-continuous. Assume in addition:
1. `C` has a final object `X` and `u(X)` is a final object of `D`; and
2. `C` has fibre products and `u` commutes with them.
Then `u` defines a quasi-morphism of sites; equivalently, `u_s : Sh(C) → Sh(D)`
is exact (preserves finite limits and finite colimits).

The continuity needed to form `u_s` is *derived* from quasi-continuity via
Background Lemma A (`isContinuous_of_isQuasiContinuous`); it is **not** taken as a
hypothesis. We introduce it internally with `letI`. Hypothesis (1) is recorded as
preservation of the terminal object (`PreservesLimitsOfShape (Discrete PEmpty)`),
which — together with `C` having a terminal object — exactly says `u(X)` is a
final object of `D`; hypothesis (2) is preservation of pullbacks
(`PreservesLimitsOfShape WalkingCospan`).
-/

/-- **Statement 1.** A quasi-continuous functor `u : C → D` between sites that
preserves the terminal object and preserves fibre products (pullbacks) defines a
quasi-morphism of sites: the induced functor `u_s : Sh(C) → Sh(D)` on set-valued
sheaves is exact. Continuity is derived internally from quasi-continuity via
Background Lemma A and is not assumed. -/
@[stacks 00X8]
theorem isQuasiMorphismOfSites_of_isQuasiContinuous
    {C : Type u} [SmallCategory C] {D : Type u} [SmallCategory D]
    [HasPullbacks C] [HasPullbacks D] [HasTerminal C]
    (u : C ⥤ D) (PC : Pretopology C) (PD : Pretopology D)
    (hqc : IsQuasiContinuous u PC PD)
    -- Hypothesis (1): `u` sends the final object of `C` to a final object of `D`.
    (hterminal : PreservesLimitsOfShape (Discrete PEmpty.{1}) u)
    -- Hypothesis (2): `u` commutes with fibre products.
    (hpullbacks : PreservesLimitsOfShape WalkingCospan u) :
    IsQuasiMorphismOfSites u PC PD hqc := by
  unfold IsQuasiMorphismOfSites
  let : u.IsContinuous PC.toGrothendieck PD.toGrothendieck :=
    isContinuous_of_isQuasiContinuous u PC PD hqc
  have : PreservesLimitsOfShape (Discrete PEmpty.{1}) u := hterminal
  have : PreservesLimitsOfShape WalkingCospan u := hpullbacks
  have : HasFiniteLimits C := hasFiniteLimits_of_hasTerminal_and_pullbacks
  have : PreservesFiniteLimits u :=
    preservesFiniteLimits_of_preservesTerminal_and_pullbacks u
  have : RepresentablyFlat u := flat_of_preservesFiniteLimits u
  refine ⟨?_, ?_⟩
  · exact Functor.sheafPullbackConstruction.preservesFiniteLimits u (Type u)
      PC.toGrothendieck PD.toGrothendieck
  · have : PreservesColimitsOfSize.{u, u}
        (u.sheafPullback (Type u) PC.toGrothendieck PD.toGrothendieck) :=
      (u.sheafAdjunctionContinuous (Type u) PC.toGrothendieck
        PD.toGrothendieck).leftAdjoint_preservesColimits
    exact PreservesColimitsOfSize.preservesFiniteColimits _

/-- **Statement 1, exactness form.** The substantive conclusion of Statement 1:
the induced functor `u_s : Sh(C) → Sh(D)` is exact (preserves finite limits and
finite colimits). The continuity instance needed to form `u_s` is derived from
quasi-continuity via Background Lemma A (introduced with `letI`) rather than
assumed. -/
theorem isExact_sheafPullback_of_isQuasiContinuous
    {C : Type u} [SmallCategory C] {D : Type u} [SmallCategory D]
    [HasPullbacks C] [HasPullbacks D] [HasTerminal C]
    (u : C ⥤ D) (PC : Pretopology C) (PD : Pretopology D)
    (hqc : IsQuasiContinuous u PC PD)
    (hterminal : PreservesLimitsOfShape (Discrete PEmpty.{1}) u)
    (hpullbacks : PreservesLimitsOfShape WalkingCospan u) :
    letI : u.IsContinuous PC.toGrothendieck PD.toGrothendieck :=
      isContinuous_of_isQuasiContinuous u PC PD hqc
    IsExact (u.sheafPullback (Type u) PC.toGrothendieck PD.toGrothendieck) :=
  isQuasiMorphismOfSites_of_isQuasiContinuous u PC PD hqc hterminal hpullbacks

end QuasiMorphismOfSites
