module

public import Mathlib.CategoryTheory.Sites.CoverLifting
public import Mathlib.CategoryTheory.Sites.Over
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck

/-!
# Recognising cocontinuity on the generators of the target topology

A functor `u : C ⥤ D` between sites `(C, J)` and `(D, K)` is cocontinuous when every `K`-covering
sieve of an object `u U` pulls back to a `J`-covering sieve of `U`. When `K` is the Grothendieck
topology generated by a precoverage, whose covering sieves are those of
`CategoryTheory.Precoverage.Saturate`, cocontinuity is checked on the covering families of the
precoverage.

## Main results

* `CategoryTheory.Functor.functorPullback_pullback_mem_of_saturate`: the inductive statement —
  if the sieve generated by every covering family of the precoverage pulls back to a covering
  sieve *after an arbitrary further base change*, then so does every sieve in the generated
  topology.
* `CategoryTheory.Functor.isCocontinuous_toGrothendieck_of_forall_pullback`: consequently `u` is
  cocontinuous for the generated topology.
* `CategoryTheory.Functor.functorPullback_eq_functorPullback_overEquiv` and
  `CategoryTheory.Functor.isCocontinuous_over`: a functor into a slice category `Over X₀` is
  cocontinuous for the localized topology as soon as its composite with the forgetful functor
  is cocontinuous for the ambient topology.
-/

@[expose] public section

open CategoryTheory

namespace CategoryTheory.Functor

universe v₁ v₂ u₁ u₂

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]
  (u : C ⥤ D) (J : GrothendieckTopology C) (K : Precoverage D)

/-- If for every object `T` of `C`, every morphism `g : u.obj T ⟶ X` of `D` and every covering
family `R` of `X` in the precoverage `K` the sieve `(Sieve.generate R).pullback g` pulls back
along `u` to a `J`-covering sieve of `T`, then the same holds for every sieve of the
Grothendieck topology generated by `K`. -/
public theorem functorPullback_pullback_mem_of_saturate
    (h : ∀ (T : C) (X : D) (g : u.obj T ⟶ X) (R : Presieve X), R ∈ K X →
      ((Sieve.generate R).pullback g).functorPullback u ∈ J T)
    {X : D} {S : Sieve X} (hS : K.Saturate X S) :
    ∀ (T : C) (g : u.obj T ⟶ X), (S.pullback g).functorPullback u ∈ J T := by
  induction hS with
  | of X R hR => exact fun T g ↦ h T X g R hR
  | top X => exact fun T _ ↦ by simp
  | pullback X S _ Y f ih =>
      intro T g
      simpa only [Sieve.pullback_comp] using ih T (g ≫ f)
  | transitive X S R _ _ ih₁ ih₂ =>
      intro T g
      refine J.transitive (ih₁ T g) _ fun W k hk ↦ ?_
      have hW := ih₂ (show S (u.map k ≫ g) from hk) W (𝟙 (u.obj W))
      rw [Sieve.pullback_id] at hW
      refine J.superset_covering (fun V l hl ↦ ?_) hW
      have hl' : R (u.map l ≫ u.map k ≫ g) := hl
      simpa [Sieve.pullback_apply, Category.assoc] using hl'

/-- A functor is cocontinuous for the Grothendieck topology generated by a precoverage as soon
as the sieve generated by each covering family of the precoverage, base changed along an
arbitrary morphism out of an object in the image of the functor, pulls back to a covering
sieve. -/
public theorem isCocontinuous_toGrothendieck_of_forall_pullback
    (h : ∀ (T : C) (X : D) (g : u.obj T ⟶ X) (R : Presieve X), R ∈ K X →
      ((Sieve.generate R).pullback g).functorPullback u ∈ J T) :
    u.IsCocontinuous J K.toGrothendieck where
  cover_lift {T} {S} hS := by
    simpa only [Sieve.pullback_id] using
      functorPullback_pullback_mem_of_saturate u J K h hS T (𝟙 (u.obj T))

section Slice

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D] {X₀ : D}

/-- Pulling a sieve on `u.obj T` back along a functor `u : C ⥤ Over X₀` is the same as
transporting it to a sieve on the underlying object and pulling that back along the composite
of `u` with the forgetful functor. -/
public theorem functorPullback_eq_functorPullback_overEquiv (u : C ⥤ Over X₀) {T : C}
    (R : Sieve (u.obj T)) :
    R.functorPullback u =
      (Sieve.overEquiv (u.obj T) R).functorPullback (u ⋙ Over.forget X₀) := by
  ext T' k
  show R (u.map k) ↔ Sieve.overEquiv (u.obj T) R ((u.map k).left)
  rw [← Sieve.overEquiv_symm_iff, OrderIso.symm_apply_apply]

/-- A functor into a slice category is cocontinuous for the localized topology on the slice as
soon as its composite with the forgetful functor is cocontinuous for the ambient topology. -/
public theorem isCocontinuous_over (u : C ⥤ Over X₀) (J : GrothendieckTopology C)
    (K : GrothendieckTopology D) [(u ⋙ Over.forget X₀).IsCocontinuous J K] :
    u.IsCocontinuous J (K.over X₀) where
  cover_lift {T} {R} hR := by
    rw [functorPullback_eq_functorPullback_overEquiv u R]
    exact IsCocontinuous.cover_lift (G := u ⋙ Over.forget X₀) (J := J) (K := K)
      ((K.mem_over_iff R).1 hR)

end Slice

end CategoryTheory.Functor
