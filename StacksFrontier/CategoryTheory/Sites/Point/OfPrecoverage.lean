module

public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import StacksFrontier.CategoryTheory.Sites.Point.OfPreservesFiniteLimits

/-!
# Points of a topology presented by a precoverage

A point `CategoryTheory.GrothendieckTopology.Point` of a Grothendieck topology asks for joint
surjectivity of the fibre functor on every covering sieve. For the topology generated by a
precoverage, and a fibre functor whose category of elements is cofiltered, it suffices to check
joint surjectivity on the covering families of the precoverage.

## Main results

* `CategoryTheory.Functor.CoveringJointlySurjective.of_precoverage` — joint surjectivity on
  the presenting families implies joint surjectivity on all covering sieves of the generated
  topology.
* `CategoryTheory.GrothendieckTopology.Point.ofPrecoverage` — the resulting point of the
  generated topology.
-/

@[expose] public section

namespace CategoryTheory

open Limits Opposite

universe w v u

variable {C : Type u} [Category.{v} C]

namespace Functor.CoveringJointlySurjective

/-- Joint surjectivity of a fibre functor over the covering families presenting a
precoverage implies joint surjectivity over every covering sieve of the generated
Grothendieck topology, when the category of elements of the fibre functor is cofiltered. -/
public theorem of_precoverage {u : C ⥤ Type w} [IsCofiltered u.Elements] {K : Precoverage C}
    (h : ∀ {X : C} (R : Presieve X), R ∈ K X → ∀ x : u.obj X,
      ∃ (Y : C) (f : Y ⟶ X) (_ : R f) (y : u.obj Y), u.map f y = x) :
    u.CoveringJointlySurjective K.toGrothendieck := by
  intro X R hR
  rw [Precoverage.mem_toGrothendieck_iff] at hR
  induction hR with
  | of X R hR =>
    intro x
    obtain ⟨Y, f, hf, y, hy⟩ := h R hR x
    exact ⟨Y, f, ⟨Y, 𝟙 Y, f, hf, Category.id_comp f⟩, y, hy⟩
  | top X => exact fun x => ⟨X, 𝟙 X, trivial, x, by simp⟩
  | pullback X S _ Y g ih =>
    intro x
    obtain ⟨Z, f, hf, z, hz⟩ := ih (u.map g x)
    let A : u.Elements := u.elementsMk Z z
    let B : u.Elements := u.elementsMk Y x
    let W := IsCofiltered.min A B
    let p : W ⟶ A := IsCofiltered.minToLeft A B
    let q : W ⟶ B := IsCofiltered.minToRight A B
    let T : u.Elements := u.elementsMk X (u.map g x)
    let α : W ⟶ T := p ≫ Functor.Elements.homMk (y := T) f hz
    let β : W ⟶ T := q ≫ Functor.Elements.homMk (y := T) g rfl
    let e : IsCofiltered.eq α β ⟶ W := IsCofiltered.eqHom α β
    have he : e.hom ≫ p.hom ≫ f = e.hom ≫ q.hom ≫ g :=
      congrArg Functor.Elements.Hom.hom (IsCofiltered.eq_condition α β)
    refine ⟨_, (e ≫ q).hom, ?_, (IsCofiltered.eq α β).val, (e ≫ q).map_val⟩
    show S ((e.hom ≫ q.hom) ≫ g)
    rw [Category.assoc, ← he, ← Category.assoc]
    exact S.downward_closed hf _
  | transitive X S R _ _ ih₁ ih₂ =>
    intro x
    obtain ⟨Y, f, hf, y, hy⟩ := ih₁ x
    obtain ⟨Z, g, hg, z, hz⟩ := ih₂ hf y
    exact ⟨Z, g ≫ f, hg, z, by simp [hz, hy]⟩

end Functor.CoveringJointlySurjective

namespace GrothendieckTopology.Point

/-- A fibre functor with cofiltered, initially small category of elements which is jointly
surjective over the covering families presenting a precoverage is a point of the generated
Grothendieck topology. -/
public def ofPrecoverage (u : C ⥤ Type w) [IsCofiltered u.Elements]
    [InitiallySmall.{w} u.Elements] {K : Precoverage C}
    (h : ∀ {X : C} (R : Presieve X), R ∈ K X → ∀ x : u.obj X,
      ∃ (Y : C) (f : Y ⟶ X) (_ : R f) (y : u.obj Y), u.map f y = x) :
    Point.{w} K.toGrothendieck where
  fiber := u
  jointly_surjective R hR x := Functor.CoveringJointlySurjective.of_precoverage h R hR x

/-- The fibre functor of `GrothendieckTopology.Point.ofPrecoverage u h` is `u`. -/
@[simp]
public lemma ofPrecoverage_fiber (u : C ⥤ Type w) [IsCofiltered u.Elements]
    [InitiallySmall.{w} u.Elements] {K : Precoverage C}
    (h : ∀ {X : C} (R : Presieve X), R ∈ K X → ∀ x : u.obj X,
      ∃ (Y : C) (f : Y ⟶ X) (_ : R f) (y : u.obj Y), u.map f y = x) :
    (ofPrecoverage u h).fiber = u := rfl

end GrothendieckTopology.Point

end CategoryTheory

end
