module

public import Mathlib.CategoryTheory.Adjunction.Restrict
public import Mathlib.CategoryTheory.Sites.Coverage
public import Mathlib.CategoryTheory.Sites.LeftExact
public import StacksFrontier.CategoryTheory.Sites.Point.StalkExact
public import StacksFrontier.CategoryTheory.Sites.Point.StalkLeftAdjoint

/-!
# Points of a site in the sense of the Stacks project, and their stalks

Stacks (Tag 00Y5) defines a *point* of a site `𝒞` to be a functor `u : 𝒞 ⥤ Sets` such that

1. for every covering `{U_i → U}` the map `∐ u(U_i) → u(U)` is surjective;
2. for every covering `{U_i → U}` and every morphism `V → U` the maps
   `u(U_i ×_U V) → u(U_i) ×_{u(U)} u(V)` are bijective;
3. the stalk functor `Sh(𝒞) ⥤ Sets`, `F ↦ F_p`, is left exact,

where the stalk `F_p` is the colimit of the sections of `F` over the opposite of the category of
elements of `u` (Stacks 04EH), a colimit that is not assumed to be filtered. This file defines
that notion, `CategoryTheory.Precoverage.Point`, and proves Stacks 04EN for it: the stalk of a
presheaf agrees with the stalk of its sheafification, and both stalk functors are exact and
commute with arbitrary colimits.

## The site

A site in the sense of the source (Stacks 00VH) is a category with a set of covering families,
closed under isomorphisms and composition, and such that a covering `{U_i → U}` can be pulled
back along any `V → U`: the fibre products `U_i ×_U V` exist and `{U_i ×_U V → V}` is again a
covering. Here it is a `CategoryTheory.Precoverage K` on a small category `C` with the classes
`K.HasPullbacks` (the fibre products exist) and `K.IsStableUnderBaseChange` (their families are
coverings); a sheaf on the site is a sheaf for the Grothendieck topology `K.toGrothendieck`
generated by `K`, which by `Presieve.isSheaf_coverage` is the same as satisfying the sheaf
condition for every covering family of `K` (Stacks 00VM). Closure under isomorphisms and under
composition is not used anywhere, so it is not assumed.

## Main definitions

* `CategoryTheory.Precoverage.Point`: a point of the site `(C, K)` (Stacks 00Y5).
* `CategoryTheory.Precoverage.Point.presheafStalk`, `CategoryTheory.Precoverage.Point.sheafStalk`:
  the stalk functors on presheaves and sheaves of sets (Stacks 04EH).
* `CategoryTheory.Precoverage.Point.sheafPushforward`: the skyscraper functor `u^s` of Stacks 00Y8,
  and `CategoryTheory.Precoverage.Point.sheafAdjunction`, its adjunction with the stalk functor.

## Main results

* `CategoryTheory.Precoverage.Point.isIso_stalkSheafificationComparison`: Stacks 04EN (1).
* `CategoryTheory.Precoverage.Point.sheafStalk_exact_preservesColimits`: Stacks 04EN (2).
* `CategoryTheory.Precoverage.Point.presheafStalk_exact_preservesColimits`: Stacks 04EN (3).

## Implementation notes

The proof is the source's. Conditions (1) and (2) make `u^p E : U ↦ Map(u(U), E)` a sheaf
(`isSheaf_presheafPushforward`, the first assertion of Stacks 00Y8), so the adjunction between
the presheaf stalk functor and `u^p` (Stacks 00Y7) restricts to sheaves and the stalk of `F` is
the stalk of `F^#` (`main_theorem00Y8`). Both stalk functors are therefore left adjoints and
commute with all colimits; the sheaf stalk functor is left exact by condition (3), and the
presheaf stalk functor is isomorphic to sheafification followed by the sheaf stalk functor, a
composite of left exact functors.

## References

* [Stacks Project, Tag 00Y5](https://stacks.math.columbia.edu/tag/00Y5)
* [Stacks Project, Tag 00Y8](https://stacks.math.columbia.edu/tag/00Y8)
* [Stacks Project, Tag 04EN](https://stacks.math.columbia.edu/tag/04EN)
-/

@[expose] public section

open CategoryTheory Limits Opposite

universe w' w'' u

namespace CategoryTheory.Precoverage

variable {C : Type u} [SmallCategory C] (K : Precoverage C) [K.HasPullbacks]

/-- A *point* of the site `(C, K)` (Stacks 00Y5): a functor `u : C ⥤ Type u` such that

1. for every covering `R` of `X` the elements of `u(X)` all come from the members of `R`, i.e.
   `∐ u(U_i) → u(X)` is surjective;
2. for every covering `R` of `X`, every member `f : Y ⟶ X` of `R` and every `g : Z ⟶ X`, the map
   `u(Y ×_X Z) → u(Y) ×_{u(X)} u(Z)` is bijective;
3. the stalk functor `F ↦ F_p` on sheaves of sets is left exact, the stalk being the colimit
   `PresheafPushforwardStalkAdjunction.presheafStalk u` of the sections of `F` over the opposite
   of the category of elements of `u` (Stacks 04EH). -/
@[stacks 00Y5 "The source's definition, for a site given by its covering families."]
structure Point where
  /-- The functor `u : C ⥤ Sets` of the point. -/
  fiber : C ⥤ Type u
  /-- Condition (1): coverings are jointly surjective on `u`. -/
  jointly_surjective {X : C} (R : Presieve X) (hR : R ∈ K X) (x : fiber.obj X) :
    ∃ (Y : C) (f : Y ⟶ X) (_ : R f) (y : fiber.obj Y), fiber.map f y = x
  /-- Condition (2): `u` turns the fibre products `U_i ×_U V` of a covering into fibre products
  of sets. -/
  pullback_bijective {X : C} (R : Presieve X) (hR : R ∈ K X) {Y Z : C} (f : Y ⟶ X) (hf : R f)
    (g : Z ⟶ X) :
    haveI := K.hasPullbacks_of_mem g hR
    haveI := Presieve.hasPullback g hf
    Function.Bijective (fun w : fiber.obj (pullback f g) =>
      (⟨(fiber.map (pullback.fst f g) w, fiber.map (pullback.snd f g) w), by
          simp only [← Functor.map_comp_apply, pullback.condition]⟩ :
        {q : fiber.obj Y × fiber.obj Z // fiber.map f q.1 = fiber.map g q.2}))
  /-- Condition (3): the stalk functor on sheaves of sets is left exact. -/
  preservesFiniteLimits_sheafStalk :
    PreservesFiniteLimits (sheafToPresheaf K.toGrothendieck (Type u) ⋙
      PresheafPushforwardStalkAdjunction.presheafStalk fiber)

namespace Point

variable {K} (p : K.Point)

/-- The stalk functor `F ↦ F_p` on presheaves of sets at a point `p` (Stacks 04EH): the colimit
of the sections of `F` over the opposite of the category of elements of `p.fiber`. -/
noncomputable abbrev presheafStalk : (Cᵒᵖ ⥤ Type u) ⥤ Type u :=
  PresheafPushforwardStalkAdjunction.presheafStalk p.fiber

/-- The stalk functor `F ↦ F_p` on sheaves of sets at a point `p`. -/
noncomputable abbrev sheafStalk : Sheaf K.toGrothendieck (Type u) ⥤ Type u :=
  sheafToPresheaf K.toGrothendieck (Type u) ⋙ p.presheafStalk

/-- Two elements of members of a covering with the same image in `u(X)` carry the same value of a
compatible family of sections of `u^p E`; this is where condition (2) enters. -/
theorem compatible_apply_eq_of_map_eq {X : C} (R : Presieve X) (hR : R ∈ K X) (E : Type u)
    (s : Presieve.FamilyOfElements
      ((PresheafPushforwardStalkAdjunction.presheafPushforward p.fiber).obj E) R)
    (hs : s.Compatible) {Y Y' : C} (f : Y ⟶ X) (hf : R f) (f' : Y' ⟶ X) (hf' : R f')
    (y : p.fiber.obj Y) (y' : p.fiber.obj Y') (h : p.fiber.map f y = p.fiber.map f' y') :
    s f hf y = s f' hf' y' := by
  have := K.hasPullbacks_of_mem f' hR
  have := Presieve.hasPullback f' hf
  obtain ⟨w, hw⟩ := (p.pullback_bijective R hR f hf f').2 ⟨(y, y'), h⟩
  have h₁ : p.fiber.map (pullback.fst f f') w = y := congrArg (fun q => q.1.1) hw
  have h₂ : p.fiber.map (pullback.snd f f') w = y' := congrArg (fun q => q.1.2) hw
  have := congrFun (hs (pullback.fst f f') (pullback.snd f f') hf hf' pullback.condition) w
  rw [PresheafPushforwardStalkAdjunction.presheafPushforward_obj_map_apply,
    PresheafPushforwardStalkAdjunction.presheafPushforward_obj_map_apply] at this
  rw [← h₁, ← h₂]
  exact this

/-- For a point `p` and a set `E`, the presheaf `u^p E : U ↦ Map(u(U), E)` satisfies the sheaf
condition for every covering family of `K`. -/
theorem isSheafFor_presheafPushforward {X : C} (R : Presieve X) (hR : R ∈ K X) (E : Type u) :
    Presieve.IsSheafFor
      ((PresheafPushforwardStalkAdjunction.presheafPushforward p.fiber).obj E) R := by
  intro s hs
  choose Y f hf y hy using p.jointly_surjective R hR
  refine ⟨fun a => s (f a) (hf a) (y a), ?_, ?_⟩
  · intro Z g hg
    funext b
    exact p.compatible_apply_eq_of_map_eq R hR E s hs _ _ g hg _ b (hy _)
  · intro t ht
    funext a
    have h := congrFun (ht (f a) (hf a)) (y a)
    rw [PresheafPushforwardStalkAdjunction.presheafPushforward_obj_map_apply, Quiver.Hom.unop_op,
      hy a] at h
    exact h

variable [K.IsStableUnderBaseChange]

/-- **Stacks 00Y8 (1)** for a point of the site: `u^p E` is a sheaf for every set `E`. -/
theorem isSheaf_presheafPushforward (E : Type u) :
    Presheaf.IsSheaf K.toGrothendieck
      ((PresheafPushforwardStalkAdjunction.presheafPushforward p.fiber).obj E) := by
  rw [isSheaf_iff_isSheaf_of_type, ← Precoverage.toGrothendieck_toCoverage,
    Presieve.isSheaf_coverage]
  intro X R hR
  exact p.isSheafFor_presheafPushforward R hR E

/-- The skyscraper functor `u^s : Sets ⥤ Sh(C)`, `E ↦ (U ↦ Map(u(U), E))`, of a point. -/
noncomputable def sheafPushforward : Type u ⥤ Sheaf K.toGrothendieck (Type u) :=
  ObjectProperty.lift _ (PresheafPushforwardStalkAdjunction.presheafPushforward p.fiber)
    p.isSheaf_presheafPushforward

/-- **Stacks 00Y8 (2)** for a point of the site: the stalk functor on sheaves is left adjoint to
the skyscraper functor `u^s`. -/
noncomputable def sheafAdjunction : p.sheafStalk ⊣ p.sheafPushforward :=
  (PresheafPushforwardStalkAdjunction.adjunction p.fiber).restrictFullyFaithful
    (fullyFaithfulSheafToPresheaf _ _) (Functor.FullyFaithful.id _)
    (Functor.rightUnitor _).symm
    (Functor.leftUnitor _ ≪≫
      (ObjectProperty.liftCompιIso _ _ p.isSheaf_presheafPushforward).symm)

/-- The comparison from the stalk of a presheaf of sets at `p` to the stalk of its
sheafification, induced by the unit `F ⟶ F^#` of sheafification. -/
noncomputable def stalkSheafificationComparison :
    p.presheafStalk ⟶ presheafToSheaf K.toGrothendieck (Type u) ⋙ p.sheafStalk :=
  Functor.whiskerRight (toSheafification K.toGrothendieck (Type u)) p.presheafStalk

/-- **Stacks 04EN (1).** For a point `p` of the site `(C, K)`, the canonical map `F_p → (F^#)_p`
from the stalk of a presheaf of sets to the stalk of its sheafification is an isomorphism,
naturally in `F`. -/
@[stacks 04EN "(1), for a point of a site in the source's sense (Tag 00Y5)"]
theorem isIso_stalkSheafificationComparison : IsIso p.stalkSheafificationComparison := by
  have : ∀ F, IsIso (p.stalkSheafificationComparison.app F) := fun F => by
    change IsIso (p.presheafStalk.map (toSheafify K.toGrothendieck F))
    have hb := main_theorem00Y8 K.toGrothendieck p.presheafStalk
      (PresheafPushforwardStalkAdjunction.presheafPushforward p.fiber)
      (PresheafPushforwardStalkAdjunction.adjunction p.fiber) p.isSheaf_presheafPushforward F
    obtain ⟨g, hg⟩ := (hb _).2 (𝟙 _)
    refine ⟨g, hg, (hb _).1 ?_⟩
    change _ ≫ g ≫ _ = _ ≫ 𝟙 _
    rw [reassoc_of% hg, Category.comp_id]
  exact NatIso.isIso_of_isIso_app _

/-- The isomorphism `F_p ≅ (F^#)_p` of Stacks 04EN (1), natural in the presheaf `F`. -/
noncomputable def stalkSheafificationIso :
    p.presheafStalk ≅ presheafToSheaf K.toGrothendieck (Type u) ⋙ p.sheafStalk :=
  haveI := p.isIso_stalkSheafificationComparison
  asIso p.stalkSheafificationComparison

instance : PreservesFiniteLimits p.sheafStalk := p.preservesFiniteLimits_sheafStalk

instance : PreservesColimitsOfSize.{w', w''} p.sheafStalk :=
  p.sheafAdjunction.leftAdjoint_preservesColimits

instance : PreservesColimitsOfSize.{w', w''} p.presheafStalk :=
  (PresheafPushforwardStalkAdjunction.adjunction p.fiber).leftAdjoint_preservesColimits

instance : PreservesFiniteLimits p.presheafStalk :=
  haveI : PreservesFiniteLimits (presheafToSheaf K.toGrothendieck (Type u)) := inferInstance
  haveI : PreservesFiniteLimits (presheafToSheaf K.toGrothendieck (Type u) ⋙ p.sheafStalk) :=
    comp_preservesFiniteLimits _ _
  preservesFiniteLimits_of_natIso p.stalkSheafificationIso.symm

/-- **Stacks 04EN (2).** For a point `p` of the site `(C, K)`, the stalk functor
`Sh(C) ⥤ Sets`, `F ↦ F_p`, is exact (it commutes with finite limits and finite colimits) and
commutes with arbitrary colimits. -/
@[stacks 04EN "(2), for a point of a site in the source's sense (Tag 00Y5)"]
theorem sheafStalk_exact_preservesColimits :
    (PreservesFiniteLimits p.sheafStalk ∧ PreservesFiniteColimits p.sheafStalk) ∧
      PreservesColimitsOfSize.{w', w''} p.sheafStalk :=
  haveI : PreservesColimitsOfSize.{0, 0} p.sheafStalk := inferInstance
  ⟨⟨inferInstance, PreservesColimitsOfSize.preservesFiniteColimits _⟩, inferInstance⟩

/-- **Stacks 04EN (3).** For a point `p` of the site `(C, K)`, the stalk functor
`PSh(C) ⥤ Sets`, `F ↦ F_p`, is exact (it commutes with finite limits and finite colimits) and
commutes with arbitrary colimits. -/
@[stacks 04EN "(3), for a point of a site in the source's sense (Tag 00Y5)"]
theorem presheafStalk_exact_preservesColimits :
    (PreservesFiniteLimits p.presheafStalk ∧ PreservesFiniteColimits p.presheafStalk) ∧
      PreservesColimitsOfSize.{w', w''} p.presheafStalk :=
  haveI : PreservesColimitsOfSize.{0, 0} p.presheafStalk := inferInstance
  ⟨⟨inferInstance, PreservesColimitsOfSize.preservesFiniteColimits _⟩, inferInstance⟩

end Point

end CategoryTheory.Precoverage
