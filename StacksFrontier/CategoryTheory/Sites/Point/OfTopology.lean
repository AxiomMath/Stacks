module

public import Mathlib.CategoryTheory.Sites.Point.Skyscraper
public import Mathlib.CategoryTheory.Limits.Preserves.Ulift
public import StacksCore.Tactic.StacksAttribute

/-!
# Points of a topology

Let `C` be a category and `u : C ⥤ Type w` a functor. Following Stacks (Section 00Y3), the
*stalk* of a presheaf of sets `F` at `p = u` is
`F_p = colim_{(U, x)} F(U)`, the colimit over the opposite of the category of neighbourhoods
`(U, x)` of `p` (`U : C`, `x : u U`), i.e. of the category of elements `u.Elements`. Its
elements are the triples `(U, x, s)` with `s : F(U)`, modulo the equivalence relation generated
by `(U, x, s) ∼ (V, y, F(α) s)` for `α : V ⟶ U` with `u(α) y = x`. We implement it literally as
this quotient, `Functor.ColimitType`, which needs no existence hypothesis on colimits.

Stacks Definition 00ZT: for a topology `J` on `C`, a *point* of the topology is a functor
`u : C ⥤ Type w` such that

1. for every covering sieve `S` on `U`, the map `S_p → (h_U)_p` is surjective;
2. the stalk functor `Sh(C) ⥤ Sets`, `F ↦ F_p`, is exact, that is, it commutes with finite
   limits and with finite colimits (Stacks Definition 0034).

## Main definitions

* `CategoryTheory.Functor.pointStalk u`: the stalk functor `F ↦ F_p` on presheaves of sets.
* `CategoryTheory.GrothendieckTopology.IsPointOfTopology J u`: Stacks' notion of a point of
  the topology `J`.

## Main results

* `CategoryTheory.GrothendieckTopology.Point.isPointOfTopology`: the fiber functor of a point of
  the site `(C, J)` in Mathlib's sense (`GrothendieckTopology.Point`, which also assumes the
  category of elements cofiltered and initially small) is a point of the topology `J` in Stacks'
  sense.
-/

@[expose] public section

universe w' w v u

namespace CategoryTheory

open Limits Opposite

variable {C : Type u} [Category.{v} C]

namespace Functor

variable (u : C ⥤ Type w)

/-- The stalk `F_p` at `p = u : C ⥤ Type w` of a presheaf of sets `F` (Stacks 04EH): the
colimit of `F(U)` over the opposite of the category of neighbourhoods `(U, x)`, `x : u U`, of
`p`, realised as triples `(U, x, s)`, `s : F(U)`, modulo the equivalence relation generated by
`(U, x, s) ∼ (V, y, F(α) s)` for `α : (V, y) ⟶ (U, x)`. This is the stalk functor
`PSh(C) ⥤ Sets`. -/
@[simps obj]
def pointStalk : (Cᵒᵖ ⥤ Type w') ⥤ Type (max u w w') where
  obj F := ((Functor.Elements.π u).op ⋙ F).ColimitType
  map {F G} φ := ↾(((Functor.Elements.π u).op ⋙ F).descColimitType
    ((((Functor.Elements.π u).op ⋙ G).coconeTypes).precompose
      (G := (Functor.Elements.π u).op ⋙ F) (fun j x ↦ φ.app (op j.unop.1) x)
      (fun f ↦ by funext x; exact NatTrans.naturality_apply φ _ x)))
  map_id F := by
    ext t
    obtain ⟨j, x, rfl⟩ := ((Functor.Elements.π u).op ⋙ F).ιColimitType_jointly_surjective t
    rfl
  map_comp φ ψ := by
    ext t
    obtain ⟨j, x, rfl⟩ := ((Functor.Elements.π u).op ⋙ _).ιColimitType_jointly_surjective t
    rfl

lemma pointStalk_map_ιColimitType {F G : Cᵒᵖ ⥤ Type w'} (φ : F ⟶ G) (j : u.Elementsᵒᵖ)
    (x : F.obj (op j.unop.1)) :
    (u.pointStalk.map φ) (((Functor.Elements.π u).op ⋙ F).ιColimitType j x) =
      ((Functor.Elements.π u).op ⋙ G).ιColimitType j (φ.app (op j.unop.1) x) :=
  rfl

end Functor

namespace GrothendieckTopology

variable (J : GrothendieckTopology C)

/-- **Stacks 00ZT.** A *point of the topology* `J` on `C` is a functor `u : C ⥤ Type w` such
that

1. for every covering sieve `S` on `U`, the map `S_p → (h_U)_p` induced on stalks by the
   inclusion `S ⟶ h_U` is surjective;
2. the stalk functor `Sh(C) ⥤ Sets`, `F ↦ F_p`, on sheaves of sets `Type w`, is exact: it
   commutes with finite limits and with finite colimits (Stacks 0034).

The stalk is `Functor.pointStalk u`, the colimit over the neighbourhoods of `p = u`. -/
@[stacks 00ZT "Stacks' definition of a point of a topology, on `u : C ⥤ Type w` with the
  stalk taken as the colimit over the category of elements of `u`; a Mathlib point gives one,
  see `GrothendieckTopology.Point.isPointOfTopology`."]
structure IsPointOfTopology (u : C ⥤ Type w) : Prop where
  /-- For a covering sieve `S` on `U`, the map `S_p → (h_U)_p` is surjective. -/
  pointStalk_map_functorInclusion_surjective {U : C} (S : Sieve U) (hS : S ∈ J U) :
    Function.Surjective (u.pointStalk.map S.functorInclusion)
  /-- The stalk functor on sheaves of sets is left exact. -/
  preservesFiniteLimits : PreservesFiniteLimits (sheafToPresheaf J (Type w) ⋙ u.pointStalk)
  /-- The stalk functor on sheaves of sets is right exact. -/
  preservesFiniteColimits : PreservesFiniteColimits (sheafToPresheaf J (Type w) ⋙ u.pointStalk)

namespace Point

variable {J} (Φ : Point.{w} J)

/-- For a point `Φ` of the site `(C, J)`, the stalk `F_p` of a presheaf of sets at `p = Φ.fiber`
is identified with Mathlib's fiber `Φ.presheafFiber.obj F`, up to raising universes. -/
noncomputable def pointStalkIsoPresheafFiber :
    (Φ.fiber.pointStalk : (Cᵒᵖ ⥤ Type w) ⥤ Type (max u w)) ≅
      Φ.presheafFiber ⋙ uliftFunctor.{u, w} :=
  NatIso.ofComponents
    (fun F ↦ ((Types.colimitEquivColimitType
      ((Functor.Elements.π Φ.fiber).op ⋙ F)).symm.trans
        (Equiv.ulift (α := Φ.presheafFiber.obj F)).symm).toIso)
    (fun {F G} φ ↦ by
      ext t
      obtain ⟨j, x, rfl⟩ :=
        ((Functor.Elements.π Φ.fiber).op ⋙ F).ιColimitType_jointly_surjective t
      apply ULift.ext
      change (Types.colimitEquivColimitType _).symm (Quot.mk _ ⟨j, φ.app _ x⟩) =
        Φ.presheafFiber.map φ ((Types.colimitEquivColimitType _).symm (Quot.mk _ ⟨j, x⟩))
      rw [Types.colimitEquivColimitType_symm_apply, Types.colimitEquivColimitType_symm_apply]
      exact (Φ.toPresheafFiber_naturality_apply φ j.unop.1 j.unop.2 x).symm)

/-- The stalk functor `F ↦ F_p` on sheaves of sets at `p = Φ.fiber` is Mathlib's
`Φ.sheafFiber`, up to raising universes. -/
noncomputable def sheafFiberCompUliftIsoPointStalk :
    Φ.sheafFiber (A := Type w) ⋙ uliftFunctor.{u, w} ≅
      sheafToPresheaf J (Type w) ⋙ Φ.fiber.pointStalk :=
  (Functor.isoWhiskerLeft (sheafToPresheaf J (Type w)) Φ.pointStalkIsoPresheafFiber ≪≫
    (Functor.associator _ _ _).symm).symm

/-- A point of the site `(C, J)` in Mathlib's sense (`GrothendieckTopology.Point`) gives a point
of the topology `J` in the sense of Stacks 00ZT: its fiber functor `Φ.fiber` satisfies the
covering-sieve surjectivity condition, and the stalk functor on sheaves of sets is exact. -/
theorem isPointOfTopology [LocallySmall.{w} C] : J.IsPointOfTopology Φ.fiber where
  pointStalk_map_functorInclusion_surjective {U} S hS t := by
    obtain ⟨j, f, rfl⟩ :=
      ((Functor.Elements.π Φ.fiber).op ⋙ yoneda.obj U).ιColimitType_jointly_surjective t
    obtain ⟨W, g, hg, z, hz⟩ := Φ.jointly_surjective _ (J.pullback_stable f hS) j.unop.2
    let k : Φ.fiber.elementsMk W z ⟶ j.unop := ⟨g, hz⟩
    refine ⟨((Functor.Elements.π Φ.fiber).op ⋙ S.functor).ιColimitType
      (op (Φ.fiber.elementsMk W z)) ⟨g ≫ f, hg⟩, ?_⟩
    exact ((Functor.Elements.π Φ.fiber).op ⋙ yoneda.obj U).ιColimitType_map k.op f
  preservesFiniteLimits :=
    preservesFiniteLimits_of_natIso Φ.sheafFiberCompUliftIsoPointStalk
  preservesFiniteColimits :=
    preservesFiniteColimits_of_natIso Φ.sheafFiberCompUliftIsoPointStalk

end Point

end GrothendieckTopology

end CategoryTheory
