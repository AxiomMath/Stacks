module

public import Mathlib.CategoryTheory.Limits.Shapes.Products
public import Mathlib.CategoryTheory.Limits.Types.Pullbacks
public import Mathlib.CategoryTheory.Sites.Coverage
public import Mathlib.CategoryTheory.Sites.Localization
public import StacksFrontier.CategoryTheory.Sites.Point.StalkLeftAdjoint

/-!
# Skyscraper presheaves of a functor to sets

Let `C` be a site whose coverings are the families of a precoverage `K` that has the fibre
products of its coverings and is stable under base change (the axioms of a site in the sense of
Stacks 00VH), and let `u : C ⥤ Type w` be a functor such that

1. for every covering `{U_i → U}` the map `∐ u(U_i) → u(U)` is surjective, and
2. for every covering `{U_i → U}` and every morphism `V → U` the maps
   `u(U_i ×_U V) → u(U_i) ×_{u(U)} u(V)` are bijective,

that is, conditions (1) and (2) of a point of a site (Stacks 00Y5). Condition (3) of 00Y5 is not
assumed. For an object `M` of a category `A` with products, the *skyscraper presheaf*
`u^p M : U ↦ ∏_{x ∈ u(U)} M` is then a sheaf, and the stalk functor
`F ↦ F_p = colim_{(U, x) ∈ Nbh(p)ᵒᵖ} F(U)` (`CategoryTheory.elementColimit u A`) satisfies
`Mor_A(F_p, M) = Mor_{PSh(C, A)}(F, u^p M)`. Hence, by the argument of Stacks 00Y8, the stalk
functor inverts every morphism of presheaves that becomes an isomorphism after sheafification;
in particular `F_p = (F^#)_p`.

Nothing here assumes that the category of neighbourhoods of `u` is cofiltered, so these results
apply to the points of Stacks 00Y5 directly, without passing through Mathlib's
`CategoryTheory.GrothendieckTopology.Point`.

## Main results

* `CategoryTheory.ElementColimit.isSheaf_skyscraperPresheaf`: `u^p M` is a sheaf.
* `CategoryTheory.ElementColimit.skyscraperPresheafHomEquiv`:
  `Mor(F_p, M) ≃ Mor(F, u^p M)`.
* `CategoryTheory.ElementColimit.W_isInvertedBy_elementColimit`: the stalk functor inverts
  the morphisms of `J.W`.
* `CategoryTheory.ElementColimit.isIso_elementColimit_map_toSheafify`: `F_p ≅ (F^#)_p`.
-/

@[expose] public section

namespace CategoryTheory.ElementColimit

open Limits Opposite

universe w v t a b

variable {C : Type t} [Category.{v} C] (u : C ⥤ Type w) {A : Type a} [Category.{b} A]
  [HasProducts.{w} A]

/-- The skyscraper presheaf `u^p M : U ↦ ∏_{x ∈ u(U)} M` of a functor `u : C ⥤ Type w` with
value `M`; the restriction along `f : V ⟶ U` sends the factor at `u(f)(y)` to the factor at
`y`. -/
noncomputable abbrev skyscraperPresheaf (M : A) : Cᵒᵖ ⥤ A where
  obj U := ∏ᶜ fun (_ : u.obj U.unop) => M
  map f := Pi.lift fun y => Pi.π (fun (_ : u.obj _) => M) (u.map f.unop y)
  map_id U := by
    ext y
    simp
  map_comp f g := by
    ext y
    simp

@[reassoc (attr := simp)]
lemma skyscraperPresheaf_map_π (M : A) {U V : Cᵒᵖ} (f : U ⟶ V) (y : u.obj V.unop) :
    (skyscraperPresheaf u M).map f ≫ Pi.π _ y = Pi.π _ (u.map f.unop y) :=
  Pi.lift_comp_π _ _

variable {u}

private lemma exists_cospan_of_bijective {X Y₁ Y₂ : C} (f₁ : Y₁ ⟶ X) (f₂ : Y₂ ⟶ X)
    [HasPullback f₁ f₂] (h : Function.Bijective (pullbackComparison u f₁ f₂))
    (y₁ : u.obj Y₁) (y₂ : u.obj Y₂) (hy : u.map f₁ y₁ = u.map f₂ y₂) :
    ∃ z : u.obj (pullback f₁ f₂), u.map (pullback.fst f₁ f₂) z = y₁ ∧
      u.map (pullback.snd f₁ f₂) z = y₂ := by
  obtain ⟨z, hz⟩ := h.2 ((Types.pullbackIsoPullback (u.map f₁) (u.map f₂)).inv ⟨(y₁, y₂), hy⟩)
  refine ⟨z, ?_, ?_⟩
  · have := congrArg (pullback.fst (u.map f₁) (u.map f₂)) hz
    rwa [← ConcreteCategory.comp_apply, pullbackComparison_comp_fst,
      Types.pullbackIsoPullback_inv_fst_apply] at this
  · have := congrArg (pullback.snd (u.map f₁) (u.map f₂)) hz
    rwa [← ConcreteCategory.comp_apply, pullbackComparison_comp_snd,
      Types.pullbackIsoPullback_inv_snd_apply] at this

variable {K : Precoverage C} [K.HasPullbacks] [K.IsStableUnderBaseChange]

/-- **Stacks 0AI4** (the presheaf `U ↦ Map(u(U), M)` is a sheaf), for a category `A` with
products in place of topological spaces.

Let `u : C ⥤ Type w` satisfy conditions (1) and (2) of a point of a site (Stacks 00Y5) for the
coverings of a precoverage `K` with fibre products, stable under base change. Then for every
object `M` of `A` the skyscraper presheaf `U ↦ ∏_{x ∈ u(U)} M` is a sheaf for the topology
generated by `K`. This is the sheaf property of Stacks 00Y8 (1), with values in `A`. -/
theorem isSheaf_skyscraperPresheaf
    (h₁ : ∀ ⦃X : C⦄ (R : Presieve X), R ∈ K X → ∀ x : u.obj X,
      ∃ (Y : C) (f : Y ⟶ X) (_ : R f) (y : u.obj Y), u.map f y = x)
    (h₂ : ∀ ⦃X : C⦄ (R : Presieve X), R ∈ K X → ∀ ⦃Y Z : C⦄ (f : Y ⟶ X), R f →
      ∀ (g : Z ⟶ X) [HasPullback f g], Function.Bijective (pullbackComparison u f g))
    (M : A) :
    Presheaf.IsSheaf K.toGrothendieck (skyscraperPresheaf u M) := by
  intro E
  rw [Precoverage.isSheaf_toGrothendieck_iff_of_isStableUnderBaseChange]
  intro X R hR x hx
  -- The value of the family at a factor `y : u(Y)` depends only on the image of `y` in `u(X)`.
  have key : ∀ ⦃Y₁ Y₂ : C⦄ (f₁ : Y₁ ⟶ X) (f₂ : Y₂ ⟶ X) (hf₁ : R f₁) (hf₂ : R f₂)
      (y₁ : u.obj Y₁) (y₂ : u.obj Y₂), u.map f₁ y₁ = u.map f₂ y₂ →
      (x f₁ hf₁ : E ⟶ ∏ᶜ fun (_ : u.obj Y₁) => M) ≫ Pi.π (fun _ => M) y₁ =
        (x f₂ hf₂ : E ⟶ ∏ᶜ fun (_ : u.obj Y₂) => M) ≫ Pi.π (fun _ => M) y₂ := by
    intro Y₁ Y₂ f₁ f₂ hf₁ hf₂ y₁ y₂ hy
    have : R.HasPullbacks f₂ := K.hasPullbacks_of_mem f₂ hR
    have : HasPullback f₁ f₂ := Presieve.hasPullback f₂ hf₁
    obtain ⟨z, hz₁, hz₂⟩ := exists_cospan_of_bijective f₁ f₂ (h₂ R hR f₁ hf₁ f₂) y₁ y₂ hy
    have hc : (x f₁ hf₁ : E ⟶ ∏ᶜ fun (_ : u.obj Y₁) => M) ≫
          (skyscraperPresheaf u M).map (pullback.fst f₁ f₂).op =
        (x f₂ hf₂ : E ⟶ ∏ᶜ fun (_ : u.obj Y₂) => M) ≫
          (skyscraperPresheaf u M).map (pullback.snd f₁ f₂).op :=
      hx (pullback.fst f₁ f₂) (pullback.snd f₁ f₂) hf₁ hf₂ pullback.condition
    have := congrArg (· ≫ Pi.π (fun _ => M) z) hc
    simp only [Category.assoc, Pi.lift_comp_π, Quiver.Hom.unop_op] at this
    rwa [hz₁, hz₂] at this
  choose Y f hf y hy using h₁ R hR
  let t₀ : E ⟶ ∏ᶜ fun (_ : u.obj X) => M :=
    Pi.lift fun a => (x (f a) (hf a) : E ⟶ ∏ᶜ fun (_ : u.obj (Y a)) => M) ≫
      Pi.π (fun _ => M) (y a)
  refine ⟨t₀, ?_, fun (t : E ⟶ ∏ᶜ fun (_ : u.obj X) => M) ht => ?_⟩
  · intro Z g hg
    change t₀ ≫ (skyscraperPresheaf u M).map g.op = x g hg
    refine Pi.hom_ext _ _ fun b => ?_
    rw [Category.assoc, skyscraperPresheaf_map_π, Pi.lift_comp_π, Quiver.Hom.unop_op]
    exact key (f (u.map g b)) g (hf _) hg (y _) b (hy _)
  · refine Pi.hom_ext _ _ fun a => ?_
    have hta : t ≫ (skyscraperPresheaf u M).map (f a).op = x (f a) (hf a) := ht _ (hf a)
    rw [Pi.lift_comp_π, ← hta, Category.assoc, skyscraperPresheaf_map_π, Quiver.Hom.unop_op, hy]

variable (u)

section

variable [HasColimitsOfShape u.Elementsᵒᵖ A] {P Q : Cᵒᵖ ⥤ A} {M : A}

/-- The adjunction of Stacks 00Y7 with values in `A`: morphisms out of the stalk
`F_p = colim_{(U, x)} F(U)` correspond to morphisms of presheaves `F ⟶ u^p M`. -/
noncomputable def skyscraperPresheafHomEquiv :
    (colimit ((Functor.Elements.π u).op ⋙ P) ⟶ M) ≃ (P ⟶ skyscraperPresheaf u M) where
  toFun φ :=
    { app U := Pi.lift fun x =>
        colimit.ι ((Functor.Elements.π u).op ⋙ P) (op (u.elementsMk U.unop x)) ≫ φ
      naturality {U V} g := by
        refine Pi.hom_ext _ _ fun y => ?_
        rw [Category.assoc, Pi.lift_comp_π, Category.assoc, skyscraperPresheaf_map_π,
          Pi.lift_comp_π]
        let e : u.elementsMk V.unop y ⟶ u.elementsMk U.unop (u.map g.unop y) := ⟨g.unop, rfl⟩
        rw [← colimit.w ((Functor.Elements.π u).op ⋙ P) e.op, Category.assoc]
        rfl }
  invFun α := colimit.desc _
    { pt := M
      ι :=
        { app j := α.app (op j.unop.obj) ≫ Pi.π (fun _ => M) j.unop.val
          naturality {j k} g := by
            change P.map g.unop.hom.op ≫ α.app (op k.unop.obj) ≫ Pi.π (fun _ => M) k.unop.val =
              (α.app (op j.unop.obj) ≫ Pi.π (fun _ => M) j.unop.val) ≫ 𝟙 M
            rw [Category.comp_id, ← Category.assoc, α.naturality, Category.assoc,
              skyscraperPresheaf_map_π, Quiver.Hom.unop_op, Functor.Elements.Hom.map_val] } }
  left_inv φ := by
    refine colimit.hom_ext fun j => ?_
    rw [colimit.ι_desc]
    exact Pi.lift_comp_π _ _
  right_inv α := by
    ext U : 2
    refine Pi.hom_ext _ _ fun x => ?_
    rw [Pi.lift_comp_π, colimit.ι_desc]

lemma skyscraperPresheafHomEquiv_app_π (φ : colimit ((Functor.Elements.π u).op ⋙ P) ⟶ M)
    (U : Cᵒᵖ) (x : u.obj U.unop) :
    (skyscraperPresheafHomEquiv u φ).app U ≫ Pi.π (fun _ => M) x =
      colimit.ι ((Functor.Elements.π u).op ⋙ P) (op (u.elementsMk U.unop x)) ≫ φ :=
  Pi.lift_comp_π _ _

lemma skyscraperPresheafHomEquiv_naturality_left (f : P ⟶ Q)
    (g : colimit ((Functor.Elements.π u).op ⋙ Q) ⟶ M) :
    skyscraperPresheafHomEquiv u
        (colimMap (Functor.whiskerLeft (Functor.Elements.π u).op f) ≫ g) =
      f ≫ skyscraperPresheafHomEquiv u g := by
  ext U : 2
  refine Pi.hom_ext _ _ fun x => ?_
  rw [NatTrans.comp_app, Category.assoc, skyscraperPresheafHomEquiv_app_π,
    skyscraperPresheafHomEquiv_app_π, ι_colimMap_assoc]
  rfl

end

variable {u}

/-- **Stacks 00Y8 / 0AI4**, with values in `A`: for `u : C ⥤ Type w` satisfying conditions (1)
and (2) of a point of a site (Stacks 00Y5), the stalk functor `F ↦ F_p` inverts every morphism
of presheaves which becomes an isomorphism after sheafification (the class `J.W`). -/
theorem W_isInvertedBy_elementColimit [HasColimitsOfShape u.Elementsᵒᵖ A]
    (h₁ : ∀ ⦃X : C⦄ (R : Presieve X), R ∈ K X → ∀ x : u.obj X,
      ∃ (Y : C) (f : Y ⟶ X) (_ : R f) (y : u.obj Y), u.map f y = x)
    (h₂ : ∀ ⦃X : C⦄ (R : Presieve X), R ∈ K X → ∀ ⦃Y Z : C⦄ (f : Y ⟶ X), R f →
      ∀ (g : Z ⟶ X) [HasPullback f g], Function.Bijective (pullbackComparison u f g)) :
    K.toGrothendieck.W.IsInvertedBy (elementColimit u A) := by
  intro P₁ P₂ f hf
  change IsIso (colimMap (Functor.whiskerLeft (Functor.Elements.π u).op f))
  rw [isIso_iff_coyoneda_map_bijective]
  intro M
  rw [← Function.Bijective.of_comp_iff' (skyscraperPresheafHomEquiv u).bijective]
  convert (hf _ (isSheaf_skyscraperPresheaf h₁ h₂ M)).comp
    (skyscraperPresheafHomEquiv u).bijective using 1
  ext g : 1
  exact skyscraperPresheafHomEquiv_naturality_left u f g

/-- **Stacks 00Y8 (3) / 0AI4**, with values in `A`: for `u : C ⥤ Type w` satisfying conditions
(1) and (2) of a point of a site (Stacks 00Y5), the canonical map `F_p ⟶ (F^#)_p` from the
stalk of a presheaf to the stalk of its sheafification is an isomorphism. -/
theorem isIso_elementColimit_map_toSheafify [HasColimitsOfShape u.Elementsᵒᵖ A]
    [HasWeakSheafify K.toGrothendieck A]
    (h₁ : ∀ ⦃X : C⦄ (R : Presieve X), R ∈ K X → ∀ x : u.obj X,
      ∃ (Y : C) (f : Y ⟶ X) (_ : R f) (y : u.obj Y), u.map f y = x)
    (h₂ : ∀ ⦃X : C⦄ (R : Presieve X), R ∈ K X → ∀ ⦃Y Z : C⦄ (f : Y ⟶ X), R f →
      ∀ (g : Z ⟶ X) [HasPullback f g], Function.Bijective (pullbackComparison u f g))
    (F : Cᵒᵖ ⥤ A) :
    IsIso ((elementColimit u A).map (toSheafify K.toGrothendieck F)) :=
  W_isInvertedBy_elementColimit h₁ h₂ _ (K.toGrothendieck.W_toSheafify F)

end CategoryTheory.ElementColimit
