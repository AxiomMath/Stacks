module

public import Mathlib.CategoryTheory.Limits.Preserves.FunctorCategory
public import Mathlib.CategoryTheory.Limits.Preserves.Shapes.Square
public import Mathlib.CategoryTheory.Sites.LeftExact
public import Mathlib.CategoryTheory.Sites.PreservesSheafification
public import StacksFrontier.CategoryTheory.Sites.Density

/-! # Sheafified representables in a larger universe of sections

The sheafified Yoneda embedding of `StacksFrontier.CategoryTheory.Sites.Density` takes values in
`Sheaf J (Type max u v)`, the sheaves of sets whose sections live in the universe generated by
the objects and the morphisms of the site. A statement about sheaves of modules on a ringed
site, by contrast, fixes an independent universe `t` for the sections of the modules, and the
underlying sheaf of sets of such a module does *not* live in `Type max u v`. Comparing the two
therefore needs the sheafified representables with sections in `Type max u v t`, together with
a transfer of the universal properties from one universe to the other.

That transfer is the content of this file. It does not go through a functor between the two
sheaf categories: `Sheaf J (Type max u v) ⥤ Sheaf J (Type max u v t)` is neither an
equivalence nor a left adjoint, so it has no reason to preserve a pushout. What transfers
instead is the property `GrothendieckTopology.W` of *becoming invertible after
sheafification*, because `CategoryTheory.uliftFunctor` preserves sheafification
(`GrothendieckTopology.PreservesSheafification`). A pushout square of sheafifications is
exactly a presheaf square whose comparison map to the presheaf pushout lies in `J.W`, and
`GrothendieckTopology.W_of_preservesSheafification` moves that membership across.

## Main definitions

* `CategoryTheory.Sheaf.sheafifiedYonedaULift`: the functor `U ↦ h_U^#` with values in
  `Sheaf J (Type max u v t)`.
* `CategoryTheory.Sheaf.uliftYonedaCompULiftFunctorIso`: the comparison between lifting a
  representable twice and lifting it once into the larger universe.
* `CategoryTheory.Sheaf.sectionEquivULift`: Yoneda's lemma for sheaves of sets at the larger
  universe, `Mor(h_X^#, F) ≃ F(X)`.

## Main results

* `CategoryTheory.Sheaf.isPushout_map_whiskeringRight_presheafToSheaf`: if a square of
  presheaves becomes a pushout square after sheafification, then so does the square obtained
  by composing with a functor that preserves sheafification and spans.
* `CategoryTheory.Sheaf.isPushout_sheafifiedYonedaULift`: if the sheafified representables of
  a square form a pushout square in `Sheaf J (Type max u v)`, they also do in
  `Sheaf J (Type max u v t)`.
* `CategoryTheory.Sheaf.isPullback_op_map_of_isPushout`: consequently the sections of *any*
  sheaf of sets with sections in `Type max u v t` form a pullback square over such a square.
* `CategoryTheory.Sheaf.sectionEquivULift_map_comp`: restriction of sections corresponds to
  precomposition with a morphism of sheafified representables.

## Implementation notes

The hypothesis `PreservesColimitsOfShape WalkingSpan ((whiskeringRight _ _ _).obj F)` of the
general statement is automatic for `F = uliftFunctor`, which preserves colimits of every
size; it is left as a hypothesis so that the statement applies to any functor preserving
sheafification, for instance a forgetful functor between algebraic categories.

## References

* [Stacks Project, Tag 0GLW](https://stacks.math.columbia.edu/tag/0GLW)
* [Stacks Project, Tag 0EVY](https://stacks.math.columbia.edu/tag/0EVY)
-/

@[expose] public noncomputable section

open CategoryTheory Limits Opposite

namespace CategoryTheory.Sheaf

universe u v t u₁ v₁ u₂ v₂

section Transfer

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  {A : Type u₁} [Category.{v₁} A] {B : Type u₂} [Category.{v₂} B] (F : A ⥤ B)
  [HasWeakSheafify J A] [HasWeakSheafify J B] [J.PreservesSheafification F]
  [HasPushouts (Cᵒᵖ ⥤ A)]
  [PreservesColimitsOfShape WalkingSpan ((Functor.whiskeringRight Cᵒᵖ A B).obj F)]

/-- **Universe transfer for a pushout of sheafifications.** If a square of presheaves with
values in `A` becomes a pushout square after sheafification, and `F : A ⥤ B` preserves
sheafification and spans, then the square of presheaves with values in `B` obtained by
composing with `F` also becomes a pushout square after sheafification. -/
theorem isPushout_map_whiskeringRight_presheafToSheaf (sq : Square (Cᵒᵖ ⥤ A))
    (h : (sq.map (presheafToSheaf J A)).IsPushout) :
    (sq.map ((Functor.whiskeringRight Cᵒᵖ A B).obj F ⋙ presheafToSheaf J B)).IsPushout := by
  have h : IsPushout ((presheafToSheaf J A).map sq.f₁₂) ((presheafToSheaf J A).map sq.f₁₃)
      ((presheafToSheaf J A).map sq.f₂₄) ((presheafToSheaf J A).map sq.f₃₄) := h
  have hspan : IsPushout sq.f₁₂ sq.f₁₃
      (pushout.inl sq.f₁₂ sq.f₁₃) (pushout.inr sq.f₁₂ sq.f₁₃) := IsPushout.of_hasPushout _ _
  have hspanA := hspan.map (presheafToSheaf J A)
  have key : (presheafToSheaf J A).map (pushout.desc sq.f₂₄ sq.f₃₄ sq.fac) =
      (hspanA.isoIsPushout _ _ h).hom := by
    refine hspanA.hom_ext ?_ ?_
    · rw [IsPushout.inl_isoIsPushout_hom, ← Functor.map_comp, pushout.inl_desc]
    · rw [IsPushout.inr_isoIsPushout_hom, ← Functor.map_comp, pushout.inr_desc]
  have hWψ : J.W (pushout.desc sq.f₂₄ sq.f₃₄ sq.fac) := by
    rw [GrothendieckTopology.W_iff, key]
    infer_instance
  have hWF := J.W_of_preservesSheafification F _ hWψ
  rw [GrothendieckTopology.W_iff] at hWF
  have hiso : IsIso (((Functor.whiskeringRight Cᵒᵖ A B).obj F ⋙ presheafToSheaf J B).map
      (pushout.desc sq.f₂₄ sq.f₃₄ sq.fac)) := hWF
  refine (hspan.map ((Functor.whiskeringRight Cᵒᵖ A B).obj F ⋙ presheafToSheaf J B)).of_iso
    (Iso.refl _) (Iso.refl _) (Iso.refl _)
    (@asIso _ _ _ _ _ hiso) ?_ ?_ ?_ ?_
  all_goals first
    | exact (Category.comp_id _).trans (Category.id_comp _).symm
    | exact ((Functor.map_comp _ _ _).symm.trans
        (congrArg _ (pushout.inl_desc sq.f₂₄ sq.f₃₄ sq.fac))).trans (Category.id_comp _).symm
    | exact ((Functor.map_comp _ _ _).symm.trans
        (congrArg _ (pushout.inr_desc sq.f₂₄ sq.f₃₄ sq.fac))).trans (Category.id_comp _).symm

end Transfer

section SheafifiedYoneda

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)

/-- Lifting a representable presheaf into `Type max u v` and then into `Type max u v t` is
lifting it into `Type max u v t` at once. -/
def uliftYonedaCompULiftFunctorIso :
    uliftYoneda.{u} (C := C) ⋙
        (Functor.whiskeringRight Cᵒᵖ (Type max u v) (Type max u v t)).obj
          uliftFunctor.{t, max u v} ≅
      uliftYoneda.{max u t} :=
  NatIso.ofComponents (fun _ ↦ NatIso.ofComponents
    (fun _ ↦ Equiv.toIso ((Equiv.ulift.trans Equiv.ulift).trans Equiv.ulift.symm)))

/-- The sheafified Yoneda embedding `U ↦ h_U^#` with sections in a universe `max u v t`
containing both the site and a chosen universe `t`. For `t = u` it is
`CategoryTheory.Sheaf.sheafifiedYoneda`. -/
def sheafifiedYonedaULift [HasWeakSheafify J (Type max u v t)] :
    C ⥤ Sheaf J (Type max u v t) :=
  uliftYoneda.{max u t} ⋙ presheafToSheaf J (Type max u v t)

/-- **The sheafified representables of a square form a pushout square in every universe of
sections containing the site.** -/
theorem isPushout_sheafifiedYonedaULift [HasWeakSheafify J (Type max u v)]
    [HasWeakSheafify J (Type max u v t)] (sq : Square C)
    (h : (sq.map (Sheaf.sheafifiedYoneda J)).IsPushout) :
    (sq.map (sheafifiedYonedaULift.{u, v, t} J)).IsPushout := by
  have h1 := isPushout_map_whiskeringRight_presheafToSheaf J uliftFunctor.{t, max u v}
    (sq.map uliftYoneda.{u}) h
  let e : uliftYoneda.{u} (C := C) ⋙
      ((Functor.whiskeringRight Cᵒᵖ (Type max u v) (Type max u v t)).obj
        uliftFunctor.{t, max u v} ⋙ presheafToSheaf J (Type max u v t)) ≅
      sheafifiedYonedaULift.{u, v, t} J :=
    (Functor.associator _ _ _).symm ≪≫
      Functor.isoWhiskerRight uliftYonedaCompULiftFunctorIso.{u, v, t}
        (presheafToSheaf J (Type max u v t))
  exact (Square.IsPushout.iff_of_iso (Square.isoMk (e.app sq.X₁) (e.app sq.X₂) (e.app sq.X₃)
    (e.app sq.X₄) (e.hom.naturality sq.f₁₂) (e.hom.naturality sq.f₁₃) (e.hom.naturality sq.f₂₄)
    (e.hom.naturality sq.f₃₄))).mp h1

end SheafifiedYoneda

section Sections

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  [HasWeakSheafify J (Type max u v t)]

/-- **Yoneda's lemma for sheaves of sets at the larger universe of sections**: a morphism
`h_X^# ⟶ F` out of a sheafified representable with sections in `Type max u v t` is a section
of `F` over `X`. This is `CategoryTheory.Sheaf.sectionEquiv` with the extra universe. -/
def sectionEquivULift {X : C} {F : Sheaf J (Type max u v t)} :
    ((sheafifiedYonedaULift.{u, v, t} J).obj X ⟶ F) ≃ F.obj.obj (op X) :=
  ((sheafificationAdjunction J (Type max u v t)).homEquiv (uliftYoneda.{max u t}.obj X) F).trans
    uliftYonedaEquiv.{max u t}

/-- Precomposing `α : h_X^# ⟶ F` with `h_i^#`, for `i : Y ⟶ X`, restricts the corresponding
section along `i`. -/
theorem sectionEquivULift_map_comp {X Y : C} (i : Y ⟶ X) {F : Sheaf J (Type max u v t)}
    (α : (sheafifiedYonedaULift.{u, v, t} J).obj X ⟶ F) :
    sectionEquivULift.{u, v, t} J ((sheafifiedYonedaULift.{u, v, t} J).map i ≫ α) =
      F.obj.map i.op (sectionEquivULift.{u, v, t} J α) :=
  (congrArg (fun β : uliftYoneda.{max u t}.obj Y ⟶
        (sheafToPresheaf J (Type max u v t)).obj F => uliftYonedaEquiv.{max u t} β)
    ((sheafificationAdjunction J (Type max u v t)).homEquiv_naturality_left
      (uliftYoneda.{max u t}.map i)
      (show (presheafToSheaf J (Type max u v t)).obj (uliftYoneda.{max u t}.obj X) ⟶ F from
        α))).trans
    (uliftYonedaEquiv_naturality
      ((sheafificationAdjunction J (Type max u v t)).homEquiv
        (uliftYoneda.{max u t}.obj X) F α) i.op).symm

/-- **The sections of a sheaf over a Mayer-Vietoris square form a pullback square.** If the
sheafified representables of `sq` form a pushout square in `Sheaf J (Type max u v)`, then for
*every* sheaf of sets `F` whose sections live in `Type max u v t` the square of restriction
maps `F(X₄) ⟶ F(X₂)`, `F(X₄) ⟶ F(X₃)`, `F(X₂) ⟶ F(X₁)`, `F(X₃) ⟶ F(X₁)` is a pullback
square of types. -/
theorem isPullback_op_map_of_isPushout [HasWeakSheafify J (Type max u v)] (sq : Square C)
    (h : (sq.map (Sheaf.sheafifiedYoneda J)).IsPushout) (F : Sheaf J (Type max u v t)) :
    (sq.op.map F.obj).IsPullback := by
  have h1 := ((isPushout_sheafifiedYonedaULift.{u, v, t} J sq h).op).map (yoneda.obj F)
  refine (Square.IsPullback.iff_of_iso (Square.isoMk
    (Equiv.toIso (sectionEquivULift.{u, v, t} J)) (Equiv.toIso (sectionEquivULift.{u, v, t} J))
    (Equiv.toIso (sectionEquivULift.{u, v, t} J)) (Equiv.toIso (sectionEquivULift.{u, v, t} J))
    ?_ ?_ ?_ ?_)).mp h1 <;>
  (ext α; exact sectionEquivULift_map_comp.{u, v, t} J _ α)

end Sections

end CategoryTheory.Sheaf
