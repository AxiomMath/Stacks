    (Presheaf.isLocallySurjective_iff_whisker_forget J _).mpr
      (Presheaf.isLocallySurjective_of_isLocallySurjective_fac J
        (freeAlgebraSheafVariable_comp_desc J A B E'.obj a πE.hom))
  let c := presentationNaiveCotangentComplexMap.{v, u, max w u v, w} J A E'.obj
    (underlyingPresheaf J B) πE.hom B a πE.hom (𝟙 _) (Category.comp_id _)
  let comparison₀ := presentationTensorMap.{v, u, max w u v, w} J A E'.obj
    (underlyingPresheaf J B) πE.hom B a πE.hom (𝟙 _) (Category.comp_id _)
  obtain ⟨l, hl⟩ := exists_tensorHom_on_generators.{v, u, w} J A B a E'.obj πE.hom H
    liftGen.hom
  have hpoly : Presheaf.IsLocallySurjective J
      ((toSheafification J CommRingCat.{max w u v}).app (polynomialPresheaf J A E'.obj)) := by
    let := ringWEqualsLocallyBijective.{v, u, w} J
    exact (J.W_toSheafify _).isLocallySurjective
  have hlp : l ≫ pH = comparison₀ := by
    apply (tensorHomEquivDerivation.{v, u, w} J A B a E'.obj πE.hom S₀.X₂).injective
    refine freeAlgebraSheafDerivation_ext J A E'.obj _ _ _ ?_
    intro X e
    refine Eq.trans (tensorHomEquivDerivation_d.{v, u, w} J A B a E'.obj πE.hom S₀.X₂
      (l ≫ pH) X _) ?_
    refine Eq.trans ?_ (tensorHomEquivDerivation_d.{v, u, w} J A B a E'.obj πE.hom S₀.X₂
      comparison₀ X _).symm
    have h1 : comparison₀.val.app X
          (tensorDifferential.{v, u, max w u v, w} J A (freeAlgebraSheaf J A E'.obj) B
            (freeAlgebraSheafCoefficientMap J A E'.obj) (presentation J A B a E'.obj πE.hom) X
            ((freeAlgebraSheafVariable J A E'.obj).app X e)) =
        tensorDifferential.{v, u, max w u v, w} J A
          (freeAlgebraSheaf J A (underlyingPresheaf J B)) B
          (freeAlgebraSheafCoefficientMap J A (underlyingPresheaf J B))
          (presentation J A B a (underlyingPresheaf J B) (𝟙 _)) X
          ((freeAlgebraMap J A E'.obj (underlyingPresheaf J B) πE.hom).hom.app X
            ((freeAlgebraSheafVariable J A E'.obj).app X e)) :=
      tensorSheafMapOfFac_tensorDifferential J A B _ _ _ _ _ _ _ _ _ X _
    have h2 : (freeAlgebraMap J A E'.obj (underlyingPresheaf J B) πE.hom).hom.app X
          ((freeAlgebraSheafVariable J A E'.obj).app X e) = vars.app X (πE.hom.app X e) :=
      congrArg (fun k => k.app X e)
        (freeAlgebraSheafVariable_comp_freeAlgebraMap J A E'.obj (underlyingPresheaf J B) πE.hom)
    have h3 : gen.hom.app X (πE.hom.app X e) = pSet.hom.app X (liftGen.hom.app X e) :=
      congrArg (fun k => k.hom.app X e) hGen
    refine Eq.trans (congrArg (fun y => pH.val.app X y) (hl X e)) ?_
    refine Eq.trans ?_ h1.symm
    refine Eq.trans ?_ (congrArg (fun y => tensorDifferential.{v, u, max w u v, w} J A
      (freeAlgebraSheaf J A (underlyingPresheaf J B)) B
      (freeAlgebraSheafCoefficientMap J A (underlyingPresheaf J B))
      (presentation J A B a (underlyingPresheaf J B) (𝟙 _)) X y) h2).symm
    exact h3.symm.trans (hgen X (πE.hom.app X e))
  have hi : presentationDegreeZeroInclusion.{v, u, w} J A B a E'.obj πE.hom ≫ c =
      (CochainComplex.singleFunctor
        (_root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B)) 0).map
          comparison₀ ≫
        presentationDegreeZeroInclusion.{v, u, w} J A B a (underlyingPresheaf J B) (𝟙 _) := by
    apply HomologicalComplex.from_single_hom_ext
    rw [HomologicalComplex.comp_f, HomologicalComplex.comp_f,
      presentationDegreeZeroInclusion_f_zero, presentationDegreeZeroInclusion_f_zero,
      presentationNaiveCotangentComplexMap_f_zero]
    simp [CochainComplex.singleFunctor,
      HomologicalComplex.single_map_f_self]
    rfl
  have hz : (DerivedCategory.singleFunctor
      (_root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B)) 0).map pH ≫
        ξ₀ = 0 := by
    rw [← hExt]
    simpa only [Abelian.Ext.comp_hom, Abelian.Ext.mk₀_hom, Abelian.Ext.zero_hom,
      ShiftedHom.mk₀_comp] using congrArg Abelian.Ext.hom hS.comp_extClass
  have hv : DerivedCategory.Q.map
      (presentationDegreeZeroInclusion.{v, u, w} J A B a E'.obj πE.hom) ≫
      (DerivedCategory.Q.map c ≫ ξ) = 0 := by
    have hq : DerivedCategory.Q.map
          (presentationDegreeZeroInclusion.{v, u, w} J A B a E'.obj πE.hom) ≫
          DerivedCategory.Q.map c =
        DerivedCategory.Q.map ((CochainComplex.singleFunctor
            (_root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B)) 0).map
            comparison₀) ≫
          DerivedCategory.Q.map
            (presentationDegreeZeroInclusion.{v, u, w} J A B a (underlyingPresheaf J B) (𝟙 _)) := by
      rw [← DerivedCategory.Q.map_comp, ← DerivedCategory.Q.map_comp, hi]
    refine Eq.trans (Category.assoc _ _ _).symm ?_
    rw [hq]
    refine Eq.trans (Category.assoc _ _ _) ?_
    change (DerivedCategory.singleFunctor
      (_root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B)) 0).map
        comparison₀ ≫ ξ₀ = 0
    rw [← hlp, Functor.map_comp, Category.assoc, hz, Limits.comp_zero]
  obtain ⟨f, hf⟩ := exists_conormalHom_of_restriction_eq_zero.{v, u, w, t} J A B a E'.obj
    πE.hom G (DerivedCategory.Q.map c ≫ ξ) hv
  refine ⟨E', πE.hom, hπ, hsurj', f, ?_⟩
  have hc : naiveCotangentComplexComparison.{v, u, max w u v, w} J A B a E'.obj πE.hom = c := by
    have hnat := naiveCotangentComplexComparison_naturality.{v, u, max w u v, w} J A B a
      E'.obj (underlyingPresheaf J B) πE.hom πE.hom (𝟙 _) (Category.comp_id _)
    rw [naiveCotangentComplexComparison_id] at hnat
    exact ((Category.comp_id c).symm.trans hnat).symm
  rwa [hc]

/-- Let `A ⟶ B` be a homomorphism of sheaves of rings on a site, let `G` be a `B`-module and let
`ξ` be a first Ext class of the naive cotangent complex `NL_{B/A}` with values in `G`. Then there
is a map of sheaves of sets `α : E ⟶ B` presenting `B` over `A` for which `ξ`, viewed in
`Ext¹_B(NL(α), G)` along the canonical comparison map, is the class of a homomorphism `I/I² ⟶ G`
out of the conormal sheaf of the presentation. -/
@[stacks 08UJ]
theorem exists_presentation_conormalExtClass
    (ξ : DerivedCategory.Ext (DerivedCategory.Q.obj
        (naiveCotangentComplex.{v, u, max w u v, w} J A B a))
      ((DerivedCategory.singleFunctor _ 0).obj G) 1) :
    ∃ (E : Sheaf J (Type (max w u v))) (α : E.obj ⟶ underlyingPresheaf J B)
      (hsurj : Presheaf.IsLocallySurjective J (presentation J A B a E.obj α).hom),
      letI : Presheaf.IsLocallySurjective J (presentation J A B a E.obj α).hom := hsurj
      ∃ f : (presentationConormalSequence.{v, u, max w u v, w} J A B a E.obj α).X₁ ⟶ G,
        DerivedCategory.Q.map
            (naiveCotangentComplexComparison.{v, u, max w u v, w} J A B a E.obj α) ≫ ξ =
          presentationConormalExtClass.{v, u, w, t} J A B a E.obj α G f := by
  obtain ⟨E, α, -, hsurj, h⟩ := exists_locallySurjective_presentation_conormalExtClass J A B a G ξ
  exact ⟨E, α, hsurj, h⟩

end Existence

