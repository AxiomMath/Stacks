module

public import Mathlib.Algebra.Category.ModuleCat.Presheaf.EpiMono
public import Mathlib.Algebra.Category.Ring.Colimits
public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import Mathlib.Algebra.Category.Ring.Limits
public import Mathlib.Algebra.MvPolynomial.Derivation
public import Mathlib.CategoryTheory.Sites.Equivalence
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EpiLocallySurjective
public import StacksFrontier.Algebra.Homology.DerivedCategory.Ext.Basic
public import StacksFrontier.CategoryTheory.Sites.Modules.InternalHomAndFlatness.NaiveCotangent

/-!
# First Ext classes of the naive cotangent complex of sheaves of rings

Let `A ⟶ B` be a homomorphism of sheaves of commutative rings on a site and let `G` be a
sheaf of `B`-modules. A homomorphism `I/I² ⟶ G` out of the conormal sheaf of a polynomial
presentation `α : E ⟶ B` of `B` over `A` has a first Ext class in `Ext¹_B(NL(α), G)`, namely
the class of the chain map from `NL(α)` to `G` placed in degree `-1`. Every first Ext class of
the naive cotangent complex `NL_{B/A}` is of this form once the presentation is refined: the
obstruction to writing a class in that way is its restriction to the degree `0` term
`Ω = Ω_{A[E]/A} ⊗_{A[E]} B`, which is the free `B`-module on the sheaf of sets `E`; writing
that obstruction as the class of an extension `0 ⟶ G ⟶ H ⟶ Ω ⟶ 0` of `B`-modules and
replacing `E` by the fibre product `E ×_Ω H` kills it, because the generators of the refined
presentation come with prescribed lifts to `H`.

## Main definitions

* `Stacks.SheafOfModules.presentationConormalExtClass` is the first Ext class of a
  homomorphism out of the conormal sheaf of a polynomial presentation.

## Main results

* `Stacks.SheafOfModules.exists_presentation_conormalExtClass` is the main result: a first Ext
  class of `NL_{B/A}` becomes, along the canonical comparison map of a suitable polynomial
  presentation `α : E ⟶ B`, the class of a homomorphism `I/I² ⟶ G` out of its conormal sheaf.
* `Stacks.SheafOfModules.exists_locallySurjective_presentation_conormalExtClass`: the same, with
  `α` itself locally surjective.

## Implementation notes

The degree `0` term of `NL(α)` is the free `B`-module on the sheaf of sets `E`: morphisms out
of it are the derivations of `A[E]` over `A` with values in the module, and such a derivation
is determined by, and may be prescribed on, the variables, because the sheaf `A[E]` is locally
generated by polynomials in them. Both halves are obtained from the corepresentability of
derivations together with the local bijectivity of the sheafification map of the presheaf of
polynomial rings.

The identification of `NL(α)` with `NL_{B/A}` enters only through the canonical comparison
chain map `NL(α) ⟶ NL_{B/A}`, along which the given class is pulled back. First Ext groups are
Hom-groups of the derived category of sheaves of `B`-modules, for an arbitrary choice of
`HasDerivedCategory` instance.

The ring universe is `max w u v` for a site `Type u` with `Category.{v}`. This is forced
rather than chosen: the refined presentation has sections of a sheaf of modules among its
generators, so the generator universe absorbs the module universe, which in turn absorbs the
site universes. As `w` is free, the statement covers every ring universe containing
`max u v`.

## References

* [Stacks Project, Tag 08UJ](https://stacks.math.columbia.edu/tag/08UJ)
* [Stacks Project, Tag 08TY](https://stacks.math.columbia.edu/tag/08TY), the canonical
  identification of `NL(α)` with `NL_{B/A}`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe v u w t

namespace Stacks.SheafOfModules

/-! ### Two-term complexes in an abelian category -/

section TwoTerm

variable {D : Type*} [Category D] [Abelian D]

variable {L M : D}

/-- The degree `0` term of a two-term complex `L ⟶ M`, placed in degree `0`, as a subcomplex:
the chain map out of the complex concentrated in degree `0` with value `M`. -/
private noncomputable def doubleInclusion (d : L ⟶ M) :
    (CochainComplex.singleFunctor D 0).obj M ⟶
      HomologicalComplex.double d
        (show (ComplexShape.up ℤ).Rel (-1) 0 from by decide) :=
  HomologicalComplex.mkHomFromSingle (HomologicalComplex.doubleXIso₁ d
    (show (ComplexShape.up ℤ).Rel (-1) 0 from by decide) (by omega)).inv
    (by
      intro k hk
      rw [HomologicalComplex.double_d_eq_zero₀ d
        (show (ComplexShape.up ℤ).Rel (-1) 0 from by decide) 0 k (by omega)]
      simp)

/-- In degree `0` the inclusion of the degree `0` term is the canonical identification. -/
private lemma doubleInclusion_f_zero (d : L ⟶ M) :
    (doubleInclusion d).f 0 =
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).hom ≫
        (HomologicalComplex.doubleXIso₁ d
          (show (ComplexShape.up ℤ).Rel (-1) 0 from by decide) (by omega)).inv :=
  HomologicalComplex.mkHomFromSingle_f _ _

/-- The degree `-1` term of a two-term complex `L ⟶ M`, placed in degree `-1`, as a quotient
complex: the chain map into the complex concentrated in degree `-1` with value `L`. -/
private noncomputable def doubleProjection (d : L ⟶ M) :
    HomologicalComplex.double d
      (show (ComplexShape.up ℤ).Rel (-1) 0 from by decide) ⟶
      (CochainComplex.singleFunctor D (-1)).obj L :=
  HomologicalComplex.mkHomToSingle (HomologicalComplex.doubleXIso₀ d
    (show (ComplexShape.up ℤ).Rel (-1) 0 from by decide)).hom
    (by
      intro j hj
      rw [HomologicalComplex.double_d_eq_zero₁ d
        (show (ComplexShape.up ℤ).Rel (-1) 0 from by decide) j (-1) (by omega)]
      simp)

/-- The inclusion of the degree `0` term followed by the projection onto the degree `-1` term
is zero. -/
private lemma doubleInclusion_comp_doubleProjection (d : L ⟶ M) :
    doubleInclusion d ≫ doubleProjection d = 0 := by
  apply HomologicalComplex.from_single_hom_ext
  exact (HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) (-1) L 0
    (by omega)).eq_of_tgt _ _

/-- A two-term complex sits in a short exact sequence of complexes between its degree `0` term,
placed in degree `0`, and its degree `-1` term, placed in degree `-1`. -/
private lemma shortExact_double (d : L ⟶ M) :
    (ShortComplex.mk (doubleInclusion d) (doubleProjection d)
      (doubleInclusion_comp_doubleProjection d)).ShortExact := by
  refine HomologicalComplex.shortExact_of_degreewise_shortExact _ fun n => ?_
  let S := (ShortComplex.mk (doubleInclusion d) (doubleProjection d)
    (doubleInclusion_comp_doubleProjection d)).map (HomologicalComplex.eval D _ n)
  change S.ShortExact
  by_cases hn : n = 0
  · subst n
    have hi : IsIso S.f := by
      dsimp [S, doubleInclusion]
      rw [HomologicalComplex.mkHomFromSingle_f]
      infer_instance
    have hz : IsZero ((CochainComplex.singleFunctor D (-1)).obj L |>.X 0) :=
      HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) (-1) L 0 (by omega)
    have hzg : S.g = 0 := hz.eq_of_tgt S.g 0
    have hExact : S.Exact := (ShortComplex.exact_iff_epi S hzg).2 inferInstance
    exact ShortComplex.ShortExact.mk' hExact (by infer_instance) (hz.epi _)
  · by_cases hn' : n = -1
    · subst n
      have hp : IsIso S.g := by
        dsimp [S, doubleProjection]
        rw [HomologicalComplex.mkHomToSingle_f]
        infer_instance
      have hz : IsZero ((CochainComplex.singleFunctor D 0).obj M |>.X (-1)) :=
        HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 M (-1) (by omega)
      have hzf : S.f = 0 := hz.eq_of_src S.f 0
      have hExact : S.Exact := (ShortComplex.exact_iff_mono S hzf).2 inferInstance
      exact ShortComplex.ShortExact.mk' hExact (hz.mono _) (by infer_instance)
    · have hz : IsZero S.X₂ := HomologicalComplex.isZero_double_X d
        (show (ComplexShape.up ℤ).Rel (-1) 0 from by decide) n hn' hn
      have hz₁ : IsZero S.X₁ := by
        change IsZero (((CochainComplex.singleFunctor D 0).obj M).X n)
        exact HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 M n hn
      have hz₃ : IsZero S.X₃ := by
        change IsZero (((CochainComplex.singleFunctor D (-1)).obj L).X n)
        exact HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) (-1) L n hn'
      exact ShortComplex.ShortExact.mk' (S.exact_of_isZero_X₂ hz)
        (hz₁.mono S.f) (hz₃.epi S.g)

/-- A map out of a two-term complex in the derived category whose restriction to the degree `0`
term vanishes factors through the degree `-1` term, placed in degree `-1`. -/
private lemma exists_factorization_of_restriction_eq_zero [HasDerivedCategory D]
    (G : D) (d : L ⟶ M)
    (ξ : DerivedCategory.Q.obj (HomologicalComplex.double d
      (show (ComplexShape.up ℤ).Rel (-1) 0 from by decide)) ⟶
      ((DerivedCategory.singleFunctor D 0).obj G)⟦(1 : ℤ)⟧)
    (hξ : DerivedCategory.Q.map (doubleInclusion d) ≫ ξ = 0) :
    ∃ g : DerivedCategory.Q.obj ((CochainComplex.singleFunctor D (-1)).obj L) ⟶
        ((DerivedCategory.singleFunctor D 0).obj G)⟦(1 : ℤ)⟧,
      ξ = DerivedCategory.Q.map (doubleProjection d) ≫ g := by
  have hS := shortExact_double d
  exact (DerivedCategory.triangleOfSES hS).yoneda_exact₂
    (DerivedCategory.triangleOfSES_distinguished hS) ξ hξ

/-- Every element of `Ext¹(M, G)` is the class of a short exact sequence
`0 ⟶ G ⟶ H ⟶ M ⟶ 0`. -/
private lemma exists_shortExact_representing_extOne [HasExt D] [HasDerivedCategory D] (M G : D)
    (ξ : ShiftedHom ((DerivedCategory.singleFunctor D 0).obj M)
      ((DerivedCategory.singleFunctor D 0).obj G) 1) :
    ∃ (H : D) (i : G ⟶ H) (p : H ⟶ M) (h : i ≫ p = 0)
      (hS : (ShortComplex.mk i p h).ShortExact),
      Abelian.Ext.homEquiv hS.extClass = ξ := by
  obtain ⟨H, i, p, h, hS, hh⟩ :=
    (Abelian.Ext.extClass_surjective_and_eq_iff_iso_and_baerSum D M G).1
      ((Abelian.Ext.homEquiv (X := M) (Y := G)).symm ξ)
  refine ⟨H, i, p, h, hS, ?_⟩
  rw [hh]
  exact (Abelian.Ext.homEquiv (X := M) (Y := G)).apply_symm_apply ξ

/-- A map in the derived category out of an object of `D` placed in degree `-1` and into an
object placed in degree `0`, shifted by one, comes from a map of `D`. -/
private lemma exists_map_of_hom_degree_negOne [HasDerivedCategory D] (L G : D)
    (g : DerivedCategory.Q.obj ((CochainComplex.singleFunctor D (-1)).obj L) ⟶
      ((DerivedCategory.singleFunctor D 0).obj G)⟦(1 : ℤ)⟧) :
    ∃ f : L ⟶ G,
      g = DerivedCategory.Q.map ((CochainComplex.singleFunctor D (-1)).map f) ≫
        ((DerivedCategory.singleFunctors D).shiftIso (1 : ℤ) (-1) 0 (by decide)).inv.app G := by
  obtain ⟨f, hf⟩ := (DerivedCategory.singleFunctor D (-1)).map_surjective
    (g ≫ ((DerivedCategory.singleFunctors D).shiftIso (1 : ℤ) (-1) 0 (by decide)).hom.app G)
  refine ⟨f, ?_⟩
  change g = (DerivedCategory.singleFunctor D (-1)).map f ≫ _
  rw [hf]
  simp

/-- A map out of a two-term complex in the derived category whose restriction to the degree `0`
term vanishes is the class of a map out of the degree `-1` term. -/
private lemma exists_hom_eq_of_restriction_eq_zero [HasDerivedCategory D] (G : D) (d : L ⟶ M)
    (ξ : DerivedCategory.Q.obj (HomologicalComplex.double d
      (show (ComplexShape.up ℤ).Rel (-1) 0 from by decide)) ⟶
      ((DerivedCategory.singleFunctor D 0).obj G)⟦(1 : ℤ)⟧)
    (hξ : DerivedCategory.Q.map (doubleInclusion d) ≫ ξ = 0) :
    ∃ (f : (HomologicalComplex.double d
        (show (ComplexShape.up ℤ).Rel (-1) 0 from by decide)).X (-1) ⟶ G)
      (hf : ∀ i : ℤ, (ComplexShape.up ℤ).Rel i (-1) →
        (HomologicalComplex.double d
          (show (ComplexShape.up ℤ).Rel (-1) 0 from by decide)).d i (-1) ≫ f = 0),
      ξ = DerivedCategory.Q.map (HomologicalComplex.mkHomToSingle f hf) ≫
        ((DerivedCategory.singleFunctors D).shiftIso (1 : ℤ) (-1) 0 (by decide)).inv.app G := by
  obtain ⟨g, hg⟩ := exists_factorization_of_restriction_eq_zero G d ξ hξ
  obtain ⟨f, hf⟩ := exists_map_of_hom_degree_negOne L G g
  let e := HomologicalComplex.doubleXIso₀ d
    (show (ComplexShape.up ℤ).Rel (-1) 0 from by decide)
  have hz (i : ℤ) (_ : (ComplexShape.up ℤ).Rel i (-1)) :
      (HomologicalComplex.double d
        (show (ComplexShape.up ℤ).Rel (-1) 0 from by decide)).d i (-1) ≫ (e.hom ≫ f) = 0 := by
    rw [HomologicalComplex.double_d_eq_zero₁ d
      (show (ComplexShape.up ℤ).Rel (-1) 0 from by decide) i (-1) (by omega), zero_comp]
  refine ⟨e.hom ≫ f, hz, ?_⟩
  rw [hg, hf, ← Category.assoc, ← DerivedCategory.Q.map_comp]
  congr 2
  apply HomologicalComplex.to_single_hom_ext
  simp [doubleProjection, HomologicalComplex.comp_f, e,
    CochainComplex.singleFunctor,
    HomologicalComplex.single_map_f_self]

end TwoTerm

/-! ### Local surjectivity -/

section LocallySurjective

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)

/-- The first projection of a fibre product of sheaves of sets is surjective as soon as the
map it is pulled back along is. -/
private lemma isLocallySurjective_pullback_fst
    {E H M : Sheaf J (Type w)} (f : E ⟶ M) (p : H ⟶ M)
    [Presheaf.IsLocallySurjective J p.hom] :
    Presheaf.IsLocallySurjective J (Limits.pullback.fst f p).hom := by
  constructor
  intro X x
  apply J.superset_covering _ (Presheaf.imageSieve_mem J p.hom (f.hom.app (Opposite.op X) x))
  rintro Y g ⟨y, hy⟩
  have hpb := ((IsPullback.of_hasPullback f p).map
    (sheafToPresheaf J (Type w))).map ((evaluation Cᵒᵖ (Type w)).obj (Opposite.op Y))
  obtain ⟨t, ht, _⟩ := Types.exists_of_isPullback hpb (E.obj.map g.op x) y
    ((NatTrans.naturality_apply f.hom g.op x).trans hy.symm)
  exact ⟨t, ht⟩

end LocallySurjective

/-! ### Derivations of a free algebra sheaf -/

section Derivations

open Stacks.Sites.FreeAlgebra

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)

/-- Two sums of two scalar multiples in a module over a commutative ring object agree as soon
as the multiplied elements do. -/
private lemma smul_add_congr {R : CommRingCat.{w}} {N : ModuleCat.{w} R} (r s : R)
    {x x' y y' : N} (hx : x = x') (hy : y = y') : r • x + s • y = r • x' + s • y' := by
  rw [hx, hy]

/-- Two sums of two scalar multiples in a module over a semiring agree as soon as the
multiplied elements do. -/
private lemma smul_add_congr' {R : Type*} [Semiring R] {N : Type*} [AddCommMonoid N]
    [Module R N] (r s : R) {x x' y y' : N} (hx : x = x') (hy : y = y') :
    r • x + s • y = r • x' + s • y' := by rw [hx, hy]

/-- The derivation of a polynomial ring over its coefficient ring prescribing the values of the
variables. -/
private noncomputable def polynomialDerivationComponent
    (R : CommRingCat.{w}) (E : Type w) (M : ModuleCat.{w} (MvPolynomial E R))
    (f : E → M) : M.Derivation (CommRingCat.ofHom MvPolynomial.C) := by
  let : Module R M := Module.compHom M (MvPolynomial.C : R →+* MvPolynomial E R)
  let : IsScalarTower R (MvPolynomial E R) M := IsScalarTower.of_compHom _ _ _
  exact ModuleCat.Derivation.mk (MvPolynomial.mkDerivation R f)
    (fun x y => map_add _ x y) (fun x y => Derivation.leibniz _ x y)
    (fun r => MvPolynomial.derivation_C _ r)

/-- The derivation prescribing the values of the variables takes the prescribed value at each
variable. -/
private lemma polynomialDerivationComponent_X
    (R : CommRingCat.{w}) (E : Type w) (M : ModuleCat.{w} (MvPolynomial E R))
    (f : E → M) (e : E) :
    (polynomialDerivationComponent R E M f).d (MvPolynomial.X e) = f e := by
  let : Module R M := Module.compHom M (MvPolynomial.C : R →+* MvPolynomial E R)
  let : IsScalarTower R (MvPolynomial E R) M := IsScalarTower.of_compHom _ _ _
  exact MvPolynomial.mkDerivation_X R f e

/-- A map of presheaves of sets from the variables to a presheaf of modules over the presheaf of
polynomial rings is the family of values at the variables of a derivation. -/
private lemma exists_polynomialDerivation
    (A : Sheaf J CommRingCat.{w}) (E : Cᵒᵖ ⥤ Type w)
    (M : PresheafOfModules.{w}
      (polynomialPresheaf J A E ⋙ forget₂ CommRingCat RingCat))
    (f : E ⟶ M.presheaf ⋙ forget AddCommGrpCat) :
    ∃ D : PresheafOfModulesOfCommRing.Derivation' M (polynomialCoefficientMap J A E),
      ∀ (X : Cᵒᵖ) (e : E.obj X), D.d (MvPolynomial.X e) = f.app X e := by
  let d (X : Cᵒᵖ) := polynomialDerivationComponent (A.obj.obj X) (E.obj X)
    (M.obj X) (f.app X)
  have hC (X : Cᵒᵖ) (r : A.obj.obj X) : (d X).d (MvPolynomial.C r) = 0 := (d X).d_map r
  have hX (X : Cᵒᵖ) (e : E.obj X) : (d X).d (MvPolynomial.X e) = f.app X e :=
    polynomialDerivationComponent_X _ _ _ _ _
  have hn {X Y : Cᵒᵖ} (g : X ⟶ Y) (x : (polynomialPresheaf J A E).obj X) :
      (d Y).d ((polynomialPresheaf J A E).map g x) = M.map g ((d X).d x) := by
    induction x using MvPolynomial.induction_on with
    | C r =>
      rw [show (polynomialPresheaf J A E).map g (MvPolynomial.C r) =
        MvPolynomial.C (A.obj.map g r) from MvPolynomial.eval₂Hom_C _ _ _]
      rw [hC, hC, map_zero]
      rfl
    | add p q hp hq =>
      refine Eq.trans (congrArg (fun t => (d Y).d t) (map_add _ p q)) ?_
      refine Eq.trans ((d Y).d_add _ _) ?_
      refine Eq.trans (congrArg₂ (· + ·) hp hq) ?_
      refine Eq.trans (map_add (ConcreteCategory.hom (M.map g)) _ _).symm ?_
      exact congrArg (fun t => (ConcreteCategory.hom (M.map g)) t) ((d X).d_add p q).symm
    | mul_X p e hp =>
      have hvarmap : (polynomialPresheaf J A E).map g (MvPolynomial.X e) =
          MvPolynomial.X (E.map g e) := MvPolynomial.eval₂Hom_X' _ _ _
      have hvar : (d Y).d ((polynomialPresheaf J A E).map g (MvPolynomial.X e)) =
          (ConcreteCategory.hom (M.map g)) ((d X).d (MvPolynomial.X e)) := by
        refine Eq.trans (congrArg (fun t => (d Y).d t) hvarmap) ?_
        refine Eq.trans (hX Y (E.map g e)) ?_
        refine Eq.trans (NatTrans.naturality_apply f g e) ?_
        exact congrArg (fun t => (ConcreteCategory.hom (M.map g)) t) (hX X e).symm
      refine Eq.trans (congrArg (fun t => (d Y).d t) (map_mul _ p (MvPolynomial.X e))) ?_
      refine Eq.trans ((d Y).d_mul _ _) ?_
      refine Eq.trans (smul_add_congr (N := M.obj Y) _ _ hvar hp) ?_
      refine Eq.trans ?_ (congrArg (fun t => (ConcreteCategory.hom (M.map g)) t)
        ((d X).d_mul p (MvPolynomial.X e)).symm)
      refine Eq.trans ?_ (map_add (ConcreteCategory.hom (M.map g)) _ _).symm
      exact congrArg₂ (· + ·) (PresheafOfModules.map_smul M g p _).symm
        (PresheafOfModules.map_smul M g (MvPolynomial.X e) _).symm
  exact ⟨PresheafOfModulesOfCommRing.Derivation'.mk d (fun {X Y} g x => hn g x), hX⟩


/-- A derivation with values in a sheaf of modules, defined on a presheaf of rings which is
locally isomorphic to a sheaf of rings, extends to a derivation on that sheaf of rings.

This is the gluing step of derivation descent: it is what turns a derivation defined only on a
locally isomorphic presheaf of rings into one on the sheaf itself, and it is stated with the
extension's defining equation on sections so that a consumer can compute with it. -/
private lemma exists_derivation_of_locallyBijective
    {S P : Cᵒᵖ ⥤ CommRingCat.{w}} {Q : Sheaf J CommRingCat.{w}}
    [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
    [J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    (a : S ⟶ P) (α : P ⟶ Q.obj)
    [Presheaf.IsLocallySurjective J α] [Presheaf.IsLocallyInjective J α]
    (M : _root_.SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf Q))
    (D : PresheafOfModulesOfCommRing.Derivation' ((PresheafOfModules.restrictScalars
      (Functor.whiskerRight α (forget₂ CommRingCat RingCat))).obj M.val) a) :
    ∃ D' : PresheafOfModulesOfCommRing.Derivation' M.val (a ≫ α),
      ∀ (X : Cᵒᵖ) (x : P.obj X), D'.d (α.app X x) = D.d x := by
  let alphaAdd := Functor.whiskerRight α
    (forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat)
  have : Presheaf.IsLocallySurjective J alphaAdd := ⟨fun {_} x => Presheaf.imageSieve_mem J α x⟩
  have : Presheaf.IsLocallyInjective J alphaAdd :=
    ⟨fun {_} x y h => Presheaf.equalizerSieve_mem J α x y h⟩
  let d₀ : P ⋙ (forget₂ CommRingCat RingCat ⋙ forget₂ RingCat AddCommGrpCat) ⟶
      M.val.presheaf :=
    { app X := AddCommGrpCat.ofHom D.d
      naturality := by
        intro X Y f
        ext x
        exact D.d_map f x }
  let e := (J.W_of_isLocallyBijective alphaAdd).homEquiv M.val.presheaf M.isSheaf
  let d := e.symm d₀
  have hd : alphaAdd ≫ d = d₀ := e.apply_symm_apply d₀
  let δ (X : Cᵒᵖ) : Q.obj.obj X →+ M.val.obj X := (d.app X).hom
  have hd' (X : Cᵒᵖ) (x : P.obj X) : δ X (α.app X x) = D.d x :=
    congrArg (fun f => f.app X x) hd
  have hn {X Y : Cᵒᵖ} (f : X ⟶ Y) (x : Q.obj.obj X) :
      δ Y (Q.obj.map f x) = M.val.map f (δ X x) := NatTrans.naturality_apply d f x
  refine ⟨{ d := fun {X} => δ X
            d_map := fun f x => hn f x
            d_app := ?_
            d_mul := ?_ }, hd'⟩
  · intro X x y
    apply M.isSheaf.isSeparated _ _
      (J.intersection_covering (Presheaf.imageSieve_mem J α x)
        (Presheaf.imageSieve_mem J α y))
    rintro Y f ⟨⟨x₀, hx₀⟩, ⟨y₀, hy₀⟩⟩
    change M.val.map f.op _ = M.val.map f.op _
    have hprod : Q.obj.map f.op (x * y) = α.app _ (x₀ * y₀) := by
      rw [map_mul, ← hx₀, ← hy₀, map_mul]
    have hy' : M.val.map f.op (δ X y) = D.d y₀ :=
      (hn f.op y).symm.trans ((congrArg (δ _) hy₀.symm).trans (hd' _ y₀))
    have hx' : M.val.map f.op (δ X x) = D.d x₀ :=
      (hn f.op x).symm.trans ((congrArg (δ _) hx₀.symm).trans (hd' _ x₀))
    have hleft : M.val.map f.op (δ X (x * y)) = D.d (x₀ * y₀) :=
      (hn f.op (x * y)).symm.trans ((congrArg (δ _) hprod).trans (hd' _ _))
    have h1 := PresheafOfModules.map_smul M.val f.op x (δ X y)
    have h2 := PresheafOfModules.map_smul M.val f.op y (δ X x)
    have hx₀' : α.app _ x₀ = ((Stacks.SheafOfModules.Tensor.ringSheaf Q).obj.map f.op) x := hx₀
    have hy₀' : α.app _ y₀ = ((Stacks.SheafOfModules.Tensor.ringSheaf Q).obj.map f.op) y := hy₀
    rw [← hx₀', hy'] at h1
    rw [← hy₀', hx'] at h2
    rw [map_add]
    exact hleft.trans ((D.d_mul x₀ y₀).trans (congrArg₂ (· + ·) h1 h2).symm)
  · intro X x
    exact (hd' _ (a.app X x)).trans (D.d_app x)

/-- **A derivation on a presheaf of rings locally isomorphic to a sheaf of rings extends to the
sheaf of rings**, with the extension's defining equation on sections. This is the statement of
`exists_derivation_of_locallyBijective` as a declaration downstream modules may use. -/
public alias exists_derivation_extension_of_locallyBijective :=
    exists_derivation_of_locallyBijective

variable [HasWeakSheafify J CommRingCat.{w}]
  [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]

omit [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})] in
/-- A derivation of a free algebra sheaf `A[E]` over `A` is determined by its values on the
variables. -/
private lemma freeAlgebraSheafDerivation_ext
    (A : Sheaf J CommRingCat.{w}) (E : Cᵒᵖ ⥤ Type w)
    [Presheaf.IsLocallySurjective J
      ((toSheafification J CommRingCat.{w}).app (polynomialPresheaf J A E))]
    (M : _root_.SheafOfModules.{w}
      (Stacks.SheafOfModules.Tensor.ringSheaf (freeAlgebraSheaf J A E)))
    (D₁ D₂ : PresheafOfModulesOfCommRing.Derivation' M.val
      (freeAlgebraSheafCoefficientMap J A E).hom)
    (h : ∀ (X : Cᵒᵖ) (e : E.obj X),
      D₁.d (((toSheafification J CommRingCat.{w}).app
        (polynomialPresheaf J A E)).app X (MvPolynomial.X e)) =
      D₂.d (((toSheafification J CommRingCat.{w}).app
        (polynomialPresheaf J A E)).app X (MvPolynomial.X e))) : D₁ = D₂ := by
  let η := (toSheafification J CommRingCat.{w}).app (polynomialPresheaf J A E)
  have hp (X : Cᵒᵖ) (p : MvPolynomial (E.obj X) (A.obj.obj X)) :
      D₁.d (η.app X p) = D₂.d (η.app X p) := by
    induction p using MvPolynomial.induction_on with
    | C r => exact (D₁.d_app r).trans (D₂.d_app r).symm
    | add p q hp hq =>
      refine Eq.trans (congrArg D₁.d (map_add (ConcreteCategory.hom (η.app X)) p q)) ?_
      refine Eq.trans (map_add D₁.d _ _) ?_
      refine Eq.trans (congrArg₂ (· + ·) hp hq) ?_
      refine Eq.trans (map_add D₂.d _ _).symm ?_
      exact congrArg D₂.d (map_add (ConcreteCategory.hom (η.app X)) p q).symm
    | mul_X p e hp =>
      refine Eq.trans (congrArg D₁.d
        (map_mul (ConcreteCategory.hom (η.app X)) p (MvPolynomial.X e))) ?_
      refine Eq.trans (D₁.d_mul _ _) ?_
      refine Eq.trans (smul_add_congr' _ _ (h X e) hp) ?_
      refine Eq.trans (D₂.d_mul _ _).symm ?_
      exact congrArg D₂.d
        (map_mul (ConcreteCategory.hom (η.app X)) p (MvPolynomial.X e)).symm
  ext X x
  apply M.isSheaf.isSeparated _ _ (Presheaf.imageSieve_mem J η x)
  rintro Y f ⟨p, hpx⟩
  change M.val.map f.op (D₁.d x) = M.val.map f.op (D₂.d x)
  exact (D₁.d_map f.op x).symm.trans
    ((congrArg D₁.d hpx.symm).trans ((hp _ p).trans
      ((congrArg D₂.d hpx).trans (D₂.d_map f.op x))))

end Derivations

/-! ### The free module on the generators of a presentation -/

section FreeModule

open Stacks.Sites.FreeAlgebra Stacks.Sites.Conormal
open AlgebraicGeometry.SheafOfModules (moduleOfDifferentialsOfSite universalDerivationOfSite
  derivationsFunctor)

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  [HasWeakSheafify J CommRingCat.{max w u v}]
  [J.HasSheafCompose (forget₂ CommRingCat.{max w u v} RingCat.{max w u v})]
  (A B : Sheaf J CommRingCat.{max w u v}) (a : A ⟶ B)
  (E : Cᵒᵖ ⥤ Type (max w u v)) (α : E ⟶ underlyingPresheaf J B)
  [Presheaf.IsLocallySurjective J (presentation J A B a E α).hom]

variable (N : _root_.SheafOfModules.{max w u v}
  (Stacks.SheafOfModules.Tensor.ringSheaf B))

/-- Morphisms from the degree `0` term of `NL(α)` to a sheaf of `B`-modules are the derivations
of `A[E]` over `A` with values in it. -/
private noncomputable def tensorHomEquivDerivation :
    ((presentationConormalSequence.{v, u, max w u v, w} J A B a E α).X₂ ⟶ N) ≃
      PresheafOfModulesOfCommRing.Derivation'
        ((_root_.SheafOfModules.pushforward (underlyingRingHomForPullback J
          (freeAlgebraSheaf J A E) B (presentation J A B a E α))).obj N).val
          (freeAlgebraSheafCoefficientMap J A E).hom :=
  (tensorDifferentialsIso.{v, u, max w u v, w} J A (freeAlgebraSheaf J A E) B
      (freeAlgebraSheafCoefficientMap J A E) (presentation J A B a E α)).homFromEquiv.trans
    (((_root_.SheafOfModules.pullbackPushforwardAdjunction
      (underlyingRingHomForPullback J (freeAlgebraSheaf J A E) B
        (presentation J A B a E α))).homEquiv _ N).trans
      (derivationsFunctor.{w} A (freeAlgebraSheaf J A E)
        (freeAlgebraSheafCoefficientMap J A E)).corepresentableBy.homEquiv)

/-- The derivation attached to a morphism out of the degree `0` term of `NL(α)` takes a section
to its value on the local section `1 ⊗ d f`. -/
private lemma tensorHomEquivDerivation_d
    (k : (presentationConormalSequence.{v, u, max w u v, w} J A B a E α).X₂ ⟶ N)
    (X : Cᵒᵖ) (x : (freeAlgebraSheaf J A E).obj.obj X) :
    (tensorHomEquivDerivation.{v, u, w} J A B a E α N k).d x =
      k.val.app X (tensorDifferential.{v, u, max w u v, w} J A (freeAlgebraSheaf J A E) B
        (freeAlgebraSheafCoefficientMap J A E) (presentation J A B a E α) X x) := by
  have hco := (derivationsFunctor.{w} A (freeAlgebraSheaf J A E)
    (freeAlgebraSheafCoefficientMap J A E)).corepresentableBy.homEquiv_eq
      (((_root_.SheafOfModules.pullbackPushforwardAdjunction
        (underlyingRingHomForPullback J (freeAlgebraSheaf J A E) B
          (presentation J A B a E α))).homEquiv _ N)
        ((tensorDifferentialsIso.{v, u, max w u v, w} J A (freeAlgebraSheaf J A E) B
          (freeAlgebraSheafCoefficientMap J A E) (presentation J A B a E α)).inv ≫ k))
  refine Eq.trans (congrArg (fun D => D.d (X := X) x) hco) ?_
  exact congrArg (fun t => k.val.app X t)
    (tensorDifferentialsIso_inv_d.{v, u, max w u v, w} J A (freeAlgebraSheaf J A E) B
      (freeAlgebraSheafCoefficientMap J A E) (presentation J A B a E α) X x)

omit [HasWeakSheafify J CommRingCat.{max w u v}]
  [J.HasSheafCompose (forget₂ CommRingCat.{max w u v} RingCat.{max w u v})] in
/-- Sheafification of presheaves of commutative rings on the site inverts exactly the locally
bijective maps. -/
private lemma ringWEqualsLocallyBijective :
    J.WEqualsLocallyBijective CommRingCat.{max w u v} := by
  let : EssentiallySmall.{max w u v} C := essentiallySmallSelf.{w, v, u} C
  let : ((equivSmallModel.{max w u v} C).inverse.inducedTopology J).WEqualsLocallyBijective
      CommRingCat.{max w u v} := inferInstance
  exact GrothendieckTopology.WEqualsLocallyBijective.ofEssentiallySmall.{v, _, u, _,
    max w u v} J

variable [HasSheafify J AddCommGrpCat.{max w u v}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{max w u v}]

omit [HasSheafify J AddCommGrpCat.{max w u v}] in
/-- The degree `0` term of `NL(α)` is the free `B`-module on the sheaf of generators: every
map of sheaves of sets from the generators to a sheaf of `B`-modules is the restriction of a
morphism of sheaves of modules. -/
private lemma exists_tensorHom_on_generators
    (g : E ⟶ N.val.presheaf ⋙ forget AddCommGrpCat.{max w u v}) :
    ∃ l : (presentationConormalSequence.{v, u, max w u v, w} J A B a E α).X₂ ⟶ N,
      ∀ (X : Cᵒᵖ) (e : E.obj X),
        l.val.app X (tensorDifferential.{v, u, max w u v, w} J A (freeAlgebraSheaf J A E) B
          (freeAlgebraSheafCoefficientMap J A E) (presentation J A B a E α) X
          (freeAlgebraSheafVariable J A E |>.app X e)) = g.app X e := by
  let := ringWEqualsLocallyBijective.{v, u, w} J
  let η := (toSheafification J CommRingCat.{max w u v}).app (polynomialPresheaf J A E)
  have : Presheaf.IsLocallySurjective J η := (J.W_toSheafify _).isLocallySurjective
  have : Presheaf.IsLocallyInjective J η := (J.W_toSheafify _).isLocallyInjective
  let M := (_root_.SheafOfModules.pushforward (underlyingRingHomForPullback J
    (freeAlgebraSheaf J A E) B (presentation J A B a E α))).obj N
  obtain ⟨D₀, hD₀⟩ := exists_polynomialDerivation J A E
    ((PresheafOfModules.restrictScalars
      (Functor.whiskerRight η (forget₂ CommRingCat RingCat))).obj M.val) g
  obtain ⟨D, hD⟩ := exists_derivation_of_locallyBijective J
    (polynomialCoefficientMap J A E) η M D₀
  let D' : PresheafOfModulesOfCommRing.Derivation' M.val
      (freeAlgebraSheafCoefficientMap J A E).hom := D
  refine ⟨(tensorHomEquivDerivation.{v, u, w} J A B a E α N).symm D', fun X e => ?_⟩
  have hEq : tensorHomEquivDerivation.{v, u, w} J A B a E α N
      ((tensorHomEquivDerivation.{v, u, w} J A B a E α N).symm D') = D' :=
    Equiv.apply_symm_apply _ D'
  refine Eq.trans (tensorHomEquivDerivation_d.{v, u, w} J A B a E α N
    ((tensorHomEquivDerivation.{v, u, w} J A B a E α N).symm D') X
    (freeAlgebraSheafVariable J A E |>.app X e)).symm ?_
  refine Eq.trans (congrArg (fun D₁ => D₁.d (X := X)
    (freeAlgebraSheafVariable J A E |>.app X e)) hEq) ?_
  exact (hD X (MvPolynomial.X e)).trans (hD₀ X e)

end FreeModule

/-! ### First Ext classes of the naive cotangent complex -/

section ExtClass

open Stacks.Sites.FreeAlgebra Stacks.Sites.Conormal

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  [HasWeakSheafify J CommRingCat.{max w u v}]
  [J.HasSheafCompose (forget₂ CommRingCat.{max w u v} RingCat.{max w u v})]
  (A B : Sheaf J CommRingCat.{max w u v}) (a : A ⟶ B)
  (E : Cᵒᵖ ⥤ Type (max w u v)) (α : E ⟶ underlyingPresheaf J B)
  [Presheaf.IsLocallySurjective J (presentation J A B a E α).hom]
  [HasSheafify J AddCommGrpCat.{max w u v}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{max w u v}]
  [HasDerivedCategory.{t}
    (_root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B))]
  (G : _root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B))

/-- The inclusion of the degree `0` term of `NL(α)`, placed in degree `0`, as a subcomplex. -/
private noncomputable def presentationDegreeZeroInclusion :
    (CochainComplex.singleFunctor
        (_root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B)) 0).obj
      (presentationConormalSequence.{v, u, max w u v, w} J A B a E α).X₂ ⟶
      presentationNaiveCotangentComplex.{v, u, max w u v, w} J A B a E α := by
  letI : HasZeroObject
      (_root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B)) :=
    hasZeroObject_of_hasTerminal_object
  exact doubleInclusion (presentationConormalSequence.{v, u, max w u v, w} J A B a E α).f

/-- The first Ext class of a homomorphism `f : I/I² ⟶ G` out of the conormal sheaf of a
polynomial presentation `α : E ⟶ B`: the class in `Ext¹_B(NL(α), G)` of the chain map from
`NL(α)` to the sheaf `G` placed in degree `-1` which is `f` in degree `-1`. -/
noncomputable def presentationConormalExtClass
    (f : (presentationConormalSequence.{v, u, max w u v, w} J A B a E α).X₁ ⟶ G) :
    DerivedCategory.Ext (DerivedCategory.Q.obj
        (presentationNaiveCotangentComplex.{v, u, max w u v, w} J A B a E α))
      ((DerivedCategory.singleFunctor _ 0).obj G) 1 :=
  DerivedCategory.Q.map (HomologicalComplex.mkHomToSingle
      (eqToHom (presentationNaiveCotangentComplex_X_negOne J A B a E α) ≫ f)
      (by
        intro i hi
        have hi' : i ≠ (-1 : ℤ) := by
          intro h
          subst i
          simp at hi
        have hi'' : i ≠ (0 : ℤ) := by
          intro h
          subst i
          simp at hi
        exact (presentationNaiveCotangentComplex_isZero_X.{v, u, max w u v, w} J A B a E α i
          hi' hi'').eq_of_src _ _)) ≫
    ((DerivedCategory.singleFunctors _).shiftIso (1 : ℤ) (-1) 0 (by decide)).inv.app G

omit [J.HasSheafCompose (forget₂ CommRingCat.{max w u v} RingCat.{max w u v})]
  [HasDerivedCategory.{t}
    (_root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B))] in
/-- In degree `0` the inclusion of the degree `0` term of `NL(α)` is the canonical
identification of that term. -/
private lemma presentationDegreeZeroInclusion_f_zero :
    (presentationDegreeZeroInclusion.{v, u, w} J A B a E α).f 0 =
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0
        (presentationConormalSequence.{v, u, max w u v, w} J A B a E α).X₂).hom ≫
        eqToHom (presentationNaiveCotangentComplex_X_zero J A B a E α).symm := by
  let : HasZeroObject
      (_root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B)) :=
    hasZeroObject_of_hasTerminal_object
  have h₁ : (HomologicalComplex.doubleXIso₁
      (presentationConormalSequence.{v, u, max w u v, w} J A B a E α).f
      (show (ComplexShape.up ℤ).Rel (-1) 0 from by decide) (by decide)).inv =
      eqToHom (presentationNaiveCotangentComplex_X_zero J A B a E α).symm := by
    simp only [HomologicalComplex.doubleXIso₁]
    congr 1
  refine Eq.trans (doubleInclusion_f_zero _) ?_
  exact congrArg (fun k => (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0
    (presentationConormalSequence.{v, u, max w u v, w} J A B a E α).X₂).hom ≫ k) h₁

omit [J.HasSheafCompose (forget₂ CommRingCat.{max w u v} RingCat.{max w u v})] in
/-- A first Ext class of `NL(α)` whose restriction to the degree `0` term vanishes is the class
of a homomorphism out of the conormal sheaf. -/
private lemma exists_conormalHom_of_restriction_eq_zero
    (ξ : DerivedCategory.Ext (DerivedCategory.Q.obj
        (presentationNaiveCotangentComplex.{v, u, max w u v, w} J A B a E α))
      ((DerivedCategory.singleFunctor _ 0).obj G) 1)
    (hξ : DerivedCategory.Q.map
      (presentationDegreeZeroInclusion.{v, u, w} J A B a E α) ≫ ξ = 0) :
    ∃ f : (presentationConormalSequence.{v, u, max w u v, w} J A B a E α).X₁ ⟶ G,
      ξ = presentationConormalExtClass.{v, u, w, t} J A B a E α G f := by
  let : HasZeroObject
      (_root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B)) :=
    hasZeroObject_of_hasTerminal_object
  obtain ⟨f, hf, hclass⟩ := exists_hom_eq_of_restriction_eq_zero G
    (presentationConormalSequence.{v, u, max w u v, w} J A B a E α).f ξ hξ
  have key : eqToHom (presentationNaiveCotangentComplex_X_negOne J A B a E α) ≫
      (eqToHom (presentationNaiveCotangentComplex_X_negOne J A B a E α).symm ≫ f) = f :=
    (eqToHom_trans_assoc _ _ f).trans (Category.id_comp f)
  refine ⟨eqToHom (presentationNaiveCotangentComplex_X_negOne J A B a E α).symm ≫ f, ?_⟩
  refine hclass.trans ?_
  refine congrArg (fun k => DerivedCategory.Q.map k ≫
    ((DerivedCategory.singleFunctors _).shiftIso (1 : ℤ) (-1) 0 (by decide)).inv.app G) ?_
  apply HomologicalComplex.to_single_hom_ext
  rw [HomologicalComplex.mkHomToSingle_f, HomologicalComplex.mkHomToSingle_f]
  exact congrArg (fun k => k ≫
    (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) (-1) G).inv) key.symm

end ExtClass

/-! ### Representing a first Ext class by a conormal homomorphism -/

section Existence

open Stacks.Sites.FreeAlgebra Stacks.Sites.Conormal
open AlgebraicGeometry.SheafOfModules (moduleOfDifferentialsOfSite universalDerivationOfSite)

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  [HasWeakSheafify J CommRingCat.{max w u v}]
  [J.HasSheafCompose (forget₂ CommRingCat.{max w u v} RingCat.{max w u v})]
  (A B : Sheaf J CommRingCat.{max w u v}) (a : A ⟶ B)
  [HasSheafify J AddCommGrpCat.{max w u v}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{max w u v}]
  [HasDerivedCategory.{t}
    (_root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B))]
  (G : _root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B))

/-- Let `A ⟶ B` be a homomorphism of sheaves of rings on a site, let `G` be a `B`-module and let
`ξ` be a first Ext class of the naive cotangent complex `NL_{B/A}` with values in `G`. Then there
is a map of sheaves of sets `α : E ⟶ B` presenting `B` over `A` for which `ξ`, viewed in
`Ext¹_B(NL(α), G)` along the canonical comparison map, is the class of a homomorphism `I/I² ⟶ G`
out of the conormal sheaf of the presentation, with `α` itself locally
surjective, as the source's construction `ℰ = ℬ ×_Ω ℋ` gives it. -/
theorem exists_locallySurjective_presentation_conormalExtClass
    (ξ : DerivedCategory.Ext (DerivedCategory.Q.obj
        (naiveCotangentComplex.{v, u, max w u v, w} J A B a))
      ((DerivedCategory.singleFunctor _ 0).obj G) 1) :
    ∃ (E : Sheaf J (Type (max w u v))) (α : E.obj ⟶ underlyingPresheaf J B)
      (_ : Presheaf.IsLocallySurjective J α)
      (hsurj : Presheaf.IsLocallySurjective J (presentation J A B a E.obj α).hom),
      letI : Presheaf.IsLocallySurjective J (presentation J A B a E.obj α).hom := hsurj
      ∃ f : (presentationConormalSequence.{v, u, max w u v, w} J A B a E.obj α).X₁ ⟶ G,
        DerivedCategory.Q.map
            (naiveCotangentComplexComparison.{v, u, max w u v, w} J A B a E.obj α) ≫ ξ =
          presentationConormalExtClass.{v, u, w, t} J A B a E.obj α G f := by
  classical
  let : HasZeroObject
      (_root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B)) :=
    hasZeroObject_of_hasTerminal_object
  let : HasExt.{t} (_root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B)) :=
    hasExt_of_hasDerivedCategory _
  have hBsheaf : Presheaf.IsSheaf J (underlyingPresheaf J B) :=
    (Presheaf.isSheaf_iff_isSheaf_comp J B.obj (forget CommRingCat.{max w u v})).mp B.property
  let Bset : Sheaf J (Type (max w u v)) := ⟨underlyingPresheaf J B, hBsheaf⟩
  let S₀ := presentationConormalSequence.{v, u, max w u v, w} J A B a
    (underlyingPresheaf J B) (𝟙 _)
  let ξ₀ : (DerivedCategory.singleFunctor
      (_root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B)) 0).obj S₀.X₂ ⟶
      ((DerivedCategory.singleFunctor
        (_root_.SheafOfModules.{max w u v} (Stacks.SheafOfModules.Tensor.ringSheaf B)) 0).obj
          G)⟦(1 : ℤ)⟧ :=
    DerivedCategory.Q.map (doubleInclusion S₀.f) ≫ ξ
  obtain ⟨H, iH, pH, hH, hS, hExt⟩ := exists_shortExact_representing_extOne S₀.X₂ G ξ₀
  let Mset := (sheafCompose J (forget AddCommGrpCat.{max w u v})).obj
    ((_root_.SheafOfModules.toSheaf (Stacks.SheafOfModules.Tensor.ringSheaf B)).obj S₀.X₂)
  let Hset := (sheafCompose J (forget AddCommGrpCat.{max w u v})).obj
    ((_root_.SheafOfModules.toSheaf (Stacks.SheafOfModules.Tensor.ringSheaf B)).obj H)
  let pSet : Hset ⟶ Mset := (sheafCompose J (forget AddCommGrpCat.{max w u v})).map
    ((_root_.SheafOfModules.toSheaf (Stacks.SheafOfModules.Tensor.ringSheaf B)).map pH)
  have : Epi pH := hS.epi_g
  have hpSet : Presheaf.IsLocallySurjective J pSet.hom :=
    (Presheaf.isLocallySurjective_iff_whisker_forget J _).mp
      (EpiMono.isLocallySurjective_of_epi pH)
  let Ωc := moduleOfDifferentialsOfSite.{v, u, max w u v, w} A
    (freeAlgebraSheaf J A (underlyingPresheaf J B))
    (freeAlgebraSheafCoefficientMap J A (underlyingPresheaf J B))
  let adj := _root_.SheafOfModules.pullbackPushforwardAdjunction
    (underlyingRingHomForPullback J (freeAlgebraSheaf J A (underlyingPresheaf J B)) B
      (presentation J A B a (underlyingPresheaf J B) (𝟙 _)))
  let iso := tensorDifferentialsIso.{v, u, max w u v, w} J A
    (freeAlgebraSheaf J A (underlyingPresheaf J B)) B
    (freeAlgebraSheafCoefficientMap J A (underlyingPresheaf J B))
    (presentation J A B a (underlyingPresheaf J B) (𝟙 _))
  let univ := universalDerivationOfSite.{v, u, max w u v, w} A
    (freeAlgebraSheaf J A (underlyingPresheaf J B))
    (freeAlgebraSheafCoefficientMap J A (underlyingPresheaf J B))
  let vars := freeAlgebraSheafVariable J A (underlyingPresheaf J B)
  let genNat : Bset.obj ⟶ (sheafToPresheaf J (Type (max w u v))).obj Mset :=
    { app := fun X => TypeCat.ofHom fun e =>
        iso.inv.val.app X ((adj.unit.app Ωc).val.app X (univ.d (vars.app X e)))
      naturality := by
        intro X Y f
        ext e
        change iso.inv.val.app Y ((adj.unit.app Ωc).val.app Y
            (univ.d (vars.app Y ((underlyingPresheaf J B).map f e)))) =
          S₀.X₂.val.map f (iso.inv.val.app X
            ((adj.unit.app Ωc).val.app X (univ.d (vars.app X e))))
        have h2 : univ.d ((underlyingPresheaf J
              (freeAlgebraSheaf J A (underlyingPresheaf J B))).map f (vars.app X e)) =
            Ωc.val.map f (univ.d (vars.app X e)) := univ.d_map f (vars.app X e)
        rw [NatTrans.naturality_apply vars f e, h2]
        exact (congrArg (fun y => iso.inv.val.app Y y)
            (PresheafOfModules.naturality_apply (adj.unit.app Ωc).val f
              (univ.d (vars.app X e)))).trans
          (PresheafOfModules.naturality_apply iso.inv.val f _) }
  let gen : Bset ⟶ Mset := (fullyFaithfulSheafToPresheaf J (Type (max w u v))).homEquiv.symm genNat
  have hgen : ∀ (X : Cᵒᵖ) (e : (underlyingPresheaf J B).obj X),
      gen.hom.app X e = tensorDifferential.{v, u, max w u v, w} J A
        (freeAlgebraSheaf J A (underlyingPresheaf J B)) B
        (freeAlgebraSheafCoefficientMap J A (underlyingPresheaf J B))
        (presentation J A B a (underlyingPresheaf J B) (𝟙 _)) X (vars.app X e) := by
    intro X e
    exact tensorDifferentialsIso_inv_d.{v, u, max w u v, w} J A
      (freeAlgebraSheaf J A (underlyingPresheaf J B)) B
      (freeAlgebraSheafCoefficientMap J A (underlyingPresheaf J B))
      (presentation J A B a (underlyingPresheaf J B) (𝟙 _)) X _
  let E' := Limits.pullback gen pSet
  let πE : E' ⟶ Bset := Limits.pullback.fst gen pSet
  let liftGen : E' ⟶ Hset := Limits.pullback.snd gen pSet
  have hGen : πE ≫ gen = liftGen ≫ pSet := Limits.pullback.condition
  have hπ : Presheaf.IsLocallySurjective J πE.hom :=
    isLocallySurjective_pullback_fst J gen pSet
  have hsurj' : Presheaf.IsLocallySurjective J
