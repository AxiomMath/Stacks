module

public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.FiniteTypeIdealSheaf
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.DerivedCompletionRinged.LocalizationAtGlobalSection
public import StacksFrontier.CategoryTheory.Sites.Modules.AdicQuotientModuleTower
public import Mathlib.Algebra.Homology.ShortComplex.ModuleCat
public import Mathlib.Algebra.Category.ModuleCat.Presheaf.EpiMono

/-!
# The one-point ringed site of a commutative ring

Let `A` be a commutative ring. This file builds the ringed site with one object, the chaotic
topology and constant structure sheaf `A`, and records what computing on it needs: sheaves of
modules there are presheaves of modules, a short complex of them is short exact as soon as its
sections over the point are, and for `x ∈ A` the sections of the powers of the sheaf of ideals
`(x)` over the point are the principal ideals `xⁿ A`.

## Main definitions

* `Stacks.PointRingedSite.site`: the ringed site.
* `Stacks.PointRingedSite.idealX`: the sheaf of ideals generated by `x ∈ A`.
* `Stacks.PointRingedSite.mulEnd`: multiplication by `a ∈ A` on sheaves of modules.

## Main results

* `Stacks.PointRingedSite.forget_isEquivalence`: on the chaotic site, sheaves of modules are
  presheaves of modules.
* `Stacks.PointRingedSite.shortExact_of_evaluation`: a short complex of sheaves of modules is
  short exact as soon as its sections over the point are.
* `Stacks.PointRingedSite.mem_idealPow_iff`: the sections of `(x)ⁿ` over the point are `xⁿ A`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry

namespace Stacks.PointRingedSite

universe u

variable (A : Type u) [CommRing A]

/-- **The one-point ringed site of `A`**: one object, the chaotic topology, and the constant
structure sheaf `A`. -/
def site : RingedSite.{u, u, u} where
  C := Discrete PUnit.{u + 1}
  J := ⊥
  O := ⟨(Functor.const _).obj (CommRingCat.of A), Presheaf.isSheaf_bot _⟩

/-- The unique object of the site. -/
def pt : (site A).C := ⟨⟨⟩⟩

/-- Every object of the site is the point. -/
theorem eq_pt (U : (site A).C) : U = pt A := by
  rcases U with ⟨⟨⟩⟩
  rfl

/-- Every object of the opposite category of the site is `op` of the point. -/
theorem eq_op_pt (U : (site A).Cᵒᵖ) : U = op (pt A) := by
  rcases U with ⟨⟨⟨⟩⟩⟩
  rfl

attribute [local instance] AlgebraicGeometry.RingedSite.hasSheafCompose_forget₂_ringCat

/-- The structure sheaf maps every arrow to the identity. -/
theorem ringSheaf_map {U V : (site A).Cᵒᵖ} (g : U ⟶ V)
    (a : (Stacks.SheafOfModules.Tensor.ringSheaf (site A).O).obj.obj U) :
    (Stacks.SheafOfModules.Tensor.ringSheaf (site A).O).obj.map g a = a := rfl

section Modules

/-- On the chaotic site every presheaf of modules is a sheaf. -/
instance forget_essSurj :
    (SheafOfModules.forget (Stacks.SheafOfModules.Tensor.ringSheaf (site A).O)).EssSurj where
  mem_essImage P := ⟨⟨P, Presheaf.isSheaf_bot _⟩, ⟨Iso.refl _⟩⟩

/-- **On the chaotic site, sheaves of modules are presheaves of modules.** -/
instance forget_isEquivalence :
    (SheafOfModules.forget (Stacks.SheafOfModules.Tensor.ringSheaf (site A).O)).IsEquivalence where

/-- Sections over the point. -/
abbrev ev : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf (site A).O) ⥤
    ModuleCat.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf (site A).O).obj.obj (op (pt A))) :=
  SheafOfModules.forget _ ⋙ PresheafOfModules.evaluation _ (op (pt A))

/-- Taking sections over the point is faithful. -/
instance ev_faithful : (ev A).Faithful where
  map_injective {M N} f g h := by
    refine SheafOfModules.Hom.ext (PresheafOfModules.hom_ext fun U => ?_)
    obtain rfl := eq_op_pt A U
    exact h

/-- Taking sections over the point preserves finite limits. -/
instance ev_preservesFiniteLimits : PreservesFiniteLimits (ev A) :=
  comp_preservesFiniteLimits _ _

/-- Taking sections over the point preserves finite colimits. -/
instance ev_preservesFiniteColimits : PreservesFiniteColimits (ev A) :=
  comp_preservesFiniteColimits _ _

/-- **A short complex of sheaves of modules on the point is short exact as soon as its sections
over the point are.** -/
theorem shortExact_of_evaluation
    {S : ShortComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf (site A).O))}
    (h : (S.map (ev A)).ShortExact) : S.ShortExact where
  exact := (S.exact_map_iff_of_faithful (ev A)).1 h.exact
  mono_f := (ev A).mono_of_mono_map h.mono_f
  epi_g := (ev A).epi_of_epi_map h.epi_g

end Modules

section Ideal

/-- The global section of the structure sheaf with value `a` everywhere. -/
def constSection (a : A) :
    Presheaf.globalSections ((site A).O.obj ⋙ forget CommRingCat.{u}) :=
  (Presheaf.globalSectionsEquivSections _).symm ⟨fun _ => a, fun _ => rfl⟩

/-- The global section `constSection A a` has value `a` over every object. -/
@[simp]
theorem globalSectionVal_constSection (a : A) (U : (site A).Cᵒᵖ) :
    RingedSite.globalSectionVal (constSection A a) U = a := by
  simp only [RingedSite.globalSectionVal, constSection, Equiv.apply_symm_apply]
  rfl

/-- The family with value `a` everywhere, as a compatible family of local sections of the
underlying sheaf of rings. -/
def constFamily (a : A) :
    ((Stacks.SheafOfModules.Tensor.ringSheaf (site A).O).obj ⋙ forget RingCat.{u}).sections :=
  ⟨fun _ => a, fun _ => rfl⟩

/-- Multiplication by `a ∈ A`, as an endomorphism of the identity functor of sheaves of
modules. -/
abbrev mulEnd (a : A) :
    End (𝟭 (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf (site A).O))) :=
  Stacks.SheafOfModules.globalSectionToEnd (Stacks.SheafOfModules.Tensor.ringSheaf (site A).O)
    (constFamily A a)

/-- **The sheaf of ideals `ℐ = (x)`.** -/
def idealX (x : A) :
    SheafOfModules.Submodule
      (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf (site A).O)) :=
  RingedSite.idealOfGlobalSections (site A) ![constSection A x]

/-- A covering sieve of the chaotic site contains the identity. -/
theorem id_mem_of_mem_J {U : (site A).C} {S : Sieve U} (hS : S ∈ (site A).J U) : S (𝟙 U) := by
  change S ∈ (⊥ : GrothendieckTopology _) U at hS
  rw [GrothendieckTopology.bot_covering] at hS
  rw [hS]
  trivial

/-- An element of `A`, read in the ring of sections of the structure sheaf over the point. -/
abbrev toO (a : A) : (site A).O.obj.obj (op (pt A)) := a

/-- **The sections of `ℐ` over the point are `x A`.** -/
theorem sectionIdeal_idealX (x : A) :
    Stacks.Sites.sectionIdeal (idealX A x) (op (pt A)) = Ideal.span {(toO A x)} := by
  have hspan : Ideal.span (Set.range (RingedSite.restrictGlobalSections (site A)
      ![constSection A x] (op (pt A)))) = Ideal.span {(toO A x)} := by
    congr 1
    ext b
    simp only [Set.mem_range, Fin.exists_fin_one, Matrix.cons_val_fin_one,
      RingedSite.restrictGlobalSections, globalSectionVal_constSection]
    exact eq_comm
  ext s
  refine ⟨fun h => ?_, fun h =>
    RingedSite.mem_idealOfGlobalSections_of_mem_span (site A) _ (op (pt A)) (hspan ▸ h)⟩
  obtain ⟨S, hS, hmem⟩ := (RingedSite.mem_idealOfGlobalSections_iff (site A) _ (op (pt A))).1 h
  rw [← hspan]
  exact hmem (𝟙 _) (id_mem_of_mem_J A hS)

/-- **The sections of `ℐⁿ` over the point are `xⁿ A`.** -/
theorem mem_idealPow_iff (x : A) (n : ℕ) (s : (site A).O.obj.obj (op (pt A))) :
    s ∈ (Stacks.Sites.idealPow (idealX A x) n).obj (op (pt A)) ↔
      s ∈ Ideal.span {toO A x ^ n} := by
  rw [← Ideal.span_singleton_pow, ← sectionIdeal_idealX]
  refine ⟨fun h => ?_, Stacks.Sites.mem_idealPow_of_mem_pow (idealX A x) n⟩
  have h' : s ∈ (Stacks.SheafOfModules.sheafifySubmodule
      (Stacks.Sites.presheafIdealPow (J := (site A).J) (O := (site A).O) (idealX A x) n)).obj
        (op (pt A)) := h
  obtain ⟨S, hS, hmem⟩ := Stacks.SheafOfModules.mem_sheafifySubmodule_iff.1 h'
  exact hmem (𝟙 _) (id_mem_of_mem_J A hS)

end Ideal

end Stacks.PointRingedSite
