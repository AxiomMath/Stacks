public import Mathlib.Combinatorics.Quiver.ReflQuiver
import StacksCore.Tactic.EgaSgaAttribute

@[expose] public section

set_option backward.isDefEq.respectTransparency false

/-
# Problem Description (Stacks Tag 04ES)

Fix a site `C` (a category with a Grothendieck topology `J`) and a ringed site
`(C, O)`, i.e. `O` is a sheaf of commutative unital rings on `C`.

For an object `U` we write `O(U) = O.1.obj (op U)` for the ring of sections, and
for a morphism `g : V ⟶ U` the restriction `f|_V` is `O.1.map g.op f`, a ring
homomorphism (so it preserves `1`, products and `1 - f`).

We prove the equivalence of three conditions:

1. For every object `U` and every `f ∈ O(U)` there is a covering `{U_j → U}` such
   that for each member either `f|_{U_j}` is invertible or `(1 - f)|_{U_j}` is
   invertible.

2. For every object `U`, every `n ≥ 1` and all `f_1, …, f_n ∈ O(U)` generating the
   unit ideal, there is a covering `{U_j → U}` such that on each member some
   `f_i|_{U_j}` is invertible.

3. The map of sheaves of sets
        `(O × O) ⨿ (O × O) ⟶ O × O`,
   sending `(f, a)` (first component) to `(f, a·f)` and `(f, b)` (second component)
   to `(f, b·(1 - f))`, is surjective (an epimorphism in the sheaf topos).

The goal is to prove `(1) ↔ (2) ↔ (3)`.
-/

/-
## Notes on the formalization

* Coverings `{U_j → U}_{j ∈ J}` of the Grothendieck topology are modelled by
  covering sieves `S ∈ J U`; "for every member of the covering" becomes "for every
  arrow `g : V ⟶ U` in `S`". This is the standard Mathlib idiom and is equivalent to
  using presieves/covers, since a sieve is generated by any covering family and `J`
  is a Grothendieck (sieve) topology.

* "Invertible" means "is a unit of the ring", i.e. `IsUnit`.

* Statement (3). As emphasized in the problem statement, surjectivity of a map of
  sheaves of *sets* means surjectivity in the sheaf topos, i.e. the *local
  surjectivity* condition: every section of the target is, on some covering,
  locally in the image of the map. For the specific map of Definition 3 this local
  surjectivity is exactly the following elementary condition, which is therefore the
  faithful operative content of statement (3):

    for every object `U` and every section `(f, c) ∈ O(U) × O(U)` there is a covering
    `{U_j → U}` such that on each member `(f, c)|_{U_j}` is in the image, i.e. either
      `∃ a, c|_{U_j} = a · f|_{U_j}`   (the section comes from the first component
                                        `(f, a) ↦ (f, a·f)`), or
      `∃ b, c|_{U_j} = b · (1 - f)|_{U_j}`  (it comes from the second component
                                        `(f, b) ↦ (f, b·(1 - f))`).

  (The first coordinate `f` is automatically preserved by the map, so being in the
  image only constrains the second coordinate `c`.) We take this elementwise
  local-surjectivity condition as the Lean rendering of statement (3); a
  `correctness` comment records its meaning.
-/

namespace Stacks.Sheaves.LocallyRingedSite

open CategoryTheory Opposite

universe v u

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}

/-- The ring of sections of the structure sheaf `O` over an object `U`. -/
abbrev sections (O : Sheaf J CommRingCat.{v}) (U : C) : Type v := O.1.obj (op U)

/-- Restriction of a section `f ∈ O(U)` along a morphism `g : V ⟶ U`. -/
abbrev restrict (O : Sheaf J CommRingCat.{v}) {U V : C} (g : V ⟶ U)
    (f : sections O U) : sections O V := (O.1.map g.op) f

/-- Restriction is a ring homomorphism (it preserves `1`). -/
example (O : Sheaf J CommRingCat.{v}) {U V : C} (g : V ⟶ U) :
    restrict O g (1 : sections O U) = 1 := by
  simp [restrict]

-- ## Main Definition(s)

/-- **Definition 1 (Invertible section).** A section `g ∈ O(U)` is *invertible* iff it
is a unit of the ring `O(U)`. -/
def Invertible (O : Sheaf J CommRingCat.{v}) {U : C} (g : sections O U) : Prop :=
  IsUnit g

/-- **Definition 2 (Generating the unit ideal).** Sections `f : Fin n → O(U)` generate
the unit ideal iff there exist coefficients `a : Fin n → O(U)` with
`∑ i, a i * f i = 1`. -/
def GeneratesUnitIdeal (O : Sheaf J CommRingCat.{v}) {U : C} {n : ℕ}
    (f : Fin n → sections O U) : Prop :=
  ∃ a : Fin n → sections O U, (∑ i, a i * f i) = 1

/-- A predicate `P` on the members of a covering of `U` holds *locally*: there is a
covering sieve `S ∈ J U` such that `P` holds for every arrow in `S`. This is the
formal meaning of "there exists a covering `{U_j → U}` such that for each `j`, …". -/
def LocallyOnCovering (J : GrothendieckTopology C) (U : C)
    (P : ⦃V : C⦄ → (V ⟶ U) → Prop) : Prop :=
  ∃ S : Sieve U, S ∈ J U ∧ ∀ ⦃V : C⦄ (g : V ⟶ U), S.arrows g → P g

-- ## Main Statement(s)

/-- **Condition (1).** For every `U` and `f ∈ O(U)` there is a covering on each member
of which either `f` or `1 - f` restricts to a unit. -/
def Condition1 (O : Sheaf J CommRingCat.{v}) : Prop :=
  ∀ (U : C) (f : sections O U),
    LocallyOnCovering J U
      (fun {_} g => Invertible O (restrict O g f) ∨ Invertible O (restrict O g (1 - f)))

/-- **Condition (2).** For every `U`, every `n ≥ 1`, and all `f : Fin n → O(U)`
generating the unit ideal, there is a covering on each member of which some `f i`
restricts to a unit. -/
def Condition2 (O : Sheaf J CommRingCat.{v}) : Prop :=
  ∀ (U : C) (n : ℕ), 0 < n → ∀ (f : Fin n → sections O U), GeneratesUnitIdeal O f →
    LocallyOnCovering J U
      (fun {_} g => ∃ i : Fin n, Invertible O (restrict O g (f i)))

/-- **Condition (3).** Local surjectivity of the map of sheaves of sets
`(O × O) ⨿ (O × O) ⟶ O × O` of Definition 3: for every `U` and every section
`(f, c)` of `O × O`, there is a covering on each member of which `(f, c)` is locally
in the image, i.e. either `c|_V = a · f|_V` for some `a` (first component) or
`c|_V = b · (1 - f)|_V` for some `b` (second component). -/
def Condition3 (O : Sheaf J CommRingCat.{v}) : Prop :=
  ∀ (U : C) (f c : sections O U),
    LocallyOnCovering J U
      (fun {V} g =>
        (∃ a : sections O V, restrict O g c = a * restrict O g f) ∨
        (∃ b : sections O V, restrict O g c = b * restrict O g (1 - f)))

-- ## Auxiliary lemmas

/-- Restriction is functorial: `f|_(g'≫g) = (f|_g)|_g'`. -/
theorem restrict_comp (O : Sheaf J CommRingCat.{v}) {U V W : C} (g : V ⟶ U)
    (g' : W ⟶ V) (f : sections O U) :
    restrict O (g' ≫ g) f = restrict O g' (restrict O g f) := by
  simp [restrict]

/-- Restriction is multiplicative: `(a * b)|_g = a|_g * b|_g`. -/
theorem restrict_mul (O : Sheaf J CommRingCat.{v}) {U V : C} (g : V ⟶ U)
    (a b : sections O U) :
    restrict O g (a * b) = restrict O g a * restrict O g b := by
  simp [restrict]

/-- Restriction preserves the unit section: `1|_g = 1`. -/
theorem restrict_one (O : Sheaf J CommRingCat.{v}) {U V : C} (g : V ⟶ U) :
    restrict O g (1 : sections O U) = 1 := by
  simp [restrict]

/-- Restriction commutes with subtraction: `(a - b)|_g = a|_g - b|_g`. -/
theorem restrict_sub (O : Sheaf J CommRingCat.{v}) {U V : C} (g : V ⟶ U)
    (a b : sections O U) :
    restrict O g (a - b) = restrict O g a - restrict O g b := by
  simp [restrict]

/-- Restriction sends units to units. -/
theorem isUnit_restrict (O : Sheaf J CommRingCat.{v}) {U V : C} (g : V ⟶ U)
    {f : sections O U} (h : IsUnit f) : IsUnit (restrict O g f) :=
  h.map (O.1.map g.op).hom

/-- **Refinement / transitivity for `LocallyOnCovering`.**
If there is a covering `S` of `U`, and on each member `g : V ⟶ U` of `S` the
predicate `P` holds locally after precomposition, then `P` holds locally on `U`. -/
theorem LocallyOnCovering.refine {U : C} (P : ⦃V : C⦄ → (V ⟶ U) → Prop)
    (S : Sieve U) (hS : S ∈ J U)
    (h : ∀ ⦃V : C⦄ (g : V ⟶ U), S.arrows g →
      LocallyOnCovering J V (fun {_} g' => P (g' ≫ g))) :
    LocallyOnCovering J U P := by
  -- Choose, for each member of `S`, an inner covering sieve.
  choose R hR hRP using h
  refine ⟨Sieve.bind S.arrows R, ?_, ?_⟩
  · exact J.bind_covering hS (fun _ _ H => hR _ H)
  · rintro Z k hk
    obtain ⟨V, g', g, H, hg', rfl⟩ := hk
    exact hRP g H g' hg'

/-- If a predicate holds for all arrows of a covering and is implied by a weaker
predicate, then the weaker form also holds locally. -/
theorem LocallyOnCovering.mono {U : C} {P Q : ⦃V : C⦄ → (V ⟶ U) → Prop}
    (h : LocallyOnCovering J U P)
    (hPQ : ∀ ⦃V : C⦄ (g : V ⟶ U), P g → Q g) :
    LocallyOnCovering J U Q := by
  obtain ⟨S, hS, hP⟩ := h
  exact ⟨S, hS, fun _ g hg => hPQ g (hP g hg)⟩

-- ## Main proofs

/-- `(2) ⟹ (1)`. Apply (2) to `(f, 1 - f)`. -/
theorem condition2_imp_condition1 (O : Sheaf J CommRingCat.{v})
    (h2 : Condition2 O) : Condition1 O := by
  intro U f
  refine (h2 U 2 (by norm_num) ![f, 1 - f] ⟨![1, 1], by simp [Fin.sum_univ_two]⟩).mono ?_
  exact fun _ _ h => Fin.exists_fin_two.1 h

/-- `(3) ⟹ (1)`. Apply (3) to the section `(f, 1)`. -/
theorem condition3_imp_condition1 (O : Sheaf J CommRingCat.{v})
    (h3 : Condition3 O) : Condition1 O := by
  intro U f
  refine (h3 U f 1).mono ?_
  rintro V g h
  have key : ∀ x : sections O V, (∃ a, restrict O g 1 = a * x) → Invertible O x :=
    fun x ⟨a, ha⟩ => IsUnit.of_mul_eq_one_right a (by rw [← ha, restrict_one])
  exact h.imp (key _) (key _)

/-- `(1) ⟹ (3)`. Given `(f, c)`, refine on units of `f` / `1 - f`. -/
theorem condition1_imp_condition3 (O : Sheaf J CommRingCat.{v})
    (h1 : Condition1 O) : Condition3 O := by
  intro U f c
  refine (h1 U f).mono ?_
  rintro V g h
  have key : ∀ x : sections O V, Invertible O x → ∃ b, restrict O g c = b * x :=
    fun x ⟨u, hu⟩ => ⟨restrict O g c * ↑u⁻¹, by rw [mul_assoc, ← hu, Units.inv_mul, mul_one]⟩
  exact h.imp (key _) (key _)

/-- Two-element case of `(1) ⟹ (2)`: if `a₀ f₀ + a₁ f₁ = 1` then locally `f₀` or
`f₁` is a unit. -/
theorem condition1_two (O : Sheaf J CommRingCat.{v}) (h1 : Condition1 O)
    {U : C} (f₀ f₁ a₀ a₁ : sections O U) (hgen : a₀ * f₀ + a₁ * f₁ = 1) :
    LocallyOnCovering J U
      (fun {_} g => Invertible O (restrict O g f₀) ∨ Invertible O (restrict O g f₁)) := by
  refine (h1 U (a₀ * f₀)).mono ?_
  rintro V g (hf | hf)
  · rw [restrict_mul] at hf
    exact Or.inl (isUnit_of_mul_isUnit_right hf)
  · rw [show (1 : sections O U) - a₀ * f₀ = a₁ * f₁ by rw [← hgen]; ring,
      restrict_mul] at hf
    exact Or.inr (isUnit_of_mul_isUnit_right hf)

/-- Generalized `(1) ⟹ (2)`, with `U` universally quantified to make the induction
on `n` go through. -/
theorem condition1_gen (O : Sheaf J CommRingCat.{v}) (h1 : Condition1 O) :
    ∀ (n : ℕ), 0 < n → ∀ (U : C) (f : Fin n → sections O U), GeneratesUnitIdeal O f →
      LocallyOnCovering J U
        (fun {_} g => ∃ i : Fin n, Invertible O (restrict O g (f i))) := by
  intro n
  induction n with
  | zero => exact fun h => absurd h (Nat.lt_irrefl 0)
  | succ m ih =>
    intro _ U f ⟨a, ha⟩
    rcases Nat.eq_zero_or_pos m with rfl | hm
    · have hf0 : a 0 * f 0 = 1 := by simpa [Fin.sum_univ_one] using ha
      exact ⟨⊤, J.top_mem U, fun V g _ =>
        ⟨0, isUnit_restrict O g (IsUnit.of_mul_eq_one_right (a 0) hf0)⟩⟩
    · have hsum : a (Fin.last m) * f (Fin.last m) +
          1 * ∑ i : Fin m, a i.castSucc * f i.castSucc = 1 := by
        rw [Fin.sum_univ_castSucc] at ha
        rwa [one_mul, add_comm]
      obtain ⟨S, hS, hP⟩ := condition1_two O h1 (f (Fin.last m))
        (∑ i : Fin m, a i.castSucc * f i.castSucc) (a (Fin.last m)) 1 hsum
      refine LocallyOnCovering.refine _ S hS fun V g hg => ?_
      rcases hP g hg with hfl | hdl
      · exact ⟨⊤, J.top_mem V, fun W g' _ =>
          ⟨Fin.last m, by rw [restrict_comp]; exact isUnit_restrict O g' hfl⟩⟩
      · have hgenV : GeneratesUnitIdeal O (fun i : Fin m => restrict O g (f i.castSucc)) := by
          obtain ⟨u, hu⟩ := hdl
          refine ⟨fun i => ↑u⁻¹ * restrict O g (a i.castSucc), ?_⟩
          have hsumV :
              ∑ i : Fin m, restrict O g (a i.castSucc) * restrict O g (f i.castSucc) = ↑u := by
            rw [hu]
            simp only [restrict, map_sum, map_mul]
          simp_rw [mul_assoc, ← Finset.mul_sum, hsumV, Units.inv_mul]
        refine (ih hm V _ hgenV).mono ?_
        exact fun W g' ⟨i, hi⟩ => ⟨i.castSucc, by rw [restrict_comp]; exact hi⟩

/-- `(1) ⟹ (2)`. -/
theorem condition1_imp_condition2 (O : Sheaf J CommRingCat.{v})
    (h1 : Condition1 O) : Condition2 O :=
  fun U n hn f hgen => condition1_gen O h1 n hn U f hgen

/-- `(1) ↔ (2)`. -/
theorem condition1_iff_condition2 (O : Sheaf J CommRingCat.{v}) :
    Condition1 O ↔ Condition2 O :=
  ⟨condition1_imp_condition2 O, condition2_imp_condition1 O⟩

/-- `(1) ↔ (3)`. -/
theorem condition1_iff_condition3 (O : Sheaf J CommRingCat.{v}) :
    Condition1 O ↔ Condition3 O :=
  ⟨condition1_imp_condition3 O, condition3_imp_condition1 O⟩

/-- `(2) ↔ (3)`. -/
theorem condition2_iff_condition3 (O : Sheaf J CommRingCat.{v}) :
    Condition2 O ↔ Condition3 O := by
  rw [← condition1_iff_condition2 O, condition1_iff_condition3 O]

/-- **Theorem (Stacks Tag 04ES).** For a ringed site `(C, O)`, conditions (1), (2),
(3) are equivalent. We state the equivalence as the conjunction of the two
biconditionals `(1) ↔ (2)` and `(2) ↔ (3)`. -/
@[stacks 04ES, sga "4 IV 13.9" "b) (ii) <=> (iii)"]
theorem condition1_iff_condition2_and_condition2_iff_condition3
    (O : Sheaf J CommRingCat.{v}) :
    (Condition1 O ↔ Condition2 O) ∧ (Condition2 O ↔ Condition3 O) :=
  ⟨condition1_iff_condition2 O, condition2_iff_condition3 O⟩

end Stacks.Sheaves.LocallyRingedSite
