module

public import Mathlib.RingTheory.Flat.Basic
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FlatSheafification
public import StacksFrontier.CategoryTheory.Sites.Modules.BaseRingTensorInverseLimit

/-!
# `𝒪_X ⊗_R -` preserves injections where `𝒪_X` is locally flat over `R`

Let `(C, J)` be a site with a sheaf of commutative rings `O`, and let `φ : R →+* Γ(C, O)` be a
base ring, so that `M ↦ 𝒪_X ⊗_R M` is `Stacks.Cohomology.SiteModules.baseRingTensorFunctor φ`,
the sheafification of `U ↦ O(U) ⊗_R M`.  If every object of the site is covered by objects `U`
over which `O(U)` is a flat `R`-module, then this functor carries injective `R`-linear maps to
monomorphisms.  This is the exactness input of the first row of the proof of Stacks 0D3F: for
`X` flat over `R` the affine étale charts are such objects.

## Main results

* `CategoryTheory.Presheaf.isLocallyInjective_of_injective_of_ofArrows_mem`: a morphism of
  presheaves which is injective on the members of a covering family of every object is locally
  injective.
* `Stacks.Cohomology.SiteModules.injective_sectionTensor_extendScalars_map`: on sections over an
  object `U` with `O(U)` flat over `R`, the presheaf `U ↦ O(U) ⊗_A (A ⊗_R M)` turns an injection
  into an injection.
* `Stacks.Cohomology.SiteModules.mono_baseRingTensorFunctor_map`: the statement above.

## Implementation notes

The sections over `U` of the presheaf underlying `𝒪_X ⊗_R M` are `O(U) ⊗_A (A ⊗_R M)`, with
`A = Γ(C, O)`; they are compared with `O(U) ⊗_R M` by
`TensorProduct.AlgebraTensorModule.cancelBaseChange`, under which the induced map is
`O(U) ⊗_R g`.  The `R`-algebra structure on `O(U)` is the composite of `φ` with evaluation of a
global function at `U`, recorded as `Stacks.Cohomology.SiteModules.baseRingSectionAlgebra`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite Stacks.SheafOfModules

universe u v r w t

namespace CategoryTheory.Presheaf

/-- **A morphism of presheaves which is injective on the members of a covering family of every
object is locally injective.** Two sections with the same image agree after restriction to each
member of the family, and the sieve on which they agree is a sieve, so it contains the sieve
generated by the family. -/
theorem isLocallyInjective_of_injective_of_ofArrows_mem {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {D : Type*} [Category D] {FD : D → D → Type*}
    {CD : D → Type*} [∀ X Y, FunLike (FD X Y) (CD X) (CD Y)] [ConcreteCategory D FD]
    {F₁ F₂ : Cᵒᵖ ⥤ D} (φ : F₁ ⟶ F₂)
    (hcov : ∀ X : C, ∃ (I : Type t) (Ui : I → C) (f : ∀ i, Ui i ⟶ X),
      Sieve.ofArrows Ui f ∈ J X ∧ ∀ i, Function.Injective (φ.app (op (Ui i)))) :
    IsLocallyInjective J φ where
  equalizerSieve_mem {X} x y h := by
    obtain ⟨I, Ui, f, hS, hinj⟩ := hcov X.unop
    refine J.superset_covering ?_ hS
    rw [Sieve.ofArrows, Sieve.generate_le_iff]
    rintro _ _ ⟨i⟩
    apply hinj i
    show φ.app (op (Ui i)) (F₁.map (f i).op x) = φ.app (op (Ui i)) (F₁.map (f i).op y)
    rw [NatTrans.naturality_apply, NatTrans.naturality_apply, h]

end CategoryTheory.Presheaf

namespace Stacks.Cohomology.SiteModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  [J.HasSheafCompose (forget₂ CommRingCat.{r} RingCat.{r})]
  {O : Sheaf J CommRingCat.{r}} {R : Type t} [CommRing R]

/-- The sections of `O` over an object, as an algebra over a base ring `R` of `O`: the
structure map is a global function's value there. -/
abbrev baseRingSectionAlgebra (φ : R →+* GlobalFunctionRing O) (X : Cᵒᵖ) :
    Algebra R (O.obj.obj X) :=
  ((globalSectionEvalHom O X).comp φ).toAlgebra

/-- Two additive maps out of a tensor product agree if they agree on pure tensors. -/
private theorem tensorProduct_addMonoidHom_ext {S M N T : Type*} [CommSemiring S]
    [AddCommMonoid M] [AddCommMonoid N] [AddCommMonoid T] [Module S M] [Module S N]
    {f g : TensorProduct S M N →+ T} (h : ∀ m n, f (m ⊗ₜ n) = g (m ⊗ₜ n)) : f = g :=
  AddMonoidHom.ext fun t => by
    induction t using TensorProduct.induction_on with
    | zero => simp
    | tmul m n => exact h m n
    | add x y hx hy => simp [hx, hy]

/-- **Over an object `U` with `O(U)` flat over `R`, the presheaf `U ↦ O(U) ⊗_R M` carries an
injection to an injection.**  The sections are `O(U) ⊗_A (A ⊗_R M) ≅ O(U) ⊗_R M`, under which
the induced map is `O(U) ⊗_R g`. -/
theorem injective_sectionTensor_extendScalars_map (φ : R →+* GlobalFunctionRing O) (X : Cᵒᵖ)
    (hflat : letI := baseRingSectionAlgebra φ X; Module.Flat R (O.obj.obj X))
    {M M' : ModuleCat.{w} R} (g : M ⟶ M') (hg : Function.Injective g) :
    Function.Injective (((sectionTensorPresheafFunctor O).map
      ((ModuleCat.extendScalars φ).map g)).app X) := by
  let := φ.toAlgebra
  let := baseRingSectionAlgebra φ X
  have : IsScalarTower R (GlobalFunctionRing O) (O.obj.obj X) :=
    IsScalarTower.of_algebraMap_eq (fun _ => rfl)
  let e : ∀ N : ModuleCat.{w} R, (sectionTensorPresheafObj ((ModuleCat.extendScalars φ).obj N) X) ≃+
      TensorProduct R (O.obj.obj X) N := fun N =>
    (TensorProduct.AlgebraTensorModule.cancelBaseChange R (GlobalFunctionRing O) (O.obj.obj X)
      (O.obj.obj X) N).toAddEquiv
  let F₁ : sectionTensorPresheafObj ((ModuleCat.extendScalars φ).obj M) X →+
      TensorProduct R (O.obj.obj X) M' :=
    (e M').toAddMonoidHom.comp (((sectionTensorPresheafFunctor O).map
      ((ModuleCat.extendScalars φ).map g)).app X).hom.toAddMonoidHom
  let F₂ : sectionTensorPresheafObj ((ModuleCat.extendScalars φ).obj M) X →+
      TensorProduct R (O.obj.obj X) M' :=
    (g.hom.lTensor (O.obj.obj X)).toAddMonoidHom.comp (e M).toAddMonoidHom
  have hF : ∀ t, F₁ t = F₂ t := fun t => by
    refine DFunLike.congr_fun (tensorProduct_addMonoidHom_ext fun b n => ?_) t
    refine DFunLike.congr_fun (tensorProduct_addMonoidHom_ext (f := F₁.comp
      (TensorProduct.mk (GlobalFunctionRing O) (O.obj.obj X)
        ((ModuleCat.extendScalars φ).obj M) b).toAddMonoidHom) (g := F₂.comp
      (TensorProduct.mk (GlobalFunctionRing O) (O.obj.obj X)
        ((ModuleCat.extendScalars φ).obj M) b).toAddMonoidHom) fun a m => rfl) n
  intro s t hst
  exact (e M).injective (Module.Flat.lTensor_preserves_injective_linearMap _ hg
    ((hF s).symm.trans ((congrArg (e M') hst).trans (hF t))))

variable [HasWeakSheafify J AddCommGrpCat.{max u r w}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{max u r w}]

/-- **`𝒪_X ⊗_R -` carries injections to monomorphisms when every object is covered by objects
over which `𝒪_X` is flat over `R`.** On sections over such an object `U` the presheaf
`U ↦ 𝒪(U) ⊗_R M` turns an injection into an injection, so the induced morphism of presheaves is
locally injective, and it becomes a monomorphism after sheafification. -/
theorem mono_baseRingTensorFunctor_map (φ : R →+* GlobalFunctionRing O)
    (hcov : ∀ X : C, ∃ (I : Type t) (Ui : I → C) (f : ∀ i, Ui i ⟶ X),
      Sieve.ofArrows Ui f ∈ J X ∧
        ∀ i, letI := baseRingSectionAlgebra φ (op (Ui i)); Module.Flat R (O.obj.obj (op (Ui i))))
    {M M' : ModuleCat.{max u r w} R} (g : M ⟶ M') (hg : Function.Injective g) :
    Mono ((baseRingTensorFunctor.{u, v, r, w} φ).map g) :=
  FlatSheafification.moduleSheafification_map_mono_of_locallyInjective J (𝟙 (ringSheafOfSite O).obj)
    ((sectionTensorPresheafFunctor O).map ((ModuleCat.extendScalars φ).map g))
    (Presheaf.isLocallyInjective_of_injective_of_ofArrows_mem _ fun X => by
      obtain ⟨I, Ui, f, hS, hfl⟩ := hcov X
      exact ⟨I, Ui, f, hS, fun i =>
        injective_sectionTensor_extendScalars_map φ (op (Ui i)) (hfl i) g hg⟩)

end Stacks.Cohomology.SiteModules

end
