module

public import StacksFrontier.CategoryTheory.Sites.Modules.ConormalLocallyBijective
public import StacksFrontier.CategoryTheory.Sites.Modules.FreeAlgebraSheaf
public import StacksFrontier.RingTheory.NaiveCotangent.PolynomialConormalDerivative

/-!
# A presentation by a free algebra sheaf is locally a polynomial presentation

The free `A`-algebra `A[E]` on a presheaf of sets `E` is the sheafification of the presheaf of
polynomial rings `U ↦ A(U)[E(U)]`, so a section of `A[E]` over `U` is *not* a polynomial in the
sections of `E` over `U`; it is only locally one.  Everything about the conormal sheaf of a
presentation `A[E] ⟶ B` that needs honest polynomials — reading off the coefficient of a
variable, substituting a lift of a generator — therefore has to be done on the presheaf of
polynomial rings and transported.

The transport is available because the sheafification unit is locally bijective and
`Stacks.Sites.FreeAlgebra.freeAlgebraSheafDesc_spec` says that it is a morphism of
presentations: the polynomial presentation `A(U)[E(U)] ⟶ B(U)` factors the presentation
`A[E] ⟶ B` through it.  Hence the kernel and the conormal module of `A[E] ⟶ B` are locally
those of a polynomial presentation.

## Main definitions

* `Stacks.Sites.FreeAlgebra.polynomialUnit`: the sheafification unit `A(-)[E(-)] ⟶ A[E]`, read
  as a change of presentation.

## Main results

* `Stacks.Sites.FreeAlgebra.polynomialUnit_comp_desc` and
  `Stacks.Sites.FreeAlgebra.coefficientMap_comp_polynomialUnit`: the unit is a morphism of
  presentations of `B` over `A`.
* `Stacks.Sites.FreeAlgebra.exists_covering_polynomial_kernelIdeal_lift`: a local section of
  the kernel of `A[E] ⟶ B` is, on a covering, the image of a polynomial in the kernel of the
  polynomial presentation.
* `Stacks.Sites.FreeAlgebra.exists_covering_mem_ker_sq_polynomialUnit`: a polynomial whose image
  in `A[E]` lies in the square of the kernel of `A[E] ⟶ B` lies, on a covering, in the square of
  the kernel of the polynomial presentation.
* `Stacks.Sites.FreeAlgebra.exists_covering_polynomial_conormalMap_eq`: a local section of the
  conormal module of `A[E] ⟶ B` is, on a covering, the image of a conormal class of the
  polynomial presentation.
* `Stacks.Sites.FreeAlgebra.vanishingSieve_mem_of_polynomial_conormalMap_eq_zero`: a conormal
  class of the polynomial presentation killed by that map restricts to zero on a covering.
* `Stacks.Sites.FreeAlgebra.conormalToTensorApp_toCotangent_eq_zero_iff`: the conormal map of
  the polynomial presentation kills the class of a polynomial in the kernel exactly when all of
  its partial derivatives lie in the kernel.

## Implementation notes

Local bijectivity of the unit is the Mathlib instance for `CategoryTheory.toSheafify`, which
needs `J.WEqualsLocallyBijective CommRingCat.{w}` in addition to the hypotheses of the free
algebra sheaf.

## References

* [Stacks Project, Tag 08TU](https://stacks.math.columbia.edu/tag/08TU), the free algebra
  sheaf.
* [Stacks Project, Tag 08TS](https://stacks.math.columbia.edu/tag/08TS), the conormal
  sequence.
* [Stacks Project, Tag 08TY](https://stacks.math.columbia.edu/tag/08TY), whose proof passes to
  the subpresheaf of `B` generated by the variables and to the presheaf kernel there.
-/

@[expose] public section

open CategoryTheory Opposite

universe v u w

namespace Stacks.Sites.FreeAlgebra

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  [HasWeakSheafify J CommRingCat.{w}] [J.WEqualsLocallyBijective CommRingCat.{w}]
  (A B : Sheaf J CommRingCat.{w}) (E : Functor Cᵒᵖ (Type w)) (a : A ⟶ B)
  (e : E ⟶ underlyingPresheaf J B)

/-- The sheafification unit `A(-)[E(-)] ⟶ A[E]` of the presheaf of polynomial rings, read as a
change of presentation from the polynomial presentation to the presentation by the free
algebra sheaf. -/
noncomputable abbrev polynomialUnit :
    polynomialPresheaf J A E ⟶ (freeAlgebraSheaf J A E).obj :=
  toSheafify J (polynomialPresheaf J A E)

/-- The sheafification unit `A(-)[E(-)] ⟶ A[E]` is locally surjective. -/
instance isLocallySurjective_polynomialUnit :
    Presheaf.IsLocallySurjective J (polynomialUnit J A E) :=
  inferInstanceAs (Presheaf.IsLocallySurjective J (toSheafify J (polynomialPresheaf J A E)))

/-- The sheafification unit `A(-)[E(-)] ⟶ A[E]` is locally injective. -/
instance isLocallyInjective_polynomialUnit :
    Presheaf.IsLocallyInjective J (polynomialUnit J A E) :=
  inferInstanceAs (Presheaf.IsLocallyInjective J (toSheafify J (polynomialPresheaf J A E)))

omit [J.WEqualsLocallyBijective CommRingCat.{w}] in
/-- The unit is a morphism of presentations of `B`: the polynomial presentation
`A(U)[E(U)] ⟶ B(U)` is the unit followed by `A[E] ⟶ B`. -/
theorem polynomialUnit_comp_desc :
    polynomialUnit J A E ≫ (freeAlgebraSheafDesc J A B E a e).hom =
      polynomialEvaluation J A B E a e :=
  freeAlgebraSheafDesc_spec J A B E a e

omit [J.WEqualsLocallyBijective CommRingCat.{w}] in
/-- The unit is a morphism of `A`-algebras. -/
theorem coefficientMap_comp_polynomialUnit :
    polynomialCoefficientMap J A E ≫ polynomialUnit J A E =
      (freeAlgebraSheafCoefficientMap J A E).hom :=
  rfl

/-- A local section of the kernel of a presentation `A[E] ⟶ B` is, on a covering sieve, the
image of a polynomial lying in the kernel of the polynomial presentation
`A(U)[E(U)] ⟶ B(U)`. -/
theorem exists_covering_polynomial_kernelIdeal_lift {X : C}
    (x : (freeAlgebraSheaf J A E).obj.obj (op X))
    (hx : x ∈ Conormal.kernelIdeal (freeAlgebraSheafDesc J A B E a e).hom (op X)) :
    ∃ S : Sieve X, S ∈ J X ∧ ∀ (Y : C) (g : Y ⟶ X), S g →
      ∃ q : (polynomialPresheaf J A E).obj (op Y),
        q ∈ Conormal.kernelIdeal (polynomialEvaluation J A B E a e) (op Y) ∧
          (polynomialUnit J A E).app (op Y) q =
            (freeAlgebraSheaf J A E).obj.map g.op x :=
  Conormal.exists_covering_kernelIdeal_lift J (polynomialUnit_comp_desc J A B E a e) x hx

/-- If the image in `A[E]` of a polynomial `p` lies in the square of the kernel ideal of the
presentation `A[E] ⟶ B`, then on a covering sieve every restriction of `p` lies in the square
of the kernel of the polynomial presentation `A(U)[E(U)] ⟶ B(U)`. -/
theorem exists_covering_mem_ker_sq_polynomialUnit {X : C}
    (p : (polynomialPresheaf J A E).obj (op X))
    (hp : (polynomialUnit J A E).app (op X) p ∈
      Conormal.kernelIdeal (freeAlgebraSheafDesc J A B E a e).hom (op X) ^ 2) :
    ∃ S : Sieve X, S ∈ J X ∧ ∀ (Y : C) (g : Y ⟶ X), S g →
      (polynomialPresheaf J A E).map g.op p ∈
        Conormal.kernelIdeal (polynomialEvaluation J A B E a e) (op Y) ^ 2 := by
  refine ⟨⟨fun Y g ↦ (polynomialPresheaf J A E).map g.op p ∈
      Conormal.kernelIdeal (polynomialEvaluation J A B E a e) (op Y) ^ 2, ?_⟩, ?_,
    fun _ _ hg ↦ hg⟩
  · intro Y Z g hg k
    have hcomp : (polynomialPresheaf J A E).map (k ≫ g).op p =
        (polynomialPresheaf J A E).map k.op ((polynomialPresheaf J A E).map g.op p) := by
      rw [op_comp]; exact (polynomialPresheaf J A E).map_comp_apply g.op k.op p
    rw [hcomp]
    exact Conormal.presheafMap_mem_kernelIdeal_sq k.op hg
  obtain ⟨S, hS, hlift⟩ := Conormal.exists_covering_sq_lift J
    (polynomialUnit_comp_desc J A B E a e) ((polynomialUnit J A E).app (op X) p) hp
  refine J.transitive hS _ (fun Y g hg ↦ ?_)
  obtain ⟨q, hq, hqu⟩ := hlift Y g hg
  have heq : (polynomialUnit J A E).app (op Y) q =
      (polynomialUnit J A E).app (op Y) ((polynomialPresheaf J A E).map g.op p) :=
    hqu.trans (NatTrans.naturality_apply (polynomialUnit J A E) g.op p).symm
  refine J.superset_covering ?_
    (Presheaf.equalizerSieve_mem J (polynomialUnit J A E) q _ heq)
  intro Z k hk
  have hmem : (polynomialPresheaf J A E).map k.op q ∈
      Conormal.kernelIdeal (polynomialEvaluation J A B E a e) (op Z) ^ 2 :=
    Conormal.presheafMap_mem_kernelIdeal_sq k.op hq
  have hcomp : (polynomialPresheaf J A E).map (k ≫ g).op p =
      (polynomialPresheaf J A E).map k.op ((polynomialPresheaf J A E).map g.op p) := by
    rw [op_comp]; exact (polynomialPresheaf J A E).map_comp_apply g.op k.op p
  change (polynomialPresheaf J A E).map (k ≫ g).op p ∈ _
  rw [hcomp, ← hk]
  exact hmem

/-- A local section of the conormal module of a presentation `A[E] ⟶ B` is, on a covering
sieve, the image of a conormal class of the polynomial presentation. -/
theorem exists_covering_polynomial_conormalMap_eq {X : C}
    (c : (Conormal.conormalPresheaf (freeAlgebraSheafDesc J A B E a e).hom).obj (op X)) :
    ∃ S : Sieve X, S ∈ J X ∧ ∀ (Y : C) (g : Y ⟶ X), S g →
      ∃ d : (Conormal.conormalPresheaf (polynomialEvaluation J A B E a e)).obj (op Y),
        Conormal.conormalMapOfFac (polynomialEvaluation J A B E a e)
            (freeAlgebraSheafDesc J A B E a e).hom (polynomialUnit J A E)
            (polynomialUnit_comp_desc J A B E a e) (op Y) d =
          (Conormal.conormalPresheaf (freeAlgebraSheafDesc J A B E a e).hom).map g.op c :=
  Conormal.exists_covering_conormalMapOfFac_eq J (polynomialUnit_comp_desc J A B E a e) c

/-- A conormal class of the polynomial presentation whose image in the conormal module of
`A[E] ⟶ B` vanishes restricts to zero on a covering sieve. -/
theorem vanishingSieve_mem_of_polynomial_conormalMap_eq_zero {X : C}
    (c : (Conormal.conormalPresheaf (polynomialEvaluation J A B E a e)).obj (op X))
    (hc : Conormal.conormalMapOfFac (polynomialEvaluation J A B E a e)
      (freeAlgebraSheafDesc J A B E a e).hom (polynomialUnit J A E)
      (polynomialUnit_comp_desc J A B E a e) (op X) c = 0) :
    Conormal.vanishingSieve
        (Conormal.conormalPresheaf (polynomialEvaluation J A B E a e)) c ∈ J X :=
  Conormal.vanishingSieve_mem_of_conormalMapOfFac_eq_zero J
    (polynomialUnit_comp_desc J A B E a e) c hc

omit [HasWeakSheafify J CommRingCat.{w}] [J.WEqualsLocallyBijective CommRingCat.{w}] in
/-- The conormal map of the polynomial presentation kills the class of a polynomial in the
kernel exactly when all of its partial derivatives lie in the kernel. -/
theorem conormalToTensorApp_toCotangent_eq_zero_iff (X : Cᵒᵖ)
    (f : Conormal.kernelIdeal (polynomialEvaluation J A B E a e) X) :
    Conormal.conormalToTensorApp (polynomialEvaluation J A B E a e)
          (polynomialCoefficientMap J A E) X
        ((Conormal.kernelIdeal (polynomialEvaluation J A B E a e) X).toCotangent f) = 0 ↔
      ∀ i : E.obj X, MvPolynomial.pderiv i f.1 ∈
        Conormal.kernelIdeal (polynomialEvaluation J A B E a e) X := by
  rw [Conormal.conormalToTensorApp_toCotangent]
  exact KaehlerDifferential.one_tmul_D_eq_zero_iff_pderiv_mem
    (inst := ((polynomialCoefficientMap J A E).app X).hom.toAlgebra) (fun _ ↦ rfl) _ _

end Stacks.Sites.FreeAlgebra

end
