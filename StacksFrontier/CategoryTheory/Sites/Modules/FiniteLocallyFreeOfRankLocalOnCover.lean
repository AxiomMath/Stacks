module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.LocalOnCover.FiniteLocallyFree
public import StacksFrontier.CategoryTheory.Sites.Modules.FiniteLocallyFreeOfRank

/-!
# Finite local freeness of a fixed rank is local on a covering family

Stacks 03DN asserts that each of the local conditions of Stacks 03DL may be tested on the
members of any family covering the final object of a site, and
`Stacks.SheafOfModules.isFiniteLocallyFreeOnSite_iff_exists_cover_isFiniteLocallyFreeOnSite`
proves that for finite local freeness.  This file proves the same for the *rank* clause of
Stacks 0409, `AlgebraicGeometry.RingedSite.IsFiniteLocallyFreeOfRank`: a sheaf of modules on a
ringed site has rank `r` exactly when its restrictions to the members of some covering family
have rank `r` on the localized ringed sites, and exactly when those restrictions are
coproducts of `r` copies of the structure sheaf.

Fixing the rank changes nothing in the argument, because every transport of a free presentation
used by the unranked statement keeps the index type of the presentation: both
`Stacks.SheafOfModules.isColimitCofanOver`, which restricts a presentation along a morphism of
the site, and `Stacks.SheafOfModules.isColimitCofanTransport`, which carries one across an
equivalence matching the two structure sheaves, are stated for an arbitrary index.  What the
unranked statement does with `∃ n : ℕ` in front of the presentation, the statements here do with
the given `r`.

## Main definitions

No new definitions are introduced.

## Main results

* `AlgebraicGeometry.RingedSite.IsFiniteLocallyFreeOfRank.of_iso`: having rank `r` depends only
  on the isomorphism class of the module.
* `AlgebraicGeometry.RingedSite.IsFiniteLocallyFreeOfRank.over`: having rank `r` is inherited by
  the restriction to a localized ringed site.
* `AlgebraicGeometry.RingedSite.isFiniteLocallyFreeOfRank_iff_exists_cover_isColimit`: having
  rank `r` is equivalent to being a coproduct of `r` copies of the structure sheaf over the
  members of some covering family of the final object.
* `AlgebraicGeometry.RingedSite.isFiniteLocallyFreeOfRank_iff_exists_cover`: having rank `r` is
  equivalent to the restrictions to the members of some covering family of the final object
  having rank `r` on the localized ringed sites.
* `AlgebraicGeometry.RingedSite.isFiniteLocallyFreeOfRank_unit`: the structure sheaf has
  rank `1`.  This is the inhabitant of the predicate; before it, nothing in the development
  produced a module of any rank.

## Implementation notes

No attribute is carried.  Stacks 03DN is about the conditions of Stacks 03DL, and a fixed rank
is not one of them: it is the rank clause of Stacks 0409, whose own statement is the definition
and not this locality.  The sibling file for the unranked condition carries no attribute either.

The localized ringed site is `AlgebraicGeometry.RingedSite.over`, Stacks 04IX.  Both equivalences
compare two readings of one module exactly as the unranked ones do: for `V` an object of the
slice site over `U`, the module `(M.over U).over V` on the iterated slice and the module
`M.over V.left` on the slice over `V.left` are carried to one another by
`CategoryTheory.Over.iteratedSliceEquiv`, and a presentation of fixed rank is carried with them.

Rank zero is included, as in the source: a module of rank `0` is one whose restrictions to a
covering family are initial.

`AlgebraicGeometry.RingedSite.isFiniteLocallyFreeOfRank_unit` is proved from the covering family
generated by the identity of each object, which is the maximal sieve; the restriction of the
structure sheaf to a slice is the structure sheaf of the slice on the nose, so the presentation
is the identity, and a one-element cofan at the identity is a colimit because the indexing
category has one object.  That colimit is constructed inside the proof rather than named, so
that this file introduces no definition.

## References

* [Stacks Project, Tag 03DN](https://stacks.math.columbia.edu/tag/03DN)
* [Stacks Project, Tag 03DL](https://stacks.math.columbia.edu/tag/03DL)
* [Stacks Project, Tag 0409](https://stacks.math.columbia.edu/tag/0409)
* [Stacks Project, Tag 04IX](https://stacks.math.columbia.edu/tag/04IX)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u v w t

namespace AlgebraicGeometry.RingedSite

/-- A presentation of the restriction of `M` to `V.left` as a coproduct of `r` copies of the
structure sheaf gives one of its restriction to the iterated slice over `V`. -/
private theorem exists_isColimitCofanOfRank_overOver {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R) (U : C)
    (V : Over U) {r : ℕ}
    (h : ∃ ι : ∀ _ : Fin r, SheafOfModules.unit (R.over V.left) ⟶ M.over V.left,
      Nonempty (IsColimit (Cofan.mk (M.over V.left) ι))) :
    ∃ ι : ∀ _ : Fin r, SheafOfModules.unit ((R.over U).over V) ⟶ (M.over U).over V,
      Nonempty (IsColimit (Cofan.mk ((M.over U).over V) ι)) := by
  obtain ⟨ι, ⟨hc⟩⟩ := h
  exact ⟨_, ⟨Stacks.SheafOfModules.isColimitCofanTransport
    (Stacks.SheafOfModules.sliceEquiv R U V) (Stacks.SheafOfModules.sliceEquivUnitIso R U V)
    (Stacks.SheafOfModules.sliceEquivObjIso M U V) ι hc⟩⟩

/-- A presentation of the restriction of `M` to the iterated slice over `V` as a coproduct of `r`
copies of the structure sheaf gives one of its restriction to `V.left`. -/
private theorem exists_isColimitCofanOfRank_overOver_symm {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}} (M : SheafOfModules.{w} R) (U : C)
    (V : Over U) {r : ℕ}
    (h : ∃ ι : ∀ _ : Fin r, SheafOfModules.unit ((R.over U).over V) ⟶ (M.over U).over V,
      Nonempty (IsColimit (Cofan.mk ((M.over U).over V) ι))) :
    ∃ ι : ∀ _ : Fin r, SheafOfModules.unit (R.over V.left) ⟶ M.over V.left,
      Nonempty (IsColimit (Cofan.mk (M.over V.left) ι)) := by
  obtain ⟨ι, ⟨hc⟩⟩ := h
  let e := Stacks.SheafOfModules.sliceEquiv R U V
  let η : e.symm.functor.obj (SheafOfModules.unit ((R.over U).over V)) ≅
      SheafOfModules.unit (R.over V.left) :=
    e.inverse.mapIso (Stacks.SheafOfModules.sliceEquivUnitIso R U V).symm ≪≫
      (e.unitIso.app (SheafOfModules.unit (R.over V.left))).symm
  let ρ : e.symm.functor.obj ((M.over U).over V) ≅ M.over V.left :=
    e.inverse.mapIso (Stacks.SheafOfModules.sliceEquivObjIso M U V).symm ≪≫
      (e.unitIso.app (M.over V.left)).symm
  exact ⟨_, ⟨Stacks.SheafOfModules.isColimitCofanTransport e.symm η ρ ι hc⟩⟩

/-- If a family of objects covers the final object and the restriction of `M` to each member is a
coproduct of `r` copies of the structure sheaf, then every object carries a covering family of
arrows on whose sources the same holds.

This is the rank-indexed form of
`Stacks.SheafOfModules.exists_cover_isColimitCofan_of_coversTop`; the sieve produced is the same
one, and only the index type of the presentation differs. -/
private theorem exists_cover_isColimitCofanOfRank_of_coversTop {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}} {I : Type t} (Y : I → C)
    (hY : J.CoversTop Y) (M : SheafOfModules.{w} R) {r : ℕ}
    (hM : ∀ i, ∃ ι : ∀ _ : Fin r, SheafOfModules.unit (R.over (Y i)) ⟶ M.over (Y i),
      Nonempty (IsColimit (Cofan.mk (M.over (Y i)) ι)))
    (W : C) :
    ∃ (I' : Type (max u v)) (V : I' → C) (f : ∀ i, V i ⟶ W),
      Sieve.ofArrows V f ∈ J W ∧
        ∀ i, ∃ ι : ∀ _ : Fin r, SheafOfModules.unit (R.over (V i)) ⟶ M.over (V i),
          Nonempty (IsColimit (Cofan.mk (M.over (V i)) ι)) := by
  refine ⟨Σ Z : C, { g : Z ⟶ W // (Sieve.ofObjects Y W).arrows g }, fun x => x.1,
    fun x => x.2.1, ?_, ?_⟩
  · refine J.superset_covering ?_ (hY W)
    intro Z g hg
    exact Sieve.ofArrows_mk _ _ (⟨Z, g, hg⟩ : Σ Z : C, { g : Z ⟶ W // _ })
  · rintro ⟨Z, g, i, ⟨h⟩⟩
    obtain ⟨ι, ⟨hc⟩⟩ := hM i
    exact ⟨_, ⟨Stacks.SheafOfModules.isColimitCofanOver M h ι hc⟩⟩

/-- A covering family of `W.left` gives a covering family of `W` in the localized site over `U`. -/
private theorem ofArrows_over_mem {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
    (U : C) (W : Over U) {I : Type t} (V : I → C) (f : ∀ i, V i ⟶ W.left)
    (hcov : Sieve.ofArrows V f ∈ J W.left) :
    Sieve.ofArrows (fun j => Over.mk (f j ≫ W.hom))
      (fun j => Over.homMk (f j) (by simp)) ∈ (J.over U) W := by
  rw [GrothendieckTopology.mem_over_iff]
  simpa [Sieve.overEquiv, Sieve.functorPushforward_ofArrows] using hcov

/-- Finite local freeness is inherited by the restriction to a localized site.  This is the
unranked companion of `AlgebraicGeometry.RingedSite.IsFiniteLocallyFreeOfRank.over`, and it is
the restriction half of Stacks 03DN for finite local freeness. -/
theorem _root_.SheafOfModules.IsFiniteLocallyFreeOnSite.over {C : Type u} [Category.{v} C]
    {J : GrothendieckTopology C} {R : Sheaf J RingCat.{w}} {M : SheafOfModules.{w} R}
    (h : SheafOfModules.IsFiniteLocallyFreeOnSite M) (U : C) :
    SheafOfModules.IsFiniteLocallyFreeOnSite (R := R.over U) (M.over U) := by
  rw [SheafOfModules.isFiniteLocallyFreeOnSite_iff_exists_cover_isColimit] at h
  refine (SheafOfModules.isFiniteLocallyFreeOnSite_iff_exists_cover_isColimit
    (R := R.over U) (M.over U)).2 fun W => ?_
  obtain ⟨I, V, f, hcov, hfree⟩ := h W.left
  refine ⟨I, _, _, ofArrows_over_mem J U W V f hcov, fun j => ?_⟩
  exact Stacks.SheafOfModules.exists_isColimitCofan_overOver M U
      (Over.mk (f j ≫ W.hom)) (hfree j)

variable (X : RingedSite.{u, v, w})
  (F : SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))

/-- Having rank `r` depends only on the isomorphism class of a sheaf of modules. -/
theorem IsFiniteLocallyFreeOfRank.of_iso
    {G : SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)} {r : ℕ}
    (e : F ≅ G) (h : IsFiniteLocallyFreeOfRank X F r) : IsFiniteLocallyFreeOfRank X G r := by
  intro U
  obtain ⟨I, V, f, hcov, hfree⟩ := h U
  refine ⟨I, V, f, hcov, fun i => ?_⟩
  obtain ⟨ι, ⟨hc⟩⟩ := hfree i
  refine ⟨fun j => ι j ≫
    ((SheafOfModules.overFunctor (Stacks.SheafOfModules.Tensor.ringSheaf X.O) (V i)).mapIso e).hom,
    ?_⟩
  exact ⟨IsColimit.ofIsoColimit hc
    (Cocone.ext ((SheafOfModules.overFunctor (Stacks.SheafOfModules.Tensor.ringSheaf X.O)
      (V i)).mapIso e) (fun _ => rfl))⟩

/-- Having rank `r` is inherited by the restriction to a localized ringed site. -/
theorem IsFiniteLocallyFreeOfRank.over {r : ℕ} (h : IsFiniteLocallyFreeOfRank X F r) (U : X.C) :
    IsFiniteLocallyFreeOfRank (X.over U) (F.over U) r := by
  intro W
  obtain ⟨I, V, f, hcov, hfree⟩ := h W.left
  refine ⟨I, _, _, ofArrows_over_mem X.J U W V f hcov, fun j => ?_⟩
  exact exists_isColimitCofanOfRank_overOver F U (Over.mk (f j ≫ W.hom)) (hfree j)

/-- **The rank clause of Stacks 0409 is local on a covering family.** A sheaf of modules on a
ringed site has rank `r` if and only if its restriction to each member of some covering family of
the final object is a coproduct of `r` copies of the structure sheaf.

This is the rank-indexed form of
`Stacks.SheafOfModules.isFiniteLocallyFreeOnSite_iff_exists_cover_isFiniteFree`. -/
theorem isFiniteLocallyFreeOfRank_iff_exists_cover_isColimit (r : ℕ) :
    IsFiniteLocallyFreeOfRank X F r ↔
      ∃ (I : Type (max u v)) (U : I → X.C), X.J.CoversTop U ∧
        ∀ i : I, ∃ ι : ∀ _ : Fin r,
            SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over (U i)) ⟶
              F.over (U i),
          Nonempty (IsColimit (Cofan.mk (F.over (U i)) ι)) := by
  refine ⟨fun hF => ?_, fun ⟨I, U, hU, hfree⟩ =>
    exists_cover_isColimitCofanOfRank_of_coversTop U hU F hfree⟩
  classical
  choose I V f hcov hfree using fun i : ULift.{max u v} X.C => hF i.down
  exact ⟨Σ i, I i, fun ij => V ij.1 ij.2,
    (Stacks.SheafOfModules.coversTop_ulift_self X.J).over fun i =>
      Stacks.SheafOfModules.coversTop_over_of_ofArrows_mem X.J _ (V i) (f i) (hcov i),
    fun ij => hfree ij.1 ij.2⟩

/-- **The rank clause of Stacks 0409 is local on a covering family.** A sheaf of modules on a
ringed site has rank `r` if and only if its restriction to each member of some covering family of
the final object has rank `r` on the corresponding localized ringed site.

This is the rank-indexed form of
`Stacks.SheafOfModules.isFiniteLocallyFreeOnSite_iff_exists_cover_isFiniteLocallyFreeOnSite`. -/
theorem isFiniteLocallyFreeOfRank_iff_exists_cover (r : ℕ) :
    IsFiniteLocallyFreeOfRank X F r ↔
      ∃ (I : Type (max u v)) (U : I → X.C), X.J.CoversTop U ∧
        ∀ i : I, IsFiniteLocallyFreeOfRank (X.over (U i)) (F.over (U i)) r := by
  refine ⟨fun hF => ⟨ULift.{max u v} X.C, fun i => i.down,
    Stacks.SheafOfModules.coversTop_ulift_self X.J,
    fun i => IsFiniteLocallyFreeOfRank.over X F hF i.down⟩, ?_⟩
  rintro ⟨I, U, hU, hlocal⟩
  classical
  choose I' V f hcov hfree using fun i : I => hlocal i (Over.mk (𝟙 (U i)))
  have hcovBase (i : I) : Sieve.ofArrows (fun j => (V i j).left)
      (fun j => (V i j).hom) ∈ X.J (U i) := by
    have heq (j : I' i) : (f i j).left = (V i j).hom := by simpa using Over.w (f i j)
    simpa [Sieve.overEquiv, Sieve.functorPushforward_ofArrows, heq] using
      (GrothendieckTopology.mem_over_iff X.J _).mp (hcov i)
  exact (isFiniteLocallyFreeOfRank_iff_exists_cover_isColimit X F r).2
    ⟨Σ i, I' i, fun ij => (V ij.1 ij.2).left, hU.over fun i =>
      Stacks.SheafOfModules.coversTop_over_of_ofArrows_mem X.J (U i) (fun j => (V i j).left)
        (fun j => (V i j).hom) (hcovBase i),
      fun ij => exists_isColimitCofanOfRank_overOver_symm F (U ij.1) (V ij.1 ij.2)
        (hfree ij.1 ij.2)⟩

/-- The structure sheaf of a ringed site has rank `1`: over the covering family generated by the
identity of an object, it is a coproduct of one copy of itself.

This exhibits an inhabitant of `AlgebraicGeometry.RingedSite.IsFiniteLocallyFreeOfRank`. -/
theorem isFiniteLocallyFreeOfRank_unit :
    IsFiniteLocallyFreeOfRank X
      (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) 1 := by
  intro U
  refine ⟨PUnit.{max u v + 1}, fun _ => U, fun _ => 𝟙 U, ?_, fun _ => ⟨fun _ => 𝟙 _, ?_⟩⟩
  · have htop : Sieve.ofArrows (fun _ : PUnit.{max u v + 1} => U) (fun _ => 𝟙 U) = ⊤ :=
      eq_top_iff.mpr fun Z g _ => by
        simpa using (Sieve.ofArrows _ _).downward_closed
          (Sieve.ofArrows_mk (fun _ : PUnit.{max u v + 1} => U) (fun _ => 𝟙 U) PUnit.unit) g
    exact htop ▸ X.J.top_mem U
  · refine ⟨{ desc := fun s => s.ι.app ⟨0⟩, fac := ?_, uniq := ?_ }⟩
    · rintro s ⟨j⟩
      obtain rfl : j = 0 := Subsingleton.elim _ _
      exact Category.id_comp _
    · exact fun s m h => (Category.id_comp m).symm.trans (h ⟨0⟩)

end AlgebraicGeometry.RingedSite

end
