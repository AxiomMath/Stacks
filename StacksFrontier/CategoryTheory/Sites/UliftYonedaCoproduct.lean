module

public import Mathlib.CategoryTheory.Sites.Subcanonical
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Disjoint coverings become coproducts under the universe-raising Yoneda embedding

Mathlib's `CategoryTheory.GrothendieckTopology.isColimitCofanMkYoneda` says that a cofan of a
subcanonical site whose injections are monomorphisms, generate a covering sieve and are
pairwise disjoint is carried by the Yoneda embedding `J.yoneda` to a coproduct of sheaves of
`Type v`, the value universe of the site. This file records the same statement for the
universe-raising Yoneda embedding `J.uliftYoneda.{w}` into sheaves of `Type (max v w)`.

The raise in the value universe is not cosmetic: a formal algebraic space over a base scheme
is a sheaf of `Type (u + 1)` on a site whose value universe is `Type u`, so every coproduct of
representables that appears in the theory of formal algebraic spaces is formed among sheaves of
`Type (u + 1)` and is not an instance of the statement in the value universe of the site.

## Main results

* `CategoryTheory.GrothendieckTopology.isColimitCofanMkUliftYoneda`: the cofan of universe-lifted
  representable sheaves attached to a disjoint covering cofan is colimiting.

## Implementation notes

The proof is the one of `CategoryTheory.GrothendieckTopology.isColimitCofanMkYoneda`, run through
`CategoryTheory.GrothendieckTopology.uliftYonedaEquiv` instead of the Yoneda equivalence: the
sheaf condition for the covering generated by the injections, in the `Presieve.IsSheafFor` form
for a family of arrows, says exactly that a compatible family of sections over the summands
glues uniquely, and compatibility is automatic — on the diagonal because the injections are
monomorphisms, off the diagonal because the pairwise intersections are initial and a sheaf takes
an object covered by the empty sieve to a terminal type.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe w v u

namespace CategoryTheory.GrothendieckTopology

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C) [J.Subcanonical]

/-- A family of pairwise disjoint monomorphisms generating a covering sieve of a subcanonical
topology `J` is carried by the universe-raising Yoneda embedding into `J`-sheaves of
`Type (max v w)` to a coproduct diagram.

This is `CategoryTheory.GrothendieckTopology.isColimitCofanMkYoneda` with the value universe of
the sheaves raised from `Type v` to `Type (max v w)`. -/
@[sga "4 II 4.6.2" "special case"]
def isColimitCofanMkUliftYoneda {ι : Type*} (X : ι → C) {c : Cofan X}
    (hcov : Sieve.ofArrows X c.inj ∈ J c.pt) [∀ i, Mono (c.inj i)]
    (hempty : ∀ Y, IsInitial Y → ⊥ ∈ J Y)
    (hdisj : ∀ {i j} (_ : i ≠ j) {Y} (a : Y ⟶ X i) (b : Y ⟶ X j),
      a ≫ c.inj i = b ≫ c.inj j → Nonempty (IsInitial Y)) :
    IsColimit (Cofan.mk _ fun i => J.uliftYoneda.{w}.map (c.inj i)) := by
  have hglue (s : Cofan fun i => J.uliftYoneda.{w}.obj (X i)) :
      ∃! t : s.pt.obj.obj (op c.pt),
        ∀ i, s.pt.obj.map (c.inj i).op t = J.uliftYonedaEquiv (s.inj i) := by
    apply (Presieve.isSheafFor_arrows_iff _ _).1
      ((Presieve.isSheafFor_iff_generate _).2 (s.pt.property.isSheafFor _ hcov))
    intro i j Y a b hab
    obtain rfl | hij := eq_or_ne i j
    · rw [(cancel_mono _).mp hab]
    · obtain ⟨hY⟩ := hdisj hij a b hab
      let := Types.isTerminalEquivUnique _ (Sheaf.isTerminalOfBotCover s.pt _ (hempty Y hY))
      exact Subsingleton.elim _ _
  refine Cofan.IsColimit.mk _
    (fun s => J.uliftYonedaEquiv.symm (hglue s).choose) ?_ ?_
  · intro s i
    apply J.uliftYonedaEquiv.injective
    change J.uliftYonedaEquiv (J.uliftYoneda.map (c.inj i) ≫
      J.uliftYonedaEquiv.symm (hglue s).choose) = _
    rw [← J.uliftYonedaEquiv_naturality, Equiv.apply_symm_apply]
    exact (hglue s).choose_spec.1 i
  · intro s m hm
    apply J.uliftYonedaEquiv.injective
    rw [Equiv.apply_symm_apply]
    refine (hglue s).choose_spec.2 _ fun i => ?_
    rw [J.uliftYonedaEquiv_naturality]
    exact congrArg J.uliftYonedaEquiv (hm i)

end CategoryTheory.GrothendieckTopology

end
