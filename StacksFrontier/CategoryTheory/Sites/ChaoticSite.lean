module

public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import Mathlib.CategoryTheory.Sites.Sheaf
public import StacksCore.Tactic.StacksAttribute

/-!
# The chaotic site on an arbitrary category

Let `C` be a category. Stacks 07GE turns `C` into a site whose coverings of `U` are the
families `{φ : V → U}` with `φ` an isomorphism, and observes that the sheaves on this site are
exactly the presheaves on `C`. This topology is called the *chaotic* or *indiscrete* topology.

Mathlib's `CategoryTheory.Pretopology.trivial` is this site, but a `Pretopology` needs chosen
fibre products, so it is only available under `[HasPullbacks C]`. Here the coverings are given
for an arbitrary category `C`, as the precoverage `CategoryTheory.Precoverage.chaotic`:

* `Precoverage.chaotic C`: the covering presieves of `U` are the singletons `{φ}` with
  `φ : V ⟶ U` an isomorphism;
* the site axioms of Stacks 00VH hold without any assumption on `C`: isomorphisms are coverings
  (`Precoverage.chaotic.instHasIsos`), coverings compose (`Precoverage.bind_mem_chaotic`), and the
  fibre products of a covering along any morphism exist (`Precoverage.chaotic.instHasPullbacks`)
  and form a covering (`Precoverage.pullbackArrows_mem_chaotic`);
* `Precoverage.toGrothendieck_chaotic`: the generated Grothendieck topology is `⊥`, the topology
  in which only the maximal sieve covers;
* `Precoverage.sheafChaoticEquivalence`: sheaves on the chaotic site, with values in any
  category `A`, are the presheaves on `C`.

## References

* [Stacks Project, Tag 07GE](https://stacks.math.columbia.edu/tag/07GE)
-/

@[expose] public section

universe v u

namespace CategoryTheory

open Limits

namespace Precoverage

variable (C : Type u) [Category.{v} C]

/-- The chaotic (indiscrete) precoverage on an arbitrary category `C`: the covering presieves
of `U` are the singletons `{φ}` with `φ : V ⟶ U` an isomorphism. -/
@[stacks 07GE "the iso-singleton coverings, for an arbitrary category (Mathlib's
  `Pretopology.trivial` needs `HasPullbacks C`)"]
def chaotic : Precoverage C where
  coverings U := {R | ∃ (V : C) (φ : V ⟶ U), IsIso φ ∧ R = Presieve.singleton φ}

variable {C}

lemma mem_chaotic_iff {U : C} {R : Presieve U} :
    R ∈ chaotic C U ↔ ∃ (V : C) (φ : V ⟶ U), IsIso φ ∧ R = Presieve.singleton φ :=
  Iff.rfl

/-- In the chaotic precoverage, every singleton isomorphism is a covering. -/
instance chaotic.instHasIsos : (chaotic C).HasIsos where
  mem_coverings_of_isIso f _ := ⟨_, f, inferInstance, rfl⟩

/-- Every covering of the chaotic precoverage has fibre products along any morphism, since
the fibre product along an isomorphism always exists. -/
instance chaotic.instHasPullbacks : (chaotic C).HasPullbacks where
  hasPullbacks_of_mem f hR := by
    obtain ⟨V, φ, hφ, rfl⟩ := hR
    refine ⟨fun {_ _} h ↦ ?_⟩
    cases h
    exact hasPullback_of_left_iso φ f

/-- The base change of a chaotic covering along any morphism is a chaotic covering. -/
lemma pullbackArrows_mem_chaotic {U V : C} (f : V ⟶ U) {R : Presieve U}
    (hR : R ∈ chaotic C U) :
    haveI := (chaotic C).hasPullbacks_of_mem f hR
    R.pullbackArrows f ∈ chaotic C V := by
  obtain ⟨W, φ, hφ, rfl⟩ := hR
  have := hasPullback_of_left_iso φ f
  exact ⟨_, pullback.snd φ f, inferInstance, Presieve.pullback_singleton (f := f) φ⟩

/-- The composition of chaotic coverings is a chaotic covering. -/
lemma bind_mem_chaotic {U : C} {S : Presieve U} (hS : S ∈ chaotic C U)
    {T : ∀ ⦃V⦄ ⦃f : V ⟶ U⦄, S f → Presieve V}
    (hT : ∀ ⦃V⦄ ⦃f : V ⟶ U⦄ (h : S f), T h ∈ chaotic C V) :
    S.bind T ∈ chaotic C U := by
  obtain ⟨V, φ, hφ, rfl⟩ := hS
  obtain ⟨W, ψ, hψ, hTψ⟩ := hT (Presieve.singleton.mk : Presieve.singleton φ φ)
  refine ⟨W, ψ ≫ φ, inferInstance, ?_⟩
  funext Z
  ext h
  constructor
  · rintro ⟨Y, g, k, hk, hg, rfl⟩
    cases hk
    rw [hTψ] at hg
    cases hg
    exact Presieve.singleton.mk
  · rintro ⟨⟩
    exact ⟨V, ψ, φ, Presieve.singleton.mk, by rw [hTψ]; exact Presieve.singleton.mk, rfl⟩

/-- The Grothendieck topology generated by the chaotic precoverage is `⊥`, the topology in which
only the maximal sieve covers. -/
@[stacks 07GE "the iso-singleton coverings of an arbitrary category generate the bottom
  topology"]
theorem toGrothendieck_chaotic : (chaotic C).toGrothendieck = ⊥ := by
  refine le_antisymm (toGrothendieck_le_iff_le_toPrecoverage.2 fun U R hR ↦ ?_) bot_le
  obtain ⟨V, φ, hφ, rfl⟩ := hR
  rw [GrothendieckTopology.mem_toPrecoverage_iff, GrothendieckTopology.bot_covering]
  exact Sieve.generate_of_singleton_isSplitEpi φ

/-- Every presheaf is a sheaf for the topology generated by the chaotic precoverage. -/
theorem isSheaf_toGrothendieck_chaotic {A : Type*} [Category* A] (P : Cᵒᵖ ⥤ A) :
    Presheaf.IsSheaf (chaotic C).toGrothendieck P := by
  rw [toGrothendieck_chaotic]
  exact Presheaf.isSheaf_bot P

variable (C) in
/-- Sheaves on the chaotic site of an arbitrary category `C`, with values in a category `A`,
are the presheaves on `C`: the forgetful functor is an equivalence of categories. -/
@[stacks 07GE "sheaves on the chaotic site of an arbitrary category are the presheaves"]
def sheafChaoticEquivalence (A : Type*) [Category* A] :
    Sheaf (chaotic C).toGrothendieck A ≌ Cᵒᵖ ⥤ A where
  functor := sheafToPresheaf _ _
  inverse :=
    { obj P := ⟨P, isSheaf_toGrothendieck_chaotic P⟩
      map f := ⟨f⟩ }
  unitIso := Iso.refl _
  counitIso := Iso.refl _

end Precoverage

end CategoryTheory
