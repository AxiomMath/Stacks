module

public import StacksFrontier.CategoryTheory.Sites.Stack.EffectiveDescentCoarserTopology

/-!
# Effectivity of a pulled back descent datum from one covering arrow

Let `p : 𝒳 ⥤ 𝒮` be fibred in groupoids with morphism presheaves sheaves for a topology `K`, let `D`
be a descent datum relative to a sieve `R` of `U`, and let `v : V ⟶ U`. Suppose `e : E ⟶ V`
generates a `K`-covering sieve of `V` and `e ≫ v` is an arrow of `R`. A single morphism
`ζ₀ : D (e ≫ v) ⟶ y` lying over `e`, compatible with the gluing isomorphism of `D` at every pair
of morphisms into `E` that agree over `V`, makes the pullback of `D` along `v` effective, with
`y` the object it descends to.

This is how a descent datum is shown effective after an fppf base change in the proof of
Stacks 0GRH: the object `y` and the morphism `ζ₀` are produced over the base change of the given
fpqc covering, and the compatibility is the descent datum of the chart.

## Main results

* `CategoryTheory.Functor.SieveDescentDatum.isEffective_pullback_of_singleArrow`.
-/

@[expose] public section

namespace CategoryTheory.Functor

open Category Limits Opposite

universe v₁ v₂ u₁ u₂

variable {𝒮 : Type u₁} [Category.{v₁} 𝒮] {𝒳 : Type u₂} [Category.{v₂} 𝒳] {p : 𝒳 ⥤ 𝒮}
  [p.IsFibered] {U : 𝒮} {R : Sieve U}

attribute [local implicit_reducible] Fiber Fiber.fiberInclusion

/-- An arrow of the sieve generated by a single morphism `e` factors through `e`. -/
lemma exists_comp_eq_of_mem_generate_singleton {V E Y : 𝒮} {e : E ⟶ V} {h : Y ⟶ V}
    (hh : (Sieve.generate (Presieve.singleton e)).arrows h) : ∃ k : Y ⟶ E, k ≫ e = h := by
  obtain ⟨_, k, g, hg, hk⟩ := hh
  cases hg
  exact ⟨k, hk⟩

namespace SieveDescentDatum

variable (D : SieveDescentDatum p R)

/-- The chosen cartesian lift of `ε` at the object of `D` at `a`, followed by the inverse of the
contraction onto `a` from `f` and the chosen cartesian lift of `g`, is the gluing isomorphism of
`a` and `f` read at `(ε, ε ≫ g)`, followed by the chosen cartesian lift of `ε ≫ g`. -/
lemma pullbackMap_contract_inv_pullbackMap {V W Z : 𝒮} {f : V ⟶ U} (hf : R f) (g : W ⟶ V)
    {a : W ⟶ U} (ha : R a) (hga : g ≫ f = a) (ε : Z ⟶ W) :
    IsPreFibered.pullbackMap (D.obj a ha).2 ε ≫
        Fiber.fiberInclusion.map (D.contract hf g ha hga).inv ≫
          IsPreFibered.pullbackMap (D.obj f hf).2 g =
      Fiber.fiberInclusion.map (D.iso ha hf ε (ε ≫ g) (by rw [assoc, hga])).hom ≫
        IsPreFibered.pullbackMap (D.obj f hf).2 (ε ≫ g) := by
  have h := D.pullbackFiberHom_contract hf g ha hga ε
  have hinv : pullbackFiberHom (D.contract hf g ha hga).inv ε =
      (D.iso hf ha (ε ≫ g) ε (by rw [assoc, hga])).inv ≫
        (pullbackFiberCompIso (D.obj f hf) g ε).inv := by
    have h' : (pullbackFiberIso (D.contract hf g ha hga) ε).hom =
        (pullbackFiberCompIso (D.obj f hf) g ε ≪≫
          D.iso hf ha (ε ≫ g) ε (by rw [assoc, hga])).hom := h
    have h'' := congrArg Iso.inv (Iso.ext h')
    exact h''
  rw [← Category.assoc, ← pullbackFiberHom_fac, Category.assoc, hinv, Functor.map_comp,
    Category.assoc, pullbackFiberCompIso, pullbackFiberCompIso'_inv_fac,
    ← D.iso_symm hf ha (ε ≫ g) ε (by rw [assoc, hga])]

/-- **Effectivity of a pulled back descent datum from one covering arrow.** -/
theorem isEffective_pullback_of_singleArrow (hp : p.IsFiberedInGroupoids)
    {K : GrothendieckTopology 𝒮} (hmor : ∀ (V : 𝒮) (x y : p.Fiber V), IsMorSheaf p K V x y)
    {V E : 𝒮} (v : V ⟶ U) (e : E ⟶ V) (he : Sieve.generate (Presieve.singleton e) ∈ K V)
    {b₀ : E ⟶ U} (hb₀ : e ≫ v = b₀) (hRb : R.arrows b₀) (y : p.Fiber V)
    (ζ₀ : (D.obj b₀ hRb).1 ⟶ y.1) (hζ₀ : p.IsHomLift e ζ₀)
    (hcompat : ∀ ⦃Z : 𝒮⦄ (k₁ k₂ : Z ⟶ E) (hk : k₁ ≫ e = k₂ ≫ e),
      Fiber.fiberInclusion.map (D.iso hRb hRb k₁ k₂
          (by rw [← hb₀, ← assoc, hk, assoc])).hom ≫
        IsPreFibered.pullbackMap (D.obj b₀ hRb).2 k₂ ≫ ζ₀ =
      IsPreFibered.pullbackMap (D.obj b₀ hRb).2 k₁ ≫ ζ₀) :
    (D.pullback v).IsEffective := by
  have hT : Sieve.generate (Presieve.singleton e) ≤ R.pullback v := by
    intro Y h hh
    obtain ⟨k, rfl⟩ := exists_comp_eq_of_mem_generate_singleton hh
    show R.arrows ((k ≫ e) ≫ v)
    rw [assoc, hb₀]
    exact R.downward_closed hRb k
  refine (D.pullback v).isEffective_of_restrict hmor hT he ?_
  choose k hk using fun (Y : 𝒮) (h : Y ⟶ V)
    (hh : (Sieve.generate (Presieve.singleton e)).arrows h) =>
      exists_comp_eq_of_mem_generate_singleton hh
  have hkb : ∀ (Y : 𝒮) (h : Y ⟶ V) (hh : (Sieve.generate (Presieve.singleton e)).arrows h),
      k Y h hh ≫ b₀ = h ≫ v := by
    intro Y h hh; rw [← hb₀, ← assoc, hk]
  let ζ : ∀ ⦃Y : 𝒮⦄ (h : Y ⟶ V) (hh : (Sieve.generate (Presieve.singleton e)).arrows h),
      (((D.pullback v).restrict hT).obj h hh).1 ⟶ y.1 := fun Y h hh =>
    Fiber.fiberInclusion.map (D.contract hRb (k Y h hh) (hT _ hh) (hkb Y h hh)).inv ≫
      IsPreFibered.pullbackMap (D.obj b₀ hRb).2 (k Y h hh) ≫ ζ₀
  have hlift : ∀ ⦃Y : 𝒮⦄ (h : Y ⟶ V) (hh : (Sieve.generate (Presieve.singleton e)).arrows h),
      p.IsHomLift h (ζ h hh) := by
    intro Y h hh
    have : p.IsHomLift (𝟙 Y ≫ k Y h hh ≫ e) (ζ h hh) := by
      dsimp only [ζ]; infer_instance
    exact (congrArg (fun g => p.IsHomLift g (ζ h hh))
      (by rw [Category.id_comp, hk])).mp this
  refine ⟨y, ζ, fun Y h hh => ?_, fun Y₁ Y₂ Z h₁ hh₁ h₂ hh₂ ε₁ ε₂ heq => ?_⟩
  · have := hlift h hh
    have := hp.isStronglyCartesian_homLift h (ζ h hh)
    exact inferInstance
  · have e₁ : (ε₁ ≫ k Y₁ h₁ hh₁) ≫ e = (ε₂ ≫ k Y₂ h₂ hh₂) ≫ e := by
      rw [assoc, assoc, hk, hk, heq]
    have hc := hcompat (ε₁ ≫ k Y₁ h₁ hh₁) (ε₂ ≫ k Y₂ h₂ hh₂) e₁
    have F₁ := D.pullbackMap_contract_inv_pullbackMap hRb (k Y₁ h₁ hh₁) (hT _ hh₁)
      (hkb Y₁ h₁ hh₁) ε₁
    have F₂ := D.pullbackMap_contract_inv_pullbackMap hRb (k Y₂ h₂ hh₂) (hT _ hh₂)
      (hkb Y₂ h₂ hh₂) ε₂
    have hcoc₁ := D.cocycle (hT _ hh₁) (hT _ hh₂) hRb ε₁ ε₂ (ε₂ ≫ k Y₂ h₂ hh₂)
      (by rw [← assoc, ← assoc, heq]) (by rw [assoc, hkb]) (by rw [assoc, hkb, ← assoc, heq, assoc])
    have hcoc₂ := D.cocycle (hT _ hh₁) hRb hRb ε₁ (ε₁ ≫ k Y₁ h₁ hh₁) (ε₂ ≫ k Y₂ h₂ hh₂)
      (by rw [assoc, hkb]) (by rw [assoc, assoc, ← hb₀, ← assoc (k _ _ _), hk, ← assoc (k _ _ _),
        hk, ← assoc, ← assoc, heq]) (by rw [assoc, hkb, ← assoc, heq, assoc])
    have hcoc₁' := congrArg (Fiber.fiberInclusion.map ·) hcoc₁
    have hcoc₂' := congrArg (Fiber.fiberInclusion.map ·) hcoc₂
    simp only [Functor.map_comp] at hcoc₁' hcoc₂'
    have hm₁ := mem_of_mem_pullback (hT _ hh₁)
    have hm₂ := mem_of_mem_pullback (hT _ hh₂)
    have heqv : ε₁ ≫ (h₁ ≫ v) = ε₂ ≫ (h₂ ≫ v) := by rw [← assoc, ← assoc, heq]
    have e₂k : ε₂ ≫ (h₂ ≫ v) = (ε₂ ≫ k Y₂ h₂ hh₂) ≫ b₀ := by rw [assoc, hkb]
    have e₁k : ε₁ ≫ (h₁ ≫ v) = (ε₁ ≫ k Y₁ h₁ hh₁) ≫ b₀ := by rw [assoc, hkb]
    have ekk : (ε₁ ≫ k Y₁ h₁ hh₁) ≫ b₀ = (ε₂ ≫ k Y₂ h₂ hh₂) ≫ b₀ := e₁k.symm.trans (heqv.trans e₂k)
    show Fiber.fiberInclusion.map (D.iso hm₁ hm₂ ε₁ ε₂ heqv).hom ≫
        IsPreFibered.pullbackMap (D.obj (h₂ ≫ v) hm₂).2 ε₂ ≫
          (Fiber.fiberInclusion.map (D.contract hRb (k Y₂ h₂ hh₂) hm₂ (hkb Y₂ h₂ hh₂)).inv ≫
            IsPreFibered.pullbackMap (D.obj b₀ hRb).2 (k Y₂ h₂ hh₂) ≫ ζ₀) =
      IsPreFibered.pullbackMap (D.obj (h₁ ≫ v) hm₁).2 ε₁ ≫
          (Fiber.fiberInclusion.map (D.contract hRb (k Y₁ h₁ hh₁) hm₁ (hkb Y₁ h₁ hh₁)).inv ≫
            IsPreFibered.pullbackMap (D.obj b₀ hRb).2 (k Y₁ h₁ hh₁) ≫ ζ₀)
    calc _ = Fiber.fiberInclusion.map (D.iso hm₁ hm₂ ε₁ ε₂ heqv).hom ≫
          (IsPreFibered.pullbackMap (D.obj (h₂ ≫ v) hm₂).2 ε₂ ≫
            Fiber.fiberInclusion.map (D.contract hRb (k Y₂ h₂ hh₂) hm₂ (hkb Y₂ h₂ hh₂)).inv ≫
            IsPreFibered.pullbackMap (D.obj b₀ hRb).2 (k Y₂ h₂ hh₂)) ≫ ζ₀ := by
          simp only [Category.assoc]
      _ = Fiber.fiberInclusion.map (D.iso hm₁ hm₂ ε₁ ε₂ heqv).hom ≫
          (Fiber.fiberInclusion.map (D.iso hm₂ hRb ε₂ (ε₂ ≫ k Y₂ h₂ hh₂) e₂k).hom ≫
            IsPreFibered.pullbackMap (D.obj b₀ hRb).2 (ε₂ ≫ k Y₂ h₂ hh₂)) ≫ ζ₀ := by
          rw [F₂]
      _ = Fiber.fiberInclusion.map (D.iso hm₁ hRb ε₁ (ε₂ ≫ k Y₂ h₂ hh₂) (heqv.trans e₂k)).hom ≫
            IsPreFibered.pullbackMap (D.obj b₀ hRb).2 (ε₂ ≫ k Y₂ h₂ hh₂) ≫ ζ₀ := by
          rw [← hcoc₁']; simp only [Category.assoc]
      _ = Fiber.fiberInclusion.map (D.iso hm₁ hRb ε₁ (ε₁ ≫ k Y₁ h₁ hh₁) e₁k).hom ≫
            Fiber.fiberInclusion.map (D.iso hRb hRb (ε₁ ≫ k Y₁ h₁ hh₁)
              (ε₂ ≫ k Y₂ h₂ hh₂) ekk).hom ≫
            IsPreFibered.pullbackMap (D.obj b₀ hRb).2 (ε₂ ≫ k Y₂ h₂ hh₂) ≫ ζ₀ := by
          rw [← hcoc₂']; simp only [Category.assoc]
      _ = Fiber.fiberInclusion.map (D.iso hm₁ hRb ε₁ (ε₁ ≫ k Y₁ h₁ hh₁) e₁k).hom ≫
            IsPreFibered.pullbackMap (D.obj b₀ hRb).2 (ε₁ ≫ k Y₁ h₁ hh₁) ≫ ζ₀ := by
          rw [hc]
      _ = (IsPreFibered.pullbackMap (D.obj (h₁ ≫ v) hm₁).2 ε₁ ≫
            Fiber.fiberInclusion.map (D.contract hRb (k Y₁ h₁ hh₁) hm₁ (hkb Y₁ h₁ hh₁)).inv ≫
            IsPreFibered.pullbackMap (D.obj b₀ hRb).2 (k Y₁ h₁ hh₁)) ≫ ζ₀ := by
          rw [F₁, Category.assoc]
      _ = _ := by simp only [Category.assoc]

/-- The chosen pullback of the object of `D` at `ε ≫ f`, contracted onto the chosen pullback of
the object at `f`, is the gluing isomorphism followed by the restriction map of the slice. -/
lemma pullbackMap_contract_inv {V W Z : 𝒮} {f : W ⟶ U} (hf : R f) (ε : V ⟶ W)
    (hRb : R (ε ≫ f)) (k : Z ⟶ V) :
    IsPreFibered.pullbackMap (D.obj (ε ≫ f) hRb).2 k ≫
        Fiber.fiberInclusion.map (D.contract hf ε hRb rfl).inv =
      Fiber.fiberInclusion.map (D.iso hRb hf k (k ≫ ε) (by rw [assoc])).hom ≫
        pullbackFiberMap p (D.obj f hf) (Over.homMk k rfl : Over.mk (k ≫ ε) ⟶ Over.mk ε) := by
  have : p.IsHomLift k (Fiber.fiberInclusion.map (D.iso hRb hf k (k ≫ ε) (by rw [assoc])).hom ≫
      pullbackFiberMap p (D.obj f hf) (Over.homMk k rfl : Over.mk (k ≫ ε) ⟶ Over.mk ε)) := by
    have : p.IsHomLift (𝟙 Z ≫ (Over.homMk k rfl : Over.mk (k ≫ ε) ⟶ Over.mk ε).left)
        (Fiber.fiberInclusion.map (D.iso hRb hf k (k ≫ ε) (by rw [assoc])).hom ≫
          pullbackFiberMap p (D.obj f hf) (Over.homMk k rfl : Over.mk (k ≫ ε) ⟶ Over.mk ε)) :=
      inferInstance
    simpa using this
  have : p.IsHomLift k (IsPreFibered.pullbackMap (D.obj (ε ≫ f) hRb).2 k ≫
      Fiber.fiberInclusion.map (D.contract hf ε hRb rfl).inv) := by
    have : p.IsHomLift (k ≫ 𝟙 V) (IsPreFibered.pullbackMap (D.obj (ε ≫ f) hRb).2 k ≫
        Fiber.fiberInclusion.map (D.contract hf ε hRb rfl).inv) := inferInstance
    simpa using this
  refine IsStronglyCartesian.ext p ε (IsPreFibered.pullbackMap (D.obj f hf).2 ε) k ?_
  rw [assoc, D.pullbackMap_contract_inv_pullbackMap hf ε hRb rfl k, assoc]
  exact congrArg _ (pullbackFiberMap_fac p (D.obj f hf)
    (Over.homMk k rfl : Over.mk (k ≫ ε) ⟶ Over.mk ε)).symm

/-- **Effectivity of a pulled back descent datum from one covering arrow, slice form.** The
version of `CategoryTheory.Functor.SieveDescentDatum.isEffective_pullback_of_singleArrow` in
which the morphism `ζ₁` starts at the chosen pullback along `ε` of the object of `D` at an arrow
`f` of `R`, and the compatibility is read through the restriction maps of that pullback. -/
theorem isEffective_pullback_of_singleArrow_slice (hp : p.IsFiberedInGroupoids)
    {K : GrothendieckTopology 𝒮} (hmor : ∀ (V : 𝒮) (x y : p.Fiber V), IsMorSheaf p K V x y)
    {V E W : 𝒮} (v : V ⟶ U) (e : E ⟶ V) (he : Sieve.generate (Presieve.singleton e) ∈ K V)
    {f : W ⟶ U} (hf : R f) (ε : E ⟶ W) (hb : e ≫ v = ε ≫ f) (y : p.Fiber V)
    (ζ₁ : (pullbackFiber p (D.obj f hf) ε).1 ⟶ y.1) (hζ₁ : p.IsHomLift e ζ₁)
    (hcompat : ∀ ⦃Z : 𝒮⦄ (k₁ k₂ : Z ⟶ E) (_hk : k₁ ≫ e = k₂ ≫ e) (a₁ a₂ : Z ⟶ W)
      (ha₁ : k₁ ≫ ε = a₁) (ha₂ : k₂ ≫ ε = a₂),
      Fiber.fiberInclusion.map (D.iso hf hf a₁ a₂
          (by rw [← ha₁, ← ha₂, assoc, assoc, ← hb, ← assoc, _hk, assoc])).hom ≫
        pullbackFiberMap p (D.obj f hf) (Over.homMk k₂ ha₂ : Over.mk a₂ ⟶ Over.mk ε) ≫ ζ₁ =
      pullbackFiberMap p (D.obj f hf) (Over.homMk k₁ ha₁ : Over.mk a₁ ⟶ Over.mk ε) ≫ ζ₁) :
    (D.pullback v).IsEffective := by
  have hRb : R (ε ≫ f) := R.downward_closed hf ε
  have hlift : p.IsHomLift e (Fiber.fiberInclusion.map (D.contract hf ε hRb rfl).inv ≫ ζ₁) := by
    have : p.IsHomLift (𝟙 E ≫ e)
        (Fiber.fiberInclusion.map (D.contract hf ε hRb rfl).inv ≫ ζ₁) := inferInstance
    simpa using this
  refine D.isEffective_pullback_of_singleArrow hp hmor v e he hb hRb y
    (Fiber.fiberInclusion.map (D.contract hf ε hRb rfl).inv ≫ ζ₁) hlift ?_
  intro Z k₁ k₂ hk
  have hkε : k₁ ≫ ε ≫ f = k₂ ≫ ε ≫ f := by rw [← hb, ← assoc, hk, assoc]
  have hcoc₁ := congrArg (Fiber.fiberInclusion.map ·) (D.cocycle hRb hRb hf k₁ k₂ (k₂ ≫ ε)
    hkε (assoc _ _ _).symm (hkε.trans (assoc _ _ _).symm))
  have hcoc₂ := congrArg (Fiber.fiberInclusion.map ·) (D.cocycle hRb hf hf k₁ (k₁ ≫ ε) (k₂ ≫ ε)
    (assoc _ _ _).symm ((assoc _ _ _).trans (hkε.trans (assoc _ _ _).symm))
    (hkε.trans (assoc _ _ _).symm))
  simp only [Functor.map_comp] at hcoc₁ hcoc₂
  calc _ = Fiber.fiberInclusion.map (D.iso hRb hRb k₁ k₂ hkε).hom ≫
        (IsPreFibered.pullbackMap (D.obj (ε ≫ f) hRb).2 k₂ ≫
          Fiber.fiberInclusion.map (D.contract hf ε hRb rfl).inv) ≫ ζ₁ := by
        simp only [assoc]
    _ = _ := by
      rw [pullbackMap_contract_inv, ← assoc, ← assoc, hcoc₁, ← hcoc₂, assoc, assoc,
        hcompat k₁ k₂ hk _ _ rfl rfl, ← assoc, ← pullbackMap_contract_inv, assoc]

end SieveDescentDatum

end CategoryTheory.Functor

end
