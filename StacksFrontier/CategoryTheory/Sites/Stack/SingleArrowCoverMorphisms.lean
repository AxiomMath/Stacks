module

public import StacksFrontier.CategoryTheory.Sites.InheritedTopology.MorGluing
public import StacksFrontier.CategoryTheory.FiberedCategory.Strictification
public import StacksCore.CategoryTheory.FiberedInGroupoidsEquiv

/-!
# Morphisms out of an object along a single covering arrow

Let `p : 𝒳 ⥤ 𝒮` be fibred in groupoids over a site `(𝒮, J)` and let `x` be an object over `U`
whose presheaves of morphisms are sheaves (condition (2) of Stacks 026F). Let `ζ : O ⟶ x` be a
lift of a morphism `v : V ⟶ U` which generates a covering sieve of `U` on its own. This file
shows that morphisms out of `x` are determined by their composites with `ζ`, and that a morphism
`ψ : O ⟶ b` descends along `ζ` to a morphism `x ⟶ b` as soon as it identifies any two morphisms
into `O` that `ζ` identifies.

## Main results

* `CategoryTheory.Functor.eq_of_comp_eq_of_singleCover`: morphisms out of `x` lying over one and
  the same morphism agree once they agree after `ζ`.
* `CategoryTheory.Functor.exists_comp_eq_of_singleCover`: the descent of a morphism along `ζ`.
-/

@[expose] public section

namespace CategoryTheory.Functor

open Limits

universe v₁ v₂ u₁ u₂

attribute [local implicit_reducible] Fiber Fiber.fiberInclusion

variable {𝒮 : Type u₁} [Category.{v₁} 𝒮] {𝒳 : Type u₂} [Category.{v₂} 𝒳]
  (p : 𝒳 ⥤ 𝒮) [p.IsFibered] (hp : p.IsFiberedInGroupoids) {J : GrothendieckTopology 𝒮}

/-- Two morphisms of a fibre whose composites with the chosen cartesian lift of `f` agree have the
same base change along `f`. -/
lemma pullbackFiberHom_eq_of_pullbackMap_comp_eq {W Z : 𝒮} {y y' : p.Fiber W} (m₁ m₂ : y ⟶ y')
    (f : Z ⟶ W)
    (h : IsPreFibered.pullbackMap y.2 f ≫ Fiber.fiberInclusion.map m₁ =
      IsPreFibered.pullbackMap y.2 f ≫ Fiber.fiberInclusion.map m₂) :
    pullbackFiberHom m₁ f = pullbackFiberHom m₂ f :=
  pullbackFiberHom_uniq m₂ f _ (by rw [pullbackFiberHom_fac, h])

/-- Members of the sieve generated by `v` factor as `a ≫ v`, and the chosen pullback of `x` along
them maps to `O` over `a`, compatibly with `ζ`. -/
private theorem exists_lift_of_mem_ofArrows (hp : p.IsFiberedInGroupoids) {U V Z : 𝒮}
    {v : V ⟶ U} {x : p.Fiber U} {O : 𝒳} (ζ : O ⟶ x.1) [p.IsHomLift v ζ] {f : Z ⟶ U}
    (hf : Sieve.ofArrows (fun _ : Unit => V) (fun _ => v) f) :
    ∃ (a : Z ⟶ V) (ω : (pullbackFiber p x f).1 ⟶ O),
      a ≫ v = f ∧ p.IsHomLift a ω ∧ ω ≫ ζ = IsPreFibered.pullbackMap x.2 f := by
  obtain ⟨_, a, rfl⟩ := (Sieve.mem_ofArrows_iff _ _ f).mp hf
  have := hp.isStronglyCartesian_homLift v ζ
  exact ⟨a, IsStronglyCartesian.map p v ζ (g := a) rfl (IsPreFibered.pullbackMap x.2 (a ≫ v)),
    rfl, inferInstance, IsStronglyCartesian.fac p v ζ _ _⟩

include hp in
/-- **Morphisms out of an object are determined along a single covering arrow.** If `v : V ⟶ U`
generates a covering sieve and `ζ : O ⟶ x` lies over `v`, two morphisms `x ⟶ b` lying over the same
morphism and agreeing after `ζ` are equal, when the presheaves `Mor(x, -)` are sheaves. -/
theorem eq_of_comp_eq_of_singleCover {U V B : 𝒮} {v : V ⟶ U}
    (hv : Sieve.ofArrows (fun _ : Unit => V) (fun _ => v) ∈ J U)
    {x : p.Fiber U} (hmor : ∀ y : p.Fiber U, IsMorSheaf p J U x y)
    {O : 𝒳} (ζ : O ⟶ x.1) [p.IsHomLift v ζ] {b : 𝒳} (g : U ⟶ B)
    (φ₁ φ₂ : x.1 ⟶ b) [p.IsHomLift g φ₁] [p.IsHomLift g φ₂] (h : ζ ≫ φ₁ = ζ ≫ φ₂) :
    φ₁ = φ₂ := by
  have hb : p.obj b = B := IsHomLift.codomain_eq p g φ₁
  let b₀ : p.Fiber B := ⟨b, hb⟩
  have key : toPullbackFiber p x b₀ g φ₁ = toPullbackFiber p x b₀ g φ₂ := by
    refine eq_of_pullbackFiberHom_locally_eq p (hmor (pullbackFiber p b₀ g)) hv ?_
    intro Z f hf
    obtain ⟨a, ω, rfl, -, hω⟩ := exists_lift_of_mem_ofArrows p hp ζ hf
    refine pullbackFiberHom_eq_of_pullbackMap_comp_eq p _ _ _ ?_
    have := hp.isStronglyCartesian_homLift g (IsPreFibered.pullbackMap b₀.2 g)
    refine IsStronglyCartesian.ext p g (IsPreFibered.pullbackMap b₀.2 g) (a ≫ v) ?_
    rw [Category.assoc, Category.assoc, toPullbackFiber_fac, toPullbackFiber_fac, ← hω,
      Category.assoc, Category.assoc, h]
  rw [← toPullbackFiber_fac p x b₀ g φ₁, ← toPullbackFiber_fac p x b₀ g φ₂, key]

include hp in
/-- **Descent of a morphism along a single covering arrow.** If `v : V ⟶ U` generates a covering
sieve, `ζ : O ⟶ x` lies over `v` and the presheaves `Mor(x, -)` are sheaves, a morphism
`ψ : O ⟶ b` over `v ≫ g` which identifies any two morphisms into `O` identified by `ζ` is
`ζ ≫ φ` for a morphism `φ : x ⟶ b` over `g`. -/
theorem exists_comp_eq_of_singleCover {U V B : 𝒮} {v : V ⟶ U}
    (hv : Sieve.ofArrows (fun _ : Unit => V) (fun _ => v) ∈ J U)
    {x : p.Fiber U} (hmor : ∀ y : p.Fiber U, IsMorSheaf p J U x y)
    {O : 𝒳} (ζ : O ⟶ x.1) [p.IsHomLift v ζ] {b : 𝒳} (g : U ⟶ B) (hb : p.obj b = B)
    (ψ : O ⟶ b) [p.IsHomLift (v ≫ g) ψ]
    (hψ : ∀ ⦃Z : 𝒮⦄ (e₁ e₂ : Z ⟶ V), e₁ ≫ v = e₂ ≫ v → ∀ ⦃A : 𝒳⦄ (a₁ a₂ : A ⟶ O),
      p.IsHomLift e₁ a₁ → p.IsHomLift e₂ a₂ → a₁ ≫ ζ = a₂ ≫ ζ → a₁ ≫ ψ = a₂ ≫ ψ) :
    ∃ φ : x.1 ⟶ b, p.IsHomLift g φ ∧ ζ ≫ φ = ψ := by
  classical
  have := hp.isStronglyCartesian_homLift v ζ
  let b₀ : p.Fiber B := ⟨b, hb⟩
  have := hp.isStronglyCartesian_homLift g (IsPreFibered.pullbackMap b₀.2 g)
  let R := Sieve.ofArrows (fun _ : Unit => V) (fun _ => v)
  -- the lift through `ζ` of the chosen pullback of `x` along a member of the sieve
  choose a ω ha iω hω using fun ⦃Z : 𝒮⦄ (f : Z ⟶ U) (hf : R.arrows f) =>
    exists_lift_of_mem_ofArrows p hp ζ hf
  have iωψ : ∀ ⦃Z : 𝒮⦄ (f : Z ⟶ U) (hf : R.arrows f), p.IsHomLift (f ≫ g) (ω f hf ≫ ψ) := by
    intro Z f hf
    have : p.IsHomLift (a f hf ≫ v ≫ g) (ω f hf ≫ ψ) := inferInstance
    rwa [← Category.assoc, ha f hf] at this
  let μ : ∀ ⦃Z : 𝒮⦄ (f : Z ⟶ U) (hf : R.arrows f),
      (pullbackFiber p x f).1 ⟶ (pullbackFiber p b₀ g).1 :=
    fun Z f hf => IsStronglyCartesian.map p g (IsPreFibered.pullbackMap b₀.2 g) (g := f)
      (f' := f ≫ g) rfl (ω f hf ≫ ψ)
  have hμ : ∀ ⦃Z : 𝒮⦄ (f : Z ⟶ U) (hf : R.arrows f),
      μ f hf ≫ IsPreFibered.pullbackMap b₀.2 g = ω f hf ≫ ψ :=
    fun Z f hf => IsStronglyCartesian.fac p g _ _ _
  have iμ : ∀ ⦃Z : 𝒮⦄ (f : Z ⟶ U) (hf : R.arrows f), p.IsHomLift f (μ f hf) :=
    fun Z f hf => inferInstance
  let θ : ∀ ⦃Z : 𝒮⦄ (f : Z ⟶ U) (hf : R.arrows f),
      pullbackFiber p x f ⟶ pullbackFiber p (pullbackFiber p b₀ g) f :=
    fun Z f hf => toPullbackFiber p _ _ f (μ f hf)
  have hθfac : ∀ ⦃Z : 𝒮⦄ (f : Z ⟶ U) (hf : R.arrows f),
      Fiber.fiberInclusion.map (θ f hf) ≫
        IsPreFibered.pullbackMap (pullbackFiber p b₀ g).2 f = μ f hf :=
    fun Z f hf => toPullbackFiber_fac p _ _ f _
  obtain ⟨m, hm⟩ := exists_fiberHom_of_locally p (hmor (pullbackFiber p b₀ g)) hv θ (by
    intro Z W f hf γ bb hbb hbb'
    refine fiber_hom_ext_of_cartesian bb
      (IsPreFibered.pullbackMap (pullbackFiber p b₀ g).2 bb)
      (IsPreFibered.pullbackMap.IsCartesian _ _) _ _ ?_
    rw [hθfac]
    simp only [Functor.map_comp, Category.assoc, pullbackFiberCompIso'_hom_fac,
      pullbackFiberHom_fac_assoc, hθfac]
    -- the two lifts into the chosen pullback of `b` agree
    have i₁ : p.IsHomLift bb (Fiber.fiberInclusion.map
        (pullbackFiberCompIso' x f γ bb hbb).inv ≫
          IsPreFibered.pullbackMap (pullbackFiber p x f).2 γ ≫ μ f hf) := by
      have : p.IsHomLift (𝟙 W ≫ γ ≫ f) (Fiber.fiberInclusion.map
          (pullbackFiberCompIso' x f γ bb hbb).inv ≫
            IsPreFibered.pullbackMap (pullbackFiber p x f).2 γ ≫ μ f hf) := inferInstance
      rwa [Category.id_comp, hbb] at this
    refine IsStronglyCartesian.ext p g (IsPreFibered.pullbackMap b₀.2 g) bb ?_
    rw [hμ, Category.assoc, Category.assoc, hμ]
    have i₂ : p.IsHomLift (𝟙 W ≫ γ ≫ a f hf) (Fiber.fiberInclusion.map
        (pullbackFiberCompIso' x f γ bb hbb).inv ≫
          IsPreFibered.pullbackMap (pullbackFiber p x f).2 γ ≫ ω f hf) := inferInstance
    rw [← Category.assoc (IsPreFibered.pullbackMap _ γ), ← Category.assoc]
    refine hψ (a bb hbb') (𝟙 W ≫ γ ≫ a f hf) ?_ _ _ (iω bb hbb') i₂ ?_
    · rw [ha bb hbb', Category.assoc, Category.assoc, ha f hf, Category.id_comp, hbb]
    · rw [hω, Category.assoc, Category.assoc, hω, pullbackFiberCompIso'_inv_fac])
  refine ⟨Fiber.fiberInclusion.map m ≫ IsPreFibered.pullbackMap b₀.2 g, ?_, ?_⟩
  · have : p.IsHomLift (𝟙 U ≫ g) (Fiber.fiberInclusion.map m ≫
        IsPreFibered.pullbackMap b₀.2 g) := inferInstance
    rwa [Category.id_comp] at this
  · have hv' : R.arrows v := Sieve.ofArrows_mk _ _ ()
    have hO : p.obj O = V := IsHomLift.domain_eq p v ζ
    let ζv := toPullbackFiber p ⟨O, hO⟩ x v ζ
    have hζv : Fiber.fiberInclusion.map ζv ≫ IsPreFibered.pullbackMap x.2 v = ζ :=
      toPullbackFiber_fac p ⟨O, hO⟩ x v ζ
    have key : Fiber.fiberInclusion.map ζv ≫ ω v hv' ≫ ψ = ψ := by
      have i₂ : p.IsHomLift (𝟙 V ≫ a v hv') (Fiber.fiberInclusion.map ζv ≫ ω v hv') :=
        inferInstance
      have := hψ (𝟙 V ≫ a v hv') (𝟙 V) (by rw [Category.id_comp, Category.id_comp, ha v hv'])
        (Fiber.fiberInclusion.map ζv ≫ ω v hv') (𝟙 O) i₂ (IsHomLift.id hO)
        (by rw [Category.assoc, hω, hζv]; exact (Category.id_comp ζ).symm)
      exact (Category.assoc _ _ _).symm.trans (this.trans (Category.id_comp ψ))
    rw [← hζv, Category.assoc, ← Category.assoc (IsPreFibered.pullbackMap x.2 v),
      ← pullbackFiberHom_fac, hm v hv', Category.assoc,
      ← Category.assoc (Fiber.fiberInclusion.map (θ v hv')), hθfac, hμ, key]

end CategoryTheory.Functor

end
