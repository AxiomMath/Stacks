module

public import StacksFrontier.CategoryTheory.Sites.InheritedTopology.DescentUniqueness
public import StacksFrontier.CategoryTheory.Sites.Stack.EffectiveDescentRefinement
public import StacksFrontier.CategoryTheory.Sites.Stack.StackBridge.IsomSheaf

/-!
# Effectivity of a sieve-indexed descent datum from a cocone on the chosen overlaps

Let `p : 𝒳 ⥤ 𝒞` be a category fibred in groupoids over a category with fibre products, and let
`D` be a descent datum relative to the sieve generated by a family `{f l : V l ⟶ U}`
(`CategoryTheory.Functor.SieveDescentDatum`). This file reduces the effectivity of `D` to data
over the members of the family and their chosen pairwise fibre products only.

The object the datum attaches to an arrow of the sieve can be moved along a factorization of
that arrow through another arrow of the sieve: contract the chosen pullback of the object at the
longer arrow onto the object at the shorter one and follow the chosen cartesian lift.  That is
`CategoryTheory.Functor.SieveDescentDatum.transportMap`; it lies cartesianly over the
factorization and it is functorial in it.  The objects at the members, at the chosen pairwise
fibre products and at the chosen triple fibre products, joined by these transports, form a
diagram, and a cocone on that diagram — morphisms `ζ l` from the objects at the members to one
object over `U`, lying over the members and equalized by the two transports out of each pairwise
fibre product — is all that effectivity asks for.

## Main definitions

* `CategoryTheory.Functor.SieveDescentDatum.transportMap`: the transport of a descent datum along
  a factorization of an arrow of its sieve.

## Main results

* `CategoryTheory.Functor.SieveDescentDatum.transportMap_cartesian` and
  `CategoryTheory.Functor.SieveDescentDatum.transportMap_comp`: the transport lies cartesianly
  over the factorization and is functorial in it.
* `CategoryTheory.Functor.SieveDescentDatum.isEffective_of_pairCocone`: **a cocone over the
  members of the family, equalized on the chosen pairwise fibre products, makes the datum
  effective.**

## References

* [Stacks Project, Tag 026B](https://stacks.math.columbia.edu/tag/026B)
* [Stacks Project, Tag 026F](https://stacks.math.columbia.edu/tag/026F)
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits

universe w u₁ v₁ u₂ v₂

namespace CategoryTheory.Functor

attribute [local implicit_reducible] Functor.Fiber Functor.Fiber.fiberInclusion

variable {C : Type u₁} [Category.{v₁} C] {E : Type u₂} [Category.{v₂} E]
  {p : E ⥤ C} [p.IsFibered] {U : C} {R : Sieve U}

namespace SieveDescentDatum

/-- The morphism between the objects a sieve-indexed descent datum attaches to two arrows of its
sieve, one of which factors through the other: contract the chosen pullback of the object at the
longer arrow onto the object at the shorter one, and follow the chosen cartesian lift. -/
def transportMap (D : SieveDescentDatum p R)
    {V W : C} {f : V ⟶ U} (hf : R f) {g : W ⟶ U} (hg : R g)
    (a : W ⟶ V) (ha : a ≫ f = g) : (D.obj g hg).1 ⟶ (D.obj f hf).1 :=
  Fiber.fiberInclusion.map (D.contract hf a hg ha).inv ≫
    IsPreFibered.pullbackMap (D.obj f hf).2 a

/-- The transport of a descent datum along a factorization lies cartesianly over that
factorization. -/
lemma transportMap_cartesian (D : SieveDescentDatum p R)
    {V W : C} {f : V ⟶ U} (hf : R f) {g : W ⟶ U} (hg : R g)
    (a : W ⟶ V) (ha : a ≫ f = g) : p.IsCartesian a (D.transportMap hf hg a ha) := by
  have : p.IsHomLift (𝟙 W) (Fiber.fiberInclusion.map (D.contract hf a hg ha).inv) :=
    (D.contract hf a hg ha).inv.2
  have : p.IsCartesian a (IsPreFibered.pullbackMap (D.obj f hf).2 a) :=
    IsPreFibered.pullbackMap.IsCartesian _ _
  have hh : p.IsCartesian (𝟙 W ≫ a) (D.transportMap hf hg a ha) := by
    dsimp [transportMap]
    infer_instance
  simpa using hh

/-- The transport of a descent datum lies over the factorization. -/
lemma transportMap_isHomLift (D : SieveDescentDatum p R)
    {V W : C} {f : V ⟶ U} (hf : R f) {g : W ⟶ U} (hg : R g)
    (a : W ⟶ V) (ha : a ≫ f = g) : p.IsHomLift a (D.transportMap hf hg a ha) :=
  (D.transportMap_cartesian hf hg a ha).toIsHomLift

/-- The transport of a descent datum is functorial in the factorization. -/
lemma transportMap_comp (D : SieveDescentDatum p R)
    {V W Z : C} {f : V ⟶ U} (hf : R f) {g : W ⟶ U} (hg : R g)
    {b : Z ⟶ U} (hb : R b) (a : W ⟶ V) (a' : Z ⟶ W)
    (ha : a ≫ f = g) (ha' : a' ≫ g = b) :
    D.transportMap hg hb a' ha' ≫ D.transportMap hf hg a ha =
      D.transportMap hf hb (a' ≫ a) (by rw [Category.assoc, ha, ha']) := by
  have he : pullbackFiberIso (D.contract hf a hg ha) a' ≪≫ D.contract hg a' hb ha' =
      pullbackFiberCompIso (D.obj f hf) a a' ≪≫
        D.contract hf (a' ≫ a) hb (by rw [Category.assoc, ha, ha']) := by
    apply Iso.ext
    simp only [Iso.trans_hom, pullbackFiberIso_hom]
    rw [D.pullbackFiberHom_contract]
    simp only [SieveDescentDatum.contract, Iso.trans_hom, Category.assoc]
    rw [← Category.assoc (D.iso hf hg (a' ≫ a) a' _).hom, D.cocycle]
  have hi := congrArg Iso.inv he
  simp only [Iso.trans_inv, pullbackFiberIso_inv] at hi
  simp only [transportMap, Category.assoc]
  rw [← pullbackFiberHom_fac_assoc, ← Category.assoc, ← Functor.map_comp, hi,
    Functor.map_comp, Category.assoc, pullbackFiberCompIso_inv_fac]

/-- The transport absorbs a contraction of the datum. -/
lemma contract_hom_comp_transportMap (D : SieveDescentDatum p R)
    {V W : C} {f : V ⟶ U} (hf : R f) {b : W ⟶ U} (hb : R b) (γ : W ⟶ V) (hγ : γ ≫ f = b) :
    Fiber.fiberInclusion.map (D.contract hf γ hb hγ).hom ≫ D.transportMap hf hb γ hγ =
      IsPreFibered.pullbackMap (D.obj f hf).2 γ := by
  change Fiber.fiberInclusion.map (D.contract hf γ hb hγ).hom ≫
    Fiber.fiberInclusion.map (D.contract hf γ hb hγ).inv ≫
      IsPreFibered.pullbackMap (D.obj f hf).2 γ = _
  rw [← Category.assoc, ← Functor.map_comp, Iso.hom_inv_id, CategoryTheory.Functor.map_id,
    Category.id_comp]

end SieveDescentDatum

variable [HasPullbacks C] {L : Type w} {V : L → C} (f : ∀ l, V l ⟶ U)

namespace SieveDescentDatum

/-- **Effectivity of a descent datum relative to the sieve generated by a family, from a cocone
on the chosen pairwise fibre products.**  Let `p` be fibred in groupoids and let `D` be a descent
datum relative to the sieve generated by `{f l : V l ⟶ U}`.  Suppose given an object `x` of the
fibre over `U` and morphisms `ζ l` from the object at `f l` to `x`, lying over `f l`, which are
equalized by the two transports of the datum out of the object at each chosen fibre product
`V l ×_U V m`.  Then `D` is effective. -/
theorem isEffective_of_pairCocone (hgpd : p.IsFiberedInGroupoids)
    (D : SieveDescentDatum p (Sieve.ofArrows V f)) (x : p.Fiber U)
    (ζ : ∀ l, (D.obj (f l) (Sieve.ofArrows_mk V f l)).1 ⟶ x.1)
    (hζ : ∀ l, p.IsHomLift (f l) (ζ l))
    (hpair : ∀ l m,
      D.transportMap (Sieve.ofArrows_mk V f l)
          ((Sieve.ofArrows V f).downward_closed (Sieve.ofArrows_mk V f l)
            (pullback.fst (f l) (f m)))
          (pullback.fst (f l) (f m)) rfl ≫ ζ l =
        D.transportMap (Sieve.ofArrows_mk V f m)
          ((Sieve.ofArrows V f).downward_closed (Sieve.ofArrows_mk V f l)
            (pullback.fst (f l) (f m)))
          (pullback.snd (f l) (f m)) pullback.condition.symm ≫ ζ m) :
    D.IsEffective := by
  classical
  have hR (l : L) : (Sieve.ofArrows V f) (f l) := Sieve.ofArrows_mk V f l
  have hcompat : ∀ {A : C} (l m : L) {b : A ⟶ U} (hb : (Sieve.ofArrows V f) b)
      (a : A ⟶ V l) (a' : A ⟶ V m) (ha : a ≫ f l = b) (ha' : a' ≫ f m = b),
      D.transportMap (hR l) hb a ha ≫ ζ l = D.transportMap (hR m) hb a' ha' ≫ ζ m := by
    intro A l m b hb a a' ha ha'
    have h₂ : (Sieve.ofArrows V f) (pullback.fst (f l) (f m) ≫ f l) :=
      (Sieve.ofArrows V f).downward_closed (hR l) (pullback.fst (f l) (f m))
    obtain ⟨t, rfl, rfl⟩ : ∃ t : A ⟶ Limits.pullback (f l) (f m),
        t ≫ pullback.fst _ _ = a ∧ t ≫ pullback.snd _ _ = a' :=
      ⟨pullback.lift a a' (ha.trans ha'.symm), pullback.lift_fst _ _ _, pullback.lift_snd _ _ _⟩
    have hlift : t ≫ (pullback.fst (f l) (f m) ≫ f l) = b := by rw [← Category.assoc]; exact ha
    rw [← D.transportMap_comp (hR l) h₂ hb _ t rfl hlift,
      ← D.transportMap_comp (hR m) h₂ hb _ t pullback.condition.symm hlift,
      Category.assoc, Category.assoc, hpair l m]
  have hex : ∀ (A : C) (h : A ⟶ U), (Sieve.ofArrows V f).arrows h →
      ∃ (l : L) (b : A ⟶ V l), b ≫ f l = h :=
    fun _ _ hh ↦ Functor.exists_factorization_of_ofArrows hh
  choose idx arr harr using hex
  obtain ⟨ζs, hζdef⟩ :
      ∃ ζs : ∀ ⦃A : C⦄ (h : A ⟶ U) (hh : (Sieve.ofArrows V f).arrows h),
        (D.obj h hh).1 ⟶ x.1,
        ∀ ⦃A : C⦄ (h : A ⟶ U) (hh : (Sieve.ofArrows V f).arrows h),
          ζs h hh = D.transportMap (hR (idx A h hh)) hh (arr A h hh) (harr A h hh) ≫
            ζ (idx A h hh) :=
    ⟨fun {A} h hh ↦ D.transportMap (hR (idx A h hh)) hh (arr A h hh) (harr A h hh) ≫
      ζ (idx A h hh), fun _ _ _ ↦ rfl⟩
  refine (SieveDescentDatum.isEffective_iff_exists_descends p D).mpr
    ⟨x, ζs, D.descends_of_isoAlong x ζs (fun {A} h hh ↦ ?_) ?_⟩
  · have h₁ := D.transportMap_isHomLift (hR (idx A h hh)) hh (arr A h hh) (harr A h hh)
    have h₂ := hζ (idx A h hh)
    have h₃ : p.IsHomLift (arr A h hh ≫ f (idx A h hh))
        (D.transportMap (hR (idx A h hh)) hh (arr A h hh) (harr A h hh) ≫
          ζ (idx A h hh)) := inferInstance
    rw [harr A h hh] at h₃
    rw [hζdef h hh]
    have h₄ : p.IsStronglyCartesian h
        (D.transportMap (hR (idx A h hh)) hh (arr A h hh) (harr A h hh) ≫
          ζ (idx A h hh)) := by
      have := h₃
      exact hgpd.isStronglyCartesian_homLift h _
    exact Functor.IsStronglyCartesian.isCartesian_of_isStronglyCartesian _ h _
  · intro A A' h hh γ b hb hb'
    have hkey := hcompat (idx A' b hb') (idx A h hh) hb' (arr A' b hb') (γ ≫ arr A h hh)
      (harr A' b hb') (by rw [Category.assoc, harr A h hh]; exact hb)
    calc Fiber.fiberInclusion.map (D.contract hh γ hb' hb).hom ≫ ζs b hb'
        = Fiber.fiberInclusion.map (D.contract hh γ hb' hb).hom ≫
            (D.transportMap hh hb' γ hb ≫
              D.transportMap (hR (idx A h hh)) hh (arr A h hh) (harr A h hh)) ≫
            ζ (idx A h hh) := by
          rw [hζdef b hb', hkey, D.transportMap_comp]
      _ = (Fiber.fiberInclusion.map (D.contract hh γ hb' hb).hom ≫
            D.transportMap hh hb' γ hb) ≫
            D.transportMap (hR (idx A h hh)) hh (arr A h hh) (harr A h hh) ≫
            ζ (idx A h hh) := by
          simp only [Category.assoc]
      _ = IsPreFibered.pullbackMap (D.obj h hh).2 γ ≫ ζs h hh := by
          rw [D.contract_hom_comp_transportMap, hζdef h hh]

end SieveDescentDatum

end CategoryTheory.Functor

end
