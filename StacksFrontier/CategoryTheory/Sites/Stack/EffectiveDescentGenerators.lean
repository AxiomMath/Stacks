module

public import StacksFrontier.CategoryTheory.Sites.Stackification.StageThreeEffectiveDescent

/-!
# Effectivity of a descent datum along a sieve generated by a family, from the generators

Let `R` be the sieve generated by a family `{f l : N l ⟶ U}`. A descent datum relative to `R`
attaches objects to *every* arrow of `R`, and effectivity asks for a cartesian morphism out of
each of them. This file shows that it suffices to give cartesian morphisms out of the objects at
the generators `f l`, compatible with the gluing isomorphisms of the datum on the chosen fibre
products `N l ×_U N m`: the morphism at an arbitrary arrow `γ ≫ f l` of `R` is the one at `f l`,
pulled back along `γ` and transported along the contraction of the datum.

No Stacks tag states this on its own: it is the passage between the family and the sieve forms of
descent data that the Stacks project makes silently (Stacks 026B, 026E). The declarations below
are therefore left untagged.

## Main results

* `CategoryTheory.Functor.SieveDescentDatum.isEffective_of_generators`: the statement above.
-/

@[expose] public noncomputable section

namespace CategoryTheory.Functor

open CategoryTheory Category Limits

universe w v₁ v₂ u₁ u₂

variable {𝒮 : Type u₁} [Category.{v₁} 𝒮] {𝒳 : Type u₂} [Category.{v₂} 𝒳] {p : 𝒳 ⥤ 𝒮}
  [p.IsFibered] {U : 𝒮} {L : Type w} {N : L → 𝒮} {f : ∀ l, N l ⟶ U}

namespace SieveDescentDatum

/-- A generator of a sieve generated by a family is one of its arrows. -/
theorem ofArrows_gen (l : L) : (Sieve.ofArrows N f).arrows (f l) :=
  Sieve.ofArrows_mk N f l

/-- An arrow of the sieve generated by a family factors through one of its generators. -/
theorem exists_factor_of_ofArrows {W : 𝒮} {b : W ⟶ U} (hb : (Sieve.ofArrows N f).arrows b) :
    ∃ (l : L) (γ : W ⟶ N l), γ ≫ f l = b := by
  obtain ⟨Y, h, g, ⟨l⟩, rfl⟩ := hb
  exact ⟨l, h, rfl⟩

variable (D : SieveDescentDatum p (Sieve.ofArrows N f))

/-- **Compatibility at the chosen fibre products of the generators is compatibility at every
pair.** A pair of morphisms into two generators with the same composite factors through their
chosen fibre product, and the gluing isomorphism base-changes by
`CategoryTheory.Functor.SieveDescentDatum.iso_pullback`. -/
theorem generators_compat [HasPullbacks 𝒮] {a : p.Fiber U}
    (ζ : ∀ l, (D.obj (f l) (ofArrows_gen l)).1 ⟶ a.1)
    (hglue : ∀ l m, Fiber.fiberInclusion.map (D.iso (ofArrows_gen l) (ofArrows_gen m)
          (Limits.pullback.fst (f l) (f m)) (Limits.pullback.snd (f l) (f m))
          Limits.pullback.condition).hom ≫
        IsPreFibered.pullbackMap (D.obj (f m) (ofArrows_gen m)).2
          (Limits.pullback.snd (f l) (f m)) ≫
          ζ m =
      IsPreFibered.pullbackMap (D.obj (f l) (ofArrows_gen l)).2
        (Limits.pullback.fst (f l) (f m)) ≫ ζ l)
    (l m : L) {Z : 𝒮} (γ : Z ⟶ N l) (γ' : Z ⟶ N m) (h : γ ≫ f l = γ' ≫ f m) :
    Fiber.fiberInclusion.map (D.iso (ofArrows_gen l) (ofArrows_gen m) γ γ' h).hom ≫
        IsPreFibered.pullbackMap (D.obj (f m) (ofArrows_gen m)).2 γ' ≫ ζ m =
      IsPreFibered.pullbackMap (D.obj (f l) (ofArrows_gen l)).2 γ ≫ ζ l := by
  obtain ⟨k, rfl, rfl⟩ : ∃ k : Z ⟶ Limits.pullback (f l) (f m),
      k ≫ Limits.pullback.fst (f l) (f m) = γ ∧ k ≫ Limits.pullback.snd (f l) (f m) = γ' :=
    ⟨Limits.pullback.lift γ γ' h, Limits.pullback.lift_fst _ _ _, Limits.pullback.lift_snd _ _ _⟩
  rw [← D.iso_pullback (ofArrows_gen l) (ofArrows_gen m) (Limits.pullback.fst (f l) (f m))
    (Limits.pullback.snd (f l) (f m)) Limits.pullback.condition k]
  simp only [Functor.map_comp, Category.assoc, pullbackFiberIso_hom]
  rw [pullbackFiberCompIso_hom_fac_assoc, pullbackFiberHom_fac_assoc]
  exact (congrArg (fun t => _ ≫ _ ≫ t) (hglue l m)).trans
    (pullbackFiberCompIso_inv_fac_assoc _ _ _ _)

/-- **Two factorizations through generators give the same contracted morphism.** If `δ ≫ f m` and
`γ ≫ f l` are both equal to `b`, contracting the morphism at `f m` along `δ` and the one at `f l`
along `γ` onto the object at `b` give the same morphism, by compatibility at the pair `(δ, γ)`
and the cocycle condition. -/
theorem contract_inv_generators_eq [HasPullbacks 𝒮] {a : p.Fiber U}
    (ζ : ∀ l, (D.obj (f l) (ofArrows_gen l)).1 ⟶ a.1)
    (hall : ∀ (l m : L) {Z : 𝒮} (γ : Z ⟶ N l) (γ' : Z ⟶ N m) (h : γ ≫ f l = γ' ≫ f m),
      Fiber.fiberInclusion.map (D.iso (ofArrows_gen l) (ofArrows_gen m) γ γ' h).hom ≫
          IsPreFibered.pullbackMap (D.obj (f m) (ofArrows_gen m)).2 γ' ≫ ζ m =
        IsPreFibered.pullbackMap (D.obj (f l) (ofArrows_gen l)).2 γ ≫ ζ l)
    {W : 𝒮} {b : W ⟶ U} (hb : (Sieve.ofArrows N f).arrows b) (m l : L) (δ : W ⟶ N m)
    (γ : W ⟶ N l) (hδ : δ ≫ f m = b) (hγ : γ ≫ f l = b) :
    Fiber.fiberInclusion.map (D.contract (ofArrows_gen m) δ hb hδ).inv ≫
        IsPreFibered.pullbackMap (D.obj (f m) (ofArrows_gen m)).2 δ ≫ ζ m =
      Fiber.fiberInclusion.map (D.contract (ofArrows_gen l) γ hb hγ).inv ≫
        IsPreFibered.pullbackMap (D.obj (f l) (ofArrows_gen l)).2 γ ≫ ζ l := by
  have key : (D.contract (ofArrows_gen m) δ hb hδ).inv ≫
      (D.iso (ofArrows_gen m) (ofArrows_gen l) δ γ (hδ.trans hγ.symm)).hom =
        (D.contract (ofArrows_gen l) γ hb hγ).inv := by
    rw [Iso.inv_comp_eq]
    simp only [contract, Iso.trans_hom, Iso.trans_inv, Category.assoc, Iso.hom_inv_id_assoc]
    rw [← D.iso_symm (ofArrows_gen l) hb γ (𝟙 W) (by rw [hγ, Category.id_comp]),
      D.cocycle (ofArrows_gen m) hb (ofArrows_gen l) δ (𝟙 W) γ (by rw [hδ, Category.id_comp])
        (by rw [Category.id_comp, hγ]) (hδ.trans hγ.symm)]
  rw [← key, Functor.map_comp, Category.assoc, hall m l δ γ (hδ.trans hγ.symm)]
  rfl

/-- **Effectivity along a sieve generated by a family, from the generators.** Let `D` be a descent
datum relative to the sieve generated by `{f l : N l ⟶ U}`, `a` an object of the fibre over `U`
and `ζ l` cartesian morphisms over `f l` from the objects of `D` at the generators to `a`,
compatible with the gluing isomorphisms of `D` on the chosen fibre products `N l ×_U N m`. Then
`D` is effective: the morphism at an arrow `γ ≫ f l` of the sieve is `ζ l`, pulled back along `γ`
and transported along the contraction of `D`. -/
theorem isEffective_of_generators [HasPullbacks 𝒮] (a : p.Fiber U)
    (ζ : ∀ l, (D.obj (f l) (ofArrows_gen l)).1 ⟶ a.1)
    (hcart : ∀ l, p.IsCartesian (f l) (ζ l))
    (hglue : ∀ l m, Fiber.fiberInclusion.map (D.iso (ofArrows_gen l) (ofArrows_gen m)
          (Limits.pullback.fst (f l) (f m)) (Limits.pullback.snd (f l) (f m))
          Limits.pullback.condition).hom ≫
        IsPreFibered.pullbackMap (D.obj (f m) (ofArrows_gen m)).2
          (Limits.pullback.snd (f l) (f m)) ≫ ζ m =
      IsPreFibered.pullbackMap (D.obj (f l) (ofArrows_gen l)).2
        (Limits.pullback.fst (f l) (f m)) ≫ ζ l) :
    D.IsEffective := by
  classical
  have hall := generators_compat D ζ hglue
  have hfac := fun (W : 𝒮) (b : W ⟶ U) (hb : (Sieve.ofArrows N f).arrows b) =>
    exists_factor_of_ofArrows hb
  choose lb γb hγb using hfac
  let ζ' : ∀ ⦃W : 𝒮⦄ (b : W ⟶ U) (hb : (Sieve.ofArrows N f).arrows b), (D.obj b hb).1 ⟶ a.1 :=
    fun W b hb => Fiber.fiberInclusion.map (D.contract (ofArrows_gen (lb W b hb)) (γb W b hb) hb
        (hγb W b hb)).inv ≫
      IsPreFibered.pullbackMap (D.obj _ (ofArrows_gen (lb W b hb))).2 (γb W b hb) ≫ ζ (lb W b hb)
  have hcart' : ∀ ⦃W : 𝒮⦄ (b : W ⟶ U) (hb : (Sieve.ofArrows N f).arrows b),
      p.IsCartesian b (ζ' b hb) := by
    intro W b hb
    have h₁ : p.IsHomLift (𝟙 W) (Fiber.fiberInclusion.mapIso
        (D.contract (ofArrows_gen (lb W b hb)) (γb W b hb) hb (hγb W b hb))).symm.hom :=
      (D.contract (ofArrows_gen (lb W b hb)) (γb W b hb) hb (hγb W b hb)).inv.2
    have h₂ : p.IsCartesian (γb W b hb) (IsPreFibered.pullbackMap
        (D.obj _ (ofArrows_gen (lb W b hb))).2 (γb W b hb)) :=
      IsPreFibered.pullbackMap.IsCartesian _ _
    have h₃ := hcart (lb W b hb)
    have h₂₃ : p.IsCartesian (γb W b hb ≫ f (lb W b hb)) (IsPreFibered.pullbackMap
        (D.obj _ (ofArrows_gen (lb W b hb))).2 (γb W b hb) ≫ ζ (lb W b hb)) := inferInstance
    have h : p.IsCartesian (γb W b hb ≫ f (lb W b hb))
        ((Fiber.fiberInclusion.mapIso (D.contract (ofArrows_gen (lb W b hb)) (γb W b hb) hb
          (hγb W b hb))).symm.hom ≫ (IsPreFibered.pullbackMap
            (D.obj _ (ofArrows_gen (lb W b hb))).2 (γb W b hb) ≫ ζ (lb W b hb))) :=
      @IsCartesian.of_iso_comp _ _ _ _ p _ _ _ _ _ _ h₂₃ _ _ h₁
    rw [hγb W b hb] at h
    exact h
  refine ⟨a, ζ', D.descends_of_isoAlong a ζ' hcart' ?_⟩
  intro V W g hg γ b hγ hb
  have h1 := hγb V g hg
  have hδ : (γ ≫ γb V g hg) ≫ f (lb V g hg) = b := by rw [Category.assoc, h1, hγ]
  have hI : (D.iso (ofArrows_gen (lb V g hg)) hg (γ ≫ γb V g hg) γ
      (by rw [Category.assoc, h1])).hom ≫ (D.contract hg γ hb hγ).hom =
        (D.contract (ofArrows_gen (lb V g hg)) (γ ≫ γb V g hg) hb hδ).hom := by
    simp only [contract, Iso.trans_hom, ← Category.assoc]
    rw [D.cocycle (ofArrows_gen (lb V g hg)) hg hb (γ ≫ γb V g hg) γ (𝟙 W)
      (by rw [Category.assoc, h1]) (by rw [Category.id_comp, hγ]) (by rw [Category.id_comp, hδ])]
  have fe : (D.contract hg γ hb hγ).hom ≫
      (D.contract (ofArrows_gen (lb V g hg)) (γ ≫ γb V g hg) hb hδ).inv =
        pullbackFiberHom (D.contract (ofArrows_gen (lb V g hg)) (γb V g hg) hg h1).inv γ ≫
          (pullbackFiberCompIso (D.obj _ (ofArrows_gen (lb V g hg))) (γb V g hg) γ).hom := by
    rw [← cancel_epi (pullbackFiberIso
      (D.contract (ofArrows_gen (lb V g hg)) (γb V g hg) hg h1) γ).hom, pullbackFiberIso_hom,
      ← pullbackFiberHom_comp_assoc, Iso.hom_inv_id, pullbackFiberHom_id, Category.id_comp,
      pullbackFiberHom_contract D (ofArrows_gen (lb V g hg)) (γb V g hg) hg h1 γ,
      Category.assoc, reassoc_of% hI, Iso.hom_inv_id, Category.comp_id]
  have step1 := contract_inv_generators_eq D ζ hall hb (lb V g hg) (lb W b hb)
    (γ ≫ γb V g hg) (γb W b hb) hδ (hγb W b hb)
  refine (congrArg (_ ≫ ·) step1.symm).trans ?_
  rw [← Category.assoc, ← Functor.map_comp, fe, Functor.map_comp, Category.assoc,
    pullbackFiberCompIso_hom_fac_assoc, pullbackFiberHom_fac_assoc]
  rfl

end SieveDescentDatum

end CategoryTheory.Functor
