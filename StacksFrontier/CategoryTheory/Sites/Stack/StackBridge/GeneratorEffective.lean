module

public import StacksFrontier.CategoryTheory.Sites.Descent.IsStack.SieveDescentDatum
public import StacksFrontier.CategoryTheory.Sites.Descent.IsStack.PullbackFiberComp
public import StacksFrontier.CategoryTheory.Sites.Stack.StackBridge.IsomSheaf

/-!
# Effectivity of a descent datum from its generators

A descent datum `D` relative to the sieve generated by a family `{f i : V i ⟶ U}` is effective as
soon as the objects of `D` at the *generators* `f i` alone admit cartesian morphisms `ζ i` to an
object `a` of the fibre over `U`, compatible with the gluing isomorphisms between two generators.

Every arrow `g` of the generated sieve factors as `a_g ≫ f i_g` for a chosen index `i_g`; the
cartesian morphism attached to `g` is the gluing isomorphism of `D` from `g` to `f i_g`, read at
`(𝟙, a_g)`, followed by the chosen cartesian lift of `a_g` and by `ζ i_g`. Base change of the
gluing isomorphisms (`CategoryTheory.Functor.SieveDescentDatum.iso_pullback`) computes the
pullback of that morphism along any `ε`, the cocycle condition together with the compatibility on
generators shows that the result does not depend on the factorization, and the compatibility
required by effectivity follows by the cocycle condition once more.

## Main results

* `CategoryTheory.Functor.SieveDescentDatum.isEffective_of_generators_of_pairwise_compat`:
  effectivity from cartesian morphisms on the generators compatible over arbitrary pairs
  `(b, b')`, in a base without fibre products. With fibre products, compatibility over the chosen
  fibre products `V i ×_U V j` suffices: that is
  `CategoryTheory.Functor.SieveDescentDatum.isEffective_of_generators`.
-/

@[expose] public section

namespace CategoryTheory

open Limits

universe w v₁ v₂ u₁ u₂

namespace Functor

attribute [local implicit_reducible] Fiber Fiber.fiberInclusion

variable {𝒞 : Type u₁} [Category.{v₁} 𝒞] {𝒳 : Type u₂} [Category.{v₂} 𝒳]
variable {p : 𝒳 ⥤ 𝒞} [p.IsFibered]

namespace SieveDescentDatum

section General

variable {U : 𝒞} {R : Sieve U} (D : SieveDescentDatum p R)

/-- `CategoryTheory.Functor.SieveDescentDatum.iso_pullback` with the two composite base morphisms
named: the base change along `γ` of the gluing isomorphism at `(ε, ε')`, read through the
contractions onto the chosen pullbacks along `m = γ ≫ ε` and `m' = γ ≫ ε'`, is the gluing
isomorphism at `(m, m')`. -/
lemma iso_pullback' ⦃V W Z Z' : 𝒞⦄ ⦃f : V ⟶ U⦄ (hf : R f) ⦃g : W ⟶ U⦄ (hg : R g)
    (ε : Z ⟶ V) (ε' : Z ⟶ W) (heq : ε ≫ f = ε' ≫ g) (γ : Z' ⟶ Z) (m : Z' ⟶ V)
    (hm : γ ≫ ε = m) (m' : Z' ⟶ W) (hm' : γ ≫ ε' = m') :
    (pullbackFiberCompIso' (D.obj f hf) ε γ m hm).inv ≫
        (pullbackFiberIso (D.iso hf hg ε ε' heq) γ).hom ≫
        (pullbackFiberCompIso' (D.obj g hg) ε' γ m' hm').hom =
      (D.iso hf hg m m' (by rw [← hm, ← hm', Category.assoc, Category.assoc, heq])).hom := by
  subst hm hm'
  exact D.iso_pullback hf hg ε ε' heq γ

/-- The pullback along `ε` of the morphism out of the object of `D` at `g` obtained from a
factorization `g = a ≫ f`: the gluing isomorphism at `(𝟙, a)`, the chosen cartesian lift of `a`
and a morphism `ζ` out of the object at `f`. It is the gluing isomorphism at `(ε, ε ≫ a)`,
followed by the chosen cartesian lift of `ε ≫ a` and by `ζ`. -/
lemma pullbackMap_comp_glue ⦃V W Z : 𝒞⦄ ⦃f : V ⟶ U⦄ (hf : R f) ⦃g : W ⟶ U⦄ (hg : R g)
    (a : W ⟶ V) (ha : a ≫ f = g) {t : 𝒳} (ζ : (D.obj f hf).1 ⟶ t) (ε : Z ⟶ W) :
    IsPreFibered.pullbackMap (D.obj g hg).2 ε ≫
        Fiber.fiberInclusion.map (pullbackFiberIdIso (D.obj g hg)).inv ≫
        Fiber.fiberInclusion.map
          (D.iso hg hf (𝟙 W) a (by rw [Category.id_comp, ha])).hom ≫
        IsPreFibered.pullbackMap (D.obj f hf).2 a ≫ ζ =
      Fiber.fiberInclusion.map
          (D.iso hg hf ε (ε ≫ a) (by rw [Category.assoc, ha])).hom ≫
        IsPreFibered.pullbackMap (D.obj f hf).2 (ε ≫ a) ≫ ζ := by
  have h₁ : IsPreFibered.pullbackMap (D.obj g hg).2 ε ≫
      Fiber.fiberInclusion.map (pullbackFiberIdIso (D.obj g hg)).inv =
        Fiber.fiberInclusion.map
            (pullbackFiberCompIso' (D.obj g hg) (𝟙 W) ε ε (Category.comp_id ε)).inv ≫
          IsPreFibered.pullbackMap (pullbackFiber p (D.obj g hg) (𝟙 W)).2 ε := by
    rw [← pullbackFiberHom_pullbackFiberIdIso_inv_eq, pullbackFiberHom_fac]
  rw [← D.iso_pullback' hg hf (𝟙 W) a (by rw [Category.id_comp, ha]) ε ε (Category.comp_id ε)
    (ε ≫ a) rfl]
  simp only [Functor.map_comp, Category.assoc, pullbackFiberIso_hom]
  rw [reassoc_of% h₁, ← pullbackFiberHom_fac_assoc, pullbackFiberCompIso'_hom_fac_assoc]

/-- Switching the factorization: if morphisms `ζ`, `ζ'` out of the objects of `D` at `f` and `f'`
are compatible with the gluing isomorphism at `(b, c)`, then reading the object at `g` through the
gluing isomorphism at `(ε, b)` or at `(ε, c)` gives the same morphism. -/
lemma iso_comp_pullbackMap_eq ⦃V V' W Z : 𝒞⦄ ⦃f : V ⟶ U⦄ (hf : R f) ⦃f' : V' ⟶ U⦄
    (hf' : R f') ⦃g : W ⟶ U⦄ (hg : R g) (ε : Z ⟶ W) (b : Z ⟶ V) (c : Z ⟶ V')
    (hb : ε ≫ g = b ≫ f) (hc : ε ≫ g = c ≫ f') {t : 𝒳} (ζ : (D.obj f hf).1 ⟶ t)
    (ζ' : (D.obj f' hf').1 ⟶ t)
    (h : Fiber.fiberInclusion.map (D.iso hf hf' b c (hb.symm.trans hc)).hom ≫
        IsPreFibered.pullbackMap (D.obj f' hf').2 c ≫ ζ' =
      IsPreFibered.pullbackMap (D.obj f hf).2 b ≫ ζ) :
    Fiber.fiberInclusion.map (D.iso hg hf ε b hb).hom ≫
        IsPreFibered.pullbackMap (D.obj f hf).2 b ≫ ζ =
      Fiber.fiberInclusion.map (D.iso hg hf' ε c hc).hom ≫
        IsPreFibered.pullbackMap (D.obj f' hf').2 c ≫ ζ' := by
  rw [← h, ← D.cocycle hg hf hf' ε b c hb (hb.symm.trans hc) hc, Functor.map_comp,
    Category.assoc]

end General

variable {U : 𝒞} {I : Type w} {V : I → 𝒞} {f : ∀ i, V i ⟶ U}
  (D : SieveDescentDatum p (Sieve.ofArrows V f))

/-- **A descent datum relative to the sieve generated by a family is effective from its
generators.** Cartesian morphisms `ζ i` from the objects of `D` at the members `f i` of the family
to an object `a` of the fibre over `U`, compatible with the gluing isomorphisms of `D` between two
members over an arbitrary pair `(b, b')` agreeing over `U`, make `D` effective.

For an arrow `g` of the sieve, factored as `a_g ≫ f i_g`, the cartesian morphism attached to `g`
is the gluing isomorphism from `g` to `f i_g` at `(𝟙, a_g)`, followed by the chosen cartesian lift
of `a_g` and by `ζ i_g`; its pullback along any `ε` is computed by
`CategoryTheory.Functor.SieveDescentDatum.pullbackMap_comp_glue`, and the compatibility follows
from the cocycle condition and the compatibility on generators. -/
theorem isEffective_of_generators_of_pairwise_compat (a : p.Fiber U)
    (ζ : ∀ i, (D.obj (f i) (Sieve.ofArrows_mk V f i)).1 ⟶ a.1)
    (hcart : ∀ i, p.IsCartesian (f i) (ζ i))
    (hglue : ∀ (i j : I) ⦃Z : 𝒞⦄ (b : Z ⟶ V i) (b' : Z ⟶ V j) (h : b ≫ f i = b' ≫ f j),
      Fiber.fiberInclusion.map
            (D.iso (Sieve.ofArrows_mk V f i) (Sieve.ofArrows_mk V f j) b b' h).hom ≫
          IsPreFibered.pullbackMap (D.obj (f j) (Sieve.ofArrows_mk V f j)).2 b' ≫ ζ j =
        IsPreFibered.pullbackMap (D.obj (f i) (Sieve.ofArrows_mk V f i)).2 b ≫ ζ i) :
    D.IsEffective := by
  have hfac : ∀ (W : 𝒞) (g : W ⟶ U), (Sieve.ofArrows V f).arrows g →
      ∃ (i : I) (c : W ⟶ V i), c ≫ f i = g :=
    fun _ _ hg => exists_factorization_of_ofArrows hg
  choose idx c hc using hfac
  refine ⟨a, fun W g hg =>
    Fiber.fiberInclusion.map (pullbackFiberIdIso (D.obj g hg)).inv ≫
      Fiber.fiberInclusion.map (D.iso hg (Sieve.ofArrows_mk V f (idx W g hg)) (𝟙 W)
        (c W g hg) (by rw [Category.id_comp, hc])).hom ≫
      IsPreFibered.pullbackMap (D.obj (f (idx W g hg)) (Sieve.ofArrows_mk V f _)).2
        (c W g hg) ≫ ζ (idx W g hg), fun W g hg => ?_, fun W W' Z g hg g' hg' ε ε' heq => ?_⟩
  · set e := (pullbackFiberIdIso (D.obj g hg)).symm ≪≫
      D.iso hg (Sieve.ofArrows_mk V f (idx W g hg)) (𝟙 W) (c W g hg)
        (by rw [Category.id_comp, hc]) with he
    have h₁ : p.IsHomLift (𝟙 W) (Fiber.fiberInclusion.mapIso e).hom := e.hom.2
    have h₂ : p.IsCartesian (c W g hg)
        (IsPreFibered.pullbackMap (D.obj (f (idx W g hg)) (Sieve.ofArrows_mk V f _)).2
          (c W g hg)) :=
      IsPreFibered.pullbackMap.IsCartesian _ _
    have h₃ := hcart (idx W g hg)
    have h : p.IsCartesian (c W g hg ≫ f (idx W g hg))
        ((Fiber.fiberInclusion.mapIso e).hom ≫
          IsPreFibered.pullbackMap (D.obj (f (idx W g hg)) (Sieve.ofArrows_mk V f _)).2
            (c W g hg) ≫ ζ (idx W g hg)) :=
      inferInstance
    rw [hc] at h
    simpa [he, Functor.map_comp, Category.assoc] using h
  · dsimp only
    rw [D.pullbackMap_comp_glue _ hg' (c W' g' hg') (hc W' g' hg'),
      D.pullbackMap_comp_glue _ hg (c W g hg) (hc W g hg), ← Category.assoc, ← Functor.map_comp,
      D.cocycle hg hg' (Sieve.ofArrows_mk V f (idx W' g' hg')) ε ε' (ε' ≫ c W' g' hg') heq
        (by rw [Category.assoc, hc]) (by rw [Category.assoc, hc, heq])]
    exact (D.iso_comp_pullbackMap_eq _ _ hg ε _ _ _ _ _ _
      (hglue (idx W g hg) (idx W' g' hg') _ _ _)).symm

end SieveDescentDatum

end Functor

end CategoryTheory
