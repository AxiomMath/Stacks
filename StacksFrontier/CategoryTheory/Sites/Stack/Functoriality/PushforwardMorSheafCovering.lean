module

public import StacksFrontier.CategoryTheory.Sites.Stack.Functoriality.PushforwardMorSheaf
public import Mathlib.CategoryTheory.Sites.Coverage
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import Mathlib.CategoryTheory.Limits.Constructions.Over.Connected

/-!
# The morphism presheaves of a pushforward, for a site given by coverings

Let `(𝒞, J₀)` be a site in the sense of Stacks 00VH: `J₀` is a precoverage of `𝒞` containing the
isomorphisms, stable under composition and under base change, and the fibre products
`Vⱼ ×_V T` of the members of a covering with an arbitrary morphism `T ⟶ V` exist. Let
`u : 𝒞 ⥤ 𝒟` be a continuous functor of sites in the sense of Stacks 00WU: `u` sends coverings to
coverings, and commutes with the fibre products `Vⱼ ×_V T` just described. No other fibre
product of `𝒞` is assumed to exist, and `u` is not assumed to commute with any other.

This file proves, in that setting, condition (2) of Stacks 026F for the pushforward `u^p𝒮 ⥤ 𝒞` of
a fibred category `p : 𝒮 ⥤ 𝒟` whose morphism presheaves are sheaves: the presheaves `Mor(x, y)`
on `𝒞/U` are sheaves for the topology generated by `J₀`.

As in `StacksFrontier.CategoryTheory.Sites.Stack.Functoriality.PushforwardMorSheaf`, the presheaf
`Mor(x, y)` on `𝒞/U` is the restriction along `Over.post u : 𝒞/U ⥤ 𝒟/u(U)` of the presheaf
`Mor(x, y)` on `𝒟/u(U)`. The sheaf condition for the localised topology on `𝒞/U` is checked on
the presieves of `𝒞/U` lying over a covering of `J₀`: those have fibre products, `Over.post u`
commutes with them, and their images generate covering sieves of `𝒟/u(U)`.

## Main results

* `CategoryTheory.StrictPullback.coverPreserving_toGrothendieck`, a functor sending coverings to
  coverings is cover-preserving for the topology the coverings generate;
* `CategoryTheory.StrictPullback.isSheaf_overPost_comp`, restriction along `Over.post u` sends
  sheaves to sheaves;
* `CategoryTheory.StrictPullback.isMorSheaf_structureFunctor_toGrothendieck`, condition (2) of
  Stacks 026F for the pushforward.
-/

@[expose] public section

namespace CategoryTheory

open Limits

universe w v₁ v₂ v₃ u₁ u₂ u₃

variable {𝒞 : Type u₁} [Category.{v₁} 𝒞] {𝒟 : Type u₂} [Category.{v₂} 𝒟]
  {𝒮 : Type u₃} [Category.{v₃} 𝒮]

namespace StrictPullback

variable (J₀ : Precoverage 𝒞) [J₀.HasIsos] [J₀.IsStableUnderComposition]
  [J₀.IsStableUnderBaseChange] [J₀.HasPullbacks]

/-- A functor sending the coverings of `J₀` to families generating covering sieves is
cover-preserving for the Grothendieck topology `J₀` generates: every covering sieve of that
topology contains a covering of `J₀`. -/
lemma coverPreserving_toGrothendieck (K : GrothendieckTopology 𝒟) (u : 𝒞 ⥤ 𝒟)
    (hcov : ∀ ⦃V : 𝒞⦄ ⦃R : Presieve V⦄, R ∈ J₀ V → Sieve.generate (R.map u) ∈ K (u.obj V)) :
    CoverPreserving J₀.toGrothendieck K u where
  cover_preserve {V S} hS := by
    obtain ⟨R, hR, hle⟩ := J₀.mem_toGrothendieck_iff_of_isStableUnderComposition.1 hS
    refine K.superset_covering ?_ (hcov hR)
    rw [Sieve.generate_le_iff]
    rintro _ _ ⟨hf⟩
    exact Sieve.image_mem_functorPushforward u S (hle _ _ hf)

/-- Every covering sieve of the localised topology on `𝒞/U` contains the presieve of the arrows
lying over a covering of `J₀`. -/
lemma exists_functorPullback_forget_le {U : 𝒞} {g : Over U} {S : Sieve g}
    (hS : S ∈ (J₀.toGrothendieck.over U) g) :
    ∃ P ∈ J₀ g.left, P.functorPullback (Over.forget U) ≤ S.arrows := by
  rw [GrothendieckTopology.mem_over_iff] at hS
  obtain ⟨P, hP, hle⟩ := J₀.mem_toGrothendieck_iff_of_isStableUnderComposition.1 hS
  refine ⟨P, hP, fun W k hk => ?_⟩
  have h := (Sieve.overEquiv_iff S k.left).1 (hle _ _ hk)
  have hk : k = (Over.homMk (𝟙 W.left) (by simp [Over.w k]) :
      W ⟶ Over.mk (k.left ≫ g.hom)) ≫ Over.homMk k.left := by
    ext
    simp
  rw [hk]
  exact S.downward_closed h _

omit [J₀.HasIsos] [J₀.IsStableUnderComposition] [J₀.IsStableUnderBaseChange] [J₀.HasPullbacks] in
/-- The arrows of `𝒞/U` lying over a covering of `J₀` generate a covering sieve of the localised
topology. -/
lemma generate_functorPullback_forget_mem {U : 𝒞} {g : Over U} {P : Presieve g.left}
    (hP : P ∈ J₀ g.left) :
    Sieve.generate (P.functorPullback (Over.forget U)) ∈ (J₀.toGrothendieck.over U) g := by
  rw [GrothendieckTopology.mem_over_iff]
  refine J₀.toGrothendieck.superset_covering ?_ (J₀.generate_mem_toGrothendieck hP)
  rw [Sieve.generate_le_iff]
  intro V f hf
  rw [Sieve.overEquiv_iff]
  exact Sieve.le_generate _ _ _ hf

omit [J₀.HasIsos] [J₀.IsStableUnderComposition] [J₀.IsStableUnderBaseChange] in
/-- Two arrows of `𝒞/U` lying over members of a covering of `J₀` have a fibre product: it is
computed in `𝒞`, where it exists because the site has the fibre products of its coverings. -/
lemma hasPairwisePullbacks_functorPullback_forget {U : 𝒞} {g : Over U} {P : Presieve g.left}
    (hP : P ∈ J₀ g.left) : (P.functorPullback (Over.forget U)).HasPairwisePullbacks where
  has_pullbacks {Y Z k₁} hk₁ {k₂} _ := by
    have : P.HasPullbacks k₂.left := J₀.hasPullbacks_of_mem k₂.left hP
    have h : HasLimit (cospan ((Over.forget U).map k₁) ((Over.forget U).map k₂)) :=
      Presieve.hasPullback k₂.left hk₁
    have : HasLimit (cospan k₁ k₂ ⋙ Over.forget U) :=
      @hasLimit_of_iso _ _ _ _ _ _ h (cospanCompIso (Over.forget U) k₁ k₂).symm
    exact hasLimit_of_created (cospan k₁ k₂) (Over.forget U)

omit [J₀.HasIsos] [J₀.IsStableUnderComposition] [J₀.IsStableUnderBaseChange] [J₀.HasPullbacks] in
/-- `Over.post u` commutes with the fibre products of two arrows of `𝒞/U` lying over members of a
covering of `J₀`, as soon as `u` commutes with the fibre products of the members of the
coverings of `J₀`. -/
lemma preservesPairwisePullbacks_functorPullback_forget (u : 𝒞 ⥤ 𝒟)
    (hpres : ∀ ⦃V : 𝒞⦄ ⦃R : Presieve V⦄, R ∈ J₀ V → ∀ ⦃W : 𝒞⦄ ⦃f : W ⟶ V⦄, R f →
      ∀ ⦃T : 𝒞⦄ (g : T ⟶ V), PreservesLimit (cospan f g) u)
    {U : 𝒞} {g : Over U} {P : Presieve g.left} (hP : P ∈ J₀ g.left) :
    (Over.post (X := U) u).PreservesPairwisePullbacks (P.functorPullback (Over.forget U)) where
  preservesLimit {Y Z k₁ k₂} hk₁ _ := by
    have : PreservesLimit (cospan ((Over.forget U).map k₁) ((Over.forget U).map k₂)) u :=
      hpres hP hk₁ k₂.left
    have : PreservesLimit (cospan k₁ k₂ ⋙ Over.forget U) u :=
      preservesLimit_of_iso_diagram u (cospanCompIso (Over.forget U) k₁ k₂).symm
    have : PreservesLimit (cospan k₁ k₂) (Over.post (X := U) u ⋙ Over.forget (u.obj U)) :=
      inferInstanceAs (PreservesLimit (cospan k₁ k₂) (Over.forget U ⋙ u))
    exact preservesLimit_of_reflects_of_preserves (Over.post (X := U) u) (Over.forget (u.obj U))

/-- Restriction along `Over.post u : 𝒞/U ⥤ 𝒟/u(U)` sends sheaves to sheaves, for a continuous
functor of sites in the sense of Stacks 00WU between the site `(𝒞, J₀)` and a site `(𝒟, K)`.

The sheaf condition for the localised topology on `𝒞/U` is checked on the presieves that have
fibre products, whose fibre products `Over.post u` preserves, and which generate covering sieves
(`Presieve.isSheaf_coverage`); every covering sieve contains one of them, lying over a covering
of `J₀`. On such a presieve the sheaf condition for the restriction is the sheaf condition for
its image (`Presieve.IsSheafFor.comp_iff_of_preservesPairwisePullbacks`), which generates a
covering sieve of `𝒟/u(U)`. -/
theorem isSheaf_overPost_comp (K : GrothendieckTopology 𝒟) (u : 𝒞 ⥤ 𝒟)
    (hcov : ∀ ⦃V : 𝒞⦄ ⦃R : Presieve V⦄, R ∈ J₀ V → Sieve.generate (R.map u) ∈ K (u.obj V))
    (hpres : ∀ ⦃V : 𝒞⦄ ⦃R : Presieve V⦄, R ∈ J₀ V → ∀ ⦃W : 𝒞⦄ ⦃f : W ⟶ V⦄, R f →
      ∀ ⦃T : 𝒞⦄ (g : T ⟶ V), PreservesLimit (cospan f g) u)
    (U : 𝒞) (G : (Over (u.obj U))ᵒᵖ ⥤ Type w) (hG : Presieve.IsSheaf (K.over (u.obj U)) G) :
    Presieve.IsSheaf (J₀.toGrothendieck.over U) ((Over.post (X := U) u).op ⋙ G) := by
  let Q : Coverage (Over U) :=
    { coverings := fun g => {R | R.HasPairwisePullbacks ∧
        (Over.post (X := U) u).PreservesPairwisePullbacks R ∧
        Sieve.generate R ∈ (J₀.toGrothendieck.over U) g}
      pullback := by
        intro g g' f R hR
        obtain ⟨P, hP, hle⟩ := exists_functorPullback_forget_le J₀
          ((J₀.toGrothendieck.over U).pullback_stable f hR.2.2)
        refine ⟨P.functorPullback (Over.forget U),
          ⟨hasPairwisePullbacks_functorPullback_forget J₀ hP,
            preservesPairwisePullbacks_functorPullback_forget J₀ u hpres hP,
            generate_functorPullback_forget_mem J₀ hP⟩, ?_⟩
        intro Z k hk
        obtain ⟨W, i, e, he, hie⟩ := hle _ _ hk
        exact ⟨W, i, e, he, hie⟩ }
  have hQ : Q.toGrothendieck = J₀.toGrothendieck.over U := by
    refine le_antisymm (((Coverage.gi (Over U)).gc Q _).2 fun g R hR => hR.2.2) ?_
    intro g S hS
    obtain ⟨P, hP, hle⟩ := exists_functorPullback_forget_le J₀ hS
    exact Q.mem_toGrothendieck_sieves_of_superset hle
      ⟨hasPairwisePullbacks_functorPullback_forget J₀ hP,
        preservesPairwisePullbacks_functorPullback_forget J₀ u hpres hP,
        generate_functorPullback_forget_mem J₀ hP⟩
  rw [← hQ, Presieve.isSheaf_coverage]
  intro g R hR
  obtain ⟨h₁, h₂, h₃⟩ := hR
  rw [Presieve.IsSheafFor.comp_iff_of_preservesPairwisePullbacks, Presieve.isSheafFor_iff_generate]
  refine hG.isSheafFor _ ((K.over (u.obj U)).superset_covering ?_
    (((coverPreserving_toGrothendieck J₀ K u hcov).overPost U).cover_preserve h₃))
  rintro Y h ⟨W, k, a, ⟨Z, i, e, he, rfl⟩, rfl⟩
  rw [Functor.map_comp, ← Category.assoc]
  exact Sieve.le_generate _ _ _ (Sieve.downward_closed _
    (Sieve.le_generate _ _ _ (Presieve.map_map (F := Over.post (X := U) u) he)) _)

/-- **Stacks 026F (2)** for the pushforward along a continuous functor of sites in the sense of
Stacks 00WU, the site `(𝒞, J₀)` being given by coverings as in Stacks 00VH: the presheaf
`Mor(x, y)` on `𝒞/U` is a sheaf as soon as the morphism presheaves of `p` are. -/
theorem isMorSheaf_structureFunctor_toGrothendieck (K : GrothendieckTopology 𝒟) (u : 𝒞 ⥤ 𝒟)
    (hcov : ∀ ⦃V : 𝒞⦄ ⦃R : Presieve V⦄, R ∈ J₀ V → Sieve.generate (R.map u) ∈ K (u.obj V))
    (hpres : ∀ ⦃V : 𝒞⦄ ⦃R : Presieve V⦄, R ∈ J₀ V → ∀ ⦃W : 𝒞⦄ ⦃f : W ⟶ V⦄, R f →
      ∀ ⦃T : 𝒞⦄ (g : T ⟶ V), PreservesLimit (cospan f g) u)
    (p : 𝒮 ⥤ 𝒟) [p.IsFibered]
    (hp : ∀ (Y : 𝒟) (a b : p.Fiber Y), Functor.IsMorSheaf p K Y a b)
    (U : 𝒞) (x y : (structureFunctor u p).Fiber U) :
    Functor.IsMorSheaf (structureFunctor u p) J₀.toGrothendieck U x y := by
  have h0 : Presieve.IsSheaf (K.over (u.obj U)) (Functor.morPresheaf p (fiberFib x) (fiberFib y)) :=
    (isSheaf_iff_isSheaf_of_type _ _).1 (hp (u.obj U) (fiberFib x) (fiberFib y))
  have h1 := isSheaf_overPost_comp J₀ K u hcov hpres U _ (Presieve.isSheaf_comp_uliftFunctor _ h0)
  exact (Presheaf.isSheaf_of_iso_iff (morPresheafFibIso x y)).2
    ((isSheaf_iff_isSheaf_of_type _ _).2 h1)

end StrictPullback

end CategoryTheory
