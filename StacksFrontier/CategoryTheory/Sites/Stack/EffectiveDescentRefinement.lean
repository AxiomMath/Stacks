module

public import StacksFrontier.CategoryTheory.Sites.Stackification.StageThreeEffectiveDescent
public import StacksFrontier.CategoryTheory.Sites.Stack.StackBridge.ToSieve

/-!
# To prove effectivity one may first refine the covering

Let `p : 𝒳 ⥤ 𝒞` be a fibred category over a site `(𝒞, J)` whose morphism presheaves are sheaves
— condition (2) of Stacks 02ZI, here in the form `CategoryTheory.Functor.IsMorSheaf`. Effectivity
of descent data is then *local on the base*: a descent datum relative to a covering sieve whose
restriction to a covering refinement is effective is itself effective. That is
`CategoryTheory.Functor.SieveDescentDatum.isEffective_of_restrict`.

This file shows that, to establish condition (3) of Stacks 026F, and condition (3) of Stacks 02ZI
for covering families indexed by an arbitrary type, it suffices to establish effectivity of descent
data relative to some covering refinement of each covering sieve.

## Main results

* `CategoryTheory.Functor.hasEffectiveDescent_of_refinements`: effective descent along every
  covering sieve, from effective descent along one covering refinement of each.
* `CategoryTheory.Functor.hasEffectiveDescent_of_familyRefinements`: the same with the refinements
  presented as covering families.
* `CategoryTheory.Functor.DescentDatum.isEffective_of_refinements`: a descent datum relative to a
  covering family indexed by an arbitrary type is effective as soon as every covering sieve admits
  a covering refinement along which descent is effective.
-/

@[expose] public noncomputable section

namespace CategoryTheory

open Limits

universe w v₁ v₂ u₁ u₂

/-- The sieve generated by a family of arrows is contained in a sieve `R` as soon as every member
of the family belongs to `R`. -/
theorem Sieve.ofArrows_le_of_forall_mem {𝒞 : Type u₁} [Category.{v₁} 𝒞] {U : 𝒞} {L : Type w}
    (V : L → 𝒞) (f : ∀ l, V l ⟶ U) {R : Sieve U} (h : ∀ l, R.arrows (f l)) :
    Sieve.ofArrows V f ≤ R := by
  rwa [Sieve.ofArrows, Sieve.generate_le_iff, Presieve.ofArrows_le_iff]

namespace Functor

variable {𝒞 : Type u₁} [Category.{v₁} 𝒞] {𝒳 : Type u₂} [Category.{v₂} 𝒳]
  {p : 𝒳 ⥤ 𝒞} [p.IsFibered] {J : GrothendieckTopology 𝒞}

/-- If the morphism presheaves of `p` are sheaves, and if every `J`-covering sieve `R` admits a
`J`-covering refinement `T ≤ R` relative to which *every* descent datum is effective, then every
descent datum relative to every covering sieve is effective — condition (3) of Stacks 026F. -/
theorem hasEffectiveDescent_of_refinements
    (hmor : ∀ (W : 𝒞) (x y : p.Fiber W), p.IsMorSheaf J W x y)
    (href : ∀ ⦃U : 𝒞⦄ (R : Sieve U), R ∈ J U → ∃ T : Sieve U, T ≤ R ∧ T ∈ J U ∧
      ∀ D : p.SieveDescentDatum T, D.IsEffective) :
    p.HasEffectiveDescent J := by
  intro U R hR D
  obtain ⟨T, hTle, hTmem, hTeff⟩ := href R hR
  exact D.isEffective_of_restrict hmor hTle hTmem (hTeff _)

/-- `CategoryTheory.Functor.hasEffectiveDescent_of_refinements` with the refinements presented as
covering families: if the morphism presheaves of `p` are sheaves, and if every `J`-covering sieve
`R` admits a covering family `{V' l ⟶ U}` with all members in `R` relative to which every descent
datum is effective, then every descent datum relative to every covering sieve is effective. -/
theorem hasEffectiveDescent_of_familyRefinements
    (hmor : ∀ (W : 𝒞) (x y : p.Fiber W), p.IsMorSheaf J W x y)
    (href : ∀ ⦃U : 𝒞⦄ (R : Sieve U), R ∈ J U →
      ∃ (L : Type w) (V' : L → 𝒞) (f' : ∀ l, V' l ⟶ U), (∀ l, R.arrows (f' l)) ∧
        Sieve.ofArrows V' f' ∈ J U ∧
        ∀ D : p.SieveDescentDatum (Sieve.ofArrows V' f'), D.IsEffective) :
    p.HasEffectiveDescent J := by
  refine hasEffectiveDescent_of_refinements hmor fun {U} R hR ↦ ?_
  obtain ⟨L, V', f', hle, hcov, heff⟩ := href R hR
  exact ⟨Sieve.ofArrows V' f', Sieve.ofArrows_le_of_forall_mem V' f' hle, hcov, heff⟩

variable {U : 𝒞} {I : Type w} {V : I → 𝒞} {f : ∀ i, V i ⟶ U}
  {Vij : I → I → 𝒞} {pr₁ : ∀ i j, Vij i j ⟶ V i} {pr₂ : ∀ i j, Vij i j ⟶ V j}
  {hVij : ∀ i j, IsPullback (pr₁ i j) (pr₂ i j) (f i) (f j)}
  {Vijk : I → I → I → 𝒞}
  {s₁₂ : ∀ i j k, Vijk i j k ⟶ Vij i j} {s₂₃ : ∀ i j k, Vijk i j k ⟶ Vij j k}
  {hVijk : ∀ i j k, IsPullback (s₁₂ i j k) (s₂₃ i j k) (pr₂ i j) (pr₁ j k)}
  {q₁ : ∀ i j k, Vijk i j k ⟶ V i} {q₂ : ∀ i j k, Vijk i j k ⟶ V j}
  {q₃ : ∀ i j k, Vijk i j k ⟶ V k}
  {hq₁ : ∀ i j k, q₁ i j k = s₁₂ i j k ≫ pr₁ i j}
  {hq₂ : ∀ i j k, q₂ i j k = s₁₂ i j k ≫ pr₂ i j}
  {hq₃ : ∀ i j k, q₃ i j k = s₂₃ i j k ≫ pr₂ j k}

/-- A descent datum relative to a covering family `{f i : V i ⟶ U}` with fibre-product double and
triple overlaps, indexed by an arbitrary type `I`, is effective as soon as the morphism presheaves
of `p` are sheaves and every covering sieve of `𝒞` admits a covering refinement relative to which
descent is effective. -/
theorem DescentDatum.isEffective_of_refinements
    (hmor : ∀ (W : 𝒞) (x y : p.Fiber W), p.IsMorSheaf J W x y)
    (href : ∀ ⦃W : 𝒞⦄ (R : Sieve W), R ∈ J W → ∃ T : Sieve W, T ≤ R ∧ T ∈ J W ∧
      ∀ D : p.SieveDescentDatum T, D.IsEffective)
    (D : DescentDatum p V f Vij pr₁ pr₂ hVij Vijk s₁₂ s₂₃ hVijk q₁ q₂ q₃ hq₁ hq₂ hq₃)
    (hf : Sieve.ofArrows V f ∈ J U) : D.IsEffective :=
  D.isEffective_of_hasEffectiveDescent (hasEffectiveDescent_of_refinements hmor href) hf

end Functor

end CategoryTheory
