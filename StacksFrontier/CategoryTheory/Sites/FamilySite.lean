-/

@[expose] public section

universe w v₁ v₂ u₁ u₂ u

open CategoryTheory CategoryTheory.Limits

namespace Stacks.Sites

/-- A *site* in the sense of Stacks 00VH: a category `C` with a set `Cov X` of indexed families of
morphisms with target `X`, for every object `X`, called the coverings, such that
1. for an isomorphism `f : Y ⟶ X` there is a covering of `X` indexed by a singleton set whose
   unique morphism is `f`;
2. if `{U_i → U}_{i ∈ I}` is a covering and `{V_{ij} → U_i}_{j ∈ J_i}` is a covering for each
   `i`, then `{V_{ij} → U}_{i ∈ I, j ∈ J_i}` is a covering;
3. if `{U_i → U}_{i ∈ I}` is a covering and `V → U` is a morphism, then the fibre products
   `U_i ×_U V` exist and, for some choice of them, `{U_i ×_U V → V}_{i ∈ I}` is a covering. -/
structure Site (C : Type u₁) [Category.{v₁} C] where
  /-- The coverings `{U_i → X}_{i ∈ I}` of the object `X`. -/
  Cov : (X : C) → Set (PreZeroHypercover.{w} X)
  /-- Axiom (1): an isomorphism `f` forms a covering `{f}` indexed by a singleton set. -/
  isIso_mem : ∀ ⦃X Y : C⦄ (f : Y ⟶ X), IsIso f →
    ∃ 𝒰 ∈ Cov X, Subsingleton 𝒰.I₀ ∧ 𝒰.presieve₀ = Presieve.singleton f
  /-- Axiom (2): the composite of coverings is a covering. -/
  bind_mem : ∀ ⦃X : C⦄ (𝒰 : PreZeroHypercover.{w} X)
    (𝒱 : (i : 𝒰.I₀) → PreZeroHypercover.{w} (𝒰.X i)),
    𝒰 ∈ Cov X → (∀ i, 𝒱 i ∈ Cov (𝒰.X i)) → 𝒰.bind 𝒱 ∈ Cov X
  /-- Axiom (3): for a covering `{U_i → X}` and `g : V ⟶ X` the fibre products `U_i ×_X V`
  exist, and for some choice of them the projections `U_i ×_X V → V` form a covering of `V`. -/
  pullback_mem : ∀ ⦃X : C⦄ (𝒰 : PreZeroHypercover.{w} X), 𝒰 ∈ Cov X → ∀ ⦃V : C⦄ (g : V ⟶ X),
    ∃ (P : 𝒰.I₀ → C) (p : (i : 𝒰.I₀) → P i ⟶ V) (q : (i : 𝒰.I₀) → P i ⟶ 𝒰.X i),
      (∀ i, IsPullback (q i) (p i) (𝒰.f i) g) ∧ ⟨𝒰.I₀, P, p⟩ ∈ Cov V

namespace Site

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]

/-- In a site, a member `U_i → X` of a covering has a fibre product with every `g : V ⟶ X`
(axiom (3) of Stacks 00VH). -/
theorem hasPullback (S : Site.{w} C) {X : C} {𝒰 : PreZeroHypercover.{w} X} (h𝒰 : 𝒰 ∈ S.Cov X)
    {V : C} (g : V ⟶ X) (i : 𝒰.I₀) : HasPullback g (𝒰.f i) := by
  obtain ⟨P, p, q, hpb, -⟩ := S.pullback_mem 𝒰 h𝒰 g
  exact (hpb i).flip.hasPullback

/-- A functor `u : C ⥤ D` between sites is *continuous* (Stacks 00WV) if for every covering
`{V_i → V}_{i ∈ I}` of `C`
1. the family `{u(V_i) → u(V)}_{i ∈ I}` is a covering of `D`, and
2. for every morphism `T → V` of `C` the morphism `u(T ×_V V_i) → u(T) ×_{u(V)} u(V_i)` is an
   isomorphism.

The fibre products in clause (2) exist by axiom (3) of `C`, resp. of `D` applied to the covering
of clause (1). -/
@[stacks 00WV]
structure IsContinuous (SC : Site.{w} C) (SD : Site.{w} D) (u : C ⥤ D) : Prop where
  /-- Clause (1): the image `{u(V_i) → u(V)}_{i ∈ I}` of a covering is a covering. -/
  map_mem : ∀ ⦃V : C⦄ (𝒱 : PreZeroHypercover.{w} V), 𝒱 ∈ SC.Cov V → 𝒱.map u ∈ SD.Cov (u.obj V)
  /-- Clause (2): `u(T ×_V V_i) → u(T) ×_{u(V)} u(V_i)` is an isomorphism. -/
  isIso_pullbackComparison : ∀ ⦃V : C⦄ (𝒱 : PreZeroHypercover.{w} V) (h𝒱 : 𝒱 ∈ SC.Cov V)
    ⦃T : C⦄ (g : T ⟶ V) (i : 𝒱.I₀),
    haveI := SC.hasPullback h𝒱 g i
    haveI : HasPullback (u.map g) (u.map (𝒱.f i)) :=
      SD.hasPullback (map_mem 𝒱 h𝒱) (u.map g) i
    IsIso (pullbackComparison u g (𝒱.f i))

/-- The coverings of a site, as a `CategoryTheory.Coverage`: the covering presieves of `X` are the
sets of arrows of the coverings of `X`. Its pullback condition is axiom (3) of Stacks 00VH. -/
def toCoverage (S : Site.{w} C) : Coverage C where
  coverings X := {R | ∃ 𝒰 ∈ S.Cov X, 𝒰.presieve₀ = R}
  pullback := by
    rintro X V g _ ⟨𝒰, h𝒰, rfl⟩
    obtain ⟨P, p, q, hpb, hmem⟩ := S.pullback_mem 𝒰 h𝒰 g
    refine ⟨_, ⟨_, hmem, rfl⟩, ?_⟩
    rintro Z _ ⟨i⟩
    exact ⟨_, q i, 𝒰.f i, Presieve.ofArrows.mk i, (hpb i).w⟩

/-- The Grothendieck topology generated by the coverings of a site. Its sheaves are exactly the
presheaves satisfying the sheaf condition for every covering (`Presieve.isSheaf_coverage`), so
`Sheaf S.topology A` is the category of sheaves on the site. -/
def topology (S : Site.{w} C) : GrothendieckTopology C :=
  S.toCoverage.toGrothendieck

/-- A presheaf of sets is a sheaf for `S.topology` exactly when it satisfies the sheaf condition
for every covering of the site. -/
theorem isSheaf_topology_iff (S : Site.{w} C) (P : Cᵒᵖ ⥤ Type u) :
    Presieve.IsSheaf S.topology P ↔
      ∀ ⦃X : C⦄ (𝒰 : PreZeroHypercover.{w} X), 𝒰 ∈ S.Cov X → Presieve.IsSheafFor P 𝒰.presieve₀ := by
  refine (Presieve.isSheaf_coverage S.toCoverage P).trans ⟨fun h X 𝒰 h𝒰 => h _ ⟨𝒰, h𝒰, rfl⟩, ?_⟩
  rintro h X _ ⟨𝒰, h𝒰, rfl⟩
  exact h 𝒰 h𝒰

end Site

namespace Site

variable {C : Type u} [SmallCategory C] {D : Type u} [SmallCategory D]

/-- A *morphism of sites* `f : D → C` (Stacks 00X1) is given by a continuous functor
`u : C ⥤ D` (Stacks 00WV) such that the functor `u_s : Sh(C) ⥤ Sh(D)`, `G ↦ (u_p G)^#`, on
sheaves of sets is exact, i.e. preserves finite limits and finite colimits. Here `u_s` is
`Functor.sheafPullbackConstruction.sheafPullback`, the restriction to sheaves of the left Kan
extension along `u.op` followed by sheafification. -/
@[stacks 00X1]
structure IsMorphismOfSites (SC : Site.{w} C) (SD : Site.{w} D) (u : C ⥤ D) : Prop where
  /-- The functor `u` is continuous. -/
  isContinuous : IsContinuous SC SD u
  /-- `u_s` is left exact. -/
  preservesFiniteLimits :
    PreservesFiniteLimits
      (Functor.sheafPullbackConstruction.sheafPullback u (Type u) SC.topology SD.topology)
  /-- `u_s` is right exact. -/
  preservesFiniteColimits :
    PreservesFiniteColimits
      (Functor.sheafPullbackConstruction.sheafPullback u (Type u) SC.topology SD.topology)

end Site

end Stacks.Sites
