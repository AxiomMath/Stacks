module

public import StacksFrontier.CategoryTheory.Sites.DerivedTensorModuleSheaf.KoszulProducts
public import StacksFrontier.CategoryTheory.Sites.DerivedTensorModuleSheaf.AdicReductionSections
public import StacksFrontier.CategoryTheory.Sites.DerivedTensorModuleSheaf.ReductionTower
public import StacksFrontier.RingTheory.Module.AdicSystem.RowReductionProIso
public import StacksFrontier.Algebra.Homology.KoszulConeTensorHomology

/-!
# Reductions of the Koszul complex of sheaves are pro-constant

Let `(C, J)` be a site, `Λ` a Noetherian ring, `I ⊆ Λ` an ideal generated by `f₁, …, f_r` and
`Kos(f)` the Koszul complex of sheaves of `Λ`-modules. The maps
`Kos(f) → Kos(f) ⊗_Λ^L \underline{Λ/Iⁿ}` are an isomorphism of pro-objects of `D(C, Λ)` from the
constant system, and so are their tensor products with any `K ∈ D(C, Λ)`:
`K ⊗^L Kos(f) → (K ⊗^L \underline{Λ/Iⁿ}) ⊗^L Kos(f)`.

## Main definitions

* `Stacks.ModuleSheaf.constantComplexTensorSingleIso`: `M ↦ \underline{F} ⊗^L \underline{M}[0]`
  is the constant complex on `F ⊗_Λ M`, for `F` with left K-flat constant complex.

## Main results

* `Stacks.ModuleSheaf.hasEventualInverses_tensorRight_derivedReductionMap`: the pro-isomorphism
  `K ⊗^L Kos(f) → (K ⊗^L \underline{Λ/Iⁿ}) ⊗^L Kos(f)`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits MonoidalCategory CochainComplex.KFlatBifunctor
open NoetherianAdicCompletion

universe t w v u

namespace Stacks.ModuleSheaf

open AlgebraicGeometry.ProEtale (adicQuotientCone)

attribute [local instance] Sheaf.monoidalCategory Sheaf.symmetricCategory monoidalClosed
  CochainComplex.braidedCategory derivedMonoidal

/-- The component of the comparison from a constant system to a system, after applying `Ψ`. -/
private theorem constComp_inv_whiskerRight_app {D E : Type*} [Category D] [Category E] {X : D}
    {G : ℕᵒᵖ ⥤ D} (φ : (Functor.const ℕᵒᵖ).obj X ⟶ G) (Ψ : D ⥤ E) (n : ℕᵒᵖ) :
    ((Functor.constComp ℕᵒᵖ X Ψ).inv ≫ Functor.whiskerRight φ Ψ).app n = Ψ.map (φ.app n) := by
  simp

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  {Λ : Type w} [CommRing Λ] [UnivLE.{max u v, w}]

variable (J) in
/-- **The Koszul complex of sheaves is the constant complex on the iterated cone over `Λ`.** -/
theorem nonempty_mapHomologicalComplex_koszulTensor_iso_koszulComplex {r : ℕ} (f : Fin r → Λ) :
    Nonempty (((constantSheaf J (ModuleCat.{w} Λ)).mapHomologicalComplex (ComplexShape.up ℤ)).obj
        (Stacks.KoszulCone.koszulTensor r f (𝟙_ (CochainComplex (ModuleCat.{w} Λ) ℤ))) ≅
      koszulComplex J Λ f) := by
  let c := constantSheaf J (ModuleCat.{w} Λ)
  obtain ⟨e₁⟩ := Stacks.KoszulCone.nonempty_mapHomologicalComplex_koszulTensor_iso c id
    (fun a Y ↦ by rw [constantSheaf_map_smul, CategoryTheory.Functor.map_id]; rfl) r f
    (𝟙_ (CochainComplex (ModuleCat.{w} Λ) ℤ))
  let e₂ : (c.mapHomologicalComplex (ComplexShape.up ℤ)).obj
        (𝟙_ (CochainComplex (ModuleCat.{w} Λ) ℤ)) ≅
      𝟙_ (CochainComplex (Sheaf J (ModuleCat.{w} Λ)) ℤ) :=
    (HomologicalComplex.singleMapHomologicalComplex c (ComplexShape.up ℤ) 0).app
      (𝟙_ (ModuleCat.{w} Λ))
  obtain ⟨e₃⟩ := Stacks.KoszulCone.nonempty_koszulTensor_iso_of_iso e₂ r f
  exact ⟨e₁ ≪≫ e₃⟩

variable [HasDerivedCategory.{t} (Sheaf J (ModuleCat.{w} Λ))]

/-- **Tensoring a constant sheaf in degree zero with a constant complex.** For a complex `F` of
`Λ`-modules whose constant complex is left K-flat, `M ↦ \underline{F} ⊗^L \underline{M}[0]` is
the constant complex on the termwise tensor product `F ⊗_Λ M`, naturally in `M`. -/
def constantComplexTensorSingleIso (F : CochainComplex (ModuleCat.{w} Λ) ℤ)
    (hF : KFlatLeft (curriedTensor (Sheaf J (ModuleCat.{w} Λ)))
      (((constantSheaf J (ModuleCat.{w} Λ)).mapHomologicalComplex (ComplexShape.up ℤ)).obj F)) :
    constantSheaf J (ModuleCat.{w} Λ) ⋙ DerivedCategory.singleFunctor _ 0 ⋙
        MonoidalCategory.tensorLeft (DerivedCategory.Q.obj
          (((constantSheaf J (ModuleCat.{w} Λ)).mapHomologicalComplex (ComplexShape.up ℤ)).obj F)) ≅
      rowFunctor (curriedTensor (ModuleCat.{w} Λ)) F ⋙ DerivedCategory.Q ⋙
        (constantSheaf J (ModuleCat.{w} Λ)).mapDerivedCategory :=
  Functor.isoWhiskerLeft _ (Functor.isoWhiskerRight (DerivedCategory.singleFunctorIsoCompQ _ 0) _ ≪≫
      derivedTensorSingleIso hF) ≪≫
    Functor.isoWhiskerRight (mapRowFunctorIso (curriedTensor (ModuleCat.{w} Λ))
      (curriedTensor (Sheaf J (ModuleCat.{w} Λ))) (constantSheafTensorIso (J := J)) F).symm
      DerivedCategory.Q ≪≫
    Functor.isoWhiskerLeft (rowFunctor (curriedTensor (ModuleCat.{w} Λ)) F)
      (constantSheaf J (ModuleCat.{w} Λ)).mapDerivedCategoryFactors.symm

omit [UnivLE.{max u v, w}] [HasDerivedCategory.{t} (Sheaf J (ModuleCat.{w} Λ))] in
/-- Pro-isomorphisms induced by the quotient maps `Λ → Λ/Iⁿ` are invariant under natural
isomorphisms of the functor applied to them. -/
theorem hasEventualInverses_adicQuotientCone_of_iso {D : Type*} [Category D]
    {Ψ Ψ' : ModuleCat.{w} Λ ⥤ D} (e : Ψ ≅ Ψ') (I : Ideal Λ)
    (h : HasEventualInverses ((Functor.constComp ℕᵒᵖ _ Ψ').inv ≫
      Functor.whiskerRight (adicQuotientCone Λ I (ModuleCat.of Λ Λ)) Ψ')) :
    HasEventualInverses ((Functor.constComp ℕᵒᵖ _ Ψ).inv ≫
      Functor.whiskerRight (adicQuotientCone Λ I (ModuleCat.of Λ Λ)) Ψ) := by
  intro n
  obtain ⟨m, hnm, s, hs₁, hs₂⟩ := h n
  refine ⟨m, hnm, e.hom.app _ ≫ s ≫ e.inv.app _, ?_, ?_⟩
  · simp only [constComp_inv_whiskerRight_app, Functor.const_obj_map] at hs₁ ⊢
    rw [e.hom.naturality_assoc, reassoc_of% hs₁]
    simp
  · simp only [constComp_inv_whiskerRight_app, Functor.comp_map] at hs₂ ⊢
    rw [Category.assoc, Category.assoc, ← e.inv.naturality, reassoc_of% hs₂]
    simp

omit [UnivLE.{max u v, w}] in
/-- The unit complex of modules is finite in each degree. -/
theorem finite_X_tensorUnit_cochainComplex (i : ℤ) :
    Module.Finite Λ ((𝟙_ (CochainComplex (ModuleCat.{w} Λ) ℤ)).X i) := by
  rcases eq_or_ne i 0 with rfl | hi
  · exact Module.Finite.equiv (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0
      (ModuleCat.of Λ Λ)).toLinearEquiv.symm
  · have : Subsingleton ((𝟙_ (CochainComplex (ModuleCat.{w} Λ) ℤ)).X i) :=
      ModuleCat.subsingleton_of_isZero
        (HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 (ModuleCat.of Λ Λ) i hi)
    exact Module.Finite.of_surjective (0 : Λ →ₗ[Λ] _) fun y ↦ ⟨0, Subsingleton.elim _ _⟩

/-- **The reductions of a constant complex with `I`-power torsion cohomology are pro-constant**
in `D(C, Λ)`: for a bounded complex `F` of finite `Λ`-modules over a Noetherian ring whose
cohomology is killed by `Iᵗ`, the maps `\underline{F ⊗_Λ Λ} → \underline{F ⊗_Λ Λ/Iⁿ}` are an
isomorphism of pro-objects from the constant system. -/
theorem hasEventualInverses_adicQuotientCone_constantComplex [IsNoetherianRing Λ] (I : Ideal Λ)
    (F : CochainComplex (ModuleCat.{w} Λ) ℤ) (hF : ∀ i, Module.Finite Λ (F.X i)) (a b : ℤ)
    [F.IsStrictlyGE a] [F.IsStrictlyLE b] (t : ℕ)
    (ht : ∀ i, I ^ t ≤ Module.annihilator Λ (F.homology i)) :
    HasEventualInverses ((Functor.constComp ℕᵒᵖ _ (rowFunctor (curriedTensor (ModuleCat.{w} Λ)) F ⋙
        DerivedCategory.Q ⋙ (constantSheaf J (ModuleCat.{w} Λ)).mapDerivedCategory)).inv ≫
      Functor.whiskerRight (adicQuotientCone Λ I (ModuleCat.of Λ Λ))
        (rowFunctor (curriedTensor (ModuleCat.{w} Λ)) F ⋙ DerivedCategory.Q ⋙
          (constantSheaf J (ModuleCat.{w} Λ)).mapDerivedCategory)) := by
  let L := (constantSheaf J (ModuleCat.{w} Λ)).mapDerivedCategory
  intro n
  obtain ⟨m, hnm, s, hs₁, hs₂⟩ :=
    Stacks.PseudoCoherent.AdicCompletion.exists_proInverse_rowComplexMapRight_mkQ I F hF a b t ht n
  refine ⟨m, hnm, L.map s, ?_, ?_⟩
  · simp only [constComp_inv_whiskerRight_app, Functor.comp_map, Functor.const_obj_map]
    exact (L.map_comp _ _).symm.trans ((congrArg L.map hs₁).trans (L.map_id _))
  · simp only [constComp_inv_whiskerRight_app, Functor.comp_map]
    exact (L.map_comp _ _).symm.trans (congrArg L.map hs₂)

omit [HasDerivedCategory.{t} (Sheaf J (ModuleCat.{w} Λ))] in
variable (J) in
/-- The constant complex on the iterated cone over `Λ` is left K-flat. -/
theorem kFlatLeft_mapHomologicalComplex_koszulTensor {r : ℕ} (f : Fin r → Λ) :
    KFlatLeft (curriedTensor (Sheaf J (ModuleCat.{w} Λ)))
      (((constantSheaf J (ModuleCat.{w} Λ)).mapHomologicalComplex (ComplexShape.up ℤ)).obj
        (Stacks.KoszulCone.koszulTensor r f (𝟙_ (CochainComplex (ModuleCat.{w} Λ) ℤ)))) := by
  have h0 : KFlatLeft (curriedTensor (Sheaf J (ModuleCat.{w} Λ))) (koszulComplex J Λ f) :=
    CochainComplex.KFlatMonoidal.kFlatLeft_of_kFlat _ (kFlat_koszulComplex J Λ f)
  obtain ⟨χ⟩ := nonempty_mapHomologicalComplex_koszulTensor_iso_koszulComplex J f
  exact fun G hG n ↦ HomologicalComplex.ExactAt.of_iso (h0 G hG n)
    ((((curriedTensor (Sheaf J (ModuleCat.{w} Λ))).map₂HomologicalComplex (ComplexShape.up ℤ)
      (ComplexShape.up ℤ) (ComplexShape.up ℤ)).mapIso χ.symm).app G)

/-- **The reductions of the Koszul complex of sheaves are pro-constant.** For `Λ` Noetherian
and `Iᵗ ⊆ (f₁, …, f_r)`, the maps `\underline{Λ}[0] ⊗^L Kos(f) → \underline{Λ/Iⁿ}[0] ⊗^L Kos(f)`
induced by the quotient maps are an isomorphism of pro-objects of `D(C, Λ)` from the constant
system. -/
theorem hasEventualInverses_adicQuotientCone_tensorRight_koszulComplex [IsNoetherianRing Λ]
    (I : Ideal Λ) {r : ℕ} (f : Fin r → Λ) (t : ℕ) (ht : I ^ t ≤ Ideal.span (Set.range f)) :
    HasEventualInverses ((Functor.constComp ℕᵒᵖ _ (constantSheaf J (ModuleCat.{w} Λ) ⋙
        DerivedCategory.singleFunctor _ 0 ⋙
          MonoidalCategory.tensorRight (DerivedCategory.Q.obj (koszulComplex J Λ f)))).inv ≫
      Functor.whiskerRight (adicQuotientCone Λ I (ModuleCat.of Λ Λ))
        (constantSheaf J (ModuleCat.{w} Λ) ⋙ DerivedCategory.singleFunctor _ 0 ⋙
          MonoidalCategory.tensorRight (DerivedCategory.Q.obj (koszulComplex J Λ f)))) := by
  let _ := derivedSymmetric (C := C) J Λ
  let c := constantSheaf J (ModuleCat.{w} Λ)
  let P := Stacks.KoszulCone.koszulTensor r f (𝟙_ (CochainComplex (ModuleCat.{w} Λ) ℤ))
  obtain ⟨χ⟩ := nonempty_mapHomologicalComplex_koszulTensor_iso_koszulComplex J f
  have hP : KFlatLeft (curriedTensor (Sheaf J (ModuleCat.{w} Λ)))
      ((c.mapHomologicalComplex (ComplexShape.up ℤ)).obj P) :=
    kFlatLeft_mapHomologicalComplex_koszulTensor J f
  let Y := DerivedCategory.Q.obj (koszulComplex J Λ f)
  let Y' := DerivedCategory.Q.obj ((c.mapHomologicalComplex (ComplexShape.up ℤ)).obj P)
  let eY : Y ≅ Y' := DerivedCategory.Q.mapIso χ.symm
  let eβ : MonoidalCategory.tensorRight Y ≅ MonoidalCategory.tensorLeft Y' := NatIso.ofComponents
    (fun X ↦ β_ X Y ≪≫ whiskerRightIso eY X) (fun {X X'} g ↦ by
      change g ▷ Y ≫ (β_ X' Y).hom ≫ eY.hom ▷ X' = ((β_ X Y).hom ≫ eY.hom ▷ X) ≫ Y' ◁ g
      rw [BraidedCategory.braiding_naturality_left_assoc, Category.assoc, whisker_exchange])
  let e : c ⋙ DerivedCategory.singleFunctor _ 0 ⋙ MonoidalCategory.tensorRight Y ≅
      rowFunctor (curriedTensor (ModuleCat.{w} Λ)) P ⋙ DerivedCategory.Q ⋙ c.mapDerivedCategory :=
    Functor.isoWhiskerLeft (c ⋙ DerivedCategory.singleFunctor _ 0) eβ ≪≫
      constantComplexTensorSingleIso P hP
  have : (𝟙_ (CochainComplex (ModuleCat.{w} Λ) ℤ)).IsStrictlyGE 0 :=
    inferInstanceAs (CochainComplex.IsStrictlyGE
      ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (ModuleCat.of Λ Λ)) 0)
  have : (𝟙_ (CochainComplex (ModuleCat.{w} Λ) ℤ)).IsStrictlyLE 0 :=
    inferInstanceAs (CochainComplex.IsStrictlyLE
      ((HomologicalComplex.single _ (ComplexShape.up ℤ) 0).obj (ModuleCat.of Λ Λ)) 0)
  have := Stacks.KoszulCone.isStrictlyGE_koszulTensor
    (𝟙_ (CochainComplex (ModuleCat.{w} Λ) ℤ)) 0 r f
  have := Stacks.KoszulCone.isStrictlyLE_koszulTensor
    (𝟙_ (CochainComplex (ModuleCat.{w} Λ) ℤ)) 0 r f
  exact hasEventualInverses_adicQuotientCone_of_iso e I
    (hasEventualInverses_adicQuotientCone_constantComplex I P
      (Stacks.KoszulCone.finite_X_koszulTensor _ finite_X_tensorUnit_cochainComplex r f)
      (0 - r) 0 t (fun i ↦ ht.trans
        (Stacks.KoszulCone.span_le_annihilator_homology_koszulTensor f i)))

variable (J Λ) in
/-- The component of `unitToQuotientPowerTower J Λ I` at `n` is the unit isomorphism
`derivedTensorUnitIso J Λ` followed by the image in degree `0` of the constant sheaf of the
reduction `Λ → Λ/Iⁿ`. -/
theorem unitToQuotientPowerTower_app (I : Ideal Λ) (n : ℕᵒᵖ) :
    (unitToQuotientPowerTower J Λ I).app n = (derivedTensorUnitIso J Λ).hom ≫
      (DerivedCategory.singleFunctor _ 0).map ((constantSheaf J (ModuleCat.{w} Λ)).map
        ((adicQuotientCone Λ I (ModuleCat.of Λ Λ)).app n)) := by
  simp [unitToQuotientPowerTower, constantAdicQuotientCone, adicQuotientCone]

/-- **Reduction commutes with tensoring by the Koszul complex up to pro-isomorphism.** For `Λ`
Noetherian, `Iᵗ ⊆ (f₁, …, f_r)` and `K ∈ D(C, Λ)`, the maps
`K ⊗^L Kos(f) → (K ⊗^L \underline{Λ/Iⁿ}) ⊗^L Kos(f)` induced by the reductions `K → K ⊗^L
\underline{Λ/Iⁿ}` are an isomorphism of pro-objects from the constant system. -/
theorem hasEventualInverses_tensorRight_derivedReductionMap [IsNoetherianRing Λ] (I : Ideal Λ)
    {r : ℕ} (f : Fin r → Λ) (t : ℕ) (ht : I ^ t ≤ Ideal.span (Set.range f))
    (K : DerivedCategory (Sheaf J (ModuleCat.{w} Λ))) :
    HasEventualInverses ((Functor.constComp ℕᵒᵖ K
        (MonoidalCategory.tensorRight (DerivedCategory.Q.obj (koszulComplex J Λ f)))).inv ≫
      Functor.whiskerRight (derivedReductionMap J Λ I K)
        (MonoidalCategory.tensorRight (DerivedCategory.Q.obj (koszulComplex J Λ f)))) := by
  let Y := DerivedCategory.Q.obj (koszulComplex J Λ f)
  have hΨ := hasEventualInverses_adicQuotientCone_tensorRight_koszulComplex (J := J) I f t ht
  let ε := unitToQuotientPowerTower J Λ I
  have hε : ∀ n : ℕᵒᵖ, ε.app n ▷ Y = (derivedTensorUnitIso J Λ).hom ▷ Y ≫
      ((Functor.constComp ℕᵒᵖ _ (constantSheaf J (ModuleCat.{w} Λ) ⋙
        DerivedCategory.singleFunctor _ 0 ⋙ MonoidalCategory.tensorRight Y)).inv ≫
      Functor.whiskerRight (adicQuotientCone Λ I (ModuleCat.of Λ Λ))
        (constantSheaf J (ModuleCat.{w} Λ) ⋙ DerivedCategory.singleFunctor _ 0 ⋙
          MonoidalCategory.tensorRight Y)).app n := fun n ↦ by
    simp only [ε, unitToQuotientPowerTower_app, constComp_inv_whiskerRight_app, comp_whiskerRight]
    rfl
  have hU : ∀ n : ℕ, ∃ (m : ℕ) (hnm : n ≤ m) (s : (ε.app ⟨m⟩ ▷ Y |> fun _ ↦
      ((quotientPowerTower J Λ I).obj ⟨m⟩ ⊗ Y)) ⟶ 𝟙_ _ ⊗ Y),
      ε.app ⟨m⟩ ▷ Y ≫ s = 𝟙 _ ∧ s ≫ ε.app ⟨n⟩ ▷ Y =
        (quotientPowerTower J Λ I).map (homOfLE hnm).op ▷ Y := fun n ↦ by
    obtain ⟨m, hnm, s, hs₁, hs₂⟩ := hΨ n
    refine ⟨m, hnm, s ≫ (derivedTensorUnitIso J Λ).inv ▷ Y, ?_, ?_⟩
    · rw [hε ⟨m⟩, Category.assoc, reassoc_of% hs₁]
      simp
    · rw [hε ⟨n⟩, Category.assoc, ← comp_whiskerRight_assoc, Iso.inv_hom_id, id_whiskerRight,
        Category.id_comp, hs₂]
      rfl
  intro n
  obtain ⟨m, hnm, s, hs₁, hs₂⟩ := hU n
  have hφ : ∀ p : ℕ, ((Functor.constComp ℕᵒᵖ K (MonoidalCategory.tensorRight Y)).inv ≫
      Functor.whiskerRight (derivedReductionMap J Λ I K) (MonoidalCategory.tensorRight Y)).app ⟨p⟩ =
        (ρ_ K).inv ▷ Y ≫ (α_ K (𝟙_ _) Y).hom ≫ K ◁ (ε.app ⟨p⟩ ▷ Y) ≫
          (α_ K ((quotientPowerTower J Λ I).obj ⟨p⟩) Y).inv := fun p ↦ by
    simp only [constComp_inv_whiskerRight_app, derivedReductionMap_app]
    change ((ρ_ K).inv ≫ K ◁ ε.app ⟨p⟩) ▷ Y = _
    rw [comp_whiskerRight, associator_inv_naturality_middle]
    simp only [Functor.const_obj_obj, Iso.hom_inv_id_assoc]
  refine ⟨m, hnm, (α_ K _ Y).hom ≫ K ◁ s ≫ (α_ K (𝟙_ _) Y).inv ≫ (ρ_ K).hom ▷ Y, ?_, ?_⟩
  · rw [hφ]
    simp only [Category.assoc, Functor.const_obj_obj, Functor.const_obj_map,
      Iso.inv_hom_id_assoc, ← whiskerLeft_comp_assoc, hs₁, whiskerLeft_id, Category.id_comp,
      Iso.hom_inv_id_assoc, ← comp_whiskerRight, Iso.inv_hom_id, id_whiskerRight]
    rfl
  · rw [hφ]
    simp only [Category.assoc, Functor.const_obj_obj, Iso.inv_hom_id_assoc,
      ← comp_whiskerRight_assoc, Iso.hom_inv_id, id_whiskerRight, Category.id_comp,
      ← whiskerLeft_comp_assoc, hs₂]
    change _ = (K ◁ (quotientPowerTower J Λ I).map (homOfLE hnm).op) ▷ Y
    rw [associator_inv_naturality_middle, Iso.hom_inv_id_assoc]

end Stacks.ModuleSheaf
