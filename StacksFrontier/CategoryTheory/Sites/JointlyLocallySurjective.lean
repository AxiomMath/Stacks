module

public import Mathlib.CategoryTheory.Sites.LocallySurjective
public import Mathlib.CategoryTheory.Sites.Subsheaf
import StacksCore.Tactic.EgaSgaAttribute

/-!
# A jointly locally surjective family of morphisms of sheaves

For a family `c i : G i ⟶ F` of morphisms of sheaves of types, local surjectivity of
`Sigma.desc c` implies that every section of `F` is locally in the image of one of the `c i`.

## Main definitions

* `CategoryTheory.Sheaf.jointRange`: the subfunctor of the target generated by the images of a
  family of morphisms of sheaves.

## Main results

* `CategoryTheory.Sheaf.mem_jointRange_obj_iff`: a section lies in the joint range exactly when
  it is in the image of one member of the family.
* `CategoryTheory.Sheaf.exists_sieve_of_isLocallySurjective_sigmaDesc`: a family whose induced
  morphism out of the coproduct is locally surjective is jointly locally surjective on sections —
  every section of the target restricts, along the arrows of a covering sieve, into the image of
  a member of the family.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe w' w v u

namespace CategoryTheory.Sheaf

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  {I : Type w'} {G : I → Sheaf J (Type w)} {F : Sheaf J (Type w)}

/-- The subfunctor of the underlying presheaf of `F` generated by the images of a family of
morphisms of sheaves into `F`: over an object it consists of the sections of `F` lying in the
image of one member of the family. -/
@[sga "3 IV 4.1.2" "special case", sga "3 IV 4.4.8"]
def jointRange (c : ∀ i, G i ⟶ F) : Subfunctor F.obj :=
  ⨆ i, Subfunctor.range (c i).hom

/-- A section of the target lies in the joint range of a family exactly when it is the image of
a section of one of the sources. -/
theorem mem_jointRange_obj_iff (c : ∀ i, G i ⟶ F) {U : Cᵒᵖ} (s : F.obj.obj U) :
    s ∈ (jointRange c).obj U ↔ ∃ (i : I) (t : (G i).obj.obj U), (c i).hom.app U t = s := by
  simp [jointRange, Subfunctor.iSup_obj]

/-- **A family of morphisms of sheaves of types whose induced morphism out of the coproduct is
locally surjective is jointly locally surjective on sections.** Every section `s` of the target
over an object `U` restricts, along each arrow of a covering sieve of `U`, into the image of one
member of the family. -/
@[sga "3 IV 4.4.8" "partial"]
theorem exists_sieve_of_isLocallySurjective_sigmaDesc [HasCoproduct G] (c : ∀ i, G i ⟶ F)
    (hc : Sheaf.IsLocallySurjective (Sigma.desc c)) {U : C} (s : F.obj.obj (op U)) :
    ∃ T : Sieve U, T ∈ J U ∧ ∀ ⦃V : C⦄ (g : V ⟶ U), T g →
      ∃ (i : I) (t : (G i).obj.obj (op V)), (c i).hom.app (op V) t = F.obj.map g.op s := by
  have hF : Presieve.IsSheaf J F.obj := (isSheaf_iff_isSheaf_of_type J F.obj).1 F.property
  set R : Subfunctor F.obj := jointRange c
  let Y : Sheaf J (Type w) :=
    ⟨(R.sheafify J).toFunctor, (isSheaf_iff_isSheaf_of_type J _).2 (R.sheafify_isSheaf hF)⟩
  let j : Y ⟶ F := ObjectProperty.homMk (R.sheafify J).ι
  have hle : ∀ i, Subfunctor.range (c i).hom ≤ R.sheafify J := fun i ↦
    le_trans (le_iSup (fun i ↦ Subfunctor.range (c i).hom) i) (R.le_sheafify J)
  let u : ∀ i, G i ⟶ Y := fun i ↦ ObjectProperty.homMk (Subfunctor.lift (c i).hom (hle i))
  have hfac : Sigma.desc u ≫ j = Sigma.desc c := by
    refine Sigma.hom_ext _ _ fun i ↦ ?_
    rw [← Category.assoc, Sigma.ι_desc, Sigma.ι_desc]
    exact Sheaf.hom_ext (Subfunctor.lift_ι (c i).hom (hle i))
  have hfac' : (Sigma.desc u).hom ≫ j.hom = (Sigma.desc c).hom := congrArg (fun φ ↦ φ.hom) hfac
  have hj : Presheaf.IsLocallySurjective J j.hom :=
    Presheaf.isLocallySurjective_of_isLocallySurjective_fac J hfac'
  have hRtop : R.sheafify J = ⊤ := by
    have h := (Presheaf.isLocallySurjective_iff_range_sheafify_eq_top' J j.hom).1 hj
    rwa [show Subfunctor.range j.hom = R.sheafify J from Subfunctor.range_ι _,
      R.sheafify_sheafify hF] at h
  exact ⟨R.sieveOfSection s, (show s ∈ (R.sheafify J).obj (op U) by rw [hRtop]; trivial),
    fun {V} g hg ↦ (mem_jointRange_obj_iff c _).1 hg⟩

end CategoryTheory.Sheaf

end
