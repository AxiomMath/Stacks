module

public import Mathlib.CategoryTheory.Sites.Over
public import StacksFrontier.CategoryTheory.FiberedCategory.CompFibered
public import StacksFrontier.CategoryTheory.Sites.Localization.StacksAndLocalization
public import StacksFrontier.CategoryTheory.Sites.Stack.InheritedSite

/-!
# The topology a slice of a fibred category inherits

Let `p : C ⥤ D` be a fibred category, let `J` be a topology on `D` and give `C` the topology
`p.inheritedTopology J` of Stacks 06NV. For an object `U` of `C` the slice `C/U` sits over `D`
through `Over.forget U ⋙ p` and over `D/p(U)` through `Over.post p`, and all three ways of
putting a topology on `C/U` agree:

```
(Over.forget U ⋙ p).inheritedTopology J
  = (Over.post p).inheritedTopology (J.over (p.obj U))
  = (p.inheritedTopology J).over U.
```

This is what lets the slice projection `C/U ⟶ D/p(U)` inherit the continuity and cocontinuity of
`p` itself.

## Main results

* `CategoryTheory.Functor.isStronglyCartesian_map_self`: a strongly cartesian morphism is strongly
  cartesian over its own image.
* `CategoryTheory.Functor.isStronglyCartesian_overForget_comp_iff`: a morphism of `C/U` is
  strongly cartesian for `Over.forget U ⋙ p` exactly when its underlying morphism is strongly
  cartesian for `p`.
* `CategoryTheory.Functor.isFibered_overPost`: the slice projection of a fibred category is a
  fibred category.
* `CategoryTheory.Functor.cartesianPresieve_map_generate`: the image of the presieve of cartesian
  arrows over a sieve generates that sieve.
* `CategoryTheory.Functor.inheritedTopology_comp_overForget'`: inheriting along
  `p ⋙ Over.forget U` is inheriting along `p` from the localization of the topology at `U`.
* `CategoryTheory.Functor.inheritedTopology_overPost`: the topology the slice projection inherits
  from the localized base topology is the localization of the inherited topology.
* `CategoryTheory.Functor.inheritedTopology_overForget_comp`: the topology `C/U` inherits from `D`
  through `Over.forget U ⋙ p` is the localization of the inherited topology at `U`.

## Main definitions

* `CategoryTheory.Functor.cartesianPresieve`: the strongly cartesian arrows lying over a sieve.
* `CategoryTheory.Functor.inheritedCoverage`: the inherited precoverage of a fibred category,
  presented as a coverage.

## Implementation notes

Both inherited topologies are generated by a precoverage, so the two sides of
`inheritedTopology_overPost` are compared as precoverages and then saturated. The step that is not
formal is matching the two cartesianness conditions: that is
`isStronglyCartesian_overForget_comp_iff`, whose backward direction is the fact that the forgetful
functor of a slice is itself strongly cartesian on every lift.

Saturating requires the inherited precoverage to be stable under base change, i.e. to come from a
`CategoryTheory.Coverage`; the refinement of a pullback is the presieve of *cartesian* arrows over
the pulled-back sieve, whose image generates that sieve back because every arrow of the base has a
cartesian lift.

`inheritedTopology_comp_overForget'` is stated here for a fibred `p`. The unprimed
`CategoryTheory.Functor.inheritedTopology_comp_overForget` assumes instead that `p` is fibred in
groupoids, where the cartesianness condition is vacuous; for a merely fibred `p` the two
conditions are matched by `CategoryTheory.Functor.isStronglyCartesian_of_comp_forget` and
`CategoryTheory.Functor.IsStronglyCartesian.comp_functor`.

## References

* [Stacks Project, Tag 06NV](https://stacks.math.columbia.edu/tag/06NV)
* [Stacks Project, Tag 02XR](https://stacks.math.columbia.edu/tag/02XR)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace CategoryTheory.Functor

universe u₁ u₂ u₃ v₁ v₂ v₃

section Pushforward

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]

private lemma generate_functorPushforward_eq (F : C ⥤ D) {X : C} (R : Presieve X) :
    Sieve.generate (R.functorPushforward F) = Sieve.generate (R.map F) := by
  refine le_antisymm ?_ (Sieve.generate_mono (Presieve.map_le_functorPushforward F R))
  rw [Sieve.generate_le_iff, Sieve.arrows_generate_map_eq_functorPushforward]

private lemma generate_presieveFunctorPushforward_eq (F : C ⥤ D) {X : C} (R : Presieve X) :
    Sieve.generate (Presieve.functorPushforward F R) =
      (Sieve.generate R).functorPushforward F := by
  rw [← Sieve.generate_map_eq_functorPushforward, generate_functorPushforward_eq]


private lemma presieve_map_comp_functor {E : Type u₃} [Category.{v₃} E] (F : C ⥤ D) (G : D ⥤ E)
    {X : C} (R : Presieve X) : (R.map F).map G = R.map (F ⋙ G) :=
  le_antisymm (fun _ _ ⟨⟨h⟩⟩ ↦ Presieve.map_map h) fun _ _ ⟨h⟩ ↦
    Presieve.map_map (Presieve.map_map h)

end Pushforward

section Slice

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]

/-- A morphism of the slice `C/U` is strongly cartesian for `Over.forget U ⋙ p` exactly when the
morphism it lies over is strongly cartesian for `p`. -/
lemma isStronglyCartesian_overForget_comp_iff (p : C ⥤ D) (U : C) {X Y : Over U} (f : X ⟶ Y) :
    (Over.forget U ⋙ p).IsStronglyCartesian
        ((Over.forget U ⋙ p).map f) f ↔ p.IsStronglyCartesian (p.map f.left) f.left := by
  constructor
  · intro hf
    have : (Over.forget U ⋙ p).IsStronglyCartesian (p.map f.left) f := by simpa using hf
    refine { toIsHomLift := inferInstance, universal_property' := ?_ }
    intro Z g ψ hψ
    let ZU : Over U := Over.mk (ψ ≫ Y.hom)
    let ψU : ZU ⟶ Y := Over.homMk ψ rfl
    let : (Over.forget U ⋙ p).IsHomLift (g ≫ p.map f.left) ψU := by
      apply IsHomLift.of_fac' _ _ _ (by rfl) (by rfl)
      simpa [ZU, ψU, Functor.comp_map] using
        (IsHomLift.eq_of_isHomLift p (g ≫ p.map f.left) ψ).symm
    obtain ⟨χ, ⟨hχ, hχf⟩, hχuniq⟩ :=
      IsStronglyCartesian.universal_property (Over.forget U ⋙ p)
        (p.map f.left) f (g := g) (g ≫ p.map f.left) rfl ψU
    have hχp : p.IsHomLift g χ.left := by
      apply IsHomLift.of_fac' _ _ _ rfl rfl
      simpa [ZU, Functor.comp_map] using (IsHomLift.fac' (Over.forget U ⋙ p) g χ)
    refine ⟨χ.left, ⟨hχp, congrArg Over.Hom.left hχf⟩, ?_⟩
    rintro χ' ⟨hχ', hχ'f⟩
    let χ'U : ZU ⟶ X := Over.homMk χ' (by simp [ZU, ← hχ'f])
    have hχ'U : (Over.forget U ⋙ p).IsHomLift g χ'U := by
      apply IsHomLift.of_fac' _ _ _ rfl rfl
      simpa [ZU, χ'U, Functor.comp_map] using
        (IsHomLift.eq_of_isHomLift p g χ').symm
    exact congrArg Over.Hom.left (hχuniq χ'U ⟨hχ'U, Over.OverMorphism.ext hχ'f⟩)
  · intro hf
    let : (Over.forget U).IsHomLift f.left f := by
      change (Over.forget U).IsHomLift ((Over.forget U).map f) f
      infer_instance
    let : (Over.forget U).IsStronglyCartesian f.left f := Over.isStronglyCartesian_forget f.left f
    exact IsStronglyCartesian.comp_functor (Over.forget U) p (p.map f.left) f.left f

/-- The precoverage `C/U` inherits through `Over.forget U ⋙ p` is the one inherited by `C` along
`p`, pulled back along the forgetful functor. -/
private lemma sliceInheritedPrecoverage_eq (p : C ⥤ D) (U : C) (J : GrothendieckTopology D) :
    (Over.forget U ⋙ p).inheritedPrecoverage J.toPrecoverage =
      (p.inheritedPrecoverage J.toPrecoverage).comap (Over.forget U) := by
  ext X R
  rw [Precoverage.mem_comap_iff]
  have hmap : R.map (Over.forget U ⋙ p) = (R.map (Over.forget U)).map p :=
    (presieve_map_comp_functor (Over.forget U) p R).symm
  constructor
  · rintro ⟨hcart, hcov⟩
    refine ⟨?_, ?_⟩
    · intro Z g hg
      rcases (Presieve.map_iff.mp hg) with ⟨Y, rfl, f, hf, hfg⟩
      have hp := (isStronglyCartesian_overForget_comp_iff p U f).1 (hcart f hf)
      have hleft : f.left = g := by simpa using hfg
      simpa [hleft] using hp
    · simpa only [hmap, Functor.comp_obj] using hcov
  · rintro ⟨hcart, hcov⟩
    refine ⟨?_, ?_⟩
    · intro Z g hg
      have hg' : (R.map (Over.forget U)) ((Over.forget U).map g) :=
        Presieve.map_map (F := Over.forget U) hg
      exact (isStronglyCartesian_overForget_comp_iff p U g).2 (hcart _ hg')
    · simpa only [hmap, Functor.comp_obj] using hcov

/-- **Stacks 02XR for the slice projection.** The slice projection `C/U ⥤ D/p(U)` of a fibred
category is a fibred category: it composes with the forgetful functor to `Over.forget U ⋙ p`,
which is fibred as a composite of fibred functors. -/
lemma isFibered_overPost (p : C ⥤ D) [p.IsFibered] (U : C) :
    (Over.post p : Over U ⥤ Over (p.obj U)).IsFibered := by
  let r : Over U ⥤ D := Over.forget U ⋙ p
  have : r.IsFibered := Functor.IsFibered.comp_functor (Over.forget U) p
  exact Functor.IsFibered.of_comp_over (U := p.obj U) (p' := Over.post p) r
    (Over.post_forget_eq_forget_comp p U)

end Slice

section InheritedCoverage

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D] (p : C ⥤ D)

/-- Strong cartesianness of `g` over `f` forces `f` to be `p.map g` up to the identification of
its source, so a strongly cartesian morphism is strongly cartesian over its own image. -/
lemma isStronglyCartesian_map_self {R S : D} (f : R ⟶ S) {X Y : C} (g : X ⟶ Y)
    [p.IsStronglyCartesian f g] : p.IsStronglyCartesian (p.map g) g := by
  subst_hom_lift p f g
  assumption

/-- The presieve of strongly cartesian arrows of `C` whose image lies in a given sieve on
`p.obj X`. -/
def cartesianPresieve {X : C} (S : Sieve (p.obj X)) : Presieve X :=
  fun _ f => p.IsStronglyCartesian (p.map f) f ∧ S (p.map f)

/-- The image of the cartesian presieve over a sieve `S` generates `S` back, because every
morphism of the base has a cartesian lift. -/
lemma cartesianPresieve_map_generate [p.IsFibered] {X : C}
    (S : Sieve (p.obj X)) : Sieve.generate ((cartesianPresieve p S).map p) = S := by
  apply le_antisymm
  · rw [Sieve.generate_le_iff]
    rintro _ _ ⟨hf⟩
    exact hf.2
  · intro Z f hf
    obtain ⟨Y, g, hg⟩ := IsPreFibered.exists_isCartesian p rfl f
    have hcart : p.IsStronglyCartesian (p.map g) g := isStronglyCartesian_map_self p f g
    have hfac := IsHomLift.fac' p f g
    have hmem : S (p.map g) := by
      rw [hfac]
      simpa using S.downward_closed hf (eqToHom (IsHomLift.domain_eq p f g))
    have hm := Sieve.le_generate ((cartesianPresieve p S).map p) _ _
      (Presieve.map_map (F := p) (show cartesianPresieve p S g from ⟨hcart, hmem⟩))
    convert (Sieve.generate ((cartesianPresieve p S).map p)).downward_closed hm
      (eqToHom (IsHomLift.domain_eq p f g).symm) using 1
    simp [hfac]

/-- The inherited precoverage of a fibred category, as a coverage: a pullback of an inherited
covering is refined by the cartesian arrows over its image. -/
def inheritedCoverage [p.IsFibered] (J : GrothendieckTopology D) : Coverage C where
  toPrecoverage := p.inheritedPrecoverage J.toPrecoverage
  pullback := by
    intro X Y f R hR
    let S := (Sieve.generate (R.map p)).pullback (p.map f)
    refine ⟨cartesianPresieve p S, ⟨fun _ g hg => hg.1, ?_⟩, ?_⟩
    · rw [GrothendieckTopology.mem_toPrecoverage_iff, cartesianPresieve_map_generate]
      exact J.pullback_stable (p.map f) hR.2
    · intro Z g hg
      rcases hg.2 with ⟨W, a, b, hb, hab⟩
      rcases hb with ⟨hv⟩
      rename_i V v
      have := hR.1 v hv
      refine ⟨V, IsStronglyCartesian.map p (p.map v) v
        (f' := p.map (g ≫ f)) (by simpa using hab.symm) (g ≫ f), v, hv, ?_⟩
      exact IsStronglyCartesian.fac p (p.map v) v _ _

private lemma over_coverage_eq (K : Coverage C) (X : C) :
    K.toPrecoverage.toGrothendieck.over X =
      (K.toPrecoverage.comap (Over.forget X)).toGrothendieck := by
  refine le_antisymm ?_ ?_
  · intro ⟨Y, right, (s : Y ⟶ X)⟩ R hR
    obtain ⟨(R : Sieve Y), rfl⟩ := (Sieve.overEquiv _).symm.surjective R
    simp only [GrothendieckTopology.mem_over_iff, OrderIso.apply_symm_apply] at hR
    change K.toPrecoverage.Saturate Y R at hR
    rw [← K.saturate_iff_saturate_toPrecoverage] at hR
    induction hR with
    | of Z S hS =>
      rw [Sieve.overEquiv_symm_generate]
      exact .of _ _ (by simpa)
    | top => simp
    | transitive Y R S hR H ih ih' =>
      refine GrothendieckTopology.transitive _ (ih s) _ fun Z g hg => ?_
      obtain rfl : right = Z.right := Subsingleton.elim _ _
      rw [← Sieve.overEquiv_symm_pullback]
      exact ih' hg Z.hom
  · rw [Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
    intro Y R hR
    rw [Precoverage.mem_comap_iff] at hR
    rw [GrothendieckTopology.mem_toPrecoverage_iff, GrothendieckTopology.mem_over_iff,
      Sieve.overEquiv, RelIso.coe_fn_mk, Equiv.coe_fn_mk,
      ← Sieve.generate_map_eq_functorPushforward]
    exact Precoverage.Saturate.of _ _ hR

end InheritedCoverage

section InheritedTopology

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]

/-- The topology the slice projection `C/U ⥤ D/p(U)` inherits from the localized base topology is
the localization at `U` of the topology `C` inherits from `D`. -/
lemma inheritedTopology_overPost (p : C ⥤ D) [p.IsFibered] (J : GrothendieckTopology D) (U : C) :
    (Over.post p : Over U ⥤ Over (p.obj U)).inheritedTopology (J.over (p.obj U)) =
      (p.inheritedTopology J).over U := by
  rw [Functor.inheritedTopology_eq,
    show p.inheritedTopology J = (inheritedCoverage p J).toPrecoverage.toGrothendieck from rfl,
    over_coverage_eq]
  congr 1
  change (Over.post p).inheritedPrecoverage (J.over (p.obj U)).toPrecoverage =
    (p.inheritedPrecoverage J.toPrecoverage).comap (Over.forget U)
  rw [← sliceInheritedPrecoverage_eq]
  ext X R
  change _ ∧ _ ↔ _ ∧ _
  refine and_congr (forall₃_congr fun Y f hf => ?_) ?_
  · simpa only [Over.post_forget_eq_forget_comp] using
      isStronglyCartesian_comp_forget_iff (Over.post p) f
  · simp only [GrothendieckTopology.mem_toPrecoverage_iff,
      GrothendieckTopology.mem_over_iff, Sieve.overEquiv,
      RelIso.coe_fn_mk, Equiv.coe_fn_mk, ← Sieve.generate_map_eq_functorPushforward,
      presieve_map_comp_functor, Over.post_forget_eq_forget_comp]
    exact Iff.rfl

/-- Inheriting a topology along `p ⋙ Over.forget U`, for a fibred `p : X ⥤ D/U`, is the same as
inheriting along `p` from the localization of that topology at `U`.

`CategoryTheory.Functor.inheritedTopology_comp_overForget` is the same conclusion under the
stronger hypothesis that `p` is fibred in groupoids. -/
lemma inheritedTopology_comp_overForget' {X : Type u₃} [Category.{v₃} X] (U : D) (p : X ⥤ Over U)
    [p.IsFibered] (J : GrothendieckTopology D) :
    (p ⋙ Over.forget U).inheritedTopology J = p.inheritedTopology (J.over U) := by
  let q := p ⋙ Over.forget U
  let : q.IsFibered := Functor.IsFibered.comp_functor p (Over.forget U)
  have hgen (Y : X) (R : Presieve Y) :
      Sieve.generate (R.map q) =
        Sieve.generate (Presieve.functorPushforward (Over.forget U) (R.map p)) := by
    rw [generate_functorPushforward_eq, presieve_map_comp_functor]
  have hpre : q.inheritedPrecoverage J.toPrecoverage =
      p.inheritedPrecoverage (J.over U).toPrecoverage := by
    ext Y R
    change _ ∧ _ ↔ _ ∧ _
    refine and_congr (forall₃_congr fun Z f hf => ?_) ?_
    · exact (isStronglyCartesian_comp_forget_iff p f).symm
    · rw [GrothendieckTopology.mem_toPrecoverage_iff, GrothendieckTopology.mem_toPrecoverage_iff,
        GrothendieckTopology.mem_over_iff, Sieve.overEquiv_generate, ← hgen Y R]
      rfl
  simp [q, Functor.inheritedTopology_eq, hpre]

/-- The topology the slice `C/U` inherits from `D` along `Over.forget U ⋙ p` is the localization
at `U` of the topology `C` inherits from `D`. -/
lemma inheritedTopology_overForget_comp (p : C ⥤ D) [p.IsFibered] (J : GrothendieckTopology D)
    (U : C) :
    (Over.forget U ⋙ p).inheritedTopology J = (p.inheritedTopology J).over U := by
  let q : Over U ⥤ Over (p.obj U) := Over.post p
  have : q.IsFibered := isFibered_overPost p U
  calc
    (Over.forget U ⋙ p).inheritedTopology J =
        (q ⋙ Over.forget (p.obj U)).inheritedTopology J := by
          rw [Over.post_forget_eq_forget_comp]
    _ = q.inheritedTopology (J.over (p.obj U)) :=
      inheritedTopology_comp_overForget' (p.obj U) q J
    _ = (p.inheritedTopology J).over U := inheritedTopology_overPost p J U

end InheritedTopology

end CategoryTheory.Functor

end
