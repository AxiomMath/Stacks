/-!
# Functoriality of the topos of a fibred category over a site

Let `(𝒞, J)` be a site and let `F : 𝒳 ⥤ 𝒴` be a 1-morphism of fibred categories over `𝒞`
(Stacks 02XP): a functor strictly over `𝒞` which carries strongly cartesian morphisms to strongly
cartesian morphisms. Endow `𝒳` and `𝒴` with the topologies they inherit from `𝒞` (Stacks 06NV), in
which a family of morphisms covers when each of its members is strongly cartesian over its image
and the family of images covers in `𝒞`.

Stacks 06NW says that `F` is then a continuous and a cocontinuous functor between those two sites.
This file proves Stacks 06NW in the special case where `𝒞` has fibre products (`[HasPullbacks 𝒞]`,
which Stacks does not assume). The registered forms of Stacks 06NW, with no hypothesis on the base
beyond its topology, are
`CategoryTheory.Functor.IsFibredOneMorphism.isContinuous_inheritedTopology` and
`CategoryTheory.Functor.IsFibredOneMorphism.isCocontinuous_inheritedTopology`
(`StacksFrontier/CategoryTheory/Sites/InheritedTopology/OneMorphismContinuity.lean`), and the
morphism of topoi derived from them in
`StacksFrontier/CategoryTheory/Sites/InheritedTopology/OneMorphismTopoi.lean`.

Consequently `F` induces a morphism of topoi `f : Sh(𝒳) ⟶ Sh(𝒴)` whose inverse image is plain
restriction, so that `f⁻¹(𝒢)(x) = 𝒢(F x)`, and whose direct image is the right Kan extension along
`F.op`, both with no intervening sheafification.

## Main results

* `CategoryTheory.Functor.IsFibredOneMorphism.isContinuous_and_isCocontinuous_inheritedTopology`:
  `F` is continuous and cocontinuous for the inherited topologies.
* `CategoryTheory.Functor.IsFibredOneMorphism.inverseImageCompSheafToPresheafIso` and
  `CategoryTheory.Functor.IsFibredOneMorphism.inverseImage_obj_obj_obj`: the inverse image is
  restriction along `F.op` with no sheafification, so `f⁻¹(𝒢)(x) = 𝒢(F x)`.
* `CategoryTheory.Functor.IsFibredOneMorphism.preservesFiniteLimits_inverseImage`: the inverse
  image is left exact.
* `CategoryTheory.Functor.IsFibredOneMorphism.directImageCompSheafToPresheafIso`: the direct image
  is the right Kan extension along `F.op`.
* `CategoryTheory.Functor.IsFibredOneMorphism.sheafAdjunctionInheritedTopology`: the morphism of
  topoi `f : Sh(𝒳) ⟶ Sh(𝒴)` itself, as the adjunction `f⁻¹ ⊣ f_*`.

## References

* [StacksProject 06NW](https://stacks.math.columbia.edu/tag/06NW)
-/

@[expose] public section

open CategoryTheory Limits

universe v₁ v₂ v₃ u₁ u₂ u₃

namespace CategoryTheory.Functor

variable {𝒞 : Type u₁} [Category.{v₁} 𝒞] {𝒳 : Type u₂} [Category.{v₂} 𝒳]
  {𝒴 : Type u₃} [Category.{v₃} 𝒴]

/-! ### Auxiliary lemmas -/

/-- If `φ : a ⟶ b` lies over `f : R ⟶ r.obj b`, then `r.map φ` is `f` preceded by the
identification of `r.obj a` with `R`. -/
public lemma map_eq_eqToHom_comp_of_isHomLift (r : 𝒳 ⥤ 𝒞) {R : 𝒞} {a b : 𝒳}
    (f : R ⟶ r.obj b) (φ : a ⟶ b) [r.IsHomLift f φ] :
    r.map φ = eqToHom (IsHomLift.domain_eq r f φ) ≫ f := by
  simpa using IsHomLift.fac' r f φ

/-- A morphism `φ` lying over `f` puts `f` into the sieve generated by any presieve containing the
image of `φ`. -/
public lemma mem_generate_arrows_of_isHomLift (r : 𝒳 ⥤ 𝒞) {R : 𝒞} {a b : 𝒳}
    (f : R ⟶ r.obj b) (φ : a ⟶ b) [r.IsHomLift f φ] {T : Presieve (r.obj b)}
    (hT : T (r.map φ)) : (Sieve.generate T).arrows f :=
  ⟨r.obj a, eqToHom (IsHomLift.domain_eq r f φ).symm, r.map φ, hT, by
    rw [map_eq_eqToHom_comp_of_isHomLift r f φ]; simp⟩

/-- A morphism `χ` into the target of a strongly cartesian `ψ` whose image factors through the
image of `ψ` factors through `ψ` itself. -/
public lemma exists_comp_eq_of_isStronglyCartesian (r : 𝒴 ⥤ 𝒞) {c d e : 𝒴} (ψ : c ⟶ d)
    [r.IsStronglyCartesian (r.map ψ) ψ] (χ : e ⟶ d) (α : r.obj e ⟶ r.obj c)
    (hα : r.map χ = α ≫ r.map ψ) : ∃ θ : e ⟶ c, θ ≫ ψ = χ := by
  obtain ⟨θ, ⟨-, hθ⟩, -⟩ :=
    IsStronglyCartesian.universal_property r (r.map ψ) ψ α (r.map χ) hα χ
  exact ⟨θ, hθ⟩

/-- A commuting square of `𝒴` whose image under `r` is a fibre product square is itself a fibre
product square, as soon as the side `f` of the cospan and the projection `b` parallel to it are
strongly cartesian. -/
private lemma isPullback_of_isPullback_map (r : 𝒴 ⥤ 𝒞) {W X Y Z : 𝒴}
    (a : W ⟶ Y) (b : W ⟶ Z) (f : Y ⟶ X) (g : Z ⟶ X)
    [r.IsStronglyCartesian (r.map f) f] [r.IsStronglyCartesian (r.map b) b]
    (hab : a ≫ f = b ≫ g)
    (hbase : IsPullback (r.map a) (r.map b) (r.map f) (r.map g)) :
    IsPullback a b f g := by
  have ext_of_map_eq : ∀ {c d e : 𝒴} (ψ : c ⟶ d) [r.IsStronglyCartesian (r.map ψ) ψ]
      (m m' : e ⟶ c), r.map m = r.map m' → m ≫ ψ = m' ≫ ψ → m = m' := by
    intro c d e ψ _ m m' hm h
    have : r.IsHomLift (r.map m') m := by rw [← hm]; infer_instance
    exact IsStronglyCartesian.ext r (r.map ψ) ψ (r.map m') h
  have key : ∀ s : PullbackCone f g, ∃ t : s.pt ⟶ W, t ≫ a = s.fst ∧ t ≫ b = s.snd ∧
      ∀ m : s.pt ⟶ W, m ≫ a = s.fst → m ≫ b = s.snd → m = t := by
    intro s
    have hcond : r.map s.fst ≫ r.map f = r.map s.snd ≫ r.map g := by
      rw [← r.map_comp, ← r.map_comp, s.condition]
    obtain ⟨α, hα₁, hα₂⟩ : ∃ α : r.obj s.pt ⟶ r.obj W,
        α ≫ r.map a = r.map s.fst ∧ α ≫ r.map b = r.map s.snd :=
      ⟨hbase.lift _ _ hcond, hbase.lift_fst _ _ hcond, hbase.lift_snd _ _ hcond⟩
    obtain ⟨t, ⟨htα, htb⟩, -⟩ :=
      IsStronglyCartesian.universal_property r (r.map b) b α (r.map s.snd) hα₂.symm s.snd
    have htmap : r.map t = α := (IsHomLift.eq_of_isHomLift r α t).symm
    have hta : t ≫ a = s.fst :=
      ext_of_map_eq f (t ≫ a) s.fst (by rw [r.map_comp, htmap, hα₁])
        (by rw [Category.assoc, hab, ← Category.assoc, htb, s.condition])
    refine ⟨t, hta, htb, fun m hm₁ hm₂ ↦ ext_of_map_eq b m t ?_ (by rw [hm₂, htb])⟩
    rw [htmap]
    exact hbase.hom_ext (by rw [← r.map_comp, hm₁, hα₁]) (by rw [← r.map_comp, hm₂, hα₂])
  exact IsPullback.of_isLimit (PullbackCone.IsLimit.mk hab (fun s ↦ (key s).choose)
    (fun s ↦ (key s).choose_spec.1) (fun s ↦ (key s).choose_spec.2.1)
    (fun s m h₁ h₂ ↦ (key s).choose_spec.2.2 m h₁ h₂))

/-- Let `q : 𝒴 ⥤ 𝒞` be a functor to a category with fibre products, let `F : 𝒳 ⥤ 𝒴` make
`F ⋙ q` a fibred category, and let `F` carry morphisms strongly cartesian for `F ⋙ q` to morphisms
strongly cartesian for `q`. If `f` is strongly cartesian then the fibre product of `f` and any `g`
with the same target exists and is preserved by `F`. -/
public theorem IsFibredOneMorphism.preservesLimit_cospan_of_isStronglyCartesian
    [HasPullbacks 𝒞] {q : 𝒴 ⥤ 𝒞} {F : 𝒳 ⥤ 𝒴} [(F ⋙ q).IsFibered]
    (hcart : ∀ {R T : 𝒞} (f : R ⟶ T) {a b : 𝒳} (φ : a ⟶ b),
      (F ⋙ q).IsStronglyCartesian f φ → q.IsStronglyCartesian f (F.map φ))
    {x y z : 𝒳} (f : y ⟶ x) (g : z ⟶ x)
    (hf : (F ⋙ q).IsStronglyCartesian ((F ⋙ q).map f) f) :
    PreservesLimit (cospan f g) F := by
  have : HasPullback f g := IsFibered.hasPullback_of_isStronglyCartesian (F ⋙ q) f g
  have hsnd : (F ⋙ q).IsStronglyCartesian
      ((F ⋙ q).map (pullback.snd f g)) (pullback.snd f g) :=
    IsFibered.snd_isStronglyCartesian (F ⋙ q) f g
  have hbase := IsFibered.map_isPullback_of_isStronglyCartesian (F ⋙ q) f g
  have h1 : q.IsStronglyCartesian (q.map (F.map f)) (F.map f) := hcart _ f hf
  have h2 : q.IsStronglyCartesian
      (q.map (F.map (pullback.snd f g))) (F.map (pullback.snd f g)) := hcart _ _ hsnd
  have hmapped : IsPullback (F.map (pullback.fst f g)) (F.map (pullback.snd f g))
      (F.map f) (F.map g) :=
    isPullback_of_isPullback_map q _ _ _ _
      (by rw [← F.map_comp, ← F.map_comp, pullback.condition]) hbase
  exact preservesLimit_of_preserves_limit_cone (pullbackIsPullback f g)
    ((isLimitMapConePullbackConeEquiv F pullback.condition).symm hmapped.isLimit)

/-- Let `(𝒞, J)` be a site and let `F : 𝒳 ⥤ 𝒴` be a 1-morphism of fibred categories over `𝒞`
(Stacks 02XP), so that `F ⋙ q = p` and `F` preserves strongly cartesian morphisms. Then `F` is a
continuous and a cocontinuous functor between the topologies that `𝒳` and `𝒴` inherit from `𝒞`
(Stacks 06NV).

This is the special case of Stacks 06NW in which `𝒞` has fibre products; the general form, with no
`[HasPullbacks 𝒞]`, is `IsFibredOneMorphism.isContinuous_inheritedTopology` together with
`IsFibredOneMorphism.isCocontinuous_inheritedTopology`. -/
public theorem IsFibredOneMorphism.isContinuous_and_isCocontinuous_inheritedTopology
    [HasPullbacks 𝒞] (J : GrothendieckTopology 𝒞) {p : 𝒳 ⥤ 𝒞} {q : 𝒴 ⥤ 𝒞} {F : 𝒳 ⥤ 𝒴}
    [p.IsFibered] [q.IsFibered] (hF : p.IsFibredOneMorphism q F) :
    F.IsContinuous (p.inheritedTopology J) (q.inheritedTopology J) ∧
      F.IsCocontinuous (p.inheritedTopology J) (q.inheritedTopology J) := by
  obtain ⟨rfl, hcart⟩ := hF
  refine ⟨?_, ?_⟩
  · have hle : (F ⋙ q).inheritedPrecoverage J.toPrecoverage ≤
        (q.inheritedPrecoverage J.toPrecoverage).comap F := by
      intro x R hR
      rw [Precoverage.mem_comap_iff]
      refine ⟨?_, ?_⟩
      · rintro _ _ ⟨hg⟩
        exact hcart _ _ (hR.1 _ hg)
      · obtain ⟨ι, Y, v, rfl⟩ := R.exists_eq_ofArrows
        simpa using hR.2
    have hpres : ((F ⋙ q).inheritedPrecoverage J.toPrecoverage).PullbacksPreservedBy F := by
      constructor
      intro x R hR
      constructor
      intro _ _ f g hf hg
      exact IsFibredOneMorphism.preservesLimit_cospan_of_isStronglyCartesian hcart f g (hR.1 f hf)
    exact F.isContinuous_toGrothendieck_of_pullbacksPreservedBy _ _ hle
  · constructor
    intro x S hS
    have hS' : S ∈ (q.inheritedPrecoverage J.toPrecoverage).toGrothendieck (F.obj x) := hS
    rw [Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition] at hS'
    obtain ⟨R, hR, hRS⟩ := hS'
    obtain ⟨ι, Y, v, rfl⟩ := R.exists_eq_ofArrows
    have hvc : ∀ i, q.IsStronglyCartesian (q.map (v i)) (v i) := fun i ↦
      hR.1 (v i) (Presieve.ofArrows.mk i)
    choose W u hu using fun i ↦
      IsFibered.exists_isStronglyCartesian (F ⋙ q) (Y := x) (q.map (v i))
    have hucart : ∀ i, (F ⋙ q).IsStronglyCartesian ((F ⋙ q).map (u i)) (u i) := fun i ↦ by
      have := hu i
      exact IsStronglyCartesian.isStronglyCartesian_map (F ⋙ q) (u i) (q.map (v i))
    have hmem : Presieve.ofArrows W u ∈
        (F ⋙ q).inheritedPrecoverage J.toPrecoverage x := by
      refine ⟨?_, ?_⟩
      · rintro _ _ ⟨i⟩
        exact hucart i
      · rw [Presieve.map_ofArrows, GrothendieckTopology.mem_toPrecoverage_iff]
        have h2 : Sieve.generate
            (Presieve.ofArrows (fun i ↦ q.obj (Y i)) (fun i ↦ q.map (v i)))
            ∈ J (q.obj (F.obj x)) := by
          have h := hR.2
          rwa [Presieve.map_ofArrows, GrothendieckTopology.mem_toPrecoverage_iff] at h
        refine J.superset_covering ?_ h2
        rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
        intro i
        have := hu i
        exact mem_generate_arrows_of_isHomLift (F ⋙ q) (q.map (v i)) (u i) (Presieve.ofArrows.mk i)
    have hsub : Sieve.generate (Presieve.ofArrows W u) ≤ Sieve.functorPullback F S := by
      rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
      intro i
      have := hu i
      have := hvc i
      have hα : q.map (F.map (u i)) =
          eqToHom (IsHomLift.domain_eq (F ⋙ q) (q.map (v i)) (u i)) ≫ q.map (v i) :=
        map_eq_eqToHom_comp_of_isHomLift (F ⋙ q) (q.map (v i)) (u i)
      obtain ⟨θ, hθ⟩ := exists_comp_eq_of_isStronglyCartesian q (v i) (F.map (u i)) _ hα
      have hvS : S.arrows (v i) := hRS _ _ (Presieve.ofArrows.mk i)
      exact (hθ ▸ S.downward_closed hvS θ : S.arrows (F.map (u i)))
    rw [inheritedTopology_eq]
    exact GrothendieckTopology.superset_covering _ hsub
      (Precoverage.generate_mem_toGrothendieck hmem)

/-! ### The induced morphism of topoi

`F` induces a morphism of topoi `f : Sh(𝒳) ⟶ Sh(𝒴)` with `f_* = {}_sF = {}_pF` the right Kan
extension along `F.op`, `f⁻¹ = F^s = F^p` plain restriction along `F.op`, and
`f⁻¹(𝒢)(x) = 𝒢(F x)`. Here `A` is any category of coefficients.

The declarations of this section assume `[HasPullbacks 𝒞]`, which Stacks 06NW does not; the
forms without it are in `StacksFrontier/CategoryTheory/Sites/InheritedTopology/OneMorphismTopoi.lean`.
-/

universe v₄ u₄

section MorphismOfTopoi

variable [HasPullbacks 𝒞] (J : GrothendieckTopology 𝒞) {p : 𝒳 ⥤ 𝒞} {q : 𝒴 ⥤ 𝒞} {F : 𝒳 ⥤ 𝒴}
  [p.IsFibered] [q.IsFibered] (hF : p.IsFibredOneMorphism q F)
  (A : Type u₄) [Category.{v₄} A]

/-- The inverse image of the morphism of topoi induced by a 1-morphism of fibred categories is
plain restriction along `F.op`: as a functor to presheaves on `𝒳` it is `sheafToPresheaf` followed
by precomposition with `F.op`, with no sheafification intervening. -/
def IsFibredOneMorphism.inverseImageCompSheafToPresheafIso :
    letI := (hF.isContinuous_and_isCocontinuous_inheritedTopology J).1
    F.sheafPushforwardContinuous A (p.inheritedTopology J) (q.inheritedTopology J) ⋙
        sheafToPresheaf (p.inheritedTopology J) A ≅
      sheafToPresheaf (q.inheritedTopology J) A ⋙ (whiskeringLeft _ _ _).obj F.op :=
  have := (hF.isContinuous_and_isCocontinuous_inheritedTopology J).1
  F.sheafPushforwardContinuousCompSheafToPresheafIso A _ _

/-- The formula `f⁻¹(𝒢)(x) = 𝒢(F x)`: the sections of the inverse image of a sheaf `𝒢` on `𝒴`
over an object `x` of `𝒳` are the sections of `𝒢` over `F x`. -/
theorem IsFibredOneMorphism.inverseImage_obj_obj_obj :
    letI := (hF.isContinuous_and_isCocontinuous_inheritedTopology J).1
    ∀ (𝒢 : Sheaf (q.inheritedTopology J) A) (x : 𝒳),
      ((F.sheafPushforwardContinuous A (p.inheritedTopology J)
            (q.inheritedTopology J)).obj 𝒢).obj.obj (Opposite.op x) =
        𝒢.obj.obj (Opposite.op (F.obj x)) :=
  have := (hF.isContinuous_and_isCocontinuous_inheritedTopology J).1
  fun 𝒢 x ↦ F.sheafPushforwardContinuous_obj_obj_obj A _ _ 𝒢 (Opposite.op x)

/-- The inverse image `f⁻¹` of the morphism of topoi induced by a 1-morphism of fibred categories
preserves finite limits. -/
theorem IsFibredOneMorphism.preservesFiniteLimits_inverseImage [HasFiniteLimits A] :
    letI := (hF.isContinuous_and_isCocontinuous_inheritedTopology J).1
    PreservesFiniteLimits (F.sheafPushforwardContinuous A (p.inheritedTopology J)
      (q.inheritedTopology J)) := by
  have := (hF.isContinuous_and_isCocontinuous_inheritedTopology J).1
  constructor
  intro S _ _
  have h2 : PreservesLimitsOfShape S
      (F.sheafPushforwardContinuous A (p.inheritedTopology J) (q.inheritedTopology J) ⋙
        sheafToPresheaf (p.inheritedTopology J) A) :=
    preservesLimitsOfShape_of_natIso
      (F.sheafPushforwardContinuousCompSheafToPresheafIso A _ _).symm
  exact preservesLimitsOfShape_of_reflects_of_preserves _ (sheafToPresheaf _ A)

/-- The direct image of the morphism of topoi is the right Kan extension along `F.op`, taken on
sheaves: as a functor to presheaves on `𝒴` it is `sheafToPresheaf` followed by `F.op.ran`. -/
noncomputable def IsFibredOneMorphism.directImageCompSheafToPresheafIso
    [∀ (G : 𝒳ᵒᵖ ⥤ A), F.op.HasPointwiseRightKanExtension G] :
    letI := (hF.isContinuous_and_isCocontinuous_inheritedTopology J).2
    F.sheafPushforwardCocontinuous A (p.inheritedTopology J) (q.inheritedTopology J) ⋙
        sheafToPresheaf (q.inheritedTopology J) A ≅
      sheafToPresheaf (p.inheritedTopology J) A ⋙ F.op.ran :=
  have := (hF.isContinuous_and_isCocontinuous_inheritedTopology J).2
  F.sheafPushforwardCocontinuousCompSheafToPresheafIso A _ _

/-- The morphism of topoi `f : Sh(𝒳) ⟶ Sh(𝒴)` induced by a 1-morphism of fibred categories `F`,
as the adjunction `f⁻¹ ⊣ f_*` between the two inherited sites, with `f⁻¹` the restriction
`F.sheafPushforwardContinuous` and `f_*` the right Kan extension `F.sheafPushforwardCocontinuous`.
-/
noncomputable def IsFibredOneMorphism.sheafAdjunctionInheritedTopology
    [∀ (G : 𝒳ᵒᵖ ⥤ A), F.op.HasPointwiseRightKanExtension G] :
    letI := (hF.isContinuous_and_isCocontinuous_inheritedTopology J).1
    letI := (hF.isContinuous_and_isCocontinuous_inheritedTopology J).2
    F.sheafPushforwardContinuous A (p.inheritedTopology J) (q.inheritedTopology J) ⊣
      F.sheafPushforwardCocontinuous A (p.inheritedTopology J) (q.inheritedTopology J) :=
  have := (hF.isContinuous_and_isCocontinuous_inheritedTopology J).1
  have := (hF.isContinuous_and_isCocontinuous_inheritedTopology J).2
  F.sheafAdjunctionCocontinuous A _ _

end MorphismOfTopoi

/-- For a functor `F` between small categories, the pointwise right Kan extensions along `F.op` of
presheaves of sets exist, and the category of sets has finite limits. -/
example {𝒳' : Type u₄} [SmallCategory 𝒳'] {𝒴' : Type u₄} [SmallCategory 𝒴'] (F : 𝒳' ⥤ 𝒴') :
    (∀ (G : 𝒳'ᵒᵖ ⥤ Type u₄), F.op.HasPointwiseRightKanExtension G) ∧
      HasFiniteLimits (Type u₄) :=
  ⟨inferInstance, inferInstance⟩

end CategoryTheory.Functor

end
