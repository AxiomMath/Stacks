module

public import StacksCore.CategoryTheory.FiberedInGroupoidsEquiv
public import StacksFrontier.CategoryTheory.Sites.InheritedTopology.Stack
public import StacksFrontier.CategoryTheory.Sites.Stack.StackBridge.Dictionary

/-!
# Gluing in a stack in groupoids along a disjoint covering family

Let `p : 𝒮 ⥤ 𝒞` be a stack in groupoids over a site `(𝒞, J)`. Call an object `Z` of `𝒞`
*void* when the empty sieve covers it and every object mapping to it has at most one morphism to
any object (for the big fppf site: the underlying scheme is empty). Over a void object the fibre
of `p` is trivial, so every object of `𝒮` over a void object has at most one morphism to any
object of `𝒮`.

A covering family `{eᵢ : Vᵢ ⟶ E}` of monomorphisms whose pairwise fibre products `Vᵢ ×_E Vⱼ`,
`i ≠ j`, are void behaves like a disjoint union: fibre morphisms over the `Vᵢ` glue uniquely to a
fibre morphism over `E`, and objects over the `Vᵢ` glue to an object over `E`.

## Main definitions and results

* `CategoryTheory.Functor.IsVoid`: void objects of a site.
* `CategoryTheory.Functor.IsStackInGroupoids.hom_ext_of_isVoid`: morphisms out of an object over a
  void object are unique.
* `CategoryTheory.Functor.IsStackInGroupoids.existsUnique_glue_hom`: fibre morphisms glue
  uniquely along a disjoint covering family.
* `CategoryTheory.Functor.IsStackInGroupoids.exists_glue_obj`: objects glue along a disjoint
  covering family.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace CategoryTheory.Functor

universe w v₁ u₁ v₂ u₂

variable {𝒞 : Type u₁} [Category.{v₁} 𝒞] {𝒮 : Type u₂} [Category.{v₂} 𝒮]
  {p : 𝒮 ⥤ 𝒞} {J : GrothendieckTopology 𝒞}

/-- An object of a site is *void* when the empty sieve covers it and every object mapping to it
has at most one morphism to any object. -/
def IsVoid (J : GrothendieckTopology 𝒞) (Z : 𝒞) : Prop :=
  (⊥ : Sieve Z) ∈ J Z ∧ ∀ ⦃Z' : 𝒞⦄ (_ : Z' ⟶ Z) (T : 𝒞), Subsingleton (Z' ⟶ T)

/-- An object mapping to a void object is void. -/
theorem IsVoid.of_hom {Z Z' : 𝒞} (h : IsVoid J Z) (f : Z' ⟶ Z) : IsVoid J Z' :=
  ⟨by simpa using J.pullback_stable f h.1, fun _ g T ↦ h.2 (g ≫ f) T⟩

/-- A family `{eᵢ : Vᵢ ⟶ E}` is a *disjoint covering family* when it generates a covering sieve,
its members are monomorphisms, and two distinct members only meet over void objects. -/
def IsDisjointCover (J : GrothendieckTopology 𝒞) {E : 𝒞} {I : Type*} (V : I → 𝒞)
    (e : ∀ i, V i ⟶ E) : Prop :=
  Sieve.ofArrows V e ∈ J E ∧ (∀ i, Mono (e i)) ∧
    ∀ i j, i ≠ j → ∀ ⦃Z : 𝒞⦄ (a : Z ⟶ V i) (b : Z ⟶ V j), a ≫ e i = b ≫ e j → IsVoid J Z

/-- **A base change of a disjoint covering family is a disjoint covering family.** -/
theorem IsDisjointCover.of_isPullback {E T : 𝒞} {I : Type*} {V : I → 𝒞} {e : ∀ i, V i ⟶ E}
    (h : IsDisjointCover J V e) (f : T ⟶ E) {W : I → 𝒞} (b : ∀ i, W i ⟶ T) (c : ∀ i, W i ⟶ V i)
    (hb : ∀ i, IsPullback (b i) (c i) f (e i)) : IsDisjointCover J W b := by
  refine ⟨J.superset_covering ?_ (J.pullback_stable f h.1), fun i ↦ ⟨fun u v huv ↦ ?_⟩,
    fun i j hij Z u v huv ↦ h.2.2 i j hij (u ≫ c i) (v ≫ c j) ?_⟩
  · rintro Z g ⟨Y, k, _, ⟨i⟩, hk⟩
    exact ⟨_, (hb i).lift g k hk.symm, b i, ⟨i⟩, (hb i).lift_fst _ _ _⟩
  · have := h.2.1 i
    refine (hb i).hom_ext huv ((cancel_mono (e i)).1 ?_)
    rw [Category.assoc, Category.assoc, ← (hb i).w, ← Category.assoc, huv, Category.assoc]
  · rw [Category.assoc, Category.assoc, ← (hb i).w, ← (hb j).w, ← Category.assoc, huv,
      Category.assoc]

/-- A fibre morphism is a morphism lying over the identity. -/
theorem fibreHom_iff {U : 𝒞} {a b : 𝒮} (ha : p.obj a = U) (hb : p.obj b = U) (φ : a ⟶ b) :
    FibreHom p a b ha hb φ ↔ p.IsHomLift (𝟙 U) φ := by
  refine ⟨fun h ↦ ?_, fun h ↦ ?_⟩
  · have : p.IsHomLift (eqToHom ha ≫ eqToHom hb.symm) φ := h
    exact IsHomLift.of_fac' p (𝟙 U) φ ha hb
      (by simpa using IsHomLift.fac' p (eqToHom ha ≫ eqToHom hb.symm) φ)
  · exact IsHomLift.of_fac' p (eqToHom ha ≫ eqToHom hb.symm) φ rfl rfl
      (by simpa using IsHomLift.fac' p (𝟙 U) φ)

/-- In a category fibred in groupoids a fibre morphism is an isomorphism. -/
theorem isIso_of_fibreHom (hp : p.IsFiberedInGroupoids) {U : 𝒞} {a b : 𝒮} {ha : p.obj a = U}
    {hb : p.obj b = U} {φ : a ⟶ b} (h : FibreHom p a b ha hb φ) : IsIso φ := by
  have : p.IsHomLift (𝟙 U) φ := (fibreHom_iff ha hb φ).1 h
  have := hp.isStronglyCartesian_homLift (𝟙 U) φ
  exact IsStronglyCartesian.isIso_of_base_isIso p (𝟙 U) φ

/-- The sieve generated by the empty family is the empty sieve. -/
theorem ofArrows_pEmpty_eq_bot {Z : 𝒞} :
    Sieve.ofArrows (PEmpty.elim : PEmpty.{w + 1} → 𝒞) (fun i ↦ PEmpty.elim i : ∀ _i, _ ⟶ Z) =
      ⊥ := by
  ext Y g
  simp only [Sieve.bot_apply, iff_false]
  rintro ⟨_, _, _, ⟨i⟩, _⟩
  exact i.elim

/-- The canonical comparison between restrictions only depends on the base morphism. -/
theorem compTo_congr {W V U : 𝒞} {g g' : W ⟶ V} (hg : g = g') {f : V ⟶ U} {h : W ⟶ U}
    (hh : h = g ≫ f) (hh' : h = g' ≫ f) {x : 𝒮} {hx : p.obj x = U}
    (xr : Restriction p f x hx) (xrW : Restriction p h x hx) :
    Restriction.compTo p g f hh xr xrW = Restriction.compTo p g' f hh' xr xrW := by
  subst hg
  rfl

/-- In a category fibred in groupoids, every fibre morphism has a canonical restriction along
every base morphism. -/
theorem exists_isRestrictionOf (hp : p.IsFiberedInGroupoids) {W V Ux Uy : 𝒞} (g : W ⟶ V)
    {fx : V ⟶ Ux} {fy : V ⟶ Uy} {hx_ : W ⟶ Ux} {hy_ : W ⟶ Uy} (hfx : hx_ = g ≫ fx)
    (hfy : hy_ = g ≫ fy) {x y : 𝒮} {hx : p.obj x = Ux} {hy : p.obj y = Uy}
    (xr : Restriction p fx x hx) (yr : Restriction p fy y hy) (xrW : Restriction p hx_ x hx)
    (yrW : Restriction p hy_ y hy) (α : xr.pt ⟶ yr.pt)
    (hα : FibreHom p xr.pt yr.pt xr.hpt yr.hpt α) :
    ∃ β : xrW.pt ⟶ yrW.pt, FibreHom p xrW.pt yrW.pt xrW.hpt yrW.hpt β ∧
      IsRestrictionOf p g hfx hfy xr yr xrW yrW α β := by
  have : p.IsFibered := hp.isFibered
  have := Restriction.isHomLift_compTo g fy hfy yr yrW
  have := Restriction.isHomLift_compTo g fx hfx xr xrW
  have : p.IsHomLift (𝟙 V) α := (fibreHom_iff _ _ α).1 hα
  have := hp.isStronglyCartesian_homLift g (Restriction.compTo p g fy hfy yr yrW)
  refine ⟨IsStronglyCartesian.map p g (Restriction.compTo p g fy hfy yr yrW)
    (Category.id_comp g).symm (Restriction.compTo p g fx hfx xr xrW ≫ α), ?_, ?_⟩
  · exact (fibreHom_iff _ _ _).2 inferInstance
  · exact IsStronglyCartesian.fac p g _ _ _

/-- A fibre morphism into a restriction is determined by its composite with the restriction. -/
theorem Restriction.fibreHom_ext {V U : 𝒞} {f : V ⟶ U} {x : 𝒮} {hx : p.obj x = U}
    (R : Restriction p f x hx) {a : 𝒮} {β β' : a ⟶ R.pt} (hβ : p.IsHomLift (𝟙 V) β)
    (hβ' : p.IsHomLift (𝟙 V) β') (h : β ≫ R.hom = β' ≫ R.hom) : β = β' := by
  have := R.isStronglyCartesian_hom
  exact IsStronglyCartesian.ext p f R.hom (𝟙 V) h

/-- A fibre morphism between two restrictions of one object which is compatible with the two
restriction morphisms has compatible canonical restrictions. -/
theorem canonical_of_isRestrictionOf {W V U : 𝒞} {g : W ⟶ V} {fx : V ⟶ U} {fy : V ⟶ U}
    {hx_ : W ⟶ U} {hy_ : W ⟶ U} {hfx : hx_ = g ≫ fx} {hfy : hy_ = g ≫ fy} {x : 𝒮}
    {hx : p.obj x = U} {xr : Restriction p fx x hx} {yr : Restriction p fy x hx}
    {xrW : Restriction p hx_ x hx} {yrW : Restriction p hy_ x hx} {α : xr.pt ⟶ yr.pt}
    {β : xrW.pt ⟶ yrW.pt} (h : IsRestrictionOf p g hfx hfy xr yr xrW yrW α β)
    (hα : α ≫ yr.hom = xr.hom) : β ≫ yrW.hom = xrW.hom := by
  have h' : β ≫ Restriction.compTo p g fy hfy yr yrW = Restriction.compTo p g fx hfx xr xrW ≫ α :=
    h
  calc β ≫ yrW.hom = β ≫ Restriction.compTo p g fy hfy yr yrW ≫ yr.hom := by
        rw [Restriction.compTo_hom]
    _ = (Restriction.compTo p g fx hfx xr xrW ≫ α) ≫ yr.hom := by rw [← Category.assoc, h']
    _ = xrW.hom := by rw [Category.assoc, hα, Restriction.compTo_hom]

/-- A morphism lying over `f` factors through a strongly cartesian morphism over `f` by a fibre
morphism. -/
private theorem exists_homLift_id_comp_eq {R S : 𝒞} {f : R ⟶ S} {a b y : 𝒮} {φ : b ⟶ y}
    (hφ : p.IsStronglyCartesian f φ) {ψ : a ⟶ y} (hψ : p.IsHomLift f ψ) :
    ∃ χ : a ⟶ b, p.IsHomLift (𝟙 R) χ ∧ χ ≫ φ = ψ :=
  ⟨IsStronglyCartesian.map p f φ (Category.id_comp f).symm ψ,
    IsStronglyCartesian.map_isHomLift _ _ _ _ _, IsStronglyCartesian.fac _ _ _ _ _⟩

namespace IsStackInGroupoids

variable (hst : p.IsStackInGroupoids.{w} J)
include hst

/-- **The fibre over an object covered by the empty sieve is trivial**: between two objects over
it there is a fibre morphism, and only one. -/
theorem fibreHom_of_bot {Z : 𝒞} (hZ : (⊥ : Sieve Z) ∈ J Z) {a b : 𝒮} (ha : p.obj a = Z)
    (hb : p.obj b = Z) :
    (∃ g : a ⟶ b, FibreHom p a b ha hb g) ∧
      ∀ g g' : a ⟶ b, FibreHom p a b ha hb g → FibreHom p a b ha hb g' → g = g' := by
  have H := hst.isom_isSheaf a b ha hb (I := PEmpty.{w + 1}) PEmpty.elim (fun i ↦ PEmpty.elim i)
    (by rwa [ofArrows_pEmpty_eq_bot]) (fun i ↦ PEmpty.elim i) (fun i ↦ PEmpty.elim i)
    (fun i ↦ PEmpty.elim i) (fun i ↦ PEmpty.elim i) (fun i ↦ PEmpty.elim i)
    (fun i ↦ PEmpty.elim i) (fun i ↦ PEmpty.elim i) (fun i ↦ PEmpty.elim i)
  obtain ⟨g, ⟨hg, -, -⟩, huniq⟩ := H (fun i ↦ PEmpty.elim i) (fun i ↦ PEmpty.elim i)
    (fun i ↦ PEmpty.elim i) (fun i ↦ PEmpty.elim i)
  refine ⟨⟨g, hg⟩, fun u v hu hv ↦ ?_⟩
  rw [huniq u ⟨hu, isIso_of_fibreHom hst.isFiberedInGroupoids hu, fun i ↦ i.elim⟩,
    huniq v ⟨hv, isIso_of_fibreHom hst.isFiberedInGroupoids hv, fun i ↦ i.elim⟩]

/-- **Morphisms out of an object over a void object are unique.** -/
theorem hom_ext_of_isVoid {Z : 𝒞} (hZ : IsVoid J Z) {a y : 𝒮} (ha : p.obj a = Z)
    (u v : a ⟶ y) : u = v := by
  have hZ' := hZ.of_hom (eqToHom ha)
  have hb : p.map u = p.map v := by
    have := hZ'.2 (𝟙 _) (p.obj y)
    exact Subsingleton.elim _ _
  let yr := Restriction.ofIsFiberedInGroupoids p hst.isFiberedInGroupoids (p.map u) y rfl
  have : p.IsHomLift (p.map u) v := by rw [hb]; infer_instance
  obtain ⟨u', hu', hu'w⟩ := exists_homLift_id_comp_eq yr.isStronglyCartesian_hom
    (inferInstance : p.IsHomLift (p.map u) u)
  obtain ⟨v', hv', hv'w⟩ := exists_homLift_id_comp_eq yr.isStronglyCartesian_hom this
  rw [← hu'w, ← hv'w, (hst.fibreHom_of_bot hZ'.1 rfl yr.hpt).2 u' v'
    ((fibreHom_iff _ _ _).2 hu') ((fibreHom_iff _ _ _).2 hv')]

variable [HasPullbacks 𝒞] {E : 𝒞} {I : Type w} {V : I → 𝒞} {e : ∀ i, V i ⟶ E}

/-- Along a family of monomorphisms with void pairwise overlaps, every family of fibre morphisms
is compatible on the overlaps. -/
theorem compat_of_disjoint (hmono : ∀ i, Mono (e i))
    (hdisj : ∀ i j, i ≠ j → IsVoid J (pullback (e i) (e j))) {x y : 𝒮} {hx : p.obj x = E}
    {hy : p.obj y = E} (xr : ∀ i, Restriction p (e i) x hx) (yr : ∀ i, Restriction p (e i) y hy)
    (xrij : ∀ i j, Restriction p (pullback.fst (e i) (e j) ≫ e i) x hx)
    (yrij : ∀ i j, Restriction p (pullback.fst (e i) (e j) ≫ e i) y hy)
    (φ : ∀ i, (xr i).pt ⟶ (yr i).pt) (hφ : ∀ i, FibreHom p _ _ (xr i).hpt (yr i).hpt (φ i))
    (i j : I) :
    ∃ γ : (xrij i j).pt ⟶ (yrij i j).pt,
      FibreHom p _ _ (xrij i j).hpt (yrij i j).hpt γ ∧
      IsRestrictionOf p (pullback.fst (e i) (e j)) rfl rfl (xr i) (yr i) (xrij i j) (yrij i j)
        (φ i) γ ∧
      IsRestrictionOf p (pullback.snd (e i) (e j)) (IsPullback.of_hasPullback (e i) (e j)).w
        (IsPullback.of_hasPullback (e i) (e j)).w (xr j) (yr j) (xrij i j) (yrij i j) (φ j) γ := by
  obtain ⟨γ, hγ, hr⟩ := exists_isRestrictionOf hst.isFiberedInGroupoids
    (pullback.fst (e i) (e j)) rfl rfl (xr i) (yr i) (xrij i j) (yrij i j) (φ i) (hφ i)
  refine ⟨γ, hγ, hr, ?_⟩
  by_cases hij : i = j
  · subst hij
    have := hmono i
    have hpr := fst_eq_snd_of_mono_eq (e i)
    have e₁ := compTo_congr (p := p) hpr rfl (IsPullback.of_hasPullback (e i) (e i)).w (yr i)
      (yrij i i)
    have e₂ := compTo_congr (p := p) hpr rfl (IsPullback.of_hasPullback (e i) (e i)).w (xr i)
      (xrij i i)
    show γ ≫ Restriction.compTo p _ _ _ (yr i) (yrij i i) =
      Restriction.compTo p _ _ _ (xr i) (xrij i i) ≫ φ i
    rw [← e₁, ← e₂]
    exact hr
  · exact hst.hom_ext_of_isVoid (hdisj i j hij) (xrij i j).hpt _ _

/-- **Fibre morphisms glue uniquely along a disjoint covering family of monomorphisms.** -/
theorem existsUnique_glue_hom (hcov : Sieve.ofArrows V e ∈ J E) (hmono : ∀ i, Mono (e i))
    (hdisj : ∀ i j, i ≠ j → IsVoid J (pullback (e i) (e j))) {a b : 𝒮} (ha : p.obj a = E)
    (hb : p.obj b = E) (a' b' : I → 𝒮) (α : ∀ i, a' i ⟶ a) (β : ∀ i, b' i ⟶ b)
    (hα : ∀ i, p.IsHomLift (e i) (α i)) (hβ : ∀ i, p.IsHomLift (e i) (β i))
    (θ : ∀ i, a' i ⟶ b' i) (hθ : ∀ i, p.IsHomLift (𝟙 (V i)) (θ i)) :
    ∃! θ' : a ⟶ b, p.IsHomLift (𝟙 E) θ' ∧ ∀ i, α i ≫ θ' = θ i ≫ β i := by
  have hp := hst.isFiberedInGroupoids
  let xr : ∀ i, Restriction p (e i) a ha := fun i ↦
    Restriction.ofCartesian (IsHomLift.domain_eq p (e i) (α i)) ha (α i)
      (hp.isStronglyCartesian_homLift (e i) (α i))
  let yr : ∀ i, Restriction p (e i) b hb := fun i ↦
    Restriction.ofCartesian (IsHomLift.domain_eq p (e i) (β i)) hb (β i)
      (hp.isStronglyCartesian_homLift (e i) (β i))
  let xrij : ∀ i j, Restriction p (pullback.fst (e i) (e j) ≫ e i) a ha := fun i j ↦
    Restriction.ofIsFiberedInGroupoids p hp _ a ha
  let yrij : ∀ i j, Restriction p (pullback.fst (e i) (e j) ≫ e i) b hb := fun i j ↦
    Restriction.ofIsFiberedInGroupoids p hp _ b hb
  have hφ : ∀ i, FibreHom p _ _ (xr i).hpt (yr i).hpt (θ i) := fun i ↦
    (fibreHom_iff _ _ _).2 (hθ i)
  obtain ⟨g, ⟨hg, -, hgw⟩, huniq⟩ := hst.isom_isSheaf a b ha hb V e hcov
    (fun i j ↦ pullback (e i) (e j)) (fun i j ↦ pullback.fst _ _) (fun i j ↦ pullback.snd _ _)
    (fun i j ↦ IsPullback.of_hasPullback _ _) xr yr xrij yrij θ hφ
    (fun i ↦ isIso_of_fibreHom hp (hφ i))
    (hst.compat_of_disjoint hmono hdisj xr yr xrij yrij θ hφ)
  refine ⟨g, ⟨(fibreHom_iff _ _ _).1 hg, hgw⟩, fun g' ⟨h₁, h₂⟩ ↦ ?_⟩
  have h₁' : FibreHom p a b ha hb g' := (fibreHom_iff _ _ _).2 h₁
  exact huniq g' ⟨h₁', isIso_of_fibreHom hp h₁', h₂⟩

/-- Over the overlap of two members of a family of monomorphisms with void pairwise overlaps,
two restrictions of objects over the members are related by a fibre morphism, which is the
canonical comparison when the two members coincide. -/
private theorem exists_fibreHom_pullback (hmono : ∀ i, Mono (e i))
    (hdisj : ∀ i j, i ≠ j → IsVoid J (pullback (e i) (e j))) (a : I → 𝒮)
    (ha : ∀ i, p.obj (a i) = V i) {i j : I}
    (xrij : Restriction p (pullback.fst (e i) (e j)) (a i) (ha i))
    (xrji : Restriction p (pullback.snd (e i) (e j)) (a j) (ha j)) :
    ∃ φ : xrij.pt ⟶ xrji.pt, FibreHom p _ _ xrij.hpt xrji.hpt φ ∧
      ∀ h : i = j, φ ≫ xrji.hom = xrij.hom ≫ eqToHom (congrArg a h) := by
  by_cases hij : i = j
  · subst hij
    have := hmono i
    have hpr := fst_eq_snd_of_mono_eq (e i)
    have := xrji.isStronglyCartesian_hom
    have : p.IsHomLift (pullback.fst (e i) (e i)) xrij.hom := xrij.isHomLift_hom
    refine ⟨IsStronglyCartesian.map p (pullback.snd (e i) (e i)) xrji.hom
      (show pullback.fst (e i) (e i) = 𝟙 _ ≫ pullback.snd (e i) (e i) by
        rw [hpr, Category.id_comp]) xrij.hom, (fibreHom_iff _ _ _).2 inferInstance,
      fun _ ↦ ?_⟩
    rw [eqToHom_refl, Category.comp_id]
    exact IsStronglyCartesian.fac _ _ _ _ _
  · obtain ⟨φ, hφ⟩ := (hst.fibreHom_of_bot (hdisj i j hij).1 xrij.hpt xrji.hpt).1
    exact ⟨φ, hφ, fun h ↦ (hij h).elim⟩

/-- **Objects glue along a disjoint covering family of monomorphisms**: objects over the members
of the family are the restrictions of one object over the target. -/
theorem exists_glue_obj (hcov : Sieve.ofArrows V e ∈ J E) (hmono : ∀ i, Mono (e i))
    (hdisj : ∀ i j, i ≠ j → IsVoid J (pullback (e i) (e j))) (a : I → 𝒮)
    (ha : ∀ i, p.obj (a i) = V i) :
    ∃ (z : 𝒮) (_ : p.obj z = E) (ζ : ∀ i, a i ⟶ z), ∀ i, p.IsHomLift (e i) (ζ i) := by
  have hp := hst.isFiberedInGroupoids
  let xrij : ∀ i j, Restriction p (pullback.fst (e i) (e j)) (a i) (ha i) := fun i j ↦
    Restriction.ofIsFiberedInGroupoids p hp _ _ _
  let xrji : ∀ i j, Restriction p (pullback.snd (e i) (e j)) (a j) (ha j) := fun i j ↦
    Restriction.ofIsFiberedInGroupoids p hp _ _ _
  choose φ hφ hφc using fun i j ↦
    hst.exists_fibreHom_pullback hmono hdisj a ha (xrij i j) (xrji i j)
  have hφc' : ∀ i, φ i i ≫ (xrji i i).hom = (xrij i i).hom := fun i ↦ by
    simpa using hφc i i rfl
  let q₁ : ∀ i j k, pullback (pullback.snd (e i) (e j)) (pullback.fst (e j) (e k)) ⟶ V i :=
    fun i j k ↦ pullback.fst (pullback.snd (e i) (e j)) (pullback.fst (e j) (e k)) ≫
      pullback.fst (e i) (e j)
  let q₂ : ∀ i j k, pullback (pullback.snd (e i) (e j)) (pullback.fst (e j) (e k)) ⟶ V j :=
    fun i j k ↦ pullback.fst (pullback.snd (e i) (e j)) (pullback.fst (e j) (e k)) ≫
      pullback.snd (e i) (e j)
  let q₃ : ∀ i j k, pullback (pullback.snd (e i) (e j)) (pullback.fst (e j) (e k)) ⟶ V k :=
    fun i j k ↦ pullback.snd (pullback.snd (e i) (e j)) (pullback.fst (e j) (e k)) ≫
      pullback.snd (e j) (e k)
  have hq : ∀ i j k, q₁ i j k ≫ e i = q₃ i j k ≫ e k := by
    intro i j k
    simp only [q₁, q₃, Category.assoc]
    rw [pullback.condition (f := e i) (g := e j), ← Category.assoc, pullback.condition,
      Category.assoc, pullback.condition (f := e j) (g := e k)]
  let s₁₃ : ∀ i j k, pullback (pullback.snd (e i) (e j)) (pullback.fst (e j) (e k)) ⟶
      pullback (e i) (e k) := fun i j k ↦ pullback.lift (q₁ i j k) (q₃ i j k) (hq i j k)
  let wi : ∀ i j k, Restriction p (q₁ i j k) (a i) (ha i) := fun i j k ↦
    Restriction.ofIsFiberedInGroupoids p hp _ _ _
  let wj : ∀ i j k, Restriction p (q₂ i j k) (a j) (ha j) := fun i j k ↦
    Restriction.ofIsFiberedInGroupoids p hp _ _ _
  let wk : ∀ i j k, Restriction p (q₃ i j k) (a k) (ha k) := fun i j k ↦
    Restriction.ofIsFiberedInGroupoids p hp _ _ _
  choose αij hαijF hαijR using fun i j k ↦ exists_isRestrictionOf hp
    (pullback.fst (pullback.snd (e i) (e j)) (pullback.fst (e j) (e k)))
    (rfl : q₁ i j k = _) (rfl : q₂ i j k = _) (xrij i j) (xrji i j) (wi i j k) (wj i j k) (φ i j)
    (hφ i j)
  choose αjk hαjkF hαjkR using fun i j k ↦ exists_isRestrictionOf hp
    (pullback.snd (pullback.snd (e i) (e j)) (pullback.fst (e j) (e k)))
    (pullback.condition : q₂ i j k = _) (rfl : q₃ i j k = _) (xrij j k) (xrji j k) (wj i j k)
    (wk i j k) (φ j k) (hφ j k)
  choose αik hαikF hαikR using fun i j k ↦ exists_isRestrictionOf hp (s₁₃ i j k)
    (pullback.lift_fst _ _ _).symm (pullback.lift_snd _ _ _).symm (xrij i k) (xrji i k)
    (wi i j k) (wk i j k) (φ i k) (hφ i k)
  have hcoc : ∀ i j k, αik i j k = αij i j k ≫ αjk i j k := by
    intro i j k
    by_cases hij : i = j
    · by_cases hjk : j = k
      · subst hij hjk
        have h₁ := (fibreHom_iff _ _ _).1 (hαijF i i i)
        have h₂ := (fibreHom_iff _ _ _).1 (hαjkF i i i)
        have h₃ : p.IsHomLift (𝟙 (pullback (pullback.snd (e i) (e i)) (pullback.fst (e i) (e i))))
            (αij i i i ≫ αjk i i i) := inferInstance
        refine (wk i i i).fibreHom_ext ((fibreHom_iff _ _ _).1 (hαikF i i i)) h₃ ?_
        rw [canonical_of_isRestrictionOf (hαikR i i i) (hφc' i), Category.assoc,
          canonical_of_isRestrictionOf (hαjkR i i i) (hφc' i),
          canonical_of_isRestrictionOf (hαijR i i i) (hφc' i)]
      · exact hst.hom_ext_of_isVoid ((hdisj j k hjk).of_hom (pullback.snd _ _)) (wi i j k).hpt _ _
    · exact hst.hom_ext_of_isVoid ((hdisj i j hij).of_hom (pullback.fst _ _)) (wi i j k).hpt _ _
  let D : DescentDatum p V e (fun i j ↦ pullback (e i) (e j)) (fun i j ↦ pullback.fst (e i) (e j))
      (fun i j ↦ pullback.snd (e i) (e j)) (fun i j ↦ IsPullback.of_hasPullback (e i) (e j))
      (fun i j k ↦ pullback (pullback.snd (e i) (e j)) (pullback.fst (e j) (e k)))
      (fun i j k ↦ pullback.fst (pullback.snd (e i) (e j)) (pullback.fst (e j) (e k)))
      (fun i j k ↦ pullback.snd (pullback.snd (e i) (e j)) (pullback.fst (e j) (e k)))
      (fun i j k ↦ IsPullback.of_hasPullback _ _) q₁ q₂ q₃ (fun _ _ _ ↦ rfl)
      (fun _ _ _ ↦ rfl) (fun _ _ _ ↦ rfl) :=
    { x := a, hx := ha, xrij, xrji, φ, φ_fibreHom := hφ
      φ_iso := fun i j ↦ isIso_of_fibreHom hp (hφ i j)
      wi, wj, wk, αij, αjk, αik, αij_restr := hαijR, αjk_restr := hαjkR, s₁₃
      hs₁₃₁ := fun i j k ↦ pullback.lift_fst _ _ _
      hs₁₃₂ := fun i j k ↦ pullback.lift_snd _ _ _
      αik_restr := hαikR, cocycle := hcoc }
  obtain ⟨z, hz, xr, ψ, hψF, hψI, -⟩ :=
    hst.effective_descent V e hcov _ _ _ _ _ _ _ _ _ _ _ _ _ _ D
  refine ⟨z, hz, fun i ↦ CategoryTheory.inv (ψ i) ≫ (xr i).hom, fun i ↦ ?_⟩
  have := hψI i
  have : p.IsHomLift (𝟙 (V i)) (ψ i) := (fibreHom_iff _ _ _).1 (hψF i)
  have := (xr i).isHomLift_hom
  infer_instance

/-- **Morphisms glue uniquely along a disjoint covering family**: morphisms out of the
restrictions of `a` to the members of the family, lying over the composites with `g`, are the
restrictions of exactly one morphism out of `a` lying over `g`. -/
theorem existsUnique_glue_hom_over (hdc : IsDisjointCover J V e) {a y : 𝒮} (ha : p.obj a = E)
    {Y : 𝒞} (hy : p.obj y = Y) (g : E ⟶ Y) (a' : I → 𝒮) (α : ∀ i, a' i ⟶ a)
    (hα : ∀ i, p.IsHomLift (e i) (α i)) (h : ∀ i, a' i ⟶ y)
    (hh : ∀ i, p.IsHomLift (e i ≫ g) (h i)) :
    ∃! u : a ⟶ y, p.IsHomLift g u ∧ ∀ i, α i ≫ u = h i := by
  have hp := hst.isFiberedInGroupoids
  let b := Restriction.ofIsFiberedInGroupoids p hp g y hy
  have hc : p.IsStronglyCartesian g b.hom := b.isStronglyCartesian_hom
  let b' : ∀ i, Restriction p (e i) b.pt b.hpt := fun i ↦
    Restriction.ofIsFiberedInGroupoids p hp (e i) b.pt b.hpt
  have hβ : ∀ i, p.IsHomLift (e i) (b' i).hom := fun i ↦ (b' i).isHomLift_hom
  have hcomp : ∀ i, p.IsStronglyCartesian (e i ≫ g) ((b' i).hom ≫ b.hom) := fun i ↦ by
    have := (b' i).isStronglyCartesian_hom
    infer_instance
  choose θ hθ hθw using fun i ↦ exists_homLift_id_comp_eq (hcomp i) (hh i)
  obtain ⟨θ', ⟨hθ'l, hθ'w⟩, huniq⟩ := hst.existsUnique_glue_hom hdc.1 hdc.2.1
    (fun i j hij ↦ hdc.2.2 i j hij _ _ pullback.condition) ha b.hpt a' (fun i ↦ (b' i).pt) α
    (fun i ↦ (b' i).hom) hα hβ θ hθ
  refine ⟨θ' ≫ b.hom, ⟨?_, fun i ↦ ?_⟩, fun u ⟨hul, huw⟩ ↦ ?_⟩
  · have := hθ'l
    exact isHomLift_of_eq (inferInstance : p.IsHomLift (𝟙 E ≫ g) (θ' ≫ b.hom)) (Category.id_comp g)
  · rw [← Category.assoc, hθ'w, Category.assoc, hθw]
  · obtain ⟨θ'', hθ''l, hθ''w⟩ := exists_homLift_id_comp_eq hc hul
    have key : θ'' = θ' := huniq θ'' ⟨hθ''l, fun i ↦ ?_⟩
    · rw [← hθ''w, key]
    · have := hα i
      have := hθ i
      have := hβ i
      have : p.IsHomLift (e i) (α i ≫ θ'') := inferInstance
      have : p.IsHomLift (e i) (θ i ≫ (b' i).hom) := inferInstance
      refine IsStronglyCartesian.ext p g b.hom (e i) ?_
      rw [Category.assoc, hθ''w, huw, Category.assoc, hθw]

end IsStackInGroupoids

end CategoryTheory.Functor

