module

public import StacksFrontier.CategoryTheory.Sites.InheritedTopology.Functoriality
import StacksCore.Tactic.StacksAttribute

/-!
# A 1-morphism of fibred categories is continuous and cocontinuous, over any base

Let `(𝒞, J)` be a site, let `p : 𝒳 ⥤ 𝒞` be a functor and let `u : 𝒳' ⥤ 𝒳` be a functor such that
`u ⋙ p` is a fibred category and `u` carries strongly cartesian morphisms for `u ⋙ p` to strongly
cartesian morphisms for `p`. Endow `𝒳` and `𝒳'` with the topologies they inherit from `(𝒞, J)`
(Stacks 06NV). Then `u` is continuous and cocontinuous for those two topologies.

This is Stacks 06NW, but with **no fibre products assumed in the base**.
`CategoryTheory.Functor.IsFibredOneMorphism.isContinuous_and_isCocontinuous_inheritedTopology`
proves the same two conjuncts under `[HasPullbacks 𝒞]`, which it uses to transfer the sheaf
condition through the pairwise fibre products of a covering family (Stacks 06N5). A ringed site in
the sense of Stacks 03AD carries no fibre products, so that form cannot be threaded through the
construction of Stacks 08PA; the declarations below replace the fibre-product argument by the
universal property of strongly cartesian morphisms, which needs nothing of the base.

## Main results

* `CategoryTheory.Functor.isSheafFor_functorPullback_of_isFibredOneMorphism`: restriction along
  `u.op` of a presheaf on `𝒳` that is a sheaf for the `p`-pullback of a sieve `B` of the base is a
  sheaf for the `(u ⋙ p)`-pullback of `B`.
* `CategoryTheory.Functor.generate_mem_map_iff_of_isFibredOneMorphism`: a morphism of `𝒳'` lies in
  the sieve generated by a presieve of strongly cartesian morphisms exactly when its `u`-image
  lies in the sieve generated by the `u`-image presieve.
* `CategoryTheory.Functor.IsFibredOneMorphism.isContinuous_inheritedTopology` and
  `CategoryTheory.Functor.IsFibredOneMorphism.isCocontinuous_inheritedTopology`: the two conjuncts
  of Stacks 06NW for `u`, with no hypothesis on the base beyond its topology.

## Implementation notes

The hypothesis is spelled as `CategoryTheory.Functor.IsFibredOneMorphism`, whose first field is the
equality `u ⋙ p = p'`. The auxiliary results take it in the already-substituted form
`(u ⋙ p).IsFibredOneMorphism p u`, whose `comp_eq` field is `rfl` and whose second field is the
only content; the two conjuncts of Stacks 06NW then substitute `comp_eq` and apply them.

The sheaf-transfer lemma generalises
`Stacks.Sites.FibredCategory.isSheafFor_functorPullback_of_isFibered`, which is its case
`𝒳 = 𝒞`, `p = 𝟭 𝒞`, `u = p'`: there every morphism of `𝒞` is strongly cartesian for `𝟭 𝒞`, so the
hypothesis on `u` is vacuous and `B.functorPullback (𝟭 𝒞)` is `B`.

## References

* [Stacks Project, Tag 06NW](https://stacks.math.columbia.edu/tag/06NW)
* [Stacks Project, Tag 08PA](https://stacks.math.columbia.edu/tag/08PA)
-/

@[expose] public section

open CategoryTheory Limits

universe w v₁ v₂ v₃ u₁ u₂ u₃

namespace CategoryTheory.Functor

variable {𝒞 : Type u₁} [Category.{v₁} 𝒞] {𝒳 : Type u₂} [Category.{v₂} 𝒳]
  {𝒳' : Type u₃} [Category.{v₃} 𝒳']

/-- Mapping a presieve along two functors in turn is mapping it along their composition. -/
theorem Presieve.map_comp_eq (u : 𝒳' ⥤ 𝒳) (p : 𝒳 ⥤ 𝒞) {X' : 𝒳'} (R : Presieve X') :
    (R.map u).map p = R.map (u ⋙ p) := by
  funext V f
  refine propext ⟨?_, ?_⟩
  · rintro ⟨⟨hg⟩⟩
    exact Presieve.map_map hg
  · rintro ⟨hg⟩
    exact Presieve.map_map (Presieve.map_map hg)

universe v₄ u₄

section Auxiliary

variable {𝒜 : Type u₄} [Category.{v₄} 𝒜]

/-- A morphism lies in the sieve generated by a presieve of strongly cartesian morphisms exactly
when its image lies in the sieve generated by the image presieve. -/
theorem generate_arrows_map_iff (r : 𝒜 ⥤ 𝒞) {X Y : 𝒜} (R : Presieve X)
    (hcart : ∀ ⦃Z : 𝒜⦄ (g : Z ⟶ X), R g → r.IsStronglyCartesian (r.map g) g) (f : Y ⟶ X) :
    (Sieve.generate R).arrows f ↔ (Sieve.generate (R.map r)).arrows (r.map f) := by
  refine ⟨?_, ?_⟩
  · rintro ⟨Z, a, g, hg, rfl⟩
    have hgen : (Sieve.generate (R.map r)).arrows (r.map g) :=
      Sieve.le_generate (R.map r) _ _ (Presieve.map_map hg)
    simpa only [← r.map_comp] using
      Sieve.downward_closed (Sieve.generate (R.map r)) hgen (r.map a)
  · rintro ⟨W, a, b, hb, hab⟩
    obtain ⟨Z, rfl, g, hg, hrg⟩ := (Presieve.map_iff).mp hb
    have hbase : r.map f = a ≫ r.map g := by
      rw [← hab, hrg]
      simp
    have := hcart g hg
    obtain ⟨k, ⟨-, hk⟩, -⟩ :=
      IsStronglyCartesian.universal_property r (r.map g) g a (r.map f) hbase f
    exact ⟨Z, k, g, hg, hk⟩

end Auxiliary

section Transfer

variable (p : 𝒳 ⥤ 𝒞) (u : 𝒳' ⥤ 𝒳) [(u ⋙ p).IsFibered]
  (hu : (u ⋙ p).IsFibredOneMorphism p u)

variable {X' : 𝒳'}

/-- The chosen strongly cartesian lift in `𝒳'`, at an object `X'`, of a morphism of the base with
target `(u ⋙ p).obj X'`. It exists because `u ⋙ p` is a fibred category. -/
noncomputable abbrev cartLift {V : 𝒞} (w : V ⟶ p.obj (u.obj X')) :
    IsPreFibered.pullbackObj (p := u ⋙ p) (a := X') rfl w ⟶ X' :=
  IsPreFibered.pullbackMap (p := u ⋙ p) (a := X') rfl w

/-- The chosen lift is strongly cartesian for `u ⋙ p` over the morphism it lifts. -/
theorem cartLift_isStronglyCartesian {V : 𝒞} (w : V ⟶ p.obj (u.obj X')) :
    (u ⋙ p).IsStronglyCartesian w (cartLift p u (X' := X') w) := by
  let _ : (u ⋙ p).IsCartesian w (cartLift p u (X' := X') w) := inferInstance
  infer_instance

/-- The `(u ⋙ p)`-image of the chosen lift of a member of a sieve of the base is in that sieve. -/
private theorem map_cartLift_mem (B : Sieve (p.obj (u.obj X'))) {V : 𝒞}
    {b : V ⟶ p.obj (u.obj X')} (hb : B.arrows b) :
    (B.functorPullback (u ⋙ p)).arrows (cartLift p u (X' := X') b) := by
  have := cartLift_isStronglyCartesian p u (X' := X') b
  change B.arrows ((u ⋙ p).map _)
  rw [map_eq_eqToHom_comp_of_isHomLift (u ⋙ p) b (cartLift p u b)]
  exact B.downward_closed hb _

include hu

/-- The `u`-image of the chosen lift is strongly cartesian for `p`. -/
theorem map_cartLift_isStronglyCartesian {V : 𝒞} (w : V ⟶ p.obj (u.obj X')) :
    p.IsStronglyCartesian w (u.map (cartLift p u (X' := X') w)) :=
  hu.map_isStronglyCartesian w _ (cartLift_isStronglyCartesian p u w)

/-- The comparison of a morphism `h` of `𝒳` with the `u`-image of the chosen cartesian lift of its
base morphism: the unique morphism over the identity of the base through which `h` factors. -/
noncomputable def toCartLift {V : 𝒳} (h : V ⟶ u.obj X') :
    V ⟶ u.obj (IsPreFibered.pullbackObj (p := u ⋙ p) (a := X') rfl (p.map h)) :=
  haveI := map_cartLift_isStronglyCartesian p u hu (X' := X') (p.map h)
  IsStronglyCartesian.map p (p.map h) (u.map (cartLift p u (X' := X') (p.map h)))
    (g := 𝟙 _) (Category.id_comp _).symm h

/-- The comparison morphism lies over the identity of the base. -/
theorem toCartLift_isHomLift {V : 𝒳} (h : V ⟶ u.obj X') :
    p.IsHomLift (𝟙 (p.obj V)) (toCartLift p u hu h) := by
  have := map_cartLift_isStronglyCartesian p u hu (X' := X') (p.map h)
  exact IsStronglyCartesian.map_isHomLift p _ _ _ _

/-- The comparison morphism factors the given morphism through the `u`-image of the chosen lift. -/
@[simp] theorem toCartLift_comp {V : 𝒳} (h : V ⟶ u.obj X') :
    toCartLift p u hu h ≫ u.map (cartLift p u (X' := X') (p.map h)) = h := by
  have := map_cartLift_isStronglyCartesian p u hu (X' := X') (p.map h)
  exact IsStronglyCartesian.fac p _ _ _ _

/-- The comparison morphism is the only morphism over the identity of the base which factors the
given morphism through the `u`-image of the chosen lift. -/
theorem toCartLift_uniq {V : 𝒳} (h : V ⟶ u.obj X')
    (c : V ⟶ u.obj (IsPreFibered.pullbackObj (p := u ⋙ p) (a := X') rfl (p.map h)))
    (hcHom : p.IsHomLift (𝟙 (p.obj V)) c)
    (hc : c ≫ u.map (cartLift p u (X' := X') (p.map h)) = h) :
    c = toCartLift p u hu h := by
  have := map_cartLift_isStronglyCartesian p u hu (X' := X') (p.map h)
  have := hcHom
  have := toCartLift_isHomLift p u hu h
  exact IsStronglyCartesian.ext p (p.map h) _ (𝟙 (p.obj V)) (by rw [hc, toCartLift_comp])

omit hu in
/-- The chosen cartesian lift of the base morphism of a member of the `p`-pullback of a sieve of
the base is a member of its `(u ⋙ p)`-pullback. -/
theorem cartLift_mem_functorPullback (B : Sieve (p.obj (u.obj X'))) {V : 𝒳} (h : V ⟶ u.obj X')
    (hh : (B.functorPullback p).arrows h) :
    (B.functorPullback (u ⋙ p)).arrows (cartLift p u (X' := X') (p.map h)) :=
  map_cartLift_mem p u B hh

/-- **The sheaf-transfer step of Stacks 06NW for a 1-morphism, over any base.** Let `B` be a sieve
of the base on `(u ⋙ p).obj X'` and let `G` be a presheaf on `𝒳` that is a sheaf for the
`p`-pullback of `B`. Then the restriction of `G` along `u.op` is a sheaf for the
`(u ⋙ p)`-pullback of `B`. -/
theorem isSheafFor_functorPullback_of_isFibredOneMorphism
    (B : Sieve (p.obj (u.obj X'))) (G : 𝒳ᵒᵖ ⥤ Type w)
    (hG : Presieve.IsSheafFor G (B.functorPullback p).arrows) :
    Presieve.IsSheafFor (u.op ⋙ G) (B.functorPullback (u ⋙ p)).arrows := by
  have lift_mem : ∀ {V : 𝒳} (h : V ⟶ u.obj X'), (B.functorPullback p).arrows h →
      (B.functorPullback (u ⋙ p)).arrows (cartLift p u (X' := X') (p.map h)) :=
    fun {_} h hh => cartLift_mem_functorPullback p u B h hh
  intro x hx
  let y : (B.functorPullback p).arrows.FamilyOfElements G := fun {V} h hh =>
    G.map (toCartLift p u hu h).op (x _ (lift_mem h hh))
  have compat : ∀ {Y Z : 𝒳'} (k : Y ⟶ Z) (gZ : Z ⟶ X') (gY : Y ⟶ X')
      (hZ : (B.functorPullback (u ⋙ p)).arrows gZ) (hY : (B.functorPullback (u ⋙ p)).arrows gY),
      k ≫ gZ = gY → G.map (u.map k).op (x gZ hZ) = x gY hY := by
    intro Y Z k gZ gY hZ hY hk
    have h0 := hx k (𝟙 _) hZ hY (by rw [hk, Category.id_comp])
    simpa using h0
  have step : ∀ {Z V : 𝒳} (h : Z ⟶ u.obj X') (hmem : (B.functorPullback p).arrows h)
      (hV : V ⟶ u.obj X') (hhV : (B.functorPullback p).arrows hV)
      (a : Z ⟶ V), a ≫ hV = h →
      G.map a.op (y hV hhV) = G.map (toCartLift p u hu h).op (x _ (lift_mem h hmem)) := by
    intro Z V h hmem hV hhV a ha
    have := cartLift_isStronglyCartesian p u (X' := X') (p.map hV)
    have := cartLift_isStronglyCartesian p u (X' := X') (p.map h)
    have := map_cartLift_isStronglyCartesian p u hu (X' := X') (p.map hV)
    have hbase : p.map h = p.map a ≫ p.map hV := by rw [← p.map_comp, ha]
    let k := IsStronglyCartesian.map (u ⋙ p) (p.map hV) (cartLift p u (X' := X') (p.map hV))
      hbase (cartLift p u (X' := X') (p.map h))
    have hk : k ≫ cartLift p u (X' := X') (p.map hV) = cartLift p u (X' := X') (p.map h) :=
      IsStronglyCartesian.fac (u ⋙ p) _ _ _ _
    have hcompat : G.map (u.map k).op (x _ (lift_mem hV hhV)) = x _ (lift_mem h hmem) :=
      compat k _ _ _ _ hk
    have hroute : a ≫ toCartLift p u hu hV = toCartLift p u hu h ≫ u.map k := by
      have := toCartLift_isHomLift p u hu hV
      have := toCartLift_isHomLift p u hu h
      have : (u ⋙ p).IsHomLift (p.map a) k := IsStronglyCartesian.map_isHomLift (u ⋙ p) _ _ _ _
      have : p.IsHomLift (p.map a) (u.map k) := isHomLift_map_of_comp_eq (q := p) rfl _ k
      refine IsStronglyCartesian.ext p (p.map hV)
        (u.map (cartLift p u (X' := X') (p.map hV))) (p.map a) ?_
      rw [Category.assoc, Category.assoc, toCartLift_comp, ← u.map_comp, hk,
        toCartLift_comp, ha]
    calc G.map a.op (y hV hhV)
        = G.map (a ≫ toCartLift p u hu hV).op (x _ (lift_mem hV hhV)) :=
          (Functor.map_comp_apply G (toCartLift p u hu hV).op a.op _).symm
      _ = G.map (toCartLift p u hu h ≫ u.map k).op (x _ (lift_mem hV hhV)) := by rw [hroute]
      _ = G.map (toCartLift p u hu h).op (G.map (u.map k).op (x _ (lift_mem hV hhV))) :=
          Functor.map_comp_apply G (u.map k).op (toCartLift p u hu h).op _
      _ = G.map (toCartLift p u hu h).op (x _ (lift_mem h hmem)) := congrArg _ hcompat
  have hy : y.Compatible := by
    intro V₁ V₂ Z a₁ a₂ h₁ h₂ hh₁ hh₂ hcomm
    have hmem : (B.functorPullback p).arrows (a₁ ≫ h₁) :=
      (B.functorPullback p).downward_closed hh₁ _
    rw [step (a₁ ≫ h₁) hmem h₁ hh₁ a₁ rfl, step (a₁ ≫ h₁) hmem h₂ hh₂ a₂ hcomm.symm]
  obtain ⟨t, ht, huniq⟩ := hG y hy
  have amalg : ∀ (t' : (u.op ⋙ G).obj (Opposite.op X')),
      x.IsAmalgamation t' → y.IsAmalgamation t' := by
    intro t' ht' V h hh
    change G.map h.op t' = G.map (toCartLift p u hu h).op (x _ (lift_mem h hh))
    calc G.map h.op t'
        = G.map (toCartLift p u hu h ≫
            u.map (cartLift p u (X' := X') (p.map h))).op t' := by rw [toCartLift_comp]
      _ = G.map (toCartLift p u hu h).op
            (G.map (u.map (cartLift p u (X' := X') (p.map h))).op t') :=
          Functor.map_comp_apply G (u.map (cartLift p u (X' := X') (p.map h))).op
            (toCartLift p u hu h).op t'
      _ = G.map (toCartLift p u hu h).op (x _ (lift_mem h hh)) :=
          congrArg _ (ht' _ (lift_mem h hh))
  refine ⟨t, ?_, fun t' ht' => huniq t' (amalg t' ht')⟩
  intro Y' g hg
  have hug : (B.functorPullback p).arrows (u.map g) := hg
  have := cartLift_isStronglyCartesian p u (X' := X') ((u ⋙ p).map g)
  let χ := IsStronglyCartesian.map (u ⋙ p) ((u ⋙ p).map g)
    (cartLift p u (X' := X') ((u ⋙ p).map g)) (g := 𝟙 _) (Category.id_comp _).symm g
  have hχ : χ ≫ cartLift p u (X' := X') (p.map (u.map g)) = g :=
    IsStronglyCartesian.fac (u ⋙ p) ((u ⋙ p).map g)
      (cartLift p u (X' := X') ((u ⋙ p).map g)) (Category.id_comp _).symm g
  have hcompat : G.map (u.map χ).op (x _ (lift_mem (u.map g) hug)) = x g hg :=
    compat χ _ _ _ _ hχ
  have hid : u.map χ = toCartLift p u hu (u.map g) := by
    have : (u ⋙ p).IsHomLift (𝟙 ((u ⋙ p).obj Y')) χ :=
      IsStronglyCartesian.map_isHomLift (u ⋙ p) _ _ _ _
    exact toCartLift_uniq p u hu (u.map g) (u.map χ)
      (isHomLift_map_of_comp_eq (q := p) rfl (𝟙 _) χ)
      ((u.map_comp χ _).symm.trans (congrArg u.map hχ))
  change G.map (u.map g).op t = x g hg
  rw [ht _ hug]
  change G.map (toCartLift p u hu (u.map g)).op (x _ (lift_mem (u.map g) hug)) = x g hg
  rw [← hid]
  exact hcompat

end Transfer

section Main

variable {p : 𝒳 ⥤ 𝒞} {p' : 𝒳' ⥤ 𝒞} {u : 𝒳' ⥤ 𝒳}

/-- The `u`-image of a presieve of strongly cartesian morphisms for `u ⋙ p` is a presieve of
strongly cartesian morphisms for `p`. -/
theorem IsFibredOneMorphism.map_isStronglyCartesian_of_mem_map
    (hu : (u ⋙ p).IsFibredOneMorphism p u) {X' : 𝒳'} (R : Presieve X')
    (hR : ∀ ⦃Y' : 𝒳'⦄ (g : Y' ⟶ X'), R g → (u ⋙ p).IsStronglyCartesian ((u ⋙ p).map g) g)
    ⦃V : 𝒳⦄ (m : V ⟶ u.obj X') (hm : (R.map u) m) : p.IsStronglyCartesian (p.map m) m := by
  obtain ⟨hg⟩ := hm
  exact hu.map_isStronglyCartesian _ _ (hR _ hg)

/-- **Stacks 06NW, continuity half, for a 1-morphism of fibred categories, over any base.** A
1-morphism `u` of fibred categories over a site `(𝒞, J)` is a continuous functor from the topology
`𝒳'` inherits from `(𝒞, J)` to the one `𝒳` inherits from it: restriction along `u.op` carries
sheaves on `𝒳` to sheaves on `𝒳'`. No fibre products of the base are assumed. -/
theorem IsFibredOneMorphism.isContinuous_inheritedTopology (J : GrothendieckTopology 𝒞)
    [p'.IsFibered] (hu : p'.IsFibredOneMorphism p u) :
    u.IsContinuous (p'.inheritedTopology J) (p.inheritedTopology J) := by
  obtain ⟨rfl, hcart⟩ := hu
  have hu : (u ⋙ p).IsFibredOneMorphism p u := ⟨rfl, hcart⟩
  constructor
  intro G
  change Presieve.IsSheaf ((u ⋙ p).inheritedPrecoverage J.toPrecoverage).toGrothendieck
    (u.op ⋙ G.obj)
  rw [((u ⋙ p).inheritedPrecoverage J.toPrecoverage).isSheaf_toGrothendieck_iff]
  intro X' Y' f R hR
  have hcartR : ∀ ⦃Z' : 𝒳'⦄ (g : Z' ⟶ X'),
      R g → (u ⋙ p).IsStronglyCartesian ((u ⋙ p).map g) g :=
    fun _ g hg ↦ hR.1 g hg
  have hcartu : ∀ ⦃V : 𝒳⦄ (m : V ⟶ u.obj X'),
      (R.map u) m → p.IsStronglyCartesian (p.map m) m :=
    fun _ m hm ↦ hu.map_isStronglyCartesian_of_mem_map R hcartR m hm
  have hmapR : R.map u ∈ p.inheritedPrecoverage J.toPrecoverage (u.obj X') :=
    ⟨hcartu, by rw [Presieve.map_comp_eq]; exact hR.2⟩
  have hcovpb : (Sieve.generate (R.map u)).pullback (u.map f) ∈
      p.inheritedTopology J (u.obj Y') :=
    (p.inheritedTopology J).pullback_stable (u.map f)
      (Precoverage.generate_mem_toGrothendieck hmapR)
  let B : Sieve (p.obj (u.obj Y')) :=
    (Sieve.generate (R.map (u ⋙ p))).pullback ((u ⋙ p).map f)
  have hBp : B.functorPullback p = (Sieve.generate (R.map u)).pullback (u.map f) := by
    refine Sieve.ext fun V m ↦ ?_
    calc (Sieve.generate (R.map (u ⋙ p))).arrows (p.map m ≫ (u ⋙ p).map f)
        ↔ (Sieve.generate ((R.map u).map p)).arrows (p.map (m ≫ u.map f)) := by
          rw [Presieve.map_comp_eq, p.map_comp, Functor.comp_map]
      _ ↔ (Sieve.generate (R.map u)).arrows (m ≫ u.map f) :=
          (generate_arrows_map_iff p (R.map u) hcartu (m ≫ u.map f)).symm
  have hgoal : (Sieve.generate R).pullback f = B.functorPullback (u ⋙ p) := by
    refine Sieve.ext fun Z' g ↦ ?_
    calc (Sieve.generate R).arrows (g ≫ f)
        ↔ (Sieve.generate (R.map (u ⋙ p))).arrows ((u ⋙ p).map (g ≫ f)) :=
          generate_arrows_map_iff (u ⋙ p) R hcartR (g ≫ f)
      _ ↔ (Sieve.generate (R.map (u ⋙ p))).arrows ((u ⋙ p).map g ≫ (u ⋙ p).map f) := by
          rw [Functor.map_comp]
  rw [hgoal]
  refine isSheafFor_functorPullback_of_isFibredOneMorphism p u hu B G.obj ?_
  rw [hBp]
  exact G.2.isSheafFor _ hcovpb

/-- **Stacks 06NW, cocontinuity half, for a 1-morphism of fibred categories, over any base.** A
1-morphism `u` of fibred categories over a site `(𝒞, J)` is a cocontinuous functor from the
topology `𝒳'` inherits from `(𝒞, J)` to the one `𝒳` inherits from it: a covering sieve of
`u.obj X'` pulls back to a covering sieve of `X'`. No fibre products of the base are
assumed. -/
theorem IsFibredOneMorphism.isCocontinuous_inheritedTopology (J : GrothendieckTopology 𝒞)
    [p'.IsFibered] (hu : p'.IsFibredOneMorphism p u) :
    u.IsCocontinuous (p'.inheritedTopology J) (p.inheritedTopology J) := by
  obtain ⟨rfl, hcart⟩ := hu
  constructor
  -- The induction has to be generalised over the morphisms into the object carrying the sieve,
  -- because `u` need not be surjective on objects: the statement proved is that the pullback of
  -- the sieve along any morphism out of a `u`-image pulls back to a covering sieve.
  suffices H : ∀ (V : 𝒳) (S : Sieve V), (p.inheritedPrecoverage J.toPrecoverage).Saturate V S →
      ∀ (Z' : 𝒳') (m : u.obj Z' ⟶ V),
        (S.pullback m).functorPullback u ∈ (u ⋙ p).inheritedTopology J Z' by
    intro X' S hS
    simpa using H _ S hS X' (𝟙 _)
  intro V S hS
  induction hS with
  | of V R hR =>
    intro Z' m
    have hcartR : ∀ ⦃W : 𝒳⦄ (r : W ⟶ V), R r → p.IsStronglyCartesian (p.map r) r :=
      fun _ r hr ↦ hR.1 r hr
    have hBJ : (Sieve.generate (R.map p)).pullback (p.map m) ∈ J (p.obj (u.obj Z')) :=
      J.pullback_stable (p.map m)
        ((GrothendieckTopology.mem_toPrecoverage_iff ..).mp hR.2)
    let R' : Presieve Z' := fun _ e =>
      ((Sieve.generate (R.map p)).pullback (p.map m)).arrows ((u ⋙ p).map e) ∧
        (u ⋙ p).IsStronglyCartesian ((u ⋙ p).map e) e
    have hR' : R' ∈ (u ⋙ p).inheritedPrecoverage J.toPrecoverage Z' := by
      refine ⟨fun _ _ he ↦ he.2, ?_⟩
      rw [GrothendieckTopology.mem_toPrecoverage_iff]
      refine J.superset_covering ?_ hBJ
      intro W b hb
      have := cartLift_isStronglyCartesian p u (X' := Z') b
      have hmemR' : R' (cartLift p u (X' := Z') b) :=
        ⟨map_cartLift_mem p u _ hb, IsStronglyCartesian.isStronglyCartesian_map (u ⋙ p)
          (cartLift p u (X' := Z') b) b⟩
      exact mem_generate_arrows_of_isHomLift (u ⋙ p) b (cartLift p u (X' := Z') b)
        (Presieve.map_map hmemR')
    refine GrothendieckTopology.superset_covering _ ?_
      (Precoverage.generate_mem_toGrothendieck hR')
    rw [Sieve.generate_le_iff]
    intro W' e he
    change (Sieve.generate R).arrows (u.map e ≫ m)
    rw [generate_arrows_map_iff p R hcartR (u.map e ≫ m), p.map_comp]
    exact he.1
  | top V => simp
  | pullback V S _ Y g ih =>
    intro Z' m
    rw [← Sieve.pullback_comp]
    exact ih Z' (m ≫ g)
  | transitive V S R _ _ ih1 ih2 =>
    intro Z' m
    refine GrothendieckTopology.transitive _ (ih1 Z' m) _ ?_
    intro Y' g hg
    have hgS : S.arrows (u.map g ≫ m) := hg
    have key := ih2 hgS Y' (𝟙 _)
    rw [Sieve.pullback_id] at key
    have hsieve : (R.pullback (u.map g ≫ m)).functorPullback u =
        ((R.pullback m).functorPullback u).pullback g := by
      refine Sieve.ext fun W' h ↦ ?_
      change R.arrows (u.map h ≫ u.map g ≫ m) ↔ R.arrows (u.map (h ≫ g) ≫ m)
      rw [u.map_comp, Category.assoc]
    rw [← hsieve]
    exact key

end Main

end CategoryTheory.Functor

