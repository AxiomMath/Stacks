module

public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import Mathlib.SetTheory.ZFC.Basic
public import StacksFrontier.CategoryTheory.Sites.CoveringPermanence
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Covering families of a site, with their index sets

A site in the sense of the source is a category together with, for every object `X`, a *set* of
covering families of `X`. The index of a covering family is therefore an honest set, not a type:
`CoveringFamilies` below records exactly that datum, and `SetFamily` is a family of objects
indexed by a `ZFSet`, so that the fibres of a morphism of families — formed by separation — are
again families of the same kind.

With this in hand, a morphism of semi-representable objects over `X` is *covering* when each of
its fibre families is one of the site's covering families, and the whole condition is a statement
about members of a set rather than about presieves. `isCoveringOver_of_coveringFamilies`
compares this with the presieve-level condition
`StacksDraft.CategoryTheory.Sites.Hypercovering.Basic.IsCoveringOver`, which is the form the
permanence properties of coverings are proved in.

## Main definitions

* `SetFamily`: a family of objects of `C` indexed by a `ZFSet`, with `SetFamily.inclusion` the
  functor regarding it as a formal coproduct and `SetFamily.fibre`, `SetFamily.fibreFamily` its
  fibres over an index of the target of a morphism.
* `CoveringFamilies`: the covering families of a site, together with the smallness condition of
  Tag 00VH.
* `CoveringFamilies.IsCovering` and `CoveringFamilies.IsCoveringOver`: a morphism of
  semi-representable objects, respectively of semi-representable objects over `X`, is covering
  when each of its fibre families is a covering family of the site (Tag 01G3).
* `CoveringFamilies.toPrecoverage` and `CoveringFamilies.toGrothendieck`: the precoverage and the
  Grothendieck topology obtained by forgetting the index sets.
* `CoveringFamilies.IsHypercovering`: a simplicial object of semi-representable objects over `X`
  is a hypercovering for the site's covering families when its degree-zero family is one of them
  and each successive matching morphism is covering (Tag 01G5).

## Main results

* `isCoveringOver_of_coveringFamilies`: forgetting index elements takes a covering morphism for
  the site's covering families to a covering morphism for any pretopology containing the
  presieves of those families.
* `isHypercovering_of_coveringFamilies` and
  `isHypercovering_toGrothendieck_of_coveringFamilies`: the same comparison for hypercoverings,
  for a compatible pretopology and in particular for the pretopology of the Grothendieck topology
  generated by the covering families. No converse is asserted, and neither gives a smallness
  bound in the larger index type.

## Implementation notes

`SetFamily` retains the actual index set as a `ZFSet`, including its elements when forming
fibres by separation; this is what makes the covering condition a membership in a set. The
coercion of a `ZFSet.{w}` to a sort lands in `Type (w + 1)`, so a `SetFamily.{w}` is included in
`FormalCoproduct.{w + 1}`.

`CoveringFamilies` has independent universes for the set of families, for the index elements, and
for the objects and arrows of `C`. Its `small` field is the requirement of Tag 00VH that the
coverings form a set; it is not used in the definition of a covering morphism, and no closure
axiom is needed there either.

The presieve-level predicates of
`StacksFrontier.CategoryTheory.Sites.Hypercovering.Basic` are a genuinely weaker notion: they forget
the index set and so carry no smallness claim. They must not be used to assert literal smallness
of a hypercovering.

The matching objects in `CoveringFamilies.IsHypercovering` are computed in
`FormalCoproduct (Over X)` after inclusion, where the finite limits supplying the coskeleta live;
only the covering tests use the actual families and their set-theoretic fibres.

## References

* [Stacks Project, Tag 01G3](https://stacks.math.columbia.edu/tag/01G3)
* [Stacks Project, Tag 01G5](https://stacks.math.columbia.edu/tag/01G5)
-/

@[expose] public section

universe s w v u

open CategoryTheory CategoryTheory.Limits Opposite Simplicial

namespace Stacks.CategoryTheory.Hypercovering

variable {C : Type u} [Category.{v} C]

/-- A family of objects of `C` indexed by an actual set, so that its fibres — cut out by
separation — retain their index elements. -/
structure SetFamily (C : Type u) where
  /-- The index set. -/
  I : ZFSet.{w}
  /-- The member at an index. -/
  obj : I → C

namespace SetFamily

/-- Regard a set-indexed family as a formal coproduct. -/
def toFormalCoproduct (U : SetFamily.{w} C) : FormalCoproduct.{w + 1} C :=
  ⟨U.I, U.obj⟩

/-- Morphisms of set-indexed families are the morphisms of the underlying formal coproducts:
an index map together with a component morphism over each index. -/
instance category : Category (SetFamily.{w} C) where
  Hom U V := U.toFormalCoproduct ⟶ V.toFormalCoproduct
  id U := 𝟙 U.toFormalCoproduct
  comp f g := f ≫ g

/-- The inclusion of set-indexed families in formal coproducts. -/
def inclusion : SetFamily.{w} C ⥤ FormalCoproduct.{w + 1} C where
  obj := SetFamily.toFormalCoproduct
  map f := f

/-- The fibre of a morphism of families of objects over `X` above an index of the target, with
index set the actual subset of the source index set lying over that index. -/
def fibre {X : C} (U : SetFamily.{w} (Over X))
    {V : FormalCoproduct.{w + 1} (Over X)} (f : U.toFormalCoproduct ⟶ V) (j : V.I) :
    SetFamily.{w} (Over (V.obj j).left) where
  I := U.I.sep (fun i ↦ ∀ hi : i ∈ U.I, f.f ⟨i, hi⟩ = j)
  obj i := by
    let hi := (ZFSet.mem_sep.mp i.2).1
    let hij := (ZFSet.mem_sep.mp i.2).2 hi
    exact Over.mk ((f.φ ⟨i.1, hi⟩).left ≫
      eqToHom (congrArg (fun k ↦ (V.obj k).left) hij))

/-- The fibre of a morphism of families in `C` itself above an index of the target. -/
def fibreFamily (U : SetFamily.{w} C)
    {V : FormalCoproduct.{w + 1} C} (f : U.toFormalCoproduct ⟶ V) (j : V.I) :
    SetFamily.{w} (Over (V.obj j)) where
  I := U.I.sep (fun i ↦ ∀ hi : i ∈ U.I, f.f ⟨i, hi⟩ = j)
  obj i := by
    let hi := (ZFSet.mem_sep.mp i.2).1
    let hij := (ZFSet.mem_sep.mp i.2).2 hi
    exact Over.mk (f.φ ⟨i.1, hi⟩ ≫ eqToHom (congrArg V.obj hij))

/-- The presieve underlying a family of objects over `X`, obtained by forgetting the index set. -/
def presieve {X : C} (U : SetFamily.{w} (Over X)) : Presieve X :=
  Presieve.ofArrows (fun i ↦ (U.obj i).left) (fun i ↦ (U.obj i).hom)

end SetFamily

/-- The covering families of a site: for every object a set of families of objects over it,
indexed by actual sets. The `small` field is the requirement of Tag 00VH that the coverings of
each object form a set, stated independently of the universe of their index sets. -/
structure CoveringFamilies (C : Type u) [Category.{v} C] where
  /-- The covering families with the given target, including their index sets. -/
  families : (X : C) → Set (SetFamily.{w} (Over X))
  /-- The coverings of each object form a set. -/
  small : ∀ X, Small.{s} (families X)

namespace CoveringFamilies

/-- **Stacks Project, Tag 01G3.** A morphism of semi-representable objects is covering when
every one of its fibre families is a covering family of the site. The target is allowed to be an
arbitrary formal coproduct, as it is for a matching object. -/
@[stacks 01G3 "the definition for SR(C)"]
abbrev IsCovering (Cov : CoveringFamilies.{s, w} C) {U : SetFamily.{w} C}
    {V : FormalCoproduct.{w + 1} C} (f : U.toFormalCoproduct ⟶ V) : Prop :=
  ∀ j : V.I, U.fibreFamily f j ∈ Cov.families (V.obj j)

/-- **Stacks Project, Tag 01G3.** A morphism of semi-representable objects over `X` is covering
when every one of its underlying fibre families is a covering family of the site. -/
@[stacks 01G3 "the definition for SR(C, X)"]
abbrev IsCoveringOver (Cov : CoveringFamilies.{s, w} C)
    {X : C} {U : SetFamily.{w} (Over X)} {V : FormalCoproduct.{w + 1} (Over X)}
    (f : U.toFormalCoproduct ⟶ V) : Prop :=
  ∀ j : V.I, U.fibre f j ∈ Cov.families (V.obj j).left

/-- The precoverage obtained by forgetting the index sets of the covering families. -/
def toPrecoverage (Cov : CoveringFamilies.{s, w} C) : Precoverage C where
  coverings X := {R | ∃ U ∈ Cov.families X, U.presieve = R}

/-- The Grothendieck topology generated by the covering families. -/
def toGrothendieck (Cov : CoveringFamilies.{s, w} C) : GrothendieckTopology C :=
  Cov.toPrecoverage.toGrothendieck

section Hypercovering

variable [HasPullbacks C]

/-- **Stacks Project, Tag 01G5.** A hypercovering of `X` for the site's covering families: the
degree-zero family is one of the covering families of `X`, and all fibres of the successive
matching morphisms are covering families of the site. The coskeleton is computed in formal
coproducts, after including the set-indexed families. -/
@[stacks 01G5, sga "4 V 7.3.3" "object case, no type p"]
abbrev IsHypercovering (Cov : CoveringFamilies.{s, w} C) {X : C}
    (K : SimplicialObject (SetFamily.{w} (Over X))) : Prop :=
  K.obj (Opposite.op ⦋0⦌) ∈ Cov.families X ∧
    ∀ n : ℕ, Cov.IsCoveringOver
      (((SimplicialObject.coskAdj n).unit.app (K ⋙ SetFamily.inclusion)).app
        (Opposite.op ⦋n + 1⦌))

end Hypercovering

end CoveringFamilies

variable [HasPullbacks C]

/-- If a family indexed by `ι` surjects onto the fibre family of `f` over `j`, then the fibre
presieve is in `J` as soon as the reindexed presieve is. -/
private theorem ofArrows_fibre_mem {J : Pretopology C} {X : C}
    {U V : FormalCoproduct.{w + 1} (Over X)} (f : U ⟶ V) (j : V.I) {ι : Type*}
    (a : ι → {i : U.I // f.f i = j}) (ha : a.Surjective)
    (h : Presieve.ofArrows (fun k ↦ (U.obj (a k).1).left)
      (fun k ↦ (f.φ (a k).1).left ≫ eqToHom (congrArg (fun k ↦ (V.obj k).left) (a k).2)) ∈
        J (V.obj j).left) :
    Presieve.ofArrows (fun i : {i : U.I // f.f i = j} ↦ (U.obj i.1).left)
      (fun i ↦ (f.φ i.1).left ≫ eqToHom (congrArg (fun k ↦ (V.obj k).left) i.2)) ∈
        J (V.obj j).left :=
  by rwa [← Presieve.ofArrows_comp_eq_of_surjective _ ha]

/-- Forgetting the index elements takes a covering morphism for the site's covering families to a
covering morphism for any pretopology containing the presieves of those families. -/
theorem isCoveringOver_of_coveringFamilies
    (Cov : CoveringFamilies.{s, w} C) (J : Pretopology C)
    (hCov : ∀ (Y : C) (U : SetFamily.{w} (Over Y)),
      U ∈ Cov.families Y → U.presieve ∈ J Y)
    {X : C} {U : SetFamily.{w} (Over X)} {V : FormalCoproduct.{w + 1} (Over X)}
    {f : U.toFormalCoproduct ⟶ V} (hf : Cov.IsCoveringOver f) :
    IsCoveringOver J f := by
  intro j
  let a : (U.fibre f j).I → {i : U.toFormalCoproduct.I // f.f i = j} := fun i ↦ by
    have hi := ZFSet.mem_sep.mp (show i.1 ∈
      U.I.sep (fun k ↦ ∀ hk : k ∈ U.I, f.f ⟨k, hk⟩ = j) from i.2)
    exact ⟨⟨i.1, hi.1⟩, hi.2 hi.1⟩
  refine ofArrows_fibre_mem f j a ?_ (hCov _ _ (hf j))
  rintro ⟨i, hi⟩
  refine ⟨⟨i.1, ?_⟩, rfl⟩
  change i.1 ∈ U.I.sep (fun k ↦ ∀ hk : k ∈ U.I, f.f ⟨k, hk⟩ = j)
  exact ZFSet.mem_sep.mpr ⟨i.2, fun _ ↦ hi⟩

/-- A hypercovering for the site's covering families is a hypercovering for every pretopology
containing the presieves of those families and stable under composition. This makes the
pretopology results applicable after forgetting index elements; no converse is asserted, and
there is no smallness bound in the larger index type. -/
theorem isHypercovering_of_coveringFamilies
    {Cov : CoveringFamilies.{s, w} C} {X : C}
    {K : SimplicialObject (SetFamily.{w} (Over X))} (hK : Cov.IsHypercovering K)
    (J : Pretopology C) [Precoverage.IsStableUnderComposition J.toPrecoverage]
    (hCov : ∀ (Y : C) (U : SetFamily.{w} (Over Y)),
      U ∈ Cov.families Y → U.presieve ∈ J Y) :
    IsHypercovering J (K ⋙ SetFamily.inclusion) := by
  refine ⟨?_, fun n ↦ isCoveringOver_of_coveringFamilies Cov J hCov (hK.2 n)⟩
  let U := K.obj (Opposite.op ⦋0⦌)
  let T := (FormalCoproduct.incl.{w + 1} (Over X)).obj (Over.mk (𝟙 X))
  let q : U.toFormalCoproduct ⟶ T :=
    { f := fun _ ↦ PUnit.unit
      φ := fun i ↦ Over.homMk (U.obj i).hom
        (by simp [T, FormalCoproduct.incl, SetFamily.toFormalCoproduct]) }
  have hq : IsCoveringOver J q := by
    intro j
    cases j
    refine ofArrows_fibre_mem q _ (fun i : U.I ↦ ⟨i, rfl⟩) (fun i ↦ ⟨i.1, rfl⟩) ?_
    simp only [q, eqToHom_refl, Category.comp_id]
    exact hCov X U hK.1
  let e : T ≅ (⊤_ FormalCoproduct.{w + 1} (Over X)) :=
    (FormalCoproduct.isTerminalIncl _ Over.mkIdTerminal).uniqueUpToIso terminalIsTerminal
  have h := hq.comp J (IsCoveringOver.of_isIso J e.hom)
  rwa [show q ≫ e.hom = terminal.from U.toFormalCoproduct from terminal.hom_ext _ _] at h

/-- Every hypercovering for the site's covering families is a hypercovering for the pretopology
of the Grothendieck topology those families generate. -/
theorem isHypercovering_toGrothendieck_of_coveringFamilies
    {Cov : CoveringFamilies.{s, w} C} {X : C}
    {K : SimplicialObject (SetFamily.{w} (Over X))} (hK : Cov.IsHypercovering K) :
    IsHypercovering Cov.toGrothendieck.toPretopology (K ⋙ SetFamily.inclusion) := by
  have : Precoverage.IsStableUnderComposition
      Cov.toGrothendieck.toPretopology.toPrecoverage :=
    inferInstanceAs (Precoverage.IsStableUnderComposition Cov.toGrothendieck.toPrecoverage)
  exact isHypercovering_of_coveringFamilies hK _ fun Y U hU ↦
    Precoverage.generate_mem_toGrothendieck (J := Cov.toPrecoverage) ⟨U, hU, rfl⟩

end Stacks.CategoryTheory.Hypercovering

end
