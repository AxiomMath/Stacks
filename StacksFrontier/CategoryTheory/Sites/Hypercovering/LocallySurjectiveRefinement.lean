/-!
# Refining a hypercovering through a locally surjective presheaf map

A locally surjective map of presheaves onto a term of a hypercovering can be incorporated into
a refinement of the hypercovering.

## Main definitions

There are no new definitions.

## Main results

* `exists_hypercovering_map_factoring_through_locallySurjective`: the map in a chosen degree of
  a hypercovering refinement factors through the given presheaf map.

## Implementation notes

The functor `associatedPresheafFunctorOver` is the source's `F`, taking a formal coproduct of
objects over `X` to a coproduct of representables on `C`. Local surjectivity is expressed by
`Presheaf.IsLocallySurjective` for the topology generated by the site's pretopology; this is
equivalent to surjectivity after sheafification. Factorization is an explicit natural
transformation and a commuting equation.
The index universe of formal coproducts is taken to contain the object and morphism universes,
so a covering family obtained from a local-surjectivity sieve is an admissible formal coproduct.
The indexed-family composition axiom of a site (Tag 00VH (2)), needed to apply Tag 01GJ, is
supplied by `Precoverage.IsStableUnderComposition`.

## References

* [Stacks Project, Tag 01GK](https://stacks.math.columbia.edu/tag/01GK)
-/

@[expose] public section

universe w v u

open CategoryTheory CategoryTheory.Limits Simplicial

namespace Stacks.CategoryTheory.Hypercovering

section

/-- Restricting a map of formal coproducts to one term factors through the corresponding term of
the target. -/
private theorem fromIncl_id_comp {𝒜 : Type*} [Category 𝒜] {A B : FormalCoproduct.{w} 𝒜} (f : A ⟶ B)
    (p : A.I) :
    FormalCoproduct.Hom.fromIncl p (𝟙 (A.obj p)) ≫ f =
      (FormalCoproduct.incl 𝒜).map (f.φ p) ≫
        FormalCoproduct.Hom.fromIncl (f.f p) (𝟙 (B.obj (f.f p))) := by
  refine (FormalCoproduct.hom_ext_iff' _ _).2 fun j => ⟨rfl, ?_⟩
  cases j
  simp [FormalCoproduct.Hom.fromIncl, FormalCoproduct.incl]

variable {C : Type u} [Category.{v} C] {X : C}

/-- The section of the presheaf associated to `U` given by the identity of its term `U.obj i`. -/
private noncomputable def termSection (U : FormalCoproduct.{max u v w} (Over X)) (i : U.I) :
    ((associatedPresheafFunctorOver (X := X)).obj U).obj (Opposite.op (U.obj i).left) :=
  ((associatedPresheafFunctorOver (X := X)).map
      (FormalCoproduct.Hom.fromIncl i (𝟙 (U.obj i)))).app (Opposite.op (U.obj i).left)
    ((((FormalCoproduct.evalCompInclIsoId (Over X) (Cᵒᵖ ⥤ Type (max u v (max u v) w))).app
      (Over.forget X ⋙ uliftYoneda.{max u (max u v) w})).inv.app (U.obj i)).app
      (Opposite.op (U.obj i).left) (ULift.up (𝟙 (U.obj i).left)))

/-- The section classifying the restriction of a map of formal coproducts to one term is the
pullback of the corresponding term section of the target. -/
private theorem uliftYonedaEquiv_inclIso_inv_comp_map {Z U : FormalCoproduct.{max u v w} (Over X)}
    (v : Z ⟶ U) (p : Z.I) :
    uliftYonedaEquiv.{max u (max u v) w}
      ((((FormalCoproduct.evalCompInclIsoId (Over X) (Cᵒᵖ ⥤ Type (max u v (max u v) w))).app
          (Over.forget X ⋙ uliftYoneda.{max u (max u v) w})).app (Z.obj p)).inv ≫
        (associatedPresheafFunctorOver (X := X)).map
          (FormalCoproduct.Hom.fromIncl p (𝟙 (Z.obj p)) ≫ v)) =
      ((associatedPresheafFunctorOver (X := X)).obj U).map (v.φ p).left.op
        (termSection U (v.f p)) := by
  let D := associatedPresheafFunctorOver (X := X)
  let E := Over.forget X ⋙ uliftYoneda.{max u (max u v) w}
  let inclIso := (FormalCoproduct.evalCompInclIsoId (Over X)
    (Cᵒᵖ ⥤ Type (max u v (max u v) w))).app E
  let e := inclIso.app (Z.obj p)
  let f := v.φ p
  let eB := inclIso.app (U.obj (v.f p))
  let inc := FormalCoproduct.incl (Over X)
  let τ := D.map (FormalCoproduct.Hom.fromIncl (v.f p) (𝟙 (U.obj (v.f p))))
  change uliftYonedaEquiv (e.inv ≫ D.map (FormalCoproduct.Hom.fromIncl p (𝟙 (Z.obj p)) ≫ v)) =
    (D.obj U).map f.left.op (termSection U (v.f p))
  rw [CategoryTheory.uliftYonedaEquiv_apply]
  have hmap : D.map (FormalCoproduct.Hom.fromIncl p (𝟙 (Z.obj p)) ≫ v) =
      D.map (inc.map f) ≫ τ := by
    rw [fromIncl_id_comp, Functor.map_comp]
  have hIso : e.inv ≫ D.map (inc.map f) = E.map f ≫ eB.inv :=
    (inclIso.inv.naturality f).symm
  have hcomp : e.inv ≫ D.map (inc.map f) ≫ τ = E.map f ≫ eB.inv ≫ τ := by
    rw [← Category.assoc, hIso, Category.assoc]
  let xZ : (E.obj (Z.obj p)).obj (Opposite.op (Z.obj p).left) := ULift.up (𝟙 (Z.obj p).left)
  have hsection := congrArg (fun γ : E.obj (Z.obj p) ⟶ D.obj U =>
    (ConcreteCategory.hom (γ.app (Opposite.op (Z.obj p).left))) xZ) hcomp
  let xB : (E.obj (U.obj (v.f p))).obj (Opposite.op (U.obj (v.f p)).left) :=
    ULift.up (𝟙 (U.obj (v.f p)).left)
  have hnat := NatTrans.naturality_apply (eB.inv ≫ τ) f.left.op xB
  rw [hmap]
  have heval :
      (ConcreteCategory.hom ((E.map f).app (Opposite.op (Z.obj p).left))) xZ =
        (ConcreteCategory.hom ((E.obj (U.obj (v.f p))).map f.left.op)) xB := by
    simp only [Functor.comp_obj, Over.forget_obj, Functor.comp_map, Over.forget_map,
      uliftYoneda_map_app, TypeCat.hom_ofHom, yoneda_obj_obj, TypeCat.Fun.coe_mk,
      Category.id_comp, uliftYoneda_obj_map, Quiver.Hom.unop_op, E, f, xZ, xB]
    exact ULift.ext (Category.comp_id _).symm
  have hsectionRight :
      (ConcreteCategory.hom ((E.map f ≫ eB.inv ≫ τ).app (Opposite.op (Z.obj p).left))) xZ =
        (ConcreteCategory.hom ((eB.inv ≫ τ).app (Opposite.op (Z.obj p).left)))
          ((ConcreteCategory.hom ((E.obj (U.obj (v.f p))).map f.left.op)) xB) := by
    simp only [NatTrans.comp_app, ConcreteCategory.comp_apply, heval]
  have hs : termSection U (v.f p) =
      ConcreteCategory.hom ((eB.inv ≫ τ).app (Opposite.op (U.obj (v.f p)).left)) xB := rfl
  rw [hs]
  simpa [eB, τ, f, E, xZ, xB] using hsection.trans (hsectionRight.trans hnat)

/-- A family of lifts through `u` of the restrictions of `v` to the terms of `Z` glues to a lift
of `v`. -/
private theorem exists_comp_eq_map_of_forall_fromIncl {Z U : FormalCoproduct.{max u v w} (Over X)}
    {F : Cᵒᵖ ⥤ Type (max u v w)} (u : F ⟶ (associatedPresheafFunctorOver (X := X)).obj U)
    (v : Z ⟶ U)
    (q' : ∀ p : Z.I,
      (associatedPresheafFunctorOver (X := X)).obj (FormalCoproduct.toFun Z p) ⟶ F)
    (hq : ∀ p : Z.I, q' p ≫ u = (associatedPresheafFunctorOver (X := X)).map
      (FormalCoproduct.Hom.fromIncl p (𝟙 (Z.obj p)) ≫ v)) :
    ∃ g : (associatedPresheafFunctorOver (X := X)).obj Z ⟶ F,
      g ≫ u = (associatedPresheafFunctorOver (X := X)).map v := by
  let D := associatedPresheafFunctorOver (X := X)
  let c := FormalCoproduct.cofan Z.I (FormalCoproduct.toFun Z)
  let iso := FormalCoproduct.cofanPtIsoSelf Z
  have hC : IsColimit (D.mapCocone c) := by
    dsimp [D, associatedPresheafFunctorOver]
    exact FormalCoproduct.isColimitEvalMapCoconeCofan Z.I (FormalCoproduct.toFun Z) _
  let d : Cocone (Discrete.functor (FormalCoproduct.toFun Z) ⋙ D) :=
    Cocone.mk F
      { app := fun p : Discrete Z.I => q' p.as
        naturality := by
          intro i j f
          obtain rfl : i = j := Discrete.ext (Discrete.eq_of_hom f)
          simp }
  let gZ : D.obj Z ⟶ F := D.map iso.inv ≫ hC.desc d
  let m (p : Z.I) : (FormalCoproduct.incl (Over X)).obj (Z.obj p) ⟶ U :=
    FormalCoproduct.Hom.fromIncl p (𝟙 (Z.obj p)) ≫ v
  have hm (p : Z.I) : c.inj p ≫ iso.hom ≫ v = m p := by
    rw [← Category.assoc, FormalCoproduct.inj_comp_cofanPtIsoSelf_hom]
    rfl
  refine ⟨gZ, (cancel_epi (D.map iso.hom)).1 (hC.hom_ext fun p => ?_)⟩
  have hfac : D.map (c.inj p.as) ≫ hC.desc d = q' p.as := by
    cases p with
    | mk i => simpa only [Functor.mapCocone_ι_app, c, d, Cofan.inj] using hC.fac d ⟨i⟩
  change D.map (c.inj p.as) ≫ D.map iso.hom ≫ gZ ≫ u =
    D.map (c.inj p.as) ≫ D.map iso.hom ≫ D.map v
  calc
    D.map (c.inj p.as) ≫ D.map iso.hom ≫ gZ ≫ u =
        (D.map (c.inj p.as) ≫ (D.map iso.hom ≫ D.map iso.inv)) ≫
          hC.desc d ≫ u := by simp [gZ, Category.assoc]
    _ = q' p.as ≫ u := by
      rw [← Functor.map_comp, iso.hom_inv_id, CategoryTheory.Functor.map_id, Category.comp_id,
        ← Category.assoc, hfac]
    _ = (show D.obj (Z.toFun p.as) ⟶ D.obj U from D.map (m p.as)) := hq p.as
    _ = D.map (c.inj p.as) ≫ D.map iso.hom ≫ D.map v := by
      rw [← hm, ← Functor.map_comp, ← Functor.map_comp]

/-- The formal coproduct over `X` of the arrows of a family of presieves on the terms of `U`. -/
private def sigmaPresieves (U : FormalCoproduct.{max u v w} (Over X))
    (R : ∀ i : U.I, Presieve (U.obj i).left) : FormalCoproduct.{max u v w} (Over X) :=
  ⟨(Σ i : U.I, (R i).uncurry), fun p => Over.mk (p.2.val.2 ≫ (U.obj p.1).hom)⟩

/-- The map from `sigmaPresieves U R` to `U` given by the arrows of the presieves. -/
private def sigmaPresievesHom (U : FormalCoproduct.{max u v w} (Over X))
    (R : ∀ i : U.I, Presieve (U.obj i).left) : sigmaPresieves U R ⟶ U where
  f p := p.1
  φ p := Over.homMk p.2.val.2

variable [HasPullbacks C]

/-- The map collecting a family of covering presieves on the terms of `U` is covering. -/
private theorem isCoveringOver_sigmaPresievesHom (J : Pretopology C)
    (U : FormalCoproduct.{max u v w} (Over X)) (R : ∀ i : U.I, Presieve (U.obj i).left)
    (hR : ∀ i, R i ∈ J (U.obj i).left) : IsCoveringOver J (sigmaPresievesHom U R) := by
  intro i
  let Z := sigmaPresieves U R
  let v := sigmaPresievesHom U R
  change Presieve.ofArrows
    (fun j : {p : Z.I // v.f p = i} => (Z.obj j.1).left)
    (fun j => (v.φ j.1).left ≫ eqToHom (congrArg (fun k => (U.obj k).left) j.2)) ∈
      J (U.obj i).left
  have hEq : Presieve.ofArrows
      (fun j : {p : Z.I // v.f p = i} => (Z.obj j.1).left)
      (fun j => (v.φ j.1).left ≫ eqToHom (congrArg (fun k => (U.obj k).left) j.2)) =
      R i := by
    apply le_antisymm
    · intro Y f hf
      rcases hf with ⟨⟨⟨i', a⟩, hi⟩⟩
      dsimp [v, sigmaPresievesHom] at hi
      subst i'
      change R i (a.val.2 ≫ 𝟙 _)
      rw [Category.comp_id]
      exact a.property
    · intro Y f hf
      exact Presieve.ofArrows.mk' (⟨⟨i, ⟨⟨Y, f⟩, hf⟩⟩, rfl⟩ : {p : Z.I // v.f p = i}) rfl
        (by
          simp [v, Z, sigmaPresieves, sigmaPresievesHom]
          rfl)
  exact hEq ▸ hR i

end

variable {C : Type u} [Category.{v} C] [HasPullbacks C]

/-- **Stacks Project, Tag 01GK.** A locally surjective map onto the presheaf represented by one
term of a hypercovering can be factored through after refining the hypercovering. -/
@[stacks 01GK, sga "4 V 7.3.2" "2)"]
public theorem exists_hypercovering_map_factoring_through_locallySurjective
    (J : Pretopology C) [Precoverage.IsStableUnderComposition J.toPrecoverage] {X : C}
    (K : SimplicialObject (FormalCoproduct.{max u v w} (Over X)))
    (hK : IsHypercovering J K) (n : ℕ)
    (F : Cᵒᵖ ⥤ Type (max u v w))
    (u : F ⟶ (associatedPresheafFunctorOver (X := X)).obj
      (K.obj (Opposite.op (SimplexCategory.mk n))))
    [Presheaf.IsLocallySurjective J.toGrothendieck u] :
    ∃ (L : SimplicialObject (FormalCoproduct.{max u v w} (Over X))),
      IsHypercovering J L ∧
        ∃ (f : L ⟶ K)
          (g : (associatedPresheafFunctorOver (X := X)).obj
            (L.obj (Opposite.op (SimplexCategory.mk n))) ⟶ F),
            g ≫ u = (associatedPresheafFunctorOver (X := X)).map
              (f.app (Opposite.op (SimplexCategory.mk n))) := by
  classical
  let U := K.obj (Opposite.op (SimplexCategory.mk n))
  let D := associatedPresheafFunctorOver (X := X)
  let E := Over.forget X ⋙ uliftYoneda.{max u (max u v) w}
  let inclIso := (FormalCoproduct.evalCompInclIsoId (Over X)
    (Cᵒᵖ ⥤ Type (max u v (max u v) w))).app E
  choose R hR hRS using fun i : U.I =>
    (Pretopology.mem_toGrothendieck J (U.obj i).left
      (Presheaf.imageSieve u (termSection U i))).mp
      (Presheaf.imageSieve_mem (J := J.toGrothendieck) u (termSection U i))
  let Z := sigmaPresieves U R
  let v := sigmaPresievesHom U R
  choose x hx using fun p : Z.I => hRS p.1 p.2.val.1 p.2.val.2 p.2.property
  let q (p : Z.I) : E.obj (Z.obj p) ⟶ F :=
    uliftYonedaEquiv.{max u (max u v) w}.symm (x p)
  let q' (p : Z.I) : D.obj (FormalCoproduct.toFun Z p) ⟶ F :=
    (inclIso.hom.app (Z.obj p)) ≫ q p
  have hlocal (p : Z.I) :
      q' p ≫ u = D.map (FormalCoproduct.Hom.fromIncl p (𝟙 (Z.obj p)) ≫ v) := by
    let e := inclIso.app (Z.obj p)
    apply (cancel_epi e.inv).1
    change (e.inv ≫ e.hom) ≫ q p ≫ u =
      e.inv ≫ D.map (FormalCoproduct.Hom.fromIncl p (𝟙 (Z.obj p)) ≫ v)
    rw [e.inv_hom_id, Category.id_comp]
    apply uliftYonedaEquiv.injective
    dsimp only [q]
    rw [uliftYonedaEquiv_comp, uliftYonedaEquiv_comp]
    refine Eq.trans ?_ ((hx p).trans (uliftYonedaEquiv_inclIso_inv_comp_map v p).symm)
    exact congrArg _ (Equiv.apply_symm_apply _ _)
  obtain ⟨gZ, hfactor⟩ := exists_comp_eq_map_of_forall_fromIncl u v q' hlocal
  obtain ⟨L, hL, f, g, hfg⟩ := exists_hypercovering_map_factoring_through_covering J K hK n v
    (isCoveringOver_sigmaPresievesHom J U R hR)
  refine ⟨L, hL, f, D.map g ≫ gZ, ?_⟩
  simp only [Category.assoc, hfactor, ← Functor.map_comp, hfg, D]

end Stacks.CategoryTheory.Hypercovering
