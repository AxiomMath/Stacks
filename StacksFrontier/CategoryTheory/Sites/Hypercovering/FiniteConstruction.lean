/-!
# Hypercoverings by a chosen class of objects, with finite families in every degree

Let `C` be a site with fibre products and let `B` be a class of objects of `C`. Suppose every
object of `C` has a finite covering family by objects of `B`, and that adjoining one further
morphism from an object of `B` to such a family again gives a covering family. Then every object
of `C` admits a hypercovering whose family in every degree is finite and consists of objects of
`B`.

## Main results

* `exists_finite_hypercovering`: existence of a hypercovering which is degreewise a finite family
  of objects of `B`.

## Implementation notes

A covering family is recorded as the presieve generated by its displayed arrows. A term of the
hypercovering is a formal coproduct of objects over the base, so its component morphisms to the
base are part of the objects of that formal coproduct. Adjoining an arrow to a family is recorded
by indexing the enlarged family by `Sum I PUnit`.

The hypercovering is built by adjoining, degree by degree, a finite family of simplices along
their boundaries: `attach` glues to a simplicial object one cell for every nondegenerate simplex
of `Δ[n + 1]` outside its `(n + 1)`-skeleton, and `exists_finite_matching_extension` performs one
such step. Each step is an isomorphism in degrees at most `n`, so the sequence of steps is
degreewise eventually constant and `exists_stabilized_simplicial_object` takes its colimit; each
degree of the colimit is a finite family already present at a finite stage.

## References

* [Stacks Project, Tag 094K](https://stacks.math.columbia.edu/tag/094K)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite Simplicial

universe w v u

namespace Stacks.CategoryTheory.Hypercovering

namespace FiniteConstruction



private def componentDiagram {D : Type u} [Category.{v} D]
    {A : Type} [SmallCategory A] (F : A ⥤ FormalCoproduct.{w} D)
    (s : ∀ a, (F.obj a).I)
    (hs : ∀ {a b} (f : a ⟶ b), (F.map f).f (s a) = s b) : A ⥤ D where
  obj a := (F.obj a).obj (s a)
  map f := (F.map f).φ (s _) ≫ eqToHom (congrArg (F.obj _).obj (hs f))
  map_id a := ((FormalCoproduct.hom_ext_iff' _ _).mp (F.map_id a) (s a)).2
  map_comp {a b c} f g := by
    have hφ := (FormalCoproduct.hom_ext_iff' _ _).mp (F.map_comp f g) (s a)
    dsimp only [FormalCoproduct.category_comp_f, FormalCoproduct.category_comp_φ] at hφ
    obtain ⟨e, he⟩ := hφ
    change (F.map (f ≫ g)).φ (s a) ≫ _ = _
    rw [Category.assoc, ← eqToHom_naturality_assoc (F.map g).φ (hs f)]
    simpa using congrArg (fun k => k ≫ eqToHom
      (congrArg (F.obj c).obj ((congrArg (F.map g).f (hs f)).trans (hs g)))) he

private def componentCone {D : Type u} [Category.{v} D]
    {A : Type} [SmallCategory A] (F : A ⥤ FormalCoproduct.{w} D)
    (s : ∀ a, (F.obj a).I)
    (hs : ∀ {a b} (f : a ⟶ b), (F.map f).f (s a) = s b)
    (c : Cone F) (i : c.pt.I) (hi : ∀ a, (c.π.app a).f i = s a) :
    Cone (componentDiagram F s hs) where
  pt := c.pt.obj i
  π :=
    { app := fun a => (c.π.app a).φ i ≫ eqToHom (congrArg (F.obj a).obj (hi a))
      naturality := by
        intro a b f
        dsimp [componentDiagram]
        simp only [Category.id_comp, Category.assoc]
        rw [← eqToHom_naturality_assoc (F.map f).φ (hi a)]
        obtain ⟨e, he⟩ := (FormalCoproduct.hom_ext_iff' _ _).mp (c.w f) i
        simpa using (congrArg (fun k => k ≫ eqToHom
          (congrArg (F.obj b).obj (hi b))) he).symm }

private theorem finite_indices_of_isLimit {D : Type u} [Category.{v} D]
    {A : Type} [SmallCategory A] [FinCategory A] [HasFiniteLimits D]
    (F : A ⥤ FormalCoproduct.{w} D) [∀ a, Finite (F.obj a).I]
    (c : Cone F) (hc : IsLimit c) : Finite c.pt.I := by
  classical
  apply Finite.of_injective (fun i a => (c.π.app a).f i)
  intro i j hij
  let s := fun a => (c.π.app a).f i
  have hs : ∀ {a b} (f : a ⟶ b), (F.map f).f (s a) = s b :=
    fun f => congrArg (fun k => k.f i) (c.w f)
  let G := componentDiagram F s hs
  let ci : Cone G := componentCone F s hs c i (fun _ => rfl)
  let cj : Cone G := componentCone F s hs c j (fun a => (congrFun hij a).symm)
  let p := pullback (limit.lift G ci) (limit.lift G cj)
  let fi : (FormalCoproduct.incl D).obj p ⟶ c.pt :=
    FormalCoproduct.Hom.fromIncl i (pullback.fst _ _)
  let fj : (FormalCoproduct.incl D).obj p ⟶ c.pt :=
    FormalCoproduct.Hom.fromIncl j (pullback.snd _ _)
  have h : fi = fj := by
    apply hc.hom_ext
    intro a
    -- `hij` is stated for an unreduced application, so record its instance at `a` in the
    -- beta-reduced form that the objects below are written in.
    have hija : (c.π.app a).f i = (c.π.app a).f j := congrFun hij a
    -- The two legs of the component cones, with their types written out, so that the
    -- `eqToHom` algebra below is visible to `rw`.
    let e₂ : (F.obj a).obj ((c.π.app a).f j) ⟶ (F.obj a).obj ((c.π.app a).f i) :=
      eqToHom (congrArg (F.obj a).obj hija.symm)
    have h₁ : ci.π.app a = (c.π.app a).φ i ≫ 𝟙 ((F.obj a).obj ((c.π.app a).f i)) := rfl
    have h₂ : cj.π.app a = (c.π.app a).φ j ≫ e₂ := rfl
    have he₂ : e₂ ≫ eqToHom (congrArg (F.obj a).obj hija) =
        𝟙 ((F.obj a).obj ((c.π.app a).f j)) := by simp [e₂]
    have hpc : pullback.fst (limit.lift G ci) (limit.lift G cj) ≫ ci.π.app a =
        pullback.snd (limit.lift G ci) (limit.lift G cj) ≫ cj.π.app a := by
      rw [← limit.lift_π ci a, ← limit.lift_π cj a]
      exact pullback.condition_assoc (limit.π G a)
    rw [h₁, h₂, Category.comp_id] at hpc
    refine FormalCoproduct.hom_ext (funext fun _ => hija) ?_
    intro k
    show (pullback.fst (limit.lift G ci) (limit.lift G cj) ≫ (c.π.app a).φ i) ≫
        eqToHom (congrArg (F.obj a).obj hija) =
      pullback.snd (limit.lift G ci) (limit.lift G cj) ≫ (c.π.app a).φ j
    refine (congrArg (fun z ↦ z ≫ eqToHom (congrArg (F.obj a).obj hija)) hpc).trans ?_
    refine (Category.assoc _ _ _).trans ?_
    exact congrArg (fun z ↦ pullback.snd (limit.lift G ci) (limit.lift G cj) ≫ z)
      ((Category.assoc _ _ _).trans
        ((congrArg (fun z ↦ (c.π.app a).φ j ≫ z) he₂).trans (Category.comp_id _)))
  exact congrArg (fun k => k.f PUnit.unit) h

@[instance_reducible]
private noncomputable def matchingFinCategory (n : ℕ) (a : SimplexCategoryᵒᵖ) :
    FinCategory (StructuredArrow a (SimplexCategory.Truncated.inclusion n).op) := by
  classical
  have := SimplicialObject.Truncated.finite_truncated n
  have : Finite (SimplexCategory.Truncated n)ᵒᵖ := .of_equiv _ equivToOpposite
  have : ∀ b : (SimplexCategory.Truncated n)ᵒᵖ,
      Finite (a ⟶ (SimplexCategory.Truncated.inclusion n).op.obj b) :=
    fun _ => SimplicialObject.Truncated.finite_hom_op _ _
  have : ∀ b c : (SimplexCategory.Truncated n)ᵒᵖ, Finite (b ⟶ c) := fun b c => by
    have := SimplicialObject.Truncated.finite_hom_fullSubcategory c.unop b.unop
    exact SimplicialObject.Truncated.finite_hom_op b c
  have : Finite (StructuredArrow a (SimplexCategory.Truncated.inclusion n).op) := by
    refine Finite.of_injective (fun f => (⟨f.right, f.hom⟩ :
      (b : (SimplexCategory.Truncated n)ᵒᵖ) ×
        (a ⟶ (SimplexCategory.Truncated.inclusion n).op.obj b))) ?_
    rintro ⟨l₁, r₁, w₁⟩ ⟨l₂, r₂, w₂⟩ h
    obtain ⟨rfl, h'⟩ := Sigma.mk.inj_iff.mp h
    obtain rfl := eq_of_heq h'
    cases l₁
    cases l₂
    rfl
  exact
    { fintypeObj := Fintype.ofFinite _
      fintypeHom := fun b c => by
        have : Finite (b ⟶ c) := Finite.of_injective CommaMorphism.right
          (fun _ _ h => StructuredArrow.hom_ext _ _ h)
        exact Fintype.ofFinite _ }

private theorem finite_cosk_indices
    {D : Type u} [Category.{v} D] [HasFiniteLimits D]
    (K : SimplicialObject (FormalCoproduct.{w} D)) (n : ℕ)
    [∀ F : (SimplexCategory.Truncated n)ᵒᵖ ⥤ FormalCoproduct.{w} D,
      (SimplexCategory.Truncated.inclusion n).op.HasPointwiseRightKanExtension F]
    (hfinite : ∀ m : ℕ, m ≤ n → Finite (K.obj (op ⦋m⦌)).I)
    (a : SimplexCategoryᵒᵖ) : Finite (((SimplicialObject.cosk n).obj K).obj a).I := by
  let := matchingFinCategory n a
  let F := (SimplicialObject.truncation n).obj K
  let L := (SimplexCategory.Truncated.inclusion n).op
  let E := Functor.RightExtension.mk ((SimplicialObject.cosk n).obj K)
    ((SimplicialObject.coskAdj n).counit.app F)
  have : ∀ b : StructuredArrow a L, Finite (((StructuredArrow.proj a L ⋙ F).obj b).I) :=
    fun b => hfinite b.right.unop.obj.len b.right.unop.property
  exact finite_indices_of_isLimit (StructuredArrow.proj a L ⋙ F) (E.coneAt a)
    (Functor.isPointwiseRightKanExtensionOfIsRightKanExtension
      ((SimplicialObject.cosk n).obj K)
      ((SimplicialObject.coskAdj n).counit.app F) a)

/-- Two morphisms of formal coproducts agree when, over every index of the source, the pair
consisting of the target index and the component morphism agrees. Unlike
`FormalCoproduct.hom_ext` this carries no `eqToHom`, so it applies when the two index maps agree
only after a case distinction. -/
private lemma hom_ext_sigma {D : Type u} [Category.{v} D] {U V : FormalCoproduct.{w} D}
    {g₁ g₂ : U ⟶ V}
    (h : ∀ i, (⟨g₁.f i, g₁.φ i⟩ : Σ j, U.obj i ⟶ V.obj j) = ⟨g₂.f i, g₂.φ i⟩) : g₁ = g₂ := by
  obtain ⟨f₁, φ₁⟩ := g₁
  obtain ⟨f₂, φ₂⟩ := g₂
  have hf : f₁ = f₂ := funext fun i => congrArg Sigma.fst (h i)
  subst hf
  refine FormalCoproduct.hom_ext rfl fun i => ?_
  simp only [eqToHom_refl, Category.comp_id]
  exact eq_of_heq (Sigma.mk.inj_iff.mp (h i)).2

section Attach
variable {D : Type u} [Category.{v} D] {A : Type} [SmallCategory A]
    (K : A ⥤ FormalCoproduct.{w} D) (S : A ⥤ Type w) (R : Subfunctor S)
    (T : FormalCoproduct.{w} D)
private def attachObj (a : A) : FormalCoproduct.{w} D where
  I := (K.obj a).I ⊕ ({s : S.obj a // s ∉ R.obj a} × T.I)
  obj := Sum.elim (K.obj a).obj (fun p => T.obj p.2)

private def attachInl (a : A) : K.obj a ⟶ attachObj K S R T a where
  f := Sum.inl
  φ _ := 𝟙 _

private def attachCell (a : A) (s : S.obj a) (hs : s ∉ R.obj a) :
    T ⟶ attachObj K S R T a where
  f i := Sum.inr (⟨s, hs⟩, i)
  φ _ := 𝟙 _

variable (b : ∀ a, R.obj a → (T ⟶ K.obj a))

/-- The image of an adjoined cell under a transition map, as an index of the enlarged family
together with the component morphism over it: the cell is glued onto the given object once its
boundary datum has entered `R`, and stays a cell otherwise. Packaging the index and the
component together is what makes the component's type match the index without a transport. -/
private noncomputable def attachCellMap {a a' : A} (f : a ⟶ a')
    (p : { s : S.obj a // s ∉ R.obj a } × T.I) :
    Σ j : (attachObj K S R T a').I, T.obj p.2 ⟶ (attachObj K S R T a').obj j := by
  classical
  exact if h : S.map f p.1.1 ∈ R.obj a' then
      ⟨.inl ((b a' ⟨S.map f p.1.1, h⟩).f p.2), (b a' ⟨S.map f p.1.1, h⟩).φ p.2⟩
    else ⟨.inr (⟨S.map f p.1.1, h⟩, p.2), 𝟙 _⟩

private lemma attachCellMap_of_mem {a a' : A} (f : a ⟶ a')
    (p : { s : S.obj a // s ∉ R.obj a } × T.I) (h : S.map f p.1.1 ∈ R.obj a') :
    attachCellMap K S R T b f p =
      ⟨.inl ((b a' ⟨S.map f p.1.1, h⟩).f p.2), (b a' ⟨S.map f p.1.1, h⟩).φ p.2⟩ := by
  classical
  simp only [attachCellMap, h, dite_eq_left_of_eq_true]

private lemma attachCellMap_of_notMem {a a' : A} (f : a ⟶ a')
    (p : { s : S.obj a // s ∉ R.obj a } × T.I) (h : S.map f p.1.1 ∉ R.obj a') :
    attachCellMap K S R T b f p = ⟨.inr (⟨S.map f p.1.1, h⟩, p.2), 𝟙 _⟩ := by
  classical
  simp only [attachCellMap, h, dite_eq_right_of_eq_false]

private noncomputable def attachMap {a a' : A} (f : a ⟶ a') :
    attachObj K S R T a ⟶ attachObj K S R T a' where
  f i := match i with
    | .inl i => .inl ((K.map f).f i)
    | .inr p => (attachCellMap K S R T b f p).1
  φ i := match i with
    | .inl i => (K.map f).φ i
    | .inr p => (attachCellMap K S R T b f p).2

private theorem attachInl_map {a a' : A} (f : a ⟶ a') :
    attachInl K S R T a ≫ attachMap K S R T b f =
      K.map f ≫ attachInl K S R T a' := by
  ext i
  · rfl
  · simp [attachInl, attachMap, attachObj]

private theorem attachCell_map_of_mem {a a' : A} (f : a ⟶ a') (s : S.obj a)
    (hs : s ∉ R.obj a) (h : S.map f s ∈ R.obj a') :
    attachCell K S R T a s hs ≫ attachMap K S R T b f =
      b a' ⟨S.map f s, h⟩ ≫ attachInl K S R T a' := by
  refine hom_ext_sigma fun i => ?_
  obtain ⟨h₁, h₂⟩ := Sigma.ext_iff.mp (attachCellMap_of_mem K S R T b f (⟨s, hs⟩, i) h)
  refine Sigma.ext_iff.mpr ⟨h₁, ?_⟩
  exact ((heq_of_eq (Category.id_comp _)).trans h₂).trans (heq_of_eq (Category.comp_id _).symm)

private theorem attachCell_map_of_notMem {a a' : A} (f : a ⟶ a') (s : S.obj a)
    (hs : s ∉ R.obj a) (h : S.map f s ∉ R.obj a') :
    attachCell K S R T a s hs ≫ attachMap K S R T b f =
      attachCell K S R T a' (S.map f s) h := by
  refine hom_ext_sigma fun i => ?_
  obtain ⟨h₁, h₂⟩ := Sigma.ext_iff.mp (attachCellMap_of_notMem K S R T b f (⟨s, hs⟩, i) h)
  refine Sigma.ext_iff.mpr ⟨h₁, ?_⟩
  exact (heq_of_eq (Category.id_comp _)).trans h₂

private theorem attachObj_hom_ext {a : A} {Z : FormalCoproduct.{w} D}
    {f g : attachObj K S R T a ⟶ Z}
    (hinl : attachInl K S R T a ≫ f = attachInl K S R T a ≫ g)
    (hcell : ∀ (s : S.obj a) (hs : s ∉ R.obj a),
      attachCell K S R T a s hs ≫ f = attachCell K S R T a s hs ≫ g) : f = g := by
  apply (FormalCoproduct.hom_ext_iff' _ _).mpr
  rintro (i | ⟨⟨s, hs⟩, i⟩)
  · obtain ⟨h₁, h₂⟩ := (FormalCoproduct.hom_ext_iff' _ _).mp hinl i
    simp only [attachInl, FormalCoproduct.category_comp_φ] at h₂
    erw [Category.id_comp, Category.id_comp] at h₂
    exact ⟨h₁, h₂⟩
  · obtain ⟨h₁, h₂⟩ := (FormalCoproduct.hom_ext_iff' _ _).mp (hcell s hs) i
    simp only [attachCell, FormalCoproduct.category_comp_φ] at h₂
    erw [Category.id_comp, Category.id_comp] at h₂
    exact ⟨h₁, h₂⟩

private theorem attachMap_id (a : A) : attachMap K S R T b (𝟙 a) = 𝟙 _ := by
  apply attachObj_hom_ext
  · simp [attachInl_map]
  · intro s hs
    rw [attachCell_map_of_notMem _ _ _ _ _ _ _ _ (by simpa using hs)]
    simp

variable (hb : ∀ {a a' : A} (f : a ⟶ a') (s : R.obj a),
  b a s ≫ K.map f = b a' ⟨S.map f s, R.map f s.2⟩)

include hb in
private theorem attachMap_comp {a a' a'' : A} (f : a ⟶ a') (g : a' ⟶ a'') :
    attachMap K S R T b (f ≫ g) = attachMap K S R T b f ≫ attachMap K S R T b g := by
  classical
  apply attachObj_hom_ext
  · rw [attachInl_map, ← Category.assoc, attachInl_map, Category.assoc,
      attachInl_map, K.map_comp, Category.assoc]
  · intro s hs
    by_cases h : S.map f s ∈ R.obj a'
    · have h' : S.map (f ≫ g) s ∈ R.obj a'' := by
        simpa using R.map g h
      rw [attachCell_map_of_mem _ _ _ _ _ _ _ _ h', ← Category.assoc,
        attachCell_map_of_mem _ _ _ _ _ _ _ _ h, Category.assoc,
        attachInl_map, ← Category.assoc, hb]
      simp
    · rw [← Category.assoc, attachCell_map_of_notMem _ _ _ _ _ _ _ _ h]
      by_cases h' : S.map g (S.map f s) ∈ R.obj a''
      · rw [attachCell_map_of_mem _ _ _ _ _ _ _ _ (by simpa using h'),
          attachCell_map_of_mem _ _ _ _ _ _ _ _ h']
        simp
      · rw [attachCell_map_of_notMem _ _ _ _ _ _ _ _ (by simpa using h'),
          attachCell_map_of_notMem _ _ _ _ _ _ _ _ h']
        simp

private noncomputable def attach : A ⥤ FormalCoproduct.{w} D where
  obj := attachObj K S R T
  map := attachMap K S R T b
  map_id := attachMap_id K S R T b
  map_comp := attachMap_comp K S R T b hb

private noncomputable def attachInclusion : K ⟶ attach K S R T b hb where
  app := attachInl K S R T
  naturality _ _ f := (attachInl_map K S R T b f).symm

private theorem finite_attach_indices (a : A)
    [Finite (K.obj a).I] [Finite (S.obj a)] [Finite T.I] :
    Finite ((attach K S R T b hb).obj a).I := by
  show Finite ((K.obj a).I ⊕ ({s : S.obj a // s ∉ R.obj a} × T.I))
  infer_instance

private theorem attach_obj_mem (B : Set D) (hK : ∀ a i, (K.obj a).obj i ∈ B)
    (hT : ∀ i, T.obj i ∈ B) (a : A) (i : ((attach K S R T b hb).obj a).I) :
    ((attach K S R T b hb).obj a).obj i ∈ B := by
  rcases i with i | ⟨s, i⟩
  · exact hK a i
  · exact hT i

private theorem isIso_attachInclusion_app (a : A) (hR : R.obj a = Set.univ) :
    IsIso ((attachInclusion K S R T b hb).app a) := by
  classical
  let f : attachObj K S R T a ⟶ K.obj a :=
    { f := Sum.elim id (fun p => False.elim (p.1.2 (by simp [hR])))
      φ := fun i => match i with
        | .inl i => 𝟙 _
        | .inr p => False.elim (p.1.2 (by simp [hR])) }
  refine ⟨⟨f, ?_, ?_⟩⟩
  · ext i <;> simp [attachInclusion, attachInl, f, attachObj, attach]
  · apply (FormalCoproduct.hom_ext_iff' _ _).mpr
    rintro (i | p)
    · refine ⟨rfl, ?_⟩
      simp [attachInclusion, attachInl, f, attachObj, attach]
    · exact False.elim (p.1.2 (by simp [hR]))

variable {L : A ⥤ FormalCoproduct.{w} D} (f : K ⟶ L)
    (t : ∀ a, S.obj a → (T ⟶ L.obj a))

private def attachDescApp (a : A) : attachObj K S R T a ⟶ L.obj a where
  f := Sum.elim (f.app a).f (fun p => (t a p.1.1).f p.2)
  φ := fun i => match i with
    | .inl i => (f.app a).φ i
    | .inr p => (t a p.1.1).φ p.2

private theorem attachInl_desc (a : A) :
    attachInl K S R T a ≫ attachDescApp K S R T f t a = f.app a := by
  ext i <;> simp [attachInl, attachDescApp, attachObj]

private theorem attachCell_desc (a : A) (s : S.obj a) (hs : s ∉ R.obj a) :
    attachCell K S R T a s hs ≫ attachDescApp K S R T f t a = t a s := by
  ext i <;> simp [attachCell, attachDescApp, attachObj]

variable (ht : ∀ {a a' : A} (g : a ⟶ a') (s : S.obj a),
    t a s ≫ L.map g = t a' (S.map g s))
  (hbt : ∀ a (s : R.obj a), b a s ≫ f.app a = t a s)

private noncomputable def attachDesc : attach K S R T b hb ⟶ L where
  app := attachDescApp K S R T f t
  naturality a a' g := by
    classical
    dsimp only [attach]
    apply attachObj_hom_ext K S R T
    · rw [← Category.assoc, attachInl_map, Category.assoc,
        attachInl_desc, ← Category.assoc, attachInl_desc]
      exact f.naturality g
    · intro s hs
      by_cases h : S.map g s ∈ R.obj a'
      · rw [← Category.assoc, attachCell_map_of_mem _ _ _ _ _ _ _ _ h,
          Category.assoc, attachInl_desc, hbt, ← Category.assoc, attachCell_desc, ht]
      · rw [← Category.assoc, attachCell_map_of_notMem _ _ _ _ _ _ _ _ h,
          attachCell_desc, ← Category.assoc, attachCell_desc, ht]

end Attach

private theorem exists_finite_matching_extension
    {D : Type u} [Category.{v} D]
    (K : SimplicialObject (FormalCoproduct.{w} D)) (B : Set D) (n : ℕ)
    [∀ F : (SimplexCategory.Truncated n)ᵒᵖ ⥤ FormalCoproduct.{w} D,
      (SimplexCategory.Truncated.inclusion n).op.HasPointwiseRightKanExtension F]
    (hK : ∀ a, Finite (K.obj a).I ∧ ∀ i, (K.obj a).obj i ∈ B)
    (T : FormalCoproduct.{w} D) [Finite T.I] (hT : ∀ i, T.obj i ∈ B)
    (q : T ⟶ ((SimplicialObject.cosk n).obj K).obj (op ⦋n + 1⦌)) :
    ∃ (K' : SimplicialObject (FormalCoproduct.{w} D)) (i : K ⟶ K')
      (d : K' ⟶ (SimplicialObject.cosk n).obj K) (e : T ⟶ K'.obj (op ⦋n + 1⦌)),
      IsIso ((SimplicialObject.truncation n).map i) ∧
      i ≫ d = (SimplicialObject.coskAdj n).unit.app K ∧
      e ≫ d.app (op ⦋n + 1⦌) = q ∧
      Function.Injective e.f ∧ (∀ j, IsIso (e.φ j)) ∧
      ∀ a, Finite (K'.obj a).I ∧ ∀ j, (K'.obj a).obj j ∈ B := by
  classical
  let S : SSet.{w} := Δ[n + 1]
  let Sh : SSet.{max w v} := Δ[n + 1]
  let Rh := Sh.skeleton (n + 1)
  let up := fun a (s : S.obj a) => (⟨s.down⟩ : Sh.obj a)
  let R : Subfunctor S :=
    { obj := fun a => {s | up a s ∈ Rh.obj a}
      map := fun f s h => Rh.map f h }
  let c := (SimplicialObject.coskAdj n).unit.app K
  obtain ⟨b, hb⟩ := exists_matching_boundary K n T q
  let b₀ := fun a (s : R.obj a) => b.app a ⟨up a s, s.2⟩
  have hb₀ : ∀ {a a'} (f : a ⟶ a') (s : R.obj a),
      b₀ a s ≫ K.map f = b₀ a' ⟨S.map f s, R.map f s.2⟩ :=
    fun f s => (NatTrans.naturality_apply b f ⟨up _ s, s.2⟩).symm
  let τ : Sh ⟶ (SimplicialObject.cosk n).obj K ⋙ coyoneda.obj (op T) :=
    SSet.yonedaEquiv.symm q
  let t := fun a (s : S.obj a) => τ.app a (up a s)
  have ht : ∀ {a a'} (f : a ⟶ a') (s : S.obj a),
      t a s ≫ ((SimplicialObject.cosk n).obj K).map f = t a' (S.map f s) :=
    fun f s => (NatTrans.naturality_apply τ f (up _ s)).symm
  have hbt : ∀ a (s : R.obj a), b₀ a s ≫ c.app a = t a s :=
    fun a s => congrArg (fun f => f ⟨up a s, s.2⟩) (NatTrans.congr_app hb a)
  let K' := attach K S R T b₀ hb₀
  let i := attachInclusion K S R T b₀ hb₀
  let d := attachDesc K S R T b₀ hb₀ c t ht hbt
  let x : S.obj (op ⦋n + 1⦌) := SSet.stdSimplex.objEquiv.symm (𝟙 ⦋n + 1⦌)
  have hx : x ∉ R.obj (op ⦋n + 1⦌) := fun hmem ↦
    Nat.lt_irrefl (n + 1) ((Sh.mem_skeleton_obj_iff_of_nonDegenerate
      ⟨up _ x, SSet.stdSimplex.objEquiv_symm_id_mem_nonDegenerate (n + 1)⟩ (n + 1)).mp hmem)
  refine ⟨K', i, d, attachCell K S R T _ x hx, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · have : ∀ a, IsIso (((SimplicialObject.truncation n).map i).app a) := fun a =>
      isIso_attachInclusion_app K S R T b₀ hb₀ _ (by
        ext s
        simp only [Set.mem_univ, iff_true]
        show up _ s ∈ Rh.obj _
        exact (Sh.skeleton_obj_eq_top (Nat.lt_succ_of_le a.unop.property)) ▸ Set.mem_univ _)
    apply NatIso.isIso_of_isIso_app
  · apply NatTrans.ext
    funext a
    exact attachInl_desc K S R T c t a
  · show attachCell K S R T _ x hx ≫ attachDescApp K S R T c t _ = q
    rw [attachCell_desc]
    show q ≫ ((SimplicialObject.cosk n).obj K).map (𝟙 (op ⦋n + 1⦌)) = q
    simp
  · exact fun _ _ h => congrArg Prod.snd (Sum.inr.inj h)
  · exact fun _ => IsIso.id _
  · intro a
    have := (hK a).1
    have : Finite (S.obj a) := by dsimp [S]; infer_instance
    exact ⟨finite_attach_indices K S R T b₀ hb₀ a,
      attach_obj_mem K S R T b₀ hb₀ B (fun a => (hK a).2) hT a⟩

private theorem exists_finite_cover_formalCoproduct
    {C : Type u} [Category.{v} C] [HasPullbacks C] {X : C}
    (J : Pretopology C) (B : Set C)
    (exists_finite_cover : ∀ Y : C,
      ∃ (I : Type w) (U : I → C) (f : ∀ i, U i ⟶ Y),
        Finite I ∧ (∀ i, B (U i)) ∧ Presieve.ofArrows U f ∈ J Y)
    (A : FormalCoproduct.{w} (Over X)) [Finite A.I] :
    ∃ (T : FormalCoproduct.{w} (Over X)) (f : T ⟶ A),
      Finite T.I ∧ (∀ i, (T.obj i).left ∈ B) ∧ IsCoveringOver J f := by
  classical
  choose I U f hI hB hcover using fun j : A.I => exists_finite_cover (A.obj j).left
  let T : FormalCoproduct.{w} (Over X) :=
    ⟨(j : A.I) × I j, fun p => Over.mk (f p.1 p.2 ≫ (A.obj p.1).hom)⟩
  let q : T ⟶ A :=
    { f := fun p => p.1
      φ := fun p => Over.homMk (f p.1 p.2) (by simp [T]) }
  refine ⟨T, q, ?_, ?_, ?_⟩
  · infer_instance
  · exact fun p => hB p.1 p.2
  · intro j
    let e : {p : T.I // q.f p = j} ≃ I j :=
      { toFun := fun p => cast (congrArg I p.2) p.1.2
        invFun := fun i => ⟨⟨j, i⟩, rfl⟩
        left_inv := by
          rintro ⟨⟨j', i⟩, hj⟩
          dsimp [q] at hj
          subst j'
          rfl
        right_inv := fun _ => rfl }
    let Z (i : {p : T.I // q.f p = j}) := (T.obj i.1).left
    let a (i : {p : T.I // q.f p = j}) :=
      (q.φ i.1).left ≫ eqToHom (congrArg (fun k => (A.obj k).left) i.2)
    let Y (i : {p : T.I // q.f p = j}) := U j (e i)
    let b (i : {p : T.I // q.f p = j}) := f j (e i)
    have hobj (i : {p : T.I // q.f p = j}) : Z i = Y i := by
      rcases i with ⟨⟨j', k⟩, hj⟩
      dsimp [q] at hj
      subst j'
      simp [Z, Y, T, e]
    have harrow (i : {p : T.I // q.f p = j}) :
        a i = eqToHom (hobj i) ≫ b i := by
      rcases i with ⟨⟨j', k⟩, hj⟩
      dsimp [q] at hj
      subst j'
      simp [a, b, Z, Y, T, q, e]
    have hpres : Presieve.ofArrows Z a = Presieve.ofArrows Y b := by
      funext V g
      apply propext
      constructor
      · rintro ⟨i⟩
        exact Presieve.ofArrows.mk' i (hobj i) (harrow i)
      · rintro ⟨k⟩
        exact Presieve.ofArrows.mk' k (hobj k).symm (by rw [harrow k]; simp)
    show Presieve.ofArrows Z a ∈ J (A.obj j).left
    rw [hpres]
    show Presieve.ofArrows (U j ∘ e) (fun i => f j (e i)) ∈ J (A.obj j).left
    rw [Presieve.ofArrows_comp_eq_of_surjective (f j) e.surjective]
    exact hcover j

private theorem ofArrows_adjoin_eq_sup.{z}
    {C : Type u} [Category.{v} C] {X V : C} {I : Type w}
    (U : I → C) (f : ∀ i, U i ⟶ X) (g : V ⟶ X) :
    Presieve.ofArrows (Sum.elim U (fun _ : PUnit.{z + 1} => V))
      (fun i : Sum I PUnit.{z + 1} => match i with | .inl i => f i | .inr _ => g) =
      Presieve.ofArrows U f ⊔ Presieve.singleton g := by
  funext Y a
  apply propext
  constructor
  · rintro ⟨i | i⟩
    · exact Or.inl (Presieve.ofArrows.mk i)
    · exact Or.inr (Presieve.singleton_self _)
  · intro h
    change Presieve.ofArrows U f a ∨ Presieve.singleton g a at h
    rcases h with h | h
    · obtain ⟨i⟩ := h
      exact Presieve.ofArrows.mk (Sum.inl i : I ⊕ PUnit.{z + 1})
    · cases h
      exact Presieve.ofArrows.mk (Sum.inr PUnit.unit : I ⊕ PUnit.{z + 1})

/-- The family of arrows indexed by `insert i s` is the family indexed by `s` together with the
arrow indexed by `i`. -/
theorem ofArrows_subtype_insert {C : Type u} [Category.{v} C] {X : C} {H : Type w}
    [DecidableEq H] (V : H → C) (g : ∀ i, V i ⟶ X) (i : H) (s : Finset H) :
    Presieve.ofArrows (fun k : {k // k ∈ insert i s} => V k) (fun k => g k) =
      Presieve.ofArrows (fun k : {k // k ∈ s} => V k) (fun k => g k) ⊔
        Presieve.singleton (g i) := by
  funext Y k
  apply propext
  constructor
  · rintro ⟨⟨j, hj⟩⟩
    rcases Finset.mem_insert.mp hj with rfl | hj
    · exact Or.inr (Presieve.singleton_self _)
    · exact Or.inl (Presieve.ofArrows.mk (⟨j, hj⟩ : {k // k ∈ s}))
  · intro h
    change Presieve.ofArrows _ _ k ∨ Presieve.singleton (g i) k at h
    rcases h with ⟨⟨j, hj⟩⟩ | h
    · exact Presieve.ofArrows.mk (⟨j, Finset.mem_insert_of_mem hj⟩ : {k // k ∈ insert i s})
    · cases h
      exact Presieve.ofArrows.mk (⟨i, Finset.mem_insert_self _ _⟩ : {k // k ∈ insert i s})

private abbrev FiniteAdjoin {C : Type u} [Category.{v} C] [HasPullbacks C]
    (J : Pretopology C) (B : Set C) : Prop :=
  ∀ {X : C} {I : Type w} (U : I → C) (f : ∀ i, U i ⟶ X),
    Finite I → (∀ i, B (U i)) → Presieve.ofArrows U f ∈ J X →
    ∀ (V : C) (g : V ⟶ X), B V →
      Presieve.ofArrows (Sum.elim U (fun _ : PUnit.{w + 1} => V))
        (fun i : Sum I PUnit.{w + 1} => match i with | .inl i => f i | .inr _ => g) ∈ J X

private theorem finiteAdjoin_of_cover_of_adjoin {C : Type u} [Category.{v} C] [HasPullbacks C]
    (J : Pretopology C) (B : Set C)
    (cover_of_adjoin : ∀ {X : C} {I : Type w} (U : I → C) (f : ∀ i, U i ⟶ X),
      Finite I → (∀ i, B (U i)) → Presieve.ofArrows U f ∈ J X →
      ∀ (V : C) (g : V ⟶ X), B V →
        Presieve.ofArrows
          (fun i : Sum I PUnit ↦ match i with | Sum.inl i => U i | Sum.inr _ => V)
          (fun i : Sum I PUnit ↦ match i with | Sum.inl i => f i | Sum.inr _ => g) ∈ J X) :
    FiniteAdjoin.{w} J B := by
  intro Y H V g hH hV hg W a hW
  have h := cover_of_adjoin V g hH hV hg W a hW
  have he : Presieve.ofArrows V g ⊔ Presieve.singleton a ∈ J Y := by
    convert h using 1
    funext Z b
    apply propext
    constructor
    · intro hb
      change Presieve.ofArrows V g b ∨ Presieve.singleton a b at hb
      rcases hb with hb | hb
      · obtain ⟨i⟩ := hb
        exact Presieve.ofArrows.mk (Sum.inl i)
      · cases hb
        exact Presieve.ofArrows.mk (Sum.inr PUnit.unit)
    · rintro ⟨i | i⟩
      · exact Or.inl (Presieve.ofArrows.mk i)
      · exact Or.inr (Presieve.singleton_self _)
  exact (ofArrows_adjoin_eq_sup V g a).symm ▸ he

private theorem finite_cover_sup {C : Type u} [Category.{v} C] [HasPullbacks C]
    (J : Pretopology C) (B : Set C) (hJ : FiniteAdjoin.{w} J B)
    {X : C} {I H : Type w} [Finite I] [Finite H]
    (U : I → C) (f : ∀ i, U i ⟶ X) (hU : ∀ i, B (U i))
    (hf : Presieve.ofArrows U f ∈ J X)
    (V : H → C) (g : ∀ i, V i ⟶ X) (hV : ∀ i, B (V i)) :
    Presieve.ofArrows U f ⊔ Presieve.ofArrows V g ∈ J X := by
  classical
  let P := fun (s : Finset H) =>
    ∃ (A : Type w) (W : A → C) (a : ∀ i, W i ⟶ X),
      Finite A ∧ (∀ i, B (W i)) ∧ Presieve.ofArrows W a ∈ J X ∧
      Presieve.ofArrows W a = Presieve.ofArrows U f ⊔
        Presieve.ofArrows (fun i : {i // i ∈ s} => V i) (fun i => g i)
  have hp : ∀ s, P s := by
    intro s
    induction s using Finset.induction_on with
    | empty =>
      refine ⟨I, U, f, inferInstance, hU, hf, ?_⟩
      funext Y a
      apply propext
      constructor
      · exact Or.inl
      · intro h
        change Presieve.ofArrows U f a ∨ _ at h
        rcases h with h | h
        · exact h
        · cases h with
          | mk i => exact False.elim (Finset.notMem_empty _ i.2)
    | @insert i s hi ih =>
      obtain ⟨A, W, a, hA, hW, ha, he⟩ := ih
      refine ⟨A ⊕ PUnit, Sum.elim W (fun _ => V i),
        (fun j => match j with | .inl j => a j | .inr _ => g i),
        inferInstance, ?_, hJ W a hA hW ha _ (g i) (hV i), ?_⟩
      · rintro (j | j)
        · exact hW j
        · exact hV i
      · refine (ofArrows_adjoin_eq_sup W a (g i)).trans ?_
        rw [he, ofArrows_subtype_insert, sup_assoc]
  let := Fintype.ofFinite H
  obtain ⟨A, W, a, _, _, ha, he⟩ := hp Finset.univ
  rw [he] at ha
  have heq : Presieve.ofArrows (fun i : {i // i ∈ (Finset.univ : Finset H)} => V i)
      (fun i => g i) = Presieve.ofArrows V g :=
    Presieve.ofArrows_comp_eq_of_surjective g
      (show Function.Surjective (fun i : {i // i ∈ (Finset.univ : Finset H)} => i.1) from
        fun i => ⟨⟨i, Finset.mem_univ _⟩, rfl⟩)
  rwa [heq] at ha

private theorem finite_cover_mono {C : Type u} [Category.{v} C] [HasPullbacks C]
    (J : Pretopology C) (B : Set C) (hJ : FiniteAdjoin.{w} J B)
    {X : C} {I H : Type w} [Finite I] [Finite H]
    (U : I → C) (f : ∀ i, U i ⟶ X) (hU : ∀ i, B (U i))
    (hf : Presieve.ofArrows U f ∈ J X)
    (V : H → C) (g : ∀ i, V i ⟶ X) (hV : ∀ i, B (V i))
    (h : Presieve.ofArrows U f ≤ Presieve.ofArrows V g) :
    Presieve.ofArrows V g ∈ J X := by
  simpa only [sup_eq_right.mpr h] using finite_cover_sup J B hJ U f hU hf V g hV

private theorem finite_cover_of_iso_refinement
    {C : Type u} [Category.{v} C] [HasPullbacks C]
    (J : Pretopology C) (B : Set C) (hJ : FiniteAdjoin.{w} J B)
    {X : C} {I H : Type w} [Finite I] [Finite H]
    (U : I → C) (f : ∀ i, U i ⟶ X) (hf : Presieve.ofArrows U f ∈ J X)
    (V : H → C) (g : ∀ i, V i ⟶ X) (hV : ∀ i, B (V i))
    (r : I → H) (e : ∀ i, U i ≅ V (r i)) (he : ∀ i, f i = (e i).hom ≫ g (r i)) :
    Presieve.ofArrows V g ∈ J X := by
  classical
  let W := fun {Y} (a : Y ⟶ X) (h : Presieve.ofArrows U f a) (_ : PUnit.{w + 1}) =>
    V (r h.idx)
  let b := fun {Y} (a : Y ⟶ X) (h : Presieve.ofArrows U f a) (_ : PUnit.{w + 1}) =>
    (e h.idx).inv ≫ eqToHom h.obj_idx
  have hb : ∀ {Y} (a : Y ⟶ X) (h : Presieve.ofArrows U f a) (k : PUnit.{w + 1}),
      b a h k ≫ a = g (r h.idx) := by
    intro Y a h k
    dsimp [b]
    rw [Category.assoc, ← h.hom_idx, he]
    simp
  have hc := J.transitive (Presieve.ofArrows U f)
    (fun _ a h => Presieve.ofArrows (W a h) (b a h)) hf (by
      intro Y a h
      rw [Presieve.ofArrows_pUnit]
      exact J.has_isos _)
  rw [Presieve.ofArrows_bind] at hc
  apply finite_cover_mono J B hJ _ _ (fun k => hV _) hc V g hV
  intro Y a ha
  cases ha with
  | mk k =>
    rw [hb (f k.1) (Presieve.ofArrows.mk k.1) k.2]
    exact Presieve.ofArrows.mk _

private theorem cover_postcomp_iso {C : Type u} [Category.{v} C] [HasPullbacks C]
    (J : Pretopology C) {X Y : C} {I : Type w}
    (U : I → C) (f : ∀ i, U i ⟶ X) (hf : Presieve.ofArrows U f ∈ J X)
    (e : X ≅ Y) : Presieve.ofArrows U (fun i => f i ≫ e.hom) ∈ J Y := by
  let S := Presieve.singleton e.hom
  let T : ∀ {Z} (g : Z ⟶ Y), S g → Presieve Z := fun {Z} g h => by
    cases h
    exact Presieve.ofArrows U f
  have ht := J.transitive S (fun _ g h => T g h) (J.has_isos e.hom) (by
    intro Z g h
    cases h
    exact hf)
  convert ht using 1
  funext Z g
  apply propext
  constructor
  · rintro ⟨i⟩
    exact ⟨X, f i, e.hom, Presieve.singleton_self _, Presieve.ofArrows.mk i, rfl⟩
  · rintro ⟨Z, a, b, hb, ha, rfl⟩
    cases hb
    obtain ⟨i⟩ := ha
    exact Presieve.ofArrows.mk i

private theorem isIso_component {D : Type u} [Category.{v} D]
    {A B : FormalCoproduct.{w} D} (f : A ⟶ B) [IsIso f] (i : A.I) :
    IsIso (f.φ i) := by
  let g := inv f
  have hfg (i : A.I) : g.f (f.f i) = i :=
    congrArg (fun q : A ⟶ A => q.f i) (IsIso.hom_inv_id f)
  let k : B.obj (f.f i) ⟶ A.obj i := g.φ (f.f i) ≫ eqToHom (congrArg A.obj (hfg i))
  refine ⟨⟨k, ?_, ?_⟩⟩
  · obtain ⟨_, h⟩ := (FormalCoproduct.hom_ext_iff' _ _).mp (IsIso.hom_inv_id f) i
    simpa [k, g] using h
  · obtain ⟨_, h⟩ := (FormalCoproduct.hom_ext_iff' _ _).mp (IsIso.inv_hom_id f) (f.f i)
    simpa [k, g, hfg i, Category.assoc] using h

private theorem covering_of_factorization
    {C : Type u} [Category.{v} C] [HasPullbacks C] {X : C}
    (J : Pretopology C) (B : Set C) (hJ : FiniteAdjoin.{w} J B)
    {T A Z : FormalCoproduct.{w} (Over X)} [Finite T.I] [Finite A.I]
    (e : T ⟶ A) (d : A ⟶ Z) (hA : ∀ i, B (A.obj i).left)
    (he : ∀ i, IsIso (e.φ i)) (hq : IsCoveringOver J (e ≫ d)) :
    IsCoveringOver J d := by
  intro j
  let r : {i : T.I // (e ≫ d).f i = j} → {i : A.I // d.f i = j} :=
    fun i => ⟨e.f i, i.2⟩
  let ei (i : {i : T.I // (e ≫ d).f i = j}) :
      (T.obj i.1).left ≅ (A.obj (r i).1).left := by
    have := he i.1
    exact (Over.forget X).mapIso (asIso (e.φ i.1))
  exact finite_cover_of_iso_refinement J B hJ _ _ (hq j) _ _
    (fun i => hA i.1) r ei (fun i => by simp [ei, r, Category.assoc])

private theorem covering_postcomp_iso
    {C : Type u} [Category.{v} C] [HasPullbacks C] {X : C}
    (J : Pretopology C) (B : Set C) (hJ : FiniteAdjoin.{w} J B)
    {T A Z : FormalCoproduct.{w} (Over X)} [Finite T.I]
    (q : T ⟶ A) (e : A ⟶ Z) [IsIso e] (hT : ∀ i, B (T.obj i).left)
    (hq : IsCoveringOver J q) : IsCoveringOver J (q ≫ e) := by
  intro j
  let k := (inv e).f j
  have hk : e.f k = j := congrArg (fun f => f.f j) (IsIso.inv_hom_id e)
  have := isIso_component e k
  let γ : (A.obj k).left ≅ (Z.obj j).left :=
    (Over.forget X).mapIso (asIso (e.φ k)) ≪≫ eqToIso (congrArg (fun k => (Z.obj k).left) hk)
  have hc := cover_postcomp_iso J _ _ (hq k) γ
  refine finite_cover_mono J B hJ
    (I := {i : T.I // q.f i = k}) (H := {i : T.I // (q ≫ e).f i = j})
    _ _ (fun i => hT i.1) hc _ _ (fun i => hT i.1) ?_
  intro Y a ha
  obtain ⟨i⟩ := ha
  let hi : (q ≫ e).f i.1 = j := (congrArg e.f i.2).trans hk
  refine Presieve.ofArrows.mk' (⟨i.1, hi⟩ : {i // (q ≫ e).f i = j}) rfl ?_
  dsimp [γ]
  have h := congrArg (fun f => f.left) (eqToHom_naturality e.φ i.2)
  simpa [Category.assoc] using congrArg
    (fun f => (q.φ i.1).left ≫ f ≫ eqToHom (congrArg (fun k => (Z.obj k).left) hk)) h.symm

/-- A morphism of simplicial objects that is an isomorphism on the `n`-truncation induces an
isomorphism on the `n`-coskeleta. -/
private theorem isIso_cosk_map {D : Type u} [Category.{v} D] {K L : SimplicialObject D}
    (f : K ⟶ L) (n : ℕ) [IsIso ((SimplicialObject.truncation n).map f)]
    [∀ F : (SimplexCategory.Truncated n)ᵒᵖ ⥤ D,
      (SimplexCategory.Truncated.inclusion n).op.HasRightKanExtension F] :
    IsIso ((SimplicialObject.cosk n).map f) := by
  change IsIso ((SimplicialObject.Truncated.cosk n).map ((SimplicialObject.truncation n).map f))
  infer_instance

private theorem matching_cover_transfer
    {C : Type u} [Category.{v} C] [HasPullbacks C] {X : C}
    (J : Pretopology C) (B : Set C) (hJ : FiniteAdjoin.{w} J B)
    {K L : SimplicialObject (FormalCoproduct.{w} (Over X))} (f : K ⟶ L) (n : ℕ)
    [IsIso ((SimplicialObject.truncation n).map f)] [IsIso (f.app (op ⦋n + 1⦌))]
    [Finite (K.obj (op ⦋n + 1⦌)).I] [Finite (L.obj (op ⦋n + 1⦌)).I]
    (hK : ∀ i, B ((K.obj (op ⦋n + 1⦌)).obj i).left)
    (hL : ∀ i, B ((L.obj (op ⦋n + 1⦌)).obj i).left)
    (h : IsCoveringOver J
      (((SimplicialObject.coskAdj n).unit.app K).app (op ⦋n + 1⦌))) :
    IsCoveringOver J
      (((SimplicialObject.coskAdj n).unit.app L).app (op ⦋n + 1⦌)) := by
  have := isIso_cosk_map f n
  have hc := covering_postcomp_iso J B hJ _
    (((SimplicialObject.cosk n).map f).app (op ⦋n + 1⦌)) hK h
  have hn := NatTrans.congr_app ((SimplicialObject.coskAdj n).unit.naturality f) (op ⦋n + 1⦌)
  dsimp at hn
  exact covering_of_factorization J B hJ (f.app _) _ hL
    (fun i => isIso_component _ i) (hn.symm ▸ hc)

private theorem exists_finite_covering_extension
    {C : Type u} [Category.{v} C] [HasPullbacks C] {X : C}
    (J : Pretopology C) (B : Set C) (hJ : FiniteAdjoin.{w} J B)
    (hcover : ∀ Y : C, ∃ (I : Type w) (U : I → C) (f : ∀ i, U i ⟶ Y),
      Finite I ∧ (∀ i, B (U i)) ∧ Presieve.ofArrows U f ∈ J Y)
    (K : SimplicialObject (FormalCoproduct.{w} (Over X))) (n : ℕ)
    (hK : ∀ a, Finite (K.obj a).I ∧ ∀ i, B ((K.obj a).obj i).left) :
    ∃ (L : SimplicialObject (FormalCoproduct.{w} (Over X))) (f : K ⟶ L),
      IsIso ((SimplicialObject.truncation n).map f) ∧
      (∀ a, Finite (L.obj a).I ∧ ∀ i, B ((L.obj a).obj i).left) ∧
      IsCoveringOver J
        (((SimplicialObject.coskAdj n).unit.app L).app (op ⦋n + 1⦌)) := by
  let : HasFiniteLimits (Over X) := hasFiniteLimits_of_hasTerminal_and_pullbacks
  have := finite_cosk_indices K n (fun m _ => (hK _).1) (op ⦋n + 1⦌)
  obtain ⟨T, q, hT, hBT, hq⟩ := exists_finite_cover_formalCoproduct J B hcover
    (((SimplicialObject.cosk n).obj K).obj (op ⦋n + 1⦌))
  obtain ⟨L, f, d, e, hf, hfd, hed, _, he, hL⟩ :=
    exists_finite_matching_extension K {A | B A.left} n hK T hBT q
  have hLf := (hL (op ⦋n + 1⦌)).1
  have hd : IsCoveringOver J (d.app (op ⦋n + 1⦌)) :=
    covering_of_factorization J B hJ e _ (hL _).2 he (hed.symm ▸ hq)
  have := isIso_cosk_map f n
  refine ⟨L, f, hf, hL, ?_⟩
  have hc := covering_postcomp_iso J B hJ _
    (((SimplicialObject.cosk n).map f).app (op ⦋n + 1⦌)) (hL _).2 hd
  have h := NatTrans.congr_app
    (comp_map_eq_unit (SimplicialObject.coskAdj n) f d hfd) (op ⦋n + 1⦌)
  exact h ▸ hc

private theorem initial_cover
    {C : Type u} [Category.{v} C] [HasPullbacks C] {X : C}
    (J : Pretopology C) (B : Set C) (hJ : FiniteAdjoin.{w} J B)
    {I : Type w} [Finite I] (U : I → C) (f : ∀ i, U i ⟶ X)
    (hU : ∀ i, B (U i)) (hf : Presieve.ofArrows U f ∈ J X) :
    IsCoveringOver J
      (terminal.from (⟨I, fun i => Over.mk (f i)⟩ : FormalCoproduct.{w} (Over X))) := by
  let A : FormalCoproduct.{w} (Over X) := ⟨I, fun i => Over.mk (f i)⟩
  let Z := (FormalCoproduct.incl (Over X)).obj (Over.mk (𝟙 X))
  let q : A ⟶ Z :=
    { f := fun _ => PUnit.unit
      φ := fun i => Over.homMk (f i) (by
        show f i ≫ (Over.mk (𝟙 X)).hom = (Over.mk (f i)).hom
        simp) }
  have hq : IsCoveringOver J q := by
    have : Subsingleton Z.I := inferInstanceAs (Subsingleton PUnit)
    intro j
    have heq : Presieve.ofArrows
        (fun i : {i : I // q.f i = j} => U i.1)
        (fun i => f i.1) = Presieve.ofArrows U f :=
      Presieve.ofArrows_comp_eq_of_surjective f (fun i => ⟨⟨i, Subsingleton.elim _ _⟩, rfl⟩)
    have hgoal : Presieve.ofArrows (fun i : {i : I // q.f i = j} => U i.1)
        (fun i => f i.1) ∈ J X := by rwa [heq]
    -- The transport along `i.2` is a transport between definitionally equal objects, so it is
    -- the identity; the displayed family of arrows is therefore the given one.
    have harrow : (fun i : {i : A.I // q.f i = j} =>
          (q.φ i.1).left ≫ eqToHom (congrArg (fun k => (Z.obj k).left) i.2)) =
        fun i : {i : A.I // q.f i = j} => f i.1 :=
      funext fun i => Category.comp_id ((q.φ i.1).left)
    rw [harrow]
    exact hgoal
  let e := (FormalCoproduct.isTerminalIncl (Over.mk (𝟙 X)) Over.mkIdTerminal).uniqueUpToIso
    terminalIsTerminal
  have hc := covering_postcomp_iso J B hJ q e.hom hU hq
  have he : q ≫ e.hom = terminal.from A := terminalIsTerminal.hom_ext _ _
  exact he ▸ hc


end FiniteConstruction

open FiniteConstruction

-- Preserve the accepted statement's category-to-quiver instance for arrow notation.
attribute [-instance] CategoryTheory.ReflQuiver.toQuiver in
/-- **Stacks Project, Tag 094K.** If a class `B` supplies finite coverings and every such
covering remains covering after adjoining one further arrow from an object of `B`, then every
object has a hypercovering whose family in every degree is finite and consists of objects of
`B`. -/
@[stacks 094K]
theorem exists_finite_hypercovering
    {C : Type u} [Category.{v} C] [HasPullbacks C] (J : Pretopology C) (B : Set C)
    (exists_finite_cover : ∀ X : C,
      ∃ (I : Type w) (U : I → C) (f : ∀ i, U i ⟶ X),
        Finite I ∧ (∀ i, B (U i)) ∧ Presieve.ofArrows U f ∈ J X)
    (cover_of_adjoin : ∀ {X : C} {I : Type w} (U : I → C) (f : ∀ i, U i ⟶ X),
      Finite I → (∀ i, B (U i)) → Presieve.ofArrows U f ∈ J X →
      ∀ (V : C) (g : V ⟶ X), B V →
        Presieve.ofArrows
          (fun i : Sum I PUnit ↦ match i with | Sum.inl i => U i | Sum.inr _ => V)
          (fun i : Sum I PUnit ↦ match i with | Sum.inl i => f i | Sum.inr _ => g) ∈ J X) :
    ∀ X : C, ∃ K : SimplicialObject (FormalCoproduct.{w} (Over X)),
      IsHypercovering J K ∧
        ∀ n : ℕ, Finite (K.obj (Opposite.op ⦋n⦌)).I ∧
          ∀ i, B ((K.obj (Opposite.op ⦋n⦌)).obj i).left := by
  classical
  have hadjoin : FiniteAdjoin.{w} J B := finiteAdjoin_of_cover_of_adjoin J B cover_of_adjoin
  intro X
  let : HasFiniteLimits (Over X) := hasFiniteLimits_of_hasTerminal_and_pullbacks
  obtain ⟨I, U, f, hI, hB, hJ⟩ := exists_finite_cover X
  let T : FormalCoproduct.{w} (Over X) := ⟨I, fun i => Over.mk (f i)⟩
  let Good := fun K : SimplicialObject (FormalCoproduct.{w} (Over X)) =>
    ∀ a, Finite (K.obj a).I ∧ ∀ i, B ((K.obj a).obj i).left
  have hs : ∀ n (K : {K // Good K}),
      ∃ (L : {K // Good K}) (f : K.1 ⟶ L.1),
        IsIso ((SimplicialObject.truncation n).map f) ∧
        IsCoveringOver J
          (((SimplicialObject.coskAdj n).unit.app L.1).app (op ⦋n + 1⦌)) := fun n K =>
    let ⟨L, f, hf, hL, hc⟩ :=
      exists_finite_covering_extension J B hadjoin exists_finite_cover K.1 n K.2
    ⟨⟨L, hL⟩, f, hf, hc⟩
  choose next incl htr hcov using hs
  let seq : ℕ → {K // Good K} :=
    Nat.rec ⟨(SimplicialObject.const _).obj T, fun _ => ⟨hI, hB⟩⟩ (fun n K => next n K)
  let F : ℕ ⥤ SimplicialObject (FormalCoproduct.{w} (Over X)) :=
    Functor.ofSequence (fun n => incl n (seq n))
  have hGoodF (n : ℕ) : Good (F.obj n) := (seq n).2
  have hF : ∀ n, IsIso ((SimplicialObject.truncation n).map
      (F.map (homOfLE (Nat.le_succ n)))) := by
    intro n
    rw [show F.map (homOfLE (Nat.le_succ n)) = incl n (seq n) from
      Functor.ofSequence_map_homOfLE_succ _ n]
    exact htr n (seq n)
  obtain ⟨K, ι, hobj, hι, -⟩ := exists_stabilized_simplicial_object F hF
  have hK : Good K := by
    intro a
    rw [hobj a]
    exact (seq a.unop.len).2 a
  refine ⟨K, ⟨?_, ?_⟩, fun n => hK _⟩
  · have := (hK (op ⦋0⦌)).1
    have := (hGoodF 0 (op ⦋0⦌)).1
    have := hι 0 (op ⦋0⦌) (by rfl)
    apply covering_of_factorization J B hadjoin ((ι 0).app (op ⦋0⦌)) _
      (hK _).2 (fun i => isIso_component _ i)
    rw [terminal.comp_from]
    show IsCoveringOver J (terminal.from T)
    exact initial_cover J B hadjoin U f hB hJ
  · intro n
    have : ∀ a, IsIso (((SimplicialObject.truncation n).map (ι (n + 1))).app a) :=
      fun a => hι (n + 1) _ (Nat.le_succ_of_le a.unop.property)
    have : IsIso ((SimplicialObject.truncation n).map (ι (n + 1))) :=
      NatIso.isIso_of_isIso_app _
    have := hι (n + 1) (op ⦋n + 1⦌) (by rfl)
    have := (hGoodF (n + 1) (op ⦋n + 1⦌)).1
    have := (hK (op ⦋n + 1⦌)).1
    exact matching_cover_transfer J B hadjoin (ι (n + 1)) n
      ((seq (n + 1)).2 _).2 (hK _).2 (hcov n (seq n))


end Stacks.CategoryTheory.Hypercovering

