module

public import StacksFrontier.CategoryTheory.Sites.Hypercovering.Construction.PresheafObjects.Descent

/-!
# Existence of hypercoverings of the final presheaf by objects in a collection

[Stacks, Tag 0DAX]: a covering collection of objects supplies a hypercovering of the final
presheaf all of whose terms are coproducts of objects in that collection
(`exists_hypercoveringOfTerminal_with_objects_in`), and a hypercovering of an object `X` is a
hypercovering of the final presheaf on the localized site `C/X`.
-/

@[expose] public section

universe w v u q d e

open CategoryTheory CategoryTheory.Limits Opposite

namespace Stacks.CategoryTheory.Hypercovering

attribute [local implicit_reducible] mapFormalCoproduct

variable {C : Type u} [Category.{v} C] [HasEqualizers C] [HasPullbacks C]

/-- **Stacks Project, Tag 0DAX.** A covering collection of objects supplies a hypercovering of
the final presheaf all of whose terms are coproducts of objects in that collection. -/
@[stacks 0DAX]
theorem exists_hypercoveringOfTerminal_with_objects_in
    (J : Pretopology C) (B : Set C)
    (hcover : ∀ U : C, ∃ (ι : Type (max w u v)) (V : ι → C) (f : ∀ i, V i ⟶ U),
      (∀ i, V i ∈ B) ∧ Presieve.ofArrows V f ∈ J U) :
    ∃ K : HypercoveringOfTerminal.{max w u v} J,
      ∀ (n : ℕ) (i : (K.toSimplicialObject.obj (op (SimplexCategory.mk n))).I),
        (K.toSimplicialObject.obj (op (SimplexCategory.mk n))).obj i ∈ B := by
  obtain ⟨K, hK, hB⟩ :=
    exists_hypercovering_of_terminal_presheaf_in_presheaf_category J B hcover
  let Q := K ⋙ mapFormalCoproduct (Over.forget _)
  have hQ : ∀ (n : SimplexCategoryᵒᵖ) (i : (Q.obj n).I),
      (Q.obj n).obj i ∈ representableObjectsIn (C := C) B :=
    fun n i ↦ hB n.unop.len i
  let L := liftSimplicialObject B Q hQ
  obtain ⟨H, hH⟩ := hypercoveringOfTerminal_lift J L K (liftSimplicialIso B K hQ) hK
  refine ⟨H, ?_⟩
  rw [hH]
  intro n i
  exact liftFormalObject_mem B (Q.obj _) (hQ _) i

section SliceTerminal

omit [HasEqualizers C] in
/-- **A covering morphism of semi-representable objects over `X` is covering for the localized
pretopology on `C/X`.** Both conditions are read over the same target summand and differ only in
the category the covering family is taken in: the hypothesis asks that the family of underlying
arrows of `C` generate a covering sieve of `(V.obj j).left`, the conclusion that the family of
arrows of `C/X` generate a covering sieve of `V.obj j`. The localized topology is defined by the
corresponding sieve of `C`, and `Sieve.overEquiv_ofArrows` identifies the sieve generated by a
family of arrows of `C/X` with the sieve generated by their underlying arrows. -/
theorem isCovering_toPretopology_over_of_isCoveringOver (J : Pretopology C) {X : C}
    {U V : FormalCoproduct.{q} (Over X)} (f : U ⟶ V) (hf : IsCoveringOver J f) :
    IsCovering (J.toGrothendieck.over X).toPretopology f := by
  intro j
  show Sieve.generate (Presieve.ofArrows _ _) ∈ (J.toGrothendieck.over X) _
  rw [← Sieve.ofArrows, GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows]
  have harr : (fun i : { i : U.I // f.f i = j } ↦
        (f.φ i.1 ≫ eqToHom (congrArg V.obj i.2)).left) =
      fun i : { i : U.I // f.f i = j } ↦ (f.φ i.1).left ≫
        eqToHom (congrArg (fun k ↦ (V.obj k).left) i.2) :=
    funext fun i ↦ congrArg (fun m ↦ (f.φ i.1).left ≫ m) (Over.eqToHom_left _)
  rw [harr, Sieve.ofArrows]
  exact (Pretopology.mem_toGrothendieck _ _ _).2 ⟨_, hf j, Sieve.le_generate _⟩

omit [HasEqualizers C] in
/-- **A hypercovering of an object `X` of `C` is a hypercovering of the final presheaf on the
localized site `C/X`.** The two notions are the two readings of [Stacks, Tag 01G5] and
[Stacks, Tag 09VU] of one and the same datum: a simplicial semi-representable object over `X`
whose degree-zero term covers `X` and whose canonical map to each successive matching object is
covering. The simplicial object is unchanged -- the hypercovering produced has it as its
underlying simplicial object -- and only the form of the three conditions changes, from covering
families of `C` to local surjectivity of the associated presheaves on `C/X`.

The site `C/X` has a terminal object, so its semi-representable objects have one too, and the
degree-zero condition is a covering family over it; the translation of the conditions is
`hypercoveringOfTerminal_lift` applied in `C/X`, the covering families being carried into
`localPretopology` by `isCoveringOver_of_homLocallySurjective` exactly as in
`isHypercovering_yonedaFormal`, which is this statement read in the other direction. -/
theorem exists_hypercoveringOfTerminal_over_of_isHypercovering (J : Pretopology C) {X : C}
    [HasEqualizers (Over X)]
    (K : SimplicialObject (FormalCoproduct.{max w u v} (Over X))) (hK : IsHypercovering J K) :
    ∃ H : HypercoveringOfTerminal.{max w u v} (J.toGrothendieck.over X).toPretopology,
      H.toSimplicialObject = K := by
  set Q := (J.toGrothendieck.over X).toPretopology
  refine hypercoveringOfTerminal_lift (C := Over X) Q K (K ⋙ yonedaFormal) (Iso.refl _)
    ⟨?_, fun n ↦ ?_⟩
  · refine isCoveringOver_of_homLocallySurjective (C := Over X) Q _ fun W s ↦ ?_
    refine Q.toGrothendieck.superset_covering ?_
      (homLocallySurjective_incl_of_isCovering (C := Over X) Q _
        (isCovering_toPretopology_over_of_isCoveringOver J _ hK.1) W (terminal.from _))
    rintro W' g ⟨t, -⟩
    exact ⟨yonedaFormal.map t, terminal.hom_ext _ _⟩
  · exact isCoveringOver_of_homLocallySurjective (C := Over X) Q _
      (homLocallySurjective_unit_comp_of_fullyFaithful (C := Over X) Q.toGrothendieck
        (FormalCoproduct.incl (Over X)) yonedaFormal yonedaFormalFullyFaithful K n _
        (homLocallySurjective_incl_of_isCovering (C := Over X) Q _
          (isCovering_toPretopology_over_of_isCoveringOver J _ (hK.2 n))))

end SliceTerminal

end Stacks.CategoryTheory.Hypercovering

end
