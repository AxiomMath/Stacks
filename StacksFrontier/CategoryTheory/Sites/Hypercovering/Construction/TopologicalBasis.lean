/-!
# Hypercoverings subordinate to a topological basis

Every topological space admits a hypercovering whose open sets all belong to any prescribed basis
for its topology, and a quasi-compact, quasi-separated space admits one which is in addition
finite in every simplicial degree, subordinate to any basis of quasi-compact opens.

## Main results

* `Stacks.CategoryTheory.Hypercovering.exists_hypercovering_of_isTopologicalBasis`: a basis of a
  topological space contains all the open sets occurring in some hypercovering.
* `Stacks.CategoryTheory.Hypercovering.exists_finite_hypercovering_of_finite_intersection_covers`:
  when every finite intersection of basis opens has a finite cover by basis opens, the
  hypercovering can be chosen with finitely many summands in each degree.
* `Stacks.CategoryTheory.Hypercovering.exists_finite_hypercovering_of_isTopologicalBasis`: a
  quasi-compact basis on a quasi-compact, quasi-separated space supports a degreewise finite
  hypercovering.

## Implementation notes

We regard the topological space as the terminal object of its category of open subsets. A
semi-representable object over this terminal open is represented by a formal coproduct of open
subsets; the final clause of each statement says that the open subset underlying every summand in
every simplicial degree belongs to the given basis.

The first result does not assert degreewise finiteness. The second records the finite-cover
variant of the same recursive construction, run inside the sublattice of opens generated by the
basis, where finite covers are available; the resulting hypercovering is then pushed forward to
the full site of opens along the inclusion, which takes covering families to covering families
and preserves fibre products. Thus finiteness is obtained during the construction, not by
thinning an arbitrary hypercovering.

For the quasi-compact case, the hypotheses of quasi-compactness and quasi-separatedness are
stated directly in terms of compact subsets, without imposing any separation axiom. Finiteness of
the index type in every degree also says that the coverings of the terminal open, of pairwise
intersections, and of the higher matching intersections are finite.

## References

* [Stacks Project, Tag 01H6](https://stacks.math.columbia.edu/tag/01H6)
* [Stacks Project, Tag 01H7](https://stacks.math.columbia.edu/tag/01H7)
-/

@[expose] public section

universe u

open CategoryTheory CategoryTheory.Limits Simplicial TopologicalSpace

namespace Stacks.CategoryTheory.Hypercovering

section Generated

private lemma mem_finset_union {X : Type u} (s : Finset (Set X)) (x : X) :
    x ∈ (⋃ V ∈ s, V) ↔ ∃ V ∈ s, x ∈ V := by simp

/-- The sets obtained from a family `B` by finitely many unions and intersections, together with
the empty set and the whole space. -/
private inductive generatedOpen {X : Type u} (B : Set (Set X)) : Set X → Prop where
  | top : generatedOpen B Set.univ
  | bot : generatedOpen B ∅
  | basic {U : Set X} : U ∈ B → generatedOpen B U
  | sup {U V : Set X} : generatedOpen B U → generatedOpen B V →
      generatedOpen B (U ∪ V)
  | inf {U V : Set X} : generatedOpen B U → generatedOpen B V →
      generatedOpen B (U ∩ V)

/-- If every finite intersection of members of `B` has a finite cover by members of `B`, then so
has every set generated from `B` by finite unions and intersections. -/
private lemma generatedOpen_finite_cover {X : Type u} {B : Set (Set X)}
    (hfinite : ∀ s : Finset (Set X), (∀ U ∈ s, U ∈ B) →
      ∃ t : Finset (Set X), (∀ V ∈ t, V ∈ B) ∧ (⋃ V ∈ t, V) = (⋂ U ∈ s, U))
    {U : Set X} (hU : generatedOpen B U) :
    ∃ t : Finset (Set X), (∀ V ∈ t, V ∈ B) ∧ (⋃ V ∈ t, V) = U := by
  induction hU with
  | top =>
      obtain ⟨t, htB, ht⟩ := hfinite ∅ (by simp)
      exact ⟨t, htB, by simpa using ht⟩
  | bot => exact ⟨∅, by simp, by simp⟩
  | @basic V hVB =>
      obtain ⟨t, htB, ht⟩ := hfinite {V} (by simp [hVB])
      exact ⟨t, htB, by simpa using ht⟩
  | @sup A D hU hV ihU ihV =>
      obtain ⟨s, hsB, rfl⟩ := ihU
      obtain ⟨t, htB, rfl⟩ := ihV
      refine ⟨s ∪ t, by simpa using fun W hW ↦ hW.elim (hsB W) (htB W), ?_⟩
      ext x
      simp only [Set.mem_iUnion, Set.mem_union, Finset.mem_union, exists_prop,
        or_and_right, exists_or]
  | @inf A D hU hV ihU ihV =>
      obtain ⟨s, hsB, rfl⟩ := ihU
      obtain ⟨t, htB, rfl⟩ := ihV
      let pairs := s.product t
      have hpair (p : Set X × Set X) (hp : p ∈ pairs) :
          ∃ r : Finset (Set X), (∀ W ∈ r, W ∈ B) ∧ (⋃ W ∈ r, W) = p.1 ∩ p.2 := by
        have hp' := Finset.mem_product.mp hp
        obtain ⟨r, hrB, hr⟩ := hfinite {p.1, p.2} (by
          intro W hW
          simp only [Finset.mem_insert, Finset.mem_singleton] at hW
          rcases hW with rfl | rfl
          · exact hsB _ hp'.1
          · exact htB _ hp'.2)
        exact ⟨r, hrB, by simpa using hr⟩
      classical
      choose! r hrB hr using hpair
      refine ⟨pairs.biUnion r, fun W hW ↦ ?_, ?_⟩
      · obtain ⟨p, hp, hWp⟩ := Finset.mem_biUnion.mp hW
        exact hrB p hp W hWp
      · ext x
        rw [mem_finset_union, Set.mem_inter_iff, mem_finset_union, mem_finset_union]
        constructor
        · rintro ⟨W, hWq, hxW⟩
          obtain ⟨p, hp, hWp⟩ := Finset.mem_biUnion.mp hWq
          have hx : x ∈ p.1 ∩ p.2 := hr p hp ▸ (mem_finset_union _ _).2 ⟨W, hWp, hxW⟩
          obtain ⟨hp₁, hp₂⟩ := Finset.mem_product.mp hp
          exact ⟨⟨p.1, hp₁, hx.1⟩, ⟨p.2, hp₂, hx.2⟩⟩
        · rintro ⟨⟨a, ha, hxa⟩, ⟨b, hb, hxb⟩⟩
          have hp : (a, b) ∈ pairs := Finset.mem_product.mpr ⟨ha, hb⟩
          have hx : x ∈ (a, b).1 ∩ (a, b).2 := ⟨hxa, hxb⟩
          rw [← hr _ hp] at hx
          obtain ⟨W, hW, hxW⟩ := (mem_finset_union _ _).mp hx
          exact ⟨W, Finset.mem_biUnion.mpr ⟨_, hp, hW⟩, hxW⟩

/-- The sublattice of opens generated by a family of sets. -/
private def generatedOpenSublattice {X : Type u} [TopologicalSpace X] (B : Set (Set X)) :
    Sublattice (Opens X) where
  carrier := {U | generatedOpen B U.1}
  supClosed' _ hU _ hV := generatedOpen.sup hU hV
  infClosed' _ hU _ hV := generatedOpen.inf hU hV

private abbrev generatedOpens {X : Type u} [TopologicalSpace X] (B : Set (Set X)) :=
  generatedOpenSublattice B

private instance generatedOpens_orderTop {X : Type u} [TopologicalSpace X]
    (B : Set (Set X)) : OrderTop (generatedOpens B) where
  top := ⟨⊤, generatedOpen.top⟩
  le_top := fun U ↦ show U.1 ≤ ⊤ from le_top

private instance generatedOpens_orderBot {X : Type u} [TopologicalSpace X]
    (B : Set (Set X)) : OrderBot (generatedOpens B) where
  bot := ⟨⊥, generatedOpen.bot⟩
  bot_le := fun U ↦ show ⊥ ≤ U.1 from bot_le

private instance generatedOpens_hasLimit_cospan {X : Type u} [TopologicalSpace X]
    (B : Set (Set X)) {A D Z : generatedOpens B} (f : A ⟶ Z) (g : D ⟶ Z) :
    HasLimit (cospan f g) := by
  let P : generatedOpens B := ⟨A.1 ⊓ D.1, generatedOpen.inf A.2 D.2⟩
  let c : PullbackCone f g := PullbackCone.mk
    (show P ⟶ A from homOfLE (show P.1 ≤ A.1 from inf_le_left))
    (show P ⟶ D from homOfLE (show P.1 ≤ D.1 from inf_le_right))
  refine HasLimit.mk ⟨c, PullbackCone.IsLimit.mk ?_ (fun s ↦ homOfLE (le_inf
    (show s.pt.1 ≤ A.1 from leOfHom s.fst) (show s.pt.1 ≤ D.1 from leOfHom s.snd))) ?_ ?_ ?_⟩ <;>
    intros <;> subsingleton

private instance generatedOpens_hasPullbacks {X : Type u} [TopologicalSpace X]
    (B : Set (Set X)) : HasPullbacks (generatedOpens B) :=
  hasPullbacks_of_hasLimit_cospan (generatedOpens B)

private def generatedOpensInfTopHom {X : Type u} [TopologicalSpace X] (B : Set (Set X)) :
    InfTopHom (generatedOpens B) (Opens X) where
  toInfHom := { toFun := fun U ↦ U.1, map_inf' := fun _ _ ↦ rfl }
  map_top' := rfl

/-- The inclusion of the sublattice of opens generated by `B` into all opens, as a functor. -/
private def generatedOpensInclusion {X : Type u} [TopologicalSpace X] (B : Set (Set X)) :
    generatedOpens B ⥤ Opens X :=
  (OrderHomClass.toOrderHom (generatedOpensInfTopHom B)).toFunctor

private instance generatedOpensInclusion_preservesFiniteLimits {X : Type u}
    [TopologicalSpace X] (B : Set (Set X)) :
    PreservesFiniteLimits (generatedOpensInclusion B) := by
  dsimp only [generatedOpensInclusion]
  infer_instance

private def generatedTop {X : Type u} [TopologicalSpace X] (B : Set (Set X)) :
    generatedOpens B := ⟨⊤, generatedOpen.top⟩

/-- The pretopology of pointwise covering families on the sublattice generated by `B`. -/
private def generatedPretopology {X : Type u} [TopologicalSpace X] (B : Set (Set X)) :
    Pretopology (generatedOpens B) where
  coverings U := {S | ∀ x ∈ U.1.1, ∃ (V : generatedOpens B) (f : V ⟶ U),
    S f ∧ x ∈ V.1.1}
  has_isos U V f hf x hx := ⟨V, f, Presieve.singleton_self _, (inv f).le hx⟩
  pullbacks X Y f S hS x hx := by
    rcases hS x (f.le hx) with ⟨U, g, hg, hU⟩
    refine ⟨_, _, Presieve.pullbackArrows.mk _ _ hg, ?_⟩
    have hle : U ⊓ Y ≤ pullback g f :=
      leOfHom (pullback.lift (homOfLE inf_le_left) (homOfLE inf_le_right) rfl)
    exact hle ⟨hU, hx⟩
  transitive X S Ti hS hTi x hx := by
    rcases hS x hx with ⟨U, f, hf, hU⟩
    rcases hTi f hf x hU with ⟨V, g, hg, hV⟩
    exact ⟨V, g ≫ f, ⟨U, g, f, hf, hg, rfl⟩, hV⟩

private def generatedBasisObjects {X : Type u} [TopologicalSpace X] (B : Set (Set X)) :
    Set (generatedOpens B) := {U | U.1.1 ∈ B}

private lemma generatedOpens_finite_cover {X : Type u} [TopologicalSpace X]
    {B : Set (Set X)} (hfinite : ∀ s : Finset (Set X), (∀ U ∈ s, U ∈ B) →
      ∃ t : Finset (Set X), (∀ V ∈ t, V ∈ B) ∧ (⋃ V ∈ t, V) = (⋂ U ∈ s, U))
    (hB : IsTopologicalBasis B) (U : generatedOpens B) :
    ∃ (I : Type u) (V : I → generatedOpens B) (f : ∀ i, V i ⟶ U),
      Finite I ∧ (∀ i, generatedBasisObjects B (V i)) ∧
        Presieve.ofArrows V f ∈ generatedPretopology B U := by
  classical
  obtain ⟨t, htB, ht⟩ := generatedOpen_finite_cover hfinite U.2
  let I := {V : Set X // V ∈ t}
  let V : I → generatedOpens B := fun i ↦
    ⟨⟨i.1, hB.isOpen (htB i.1 i.2)⟩, generatedOpen.basic (htB i.1 i.2)⟩
  have hsub (i : I) : i.1 ⊆ U.1.1 := fun x hx ↦ ht ▸ (mem_finset_union t x).2 ⟨i.1, i.2, hx⟩
  let f : ∀ i, V i ⟶ U := fun i ↦ homOfLE (hsub i)
  refine ⟨I, V, f, Finite.of_fintype I, fun i ↦ htB i.1 i.2, fun x hx ↦ ?_⟩
  rw [← ht] at hx
  obtain ⟨W, hW, hxW⟩ := (mem_finset_union t x).mp hx
  exact ⟨V ⟨W, hW⟩, f ⟨W, hW⟩, Presieve.ofArrows.mk _, hxW⟩

private lemma generatedOpens_coverOfAdjoin {X : Type u} [TopologicalSpace X]
    (B : Set (Set X)) :
    ∀ {X₀ : generatedOpens B} {I : Type u} (V : I → generatedOpens B)
      (f : ∀ i, V i ⟶ X₀),
      Finite I → (∀ i, generatedBasisObjects B (V i)) →
      Presieve.ofArrows V f ∈ generatedPretopology B X₀ →
      ∀ (W : generatedOpens B) (g : W ⟶ X₀), generatedBasisObjects B W →
        Presieve.ofArrows
          (fun i : Sum I PUnit.{u + 1} ↦ match i with | Sum.inl i => V i | Sum.inr _ => W)
          (fun i : Sum I PUnit.{u + 1} ↦ match i with | Sum.inl i => f i | Sum.inr _ => g) ∈
            generatedPretopology B X₀ := by
  intro X₀ I V f _ _ hf W g _ x hx
  obtain ⟨Y, k, ⟨i⟩, hxY⟩ := hf x hx
  exact ⟨V i, f i, Presieve.ofArrows.mk (Sum.inl i), hxY⟩

private lemma generatedOpensInclusion_mapsCoveringsToCoverings {X : Type u}
    [TopologicalSpace X] (B : Set (Set X)) :
    MapsCoveringsToCoverings.{u} (generatedOpensInclusion B) (generatedPretopology B)
      (Opens.pretopology X) := by
  intro V ι A g hg x hx
  obtain ⟨W, f, ⟨i⟩, hxW⟩ := hg x hx
  exact ⟨(generatedOpensInclusion B).obj (A i), (generatedOpensInclusion B).map (g i),
    Presieve.ofArrows.mk i, hxW⟩

end Generated

variable {X : Type u} [TopologicalSpace X]

/-- **Stacks Project, Tag 01H6.** Every basis of a topological space supports a hypercovering all
of whose constituent open subsets belong to that basis. -/
@[stacks 01H6]
theorem exists_hypercovering_of_isTopologicalBasis
    (B : Set (Set X)) (hB : IsTopologicalBasis B) :
    ∃ K : SimplicialObject (FormalCoproduct.{u} (Over (⊤ : Opens X))),
      IsHypercovering (Opens.pretopology X) K ∧
        ∀ n : ℕ, ∀ i : (K.obj (Opposite.op ⦋n⦌)).I,
          ((K.obj (Opposite.op ⦋n⦌)).obj i).left.1 ∈ B := by
  let B' : Set (Opens X) := { U | U.1 ∈ B }
  have hcover : ∀ U : Opens X, ∃ (ι : Type u) (V : ι → Opens X) (f : ∀ i, V i ⟶ U),
      (∀ i, V i ∈ B') ∧ Presieve.ofArrows V f ∈ Opens.pretopology X U := by
    intro U
    let ι := { V : Set X // V ∈ B ∧ V ⊆ U }
    let V : ι → Opens X := fun V ↦ ⟨V.1, hB.isOpen V.2.1⟩
    let f : ∀ i, V i ⟶ U := fun i ↦ homOfLE i.2.2
    refine ⟨ι, V, f, fun i ↦ i.2.1, fun x hx ↦ ?_⟩
    obtain ⟨W, hWB, hxW, hWU⟩ := hB.exists_subset_of_mem_open hx U.2
    exact ⟨V ⟨W, hWB, hWU⟩, f ⟨W, hWB, hWU⟩, Presieve.ofArrows.mk _, hxW⟩
  have hadjoin : ∀ {ι : Type u} (V : ι → Opens X) {U : Opens X} (f : ∀ i, V i ⟶ U),
      (∀ i, V i ∈ B') → Presieve.ofArrows V f ∈ Opens.pretopology X U →
      ∀ {U' : Opens X}, U' ∈ B' → ∀ g : U' ⟶ U,
        (fun {_} h ↦ Presieve.ofArrows V f h ∨ Presieve.singleton g h) ∈
          Opens.pretopology X U := by
    intro ι V U f _ hf U' _ g x hx
    obtain ⟨W, k, hk, hxW⟩ := hf x hx
    exact ⟨W, k, Or.inl hk, hxW⟩
  exact exists_hypercovering_with_objects_in (Opens.pretopology X) B' hcover hadjoin ⊤

/-- A finite-cover choice for every finite intersection of basis opens yields a hypercovering
with finitely many summands in each degree. The empty intersection is the whole space. -/
theorem exists_finite_hypercovering_of_finite_intersection_covers
    (B : Set (Set X)) (hB : IsTopologicalBasis B)
    (hfinite : ∀ s : Finset (Set X), (∀ U ∈ s, U ∈ B) →
      ∃ t : Finset (Set X), (∀ V ∈ t, V ∈ B) ∧
        (⋃ V ∈ t, V) = (⋂ U ∈ s, U)) :
    ∃ K : SimplicialObject (FormalCoproduct.{u} (Over (⊤ : Opens X))),
      IsHypercovering (Opens.pretopology X) K ∧
        ∀ n : ℕ, Finite (K.obj (Opposite.op ⦋n⦌)).I ∧
          ∀ i : (K.obj (Opposite.op ⦋n⦌)).I,
            ((K.obj (Opposite.op ⦋n⦌)).obj i).left.1 ∈ B := by
  classical
  let J := generatedPretopology B
  let B' := generatedBasisObjects B
  obtain ⟨K, hK, hKfinite⟩ :=
    exists_finite_hypercovering J B'
      (fun U ↦ generatedOpens_finite_cover hfinite hB U)
      (generatedOpens_coverOfAdjoin B) (generatedTop B)
  let u := generatedOpensInclusion B
  refine ⟨K ⋙ mapFormalCoproduct (Over.post u),
    IsHypercovering.map J (Opens.pretopology X) u
      (generatedOpensInclusion_mapsCoveringsToCoverings B) K hK, hKfinite⟩

/-- **Stacks Project, Tag 01H7.** A quasi-compact topological space with a basis of
quasi-compact opens and quasi-compact intersections of quasi-compact opens has a hypercovering
subordinate to that basis whose index type is finite in every degree. -/
@[stacks 01H7]
theorem exists_finite_hypercovering_of_isTopologicalBasis
    (B : Set (Set X)) (hB : IsTopologicalBasis B)
    (hX : IsCompact (Set.univ : Set X))
    (hBcompact : ∀ U ∈ B, IsCompact U)
    (hInter : ∀ U V : Set X, IsOpen U → IsCompact U →
      IsOpen V → IsCompact V → IsCompact (U ∩ V)) :
    ∃ K : SimplicialObject (FormalCoproduct.{u} (Over (⊤ : Opens X))),
      IsHypercovering (Opens.pretopology X) K ∧
        ∀ n : ℕ, Finite (K.obj (Opposite.op (SimplexCategory.mk n))).I ∧
          ∀ i : (K.obj (Opposite.op (SimplexCategory.mk n))).I,
            ((K.obj (Opposite.op (SimplexCategory.mk n))).obj i).left.1 ∈ B := by
  have : CompactSpace X := ⟨hX⟩
  have : QuasiSeparatedSpace X := ⟨hInter⟩
  apply exists_finite_hypercovering_of_finite_intersection_covers B hB
  classical
  intro s hs
  have hUcompact : IsCompact (⋂ U ∈ s, U) := by
    simpa only [Set.sInter_eq_biInter, Finset.mem_coe] using
      (QuasiSeparatedSpace.isCompact_sInter s.finite_toSet
        (fun U hU ↦ Or.inl (hB.isOpen (hs U hU)))
        (fun U hU ↦ hBcompact U (hs U hU)))
  obtain ⟨t, ht⟩ := eq_sUnion_finset_of_isTopologicalBasis_of_isCompact_open
    B hB _ hUcompact (isOpen_biInter_finset (fun U hU ↦ hB.isOpen (hs U hU)))
  refine ⟨t.image Subtype.val, ?_, by simpa [Set.sUnion_eq_biUnion] using ht.symm⟩
  intro V hV
  obtain ⟨i, -, rfl⟩ := Finset.mem_image.mp hV
  exact i.property

end Stacks.CategoryTheory.Hypercovering

end
