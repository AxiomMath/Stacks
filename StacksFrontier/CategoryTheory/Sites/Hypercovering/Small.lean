module

public import Mathlib.Logic.Small.Basic
public import Mathlib.Logic.Small.Set
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.CategoryTheory.Sites.Hypercovering.CoveringFamilies

/-!
# Hypercoverings of an object form a set

Let `C` be a site with fibre products, presented by its covering families in the sense of
`Stacks.CategoryTheory.Hypercovering.CoveringFamilies`, and let `X` be an object of `C`. The
hypercoverings of `X` then form a set rather than a proper class: the type of simplicial
set-indexed families over `X` satisfying `CoveringFamilies.IsHypercovering` is small.

The bound comes from the covering families themselves. Every index element appearing in a
hypercovering of `X` appears in the index set of one of the site's covering families — in degree
zero because the degree-zero family *is* a covering family of `X`, and in positive degree because
the index element lies in a fibre of a matching morphism, and that fibre is cut out of the index
set by separation, so its index elements are among those of the original family.
Families indexed inside one fixed small set of elements form a small type, and so do functors
into a small collection of objects; together these bound the simplicial objects involved.

## Main results

* `Stacks.CategoryTheory.Hypercovering.small_hypercoverings`: the type of hypercoverings of an
  object is small in the universe generated by the site's covering families, objects, arrows and
  index elements.

## Implementation notes

`CoveringFamilies.IsHypercovering` refers to the site's actual set of indexed covering families,
so the bound involves no successor on the universe of index elements, unlike the ambient type of
all set-indexed families. The covering axioms themselves play no part in the size argument; only
the two membership conditions do.

## References

* [Stacks Project, Tag 01G7](https://stacks.math.columbia.edu/tag/01G7)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Simplicial

universe s w v u t

namespace Stacks.CategoryTheory.Hypercovering

/-- Families whose index elements lie in a fixed small set form a small type. -/
private theorem small_setFamilies_of_indices {D : Type u} (A : Set ZFSet.{w})
    [Small.{s} A] [Small.{s} D] :
    Small.{s} {U : SetFamily.{w} D // ∀ i ∈ U.I, i ∈ A} := by
  let S := {I : ZFSet.{w} // ∀ i ∈ I, i ∈ A}
  have : Small.{s} S := by
    apply small_of_injective (f := fun I : S => {a : A | a.1 ∈ I.1})
    intro I J h; apply Subtype.ext; apply ZFSet.ext; intro i
    constructor <;> intro hi
    · exact (Set.ext_iff.mp h ⟨i, I.2 i hi⟩).mp hi
    · exact (Set.ext_iff.mp h ⟨i, J.2 i hi⟩).mpr hi
  have (I : S) : Small.{s} I.1 :=
    small_of_injective (f := fun i : I.1 => (⟨i.1, I.2 i.1 i.2⟩ : A))
      (fun _ _ h => Subtype.ext (congrArg (fun x : A => x.1) h))
  apply small_of_injective (f := fun U : {U : SetFamily.{w} D // ∀ i ∈ U.I, i ∈ A} =>
    (⟨⟨U.1.I, U.2⟩, U.1.obj⟩ : Σ I : S, I.1 → D))
  rintro ⟨⟨I, f⟩, hI⟩ ⟨⟨J, g⟩, hJ⟩ h
  cases h; rfl

/-- Functors taking values in a small collection of objects form a small type. -/
@[sga "4 I 1.1.1" "a)"]
private theorem small_functors_of_objects {J : Type u} [Category.{v} J]
    {D : Type w} [Category.{t} D] (P : D → Prop)
    [Small.{s} J] [∀ i j : J, Small.{s} (i ⟶ j)]
    [Small.{s} {d // P d}] [∀ d e : D, Small.{s} (d ⟶ e)] :
    Small.{s} {F : J ⥤ D // ∀ j, P (F.obj j)} := by
  let Code := Σ o : J → {d // P d}, ∀ i j, (i ⟶ j) → ((o i).1 ⟶ (o j).1)
  apply small_of_injective (f :=
    fun F : {F : J ⥤ D // ∀ j, P (F.obj j)} =>
      (⟨fun j => ⟨F.1.obj j, F.2 j⟩, fun _ _ f => F.1.map f⟩ : Code))
  rintro ⟨⟨fo, fm, fi, fc⟩, hf⟩ ⟨⟨go, gm, gi, gc⟩, hg⟩ h
  have ho : fo = go := congrArg (fun o => fun j => (o j).1) (congrArg Sigma.fst h)
  cases ho
  have hm := eq_of_heq (Sigma.mk.inj_iff.mp h).2
  have hfm : @fm = @gm := by funext i j f; exact congrFun (congrFun (congrFun hm i) j) f
  cases hfm; rfl

variable {C : Type u} [Category.{v} C] [HasPullbacks C]

/-- **Stacks Project, Tag 01G7.** Hypercoverings of an object of a site with
fibre products form a set. -/
@[stacks 01G7]
public theorem small_hypercoverings (Cov : CoveringFamilies.{s, w} C) (X : C) :
    Small.{max s u v w}
      {K : SimplicialObject (SetFamily.{w} (Over X)) //
        CoveringFamilies.IsHypercovering Cov K} := by
  -- Collect the index elements of all covering families over all objects.
  let ι := Σ Y : C, Σ U : Cov.families Y, U.1.I
  have : Small.{max s u v w} C := small_max.{max s v w} _
  have (Y : C) : Small.{max s u v w} (Cov.families Y) := by
    have := Cov.small Y; exact small_lift.{_, max u v w, s} _
  have (Y : C) (U : Cov.families Y) : Small.{max s u v w} U.1.I :=
    small_lift.{_, max s u v, w} _
  have : Small.{max s u v w} ι := inferInstance
  let A := Set.range (fun a : ι => a.2.2.1)
  have : Small.{max s u v w} A := inferInstance
  have : Small.{max s u v w} (Over X) := small_max.{max s w} _
  have hhom (U V : SetFamily.{w} (Over X)) : Small.{max s u v w} (U ⟶ V) := by
    have (Y Z : Over X) : Small.{max s u v w} (Y ⟶ Z) := small_max.{max s u w} _
    have : Small.{max s u v w} U.I := small_lift.{_, max s u v, w} _
    have : Small.{max s u v w} V.I := small_lift.{_, max s u v, w} _
    apply small_of_injective (f := fun f : U ⟶ V =>
      (⟨f.f, f.φ⟩ : Σ a : U.I → V.I, ∀ i, U.obj i ⟶ V.obj (a i)))
    rintro ⟨f, φ⟩ ⟨g, ψ⟩ h
    cases h; rfl
  let P := fun U : SetFamily.{w} (Over X) => ∀ i ∈ U.I, i ∈ A
  have : Small.{max s u v w} {U // P U} := small_setFamilies_of_indices A
  let Q := {K : SimplicialObject (SetFamily.{w} (Over X)) // ∀ j, P (K.obj j)}
  have : Small.{max s u v w} Q := small_functors_of_objects P
  -- Every index in positive degree belongs to one of the covering fibres.
  have hbound (K : SimplicialObject (SetFamily.{w} (Over X)))
      (hK : CoveringFamilies.IsHypercovering Cov K) (j : SimplexCategoryᵒᵖ) : P (K.obj j) := by
    rcases j with ⟨⟨n⟩⟩
    intro i hi
    cases n with
    | zero => exact ⟨⟨X, ⟨K.obj (Opposite.op ⦋0⦌), hK.1⟩, ⟨i, hi⟩⟩, rfl⟩
    | succ n =>
      let U := K.obj (Opposite.op ⦋n + 1⦌)
      let f := ((SimplicialObject.coskAdj n).unit.app
        (K ⋙ SetFamily.inclusion)).app (Opposite.op ⦋n + 1⦌)
      let j := f.f ⟨i, hi⟩
      exact ⟨⟨_, ⟨U.fibre f j, hK.2 n j⟩,
        ⟨i, by
          change i ∈ U.I.sep (fun k => ∀ hk : k ∈ U.I, f.f ⟨k, hk⟩ = j)
          exact ZFSet.mem_sep.mpr ⟨hi, fun _ => rfl⟩⟩⟩, rfl⟩
  exact small_of_injective
    (f := fun K : {K : SimplicialObject (SetFamily.{w} (Over X)) //
        CoveringFamilies.IsHypercovering Cov K} => (⟨K.1, hbound K.1 K.2⟩ : Q))
    (fun _ _ h => Subtype.ext (congrArg (fun K : Q => K.1) h))


end Stacks.CategoryTheory.Hypercovering

end
