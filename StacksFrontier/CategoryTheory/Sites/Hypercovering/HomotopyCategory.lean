module

public import Mathlib.CategoryTheory.Filtered.Basic
public import Mathlib.CategoryTheory.Quotient
public import Mathlib.CategoryTheory.Limits.Constructions.Over.Products
public import StacksFrontier.CategoryTheory.Sites.Hypercovering.CechOfCovering
public import StacksFrontier.CategoryTheory.Sites.Hypercovering.CoveringAndHomotopies.Homotopy
public import StacksFrontier.CategoryTheory.Sites.Hypercovering.CoveringAndHomotopies.Product
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Hypercoverings of an object with maps up to homotopy

Let `C` be a site given by a pretopology `J`, let `C` have fibre products and let `X : C`. The
hypercoverings of `X` form the objects of a category whose morphisms are the maps of
hypercoverings up to homotopy, written `HC(C, X)` in the source. This file builds that category
as the quotient of the full subcategory of hypercoverings by the congruence generated by the
existence of a simplicial homotopy, and shows that it is cofiltered: two hypercoverings are both
refined by their product, and two parallel maps become equal after refining the source.

## Main definitions

* `Hypercoverings`: the hypercoverings of `X`, as a full subcategory of the simplicial
  semi-representable objects over `X`.
* `homotopyRel`: the relation on morphisms of hypercoverings of being joined by a simplicial
  homotopy.
* `HypercoveringsHomotopy`: `HC(C, X)`, the hypercoverings of `X` with maps up to homotopy.

## Main results

* `isCofiltered_hypercoveringsHomotopy`: `HC(C, X)` is cofiltered, so that a diagram indexed by
  its opposite is directed.

## Implementation notes

The quotient is `CategoryTheory.Quotient`, which divides by the congruence generated by the given
relation on morphisms; on morphisms of simplicial objects that congruence is the equivalence
relation generated by the existence of a homotopy, by
`CategoryTheory.SimplicialObject.congruence_homotopic`, which is the source's notion of two maps
being homotopic. The interval is taken in the hom-universe of `SR(C, X)`, the universe in which
Tag 01GS produces its homotopy.

Cofilteredness uses the two permanence results of the source: the product of two hypercoverings
is a hypercovering (Tag 01GI) and two parallel maps of hypercoverings are homotopic after
precomposition with a map from a further hypercovering (Tag 01GS). Both need the pretopology to
be stable under composition, which is the indexed-family composition axiom of a site
(Tag 00VH); a hypercovering exists at all because the one-member family `{X → X}` is covering,
so its Čech object is one (Tag 0GMA).

## References

* [Stacks Project, Tag 01GI](https://stacks.math.columbia.edu/tag/01GI)
* [Stacks Project, Tag 01GS](https://stacks.math.columbia.edu/tag/01GS)
* [Stacks Project, Tag 08RJ](https://stacks.math.columbia.edu/tag/08RJ)
-/

@[expose] public section

universe w v u

open CategoryTheory CategoryTheory.Limits CategoryTheory.SimplicialObject Opposite Simplicial

namespace Stacks.CategoryTheory.Hypercovering

variable {C : Type u} [Category.{v} C] [HasPullbacks C]

/-- The hypercoverings of `X`: the full subcategory of the simplicial semi-representable objects
over `X` cut out by `IsHypercovering`. -/
abbrev Hypercoverings (J : Pretopology C) (X : C) : Type _ :=
  ObjectProperty.FullSubcategory
    (fun K : SimplicialObject (FormalCoproduct.{w} (Over X)) ↦ IsHypercovering J K)

/-- Two morphisms of hypercoverings of `X` are related when they are joined by a simplicial
homotopy, the interval being taken in the hom-universe of `SR(C, X)`. -/
def homotopyRel (J : Pretopology C) (X : C) : HomRel (Hypercoverings.{w} J X) :=
  fun K L a b ↦ ∃ h : K.obj.copower (Δ[1] : SSet.{max v w}) ⟶ L.obj,
    IsHomotopy h a.hom b.hom

/-- `HC(C, X)`: the hypercoverings of `X` with maps up to homotopy, the quotient of the category
of hypercoverings by the congruence generated by the existence of a simplicial homotopy. -/
@[sga "4 V 7.3.1.7"]
abbrev HypercoveringsHomotopy (J : Pretopology C) (X : C) : Type _ :=
  CategoryTheory.Quotient (homotopyRel.{w} J X)

/-- The Čech object of the one-member covering family `{X → X}` is a hypercovering of `X`, so
`X` has at least one hypercovering. -/
theorem nonempty_hypercoverings (J : Pretopology C) (X : C) :
    Nonempty (Hypercoverings.{w} J X) := by
  let : HasTerminal (Over X) := Over.over_hasTerminal X
  let : HasBinaryProducts (Over X) :=
    Over.ConstructProducts.over_binaryProduct_of_pullback
  let : HasFiniteProducts (Over X) := hasFiniteProducts_of_has_binary_and_terminal
  exact ⟨⟨((FormalCoproduct.incl.{w} (Over X)).obj (Over.mk (𝟙 X))).cech,
    isHypercovering_cech J (𝟙 X) (J.has_isos (𝟙 X))⟩⟩

/-- **`HC(C, X)` is cofiltered.** Two hypercoverings of `X` are refined by their product
(Tag 01GI), and two parallel maps of hypercoverings become equal in `HC(C, X)` after
precomposition with a map from a further hypercovering (Tag 01GS); a hypercovering exists by
`nonempty_hypercoverings`. Hence a diagram indexed by `HC(C, X)ᵒᵖ` is directed. -/
@[sga "4 V 7.3.2" "Clause 1, special case"]
instance isCofiltered_hypercoveringsHomotopy (J : Pretopology C)
    [Precoverage.IsStableUnderComposition J.toPrecoverage] (X : C) :
    IsCofiltered (HypercoveringsHomotopy.{w} J X) where
  cone_objs := by
    rintro ⟨K⟩ ⟨L⟩
    refine ⟨⟨⟨K.obj ⨯ L.obj, IsHypercovering.prod J K.property L.property⟩⟩,
      Quot.mk _ (ObjectProperty.homMk Limits.prod.fst),
      Quot.mk _ (ObjectProperty.homMk Limits.prod.snd), trivial⟩
  cone_maps := by
    rintro ⟨K⟩ ⟨L⟩ ⟨a⟩ ⟨b⟩
    obtain ⟨K', c, hK', h, hh⟩ := exists_homotopy_after_hypercovering_refinement_max
      J K.property L.property a.hom b.hom
    refine ⟨⟨⟨K', hK'⟩⟩, Quot.mk _ (ObjectProperty.homMk c), ?_⟩
    exact CategoryTheory.Quotient.sound _ ⟨h, hh⟩
  nonempty := (nonempty_hypercoverings.{w} J X).elim fun K ↦ ⟨⟨K⟩⟩

end Stacks.CategoryTheory.Hypercovering

end
