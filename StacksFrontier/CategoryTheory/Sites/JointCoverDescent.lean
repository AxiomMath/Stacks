module

public import Mathlib.CategoryTheory.Sites.Subsheaf
public import StacksFrontier.CategoryTheory.Sites.Cohomology.CoverDescent.Sections

/-!
# Descending a morphism to a sheaf along a jointly covering family

Let `(C, J)` be a site, let `P` be a presheaf of sets on `C` and let `t i : A i ⟶ P` be a family
of morphisms whose images generate `P` locally, in the sense that the subfunctor of `P` generated
by them sheafifies to the whole of `P`. A family of morphisms `φ₀ i : A i ⟶ F` to a sheaf `F`
descends to a morphism `P ⟶ F` exactly when it is constant on the fibres of the family: whenever
two sections of two members have the same image in `P`, their images in `F` agree. The descent is
unique.

This is the family form of
`Stacks.Sites.CoverDescent.exists_factor_of_isLocallySurjective`, which treats a single locally
surjective morphism and is the case of a one-element family. The hypothesis is phrased with
`CategoryTheory.Subfunctor.sheafify` rather than with local surjectivity of the morphism out of a
coproduct of the members, because no coproduct is needed and the sections of a coproduct of
sheaves carry no information about the members.

## Main results

* `CategoryTheory.Presheaf.existsUnique_hom_of_sheafify_iSup_range_eq_top`: the descent and its
  uniqueness.
* `CategoryTheory.Presheaf.hom_ext_of_sheafify_iSup_range_eq_top`: the uniqueness half on its
  own, that is, two morphisms out of `P` which agree on every member of the family agree.
* `CategoryTheory.Presheaf.mem_iSup_range_obj_iff` and
  `CategoryTheory.Presheaf.sieveOfSection_iSup_range_mem`: a section of `P` is in the subfunctor
  generated by the family exactly when it lifts to a member, and the arrows along which a
  prescribed section lifts form a covering sieve.
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

universe w v u

namespace CategoryTheory.Presheaf

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  {I : Type*} {A : I → Cᵒᵖ ⥤ Type w} {P F : Cᵒᵖ ⥤ Type w}

section

variable (t : ∀ i, A i ⟶ P)

/-- A section of `P` lies in the subfunctor generated by the images of a family exactly when it
is the image of a section of one member of the family. -/
theorem mem_iSup_range_obj_iff {y : Cᵒᵖ} (s : P.obj y) :
    s ∈ (⨆ i, Subfunctor.range (t i)).obj y ↔
      ∃ (i : I) (a : (A i).obj y), (t i).app y a = s := by
  simp [Subfunctor.iSup_obj]

variable (hcov : (⨆ i, Subfunctor.range (t i)).sheafify J = ⊤)

include hcov

/-- The arrows along which a prescribed section of `P` restricts into the image of a member of
the family form a covering sieve. -/
theorem sieveOfSection_iSup_range_mem {y : C} (p : P.obj (op y)) :
    (⨆ i, Subfunctor.range (t i)).sieveOfSection p ∈ J y :=
  show p ∈ ((⨆ i, Subfunctor.range (t i)).sheafify J).obj (op y) by rw [hcov]; trivial

/-- Two sections of a sheaf agree if their restrictions agree along every arrow along which a
prescribed section `p` of `P` lifts to a member of a jointly covering family. -/
private theorem eq_of_forall_lift (hF : Presieve.IsSheaf J F) {y : C} (p : P.obj (op y))
    {x x' : F.obj (op y)}
    (h : ∀ (Z : C) (g : Z ⟶ y) (i : I) (a : (A i).obj (op Z)),
      (t i).app (op Z) a = P.map g.op p → F.map g.op x = F.map g.op x') : x = x' := by
  refine (hF _ (sieveOfSection_iSup_range_mem J t hcov p)).isSeparatedFor.ext fun Z g hg => ?_
  obtain ⟨i, a, ha⟩ := (mem_iSup_range_obj_iff t _).1 hg
  exact h Z g i a ha

/-- **Two morphisms out of `P` to a sheaf which agree on every member of a jointly covering
family agree.** -/
theorem hom_ext_of_sheafify_iSup_range_eq_top (hF : Presieve.IsSheaf J F) {φ ψ : P ⟶ F}
    (h : ∀ i, t i ≫ φ = t i ≫ ψ) : φ = ψ := by
  refine Stacks.Sites.CoverDescent.natTrans_ext fun y p => ?_
  refine eq_of_forall_lift J t hcov hF p fun Z g i a ha => ?_
  rw [← NatTrans.naturality_apply, ← NatTrans.naturality_apply, ← ha]
  simpa only [NatTrans.comp_app_apply] using congrArg (fun f => f.app (op Z) a) (h i)

/-- **A family of morphisms to a sheaf which is constant on the fibres of a jointly covering
family descends, uniquely, to the target of that family.** -/
theorem existsUnique_hom_of_sheafify_iSup_range_eq_top (hF : Presieve.IsSheaf J F)
    (φ₀ : ∀ i, A i ⟶ F)
    (hφ₀ : ∀ (y : Cᵒᵖ) (i j : I) (a : (A i).obj y) (a' : (A j).obj y),
      (t i).app y a = (t j).app y a' → (φ₀ i).app y a = (φ₀ j).app y a') :
    ∃! φ : P ⟶ F, ∀ i, t i ≫ φ = φ₀ i := by
  let fam : ∀ (y : C) (p : P.obj (op y)),
      Presieve.FamilyOfElements F ((⨆ i, Subfunctor.range (t i)).sieveOfSection p).arrows :=
    fun _ _ Z _ hg =>
      (φ₀ ((mem_iSup_range_obj_iff t _).1 hg).choose).app (op Z)
        ((mem_iSup_range_obj_iff t _).1 hg).choose_spec.choose
  have hpick : ∀ (y : C) (p : P.obj (op y)) {Z : C} (g : Z ⟶ y)
      (hg : ((⨆ i, Subfunctor.range (t i)).sieveOfSection p).arrows g) (i : I)
      (a : (A i).obj (op Z)), (t i).app (op Z) a = P.map g.op p →
        fam y p g hg = (φ₀ i).app (op Z) a := fun _ _ _ _ hg _ _ ha =>
    hφ₀ _ _ _ _ _
      ((((mem_iSup_range_obj_iff t _).1 hg).choose_spec.choose_spec).trans ha.symm)
  have hfam : ∀ (y : C) (p : P.obj (op y)), (fam y p).Compatible := by
    intro y p Y₁ Y₂ Z g₁ g₂ f₁ f₂ h₁ h₂ hcomm
    obtain ⟨i₁, a₁, ha₁⟩ := (mem_iSup_range_obj_iff t _).1 h₁
    obtain ⟨i₂, a₂, ha₂⟩ := (mem_iSup_range_obj_iff t _).1 h₂
    rw [hpick y p f₁ h₁ i₁ a₁ ha₁, hpick y p f₂ h₂ i₂ a₂ ha₂,
      ← NatTrans.naturality_apply, ← NatTrans.naturality_apply]
    refine hφ₀ _ _ _ _ _ ?_
    rw [NatTrans.naturality_apply, NatTrans.naturality_apply, ha₁, ha₂,
      ← Functor.map_comp_apply, ← Functor.map_comp_apply, ← op_comp, ← op_comp, hcomm]
  let val : ∀ (y : C) (_ : P.obj (op y)), F.obj (op y) := fun y p =>
    (hF _ (sieveOfSection_iSup_range_mem J t hcov p)).amalgamate (fam y p) (hfam y p)
  have hval : ∀ (y : C) (p : P.obj (op y)) (Z : C) (g : Z ⟶ y) (i : I) (a : (A i).obj (op Z)),
      (t i).app (op Z) a = P.map g.op p → F.map g.op (val y p) = (φ₀ i).app (op Z) a := by
    intro y p Z g i a ha
    have hg : ((⨆ i, Subfunctor.range (t i)).sieveOfSection p).arrows g :=
      (mem_iSup_range_obj_iff t _).2 ⟨i, a, ha⟩
    rw [(hF _ (sieveOfSection_iSup_range_mem J t hcov p)).valid_glue (hfam y p) g hg]
    exact hpick y p g hg i a ha
  have hnat : ∀ {y y' : Cᵒᵖ} (g : y ⟶ y'),
      P.map g ≫ (↾fun p => val y'.unop p) = (↾fun p => val y.unop p) ≫ F.map g := by
    intro y y' g
    refine TypeCat.homEquiv.injective (funext fun p => ?_)
    simp only [TypeCat.homEquiv_apply, types_comp_apply, TypeCat.ofHom_apply]
    refine eq_of_forall_lift J t hcov hF (P.map g p) fun Z k i a ha => ?_
    have hka : (t i).app (op Z) a = P.map (k ≫ g.unop).op p := by
      simp [ha]
    rw [hval _ (P.map g p) Z k i a ha, ← hval _ p Z (k ≫ g.unop) i a hka]
    simp
  refine existsUnique_of_exists_of_unique
    ⟨⟨fun y => ↾fun p => val y.unop p, fun {_ _} g => hnat g⟩, fun i => ?_⟩
    fun φ ψ hφ hψ => hom_ext_of_sheafify_iSup_range_eq_top J t hcov hF fun i =>
      (hφ i).trans (hψ i).symm
  refine Stacks.Sites.CoverDescent.natTrans_ext fun y a => ?_
  simpa using hval y.unop ((t i).app y a) y.unop (𝟙 _) i a (by simp)

end

end CategoryTheory.Presheaf

end
