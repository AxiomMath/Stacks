module

public import Mathlib.CategoryTheory.Comma.StructuredArrow.Basic
public import Mathlib.CategoryTheory.Sites.InducedTopology

/-!
# The restricted topology on the costructured arrows over an object

Let `G : C ⥤ D` be a functor, `Y` an object of `D` and `K` a Grothendieck topology on `C`.  The
projection `j : CostructuredArrow G Y ⥤ C` forgets the structure morphism `G.obj X ⟶ Y`, and
`j.restrictedTopology K` is the topology generated by the families whose image under `j` is a
`K`-covering.  This file shows that no generation is needed: a sieve of `X` is covering for the
restricted topology exactly when its image under `j` is a `K`-covering sieve of `X.left`.

This is what makes the restricted topology usable in practice: a covering of a costructured arrow
`X` yields, by pushing forward, a covering of `X.left` in `C`, and conversely.

## Main definitions

* `CategoryTheory.CostructuredArrow.liftHom`: the canonical lift of a morphism `g : V ⟶ X.left`
  of `C` to a morphism of costructured arrows with target `X`.
* `CategoryTheory.CostructuredArrow.projTopology`: the topology on `CostructuredArrow G Y` whose
  covering sieves are those whose image under `j` is covering.

## Main results

* `CategoryTheory.CostructuredArrow.mem_functorPushforward_proj_iff`: `j` is a discrete
  fibration, in the form sieves need — the image of a sieve `S` contains `j(f)` exactly when `S`
  contains `f`.
* `CategoryTheory.CostructuredArrow.restrictedTopology_proj_eq_projTopology` and
  `CategoryTheory.CostructuredArrow.mem_restrictedTopology_proj_iff`: the restricted topology
  consists of exactly the sieves whose image under `j` is covering.

## Implementation notes

The argument is the one for `CostructuredArrow yoneda F` in
`StacksFrontier/CategoryTheory/Sites/Topos/LocalizationOfTopoi.lean`, for an arbitrary functor in
place of the Yoneda embedding: nothing there uses more than the commutation
`G.map f.left ≫ X.hom = Z.hom` of a morphism `f : Z ⟶ X` of costructured arrows.
-/

@[expose] public section

namespace CategoryTheory.CostructuredArrow

universe v₁ v₂ u₁ u₂

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D] (G : C ⥤ D) (Y : D)

/-- The canonical lift of `g : V ⟶ X.left` to a morphism of costructured arrows with target
`X`: its source is the costructured arrow `G.obj V ⟶ G.obj X.left ⟶ Y`. -/
abbrev liftHom (X : CostructuredArrow G Y) {V : C} (g : V ⟶ X.left) :
    CostructuredArrow.mk (G.map g ≫ X.hom) ⟶ X :=
  CostructuredArrow.homMk g rfl

/-- **The projection is a discrete fibration**, in the form sieves need: for a morphism `f` of
costructured arrows with target `X`, the image under the projection of a sieve `S` of `X`
contains `f.left` exactly when `S` contains `f` itself. -/
lemma mem_functorPushforward_proj_iff {X Z : CostructuredArrow G Y} (S : Sieve X) (f : Z ⟶ X) :
    (S.functorPushforward (CostructuredArrow.proj G Y)).arrows f.left ↔ S.arrows f := by
  constructor
  · rintro ⟨W, h, a, hS, e⟩
    have w : G.map a ≫ W.hom = Z.hom := by
      rw [← CostructuredArrow.w f, show f.left = a ≫ h.left from e, G.map_comp,
        Category.assoc, CostructuredArrow.w h]
    have hk : (CostructuredArrow.homMk a w : Z ⟶ W) ≫ h = f := by
      ext
      simpa using e.symm
    exact hk ▸ S.downward_closed hS _
  · exact fun hf => ⟨Z, f, 𝟙 Z.left, hf, by simp⟩

/-- `mem_functorPushforward_proj_iff` at the canonical lift of `g`. -/
lemma mem_functorPushforward_proj_liftHom_iff {X : CostructuredArrow G Y} (S : Sieve X) {V : C}
    (g : V ⟶ X.left) :
    (S.functorPushforward (CostructuredArrow.proj G Y)).arrows g ↔ S.arrows (liftHom G Y X g) :=
  mem_functorPushforward_proj_iff G Y S (liftHom G Y X g)

/-- Pulling back along the projection undoes pushing forward along it. -/
lemma functorPullback_functorPushforward_proj {X : CostructuredArrow G Y} (S : Sieve X) :
    (S.functorPushforward (CostructuredArrow.proj G Y)).functorPullback
        (CostructuredArrow.proj G Y) = S :=
  Sieve.ext fun _ f => mem_functorPushforward_proj_iff G Y S f

/-- Pushing forward along the projection undoes pulling back along it. -/
lemma functorPushforward_functorPullback_proj {X : CostructuredArrow G Y} (T : Sieve X.left) :
    (T.functorPullback (CostructuredArrow.proj G Y)).functorPushforward
        (CostructuredArrow.proj G Y) = T :=
  Sieve.ext fun _ g => mem_functorPushforward_proj_liftHom_iff G Y _ g

/-- Pushing forward along the projection commutes with pulling back. -/
lemma functorPushforward_proj_pullback {X₁ X₂ : CostructuredArrow G Y} (f : X₁ ⟶ X₂)
    (S : Sieve X₂) :
    (S.pullback f).functorPushforward (CostructuredArrow.proj G Y) =
      (S.functorPushforward (CostructuredArrow.proj G Y)).pullback
        ((CostructuredArrow.proj G Y).map f) := by
  rw [← functorPushforward_functorPullback_proj G Y
      ((S.functorPushforward (CostructuredArrow.proj G Y)).pullback
        ((CostructuredArrow.proj G Y).map f)),
    Sieve.functorPullback_pullback, functorPullback_functorPushforward_proj]

variable (K : GrothendieckTopology C)

/-- The topology on the costructured arrows over `Y` whose covering sieves are those whose image
under the projection is covering. -/
def projTopology : GrothendieckTopology (CostructuredArrow G Y) where
  sieves X := {S | S.functorPushforward (CostructuredArrow.proj G Y) ∈ K X.left}
  top_mem' X := by
    rw [Set.mem_ofPred_eq, Sieve.functorPushforward_top]
    exact K.top_mem X.left
  pullback_stable' X₁ X₂ S f hS := by
    rw [Set.mem_ofPred_eq, functorPushforward_proj_pullback]
    exact K.pullback_stable _ hS
  transitive' X S hS R hR :=
    K.transitive hS _ fun V g hg => by
      have h : (R.pullback (liftHom G Y X g)).functorPushforward
          (CostructuredArrow.proj G Y) ∈ K V :=
        hR ((mem_functorPushforward_proj_liftHom_iff G Y S g).1 hg)
      rwa [functorPushforward_proj_pullback] at h

/-- A sieve on a costructured arrow `X` is covering for `projTopology G Y K` if and only if its
image under the projection is a `K`-covering sieve of `X.left`. -/
lemma mem_projTopology_iff (X : CostructuredArrow G Y) (S : Sieve X) :
    S ∈ projTopology G Y K X ↔ S.functorPushforward (CostructuredArrow.proj G Y) ∈ K X.left :=
  Iff.rfl

/-- **The restricted topology on the costructured arrows is the topology of sieves with covering
image**: the families whose image under the projection is covering already form a topology. -/
lemma restrictedTopology_proj_eq_projTopology :
    (CostructuredArrow.proj G Y).restrictedTopology K = projTopology G Y K := by
  refine le_antisymm ?_ (fun X S hS => ?_)
  · rw [Functor.restrictedTopology, Precoverage.toGrothendieck_eq_sInf]
    refine sInf_le fun X R hR => ?_
    rwa [mem_projTopology_iff, ← Sieve.generate_map_eq_functorPushforward]
  · exact Functor.mem_restrictedTopology_of_functorPushforward_mem hS

/-- **A sieve of a costructured arrow is covering for the restricted topology exactly when its
image under the projection is covering.** -/
lemma mem_restrictedTopology_proj_iff (X : CostructuredArrow G Y) (S : Sieve X) :
    S ∈ (CostructuredArrow.proj G Y).restrictedTopology K X ↔
      S.functorPushforward (CostructuredArrow.proj G Y) ∈ K X.left := by
  rw [restrictedTopology_proj_eq_projTopology, mem_projTopology_iff]

end CategoryTheory.CostructuredArrow

end
