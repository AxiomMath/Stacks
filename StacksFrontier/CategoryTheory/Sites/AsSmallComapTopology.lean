module

public import Mathlib.CategoryTheory.Sites.DenseSubsite.InducedTopology
public import Mathlib.CategoryTheory.Sites.Equivalence

/-!
# The topology of a precoverage carried to the small model along `AsSmall.down`

Let `C` be a category and `K` a precoverage on `C`, carried to the equivalent category
`CategoryTheory.AsSmall C` as `CategoryTheory.Precoverage.comap AsSmall.down K`. This file shows
that the Grothendieck topology generated by the transported precoverage,
`(K.comap AsSmall.down).toGrothendieck`, is the topology induced along the equivalence,
`AsSmall.down.inducedTopology K.toGrothendieck`, for a precoverage satisfying `HasIsos`,
`IsStableUnderBaseChange`, `IsStableUnderComposition` and `HasPullbacks`.

All names are in the namespace `Stacks.AsSmallSite`.

## Main results

* `map_functorPullback_asSmallDown`: pulling a presieve back along `AsSmall.down` and pushing it
  forward again returns it unchanged.
* `toGrothendieck_comap_asSmallDown`: the topology generated by the transported precoverage is the
  topology induced along `AsSmall.down`.
-/

@[expose] public section

open CategoryTheory

universe w v u

namespace Stacks.AsSmallSite

variable {C : Type u} [Category.{v} C]

/-- **Pulling a presieve back along `AsSmall.down` and pushing it forward again returns it
unchanged**: for a presieve `R` on `AsSmall.down.obj S`,
`Presieve.map AsSmall.down (Presieve.functorPullback AsSmall.down R) = R`. -/
theorem map_functorPullback_asSmallDown {S : AsSmall.{w} C}
    (R : Presieve ((AsSmall.down : AsSmall.{w} C ⥤ C).obj S)) :
    Presieve.map (AsSmall.down : AsSmall.{w} C ⥤ C)
        (Presieve.functorPullback (AsSmall.down : AsSmall.{w} C ⥤ C) R) = R := by
  funext Y f
  simp only [eq_iff_iff]
  constructor
  · intro hmem
    rw [Presieve.map_iff] at hmem
    obtain ⟨Z, h, g, hg, hcomp⟩ := hmem
    subst h
    rw [eqToHom_refl, Category.id_comp] at hcomp
    have hg' : R ((AsSmall.down : AsSmall.{w} C ⥤ C).map g) := hg
    exact hcomp ▸ hg'
  · intro hf
    exact Presieve.map_map (F := (AsSmall.down : AsSmall.{w} C ⥤ C))
      (R := Presieve.functorPullback (AsSmall.down : AsSmall.{w} C ⥤ C) R)
      (f := AsSmall.up.map f) hf

/-- **The Grothendieck topology generated by a precoverage carried to the small model is the
topology induced along the equivalence.** For a precoverage `K` on `C` with `HasIsos`,
`IsStableUnderBaseChange`, `IsStableUnderComposition` and `HasPullbacks`,
`(K.comap AsSmall.down).toGrothendieck = AsSmall.down.inducedTopology K.toGrothendieck`. -/
theorem toGrothendieck_comap_asSmallDown (K : Precoverage C)
    [K.HasIsos] [K.IsStableUnderBaseChange] [K.IsStableUnderComposition] [K.HasPullbacks] :
    (K.comap (AsSmall.down : AsSmall.{w} C ⥤ C)).toGrothendieck =
      (AsSmall.down : AsSmall.{w} C ⥤ C).inducedTopology K.toGrothendieck := by
  have : (AsSmall.down : AsSmall.{w} C ⥤ C).IsEquivalence :=
    inferInstanceAs (AsSmall.equiv (C := C)).inverse.IsEquivalence
  rw [Precoverage.toGrothendieck_comap_eq_restrictedTopology
      (AsSmall.down : AsSmall.{w} C ⥤ C) K
      fun {_ R} hR ↦ (map_functorPullback_asSmallDown R).symm ▸ hR,
    Functor.restrictedTopology_eq_inducedTopology]

end Stacks.AsSmallSite

end
