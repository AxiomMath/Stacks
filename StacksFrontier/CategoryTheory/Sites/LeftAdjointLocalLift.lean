module

public import Mathlib.CategoryTheory.Sites.Limits
public import Mathlib.CategoryTheory.Sites.Subsheaf
public import Mathlib.CategoryTheory.Sites.Subcanonical
public import StacksFrontier.CategoryTheory.Sites.LeftAdjointCoveringLift

/-!
# Local lifts of sections along a left adjoint between categories of sheaves

Let `F` be a left adjoint between categories of sheaves of sets — the inverse image of a morphism
of topoi, or the direct image along an equivalence of topoi.  If a family of sections `bₖ ∈ Z(Vₖ)`
of a sheaf `Z` generates `Z` locally, then every section of `F(Z)` is, locally, the image of a
section of `F(h_{Vₖ})` along `F(h_{Vₖ} ⟶ Z)` for some `k`.  For a covering sieve of `W` this says
that a section of `F(h_W)` lifts, locally, along the members of the sieve.  This complements
`CategoryTheory.Sheaf.exists_map_yonedaEquiv_symm_eq`, which is the case of a point of a topos.

## Main results

* `CategoryTheory.Sheaf.sieveOfSection_range_mem`: a map of presheaves into a sheaf which detects
  maps out of the sheaf generates it locally.
* `CategoryTheory.Sheaf.exists_locally_lift_of_adjunction`: the local lift along a locally
  generating family of sections.
* `CategoryTheory.Sheaf.exists_covering_lift_of_adjunction`: the local lift along a covering sieve.

## References

* [Stacks Project, Tag 04KL](https://stacks.math.columbia.edu/tag/04KL)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe w u u'

namespace CategoryTheory.Sheaf

section Range

variable {C : Type u} [Category.{w} C] {J : GrothendieckTopology C} [HasSheafify J (Type w)]

/-- **A map of presheaves which detects maps out of a sheaf generates it locally.**  If `u` is a
map from a presheaf to a sheaf `F` of sets such that two maps out of `F` into any sheaf agree as
soon as they agree after `u`, then every section of `F` lies, locally, in the image of `u`.

The subsheaf generated by the image of `u` receives `u`, so its inclusion into `F` is an
epimorphism of sheaves; an epimorphism of sheaves of sets is locally surjective. -/
theorem sieveOfSection_range_mem {P : Cᵒᵖ ⥤ Type w} {F : Sheaf J (Type w)} (u : P ⟶ F.obj)
    (h : ∀ ⦃E : Sheaf J (Type w)⦄ (a b : F ⟶ E), u ≫ a.hom = u ≫ b.hom → a = b)
    {U : C} (s : F.obj.obj (op U)) : (Subfunctor.range u).sieveOfSection s ∈ J U := by
  let G₀ := Subfunctor.range u
  let Gs : Sheaf J (Type w) := ⟨(G₀.sheafify J).toFunctor, (isSheaf_iff_isSheaf_of_type _ _).mpr
    (G₀.sheafify_isSheaf ((isSheaf_iff_isSheaf_of_type _ _).mp F.cond))⟩
  let ιs : Gs ⟶ F := ⟨(G₀.sheafify J).ι⟩
  let l : P ⟶ Gs.obj := Subfunctor.lift u fun U' x hx ↦ G₀.le_sheafify J U' hx
  have : Sheaf.IsLocallySurjective ιs := (Sheaf.isLocallySurjective_iff_epi ιs).mpr
    ⟨fun {E} a b hab ↦ h a b (by
      show (l ≫ ιs.hom) ≫ a.hom = (l ≫ ιs.hom) ≫ b.hom
      rw [Category.assoc, Category.assoc]
      exact congrArg (fun m ↦ l ≫ m.hom) hab)⟩
  refine J.transitive (Presheaf.imageSieve_mem J ιs.hom s) _ fun U' i hi ↦ ?_
  obtain ⟨t, ht⟩ := hi
  have hmem : F.obj.map i.op s ∈ (G₀.sheafify J).obj (op U') := by
    rw [← ht]
    exact t.2
  refine J.superset_covering (fun U'' k hk ↦ ?_) hmem
  show F.obj.map (k ≫ i).op s ∈ G₀.obj (op U'')
  rw [op_comp, FunctorToTypes.map_comp_apply]
  exact hk

end Range

section Adjunction

variable {C : Type u} [Category.{w} C] {J : GrothendieckTopology C} [HasSheafify J (Type w)]
  {D : Type u'} [Category.{w} D] {K : GrothendieckTopology D} [K.Subcanonical]
  {F : Sheaf K (Type w) ⥤ Sheaf J (Type w)} {G : Sheaf J (Type w) ⥤ Sheaf K (Type w)}

/-- **Sections of the image of a sheaf under a left adjoint lift locally along a locally
generating family of sections.**  Let `F` be a left adjoint between categories of sheaves of
sets — the inverse image of a morphism of topoi, for instance — and let the sections
`bₖ ∈ Z(Vₖ)` generate the sheaf `Z` locally.  Then every section `s` over `U` of `F(Z)` is,
locally on `U`, the image of a section of `F(h_{Vₖ})` along `F(h_{Vₖ} ⟶ Z)` for some `k`, the
map `h_{Vₖ} ⟶ Z` being the one classifying `bₖ`.  The family need not be small.

The sections of `F(Z)` which are locally of this form are a subsheaf, and the inclusion of that
subsheaf is an epimorphism: two maps out of `F(Z)` are adjoint to two maps out of `Z`, and those
agree on every `bₖ` because the two maps agree after every `F(h_{Vₖ} ⟶ Z)`, hence agree
everywhere because the `bₖ` generate `Z` locally.  An epimorphism of sheaves of sets is locally
surjective, so every section lies in the subsheaf. -/
theorem exists_locally_lift_of_adjunction (adj : F ⊣ G) {Z : Sheaf K (Type w)} {ι : Type*}
    (V : ι → D) (b : ∀ k, Z.obj.obj (op (V k)))
    (h : ∀ (W : D) (z : Z.obj.obj (op W)), ∃ T : Sieve W, T ∈ K W ∧
      ∀ ⦃W' : D⦄ (i : W' ⟶ W), T i → ∃ (k : ι) (φ : W' ⟶ V k),
        Z.obj.map φ.op (b k) = Z.obj.map i.op z)
    {U : C} (s : (F.obj Z).obj.obj (op U)) :
    ∃ T : Sieve U, T ∈ J U ∧ ∀ ⦃U' : C⦄ (i : U' ⟶ U), T i →
      ∃ (k : ι) (s' : (F.obj (K.yoneda.obj (V k))).obj.obj (op U')),
        (F.map (K.yonedaEquiv.symm (b k))).hom.app (op U') s' = (F.obj Z).obj.map i.op s := by
  let P := F.obj Z
  let G₀ : Subfunctor P.obj :=
    { obj := fun U' => {σ | ∃ (k : ι) (s' : (F.obj (K.yoneda.obj (V k))).obj.obj U'),
          (F.map (K.yonedaEquiv.symm (b k))).hom.app U' s' = σ}
      map := by
        rintro U₁ U₂ i σ ⟨k, s', rfl⟩
        exact ⟨k, (F.obj (K.yoneda.obj (V k))).obj.map i s',
          ConcreteCategory.congr_hom ((F.map (K.yonedaEquiv.symm (b k))).hom.naturality i) s'⟩ }
  refine ⟨G₀.sieveOfSection s, ?_, fun U' i hi ↦ hi⟩
  have hs := sieveOfSection_range_mem G₀.ι (fun Y a a' hab ↦ by
    apply (adj.homEquiv _ _).injective
    apply Sheaf.hom_ext
    ext ⟨W⟩ z
    show (adj.homEquiv _ _ a).hom.app (op W) z = (adj.homEquiv _ _ a').hom.app (op W) z
    obtain ⟨T, hT, hTz⟩ := h W z
    refine (((isSheaf_iff_isSheaf_of_type _ _).mp (G.obj Y).cond).isSeparated T hT).ext
      fun W' i hi ↦ ?_
    obtain ⟨k, φ, hφ⟩ := hTz i hi
    have hk : F.map (K.yonedaEquiv.symm (b k)) ≫ a = F.map (K.yonedaEquiv.symm (b k)) ≫ a' := by
      apply Sheaf.hom_ext
      let l := Subfunctor.lift (G := G₀) (F.map (K.yonedaEquiv.symm (b k))).hom
        (by rintro U' _ ⟨s', rfl⟩; exact ⟨k, s', rfl⟩)
      show (l ≫ G₀.ι) ≫ a.hom = (l ≫ G₀.ι) ≫ a'.hom
      rw [Category.assoc, Category.assoc, hab]
    have key : ∀ c : P ⟶ Y, (G.obj Y).obj.map i.op ((adj.homEquiv _ _ c).hom.app (op W) z) =
        (G.obj Y).obj.map φ.op
          (K.yonedaEquiv (adj.homEquiv _ _ (F.map (K.yonedaEquiv.symm (b k)) ≫ c))) := fun c ↦ by
      rw [Adjunction.homEquiv_naturality_left, GrothendieckTopology.yonedaEquiv_comp,
        Equiv.apply_symm_apply]
      have n1 := ConcreteCategory.congr_hom ((adj.homEquiv _ _ c).hom.naturality i.op) z
      have n2 := ConcreteCategory.congr_hom ((adj.homEquiv _ _ c).hom.naturality φ.op) (b k)
      simp only [ConcreteCategory.comp_apply] at n1 n2
      rw [← n1, ← n2, hφ]
    rw [key, key, hk]) s
  rwa [Subfunctor.range_ι] at hs

/-- **Sections of the image of a representable sheaf under a left adjoint lift locally along a
covering.**  Let `F` be a left adjoint between categories of sheaves of sets, let `R` be a
covering sieve of `W`, and let `s` be a section over `U` of `F(h_W)`.  Then, locally on `U`, `s`
is the image of a section of `F(h_{W'})` along `F(h_j)` for some `j : W' ⟶ W` in `R`.  This is
`CategoryTheory.Sheaf.exists_locally_lift_of_adjunction` for the family of the arrows of `R`,
which generates `h_W` locally because `R` covers `W`. -/
theorem exists_covering_lift_of_adjunction (adj : F ⊣ G) {W : D} {R : Sieve W} (hR : R ∈ K W)
    {U : C} (s : (F.obj (K.yoneda.obj W)).obj.obj (op U)) :
    ∃ T : Sieve U, T ∈ J U ∧ ∀ ⦃U' : C⦄ (i : U' ⟶ U), T i →
      ∃ (W' : D) (j : W' ⟶ W), R j ∧ ∃ s' : (F.obj (K.yoneda.obj W')).obj.obj (op U'),
        (F.map (K.yoneda.map j)).hom.app (op U') s' = (F.obj (K.yoneda.obj W)).obj.map i.op s := by
  obtain ⟨T, hT, hTs⟩ := exists_locally_lift_of_adjunction adj
    (Z := K.yoneda.obj W) (ι := {p : Σ W' : D, W' ⟶ W // R p.2}) (fun p ↦ p.1.1)
    (fun p ↦ (p.1.2 : (K.yoneda.obj W).obj.obj (op p.1.1))) (fun W₀ z ↦ by
      refine ⟨R.pullback z, K.pullback_stable z hR, fun W' i hi ↦ ⟨⟨⟨W', i ≫ z⟩, hi⟩, 𝟙 _, ?_⟩⟩
      exact Category.id_comp (i ≫ z)) s
  refine ⟨T, hT, fun U' i hi ↦ ?_⟩
  obtain ⟨⟨⟨W', j⟩, hj⟩, s', hs'⟩ := hTs i hi
  refine ⟨W', j, hj, s', Eq.trans ?_ hs'⟩
  rw [show K.yonedaEquiv.symm (j : (K.yoneda.obj W).obj.obj (op W')) = K.yoneda.map j by
    rw [Equiv.symm_apply_eq, GrothendieckTopology.yonedaEquiv_yoneda_map]]

end Adjunction

end CategoryTheory.Sheaf

end
