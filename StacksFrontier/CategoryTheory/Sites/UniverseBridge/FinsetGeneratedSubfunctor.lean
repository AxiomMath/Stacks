/-!
# Finitely generated subfunctors of a functor to types

Let `P : A ⥤ Type w`. For a finite set `s` of sections of `P` — pairs `⟨b, x⟩` with `x : P.obj b` —
the subfunctor generated by `s` is the supremum of the subfunctors generated by its members, whose
value at `a` is the set of `P.map f x` for `⟨b, x⟩ ∈ s` and a single arrow `f : b ⟶ a`. These
subfunctors are monotone in `s` and exhaust `P`.

## Main definitions

* `Stacks.Sites.UniverseBridge.ofSectionGen`: the subfunctor generated by one section, for an
  arbitrary domain.
* `Stacks.Sites.UniverseBridge.generated`: the subfunctor generated by a finite set of sections.

## Main results

* `Stacks.Sites.UniverseBridge.generated_monotone`: `generated` is monotone in the finite set.
* `Stacks.Sites.UniverseBridge.exists_generated_mem`: every section of `P` lies in a finitely
  generated subfunctor.

## References

* [Stacks Project, Tag 0GN2](https://stacks.math.columbia.edu/tag/0GN2)
-/

@[expose] public section

open CategoryTheory

universe w v u

namespace Stacks.Sites.UniverseBridge

variable {A : Type u} [Category.{v} A] {P : A ⥤ Type w}

/-- The subfunctor of `P : A ⥤ Type w` generated by a single section `x : P.obj X`, for an
arbitrary domain `A`: its value at `U` is the set of `P.map f x` for `f : X ⟶ U`. -/
public def ofSectionGen {X : A} (x : P.obj X) : Subfunctor P where
  obj U := {u | ∃ f : X ⟶ U, P.map f x = u}
  map {U V} g := by
    rintro _ ⟨f, rfl⟩
    exact ⟨f ≫ g, by simp⟩

/-- A section lies in the subfunctor it generates, via the identity arrow. -/
public lemma mem_ofSectionGen_self {X : A} (x : P.obj X) :
    x ∈ (ofSectionGen x).obj X :=
  ⟨𝟙 X, by simp⟩

variable (P) in
/-- The subfunctor of `P` generated by a finite set of sections. -/
public def generated (s : Finset (Σ a, P.obj a)) : Subfunctor P :=
  ⨆ p ∈ s, ofSectionGen p.2

/-- Enlarging the finite set of generators enlarges the subfunctor. -/
public lemma generated_monotone {s t : Finset (Σ a, P.obj a)} (h : s ⊆ t) :
    generated P s ≤ generated P t :=
  iSup₂_le fun p hp => le_iSup₂_of_le p (h hp) le_rfl

/-- A section lies in the subfunctor generated by its own singleton. -/
public lemma mem_generated_singleton (p : Σ a, P.obj a) :
    p.2 ∈ (generated P {p}).obj p.1 :=
  (le_iSup₂_of_le (f := fun (q : Σ a, P.obj a) (_ : q ∈ ({p} : Finset (Σ a, P.obj a))) =>
      ofSectionGen q.2) p (Finset.mem_singleton_self p) le_rfl) p.1
    (mem_ofSectionGen_self p.2)

/-- The finitely generated subfunctors exhaust `P`: every section of `P` lies in the subfunctor
generated by some finite set of sections, namely its own singleton. -/
public lemma exists_generated_mem (a : A) (x : P.obj a) :
    ∃ s : Finset (Σ a, P.obj a), x ∈ (generated P s).obj a := by
  refine ⟨{⟨a, x⟩}, ?_⟩
  exact mem_generated_singleton (P := P) ⟨a, x⟩

end Stacks.Sites.UniverseBridge

end
