/-!
# The generated subfunctors, shrunk to `Type u`

For `P : A ⥤ Type (max u w)` on a `u`-small category `A` and a finite set `s` of sections, the
generated subfunctor has `u`-small values, so `CategoryTheory.FunctorToTypes.shrink` transports it
to a functor landing in `Type u`. This module records that transport and the comparison of its
lift to `Type (max u w)` back into `P`.

## Main definitions

* `shrinkSelfIso`: a functor to `Type w'` with `w'`-small values is isomorphic to its shrinking.
* `shrinkUliftIso`: the comparison undoing the shrink and the lift at once.
* `generatedShrunk`: the subfunctor generated by `s`, transported to `A ⥤ Type u`.
* `generatedShrunkUliftIso`: its lift is isomorphic to the generated subfunctor itself.
* `generatedShrunkToP`: the comparison of the lift into `P`.

## Main results

* `shrinkMap_id`, `shrinkMap_comp`: functoriality of `FunctorToTypes.shrinkMap`.
* `homOfLe_self`, `homOfLe_comp`: functoriality of `Subfunctor.homOfLe`.
* `whiskerRight_shrinkMap_comp_shrinkUliftIso_hom`: naturality of `shrinkUliftIso` in the
  functor.

## References

* [Stacks Project, Tag 0GN2](https://stacks.math.columbia.edu/tag/0GN2)
-/

@[expose] public noncomputable section

open CategoryTheory

universe w'' w' w v u

namespace Stacks.Sites.UniverseBridge

/-- A functor to `Type w'` whose values are `w'`-small is isomorphic to its own shrinking at
`w'`. -/
@[simps!]
public def shrinkSelfIso {B : Type u} [Category.{v} B] (F : B ⥤ Type w')
    [FunctorToTypes.Small.{w'} F] : FunctorToTypes.shrink.{w'} F ≅ F :=
  NatIso.ofComponents fun X ↦ Equiv.toIso (equivShrink (F.obj X)).symm

section Functoriality

variable {B : Type u} [Category.{v} B] {F G H : B ⥤ Type w'}

/-- Shrinking the identity is the identity. -/
public lemma shrinkMap_id (F : B ⥤ Type w') [FunctorToTypes.Small.{w} F] :
    FunctorToTypes.shrinkMap.{w} (𝟙 F) = 𝟙 (FunctorToTypes.shrink.{w} F) := by
  ext a x
  simp

/-- Shrinking respects composition. -/
public lemma shrinkMap_comp (τ : F ⟶ G) (σ : G ⟶ H) [FunctorToTypes.Small.{w} F]
    [FunctorToTypes.Small.{w} G] [FunctorToTypes.Small.{w} H] :
    FunctorToTypes.shrinkMap.{w} (τ ≫ σ) =
      FunctorToTypes.shrinkMap.{w} τ ≫ FunctorToTypes.shrinkMap.{w} σ := by
  ext a x
  simp

/-- The inclusion of a subfunctor into itself is the identity. -/
public lemma homOfLe_self {Q : Subfunctor F} (h : Q ≤ Q) :
    Subfunctor.homOfLe h = 𝟙 Q.toFunctor := by
  ext a x
  rfl

/-- The inclusions of subfunctors compose. -/
public lemma homOfLe_comp {Q Q' Q'' : Subfunctor F} (h : Q ≤ Q') (h' : Q' ≤ Q'') :
    Subfunctor.homOfLe h ≫ Subfunctor.homOfLe h' = Subfunctor.homOfLe (h.trans h') := by
  ext a x
  rfl

/-- Undoing the shrink and the lift at once: a `w'`-small functor to `Type (max w' w'')` is
recovered from its `w'`-shrinking lifted back up: the comparison with `shrink.{max w' w''}`
followed by `shrinkSelfIso`. -/
public def shrinkUliftIso (F : B ⥤ Type (max w' w'')) [FunctorToTypes.Small.{w'} F] :
    FunctorToTypes.shrink.{w'} F ⋙ uliftFunctor.{w'', w'} ≅ F :=
  FunctorToTypes.shrinkCompUliftFunctorIso.{w', max w' w'', w''} F ≪≫ shrinkSelfIso F

/-- The comparison `shrinkUliftIso` undoes the shrink on sections. -/
public lemma shrinkUliftIso_hom_app_apply {F : B ⥤ Type (max w' w'')}
    [FunctorToTypes.Small.{w'} F] (a : B)
    (x : (FunctorToTypes.shrink.{w'} F ⋙ uliftFunctor.{w'', w'}).obj a) :
    (shrinkUliftIso.{w'', w'} F).hom.app a x = (equivShrink (F.obj a)).symm x.down :=
  Equiv.symm_apply_apply _ _

/-- **`shrinkUliftIso` is natural in the functor.** -/
public lemma whiskerRight_shrinkMap_comp_shrinkUliftIso_hom {F G : B ⥤ Type (max w' w'')}
    [FunctorToTypes.Small.{w'} F] [FunctorToTypes.Small.{w'} G] (τ : F ⟶ G) :
    Functor.whiskerRight (FunctorToTypes.shrinkMap.{w'} τ) uliftFunctor.{w'', w'} ≫
        (shrinkUliftIso.{w'', w'} G).hom =
      (shrinkUliftIso.{w'', w'} F).hom ≫ τ := by
  ext a x
  simp only [NatTrans.comp_app, TypeCat.Fun.toFun_apply, ConcreteCategory.comp_apply]
  rw [shrinkUliftIso_hom_app_apply, shrinkUliftIso_hom_app_apply]
  exact (equivShrink (G.obj a)).symm_apply_apply _

end Functoriality

variable {A : Type u} [SmallCategory A] (P : A ⥤ Type (max u w))

/-- The generated subfunctor has `u`-small values, so it may be shrunk to `Type u`. -/
public instance smallGeneratedToFunctor (s : Finset (Σ a, P.obj a)) :
    FunctorToTypes.Small.{u} ((generated P s).toFunctor) :=
  fun a ↦ small_generated_obj P s a

/-- The subfunctor generated by a finite set of sections, transported into `Type u`. -/
public abbrev generatedShrunk (s : Finset (Σ a, P.obj a)) : A ⥤ Type u :=
  FunctorToTypes.shrink.{u} ((generated P s).toFunctor)

/-- Lifting the shrunken generated subfunctor back to `Type (max u w)` recovers it. -/
public def generatedShrunkUliftIso (s : Finset (Σ a, P.obj a)) :
    generatedShrunk P s ⋙ uliftFunctor.{w, u} ≅ (generated P s).toFunctor :=
  shrinkUliftIso.{w, u} ((generated P s).toFunctor)

/-- The comparison of the lifted shrunken generated subfunctor into `P`. -/
public def generatedShrunkToP (s : Finset (Σ a, P.obj a)) :
    generatedShrunk P s ⋙ uliftFunctor.{w, u} ⟶ P :=
  (generatedShrunkUliftIso P s).hom ≫ (generated P s).ι

end Stacks.Sites.UniverseBridge

end
