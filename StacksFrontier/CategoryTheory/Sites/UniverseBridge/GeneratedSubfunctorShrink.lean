/-!
# The index of finitely generated subfunctors is filtered, and its values are small

For `P : A ⥤ Type w` on a `u`-small category `A`, the finite sets of sections of `P` index the
finitely generated subfunctors. This module records that the index is filtered — by union of
finite sets — and that each generated subfunctor has `u`-small values.

`Finset (Σ a, P.obj a)` needs `DecidableEq` for its union, and an arbitrary type need not carry a
specified computable equality; `Classical.decEq` supplies one, which is harmless in this
noncomputable development.

## Main results

* `isFiltered_finsetGens`: the index is filtered.
* `small_generated_obj`: `(generated P s).obj a` is `u`-small.

## References

* [Stacks Project, Tag 0GN2](https://stacks.math.columbia.edu/tag/0GN2)
-/

@[expose] public section

open CategoryTheory

universe w u

namespace Stacks.Sites.UniverseBridge

variable {A : Type u} [SmallCategory A] (P : A ⥤ Type w)

/-- The index of the density presentation — finite sets of sections of `P` — is filtered: the
union of two finite sets dominates both. `DecidableEq` for the union comes from `Classical`. -/
public lemma isFiltered_finsetGens : IsFiltered (Finset (Σ a, P.obj a)) := by
  classical
  exact isFiltered_of_semilatticeSup_nonempty _

/-- The value at `a` of the subfunctor generated by a finite set of sections is `u`-small: it is
the image of the `u`-small type of pairs (a generator in `s`, an arrow out of it). -/
public lemma small_generated_obj (s : Finset (Σ a, P.obj a)) (a : A) :
    Small.{u} ((generated P s).obj a) := by
  classical
  have : Small.{u} ((s : Set (Σ a, P.obj a))) :=
    small_of_injective (f := fun p => (s.equivFin p : Fin s.card)) (Equiv.injective _)
  have : Small.{u} ((p : (s : Set (Σ a, P.obj a))) × ((p : Σ a, P.obj a).1 ⟶ a)) :=
    inferInstance
  have hmem : ∀ (q : (p : (s : Set (Σ a, P.obj a))) × ((p : Σ a, P.obj a).1 ⟶ a)),
      P.map q.2 (q.1 : Σ a, P.obj a).2 ∈ (generated P s).obj a := by
    intro q
    have hle : ofSectionGen (P := P) (q.1 : Σ a, P.obj a).2 ≤ generated P s :=
      le_iSup₂_of_le (q.1 : Σ a, P.obj a) q.1.2 le_rfl
    exact hle a ⟨q.2, rfl⟩
  refine small_of_surjective (f := fun q => (⟨_, hmem q⟩ : (generated P s).obj a)) ?_
  rintro ⟨u, hu⟩
  have hu' : u ∈ ⋃ p : (Σ a, P.obj a), ⋃ (_ : p ∈ s),
      (ofSectionGen (P := P) p.2).obj a := by
    simpa only [generated, Subfunctor.iSup_obj] using hu
  rcases Set.mem_iUnion.mp hu' with ⟨p, hp'⟩
  rcases Set.mem_iUnion.mp hp' with ⟨hp, hf'⟩
  rcases hf' with ⟨f, hf⟩
  exact ⟨⟨⟨p, hp⟩, f⟩, Subtype.ext hf⟩

end Stacks.Sites.UniverseBridge

end
