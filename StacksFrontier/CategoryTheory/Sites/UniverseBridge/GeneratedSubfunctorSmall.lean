public import Mathlib.Logic.Small.Set

/-!
# Finitely generated subfunctors have small values

For `P : A ⥤ Type w` on a `u`-small category `A`, the subfunctor generated by a finite set `s` of
sections takes `u`-small values: at `a` it is the union, over the finitely many generators
`⟨b, x⟩ ∈ s`, of the range of `fun f : b ⟶ a => P.map f x`. Each range is `u`-small because the
hom-set is, and a finite union of `u`-small sets is `u`-small.

This is the smallness half of the density step of the universe bridge of Stacks 0GN2: it is what
licenses shrinking the generated subfunctors to `Type u` before sheafifying.

## Main results

* `small_generated_obj`: `(generated P s).obj a` is `u`-small.

## References

* [Stacks Project, Tag 0GN2](https://stacks.math.columbia.edu/tag/0GN2)
-/

@[expose] public section

open CategoryTheory

universe w u

namespace Stacks.Sites.UniverseBridge

variable {A : Type u} [SmallCategory A] {P : A ⥤ Type w}

/-- The value at `a` of the subfunctor generated by one section `x : P.obj X` is the range of
`fun f : X ⟶ a => P.map f x`, so it is `u`-small when the hom-sets are. -/
public lemma small_ofSectionGen_obj {X : A} (x : P.obj X) (a : A) :
    Small.{u} ((ofSectionGen (P := P) x).obj a) := by
  have : (ofSectionGen (P := P) x).obj a = Set.range (fun f : X ⟶ a => P.map f x) := by
    ext u
    exact ⟨fun ⟨f, hf⟩ => ⟨f, hf⟩, fun ⟨f, hf⟩ => ⟨f, hf⟩⟩
  rw [this]
  infer_instance

end Stacks.Sites.UniverseBridge

end
