module

public import Mathlib.CategoryTheory.Sites.Continuous
import StacksCore.Tactic.StacksAttribute

/-!
# Restriction along a continuous functor preserves sheaves

Let `C` and `D` be sites, given by precoverages `J` and `K`, and let `u : C ⥤ D` be continuous in
the sense of Stacks 00WV: for every covering `{Vᵢ ⟶ V}` of `J`,

1. the image family `{u(Vᵢ) ⟶ u(V)}` is a covering of `K`, and
2. for every morphism `T ⟶ V` of `C`, the functor `u` carries the fibre product `T ×_V Vᵢ` to a
   fibre product `u(T) ×_{u(V)} u(Vᵢ)`.

Then for every sheaf `F` on `D` the presheaf `u^p F = F ∘ u` is a sheaf on `C` (Stacks 00WW).

Mathlib's `CategoryTheory.Functor.isContinuous_of_coverPreserving` reaches the same conclusion
from `CompatiblePreserving`, a condition on every presieve rather than on the coverings, which a
functor continuous in the sense of 00WV need not satisfy. The form proved here is the source's:
its hypotheses are the two clauses of 00WV, and its conclusion is the sheaf condition for the
coverings of `J`.

## Main results

* `CategoryTheory.Functor.isSheafFor_op_comp_of_preservesLimit_cospan` (**Stacks 00WW**): `u^p F`
  satisfies the sheaf condition for every covering of `J` when `F` does for every covering of `K`.
* `CategoryTheory.Functor.isContinuous_toGrothendieck_of_preservesLimit_cospan` (**Stacks 00WW**):
  the same statement for the Grothendieck topologies the two precoverages generate, as
  `CategoryTheory.Functor.IsContinuous`.

## References

* [Stacks Project, Tag 00WV](https://stacks.math.columbia.edu/tag/00WV)
* [Stacks Project, Tag 00WW](https://stacks.math.columbia.edu/tag/00WW)
-/

@[expose] public section

namespace CategoryTheory.Functor

open Limits

universe w v₁ v₂ u₁ u₂

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]

/-- **Stacks 00WW.** Let `J` and `K` be precoverages on `C` and `D` such that the fibre products
`T ×_V Vᵢ` of a `J`-covering `{Vᵢ ⟶ V}` with any `T ⟶ V` exist (axiom (3) of a site, Stacks
00VH), and let `u : C ⥤ D` be continuous in the sense of Stacks 00WV:
`hcov` says that the image `{u(Vᵢ) ⟶ u(V)}` of a `J`-covering is a `K`-covering, and `hpb` that
`u` carries each fibre product `T ×_V Vᵢ` to a fibre product. If a presheaf of sets `F` on `D`
satisfies the sheaf condition for every `K`-covering, then `u^p F = u.op ⋙ F` satisfies it for
every `J`-covering.

The remaining axioms of a site (isomorphisms and composites of coverings are coverings, and
coverings are stable under base change) are not used, so they are not assumed. -/
@[stacks 00WW "u^p of a sheaf is a sheaf, for the sheaf condition on the coverings of the sites"]
theorem isSheafFor_op_comp_of_preservesLimit_cospan (J : Precoverage C) (K : Precoverage D)
    [J.HasPullbacks] (u : C ⥤ D)
    (hcov : ∀ ⦃V : C⦄ ⦃R : Presieve V⦄, R ∈ J V → R.map u ∈ K (u.obj V))
    (hpb : ∀ ⦃V : C⦄ ⦃R : Presieve V⦄, R ∈ J V → ∀ ⦃Vᵢ : C⦄ ⦃f : Vᵢ ⟶ V⦄, R f →
      ∀ ⦃T : C⦄ (g : T ⟶ V), PreservesLimit (cospan g f) u)
    (F : Dᵒᵖ ⥤ Type w) (hF : ∀ ⦃U : D⦄ (S : Presieve U), S ∈ K U → Presieve.IsSheafFor F S)
    ⦃V : C⦄ (R : Presieve V) (hR : R ∈ J V) : Presieve.IsSheafFor (u.op ⋙ F) R := by
  have : R.HasPairwisePullbacks := J.hasPairwisePullbacks_of_mem hR
  have : u.PreservesPairwisePullbacks R := ⟨fun _ _ _ _ _ hg ↦ hpb hR hg _⟩
  rw [Presieve.IsSheafFor.comp_iff_of_preservesPairwisePullbacks]
  exact hF _ (hcov hR)

/-- **Stacks 00WW**, for the Grothendieck topologies generated by the coverings. Let `J` and `K`
be precoverages on `C` and `D` whose coverings have fibre products with arbitrary morphisms and
are stable under base change (axiom (3) of a site, Stacks 00VH), and let `u : C ⥤ D` be
continuous in the sense of Stacks 00WV (`hcov`, `hpb`, as in
`CategoryTheory.Functor.isSheafFor_op_comp_of_preservesLimit_cospan`). Then restriction along `u`
carries sheaves for the topology generated by `K` to sheaves for the topology generated by `J`,
that is, `u` is `CategoryTheory.Functor.IsContinuous`. -/
@[stacks 00WW "u^p of a sheaf is a sheaf, for the generated Grothendieck topologies"]
theorem isContinuous_toGrothendieck_of_preservesLimit_cospan (J : Precoverage C)
    (K : Precoverage D) [J.IsStableUnderBaseChange] [J.HasPullbacks] [K.IsStableUnderBaseChange]
    [K.HasPullbacks] (u : C ⥤ D)
    (hcov : ∀ ⦃V : C⦄ ⦃R : Presieve V⦄, R ∈ J V → R.map u ∈ K (u.obj V))
    (hpb : ∀ ⦃V : C⦄ ⦃R : Presieve V⦄, R ∈ J V → ∀ ⦃Vᵢ : C⦄ ⦃f : Vᵢ ⟶ V⦄, R f →
      ∀ ⦃T : C⦄ (g : T ⟶ V), PreservesLimit (cospan g f) u) :
    u.IsContinuous J.toGrothendieck K.toGrothendieck := by
  have : J.PullbacksPreservedBy u := ⟨fun _ _ hR ↦ ⟨fun _ _ _ _ _ hg ↦ hpb hR hg _⟩⟩
  exact u.isContinuous_toGrothendieck_of_pullbacksPreservedBy J K hcov

end CategoryTheory.Functor
