module

public import Mathlib.CategoryTheory.Sites.Coverage
public import StacksFrontier.CategoryTheory.Sites.Pretopology.SmallSubsite
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Property P for a functor between sites

Stacks 09W7 attaches to a functor `F : C ⥤ D` between sites the condition that every covering
family of `D` can be pulled back, along a morphism whose source lies in the image of `F`, to a
covering family of `C`. The pullback is not required to be a pullback in `D`: its universal
property is tested only on objects coming from `C`, which is what
`CategoryTheory.Functor.IsRepresentablePullback` expresses.

The coverings are the family-based ones of `Covering`, so no object of either site is assumed
to admit all pullbacks.

## Main definitions

* `CategoryTheory.topologyOfCoverings`: the Grothendieck topology generated by a class of
  covering families.
* `CategoryTheory.Functor.IsRepresentablePullback`: the universal property of the relative
  pullback `U ×_{g, V, f} W` of Stacks 09W7, tested on the source category only.
* `CategoryTheory.Functor.HasCoverPullbacks`: property P of Stacks 09W7.

## Implementation notes

In `IsRepresentablePullback` and `HasCoverPullbacks` the two sites have their objects in one
universe `u` and their morphisms in one universe `v`, and the index types of covering families
lie in `max u v`.

## References

* [Stacks Project, Tag 09W7](https://stacks.math.columbia.edu/tag/09W7)
* [Stacks Project, Tag 09WD](https://stacks.math.columbia.edu/tag/09WD)
-/

@[expose] public section

open CategoryTheory

universe u v

namespace CategoryTheory

/-- The Grothendieck topology generated by a class of covering families: a sieve covers when it
contains the sieve generated by one of the families. -/
@[sga "3 IV 4.2.2"]
def topologyOfCoverings {C : Type u} [Category.{v} C]
    (Cov : Covering.{u, v, max u v} C → Prop) : GrothendieckTopology C :=
  ({ coverings := fun U ↦
      { R | ∃ E : PreZeroHypercover.{max u v} U, Cov ⟨U, E⟩ ∧ E.presieve₀ = R } } :
    Precoverage C).toGrothendieck

namespace Functor

/-- The object `P` represents the functor sending `T` to pairs of maps `T ⟶ U` and
`F.obj T ⟶ W` whose images in `V` agree. This is the relative pullback
`U ×_{g, V, f} W` of Stacks 09W7; unlike an ordinary pullback, its universal property is
tested only on objects in the source category. -/
def IsRepresentablePullback {C : Type u} [Category.{v} C]
    {D : Type u} [Category.{v} D] (F : C ⥤ D) {U : C} {V W : D}
    (g : F.obj U ⟶ V) (f : W ⟶ V) (P : C) (p₁ : P ⟶ U)
    (p₂ : F.obj P ⟶ W) : Prop :=
  F.map p₁ ≫ g = p₂ ≫ f ∧
    ∀ (T : C) (a : T ⟶ U) (b : F.obj T ⟶ W),
      F.map a ≫ g = b ≫ f →
        ∃! l : T ⟶ P, (l ≫ p₁ = a ∧ F.map l ≫ p₂ = b)

/-- Property P of Stacks 09W7: covering families have representable base changes along
morphisms whose source is in the image of the functor, and the resulting family is
covering. -/
def HasCoverPullbacks {C : Type u} [Category.{v} C]
    {D : Type u} [Category.{v} D] (F : C ⥤ D)
    (CovC : Covering.{u, v, max u v} C → Prop)
    (CovD : Covering.{u, v, max u v} D → Prop) : Prop :=
  ∀ (𝒱 : Covering.{u, v, max u v} D), CovD 𝒱 →
    ∀ (U : C) (g : F.obj U ⟶ 𝒱.1),
      ∃ (P : 𝒱.2.I₀ → C) (p₁ : ∀ i, P i ⟶ U)
        (p₂ : ∀ i, F.obj (P i) ⟶ 𝒱.2.X i),
        (∀ i, IsRepresentablePullback F g (𝒱.2.f i) (P i) (p₁ i) (p₂ i)) ∧
          CovC ⟨U, ⟨𝒱.2.I₀, P, p₁⟩⟩

end Functor

end CategoryTheory

end
