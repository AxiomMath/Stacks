module

public import StacksFrontier.CategoryTheory.Sites.Hypercovering.SheafCoequalizer
public import StacksFrontier.CategoryTheory.Sites.SemiRepresentable.PushPullNaturality
public import StacksFrontier.CategoryTheory.Sites.Simplicial.HypercoveringDescent
public import StacksFrontier.CategoryTheory.Sites.Simplicial.TotalAugmentationMorphism

/-!
# The vertices of the fork of the total direct image are internal homs

Let `(C, J)` be a site and let `K` be a simplicial semi-representable object of `C` whose
localized topology admits pullbacks of coverings, so that the simplicial family of sites
`n ↦ C/K_n` of Stacks 0D8B exists, with total site `(C/K)_total` and augmentation `a` given by
the degree-zero localization functor `j_0`.

Stacks 0D70 (3) exhibits the total direct image `a_* F` as the equalizer of two transitions
between the direct images of the component augmentations, the vertex in simplicial degree `k`
being `a_{k,*}` of the restriction of `F` to that degree. This file identifies those vertices
at an inverse image: for `F = a^{-1} G` the degree-`k` vertex is the internal hom
`SheafHom(F(K_k)^#, G)`, naturally in `G`.

By Stacks 0D8B the morphism of topoi `a_k` which Stacks 0D70 attaches to the augmentation is the
morphism of topoi of the localization functor `j_k : C/K_k ⥤ C`, and by Stacks 0D86 push-pull
along `j_k` is the internal hom out of `F(K_k)^#`.

## Main definitions

* `CategoryTheory.SimplicialSemiRepresentable.componentPushPullSheafHomIso`: **Stacks 0D86** in
  simplicial degree `k`, push-pull along `j_k` is `SheafHom(F(K_k)^#, -)`.
* `CategoryTheory.SimplicialSemiRepresentable.componentAugmentationPushPullSheafHomIso`:
  push-pull along the degree-`k` component augmentation is `SheafHom(F(K_k)^#, -)`.
* `CategoryTheory.SimplicialSemiRepresentable.forkVertexSheafHomIso`: the degree-`k` vertex of
  the fork of Stacks 0D70 (3), evaluated at an inverse image along the augmentation, is
  `SheafHom(F(K_k)^#, -)`.
* `CategoryTheory.SimplicialSemiRepresentable.restrictForkVertexSheafHomIso`: the same with the
  total augmentation read as the morphism of topoi of Stacks 0D70, part (2), and restriction in
  place of the inverse image of the component morphism.
* `CategoryTheory.SimplicialSemiRepresentable.forkVertexSheafHomIsoTotalLocalization`: the same
  with the augmentation read as restriction along `j_total`.

## Implementation notes

The topology of the component site `C/K_k` is generated by a family of coverings and is only
propositionally the componentwise localized topology (`componentTopology_eq`). The localization
functor of simplicial degree `k` is the componentwise localization functor of `K_k`
definitionally (`sliceForget_eq`).

## References

* [Stacks Project, Tag 0D8E](https://stacks.math.columbia.edu/tag/0D8E)
* [Stacks Project, Tag 0D86](https://stacks.math.columbia.edu/tag/0D86)
* [Stacks Project, Tag 0D8B](https://stacks.math.columbia.edu/tag/0D8B)
* [Stacks Project, Tag 0D70](https://stacks.math.columbia.edu/tag/0D70)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace CategoryTheory.SimplicialSemiRepresentable

variable {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)
  (K : SimplicialObject (FormalCoproduct.{u} C)) [J.toCoverage.HasPullbacks]

/-- Push-pull along the localization functor `j_k : C/K_k ⥤ C` of the site of simplicial degree
`k` is the internal hom out of `F(K_k)^#`. -/
def componentPushPullSheafHomIso (k : SimplexCategory) :
    (localizationMorphism J K k).inverseImage ⋙ (localizationMorphism J K k).pushforward ≅
      SheafHomAdj.sheafHomFunctor
        (SemiRepresentable.formalCoproductSheafifiedYoneda J (K.obj (op k))) :=
  letI : (SemiRepresentable.componentOverForget (K.obj (op k))).IsContinuous
      ((situation J K).componentTopology k) J := sliceForget_isContinuous J K k
  letI : (SemiRepresentable.componentOverForget (K.obj (op k))).IsCocontinuous
      ((situation J K).componentTopology k) J := sliceForget_isCocontinuous J K k
  SemiRepresentable.pushPullSheafHomIso J (K.obj (op k))
    ((situation J K).componentTopology k) (componentTopology_eq J K k)

/-- Push-pull along the degree-`k` component augmentation is the internal hom out of
`F(K_k)^#`. -/
def componentAugmentationPushPullSheafHomIso (k : SimplexCategory) :
    (SimplicialSiteSituation.Augmentation.componentAugmentation (situation J K) (Cat.of C) J
          (situationAugmentation J K) k).inverseImage ⋙
        (SimplicialSiteSituation.Augmentation.componentAugmentation (situation J K) (Cat.of C) J
          (situationAugmentation J K) k).pushforward ≅
      SheafHomAdj.sheafHomFunctor
        (SemiRepresentable.formalCoproductSheafifiedYoneda J (K.obj (op k))) :=
  Functor.isoWhiskerRight (componentInverseImageIso J K k) _ ≪≫
    Functor.isoWhiskerLeft (localizationMorphism J K k).inverseImage
      (componentPushforwardIso J K k) ≪≫
      componentPushPullSheafHomIso J K k

/-- **The degree-`k` vertex of the fork of Stacks 0D70 (3) at an inverse image.** For a sheaf of
sets `G` on `(C, J)` the direct image along the degree-`k` component augmentation of the
restriction to degree `k` of `a^{-1} G` is `SheafHom(F(K_k)^#, G)`, naturally in `G`. -/
def forkVertexSheafHomIso (k : SimplexCategory) :
    ((CocontinuousSimplicialSite.Augmentation.totalMorphismOfTopoi
          (augmentation J K)).inverseImage ⋙
        (SimplicialSiteSituation.componentMorphism (situation J K) k).inverseImage) ⋙
      (SimplicialSiteSituation.Augmentation.componentAugmentation (situation J K) (Cat.of C) J
        (situationAugmentation J K) k).pushforward ≅
      SheafHomAdj.sheafHomFunctor
        (SemiRepresentable.formalCoproductSheafifiedYoneda J (K.obj (op k))) :=
  Functor.isoWhiskerRight
      (CocontinuousSimplicialSite.Augmentation.componentInclusionCompInverseImageIso
        (augmentation J K) k) _ ≪≫
    componentAugmentationPushPullSheafHomIso J K k

/-- **The degree-`k` vertex of the fork of Stacks 0D70 (3), with the total augmentation read as
the morphism of topoi of Stacks 0D70, part (2).** For a sheaf of sets `G` on `(C, J)` the direct
image along the degree-`k` component augmentation of the restriction to degree `k` of `a^{-1} G`
is `SheafHom(F(K_k)^#, G)`, naturally in `G`. Here restriction to the component replaces the
inverse image of the component morphism. -/
def restrictForkVertexSheafHomIso (k : SimplexCategory) :
    (SimplicialSiteSituation.Augmentation.inverseImage (situation J K) (Cat.of C) J
          (situationAugmentation J K) ⋙ (situation J K).restrict k) ⋙
        (SimplicialSiteSituation.Augmentation.componentAugmentation (situation J K) (Cat.of C) J
          (situationAugmentation J K) k).pushforward ≅
      SheafHomAdj.sheafHomFunctor
        (SemiRepresentable.formalCoproductSheafifiedYoneda J (K.obj (op k))) :=
  Functor.isoWhiskerRight
      (SimplicialSiteSituation.Augmentation.restrictCompInverseImageIso (situation J K)
        (Cat.of C) J (situationAugmentation J K) k) _ ≪≫
    componentAugmentationPushPullSheafHomIso J K k

/-- **The degree-`k` vertex of the fork of Stacks 0D70 (3), with the augmentation read as
restriction along `j_total`.** This is `forkVertexSheafHomIso` precomposed with the
identification of the inverse image of the augmentation with restriction along the localization
functor of the total site. -/
def forkVertexSheafHomIsoTotalLocalization (k : SimplexCategory) :
    ((totalLocalizationMorphism J K).inverseImage ⋙
        (SimplicialSiteSituation.componentMorphism (situation J K) k).inverseImage) ⋙
      (SimplicialSiteSituation.Augmentation.componentAugmentation (situation J K) (Cat.of C) J
        (situationAugmentation J K) k).pushforward ≅
      SheafHomAdj.sheafHomFunctor
        (SemiRepresentable.formalCoproductSheafifiedYoneda J (K.obj (op k))) :=
  Functor.isoWhiskerRight
      (Functor.isoWhiskerRight (totalInverseImageIso J K).symm
        (SimplicialSiteSituation.componentMorphism (situation J K) k).inverseImage) _ ≪≫
    forkVertexSheafHomIso J K k

end CategoryTheory.SimplicialSemiRepresentable

end
