module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.CategoryTheory.Sites.Simplicial.HypercoveringBoundedBelowEquivalence
public import StacksFrontier.CategoryTheory.Sites.Simplicial.HypercoveringDerivedGlobalSections
public import StacksFrontier.CategoryTheory.Sites.Simplicial.HypercoveringSituationGlobalSections
public import StacksFrontier.CategoryTheory.Sites.Simplicial.HypercoveringObjectDerivedDescent
public import StacksFrontier.CategoryTheory.Sites.Simplicial.HypercoveringUnit
public import StacksFrontier.CategoryTheory.Sites.Simplicial.HypercoveringObjectDerivedPushforwardUnconditional

/-!
# Derived descent along the augmentation of a hypercovering of an object

Let `C` be a site with fibre products, `X` an object of `C` and `K` a hypercovering of `X`, a
simplicial object of `SR(C, X) = FormalCoproduct (Over X)`. The simplicial family of sites
`n ↦ (C/X)/K_n` over the slice site `C/X` has a total site `(C/K)_total` and an augmentation
`a : Sh((C/K)_total) ⟶ Sh(C/X)`. This file proves:

* `RΓ(X, E) = RΓ((C/K)_total, a⁻¹E)` for `E` in `D(C/X)`;
* `a⁻¹ : D⁺(C/X) ⟶ D⁺_𝒜((C/K)_total)` is an equivalence with quasi-inverse `Ra_*`, where
  `𝒜 ⊂ Ab((C/K)_total)` is the weak Serre subcategory of cartesian abelian sheaves.

## Main definitions

In the namespace `CategoryTheory.SimplicialSemiRepresentable`:

* `derivedGlobalSectionsInverseImageIsoOverOfHypercovering`: the isomorphism
  `RΓ(X, -) ≅ a⁻¹ ⋙ RΓ((C/K)_total, -)` of functors on the unbounded derived category of abelian
  sheaves on `C/X`.
* `derivedTotalInverseImageEquivalenceOverOfHypercovering`: the equivalence
  `D⁺(C/X) ≌ D⁺_𝒜((C/K)_total)`.

## Main results

* `derivedTotalInverseImageEquivalenceOverOfHypercovering_functor` and
  `derivedTotalInverseImageEquivalenceOverOfHypercovering_inverse`: the two functors of the
  equivalence are the restrictions of `a⁻¹` and of `Ra_*` to the bounded below subcategories.

## Implementation notes

The site `C/X` is `(Over X, P.toGrothendieck.over X)`, the topology generated by the pretopology
`P` localized at `X`, and the augmentation is
`CategoryTheory.SimplicialSemiRepresentable.augmentationOver`.

`RΓ(X, -)` is `CategoryTheory.SimplicialSiteSituation.Augmentation.derivedGlobalSectionsBase`
taken at the site `C/X`, the total right derived functor of `CategoryTheory.Sheaf.Γ` of that site.

`D⁺(C/X)` is `DerivedCategoryB.derivedCategoryBPlus` of the weak Serre subcategory of all abelian
sheaves on `C/X`, which is cohomological boundedness below
(`CategoryTheory.SimplicialSiteSituation.Augmentation.derivedCategoryBPlus_top_iff`).

## References

* [Stacks Project, Tag 09X7](https://stacks.math.columbia.edu/tag/09X7)
* [Stacks Project, Tag 0D8M](https://stacks.math.columbia.edu/tag/0D8M)
* [Stacks Project, Tag 01G5](https://stacks.math.columbia.edu/tag/01G5)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.SimplicialSiteSituation Opposite

universe u

namespace CategoryTheory.SimplicialSemiRepresentable

attribute [local instance] HasDerivedCategory.standard

variable {C : Type u} [SmallCategory C] [HasPullbacks C] (P : Pretopology C) {X : C}
  (K : SimplicialObject (FormalCoproduct.{u} (Over X)))

section Hypercovering

open Stacks.CategoryTheory.Hypercovering

variable (hK : IsHypercovering P K)

include hK in
/-- Let `C` be a site with fibre products, `X` an object of `C`, `K` a hypercovering of `X` and
`a : Sh((C/K)_total) ⟶ Sh(C/X)` the augmentation of the simplicial family of sites
`n ↦ (C/X)/K_n`. Derived global sections over `X` are derived global sections on the total site of
the inverse image:

`RΓ(X, E) = RΓ((C/K)_total, a⁻¹E)`,

as an isomorphism of functors on the unbounded derived category of abelian sheaves on `C/X`. -/
@[stacks 09X7]
def derivedGlobalSectionsInverseImageIsoOverOfHypercovering :
    Augmentation.derivedGlobalSectionsBase (Cat.of (Over X)) (P.toGrothendieck.over X) ≅
      Augmentation.derivedTotalInverseImage (situationOver P K) (Cat.of (Over X))
          (P.toGrothendieck.over X) (augmentationOver P K) ⋙
        Augmentation.derivedGlobalSectionsTotal (situationOver P K) :=
  derivedGlobalSectionsInverseImageIsoOver P K
    (isIso_situationAbelianTotalAdjunctionUnit_over P K hK)
    (inverseImageComputesDerivedPushforward_over_of_isHypercovering P K hK)
    (abelianTotalPushforwardGammaIsoOver P K)

include hK in
/-- Let `C` be a site with fibre products, `X` an object of `C`, `K` a hypercovering of `X`, `a`
the augmentation of the simplicial family of sites `n ↦ (C/X)/K_n`, and `𝒜 ⊂ Ab((C/K)_total)` the
weak Serre subcategory of cartesian abelian sheaves. The derived inverse image is an equivalence

`a⁻¹ : D⁺(C/X) ⟶ D⁺_𝒜((C/K)_total)`

with quasi-inverse `Ra_*`. -/
@[stacks 0D8M]
def derivedTotalInverseImageEquivalenceOverOfHypercovering :
    (DerivedCategoryB.derivedCategoryBPlus
        (⊤ : ObjectProperty
          (Sheaf (P.toGrothendieck.over X) AddCommGrpCat.{u}))).FullSubcategory ≌
      (DerivedCategoryB.derivedCategoryBPlus
        ((situationOver P K).IsCartesianAbSheaf)).FullSubcategory :=
  derivedTotalInverseImageEquivalenceOver P K
    (isIso_situationAbelianTotalAdjunctionUnit_over P K hK)
    (inverseImageComputesDerivedPushforward_over_of_isHypercovering P K hK)
    (essImage_situationTotalInverseImageAb_of_isCartesianAbSheaf_over P K hK)

include hK in
/-- The forward functor of `derivedTotalInverseImageEquivalenceOverOfHypercovering` is the
restriction of the derived inverse image `a⁻¹` to the bounded below subcategories. -/
@[stacks 0D8M "the forward functor of the equivalence is a⁻¹"]
theorem derivedTotalInverseImageEquivalenceOverOfHypercovering_functor :
    (derivedTotalInverseImageEquivalenceOverOfHypercovering P K hK).functor =
      Augmentation.derivedTotalInverseImagePlus (situationOver P K) (Cat.of (Over X))
        (P.toGrothendieck.over X) (augmentationOver P K) :=
  rfl

include hK in
/-- The quasi-inverse of `derivedTotalInverseImageEquivalenceOverOfHypercovering` is the
restriction of the derived direct image `Ra_*` to the bounded below subcategories. -/
@[stacks 0D8M "the quasi-inverse of the equivalence is Ra_*"]
theorem derivedTotalInverseImageEquivalenceOverOfHypercovering_inverse :
    (derivedTotalInverseImageEquivalenceOverOfHypercovering P K hK).inverse =
      Augmentation.derivedTotalPushforwardPlus (situationOver P K) (Cat.of (Over X))
        (P.toGrothendieck.over X) (augmentationOver P K) :=
  rfl

end Hypercovering

end CategoryTheory.SimplicialSemiRepresentable

end
