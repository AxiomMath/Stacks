module

public import StacksFrontier.CategoryTheory.Sites.Simplicial.CartesianSections
public import StacksFrontier.CategoryTheory.Sites.Simplicial.HypercoveringBySimplicialObjectTotalSite

/-!
# Descent along a hypercovering, read on the site `(C/U)_total`

Let `C` be a site with fibre products given by a pretopology `P`, let `U` be a simplicial object of
`C` and let `a : U ⟶ X` be an augmentation which is a hypercovering of `X` in the sense of
Section 09X8. Stacks 0DA8 says that `a^{-1} : Sh(C/X) ⥤ Sh((C/U)_total)` is fully faithful with
essential image the cartesian sheaves. The library proves it for the total site `(C/K)_total` of
the simplicial semi-representable object `K_n = {U_n ⟶ X}`; this file reads it on the site
`(C/U)_total` whose objects are the `V/U_n`, the form in which the site is used in Section 0DHI.

On `(C/U)_total` the cartesian condition is read on sections: a sheaf `F` is cartesian as soon as,
for every simplex map `φ : [m] ⟶ [n]` and every `V/U_n`, restriction along the arrow
`(n, V/U_n) ⟶ (m, V/U_m)` of the total category is a bijection
`F(V/U_m) ⟶ F(V/U_n)`. The transition functors `C/U_n ⥤ C/U_m` being continuous as well as
cocontinuous, this is the same as the invertibility of the transitions of Stacks 09WF.

## Main definitions

* `CategoryTheory.SimplicialOver.IsCartesianOnSections`: restriction along every cross-fibre
  arrow `(n, V/U_n) ⟶ (m, V/U_m)` of `(C/U)_total` is bijective.

## Main results

* `CategoryTheory.Grothendieck.isIso_fiber_map_map`: the functor induced on Grothendieck
  constructions by a natural transformation preserves arrows with invertible fibre component.
* `CategoryTheory.CocontinuousSimplicialSite.isIso_fiberTransition_of_isIso_map_ιNatTrans`: in
  case (B), with continuous transition functors, a sheaf whose restrictions along the cross-fibre
  arrows are bijective has invertible transitions.
* `CategoryTheory.SimplicialSemiRepresentable.isCartesianSheaf_of_isIso_map_ιNatTrans`: the same
  on the total site of a simplicial semi-representable object, the converse of
  `CategoryTheory.SimplicialSemiRepresentable.isIso_map_ιNatTrans_of_isCartesianSheaf`.
* `CategoryTheory.SimplicialOver.IsCartesianOnSections.isIso_map`: restriction along any arrow
  with invertible fibre component is then bijective.
* `CategoryTheory.SimplicialOver.fullyFaithfulAugmentationInverseImage`: Stacks 0DA8 (1) on
  `(C/U)_total`, full faithfulness of `a^{-1}`.
* `CategoryTheory.SimplicialOver.mem_essImage_augmentationInverseImage_of_isCartesianOnSections`:
  Stacks 0DA8 (1) on `(C/U)_total`, a sheaf whose restrictions along the cross-fibre arrows are
  bijective is in the essential image of `a^{-1}`.

## Implementation notes

The two results are stated for any topology `J` on `C` equal to the one generated by the
pretopology `P`, the hypercovering conditions being conditions on covering families of `P`. The
two total sites are identified by the equivalence
`CategoryTheory.SimplicialOver.associatedTotalEquivalence`, under which the two augmentations
correspond (`CategoryTheory.SimplicialOver.augmentationInverseImageIsoAssociated`). A cross-fibre
arrow of `(C/K)_total` goes to an arrow of `(C/U)_total` whose fibre component is an isomorphism,
and restriction along such an arrow is the restriction along a cross-fibre arrow followed by an
isomorphism.

## References

* [Stacks Project, Tag 0DA8](https://stacks.math.columbia.edu/tag/0DA8)
* [Stacks Project, Section 09X8](https://stacks.math.columbia.edu/tag/09X8)
* [Stacks Project, Tag 09WF](https://stacks.math.columbia.edu/tag/09WF)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite Simplicial
  Stacks.CategoryTheory.Hypercovering

universe u

namespace CategoryTheory


namespace Grothendieck

/-- The functor induced on Grothendieck constructions by a natural transformation sends an arrow
with invertible fibre component to an arrow with invertible fibre component. -/
theorem isIso_fiber_map_map {E : Type*} [Category E] {F G : E ⥤ Cat} (α : F ⟶ G)
    {x y : Grothendieck F} (f : x ⟶ y) (hf : IsIso f.fiber) :
    IsIso ((Grothendieck.map α).map f).fiber := by
  change IsIso ((eqToHom (α.naturality f.base).symm).toNatTrans.app x.fiber ≫
    (α.app y.base).toFunctor.map f.fiber)
  rw [Cat.eqToHom_app]
  exact IsIso.comp_isIso' inferInstance (Functor.map_isIso _ f.fiber)

end Grothendieck

namespace CocontinuousSimplicialSite

open SimplicialSiteSituation

/-- **Stacks 09WF read on sections, in case (B), the converse direction.** If the transition
functor of a simplex map is continuous as well as cocontinuous, and restriction of a total-site
sheaf along every cross-fibre arrow of that simplex map is bijective, then the transition between
the restrictions of the sheaf is invertible. -/
theorem isIso_fiberTransition_of_isIso_map_ιNatTrans (D : CocontinuousSimplicialSite.{u})
    {m n : SimplexCategory} (φ : m ⟶ n)
    [((D.underlying.map φ.op).toFunctor).IsContinuous
      ((⟨Sum.inr D⟩ : SimplicialSiteSituation.{u}).componentTopology n)
      ((⟨Sum.inr D⟩ : SimplicialSiteSituation.{u}).componentTopology m)]
    (F : Sheaf (⟨Sum.inr D⟩ : SimplicialSiteSituation.{u}).totalTopology (Type u))
    (hF : ∀ U : D.underlying.obj (op n),
      IsIso (F.obj.map ((Grothendieck.ιNatTrans (F := D.underlying) φ.op).app U).op)) :
    IsIso ((fiberTransition (⟨Sum.inr D⟩ : SimplicialSiteSituation.{u}) φ).app F) := by
  have : ((D.underlying.map φ.op).toFunctor).IsCocontinuous
      ((⟨Sum.inr D⟩ : SimplicialSiteSituation.{u}).componentTopology n)
      ((⟨Sum.inr D⟩ : SimplicialSiteSituation.{u}).componentTopology m) := D.isCocontinuous φ.op
  set adj₂ := ((D.underlying.map φ.op).toFunctor).sheafAdjunctionCocontinuous (Type u)
    ((⟨Sum.inr D⟩ : SimplicialSiteSituation.{u}).componentTopology n)
    ((⟨Sum.inr D⟩ : SimplicialSiteSituation.{u}).componentTopology m)
  have h₄ : ((adj₂.homEquiv _ _).symm
        ((restrictTransition (⟨Sum.inr D⟩ : SimplicialSiteSituation.{u}) φ).app F)).hom =
      ((((D.underlying.map φ.op).toFunctor).op.ranAdjunction (Type u)).homEquiv _ _).symm
        ((restrictTransition (⟨Sum.inr D⟩ : SimplicialSiteSituation.{u}) φ).app F).hom := by
    refine (Equiv.eq_symm_apply _).2 ?_
    refine (Functor.sheafAdjunctionCocontinuous_homEquiv_apply_hom _ _ _ _ _).symm.trans ?_
    exact Sheaf.hom_ext_iff.1 ((adj₂.homEquiv _ _).apply_symm_apply _)
  have : ∀ U, IsIso (((adj₂.homEquiv _ _).symm
      ((restrictTransition (⟨Sum.inr D⟩ : SimplicialSiteSituation.{u}) φ).app F)).hom.app U) := by
    rintro ⟨U⟩
    rw [congrArg (fun z ↦ z.app (op U)) h₄, restrictTransition_inr_app D φ F U]
    exact hF U
  have : IsIso ((adj₂.homEquiv _ _).symm
      ((restrictTransition (⟨Sum.inr D⟩ : SimplicialSiteSituation.{u}) φ).app F)).hom :=
    NatIso.isIso_of_isIso_app _
  have : IsIso ((sheafToPresheaf _ _).map ((adj₂.homEquiv _ _).symm
      ((restrictTransition (⟨Sum.inr D⟩ : SimplicialSiteSituation.{u}) φ).app F))) :=
    inferInstanceAs (IsIso ((adj₂.homEquiv _ _).symm
      ((restrictTransition (⟨Sum.inr D⟩ : SimplicialSiteSituation.{u}) φ).app F)).hom)
  have : IsIso ((adj₂.homEquiv _ _).symm
      ((restrictTransition (⟨Sum.inr D⟩ : SimplicialSiteSituation.{u}) φ).app F)) :=
    isIso_of_reflects_iso _ (sheafToPresheaf _ _)
  exact (Adjunction.isIso_homEquiv_symm_iff
    ((⟨Sum.inr D⟩ : SimplicialSiteSituation.{u}).transitionMorphism φ).adj adj₂ _).2 this

end CocontinuousSimplicialSite

namespace SimplicialSemiRepresentable

open SemiRepresentable SimplicialSiteSituation

variable {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)
  (K : SimplicialObject (FormalCoproduct.{u} C)) [J.toCoverage.HasPullbacks]

/-- **Cartesianness, read on sections, the converse direction.** A sheaf on the total site whose
restrictions along all cross-fibre arrows of the total category are bijective is cartesian. -/
theorem isCartesianSheaf_of_isIso_map_ιNatTrans
    (F : Sheaf (situation J K).totalTopology (Type u))
    (hF : ∀ ⦃m n : SimplexCategory⦄ (φ : m ⟶ n) (U : ComponentOver (K.obj (op n))),
      IsIso (F.obj.map ((Grothendieck.ιNatTrans (F := slices K) φ.op).app U).op)) :
    (situation J K).IsCartesianSheaf F := fun _ _ φ ↦ by
  have : (((simplicialSite J K).underlying.map φ.op).toFunctor).IsContinuous
      ((⟨Sum.inr (simplicialSite J K)⟩ : SimplicialSiteSituation.{u}).componentTopology _)
      ((⟨Sum.inr (simplicialSite J K)⟩ : SimplicialSiteSituation.{u}).componentTopology _) :=
    componentOverMap_isContinuous' J K φ
  exact CocontinuousSimplicialSite.isIso_fiberTransition_of_isIso_map_ιNatTrans
    (simplicialSite J K) φ F (hF φ)

end SimplicialSemiRepresentable

namespace SimplicialOver

variable {C : Type u} [SmallCategory C] [HasPullbacks C] {X : C} (U : SimplicialObject C)
  (a : U ⟶ (SimplicialObject.const C).obj X)

/-- Restriction along the cross-fibre arrows of `(C/U)_total` is bijective: the condition on a
sheaf on `(C/U)_total` which makes it cartesian. -/
def IsCartesianOnSections {J : GrothendieckTopology C}
    (F : Sheaf (SimplicialOver.totalTopology J U) (Type u)) : Prop :=
  ∀ ⦃m n : SimplexCategory⦄ (φ : m ⟶ n) (V : Over (U.obj (op n))),
    IsIso (F.obj.map ((Grothendieck.ιNatTrans (F := slices U) φ.op).app V).op)

omit [HasPullbacks C] in
variable {U} in
/-- For a sheaf on `(C/U)_total` whose restrictions along the cross-fibre arrows are bijective,
restriction along every arrow with invertible fibre component is bijective. -/
theorem IsCartesianOnSections.isIso_map {J : GrothendieckTopology C}
    {F : Sheaf (SimplicialOver.totalTopology J U) (Type u)} (hF : IsCartesianOnSections U F)
    {x y : Grothendieck (slices U)} (g : x ⟶ y) (hg : IsIso g.fiber) :
    IsIso (F.obj.map g.op) := by
  have key : F.obj.map g.op =
      F.obj.map ((Grothendieck.ι (slices U) y.base).map g.fiber).op ≫
        F.obj.map ((Grothendieck.ιNatTrans (F := slices U) g.base).app x.fiber).op :=
    (congrArg (fun z ↦ F.obj.map (Quiver.Hom.op z))
      (Grothendieck.ιNatTrans_app_comp_ι_map g.base g.fiber).symm).trans (F.obj.map_comp _ _)
  rw [key]
  exact IsIso.comp_isIso' (Functor.map_isIso F.obj _) (hF g.base.unop x.fiber)

/-- **Stacks 0DA8 (1) on `(C/U)_total`, full faithfulness.** For a hypercovering `a : U ⟶ X` of
`X` in `C`, the inverse image `a^{-1} : Sh(C/X) ⥤ Sh((C/U)_total)` along the augmentation given
by `V/U_n ↦ V/X` is fully faithful. -/
def fullyFaithfulAugmentationInverseImage (P : Pretopology C)
    (h : IsHypercoveringAugmentation P U a) {J : GrothendieckTopology C}
    (hJ : P.toGrothendieck = J) :
    (augmentationMorphismOfTopoi J U a).inverseImage.FullyFaithful := by
  subst hJ
  exact ((SimplicialSemiRepresentable.fullyFaithfulInverseImageAugmented' P U a h).comp
      (associatedTotalSheafEquivalence U a P.toGrothendieck).fullyFaithfulFunctor).ofIso
    (augmentationInverseImageIsoAssociated U a P.toGrothendieck).symm

/-- **Stacks 0DA8 (1) on `(C/U)_total`, the essential image.** For a hypercovering `a : U ⟶ X`
of `X` in `C`, a sheaf of sets on `(C/U)_total` whose restrictions along the cross-fibre arrows
`(n, V/U_n) ⟶ (m, V/U_m)` are bijective lies in the essential image of `a^{-1}`. -/
theorem mem_essImage_augmentationInverseImage_of_isCartesianOnSections (P : Pretopology C)
    (h : IsHypercoveringAugmentation P U a) {J : GrothendieckTopology C}
    (hJ : P.toGrothendieck = J) (F : Sheaf (SimplicialOver.totalTopology J U) (Type u))
    (hF : IsCartesianOnSections U F) :
    (augmentationMorphismOfTopoi J U a).inverseImage.essImage F := by
  subst hJ
  let E := associatedTotalSheafEquivalence U a P.toGrothendieck
  have hsr : (SimplicialSemiRepresentable.situation (P.toGrothendieck.over X)
      (associatedSimplicialObject.{u} U a)).IsCartesianSheaf (E.inverse.obj F) := by
    refine SimplicialSemiRepresentable.isCartesianSheaf_of_isIso_map_ιNatTrans
      (P.toGrothendieck.over X) (associatedSimplicialObject.{u} U a) _ fun m n φ V ↦ ?_
    have e : (E.inverse.obj F).obj.map ((Grothendieck.ιNatTrans φ.op).app V).op =
        F.obj.map ((fromAssociatedTotal U a).map ((Grothendieck.ιNatTrans φ.op).app V)).op :=
      rfl
    rw [e]
    exact hF.isIso_map _ (Grothendieck.isIso_fiber_map_map _ _ (Iso.refl _).isIso_hom)
  obtain ⟨H, ⟨e⟩⟩ :=
    (SimplicialSemiRepresentable.mem_essImage_iff_isCartesianSheaf_augmented' P U a h _).2 hsr
  exact ⟨H, ⟨(augmentationInverseImageIsoAssociated U a P.toGrothendieck).app H ≪≫
    E.functor.mapIso e ≪≫ E.counitIso.app F⟩⟩

end SimplicialOver

end CategoryTheory

end
