module

public import StacksFrontier.CategoryTheory.Sites.Simplicial.PointSimplicialModules
public import StacksFrontier.CategoryTheory.Sites.Simplicial.PointSimplicialTransitionFlat
public import StacksFrontier.CategoryTheory.Sites.Simplicial.RatioCosimplicialRing

/-!
# Stacks 0D7K is false as written

Stacks 0D7K asserts that the cartesian `O`-modules form an abelian category as soon as `f_{δ¹₁}`
and `f_{δ¹₀}` are flat. This file shows that this fails. On the constant simplicial site on the
point, let `O` be the cosimplicial ring of unit ratios
`Rₙ = ℤ[xᵢ, wᵢⱼ^{±1} (i ≤ j)]/(xᵢ = wᵢⱼxⱼ, wᵢᵢ = 1)` of
`CategoryTheory.RatioCosimplicialRing`. Both degree-one faces `R₀ ⟶ R₁` are flat, but in `R₂` the
nonzero element `w₀₂ - w₀₁w₁₂` kills `x₀`. As a consequence the quotient map `𝒪 ⟶ 𝒪 ⧸ (x₀)` is a
monomorphism and an epimorphism of cartesian modules which is not an isomorphism, so no abelian
structure exists on the cartesian modules.

## Main results

* `CategoryTheory.PointSimplicialSite.RatioCounterexample.isEmpty_abelian_cart`: the cartesian
  modules of the example carry no abelian structure.
* `CategoryTheory.PointSimplicialSite.RatioCounterexample.exists_not_abelian_cartesianModuleSheaf`:
  Stacks 0D7K, the counterexample.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite
open scoped Simplicial

universe u

namespace CategoryTheory.PointSimplicialSite.RatioCounterexample

open RatioCosimplicialRing

noncomputable section

/-- The cosimplicial ring of unit ratios. -/
abbrev A : SimplexCategory ⥤ CommRingCat.{u} := ratioRing.{u}

/-- The vertex `x₀` in degree `n`. -/
abbrev xz (n : SimplexCategory) : A.{u}.obj n := mk (gx 0)

/-- The ring map of `φ : m ⟶ n` sends the vertex `x₀` to the vertex `x_{φ(0)}`. -/
theorem map_xz {m n : SimplexCategory} (φ : m ⟶ n) :
    (A.{u}.map φ).hom (xz m) = mk (gx (φ.toOrderHom 0)) := ratioRing_map_mk φ _

/-- In degree `n`, `x₀ = w₀ᵢ xᵢ` for every vertex `i`. -/
theorem xz_eq {n : SimplexCategory} (i : Fin (n.len + 1)) :
    xz.{u} n = mk (gw 0 i (Fin.zero_le i)) * mk (gx i) := mk_x_eq _ 0 i _

/-- The ideal generated by the vertices. -/
def Jt (n : SimplexCategory) : Ideal (A.{u}.obj n) := Ideal.span {xz n}

/-- In degree `n`, `xᵢ = w₀ᵢ⁻¹ x₀` for every vertex `i`. -/
theorem x_eq_v_mul (n : ℕ) (i : Fin (n + 1)) :
    mk.{u} (gx i) = mk (gv 0 i (Fin.zero_le i)) * mk (gx 0) := by
  rw [mk_x_eq n 0 i (Fin.zero_le i), ← mul_assoc, mul_comm (mk (gv _ _ _)), mk_w_mul_v, one_mul]

/-- The ring maps of the cosimplicial ring carry the ideals `(x₀)` into each other. -/
theorem Jt_comap {m n : SimplexCategory} (φ : m ⟶ n) : Jt.{u} m ≤ (Jt n).comap (A.map φ).hom := by
  rw [Jt, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Ideal.mem_comap, map_xz]
  exact Ideal.mem_span_singleton'.2 ⟨mk (gv 0 (φ.toOrderHom 0) (Fin.zero_le _)),
    (x_eq_v_mul n.len (φ.toOrderHom 0)).symm⟩

/-- The ideal `(x₀)` in degree `n` is contained in the extension of the ideal `(x₀)` of degree `m`
along any `φ : m ⟶ n`. -/
theorem Jt_map {m n : SimplexCategory} (φ : m ⟶ n) : Jt.{u} n ≤ (Jt m).map (A.map φ).hom := by
  rw [Jt, Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, xz_eq (φ.toOrderHom 0)]
  have h : (A.{u}.map φ).hom (xz m) ∈ (Jt m).map (A.map φ).hom :=
    Ideal.mem_map_of_mem _ (Ideal.subset_span rfl)
  rw [map_xz] at h
  exact Ideal.mul_mem_left _ _ h

/-- The zero ideals. -/
abbrev Jb (n : SimplexCategory) : Ideal (A.{u}.obj n) := ⊥

/-- The ring maps of the cosimplicial ring carry the zero ideals into each other. -/
theorem Jb_comap {m n : SimplexCategory} (φ : m ⟶ n) : Jb.{u} m ≤ (Jb n).comap (A.map φ).hom :=
  bot_le

/-- The zero ideal in degree `n` is contained in the extension of the zero ideal of degree `m`
along any `φ : m ⟶ n`. -/
theorem Jb_map {m n : SimplexCategory} (φ : m ⟶ n) : Jb.{u} n ≤ (Jb m).map (A.map φ).hom :=
  bot_le

/-- The structure sheaf, as the quotient module by the zero ideals. -/
abbrev OO : SheafOfModules.{u} (situation.{u}.totalRingSheaf (ringSheaf A.{u})) :=
  quotModule A Jb Jb_comap

/-- The quotient by the ideal of the vertices. -/
abbrev QQ : SheafOfModules.{u} (situation.{u}.totalRingSheaf (ringSheaf A.{u})) :=
  quotModule A Jt Jt_comap

/-- The quotient map `𝒪 ⟶ 𝒪 ⧸ (x₀)`. -/
abbrev ππ : OO.{u} ⟶ QQ.{u} := quotMap A Jb_comap Jt_comap (fun _ => bot_le)

/-- The structure sheaf `𝒪` is a cartesian module. -/
theorem OO_isCartesian : situation.{u}.IsCartesianModule (ringSheaf A) OO.{u} :=
  quotModule_isCartesian A Jb Jb_comap Jb_map

/-- The quotient `𝒪 ⧸ (x₀)` is a cartesian module. -/
theorem QQ_isCartesian : situation.{u}.IsCartesianModule (ringSheaf A) QQ.{u} :=
  quotModule_isCartesian A Jt Jt_comap Jt_map

/-! ### Sections of the structure sheaf -/

/-- An element of the ring in degree `n`, as a section of `𝒪` over the object of degree `n`. -/
abbrev oo {n : SimplexCategory} (a : A.{u}.obj n) : OO.{u}.val.obj (op (tot n)) :=
  Ideal.Quotient.mk (Jb n) a

/-- Every section of `𝒪` over the object of degree `n` is the class of a ring element. -/
theorem oo_surjective {n : SimplexCategory} (q : OO.{u}.val.obj (op (tot n))) :
    ∃ a : A.{u}.obj n, oo a = q :=
  Ideal.Quotient.mk_surjective (show A.{u}.obj n ⧸ Jb n from q)

/-- The section of `𝒪` attached to a ring element determines that element. -/
theorem oo_injective {n : SimplexCategory} {a b : A.{u}.obj n} (h : oo a = oo b) : a = b :=
  sub_eq_zero.1 (Ideal.mem_bot.1 (Ideal.Quotient.eq.1 h))

/-- The module structure of the degree-`n` component of `𝒪` is multiplication in the ring of
degree `n`. -/
theorem smul_oo {n : SimplexCategory} (r a : A.{u}.obj n) :
    (toSec r • (show (situation.{u}.componentModule (ringSheaf A) OO n).val.obj (op pt) from
      oo a) : (situation.{u}.componentModule (ringSheaf A) OO n).val.obj (op pt)) = oo (r * a) :=
  rfl

/-- Restriction of `𝒪` along the morphism of degree `φ` sends the class of `a` to the class of
its image under the ring map of `φ`. -/
theorem map_oo {m n : SimplexCategory} (φ : m ⟶ n) (a : A.{u}.obj m) :
    OO.{u}.val.map (totHom φ).op (oo a) = oo ((A.map φ).hom a) := rfl

/-- Multiplication by an element of the ring, on the degree-`n` component of `𝒪`. -/
def mulHom {n : SimplexCategory} (r : A.{u}.obj n) :
    situation.{u}.componentModule (ringSheaf A) OO n ⟶
      situation.{u}.componentModule (ringSheaf A) OO n :=
  compHomMk
    { toFun := fun q => toSec r • q
      map_add' := fun q q' => smul_add _ q q'
      map_smul' := fun c q => by
        obtain ⟨a, rfl⟩ := oo_surjective q
        let c' : A.{u}.obj n := c
        change oo (r * (c' * a)) = oo (c' * (r * a))
        rw [mul_left_comm] }

/-- Multiplication by `r` sends the class of `a` to the class of `r * a`. -/
theorem mulHom_apply {n : SimplexCategory} (r a : A.{u}.obj n) :
    (mulHom r).val.app (op pt) (oo a) = oo (r * a) := rfl

/-! ### The key step -/

section Key

variable {X : SheafOfModules.{u} (situation.{u}.totalRingSheaf (ringSheaf A.{u}))}
  (hX : situation.{u}.IsCartesianModule (ringSheaf A) X) (g : X ⟶ OO.{u})

/-- Naturality of `g` along the morphism of degree `φ`, on sections. -/
theorem g_nat {m n : SimplexCategory} (φ : m ⟶ n) (y : X.val.obj (op (tot m))) :
    g.val.app (op (tot n)) (X.val.map (totHom φ).op y) =
      OO.{u}.val.map (totHom φ).op (g.val.app (op (tot m)) y) :=
  PresheafOfModules.naturality_apply g.val _ y

/-- Transport along `φ` sends the restriction of `y` to the class of the image of `a`, if `q y` is
the class of `a`. -/
private theorem transportHom_apply_oo {m n : SimplexCategory} (φ : m ⟶ n)
    (q : situation.{u}.componentModule (ringSheaf A) X m ⟶
      situation.{u}.componentModule (ringSheaf A) OO m)
    (y : X.val.obj (op (tot m))) {a : A.{u}.obj m} (ha : oo a = q.val.app (op pt) y) :
    (transportHom hX OO φ q).val.app (op pt) (X.val.map (totHom φ).op y) =
      oo ((A.map φ).hom a) := by
  rw [transportHom_apply, ← ha]
  rfl

/-- The restriction of `g` to degree `n` is the transport of `p` followed by multiplication by
the `k`-th power of the vertex, when `g = x₀ᵏ p` in degree zero. -/
theorem componentModuleMap_eq (k : ℕ)
    (p : situation.{u}.componentModule (ringSheaf A) X ⦋0⦌ ⟶
      situation.{u}.componentModule (ringSheaf A) OO ⦋0⦌)
    (hp : ∀ y, g.val.app (op (tot ⦋0⦌)) y = toSec (xz ⦋0⦌ ^ k) • p.val.app (op pt) y)
    {n : SimplexCategory} (v : ⦋0⦌ ⟶ n) :
    situation.{u}.componentModuleMap (ringSheaf A) g n =
      transportHom hX OO v p ≫ mulHom ((A.map v).hom (xz ⦋0⦌) ^ k) := by
  apply comp_hom_ext_of_isCartesian hX v
  intro y
  obtain ⟨a, ha⟩ := oo_surjective (p.val.app (op pt) y)
  have h1 : g.val.app (op (tot n)) (X.val.map (totHom v).op y) =
      oo ((A.map v).hom (xz ⦋0⦌ ^ k * a)) := by
    rw [g_nat g, hp, ← ha]; rfl
  have h2 := transportHom_apply_oo hX v p y ha
  refine h1.trans ?_
  change _ = (mulHom _).val.app (op pt)
    ((transportHom hX OO v p).val.app (op pt) (X.val.map (totHom v).op y))
  rw [h2, mulHom_apply, map_mul, map_pow]
  rfl

omit hX g in
/-- In `R₁`, if `x₀ᵏ a = x₁ᵏ b` then `b = w₀₁ᵏ a`. -/
theorem ring_step (k : ℕ) (a b : Ring.{u} 1)
    (e : mk (gx 0) ^ k * a = mk (gx 1) ^ k * b) : b = mk (gw 0 1 (by decide)) ^ k * a := by
  have hx : (mk (gx 0) : Ring.{u} 1) = mk (gw 0 1 (by decide)) * mk (gx 1) := mk_x_eq 1 0 1 _
  have h0 : (mk (gx 1) : Ring.{u} 1) ^ k * (b - mk (gw 0 1 (by decide)) ^ k * a) = 0 := by
    rw [hx, mul_pow] at e
    linear_combination -e
  exact sub_eq_zero.1 (x₁_pow_mul_eq_zero h0)

/-- The unit `w₀₁` in degree one. -/
abbrev ww : A.{u}.obj ⦋1⦌ := mk (gw 0 1 (by decide))

/-- The face `δ¹₁ : ⦋0⦌ ⟶ ⦋1⦌` sends `x₀` to `x₀`. -/
theorem map_δ_one_xz : (A.{u}.map (SimplexCategory.δ (1 : Fin 2))).hom (xz ⦋0⦌) =
    (mk (gx 0) : A.{u}.obj ⦋1⦌) := map_xz _

/-- The face `δ¹₀ : ⦋0⦌ ⟶ ⦋1⦌` sends `x₀` to `x₁`. -/
theorem map_δ_zero_xz : (A.{u}.map (SimplexCategory.δ (0 : Fin 2))).hom (xz ⦋0⦌) =
    (mk (gx 1) : A.{u}.obj ⦋1⦌) := map_xz _

/-- When `g = x₀ᵏ p` in degree zero, the transport of `p` along the target vertex of `⦋1⦌` is
`w₀₁ᵏ` times its transport along the source vertex. -/
theorem transport_one (k : ℕ)
    (p : situation.{u}.componentModule (ringSheaf A) X ⦋0⦌ ⟶
      situation.{u}.componentModule (ringSheaf A) OO ⦋0⦌)
    (hp : ∀ y, g.val.app (op (tot ⦋0⦌)) y = toSec (xz ⦋0⦌ ^ k) • p.val.app (op pt) y)
    (z : (situation.{u}.componentModule (ringSheaf A) X ⦋1⦌).val.obj (op pt)) :
    (transportHom hX OO (SimplexCategory.δ (0 : Fin 2)) p).val.app (op pt) z =
      (mulHom (ww ^ k)).val.app (op pt)
        ((transportHom hX OO (SimplexCategory.δ (1 : Fin 2)) p).val.app (op pt) z) := by
  have e := congrArg (fun f => f.val.app (op pt) z)
    ((componentModuleMap_eq hX g k p hp (SimplexCategory.δ (1 : Fin 2))).symm.trans
      (componentModuleMap_eq hX g k p hp (SimplexCategory.δ (0 : Fin 2))))
  obtain ⟨a, ha⟩ := oo_surjective
    ((transportHom hX OO (SimplexCategory.δ (1 : Fin 2)) p).val.app (op pt) z)
  obtain ⟨b, hb⟩ := oo_surjective
    ((transportHom hX OO (SimplexCategory.δ (0 : Fin 2)) p).val.app (op pt) z)
  change (mulHom _).val.app (op pt) ((transportHom hX OO _ p).val.app (op pt) z) =
    (mulHom _).val.app (op pt) ((transportHom hX OO _ p).val.app (op pt) z) at e
  rw [← ha, ← hb, mulHom_apply, mulHom_apply, map_δ_one_xz, map_δ_zero_xz] at e
  rw [← ha, ← hb, mulHom_apply]
  congr 1
  exact ring_step k a b (oo_injective e)

omit g in
/-- Transport commutes with multiplication by a ring element. -/
theorem transport_mul {m n : SimplexCategory} (φ : m ⟶ n)
    (q : situation.{u}.componentModule (ringSheaf A) X m ⟶
      situation.{u}.componentModule (ringSheaf A) OO m) (r : A.{u}.obj m) :
    transportHom hX OO φ (q ≫ mulHom r) = transportHom hX OO φ q ≫ mulHom ((A.map φ).hom r) := by
  apply comp_hom_ext_of_isCartesian hX φ
  intro y
  obtain ⟨a, ha⟩ := oo_surjective (q.val.app (op pt) y)
  refine (transportHom_apply hX OO φ _ y).trans ?_
  change OO.{u}.val.map (totHom φ).op ((mulHom r).val.app (op pt) (q.val.app (op pt) y)) =
    (mulHom _).val.app (op pt)
      ((transportHom hX OO φ q).val.app (op pt) (X.val.map (totHom φ).op y))
  rw [transportHom_apply_oo hX φ q y ha, ← ha, mulHom_apply, map_oo]
  change oo ((A.map φ).hom (r * a)) = oo ((A.map φ).hom r * (A.map φ).hom a)
  rw [map_mul]

/-- When `g = x₀ᵏ p` in degree zero, the transport of `p` along `δ¹₀ ≫ δ²ᵢ` is its transport
along `δ¹₁ ≫ δ²ᵢ` followed by multiplication by `δ²ᵢ(w₀₁)ᵏ`. -/
theorem transport_face (k : ℕ)
    (p : situation.{u}.componentModule (ringSheaf A) X ⦋0⦌ ⟶
      situation.{u}.componentModule (ringSheaf A) OO ⦋0⦌)
    (hp : ∀ y, g.val.app (op (tot ⦋0⦌)) y = toSec (xz ⦋0⦌ ^ k) • p.val.app (op pt) y)
    (i : Fin 3) :
    transportHom hX OO (SimplexCategory.δ (0 : Fin 2) ≫ SimplexCategory.δ i) p =
      transportHom hX OO (SimplexCategory.δ (1 : Fin 2) ≫ SimplexCategory.δ i) p ≫
        mulHom ((A.map (SimplexCategory.δ i)).hom ww ^ k) := by
  have hD : transportHom hX OO (SimplexCategory.δ (0 : Fin 2)) p =
      transportHom hX OO (SimplexCategory.δ (1 : Fin 2)) p ≫ mulHom (ww ^ k) :=
    comp_hom_ext (transport_one hX g k p hp)
  rw [transportHom_comp, transportHom_comp, hD, transport_mul, map_pow]

omit hX g in
/-- The class of the generator `w_{ij}` depends only on the indices `i` and `j`. -/
theorem mk_gw_congr {n : ℕ} {i j i' j' : Fin (n + 1)} (h : i ≤ j) (hi : i = i') (hj : j = j') :
    mk.{u} (gw i j h) = mk (gw i' j' (hi ▸ hj ▸ h)) := by
  subst hi hj; rfl

omit hX g in
/-- The face `δ²ᵢ : ⦋1⦌ ⟶ ⦋2⦌` sends `w₀₁` to `w_{δ²ᵢ(0) δ²ᵢ(1)}`. -/
theorem map_ww (i : Fin 3) : (A.{u}.map (SimplexCategory.δ i)).hom ww =
    mk (gw ((SimplexCategory.δ i).toOrderHom 0) ((SimplexCategory.δ i).toOrderHom 1)
      ((SimplexCategory.δ i).toOrderHom.monotone (by decide))) :=
  ratioRing_map_mk _ _

omit hX g in
/-- If `k ≠ 0` and the image `b'` in `R₂` of `b ∈ R₀` satisfies `w₀₂ᵏ b' = w₁₂ᵏ w₀₁ᵏ b'`, then `b`
vanishes at `x₀ = 0`. -/
theorem ring_step2 (k : ℕ) (hk : k ≠ 0) (f : Fin 1 →o Fin 3) (b : Ring.{u} 0)
    (h : mk (gw 0 2 (by decide)) ^ k * ringMap f b =
      mk (gw 1 2 (by decide)) ^ k * (mk (gw 0 1 (by decide)) ^ k * ringMap f b)) :
    evalZero b = 0 :=
  evalZero_eq_zero_of_mul hk f b (by linear_combination h)

include hX in
/-- If `g = x₀ᵏ p` in degree zero with `k ≥ 1`, then every value of `p` is a multiple of `x₀`. -/
theorem key_dvd (k : ℕ) (hk : k ≠ 0)
    (p : situation.{u}.componentModule (ringSheaf A) X ⦋0⦌ ⟶
      situation.{u}.componentModule (ringSheaf A) OO ⦋0⦌)
    (hp : ∀ y, g.val.app (op (tot ⦋0⦌)) y = toSec (xz ⦋0⦌ ^ k) • p.val.app (op pt) y)
    (y : X.val.obj (op (tot ⦋0⦌))) :
    ∃ c : A.{u}.obj ⦋0⦌, p.val.app (op pt) y = oo (xz ⦋0⦌ * c) := by
  have R2 := transport_face hX g k p hp 2
  have R0 := transport_face hX g k p hp 0
  have R1 := transport_face hX g k p hp 1
  have v1 : SimplexCategory.δ (1 : Fin 2) ≫ SimplexCategory.δ (0 : Fin 3) =
      SimplexCategory.δ (0 : Fin 2) ≫ SimplexCategory.δ (2 : Fin 3) := by decide
  have v0 : SimplexCategory.δ (1 : Fin 2) ≫ SimplexCategory.δ (1 : Fin 3) =
      SimplexCategory.δ (1 : Fin 2) ≫ SimplexCategory.δ (2 : Fin 3) := by decide
  have v2 : SimplexCategory.δ (0 : Fin 2) ≫ SimplexCategory.δ (1 : Fin 3) =
      SimplexCategory.δ (0 : Fin 2) ≫ SimplexCategory.δ (0 : Fin 3) := by decide
  rw [v1, R2] at R0
  rw [v0, v2] at R1
  have E := R1.symm.trans R0
  obtain ⟨a, ha⟩ := oo_surjective (p.val.app (op pt) y)
  have hz := transportHom_apply_oo hX
    (SimplexCategory.δ (1 : Fin 2) ≫ SimplexCategory.δ (2 : Fin 3)) p y ha
  have E' := congrArg (fun f => f.val.app (op pt)
    (X.val.map (totHom (SimplexCategory.δ (1 : Fin 2) ≫ SimplexCategory.δ (2 : Fin 3))).op y)) E
  change (mulHom _).val.app (op pt) ((transportHom hX OO _ p).val.app (op pt) _) =
    (mulHom _).val.app (op pt) ((mulHom _).val.app (op pt)
      ((transportHom hX OO _ p).val.app (op pt) _)) at E'
  rw [hz, mulHom_apply, mulHom_apply, mulHom_apply, map_ww, map_ww, map_ww] at E'
  obtain ⟨c, hc⟩ := t_dvd_of_evalZero (ring_step2 k hk _ a (oo_injective E'))
  exact ⟨c, by rw [← ha, hc]; rfl⟩

omit hX g in
/-- Division by `x₀` of a morphism into `𝒪` in degree zero all of whose values are multiples of
`x₀`. -/
theorem exists_div (q : situation.{u}.componentModule (ringSheaf A) X ⦋0⦌ ⟶
      situation.{u}.componentModule (ringSheaf A) OO ⦋0⦌)
    (hq : ∀ y, ∃ c : A.{u}.obj ⦋0⦌, q.val.app (op pt) y = oo (xz ⦋0⦌ * c)) :
    ∃ q' : situation.{u}.componentModule (ringSheaf A) X ⦋0⦌ ⟶
        situation.{u}.componentModule (ringSheaf A) OO ⦋0⦌,
      ∀ y, q.val.app (op pt) y = toSec (xz ⦋0⦌) • q'.val.app (op pt) y := by
  choose c hc using hq
  have cancel : ∀ {a b : A.{u}.obj ⦋0⦌}, oo (xz ⦋0⦌ * a) = oo (xz ⦋0⦌ * b) → a = b :=
    fun h => mul_left_cancel₀ (M₀ := Ring.{u} 0) t_ne_zero (oo_injective h)
  refine ⟨compHomMk
    { toFun := fun y => oo (c y)
      map_add' := fun y y' => by
        change oo (c (y + y')) = oo (c y + c y')
        congr 1
        apply cancel
        rw [← hc, mul_add, map_add (q.val.app (op pt)).hom]
        rw [hc, hc]; rfl
      map_smul' := fun r y => by
        let r' : A.{u}.obj ⦋0⦌ := r
        change oo (c (r • y)) = oo (r' * c y)
        congr 1
        apply cancel
        rw [← hc]
        refine ((q.val.app (op pt)).hom.map_smul r y).trans ?_
        rw [hc]
        change oo (r' * (xz ⦋0⦌ * c y)) = oo (xz ⦋0⦌ * (r' * c y))
        rw [mul_left_comm] }, fun y => ?_⟩
  rw [hc]; rfl

include hX in
/-- **A morphism from a cartesian module into `𝒪` which dies in `𝒪 ⧸ (x₀)` is zero.** -/
theorem eq_zero_of_comp_ππ (hg : g ≫ ππ = 0) : g = 0 := by
  have base : ∀ y, ∃ c : A.{u}.obj ⦋0⦌,
      (situation.{u}.componentModuleMap (ringSheaf A) g ⦋0⦌).val.app (op pt) y =
        oo (xz ⦋0⦌ * c) := by
    intro y
    obtain ⟨a, ha⟩ := oo_surjective (g.val.app (op (tot ⦋0⦌)) y)
    have h0 := congrArg (fun f => f.val.app (op (tot ⦋0⦌)) y) hg
    change ππ.val.app (op (tot ⦋0⦌)) (g.val.app (op (tot ⦋0⦌)) y) = 0 at h0
    rw [← ha, quotMap_apply] at h0
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 (Ideal.Quotient.eq_zero_iff_mem.1 h0)
    exact ⟨c, by change g.val.app (op (tot ⦋0⦌)) y = _; rw [← ha, ← hc, mul_comm]⟩
  have step : ∀ k : ℕ, ∃ p : situation.{u}.componentModule (ringSheaf A) X ⦋0⦌ ⟶
      situation.{u}.componentModule (ringSheaf A) OO ⦋0⦌,
      ∀ y, g.val.app (op (tot ⦋0⦌)) y = toSec (xz ⦋0⦌ ^ (k + 1)) • p.val.app (op pt) y := by
    intro k
    induction k with
    | zero =>
      obtain ⟨p, hp⟩ := exists_div _ base
      exact ⟨p, fun y => by rw [zero_add, pow_one]; exact hp y⟩
    | succ k ih =>
      obtain ⟨p, hp⟩ := ih
      obtain ⟨p', hp'⟩ := exists_div p (key_dvd hX g (k + 1) (Nat.succ_ne_zero k) p hp)
      refine ⟨p', fun y => ?_⟩
      obtain ⟨b, hb⟩ := oo_surjective (p'.val.app (op pt) y)
      have e1 : p.val.app (op pt) y = oo (xz ⦋0⦌ * b) := (hp' y).trans (by rw [← hb]; rfl)
      refine (hp y).trans ?_
      rw [e1, ← hb]
      change oo (xz ⦋0⦌ ^ (k + 1) * (xz ⦋0⦌ * b)) = oo (xz ⦋0⦌ ^ (k + 1 + 1) * b)
      rw [← mul_assoc, ← pow_succ]
  have hzero : ∀ y, g.val.app (op (tot ⦋0⦌)) y = 0 := by
    intro y
    obtain ⟨a, ha⟩ := oo_surjective (g.val.app (op (tot ⦋0⦌)) y)
    have hdvd : ∀ k : ℕ, t ^ k ∣ a := by
      intro k
      obtain ⟨p, hp⟩ := step k
      obtain ⟨b, hb⟩ := oo_surjective (p.val.app (op pt) y)
      have e := (ha.trans (hp y)).trans (congrArg _ hb.symm)
      have e' : a = xz ⦋0⦌ ^ (k + 1) * b := oo_injective e
      rw [e']
      exact Dvd.dvd.mul_right (pow_dvd_pow (t.{u}) (Nat.le_succ k)) b
    rw [← ha, eq_zero_of_forall_t_pow_dvd hdvd]
    rfl
  refine tot_hom_ext fun n x => ?_
  have hn : situation.{u}.componentModuleMap (ringSheaf A) g n = 0 := by
    apply comp_hom_ext_of_isCartesian hX (SimplexCategory.const ⦋0⦌ n 0)
    intro y
    change g.val.app (op (tot n)) _ = 0
    rw [g_nat g, hzero, map_zero]
    rfl
  exact congrArg (fun f => f.val.app (op pt) x) hn

end Key

/-! ### The category of cartesian modules is not abelian -/

/-- The cartesian modules of the counterexample. -/
abbrev Cart := situation.{u}.CartesianModuleSheaf (ringSheaf A.{u})

/-- `𝒪`, as a cartesian module. -/
abbrev Oc : Cart.{u} := ⟨OO, OO_isCartesian⟩

/-- `𝒪 ⧸ (x₀)`, as a cartesian module. -/
abbrev Qc : Cart.{u} := ⟨QQ, QQ_isCartesian⟩

/-- The quotient map, as a morphism of cartesian modules. -/
abbrev πc : Oc.{u} ⟶ Qc.{u} := ObjectProperty.homMk ππ

/-- The quotient map `𝒪 ⟶ 𝒪 ⧸ (x₀)` is a monomorphism of cartesian modules. -/
theorem mono_πc : Mono πc.{u} := by
  refine Preadditive.mono_of_cancel_zero _ (fun {Z} g hg => ?_)
  apply ObjectProperty.hom_ext
  exact eq_zero_of_comp_ππ Z.property g.hom (congrArg (fun f => f.hom) hg)

/-- The quotient map `𝒪 ⟶ 𝒪 ⧸ (x₀)` is an epimorphism of cartesian modules. -/
theorem epi_πc : Epi πc.{u} := by
  refine Preadditive.epi_of_cancel_zero _ (fun {Z} h hh => ?_)
  apply ObjectProperty.hom_ext
  have hh' : ππ ≫ h.hom = 0 := congrArg (fun f => f.hom) hh
  refine tot_hom_ext fun n x => ?_
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective (show A.{u}.obj n ⧸ Jt n from x)
  exact congrArg (fun f => f.val.app (op (tot n)) (oo a)) hh'

/-- The quotient map `𝒪 ⟶ 𝒪 ⧸ (x₀)` is not an isomorphism of cartesian modules. -/
theorem not_isIso_πc : ¬ IsIso πc.{u} := by
  intro h
  have h' : IsIso ππ.{u} := (inferInstance : IsIso ((ObjectProperty.ι _).map πc.{u}))
  have e := congrArg (fun f => f.val.app (op (tot ⦋0⦌)) (oo (xz ⦋0⦌))) (IsIso.hom_inv_id ππ.{u})
  change (inv ππ.{u}).val.app (op (tot ⦋0⦌)) (ππ.val.app (op (tot ⦋0⦌)) (oo (xz ⦋0⦌))) =
    oo (xz ⦋0⦌) at e
  have hz : ππ.{u}.val.app (op (tot ⦋0⦌)) (oo (xz ⦋0⦌)) = 0 := by
    rw [quotMap_apply]
    exact Ideal.Quotient.eq_zero_iff_mem.2 (Ideal.subset_span rfl)
  rw [hz, map_zero] at e
  exact t_ne_zero.{u} (oo_injective e.symm)

/-- An abelian structure makes a category balanced, whatever other structure it carries. -/
theorem balanced_of_abelian {C : Type*} [Category C] (h : Abelian C) : Balanced C := by
  let := h
  infer_instance

/-- **The cartesian modules of the counterexample carry no abelian structure.** -/
theorem isEmpty_abelian_cart : IsEmpty (Abelian Cart.{u}) :=
  ⟨fun inst => by
    have : Balanced Cart.{u} := balanced_of_abelian inst
    have := mono_πc.{u}
    have := epi_πc.{u}
    exact not_isIso_πc (isIso_of_mono_of_epi πc)⟩

/-- The ring map `R₀ ⟶ R₁` of the face `δ¹ᵢ` of the cosimplicial ring of unit ratios is flat. -/
theorem flat_map_δ (i : Fin 2) : (A.{u}.map (SimplexCategory.δ i)).hom.Flat :=
  flat_face i

/-- **Stacks 0D7K: the positive assertion is false as written.** There is a simplicial site
(the constant simplicial site on the point, in case (A) of Stacks 09WE) and a sheaf of rings `O`
on its total site (the cosimplicial ring of unit ratios
`Rₙ = ℤ[xᵢ, wᵢⱼ^{±1} (i ≤ j)]/(xᵢ = wᵢⱼxⱼ, wᵢᵢ = 1)`) such that the morphisms of ringed topoi
`f_{δ¹₁}` and `f_{δ¹₀}` are flat, but the category of cartesian `O`-modules is not abelian, for
any choice of abelian structure: the quotient map `𝒪 ⟶ 𝒪/(x₀)` is a monomorphism and an
epimorphism of cartesian modules, but not an isomorphism. -/
@[stacks 0D7K "the positive assertion is false as written: counterexample with f_{δ¹₁} and \
f_{δ¹₀} flat but the cartesian O-modules not an abelian category (constant simplicial site on \
the point, O the cosimplicial ring of unit ratios); the corrected form is \
CategoryTheory.SimplicialSiteSituation.cartesianModuleSheafAbelian"]
theorem exists_not_abelian_cartesianModuleSheaf :
    ∃ (S : SimplicialSiteSituation.{u}) (O : Sheaf S.totalTopology CommRingCat.{u}),
      (S.transitionRingedToposHom O (SimplexCategory.δ (1 : Fin 2))).IsFlat ∧
      (S.transitionRingedToposHom O (SimplexCategory.δ (0 : Fin 2))).IsFlat ∧
      IsEmpty (Abelian (S.CartesianModuleSheaf O)) :=
  ⟨situation, ringSheaf A, isFlat_transitionRingedToposHom A _ (flat_map_δ 1),
    isFlat_transitionRingedToposHom A _ (flat_map_δ 0), isEmpty_abelian_cart⟩

end

end CategoryTheory.PointSimplicialSite.RatioCounterexample

