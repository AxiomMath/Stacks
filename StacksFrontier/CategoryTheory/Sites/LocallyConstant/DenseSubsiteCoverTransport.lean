module

public import Mathlib.CategoryTheory.Sites.DenseSubsite.Basic
import StacksCore.Tactic.StacksAttribute

/-!
# A locally checkable condition on objects transports across a dense subsite

Let `G : C ⥤ D` be a full functor exhibiting `(C, J)` as a dense subsite of `(D, K)`. Let `T` be
a property of objects of `C` and `T'` a property of objects of `D`, each inherited by every
object lying over one that has it, and let `T` be the restriction of `T'` along `G`. Then every
object of `C` has a covering family whose members satisfy `T` if and only if every object of `D`
has a covering family whose members satisfy `T'`.

This is the combinatorial half of the comparison of the two presentations of a small étale site.
The predicates of Tags 093Q and 03RW — `Stacks.ConstantSheaf.IsFiniteLocallyConstant`,
`Stacks.ConstantSheaf.IsLocallyConstantWith` and
`Stacks.ConstantSheaf.IsFiniteTypeLocallyConstant` — are all of the quantified shape treated
here, with `T V` the condition that the restriction of a fixed sheaf to `C/V` is a constant sheaf
on a value satisfying some condition. Local constancy is thus *not* a condition on the sheaf
category alone: the slice conditions `T` and `T'` have to be matched up separately, which is
the hypothesis `hTT'` below, and the present file supplies everything else.

## Main results

* `Stacks.Sites.exists_cover_iff_ofObjects_mem`: an object has a covering family whose members
  satisfy `T` exactly when the sieve of objects satisfying `T` is a covering sieve.
* `Stacks.Sites.ofObjects_mem_iff_of_isDenseSubsite`: the sieve of objects satisfying `T` covers
  every object of `C` exactly when the sieve of objects satisfying `T'` covers every object
  of `D`.
* `Stacks.Sites.forall_exists_cover_iff_of_isDenseSubsite`: **the transport**, in the quantified
  shape the local-constancy predicates are stated in.

## Implementation notes

A property of objects inherited along arrows cuts out a sieve on each object, and that sieve is
`CategoryTheory.Sieve.ofObjects` of the family of *all* objects satisfying the property, indexed
by the subtype; no new sieve construction is introduced.
`CategoryTheory.Sieve.mem_ofObjects_iff` asks for an arrow from the source to some member of the
family, which inheritance turns into the property of the source itself.

The two sites are taken in the same pair of universes, so that one and the same index type
`Type (max u v)` serves both quantified statements; `CategoryTheory.Sieve.exists_eq_ofArrows`
produces covering families indexed in exactly that type. The two small étale sites of a scheme
`S : Scheme.{u}` — `AlgebraicGeometry.SmallEtale B S hS` and `S.Etale` — both have objects in
`Type (u + 1)` and morphisms in `Type u`, so this is no restriction there.

Fullness of `G` is used once, in the direction that produces a covering family of `C` from one
of `D`: an arrow `G V' ⟶ G V` between images has to be realised as `G` of an arrow `V' ⟶ V` in
order to enter a sieve of `C`. A dense subsite inclusion is only *locally* full in general, and
with local fullness the same proof needs one further refinement; the embeddings of interest here
are full, so the hypothesis is taken outright.

## References

* [Stacks Project, Tag 021E](https://stacks.math.columbia.edu/tag/021E)
* [Stacks Project, Tag 03A0](https://stacks.math.columbia.edu/tag/03A0)
-/

@[expose] public section

open CategoryTheory

namespace Stacks.Sites

universe v u

section Sieve

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  {T : C → Prop} (hT : ∀ {V V' : C}, (V' ⟶ V) → T V → T V')

include hT

/-- **A property inherited along arrows is read on sources.** An arrow belongs to the sieve
generated by the objects satisfying `T` exactly when its own source satisfies `T`. -/
public theorem mem_ofObjects_subtype_iff {U Z : C} (g : Z ⟶ U) :
    Sieve.ofObjects (Subtype.val : {V : C // T V} → C) U g ↔ T Z :=
  ⟨fun ⟨⟨_, hV⟩, ⟨k⟩⟩ ↦ hT k hV, fun h ↦ ⟨⟨Z, h⟩, ⟨𝟙 Z⟩⟩⟩

/-- **A covering family of objects satisfying `T` is the same thing as a covering sieve of
objects satisfying `T`.** The sieve generated by the objects satisfying `T` contains any covering
family of such objects, and conversely it is itself generated by a family of arrows, whose
sources then satisfy `T`. -/
public theorem exists_cover_iff_ofObjects_mem (U : C) :
    (∃ (I : Type (max u v)) (V : I → C) (f : ∀ i, V i ⟶ U),
        Sieve.ofArrows V f ∈ J U ∧ ∀ i, T (V i)) ↔
      Sieve.ofObjects (Subtype.val : {V : C // T V} → C) U ∈ J U := by
  constructor
  · rintro ⟨I, V, f, hcov, hV⟩
    refine J.superset_covering ?_ hcov
    rw [Sieve.generate_le_iff]
    rintro Y a ⟨i⟩
    exact (mem_ofObjects_subtype_iff hT _).2 (hV i)
  · intro h
    obtain ⟨I, V, f, hVf⟩ :=
      Sieve.exists_eq_ofArrows (Sieve.ofObjects (Subtype.val : {V : C // T V} → C) U)
    refine ⟨I, V, f, hVf ▸ h, fun i ↦ (mem_ofObjects_subtype_iff hT (f i)).1 ?_⟩
    rw [hVf]
    exact Sieve.ofArrows_mk V f i

end Sieve

section DenseSubsite

variable {C D : Type u} [Category.{v} C] [Category.{v} D]
  (J : GrothendieckTopology C) (K : GrothendieckTopology D) (G : C ⥤ D)
  [G.Full] [G.IsDenseSubsite J K]
  {T : C → Prop} {T' : D → Prop}
  (hT : ∀ {V V' : C}, (V' ⟶ V) → T V → T V')
  (hT' : ∀ {W W' : D}, (W' ⟶ W) → T' W → T' W')
  (hTT' : ∀ V : C, T V ↔ T' (G.obj V))

include hT hT' hTT'

/-- **A locally checkable condition on objects is covering on a dense subsite exactly when it is
covering on the ambient site.**

From `C` to `D`: an object `W` of `D` is covered by images `G V ⟶ W`, each `V` is covered by its
own `T`-objects, and the image of such a covering, refined along the arrow to `W`, consists of
arrows whose sources lie over an image of a `T`-object and hence satisfy `T'`.

From `D` to `C`: a sieve of `C` is covering exactly when its image generates a covering sieve,
by `CategoryTheory.Functor.IsDenseSubsite.functorPushforward_mem_iff`; the image is covering
because `G V` is covered by the `T'`-objects, each of those is covered by images `G V' ⟶ Z`,
and `V'` then satisfies `T` and maps to `V` by fullness. -/
public theorem ofObjects_mem_iff_of_isDenseSubsite :
    (∀ U : C, Sieve.ofObjects (Subtype.val : {V : C // T V} → C) U ∈ J U) ↔
      (∀ W : D, Sieve.ofObjects (Subtype.val : {W : D // T' W} → D) W ∈ K W) := by
  have _ : G.IsCoverDense K := Functor.IsDenseSubsite.isCoverDense J K G
  constructor
  · intro h W
    refine K.transitive (G.is_cover_of_isCoverDense K W) _ ?_
    rintro Z f ⟨⟨W₀, lift, map, (fac : lift ≫ map = f)⟩⟩
    refine K.superset_covering ?_
      (K.pullback_stable lift ((G.functorPushforward_mem_iff J K).2 (h W₀)))
    rintro Y a ⟨Z', g, k, hg, (_ : a ≫ lift = k ≫ G.map g)⟩
    exact (mem_ofObjects_subtype_iff hT' (a ≫ f)).2
      (hT' k ((hTT' Z').1 ((mem_ofObjects_subtype_iff hT g).1 hg)))
  · intro h U
    rw [← G.functorPushforward_mem_iff J K]
    refine K.transitive (h (G.obj U)) _ ?_
    intro Z f hf
    refine K.superset_covering ?_ (G.is_cover_of_isCoverDense K Z)
    rintro Y a ⟨⟨W₀, lift, map, (fac : lift ≫ map = a)⟩⟩
    obtain ⟨c, hc⟩ := G.map_surjective (map ≫ f)
    refine ⟨W₀, c, lift, (mem_ofObjects_subtype_iff hT c).2
      ((hTT' W₀).2 (hT' map ((mem_ofObjects_subtype_iff hT' f).1 hf))), ?_⟩
    rw [← fac, Category.assoc, hc]

/-- **The transport of a locally checkable condition on objects across a dense subsite.** Every
object of `C` has a covering family of `T`-objects if and only if every object of `D` has a
covering family of `T'`-objects.

Both quantified statements are read as the covering of every object by its sieve of
good objects through `Stacks.Sites.exists_cover_iff_ofObjects_mem`, and those two are compared
by `Stacks.Sites.ofObjects_mem_iff_of_isDenseSubsite`. -/
public theorem forall_exists_cover_iff_of_isDenseSubsite :
    (∀ U : C, ∃ (I : Type (max u v)) (V : I → C) (f : ∀ i, V i ⟶ U),
        Sieve.ofArrows V f ∈ J U ∧ ∀ i, T (V i)) ↔
      (∀ W : D, ∃ (I : Type (max u v)) (V : I → D) (f : ∀ i, V i ⟶ W),
        Sieve.ofArrows V f ∈ K W ∧ ∀ i, T' (V i)) := by
  rw [forall_congr' fun U ↦ exists_cover_iff_ofObjects_mem J hT U,
    forall_congr' fun W ↦ exists_cover_iff_ofObjects_mem K hT' W]
  exact ofObjects_mem_iff_of_isDenseSubsite J K G hT hT' hTT'

end DenseSubsite

end Stacks.Sites

end
