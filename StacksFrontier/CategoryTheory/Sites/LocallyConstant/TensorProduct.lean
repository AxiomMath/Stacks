/-!
# Tensor products of locally constant sheaves of modules

Let `(C, J)` be a site and let `Λ` be a commutative ring. The tensor product of two locally
constant sheaves of `Λ`-modules on `C` is again a locally constant sheaf of `Λ`-modules.

## Main results

* `Stacks.ConstantSheaf.isConstant_tensor`: the tensor product of two constant sheaves is the
  constant sheaf on the tensor product of their values.
* `Stacks.ConstantSheaf.overPullbackMonoidal`: restriction of sheaves to an object of the site is
  a monoidal functor.
* `Stacks.ConstantSheaf.isLocallyConstant_tensor`: the tensor product of two locally constant
  sheaves of `Λ`-modules is locally constant.

## Implementation notes

Sheaves of `Λ`-modules are `ModuleCat Λ`-valued sheaves, and their tensor product is the one of
`CategoryTheory.Sheaf.monoidalCategory`: the monoidal structure obtained by localizing the
objectwise tensor product of presheaves along sheafification, so that `F ⊗ G` is the
sheafification of `U ↦ F(U) ⊗_Λ G(U)`. Mathlib does not make that structure an instance, since on
some value categories it clashes with the cartesian one, so it is activated as a local instance
here.

The module universe is the universe of `Λ`, because `ModuleCat.{w} Λ` is monoidal closed only for
`Λ : Type w`. The single size hypothesis `UnivLE.{max u v, w}` then supplies the enriched homs that
make the class of morphisms inverted by sheafification monoidal, and the pointwise Kan extensions
along `Over.map`, so no further hypothesis on the site is needed; in particular the site is not
assumed to have pullbacks or a final object.

The two sheaves are trivialized over one and the same object by intersecting the two sieves
generated by their trivializing families, rather than by forming fibre products of their members:
the intersection of two covering sieves is covering, and every member of a family generating it
factors through a member of each of the two given families, which is all that the invariance of
a trivialization under refinement needs. That invariance is reached from
`Stacks.ConstantSheaf.constantSheafOverMapIso`, so it costs pointwise Kan extensions along
`Over.map` rather than pullbacks in the site.

Restriction to an object of the site is monoidal because it lifts, along sheafification, to the
composite of restriction of presheaves with sheafification on the slice site; that composite is
monoidal, and a functor which lifts along a monoidal localization functor to a monoidal functor is
monoidal.

## References

* [Stacks Project, Tag 093V](https://stacks.math.columbia.edu/tag/093V)
* [Stacks Project, Tag 093Q](https://stacks.math.columbia.edu/tag/093Q)
-/

@[expose] public noncomputable section

open CategoryTheory MonoidalCategory

namespace Stacks.ConstantSheaf

universe w v u v' u'

attribute [local instance] Sheaf.monoidalCategory

section Constant

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  (A : Type u') [Category.{v'} A] [MonoidalCategory A]
  [HasWeakSheafify J A] [(J.W (A := A)).IsMonoidal]

/-- **The tensor product of two constant sheaves is constant**, with the tensor product of the two
values as its value. -/
theorem isConstant_tensor (F G : Sheaf J A) [Sheaf.IsConstant J F] [Sheaf.IsConstant J G] :
    Sheaf.IsConstant J (F ⊗ G) := by
  obtain ⟨M, ⟨eF⟩⟩ := F.mem_essImage_of_isConstant
  obtain ⟨N, ⟨eG⟩⟩ := G.mem_essImage_of_isConstant
  refine ⟨M ⊗ N, ⟨?_⟩⟩
  let c : A ⥤ Cᵒᵖ ⥤ A := Functor.const Cᵒᵖ
  let e : c.obj M ⊗ c.obj N ≅ c.obj (M ⊗ N) :=
    NatIso.ofComponents (fun _ => Iso.refl _) (by intros; simp [c])
  exact ((presheafToSheaf J A).mapIso e).symm ≪≫
    (Functor.Monoidal.μIso (presheafToSheaf J A) (c.obj M) (c.obj N)).symm ≪≫ tensorIso eF eG

end Constant

section OverPullback

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  (A : Type u') [Category.{v'} A] [MonoidalCategory A]
  [HasWeakSheafify J A] [(J.W (A := A)).IsMonoidal]
  [∀ U : C, HasWeakSheafify (J.over U) A] [∀ U : C, ((J.over U).W (A := A)).IsMonoidal]
  [∀ (U : C) (P : (Over U)ᵒᵖ ⥤ A), (Over.forget U).op.HasPointwiseRightKanExtension P]

/-- **Restriction of sheaves to an object of the site is a monoidal functor.** -/
@[instance_reducible]
def overPullbackMonoidal (X : C) : (J.overPullback A X).Monoidal :=
  letI H := (Functor.whiskeringLeft _ _ A).obj (Over.forget X).op ⋙
    presheafToSheaf (J.over X) A
  letI : Localization.Lifting (presheafToSheaf J A) (J.W (A := A)) H (J.overPullback A X) :=
    ⟨((Over.forget X).pushforwardContinuousSheafificationCompatibility A (J.over X) J).symm⟩
  Localization.Monoidal.functorMonoidalOfComp (presheafToSheaf J A) (J.W (A := A))
    (J.overPullback A X) H

/-- **The tensor product of two sheaves which become constant over an object of the site becomes
constant over that object.** -/
theorem isConstant_overPullback_tensor {X : C} (F G : Sheaf J A)
    [Sheaf.IsConstant (J.over X) ((J.overPullback A X).obj F)]
    [Sheaf.IsConstant (J.over X) ((J.overPullback A X).obj G)] :
    Sheaf.IsConstant (J.over X) ((J.overPullback A X).obj (F ⊗ G)) :=
  let := overPullbackMonoidal J A X
  have := isConstant_tensor (J.over X) A ((J.overPullback A X).obj F)
    ((J.overPullback A X).obj G)
  Sheaf.isConstant_congr _ (Functor.Monoidal.μIso (J.overPullback A X) F G)

end OverPullback

section Refinement

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  (A : Type u') [Category.{v'} A] [∀ U : C, HasWeakSheafify (J.over U) A]

/-- Restriction along a morphism of the site preserves constant sheaves: it carries the constant
sheaf to the constant sheaf on the same value. -/
private theorem isConstant_overMapPullback_obj {X Y : C} (f : X ⟶ Y)
    [∀ P : (Over X)ᵒᵖ ⥤ A, (Over.map f).op.HasPointwiseRightKanExtension P]
    (G : Sheaf (J.over Y) A) [Sheaf.IsConstant (J.over Y) G] :
    Sheaf.IsConstant (J.over X) ((J.overMapPullback A f).obj G) := by
  obtain ⟨E, ⟨e⟩⟩ := G.mem_essImage_of_isConstant
  exact ⟨E, ⟨constantSheafOverMapIso J A f E ≪≫ (J.overMapPullback A f).mapIso e⟩⟩

/-- **A trivialization survives refinement**: a sheaf which becomes constant after restriction to
`Y` becomes constant after restriction to any `X` lying over `Y`. -/
private theorem isConstant_overPullback_of_overMap {X Y : C} (f : X ⟶ Y)
    [∀ P : (Over X)ᵒᵖ ⥤ A, (Over.map f).op.HasPointwiseRightKanExtension P] (F : Sheaf J A)
    [Sheaf.IsConstant (J.over Y) ((J.overPullback A Y).obj F)] :
    Sheaf.IsConstant (J.over X) ((J.overPullback A X).obj F) :=
  have := isConstant_overMapPullback_obj J A f ((J.overPullback A Y).obj F)
  Sheaf.isConstant_congr _ (F.pushforwardOverMapIso f)

end Refinement

section Module

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  (Λ : Type w) [CommRing Λ] [UnivLE.{max u v, w}]
  [HasWeakSheafify J (ModuleCat.{w} Λ)]
  [∀ U : C, HasWeakSheafify (J.over U) (ModuleCat.{w} Λ)]

/-- The tensor product of two locally constant sheaves of `Λ`-modules on a site is a locally
constant sheaf of `Λ`-modules. -/
@[stacks 093V, sga "5 VI 1.4.5" "locally constant claim"]
theorem isLocallyConstant_tensor (F G : Sheaf J (ModuleCat.{w} Λ))
    [IsLocallyConstant J F] [IsLocallyConstant J G] : IsLocallyConstant J (F ⊗ G) where
  exists_cover U := by
    obtain ⟨I, X, f, hf, hF⟩ := IsLocallyConstant.exists_cover (J := J) (F := F) U
    obtain ⟨I', Y, g, hg, hG⟩ := IsLocallyConstant.exists_cover (J := J) (F := G) U
    obtain ⟨K, Z, p, hp⟩ :=
      (Sieve.ofArrows X f ⊓ Sieve.ofArrows Y g).exists_eq_ofArrows
    refine ⟨K, Z, p, hp ▸ J.intersection_covering hf hg, fun k => ?_⟩
    have hk : (Sieve.ofArrows X f ⊓ Sieve.ofArrows Y g) (p k) := by
      rw [hp]; exact Sieve.ofArrows_mk Z p k
    obtain ⟨i, a, -⟩ := (Sieve.mem_ofArrows_iff X f (p k)).mp hk.1
    obtain ⟨j, b, -⟩ := (Sieve.mem_ofArrows_iff Y g (p k)).mp hk.2
    have := hF i
    have := hG j
    have := isConstant_overPullback_of_overMap J (ModuleCat.{w} Λ) a F
    have := isConstant_overPullback_of_overMap J (ModuleCat.{w} Λ) b G
    exact isConstant_overPullback_tensor J (ModuleCat.{w} Λ) F G

end Module

end Stacks.ConstantSheaf

end
