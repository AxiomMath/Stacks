open CategoryTheory Limits Opposite

namespace CategoryTheory.Sheaf

@[expose] public section

/-- In a filtered colimit of sheaves of types whose transition morphisms are monomorphisms,
every colimit injection is a monomorphism. -/
public theorem mono_colimit_ι_of_mono_transition
    {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
    {I : Type w₁} [Category.{w₂} I] [IsFiltered I]
    [HasColimitsOfShape I (Type (max u v))]
    (F : I ⥤ Sheaf J (Type (max u v)))
    (hmono : ∀ i j (f : i ⟶ j), Mono (F.map f)) (i : I) :
    Mono (colimit.ι F i) := by
  apply (Sheaf.Hom.mono_iff_presheaf_mono J (Type (max u v)) _).2
  apply (NatTrans.mono_iff_mono_app (colimit.ι F i).hom).2
  intro W'
  exact (CategoryTheory.mono_iff_injective _).2
    (Stacks.Sites.FilteredColimitSections.injective_ι_app_of_mono F hmono W'.unop i)

/-- The sheafified Yoneda embedding sends a morphism whose image under a faithful functor is a
monomorphism to a monomorphism of sheaves. -/
public theorem mono_sheafifiedYoneda_map_of_mono_underlying
    {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
    {D : Type*} [Category* D] (T : C ⥤ D) [T.Faithful]
    {A B : C} (f : A ⟶ B) (hf : Mono (T.map f)) :
    Mono ((sheafifiedYoneda J).map f) := by
  have hinj : ∀ X : Cᵒᵖ,
      Function.Injective ((uliftYoneda.{u, v, u}.map f).app X) := by
    intro X x y hxy
    apply ULift.ext
    apply T.map_injective
    apply (cancel_mono (T.map f)).1
    simpa using congrArg (fun z => T.map (ULift.down z)) hxy
  have hloc : Presheaf.IsLocallyInjective J (uliftYoneda.{u, v, u}.map f) :=
    Presheaf.isLocallyInjective_of_injective J _ hinj
  have hloc' : IsLocallyInjective ((sheafifiedYoneda J).map f) := by
    change IsLocallyInjective
      ((presheafToSheaf J (Type (max u v))).map (uliftYoneda.{u, v, u}.map f))
    exact (Presheaf.isLocallyInjective_presheafToSheaf_map_iff J _).2 hloc
  exact mono_of_isLocallyInjective _

end

end CategoryTheory.Sheaf

end MonoTransfer
