module

public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import StacksFrontier.CategoryTheory.Sites.Pretopology.SmallSubsite
public import StacksFrontier.CategoryTheory.Sites.QuasiCompact
import StacksCore.Tactic.StacksAttribute

/-!
# Sites whose covering families are finite

Let `P` be a class of covering families on `C` satisfying the site axioms and presenting a
precoverage `J`, so that the covering sieves of `J` are those generated by a family in `P`.
Every covering sieve is then refined by a family in `P`. If moreover every family in `P` has a
finite index type, every object of `C` is quasi-compact in the sense of Stacks 090H.

## Main results

* `CategoryTheory.exists_covering_le_of_isSite`: a covering sieve contains the presieve of a
  covering family in `P`.
* `CategoryTheory.GrothendieckTopology.isQuasiCompactObject_of_isSite`: when all families in
  `P` are finite, every object is quasi-compact.

## Implementation notes

The class of covering families is a predicate on `Covering C`, an object of `C` bundled with
a `CategoryTheory.PreZeroHypercover` over it, and the site axioms are
`CategoryTheory.IsSite`. The indexing universe is `max u v`, the universe in which
`CategoryTheory.GrothendieckTopology.IsQuasiCompactObject` quantifies over coverings and in
which every covering sieve is generated by a family.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace CategoryTheory

universe v u

variable {C : Type u} [Category.{v} C]

/-- A covering sieve of a precoverage presented by a class of covering families satisfying the
site axioms contains the presieve of such a family. -/
theorem exists_covering_le_of_isSite (P : Covering.{u, v, max u v} C → Prop) (hP : IsSite P)
    (J : Precoverage C)
    (hJ : ∀ (X : C) (R : Presieve X), R ∈ J X ↔
      ∃ E : PreZeroHypercover.{max u v} X, R = E.presieve₀ ∧ P ⟨X, E⟩)
    {X : C} (T : Sieve X) (hT : T ∈ J.toGrothendieck X) :
    ∃ E : PreZeroHypercover.{max u v} X, P ⟨X, E⟩ ∧ E.presieve₀ ≤ T := by
  classical
  induction hT with
  | of X R hR =>
    obtain ⟨E, rfl, hE⟩ := (hJ X R).mp hR
    exact ⟨E, hE, Sieve.le_generate _⟩
  | top X =>
    exact ⟨PreZeroHypercover.singleton (𝟙 X), hP.1 _, le_top⟩
  | pullback X T h Y f ih =>
    obtain ⟨E, hE, hET⟩ := ih
    obtain ⟨V, a, b, hpb, hV⟩ := hP.2.2 ⟨X, E⟩ hE Y f
    refine ⟨⟨E.I₀, V, b⟩, hV, ?_⟩
    rintro Z g ⟨i⟩
    show T (b i ≫ f)
    rw [← (hpb i).w]
    exact T.downward_closed (hET _ _ (Presieve.ofArrows.mk i)) (a i)
  | transitive X T R _ _ ih ihr =>
    obtain ⟨E, hE, hET⟩ := ih
    choose V hV hVR using fun i => ihr (hET _ _ (Presieve.ofArrows.mk i))
    refine ⟨E.bind V, ?_, ?_⟩
    · simpa [PreZeroHypercover.pushforward] using
        hP.2.1 ⟨X, E⟩ hE (fun i => ⟨E.X i, V i⟩) hV (fun _ => rfl)
    · rintro Z g ⟨i⟩
      exact hVR i.1 _ _ (Presieve.ofArrows.mk i.2)

/-- **Stacks 090H.** If every covering family of a class satisfying the site axioms has a
finite index type, then every object of the site it presents is quasi-compact. -/
theorem GrothendieckTopology.isQuasiCompactObject_of_isSite
    (P : Covering.{u, v, max u v} C → Prop) (hP : IsSite P)
    (hfinite : ∀ E, P E → Finite E.2.I₀) (J : Precoverage C)
    (hJ : ∀ (X : C) (R : Presieve X), R ∈ J X ↔
      ∃ E : PreZeroHypercover.{max u v} X, R = E.presieve₀ ∧ P ⟨X, E⟩) (X : C) :
    J.toGrothendieck.IsQuasiCompactObject X := by
  classical
  intro E hE
  obtain ⟨F, hF, hFE⟩ := exists_covering_le_of_isSite P hP J hJ E.sieve₀ hE
  have := hfinite ⟨X, F⟩ hF
  choose j a ha using fun i => (Sieve.mem_ofArrows_iff _ _ _).mp
    (hFE _ _ (Presieve.ofArrows.mk i))
  exact ⟨F, ⟨j, a, fun i => (ha i).symm⟩,
    Precoverage.generate_mem_toGrothendieck ((hJ _ _).mpr ⟨F, rfl, hF⟩),
    Set.finite_range _⟩

end CategoryTheory

end
