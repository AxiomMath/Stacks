module

public import StacksFrontier.CategoryTheory.Sites.QuasiCompact

/-!
# Finitely many members of a covering of a quasi-compact object already cover it

Let `U` be a quasi-compact object of a site `(C, J)` in the sense of Stacks 090H,
`AlgebraicGeometry.RingedSite`-free: every covering family of `U` is refined by one which
factors through finitely many of its members. This file turns that statement into the form in
which it is used, namely that a *finite subfamily* of the given covering family already
generates a covering sieve of `U`.

The passage is immediate: a refinement `𝒱 ⟶ 𝒰` factors each `𝒱.f j` through `𝒰.f (φ.s₀ j)`, so
the sieve generated by the finitely many arrows `𝒰.f i` with `i` in the image of `φ.s₀` contains
the covering sieve of `𝒱`.

## Main results

* `CategoryTheory.GrothendieckTopology.exists_finite_subfamily_sieve_mem_of_isQuasiCompactObject`:
  a finite subset of the index type of a covering family of a quasi-compact object indexes a
  subfamily which still generates a covering sieve.
* `CategoryTheory.GrothendieckTopology.exists_finite_ofArrows_mem_of_isQuasiCompactObject`: the
  same for a covering *presieve*, producing a finite family of arrows of the presieve which
  generates a covering sieve.

## Implementation notes

This is weaker than the notion `StacksProblem.HasFiniteSubcovering` of
`StacksFrontier.CategoryTheory.Sites.QuasiCompact.FiniteRefinements`, which asks the finite
subfamily to be a covering *of the pretopology* rather than merely to generate a covering sieve
of the topology it generates; that stronger statement is false in general, which is what the
counterexample `StacksProblem.exists_finiteRefinement_not_finiteSubcovering` of that file shows.
Generating a covering sieve is what an argument which has to choose one integer per member of a
covering needs, since the choice can then be made over a finite set.

The index type of the presieve form is `{x : Σ Z : C, Z ⟶ U // S x.2}`, the arrows of the
presieve, which lives in `Type (max u v)`; that is the index universe
`CategoryTheory.GrothendieckTopology.IsQuasiCompactObject` quantifies over, so no smallness
hypothesis on the presieve is needed.

## References

* [Stacks Project, Tag 090H](https://stacks.math.columbia.edu/tag/090H)
-/

@[expose] public section

open CategoryTheory Limits

namespace CategoryTheory.GrothendieckTopology

universe v u

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}

/-- **Finitely many members of a covering family of a quasi-compact object already cover it.**
If `U` is quasi-compact and `𝒰` is a covering family of `U`, then some finite subset `T` of the
index type of `𝒰` indexes a subfamily whose generated sieve still covers `U`. -/
theorem exists_finite_subfamily_sieve_mem_of_isQuasiCompactObject {U : C}
    (hU : J.IsQuasiCompactObject U) (𝒰 : PreZeroHypercover.{max u v} U)
    (h𝒰 : 𝒰.sieve₀ ∈ J U) :
    ∃ T : Set 𝒰.I₀, T.Finite ∧
      Sieve.ofArrows (fun i : T => 𝒰.X i.1) (fun i : T => 𝒰.f i.1) ∈ J U := by
  obtain ⟨𝒱, φ, hcov, hfin⟩ := hU 𝒰 h𝒰
  refine ⟨Set.range φ.s₀, hfin, J.superset_covering ?_ hcov⟩
  rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
  intro j
  exact (Sieve.mem_ofArrows_iff _ _ _).2
    ⟨⟨φ.s₀ j, Set.mem_range_self j⟩, φ.h₀ j, (φ.w₀ j).symm⟩

/-- **Finitely many arrows of a covering presieve of a quasi-compact object already cover it.**
If `U` is quasi-compact and the sieve generated by a presieve `S` of `U` covers `U`, then
finitely many arrows of `S` generate a covering sieve of `U`. -/
theorem exists_finite_ofArrows_mem_of_isQuasiCompactObject {U : C}
    (hU : J.IsQuasiCompactObject U) (S : Presieve U) (hS : Sieve.generate S ∈ J U) :
    ∃ (ι : Type (max u v)) (_ : Finite ι) (V : ι → C) (f : ∀ i, V i ⟶ U),
      (∀ i, S (f i)) ∧ Sieve.ofArrows V f ∈ J U := by
  let 𝒰 : PreZeroHypercover.{max u v} U :=
    { I₀ := { x : Σ Z : C, Z ⟶ U // S x.2 }
      X := fun x => x.1.1
      f := fun x => x.1.2 }
  have hpre : Presieve.ofArrows 𝒰.X 𝒰.f = S :=
    le_antisymm (fun _ _ h => by obtain ⟨x⟩ := h; exact x.2)
      (fun Z g hg => .mk (⟨⟨Z, g⟩, hg⟩ : 𝒰.I₀))
  obtain ⟨T, hTfin, hTcov⟩ :=
    exists_finite_subfamily_sieve_mem_of_isQuasiCompactObject hU 𝒰
      (by rwa [show 𝒰.sieve₀ = Sieve.generate S from congrArg Sieve.generate hpre])
  exact ⟨T, hTfin.to_subtype, fun i => 𝒰.X i.1, fun i => 𝒰.f i.1, fun i => i.1.2, hTcov⟩

end CategoryTheory.GrothendieckTopology

end
