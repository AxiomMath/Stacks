module

public import Mathlib.CategoryTheory.Sites.Over
public import StacksFrontier.CategoryTheory.Sites.QuasiCompact
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Quasi-compact objects of a localized site

Let `J` be a Grothendieck topology on a category `C`, let `Y : C` and let `X : Over Y`. The
localized topology `CategoryTheory.GrothendieckTopology.over` on the slice has as covering
sieves of `X` exactly the sieves whose image under `CategoryTheory.Sieve.overEquiv X` covers
`X.left` for `J`. Quasi-compactness in the sense of Stacks 090H transfers along that
correspondence.

## Main results

* `CategoryTheory.GrothendieckTopology.isQuasiCompactObject_over`: if `X.left` is a
  quasi-compact object of `(C, J)` then `X` is a quasi-compact object of the localized site
  `(Over Y, J.over Y)`.

## Implementation notes

Both directions of the correspondence are needed and both are available without any
functorial preliminaries: `CategoryTheory.Sieve.overEquiv_ofArrows` turns the sieve generated
by a family in the slice into the sieve generated by the family of underlying morphisms, and a
family of morphisms to `X.left` is lifted into the slice by composing each member with the
structure morphism `X.hom`. The index map of the refining morphism of families is untouched by
both moves, so the finiteness condition transfers verbatim.

## References

* [Stacks Project, Tag 090H](https://stacks.math.columbia.edu/tag/090H)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe v u

namespace CategoryTheory.GrothendieckTopology

variable {C : Type u} [Category.{v} C]

/-- **Quasi-compactness is inherited by the localized site.** If the underlying object `X.left`
of an object `X` of the slice `Over Y` is quasi-compact for `J`, then `X` is quasi-compact for
the localized topology `J.over Y`.

A covering family of `X` in the slice has a covering family of underlying morphisms, which
quasi-compactness of `X.left` refines through finitely many of its members; composing the
refining family with the structure morphism `X.hom` lifts that refinement back into the
slice. -/
@[sga "4 VI 1.5.1" "partial"]
public theorem isQuasiCompactObject_over (J : GrothendieckTopology C) {Y : C} (X : Over Y)
    (hX : J.IsQuasiCompactObject X.left) : (J.over Y).IsQuasiCompactObject X := by
  intro 𝒰 h𝒰
  rw [mem_over_iff, PreZeroHypercover.sieve₀, Sieve.overEquiv_ofArrows] at h𝒰
  obtain ⟨𝒱, φ, h𝒱, hfin⟩ :=
    hX { I₀ := 𝒰.I₀, X := fun i => (𝒰.X i).left, f := fun i => (𝒰.f i).left } h𝒰
  refine ⟨{ I₀ := 𝒱.I₀
            X := fun i => Over.mk (𝒱.f i ≫ X.hom)
            f := fun i => Over.homMk (𝒱.f i) },
    { s₀ := φ.s₀
      h₀ := fun i => Over.homMk (φ.h₀ i) ?_
      w₀ := fun i => ?_ }, ?_, hfin⟩
  · rw [← Over.w (𝒰.f (φ.s₀ i)), ← Category.assoc]
    exact congrArg (· ≫ X.hom) (φ.w₀ i)
  · ext
    exact φ.w₀ i
  · rw [mem_over_iff, PreZeroHypercover.sieve₀, Sieve.overEquiv_ofArrows]
    exact h𝒱

end CategoryTheory.GrothendieckTopology

end
