module

public import Mathlib.CategoryTheory.Limits.Shapes.Pullback.HasPullback
public import Mathlib.SetTheory.Cardinal.Regular
public import StacksFrontier.CategoryTheory.Sites.Pretopology.SmallSubsite
public import StacksFrontier.Order.TransfiniteIterationSmall

/-!
# The set of coverings generated by a set of coverings

Let `C` be a category with fibre products whose objects and morphisms form sets, and let `T₀` be
a set of coverings of `C`. Closing `T₀` under the three operations in the axioms of a site
(one-element families of isomorphisms, composition of coverings, base change along chosen fibre
products) by a transfinite iteration gives a *set* `Covering.closure T₀` of coverings which
contains `T₀` and satisfies the axioms of a site. This realizes the set `Cov(C)_{κ, α}` of
Stacks 000X: a set of coverings, closed under the operations of a site, obtained by bounding the
stages at which coverings are produced.

Every covering is combinatorially equivalent (Stacks 00VU (1)) to the covering indexed by the set
of its arrows, `Covering.ofArrows`, and these form a set; adding them to `T₀` gives the system of
representatives in Stacks 000X (3).

## Main definitions

* `Covering.arrows`, `Covering.ofArrows`: the set of arrows of a covering, and the covering indexed
  by a set of arrows.
* `Covering.closureStep`: one step of the closure.
* `Covering.closure`: the closure of a set of coverings.

## Main results

* `Covering.combEquiv_ofArrows`: a covering is combinatorially equivalent to the covering indexed by
  its arrows.
* `Covering.small_closure`: the closure of a set of coverings is a set.
* `Covering.le_closure`: it contains the coverings it is generated by.
* `Covering.isSite_closure`: it satisfies the axioms of a site.
* `Covering.closure_induction`: a property of coverings holding on `T₀` and preserved by the
  closure step holds on the closure.

## References

* [Stacks Project, Tag 000X](https://stacks.math.columbia.edu/tag/000X)
* [Stacks Project, Tag 00VH](https://stacks.math.columbia.edu/tag/00VH)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Cardinal

universe w v u

namespace Covering

variable {C : Type u} [Category.{v} C]

/-- The set of arrows `Supp(𝒰)` of a covering `𝒰`, as pairs of a source and a morphism. -/
public def arrows (𝒰 : Covering.{u, v, w} C) : Set (Σ V : C, V ⟶ 𝒰.1) :=
  Set.range fun i => (⟨𝒰.2.X i, 𝒰.2.f i⟩ : Σ V : C, V ⟶ 𝒰.1)

/-- The covering of `U` indexed by a set `T` of morphisms into `U`. -/
public noncomputable def ofArrows (U : C) (T : Set (Σ V : C, V ⟶ U)) [Small.{w} T] :
    Covering.{u, v, w} C :=
  ⟨U, ⟨Shrink.{w} T, fun s => ((equivShrink T).symm s).1.1,
    fun s => ((equivShrink T).symm s).1.2⟩⟩

/-- An equality of pairs of a source and a morphism gives the equality of the sources and the
equality of the morphisms transported along it. -/
private lemma eq_eqToHom_comp_of_sigma_eq {U : C} {p q : Σ V : C, V ⟶ U} (h : p = q) :
    ∃ e : p.1 = q.1, p.2 = eqToHom e ≫ q.2 := by
  subst h
  exact ⟨rfl, by simp⟩

/-- **Stacks 000X, proof.** A covering is combinatorially equivalent to the covering indexed by the
set of its arrows. -/
public lemma combEquiv_ofArrows (𝒰 : Covering.{u, v, w} C) [Small.{w} 𝒰.arrows] :
    CombEquiv 𝒰 (ofArrows 𝒰.1 𝒰.arrows) := by
  let e := equivShrink.{w} 𝒰.arrows
  refine ⟨rfl, ?_, ?_⟩
  · have key (i : 𝒰.2.I₀) := eq_eqToHom_comp_of_sigma_eq
      (congrArg Subtype.val (e.symm_apply_apply ⟨⟨𝒰.2.X i, 𝒰.2.f i⟩, i, rfl⟩)).symm
    choose hX hf using key
    exact ⟨fun i => e ⟨⟨𝒰.2.X i, 𝒰.2.f i⟩, i, rfl⟩, hX, hf⟩
  · choose β hβ using fun s : Shrink.{w} 𝒰.arrows => (e.symm s).2
    have key (s : Shrink.{w} 𝒰.arrows) := eq_eqToHom_comp_of_sigma_eq (hβ s).symm
    choose hX hf using key
    exact ⟨β, hX, hf⟩

variable [HasPullbacks C]

/-- The base change of a covering `{Uᵢ ⟶ U}` along `g : V ⟶ U`, by the chosen fibre products
`{Uᵢ ×_U V ⟶ V}`. -/
public noncomputable def baseChange (𝒰 : Covering.{u, v, w} C) {V : C} (g : V ⟶ 𝒰.1) :
    Covering.{u, v, w} C :=
  ⟨V, ⟨𝒰.2.I₀, fun i => pullback (𝒰.2.f i) g, fun _ => pullback.snd _ _⟩⟩

/-- One step of the closure of a collection `T` of coverings under the operations in the axioms
of a site: the members of `T`, the one-element families of isomorphisms, the compositions of
members of `T`, and the base changes of members of `T`. -/
public inductive closureStep (T : Covering.{u, v, w} C → Prop) : Covering.{u, v, w} C → Prop
  | of_mem {𝒰 : Covering.{u, v, w} C} (h : T 𝒰) : closureStep T 𝒰
  | singleton {U V : C} (f : V ⟶ U) [IsIso f] :
      closureStep T ⟨U, PreZeroHypercover.singleton.{w} f⟩
  | bind {𝒰 : Covering.{u, v, w} C} (h𝒰 : T 𝒰) (𝒱 : 𝒰.2.I₀ → Covering.{u, v, w} C)
      (h𝒱 : ∀ i, T (𝒱 i)) (h : ∀ i, (𝒱 i).1 = 𝒰.2.X i) :
      closureStep T ⟨𝒰.1, 𝒰.2.bind fun i => (𝒱 i).2.pushforward (eqToHom (h i))⟩
  | baseChange {𝒰 : Covering.{u, v, w} C} (h𝒰 : T 𝒰) {V : C} (g : V ⟶ 𝒰.1) :
      closureStep T (𝒰.baseChange g)

/-- A step of the closure keeps every covering already present. -/
public lemma le_closureStep (T : Covering.{u, v, w} C → Prop) : T ≤ closureStep T :=
  fun _ h => .of_mem h

/-- If the objects and morphisms of `C` form sets, a step of the closure applied to a set of
coverings gives a set of coverings. -/
public lemma small_closureStep [Small.{w} C] [LocallySmall.{w} C] (T : Covering.{u, v, w} C → Prop)
    (hT : Small.{w} (Subtype T)) : Small.{w} (Subtype (closureStep T)) := by
  let D := Subtype T ⊕ (Σ U V : C, {f : V ⟶ U // IsIso f}) ⊕
    {p : Σ 𝒰 : Subtype T, (𝒰.1.2.I₀ → Subtype T) // ∀ i, (p.2 i).1.1 = p.1.1.2.X i} ⊕
    (Σ 𝒰 : Subtype T, Σ V : C, V ⟶ 𝒰.1.1)
  let F : D → Subtype (closureStep T) := fun
    | .inl 𝒰 => ⟨𝒰.1, .of_mem 𝒰.2⟩
    | .inr (.inl ⟨_, _, f, hf⟩) => ⟨_, @closureStep.singleton _ _ _ T _ _ f hf⟩
    | .inr (.inr (.inl ⟨⟨𝒰, 𝒱⟩, h⟩)) =>
      ⟨_, .bind 𝒰.2 (fun i => (𝒱 i).1) (fun i => (𝒱 i).2) h⟩
    | .inr (.inr (.inr ⟨𝒰, _, g⟩)) => ⟨_, .baseChange 𝒰.2 g⟩
  refine small_of_surjective (f := F) ?_
  rintro ⟨𝒲, h⟩
  cases h with
  | of_mem h => exact ⟨.inl ⟨_, h⟩, rfl⟩
  | singleton f => exact ⟨.inr (.inl ⟨_, _, f, inferInstance⟩), rfl⟩
  | bind h𝒰 𝒱 h𝒱 h => exact ⟨.inr (.inr (.inl ⟨⟨⟨_, h𝒰⟩, fun i => ⟨𝒱 i, h𝒱 i⟩⟩, h⟩)), rfl⟩
  | baseChange h𝒰 g => exact ⟨.inr (.inr (.inr ⟨⟨_, h𝒰⟩, _, g⟩)), rfl⟩

/-- The stage indexed by the ordinal `γ` of the closure of `T₀`. -/
public noncomputable def closureStage (T₀ : Covering.{u, v, w} C → Prop) (γ : Ordinal.{w}) :
    Covering.{u, v, w} C → Prop :=
  transfiniteIterate closureStep γ T₀

/-- The cardinal bounding the index sets of the coverings in the closure of `T₀`: the supremum of
`ℵ₀` and of the cardinalities of the index sets of the members of `T₀`. -/
public noncomputable def closureIndexBound (T₀ : Covering.{u, v, w} C → Prop) : Cardinal.{w} :=
  ℵ₀ ⊔ ⨆ 𝒰 : Subtype T₀, #𝒰.1.2.I₀

/-- The ordinal at which the closure stops: the initial ordinal of the successor of the bound on
the index sets, a regular cardinal exceeding all of them. -/
public noncomputable def closureOrdinal (T₀ : Covering.{u, v, w} C → Prop) : Ordinal.{w} :=
  (Order.succ (closureIndexBound T₀)).ord

/-- The closure of a set `T₀` of coverings under the operations in the axioms of a site. -/
public noncomputable def closure (T₀ : Covering.{u, v, w} C → Prop) : Covering.{u, v, w} C → Prop :=
  closureStage T₀ (closureOrdinal T₀)

variable {T₀ : Covering.{u, v, w} C → Prop}

/-- The stages of the closure increase. -/
public lemma closureStage_mono {o o' : Ordinal.{w}} (h : o ≤ o') :
    closureStage T₀ o ≤ closureStage T₀ o' :=
  monotone_transfiniteIterate _ _ le_closureStep h

/-- The stage indexed by a successor ordinal is a step applied to the previous stage. -/
public lemma closureStage_succ (o : Ordinal.{w}) :
    closureStage T₀ (Order.succ o) = closureStep (closureStage T₀ o) :=
  transfiniteIterate_succ _ _ _ (not_isMax o)

/-- The closure contains the coverings it is generated by. -/
public lemma le_closure : T₀ ≤ closure T₀ := by
  have h : closureStage T₀ ⊥ = T₀ := transfiniteIterate_bot _ _
  exact h.symm.le.trans (closureStage_mono bot_le)

omit [HasPullbacks C] in
/-- The bound on the index sets is infinite. -/
public lemma aleph0_le_closureIndexBound : ℵ₀ ≤ closureIndexBound T₀ := le_sup_left

omit [HasPullbacks C] in
/-- The ordinal at which the closure stops is a limit ordinal. -/
public lemma isSuccLimit_closureOrdinal : Order.IsSuccLimit (closureOrdinal T₀) :=
  Cardinal.isSuccLimit_ord (aleph0_le_closureIndexBound.trans (Order.le_succ _))

omit [HasPullbacks C] in
/-- The cofinality of the ordinal at which the closure stops is the successor of the bound on the
index sets. -/
public lemma cof_closureOrdinal :
    (closureOrdinal T₀).cof = Order.succ (closureIndexBound T₀) :=
  (Cardinal.isRegular_succ aleph0_le_closureIndexBound).cof_ord

/-- A covering lies in the closure precisely when it lies in an earlier stage. -/
public lemma closure_iff {𝒰 : Covering.{u, v, w} C} :
    closure T₀ 𝒰 ↔ ∃ o < closureOrdinal T₀, closureStage T₀ o 𝒰 :=
  transfiniteIterate_apply_iff_of_isSuccLimit _ _ isSuccLimit_closureOrdinal 𝒰

/-- A step applied to a stage below the closure ordinal stays inside the closure. -/
public lemma closure_of_closureStep {o : Ordinal.{w}} (ho : o < closureOrdinal T₀)
    {𝒰 : Covering.{u, v, w} C} (h : closureStep (closureStage T₀ o) 𝒰) : closure T₀ 𝒰 :=
  closure_iff.2 ⟨Order.succ o, isSuccLimit_closureOrdinal.succ_lt ho,
    (closureStage_succ (T₀ := T₀) o).symm ▸ h⟩

/-- A `Σ`-type whose index set and fibres have cardinality at most an infinite cardinal `κ` has
cardinality at most `κ`. -/
private lemma mk_sigma_le_of_le {κ : Cardinal.{w}} (hκ : ℵ₀ ≤ κ) {I : Type w} (hI : #I ≤ κ)
    {J : I → Type w} (hJ : ∀ i, #(J i) ≤ κ) : #(Σ i, J i) ≤ κ :=
  calc #(Σ i, J i) = sum fun i => #(J i) := mk_sigma J
    _ ≤ #I * κ := (sum_le_sum _ _ hJ).trans (by simp [sum_const])
    _ ≤ κ * κ := mul_le_mul' hI le_rfl
    _ = κ := mul_eq_self hκ

/-- Every member of a stage of the closure has index set of cardinality at most the bound, if the
members of `T₀` have. -/
private lemma mk_le_of_closureStage {κ : Cardinal.{w}} (hκ : ℵ₀ ≤ κ)
    (hT₀ : ∀ 𝒰, T₀ 𝒰 → #𝒰.2.I₀ ≤ κ) (o : Ordinal.{w}) :
    ∀ 𝒰, closureStage T₀ o 𝒰 → #𝒰.2.I₀ ≤ κ := by
  induction o using SuccOrder.limitRecOn with
  | isMin o ho =>
    obtain rfl := ho.eq_bot
    intro 𝒰 h
    rw [closureStage, transfiniteIterate_bot] at h
    exact hT₀ _ h
  | succ o _ ih =>
    rw [closureStage_succ]
    intro 𝒰 h
    cases h with
    | of_mem h => exact ih _ h
    | singleton f => simpa using one_le_aleph0.trans hκ
    | bind h𝒰 𝒱 h𝒱 h => exact mk_sigma_le_of_le hκ (ih _ h𝒰) fun i => ih _ (h𝒱 i)
    | @baseChange 𝒰' h𝒰 V g => exact ih 𝒰' h𝒰
  | isSuccLimit o ho ih =>
    intro 𝒰 h
    obtain ⟨c, hc, h⟩ := (transfiniteIterate_apply_iff_of_isSuccLimit _ _ ho 𝒰).1 h
    exact ih c hc 𝒰 h

omit [HasPullbacks C] in
/-- Every member of `T₀` has index set of cardinality at most the bound. -/
private lemma mk_le_closureIndexBound_of_mem [Small.{w} (Subtype T₀)] {𝒰 : Covering.{u, v, w} C}
    (h : T₀ 𝒰) : #𝒰.2.I₀ ≤ closureIndexBound T₀ :=
  (le_ciSup (f := fun 𝒰 : Subtype T₀ => #𝒰.1.2.I₀) Cardinal.bddAbove_of_small
    ⟨𝒰, h⟩).trans le_sup_right

/-- Every member of the closure has index set of cardinality at most the bound. -/
private lemma mk_le_closureIndexBound [Small.{w} (Subtype T₀)] {𝒰 : Covering.{u, v, w} C}
    (h : closure T₀ 𝒰) : #𝒰.2.I₀ ≤ closureIndexBound T₀ :=
  mk_le_of_closureStage aleph0_le_closureIndexBound (fun _ => mk_le_closureIndexBound_of_mem)
    _ _ h

/-- The closure of a set of coverings is a set. -/
public lemma small_closure [Small.{w} C] [LocallySmall.{w} C] (hT₀ : Small.{w} (Subtype T₀)) :
    Small.{w} (Subtype (closure T₀)) :=
  small_transfiniteIterate _ (small_closureStep) _ hT₀ _

/-- **Stacks 000X (2).** The closure of a set of coverings satisfies the axioms of a site. -/
public lemma isSite_closure [Small.{w} (Subtype T₀)] : IsSite (closure T₀) := by
  have h0 : (0 : Ordinal.{w}) < closureOrdinal T₀ := isSuccLimit_closureOrdinal.bot_lt
  refine ⟨fun f _ => closure_of_closureStep h0 (.singleton f), ?_, ?_⟩
  · intro 𝒰 h𝒰 𝒱 h𝒱 h
    obtain ⟨o₀, ho₀, h𝒰o⟩ := closure_iff.1 h𝒰
    choose o ho h𝒱o using fun i => closure_iff.1 (h𝒱 i)
    obtain ⟨m, hm, hom⟩ := Ordinal.exists_lt_forall_le_of_mk_lt_cof
      (by rw [cof_closureOrdinal, ← mk_congr (equivShrink.{w} 𝒰.2.I₀)]
          exact Order.lt_succ_of_le (mk_le_closureIndexBound h𝒰)) o ho
    refine closure_of_closureStep (max_lt ho₀ hm)
      (.bind (closureStage_mono (le_max_left _ _) _ h𝒰o) 𝒱
        (fun i => closureStage_mono ((hom i).trans (le_max_right _ _)) _ (h𝒱o i)) h)
  · intro 𝒰 h𝒰 V g
    obtain ⟨o, ho, h𝒰o⟩ := closure_iff.1 h𝒰
    exact ⟨_, fun i => pullback.fst (𝒰.2.f i) g, fun i => pullback.snd (𝒰.2.f i) g,
      fun i => IsPullback.of_hasPullback _ _,
      closure_of_closureStep ho (.baseChange h𝒰o g)⟩

/-- A property of coverings that holds on `T₀` and is preserved by the closure step holds on the
closure of `T₀`. -/
public lemma closure_induction (P : Covering.{u, v, w} C → Prop) (h₀ : ∀ 𝒰, T₀ 𝒰 → P 𝒰)
    (hstep : ∀ T : Covering.{u, v, w} C → Prop, (∀ 𝒰, T 𝒰 → P 𝒰) →
      ∀ 𝒰, closureStep T 𝒰 → P 𝒰) {𝒰 : Covering.{u, v, w} C} (h : closure T₀ 𝒰) : P 𝒰 := by
  suffices ∀ o : Ordinal.{w}, ∀ 𝒰, closureStage T₀ o 𝒰 → P 𝒰 from this _ _ h
  intro o
  induction o using SuccOrder.limitRecOn with
  | isMin o ho =>
    obtain rfl := ho.eq_bot
    intro 𝒰 h
    rw [closureStage, transfiniteIterate_bot] at h
    exact h₀ _ h
  | succ o _ ih =>
    rw [closureStage_succ]
    exact hstep _ ih
  | isSuccLimit o ho ih =>
    intro 𝒰 h
    obtain ⟨c, hc, h⟩ := (transfiniteIterate_apply_iff_of_isSuccLimit _ _ ho 𝒰).1 h
    exact ih c hc 𝒰 h

end Covering
