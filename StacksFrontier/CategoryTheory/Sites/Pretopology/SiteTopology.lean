module

public import Mathlib.CategoryTheory.Sites.Coverage
public import Mathlib.CategoryTheory.Sites.EqualizerSheafCondition
public import StacksFrontier.CategoryTheory.Sites.Pretopology.SitePretopology
public import Mathlib.Tactic.CrossRefAttribute

/-!
# The topology defined by a site (Stacks 00ZC)

A site in the sense of Stacks 00VH is a category `C` with a class `IsCov` of covering families
satisfying the isomorphism, composition and base change axioms (`IsSite IsCov`); no fibre
products are assumed in `C` beyond those the base change axiom provides. Stacks 00ZC says:

1. the sieves `S` on `U` containing the sieve generated by some covering `{Uᵢ ⟶ U}` form a
   Grothendieck topology `J`;
2. a presheaf of sets is a sheaf for `J` if and only if it is a sheaf on the site, that is, for
   every covering `{Uᵢ ⟶ U}` the diagram `F(U) ⟶ ∏ F(Uᵢ) ⇉ ∏ F(Uᵢ ×_U Uⱼ)` is an equalizer
   (Stacks 00VM).

## Main definitions

* `IsSite.coverage`: the coverage whose covering presieves are those of the covering families.
* `IsSite.topology`: the Grothendieck topology `J` of Stacks 00ZC.

## Main results

* `IsSite.mem_topology_iff`: the covering sieves of `J` are exactly the sieves of 00ZC.
* `IsSite.isSheaf_topology_iff`: a presheaf is a `J`-sheaf iff it is a sheaf for every covering
  family of the site.
* `IsSite.isSheaf_topology_iff_isLimit`: the same with the equalizer form of Stacks 00VM.
* `IsSite.exists_topology_and_isSheaf_iff`: Stacks 00ZC, both parts together.

## Note on Mathlib's registration

Mathlib registers 00ZC on `CategoryTheory.Pretopology.toGrothendieck`, the topology generated by
a pretopology in a category with all fibre products. That definition makes no claim of its own:
part (1) is `Pretopology.mem_toGrothendieck` and part (2) `Presieve.isSheaf_pretopology`, and both
assume `HasPullbacks C`, which a Stacks site does not. The results here are stated for a site as
in 00VH.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u v w t

variable {C : Type u} [Category.{v} C] {IsCov : Covering.{u, v, w} C → Prop}

namespace IsSite

/-- The coverage of a site: the covering presieves of `U` are the presieves of the covering
families with target `U`. The base change axiom gives its pullback condition. -/
def coverage (h : IsSite IsCov) : Coverage C where
  toPrecoverage := precoverageSitePretopology IsCov
  pullback U V f R := by
    rintro ⟨E, rfl, hE⟩
    obtain ⟨P, π₁, π₂, hpb, hcov⟩ := h.2.2 ⟨U, E⟩ hE V f
    refine ⟨Presieve.ofArrows P π₂, ⟨⟨E.I₀, P, π₂⟩, rfl, hcov⟩, ?_⟩
    rintro Z g ⟨i⟩
    exact ⟨E.X i, π₁ i, E.f i, ⟨i⟩, (hpb i).w⟩

/-- **The topology defined by a site** (Stacks 00ZC, 00ZD): the Grothendieck topology generated
by the covering families. By `mem_topology_iff` its covering sieves on `U` are the sieves
containing the sieve generated by some covering of `U`. -/
def topology (h : IsSite IsCov) : GrothendieckTopology C :=
  h.coverage.toGrothendieck

/-- **Stacks 00ZC (1)**: a sieve `S` on `U` covers for the topology of the site exactly when
some covering `{Uᵢ ⟶ U}` of the site generates a sieve contained in `S`. -/
theorem mem_topology_iff (h : IsSite IsCov) {U : C} (S : Sieve U) :
    S ∈ h.topology U ↔
      ∃ E : PreZeroHypercover.{w} U, IsCov ⟨U, E⟩ ∧ Sieve.generate E.presieve₀ ≤ S := by
  refine ⟨fun hS => ?_, fun ⟨E, hE, hle⟩ => ?_⟩
  · induction hS with
    | of X R hR =>
      obtain ⟨E, rfl, hE⟩ := hR
      exact ⟨E, hE, le_rfl⟩
    | top X =>
      exact ⟨PreZeroHypercover.singleton.{w} (𝟙 X), h.1 (𝟙 X), le_top⟩
    | transitive X R S _ _ ihR ihS =>
      obtain ⟨E, hE, hle⟩ := ihR
      choose F hF hFle using fun i : E.I₀ => ihS (hle _ (Sieve.le_generate _ _ _ (E.presieve₀_f i)))
      refine ⟨_, h.2.1 ⟨X, E⟩ hE (fun i => ⟨E.X i, F i⟩) hF (fun _ => rfl), ?_⟩
      rw [Sieve.generate_le_iff]
      rintro _ _ ⟨⟨i, j⟩⟩
      simpa [PreZeroHypercover.bind, PreZeroHypercover.pushforward] using
        hFle i _ (Sieve.le_generate _ _ _ ((F i).presieve₀_f j))
  · exact h.coverage.mem_toGrothendieck_sieves_of_superset
      ((Sieve.generate_le_iff _ _).mp hle) ⟨E, rfl, hE⟩

/-- **Stacks 00ZC (2)**: a presheaf of sets is a sheaf for the topology of the site exactly when
it is a sheaf for every covering family of the site. -/
theorem isSheaf_topology_iff (h : IsSite IsCov) (F : Cᵒᵖ ⥤ Type t) :
    Presieve.IsSheaf h.topology F ↔
      ∀ 𝒰 : Covering.{u, v, w} C, IsCov 𝒰 → Presieve.IsSheafFor F 𝒰.2.presieve₀ := by
  rw [topology, Presieve.isSheaf_coverage]
  refine ⟨fun H 𝒰 h𝒰 => H _ ⟨𝒰.2, rfl, h𝒰⟩, ?_⟩
  rintro H U R ⟨E, rfl, hE⟩
  exact H ⟨U, E⟩ hE

/-- The fibre products `Uᵢ ×_U Uⱼ` of the members of a covering exist: base change of the
covering along `Uⱼ ⟶ U` provides them. -/
theorem hasPairwisePullbacks (h : IsSite IsCov) {𝒰 : Covering.{u, v, w} C} (h𝒰 : IsCov 𝒰) :
    𝒰.2.presieve₀.HasPairwisePullbacks where
  has_pullbacks {_ _ _} hf {_} hg := by
    obtain ⟨i⟩ := hf
    obtain ⟨j⟩ := hg
    obtain ⟨P, π₁, π₂, hpb, -⟩ := h.2.2 𝒰 h𝒰 _ (𝒰.2.f j)
    exact (hpb i).hasPullback

/-- **Stacks 00ZC (2)**, with the sheaf condition of Stacks 00VM as stated there: a presheaf
of sets is a sheaf for the topology of the site exactly when, for every covering
`{Uᵢ ⟶ U}`, the fork `F(U) ⟶ ∏ F(Uᵢ) ⇉ ∏ F(Uᵢ ×_U Uⱼ)` is an equalizer. -/
theorem isSheaf_topology_iff_isLimit (h : IsSite IsCov) (F : Cᵒᵖ ⥤ Type w) :
    Presieve.IsSheaf h.topology F ↔
      ∀ (𝒰 : Covering.{u, v, w} C) (h𝒰 : IsCov 𝒰),
        haveI := h.hasPairwisePullbacks h𝒰
        Nonempty (IsLimit (Fork.ofι (Equalizer.Presieve.Arrows.forkMap F 𝒰.2.X 𝒰.2.f)
          (Equalizer.Presieve.Arrows.w F 𝒰.2.X 𝒰.2.f))) := by
  rw [h.isSheaf_topology_iff]
  refine forall₂_congr fun 𝒰 h𝒰 => ?_
  have := h.hasPairwisePullbacks h𝒰
  exact Equalizer.Presieve.Arrows.sheaf_condition F 𝒰.2.X 𝒰.2.f

/-- **Stacks 00ZC.** Let `C` be a site with coverings `IsCov`. For `U : C`, let `J(U)` be the
set of sieves `S` on `U` such that some covering `{fᵢ : Uᵢ ⟶ U}` of the site generates a sieve
contained in `S`. Then (1) `J` is a Grothendieck topology on `C`, and (2) a presheaf of sets
is a sheaf for `J` if and only if it is a sheaf on the site, that is, for every covering the
fork `F(U) ⟶ ∏ F(Uᵢ) ⇉ ∏ F(Uᵢ ×_U Uⱼ)` is an equalizer (Stacks 00VM). The topology is
`IsSite.topology`. -/
@[stacks 00ZC "Both parts for a site as in 00VH (no fibre products assumed in `C`); the sheaf
  condition is the equalizer of 00VM. Mathlib's own 00ZC tag on `Pretopology.toGrothendieck`
  only names the topology of a pretopology in a category with all fibre products."]
theorem exists_topology_and_isSheaf_iff (h : IsSite IsCov) :
    ∃ J : GrothendieckTopology C,
      (∀ (U : C) (S : Sieve U),
        S ∈ J U ↔ ∃ E : PreZeroHypercover.{w} U, IsCov ⟨U, E⟩ ∧ Sieve.generate E.presieve₀ ≤ S) ∧
      ∀ F : Cᵒᵖ ⥤ Type w,
        Presieve.IsSheaf J F ↔
          ∀ (𝒰 : Covering.{u, v, w} C) (h𝒰 : IsCov 𝒰),
            haveI := h.hasPairwisePullbacks h𝒰
            Nonempty (IsLimit (Fork.ofι (Equalizer.Presieve.Arrows.forkMap F 𝒰.2.X 𝒰.2.f)
              (Equalizer.Presieve.Arrows.w F 𝒰.2.X 𝒰.2.f))) :=
  ⟨h.topology, fun _ => h.mem_topology_iff, h.isSheaf_topology_iff_isLimit⟩

end IsSite
