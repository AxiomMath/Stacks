module

public import Mathlib.CategoryTheory.Sites.Coverage
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import Mathlib.CategoryTheory.Sites.Hypercover.Zero

/-!
# The topology generated by a precoverage only depends on its coverings up to refinement

`CategoryTheory.isSheaf_iff_of_refines` records Stacks 00VX for a
`CategoryTheory.Pretopology`: mutual refinement of the covering families makes the two notions
of sheaf agree. This file records the same comparison one level down, for a
`CategoryTheory.Precoverage`, and in the sharper form of an (in)equality of the *generated
Grothendieck topologies* rather than of their sheaves.

Two things are gained. A `Precoverage` is a bare collection of covering presieves with no site
axioms at all, so the comparison applies to collections — such as the chosen covering families
of a big site — which are not known to be pretopologies; and the conclusion is an equality of
topologies, which is strictly stronger than the agreement of the sheaf categories and is what
one needs in order to *rewrite* one topology into the other.

No pullbacks are required, in contrast to
`CategoryTheory.toGrothendieck_le_of_refines`: the proof goes through
`CategoryTheory.Precoverage.toGrothendieck_eq_sInf`, which presents the generated topology as
the least one containing the sieves generated by the covering presieves, so only the sieve
inequality `Sieve.generate R' ≤ Sieve.generate R` of a refinement is used.

## Main results

* `CategoryTheory.PreZeroHypercover.Hom.factorsThru_presieve₀`: a refinement morphism of
  pre-`0`-hypercovers induces a factorisation of the generated presieves, which is the
  presieve-level notion of refinement of Stacks 00VT (2).
* `CategoryTheory.Precoverage.toGrothendieck_le_of_refines`: if every covering presieve of `J₁`
  is refined by a covering presieve of `J₂`, the topology generated by `J₁` is contained in the
  one generated by `J₂`.
* `CategoryTheory.Precoverage.toGrothendieck_eq_of_refines`: mutual refinement gives equality of
  the generated topologies.
* `CategoryTheory.Presieve.FactorsThru.trans` and
  `CategoryTheory.PreZeroHypercover.factorsThru_presieve₀_of_map`: refinement is transitive, and
  descends along a fully faithful functor.

## References

* [Stacks Project, Tag 00VX](https://stacks.math.columbia.edu/tag/00VX)
* [Stacks Project, Tag 00VT](https://stacks.math.columbia.edu/tag/00VT)
-/

@[expose] public section

namespace CategoryTheory

universe w w' v u

variable {C : Type u} [Category.{v} C]

/-- A refinement morphism `E ⟶ F` of pre-`0`-hypercovers makes the presieve generated by `E`
factor through the presieve generated by `F`: the component `h₀ i` of the morphism is the
factorisation of the arrow `E.f i` through `F.f (s₀ i)`.

This is the translation of Mathlib's indexed notion of refinement into the presieve-level notion
of Stacks 00VT (2), namely `CategoryTheory.Presieve.FactorsThru`. -/
lemma PreZeroHypercover.Hom.factorsThru_presieve₀ {S : C} {E : PreZeroHypercover.{w} S}
    {F : PreZeroHypercover.{w'} S} (φ : E.Hom F) : E.presieve₀.FactorsThru F.presieve₀ := by
  rintro Y g ⟨i⟩
  exact ⟨F.X (φ.s₀ i), φ.h₀ i, F.f (φ.s₀ i), ⟨φ.s₀ i⟩, φ.w₀ i⟩

/-- Refinement is transitive: a refinement of a refinement is a refinement. -/
lemma Presieve.FactorsThru.trans {X : C} {R S T : Presieve X} (hRS : R.FactorsThru S)
    (hST : S.FactorsThru T) : R.FactorsThru T := by
  intro Z g hg
  obtain ⟨W, i, e, he, hie⟩ := hRS hg
  obtain ⟨W', i', e', he', hie'⟩ := hST he
  exact ⟨W', i ≫ i', e', he', by rw [Category.assoc, hie', hie]⟩

/-- Refinement of the families generated by two pre-`0`-hypercovers descends along a fully
faithful functor: a factorisation of the image families is the image of a factorisation.

The sources of the refining family are *given* by the refined one, so no object of the source
category has to be produced; only a morphism, which fullness supplies and faithfulness shows
to commute. -/
lemma PreZeroHypercover.factorsThru_presieve₀_of_map {D : Type*} [Category D] (F : C ⥤ D)
    [F.Full] [F.Faithful] {X : C} {E : PreZeroHypercover.{w} X} {G : PreZeroHypercover.{w'} X}
    (h : (E.map F).presieve₀.FactorsThru (G.map F).presieve₀) :
    E.presieve₀.FactorsThru G.presieve₀ := by
  -- Spell both image families as `Presieve.ofArrows` indexed by the *source* index types, so
  -- that destructuring an arrow of the refined family produces an index of `G` itself.
  have h' : Presieve.FactorsThru
      (Presieve.ofArrows (fun i => F.obj (E.X i)) fun i => F.map (E.f i))
      (Presieve.ofArrows (fun j => F.obj (G.X j)) fun j => F.map (G.f j)) := h
  rintro Z g ⟨i⟩
  obtain ⟨W, u, e, he, hue⟩ := h' ⟨i⟩
  obtain ⟨j⟩ := he
  refine ⟨G.X j, F.preimage u, G.f j, ⟨j⟩, F.map_injective ?_⟩
  rw [F.map_comp, F.map_preimage]
  exact hue

namespace Precoverage

/-- **Stacks 00VX**, for precoverages and in the form of an inequality of generated topologies:
if every covering presieve of `J₁` is refined by some covering presieve of `J₂`, then the
Grothendieck topology generated by `J₁` is contained in the one generated by `J₂`.

Unlike `CategoryTheory.toGrothendieck_le_of_refines`, this needs neither pullbacks in `C` nor
the site axioms of a pretopology. -/
theorem toGrothendieck_le_of_refines (J₁ J₂ : Precoverage C)
    (h : ∀ (X : C) (R : Presieve X), R ∈ J₁ X →
      ∃ R' ∈ J₂ X, Presieve.FactorsThru R' R) :
    J₁.toGrothendieck ≤ J₂.toGrothendieck := by
  rw [J₁.toGrothendieck_eq_sInf]
  refine sInf_le fun X R hR => ?_
  obtain ⟨R', hR', hfac⟩ := h X R hR
  refine J₂.toGrothendieck.superset_covering ?_ (generate_mem_toGrothendieck hR')
  rw [Sieve.generate_le_iff]
  intro Y g hg
  obtain ⟨Z, i, e, he, hie⟩ := hfac hg
  exact ⟨Z, i, e, he, hie⟩

/-- **Stacks 00VX**, for precoverages: if the covering presieves of `J₁` and `J₂` refine each
other, the two generated Grothendieck topologies are *equal*. -/
theorem toGrothendieck_eq_of_refines (J₁ J₂ : Precoverage C)
    (h₁ : ∀ (X : C) (R : Presieve X), R ∈ J₁ X →
      ∃ R' ∈ J₂ X, Presieve.FactorsThru R' R)
    (h₂ : ∀ (X : C) (R : Presieve X), R ∈ J₂ X →
      ∃ R' ∈ J₁ X, Presieve.FactorsThru R' R) :
    J₁.toGrothendieck = J₂.toGrothendieck :=
  le_antisymm (toGrothendieck_le_of_refines J₁ J₂ h₁) (toGrothendieck_le_of_refines J₂ J₁ h₂)

/-- A precoverage contained in another one is in particular refined by it, so the comparison of
generated topologies specialises to `CategoryTheory.Precoverage.toGrothendieck_mono`. -/
theorem toGrothendieck_le_of_le {J₁ J₂ : Precoverage C} (h : J₁ ≤ J₂) :
    J₁.toGrothendieck ≤ J₂.toGrothendieck :=
  toGrothendieck_le_of_refines J₁ J₂ fun X R hR =>
    ⟨R, h X hR, Presieve.factorsThru_of_le _ _ le_rfl⟩

end Precoverage

end CategoryTheory

end
