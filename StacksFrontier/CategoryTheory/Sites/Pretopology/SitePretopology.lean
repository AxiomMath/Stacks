module

public import Mathlib.CategoryTheory.Sites.Pretopology
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import StacksFrontier.CategoryTheory.Sites.Pretopology.SmallSubsite
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The pretopology of a site given by covering families

A class `Cov` of covering families satisfying the site axioms (isomorphisms, composition, base
change) in a category with fibre products defines a pretopology: the coverings of `U` are the
presieves of the families of `Cov` with target `U`. Its generated Grothendieck topology is the
topology generated by the families of `Cov`.

## Main definitions

* `IsSite.pretopologyBigFppfPretopology`: the pretopology of a site given by covering families.

## Main results

* `IsSite.toGrothendieck_pretopology_bigFppfPretopology`: its Grothendieck topology is the one
  generated by the presieves of the covering families.
* `CategoryTheory.Precoverage.isSite_presieve₀_mem`: conversely, a Mathlib precoverage with
  isomorphisms, stable under composition and base change and with the fibre products of its
  coverings, defines a site.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u v w

section Precoverage

variable {C : Type u} [Category.{v} C]

/-- A Mathlib precoverage that contains the isomorphisms, is stable under composition and base
change, and has the fibre products of its coverings defines a site in the sense of Stacks 00VH:
the covering families are those whose presieve is a covering. Only the fibre products of the
coverings are needed, not all pullbacks in `C`. -/
theorem CategoryTheory.Precoverage.isSite_presieve₀_mem (J : Precoverage C) [J.HasIsos]
    [J.IsStableUnderComposition] [J.IsStableUnderBaseChange] [J.HasPullbacks] :
    IsSite (fun 𝒰 : Covering.{u, v, w} C => 𝒰.2.presieve₀ ∈ J 𝒰.1) := by
  have transport : ∀ {A B : C} (e : A = B) (F : PreZeroHypercover.{w} A), F.presieve₀ ∈ J A →
      Presieve.ofArrows F.X (fun j => F.f j ≫ eqToHom e) ∈ J B := by
    rintro A B rfl F hF
    simpa using hF
  refine ⟨?_, ?_, ?_⟩
  · intro U V f hf
    rw [PreZeroHypercover.presieve₀_singleton]
    exact Precoverage.mem_coverings_of_isIso f
  · intro 𝒰 h𝒰 𝒱 h𝒱 h
    exact Precoverage.comp_mem_coverings 𝒰.2.f h𝒰 (fun i j => (𝒱 i).2.f j ≫ eqToHom (h i))
      fun i => transport (h i) (𝒱 i).2 (h𝒱 i)
  · intro 𝒰 h𝒰 V g
    have hpb : 𝒰.2.presieve₀.HasPullbacks g := Precoverage.hasPullbacks_of_mem g h𝒰
    have : ∀ i, HasPullback (𝒰.2.f i) g := fun i => hpb.hasPullback (𝒰.2.presieve₀_f i)
    exact ⟨fun i => pullback (𝒰.2.f i) g, fun i => pullback.fst _ _, fun i => pullback.snd _ _,
      fun i => IsPullback.of_hasPullback _ _,
      Precoverage.mem_coverings_of_isPullback 𝒰.2.f h𝒰 g _ _
        fun i => (IsPullback.of_hasPullback (𝒰.2.f i) g).flip⟩

end Precoverage

variable {C : Type u} [Category.{v} C] [HasPullbacks C] {IsCov : Covering.{u, v, w} C → Prop}

namespace IsSite

/-- The precoverage presented by a class of covering families: the coverings of `U` are the
presieves of the families of the class with target `U`. -/
def precoverageSitePretopology (IsCov : Covering.{u, v, w} C → Prop) : Precoverage C where
  coverings U := {R | ∃ E : PreZeroHypercover.{w} U, R = E.presieve₀ ∧ IsCov ⟨U, E⟩}

omit [HasPullbacks C] in
/-- The presieve of a family composed with isomorphisms on its members is the presieve of the
family of composites. -/
private theorem presieve₀_bind_singleton {U : C} (E : PreZeroHypercover.{w} U) {Y : E.I₀ → C}
    (e : ∀ i, Y i ⟶ E.X i) :
    (E.bind fun i => (PreZeroHypercover.singleton.{w} (e i)).pushforward (eqToHom rfl)).presieve₀ =
      Presieve.ofArrows Y fun i => e i ≫ E.f i := by
  refine le_antisymm ?_ ?_
  · rintro _ _ ⟨⟨i, ⟨⟩⟩⟩
    simpa [PreZeroHypercover.bind, PreZeroHypercover.pushforward,
      PreZeroHypercover.singleton] using Presieve.ofArrows.mk (f := fun i => e i ≫ E.f i) i
  · rintro _ _ ⟨i⟩
    simpa [PreZeroHypercover.bind, PreZeroHypercover.pushforward,
      PreZeroHypercover.singleton] using
      (PreZeroHypercover.presieve₀_f (E.bind fun i =>
        (PreZeroHypercover.singleton.{w} (e i)).pushforward (eqToHom rfl)) ⟨i, PUnit.unit⟩)

variable (h : IsSite IsCov)
include h

/-- The pretopology of a site given by covering families in a category with fibre products: the
coverings of `U` are the presieves of the covering families with target `U`. -/
def pretopologyBigFppfPretopology : Pretopology C where
  toPrecoverage := precoverageSitePretopology IsCov
  has_isos U V f hf := ⟨PreZeroHypercover.singleton.{w} f,
    (PreZeroHypercover.presieve₀_singleton f).symm, @h.1 _ _ f hf⟩
  pullbacks U V f S := by
    rintro ⟨E, rfl, hE⟩
    obtain ⟨P, π₁, π₂, hpb, hcov⟩ := h.2.2 ⟨U, E⟩ hE V f
    let F : PreZeroHypercover.{w} V := ⟨E.I₀, P, π₂⟩
    have hcomp := h.2.1 ⟨V, F⟩ hcov (fun i => ⟨P i, PreZeroHypercover.singleton.{w}
      ((hpb i).isoPullback.inv)⟩) (fun i => h.1 _) (fun _ => rfl)
    refine ⟨_, ?_, hcomp⟩
    rw [presieve₀_bind_singleton F, ← PreZeroHypercover.presieve₀_pullback₁]
    exact congrArg (Presieve.ofArrows (fun i => pullback (E.f i) f))
      (funext fun i => (hpb i).isoPullback_inv_snd.symm)
  transitive U S Ti := by
    rintro ⟨E, rfl, hE⟩ hTi
    choose F hF hFc using hTi
    have hcomp := h.2.1 ⟨U, E⟩ hE (fun i => ⟨E.X i, F (E.f i) (E.presieve₀_f i)⟩)
      (fun i => hFc _ _) (fun _ => rfl)
    refine ⟨_, ?_, hcomp⟩
    refine le_antisymm ?_ ?_
    · rintro Z _ ⟨Y, g, f, H, hg, rfl⟩
      obtain ⟨i⟩ := H
      rw [hF] at hg
      obtain ⟨j⟩ := hg
      simpa [PreZeroHypercover.bind, PreZeroHypercover.pushforward] using
        (PreZeroHypercover.presieve₀_f (E.bind fun i =>
          (F (E.f i) (E.presieve₀_f i)).pushforward (eqToHom rfl)) ⟨i, j⟩)
    · rintro _ _ ⟨⟨i, j⟩⟩
      refine ⟨E.X i, (F (E.f i) (E.presieve₀_f i)).f j, E.f i, E.presieve₀_f i, ?_, ?_⟩
      · rw [hF]
        exact (F (E.f i) (E.presieve₀_f i)).presieve₀_f j
      · simp [PreZeroHypercover.bind, PreZeroHypercover.pushforward]

/-- The Grothendieck topology of the pretopology of a site is the topology generated by the
presieves of its covering families. -/
@[sga "3 IV 4.2.6" "special case"]
theorem toGrothendieck_pretopology_bigFppfPretopology :
    (pretopologyBigFppfPretopology h).toGrothendieck =
      (precoverageSitePretopology IsCov).toGrothendieck := by
  refine le_antisymm ?_ ?_
  · rintro U S ⟨R, hR, hRS⟩
    exact GrothendieckTopology.superset_covering _ ((Sieve.generate_le_iff _ _).2 hRS)
      (Precoverage.generate_mem_toGrothendieck hR)
  · rw [Precoverage.toGrothendieck_le_iff_le_toPrecoverage]
    intro U R hR
    exact ⟨R, hR, Sieve.le_generate R⟩

end IsSite
