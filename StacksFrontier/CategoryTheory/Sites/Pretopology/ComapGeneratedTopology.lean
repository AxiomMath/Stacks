module

public import Mathlib.CategoryTheory.Sites.DenseSubsite.InducedTopology
public import Mathlib.CategoryTheory.Sites.Equivalence

/-!
# The topology generated by the comap of a precoverage along an isomorphism of categories

Let `F : C ⥤ D` be fully faithful and *surjective on objects*, and let `P` be a precoverage on
`D`. Pulling `P` back to `C` is `Precoverage.comap F P`, and the question this file answers is
how the Grothendieck topology it generates compares with the one generated by `P` itself:

`S ∈ (P.comap F).toGrothendieck X ↔ S.functorPushforward F ∈ P.toGrothendieck (F.obj X)`.

Both operations — generating a topology from a precoverage, and transporting sieves along `F` —
commute, so the two sides agree. Only the easy inclusion is in Mathlib in this generality
(`CategoryTheory.Precoverage.toGrothendieck_comap_le_restrictedTopology`); the other one is
available there only through
`CategoryTheory.Precoverage.toGrothendieck_comap_eq_restrictedTopology`, which asks the
precoverage to have isomorphisms, to have pullbacks and to be stable under composition and base
change. None of that is needed when `F` is an isomorphism of categories, and the proof below uses
none of it: it is an induction over `CategoryTheory.Precoverage.Saturate`, the inductive predicate
defining `Precoverage.toGrothendieck`, with the surjectivity of `F` on objects supplying a
preimage at every stage.

## Main results

* `CategoryTheory.Precoverage.map_functorPullback_of_surjective` — the comap of a precoverage along
  such an `F` is computed by pulling presieves back: `(R.functorPullback F).map F = R`.
* `CategoryTheory.Precoverage.mem_toGrothendieck_comap_iff` — the displayed equivalence.
* `CategoryTheory.Precoverage.toGrothendieck_comap_eq_restrictedTopology_of_surjective` — the same
  statement as an equality of Grothendieck topologies with
  `CategoryTheory.Functor.restrictedTopology`, which is the shape
  `CategoryTheory.Functor.IsDenseSubsite` consumes.

## Implementation notes

The hypothesis is stated as `Function.Surjective F.obj` rather than as essential surjectivity
because the applications — `CategoryTheory.AsSmall.down` and `CategoryTheory.AsSmall.up`, which
raise the morphism universe of a site — are surjective on objects on the nose, and because the
`Saturate` induction substitutes the resulting equality of objects instead of carrying an
isomorphism through four cases.

## References

* [Stacks Project, Tag 00Z9](https://stacks.math.columbia.edu/tag/00Z9)
-/

@[expose] public section

namespace CategoryTheory

open CategoryTheory Limits

universe v₁ v₂ u₁ u₂

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]
  (F : C ⥤ D) [F.Full] [F.Faithful] (hF : Function.Surjective F.obj)

namespace Precoverage

include hF

/-- A fully faithful functor which is surjective on objects is an equivalence. -/
theorem isEquivalence_of_surjective_obj : F.IsEquivalence :=
  have := Functor.essSurj_of_surj hF
  {}

omit [F.Faithful] in
/-- **Pulling a presieve back along `F` and pushing it forward again recovers it**, when `F` is
fully faithful and surjective on objects: every arrow into `F.obj X` has its source in the image
of `F` by surjectivity, and is the image of an arrow of `C` by fullness. This is the hypothesis
that `CategoryTheory.Precoverage.toGrothendieck_comap_eq_restrictedTopology` asks for. -/
theorem map_functorPullback_of_surjective {X : C} (R : Presieve (F.obj X)) :
    (Presieve.functorPullback F R).map F = R := by
  refine le_antisymm (Presieve.map_functorPullback R) fun W f hf => ?_
  obtain ⟨W', rfl⟩ := hF W
  rw [show f = F.map (F.preimage f) by simp]
  exact Presieve.map.of (show (Presieve.functorPullback F R) (F.preimage f) by simpa using hf)

variable (P : Precoverage D)

omit [F.Faithful] in
/-- The inductive step of `CategoryTheory.Precoverage.mem_toGrothendieck_comap_iff`: a sieve
saturated for `P` over an object in the image of `F` pulls back to a sieve saturated for the comap
of `P`. The preimage of the object is quantified over rather than fixed, so that each case of the
induction can substitute the equality and work with `F.obj X` itself. -/
theorem functorPullback_mem_toGrothendieck_comap {Y : D} {T : Sieve Y} (hT : P.Saturate Y T) :
    ∀ (X : C) (hX : F.obj X = Y),
      Sieve.functorPullback F (T.pullback (eqToHom hX)) ∈ (P.comap F).toGrothendieck X := by
  induction hT with
  | of Y R hR =>
    intro X hX
    subst hX
    simp only [eqToHom_refl, Sieve.pullback_id]
    refine GrothendieckTopology.superset_covering _
      (Sieve.generate_functorPullback_le F R) ?_
    refine generate_mem_toGrothendieck (J := P.comap F) ?_
    rw [mem_comap_iff, map_functorPullback_of_surjective F hF]
    exact hR
  | top Y =>
    intro X hX
    subst hX
    simp
  | pullback Y T₀ _ Y' g ih =>
    intro X hX
    subst hX
    obtain ⟨X₀, rfl⟩ := hF Y
    simp only [eqToHom_refl, Sieve.pullback_id]
    rw [show g = F.map (F.preimage g) by simp, Sieve.functorPullback_pullback]
    exact GrothendieckTopology.pullback_stable _ _ (by simpa using ih X₀ rfl)
  | transitive Y T₀ R _ h ih₀ ih =>
    intro X hX
    subst hX
    simp only [eqToHom_refl, Sieve.pullback_id]
    refine GrothendieckTopology.transitive _ (by simpa using ih₀ X rfl) _ ?_
    intro Z f hf
    have hZ := ih (f := F.map f) hf Z rfl
    simpa [Sieve.functorPullback_pullback] using hZ

/-- **The topology generated by the comap of a precoverage along an isomorphism of categories.**
For `F : C ⥤ D` fully faithful and surjective on objects and a precoverage `P` on `D`, a sieve
on `X : C` is covering for the topology generated by `Precoverage.comap F P` exactly when its
image under `F` is covering for the topology generated by `P`.

The forward implication is Mathlib's
`CategoryTheory.Precoverage.toGrothendieck_comap_le_restrictedTopology` read through
`CategoryTheory.Functor.mem_restrictedTopology_iff`, whose hypotheses an equivalence supplies.
The reverse one is `functorPullback_mem_toGrothendieck_comap` at the sieve's own image, using that
pulling an image back along a fully faithful functor recovers the sieve. -/
theorem mem_toGrothendieck_comap_iff {X : C} {S : Sieve X} :
    S ∈ (P.comap F).toGrothendieck X ↔
      S.functorPushforward F ∈ P.toGrothendieck (F.obj X) := by
  have := isEquivalence_of_surjective_obj F hF
  refine ⟨fun hS => ?_, fun hS => ?_⟩
  · exact Functor.mem_restrictedTopology_iff.mp
      (P.toGrothendieck_comap_le_restrictedTopology (F := F) _ hS)
  · have hX := functorPullback_mem_toGrothendieck_comap F hF P hS X rfl
    simpa [Sieve.functorPullback_functorPushforward_eq] using hX

/-- **The topology generated by the comap of a precoverage along an isomorphism of categories**,
as an equality of Grothendieck topologies: it is `CategoryTheory.Functor.restrictedTopology`, the
coarsest one whose covering sieves have covering image. This is the form
`CategoryTheory.Functor.IsDenseSubsite` consumes.

This is Mathlib's `CategoryTheory.Precoverage.toGrothendieck_comap_eq_restrictedTopology` with the
hypotheses on the precoverage — isomorphisms, pullbacks, stability under composition and base
change — replaced by surjectivity of `F` on objects, none of those being needed alongside it. -/
theorem toGrothendieck_comap_eq_restrictedTopology_of_surjective :
    (P.comap F).toGrothendieck = F.restrictedTopology P.toGrothendieck := by
  have := isEquivalence_of_surjective_obj F hF
  refine le_antisymm (fun _ _ hS => ?_) fun _ _ hS => ?_
  · exact Functor.mem_restrictedTopology_iff.mpr
      ((mem_toGrothendieck_comap_iff F hF P).mp hS)
  · exact (mem_toGrothendieck_comap_iff F hF P).mpr
      (Functor.mem_restrictedTopology_iff.mp hS)

end Precoverage

end CategoryTheory

end
