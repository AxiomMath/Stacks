module

public import StacksFrontier.CategoryTheory.Sites.Pretopology.EquivalenceComparison
public import Mathlib.CategoryTheory.Sites.Coverage
public import Mathlib.CategoryTheory.Sites.Sheaf

/-!
# Sheaves on a pretopology only depend on its coverings up to refinement

Stacks tag 00VX: if every covering of a pretopology `K₁` is tautologically equivalent to some
covering of `K₂` — or merely refined by one — then `K₁` generates a coarser topology than `K₂`,
so every `K₂`-sheaf is a `K₁`-sheaf. Consequently mutual tautological equivalence, and likewise
mutual refinement, makes the two notions of sheaf coincide.

## How the hypotheses are phrased

The source states 00VX for two *sets of families* of morphisms with fixed target. Mathlib's
`Pretopology` has `coverings X : Set (Presieve X)`, so the hypotheses below are about presieves.
Neither relation needs a presieve-level reformulation: refinement in the sense of 00VT (2) is
Mathlib's `Presieve.FactorsThru`, and tautological equivalence in the sense of 00VU (2) is
applied to a presieve through Mathlib's canonical section `Presieve.preZeroHypercover`, which
indexes a presieve by its own arrows and so restores the indexing a presieve has forgotten.
-/

@[expose] public section

namespace CategoryTheory

universe w w' t v u

variable {C : Type u} [Category.{v} C]

/-! ### The presieve-level form of Stacks 00VV (2) -/

namespace PreZeroHypercover

variable {U : C}

/-- The presieve-level form of **Stacks 00VV (2)**: if `E` and `F` are tautologically equivalent
families, then every arrow of the presieve generated by `F` factors through an arrow of the
presieve generated by `E`, the horizontal isomorphism of each triangle of 00VU (2) being the
factorisation. -/
lemma TautologicallyEquivalent.factorsThru_presieve₀ {E : PreZeroHypercover.{w} U}
    {F : PreZeroHypercover.{w'} U} (h : TautologicallyEquivalent E F) :
    F.presieve₀.FactorsThru E.presieve₀ := by
  obtain ⟨-, β, hβ⟩ := h
  rintro Y g ⟨j⟩
  obtain ⟨e, he⟩ := hβ j
  exact ⟨E.X (β j), e.hom, E.f (β j), ⟨β j⟩, he⟩

end PreZeroHypercover

/-! ### Refinement shrinks the generated sieve -/

/-- If `S` factors through `R`, then `Sieve.generate S ≤ Sieve.generate R`. -/
lemma generate_le_generate_of_refines {X : C} {S R : Presieve X}
    (hSR : Presieve.FactorsThru S R) : Sieve.generate S ≤ Sieve.generate R := by
  rw [Sieve.generate_le_iff]
  exact fun _ _ hg => hSR hg

variable [Limits.HasPullbacks C]

/-- If every `K₁`-covering is refined by some `K₂`-covering, then
`K₁.toGrothendieck ≤ K₂.toGrothendieck`. -/
lemma toGrothendieck_le_of_refines (K₁ K₂ : Pretopology C)
    (h : ∀ X (U : Presieve X), U ∈ K₁.coverings X →
        ∃ V ∈ K₂.coverings X, Presieve.FactorsThru V U) :
    K₁.toGrothendieck ≤ K₂.toGrothendieck := by
  intro X S hS
  rw [Pretopology.mem_toGrothendieck] at hS ⊢
  obtain ⟨U, hU, hUS⟩ := hS
  obtain ⟨V, hV, hVU⟩ := h X U hU
  refine ⟨V, hV, ?_⟩
  rw [← Sieve.generate_le_iff] at hUS ⊢
  exact (generate_le_generate_of_refines hVU).trans hUS

/-- If every `K₁`-covering is tautologically equivalent to some `K₂`-covering, then
`K₁.toGrothendieck ≤ K₂.toGrothendieck`. -/
lemma toGrothendieck_le_of_tautEquiv (K₁ K₂ : Pretopology C)
    (h : ∀ X (U : Presieve X), U ∈ K₁.coverings X → ∃ V ∈ K₂.coverings X,
        PreZeroHypercover.TautologicallyEquivalent U.preZeroHypercover V.preZeroHypercover) :
    K₁.toGrothendieck ≤ K₂.toGrothendieck :=
  toGrothendieck_le_of_refines K₁ K₂ fun X U hU =>
    let ⟨V, hV, hUV⟩ := h X U hU
    ⟨V, hV, by simpa using hUV.factorsThru_presieve₀⟩

/-- **Stacks 00VX (1)**, one inclusion: if every covering of `K₁` is tautologically equivalent
to some covering of `K₂`, then every `K₂`-sheaf is a `K₁`-sheaf. -/
@[stacks 00VX "(1)"]
theorem isSheaf_of_tautEquiv_subset (K₁ K₂ : Pretopology C)
    (h : ∀ X (U : Presieve X), U ∈ K₁.coverings X → ∃ V ∈ K₂.coverings X,
        PreZeroHypercover.TautologicallyEquivalent U.preZeroHypercover V.preZeroHypercover)
    (P : Cᵒᵖ ⥤ Type t) (hP : Presheaf.IsSheaf K₂.toGrothendieck P) :
    Presheaf.IsSheaf K₁.toGrothendieck P := fun E =>
  Presieve.isSheaf_of_le _ (toGrothendieck_le_of_tautEquiv K₁ K₂ h) (hP E)

/-- **Stacks 00VX (1)**, the equality: if tautological equivalence holds in both directions then
the categories of sheaves coincide. -/
@[stacks 00VX "(1)"]
theorem isSheaf_iff_of_tautEquiv (K₁ K₂ : Pretopology C)
    (h₁ : ∀ X (U : Presieve X), U ∈ K₁.coverings X → ∃ V ∈ K₂.coverings X,
        PreZeroHypercover.TautologicallyEquivalent U.preZeroHypercover V.preZeroHypercover)
    (h₂ : ∀ X (U : Presieve X), U ∈ K₂.coverings X → ∃ V ∈ K₁.coverings X,
        PreZeroHypercover.TautologicallyEquivalent U.preZeroHypercover V.preZeroHypercover)
    (P : Cᵒᵖ ⥤ Type t) :
    Presheaf.IsSheaf K₁.toGrothendieck P ↔ Presheaf.IsSheaf K₂.toGrothendieck P :=
  ⟨isSheaf_of_tautEquiv_subset K₂ K₁ h₂ P, isSheaf_of_tautEquiv_subset K₁ K₂ h₁ P⟩

/-- **Stacks 00VX (2)**, one inclusion: if every covering of `K₁` is refined by some covering of
`K₂`, then every `K₂`-sheaf is a `K₁`-sheaf. -/
@[stacks 00VX "(2)"]
theorem isSheaf_of_refines_subset (K₁ K₂ : Pretopology C)
    (h : ∀ X (U : Presieve X), U ∈ K₁.coverings X →
        ∃ V ∈ K₂.coverings X, Presieve.FactorsThru V U)
    (P : Cᵒᵖ ⥤ Type t) (hP : Presheaf.IsSheaf K₂.toGrothendieck P) :
    Presheaf.IsSheaf K₁.toGrothendieck P := fun E =>
  Presieve.isSheaf_of_le _ (toGrothendieck_le_of_refines K₁ K₂ h) (hP E)

/-- **Stacks 00VX (2)**, the equality: if mutual refinement holds in both directions then the
categories of sheaves coincide. -/
@[stacks 00VX "(2)"]
theorem isSheaf_iff_of_refines (K₁ K₂ : Pretopology C)
    (h₁ : ∀ X (U : Presieve X), U ∈ K₁.coverings X →
        ∃ V ∈ K₂.coverings X, Presieve.FactorsThru V U)
    (h₂ : ∀ X (U : Presieve X), U ∈ K₂.coverings X →
        ∃ V ∈ K₁.coverings X, Presieve.FactorsThru V U)
    (P : Cᵒᵖ ⥤ Type t) :
    Presheaf.IsSheaf K₁.toGrothendieck P ↔ Presheaf.IsSheaf K₂.toGrothendieck P :=
  ⟨isSheaf_of_refines_subset K₂ K₁ h₂ P, isSheaf_of_refines_subset K₁ K₂ h₁ P⟩

end CategoryTheory
