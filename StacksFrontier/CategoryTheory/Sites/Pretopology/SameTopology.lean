module

public import StacksFrontier.CategoryTheory.Sites.Pretopology.CombinatorialEquivalence
public import Mathlib.CategoryTheory.Sites.Sheaf
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Combinatorially equivalent covering data generate the same topology

Covering data `Cov` on a category assigns to every object a set of families of morphisms with
that target — Mathlib's `CategoryTheory.PreZeroHypercover` — and generates a Grothendieck
topology through the presieves of its families.

Stacks tag 00VY: if `Cov₁` and `Cov₂` are covering data contained in `Cov` such that every
family in `Cov` is combinatorially equivalent both to a family in `Cov₁` and to a family in
`Cov₂`, then `Cov₁` and `Cov₂` generate the same topology, and hence have the same sheaves.

## The index type is not a parameter of the covering data

Because `PreZeroHypercover` bundles its index type, covering data is `∀ U, Set (… U)` rather
than `∀ U I, Set (… U I)`. That is what the source means by "a set of families of morphisms
with fixed target": one set per object, whose members may be indexed by anything. Indexing the
sets themselves by the index type additionally requires the two families of a combinatorial
equivalence to have the *same* index type, which 00VU does not.

The site axioms then read off Mathlib's operations directly: the singleton identity family is
`PreZeroHypercover.singleton (𝟙 U)`, the pullback family is `pullback₂`, and the composite
family is `bind`.
-/

@[expose] public section

-- The three `IsSite` hypotheses below are the source's, and the proofs do not use them: the
-- generated topologies agree because the generated presieves do, whether or not the covering
-- data satisfy the site axioms. They are kept so that the tagged statements are the ones
-- 00VY makes — dropping them would state a strictly stronger lemma about arbitrary covering
-- data, which is a different claim from the source's.

namespace CategoryTheory.PreZeroHypercover

universe w v u

variable {C : Type u} [Category.{v} C]

/-- **Covering data** on `C`: for each object, a set of families of morphisms with that target.
-/
abbrev CovData (C : Type u) [Category.{v} C] : Type _ :=
  ∀ U : C, Set (PreZeroHypercover.{w, v, u} U)

/-- Pointwise inclusion of two pieces of covering data. -/
def CovData.Subset (Cov₁ Cov : CovData.{w, v, u} C) : Prop :=
  ∀ U : C, Cov₁ U ⊆ Cov U

variable [Limits.HasPullbacks C]

/-- The site axioms on covering data: the identity family covers, coverings pull back, and a
covering of each member of a covering composes to a covering. -/
@[sga "4 II 1.3"]
structure CovData.IsSite (Cov : CovData.{w, v, u} C) : Prop where
  /-- The one-element family `{𝟙 U}` is a covering of `U`. -/
  id_mem : ∀ U : C, singleton (𝟙 U) ∈ Cov U
  /-- The pullback of a covering along any morphism is a covering. -/
  pullback_mem : ∀ ⦃U V : C⦄ (f : V ⟶ U) (E : PreZeroHypercover.{w} U),
    E ∈ Cov U → E.pullback₂ f ∈ Cov V
  /-- A covering of each member of a covering composes to a covering. -/
  comp_mem : ∀ ⦃U : C⦄ (E : PreZeroHypercover.{w} U), E ∈ Cov U →
    ∀ (F : ∀ i, PreZeroHypercover.{w} (E.X i)), (∀ i, F i ∈ Cov (E.X i)) →
    E.bind F ∈ Cov U

/-- The presieves arising from the families of a piece of covering data. -/
def CovData.presieveCoverings (Cov : CovData.{w, v, u} C) (U : C) : Set (Presieve U) :=
  {R | ∃ E : PreZeroHypercover.{w} U, E ∈ Cov U ∧ E.presieve₀ = R}

/-- The Grothendieck topology generated by a piece of covering data. -/
@[sga "4 II 1.3.1" "more general"]
def CovData.toGrothendieck (Cov : CovData.{w, v, u} C) : GrothendieckTopology C :=
  sInf {J : GrothendieckTopology C |
    ∀ (U : C) (R : Presieve U), R ∈ Cov.presieveCoverings U → Sieve.generate R ∈ J U}

/-- The category `Sh(Cov)` of sheaves of sets for the topology generated by `Cov`. -/
abbrev Sh (Cov : CovData.{w, v, u} C) : Type _ :=
  Sheaf (CovData.toGrothendieck Cov) (Type w)

omit [Limits.HasPullbacks C] in
/-- If `Cov₁ ⊆ Cov` and `Cov₂ ⊆ Cov`, and every family in `Cov` is combinatorially equivalent
to one in `Cov₁` and to one in `Cov₂`, then the presieves arising from `Cov₁` and from `Cov₂`
are the same, because combinatorially equivalent families generate the same presieve. -/
lemma presieveCoverings_eq (Cov Cov₁ Cov₂ : CovData.{w, v, u} C)
    (hCov₁_sub : CovData.Subset Cov₁ Cov) (hCov₂_sub : CovData.Subset Cov₂ Cov)
    (h₁ : ∀ ⦃U : C⦄ ⦃E : PreZeroHypercover.{w} U⦄, E ∈ Cov U →
      ∃ F : PreZeroHypercover.{w} U, F ∈ Cov₁ U ∧ CombinatoriallyEquivalent E F)
    (h₂ : ∀ ⦃U : C⦄ ⦃E : PreZeroHypercover.{w} U⦄, E ∈ Cov U →
      ∃ F : PreZeroHypercover.{w} U, F ∈ Cov₂ U ∧ CombinatoriallyEquivalent E F) :
    ∀ U : C, Cov₁.presieveCoverings U = Cov₂.presieveCoverings U := by
  intro U
  ext R
  refine ⟨fun ⟨E, hE, hpre⟩ => ?_, fun ⟨E, hE, hpre⟩ => ?_⟩
  · obtain ⟨F, hF, hCE⟩ := h₂ (hCov₁_sub U hE)
    exact ⟨F, hF, (presieve₀_eq_of_combinatoriallyEquivalent hCE).symm.trans hpre⟩
  · obtain ⟨F, hF, hCE⟩ := h₁ (hCov₂_sub U hE)
    exact ⟨F, hF, (presieve₀_eq_of_combinatoriallyEquivalent hCE).symm.trans hpre⟩

/-- **Stacks 00VY**, topology form: covering data inside `Cov` that both capture every family
of `Cov` up to combinatorial equivalence generate the same Grothendieck topology. -/
theorem toGrothendieck_eq (Cov Cov₁ Cov₂ : CovData.{w, v, u} C)
    (_hCov_site : Cov.IsSite) (_hCov₁_site : Cov₁.IsSite) (_hCov₂_site : Cov₂.IsSite)
    (hCov₁_sub : CovData.Subset Cov₁ Cov) (hCov₂_sub : CovData.Subset Cov₂ Cov)
    (h₁ : ∀ ⦃U : C⦄ ⦃E : PreZeroHypercover.{w} U⦄, E ∈ Cov U →
      ∃ F : PreZeroHypercover.{w} U, F ∈ Cov₁ U ∧ CombinatoriallyEquivalent E F)
    (h₂ : ∀ ⦃U : C⦄ ⦃E : PreZeroHypercover.{w} U⦄, E ∈ Cov U →
      ∃ F : PreZeroHypercover.{w} U, F ∈ Cov₂ U ∧ CombinatoriallyEquivalent E F) :
    CovData.toGrothendieck Cov₁ = CovData.toGrothendieck Cov₂ := by
  simp [CovData.toGrothendieck,
    presieveCoverings_eq Cov Cov₁ Cov₂ hCov₁_sub hCov₂_sub h₁ h₂]

/-- **Stacks 00VY**, presheaf form: under the hypotheses of `toGrothendieck_eq` a presheaf is a
sheaf for the topology generated by `Cov₁` exactly when it is one for `Cov₂`. -/
theorem isSheaf_iff (Cov Cov₁ Cov₂ : CovData.{w, v, u} C)
    (hCov_site : Cov.IsSite) (hCov₁_site : Cov₁.IsSite) (hCov₂_site : Cov₂.IsSite)
    (hCov₁_sub : CovData.Subset Cov₁ Cov) (hCov₂_sub : CovData.Subset Cov₂ Cov)
    (h₁ : ∀ ⦃U : C⦄ ⦃E : PreZeroHypercover.{w} U⦄, E ∈ Cov U →
      ∃ F : PreZeroHypercover.{w} U, F ∈ Cov₁ U ∧ CombinatoriallyEquivalent E F)
    (h₂ : ∀ ⦃U : C⦄ ⦃E : PreZeroHypercover.{w} U⦄, E ∈ Cov U →
      ∃ F : PreZeroHypercover.{w} U, F ∈ Cov₂ U ∧ CombinatoriallyEquivalent E F)
    (P : Cᵒᵖ ⥤ Type w) :
    Presheaf.IsSheaf (CovData.toGrothendieck Cov₁) P ↔
      Presheaf.IsSheaf (CovData.toGrothendieck Cov₂) P := by
  rw [toGrothendieck_eq Cov Cov₁ Cov₂ hCov_site hCov₁_site hCov₂_site hCov₁_sub hCov₂_sub h₁ h₂]

/-- **Stacks 00VY** as stated there: the two pieces of covering data have literally the same
category of sheaves, `Sh Cov₁ = Sh Cov₂`. -/
@[stacks 00VY]
theorem sh_eq (Cov Cov₁ Cov₂ : CovData.{w, v, u} C)
    (hCov_site : Cov.IsSite) (hCov₁_site : Cov₁.IsSite) (hCov₂_site : Cov₂.IsSite)
    (hCov₁_sub : CovData.Subset Cov₁ Cov) (hCov₂_sub : CovData.Subset Cov₂ Cov)
    (h₁ : ∀ ⦃U : C⦄ ⦃E : PreZeroHypercover.{w} U⦄, E ∈ Cov U →
      ∃ F : PreZeroHypercover.{w} U, F ∈ Cov₁ U ∧ CombinatoriallyEquivalent E F)
    (h₂ : ∀ ⦃U : C⦄ ⦃E : PreZeroHypercover.{w} U⦄, E ∈ Cov U →
      ∃ F : PreZeroHypercover.{w} U, F ∈ Cov₂ U ∧ CombinatoriallyEquivalent E F) :
    Sh Cov₁ = Sh Cov₂ :=
  -- `Sh` is an `abbrev`, so `rw` cannot see the topology inside it; `congrArg` can.
  congrArg (fun J => Sheaf J (Type w))
    (toGrothendieck_eq Cov Cov₁ Cov₂ hCov_site hCov₁_site hCov₂_site hCov₁_sub hCov₂_sub h₁ h₂)

end CategoryTheory.PreZeroHypercover
