module

public import StacksFrontier.CategoryTheory.Sites.Pretopology.ComapGeneratedTopology

/-!
# Raising the morphism universe of a site

A site whose objects live in a higher universe than its morphisms — the small affine étale site of
a scheme, `AlgebraicGeometry.SmallAffineEtale B S hS : Type (u + 1)` with `Category.{u}`, is the
example this file is written for — is not a `CategoryTheory.SmallCategory`, and the theorems of
the Stacks project that are stated for small sites do not apply to it verbatim. The standard
repair is `CategoryTheory.AsSmall`, which raises the morphism universe; the topology comes along
as `CategoryTheory.Precoverage.comap CategoryTheory.AsSmall.down` of the original precoverage.

This file shows that the raise is harmless: `AsSmall.up` is the inclusion of a *dense subsite* in
the sense of `CategoryTheory.Functor.IsDenseSubsite`, for the original topology on the source and
the generated topology of the comapped precoverage on the target. Everything a dense subsite
inclusion gives — continuity, cocontinuity, and an equivalence of sheaf categories by
`CategoryTheory.Functor.IsDenseSubsite.sheafEquiv` — is therefore available across the raise.

## Main results

* `CategoryTheory.AsSmall.surjective_down_obj`, `CategoryTheory.AsSmall.surjective_up_obj` — both
  halves of the equivalence are surjective on objects, on the nose.
* `CategoryTheory.AsSmall.functorPushforward_up_down` — pushing a sieve up and then down again is
  the identity.
* `CategoryTheory.AsSmall.mem_comap_toGrothendieck_iff` — a sieve of the raised site is covering
  exactly when the sieve it comes from is.
* `CategoryTheory.AsSmall.isDenseSubsite_up` — **`AsSmall.up` is a dense subsite inclusion of
  sites.**
* `CategoryTheory.AsSmall.isDenseSubsite_up_inducedTopology` — the same for the other spelling of
  the raised topology, the one induced along `CategoryTheory.AsSmall.down`.
* With `CategoryTheory.AsSmall.isDenseSubsite_up` as an instance, restriction along `AsSmall.up`
  is an equivalence on sheaves with values in any category with the needed limits, by Mathlib's
  `IsEquivalence` instance for `sheafPushforwardContinuous` along a dense subsite inclusion.

## Implementation notes

The content is `CategoryTheory.Precoverage.mem_toGrothendieck_comap_iff`, which needs
`AsSmall.down` to be fully faithful and surjective on objects and nothing else — in particular no
stability property of the precoverage. The passage from `AsSmall.down` to `AsSmall.up` is
`CategoryTheory.Sieve.functorPushforward_equivalence_eq_pullback` at the unit of
`CategoryTheory.AsSmall.equiv`, which is the identity.
-/

@[expose] public section

namespace CategoryTheory.AsSmall

open CategoryTheory Limits

universe w v u

variable {C : Type u} [Category.{v} C]

/-- `AsSmall.down` is surjective on objects: the object it sends `⟨X⟩` to is `X`. -/
theorem surjective_down_obj :
    Function.Surjective (AsSmall.down : AsSmall.{w} C ⥤ C).obj :=
  fun X => ⟨⟨X⟩, rfl⟩

/-- `AsSmall.up` is surjective on objects. -/
theorem surjective_up_obj :
    Function.Surjective (AsSmall.up : C ⥤ AsSmall.{w} C).obj :=
  fun Z => ⟨ULift.down Z, rfl⟩

/-- `AsSmall.up` is full, being the functor of the equivalence `CategoryTheory.AsSmall.equiv`. -/
instance full_up : (AsSmall.up : C ⥤ AsSmall.{w} C).Full :=
  inferInstanceAs ((AsSmall.equiv : C ≌ AsSmall.{w} C).functor.Full)

/-- `AsSmall.up` is faithful, being the functor of the equivalence
`CategoryTheory.AsSmall.equiv`. -/
instance faithful_up : (AsSmall.up : C ⥤ AsSmall.{w} C).Faithful :=
  inferInstanceAs ((AsSmall.equiv : C ≌ AsSmall.{w} C).functor.Faithful)

/-- `AsSmall.down` is full, being the inverse of the equivalence `CategoryTheory.AsSmall.equiv`. -/
instance full_down : (AsSmall.down : AsSmall.{w} C ⥤ C).Full :=
  inferInstanceAs ((AsSmall.equiv : C ≌ AsSmall.{w} C).inverse.Full)

/-- `AsSmall.down` is faithful, being the inverse of the equivalence
`CategoryTheory.AsSmall.equiv`. -/
instance faithful_down : (AsSmall.down : AsSmall.{w} C ⥤ C).Faithful :=
  inferInstanceAs ((AsSmall.equiv : C ≌ AsSmall.{w} C).inverse.Faithful)

/-- The unit of `CategoryTheory.AsSmall.equiv` is the identity. -/
@[simp]
theorem equiv_unitInv_app (X : C) :
    (AsSmall.equiv : C ≌ AsSmall.{w} C).unitInv.app X = 𝟙 X :=
  rfl

/-- **Pushing a sieve up to the raised site and back down again is the identity.** -/
theorem functorPushforward_up_down {X : C} (S : Sieve X) :
    (S.functorPushforward (AsSmall.up : C ⥤ AsSmall.{w} C)).functorPushforward AsSmall.down
      = S :=
  (Sieve.functorPushforward_equivalence_eq_pullback
    (AsSmall.equiv : C ≌ AsSmall.{w} C) S).trans Sieve.pullback_id

variable (P : Precoverage C)

/-- **A sieve of the raised site is covering exactly when the sieve it comes from is.** The
topology of the raised site is generated by `Precoverage.comap AsSmall.down` of the original
precoverage, and transporting sieves along the raise commutes with generating a topology. -/
theorem mem_comap_toGrothendieck_iff {Z : AsSmall.{w} C} (S : Sieve Z) :
    S ∈ (P.comap (AsSmall.down : AsSmall.{w} C ⥤ C)).toGrothendieck Z ↔
      S.functorPushforward AsSmall.down ∈ P.toGrothendieck (AsSmall.down.obj Z) :=
  Precoverage.mem_toGrothendieck_comap_iff
    (AsSmall.down : AsSmall.{w} C ⥤ C) surjective_down_obj P

/-- A fully faithful functor surjective on objects is a dense subsite inclusion as soon as covering
sieves correspond under pushforward. -/
private theorem isDenseSubsite_of_surjective_obj {D : Type*} [Category D] (F : C ⥤ D) [F.Full]
    [F.Faithful] (hF : Function.Surjective F.obj) {J : GrothendieckTopology C}
    {K : GrothendieckTopology D}
    (h : ∀ {X : C} {S : Sieve X}, S.functorPushforward F ∈ K _ ↔ S ∈ J _) :
    F.IsDenseSubsite J K :=
  have := Precoverage.isEquivalence_of_surjective_obj F hF
  { functorPushforward_mem_iff := h }

/-- **`AsSmall.up` is the inclusion of a dense subsite**, from the original site to the raised
one: it is fully faithful, it is cover dense because it is an equivalence, and a sieve is covering
upstairs exactly when its image is covering downstairs, which is
`CategoryTheory.AsSmall.mem_comap_toGrothendieck_iff` read through
`CategoryTheory.AsSmall.functorPushforward_up_down`. -/
theorem isDenseSubsite_up :
    (AsSmall.up : C ⥤ AsSmall.{w} C).IsDenseSubsite P.toGrothendieck
      (P.comap AsSmall.down).toGrothendieck :=
  isDenseSubsite_of_surjective_obj _ surjective_up_obj fun {X S} => by
    rw [mem_comap_toGrothendieck_iff P, functorPushforward_up_down]
    exact Iff.rfl

/-- **`AsSmall.down` is the inclusion of a dense subsite**, from the raised site to the original
one. This is the direction needed to exhibit the raised site as a *small model* of the original
one: a model of a site `A` is a small category `C` together with a functor `C ⥤ A` which is an
equivalence and a dense subsite inclusion, and for the raise that functor is `AsSmall.down`, not
`AsSmall.up`.

Its proof is `CategoryTheory.AsSmall.mem_comap_toGrothendieck_iff` read backwards: the condition
`CategoryTheory.Functor.IsDenseSubsite.functorPushforward_mem_iff` asks for is exactly that
equivalence, with no need of `CategoryTheory.AsSmall.functorPushforward_up_down`. -/
theorem isDenseSubsite_down :
    (AsSmall.down : AsSmall.{w} C ⥤ C).IsDenseSubsite (P.comap AsSmall.down).toGrothendieck
      P.toGrothendieck :=
  isDenseSubsite_of_surjective_obj _ surjective_down_obj fun {_ S} =>
    (mem_comap_toGrothendieck_iff P S).symm

attribute [local instance] isDenseSubsite_up

/-- **`AsSmall.up` is the inclusion of a dense subsite** when the raised site carries the topology
induced from the original one along `CategoryTheory.AsSmall.down`, which is the other spelling of
the raised topology in use — `Stacks.EtaleCohomology.MayerVietoris.topology` is written this way.

The argument is the one of `CategoryTheory.AsSmall.isDenseSubsite_up`, with
`CategoryTheory.Functor.mem_inducedTopology_iff_of_isCoverDense` in place of
`CategoryTheory.AsSmall.mem_comap_toGrothendieck_iff`. Mathlib's instance for an equivalence of
categories does not fire at this spelling: it is stated for `e.functor` of an
`CategoryTheory.Equivalence`, and recognizing `AsSmall.up` as `AsSmall.equiv.functor` is beyond
instance search. -/
theorem isDenseSubsite_up_inducedTopology (J : GrothendieckTopology C) :
    (AsSmall.up : C ⥤ AsSmall.{w} C).IsDenseSubsite J
      ((AsSmall.down : AsSmall.{w} C ⥤ C).inducedTopology J) := by
  have := Precoverage.isEquivalence_of_surjective_obj
    (AsSmall.down : AsSmall.{w} C ⥤ C) surjective_down_obj
  exact isDenseSubsite_of_surjective_obj _ surjective_up_obj fun {X S} => by
    rw [Functor.mem_inducedTopology_iff_of_isCoverDense, functorPushforward_up_down]
    exact Iff.rfl

end CategoryTheory.AsSmall

end
