module

public import Mathlib.Algebra.Category.Grp.Ulift
public import Mathlib.CategoryTheory.Adjunction.Restrict
public import Mathlib.CategoryTheory.Sites.Over
public import Mathlib.CategoryTheory.Sites.PreservesLocallyBijective
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.AssociatedSheafIsos
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.PushforwardExact

/-!
# Sheafification of abelian groups descends from the slice sites

Let `(C, J)` be a site with `C : Type u` and `Category.{v} C`, and let `w` be a universe with no
relation to `max u v`.  Sheafification of `AddCommGrpCat.{w}`-valued presheaves on `(C, J)` is
known to exist when `max u v ≤ w`
(`CategoryTheory.GrothendieckTopology.hasSheafify_addCommGrpCat`), and for a *small* `w` there is
no reason for it to exist at all.  This file supplies the one remaining case that arises in
practice: if sheafification exists at `w` on every **slice** site `(C/X, J/X)` and inverts
exactly the locally bijective morphisms there, then it exists on `(C, J)` and inverts exactly
the locally bijective morphisms there too.

The hypotheses are not artificial.  A ringed site or ringed topos comes with its structure sheaf
in some section universe `w`, and local conditions on its sheaves of modules — being of finite
type, of finite presentation, locally generated by `r` sections — are read on the slice sites, so
the slice instances are exactly the ones such a statement already carries.  What this file
removes is the need to assume the global ones as well.

## Main results

* `CategoryTheory.GrothendieckTopology.hasWeakSheafify_addCommGrpCat_of_over`: sheafification of
  `AddCommGrpCat.{w}`-valued presheaves exists on `(C, J)` as soon as it exists on every slice.
* `CategoryTheory.GrothendieckTopology.wEqualsLocallyBijective_addCommGrpCat_of_over`: and it
  inverts exactly the locally bijective morphisms.

## Implementation notes

Both proofs run through the large universe `max u v w`, where sheafification is unconditionally
available.  Write `U : AddCommGrpCat.{w} ⥤ AddCommGrpCat.{max u v w}` for the universe lift.
The content is that the composite

`(Cᵒᵖ ⥤ AddCommGrpCat.{w}) ⟶ (Cᵒᵖ ⥤ AddCommGrpCat.{max u v w}) ⟶ Sheaf J AddCommGrpCat.{max u v w}`

of lifting with large sheafification lands in the essential image of `sheafCompose J U`, i.e. the
large sheafification of a lifted presheaf is again a lift.  Granting that, lifting and
`sheafCompose J U` are both fully faithful, so `Adjunction.restrictFullyFaithful` cuts the large
sheafification adjunction down to the small one.

That the large sheafification of a lifted presheaf is a lift is checked one object `X` of the site
at a time, and this is where the slice hypotheses enter: restricted to `C/X`, both the large
sheafification of the lift and the lift of the *slice* sheafification are morphisms out of the
restricted presheaf which are local for the sheaf condition and whose targets are sheaves, so
`isoOfLocalMaps` identifies their targets.  The second of them is a lift by construction, so the
first is as well, and its value at the terminal object of `C/X` is the value of the original at
`X`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe w v u

namespace CategoryTheory

/-- **Two local morphisms out of a common source into local objects have isomorphic targets.**
If `a : X ⟶ Y` and `b : X ⟶ Z` are both `P`-local — precomposition with either is a bijection on
morphisms into any object satisfying `P` — and `Y` and `Z` both satisfy `P`, then `Y ≅ Z`.  This
is the uniqueness half of a localization, and it is how two different constructions of a
sheafification are identified. -/
noncomputable def ObjectProperty.isoOfLocalMaps {D : Type*} [Category* D]
    (P : ObjectProperty D) {X Y Z : D} (a : X ⟶ Y) (b : X ⟶ Z)
    (ha : P.isLocal a) (hb : P.isLocal b) (hY : P Y) (hZ : P Z) : Y ≅ Z := by
  let e := ha.homEquiv Z hZ
  let d := hb.homEquiv Y hY
  have he : a ≫ e.symm b = b := e.apply_symm_apply b
  have hd : b ≫ d.symm a = a := d.apply_symm_apply a
  refine ⟨e.symm b, d.symm a, ?_, ?_⟩
  · apply (ha Y hY).1
    change a ≫ e.symm b ≫ d.symm a = a ≫ 𝟙 Y
    rw [← Category.assoc, he, hd, Category.comp_id]
  · apply (hb Z hZ).1
    change b ≫ d.symm a ≫ e.symm b = b ≫ 𝟙 Z
    rw [← Category.assoc, hd, he, Category.comp_id]

namespace GrothendieckTopology

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)

/-- A sheaf of abelian groups all of whose values are universe lifts is itself the lift of a
sheaf. -/
private lemma essImage_sheafCompose_uliftFunctor (Q : Sheaf J AddCommGrpCat.{max u v w})
    (h : ∀ X, AddCommGrpCat.uliftFunctor.{max u v, w}.essImage (Q.obj.obj X)) :
    (sheafCompose J AddCommGrpCat.uliftFunctor.{max u v, w}).essImage Q := by
  let U := AddCommGrpCat.uliftFunctor.{max u v, w}
  let P := Functor.essImage.liftFunctor Q.obj U h
  let e : P ⋙ U ≅ Q.obj := Functor.essImage.liftFunctorCompIso Q.obj U h
  exact ⟨⟨P, Presheaf.isSheaf_of_isSheaf_comp J P U ((Presheaf.isSheaf_of_iso_iff e).2 Q.property)⟩,
    ⟨ObjectProperty.isoMk _ e⟩⟩

variable [∀ X : C, HasWeakSheafify (J.over X) AddCommGrpCat.{w}]
  [∀ X : C, (J.over X).WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- The large sheafification of a universe lift is again a universe lift.  Object by object the
comparison is `ObjectProperty.isoOfLocalMaps` between the restriction to a slice site of the
large sheafification and the lift of the slice sheafification. -/
private lemma essImage_sheafify_uliftFunctor [HasSheafify J AddCommGrpCat.{max u v w}]
    (P : Cᵒᵖ ⥤ AddCommGrpCat.{w}) :
    (sheafCompose J AddCommGrpCat.uliftFunctor.{max u v, w}).essImage
      ((presheafToSheaf J AddCommGrpCat.{max u v w}).obj
        (P ⋙ AddCommGrpCat.uliftFunctor.{max u v, w})) := by
  have : J.WEqualsLocallyBijective AddCommGrpCat.{max u v w} :=
    wEqualsLocallyBijective_addCommGrpCat.{max u v w} J
  let U := AddCommGrpCat.uliftFunctor.{max u v, w}
  let Q := (presheafToSheaf J AddCommGrpCat.{max u v w}).obj (P ⋙ U)
  apply essImage_sheafCompose_uliftFunctor J Q
  intro X
  have : (J.over X.unop).WEqualsLocallyBijective AddCommGrpCat.{max u v w} :=
    wEqualsLocallyBijective_addCommGrpCat.{max u v w} (J.over X.unop)
  let P₀ := (Over.forget X.unop).op ⋙ P
  let Q₀ := (presheafToSheaf (J.over X.unop) AddCommGrpCat.{w}).obj P₀
  let a := Functor.whiskerLeft (Over.forget X.unop).op (_root_.CategoryTheory.toSheafify J (P ⋙ U))
  let b := Functor.whiskerRight (_root_.CategoryTheory.toSheafify (J.over X.unop) P₀) U
  have ha : (J.over X.unop).W a := by
    have : Presheaf.IsLocallyInjective (J.over X.unop) a :=
      Presheaf.isLocallyInjective_whisker (J.over X.unop) J (Over.forget X.unop) _
    have : Presheaf.IsLocallySurjective (J.over X.unop) a :=
      Presheaf.isLocallySurjective_whisker (J.over X.unop) J (Over.forget X.unop) _
    exact (J.over X.unop).W_of_isLocallyBijective a
  have hb : (J.over X.unop).W b := by
    have : Presheaf.IsLocallyInjective (J.over X.unop) b :=
      Presheaf.isLocallyInjective_whiskerRight_uliftFunctor (J.over X.unop)
        (_root_.CategoryTheory.toSheafify (J.over X.unop) P₀)
    have : Presheaf.IsLocallySurjective (J.over X.unop) b :=
      Presheaf.isLocallySurjective_whiskerRight_uliftFunctor (J.over X.unop)
        (_root_.CategoryTheory.toSheafify (J.over X.unop) P₀)
    exact (J.over X.unop).W_of_isLocallyBijective b
  let e := ObjectProperty.isoOfLocalMaps (Presheaf.IsSheaf (J.over X.unop)) a b ha hb
    (Q.over X.unop).property ((sheafCompose (J.over X.unop) U).obj Q₀).property
  exact ⟨Q₀.obj.obj (op (Over.mk (𝟙 X.unop))), ⟨(e.app (op (Over.mk (𝟙 X.unop)))).symm⟩⟩

/-- The restricted sheafification adjunction: a left adjoint `L` to the forgetful functor on
sheaves, together with an isomorphism exhibiting the large sheafification of lifts as `L` followed
by the lift of sheaves. -/
private lemma exists_adjunction_iso_sheafCompose_uliftFunctor
    [HasSheafify J AddCommGrpCat.{max u v w}] :
    ∃ (L : (Cᵒᵖ ⥤ AddCommGrpCat.{w}) ⥤ Sheaf J AddCommGrpCat.{w})
      (_ : ((Functor.whiskeringRight Cᵒᵖ _ _).obj AddCommGrpCat.uliftFunctor.{max u v, w} ⋙
        presheafToSheaf J AddCommGrpCat.{max u v w}) ≅
          L ⋙ sheafCompose J AddCommGrpCat.uliftFunctor.{max u v, w}),
      Nonempty (L ⊣ sheafToPresheaf J AddCommGrpCat.{w}) := by
  let U := AddCommGrpCat.uliftFunctor.{max u v, w}
  let iP := (Functor.whiskeringRight Cᵒᵖ _ _).obj U
  let iS := sheafCompose J U
  let G := iP ⋙ presheafToSheaf J AddCommGrpCat.{max u v w}
  have h (P) : iS.essImage (G.obj P) := essImage_sheafify_uliftFunctor J P
  let e : G ≅ Functor.essImage.liftFunctor G iS h ⋙ iS :=
    (Functor.essImage.liftFunctorCompIso G iS h).symm
  exact ⟨_, e, ⟨(sheafificationAdjunction J AddCommGrpCat.{max u v w}).restrictFullyFaithful
    (Functor.FullyFaithful.ofFullyFaithful iP)
    (Functor.FullyFaithful.ofFullyFaithful iS) e (Iso.refl _)⟩⟩

/-- **Sheafification of presheaves of abelian groups descends from the slice sites.**  If
`AddCommGrpCat.{w}`-valued presheaves on every slice site `(C/X, J/X)` have a sheafification
inverting exactly the locally bijective morphisms, then they have one on `(C, J)`, with no
relation assumed between `w` and the universes of the site. -/
theorem hasWeakSheafify_addCommGrpCat_of_over : HasWeakSheafify J AddCommGrpCat.{w} := by
  have : HasSheafify J AddCommGrpCat.{max u v w} := hasSheafify_addCommGrpCat.{max u v w} J
  obtain ⟨_, _, ⟨adj⟩⟩ := exists_adjunction_iso_sheafCompose_uliftFunctor.{w} J
  exact adj.isRightAdjoint

/-- **Sheafification of presheaves of abelian groups inverts exactly the locally bijective
morphisms as soon as it does so on the slice sites.**  The class `J.W` is read off the restricted
adjunction, and lifting the universe of the sections changes neither local injectivity nor local
surjectivity.

This has the same *conclusion* as `wEqualsLocallyBijective_addCommGrpCat` but incomparable
hypotheses, which is why both exist and neither is redundant: that one assumes
`UnivLE.{max u v, w}`, i.e. that the sections are large enough to contain the site, whereas this
one assumes the sheafification instances on the slice sites and says nothing relating `w` to
`max u v`. Neither set of hypotheses implies the other, and this statement is what covers the
case `max u v ≤ w` fails — it is proved *using* the other one at the larger universe
`max u v w`. -/
theorem wEqualsLocallyBijective_addCommGrpCat_of_over :
    J.WEqualsLocallyBijective AddCommGrpCat.{w} := by
  have : HasSheafify J AddCommGrpCat.{max u v w} := hasSheafify_addCommGrpCat.{max u v w} J
  have : J.WEqualsLocallyBijective AddCommGrpCat.{max u v w} :=
    wEqualsLocallyBijective_addCommGrpCat.{max u v w} J
  let U := AddCommGrpCat.uliftFunctor.{max u v, w}
  let iP := (Functor.whiskeringRight Cᵒᵖ _ _).obj U
  let iS := sheafCompose J U
  let G := iP ⋙ presheafToSheaf J AddCommGrpCat.{max u v w}
  obtain ⟨L, e, ⟨adj⟩⟩ := exists_adjunction_iso_sheafCompose_uliftFunctor.{w} J
  change G ≅ L ⋙ iS at e
  refine ⟨fun {P Q} f => ?_⟩
  rw [J.W_iff_isIso_map_of_adjunction adj, ← isIso_iff_of_reflects_iso (L.map f) iS]
  have he : iS.map (L.map f) = e.inv.app P ≫ G.map f ≫ e.hom.app Q := by
    rw [e.hom.naturality]
    simp
  rw [he, isIso_comp_left_iff, isIso_comp_right_iff]
  change IsIso ((presheafToSheaf J AddCommGrpCat.{max u v w}).map
    (Functor.whiskerRight f U)) ↔ _
  rw [← J.W_iff, J.W_iff_isLocallyBijective]
  refine ⟨fun ⟨hi, hs⟩ => ⟨⟨fun {X} x y hxy => ?_⟩, ⟨fun {X} x => ?_⟩⟩, fun ⟨_, _⟩ =>
    ⟨Presheaf.isLocallyInjective_whiskerRight_uliftFunctor J f,
      Presheaf.isLocallySurjective_whiskerRight_uliftFunctor J f⟩⟩
  · convert hi.equalizerSieve_mem (ULift.up x) (ULift.up y) (congrArg ULift.up hxy) using 1
    ext V i
    exact ULift.ext_iff.symm
  · refine J.superset_covering ?_ (hs.imageSieve_mem (ULift.up x))
    rintro V i ⟨y, hy⟩
    exact ⟨y.down, congrArg ULift.down hy⟩

end GrothendieckTopology

end CategoryTheory

end
