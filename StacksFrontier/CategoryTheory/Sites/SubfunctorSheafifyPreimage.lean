module

public import Mathlib.CategoryTheory.Sites.Subsheaf
public import Mathlib.CategoryTheory.Subfunctor.Image

/-!
# The subsheaf generated by a subfunctor commutes with inverse images

Let `p : F' ⟶ F` be a morphism of type-valued presheaves on a category `C` carrying a
Grothendieck topology `J`, and let `G` be a subfunctor of `F`. The inverse image
`CategoryTheory.Subfunctor.preimage`, whose sections over an object are those sections of `F'`
which `p` carries into `G`, commutes with the subsheaf `CategoryTheory.Subfunctor.sheafify`
generated by a subfunctor: the sieve of arrows along which a section of `F'` restricts into the
inverse image of `G` is the sieve of arrows along which its image restricts into `G`.

In particular the inverse image of a subsheaf of a sheaf along a morphism of sheaves is again a
subsheaf, which is how the fibre product of a morphism of sheaves with a subsheaf of its target
is recognised as a sheaf. (That it *is* the fibre product is Stacks 083Q,
`CategoryTheory.Subfunctor.isPullback_preimage`.)

## Main results

* `CategoryTheory.Subfunctor.sieveOfSection_preimage`: the sieve of a section for the inverse
  image is the sieve of its image for the original subfunctor.
* `CategoryTheory.Subfunctor.preimage_sheafify`: the inverse image commutes with `sheafify`.
* `CategoryTheory.Subfunctor.isSheaf_preimage`: the inverse image of a subsheaf along a morphism
  of sheaves is a subsheaf.
-/

@[expose] public section

open Opposite CategoryTheory

universe w v u

namespace CategoryTheory.Subfunctor

variable {C : Type u} [Category.{v} C] {F F' : Cᵒᵖ ⥤ Type w}

/-- The sieve of arrows along which a section of `F'` restricts into the inverse image of a
subfunctor `G` is the sieve of arrows along which its image restricts into `G`. -/
theorem sieveOfSection_preimage (G : Subfunctor F) (p : F' ⟶ F) {U : Cᵒᵖ} (x : F'.obj U) :
    (G.preimage p).sieveOfSection x = G.sieveOfSection (p.app U x) := by
  ext V i
  show p.app _ (F'.map i.op x) ∈ G.obj _ ↔ F.map i.op (p.app U x) ∈ G.obj _
  rw [NatTrans.naturality_apply]

/-- **The subsheaf generated by a subfunctor commutes with inverse images.** -/
theorem preimage_sheafify' (J : GrothendieckTopology C) (G : Subfunctor F) (p : F' ⟶ F) :
    (G.preimage p).sheafify J = (G.sheafify J).preimage p := by
  ext U x
  show (G.preimage p).sieveOfSection x ∈ J (unop U) ↔
    G.sieveOfSection (p.app U x) ∈ J (unop U)
  rw [sieveOfSection_preimage]

/-- **The inverse image of a subsheaf along a morphism of sheaves is a subsheaf.** -/
theorem isSheaf_preimage {J : GrothendieckTopology C} (G : Subfunctor F) (p : F' ⟶ F)
    (hF : Presieve.IsSheaf J F) (hF' : Presieve.IsSheaf J F')
    (hG : Presieve.IsSheaf J G.toFunctor) :
    Presieve.IsSheaf J (G.preimage p).toFunctor := by
  rw [← (G.preimage p).eq_sheafify_iff hF', preimage_sheafify',
    ← (G.eq_sheafify_iff hF).mpr hG]

end CategoryTheory.Subfunctor

end
