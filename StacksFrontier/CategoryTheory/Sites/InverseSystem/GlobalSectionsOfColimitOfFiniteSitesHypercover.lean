universe u₁ u₂ w v₁ v₂ v₃ v₄ t₁ t₂

namespace Stacks.WeakSites.ColimitGlobalSections

section Hypercover

variable {C : Type v₁} [Category.{v₂} C] (J : GrothendieckTopology C)

/-- **A finite one-hypercover of the terminal sheaf, on a site whose category need not be
small.** This is `Stacks.WeakSites.ColimitGlobalSections.IsTopOneHypercover` without the
smallness of the underlying category, which the sites of the étale development need. The
objects `W k` jointly cover the terminal sheaf, and any two morphisms into members of the family
factor, locally on the source,
through one of the objects `P k l m`. Think of the `W k` as a finite affine cover of a
quasi-compact scheme and of the `P k l m` as a finite affine cover of the intersection of `W k`
and `W l`, which exists when the scheme is quasi-separated; the `P k l m` stand in for a fibre
product `W k × W l`, which a site of affine objects need not contain. -/
structure IsTopOneHypercoverOn {κ ν : Type*} (W : κ → C) (P : κ → κ → ν → C)
    (p₁ : ∀ k l m, P k l m ⟶ W k) (p₂ : ∀ k l m, P k l m ⟶ W l) : Prop where
  /-- The objects `W k` jointly cover the terminal sheaf. -/
  coversTop : J.CoversTop W
  /-- Any two morphisms into members of the family locally factor through some `P k l m`. -/
  locally_factors : ∀ (Z : C) (k l : κ) (f : Z ⟶ W k) (g : Z ⟶ W l),
    ∃ S : Sieve Z, S ∈ J Z ∧ ∀ ⦃V : C⦄ (q : V ⟶ Z), S.arrows q →
      ∃ (m : ν) (r : V ⟶ P k l m),
        q ≫ f = r ≫ p₁ k l m ∧ q ≫ g = r ≫ p₂ k l m

/-- **The hypothesis of
`Stacks.WeakSites.ColimitGlobalSections.IsTopOneHypercover.of_equiv`, from a correspondence of
covering PRESIEVES.** If covering presieves correspond across an equivalence of sites, then a
covering *sieve* of `e.functor.obj Z` pulls back to a covering sieve of `Z`.

This is what makes the transport usable. A geometric identification of the topology of a site of
representatives with the topology of the site it represents is naturally stated on presieves --
"a family covers at the level exactly when its image covers" -- because that is the form in which
a topology generated by covering families is given. The transport, on the other hand, needs
arbitrary covering sieves, and a covering sieve of a generated topology is one of the inductively
defined `CategoryTheory.Precoverage.Saturate`, not the sieve generated by a covering family. No
induction over that is needed: a sieve is downward closed, so every arrow of `S` factors through
the image under `e.functor` of an arrow of the pullback of `S`, whence `S` is contained in the
sieve generated by that image, and the presieve correspondence applies to the pullback's own
arrows. -/
theorem functorPullback_mem_of_map_mem_toPrecoverage {C₂ : Type v₃} [Category.{v₄} C₂]
    {J₂ : GrothendieckTopology C₂} (e : C ≌ C₂)
    (he : ∀ (Z : C) (R : Presieve Z),
      R.map e.functor ∈ J₂.toPrecoverage (e.functor.obj Z) → R ∈ J.toPrecoverage Z)
    (Z : C) (S : Sieve (e.functor.obj Z)) (hS : S ∈ J₂ (e.functor.obj Z)) :
    S.functorPullback e.functor ∈ J Z := by
  rw [← Sieve.generate_sieve (S.functorPullback e.functor),
    ← GrothendieckTopology.mem_toPrecoverage_iff]
  refine he Z _ ?_
  rw [GrothendieckTopology.mem_toPrecoverage_iff]
  refine J₂.superset_covering ?_ hS
  intro V f hf
  have hmem : (S.functorPullback e.functor).arrows (e.inverse.map f ≫ e.unitInv.app Z) := by
    show S (e.functor.map (e.inverse.map f ≫ e.unitInv.app Z))
    have heq : e.functor.map (e.inverse.map f ≫ e.unitInv.app Z) = e.counit.app V ≫ f := by
      simp
    rw [heq]
    exact S.downward_closed hf _
  exact ⟨_, e.counitInv.app V, _, Presieve.map_map hmem, by simp⟩

/-- Pushing a presieve up through `AsSmall` and back down returns it. -/
theorem presieve_map_up_down {A : Type v₁} [Category.{v₂} A] {Y : A} (R : Presieve Y) :
    (R.map (AsSmall.up : A ⥤ AsSmall.{v₃} A)).map AsSmall.down = R := by
  refine le_antisymm ?_ ?_
  · rintro W f ⟨h⟩
    obtain ⟨h'⟩ := h
    exact h'
  · intro W f hf
    exact Presieve.map_map (Presieve.map_map hf)

/-- **Covering sieves descend to a site raised through `AsSmall`.** If a sieve covers an object of
`A` for the topology generated by a precoverage `K`, then its pullback along `AsSmall.down` covers
the raised object for the topology generated by `Precoverage.comap AsSmall.down K`.

This is the hypothesis `he` of
`Stacks.WeakSites.ColimitGlobalSections.IsTopOneHypercover.of_equiv` for the equivalence
`CategoryTheory.AsSmall.equiv.symm`, and it is the one place on this route where an induction over
`CategoryTheory.Precoverage.Saturate` is unavoidable. The easy direction is definitional -- a
comap, so a family covers upstairs exactly when its image covers downstairs -- but the conclusion
needed here is about an arbitrary covering SIEVE of the generated topology, and those are built by
the four constructors of `Saturate` rather than being the sieves generated by covering families.

The induction is mechanical only because the raising is strict: `AsSmall.up` and `AsSmall.down`
are inverse on the nose, so the pullback commutes with `Sieve.pullback` on the nose
(`Sieve.ext fun _ _ => Iff.rfl`) and no transport appears in any case. A raising that were an
equivalence but not a retract would need the unit and counit in all four. -/
theorem functorPullback_mem_toGrothendieck_comap_asSmall {A : Type v₁} [Category.{v₂} A]
    (K : Precoverage A) {X : AsSmall.{v₃} A} {S : Sieve (AsSmall.down.obj X)}
    (hS : S ∈ K.toGrothendieck (AsSmall.down.obj X)) :
    S.functorPullback (AsSmall.down : AsSmall.{v₃} A ⥤ A) ∈
      (K.comap AsSmall.down).toGrothendieck X := by
  have key : ∀ (Y : A) (T : Sieve Y), K.Saturate Y T →
      Sieve.functorPullback (AsSmall.down : AsSmall.{v₃} A ⥤ A)
          (X := AsSmall.up.obj Y) T ∈
        (K.comap AsSmall.down).toGrothendieck (AsSmall.up.obj Y) := by
    intro Y T hT
    induction hT with
    | of Y R hR =>
      refine ((K.comap AsSmall.down).toGrothendieck).superset_covering ?_
        (Precoverage.generate_mem_toGrothendieck
          (show R.map (AsSmall.up : A ⥤ AsSmall.{v₃} A) ∈
              (K.comap AsSmall.down) (AsSmall.up.obj Y) by
            show (R.map (AsSmall.up : A ⥤ AsSmall.{v₃} A)).map AsSmall.down ∈ K Y
            rw [presieve_map_up_down]
            exact hR))
      rintro W f ⟨W', p, r, ⟨hr⟩, rfl⟩
      exact (Sieve.generate R).downward_closed (Sieve.le_generate R _ _ hr) _
    | top Y => exact ((K.comap AsSmall.down).toGrothendieck).top_mem _
    | pullback Y T hT Y' f ih =>
      refine (show Sieve.functorPullback (AsSmall.down : AsSmall.{v₃} A ⥤ A)
          (X := AsSmall.up.obj Y') (T.pullback f) =
            (Sieve.functorPullback (AsSmall.down : AsSmall.{v₃} A ⥤ A)
              (X := AsSmall.up.obj Y) T).pullback (AsSmall.up.map f) from
          Sieve.ext fun _ _ => Iff.rfl) ▸
        ((K.comap AsSmall.down).toGrothendieck).pullback_stable (AsSmall.up.map f) ih
    | transitive Y T R hT hR ihT ihR =>
      refine ((K.comap AsSmall.down).toGrothendieck).transitive ihT _ fun Z g hg => ?_
      exact (show (Sieve.functorPullback (AsSmall.down : AsSmall.{v₃} A ⥤ A)
            (X := AsSmall.up.obj Y) R).pullback g =
          Sieve.functorPullback (AsSmall.down : AsSmall.{v₃} A ⥤ A)
            (X := AsSmall.up.obj (AsSmall.down.obj Z)) (R.pullback (AsSmall.down.map g)) from
          Sieve.ext fun _ _ => Iff.rfl) ▸ ihR hg
  exact key _ S hS

namespace IsTopOneHypercoverOn

/-- **A terminal object is a one-hypercover of the terminal sheaf**, with the terminal object
itself in both roles. This is the instantiation at a site which does have a terminal object, so
the notion above is not vacuous; for such a site the conclusions of this file say that the
sections over the terminal object are the filtered colimit of the sections over the terminal
objects of the levels, which is the object-level statement at that object. -/
theorem of_isTerminal {T : C} (hT : IsTerminal T) :
    IsTopOneHypercoverOn J (fun _ : Unit => T) (fun _ _ _ : Unit => T)
      (fun _ _ _ => 𝟙 T) (fun _ _ _ => 𝟙 T) where
  coversTop := by
    refine (J.coversTop_iff_of_isTerminal T hT _).2 (J.superset_covering ?_ (J.top_mem T))
    intro Z f _
    exact ⟨(), ⟨hT.from Z⟩⟩
  locally_factors Z _ _ f g := by
    refine ⟨⊤, J.top_mem Z, fun V q _ => ⟨(), q ≫ f, by simp, ?_⟩⟩
    rw [Category.comp_id, hT.hom_ext g f]

omit [Category.{v₂} C] in
/-- On a small category the two notions of a finite one-hypercover of the terminal sheaf agree. -/
theorem toIsTopOneHypercover {C : Type w} [SmallCategory C] {J : GrothendieckTopology C}
    {κ ν : Type*} {W : κ → C} {P : κ → κ → ν → C}
    {p₁ : ∀ k l m, P k l m ⟶ W k} {p₂ : ∀ k l m, P k l m ⟶ W l}
    (h : IsTopOneHypercoverOn J W P p₁ p₂) : IsTopOneHypercover J W P p₁ p₂ :=
  ⟨h.coversTop, h.locally_factors⟩


variable {J} {κ ν : Type*} {W W' : κ → C} {P P' : κ → κ → ν → C}
  {p₁ : ∀ k l m, P k l m ⟶ W k} {p₂ : ∀ k l m, P k l m ⟶ W l}
  {p₁' : ∀ k l m, P' k l m ⟶ W' k} {p₂' : ∀ k l m, P' k l m ⟶ W' l}

/-- **Transport along isomorphisms of the data.** A geometric instantiation produces the objects
of a level only up to isomorphism — the transition image of an object of a site is a base change,
pinned by a pullback square rather than by an equality — so this is the form in which the
hypotheses below are to be checked. -/
theorem of_iso (h : IsTopOneHypercoverOn J W P p₁ p₂)
    (eW : ∀ k, W k ≅ W' k) (eP : ∀ k l m, P k l m ≅ P' k l m)
    (h₁ : ∀ k l m, p₁' k l m = (eP k l m).inv ≫ p₁ k l m ≫ (eW k).hom)
    (h₂ : ∀ k l m, p₂' k l m = (eP k l m).inv ≫ p₂ k l m ≫ (eW l).hom) :
    IsTopOneHypercoverOn J W' P' p₁' p₂' where
  coversTop Z := by
    refine J.superset_covering ?_ (h.coversTop Z)
    rintro Y f ⟨k, ⟨b⟩⟩
    exact ⟨k, ⟨b ≫ (eW k).hom⟩⟩
  locally_factors Z k l f g := by
    obtain ⟨S, hS, hfac⟩ := h.locally_factors Z k l (f ≫ (eW k).inv) (g ≫ (eW l).inv)
    refine ⟨S, hS, fun V q hq => ?_⟩
    obtain ⟨m, r, e₁, e₂⟩ := hfac q hq
    refine ⟨m, r ≫ (eP k l m).hom, ?_, ?_⟩
    · rw [h₁, Category.assoc, Iso.hom_inv_id_assoc, ← Category.assoc, ← e₁]
      simp
    · rw [h₂, Category.assoc, Iso.hom_inv_id_assoc, ← Category.assoc, ← e₂]
      simp

/-- **Re-indexing a one-hypercover along equivalences of the index types.** The notion depends on
the index types `κ` and `ν` only through the families, so a bijective change of index carries a
one-hypercover to a one-hypercover.

This is what a geometric instantiation needs on top of
`Stacks.WeakSites.ColimitGlobalSections.IsTopOneHypercover.of_iso`. `of_iso` transports the
*objects*, which is the right tool when a transition image is pinned only up to isomorphism; it
does not touch the indices. But the consumers in this file bind the index types in `Type` --
universe zero, finite -- while a covering produced from geometry is indexed in the universe of
the schemes, so the two have to be matched by an equivalence, both index types being finite.

The index universes are written out rather than left to `Type*`: in this development an
auto-bound index universe on a statement mentioning a concrete site has been enough to make
elaboration exceed its heartbeat budget outright. -/
theorem reindex {κ₀ ν₀ : Type t₁} {κ₁ ν₁ : Type t₂} {W₀ : κ₀ → C} {P₀ : κ₀ → κ₀ → ν₀ → C}
    {q₁ : ∀ k l m, P₀ k l m ⟶ W₀ k} {q₂ : ∀ k l m, P₀ k l m ⟶ W₀ l}
    (h : IsTopOneHypercoverOn J W₀ P₀ q₁ q₂) (eκ : κ₁ ≃ κ₀) (eν : ν₁ ≃ ν₀) :
    IsTopOneHypercoverOn J (fun k => W₀ (eκ k)) (fun k l m => P₀ (eκ k) (eκ l) (eν m))
      (fun k l m => q₁ (eκ k) (eκ l) (eν m)) (fun k l m => q₂ (eκ k) (eκ l) (eν m)) where
  coversTop Z := by
    refine J.superset_covering ?_ (h.coversTop Z)
    rintro Y f ⟨k, ⟨b⟩⟩
    obtain ⟨k', rfl⟩ := eκ.surjective k
    exact ⟨k', ⟨b⟩⟩
  locally_factors Z k l f g := by
    obtain ⟨T, hT, hfac⟩ := h.locally_factors Z (eκ k) (eκ l) f g
    refine ⟨T, hT, fun V q hq => ?_⟩
    obtain ⟨m, r, e₁, e₂⟩ := hfac q hq
    obtain ⟨m', rfl⟩ := eν.surjective m
    exact ⟨m', r, e₁, e₂⟩

/-- **Transport along an equivalence of sites.** A one-hypercover of the terminal sheaf of `C₂`
pulls back, along an equivalence `e : C ≌ C₂` whose functor reflects covering sieves in the weak
sense `he`, to a one-hypercover of the terminal sheaf of `C`, on the images of the objects under
`e.inverse`.

Why this is needed on top of
`Stacks.WeakSites.ColimitGlobalSections.IsTopOneHypercover.of_iso` and
`Stacks.WeakSites.ColimitGlobalSections.IsTopOneHypercover.reindex`. A strict inverse system of
sites in the sense of Stacks 0A34 has small categories as its levels, so a system whose levels
are to be the small affine étale sites of a family of schemes is built on small categories of
*representatives*, each merely equivalent to the geometric site it represents. A one-hypercover
established where the geometry is has therefore to be moved to the representatives before the
levels of the system can see it. `of_iso` moves the objects inside one site and `reindex` moves
the indices; neither crosses from one category to another.

Only one direction of the covering correspondence is assumed, and in the weak form "the
functor-pullback of a covering sieve covers", because that is the direction and the form which
the conclusion uses and which the identification of a level topology with an induced topology
supplies. -/
theorem of_equiv {C₂ : Type v₃} [Category.{v₄} C₂] {J₂ : GrothendieckTopology C₂}
    {κ₂ ν₂ : Type t₁} {W₂ : κ₂ → C₂} {P₂ : κ₂ → κ₂ → ν₂ → C₂}
    {r₁ : ∀ k l m, P₂ k l m ⟶ W₂ k} {r₂ : ∀ k l m, P₂ k l m ⟶ W₂ l}
    (h : IsTopOneHypercoverOn J₂ W₂ P₂ r₁ r₂) (e : C ≌ C₂)
    (he : ∀ (Z : C) (S : Sieve (e.functor.obj Z)), S ∈ J₂ (e.functor.obj Z) →
      S.functorPullback e.functor ∈ J Z) :
    IsTopOneHypercoverOn J (fun k => e.inverse.obj (W₂ k))
      (fun k l m => e.inverse.obj (P₂ k l m))
      (fun k l m => e.inverse.map (r₁ k l m)) (fun k l m => e.inverse.map (r₂ k l m)) where
  coversTop Z := by
    refine J.superset_covering ?_ (he Z _ (h.coversTop (e.functor.obj Z)))
    rintro Y f ⟨k, ⟨b⟩⟩
    exact ⟨k, ⟨e.unit.app Y ≫ e.inverse.map b⟩⟩
  locally_factors Z k l f g := by
    obtain ⟨S, hS, hfac⟩ := h.locally_factors (e.functor.obj Z) k l
      (e.functor.map f ≫ e.counit.app (W₂ k))
      (e.functor.map g ≫ e.counit.app (W₂ l))
    refine ⟨S.functorPullback e.functor, he Z S hS, fun V q hq => ?_⟩
    obtain ⟨m, t, e₁, e₂⟩ := hfac (e.functor.map q) hq
    refine ⟨m, e.unit.app V ≫ e.inverse.map t, ?_, ?_⟩
    · refine Eq.symm ?_
      rw [Category.assoc, ← Functor.map_comp, ← e₁]
      simp
    · refine Eq.symm ?_
      rw [Category.assoc, ← Functor.map_comp, ← e₂]
      simp

end IsTopOneHypercoverOn

end Hypercover

variable {C : Type w} [SmallCategory C] (J : GrothendieckTopology C)

section Main

variable {J}
variable (D : InverseSystemOfFiniteSites.{u₁, u₂, w}) (u : ∀ i, D.C i ⥤ C)
  (hu : ∀ {i j : D.I} (a : i ⟶ j), D.u a ⋙ u i = u j)
  (Fs : ∀ i, Sheaf (D.J i) (Type w))
  (ψ : ∀ {i j : D.I} (a : j ⟶ i), (Fs i).obj ⟶ (D.u a).op ⋙ (Fs j).obj)
  (G : Sheaf J (Type w)) (ι : ∀ i, (Fs i).obj ⟶ (u i).op ⋙ G.obj)

variable
  (hψ : ∀ {i j k : D.I} (a : j ⟶ i) (b : k ⟶ j) (V : D.C i) (x : (Fs i).obj.obj (op V)),
    (ψ (b ≫ a)).app (op V) x =
      (Fs k).obj.map (eqToHom (congrArg op (Functor.congr_obj (D.comp b a) V).symm))
        ((ψ b).app (op ((D.u a).obj V)) ((ψ a).app (op V) x)))
  (hι : ∀ {i j : D.I} (a : j ⟶ i) (V : D.C i) (x : (Fs i).obj.obj (op V)),
    (ι i).app (op V) x =
      G.obj.map (eqToHom (congrArg op (Functor.congr_obj (hu a) V)))
        ((ι j).app (op ((D.u a).obj V)) ((ψ a).app (op V) x)))
  (hsurj : ∀ (i : D.I) (X : D.C i) (s : G.obj.sections),
    ∃ (j : D.I) (a : j ⟶ i) (t : (Fs j).obj.obj (op ((D.u a).obj X))),
      (ι j).app (op ((D.u a).obj X)) t = s.val (op ((u j).obj ((D.u a).obj X))))
  (hsep : ∀ (i : D.I) (X : D.C i) (j : D.I) (a : j ⟶ i)
    (t t' : (Fs j).obj.obj (op ((D.u a).obj X))),
    (ι j).app (op ((D.u a).obj X)) t = (ι j).app (op ((D.u a).obj X)) t' →
      ∃ (k : D.I) (b : k ⟶ j),
        (ψ b).app (op ((D.u a).obj X)) t = (ψ b).app (op ((D.u a).obj X)) t')
  {κ' ν' : Type} [Finite κ'] [Finite ν'] (i₀ : D.I) (W₀ : κ' → D.C i₀)
  (P₀ : κ' → κ' → ν' → D.C i₀)
  (q₁ : ∀ k l m, P₀ k l m ⟶ W₀ k) (q₂ : ∀ k l m, P₀ k l m ⟶ W₀ l)
  (hlev : ∀ {n : D.I} (a : n ⟶ i₀), IsTopOneHypercoverOn (D.J n)
    (fun k => (D.u a).obj (W₀ k)) (fun k l m => (D.u a).obj (P₀ k l m))
    (fun k l m => (D.u a).map (q₁ k l m)) (fun k l m => (D.u a).map (q₂ k l m)))
  (hC : IsTopOneHypercoverOn J (fun k => (u i₀).obj (W₀ k))
    (fun k l m => (u i₀).obj (P₀ k l m)) (fun k l m => (u i₀).map (q₁ k l m))
    (fun k l m => (u i₀).map (q₂ k l m)))
  (ρ : ∀ {n : D.I} (_ : n ⟶ i₀), (Fs n).obj.sections → G.obj.sections)
  (hρ : ∀ {n : D.I} (a : n ⟶ i₀) (t : (Fs n).obj.sections) (Y : D.C n),
    (ρ a t).val (op ((u n).obj Y)) = (ι n).app (op Y) (t.val (op Y)))

/-- **The global sections of `G` are the filtered colimit of the global sections of the `F n`**,
as a predicate: the canonical maps `ρ` are jointly surjective, and two global sections of a level
with the same image agree, after passing to a further level, on a finite family of objects of the
level `i₀` which determines them.

This names the conclusion of `globalSections_colimit_of_exists_topOneHypercover` so that a
geometric instantiation can state it. The family is existentially quantified INSIDE the predicate,
which is what makes that possible: the family a construction produces is not available to name in
the statement of a theorem about it.

The reason to name it rather than write it out is the same reason the
hypotheses of that theorem are stated here over variables. Written out at a concrete system, the
separatedness clause exhausts the heartbeat budget in the SIGNATURE -- at `isDefEq` rather than at
`whnf`, because `(ψ b).app (op ((D.u a).obj (W k)))` applied to `t'.val (op ((D.u a).obj (W k)))`
sets the elaborator to unify two sheaf-section types through the system, four times over. Inside
this definition `D`, `Fs`, `ψ` and `G` are variables and there is nothing to unfold. -/
def GlobalSectionsIsColimit : Prop :=
  (∀ s : G.obj.sections, ∃ (n : D.I) (a : n ⟶ i₀) (t : (Fs n).obj.sections), ρ a t = s) ∧
    ∃ (κ₁ : Type) (W : κ₁ → D.C i₀),
      ∀ (n : D.I) (a : n ⟶ i₀) (t t' : (Fs n).obj.sections), ρ a t = ρ a t' →
        ∃ (m : D.I) (b : m ⟶ n), ∀ k : κ₁,
          (ψ b).app (op ((D.u a).obj (W k))) (t.val (op ((D.u a).obj (W k)))) =
            (ψ b).app (op ((D.u a).obj (W k))) (t'.val (op ((D.u a).obj (W k))))

include hu hψ hι hsurj hsep hρ in
/-- **Stacks 09YQ in degree zero, with the covering data as an existential.** The same conclusion
as `globalSections_colimit_pullback_of_colimit`, but taking the one-hypercover of the level `i₀`
and its transported copies as an existential hypothesis rather than as fixed data.

This is the form a geometric instantiation can actually state. The two hypotheses `hlev` and `hC`
mention a chosen family, so a development that produces its family by a construction -- a finite
affine cover of a quasi-compact quasi-separated scheme, say, whose index type is whatever the
construction returns -- has that family only under an existential, and cannot name it in the
statement of its own theorem.

The reason for stating it HERE and not at the geometry is the size of the elaboration, not
tidiness. Writing the hypotheses out at a concrete system whose `D` is a projection of a
sixteen-field structure literal exceeds the heartbeat budget in the SIGNATURE -- the `hG` clause
alone did, before any proof ran -- because every one of some thirty occurrences of `D.I`, `D.C i`,
`D.u a`, `D.J i` forces the elaborator through that definition again. Here `D`, `u`, `K`, `Fs`,
`ψ`, `G` and `ι` are section variables and nothing unfolds.

That is the fourth instance in this development of one rule, and it is worth stating as a rule
rather than meeting a fifth time: when a statement about a concrete construction will not
elaborate, state it about the variables and apply it, rather than raising a limit or inlining the
construction. The other three were a geometric identification stated with no reference to a system
of sites, a fibre-product square taken as a hypothesis and discharged separately, and a
one-hypercover stated on the site where the geometry lives rather than on a raised copy of it. -/
theorem globalSections_colimit_of_exists_topOneHypercover
    (hdata : ∃ (κ₁ ν₁ : Type) (_ : Finite κ₁) (_ : Finite ν₁) (W : κ₁ → D.C i₀)
      (P : κ₁ → κ₁ → ν₁ → D.C i₀) (p₁ : ∀ k l m, P k l m ⟶ W k)
      (p₂ : ∀ k l m, P k l m ⟶ W l),
      (∀ {n : D.I} (a : n ⟶ i₀), IsTopOneHypercoverOn (D.J n)
          (fun k => (D.u a).obj (W k)) (fun k l m => (D.u a).obj (P k l m))
          (fun k l m => (D.u a).map (p₁ k l m))
          (fun k l m => (D.u a).map (p₂ k l m))) ∧
        IsTopOneHypercoverOn J (fun k => (u i₀).obj (W k))
          (fun k l m => (u i₀).obj (P k l m)) (fun k l m => (u i₀).map (p₁ k l m))
          (fun k l m => (u i₀).map (p₂ k l m))) :
    GlobalSectionsIsColimit D Fs ψ G i₀ ρ := by
  obtain ⟨κ₁, ν₁, hκ₁, hν₁, W, P, p₁, p₂, hlev', hC'⟩ := hdata
  obtain ⟨h1, h2⟩ := globalSections_colimit_pullback_of_colimit D u hu Fs ψ G ι hψ hι hsurj hsep
    i₀ W P p₁ p₂ (fun a => (hlev' a).toIsTopOneHypercover) hC'.toIsTopOneHypercover ρ hρ
  exact ⟨h1, κ₁, W, h2⟩

end Main

section MatchingFamilies

/-- **A matching family on a one-hypercover datum.** A family of sections of a presheaf `H` over
the objects `W k` whose restrictions to the objects `P k l m` agree.

For a one-hypercover of the terminal sheaf this is the sheaf condition's description of the global
sections — `existsUnique_sections_of_matching` and `sections_eq_of_eq_on_topOneHypercover`
together say that the global sections of a sheaf ARE its matching families. For a one-hypercover
of the subsheaf represented by a quasi-compact quasi-separated object `V` of the site it is the
same description of the sections over `V`, an object the site need not contain. In both cases the
point is identical: when the two index types are finite the matching families are a FINITE limit
of sections over objects, and a filtered colimit passes through a finite limit. -/
@[ext]
structure MatchingFamily {A : Type v₁} [Category.{v₂} A] (H : Aᵒᵖ ⥤ Type w) {κ ν : Type t₁}
    (W : κ → A) (P : κ → κ → ν → A) (p₁ : ∀ k l m, P k l m ⟶ W k)
    (p₂ : ∀ k l m, P k l m ⟶ W l) where
  /-- The sections over the objects of the first layer. -/
  val : ∀ k, H.obj (op (W k))
  /-- Their restrictions to the objects of the second layer agree. -/
  matching : ∀ k l m, H.map (p₁ k l m).op (val k) = H.map (p₂ k l m).op (val l)

namespace MatchingFamily

variable {A : Type v₁} [Category.{v₂} A] {H H' H'' : Aᵒᵖ ⥤ Type w} {κ ν : Type t₁}
  {W W' : κ → A} {P P' : κ → κ → ν → A}
  {p₁ : ∀ k l m, P k l m ⟶ W k} {p₂ : ∀ k l m, P k l m ⟶ W l}
  {p₁' : ∀ k l m, P' k l m ⟶ W' k} {p₂' : ∀ k l m, P' k l m ⟶ W' l}

/-- **A matching family is carried along a morphism of presheaves.** The components are pushed
forward by `α`; the matching condition survives because `α` is natural. -/
def map (α : H ⟶ H') (x : MatchingFamily H W P p₁ p₂) : MatchingFamily H' W P p₁ p₂ where
  val k := α.app (op (W k)) (x.val k)
  matching k l m := by
    rw [← NatTrans.naturality_apply α (p₁ k l m).op (x.val k),
      ← NatTrans.naturality_apply α (p₂ k l m).op (x.val l), x.matching k l m]

/-- The component of `x.map α` at `k` is the image of the component of `x` under `α`. -/
@[simp]
theorem map_val (α : H ⟶ H') (x : MatchingFamily H W P p₁ p₂) (k : κ) :
    (x.map α).val k = α.app (op (W k)) (x.val k) :=
  rfl

/-- Mapping along `α` and then along `β` is mapping along `α ≫ β`. -/
theorem map_map (α : H ⟶ H') (β : H' ⟶ H'') (x : MatchingFamily H W P p₁ p₂) :
    (x.map α).map β = x.map (α ≫ β) :=
  rfl

/-- Mapping along the identity of `H` is the identity. -/
theorem map_id (x : MatchingFamily H W P p₁ p₂) : x.map (𝟙 H) = x := rfl

/-- **Transport along an isomorphism of the presheaves.** One of the two transports a geometric
instantiation needs, the other being `MatchingFamily.ofIso`: the presheaf whose matching families
are to be computed is produced by an equivalence of categories of sheaves — Stacks 04HR, for the
inclusion of a small affine étale site into the small étale site — and is therefore pinned only
up to a natural isomorphism. -/
def mapIso (e : H ≅ H') : MatchingFamily H W P p₁ p₂ ≃ MatchingFamily H' W P p₁ p₂ where
  toFun x := x.map e.hom
  invFun y := y.map e.inv
  left_inv x := by
    change (x.map e.hom).map e.inv = x
    rw [map_map, e.hom_inv_id, map_id]
  right_inv y := by
    change (y.map e.inv).map e.hom = y
    rw [map_map, e.inv_hom_id, map_id]

/-- The component of `mapIso e x` at `k` is the image of the component of `x` under `e.hom`. -/
@[simp]
theorem mapIso_apply_val (e : H ≅ H') (x : MatchingFamily H W P p₁ p₂) (k : κ) :
    (mapIso (W := W) (P := P) (p₁ := p₁) (p₂ := p₂) e x).val k =
      e.hom.app (op (W k)) (x.val k) :=
  rfl

/-- The component of `(mapIso e).symm y` at `k` is the image of the component of `y` under
`e.inv`. -/
@[simp]
theorem mapIso_symm_apply_val (e : H ≅ H') (y : MatchingFamily H' W P p₁ p₂) (k : κ) :
    ((mapIso (W := W) (P := P) (p₁ := p₁) (p₂ := p₂) e).symm y).val k =
      e.inv.app (op (W k)) (y.val k) :=
  rfl

/-- **The matching families of a restricted presheaf are the matching families of the presheaf on
the image datum**, on the nose: restricting along `U` and then evaluating at `W k` is evaluating
at `U.obj (W k)`, and likewise for the structure morphisms. The identification is definitional,
and is recorded because the two spellings are what the two sides of a comparison across a change
of site look like. -/
def comp {A' : Type v₃} [Category.{v₄} A'] (U : A ⥤ A') (K : A'ᵒᵖ ⥤ Type w) :
    MatchingFamily (U.op ⋙ K) W P p₁ p₂ ≃
      MatchingFamily K (fun k => U.obj (W k)) (fun k l m => U.obj (P k l m))
        (fun k l m => U.map (p₁ k l m)) (fun k l m => U.map (p₂ k l m)) where
  toFun x := ⟨x.val, x.matching⟩
  invFun y := ⟨y.val, y.matching⟩
  left_inv _ := rfl
  right_inv _ := rfl

/-- The components of a matching family are unchanged by `comp U K`. -/
@[simp]
theorem comp_apply_val {A' : Type v₃} [Category.{v₄} A'] (U : A ⥤ A') (K : A'ᵒᵖ ⥤ Type w)
    (x : MatchingFamily (U.op ⋙ K) W P p₁ p₂) (k : κ) :
    (comp (p₁ := p₁) (p₂ := p₂) U K x).val k = x.val k :=
  rfl

/-- The components of a matching family are unchanged by `(comp U K).symm`. -/
@[simp]
theorem comp_symm_apply_val {A' : Type v₃} [Category.{v₄} A'] (U : A ⥤ A') (K : A'ᵒᵖ ⥤ Type w)
    (y : MatchingFamily K (fun k => U.obj (W k)) (fun k l m => U.obj (P k l m))
      (fun k l m => U.map (p₁ k l m)) (fun k l m => U.map (p₂ k l m))) (k : κ) :
    ((comp (p₁ := p₁) (p₂ := p₂) U K).symm y).val k = y.val k :=
  rfl

/-- **Transport along isomorphisms of the objects.** The counterpart, for matching families, of
`Stacks.WeakSites.ColimitGlobalSections.IsTopOneHypercover.of_iso`, and needed for the same
reason: a geometric instantiation produces the objects of a level only up to isomorphism — the
transition image of an object of a site is a base change, pinned by a pullback square rather than
by an equality — so the datum whose matching families the consumers of this file compute is not,
on the nose, the datum the geometry hands over.

The two factorisation hypotheses are literally those of `IsTopOneHypercoverOn.of_iso`, so a
geometric application discharges them once and uses them for both. -/
def ofIso (eW : ∀ k, W k ≅ W' k) (eP : ∀ k l m, P k l m ≅ P' k l m)
    (h₁ : ∀ k l m, p₁' k l m = (eP k l m).inv ≫ p₁ k l m ≫ (eW k).hom)
    (h₂ : ∀ k l m, p₂' k l m = (eP k l m).inv ≫ p₂ k l m ≫ (eW l).hom) :
    MatchingFamily H W P p₁ p₂ ≃ MatchingFamily H W' P' p₁' p₂' where
  toFun x :=
    { val := fun k => H.map (eW k).inv.op (x.val k)
      matching := fun k l m => by
        dsimp only
        rw [← Functor.map_comp_apply, ← Functor.map_comp_apply, ← op_comp, ← op_comp,
          h₁ k l m, h₂ k l m]
        simp only [Category.assoc, Iso.hom_inv_id, Category.comp_id, op_comp,
          Functor.map_comp_apply]
        rw [x.matching k l m] }
  invFun y :=
    { val := fun k => H.map (eW k).hom.op (y.val k)
      matching := fun k l m => by
        have e₁ : p₁ k l m ≫ (eW k).hom = (eP k l m).hom ≫ p₁' k l m := by
          rw [h₁ k l m, Iso.hom_inv_id_assoc]
        have e₂ : p₂ k l m ≫ (eW l).hom = (eP k l m).hom ≫ p₂' k l m := by
          rw [h₂ k l m, Iso.hom_inv_id_assoc]
        dsimp only
        rw [← Functor.map_comp_apply, ← Functor.map_comp_apply, ← op_comp, ← op_comp, e₁, e₂,
          op_comp, op_comp, Functor.map_comp_apply, Functor.map_comp_apply, y.matching k l m] }
  left_inv x := by
    ext k
    dsimp only
    rw [← Functor.map_comp_apply, ← op_comp, Iso.hom_inv_id, op_id]
    exact H.map_id_apply _ _
  right_inv y := by
    ext k
    dsimp only
    rw [← Functor.map_comp_apply, ← op_comp, Iso.inv_hom_id, op_id]
    exact H.map_id_apply _ _

/-- The component of `ofIso eW eP h₁ h₂ x` at `k` is the restriction of the component of `x`
along `(eW k).inv`. -/
@[simp]
theorem ofIso_apply_val (eW : ∀ k, W k ≅ W' k) (eP : ∀ k l m, P k l m ≅ P' k l m)
    (h₁ : ∀ k l m, p₁' k l m = (eP k l m).inv ≫ p₁ k l m ≫ (eW k).hom)
    (h₂ : ∀ k l m, p₂' k l m = (eP k l m).inv ≫ p₂ k l m ≫ (eW l).hom)
    (x : MatchingFamily H W P p₁ p₂) (k : κ) :
    (ofIso (H := H) eW eP h₁ h₂ x).val k = H.map (eW k).inv.op (x.val k) :=
  rfl

/-- The component of `(ofIso eW eP h₁ h₂).symm y` at `k` is the restriction of the component of
`y` along `(eW k).hom`. -/
@[simp]
theorem ofIso_symm_apply_val (eW : ∀ k, W k ≅ W' k) (eP : ∀ k l m, P k l m ≅ P' k l m)
    (h₁ : ∀ k l m, p₁' k l m = (eP k l m).inv ≫ p₁ k l m ≫ (eW k).hom)
    (h₂ : ∀ k l m, p₂' k l m = (eP k l m).inv ≫ p₂ k l m ≫ (eW l).hom)
    (y : MatchingFamily H W' P' p₁' p₂') (k : κ) :
    ((ofIso (H := H) eW eP h₁ h₂).symm y).val k = H.map (eW k).hom.op (y.val k) :=
  rfl

/-- **Re-indexing a matching family along equivalences of the index types.** The counterpart of
`Stacks.WeakSites.ColimitGlobalSections.IsTopOneHypercover.reindex`, and needed for the same
reason: the consumers of this file bind the index types in `Type`, while a datum produced from
geometry is indexed in the universe of the schemes, so the two have to be matched by an
equivalence of finite index types.

Only this direction is stated, and as a map rather than as an equivalence. It is the direction a
consumer uses — the reindexed datum is the one the consumers see — and the inverse direction
cannot be written without a transport along `Equiv.apply_symm_apply` inside the dependent type
`fun k => H.obj (op (W₀ k))`, whereas here the surjectivity of `eκ` lets every obligation be
discharged by substituting `eκ k` for the index. -/
def reindex {κ₀ ν₀ : Type t₁} {κ₁ ν₁ : Type t₂} {W₀ : κ₀ → A} {P₀ : κ₀ → κ₀ → ν₀ → A}
    {q₁ : ∀ k l m, P₀ k l m ⟶ W₀ k} {q₂ : ∀ k l m, P₀ k l m ⟶ W₀ l}
    (eκ : κ₁ ≃ κ₀) (eν : ν₁ ≃ ν₀) (x : MatchingFamily H W₀ P₀ q₁ q₂) :
    MatchingFamily H (fun k => W₀ (eκ k)) (fun k l m => P₀ (eκ k) (eκ l) (eν m))
      (fun k l m => q₁ (eκ k) (eκ l) (eν m)) (fun k l m => q₂ (eκ k) (eκ l) (eν m)) where
  val k := x.val (eκ k)
  matching k l m := x.matching (eκ k) (eκ l) (eν m)

/-- The component of `x.reindex eκ eν` at `k` is the component of `x` at `eκ k`. -/
@[simp]
theorem reindex_val {κ₀ ν₀ : Type t₁} {κ₁ ν₁ : Type t₂} {W₀ : κ₀ → A} {P₀ : κ₀ → κ₀ → ν₀ → A}
    {q₁ : ∀ k l m, P₀ k l m ⟶ W₀ k} {q₂ : ∀ k l m, P₀ k l m ⟶ W₀ l}
    (eκ : κ₁ ≃ κ₀) (eν : ν₁ ≃ ν₀) (x : MatchingFamily H W₀ P₀ q₁ q₂) (k : κ₁) :
    (x.reindex eκ eν).val k = x.val (eκ k) :=
  rfl

end MatchingFamily

variable {J}
variable (D : InverseSystemOfFiniteSites.{u₁, u₂, w}) (u : ∀ i, D.C i ⥤ C)
  (hu : ∀ {i j : D.I} (a : i ⟶ j), D.u a ⋙ u i = u j)
  (Fs : ∀ i, Sheaf (D.J i) (Type w))
  (ψ : ∀ {i j : D.I} (a : j ⟶ i), (Fs i).obj ⟶ (D.u a).op ⋙ (Fs j).obj)
  (G : Sheaf J (Type w)) (ι : ∀ i, (Fs i).obj ⟶ (u i).op ⋙ G.obj)
  (hψ : ∀ {i j k : D.I} (a : j ⟶ i) (b : k ⟶ j) (V : D.C i) (x : (Fs i).obj.obj (op V)),
    (ψ (b ≫ a)).app (op V) x =
      (Fs k).obj.map (eqToHom (congrArg op (Functor.congr_obj (D.comp b a) V).symm))
        ((ψ b).app (op ((D.u a).obj V)) ((ψ a).app (op V) x)))
  (hι : ∀ {i j : D.I} (a : j ⟶ i) (V : D.C i) (x : (Fs i).obj.obj (op V)),
    (ι i).app (op V) x =
      G.obj.map (eqToHom (congrArg op (Functor.congr_obj (hu a) V)))
        ((ι j).app (op ((D.u a).obj V)) ((ψ a).app (op V) x)))
  (hsurjObj : ∀ (i : D.I) (X : D.C i) (z : G.obj.obj (op ((u i).obj X))),
    ∃ (j : D.I) (a : j ⟶ i) (t : (Fs j).obj.obj (op ((D.u a).obj X))),
      G.obj.map (eqToHom (congrArg op (Functor.congr_obj (hu a) X)))
        ((ι j).app (op ((D.u a).obj X)) t) = z)
  (hsep : ∀ (i : D.I) (X : D.C i) (j : D.I) (a : j ⟶ i)
    (t t' : (Fs j).obj.obj (op ((D.u a).obj X))),
    (ι j).app (op ((D.u a).obj X)) t = (ι j).app (op ((D.u a).obj X)) t' →
      ∃ (k : D.I) (b : k ⟶ j),
        (ψ b).app (op ((D.u a).obj X)) t = (ψ b).app (op ((D.u a).obj X)) t')
  {κ' ν' : Type} (i₀ : D.I) (W₀ : κ' → D.C i₀) (P₀ : κ' → κ' → ν' → D.C i₀)
  (q₁ : ∀ k l m, P₀ k l m ⟶ W₀ k) (q₂ : ∀ k l m, P₀ k l m ⟶ W₀ l)
  (σ : ∀ {n : D.I} (a : n ⟶ i₀),
    MatchingFamily ((D.u a).op ⋙ (Fs n).obj) W₀ P₀ q₁ q₂ →
      MatchingFamily ((u i₀).op ⋙ G.obj) W₀ P₀ q₁ q₂)
  (hσ : ∀ {n : D.I} (a : n ⟶ i₀) (t : MatchingFamily ((D.u a).op ⋙ (Fs n).obj) W₀ P₀ q₁ q₂)
    (k : κ'), (σ a t).val k =
      G.obj.map (eqToHom (congrArg op (Functor.congr_obj (hu a) (W₀ k))))
        ((ι n).app (op ((D.u a).obj (W₀ k))) (t.val k)))

/-- **The matching families of `G = colim f_i^{-1}F_i` on a one-hypercover datum of a level are
the filtered colimit of the matching families of the `F n`**, as a predicate: the canonical maps
`σ` are jointly surjective, and two matching families of a level with the same image agree,
componentwise, after passing to a further level.

This is the statement of Stacks 09YN over a quasi-compact quasi-separated object rather than over
an affine one, with the object replaced by the datum that covers it. It is named, rather than
written out, for the reason recorded on `GlobalSectionsIsColimit`: at a concrete system the
separatedness clause exhausts the heartbeat budget in the signature. -/
def MatchingFamiliesIsColimit : Prop :=
  (∀ y : MatchingFamily ((u i₀).op ⋙ G.obj) W₀ P₀ q₁ q₂,
      ∃ (n : D.I) (a : n ⟶ i₀) (t : MatchingFamily ((D.u a).op ⋙ (Fs n).obj) W₀ P₀ q₁ q₂),
        σ a t = y) ∧
    ∀ (n : D.I) (a : n ⟶ i₀) (t t' : MatchingFamily ((D.u a).op ⋙ (Fs n).obj) W₀ P₀ q₁ q₂),
      σ a t = σ a t' → ∃ (m : D.I) (b : m ⟶ n), ∀ k : κ',
        (ψ b).app (op ((D.u a).obj (W₀ k))) (t.val k) =
          (ψ b).app (op ((D.u a).obj (W₀ k))) (t'.val k)

/-- A transport along an equality of objects of `C` is injective on sections. -/
private theorem map_eqToHom_inj {X Y : C} (h : X = Y) {z z' : G.obj.obj (op X)}
    (hzz : G.obj.map (eqToHom (congrArg op h)) z =
      G.obj.map (eqToHom (congrArg op h)) z') : z = z' := by
  subst h
  simpa using hzz

/-- Transporting a section of a level along an equality of objects of that level commutes with
the leg `ι`. -/
private theorem ι_app_map_eqToHom {n : D.I} {Y₁ Y₂ : D.C n} (h : Y₁ = Y₂)
    (z : (Fs n).obj.obj (op Y₁)) :
    (ι n).app (op Y₂) ((Fs n).obj.map (eqToHom (congrArg op h)) z) =
      G.obj.map (eqToHom (congrArg op (congrArg (u n).obj h))) ((ι n).app (op Y₁) z) := by
  subst h
  simp

include hι in
/-- **The descent maps are a cocone.** Pushing a section of the level `j` down to the level `n`
along `ψ b` and then into `G` is pushing it into `G` directly. The arrow `c : n ⟶ i₁` is not
required to be `b ≫ a`: all that is used is an identification `hobj` of the two images of the
object, which is what a system supplies. -/
private theorem map_eqToHom_ι_trans {i₁ n j : D.I} (a : j ⟶ i₁) (b : n ⟶ j) (c : n ⟶ i₁)
    (Y : D.C i₁) (x : (Fs j).obj.obj (op ((D.u a).obj Y)))
    (hobj : (D.u b).obj ((D.u a).obj Y) = (D.u c).obj Y) :
    G.obj.map (eqToHom (congrArg op (Functor.congr_obj (hu c) Y)))
        ((ι n).app (op ((D.u c).obj Y))
          ((Fs n).obj.map (eqToHom (congrArg op hobj))
            ((ψ b).app (op ((D.u a).obj Y)) x))) =
      G.obj.map (eqToHom (congrArg op (Functor.congr_obj (hu a) Y)))
        ((ι j).app (op ((D.u a).obj Y)) x) := by
  rw [ι_app_map_eqToHom D u Fs G ι hobj, hι b ((D.u a).obj Y) x]
  simp only [← Functor.map_comp_apply, eqToHom_trans]

/-- **Naturality read across an identification of the functors.** If `U = U'` and `θ` is a
natural family of maps `H ⟶ U.op ⋙ G`, then the transported family is natural for `U'`.

Stated over a bare equality of functors and a pointwise-natural family rather than over the
system, so that `subst` is available: at the system the equality is `hu a`, whose two sides are
`D.u a ⋙ u n` and `u i₁`, and neither can be abstracted in place. -/
private theorem map_eqToHom_comp_app {A : Type w} [SmallCategory A] (U U' : A ⥤ C) (hUU : U = U')
    (H : Aᵒᵖ ⥤ Type w) (θ : ∀ Y : A, H.obj (op Y) → G.obj.obj (op (U.obj Y)))
    (hθ : ∀ (Y Y' : A) (f : Y' ⟶ Y) (z : H.obj (op Y)),
      θ Y' (H.map f.op z) = G.obj.map (U.map f).op (θ Y z))
    {Y Y' : A} (f : Y' ⟶ Y) (z : H.obj (op Y)) :
    G.obj.map (eqToHom (congrArg op (Functor.congr_obj hUU Y'))) (θ Y' (H.map f.op z)) =
      G.obj.map (U'.map f).op
        (G.obj.map (eqToHom (congrArg op (Functor.congr_obj hUU Y))) (θ Y z)) := by
  subst hUU
  rw [hθ Y Y' f z]
  simp

/-- A finite family of pairs of sections of a level, each pair identified at some further level,
is identified at a single further level
(`CategoryTheory.IsCofiltered.wideCospan`). -/
private theorem exists_forall_ψ_eq
    (hψ : ∀ {i j k : D.I} (a : j ⟶ i) (b : k ⟶ j) (V : D.C i) (x : (Fs i).obj.obj (op V)),
      (ψ (b ≫ a)).app (op V) x =
        (Fs k).obj.map (eqToHom (congrArg op (Functor.congr_obj (D.comp b a) V).symm))
          ((ψ b).app (op ((D.u a).obj V)) ((ψ a).app (op V) x)))
    {β : Type} [Finite β] {n : D.I} (V : β → D.C n)
    (s s' : ∀ x, (Fs n).obj.obj (op (V x)))
    (h : ∀ x, ∃ (m : D.I) (b : m ⟶ n), (ψ b).app (op (V x)) (s x) = (ψ b).app (op (V x)) (s' x)) :
    ∃ (m : D.I) (b : m ⟶ n), ∀ x, (ψ b).app (op (V x)) (s x) = (ψ b).app (op (V x)) (s' x) := by
  choose mm bb hbb using h
  obtain ⟨m, b, g, hg⟩ := IsCofiltered.wideCospan bb
  exact ⟨m, b, fun x => by rw [← hg x, hψ (bb x) (g x), hψ (bb x) (g x), hbb x]⟩

/-- **A matching family transports along an equality of the transition functors.** The arrow
`b ≫ a` of the index and the composite `D.u a ⋙ D.u b` of the transition functors agree only up
to the identification `D.comp`, and a matching family built at the composite has to be moved to
the arrow. Stated as an existential with its components pinned, so that `subst` discharges it. -/
private theorem exists_matchingFamily_of_functorEq {n : D.I} {U U' : D.C i₀ ⥤ D.C n} (h : U = U')
    (x : MatchingFamily (U.op ⋙ (Fs n).obj) W₀ P₀ q₁ q₂) :
    ∃ x' : MatchingFamily (U'.op ⋙ (Fs n).obj) W₀ P₀ q₁ q₂, ∀ k,
      x'.val k = (Fs n).obj.map (eqToHom (congrArg op (Functor.congr_obj h (W₀ k)))) (x.val k) := by
  subst h
  exact ⟨x, fun k => by simp⟩

include hu hψ hsep hσ in
/-- **Separatedness of the colimit of matching families.** Two matching families of `F n` with the
same image agree, componentwise, at a further level: componentwise this is the object-level
separatedness `hsep`, and a finite family of arrows is dominated by a single one
(`CategoryTheory.IsCofiltered.wideCospan`). -/
theorem matchingFamily_separated [Finite κ'] (n : D.I) (a : n ⟶ i₀)
    (t t' : MatchingFamily ((D.u a).op ⋙ (Fs n).obj) W₀ P₀ q₁ q₂) (h : σ a t = σ a t') :
    ∃ (m : D.I) (b : m ⟶ n), ∀ k : κ',
      (ψ b).app (op ((D.u a).obj (W₀ k))) (t.val k) =
        (ψ b).app (op ((D.u a).obj (W₀ k))) (t'.val k) := by
  classical
  have hk : ∀ k : κ', ∃ (m : D.I) (b : m ⟶ n),
      (ψ b).app (op ((D.u a).obj (W₀ k))) (t.val k) =
        (ψ b).app (op ((D.u a).obj (W₀ k))) (t'.val k) := by
    intro k
    refine hsep i₀ (W₀ k) n a _ _ ?_
    refine map_eqToHom_inj G (Functor.congr_obj (hu a) (W₀ k)) ?_
    rw [← hσ a t k, ← hσ a t' k, h]
  exact exists_forall_ψ_eq D Fs ψ hψ (fun k => (D.u a).obj (W₀ k)) (fun k => t.val k)
    (fun k => t'.val k) hk

include hu hψ hι hsurjObj hsep hσ in
/-- **Joint surjectivity of the colimit of matching families: Stacks 09YN over an object the site
need not contain.** Every matching family of `G = colim f_i^{-1}F_i` on the image of a finite
one-hypercover datum of the level `i₀` is the image of a matching family of some `F n`.

The proof is the object-level statement applied to each of the finitely many components, twice.
The components descend by `hsurjObj` and a single level dominating the finitely many levels is
found by `CategoryTheory.IsCofiltered.wideCospan`; the finitely many matching conditions hold in
`G`, because the given family matches, so by `hsep` they hold at a further single level, again by
`wideCospan`; and there the family IS a matching family, with nothing to glue. Finiteness of the
two index types is used exactly at the two applications of `wideCospan`.

Nothing about one-hypercovers enters: neither `IsTopOneHypercoverOn` nor the sheaf condition is a
hypothesis. That is the whole point of stating the colimit over matching families — the
identification of the matching families with the sections over an object is a statement about one
site at a time, and the colimit statement does not need it. -/
theorem matchingFamily_jointlySurjective [Finite κ'] [Finite ν']
    (y : MatchingFamily ((u i₀).op ⋙ G.obj) W₀ P₀ q₁ q₂) :
    ∃ (n : D.I) (a : n ⟶ i₀) (t : MatchingFamily ((D.u a).op ⋙ (Fs n).obj) W₀ P₀ q₁ q₂),
      σ a t = y := by
  classical
  have step0 : ∀ k : κ', ∃ (j : D.I) (aj : j ⟶ i₀)
      (t : (Fs j).obj.obj (op ((D.u aj).obj (W₀ k)))),
      G.obj.map (eqToHom (congrArg op (Functor.congr_obj (hu aj) (W₀ k))))
        ((ι j).app (op ((D.u aj).obj (W₀ k))) t) = y.val k :=
    fun k => hsurjObj i₀ (W₀ k) (y.val k)
  choose jj aa tt htt using step0
  obtain ⟨n₁, a, e, he⟩ := IsCofiltered.wideCospan aa
  have step1 : ∀ k : κ', ∃ z : (Fs n₁).obj.obj (op ((D.u a).obj (W₀ k))),
      G.obj.map (eqToHom (congrArg op (Functor.congr_obj (hu a) (W₀ k))))
        ((ι n₁).app (op ((D.u a).obj (W₀ k))) z) = y.val k := by
    intro k
    have hobj : (D.u (e k)).obj ((D.u (aa k)).obj (W₀ k)) = (D.u a).obj (W₀ k) :=
      (Functor.congr_obj (D.comp (e k) (aa k)) (W₀ k)).symm.trans
        (Functor.congr_obj (congrArg (fun h : n₁ ⟶ i₀ => D.u h) (he k)) (W₀ k))
    exact ⟨_, (map_eqToHom_ι_trans D u hu Fs ψ G ι hι (aa k) (e k) a (W₀ k) (tt k) hobj).trans
      (htt k)⟩
  choose zz hzz using step1
  have hnat : ∀ (Y : D.C i₀) (k : κ') (f : Y ⟶ W₀ k),
      G.obj.map (eqToHom (congrArg op (Functor.congr_obj (hu a) Y)))
          ((ι n₁).app (op ((D.u a).obj Y)) ((Fs n₁).obj.map ((D.u a).map f).op (zz k))) =
        G.obj.map ((u i₀).map f).op (y.val k) := by
    intro Y k f
    rw [← hzz k]
    exact map_eqToHom_comp_app G (D.u a ⋙ u n₁) (u i₀) (hu a) ((D.u a).op ⋙ (Fs n₁).obj)
      (fun Y' z => (ι n₁).app (op ((D.u a).obj Y')) z)
      (fun _ _ g z => by simp)
      f (zz k)
  have key : ∀ x : κ' × κ' × ν', ∃ (k' : D.I) (b : k' ⟶ n₁),
      (ψ b).app (op ((D.u a).obj (P₀ x.1 x.2.1 x.2.2)))
          ((Fs n₁).obj.map ((D.u a).map (q₁ x.1 x.2.1 x.2.2)).op (zz x.1)) =
        (ψ b).app (op ((D.u a).obj (P₀ x.1 x.2.1 x.2.2)))
          ((Fs n₁).obj.map ((D.u a).map (q₂ x.1 x.2.1 x.2.2)).op (zz x.2.1)) := by
    rintro ⟨k, l, m⟩
    refine hsep i₀ (P₀ k l m) n₁ a _ _ ?_
    refine map_eqToHom_inj G (Functor.congr_obj (hu a) (P₀ k l m)) ?_
    rw [hnat (P₀ k l m) k (q₁ k l m), hnat (P₀ k l m) l (q₂ k l m)]
    exact y.matching k l m
  obtain ⟨n, b, key2⟩ := exists_forall_ψ_eq D Fs ψ hψ
    (fun x : κ' × κ' × ν' => (D.u a).obj (P₀ x.1 x.2.1 x.2.2))
    (fun x => (Fs n₁).obj.map ((D.u a).map (q₁ x.1 x.2.1 x.2.2)).op (zz x.1))
    (fun x => (Fs n₁).obj.map ((D.u a).map (q₂ x.1 x.2.1 x.2.2)).op (zz x.2.1)) key
  let t0 : MatchingFamily ((D.u a ⋙ D.u b).op ⋙ (Fs n).obj) W₀ P₀ q₁ q₂ :=
    { val := fun k => (ψ b).app (op ((D.u a).obj (W₀ k))) (zz k)
      matching := fun k l m => by
        have e₁ := NatTrans.naturality_apply (ψ b) ((D.u a).map (q₁ k l m)).op (zz k)
        have e₂ := NatTrans.naturality_apply (ψ b) ((D.u a).map (q₂ k l m)).op (zz l)
        simp only [Functor.comp_map, Functor.op_map, Quiver.Hom.unop_op] at e₁ e₂ ⊢
        rw [← e₁, ← e₂]
        exact key2 (k, l, m) }
  obtain ⟨t, ht⟩ := exists_matchingFamily_of_functorEq D Fs i₀ W₀ P₀ q₁ q₂ (D.comp b a).symm t0
  refine ⟨n, b ≫ a, t, ?_⟩
  ext k
  have hobj : (D.u b).obj ((D.u a).obj (W₀ k)) = (D.u (b ≫ a)).obj (W₀ k) :=
    (Functor.congr_obj (D.comp b a) (W₀ k)).symm
  have hstep : G.obj.map (eqToHom (congrArg op (Functor.congr_obj (hu (b ≫ a)) (W₀ k))))
        ((ι n).app (op ((D.u (b ≫ a)).obj (W₀ k)))
          ((Fs n).obj.map (eqToHom (congrArg op hobj))
            ((ψ b).app (op ((D.u a).obj (W₀ k))) (zz k)))) =
      G.obj.map (eqToHom (congrArg op (Functor.congr_obj (hu a) (W₀ k))))
        ((ι n₁).app (op ((D.u a).obj (W₀ k))) (zz k)) :=
    map_eqToHom_ι_trans D u hu Fs ψ G ι hι a b (b ≫ a) (W₀ k) (zz k) hobj
  rw [hσ (b ≫ a) t k, ht k]
  exact hstep.trans (hzz k)

include hu hψ hι hsurjObj hsep hσ in
/-- **Stacks 09YN over a quasi-compact quasi-separated object.** The matching families of
`G = colim f_i^{-1}F_i` on the image of a finite one-hypercover datum of a level are the filtered
colimit of the matching families of the `F n`. -/
theorem matchingFamiliesIsColimit_of_finite [Finite κ'] [Finite ν'] :
    MatchingFamiliesIsColimit D u Fs ψ G i₀ W₀ P₀ q₁ q₂ σ :=
  ⟨matchingFamily_jointlySurjective D u hu Fs ψ G ι hψ hι hsurjObj hsep i₀ W₀ P₀ q₁ q₂ σ hσ,
    fun n a t t' h =>
      matchingFamily_separated D u hu Fs ψ G ι hψ hsep i₀ W₀ P₀ q₁ q₂ σ hσ n a t t' h⟩

include hu in
/-- **The canonical map on matching families induced by the legs `ι`.** A matching family of `F n`
on the transition image of the datum is carried, componentwise, into `G` by the leg `ι n` and the
identification `hu a` of `u_n ∘ u_a` with `u_{i₀}`.

This is the map `σ` that `MatchingFamiliesIsColimit` and the results above quantify over, and
`matchingFamiliesIsColimit_of_finite'` is the colimit statement for it; `matchingFamilyMap_val`
is the hypothesis `hσ` for it, by `rfl`. The results above take `σ` as data because that is the
form a consumer with its own canonical map can use, and because a geometric consumer may obtain
its map from a sheaf-theoretic construction rather than componentwise; what was missing, and is
supplied here, is that there IS such a map, so those results are not vacuous.

The matching condition is naturality of `ι n` read across the identification `hu a` of the two
functors, which is what the private `map_eqToHom_comp_app` of this file says: the composite
`u_a ⋙ u_n` and `u_{i₀}` are equal and not identical, and neither side can be abstracted in
place, so the equality is substituted there once and used twice here. -/
def matchingFamilyMap {n : D.I} (a : n ⟶ i₀)
    (t : MatchingFamily ((D.u a).op ⋙ (Fs n).obj) W₀ P₀ q₁ q₂) :
    MatchingFamily ((u i₀).op ⋙ G.obj) W₀ P₀ q₁ q₂ where
  val k := G.obj.map (eqToHom (congrArg op (Functor.congr_obj (hu a) (W₀ k))))
    ((ι n).app (op ((D.u a).obj (W₀ k))) (t.val k))
  matching k l m := by
    have hnat : ∀ (Y : D.C i₀) (k' : κ') (f : Y ⟶ W₀ k'),
        G.obj.map (eqToHom (congrArg op (Functor.congr_obj (hu a) Y)))
            ((ι n).app (op ((D.u a).obj Y))
              ((Fs n).obj.map ((D.u a).map f).op (t.val k'))) =
          G.obj.map ((u i₀).map f).op
            (G.obj.map (eqToHom (congrArg op (Functor.congr_obj (hu a) (W₀ k'))))
              ((ι n).app (op ((D.u a).obj (W₀ k'))) (t.val k'))) := fun Y k' f =>
      map_eqToHom_comp_app G (D.u a ⋙ u n) (u i₀) (hu a) ((D.u a).op ⋙ (Fs n).obj)
        (fun Y' z => (ι n).app (op ((D.u a).obj Y')) z)
        (fun _ _ g z => by simp)
        f (t.val k')
    dsimp only [Functor.comp_map, Functor.op_map, Quiver.Hom.unop_op]
    rw [← hnat (P₀ k l m) k (q₁ k l m), ← hnat (P₀ k l m) l (q₂ k l m)]
    exact congrArg _ (congrArg _ (t.matching k l m))

/-- The component of `matchingFamilyMap D u hu Fs G ι i₀ W₀ P₀ q₁ q₂ a t` at `k` is the image of
the component of `t` under `ι n`, transported along the equality `hu a`. -/
@[simp]
theorem matchingFamilyMap_val {n : D.I} (a : n ⟶ i₀)
    (t : MatchingFamily ((D.u a).op ⋙ (Fs n).obj) W₀ P₀ q₁ q₂) (k : κ') :
    (matchingFamilyMap D u hu Fs G ι i₀ W₀ P₀ q₁ q₂ a t).val k =
      G.obj.map (eqToHom (congrArg op (Functor.congr_obj (hu a) (W₀ k))))
        ((ι n).app (op ((D.u a).obj (W₀ k))) (t.val k)) :=
  rfl

include hψ hι hsurjObj hsep in
/-- **Stacks 09YN over a quasi-compact quasi-separated object, for the canonical map.**
`matchingFamiliesIsColimit_of_finite` with `σ` taken to be `matchingFamilyMap`, which is what a
consumer that has not built a map of its own wants. -/
theorem matchingFamiliesIsColimit_of_finite' [Finite κ'] [Finite ν'] :
    MatchingFamiliesIsColimit D u Fs ψ G i₀ W₀ P₀ q₁ q₂
      (fun {_} a => matchingFamilyMap D u hu Fs G ι i₀ W₀ P₀ q₁ q₂ a) :=
  matchingFamiliesIsColimit_of_finite D u hu Fs ψ G ι hψ hι hsurjObj hsep i₀ W₀ P₀ q₁ q₂ _
    (fun a t k => matchingFamilyMap_val D u hu Fs G ι i₀ W₀ P₀ q₁ q₂ a t k)

end MatchingFamilies

end Stacks.WeakSites.ColimitGlobalSections

