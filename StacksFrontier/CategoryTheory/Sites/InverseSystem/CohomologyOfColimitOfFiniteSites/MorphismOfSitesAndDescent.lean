namespace Stacks.WeakSites.ColimitMorphismOfSites

@[expose] public section

section Factorization

variable {X Y Z : Type w} [SmallCategory X] [SmallCategory Y] [SmallCategory Z]

/-- The sheaf pullback along a continuous functor transported along an equality of functors. The
transport cannot be a `rewrite`: `Functor.sheafPullback` takes continuity as an instance argument,
so the equality has to be eliminated by substitution, after which the two continuity assumptions
are proofs of the same proposition. -/
private noncomputable def sheafPullbackIsoOfEq {v v' : X ⥤ Y} (h : v = v')
    (J : GrothendieckTopology X) (L : GrothendieckTopology Y) [v.IsContinuous J L]
    [v'.IsContinuous J L] : v.sheafPullback (Type w) J L ≅ v'.sheafPullback (Type w) J L := by
  subst h; exact Iso.refl _

private theorem sheafPullbackIsoOfEq_refl (v : X ⥤ Y) (J : GrothendieckTopology X)
    (L : GrothendieckTopology Y) [v.IsContinuous J L] :
    sheafPullbackIsoOfEq (rfl : v = v) J L = Iso.refl _ :=
  rfl

/-- **The comparison isomorphism of a factorization of a continuous functor.** For a factorization
`v ⋙ w = vw` of continuous functors between sites, `vw_s ≅ v_s ⋙ w_s`: both are left adjoint to
`w^s ⋙ v^s ≅ vw^s`.

For the colimit of an inverse system of sites this is the isomorphism `f_i^{-1} ≅ f_a^{-1} ⋙
f_j^{-1}` attached to `hu a : D.u a ⋙ u j = u i`, and it is what the canonical maps of equation
(09YM) are built from (`homEquiv_symm_unit_comp_eq`). -/
private noncomputable def sheafPullbackFacIso {v : X ⥤ Y} {w : Y ⥤ Z} {vw : X ⥤ Z} (e : v ⋙ w = vw)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    [v.IsContinuous J K] [w.IsContinuous K L] [vw.IsContinuous J L] :
    vw.sheafPullback (Type w) J L ≅ v.sheafPullback (Type w) J K ⋙ w.sheafPullback (Type w) K L :=
  haveI := Functor.isContinuous_comp v w J K L
  (sheafPullbackIsoOfEq e J L).symm ≪≫ Functor.sheafPullbackComp v w J K L

/-- At the identity factorization `v ⋙ w = v ⋙ w` the comparison isomorphism of pushforwards is
the identity. Both sides of `Functor.sheafPushforwardContinuousComp'` are precomposition with
`(v ⋙ w).op`, and its second factor, the action of a natural isomorphism of functors on
pushforwards, is the identity at the identity isomorphism. -/
private theorem comp'_refl_hom_app (v : X ⥤ Y) (w : Y ⥤ Z) (J : GrothendieckTopology X)
    (K : GrothendieckTopology Y) (L : GrothendieckTopology Z) [v.IsContinuous J K]
    [w.IsContinuous K L] [(v ⋙ w).IsContinuous J L] (M : Sheaf L (Type w)) :
    (Functor.sheafPushforwardContinuousComp' (Iso.refl (v ⋙ w)) (Type w) J K L).hom.app M =
      𝟙 _ := by
  ext M' x
  simp only [Functor.comp_obj, Functor.sheafPushforwardContinuousComp', Iso.trans,
    Functor.sheafPushforwardContinuousComp, Iso.refl_hom, Functor.sheafPushforwardContinuousIso,
    Functor.sheafPushforwardContinuousNatTrans, Iso.refl_inv, NatTrans.op_id, ObjectProperty.ι_obj,
    Functor.whiskerRight_id', TypeCat.Fun.toFun_apply, ObjectProperty.FullSubcategory.id_hom,
    NatTrans.id_app]
  rfl

/-- The inverse form of `comp'_refl_hom_app`. -/
private theorem comp'_refl_inv_app (v : X ⥤ Y) (w : Y ⥤ Z) (J : GrothendieckTopology X)
    (K : GrothendieckTopology Y) (L : GrothendieckTopology Z) [v.IsContinuous J K]
    [w.IsContinuous K L] [(v ⋙ w).IsContinuous J L] (M : Sheaf L (Type w)) :
    (Functor.sheafPushforwardContinuousComp' (Iso.refl (v ⋙ w)) (Type w) J K L).inv.app M =
      𝟙 _ := by
  have h := Iso.hom_inv_id_app
    (Functor.sheafPushforwardContinuousComp' (Iso.refl (v ⋙ w)) (Type w) J K L) M
  rw [comp'_refl_hom_app] at h
  exact (Category.id_comp _).symm.trans h

/-- **The comparison isomorphism of pushforwards, read on sections.** At an object `A` of the
source of `v` its value is the restriction of the sheaf along the equality of objects
`(v ⋙ w).obj A = vw.obj A`, which is how every equation between canonical maps of a factorization
turns into the `eqToHom`-transports that the statements of Stacks 09YN and 0A35 are phrased with.
-/
private theorem comp'_hom_app_app {v : X ⥤ Y} {w : Y ⥤ Z} {vw : X ⥤ Z} (e : v ⋙ w = vw)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    [v.IsContinuous J K] [w.IsContinuous K L] [vw.IsContinuous J L] (N : Sheaf L (Type w))
    (A : X) :
    ((Functor.sheafPushforwardContinuousComp' (eqToIso e) (Type w) J K L).hom.app N).hom.app
        (op A) =
      N.obj.map (eqToHom (congrArg op (Functor.congr_obj e A))) := by
  subst e
  rw [eqToIso_refl, comp'_refl_hom_app]
  simp only [Functor.comp_obj, ObjectProperty.FullSubcategory.id_hom, NatTrans.id_app,
    eqToHom_refl, Functor.map_id]
  rfl

/-- The comparison isomorphism of pushforwards along a factorization is, for the factorization
`v ⋙ w = v ⋙ w`, the one of `Functor.sheafPushforwardContinuousComp`: the second factor of
`Functor.sheafPushforwardContinuousComp'`, the action of a natural isomorphism of functors on
pushforwards, is the identity at the identity isomorphism. -/
private theorem sheafPushforwardContinuousComp_hom_comp_comp'_inv (v : X ⥤ Y) (w : Y ⥤ Z)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    [v.IsContinuous J K] [w.IsContinuous K L] [(v ⋙ w).IsContinuous J L] (M : Sheaf L (Type w)) :
    (Functor.sheafPushforwardContinuousComp v w (Type w) J K L).hom.app M ≫
        (Functor.sheafPushforwardContinuousComp' (eqToIso (rfl : v ⋙ w = v ⋙ w)) (Type w) J K
              L).inv.app
          M =
      𝟙 _ := by
  rw [eqToIso_refl, comp'_refl_inv_app]
  rfl

/-- **The canonical map of equation (09YM) is the unit of the `w`-adjunction composed with the
comparison isomorphism of the factorization.** For a factorization `v ⋙ w = vw` of continuous
functors and a sheaf `F` on the source, the adjoint of the unit `F ⟶ vw^s vw_s F` under the
`v`-adjunction, read through the identification `vw^s ≅ w^s ⋙ v^s` of pushforwards, is the map
`v_s F ⟶ w^s (vw_s F)` adjoint to `sheafPullbackFacIso e |>.inv.app F : w_s v_s F ⟶ vw_s F`.

For the colimit of an inverse system of sites, with `v = D.u a`, `w = u j` and `vw = u i` for
`a : j ⟶ i`, the left-hand side is the morphism of sheaves whose value at `U` is the map `θ a` of
equation (09YM), by the formula `hθ` that pins it. So `θ a` is, up to the isomorphism
`sheafPullbackFacIso`, the unit of the `u j`-adjunction at the sheaf `f_a^{-1}F` read on sections
over `(D.u a).obj U`: no colimit over the arrows into `i` and no coherence between different `a`
enters its description. This is the reduction of (09YM) to a statement about a single level. -/
private theorem homEquiv_symm_unit_comp_eq {v : X ⥤ Y} {w : Y ⥤ Z} {vw : X ⥤ Z} (e : v ⋙ w = vw)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    [v.IsContinuous J K] [w.IsContinuous K L] [vw.IsContinuous J L] (F : Sheaf J (Type w)) :
    ((v.sheafAdjunctionContinuous (Type w) J K).homEquiv F
            ((w.sheafPushforwardContinuous (Type w) K L).obj
              ((vw.sheafPullback (Type w) J L).obj F))).symm
        ((vw.sheafAdjunctionContinuous (Type w) J L).unit.app F ≫
          (Functor.sheafPushforwardContinuousComp' (eqToIso e) (Type w) J K L).inv.app
            ((vw.sheafPullback (Type w) J L).obj F)) =
      (w.sheafAdjunctionContinuous (Type w) K L).homEquiv ((v.sheafPullback (Type w) J K).obj F)
        ((vw.sheafPullback (Type w) J L).obj F) ((sheafPullbackFacIso e J K L).inv.app F) := by
  subst e
  have key :=
    Adjunction.homEquiv_leftAdjointUniq_hom_app
      (((v.sheafAdjunctionContinuous (Type w) J K).comp
            (w.sheafAdjunctionContinuous (Type w) K L)).ofNatIsoRight
        (Functor.sheafPushforwardContinuousComp v w (Type w) J K L))
      ((v ⋙ w).sheafAdjunctionContinuous (Type w) J L) F
  rw [Adjunction.homEquiv_ofNatIsoRight_apply, Adjunction.comp_homEquiv] at key
  simp only [Equiv.trans_apply] at key
  rw [Equiv.symm_apply_eq]
  simp only [sheafPullbackFacIso, Functor.sheafPullbackComp, Iso.trans_inv, Iso.symm_inv,
    sheafPullbackIsoOfEq_refl, Iso.refl_hom, Category.comp_id, Adjunction.leftAdjointUniq_inv_app]
  rw [← key, Category.assoc, sheafPushforwardContinuousComp_hom_comp_comp'_inv, Category.comp_id]

end Factorization

section FactorizationComp

variable {X Y Z T : Type w} [SmallCategory X] [SmallCategory Y] [SmallCategory Z] [SmallCategory T]

/-- **The canonical map of equation (09YM), as a morphism of sheaves.** For a factorization
`v ⋙ w = vw` of continuous functors and a sheaf `F` on the source, this is the morphism
`v_s F ⟶ w^s (vw_s F)` adjoint to `sheafPullbackFacIso e |>.inv.app F`, that is the unit of the
`w`-adjunction at `v_s F` followed by the comparison isomorphism of the factorization.

`homEquiv_symm_unit_comp_eq` says that this is the morphism whose value at an object is the map
`θ` of equation (09YM), as the formula `hθ` writes it. -/
private noncomputable def unitFac {v : X ⥤ Y} {w : Y ⥤ Z} {vw : X ⥤ Z} (e : v ⋙ w = vw)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    [v.IsContinuous J K] [w.IsContinuous K L] [vw.IsContinuous J L] (F : Sheaf J (Type w)) :
    (v.sheafPullback (Type w) J K).obj F ⟶
      (w.sheafPushforwardContinuous (Type w) K L).obj ((vw.sheafPullback (Type w) J L).obj F) :=
  (w.sheafAdjunctionContinuous (Type w) K L).homEquiv _ _ ((sheafPullbackFacIso e J K L).inv.app F)

/-- The adjoint of `unitFac` under the `v`-adjunction is the unit of the `vw`-adjunction, read
through the identification `vw^s ≅ w^s ⋙ v^s` of pushforwards. This is
`homEquiv_symm_unit_comp_eq` with both sides transposed, and it is the only property of `unitFac`
that the coherence `unitFac_comp` below uses. -/
private theorem homEquiv_unitFac {v : X ⥤ Y} {w : Y ⥤ Z} {vw : X ⥤ Z} (e : v ⋙ w = vw)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    [v.IsContinuous J K] [w.IsContinuous K L] [vw.IsContinuous J L] (F : Sheaf J (Type w)) :
    (v.sheafAdjunctionContinuous (Type w) J K).homEquiv F _ (unitFac e J K L F) =
      (vw.sheafAdjunctionContinuous (Type w) J L).unit.app F ≫
        (Functor.sheafPushforwardContinuousComp' (eqToIso e) (Type w) J K L).inv.app
          ((vw.sheafPullback (Type w) J L).obj F) := by
  rw [unitFac, ← homEquiv_symm_unit_comp_eq e J K L F, Equiv.apply_symm_apply]

/-- **The adjoint of a canonical map followed by a map of sheaves on the target.** For a
factorization `v ⋙ w = vw` and a morphism `h : vw_s F ⟶ H`, the `v`-adjoint of
`unitFac e ≫ w^s h` is the `vw`-adjoint of `h`, read through the identification `vw^s ≅ w^s ⋙ v^s`
of pushforwards.

This is the statement that "precomposition with `unitFac e`" is, on the sheaves `H` of the target
site, the bijection of the `vw`-adjunction up to the comparison isomorphism; it is what identifies
the maps out of a colimit sheaf in the universal property `hG` of Stacks 09YN. -/
private theorem homEquiv_unitFac_comp {v : X ⥤ Y} {w : Y ⥤ Z} {vw : X ⥤ Z} (e : v ⋙ w = vw)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    [v.IsContinuous J K] [w.IsContinuous K L] [vw.IsContinuous J L] (F : Sheaf J (Type w))
    (H : Sheaf L (Type w)) (h : (vw.sheafPullback (Type w) J L).obj F ⟶ H) :
    (v.sheafAdjunctionContinuous (Type w) J K).homEquiv F
        ((w.sheafPushforwardContinuous (Type w) K L).obj H)
        (unitFac e J K L F ≫ (w.sheafPushforwardContinuous (Type w) K L).map h) =
      (vw.sheafAdjunctionContinuous (Type w) J L).homEquiv F H h ≫
        (Functor.sheafPushforwardContinuousComp' (eqToIso e) (Type w) J K L).inv.app H := by
  rw [Adjunction.homEquiv_naturality_right, homEquiv_unitFac, Adjunction.homEquiv_unit,
    Category.assoc, Category.assoc]
  exact
    congrArg _
      ((Functor.sheafPushforwardContinuousComp' (eqToIso e) (Type w) J K L).inv.naturality h).symm

/-- The comparison isomorphisms of pushforwards attached to a two-step factorization satisfy the
evident cocycle identity. Both sides are restrictions of a sheaf along equalities of functors, so
the identity is one of `eqToHom`s. -/
private theorem comp'_inv_cocycle {v : X ⥤ Y} {w : Y ⥤ Z} {x : Z ⥤ T} {vw : X ⥤ Z} {wx : Y ⥤ T}
    {vwx : X ⥤ T} (e₁ : v ⋙ w = vw) (e₂ : w ⋙ x = wx) (e₃ : v ⋙ wx = vwx) (e₄ : vw ⋙ x = vwx)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    (M : GrothendieckTopology T) [v.IsContinuous J K] [w.IsContinuous K L] [x.IsContinuous L M]
    [vw.IsContinuous J L] [wx.IsContinuous K M] [vwx.IsContinuous J M] (N : Sheaf M (Type w)) :
    (Functor.sheafPushforwardContinuousComp' (eqToIso e₃) (Type w) J K M).inv.app N =
      (Functor.sheafPushforwardContinuousComp' (eqToIso e₄) (Type w) J L M).inv.app N ≫
        (Functor.sheafPushforwardContinuousComp' (eqToIso e₁) (Type w) J K L).inv.app
          ((x.sheafPushforwardContinuous (Type w) L M).obj N) ≫
        (v.sheafPushforwardContinuous (Type w) J K).map
          ((Functor.sheafPushforwardContinuousComp' (eqToIso e₂) (Type w) K L M).hom.app N) := by
  subst e₁ e₂
  subst e₃
  obtain rfl : e₄ = rfl := rfl
  simp only [eqToIso_refl, comp'_refl_hom_app, comp'_refl_inv_app]
  rfl

/-- **The canonical maps of equation (09YM) are compatible with refining the level.** For a
two-step factorization `v ⋙ w = vw`, `w ⋙ x = wx`, `v ⋙ wx = vw ⋙ x = vwx` of continuous
functors, the canonical map attached to `v ⋙ wx = vwx` is the canonical map attached to
`v ⋙ w = vw` followed by the one attached to `vw ⋙ x = vwx`.

For the colimit of an inverse system of sites, with `v = D.u c`, `w = D.u e`, `x = u k'`, this says
that a section of `f_c^{-1}F` over `u_c W` and its image in `f_{e ∘ c}^{-1}F` over `u_{e ∘ c} W`
have the same image in `f_i^{-1}F` over `u_i W`: representatives can be pushed to any deeper level
without changing the section they represent. It is what makes the family of the `θ` a filtered
system of maps rather than an unrelated collection. -/
private theorem unitFac_comp {v : X ⥤ Y} {w : Y ⥤ Z} {x : Z ⥤ T} {vw : X ⥤ Z} {wx : Y ⥤ T}
    {vwx : X ⥤ T} (e₁ : v ⋙ w = vw) (e₂ : w ⋙ x = wx) (e₃ : v ⋙ wx = vwx) (e₄ : vw ⋙ x = vwx)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    (M : GrothendieckTopology T) [v.IsContinuous J K] [w.IsContinuous K L] [x.IsContinuous L M]
    [vw.IsContinuous J L] [wx.IsContinuous K M] [vwx.IsContinuous J M] (F : Sheaf J (Type w)) :
    unitFac e₃ J K M F =
      unitFac e₁ J K L F ≫
        (w.sheafPushforwardContinuous (Type w) K L).map (unitFac e₄ J L M F) ≫
        (Functor.sheafPushforwardContinuousComp' (eqToIso e₂) (Type w) K L M).hom.app
          ((vwx.sheafPullback (Type w) J M).obj F) := by
  have hnat :
    (vw.sheafPushforwardContinuous (Type w) J L).map (unitFac e₄ J L M F) ≫
        (Functor.sheafPushforwardContinuousComp' (eqToIso e₁) (Type w) J K L).inv.app _ =
      (Functor.sheafPushforwardContinuousComp' (eqToIso e₁) (Type w) J K L).inv.app _ ≫
        (v.sheafPushforwardContinuous (Type w) J K).map
          ((w.sheafPushforwardContinuous (Type w) K L).map (unitFac e₄ J L M F)) :=
    (Functor.sheafPushforwardContinuousComp' (eqToIso e₁) (Type w) J K L).inv.naturality _
  have h₄ :
    (vw.sheafAdjunctionContinuous (Type w) J L).unit.app F ≫
        (vw.sheafPushforwardContinuous (Type w) J L).map (unitFac e₄ J L M F) =
      (vwx.sheafAdjunctionContinuous (Type w) J M).unit.app F ≫
        (Functor.sheafPushforwardContinuousComp' (eqToIso e₄) (Type w) J L M).inv.app
          ((vwx.sheafPullback (Type w) J M).obj F) := by
    have h := homEquiv_unitFac e₄ J L M F
    rw [Adjunction.homEquiv_unit] at h
    exact h
  refine ((v.sheafAdjunctionContinuous (Type w) J K).homEquiv F _).injective ?_
  rw [homEquiv_unitFac, Adjunction.homEquiv_naturality_right, homEquiv_unitFac,
    comp'_inv_cocycle e₁ e₂ e₃ e₄ J K L M, Functor.map_comp]
  slice_lhs 1 2 => rw [← h₄]
  slice_lhs 2 3 => rw [hnat]
  simp

/-- The defining formula of `unitFac`. -/
private theorem unitFac_def {v : X ⥤ Y} {w : Y ⥤ Z} {vw : X ⥤ Z} (e : v ⋙ w = vw)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    [v.IsContinuous J K] [w.IsContinuous K L] [vw.IsContinuous J L] (F : Sheaf J (Type w)) :
    unitFac e J K L F =
      (w.sheafAdjunctionContinuous (Type w) K L).homEquiv _ _
        ((sheafPullbackFacIso e J K L).inv.app F) :=
  rfl

/-- The `v`-adjoint transpose of the unit of the `vw`-adjunction, followed by the comparison
isomorphism, is `unitFac`. -/
private theorem homEquiv_symm_unit_eq_unitFac {v : X ⥤ Y} {w : Y ⥤ Z} {vw : X ⥤ Z}
    (e : v ⋙ w = vw) (J : GrothendieckTopology X) (K : GrothendieckTopology Y)
    (L : GrothendieckTopology Z) [v.IsContinuous J K] [w.IsContinuous K L] [vw.IsContinuous J L]
    (F : Sheaf J (Type w)) :
    ((v.sheafAdjunctionContinuous (Type w) J K).homEquiv F
            ((w.sheafPushforwardContinuous (Type w) K L).obj
              ((vw.sheafPullback (Type w) J L).obj F))).symm
        ((vw.sheafAdjunctionContinuous (Type w) J L).unit.app F ≫
          (Functor.sheafPushforwardContinuousComp' (eqToIso e) (Type w) J K L).inv.app
            ((vw.sheafPullback (Type w) J L).obj F)) =
      unitFac e J K L F :=
  (homEquiv_symm_unit_comp_eq e J K L F).trans (unitFac_def e J K L F).symm

/-- `unitFac` is the unit of the `w`-adjunction followed by the comparison isomorphism. -/
private theorem unitFac_eq_unit_comp_map {v : X ⥤ Y} {w : Y ⥤ Z} {vw : X ⥤ Z} (e : v ⋙ w = vw)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    [v.IsContinuous J K] [w.IsContinuous K L] [vw.IsContinuous J L] (F : Sheaf J (Type w)) :
    unitFac e J K L F =
      (w.sheafAdjunctionContinuous (Type w) K L).unit.app ((v.sheafPullback (Type w) J K).obj F) ≫
        (w.sheafPushforwardContinuous (Type w) K L).map
          ((sheafPullbackFacIso e J K L).inv.app F) := by
  rw [unitFac_def, Adjunction.homEquiv_unit]

/-- `unitFac` is natural in the sheaf, both sides being adjoints of a natural isomorphism. -/
private theorem unitFac_naturality {v : X ⥤ Y} {w : Y ⥤ Z} {vw : X ⥤ Z} (e : v ⋙ w = vw)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    [v.IsContinuous J K] [w.IsContinuous K L] [vw.IsContinuous J L] {F F' : Sheaf J (Type w)}
    (φ : F ⟶ F') :
    (v.sheafPullback (Type w) J K).map φ ≫ unitFac e J K L F' =
      unitFac e J K L F ≫
        (w.sheafPushforwardContinuous (Type w) K L).map
          ((vw.sheafPullback (Type w) J L).map φ) := by
  rw [unitFac_def, unitFac_def, ← Adjunction.homEquiv_naturality_left, ←
    Adjunction.homEquiv_naturality_right]
  exact congrArg _ ((sheafPullbackFacIso e J K L).inv.naturality φ)

/-- `unitFac` as a natural transformation. -/
private noncomputable def unitFacNat {v : X ⥤ Y} {w : Y ⥤ Z} {vw : X ⥤ Z} (e : v ⋙ w = vw)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    [v.IsContinuous J K] [w.IsContinuous K L] [vw.IsContinuous J L] :
    v.sheafPullback (Type w) J K ⟶
      vw.sheafPullback (Type w) J L ⋙ w.sheafPushforwardContinuous (Type w) K L
    where
  app F := unitFac e J K L F
  naturality _ _ φ := unitFac_naturality e J K L φ

/-- **The canonical map of equation (09YM) as a natural transformation of endofunctors.** For a
factorization `v ⋙ w = vw` of continuous functors the composite `v^s v_s ⟶ vw^s vw_s` whose value
at `F` and at an object `A` of the source is the canonical map from the sections of `v_s F` over
`v A` to the sections of `vw_s F` over `vw A`.

Read at `v = D.u a`, `w = u j`, `vw = u i` and `A = U` this is the morphism of which the map `θ a`
of
equation (09YM) is a component, and reading it as a natural transformation of *functors of the
sheaf*
is what lets `preservesFiniteLimits_of_jointlySurjective` be applied to it. -/
private noncomputable def sectionsNat {v : X ⥤ Y} {w : Y ⥤ Z} {vw : X ⥤ Z} (e : v ⋙ w = vw)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    [v.IsContinuous J K] [w.IsContinuous K L] [vw.IsContinuous J L] :
    v.sheafPullback (Type w) J K ⋙ v.sheafPushforwardContinuous (Type w) J K ⟶
      vw.sheafPullback (Type w) J L ⋙ vw.sheafPushforwardContinuous (Type w) J L :=
  Functor.whiskerRight (unitFacNat e J K L) (v.sheafPushforwardContinuous (Type w) J K) ≫
    Functor.whiskerLeft (vw.sheafPullback (Type w) J L)
      (Functor.sheafPushforwardContinuousComp' (eqToIso e) (Type w) J K L).hom

private theorem sectionsNat_app {v : X ⥤ Y} {w : Y ⥤ Z} {vw : X ⥤ Z} (e : v ⋙ w = vw)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    [v.IsContinuous J K] [w.IsContinuous K L] [vw.IsContinuous J L] (F : Sheaf J (Type w)) :
    (sectionsNat e J K L).app F =
      (v.sheafPushforwardContinuous (Type w) J K).map (unitFac e J K L F) ≫
        (Functor.sheafPushforwardContinuousComp' (eqToIso e) (Type w) J K L).hom.app
          ((vw.sheafPullback (Type w) J L).obj F) :=
  rfl

/-- The `hom` form of `comp'_inv_cocycle`. -/
private theorem comp'_hom_cocycle {v : X ⥤ Y} {w : Y ⥤ Z} {x : Z ⥤ T} {vw : X ⥤ Z} {wx : Y ⥤ T}
    {vwx : X ⥤ T} (e₁ : v ⋙ w = vw) (e₂ : w ⋙ x = wx) (e₃ : v ⋙ wx = vwx) (e₄ : vw ⋙ x = vwx)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    (M : GrothendieckTopology T) [v.IsContinuous J K] [w.IsContinuous K L] [x.IsContinuous L M]
    [vw.IsContinuous J L] [wx.IsContinuous K M] [vwx.IsContinuous J M] (N : Sheaf M (Type w)) :
    (Functor.sheafPushforwardContinuousComp' (eqToIso e₁) (Type w) J K L).hom.app
          ((x.sheafPushforwardContinuous (Type w) L M).obj N) ≫
        (Functor.sheafPushforwardContinuousComp' (eqToIso e₄) (Type w) J L M).hom.app N =
      (v.sheafPushforwardContinuous (Type w) J K).map
          ((Functor.sheafPushforwardContinuousComp' (eqToIso e₂) (Type w) K L M).hom.app N) ≫
        (Functor.sheafPushforwardContinuousComp' (eqToIso e₃) (Type w) J K M).hom.app N := by
  subst e₁ e₂
  subst e₃
  obtain rfl : e₄ = rfl := rfl
  simp only [eqToIso_refl, comp'_refl_hom_app]
  rfl

/-- **The canonical maps of equation (09YM) compose.** For a two-step factorization the canonical
map of the whole is the canonical map of the first step followed by that of the second. This is
`unitFac_comp` transported to the natural transformations of `sectionsNat`, and it is the
directedness that `preservesFiniteLimits_of_jointlySurjective` asks for. -/
private theorem sectionsNat_comp {v : X ⥤ Y} {w : Y ⥤ Z} {x : Z ⥤ T} {vw : X ⥤ Z} {wx : Y ⥤ T}
    {vwx : X ⥤ T} (e₁ : v ⋙ w = vw) (e₂ : w ⋙ x = wx) (e₃ : v ⋙ wx = vwx) (e₄ : vw ⋙ x = vwx)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    (M : GrothendieckTopology T) [v.IsContinuous J K] [w.IsContinuous K L] [x.IsContinuous L M]
    [vw.IsContinuous J L] [wx.IsContinuous K M] [vwx.IsContinuous J M] :
    sectionsNat e₁ J K L ≫ sectionsNat e₄ J L M = sectionsNat e₃ J K M := by
  refine NatTrans.ext (funext fun F => ?_)
  have hnat :
    (v.sheafPushforwardContinuous (Type w) J K).map
          ((w.sheafPushforwardContinuous (Type w) K L).map (unitFac e₄ J L M F)) ≫
        (Functor.sheafPushforwardContinuousComp' (eqToIso e₁) (Type w) J K L).hom.app
          ((x.sheafPushforwardContinuous (Type w) L M).obj
            ((vwx.sheafPullback (Type w) J M).obj F)) =
      (Functor.sheafPushforwardContinuousComp' (eqToIso e₁) (Type w) J K L).hom.app
          ((vw.sheafPullback (Type w) J L).obj F) ≫
        (vw.sheafPushforwardContinuous (Type w) J L).map (unitFac e₄ J L M F) :=
    (Functor.sheafPushforwardContinuousComp' (eqToIso e₁) (Type w) J K L).hom.naturality _
  rw [NatTrans.comp_app, sectionsNat_app, sectionsNat_app, sectionsNat_app,
    unitFac_comp e₁ e₂ e₃ e₄ J K L M, Functor.map_comp, Functor.map_comp]
  simp only [Category.assoc]
  slice_lhs 2 3 => rw [← hnat]
  slice_lhs 3 4 => rw [comp'_hom_cocycle e₁ e₂ e₃ e₄ J K L M]

/-- `sectionsNat_comp`, read on sections over `v A`. -/
private theorem sectionsNat_comp_apply {v : X ⥤ Y} {w : Y ⥤ Z} {x : Z ⥤ T} {vw : X ⥤ Z}
    {wx : Y ⥤ T} {vwx : X ⥤ T} (e₁ : v ⋙ w = vw) (e₂ : w ⋙ x = wx) (e₃ : v ⋙ wx = vwx)
    (e₄ : vw ⋙ x = vwx) (J : GrothendieckTopology X) (K : GrothendieckTopology Y)
    (L : GrothendieckTopology Z) (M : GrothendieckTopology T) [v.IsContinuous J K]
    [w.IsContinuous K L] [x.IsContinuous L M] [vw.IsContinuous J L] [wx.IsContinuous K M]
    [vwx.IsContinuous J M] (F : Sheaf J (Type w)) (A : X)
    (y : ((v.sheafPullback (Type w) J K).obj F).obj.obj (op (v.obj A))) :
    ((sectionsNat e₄ J L M).app F).hom.app (op A)
        (((sectionsNat e₁ J K L).app F).hom.app (op A) y) =
      ((sectionsNat e₃ J K M).app F).hom.app (op A) y := by
  rw [← sectionsNat_comp e₁ e₂ e₃ e₄ J K L M]
  rfl

/-- If two sections of `v_s F` over `v A` have the same image under the unit of the
`w`-adjunction, they have the same image under the canonical map of the factorization: the latter
is the former followed by the comparison isomorphism. -/
private theorem unitFac_app_eq_of_unit_app_eq {v : X ⥤ Y} {w : Y ⥤ Z} {vw : X ⥤ Z} (e : v ⋙ w = vw)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    [v.IsContinuous J K] [w.IsContinuous K L] [vw.IsContinuous J L] (F : Sheaf J (Type w)) (A : Y)
    {y y' : ((v.sheafPullback (Type w) J K).obj F).obj.obj (op A)}
    (h :
      ((w.sheafAdjunctionContinuous (Type w) K L).unit.app
              ((v.sheafPullback (Type w) J K).obj F)).hom.app
          (op A) y =
        ((w.sheafAdjunctionContinuous (Type w) K L).unit.app
              ((v.sheafPullback (Type w) J K).obj F)).hom.app
          (op A) y') :
    (unitFac e J K L F).hom.app (op A) y = (unitFac e J K L F).hom.app (op A) y' := by
  rw [unitFac_eq_unit_comp_map]
  exact
    TypeCat.congr_arg
      (((w.sheafPushforwardContinuous (Type w) K L).map
            ((sheafPullbackFacIso e J K L).inv.app F)).hom.app
        (op A))
      h

/-- An isomorphism of sheaves of sets is injective on sections. -/
private theorem eq_of_iso_inv_app_eq {E : Type w} [SmallCategory E] {L : GrothendieckTopology E}
    {M N : Sheaf L (Type w)} (φ : M ≅ N) (V : Eᵒᵖ) {x y : N.obj.obj V}
    (h : φ.inv.hom.app V x = φ.inv.hom.app V y) : x = y := by
  have h1 : ∀ z : N.obj.obj V, φ.hom.hom.app V (φ.inv.hom.app V z) = z := fun z =>
    ConcreteCategory.congr_hom (congrArg (fun m : N ⟶ N => NatTrans.app m.hom V) φ.inv_hom_id) z
  rw [← h1 x, h, h1]

/-- The converse of `unitFac_app_eq_of_unit_app_eq`: two sections of `v_s F` over `v A` with the
same image under the canonical map of the factorization already have the same image under the unit
of the `w`-adjunction, the comparison isomorphism being injective on sections. This is what turns
the separatedness clause of Stacks 09YN, phrased with the maps of the system, into the one of
equation (09YM), phrased with the unit. -/
private theorem unit_app_eq_of_unitFac_app_eq {v : X ⥤ Y} {w : Y ⥤ Z} {vw : X ⥤ Z} (e : v ⋙ w = vw)
    (J : GrothendieckTopology X) (K : GrothendieckTopology Y) (L : GrothendieckTopology Z)
    [v.IsContinuous J K] [w.IsContinuous K L] [vw.IsContinuous J L] (F : Sheaf J (Type w)) (A : Y)
    {y y' : ((v.sheafPullback (Type w) J K).obj F).obj.obj (op A)}
    (h : (unitFac e J K L F).hom.app (op A) y = (unitFac e J K L F).hom.app (op A) y') :
    ((w.sheafAdjunctionContinuous (Type w) K L).unit.app
            ((v.sheafPullback (Type w) J K).obj F)).hom.app
        (op A) y =
      ((w.sheafAdjunctionContinuous (Type w) K L).unit.app
            ((v.sheafPullback (Type w) J K).obj F)).hom.app
        (op A) y' := by
  rw [unitFac_eq_unit_comp_map] at h
  exact eq_of_iso_inv_app_eq ((sheafPullbackFacIso e J K L).app F) (op (w.obj A)) h

/-- The same statement for `sectionsNat`: its value at an object of the source is the value of
`unitFac` followed by the comparison isomorphism of pushforwards. -/
private theorem sectionsNat_app_eq_of_unit_app_eq {v : X ⥤ Y} {w : Y ⥤ Z} {vw : X ⥤ Z}
    (e : v ⋙ w = vw) (J : GrothendieckTopology X) (K : GrothendieckTopology Y)
    (L : GrothendieckTopology Z) [v.IsContinuous J K] [w.IsContinuous K L] [vw.IsContinuous J L]
    (F : Sheaf J (Type w)) (A : X)
    {y y' : ((v.sheafPullback (Type w) J K).obj F).obj.obj (op (v.obj A))}
    (h :
      ((w.sheafAdjunctionContinuous (Type w) K L).unit.app
              ((v.sheafPullback (Type w) J K).obj F)).hom.app
          (op (v.obj A)) y =
        ((w.sheafAdjunctionContinuous (Type w) K L).unit.app
              ((v.sheafPullback (Type w) J K).obj F)).hom.app
          (op (v.obj A)) y') :
    ((sectionsNat e J K L).app F).hom.app (op A) y =
      ((sectionsNat e J K L).app F).hom.app (op A) y' := by
  have h1 := unitFac_app_eq_of_unit_app_eq e J K L F (v.obj A) h
  rw [sectionsNat_app]
  exact
    TypeCat.congr_arg
      (((Functor.sheafPushforwardContinuousComp' (eqToIso e) (Type w) J K L).hom.app
            ((vw.sheafPullback (Type w) J L).obj F)).hom.app
        (op A))
      h1

end FactorizationComp

section FilteredColimitExactness

/-- A terminal object of `Type w` has at most one element. -/
private theorem eq_of_isTerminal {S : Type w} (h : IsTerminal S) (a b : S) : a = b :=
  ConcreteCategory.congr_hom
    (h.hom_ext (↾fun _ : PUnit.{w + 1} => a) (↾fun _ : PUnit.{w + 1} => b)) PUnit.unit

/-- A terminal object of `Type w` has an element. -/
private theorem nonempty_of_isTerminal {S : Type w} (h : IsTerminal S) : Nonempty S :=
  ⟨h.from PUnit.{w + 1} PUnit.unit⟩

/-- Naturality of a morphism of set-valued functors, read on elements. -/
private theorem natTrans_app_map {A : Type u₃} [Category.{v₃} A] {F G : A ⥤ Type w} (σ : F ⟶ G)
    {X Y : A} (f : X ⟶ Y) (x : F.obj X) : σ.app Y (F.map f x) = G.map f (σ.app X x) :=
  ConcreteCategory.congr_hom (σ.naturality f) x

/-- In `Type w` the two projections of a limit pullback cone are jointly injective. -/
private theorem eq_of_isLimitPullbackCone {S₁ S₂ S₃ : Type w} {f : S₁ ⟶ S₃} {g : S₂ ⟶ S₃}
    {c : PullbackCone f g} (hc : IsLimit c) (z z' : c.pt) (h₁ : c.fst z = c.fst z')
    (h₂ : c.snd z = c.snd z') : z = z' := by
  have key : (↾fun _ : PUnit.{w + 1} => z) = (↾fun _ : PUnit.{w + 1} => z') :=
    PullbackCone.IsLimit.hom_ext hc (ConcreteCategory.hom_ext _ _ fun _ => h₁)
      (ConcreteCategory.hom_ext _ _ fun _ => h₂)
  exact ConcreteCategory.congr_hom key PUnit.unit

/-- In `Type w` a limit pullback cone has a point over every compatible pair of elements. -/
private theorem exists_of_isLimitPullbackCone {S₁ S₂ S₃ : Type w} {f : S₁ ⟶ S₃} {g : S₂ ⟶ S₃}
    {c : PullbackCone f g} (hc : IsLimit c) (a : S₁) (b : S₂) (hab : f a = g b) :
    ∃ z : c.pt, c.fst z = a ∧ c.snd z = b := by
  obtain ⟨l, hl₁, hl₂⟩ :=
    PullbackCone.IsLimit.lift' hc (↾fun _ : PUnit.{w + 1} => a) (↾fun _ : PUnit.{w + 1} => b)
      (ConcreteCategory.hom_ext _ _ fun _ => hab)
  exact
    ⟨l PUnit.unit, ConcreteCategory.congr_hom hl₁ PUnit.unit,
      ConcreteCategory.congr_hom hl₂ PUnit.unit⟩

/-- **A functor to sets which is a pointwise filtered colimit of left exact functors is left
exact.** Let `Φ : A ⥤ Type w` be equipped with a family of left exact functors `Ψ l` and natural
transformations `θ l : Ψ l ⟶ Φ` which are jointly surjective (`hsurj`), separated in the sense that
two elements with the same image under `θ l` are identified by some transition (`hsep`), and
directed in the sense that any two indices are dominated by a third compatibly with the `θ`
(`hcommon`). Then `Φ` preserves finite limits.

The transitions `τ` are *not* asked to form a functor: no cocycle condition between composites is
used. It is enough that each of them is compatible with the `θ`, which is what makes the hypothesis
available in the situation of equation (09YM), where the transitions are units of adjunctions and
their coherence is `unitFac_comp`, a statement about one composition at a time.

Only the terminal object and pullbacks are treated,
`preservesFiniteLimits_of_preservesTerminal_and_pullbacks`
supplying the rest; that is what keeps the directedness hypothesis to *pairs* of indices rather
than to finite families of them. -/
private theorem preservesFiniteLimits_of_jointlySurjective {A : Type u₃} [Category.{v₃} A]
    [HasFiniteLimits A] {Λ : Type u₄} [Nonempty Λ] (Φ : A ⥤ Type w) (Ψ : Λ → (A ⥤ Type w))
    (hΨ : ∀ l, PreservesFiniteLimits (Ψ l)) (θ : ∀ l, Ψ l ⟶ Φ)
    (hsurj : ∀ (G : A) (s : Φ.obj G), ∃ (l : Λ) (t : (Ψ l).obj G), (θ l).app G t = s)
    (hsep :
      ∀ (l : Λ) (G : A) (t t' : (Ψ l).obj G),
        (θ l).app G t = (θ l).app G t' →
          ∃ (m : Λ) (τ : Ψ l ⟶ Ψ m),
            (∀ (G' : A) (y : (Ψ l).obj G'), (θ m).app G' (τ.app G' y) = (θ l).app G' y) ∧
              τ.app G t = τ.app G t')
    (hcommon :
      ∀ l l' : Λ,
        ∃ (m : Λ) (τ : Ψ l ⟶ Ψ m) (τ' : Ψ l' ⟶ Ψ m),
          (∀ (G' : A) (y : (Ψ l).obj G'), (θ m).app G' (τ.app G' y) = (θ l).app G' y) ∧
            ∀ (G' : A) (y : (Ψ l').obj G'), (θ m).app G' (τ'.app G' y) = (θ l').app G' y) :
    PreservesFiniteLimits Φ := by
  have hpt : ∀ l : Λ, PreservesLimitsOfShape (Discrete PEmpty.{1}) (Ψ l) := fun l =>
    (hΨ l).preservesFiniteLimits _
  have hpc : ∀ l : Λ, PreservesLimitsOfShape WalkingCospan (Ψ l) := fun l =>
    (hΨ l).preservesFiniteLimits _
  have hterm : ∀ l : Λ, IsTerminal ((Ψ l).obj (⊤_ A)) := fun l =>
    terminalIsTerminal.isTerminalObj (Ψ l) (⊤_ A)
  -- `Φ` preserves the terminal object: its value there is nonempty by joint surjectivity applied
  -- to any index, and a subsingleton because two elements are represented at a common index.
  have hΦterm : IsTerminal (Φ.obj (⊤_ A)) := by
    let l₀ : Λ := Classical.arbitrary Λ
    have hne : Nonempty (Φ.obj (⊤_ A)) := ⟨(θ l₀).app _ (nonempty_of_isTerminal (hterm l₀)).some⟩
    have hss : ∀ s s' : Φ.obj (⊤_ A), s = s' := by
      intro s s'
      obtain ⟨l, t, ht⟩ := hsurj _ s
      obtain ⟨l', t', ht'⟩ := hsurj _ s'
      obtain ⟨m, τ, τ', hτ, hτ'⟩ := hcommon l l'
      rw [← ht, ← ht', ← hτ _ t, ← hτ' _ t', eq_of_isTerminal (hterm m) (τ.app _ t) (τ'.app _ t')]
    exact
      IsTerminal.ofUniqueHom (fun _ => ↾fun _ => hne.some) fun _ _ =>
        ConcreteCategory.hom_ext _ _ fun _ => hss _ _
  have : PreservesLimit (Functor.empty.{0} A) Φ :=
    preservesLimit_of_preserves_limit_cone terminalIsTerminal
      ((isLimitMapConeEmptyConeEquiv Φ (⊤_ A)).symm hΦterm)
  have : PreservesLimitsOfShape (Discrete PEmpty.{1}) Φ :=
    preservesLimitsOfShape_pempty_of_preservesTerminal Φ
  -- `Φ` preserves pullbacks.
  have hpb : ∀ {A₁ A₂ A₃ : A} (f : A₁ ⟶ A₃) (g : A₂ ⟶ A₃), PreservesLimit (cospan f g) Φ := by
    intro A₁ A₂ A₃ f g
    -- two elements of `Φ (A₁ ×_{A₃} A₂)` with the same projections agree: represent both at a
    -- common index, make the first projections agree there, then the second ones further down,
    -- and use that `Ψ` preserves the fibre product.
    have hmono :
      ∀ z₁ z₂ : Φ.obj (pullback f g),
        Φ.map (pullback.fst f g) z₁ = Φ.map (pullback.fst f g) z₂ →
          Φ.map (pullback.snd f g) z₁ = Φ.map (pullback.snd f g) z₂ → z₁ = z₂ := by
      intro z₁ z₂ h₁ h₂
      obtain ⟨k₁, u₁, hu₁⟩ := hsurj _ z₁
      obtain ⟨k₂, u₂, hu₂⟩ := hsurj _ z₂
      obtain ⟨m, ρ₁, ρ₂, hρ₁, hρ₂⟩ := hcommon k₁ k₂
      have ha₁ : (θ m).app _ (ρ₁.app _ u₁) = z₁ := by rw [hρ₁, hu₁]
      have ha₂ : (θ m).app _ (ρ₂.app _ u₂) = z₂ := by rw [hρ₂, hu₂]
      have e₁ :
        (θ m).app A₁ ((Ψ m).map (pullback.fst f g) (ρ₁.app _ u₁)) =
          (θ m).app A₁ ((Ψ m).map (pullback.fst f g) (ρ₂.app _ u₂)) := by
        rw [natTrans_app_map (θ m) (pullback.fst f g) (ρ₁.app _ u₁),
          natTrans_app_map (θ m) (pullback.fst f g) (ρ₂.app _ u₂), ha₁, ha₂]
        exact h₁
      obtain ⟨n₁, σ₁, hσ₁, hσ₁eq⟩ := hsep m A₁ _ _ e₁
      have e₂ :
        (θ n₁).app A₂ ((Ψ n₁).map (pullback.snd f g) (σ₁.app _ (ρ₁.app _ u₁))) =
          (θ n₁).app A₂ ((Ψ n₁).map (pullback.snd f g) (σ₁.app _ (ρ₂.app _ u₂))) := by
        rw [natTrans_app_map (θ n₁) (pullback.snd f g) (σ₁.app _ (ρ₁.app _ u₁)),
          natTrans_app_map (θ n₁) (pullback.snd f g) (σ₁.app _ (ρ₂.app _ u₂)), hσ₁ _ (ρ₁.app _ u₁),
          hσ₁ _ (ρ₂.app _ u₂), ha₁, ha₂]
        exact h₂
      obtain ⟨n₂, σ₂, hσ₂, hσ₂eq⟩ := hsep n₁ A₂ _ _ e₂
      have := hpc n₂
      have hstep :
        (Ψ n₁).map (pullback.fst f g) (σ₁.app _ (ρ₁.app _ u₁)) =
          (Ψ n₁).map (pullback.fst f g) (σ₁.app _ (ρ₂.app _ u₂)) := by
        rw [← natTrans_app_map σ₁ (pullback.fst f g) (ρ₁.app _ u₁), ←
          natTrans_app_map σ₁ (pullback.fst f g) (ρ₂.app _ u₂)]
        exact hσ₁eq
      have hfin : σ₂.app _ (σ₁.app _ (ρ₁.app _ u₁)) = σ₂.app _ (σ₁.app _ (ρ₂.app _ u₂)) := by
        refine
          eq_of_isLimitPullbackCone (isLimitOfHasPullbackOfPreservesLimit (Ψ n₂) f g) _ _ ?_ ?_
        · exact
            ((natTrans_app_map σ₂ (pullback.fst f g) (σ₁.app _ (ρ₁.app _ u₁))).symm.trans
                  (TypeCat.congr_arg (σ₂.app A₁) hstep)).trans
              (natTrans_app_map σ₂ (pullback.fst f g) (σ₁.app _ (ρ₂.app _ u₂)))
        · exact
            ((natTrans_app_map σ₂ (pullback.snd f g) (σ₁.app _ (ρ₁.app _ u₁))).symm.trans
                  hσ₂eq).trans
              (natTrans_app_map σ₂ (pullback.snd f g) (σ₁.app _ (ρ₂.app _ u₂)))
      rw [← ha₁, ← ha₂, ← hσ₁ _ (ρ₁.app _ u₁), ← hσ₁ _ (ρ₂.app _ u₂), ←
        hσ₂ _ (σ₁.app _ (ρ₁.app _ u₁)), ← hσ₂ _ (σ₁.app _ (ρ₂.app _ u₂)), hfin]
    -- and every compatible pair of elements is in the image.
    have hkey :
      ∀ (p : Φ.obj A₁) (q : Φ.obj A₂),
        Φ.map f p = Φ.map g q →
          ∃! z : Φ.obj (pullback f g),
            Φ.map (pullback.fst f g) z = p ∧ Φ.map (pullback.snd f g) z = q := by
      intro p q hpq
      obtain ⟨l, t, ht⟩ := hsurj _ p
      obtain ⟨l', t', ht'⟩ := hsurj _ q
      obtain ⟨m, τ, τ', hτ, hτ'⟩ := hcommon l l'
      have hxp : (θ m).app A₁ (τ.app _ t) = p := by rw [hτ, ht]
      have hyq : (θ m).app A₂ (τ'.app _ t') = q := by rw [hτ', ht']
      have hmid :
        (θ m).app A₃ ((Ψ m).map f (τ.app _ t)) = (θ m).app A₃ ((Ψ m).map g (τ'.app _ t')) := by
        rw [natTrans_app_map (θ m) f (τ.app _ t), natTrans_app_map (θ m) g (τ'.app _ t'), hxp, hyq]
        exact hpq
      obtain ⟨n, σ, hσ, hσeq⟩ := hsep m A₃ _ _ hmid
      have := hpc n
      have hn : (Ψ n).map f (σ.app A₁ (τ.app _ t)) = (Ψ n).map g (σ.app A₂ (τ'.app _ t')) := by
        rw [← natTrans_app_map σ f (τ.app _ t), ← natTrans_app_map σ g (τ'.app _ t')]
        exact hσeq
      obtain ⟨z', hz₁, hz₂⟩ :=
        exists_of_isLimitPullbackCone (isLimitOfHasPullbackOfPreservesLimit (Ψ n) f g) _ _ hn
      have hfst : Φ.map (pullback.fst f g) ((θ n).app _ z') = p :=
        ((natTrans_app_map (θ n) (pullback.fst f g) z').symm.trans
              (TypeCat.congr_arg ((θ n).app A₁) hz₁)).trans
          ((hσ A₁ (τ.app _ t)).trans hxp)
      have hsnd : Φ.map (pullback.snd f g) ((θ n).app _ z') = q :=
        ((natTrans_app_map (θ n) (pullback.snd f g) z').symm.trans
              (TypeCat.congr_arg ((θ n).app A₂) hz₂)).trans
          ((hσ A₂ (τ'.app _ t')).trans hyq)
      exact
        ⟨(θ n).app _ z', ⟨hfst, hsnd⟩, fun z hz =>
          hmono z _ (by rw [hz.1, hfst]) (by rw [hz.2, hsnd])⟩
    refine preservesLimit_of_preserves_limit_cone (pullbackIsPullback f g) ?_
    exact
      (isLimitMapConePullbackConeEquiv Φ (pullback.condition (f := f) (g := g))).symm
        (PullbackCone.IsLimit.mk _
          (fun s =>
            ↾fun z => (hkey (s.fst z) (s.snd z) (ConcreteCategory.congr_hom s.condition z)).choose)
          (fun s =>
            ConcreteCategory.hom_ext _ _ fun z =>
              (hkey (s.fst z) (s.snd z)
                  (ConcreteCategory.congr_hom s.condition z)).choose_spec.1.1)
          (fun s =>
            ConcreteCategory.hom_ext _ _ fun z =>
              (hkey (s.fst z) (s.snd z)
                  (ConcreteCategory.congr_hom s.condition z)).choose_spec.1.2)
          (fun s m hm₁ hm₂ =>
            ConcreteCategory.hom_ext _ _ fun z =>
              (hkey (s.fst z) (s.snd z) (ConcreteCategory.congr_hom s.condition z)).choose_spec.2
                (m z) ⟨ConcreteCategory.congr_hom hm₁ z, ConcreteCategory.congr_hom hm₂ z⟩))
  have : PreservesLimitsOfShape WalkingCospan Φ := by
    constructor
    intro Kd
    have := hpb (Kd.map WalkingCospan.Hom.inl) (Kd.map WalkingCospan.Hom.inr)
    exact preservesLimit_of_iso_diagram Φ (diagramIsoCospan Kd).symm
  exact preservesFiniteLimits_of_preservesTerminal_and_pullbacks Φ

end FilteredColimitExactness

section Evaluation

/-- The sections of a sheaf of sets over a fixed object, as a functor. -/
private abbrev evalSheaf {E : Type w} [SmallCategory E] (L : GrothendieckTopology E) (V : Eᵒᵖ) :
    Sheaf L (Type w) ⥤ Type w :=
  sheafToPresheaf L (Type w) ⋙ (evaluation Eᵒᵖ (Type w)).obj V

/-- Taking sections over an object is left exact: finite limits of sheaves are computed in
presheaves (Stacks 00W2), sheafification being a left adjoint of the inclusion, and finite limits
of presheaves are computed pointwise. -/
@[sga "3 IV 4.4.1" "(i)", sga "4 II 4.1" "Clause 3"]
private theorem preservesFiniteLimits_evalSheaf {E : Type w} [SmallCategory E]
    (L : GrothendieckTopology E) (V : Eᵒᵖ) : PreservesFiniteLimits (evalSheaf L V) := by
  have : PreservesLimitsOfSize.{0, 0} (sheafToPresheaf L (Type w)) :=
    (sheafificationAdjunction L (Type w)).rightAdjoint_preservesLimits
  have : PreservesFiniteLimits (sheafToPresheaf L (Type w)) :=
    PreservesLimitsOfSize.preservesFiniteLimits _
  have : PreservesFiniteLimits ((evaluation Eᵒᵖ (Type w)).obj V) := inferInstance
  exact comp_preservesFiniteLimits _ _

/-- **A functor into sheaves of sets is left exact as soon as taking sections over every object
is.**
Finite limits of sheaves are computed in presheaves, where they are computed pointwise, and
`sheafToPresheaf` is fully faithful, hence reflects limits. -/
@[sga "4 IV 4.6.3" "partial"]
private theorem preservesFiniteLimits_of_evalSheaf {A : Type u₄} [Category.{v₄} A] {E : Type w}
    [SmallCategory E] (L : GrothendieckTopology E) (Ξ : A ⥤ Sheaf L (Type w))
    (h : ∀ V : Eᵒᵖ, PreservesFiniteLimits (Ξ ⋙ evalSheaf L V)) : PreservesFiniteLimits Ξ := by
  have h1 : PreservesFiniteLimits (Ξ ⋙ sheafToPresheaf L (Type w)) := by
    constructor
    intro T _ _
    exact preservesLimitsOfShape_of_evaluation _ T fun V => (h V).preservesFiniteLimits T
  constructor
  intro T _ _
  constructor
  intro Gd
  constructor
  intro c hc
  exact
    ⟨isLimitOfReflects (sheafToPresheaf L (Type w))
        (isLimitOfPreserves (Ξ ⋙ sheafToPresheaf L (Type w)) hc)⟩

end Evaluation

section

variable {C : Type w} [SmallCategory C] (D : InverseSystemOfFiniteSites.{u₁, u₂, w})
  (u : ∀ i, D.C i ⥤ C)
  (hu : ∀ {i j : D.I} (a : i ⟶ j), D.u a ⋙ u i = u j)
  (hobj : ∀ X : C, ∃ (i : D.I) (Y : D.C i), (u i).obj Y = X)
  (hhom :
    ∀ (i : D.I) (X Y : D.C i) (f : (u i).obj X ⟶ (u i).obj Y),
      ∃ (j : D.I) (a : j ⟶ i) (g : (D.u a).obj X ⟶ (D.u a).obj Y),
        (u j).map g =
          eqToHom (Functor.congr_obj (hu a) X) ≫ f ≫ eqToHom (Functor.congr_obj (hu a) Y).symm)
  (hhom_inj :
    ∀ (i : D.I) (X Y : D.C i) (g₁ g₂ : X ⟶ Y),
      (u i).map g₁ = (u i).map g₂ → ∃ (j : D.I) (a : j ⟶ i), (D.u a).map g₁ = (D.u a).map g₂)
  (K : Precoverage C)
  (hK :
    ∀ (X : C) (R : Presieve X),
      R ∈ K X ↔
        ∃ (i : D.I) (Y : D.C i) (h : (u i).obj Y = X) (S : Presieve Y),
          S ∈ (D.J i).toPrecoverage Y ∧ S ∈ Precoverage.finite (D.C i) Y ∧ R = h ▸ S.map (u i))

/-- A finite family generating a covering sieve of `D.J i` is a covering of `D.C i` in the sense of
Stacks 00VH, that is a member of both `(D.J i).toPrecoverage` and `Precoverage.finite (D.C i)`.
Together with `InverseSystemOfFiniteSites.finiteCoverings` this says that the coverings of Stacks
00VH generate the topology `D.J i`. -/
private theorem ofArrows_mem_inf (i : D.I) {Z : D.C i} {ι : Type} [Finite ι] {Y : ι → D.C i}
    {f : ∀ t, Y t ⟶ Z} {S : Sieve Z} (hgen : Sieve.generate (Presieve.ofArrows Y f) = S)
    (hS : S ∈ D.J i Z) :
    Presieve.ofArrows Y f ∈ ((D.J i).toPrecoverage ⊓ Precoverage.finite (D.C i)) Z := by
  refine ⟨?_, Precoverage.ofArrows_mem_finite Y f⟩
  rw [GrothendieckTopology.mem_toPrecoverage_iff, hgen]
  exact hS

include hK in
/-- The image under `u i` of a covering of `D.C i` in the sense of Stacks 00VH is a covering of the
colimit: this is the description `hK` of `K` read in one direction. -/
private theorem map_mem_of_mem_inf (i : D.I) {Z : D.C i} {S : Presieve Z}
    (hS : S ∈ ((D.J i).toPrecoverage ⊓ Precoverage.finite (D.C i)) Z) :
    S.map (u i) ∈ K ((u i).obj Z) :=
  (hK _ _).2 ⟨i, Z, rfl, S, hS.1, hS.2, rfl⟩

include hK in
/-- Each `u i : D.C i ⥤ C` is cover-preserving for `D.J i` and the topology generated by the
coverings `K` of the colimit: a covering sieve of `D.J i` is generated by a finite family
(Stacks 0A34), the image of that family under `u i` is a covering of `C` by the description `hK`
of `K`, and the sieve it generates is the pushforward of the original sieve.

Only the description `hK` of the coverings of `C` is used; that `u` exhibits `C` as a colimit is
not. -/
private theorem coverPreserving_of_hK (i : D.I) :
    CoverPreserving (D.J i) K.toGrothendieck (u i) where
  cover_preserve {Z} {S} hS := by
    obtain ⟨R, hRS, hRcov, hRfin⟩ := D.finiteCoverings i S hS
    have h2 :=
      Precoverage.generate_mem_toGrothendieck (J := K)
        (map_mem_of_mem_inf D u K hK i ⟨hRcov, hRfin⟩)
    rw [Sieve.generate_map_eq_functorPushforward] at h2
    exact K.toGrothendieck.superset_covering
      (Sieve.functorPushforward_monotone (u i) _ ((Sieve.generate_le_iff _ _).2 hRS)) h2

/-- The coverings `K` of the colimit satisfy the three conditions of a site in the sense of
Stacks 00VH: a one-element family given by an isomorphism is a covering, coverings are stable under
refinement by coverings, and the fibre products of a covering along any morphism exist and again
form a covering.

This is Stacks 09YL. That lemma produces *some* precoverage with the membership described by `hK`,
and `hK` determines a precoverage uniquely, so the two agree. -/
private alias precoverage_conditions_of_hK :=
  Stacks.WeakSites.ColimitSheafSections.hasIsos_and_bind_and_pullbackArrows

/-- **A presheaf on a site whose coverings admit and are stable under fibre products is a sheaf as
soon as it has the sheaf property for those coverings.** For a precoverage `K` all of whose
coverings admit fibre products along an arbitrary morphism (`K.HasPullbacks`, Stacks 00VH (3),
existence half) and whose coverings are stable under forming them (`hcov`, Stacks 00VH (3)), the
sheaf condition for the *generated* topology — a condition on every covering sieve of
`K.toGrothendieck`, which is defined inductively and contains far more sieves than the ones
generated by a covering — is equivalent to the sheaf condition for the coverings themselves.

The two hypotheses say exactly that `K` underlies a `CategoryTheory.Coverage`, whose covering
presieves generate the same topology (`Coverage.toGrothendieck_toPrecoverage`) and detect its
sheaves (`Presieve.isSheaf_coverage`). Stated for a general precoverage because that is the
generality it holds in: nothing about the inverse system enters. -/
@[sga "4 II 2.3" "special case"]
private theorem isSheaf_toGrothendieck_iff (K' : Precoverage C) [K'.HasPullbacks]
    (hcov :
      ∀ (X Y : C) (f : Y ⟶ X) (R : Presieve X) [R.HasPullbacks f],
        R ∈ K' X → R.pullbackArrows f ∈ K' Y)
    (P : Cᵒᵖ ⥤ Type w) :
    Presheaf.IsSheaf K'.toGrothendieck P ↔
      ∀ ⦃X : C⦄ (R : Presieve X), R ∈ K' X → Presieve.IsSheafFor P R := by
  rw [isSheaf_iff_isSheaf_of_type]
  let Kc : Coverage C :=
    { __ := K'
      pullback := by
        intro X Y f S hS
        have : S.HasPullbacks f := Precoverage.hasPullbacks_of_mem f hS
        exact ⟨S.pullbackArrows f, hcov X Y f S hS, Presieve.FactorsThruAlong.pullbackArrows f S⟩ }
  have hKG : K'.toGrothendieck = Kc.toGrothendieck := Kc.toGrothendieck_toPrecoverage
  rw [hKG]
  exact Presieve.isSheaf_coverage Kc P

include hu hobj hhom hhom_inj hK in
/-- **The sheaf condition on the colimit site is the sheaf condition for finite coverings coming
from a level.** A presheaf on `C` is a sheaf for `K.toGrothendieck` if and only if it has the sheaf
property for every member of `K`, and by `hK` a member of `K` is the image under some `u i` of a
*finite* covering of `D.C i`.

This is the Lean form of the source's remark that "any covering `{U^t → U}` in `C` comes from a
finite level", which is what makes the sheaf condition on `C` a finite limit condition and hence
lets it commute with the filtered colimit defining the sections of `f_i^{-1}F`. Its inputs are
condition (3) of Stacks 00VH for `K`, both halves, which is Stacks 09YL
(`precoverage_conditions_of_hK`). -/
private theorem isSheaf_toGrothendieck_iff_of_hK (P : Cᵒᵖ ⥤ Type w) :
    Presheaf.IsSheaf K.toGrothendieck P ↔
      ∀ ⦃X : C⦄ (R : Presieve X), R ∈ K X → Presieve.IsSheafFor P R := by
  obtain ⟨-, -, hPB, hcov⟩ := precoverage_conditions_of_hK D u hu hobj hhom hhom_inj K hK
  have := hPB
  exact isSheaf_toGrothendieck_iff K hcov P

include hu in
/-- Continuity of the `u i` propagates along the arrows of `D.I`: if `u m` is continuous and
`d : m ⟶ i`, then `u i = D.u d ⋙ u m` is continuous, `D.u d` being continuous because `f_d` is a
morphism of sites (Stacks 0A34 (3)). So the family `{u i}` is continuous as soon as it is
continuous at a cofinal family of indices. -/
private theorem isContinuous_of_hom {m i : D.I} (d : m ⟶ i)
    [(u m).IsContinuous (D.J m) K.toGrothendieck] :
    (u i).IsContinuous (D.J i) K.toGrothendieck := by
  have := D.continuous d
  exact hu d ▸ Functor.isContinuous_comp (D.u d) (u m) (D.J i) (D.J m) K.toGrothendieck

/-- Left exactness of `u_s` transports along an equality of continuous functors. The two
continuity assumptions are proofs of the same proposition, so this is a transport of the
`sheafPullback` functor itself, which the equality cannot rewrite in place because that functor
takes continuity as an instance argument. -/
private theorem preservesFiniteLimits_sheafPullback_of_eq {X Y : Type w} [SmallCategory X]
    [SmallCategory Y] {F G : X ⥤ Y} (h : F = G) (J : GrothendieckTopology X)
    (L : GrothendieckTopology Y) [F.IsContinuous J L] [G.IsContinuous J L]
    (hF : PreservesFiniteLimits (F.sheafPullback (Type w) J L)) :
    PreservesFiniteLimits (G.sheafPullback (Type w) J L) := by
  subst h
  exact hF

include hu in
/-- Left exactness of `f_i^{-1}` propagates along the arrows of `D.I`: if `f_j^{-1}` is left exact
and `a : j ⟶ i`, then `f_i^{-1} ≅ f_a^{-1} ⋙ f_j^{-1}` is left exact, `f_a^{-1}` being left exact
because `f_a` is a morphism of sites (Stacks 0A34 (3)).

This is the identification `u_i = D.u a ⋙ u_j` of the source, on the pullback side; it is what
reduces the value of `f_i^{-1}F` at an arbitrary object `u_j V_j` of `C` to equation (09YM) at the
level `j`, applied to the sheaf `f_a^{-1}F`, so that the general case of the source's last
paragraph needs no separate colimit formula. -/
private theorem preservesFiniteLimits_sheafPullback_of_hom {i j : D.I} (a : j ⟶ i)
    [(u i).IsContinuous (D.J i) K.toGrothendieck] [(u j).IsContinuous (D.J j) K.toGrothendieck]
    (hj : PreservesFiniteLimits ((u j).sheafPullback (Type w) (D.J j) K.toGrothendieck)) :
    PreservesFiniteLimits ((u i).sheafPullback (Type w) (D.J i) K.toGrothendieck) := by
  have := D.continuous a
  have := (D.isMorphismOfSites a).preservesFiniteLimits
  have : (D.u a ⋙ u j).IsContinuous (D.J i) K.toGrothendieck :=
    Functor.isContinuous_comp (D.u a) (u j) (D.J i) (D.J j) K.toGrothendieck
  refine preservesFiniteLimits_sheafPullback_of_eq (hu a) (D.J i) K.toGrothendieck ?_
  have :
    PreservesFiniteLimits
      ((D.u a).sheafPullback (Type w) (D.J i) (D.J j) ⋙
        (u j).sheafPullback (Type w) (D.J j) K.toGrothendieck) :=
    comp_preservesFiniteLimits _ _
  exact
    preservesFiniteLimits_of_natIso
      (Functor.sheafPullbackComp (D.u a) (u j) (D.J i) (D.J j) K.toGrothendieck).symm

/-- The transport of a morphism `p : V ⟶ (D.u d).obj A` of the member `D.C l` along a further
transition `t : k ⟶ l`, with its target read in `D.C k` as `(D.u (t ≫ d)).obj A` rather than as
`(D.u t).obj ((D.u d).obj A)`. The two differ by the equality of functors
`D.u (t ≫ d) = D.u d ⋙ D.u t`, which is not a definitional one, so the transport is not
`(D.u t).map p` on the nose. -/
private def transportHom {i l k : D.I} {A : D.C i} {V : D.C l} {d : l ⟶ i} (t : k ⟶ l)
    (p : V ⟶ (D.u d).obj A) : (D.u t).obj V ⟶ (D.u (t ≫ d)).obj A :=
  (D.u t).map p ≫ eqToHom (Functor.congr_obj (D.comp t d) A).symm

/-- Transport commutes with composing with a morphism coming from `D.C i`. -/
private theorem transportHom_comp {i l k : D.I} {A B : D.C i} {V : D.C l} {d : l ⟶ i} (t : k ⟶ l)
    (p : V ⟶ (D.u d).obj A) (h : A ⟶ B) :
    transportHom D t p ≫ (D.u (t ≫ d)).map h = transportHom D t (p ≫ (D.u d).map h) := by
  have e := Functor.congr_hom (D.comp t d) h
  simp only [Functor.comp_map] at e
  simp [transportHom, e]

/-- An equality of parallel morphisms of a member persists further down the index category. -/
private theorem map_eq_of_map_eq {l k k' : D.I} {A B : D.C l} {x y : A ⟶ B} (b : k ⟶ l)
    (h : (D.u b).map x = (D.u b).map y) (e : k' ⟶ k) :
    (D.u (e ≫ b)).map x = (D.u (e ≫ b)).map y := by
  have hx := Functor.congr_hom (D.comp e b) x
  have hy := Functor.congr_hom (D.comp e b) y
  simp only [Functor.comp_map] at hx hy
  rw [hx, hy, h]

include hu in
/-- The image in `C` of a morphism of `D.C i` does not depend on the level it is read at. -/
private theorem map_transition_map {i l : D.I} (d : l ⟶ i) {A B : D.C i} (h : A ⟶ B) :
    (u l).map ((D.u d).map h) ≫ eqToHom (Functor.congr_obj (hu d) B) =
      eqToHom (Functor.congr_obj (hu d) A) ≫ (u i).map h := by
  have e := Functor.congr_hom (hu d) h
  simp only [Functor.comp_map] at e
  simp [e]

include hu in
/-- A descended morphism stays descended after transport further down the index category. -/
private theorem transportHom_map {i l k : D.I} {A : D.C i} {V : D.C l} {W : C} {d : l ⟶ i}
    (hV : (u l).obj V = W) {p : W ⟶ (u i).obj A} {p' : V ⟶ (D.u d).obj A}
    (hp : (u l).map p' ≫ eqToHom (Functor.congr_obj (hu d) A) = eqToHom hV ≫ p) (t : k ⟶ l) :
    (u k).map (transportHom D t p') ≫ eqToHom (Functor.congr_obj (hu (t ≫ d)) A) =
      eqToHom ((Functor.congr_obj (hu t) V).trans hV) ≫ p := by
  have e := map_transition_map D u hu t p'
  have h2 :
    eqToHom (congrArg (u k).obj (Functor.congr_obj (D.comp t d) A).symm) ≫
        eqToHom (Functor.congr_obj (hu (t ≫ d)) A) =
      eqToHom (Functor.congr_obj (hu t) ((D.u d).obj A)) ≫
        eqToHom (Functor.congr_obj (hu d) A) := by
    simp
  simp only [transportHom, Functor.map_comp, eqToHom_map, Category.assoc, h2]
  rw [← Category.assoc, e, Category.assoc, hp]
  simp

/-- **A factorization found at a level is one in the colimit.** Let `p' : V ⟶ (D.u d).obj A` have
image `p : W ⟶ u_i A` under `u l`, and let `h₃` factor the transport of `p'` to the level `k`
through the image of a morphism `π : P ⟶ A` of `D.C i`. Then the image of `h₃` in `C`, read on
`W = u_k((D.u b).obj V)`, factors `p` through `u_i π`.

This is the step both projections of `preservesLimit_cospan_of_mem` need, and the only place where
the two levels of transport — `hu b` for the source and `hu (b ≫ d)` for the target — have to be
reconciled; `transportHom_map` does that reconciliation and `map_transition_map` moves `π` from the
level `k` to the level `i`. -/
private theorem comp_map_eq_of_transportHom_fac {i l k : D.I} {A P : D.C i} {V : D.C l} {W : C}
    {d : l ⟶ i} (hV : (u l).obj V = W) {p : W ⟶ (u i).obj A} {p' : V ⟶ (D.u d).obj A}
    (hp : (u l).map p' ≫ eqToHom (Functor.congr_obj (hu d) A) = eqToHom hV ≫ p) (b : k ⟶ l)
    {h₃ : (D.u b).obj V ⟶ (D.u (b ≫ d)).obj P} {π : P ⟶ A}
    (hh : h₃ ≫ (D.u (b ≫ d)).map π = transportHom D b p') :
    (eqToHom ((Functor.congr_obj (hu b) V).trans hV).symm ≫
          (u k).map h₃ ≫ eqToHom (Functor.congr_obj (hu (b ≫ d)) P)) ≫
        (u i).map π =
      p := by
  have e := map_transition_map D u hu (b ≫ d) π
  have ep := transportHom_map D u hu hV hp b
  rw [← hh, Functor.map_comp] at ep
  rw [Category.assoc, Category.assoc, ← e, ← Category.assoc ((u k).map h₃), ep]
  simp

