/-- **A pair of morphisms of `C` out of a common source descends to a single level.** The source is
put over a level, the first morphism is descended there, the second over the level so obtained, and
the two resulting arrows to `i` are equalized by cofilteredness. This is the source's remark that a
finite diagram of `C` comes from a single member of the system, for a cospan. -/
private theorem exists_descent₂ {i : D.I} (A B : D.C i) {W : C} (p : W ⟶ (u i).obj A)
    (q : W ⟶ (u i).obj B) :
    ∃ (l : D.I) (d : l ⟶ i) (V : D.C l) (hV : (u l).obj V = W) (p' : V ⟶ (D.u d).obj A) (q' :
      V ⟶ (D.u d).obj B),
      (u l).map p' ≫ eqToHom (Functor.congr_obj (hu d) A) = eqToHom hV ≫ p ∧
        (u l).map q' ≫ eqToHom (Functor.congr_obj (hu d) B) = eqToHom hV ≫ q := by
  obtain ⟨l₀, V₀, hV₀⟩ := hobj W
  obtain ⟨l₁, c₁, d₁, p₁, hp₁⟩ := exists_descent_of_base D u hu hhom A V₀ hV₀ p
  have hV₁ : (u l₁).obj ((D.u c₁).obj V₀) = W := (Functor.congr_obj (hu c₁) V₀).trans hV₀
  obtain ⟨l₂, c₂, d₂, q₂, hq₂⟩ := exists_descent_of_base D u hu hhom B ((D.u c₁).obj V₀) hV₁ q
  have hp₂ := transportHom_map D u hu hV₁ hp₁ c₂
  obtain ⟨n, s, hs⟩ := IsCofilteredOrEmpty.cone_maps (c₂ ≫ d₁) d₂
  have hV₂ : (u l₂).obj ((D.u c₂).obj ((D.u c₁).obj V₀)) = W :=
    (Functor.congr_obj (hu c₂) _).trans hV₁
  have hp₃ := transportHom_map D u hu hV₂ hp₂ s
  have hq₃ := transportHom_map D u hu hV₂ hq₂ s
  refine
    ⟨n, s ≫ c₂ ≫ d₁, (D.u s).obj ((D.u c₂).obj ((D.u c₁).obj V₀)),
      (Functor.congr_obj (hu s) _).trans hV₂, transportHom D s (transportHom D c₂ p₁),
      transportHom D s q₂ ≫ eqToHom (by rw [hs]), hp₃, ?_⟩
  rw [Functor.map_comp, eqToHom_map, Category.assoc, eqToHom_trans]
  exact hq₃

/-- Two descended morphisms into the images of `f` and `g` with equal composites in `C` have images
under `u l` of the composites with `f` and `g` that agree. -/
private theorem map_comp_eq_of_descent {i l : D.I} (d : l ⟶ i) {A B Z : D.C i} (f : A ⟶ Z)
    (g : B ⟶ Z) {V : D.C l} {W : C} (hV : (u l).obj V = W) {p : W ⟶ (u i).obj A}
    {q : W ⟶ (u i).obj B} {p' : V ⟶ (D.u d).obj A} {q' : V ⟶ (D.u d).obj B}
    (hp : (u l).map p' ≫ eqToHom (Functor.congr_obj (hu d) A) = eqToHom hV ≫ p)
    (hq : (u l).map q' ≫ eqToHom (Functor.congr_obj (hu d) B) = eqToHom hV ≫ q)
    (h : p ≫ (u i).map f = q ≫ (u i).map g) :
    (u l).map (p' ≫ (D.u d).map f) = (u l).map (q' ≫ (D.u d).map g) := by
  have ef := map_transition_map D u hu d f
  have eg := map_transition_map D u hu d g
  rw [Functor.map_comp, Functor.map_comp, ← cancel_mono (f := eqToHom (Functor.congr_obj (hu d) Z))]
  simp only [Category.assoc, ef, eg]
  rw [← Category.assoc ((u l).map p'), hp, ← Category.assoc ((u l).map q'), hq, Category.assoc,
    Category.assoc, h]

/-- Transport along `t` of two morphisms whose composites with `f` and `g` agree after applying
`D.u t` still has equal composites with `f` and `g`. -/
private theorem transportHom_comp_eq_of_map_eq {i l k : D.I} {A B Z : D.C i} {V : D.C l}
    {d : l ⟶ i} (t : k ⟶ l) {p : V ⟶ (D.u d).obj A} {q : V ⟶ (D.u d).obj B} (f : A ⟶ Z)
    (g : B ⟶ Z) (h : (D.u t).map (p ≫ (D.u d).map f) = (D.u t).map (q ≫ (D.u d).map g)) :
    transportHom D t p ≫ (D.u (t ≫ d)).map f = transportHom D t q ≫ (D.u (t ≫ d)).map g := by
  rw [transportHom_comp, transportHom_comp]
  simp [transportHom, h]

include hu hobj hhom hhom_inj in
/-- The images under `u i` of the two projections of a fibre product `Y ×_Z X` of a covering of
`D.C i` are jointly monic in `C`. A pair of morphisms into `u_i(Y ×_Z X)` agreeing after both
projections descends to a level (`exists_descent₂`), the two agreements hold at a further level
(`hhom_inj`), and there the transition preserves the fibre product
(`InverseSystemOfFiniteSites.preservesPullbacks`), so the two descended morphisms are equal. -/
private theorem eq_of_comp_eq (i : D.I) {Z : D.C i} {R : Presieve Z}
    (hR : R ∈ ((D.J i).toPrecoverage ⊓ Precoverage.finite (D.C i)) Z) {Y X : D.C i} {f : Y ⟶ Z}
    {g : X ⟶ Z} (hg : R g) [HasPullback f g] {W : C} (m m' : W ⟶ (u i).obj (pullback f g))
    (h₁ : m ≫ (u i).map (pullback.fst f g) = m' ≫ (u i).map (pullback.fst f g))
    (h₂ : m ≫ (u i).map (pullback.snd f g) = m' ≫ (u i).map (pullback.snd f g)) : m = m' := by
  obtain ⟨l, d, V, hV, m₁, m₁', hm₁, hm₁'⟩ :=
    exists_descent₂ D u hu hobj hhom (pullback f g) (pullback f g) m m'
  obtain ⟨k₁, b₁, hb₁⟩ := hhom_inj l V _ _ _
    (map_comp_eq_of_descent D u hu d (pullback.fst f g) (pullback.fst f g) hV hm₁ hm₁' h₁)
  obtain ⟨k₂, b₂, hb₂⟩ := hhom_inj l V _ _ _
    (map_comp_eq_of_descent D u hu d (pullback.snd f g) (pullback.snd f g) hV hm₁ hm₁' h₂)
  obtain ⟨n, e₁, e₂, -⟩ := IsCofilteredOrEmpty.cone_objs k₁ k₂
  obtain ⟨n', s, hs⟩ := IsCofilteredOrEmpty.cone_maps (e₁ ≫ b₁) (e₂ ≫ b₂)
  have hT₁ := map_eq_of_map_eq D b₁ hb₁ (s ≫ e₁)
  have hT₂ := map_eq_of_map_eq D b₂ hb₂ (s ≫ e₂)
  rw [Category.assoc, ← hs, ← Category.assoc] at hT₂
  set t : n' ⟶ l := (s ≫ e₁) ≫ b₁ with ht
  have := D.preservesPullbacks (t ≫ d) hR hg f
  have hlim := isLimitOfHasPullbackOfPreservesLimit (D.u (t ≫ d)) f g
  -- `hlim` exhibits `(D.u (t ≫ d)).obj (Y ×_Z X)` as the fibre product of the images of `f` and
  -- `g` in `D.C n'`, and `hstep hT₁`, `hstep hT₂` say that `transportHom D t m₁` and
  -- `transportHom D t m₁'` have the same composites with its two projections, whose
  -- `PullbackCone.fst`/`snd` of a `PullbackCone.mk` are those maps definitionally.
  have hkey : transportHom D t m₁ = transportHom D t m₁' :=
    PullbackCone.IsLimit.hom_ext hlim
      (transportHom_comp_eq_of_map_eq D t (pullback.fst f g) (pullback.fst f g) hT₁)
      (transportHom_comp_eq_of_map_eq D t (pullback.snd f g) (pullback.snd f g) hT₂)
  have e₁' := transportHom_map D u hu hV hm₁ t
  have e₂' := transportHom_map D u hu hV hm₁' t
  rw [hkey, e₂'] at e₁'
  exact ((cancel_epi _).1 e₁').symm

include hu hobj hhom hhom_inj in
/-- Each `u i` carries a fibre product of two members of a covering of `D.C i` to a fibre product
in `C`. A pair of morphisms into `u_i Y` and `u_i X` agreeing over `u_i Z` descends to a level
(`exists_descent₂`), the agreement holds at a further level (`hhom_inj`), and there the transition
preserves the fibre product (`InverseSystemOfFiniteSites.preservesPullbacks`), so the pair factors;
the factorization is unique by `eq_of_comp_eq`. -/
private theorem preservesLimit_cospan_of_mem (i : D.I) {Z : D.C i} {R : Presieve Z}
    (hR : R ∈ ((D.J i).toPrecoverage ⊓ Precoverage.finite (D.C i)) Z) {Y X : D.C i} {f : Y ⟶ Z}
    {g : X ⟶ Z} (hg : R g) : PreservesLimit (cospan f g) (u i) := by
  have := D.hasPullbacks i
  have : R.HasPullbacks f := Precoverage.hasPullbacks_of_mem f hR
  have : HasPullback g f := Presieve.HasPullbacks.hasPullback f hg
  have : HasPullback f g := hasPullback_symmetry g f
  have key :
    ∀ (W : C) (p : W ⟶ (u i).obj Y) (q : W ⟶ (u i).obj X),
      p ≫ (u i).map f = q ≫ (u i).map g →
        ∃! h : W ⟶ (u i).obj (pullback f g),
          h ≫ (u i).map (pullback.fst f g) = p ∧ h ≫ (u i).map (pullback.snd f g) = q := by
    intro W p q hpq
    obtain ⟨l, d, V, hV, p', q', hp', hq'⟩ := exists_descent₂ D u hu hobj hhom Y X p q
    obtain ⟨k, b, hb⟩ := hhom_inj l V _ _ _ (map_comp_eq_of_descent D u hu d f g hV hp' hq' hpq)
    have := D.preservesPullbacks (b ≫ d) hR hg f
    have hlim := isLimitOfHasPullbackOfPreservesLimit (D.u (b ≫ d)) f g
    obtain ⟨h₃, hh₁, hh₂⟩ :=
      PullbackCone.IsLimit.lift' hlim (transportHom D b p') (transportHom D b q')
        (transportHom_comp_eq_of_map_eq D b f g hb)
    simp only [PullbackCone.mk_fst, PullbackCone.mk_snd] at hh₁ hh₂
    have hwp := comp_map_eq_of_transportHom_fac D u hu hV hp' b hh₁
    have hwq := comp_map_eq_of_transportHom_fac D u hu hV hq' b hh₂
    exact
      ⟨_, ⟨hwp, hwq⟩, fun m hm =>
        eq_of_comp_eq D u hu hobj hhom hhom_inj i hR hg m _ (by rw [hm.1, hwp])
          (by rw [hm.2, hwq])⟩
  refine preservesLimit_of_preserves_limit_cone (pullbackIsPullback f g) ?_
  refine
    (isLimitMapConePullbackConeEquiv (u i) (pullback.condition (f := f) (g := g))).symm
      (PullbackCone.IsLimit.mk _ (fun s => (key s.pt s.fst s.snd s.condition).choose)
        (fun s => (key s.pt s.fst s.snd s.condition).choose_spec.1.1)
        (fun s => (key s.pt s.fst s.snd s.condition).choose_spec.1.2)
        (fun s m hm₁ hm₂ => (key s.pt s.fst s.snd s.condition).choose_spec.2 m ⟨hm₁, hm₂⟩))

include hu hobj hhom hhom_inj hK in
omit hK in
/-- Each `u i` preserves the fibre products of a covering of `D.C i`: for a covering `{Y t → Z}` in
the sense of Stacks 00VH and indices `t, s`, the functor `u i` carries the fibre product
`Y t ×_Z Y s` of Stacks 00VH (3) to the fibre product `u_i(Y t) ×_{u_i Z} u_i(Y s)` in the colimit.
This is condition (2) of continuity in the sense of Stacks 00WV, for the functors `u i` rather than
for the transitions of the system.

It reduces to the same condition at a finite level. A pair `W ⟶ u_i(Y t)`, `W ⟶ u_i(Y s)` agreeing
over `u_i Z` comes from a level `d : l ⟶ i` of the system (`hobj`, `hhom`, `hhom_inj` and
cofilteredness of `D.I`), that is from a pair `V ⟶ (D.u d)(Y t)`, `V ⟶ (D.u d)(Y s)` over
`(D.u d) Z` with `u_l V = W`; if `D.u d` carries `Y t ×_Z Y s` to the fibre product of
`(D.u d)(Y t)` and `(D.u d)(Y s)` over `(D.u d) Z`, that pair factors through it, and applying
`u l` and `hu d` gives a factorization of the original pair through `u_i(Y t ×_Z Y s)`, unique by
`hhom_inj`.

That the transitions carry those fibre products to fibre products is the hypothesis
`InverseSystemOfFiniteSites.preservesPullbacks`, and it does not follow from the other fields.
Stacks 0A34 (3) asks each transition to be a morphism of sites `f_a` given by a functor `u_a`
*continuous in the sense of Stacks 00WV*, whose condition (2) is exactly that `u_a` commutes with
the fibre products of a covering; the structure carries the existence of those fibre products
(`hasPullbacks`, Stacks 00VH (3)), their preservation (`preservesPullbacks`, Stacks 00WV (2)) and
the exactness half of Stacks 00X1 (`isMorphismOfSites`) as three separate fields, because
`Functor.IsContinuous` — the conclusion of Stacks 00WW — implies neither of the last two. Let
`D.C j` be `{Z, Y₁, Y₂, A}` with `h_t : Y_t ⟶ Z` and `A = Y₁ ×_Z Y₂`, let `D.C i` be that
category together with an object `B` and a pair `B ⟶ Y₁`, `B ⟶ Y₂` over `Z` not factoring through
`A`, let `D.J j` be generated by `{h₁, h₂}` and `D.J i` by `{h₁, h₂}` together with the empty
covering of `B`. A `D.J i`-sheaf has a one-point value at `B`, so the restriction along the
inclusion `D.u : D.C j ⥤ D.C i` of a `D.J i`-sheaf is a `D.J j`-sheaf, i.e. `D.u` is continuous in
the sense of `Functor.IsContinuous`, while `D.u` does not preserve `A`. -/
private theorem pullbacksPreservedBy_of_hK (i : D.I) :
    ((D.J i).toPrecoverage ⊓ Precoverage.finite (D.C i)).PullbacksPreservedBy (u i) := by
  constructor
  intro X R hR
  constructor
  intro Y Z f g hf hg
  exact preservesLimit_cospan_of_mem D u hu hobj hhom hhom_inj i hR hg

include hu hobj hhom hhom_inj hK in
/-- Each `u i` is continuous for `D.J i` and the topology generated by the
coverings `K` of the colimit; equivalently, restriction along `(u i).op` sends sheaves of sets on
`C` to sheaves on `D.C i`. The source says this "is immediate from the arguments in the proof of
Lemma 09YL".

The argument. Let `F` be a sheaf on `(C, K.toGrothendieck)`, let `Z : D.C i` and let `S` be a
covering sieve of `Z`. By `InverseSystemOfFiniteSites.finiteCoverings`, `S` is generated by a
finite family `f t : Y t ⟶ Z`, and it suffices to amalgamate compatible families for that family
(`Presieve.isSheafFor_iff_generate`). Its image `{u_i (f t)}` is a `K`-covering of `u_i Z`
(`coverPreserving_of_hK`), for which `F` does amalgamate, so everything turns on the one point that
a family compatible over `D.C i` is compatible over `C`: given `a₁ : W ⟶ u_i (Y t)` and
`a₂ : W ⟶ u_i (Y s)` with `a₁ ≫ u_i (f t) = a₂ ≫ u_i (f s)`, the two restrictions of the family
must agree. The object `W` and the pair `(a₁, a₂)` come from a level of the system, say
`b₁ : V ⟶ (D.u d) (Y t)` and `b₂ : V ⟶ (D.u d) (Y s)` with `d : l ⟶ i` and `W = u_l V`
(`hobj`, `hhom`, `hhom_inj` and cofilteredness of `D.I`), whereas compatibility of the family is a
hypothesis about pairs in `D.C i`, not in `D.C l`. What closes that gap in the source is continuity
of `D.u d` in the sense of Stacks 00WV: the fibre product `Y t ×_Z Y s` exists in `D.C i`, which is
condition (3) of Stacks 00VH for the members of the system, and `D.u d` carries it to the fibre
product `(D.u d)(Y t) ×_{(D.u d) Z} (D.u d)(Y s)`, through which `(b₁, b₂)` therefore factors; the
two projections of `Y t ×_Z Y s` are a pair in `D.C i`, and compatibility there gives the equality.

Three remarks on the shape of this step.

* Mathlib's criterion `Functor.isContinuous_of_coverPreserving` is not available, because its
  hypothesis `CompatiblePreserving K.toGrothendieck (u i)` is false in general: it quantifies over
  presieves that need not be coverings, and there nothing forces the two restrictions to agree.
  Concretely, let `D.I` be `{0 ⟵ 1}`, which is cofiltered; let `D.C 0` have objects `Y, Z` and one
  non-identity arrow `g : Y ⟶ Z`; let `D.C 1` be `D.C 0` together with an object `X`, two arrows
  `f₁, f₂ : X ⟶ Y` and a single arrow `X ⟶ Z` (so `f₁ ≫ g = f₂ ≫ g`); let `D.u` be that inclusion
  and let both topologies be trivial. Then `C = D.C 1`, no `K`-covering of `Y` or `Z` is
  non-trivial, `K.toGrothendieck` is trivial and every presheaf on `C` is a sheaf. Take
  `T = {g}`, which is *not* a covering, so every family of elements on `T` is compatible for
  vacuous reasons, and take the presheaf `F` with `F Z = ∅`, `F Y = F X = Bool` and
  `F f₁ ≠ F f₂`. Compatible-preservation applied to `f₁, f₂` would force `F f₁ = F f₂`.
* Both inputs to the argument above are carried by `InverseSystemOfFiniteSites`, and neither by the
  Grothendieck topologies alone. The fibre products of a covering of a member are condition (3) of
  Stacks 00VH, which a `GrothendieckTopology` does not give, and are the field `hasPullbacks`;
  their preservation by `D.u d` is condition (2) of continuity in the sense of Stacks 00WV, which
  `InverseSystemOfFiniteSites.continuous` — the *conclusion* of Stacks 00WW, that restriction along
  `D.u d` carries sheaves to sheaves — does not imply, and is the field `preservesPullbacks`.
  The fibre products produced by Stacks 09YL (`precoverage_conditions_of_hK`) would not substitute:
  they are those of `C`, not of the members, and a pair `(b₁, b₂)` as above factors through
  `u_i (Y t) ×_{u_i Z} u_i (Y s)`, an object that again comes from some level of the system with no
  reason to be `u_i` of an object of `D.C i`.
* Stacks 00WW does not imply Stacks 00WV. Let `D.C j` be `{Z, Y₁, Y₂, A}` with `h_t : Y_t ⟶ Z` and
  `A = Y₁ ×_Z Y₂`, let `D.C i` be that category together with an object `B` and a pair
  `B ⟶ Y₁`, `B ⟶ Y₂` over `Z` not factoring through `A`, let `D.J j` be generated by `{h₁, h₂}` and
  `D.J i` by `{h₁, h₂}` together with the empty covering of `B`. A `D.J i`-sheaf has a one-point
  value at `B`, so its restriction along the inclusion `D.u : D.C j ⥤ D.C i` has the sheaf property
  for `{h₁, h₂}`, i.e. `D.u` is continuous in the sense of `Functor.IsContinuous`; but `D.u` does
  not preserve `A`, the fibre product of the covering `{h₁, h₂}`.
* `Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy`, Stacks 00WW for the generated
  Grothendieck topologies (registered as
  `Functor.isContinuous_toGrothendieck_of_preservesLimit_cospan`), whose hypotheses
  `Precoverage.HasPullbacks` and `Precoverage.PullbacksPreservedBy` follow from Stacks 00VH (3)
  and 00WV (2), is nevertheless **not** applicable here: it also asks both precoverages to
  be `Precoverage.IsStableUnderBaseChange`, and that class is stated for `Presieve.pullback`, the
  presieve of *all* `g` with `g ≫ f` in the covering, not for the finite family
  `Presieve.pullbackArrows` of Stacks 00VH (3). Neither `K` nor
  `(D.J i).toPrecoverage ⊓ Precoverage.finite (D.C i)` satisfies it, both consisting of families
  with a finite index set. So the descent has to be run by hand, off
  `Presieve.isSheafFor_iff_generate` and `coverPreserving_of_hK`, as described above. -/
private theorem isContinuous_of_hK (i : D.I) : (u i).IsContinuous (D.J i) K.toGrothendieck where
  op_comp_isSheaf_of_types G := by
    rw [← StacksWeakAux.toGrothendieck_inf_finite_eq D i,
      Precoverage.isSheaf_toGrothendieck_iff]
    intro Z T ξ R hR
    obtain ⟨ι, hι, Y, g, rfl⟩ := StacksWeakAux.exists_ofArrows_of_mem_finite R hR.2
    have := hι
    have := D.hasPullbacks i
    have : (Presieve.ofArrows Y g).HasPullbacks ξ :=
      Precoverage.hasPullbacks_of_mem ξ hR
    obtain ⟨α, hα, B, q, hgen⟩ := StacksWeakAux.exists_finite_generating_pullback Y g ξ
    have := hα
    have hmem :
      Presieve.ofArrows B q ∈ ((D.J i).toPrecoverage ⊓ Precoverage.finite (D.C i)) T := by
      refine ⟨?_, Precoverage.ofArrows_mem_finite B q⟩
      rw [GrothendieckTopology.mem_toPrecoverage_iff, hgen]
      exact (D.J i).pullback_stable ξ ((GrothendieckTopology.mem_toPrecoverage_iff _ _).1 hR.1)
    have : (Presieve.ofArrows B q).HasPairwisePullbacks :=
      Precoverage.hasPairwisePullbacks_of_mem _ hmem
    have : (u i).PreservesPairwisePullbacks (Presieve.ofArrows B q) :=
      (pullbacksPreservedBy_of_hK D u hu hobj hhom hhom_inj i).preservesPairwisePullbacks_of_mem
        hmem
    have key : Presieve.IsSheafFor ((u i).op ⋙ G.obj) (Presieve.ofArrows B q) := by
      rw [Presieve.IsSheafFor.comp_iff_of_preservesPairwisePullbacks]
      exact
        ((isSheaf_iff_isSheaf_of_type _ _).1 G.property).isSheafFor _
          (Precoverage.generate_mem_toGrothendieck (map_mem_of_mem_inf D u K hK i hmem))
    rw [← hgen]
    exact (Presieve.isSheafFor_iff_generate _).1 key

include hu hobj hhom hhom_inj hK in
/-- **The functors to the colimit site are continuous**: the public form of the continuity that
Stacks 09YL's conditions on `hobj`, `hhom`, `hhom_inj` and `hK` give. -/
public theorem isContinuous_toColimitSite (i : D.I) :
    (u i).IsContinuous (D.J i) K.toGrothendieck :=
  isContinuous_of_hK D u hu hobj hhom hhom_inj K hK i

/-- The image of a presieve under a composite functor. -/
private theorem map_map_of_comp {A B E : Type w} [SmallCategory A] [SmallCategory B]
    [SmallCategory E] (v : A ⥤ B) (x : B ⥤ E) {Y : A} (S : Presieve Y) :
    (S.map v).map x = S.map (v ⋙ x) := by
  refine le_antisymm ?_ ?_
  · rintro W f ⟨h⟩
    obtain ⟨h'⟩ := h
    exact Presieve.map_map h'
  · rintro W f ⟨h⟩
    exact Presieve.map_map (Presieve.map_map h)

/-- The image of a presieve under a factorization `v ⋙ x = vx`, transported to the object
`vx.obj Y`: the two-step image and the one-step image agree. This is the form in which the
description `hK` of the coverings of the colimit is descended to a deeper level. -/
private theorem transport_map_eq {A B E : Type w} [SmallCategory A] [SmallCategory B]
    [SmallCategory E] {v : A ⥤ B} {x : B ⥤ E} {vx : A ⥤ E} (e : v ⋙ x = vx) {Y : A} {W : E}
    (h : vx.obj Y = W) (S : Presieve Y) :
    h ▸ S.map vx = ((Functor.congr_obj e Y).trans h) ▸ (S.map v).map x := by
  subst e
  exact congrArg (fun T => h ▸ T) (map_map_of_comp v x S).symm

/-- **The system restricted to the levels below `i`.** Its index category is the category `Over i`
of arrows into `i`, which is again cofiltered, and all of its data is that of `D` read at the
source of the arrow.

This is what makes equation (09YM) an instance of Stacks 09YN, whose data is a sheaf at *every*
level of a system: over `Over i` the assignment `a ↦ f_a^{-1}F` of (09YM) is such a family, whereas
over `D.I` it is not defined at a level admitting no arrow to `i`, and the levels below `i` are
cofinal by cofilteredness of `D.I` — which is exactly what `hobjOver`, `hhomOver`, `hhomInjOver`
and `hKOver` below say. -/
private def restrictOver (i : D.I) : InverseSystemOfFiniteSites.{u₁, max u₂ u₁, w} where
  I := Over i
  C p := D.C p.left
  J p := D.J p.left
  finiteCoverings p := D.finiteCoverings p.left
  u {p q : Over i} (a : p ⟶ q) := D.u a.left
  isMorphismOfSites {p q : Over i} (a : p ⟶ q) := D.isMorphismOfSites a.left
  hasPullbacks p := D.hasPullbacks p.left
  coverPreserving {p q : Over i} (a : p ⟶ q) := D.coverPreserving a.left
  preservesPullbacks {p q : Over i} (a : p ⟶ q) := D.preservesPullbacks a.left
  comp {p q r : Over i} (b : p ⟶ q) (a : q ⟶ r) := D.comp b.left a.left
  id_map p := D.id_map p.left

/-- The functors to the colimit, reindexed over the levels below `i`. -/
private def uOver (i : D.I) : ∀ p : (restrictOver D i).I, (restrictOver D i).C p ⥤ C := fun p =>
  u p.left

include hu in
/-- `u` still exhibits `C` as the colimit of the restricted system: the factorizations. -/
private theorem huOver (i : D.I) {p q : (restrictOver D i).I} (a : p ⟶ q) :
    (restrictOver D i).u a ⋙ uOver D u i p = uOver D u i q :=
  hu a.left

include hu hobj in
/-- Every object of `C` comes from a level below `i`: it comes from some level `m`, and `D.I` being
cofiltered there is a level dominating both `m` and `i`. -/
private theorem hobjOver (i : D.I) (X : C) :
    ∃ (p : (restrictOver D i).I) (Y : (restrictOver D i).C p), (uOver D u i p).obj Y = X := by
  obtain ⟨m, Y, hY⟩ := hobj X
  obtain ⟨n, c, d, -⟩ := IsCofilteredOrEmpty.cone_objs m i
  exact ⟨Over.mk d, (D.u c).obj Y, (Functor.congr_obj (hu c) Y).trans hY⟩

include hu hhom in
/-- Every morphism between objects of a level below `i` comes from a level below `i`: the level it
comes from is equipped with an arrow to `i` by composing. -/
private theorem hhomOver (i : D.I) (p : (restrictOver D i).I) (X Y : (restrictOver D i).C p)
    (f : (uOver D u i p).obj X ⟶ (uOver D u i p).obj Y) :
    ∃ (q : (restrictOver D i).I) (a : q ⟶ p) (g :
      ((restrictOver D i).u a).obj X ⟶ ((restrictOver D i).u a).obj Y),
      (uOver D u i q).map g =
        eqToHom (Functor.congr_obj (huOver D u hu i a) X) ≫
          f ≫ eqToHom (Functor.congr_obj (huOver D u hu i a) Y).symm := by
  obtain ⟨m, a, g, hg⟩ := hhom p.left X Y f
  exact ⟨Over.mk (a ≫ p.hom), Over.homMk a, g, hg⟩

include hhom_inj in
/-- Two morphisms of a level below `i` with the same image are already equal at a level below `i`.
-/
private theorem hhomInjOver (i : D.I) (p : (restrictOver D i).I) (X Y : (restrictOver D i).C p)
    (g₁ g₂ : X ⟶ Y) (h : (uOver D u i p).map g₁ = (uOver D u i p).map g₂) :
    ∃ (q : (restrictOver D i).I) (a : q ⟶ p),
      ((restrictOver D i).u a).map g₁ = ((restrictOver D i).u a).map g₂ := by
  obtain ⟨m, a, hm⟩ := hhom_inj p.left X Y g₁ g₂ h
  exact ⟨Over.mk (a ≫ p.hom), Over.homMk a, hm⟩

include hu hK in
/-- **The coverings of `C` are the images of the finite coverings of the levels below `i`.** One
direction is a weakening of `hK`; the other pushes a covering of a level `m` forward along a
transition to a level dominating both `m` and `i`, where it is still a finite covering
(`InverseSystemOfFiniteSites.coverPreserving`) with the same image in `C` (`transport_map_eq`). -/
private theorem hKOver (i : D.I) (X : C) (R : Presieve X) :
    R ∈ K X ↔
      ∃ (p : (restrictOver D i).I) (Y : (restrictOver D i).C p) (h : (uOver D u i p).obj Y = X) (S
        : Presieve Y),
        S ∈ ((restrictOver D i).J p).toPrecoverage Y ∧
          S ∈ Precoverage.finite ((restrictOver D i).C p) Y ∧ R = h ▸ S.map (uOver D u i p) := by
  refine
    ⟨fun hR => ?_, fun ⟨p, Y, h, S, hS1, hS2, hRS⟩ => (hK X R).2 ⟨p.left, Y, h, S, hS1, hS2, hRS⟩⟩
  obtain ⟨m, Y, h, S, hS1, hS2, hRS⟩ := (hK X R).1 hR
  obtain ⟨n, c, d, -⟩ := IsCofilteredOrEmpty.cone_objs m i
  obtain ⟨hm1, hm2⟩ := D.coverPreserving c Y ⟨hS1, hS2⟩
  refine
    ⟨Over.mk d, (D.u c).obj Y, (Functor.congr_obj (hu c) Y).trans h, S.map (D.u c), hm1, hm2, ?_⟩
  rw [hRS]
  exact transport_map_eq (hu c) h S

/-- The factorization `D.u p.hom ⋙ D.u a.left = D.u q.hom` of the transitions of the restricted
system attached to an arrow `a : q ⟶ p` of `Over i`. -/
private theorem compOver {i : D.I} {p q : Over i} (a : q ⟶ p) :
    D.u p.hom ⋙ D.u a.left = D.u q.hom :=
  (D.comp a.left p.hom).symm.trans (congrArg (fun τ : q.left ⟶ i => D.u τ) (Over.w a))

/-- **The transition maps of the family `a ↦ f_a^{-1}F` of equation (09YM), in the pushforward form
of Stacks 09YN.** For `a : q ⟶ p` in `Over i` it is the canonical map of the factorization
`compOver a`, that is the unit of the `D.u a.left`-adjunction followed by the comparison
isomorphism `f_{a.left}^{-1}f_{p.hom}^{-1}F ≅ f_{q.hom}^{-1}F`. -/
private noncomputable def psiOver {i : D.I}
    (hcontu : ∀ {m n : D.I} (a : m ⟶ n), (D.u a).IsContinuous (D.J n) (D.J m))
    (F : Sheaf (D.J i) (Type w)) {p q : Over i} (a : q ⟶ p) :
    (((D.u p.hom).sheafPullback (Type w) (D.J i) (D.J p.left)).obj F).obj ⟶
      (D.u a.left).op ⋙ (((D.u q.hom).sheafPullback (Type w) (D.J i) (D.J q.left)).obj F).obj :=
  (unitFac (compOver D a) (D.J i) (D.J p.left) (D.J q.left) F).hom

private theorem psiOver_def {i : D.I}
    (hcontu : ∀ {m n : D.I} (a : m ⟶ n), (D.u a).IsContinuous (D.J n) (D.J m))
    (F : Sheaf (D.J i) (Type w)) {p q : Over i} (a : q ⟶ p) :
    psiOver D hcontu F a = (unitFac (compOver D a) (D.J i) (D.J p.left) (D.J q.left) F).hom :=
  rfl

include hu in
/-- **The structure maps of the colimit, in the pushforward form of Stacks 09YN.** For `p : Over i`
it is the canonical map of the factorization `hu p.hom : D.u p.hom ⋙ u p.left = u i`, whose value
at `U` is the map `θ p.hom` of equation (09YM). -/
private noncomputable def iotaOver {i : D.I}
    (hcontu : ∀ {m n : D.I} (a : m ⟶ n), (D.u a).IsContinuous (D.J n) (D.J m))
    (hcontc : ∀ m, (u m).IsContinuous (D.J m) K.toGrothendieck) (F : Sheaf (D.J i) (Type w))
    (p : Over i) :
    (((D.u p.hom).sheafPullback (Type w) (D.J i) (D.J p.left)).obj F).obj ⟶
      (u p.left).op ⋙ (((u i).sheafPullback (Type w) (D.J i) K.toGrothendieck).obj F).obj :=
  (unitFac (hu p.hom) (D.J i) (D.J p.left) K.toGrothendieck F).hom

include hu in
private theorem iotaOver_def {i : D.I}
    (hcontu : ∀ {m n : D.I} (a : m ⟶ n), (D.u a).IsContinuous (D.J n) (D.J m))
    (hcontc : ∀ m, (u m).IsContinuous (D.J m) K.toGrothendieck) (F : Sheaf (D.J i) (Type w))
    (p : Over i) :
    iotaOver D u hu K hcontu hcontc F p =
      (unitFac (hu p.hom) (D.J i) (D.J p.left) K.toGrothendieck F).hom :=
  rfl

/-- **The cocycle condition `hψ` of Stacks 09YN for the family `psiOver`.** It is `unitFac_comp`
for the two-step factorization `D.u p.hom ⋙ D.u a.left = D.u q.hom`,
`D.u a.left ⋙ D.u b.left = D.u (b ≫ a).left`, read on sections. -/
private theorem psiOver_comp {i : D.I}
    (hcontu : ∀ {m n : D.I} (a : m ⟶ n), (D.u a).IsContinuous (D.J n) (D.J m))
    (F : Sheaf (D.J i) (Type w)) {p q r : Over i} (a : q ⟶ p) (b : r ⟶ q) (V : D.C p.left)
    (x : (((D.u p.hom).sheafPullback (Type w) (D.J i) (D.J p.left)).obj F).obj.obj (op V)) :
    (psiOver D hcontu F (b ≫ a)).app (op V) x =
      (((D.u r.hom).sheafPullback (Type w) (D.J i) (D.J r.left)).obj F).obj.map
        (eqToHom (congrArg op (Functor.congr_obj (D.comp b.left a.left).symm V)))
        ((psiOver D hcontu F b).app (op ((D.u a.left).obj V))
          ((psiOver D hcontu F a).app (op V) x)) := by
  have key :=
    unitFac_comp (compOver D a) (D.comp b.left a.left).symm (compOver D (b ≫ a)) (compOver D b)
      (D.J i) (D.J p.left) (D.J q.left) (D.J r.left) F
  rw [psiOver_def, psiOver_def, psiOver_def, key, ←
    comp'_hom_app_app (D.comp b.left a.left).symm (D.J p.left) (D.J q.left) (D.J r.left)]
  rfl

include hu in
/-- **The compatibility `hι` of Stacks 09YN for the maps `iotaOver`.** It is `unitFac_comp` for the
two-step factorization `D.u p.hom ⋙ D.u a.left = D.u q.hom`, `D.u a.left ⋙ u q.left = u p.left`,
read on sections: a section at the level `p` and its image at the deeper level `q` have the same
image in the colimit. -/
private theorem iotaOver_comp {i : D.I}
    (hcontu : ∀ {m n : D.I} (a : m ⟶ n), (D.u a).IsContinuous (D.J n) (D.J m))
    (hcontc : ∀ m, (u m).IsContinuous (D.J m) K.toGrothendieck) (F : Sheaf (D.J i) (Type w))
    {p q : Over i} (a : q ⟶ p) (V : D.C p.left)
    (x : (((D.u p.hom).sheafPullback (Type w) (D.J i) (D.J p.left)).obj F).obj.obj (op V)) :
    (iotaOver D u hu K hcontu hcontc F p).app (op V) x =
      (((u i).sheafPullback (Type w) (D.J i) K.toGrothendieck).obj F).obj.map
        (eqToHom (congrArg op (Functor.congr_obj (hu a.left) V)))
        ((iotaOver D u hu K hcontu hcontc F q).app (op ((D.u a.left).obj V))
          ((psiOver D hcontu F a).app (op V) x)) := by
  have key :=
    unitFac_comp (compOver D a) (hu a.left) (hu p.hom) (hu q.hom) (D.J i) (D.J p.left) (D.J q.left)
      K.toGrothendieck F
  rw [iotaOver_def, iotaOver_def, psiOver_def, key, ←
    comp'_hom_app_app (hu a.left) (D.J p.left) (D.J q.left) K.toGrothendieck]
  rfl

include hu in
/-- **`f_i^{-1}F` is the colimit `colim_{p : Over i} f_{p.left}^{-1}f_{p.hom}^{-1}F`**, which is
the hypothesis `hG` of Stacks 09YN for the restricted system: a compatible family of maps
`g p : f_{p.hom}^{-1}F ⟶ u_{p.left,*}H` factors uniquely through the maps `iotaOver`.

This is the source's third paragraph, and it is where the observation of the docstring of
`sections_pullback_colimit` below replaces the corepresentability argument: every transition of the
diagram is invertible, so the colimit is any one of its values, and the whole of the universal
property comes from the level `p₀ = 𝟙 i` and the bijectivity of the adjunction. In detail, write
`κ p : F ⟶ u_{i,*}H` for the `D.u p.hom`-adjoint of `g p`, read through the identification
`u_{i,*} ≅ (D.u p.hom)_* u_{p.left,*}` of pushforwards. The compatibility of the family says
exactly that `κ` is constant (`hκconst`, a cocycle computation off `comp'_hom_cocycle`), and
`homEquiv_unitFac_comp` says that the map `h` the universal property asks for is one whose adjoint
is
that constant value; since `(u p.left)_*H` is a sheaf — this is continuity of `u p.left`, and the
only place the sheaf property of `H` is used — the adjunction is a bijection, which gives both the
existence and the uniqueness. -/
private theorem hGOver {i : D.I}
    (hcontu : ∀ {m n : D.I} (a : m ⟶ n), (D.u a).IsContinuous (D.J n) (D.J m))
    (hcontc : ∀ m, (u m).IsContinuous (D.J m) K.toGrothendieck) (F : Sheaf (D.J i) (Type w))
    (H : Sheaf K.toGrothendieck (Type w))
    (g :
      ∀ p : Over i,
        (((D.u p.hom).sheafPullback (Type w) (D.J i) (D.J p.left)).obj F).obj ⟶
          (u p.left).op ⋙ H.obj)
    (hg :
      ∀ {p q : Over i} (a : q ⟶ p) (V : D.C p.left)
        (x : (((D.u p.hom).sheafPullback (Type w) (D.J i) (D.J p.left)).obj F).obj.obj (op V)),
        (g p).app (op V) x =
          H.obj.map (eqToHom (congrArg op (Functor.congr_obj (hu a.left) V)))
            ((g q).app (op ((D.u a.left).obj V)) ((psiOver D hcontu F a).app (op V) x))) :
    ∃! h : ((u i).sheafPullback (Type w) (D.J i) K.toGrothendieck).obj F ⟶ H,
      ∀ (p : Over i) (V : D.C p.left)
        (x : (((D.u p.hom).sheafPullback (Type w) (D.J i) (D.J p.left)).obj F).obj.obj (op V)),
        (g p).app (op V) x =
          h.hom.app (op ((u p.left).obj V))
            ((iotaOver D u hu K hcontu hcontc F p).app (op V) x) := by
  -- the maps `g p`, as morphisms of sheaves, and the compatibility as an equation between them
  have hgs :
    ∀ {p q : Over i} (a : q ⟶ p),
      (ObjectProperty.homMk (g p) :
          ((D.u p.hom).sheafPullback (Type w) (D.J i) (D.J p.left)).obj F ⟶
            ((u p.left).sheafPushforwardContinuous (Type w) (D.J p.left) K.toGrothendieck).obj H) =
        unitFac (compOver D a) (D.J i) (D.J p.left) (D.J q.left) F ≫
          ((D.u a.left).sheafPushforwardContinuous (Type w) (D.J p.left) (D.J q.left)).map
            (ObjectProperty.homMk (g q)) ≫
          (Functor.sheafPushforwardContinuousComp' (eqToIso (hu a.left)) (Type w) (D.J p.left)
                (D.J q.left) K.toGrothendieck).hom.app
            H := by
    intro p q a
    refine Sheaf.hom_ext (NatTrans.ext (funext fun V => ConcreteCategory.hom_ext _ _ fun x => ?_))
    obtain ⟨V⟩ := V
    change (g p).app (op V) x = _
    rw [hg a V x, ← comp'_hom_app_app (hu a.left) (D.J p.left) (D.J q.left) K.toGrothendieck]
    rfl
  -- the adjoint of `g p`, a map `F ⟶ u_{i,*}H` independent of the level `p`
  obtain ⟨κ, hκ⟩ :
    ∃ κ :
      ∀ _ : Over i, F ⟶ ((u i).sheafPushforwardContinuous (Type w) (D.J i) K.toGrothendieck).obj H,
      ∀ p : Over i,
        κ p =
          ((D.u p.hom).sheafAdjunctionContinuous (Type w) (D.J i) (D.J p.left)).homEquiv F
              (((u p.left).sheafPushforwardContinuous (Type w) (D.J p.left) K.toGrothendieck).obj
                H)
              (ObjectProperty.homMk (g p)) ≫
            (Functor.sheafPushforwardContinuousComp' (eqToIso (hu p.hom)) (Type w) (D.J i)
                  (D.J p.left) K.toGrothendieck).hom.app
              H :=
    ⟨_, fun _ => rfl⟩
  have hκconst : ∀ {p q : Over i} (_ : q ⟶ p), κ q = κ p := by
    intro p q a
    rw [hκ, hκ, hgs a, Adjunction.homEquiv_naturality_right, homEquiv_unitFac,
      Adjunction.homEquiv_unit, Functor.map_comp]
    have hnat :
      ((D.u q.hom).sheafPushforwardContinuous (Type w) (D.J i) (D.J q.left)).map
            (ObjectProperty.homMk (g q) :
              ((D.u q.hom).sheafPullback (Type w) (D.J i) (D.J q.left)).obj F ⟶
                ((u q.left).sheafPushforwardContinuous (Type w) (D.J q.left) K.toGrothendieck).obj
                  H) ≫
          (Functor.sheafPushforwardContinuousComp' (eqToIso (compOver D a)) (Type w) (D.J i)
                (D.J p.left) (D.J q.left)).inv.app
            (((u q.left).sheafPushforwardContinuous (Type w) (D.J q.left) K.toGrothendieck).obj
              H) =
        (Functor.sheafPushforwardContinuousComp' (eqToIso (compOver D a)) (Type w) (D.J i)
                (D.J p.left) (D.J q.left)).inv.app
            (((D.u q.hom).sheafPullback (Type w) (D.J i) (D.J q.left)).obj F) ≫
          ((D.u p.hom).sheafPushforwardContinuous (Type w) (D.J i) (D.J p.left)).map
            (((D.u a.left).sheafPushforwardContinuous (Type w) (D.J p.left) (D.J q.left)).map
              (ObjectProperty.homMk (g q))) :=
      (Functor.sheafPushforwardContinuousComp' (eqToIso (compOver D a)) (Type w) (D.J i)
            (D.J p.left) (D.J q.left)).inv.naturality
        _
    have hcocy :=
      comp'_hom_cocycle (compOver D a) (hu a.left) (hu p.hom) (hu q.hom) (D.J i) (D.J p.left)
        (D.J q.left) K.toGrothendieck H
    simp only [Category.assoc]
    slice_rhs 2 3 => rw [← hnat]
    slice_rhs 4 5 => rw [← hcocy]
    slice_rhs 3 4 => rw [Iso.inv_hom_id_app]
    rw [Category.id_comp]
  -- a level dominating every level: the identity of `i`
  obtain ⟨p₀, hp₀⟩ : ∃ p₀ : Over i, ∀ p : Over i, Nonempty (p ⟶ p₀) :=
    ⟨Over.mk (𝟙 i), fun p => ⟨Over.homMk p.hom⟩⟩
  refine
    ⟨((u i).sheafAdjunctionContinuous (Type w) (D.J i) K.toGrothendieck).homEquiv F H |>.symm
        (κ p₀),
      ?_, ?_⟩
  · intro p V x
    have key :
      (ObjectProperty.homMk (g p) :
          ((D.u p.hom).sheafPullback (Type w) (D.J i) (D.J p.left)).obj F ⟶
            ((u p.left).sheafPushforwardContinuous (Type w) (D.J p.left) K.toGrothendieck).obj H) =
        unitFac (hu p.hom) (D.J i) (D.J p.left) K.toGrothendieck F ≫
          ((u p.left).sheafPushforwardContinuous (Type w) (D.J p.left) K.toGrothendieck).map
            (((u i).sheafAdjunctionContinuous (Type w) (D.J i) K.toGrothendieck).homEquiv F
                H |>.symm
              (κ p₀)) := by
      refine
        (((D.u p.hom).sheafAdjunctionContinuous (Type w) (D.J i) (D.J p.left)).homEquiv F
              _).injective
          ?_
      rw [homEquiv_unitFac_comp, Equiv.apply_symm_apply, ← hκconst (hp₀ p).some, hκ,
        Category.assoc, Iso.hom_inv_id_app]
      exact (Category.comp_id _).symm
    exact ConcreteCategory.congr_hom (congrArg (fun m => NatTrans.app m.hom (op V)) key) x
  · intro h' hh'
    refine
      (((u i).sheafAdjunctionContinuous (Type w) (D.J i) K.toGrothendieck).homEquiv F H).injective
        ?_
    rw [Equiv.apply_symm_apply]
    have key :
      (ObjectProperty.homMk (g p₀) :
          ((D.u p₀.hom).sheafPullback (Type w) (D.J i) (D.J p₀.left)).obj F ⟶
            ((u p₀.left).sheafPushforwardContinuous (Type w) (D.J p₀.left) K.toGrothendieck).obj
              H) =
        unitFac (hu p₀.hom) (D.J i) (D.J p₀.left) K.toGrothendieck F ≫
          ((u p₀.left).sheafPushforwardContinuous (Type w) (D.J p₀.left) K.toGrothendieck).map
            h' := by
      refine
        Sheaf.hom_ext (NatTrans.ext (funext fun V => ConcreteCategory.hom_ext _ _ fun x => ?_))
      obtain ⟨V⟩ := V
      exact hh' p₀ V x
    have h2 :=
      congrArg
        (fun m =>
          m ≫
            (Functor.sheafPushforwardContinuousComp' (eqToIso (hu p₀.hom)) (Type w) (D.J i)
                  (D.J p₀.left) K.toGrothendieck).hom.app
              H)
        (congrArg
          (((D.u p₀.hom).sheafAdjunctionContinuous (Type w) (D.J i) (D.J p₀.left)).homEquiv F _)
          key)
    rw [homEquiv_unitFac_comp] at h2
    rw [← hκ p₀, Category.assoc, Iso.inv_hom_id_app, Category.comp_id] at h2
    exact h2.symm

/-- **Equation (09YM).** For `U : D.C i` and a sheaf of sets `F` on `D.C i`, the
canonical maps `θ a : (f_a^{-1}F)(u_a U) → (f_i^{-1}F)(u_i U)`, indexed by the arrows `a : j ⟶ i`
of `D.I`, exhibit `(f_i^{-1}F)(u_i U)` as their filtered colimit: they are jointly surjective, and
two sections at a level with the same image agree after pullback along some further `D.u b`.

The source's argument. Define a presheaf `G` on `C` by `G(u_j V_j) = colim_{b : k ⟶ j}
(f_{a ∘ b}^{-1}F)(u_b V_j)` for any `a : j ⟶ i`; the value is independent of the choices, and a
morphism of `C` comes from a level and induces the restriction maps. `G` is a sheaf: a covering of
`C` comes from a level `j`, and `H^0` of it against `G` is the filtered colimit of the `H^0` of its
levels against the `f_{b ∘ a}^{-1}F`, because filtered colimits commute with finite limits — here
the finiteness of the coverings of the `D.C i` is used. Finally `G ≅ f_i^{-1}F`, because a map
`G → H` is a compatible system of maps `(f_{a ∘ b}^{-1}F)(u_b V_j) → H(u_j V_j)`, the
compatibilities force such a system to be determined by its component at `a = b = id`, and that
component is a map `F → f_{i,*}H`; so `G` corepresents the same functor as `f_i^{-1}F`. By
construction `G(u_i U)` is the right-hand side of (09YM).

Only *continuity* of the `u i` (`isContinuous_of_hK`) is assumed, never exactness of `f_i^{-1}`:
the source proves (09YM) first and deduces exactness from it, so exactness of `f_i^{-1}` cannot be
an input here on pain of circularity. What the construction of `G` does consume is exactness of the
*transitions* `f_a^{-1}`, which is a hypothesis of the system
(`InverseSystemOfFiniteSites.isMorphismOfSites`, Stacks 0A34 (3)) and not of this lemma.

The identification `G ≅ f_i^{-1}F` needs less than the source's third paragraph, which checks it by
corepresentability. Since `u_i = D.u a ⋙ u_j` (`hu a`), the comparison
`Functor.sheafPullbackComp` gives `f_i^{-1} ≅ f_j^{-1} ∘ f_a^{-1}` for every `a : j ⟶ i`, so the
diagram `a ↦ f_j^{-1}f_a^{-1}F` whose colimit is `G` has all of its transition maps invertible and
its colimit is any one of its values, namely `f_i^{-1}F` at `a = 𝟙 i`. The content of (09YM) is
therefore not the identification of the colimit sheaf but the fact that the *unit*
`f_a^{-1}F → f_{j,*}f_j^{-1}f_a^{-1}F = f_{j,*}f_i^{-1}F`, read on sections over `u_a U`, becomes
bijective in the colimit over `a`; `θ a` is that unit.

The proof instantiates Stacks 09YN at the restriction `restrictOver D i` of the system to the
levels below `i`, which are cofinal by cofilteredness of `D.I` (`hobjOver`, `hhomOver`,
`hhomInjOver`, `hKOver`); the family of sheaves is `a ↦ f_a^{-1}F`, its transition maps are
`psiOver` with the cocycle condition `psiOver_comp`, the structure maps of the colimit are
`iotaOver` with the compatibility `iotaOver_comp`, and that `f_i^{-1}F` is that colimit is
`hGOver`. The two clauses of Stacks 09YN are the two clauses here: for joint surjectivity, the
arrow `a : j ⟶ i` it produces is the structure arrow of the level it produces (`Over.w`), and for
separatedness the comparison isomorphism is cancelled from the maps of the system to leave the unit
(`unit_app_eq_of_unitFac_app_eq`). -/
private theorem sections_pullback_colimit :
    haveI _hcont : ∀ i, (u i).IsContinuous (D.J i) K.toGrothendieck := fun i =>
      isContinuous_of_hK D u hu hobj hhom hhom_inj K hK i
    haveI _hcontu : ∀ {i j : D.I} (a : i ⟶ j), (D.u a).IsContinuous (D.J j) (D.J i) := fun a =>
      D.continuous a
    ∀ (i : D.I) (U : D.C i) (F : Sheaf (D.J i) (Type w))
      (θ :
        ∀ {j : D.I} (a : j ⟶ i),
          (((D.u a).sheafPullback (Type w) (D.J i) (D.J j)).obj F).obj.obj (op ((D.u a).obj U)) →
            (((u i).sheafPullback (Type w) (D.J i) K.toGrothendieck).obj F).obj.obj
              (op ((u i).obj U))),
      (∀ {j : D.I} (a : j ⟶ i),
          θ a =
            (((D.u a).sheafPushforwardContinuous (Type w) (D.J i) (D.J j)).map
                    ((((D.u a).sheafAdjunctionContinuous (Type w) (D.J i) (D.J j)).homEquiv F
                          (((u j).sheafPushforwardContinuous (Type w) (D.J j) K.toGrothendieck).obj
                            (((u i).sheafPullback (Type w) (D.J i) K.toGrothendieck).obj F))).symm
                      (((u i).sheafAdjunctionContinuous (Type w) (D.J i) K.toGrothendieck).unit.app
                          F ≫
                        (Functor.sheafPushforwardContinuousComp' (eqToIso (hu a)) (Type w) (D.J i)
                              (D.J j) K.toGrothendieck).inv.app
                          _)) ≫
                  (Functor.sheafPushforwardContinuousComp' (eqToIso (hu a)) (Type w) (D.J i)
                        (D.J j) K.toGrothendieck).hom.app
                    _).hom.app
              (op U)) →
        (∀ s :
            (((u i).sheafPullback (Type w) (D.J i) K.toGrothendieck).obj F).obj.obj
              (op ((u i).obj U)),
            ∃ (j : D.I) (a : j ⟶ i) (t :
              (((D.u a).sheafPullback (Type w) (D.J i) (D.J j)).obj F).obj.obj
                (op ((D.u a).obj U))),
              θ a t = s) ∧
          ∀ (j : D.I) (a : j ⟶ i)
            (t t' :
              (((D.u a).sheafPullback (Type w) (D.J i) (D.J j)).obj F).obj.obj
                (op ((D.u a).obj U))),
            θ a t = θ a t' →
              ∃ (k : D.I) (b : k ⟶ j),
                (((D.u b).sheafAdjunctionContinuous (Type w) (D.J j) (D.J k)).unit.app
                        (((D.u a).sheafPullback (Type w) (D.J i) (D.J j)).obj F)).hom.app
                    (op ((D.u a).obj U)) t =
                  (((D.u b).sheafAdjunctionContinuous (Type w) (D.J j) (D.J k)).unit.app
                        (((D.u a).sheafPullback (Type w) (D.J i) (D.J j)).obj F)).hom.app
                    (op ((D.u a).obj U)) t' := by
  have hcontc : ∀ m, (u m).IsContinuous (D.J m) K.toGrothendieck := fun m =>
    isContinuous_of_hK D u hu hobj hhom hhom_inj K hK m
  have hcontu : ∀ {m n : D.I} (a : m ⟶ n), (D.u a).IsContinuous (D.J n) (D.J m) := fun a =>
    D.continuous a
  intro i U F θ hθ
  -- `θ a` is the canonical map `iotaOver` of the level `Over.mk a`, read on sections over `u_a U`
  have hθc :
    ∀ {j : D.I} (a : j ⟶ i)
      (t : (((D.u a).sheafPullback (Type w) (D.J i) (D.J j)).obj F).obj.obj (op ((D.u a).obj U))),
      θ a t =
        (((u i).sheafPullback (Type w) (D.J i) K.toGrothendieck).obj F).obj.map
          (eqToHom (congrArg op (Functor.congr_obj (hu a) U)))
          ((iotaOver D u hu K hcontu hcontc F (Over.mk a)).app (op ((D.u a).obj U)) t) := by
    intro j a t
    rw [hθ a, homEquiv_symm_unit_eq_unitFac,
      ← comp'_hom_app_app (hu a) (D.J i) (D.J j) K.toGrothendieck]
    rfl
  -- Stacks 09YN for the system restricted to the levels below `i`
  have main :=
    InverseSystemOfFiniteSites.sections_colimit_pullback_of_colimit (restrictOver D i) (uOver D u i)
      (huOver D u hu i) (hobjOver D u hu hobj i) (hhomOver D u hu hhom i)
      (hhomInjOver D u hhom_inj i) K (hKOver D u hu K hK i)
      (fun p => ((D.u p.hom).sheafPullback (Type w) (D.J i) (D.J p.left)).obj F)
      (fun a => psiOver D hcontu F a) (fun a b V x => psiOver_comp D hcontu F a b V x)
      (((u i).sheafPullback (Type w) (D.J i) K.toGrothendieck).obj F)
      (fun p => iotaOver D u hu K hcontu hcontc F p)
      (fun a V x => iotaOver_comp D u hu K hcontu hcontc F a V x)
      (fun H g hg => hGOver D u hu K hcontu hcontc F H g hg) (Over.mk (𝟙 i)) U
      (fun {q} a' t =>
        (((u i).sheafPullback (Type w) (D.J i) K.toGrothendieck).obj F).obj.map
          (eqToHom (congrArg op (Functor.congr_obj (hu a'.left) U)))
          ((iotaOver D u hu K hcontu hcontc F q).app (op ((D.u a'.left).obj U)) t))
      (fun _ _ => rfl)
  refine ⟨fun s => ?_, ?_⟩
  · -- joint surjectivity: a section comes from a level `q` below `i`, and the arrow to `i` that
    -- Stacks 09YN produces is the structure arrow `q.hom` of that level
    obtain ⟨q, a', t, ht⟩ := main.1 s
    have hw : a'.left = q.hom := by simpa using Over.w a'
    have hθc' :
      ∀ (p : Over i)
        (y :
          (((D.u p.hom).sheafPullback (Type w) (D.J i) (D.J p.left)).obj F).obj.obj
            (op ((D.u p.hom).obj U))),
        θ p.hom y =
          (((u i).sheafPullback (Type w) (D.J i) K.toGrothendieck).obj F).obj.map
            (eqToHom (congrArg op (Functor.congr_obj (hu p.hom) U)))
            ((iotaOver D u hu K hcontu hcontc F p).app (op ((D.u p.hom).obj U)) y) :=
      fun p y => hθc p.hom y
    have key :
      ∀ (b : q.left ⟶ i) (hb : b = q.hom)
        (y :
          (((D.u q.hom).sheafPullback (Type w) (D.J i) (D.J q.left)).obj F).obj.obj
            (op ((D.u b).obj U))),
        θ q.hom
            ((((D.u q.hom).sheafPullback (Type w) (D.J i) (D.J q.left)).obj F).obj.map
              (eqToHom
                (congrArg op (Functor.congr_obj (congrArg (fun τ : q.left ⟶ i => D.u τ) hb) U)))
              y) =
          (((u i).sheafPullback (Type w) (D.J i) K.toGrothendieck).obj F).obj.map
            (eqToHom (congrArg op (Functor.congr_obj (hu b) U)))
            ((iotaOver D u hu K hcontu hcontc F q).app (op ((D.u b).obj U)) y) := by
      intro b hb y
      subst hb
      simpa using hθc' q y
    exact ⟨q.left, q.hom, _, (key a'.left hw t).trans ht⟩
  · -- separatedness: two sections with the same image agree at a further level
    intro j a t t' h
    obtain ⟨k, b, hb⟩ :=
      main.2 (Over.mk a) (Over.homMk a) t t' ((hθc a t).symm.trans (h.trans (hθc a t')))
    have hc1 : (D.u (Over.mk a).hom).IsContinuous (D.J i) (D.J j) := hcontu a
    have hc2 : (D.u (Over.Hom.left b)).IsContinuous (D.J j) (D.J k.left) := hcontu b.left
    have hc3 : (D.u k.hom).IsContinuous (D.J i) (D.J k.left) := hcontu k.hom
    exact
      ⟨k.left, b.left,
        unit_app_eq_of_unitFac_app_eq (compOver D b) (D.J i) (D.J j) (D.J k.left) F ((D.u a).obj U)
          hb⟩

/-- The canonical map `θ a` of equation (09YM) at the level `n`, packaged as a natural
transformation of functors of the sheaf: `sectionsNat` for the factorization `hu c`, whiskered with
taking sections over `W`. Reading it as a natural transformation is what lets
`preservesFiniteLimits_of_jointlySurjective` be applied to the family of the `θ`. -/
private noncomputable def sectionsTheta {n k : D.I} (c : k ⟶ n) (W : D.C n)
    [(u n).IsContinuous (D.J n) K.toGrothendieck] [(u k).IsContinuous (D.J k) K.toGrothendieck]
    [(D.u c).IsContinuous (D.J n) (D.J k)] :
    (D.u c).sheafPullback (Type w) (D.J n) (D.J k) ⋙ evalSheaf (D.J k) (op ((D.u c).obj W)) ⟶
      (u n).sheafPullback (Type w) (D.J n) K.toGrothendieck ⋙
        evalSheaf K.toGrothendieck (op ((u n).obj W)) :=
  Functor.whiskerRight (sectionsNat (hu c) (D.J n) (D.J k) K.toGrothendieck)
    (evalSheaf (D.J n) (op W))

include hu hobj hhom hhom_inj hK in
/-- **The sections of `f_n^{-1}F` over an object `u_n W` of the level `n` are left exact in `F`.**
This is equation (09YM) read as a statement about the functor `F ↦ (f_n^{-1}F)(u_n W)`: the maps
`θ c` exhibit it as a filtered colimit of the functors `F ↦ (f_c^{-1}F)(u_c W)`, which are left
exact because the transitions of the system are morphisms of sites (Stacks 0A34 (3)), and a
filtered colimit of left exact functors to sets is left exact
(`preservesFiniteLimits_of_jointlySurjective`).

The index category is the category of arrows `c : k ⟶ n` of `D.I`, cofiltered because `D.I` is;
only its directedness is used, in the form supplied by `sectionsNat_comp`. -/
private theorem preservesFiniteLimits_sections_of_hK (n : D.I) (W : D.C n)
    [(u n).IsContinuous (D.J n) K.toGrothendieck] :
    PreservesFiniteLimits
      ((u n).sheafPullback (Type w) (D.J n) K.toGrothendieck ⋙
        evalSheaf K.toGrothendieck (op ((u n).obj W))) := by
  have hcont : ∀ m, (u m).IsContinuous (D.J m) K.toGrothendieck := fun m =>
    isContinuous_of_hK D u hu hobj hhom hhom_inj K hK m
  have hcontu : ∀ {p q : D.I} (a : p ⟶ q), (D.u a).IsContinuous (D.J q) (D.J p) := fun a =>
    D.continuous a
  have hne : Nonempty ((k : D.I) × (k ⟶ n)) := ⟨⟨n, 𝟙 n⟩⟩
  -- Equation (09YM) at the level `n` and the object `W`, for the canonical maps `sectionsTheta`:
  -- that they are the maps `θ` the statement pins is `homEquiv_symm_unit_comp_eq`.
  have hcolim := fun F : Sheaf (D.J n) (Type w) =>
