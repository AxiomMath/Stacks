/-- `f_i^{-1} = u_{i,s}` is left exact.

The argument, which is the source's last paragraph, runs off equation (09YM), stated as
`sections_pullback_colimit` above — which is why that lemma precedes this one, and why it assumes
only continuity of the `u i`. Finite limits of sheaves are computed in presheaves (Stacks 00W2), so
it suffices that `F ↦ (f_i^{-1}F)(V)` commutes with finite limits for every `V : C`. Writing
`V = u_j V_j` and using (09YM) for the level `j`, that value is the filtered colimit over
`b : k ⟶ j` of `(f_b^{-1}F)(u_b V_j)`; each `f_b^{-1}` commutes with finite limits because `D.u b`
is a morphism of sites in the sense of Stacks 0A34 (3), and filtered colimits of sets commute with
finite limits. Right exactness is automatic (`Functor.preservesFiniteColimits_sheafPullback`).

Exactness of the `f_b^{-1}` is `InverseSystemOfFiniteSites.isMorphismOfSites`, the field recording
Stacks 0A34 (3) in full; Stacks 00X1 remarks that this condition on `u_s` cannot be omitted, and
without it the conclusion of this lemma is false. With all topologies trivial, continuity of the
transitions holds vacuously (`Presheaf.isSheaf_bot`) while exactness stays a real condition: for
`D.I` the poset `{0 ⟶ 1}`, `D.C 1` discrete on `W₁, W₂`, `D.C 0` the category `{V, W₁, W₂}` with
one arrow `V ⟶ W_t` for each `t`, `D.u` of `0 ⟶ 1` the inclusion and `C = D.C 0` with `u 0 = 𝟭`,
`f_1^{-1}` is the left Kan extension along `(D.u).op` up to the equivalence
`Sheaf ⊥ A ≌ Presheaf`, so `(f_1^{-1}P)(V)` is a colimit over the *discrete* comma category of
`(W₁, V ⟶ W₁)` and `(W₂, V ⟶ W₂)`, namely `P(W₁) ⊔ P(W₂)`; at the terminal sheaf that has two
elements and the empty limit is not preserved. The bracketing of the hypotheses is therefore
essential rather than decorative, and the remaining gap in this step is (09YM), not exactness. -/
private theorem preservesFiniteLimits_sheafPullback_of_hK (i : D.I)
    [(u i).IsContinuous (D.J i) K.toGrothendieck] :
    PreservesFiniteLimits ((u i).sheafPullback (Type w) (D.J i) K.toGrothendieck) := by
  have hcont : ∀ m, (u m).IsContinuous (D.J m) K.toGrothendieck := fun m =>
    isContinuous_of_hK D u hu hobj hhom hhom_inj K hK m
  have hcontu : ∀ {p q : D.I} (a : p ⟶ q), (D.u a).IsContinuous (D.J q) (D.J p) := fun a =>
    D.continuous a
  -- finite limits of sheaves are computed pointwise, so it suffices to treat the sections over
  -- each object `V` of `C`
  refine preservesFiniteLimits_of_evalSheaf K.toGrothendieck _ fun V => ?_
  -- `V` comes from a level `m`, and `i` and `m` are dominated by a level `n`, so `V = u_n W`
  obtain ⟨m, Y, hY⟩ := hobj V.unop
  obtain ⟨n, a, b, -⟩ := IsCofilteredOrEmpty.cone_objs i m
  have hVW : (u n).obj ((D.u b).obj Y) = V.unop := (Functor.congr_obj (hu b) Y).trans hY
  have hV : V = op ((u n).obj ((D.u b).obj Y)) := by rw [hVW]
  subst hV
  -- `f_i^{-1} ≅ f_a^{-1} ⋙ f_n^{-1}`, the first factor is left exact by Stacks 0A34 (3) and the
  -- sections of the second over `u_n W` are left exact by equation (09YM)
  have h1 :
    PreservesFiniteLimits
      ((D.u a).sheafPullback (Type w) (D.J i) (D.J n) ⋙
        ((u n).sheafPullback (Type w) (D.J n) K.toGrothendieck ⋙
          evalSheaf K.toGrothendieck (op ((u n).obj ((D.u b).obj Y))))) := by
    have := (D.isMorphismOfSites a).preservesFiniteLimits
    have := preservesFiniteLimits_sections_of_hK D u hu hobj hhom hhom_inj K hK n ((D.u b).obj Y)
    exact comp_preservesFiniteLimits _ _
  have h2 :
    PreservesFiniteLimits
      (((D.u a).sheafPullback (Type w) (D.J i) (D.J n) ⋙
          (u n).sheafPullback (Type w) (D.J n) K.toGrothendieck) ⋙
        evalSheaf K.toGrothendieck (op ((u n).obj ((D.u b).obj Y)))) :=
    h1
  exact
    preservesFiniteLimits_of_natIso
      (Functor.isoWhiskerRight (sheafPullbackFacIso (hu a) (D.J i) (D.J n) K.toGrothendieck).symm
        (evalSheaf K.toGrothendieck (op ((u n).obj ((D.u b).obj Y)))))

include hu hobj hhom hhom_inj hK in
/-- Each `u i` defines a morphism of sites `f_i : C → C_i` (Stacks 00X1): it is continuous
(`isContinuous_of_hK`), `f_i^{-1}` is left exact
(`preservesFiniteLimits_sheafPullback_of_hK`), and right exactness is automatic for a left
adjoint. -/
private theorem isMorphismOfSites_of_hK (i : D.I) :
    (u i).IsMorphismOfSites (D.J i) K.toGrothendieck := by
  have : (u i).IsContinuous (D.J i) K.toGrothendieck :=
    isContinuous_of_hK D u hu hobj hhom hhom_inj K hK i
  rw [Functor.isMorphismOfSites_iff_preservesFiniteLimits]
  exact preservesFiniteLimits_sheafPullback_of_hK D u hu hobj hhom hhom_inj K hK i

include hu hobj hhom hhom_inj hK in
/-- **The functors to the colimit site are morphisms of sites** (Stacks 00X1): the public form of
`isMorphismOfSites_of_hK`. -/
public alias isMorphismOfSites_toColimitSite := isMorphismOfSites_of_hK

end

