/-- **A morphism of `C` whose source is seen by a level descends to a level.** Both source and
target are moved to a common index by cofilteredness, and `hhom` then produces the lift. -/
private theorem exists_descent_of_base {i l₀ : D.I} (A : D.C i) (V₀ : D.C l₀) {W : C}
    (hV₀ : (u l₀).obj V₀ = W) (p : W ⟶ (u i).obj A) :
    ∃ (l : D.I) (c : l ⟶ l₀) (d : l ⟶ i) (p' : (D.u c).obj V₀ ⟶ (D.u d).obj A),
      (u l).map p' ≫ eqToHom (Functor.congr_obj (hu d) A) =
        eqToHom ((Functor.congr_obj (hu c) V₀).trans hV₀) ≫ p := by
  obtain ⟨m, a, b, -⟩ := IsCofilteredOrEmpty.cone_objs l₀ i
  obtain ⟨n, e, g, hg⟩ :=
    hhom m ((D.u a).obj V₀) ((D.u b).obj A)
      (eqToHom ((Functor.congr_obj (hu a) V₀).trans hV₀) ≫
        p ≫ eqToHom (Functor.congr_obj (hu b) A).symm)
  refine
    ⟨n, e ≫ a, e ≫ b,
      eqToHom (Functor.congr_obj (D.comp e a) V₀) ≫
        g ≫ eqToHom (Functor.congr_obj (D.comp e b) A).symm,
      ?_⟩
  simp only [Functor.map_comp, eqToHom_map, hg, Category.assoc, eqToHom_trans]
  simp

