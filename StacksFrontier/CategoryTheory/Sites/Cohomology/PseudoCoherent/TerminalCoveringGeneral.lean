module

public import StacksFrontier.CategoryTheory.Sites.Cohomology.PseudoCoherent.TerminalCovering
public import StacksFrontier.CategoryTheory.Sites.Cohomology.PseudoCoherent.DerivedApproximationOnASliceGeneral

/-!
# One covering of the final object suffices, at independent universes

Let `(C, O)` be a ringed site whose underlying category has a final object `X`, and let `E` be
an object of `D(O)`. If there are a covering `{U_i → X}` of that final object, strictly perfect
complexes `E_i` of `O_{U_i}`-modules and maps `α_i : E_i → E|_{U_i}` in `D(O_{U_i})` which are
isomorphisms on cohomology in every degree `> m` and surjective in degree `m`, then `E` is
`m`-pseudo-coherent. This is part (1) of [Stacks, Tag 08FU].

The statement already exists on the diagonal site `RingedSite.{u, u, 0}`, where the sections of
the modules lie in `Type`; this file states it with the underlying category, its morphisms and
the sections of the modules at independent universes, which is where the perfectness cluster of
[Stacks, Tag 0FPV] lives and where the "we may assume `C` has a final object" reduction of that
tag needs it.

## Main results

* `AlgebraicGeometry.RingedSite.isPseudoCoherentFrom_of_covering_of_terminal_general`:
  Stacks 08FU, part (1), at independent universes.

## Implementation notes

The argument is the one on the diagonal, reproduced up to the universe of the sections: over a
member `V` of the given covering the derived approximation is transported to the restriction
`K|_V` of a fixed representative `K` of `E` and made chain-level on a covering of `V` by
`AlgebraicGeometry.RingedSite.exists_coveringSieve_approximation_of_derived_general`, and an
arbitrary object `U` of `C` reaches the final object by a unique arrow, so the covering sieve
generated by `{U_i → X}` pulls back to a covering sieve of `U` whose arrows each transport a
member's covering to their source; `CategoryTheory.Sieve.bind` composes the two.

The exactness of restriction to a slice is taken from the forms of
`Stacks.SheafOfModules.LocalCokernel.overFunctor_preservesFiniteLimits` and
`...overFunctor_preservesFiniteColimits` recorded in instance scope at a free universe of the
sections in `AlgebraicGeometry.RingedSite.ovFunctorLimits` and
`AlgebraicGeometry.RingedSite.ovFunctorColimits`, the diagonal file's own copies being stated
only for sections in `Type`.

## References

* [Stacks Project, Tag 08FU](https://stacks.math.columbia.edu/tag/08FU)
* [Stacks Project, Tag 08FT](https://stacks.math.columbia.edu/tag/08FT)
* [Stacks Project, Tag 0FPV](https://stacks.math.columbia.edu/tag/0FPV)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u v w d

namespace AlgebraicGeometry.RingedSite

section TerminalGeneral

variable (X : RingedSite.{u, v, w})
variable [HasSheafify X.J AddCommGrpCat.{w}]
variable [X.J.WEqualsLocallyBijective AddCommGrpCat.{w}]
variable [∀ U : X.C, HasSheafify (X.J.over U) AddCommGrpCat.{w}]
variable [∀ U : X.C, (X.J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
variable [HasDerivedCategory.{d} (SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))]
variable [hSliceDer : ∀ U : X.C,
  HasDerivedCategory.{d} (SheafOfModules.{w} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over U))]

attribute [local instance] locallyOverRingSheafHasDerivedCategory

attribute [local instance] ovFunctorLimits ovFunctorColimits

/-- **Stacks 08FU, part (1)**, with the site, its morphisms and the sections of the modules at
independent universes. Let `(C, O)` be a ringed site, let `E` be an object of `D(O)` and let `T`
be a final object of `C`. If a covering `{V → T}` of `T` carries over each of its members a
strictly perfect complex `P` of `O|_V`-modules and a morphism `P ⟶ E|_V` of `D(O|_V)` which is
an isomorphism on cohomology in every degree `> m` and an epimorphism on cohomology in degree
`m`, then `E` is `m`-pseudo-coherent. -/
theorem isPseudoCoherentFrom_of_covering_of_terminal_general
    (T : X.C) (hT : IsTerminal T)
    (E : DerivedCategory (SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))) (m : ℤ)
    (S : Presieve T) (hS : Sieve.generate S ∈ X.J T)
    (hdata : ∀ ⦃V : X.C⦄ (f : V ⟶ T), S f →
      ∃ P : CochainComplex
          (SheafOfModules.{w} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over V)) ℤ,
        IsStrictlyPerfect ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over V) P ∧
        ∃ α : DerivedCategory.Q.obj P ⟶
            (SheafOfModules.overFunctor.{w}
              (Stacks.SheafOfModules.Tensor.ringSheaf X.O) V).mapDerivedCategory.obj E,
          (∀ j : ℤ, m < j → IsIso ((DerivedCategory.homologyFunctor _ j).map α)) ∧
          Epi ((DerivedCategory.homologyFunctor _ m).map α)) :
    X.IsPseudoCoherentFrom E m := by
  classical
  obtain ⟨K, eK⟩ : Σ' K : CochainComplex
        (SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ,
      DerivedCategory.Q.obj K ≅ E :=
    ⟨DerivedCategory.Q.objPreimage E, DerivedCategory.Q.objObjPreimageIso E⟩
  refine ⟨K, ?_, ⟨eK⟩⟩
  intro U
  have hR : (Sieve.generate S).pullback (hT.from U) ∈ X.J U := X.J.pullback_stable _ hS
  have key2 : ∀ (Z : X.C) (p : Z ⟶ U), ((Sieve.generate S).pullback (hT.from U)).arrows p →
      ∃ TZ : Sieve Z, TZ ∈ X.J Z ∧
        ∀ ⦃Y : X.C⦄ (k : Y ⟶ Z), TZ k →
          ∃ P : CochainComplex
              (SheafOfModules.{w} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over Y)) ℤ,
            IsStrictlyPerfect ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over Y) P ∧
            ∃ α : P ⟶ X.restrictComplex K Y,
              (∀ j : ℤ, m < j → IsIso (HomologicalComplex.homologyMap α j)) ∧
              Epi (HomologicalComplex.homologyMap α m) := by
    intro Z p hp
    obtain ⟨V, g, f, hf, -⟩ := hp
    obtain ⟨P, hP, α, hiso, hepi⟩ := hdata f hf
    have erep : DerivedCategory.Q.obj (X.restrictComplex K V) ≅
        (SheafOfModules.overFunctor.{w}
          (Stacks.SheafOfModules.Tensor.ringSheaf X.O) V).mapDerivedCategory.obj E :=
      ((SheafOfModules.overFunctor.{w}
          (Stacks.SheafOfModules.Tensor.ringSheaf X.O) V).mapDerivedCategoryFactors.app K).symm ≪≫
        (SheafOfModules.overFunctor.{w}
          (Stacks.SheafOfModules.Tensor.ringSheaf X.O) V).mapDerivedCategory.mapIso eK
    have hinv : IsIso erep.inv := erep.isIso_inv
    obtain ⟨TV, hTV, hTVdata⟩ := X.exists_coveringSieve_approximation_of_derived_general V K m P hP
      (α ≫ erep.inv)
      (fun j hj => by
        have := hiso j hj
        rw [Functor.map_comp]
        infer_instance)
      (by
        rw [Functor.map_comp]
        exact epi_comp' hepi (IsIso.epi_of_iso _))
    exact ⟨TV.pullback g, X.J.pullback_stable g hTV, fun _ k hk => hTVdata (k ≫ g) hk⟩
  refine ⟨(Sieve.bind ((Sieve.generate S).pullback (hT.from U)).arrows
    fun Z p hp => (key2 Z p hp).choose).arrows, ?_, ?_⟩
  · rw [Sieve.generate_sieve]
    exact X.J.bind_covering hR fun Z p hp => (key2 Z p hp).choose_spec.1
  · rintro Y q ⟨Z, k, p, hp, hk, rfl⟩
    exact (key2 Z p hp).choose_spec.2 k hk

end TerminalGeneral

end AlgebraicGeometry.RingedSite

end
