-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u v w

namespace AlgebraicGeometry.RingedSite

section Free

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} (R : Sheaf J RingCat.{w})
  [HasWeakSheafify J AddCommGrpCat.{w}] [J.WEqualsLocallyBijective AddCommGrpCat.{w}]

/-- **A free module on a finite index type is a direct summand of a finite free module**: it is
isomorphic to `𝒪^{⊕n}` with `n` the cardinality of the index type. -/
theorem isDirectSummandOfFiniteFree_free_of_finite (I : Type w) [Finite I] :
    IsDirectSummandOfFiniteFree R (SheafOfModules.free (R := R) I) := by
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin I
  let γ : SheafOfModules.free (R := R) I ≅ SheafOfModules.free (R := R) (ULift.{w} (Fin n)) :=
    (SheafOfModules.freeFunctor (R := R)).mapIso (e.trans Equiv.ulift.symm).toIso
  exact (isDirectSummandOfFiniteFree_iff_free R _).2 ⟨n, γ.hom, γ.inv, γ.hom_inv_id⟩

end Free

section Main

attribute [local instance] sliceHasSheafify sliceWEqualsLocallyBijective iterHasSheafify iterWEq
  iterHasSheafifyAll iterWEqAll ovFunctorLimits ovFunctorColimits HasDerivedCategory.standard

/-- **A free module on a finite index type, placed in degree zero, is `m`-pseudo-coherent** for
every `m`: the complex with that module in degree zero is strictly perfect
(`AlgebraicGeometry.RingedSite.isStrictlyPerfect_singleObj`), and a strictly perfect complex is
its own approximation. -/
theorem isPseudoCoherentFrom_singleFunctor_zero_free (X : RingedSite.{u, v, w})
    [HasSheafify X.J AddCommGrpCat.{w}] [X.J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    [∀ U : X.C, HasSheafify (X.J.over U) AddCommGrpCat.{w}]
    [∀ U : X.C, (X.J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (I : Type w) [Finite I] (m : ℤ) :
    X.IsPseudoCoherentFrom
      ((DerivedCategory.singleFunctor
        (SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) 0).obj
        (SheafOfModules.free I)) m :=
  ⟨_, isPseudoCoherentComplexFrom_of_isStrictlyPerfect_general X _
      (isStrictlyPerfect_singleObj _ (isDirectSummandOfFiniteFree_free_of_finite _ I) 0) m,
    ⟨((DerivedCategory.singleFunctorIsoCompQ _ 0).app _).symm⟩⟩

/-- The syzygy induction behind
`AlgebraicGeometry.RingedSite.isPseudoCoherentFrom_singleFunctor_zero_of_isCoherentOnSite`, on
the number `k` of syzygy steps below degree one, with the ringed site quantified inside, since
the step replaces the site by a slice. -/
private theorem isPseudoCoherentFrom_singleFunctor_zero_of_isCoherentOnSite_aux (k : ℕ) :
    ∀ (X : RingedSite.{max u v, v, w}) [HasSheafify X.J AddCommGrpCat.{w}]
      [X.J.WEqualsLocallyBijective AddCommGrpCat.{w}]
      [∀ U : X.C, HasSheafify (X.J.over U) AddCommGrpCat.{w}]
      [∀ U : X.C, (X.J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}],
      SheafOfModules.IsCoherentOnSite
        (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) →
      ∀ M : SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf X.O),
        SheafOfModules.IsCoherentOnSite M →
        X.IsPseudoCoherentFrom
          ((DerivedCategory.singleFunctor
            (SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) 0).obj M)
          (1 - (k : ℤ)) := by
  induction k with
  | zero =>
    intro X _ _ _ _ _ M _
    have h := isPseudoCoherentFrom_of_isLE X ((DerivedCategory.singleFunctor
      (SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) 0).obj M) 0
    simpa using h
  | succ k ih =>
    intro X _ _ _ _ hO M hM
    refine isPseudoCoherentFrom_of_locally_general X _ _ fun U => ?_
    have hMU : (M.over U).IsFiniteType :=
      SheafOfModules.isFiniteType_of_presheaf_isFiniteType (M.over U)
        (Stacks.SheafOfModules.isFiniteType_over M hM.isFiniteType U)
    obtain ⟨T, hT, hgen⟩ :=
      Stacks.SheafOfModules.exists_covering_sieve_finite_generators_of_isFiniteType_over _ M U hMU
    refine ⟨T.arrows, by simpa using hT, fun V f hf => ?_⟩
    obtain ⟨σ, hσ⟩ := hgen f hf
    have hOV : SheafOfModules.IsCoherentOnSite
        (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf (X.over V).O)) :=
      Stacks.SheafOfModules.isCoherentOnSite_over _ hO V
    have hMV : SheafOfModules.IsCoherentOnSite (M.over V) :=
      Stacks.SheafOfModules.isCoherentOnSite_over M hM V
    have hfree : SheafOfModules.IsCoherentOnSite
        (SheafOfModules.free (R := Stacks.SheafOfModules.Tensor.ringSheaf (X.over V).O) σ.I) :=
      Stacks.SheafOfModules.isCoherentOnSite_sigma _ fun _ => hOV
    have hK : SheafOfModules.IsCoherentOnSite (kernel σ.π) :=
      Stacks.SheafOfModules.isCoherentOnSite_kernel hfree hMV σ.π
    have hSE : (ShortComplex.kernelSequence σ.π).ShortExact :=
      { exact := ShortComplex.kernelSequence_exact σ.π
        mono_f := inferInstance
        epi_g := σ.epi }
    have h₃ := isPseudoCoherentFrom_of_distinguished_one_general (X.over V)
      (1 - ((k + 1 : ℕ) : ℤ)) _ hSE.singleTriangle_distinguished
      (by
        have harith : 1 - ((k + 1 : ℕ) : ℤ) + 1 = 1 - (k : ℤ) := by push_cast; ring
        rw [harith]
        exact ih (X.over V) hOV (kernel σ.π) hK)
      (isPseudoCoherentFrom_singleFunctor_zero_free (X.over V) σ.I _)
    exact isPseudoCoherentFrom_of_iso (X.over V) _ h₃
      (((SheafOfModules.overFunctor.{w} (Stacks.SheafOfModules.Tensor.ringSheaf X.O) V)
        |>.mapDerivedCategorySingleFunctor 0).app M)

/-- **On a ringed site whose structure sheaf is coherent, a coherent module placed in degree
zero is `m`-pseudo-coherent for every integer `m`.**

The syzygies of a coherent module are coherent, locally, so its local resolutions by finite
free modules can be continued indefinitely. This is the site form of
`AlgebraicGeometry.isPseudoCoherentFrom_singleFunctor_zero_of_isCoherent`, and it is the input
the truncation induction
`AlgebraicGeometry.RingedSite.isPseudoCoherentFrom_of_homology_of_boundedAbove_general` needs
for the implication (1) ⇒ (2) of Stacks 08IK. -/
theorem isPseudoCoherentFrom_singleFunctor_zero_of_isCoherentOnSite
    (X : RingedSite.{max u v, v, w}) [HasSheafify X.J AddCommGrpCat.{w}]
    [X.J.WEqualsLocallyBijective AddCommGrpCat.{w}]
    [∀ U : X.C, HasSheafify (X.J.over U) AddCommGrpCat.{w}]
    [∀ U : X.C, (X.J.over U).WEqualsLocallyBijective AddCommGrpCat.{w}]
    (hO : SheafOfModules.IsCoherentOnSite
      (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (M : SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))
    (hM : SheafOfModules.IsCoherentOnSite M) (m : ℤ) :
    X.IsPseudoCoherentFrom
      ((DerivedCategory.singleFunctor
        (SheafOfModules.{w} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) 0).obj M) m :=
  isPseudoCoherentFrom_mono_general X _
    (isPseudoCoherentFrom_singleFunctor_zero_of_isCoherentOnSite_aux (1 - m).toNat X hO M hM)
    (by omega)

end Main

end AlgebraicGeometry.RingedSite

end
