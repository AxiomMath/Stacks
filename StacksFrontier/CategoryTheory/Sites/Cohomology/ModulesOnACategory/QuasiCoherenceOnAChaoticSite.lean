module

public import Mathlib.Algebra.Category.ModuleCat.Kernels
public import Mathlib.Algebra.Category.ModuleCat.Presheaf.Colimits
public import Mathlib.Algebra.Module.ULift
import StacksFrontier.AlgebraicGeometry.QcohRestrictEquiv.IsoLocality
public import StacksFrontier.AlgebraicGeometry.Topologies.QuasicoherentCokernels

/-!
# Quasi-coherence of a sheaf of modules on a category with the chaotic topology

A category `C` may be viewed as a site with the *chaotic* topology `⊥`, for which every
presheaf is a sheaf.  A sheaf of modules `F` over a sheaf of rings `R` on `(C, ⊥)` is
quasi-coherent, in the sense of the local module types, exactly when all of its restriction
maps are base-change maps: for every morphism `a : V ⟶ U` of `Cᵒᵖ` the `R(V)`-linear map
`F(V) ⟶ F(U)` is universal among `R(V)`-linear maps from `F(V)` into an `R(U)`-module, which
says that `F(U)` is `F(V) ⊗_{R(V)} R(U)`.

The base-change condition is phrased by its universal property rather than by a tensor
product because the sheaf of rings is not assumed commutative, so that
`ModuleCat.extendScalars` is unavailable.  `CategoryTheory.Functor.IsUniversalArrow` is that
universal property, and `CategoryTheory.Functor.isUniversalArrow_iff_isIso` turns it into the
invertibility of the base-change comparison map as soon as a left adjoint of restriction of
scalars is at hand.

## Main definitions

* `CategoryTheory.Functor.IsUniversalArrow`: a morphism `g : X ⟶ G.obj Y` is universal, that
  is, every morphism `X ⟶ G.obj Z` is `g` followed by `G` applied to a unique `Y ⟶ Z`.

## Main results

* `CategoryTheory.Functor.isUniversalArrow_iff_isIso`: for an adjunction `L ⊣ G`, a morphism
  `g : X ⟶ G.obj Y` is universal exactly when its adjoint transpose `L.obj X ⟶ Y` is an
  isomorphism.
* `CategoryTheory.Functor.IsUniversalArrow.of_iso`: universality is invariant under
  isomorphisms of the source and of the target.
* `Stacks.ModulesOnACategory.isQuasicoherentOnSite_iff_isUniversalArrow`: on a category with
  the chaotic topology, a sheaf of modules is quasi-coherent if and only if each of its
  restriction maps is universal for restriction of scalars.

## Implementation notes

The site objects, the site morphisms and the coefficient rings have independent universes
`u`, `v` and `r`.  The module universe is `max u v r m` with `m` free: a global presentation
of a sheaf of modules is by definition built in the universe `max u v r m`, and the proof
produces one from the universal property by generators and relations there, so the module
universe has to contain `max u v r`.  Everything else is independent.

The chaotic topology enters twice.  It makes the forgetful functor from sheaves of modules to
presheaves of modules an equivalence, which is how colimits of sheaves of modules and their
objectwise computation are obtained; and it makes `{𝟙 U}` a covering of every object `U`, so
that quasi-coherence reduces to the existence of a global presentation over each slice.  Each
slice `Over U` again carries the chaotic topology and has a terminal object, and over a
terminal object a module with universal restriction maps is generated by its sections there,
with its relations likewise generated over the terminal object; that is the presentation.

The free module of rank one is built by hand rather than taken as the universe lift of the
unit sheaf of modules, so that its sections are literally `ULift (R(X))` and the coefficient
ring is visible to instance search; the two are definitionally equal, which is what lets the
presentation produced here be read as a presentation in the sense of the universe-lifted unit.

## References

* [Stacks Project, Tag 03DL](https://stacks.math.columbia.edu/tag/03DL)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u v r m t w

namespace CategoryTheory.Functor

variable {D : Type*} [Category D] {E : Type*} [Category E]

/-- A morphism `g : X ⟶ G.obj Y` is a **universal arrow** from `X` to the functor `G` when
every morphism `X ⟶ G.obj Z` factors as `g` followed by `G` applied to a unique morphism
`Y ⟶ Z`.  Equivalently, `Y` together with `g` represents the value at `X` of a left adjoint of
`G`, whether or not that adjoint exists globally. -/
def IsUniversalArrow (G : E ⥤ D) {X : D} {Y : E} (g : X ⟶ G.obj Y) : Prop :=
  ∀ Z : E, Function.Bijective (fun f : Y ⟶ Z ↦ g ≫ G.map f)

/-- Under an adjunction `L ⊣ G`, a morphism `g : X ⟶ G.obj Y` is a universal arrow exactly
when its adjoint transpose `L.obj X ⟶ Y` is an isomorphism. -/
theorem isUniversalArrow_iff_isIso {L : D ⥤ E} {G : E ⥤ D} (adj : L ⊣ G) {X : D} {Y : E}
    (g : X ⟶ G.obj Y) :
    G.IsUniversalArrow g ↔ IsIso ((adj.homEquiv X Y).symm g) := by
  rw [isIso_iff_coyoneda_map_bijective]
  refine forall_congr' fun Z ↦ ?_
  rw [← Equiv.comp_bijective (e := adj.homEquiv X Z)]
  apply Iff.of_eq
  congr 1
  funext f
  simp [Adjunction.homEquiv_naturality_right]

/-- Universality is invariant under isomorphisms of the source and of the target, provided the
two universal arrows are compatible with them. -/
theorem IsUniversalArrow.of_iso {G : E ⥤ D} {X X' : D} {Y Y' : E} {g : X ⟶ G.obj Y}
    {g' : X' ⟶ G.obj Y'} (eX : X ≅ X') (eY : Y ≅ Y')
    (he : g ≫ G.map eY.hom = eX.hom ≫ g') (h : G.IsUniversalArrow g) :
    G.IsUniversalArrow g' := by
  intro Z
  have hh := (Iso.homCongr eX (Iso.refl (G.obj Z))).bijective.comp
    ((h Z).comp (Iso.homCongr eY.symm (Iso.refl Z)).bijective)
  convert hh using 1
  funext f
  simp only [Function.comp_def, Iso.homCongr_apply, Iso.symm_inv, Iso.refl_hom,
    Category.comp_id, Functor.map_comp]
  rw [← Category.assoc g, he]
  simp

end CategoryTheory.Functor

namespace Stacks.ModulesOnACategory

section Transport

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{r}}

/-- The restriction map of a sheaf of modules along `a : V ⟶ U`, read as a map of
`R(V)`-modules, is a universal arrow for restriction of scalars along `R(V) ⟶ R(U)`.  This is
the base-change condition: it says that `F(U)` is `F(V) ⊗_{R(V)} R(U)`. -/
private def IsBaseChanged {U V : Cᵒᵖ} (a : V ⟶ U) (F : SheafOfModules.{t} R) : Prop :=
  (ModuleCat.restrictScalars.{t} (R.obj.map a).hom).IsUniversalArrow (F.val.map a)

/-- Forgetting the sheaf condition preserves zero morphisms. -/
private instance preservesZeroForget :
    (SheafOfModules.forget.{t} R).PreservesZeroMorphisms :=
  ⟨fun _ _ ↦ rfl⟩

/-- Sections of a composite of morphisms of sheaves of modules. -/
private theorem comp_val_app {F G H : SheafOfModules.{t} R} (φ : F ⟶ G) (ψ : G ⟶ H) (X : Cᵒᵖ) :
    (φ ≫ ψ).val.app X = φ.val.app X ≫ ψ.val.app X := rfl

/-- Sections of the zero morphism of sheaves of modules. -/
private theorem zero_val_app (F G : SheafOfModules.{t} R) (X : Cᵒᵖ) :
    (0 : F ⟶ G).val.app X = 0 := rfl

/-- A sheaf of modules whose sections already live in the universe of global presentations is
isomorphic to its universe lift. -/
private noncomputable def uliftForPresentationIsoSelf.{u', v', r', m'} {C : Type u'}
    [Category.{v'} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{r'}}
    (G : SheafOfModules.{max u' v' r' m'} R) :
    G ≅ SheafOfModules.uliftForPresentation.{u', v', r', max u' v' r' m', max u' v' r'} G :=
  (SheafOfModules.fullyFaithfulForget R).preimageIso
    (PresheafOfModules.isoMk (fun X ↦ (ULift.moduleEquiv
      (R := R.obj.obj X) (M := G.val.obj X)).symm.toModuleIso) fun _ _ _ ↦ by ext; rfl)

/-- Restricting to a slice of the site does not change the base-change condition. -/
private theorem isBaseChanged_over_iff {W : C} {U V : (Over W)ᵒᵖ} (a : V ⟶ U)
    (F : SheafOfModules.{t} R) :
    IsBaseChanged a (F.over W) ↔ IsBaseChanged ((Over.forget W).op.map a) F := Iff.rfl

variable {U V : Cᵒᵖ} (a : V ⟶ U)

/-- The base-change condition, spelled out. -/
private theorem isBaseChanged_mk {F : SheafOfModules.{t} R}
    (hinj : ∀ (Z : ModuleCat.{t} (R.obj.obj U)) (g₁ g₂ : F.val.obj U ⟶ Z),
      F.val.map a ≫ (ModuleCat.restrictScalars (R.obj.map a).hom).map g₁ =
        F.val.map a ≫ (ModuleCat.restrictScalars (R.obj.map a).hom).map g₂ → g₁ = g₂)
    (hsurj : ∀ (Z : ModuleCat.{t} (R.obj.obj U))
      (y : F.val.obj V ⟶ (ModuleCat.restrictScalars (R.obj.map a).hom).obj Z),
      ∃ g : F.val.obj U ⟶ Z,
        F.val.map a ≫ (ModuleCat.restrictScalars (R.obj.map a).hom).map g = y) :
    IsBaseChanged a F :=
  fun Z ↦ ⟨fun g₁ g₂ h ↦ hinj Z g₁ g₂ h, fun y ↦ hsurj Z y⟩

/-- Cancellation half of the base-change condition. -/
private theorem eq_of_isBaseChanged {F : SheafOfModules.{t} R} (h : IsBaseChanged a F)
    {Z : ModuleCat.{t} (R.obj.obj U)} {g₁ g₂ : F.val.obj U ⟶ Z}
    (hg : F.val.map a ≫ (ModuleCat.restrictScalars (R.obj.map a).hom).map g₁ =
      F.val.map a ≫ (ModuleCat.restrictScalars (R.obj.map a).hom).map g₂) : g₁ = g₂ :=
  (h Z).1 hg

/-- Existence half of the base-change condition. -/
private theorem exists_of_isBaseChanged {F : SheafOfModules.{t} R} (h : IsBaseChanged a F)
    {Z : ModuleCat.{t} (R.obj.obj U)}
    (y : F.val.obj V ⟶ (ModuleCat.restrictScalars (R.obj.map a).hom).obj Z) :
    ∃ g : F.val.obj U ⟶ Z,
      F.val.map a ≫ (ModuleCat.restrictScalars (R.obj.map a).hom).map g = y :=
  (h Z).2 y

/-- Moving a morphism of sheaves of modules across a restriction map. -/
private theorem restrictScalars_map_comp {F G : SheafOfModules.{t} R} (φ : F ⟶ G)
    (Z : ModuleCat.{t} (R.obj.obj U)) (g : G.val.obj U ⟶ Z) :
    F.val.map a ≫ (ModuleCat.restrictScalars (R.obj.map a).hom).map (φ.val.app U ≫ g) =
      φ.val.app V ≫ (G.val.map a ≫
        (ModuleCat.restrictScalars (R.obj.map a).hom).map g) := by
  rw [Functor.map_comp, ← Category.assoc, φ.val.naturality a, Category.assoc]

/-- The base-change condition is invariant under isomorphism. -/
private theorem isBaseChanged_of_iso {F G : SheafOfModules.{t} R} (e : F ≅ G)
    (h : IsBaseChanged a F) : IsBaseChanged a G :=
  Functor.IsUniversalArrow.of_iso
    ((PresheafOfModules.evaluation R.obj V).mapIso ((SheafOfModules.forget R).mapIso e))
    ((PresheafOfModules.evaluation R.obj U).mapIso ((SheafOfModules.forget R).mapIso e))
    (e.hom.val.naturality a) h

/-- A morphism between two sheaves of modules satisfying the base-change condition is
invertible over `U` as soon as it is invertible over `V`. -/
private theorem isIso_app_of_isBaseChanged {F G : SheafOfModules.{t} R} (φ : F ⟶ G)
    (hF : IsBaseChanged a F) (hG : IsBaseChanged a G) (hV : IsIso (φ.val.app V)) :
    IsIso (φ.val.app U) := by
  refine isIso_of_coyoneda_map_bijective _ fun Z ↦ ?_
  have hpre : ∀ W : ModuleCat.{t} (R.obj.obj V),
      Function.Bijective (fun y : G.val.obj V ⟶ W ↦ φ.val.app V ≫ y) := by
    intro W
    refine ⟨fun y₁ y₂ hy ↦ ?_, fun z ↦ ⟨inv (φ.val.app V) ≫ z, by simp⟩⟩
    simpa using congrArg (fun k ↦ inv (φ.val.app V) ≫ k) hy
  rw [← (hF Z).of_comp_iff' (fun x : G.val.obj U ⟶ Z ↦ φ.val.app U ≫ x)]
  have hcomp : (fun g : F.val.obj U ⟶ Z ↦ F.val.map a ≫
        (ModuleCat.restrictScalars (R.obj.map a).hom).map g) ∘
        (fun x : G.val.obj U ⟶ Z ↦ φ.val.app U ≫ x) =
      (fun y : G.val.obj V ⟶ (ModuleCat.restrictScalars (R.obj.map a).hom).obj Z ↦
        φ.val.app V ≫ y) ∘
        (fun g : G.val.obj U ⟶ Z ↦ G.val.map a ≫
          (ModuleCat.restrictScalars (R.obj.map a).hom).map g) :=
    funext fun x ↦ restrictScalars_map_comp a φ Z x
  rw [hcomp]
  exact (hpre _).comp (hG Z)

/-- The base-change condition passes to a coproduct of copies of a module satisfying it,
provided evaluation over `U` and over `V` turns the cofan into a colimit cofan of modules. -/
private theorem isBaseChanged_of_cofan {I : Type w} {A P : SheafOfModules.{t} R}
    (ι : I → (A ⟶ P))
    (hU : IsColimit (Cofan.mk (P.val.obj U) (fun i ↦ (ι i).val.app U)))
    (hV : IsColimit (Cofan.mk (P.val.obj V) (fun i ↦ (ι i).val.app V)))
    (hA : IsBaseChanged a A) : IsBaseChanged a P := by
  refine isBaseChanged_mk a (fun Z g₁ g₂ hg ↦ ?_) (fun Z y ↦ ?_)
  · refine Cofan.IsColimit.hom_ext hU _ _ fun i ↦ ?_
    simp only [cofan_mk_inj]
    refine eq_of_isBaseChanged a hA ?_
    rw [restrictScalars_map_comp a (ι i) Z g₁, restrictScalars_map_comp a (ι i) Z g₂, hg]
  · choose g hg using fun i ↦ exists_of_isBaseChanged a hA ((ι i).val.app V ≫ y)
    refine ⟨Cofan.IsColimit.desc hU g, Cofan.IsColimit.hom_ext hV _ _ fun i ↦ ?_⟩
    simp only [cofan_mk_inj]
    have hfac : (ι i).val.app U ≫ Cofan.IsColimit.desc hU g = g i := by
      simpa only [cofan_mk_inj] using Cofan.IsColimit.fac hU g i
    rw [← restrictScalars_map_comp a (ι i) Z (Cofan.IsColimit.desc hU g), hfac, hg i]

/-- The base-change condition passes to a cokernel, provided evaluation over `U` and over `V`
turns the cokernel cofork into a colimit cofork of modules. -/
private theorem isBaseChanged_of_cokernel {Q P N : SheafOfModules.{t} R}
    {q : Q ⟶ P} {p : P ⟶ N}
    {hzU : q.val.app U ≫ p.val.app U = 0} {hzV : q.val.app V ≫ p.val.app V = 0}
    (hU : IsColimit (CokernelCofork.ofπ (f := q.val.app U) (p.val.app U) hzU))
    (hV : IsColimit (CokernelCofork.ofπ (f := q.val.app V) (p.val.app V) hzV))
    (hQ : IsBaseChanged a Q) (hP : IsBaseChanged a P) : IsBaseChanged a N := by
  refine isBaseChanged_mk a (fun Z g₁ g₂ hg ↦ ?_) (fun Z y ↦ ?_)
  · refine Cofork.IsColimit.hom_ext hU ?_
    simp only [Cofork.π_ofπ]
    refine eq_of_isBaseChanged a hP ?_
    rw [restrictScalars_map_comp a p Z g₁, restrictScalars_map_comp a p Z g₂, hg]
  · obtain ⟨g, hg⟩ := exists_of_isBaseChanged a hP (p.val.app V ≫ y)
    have hq : q.val.app U ≫ g = 0 := by
      refine eq_of_isBaseChanged a hQ ?_
      rw [restrictScalars_map_comp a q Z g, hg, ← Category.assoc, hzV, zero_comp,
        Functor.map_zero, comp_zero]
    refine ⟨hU.desc (CokernelCofork.ofπ g hq), Cofork.IsColimit.hom_ext hV ?_⟩
    have hfac : p.val.app U ≫ hU.desc (CokernelCofork.ofπ g hq) = g := by
      simpa only [Cofork.π_ofπ] using Cofork.IsColimit.π_desc (t := CokernelCofork.ofπ g hq) hU
    simp only [Cofork.π_ofπ]
    rw [← restrictScalars_map_comp a p Z (hU.desc (CokernelCofork.ofπ g hq)), hfac, hg]

end Transport

section Chaotic

variable {C : Type u} [Category.{v} C]

/-- For the chaotic topology, forgetting the sheaf condition is an equivalence from sheaves of
modules to presheaves of modules. -/
private instance isEquivalenceForget (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r}) :
    (SheafOfModules.forget.{t} R).IsEquivalence := by
  have : (SheafOfModules.forget.{t} R).EssSurj :=
    ⟨fun M ↦ ⟨⟨M, Presheaf.isSheaf_bot M.presheaf⟩, ⟨Iso.refl _⟩⟩⟩
  exact ⟨inferInstance, inferInstance, inferInstance⟩

/-- On a category with the chaotic topology, sheaves of modules have all colimits. -/
private instance hasColimitsSheafOfModules
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r}) :
    HasColimitsOfSize.{t, t} (SheafOfModules.{t} R) :=
  Adjunction.has_colimits_of_equivalence (SheafOfModules.forget.{t} R)

/-- Evaluation of sheaves of modules over an object of a category with the chaotic
topology. -/
private noncomputable abbrev sectionsOver.{u', v', r', t'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (X : Cᵒᵖ) :
    SheafOfModules.{t'} R ⥤ ModuleCat.{t'} (R.obj.obj X) :=
  SheafOfModules.forget R ⋙ PresheafOfModules.evaluation R.obj X

/-- Evaluation of sheaves of modules on a category with the chaotic topology turns a coproduct
cofan into a coproduct cofan of modules. -/
private noncomputable def isColimitCofanSections.{u', v', r', t'} {C : Type u'}
    [Category.{v'} C] (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (X : Cᵒᵖ)
    {I : Type t'} {A P : SheafOfModules.{t'} R} (ι : I → (A ⟶ P))
    (h : IsColimit (Cofan.mk P ι)) :
    IsColimit (Cofan.mk (P.val.obj X) (fun i ↦ (ι i).val.app X)) :=
  (Cofan.isColimitMapCoconeEquiv (sectionsOver.{u', v', r', t'} R X) _ (Cofan.mk P ι)).toFun
    (isColimitOfPreserves (sectionsOver.{u', v', r', t'} R X) h)

/-- Evaluation of sheaves of modules on a category with the chaotic topology turns a cokernel
cofork into a cokernel cofork of modules. -/
private noncomputable def isColimitCokernelCoforkSections.{u', v', r', t'} {C : Type u'}
    [Category.{v'} C] (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (X : Cᵒᵖ)
    {Q P N : SheafOfModules.{t'} R} {q : Q ⟶ P} {p : P ⟶ N} (hqp : q ≫ p = 0)
    (h : IsColimit (CokernelCofork.ofπ p hqp)) :
    IsColimit (CokernelCofork.ofπ (f := q.val.app X) (p.val.app X)
      (show q.val.app X ≫ p.val.app X = 0 by
        rw [← comp_val_app, hqp, zero_val_app])) :=
  CokernelCofork.mapIsColimit (CokernelCofork.ofπ p hqp) h
    (sectionsOver.{u', v', r', t'} R X)

/-- The base-change condition passes to a coproduct of copies of a sheaf of modules satisfying it,
on a category with the chaotic topology. -/
private theorem isBaseChanged_of_isColimit_cofan
    {R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r}} {U V : Cᵒᵖ} (a : V ⟶ U) {I : Type t}
    {A P : SheafOfModules.{t} R} (ι : I → (A ⟶ P))
    (hP : IsColimit (Cofan.mk P ι)) (hA : IsBaseChanged a A) : IsBaseChanged a P :=
  isBaseChanged_of_cofan a ι (isColimitCofanSections R U ι hP)
    (isColimitCofanSections R V ι hP) hA

/-- The base-change condition passes to a cokernel of sheaves of modules, on a category with the
chaotic topology. -/
private theorem isBaseChanged_of_isColimit_cokernelCofork
    {R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r}} {U V : Cᵒᵖ} (a : V ⟶ U)
    {Q P N : SheafOfModules.{t} R} {q : Q ⟶ P} {p : P ⟶ N} (hqp : q ≫ p = 0)
    (h : IsColimit (CokernelCofork.ofπ p hqp)) (hQ : IsBaseChanged a Q) (hP : IsBaseChanged a P) :
    IsBaseChanged a N :=
  isBaseChanged_of_cokernel a (isColimitCokernelCoforkSections R U hqp h)
    (isColimitCokernelCoforkSections R V hqp h) hQ hP

/-- Every slice of a category with the chaotic topology again carries the chaotic
topology. -/
private theorem over_bot (X : C) : (⊥ : GrothendieckTopology C).over X = ⊥ := by
  apply GrothendieckTopology.ext
  funext Y
  ext S
  simp [GrothendieckTopology.mem_over_iff]

/-- A covering family for the chaotic topology contains a split epimorphism; in particular one
of its members receives a morphism from the object being covered. -/
private theorem exists_section_of_bot_cover {X : C} {I : Type*} (V : I → C)
    (f : ∀ i, V i ⟶ X) (hc : Sieve.ofArrows V f ∈ (⊥ : GrothendieckTopology C) X) :
    ∃ i, ∃ s : X ⟶ V i, s ≫ f i = 𝟙 X := by
  rw [GrothendieckTopology.bot_covering] at hc
  have hid : Sieve.ofArrows V f (𝟙 X) := by rw [hc]; simp
  obtain ⟨i, s, hs⟩ := (Sieve.mem_ofArrows_iff V f (𝟙 X)).mp hid
  exact ⟨i, s, hs.symm⟩

end Chaotic


section FreeOne

/-- The free sheaf of modules of rank one over a category with the chaotic topology, with
sections `ULift (R(X))` over `X`.  It is definitionally the universe lift of the unit sheaf of
modules. -/
private noncomputable abbrev freeOne.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) :
    SheafOfModules.{max u' v' r' m'} R where
  val :=
    { obj := fun X ↦ ModuleCat.of (R.obj.obj X) (ULift.{max u' v' r' m'} (R.obj.obj X))
      map := fun {X Y} f ↦ ModuleCat.ofHom
        (Y := (ModuleCat.restrictScalars (R.obj.map f).hom).obj
          (ModuleCat.of (R.obj.obj Y) (ULift.{max u' v' r' m'} (R.obj.obj Y))))
        { toFun := fun c ↦ ULift.up ((R.obj.map f).hom c.down)
          map_add' := fun c d ↦ ULift.ext _ _ (map_add (R.obj.map f).hom c.down d.down)
          map_smul' := fun s c ↦ ULift.ext _ _ (map_mul (R.obj.map f).hom s c.down) }
      map_id := fun X ↦ by ext c; exact congrArg ULift.up (by simp)
      map_comp := fun f g ↦ by
        ext c
        exact congrArg ULift.up (by rw [R.obj.map_comp]; rfl) }
  isSheaf := Presheaf.isSheaf_bot _

/-- The morphism out of the free sheaf of modules of rank one determined by a section of the
target. -/
private noncomputable def freeOneHom.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (X : Cᵒᵖ)
    {Z : ModuleCat.{max u' v' r' m'} (R.obj.obj X)} (z : Z) :
    (freeOne.{u', v', r', m'} R).val.obj X ⟶ Z :=
  ModuleCat.ofHom
    { toFun := fun c ↦ c.down • z
      map_add' := fun c d ↦ add_smul c.down d.down z
      map_smul' := fun s c ↦ by
        change (s * c.down) • z = s • c.down • z
        exact mul_smul _ _ _ }

/-- `freeOneHom` sends the canonical generator to the given section. -/
private theorem freeOneHom_gen.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (X : Cᵒᵖ)
    {Z : ModuleCat.{max u' v' r' m'} (R.obj.obj X)} (z : Z) :
    (freeOneHom.{u', v', r', m'} R X z).hom (ULift.up (1 : R.obj.obj X)) = z := by
  show (1 : R.obj.obj X) • z = z
  exact one_smul _ _

/-- Two morphisms out of the free sheaf of modules of rank one agree as soon as they agree on
the canonical generator. -/
private theorem freeOne_hom_ext.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (X : Cᵒᵖ)
    {Z : ModuleCat.{max u' v' r' m'} (R.obj.obj X)}
    {g₁ g₂ : (freeOne.{u', v', r', m'} R).val.obj X ⟶ Z}
    (h : g₁.hom (ULift.up (1 : R.obj.obj X)) = g₂.hom (ULift.up (1 : R.obj.obj X))) :
    g₁ = g₂ := by
  refine ModuleCat.hom_ext (LinearMap.ext fun ⟨s⟩ ↦ ?_)
  show g₁.hom (ULift.up s) = g₂.hom (ULift.up s)
  have hs : (ULift.up s : ULift.{max u' v' r' m'} (R.obj.obj X)) =
      s • ULift.up (1 : R.obj.obj X) := ULift.ext _ _ (by simp)
  rw [hs, map_smul, map_smul, h]

/-- Postcomposition evaluated at the canonical generator. -/
private theorem freeOne_comp_gen.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (X : Cᵒᵖ)
    {Z W : ModuleCat.{max u' v' r' m'} (R.obj.obj X)}
    (g : (freeOne.{u', v', r', m'} R).val.obj X ⟶ Z) (k : Z ⟶ W) :
    (g ≫ k).hom (ULift.up (1 : R.obj.obj X)) =
      k.hom (g.hom (ULift.up (1 : R.obj.obj X))) := rfl

/-- The restriction map of the free sheaf of modules of rank one carries the canonical
generator to the canonical generator. -/
private theorem freeOne_restriction_gen.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) {U V : Cᵒᵖ} (a : V ⟶ U)
    {Z : ModuleCat.{max u' v' r' m'} (R.obj.obj U)}
    (g : (freeOne.{u', v', r', m'} R).val.obj U ⟶ Z) :
    ((freeOne.{u', v', r', m'} R).val.map a ≫
        (ModuleCat.restrictScalars (R.obj.map a).hom).map g).hom
        (ULift.up (1 : R.obj.obj V)) =
      g.hom (ULift.up (1 : R.obj.obj U)) := by
  show g.hom (ULift.up ((R.obj.map a).hom 1)) = g.hom (ULift.up 1)
  rw [map_one]

/-- The restriction maps of the free sheaf of modules of rank one are base-change maps. -/
private theorem isBaseChanged_freeOne.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) {U V : Cᵒᵖ} (a : V ⟶ U) :
    IsBaseChanged a (freeOne.{u', v', r', m'} R) := by
  refine isBaseChanged_mk a (fun Z g₁ g₂ hg ↦ ?_) (fun Z y ↦ ?_)
  · refine freeOne_hom_ext.{u', v', r', m'} R U ?_
    rw [← freeOne_restriction_gen.{u', v', r', m'} R a g₁,
      ← freeOne_restriction_gen.{u', v', r', m'} R a g₂, hg]
  · obtain ⟨z, hz⟩ : ∃ z : (Z : Type (max u' v' r' m')),
        y.hom (ULift.up (1 : R.obj.obj V)) = z := ⟨_, rfl⟩
    refine ⟨freeOneHom.{u', v', r', m'} R U z, ?_⟩
    refine freeOne_hom_ext.{u', v', r', m'} R V ?_
    rw [freeOne_restriction_gen.{u', v', r', m'} R a, freeOneHom_gen]
    exact hz.symm

end FreeOne

section Generators

/-- The restriction to `Y` of a section over a terminal object. -/
private noncomputable def terminalRestrict.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    (G : SheafOfModules.{max u' v' r' m'} R) (x : G.val.obj (Opposite.op T)) (Y : Cᵒᵖ) :
    (G.val.obj Y : Type (max u' v' r' m')) := (G.val.map (hT.from Y.unop).op).hom x

/-- The restrictions of a section over a terminal object are compatible. -/
private theorem map_terminalRestrict.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    (G : SheafOfModules.{max u' v' r' m'} R) (x : G.val.obj (Opposite.op T))
    {Y Z : Cᵒᵖ} (f : Y ⟶ Z) :
    (G.val.map f).hom (terminalRestrict.{u', v', r', m'} R T hT G x Y) =
      terminalRestrict.{u', v', r', m'} R T hT G x Z :=
  (G.val.map_comp_apply (hT.from Y.unop).op f x).symm.trans
    (G.val.congr_map_apply (Quiver.Hom.unop_inj (hT.hom_ext _ _)) x)

/-- The restriction of a section over a terminal object to that object is the section. -/
private theorem terminalRestrict_self.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    (G : SheafOfModules.{max u' v' r' m'} R) (x : G.val.obj (Opposite.op T)) :
    terminalRestrict.{u', v', r', m'} R T hT G x (Opposite.op T) = x := by
  refine (G.val.congr_map_apply (show (hT.from (Opposite.op T).unop).op =
    𝟙 (Opposite.op T) from Quiver.Hom.unop_inj (hT.hom_ext _ _)) x).trans ?_
  simp
  rfl

/-- The morphism out of the free sheaf of modules of rank one determined by a section over a
terminal object: it sends the canonical generator to the restrictions of that section. -/
private noncomputable def generatorHom.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    (G : SheafOfModules.{max u' v' r' m'} R) (x : G.val.obj (Opposite.op T)) :
    freeOne.{u', v', r', m'} R ⟶ G where
  val :=
    { app := fun Y ↦ freeOneHom.{u', v', r', m'} R Y
        (terminalRestrict.{u', v', r', m'} R T hT G x Y)
      naturality := by
        intro Y Z f
        refine freeOne_hom_ext.{u', v', r', m'} R Y ?_
        rw [freeOne_restriction_gen.{u', v', r', m'} R f,
          freeOneHom_gen.{u', v', r', m'},
          freeOne_comp_gen.{u', v', r', m'}, freeOneHom_gen.{u', v', r', m'}]
        exact (map_terminalRestrict.{u', v', r', m'} R T hT G x f).symm }

/-- The value of `generatorHom` at the canonical generator over an object. -/
private theorem generatorHom_val_app_gen.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    (G : SheafOfModules.{max u' v' r' m'} R) (x : G.val.obj (Opposite.op T)) (Y : Cᵒᵖ) :
    ((generatorHom.{u', v', r', m'} R T hT G x).val.app Y).hom
        (ULift.up (1 : R.obj.obj Y)) =
      terminalRestrict.{u', v', r', m'} R T hT G x Y :=
  freeOneHom_gen.{u', v', r', m'} R Y _

/-- `generatorHom` sends the canonical generator over the terminal object to the given
section. -/
private theorem generatorHom_gen.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    (G : SheafOfModules.{max u' v' r' m'} R) (x : G.val.obj (Opposite.op T)) :
    ((generatorHom.{u', v', r', m'} R T hT G x).val.app (Opposite.op T)).hom
      (ULift.up (1 : R.obj.obj (Opposite.op T))) = x :=
  (generatorHom_val_app_gen.{u', v', r', m'} R T hT G x _).trans
    (terminalRestrict_self.{u', v', r', m'} R T hT G x)

/-- `generatorHom` is natural in the target. -/
private theorem generatorHom_comp.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    {G G' : SheafOfModules.{max u' v' r' m'} R} (x : G.val.obj (Opposite.op T)) (φ : G ⟶ G') :
    generatorHom.{u', v', r', m'} R T hT G x ≫ φ =
      generatorHom.{u', v', r', m'} R T hT G'
        ((φ.val.app (Opposite.op T)).hom x) := by
  refine SheafOfModules.Hom.ext (PresheafOfModules.hom_ext fun Y ↦ ?_)
  refine freeOne_hom_ext.{u', v', r', m'} R Y ?_
  rw [comp_val_app, freeOne_comp_gen.{u', v', r', m'},
    generatorHom_val_app_gen.{u', v', r', m'}, generatorHom_val_app_gen.{u', v', r', m'}]
  exact PresheafOfModules.naturality_apply φ.val _ x

/-- `generatorHom` at the zero section is the zero morphism. -/
private theorem generatorHom_zero.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    (G : SheafOfModules.{max u' v' r' m'} R) :
    generatorHom.{u', v', r', m'} R T hT G 0 = 0 := by
  refine SheafOfModules.Hom.ext (PresheafOfModules.hom_ext fun Y ↦ ?_)
  refine freeOne_hom_ext.{u', v', r', m'} R Y ?_
  rw [generatorHom_val_app_gen.{u', v', r', m'}, zero_val_app]
  simp [terminalRestrict]
  rfl

end Generators

section Presentation

/-- The free sheaf of modules on the sections of `G` over the terminal object `T`. -/
private noncomputable abbrev genObj.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C)
    (G : SheafOfModules.{max u' v' r' m'} R) : SheafOfModules.{max u' v' r' m'} R :=
  ∐ fun _ : (G.val.obj (Opposite.op T) : Type (max u' v' r' m')) ↦ freeOne.{u', v', r', m'} R

/-- The map onto `G` from the free sheaf of modules on its sections over the terminal
object. -/
private noncomputable def genMap.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    (G : SheafOfModules.{max u' v' r' m'} R) : genObj.{u', v', r', m'} R T G ⟶ G :=
  Sigma.desc fun x ↦ generatorHom.{u', v', r', m'} R T hT G x

/-- `genMap` restricted to the summand at the index `x` is `generatorHom` at `x`. -/
private theorem ι_comp_genMap.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    (G : SheafOfModules.{max u' v' r' m'} R)
    (x : (G.val.obj (Opposite.op T) : Type (max u' v' r' m'))) :
    Sigma.ι (fun _ : (G.val.obj (Opposite.op T) : Type (max u' v' r' m')) ↦
        freeOne.{u', v', r', m'} R) x ≫ genMap.{u', v', r', m'} R T hT G =
      generatorHom.{u', v', r', m'} R T hT G x :=
  Sigma.ι_desc _ _

/-- The presentation map sends the canonical generator at the index `x` to `x`. -/
private theorem genMap_apply_gen.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    (G : SheafOfModules.{max u' v' r' m'} R)
    (x : (G.val.obj (Opposite.op T) : Type (max u' v' r' m'))) :
    ((genMap.{u', v', r', m'} R T hT G).val.app (Opposite.op T)).hom
      (((Sigma.ι (fun _ : (G.val.obj (Opposite.op T) : Type (max u' v' r' m')) ↦
          freeOne.{u', v', r', m'} R) x).val.app (Opposite.op T)).hom
        (ULift.up (1 : R.obj.obj (Opposite.op T)))) = x := by
  rw [← freeOne_comp_gen.{u', v', r', m'}, ← comp_val_app, ι_comp_genMap]
  exact generatorHom_gen.{u', v', r', m'} R T hT G x

/-- The relations of the presentation: the sections over the terminal object of the free sheaf
of modules on the generators that are killed by the presentation map. -/
private abbrev relIdx.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    (G : SheafOfModules.{max u' v' r' m'} R) : Type (max u' v' r' m') :=
  {x : ((genObj.{u', v', r', m'} R T G).val.obj (Opposite.op T) :
      Type (max u' v' r' m')) //
    ((genMap.{u', v', r', m'} R T hT G).val.app (Opposite.op T)).hom x = 0}

/-- The free sheaf of modules on the relations. -/
private noncomputable abbrev relObj.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    (G : SheafOfModules.{max u' v' r' m'} R) : SheafOfModules.{max u' v' r' m'} R :=
  ∐ fun _ : relIdx.{u', v', r', m'} R T hT G ↦ freeOne.{u', v', r', m'} R

/-- The map from the free sheaf of modules on the relations to the one on the generators. -/
private noncomputable def relMap.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    (G : SheafOfModules.{max u' v' r' m'} R) :
    relObj.{u', v', r', m'} R T hT G ⟶ genObj.{u', v', r', m'} R T G :=
  Sigma.desc fun x ↦
    generatorHom.{u', v', r', m'} R T hT (genObj.{u', v', r', m'} R T G) x.1

/-- `relMap` restricted to the summand at the index `x` is `generatorHom` at `x`. -/
private theorem ι_comp_relMap.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    (G : SheafOfModules.{max u' v' r' m'} R) (x : relIdx.{u', v', r', m'} R T hT G) :
    Sigma.ι (fun _ : relIdx.{u', v', r', m'} R T hT G ↦ freeOne.{u', v', r', m'} R) x ≫
        relMap.{u', v', r', m'} R T hT G =
      generatorHom.{u', v', r', m'} R T hT (genObj.{u', v', r', m'} R T G) x.1 :=
  Sigma.ι_desc _ _

/-- The relation map sends the canonical generator at the index `x` to `x`. -/
private theorem relMap_apply_gen.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    (G : SheafOfModules.{max u' v' r' m'} R) (x : relIdx.{u', v', r', m'} R T hT G) :
    ((relMap.{u', v', r', m'} R T hT G).val.app (Opposite.op T)).hom
      (((Sigma.ι (fun _ : relIdx.{u', v', r', m'} R T hT G ↦
          freeOne.{u', v', r', m'} R) x).val.app (Opposite.op T)).hom
        (ULift.up (1 : R.obj.obj (Opposite.op T)))) = x.1 := by
  rw [← freeOne_comp_gen.{u', v', r', m'}, ← comp_val_app, ι_comp_relMap]
  exact generatorHom_gen.{u', v', r', m'} R T hT _ x.1

/-- The relations are killed by the presentation map. -/
private theorem relMap_comp_genMap.{u', v', r', m'} {C : Type u'} [Category.{v'} C]
    (R : Sheaf (⊥ : GrothendieckTopology C) RingCat.{r'}) (T : C) (hT : IsTerminal T)
    (G : SheafOfModules.{max u' v' r' m'} R) :
    relMap.{u', v', r', m'} R T hT G ≫ genMap.{u', v', r', m'} R T hT G = 0 := by
  refine Sigma.hom_ext _ _ fun x ↦ ?_
  rw [← Category.assoc, ι_comp_relMap, comp_zero, generatorHom_comp, x.2, generatorHom_zero]

end Presentation

section Criterion

/-- A global presentation forces all restriction maps to be base-change maps. -/
private theorem isBaseChanged_of_hasGlobalPresentation.{u', v', r', m'} {C : Type u'}
    [Category.{v'} C] {J : GrothendieckTopology C} (hJ : J = ⊥) {R : Sheaf J RingCat.{r'}}
    (G : SheafOfModules.{max u' v' r' m'} R) (hG : G.HasGlobalPresentation)
    {U V : Cᵒᵖ} (a : V ⟶ U) : IsBaseChanged a G := by
  subst hJ
  obtain ⟨I, K, P, Q, ι, κ, ⟨hP⟩, ⟨hQ⟩, q, b, hqb, ⟨hc⟩⟩ := hG
  have hA := isBaseChanged_freeOne.{u', v', r', m'} R a
  have hPbc : IsBaseChanged a P :=
    isBaseChanged_of_isColimit_cofan a ι hP hA
  have hQbc : IsBaseChanged a Q :=
    isBaseChanged_of_isColimit_cofan a κ hQ hA
  have hlift : IsBaseChanged a
      (SheafOfModules.uliftForPresentation.{u', v', r', max u' v' r' m', max u' v' r'} G) :=
    isBaseChanged_of_isColimit_cokernelCofork a hqb hc hQbc hPbc
  exact isBaseChanged_of_iso a
    (uliftForPresentationIsoSelf.{u', v', r', m'} G).symm hlift

/-- Over a terminal object, universal restriction maps give a global presentation: the sections
over the terminal object generate, and their relations are generated over the terminal object
as well. -/
private theorem hasGlobalPresentation_of_isBaseChanged.{u', v', r', m'} {C : Type u'}
    [Category.{v'} C] {J : GrothendieckTopology C} (hJ : J = ⊥) {R : Sheaf J RingCat.{r'}}
    (T : C) (hT : IsTerminal T) (G : SheafOfModules.{max u' v' r' m'} R)
    (hG : ∀ W : C, IsBaseChanged (hT.from W).op G) : G.HasGlobalPresentation := by
  subst hJ
  classical
  have hzb := relMap_comp_genMap.{u', v', r', m'} R T hT G
  have hbsurj : Function.Surjective
      ((sectionsOver.{u', v', r', max u' v' r' m'} R (Opposite.op T)).map
        (genMap.{u', v', r', m'} R T hT G)).hom := fun x ↦
    ⟨((Sigma.ι (fun _ : (G.val.obj (Opposite.op T) : Type (max u' v' r' m')) ↦
        freeOne.{u', v', r', m'} R) x).val.app (Opposite.op T)).hom
      (ULift.up (1 : R.obj.obj (Opposite.op T))),
      genMap_apply_gen.{u', v', r', m'} R T hT G x⟩
  have hexact : Function.Exact
      ((sectionsOver.{u', v', r', max u' v' r' m'} R (Opposite.op T)).map
        (relMap.{u', v', r', m'} R T hT G)).hom
      ((sectionsOver.{u', v', r', max u' v' r' m'} R (Opposite.op T)).map
        (genMap.{u', v', r', m'} R T hT G)).hom := by
    intro x
    refine ⟨fun hx ↦ ?_, ?_⟩
    · exact ⟨((Sigma.ι (fun _ : relIdx.{u', v', r', m'} R T hT G ↦
        freeOne.{u', v', r', m'} R)
          (⟨x, hx⟩ : relIdx.{u', v', r', m'} R T hT G)).val.app (Opposite.op T)).hom
        (ULift.up (1 : R.obj.obj (Opposite.op T))),
        relMap_apply_gen.{u', v', r', m'} R T hT G ⟨x, hx⟩⟩
    · rintro ⟨y, rfl⟩
      exact congrArg (fun φ ↦
        ((sectionsOver.{u', v', r', max u' v' r' m'} R (Opposite.op T)).map φ).hom y) hzb
  have hgdef : cokernel.π (relMap.{u', v', r', m'} R T hT G) ≫
      cokernel.desc _ (genMap.{u', v', r', m'} R T hT G) hzb =
      genMap.{u', v', r', m'} R T hT G := cokernel.π_desc _ _ hzb
  have hgT : IsIso ((cokernel.desc _ (genMap.{u', v', r', m'} R T hT G) hzb).val.app
      (Opposite.op T)) := by
    have hcokerT := isColimitCokernelCoforkSections R (Opposite.op T)
      (cokernel.condition (relMap.{u', v', r', m'} R T hT G))
      (cokernelIsCokernel (relMap.{u', v', r', m'} R T hT G))
    have hEb := ModuleCat.isColimitCokernelCofork
      ((sectionsOver.{u', v', r', max u' v' r' m'} R (Opposite.op T)).map
        (relMap.{u', v', r', m'} R T hT G))
      ((sectionsOver.{u', v', r', max u' v' r' m'} R (Opposite.op T)).map
        (genMap.{u', v', r', m'} R T hT G)) hexact hbsurj
    have heq : (cokernel.desc _ (genMap.{u', v', r', m'} R T hT G) hzb).val.app
        (Opposite.op T) = (hcokerT.coconePointUniqueUpToIso hEb).hom := by
      refine Cofork.IsColimit.hom_ext hcokerT ?_
      simp only [Cofork.π_ofπ]
      rw [← comp_val_app, hgdef]
      exact (hcokerT.comp_coconePointUniqueUpToIso_hom hEb WalkingParallelPair.one).symm
    rw [heq]
    exact ⟨⟨(hcokerT.coconePointUniqueUpToIso hEb).inv,
      (hcokerT.coconePointUniqueUpToIso hEb).hom_inv_id,
      (hcokerT.coconePointUniqueUpToIso hEb).inv_hom_id⟩⟩
  have hgiso : IsIso (cokernel.desc _ (genMap.{u', v', r', m'} R T hT G) hzb) := by
    refine Stacks.AlgebraicGeometry.QcohRestrictEquiv.isIso_of_isIso_val_app _ fun X ↦ ?_
    obtain ⟨W⟩ := X
    have hA := isBaseChanged_freeOne.{u', v', r', m'} R (hT.from W).op
    have hPbc : IsBaseChanged (hT.from W).op (genObj.{u', v', r', m'} R T G) :=
      isBaseChanged_of_isColimit_cofan _ (Sigma.ι _) (coproductIsCoproduct _) hA
    have hQbc : IsBaseChanged (hT.from W).op (relObj.{u', v', r', m'} R T hT G) :=
      isBaseChanged_of_isColimit_cofan _ (Sigma.ι _) (coproductIsCoproduct _) hA
    have hNbc : IsBaseChanged (hT.from W).op
        (cokernel (relMap.{u', v', r', m'} R T hT G)) :=
      isBaseChanged_of_isColimit_cokernelCofork _ (cokernel.condition _)
        (cokernelIsCokernel (relMap.{u', v', r', m'} R T hT G)) hQbc hPbc
    exact isIso_app_of_isBaseChanged _ _ hNbc (hG W) hgT
  have hcb : IsColimit (CokernelCofork.ofπ (genMap.{u', v', r', m'} R T hT G) hzb) :=
    (cokernelIsCokernel (relMap.{u', v', r', m'} R T hT G)).ofIsoColimit
      (Cofork.ext (@asIso _ _ _ _
        (cokernel.desc _ (genMap.{u', v', r', m'} R T hT G) hzb) hgiso) hgdef)
  have hz2 : relMap.{u', v', r', m'} R T hT G ≫
      (genMap.{u', v', r', m'} R T hT G ≫
        (uliftForPresentationIsoSelf.{u', v', r', m'} G).hom) = 0 := by
    rw [← Category.assoc, hzb, zero_comp]
  exact ⟨(G.val.obj (Opposite.op T) : Type (max u' v' r' m')),
    relIdx.{u', v', r', m'} R T hT G, genObj.{u', v', r', m'} R T G,
    relObj.{u', v', r', m'} R T hT G, Sigma.ι _, Sigma.ι _,
    ⟨coproductIsCoproduct _⟩, ⟨coproductIsCoproduct _⟩,
    relMap.{u', v', r', m'} R T hT G,
    genMap.{u', v', r', m'} R T hT G ≫
      (uliftForPresentationIsoSelf.{u', v', r', m'} G).hom, hz2,
    ⟨hcb.ofIsoColimit (Cofork.ext (uliftForPresentationIsoSelf.{u', v', r', m'} G) rfl)⟩⟩

/-- **Quasi-coherence on a category with the chaotic topology.** A sheaf of modules on a
category carrying the chaotic topology is quasi-coherent if and only if all of its restriction
maps are base-change maps: for every morphism `a : V ⟶ U` of `Cᵒᵖ`, the map `F(V) ⟶ F(U)` is
universal among `R(V)`-linear maps from `F(V)` into an `R(U)`-module.

Unfolded, the right-hand side says that for every `a` and every `R(U)`-module `Z` the map
`g ↦ F.val.map a ≫ (ModuleCat.restrictScalars (R.obj.map a).hom).map g` is bijective. -/
theorem isQuasicoherentOnSite_iff_isUniversalArrow.{u', v', r', m'} {C : Type u'}
    [Category.{v'} C] {J : GrothendieckTopology C} (hJ : J = ⊥) {R : Sheaf J RingCat.{r'}}
    (F : SheafOfModules.{max u' v' r' m'} R) :
    F.IsQuasicoherentOnSite ↔
      ∀ {U V : Cᵒᵖ} (a : V ⟶ U),
        (ModuleCat.restrictScalars (R.obj.map a).hom).IsUniversalArrow (F.val.map a) := by
  subst hJ
  constructor
  · intro hF U V a
    obtain ⟨I, W, p, hcover, hpres⟩ := hF.locally_hasGlobalPresentation V.unop
    obtain ⟨i, s, -⟩ := exists_section_of_bot_cover W p hcover
    exact (isBaseChanged_over_iff
      (Over.homMk (U := (Over.mk (a.unop ≫ s) : Over (W i))) (V := Over.mk s)
        a.unop rfl).op F).mp
      (isBaseChanged_of_hasGlobalPresentation.{max u' v', v', r', m'}
        (over_bot (W i)) (F.over (W i)) (hpres i) _)
  · intro h
    refine ⟨fun W ↦ ⟨PUnit.{max u' v' + 1}, fun _ ↦ W, fun _ ↦ 𝟙 W, ?_, fun _ ↦ ?_⟩⟩
    · rw [GrothendieckTopology.bot_covering]
      exact top_unique fun Y f _ ↦ (Sieve.mem_ofArrows_iff _ _ _).mpr ⟨PUnit.unit, f, by simp⟩
    · exact hasGlobalPresentation_of_isBaseChanged.{max u' v', v', r', m'}
        (over_bot W) (Over.mk (𝟙 W)) Over.mkIdTerminal (F.over W) fun Y ↦
          (isBaseChanged_over_iff (Over.mkIdTerminal.from Y).op F).mpr
            (h ((Over.mkIdTerminal.from Y).left).op)

end Criterion

end Stacks.ModulesOnACategory

