module

public import Mathlib.CategoryTheory.Sites.SheafCohomology.Basic
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ULiftFiniteColimits
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ULiftUnit
public import StacksFrontier.CategoryTheory.Sites.Cohomology.Modules.CohomologyOfModules
public import StacksFrontier.CategoryTheory.Sites.Cohomology.Modules.ModuleCohomologyAbelianComparison
public import StacksFrontier.CategoryTheory.Sites.GlobalSections.ModuleCohomologyComparison
public import StacksFrontier.CategoryTheory.Sites.Modules.ExtendScalarsAdjunction
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Module cohomology out of the lifted structure sheaf is the cohomology of the abelian sheaf

Let `(C, J)` be a site and `R` a sheaf of rings on it, valued in `RingCat.{w}`, and consider
sheaves of `R`-modules with sections in the universe `max u v w` generated by the site and the
rings. At such a universe the structure sheaf `R` is not itself an object of `Mod(R)` — its
sections lie in `Type w` — but its universe lift `Stacks.SheafOfModules.uliftUnit R` is, and it is
still free of rank one: a morphism out of it is a global section of the target.

This file proves that for every sheaf of `R`-modules `M` and every degree `n`

`Ext^n_{Mod(R)}(uliftUnit R, M) ≅ H^n(C, M_ab)`,

naturally in `M`, where `M_ab` is the underlying abelian sheaf and `H^n` is Mathlib's
`CategoryTheory.Sheaf.functorH`, `Ext^n` out of the constant sheaf `ℤ`. This is **Stacks 03FD**
for global cohomology, on a site with no terminal object and with the ring universe and the module
universe independent.

## Main definitions

* `Stacks.Cohomology.ULiftUnitComparison.uliftUnitHomAddEquiv`: a morphism out of the lifted
  structure sheaf is a map of abelian presheaves out of the constant presheaf `ℤ`.
* `Stacks.Cohomology.ULiftUnitComparison.uliftUnitCoyonedaIso`: in degree zero, maps out of the
  lifted structure sheaf and maps out of the constant sheaf `ℤ` into the underlying abelian sheaf
  are the same functor.
* `Stacks.Cohomology.ULiftUnitComparison.extULiftUnitIso`: the comparison in every degree.

## Main results

* `Stacks.Cohomology.ULiftUnitComparison.isZero_ext_uliftUnit_iff`: `Ext^n(uliftUnit R, M)`
  vanishes exactly when `H^n(C, M_ab)` does.

## Implementation notes

The proof is the `δ`-functor argument of the source, through
`ModuleSheafCohomology.extComparisonIso`: forgetting to abelian sheaves is exact, the two
degree-zero functors agree, and the underlying abelian sheaf of an injective sheaf of modules has
no higher `Ext` out of the sectionwise torsion-free sheaf `ℤ`
(`Stacks.SheafOfModules.ext_eq_zero_of_isTorsionFree`, at independent ring and module universes).
`Stacks.Cohomology.ModuleAbelianComparison.moduleFunctorHIsoOfIsTerminal` is the same comparison
for the structure sheaf itself at the ring universe, on a site with a terminal object; the
degree-zero identification here goes through the sheafification adjunction instead of a terminal
object, so no terminal object is needed.

## References

* [Stacks Project, Tag 03FD](https://stacks.math.columbia.edu/tag/03FD)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Abelian Opposite
open Stacks.Cohomology.ModuleAbelianComparison (constantZ constantZ_isTorsionFree)

universe w v u t

namespace Stacks.Cohomology.ULiftUnitComparison

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C) (R : Sheaf J RingCat.{w})

attribute [local instance] Stacks.Cohomology.BiggerSiteModules.hasSheafify_source
  Stacks.Cohomology.BiggerSiteModules.wEqualsLocallyBijective_source
  Stacks.Cohomology.ModuleAbelianComparison.hasExt

/-- The category of abelian sheaves on `J`, at the universe `max u v w`, has enough injectives. -/
@[sga "4 V 0.2.1" "abelian sheaves on sites"]
local instance enoughInjectivesAb : EnoughInjectives (Sheaf J AddCommGrpCat.{max u v w}) :=
  Stacks.Cohomology.SiteModules.site_enoughInjectives_addCommGrp.{u, v, w} (J := J)

/-- The category of sheaves of `R`-modules, at the universe `max u v w`, has enough injectives. -/
@[sga "4 V 0.2.1" "special case"]
local instance enoughInjectivesModules :
    EnoughInjectives (SheafOfModules.{max u v w} R) :=
  Stacks.Cohomology.SiteModules.moduleSheavesEnoughInjectives.{u, v, w, 0} R

/-- The category of sheaves of `R`-modules has `Ext`-groups in the universe `max u v w`. -/
local instance hasExtModules : HasExt.{max u v w} (SheafOfModules.{max u v w} R) :=
  have := Stacks.Cohomology.SiteModules.moduleSheavesGrothendieck.{u, v, w, 0} R
  inferInstance

/-- The functor from sheaves of `R`-modules to abelian sheaves preserves finite colimits. -/
local instance toSheaf_preservesFiniteColimits :
    PreservesFiniteColimits (SheafOfModules.toSheaf.{max u v w} R) :=
  Stacks.SheafOfModules.toSheaf_preservesFiniteColimits.{max u v w} R

/-- The constant presheaf `ℤ` on the site, with values in the universe of the modules. -/
abbrev constantZPresheaf : Cᵒᵖ ⥤ AddCommGrpCat.{max u v w} :=
  (Functor.const Cᵒᵖ).obj (AddCommGrpCat.of (ULift.{max u v w} ℤ))

variable {J R}

/-- The map of abelian presheaves `ℤ ⟶ M` sending `1` to the image of the generator under a
morphism `uliftUnit R ⟶ M`. -/
def uliftUnitHomToConst (M : SheafOfModules.{max u v w} R)
    (φ : Stacks.SheafOfModules.uliftUnit.{max u v} R ⟶ M) :
    constantZPresheaf.{w, v, u} (C := C) ⟶ M.val.presheaf where
  app X := AddCommGrpCat.ofHom ((zmultiplesHom _
    (φ.val.app X (ULift.up (1 : R.obj.obj X)))).comp AddEquiv.ulift.toAddMonoidHom)
  naturality {X Y} g := by
    ext (n : ULift ℤ)
    change n.down • φ.val.app Y (ULift.up (1 : R.obj.obj Y)) =
      M.val.map g (n.down • φ.val.app X (ULift.up (1 : R.obj.obj X)))
    rw [map_zsmul]
    congr 1
    refine Eq.trans ?_ (PresheafOfModules.naturality_apply φ.val g
      (ULift.up (1 : R.obj.obj X)))
    exact congrArg (φ.val.app Y) (congrArg ULift.up (map_one (R.obj.map g).hom).symm)

/-- The map `uliftUnitHomToConst M φ` sends `n` to `n` times the image under `φ` of the
generator. -/
lemma uliftUnitHomToConst_app_apply (M : SheafOfModules.{max u v w} R)
    (φ : Stacks.SheafOfModules.uliftUnit.{max u v} R ⟶ M) (X : Cᵒᵖ) (n : ULift ℤ) :
    (uliftUnitHomToConst M φ).app X n = n.down • φ.val.app X (ULift.up (1 : R.obj.obj X)) :=
  rfl

/-- The global section of `M` named by a map of abelian presheaves out of the constant presheaf
`ℤ`: the image of `1`. -/
def sectionOfConstHom (M : SheafOfModules.{max u v w} R)
    (g : constantZPresheaf.{w, v, u} (C := C) ⟶ M.val.presheaf) : M.val.sections :=
  PresheafOfModules.sectionsMk (fun X => g.app X (ULift.up 1)) (fun {_ _} f =>
    (NatTrans.naturality_apply g f (ULift.up 1)).symm)

/-- **A morphism out of the lifted structure sheaf is a map of abelian presheaves out of the
constant presheaf `ℤ`.** Both are the global sections of the target: the first by
`Stacks.SheafOfModules.uliftUnitHom`, the second because a map out of `ℤ` is determined by the
image of `1`. -/
def uliftUnitHomAddEquiv (M : SheafOfModules.{max u v w} R) :
    (Stacks.SheafOfModules.uliftUnit.{max u v} R ⟶ M) ≃+
      (constantZPresheaf.{w, v, u} (C := C) ⟶ M.val.presheaf) where
  toFun := uliftUnitHomToConst M
  invFun g := Stacks.SheafOfModules.uliftUnitHom (sectionOfConstHom M g)
  left_inv φ := by
    refine Stacks.SheafOfModules.uliftUnit_hom_ext fun X => ?_
    change (1 : R.obj.obj X) • ((1 : ℤ) • φ.val.app X (ULift.up (1 : R.obj.obj X))) =
      φ.val.app X (ULift.up (1 : R.obj.obj X))
    rw [one_smul, one_zsmul]
  right_inv g := by
    ext X (n : ULift ℤ)
    change n.down • ((1 : R.obj.obj X) • (show M.val.obj X from g.app X (ULift.up 1))) =
      g.app X n
    rw [one_smul]
    change n.down • g.app X (ULift.up 1) = g.app X n
    rw [← map_zsmul]
    congr 1
    exact ULift.ext (by simp)
  map_add' φ ψ := by
    ext X (n : ULift ℤ)
    rw [uliftUnitHomToConst_app_apply]
    change n.down • (φ.val.app X (ULift.up (1 : R.obj.obj X)) +
        ψ.val.app X (ULift.up (1 : R.obj.obj X))) =
      n.down • φ.val.app X (ULift.up (1 : R.obj.obj X)) +
        n.down • ψ.val.app X (ULift.up (1 : R.obj.obj X))
    rw [smul_add]

variable (J R)

/-- **Stacks 03FD in degree zero, without a terminal object.** Morphisms out of the lifted
structure sheaf and morphisms out of the constant sheaf `ℤ` into the underlying abelian sheaf are
the same functor of the sheaf of `R`-modules. The first is the maps of abelian presheaves out of
the constant presheaf `ℤ` by `uliftUnitHomAddEquiv`, and those are the maps out of its
sheafification by the sheafification adjunction. -/
def uliftUnitCoyonedaIso :
    preadditiveCoyoneda.obj (op (Stacks.SheafOfModules.uliftUnit.{max u v} R)) ≅
      SheafOfModules.toSheaf.{max u v w} R ⋙
        preadditiveCoyoneda.obj (op (constantZ.{w} J)) :=
  have : (presheafToSheaf J AddCommGrpCat.{max u v w}).Additive :=
    (sheafificationAdjunction J AddCommGrpCat.{max u v w}).left_adjoint_additive
  NatIso.ofComponents (G := (SheafOfModules.toSheaf.{max u v w} R ⋙
        sheafToPresheaf J AddCommGrpCat.{max u v w}) ⋙
      preadditiveCoyoneda.obj (op (constantZPresheaf.{w, v, u} (C := C))))
      (fun M => (uliftUnitHomAddEquiv M).toAddCommGrpIso)
      (fun {M N} f => by
        refine AddCommGrpCat.hom_ext (AddMonoidHom.ext fun φ => ?_)
        refine NatTrans.ext (funext fun X => ?_)
        ext (n : ULift ℤ)
        change n.down • f.val.app X (φ.val.app X (ULift.up (1 : R.obj.obj X))) =
          f.val.app X (n.down • φ.val.app X (ULift.up (1 : R.obj.obj X)))
        rw [map_zsmul]) ≪≫
    Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft (SheafOfModules.toSheaf.{max u v w} R)
      (Stacks.Cohomology.ObjectSections.coyonedaAdjunctionIso
        (sheafificationAdjunction J AddCommGrpCat.{max u v w})
        (constantZPresheaf.{w, v, u} (C := C)))

/-- **Stacks 03FD, global cohomology, without a terminal object and at independent ring and module
universes.** For every degree `n`, `Ext^n(uliftUnit R, M)` is the cohomology `H^n(C, M_ab)` of
the underlying abelian sheaf, naturally in the sheaf of `R`-modules `M`.

Both sides are `δ`-functors on sheaves of `R`-modules — the second because forgetting to abelian
sheaves is exact — they agree in degree zero by `uliftUnitCoyonedaIso`, and both are universal:
the second because the underlying abelian sheaf of an injective sheaf of modules has no higher
`Ext` out of the sectionwise torsion-free sheaf `ℤ`. -/
@[sga "7 IX 9.4.3" "(a), special case"]
def extULiftUnitIso (n : ℕ) :
    extFunctorObj (Stacks.SheafOfModules.uliftUnit.{max u v} R) n ≅
      SheafOfModules.toSheaf.{max u v w} R ⋙
        Sheaf.functorH.{max u v w} J n :=
  ModuleSheafCohomology.extComparisonIso (SheafOfModules.toSheaf R) (constantZ.{w} J)
    (Stacks.SheafOfModules.uliftUnit.{max u v} R)
    (fun I _ m e => Stacks.SheafOfModules.ext_eq_zero_of_isTorsionFree.{max u v w,
      max u v, w, v, u} J R I _ (constantZ_isTorsionFree.{w} J) m e)
    (uliftUnitCoyonedaIso J R) n

/-- **`Ext^n` out of the lifted structure sheaf vanishes exactly when the cohomology of the
underlying abelian sheaf does**, by `extULiftUnitIso`. -/
theorem isZero_ext_uliftUnit_iff (M : SheafOfModules.{max u v w} R) (n : ℕ) :
    IsZero ((extFunctorObj (Stacks.SheafOfModules.uliftUnit.{max u v} R) n).obj M) ↔
      IsZero ((Sheaf.functorH.{max u v w} J n).obj
        ((SheafOfModules.toSheaf.{max u v w} R).obj M)) :=
  ((extULiftUnitIso J R n).app M).isZero_iff

/-- **`Ext^n` out of the lifted structure sheaf vanishes, in any universe of `Ext`-groups, when
the cohomology of the underlying abelian sheaf does.** This is `isZero_ext_uliftUnit_iff` moved
along `CategoryTheory.Abelian.Ext.chgUniv`, which identifies the `Ext`-groups formed in two
universes. -/
theorem isZero_ext_uliftUnit_of_isZero_functorH [HasExt.{t} (SheafOfModules.{max u v w} R)]
    (M : SheafOfModules.{max u v w} R) (n : ℕ)
    (h : IsZero ((Sheaf.functorH.{max u v w} J n).obj
      ((SheafOfModules.toSheaf.{max u v w} R).obj M))) :
    IsZero ((extFunctorObj.{t} (Stacks.SheafOfModules.uliftUnit.{max u v} R) n).obj M) := by
  have : Subsingleton (Ext.{max u v w} (Stacks.SheafOfModules.uliftUnit.{max u v} R) M n) :=
    AddCommGrpCat.subsingleton_of_isZero ((isZero_ext_uliftUnit_iff J R M n).2 h)
  have : Subsingleton (Ext.{t} (Stacks.SheafOfModules.uliftUnit.{max u v} R) M n) :=
    Ext.chgUniv.{max u v w, t}.subsingleton
  exact @AddCommGrpCat.isZero_of_subsingleton _ this

end Stacks.Cohomology.ULiftUnitComparison

end
