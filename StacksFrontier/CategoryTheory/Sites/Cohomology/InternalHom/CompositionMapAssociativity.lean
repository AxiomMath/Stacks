module

public import StacksFrontier.CategoryTheory.Sites.Cohomology.InternalHom.CompositionAssociativity

/-!
# The composition morphism of internal Hom complexes is associative and unital

Let `(C, O)` be a ringed site and let `K`, `L`, `M`, `N` be complexes of `O`-modules. The
composition morphism of Stacks 0A91,

`Tot(SheafHom(L, M) ⊗_O SheafHom(K, L)) ⟶ SheafHom(K, M)`,

is characterised by its value on the homogeneous local pure tensors
(`AlgebraicGeometry.RingedSite.compositionMap_tensorTotalSection`). This file records that it is
associative and that the identity section is a two-sided unit for it, on those pure tensors —
which is the form in which the morphism is computed with, since the pure tensors are what
generate the total tensor complex.

## Main results

* `AlgebraicGeometry.RingedSite.compositionMap_assoc`: **the composition morphism is
  associative.** Composing three homogeneous local sections, bracketed either way, gives the same
  section of `SheafHom(K, N)`.
* `AlgebraicGeometry.RingedSite.compositionMap_idSection_left` and
  `AlgebraicGeometry.RingedSite.compositionMap_idSection_right`: **the identity section is a
  two-sided unit** for the composition morphism.

## Implementation notes

**The statements are `HEq`, and this is forced by the morphism rather than chosen.** The total
degree of a value of `AlgebraicGeometry.RingedSite.compositionMap` is not a parameter: the
degree-`n` component is applied to a pure tensor of degrees `p` and `q` with `n = p + q`
determined by them. So a triple composite bracketed to the left lands in degree `(i + j) + k`
and bracketed to the right in degree `i + (j + k)`, and these are not the same integer
expression. The underlying pairing on sections does take the total degree as a parameter, which
is why `AlgebraicGeometry.RingedSite.compositionSection_assoc` is an honest equality; the
transport reappears here, exactly once, and is absorbed by
`compositionSection_heq_degree`. The same remark applies to the unit laws, whose degrees are
`0 + q` and `p + 0`.

**What an associator-level statement would need beyond this, and why it is not here.** Phrasing
associativity as an equality of two morphisms out of a triple total tensor complex requires an
associator for `AlgebraicGeometry.RingedSite.tensorTotal`, and that is a separate construction:
`tensorTotal` sheafifies the total complex of a double complex of presheaf tensor products, so a
nested `tensorTotal X (tensorTotal X A B) C` is not the sheafification of a triple presheaf
tensor product and the comparison has to be supplied — through
`AlgebraicGeometry.RingedSite.tensorTotalIsoTensorComplex` to the degreewise sheaf tensor, where
Mathlib's `HomologicalComplex.Monoidal` associator lives, together with the
`HomologicalComplex.HasGoodTrifunctor₁₂Obj` and `HasGoodTrifunctor₂₃Obj` instances, which are not
available globally here. Moreover reducing such a statement to local sections does not follow
from `AlgebraicGeometry.RingedSite.tensorTotal_hom_ext` alone: its inner quantifier ranges over
arbitrary sections of the inner factor, and for a nested total complex those are generated by
pure tensors only locally, so a currying step
(`AlgebraicGeometry.RingedSite.sheafHomTensorCurryIso`) is needed to turn the inner variable back
into a morphism out of a total complex. The statements below are what any such formulation
reduces to at its leaves.

## References

* [Stacks Project, Tag 0A8Z](https://stacks.math.columbia.edu/tag/0A8Z)
* [Stacks Project, Tag 0A91](https://stacks.math.columbia.edu/tag/0A91)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite CochainComplex.HomComplex

universe u

namespace AlgebraicGeometry.RingedSite

variable (X : RingedSite.{u, u, u})

attribute [local instance] ringSheafSectionsCommRing presheafOfModulesMonoidalCategory
  curriedTensorPreservesZeroMorphisms curriedTensorObjPreservesZeroMorphisms

section

variable
  {K L M N : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ}

/-- Composition of local sections at two equal, but differently spelt, total degrees. The two
values agree up to `HEq`; this is the one transport that the composition morphism forces and
that the pairing on sections does not. -/
theorem compositionSection_heq_degree (U : X.C) (p q n n' : ℤ) (hn : p + q = n)
    (hn' : p + q = n')
    (β : ((sheafHomComplex X L M).obj.X p).val.obj (op U))
    (γ : ((sheafHomComplex X K L).obj.X q).val.obj (op U)) :
    HEq (compositionSection X U p q n hn β γ) (compositionSection X U p q n' hn' β γ) := by
  obtain rfl : n = n' := by omega
  rfl

/-- **The composition morphism of internal Hom complexes is associative.** For homogeneous local
sections `x` of `SheafHom(M, N)`, `y` of `SheafHom(L, M)` and `z` of `SheafHom(K, L)` over the
same object, composing `x` with `y` first or `y` with `z` first gives the same section of
`SheafHom(K, N)`, up to the degree transport between `(i + j) + k` and `i + (j + k)`. -/
theorem compositionMap_assoc (U : X.C) (i j k : ℤ)
    (x : ((sheafHomComplex X M N).obj.X i).val.obj (op U))
    (y : ((sheafHomComplex X L M).obj.X j).val.obj (op U))
    (z : ((sheafHomComplex X K L).obj.X k).val.obj (op U)) :
    HEq
      (((compositionMap X K L N).f (i + j + k)).val.app (op U)
        (tensorTotalSection X (sheafHomComplex X L N).obj (sheafHomComplex X K L).obj U (i + j) k
          (((compositionMap X L M N).f (i + j)).val.app (op U)
            (tensorTotalSection X (sheafHomComplex X M N).obj (sheafHomComplex X L M).obj U i j
              x y)) z))
      (((compositionMap X K M N).f (i + (j + k))).val.app (op U)
        (tensorTotalSection X (sheafHomComplex X M N).obj (sheafHomComplex X K M).obj U i (j + k)
          x (((compositionMap X K L M).f (j + k)).val.app (op U)
            (tensorTotalSection X (sheafHomComplex X L M).obj (sheafHomComplex X K L).obj U j k
              y z)))) := by
  rw [compositionMap_tensorTotalSection X L M N U i j x y,
    compositionMap_tensorTotalSection X K L M U j k y z,
    compositionMap_tensorTotalSection X K L N U (i + j) k _ z,
    compositionMap_tensorTotalSection X K M N U i (j + k) x _,
    compositionSection_assoc X U i j k (i + j) (j + k) (i + j + k) rfl rfl rfl (by omega) x y z]
  exact compositionSection_heq_degree X U i (j + k) (i + j + k) (i + (j + k)) (by omega) rfl x _

/-- **The identity section is a left unit for the composition morphism.** -/
theorem compositionMap_idSection_left (U : X.C) (q : ℤ)
    (γ : ((sheafHomComplex X K M).obj.X q).val.obj (op U)) :
    HEq
      (((compositionMap X K M M).f (0 + q)).val.app (op U)
        (tensorTotalSection X (sheafHomComplex X M M).obj (sheafHomComplex X K M).obj U 0 q
          (idSection X M U) γ)) γ :=
  (compositionMap_tensorTotalSection X K M M U 0 q (idSection X M U) γ ▸
      compositionSection_heq_degree X U 0 q (0 + q) q rfl (zero_add q) (idSection X M U) γ).trans
    (heq_of_eq (compositionSection_idSection_left X U q γ))

/-- **The identity section is a right unit for the composition morphism.** -/
theorem compositionMap_idSection_right (U : X.C) (p : ℤ)
    (β : ((sheafHomComplex X K M).obj.X p).val.obj (op U)) :
    HEq
      (((compositionMap X K K M).f (p + 0)).val.app (op U)
        (tensorTotalSection X (sheafHomComplex X K M).obj (sheafHomComplex X K K).obj U p 0
          β (idSection X K U))) β :=
  (compositionMap_tensorTotalSection X K K M U p 0 β (idSection X K U) ▸
      compositionSection_heq_degree X U p 0 (p + 0) p rfl (add_zero p) β (idSection X K U)).trans
    (heq_of_eq (compositionSection_idSection_right X U p β))

end

end AlgebraicGeometry.RingedSite

end
