namespace Stacks.CechSite

-- The degree-`n` term of the Čech complex and the product `∏ᶜ cochainFactor E F n` of its
-- factors are the same object, but only after the construction of the complex out of the
-- simplicial formal coproduct is unfolded; the definitions below have to be reducible at
-- implicit transparency for the rewriting steps that pass between the two spellings to
-- typecheck.
attribute [local implicit_reducible] FormalCoproduct.evalOp
  FormalCoproduct.cosimplicialObjectFunctor FormalCoproduct.cochainComplexFunctor
  AlgebraicTopology.alternatingCofaceMapComplex
  AlgebraicTopology.AlternatingCofaceMapComplex.obj cechFormalCoproduct

private noncomputable def rangeSheafifySubgroup
    {C : Type u} [Category.{v} C] {F G : Cᵒᵖ ⥤ AddCommGrpCat.{b}}
    (J : GrothendieckTopology C) (f : F ⟶ G) (X : Cᵒᵖ) : AddSubgroup (G.obj X) := by
  let R := Subfunctor.range (Functor.whiskerRight f (forget (AddCommGrpCat.{b})))
  refine
    { carrier := (R.sheafify J).obj X
      zero_mem' := R.le_sheafify J _ ⟨0, by change f.app X 0 = 0; simp⟩
      add_mem' := ?_
      neg_mem' := ?_ }
  · intro x y hx hy
    change R.sieveOfSection x ∈ J X.unop at hx
    change R.sieveOfSection y ∈ J X.unop at hy
    apply J.superset_covering ?_ (J.intersection_covering hx hy)
    intro Y g hg
    change R.sieveOfSection x g ∧ R.sieveOfSection y g at hg
    rcases hg with ⟨h₁, h₂⟩
    change G.map g.op x ∈ Set.range (f.app _) at h₁
    change G.map g.op y ∈ Set.range (f.app _) at h₂
    rcases h₁ with ⟨x', hx'⟩
    rcases h₂ with ⟨y', hy'⟩
    refine ⟨x' + y', ?_⟩
    change (ConcreteCategory.hom (f.app (op Y))) (x' + y') =
      (ConcreteCategory.hom (G.map g.op)) (x + y)
    rw [map_add, hx', hy', map_add]
  · intro x hx
    change R.sieveOfSection x ∈ J X.unop at hx
    apply J.superset_covering ?_ hx
    intro Y g hg
    change G.map g.op x ∈ Set.range (f.app _) at hg
    rcases hg with ⟨x', hx'⟩
    refine ⟨-x', ?_⟩
    change (ConcreteCategory.hom (f.app (op Y))) (-x') =
      (ConcreteCategory.hom (G.map g.op)) (-x)
    rw [map_neg, hx', map_neg]

private noncomputable def rangeSheafifyPresheaf
    {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
    {F G : Cᵒᵖ ⥤ AddCommGrpCat.{b}} (η : F ⟶ G) : Cᵒᵖ ⥤ AddCommGrpCat.{b} where
  obj X := AddCommGrpCat.of (rangeSheafifySubgroup J η X)
  map {X Y} i := AddCommGrpCat.ofHom
    { toFun := fun x => ⟨G.map i x.1,
        (Subfunctor.range
          (Functor.whiskerRight η (forget (AddCommGrpCat.{b})))).sheafify J |>.map i x.2⟩
      map_zero' := by ext; simp
      map_add' := by intro x y; ext; simp }
  map_id := by
    intro X
    ext x
    simp
  map_comp := by
    intro X Y Z f g
    ext x
    simp [Functor.map_comp]

private lemma epi_isLocallySurjective_of_hasSheafify
    {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
    [HasSheafify J (AddCommGrpCat.{b})]
    (F G : Sheaf J (AddCommGrpCat.{b})) (f : F ⟶ G) [Epi f] :
    Presheaf.IsLocallySurjective J
      ((sheafToPresheaf J (AddCommGrpCat.{b})).map f) := by
  classical
  let P := sheafToPresheaf J (AddCommGrpCat.{b})
  let η := P.map f
  let R := Subfunctor.range (Functor.whiskerRight η (forget (AddCommGrpCat.{b})))
  let I₀ := rangeSheafifyPresheaf J η
  let m₀ : I₀ ⟶ G.obj := {
    app X := AddCommGrpCat.ofHom (rangeSheafifySubgroup J η X).subtype
    naturality := by
      intro X Y i
      ext x
      rfl }
  have hI : Presheaf.IsSheaf J I₀ := by
    intro A X S hS x hx
    let θ := Functor.whiskerRight m₀ (coyoneda.obj (op A))
    let xG := x.map θ
    obtain ⟨q, hq, hqUnique⟩ := G.property A S hS xG (hx.map θ)
    have hqval (Y : C) (i : Y ⟶ X) (hi : S.arrows i) (a : A) :
        (G.obj.map i.op) ((ConcreteCategory.hom q) a) =
          ((ConcreteCategory.hom (x i hi)) a).val := by
      have h := congrArg (fun φ : A ⟶ G.obj.obj (op Y) => (ConcreteCategory.hom φ) a) (hq i hi)
      dsimp [xG, θ] at h
      change (G.obj.map i.op) ((ConcreteCategory.hom q) a) =
        ((ConcreteCategory.hom (x i hi)) a).val at h
      exact h
    have hmem (a : A) : (ConcreteCategory.hom q) a ∈
        (Subfunctor.sheafify J R).obj (op X) := by
      change R.sieveOfSection ((ConcreteCategory.hom q) a) ∈ J X
      let T : Sieve X := Sieve.bind S.arrows fun Y i hi =>
        R.sieveOfSection ((ConcreteCategory.hom (x i hi)) a).val
      have hT : T ∈ J X :=
        J.bind_covering hS fun Y i hi => ((ConcreteCategory.hom (x i hi)) a).property
      apply J.superset_covering ?_ hT
      intro Z k hk
      rcases hk with ⟨Y, g, i, hi, hg, hki⟩
      change R.sieveOfSection ((ConcreteCategory.hom (x i hi)) a).val g at hg
      change ∃ z, (ConcreteCategory.hom (η.app (op Z))) z =
        (ConcreteCategory.hom (G.obj.map k.op)) ((ConcreteCategory.hom q) a)
      rcases hg with ⟨z, hz⟩
      refine ⟨z, ?_⟩
      rw [← hki]
      calc
        (ConcreteCategory.hom (η.app (op Z))) z =
            (ConcreteCategory.hom (G.obj.map g.op))
              ((ConcreteCategory.hom (x i hi)) a).val := hz
        _ = (ConcreteCategory.hom (G.obj.map g.op))
              ((ConcreteCategory.hom (G.obj.map i.op)) ((ConcreteCategory.hom q) a)) := by
            rw [hqval Y i hi a]
        _ = (ConcreteCategory.hom (G.obj.map (i.op ≫ g.op)))
              ((ConcreteCategory.hom q) a) := by
            rw [← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply,
              ← G.obj.map_comp]
            simp only [ConcreteCategory.comp_apply]
        _ = (ConcreteCategory.hom (G.obj.map (g ≫ i).op))
              ((ConcreteCategory.hom q) a) := by rw [← op_comp]
    let qI : A ⟶ I₀.obj (op X) := AddCommGrpCat.ofHom {
      toFun := fun a => ⟨(ConcreteCategory.hom q) a, hmem a⟩
      map_zero' := Subtype.ext (map_zero (ConcreteCategory.hom q))
      map_add' a a' := Subtype.ext (map_add (ConcreteCategory.hom q) a a') }
    have hqI : (x : Presieve.FamilyOfElements
        (I₀ ⋙ coyoneda.obj (op A)) S.arrows).IsAmalgamation qI := by
      intro Y i hi
      change qI ≫ I₀.map i.op = x i hi
      exact AddCommGrpCat.hom_ext (AddMonoidHom.ext fun a => Subtype.ext (hqval Y i hi a))
    refine ⟨qI, hqI, fun t ht => AddCommGrpCat.hom_ext (AddMonoidHom.ext fun a => ?_)⟩
    apply Subtype.ext
    have hCandidate : xG.IsAmalgamation (t ≫ m₀.app (op X)) := by
      intro Y i hi
      change (t ≫ m₀.app (op X)) ≫ G.obj.map i.op =
        (x i hi) ≫ m₀.app (op Y)
      have hti : t ≫ I₀.map i.op = x i hi := ht i hi
      rw [Category.assoc, ← m₀.naturality i.op, ← Category.assoc, hti]
    exact congrArg (fun φ : A ⟶ G.obj.obj (op X) => (ConcreteCategory.hom φ) a)
      (hqUnique _ hCandidate)
  let I : Sheaf J (AddCommGrpCat.{b}) := ⟨I₀, hI⟩
  let m : I ⟶ G := ⟨m₀⟩
  let l : F ⟶ I := ⟨{
    app := fun X => AddCommGrpCat.ofHom {
      toFun := fun x => ⟨η.app X x, R.le_sheafify J X ⟨x, rfl⟩⟩
      map_zero' := by apply Subtype.ext; simp
      map_add' := by intro x y; apply Subtype.ext; simp }
    naturality := by
      intro X Y i
      ext x
      apply Subtype.ext
      change (ConcreteCategory.hom (η.app Y)) (F.obj.map i x) =
        (ConcreteCategory.hom ((P.obj G).map i)) ((ConcreteCategory.hom (η.app X)) x)
      exact NatTrans.naturality_apply η i x
  }⟩
  have hfac : l ≫ m = f := by
    ext X x
    rfl
  have : Mono m := by
    apply Functor.ReflectsMonomorphisms.reflects (F := P) m
    rw [NatTrans.mono_iff_mono_app]
    exact fun X => (AddCommGrpCat.mono_iff_injective _).2 fun x y hxy => Subtype.ext hxy
  have : Epi m := epi_of_epi_fac hfac
  have : IsIso m := isIso_of_mono_of_epi m
  have htop : R.sheafify J = ⊤ := by
    ext X s
    refine ⟨fun _ => trivial, fun _ => ?_⟩
    let x := (inv m).hom.app X s
    have hx : (m.hom.app X) x = s := by
      change (m.hom.app X) (((inv m).hom.app X) s) = s
      simp [m]
    exact hx ▸ x.property
  exact (Presheaf.isLocallySurjective_iff_range_sheafify_eq_top J η).2 htop

private lemma exists_cover_refining_imageSieve
    {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
    [HasSheafify J (AddCommGrpCat.{max a w})]
    (S : ShortComplex (Sheaf J (AddCommGrpCat.{max a w}))) (hS : S.ShortExact)
    (U : C) (Cov : Set (PreZeroHypercover.{w} U))
    (hcofinal : ∀ R ∈ J U, ∃ E : PreZeroHypercover.{w} U,
      E ∈ Cov ∧ E.sieve₀ ≤ R)
    (s : (((sheafToPresheaf J (AddCommGrpCat.{max a w})).obj S.X₃).obj (op U))) :
    ∃ E : PreZeroHypercover.{w} U, E ∈ Cov ∧
      E.sieve₀ ≤ Presheaf.imageSieve
        ((sheafToPresheaf J (AddCommGrpCat.{max a w})).map S.g) s ∧
      ∀ i : E.I₀,
        ∃ x : (((sheafToPresheaf J (AddCommGrpCat.{max a w})).obj S.X₂).obj (op (E.X i))),
          ((sheafToPresheaf J (AddCommGrpCat.{max a w})).map S.g).app (op (E.X i)) x =
            ((sheafToPresheaf J (AddCommGrpCat.{max a w})).obj S.X₃).map (E.f i).op s := by
  let b := (sheafToPresheaf J (AddCommGrpCat.{max a w})).map S.g
  have : Epi S.g := hS.epi_g
  obtain ⟨E, hE, hER⟩ := hcofinal _
    ((epi_isLocallySurjective_of_hasSheafify J S.X₂ S.X₃ S.g).imageSieve_mem s)
  exact ⟨E, hE, hER, fun i =>
    ⟨_, Presheaf.app_localPreimage b s (E.f i) (hER (E.f i) (E.sieve₀_f i))⟩⟩

/-- Evaluating a short exact sequence of sheaves at `V` leaves `f` a kernel of `g`. -/
private noncomputable def sectionwise_isLimit
    {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
    [HasSheafify J (AddCommGrpCat.{b})]
    (S : ShortComplex (Sheaf J (AddCommGrpCat.{b}))) (hS : S.ShortExact) (V : C) :
    IsLimit (KernelFork.ofι
      (S.map (sheafToPresheaf J (AddCommGrpCat.{b}) ⋙
        (evaluation Cᵒᵖ (AddCommGrpCat.{b})).obj (op V))).f
      (S.map (sheafToPresheaf J (AddCommGrpCat.{b}) ⋙
        (evaluation Cᵒᵖ (AddCommGrpCat.{b})).obj (op V))).zero) :=
  KernelFork.mapIsLimit _ hS.fIsKernel (sheafToPresheaf J (AddCommGrpCat.{b}) ⋙
    (evaluation Cᵒᵖ (AddCommGrpCat.{b})).obj (op V))

private lemma sectionwise_kernel
    {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
    [HasSheafify J (AddCommGrpCat.{b})]
    (S : ShortComplex (Sheaf J (AddCommGrpCat.{b}))) (hS : S.ShortExact)
    (V : C) (x : (((sheafToPresheaf J (AddCommGrpCat.{b})).obj S.X₂).obj (op V)))
    (hx : ((sheafToPresheaf J (AddCommGrpCat.{b})).map S.g).app (op V) x = 0) :
    ∃ y : (((sheafToPresheaf J (AddCommGrpCat.{b})).obj S.X₁).obj (op V)),
      ((sheafToPresheaf J (AddCommGrpCat.{b})).map S.f).app (op V) y = x :=
  ((ShortComplex.ab_exact_iff _).1 (ShortComplex.exact_of_f_is_kernel _
    (sectionwise_isLimit J S hS V))) x hx

private lemma sectionwise_injective
    {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
    [HasSheafify J (AddCommGrpCat.{b})]
    (S : ShortComplex (Sheaf J (AddCommGrpCat.{b}))) (hS : S.ShortExact)
    (V : C) :
    Function.Injective (((sheafToPresheaf J (AddCommGrpCat.{b})).map S.f).app (op V)) :=
  (AddCommGrpCat.mono_iff_injective _).1 (Fork.IsLimit.mono (sectionwise_isLimit J S hS V))

/-- Projecting a map of products to a factor. Stated as its own lemma so that the two
occurrences of the target family share one `HasProduct` instance, which is what lets `rw`
apply `Limits.Pi.map_π`; at the use site below the two spellings of that family are only
definitionally equal. -/
private lemma pi_π_map_apply {ι : Type w} (P Q : ι → AddCommGrpCat.{b})
    [HasProduct P] [HasProduct Q] (p : ∀ i, P i ⟶ Q i) (i : ι)
    (x : (∏ᶜ P : AddCommGrpCat.{b})) :
    Pi.π Q i (Limits.Pi.map p x) = p i (Pi.π P i x) := by
  rw [← ConcreteCategory.comp_apply, Pi.map_π, ConcreteCategory.comp_apply]

private lemma productAddEquiv_cech_apply {C : Type u} [Category.{v} C]
    {U : C} (E : PreZeroHypercover.{w} U)
    [HasProducts.{w} AddCommGrpCat.{b}]
    [∀ (n : ℕ) (i : Fin (n + 1) → E.I₀),
      HasProduct (fun a ↦ Over.mk (E.f (i a)))]
    (F : Cᵒᵖ ⥤ AddCommGrpCat.{b}) (n : ℕ) (x : (cechComplex E F).X n)
    (k : Fin (n + 1) → E.I₀) :
    productAddEquiv (cochainFactor E F n) x k =
      Pi.π (cochainFactor E F n) k x :=
  rfl

private noncomputable def cochainOfFamily {C : Type u} [Category.{v} C]
    {U : C} (E : PreZeroHypercover.{w} U)
    [HasProducts.{w} AddCommGrpCat.{b}]
    [∀ (n : ℕ) (i : Fin (n + 1) → E.I₀),
      HasProduct (fun a ↦ Over.mk (E.f (i a)))]
    (F : Cᵒᵖ ⥤ AddCommGrpCat.{b}) (n : ℕ)
    (s : ∀ k : Fin (n + 1) → E.I₀, cochainFactor E F n k) :
    (cechComplex E F).X n :=
  (productAddEquiv (cochainFactor E F n)).symm s

private lemma cochainOfFamily_π {C : Type u} [Category.{v} C]
    {U : C} (E : PreZeroHypercover.{w} U)
    [HasProducts.{w} AddCommGrpCat.{b}]
    [∀ (n : ℕ) (i : Fin (n + 1) → E.I₀),
      HasProduct (fun a ↦ Over.mk (E.f (i a)))]
    (F : Cᵒᵖ ⥤ AddCommGrpCat.{b}) (n : ℕ)
    (s : ∀ k : Fin (n + 1) → E.I₀, cochainFactor E F n k)
    (k : Fin (n + 1) → E.I₀) :
    Pi.π (cochainFactor E F n) k (cochainOfFamily E F n s) = s k :=
  congrFun ((productAddEquiv (cochainFactor E F n)).apply_symm_apply s) k

private lemma cochainMap_cochainOfFamily_π {C : Type u} [Category.{v} C]
    {U : C} (E : PreZeroHypercover.{w} U)
    [HasProducts.{w} AddCommGrpCat.{b}]
    [∀ (n : ℕ) (i : Fin (n + 1) → E.I₀),
      HasProduct (fun a ↦ Over.mk (E.f (i a)))]
    (F G : Cᵒᵖ ⥤ AddCommGrpCat.{b}) (η : F ⟶ G) (n : ℕ)
    (s : ∀ k : Fin (n + 1) → E.I₀, cochainFactor E F n k)
    (k : Fin (n + 1) → E.I₀) :
    Pi.π (cochainFactor E G n) k
      (((cechComplexFunctor E).map η).f n (cochainOfFamily E F n s)) =
        η.app (op (((cechSimplicialObject E).obj
          (op (SimplexCategory.mk n))).obj k).left) (s k) := by
  have h := pi_π_map_apply (cochainFactor E F n) (cochainFactor E G n)
    (fun i ↦ η.app (op (((cechSimplicialObject E).obj
      (op (SimplexCategory.mk n))).obj i).left)) k (cochainOfFamily E F n s)
  rwa [cochainOfFamily_π] at h

private lemma cochainMap_injective_of_pointwise_injective {C : Type u}
    [Category.{v} C] {U : C} (E : PreZeroHypercover.{w} U)
    [HasProducts.{w} AddCommGrpCat.{b}]
    [∀ (n : ℕ) (i : Fin (n + 1) → E.I₀),
      HasProduct (fun a ↦ Over.mk (E.f (i a)))]
    (F G : Cᵒᵖ ⥤ AddCommGrpCat.{b}) (η : F ⟶ G) (n : ℕ)
    (hinj : ∀ k : Fin (n + 1) → E.I₀,
      Function.Injective (η.app (op (((cechSimplicialObject E).obj
        (op (SimplexCategory.mk n))).obj k).left))) :
    Function.Injective (((cechComplexFunctor E).map η).f n) := by
  intro x y hxy
  have hsrc : productAddEquiv (cochainFactor E F n) x =
      productAddEquiv (cochainFactor E F n) y := by
    ext k
    have h (z : (cechComplex E F).X n) :
        cochainOfFamily E F n (productAddEquiv (cochainFactor E F n) z) = z :=
      (productAddEquiv (cochainFactor E F n)).symm_apply_apply z
    have hk := congrArg (fun z ↦ Pi.π (cochainFactor E G n) k z) hxy
    rw [← h x, ← h y, cochainMap_cochainOfFamily_π, cochainMap_cochainOfFamily_π] at hk
    exact hinj k hk
  exact (productAddEquiv (cochainFactor E F n)).injective hsrc

private lemma cech_cocycle_is_coboundary
    {C : Type u} [Category.{v} C] {U : C} (E : PreZeroHypercover.{w} U)
    [HasProducts.{w} AddCommGrpCat.{b}]
    [∀ (n : ℕ) (i : Fin (n + 1) → E.I₀),
      HasProduct (fun a ↦ Over.mk (E.f (i a)))]
    (F : Cᵒᵖ ⥤ AddCommGrpCat.{b})
    (h : IsZero (cechCohomology E F 1))
    (c : (cechComplex E F).X 1)
    (hc : (cechComplex E F).d 1 2 c = 0) :
    ∃ t : (cechComplex E F).X 0,
      (cechComplex E F).d 0 1 t = c := by
  let K := cechComplex E F
  have hExact : (K.sc' 0 1 2).Exact :=
    (K.exactAt_iff' (i := 0) (j := 1) (k := 2)
      (ComplexShape.prev_eq' _ (ComplexShape.up_mk 0 1 (by simp)))
      (ComplexShape.next_eq' _ (ComplexShape.up_mk 1 2 (by simp)))).1
        ((HomologicalComplex.exactAt_iff_isZero_homology _ _).2 h)
  exact (ShortComplex.ab_exact_iff _).1 hExact c hc




private lemma hom_sub_apply {G H : AddCommGrpCat.{b}} (f g : G ⟶ H) (x : G) :
    (f - g) x = f x - g x := rfl

private lemma cochainDifferentialZero_π {C : Type u} [Category.{v} C]
    {U : C} (E : PreZeroHypercover.{w} U)
    [HasProducts.{w} AddCommGrpCat.{b}]
    [∀ (n : ℕ) (i : Fin (n + 1) → E.I₀),
      HasProduct (fun a ↦ Over.mk (E.f (i a)))]
    (F : Cᵒᵖ ⥤ AddCommGrpCat.{b}) (s : ∀ i : E.I₀, F.obj (op (E.X i)))
    (k : Fin 2 → E.I₀) :
    Pi.π (cochainFactor E F 1) k
      ((cechComplex E F).d 0 1
        (familyToCochain E F s)) =
    F.map (Pi.π (fun j : Fin 2 ↦ Over.mk (E.f (k j))) 1).left.op (s (k 1)) -
      F.map (Pi.π (fun j : Fin 2 ↦ Over.mk (E.f (k j))) 0).left.op (s (k 0)) := by
  simp only [cechComplex, cechComplexFunctor,
    Functor.comp_obj, FormalCoproduct.cochainComplexFunctor_obj_d,
    CochainComplex.of.d, Nat.reduceAdd, ↓reduceDIte, eqToHom_refl,
    AlgebraicTopology.AlternatingCofaceMapComplex.objD,
    Fin.sum_univ_two, Fin.val_zero, Fin.val_one, pow_zero, pow_one, one_zsmul,
    neg_one_zsmul, ← sub_eq_add_neg]
  change Pi.π (cochainFactor E F 1) k
    ((Pi.lift (fun l : Fin 2 → E.I₀ ↦
      Pi.π (cochainFactor E F 0) (l ∘ (0 : Fin 2).succAbove) ≫
        F.map (Pi.lift (fun j : Fin 1 ↦
          Pi.π (fun b : Fin 2 ↦ Over.mk (E.f (l b))) ((0 : Fin 2).succAbove j))).left.op) -
      Pi.lift (fun l : Fin 2 → E.I₀ ↦
      Pi.π (cochainFactor E F 0) (l ∘ (1 : Fin 2).succAbove) ≫
        F.map (Pi.lift (fun j : Fin 1 ↦
          Pi.π (fun b : Fin 2 ↦ Over.mk (E.f (l b))) ((1 : Fin 2).succAbove j))).left.op))
      (familyToCochain E F s)) = _
  simp only [hom_sub_apply, map_sub, ← ConcreteCategory.comp_apply, Pi.lift_π]
  simp only [ConcreteCategory.comp_apply, familyToCochain_π]
  simp only [← Functor.map_comp_apply, ← op_comp, ← Over.comp_left]
  simp only [Function.comp_def, Pi.lift_π]
  rfl

/-- A morphism out of `ℤ` composed with `f` is the morphism determined by the image of `1`. -/
private lemma ofHom_uliftZMultiplesHom_comp {G H : AddCommGrpCat.{b}} (z : G) (f : G ⟶ H) :
    AddCommGrpCat.ofHom (uliftZMultiplesHom G z) ≫ f =
      AddCommGrpCat.ofHom (uliftZMultiplesHom H (f z)) := by
  ext n
  simp [uliftZMultiplesHom, zmultiplesHom, map_zsmul]

/-- **Stacks Project, Tag 03F8.** For a short exact sequence of abelian sheaves, vanishing
of first Čech cohomology of the first sheaf on a cofinal system of coverings makes the last
map surjective on sections. -/
@[stacks 03F8]
public theorem surjective_on_sections_of_isZero_cechCohomology
    {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
    [HasSheafify J (AddCommGrpCat.{max a w})]
    (S : ShortComplex (Sheaf J (AddCommGrpCat.{max a w}))) (hS : S.ShortExact)
    (U : C) (Cov : Set (PreZeroHypercover.{w} U))
    (hCov : ∀ E ∈ Cov, E.sieve₀ ∈ J U)
    (hcofinal : ∀ R ∈ J U, ∃ E : PreZeroHypercover.{w} U,
      E ∈ Cov ∧ E.sieve₀ ≤ R)
    (hproducts : ∀ (E : PreZeroHypercover.{w} U), E ∈ Cov →
      ∀ (n : ℕ) (i : Fin (n + 1) → E.I₀),
        HasProduct (fun a ↦ Over.mk (E.f (i a))))
    (hH1 : ∀ (E : PreZeroHypercover.{w} U) (hE : E ∈ Cov),
      letI := hproducts E hE
      IsZero (cechCohomology E
        ((sheafToPresheaf J (AddCommGrpCat.{max a w})).obj S.X₁) 1)) :
    Function.Surjective
      (((sheafToPresheaf J (AddCommGrpCat.{max a w})).map S.g).app (op U)) :=
  by
    classical
    intro s
    let P := sheafToPresheaf J (AddCommGrpCat.{max a w})
    let P₁ := P.obj S.X₁
    let P₂ := P.obj S.X₂
    let P₃ := P.obj S.X₃
    let ηf := P.map S.f
    let ηg := P.map S.g
    obtain ⟨E, hE, hER, hlocal⟩ :=
      exists_cover_refining_imageSieve J S hS U Cov hcofinal s
    let := hproducts E hE
    let x : ∀ i, P₂.obj (op (E.X i)) := fun i ↦ Classical.choose (hlocal i)
    have hx (i : E.I₀) : ηg.app (op (E.X i)) (x i) =
        P₃.map (E.f i).op s := Classical.choose_spec (hlocal i)
    let pairObj (k : Fin 2 → E.I₀) :=
      (∏ᶜ (fun j : Fin 2 ↦ Over.mk (E.f (k j))) : Over U).left
    let pairProj (k : Fin 2 → E.I₀) (j : Fin 2) : pairObj k ⟶ E.X (k j) :=
      (Pi.π (fun j : Fin 2 ↦ Over.mk (E.f (k j))) j).left
    have hker (k : Fin 2 → E.I₀) :
        ηg.app (op (pairObj k))
          (P₂.map (pairProj k 1).op (x (k 1)) -
            P₂.map (pairProj k 0).op (x (k 0))) = 0 := by
      rw [map_sub, NatTrans.naturality_apply, NatTrans.naturality_apply, hx (k 1), hx (k 0),
        ← Functor.map_comp_apply, ← op_comp, ← Functor.map_comp_apply, ← op_comp]
      have hsame : pairProj k 1 ≫ E.f (k 1) = pairProj k 0 ≫ E.f (k 0) :=
        (Pi.π (fun j : Fin 2 ↦ Over.mk (E.f (k j))) 1).w.trans
          (Pi.π (fun j : Fin 2 ↦ Over.mk (E.f (k j))) 0).w.symm
      rw [hsame]
      simp
    let y : ∀ k : Fin 2 → E.I₀, P₁.obj (op (pairObj k)) := fun k ↦
      Classical.choose (sectionwise_kernel J S hS (pairObj k)
        (P₂.map (pairProj k 1).op (x (k 1)) -
          P₂.map (pairProj k 0).op (x (k 0))) (hker k))
    have hy (k : Fin 2 → E.I₀) :
        ηf.app (op (pairObj k)) (y k) =
          P₂.map (pairProj k 1).op (x (k 1)) -
            P₂.map (pairProj k 0).op (x (k 0)) :=
      Classical.choose_spec (sectionwise_kernel J S hS (pairObj k)
        (P₂.map (pairProj k 1).op (x (k 1)) -
          P₂.map (pairProj k 0).op (x (k 0))) (hker k))
    let c := cochainOfFamily E P₁ 1 y
    have hmap : ((cechComplexFunctor E).map ηf).f 1 c =
        (cechComplex E P₂).d 0 1 (familyToCochain E P₂ x) := by
      apply (productAddEquiv (cochainFactor E P₂ 1)).injective
      funext k
      rw [productAddEquiv_cech_apply, productAddEquiv_cech_apply,
        cochainMap_cochainOfFamily_π, cochainDifferentialZero_π]
      exact hy k
    have hc : (cechComplex E P₁).d 1 2 c = 0 := by
      let K₁ := cechComplex E P₁
      let K₂ := cechComplex E P₂
      have hcommEval :=
        ConcreteCategory.congr_hom (((cechComplexFunctor E).map ηf).comm (1 : ℕ) (2 : ℕ)) c
      have hcomm' : K₂.d 1 2 (((cechComplexFunctor E).map ηf).f 1 c) =
          ((cechComplexFunctor E).map ηf).f 2 (K₁.d 1 2 c) := by
        change _ = _ at hcommEval
        rwa [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply] at hcommEval
      have hz : K₂.d 1 2 (((cechComplexFunctor E).map ηf).f 1 c) = 0 := by
        rw [hmap]
        exact ConcreteCategory.congr_hom (K₂.d_comp_d 0 1 2)
          (familyToCochain E P₂ x) |>.trans (by simp)
      have hinj : Function.Injective (((cechComplexFunctor E).map ηf).f 2) :=
        cochainMap_injective_of_pointwise_injective E P₁ P₂ ηf 2
          (fun k => sectionwise_injective J S hS
            (((cechSimplicialObject E).obj
              (op (SimplexCategory.mk 2))).obj k).left)
      apply hinj
      simpa [hcomm'] using hz
    have hvan := hH1 E hE
    obtain ⟨t, ht⟩ := cech_cocycle_is_coboundary.{w, v, u, max a w} E P₁ hvan c hc
    obtain ⟨τ, htτ⟩ : ∃ r, familyToCochain E P₁ r = t :=
      ⟨cochainToFamily E P₁ t, familyToCochain_cochainToFamily E P₁ t⟩
    have hdt : (cechComplex E P₁).d 0 1
        (familyToCochain E P₁ τ) = c := by
      rw [htτ]
      exact ht
    have hdtpair (k : Fin 2 → E.I₀) :
        P₁.map (pairProj k 1).op (τ (k 1)) -
          P₁.map (pairProj k 0).op (τ (k 0)) = y k := by
      have h := congrArg (fun q => Pi.π (cochainFactor E P₁ 1) k q) hdt
      rwa [cochainDifferentialZero_π, cochainOfFamily_π] at h
    let z : ∀ i, P₂.obj (op (E.X i)) := fun i ↦
      x i - ηf.app (op (E.X i)) (τ i)
    have hcorrected (k : Fin 2 → E.I₀) :
        P₂.map (pairProj k 1).op (z (k 1)) =
          P₂.map (pairProj k 0).op (z (k 0)) := by
      dsimp [z]
      rw [map_sub, map_sub, ← NatTrans.naturality_apply,
        ← NatTrans.naturality_apply]
      have hcorr := congrArg (ηf.app (op (pairObj k))) (hdtpair k)
      rw [map_sub, hy k] at hcorr
      exact sub_eq_sub_iff_add_eq_add.2 <|
        (sub_eq_sub_iff_add_eq_add.1 hcorr).symm.trans (add_comm _ _)
    have hcompat : ∀ ⦃W : C⦄ ⦃i j : E.I₀⦄ (a : W ⟶ E.X i)
        (b : W ⟶ E.X j), a ≫ E.f i = b ≫ E.f j →
        P₂.map a.op (z i) = P₂.map b.op (z j) := by
      intro W i j a b hab
      let k : Fin 2 → E.I₀ := fun m ↦ if m = 0 then i else j
      have hk0 : k 0 = i := by simp [k]
      have hk1 : k 1 = j := by simp [k]
      let G : Fin 2 → Over U := fun m ↦ Over.mk (E.f (k m))
      let A : Over.mk (a ≫ E.f i) ⟶ G 0 := Over.homMk a (by simp [G, k])
      let B : Over.mk (a ≫ E.f i) ⟶ G 1 :=
        Over.homMk b (by simpa [G, k] using hab.symm)
      let v : Over.mk (a ≫ E.f i) ⟶ (∏ᶜ G : Over U) :=
        Pi.lift (fun m ↦ Fin.cases A (fun _ ↦ B) m)
      have hv0 : v.left ≫ pairProj k 0 = a := by
        change (v ≫ Pi.π G 0).left = a
        rw [Pi.lift_π]
        rfl
      have hv1 : v.left ≫ pairProj k 1 = b := by
        change (v ≫ Pi.π G 1).left = b
        rw [Pi.lift_π]
        rfl
      have hpull := congrArg (fun q ↦ P₂.map v.left.op q) (hcorrected k)
      rw [← Functor.map_comp_apply, ← op_comp, hv1, ← Functor.map_comp_apply, ← op_comp,
        hv0] at hpull
      simpa [k] using hpull.symm
    let M : ∀ i, AddCommGrpCat.of (ULift ℤ) ⟶ P₂.obj (op (E.X i)) := fun i ↦
      AddCommGrpCat.ofHom (uliftZMultiplesHom _ (z i))
    have hM : ∀ ⦃W : C⦄ ⦃i j : E.I₀⦄ (a : W ⟶ E.X i)
        (b : W ⟶ E.X j), a ≫ E.f i = b ≫ E.f j →
        M i ≫ P₂.map a.op = M j ≫ P₂.map b.op := by
      intro W i j a b hab
      simp only [M, ofHom_uliftZMultiplesHom_comp, hcompat a b hab]
    let L := S.X₂.property.amalgamateOfArrows E.f (hCov E hE) M hM
    let u : P₂.obj (op U) := ConcreteCategory.hom L (ULift.up (1 : ℤ))
    have hL (i : E.I₀) : L ≫ P₂.map (E.f i).op = M i :=
      Presheaf.IsSheaf.amalgamateOfArrows_map S.X₂.property E.f (hCov E hE) M hM i
    have hu (i : E.I₀) : P₂.map (E.f i).op u = z i := by
      have h := ConcreteCategory.congr_hom (hL i) (ULift.up (1 : ℤ))
      change P₂.map (E.f i).op u = (1 : ℤ) • z i at h
      simpa [u] using h
    have hzimage (i : E.I₀) :
        ηg.app (op (E.X i)) (z i) = P₃.map (E.f i).op s := by
      dsimp [z]
      rw [map_sub, hx]
      have hfg : ηf ≫ ηg = 0 := by
        dsimp [ηf, ηg]
        rw [← Functor.map_comp, S.zero, Functor.map_zero]
      have hzero : ηg.app (op (E.X i)) (ηf.app (op (E.X i)) (τ i)) = 0 := by
        have h := congrArg (fun θ : P₁ ⟶ P₃ => θ.app (op (E.X i)) (τ i)) hfg
        simpa [NatTrans.comp_app] using h
      rw [hzero, sub_zero]
    let φ : AddCommGrpCat.of (ULift ℤ) ⟶ P₃.obj (op U) :=
      AddCommGrpCat.ofHom (uliftZMultiplesHom _ (ηg.app (op U) u))
    let ψ : AddCommGrpCat.of (ULift ℤ) ⟶ P₃.obj (op U) :=
      AddCommGrpCat.ofHom (uliftZMultiplesHom _ s)
    have hgen (i : E.I₀) :
        P₃.map (E.f i).op (ηg.app (op U) u) = P₃.map (E.f i).op s := by
      rw [← NatTrans.naturality_apply, hu i, hzimage i]
    have hrestr (i : E.I₀) : φ ≫ P₃.map (E.f i).op = ψ ≫ P₃.map (E.f i).op := by
      simp only [φ, ψ, ofHom_uliftZMultiplesHom_comp, hgen i]
    have hφψ : φ = ψ :=
      S.X₃.property.hom_ext_ofArrows E.f (hCov E hE) hrestr
    refine ⟨u, ?_⟩
    have h := ConcreteCategory.congr_hom hφψ (ULift.up (1 : ℤ))
    change (1 : ℤ) • ηg.app (op U) u = (1 : ℤ) • s at h
    simpa [P₃, P, ηg] using h

end Stacks.CechSite
