/-- A site small in the coefficient universe has enough injective abelian sheaves. -/
noncomputable local instance sheafEnoughInjectives
    {C : Type u} [Category.{v} C] [Small.{v} C]
    (J : GrothendieckTopology C) [HasSheafify J AddCommGrpCat.{v}] :
    EnoughInjectives (Sheaf J AddCommGrpCat.{v}) := by
  have : IsGrothendieckAbelian.{v} (Sheaf J AddCommGrpCat.{v}) :=
    Sheaf.isGrothendieckAbelian_of_essentiallySmall.{v} J AddCommGrpCat.{v}
  infer_instance

/-- `w`-indexed limits of abelian groups at the enlarged coefficient universe, stated
directly so that instance search need not discover the universe comparison. -/
local instance hasLimitsOfSize_addCommGrpCat_max :
    HasLimitsOfSize.{w, w} AddCommGrpCat.{max v w} :=
  inferInstance

/-- `w`-indexed colimits of abelian groups at the enlarged coefficient universe. -/
local instance hasColimitsOfSize_addCommGrpCat_max :
    HasColimitsOfSize.{w, w} AddCommGrpCat.{max v w} :=
  inferInstance

/-- `w`-indexed coproducts of abelian presheaves at the enlarged coefficient universe. -/
local instance hasCoproducts_presheafAddCommGrpCat_max
    {C : Type u} [Category.{max v w} C] :
    HasCoproducts.{w} (Cᵒᵖ ⥤ AddCommGrpCat.{max v w}) := fun _ => inferInstance

private lemma evalOp_preservesFiniteLimits
    {D : Type u} [Category.{v} D] {A : Type uA} [Category.{vA} A]
    [HasProducts.{w} A] [HasFiniteLimits A] :
    PreservesFiniteLimits (FormalCoproduct.evalOp.{w} D A) :=
  preservesFiniteLimits_of_evaluation _ fun T ↦
    preservesFiniteLimits_of_natIso (evalOpCompEvaluationIso T.unop).symm

private lemma alternatingCofaceMapComplex_preservesFiniteLimits
    (A : Type uA) [Category.{vA} A] [Preadditive A] [HasFiniteLimits A] :
    PreservesFiniteLimits (AlgebraicTopology.alternatingCofaceMapComplex A) := by
  constructor
  intro J _ _
  apply HomologicalComplex.preservesLimitsOfShape_of_eval
  intro n
  change PreservesLimitsOfShape J ((evaluation SimplexCategory A).obj (SimplexCategory.mk n))
  infer_instance

private lemma cechComplexFunctor_preservesFiniteLimits
    {C : Type u} [Category.{v} C] {X : C} (E : PreZeroHypercover.{w} X)
    {A : Type uA} [Category.{vA} A] [HasProducts.{w} A] [Preadditive A] [HasFiniteLimits A]
    [∀ (n : ℕ) (i : Fin (n + 1) → E.I₀),
      HasProduct (fun a ↦ Over.mk (E.f (i a)))] :
    PreservesFiniteLimits (cechComplexFunctor (A := A) E) := by
  have : PreservesFiniteLimits (FormalCoproduct.evalOp.{w} (Over X) A) :=
    evalOp_preservesFiniteLimits
  have := alternatingCofaceMapComplex_preservesFiniteLimits A
  unfold cechComplexFunctor FormalCoproduct.cochainComplexFunctor
    FormalCoproduct.cosimplicialObjectFunctor
  infer_instance

private lemma epi_piMap_of_surjective {ι : Type t} (A B : ι → AddCommGrpCat.{max t a})
    [HasProducts.{t} AddCommGrpCat.{max t a}]
    (f : ∀ i, A i ⟶ B i)
    (hf : ∀ i, Function.Surjective (ConcreteCategory.hom (f i))) :
    Epi (Limits.Pi.map f) := by
  rw [AddCommGrpCat.epi_iff_surjective]
  intro y
  classical
  choose x hx using fun i => hf i ((Concrete.productEquiv B) y i)
  refine ⟨(Concrete.productEquiv A).symm x, ?_⟩
  apply (Concrete.productEquiv B).injective
  ext i
  calc
    (Concrete.productEquiv B) (Limits.Pi.map f ((Concrete.productEquiv A).symm x)) i =
        (Limits.Pi.π B i).hom (Limits.Pi.map f ((Concrete.productEquiv A).symm x)) := by simp
    _ = (f i).hom ((Limits.Pi.π A i).hom ((Concrete.productEquiv A).symm x)) :=
      congrArg (fun g => g.hom ((Concrete.productEquiv A).symm x)) (Limits.Pi.map_π f i)
    _ = (f i).hom (x i) := by simp
    _ = (Concrete.productEquiv B) y i := hx i

/-- Coefficient universe lifting commutes with the Čech complex. -/
private noncomputable def cechUliftIso
    {C : Type u} [Category.{max v w} C] {X : C} (E : PreZeroHypercover.{w} X)
    [∀ (n : ℕ) (i : Fin (n + 1) → E.I₀), HasProduct (fun a ↦ Over.mk (E.f (i a)))]
    (I : Cᵒᵖ ⥤ AddCommGrpCat.{max v w}) :
    ((AddCommGrpCat.uliftFunctor.{u}.mapHomologicalComplex _).obj
      (cechComplex E I)) ≅
        cechComplex E (I ⋙ AddCommGrpCat.uliftFunctor.{u}) := by
  let L := AddCommGrpCat.uliftFunctor.{u, max v w}
  let T : CosimplicialObject AddCommGrpCat.{max v w} := (cechSimplicialObject E).rightOp ⋙
    (FormalCoproduct.evalOp.{w} (Over X) AddCommGrpCat.{max v w}).obj ((Over.forget X).op ⋙ I)
  let T' : CosimplicialObject AddCommGrpCat.{max u v w} := (cechSimplicialObject E).rightOp ⋙
    (FormalCoproduct.evalOp.{w} (Over X) AddCommGrpCat.{max u v w}).obj
      ((Over.forget X).op ⋙ I ⋙ L)
  let P := (Over.forget X).op ⋙ I
  let e₀ : (FormalCoproduct.evalOp.{w} (Over X) AddCommGrpCat.{max v w}).obj P ⋙ L ≅
      (FormalCoproduct.evalOp.{w} (Over X) AddCommGrpCat.{max u v w}).obj (P ⋙ L) :=
    NatIso.ofComponents (fun Y ↦ PreservesProduct.iso L (fun i ↦ P.obj (op (Y.unop.obj i))))
      (by
        intro Y Z f
        apply Pi.hom_ext
        intro i
        dsimp only [Functor.comp_map, Functor.comp_obj, FormalCoproduct.evalOp]
        simp only [PreservesProduct.iso_hom, Category.assoc, piComparison_comp_π,
          Pi.lift_comp_π, piComparison_comp_π_assoc, ← L.map_comp])
  let e : T ⋙ L ≅ T' := Functor.isoWhiskerLeft (cechSimplicialObject E).rightOp e₀
  let e' : (L.mapHomologicalComplex _).obj (cechComplex E I) ≅
      (AlgebraicTopology.alternatingCofaceMapComplex _).obj (T ⋙ L) := by
    refine HomologicalComplex.Hom.isoOfComponents (fun n ↦ Iso.refl _) ?_
    intro i j hij
    obtain rfl : i + 1 = j := hij
    change 𝟙 _ ≫ _ = L.map _ ≫ 𝟙 _
    simp only [Category.comp_id]
    symm
    change L.map ((AlgebraicTopology.AlternatingCofaceMapComplex.obj T).d i (i + 1)) =
      (AlgebraicTopology.AlternatingCofaceMapComplex.obj (T ⋙ L)).d i (i + 1)
    simp only [AlgebraicTopology.AlternatingCofaceMapComplex.obj, CochainComplex.of_d,
      AlgebraicTopology.AlternatingCofaceMapComplex.objD, Functor.map_sum, Functor.map_zsmul]
    rfl
  exact e' ≪≫ (AlgebraicTopology.alternatingCofaceMapComplex _).mapIso e

/-- The source's exact-Hom argument also allows a larger object universe when the
coefficients already contain the morphism and covering-index universes. -/
private lemma injective_cechCohomology_isZero'
    {C : Type u} [Category.{max v w} C] {X : C} (E : PreZeroHypercover.{w} X)
    [∀ (n : ℕ) (i : Fin (n + 1) → E.I₀), HasProduct (fun a ↦ Over.mk (E.f (i a)))]
    (I : Cᵒᵖ ⥤ AddCommGrpCat.{max v w}) [Injective I] (p : ℕ) (hp : 0 < p) :
    IsZero (cechCohomology E I p) := by
  let K := integralCechComplex.{w, max v w, u, v} E
  have hK : K.ExactAt p := (HomologicalComplex.exactAt_iff_isZero_homology _ p).2
    (integralCechComplex_homology_isZero.{w, max v w, u, v} E p hp)
  have : (preadditiveYoneda.obj I).PreservesEpimorphisms :=
    (Injective.injective_iff_preservesEpimorphisms_preadditiveYoneda_obj I).1 inferInstance
  have : (preadditiveYoneda.obj I).PreservesHomology :=
    Functor.preservesHomology_of_preservesEpis_and_kernels _
  have hHom : ((homComplexFunctor K).obj I).ExactAt p :=
    ShortComplex.Exact.map hK.op (preadditiveYoneda.obj I)
  have hLift := hHom.of_iso ((homIntegralCechComplexIso.{w, max v w, u, v} E).app I)
  have hMap := hLift.of_iso (cechUliftIso E I).symm
  have hExact : (cechComplex E I).ExactAt p :=
    ((cechComplex E I).sc p |>.exact_map_iff_of_faithful
      AddCommGrpCat.uliftFunctor).1 hMap
  exact hExact.isZero_homology

/-- **Stacks 03F9 with the smallness assumption on the site traded for its consequences.**
This is `sheafCohomology_isZero_of_cechCohomology_isZero` with `Small.{max v w} C` replaced by
the two homological inputs the source's proof uses it for: enough injective abelian sheaves at
the coefficient universe, and sheafification detecting the locally bijective morphisms. -/
public theorem sheafCohomology_isZero_of_cechCohomology_isZero_of_enoughInjectives
    {C : Type u} [Category.{max v w} C] (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{max v w}]
    [HasExt.{x} (Sheaf J AddCommGrpCat.{max v w})]
    [EnoughInjectives (Sheaf J AddCommGrpCat.{max v w})]
    [J.WEqualsLocallyBijective AddCommGrpCat.{max v w}]
    (B : Set C)
    (Cov : ∀ U : C,
      Set { E : PreZeroHypercover.{w} U // E.sieve₀ ∈ J U })
    (hProducts : ∀ {U : C}
      (E : { E : PreZeroHypercover.{w} U // E.sieve₀ ∈ J U }),
      E ∈ Cov U → ∀ (p : ℕ) (i : Fin (p + 1) → E.1.I₀),
        HasProduct (fun a ↦ Over.mk (E.1.f (i a))))
    (hCovObjects : ∀ {U : C}
      (E : { E : PreZeroHypercover.{w} U // E.sieve₀ ∈ J U }) (hE : E ∈ Cov U),
      U ∈ B ∧ (∀ i, E.1.X i ∈ B) ∧
        ∀ (p : ℕ) (i : Fin (p + 1) → E.1.I₀),
          letI : ∀ (q : ℕ) (j : Fin (q + 1) → E.1.I₀),
            HasProduct (fun a ↦ Over.mk (E.1.f (j a))) := hProducts E hE
          (∏ᶜ (fun a ↦ Over.mk (E.1.f (i a)))).left ∈ B)
    (hCovCofinal : ∀ U ∈ B, ∀ R ∈ J U,
      ∃ (E : { E : PreZeroHypercover.{w} U // E.sieve₀ ∈ J U }),
        E ∈ Cov U ∧ E.1.sieve₀ ≤ R)
    (F : Sheaf J AddCommGrpCat.{max v w})
    (hCech : ∀ {U : C}
      (E : { E : PreZeroHypercover.{w} U // E.sieve₀ ∈ J U }) (hE : E ∈ Cov U)
      (p : ℕ), 0 < p →
        letI : ∀ (q : ℕ) (i : Fin (q + 1) → E.1.I₀),
          HasProduct (fun a ↦ Over.mk (E.1.f (i a))) := hProducts E hE
        IsZero (cechCohomology E.1 F.obj p))
    (U : C) (hU : U ∈ B) (p : ℕ) (hp : 0 < p) :
    IsZero (Sheaf.H' F p U) := by
  let P := fun (G : Sheaf J AddCommGrpCat.{max v w}) =>
    ∀ {V : C} (E : { E : PreZeroHypercover.{w} V // E.sieve₀ ∈ J V }) (hE : E ∈ Cov V)
      (n : ℕ), 0 < n →
        let := hProducts E hE
        IsZero (cechCohomology E.1 G.obj n)
  have main : ∀ (n : ℕ), 0 < n → ∀ (G : Sheaf J AddCommGrpCat.{max v w}), P G →
      ∀ V ∈ B, IsZero (Sheaf.H' G n V) := by
    intro n hn
    induction n using Nat.case_strong_induction_on with
    | hz => simp at hn
    | hi n ih =>
      intro G hG V hV
      let ⟨ip⟩ := EnoughInjectives.presentation G
      let I := ip.J
      let f : G ⟶ I := ip.f
      let Q := cokernel f
      let S : ShortComplex (Sheaf J AddCommGrpCat.{max v w}) :=
        ShortComplex.mk f (cokernel.π f) (cokernel.condition f)
      have hS : S.ShortExact := { exact := ShortComplex.exact_cokernel f }
      have hsurj (T : C) (hT : T ∈ B) : Function.Surjective
          (((sheafToPresheaf J (AddCommGrpCat.{max v w})).map S.g).app (Opposite.op T)) := by
        let Cov' : Set (PreZeroHypercover.{w} T) :=
          { E | ∃ h : E.sieve₀ ∈ J T,
            (⟨E, h⟩ : { E : PreZeroHypercover.{w} T // E.sieve₀ ∈ J T }) ∈ Cov T }
        refine surjective_on_sections_of_isZero_cechCohomology.{w, max v w, u, v}
          (J := J) (S := S) hS (U := T) (Cov := Cov') ?_ ?_ ?_ ?_
        · intro E hE
          exact hE.choose
        · intro R hR
          obtain ⟨E, hE, hER⟩ := hCovCofinal T hT R hR
          exact ⟨E.1, ⟨E.2, hE⟩, hER⟩
        · intro E hE p i
          obtain ⟨hcov, hECov⟩ := hE
          exact hProducts ⟨E, hcov⟩ hECov p i
        · intro E hE
          obtain ⟨hcov, hECov⟩ := hE
          exact hG ⟨E, hcov⟩ hECov 1 one_pos
      have hQ : P Q := by
        intro T E hE k hk
        let := hProducts E hE
        let Fcech := sheafToPresheaf J (AddCommGrpCat.{max v w}) ⋙ cechComplexFunctor E.1
        let : PreservesFiniteLimits (cechComplexFunctor E.1) :=
          cechComplexFunctor_preservesFiniteLimits
            (A := AddCommGrpCat.{max v w}) E.1
        let : PreservesFiniteLimits Fcech := by
          dsimp [Fcech]
          infer_instance
        let SC := S.map Fcech
        let : Mono S.f := hS.mono_f
        let : Mono SC.f := Functor.map_mono Fcech S.f
        have hSC : SC.ShortExact :=
          HomologicalComplex.shortExact_of_degreewise_shortExact SC fun m => by
          have hm := hCovObjects E hE
          have hepi : Epi ((SC.map (HomologicalComplex.eval _ _ m)).g) := by
            let W := fun i : Fin (m + 1) → E.1.I₀ =>
              (∏ᶜ fun a ↦ Over.mk (E.1.f (i a))).left
            change Epi (Limits.Pi.map fun i : Fin (m + 1) → E.1.I₀ =>
              ((sheafToPresheaf J (AddCommGrpCat.{max v w})).map S.g).app (op (W i)))
            apply epi_piMap_of_surjective.{w, v}
            intro i
            exact hsurj (W i) (hm.2.2 m i)
          let Eval := Fcech ⋙ HomologicalComplex.eval _ _ m
          let : PreservesFiniteLimits Eval := by
            dsimp [Eval]
            infer_instance
          let : Mono ((S.map Eval).f) := Functor.map_mono Eval S.f
          let : Mono ((SC.map (HomologicalComplex.eval _ _ m)).f) := by
            change Mono ((HomologicalComplex.eval _ _ m).map SC.f)
            exact Functor.map_mono (HomologicalComplex.eval _ _ m) SC.f
          let : Epi ((S.map Eval).g) := hepi
          have hPres : PreservesLimit (parallelPair S.g 0) Eval := inferInstance
          have hExact : (S.map Eval).Exact :=
            hS.exact.map_of_mono_of_preservesKernel Eval hS.mono_f hPres
          exact ShortComplex.ShortExact.mk hExact
        have hI : IsZero (SC.X₂.homology k) := by
          have hI : Injective I.obj :=
            (sheafificationAdjunction J AddCommGrpCat.{max v w}).map_injective I inferInstance
          exact injective_cechCohomology_isZero' E.1 I.obj k hk
        have hF : IsZero (SC.X₁.homology (k + 1)) :=
          hG E hE (k + 1) (Nat.zero_lt_succ k)
        exact (hSC.homology_exact₃ k (k + 1) (by simp)).isZero_X₂
          (hI.eq_of_src _ _) (hF.eq_of_tgt _ _)
      let P : Sheaf J AddCommGrpCat.{max v w} :=
        (presheafToSheaf J AddCommGrpCat.{max v w}).obj (yoneda.obj V ⋙ AddCommGrpCat.free)
      have hext (z : Ext P G (n + 1)) : ∃ q : Ext P Q n, q.comp hS.extClass rfl = z := by
        let : Injective I := ip.injective
        exact CategoryTheory.Abelian.Ext.covariant_sequence_exact₁ P hS z
          (Ext.eq_zero_of_injective _) rfl
      by_cases hn0 : n = 0
      · subst n
        have hs := hsurj V hV
        rw [IsZero.iff_id_eq_zero]
        ext z
        let sectionEquiv : ∀ A : Sheaf J AddCommGrpCat.{max v w},
            (P ⟶ A) ≃ (((sheafToPresheaf J AddCommGrpCat.{max v w}).obj A).obj (op V)) :=
          fun A =>
            ((sheafificationAdjunction J AddCommGrpCat.{max v w}).homEquiv _ A).trans
              (((AddCommGrpCat.adj.whiskerRight Cᵒᵖ).homEquiv
                (yoneda.obj V) A.obj).trans yonedaEquiv)
        let eQ := sectionEquiv S.X₃
        let eI := sectionEquiv S.X₂
        obtain ⟨q, rfl⟩ := hext z
        obtain ⟨i, hi⟩ := hs (eQ (Ext.addEquiv₀ q))
        have hcompat : eQ (eI.symm i ≫ S.g) = eQ (Ext.addEquiv₀ q) := by
          calc
            eQ (eI.symm i ≫ S.g) =
                ((sheafToPresheaf J AddCommGrpCat.{max v w}).map S.g).app (op V)
                  (eI (eI.symm i)) := by
              dsimp only [eQ, eI, sectionEquiv]
              simp only [Equiv.trans_apply, Equiv.symm_trans_apply]
              rw [(sheafificationAdjunction J AddCommGrpCat.{max v w}).homEquiv_naturality_right,
                (AddCommGrpCat.adj.whiskerRight Cᵒᵖ).homEquiv_naturality_right, yonedaEquiv_comp]
              rfl
            _ = eQ (Ext.addEquiv₀ q) := by
              rw [Equiv.apply_symm_apply]
              exact hi
        have hlift : eI.symm i ≫ S.g = Ext.addEquiv₀ q := eQ.injective hcompat
        have hq : q = Ext.mk₀ (eI.symm i ≫ S.g) := by
          simpa using congrArg (Ext.mk₀ (X := P) (Y := S.X₃)) hlift.symm
        change q.comp hS.extClass (zero_add 1) = 0
        rw [hq, ← Ext.mk₀_comp_mk₀_assoc]
        simp
      · have hnpos : 0 < n := Nat.pos_of_ne_zero hn0
        have hQ' := ih n (le_refl n) hnpos Q hQ V hV
        have hsub : Subsingleton (G.H' (n + 1) V) := by
          apply subsingleton_of_forall_eq 0
          intro z
          obtain ⟨q, hq⟩ := hext z
          let zRaw : Ext P G (n + 1) := z
          have hQsub : Subsingleton (Ext P Q n) := by
            change Subsingleton (Q.H' n V)
            exact AddCommGrpCat.subsingleton_of_isZero hQ'
          have hq0 : q = 0 := hQsub.elim _ _
          rw [hq0] at hq
          change zRaw = 0
          simpa only [Ext.zero_comp] using hq.symm
        exact AddCommGrpCat.isZero_of_subsingleton _
  exact main p hp F hCech U hU

/-- **Stacks Project, Tag 03F9.** If a cofinal collection of coverings of a collection of
objects has all its nonempty finite fibre products in that collection, then vanishing of
positive-degree Čech cohomology on those coverings implies vanishing of positive-degree sheaf
cohomology on every object in the collection. -/
@[stacks 03F9]
public theorem sheafCohomology_isZero_of_cechCohomology_isZero
    {C : Type u} [Category.{max v w} C] [Small.{max v w} C] (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{max v w}]
    [HasExt.{x} (Sheaf J AddCommGrpCat.{max v w})]
    (B : Set C)
    (Cov : ∀ U : C,
      Set { E : PreZeroHypercover.{w} U // E.sieve₀ ∈ J U })
    (hProducts : ∀ {U : C}
      (E : { E : PreZeroHypercover.{w} U // E.sieve₀ ∈ J U }),
      E ∈ Cov U → ∀ (p : ℕ) (i : Fin (p + 1) → E.1.I₀),
        HasProduct (fun a ↦ Over.mk (E.1.f (i a))))
    (hCovObjects : ∀ {U : C}
      (E : { E : PreZeroHypercover.{w} U // E.sieve₀ ∈ J U }) (hE : E ∈ Cov U),
      U ∈ B ∧ (∀ i, E.1.X i ∈ B) ∧
        ∀ (p : ℕ) (i : Fin (p + 1) → E.1.I₀),
          letI : ∀ (q : ℕ) (j : Fin (q + 1) → E.1.I₀),
            HasProduct (fun a ↦ Over.mk (E.1.f (j a))) := hProducts E hE
          (∏ᶜ (fun a ↦ Over.mk (E.1.f (i a)))).left ∈ B)
    (hCovCofinal : ∀ U ∈ B, ∀ R ∈ J U,
      ∃ (E : { E : PreZeroHypercover.{w} U // E.sieve₀ ∈ J U }),
        E ∈ Cov U ∧ E.1.sieve₀ ≤ R)
    (F : Sheaf J AddCommGrpCat.{max v w})
    (hCech : ∀ {U : C}
      (E : { E : PreZeroHypercover.{w} U // E.sieve₀ ∈ J U }) (hE : E ∈ Cov U)
      (p : ℕ), 0 < p →
        letI : ∀ (q : ℕ) (i : Fin (q + 1) → E.1.I₀),
          HasProduct (fun a ↦ Over.mk (E.1.f (i a))) := hProducts E hE
        IsZero (cechCohomology E.1 F.obj p))
    (U : C) (hU : U ∈ B) (p : ℕ) (hp : 0 < p) :
    IsZero (Sheaf.H' F p U) := by
  let : J.WEqualsLocallyBijective AddCommGrpCat.{max v w} :=
    GrothendieckTopology.WEqualsLocallyBijective.ofEssentiallySmall J
  exact sheafCohomology_isZero_of_cechCohomology_isZero_of_enoughInjectives J B Cov
    hProducts hCovObjects hCovCofinal F hCech U hU p hp

end Stacks.CechSite
