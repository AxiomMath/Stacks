open CategoryTheory CategoryTheory.Limits

universe uD vD uC vC w

/-- A presheaf of commutative rings whose underlying presheaf of sets is a sheaf is itself a
sheaf, with no relation assumed between the universe of the site and the universe of the rings.

Mathlib's `CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp` asks the forgetful functor to
reflect limits of a size determined by the site, which for `CommRingCat.{w}` holds only when the
site is no larger than `w`. The hypothesis supplies the limit cone on underlying sets, and every
limit in play is therefore small, so the forgetful functor preserves and (reflecting
isomorphisms) reflects it. -/
@[ega "0 3.1.3" "special case"]
theorem CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp_forget_commRingCat
    {C : Type*} [Category C] (J : GrothendieckTopology C) (P : Cᵒᵖ ⥤ CommRingCat.{w})
    (h : Presheaf.IsSheaf J (P ⋙ forget CommRingCat)) : Presheaf.IsSheaf J P := by
  rw [Presheaf.isSheaf_iff_isLimit] at h ⊢
  intro X S hS
  obtain ⟨t⟩ := h S hS
  let D := S.arrows.diagram.op ⋙ P
  have : HasLimit (D ⋙ forget CommRingCat) := ⟨_, t⟩
  have : Small.{w} (D ⋙ forget CommRingCat).sections :=
    (Types.hasLimit_iff_small_sections _).mp inferInstance
  have : PreservesLimit D (forget CommRingCat) :=
    preservesLimit_of_preserves_limit_cone (CommRingCat.limitConeIsLimit D)
      (Types.Small.limitConeIsLimit _)
  have : ReflectsLimit D (forget CommRingCat) :=
    reflectsLimit_of_reflectsIsomorphisms D (forget CommRingCat)
  exact ⟨isLimitOfReflects (forget CommRingCat) t⟩

namespace Stacks.Sites.FibredCategory

/-- The chosen cartesian lift at `X` of a member of a sieve `B` on `p.obj X` lies in the functor
pullback of `B`. -/
theorem map_pullbackMap_mem
    {C D : Type*} [Category C] [Category D] (p : C ⥤ D) [p.IsPreFibered]
    {X : C} (B : Sieve (p.obj X)) {V : D} {u : V ⟶ p.obj X} (hu : B u) :
    B (p.map (Functor.IsPreFibered.pullbackMap (p := p) (a := X) rfl u)) := by
  have hfac : p.map (Functor.IsPreFibered.pullbackMap (p := p) (a := X) rfl u) =
      eqToHom (IsHomLift.domain_eq p u
        (Functor.IsPreFibered.pullbackMap (p := p) (a := X) rfl u)) ≫ u := by
    simpa using (IsHomLift.fac' p u (Functor.IsPreFibered.pullbackMap (p := p) (a := X) rfl u))
  rw [hfac]
  exact B.downward_closed hu _

/-- Elements of a compatible family on a functor pullback are related by restriction along any
factorisation `k ≫ e = f`. -/
private theorem map_eq_of_comp_eq
    {C D : Type*} [Category C] [Category D] {p : C ⥤ D}
    {X : C} {B : Sieve (p.obj X)} {G : Dᵒᵖ ⥤ Type*}
    {x : (B.functorPullback p).arrows.FamilyOfElements (p.op ⋙ G)} (hx : x.Compatible)
    {Y Z : C} {f : Y ⟶ X} {e : Z ⟶ X} {k : Y ⟶ Z} (hk : k ≫ e = f)
    (hf : B (p.map f)) (he : B (p.map e)) : G.map (p.map k).op (x e he) = x f hf := by
  simpa using hx k (𝟙 _) he hf (by rw [hk, Category.id_comp])

/-- Transporting a compatible family along the chosen cartesian lifts commutes with restriction
along `g`, where `w` is a lift of `g ≫ u`. -/
private theorem transport_restrict_eq
    {C D : Type*} [Category C] [Category D] (p : C ⥤ D) [p.IsFibered]
    {X : C} (B : Sieve (p.obj X)) (G : Dᵒᵖ ⥤ Type*)
    (x : (B.functorPullback p).arrows.FamilyOfElements (p.op ⋙ G)) (hx : x.Compatible)
    {V Z : D} {u : V ⟶ p.obj X} {g : Z ⟶ V} {w : Z ⟶ p.obj X} (hw : w = g ≫ u)
    (hu : B u) (hwB : B w) :
    G.map g.op (G.map (eqToHom (IsHomLift.domain_eq p u
        (Functor.IsPreFibered.pullbackMap (p := p) (a := X) rfl u)).symm).op
      (x _ (map_pullbackMap_mem p B hu))) =
    G.map (eqToHom (IsHomLift.domain_eq p w
        (Functor.IsPreFibered.pullbackMap (p := p) (a := X) rfl w)).symm).op
      (x _ (map_pullbackMap_mem p B hwB)) := by
  subst hw
  let e := Functor.IsPreFibered.pullbackMap (p := p) (a := X) rfl u
  let e₃ := Functor.IsPreFibered.pullbackMap (p := p) (a := X) rfl (g ≫ u)
  let q := Functor.IsStronglyCartesian.map p u e (g := g) (f' := g ≫ u) rfl e₃
  have hq := Functor.IsStronglyCartesian.fac p u e (f' := g ≫ u) (hf' := rfl) e₃
  have hbase : eqToHom (IsHomLift.domain_eq p (g ≫ u) e₃).symm ≫ p.map q =
      g ≫ eqToHom (IsHomLift.domain_eq p u e).symm := by
    rw [IsHomLift.fac' p g q]
    simp
  have hc := map_eq_of_comp_eq hx hq (map_pullbackMap_mem p B hwB) (map_pullbackMap_mem p B hu)
  erw [← hc]
  have h := congrArg (fun f => G.map f.op (x e (map_pullbackMap_mem p B hu))) hbase
  simp only [Functor.op_obj, op_comp, eqToHom_op, Functor.map_comp, comp_apply] at h ⊢
  exact h.symm

/-- For a fibred `p : C ⥤ D`, a compatible family of elements of `p.op ⋙ G` on the functor
pullback of a sieve `B` on `p.obj X` transports, along the chosen cartesian lifts, to a compatible
family of elements of `G` on `B`. -/
theorem compatible_transport_pullbackMap
    {C D : Type*} [Category C] [Category D] (p : C ⥤ D) [p.IsFibered]
    {X : C} (B : Sieve (p.obj X)) (G : Dᵒᵖ ⥤ Type*)
    (x : (B.functorPullback p).arrows.FamilyOfElements (p.op ⋙ G)) (hx : x.Compatible) :
    Presieve.FamilyOfElements.Compatible (P := G) (R := B.arrows) fun {_} u hu =>
      G.map (eqToHom (IsHomLift.domain_eq p u
        (Functor.IsPreFibered.pullbackMap (p := p) (a := X) rfl u)).symm).op
        (x (Functor.IsPreFibered.pullbackMap (p := p) (a := X) rfl u) (map_pullbackMap_mem p B hu))
    := by
  intro V₁ V₂ Z g₁ g₂ u₁ u₂ hu₁ hu₂ h
  exact (transport_restrict_eq p B G x hx rfl hu₁ (B.downward_closed hu₁ g₁)).trans
    (transport_restrict_eq p B G x hx h hu₂ (B.downward_closed hu₁ g₁)).symm

/-- For a fibred `p : C ⥤ D`, restriction along `p.op` of a presheaf that is a sheaf for a sieve
`B` on `p.obj X` is a sheaf for the functor pullback of `B` to `X`.

A compatible family for the pulled-back sieve is transported to one for `B` along the chosen
cartesian lifts, using that two lifts of one morphism agree up to a unique vertical
isomorphism; the amalgamation for `B` then amalgamates the original family, and is unique
because `B` is separating. -/
theorem isSheafFor_functorPullback_of_isFibered
    {C D : Type*} [Category C] [Category D] (p : C ⥤ D) [p.IsFibered]
    {X : C} (B : Sieve (p.obj X)) (G : Dᵒᵖ ⥤ Type*)
    (hG : Presieve.IsSheafFor G B.arrows) :
    Presieve.IsSheafFor (p.op ⋙ G) (B.functorPullback p).arrows := by
  let lift := fun {V : D} (u : V ⟶ p.obj X) =>
    Functor.IsPreFibered.pullbackMap (p := p) (a := X) rfl u
  intro x hx
  let y : B.arrows.FamilyOfElements G := fun {V} u hu =>
    let e := lift u
    G.map (eqToHom (IsHomLift.domain_eq p u e).symm).op
      (x e (map_pullbackMap_mem p B hu))
  have hy : y.Compatible := compatible_transport_pullbackMap p B G x hx
  obtain ⟨t, ht, htuniq⟩ := hG y hy
  refine ⟨t, ?_, ?_⟩
  · intro Y f hf
    let e := lift (p.map f)
    have he : B (p.map e) := map_pullbackMap_mem p B hf
    let d := IsHomLift.domain_eq p (p.map f) e
    let a := eqToHom d.symm
    have hfactor : p.map f = (𝟙 (p.obj Y)) ≫ p.map f := by simp
    let k := Functor.IsStronglyCartesian.map p (p.map f) e
      (g := 𝟙 (p.obj Y)) (f' := p.map f) hfactor f
    have hke := Functor.IsStronglyCartesian.fac p (p.map f) e
      (g := 𝟙 (p.obj Y)) (f' := p.map f) (hf' := hfactor) f
    have hpk : p.map k = a := by
      simpa [a, d] using (IsHomLift.fac' p (𝟙 (p.obj Y)) k)
    have hybase : G.map (p.map f).op t = G.map a.op (x e he) := by
      simpa [y, e, a, d] using ht (p.map f) hf
    show G.map (p.map f).op t = x f hf
    rw [hybase, ← hpk]
    exact map_eq_of_comp_eq hx hke hf he
  · intro t₁ ht₁
    apply hG.isSeparatedFor.ext
    intro V u hu
    let e := lift u
    have he : B (p.map e) := map_pullbackMap_mem p B hu
    let d := IsHomLift.domain_eq p u e
    have hfac : p.map e = eqToHom d ≫ u := by
      simpa [d] using (IsHomLift.fac' p u e)
    have h₁ := congrArg (G.map (eqToHom d.symm).op) (ht₁ e he)
    simpa [y, e, d, hfac] using h₁.trans (ht u hu).symm

/-- A morphism lies in the sieve generated by a presieve of strongly cartesian morphisms exactly
when its image lies in the sieve generated by the image presieve. -/
theorem generate_mem_iff_map_generate
    {C D : Type*} [Category C] [Category D] (p : C ⥤ D)
    {X Y : C} (R : Presieve X)
    (hcart : ∀ ⦃Z : C⦄ (g : Z ⟶ X), R g → p.IsStronglyCartesian (p.map g) g)
    (f : Y ⟶ X) :
    (Sieve.generate R) f ↔ (Sieve.generate (R.map p)) (p.map f) := by
  constructor
  · rintro ⟨Z, a, g, hg, rfl⟩
    simpa only [← p.map_comp] using (Sieve.generate (R.map p)).downward_closed
      (Sieve.le_generate (R.map p) _ _ (Presieve.map_map hg)) (p.map a)
  · rintro ⟨W, a, b, hb, hab⟩
    rcases (Presieve.map_iff.mp hb) with ⟨Z, rfl, g, hg, hpg⟩
    have hbase : p.map f = a ≫ p.map g := by
      rw [← hab, hpg]
      simp
    let _ : p.IsStronglyCartesian (p.map g) g := hcart g hg
    obtain ⟨k, ⟨-, hk⟩, -⟩ :=
      Functor.IsStronglyCartesian.universal_property p (p.map g) g a (p.map f) hbase f
    exact ⟨Z, k, g, hg, hk⟩

/-- **Stacks 06NW, continuity half, for the projection of a fibred category.** The projection
`p : C ⥤ D` of a fibred category is a continuous functor from the topology `C` inherits from
`(D, J)` to `J`: restriction along `p.op` carries sheaves on `D` to sheaves on `C`. -/
theorem isContinuous_inheritedTopology_of_isFibered
    {C D : Type*} [Category C] [Category D] (p : C ⥤ D) [p.IsFibered]
    (J : GrothendieckTopology D) : p.IsContinuous (p.inheritedTopology J) J := by
  constructor
  intro G
  show Presieve.IsSheaf
    (p.inheritedPrecoverage J.toPrecoverage).toGrothendieck (p.op ⋙ G.obj)
  rw [(p.inheritedPrecoverage J.toPrecoverage).isSheaf_toGrothendieck_iff]
  intro X Y f R hR
  let B : Sieve (p.obj Y) := (Sieve.generate (R.map p)).pullback (p.map f)
  have hB : B ∈ J (p.obj Y) := J.pullback_stable (p.map f)
    (J.toGrothendieck_toPrecoverage_le _ (Precoverage.generate_mem_toGrothendieck hR.2))
  have hEq : (Sieve.generate R).pullback f = B.functorPullback p := by
    ext Z g
    show (Sieve.generate R) (g ≫ f) ↔
      (Sieve.generate (R.map p)) (p.map g ≫ p.map f)
    rw [← p.map_comp]
    exact generate_mem_iff_map_generate p R
      (fun {_} q hq => hR.1 q hq) (g ≫ f)
  rw [hEq]
  exact isSheafFor_functorPullback_of_isFibered p B G.obj (G.2.isSheafFor B hB)

/-- **Stacks 06NW, cocontinuity half, for the projection of a fibred category.** The projection
`p : C ⥤ D` of a fibred category is a cocontinuous functor from the topology `C` inherits from
`(D, J)` to `J`: a covering sieve of `p.obj U` is refined by the images of the cartesian lifts
at `U` of its members, and those lifts form a covering family of the inherited structure. -/
theorem isCocontinuous_inheritedTopology_of_isFibered
    {C D : Type*} [Category C] [Category D] (p : C ⥤ D) [p.IsFibered]
    (J : GrothendieckTopology D) : p.IsCocontinuous (p.inheritedTopology J) J := by
  constructor
  intro U S hS
  let R : Presieve U := fun _ g => S (p.map g) ∧ p.IsStronglyCartesian (p.map g) g
  have hR : R ∈ p.inheritedPrecoverage J.toPrecoverage U := by
    refine ⟨fun Y g hg => hg.2, ?_⟩
    rw [GrothendieckTopology.mem_toPrecoverage_iff]
    apply J.superset_covering ?_ hS
    intro V f hf
    obtain ⟨Z, g, hg⟩ := IsPreFibered.exists_isCartesian p rfl f
    cases IsHomLift.domain_eq p f g
    let _ : p.IsCartesian f g := hg
    let _ : p.IsStronglyCartesian f g := inferInstance
    have hfac : p.map g = f := (IsHomLift.eq_of_isHomLift p f g).symm
    have hcart : p.IsStronglyCartesian (p.map g) g := by
      rw [hfac]
      infer_instance
    have hgR : R g := ⟨by simpa [hfac] using hf, hcart⟩
    exact Sieve.le_generate (R.map p) _ _ (Presieve.map_iff.2 ⟨Z, rfl, g, hgR, by simp [hfac]⟩)
  refine (p.inheritedTopology J).superset_covering ?_
    (Precoverage.generate_mem_toGrothendieck hR)
  rw [Sieve.generate_le_iff]
  exact fun _ _ hg => hg.1

/-- A ringed site `(D, O_D)` together with a fibred category `p : C ⥤ D` over its underlying
site. -/
@[stacks 08P8 "standing data"]
structure FibredCategorySituation where
  /-- The base ringed site `(D, O_D)`. -/
  base : AlgebraicGeometry.RingedSite.{uD, vD, w}
  /-- The total category `C`. -/
  C : Type uC
  /-- Morphisms of the total category. -/
  [category : Category.{vC} C]
  /-- The projection of the fibred category. -/
  p : C ⥤ base.C
  /-- The projection is a fibred category. -/
  [isFibered : p.IsFibered]

attribute [instance] FibredCategorySituation.category FibredCategorySituation.isFibered

namespace FibredCategorySituation

variable (s : FibredCategorySituation.{uD, vD, uC, vC, w})

/-- The topology on the total category inherited from the base site. -/
abbrev topology : GrothendieckTopology s.C := s.p.inheritedTopology s.base.J

/-- The projection `p : C ⥤ D` is continuous for the inherited topology on `C`. -/
instance isContinuous : s.p.IsContinuous s.topology s.base.J :=
  isContinuous_inheritedTopology_of_isFibered s.p s.base.J

/-- The projection `p : C ⥤ D` is cocontinuous for the inherited topology on `C`. -/
instance isCocontinuous : s.p.IsCocontinuous s.topology s.base.J :=
  isCocontinuous_inheritedTopology_of_isFibered s.p s.base.J

/-- The morphism of topoi induced by the projection, together with the identification of each of
its components with the canonical one. -/
structure ProjectionData where
  /-- The underlying morphism of topoi. -/
  hom : MorphismOfTopoi
    (Sheaf s.topology (Type (max w uD vD uC vC)))
    (Sheaf s.base.J (Type (max w uD vD uC vC)))
  /-- Its inverse image is restriction along the projection. -/
  inverseImage_eq :
    hom.inverseImage = s.p.sheafPushforwardContinuous
      (Type (max w uD vD uC vC)) s.topology s.base.J
  /-- Its direct image is the right adjoint of that restriction. -/
  pushforward_eq :
    hom.pushforward = s.p.sheafPushforwardCocontinuous
      (Type (max w uD vD uC vC)) s.topology s.base.J
  /-- The canonical adjunction, with its functors identified by the preceding equalities. -/
  adjunction_eq :
    HEq hom.adj (s.p.sheafAdjunctionCocontinuous
      (Type (max w uD vD uC vC)) s.topology s.base.J)

/-- **Stacks 08P8, the associated morphism of topoi.** The morphism of topoi
`π : Sh(C) ⟶ Sh(D)` canonically associated to the fibred projection: its inverse image is
restriction along `p.op`, which is left exact because restriction is computed on underlying
presheaves, where it is precomposition. -/
@[stacks 08P8 "associated morphism of topoi"]
noncomputable def inducedProjection : ProjectionData s where
  hom :=
    { pushforward := s.p.sheafPushforwardCocontinuous
        (Type (max w uD vD uC vC)) s.topology s.base.J
      inverseImage := s.p.sheafPushforwardContinuous
        (Type (max w uD vD uC vC)) s.topology s.base.J
      adj := s.p.sheafAdjunctionCocontinuous
        (Type (max w uD vD uC vC)) s.topology s.base.J
      preservesFiniteLimits := by
        constructor
        intro T _ _
        have hcomp : PreservesLimitsOfShape T
            (s.p.sheafPushforwardContinuous
              (Type (max w uD vD uC vC)) s.topology s.base.J ⋙
              sheafToPresheaf s.topology (Type (max w uD vD uC vC))) :=
          preservesLimitsOfShape_of_natIso
            (s.p.sheafPushforwardContinuousCompSheafToPresheafIso
              (Type (max w uD vD uC vC)) s.topology s.base.J).symm
        exact preservesLimitsOfShape_of_reflects_of_preserves _
          (sheafToPresheaf s.topology (Type (max w uD vD uC vC))) }
  inverseImage_eq := rfl
  pushforward_eq := rfl
  adjunction_eq := HEq.rfl

/-- The morphism of topoi denoted `π` in the source. -/
noncomputable abbrev projection :
    MorphismOfTopoi
      (Sheaf s.topology (Type (max w uD vD uC vC)))
      (Sheaf s.base.J (Type (max w uD vD uC vC))) :=
  (s.inducedProjection).hom

/-- The base structure sheaf, with its sections lifted to the universe in which the morphism of
topoi `π` is formed. -/
noncomputable def liftedBaseSheaf :
    Sheaf s.base.J CommRingCat.{max w uD vD uC vC} :=
  let F : CommRingCat.{w} ⥤ CommRingCat.{max w uD vD uC vC} :=
    { obj R := CommRingCat.of (ULift R)
      map f := CommRingCat.ofHom f.hom.ulift
      map_id := by
        intro R
        apply CommRingCat.hom_ext
        ext x
        rfl
      map_comp := by
        intro R S T f g
        apply CommRingCat.hom_ext
        ext x
        rfl }
  ⟨s.base.O.obj ⋙ F, by
    apply CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp_forget_commRingCat
    change Presheaf.IsSheaf s.base.J
      ((s.base.O.obj ⋙ forget CommRingCat.{w}) ⋙ uliftFunctor)
    have hsmall : Presheaf.IsSheaf s.base.J
        (s.base.O.obj ⋙ forget CommRingCat.{w}) := by
      have hO := s.base.O.property
      rw [Presheaf.isSheaf_iff_isLimit] at hO ⊢
      intro X S hS
      obtain ⟨hlim⟩ := hO S hS
      exact ⟨isLimitOfPreserves (forget CommRingCat.{w}) hlim⟩
    rw [isSheaf_iff_isSheaf_of_type] at hsmall ⊢
    exact (Presieve.isSheaf_comp_uliftFunctor_iff s.base.J).2 hsmall⟩

/-- The base ringed site, viewed as a ringed topos in the universe in which `π` is formed. -/
noncomputable abbrev baseRingedTopos :
    AlgebraicGeometry.RingedTopos.{vD, uD, max w uD vD uC vC} where
  C := s.base.C
  J := s.base.J
  O := s.liftedBaseSheaf

end FibredCategorySituation

end Stacks.Sites.FibredCategory
