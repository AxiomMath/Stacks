module

public import StacksFrontier.CategoryTheory.Triangulated.CompactObjects

/-!
# A right adjoint commutes with direct sums when its left adjoint preserves a compact generator

Let `L ⊣ G` be an adjunction of additive functors between pre-triangulated categories with direct
sums, with `L` commuting with the shift. If the target of `L` is weakly generated by a single
compact object `E` whose image `L E` is again compact, then `G` commutes with direct sums.

This is the abstract content of the direct-sum statement that Grothendieck duality needs of
derived direct image: `Rf_*` commutes with direct sums because its left adjoint `Lf^*` carries a
compact generator of `D_QCoh(𝒪_Y)` to a compact object of `D_QCoh(𝒪_X)`.

## Main results

* `CategoryTheory.Pretriangulated.isIso_of_generator_hom_bijective`: a morphism against which
  `Hom(E⟦n⟧, -)` is bijective for every shift of a weak generator `E` is an isomorphism.
* `CategoryTheory.Pretriangulated.preservesCoproducts_of_compact_pullback`: the right adjoint
  commutes with direct sums.

## Implementation notes

The criterion for the comparison morphism `⨁ G Aᵢ ⟶ G (⨁ Aᵢ)` to be an isomorphism is tested
against the shifts of the generator. On the left the test is bijectivity of the compactness map
of `E⟦n⟧` against the family `G Aᵢ`, which is
`CategoryTheory.bijective_cofanMap` applied to the compact object `E⟦n⟧`; on the right it is
bijectivity against the family `G` of the `Aᵢ`, which is
`CategoryTheory.bijective_cofanMap_of_adjunction` applied to the compact object `L (E⟦n⟧)`.
`CategoryTheory.cofanMap_naturality` identifies the composite of the first with the comparison
morphism as the second, and bijectivity of a composite with a bijective first factor gives
bijectivity of the second.

That the shifts of a compact object are compact, and that compactness is invariant under
isomorphism, are the first two components of the omnibus statement of Stacks 09QH in
`StacksFrontier/CategoryTheory/Triangulated/CompactObjects.lean`.

## References

* [Stacks Project, Tag 08DZ](https://stacks.math.columbia.edu/tag/08DZ)
* [Stacks Project, Tag 09QH](https://stacks.math.columbia.edu/tag/09QH)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe w v₁ v₂ u₁ u₂

namespace CategoryTheory.Pretriangulated

section Generator

variable {C : Type u₁} [Category.{v₁} C] [Preadditive C] [HasZeroObject C] [HasShift C ℤ]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]

/-- **A morphism is an isomorphism as soon as it is bijective on maps out of every shift of a
weak generator.** The cone of the morphism is right orthogonal to those shifts — surjectivity
produces a factorization of any map from a shift of the generator through the source, and
injectivity one degree down kills the connecting map — so the weak generation hypothesis makes
the cone zero. -/
theorem isIso_of_generator_hom_bijective (generator : C)
    (hgenerator : (ObjectProperty.singleton generator).IsWeakTriangulatedGenerator)
    {source target : C} (morphism : source ⟶ target)
    (hhom : ∀ object, (ObjectProperty.singleton generator).shiftClosure ℤ object →
      Function.Bijective (fun map : object ⟶ source => map ≫ morphism)) : IsIso morphism := by
  let property := (ObjectProperty.singleton generator).shiftClosure ℤ
  obtain ⟨cone, next, boundary, htriangle⟩ := distinguished_cocone_triangle morphism
  refine (Triangle.isZero₃_iff_isIso₁ _ htriangle).1 (hgenerator _ fun {object} map hobject => ?_)
  have hzero : boundary ≫ morphism⟦(1 : ℤ)⟧' = 0 := comp_distTriang_mor_zero₃₁ _ htriangle
  have hboundary : map ≫ boundary = 0 := by
    refine eq_zero_of_comp_shift_map_eq_zero (b := morphism) (fun other hother => ?_) _ ?_
    · exact (hhom _ (property.le_shift (-1 : ℤ) _ hobject)).1 (by simpa using hother)
    · simp only [Category.assoc, hzero, comp_zero]
  obtain ⟨lift, hlift⟩ := Triangle.coyoneda_exact₃ _ htriangle map hboundary
  obtain ⟨preimage, hpreimage⟩ := (hhom _ hobject).2 lift
  rw [hlift, ← hpreimage, Category.assoc]
  change preimage ≫ (morphism ≫ next) = 0
  have hnext : morphism ≫ next = 0 := comp_distTriang_mor_zero₁₂ _ htriangle
  rw [hnext, comp_zero]

end Generator

section Adjunction

variable {C : Type u₁} {D : Type u₂} [Category.{v₁} C] [Category.{v₂} D]
  [Preadditive C] [Preadditive D] [HasZeroObject C] [HasZeroObject D]
  [HasShift C ℤ] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [∀ n : ℤ, (shiftFunctor D n).Additive]
  [Pretriangulated C] [Pretriangulated D] [HasCoproducts.{w} C] [HasCoproducts.{w} D]

/-- An object isomorphic to a shift of a compact object is compact. -/
private theorem isCompactObject_of_iso_shift {T : Type u₁} [Category.{v₁} T] [Preadditive T]
    [HasZeroObject T] [HasShift T ℤ] [∀ n : ℤ, (shiftFunctor T n).Additive] [Pretriangulated T]
    [HasCoproducts.{w} T] {original object : T} (degree : ℤ) (iso : object ≅ original⟦degree⟧)
    (horiginal : IsCompactObject.{w} original) : IsCompactObject.{w} object := by
  obtain ⟨_, _, -⟩ :=
    isClosedUnderIsomorphisms_isTriangulated_isSaturated_and_isIdempotentComplete_isCompactObject
      (D := T)
  exact ObjectProperty.prop_of_iso (IsCompactObject.{w} : ObjectProperty T) iso.symm
    (ObjectProperty.le_shift (IsCompactObject.{w} : ObjectProperty T) degree _ horiginal)

/-- **The right adjoint of a functor preserving a compact weak generator commutes with direct
sums.** Let `pullback ⊣ pushforward` be an adjunction of additive functors of pre-triangulated
categories with direct sums, with `pullback` commuting with the shift. If `generator` is a
compact weak generator of the target of `pushforward` whose image under `pullback` is again
compact, then `pushforward` preserves direct sums indexed by any type of the compactness
universe. -/
theorem preservesCoproducts_of_compact_pullback (pullback : D ⥤ C) (pushforward : C ⥤ D)
    [pullback.Additive] [pushforward.Additive] [pullback.CommShift ℤ]
    (adjunction : pullback ⊣ pushforward) (generator : D)
    (hgenerator : (ObjectProperty.singleton generator).IsWeakTriangulatedGenerator)
    (hcompact : IsCompactObject.{w} generator)
    (hpullback : IsCompactObject.{w} (pullback.obj generator)) (index : Type w) :
    PreservesColimitsOfShape (Discrete index) pushforward := by
  classical
  constructor
  intro diagram
  let family := diagram.obj ∘ Discrete.mk
  let comparison := sigmaComparison pushforward family
  have hiso : IsIso comparison := by
    refine isIso_of_generator_hom_bijective generator hgenerator _ fun object hobject => ?_
    obtain ⟨original, degree, iso, horiginal⟩ :=
      (ObjectProperty.prop_shiftClosure_iff _ _).1 hobject
    have heq : original = generator := ((ObjectProperty.singleton_iff _ _).1 horiginal).symm
    subst heq
    have hobjectCompact := isCompactObject_of_iso_shift degree iso hcompact
    have hpullbackCompact : IsCompactObject.{w} (pullback.obj object) :=
      isCompactObject_of_iso_shift degree
        (pullback.mapIso iso ≪≫ (pullback.commShiftIso degree).app original) hpullback
    have hfirst := bijective_cofanMap object hobjectCompact
      (Sigma.ι fun member => pushforward.obj (family member)) (coproductIsCoproduct _)
    have hsecond := bijective_cofanMap_of_adjunction adjunction object hpullbackCompact
      (Sigma.ι family) (coproductIsCoproduct family)
    have hcompatibility :
        (fun map : object ⟶ ∐ fun member => pushforward.obj (family member) =>
            map ≫ comparison) ∘
          cofanMap object (Sigma.ι fun member => pushforward.obj (family member)) =
        cofanMap object fun member => pushforward.map (Sigma.ι family member) := by
      funext element
      have hnatural := cofanMap_naturality object
        (Sigma.ι fun member => pushforward.obj (family member))
        (fun member => pushforward.map (Sigma.ι family member)) (fun member => 𝟙 _) comparison
        (fun member => by simp [comparison]) element
      have hidentity : (DirectSum.map fun member =>
          Preadditive.rightComp object (𝟙 (pushforward.obj (family member)))) element
            = element := by
        ext member
        simp [DirectSum.map_apply, Preadditive.rightComp]
      rw [hidentity] at hnatural
      exact hnatural.symm
    exact (Function.Bijective.of_comp_iff _ hfirst).1 (hcompatibility ▸ hsecond)
  have : PreservesColimit (Discrete.functor family) pushforward :=
    PreservesCoproduct.of_iso_comparison _ _
  exact preservesColimit_of_iso_diagram _ Discrete.natIsoFunctor.symm

end Adjunction

end CategoryTheory.Pretriangulated

end
