/-!
# Compact generation of the derived category of abelian sheaves

The unbounded derived category of abelian sheaves on a site with enough quasi-compact weakly
contractible objects is compactly generated.

Abelian sheaves are the sheaves of modules over the constant sheaf of rings `ℤ`: an additive
map of abelian sheaves is automatically `ℤ`-linear, and an abelian sheaf carries a unique
action of the constant sheaf `ℤ`, which extends along the sheafification of the scalars. So the
forgetful functor from sheaves of modules over that sheaf of rings to abelian sheaves is an
equivalence, it induces an equivalence of derived categories, and compact generation transports
across it.

## Main results

* `Stacks.Cohomology.hasSheafify_ringCat` and
  `Stacks.Cohomology.wEqualsLocallyBijective_ringCat`: sheafification of presheaves of rings in
  a universe containing the site.
* `Stacks.Cohomology.isEquivalence_toSheaf_intSheaf`: sheaves of modules over the constant sheaf
  of rings `ℤ` are the abelian sheaves.
* `Stacks.Cohomology.isCompactlyGenerated_derivedCategory_abelianSheaves_of_hasEnoughObjects`:
  compact generation of the derived category of abelian sheaves.

## Implementation notes

The rank-one module is `ULift ℤ`, since the sheaf of rings has to take values in the universe
of the module sections. Its action on an abelian group is transported along `ULift.ringEquiv`,
and agrees with the canonical one because scalar multiplication by an integer is iterated
addition.

The transport of compact generation only uses that the functor is an additive equivalence
commuting with the shift, so it is stated for such a functor between additive categories with
a shift rather than for the derived categories themselves.

## References

* [Stacks Project, Tag 0F4Q](https://stacks.math.columbia.edu/tag/0F4Q)
* [Stacks Project, Tag 09SQ](https://stacks.math.columbia.edu/tag/09SQ)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe z s t u v w

namespace Stacks.Cohomology

attribute [local instance] HasDerivedCategory.standard

/-! ### Sheafification of presheaves of rings -/

/-- Presheaves of rings with sections in a universe containing the site admit sheafification. -/
theorem hasSheafify_ringCat.{z', u', v'} {C : Type u'} [Category.{v'} C]
    (J : GrothendieckTopology C) [UnivLE.{u', z'}] [UnivLE.{v', z'}] :
    HasSheafify J RingCat.{z'} :=
  hasSheafifyEssentiallySmallSite.{v', z', u', z' + 1, z'} J _

/-- Sheafification equivalences of presheaves of rings are exactly the locally bijective
morphisms, in every universe of sections containing the site. -/
theorem wEqualsLocallyBijective_ringCat.{z', u', v'} {C : Type u'} [Category.{v'} C]
    (J : GrothendieckTopology C) [UnivLE.{u', z'}] [UnivLE.{v', z'}]
    [UnivLE.{max u' v' z', z'}] [UnivLE.{max v' z', z'}] :
    J.WEqualsLocallyBijective RingCat.{z'} := by
  have _ : HasLimitsOfSize.{max v' z', max u' v' z'} RingCat.{z'} :=
    hasLimitsOfSizeOfUnivLE.{z', z', max v' z', max u' v' z'} _
  exact GrothendieckTopology.WEqualsLocallyBijective.ofEssentiallySmall.{v', z', u', z' + 1, z'} J

/-! ### Sheaves of modules over the constant sheaf of integers -/

section ConstantInt

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  {R : Sheaf J RingCat.{t}}
  (α : (Functor.const Cᵒᵖ).obj (RingCat.of (ULift.{t} ℤ)) ⟶ R.obj)

/-- **An additive map of abelian sheaves is linear over the constant sheaf of integers.** If the
sheaf of rings `R` is locally generated by the constant sheaf `ℤ`, the forgetful functor from
sheaves of `R`-modules to abelian sheaves is full. -/
theorem full_toSheaf_of_constant_int [Presheaf.IsLocallySurjective J α] :
    (SheafOfModules.toSheaf.{t} R).Full := by
  constructor
  intro M N f
  let g : (PresheafOfModules.restrictScalars α).obj M.val ⟶
      (PresheafOfModules.restrictScalars α).obj N.val :=
    PresheafOfModules.homMk f.hom (by
      intro X r m
      have hr : r = (r.down : ℤ) := by cases r; rfl
      rw [hr, Int.cast_smul_eq_zsmul, Int.cast_smul_eq_zsmul]
      exact map_zsmul (f.hom.app X).hom _ _)
  exact ⟨⟨(PresheafOfModules.restrictHomEquivOfIsLocallySurjective α N.isSheaf).symm g⟩, rfl⟩

/-- The canonical action of the constant presheaf `ULift ℤ` on a presheaf of abelian groups:
scalar multiplication by an integer is iterated addition, hence commutes with the restriction
maps. -/
def intModulePresheaf (F : Cᵒᵖ ⥤ AddCommGrpCat.{t}) :
    PresheafOfModules.{t} ((Functor.const Cᵒᵖ).obj (RingCat.of (ULift.{t} ℤ))) := by
  letI : ∀ X : Cᵒᵖ, Module
      (((Functor.const Cᵒᵖ).obj (RingCat.of (ULift.{t} ℤ))).obj X) (F.obj X) :=
    fun X ↦ Module.compHom (F.obj X) ULift.ringEquiv.toRingHom
  exact PresheafOfModules.ofPresheaf F (by
    intro X Y f r m
    change F.map f (r.down • m) = r.down • F.map f m
    exact map_zsmul (F.map f).hom _ _)

/-- The underlying presheaf of abelian groups of `intModulePresheaf F` is `F`. -/
@[simp]
theorem intModulePresheaf_presheaf (F : Cᵒᵖ ⥤ AddCommGrpCat.{t}) :
    (intModulePresheaf F).presheaf = F := rfl

/-- **Every abelian sheaf is a sheaf of modules over the constant sheaf of integers.** If the
sheaf of rings `R` is locally isomorphic to the constant sheaf `ℤ`, the forgetful functor from
sheaves of `R`-modules to abelian sheaves is essentially surjective: the canonical action of the
constant presheaf `ℤ` extends uniquely along the sheafification of the scalars. -/
@[sga "3 I 3.1.3" "essential surjectivity", sga "4 IV 11.1.5" "partial"]
theorem essSurj_toSheaf_of_constant_int [Presheaf.IsLocallySurjective J α]
    [Presheaf.IsLocallyInjective J α] :
    (SheafOfModules.toSheaf.{t} R).EssSurj := by
  constructor
  intro F
  let M := intModulePresheaf F.obj
  let φ : M.presheaf ⟶ F.obj := eqToHom (intModulePresheaf_presheaf F.obj)
  have : IsIso φ := inferInstanceAs (IsIso (eqToHom _))
  exact ⟨PresheafOfModules.sheafify α (A := F) φ, ⟨Iso.refl F⟩⟩

end ConstantInt

section IntSheaf

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
  [HasSheafify J RingCat.{t}] [J.WEqualsLocallyBijective RingCat.{t}]

/-- The constant sheaf of rings with value `ℤ`. -/
abbrev intSheaf : Sheaf J RingCat.{t} :=
  (constantSheaf J RingCat.{t}).obj (RingCat.of (ULift.{t} ℤ))

/-- The sheafification unit of the constant presheaf of rings `ℤ`. -/
abbrev intSheafUnit :
    (Functor.const Cᵒᵖ).obj (RingCat.of (ULift.{t} ℤ)) ⟶ (intSheaf.{t} J).obj :=
  toSheafify J _

/-- **Sheaves of modules over the constant sheaf of rings `ℤ` are the abelian sheaves.** -/
theorem isEquivalence_toSheaf_intSheaf :
    (SheafOfModules.toSheaf.{t} (intSheaf.{t} J)).IsEquivalence := by
  have _ : Presheaf.IsLocallySurjective J (intSheafUnit.{t} J) :=
    (J.W_toSheafify _).isLocallySurjective
  have _ : Presheaf.IsLocallyInjective J (intSheafUnit.{t} J) :=
    (J.W_toSheafify _).isLocallyInjective
  have _ : (SheafOfModules.toSheaf.{t} (intSheaf.{t} J)).Full :=
    full_toSheaf_of_constant_int (intSheafUnit.{t} J)
  have _ : (SheafOfModules.toSheaf.{t} (intSheaf.{t} J)).EssSurj :=
    essSurj_toSheaf_of_constant_int (intSheafUnit.{t} J)
  exact {}

end IntSheaf

/-! ### Transport of compact generation -/

/-- An additive equivalence of abelian categories induces an equivalence of their derived
categories. -/
theorem isEquivalence_mapDerivedCategory
    {A D : Type*} [Category A] [Category D] [Abelian A] [Abelian D]
    [HasDerivedCategory A] [HasDerivedCategory D]
    (F : A ⥤ D) [F.IsEquivalence] [F.Additive] : F.mapDerivedCategory.IsEquivalence := by
  let e := F.asEquivalence
  have _ : e.functor.Additive := ‹F.Additive›
  have _ : e.inverse.Additive := e.toAdjunction.right_adjoint_additive
  let ec := e.mapHomologicalComplex (ComplexShape.up ℤ)
  exact Localization.isEquivalence DerivedCategory.Q
    (HomologicalComplex.quasiIso A (ComplexShape.up ℤ)) DerivedCategory.Q
    (HomologicalComplex.quasiIso D (ComplexShape.up ℤ))
    (e.functor.mapHomologicalComplex (ComplexShape.up ℤ) ⋙ DerivedCategory.Q)
    e.functor.mapDerivedCategory
    (e.inverse.mapHomologicalComplex (ComplexShape.up ℤ) ⋙ DerivedCategory.Q)
    e.inverse.mapDerivedCategory
    (Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ e.inverse.mapDerivedCategoryFactors ≪≫
      (Functor.associator _ _ _).symm ≪≫
      Functor.isoWhiskerRight ec.unitIso.symm _ ≪≫ Functor.leftUnitor _)
    (Functor.associator _ _ _ ≪≫
      Functor.isoWhiskerLeft _ e.functor.mapDerivedCategoryFactors ≪≫
      (Functor.associator _ _ _).symm ≪≫
      Functor.isoWhiskerRight ec.counitIso _ ≪≫ Functor.leftUnitor _)

/-- Compact generation transports along an additive equivalence commuting with the shift: the
images of a compactly generating family are compact, and an object receiving only zero maps
from their shifts has a zero preimage. -/
theorem isCompactlyGenerated_of_equivalence
    {A D : Type*} [Category A] [Category D] [Preadditive A] [Preadditive D]
    [HasShift A ℤ] [HasShift D ℤ] (F : A ⥤ D)
    [F.IsEquivalence] [F.Additive] [F.CommShift ℤ]
    (h : Pretriangulated.IsCompactlyGenerated.{w} A) :
    Pretriangulated.IsCompactlyGenerated.{w} D := by
  obtain ⟨ι, E, hc, hg⟩ := h
  refine ⟨ι, fun i ↦ F.obj (E i), fun i ↦
    (isCompactObject_iff_isCompactObject_obj F (E i)).mp (hc i), ?_⟩
  intro K hK
  have hz : IsZero (F.objPreimage K) := by
    apply hg
    intro X f hX
    obtain ⟨Y, n, e, ⟨i⟩⟩ := hX
    have hFX : (ObjectProperty.ofObj (fun i ↦ F.obj (E i))).shiftClosure ℤ (F.obj X) :=
      ⟨F.obj (E i), n, F.mapIso e ≪≫ (F.commShiftIso n).app (E i), ⟨i⟩⟩
    apply F.map_injective
    rw [F.map_zero, ← cancel_mono (F.objObjPreimageIso K).hom, zero_comp]
    exact hK _ hFX
  exact (F.map_isZero hz).of_iso (F.objObjPreimageIso K).symm

/-- **Compact generation of the derived category of abelian sheaves on a site with enough
quasi-compact weakly contractible objects.** Let `P` be a property of objects of a site
`(C, J)` such that every object is covered by objects with `P`, every object with `P` is
quasi-compact, and over every object with `P` a locally surjective morphism of sheaves of sets
valued in the universe of the sections is surjective on sections. Then the unbounded derived
category of abelian sheaves is compactly generated.

Abelian sheaves are the sheaves of modules over the constant sheaf of rings `ℤ`
(`isEquivalence_toSheaf_intSheaf`), so this is
`isCompactlyGenerated_derivedCategory_of_hasEnoughObjects` for that sheaf of rings, transported
along the induced equivalence of derived categories. -/
theorem isCompactlyGenerated_derivedCategory_abelianSheaves_of_hasEnoughObjects
    {C : Type u} [Category.{v} C] (J : GrothendieckTopology C)
    [HasSheafify J AddCommGrpCat.{max u v w}]
    [J.WEqualsLocallyBijective AddCommGrpCat.{max u v w}]
    [HasSheafify J RingCat.{max u v w}]
    [J.WEqualsLocallyBijective RingCat.{max u v w}]
    (P : ObjectProperty C)
    (hqc : ∀ U : C, P U → J.IsQuasiCompactObject U)
    (hwc : ∀ U : C, P U → ∀ (F G : Sheaf J (Type (max u v w))) (φ : F ⟶ G),
      Sheaf.IsLocallySurjective φ → Function.Surjective (φ.hom.app (op U)))
    (hEnough : ∀ T : C, ∃ (I : Type s) (V : I → C) (p : (i : I) → V i ⟶ T),
      Sieve.ofArrows V p ∈ J T ∧ ∀ i, P (V i)) :
    Pretriangulated.IsCompactlyGenerated.{max u v w}
      (DerivedCategory (Sheaf J AddCommGrpCat.{max u v w})) := by
  have _ := isEquivalence_toSheaf_intSheaf.{max u v w} J
  have _ := isEquivalence_mapDerivedCategory
    (SheafOfModules.toSheaf.{max u v w} (intSheaf.{max u v w} J))
  exact isCompactlyGenerated_of_equivalence
    (SheafOfModules.toSheaf.{max u v w} (intSheaf.{max u v w} J)).mapDerivedCategory
    (isCompactlyGenerated_derivedCategory_of_hasEnoughObjects J (intSheaf.{max u v w} J)
      P hqc hwc hEnough)

end Stacks.Cohomology

end
