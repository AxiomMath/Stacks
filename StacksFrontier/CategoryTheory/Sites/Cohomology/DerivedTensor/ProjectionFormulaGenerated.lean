module

public import StacksFrontier.CategoryTheory.Sites.Cohomology.DerivedTensor.ProjectionFormulaCoproducts

/-!
# The projection formula on ringed topoi when the base is generated by its structure sheaf

Let `f : (Sh(C), 𝒪_C) ⟶ (Sh(D), 𝒪_D)` be a morphism of ringed topoi presented by a morphism of
sites. Suppose that a property of objects of `D(𝒪_D)` which is invariant under isomorphism and
shifts, stable under direct sums and two-out-of-three in distinguished triangles, and true for the
shifts of `𝒪_D`, holds for every object (for `D(R)` this is [Stacks, Tag 09PB]). Let `Q ⊆ D(𝒪_C)`
be a triangulated subcategory, closed under isomorphisms and direct sums, on whose families `Rf_*`
commutes with direct sums. Then for `E ∈ Q` the projection-formula map of [Stacks, Tag 0B56]

  `Rf_*E ⊗^L K ⟶ Rf_*(E ⊗^L Lf^*K)`

is an isomorphism for every `K ∈ D(𝒪_D)`. This is the argument of [Stacks, Tag 08IN], with `Q`
the objects with quasi-coherent cohomology and the commutation with sums [Stacks, Tag 08FB].

## Main results

* `Stacks.Cohomology.ProjectionFormulaGenerated.isIso_projectionFormulaMap_of_generatedOn`: the
  same for `K` in a property `P` of `D(𝒪_D)` on which the generation holds (for an affine base,
  the objects with quasi-coherent cohomology).
* `Stacks.Cohomology.ProjectionFormulaGenerated.isIso_projectionFormulaMap_of_generated`.

## References

* [Stacks Project, Tag 08IN](https://stacks.math.columbia.edu/tag/08IN)
* [Stacks Project, Tag 09PB](https://stacks.math.columbia.edu/tag/09PB)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open Stacks.Cohomology.DerivedPullbackPushforwardAdjunction
open Stacks.DerivedTensor.RingedSite
open Stacks.CategoryTheory.ComponentwiseInvertibility

namespace Stacks.Cohomology.ProjectionFormulaGenerated

universe u

attribute [local instance] HasDerivedCategory.standard

/-- A natural transformation between exact functors, invertible at every shift of the first two
vertices of a distinguished triangle, is invertible at every shift of the third. -/
theorem isIso_app_third_of_all_shifts {𝒞 𝒟 : Type*} [Category* 𝒞] [Category* 𝒟]
    [HasShift 𝒞 ℤ] [HasShift 𝒟 ℤ] [Preadditive 𝒞] [Preadditive 𝒟]
    [HasZeroObject 𝒞] [HasZeroObject 𝒟]
    [∀ n : ℤ, (shiftFunctor 𝒞 n).Additive] [∀ n : ℤ, (shiftFunctor 𝒟 n).Additive]
    [Pretriangulated 𝒞] [Pretriangulated 𝒟]
    (F G : 𝒞 ⥤ 𝒟) [F.CommShift ℤ] [G.CommShift ℤ] [F.IsTriangulated] [G.IsTriangulated]
    (α : F ⟶ G) (T : Triangle 𝒞) (hT : T ∈ distTriang 𝒞)
    (h₁ : ∀ n : ℤ, IsIso (α.app (T.obj₁⟦n⟧)))
    (h₂ : ∀ n : ℤ, IsIso (α.app (T.obj₂⟦n⟧))) :
    ∀ n : ℤ, IsIso (α.app (T.obj₃⟦n⟧)) := fun n =>
  isIso_app_third_of_distinguished F G α _ (T.shift_distinguished hT n) (h₁ n) (h₂ n)
    ((α.isIso_app_iff_of_iso ((shiftFunctorAdd 𝒞 n 1).app T.obj₁)).1 (h₁ (n + 1)))
    ((α.isIso_app_iff_of_iso ((shiftFunctorAdd 𝒞 n 1).app T.obj₂)).1 (h₂ (n + 1)))

variable {X Y : RingedTopos.{u, u, u}}
  [X.J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
  [Y.J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
  [HasSheafify X.J AddCommGrpCat.{u}] [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [HasSheafify Y.J AddCommGrpCat.{u}] [Y.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [(Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).Additive]
  [∀ M, ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).obj M).Additive]
  [(Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} Y.O).Additive]
  [∀ M, ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} Y.O).obj M).Additive]
  [∀ (A B : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ),
    HomologicalComplex.HasMapBifunctor A B
      (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O) (ComplexShape.up ℤ)]
  [∀ (A B : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)) ℤ),
    HomologicalComplex.HasMapBifunctor A B
      (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} Y.O) (ComplexShape.up ℤ)]
  (f : RingedToposSiteHom X Y)
  [(pullbackOnHomotopy f).HasLeftDerivedFunctor
    (HomotopyCategory.quasiIso
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)) (ComplexShape.up ℤ))]
  (hmos : f.u.IsMorphismOfSites Y.J X.J)

/-- **The projection formula on the objects of a property generated by the structure sheaf** (the
argument of [Stacks, Tag 08IN], with `P` the objects with quasi-coherent cohomology over an affine
base). Let `Q ⊆ D(𝒪_C)` be a triangulated subcategory closed under isomorphisms and
direct sums such that `Rf_*` commutes with direct sums of `Q`-families, and suppose that every
property of objects of `D(𝒪_D)` invariant under isomorphisms and shifts, stable under direct sums
and two-out-of-three in distinguished triangles and true for the shifts of `𝒪_D`, holds on `P`
(`hgen`). Then `Rf_*E ⊗^L K ⟶ Rf_*(E ⊗^L Lf^*K)` is an isomorphism for every `E ∈ Q` and every
`K ∈ P`. -/
theorem isIso_projectionFormulaMap_of_generatedOn
    [HasCoproducts.{u} (DerivedCategory
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))]
    [HasCoproducts.{u} (DerivedCategory
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)))]
    (Q : ObjectProperty (DerivedCategory
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    [Q.IsClosedUnderIsomorphisms] [Q.IsTriangulated]
    (hQsum : ∀ {J : Type u} (L : J → DerivedCategory
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))),
      (∀ j, Q (L j)) → Q (∐ L))
    (hRf : ∀ {J : Type u} (L : J → DerivedCategory
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))),
      (∀ j, Q (L j)) → PreservesColimit (Discrete.functor L) (derivedPushforward f))
    (P : ObjectProperty (DerivedCategory
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O))))
    (hgen : ∀ T : DerivedCategory
        (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)) → Prop,
      (∀ {K K'}, (K ≅ K') → T K → T K') → (∀ K (n : ℤ), T K → T (K⟦n⟧)) →
      (∀ {J : Type u} (K : J → DerivedCategory
        (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O))),
        (∀ j, T (K j)) → T (∐ K)) →
      (∀ Δ ∈ distTriang (DerivedCategory
          (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O))),
        (T Δ.obj₁ → T Δ.obj₂ → T Δ.obj₃) ∧ (T Δ.obj₁ → T Δ.obj₃ → T Δ.obj₂)) →
      (∀ k : ℤ, T ((unitObject ⟨Y.C, Y.J, Y.O⟩)⟦k⟧)) → ∀ K, P K → T K)
    (E : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (hE : Q E)
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)))
    (hK : P K) :
    IsIso (ProjectionFormulaOnRingedTopoi.projectionFormulaMap f hmos E K) := by
  let := DerivedPullbackOnRingedTopoi.derivedPullbackCommShift f hmos
  have := DerivedPullbackOnRingedTopoi.derivedPullback_isTriangulated_of_isMorphismOfSites f hmos
  let : (derivedPushforward f).CommShift ℤ :=
    (DerivedPullbackOnRingedTopoi.derivedAdjunction f hmos).rightAdjointCommShift ℤ
  let : (DerivedPullbackOnRingedTopoi.derivedAdjunction f hmos).CommShift ℤ :=
    (DerivedPullbackOnRingedTopoi.derivedAdjunction f hmos).commShift_of_leftAdjoint ℤ
  have : (derivedPushforward f).IsTriangulated :=
    (DerivedPullbackOnRingedTopoi.derivedAdjunction f hmos).isTriangulated_rightAdjoint
  let : ((derivedTensorProductFunctor X.O).obj E).CommShift ℤ :=
    (canonicalDerivedTensorProduct X.O).commShift_right _
  have : ((derivedTensorProductFunctor X.O).obj E).IsTriangulated :=
    (canonicalDerivedTensorProduct X.O).exact_right _
  let : ((derivedTensorProductFunctor Y.O).obj ((derivedPushforward f).obj E)).CommShift ℤ :=
    (canonicalDerivedTensorProduct Y.O).commShift_right _
  have : ((derivedTensorProductFunctor Y.O).obj ((derivedPushforward f).obj E)).IsTriangulated :=
    (canonicalDerivedTensorProduct Y.O).exact_right _
  let G₀ := derivedPullback f ⋙ (derivedTensorProductFunctor X.O).obj E
  let α : (derivedTensorProductFunctor Y.O).obj ((derivedPushforward f).obj E) ⟶
      G₀ ⋙ derivedPushforward f :=
    { app := ProjectionFormulaOnRingedTopoi.projectionFormulaMap f hmos E
      naturality := fun _ _ k =>
        ProjectionFormulaOnRingedTopoi.projectionFormulaMap_naturality_target f hmos E k }
  have hG₀ : PreservesColimitsOfSize.{u, u} G₀ := by
    have : PreservesColimitsOfSize.{u, u} (derivedPullback f) :=
      (DerivedPullbackOnRingedTopoi.derivedAdjunction f hmos).leftAdjoint_preservesColimits
    have := ProjectionFormulaCoproducts.preservesColimitsOfSize_tensor_obj ⟨X.C, X.J, X.O⟩ E
    infer_instance
  have hQshift : ∀ (A) (n : ℤ), Q A → Q (A⟦n⟧) := fun A n hA => Q.le_shift n A hA
  -- the property to propagate
  let T : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)) →
      Prop := fun K => (∀ n : ℤ, IsIso (α.app (K⟦n⟧))) ∧ Q (G₀.obj K)
  have hTshift : ∀ K (m : ℤ), T K → T (K⟦m⟧) := by
    intro K m hK
    refine ⟨fun n => (α.isIso_app_iff_of_iso ((shiftFunctorAdd _ m n).app K)).1 (hK.1 (m + n)),
      Q.prop_of_iso ((G₀.commShiftIso m).app K).symm (hQshift _ m hK.2)⟩
  have hiso : ∀ {K K'}, (K ≅ K') → T K → T K' := by
    intro K K' e hK
    exact ⟨fun n => (α.isIso_app_iff_of_iso ((shiftFunctor _ n).mapIso e)).1 (hK.1 n),
      Q.prop_of_iso (G₀.mapIso e) hK.2⟩
  have hsum : ∀ {J : Type u} (K : J → DerivedCategory
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O))),
      (∀ j, T (K j)) → T (∐ K) := by
    intro J K hK
    have hGsum : Q (G₀.obj (∐ K)) :=
      Q.prop_of_iso (asIso (sigmaComparison G₀ K)) (hQsum _ fun j => (hK j).2)
    refine ⟨fun n => ?_, hGsum⟩
    let L := fun j => (K j)⟦n⟧
    have hL : ∀ j, T (L j) := fun j => hTshift _ n (hK j)
    have : PreservesColimit (Discrete.functor fun j =>
        ((derivedTensorProductFunctor X.O).obj E).obj ((derivedPullback f).obj (L j)))
        (derivedPushforward f) := hRf _ fun j => (hL j).2
    exact (α.isIso_app_iff_of_iso (asIso (sigmaComparison (shiftFunctor _ n) K))).1 <|
      ProjectionFormulaCoproducts.isIso_projectionFormulaMap_sigma f hmos E L fun j =>
        (α.isIso_app_iff_of_iso ((shiftFunctorZero _ ℤ).app (L j))).1 ((hL j).1 0)
  have htri : ∀ Δ ∈ distTriang (DerivedCategory
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O))),
      (T Δ.obj₁ → T Δ.obj₂ → T Δ.obj₃) ∧ (T Δ.obj₁ → T Δ.obj₃ → T Δ.obj₂) := by
    intro Δ hΔ
    have hΔ' := G₀.map_distinguished Δ hΔ
    refine ⟨fun h₁ h₂ => ⟨isIso_app_third_of_all_shifts _ _ α Δ hΔ h₁.1 h₂.1,
        Q.ext_of_isTriangulatedClosed₃ _ hΔ' h₁.2 h₂.2⟩,
      fun h₁ h₃ => ⟨isIso_app_middle_of_all_shifts _ _ α Δ hΔ h₁.1 h₃.1,
        Q.ext_of_isTriangulatedClosed₂ _ hΔ' h₁.2 h₃.2⟩⟩
  have hunit : ∀ k : ℤ, T ((unitObject ⟨Y.C, Y.J, Y.O⟩)⟦k⟧) := by
    intro k
    refine ⟨fun n => ProjectionFormulaUnitInvertible.isIso_projectionFormulaMap_of_iso_shift_unit
      f hmos E (k + n) ((shiftFunctorAdd _ k n).app _).symm, ?_⟩
    let e : E ≅ G₀.obj (unitObject ⟨Y.C, Y.J, Y.O⟩) :=
      (((canonicalDerivedTensorProduct X.O).rightUnitorNatIso ⟨X.C, X.J, X.O⟩).app E).symm ≪≫
        ((derivedTensorProductFunctor X.O).obj E).mapIso
          (Stacks.Sheaves.DerivedPullback.derivedPullbackUnitIso f hmos).symm
    exact Q.prop_of_iso ((shiftFunctor _ k).mapIso e ≪≫ ((G₀.commShiftIso k).app _).symm)
      (hQshift E k hE)
  exact (α.isIso_app_iff_of_iso ((shiftFunctorZero _ ℤ).app K)).1
    ((hgen T hiso hTshift hsum htri hunit K hK).1 0)

/-- **The projection formula when the base is generated by its structure sheaf** (the argument of
[Stacks, Tag 08IN]). Let `Q ⊆ D(𝒪_C)` be a triangulated subcategory closed under isomorphisms and
direct sums such that `Rf_*` commutes with direct sums of `Q`-families, and suppose `D(𝒪_D)` is
generated by the shifts of `𝒪_D` under isomorphisms, shifts, direct sums and distinguished
triangles (`hgen`). Then `Rf_*E ⊗^L K ⟶ Rf_*(E ⊗^L Lf^*K)` is an isomorphism for every `E ∈ Q` and
every `K ∈ D(𝒪_D)`. -/
theorem isIso_projectionFormulaMap_of_generated
    [HasCoproducts.{u} (DerivedCategory
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))]
    [HasCoproducts.{u} (DerivedCategory
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)))]
    (Q : ObjectProperty (DerivedCategory
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    [Q.IsClosedUnderIsomorphisms] [Q.IsTriangulated]
    (hQsum : ∀ {J : Type u} (L : J → DerivedCategory
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))),
      (∀ j, Q (L j)) → Q (∐ L))
    (hRf : ∀ {J : Type u} (L : J → DerivedCategory
      (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))),
      (∀ j, Q (L j)) → PreservesColimit (Discrete.functor L) (derivedPushforward f))
    (hgen : ∀ T : DerivedCategory
        (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O)) → Prop,
      (∀ {K K'}, (K ≅ K') → T K → T K') → (∀ K (n : ℤ), T K → T (K⟦n⟧)) →
      (∀ {J : Type u} (K : J → DerivedCategory
        (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O))),
        (∀ j, T (K j)) → T (∐ K)) →
      (∀ Δ ∈ distTriang (DerivedCategory
          (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O))),
        (T Δ.obj₁ → T Δ.obj₂ → T Δ.obj₃) ∧ (T Δ.obj₁ → T Δ.obj₃ → T Δ.obj₂)) →
      (∀ k : ℤ, T ((unitObject ⟨Y.C, Y.J, Y.O⟩)⟦k⟧)) → ∀ K, T K)
    (E : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (hE : Q E)
    (K : DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Y.O))) :
    IsIso (ProjectionFormulaOnRingedTopoi.projectionFormulaMap f hmos E K) :=
  isIso_projectionFormulaMap_of_generatedOn f hmos Q hQsum hRf ⊤
    (fun T h₁ h₂ h₃ h₄ h₅ K _ => hgen T h₁ h₂ h₃ h₄ h₅ K) E hE K trivial

end Stacks.Cohomology.ProjectionFormulaGenerated

end
