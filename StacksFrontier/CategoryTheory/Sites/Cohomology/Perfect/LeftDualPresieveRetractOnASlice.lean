  have aux : ∀ {E : Type _} [Category E] {P Q R : E} (x : P ⟶ Q) (μ : Q ⟶ R) (δ : R ⟶ Q)
      (c : P ⟶ R), μ ≫ δ = 𝟙 Q → x ≫ μ = c → x = c ≫ δ := by
    intro E _ P Q R x μ δ c h1 h2
    rw [← h2, Category.assoc, h1, Category.comp_id]
  refine aux _ _ _ _ (Functor.Monoidal.μ_δ
    ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)) Mc Nc) ?_
  refine HomologicalComplex.from_single_hom_ext ?_
  have hL : (Stacks.Sites.ExtensionByZero.unitHomEquivOfTerminal (X.J.over W)
        ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W) (Over.mk (𝟙 W)) Over.mkIdTerminal
        _).symm y₀ ≫
      (j ▷ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc).f 0 ≫
      (Functor.LaxMonoidal.μ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ))
        Mc Nc).f 0 =
      SheafOfModules.unitHomOver (Stacks.SheafOfModules.Tensor.ringSheaf X.O)
        ((Mc ⊗ Nc : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O).X 0) W t := by
