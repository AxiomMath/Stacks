    (restriction X W).mapDerivedCategory M N
    (((restriction X W).mapDerivedCategoryFactors.app Mc).symm.trans
      ((restriction X W).mapDerivedCategory.mapIso eM))
    (((restriction X W).mapDerivedCategoryFactors.app Nc).symm.trans
      ((restriction X W).mapDerivedCategory.mapIso eN))
