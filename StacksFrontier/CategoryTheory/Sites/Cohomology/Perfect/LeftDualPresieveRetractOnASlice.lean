      Stacks.SheafOfModules.DerivedMonoidal.Complexes (X.O.over W)).X 0).val.obj
        (op (Over.mk (𝟙 W))))
    (hy₀ : ((K ⊗ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc :
