  [∀ W : X.C, (X.J.over W).WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- **The tensorator of restriction to a slice, for the tensor product `sheafTensor`, is that of
the monoidal structure of Tag 01CA.** The two structures are conjugate by identity functors whose
tensorators are identities. -/
theorem mu_sheafRestrictionMonoidal (W : X.C)
    (A B : Stacks.SheafOfModules.DerivedMonoidal.Mod X.O) :
    letI := Stacks.Cohomology.DerivedRestriction.sheafRestrictionMonoidal X W
    Functor.LaxMonoidal.μ (restriction X W) A B =
      Functor.LaxMonoidal.μ (self := (Stacks.SheafOfModules.SliceRestriction.overFunctorMonoidal
          X.O.obj (Stacks.SheafOfModules.Strict.isSheaf_ringSheaf X.O) W).toLaxMonoidal)
        (Stacks.SheafOfModules.SliceRestriction.overFunctor X.O.obj
          (Stacks.SheafOfModules.Strict.isSheaf_ringSheaf X.O) W) A B := by
  let := Stacks.Cohomology.DerivedRestriction.sheafRestrictionMonoidal X W
  have h : Functor.LaxMonoidal.μ (restriction X W) A B =
      Functor.LaxMonoidal.μ
          (self := (SheafOfModules.idMonoidalStrictToSheafTensor (X.O.over W)).toLaxMonoidal)
          (𝟭 _) _ _ ≫
        Functor.LaxMonoidal.μ (self := (Stacks.SheafOfModules.SliceRestriction.overFunctorMonoidal
            X.O.obj (Stacks.SheafOfModules.Strict.isSheaf_ringSheaf X.O) W).toLaxMonoidal)
          (Stacks.SheafOfModules.SliceRestriction.overFunctor X.O.obj
            (Stacks.SheafOfModules.Strict.isSheaf_ringSheaf X.O) W) A B ≫
        (Stacks.SheafOfModules.SliceRestriction.overFunctor X.O.obj
            (Stacks.SheafOfModules.Strict.isSheaf_ringSheaf X.O) W).map
          (Functor.LaxMonoidal.μ
            (self := (SheafOfModules.idMonoidalSheafTensorToStrict X.O).toLaxMonoidal)
            (𝟭 _) A B) := rfl
  have h1 : Functor.LaxMonoidal.μ
      (self := (SheafOfModules.idMonoidalSheafTensorToStrict X.O).toLaxMonoidal) (𝟭 _) A B =
        𝟙 _ :=
    (show Functor.LaxMonoidal.μ
      (self := (SheafOfModules.idMonoidalSheafTensorToStrict X.O).toLaxMonoidal) (𝟭 _) A B =
        @MonoidalCategoryStruct.tensorHom _ _
          (SheafOfModules.monoidalCategorySheafTensor X.O).toMonoidalCategoryStruct _ _ _ _
          (𝟙 A) (𝟙 B) from rfl).trans
      (@MonoidalCategory.id_tensorHom_id _ _ (SheafOfModules.monoidalCategorySheafTensor X.O) A B)
  rw [h, h1]
  exact (Category.id_comp _).trans ((congrArg (fun f => _ ≫ f)
    ((Stacks.SheafOfModules.SliceRestriction.overFunctor X.O.obj
      (Stacks.SheafOfModules.Strict.isSheaf_ringSheaf X.O) W).map_id _)).trans (Category.comp_id _))


/-- **The tensorator of restriction to a slice, on a local pure tensor.** It carries the
sheafification unit image of `a ⊗ b`, formed on the slice site over `W`, to the one formed on `C`
over the underlying object. -/
theorem mu_sheafRestrictionMonoidal_unit_tmul (W : X.C)
    (A B : Stacks.SheafOfModules.DerivedMonoidal.Mod X.O) (V : (Over W)ᵒᵖ)
    (a : A.val.obj (op V.unop.left)) (b : B.val.obj (op V.unop.left)) :
    letI := Stacks.Cohomology.DerivedRestriction.sheafRestrictionMonoidal X W
    (Functor.LaxMonoidal.μ (restriction X W) A B).val.app V
        (((PresheafOfModules.sheafificationAdjunction
            (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf (X.O.over W)).obj)).unit.app
          (((restriction X W).obj A).val ⊗ ((restriction X W).obj B).val)).app V (a ⊗ₜ b)) =
      ((PresheafOfModules.sheafificationAdjunction
          (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf X.O).obj)).unit.app
        (A.val ⊗ B.val)).app (op V.unop.left) (a ⊗ₜ b) := by
  rw [mu_sheafRestrictionMonoidal]
  exact Stacks.SliceRestrictionTensorSections.mu_overFunctorMonoidal_shSec_tmul X.O.obj
    (Stacks.SheafOfModules.Strict.isSheaf_ringSheaf X.O) W A B V a b


/-- **The tensorator of restriction of complexes to a slice, on a local pure tensor.** It carries
the local pure tensor `a ⊗ b` of two sections over an object `V` of the slice site over `W`,
formed in the total tensor complex of the restrictions, to the local pure tensor formed in the
total tensor complex on `C`. -/
theorem mu_restriction_ιTensorObj_unit_tmul (W : X.C)
    (A B : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O) (t r c : ℤ)
    (htr : t + r = c) (V : Over W) (a : (A.X t).val.obj (op V.left))
    (b : (B.X r).val.obj (op V.left)) :
    letI := Stacks.Cohomology.DerivedRestriction.sheafRestrictionMonoidal X W
    ((Functor.LaxMonoidal.μ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ))
        A B).f c).val.app (op V)
        ((HomologicalComplex.ιTensorObj
            (((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj A)
            (((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj B)
            t r c htr).val.app (op V)
          (((PresheafOfModules.sheafificationAdjunction
              (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf (X.O.over W)).obj)).unit.app
            (((restriction X W).obj (A.X t)).val ⊗ ((restriction X W).obj (B.X r)).val)).app
              (op V) (a ⊗ₜ b))) =
      (HomologicalComplex.ιTensorObj A B t r c htr).val.app (op V.left)
        (((PresheafOfModules.sheafificationAdjunction
            (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf X.O).obj)).unit.app
          ((A.X t).val ⊗ (B.X r).val)).app (op V.left) (a ⊗ₜ b)) := by
  let := Stacks.Cohomology.DerivedRestriction.sheafRestrictionMonoidal X W
  have hι := Functor.ι_mapHomologicalComplexTensorator_hom (restriction X W) A B t r c htr
  have hμ := mu_sheafRestrictionMonoidal_unit_tmul X W (A.X t) (B.X r) (op V) a b
  exact (congrArg (fun φ => φ.val.app (op V)
      (((PresheafOfModules.sheafificationAdjunction
            (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf (X.O.over W)).obj)).unit.app
          (((restriction X W).obj (A.X t)).val ⊗ ((restriction X W).obj (B.X r)).val)).app
        (op V) (a ⊗ₜ b))) hι).trans
    (congrArg (fun z => ((restriction X W).map
      (HomologicalComplex.ιTensorObj A B t r c htr)).val.app (op V) z) hμ)


/-- **The coevaluation of a left dual, restricted to a slice, through the restricted
representatives.** Let `η` be the coevaluation of `M ⊣ N`, represented over `W` by the cocycle
section `t` of `Tot(M^• ⊗ N^•)`. Then the coevaluation of the restricted pairing on `D(O|_W)` is
the morphism `O|_W ⟶ Tot(M^•|_W ⊗ N^•|_W)` attached to `t`, read through the K-flat comparison on
the slice. This is where the tensorator of derived restriction is computed, by
`CategoryTheory.Functor.mapDerivedCategoryMonoidal_μ_Q`. -/
theorem restriction_coevaluation_eq (W : X.C)
    (M N : Stacks.SheafOfModules.DerivedMonoidal.DerivedModules X.O)
    (pair : letI := derivedMonoidal X.O; ExactPairing M N)
    (Mc Nc : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O)
    (eM : DerivedCategory.Q.obj Mc ≅ M) (eN : DerivedCategory.Q.obj Nc ≅ N)
    (hM : Stacks.SheafOfModules.DerivedMonoidal.KFlat X.O Mc)
    (hN : Stacks.SheafOfModules.DerivedMonoidal.KFlat X.O Nc)
    (t : (((Mc ⊗ Nc : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O)).X 0).val.obj (op W))
    (ht : (((Mc ⊗ Nc : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O)).d 0 1).val.app
      (op W) t = 0)
    (hβ : (restriction X W).mapDerivedCategory.map (coevaluationUnitHom X Mc Nc hM hN
          (letI := derivedMonoidal X.O; letI := pair; η_ M N ≫ (eM.inv ⊗ₘ eN.inv))) ≫
        (restriction X W).mapDerivedCategoryFactors.hom.app
          (Mc ⊗ Nc : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O) =
      (restriction X W).mapDerivedCategoryFactors.hom.app (structureSheafComplex X) ≫
        DerivedCategory.Q.map
          ((SheafOfModules.overFunctorUnitComplexIso
              (Stacks.SheafOfModules.Tensor.ringSheaf X.O) W).hom ≫
            SheafOfModules.cocycleHomOver (Stacks.SheafOfModules.Tensor.ringSheaf X.O)
              (Mc ⊗ Nc : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O) W t ht)) :
    letI := derivedMonoidal X.O
    letI := derivedMonoidal (X.O.over W)
    letI := pair
    letI := Stacks.Cohomology.DerivedRestriction.sheafRestrictionMonoidal X W
    letI := Stacks.Cohomology.DerivedRestriction.mapDerivedCategoryMonoidal X W
    (Functor.LaxMonoidal.ε (restriction X W).mapDerivedCategory ≫
        (restriction X W).mapDerivedCategory.map (symmetricMonoidalDerived X.O).unitIso.hom ≫
        (restriction X W).mapDerivedCategoryFactors.hom.app (structureSheafComplex X) ≫
        DerivedCategory.Q.map
          ((SheafOfModules.overFunctorUnitComplexIso
              (Stacks.SheafOfModules.Tensor.ringSheaf X.O) W).hom ≫
            SheafOfModules.cocycleHomOver (Stacks.SheafOfModules.Tensor.ringSheaf X.O)
              (Mc ⊗ Nc : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O) W t ht)) ≫
      DerivedCategory.Q.map (Functor.OplaxMonoidal.δ
        ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)) Mc Nc) ≫
      ((symmetricMonoidalDerived (X.O.over W)).comparison _ _
        (Stacks.Cohomology.DerivedRestriction.kFlat_restriction X W Mc hM)
        (Stacks.Cohomology.DerivedRestriction.kFlat_restriction X W Nc hN)).inv ≫
      (((restriction X W).mapDerivedCategoryFactors.inv.app Mc ≫
          (restriction X W).mapDerivedCategory.map eM.hom) ⊗ₘ
        ((restriction X W).mapDerivedCategoryFactors.inv.app Nc ≫
          (restriction X W).mapDerivedCategory.map eN.hom)) =
      Functor.LaxMonoidal.ε (restriction X W).mapDerivedCategory ≫
        (restriction X W).mapDerivedCategory.map (η_ M N) ≫
        Functor.OplaxMonoidal.δ (restriction X W).mapDerivedCategory M N := by
  let := derivedMonoidal X.O
  let := derivedMonoidal (X.O.over W)
  let := pair
  let := Stacks.Cohomology.DerivedRestriction.sheafRestrictionMonoidal X W
  let := Stacks.Cohomology.DerivedRestriction.mapDerivedCategoryMonoidal X W
  -- the tensorator of derived restriction at the two K-flat representatives
  have hA := Functor.mapDerivedCategoryMonoidal_μ_Q (restriction X W)
    (Stacks.Cohomology.DerivedRestriction.kFlat_restriction X W)
    (Stacks.SheafOfModules.DerivedMonoidal.exists_kFlat_resolution X.O)
    (Stacks.SheafOfModules.DerivedMonoidal.exists_kFlat_resolution (X.O.over W)) hM hN
  have hδ : (restriction X W).mapDerivedCategory.map
        ((symmetricMonoidalDerived X.O).comparison Mc Nc hM hN).hom ≫
      (restriction X W).mapDerivedCategoryFactors.hom.app (Mc ⊗ Nc : Complexes X.O) ≫
      DerivedCategory.Q.map (Functor.OplaxMonoidal.δ
        ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)) Mc Nc) ≫
      ((symmetricMonoidalDerived (X.O.over W)).comparison _ _
        (Stacks.Cohomology.DerivedRestriction.kFlat_restriction X W Mc hM)
        (Stacks.Cohomology.DerivedRestriction.kFlat_restriction X W Nc hN)).inv =
      Functor.OplaxMonoidal.δ (restriction X W).mapDerivedCategory
          (DerivedCategory.Q.obj Mc) (DerivedCategory.Q.obj Nc) ≫
        ((restriction X W).mapDerivedCategoryFactors.hom.app Mc ⊗ₘ
          (restriction X W).mapDerivedCategoryFactors.hom.app Nc) := by
    have aux : ∀ {E : Type _} [Category E] {P R S T U V : E} (μ : P ⟶ R) (δ : R ⟶ P)
        (a : R ⟶ S) (b : S ⟶ T) (x : T ⟶ U) (y : U ⟶ V) (k : P ⟶ V) (z : V ⟶ U) (w : U ⟶ T),
        δ ≫ μ = 𝟙 R → μ ≫ a ≫ b = k ≫ z ≫ w → w ≫ x = 𝟙 U → z ≫ y = 𝟙 V →
          a ≫ b ≫ x ≫ y = δ ≫ k := by
      intro E _ P R S T U V μ δ a b x y k z w hδμ h hwx hzy
      rw [← Category.id_comp (a ≫ b ≫ x ≫ y), ← hδμ, Category.assoc, ← Category.assoc μ,
        ← Category.assoc (μ ≫ a), Category.assoc μ, h]
      simp only [Category.assoc]
      rw [reassoc_of% hwx, hzy, Category.comp_id]
    refine aux _ _ _ _ _ _ _ _ _
      (Functor.Monoidal.δ_μ (restriction X W).mapDerivedCategory _ _) hA ?_ (Iso.hom_inv_id _)
    exact (DerivedCategory.Q.map_comp _ _).symm.trans
      ((congrArg DerivedCategory.Q.map (Functor.Monoidal.μ_δ _ _ _)).trans
        (DerivedCategory.Q.map_id _))
  have aux : ∀ {E : Type _} [Category E] {Z₀ Z₁ Z₂ Z₃ Z₄ Z₅ Z₆ Z₇ Z₈ Z₉ Z₁₀ Z₁₁ : E}
      (ε : Z₀ ⟶ Z₁) (u' : Z₁ ⟶ Z₂) (f : Z₂ ⟶ Z₃) (g : Z₃ ⟶ Z₄) (q : Z₄ ⟶ Z₅) (w : Z₅ ⟶ Z₆)
      (T : Z₆ ⟶ Z₇) (u : Z₂ ⟶ Z₁) (η' : Z₁ ⟶ Z₈) (e : Z₈ ⟶ Z₉) (c : Z₉ ⟶ Z₁₀) (fac : Z₁₀ ⟶ Z₄)
      (δ₀ : Z₉ ⟶ Z₁₁) (P : Z₁₁ ⟶ Z₆) (A : Z₁₁ ⟶ Z₇) (δ : Z₈ ⟶ Z₇) (B : Z₇ ⟶ Z₁₁),
      f ≫ g = u ≫ η' ≫ e ≫ c ≫ fac → u' ≫ u = 𝟙 _ → c ≫ fac ≫ q ≫ w = δ₀ ≫ P →
      P ≫ T = A → e ≫ δ₀ = δ ≫ B → B ≫ A = 𝟙 _ →
        (ε ≫ u' ≫ f ≫ g) ≫ q ≫ w ≫ T = ε ≫ η' ≫ δ := by
    intro E _ Z₀ Z₁ Z₂ Z₃ Z₄ Z₅ Z₆ Z₇ Z₈ Z₉ Z₁₀ Z₁₁ ε u' f g q w T u η' e c fac δ₀ P A δ B
      h1 h2 h3 h4 h5 h6
    simp only [Category.assoc]
    rw [reassoc_of% h1, reassoc_of% h2, reassoc_of% h3, h4, reassoc_of% h5, h6,
      Category.comp_id]
  refine aux _ _ _ _ _ _ _
    ((restriction X W).mapDerivedCategory.map (symmetricMonoidalDerived X.O).unitIso.inv) _ _ _ _ _
    _ (((restriction X W).mapDerivedCategory.map eM.hom) ⊗ₘ
      ((restriction X W).mapDerivedCategory.map eN.hom)) _ _ ?_ ?_ hδ ?_
    (Functor.OplaxMonoidal.δ_natural _ eM.inv eN.inv).symm ?_
  · rw [← hβ, coevaluationUnitHom]
    have aux2 : ∀ {E E' : Type _} [Category E] [Category E'] (G : E ⥤ E')
        {P₀ P₁ P₂ P₃ P₄ : E} {Q₅ : E'} (a : P₀ ⟶ P₁) (b : P₁ ⟶ P₂) (c : P₂ ⟶ P₃) (d : P₃ ⟶ P₄)
        (k : G.obj P₄ ⟶ Q₅),
        G.map (a ≫ (b ≫ c) ≫ d) ≫ k = G.map a ≫ G.map b ≫ G.map c ≫ G.map d ≫ k := by
      intro E E' _ _ G P₀ P₁ P₂ P₃ P₄ Q₅ a b c d k
      simp only [Functor.map_comp, Category.assoc]
    exact aux2 _ _ _ _ _ _
  · exact ((restriction X W).mapDerivedCategory.mapIso
      (symmetricMonoidalDerived X.O).unitIso).hom_inv_id
  · exact (MonoidalCategory.tensorHom_comp_tensorHom _ _ _ _).trans
      (congrArg₂ (· ⊗ₘ ·) (Iso.hom_inv_id_app_assoc _ _ _) (Iso.hom_inv_id_app_assoc _ _ _))
  · exact (MonoidalCategory.tensorHom_comp_tensorHom _ _ _ _).trans
      ((congrArg₂ (· ⊗ₘ ·) ((restriction X W).mapDerivedCategory.mapIso eM).inv_hom_id
        ((restriction X W).mapDerivedCategory.mapIso eN).inv_hom_id).trans
        (MonoidalCategory.id_tensorHom_id _ _))


omit [HasSheafify X.J AddCommGrpCat.{u}] [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- Right whiskering in the tensor product `sheafTensor` of the slice over `W`, on a pure tensor
of local sections. -/
theorem whiskerRight_val_app_unit_tmul (W : X.C)
    {A A' : Stacks.SheafOfModules.DerivedMonoidal.Mod (X.O.over W)} (φ : A ⟶ A')
    (B : Stacks.SheafOfModules.DerivedMonoidal.Mod (X.O.over W)) (V : (Over W)ᵒᵖ)
    (y : A.val.obj V) (x : B.val.obj V) :
    (φ ▷ B).val.app V
        (((PresheafOfModules.sheafificationAdjunction
            (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf (X.O.over W)).obj)).unit.app
          (A.val ⊗ B.val)).app V (y ⊗ₜ x)) =
      ((PresheafOfModules.sheafificationAdjunction
          (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf (X.O.over W)).obj)).unit.app
        (A'.val ⊗ B.val)).app V (φ.val.app V y ⊗ₜ x) := by
