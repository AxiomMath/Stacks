private theorem comp_assoc_eq {E : Type*} [Category* E] {Z₀ Z₁ Z₂ Z₃ Z₄ : E}
    (a : Z₀ ⟶ Z₁) (b : Z₁ ⟶ Z₂) (c : Z₂ ⟶ Z₄) (d : Z₁ ⟶ Z₃) (e : Z₃ ⟶ Z₄)
    (h : b ≫ c = d ≫ e) : (a ≫ b) ≫ c = (a ≫ d) ≫ e := by
  rw [Category.assoc, h, Category.assoc]

