/-- **A factorization of the image of a coevaluation exhibits a retract.** Let `F` be a monoidal
functor and `N` a left dual of `M`. Suppose that, after identifying `F M` and `F N` with `MW` and
`NW`, the coevaluation of the image pairing factors through `f₀ ▷ NW` for a morphism
`f₀ : K ⟶ MW`, in the following form: there are a morphism `s : S ⟶ T`, an identification
`comp : MW ⊗ NW ≅ T` and an identification `Θ : S ≅ K ⊗ NW` carrying `f₀ ▷ NW` to `s`, and a
morphism `b : 𝟙 ⟶ S` whose composite with `s` is the image coevaluation. Then `F M` is a retract
of `K` along `f₀` followed by the identification. -/
theorem _root_.CategoryTheory.ExactPairing.exists_section_of_map_coevaluation_factors
    {C : Type*} [Category* C] [MonoidalCategory C] {D : Type*} [Category* D]
    [MonoidalCategory D] (F : C ⥤ D) [F.Monoidal] (M N : C) [ExactPairing M N]
    {K MW NW S T : D} (eM : MW ≅ F.obj M) (eN : NW ≅ F.obj N) (f₀ : K ⟶ MW) (s : S ⟶ T)
    (comp : MW ⊗ NW ≅ T) (Θ : S ≅ K ⊗ NW) (hΘ : Θ.hom ≫ (f₀ ▷ NW) = s ≫ comp.inv)
    (b : 𝟙_ D ⟶ S)
    (hb : b ≫ s ≫ comp.inv ≫ (eM.hom ⊗ₘ eN.hom) =
      Functor.LaxMonoidal.ε F ≫ F.map (η_ M N) ≫ Functor.OplaxMonoidal.δ F M N) :
    ∃ sec : F.obj M ⟶ K, sec ≫ f₀ ≫ eM.hom = 𝟙 _ := by
  let := ExactPairing.map F M N
  have hcoev : (b ≫ Θ.hom ≫ K ◁ eN.hom) ≫ (f₀ ≫ eM.hom) ▷ F.obj N = η_ (F.obj M) (F.obj N) := by
    rw [ExactPairing.map_coevaluation, ← hb, Category.assoc, Category.assoc,
      MonoidalCategory.whisker_exchange, comp_whiskerRight, ← Category.assoc (Θ.hom),
      ← Category.assoc (Θ.hom), hΘ, MonoidalCategory.tensorHom_def]
    simp only [Category.assoc]
  exact ⟨(ExactPairing.retractOfCoevaluationFactors (f₀ ≫ eM.hom) _ hcoev).i,
    (ExactPairing.retractOfCoevaluationFactors (f₀ ≫ eM.hom) _ hcoev).retract⟩

