        (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W))).hom ≫
      (Stacks.Sites.ExtensionByZero.unitHomEquivOfTerminal (X.J.over W)
        ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W) (Over.mk (𝟙 W)) Over.mkIdTerminal
        _).symm y₀ :=
    HomologicalComplex.mkHomFromSingle_f _ _
  have aux3 : ∀ {E : Type _} [Category E] {P₀ P₁ P₂ P₃ P₄ : E} (a : P₀ ⟶ P₂) (h : P₀ ⟶ P₁)
      (e : P₁ ⟶ P₂) (x : P₂ ⟶ P₃) (m : P₃ ⟶ P₄) (u : P₁ ⟶ P₄) (c : P₀ ⟶ P₄),
      a = h ≫ e → e ≫ x ≫ m = u → c = h ≫ u → (a ≫ x) ≫ m = c := by
    intro E _ P₀ P₁ P₂ P₃ P₄ a h e x m u c h1 h2 h3
    rw [h1, h3, ← h2]
    simp only [Category.assoc]
  exact aux3 _ _ _ _ _ _ _ hc hL (SheafOfModules.cocycleHomOver_f _ _ W t ht)


