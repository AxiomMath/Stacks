/-- Splicing a commuting square into a composite, in an abstract category; applied as a term, so
that the unifier crosses the spellings of the categories involved. -/
private theorem comp_chain_four {E : Type*} [Category* E] {Z₀ Z₁ Z₂ Z₃ Z₄ Z₅ Z₆ Z₇ : E}
    (ε : Z₀ ⟶ Z₁) (u : Z₁ ⟶ Z₂) (f : Z₂ ⟶ Z₃) (p : Z₃ ⟶ Z₄) (q : Z₄ ⟶ Z₆) (p' : Z₃ ⟶ Z₅)
    (d : Z₅ ⟶ Z₆) (R : Z₆ ⟶ Z₇) (G : Z₀ ⟶ Z₇) (h1 : p ≫ q = p' ≫ d)
    (h2 : (ε ≫ u ≫ f ≫ p') ≫ d ≫ R = G) : (ε ≫ u ≫ f ≫ p) ≫ q ≫ R = G := by
  rw [← h2]; simp only [Category.assoc]; rw [reassoc_of% h1]

