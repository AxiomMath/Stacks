  [∀ W : X.C, HasSheafify (X.J.over W) AddCommGrpCat.{u}]
  [∀ W : X.C, (X.J.over W).WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- A degree-zero cocycle section over `W` is a cocycle section of the restriction over the final
object of the slice. -/
private theorem restriction_d_zero (W : X.C)
    (A : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O) (s : (A.X 0).val.obj (op W))
    (hs : (A.d 0 1).val.app (op W) s = 0) :
    ((((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj A).d 0 1).val.app
      (op (Over.mk (𝟙 W))) s = 0 :=
  hs

/-- **The lifted coevaluation section is a cocycle.** If `j ▷ N^•|_W` is a monomorphism in degree
`1` and a section `y₀` of `K ⊗ N^•|_W` over the final object of the slice is carried, by
`j ▷ N^•|_W` and the tensorator of restriction, to a cocycle section `t` of `Tot(M^• ⊗ N^•)` over
`W`, then `y₀` is a cocycle. -/
theorem cocycle_of_whiskerRight_mu (W : X.C)
    (Mc Nc : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O)
    (K : Stacks.SheafOfModules.DerivedMonoidal.Complexes (X.O.over W))
    (j : K ⟶ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Mc)
    (hjm : Mono ((j ▷ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc).f 1))
    (t : (((Mc ⊗ Nc : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O)).X 0).val.obj (op W))
    (ht : (((Mc ⊗ Nc : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O)).d 0 1).val.app
      (op W) t = 0)
    (y₀ : ((K ⊗ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc :
      Stacks.SheafOfModules.DerivedMonoidal.Complexes (X.O.over W)).X 0).val.obj
        (op (Over.mk (𝟙 W))))
    (hyt : letI := Stacks.Cohomology.DerivedRestriction.sheafRestrictionMonoidal X W
      ((Functor.LaxMonoidal.μ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ))
        Mc Nc).f 0).val.app (op (Over.mk (𝟙 W)))
        (((j ▷ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc).f 0).val.app
          (op (Over.mk (𝟙 W))) y₀) = t) :
    ((K ⊗ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc :
      Stacks.SheafOfModules.DerivedMonoidal.Complexes (X.O.over W)).d 0 1).val.app
        (op (Over.mk (𝟙 W))) y₀ = 0 := by
  let := Stacks.Cohomology.DerivedRestriction.sheafRestrictionMonoidal X W
  refine @SheafOfModules.d_zero_of_mono_f_one _ _ (X.J.over W)
    (Stacks.SheafOfModules.Tensor.ringSheaf (X.O.over W)) _ _
    (j ▷ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc) hjm _ y₀ ?_
  have hz : ((Functor.OplaxMonoidal.δ ((restriction X W).mapHomologicalComplex
        (ComplexShape.up ℤ)) Mc Nc).f 0).val.app (op (Over.mk (𝟙 W)))
      (((Functor.LaxMonoidal.μ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ))
        Mc Nc).f 0).val.app (op (Over.mk (𝟙 W)))
        (((j ▷ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc).f 0).val.app
          (op (Over.mk (𝟙 W))) y₀)) =
      ((j ▷ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc).f 0).val.app
          (op (Over.mk (𝟙 W))) y₀ :=
    (SheafOfModules.hom_congr_app_apply (HomologicalComplex.congr_hom
      (Functor.Monoidal.μ_δ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ))
        Mc Nc) 0) (op (Over.mk (𝟙 W)))
      (((j ▷ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc).f 0).val.app
          (op (Over.mk (𝟙 W))) y₀)).trans rfl
  rw [← hz]
  refine d_zero_app_of_d_zero ?_ _
  rw [hyt]
  exact ht

/-- **The local retract of Stacks 0FPV, along subcomplexes of the slices.** Let `N` be a left dual
of `M` in `D(O)`, represented by K-flat complexes `M^•` and `N^•`, and let `V` be an object of
`C`. There is a covering family of `V` along each member `W` of which there are finitely many
sections `a i` of the terms of `M^•` over `W` such that, for every morphism of complexes
`j : K ⟶ M^•|_W` **of the slice over `W`** which stays a monomorphism after `- ⊗ N^•|_W` in degree
`1` and through which the `a i` lift over the final object of the slice, `M|_W` is a retract of
`K` in `D(O|_W)` along `Q(j)`.

This is the source's *"we are going to use the following argument several times"*, after its
*"we may replace `C` by `C/U` and assume `C` has a final object"*: the subcomplex lives on the
slice, so it may be generated by sections over the final object of the slice. -/
theorem exists_presieve_sliceRetract (V : X.C)
    (M N : Stacks.SheafOfModules.DerivedMonoidal.DerivedModules X.O)
    (pair : letI := derivedMonoidal X.O; ExactPairing M N)
    (Mc Nc : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O)
    (eM : DerivedCategory.Q.obj Mc ≅ M) (eN : DerivedCategory.Q.obj Nc ≅ N)
    (hM : Stacks.SheafOfModules.DerivedMonoidal.KFlat X.O Mc)
    (hN : Stacks.SheafOfModules.DerivedMonoidal.KFlat X.O Nc) :
    ∃ S : Presieve V, Sieve.generate S ∈ X.J V ∧
      ∀ ⦃W : X.C⦄ (h : W ⟶ V), S h →
        ∃ (κ : Type) (_ : Fintype κ) (deg : κ → ℤ)
          (a : ∀ i, (Mc.X (deg i)).val.obj (op W)),
          ∀ (K : Stacks.SheafOfModules.DerivedMonoidal.Complexes (X.O.over W))
            (j : K ⟶ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Mc),
            Mono ((j ▷ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc).f 1) →
            (∀ i, ∃ y : (K.X (deg i)).val.obj (op (Over.mk (𝟙 W))),
              (j.f (deg i)).val.app (op (Over.mk (𝟙 W))) y = a i) →
            ∃ sec : (restriction X W).mapDerivedCategory.obj M ⟶ DerivedCategory.Q.obj K,
              sec ≫ DerivedCategory.Q.map j ≫
                (restriction X W).mapDerivedCategoryFactors.inv.app Mc ≫
                  (restriction X W).mapDerivedCategory.map eM.hom = 𝟙 _ := by
  let := derivedMonoidal X.O
  let := pair
  classical
  obtain ⟨S₁, hS₁, hdata⟩ := exists_coveringSieve_coevaluationSection X V Mc Nc hM hN
    (η_ M N ≫ (eM.inv ⊗ₘ eN.inv))
  refine ⟨fun {W} _ =>
    ∃ (κ : Type) (_ : Fintype κ) (deg : κ → ℤ) (a : ∀ i, (Mc.X (deg i)).val.obj (op W)),
      ∀ (K : Stacks.SheafOfModules.DerivedMonoidal.Complexes (X.O.over W))
        (j : K ⟶ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Mc),
        Mono ((j ▷ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc).f 1) →
        (∀ i, ∃ y : (K.X (deg i)).val.obj (op (Over.mk (𝟙 W))),
          (j.f (deg i)).val.app (op (Over.mk (𝟙 W))) y = a i) →
        ∃ sec : (restriction X W).mapDerivedCategory.obj M ⟶ DerivedCategory.Q.obj K,
          sec ≫ DerivedCategory.Q.map j ≫
            (restriction X W).mapDerivedCategoryFactors.inv.app Mc ≫
              (restriction X W).mapDerivedCategory.map eM.hom = 𝟙 _,
    ?_, fun _ _ hh => hh⟩
  refine X.J.transitive hS₁ _ fun {W₁} f hf => ?_
  obtain ⟨t, ht, hβ₁⟩ := hdata f hf
  obtain ⟨T, hT, hsum⟩ := exists_sieve_sum_tensorComplexSection X Mc Nc 0 W₁ t
  refine X.J.superset_covering (fun {W} g hg => ?_) hT
  obtain ⟨κ, hκ, tdeg, rdeg, hdeg, a, b, hab⟩ := hsum g hg
  refine ⟨W, 𝟙 W, g ≫ f, ⟨κ, hκ, tdeg, a, fun K j hjm hlift => ?_⟩, Category.id_comp _⟩
  choose y hy using hlift
  let := Stacks.Cohomology.DerivedRestriction.sheafRestrictionMonoidal X W
  have htW :=
    SheafOfModules.d_zero_map_of_d_zero (Stacks.SheafOfModules.Tensor.ringSheaf X.O) g t ht
  have hβ : (restriction X W).mapDerivedCategory.map (coevaluationUnitHom X Mc Nc hM hN
          (η_ M N ≫ (eM.inv ⊗ₘ eN.inv))) ≫
        (restriction X W).mapDerivedCategoryFactors.hom.app
          (Mc ⊗ Nc : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O) =
      (restriction X W).mapDerivedCategoryFactors.hom.app (structureSheafComplex X) ≫
        DerivedCategory.Q.map
          ((SheafOfModules.overFunctorUnitComplexIso
              (Stacks.SheafOfModules.Tensor.ringSheaf X.O) W).hom ≫
            SheafOfModules.cocycleHomOver (Stacks.SheafOfModules.Tensor.ringSheaf X.O)
              (Mc ⊗ Nc : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O) W _ htW) :=
    (mapDerivedCategory_map_eq_restrictComplexMapAlong X g
      (coevaluationUnitHom X Mc Nc hM hN (η_ M N ≫ (eM.inv ⊗ₘ eN.inv))) _ hβ₁).trans
      (congrArg (_ ≫ ·) (congrArg DerivedCategory.Q.map
        (restrictComplexMapAlong_cocycleHomOver X g t ht)))
  obtain ⟨y₀, hy₀⟩ : ∃ y₀ :
      ((K ⊗ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc :
        Stacks.SheafOfModules.DerivedMonoidal.Complexes (X.O.over W)).X 0).val.obj
          (op (Over.mk (𝟙 W))),
      y₀ = ∑ i, (HomologicalComplex.ιTensorObj K
          (((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc)
          (tdeg i) (rdeg i) 0 (hdeg i)).val.app (op (Over.mk (𝟙 W)))
        (((PresheafOfModules.sheafificationAdjunction
            (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf (X.O.over W)).obj)).unit.app
          ((K.X (tdeg i)).val ⊗ ((restriction X W).obj (Nc.X (rdeg i))).val)).app
            (op (Over.mk (𝟙 W))) (y i ⊗ₜ b i)) := ⟨_, rfl⟩
  have hy' : ∀ i, ((j.f (tdeg i)).val.app (op (Over.mk (𝟙 W))) (y i) :
      (Mc.X (tdeg i)).val.obj (op W)) = a i := hy
  have hyt₁ := mu_whiskerRight_sum_unit_tmul X W Mc Nc K j tdeg rdeg hdeg y b
  rw [← hy₀] at hyt₁
  have hsum : (∑ i, (HomologicalComplex.ιTensorObj Mc Nc (tdeg i) (rdeg i) 0 (hdeg i)).val.app
        (op W) (((PresheafOfModules.sheafificationAdjunction
          (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf X.O).obj)).unit.app
        ((Mc.X (tdeg i)).val ⊗ (Nc.X (rdeg i)).val)).app (op W)
          ((j.f (tdeg i)).val.app (op (Over.mk (𝟙 W))) (y i) ⊗ₜ b i))) =
      ∑ i, (HomologicalComplex.ιTensorObj Mc Nc (tdeg i) (rdeg i) 0 (hdeg i)).val.app
        (op W) (((PresheafOfModules.sheafificationAdjunction
          (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf X.O).obj)).unit.app
        ((Mc.X (tdeg i)).val ⊗ (Nc.X (rdeg i)).val)).app (op W) (a i ⊗ₜ b i)) :=
    Finset.sum_congr rfl fun i _ => congrArg (fun x =>
      (HomologicalComplex.ιTensorObj Mc Nc (tdeg i) (rdeg i) 0 (hdeg i)).val.app
        (op W) (((PresheafOfModules.sheafificationAdjunction
          (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf X.O).obj)).unit.app
        ((Mc.X (tdeg i)).val ⊗ (Nc.X (rdeg i)).val)).app (op W) (x ⊗ₜ b i))) (hy' i)
  have hab' : ((Mc ⊗ Nc : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O).X 0).val.map
      g.op t = ∑ i, (HomologicalComplex.ιTensorObj Mc Nc (tdeg i) (rdeg i) 0 (hdeg i)).val.app
        (op W) (((PresheafOfModules.sheafificationAdjunction
          (𝟙 (Stacks.SheafOfModules.Tensor.ringSheaf X.O).obj)).unit.app
        ((Mc.X (tdeg i)).val ⊗ (Nc.X (rdeg i)).val)).app (op W) (a i ⊗ₜ b i)) := hab
  have hyt : ((Functor.LaxMonoidal.μ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ))
        Mc Nc).f 0).val.app (op (Over.mk (𝟙 W)))
        (((j ▷ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc).f 0).val.app
          (op (Over.mk (𝟙 W))) y₀) =
      ((Mc ⊗ Nc : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O).X 0).val.map g.op t :=
    hyt₁.trans (hsum.trans hab'.symm)
  have hcy : ((K ⊗ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc :
      Stacks.SheafOfModules.DerivedMonoidal.Complexes (X.O.over W)).d 0 1).val.app
        (op (Over.mk (𝟙 W))) y₀ = 0 :=
    cocycle_of_whiskerRight_mu X W Mc Nc K j hjm _ htW y₀ hyt
  exact exists_section_restriction_of_sliceSection X W M N pair Mc Nc eM eN hM hN _ htW hβ K j
    y₀ hcy hyt

