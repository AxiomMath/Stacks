module

public import StacksFrontier.CategoryTheory.Sites.Cohomology.Perfect.InvertibleObjectsLocalSplitting
public import StacksFrontier.CategoryTheory.Sites.Cohomology.Perfect.InvertibleObjectsOrthogonality
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.LocallyTrivialInvertible.Basic
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.RingSheafProductFactorRestrictScalars
public import StacksFrontier.CategoryTheory.Sites.Localization.RingedSiteLocalization

/-!
# Paired local splittings of the cohomology of two complexes on a ringed site

Let `(C, O)` be a ringed site and `K`, `K'` complexes of `O`-modules. A *paired splitting* over
an object `V` is a local splitting of `K` over `V` (see
`AlgebraicGeometry.RingedSite.InvertibleDerived.LocalSplitting`) whose idempotents `f_n` also act
on `H^k(K')` as `1` for `k = -n` and as `0` otherwise, and such that over `V` the tensor product
`H^n(K) ⊗ H^{-n}(K')` is freely generated by one section over the corner rings `f_n O`.

If every object has a covering by objects carrying paired splittings, the idempotents glue to a
locally finite complete family of orthogonal idempotents `e_n` of `Γ(C, O)`, and each `H^n(K)` is
an invertible module over the factor `e_n O`: on the members of the covering
`H^n(K) ⊗ H^{-n}(K')`, read over `O_n`, is freely generated by one section, so it is invertible
(Stacks 0B8K), it is `H^n(K) ⊗_{O_n} H^{-n}(K')`, and a tensor factor of an invertible module is
invertible. Hence `K` satisfies clause (2) of Stacks 0FPY.

This is the gluing step of the proof of `(1) ⟹ (2)` of Stacks 0FPY, the local input being the
ring-level structure of invertible objects (Stacks 0FNT) on the members of a covering.

## References

* [Stacks Project, Tag 0FPY](https://stacks.math.columbia.edu/tag/0FPY)
* [Stacks Project, Tag 0B8K](https://stacks.math.columbia.edu/tag/0B8K)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.MonoidalCategory AlgebraicGeometry
open Opposite Stacks.SheafOfModules.DerivedMonoidal

universe u d

namespace AlgebraicGeometry.RingedSite.InvertibleDerived

open Stacks.Cohomology.InvertibleDerived (ActsOnHomology)

variable {X : RingedSite.{u, u, u}}

/-! ### Paired splittings -/

variable [HasSheafify X.J AddCommGrpCat.{u}] [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- The tensor product `H^n(K) ⊗ H^{-n}(K')` of the cohomology sheaves of two complexes. -/
abbrev pairingTensor (K K' : CochainComplex (Mod X.O) ℤ) (n : ℤ) : Mod X.O :=
  ((Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.O).obj (K.homology n)).obj
    (K'.homology (-n))

/-- A **paired splitting** of the complexes `K` and `K'` over `V`: a local splitting of `K` whose
idempotents act on `H^k(K')` as the degree projections onto `k = -n`, and such that over `V` the
tensor product `H^n(K) ⊗ H^{-n}(K')` is freely generated by one section over the corner rings
`f_n O`. -/
structure PairedSplitting (K K' : CochainComplex (Mod X.O) ℤ) (V : X.C)
    extends LocalSplitting K V where
  /-- `f n` acts on `H^k(K')` over `V` as `1` for `k = -n` and as `0` otherwise. -/
  smul' : ∀ (n k : ℤ) ⦃W : X.C⦄ (g : W ⟶ V) (m : (K'.homology k).val.obj (op W)),
    ringSec (X.O.obj.map g.op (f n)) • m = if k = -n then m else 0
  /-- Over `V`, `H^n(K) ⊗ H^{-n}(K')` is freely generated by one section over `f n O`. -/
  gen : ∀ n : ℤ, ∃ t : (pairingTensor K K' n).val.obj (op V), ∀ ⦃W : X.C⦄ (g : W ⟶ V),
    Function.Bijective fun c :
        {a : (X.O.obj.obj (op W) : Type u) // X.O.obj.map g.op (f n) * a = a} =>
      ringSec c.1 • ((pairingTensor K K' n).val.map g.op t : (pairingTensor K K' n).val.obj (op W))

/-- The presieve of arrows into `U` whose source carries a paired splitting. -/
def pairedPresieve (K K' : CochainComplex (Mod X.O) ℤ) (U : X.C) : Presieve U :=
  fun V _ => Nonempty (PairedSplitting K K' V)

section Glue

variable {K K' : CochainComplex (Mod X.O) ℤ}
  (hK : ∀ U : X.C, Sieve.generate (pairedPresieve K K' U) ∈ X.J U)

/-- Paired splittings on coverings give local splittings on coverings. -/
theorem splittingSieve_mem_of_paired
    (hK₀ : ∀ U : X.C, Sieve.generate (pairedPresieve K K' U) ∈ X.J U) (U : X.C) :
    splittingSieve K U ∈ X.J U := by
  refine X.J.superset_covering ?_ (hK₀ U)
  rintro W g ⟨V, a, b, ⟨A⟩, rfl⟩
  exact (splittingSieve K U).downward_closed ⟨A.toLocalSplitting⟩ a

/-- The glued idempotents of a pair of complexes with paired splittings on coverings. -/
abbrev pairedIdempotents : LocallyFiniteIdempotents X :=
  glueIdempotents (splittingSieve_mem_of_paired hK)

/-- Over an object carrying a paired splitting, the glued idempotents are those of the
splitting. -/
theorem pairedIdempotents_val (n : ℤ) {V : X.C} (A : PairedSplitting K K' V) :
    ((pairedIdempotents hK).e n).val (op V) = A.f n :=
  glueIdempotents_val _ n A.toLocalSplitting

/-- Over `W` mapping to an object `V` with a paired splitting, the glued idempotent is the
restriction of the idempotent of the splitting. -/
private theorem pairedIdempotents_val_map (n : ℤ) {V W : X.C} (A : PairedSplitting K K' V)
    (a : W ⟶ V) :
    ((pairedIdempotents hK).e n).val (op W) = X.O.obj.map a.op (A.f n) := by
  rw [← ((pairedIdempotents hK).e n).map_val a.op, pairedIdempotents_val hK n A]

/-- `e_n` acts as the identity on a module on which the idempotents of every paired splitting,
restricted along any map, act as the identity. -/
private theorem actsAsOne_of_paired (n : ℤ) (F : Mod X.O)
    (h : ∀ ⦃U V : X.C⦄ (A : PairedSplitting K K' V) (a : U ⟶ V) (m : F.val.obj (op U)),
      ringSec (X.O.obj.map a.op (A.f n)) • m = m) :
    (pairedIdempotents hK).ActsAsOne n F := by
  intro U m
  induction U with | op U => ?_
  refine mod_eq_of_locally_eq _ (hK U) _ _ fun W g hg => ?_
  obtain ⟨V, a, b, ⟨A⟩, rfl⟩ := hg
  rw [F.val.map_smul]
  show ringSec (X.O.obj.map (a ≫ b).op (((pairedIdempotents hK).e n).val (op U))) • _ = _
  rw [((pairedIdempotents hK).e n).map_val, pairedIdempotents_val_map hK n A a]
  exact h A a _

/-- `e_n` acts as the identity on `H^{-n}(K')`. -/
theorem actsAsOne_neg (n : ℤ) : (pairedIdempotents hK).ActsAsOne n (K'.homology (-n)) :=
  actsAsOne_of_paired hK n _ fun _ _ A a m => (A.smul' n (-n) a m).trans (if_pos rfl)

/-- **A left factor of an invertible tensor product is invertible.** -/
theorem isInvertibleModule_left_of_tensorObj {S : Sheaf X.J CommRingCat.{u}}
    (H H' : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf S))
    (h : letI := SheafOfModules.monoidalCategorySheafTensor S
      Stacks.SheafOfModules.Tensor.IsInvertibleModule S
        (H ⊗ H' : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf S))) :
    Stacks.SheafOfModules.Tensor.IsInvertibleModule S H := by
  let := SheafOfModules.monoidalCategorySheafTensor S
  obtain ⟨G, ⟨e⟩⟩ := (Stacks.SheafOfModules.isInvertible_iff_exists_tensor_iso_unit
    (O := S.obj) (hO := (Stacks.SheafOfModules.Tensor.ringSheaf S).property)
    (H ⊗ H' : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf S))).mp h
  have e' : (H ⊗ H') ⊗ G ≅ SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf S) := e
  exact (Stacks.SheafOfModules.isInvertible_iff_exists_tensor_iso_unit
    (O := S.obj) (hO := (Stacks.SheafOfModules.Tensor.ringSheaf S).property) H).mpr
    ⟨(H' ⊗ G : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf S)),
      ⟨(α_ H H' G).symm ≪≫ e'⟩⟩

include hK in
/-- `e_n` acts as the identity on `H^n(K) ⊗ H^{-n}(K')`: locally every section is a corner
multiple of the generator. -/
theorem actsAsOne_pairingTensor (n : ℤ) :
    (pairedIdempotents hK).ActsAsOne n (pairingTensor K K' n) :=
  actsAsOne_of_paired hK n _ fun _ _ A a m => by
    obtain ⟨t, ht⟩ := A.gen n
    obtain ⟨c, hc⟩ := (ht a).2 m
    dsimp only at hc
    rw [← hc]
    exact (mul_smul _ (ringSec c.1) _).symm.trans (congrArg (· • _) c.2)

/-- **The factor module of `H^n(K) ⊗ H^{-n}(K')` is invertible over `O_n`**: over the members of
the covering it is freely generated by one section over the corner rings, which is a rank-one dual
basis there (Tag 0B8K). -/
theorem isInvertibleModule_factorModule_pairingTensor (n : ℤ) :
    Stacks.SheafOfModules.Tensor.IsInvertibleModule ((pairedIdempotents hK).factor n)
      (LocallyFiniteIdempotents.factorModule (actsAsOne_pairingTensor hK n)) := by
  set E := pairedIdempotents hK
  let P : X.C → Prop := fun W => ∃ t : (pairingTensor K K' n).val.obj (op W),
    ∀ ⦃W' : X.C⦄ (g' : W' ⟶ W),
    Function.Bijective fun c : E.Corner n (op W') =>
      ringSec c.1 •
        ((pairingTensor K K' n).val.map g'.op t : (pairingTensor K K' n).val.obj (op W'))
  have hP : ∀ (V : X.C), PairedSplitting K K' V → P V := by
    intro V A
    obtain ⟨t, ht⟩ := A.gen n
    refine ⟨t, fun W' g' => ?_⟩
    have hval := pairedIdempotents_val_map hK n A g'
    let eq : E.Corner n (op W') ≃
        {a : (X.O.obj.obj (op W') : Type u) // X.O.obj.map g'.op (A.f n) * a = a} :=
      { toFun := fun c => ⟨c.1, hval ▸ E.mem_corner n c⟩
        invFun := fun a => ⟨a.1, (Stacks.Cohomology.InvertibleDerived.mem_corner_iff_of_comm
          (E.idem n (op W'))).mpr (by rw [hval]; exact a.2)⟩
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl }
    exact (ht g').comp eq.bijective
  have hcov : X.J.CoversTop (fun i : {W : X.C // P W} => i.1) := by
    intro U
    refine X.J.superset_covering ?_ (hK U)
    rintro W g ⟨V, a, b, ⟨A⟩, rfl⟩
    exact ⟨⟨V, hP V A⟩, ⟨a⟩⟩
  exact Stacks.SheafOfModules.isInvertible_of_dualBasisOne _ _ hcov fun i =>
    Stacks.SheafOfModules.DualBasisOne.ofSmulBijective i.1 i.2.choose fun V =>
      i.2.choose_spec V.unop.hom

include hK in
/-- **Each `H^n(K)` is invertible over the factor `e_n O`.** Its tensor product over `O_n` with
`H^{-n}(K')` is the factor module of `H^n(K) ⊗_O H^{-n}(K')`, which is invertible, and a tensor
factor of an invertible module is invertible. -/
theorem isInvertibleModule_factorModule_of_paired (n : ℤ) :
    Stacks.SheafOfModules.Tensor.IsInvertibleModule ((pairedIdempotents hK).factor n)
      (LocallyFiniteIdempotents.factorModule (actsAsOne_homology
        (actsOnHomology_glueIdempotents (splittingSieve_mem_of_paired hK)) n)) := by
  let := SheafOfModules.monoidalCategorySheafTensor X.O
  let := SheafOfModules.monoidalCategorySheafTensor ((pairedIdempotents hK).factor n)
  set E := pairedIdempotents hK
  set D := E.productDecomposition
  let : MonoidalCategory (SheafOfModules (Stacks.SheafOfModules.Tensor.ringSheaf (D.factor n))) :=
    SheafOfModules.monoidalCategorySheafTensor (D.factor n)
  set hF := actsAsOne_homology (actsOnHomology_glueIdempotents (splittingSieve_mem_of_paired hK)) n
  set hF' := actsAsOne_neg hK n
  refine isInvertibleModule_left_of_tensorObj _ (LocallyFiniteIdempotents.factorModule hF') ?_
  let e1 : (D.toOMod n).obj (LocallyFiniteIdempotents.factorModule hF ⊗
      LocallyFiniteIdempotents.factorModule hF') ≅
      (D.toOMod n).obj (LocallyFiniteIdempotents.factorModule (actsAsOne_pairingTensor hK n)) :=
    (D.tensorObjIsoToOMod n _ _).symm ≪≫
      tensorIso (LocallyFiniteIdempotents.toOModFactorModuleIso hF)
        (LocallyFiniteIdempotents.toOModFactorModuleIso hF') ≪≫
      (LocallyFiniteIdempotents.toOModFactorModuleIso (actsAsOne_pairingTensor hK n)).symm
  have := isInvertibleModule_factorModule_pairingTensor hK n
  exact Stacks.SheafOfModules.isInvertible_of_iso _ _
    ((Stacks.SheafOfModules.RingSheafProductFactor.fullyFaithfulRestrictScalarsProjRing
      D.presentation n).preimageIso e1).symm

include hK in
/-- **Clause (2) of Stacks 0FPY from paired splittings.** If every object of the site has a
covering by objects carrying paired splittings of `K` and `K'`, then `K` satisfies clause (2):
the idempotents glue, act on the cohomology sheaves of `K` as the degree projections, and each
`H^n(K)` is invertible over the factor `e_n O`. -/
theorem hasInvertibleModuleDecomposition_of_paired [HasDerivedCategory.{d} (Mod X.O)] :
    HasInvertibleModuleDecomposition X (DerivedCategory.Q.obj K) :=
  hasInvertibleModuleDecomposition_of_idempotents
    (actsOnHomology_glueIdempotents (splittingSieve_mem_of_paired hK))
    (isInvertibleModule_factorModule_of_paired hK)

end Glue

end AlgebraicGeometry.RingedSite.InvertibleDerived

end
