open CategoryTheory.Pretriangulated Opposite Stacks.SheafOfModules.DerivedMonoidal

universe u w

namespace DerivedCategory

variable {A : Type*} [Category A] [Abelian A] [HasDerivedCategory.{w} A]

/-- **The third vertex of a triangle whose first map is a cohomology approximation in degrees
`≥ m` has no cohomology in degrees `≥ m`.** If `T.mor₁` is invertible on cohomology above `m`
and onto in degree `m`, the long exact sequence of cohomology kills `Hⁱ(T.obj₃)` for every
`i ≥ m`: the map into it is zero because `Hⁱ(T.mor₁)` is onto, and the map out of it is zero
because `H^{i+1}(T.mor₁)` is injective. -/
theorem isZero_homology_obj₃_of_triangle (T : Triangle (DerivedCategory A))
    (hT : T ∈ distTriang (DerivedCategory A)) (m : ℤ)
    (hiso : ∀ i, m < i → IsIso ((homologyFunctor A i).map T.mor₁))
    (hepi : Epi ((homologyFunctor A m).map T.mor₁)) (i : ℤ) (hi : m ≤ i) :
    IsZero ((homologyFunctor A i).obj T.obj₃) := by
  have hepi' : Epi ((homologyFunctor A i).map T.mor₁) := by
    rcases eq_or_lt_of_le hi with rfl | h
    · exact hepi
    · have := hiso i h
      infer_instance
  have hmono : Mono ((homologyFunctor A (i + 1)).map T.mor₁) := by
    have := hiso (i + 1) (by omega)
    infer_instance
  exact (HomologySequence.exact₃ T hT i (i + 1)).isZero_X₂
    ((HomologySequence.epi_homologyMap_mor₁_iff T hT i).1 hepi')
    ((HomologySequence.mono_homologyMap_mor₁_iff T hT i (i + 1)).1 hmono)

end DerivedCategory

namespace AlgebraicGeometry.RingedSite.InvertibleDerived

attribute [local instance] SheafOfModules.monoidalCategorySheafTensor
  SheafOfModules.symmetricCategorySheafTensor SheafOfModules.monoidalPreadditiveSheafTensor
  SheafOfModules.monoidalClosedSheafTensor
  SheafOfModules.preservesColimit_tensorRight_sheafTensor
  CochainComplex.symmetricCategory

attribute [local instance 10000] HasDerivedCategory.standard

variable {X : RingedSite.{u, u, u}} [HasSheafify X.J AddCommGrpCat.{u}]
  [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ W : X.C, HasSheafify (X.J.over W) AddCommGrpCat.{u}]
  [∀ W : X.C, (X.J.over W).WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- **The splice representative of the inductive step.** Let `ℰ` be a strictly perfect complex
vanishing below `m` and `α : Q(ℰ) ⟶ M` a morphism of `D(O)` invertible on cohomology above `m`
and onto in degree `m`. Then `M` is represented by a K-flat complex `ℳ`, bounded above, with a
map `ℰ ⟶ ℳ` invertible in every degree `≥ m`. -/
theorem exists_kFlat_splice (M : Stacks.SheafOfModules.DerivedMonoidal.DerivedModules X.O)
    (m : ℤ) (E : Complexes X.O)
    (hE : IsStrictlyPerfect (Stacks.SheafOfModules.Tensor.ringSheaf X.O) E) [E.IsStrictlyGE m]
    (α : DerivedCategory.Q.obj E ⟶ M)
    (hiso : ∀ i, m < i → IsIso ((DerivedCategory.homologyFunctor _ i).map α))
    (hepi : Epi ((DerivedCategory.homologyFunctor _ m).map α)) :
    ∃ (Mc : Complexes X.O) (ι : E ⟶ Mc), (∀ i, m ≤ i → IsIso (ι.f i)) ∧ KFlat X.O Mc ∧
      (∃ b : ℤ, ∀ i, b < i → IsZero (Mc.X i)) ∧ Nonempty (DerivedCategory.Q.obj Mc ≅ M) := by
  obtain ⟨L, β, g, hT⟩ := distinguished_cocone_triangle α
  have hL : L.IsLE (m - 1) := by
    rw [DerivedCategory.isLE_iff]
    exact fun i hi => DerivedCategory.isZero_homology_obj₃_of_triangle _ hT m hiso hepi i
      (by omega)
  obtain ⟨Lc, hLflat, hLle, ⟨eL⟩⟩ :=
    Stacks.Cohomology.DerivedPullbackOnRingedTopoi.exists_flatRepresentative_of_isLE X L (m - 1) hL
  obtain ⟨Mc, ι, π, hι, hπ, hdist⟩ :=
    CochainComplex.exists_splice_triangle E Lc m (eL.hom ≫ g)
  let e := isoTriangleOfIso₁₃ _ _ hdist hT (Iso.refl _) eL (by simp)
  obtain ⟨b, hb⟩ : ∃ b : ℤ, ∀ i, b < i → IsZero (E.X i) := by
    obtain ⟨S, hS⟩ := hE.bounded.bddAbove
    refine ⟨max S m, fun i hi => ?_⟩
    by_contra h
    exact absurd (hS h) (by omega)
  have hMb : ∀ i, max b m < i → IsZero (Mc.X i) := fun i hi => by
    have := hι i (by omega)
    exact (hb i (by omega)).of_iso (asIso (ι.f i)).symm
  have hflat : ∀ i, AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u}
      (O := X.O) (Mc.X i) := fun i => by
    rcases lt_or_ge i m with h | h
    · have := hπ i h
      exact Stacks.SheafOfModules.isFlat_of_iso X (asIso (π.f i)).symm (hLflat i)
    · have := hι i h
      exact Stacks.SheafOfModules.isFlat_of_iso X (asIso (ι.f i))
        (Stacks.SheafOfModules.isFlat_of_isDirectSummandOfFiniteFree _ (hE.termDirectSummand i))
  have hle : Mc.IsStrictlyLE (max b m) :=
    ⟨fun i hi => hMb i (by
      by_contra h
      exact hi ((max b m - i).toNat) (by
        rw [ComplexShape.embeddingUpIntLE_f]; omega))⟩
  exact ⟨Mc, ι, hι, Stacks.SheafOfModules.kFlat_of_boundedAbove_of_flat X.O Mc ⟨_, hle⟩ hflat,
    ⟨max b m, hMb⟩, ⟨Triangle.π₂.mapIso e⟩⟩

/-- The pure-tensor computation of the inductive step: the sum `∑ yᵢ ⊗ gᵢ` over the final object
of `C/W`, for lifts `yᵢ` of the `fᵢ` to the subcomplex, is carried to the restriction of
`∑ fᵢ ⊗ gᵢ`. -/
theorem whiskerRight_sum_eq_sliceTensorIso (W : X.C) (Mc Nc : Complexes X.O)
    {K : Complexes (X.over W).O} (ι' : K ⟶ restrictMod Mc W) {κ : Type} [Fintype κ]
    (tdeg rdeg : κ → ℤ) (hdeg : ∀ i, tdeg i + rdeg i = 0)
    (a : ∀ i, (Mc.X (tdeg i)).val.obj (op W)) (b' : ∀ i, (Nc.X (rdeg i)).val.obj (op W))
    (y : ∀ i, (K.X (tdeg i)).val.obj (op (Over.mk (𝟙 W))))
    (hy : ∀ i, (ι'.f (tdeg i)).val.app _ (y i) = a i) :
    ((ι' ▷ restrictMod Nc W : (K ⊗ restrictMod Nc W : Complexes (X.over W).O) ⟶
        (restrictMod Mc W ⊗ restrictMod Nc W : Complexes (X.over W).O)).f 0).val.app
          (op (Over.mk (𝟙 W)))
        (∑ i, tensorComplexSection (X.over W) (tdeg i) (rdeg i) 0 (hdeg i)
          (K := K) (L := restrictMod Nc W) (W := Over.mk (𝟙 W)) (y i) (b' i)) =
      ((sliceTensorIso W Mc Nc).hom.f 0).val.app (op (Over.mk (𝟙 W)))
        (∑ i, tensorComplexSection X (tdeg i) (rdeg i) 0 (hdeg i) (a i) (b' i)) := by
  refine Eq.trans ?_ (tensorComplexOverIso_hom_sum Mc Nc tdeg rdeg hdeg a b').symm
  erw [map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  refine (whiskerRight_f_tensorComplexSection (X.over W) (Nc := restrictMod Nc W) ι' (tdeg i)
    (rdeg i) 0 (hdeg i) (y i)
    (b' i : ((restrictMod Nc W).X (rdeg i)).val.obj (op (Over.mk (𝟙 W))))).trans ?_
  rw [hy i]

/-- The restriction to `C/W` of a strictly perfect complex vanishing below `m`, read at the
structure sheaf of the localized site: it vanishes below `m` and its terms are direct summands
of finite free modules. -/
theorem restrictMod_strictlyPerfect_data (W : X.C) (m : ℤ) (E : Complexes X.O)
    (hE : IsStrictlyPerfect (Stacks.SheafOfModules.Tensor.ringSheaf X.O) E) [E.IsStrictlyGE m] :
    (∀ i, i < m → IsZero ((restrictMod E W).X i)) ∧
      ∀ i, IsDirectSummandOfFiniteFree (Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O)
        ((restrictMod E W).X i) := by
  have hRE : IsStrictlyPerfect (Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O)
      (restrictMod E W) :=
    Stacks.SheafOfModules.isStrictlyPerfect_mapHomologicalComplex (ovF X W) (Iso.refl _) hE
  exact ⟨fun i hi => (ovF X W).map_isZero (E.isZero_of_isStrictlyGE m i hi),
    hRE.termDirectSummand⟩

/-- **The inductive step over a member `W` of the covering.** With the splice representative
`ℳ`, the K-flat representative `𝒩` of the inverse, the isomorphism `γ : Tot(ℳ ⊗ 𝒩) ≅ O[0]`, and a
cocycle `t = ∑ fᵢ ⊗ gᵢ` over `W` representing `γ⁻¹` there, the restriction `ℳ|_W` is
`(m - 1)`-pseudo-coherent on `C/W`. -/
theorem isPseudoCoherentFrom_slice_step (W : X.C) (m : ℤ) (Mc Nc : Complexes X.O)
    (hMk : KFlat X.O Mc) (hNk : KFlat X.O Nc)
    (hNflat : ∀ q, AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u} (O := X.O) (Nc.X q))
    (γ : DerivedCategory.Q.obj (Mc ⊗ Nc : Complexes X.O) ≅
      DerivedCategory.Q.obj X.structureSheafComplex)
    (E : Complexes X.O) (hE : IsStrictlyPerfect (Stacks.SheafOfModules.Tensor.ringSheaf X.O) E)
    [E.IsStrictlyGE m] (ι : E ⟶ Mc) (hι : ∀ i, m ≤ i → IsIso (ι.f i)) (b : ℤ)
    (hb : ∀ i, b < i → IsZero (Mc.X i)) {κ : Type} [Fintype κ] (tdeg rdeg : κ → ℤ)
    (hdeg : ∀ i, tdeg i + rdeg i = 0) (a : ∀ i, (Mc.X (tdeg i)).val.obj (op W))
    (b' : ∀ i, (Nc.X (rdeg i)).val.obj (op W))
    (t : ((Mc ⊗ Nc : Complexes X.O).X 0).val.obj (op W))
    (ht : ((Mc ⊗ Nc : Complexes X.O).d 0 1).val.app (op W) t = 0)
    (hab : t = ∑ i, tensorComplexSection X (tdeg i) (rdeg i) 0 (hdeg i) (a i) (b' i))
    (hβ : (ovF X W).mapDerivedCategory.map γ.inv ≫
        (ovF X W).mapDerivedCategoryFactors.hom.app (Mc ⊗ Nc : Complexes X.O) =
      (ovF X W).mapDerivedCategoryFactors.hom.app X.structureSheafComplex ≫
        DerivedCategory.Q.map
          ((SheafOfModules.overFunctorUnitComplexIso
              (Stacks.SheafOfModules.Tensor.ringSheaf X.O) W).hom ≫
            SheafOfModules.cocycleHomOver (Stacks.SheafOfModules.Tensor.ringSheaf X.O)
              (Mc ⊗ Nc : Complexes X.O) W t ht)) :
    (X.over W).IsPseudoCoherentFrom (DerivedCategory.Q.obj (restrictMod Mc W)) (m - 1) := by
  obtain ⟨hE0, hEfree⟩ := restrictMod_strictlyPerfect_data W m E hE
  let e' : restrictMod E W ⟶ restrictMod Mc W :=
    ((ovF X W).mapHomologicalComplex (ComplexShape.up ℤ)).map ι
  have he' : ∀ i, m ≤ i → IsIso (e'.f i) := fun i hi => by
    have := hι i hi
    exact inferInstanceAs (IsIso ((ovF X W).map (ι.f i)))
  have hfree : ∀ i, m ≤ i → IsDirectSummandOfFiniteFree
      (Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O) ((restrictMod Mc W).X i) :=
    fun i hi => by
      have := he' i hi
      exact IsDirectSummandOfFiniteFree.of_iso _ (asIso (e'.f i)).symm (hEfree i)
  have hb' : ∀ i, b < i → IsZero ((restrictMod Mc W).X i) := fun i hi =>
    (ovF X W).map_isZero (hb i hi)
  have hK' := isPseudoCoherentFrom_sliceGenSubcomplex tdeg a e' m hE0 he' hfree b hb'
  choose y hy using exists_lift_sliceGenSubcomplex (L := restrictMod Mc W) tdeg a e'
  have hNflat' : ∀ q, AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u}
      (O := (X.over W).O) ((restrictMod Nc W).X q) := fun q =>
    Stacks.SheafOfModules.FlatRestriction.isFlat_over X W _ (hNflat q)
  have : ∀ p, Mono ((sliceGenSubcomplexι (L := restrictMod Mc W) tdeg a e').f p) :=
    fun p => Stacks.Sites.ExtensionByZero.mono_genSubcomplexι_f _ p
  have : Mono ((sliceGenSubcomplexι (L := restrictMod Mc W) tdeg a e' ▷ restrictMod Nc W :
      (sliceGenSubcomplex (L := restrictMod Mc W) tdeg a e' ⊗ restrictMod Nc W :
        Complexes (X.over W).O) ⟶
      (restrictMod Mc W ⊗ restrictMod Nc W : Complexes (X.over W).O)).f 1) :=
    Stacks.Cohomology.LeftDualPerfect.mono_mapBifunctorMap_f_general _ hNflat' 1
  have hs := (whiskerRight_sum_eq_sliceTensorIso W Mc Nc
    (sliceGenSubcomplexι (L := restrictMod Mc W) tdeg a e') tdeg rdeg hdeg a b' y hy).trans
    (congrArg (((sliceTensorIso W Mc Nc).hom.f 0).val.app
    (op (Over.mk (𝟙 W)))) (hab.symm.trans (sliceCocycleOf_sliceCocycleHom W _ t ht).symm))
  obtain ⟨r⟩ := nonempty_retract_restrictMod_of_tensorIsoUnit W Mc Nc hMk hNk γ t ht hβ _
    (sliceGenSubcomplexι (L := restrictMod Mc W) tdeg a e') _ hs
  obtain ⟨Z, eZ, -⟩ := Pretriangulated.exists_iso_biprod_of_retraction r.i r.r r.retract
  exact isPseudoCoherentFrom_left_of_biprod_general (X.over W) _ Z (m - 1)
    (isPseudoCoherentFrom_of_iso (X.over W) (m - 1) hK' eZ.symm)

/-- **The inductive step, given the approximation on the whole site.** Let `M` be invertible in
`D(O)` with inverse `N`, let `ℰ` be a strictly perfect complex vanishing below `m` and let
`α : Q(ℰ) ⟶ M` be invertible on cohomology above `m` and onto in degree `m`. Then `M` is
`(m - 1)`-pseudo-coherent. -/
theorem isPseudoCoherentFrom_sub_one_of_approximation
    (M N : Stacks.SheafOfModules.DerivedMonoidal.DerivedModules X.O)
    (e : letI := derivedMonoidal X.O; M ⊗ N ≅ 𝟙_ _) (m : ℤ) (E : Complexes X.O)
    (hE : IsStrictlyPerfect (Stacks.SheafOfModules.Tensor.ringSheaf X.O) E) [E.IsStrictlyGE m]
    (α : DerivedCategory.Q.obj E ⟶ M)
    (hiso : ∀ i, m < i → IsIso ((DerivedCategory.homologyFunctor _ i).map α))
    (hepi : Epi ((DerivedCategory.homologyFunctor _ m).map α)) :
    X.IsPseudoCoherentFrom M (m - 1) := by
  let := derivedMonoidal X.O
  obtain ⟨Mc, ι, hι, hMk, ⟨b, hb⟩, ⟨eM⟩⟩ := exists_kFlat_splice M m E hE α hiso hepi
  obtain ⟨Nc, pN, hNk, hNflat, hpN, -⟩ :=
    Stacks.SheafOfModules.KFlatResolution.exists_kFlatResolution X.O
      (DerivedCategory.Q.objPreimage N)
  have : IsIso (DerivedCategory.Q.map pN) :=
    (DerivedCategory.isIso_Q_map_iff_quasiIso (C := Mod X.O) pN).2 hpN
  let eN : DerivedCategory.Q.obj Nc ≅ N :=
    asIso (DerivedCategory.Q.map pN) ≪≫ DerivedCategory.Q.objObjPreimageIso N
  let cmp := (symmetricMonoidalDerived X.O).comparison Mc Nc hMk hNk
  let γ : DerivedCategory.Q.obj (Mc ⊗ Nc : Complexes X.O) ≅
      DerivedCategory.Q.obj X.structureSheafComplex :=
    cmp.symm ≪≫ tensorIso eM eN ≪≫ e ≪≫ (symmetricMonoidalDerived X.O).unitIso
  let η : 𝟙_ (Stacks.SheafOfModules.DerivedMonoidal.DerivedModules X.O) ⟶
      DerivedCategory.Q.obj Mc ⊗ DerivedCategory.Q.obj Nc :=
    (symmetricMonoidalDerived X.O).unitIso.hom ≫ γ.inv ≫ cmp.inv
  have hη : coevaluationUnitHom X Mc Nc hMk hNk η = γ.inv := by
    show (symmetricMonoidalDerived X.O).unitIso.inv ≫
      ((symmetricMonoidalDerived X.O).unitIso.hom ≫ γ.inv ≫ cmp.inv) ≫ cmp.hom = γ.inv
    simp
  refine isPseudoCoherentFrom_of_locally_general X M (m - 1) (fun U => ?_)
  obtain ⟨S₁, hS₁, hdata⟩ := exists_coveringSieve_coevaluationSection X U Mc Nc hMk hNk η
  refine ⟨fun {W} _ => (X.over W).IsPseudoCoherentFrom
      ((SheafOfModules.overFunctor.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)
        W).mapDerivedCategory.obj M) (m - 1), ?_, fun _ _ hh => hh⟩
  refine X.J.transitive hS₁ _ fun {W₁} f hf => ?_
  obtain ⟨t, ht, hβ₁⟩ := hdata f hf
  obtain ⟨T, hT, hsum⟩ := exists_sieve_sum_tensorComplexSection X Mc Nc 0 W₁ t
  refine X.J.superset_covering (fun {W} g hg => ?_) hT
  refine ⟨W, 𝟙 W, g ≫ f, ?_, Category.id_comp _⟩
  obtain ⟨κ, hκ, tdeg, rdeg, hdeg, a, b', hab⟩ := hsum g hg
  have ht₀ :=
    SheafOfModules.d_zero_map_of_d_zero (Stacks.SheafOfModules.Tensor.ringSheaf X.O) g t ht
  have hβ := (mapDerivedCategory_map_eq_restrictComplexMapAlong X g
    (coevaluationUnitHom X Mc Nc hMk hNk η) _ hβ₁).trans
      (congrArg (_ ≫ ·) (congrArg DerivedCategory.Q.map
        (restrictComplexMapAlong_cocycleHomOver X g t ht)))
  rw [hη] at hβ
  exact isPseudoCoherentFrom_of_iso (X.over W) (m - 1)
    (isPseudoCoherentFrom_slice_step W m Mc Nc hMk hNk hNflat γ E hE ι hι b hb tdeg rdeg hdeg
      a b' _ ht₀ hab hβ)
    (((ovF X W).mapDerivedCategory.mapIso eM).symm ≪≫ (ovF X W).mapDerivedCategoryFactors.app Mc)

end AlgebraicGeometry.RingedSite.InvertibleDerived

end
