/-!
# Clause (3) of Stacks 0FPY implies clause (2) on a locally ringed site

Let `(C, O)` be a locally ringed site and let `M` be an object of `D(O)` which, over each member
`U_i` of a covering of every object, is an invertible `O_{U_i}`-module placed in a degree `n_i`.
Then on such a member the cohomology sheaves `H^k(M)` vanish for `k ≠ n_i` and `H^{n_i}(M)` is
locally generated freely by a single section, so the degree-projection idempotents
`δ_{n, n_i} ∈ O(U_i)` form a local splitting of the cohomology of `M` there. These glue to a
locally finite complete family of orthogonal idempotents of `Γ(C, O)` acting on the cohomology
sheaves as the degree projections, each `H^n(M)` is invertible over the factor `e_n O`, and
`M = ⨁ H^n(M)[-n]` is as in clause (2).

## Main results

* `AlgebraicGeometry.RingedSite.InvertibleDerived.restrictComplexHomologyIso`: the cohomology of
  the restriction of a complex to a slice is the restriction of its cohomology.
* `AlgebraicGeometry.RingedSite.InvertibleDerived.genSieve_mem_of_isInvertibleModuleOver`: on a
  locally ringed site, a module which is invertible over a slice is, on a covering of the slice,
  freely generated by a single section.
* `InvertibleDerived.hasInvertibleModuleDecomposition_of_hasLocalInvertibleDegree`:
  the implication `(3) ⟹ (2)` on a locally ringed site.

## References

* [Stacks Project, Tag 0FPY](https://stacks.math.columbia.edu/tag/0FPY)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open Stacks.SheafOfModules.DerivedMonoidal

universe u d

namespace AlgebraicGeometry.RingedSite.InvertibleDerived

open Stacks.Cohomology.InvertibleDerived (ActsOnHomology)

variable {X : RingedSite.{u, u, u}}

/-- Restriction of sections along a composite is the composite of the restrictions. -/
theorem map_comp_apply (F : Mod X.O) {W W' W'' : X.C} (g : W' ⟶ W) (g' : W'' ⟶ W')
    (t : F.val.obj (op W)) :
    (F.val.map (g' ≫ g).op t : F.val.obj (op W'')) = F.val.map g'.op (F.val.map g.op t) :=
  PresheafOfModules.map_comp_apply F.val g.op g'.op t

/-! ### Freely generated modules -/

/-- The sieve of arrows over whose source the sheaf of `O`-modules `F` is freely generated by a
single section: a section `t` such that `c ↦ c • t` is a bijection from the sections of `O` to the
sections of `F` over every object lying over the source. -/
def genSieve (F : Mod X.O) (U : X.C) : Sieve U where
  arrows W _ := ∃ t : F.val.obj (op W), ∀ ⦃W' : X.C⦄ (g' : W' ⟶ W),
    Function.Bijective fun c : (X.O.obj.obj (op W') : Type u) =>
      ringSec c • (F.val.map g'.op t : F.val.obj (op W'))
  downward_closed := fun ⟨t, ht⟩ g => ⟨F.val.map g.op t, fun W' g' => by
    have := ht (g' ≫ g)
    simp only [map_comp_apply F g g' t] at this
    exact this⟩

/-- Restriction of sheaves of modules to a slice preserves homology. -/
theorem preservesHomology_overFunctor' [HasSheafify X.J AddCommGrpCat.{u}]
    [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
    [∀ V : X.C, HasSheafify (X.J.over V) AddCommGrpCat.{u}]
    [∀ V : X.C, (X.J.over V).WEqualsLocallyBijective AddCommGrpCat.{u}] (V : X.C) :
    (SheafOfModules.overFunctor.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf X.O) V).PreservesHomology :=
  Stacks.SheafOfModules.preservesHomology_overFunctor V

/-- **The cohomology of the restriction of a complex to a slice is the restriction of its
cohomology.** -/
def restrictComplexHomologyIso [HasSheafify X.J AddCommGrpCat.{u}]
    [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
    [∀ V : X.C, HasSheafify (X.J.over V) AddCommGrpCat.{u}]
    [∀ V : X.C, (X.J.over V).WEqualsLocallyBijective AddCommGrpCat.{u}]
    (E : CochainComplex (Mod X.O) ℤ) (V : X.C) (k : ℤ) :
    (X.restrictComplex E V).homology k ≅
      (SheafOfModules.overFunctor (Stacks.SheafOfModules.Tensor.ringSheaf X.O) V).obj
        (E.homology k) :=
  haveI := preservesHomology_overFunctor' (X := X) V
  (E.sc k).mapHomologyIso
    (SheafOfModules.overFunctor (Stacks.SheafOfModules.Tensor.ringSheaf X.O) V)

/-- The sections of a sheaf of modules whose restriction to a slice is zero vanish over every
object of the slice. -/
theorem eq_zero_of_isZero_over {F : Mod X.O} {V : X.C}
    (h : IsZero ((SheafOfModules.overFunctor (Stacks.SheafOfModules.Tensor.ringSheaf X.O) V).obj F))
    ⦃W : X.C⦄ (g : W ⟶ V) (m : F.val.obj (op W)) : m = 0 :=
  congrArg (fun φ => (φ.val.app (op (Over.mk g))).hom m) (h.eq_of_src (𝟙 _) 0)

/-! ### Invertible modules on a locally ringed site are locally generated by one section -/

/-- **On a locally ringed site an invertible module over a slice is locally generated by a single
section.** If the restriction of `F` to the slice over `V` is an invertible module there, then
`F` is freely generated by a single section on a covering of `V`. -/
theorem genSieve_mem_of_isInvertibleModuleOver (hX : IsLocallyRinged X) (F : Mod X.O) (V : X.C)
    (hF : IsInvertibleModuleOver X V
      ((SheafOfModules.overFunctor (Stacks.SheafOfModules.Tensor.ringSheaf X.O) V).obj F)) :
    genSieve F V ∈ X.J V := by
  set L := (SheafOfModules.overFunctor (Stacks.SheafOfModules.Tensor.ringSheaf X.O) V).obj F
  have hloc : LocallyEitherUnit (X.O.over V) := (isLocallyRinged_over X V hX).2
  have : Stacks.SheafOfModules.IsInvertible (X.O.over V).obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over V).property L := hF
  obtain ⟨I, Vi, fi, hcov, hiso⟩ := Stacks.SheafOfModules.exists_cover_over_iso_unit (X.O.over V)
    ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over V).property L hloc (Over.mk (𝟙 V))
  rw [GrothendieckTopology.mem_over_iff] at hcov
  refine X.J.superset_covering (fun W g hg => ?_) hcov
  rw [Sieve.overEquiv_iff] at hg
  obtain ⟨Z, a, b, ⟨i⟩, hab⟩ := hg
  obtain ⟨ε⟩ := hiso i
  obtain ⟨e, he⟩ := Stacks.SheafOfModules.exists_smulSectionMap_bijective_of_over_iso_unit ε
  refine ⟨F.val.map a.left.op e, fun W' g' => ?_⟩
  let Vo : (Over (Vi i))ᵒᵖ := op (Over.mk (Over.homMk (g' ≫ a.left) (by
    simp only [Over.mk_left, Over.mk_hom, Category.assoc, Over.w a]) :
      Over.mk (g' ≫ a.left ≫ (Vi i).hom) ⟶ Vi i))
  rw [← map_comp_apply F a.left g' e]
  exact he Vo

/-! ### Objects on which the complex is one invertible module in one degree -/

variable [HasSheafify X.J AddCommGrpCat.{u}] [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- `K` is, over the object `W`, concentrated in degree `n`, where its cohomology is freely
generated by a single section on a covering of `W`. -/
def IsGoodAt (K : CochainComplex (Mod X.O) ℤ) (W : X.C) (n : ℤ) : Prop :=
  (∀ k : ℤ, k ≠ n → ∀ ⦃W' : X.C⦄ (_ : W' ⟶ W) (m : (K.homology k).val.obj (op W')), m = 0) ∧
    genSieve (K.homology n) W ∈ X.J W

namespace IsGoodAt

variable {K : CochainComplex (Mod X.O) ℤ}

/-- If `K` is good at `W` in degree `n`, then it is good in degree `n` at the source of every
arrow into `W`. -/
theorem map {W : X.C} {n : ℤ} (h : IsGoodAt K W n) {W' : X.C} (g : W' ⟶ W) :
    IsGoodAt K W' n :=
  ⟨fun k hk _ g' m => h.1 k hk (g' ≫ g) m,
    X.J.superset_covering (fun _ _ hg' => hg') (X.J.pullback_stable g h.2)⟩

/-- A section of `O` over an object where `K` is good, which kills the cohomology in the good
degree, vanishes. -/
theorem eq_zero_of_smul {W : X.C} {n : ℤ} (h : IsGoodAt K W n) (t : (X.O.obj.obj (op W) : Type u))
    (ht : ∀ ⦃W' : X.C⦄ (g' : W' ⟶ W) (m : (K.homology n).val.obj (op W')),
      ringSec (X.O.obj.map g'.op t) • m = 0) : t = 0 := by
  refine eq_of_locally_eq h.2 _ _ fun W' g' ⟨s, hs⟩ => ?_
  rw [map_zero]
  exact (hs (𝟙 W')).1 ((ht g' _).trans (zero_smul _ _).symm)

/-- If `K` is good at `W` in two different degrees, then the ring of sections over `W` is the
zero ring. -/
theorem subsingleton {W : X.C} {n m : ℤ} (hn : IsGoodAt K W n) (hm : IsGoodAt K W m)
    (hnm : n ≠ m) : Subsingleton (X.O.obj.obj (op W) : Type u) :=
  subsingleton_of_zero_eq_one (hn.eq_zero_of_smul 1 fun _ g' _ => hm.1 n hnm g' _).symm

/-- The local splitting over an object where `K` is good. -/
def localSplitting [DecidableEq ℤ] {W : X.C} {n : ℤ} (h : IsGoodAt K W n) :
    LocalSplitting K W where
  T := {n}
  f k := if k = n then 1 else 0
  idem k := by split_ifs <;> simp [IsIdempotentElem]
  ortho k l hkl := by split_ifs with h1 h2 <;> simp_all
  eq_zero k hk := ite_eq_right (by simpa using hk)
  sum_eq_one := by simp
  smul l k W' g m := by
    by_cases hln : l = n
    · subst hln
      rw [ite_eq_left rfl, map_one]
      change (1 : (Stacks.SheafOfModules.Tensor.ringSheaf X.O).obj.obj (op W')) • m = _
      rw [one_smul]
      split_ifs with hkl
      · rfl
      · exact h.1 k hkl g m
    · rw [ite_eq_right hln, map_zero]
      change (0 : (Stacks.SheafOfModules.Tensor.ringSheaf X.O).obj.obj (op W')) • m = _
      rw [zero_smul]
      split_ifs with hkl
      · subst hkl
        exact (h.1 _ hln g m).symm
      · rfl
  faithful W' g t ht := (h.map g).eq_zero_of_smul t fun W'' g' m => ht n g' m

end IsGoodAt

/-- The sieve of arrows over whose source `K` is good in some degree. -/
def goodSieve (K : CochainComplex (Mod X.O) ℤ) (U : X.C) : Sieve U where
  arrows W _ := ∃ n, IsGoodAt K W n
  downward_closed := fun ⟨n, h⟩ g => ⟨n, h.map g⟩

/-! ### Invertibility over the factors -/

section Invertible

variable {K : CochainComplex (Mod X.O) ℤ} (hK : ∀ U : X.C, goodSieve K U ∈ X.J U)

include hK in
/-- If `K` is good in some degree on a covering of every object, then `K` has a local splitting
on a covering of every object. -/
theorem splittingSieve_mem (U : X.C) : splittingSieve K U ∈ X.J U := by
  classical
  refine X.J.superset_covering ?_ (hK U)
  rintro W g ⟨n, h⟩
  exact ⟨h.localSplitting⟩

/-- The glued idempotents of a complex which is good on a covering of every object. -/
abbrev goodIdempotents : LocallyFiniteIdempotents X :=
  glueIdempotents (splittingSieve_mem hK)

include hK in
/-- Over an object where `K` is good in degree `n`, the glued idempotent `e_k` is `1` if `k = n`
and `0` otherwise. -/
theorem goodIdempotents_val [DecidableEq ℤ] (k : ℤ) {W : X.C} {n : ℤ} (h : IsGoodAt K W n) :
    ((goodIdempotents hK).e k).val (op W) = if k = n then 1 else 0 :=
  glueIdempotents_val _ k h.localSplitting

/-- The sieve of arrows over whose source the factor module of `H^n(K)` is freely generated by
a single section over the corner rings. -/
def factorGenSieve (n : ℤ) (U : X.C) : Sieve U where
  arrows W _ := ∃ t : (K.homology n).val.obj (op W), ∀ ⦃W' : X.C⦄ (g' : W' ⟶ W),
    Function.Bijective fun c : (goodIdempotents hK).Corner n (op W') =>
      ringSec c.1 • ((K.homology n).val.map g'.op t : (K.homology n).val.obj (op W'))
  downward_closed := fun ⟨t, ht⟩ g => ⟨(K.homology n).val.map g.op t, fun W' g' => by
    have := ht (g' ≫ g)
    simp only [map_comp_apply (K.homology n) g g' t] at this
    exact this⟩

include hK in
/-- The factor module of `H^n(K)` is freely generated by a single section over the corner rings
on a covering of every object. -/
theorem factorGenSieve_mem (n : ℤ) (U : X.C) : factorGenSieve hK n U ∈ X.J U := by
  classical
  refine X.J.transitive (hK U) _ fun W f ⟨d, hd⟩ => ?_
  by_cases hdn : d = n
  · subst hdn
    refine X.J.superset_covering ?_ (X.J.pullback_stable (𝟙 W) hd.2)
    intro W' g ⟨t, ht⟩
    refine ⟨t, fun W'' g' => ?_⟩
    simp only at ht
    have hW'' : ((goodIdempotents hK).e d).val (op W'') = 1 := by
      rw [goodIdempotents_val hK d (hd.map (g' ≫ g)), ite_eq_left rfl]
    have hval : Function.Bijective fun c : (goodIdempotents hK).Corner d (op W'') =>
        (c.1 : (X.O.obj.obj (op W'') : Type u)) :=
      ⟨Subtype.val_injective, fun r => ⟨⟨r,
        (Stacks.Cohomology.InvertibleDerived.mem_corner_iff_of_comm
        ((goodIdempotents hK).idem d (op W''))).mpr (by
        rw [hW'', one_mul])⟩, rfl⟩⟩
    exact (ht g').comp hval
  · refine X.J.superset_covering (fun W' g _ => ?_) (X.J.top_mem _)
    refine ⟨0, fun W'' g' => ?_⟩
    have h0 : ((goodIdempotents hK).e n).val (op W'') = 0 := by
      rw [goodIdempotents_val hK n ((hd.map g).map g'), ite_eq_right (Ne.symm hdn)]
    have : Subsingleton ((goodIdempotents hK).Corner n (op W'')) :=
      ⟨fun a b => Subtype.ext (((goodIdempotents hK).corner_val_eq_zero h0 a).trans
        ((goodIdempotents hK).corner_val_eq_zero h0 b).symm)⟩
    refine ⟨fun a b _ => Subsingleton.elim a b, fun m => ⟨0, ?_⟩⟩
    exact (hd.1 n (Ne.symm hdn) (g' ≫ g) _).trans (hd.1 n (Ne.symm hdn) (g' ≫ g) m).symm

include hK in
/-- **Each `H^n(K)` is invertible over the factor `e_n O`.** -/
theorem isInvertibleModule_factorModule (n : ℤ) :
    Stacks.SheafOfModules.Tensor.IsInvertibleModule ((goodIdempotents hK).factor n)
      (LocallyFiniteIdempotents.factorModule
        (actsAsOne_homology (actsOnHomology_glueIdempotents (splittingSieve_mem hK)) n)) := by
  let P : X.C → Prop := fun W => factorGenSieve hK n W (𝟙 W)
  have hcov : X.J.CoversTop (fun i : {W : X.C // P W} => i.1) := fun U =>
    X.J.superset_covering (fun W _ hf => ⟨⟨W, hf⟩, ⟨𝟙 W⟩⟩) (factorGenSieve_mem hK n U)
  exact Stacks.SheafOfModules.isInvertible_of_dualBasisOne _ _ hcov fun i =>
    Stacks.SheafOfModules.DualBasisOne.ofSmulBijective i.1 i.2.choose fun V =>
      i.2.choose_spec V.unop.hom

end Invertible

/-! ### The implication `(3) ⟹ (2)` -/

attribute [local instance] Stacks.SheafOfModules.LocalCokernel.overFunctor_preservesFiniteLimits
  Stacks.SheafOfModules.LocalCokernel.overFunctor_preservesFiniteColimits

/-- **The implication `(3) ⟹ (2)` of Stacks 0FPY.** Let `(C, O)` be a locally ringed site and let
`M` be an object of `D(O)` which, over each member of a covering of every object, is an invertible
module placed in a single degree — clause (3). Then there is a locally finite direct product
decomposition `O = ∏ O_n` and invertible `O_n`-modules `ℋ^n` with `M = ⨁ ℋ^n[-n]` — clause (2). -/
theorem hasInvertibleModuleDecomposition_of_hasLocalInvertibleDegree
    [∀ V : X.C, HasSheafify (X.J.over V) AddCommGrpCat.{u}]
    [∀ V : X.C, (X.J.over V).WEqualsLocallyBijective AddCommGrpCat.{u}]
    [HasDerivedCategory.{d} (Mod X.O)] (M : DerivedCategory (Mod X.O))
    (hM : HasLocalInvertibleDegree X M) (hX : IsLocallyRinged X) :
    HasInvertibleModuleDecomposition X M := by
  let E := DerivedCategory.Q.objPreimage M
  let eM : DerivedCategory.Q.obj E ≅ M := DerivedCategory.Q.objObjPreimageIso M
  have hgood : ∀ U : X.C, goodSieve E U ∈ X.J U := by
    intro U
    obtain ⟨S, hS, hdata⟩ := hM U
    refine X.J.superset_covering ?_ hS
    rintro W _ ⟨V, g, f, hf, rfl⟩
    obtain ⟨n, L, hL, hiso⟩ := hdata f hf
    let := HasDerivedCategory.standard
      (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over V))
    obtain ⟨ψ⟩ := hiso
    refine (goodSieve E U).downward_closed ?_ g
    let ψ' : DerivedCategory.Q.obj (X.restrictComplex E V) ≅
        DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ n).obj L) :=
      restrictComplexDerivedIso X eM ≪≫ ψ ≪≫ (DerivedCategory.singleFunctorIsoCompQ
        (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over V)) n).app L
    let φ : ∀ k, (E.homology k).over V ≅
        ((CochainComplex.singleFunctor _ n).obj L).homology k := fun k =>
      (restrictComplexHomologyIso E V k).symm ≪≫
        ((DerivedCategory.homologyFunctorFactors _ k).app _).symm ≪≫
          (DerivedCategory.homologyFunctor _ k).mapIso ψ' ≪≫
            (DerivedCategory.homologyFunctorFactors _ k).app _
    refine ⟨n, fun k hk W' g' m => ?_, ?_⟩
    · refine eq_zero_of_isZero_over ?_ g' m
      exact (HomologicalComplex.isZero_single_obj_homology _ _ _ _ hk).of_iso (φ k)
    · refine genSieve_mem_of_isInvertibleModuleOver hX (E.homology n) V ?_
      have : Stacks.SheafOfModules.IsInvertible (X.O.over V).obj
          ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over V).property L := hL
      exact Stacks.SheafOfModules.isInvertible_of_iso _ _
        ((HomologicalComplex.singleObjHomologySelfIso _ _ L).symm ≪≫ (φ n).symm)
  obtain ⟨D, H, hH, ⟨e⟩⟩ := hasInvertibleModuleDecomposition_of_idempotents
    (actsOnHomology_glueIdempotents (splittingSieve_mem hgood))
    (isInvertibleModule_factorModule hgood)
  exact ⟨D, H, hH, ⟨eM.symm ≪≫ e⟩⟩

/-- **Clauses (2) and (3) of Stacks 0FPY are equivalent on a locally ringed site.** -/
theorem hasInvertibleModuleDecomposition_iff_hasLocalInvertibleDegree
    [∀ V : X.C, HasSheafify (X.J.over V) AddCommGrpCat.{u}]
    [∀ V : X.C, (X.J.over V).WEqualsLocallyBijective AddCommGrpCat.{u}]
    [HasDerivedCategory.{d} (Mod X.O)] (M : DerivedCategory (Mod X.O)) (hX : IsLocallyRinged X) :
    HasInvertibleModuleDecomposition X M ↔ HasLocalInvertibleDegree X M :=
  ⟨fun h => hasLocalInvertibleDegree_of_hasInvertibleModuleDecomposition M h hX,
    fun h => hasInvertibleModuleDecomposition_of_hasLocalInvertibleDegree M h hX⟩

end AlgebraicGeometry.RingedSite.InvertibleDerived

end
