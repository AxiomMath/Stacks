namespace StacksDraft.StupidTruncation

variable {A : Type*} [Category* A] [Abelian A]

/-- **The inclusion of a brutal truncation is an epimorphism on cohomology in the truncation
degree.** The cycles of `σ^{≥a}K` and of `K` in degree `a` agree, and the cohomology of `σ^{≥a}K`
in degree `a` is all of its cycles. -/
theorem epi_homologyMap_ιStupidTruncGE (K : CochainComplex A ℤ) (a : ℤ) :
    Epi (HomologicalComplex.homologyMap (ιStupidTrunc K (embeddingUpIntGE a)) a) := by
  have h₂ : IsIso ((ιStupidTrunc K (embeddingUpIntGE a)).f a) := by
    rw [ιStupidTruncGE_f K a a le_rfl]
    infer_instance
  have h₃ : IsIso ((ιStupidTrunc K (embeddingUpIntGE a)).f (a + 1)) := by
    rw [ιStupidTruncGE_f K a (a + 1) (by omega)]
    infer_instance
  have hc : IsIso (HomologicalComplex.cyclesMap (ιStupidTrunc K (embeddingUpIntGE a)) a) := by
    refine ShortComplex.isIso_cyclesMap_of_isIso_of_mono'
      ((HomologicalComplex.shortComplexFunctor A (ComplexShape.up ℤ) a).map
        (ιStupidTrunc K (embeddingUpIntGE a))) h₂ ?_
    show Mono ((ιStupidTrunc K (embeddingUpIntGE a)).f ((ComplexShape.up ℤ).next a))
    rw [CochainComplex.next]
    infer_instance
  have : Epi (HomologicalComplex.homologyπ (K.stupidTrunc (embeddingUpIntGE a)) a ≫
      HomologicalComplex.homologyMap (ιStupidTrunc K (embeddingUpIntGE a)) a) := by
    rw [HomologicalComplex.homologyπ_naturality]
    infer_instance
  exact epi_of_epi (HomologicalComplex.homologyπ _ a) _

end StacksDraft.StupidTruncation


