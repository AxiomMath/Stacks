/-- A finite biproduct of copies of the unit module on a slice is a direct summand of a finite
free module. -/
theorem isDirectSummandOfFiniteFree_biproduct_unit (W : X.C) (κ : Type) [Fintype κ]
    [HasFiniteBiproducts
      (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W))] :
    IsDirectSummandOfFiniteFree ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W)
      (⨁ fun _ : κ =>
        SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W)) := by
  classical
  let eF : (⨁ fun _ : κ => SheafOfModules.unit
        ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W)) ≅
      SheafOfModules.free (R := (Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W)
        (ULift.{u} (Fin (Fintype.card κ))) :=
    biproduct.isoCoproduct _ ≪≫
      Sigma.whiskerEquiv
        (f := fun _ : κ =>
          SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W))
        (g := fun _ : ULift.{u} (Fin (Fintype.card κ)) =>
          SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W))
        ((Fintype.equivFin κ).trans Equiv.ulift.symm) (fun _ => Iso.refl _)
  exact (isDirectSummandOfFiniteFree_iff_free _ _).mpr ⟨_, eF.hom, eF.inv, eF.hom_inv_id⟩

/-- **The descending step of the pseudo-coherence induction, on one slice.** Let `M^•` represent
`M` and let `ε : E ⟶ M^•` be a morphism from a strictly perfect complex `E` concentrated in
degrees `> k` which is an isomorphism in every degree `> k`. Let `N^•` be a complex of flat
modules and let `a i` be finitely many sections of the terms of `M^•` over `W` such that `M|_W`
is a retract of `K` along `Q(j)` for every morphism of complexes `j : K ⟶ M^•|_W` on the slice
which stays a monomorphism after `- ⊗ N^•|_W` in degree `1` and through which the `a i` lift over
the final object. Then `M|_W` is `k`-pseudo-coherent.

The subcomplex `K` generated by the `a i` and the image of `E` is such a `j`; it agrees with
`M^•|_W` above `k`, and its term in degree `k` is a quotient of a finite free module, so it is
`k`-pseudo-coherent, and so is its direct summand `M|_W`. -/
theorem isPseudoCoherentFrom_restriction_of_sliceRetract (W : X.C)
    (M : Stacks.SheafOfModules.DerivedMonoidal.DerivedModules X.O)
    (Mc Nc : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O)
    (eM : DerivedCategory.Q.obj Mc ≅ M)
    (hNflat : ∀ q : ℤ, AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u} (O := X.O) (Nc.X q))
    (k : ℤ) (E : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O)
    (hE : IsStrictlyPerfect (Stacks.SheafOfModules.Tensor.ringSheaf X.O) E)
    (hEk : ∀ i, i ≤ k → IsZero (E.X i)) (ε : E ⟶ Mc) (hε : ∀ n, k < n → IsIso (ε.f n))
    (κ : Type) [Fintype κ] (deg : κ → ℤ) (a : ∀ i, (Mc.X (deg i)).val.obj (op W))
    (hR : ∀ (K : Stacks.SheafOfModules.DerivedMonoidal.Complexes (X.O.over W))
      (j : K ⟶ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Mc),
      Mono ((j ▷ ((restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)).obj Nc).f 1) →
      (∀ i, ∃ y : (K.X (deg i)).val.obj (op (Over.mk (𝟙 W))),
        (j.f (deg i)).val.app (op (Over.mk (𝟙 W))) y = a i) →
      ∃ sec : (restriction X W).mapDerivedCategory.obj M ⟶ DerivedCategory.Q.obj K,
        sec ≫ DerivedCategory.Q.map j ≫
          (restriction X W).mapDerivedCategoryFactors.inv.app Mc ≫
            (restriction X W).mapDerivedCategory.map eM.hom = 𝟙 _) :
    (X.over W).IsPseudoCoherentFrom ((restriction X W).mapDerivedCategory.obj M) k := by
  classical
  let Fc := (restriction X W).mapHomologicalComplex (ComplexShape.up ℤ)
  let hT : IsTerminal (Over.mk (𝟙 W)) := Over.mkIdTerminal
  let e := fun (F : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W)) =>
    Stacks.Sites.ExtensionByZero.unitHomEquivOfTerminal (X.J.over W)
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W) (Over.mk (𝟙 W)) hT F
  let g : ∀ i, (fun _ : κ =>
      SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W)) i ⟶
        (Fc.obj Mc).X (deg i) :=
    fun i => (e ((Fc.obj Mc).X (deg i))).symm (a i)
  obtain ⟨K, θ, ρ, hθ, hρθ, hlift, hq⟩ :=
    CochainComplex.exists_subcomplex_generated (Fc.obj Mc) deg
      (fun _ : κ => SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W)) g
      (Fc.map ε)
  have hfl : ∀ q : ℤ, AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u} (O := X.O.over W)
      ((Fc.obj Nc).X q) := fun q =>
    Stacks.SheafOfModules.FlatRestriction.isFlat_over X W (Nc.X q) (hNflat q)
  have hmono : Mono ((θ ▷ Fc.obj Nc).f 1) :=
    Stacks.Cohomology.LeftDualPerfect.mono_mapBifunctorMap_f_general (R := X.O.over W) θ hfl 1
  have hy : ∀ i, ∃ y : (K.X (deg i)).val.obj (op (Over.mk (𝟙 W))),
      (θ.f (deg i)).val.app (op (Over.mk (𝟙 W))) y = a i := by
    intro i
    obtain ⟨t, ht⟩ := hlift i
    refine ⟨e (K.X (deg i)) t, ?_⟩
    exact (Stacks.Sites.ExtensionByZero.unitHomEquivOfTerminal_naturality (X.J.over W)
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W)
      (Over.mk (𝟙 W)) hT t (θ.f (deg i))).symm.trans
        ((congrArg (e ((Fc.obj Mc).X (deg i))) ht).trans (Equiv.apply_symm_apply _ _))
  obtain ⟨sec, hsec⟩ := hR K θ hmono hy
  have hρ : ∀ n, k < n → IsIso (ρ.f n) := by
    intro n hn
    have h1 : IsIso (ρ.f n ≫ θ.f n) := by
      rw [← HomologicalComplex.comp_f, hρθ]
      have := hε n hn
      exact Functor.map_isIso (restriction X W) (ε.f n)
    have : Epi (θ.f n) := epi_of_epi (ρ.f n) (θ.f n)
    have : IsIso (θ.f n) := isIso_of_mono_of_epi _
    exact IsIso.of_isIso_comp_right _ (θ.f n)
  obtain ⟨q, hqe⟩ := hq k
  have hK : (X.over W).IsPseudoCoherentFrom (DerivedCategory.Q.obj K) k :=
    isPseudoCoherentFrom_Q_of_tail (X.over W) K k (Fc.obj E)
      (isStrictlyPerfect_over_general X W hE)
      (fun i hi => (restriction X W).map_isZero (hEk i hi)) ρ hρ _ ?_ q
  obtain ⟨Z, iso, -⟩ := CategoryTheory.Pretriangulated.exists_iso_biprod_of_retraction sec _ hsec
  exact isPseudoCoherentFrom_left_of_biprod_general (X.over W) _ Z k
    (isPseudoCoherentFrom_of_iso (X.over W) k hK iso.symm)
  have : HasFiniteBiproducts
      (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W)) :=
    Abelian.hasFiniteBiproducts
  have hP := isDirectSummandOfFiniteFree_biproduct_unit X W κ
  exact IsDirectSummandOfFiniteFree.biprod _ (IsDirectSummandOfFiniteFree.biprod _ hP hP)
    ((isStrictlyPerfect_over_general X W hE).termDirectSummand k)

/-- **The descending step of the pseudo-coherence induction of Stacks 0FPV.** Let `M` have a
left dual `N` in `D(O)`, and let `α : E ⟶ M` be an approximation of `M` in degree `m` by a
strictly perfect complex `E` concentrated in degrees `≥ m`: it is an isomorphism on cohomology in
every degree `> m` and an epimorphism in degree `m`. Then `M` is `(m - 1)`-pseudo-coherent.

`M` is the cone of a morphism `𝓛⟦-1⟧ ⟶ E` with `𝓛` a complex of flat modules concentrated in
degrees `≤ m - 1`; that cone is K-flat and agrees with `E` above `m - 1`. Along a covering, the
retract of `exists_presieve_sliceRetract` and
`isPseudoCoherentFrom_restriction_of_sliceRetract` make each restriction `M|_W`
`(m - 1)`-pseudo-coherent, and pseudo-coherence is local. -/
theorem isPseudoCoherentFrom_sub_one_of_approximation
    (M N : Stacks.SheafOfModules.DerivedMonoidal.DerivedModules X.O)
    (pair : letI := derivedMonoidal X.O; ExactPairing M N) (m : ℤ)
    (E : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O)
    (hE : IsStrictlyPerfect (Stacks.SheafOfModules.Tensor.ringSheaf X.O) E) [E.IsStrictlyGE m]
    (α : DerivedCategory.Q.obj E ⟶ M)
    (hα : ∀ i, m < i → IsIso ((DerivedCategory.homologyFunctor _ i).map α))
    (hαm : Epi ((DerivedCategory.homologyFunctor _ m).map α)) :
    X.IsPseudoCoherentFrom M (m - 1) := by
  classical
  obtain ⟨L, hLLE, hLflat, ψ, eM, -⟩ := exists_coneRepresentative X M m E α hα hαm
  have hEk : Stacks.SheafOfModules.DerivedMonoidal.KFlat X.O E :=
    kFlat_of_isStrictlyPerfect X E hE
  have hLk : Stacks.SheafOfModules.DerivedMonoidal.KFlat X.O L :=
    Stacks.SheafOfModules.kFlat_of_boundedAbove_of_flat X.O L ⟨m - 1, hLLE⟩ hLflat
  have hMk : Stacks.SheafOfModules.DerivedMonoidal.KFlat X.O (CochainComplex.mappingCone ψ) :=
    CochainComplex.KFlatBifunctor.kFlat_splice _ E L ψ hEk hLk
  obtain ⟨Nc, pN, hNk, hNflat, hpN, -⟩ :=
    Stacks.SheafOfModules.KFlatResolution.exists_kFlatResolution X.O
      (DerivedCategory.Q.objPreimage N)
  have hN' : IsIso (DerivedCategory.Q.map pN) :=
    (DerivedCategory.isIso_Q_map_iff_quasiIso
      (C := Stacks.SheafOfModules.DerivedMonoidal.Mod X.O) pN).2 hpN
  have hε : ∀ n, m - 1 < n → IsIso ((CochainComplex.mappingCone.inr ψ).f n) := fun n hn =>
    CochainComplex.mappingCone.isIso_inr_f ψ n
      ((L.isZero_of_isStrictlyLE (m - 1) n (by lia)).of_iso
        (L.shiftFunctorObjXIso (-1) (n + 1) n (by lia)))
  refine isPseudoCoherentFrom_of_locally_general X M (m - 1) fun U => ?_
  obtain ⟨S, hS, hdata⟩ := exists_presieve_sliceRetract X U M N pair
    (CochainComplex.mappingCone ψ) Nc eM
    (asIso (DerivedCategory.Q.map pN) ≪≫ DerivedCategory.Q.objObjPreimageIso N) hMk hNk
  refine ⟨S, hS, fun {W} h hh => ?_⟩
  obtain ⟨κ, hκ, deg, a, hR⟩ := hdata h hh
  exact isPseudoCoherentFrom_restriction_of_sliceRetract X W M _ Nc eM hNflat (m - 1) E hE
    (fun i hi => E.isZero_of_isStrictlyGE m i (by lia)) (CochainComplex.mappingCone.inr ψ) hε
    κ deg a hR

omit [∀ U : X.C, HasSheafify (X.J.over U) AddCommGrpCat.{u}]
  [∀ U : X.C, (X.J.over U).WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- The image of a composite with an isomorphism is an isomorphism when the image of the first
factor is. -/
private theorem isIso_map_comp {C D : Type*} [Category* C] [Category* D] (F : C ⥤ D)
    {a b c : C} (f : a ⟶ b) (g : b ⟶ c) (hf : IsIso (F.map f)) (hg : IsIso g) :
    IsIso (F.map (f ≫ g)) := by
  rw [F.map_comp]; infer_instance

omit [∀ U : X.C, HasSheafify (X.J.over U) AddCommGrpCat.{u}]
  [∀ U : X.C, (X.J.over U).WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- The image of a composite with an isomorphism is an epimorphism when the image of the first
factor is. -/
private theorem epi_map_comp {C D : Type*} [Category* C] [Category* D] (F : C ⥤ D)
    {a b c : C} (f : a ⟶ b) (g : b ⟶ c) (hf : Epi (F.map f)) (hg : IsIso g) :
    Epi (F.map (f ≫ g)) := by
  rw [F.map_comp]; infer_instance

/-- **The pseudo-coherence of a dualizable object descends by one degree.** If `M` has a left
dual in `D(O)` and is `m`-pseudo-coherent, then it is `(m - 1)`-pseudo-coherent.

Locally `M` is approximated in degree `m` by a strictly perfect complex `P`, and by its brutal
truncation `σ^{≥m}P`, which is concentrated in degrees `≥ m`; the restriction of `M` keeps a
left dual by `AlgebraicGeometry.RingedSite.exactPairingRestrict`, so
`isPseudoCoherentFrom_sub_one_of_approximation` applies on each slice, and pseudo-coherence is
local. -/
theorem isPseudoCoherentFrom_sub_one_of_isPseudoCoherentFrom
    (M N : Stacks.SheafOfModules.DerivedMonoidal.DerivedModules X.O)
    (pair : letI := derivedMonoidal X.O; ExactPairing M N) (m : ℤ)
    (h : X.IsPseudoCoherentFrom M m) :
    X.IsPseudoCoherentFrom M (m - 1) := by
  classical
  obtain ⟨K, hK, ⟨eK⟩⟩ := h
  refine isPseudoCoherentFrom_of_locally_general X M (m - 1) fun U => ?_
  obtain ⟨S, hS, hdata⟩ := hK U
  refine ⟨S, hS, fun {V} f hf => ?_⟩
  obtain ⟨P, hP, α, hα, hαm⟩ := hdata f hf
  let iso : DerivedCategory.Q.obj (X.restrictComplex K V) ≅
      (restriction X V).mapDerivedCategory.obj M :=
    ((restriction X V).mapDerivedCategoryFactors.app K).symm ≪≫
      (restriction X V).mapDerivedCategory.mapIso eK
  let E : Stacks.SheafOfModules.DerivedMonoidal.Complexes (X.over V).O :=
    P.stupidTrunc (embeddingUpIntGE m)
  have : E.IsStrictlyGE m := by
    rw [CochainComplex.isStrictlyGE_iff]
    exact fun i hi => P.isZero_stupidTrunc_X (embeddingUpIntGE m) i
      (by rw [ComplexShape.notMem_range_embeddingUpIntGE_iff]; lia)
  let β := ιStupidTrunc P (embeddingUpIntGE m) ≫ α
  have hβ := isIso_and_epi_homologyMap_comp (ιStupidTrunc P (embeddingUpIntGE m)) α m
    ⟨StacksDraft.StupidTruncation.isIso_homologyMap_ιStupidTruncGE P m,
      StacksDraft.StupidTruncation.epi_homologyMap_ιStupidTruncGE P m⟩ ⟨hα, hαm⟩
  refine isPseudoCoherentFrom_sub_one_of_approximation (X.over V)
    ((restriction X V).mapDerivedCategory.obj M) ((restriction X V).mapDerivedCategory.obj N)
    (exactPairingRestrict X V M N pair) m E
    (Stacks.SheafOfModules.isStrictlyPerfect_stupidTrunc_general _ (embeddingUpIntGE m) hP)
    (DerivedCategory.Q.map β ≫ iso.hom) (fun i hi => ?_) ?_
  · have : IsIso ((DerivedCategory.homologyFunctor _ i).map (DerivedCategory.Q.map β)) :=
      (NatIso.isIso_map_iff (DerivedCategory.homologyFunctorFactors _ i) β).2 (hβ.1 i hi)
    exact isIso_map_comp _ _ _ this ⟨⟨iso.inv, iso.hom_inv_id, iso.inv_hom_id⟩⟩
  · have : Epi ((DerivedCategory.homologyFunctor _ m).map (DerivedCategory.Q.map β)) := by
      show Epi ((DerivedCategory.Q ⋙ DerivedCategory.homologyFunctor _ m).map β)
      rw [epi_map_iff_of_natIso (DerivedCategory.homologyFunctorFactors _ m)]
      exact hβ.2
    exact epi_map_comp _ _ _ this ⟨⟨iso.inv, iso.hom_inv_id, iso.inv_hom_id⟩⟩

/-- **A bounded above object of `D(O)` with a left dual is pseudo-coherent**, the pseudo-coherence
half of the proof of Stacks 0FPV. If `M` is concentrated in degrees `≤ b`, it is
`(b + 1)`-pseudo-coherent, its cohomology vanishing from degree `b + 1` on, and
`isPseudoCoherentFrom_sub_one_of_isPseudoCoherentFrom` descends one degree at a time. -/
theorem isPseudoCoherent_of_exactPairing_of_isLE
    (M N : Stacks.SheafOfModules.DerivedMonoidal.DerivedModules X.O)
    (pair : letI := derivedMonoidal X.O; ExactPairing M N) (b : ℤ) (hb : M.IsLE b) :
    X.IsPseudoCoherent M := by
  rw [isPseudoCoherent_iff_forall_isPseudoCoherentFrom]
  have key : ∀ k : ℕ, X.IsPseudoCoherentFrom M (b + 1 - k) := by
    intro k
    induction k with
    | zero =>
      refine isPseudoCoherentFrom_of_isLE_sub_one X M _ ?_
      rwa [show b + 1 - ((0 : ℕ) : ℤ) - 1 = b by lia]
    | succ k ih =>
      rw [show b + 1 - ((k + 1 : ℕ) : ℤ) = b + 1 - k - 1 by push_cast; lia]
      exact isPseudoCoherentFrom_sub_one_of_isPseudoCoherentFrom X M N pair _ ih
  intro n
  by_cases hn : n ≤ b + 1
  · simpa only [show b + 1 - ((b + 1 - n).toNat : ℤ) = n by lia] using key (b + 1 - n).toNat
  · exact isPseudoCoherentFrom_of_isLE_sub_one X M n
      (DerivedCategory.TStructure.t.isLE_of_le M b (n - 1) (by lia))

end PseudoCoherence

