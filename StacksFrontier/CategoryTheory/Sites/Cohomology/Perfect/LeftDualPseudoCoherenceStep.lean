variable (X : RingedSite.{u, u, u})
  [HasSheafify X.J AddCommGrpCat.{u}]
  [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- **The cone of an approximation is concentrated below the approximation degree.** If
`α : E ⟶ M` in `D(O)` is an isomorphism on cohomology in every degree `> m` and an epimorphism in
degree `m`, the third vertex `L` of a distinguished triangle on `α` has no cohomology in degrees
`≥ m`. -/
theorem isLE_of_distTriang_approximation {A : Type*} [Category* A] [Abelian A]
    [HasDerivedCategory A] (T : Triangle (DerivedCategory A)) (hT : T ∈ distTriang _) (m : ℤ)
    (hα : ∀ i, m < i → IsIso ((DerivedCategory.homologyFunctor A i).map T.mor₁))
    (hαm : Epi ((DerivedCategory.homologyFunctor A m).map T.mor₁)) :
    T.obj₃.IsLE (m - 1) := by
  rw [DerivedCategory.isLE_iff]
  intro i hi
  have hepi : Epi ((DerivedCategory.homologyFunctor A i).map T.mor₁) := by
    rcases eq_or_lt_of_le (show m ≤ i by omega) with rfl | h
    · exact hαm
    · have := hα i h
      infer_instance
  have hmono : Mono ((DerivedCategory.homologyFunctor A (i + 1)).map T.mor₁) := by
    have := hα (i + 1) (by omega)
    infer_instance
  have h₂ : (DerivedCategory.homologyFunctor A i).map T.mor₂ = 0 :=
    (DerivedCategory.HomologySequence.epi_homologyMap_mor₁_iff T hT i).1 hepi
  have h₃ : DerivedCategory.HomologySequence.δ T i (i + 1) = 0 :=
    (DerivedCategory.HomologySequence.mono_homologyMap_mor₁_iff T hT i (i + 1)).1 hmono
  have hmono' : Mono (DerivedCategory.HomologySequence.δ T i (i + 1)) :=
    (DerivedCategory.HomologySequence.exact₃ T hT i (i + 1)).mono_g_iff.2 h₂
  rw [h₃] at hmono'
  exact IsZero.of_mono_zero _ ((DerivedCategory.homologyFunctor A (i + 1)).obj T.obj₁)

/-- **The splice representative of an approximated object.** Let `α : E ⟶ M` in `D(O)` be an
isomorphism on cohomology in every degree `> m` and an epimorphism in degree `m`, with `E`
concentrated in degrees `≥ m`. Then `M` is represented by a mapping cone `cone(ψ)` of a morphism
`ψ : 𝓛⟦-1⟧ ⟶ E`, where `𝓛` is a complex of flat modules concentrated in degrees `≤ m - 1`, and
`α` is the image of the inclusion `E ⟶ cone(ψ)`. -/
theorem exists_coneRepresentative (M : Stacks.SheafOfModules.DerivedMonoidal.DerivedModules X.O)
    (m : ℤ) (E : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O)
    [E.IsStrictlyGE m] (α : DerivedCategory.Q.obj E ⟶ M)
    (hα : ∀ i, m < i → IsIso ((DerivedCategory.homologyFunctor _ i).map α))
    (hαm : Epi ((DerivedCategory.homologyFunctor _ m).map α)) :
    ∃ (L : Stacks.SheafOfModules.DerivedMonoidal.Complexes X.O) (_ : L.IsStrictlyLE (m - 1))
      (_ : ∀ i : ℤ, AlgebraicGeometry.SheafOfModules.IsFlat.{u, u, u, u} (O := X.O) (L.X i))
      (ψ : L⟦(-1 : ℤ)⟧ ⟶ E) (eM : DerivedCategory.Q.obj (CochainComplex.mappingCone ψ) ≅ M),
      DerivedCategory.Q.map (CochainComplex.mappingCone.inr ψ) ≫ eM.hom = α := by
  obtain ⟨Z, β, γ, hT⟩ := distinguished_cocone_triangle α
  have hZ : Z.IsLE (m - 1) :=
    isLE_of_distTriang_approximation (Triangle.mk α β γ) hT m hα hαm
  obtain ⟨L, hflat, hLE, ⟨eL⟩⟩ :=
    Stacks.Cohomology.DerivedPullbackOnRingedTopoi.exists_flatRepresentative_of_isLE X Z (m - 1) hZ
  obtain ⟨Mc, ι, π, -, -, hT₂, ψ, e, hιe⟩ :=
    CochainComplex.exists_splice_triangle_mappingCone E L m (eL.hom ≫ γ)
  let T₂ := Triangle.mk (DerivedCategory.Q.map ι) (DerivedCategory.Q.map π) (eL.hom ≫ γ)
  let iso := isoTriangleOfIso₁₃ T₂ (Triangle.mk α β γ) hT₂ hT (Iso.refl _) eL (by
    simp [T₂])
  refine ⟨L, hLE, hflat, ψ, (DerivedCategory.Q.mapIso e).symm ≪≫ Triangle.π₂.mapIso iso, ?_⟩
  have h₁ : DerivedCategory.Q.map ι ≫ iso.hom.hom₂ = α := by
    have := iso.hom.comm₁
    rw [isoTriangleOfIso₁₃_hom_hom₁, Iso.refl_hom] at this
    simpa [T₂] using this
  rw [← hιe]
  show DerivedCategory.Q.map (ι ≫ e.hom) ≫ (DerivedCategory.Q.map e.inv ≫ iso.hom.hom₂) = α
  rw [DerivedCategory.Q.map_comp, Category.assoc, ← Category.assoc (DerivedCategory.Q.map e.hom),
    ← DerivedCategory.Q.map_comp, Iso.hom_inv_id, DerivedCategory.Q.map_id, Category.id_comp]
  exact h₁

section PseudoCoherence

variable [∀ U : X.C, HasSheafify (X.J.over U) AddCommGrpCat.{u}]
  [∀ U : X.C, (X.J.over U).WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- Sheaves of abelian groups on the slice site `X.J.over U` admit weak sheafification. -/
local instance pcStepSliceWeak (U : X.C) : HasWeakSheafify (X.J.over U) AddCommGrpCat.{u} :=
  inferInstance

/-- The restriction functor from sheaves of `O`-modules to sheaves of modules on the slice over
`U` preserves homology. -/
local instance pcStepOverFunctorHomology (U : X.C) :
    (SheafOfModules.overFunctor.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf X.O) U).PreservesHomology :=
  have := Stacks.SheafOfModules.LocalCokernel.overFunctor_preservesFiniteLimits
    (R := Stacks.SheafOfModules.Tensor.ringSheaf X.O) U
  have := Stacks.SheafOfModules.LocalCokernel.overFunctor_preservesFiniteColimits
    (R := Stacks.SheafOfModules.Tensor.ringSheaf X.O) U
  Functor.preservesHomologyOfExact _

/-- Composing two morphisms that are isomorphisms on homology above `k` and epimorphisms on
homology in degree `k` gives such a morphism. -/
private theorem isIso_and_epi_homologyMap_comp {A : Type*} [Category* A] [Abelian A]
    {P Q R : CochainComplex A ℤ} (f : P ⟶ Q) (g : Q ⟶ R) (k : ℤ)
    (hf : (∀ i, k < i → IsIso (HomologicalComplex.homologyMap f i)) ∧
      Epi (HomologicalComplex.homologyMap f k))
    (hg : (∀ i, k < i → IsIso (HomologicalComplex.homologyMap g i)) ∧
      Epi (HomologicalComplex.homologyMap g k)) :
    (∀ i, k < i → IsIso (HomologicalComplex.homologyMap (f ≫ g) i)) ∧
      Epi (HomologicalComplex.homologyMap (f ≫ g) k) := by
  simp only [HomologicalComplex.homologyMap_comp]
  refine ⟨fun i hi => ?_, ?_⟩
  · have := hf.1 i hi
    have := hg.1 i hi
    infer_instance
  · have := hf.2
    have := hg.2
    infer_instance

/-- **Pseudo-coherence passes from a brutal truncation to the complex.** The inclusion
`σ^{≥k}K ⟶ K` is an isomorphism on cohomology above `k` and an epimorphism in degree `k`, so a
strictly perfect approximation of `σ^{≥k}K` composed with it approximates `K`. -/
theorem isPseudoCoherentFrom_Q_of_stupidTruncGE
    (K : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ) (k : ℤ)
    (h : X.IsPseudoCoherentFrom
      (DerivedCategory.Q.obj (K.stupidTrunc (embeddingUpIntGE k))) k) :
    X.IsPseudoCoherentFrom (DerivedCategory.Q.obj K) k := by
  have hA := isPseudoCoherentComplexFrom_of_iso_general X _ k h
    (K.stupidTrunc (embeddingUpIntGE k)) (Iso.refl _)
  refine ⟨K, fun U => ?_, ⟨Iso.refl _⟩⟩
  obtain ⟨S, hS, hdata⟩ := hA U
  refine ⟨S, hS, fun V g hg => ?_⟩
  obtain ⟨P, hP, α, hα, hαk⟩ := hdata g hg
  let F := SheafOfModules.overFunctor.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O) V
  let Fc := F.mapHomologicalComplex (ComplexShape.up ℤ)
  let ι := ιStupidTrunc K (embeddingUpIntGE k)
  refine ⟨P, hP, α ≫ Fc.map ι, isIso_and_epi_homologyMap_comp _ _ k ⟨hα, hαk⟩ ⟨fun i hi => ?_, ?_⟩⟩
  · have : QuasiIsoAt ι i :=
      (quasiIsoAt_iff_isIso_homologyMap _ _).2
        (StacksDraft.StupidTruncation.isIso_homologyMap_ιStupidTruncGE K k i hi)
    exact (quasiIsoAt_iff_isIso_homologyMap _ _).1 inferInstance
  · have hι := StacksDraft.StupidTruncation.epi_homologyMap_ιStupidTruncGE K k
    show Epi ((F.mapShortComplex ⋙ ShortComplex.homologyFunctor _).map
      ((HomologicalComplex.shortComplexFunctor _ _ k).map ι))
    rw [epi_map_iff_of_natIso (ShortComplex.homologyFunctorIso F)]
    exact inferInstanceAs (Epi (F.map (HomologicalComplex.homologyMap ι k)))

/-- A morphism between zero objects is an isomorphism. -/
private theorem isIso_of_isZero_of_isZero' {C : Type*} [Category* C] {P Q : C} (f : P ⟶ Q)
    (hP : IsZero P) (hQ : IsZero Q) : IsIso f :=
  ⟨⟨hQ.to_ P, hP.eq_of_src _ _, hQ.eq_of_src _ _⟩⟩

/-- **A complex is pseudo-coherent one degree below a strictly perfect tail whose next term is
finitely generated.** Let `K` be a complex receiving a morphism `ε : E ⟶ K` from a strictly
perfect complex `E` concentrated in degrees `> k`, which is an isomorphism in every degree `> k`,
and suppose `K^k` is a quotient of a direct summand of a finite free module. Then `K` is
`k`-pseudo-coherent. -/
theorem isPseudoCoherentFrom_Q_of_tail
    (K : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ) (k : ℤ)
    (E : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ)
    (hE : IsStrictlyPerfect (Stacks.SheafOfModules.Tensor.ringSheaf X.O) E)
    (hEk : ∀ i, i ≤ k → IsZero (E.X i)) (ε : E ⟶ K) (hε : ∀ n, k < n → IsIso (ε.f n))
    (F : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))
    (hF : IsDirectSummandOfFiniteFree (Stacks.SheafOfModules.Tensor.ringSheaf X.O) F)
    (q : F ⟶ K.X k) [Epi q] :
    X.IsPseudoCoherentFrom (DerivedCategory.Q.obj K) k := by
  refine isPseudoCoherentFrom_Q_of_stupidTruncGE X K k ?_
  have hT := StacksDraft.StupidTruncation.stupidTruncGETriangle_distinguished K k
  refine isPseudoCoherentFrom_of_distinguished_two_general X k _ hT ?_ ?_
  · -- the tail
    have : E.IsStrictlyGE (k + 1) := by
      rw [CochainComplex.isStrictlyGE_iff]
      exact fun i hi => hEk i (by omega)
    let lift := StacksDraft.StupidTruncation.liftStupidTrunc K (embeddingUpIntGE (k + 1)) ε
    have : ∀ n, IsIso (lift.f n) := by
      intro n
      by_cases hn : k + 1 ≤ n
      · have h1 : IsIso ((ιStupidTrunc K (embeddingUpIntGE (k + 1))).f n) := by
          rw [StacksDraft.StupidTruncation.ιStupidTruncGE_f K (k + 1) n hn]
          infer_instance
        have h2 : IsIso (lift.f n ≫ (ιStupidTrunc K (embeddingUpIntGE (k + 1))).f n) := by
          rw [← HomologicalComplex.comp_f, StacksDraft.StupidTruncation.liftStupidTrunc_ι]
          exact hε n (by omega)
        exact IsIso.of_isIso_comp_right _ ((ιStupidTrunc K (embeddingUpIntGE (k + 1))).f n)
      · exact isIso_of_isZero_of_isZero' _ (hEk n (by omega))
          (CochainComplex.isZero_of_isStrictlyGE _ (k + 1) n (by omega))
    have : IsIso lift := HomologicalComplex.Hom.isIso_of_components lift
    exact isPseudoCoherentFrom_of_isStrictlyPerfect_approximation X E hE
      (DerivedCategory.Q.obj (K.stupidTrunc (embeddingUpIntGE (k + 1)))) k
      (DerivedCategory.Q.map lift) (fun _ _ => Functor.map_isIso _ _)
      (IsIso.epi_of_iso (f := (DerivedCategory.homologyFunctor _ k).map (DerivedCategory.Q.map lift)))
  · -- the term in degree `k`
    let P := (HomologicalComplex.single _ (ComplexShape.up ℤ) k).obj F
    refine isPseudoCoherentFrom_of_isStrictlyPerfect_approximation X P
      (isStrictlyPerfect_singleObj _ hF k) _ k
      ((DerivedCategory.singleFunctor _ k).map q) (fun i hi => ?_) ?_
    · refine isIso_of_isZero_of_isZero' _ ?_ ?_
      · exact (HomologicalComplex.isZero_single_obj_homology _ k F i (by omega)).of_iso
          ((DerivedCategory.homologyFunctorFactors _ i).app P)
      · exact (HomologicalComplex.isZero_single_obj_homology _ k (K.X k) i (by omega)).of_iso
          ((DerivedCategory.homologyFunctorFactors _ i).app _)
    · show Epi ((DerivedCategory.singleFunctor _ k ⋙ DerivedCategory.homologyFunctor _ k).map q)
      rw [epi_map_iff_of_natIso (DerivedCategory.singleFunctorCompHomologyFunctorIso _ k)]
      exact inferInstanceAs (Epi q)

