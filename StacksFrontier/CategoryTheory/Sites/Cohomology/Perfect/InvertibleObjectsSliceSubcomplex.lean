/-!
# The finitely generated subcomplex of the pseudo-coherence induction, on a localized site

Let `W` be an object of a ringed site `(C, O)`, so that the localized site `C/W` has the final
object `W`. Let `ℒ` be a complex on `C/W`, let `ℰ ⟶ ℒ` be a map of complexes which is an
isomorphism in every degree `≥ m`, with `ℰ` vanishing below `m`, and let finitely many sections
`aᵢ` of the terms of `ℒ` over `W` be given. This file builds the subcomplex `𝒦 ⊆ ℒ` of the
source's inductive step:

* in degree `n` the term of `𝒦` is generated by the image of `ℰⁿ` and by the `aᵢ` of degree `n`
  and the `d(aᵢ)` of degree `n`, so that it is all of `ℒⁿ` for `n ≥ m`, and in degree `m - 1` it
  is a quotient of a finite free module;
* every `aᵢ` lifts to `𝒦`.

If moreover `ℰ` is strictly perfect, then `𝒦` is `(m - 1)`-pseudo-coherent: the brutal
truncation `σ^{≥ m-1}𝒦` is bounded, vanishes below `m - 1`, is a direct summand of a finite free
module above `m - 1`, and is covered by one in degree `m - 1`, which is what
`AlgebraicGeometry.RingedSite.exists_isStrictlyPerfect_approximation_of_bottomCover` turns into a
strictly perfect approximation.

## Main results

* `AlgebraicGeometry.RingedSite.InvertibleDerived.sliceGenSubcomplex`: the subcomplex, with its
  inclusion `sliceGenSubcomplexι`.
* `AlgebraicGeometry.RingedSite.InvertibleDerived.exists_lift_sliceGenSubcomplex`: the `aᵢ` lift.
* `AlgebraicGeometry.RingedSite.InvertibleDerived.isPseudoCoherentFrom_sliceGenSubcomplex`:
  `𝒦` is `(m - 1)`-pseudo-coherent.

## Implementation notes

The terms are the images of a family of maps `Fⁿ ⊞ ℰⁿ ⟶ ℒⁿ` whose differential lifts
(`Stacks.Sites.ExtensionByZero.genSubcomplex`), `Fⁿ` being the free module on the indices of the
`aᵢ` of degree `n` and of the `d(aᵢ)` of degree `n`. The family is uniform in `n`: no complex is
defined by cases on the degree. A section over the final object `W` of `C/W` is a global
section, so the map out of `Fⁿ` is the one sending each basis element to its section
(`AlgebraicGeometry.RingedSite.InvertibleDerived.unitHomOfTerminal`).

## References

* [Stacks Project, Tag 0FPV](https://stacks.math.columbia.edu/tag/0FPV)
* [Stacks Project, Tag 0FPY](https://stacks.math.columbia.edu/tag/0FPY)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open Opposite Stacks.SheafOfModules.DerivedMonoidal

universe u

namespace AlgebraicGeometry.RingedSite.InvertibleDerived

attribute [local instance] Abelian.hasFiniteBiproducts

variable {X : RingedSite.{u, u, u}} [HasSheafify X.J AddCommGrpCat.{u}]
  [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ W : X.C, HasSheafify (X.J.over W) AddCommGrpCat.{u}]
  [∀ W : X.C, (X.J.over W).WEqualsLocallyBijective AddCommGrpCat.{u}]

section Terminal

variable {W : X.C}

/-- `unitHomOfTerminal` is natural in the module. -/
theorem unitHomOfTerminal_comp {F G : Mod (X.over W).O} (s : F.val.obj (op (Over.mk (𝟙 W))))
    (φ : F ⟶ G) :
    unitHomOfTerminal F s ≫ φ = unitHomOfTerminal G (φ.val.app _ s) :=
  unitHom_ext_of_terminal (by
    show φ.val.app _ ((unitHomOfTerminal F s).val.app _
      (1 : ((Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O).obj.obj
        (op (Over.mk (𝟙 W)))))) = _
    rw [unitHomOfTerminal_val_app, unitHomOfTerminal_val_app])

/-- `unitHomOfTerminal` of the zero section is zero. -/
theorem unitHomOfTerminal_zero (F : Mod (X.over W).O) :
    unitHomOfTerminal F 0 = 0 :=
  unitHom_ext_of_terminal (by rw [unitHomOfTerminal_val_app]; rfl)

/-- Equal morphisms agree on every section over the final object. -/
theorem val_app_eq_of_eq {F G : Mod (X.over W).O} {φ ψ : F ⟶ G} (h : φ = ψ)
    (s : F.val.obj (op (Over.mk (𝟙 W)))) : φ.val.app _ s = ψ.val.app _ s := by
  rw [h]

end Terminal

section GlobalApproximation

variable (Zs : RingedSite.{u, u, u}) [HasSheafify Zs.J AddCommGrpCat.{u}]
  [Zs.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ U : Zs.C, HasSheafify (Zs.J.over U) AddCommGrpCat.{u}]
  [∀ U : Zs.C, (Zs.J.over U).WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- **A complex with a strictly perfect approximation on the whole site is pseudo-coherent.** If
`β : 𝒫 ⟶ 𝒦` is a map of complexes of `O`-modules with `𝒫` strictly perfect, invertible on
cohomology above `n` and epic on cohomology in degree `n`, then `𝒦` is `n`-pseudo-coherent: over
every object `U` the restriction of `β` is such an approximation of `𝒦|_U`, restriction being
exact and carrying strictly perfect complexes to strictly perfect complexes. -/
theorem isPseudoCoherentComplexFrom_of_approximation
    (K P : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Zs.O)) ℤ)
    (n : ℤ) (hP : IsStrictlyPerfect (Stacks.SheafOfModules.Tensor.ringSheaf Zs.O) P)
    (β : P ⟶ K) (hiso : ∀ j : ℤ, n < j → IsIso (HomologicalComplex.homologyMap β j))
    (hepi : Epi (HomologicalComplex.homologyMap β n)) :
    Zs.IsPseudoCoherentComplexFrom K n := by
  intro U
  refine ⟨Presieve.singleton (𝟙 U), Zs.J.superset_covering (fun V f _ =>
    ⟨U, f, 𝟙 U, Presieve.singleton_self _, Category.comp_id f⟩) (Zs.J.top_mem U), ?_⟩
  rintro _ _ ⟨⟩
  let F := SheafOfModules.overFunctor.{u} (Stacks.SheafOfModules.Tensor.ringSheaf Zs.O) U
  have : PreservesFiniteLimits F :=
    Stacks.SheafOfModules.LocalCokernel.overFunctor_preservesFiniteLimits U
  have : PreservesFiniteColimits F :=
    Stacks.SheafOfModules.LocalCokernel.overFunctor_preservesFiniteColimits U
  refine ⟨(F.mapHomologicalComplex (ComplexShape.up ℤ)).obj P,
    Stacks.SheafOfModules.isStrictlyPerfect_mapHomologicalComplex F
      (Stacks.SheafOfModules.overFunctorUnitIso _ U) hP,
    (F.mapHomologicalComplex (ComplexShape.up ℤ)).map β, fun j hj => ?_, ?_⟩
  · have : QuasiIsoAt β j := (quasiIsoAt_iff_isIso_homologyMap _ _).2 (hiso j hj)
    exact (quasiIsoAt_iff_isIso_homologyMap _ _).1 inferInstance
  · exact Stacks.PseudoCoherence.DerivedCharacterization.epi_homologyMap_mapHomologicalComplex
      F β n hepi

end GlobalApproximation

section Generators

variable {W : X.C} (L : Complexes (X.over W).O) {κ : Type} [Fintype κ] (deg : κ → ℤ)
  (a : ∀ i, (L.X (deg i)).val.obj (op (Over.mk (𝟙 W))))

/-- The indices of the generators in degree `n`: the `aᵢ` of degree `n` and the `d(aᵢ)` of
degree `n`. -/
abbrev GenIdx (n : ℤ) : Type u :=
  ULift.{u} ({i : κ // deg i = n} ⊕ {i : κ // deg i + 1 = n})

/-- The section of `ℒⁿ` over the final object attached to a generator index. -/
def genSec (n : ℤ) : GenIdx deg n → (L.X n).val.obj (op (Over.mk (𝟙 W)))
  | ⟨Sum.inl i⟩ => ((L.XIsoOfEq i.2).hom).val.app _ (a i.1)
  | ⟨Sum.inr i⟩ => ((L.XIsoOfEq i.2).hom).val.app _
      ((L.d (deg i.1) (deg i.1 + 1)).val.app _ (a i.1))

/-- The map out of the free module on the generator indices of degree `n`. -/
def genMap (n : ℤ) :
    SheafOfModules.free (R := Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O)
      (GenIdx deg n) ⟶ L.X n :=
  Sigma.desc fun j => unitHomOfTerminal _ (genSec L deg a n j)

/-- The map of free modules covering the differential: the generator `aᵢ` goes to the generator
`d(aᵢ)`, and the generator `d(aᵢ)` goes to zero. -/
def genShift (n : ℤ) :
    SheafOfModules.free (R := Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O)
        (GenIdx deg n) ⟶
      SheafOfModules.free (R := Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O)
        (GenIdx deg (n + 1)) :=
  Sigma.desc fun j => match j with
    | ⟨Sum.inl i⟩ => SheafOfModules.ιFree (⟨Sum.inr ⟨i.1, by rw [i.2]⟩⟩ : GenIdx deg (n + 1))
    | ⟨Sum.inr _⟩ => 0

/-- The map `genMap` sends the basis element indexed by `j` to the section `genSec j`. -/
theorem ιFree_genMap (n : ℤ) (j : GenIdx deg n) :
    SheafOfModules.ιFree j ≫ genMap L deg a n = unitHomOfTerminal _ (genSec L deg a n j) :=
  Sigma.ι_desc _ _

/-- The maps `genMap` intertwine `genShift` with the differential of `ℒ`. -/
theorem genShift_genMap (n : ℤ) :
    genShift deg n ≫ genMap L deg a (n + 1) = genMap L deg a n ≫ L.d n (n + 1) := by
  refine Sigma.hom_ext _ _ fun j => ?_
  show (SheafOfModules.ιFree j ≫ genShift deg n) ≫ _ =
    (SheafOfModules.ιFree j ≫ genMap L deg a n) ≫ _
  rw [ιFree_genMap, unitHomOfTerminal_comp]
  obtain ⟨j | j⟩ := j
  · rw [show SheafOfModules.ιFree _ ≫ genShift deg n = _ from Sigma.ι_desc _ _, ιFree_genMap]
    refine congrArg _ ?_
    show ((L.d (deg j.1) (deg j.1 + 1)) ≫ (L.XIsoOfEq _).hom).val.app _ (a j.1) =
      ((L.XIsoOfEq j.2).hom ≫ L.d n (n + 1)).val.app _ (a j.1)
    rw [L.d_comp_XIsoOfEq_hom, L.XIsoOfEq_hom_comp_d]
  · rw [show SheafOfModules.ιFree _ ≫ genShift deg n = 0 from Sigma.ι_desc _ _, zero_comp]
    refine (unitHomOfTerminal_zero _).symm.trans (congrArg _ ?_)
    show (0 : (L.X (deg j.1) ⟶ L.X (n + 1))).val.app _ (a j.1) =
      ((L.d (deg j.1) (deg j.1 + 1) ≫ (L.XIsoOfEq j.2).hom) ≫ L.d n (n + 1)).val.app _ (a j.1)
    rw [Category.assoc, L.XIsoOfEq_hom_comp_d, HomologicalComplex.d_comp_d]

variable {L} {m : ℤ} {E : Complexes (X.over W).O} (e : E ⟶ L)

/-- The generating family: the free module on the generators together with `ℰⁿ`. -/
abbrev genSrc (n : ℤ) : Mod (X.over W).O :=
  SheafOfModules.free (R := Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O)
    (GenIdx deg n) ⊞ E.X n

/-- The generating map `Fⁿ ⊞ ℰⁿ ⟶ ℒⁿ`. -/
def genTot (n : ℤ) : genSrc deg (E := E) n ⟶ L.X n :=
  biprod.desc (genMap L deg a n) (e.f n)

/-- The lift of the differential to the generating family. -/
def genLift (n : ℤ) : genSrc deg (E := E) n ⟶ genSrc deg (E := E) (n + 1) :=
  biprod.map (genShift deg n) (E.d n (n + 1))

/-- The generating maps `genTot` intertwine `genLift` with the differential of `ℒ`. -/
theorem genLift_genTot (n : ℤ) :
    genLift deg (E := E) n ≫ genTot deg a e (n + 1) = genTot deg a e n ≫ L.d n (n + 1) := by
  refine biprod.hom_ext' _ _ ?_ ?_
  · simp only [genLift, genTot, biprod.inl_map_assoc, biprod.inl_desc, biprod.inl_desc_assoc,
      Category.assoc]
    exact genShift_genMap L deg a n
  · simp only [genLift, genTot, biprod.inr_map_assoc, biprod.inr_desc, biprod.inr_desc_assoc]
    exact (e.comm n (n + 1)).symm

/-- **The subcomplex of the inductive step.** In degree `n` it is the image of
`Fⁿ ⊞ ℰⁿ ⟶ ℒⁿ`. -/
def sliceGenSubcomplex : Complexes (X.over W).O :=
  Stacks.Sites.ExtensionByZero.genSubcomplex (genLift_genTot deg a e)

/-- The inclusion of the subcomplex. -/
def sliceGenSubcomplexι : sliceGenSubcomplex deg a e ⟶ L :=
  Stacks.Sites.ExtensionByZero.genSubcomplexι (genLift_genTot deg a e)

/-- In every degree the inclusion `sliceGenSubcomplexι` is a monomorphism. -/
instance (n : ℤ) : Mono ((sliceGenSubcomplexι deg a e).f n) :=
  Stacks.Sites.ExtensionByZero.mono_genSubcomplexι_f _ n

/-- **Every `aᵢ` lifts to the subcomplex.** -/
theorem exists_lift_sliceGenSubcomplex (i : κ) :
    ∃ y : ((sliceGenSubcomplex deg a e).X (deg i)).val.obj (op (Over.mk (𝟙 W))),
      ((sliceGenSubcomplexι deg a e).f (deg i)).val.app _ y = a i := by
  refine Stacks.Sites.ExtensionByZero.exists_lift_of_eq_app (genLift_genTot deg a e)
    (a := ((biprod.inl : _ ⟶ genSrc deg (E := E) (deg i)).val.app _
      ((SheafOfModules.ιFree (⟨Sum.inl ⟨i, rfl⟩⟩ : GenIdx deg (deg i))).val.app _
        (1 : ((Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O).obj.obj
          (op (Over.mk (𝟙 W)))))))) ?_
  show ((SheafOfModules.ιFree _ ≫ biprod.inl ≫ genTot deg a e (deg i)).val.app _
    (1 : ((Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O).obj.obj
      (op (Over.mk (𝟙 W)))))) = a i
  rw [show biprod.inl ≫ genTot deg a e (deg i) = genMap L deg a (deg i) from biprod.inl_desc _ _,
    ιFree_genMap, unitHomOfTerminal_val_app]
  show ((L.XIsoOfEq rfl).hom).val.app _ (a i) = a i
  rw [L.XIsoOfEq_rfl]
  rfl

/-- **In every degree where `ℰ ⟶ ℒ` is invertible the subcomplex is all of `ℒ`.** -/
theorem isIso_sliceGenSubcomplexι_f (n : ℤ) (hn : IsIso (e.f n)) :
    IsIso ((sliceGenSubcomplexι deg a e).f n) := by
  have hepi : Epi (genTot deg a e n) := by
    have : Epi (biprod.inr ≫ genTot deg a e n) := by
      rw [show biprod.inr ≫ genTot deg a e n = e.f n from biprod.inr_desc _ _]
      infer_instance
    exact epi_of_epi biprod.inr _
  have : Epi (image.ι (genTot deg a e n)) := epi_of_epi_fac (image.fac (genTot deg a e n))
  show IsIso (image.ι (genTot deg a e n))
  exact isIso_of_mono_of_epi _

/-- **In each degree the subcomplex is a quotient of its generating family.** -/
theorem exists_epi_sliceGenSubcomplex_X (n : ℤ) :
    ∃ π : genSrc deg (E := E) n ⟶ (sliceGenSubcomplex deg a e).X n, Epi π :=
  Stacks.Sites.ExtensionByZero.exists_epi_image (genSrc deg (E := E)) (genTot deg a e) n

/-- A free module on a finite type is a direct summand of a finite free module. -/
theorem isDirectSummandOfFiniteFree_free {W : X.C} (I : Type u) [Fintype I] :
    IsDirectSummandOfFiniteFree (Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O)
      (SheafOfModules.free (R := Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O) I) := by
  rw [isDirectSummandOfFiniteFree_iff_free]
  let eq : I ≃ ULift.{u} (Fin (Fintype.card I)) :=
    (Fintype.equivFin I).trans Equiv.ulift.symm
  let e := (SheafOfModules.freeFunctor
    (R := Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O)).mapIso eq.toIso
  exact ⟨Fintype.card I, e.hom, e.inv, e.hom_inv_id⟩

/-- **The subcomplex of the inductive step is `(m - 1)`-pseudo-coherent.** Suppose that `ℰ`
vanishes below `m`, that `ℰ ⟶ ℒ` is invertible in every degree `≥ m`, that `ℒ` vanishes above
some degree and that its terms in degrees `≥ m` are direct summands of finite free modules. Then
the subcomplex generated by `ℰ` and the `aᵢ` is `(m - 1)`-pseudo-coherent. -/
theorem isPseudoCoherentFrom_sliceGenSubcomplex {W : X.C} {L : Complexes (X.over W).O}
    {κ : Type} [Fintype κ] (deg : κ → ℤ) (a : ∀ i, (L.X (deg i)).val.obj (op (Over.mk (𝟙 W))))
    {E : Complexes (X.over W).O} (e : E ⟶ L) (m : ℤ) (hE0 : ∀ i, i < m → IsZero (E.X i))
    (he : ∀ i, m ≤ i → IsIso (e.f i))
    (hfree : ∀ i, m ≤ i →
      IsDirectSummandOfFiniteFree (Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O) (L.X i))
    (b : ℤ) (hb : ∀ i, b < i → IsZero (L.X i)) :
    letI : HasDerivedCategory (Mod (X.over W).O) := HasDerivedCategory.standard _
    (X.over W).IsPseudoCoherentFrom (DerivedCategory.Q.obj (sliceGenSubcomplex deg a e))
      (m - 1) := by
  let : HasDerivedCategory (Mod (X.over W).O) := HasDerivedCategory.standard _
  classical
  set K := sliceGenSubcomplex deg a e with hK
  let α := K.ιStupidTrunc (ComplexShape.embeddingUpIntGE (m - 1))
  have hαf : ∀ i, m - 1 ≤ i → IsIso (α.f i) := fun i hi =>
    K.isIso_ιStupidTrunc_embeddingUpIntGE_f (m - 1) i hi
  have hιf : ∀ i, m ≤ i → IsIso ((sliceGenSubcomplexι deg a e).f i) := fun i hi =>
    isIso_sliceGenSubcomplexι_f deg a e i (he i hi)
  obtain ⟨π, hπ⟩ := exists_epi_sliceGenSubcomplex_X deg a e (m - 1)
  have hA : IsDirectSummandOfFiniteFree (Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O)
      (genSrc deg (E := E) (m - 1)) :=
    IsDirectSummandOfFiniteFree.biprod _ (isDirectSummandOfFiniteFree_free _)
      (IsDirectSummandOfFiniteFree.of_isZero_general _ (hE0 _ (by omega)))
  have := hαf (m - 1) le_rfl
  have hzero : ∀ i : ℤ, i < m - 1 →
      IsZero ((K.stupidTrunc (ComplexShape.embeddingUpIntGE (m - 1))).X i) := fun i hi =>
    K.isZero_stupidTrunc_X _ i (fun j => by
      rw [ComplexShape.embeddingUpIntGE_f]; omega)
  have hiso' : ∀ i, m ≤ i →
      Nonempty ((K.stupidTrunc (ComplexShape.embeddingUpIntGE (m - 1))).X i ≅ L.X i) :=
    fun i hi => by
      have := hαf i (by omega)
      have := hιf i hi
      exact ⟨asIso (α.f i) ≪≫ asIso ((sliceGenSubcomplexι deg a e).f i)⟩
  have hbdd : {i : ℤ | ¬ IsZero ((K.stupidTrunc
      (ComplexShape.embeddingUpIntGE (m - 1))).X i)}.Finite := by
    refine (Set.finite_Icc (m - 1) (max b (m - 1))).subset fun i hi => ?_
    simp only [Set.mem_setOf_eq] at hi
    simp only [Set.mem_Icc]
    refine ⟨?_, ?_⟩
    · by_contra h
      exact hi (hzero i (by omega))
    · by_contra h
      obtain ⟨e'⟩ := hiso' i (by omega)
      exact hi ((hb i (by omega)).of_iso e')
  have hterm : ∀ i : ℤ, m - 1 < i →
      IsDirectSummandOfFiniteFree (Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O)
        ((K.stupidTrunc (ComplexShape.embeddingUpIntGE (m - 1))).X i) := fun i hi => by
    obtain ⟨e'⟩ := hiso' i (by omega)
    exact IsDirectSummandOfFiniteFree.of_iso _ e' (hfree i (by omega))
  obtain ⟨P, hP, β, hβiso, hβepi⟩ := exists_isStrictlyPerfect_approximation_of_bottomCover
    (Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O) (m - 1) hzero hbdd hterm hA
    (π ≫ inv (α.f (m - 1))) inferInstance α
    (fun j hj => StacksDraft.StupidTruncation.isIso_homologyMap_ιStupidTruncGE K (m - 1) j hj)
    (K.epi_homologyMap_ιStupidTrunc_embeddingUpIntGE (m - 1))
  exact ⟨K, isPseudoCoherentComplexFrom_of_approximation (X.over W) K P (m - 1) hP β hβiso hβepi,
    ⟨Iso.refl _⟩⟩

end Generators

end AlgebraicGeometry.RingedSite.InvertibleDerived

end
