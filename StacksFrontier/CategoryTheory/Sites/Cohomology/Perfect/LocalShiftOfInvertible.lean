module

public import StacksFrontier.CategoryTheory.Sites.Cohomology.Perfect.InvertibleOfLocalShift
public import StacksFrontier.CategoryTheory.Sites.Cohomology.Perfect.InvertibleObjectsClauseThreeToTwo
public import StacksFrontier.CategoryTheory.Sites.Cohomology.InternalHom.FromTheStructureSheaf

/-!
# An invertible object of `D(O)` is locally a shift of `O`

Let `(C, O)` be a locally ringed site and `M` an invertible object of `D(O)`. By clause (3) of
Stacks 0FPY every object of `C` has a covering on whose members `M` is an invertible module placed
in a single degree, and an invertible module on a locally ringed site is, on a covering, freely
generated by one section. So every object `U` has a covering on whose members `W` the restriction
`M|_W` is isomorphic to `O_W` placed in a single degree.

As a consequence, if `K'` is recovered from `K` by biduality through an invertible object,
`K' ≅ RSheafHom(RSheafHom(K', K), K)` with `RSheafHom(K', K)` invertible, then `K'` is, on a
covering of every object, a shift of `K`: over a member `W` on which
`RSheafHom(K', K)|_W ≅ O_W[-n]`, `K'|_W ≅ RSheafHom(O_W[-n], K|_W) ≅ K|_W[n]`.

## Main results

* `InvertibleDerived.exists_covering_restrictDer_iso_singleFunctor_unit`:
  an invertible object of `D(O)` is locally `O` placed in a single degree.
* `InvertibleDerived.exists_covering_restrictDer_iso_shift_of_biduality`:
  the local shift from biduality through an invertible object.

## Implementation notes

The derived categories are those at `CategoryTheory.HasDerivedCategory.standard`, named
explicitly: the restriction of the derived internal Hom to a slice (Stacks 08JB) and its
commutation with shifts in the source are stated there.

## References

* [Stacks Project, Tag 0FPY](https://stacks.math.columbia.edu/tag/0FPY)
* [Stacks Project, Tag 08JB](https://stacks.math.columbia.edu/tag/08JB)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.RingedSite.InvertibleDerived

variable (X : RingedSite.{u, u, u}) [HasSheafify X.J AddCommGrpCat.{u}]
  [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ W : X.C, HasSheafify (X.J.over W) AddCommGrpCat.{u}]
  [∀ W : X.C, (X.J.over W).WEqualsLocallyBijective AddCommGrpCat.{u}]

omit [HasSheafify X.J AddCommGrpCat.{u}] [X.J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ W : X.C, HasSheafify (X.J.over W) AddCommGrpCat.{u}]
  [∀ W : X.C, (X.J.over W).WEqualsLocallyBijective AddCommGrpCat.{u}] in
variable {X} in
/-- A sheaf of modules all of whose sections over objects lying over `W` vanish restricts to zero
on the slice over `W`. -/
theorem isZero_overFunctor_obj_of_forall_eq_zero
    {F : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)} {W : X.C}
    (h : ∀ ⦃W' : X.C⦄ (_ : W' ⟶ W) (m : F.val.obj (op W')), m = 0) :
    IsZero ((SheafOfModules.overFunctor.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O) W).obj
      F) := by
  rw [IsZero.iff_id_eq_zero]
  ext T m
  exact (h T.unop.hom m).trans (h T.unop.hom _).symm

attribute [local instance] Stacks.SheafOfModules.LocalCokernel.overFunctor_preservesFiniteLimits
  Stacks.SheafOfModules.LocalCokernel.overFunctor_preservesFiniteColimits

variable {X} in
/-- If the restriction of `M = [E]` to `V` is an invertible module `L` placed in degree `n`, then
the cohomology of `E` vanishes over `V` off degree `n` and is locally generated by one section in
degree `n`. -/
theorem homology_concentrated_and_genSieve_mem_of_restrict_iso_single (hX : IsLocallyRinged X)
    {E : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ}
    {M : @DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) _ _
      (HasDerivedCategory.standard _)}
    (eM : (@DerivedCategory.Q _ _ _ (HasDerivedCategory.standard _)).obj E ≅ M) {V : X.C} {n : ℤ}
    {L : SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over V)}
    (hL : IsInvertibleModuleOver X V L)
    (hiso :
      letI := HasDerivedCategory.standard
        (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))
      letI := HasDerivedCategory.standard
        (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over V))
      Nonempty ((SheafOfModules.overFunctor.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)
        V).mapDerivedCategory.obj M ≅ (DerivedCategory.singleFunctor _ n).obj L)) :
    (∀ k : ℤ, k ≠ n → ∀ ⦃W' : X.C⦄ (_ : W' ⟶ V) (m : (E.homology k).val.obj (op W')), m = 0) ∧
      genSieve (E.homology n) V ∈ X.J V := by
  let := HasDerivedCategory.standard
    (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))
  let := HasDerivedCategory.standard
    (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over V))
  obtain ⟨ψ⟩ := hiso
  let ψ' : DerivedCategory.Q.obj (X.restrictComplex E V) ≅
      DerivedCategory.Q.obj ((CochainComplex.singleFunctor _ n).obj L) :=
    restrictComplexDerivedIso X eM ≪≫ ψ ≪≫ (DerivedCategory.singleFunctorIsoCompQ
      (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over V)) n).app L
  let φ : ∀ k, (E.homology k).over V ≅
      ((CochainComplex.singleFunctor _ n).obj L).homology k := fun k =>
    (restrictComplexHomologyIso E V k).symm ≪≫
      ((DerivedCategory.homologyFunctorFactors _ k).app _).symm ≪≫
        (DerivedCategory.homologyFunctor _ k).mapIso ψ' ≪≫
          (DerivedCategory.homologyFunctorFactors _ k).app _
  refine ⟨fun k hk W' g' m => eq_zero_of_isZero_over
    ((HomologicalComplex.isZero_single_obj_homology _ _ _ _ hk).of_iso (φ k)) g' m, ?_⟩
  refine genSieve_mem_of_isInvertibleModuleOver hX (E.homology n) V ?_
  have : Stacks.SheafOfModules.IsInvertible (X.O.over V).obj
      ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over V).property L := hL
  exact Stacks.SheafOfModules.isInvertible_of_iso _ _
    ((HomologicalComplex.singleObjHomologySelfIso _ _ L).symm ≪≫ (φ n).symm)

variable {X} in
/-- If the cohomology of `E` vanishes over `W` off degree `n` and is generated over `W` by
one section in degree `n`, then the restriction of `M = [E]` to `W` is `O_W` placed in degree
`n`. -/
theorem restrictDer_iso_singleFunctor_unit_of_homology_concentrated
    {E : CochainComplex (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) ℤ}
    {M : @DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) _ _
      (HasDerivedCategory.standard _)}
    (eM : (@DerivedCategory.Q _ _ _ (HasDerivedCategory.standard _)).obj E ≅ M) {W : X.C} {n : ℤ}
    (h0 : ∀ k : ℤ, k ≠ n → ∀ ⦃W' : X.C⦄ (_ : W' ⟶ W) (m : (E.homology k).val.obj (op W')), m = 0)
    (hn : (genSieve (E.homology n) W).arrows (𝟙 W)) :
    Nonempty ((restrictDer X W).obj M ≅
      (@DerivedCategory.singleFunctor _ _ _ (HasDerivedCategory.standard _) n).obj
        (SheafOfModules.unit _)) := by
  let := HasDerivedCategory.standard
    (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))
  let := HasDerivedCategory.standard
    (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W))
  obtain ⟨t, ht⟩ := hn
  let F := X.restrictComplex E W
  let eF : DerivedCategory.Q.obj F ≅ (restrictDer X W).obj M := restrictComplexDerivedIso X eM
  have hz : ∀ k : ℤ, k ≠ n →
      IsZero ((DerivedCategory.homologyFunctor _ k).obj (DerivedCategory.Q.obj F)) :=
    fun k hk => (isZero_overFunctor_obj_of_forall_eq_zero (h0 k hk)).of_iso
      ((DerivedCategory.homologyFunctorFactors _ k).app F ≪≫ restrictComplexHomologyIso E W k)
  have : (DerivedCategory.Q.obj F).IsGE n :=
    ((DerivedCategory.Q.obj F).isGE_iff n).2 fun i hi => hz i (by omega)
  have : (DerivedCategory.Q.obj F).IsLE n :=
    ((DerivedCategory.Q.obj F).isLE_iff n).2 fun i hi => hz i (by omega)
  obtain ⟨A, ⟨eA⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE
    (DerivedCategory.Q.obj F) n
  let eA' : A ≅ SheafOfModules.unit _ :=
    ((DerivedCategory.singleFunctorCompHomologyFunctorIso _ n).app A).symm ≪≫
      (DerivedCategory.homologyFunctor _ n).mapIso eA.symm ≪≫
        (DerivedCategory.homologyFunctorFactors _ n).app F ≪≫ restrictComplexHomologyIso E W n ≪≫
          Stacks.SheafOfModules.overIsoUnitOfBijectiveSmul (E.homology n) W t fun _ g => ht g
  exact ⟨eF.symm ≪≫ eA ≪≫ (DerivedCategory.singleFunctor _ n).mapIso eA'⟩

/-- **An invertible object of `D(O)` is, on a covering of every object, `O` placed in a single
degree**, on a locally ringed site. Clause (3) of Stacks 0FPY makes it an invertible module placed
in a single degree on a covering, and the invertible module is, on a covering of each member,
freely generated by a single section (`genSieve_mem_of_isInvertibleModuleOver`). -/
theorem exists_covering_restrictDer_iso_singleFunctor_unit (hX : IsLocallyRinged X)
    (M : @DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) _ _
      (HasDerivedCategory.standard _))
    (hM : @IsInvertibleObject X _ _ (HasDerivedCategory.standard _) M) (U : X.C) :
    ∃ S : Presieve U, Sieve.generate S ∈ X.J U ∧
      ∀ ⦃W : X.C⦄ (f : W ⟶ U), S f → ∃ n : ℤ,
        Nonempty ((restrictDer X W).obj M ≅
          (@DerivedCategory.singleFunctor _ _ _ (HasDerivedCategory.standard _) n).obj
            (SheafOfModules.unit _)) := by
  let := HasDerivedCategory.standard
    (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))
  have hloc : HasLocalInvertibleDegree X M :=
    (((isInvertibleObject_tfae (X := X) M).2.2 hX).out 1 3).mp hM
  let E := DerivedCategory.Q.objPreimage M
  let eM : DerivedCategory.Q.obj E ≅ M := DerivedCategory.Q.objObjPreimageIso M
  let Good : X.C → Prop := fun W => ∃ n : ℤ,
    (∀ k : ℤ, k ≠ n → ∀ ⦃W' : X.C⦄ (_ : W' ⟶ W) (m : (E.homology k).val.obj (op W')), m = 0) ∧
      (genSieve (E.homology n) W).arrows (𝟙 W)
  let Q : Sieve U :=
    { arrows := fun W _ => Good W
      downward_closed := by
        rintro W W' g ⟨n, h0, hn⟩ g'
        exact ⟨n, fun k hk W'' g'' m => h0 k hk (g'' ≫ g') m,
          (genSieve (E.homology n) W).downward_closed (f := 𝟙 W) hn g'⟩ }
  have hQ : Q ∈ X.J U := by
    refine X.J.transitive (hloc U).choose_spec.1 Q ?_
    rintro Y _ ⟨V, g, f, hf, rfl⟩
    obtain ⟨n, L, hL, hiso⟩ := (hloc U).choose_spec.2 f hf
    obtain ⟨h0, hgen⟩ :=
      homology_concentrated_and_genSieve_mem_of_restrict_iso_single hX eM hL hiso
    refine X.J.superset_covering ?_ (X.J.pullback_stable g hgen)
    rintro Z t ⟨s, hs⟩
    exact ⟨n, fun k hk W'' g'' m => h0 k hk (g'' ≫ t ≫ g) m, ⟨s, hs⟩⟩
  refine ⟨Q.arrows, by rwa [Sieve.generate_sieve], ?_⟩
  rintro W f ⟨n, h0, hn⟩
  exact ⟨n, restrictDer_iso_singleFunctor_unit_of_homology_concentrated eM h0 hn⟩

/-- **Biduality through an invertible object makes `K'` locally a shift of `K`**, on a locally
ringed site: if `RSheafHom(K', K)` is invertible and `K' ≅ RSheafHom(RSheafHom(K', K), K)`, then
every object has a covering on whose members `W` the restriction `K'|_W` is a shift of `K|_W`.
Over a member on which `RSheafHom(K', K)|_W ≅ O_W[-n]`
(`exists_covering_restrictDer_iso_singleFunctor_unit`), Stacks 08JB gives
`K'|_W ≅ RSheafHom(O_W[-n], K|_W) ≅ RSheafHom(O_W, K|_W)[n] ≅ K|_W[n]`. -/
theorem exists_covering_restrictDer_iso_shift_of_biduality (hX : IsLocallyRinged X)
    (K K' : @DerivedCategory (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O)) _ _
      (HasDerivedCategory.standard _))
    (hR : @IsInvertibleObject X _ _ (HasDerivedCategory.standard _)
      (((@derivedSheafHomBifunctor X (HasDerivedCategory.standard _)).obj (op K')).obj K))
    (e : K' ≅ ((@derivedSheafHomBifunctor X (HasDerivedCategory.standard _)).obj
      (op (((@derivedSheafHomBifunctor X (HasDerivedCategory.standard _)).obj (op K')).obj
        K))).obj K)
    (U : X.C) :
    ∃ S : Presieve U, Sieve.generate S ∈ X.J U ∧
      ∀ ⦃W : X.C⦄ (f : W ⟶ U), S f → ∃ n : ℤ,
        Nonempty ((restrictDer X W).obj K' ≅ ((restrictDer X W).obj K)⟦n⟧) := by
  let := HasDerivedCategory.standard
    (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.O))
  obtain ⟨S, hS, hSf⟩ := exists_covering_restrictDer_iso_singleFunctor_unit X hX _ hR U
  refine ⟨S, hS, fun W f hf => ?_⟩
  obtain ⟨n, ⟨eR⟩⟩ := hSf f hf
  let := HasDerivedCategory.standard
    (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W))
  let := HasDerivedCategory.standard
    (SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf (X.over W).O))
  let R := ((derivedSheafHomBifunctor X).obj (op K')).obj K
  let O₀ := (DerivedCategory.singleFunctor
    (SheafOfModules.{u} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O).over W)) 0).obj
      (SheafOfModules.unit _)
  let eS : (DerivedCategory.singleFunctor _ n).obj (SheafOfModules.unit _) ≅ O₀⟦-n⟧ :=
    (((DerivedCategory.singleFunctors _).shiftIso (-n) n 0 (by omega)).app _).symm
  refine ⟨-(-n), ⟨(restrictDer X W).mapIso e ≪≫ (derivedHomRestriction X W).iso R K ≪≫
    ((derivedSheafHomBifunctor (X.over W)).mapIso (eR ≪≫ eS).symm.op).app _ ≪≫
    derivedSheafHomSourceShiftIso (X.over W) O₀ _ (-n) ≪≫
    (shiftFunctor _ (-(-n))).mapIso (derivedStructureSheafHomIso (X.over W) _)⟩⟩

end AlgebraicGeometry.RingedSite.InvertibleDerived
