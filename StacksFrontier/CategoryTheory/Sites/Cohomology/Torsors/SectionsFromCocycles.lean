module

public import Mathlib.CategoryTheory.Sites.Hypercover.Zero
public import StacksFrontier.CategoryTheory.Sites.Cohomology.Torsors.PseudoTorsors

/-!
# Sections of a torsor from a cocycle on a coarser family

Let `(C, J)` be a site, let `H` be a sheaf of groups and let `T` be a pseudo-`H`-torsor. Let
`{V_k → U}` be a covering family over which `T` has sections `s_k`. Over `V_k ×_U V_l` the two
pullbacks of `s_k` and `s_l` differ by a unique section `g_{kl}` of `H`, and these sections form
a cocycle. Suppose that the family factors through a second family `{M_k → U}`, by maps
`V_k → M_k` over `U`, and that the cocycle is pulled back from a cocycle `γ_{kl}` on the
`M_k ×_U M_l`. Then `T` has a section over every `M_l`: on the covering `{V_k ×_U M_l → M_l}` the
sections `γ_{kl} · s_k` agree on overlaps by the cocycle condition, and they glue.

This is the step of Stacks 099X in which a torsor trivialized by a pro-étale covering is shown to
be trivialized by an étale one: the cocycle of the pro-étale covering descends to a stage of the
limits presenting the members, and the stages form the étale covering.

## Main results

* `PseudoTorsor.nonempty_of_cocycle`: the existence of sections over the `M_l`.

## Implementation notes

The fibre products `M_k ×_U M_l` are not formed: a section `γ_{kl}` of `H` over `M_k ×_U M_l` is
recorded by its pullbacks `γ_{kl}(x, z)` along all pairs of maps `x : W ⟶ M_k`, `z : W ⟶ M_l`
over `U`, compatibly with restriction, as in the definition of nonabelian 1-cochains
(`CategoryTheory.PresheafOfGroups.OneCochain`). The cocycle `g_{kl}` of the sections `s_k` is
likewise only used through its pullbacks.

## References

* [Stacks Project, Tag 099X](https://stacks.math.columbia.edu/tag/099X)
-/

@[expose] public section

open CategoryTheory Opposite

universe t w w' v u

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C} {H : SheafOfGroups.{w} J}

namespace PseudoTorsor

/-- A morphism into the base which lies in the sieve generated by a family factors through one of
its members. -/
lemma exists_fac_of_sieve₀ {U : C} (E : PreZeroHypercover.{w'} U) {W : C} {g : W ⟶ U}
    (hg : E.sieve₀ g) : ∃ (k : E.I₀) (a : W ⟶ E.X k), a ≫ E.f k = g := by
  obtain ⟨_, a, _, ⟨k⟩, rfl⟩ := hg
  exact ⟨k, a, rfl⟩

variable (T : PseudoTorsor.{t} H) {U : C} (E : PreZeroHypercover.{w'} U)
  (s : ∀ k, T.presheaf.obj (op (E.X k)))
  {M : E.I₀ → C} (m : ∀ k, M k ⟶ U) (π : ∀ k, E.X k ⟶ M k) (hπ : ∀ k, π k ≫ m k = E.f k)
  (γ : ∀ (k l : E.I₀) {W : C} (x : W ⟶ M k) (z : W ⟶ M l), x ≫ m k = z ≫ m l →
    H.presheaf.obj (op W))

/-- The candidate section over `W ⟶ M_l` attached to a factorization `a : W ⟶ V_k` of its
composite to `U`: the section `s_k`, transported to the `l`-th chart by the cocycle. -/
def cocycleTransport (l : E.I₀) {W : C} (g : W ⟶ M l) (k : E.I₀) (a : W ⟶ E.X k)
    (ha : a ≫ E.f k = g ≫ m l) : T.presheaf.obj (op W) :=
  T.act (op W) (γ k l (a ≫ π k) g (by rw [Category.assoc, hπ, ha])) (T.presheaf.map a.op (s k))

variable {T E s m π hπ γ}

include hπ in
/-- **The transported section does not depend on the factorization**, by the cocycle condition
and the defining property of the cocycle of the sections. -/
lemma cocycleTransport_eq
    (hlift : ∀ (k l : E.I₀) {W : C} (a : W ⟶ E.X k) (b : W ⟶ E.X l)
      (hab : a ≫ E.f k = b ≫ E.f l),
      T.act (op W) (γ k l (a ≫ π k) (b ≫ π l) (by rw [Category.assoc, Category.assoc, hπ, hπ, hab]))
        (T.presheaf.map a.op (s k)) = T.presheaf.map b.op (s l))
    (hcocycle : ∀ (k k' l : E.I₀) {W : C} (x : W ⟶ M k) (y : W ⟶ M k') (z : W ⟶ M l)
      (hxy : x ≫ m k = y ≫ m k') (hyz : y ≫ m k' = z ≫ m l),
      γ k l x z (hxy.trans hyz) = γ k' l y z hyz * γ k k' x y hxy)
    (l : E.I₀) {W : C} (g : W ⟶ M l) (k k' : E.I₀) (a : W ⟶ E.X k) (a' : W ⟶ E.X k')
    (ha : a ≫ E.f k = g ≫ m l) (ha' : a' ≫ E.f k' = g ≫ m l) :
    cocycleTransport T E s m π hπ γ l g k a ha = cocycleTransport T E s m π hπ γ l g k' a' ha' := by
  have hxy : (a ≫ π k) ≫ m k = (a' ≫ π k') ≫ m k' := by
    rw [Category.assoc, Category.assoc, hπ, hπ, ha, ha']
  have hyz : (a' ≫ π k') ≫ m k' = g ≫ m l := by rw [Category.assoc, hπ, ha']
  unfold cocycleTransport
  rw [← hlift k k' a a' (ha.trans ha'.symm), ← T.mul_act, ← hcocycle k k' l _ _ g hxy hyz]

include hπ in
/-- **Sections of a torsor from a descended cocycle.** Let `{f_k : V_k → U}` be a covering
family, `s_k` sections of `T` over the `V_k`, and `π_k : V_k → M_k` maps over `U` to objects
`m_k : M_k → U`. Let `γ_{kl}` be compatible families of sections of `H` over the pairs of maps
into `M_k` and `M_l` over `U`, satisfying the cocycle condition, whose pullbacks to `V_k ×_U V_l`
carry the pullback of `s_k` to the pullback of `s_l`. Then `T` has a section over every `M_l`. -/
theorem nonempty_of_cocycle (hE : E.sieve₀ ∈ J U)
    (hnat : ∀ (k l : E.I₀) {W W' : C} (h : W' ⟶ W) (x : W ⟶ M k) (z : W ⟶ M l)
      (hxz : x ≫ m k = z ≫ m l),
      γ k l (h ≫ x) (h ≫ z) (by rw [Category.assoc, Category.assoc, hxz]) =
        H.presheaf.map h.op (γ k l x z hxz))
    (hlift : ∀ (k l : E.I₀) {W : C} (a : W ⟶ E.X k) (b : W ⟶ E.X l)
      (hab : a ≫ E.f k = b ≫ E.f l),
      T.act (op W) (γ k l (a ≫ π k) (b ≫ π l) (by rw [Category.assoc, Category.assoc, hπ, hπ, hab]))
        (T.presheaf.map a.op (s k)) = T.presheaf.map b.op (s l))
    (hcocycle : ∀ (k k' l : E.I₀) {W : C} (x : W ⟶ M k) (y : W ⟶ M k') (z : W ⟶ M l)
      (hxy : x ≫ m k = y ≫ m k') (hyz : y ≫ m k' = z ≫ m l),
      γ k l x z (hxy.trans hyz) = γ k' l y z hyz * γ k k' x y hxy)
    (l : E.I₀) : Nonempty (T.presheaf.obj (op (M l))) := by
  let S : Sieve (M l) := E.sieve₀.pullback (m l)
  have hS : S ∈ J (M l) := J.pullback_stable _ hE
  have hfac : ∀ {W : C} (g : W ⟶ M l), S g → ∃ (k : E.I₀) (a : W ⟶ E.X k), a ≫ E.f k = g ≫ m l :=
    fun g hg => exists_fac_of_sieve₀ E hg
  let x : Presieve.FamilyOfElements T.presheaf S.arrows := fun W g hg =>
    cocycleTransport T E s m π hπ γ l g (hfac g hg).choose (hfac g hg).choose_spec.choose
      (hfac g hg).choose_spec.choose_spec
  have hx : ∀ {W : C} (g : W ⟶ M l) (hg : S g) (k : E.I₀) (a : W ⟶ E.X k)
      (ha : a ≫ E.f k = g ≫ m l), x g hg = cocycleTransport T E s m π hπ γ l g k a ha :=
    fun g hg k a ha => cocycleTransport_eq hlift hcocycle l g _ k _ a _ ha
  have hcompat : x.SieveCompatible := by
    intro W W' g h hg
    obtain ⟨k, a, ha⟩ := hfac g hg
    have ha' : (h ≫ a) ≫ E.f k = (h ≫ g) ≫ m l := by rw [Category.assoc, ha, Category.assoc]
    rw [hx (h ≫ g) (S.downward_closed hg h) k (h ≫ a) ha', hx g hg k a ha]
    unfold cocycleTransport
    rw [T.naturality, ← hnat, op_comp, Functor.map_comp_apply]
    congr 2
    rw [Category.assoc]
  obtain ⟨t, -⟩ := ((isSheaf_iff_isSheaf_of_type J T.presheaf).1 T.isSheaf S hS) x
    ((Presieve.compatible_iff_sieveCompatible x).2 hcompat)
  exact ⟨t⟩

end PseudoTorsor
