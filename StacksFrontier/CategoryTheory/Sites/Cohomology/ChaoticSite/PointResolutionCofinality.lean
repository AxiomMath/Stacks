module

public import Mathlib.CategoryTheory.Limits.Final
public import Mathlib.CategoryTheory.Limits.IsConnected
public import StacksFrontier.CategoryTheory.Sites.Cohomology.ChaoticSite.CosimplicialResolution

/-!
# A point resolution is a cofinal cosimplicial object

Let `C` be a small category and let `U_•` be a cosimplicial object of `C` which is a point
resolution in the sense of `Stacks.ChaoticSite.IsPointResolution`: every simplicial set
`Mor_C(U_•, W)` is homotopy equivalent to the constant simplicial set on a singleton. This file
proves that `U` is then an **initial functor** `SimplexCategory ⥤ C`, equivalently that
`U.op : SimplexCategoryᵒᵖ ⥤ Cᵒᵖ` is **final**, so that for every diagram `G : Cᵒᵖ ⥤ D` with values
in any category the canonical comparison `colim_{Δᵒᵖ}(U.op ⋙ G) ⟶ colim_{Cᵒᵖ} G` is invertible.

As a consequence we obtain the **underived form of [Stacks, Tag 08QA]** at arbitrary
coefficients: if `f : C' ⥤ C` is a functor and `U_•` is a cosimplicial object of `C'` such that
both `U_•` and `f(U_•)` are point resolutions, then the canonical comparison
`π'_!(g^{-1}G) = colim_{C'ᵒᵖ}(G ∘ f) ⟶ colim_{Cᵒᵖ}G = π_!(G)` is an isomorphism, naturally in the
diagram `G`: both colimits are computed by the same colimit over `SimplexCategoryᵒᵖ`.

## Main results

* `Stacks.ChaoticSite.final_op_of_isPointResolution` and
  `Stacks.ChaoticSite.initial_of_isPointResolution`: a point resolution is an initial functor.
* `Stacks.ChaoticSite.isIso_colimitPre_of_isPointResolution`: the comparison of the colimit over
  `SimplexCategoryᵒᵖ` with the colimit over `Cᵒᵖ` is invertible, at arbitrary coefficients.
* `Stacks.ChaoticSite.isIso_colimitPre_op_of_isPointResolutions`: the underived [Stacks, Tag 08QA]
  comparison `colim_{C'ᵒᵖ}(G ∘ f) ⟶ colim_{Cᵒᵖ}G` is invertible.
* `Stacks.ChaoticSite.diagramColimitRestrictionPreNatIso`: the same statement read on
  `Stacks.CategoryHomology.diagramColimitRestrictionPre`, as an isomorphism of functors.

## Implementation notes

Finality is obtained from the criterion that every colimit `colim_{Δᵒᵖ}(U.op ⋙ Hom(W, -))` be a
singleton. Mathlib's `CategoryTheory.final_of_colimit_comp_coyoneda_iso_pUnit` states exactly that
criterion but only for a source category whose objects and morphisms live in the same universe as
the morphisms of the target, which `SimplexCategoryᵒᵖ ⥤ Cᵒᵖ` does not satisfy; the criterion at
arbitrary universes is `Stacks.ChaoticSite.final_of_colimit_comp_coyoneda_isoPUnit`.

The colimits of the coyoneda functors are singletons because a homotopy equivalence of simplicial
objects induces an isomorphism on colimits
(`Stacks.ChaoticSite.isIso_colim_map_of_homotopyEquivalences`): a morphism out of the colimit of a
simplicial object is determined by its restriction to degree zero, and there the two ends of a
simplicial homotopy are the two cofaces `⦋0⦌ ⟶ ⦋1⦌` composed with one and the same morphism, which
the colimit identifies.

## References

* [Stacks Project, Tag 08QA](https://stacks.math.columbia.edu/tag/08QA)
* [Stacks Project, Tag 019N](https://stacks.math.columbia.edu/tag/019N)
* [Stacks Project, Tag 09WN](https://stacks.math.columbia.edu/tag/09WN)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open scoped Simplicial

universe vA uA vJ uJ uD vD u u'

namespace Stacks.ChaoticSite

/-! ### Colimits of simplicial objects and simplicial homotopies -/

section SimplicialColimits

variable {A : Type uA} [Category.{vA} A] [HasColimitsOfShape SimplexCategoryᵒᵖ A]

/-- **A morphism out of the colimit of a simplicial object is determined in degree zero.** -/
lemma colimit_hom_ext_zero (X : SimplicialObject A) {T : A} {a b : colimit X ⟶ T}
    (h : colimit.ι X (op ⦋0⦌) ≫ a = colimit.ι X (op ⦋0⦌) ≫ b) : a = b := by
  refine colimit.hom_ext fun n ↦ ?_
  rw [← colimit.w X (SimplexCategory.const ⦋0⦌ n.unop 0).op, Category.assoc, Category.assoc, h]

/-- **Simplicially homotopic morphisms induce the same morphism on colimits.** -/
lemma colim_map_eq_of_homotopy {X Y : SimplicialObject A} {a b : X ⟶ Y}
    (h : SimplicialObject.Homotopy a b) :
    (colim : SimplicialObject A ⥤ A).map a = (colim : SimplicialObject A ⥤ A).map b := by
  refine colimit_hom_ext_zero X ?_
  rw [colimit.ι_map, colimit.ι_map, ← h.h_last_comp_δ_last 0, ← h.h_zero_comp_δ_zero 0]
  dsimp only [SimplicialObject.δ]
  rw [Category.assoc, Category.assoc, colimit.w, colimit.w]
  exact congrArg (fun k ↦ h.h k ≫ colimit.ι Y (op ⦋0 + 1⦌))
    (show Fin.last 0 = (0 : Fin (0 + 1)) from Fin.ext rfl)

/-- **Homotopic morphisms induce the same morphism on colimits**, for the equivalence relation
generated by the existence of a simplicial homotopy. -/
lemma colim_map_eq_of_homotopic {X Y : SimplicialObject A} {a b : X ⟶ Y}
    (h : Relation.EqvGen (fun p q : X ⟶ Y ↦ Nonempty (SimplicialObject.Homotopy p q)) a b) :
    (colim : SimplicialObject A ⥤ A).map a = (colim : SimplicialObject A ⥤ A).map b := by
  induction h with
  | rel _ _ hpq => exact colim_map_eq_of_homotopy hpq.some
  | refl _ => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- **A homotopy equivalence of simplicial objects induces an isomorphism on colimits.** -/
lemma isIso_colim_map_of_homotopyEquivalences {X Y : SimplicialObject A} (a : X ⟶ Y)
    (ha : SimplicialObject.homotopyEquivalences A a) :
    IsIso ((colim : SimplicialObject A ⥤ A).map a) := by
  obtain ⟨b, hab, hba⟩ := ha
  refine ⟨(colim : SimplicialObject A ⥤ A).map b, ?_, ?_⟩
  · rw [← CategoryTheory.Functor.map_comp, colim_map_eq_of_homotopic hab,
      CategoryTheory.Functor.map_id]
  · rw [← CategoryTheory.Functor.map_comp, colim_map_eq_of_homotopic hba,
      CategoryTheory.Functor.map_id]

end SimplicialColimits

/-! ### The finality criterion at arbitrary universes -/

section Criterion

variable {J : Type uJ} [Category.{vJ} J] {A : Type uA} [Category.{vA} A]

/-- **Two elements of a sigma type related by the colimit relation of a coyoneda functor give
zigzag-connected structured arrows.** -/
lemma zigzag_structuredArrow_of_eqvGen_colimitTypeRel {F : J ⥤ A} {X : A}
    {p q : Σ j, X ⟶ F.obj j}
    (h : Relation.EqvGen (Functor.ColimitTypeRel (F ⋙ coyoneda.obj (op X))) p q) :
    Zigzag (StructuredArrow.mk p.2) (StructuredArrow.mk q.2) := by
  induction h with
  | rel p q hpq =>
      obtain ⟨φ, hφ⟩ := hpq
      exact Zigzag.of_hom (StructuredArrow.homMk φ hφ.symm)
  | refl _ => exact Zigzag.refl _
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- **A functor whose coyoneda colimits are all singletons is final.** This is
`CategoryTheory.final_of_colimit_comp_coyoneda_iso_pUnit` with no relation between the universes
of the objects and the morphisms of the index category and of the morphisms of the target. -/
lemma final_of_colimit_comp_coyoneda_isoPUnit [HasColimitsOfShape J (Type vA)] (F : J ⥤ A)
    (e : ∀ X : A, colimit (F ⋙ coyoneda.obj (op X)) ≅ PUnit.{vA + 1}) : F.Final := by
  refine ⟨fun X ↦ ?_⟩
  have hne : Nonempty (StructuredArrow X F) := by
    obtain ⟨j, y, -⟩ := Types.jointly_surjective' ((e X).inv PUnit.unit)
    exact ⟨StructuredArrow.mk y⟩
  refine @zigzag_isConnected _ _ hne ?_
  rintro ⟨⟨⟨⟩⟩, j₁, h₁⟩ ⟨⟨⟨⟩⟩, j₂, h₂⟩
  refine zigzag_structuredArrow_of_eqvGen_colimitTypeRel
    (Types.colimit_eq (F := F ⋙ coyoneda.obj (op X)) (j := j₁) (j' := j₂) ?_)
  exact (e X).toEquiv.injective (Subsingleton.elim _ _)

end Criterion

/-! ### A point resolution is initial -/

section Finality

variable {C : Type u} [SmallCategory C] {U : CosimplicialObject C}

/-- **The colimit over `Δᵒᵖ` of `Mor_C(U_•, W)` is a singleton**, for `U_•` a point resolution. -/
def colimitMorIsoPUnit (hU : IsPointResolution U) (W : C) :
    colimit (U.op ⋙ yoneda.obj W) ≅ PUnit.{u + 1} :=
  haveI := isIso_colim_map_of_homotopyEquivalences _ (hU W).choose_spec
  haveI : IsConnected SimplexCategoryᵒᵖ := isConnected_of_hasInitial _
  asIso ((colim : SimplicialObject (Type u) ⥤ Type u).map (hU W).choose) ≪≫
    Types.colimitConstPUnitIsoPUnit.{u} SimplexCategoryᵒᵖ

/-- **`U.op` is a final functor, for `U_•` a point resolution.** -/
theorem final_op_of_isPointResolution (hU : IsPointResolution U) : U.op.Final :=
  final_of_colimit_comp_coyoneda_isoPUnit U.op fun W ↦
    HasColimit.isoOfNatIso (Functor.isoWhiskerLeft U.op (Coyoneda.objOpOp W.unop)) ≪≫
      colimitMorIsoPUnit hU W.unop

/-- **A point resolution is an initial functor `SimplexCategory ⥤ C`.** -/
theorem initial_of_isPointResolution (hU : IsPointResolution U) : U.Initial :=
  have := final_op_of_isPointResolution hU
  Functor.initial_of_final_op U

/-- **The comparison of the colimit over `Δᵒᵖ` with the colimit over `Cᵒᵖ` is invertible**, for
`U_•` a point resolution and arbitrary coefficients. -/
theorem isIso_colimitPre_of_isPointResolution (hU : IsPointResolution U) (D : Type uD)
    [Category.{vD} D] [HasColimitsOfShape Cᵒᵖ D] [HasColimitsOfShape SimplexCategoryᵒᵖ D]
    (G : Cᵒᵖ ⥤ D) : IsIso (colimit.pre G U.op) :=
  have := final_op_of_isPointResolution hU
  Functor.Final.colimit_pre_isIso U.op

end Finality

/-! ### The underived form of Tag 08QA -/

section Restriction

variable {C : Type u} {C' : Type u'} [SmallCategory C] [SmallCategory C'] (f : C' ⥤ C)
  {U : CosimplicialObject C'} (D : Type uD) [Category.{vD} D] [HasColimitsOfShape Cᵒᵖ D]
  [HasColimitsOfShape C'ᵒᵖ D] [HasColimitsOfShape SimplexCategoryᵒᵖ D]

/-- **The underived form of [Stacks, Tag 08QA] at arbitrary coefficients.** Let `f : C' ⥤ C` be a
functor between small categories with their chaotic topologies, let `g^{-1}` be restriction of
diagrams along `f`, and let `U_•` be a cosimplicial object of `C'` such that both `U_•` and
`f(U_•)` are point resolutions. Then the canonical comparison
`π'_!(g^{-1}G) = colim_{C'ᵒᵖ}(G ∘ f.op) ⟶ colim_{Cᵒᵖ}G = π_!(G)` is an isomorphism. -/
theorem isIso_colimitPre_op_of_isPointResolutions (hU : IsPointResolution U)
    (hfU : IsPointResolution (U ⋙ f)) (G : Cᵒᵖ ⥤ D) : IsIso (colimit.pre G f.op) := by
  have h₁ : IsIso (colimit.pre (f.op ⋙ G) U.op) :=
    isIso_colimitPre_of_isPointResolution hU D (f.op ⋙ G)
  have h₂ : IsIso (colimit.pre G (U.op ⋙ f.op)) :=
    isIso_colimitPre_of_isPointResolution (U := U ⋙ f) hfU D G
  have : IsIso (colimit.pre (f.op ⋙ G) U.op ≫ colimit.pre G f.op) := by
    rw [colimit.pre_pre G f.op U.op]; exact h₂
  exact IsIso.of_isIso_comp_left (colimit.pre (f.op ⋙ G) U.op) (colimit.pre G f.op)

/-- **The underived form of [Stacks, Tag 08QA] as an isomorphism of functors.** The natural
transformation `Stacks.CategoryHomology.diagramColimitRestrictionPre` is invertible when both
`U_•` and `f(U_•)` are point resolutions. -/
theorem isIso_diagramColimitRestrictionPre (hU : IsPointResolution U)
    (hfU : IsPointResolution (U ⋙ f)) :
    IsIso (Stacks.CategoryHomology.diagramColimitRestrictionPre f D) := by
  refine (NatTrans.isIso_iff_isIso_app _).2 fun G ↦ ?_
  exact isIso_colimitPre_op_of_isPointResolutions f D hU hfU G

/-- **`π'_! ∘ g^{-1} = π_!` at arbitrary coefficients**, the underived form of
[Stacks, Tag 08QA]. -/
def diagramColimitRestrictionPreNatIso (hU : IsPointResolution U)
    (hfU : IsPointResolution (U ⋙ f)) :
    (Functor.whiskeringLeft C'ᵒᵖ Cᵒᵖ D).obj f.op ⋙ (colim : (C'ᵒᵖ ⥤ D) ⥤ D) ≅
      (colim : (Cᵒᵖ ⥤ D) ⥤ D) :=
  haveI := isIso_diagramColimitRestrictionPre f D hU hfU
  asIso (Stacks.CategoryHomology.diagramColimitRestrictionPre f D)

end Restriction

end Stacks.ChaoticSite

end
