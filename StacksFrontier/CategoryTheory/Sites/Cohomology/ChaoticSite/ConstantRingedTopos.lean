module

public import StacksFrontier.CategoryTheory.Sites.Cohomology.ChaoticSite.PointMorphismSituation
import StacksCore.Tactic.StacksAttribute

/-!
# The constant-coefficient ringed topos of a chaotic site

Let `C` be a category and `B` a commutative ring. Giving `C` its chaotic topology and the
constant sheaf `B̲` as structure sheaf produces a ringed topos `(Sh(C), B̲)` which depends only
on `C` and `B` — on no functor out of or into `C`. A functor `f : C' ⥤ C` is automatically
continuous and cocontinuous for the chaotic topologies, and over the one-object category it is a
1-morphism of fibred categories, so the standing data of Stacks 08PA applies to it; the topology
it makes `C` and `C'` inherit from the chaotic point is again the chaotic one.

This file provides that situation. The morphism of ringed topoi it produces, and the
identification of its inverse-image coefficient sheaves with the constant sheaves, are in
`StacksFrontier.CategoryTheory.Sites.Cohomology.ChaoticSite.ConstantRingedToposMorphism`.

## Main definitions

* `Stacks.ChaoticSite.constantRingSheaf`: the constant sheaf of rings `B̲` on a chaotic site.
* `Stacks.ChaoticSite.constantRingedTopos`: the ringed topos `(Sh(C), B̲)`.
* `Stacks.ChaoticSite.functorSituation`: the standing data of Stacks 08PA attached to a functor
  `f : C' ⥤ C` and a ring `B` carried on the one-object category.

## Main results

* `Stacks.ChaoticSite.isContinuous_trivial` and
  `Stacks.ChaoticSite.isCocontinuous_trivial`: every functor between chaotic sites is
  continuous and cocontinuous.
* `Stacks.ChaoticSite.star_isFibredOneMorphism_of_functor`: every functor is a 1-morphism of
  fibred categories over the one-object category.
* `Stacks.ChaoticSite.star_inheritedTopology_bot`: the topology a category inherits from the
  chaotic one-object site along the unique functor to it is chaotic.
* `Stacks.ChaoticSite.functorSituation_totalTopology` and
  `Stacks.ChaoticSite.functorSituation_sourceTopology`: consequently both inherited topologies of
  the situation are the chaotic ones.

## Implementation notes

Four declarations here deliberately sit beside a special case of themselves in the library, and the
duplication has an expiry condition: it exists **only** because
`Stacks.ChaoticSite.RingedPointSituation` pins the one-object category to
`Discrete PUnit.{u + 1}` for `C : Type u`, while the double square of Stacks 08QN needs
`C : Type u` and `C' : Type u'` in independent universes, hence the point in `max u u'`.

* `star_isFibredOneMorphism_of_functor` generalises `star_isFibredOneMorphism`
  (`ChaoticSite/PointMorphismSituation.lean`), its case `f = Functor.star C`.
* `star_inheritedTopology_bot` generalises `RingedPointSituation.topology_eq_trivial`
  (`ChaoticSite/RingedPoint.lean`), whose target universe is not free.
* `isContinuous_trivial` and `isCocontinuous_trivial` generalise `pointFunctor_isContinuous`
  and `pointFunctor_isCocontinuous` (`ChaoticSite/PointMorphism.lean`) from the unique functor
  to the point to an arbitrary functor; the proofs are unchanged, because the chaotic-topology
  condition does not mention the functor.

**If the universes of `RingedPointSituation` are unpinned, those four declarations become
corollaries of the ones here and the pairs can be collapsed.**

## References

* [Stacks Project, Tag 08PH](https://stacks.math.columbia.edu/tag/08PH)
* [Stacks Project, Tag 08PA](https://stacks.math.columbia.edu/tag/08PA)
* [Stacks Project, Tag 08PF](https://stacks.math.columbia.edu/tag/08PF)
-/

@[expose] public section

open CategoryTheory

namespace Stacks.ChaoticSite

universe w v v' u u' u₀

/-- An arrow strongly cartesian for the unique functor to the one-object category is invertible. -/
private theorem isIso_of_isStronglyCartesian_star {C : Type u} [Category.{v} C]
    {R S : Discrete PUnit.{u₀ + 1}} (g : R ⟶ S) {a b : C} (φ : a ⟶ b)
    (h : (Functor.star.{u₀, v, u} C).IsStronglyCartesian g φ) : IsIso φ :=
  have : IsIso g := inferInstance
  Functor.IsStronglyCartesian.isIso_of_base_isIso (Functor.star.{u₀, v, u} C) g φ

/-- The topology a category inherits from the chaotic topology on the one-object category, along
the unique functor to it, is the chaotic topology: a sieve generated by a presieve of cartesian
arrows whose image covers must already contain an identity, because every arrow over the point is
cartesian and lies over an isomorphism.

This is `Stacks.ChaoticSite.RingedPointSituation.topology_eq_trivial` with the universe of the
one-object category left free; see the implementation notes for the expiry condition on the
duplication. -/
theorem star_inheritedTopology_bot (C : Type u) [Category.{v} C] :
    (Functor.star.{u₀, v, u} C).inheritedTopology
      (⊥ : GrothendieckTopology (Discrete PUnit.{u₀ + 1})) = ⊥ := by
  rw [Functor.inheritedTopology_eq]
  refine le_antisymm ((Precoverage.toGrothendieck_le_iff_le_toPrecoverage).2 ?_) bot_le
  intro X R hR
  rw [GrothendieckTopology.mem_toPrecoverage_iff]
  refine (Sieve.id_mem_iff_eq_top).mp ?_
  have hbase : (R.map (Functor.star.{u₀, v, u} C)) ∈
      (⊥ : GrothendieckTopology (Discrete PUnit.{u₀ + 1})).toPrecoverage
        ((Functor.star.{u₀, v, u} C).obj X) := hR.2
  rw [GrothendieckTopology.mem_toPrecoverage_iff] at hbase
  change Sieve.generate (R.map (Functor.star.{u₀, v, u} C)) = ⊤ at hbase
  have hmem : (Sieve.generate (R.map (Functor.star.{u₀, v, u} C)))
      (𝟙 ((Functor.star.{u₀, v, u} C).obj X)) := by rw [hbase]; trivial
  obtain ⟨Y, a, b, hb, hab⟩ := hmem
  obtain ⟨Z, rfl, g, hg, _⟩ := (Presieve.map_iff).mp hb
  have := isIso_of_isStronglyCartesian_star _ g (hR.1 g hg)
  exact ⟨Z, inv g, g, hg, by simp⟩

/-- Every functor between categories carrying their chaotic topologies is continuous: every
presheaf is a sheaf for the chaotic topology, so the condition is empty.

Generalises `Stacks.ChaoticSite.pointFunctor_isContinuous` from the unique functor to the point;
see the implementation notes for the expiry condition on the duplication. -/
instance isContinuous_trivial (C : Type u) (C' : Type u')
    [Category.{v} C] [Category.{v'} C'] (f : C' ⥤ C) :
    f.IsContinuous (GrothendieckTopology.trivial C') (GrothendieckTopology.trivial C) where
  op_comp_isSheaf_of_types _ := by
    simpa [GrothendieckTopology.trivial_eq_bot] using Presieve.isSheaf_bot

/-- Every functor between categories carrying their chaotic topologies is cocontinuous: the only
covering sieve of the chaotic topology is the maximal one, whose pullback is maximal.

Generalises `Stacks.ChaoticSite.pointFunctor_isCocontinuous`; see the implementation notes for
the expiry condition on the duplication. -/
instance isCocontinuous_trivial (C : Type u) (C' : Type u')
    [Category.{v} C] [Category.{v'} C'] (f : C' ⥤ C) :
    f.IsCocontinuous (GrothendieckTopology.trivial C') (GrothendieckTopology.trivial C) where
  cover_lift hS := by
    rw [GrothendieckTopology.trivial_covering] at hS
    subst hS
    simp

/-- Over the one-object category every functor is a 1-morphism of fibred categories: the
commutativity of the triangle is `rfl`, and a morphism is cartesian over the point as soon as it
is an isomorphism, which every arrow over an isomorphism of the point is.

Generalises `Stacks.ChaoticSite.star_isFibredOneMorphism`, its case `f = Functor.star C`; see
the implementation notes for the expiry condition on the duplication. -/
theorem star_isFibredOneMorphism_of_functor
    (C : Type u) (C' : Type u') [Category.{v} C] [Category.{v'} C'] (f : C' ⥤ C) :
    (Functor.star.{max u u', v', u'} C').IsFibredOneMorphism
      (Functor.star.{max u u', v, u} C) f where
  comp_eq := rfl
  map_isStronglyCartesian := by
    intro R T g a b φ hφ
    have : IsIso φ := isIso_of_isStronglyCartesian_star g φ hφ
    have : (Functor.star.{max u u', v, u} C).IsHomLift g (f.map φ) :=
      IsHomLift.of_fac' (Functor.star.{max u u', v, u} C) g (f.map φ)
        (Subsingleton.elim _ _) (Subsingleton.elim _ _) (by apply Subsingleton.elim)
    have : IsIso (f.map φ) := by infer_instance
    exact Functor.IsStronglyCartesian.of_isIso
      (Functor.star.{max u u', v, u} C) g (f.map φ)

/-- The constant sheaf of commutative rings `B̲` on a category with its chaotic topology. Every
presheaf is a sheaf there, so this is the constant presheaf. -/
noncomputable def constantRingSheaf (C : Type u) [Category.{v} C] (B : CommRingCat.{w}) :
    Sheaf (GrothendieckTopology.trivial C) CommRingCat.{w} :=
  (sheafBotEquivalence CommRingCat.{w}).inverse.obj ((Functor.const Cᵒᵖ).obj B)

/-- The ringed topos `(Sh(C), B̲)` of a category with its chaotic topology and a constant
coefficient ring. It depends only on `C` and `B`, not on any functor out of or into `C`. -/
noncomputable def constantRingedTopos (C : Type u) [Category.{v} C] (B : CommRingCat.{w}) :
    AlgebraicGeometry.RingedTopos.{v, u, w} where
  C := C
  J := GrothendieckTopology.trivial C
  O := constantRingSheaf C B

/-- A ringed topos whose topology is provably chaotic and whose structure sheaf is the constant
one transported along that proof is the constant-coefficient ringed topos. -/
theorem constantRingedTopos_mk_eq (C : Type u) [Category.{v} C] (B : CommRingCat.{w})
    (J : GrothendieckTopology C) (h : J = GrothendieckTopology.trivial C) :
    (AlgebraicGeometry.RingedTopos.mk C J
      (Eq.mp (congrArg (fun K => Sheaf K CommRingCat.{w}) h.symm) (constantRingSheaf C B))) =
      constantRingedTopos C B := by
  subst J
  rfl

/-- The standing data of Stacks 08PA attached to a functor `f : C' ⥤ C` and a commutative ring
`B` carried on the one-object category: the two structure functors are the unique functors to
that category, and `f` is a 1-morphism between them. -/
noncomputable def functorSituation (C : Type u) (C' : Type u')
    [Category.{v} C] [Category.{v'} C'] (f : C' ⥤ C) (B : CommRingCat.{max w u u' v v'}) :
    Stacks.Sites.FibredCategory.MorphismSituation.{max u u', u, u', max u u', v, v',
      max w u u' v v'} where
  base :=
    { C := Discrete PUnit.{max u u' + 1}
      J := GrothendieckTopology.trivial (Discrete PUnit.{max u u' + 1})
      O := (sheafBotEquivalence CommRingCat.{max w u u' v v'}).inverse.obj
        ((Functor.const (Discrete PUnit.{max u u' + 1})ᵒᵖ).obj B) }
  total := C
  source := C'
  p := Functor.star C
  p' := Functor.star C'
  u := f
  isFibredOneMorphism := star_isFibredOneMorphism_of_functor C C' f

/-- The topology the target of the situation inherits from the chaotic point is chaotic. -/
theorem functorSituation_totalTopology (C : Type u) (C' : Type u')
    [Category.{v} C] [Category.{v'} C'] (f : C' ⥤ C) (B : CommRingCat.{max w u u' v v'}) :
    (functorSituation.{w} C C' f B).totalTopology = GrothendieckTopology.trivial C := by
  change (Functor.star.{max u u', v, u} C).inheritedTopology
    (GrothendieckTopology.trivial (Discrete PUnit.{max u u' + 1})) =
      GrothendieckTopology.trivial C
  simpa [GrothendieckTopology.trivial_eq_bot] using star_inheritedTopology_bot C

/-- The topology the source of the situation inherits from the chaotic point is chaotic. -/
theorem functorSituation_sourceTopology (C : Type u) (C' : Type u')
    [Category.{v} C] [Category.{v'} C'] (f : C' ⥤ C) (B : CommRingCat.{max w u u' v v'}) :
    (functorSituation.{w} C C' f B).sourceTopology = GrothendieckTopology.trivial C' := by
  change (Functor.star.{max u u', v', u'} C').inheritedTopology
    (GrothendieckTopology.trivial (Discrete PUnit.{max u u' + 1})) =
      GrothendieckTopology.trivial C'
  simpa [GrothendieckTopology.trivial_eq_bot] using star_inheritedTopology_bot C'

end Stacks.ChaoticSite

/- Giving two categories their chaotic topologies makes every functor between them, and the
functors to the one-object category, continuous and cocontinuous, and the resulting commutative
triangle of ringed topoi with constant structure sheaf over a ring on the point is an instance
of the standing data of Stacks 08PA. The tags are registered on those declarations rather than
on copies of them. -/
add_to_stacks 08PH "chaotic_functors_continuous" Stacks.ChaoticSite.isContinuous_trivial

add_to_stacks 08PH "chaotic_functors_continuous" Stacks.ChaoticSite.isCocontinuous_trivial

add_to_stacks 08PH "chaotic_functors_continuous"
  Stacks.ChaoticSite.star_isFibredOneMorphism_of_functor

add_to_stacks 08PH "constant_ringed_topos" Stacks.ChaoticSite.constantRingSheaf

add_to_stacks 08PH "constant_ringed_topos" Stacks.ChaoticSite.constantRingedTopos

add_to_stacks 08PH "ringed_triangle" Stacks.ChaoticSite.functorSituation

add_to_stacks 08PH "ringed_triangle" Stacks.ChaoticSite.functorSituation_totalTopology

add_to_stacks 08PH "ringed_triangle" Stacks.ChaoticSite.functorSituation_sourceTopology

end
