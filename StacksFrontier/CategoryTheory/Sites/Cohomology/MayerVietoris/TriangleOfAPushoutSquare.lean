/-!
# The Mayer–Vietoris triangle of a pushout square of sheafified representables

Let `E ⟶ Y`, `Z ⟶ X` be a commutative square in a ringed site whose sheafified representables
form a pushout square and whose map `h_E^# ⟶ h_Y^#` is a monomorphism. Stacks 0EVY asserts
that the canonical comparison of Stacks 0F16 is then an isomorphism, so that the
Mayer–Vietoris triangle is distinguished, functorially in the derived module sheaf.

`Stacks.Cohomology.MayerVietoris.isIso_derivedCSquare_of_sectionsShortExact` reduces that to a
statement with no derived categories in it: the sections short complex
`M(X) ⟶ M(Z) ⊞ M(Y) ⟶ M(E)` is short exact for every injective sheaf of modules `M`. This file
proves that statement and assembles the tag.

## Main results

* `Stacks.Cohomology.MayerVietoris.shortExact_of_isPullback`: in an abelian category, a
  pullback square with epimorphic right leg gives the short exact sequence
  `P ⟶ X ⊞ Y ⟶ Z` built from signed restriction.
* `Stacks.Cohomology.MayerVietoris.isPullback_op_map`: the sections of *any* sheaf of abelian
  groups over the square form a pullback square, whatever the universe of its sections.
* `Stacks.Cohomology.MayerVietoris.shortExact_sectionsShortComplex`: the sections short
  complex is short exact for an injective sheaf of modules.
* `Stacks.Cohomology.MayerVietoris.isIso_derivedCSquare_of_isPushout`: Stacks 0EVY.

## Implementation notes

Two of the three parts of the source argument — injectivity of `M(X) ⟶ M(Z) ⊞ M(Y)` and
exactness in the middle — are the single statement that the sections form a pullback square,
and that follows from the pushout hypothesis with no further input. The hypothesis is stated
for sheaves of sets with sections in the universe `max u w` generated by the site, while the
sections of a sheaf of modules live in an independent universe `v`; the crossing goes *upward*,
through `CategoryTheory.Sheaf.isPullback_op_map_of_isPushout` at `Type max u w v`, and comes
back down because `CategoryTheory.uliftFunctor` and `forget AddCommGrpCat` both reflect
pullbacks. Working downstairs instead is not available: `HasSheafify J (Type v)` does not hold,
the plus-construction multiequalizers being limits of a shape the universe `v` need not admit.

The third part — surjectivity of `M(Y) ⟶ M(E)` — is the only one that uses injectivity of `M`,
and it is the content of
`Stacks.SheafOfModules.Small.exists_val_map_eq_of_injective`: sections over `U` are the
morphisms out of the free sheaf of modules on the representable at `U`, the monomorphism
hypothesis makes the induced morphism of free sheaves a monomorphism, and an injective object
extends along a monomorphism.

`shortExact_of_isPullback` is stated for the short complex spelled out with `biprod.lift` and
`biprod.desc` rather than for `sectionsShortComplex`, because the latter is a definition whose
projections do not reduce at instance transparency; the two are definitionally equal, so the
tagged statement applies the general lemma directly.

## References

* [Stacks Project, Tag 0EVY](https://stacks.math.columbia.edu/tag/0EVY)
* [Stacks Project, Tag 0F16](https://stacks.math.columbia.edu/tag/0F16)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.MayerVietoris

namespace Stacks.Cohomology.MayerVietoris

universe u v w r v₁ u₁

section Abstract

variable {A : Type u₁} [Category.{v₁} A] [Abelian A]

/-- **A pullback square with epimorphic right leg is a short exact sequence.** For a pullback
square `p : P ⟶ X`, `q : P ⟶ Y` over `f : X ⟶ Z`, `g : Y ⟶ Z` with `g` an epimorphism, the
short complex `P ⟶ X ⊞ Y ⟶ Z` with signed second map is short exact: `P` is the kernel of the
signed map because it is the pullback, and the signed map is an epimorphism because its
restriction to `Y` is. -/
lemma shortExact_of_isPullback {P X Y Z : A} {p : P ⟶ X} {q : P ⟶ Y} {f : X ⟶ Z} {g : Y ⟶ Z}
    (h : IsPullback p q f g) [Epi g]
    (hz : biprod.lift p q ≫ biprod.desc f (-g) = 0) :
    (ShortComplex.mk (biprod.lift p q) (biprod.desc f (-g)) hz).ShortExact := by
  have hlift : biprod.lift p q =
      h.isoPullback.hom ≫ Abelian.PullbackToBiproductIsKernel.pullbackToBiproduct f g := by
    refine biprod.hom_ext _ _ ?_ ?_
    · simp only [biprod.lift_fst, Category.assoc]
      exact h.isoPullback_hom_fst.symm
    · simp only [biprod.lift_snd, Category.assoc]
      exact h.isoPullback_hom_snd.symm
  have hlim := Abelian.PullbackToBiproductIsKernel.isLimitPullbackToBiproduct f g
  have hker : IsLimit (KernelFork.ofι
      (ShortComplex.mk (biprod.lift p q) (biprod.desc f (-g)) hz).f
      (ShortComplex.mk (biprod.lift p q) (biprod.desc f (-g)) hz).zero) := by
    refine IsLimit.ofIsoLimit hlim (Fork.ext h.isoPullback.symm ?_)
    rw [Iso.symm_hom, Fork.ι_ofι]
    show h.isoPullback.inv ≫ biprod.lift p q = _
    rw [hlift, Iso.inv_hom_id_assoc]
    rfl
  refine ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ hker)
    (mono_of_isLimit_fork hker) ?_
  have : Epi (biprod.inr ≫
      (ShortComplex.mk (biprod.lift p q) (biprod.desc f (-g)) hz).g) := by
    show Epi (biprod.inr ≫ biprod.desc f (-g))
    rw [biprod.inr_desc]
    infer_instance
  exact epi_of_epi biprod.inr _

end Abstract

section Site

variable {S : AlgebraicGeometry.RingedSite.{u, w, r}}
  [HasSheafify S.J AddCommGrpCat.{v}]
  [S.J.WEqualsLocallyBijective AddCommGrpCat.{v}]

attribute [local instance] HasDerivedCategory.standard

/-- The underlying sheaf of sets of a sheaf of abelian groups, with its sections lifted into a
universe containing the site. This is what lets a hypothesis about sheaves of sets on the site
be applied to a sheaf whose universe of sections is independent of the site. -/
def uliftSheaf (G : Sheaf S.J AddCommGrpCat.{v}) : Sheaf S.J (Type max u w v) :=
  ⟨(G.obj ⋙ forget AddCommGrpCat.{v}) ⋙ uliftFunctor.{max u w, v},
    Presheaf.isSheaf_comp_of_isSheaf _ _ _
      ((sheafCompose S.J (forget AddCommGrpCat.{v})).obj G).2⟩

omit [HasSheafify S.J AddCommGrpCat.{v}]
  [S.J.WEqualsLocallyBijective AddCommGrpCat.{v}] in
/-- **The sections of a sheaf of abelian groups over a Mayer-Vietoris square form a pullback
square.** The universe of the sections is arbitrary: the pushout hypothesis is carried up to
`Type max u w v` by `CategoryTheory.Sheaf.isPullback_op_map_of_isPushout`, and brought back
down because `CategoryTheory.uliftFunctor` and `forget AddCommGrpCat` reflect pullbacks. -/
lemma isPullback_op_map (sq : Square S.C)
    (hpushout : (sq.map (Sheaf.sheafifiedYoneda S.J)).IsPushout)
    (G : Sheaf S.J AddCommGrpCat.{v}) :
    (sq.op.map G.obj).IsPullback := by
  have h0 : (sq.op.map (uliftSheaf.{u, v, w, r} (S := S) G).obj).IsPullback :=
    Sheaf.isPullback_op_map_of_isPushout.{u, w, v} S.J sq hpushout _
  have h1 : ((sq.op.map (G.obj ⋙ forget AddCommGrpCat.{v})).map
      uliftFunctor.{max u w, v}).IsPullback := h0
  have h2 : (sq.op.map (G.obj ⋙ forget AddCommGrpCat.{v})).IsPullback :=
    Square.IsPullback.of_map uliftFunctor.{max u w, v} h1
  have h3 : ((sq.op.map G.obj).map (forget AddCommGrpCat.{v})).IsPullback := h2
  exact Square.IsPullback.of_map (forget AddCommGrpCat.{v}) h3

section Injective

variable [UnivLE.{u, v}] [UnivLE.{w, v}] [UnivLE.{r, v}]

omit [UnivLE.{u, v}] in
/-- **Restriction of sections of an injective sheaf of modules is an epimorphism** along a
morphism of the site whose sheafified representables map by a monomorphism. -/
lemma epi_sectionsRestriction_of_injective {U V : S.C} (g : U ⟶ V)
    (hmono : Mono ((Sheaf.sheafifiedYoneda S.J).map g))
    (M : SheafOfModules.{v} (Stacks.SheafOfModules.Tensor.ringSheaf S.O)) (hM : Injective M) :
    Epi (((SheafOfModules.toSheaf (Stacks.SheafOfModules.Tensor.ringSheaf S.O)).obj M).obj.map
      g.op) := by
  have := hM
  have hloc := Sheaf.isLocallyInjective_yoneda_map_of_mono S.J g hmono
  refine (AddCommGrpCat.epi_iff_surjective _).2 (fun m ↦ ?_)
  obtain ⟨n, hn⟩ := Stacks.SheafOfModules.Small.exists_val_map_eq_of_injective.{u, v, w, r}
    (Stacks.SheafOfModules.Tensor.ringSheaf S.O) g hloc M m
  exact ⟨n, hn⟩

omit [UnivLE.{u, v}] in
/-- **The sheaf-theoretic content of Stacks 0EVY.** If the sheafified representables of the
square form a pushout square and `h_E^# ⟶ h_Y^#` is a monomorphism, then for every injective
sheaf of modules `M` the sections short complex `M(X) ⟶ M(Z) ⊞ M(Y) ⟶ M(E)` is short exact. -/
theorem shortExact_sectionsShortComplex (sq : Square S.C)
    (hpushout : (sq.map (Sheaf.sheafifiedYoneda S.J)).IsPushout)
    (hmono : Mono ((Sheaf.sheafifiedYoneda S.J).map sq.f₁₂))
    (M : SheafOfModules.{v} (Stacks.SheafOfModules.Tensor.ringSheaf S.O)) (hM : Injective M) :
    (sectionsShortComplex.{u, v, w, r} sq M).ShortExact := by
  have := epi_sectionsRestriction_of_injective.{u, v, w, r} sq.f₁₂ hmono M hM
  have hpb : IsPullback
      (((SheafOfModules.toSheaf (Stacks.SheafOfModules.Tensor.ringSheaf S.O)).obj M).obj.map
        sq.f₃₄.op)
      (((SheafOfModules.toSheaf (Stacks.SheafOfModules.Tensor.ringSheaf S.O)).obj M).obj.map
        sq.f₂₄.op)
      (((SheafOfModules.toSheaf (Stacks.SheafOfModules.Tensor.ringSheaf S.O)).obj M).obj.map
        sq.f₁₃.op)
      (((SheafOfModules.toSheaf (Stacks.SheafOfModules.Tensor.ringSheaf S.O)).obj M).obj.map
        sq.f₁₂.op) :=
    (isPullback_op_map.{u, v, w, r} sq hpushout
      ((SheafOfModules.toSheaf (Stacks.SheafOfModules.Tensor.ringSheaf S.O)).obj M) :
        IsPullback _ _ _ _).flip
  exact shortExact_of_isPullback hpb _

/-- **Stacks 0EVY.** If the sheafified representables of the square form a pushout square and
`h_E^# ⟶ h_Y^#` is a monomorphism, then the canonical natural transformation of Stacks 0F16 is
an isomorphism, so that the Mayer-Vietoris triangle is distinguished and functorial for every
object of the derived category of module sheaves. -/
@[stacks 0EVY]
theorem isIso_derivedCSquare_of_isPushout (sq : Square S.C)
    (hpushout : (sq.map (Sheaf.sheafifiedYoneda S.J)).IsPushout)
    (hmono : Mono ((Sheaf.sheafifiedYoneda S.J).map sq.f₁₂)) :
    IsIso (CanonicalMapOfComplexes.derivedCSquareData.{u, v}
      (R := (Stacks.SheafOfModules.Tensor.ringSheaf S.O)) sq).derivedCSquare :=
  isIso_derivedCSquare_of_sectionsShortExact.{u, v, w, r} sq
    (fun M hM ↦ shortExact_sectionsShortComplex.{u, v, w, r} sq hpushout hmono M hM)

end Injective

end Site

end Stacks.Cohomology.MayerVietoris

end
