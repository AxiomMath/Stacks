/-- `goodCoconeDesc_natural` for a site whose category need not be small. -/
private theorem goodCoconeDesc_natural'
    {C : Type d} [Category.{d'} C] {A : Type b} [Category A]
    {I : Type c} [SmallCategory I] {F : I ⥤ (Cᵒᵖ ⥤ A)}
    (coc : Cocone F) (r : Cocone F)
    {U V : C} (f : U ⟶ V)
    (hV : IsColimit (((evaluation Cᵒᵖ A).obj (op V)).mapCocone coc))
    (hU : IsColimit (((evaluation Cᵒᵖ A).obj (op U)).mapCocone coc)) :
    coc.pt.map f.op ≫ hU.desc (((evaluation Cᵒᵖ A).obj (op U)).mapCocone r) =
      hV.desc (((evaluation Cᵒᵖ A).obj (op V)).mapCocone r) ≫ r.pt.map f.op := by
  apply hV.hom_ext
  intro i
  have hUfac := hU.fac (((evaluation Cᵒᵖ A).obj (op U)).mapCocone r) i
  have hVfac := hV.fac (((evaluation Cᵒᵖ A).obj (op V)).mapCocone r) i
  change (coc.ι.app i).app (op U) ≫
    hU.desc (((evaluation Cᵒᵖ A).obj (op U)).mapCocone r) =
    (r.ι.app i).app (op U) at hUfac
  change (coc.ι.app i).app (op V) ≫
    hV.desc (((evaluation Cᵒᵖ A).obj (op V)).mapCocone r) =
    (r.ι.app i).app (op V) at hVfac
  change (coc.ι.app i).app (op V) ≫ coc.pt.map f.op ≫
    hU.desc (((evaluation Cᵒᵖ A).obj (op U)).mapCocone r) =
    (coc.ι.app i).app (op V) ≫
    hV.desc (((evaluation Cᵒᵖ A).obj (op V)).mapCocone r) ≫ r.pt.map f.op
  calc
    _ = ((F.obj i).map f.op ≫ (coc.ι.app i).app (op U)) ≫ _ := by
      rw [← Category.assoc]
      congr 1
      simp
    _ = (F.obj i).map f.op ≫ (r.ι.app i).app (op U) := by rw [Category.assoc, hUfac]
    _ = (r.ι.app i).app (op V) ≫ r.pt.map f.op := by
      simp
    _ = _ := by
      rw [← hVfac]
      simp [Category.assoc]

/-- `presheafCoconeDesc_existsUnique` for a site whose category need not be small. -/
private theorem presheafCoconeDesc_existsUnique'
    {C : Type d} [Category.{d'} C] (K : GrothendieckTopology C)
    {A : Type b} [Category A] {I : Type c} [SmallCategory I]
    {F : I ⥤ (Cᵒᵖ ⥤ A)} (c : Cocone F) (Y : Sheaf K A)
    (η : ∀ i, F.obj i ⟶ Y.obj)
    (hη : ∀ {i j : I} (f : i ⟶ j), F.map f ≫ η j = η i)
    (hEnough : K.HasEnoughObjects
      (fun U => Nonempty (IsColimit (((evaluation Cᵒᵖ A).obj (op U)).mapCocone c)))) :
    ∃! (δ : c.pt ⟶ Y.obj), ∀ i, c.ι.app i ≫ δ = η i := by
  classical
  let r : Cocone F := {
    pt := Y.obj
    ι := { app := η, naturality := fun _ _ f => by simpa using hη f }
  }
  let good : C → Prop := fun U =>
    Nonempty (IsColimit (((evaluation Cᵒᵖ A).obj (op U)).mapCocone c))
  let localDesc (U : C) (hU : good U) : c.pt.obj (op U) ⟶ Y.obj.obj (op U) :=
    (Classical.choice hU).desc (((evaluation Cᵒᵖ A).obj (op U)).mapCocone r)
  have localDesc_fac (U : C) (hU : good U) (i : I) :
      (c.ι.app i).app (op U) ≫ localDesc U hU = (r.ι.app i).app (op U) :=
    (Classical.choice hU).fac _ i
  have localDesc_natural := fun {U V : C} (f : U ⟶ V) (hV : good V) (hU : good U) =>
    goodCoconeDesc_natural' c r f (Classical.choice hV) (Classical.choice hU)
  have factorMap_eq {U V : C} (f : U ⟶ V)
      {T₁ T₂ : C} (hT₁ : good T₁) (hT₂ : good T₂)
      (k₁ : U ⟶ T₁) (g₁ : T₁ ⟶ V) (k₂ : U ⟶ T₂) (g₂ : T₂ ⟶ V)
      (hcomp : k₁ ≫ g₁ = k₂ ≫ g₂) :
      c.pt.map g₁.op ≫ localDesc T₁ hT₁ ≫ Y.obj.map k₁.op =
        c.pt.map g₂.op ≫ localDesc T₂ hT₂ ≫ Y.obj.map k₂.op := by
    obtain ⟨L, Z, q, hq, hgood⟩ := hEnough U
    apply Y.property.hom_ext_ofArrows q hq
    intro j
    calc
      (c.pt.map g₁.op ≫ localDesc T₁ hT₁ ≫ Y.obj.map k₁.op) ≫ Y.obj.map (q j).op =
          c.pt.map g₁.op ≫ localDesc T₁ hT₁ ≫ Y.obj.map (q j ≫ k₁).op := by
            simp [op_comp, Category.assoc]
      _ = c.pt.map g₁.op ≫ c.pt.map (q j ≫ k₁).op ≫ localDesc (Z j) (hgood j) := by
            simpa [Category.assoc] using congrArg
              (fun x => c.pt.map g₁.op ≫ x)
              (localDesc_natural (q j ≫ k₁) hT₁ (hgood j)).symm
      _ = c.pt.map ((q j ≫ k₁) ≫ g₁).op ≫ localDesc (Z j) (hgood j) := by
            simp [op_comp, Category.assoc]
      _ = c.pt.map ((q j ≫ k₂) ≫ g₂).op ≫ localDesc (Z j) (hgood j) := by
            rw [Category.assoc, hcomp, ← Category.assoc]
      _ = c.pt.map g₂.op ≫ c.pt.map (q j ≫ k₂).op ≫ localDesc (Z j) (hgood j) := by
            simp [op_comp, Category.assoc]
      _ = c.pt.map g₂.op ≫ localDesc T₂ hT₂ ≫ Y.obj.map (q j ≫ k₂).op := by
            simpa [Category.assoc] using congrArg
              (fun x => c.pt.map g₂.op ≫ x)
              (localDesc_natural (q j ≫ k₂) hT₂ (hgood j))
      _ = (c.pt.map g₂.op ≫ localDesc T₂ hT₂ ≫ Y.obj.map k₂.op) ≫ Y.obj.map (q j).op := by
            simp [op_comp, Category.assoc]
  let R (V : C) : Presieve V := fun T _ => good T
  let S (V : C) : K.Cover V := by
    refine ⟨Sieve.generate (R V), ?_⟩
    obtain ⟨L, Z, f, hf, hgood⟩ := hEnough V
    apply K.superset_covering ?_ hf
    change Sieve.generate (Presieve.ofArrows Z f) ≤ Sieve.generate (R V)
    apply Sieve.generate_mono
    rintro W g ⟨i⟩
    exact hgood i
  let family (V : C) (I₀ : (S V).Arrow) :
      c.pt.obj (op V) ⟶ Y.obj.obj (op I₀.Y) := by
    let domain := I₀.hf.choose
    let first := I₀.hf.choose_spec.choose
    let second := I₀.hf.choose_spec.choose_spec.choose
    exact c.pt.map second.op ≫ localDesc domain
      I₀.hf.choose_spec.choose_spec.choose_spec.1 ≫ Y.obj.map first.op
  have family_eq (V : C) (I₀ : (S V).Arrow) {T : C} (hT : good T)
      (k : I₀.Y ⟶ T) (g : T ⟶ V) (hkg : k ≫ g = I₀.f) :
      family V I₀ = c.pt.map g.op ≫ localDesc T hT ≫ Y.obj.map k.op :=
    factorMap_eq I₀.f _ hT _ _ k g
      (I₀.hf.choose_spec.choose_spec.choose_spec.2.trans hkg.symm)
  have family_compatible (V : C) :
      ∀ ⦃I₁ I₂ : (S V).Arrow⦄ (r₁₂ : I₁.Relation I₂),
        family V I₁ ≫ Y.obj.map r₁₂.g₁.op = family V I₂ ≫ Y.obj.map r₁₂.g₂.op := by
    intro I₁ I₂ r₁₂
    obtain ⟨T₁, k₁, g₁, hT₁, hk₁⟩ := I₁.hf
    obtain ⟨T₂, k₂, g₂, hT₂, hk₂⟩ := I₂.hf
    have hcomp : (r₁₂.g₁ ≫ k₁) ≫ g₁ = (r₁₂.g₂ ≫ k₂) ≫ g₂ := by
      simpa only [Category.assoc, hk₁, hk₂] using r₁₂.w
    rw [family_eq V I₁ hT₁ k₁ g₁ hk₁, family_eq V I₂ hT₂ k₂ g₂ hk₂]
    simpa [op_comp, Category.assoc] using
      factorMap_eq (r₁₂.g₁ ≫ I₁.f) hT₁ hT₂
        (r₁₂.g₁ ≫ k₁) g₁ (r₁₂.g₂ ≫ k₂) g₂ hcomp
  let descAt (V : C) : c.pt.obj (op V) ⟶ Y.obj.obj (op V) :=
    Y.property.amalgamate (S V) (family V) (family_compatible V)
  have descAt_map (V : C) (I₀ : (S V).Arrow) :
      descAt V ≫ Y.obj.map I₀.f.op = family V I₀ :=
    Y.property.amalgamate_map (S V) (family V) (family_compatible V) I₀
  let δ : c.pt ⟶ Y.obj := {
    app := fun V => descAt V.unop
    naturality := by
      intro U V f
      apply Y.property.hom_ext (S V.unop)
      intro I₀
      obtain ⟨T, k, g, hT, hkg⟩ := I₀.hf
      let I₁ : (S U.unop).Arrow :=
        ⟨I₀.Y, I₀.f ≫ f.unop, ⟨T, k, g ≫ f.unop, hT, by rw [← hkg]; simp⟩⟩
      calc
        (c.pt.map f ≫ descAt V.unop) ≫ Y.obj.map I₀.f.op =
            c.pt.map f ≫ family V.unop I₀ := by rw [Category.assoc, descAt_map]
        _ = family U.unop I₁ := by
            rw [family_eq V.unop I₀ hT k g hkg,
              family_eq U.unop I₁ hT k (g ≫ f.unop) (by
                dsimp [I₁]
                rw [← hkg, Category.assoc])]
            simp [op_comp, Category.assoc]
        _ = descAt U.unop ≫ Y.obj.map (I₀.f ≫ f.unop).op :=
            (descAt_map U.unop I₁).symm
        _ = (descAt U.unop ≫ Y.obj.map f) ≫ Y.obj.map I₀.f.op := by
            simp [op_comp, Category.assoc]
  }
  have δ_fac (i : I) : c.ι.app i ≫ δ = η i := by
    ext U
    apply Y.property.hom_ext (S U.unop)
    intro I₀
    obtain ⟨T, k, g, hT, hkg⟩ := I₀.hf
    change ((c.ι.app i).app U ≫ descAt U.unop) ≫ Y.obj.map I₀.f.op =
      (η i).app U ≫ Y.obj.map I₀.f.op
    rw [Category.assoc, descAt_map, family_eq U.unop I₀ hT k g hkg]
    calc
      (c.ι.app i).app U ≫ c.pt.map g.op ≫ localDesc T hT ≫ Y.obj.map k.op =
          (F.obj i).map g.op ≫ (c.ι.app i).app (op T) ≫ localDesc T hT ≫
            Y.obj.map k.op := by
              simpa only [Category.assoc, Functor.const_obj_obj, op_unop] using congrArg
                (fun morphism => morphism ≫ localDesc T hT ≫ Y.obj.map k.op)
                ((c.ι.app i).naturality g.op).symm
      _ = (F.obj i).map g.op ≫ (r.ι.app i).app (op T) ≫ Y.obj.map k.op := by
            simpa only [Category.assoc] using congrArg
              (fun morphism => (F.obj i).map g.op ≫ morphism ≫ Y.obj.map k.op)
              (localDesc_fac T hT i)
      _ = (r.ι.app i).app U ≫ Y.obj.map (k ≫ g).op := by
            simpa only [op_comp, Y.obj.map_comp, Category.assoc, op_unop,
              Functor.const_obj_obj, r] using congrArg
              (fun morphism => morphism ≫ Y.obj.map k.op)
              ((r.ι.app i).naturality g.op)
      _ = (r.ι.app i).app U ≫ Y.obj.map I₀.f.op := by rw [hkg]
  refine ⟨δ, δ_fac, fun δ' hδ' => ?_⟩
  ext V
  change δ'.app V = descAt V.unop
  apply Y.property.hom_ext (S V.unop)
  intro I₀
  obtain ⟨T, k, g, hT, hkg⟩ := I₀.hf
  rw [descAt_map, family_eq V.unop I₀ hT k g hkg]
  have hdesc : δ'.app (op T) = localDesc T hT := by
    apply (Classical.choice hT).hom_ext
    intro i
    have hfac :
        (c.ι.app i).app (op T) ≫ δ'.app (op T) = (r.ι.app i).app (op T) := by
      simpa using congrArg (fun η : F.obj i ⟶ Y.obj => (η.app (op T))) (hδ' i)
    exact hfac.trans (localDesc_fac T hT i).symm
  rw [← hkg, op_comp, Y.obj.map_comp, ← Category.assoc,
    ← δ'.naturality g.op, hdesc]
  exact Category.assoc _ _ _

/-- `presheafToSheaf_mapCocone_isColimit` for a site whose category need not be small. -/
private noncomputable def presheafToSheaf_mapCocone_isColimit'
    {C : Type d} [Category.{d'} C] (K : GrothendieckTopology C)
    {A : Type b} [Category A] [HasSheafify K A]
    {I : Type c} [SmallCategory I] {F : I ⥤ (Cᵒᵖ ⥤ A)}
    (c : Cocone F)
    (hEnough : K.HasEnoughObjects
      (fun U => Nonempty (IsColimit (((evaluation Cᵒᵖ A).obj (op U)).mapCocone c)))) :
    IsColimit ((presheafToSheaf K A).mapCocone c) := by
  classical
  let adj := sheafificationAdjunction K A
  let η (s : Cocone (F ⋙ presheafToSheaf K A)) (i : I) :
      F.obj i ⟶ (sheafToPresheaf K A).obj s.pt :=
    adj.homEquiv (F.obj i) s.pt (s.ι.app i)
  have hη (s : Cocone (F ⋙ presheafToSheaf K A)) {i j : I} (f : i ⟶ j) :
      F.map f ≫ η s j = η s i := by
    dsimp [η]
    calc
      F.map f ≫ adj.homEquiv (F.obj j) s.pt (s.ι.app j) =
          adj.homEquiv (F.obj i) s.pt
            ((presheafToSheaf K A).map (F.map f) ≫ s.ι.app j) :=
            (adj.homEquiv_naturality_left (F.map f) (s.ι.app j)).symm
      _ = adj.homEquiv (F.obj i) s.pt (s.ι.app i) :=
            congrArg (adj.homEquiv (F.obj i) s.pt) (s.w f)
  let desc0 (s : Cocone (F ⋙ presheafToSheaf K A)) : c.pt ⟶ s.pt.obj :=
    Classical.choose (presheafCoconeDesc_existsUnique' K c s.pt (η s) (hη s) hEnough)
  have hdesc0 (s : Cocone (F ⋙ presheafToSheaf K A)) (i : I) :
      c.ι.app i ≫ desc0 s = η s i :=
    (Classical.choose_spec
      (presheafCoconeDesc_existsUnique' K c s.pt (η s) (hη s) hEnough)).1 i
  refine IsColimit.mk (fun s => (adj.homEquiv c.pt s.pt).symm (desc0 s)) ?_ ?_
  · intro s i
    apply (adj.homEquiv (F.obj i) s.pt).injective
    change adj.homEquiv (F.obj i) s.pt
      ((presheafToSheaf K A).map (c.ι.app i) ≫
        (adj.homEquiv c.pt s.pt).symm (desc0 s)) = η s i
    rw [adj.homEquiv_naturality_left]
    change c.ι.app i ≫ (adj.homEquiv c.pt s.pt)
      ((adj.homEquiv c.pt s.pt).symm (desc0 s)) = η s i
    rw [Equiv.apply_symm_apply]
    exact hdesc0 s i
  · intro s m hm
    apply (adj.homEquiv c.pt s.pt).injective
    rw [Equiv.apply_symm_apply]
    apply (Classical.choose_spec
      (presheafCoconeDesc_existsUnique' K c s.pt (η s) (hη s) hEnough)).2
    intro i
    calc
      c.ι.app i ≫ adj.homEquiv c.pt s.pt m =
          adj.homEquiv (F.obj i) s.pt
            ((presheafToSheaf K A).map (c.ι.app i) ≫ m) :=
        (adj.homEquiv_naturality_left (c.ι.app i) m).symm
      _ = η s i := congrArg (adj.homEquiv (F.obj i) s.pt) (hm i)

/-- Let `u : D ⥤ C` be a continuous functor and let `F` be a diagram of abelian sheaves on
`C`. If every object of `D` has a cover by objects over which degree-`p` cohomology commutes
with the colimit of `F`, then the degree-`p` higher direct image commutes with that colimit.

This is Stacks 0H7B for sites whose underlying categories need not be small: the categories
`C` and `D` have objects and morphisms in independent universes, which is the form that applies
to the small étale site of a scheme, whose objects lie one universe above its morphisms. -/
public theorem preservesColimit_rightDerived_sheafPushforwardContinuous'
    {C : Type a} {D : Type d} [Category.{a'} C] [Category.{d'} D]
    (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    [HasSheafify J (Ab.{b})] [HasSheafify K (Ab.{b})]
    [EnoughInjectives (Sheaf J (Ab.{b}))]
    (u : D ⥤ C) [u.IsContinuous K J]
    (p : ℕ) {I : Type c} [SmallCategory I]
    (F : I ⥤ Sheaf J (Ab.{b}))
    (h : ∀ V : D, ∃ E : PreZeroHypercover.{d'} V, E.sieve₀ ∈ K V ∧
      ∀ i : E.I₀, PreservesColimit F
        (((sheafSections J (Ab.{b})).obj (op (u.obj (E.X i)))).rightDerived p)) :
    PreservesColimit F
      ((u.sheafPushforwardContinuous (Ab.{b}) K J).rightDerived p) := by
  refine ⟨?_⟩
  intro c hc
  let : HasColimit F := ⟨⟨c, hc⟩⟩
  let a := presheafToSheaf K (Ab.{b})
  let precomp := (Functor.whiskeringLeft Dᵒᵖ Cᵒᵖ (Ab.{b})).obj u.op
  let Q := sheafToPresheaf J (Ab.{b}) ⋙ precomp
  let H := Q.rightDerived p
  let push := u.sheafPushforwardContinuous (Ab.{b}) K J
  have : a.PreservesHomology := Functor.preservesHomologyOfExact _
  let pushIso : push ≅ Q ⋙ a :=
    calc
      push ≅ push ⋙ 𝟭 _ := (Functor.rightUnitor push).symm
      _ ≅ push ⋙ (sheafToPresheaf K (Ab.{b}) ⋙ a) :=
        Functor.isoWhiskerLeft push (sheafificationNatIso K (Ab.{b}))
      _ ≅ (push ⋙ sheafToPresheaf K (Ab.{b})) ⋙ a :=
        Functor.associator push (sheafToPresheaf K (Ab.{b})) a
      _ ≅ (sheafToPresheaf J (Ab.{b}) ⋙ precomp) ⋙ a :=
        Functor.isoWhiskerRight
          (u.sheafPushforwardContinuousCompSheafToPresheafIso (Ab.{b}) K J) a
      _ = Q ⋙ a := rfl
  let derivedIso : push.rightDerived p ≅ H ⋙ a :=
    Stacks.Cohomology.CompositeRightDerived.rightDerivedNatIso pushIso p ≪≫
      (Stacks.Cohomology.ModuleComparison.rightDerivedCompIso Q a (Q ⋙ a)
        (Iso.refl _) p).symm
  have hEnough : K.HasEnoughObjects
      (fun V => Nonempty (IsColimit
        (((evaluation Dᵒᵖ (Ab.{b})).obj (op V)).mapCocone (H.mapCocone c)))) := by
    intro V
    obtain ⟨E, hE, hLocal⟩ := h V
    refine ⟨E.I₀, E.X, E.f, ?_, ?_⟩
    · simpa [PreZeroHypercover.sieve₀] using hE
    · intro i
      let eval := (evaluation Dᵒᵖ (Ab.{b})).obj (op (E.X i))
      have eEval : H ⋙ eval ≅
          ((sheafSections J (Ab.{b})).obj (op (u.obj (E.X i)))).rightDerived p :=
        Stacks.Cohomology.ModuleComparison.rightDerivedCompIso Q eval
            (Q ⋙ eval) (Iso.refl _) p ≪≫
          Stacks.Cohomology.CompositeRightDerived.rightDerivedNatIso (Iso.refl _) p
      have := hLocal i
      have : PreservesColimit F (H ⋙ eval) := preservesColimit_of_natIso F eEval.symm
      exact ⟨isColimitOfPreserves (H ⋙ eval) hc⟩
  have hPres : PreservesColimit F (H ⋙ a) :=
    preservesColimit_of_preserves_colimit_cocone hc
      ((IsColimit.precomposeHomEquiv (Functor.associator F H a) ((H ⋙ a).mapCocone c)).symm
        (presheafToSheaf_mapCocone_isColimit' K (H.mapCocone c) hEnough))
  let : PreservesColimit F (push.rightDerived p) :=
    preservesColimit_of_natIso F derivedIso.symm
  exact ⟨isColimitOfPreserves (push.rightDerived p) hc⟩


/-- Let `u : D ⥤ C` be the continuous functor associated to a morphism of sites and let `F` be
a diagram of abelian sheaves on `C`. If every object of `D` has a cover by objects over which
degree-`p` cohomology commutes with the colimit of `F`, then the degree-`p` higher direct image
commutes with that colimit. -/
@[stacks 0H7B]
public theorem preservesColimit_rightDerived_sheafPushforwardContinuous
    {C : Type a} {D : Type d} [SmallCategory C] [SmallCategory D]
    (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    [HasSheafify J (Ab.{b})] [HasSheafify K (Ab.{b})]
    [EnoughInjectives (Sheaf J (Ab.{b}))]
    (u : D ⥤ C) [u.IsContinuous K J]
    (p : ℕ) {I : Type c} [SmallCategory I]
    (F : I ⥤ Sheaf J (Ab.{b}))
    (h : ∀ V : D, ∃ E : PreZeroHypercover.{d} V, E.sieve₀ ∈ K V ∧
      ∀ i : E.I₀, PreservesColimit F
        (((sheafSections J (Ab.{b})).obj (op (u.obj (E.X i)))).rightDerived p)) :
    PreservesColimit F
      ((u.sheafPushforwardContinuous (Ab.{b}) K J).rightDerived p) :=
  preservesColimit_rightDerived_sheafPushforwardContinuous' J K u p F h

/-- The comparison-morphism form of the local criterion, when colimits of the given shape
exist in the coefficient category. -/
public theorem isIso_colimit_post_rightDerived_sheafPushforwardContinuous
    {C : Type a} {D : Type d} [SmallCategory C] [SmallCategory D]
    (J : GrothendieckTopology C) (K : GrothendieckTopology D)
    [HasSheafify J (Ab.{b})] [HasSheafify K (Ab.{b})]
    [EnoughInjectives (Sheaf J (Ab.{b}))]
    (u : D ⥤ C) [u.IsContinuous K J]
    (p : ℕ) {I : Type c} [SmallCategory I] [HasColimitsOfShape I (Ab.{b})]
    (F : I ⥤ Sheaf J (Ab.{b}))
    (h : ∀ V : D, ∃ E : PreZeroHypercover.{d} V, E.sieve₀ ∈ K V ∧
      ∀ i : E.I₀, IsIso (colimit.post F
        (((sheafSections J (Ab.{b})).obj (op (u.obj (E.X i)))).rightDerived p))) :
    IsIso (colimit.post F
      ((u.sheafPushforwardContinuous (Ab.{b}) K J).rightDerived p)) := by
  have := preservesColimit_rightDerived_sheafPushforwardContinuous J K u p F (by
    intro V
    obtain ⟨E, hE, h⟩ := h V
    refine ⟨E, hE, fun i ↦ ?_⟩
    have := h i
    exact preservesColimit_of_isIso_post _ _)
  infer_instance

end Stacks.Cohomology.HigherDirectImage
