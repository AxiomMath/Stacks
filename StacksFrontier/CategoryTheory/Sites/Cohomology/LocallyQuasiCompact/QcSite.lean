/-!
# The big quasi-compact site of locally quasi-compact Hausdorff spaces

The category `LC` of Hausdorff, locally quasi-compact spaces is big: its objects form a proper
class, and so do its quasi-compact coverings. Stacks 09X2 explains how to replace it by a site
`LC_qc`: choose a bounded full subcategory `LC_α` as in
`Stacks.Topology.BoundedLCSubcategory`, and then choose a *set* `Cov` of quasi-compact covering
families on `LC_α` which contains, up to combinatorial equivalence, a representative of every
quasi-compact covering family.

The chosen data is packaged as `Stacks.Topology.LocallyQuasiCompactQcSite`, and
`Stacks.Topology.exists_locallyQuasiCompactQcSite` shows the package can always be built on a
prescribed bounded subcategory. The set of coverings is realised as a `Pretopology`, obtained
from the `CategoryTheory.PreZeroHypercoverFamily` of quasi-compact families: the three site
axioms for that family are exactly the three parts of Stacks 09X1 (isomorphisms cover,
coverings compose, coverings are stable under base change), and the pullbacks the pretopology
needs come from the fibre products of `LC`, which the bounded subcategory inherits because it is
closed under countable limits.

## Main definitions

* `Stacks.Topology.LocallyQuasiCompactQcSite`: the chosen data defining `LC_qc`.
* `Stacks.Topology.LocallyQuasiCompactQcSite.category`: its underlying bounded subcategory.
* `Stacks.Topology.LocallyQuasiCompactQcSite.IsQcCovering`: being a quasi-compact covering
  family in that category.
* `Stacks.Topology.LocallyQuasiCompactQcSite.grothendieckTopology`: the topology generated by
  the chosen pretopology.

## Main results

* `Stacks.Topology.LocallyQuasiCompactQcSite.isCovering_iff_isQcCovering`: the chosen
  pretopology consists exactly of the quasi-compact families, in any index universe.
* `Stacks.Topology.LocallyQuasiCompactQcSite.exists_coveringRepresentative_family`: every
  quasi-compact family has a combinatorially equivalent chosen representative.
* `Stacks.Topology.exists_locallyQuasiCompactQcSite`: the site exists on any prescribed
  bounded subcategory.

## Implementation notes

The bigness of `LC` and of its class of coverings is expressed by universe polymorphism rather
than by an internal proper-class predicate, so no statement here asserts bigness; what is
formalized is the construction that Stacks 09X2 performs in response to it.

A family of morphisms with fixed target is presented as a
`CategoryTheory.PreZeroHypercover`, and `Cov` is a set of presieves. These two presentations
differ in exactly one way: a presieve forgets repetitions and the indexing, so passing between
them changes the index type. Every statement below is therefore proved from
`Stacks.Topology.qcCovering_of_arrow_reindex`, which transports the quasi-compact covering
condition along a reindexing that preserves the arrows; `isCovering_iff_isQcCovering` is stated
for a family in an arbitrary index universe `t`, while the chosen representatives are families
in the fixed universe `w`, and the two are compared through the canonical family of the
generated presieve.

The pullbacks of the bounded subcategory are those of `LC`, which exist because the inclusion
of `LC` into `TopCat` creates them
(`Stacks.Topology.LocallyQuasiCompactHausdorff.createsLimitsOfShape_walkingCospan`); and the
inclusion of the bounded subcategory preserves them, which is what makes the base-change axiom
a statement about topological fibre products, so that Stacks 09X1 (3) applies.

## References

* [Stacks Project, Tag 09X2](https://stacks.math.columbia.edu/tag/09X2)
* [Stacks Project, Tag 09X1](https://stacks.math.columbia.edu/tag/09X1)
* [Stacks Project, Tag 09X0](https://stacks.math.columbia.edu/tag/09X0)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Cardinal

namespace Stacks.Topology

universe u w t

/-- Quasi-compactness of a subset is transported along an equality of objects of a full
subcategory. -/
private lemma isCompact_cast {P : LocallyQuasiCompactHausdorff.{u} → Prop}
    {A B : ObjectProperty.FullSubcategory P}
    (h : A = B) (K : Set A.obj) (hK : IsCompact K) : IsCompact (h ▸ K) := by
  cases h
  exact hK

/-- Two arrows of a full subcategory that agree up to an equality of their sources have the
same image on corresponding subsets. -/
private lemma image_cast {P : LocallyQuasiCompactHausdorff.{u} → Prop}
    {A B X : ObjectProperty.FullSubcategory P}
    (h : A = B) (f : A ⟶ X) (g : B ⟶ X)
    (hf : f = eqToHom h ≫ g) (K : Set A.obj) :
    (g : B.obj → X.obj) '' (h ▸ K) = (f : A.obj → X.obj) '' K := by
  cases h
  simpa using congrArg (fun q : A ⟶ X => (q : A.obj → X.obj) '' K) hf.symm

/-- Quasi-compactness of a family transports along a reindexing `β`, provided each source of the
old family can be sent to a source of the new one by a compact-preserving operation `T` on
subsets that preserves the images in the base. -/
private lemma isQcCovering_of_image_reindex
    {I J : Type*} {A : I → Type*} {B : J → Type*} {Y : Type*}
    [∀ i, TopologicalSpace (A i)] [∀ j, TopologicalSpace (B j)] [TopologicalSpace Y]
    (f : ∀ i, A i → Y) (g : ∀ j, B j → Y) (β : I → J) (T : ∀ i, Set (A i) → Set (B (β i)))
    (hT : ∀ i K, IsCompact K → IsCompact (T i K))
    (himage : ∀ i K, g (β i) '' T i K = f i '' K)
    (hE : _root_.IsQcCovering f) : _root_.IsQcCovering g := by
  classical
  intro y
  obtain ⟨s, K, hK, hnhds⟩ := hE y
  refine ⟨s.image β, fun j => ⋃ i ∈ s, ⋃ h : β i = j, h ▸ T i (K i), ?_, ?_⟩
  · intro j _
    refine Finset.isCompact_biUnion s fun i hi => isCompact_iUnion fun h => ?_
    cases h
    exact hT i _ (hK i hi)
  · refine Filter.mem_of_superset hnhds fun z hz => ?_
    simp only [Set.mem_iUnion] at hz ⊢
    obtain ⟨i, hi, hzi⟩ := hz
    rw [← himage i] at hzi
    obtain ⟨x, hx, rfl⟩ := hzi
    refine ⟨β i, Finset.mem_image.mpr ⟨i, hi, rfl⟩, x, ?_, rfl⟩
    simp only [Set.mem_iUnion]
    exact ⟨i, hi, rfl, hx⟩

/-- A quasi-compact covering stays one after reindexing, as long as every arrow of the new
family also occurs in the old one. Given a quasi-compact family `F` and a map `β` exhibiting
each arrow of `F` as an arrow of `E`, the family `E` is quasi-compact as well: the compact
subsets witnessing `F` are pushed forward along `β` and collected index by index. -/
lemma qcCovering_of_arrow_reindex
    {P : LocallyQuasiCompactHausdorff.{u} → Prop}
    {X : ObjectProperty.FullSubcategory P}
    (E : PreZeroHypercover.{t} X) (F : PreZeroHypercover.{w} X)
    (β : F.I₀ → E.I₀) (hX : ∀ j, F.X j = E.X (β j))
    (hf : ∀ j, F.f j = eqToHom (hX j) ≫ E.f (β j))
    (hF : _root_.IsQcCovering (fun j => (F.f j : (F.X j).obj → X.obj))) :
    _root_.IsQcCovering (fun i => (E.f i : (E.X i).obj → X.obj)) := by
  exact isQcCovering_of_image_reindex _ _ β (fun j K => hX j ▸ K)
    (fun j _ hK => isCompact_cast (hX j) _ hK)
    (fun j K => image_cast (hX j) (F.f j) (E.f (β j)) (hf j) K) hF

/-- Two families generating the same presieve consist of the same arrows, so one is a
quasi-compact covering as soon as the other is. -/
lemma qcCovering_of_presieve_eq
    {P : LocallyQuasiCompactHausdorff.{u} → Prop}
    {X : ObjectProperty.FullSubcategory P}
    {E F : PreZeroHypercover.{w} X} (h : E.presieve₀ = F.presieve₀)
    (hE : _root_.IsQcCovering (fun i => (E.f i : (E.X i).obj → X.obj))) :
    _root_.IsQcCovering (fun i => (F.f i : (F.X i).obj → X.obj)) := by
  choose β hEq hf using fun i : E.I₀ =>
    Presieve.ofArrows_surj F.f (E.f i) (by
      show F.presieve₀ (E.f i)
      rw [← h]
      exact E.presieve₀_f i)
  exact qcCovering_of_arrow_reindex F E β (fun i => (hEq i).symm) hf hE

/-- A family and the canonical family of the presieve it generates have exactly the same
arrows, up to repeated indices, so they are combinatorially equivalent. -/
lemma combinatoriallyEquivalent_canonical
    {P : LocallyQuasiCompactHausdorff.{u} → Prop}
    {X : ObjectProperty.FullSubcategory P} (E : PreZeroHypercover.{t} X) :
    E.CombinatoriallyEquivalent E.presieve₀.preZeroHypercover := by
  let α (i : E.I₀) : E.presieve₀.preZeroHypercover.I₀ :=
    ⟨⟨E.X i, E.f i⟩, E.presieve₀_f i⟩
  let β (j : E.presieve₀.preZeroHypercover.I₀) : E.I₀ :=
    (Presieve.ofArrows_surj E.f j.1.2 j.2).choose
  refine ⟨⟨α, fun _ => rfl, ?_⟩,
    ⟨β, fun j => (Presieve.ofArrows_surj E.f j.1.2 j.2).choose_spec.1.symm,
      fun j => (Presieve.ofArrows_surj E.f j.1.2 j.2).choose_spec.2⟩⟩
  intro i
  show E.f i = eqToHom rfl ≫ E.f i
  simp

/-- Quasi-compactness of a family of maps is transported along homeomorphisms of the sources
that commute with the maps, together with a reindexing of the sources. -/
lemma qcCovering_of_homeomorphic_reindex
    {I J : Type*} {A : I → Type*} {B : J → Type*} {Y : Type*}
    [∀ i, TopologicalSpace (A i)] [∀ j, TopologicalSpace (B j)] [TopologicalSpace Y]
    (f : ∀ i, A i → Y) (g : ∀ j, B j → Y) (β : I → J)
    (e : ∀ i, A i ≃ₜ B (β i))
    (hmap : ∀ i x, g (β i) (e i x) = f i x)
    (hE : _root_.IsQcCovering f) : _root_.IsQcCovering g := by
  exact isQcCovering_of_image_reindex f g β (fun i K => e i '' K)
    (fun i _ hK => hK.image (e i).continuous)
    (fun i K => by rw [Set.image_image]; simp only [hmap]) hE

/-- **Stacks 09X2, the site clause.** The data defining the big quasi-compact site `LC_qc`.

Its objects form the cardinal-cutoff bounded subcategory supplied by
`Stacks.Topology.BoundedLCSubcategory`, with an additional representative condition for the
prescribed cardinal bound. Its chosen pretopology is represented by quasi-compact covering
families indexed in `Type w`, and every quasi-compact presieve has a combinatorially
equivalent chosen representative. -/
@[stacks 09X2 "the site LC_qc"]
structure LocallyQuasiCompactQcSite
    (initialObjects : Set LocallyQuasiCompactHausdorff.{u})
    (bound : Cardinal.{u} → Cardinal.{u}) where
  /-- The chosen bounded subcategory `LC_α`, including all of its containment, closure,
  smallness and bounded-representative properties. -/
  boundedSubcategory : BoundedLCSubcategory initialObjects
  /-- Every space below the prescribed cardinal bound has a representative in the chosen
  bounded subcategory. -/
  bound_representative :
    ∀ {X Y : LocallyQuasiCompactHausdorff.{u}},
      lcSize X < boundedSubcategory.cutoff → lcSize Y ≤ bound (lcSize X) →
        ∃ Z : LCSizeCutoff boundedSubcategory.cutoff, Nonempty (Y ≅ Z.1)
  /-- The chosen subcategory has the pullbacks needed by a pretopology. -/
  [hasPullbacks : HasPullbacks (LCSizeCutoff boundedSubcategory.cutoff)]
  /-- The selected set `Cov`, with the site axioms. -/
  pretopology : Pretopology (LCSizeCutoff boundedSubcategory.cutoff)
  /-- Every presieve selected by the pretopology is a quasi-compact covering when presented by
  its canonical family of arrows. -/
  covering_is_qc : ∀ {X : LCSizeCutoff boundedSubcategory.cutoff}
    (R : Presieve X), R ∈ pretopology X →
      IsQcCovering (fun i =>
        ((R.preZeroHypercover.f i : (R.preZeroHypercover.X i).obj → X.obj)))
  /-- Every quasi-compact presieve has a combinatorially equivalent selected representative
  for its canonical family of arrows. -/
  exists_coveringRepresentative :
    ∀ {X : LCSizeCutoff boundedSubcategory.cutoff}
      (R : Presieve X),
      IsQcCovering (fun i =>
        ((R.preZeroHypercover.f i : (R.preZeroHypercover.X i).obj → X.obj))) →
        ∃ F : PreZeroHypercover.{w} X,
          F.presieve₀ ∈ pretopology X ∧
            R.preZeroHypercover.CombinatoriallyEquivalent F

namespace LocallyQuasiCompactQcSite

variable {S₀ : Set LocallyQuasiCompactHausdorff.{u}}
  {Bound : Cardinal.{u} → Cardinal.{u}}

/-- The cardinal cutoff representing the chosen limit rank `α`. -/
abbrev cutoff (S : LocallyQuasiCompactQcSite.{u, w} S₀ Bound) : Cardinal.{u} :=
  S.boundedSubcategory.cutoff

/-- The underlying category of `LC_qc`. -/
abbrev category (S : LocallyQuasiCompactQcSite.{u, w} S₀ Bound) : Type (u + 1) :=
  LCSizeCutoff S.cutoff

/-- The stored pullbacks on the underlying category are available to typeclass inference. -/
instance (S : LocallyQuasiCompactQcSite.{u, w} S₀ Bound) : HasPullbacks S.category :=
  S.hasPullbacks

/-- The underlying category is essentially small already in the universe `u` of the spaces, this
being the stored smallness of the chosen bounded subcategory. Its objects live in `Type (u + 1)`
and its morphisms in `Type u`, so it is not itself a `CategoryTheory.SmallCategory`; what this
instance buys is that `CategoryTheory.SmallModel S.category` is a category in `Type u` with a
`SmallCategory` structure, and that `S.category` is equivalent to it by
`CategoryTheory.equivSmallModel`. -/
instance category_essentiallySmall (S : LocallyQuasiCompactQcSite.{u, w} S₀ Bound) :
    EssentiallySmall.{u} S.category :=
  S.boundedSubcategory.category_essentiallySmall

/-- The canonical inclusion of the underlying bounded subcategory into `LC`. -/
abbrev inclusion (S : LocallyQuasiCompactQcSite.{u, w} S₀ Bound) :
    S.category ⥤ LocallyQuasiCompactHausdorff.{u} :=
  ObjectProperty.ι _

/-- Membership in the chosen bounded subcategory. -/
abbrev Contains (S : LocallyQuasiCompactQcSite.{u, w} S₀ Bound)
    (X : LocallyQuasiCompactHausdorff.{u}) : Prop :=
  lcSize X < S.cutoff

/-- The given family of arrows is quasi-compactly covering, independently of its index
universe. -/
abbrev IsQcCovering (S : LocallyQuasiCompactQcSite.{u, w} S₀ Bound)
    {X : S.category} (E : PreZeroHypercover.{t} X) : Prop :=
  _root_.IsQcCovering (fun i => (E.f i : (E.X i).obj → X.obj))

/-- A family belongs to the selected pretopology of `LC_qc`. -/
abbrev IsCovering (S : LocallyQuasiCompactQcSite.{u, w} S₀ Bound)
    {X : S.category} (E : PreZeroHypercover.{t} X) : Prop :=
  E.presieve₀ ∈ S.pretopology X

/-- The selected pretopology consists exactly of the quasi-compact covering families. The
reverse implication uses the chosen small representative, whose presieve agrees with that of
the original family. -/
theorem isCovering_iff_isQcCovering (S : LocallyQuasiCompactQcSite.{u, w} S₀ Bound)
    {X : S.category} (E : PreZeroHypercover.{t} X) :
    S.IsCovering E ↔ S.IsQcCovering E := by
  refine ⟨fun hE => ?_, fun hE => ?_⟩
  · obtain ⟨β, hX, hf⟩ := (combinatoriallyEquivalent_canonical E).2
    exact qcCovering_of_arrow_reindex E E.presieve₀.preZeroHypercover β hX hf
      (S.covering_is_qc E.presieve₀ hE)
  · obtain ⟨α, hX, hf⟩ := (combinatoriallyEquivalent_canonical E).1
    obtain ⟨F, hF, hEF⟩ := S.exists_coveringRepresentative E.presieve₀
      (qcCovering_of_arrow_reindex E.presieve₀.preZeroHypercover E α hX hf hE)
    show E.presieve₀ ∈ S.pretopology X
    rw [← Presieve.presieve₀_preZeroHypercover E.presieve₀,
      PreZeroHypercover.presieve₀_eq_of_combinatoriallyEquivalent hEF]
    exact hF

/-- Every quasi-compact family, with any index universe, has a selected combinatorially
equivalent representative. -/
theorem exists_coveringRepresentative_family
    (S : LocallyQuasiCompactQcSite.{u, w} S₀ Bound)
    {X : S.category} (E : PreZeroHypercover.{t} X)
    (hE : S.IsQcCovering E) :
    ∃ F : PreZeroHypercover.{w} X,
      F.presieve₀ ∈ S.pretopology X ∧ E.CombinatoriallyEquivalent F := by
  obtain ⟨⟨α, hX, hf⟩, hback⟩ := combinatoriallyEquivalent_canonical E
  obtain ⟨F, hF, hEF⟩ := S.exists_coveringRepresentative E.presieve₀
    (qcCovering_of_arrow_reindex E.presieve₀.preZeroHypercover E α hX hf hE)
  exact ⟨F, hF, PreZeroHypercover.combinatoriallyEquivalent_trans E
    E.presieve₀.preZeroHypercover F ⟨⟨α, hX, hf⟩, hback⟩ hEF⟩

/-- The Grothendieck topology generated by the quasi-compact pretopology. -/
abbrev grothendieckTopology (S : LocallyQuasiCompactQcSite.{u, w} S₀ Bound) :
    GrothendieckTopology S.category :=
  S.pretopology.toGrothendieck

end LocallyQuasiCompactQcSite

/-- Quasi-compact coverings compose, in the form the site axioms need: if `E` is a
quasi-compact covering of `X` and each `F i` is a quasi-compact covering of `E.X i`, then the
family `E.bind F` of composites is a quasi-compact covering of `X`. This is Stacks 09X1 (2),
transported from families of maps to pre-`0`-hypercovers. -/
lemma isQcCovering_bind {P : LocallyQuasiCompactHausdorff.{u} → Prop}
    {X : ObjectProperty.FullSubcategory P}
    (E : PreZeroHypercover.{w} X) (F : ∀ i, PreZeroHypercover.{w} (E.X i))
    (hE : _root_.IsQcCovering (fun i => (E.f i : (E.X i).obj → X.obj)))
    (hF : ∀ i, _root_.IsQcCovering
      (fun j => ((F i).f j : ((F i).X j).obj → (E.X i).obj))) :
    _root_.IsQcCovering (fun ij => ((E.bind F).f ij : ((E.bind F).X ij).obj → X.obj)) :=
  isQcCovering_comp _ (fun i => (ConcreteCategory.hom (E.f i)).continuous) _ hE hF

/-- **Stacks 09X1 (1)** inside a full subcategory of `LC`: an isomorphism is a homeomorphism,
so the constant family it spans is a quasi-compact covering. -/
lemma isQcCovering_const_of_isIso {Q : LocallyQuasiCompactHausdorff.{u} → Prop}
    {X Y : ObjectProperty.FullSubcategory Q} (f : X ⟶ Y) [IsIso f]
    {I : Type t} [Inhabited I] :
    _root_.IsQcCovering (fun _ : I => (f : X.obj → Y.obj)) := by
  let U : ObjectProperty.FullSubcategory Q ⥤ TopCat.{u} :=
    ObjectProperty.ι _ ⋙ locallyQuasiCompactHausdorffToTop
  let _ : T2Space (U.obj X) := inferInstanceAs (T2Space X.obj)
  let _ : T2Space (U.obj Y) := inferInstanceAs (T2Space Y.obj)
  let _ : WeaklyLocallyCompactSpace (U.obj X) :=
    inferInstanceAs (WeaklyLocallyCompactSpace X.obj)
  let _ : WeaklyLocallyCompactSpace (U.obj Y) :=
    inferInstanceAs (WeaklyLocallyCompactSpace Y.obj)
  let e : U.obj X ≅ U.obj Y := asIso (U.map f)
  have hE : _root_.IsQcCovering (fun _ : Unit => (f : X.obj → Y.obj)) :=
    isQcCovering_of_homeomorph (TopCat.homeoOfIso e)
  exact qcCovering_of_homeomorphic_reindex
    (fun _ => (f : X.obj → Y.obj)) (fun _ => (f : X.obj → Y.obj))
    (fun _ => default) (fun _ => Homeomorph.refl X.obj) (fun _ _ => rfl) hE

/-- Being a quasi-compact covering depends only on the isomorphism class of a family: an
isomorphism of pre-`0`-hypercovers identifies their sources by homeomorphisms commuting with
the arrows to the base. -/
lemma qcCovering_of_iso {Q : LocallyQuasiCompactHausdorff.{u} → Prop}
    {X : ObjectProperty.FullSubcategory Q} {E F : PreZeroHypercover.{t} X} (e : E ≅ F)
    (hE : _root_.IsQcCovering (fun i => (E.f i : (E.X i).obj → X.obj))) :
    _root_.IsQcCovering (fun i => (F.f i : (F.X i).obj → X.obj)) := by
  let U : ObjectProperty.FullSubcategory Q ⥤ TopCat.{u} :=
    ObjectProperty.ι _ ⋙ locallyQuasiCompactHausdorffToTop
  let β := e.hom.s₀
  let homeo (i : E.I₀) : U.obj (E.X i) ≃ₜ U.obj (F.X (β i)) :=
    TopCat.homeoOfIso (asIso (U.map (e.hom.h₀ i)))
  have hm (i) (x) :
      (F.f (β i) : (F.X (β i)).obj → X.obj) (homeo i x) =
        (E.f i : (E.X i).obj → X.obj) x :=
    ConcreteCategory.congr_hom
      (show U.map (e.hom.h₀ i) ≫ U.map (F.f (β i)) = U.map (E.f i) by
        rw [← U.map_comp, e.hom.w₀]) x
  exact qcCovering_of_homeomorphic_reindex
    (fun i => (E.f i : (E.X i).obj → X.obj))
    (fun i => (F.f i : (F.X i).obj → X.obj)) β homeo hm hE

/-- **Stacks 09X1 (3)** inside a full subcategory of `LC`: the base change of a quasi-compact
covering along an arrow is a quasi-compact covering, the categorical pullbacks being carried to
topological fibre products by the inclusion into `TopCat`. -/
lemma isQcCovering_pullback₁ {Q : LocallyQuasiCompactHausdorff.{u} → Prop}
    [HasPullbacks (ObjectProperty.FullSubcategory Q)]
    [PreservesLimitsOfShape WalkingCospan
      (ObjectProperty.ι Q ⋙ locallyQuasiCompactHausdorffToTop)]
    {X Y : ObjectProperty.FullSubcategory Q} (f : X ⟶ Y) (E : PreZeroHypercover.{t} Y)
    (hQc : _root_.IsQcCovering (fun i => (E.f i : (E.X i).obj → Y.obj))) :
    _root_.IsQcCovering
      (fun i => ((E.pullback₁ f).f i : ((E.pullback₁ f).X i).obj → X.obj)) := by
  let U : ObjectProperty.FullSubcategory Q ⥤ TopCat.{u} :=
    ObjectProperty.ι _ ⋙ locallyQuasiCompactHausdorffToTop
  let fTop := U.map f
  let gTop (i : E.I₀) := U.map (E.f i)
  let fFun : X.obj → Y.obj := fTop.hom
  let gFun (i : E.I₀) : (E.X i).obj → Y.obj := (gTop i).hom
  let _ : T2Space (U.obj Y) := inferInstanceAs (T2Space Y.obj)
  let _ : WeaklyLocallyCompactSpace (U.obj Y) :=
    inferInstanceAs (WeaklyLocallyCompactSpace Y.obj)
  let _ : T2Space (U.obj X) := inferInstanceAs (T2Space X.obj)
  let _ : WeaklyLocallyCompactSpace (U.obj X) :=
    inferInstanceAs (WeaklyLocallyCompactSpace X.obj)
  let E' := E.pullback₁ f
  let hIsoPullback (i : E.I₀) : U.obj (pullback f (E.f i)) ≅ pullback fTop (gTop i) :=
    PreservesPullback.iso U f (E.f i)
  let e (i : E.I₀) : FiberProd fFun (gFun i) ≃ₜ U.obj (pullback f (E.f i)) :=
    (TopCat.homeoOfIso
      (hIsoPullback i ≪≫ TopCat.pullbackIsoProdSubtype fTop (gTop i))).symm
  have hm (i) (x) :
      (E'.f i : (E'.X i).obj → X.obj) (e i x) = FiberProd.prX' fFun (gFun i) x := by
    show (U.map (pullback.fst f (E.f i))).hom (e i x) = _
    have hproj :
        (hIsoPullback i ≪≫ TopCat.pullbackIsoProdSubtype fTop (gTop i)).hom ≫
          TopCat.pullbackFst fTop (gTop i) = U.map (pullback.fst f (E.f i)) := by
      simp only [Iso.trans_hom, Category.assoc, TopCat.pullbackIsoProdSubtype_hom_fst]
      exact PreservesPullback.iso_hom_fst U f (E.f i)
    rw [← ConcreteCategory.congr_hom hproj (e i x)]
    show ((e i).symm (e i x)).val.1 = x.val.1
    rw [Homeomorph.symm_apply_apply]
  exact qcCovering_of_homeomorphic_reindex
    (fun i => FiberProd.prX' fFun (gFun i))
    (fun i => (E'.f i : (E'.X i).obj → X.obj))
    (fun i => i) e hm
    (isQcCovering_base_change gFun (fun i => (gTop i).hom.continuous)
      fFun fTop.hom.continuous hQc)

/-- **Stacks 09X2, the covering-set clause.** On any prescribed bounded subcategory `LC_α` of
`LC` there is a set of quasi-compact covering families which forms a pretopology and contains a
combinatorially equivalent representative of every quasi-compact covering family; that is, the
quasi-compact site `LC_qc` exists on `LC_α`.

The set of coverings is the one generated by *all* quasi-compact families: the three site
axioms are Stacks 09X1, and the representative condition is satisfied by the family itself,
which is legitimate because the families on `LC_α` indexed in `Type (u + 1)` already form a
set. -/
@[stacks 09X2 "the set of coverings"]
theorem exists_locallyQuasiCompactQcSite
    (S₀ : Set LocallyQuasiCompactHausdorff.{u})
    (B : BoundedLCSubcategory S₀) :
    ∃ S : LocallyQuasiCompactQcSite.{u, u + 1} S₀ Cardinal.stacksBound,
      S.boundedSubcategory = B := by
  classical
  let C := LCSizeCutoff B.cutoff
  let P : PreZeroHypercoverFamily C :=
    { property := fun {X} E =>
        _root_.IsQcCovering (fun i => (E.f i : (E.X i).obj → X.obj))
      iff_shrink := by
        intro X E
        exact ⟨fun hE => qcCovering_of_presieve_eq (h := E.presieve₀_shrink.symm) hE,
          fun hE => qcCovering_of_presieve_eq (h := E.presieve₀_shrink) hE⟩ }
  let J := P.precoverage
  let _ : Precoverage.HasIsos J :=
    Precoverage.HasIsos.of_preZeroHypercoverFamily (by
      intro _ _ f _
      exact isQcCovering_const_of_isIso f)
  let _ : Precoverage.IsStableUnderComposition J :=
    Precoverage.IsStableUnderComposition.of_preZeroHypercoverFamily
      fun E F hE hF => isQcCovering_bind E F hE hF
  let _ : ObjectProperty.IsClosedUnderLimitsOfShape
      (fun X : LocallyQuasiCompactHausdorff.{u} => lcSize X < B.cutoff)
      (ULiftHom.{u} (ULift.{u} WalkingCospan)) :=
    B.closedUnderCountableLimits (ULiftHom.{u} (ULift.{u} WalkingCospan))
  let _ : ObjectProperty.IsClosedUnderLimitsOfShape
      (fun X : LocallyQuasiCompactHausdorff.{u} => lcSize X < B.cutoff) WalkingCospan :=
    ObjectProperty.IsClosedUnderLimitsOfShape.of_equivalence
      (CategoryTheory.ULiftHomULiftCategory.equiv (C := WalkingCospan)).symm
  let _ : HasLimitsOfShape WalkingCospan C := inferInstance
  let _ : HasPullbacks C := inferInstance
  let _ : PreservesLimitsOfShape WalkingCospan
      (ObjectProperty.ι (fun X : LocallyQuasiCompactHausdorff.{u} => lcSize X < B.cutoff)) :=
    inferInstance
  let _ : J.IsStableUnderBaseChange :=
    Precoverage.IsStableUnderBaseChange.of_preZeroHypercoverFamily_of_isClosedUnderIsomorphisms
      ⟨fun e hE => qcCovering_of_iso e hE⟩
      fun f E _ hQc => isQcCovering_pullback₁ f E hQc
  refine ⟨{ boundedSubcategory := B
            bound_representative := ?_
            hasPullbacks := inferInstance
            pretopology := J.toPretopology
            covering_is_qc := ?_
            exists_coveringRepresentative := ?_ }, rfl⟩
  · intro X Y hX hY
    exact B.bounded_representative hX hY
  · intro X R hR
    change R ∈ J X at hR
    rw [PreZeroHypercoverFamily.mem_precoverage_iff] at hR
    obtain ⟨E, hE, heq⟩ := hR
    exact qcCovering_of_presieve_eq
      (h := heq.symm.trans (Presieve.presieve₀_preZeroHypercover R).symm) hE
  · intro X R hR
    refine ⟨R.preZeroHypercover, ?_, PreZeroHypercover.combinatoriallyEquivalent_refl _⟩
    show R.preZeroHypercover.presieve₀ ∈ P.precoverage X
    exact PreZeroHypercover.presieve₀_mem_precoverage_iff.mpr hR

end Stacks.Topology

end
