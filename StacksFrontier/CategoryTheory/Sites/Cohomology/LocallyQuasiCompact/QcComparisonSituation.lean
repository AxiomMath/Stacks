/-!
# The quasi-compact site of locally quasi-compact spaces as a comparison situation

Stacks 0EZI asserts that the pair of topologies on `LC` — the quasi-compact topology and the
coarser Zariski topology — together with the proper maps as distinguished class and, over each
object `X`, the sheaves `π_X^{-1}F` pulled back from the space `X` as weak Serre class, satisfies
the five conditions of Situation 0EZ3. All five are proved in this directory. This file
assembles them into an actual instance `comparisonSituation` of
`Stacks.ComparingTopologies.CohomologyComparison`, so that every result proved for Situation
0EZ3 applies to `LC`, and reads the vanishing conditions `(V_n)` of that instance back on the
site: `isZero_rightDerived_qcAbelianDirectImage_of_vanishingCondition`.

## Main definitions

* `Stacks.Topology.LocallyQuasiCompactZariskiSituation.smallSite`: the underlying category of
  the site, made small in the coefficient universe by `AsSmall`.
* `Stacks.Topology.LocallyQuasiCompactZariskiSituation.smallQcSheafEquiv`,
  `smallZariskiSheafEquiv`: abelian sheaves on the localized sites of `smallSite` are abelian
  sheaves on the localized sites of the site.
* `Stacks.Topology.LocallyQuasiCompactZariskiSituation.comparisonSituation`: Situation 0EZ3 for
  `LC_qc` and `LC_Zar`.

## Main results

* `Stacks.Topology.LocallyQuasiCompactZariskiSituation`'s
  `isZero_rightDerived_qcAbelianDirectImage_qcAbelianInverseImage`: `R^i ε_{X,*}(ε_X^{-1}G) = 0`
  for `i > 0` and `G` pulled back from the space, by Stacks 0EZF for `comparisonSituation`;
  `isZero_rightDerived_qcAbelianDirectImage_of_vanishingCondition`: the same from the vanishing
  conditions `(V_n)` of `comparisonSituation`.
* `CategoryTheory.Functor.rightDerivedObjIsoOfEquivalence`: right derived functors are
  transported along equivalences of abelian categories.

## Implementation notes

Situation 0EZ3 is stated for a small category with coefficients in the universe of that
category. The site has objects in `Type (u + 1)` and morphisms in `Type u`, and its abelian
sheaves are taken with coefficients `AddCommGrpCat.{max (u + 1) v}`, so the carrier is
`AsSmall.{max (u + 1) v}` of the site, a small category in exactly the coefficient universe.
Its two topologies are induced along `AsSmall.down`, and its covering families are the covering
presieves of those topologies. The functors `AsSmall.up` and `AsSmall.down` are mutually inverse
on the nose, so restriction and change of topology commute with the transport of sheaves along
them up to identities; direct images along an arrow commute up to the isomorphism given by
uniqueness of right adjoints.

## References

* [Stacks Project, Tag 0EZ3](https://stacks.math.columbia.edu/tag/0EZ3)
* [Stacks Project, Tag 0EZI](https://stacks.math.columbia.edu/tag/0EZI)
* [Stacks Project, Tag 0EZF](https://stacks.math.columbia.edu/tag/0EZF)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace CategoryTheory.GrothendieckTopology

variable {C : Type*} [Category* C]

/-- A Grothendieck topology is the topology generated by its own covering presieves. -/
theorem toPrecoverage_toGrothendieck (J : GrothendieckTopology C) :
    J.toPrecoverage.toGrothendieck = J := by
  refine le_antisymm J.toGrothendieck_toPrecoverage_le fun X S hS => ?_
  simpa using Precoverage.generate_mem_toGrothendieck ((J.arrows_mem_toPrecoverage_iff S).2 hS)

end CategoryTheory.GrothendieckTopology

namespace CategoryTheory.AsSmall

variable {C : Type*} [Category* C]

/-- `AsSmall.down` is an equivalence, being the inverse of `AsSmall.equiv`. -/
instance isEquivalence_down : (AsSmall.down : AsSmall C ⥤ C).IsEquivalence :=
  (AsSmall.equiv (C := C)).isEquivalence_inverse

/-- `AsSmall.up` is an equivalence, being the functor of `AsSmall.equiv`. -/
instance isEquivalence_up : (AsSmall.up : C ⥤ AsSmall C).IsEquivalence :=
  (AsSmall.equiv (C := C)).isEquivalence_functor

end CategoryTheory.AsSmall

namespace CategoryTheory.Functor

variable {A A' B B' : Type*} [Category* A] [Category* A'] [Category* B] [Category* B']
  [Abelian A] [Abelian A'] [Abelian B] [Abelian B'] [HasInjectiveResolutions A]
  [EnoughInjectives A']

/-- **Right derived functors are transported along equivalences.** If `F' ∘ e_A ≅ e_B ∘ F` for
equivalences `e_A`, `e_B` of abelian categories and `F'` is left exact, then
`e_B(R^nF(X)) ≅ R^nF'(e_A X)`. -/
def rightDerivedObjIsoOfEquivalence (eA : A ≌ A') (eB : B ≌ B') (F : A ⥤ B) (F' : A' ⥤ B')
    [F.Additive] [F'.Additive] [PreservesFiniteLimits F'] [eA.functor.Additive]
    [eB.functor.Additive] (iso : F ⋙ eB.functor ≅ eA.functor ⋙ F') (X : A) (n : ℕ) :
    eB.functor.obj ((F.rightDerived n).obj X) ≅ (F'.rightDerived n).obj (eA.functor.obj X) :=
  ((Functor.rightDerivedCompIso F eB.functor n).app X).symm ≪≫
    (Functor.rightDerivedIsoOfNatIso iso n).app X ≪≫
      Stacks.RightDerivedComp.objIsoOfAcyclicImage eA.functor F'
        (fun m hm => Stacks.Cohomology.isZero_rightDerived_obj_of_preservesHomology _ X m hm)
        (fun Z _ => Stacks.RightDerivedComp.acyclic_of_injective F' (eA.functor.obj Z)) n

/-- Vanishing of a right derived functor is transported along equivalences. -/
theorem isZero_rightDerived_obj_iff_of_equivalence (eA : A ≌ A') (eB : B ≌ B') (F : A ⥤ B)
    (F' : A' ⥤ B') [F.Additive] [F'.Additive] [PreservesFiniteLimits F'] [eA.functor.Additive]
    [eB.functor.Additive] (iso : F ⋙ eB.functor ≅ eA.functor ⋙ F') (X : A) (n : ℕ) :
    IsZero ((F.rightDerived n).obj X) ↔ IsZero ((F'.rightDerived n).obj (eA.functor.obj X)) := by
  rw [← (rightDerivedObjIsoOfEquivalence eA eB F F' iso X n).isZero_iff]
  exact ⟨fun h => eB.functor.map_isZero h, fun h => h.of_full_of_faithful_of_isZero _⟩

end CategoryTheory.Functor

namespace Stacks.Topology.LocallyQuasiCompactZariskiSituation

universe u w v

variable {S₀ : Set LocallyQuasiCompactHausdorff.{u}} {Bound : Cardinal.{u} → Cardinal.{u}}
  (S : LocallyQuasiCompactZariskiSituation.{u, w} S₀ Bound)

/-- The underlying category of the site, made small in the coefficient universe
`max (u + 1) v`: its objects live in `Type (u + 1)` and its morphisms in `Type u`, and
`AsSmall` lifts both to `Type (max (u + 1) v)`. -/
abbrev smallSite : Type (max (u + 1) v) :=
  AsSmall.{max (u + 1) v} S.category

/-- The quasi-compact coverings of `smallSite`: the covering presieves of the topology induced
along the equivalence with the site. -/
def smallQcPrecoverage : Precoverage (smallSite.{u, w, v} S) :=
  (AsSmall.down.inducedTopology S.qcSite.grothendieckTopology).toPrecoverage

/-- The Zariski coverings of `smallSite`: the covering presieves of the topology induced along
the equivalence with the site. -/
def smallZariskiPrecoverage : Precoverage (smallSite.{u, w, v} S) :=
  (AsSmall.down.inducedTopology S.zariskiTopology).toPrecoverage

/-- The quasi-compact topology on `smallSite`. -/
abbrev smallQcTopology : GrothendieckTopology (smallSite.{u, w, v} S) :=
  (smallQcPrecoverage.{u, w, v} S).toGrothendieck

/-- The Zariski topology on `smallSite`. -/
abbrev smallZariskiTopology : GrothendieckTopology (smallSite.{u, w, v} S) :=
  (smallZariskiPrecoverage.{u, w, v} S).toGrothendieck

/-- The quasi-compact topology on `smallSite` is the topology induced along `AsSmall.down`. -/
theorem smallQcTopology_eq :
    smallQcTopology.{u, w, v} S = AsSmall.down.inducedTopology S.qcSite.grothendieckTopology :=
  GrothendieckTopology.toPrecoverage_toGrothendieck _

/-- The Zariski topology on `smallSite` is the topology induced along `AsSmall.down`. -/
theorem smallZariskiTopology_eq :
    smallZariskiTopology.{u, w, v} S = AsSmall.down.inducedTopology S.zariskiTopology :=
  GrothendieckTopology.toPrecoverage_toGrothendieck _

/-- `AsSmall.down` is cocontinuous for the two quasi-compact topologies. -/
instance : (AsSmall.down : smallSite.{u, w, v} S ⥤ S.category).IsCocontinuous
    (smallQcTopology.{u, w, v} S) S.qcSite.grothendieckTopology := by
  rw [smallQcTopology_eq]
  exact inferInstanceAs ((AsSmall.equiv (C := S.category)).inverse.IsCocontinuous
    ((AsSmall.equiv (C := S.category)).inverse.inducedTopology _) _)

/-- `AsSmall.down` is cocontinuous for the two Zariski topologies. -/
instance : (AsSmall.down : smallSite.{u, w, v} S ⥤ S.category).IsCocontinuous
    (smallZariskiTopology.{u, w, v} S) S.zariskiTopology := by
  rw [smallZariskiTopology_eq]
  exact inferInstanceAs ((AsSmall.equiv (C := S.category)).inverse.IsCocontinuous
    ((AsSmall.equiv (C := S.category)).inverse.inducedTopology _) _)

/-- `AsSmall.up` is cocontinuous for the two quasi-compact topologies. -/
instance : (AsSmall.up : S.category ⥤ smallSite.{u, w, v} S).IsCocontinuous
    S.qcSite.grothendieckTopology (smallQcTopology.{u, w, v} S) := by
  rw [smallQcTopology_eq]
  exact inferInstanceAs ((AsSmall.equiv (C := S.category)).functor.IsCocontinuous _
    ((AsSmall.equiv (C := S.category)).inverse.inducedTopology _))

/-- `AsSmall.up` is cocontinuous for the two Zariski topologies. -/
instance : (AsSmall.up : S.category ⥤ smallSite.{u, w, v} S).IsCocontinuous
    S.zariskiTopology (smallZariskiTopology.{u, w, v} S) := by
  rw [smallZariskiTopology_eq]
  exact inferInstanceAs ((AsSmall.equiv (C := S.category)).functor.IsCocontinuous _
    ((AsSmall.equiv (C := S.category)).inverse.inducedTopology _))

/-- The slice of `smallSite` over `X` is the slice of the site over `X.down`. -/
@[simps]
def smallOverEquiv (X : smallSite.{u, w, v} S) : Over X ≌ Over (AsSmall.down.obj X) where
  functor := Over.post AsSmall.down
  inverse := Over.post (X := AsSmall.down.obj X) AsSmall.up
  unitIso := Iso.refl _
  counitIso := Iso.refl _

/-- The slice equivalence is cocontinuous for the quasi-compact topologies. -/
instance (X : smallSite.{u, w, v} S) : (smallOverEquiv.{u, w, v} S X).functor.IsCocontinuous
    ((smallQcTopology.{u, w, v} S).over X)
    (S.qcSite.grothendieckTopology.over (AsSmall.down.obj X)) :=
  inferInstanceAs ((Over.post (X := X) AsSmall.down).IsCocontinuous _ _)

/-- The inverse slice equivalence is cocontinuous for the quasi-compact topologies. -/
instance (X : smallSite.{u, w, v} S) : (smallOverEquiv.{u, w, v} S X).inverse.IsCocontinuous
    (S.qcSite.grothendieckTopology.over (AsSmall.down.obj X))
    ((smallQcTopology.{u, w, v} S).over X) :=
  inferInstanceAs ((Over.post (X := AsSmall.down.obj X) AsSmall.up).IsCocontinuous _
    ((smallQcTopology.{u, w, v} S).over (AsSmall.up.obj (AsSmall.down.obj X))))

/-- The slice equivalence is cocontinuous for the Zariski topologies. -/
instance (X : smallSite.{u, w, v} S) : (smallOverEquiv.{u, w, v} S X).functor.IsCocontinuous
    ((smallZariskiTopology.{u, w, v} S).over X)
    (S.zariskiTopology.over (AsSmall.down.obj X)) :=
  inferInstanceAs ((Over.post (X := X) AsSmall.down).IsCocontinuous _ _)

/-- The inverse slice equivalence is cocontinuous for the Zariski topologies. -/
instance (X : smallSite.{u, w, v} S) : (smallOverEquiv.{u, w, v} S X).inverse.IsCocontinuous
    (S.zariskiTopology.over (AsSmall.down.obj X))
    ((smallZariskiTopology.{u, w, v} S).over X) :=
  inferInstanceAs ((Over.post (X := AsSmall.down.obj X) AsSmall.up).IsCocontinuous _
    ((smallZariskiTopology.{u, w, v} S).over (AsSmall.up.obj (AsSmall.down.obj X))))

/-- The inverse slice equivalence is a dense subsite for the quasi-compact topologies. -/
instance (X : smallSite.{u, w, v} S) : (smallOverEquiv.{u, w, v} S X).inverse.IsDenseSubsite
    (S.qcSite.grothendieckTopology.over (AsSmall.down.obj X))
    ((smallQcTopology.{u, w, v} S).over X) :=
  Equivalence.isDenseSubsite_inverse_of_isCocontinuous _ _ _

/-- The inverse slice equivalence is a dense subsite for the Zariski topologies. -/
instance (X : smallSite.{u, w, v} S) : (smallOverEquiv.{u, w, v} S X).inverse.IsDenseSubsite
    (S.zariskiTopology.over (AsSmall.down.obj X))
    ((smallZariskiTopology.{u, w, v} S).over X) :=
  Equivalence.isDenseSubsite_inverse_of_isCocontinuous _ _ _

/-- Abelian sheaves on the localized quasi-compact site of `smallSite` over `X` are abelian
sheaves on the localized quasi-compact site over `X.down`. -/
def smallQcSheafEquiv (X : smallSite.{u, w, v} S) :
    Sheaf ((smallQcTopology.{u, w, v} S).over X) AddCommGrpCat.{max (u + 1) v} ≌
      Sheaf (S.qcSite.grothendieckTopology.over (AsSmall.down.obj X))
        AddCommGrpCat.{max (u + 1) v} :=
  (smallOverEquiv.{u, w, v} S X).sheafCongr _ _ _

/-- Abelian sheaves on the localized Zariski site of `smallSite` over `X` are abelian sheaves on
the localized Zariski site over `X.down`. -/
def smallZariskiSheafEquiv (X : smallSite.{u, w, v} S) :
    Sheaf ((smallZariskiTopology.{u, w, v} S).over X) AddCommGrpCat.{max (u + 1) v} ≌
      Sheaf (S.zariskiTopology.over (AsSmall.down.obj X)) AddCommGrpCat.{max (u + 1) v} :=
  (smallOverEquiv.{u, w, v} S X).sheafCongr _ _ _

/-- Every Zariski covering of `smallSite` is a quasi-compact covering. -/
theorem smallZariskiPrecoverage_le_smallQcPrecoverage :
    smallZariskiPrecoverage.{u, w, v} S ≤ smallQcPrecoverage.{u, w, v} S :=
  fun _ _ hR => (Functor.mem_inducedTopology_iff_of_isCoverDense _ _ _).2
    (S.zariskiTopology_le_qc _ ((Functor.mem_inducedTopology_iff_of_isCoverDense _ _ _).1 hR))

/-- The class `A'_X` over an object of `smallSite`: the sheaves `π_X^{-1}G` of
`zariskiPullbackClass`, transported along `smallZariskiSheafEquiv`. -/
def smallZariskiPullbackClass (X : smallSite.{u, w, v} S) :
    ObjectProperty
      (Sheaf ((smallZariskiTopology.{u, w, v} S).over X) AddCommGrpCat.{max (u + 1) v}) :=
  (⊤ : ObjectProperty (Sheaf (Opens.grothendieckTopology (AsSmall.down.obj X).obj)
      AddCommGrpCat.{max (u + 1) v})).map
    (S.abelianComparisonInverseImage.{u, w, max (u + 1) v} (AsSmall.down.obj X) ⋙
      (smallZariskiSheafEquiv.{u, w, v} S X).inverse)

/-- Membership in the class over `X` is membership of the transported sheaf in
`zariskiPullbackClass` over `X.down`. -/
theorem smallZariskiPullbackClass_iff (X : smallSite.{u, w, v} S)
    (F : Sheaf ((smallZariskiTopology.{u, w, v} S).over X) AddCommGrpCat.{max (u + 1) v}) :
    smallZariskiPullbackClass.{u, w, v} S X F ↔
      S.zariskiPullbackClass.{u, w, v} (AsSmall.down.obj X)
        ((smallZariskiSheafEquiv.{u, w, v} S X).functor.obj F) := by
  simp only [smallZariskiPullbackClass, zariskiPullbackClass, ObjectProperty.prop_map_iff]
  exact ⟨fun ⟨G, _, ⟨e⟩⟩ =>
      ⟨G, trivial, ⟨(smallZariskiSheafEquiv.{u, w, v} S X).counitIso.symm.app _ ≪≫
        (smallZariskiSheafEquiv.{u, w, v} S X).functor.mapIso e⟩⟩,
    fun ⟨G, _, ⟨e⟩⟩ =>
      ⟨G, trivial, ⟨(smallZariskiSheafEquiv.{u, w, v} S X).inverse.mapIso e ≪≫
        (smallZariskiSheafEquiv.{u, w, v} S X).unitIso.symm.app _⟩⟩⟩

/-- **The weak Serre condition on `smallSite`**: the class is the essential image of the fully
faithful exact functor `π_X^{-1}` followed by an equivalence, whose right adjoint is exact. -/
theorem smallZariskiPullbackClass_isWeakSerreClass (X : smallSite.{u, w, v} S) :
    (smallZariskiPullbackClass.{u, w, v} S X).IsWeakSerreClass := by
  have _ : IsIso
      (S.abelianComparisonAdjunction.{u, w, max (u + 1) v} (AsSmall.down.obj X)).unit :=
    S.abelianComparisonAdjunction_unit_isIso.{u, w, v} (AsSmall.down.obj X)
  have hff := (S.abelianComparisonAdjunction.{u, w, max (u + 1) v}
    (AsSmall.down.obj X)).fullyFaithfulLOfIsIsoUnit
  have _ : (S.abelianComparisonInverseImage.{u, w, max (u + 1) v} (AsSmall.down.obj X)).Full :=
    hff.full
  have _ :
      (S.abelianComparisonInverseImage.{u, w, max (u + 1) v} (AsSmall.down.obj X)).Faithful :=
    hff.faithful
  have _ : (smallZariskiSheafEquiv.{u, w, v} S X).functor.Additive :=
    Functor.additive_of_preserves_binary_products _
  have _ : (smallZariskiSheafEquiv.{u, w, v} S X).symm.functor.Additive :=
    Functor.additive_of_preserves_binary_products _
  exact ObjectProperty.isWeakSerreClass_map_top
    ((S.abelianComparisonAdjunction.{u, w, max (u + 1) v} (AsSmall.down.obj X)).comp
      (smallZariskiSheafEquiv.{u, w, v} S X).symm.toAdjunction)

/-- `smallSite` has pullbacks, being equivalent to the site. -/
instance : HasPullbacks (smallSite.{u, w, v} S) :=
  Adjunction.hasLimitsOfShape_of_equivalence AsSmall.down

/-- The proper arrows of `smallSite`: those whose underlying arrow of the site is proper. -/
abbrev smallProperMorphisms : MorphismProperty (smallSite.{u, w, v} S) :=
  S.properMorphisms.inverseImage AsSmall.down

/-- **The base-change condition on `smallSite`**, transported from
`exists_isPullback_properMorphisms`. -/
theorem small_exists_isPullback_properMorphisms ⦃X Y Y' : smallSite.{u, w, v} S⦄ (f : X ⟶ Y)
    (hf : smallProperMorphisms.{u, w, v} S f) (g : Y' ⟶ Y) :
    ∃ (Z : smallSite.{u, w, v} S) (q : Z ⟶ X) (p : Z ⟶ Y'),
      IsPullback q p f g ∧ smallProperMorphisms.{u, w, v} S p := by
  obtain ⟨Z, q, p, h, hp⟩ :=
    S.exists_isPullback_properMorphisms (AsSmall.down.map f) hf (AsSmall.down.map g)
  exact ⟨AsSmall.up.obj Z, AsSmall.up.map q, AsSmall.up.map p, h.map AsSmall.up, hp⟩

/-- **The restriction condition on `smallSite`**, transported from
`zariskiPullbackClass_overMapPullback`. -/
theorem smallZariskiPullbackClass_overMapPullback ⦃X Y : smallSite.{u, w, v} S⦄ (f : X ⟶ Y)
    (F : Sheaf ((smallZariskiTopology.{u, w, v} S).over Y) AddCommGrpCat.{max (u + 1) v})
    (hF : smallZariskiPullbackClass.{u, w, v} S Y F) :
    smallZariskiPullbackClass.{u, w, v} S X
      (((smallZariskiTopology.{u, w, v} S).overMapPullback AddCommGrpCat.{max (u + 1) v} f).obj
        F) := by
  rw [smallZariskiPullbackClass_iff] at hF ⊢
  exact S.zariskiPullbackClass_overMapPullback.{u, w, v} (AsSmall.down.map f) _ hF

/-- **The sheaf condition on `smallSite`**: a member of the class satisfies the sheaf condition
for the quasi-compact coverings, transported from `zariskiPullbackClass_isSheaf_qc`. -/
theorem smallZariskiPullbackClass_isSheaf_qc (X : smallSite.{u, w, v} S)
    (F : Sheaf ((smallZariskiTopology.{u, w, v} S).over X) AddCommGrpCat.{max (u + 1) v})
    (hF : smallZariskiPullbackClass.{u, w, v} S X F) :
    Presheaf.IsSheaf ((smallQcTopology.{u, w, v} S).over X) F.obj := by
  rw [smallZariskiPullbackClass_iff] at hF
  have h := (smallOverEquiv.{u, w, v} S X).functor.op_comp_isSheaf
    ((smallQcTopology.{u, w, v} S).over X)
    (S.qcSite.grothendieckTopology.over (AsSmall.down.obj X))
    ⟨_, zariskiPullbackClass_isSheaf_qc.{u, w, v} S _ _ hF⟩
  exact (Presheaf.isSheaf_of_iso_iff
    (Functor.isoWhiskerRight (smallOverEquiv.{u, w, v} S X).op.unitIso F.obj ≪≫
      Functor.associator _ _ _)).2 h

section Pushforward

variable {X Y : smallSite.{u, w, v} S} (f : X ⟶ Y)

/-- Restriction along an arrow of `smallSite`, read on the site: restricting along `f` and then
transporting is transporting and then restricting along `f.down`. -/
def smallOverMapPullbackIso :
    S.zariskiTopology.overMapPullback AddCommGrpCat.{max (u + 1) v} (AsSmall.down.map f) ⋙
        (smallZariskiSheafEquiv.{u, w, v} S X).inverse ≅
      (smallZariskiSheafEquiv.{u, w, v} S Y).inverse ⋙
        (smallZariskiTopology.{u, w, v} S).overMapPullback AddCommGrpCat.{max (u + 1) v} f :=
  Iso.refl _

/-- **Direct image along an arrow of `smallSite`, read on the site**, by uniqueness of right
adjoints: both composites are right adjoint to the two equal composites of
`smallOverMapPullbackIso`. -/
def smallOverMapPushforwardIso :
    (Over.map f).sheafPushforwardCocontinuous AddCommGrpCat.{max (u + 1) v}
        ((smallZariskiTopology.{u, w, v} S).over X) ((smallZariskiTopology.{u, w, v} S).over Y) ⋙
        (smallZariskiSheafEquiv.{u, w, v} S Y).functor ≅
      (smallZariskiSheafEquiv.{u, w, v} S X).functor ⋙
        (Over.map (AsSmall.down.map f)).sheafPushforwardCocontinuous
          AddCommGrpCat.{max (u + 1) v} (S.zariskiTopology.over (AsSmall.down.obj X))
          (S.zariskiTopology.over (AsSmall.down.obj Y)) :=
  Adjunction.rightAdjointUniq
    ((smallZariskiSheafEquiv.{u, w, v} S Y).symm.toAdjunction.comp
      ((Over.map f).sheafAdjunctionCocontinuous AddCommGrpCat.{max (u + 1) v}
        ((smallZariskiTopology.{u, w, v} S).over X) ((smallZariskiTopology.{u, w, v} S).over Y)))
    ((((Over.map (AsSmall.down.map f)).sheafAdjunctionCocontinuous
        AddCommGrpCat.{max (u + 1) v} (S.zariskiTopology.over (AsSmall.down.obj X))
        (S.zariskiTopology.over (AsSmall.down.obj Y))).comp
      (smallZariskiSheafEquiv.{u, w, v} S X).symm.toAdjunction).ofNatIsoLeft
        (smallOverMapPullbackIso.{u, w, v} S f))

attribute [local instance] enoughInjectives_zariskiSliceSheaf

/-- **The higher-direct-image condition on `smallSite`**, transported from
`zariskiPullbackClass_rightDerived_overMapPushforward`. -/
theorem smallZariskiPullbackClass_rightDerived_overMapPushforward
    (hf : smallProperMorphisms.{u, w, v} S f)
    (F : Sheaf ((smallZariskiTopology.{u, w, v} S).over X) AddCommGrpCat.{max (u + 1) v})
    (hF : smallZariskiPullbackClass.{u, w, v} S X F) (i : ℕ) :
    smallZariskiPullbackClass.{u, w, v} S Y
      ((((Over.map f).sheafPushforwardCocontinuous AddCommGrpCat.{max (u + 1) v}
        ((smallZariskiTopology.{u, w, v} S).over X)
        ((smallZariskiTopology.{u, w, v} S).over Y)).rightDerived i).obj F) := by
  rw [smallZariskiPullbackClass_iff] at hF ⊢
  have _ : (smallZariskiSheafEquiv.{u, w, v} S X).functor.Additive :=
    Functor.additive_of_preserves_binary_products _
  have _ : (smallZariskiSheafEquiv.{u, w, v} S Y).functor.Additive :=
    Functor.additive_of_preserves_binary_products _
  have _ := zariskiPullbackClass_isWeakSerreClass.{u, w, v} S (AsSmall.down.obj Y)
  have _ : ((Over.map (AsSmall.down.map f)).sheafPushforwardCocontinuous
      AddCommGrpCat.{max (u + 1) v} (S.zariskiTopology.over (AsSmall.down.obj X))
      (S.zariskiTopology.over (AsSmall.down.obj Y))).IsRightAdjoint :=
    ((Over.map (AsSmall.down.map f)).sheafAdjunctionCocontinuous
      AddCommGrpCat.{max (u + 1) v} (S.zariskiTopology.over (AsSmall.down.obj X))
      (S.zariskiTopology.over (AsSmall.down.obj Y))).isRightAdjoint
  have _ : IsGrothendieckAbelian.{max (u + 1) v}
      (Sheaf (Opens.grothendieckTopology (AsSmall.down.obj X).obj)
        AddCommGrpCat.{max (u + 1) v}) :=
    isGrothendieckAbelian_sheafOnSpace.{u, w, v} S (AsSmall.down.obj X)
  exact ObjectProperty.prop_of_iso _
    (Functor.rightDerivedObjIsoOfEquivalence (smallZariskiSheafEquiv.{u, w, v} S X)
      (smallZariskiSheafEquiv.{u, w, v} S Y) _ _ (smallOverMapPushforwardIso.{u, w, v} S f) F
        i).symm
    (S.zariskiPullbackClass_rightDerived_overMapPushforward.{u, w, v} (AsSmall.down.map f) hf
      _ hF i)

end Pushforward

/-- A presieve on `X.down` generates a sieve contained in the image under `AsSmall.down` of the
sieve generated by its image under `AsSmall.up`. -/
theorem generate_le_functorPushforward_generate_map {X : smallSite.{u, w, v} S}
    (P : Presieve (AsSmall.down.obj X)) :
    Sieve.generate P ≤ (Sieve.generate
      (P.map (AsSmall.up : S.category ⥤ smallSite.{u, w, v} S))).functorPushforward
        AsSmall.down := by
  rintro Z g ⟨Y, k, q, hq, rfl⟩
  exact ⟨AsSmall.up.obj Y, AsSmall.up.map q, k, Sieve.le_generate _ _ _ (Presieve.map_map hq), rfl⟩

/-- A presieve on `smallSite` whose generated sieve contains the image of a covering sieve of the
site is a covering of the induced topology. -/
private theorem generate_mem_inducedTopology_of_le {X : smallSite.{u, w, v} S}
    {J : GrothendieckTopology S.category} {R : Presieve X} {T : Sieve (AsSmall.down.obj X)}
    (hT : T ∈ J (AsSmall.down.obj X))
    (hle : T ≤ (Sieve.generate R).functorPushforward AsSmall.down) :
    Sieve.generate R ∈ AsSmall.down.inducedTopology J X := by
  rw [Functor.mem_inducedTopology_iff_of_isCoverDense]
  exact J.superset_covering hle hT

/-- The image under `AsSmall.up` of a Zariski covering of the site is a Zariski covering of
`smallSite`. -/
theorem map_up_mem_smallZariskiPrecoverage {X : smallSite.{u, w, v} S}
    {P : Presieve (AsSmall.down.obj X)} (hP : P ∈ S.zariskiPrecoverage (AsSmall.down.obj X)) :
    P.map (AsSmall.up : S.category ⥤ smallSite.{u, w, v} S) ∈
      smallZariskiPrecoverage.{u, w, v} S X := by
  exact generate_mem_inducedTopology_of_le S (Precoverage.generate_mem_toGrothendieck hP)
    (generate_le_functorPushforward_generate_map S P)

/-- The image under `AsSmall.up` of a quasi-compact covering of the site is a quasi-compact
covering of `smallSite`. -/
theorem map_up_mem_smallQcPrecoverage {X : smallSite.{u, w, v} S}
    {P : Presieve (AsSmall.down.obj X)} (hP : P ∈ S.qcSite.pretopology (AsSmall.down.obj X)) :
    P.map (AsSmall.up : S.category ⥤ smallSite.{u, w, v} S) ∈
      smallQcPrecoverage.{u, w, v} S X := by
  exact generate_mem_inducedTopology_of_le S ⟨P, hP, Sieve.le_generate P⟩
    (generate_le_functorPushforward_generate_map S P)

/-- **The three-stage refinement on `smallSite`**, transported from
`exists_zariskiRefinement_properMorphisms`. -/
theorem small_covering_refinement (U : smallSite.{u, w, v} S) (R : Presieve U)
    (hR : R ∈ smallQcPrecoverage.{u, w, v} S U) :
    ∃ Q : Presieve U, Q ∈ smallZariskiPrecoverage.{u, w, v} S U ∧
      ∀ ⦃V : smallSite.{u, w, v} S⦄ (v : V ⟶ U), Q v →
        ∃ (W : smallSite.{u, w, v} S) (f : W ⟶ V), smallProperMorphisms.{u, w, v} S f ∧
          Presieve.singleton f ∈ smallQcPrecoverage.{u, w, v} S V ∧
          ∃ T : Presieve W, T ∈ smallZariskiPrecoverage.{u, w, v} S W ∧
            T.FactorsThruAlong R (f ≫ v) := by
  change Sieve.generate R ∈ AsSmall.down.inducedTopology S.qcSite.grothendieckTopology U at hR
  rw [Functor.mem_inducedTopology_iff_of_isCoverDense] at hR
  obtain ⟨R₀, hR₀, hle⟩ := hR
  obtain ⟨Q, hQ, hQref⟩ :=
    S.exists_zariskiRefinement_properMorphisms (AsSmall.down.obj U) R₀ hR₀
  refine ⟨Q.map AsSmall.up, map_up_mem_smallZariskiPrecoverage S hQ, ?_⟩
  rintro V v ⟨hv⟩
  obtain ⟨W, f, hf, hsing, T, hT, hfac⟩ := hQref _ hv
  refine ⟨AsSmall.up.obj W, AsSmall.up.map f, hf, ?_, T.map AsSmall.up,
    map_up_mem_smallZariskiPrecoverage S hT, ?_⟩
  · refine generate_mem_inducedTopology_of_le S (J := S.qcSite.grothendieckTopology)
      ⟨Presieve.singleton f, hsing, Sieve.le_generate _⟩ ?_
    rintro Z g ⟨Y, k, q, ⟨⟩, rfl⟩
    exact ⟨_, AsSmall.up.map f, k, Sieve.le_generate _ _ _ Presieve.singleton.mk, rfl⟩
  · rintro Z g' ⟨hg⟩
    obtain ⟨W₀, i, e, he, hcomm⟩ := hfac hg
    obtain ⟨Z', g'', h, ⟨Y'', k, r, hr, rfl⟩, rfl⟩ := hle _ _ he
    refine ⟨Y'', AsSmall.up.map i ≫ AsSmall.up.map h ≫ k, r, hr, ?_⟩
    apply AsSmall.down.map_injective
    simp only [Functor.map_comp, Category.assoc] at hcomm ⊢
    exact hcomm

/-- **Situation 0EZ3 for `LC_qc` and `LC_Zar`**, with the proper arrows as distinguished class
and the sheaves pulled back from the space as weak Serre class, as chosen by Stacks 0EZI; it is
carried by `smallSite`, the site made small in the coefficient universe. -/
def comparisonSituation :
    Stacks.ComparingTopologies.CohomologyComparison (smallSite.{u, w, v} S) where
  fineCoverage := smallQcPrecoverage.{u, w, v} S
  fine_hasIsos := inferInstanceAs (GrothendieckTopology.toPrecoverage _).HasIsos
  fine_stableUnderComposition :=
    inferInstanceAs (GrothendieckTopology.toPrecoverage _).IsStableUnderComposition
  fine_hasPullbacks := inferInstance
  fine_stableUnderBaseChange :=
    inferInstanceAs (GrothendieckTopology.toPrecoverage _).IsStableUnderBaseChange
  coarseCoverage := smallZariskiPrecoverage.{u, w, v} S
  coarse_hasIsos := inferInstanceAs (GrothendieckTopology.toPrecoverage _).HasIsos
  coarse_stableUnderComposition :=
    inferInstanceAs (GrothendieckTopology.toPrecoverage _).IsStableUnderComposition
  coarse_hasPullbacks := inferInstance
  coarse_stableUnderBaseChange :=
    inferInstanceAs (GrothendieckTopology.toPrecoverage _).IsStableUnderBaseChange
  coarse_le_fine := smallZariskiPrecoverage_le_smallQcPrecoverage.{u, w, v} S
  morphismProperty := smallProperMorphisms.{u, w, v} S
  weakSerre := smallZariskiPullbackClass.{u, w, v} S
  weakSerreClass := smallZariskiPullbackClass_isWeakSerreClass.{u, w, v} S
  morphismProperty_baseChange := small_exists_isPullback_properMorphisms.{u, w, v} S
  weakSerre_relocalizationInverseImage := smallZariskiPullbackClass_overMapPullback.{u, w, v} S
  weakSerre_isSheaf_fine := smallZariskiPullbackClass_isSheaf_qc.{u, w, v} S
  weakSerre_rightDerived_relocalizationPushforward := fun _ _ f hf F hF i =>
    smallZariskiPullbackClass_rightDerived_overMapPushforward.{u, w, v} S f hf F hF i
  covering_refinement := small_covering_refinement.{u, w, v} S

section Vanishing

open Stacks.ComparingTopologies

variable (X : smallSite.{u, w, v} S)

/-- The change-of-topology direct image of `comparisonSituation` over `X`, read on the site: it
is `qcAbelianDirectImage` transported along the two sheaf equivalences, on the nose. -/
def smallChangeOfTopologyIso :
    qcAbelianDirectImage.{u, w, v} S (AsSmall.down.obj X) ⋙
        (smallZariskiSheafEquiv.{u, w, v} S X).inverse ≅
      (smallQcSheafEquiv.{u, w, v} S X).inverse ⋙
        abelianComparisonPushforward (smallQcPrecoverage.{u, w, v} S)
          (smallZariskiPrecoverage.{u, w, v} S)
          (smallZariskiPrecoverage_le_smallQcPrecoverage.{u, w, v} S) X :=
  Iso.refl _

attribute [local instance] enoughInjectives_qcSliceSheaf

/-- The vanishing of `isZero_rightDerived_qcAbelianDirectImage_of_vanishingCondition`, over an
object of `smallSite`. -/
theorem isZero_rightDerived_qcAbelianDirectImage_of_vanishingCondition_aux
    (hV : ∀ n, (comparisonSituation.{u, w, v} S).vanishingCondition n)
    (G : Sheaf (S.zariskiTopology.over (AsSmall.down.obj X)) AddCommGrpCat.{max (u + 1) v})
    (hG : S.zariskiPullbackClass.{u, w, v} (AsSmall.down.obj X) G) (i : ℕ)
    (hi : 0 < i) :
    IsZero (((qcAbelianDirectImage.{u, w, v} S (AsSmall.down.obj X)).rightDerived i).obj
      ((qcAbelianInverseImage.{u, w, v} S (AsSmall.down.obj X)).obj G)) := by
  let EQ := smallQcSheafEquiv.{u, w, v} S X
  let EZ := smallZariskiSheafEquiv.{u, w, v} S X
  have _ : EQ.symm.functor.Additive := Functor.additive_of_preserves_binary_products _
  have _ : EZ.symm.functor.Additive := Functor.additive_of_preserves_binary_products _
  have _ := isIso_qcAbelianComparisonAdjunction_unit_app.{u, w, v} S _ G
    (zariskiPullbackClass_isSheaf_qc.{u, w, v} S _ G hG)
  have _ := zariskiPullbackClass_isWeakSerreClass.{u, w, v} S (AsSmall.down.obj X)
  rw [Functor.isZero_rightDerived_obj_iff_of_equivalence EQ.symm EZ.symm
    (qcAbelianDirectImage.{u, w, v} S (AsSmall.down.obj X))
    (abelianComparisonPushforward (smallQcPrecoverage.{u, w, v} S)
      (smallZariskiPrecoverage.{u, w, v} S)
      (smallZariskiPrecoverage_le_smallQcPrecoverage.{u, w, v} S) X)
    (smallChangeOfTopologyIso.{u, w, v} S X)]
  refine hV i X _ ?_ i hi le_rfl
  refine (CohomologyComparison.fineWeakSerre_iff_weakSerre_pushforward _ _ _).2 ?_
  refine (smallZariskiPullbackClass_iff.{u, w, v} S X _).2 ?_
  exact ObjectProperty.prop_of_iso _
    (asIso ((qcAbelianComparisonAdjunction.{u, w, v} S _).unit.app G) ≪≫
      (EZ.counitIso.app _).symm ≪≫
      EZ.functor.mapIso ((smallChangeOfTopologyIso.{u, w, v} S X).app _)) hG

/-- **The vanishing conditions `(V_n)` of the comparison situation give the vanishing of the
higher change-of-topology direct images on the site.** If `comparisonSituation` satisfies
`(V_n)` for every `n`, then `R^i ε_{X,*}(ε_X^{-1}G) = 0` for `i > 0` and every `G` of the class
`zariskiPullbackClass` over every object `X` of the site. -/
theorem isZero_rightDerived_qcAbelianDirectImage_of_vanishingCondition
    (hV : ∀ n, (comparisonSituation.{u, w, v} S).vanishingCondition n) (X : S.category)
    (G : Sheaf (S.zariskiTopology.over X) AddCommGrpCat.{max (u + 1) v})
    (hG : S.zariskiPullbackClass.{u, w, v} X G) (i : ℕ) (hi : 0 < i) :
    IsZero (((qcAbelianDirectImage.{u, w, v} S X).rightDerived i).obj
      ((qcAbelianInverseImage.{u, w, v} S X).obj G)) :=
  isZero_rightDerived_qcAbelianDirectImage_of_vanishingCondition_aux.{u, w, v} S
    (AsSmall.up.obj X) hV G hG i hi

/-- **The higher change-of-topology direct images of a sheaf pulled back from the space
vanish**, `R^i ε_{X,*}(ε_X^{-1}G) = 0` for `i > 0` and `G` in `zariskiPullbackClass`: the
vanishing conditions `(V_n)` of `comparisonSituation`, which hold in every degree by Stacks 0EZF
(`CohomologyComparison.vanishingCondition_all`), read on the site. -/
theorem isZero_rightDerived_qcAbelianDirectImage_qcAbelianInverseImage (X : S.category)
    (G : Sheaf (S.zariskiTopology.over X) AddCommGrpCat.{max (u + 1) v})
    (hG : S.zariskiPullbackClass.{u, w, v} X G) (i : ℕ) (hi : 0 < i) :
    IsZero (((qcAbelianDirectImage.{u, w, v} S X).rightDerived i).obj
      ((qcAbelianInverseImage.{u, w, v} S X).obj G)) :=
  isZero_rightDerived_qcAbelianDirectImage_of_vanishingCondition.{u, w, v} S
    (comparisonSituation.{u, w, v} S).vanishingCondition_all X G hG i hi

end Vanishing

end Stacks.Topology.LocallyQuasiCompactZariskiSituation
