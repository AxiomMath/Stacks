/-!
# Exactness of the Zariski comparison direct image

Let `X` be an object of the locally quasi-compact Zariski site. Part of Stacks 0DCU is the
assertion that the comparison direct image

`π_{X,*} : Ab(LC_Zar/X) ⟶ Ab(X_Zar)`

is exact. It is automatically left exact, being a right adjoint; the content is right exactness,
and that is Stacks 04BD (1): the direct image along a morphism of sites which is in addition
*almost cocontinuous* is exact on abelian sheaves.

So the work here is to check that the open-subset functor `opensToSlice` is almost cocontinuous:
given a sieve `T` on `U → X` in the slice over `X` which the Zariski topology does not know to
be covering, one must produce a covering of `U` in the small site `X_Zar` each of whose members
either has empty image or is carried into `T`. Unwinding the Zariski topology, a covering sieve
of `U → X` in the big site is generated by a family of open immersions which jointly cover; the
opens they cut out in `X` form a covering of `U` in `X_Zar`, and each of them factors through
the corresponding member of the family, because a map into an open subspace through which it
set-theoretically factors lifts uniquely (`factorThroughEmbedding`).

Stacks 04BD is available in the repository only for sites whose objects and morphisms live in
the same universe, so the statement is transported: both sites are replaced by their `ULiftHom`
models, where the hypotheses can be checked, and the conclusion is carried back along the
induced equivalences of sheaf categories. `almostLift` is the transport of almost cocontinuity,
and `exactAfterLift` the transport of the exactness conclusion.

## Main results

* `Stacks.Topology.LocallyQuasiCompactZariskiSituation.abelianComparisonDirectImage_exact`: the
  comparison direct image is exact on abelian sheaves.

## Implementation notes

The repository's form of Stacks 04BD (1),
`CategoryTheory.Functor.exactFunctor_sheafPushforwardContinuous_of_isAlmostCocontinuous`, carries
the extra hypothesis `K.WEqualsLocallyBijective AddCommGrpCat`, which the source leaves implicit
in its standing assumption that the sites admit sheafification. It is discharged inside
`exactAfterLift`, for the `ULiftHom` model of the slice site, where sheafification of abelian
sheaves exists by `CategoryTheory.GrothendieckTopology.hasSheafify_addCommGrpCat` and the
general instance then applies; so it does not appear in the statement below.

Stacks 0DCU numbers seven clauses, the last of which the source splits into (7a) and (7b), and
each is in the library and carries the tag where it is stated: the cohomology comparison
`zariskiCohomologyComparisonIso` (1), the exactness of the direct image
`abelianComparisonDirectImage_exact` (2), the invertibility of the unit
`abelianComparisonAdjunction_unit_isIso` (3), its derived counterpart
`abelianDerivedComparisonAdjunction_unit_isIso` (4), the commutative square
`zariskiComparisonSquareIso` (5), the relative cohomology comparison
`relativeZariskiCohomologyIso` (6), and the compatibility of the comparison with pushforward
along a *proper* morphism, `properDirectImageComparisonIsoOfProperMap` (7a) and
`properDerivedImageComparison_isIso` (7b). The clause stated in this file is (2).

## References

* [Stacks Project, Tag 0DCU](https://stacks.math.columbia.edu/tag/0DCU)
* [Stacks Project, Tag 04BD](https://stacks.math.columbia.edu/tag/04BD)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace

namespace Stacks.Topology.LocallyQuasiCompactZariskiSituation

universe u w v uC vC uD vD β

/-- A continuous map factors through an embedding whose image contains its own, as a continuous
map: the lift is the given map followed by the inverse of the homeomorphism onto the image. -/
private noncomputable def factorThroughEmbedding
    {A B Z : Type*} [TopologicalSpace A] [TopologicalSpace B] [TopologicalSpace Z]
    (f : C(A, Z)) (g : C(B, Z)) (hg : Topology.IsEmbedding g)
    (h : ∀ a, f a ∈ Set.range g) : C(A, B) where
  toFun a := hg.toHomeomorph.symm ⟨f a, h a⟩
  continuous_toFun := hg.toHomeomorph.symm.continuous.comp (f.continuous.subtype_mk h)

/-- The lift of `f` through the embedding `g` does compose back to `f`. -/
private theorem factorThroughEmbedding_comp
    {A B Z : Type*} [TopologicalSpace A] [TopologicalSpace B] [TopologicalSpace Z]
    (f : C(A, Z)) (g : C(B, Z)) (hg : Topology.IsEmbedding g)
    (h : ∀ a, f a ∈ Set.range g) :
    g.comp (factorThroughEmbedding f g hg h) = f := by
  ext a
  exact congrArg Subtype.val (hg.toHomeomorph.apply_symm_apply ⟨f a, h a⟩)

/-- Almost cocontinuity transports to the `ULiftHom` models of the two sites. -/
private theorem almostLift
    {C : Type uC} [Category.{vC} C] {D : Type uD} [Category.{vD} D]
    {J : GrothendieckTopology C} {K : GrothendieckTopology D}
    (f : C ⥤ D) (ha : IsAlmostCocontinuous f J K) :
    let eC : C ≌ ULiftHom.{β} C := ULiftHom.equiv
    let eD : D ≌ ULiftHom.{β} D := ULiftHom.equiv
    let J' := eC.inverse.inducedTopology J
    let K' := eD.inverse.inducedTopology K
    IsAlmostCocontinuous (eC.inverse ⋙ f ⋙ eD.functor) J' K' := by
  dsimp only
  let eC : C ≌ ULiftHom.{β} C := ULiftHom.equiv
  let eD : D ≌ ULiftHom.{β} D := ULiftHom.equiv
  let J' := eC.inverse.inducedTopology J
  let K' := eD.inverse.inducedTopology K
  let f' := eC.inverse ⋙ f ⋙ eD.functor
  let _ : eC.functor.IsDenseSubsite J J' := inferInstance
  let _ : eD.functor.IsDenseSubsite K K' := inferInstance
  change IsAlmostCocontinuous f' J' K'
  intro U S hS
  obtain ⟨T, hT, hTmem⟩ := ha (eC.inverse.obj U)
    (((eD.toAdjunction.isCocontinuous_iff_coverPreserving K K').1
      inferInstance).cover_preserve hS)
  refine ⟨T.functorPushforward eC.functor,
    (Functor.IsDenseSubsite.coverPreserving J J' eC.functor).cover_preserve hT, ?_⟩
  intro V g hg
  obtain ⟨Z, k, q, hk, hfac⟩ := hg
  have hmap : eC.inverse.map g = eC.inverse.map q ≫ k := by rw [hfac]; rfl
  have hg₁ : T (eC.inverse.map g) := by
    rw [hmap]; exact T.downward_closed hk (eC.inverse.map q)
  rcases hTmem (eC.inverse.map g) hg₁ with hempty | hSg
  · have htemp := (Functor.IsDenseSubsite.coverPreserving K K' eD.functor).cover_preserve hempty
    rw [Sieve.functorPushforward_bot] at htemp
    exact Or.inl htemp
  · have hS₂ :
        S (eD.functor.map (f.map (eC.inverse.map g)) ≫
          eD.counit.app (eD.functor.obj (f.obj (eC.inverse.obj U)))) :=
      (Sieve.mem_functorPushforward_inverse
        (e := eD) (X := eD.functor.obj (f.obj (eC.inverse.obj U)))
        (f := f.map (eC.inverse.map g))).mp hSg
    have hc : eD.counit.app (eD.functor.obj (f.obj (eC.inverse.obj U))) =
        𝟙 (eD.functor.obj (f.obj (eC.inverse.obj U))) := rfl
    rw [hc, Category.comp_id] at hS₂
    exact Or.inr hS₂

/-- Exactness passes to a functor isomorphic to a composite of exact functors. -/
private theorem exactFunctor_of_natIso_comp {A B C D : Type*} [Category A] [Category B]
    [Category C] [Category D] (P : A ⥤ B) (G : B ⥤ C) (Q : C ⥤ D) {H : A ⥤ D}
    [PreservesFiniteLimits P] [PreservesFiniteColimits P]
    [PreservesFiniteLimits Q] [PreservesFiniteColimits Q]
    (hG : exactFunctor B C G) (e : P ⋙ G ⋙ Q ≅ H) : exactFunctor A D H := by
  let _ : PreservesFiniteLimits G := ((exactFunctor_iff G).mp hG).1
  let _ : PreservesFiniteColimits G := ((exactFunctor_iff G).mp hG).2
  let _ : PreservesFiniteLimits (P ⋙ G) := comp_preservesFiniteLimits P G
  let _ : PreservesFiniteColimits (P ⋙ G) := comp_preservesFiniteColimits P G
  exact (exactFunctor A D).prop_of_iso e ((exactFunctor_iff _).mpr
    ⟨comp_preservesFiniteLimits (P ⋙ G) Q, comp_preservesFiniteColimits (P ⋙ G) Q⟩)

/-- Exactness of the direct image, deduced on the `ULiftHom` models of the two sites — where
Stacks 04BD applies, both having their objects and morphisms in one universe — and transported
back along the induced equivalences of sheaf categories. -/
private theorem exactAfterLift
    {C : Type u} [Category.{u} C] {D : Type (u + 1)} [Category.{u} D]
    {J : GrothendieckTopology C} {K : GrothendieckTopology D}
    {f : C ⥤ D} [f.IsContinuous J K]
    (L : Sheaf J (Type (max (u + 1) v)) ⥤ Sheaf K (Type (max (u + 1) v)))
    (adj : L ⊣ f.sheafPushforwardContinuous (Type (max (u + 1) v)) J K)
    (hL : PreservesFiniteLimits L)
    (ha : IsAlmostCocontinuous f J K) :
    exactFunctor (Sheaf K AddCommGrpCat.{max (u + 1) v})
      (Sheaf J AddCommGrpCat.{max (u + 1) v})
      (f.sheafPushforwardContinuous AddCommGrpCat.{max (u + 1) v} J K) := by
  let eC : C ≌ ULiftHom.{max (u + 1) v} C := ULiftHom.equiv
  let eD : D ≌ ULiftHom.{max (u + 1) v} D := ULiftHom.equiv
  let J' := eC.inverse.inducedTopology J
  let K' := eD.inverse.inducedTopology K
  let f' := eC.inverse ⋙ f ⋙ eD.functor
  let _ : eC.functor.IsDenseSubsite J J' := inferInstance
  let _ : eD.functor.IsDenseSubsite K K' := inferInstance
  let _ : (eC.inverse ⋙ f).IsContinuous J' K := Functor.isContinuous_comp eC.inverse f J' J K
  have hf' : f'.IsContinuous J' K' := Functor.isContinuous_comp (eC.inverse ⋙ f) eD.functor J' K K'
  have ha' : IsAlmostCocontinuous f' J' K' := almostLift f ha
  let ECt := eC.sheafCongr J J' (Type (max (u + 1) v))
  let EDt := eD.sheafCongr K K' (Type (max (u + 1) v))
  let Lt := ECt.inverse ⋙ L ⋙ EDt.functor
  have hpush : ∀ (A : Type (max (u + 1) v + 1)) [Category.{max (u + 1) v} A],
      (eD.sheafCongr K K' A).inverse ⋙ f.sheafPushforwardContinuous A J K ⋙
        (eC.sheafCongr J J' A).functor ≅ f'.sheafPushforwardContinuous A J' K' := fun A _ =>
    Functor.isoWhiskerLeft (eD.sheafCongr K K' A).inverse
        (Functor.sheafPushforwardContinuousComp eC.inverse f A J' J K) ≪≫
      Functor.sheafPushforwardContinuousComp (eC.inverse ⋙ f) eD.functor A J' K K'
  let Pt := f'.sheafPushforwardContinuous (Type (max (u + 1) v)) J' K'
  have hpushT := hpush (Type (max (u + 1) v))
  have adjT : Lt ⊣ Pt :=
    (ECt.symm.toAdjunction.comp (adj.comp EDt.toAdjunction)).ofNatIsoRight hpushT
  have hLt : PreservesFiniteLimits Lt := by
    let _ : PreservesFiniteLimits L := hL
    let _ : PreservesFiniteLimits (L ⋙ EDt.functor) := comp_preservesFiniteLimits L EDt.functor
    exact comp_preservesFiniteLimits ECt.inverse (L ⋙ EDt.functor)
  have hm' : IsMorphismOfSites.{max (u + 1) v} f' J' K' :=
    { toIsContinuous := hf', hasExactLeftAdjoint := ⟨Lt, ⟨adjT⟩, hLt⟩ }
  let EC := eC.sheafCongr J J' AddCommGrpCat.{max (u + 1) v}
  let ED := eD.sheafCongr K K' AddCommGrpCat.{max (u + 1) v}
  let PA' := f'.sheafPushforwardContinuous AddCommGrpCat.{max (u + 1) v} J' K'
  have hpushA := hpush AddCommGrpCat.{max (u + 1) v}
  let _ : HasSheafify K' AddCommGrpCat.{max (u + 1) v} :=
    GrothendieckTopology.hasSheafify_addCommGrpCat K'
  let _ : K'.WEqualsLocallyBijective AddCommGrpCat.{max (u + 1) v} := inferInstance
  have hpush₂ : ED.inverse ⋙ f.sheafPushforwardContinuous AddCommGrpCat.{max (u + 1) v} J K ≅
      PA' ⋙ EC.inverse := Iso.isoCompInverse hpushA
  have htransport : ED.functor ⋙ PA' ⋙ EC.inverse ≅
      f.sheafPushforwardContinuous AddCommGrpCat.{max (u + 1) v} J K :=
    (Iso.isoInverseComp (G := ED.symm) hpush₂).symm
  exact exactFunctor_of_natIso_comp ED.functor PA' EC.inverse
    (Functor.exactFunctor_sheafPushforwardContinuous_of_isAlmostCocontinuous hm' ha') htransport

/-- A morphism whose image lies in the range of an embedding factors through it, for a category
fully faithfully embedded in `TopCat`. -/
private theorem exists_comp_eq_of_range_subset {A : Type uC} [Category.{vC} A]
    (F : A ⥤ TopCat.{u}) [F.Full] [F.Faithful] {Y₁ Y₂ Z : A} (a : Y₁ ⟶ Z) (b : Y₂ ⟶ Z)
    (hb : Topology.IsEmbedding (F.map b)) (hab : ∀ x, F.map a x ∈ Set.range (F.map b)) :
    ∃ q : Y₁ ⟶ Y₂, q ≫ b = a := by
  refine ⟨F.preimage (TopCat.ofHom (factorThroughEmbedding
    (TopCat.Hom.hom (F.map a)) (TopCat.Hom.hom (F.map b)) hb hab)), F.map_injective ?_⟩
  rw [Functor.map_comp, Functor.map_preimage]
  apply TopCat.hom_ext
  simpa using factorThroughEmbedding_comp (TopCat.Hom.hom (F.map a)) (TopCat.Hom.hom (F.map b))
    hb hab

/-- A morphism over a base factors through a member of a family over that base, as soon as its
range in the base is contained in that member's and the base morphism is an embedding. -/
private theorem exists_comp_eq_of_range_eq_over {A : Type uC} [Category.{vC} A]
    (F : A ⥤ TopCat.{u}) [F.Full] [F.Faithful] {Y₁ Y₂ V Z : A}
    (a : Y₁ ⟶ V) (b : Y₂ ⟶ V) (v : V ⟶ Z) (c : Y₁ ⟶ Z)
    (hv : Topology.IsEmbedding (F.map v)) (hb : Topology.IsEmbedding (F.map b))
    (hac : a ≫ v = c) (hrange : Set.range (F.map c) ⊆ Set.range (F.map (b ≫ v))) :
    ∃ q : Y₁ ⟶ Y₂, q ≫ b = a := by
  refine exists_comp_eq_of_range_subset F a b hb fun x => ?_
  obtain ⟨z, hz⟩ := hrange ⟨x, rfl⟩
  rw [← hac] at hz
  exact ⟨z, hv.injective (by simpa [Functor.map_comp] using hz)⟩

/-- A family which `F` carries to a covering of `TopCat` consists of open embeddings. -/
private theorem isOpenEmbedding_of_map_ofArrows_mem_precoverage {A : Type uC} [Category.{vC} A]
    (F : A ⥤ TopCat.{u}) {Y : A} {ι : Type*} {Z : ι → A} (g : ∀ i, Z i ⟶ Y)
    (hg : Presieve.map F (Presieve.ofArrows Z g) ∈ TopCat.precoverage (F.obj Y)) :
    ∀ i, Topology.IsOpenEmbedding (F.map (g i)) := by
  have hopen : Presieve.ofArrows (fun i => F.obj (Z i)) (fun i => F.map (g i)) ∈
      TopCat.isOpenEmbedding.precoverage (F.obj Y) := by
    simpa using hg.2
  simpa [TopCat.isOpenEmbedding] using MorphismProperty.ofArrows_mem_precoverage.mp hopen

/-- A family which `F` carries to a covering of `TopCat` is jointly surjective. -/
private theorem exists_mem_range_of_map_ofArrows_mem_precoverage {A : Type uC} [Category.{vC} A]
    (F : A ⥤ TopCat.{u}) {Y : A} {ι : Type*} {Z : ι → A} (g : ∀ i, Z i ⟶ Y)
    (hg : Presieve.map F (Presieve.ofArrows Z g) ∈ TopCat.precoverage (F.obj Y)) :
    ∀ y : F.obj Y, ∃ i, y ∈ Set.range (F.map (g i)) := by
  have hjoint : Presieve.ofArrows (fun i => F.obj (Z i)) (fun i => F.map (g i)) ∈
      Types.jointlySurjectivePrecoverage.comap (forget TopCat) (F.obj Y) := by
    simpa only [Presieve.map_ofArrows] using hg.1
  simpa using (Presieve.ofArrows_mem_comap_jointlySurjectivePrecoverage_iff
    (F := forget TopCat) (Y := fun i => F.obj (Z i))
    (f := fun i => F.map (g i))).mp hjoint

/-- The opens cut out by a family of open subsets of `U` which jointly cover it form a covering
sieve of `U` in the small Zariski site. -/
private theorem mem_grothendieckTopology_ofArrows {Z : Type*} [TopologicalSpace Z]
    {U : Opens Z} {ι : Type*} (W : ι → Opens Z) (hWU : ∀ i, W i ≤ U)
    (hcover : ∀ x ∈ U, ∃ i, x ∈ W i) :
    Sieve.ofArrows W (fun i => homOfLE (hWU i)) ∈ Opens.grothendieckTopology Z U := by
  intro x hx
  obtain ⟨i, hi⟩ := hcover x hx
  exact ⟨W i, homOfLE (hWU i), Sieve.ofArrows_mk W _ i, hi⟩

section Instances

variable {S₀ : Set LocallyQuasiCompactHausdorff.{u}} {Bound : Cardinal.{u} → Cardinal.{u}}
  (S : LocallyQuasiCompactZariskiSituation.{u, w} S₀ Bound)

private instance preservesLimitsOfShape_walkingCospan_inclusion :
    PreservesLimitsOfShape WalkingCospan S.qcSite.inclusion := by
  let Q : ObjectProperty LocallyQuasiCompactHausdorff := fun Y => lcSize Y < S.qcSite.cutoff
  let J' := ULiftHom.{u} (ULift.{u} WalkingCospan)
  let eShape : WalkingCospan ≌ J' := ULiftHomULiftCategory.equiv WalkingCospan
  let _ : HasLimitsOfShape J' LocallyQuasiCompactHausdorff := hasLimitsOfShape_of_equivalence eShape
  let _ : Q.IsClosedUnderLimitsOfShape J' :=
    S.qcSite.boundedSubcategory.closedUnderCountableLimits J'
  let _ : CreatesLimitsOfShape J' S.qcSite.inclusion := inferInstance
  let _ : PreservesLimitsOfShape J' S.qcSite.inclusion := inferInstance
  exact preservesLimitsOfShape_of_equiv eShape.symm S.qcSite.inclusion

private instance : Precoverage.HasPullbacks S.zariskiPrecoverage := by
  dsimp [LocallyQuasiCompactZariskiSituation.zariskiPrecoverage]
  infer_instance

private instance : Precoverage.IsStableUnderBaseChange S.zariskiPrecoverage := by
  dsimp [LocallyQuasiCompactZariskiSituation.zariskiPrecoverage]
  infer_instance

private instance : Precoverage.IsStableUnderComposition S.zariskiPrecoverage := by
  dsimp [LocallyQuasiCompactZariskiSituation.zariskiPrecoverage]
  infer_instance

private instance : Precoverage.HasIsos S.zariskiPrecoverage := by
  dsimp [LocallyQuasiCompactZariskiSituation.zariskiPrecoverage]
  infer_instance

end Instances

/-- The open-subset functor is almost cocontinuous: a Zariski covering sieve of `U → X` in the
big site is generated by jointly surjective open immersions, and the opens they cut out in `X`
form a covering of `U` in the small site each of whose members factors through the sieve. -/
theorem opensToSlice_isAlmostCocontinuous
    {S₀ : Set LocallyQuasiCompactHausdorff.{u}} {Bound : Cardinal.{u} → Cardinal.{u}}
    (S : LocallyQuasiCompactZariskiSituation.{u, w} S₀ Bound) (X : S.category) :
    IsAlmostCocontinuous (S.opensToSlice X).1 (Opens.grothendieckTopology X.obj)
      (S.zariskiTopology.over X) := by
  classical
  let f := (S.opensToSlice X).1
  let F := S.qcSite.inclusion ⋙ locallyQuasiCompactHausdorffToTop
  let _ : PreservesLimitsOfShape WalkingCospan F := comp_preservesLimitsOfShape _ _
  intro U T hT
  let V := f.obj U
  have hT' : Sieve.overEquiv V T ∈ S.zariskiPrecoverage.toGrothendieck V.left :=
    (S.zariskiTopology.mem_over_iff T).mp hT
  rw [Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition] at hT'
  obtain ⟨R, hR, hRle⟩ := hT'
  obtain ⟨ι, Z, g, hRrep⟩ := R.exists_eq_ofArrows
  rw [hRrep] at hR hRle
  have hopenMap : ∀ i, Topology.IsOpenEmbedding (F.map (g i)) :=
    isOpenEmbedding_of_map_ofArrows_mem_precoverage F g hR
  have hjoint : ∀ y : F.obj V.left, ∃ i, y ∈ Set.range (F.map (g i)) :=
    exists_mem_range_of_map_ofArrows_mem_precoverage F g hR
  have hVopen : Topology.IsOpenEmbedding (F.map V.hom) := ((S.opensToSlice X).property U).1
  have hVrange : Set.range (F.map V.hom) = U.1 := ((S.opensToSlice X).property U).2
  let m (i : ι) := F.map (g i ≫ V.hom)
  have hm (i : ι) : Topology.IsOpenEmbedding (m i) := by
    dsimp only [m]
    rw [Functor.map_comp]; exact hVopen.comp (hopenMap i)
  let W (i : ι) : Opens X.obj := ⟨Set.range (m i), (hm i).isOpen_range⟩
  have hWU (i : ι) : W i ≤ U := by
    rintro x ⟨z, rfl⟩
    change (m i) z ∈ U.1; rw [← hVrange]
    exact ⟨(F.map (g i)) z, by simp [m, Functor.map_comp]⟩
  have hcover : ∀ x ∈ U, ∃ i, x ∈ W i := fun x hx => by
    change x ∈ U.1 at hx; rw [← hVrange] at hx
    obtain ⟨y, rfl⟩ := hx
    obtain ⟨i, z, hz⟩ := hjoint y
    exact ⟨i, z, by simpa [W, m, Functor.map_comp] using congrArg (F.map V.hom) hz⟩
  let h (i : ι) : W i ⟶ U := homOfLE (hWU i)
  refine ⟨Sieve.ofArrows W h, mem_grothendieckTopology_ofArrows W hWU hcover, ?_⟩
  intro W₀ k hk
  rw [Sieve.mem_ofArrows_iff] at hk
  obtain ⟨i, a, rfl⟩ := hk
  have hrange : Set.range (F.map ((f.obj (W i)).hom)) ⊆ Set.range (F.map (g i ≫ V.hom)) :=
    ((S.opensToSlice X).property (W i)).2.subset
  obtain ⟨q, hq⟩ := exists_comp_eq_of_range_eq_over F ((f.map (h i)).left) (g i) V.hom
    ((f.obj (W i)).hom) hVopen.toIsEmbedding (hopenMap i).toIsEmbedding (f.map (h i)).w hrange
  have hleft : (Sieve.overEquiv V T) ((f.map (h i)).left) := by
    rw [← hq]; exact (Sieve.overEquiv V T).downward_closed (Presieve.ofArrows_le_iff.mp hRle i) q
  have hhi : T (f.map (h i)) := by
    simpa using (Sieve.overEquiv_symm_iff (S := Sieve.overEquiv V T) (f := f.map (h i))).2 hleft
  refine Or.inr ?_
  rw [Functor.map_comp]; exact T.downward_closed hhi (f.map a)

/-- **Stacks 0DCU, the exact-direct-image clause.** The direct image from the Zariski slice site
of an object to the Zariski site of its underlying space is exact on abelian sheaves. -/
@[stacks 0DCU "exact_direct_image"]
theorem abelianComparisonDirectImage_exact
    {S₀ : Set LocallyQuasiCompactHausdorff.{u}} {Bound : Cardinal.{u} → Cardinal.{u}}
    (S : LocallyQuasiCompactZariskiSituation.{u, w} S₀ Bound)
    (X : S.category) :
    exactFunctor
      (Sheaf (S.zariskiTopology.over X) AddCommGrpCat.{max (u + 1) v})
      (Sheaf (Opens.grothendieckTopology X.obj) AddCommGrpCat.{max (u + 1) v})
      (S.comparisonDirectImage X AddCommGrpCat.{max (u + 1) v}) := by
  let J := Opens.grothendieckTopology X.obj
  let K := S.zariskiTopology.over X
  let f := (S.opensToSlice X).1
  let _ : f.IsContinuous J K := S.opensToSlice_isContinuous X
  let L := comparisonInverseImage.{u, w, max (u + 1) v} S X
  let P := f.sheafPushforwardContinuous (Type (max (u + 1) v)) J K
  have adj : L ⊣ P := comparisonAdjunction.{u, w, max (u + 1) v} S X
  have hL : PreservesFiniteLimits L :=
    comparisonInverseImage_preservesFiniteLimits.{u, w, max (u + 1) v} S X
  exact exactAfterLift (L := L) adj hL (opensToSlice_isAlmostCocontinuous S X)

end Stacks.Topology.LocallyQuasiCompactZariskiSituation

end
