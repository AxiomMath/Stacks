module

public import Mathlib.CategoryTheory.Sites.Sieves.Basic
public import StacksCore.Tactic.StacksAttribute

/-!
# The lattice of sieves on an object

Stacks 00YZ collects the basic structure of the collection of sieves on an object `U` of a category
`C`: it is a set, partially ordered by inclusion, closed under arbitrary unions and intersections,
it contains a smallest sieve through which a given family of morphisms with target `U` factors, and
it has a largest element `h_U` and a smallest element the empty subpresheaf.

In Mathlib a sieve is the bundled `CategoryTheory.Sieve`, and the last five clauses are the
`CategoryTheory.Sieve.instCompleteLattice` structure together with `CategoryTheory.Sieve.ofArrows`.
Clause (1) — "the collection of sieves on `U` is a set" — is a smallness statement, which in a
type theory is carried by the source's own argument: a sieve is a subpresheaf of `h_U`, hence is
determined by the family of subsets `{f : V ⟶ U | f ∈ S}` of the sets `h_U(V) = Hom(V, U)`. That
injection is `sieveSetEmbedding` below.

## Main results

* `sieveSetEmbedding`: sieves on `U` inject into `∀ V, Set (V ⟶ U)` (Stacks 00YZ (1)).
* `Sieve.le_iff_forall_subset`: the order on sieves is inclusion (Stacks 00YZ (2)).
* `Sieve.iSup_apply`, `Sieve.iInf_apply`: the sup and inf of a family of sieves are the pointwise
  union and intersection (Stacks 00YZ (3)).
* `Sieve.isLeast_ofArrows`, `Sieve.existsUnique_isLeast_arrows_mem`: `Sieve.ofArrows` is the unique
  smallest sieve containing a given family of morphisms with target `U` (Stacks 00YZ (4)).
* `Sieve.isGreatest_top`, `Sieve.isLeast_bot`: `⊤ = h_U` is the maximal sieve and `⊥` the minimal
  one (Stacks 00YZ (5), (6)).

Tags covered: 00YZ.
-/

@[expose] public section

open CategoryTheory

universe w v u

namespace CategoryTheory

variable {C : Type u} [Category.{v} C] {U : C}

/-- **Stacks 00YZ (1).** A sieve on `U` is a subpresheaf of `h_U`, so it is determined by the
family of subsets `{f : V ⟶ U | f ∈ S}` of `h_U(V) = Hom(V, U)`. Thus the collection of sieves on
`U` injects into `∏_V 𝒫(Hom(V, U))`, which is the source's proof that it is a set. -/
@[stacks 00YZ "(1)"]
def sieveSetEmbedding (U : C) : Sieve U ↪ ∀ V : C, Set (V ⟶ U) where
  toFun S _ := {f | S.arrows f}
  inj' _ _ h := Sieve.ext fun V f => Set.ext_iff.mp (congrFun h V) f

namespace Sieve

/-- **Stacks 00YZ (2).** The partial order on sieves on `U` is inclusion: `S ≤ T` holds exactly
when the subset of `Hom(V, U)` cut out by `S` is contained in the one cut out by `T`, for every
`V`. -/
@[stacks 00YZ "(2)", sga "3 IV 4.1.1" "special case", sga "4 I 4.3.2"]
theorem le_iff_forall_subset {S T : Sieve U} :
    S ≤ T ↔ ∀ V : C, sieveSetEmbedding U S V ⊆ sieveSetEmbedding U T V :=
  ⟨fun h _ _ hf => h _ hf, fun h _ _ hf => h _ hf⟩

/-- **Stacks 00YZ (3).** The union of a family of sieves on `U` is a sieve, namely their
supremum: an arrow lies in `⨆ i, S i` exactly when it lies in some `S i`. -/
@[stacks 00YZ "(3)", sga "4 I 4.3.2" "union"]
theorem iSup_apply {I : Type w} (S : I → Sieve U) {V : C} (f : V ⟶ U) :
    (⨆ i, S i) f ↔ ∃ i, S i f := by
  simp [iSup]

/-- **Stacks 00YZ (3).** The intersection of a family of sieves on `U` is a sieve, namely their
infimum: an arrow lies in `⨅ i, S i` exactly when it lies in every `S i`. -/
@[stacks 00YZ "(3)", sga "4 I 4.3.2" "intersection"]
theorem iInf_apply {I : Type w} (S : I → Sieve U) {V : C} (f : V ⟶ U) :
    (⨅ i, S i) f ↔ ∀ i, S i f := by
  simp [iInf]

/-- **Stacks 00YZ (4).** Given a family `{Y i ⟶ U}` of morphisms with target `U`, the sieve
`Sieve.ofArrows` it generates — the union of the images of the maps `h_{Y i} → h_U` — is the
smallest sieve on `U` containing every `f i`. -/
@[stacks 00YZ "(4)"]
theorem isLeast_ofArrows {I : Type w} (Y : I → C) (f : ∀ i, Y i ⟶ U) :
    IsLeast {S : Sieve U | ∀ i, S (f i)} (Sieve.ofArrows Y f) :=
  ⟨ofArrows_mk Y f, fun _ hT => by
    rw [Sieve.ofArrows, generate_le_iff]
    rintro V g ⟨i⟩
    exact hT i⟩

/-- **Stacks 00YZ (4).** The smallest sieve on `U` containing a given family `{Y i ⟶ U}` of
morphisms with target `U` is unique. -/
@[stacks 00YZ "(4)",
  sga "4 I 4.3.3" "generated sieve",
  sga "4½ Arcata 1.6.1" "sieve generated by U_i"]
theorem existsUnique_isLeast_arrows_mem {I : Type w} (Y : I → C) (f : ∀ i, Y i ⟶ U) :
    ∃! S : Sieve U, IsLeast {S : Sieve U | ∀ i, S (f i)} S :=
  ⟨_, isLeast_ofArrows Y f, fun _ hS => hS.unique (isLeast_ofArrows Y f)⟩

/-- **Stacks 00YZ (5).** The sieve `h_U`, which contains every arrow with target `U`
(`CategoryTheory.Sieve.top_apply`), is the maximal sieve on `U`. -/
@[stacks 00YZ "(5)"]
theorem isGreatest_top : IsGreatest (Set.univ : Set (Sieve U)) ⊤ :=
  ⟨Set.mem_univ _, fun _ _ => le_top⟩

/-- **Stacks 00YZ (6).** The empty subpresheaf of `h_U`, which contains no arrow at all
(`CategoryTheory.Sieve.bot_apply`), is the minimal sieve on `U`. -/
@[stacks 00YZ "(6)"]
theorem isLeast_bot : IsLeast (Set.univ : Set (Sieve U)) ⊥ :=
  ⟨Set.mem_univ _, fun _ _ => bot_le⟩

end Sieve

end CategoryTheory

/- Clause (5) also asserts that the maximal sieve *is* `h_U`, i.e. that it contains every arrow
with target `U`, and clause (6) that the minimal one is the empty subpresheaf. Both are already in
Mathlib. -/
add_to_stacks 00YZ "(5)" CategoryTheory.Sieve.top_apply
add_to_stacks 00YZ "(6)" CategoryTheory.Sieve.bot_apply
