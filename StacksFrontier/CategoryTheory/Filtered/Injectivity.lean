module

public import Mathlib.Algebra.Category.Grp.Colimits
public import Mathlib.CategoryTheory.Limits.Types.Colimits
public import Mathlib.Data.ZMod.Basic
public import Mathlib.Tactic.Ring
public import StacksFrontier.CategoryTheory.Filtered.SpanCocones

/-!
# Injectivity of induced maps on colimits over a span-completing category (Stacks 09WT)

Stacks 09WT is a two-part statement about an index category `I` in which every span
`y ← x → z` can be completed to a commutative square — the predicate
`CategoryTheory.HasSpanCocone` introduced for Stacks 002X, imported here rather than
restated.

* **Part (1)**, `colimMap_injective_of_span`: for `Type`-valued diagrams `M, N : I ⥤ Type w`,
  a natural transformation `α : M ⟶ N` that is injective in each component induces an
  injective map `colimit M ⟶ colimit N`. The colimit of a `Type`-valued diagram is the
  quotient of `Σ i, N.obj i` by the equivalence relation generated by
  `Functor.ColimitTypeRel`, so the proof is an induction over that generated relation
  showing that any two related elements already agree after being pushed to a common
  object; this is the source's zig-zag-shortening argument, and the span hypothesis is what
  lets the `trans` step be shortened.

* **Part (2)**, `exists_diagram_addCommGrp_colimMap_not_injective`: the analogue fails for
  diagrams of abelian groups. The witness is the Stacks counterexample, collected in the
  `ShearCounterexample` namespace below: `I` is the delooping of `ZMod 2` (one object,
  morphism monoid `ZMod 2`), `M` is the trivial diagram on `ZMod 2`, `N` carries
  `ZMod 2 × ZMod 2` with the shear action `g · (x, y) = (x + g * y, y)`, and `α` is the
  injective inclusion `x ↦ (x, 0)`. In `colimit N` the shear identifies `(1, 1)` with
  `(0, 1)`, hence sends `(1, 0)` to `0`, while `colimit M` is still `ZMod 2`; so `colimMap α`
  kills a nonzero element. The additive structure is essential: the subtraction
  `(1, 0) = (1, 1) - (0, 1)` has no counterpart for `Type`-valued diagrams.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace CategoryTheory.Limits

universe u v w

/-! ### Part (1): Injectivity on colimits of `Type`-valued diagrams. -/

/-- Two elements of `Σ i, N.obj i` identified in the colimit of a `Type`-valued diagram over
a span-completing category already agree after being mapped to a common object. -/
private lemma exists_common_refinement_of_colimitTypeRel
    {I : Type u} [Category.{v} I] (hI : HasSpanCocone I)
    {N : I ⥤ Type w} {a b : Σ i : I, N.obj i}
    (h : Relation.EqvGen N.ColimitTypeRel a b) :
    ∃ (w : I) (s : a.1 ⟶ w) (t : b.1 ⟶ w), N.map s a.2 = N.map t b.2 := by
  induction h with
  | rel a b hab =>
    obtain ⟨f, hf⟩ := hab
    exact ⟨b.1, f, 𝟙 b.1, by simp [← hf]⟩
  | refl a => exact ⟨a.1, 𝟙 a.1, 𝟙 a.1, rfl⟩
  | symm _ _ _ ih =>
    obtain ⟨w, s, t, hst⟩ := ih
    exact ⟨w, t, s, hst.symm⟩
  | trans _ _ _ _ _ ih₁ ih₂ =>
    obtain ⟨w₁, s₁, t₁, h₁⟩ := ih₁
    obtain ⟨w₂, s₂, t₂, h₂⟩ := ih₂
    obtain ⟨w, u₁, u₂, hsq⟩ := hI t₁ s₂
    refine ⟨w, s₁ ≫ u₁, t₂ ≫ u₂, ?_⟩
    simp only [Functor.map_comp_apply]
    rw [h₁, ← Functor.map_comp_apply, hsq,
        Functor.map_comp_apply, h₂]

/-- **Stacks 09WT (1).** If every span in `I` admits a commutative completion, then a
componentwise-injective natural transformation between `Type`-valued diagrams over `I`
induces an injective map on colimits. -/
@[stacks 09WT "(1)"]
theorem colimMap_injective_of_span
    {I : Type u} [Category.{v} I] (hI : HasSpanCocone I)
    {M N : I ⥤ Type w} [HasColimit M] [HasColimit N]
    (α : M ⟶ N) (hα : ∀ i : I, Function.Injective (α.app i)) :
    Function.Injective (colimMap α : colimit M ⟶ colimit N) := by
  intro x y hxy
  obtain ⟨i, m, rfl⟩ := Types.jointly_surjective' x
  obtain ⟨i', m', rfl⟩ := Types.jointly_surjective' y
  have hι : ∀ (j : I) (n : M.obj j),
      colimMap α (colimit.ι M j n) = colimit.ι N j (α.app j n) := fun j n => by
    have h := ConcreteCategory.congr_hom (ι_colimMap α j) n
    simp only [ConcreteCategory.comp_apply] at h
    exact h
  rw [hι, hι] at hxy
  obtain ⟨w, s, t, hst⟩ :=
    exists_common_refinement_of_colimitTypeRel hI (Types.colimit_eq hxy)
  have hM_eq : M.map s m = M.map t m' := hα w <| by
    rw [NatTrans.naturality_apply α s m, NatTrans.naturality_apply α t m']
    exact hst
  rw [← colimit.w_apply M s m, ← colimit.w_apply M t m', hM_eq]

/-! ### Part (2): Counterexample for diagrams of abelian groups. -/

namespace ShearCounterexample

/-- The index category of the counterexample: the delooping of `ZMod 2`, i.e. the
one-object category whose morphism monoid is `ZMod 2`. -/
@[implicit_reducible]
def SingleObjZMod2 : Type := PUnit

/-- Morphisms of `SingleObjZMod2` are the elements of `ZMod 2`, composed by addition. -/
instance smallCategory : SmallCategory SingleObjZMod2 where
  Hom _ _ := ZMod 2
  id _ := (0 : ZMod 2)
  comp f g := (show ZMod 2 from f) + (show ZMod 2 from g)
  id_comp f := show (0 : ZMod 2) + f = f by simp
  comp_id f := show (show ZMod 2 from f) + (0 : ZMod 2) = f by simp
  assoc f g h := show ((show ZMod 2 from f) + g) + h
                      = (show ZMod 2 from f) + (g + h) by ring

/-- The identity of `SingleObjZMod2` is `0 : ZMod 2`. -/
lemma id_eq (X : SingleObjZMod2) : (𝟙 X : X ⟶ X) = (0 : ZMod 2) := rfl

/-- Composition in `SingleObjZMod2` is addition in `ZMod 2`. -/
lemma comp_eq {X Y Z : SingleObjZMod2} (f : X ⟶ Y) (g : Y ⟶ Z) :
    f ≫ g = (show ZMod 2 from f) + (show ZMod 2 from g) := rfl

/-- Every span in `SingleObjZMod2` admits a commutative completion, because addition in
`ZMod 2` is commutative. -/
theorem hasSpanCocone : HasSpanCocone SingleObjZMod2 := fun _ _ _ f g =>
  ⟨PUnit.unit, g, f,
    show (show ZMod 2 from f) + g = (show ZMod 2 from g) + f by ring⟩

/-- The trivial diagram on `ZMod 2`: every morphism of `SingleObjZMod2` acts as the
identity. -/
@[implicit_reducible, simps]
def trivialDiagram : SingleObjZMod2 ⥤ AddCommGrpCat.{0} where
  obj _ := AddCommGrpCat.of (ZMod 2)
  map _ := AddCommGrpCat.ofHom (AddMonoidHom.id _)
  map_id _ := rfl
  map_comp _ _ := by ext; rfl

/-- The shear automorphism of `ZMod 2 × ZMod 2` attached to `g : ZMod 2`, namely
`(x, y) ↦ (x + g * y, y)`. -/
def shearAction (g : ZMod 2) : (ZMod 2 × ZMod 2) →+ (ZMod 2 × ZMod 2) :=
  AddMonoidHom.mk' (fun p => (p.1 + g * p.2, p.2))
    (fun a b => by
      ext
      · simp; ring
      · simp)

/-- The shear attached to `g` sends `(x, y)` to `(x + g * y, y)`. -/
@[simp]
lemma shearAction_apply (g : ZMod 2) (p : ZMod 2 × ZMod 2) :
    shearAction g p = (p.1 + g * p.2, p.2) := rfl

/-- The shear attached to `0` is the identity. -/
lemma shearAction_zero : shearAction 0 = AddMonoidHom.id _ := by
  ext ⟨a, b⟩ <;> simp

/-- The shears compose additively, so they define an action of the monoid `ZMod 2`. -/
lemma shearAction_add (f g : ZMod 2) :
    shearAction (f + g) = (shearAction g).comp (shearAction f) := by
  ext ⟨a, b⟩
  · simp only [shearAction_apply, AddMonoidHom.coe_comp, Function.comp_apply]
    ring
  · simp

/-- The diagram carrying `ZMod 2 × ZMod 2` with the shear action. -/
@[implicit_reducible, simps]
def shearDiagram : SingleObjZMod2 ⥤ AddCommGrpCat.{0} where
  obj _ := AddCommGrpCat.of (ZMod 2 × ZMod 2)
  map g := AddCommGrpCat.ofHom (shearAction g)
  map_id X := by
    rw [id_eq, shearAction_zero, AddCommGrpCat.ofHom_id]
  map_comp {_ _ _} f g := by
    rw [comp_eq, shearAction_add, AddCommGrpCat.ofHom_comp]

/-- The injective inclusion `ZMod 2 → ZMod 2 × ZMod 2`, `x ↦ (x, 0)`. -/
def inclusionHom : (ZMod 2) →+ (ZMod 2 × ZMod 2) :=
  AddMonoidHom.mk' (fun x => (x, 0)) (fun a b => by ext <;> simp)

/-- The inclusion `inclusionHom` sends `x` to `(x, 0)`. -/
@[simp]
lemma inclusionHom_apply (x : ZMod 2) : inclusionHom x = (x, 0) := rfl

/-- The naturality square for `inclusionHom`, at the level of additive monoid
homomorphisms: shearing fixes the image of `inclusionHom`. -/
lemma inclusionHom_naturality (f : ZMod 2) :
    inclusionHom.comp (AddMonoidHom.id (ZMod 2)) = (shearAction f).comp inclusionHom := by
  ext x <;> simp

/-- The natural transformation `trivialDiagram ⟶ shearDiagram` with component
`x ↦ (x, 0)`. -/
@[simps]
def inclusion : trivialDiagram ⟶ shearDiagram where
  app _ := AddCommGrpCat.ofHom inclusionHom
  naturality {_ _} f := by
    rw [trivialDiagram_map, shearDiagram_map, ← AddCommGrpCat.ofHom_comp,
      ← AddCommGrpCat.ofHom_comp, inclusionHom_naturality]

/-- Every component of `inclusion` is injective. -/
lemma inclusion_app_injective :
    ∀ i : SingleObjZMod2, Function.Injective (inclusion.app i) := fun _ x y h =>
  (Prod.mk.inj (h : inclusionHom x = inclusionHom y)).1

/-- The constant cocone over `trivialDiagram` with vertex `ZMod 2`, which shows that the
colimit of `trivialDiagram` is still `ZMod 2`. -/
private def trivialCocone : Cocone trivialDiagram where
  pt := AddCommGrpCat.of (ZMod 2)
  ι :=
    { app := fun _ => AddCommGrpCat.ofHom (AddMonoidHom.id (ZMod 2))
      naturality := by intros; ext; rfl }

private lemma desc_trivialCocone_ι_apply (x : ZMod 2) :
    (colimit.desc trivialDiagram trivialCocone)
      ((colimit.ι trivialDiagram PUnit.unit) x) = x :=
  congrArg (fun f => (ConcreteCategory.hom f) x)
    (colimit.ι_desc trivialCocone PUnit.unit)

private lemma colimit_ι_trivialDiagram_zero_ne_one :
    (colimit.ι trivialDiagram PUnit.unit) (0 : ZMod 2)
      ≠ (colimit.ι trivialDiagram PUnit.unit) (1 : ZMod 2) := fun h =>
  absurd (show (0 : ZMod 2) = 1 by
    rw [← desc_trivialCocone_ι_apply 0, h, desc_trivialCocone_ι_apply 1]) (by decide)

private lemma colimit_ι_shearDiagram_one_zero_eq_zero :
    (colimit.ι shearDiagram PUnit.unit) ((1, 0) : ZMod 2 × ZMod 2) = 0 := by
  set ι := (colimit.ι shearDiagram PUnit.unit).hom
  have hw := ConcreteCategory.congr_hom
    (colimit.w shearDiagram (j := (PUnit.unit : SingleObjZMod2)) (j' := PUnit.unit)
      (1 : ZMod 2))
    ((0, 1) : ZMod 2 × ZMod 2)
  have hmap : (ConcreteCategory.hom
      (shearDiagram.map (X := (PUnit.unit : SingleObjZMod2)) (Y := PUnit.unit) (1 : ZMod 2)))
        ((0, 1) : ZMod 2 × ZMod 2) = ((1, 1) : ZMod 2 × ZMod 2) := by
    simp
  have h : ι ((1, 1) : ZMod 2 × ZMod 2) = ι ((0, 1) : ZMod 2 × ZMod 2) := by
    rw [← hmap, ← hw, comp_apply]
  calc ι (1, 0)
      = ι ((1, 1) - (0, 1)) := by congr 1
    _ = ι (1, 1) - ι (0, 1) := ι.map_sub _ _
    _ = 0 := by rw [h, sub_self]

private lemma colimMap_inclusion_apply (x : ZMod 2) :
    (colimMap inclusion) ((colimit.ι trivialDiagram PUnit.unit) x) =
      (colimit.ι shearDiagram PUnit.unit) ((x, 0) : ZMod 2 × ZMod 2) := by
  have h := ConcreteCategory.congr_hom (ι_colimMap inclusion PUnit.unit) x
  rw [← comp_apply, h, comp_apply, inclusion_app, AddCommGrpCat.ofHom_apply, inclusionHom_apply]

/-- Although `inclusion` is injective in every component, the induced map on colimits is
not: it sends the class of `1` to the class of `(1, 0)`, which the shear identifies with
`0`. -/
lemma colimMap_inclusion_not_injective :
    ¬ Function.Injective (colimMap inclusion) := fun hInj =>
  colimit_ι_trivialDiagram_zero_ne_one <| hInj <| by
    rw [colimMap_inclusion_apply, colimMap_inclusion_apply,
      colimit_ι_shearDiagram_one_zero_eq_zero]
    exact map_zero _

end ShearCounterexample

/-- **Stacks 09WT (2).** The analogue of part (1) fails for `AddCommGrp`-valued diagrams:
there is a span-completing index category and a componentwise-injective natural
transformation of diagrams of abelian groups whose induced map on colimits is not
injective. -/
@[stacks 09WT "(2)"]
theorem exists_diagram_addCommGrp_colimMap_not_injective :
    ∃ (I : Type) (_ : SmallCategory I) (_ : HasSpanCocone I)
      (M N : I ⥤ AddCommGrpCat.{0}) (α : M ⟶ N)
      (_ : ∀ i : I, Function.Injective (α.app i)),
      ¬ Function.Injective (colimMap α) :=
  ⟨ShearCounterexample.SingleObjZMod2, ShearCounterexample.smallCategory,
    ShearCounterexample.hasSpanCocone, ShearCounterexample.trivialDiagram,
    ShearCounterexample.shearDiagram, ShearCounterexample.inclusion,
    ShearCounterexample.inclusion_app_injective,
    ShearCounterexample.colimMap_inclusion_not_injective⟩

end CategoryTheory.Limits
