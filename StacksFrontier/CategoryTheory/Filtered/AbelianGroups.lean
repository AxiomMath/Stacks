module

public import Mathlib.Algebra.Category.Grp.Colimits
public import Mathlib.CategoryTheory.Limits.Types.Colimits
public import StacksCore.Tactic.StacksAttribute

/-!
# Colimits of abelian groups are generated by their pieces (Stacks 09WR)

Let `I` be a category in which every pair of objects has a common upper bound and
let `M : I ⥤ AddCommGrpCat` be a diagram of abelian groups. Then the canonical map
from the colimit of the underlying sets to the underlying set of the colimit taken
in `AddCommGrpCat` is surjective: every element of the group-theoretic colimit is
already of the form `ι_w m` for a single index `w`.

The proof factors through the `AddSubgroup` of "good" elements — those in the
subgroup generated by the union of the images of the structure maps. That subgroup
carries a cocone, so the descended map splits the inclusion and the subgroup is all
of `colimit M`; closure induction then reduces to representing each generator, with
sums combined by pushing both representatives along arrows into a common upper
bound.

The hypothesis `[Nonempty I]` is a correction to the source rather than a
formalization artefact: for `I = ∅` the colimit of sets is `∅` while the colimit in
`AddCommGrpCat` is the zero group, and `∅ → {0}` is not surjective. It is exactly
the `0` of the group that needs an index to be represented at.
-/

@[expose] public section

namespace CategoryTheory.Limits

universe w v u

section Representatives

variable {I : Type u} [Category.{v} I]
variable (M : I ⥤ AddCommGrpCat.{w}) [HasColimit M]

/-- The subgroup of `colimit M` generated by the union of the images of all
structure maps `colimit.ι M i`. -/
private noncomputable def generatedSubgroup : AddSubgroup (colimit M : AddCommGrpCat) :=
  AddSubgroup.closure (⋃ i : I, Set.range (ConcreteCategory.hom (colimit.ι M i)))

/-- Each image of a structure map lies in `generatedSubgroup M`. -/
private lemma mem_generatedSubgroup_of_ι (i : I) (m : M.obj i) :
    (ConcreteCategory.hom (colimit.ι M i)) m ∈ generatedSubgroup M :=
  AddSubgroup.subset_closure (Set.mem_iUnion.mpr ⟨i, Set.mem_range_self _⟩)

/-- The structure map `colimit.ι M i` with its codomain restricted to
`generatedSubgroup M`. -/
private noncomputable def restrictedι (i : I) :
    (M.obj i : AddCommGrpCat) →+ generatedSubgroup M :=
  (ConcreteCategory.hom (colimit.ι M i)).codRestrict
    (generatedSubgroup M) (mem_generatedSubgroup_of_ι M i)

/-- Cocone commutativity at the level of elements. -/
private lemma colimit_ι_map_apply {i j : I} (f : i ⟶ j) (m : M.obj i) :
    (ConcreteCategory.hom (colimit.ι M j)) ((ConcreteCategory.hom (M.map f)) m)
      = (ConcreteCategory.hom (colimit.ι M i)) m :=
  ConcreteCategory.congr_hom (colimit.w M f) m

/-- The cocone on `M` with apex `generatedSubgroup M`. -/
private noncomputable def generatedCocone : Cocone M where
  pt := AddCommGrpCat.of (generatedSubgroup M)
  ι :=
    { app := fun i => AddCommGrpCat.ofHom (restrictedι M i)
      naturality := fun _ _ f => by
        ext m
        exact Subtype.ext (colimit_ι_map_apply M f m) }

/-- Every element of `colimit M` lies in `generatedSubgroup M`: the map descended
from `generatedCocone M`, postcomposed with the inclusion, is the identity on
`colimit M`, so `x` lies in the image of the inclusion. -/
private lemma mem_generatedSubgroup (x : (colimit M : AddCommGrpCat)) :
    x ∈ generatedSubgroup M := by
  have hId : colimit.desc M (generatedCocone M) ≫
      AddCommGrpCat.ofHom (AddSubgroup.subtype (generatedSubgroup M)) =
        𝟙 (colimit M : AddCommGrpCat) := by
    refine colimit.hom_ext fun i => ?_
    ext m
    simp [generatedCocone, restrictedι]
  have hEq := congr_arg (fun g => (ConcreteCategory.hom g) x) hId
  simp only [AddCommGrpCat.hom_id, AddMonoidHom.id_apply] at hEq
  rw [← hEq]
  exact ((ConcreteCategory.hom (colimit.desc M (generatedCocone M))) x).property

/-- Every element of `colimit M` is of the form `(colimit.ι M w) m` for a single
index `w`. -/
private lemma exists_ι_eq (i₀ : I)
    (hI : ∀ x y : I, ∃ (z : I) (_ : x ⟶ z) (_ : y ⟶ z), True)
    (g : (colimit M : AddCommGrpCat)) :
    ∃ (w : I) (m : M.obj w), g = (ConcreteCategory.hom (colimit.ι M w)) m := by
  refine AddSubgroup.closure_induction
    (p := fun x _ => ∃ (w : I) (m : M.obj w),
              x = (ConcreteCategory.hom (colimit.ι M w)) m)
    ?gen ?zero ?add ?neg (mem_generatedSubgroup M g)
  · rintro y hy
    simp only [Set.mem_iUnion, Set.mem_range] at hy
    obtain ⟨i, m, rfl⟩ := hy
    exact ⟨i, m, rfl⟩
  · exact ⟨i₀, 0, by simp⟩
  · rintro _ _ _ _ ⟨w₁, m₁, rfl⟩ ⟨w₂, m₂, rfl⟩
    obtain ⟨z, f₁, f₂, -⟩ := hI w₁ w₂
    refine ⟨z, (ConcreteCategory.hom (M.map f₁)) m₁ +
      (ConcreteCategory.hom (M.map f₂)) m₂, ?_⟩
    rw [map_add, colimit_ι_map_apply M f₁ m₁, colimit_ι_map_apply M f₂ m₂]
  · rintro _ _ ⟨w, m, rfl⟩
    exact ⟨w, -m, by simp [map_neg]⟩

end Representatives

/-- **Stacks 09WR.** Let `I` be a nonempty category in which every pair of objects
has a common upper bound. Then for any diagram `M : I ⥤ AddCommGrpCat` the canonical
comparison from the colimit of the underlying sets to the underlying set of the
colimit in `AddCommGrpCat` is surjective. -/
@[stacks 09WR]
theorem surjective_setColimit_to_addCommGrpColimit
    {I : Type u} [Category.{v} I] [Nonempty I]
    (hI : ∀ x y : I, ∃ (z : I) (_ : x ⟶ z) (_ : y ⟶ z), True)
    (M : I ⥤ AddCommGrpCat.{w})
    [HasColimit (M ⋙ forget AddCommGrpCat)] [HasColimit M] :
    Function.Surjective
      (colimit.desc (M ⋙ forget AddCommGrpCat)
        ((forget AddCommGrpCat).mapCocone (colimit.cocone M))) := by
  intro g
  obtain ⟨w, m, hwm⟩ := exists_ι_eq M (Classical.arbitrary I) hI (g : (colimit M : AddCommGrpCat))
  refine ⟨colimit.ι (M ⋙ forget AddCommGrpCat) w m, ?_⟩
  simp only [← types_comp_apply (colimit.ι (M ⋙ forget AddCommGrpCat) w) _,
    colimit.ι_desc]
  exact hwm.symm

end CategoryTheory.Limits
