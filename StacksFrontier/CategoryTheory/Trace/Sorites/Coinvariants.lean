module

public import StacksFrontier.CategoryTheory.Trace.Preliminaries.DiagonalAction
public import StacksFrontier.CategoryTheory.Trace.Sorites.Centralizer
public import StacksCore.Tactic.StacksAttribute

/-!
# The trace on coinvariants

Let a finite group `G` be the kernel of a cancellative monoid extension `Γ → ℕ`.  If a
`Λ[Γ]`-module is finite projective after restriction to `Λ[G]`, then its
`G`-coinvariants are finite projective over `Λ`.  The trace of degree one on
the coinvariants is the sum of the centralizer traces over the `G`-conjugacy
classes of degree-one elements.

## Main definitions

* `MonoidExtensionByNat` records a cancellative monoid extension of a finite group by `ℕ`.
* `coinvariants` is the quotient by the differences `g p - p` for any group representation.
* `coinvariantRepresentation` is the induced action of `ℕ` on coinvariants.

## Main results

* `coinvariants_module_finite` and `coinvariants_module_projective` give the
  finiteness and projectivity of coinvariants of any group representation.
* `trace_degreeOne_on_coinvariants` is the trace formula.

## Implementation notes

The primed sum in the source is expressed using an arbitrary finite set of
representatives, together with the assertion that it represents precisely the
degree-one conjugacy classes.  The resulting equality is therefore independent
of that choice.  Modules over possibly noncommutative group rings are obtained
from linear representations using `Representation.asModuleNC`.

## References

* [Stacks Project, Tag 03UD](https://stacks.math.columbia.edu/tag/03UD)
-/

@[expose] public noncomputable section

open scoped MonoidAlgebra BigOperators

open CategoryTheory.FilteredDerived

universe u v w x

namespace Stacks.Trace

/-- The data and exactness properties of a monoid extension
`1 → G → Γ → ℕ → 1`.  The fibre condition makes every fibre a left `G`-coset;
right cancellation makes that action free. -/
structure MonoidExtensionByNat (G : Type v) (Γ : Type w)
    [Group G] [Monoid Γ] where
  /-- The inclusion of the kernel `G` into `Γ`. -/
  inclusion : G →* Γ
  /-- The degree map `Γ → ℕ`, written multiplicatively. -/
  degree : Γ →* Multiplicative ℕ
  inclusion_injective : Function.Injective inclusion
  degree_inclusion : ∀ g, degree (inclusion g) = 1
  degree_surjective : Function.Surjective degree
  same_degree : ∀ γ δ, degree γ = degree δ ↔ ∃ g, γ = inclusion g * δ
  mul_right_cancel : ∀ a b c : Γ, a * c = b * c → a = b

variable {Λ : Type u} {G : Type v} {Γ : Type w} {P : Type x}
variable [Ring Λ] [Group G] [Monoid Γ]

/-- Scalar multiplication commutes with the action of a representation. -/
private lemma commute_toAddMonoidEnd_actionAddEnd
    [AddCommGroup P] [Module Λ P] (ρ : _root_.Representation Λ Γ P) (r : Λ) (γ : Γ) :
    Commute (Module.toAddMonoidEnd Λ P r) (Representation.actionAddEnd ρ γ) := by
  ext p
  exact ((ρ γ).map_smul r p).symm

private lemma representation_map_smul
    {R : Type u} {M : Type v} {V W : Type x} [Ring R] [Monoid M]
    [AddCommGroup V] [Module R V] [AddCommGroup W] [Module R W]
    (ρ : _root_.Representation R M V) (σ : _root_.Representation R M W)
    (f : Representation.asModuleNC ρ →ₗ[R]
      Representation.asModuleNC σ)
    (hf : ∀ m p, f (ρ m p) = σ m (f p))
    (a : R[M]) (p : Representation.asModuleNC ρ) :
      f (a • p) = a • f p :=
  Representation.map_smul_asModuleNC ρ σ f hf a p

/-- The restriction to `G` of a representation of the extension monoid. -/
abbrev restrictedRepresentation (E : MonoidExtensionByNat G Γ)
    [AddCommGroup P] [Module Λ P] (ρ : _root_.Representation Λ Γ P) :
    _root_.Representation Λ G P :=
  ρ.comp E.inclusion

/-- The submodule generated by the differences `g p - p`. -/
def coinvariantsKer
    [AddCommGroup P] [Module Λ P] (σ : _root_.Representation Λ G P) : Submodule Λ P :=
  Submodule.span Λ (Set.range fun gp : G × P =>
    σ gp.1 gp.2 - gp.2)

/-- The module of `G`-coinvariants of a representation of `G`. -/
abbrev coinvariants
    [AddCommGroup P] [Module Λ P] (σ : _root_.Representation Λ G P) :=
  P ⧸ coinvariantsKer σ

/-- The quotient map to the `G`-coinvariants. -/
def coinvariantsMk
    [AddCommGroup P] [Module Λ P] (σ : _root_.Representation Λ G P) :
    P →ₗ[Λ] coinvariants σ :=
  Submodule.mkQ (coinvariantsKer σ)

/-- The quotient map to the coinvariants is invariant under the action of `G`. -/
lemma coinvariantsMk_group_action
    [AddCommGroup P] [Module Λ P] (σ : _root_.Representation Λ G P)
    (g : G) (p : P) :
    coinvariantsMk σ (σ g p) = coinvariantsMk σ p :=
  (Submodule.Quotient.eq _).2 (Submodule.subset_span ⟨(g, p), rfl⟩)

/-- The endomorphism of the `G`-coinvariants induced by the action of an element `γ : Γ`. -/
noncomputable def coinvariantInducedMap
    (E : MonoidExtensionByNat G Γ) [AddCommGroup P] [Module Λ P]
    (ρ : _root_.Representation Λ Γ P) (γ : Γ) :
    coinvariants (restrictedRepresentation E ρ) →ₗ[Λ]
      coinvariants (restrictedRepresentation E ρ) := by
  let σ := restrictedRepresentation E ρ
  apply Submodule.liftQ (coinvariantsKer σ)
    ((coinvariantsMk σ).comp (ρ γ))
  apply Submodule.span_le.2
  rintro _ ⟨⟨g, p⟩, rfl⟩
  change coinvariantsMk σ (ρ γ (σ g p - p)) = 0
  rw [map_sub, LinearMap.map_sub]
  apply sub_eq_zero.mpr
  obtain ⟨g', hg'⟩ := (E.same_degree (γ * E.inclusion g) γ).mp (by
    rw [map_mul, E.degree_inclusion]
    simp)
  have hact : ρ γ (σ g p) = σ g' (ρ γ p) := by
    change ρ γ (ρ (E.inclusion g) p) = ρ (E.inclusion g') (ρ γ p)
    calc
      ρ γ (ρ (E.inclusion g) p) = ρ (γ * E.inclusion g) p := by
        rw [map_mul]
        rfl
      _ = ρ (E.inclusion g' * γ) p := by rw [hg']
      _ = ρ (E.inclusion g') (ρ γ p) := by
        rw [map_mul]
        rfl
  rw [hact, coinvariantsMk_group_action]

/-- The map induced by `γ` sends the class of `p` to the class of `ρ γ p`. -/
lemma coinvariantInducedMap_mk
    (E : MonoidExtensionByNat G Γ) [AddCommGroup P] [Module Λ P]
    (ρ : _root_.Representation Λ Γ P) (γ : Γ) (p : P) :
    coinvariantInducedMap E ρ γ
      (coinvariantsMk (restrictedRepresentation E ρ) p) =
        coinvariantsMk (restrictedRepresentation E ρ) (ρ γ p) := rfl

/-- The canonical action of the quotient monoid `ℕ` on the coinvariants.  Its
specification records compatibility with every lift in `Γ`. -/
@[stacks 03UD "the action on coinvariants", sga "4½ Rapport 5.10" "action of G^+ on P_H"]
noncomputable def coinvariantRepresentation (E : MonoidExtensionByNat G Γ)
    [AddCommGroup P] [Module Λ P] (ρ : _root_.Representation Λ Γ P) :
    { σ : _root_.Representation Λ (Multiplicative ℕ)
        (coinvariants (restrictedRepresentation E ρ)) //
      ∀ (γ : Γ) (p : P),
        σ (E.degree γ) (coinvariantsMk (restrictedRepresentation E ρ) p) =
          coinvariantsMk (restrictedRepresentation E ρ) (ρ γ p) } := by
  classical
  let t := Classical.choose (E.degree_surjective (.ofAdd 1))
  have ht : E.degree t = .ofAdd 1 := Classical.choose_spec (E.degree_surjective (.ofAdd 1))
  let T := coinvariantInducedMap E ρ t
  let R : _root_.Representation Λ (Multiplicative ℕ)
      (coinvariants (restrictedRepresentation E ρ)) :=
    { toFun := fun n => T ^ n.toAdd
      map_one' := by simp
      map_mul' := by
        intro a b
        rw [toAdd_mul, pow_add] }
  refine ⟨R, ?_⟩
  intro γ p
  have hpow : ∀ n : ℕ, ∀ p : P,
      (T ^ n) (coinvariantsMk (restrictedRepresentation E ρ) p) =
        coinvariantsMk (restrictedRepresentation E ρ) (ρ (t ^ n) p) := by
    intro n
    induction n with
    | zero => intro p; simp
    | succ n ih =>
        intro p
        rw [pow_succ', Module.End.mul_apply, ih, coinvariantInducedMap_mk]
        rw [pow_succ', map_mul, Module.End.mul_apply]
  have hdegree : E.degree (t ^ (E.degree γ).toAdd) = E.degree γ := by
    rw [map_pow, ht]
    have hn : (Multiplicative.ofAdd 1 : Multiplicative ℕ) ^ (E.degree γ).toAdd =
        Multiplicative.ofAdd (E.degree γ).toAdd := by
      induction (E.degree γ).toAdd with
      | zero => rfl
      | succ n ih => rw [pow_succ, ih]; rfl
    rw [hn]
    rfl
  obtain ⟨g, hγ⟩ := (E.same_degree γ (t ^ (E.degree γ).toAdd)).mp hdegree.symm
  change (T ^ (E.degree γ).toAdd)
    (coinvariantsMk (restrictedRepresentation E ρ) p) = _
  rw [hpow]
  have haction : ρ γ p = (restrictedRepresentation E ρ) g
      (ρ (t ^ (E.degree γ).toAdd) p) := by
    have hh := congrArg (fun z => ρ z p) hγ
    change ρ γ p = ρ (E.inclusion g) (ρ (t ^ (E.degree γ).toAdd) p)
    simpa only [map_mul, Module.End.mul_apply] using hh
  rw [haction, coinvariantsMk_group_action]

private noncomputable def representationActionHom
    [AddCommGroup P] [Module Λ P] (ρ : _root_.Representation Λ Γ P) :
    Λ[Γ] →+* AddMonoid.End P := by
  exact MonoidAlgebra.liftNCRingHom (Module.toAddMonoidEnd Λ P)
    (Representation.actionAddEnd ρ) (commute_toAddMonoidEnd_actionAddEnd ρ)

@[instance_reducible] private noncomputable def representationMonoidAlgebraModule
    [AddCommGroup P] [Module Λ P] (ρ : _root_.Representation Λ Γ P) : Module Λ[Γ] P :=
  Module.compHom P (representationActionHom ρ)

private lemma representation_restricted_actionHom
    [AddCommGroup P] [Module Λ P] (ρ : _root_.Representation Λ Γ P) (i : G →* Γ) :
    MonoidAlgebra.liftNCRingHom (Module.toAddMonoidEnd Λ P)
      (Representation.actionAddEnd (ρ.comp i))
      (commute_toAddMonoidEnd_actionAddEnd (ρ.comp i)) =
      (MonoidAlgebra.liftNCRingHom (Module.toAddMonoidEnd Λ P)
        (Representation.actionAddEnd ρ) (commute_toAddMonoidEnd_actionAddEnd ρ)).comp
        (MonoidAlgebra.mapDomainRingHom Λ i) := by
  apply MonoidAlgebra.ringHom_ext
  · intro r
    simp [MonoidAlgebra.mapDomainRingHom, MonoidAlgebra.liftNCRingHom_single]
  · intro g
    simp [MonoidAlgebra.mapDomainRingHom, MonoidAlgebra.liftNCRingHom_single,
      Representation.actionAddEnd]
    rfl

private noncomputable def representation_restricted_equiv
    [AddCommGroup P] [Module Λ P]
    (ρ : _root_.Representation Λ Γ P) (i : G →* Γ)
    [instM : Module Λ[Γ] P]
    (instS : Module Λ[G] (Representation.asModuleNC (ρ.comp i)))
    (instT : Module Λ[G] (restrictedModule Λ P i))
    (hS : instS = Representation.asModuleNC.moduleMonoidAlgebra (ρ.comp i))
    (hT : instT = restrictedModule.module i)
    (hM : instM = representationMonoidAlgebraModule ρ) :
    @LinearEquiv (Λ[G]) (Λ[G]) _ _ (RingHom.id _) (RingHom.id _) _ _
      (Representation.asModuleNC (ρ.comp i))
      (restrictedModule Λ P i) _ _ instS instT := by
  cases hM
  cases hS
  cases hT
  refine
    { toFun := fun p => p
      invFun := fun p => p
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_add' := fun _ _ => rfl
      map_smul' := ?_ }
  intro a p
  have h := representation_restricted_actionHom ρ i
  change (representationActionHom (ρ.comp i) a) (p : P) =
    (representationActionHom ρ (MonoidAlgebra.mapDomainRingHom Λ i a)) (p : P)
  exact congrArg (fun F : Λ[G] →+* AddMonoid.End P => F a (p : P)) h


/-- Restriction from `G` to a subgroup preserves finite generation for a
finite group. -/
lemma MonoidExtensionByNat.restricted_module_finite [Finite G] (E : MonoidExtensionByNat G Γ)
    [AddCommGroup P] [Module Λ P] (ρ : _root_.Representation Λ Γ P)
    [Module.Finite Λ[G] (Representation.asModuleNC
      (restrictedRepresentation E ρ))]
    (H : Subgroup G) :
    Module.Finite Λ[H] (Representation.asModuleNC
      (ρ.comp (E.inclusion.comp H.subtype))) := by
  let : Module Λ[Γ] P := representationMonoidAlgebraModule ρ
  let σ := restrictedRepresentation E ρ
  let e := representation_restricted_equiv ρ E.inclusion
    (Representation.asModuleNC.moduleMonoidAlgebra
      (restrictedRepresentation E ρ))
    (restrictedModule.module E.inclusion) rfl rfl rfl
  let : Module.Finite Λ[G] (restrictedModule Λ P E.inclusion) :=
    Module.Finite.equiv e
  have h := _root_.Stacks.Trace.restricted_module_finite (Λ := Λ) (G := G) (Γ := Γ)
    (P := P) E.inclusion H
  let : Module.Finite Λ[H]
      (restrictedModule Λ P (E.inclusion.comp H.subtype)) := h
  exact Module.Finite.equiv
    (representation_restricted_equiv ρ (E.inclusion.comp H.subtype)
      (Representation.asModuleNC.moduleMonoidAlgebra
        (ρ.comp (E.inclusion.comp H.subtype)))
      (restrictedModule.module (E.inclusion.comp H.subtype)) rfl rfl rfl).symm

/-- Restriction from `G` to a subgroup preserves projectivity for a finite
group. -/
@[sga "4½ Rapport 5.9" "partial"]
lemma MonoidExtensionByNat.restricted_module_projective [Finite G] (E : MonoidExtensionByNat G Γ)
    [AddCommGroup P] [Module Λ P] (ρ : _root_.Representation Λ Γ P)
    [Module.Projective Λ[G] (Representation.asModuleNC
      (restrictedRepresentation E ρ))]
    (H : Subgroup G) :
    Module.Projective Λ[H] (Representation.asModuleNC
      (ρ.comp (E.inclusion.comp H.subtype))) := by
  let : Module Λ[Γ] P := representationMonoidAlgebraModule ρ
  let e := representation_restricted_equiv ρ E.inclusion
    (Representation.asModuleNC.moduleMonoidAlgebra
      (restrictedRepresentation E ρ))
    (restrictedModule.module E.inclusion) rfl rfl rfl
  let : Module.Projective Λ[G] (restrictedModule Λ P E.inclusion) :=
    Module.Projective.of_equiv e
  have h := _root_.Stacks.Trace.restricted_module_projective (Λ := Λ) (G := G) (Γ := Γ)
    (P := P) E.inclusion H
  let : Module.Projective Λ[H]
      (restrictedModule Λ P (E.inclusion.comp H.subtype)) := h
  exact Module.Projective.of_equiv
    (representation_restricted_equiv ρ (E.inclusion.comp H.subtype)
      (Representation.asModuleNC.moduleMonoidAlgebra
        (ρ.comp (E.inclusion.comp H.subtype)))
      (restrictedModule.module (E.inclusion.comp H.subtype)) rfl rfl rfl).symm

/-- The action of a centralizing element is linear over the corresponding
centralizer group ring. -/
noncomputable def MonoidExtensionByNat.centralizerEndomorphism (E : MonoidExtensionByNat G Γ)
    [AddCommGroup P] [Module Λ P] (ρ : _root_.Representation Λ Γ P) (γ : Γ) :
    { f : Module.End Λ[centralizer E.inclusion γ]
      (Representation.asModuleNC
          (ρ.comp (E.inclusion.comp (centralizer E.inclusion γ).subtype))) //
      ∀ p : P, f p = ρ γ p } := by
  let H := centralizer E.inclusion γ
  let σ : _root_.Representation Λ H P := ρ.comp (E.inclusion.comp H.subtype)
  letI : Module Λ[H] (Representation.asModuleNC σ) :=
    Representation.asModuleNC.moduleMonoidAlgebra σ
  let f : Module.End Λ[H] (Representation.asModuleNC σ) :=
    { ρ γ with
      map_smul' := by
        intro a p
        apply representation_map_smul σ σ (ρ γ)
          (fun h x => by
            change ρ γ (ρ (E.inclusion h) x) = ρ (E.inclusion h) (ρ γ x)
            have hc : E.inclusion h * γ = γ * E.inclusion h := h.property
            have heq := congrArg (fun z => ρ z x) hc.symm
            simpa only [map_mul, Module.End.mul_apply] using heq) a p }
  exact ⟨f, fun p => rfl⟩

/-- The centralizer trace occurring in the trace formula. -/
noncomputable def MonoidExtensionByNat.centralizerTrace [Finite G] (E : MonoidExtensionByNat G Γ)
    [AddCommGroup P] [Module Λ P] (ρ : _root_.Representation Λ Γ P)
    [Module.Finite Λ[G] (Representation.asModuleNC
      (restrictedRepresentation E ρ))]
    [Module.Projective Λ[G] (Representation.asModuleNC
      (restrictedRepresentation E ρ))] (γ : Γ) :
    AdditiveCommutatorQuotient Λ := by
  let H := centralizer E.inclusion γ
  let σ : _root_.Representation Λ H P := ρ.comp (E.inclusion.comp H.subtype)
  letI : Module Λ[H] P :=
    Representation.asModuleNC.moduleMonoidAlgebra σ
  letI : Module.Finite Λ[H] P := MonoidExtensionByNat.restricted_module_finite E ρ H
  letI : Module.Projective Λ[H] P := MonoidExtensionByNat.restricted_module_projective E ρ H
  exact groupTrace Λ H P (MonoidExtensionByNat.centralizerEndomorphism E ρ γ).val

/-- A finite set containing exactly one representative of every `G`-conjugacy
class of elements of degree `n`. -/
def IsConjugacyClassRepresentatives (E : MonoidExtensionByNat G Γ)
    (n : Multiplicative ℕ) (S : Finset Γ) : Prop :=
  (∀ γ ∈ S, E.degree γ = n) ∧
    ∀ γ, E.degree γ = n → ∃! δ, δ ∈ S ∧
      ∃ g : G, δ = E.inclusion g * γ * E.inclusion g⁻¹

private noncomputable def representation_asModuleNC_equiv
    [AddCommGroup P] [Module Λ P] (σ : _root_.Representation Λ G P) :
    letI : Module Λ[G] P := representationMonoidAlgebraModule σ
    Representation.asModuleNC σ ≃ₗ[Λ[G]] P := by
  letI : Module Λ[G] P := representationMonoidAlgebraModule σ
  letI : Module Λ[G] (Representation.asModuleNC σ) :=
    Representation.asModuleNC.moduleMonoidAlgebra σ
  exact
    { toFun := fun p => p
      invFun := fun p => p
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl
      map_add' := fun _ _ => rfl
      map_smul' := by intro a p; rfl }

private def monoidAlgebraAugmentation : Λ[G] →ₗ[Λ] Λ where
  toFun a := a.coeff.sum fun _ r => r
  map_add' a b := Finsupp.sum_add_index' (by intro; simp) (by intro; simp)
  map_smul' r a := by
    change (r • a.coeff).sum (fun _ t => t) = r * a.coeff.sum (fun _ t => t)
    rw [Finsupp.sum_smul_index (h0 := by intro; simp)]
    change (∑ i ∈ a.coeff.support, r * a.coeff i) =
      r * ∑ i ∈ a.coeff.support, a.coeff i
    rw [← Finset.mul_sum]

private def groupHomOne : G →* Λ where
  toFun _ := 1
  map_one' := rfl
  map_mul' _ _ := by simp

private def monoidAlgebraAugmentationRingHom : Λ[G] →+* Λ :=
  MonoidAlgebra.liftNCRingHom (RingHom.id Λ) (groupHomOne (Λ := Λ) (G := G))
    (by
      intro r g
      change Commute r (1 : Λ)
      exact Commute.one_right r)

private lemma monoidAlgebraAugmentationRingHom_single (g : G) (r : Λ) :
    monoidAlgebraAugmentationRingHom (Λ := Λ) (G := G)
      (MonoidAlgebra.single g r) = r := by
  unfold monoidAlgebraAugmentationRingHom
  rw [MonoidAlgebra.liftNCRingHom_single]
  simp [groupHomOne]

omit [Group G] in
private lemma monoidAlgebraAugmentation_single (g : G) (r : Λ) :
    monoidAlgebraAugmentation (Λ := Λ) (G := G) (MonoidAlgebra.single g r) = r := by
  change (Finsupp.single g r).sum (fun _ t => t) = r
  simp

/-- Scalar multiplication on a monoid algebra is left multiplication by a constant. -/
private lemma smul_eq_single_one_mul {R M : Type*} [Semiring R] [Monoid M] (r : R) (a : R[M]) :
    r • a = MonoidAlgebra.single 1 r * a := by
  ext m
  simp [MonoidAlgebra.coeff_single_one_mul]

private lemma monoidAlgebraAugmentationRingHom_apply (a : Λ[G]) :
    monoidAlgebraAugmentationRingHom (Λ := Λ) (G := G) a =
      monoidAlgebraAugmentation (Λ := Λ) (G := G) a := by
  induction a using MonoidAlgebra.induction_on with
  | of g =>
      rw [MonoidAlgebra.of_apply, monoidAlgebraAugmentationRingHom_single,
        monoidAlgebraAugmentation_single]
  | add a b ha hb =>
      rw [map_add, monoidAlgebraAugmentation.map_add, ha, hb]
  | smul r a ha =>
      rw [smul_eq_single_one_mul, map_mul, monoidAlgebraAugmentationRingHom_single, ha,
        ← smul_eq_single_one_mul, monoidAlgebraAugmentation.map_smul]
      simp [smul_eq_mul]

private lemma representationGroup_smul
    [AddCommGroup P] [Module Λ P] (σ : _root_.Representation Λ G P) :
    letI : Module Λ[G] P := representationMonoidAlgebraModule σ
    ∀ g (p : P), (MonoidAlgebra.of Λ G g : Λ[G]) • p = σ g p := fun g p =>
  (Representation.single_smul_asModuleNC σ 1 g p).trans (one_smul Λ _)

private lemma representationScalar_smul
    [AddCommGroup P] [Module Λ P] (σ : _root_.Representation Λ G P) :
    letI : Module Λ[G] P := representationMonoidAlgebraModule σ
    ∀ r (p : P), (MonoidAlgebra.single 1 r : Λ[G]) • p = r • p := fun r p =>
  (Representation.single_smul_asModuleNC σ r 1 p).trans (by rw [map_one]; rfl)

private lemma coinvariants_groupRing_smul
    [AddCommGroup P] [Module Λ P] (σ : _root_.Representation Λ G P) :
    letI : Module Λ[G] P := representationMonoidAlgebraModule σ
    ∀ (a : Λ[G]) (p : P),
      coinvariantsMk σ (a • p) = monoidAlgebraAugmentation (Λ := Λ) (G := G) a •
        coinvariantsMk σ p := by
  let : Module Λ[G] P := representationMonoidAlgebraModule σ
  intro a p
  induction a using MonoidAlgebra.induction_on with
  | of g =>
      rw [MonoidAlgebra.of_apply, ← MonoidAlgebra.of_apply, representationGroup_smul,
        coinvariantsMk_group_action, MonoidAlgebra.of_apply, monoidAlgebraAugmentation_single,
        one_smul]
  | add a b ha hb =>
      rw [add_smul, LinearMap.map_add, ha, hb,
        monoidAlgebraAugmentation.map_add, add_smul]
  | smul r a ha =>
      rw [smul_eq_single_one_mul, mul_smul, representationScalar_smul, LinearMap.map_smul, ha,
        ← monoidAlgebraAugmentationRingHom_apply (MonoidAlgebra.single 1 r * a), map_mul,
        monoidAlgebraAugmentationRingHom_single, monoidAlgebraAugmentationRingHom_apply,
        smul_smul]

/-- The coinvariants of a finite `Λ[G]`-projective representation are finite
over `Λ`. -/
@[stacks 03UD "finiteness of the coinvariants"]
lemma coinvariants_module_finite
    [AddCommGroup P] [Module Λ P] (σ : _root_.Representation Λ G P)
    [Module.Finite Λ[G] (Representation.asModuleNC
      σ)] :
    Module.Finite Λ (coinvariants σ) := by
  classical
  let : Module Λ[G] P :=
    representationMonoidAlgebraModule σ
  let : Module.Finite Λ[G] P :=
    Module.Finite.equiv (representation_asModuleNC_equiv σ)
  have hfg : (⊤ : Submodule Λ[G] P).FG :=
    (inferInstance : Module.Finite Λ[G] P).fg_top
  obtain ⟨s, hs⟩ := hfg
  let U : Finset (coinvariants σ) := s.image (fun p => coinvariantsMk σ p)
  let T : Submodule Λ (coinvariants σ) :=
    Submodule.span Λ (U : Set (coinvariants σ))
  have hT : T = ⊤ := by
    apply top_unique
    intro q _
    obtain ⟨p, rfl⟩ := (Submodule.mkQ_surjective (coinvariantsKer σ)) q
    have hp : p ∈ Submodule.span Λ[G] (s : Set P) := hs ▸ Submodule.mem_top
    change coinvariantsMk σ p ∈ T
    apply Submodule.span_induction
      (p := fun x _ => coinvariantsMk σ x ∈ T)
      (mem := by
        intro x hx
        apply Submodule.subset_span
        exact Finset.mem_image.mpr ⟨x, hx, rfl⟩)
      (zero := T.zero_mem)
      (add := by
        intro x y hx hy h₁ h₂
        rw [map_add]
        exact T.add_mem h₁ h₂)
      (smul := by
        intro a x hx h
        rw [coinvariants_groupRing_smul]
        exact T.smul_mem (monoidAlgebraAugmentation (Λ := Λ) (G := G) a) h)
      hp
  change Module.Finite Λ (coinvariants σ)
  apply Module.Finite.of_fg_top
  rw [← hT]
  exact ⟨U, rfl⟩

private def coinvariantsLift {Q : Type*}
    [AddCommGroup P] [Module Λ P] [AddCommGroup Q] [Module Λ Q]
    (σ : _root_.Representation Λ G P) (f : P →ₗ[Λ] Q)
    (hf : ∀ g p, f (σ g p) = f p) : coinvariants σ →ₗ[Λ] Q := by
  apply Submodule.liftQ (coinvariantsKer σ) f
  apply Submodule.span_le.2
  rintro _ ⟨⟨g, p⟩, rfl⟩
  change f (σ g p - p) = 0
  rw [map_sub, hf]
  exact sub_eq_zero.mpr rfl

@[instance_reducible] private noncomputable def cosetQuotientFintype [Finite G]
    (H : Subgroup G) :
    Fintype (Quotient (QuotientGroup.rightRel H)) := by
  classical
  letI : Fintype G := Fintype.ofFinite G
  exact Quotient.fintype (QuotientGroup.rightRel H)

/-- The coinvariants of a finite `Λ[G]`-projective representation are
projective over `Λ`. -/
@[stacks 03UD "projectivity of the coinvariants", sga "4½ Rapport 5.10" "P_H projective over Λ"]
lemma coinvariants_module_projective
    [AddCommGroup P] [Module Λ P] (σ : _root_.Representation Λ G P)
    [Module.Projective Λ[G] (Representation.asModuleNC
      σ)] :
    Module.Projective Λ (coinvariants σ) := by
  classical
  let : Module Λ[G] P := representationMonoidAlgebraModule σ
  have : Module.Projective Λ[G] P :=
    Module.Projective.of_equiv (representation_asModuleNC_equiv σ)
  apply Module.Projective.of_lifting_property''
  intro f hf
  let M := (coinvariants σ →₀ Λ)
  let : Module Λ[G] M :=
    Module.compHom M (monoidAlgebraAugmentationRingHom (Λ := Λ) (G := G))
  let : Module Λ[G] (coinvariants σ) :=
    Module.compHom (coinvariants σ)
      (monoidAlgebraAugmentationRingHom (Λ := Λ) (G := G))
  let g₀ : P →ₗ[Λ[G]] coinvariants σ :=
    { toFun := coinvariantsMk σ
      map_add' := (coinvariantsMk σ).map_add
      map_smul' := by
        intro a p
        rw [coinvariants_groupRing_smul σ a p]
        change monoidAlgebraAugmentation (Λ := Λ) (G := G) a •
          coinvariantsMk σ p =
            monoidAlgebraAugmentationRingHom (Λ := Λ) (G := G) a •
              coinvariantsMk σ p
        rw [← monoidAlgebraAugmentationRingHom_apply] }
  let f₀ : M →ₗ[Λ[G]] coinvariants σ :=
    { toFun := f
      map_add' := f.map_add
      map_smul' := by
        intro a m
        change f (monoidAlgebraAugmentationRingHom (Λ := Λ) (G := G) a • m) = _
        exact f.map_smul _ _ }
  obtain ⟨h, hh⟩ := Module.projective_lifting_property f₀ g₀ hf
  let hΛ : P →ₗ[Λ] M :=
    { toFun := h
      map_add' := h.map_add
      map_smul' := by
        intro r p
        calc
          h (r • p) = h ((MonoidAlgebra.single 1 r : Λ[G]) • p) := by
            rw [representationScalar_smul]
          _ = (MonoidAlgebra.single 1 r : Λ[G]) • h p := h.map_smul _ _
          _ = r • h p := by
            change monoidAlgebraAugmentationRingHom (Λ := Λ) (G := G)
              (MonoidAlgebra.single 1 r) • h p = r • h p
            rw [monoidAlgebraAugmentationRingHom_single] }
  have hcompat : ∀ g p, hΛ (σ g p) = hΛ p := by
    intro g p
    calc
      hΛ (σ g p) = hΛ ((MonoidAlgebra.of Λ G g : Λ[G]) • p) := by
        rw [representationGroup_smul]
      _ = (MonoidAlgebra.of Λ G g : Λ[G]) • hΛ p := h.map_smul _ _
      _ = hΛ p := by
        change monoidAlgebraAugmentationRingHom (Λ := Λ) (G := G)
          (MonoidAlgebra.of Λ G g) • hΛ p = hΛ p
        rw [MonoidAlgebra.of_apply, monoidAlgebraAugmentationRingHom_single, one_smul]
  let hbar := coinvariantsLift σ hΛ hcompat
  refine ⟨hbar, ?_⟩
  apply LinearMap.ext
  intro q
  obtain ⟨p, rfl⟩ := (Submodule.mkQ_surjective (coinvariantsKer σ)) q
  change f (h p) = coinvariantsMk σ p
  exact congrArg (fun k : P →ₗ[Λ[G]] coinvariants σ => k p) hh

omit [Group G] in
private lemma monoidAlgebra_eq_sum [Fintype G] (a : Λ[G]) :
    a = ∑ g, MonoidAlgebra.single g (a.coeff g) := by
  classical
  ext g
  simp

private lemma module_smul_sum [Fintype G]
    [AddCommGroup P] [Module Λ P] [Module Λ[G] P]
    (σ : _root_.Representation Λ G P)
    (hs : ∀ g r (p : P), (MonoidAlgebra.single g r : Λ[G]) • p = r • σ g p)
    (a : Λ[G]) (p : P) : a • p = ∑ g, a.coeff g • σ g p := by
  conv_lhs => rw [monoidAlgebra_eq_sum a]
  rw [Finset.sum_smul]
  simp only [hs]

private lemma exists_equivariant_coordinates [Fintype G]
    [AddCommGroup P] [Module Λ P] (σ : _root_.Representation Λ G P)
    [Module.Finite Λ[G] (Representation.asModuleNC σ)]
    [Module.Projective Λ[G] (Representation.asModuleNC σ)] :
    ∃ (n : ℕ) (b : Fin n → P) (c : P →ₗ[Λ] (Fin n → Λ[G])),
      (∀ g p j, c (σ g p) j = MonoidAlgebra.single g 1 * c p j) ∧
      (∀ p, ∑ j, ∑ g, (c p j).coeff g • σ g (b j) = p) := by
  classical
  let : Module Λ[G] P := representationMonoidAlgebraModule σ
  have : Module.Finite Λ[G] P := Module.Finite.equiv (representation_asModuleNC_equiv σ)
  have : Module.Projective Λ[G] P := Module.Projective.of_equiv (representation_asModuleNC_equiv σ)
  have hs (g : G) (r : Λ) (x : P) :
      (MonoidAlgebra.single g r : Λ[G]) • x = r • σ g x := by
    exact Representation.single_smul_asModuleNC σ r g x
  obtain ⟨n, p, i, _, _, hpi⟩ := Module.Finite.exists_comp_eq_id_of_projective Λ[G] P
  let b : Fin n → P := fun j => p (standardBasisVector Λ[G] (Fin n) j)
  let c : P →ₗ[Λ] (Fin n → Λ[G]) :=
    { toFun := i
      map_add' := i.map_add
      map_smul' := by
        intro r x
        have h := i.map_smul (MonoidAlgebra.single 1 r) x
        rw [hs, map_one] at h
        change i (r • x) = _ at h
        funext j
        apply MonoidAlgebra.ext
        apply Finsupp.ext
        intro g
        have hj := congrArg (fun v : Fin n → Λ[G] => (v j).coeff g) h
        simpa only [Pi.smul_apply, smul_eq_mul, MonoidAlgebra.coeff_single_one_mul,
          MonoidAlgebra.coeff_smul, Finsupp.smul_apply, RingHom.id_apply] using hj }
  refine ⟨n, b, c, ?_, ?_⟩
  · intro g x j
    have h := congrFun (i.map_smul (MonoidAlgebra.single g 1) x) j
    change i (σ g x) j = MonoidAlgebra.single g 1 * i x j
    simpa only [hs, one_smul, Pi.smul_apply, smul_eq_mul] using h
  · intro x
    have hx := congrArg p (standardBasisVector_decomp Λ[G] (Fin n) (i x))
    rw [map_sum] at hx
    simp only [map_smul, module_smul_sum σ hs] at hx
    exact hx.symm.trans (congrArg (fun f : P →ₗ[Λ[G]] P => f x) hpi)

private def cosetCoefficients (H : Subgroup G) (k : G) : Λ[G] →ₗ[Λ] Λ[H] where
  toFun a := MonoidAlgebra.comapDomain (fun h : H => (h : G) * k)
    (fun _ _ h => Subtype.ext (mul_right_cancel h)) a
  map_add' a b := MonoidAlgebra.comapDomain_add _ _ a b
  map_smul' r a := by
    ext h
    change (r • a).coeff ((h : G) * k) = r * a.coeff ((h : G) * k)
    rfl

private lemma cosetCoefficients_coeff (H : Subgroup G) (k : G) (a : Λ[G]) (h : H) :
    (cosetCoefficients H k a).coeff h = a.coeff ((h : G) * k) := rfl

private lemma subgroup_trace_coordinates [Fintype G]
    [AddCommGroup P] [Module Λ P] (σ : _root_.Representation Λ G P)
    {ι : Type*} [Fintype ι] (b : ι → P) (c : P →ₗ[Λ] (ι → Λ[G]))
    (hc : ∀ g p j, c (σ g p) j = MonoidAlgebra.single g 1 * c p j)
    (hb : ∀ p, ∑ j, ∑ g, (c p j).coeff g • σ g (b j) = p)
    (H : Subgroup G) [Fintype (Quotient (QuotientGroup.rightRel H))]
    [Module Λ[H] P] [Module.Finite Λ[H] P] [Module.Projective Λ[H] P]
    (hs : ∀ h r (p : P), (MonoidAlgebra.single h r : Λ[H]) • p = r • σ h p)
    (f : Module.End Λ[H] P) :
    groupTrace Λ H P f =
      additiveCommutatorQuotientMk Λ
        (∑ j, ∑ q : Quotient (QuotientGroup.rightRel H),
          (c (f (σ q.out (b j))) j).coeff q.out) := by
  classical
  let : Fintype H := Fintype.ofFinite H
  let τ := σ.comp H.subtype
  let V := P
  let κ := ι × Quotient (QuotientGroup.rightRel H)
  let i : V →ₗ[Λ[H]] (κ → Λ[H]) :=
    { toFun := fun p z => cosetCoefficients H z.2.out (c p z.1)
      map_add' := by
        intro x y
        ext z h
        simp only [cosetCoefficients_coeff, map_add, Pi.add_apply,
          MonoidAlgebra.coeff_add, Finsupp.add_apply]
      map_smul' := by
        intro a p
        induction a using MonoidAlgebra.induction_on with
        | of h =>
          ext z l
          simp only [MonoidAlgebra.of_apply, hs, one_smul]
          change (cosetCoefficients H z.2.out (c (σ h p) z.1)).coeff l =
            (MonoidAlgebra.single h 1 * cosetCoefficients H z.2.out (c p z.1)).coeff l
          simp [cosetCoefficients_coeff, hc, mul_assoc]
        | add a a' ha ha' =>
          ext z h
          have h1 := congrArg (fun v : κ → Λ[H] => (v z).coeff h) ha
          have h2 := congrArg (fun v : κ → Λ[H] => (v z).coeff h) ha'
          simpa only [add_smul, map_add, Pi.add_apply, MonoidAlgebra.coeff_add,
            Finsupp.add_apply] using congrArg₂ (· + ·) h1 h2
        | smul r a ha =>
          rw [smul_eq_single_one_mul, mul_smul, hs, OneMemClass.coe_one, map_one]
          change (fun z : κ => cosetCoefficients H z.2.out (c (r • (a • p)) z.1)) = _
          rw [map_smul]
          ext z h
          have hh := congrArg (fun v : κ → Λ[H] => (v z).coeff h) ha
          simpa only [Pi.smul_apply, map_smul, MonoidAlgebra.coeff_smul,
            Finsupp.smul_apply, smul_eq_mul, mul_smul,
            RingHom.id_apply, mul_assoc, MonoidAlgebra.coeff_single_one_mul]
            using congrArg (r * ·) hh }
  let p : (κ → Λ[H]) →ₗ[Λ[H]] V :=
    Fintype.linearCombination Λ[H] (fun z : κ => σ z.2.out (b z.1))
  have hpi : p.comp i = LinearMap.id := by
    ext x
    change (∑ z : κ, cosetCoefficients H z.2.out (c x z.1) • σ z.2.out (b z.1)) = x
    simp only [module_smul_sum τ hs, cosetCoefficients_coeff]
    change (∑ z : κ, ∑ h : H, (c x z.1).coeff ((h : G) * z.2.out) •
      σ h (σ z.2.out (b z.1))) = x
    rw [Fintype.sum_prod_type]
    have hact (h : H) (k : G) (y : P) : σ h (σ k y) = σ ((h : G) * k) y := by
      rw [map_mul]; rfl
    simp only [hact]
    calc
      _ = ∑ j, ∑ g, (c x j).coeff g • σ g (b j) :=
        Finset.sum_congr rfl (fun j _ => Subgroup.sum_coset_representatives H
          (fun g => (c x j).coeff g • σ g (b j)))
      _ = x := hb x
  rw [groupTrace_eq_coeff_sum Λ H V p i hpi f]
  congr 1
  rw [Fintype.sum_prod_type]
  apply Finset.sum_congr rfl
  intro j _
  apply Finset.sum_congr rfl
  intro q _
  have hp : p (standardBasisVector Λ[H] κ (j, q)) = σ q.out (b j) := by
    simp only [p, standardBasisVector, Fintype.linearCombination_apply_single, one_smul]
  rw [hp]
  change (cosetCoefficients H q.out (c (f (σ q.out (b j))) j)).coeff 1 = _
  rw [cosetCoefficients_coeff, OneMemClass.coe_one, one_mul]

omit [Group G] in
private lemma augmentation_eq_sum [Fintype G] (a : Λ[G]) :
    monoidAlgebraAugmentation (Λ := Λ) (G := G) a = ∑ g, a.coeff g := by
  conv_lhs => rw [monoidAlgebra_eq_sum a]
  rw [map_sum]
  simp only [monoidAlgebraAugmentation_single]

private lemma coinvariants_trace_coordinates [Fintype G]
    [AddCommGroup P] [Module Λ P] (σ : _root_.Representation Λ G P)
    {ι : Type*} [Fintype ι] (b : ι → P) (c : P →ₗ[Λ] (ι → Λ[G]))
    (hc : ∀ g p j, c (σ g p) j = MonoidAlgebra.single g 1 * c p j)
    (hb : ∀ p, ∑ j, ∑ g, (c p j).coeff g • σ g (b j) = p)
    [Module.Finite Λ (coinvariants σ)] [Module.Projective Λ (coinvariants σ)]
    (f : Module.End Λ (coinvariants σ)) (T : Module.End Λ P)
    (hf : ∀ p, f (coinvariantsMk σ p) = coinvariantsMk σ (T p)) :
    projectiveModuleTrace Λ (coinvariants σ) f =
      additiveCommutatorQuotientMk Λ (∑ j, ∑ g, (c (T (b j)) j).coeff g) := by
  classical
  let a : P →ₗ[Λ] (ι → Λ) := LinearMap.pi fun j =>
    (monoidAlgebraAugmentation (Λ := Λ) (G := G)).comp ((LinearMap.proj j).comp c)
  have ha : ∀ g p, a (σ g p) = a p := by
    intro g x
    ext j
    change monoidAlgebraAugmentation (c (σ g x) j) = monoidAlgebraAugmentation (c x j)
    rw [hc, ← monoidAlgebraAugmentationRingHom_apply,
      map_mul, monoidAlgebraAugmentationRingHom_single, one_mul,
      monoidAlgebraAugmentationRingHom_apply]
  let i := coinvariantsLift σ a ha
  let p := Fintype.linearCombination Λ (fun j => coinvariantsMk σ (b j))
  have hpi : p.comp i = LinearMap.id := by
    apply LinearMap.ext
    intro q
    obtain ⟨x, rfl⟩ := (coinvariantsKer σ).mkQ_surjective q
    change (∑ j, monoidAlgebraAugmentation (c x j) • coinvariantsMk σ (b j)) = coinvariantsMk σ x
    simp_rw [augmentation_eq_sum, Finset.sum_smul]
    have h := congrArg (coinvariantsMk σ) (hb x)
    simpa only [map_sum, map_smul, coinvariantsMk_group_action] using h
  rw [projectiveModuleTrace_eq_of_split Λ (coinvariants σ) f p i hpi,
    freeModuleTrace_apply]
  congr 1
  apply Finset.sum_congr rfl
  intro j _
  simp only [LinearMap.comp_apply, p, standardBasisVector,
    Fintype.linearCombination_apply_single, one_smul, hf]
  change monoidAlgebraAugmentation (c (T (b j)) j) = _
  exact augmentation_eq_sum _

private def conjugate (E : MonoidExtensionByNat G Γ) (k : G) (γ : Γ) : Γ :=
  E.inclusion k⁻¹ * γ * E.inclusion k

private lemma conjugate_one (E : MonoidExtensionByNat G Γ) (γ : Γ) :
    conjugate E 1 γ = γ := by simp [conjugate]

private lemma conjugate_comp (E : MonoidExtensionByNat G Γ) (k l : G) (γ : Γ) :
    conjugate E k (conjugate E l γ) = conjugate E (l * k) γ := by
  simp [conjugate, map_mul, mul_assoc]

private lemma degree_conjugate (E : MonoidExtensionByNat G Γ) (k : G) (γ : Γ) :
    E.degree (conjugate E k γ) = E.degree γ := by
  simp [conjugate, E.degree_inclusion]

private lemma conjugate_fixed_iff (E : MonoidExtensionByNat G Γ) (k : G) (γ : Γ) :
    conjugate E k γ = γ ↔ k ∈ centralizer E.inclusion γ := by
  change E.inclusion k⁻¹ * γ * E.inclusion k = γ ↔
    E.inclusion k * γ = γ * E.inclusion k
  constructor
  · intro h
    have hh := congrArg (E.inclusion k * ·) h
    simpa only [← mul_assoc, ← map_mul, mul_inv_cancel, map_one, one_mul] using hh.symm
  · intro h
    rw [mul_assoc, ← h, ← mul_assoc, ← map_mul, inv_mul_cancel, map_one, one_mul]

private lemma conjugate_eq_iff (E : MonoidExtensionByNat G Γ) (k l : G) (γ : Γ) :
    conjugate E k γ = conjugate E l γ ↔
      QuotientGroup.rightRel (centralizer E.inclusion γ) k l := by
  rw [QuotientGroup.rightRel_apply]
  constructor
  · intro h
    have hh := congrArg (conjugate E k⁻¹) h
    apply (conjugate_fixed_iff E (l * k⁻¹) γ).mp
    simpa only [conjugate_comp, mul_inv_cancel, conjugate_one] using hh.symm
  · intro h
    have hh := congrArg (conjugate E k) ((conjugate_fixed_iff E (l * k⁻¹) γ).mpr h)
    simpa only [conjugate_comp, inv_mul_cancel_right] using hh.symm

private def conjugacyCosetMap (E : MonoidExtensionByNat G Γ) (γ : Γ) :
    Quotient (QuotientGroup.rightRel (centralizer E.inclusion γ)) → Γ :=
  Quotient.lift (fun k => conjugate E k γ)
    (fun _ _ h => (conjugate_eq_iff E _ _ γ).mpr h)

private lemma conjugacyCosetMap_out (E : MonoidExtensionByNat G Γ) (γ : Γ)
    (q : Quotient (QuotientGroup.rightRel (centralizer E.inclusion γ))) :
    conjugacyCosetMap E γ q = conjugate E q.out γ := by
  conv_lhs => rw [← Quotient.out_eq' q]
  rfl

private lemma conjugacyCosetMap_injective (E : MonoidExtensionByNat G Γ) (γ : Γ) :
    Function.Injective (conjugacyCosetMap E γ) := by
  intro q q'
  induction q using Quotient.inductionOn with | h k =>
    induction q' using Quotient.inductionOn with | h l =>
      intro h
      exact Quotient.sound' ((conjugate_eq_iff E k l γ).mp h)

private lemma conjugacy_representatives_bijective (E : MonoidExtensionByNat G Γ)
    (n : Multiplicative ℕ) (S : Finset Γ) (hS : IsConjugacyClassRepresentatives E n S) :
    Function.Bijective (fun z : (γ : S) ×
        Quotient (QuotientGroup.rightRel (centralizer E.inclusion γ.val)) =>
      (⟨conjugacyCosetMap E z.1.val z.2, by
        rw [conjugacyCosetMap_out, degree_conjugate]
        exact hS.1 _ z.1.property⟩ : {γ : Γ // E.degree γ = n})) := by
  classical
  constructor
  · rintro ⟨γ, q⟩ ⟨δ, r⟩ h
    have hval : conjugacyCosetMap E γ.val q = conjugacyCosetMap E δ.val r :=
      congrArg Subtype.val h
    have hγ : γ.val = δ.val := by
      obtain ⟨a, ha, hu⟩ := hS.2 (conjugacyCosetMap E γ.val q)
        (by rw [conjugacyCosetMap_out, degree_conjugate]; exact hS.1 _ γ.property)
      have hconj (ε : S) (r : Quotient (QuotientGroup.rightRel (centralizer E.inclusion ε.val))) :
          ε.val ∈ S ∧ ∃ g, ε.val = E.inclusion g *
            conjugacyCosetMap E ε.val r * E.inclusion g⁻¹ := by
        refine ⟨ε.property, r.out, ?_⟩
        rw [conjugacyCosetMap_out]
        have hh := conjugate_comp E r.out⁻¹ r.out ε.val
        simpa only [conjugate, inv_inv, mul_inv_cancel, inv_one, map_one, one_mul,
          mul_one] using hh.symm
      exact (hu _ (hconj γ q)).trans (hu _ (hval ▸ hconj δ r)).symm
    have hγ' : γ = δ := Subtype.ext hγ
    subst δ
    have hq : q = r := conjugacyCosetMap_injective E γ.val hval
    subst r
    rfl
  · intro γ
    obtain ⟨δ, ⟨hδ, g, hg⟩, _⟩ := hS.2 γ.val γ.property
    refine ⟨⟨⟨δ, hδ⟩, Quotient.mk _ g⟩, ?_⟩
    apply Subtype.ext
    change conjugate E g δ = γ.val
    have hδ' : δ = conjugate E g⁻¹ γ.val := by simpa [conjugate] using hg
    rw [hδ', conjugate_comp, inv_mul_cancel, conjugate_one]

private def degreeFiberEquiv (E : MonoidExtensionByNat G Γ) (t : Γ) :
    G ≃ {γ : Γ // E.degree γ = E.degree t} :=
  Equiv.ofBijective (fun g => ⟨E.inclusion g * t, by simp [E.degree_inclusion]⟩)
    ⟨fun g h he => E.inclusion_injective
      (E.mul_right_cancel _ _ t (congrArg Subtype.val he)),
      fun γ => by
        obtain ⟨g, hg⟩ := (E.same_degree γ.val t).mp γ.property
        exact ⟨g, Subtype.ext hg.symm⟩⟩

private lemma sum_conjugacy_classes [Fintype G] (E : MonoidExtensionByNat G Γ)
    (t : Γ) (S : Finset Γ) (hS : IsConjugacyClassRepresentatives E (E.degree t) S)
    [∀ γ : S, Fintype (Quotient (QuotientGroup.rightRel
      (centralizer E.inclusion γ.val)))]
    {A : Type*} [AddCommMonoid A] (f : Γ → A) :
    (∑ γ : S, ∑ q : Quotient (QuotientGroup.rightRel (centralizer E.inclusion γ.val)),
      f (conjugate E q.out γ.val)) = ∑ g, f (E.inclusion g * t) := by
  classical
  let : Fintype {γ : Γ // E.degree γ = E.degree t} :=
    Fintype.ofEquiv G (degreeFiberEquiv E t)
  let e := Equiv.ofBijective _ (conjugacy_representatives_bijective E (E.degree t) S hS)
  calc
    _ = ∑ z : (γ : S) × Quotient (QuotientGroup.rightRel
          (centralizer E.inclusion γ.val)),
        f (conjugacyCosetMap E z.1.val z.2) := by
      rw [Fintype.sum_sigma]
      simp only [conjugacyCosetMap_out]
    _ = ∑ γ : {γ : Γ // E.degree γ = E.degree t}, f γ.val :=
      Equiv.sum_comp e (fun γ => f γ.val)
    _ = ∑ g, f (E.inclusion g * t) :=
      (Equiv.sum_comp (degreeFiberEquiv E t) (fun γ => f γ.val)).symm

/-- The trace of degree one on the coinvariants is the sum of the centralizer
traces over the `G`-conjugacy classes of degree-one elements. -/
@[stacks 03UD "the trace identity", sga "4½ Rapport 5.11"]
lemma trace_degreeOne_on_coinvariants [Finite G] (E : MonoidExtensionByNat G Γ)
    [AddCommGroup P] [Module Λ P] (ρ : _root_.Representation Λ Γ P)
    [Module.Finite Λ[G] (Representation.asModuleNC
      (restrictedRepresentation E ρ))]
    [Module.Projective Λ[G] (Representation.asModuleNC
      (restrictedRepresentation E ρ))]
    (S : Finset Γ) (hS : IsConjugacyClassRepresentatives E (.ofAdd 1) S) :
    letI := coinvariants_module_finite (restrictedRepresentation E ρ)
    letI := coinvariants_module_projective (restrictedRepresentation E ρ)
    projectiveModuleTrace Λ (coinvariants (restrictedRepresentation E ρ))
        ((coinvariantRepresentation E ρ).val (.ofAdd 1)) =
      ∑ γ ∈ S, MonoidExtensionByNat.centralizerTrace E ρ γ := by
  classical
  let : Fintype G := Fintype.ofFinite G
  let σ := restrictedRepresentation E ρ
  let := coinvariants_module_finite σ
  let := coinvariants_module_projective σ
  obtain ⟨t, ht⟩ := E.degree_surjective (.ofAdd 1)
  obtain ⟨n, b, c, hc, hb⟩ := exists_equivariant_coordinates σ
  let F : Γ → Λ := fun γ => ∑ j, (c (ρ γ (b j)) j).coeff 1
  let : ∀ γ : Γ, Fintype (Quotient (QuotientGroup.rightRel
      (centralizer E.inclusion γ))) :=
    fun γ => cosetQuotientFintype (centralizer E.inclusion γ)
  have hcentral (γ : Γ) : MonoidExtensionByNat.centralizerTrace E ρ γ =
      additiveCommutatorQuotientMk Λ
        (∑ q : Quotient (QuotientGroup.rightRel (centralizer E.inclusion γ)),
          F (conjugate E q.out γ)) := by
    let H := centralizer E.inclusion γ
    let τ := ρ.comp (E.inclusion.comp H.subtype)
    let : Fintype H := Fintype.ofFinite H
    let : Module Λ[H] P := Representation.asModuleNC.moduleMonoidAlgebra τ
    let : Module.Finite Λ[H] P := MonoidExtensionByNat.restricted_module_finite E ρ H
    let : Module.Projective Λ[H] P := MonoidExtensionByNat.restricted_module_projective E ρ H
    have hs (h : H) (r : Λ) (x : P) :
        (MonoidAlgebra.single h r : Λ[H]) • x = r • σ h x :=
      Representation.single_smul_asModuleNC τ r h x
    change groupTrace Λ H P (MonoidExtensionByNat.centralizerEndomorphism E ρ γ).val = _
    refine (subgroup_trace_coordinates σ b c hc hb H hs
      (MonoidExtensionByNat.centralizerEndomorphism E ρ γ).val).trans ?_
    congr 1
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro q _
    change (∑ j, (c ((MonoidExtensionByNat.centralizerEndomorphism E ρ γ).val
      (σ q.out (b j))) j).coeff q.out) = _
    apply Finset.sum_congr rfl
    intro j _
    rw [(MonoidExtensionByNat.centralizerEndomorphism E ρ γ).property]
    have hact : ρ (conjugate E q.out γ) (b j) =
        σ q.out⁻¹ (ρ γ (σ q.out (b j))) := by
      simp only [conjugate, map_mul, Module.End.mul_apply]
      rfl
    change (c (ρ γ (σ q.out (b j))) j).coeff q.out =
      (c (ρ (conjugate E q.out γ) (b j)) j).coeff 1
    rw [hact, hc]
    simp
  have hcoin := coinvariants_trace_coordinates σ b c hc hb
    ((coinvariantRepresentation E ρ).val (.ofAdd 1)) (ρ t) (by
      intro x
      rw [← ht]
      exact (coinvariantRepresentation E ρ).property t x)
  have hF (g : G) : F (E.inclusion g * t) =
      ∑ j, (c (ρ t (b j)) j).coeff g⁻¹ := by
    apply Finset.sum_congr rfl
    intro j _
    rw [map_mul, Module.End.mul_apply]
    change (c (σ g (ρ t (b j))) j).coeff 1 = _
    rw [hc]
    simp
  have hsum : (∑ g, F (E.inclusion g * t)) =
      ∑ j, ∑ g, (c (ρ t (b j)) j).coeff g := by
    simp_rw [hF]
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j _
    exact Equiv.sum_comp (Equiv.inv G) (fun g => (c (ρ t (b j)) j).coeff g)
  have hSt : IsConjugacyClassRepresentatives E (E.degree t) S := by rwa [ht]
  have hclasses := sum_conjugacy_classes E t S hSt F
  change projectiveModuleTrace Λ (coinvariants σ)
      ((coinvariantRepresentation E ρ).val (.ofAdd 1)) = _
  rw [hcoin]
  simp_rw [hcentral]
  rw [← map_sum]
  congr 1
  rw [← hsum, ← hclasses]
  exact Finset.sum_coe_sort S (fun γ =>
    ∑ q : Quotient (QuotientGroup.rightRel (centralizer E.inclusion γ)),
      F (conjugate E q.out γ))

/-- The elements of degree one form a single `G`-coset, and `G` acts on it by conjugation with
stabilizers the centralizers.  Hence the numbers of conjugates of a set of representatives of
the `G`-conjugacy classes of degree-one elements add up to the order of `G`. -/
lemma sum_card_centralizer_cosets_degreeOne [Finite G] (E : MonoidExtensionByNat G Γ)
    (S : Finset Γ) (hS : IsConjugacyClassRepresentatives E (.ofAdd 1) S) :
    ∑ γ ∈ S, Nat.card (Quotient (QuotientGroup.rightRel
      (centralizer E.inclusion γ))) = Nat.card G := by
  classical
  let : Fintype G := Fintype.ofFinite G
  let : ∀ γ : Γ, Fintype (Quotient (QuotientGroup.rightRel
      (centralizer E.inclusion γ))) :=
    fun γ => cosetQuotientFintype (centralizer E.inclusion γ)
  obtain ⟨t, ht⟩ := E.degree_surjective (.ofAdd 1)
  have hSt : IsConjugacyClassRepresentatives E (E.degree t) S := by rwa [ht]
  have h := sum_conjugacy_classes E t S hSt (fun _ => (1 : ℕ))
  simp only [Finset.sum_const, Finset.card_univ, smul_eq_mul, mul_one,
    ← Nat.card_eq_fintype_card] at h
  rw [← h]
  exact (Finset.sum_coe_sort S
    (fun γ => Nat.card (Quotient (QuotientGroup.rightRel
      (centralizer E.inclusion γ))))).symm

end Stacks.Trace
