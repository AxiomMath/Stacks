module

public import Mathlib.Algebra.Module.LinearMap.End
public import Mathlib.Algebra.Module.Pi
public import Mathlib.Data.Fintype.BigOperators
public import Mathlib.GroupTheory.QuotientGroup.Defs
public import StacksCore.Tactic.StacksAttribute

/-!
# The trace of an endomorphism of a finite free module

For a possibly noncommutative ring `R`, write `Rⁿᵃᵗ` for the quotient of the additive group
of `R` by the subgroup generated by the additive commutators `a * b - b * a`.  The trace of
an endomorphism of a finite free left `R`-module is the image in `Rⁿᵃᵗ` of the sum of its
diagonal matrix entries; killing the additive commutators is exactly what makes that sum
independent of the chosen basis.

## Main definitions

* `CategoryTheory.FilteredDerived.additiveCommutatorSubgroup`: the additive subgroup of a ring
  generated by its additive commutators.
* `CategoryTheory.FilteredDerived.AdditiveCommutatorQuotient`: the quotient of a ring by that
  subgroup.
* `CategoryTheory.FilteredDerived.additiveCommutatorQuotientMk`: the canonical quotient map.
* `CategoryTheory.FilteredDerived.freeModuleTrace`: the trace, as an additive homomorphism on
  the endomorphisms of a finite free module with its standard basis.

## Main results

* `CategoryTheory.FilteredDerived.freeModuleTrace_apply`: the trace is the class of the sum of
  the diagonal entries.

## Implementation notes

The standard finite free left module with basis indexed by `ι` is represented by `ι → R`.  Its
endomorphisms act on row coordinates on the right: the `(i, i)` entry of an endomorphism `f` is
the `i`-th coordinate of `f` applied to the `i`-th standard basis vector.  Passing the sum of
these entries through the additive quotient map gives an additive homomorphism.  The
construction is stated for an arbitrary finite index type rather than only for `Fin m`.

## References

* [Stacks Project, Tag 03T0](https://stacks.math.columbia.edu/tag/03T0)
-/

@[expose] public section

universe u v

namespace CategoryTheory.FilteredDerived

/-- The additive subgroup of a ring generated by its additive commutators `a * b - b * a`. -/
def additiveCommutatorSubgroup (R : Type u) [Ring R] : AddSubgroup R :=
  AddSubgroup.closure {x | ∃ a b : R, x = a * b - b * a}

/-- The additive commutator quotient `R/[R,R]` of a ring `R`. -/
@[sga "4½ Rapport 4.2"]
abbrev AdditiveCommutatorQuotient (R : Type u) [Ring R] :=
  R ⧸ additiveCommutatorSubgroup R

/-- The canonical additive map from a ring to its additive commutator quotient. -/
@[sga "4½ Rapport 4.2"]
def additiveCommutatorQuotientMk (R : Type u) [Ring R] :
    R →+ AdditiveCommutatorQuotient R :=
  QuotientAddGroup.mk' (additiveCommutatorSubgroup R)

variable (R : Type u) [Ring R]

/-- The standard basis vector of `ι → R` indexed by `i`. -/
noncomputable abbrev standardBasisVector (ι : Type v) (i : ι) : ι → R := by
  classical
  exact Pi.single i 1

/-- **Stacks Project, Tag 03T0.** The trace of an endomorphism of a finite free left module,
valued in the additive commutator quotient of the coefficient ring. -/
@[stacks 03T0, sga "4½ Rapport 4.2" "free module tr", sga "5 IIIB 5.7" "5.7.1-5.7.2"]
noncomputable def freeModuleTrace (ι : Type v) [Fintype ι] :
    Module.End R (ι → R) →+ AdditiveCommutatorQuotient R where
  toFun f := by
    classical
    exact additiveCommutatorQuotientMk R
      (∑ i, f (standardBasisVector R ι i) i)
  map_zero' := by
    classical
    simp [additiveCommutatorQuotientMk]
  map_add' f g := by
    classical
    simp only [LinearMap.add_apply, Pi.add_apply, Finset.sum_add_distrib]
    exact map_add _ _ _

/-- The value of `freeModuleTrace` is the class of the sum of the diagonal entries in the
additive commutator quotient. -/
@[simp]
theorem freeModuleTrace_apply (ι : Type v) [Fintype ι]
    (f : Module.End R (ι → R)) :
    freeModuleTrace R ι f = additiveCommutatorQuotientMk R
      (∑ i, f (standardBasisVector R ι i) i) := by classical rfl

end CategoryTheory.FilteredDerived
