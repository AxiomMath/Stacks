module

public import StacksFrontier.CategoryTheory.Monoidal.ProjectionFormulaComparisonMap
public import StacksFrontier.Homology.Devissage.CompactGeneratedNatTransAllShifts

/-!
# The comparison map of a right adjoint of pushforward on a compactly generated category

Let `F : C ⥤ D` be a strong monoidal functor with right adjoint `G`, let `a` be a right adjoint
of `G`, and suppose the projection maps `K ⊗ G M ⟶ G (F K ⊗ M)` are invertible. If `C` is
pre-triangulated with direct sums and compactly generated by a family `E` all of whose shifts
have duals, and if both sides `F (-) ⊗ a L` and `a ((-) ⊗ L)` of the comparison map are exact and
commute with direct sums, then the comparison map `F K ⊗ a L ⟶ a (K ⊗ L)` is invertible for every
`K`. This is the categorical content of [Stacks, Tag 0A9U].

The proof is the dévissage
`StacksDraft.CompactDevissage.isIso_app_of_isCompactlyGenerated_of_forall_shift`, which asks for
no compatibility of the comparison map with the shift, applied to
`CategoryTheory.Adjunction.comparisonNatTrans`; at the shifts of the generators the comparison
map is invertible by `CategoryTheory.Adjunction.isIso_comparisonMap_of_exactPairing`.
-/

@[expose] public noncomputable section

namespace CategoryTheory.Adjunction

open Category MonoidalCategory Limits Pretriangulated ObjectProperty

universe v v' u u'

variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [Preadditive C] [HasZeroObject C]
  [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C] [HasCoproducts.{v} C]
  {D : Type u'} [Category.{v'} D] [MonoidalCategory D] [Preadditive D] [HasZeroObject D]
  [HasShift D ℤ] [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
  {F : C ⥤ D} {G : D ⥤ C} (adj : F ⊣ G) [F.Monoidal]
  [∀ (K : C) (M : D), IsIso (adj.projectionMap K M)] {a : C ⥤ D} (adj₂ : G ⊣ a) (L : C)
  [(F ⋙ tensorRight (a.obj L)).CommShift ℤ] [(F ⋙ tensorRight (a.obj L)).IsTriangulated]
  [(tensorRight L ⋙ a).CommShift ℤ] [(tensorRight L ⋙ a).IsTriangulated]
  [∀ J : Type v, PreservesColimitsOfShape (Discrete J) (F ⋙ tensorRight (a.obj L))]
  [∀ J : Type v, PreservesColimitsOfShape (Discrete J) (tensorRight L ⋙ a)]

/-- **The comparison map is invertible on a compactly generated category whose generators are
dualizable.** -/
theorem isIso_comparisonMap_of_isCompactlyGenerated {ι : Type v} (E : ι → C)
    (hEc : ∀ i, IsCompactObject.{v} (E i))
    (hE : ∀ Y : C, ((ofObj E).shiftClosure ℤ).rightOrthogonal Y → IsZero Y)
    (hdual : ∀ (i : ι) (n : ℤ), Nonempty (HasRightDual ((E i)⟦n⟧))) (K : C) :
    IsIso (adj.comparisonMap adj₂ K L) :=
  StacksDraft.CompactDevissage.isIso_app_of_isCompactlyGenerated_of_forall_shift
    (adj.comparisonNatTrans adj₂ L) E hEc hE
    (fun i n => by
      obtain ⟨h⟩ := hdual i n
      exact adj.isIso_comparisonMap_of_exactPairing adj₂ _ ((E i)⟦n⟧)ᘁ L) K

end CategoryTheory.Adjunction

end
