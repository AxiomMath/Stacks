module

public import StacksFrontier.CategoryTheory.Monoidal.PullbackComparisonDevissage

/-!
# The two-variable comparison map of Equation 48.8.0.1, by dévissage

Let `F : C ⥤ D` be a monoidal functor with right adjoint `G`, and `a` a right adjoint of `G`.
`CategoryTheory.MonoidalProjectionFormula.comparison` is the map `F K ⊗ a L ⟶ a (K ⊗ L)` of
[Stacks, Tag 0A9S]. `CategoryTheory.MonoidalProjectionFormula.isIso_comparisonUnit_app` proves
it invertible at `L = 𝟙` by dévissage in `K`; this file does the same at an arbitrary `L`. Both
sides are exact functors of `K` commuting with direct sums once `a` and the tensor products are,
and the map is invertible at every `K` with a right dual
(`CategoryTheory.MonoidalProjectionFormula.isIso_comparison_of_exactPairing`, [Stacks, Tag 0A9T]).

## Main definitions

* `CategoryTheory.MonoidalProjectionFormula.comparisonNatTrans` — the comparison at a fixed `L`,
  as a morphism of functors of `K`.

## Main results

* `CategoryTheory.MonoidalProjectionFormula.isIso_comparison_app` — the dévissage.

## References

* [Stacks Project, Tag 0A9S](https://stacks.math.columbia.edu/tag/0A9S)
* [Stacks Project, Tag 0A9T](https://stacks.math.columbia.edu/tag/0A9T)
* [Stacks Project, Tag 0A9U](https://stacks.math.columbia.edu/tag/0A9U)
-/

@[expose] public noncomputable section

namespace CategoryTheory.MonoidalProjectionFormula

open MonoidalCategory Limits Pretriangulated ObjectProperty

universe v₁ v₂ u₁ u₂

variable {C : Type u₁} {D : Type u₂} [Category.{v₁} C] [Category.{v₂} D]
  [MonoidalCategory C] [MonoidalCategory D]
  {F : C ⥤ D} [F.Monoidal] {G : D ⥤ C} (adj : F ⊣ G)
  {a : C ⥤ D} (adj' : G ⊣ a) [∀ (E : D) (K : C), IsIso (projectionFormulaMap adj E K)]

/-- **The comparison map of [Stacks, Tag 0A9S] at a fixed `L`**, `F K ⊗ a L ⟶ a (K ⊗ L)`, as a
morphism of functors of `K`. -/
@[simps]
def comparisonNatTrans (L : C) : F ⋙ tensorRight (a.obj L) ⟶ tensorRight L ⋙ a where
  app K := comparison adj adj' K L
  naturality _ _ f := comparison_naturality_left adj adj' f L

/-- **The comparison map `F K ⊗ a L ⟶ a (K ⊗ L)` is invertible for every `K`**, for `C`
pre-triangulated with direct sums and generated by a family of compact objects each of whose
shifts has a right dual, when both sides are exact functors of `K` commuting with direct sums:
it is invertible at every object with a right dual
(`CategoryTheory.MonoidalProjectionFormula.isIso_comparison_of_exactPairing`), and the
dévissage does the rest. -/
theorem isIso_comparison_app
    [Preadditive C] [HasZeroObject C] [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive]
    [Pretriangulated C] [HasCoproducts.{v₁} C]
    [Preadditive D] [HasZeroObject D] [HasShift D ℤ] [∀ n : ℤ, (shiftFunctor D n).Additive]
    [Pretriangulated D] (L : C)
    [(F ⋙ tensorRight (a.obj L)).CommShift ℤ] [(tensorRight L ⋙ a).CommShift ℤ]
    [(F ⋙ tensorRight (a.obj L)).IsTriangulated] [(tensorRight L ⋙ a).IsTriangulated]
    [∀ J : Type v₁, PreservesColimitsOfShape (Discrete J) (F ⋙ tensorRight (a.obj L))]
    [∀ J : Type v₁, PreservesColimitsOfShape (Discrete J) (tensorRight L ⋙ a)]
    {ι : Type v₁} (E : ι → C) (hEc : ∀ i, IsCompactObject.{v₁} (E i))
    (hE : ∀ Y : C, ((ofObj E).shiftClosure ℤ).rightOrthogonal Y → IsZero Y)
    (hdual : ∀ i (n : ℤ), HasRightDual ((E i)⟦n⟧)) (K : C) :
    IsIso (comparison adj adj' K L) :=
  StacksDraft.CompactDevissage.isIso_app_of_isCompactlyGenerated_of_forall_shift
    (comparisonNatTrans adj adj' L) E hEc hE
    (fun i n => isIso_comparison_of_exactPairing adj adj' _ ((E i)⟦n⟧)ᘁ L) K

end CategoryTheory.MonoidalProjectionFormula

end
