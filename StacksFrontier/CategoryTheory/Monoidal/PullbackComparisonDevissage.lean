module

public import StacksFrontier.CategoryTheory.Monoidal.ProjectionFormulaDualizable
public import StacksFrontier.Homology.Devissage.IsoLocusOfNatTrans

/-!
# Equation 48.8.0.1 is an isomorphism, abstractly: the proof of [Stacks, Tag 0A9U]

Let `F : C ⥤ D` be a strong monoidal functor between monoidal pre-triangulated categories with a
right adjoint `G`, which itself has a right adjoint `a`, and suppose the projection-formula map
`K ⊗ G E ⟶ G (F K ⊗ E)` is invertible everywhere. The map of Equation 48.8.0.1 of
[Stacks, Tag 0A9S] is

  `F K ⊗ a 𝟙 ⟶ a (K ⊗ 𝟙) ≅ a K`,

the comparison map `CategoryTheory.MonoidalProjectionFormula.comparison` at `L = 𝟙` followed by
`a` of the right unitor. This file proves the source's Lemma 48.13.3 in this setting: if `C` has
direct sums and a compact generating family whose shifts all have right duals, and both sides of
the map are exact functors of `K` commuting with direct sums, then the map is an isomorphism for
every `K`.

The proof is the source's: the map is invertible at every dualizable object, by
`CategoryTheory.MonoidalProjectionFormula.isIso_comparison_of_exactPairing` ([Stacks, Tag 0A9T]),
and the dévissage `StacksDraft.CompactDevissage.isIso_app_of_isCompactlyGenerated_of_forall_shift`
extends that to every object. The dévissage used does not ask the map to commute with the shift,
so no compatibility of the two sides' commutations with the shift is needed: each side only has to
be exact for *some* such commutation.

## Main definitions

* `CategoryTheory.MonoidalProjectionFormula.comparisonUnit` — the map of Equation 48.8.0.1, as a
  morphism of functors `F(-) ⊗ a 𝟙 ⟶ a`.

## Main results

* `CategoryTheory.MonoidalProjectionFormula.isIso_comparisonUnit_app` — the map is an
  isomorphism at every object.

## References

* [Stacks Project, Tag 0A9U](https://stacks.math.columbia.edu/tag/0A9U)
* [Stacks Project, Tag 0A9T](https://stacks.math.columbia.edu/tag/0A9T)
* [Stacks Project, Tag 0A9S](https://stacks.math.columbia.edu/tag/0A9S)
-/

@[expose] public noncomputable section

namespace CategoryTheory.MonoidalProjectionFormula

open MonoidalCategory Limits Pretriangulated ObjectProperty

universe v₁ v₂ u₁ u₂

variable {C : Type u₁} {D : Type u₂} [Category.{v₁} C] [Category.{v₂} D]
  [MonoidalCategory C] [MonoidalCategory D]
  {F : C ⥤ D} [F.Monoidal] {G : D ⥤ C} (adj : F ⊣ G)

/-! ### The projection formula -/

/-- The projection-formula map at a fixed `E`, as a morphism of functors of `K`. -/
@[simps]
def projectionFormulaNatTransLeft (E : D) : tensorRight (G.obj E) ⟶ F ⋙ tensorRight E ⋙ G where
  app K := projectionFormulaMap adj E K
  naturality _ _ f := projectionFormulaMap_naturality_left adj E f

/-- **[Stacks, Tag 08EU], abstractly.** Let `C` be a pre-triangulated category with direct sums,
generated by a family `E` of compact objects each of whose shifts has a right dual, and suppose
both `K ↦ K ⊗ G E` and `K ↦ G (F K ⊗ E)` are exact and commute with direct sums. Then the
projection-formula map `K ⊗ G E ⟶ G (F K ⊗ E)` is an isomorphism for every `K`: it is one at
every dualizable object, and the dévissage does the rest. -/
theorem isIso_projectionFormulaMap
    [Preadditive C] [HasZeroObject C] [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive]
    [Pretriangulated C] [HasCoproducts.{v₁} C]
    [Preadditive D] [HasZeroObject D] [HasShift D ℤ] [∀ n : ℤ, (shiftFunctor D n).Additive]
    [Pretriangulated D] (M : D)
    [(tensorRight (G.obj M)).CommShift ℤ] [(F ⋙ tensorRight M ⋙ G).CommShift ℤ]
    [(tensorRight (G.obj M)).IsTriangulated] [(F ⋙ tensorRight M ⋙ G).IsTriangulated]
    [∀ J : Type v₁, PreservesColimitsOfShape (Discrete J) (tensorRight (G.obj M))]
    [∀ J : Type v₁, PreservesColimitsOfShape (Discrete J) (F ⋙ tensorRight M ⋙ G)]
    {ι : Type v₁} (E : ι → C) (hEc : ∀ i, IsCompactObject.{v₁} (E i))
    (hE : ∀ Y : C, ((ofObj E).shiftClosure ℤ).rightOrthogonal Y → IsZero Y)
    (hdual : ∀ i (n : ℤ), HasRightDual ((E i)⟦n⟧)) (K : C) :
    IsIso (projectionFormulaMap adj M K) :=
  StacksDraft.CompactDevissage.isIso_app_of_isCompactlyGenerated_of_forall_shift
    (projectionFormulaNatTransLeft adj M) E hEc hE
    (fun i n => isIso_projectionFormulaMap_of_exactPairing adj _ ((E i)⟦n⟧)ᘁ M) K

/-! ### Equation 48.8.0.1 -/

variable {a : C ⥤ D} (adj' : G ⊣ a) [∀ (E : D) (K : C), IsIso (projectionFormulaMap adj E K)]

/-- **The map of Equation 48.8.0.1** `F K ⊗ a 𝟙 ⟶ a K`, as a morphism of functors of `K`: the
comparison map at `L = 𝟙` followed by `a` of the right unitor. -/
@[simps]
def comparisonUnit : F ⋙ tensorRight (a.obj (𝟙_ C)) ⟶ a where
  app K := comparison adj adj' K (𝟙_ C) ≫ a.map (ρ_ K).hom
  naturality K K' f := by
    dsimp
    rw [comparison_naturality_left_assoc, ← a.map_comp, Category.assoc, ← a.map_comp,
      rightUnitor_naturality]

/-- The map of Equation 48.8.0.1 is an isomorphism at an object with a right dual. -/
lemma isIso_comparisonUnit_app_of_exactPairing (K K' : C) [ExactPairing K K'] :
    IsIso ((comparisonUnit adj adj').app K) := by
  have := isIso_comparison_of_exactPairing adj adj' K K' (𝟙_ C)
  rw [comparisonUnit_app]
  infer_instance

/-- **[Stacks, Tag 0A9U], abstractly.** Let `C` be a pre-triangulated category with direct sums,
generated by a family `E` of compact objects each of whose shifts has a right dual, and suppose
both `K ↦ F K ⊗ a 𝟙` and `a` are exact and commute with direct sums. Then the map
`F K ⊗ a 𝟙 ⟶ a K` of Equation 48.8.0.1 is an isomorphism for every `K`. -/
theorem isIso_comparisonUnit_app
    [Preadditive C] [HasZeroObject C] [HasShift C ℤ] [∀ n : ℤ, (shiftFunctor C n).Additive]
    [Pretriangulated C] [HasCoproducts.{v₁} C]
    [Preadditive D] [HasZeroObject D] [HasShift D ℤ] [∀ n : ℤ, (shiftFunctor D n).Additive]
    [Pretriangulated D]
    [(F ⋙ tensorRight (a.obj (𝟙_ C))).CommShift ℤ] [a.CommShift ℤ]
    [(F ⋙ tensorRight (a.obj (𝟙_ C))).IsTriangulated] [a.IsTriangulated]
    [∀ J : Type v₁, PreservesColimitsOfShape (Discrete J) (F ⋙ tensorRight (a.obj (𝟙_ C)))]
    [∀ J : Type v₁, PreservesColimitsOfShape (Discrete J) a]
    {ι : Type v₁} (E : ι → C) (hEc : ∀ i, IsCompactObject.{v₁} (E i))
    (hE : ∀ Y : C, ((ofObj E).shiftClosure ℤ).rightOrthogonal Y → IsZero Y)
    (hdual : ∀ i (n : ℤ), HasRightDual ((E i)⟦n⟧)) (K : C) :
    IsIso ((comparisonUnit adj adj').app K) :=
  StacksDraft.CompactDevissage.isIso_app_of_isCompactlyGenerated_of_forall_shift
    (comparisonUnit adj adj') E hEc hE
    (fun i n => isIso_comparisonUnit_app_of_exactPairing adj adj' _ ((E i)⟦n⟧)ᘁ) K

end CategoryTheory.MonoidalProjectionFormula
