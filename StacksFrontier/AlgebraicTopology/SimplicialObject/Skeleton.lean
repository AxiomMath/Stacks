namespace CategoryTheory.SimplicialObject.Truncated

open Limits Opposite

section Finiteness

/-- If `A` is finite and each `L.obj X ⟶ Y` is finite, then the costructured arrow category
`CostructuredArrow L Y` has finitely many objects. -/
private theorem finite_costructuredArrow {A : Type*} [Category A] {T : Type*} [Category T]
    (L : A ⥤ T) (Y : T) [Finite A] [∀ X : A, Finite (L.obj X ⟶ Y)] :
    Finite (CostructuredArrow L Y) := by
  refine Finite.of_injective
    (fun f => (⟨f.left, f.hom⟩ : (X : A) × (L.obj X ⟶ Y))) ?_
  rintro ⟨l₁, r₁, w₁⟩ ⟨l₂, r₂, w₂⟩ h
  obtain ⟨rfl, h'⟩ := Sigma.mk.inj_iff.mp h
  obtain rfl := eq_of_heq h'
  cases r₁
  cases r₂
  rfl

/-- The hom types of `CostructuredArrow L Y` inherit finiteness from those of `A`. -/
private theorem finite_costructuredArrow_hom {A : Type*} [Category A] {T : Type*} [Category T]
    (L : A ⥤ T) (Y : T) (X X' : CostructuredArrow L Y) [Finite (X.left ⟶ X'.left)] :
    Finite (X ⟶ X') :=
  Finite.of_injective CommaMorphism.left fun _ _ h => CostructuredArrow.hom_ext _ _ h

/-- The category `(⦋n⦌/Δ)^{opp}_{≤ m} = CostructuredArrow (inclusion m).op Y` is a finite
category: its objects are the morphisms `⦋n⦌ ⟶ ⦋k⦌` with `k ≤ m`, of which there are finitely
many, and a morphism between two of them is a morphism `⦋k'⦌ ⟶ ⦋k⦌` of simplices. -/
@[instance_reducible]
private noncomputable def finCategoryCostructuredArrowOpInclusion (m : ℕ)
    (Y : SimplexCategoryᵒᵖ) :
    FinCategory (CostructuredArrow (SimplexCategory.Truncated.inclusion m).op Y) :=
  have _hA : Finite (SimplexCategory.Truncated m)ᵒᵖ :=
    have := finite_truncated m
    Finite.of_injective Opposite.unop Opposite.unop_injective
  have _hY : ∀ X : (SimplexCategory.Truncated m)ᵒᵖ,
      Finite ((SimplexCategory.Truncated.inclusion m).op.obj X ⟶ Y) := fun _ => finite_hom_op _ _
  have hhom : ∀ a b : (SimplexCategory.Truncated m)ᵒᵖ, Finite (a ⟶ b) := fun a b =>
    have : Finite (b.unop ⟶ a.unop) := finite_hom_fullSubcategory _ _
    finite_hom_op _ _
  { fintypeObj := @Fintype.ofFinite _ (finite_costructuredArrow _ Y)
    fintypeHom := fun X X' =>
      have := hhom X.left X'.left
      @Fintype.ofFinite _ (finite_costructuredArrow_hom _ Y X X') }

end Finiteness

variable {C : Type u} [Category.{v} C] [HasFiniteColimits C]

/-- **Stacks 018L**.
An `m`-truncated simplicial object `U` of a category `C` with finite colimits has a pointwise
left Kan extension along `(SimplexCategory.Truncated.inclusion m).op`: for every `⦋n⦌`, the
colimit of `U` over `(⦋n⦌/Δ)^{opp}_{≤ m}` exists. Hence the left adjoint `i_{m!}` of the
skeleton functor `sk_m` exists (`CategoryTheory.SimplicialObject.Truncated.sk m`, with
adjunction `CategoryTheory.SimplicialObject.skAdj m`) and `(i_{m!}U)_n` is that colimit. -/
@[stacks 018L, sga "4 V 7.1.0" "existence of i_{n!}"]
public instance hasPointwiseLeftKanExtension (m : ℕ) (U : SimplicialObject.Truncated C m) :
    (SimplexCategory.Truncated.inclusion m).op.HasPointwiseLeftKanExtension U := by
  intro Y
  have := finCategoryCostructuredArrowOpInclusion m Y
  infer_instance

end CategoryTheory.SimplicialObject.Truncated

namespace SSet

open CategoryTheory Opposite

open scoped Simplicial

/-- A subcomplex is stable under the simplicial operators. -/
private lemma Subcomplex.map_mem {X : SSet.{u}} (A : X.Subcomplex) {U V : SimplexCategoryᵒᵖ}
    (f : U ⟶ V) {x : X.obj U} (hx : x ∈ A.obj U) : X.map f x ∈ A.obj V :=
  Set.mem_preimage.mp (Set.mem_of_subset_of_mem (A.map f) hx)

section Skeleton

/-- Every `n`-simplex of `i_{m!}U` is the image of a simplex of degree `k ≤ m` under some
`φ : ⦋n⦌ ⟶ ⦋k⦌`, since `i_{m!}U` is a pointwise left Kan extension of `U`. -/
private lemma exists_eq_map_of_sk_obj {m : ℕ} (U : SSet.Truncated.{u} m) {n : ℕ}
    (x : ((Truncated.sk m).obj U) _⦋n⦌) :
    ∃ (k : ℕ) (_ : k ≤ m) (φ : ⦋n⦌ ⟶ ⦋k⦌) (y : ((Truncated.sk m).obj U) _⦋k⦌),
      ((Truncated.sk m).obj U).map φ.op y = x := by
  have hpw := Functor.isPointwiseLeftKanExtensionOfIsLeftKanExtension
    ((Truncated.sk m).obj U) ((SimplexCategory.Truncated.inclusion m).op.lanUnit.app U)
  obtain ⟨j, y, hy⟩ := Limits.Types.jointly_surjective _ (hpw (op ⦋n⦌)) x
  exact ⟨_, j.left.unop.property, j.hom.unop,
    ((SimplexCategory.Truncated.inclusion m).op.lanUnit.app U).app j.left y, hy⟩

/-- If `U` is an `m`-truncated simplicial set and `m < n`, then every `n`-simplex of `i_{m!}U` is
degenerate. -/
private lemma mem_degenerate_sk_obj_of_lt {m : ℕ} (U : SSet.Truncated.{u} m) {n : ℕ} (hn : m < n)
    (x : ((Truncated.sk m).obj U) _⦋n⦌) :
    x ∈ ((Truncated.sk m).obj U).degenerate n := by
  obtain ⟨k, hk, φ, y, rfl⟩ := exists_eq_map_of_sk_obj U x
  exact ⟨k, by omega, φ, y, rfl⟩

/-- The nondegenerate simplices of `i_{m!}U`, for `U` an `m`-truncated simplicial set, all lie
in degrees `≤ m`. -/
private lemma le_of_mem_nonDegenerate_sk_obj {m : ℕ} (U : SSet.Truncated.{u} m) {n : ℕ}
    {x : ((Truncated.sk m).obj U) _⦋n⦌}
    (hx : x ∈ ((Truncated.sk m).obj U).nonDegenerate n) : n ≤ m :=
  not_lt.mp fun hn ↦ hx (mem_degenerate_sk_obj_of_lt U hn x)

/-- A morphism of simplicial sets which maps nondegenerate simplices to nondegenerate simplices
and is injective on nondegenerate simplices is a monomorphism. -/
private lemma mono_of_injOn_nonDegenerate {X Y : SSet.{u}} (f : X ⟶ Y)
    (h₁ : ∀ d : ℕ, Set.MapsTo (f.app (op ⦋d⦌)) (X.nonDegenerate d) (Y.nonDegenerate d))
    (h₂ : ∀ d : ℕ, Set.InjOn (f.app (op ⦋d⦌)) (X.nonDegenerate d)) :
    Mono f := by
  rw [NatTrans.mono_iff_mono_app]
  rintro ⟨d⟩
  induction d using SimplexCategory.rec with | _ d =>
  rw [mono_iff_injective]
  intro x₁ x₂ h
  obtain ⟨m₁, g₁, _, y₁, rfl⟩ := X.exists_nonDegenerate x₁
  obtain ⟨m₂, g₂, _, y₂, rfl⟩ := X.exists_nonDegenerate x₂
  rw [NatTrans.naturality_apply, NatTrans.naturality_apply] at h
  have hy₁ : f.app _ y₁.1 ∈ Y.nonDegenerate m₁ := h₁ _ y₁.2
  have hy₂ : f.app _ y₂.1 ∈ Y.nonDegenerate m₂ := h₁ _ y₂.2
  obtain rfl : m₁ = m₂ := Y.unique_nonDegenerate_dim _ g₁ ⟨_, hy₁⟩ rfl g₂ ⟨_, hy₂⟩ h
  obtain rfl : g₁ = g₂ := Y.unique_nonDegenerate_map _ g₁ ⟨_, hy₁⟩ rfl g₂ ⟨_, hy₂⟩ h
  obtain rfl : y₁ = y₂ := Subtype.ext (h₂ m₁ y₁.2 y₂.2
    (Subtype.ext_iff.mp (Y.unique_nonDegenerate_simplex _ g₁ ⟨_, hy₁⟩ rfl g₁ ⟨_, hy₂⟩ h)))
  rfl

section

variable {X Y : SSet.{u}} (f : X ⟶ Y) {n : ℕ}
  (hf : ∀ ⦃d : ℕ⦄, d ≤ n → Function.Bijective (f.app (op ⦋d⦌)))
  (hX : ∀ ⦃d : ℕ⦄ {x : X _⦋d⦌}, x ∈ X.nonDegenerate d → d ≤ n)

include hf hX

/-- If `f : X ⟶ Y` is bijective in every degree `≤ n` and every nondegenerate simplex of `X`
has dimension `≤ n`, then `f` maps nondegenerate simplices to nondegenerate simplices. -/
private lemma mapsTo_nonDegenerate_of_bijective_le (d : ℕ) :
    Set.MapsTo (f.app (op ⦋d⦌)) (X.nonDegenerate d) (Y.nonDegenerate d) := by
  intro x hx hdeg
  obtain ⟨k, hk, φ, z, hz⟩ := hdeg
  obtain ⟨w, hw⟩ := (hf (hk.le.trans (hX hx))).surjective z
  refine hx ⟨k, hk, φ, w, (hf (hX hx)).injective ?_⟩
  rw [NatTrans.naturality_apply, hw]
  exact hz

/-- If `f : X ⟶ Y` is bijective in every degree `≤ n` and every nondegenerate simplex of `X`
has dimension `≤ n`, then `f` is a monomorphism. -/
private lemma mono_of_bijective_le : Mono f :=
  mono_of_injOn_nonDegenerate f (mapsTo_nonDegenerate_of_bijective_le f hf hX)
    fun _ _ hx _ _ h ↦ (hf (hX hx)).injective h

/-- If `f : X ⟶ Y` is bijective in every degree `≤ n` and every nondegenerate simplex of `X`
has dimension `≤ n`, then the range of `f` is the subcomplex `Y.skeleton (n + 1)` of `Y`
generated by the simplices of dimension `≤ n`. -/
private lemma range_eq_skeleton_of_bijective_le :
    Subcomplex.range f = Y.skeleton (n + 1) := by
  refine le_antisymm ?_ ?_
  · rintro ⟨d⟩ x hx
    induction d using SimplexCategory.rec with | _ d =>
    obtain ⟨y, rfl⟩ := hx
    obtain ⟨k, φ, _, z, rfl⟩ := X.exists_nonDegenerate y
    rw [NatTrans.naturality_apply]
    exact Subcomplex.map_mem _ φ.op (Y.mem_skeleton (f.app _ z.1) (Nat.lt_succ_of_le (hX z.2)))
  · rw [Subcomplex.le_iff_contains_nonDegenerate]
    intro d x hx
    exact (hf (Nat.lt_succ_iff.mp
      ((Y.mem_skeleton_obj_iff_of_nonDegenerate x (n + 1)).mp hx))).surjective x.1

/-- If `f : X ⟶ Y` is bijective in every degree `≤ n` and every nondegenerate simplex of `X`
has dimension `≤ n`, then `f` factors as an isomorphism from `X` onto the subcomplex
`Y.skeleton (n + 1)` generated by the simplices of dimension `≤ n`, followed by the inclusion of
that subcomplex. -/
private lemma exists_iso_skeleton_of_bijective_le :
    ∃ e : X ≅ (Y.skeleton (n + 1) : SSet), e.hom ≫ Subcomplex.ι _ = f :=
  have := mono_of_bijective_le f hf hX
  ⟨asIso (Subcomplex.toRange f) ≪≫
    Subcomplex.eqToIso (range_eq_skeleton_of_bijective_le f hf hX), by simp⟩

end

/-- In degrees `d ≤ n`, the counit `i_{n!} sk_n X ⟶ X` of `SSet.skAdj n` is bijective. -/
private lemma bijective_skAdj_counit_app_app (X : SSet.{u}) {n d : ℕ} (hd : d ≤ n) :
    Function.Bijective ((((skAdj n).counit.app X).app (op ⦋d⦌))) := by
  rw [← isIso_iff_bijective]
  exact NatIso.isIso_app_of_isIso ((truncation n).map ((skAdj n).counit.app X))
    (op (⟨⦋d⦌, hd⟩ : SimplexCategory.Truncated n))

end Skeleton

/-- **Stacks 018P**.
For a simplicial set `X` and `n : ℕ`, the canonical morphism `i_{n!} sk_n X ⟶ X`, i.e. the counit
of the adjunction `SSet.skAdj n`, factors as an isomorphism from `(sk n).obj X` onto the
subcomplex `X.skeleton (n + 1)` generated by the simplices of dimension `≤ n`, followed by the
inclusion of that subcomplex. -/
@[stacks 018P]
public theorem exists_iso_skeleton_hom_ι_eq_skAdj_counit (X : SSet.{u}) (n : ℕ) :
    ∃ e : (sk n).obj X ≅ (X.skeleton (n + 1) : SSet),
      e.hom ≫ Subcomplex.ι _ = (skAdj n).counit.app X :=
  exists_iso_skeleton_of_bijective_le _ (fun _ hd ↦ bijective_skAdj_counit_app_app X hd)
    fun {_ _} hx ↦ le_of_mem_nonDegenerate_sk_obj _ hx

end SSet

namespace SSet.Subcomplex

open CategoryTheory Opposite CategoryTheory.Limits

open scoped Simplicial

section Attaching

variable {X Y : SSet.{u}} {A : X.Subcomplex} {B : Y.Subcomplex} {f : Y ⟶ X}

/-- The square attached to the preimage `B = A.preimage f` of a subcomplex `A` under
`f : Y ⟶ X` is cartesian. -/
private lemma isPullback_lift_ι (hle : Subcomplex.range (B.ι ≫ f) ≤ A)
    (hpre : A.preimage f = B) :
    IsPullback (Subcomplex.lift (B.ι ≫ f) hle) B.ι A.ι f := by
  refine { w := rfl, isLimit' := ⟨evaluationJointlyReflectsLimits _ (fun ⟨⟨m⟩⟩ ↦ ?_)⟩ }
  refine (isLimitMapConePullbackConeEquiv _ _).symm (IsPullback.isLimit ?_)
  dsimp
  rw [Types.isPullback_iff]
  refine ⟨rfl, fun _ _ ⟨_, hs⟩ ↦ Subtype.ext hs,
    fun y s hys ↦ ⟨⟨s, ?_⟩, Subtype.ext hys.symm, rfl⟩⟩
  rw [← hpre, Subcomplex.preimage_obj, Set.mem_preimage, ← hys]
  exact y.2

/-- **Attaching a simplicial set along the preimage of a subcomplex.** If `B` is the preimage of
a subcomplex `A` of `X` under `f : Y ⟶ X`, if `A` and the image of `f` cover `X`, and if `f` is
injective on the simplices outside `B`, then `X` is obtained from `A` by attaching `Y` along
`B`. -/
private lemma isPushout_lift_ι (hle : Subcomplex.range (B.ι ≫ f) ≤ A)
    (hpre : A.preimage f = B) (hsup : A ⊔ Subcomplex.range f = ⊤)
    (hinj : ∀ {m : ℕ} {s₁ s₂ : Y _⦋m⦌}, s₁ ∉ B.obj (op ⦋m⦌) → s₂ ∉ B.obj (op ⦋m⦌) →
      f.app _ s₁ = f.app _ s₂ → s₁ = s₂) :
    IsPushout (Subcomplex.lift (B.ι ≫ f) hle) B.ι A.ι f := by
  rw [← Subfunctor.range_ι A] at hsup
  refine { w := rfl, isColimit' := ⟨evaluationJointlyReflectsColimits _ (fun ⟨⟨m⟩⟩ ↦ ?_)⟩ }
  refine (isColimitMapCoconePushoutCoconeEquiv _ _).symm (IsPushout.isColimit ?_)
  refine Types.isPushout_of_isPullback_of_mono'
    ((isPullback_lift_ι hle hpre).map ((CategoryTheory.evaluation _ _).obj _))
    (congr($(hsup).obj (op ⦋m⦌))) (fun s₁ s₂ h₁ h₂ h ↦ ?_)
  exact hinj (fun hs ↦ h₁ (Set.mem_range.mpr ⟨⟨s₁, hs⟩, rfl⟩))
    (fun hs ↦ h₂ (Set.mem_range.mpr ⟨⟨s₂, hs⟩, rfl⟩)) h

end Attaching

section OneCell

variable {V : SSet.{u}} {U : V.Subcomplex} {n : ℕ}

/-- A simplex of `V` of dimension `n` outside a subcomplex `U` which contains all simplices of
dimension `< n` is nondegenerate. -/
private lemma mem_nonDegenerate_of_notMem_of_skeleton_le {x : V _⦋n⦌}
    (hx : x ∉ U.obj (op ⦋n⦌)) (hlt : V.skeleton n ≤ U) : x ∈ V.nonDegenerate n := by
  rw [mem_nonDegenerate_iff_notMem_degenerate]
  rintro ⟨m, hm, f, y, rfl⟩
  exact hx (map_mem U f.op (Set.mem_of_subset_of_mem (hlt _) (V.mem_skeleton y hm)))

/-- If a subcomplex `U` of `V` contains all simplices of dimension `< n`, if `x` is the only
`n`-simplex of `V` outside `U`, and if every simplex of `V` outside `U` in a degree `> n` is
degenerate, then `U` and `x` generate `V`. The proof is an induction on the degree: below `n`
the simplex lies in `U`, in degree `n` it lies in `U` or equals `x`, and above `n` it lies in
`U` or is a degeneracy of a simplex of lower degree. -/
private lemma sup_ofSimplex_eq_top (x : V _⦋n⦌) (hlt : V.skeleton n ≤ U)
    (hn : ∀ y : V _⦋n⦌, y ∈ U.obj (op ⦋n⦌) ∨ y = x)
    (hgt : ∀ j : ℕ, n < j → ∀ z : V _⦋j⦌, z ∉ U.obj (op ⦋j⦌) → z ∈ V.degenerate j) :
    U ⊔ Subcomplex.ofSimplex x = ⊤ := by
  have hUle : U ≤ U ⊔ Subcomplex.ofSimplex x := le_sup_left
  have hxle : Subcomplex.ofSimplex x ≤ U ⊔ Subcomplex.ofSimplex x := le_sup_right
  rw [← top_le_iff]
  rintro ⟨m⟩ z -
  induction m using SimplexCategory.rec with | _ m
  revert z
  induction m using Nat.strong_induction_on with
  | _ m IH =>
    intro z
    rcases Nat.lt_trichotomy m n with h | rfl | h
    · exact Set.mem_of_subset_of_mem (hUle _)
        (Set.mem_of_subset_of_mem (hlt _) (V.mem_skeleton z h))
    · rcases hn z with h | rfl
      · exact Set.mem_of_subset_of_mem (hUle _) h
      · exact Set.mem_of_subset_of_mem (hxle _) (Subcomplex.mem_ofSimplex_obj z)
    · by_cases hz : z ∈ U.obj (op ⦋m⦌)
      · exact Set.mem_of_subset_of_mem (hUle _) hz
      · obtain ⟨k, hk, g, y, rfl⟩ := hgt m h z hz
        exact map_mem _ g.op (IH k hk (z := y))

/-- The preimage of `U` under the morphism `Δ[n] ⟶ V` classifying an `n`-simplex `x` outside
`U` is the boundary `∂Δ[n]`, as soon as the boundary lands in `U`. -/
private lemma preimage_yonedaEquiv_symm_eq_boundary {x : V _⦋n⦌} (hx : x ∉ U.obj (op ⦋n⦌))
    (hbd : Subcomplex.range (∂Δ[n].ι ≫ yonedaEquiv.symm x) ≤ U) :
    U.preimage (yonedaEquiv.symm x) = ∂Δ[n] := by
  rw [stdSimplex.eq_boundary_iff]
  refine ⟨by rwa [← Subcomplex.image_le_iff, Subcomplex.image_eq_range], fun h ↦ hx ?_⟩
  simpa using h.symm.le _ (show stdSimplex.objEquiv.symm (𝟙 ⦋n⦌) ∈ _ by simp)

/-- An `m`-simplex of `Δ[n]` avoids the boundary exactly when the map `⦋m⦌ ⟶ ⦋n⦌` it
corresponds to is an epimorphism: by definition, `∂Δ[n]` consists of the non-surjective ones. -/
private lemma epi_objEquiv_iff_notMem_boundary {m : ℕ} (s : (Δ[n] : SSet.{u}) _⦋m⦌) :
    Epi (stdSimplex.objEquiv s) ↔ s ∉ ∂Δ[n].obj (op ⦋m⦌) :=
  SimplexCategory.epi_iff_surjective.trans not_not.symm

/-- The morphism `Δ[n] ⟶ V` classifying a nondegenerate `n`-simplex `x` of `V` is injective on
the simplices which do not lie in the boundary `∂Δ[n]`: such a simplex is `objEquiv.symm φ` for
an epimorphism `φ : ⦋m⦌ ⟶ ⦋n⦌`, and the epimorphism in the Eilenberg–Zilber decomposition of a
simplex along a nondegenerate one is unique. -/
private lemma yonedaEquiv_symm_app_injOn_compl_boundary {x : V _⦋n⦌}
    (hx : x ∈ V.nonDegenerate n) {m : ℕ} {s₁ s₂ : (Δ[n] : SSet.{u}) _⦋m⦌}
    (h₁ : s₁ ∉ ∂Δ[n].obj (op ⦋m⦌)) (h₂ : s₂ ∉ ∂Δ[n].obj (op ⦋m⦌))
    (h : (yonedaEquiv.symm x).app _ s₁ = (yonedaEquiv.symm x).app _ s₂) : s₁ = s₂ :=
  have := (epi_objEquiv_iff_notMem_boundary s₁).mpr h₁
  have := (epi_objEquiv_iff_notMem_boundary s₂).mpr h₂
  stdSimplex.objEquiv.injective
    (V.unique_nonDegenerate_map (V.map (stdSimplex.objEquiv s₁).op x) _ ⟨x, hx⟩ rfl _ ⟨x, hx⟩ h)

end OneCell

/-- **Stacks 018R**.
Let `U` be a simplicial subset of a simplicial set
`V` and let `x` be an `n`-simplex of `V` not in `U` such that `U` contains all simplices of `V`
of dimension `< n` (`hlt`), `x` is the only `n`-simplex of `V` outside `U` (`hn`), and every
simplex of `V` outside `U` in a degree `> n` is degenerate (`hgt`). Then the square formed by
the boundary inclusion `∂Δ[n] ⟶ Δ[n]`, the inclusion `U ⟶ V`, and the morphism
`Δ[n] ⟶ V` classifying `x` is a pushout square: `V = U ∐_{∂Δ[n]} Δ[n]`. -/
@[stacks 018R]
public theorem isPushout_boundary_ι {V : SSet.{u}} {U : V.Subcomplex} {n : ℕ} (x : V _⦋n⦌)
    (hx : x ∉ U.obj (op ⦋n⦌)) (hlt : V.skeleton n ≤ U)
    (hn : ∀ y : V _⦋n⦌, y ∈ U.obj (op ⦋n⦌) ∨ y = x)
    (hgt : ∀ j : ℕ, n < j → ∀ z : V _⦋j⦌, z ∉ U.obj (op ⦋j⦌) → z ∈ V.degenerate j)
    (hbd : range (∂Δ[n].ι ≫ yonedaEquiv.symm x) ≤ U) :
    IsPushout (lift (∂Δ[n].ι ≫ yonedaEquiv.symm x) hbd) ∂Δ[n].ι U.ι (yonedaEquiv.symm x) :=
  isPushout_lift_ι hbd (preimage_yonedaEquiv_symm_eq_boundary hx hbd)
    (by rw [Subcomplex.range_eq_ofSimplex, Equiv.apply_symm_apply]
        exact sup_ofSimplex_eq_top x hlt hn hgt)
    (fun h₁ h₂ h ↦ yonedaEquiv_symm_app_injOn_compl_boundary
      (mem_nonDegenerate_of_notMem_of_skeleton_le hx hlt) h₁ h₂ h)

section Filtration

/-- A subcomplex of dimension `< n` is contained in the `n`-skeleton. -/
private lemma le_skeleton_of_hasDimensionLT {V : SSet.{u}} (A : V.Subcomplex) (n : ℕ)
    [HasDimensionLT A n] : A ≤ V.skeleton n := by
  rw [le_iff_contains_nonDegenerate]
  intro m z hz
  obtain ⟨w, hw⟩ : ∃ w : (A : SSet) _⦋m⦌, A.ι.app _ w = z.1 := ⟨⟨z.1, hz⟩, rfl⟩
  have hw' : w ∈ (A : SSet).nonDegenerate m := by
    rw [← nonDegenerate_iff_of_mono A.ι, hw]
    exact z.2
  exact V.mem_skeleton _ (dim_lt_of_nonDegenerate (X := A) ⟨w, hw'⟩ n)

/-- A subcomplex containing every nondegenerate simplex is everything. -/
private lemma eq_top_of_isEmpty_N {V : SSet.{u}} {U : V.Subcomplex} (h : IsEmpty U.N) :
    U = ⊤ := by
  refine le_antisymm le_top ?_
  rw [le_iff_contains_nonDegenerate]
  intro n x _
  by_contra hx
  exact h.elim (N.mk x.1 x.2 hx)

/-- A nondegenerate simplex outside a subcomplex `B` is outside any smaller subcomplex `A`:
this gives an injection `B.N → A.N` over the identity of `V.N`. -/
private lemma exists_injective_N_of_le {V : SSet.{u}} {A B : V.Subcomplex} (h : A ≤ B) :
    ∃ f : B.N → A.N, Function.Injective f ∧ ∀ t, (f t).toN = t.toN := by
  refine ⟨fun t ↦ .mk' t.toN (fun ht ↦ t.notMem (h _ ht)), fun t₁ t₂ e ↦ ?_, fun _ ↦ rfl⟩
  rw [Subcomplex.N.ext_iff] at e
  exact (Subcomplex.N.ext_iff _ _).mpr e

/-- An injection into a finite type that misses a point strictly decreases the cardinality: the
`Nat.card` version of `Fintype.card_lt_of_injective_of_notMem`, which Mathlib states only for
`[Fintype α] [Fintype β]`. -/
public theorem card_lt_of_injective_of_notMem {α β : Type*} [Finite β] (f : α → β)
    (hf : Function.Injective f) {b : β} (hb : b ∉ Set.range f) : Nat.card α < Nat.card β := by
  have : Finite α := Finite.of_injective f hf
  have := Fintype.ofFinite α
  have := Fintype.ofFinite β
  simpa [Nat.card_eq_fintype_card] using Fintype.card_lt_of_injective_of_notMem f hf hb

/-- The filtration by one-cell attachments, by induction on a bound `k` for the number
`Nat.card U.N` of nondegenerate simplices of `V` outside `U`. -/
private lemma exists_filtration (k : ℕ) : ∀ {V : SSet.{u}} (U : V.Subcomplex), Finite U.N →
    Nat.card U.N ≤ k →
    ∃ (r : ℕ) (W : ℕ → V.Subcomplex), Monotone W ∧ W 0 = U ∧ W r = ⊤ ∧
      ∀ i < r, ∃ (n : ℕ) (x : V _⦋n⦌), x ∉ (W i).obj (op ⦋n⦌) ∧
        range (∂Δ[n].ι ≫ yonedaEquiv.symm x) ≤ W i ∧
        W (i + 1) = W i ⊔ ofSimplex x := by
  induction k with
  | zero =>
    intro V U hU hk
    have hzero : Nat.card U.N = 0 := by omega
    rw [Nat.card_eq_zero] at hzero
    have hempty : IsEmpty U.N := hzero.resolve_right (fun h ↦ (not_finite_iff_infinite.mpr h) hU)
    exact ⟨0, fun _ ↦ U, monotone_const, rfl, eq_top_of_isEmpty_N hempty,
      fun i hi ↦ absurd hi (by omega)⟩
  | succ k ih =>
    intro V U hU hk
    rcases isEmpty_or_nonempty U.N with h | h
    · exact ih U hU (by simp [Nat.card_of_isEmpty])
    · obtain ⟨s, hs⟩ := Finite.exists_min (fun t : U.N ↦ t.dim)
      have hsk : V.skeleton s.dim ≤ U := by
        rw [le_iff_contains_nonDegenerate]
        intro m z hz
        by_contra hzU
        have h₁ : s.dim ≤ m := by simpa using hs (N.mk z.1 z.2 hzU)
        rw [V.mem_skeleton_obj_iff_of_nonDegenerate z s.dim] at hz
        omega
      have hbd : range (∂Δ[s.dim].ι ≫ yonedaEquiv.symm s.simplex) ≤ U :=
        (le_skeleton_of_hasDimensionLT _ s.dim).trans hsk
      obtain ⟨f, hfinj, hftoN⟩ :=
        exists_injective_N_of_le (le_sup_left : U ≤ U ⊔ ofSimplex s.simplex)
      have hfin : Finite (U ⊔ ofSimplex s.simplex : V.Subcomplex).N := Finite.of_injective f hfinj
      have hle : ofSimplex s.simplex ≤ (U ⊔ ofSimplex s.simplex : V.Subcomplex) := le_sup_right
      have hmem : s.simplex ∈ (U ⊔ ofSimplex s.simplex : V.Subcomplex).obj (op ⦋s.dim⦌) :=
        hle _ (mem_ofSimplex_obj _)
      have hnotrange : s ∉ Set.range f := by
        rintro ⟨t, ht⟩
        rw [Subcomplex.N.ext_iff, hftoN t] at ht
        have h₂ := t.notMem
        rw [ht] at h₂
        exact h₂ hmem
      have hcard : Nat.card (U ⊔ ofSimplex s.simplex : V.Subcomplex).N < Nat.card U.N :=
        card_lt_of_injective_of_notMem f hfinj hnotrange
      obtain ⟨r, W, hmono, hW0, hWr, hstep⟩ :=
        ih (U ⊔ ofSimplex s.simplex) hfin (by omega)
      refine ⟨r + 1, Nat.rec (motive := fun _ ↦ V.Subcomplex) U (fun j _ ↦ W j),
        ?_, rfl, hWr, ?_⟩
      · refine monotone_nat_of_le_succ (fun i ↦ ?_)
        cases i with
        | zero => exact le_sup_left.trans hW0.ge
        | succ j => exact hmono.imp (Nat.le_succ j)
      · intro i hi
        cases i with
        | zero => exact ⟨s.dim, s.simplex, s.notMem, hbd, hW0⟩
        | succ j => exact hstep j (by omega)

end Filtration

/-- **Stacks 018S**.
Let `U` be a simplicial subset of a simplicial set `V` such that only finitely
many nondegenerate simplices of `V` lie outside `U`. Then there are `r : ℕ` and an increasing
sequence `W` of simplicial subsets of `V` with `W 0 = U` and `W r = V` such that, for each
`i < r`, the subcomplex `W (i + 1)` is obtained from `W i` by adjoining a single simplex `x`
of `V` which does not lie in `W i` and whose boundary does; equivalently, by
`SSet.Subcomplex.isPushout_boundary_ι`, each `W i ⊆ W (i + 1)` is the attachment of a cell along
`∂Δ[n] ⟶ Δ[n]`. -/
@[stacks 018S]
public theorem exists_monotone_sup_ofSimplex_eq_top {V : SSet.{u}} (U : V.Subcomplex)
    [Finite U.N] :
    ∃ (r : ℕ) (W : ℕ → V.Subcomplex), Monotone W ∧ W 0 = U ∧ W r = ⊤ ∧
      ∀ i < r, ∃ (n : ℕ) (x : V _⦋n⦌), x ∉ (W i).obj (op ⦋n⦌) ∧
        range (∂Δ[n].ι ≫ yonedaEquiv.symm x) ≤ W i ∧
        W (i + 1) = W i ⊔ ofSimplex x :=
  exists_filtration (Nat.card U.N) U inferInstance le_rfl

end SSet.Subcomplex

namespace AlgebraicTopology.NormalizedMooreComplex

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicTopology.DoldKan

open scoped Simplicial

variable {A : Type u} [Category.{v} A] [Abelian A]

/-- Above the truncation level, the Dold–Kan projector of a left-extended truncated simplicial
object vanishes: if `U` is an `m`-truncated simplicial object of an abelian category and
`m < n`, then `P∞` is zero in degree `n` on `i_{m!}U`.

Since `i_{m!}U` is a pointwise left Kan extension, the morphisms
`(i_{m!}U)(φ) : (i_{m!}U)_k ⟶ (i_{m!}U)_n` indexed by the maps `φ : ⦋n⦌ ⟶ ⦋k⦌` with `k ≤ m`
are jointly epimorphic; each such `φ` has `k ≤ m < n`, so it is not a monomorphism and
`P∞` kills it. -/
private lemma PInfty_f_sk_obj_eq_zero {m : ℕ}
    [∀ F : (SimplexCategory.Truncated m)ᵒᵖ ⥤ A,
      (SimplexCategory.Truncated.inclusion m).op.HasPointwiseLeftKanExtension F]
    (U : SimplicialObject.Truncated A m) {n : ℕ} (hmn : m < n) :
    (PInfty (X := (SimplicialObject.Truncated.sk m).obj U)).f n = 0 := by
  have hpw := Functor.isPointwiseLeftKanExtensionOfIsLeftKanExtension
    ((SimplicialObject.Truncated.sk m).obj U)
    ((SimplexCategory.Truncated.inclusion m).op.lanUnit.app U)
  refine (hpw (op ⦋n⦌)).hom_ext' fun X φ ↦ ?_
  rw [comp_zero, comp_zero]
  have hθ : ¬ Mono φ.unop := fun _ ↦ by
    have h₁ : n ≤ (unop ((SimplexCategory.Truncated.inclusion m).op.obj X)).len :=
      SimplexCategory.len_le_of_mono φ.unop
    have h₂ : (unop ((SimplexCategory.Truncated.inclusion m).op.obj X)).len ≤ m := X.unop.property
    omega
  rw [show φ = (φ.unop).op from rfl, degeneracy_comp_PInfty _ n φ.unop hθ, comp_zero]

/-- **Stacks 018T**.
Let `A` be an abelian category and let `U` be an `m`-truncated simplicial object of `A`. For
`n > m` the degree `n` normalized Moore subobject of the simplicial object `i_{m!}U` obtained
from `U` by the left adjoint `CategoryTheory.SimplicialObject.Truncated.sk m` of truncation is
the zero subobject: `N(i_{m!}U)ₙ = 0`. -/
@[stacks 018T]
public theorem objX_sk_obj_eq_bot {m : ℕ}
    [∀ F : (SimplexCategory.Truncated m)ᵒᵖ ⥤ A,
      (SimplexCategory.Truncated.inclusion m).op.HasPointwiseLeftKanExtension F]
    (U : SimplicialObject.Truncated A m) {n : ℕ} (hmn : m < n) :
    objX ((SimplicialObject.Truncated.sk m).obj U) n = ⊥ := by
  have h := HomologicalComplex.congr_hom (inclusionOfMooreComplexMap_comp_PInfty
    ((SimplicialObject.Truncated.sk m).obj U)) n
  rw [HomologicalComplex.comp_f, PInfty_f_sk_obj_eq_zero U hmn, comp_zero,
    inclusionOfMooreComplexMap_f] at h
  conv_lhs => rw [← Subobject.mk_arrow (objX _ n)]
  exact Subobject.mk_eq_bot_iff_zero.mpr h.symm

end AlgebraicTopology.NormalizedMooreComplex

namespace CategoryTheory.SimplicialObject

open Limits Opposite AlgebraicTopology AlgebraicTopology.NormalizedMooreComplex

open scoped Simplicial

section AbelianSkeleton

variable {A : Type u} [Category.{v} A] [Abelian A]

/-- In an abelian category a morphism `f : X ⟶ Y` factors through a subobject `P` of `Y` if and
only if it is annihilated by the cokernel of `P`. -/
private lemma factors_iff_comp_cokernel_π_eq_zero {X Y : A} (P : Subobject Y) (f : X ⟶ Y) :
    P.Factors f ↔ f ≫ cokernel.π P.arrow = 0 := by
  constructor
  · intro h
    rw [← Subobject.factorThru_arrow P f h, Category.assoc, cokernel.condition, comp_zero]
  · intro h
    have := Subobject.factors_comp_arrow (P := P) (Abelian.monoLift P.arrow f h)
    rwa [Abelian.monoLift_comp] at this

/-- **A morphism of simplicial objects of an abelian category which is invertible in degrees
`≤ n` and whose source has no normalized Moore subobjects above degree `n` is a degreewise
monomorphism.** -/
private lemma mono_app_of_isIso_le_of_objX_eq_bot {V W : SimplicialObject A} (f : V ⟶ W) {n : ℕ}
    (h₁ : ∀ k ≤ n, IsIso (f.app (op ⦋k⦌))) (h₂ : ∀ k, n < k → objX V k = ⊥)
    (Δ : SimplexCategoryᵒᵖ) : Mono (f.app Δ) := by
  refine (NormalizedMooreComplex.mono_epi_isIso_app_iff_map_f f).1.mpr (fun k => ?_) Δ
  rcases le_or_gt k n with hk | hk
  · have := h₁ k hk
    have h :
        Mono (((normalizedMooreComplex A).map f).f k ≫ (inclusionOfMooreComplexMap W).f k) := by
      rw [← inclusionOfMooreComplex_app, ← HomologicalComplex.comp_f,
        (inclusionOfMooreComplex A).naturality f, HomologicalComplex.comp_f,
        alternatingFaceMapComplex_map_f, inclusionOfMooreComplex_app]
      exact mono_comp _ _
    exact mono_of_mono _ ((inclusionOfMooreComplexMap W).f k)
  · have hz : IsZero (((normalizedMooreComplex A).obj V).X k) := by
      rw [normalizedMooreComplex_obj, obj_X, h₂ k hk]
      exact IsZero.of_iso (isZero_zero A) Subobject.botCoeIsoZero
    exact hz.mono _

/-- The counit `i_{n!} sk_n V ⟶ V` is an isomorphism in every degree `≤ n`. -/
public theorem isIso_skAdj_counit_app_app {C : Type*} [Category* C] [HasFiniteColimits C]
    (V : SimplicialObject C) {n : ℕ} (k : SimplexCategoryᵒᵖ) (hk : k.unop.len ≤ n) :
    IsIso (((skAdj n).counit.app V).app k) := by
  have h₁ : IsIso ((skAdj (C := C) n).unit.app ((truncation n).obj V) ≫
      (truncation n).map ((skAdj n).counit.app V)) := by
    rw [(skAdj (C := C) n).right_triangle_components]; exact IsIso.id _
  have h₂ : IsIso ((truncation (C := C) n).map ((skAdj n).counit.app V)) :=
    IsIso.of_isIso_comp_left ((skAdj (C := C) n).unit.app ((truncation n).obj V)) _
  exact NatIso.isIso_app_of_isIso ((truncation (C := C) n).map ((skAdj n).counit.app V))
    (op (⟨k.unop, hk⟩ : SimplexCategory.Truncated n))

end AbelianSkeleton

variable {A : Type u} [Category.{v} A] [Abelian A]

/-- **Stacks 018U**.
Let `U` be a simplicial object of an abelian category `A` and let `n : ℕ`.
The canonical morphism `i_{n!} sk_n U ⟶ U` — the counit of `i_{n!} ⊣ sk_n` — is in each degree
`m` a monomorphism, and the subobject of `U_m` it defines is the least subobject through which
every operator `U(φ) : U_i ⟶ U_m` with `φ : ⦋m⦌ → ⦋i⦌` and `i ≤ n` factors, that is, the sum
`U'_m = Σ_{φ : ⦋m⦌ → ⦋i⦌, i ≤ n} Im(U(φ))`. -/
@[stacks 018U]
public theorem isLeast_subobject_mk_skAdj_counit_app (U : SimplicialObject A) (n m : ℕ) :
    ∃ _ : Mono (((skAdj n).counit.app U).app (op ⦋m⦌)),
      IsLeast {P | ∀ i ≤ n, ∀ φ : (⦋m⦌ : SimplexCategory) ⟶ ⦋i⦌, P.Factors (U.map φ.op)}
        (Subobject.mk (((skAdj n).counit.app U).app (op ⦋m⦌))) := by
  have hmono : Mono (((skAdj n).counit.app U).app (op ⦋m⦌)) :=
    mono_app_of_isIso_le_of_objX_eq_bot ((skAdj n).counit.app U)
      (fun k hk => isIso_skAdj_counit_app_app U (op ⦋k⦌) hk)
      (fun k hk => objX_sk_obj_eq_bot ((truncation n).obj U) hk) (op ⦋m⦌)
  refine ⟨hmono, fun i hi φ => ?_, fun P hP => ?_⟩
  · have := isIso_skAdj_counit_app_app U (op ⦋i⦌) hi
    have h := Subobject.factors_of_factors_right
      (inv (((skAdj n).counit.app U).app (op ⦋i⦌)) ≫ ((sk n).obj U).map φ.op)
      (Subobject.mk_factors_self (((skAdj n).counit.app U).app (op ⦋m⦌)))
    rwa [Category.assoc, NatTrans.naturality, IsIso.inv_hom_id_assoc] at h
  · have hfac : P.Factors (((skAdj n).counit.app U).app (op ⦋m⦌)) := by
      rw [factors_iff_comp_cokernel_π_eq_zero]
      have hpw := Functor.isPointwiseLeftKanExtensionOfIsLeftKanExtension
        ((SimplicialObject.Truncated.sk n).obj ((truncation n).obj U))
        ((SimplexCategory.Truncated.inclusion n).op.lanUnit.app ((truncation n).obj U))
      refine (hpw (op ⦋m⦌)).hom_ext'
        (f := ((skAdj n).counit.app U).app (op ⦋m⦌) ≫ cokernel.π P.arrow) (g := 0)
        fun X φ => ?_
      have hid : ((SimplexCategory.Truncated.inclusion n).op.lanUnit.app
            ((truncation n).obj U)).app X ≫
          ((skAdj n).counit.app U).app
            ((SimplexCategory.Truncated.inclusion n).op.obj X)
          = 𝟙 (((truncation n).obj U).obj X) :=
        Functor.lanUnit_app_app_lanAdjunction_counit_app_app _ _ _
      have hg : ((𝟭 (SimplicialObject A)).obj U).map φ ≫ cokernel.π P.arrow = 0 :=
        (factors_iff_comp_cokernel_π_eq_zero P _).mp (hP X.unop.obj.len X.unop.property φ.unop)
      dsimp only [Functor.LeftExtension.mk, StructuredArrow.mk_hom_eq_self]
      rw [comp_zero, comp_zero, NatTrans.naturality_assoc, reassoc_of% hid, hg]
    exact Subobject.mk_le_of_comm (P.factorThru _ hfac) (P.factorThru_arrow _ hfac)

end CategoryTheory.SimplicialObject

namespace CategoryTheory.SimplicialObject

open Opposite Simplicial

section HomOutOfSkeleton

/-- Naturality in the extension of the bijection `Mor(G, F') = Mor(L ⋙ G, F)` attached to a right
Kan extension `(F', α)` of `F` along `L`: if `β : F₁' ⟶ F₂'` lies over `γ : F₁ ⟶ F₂`, meaning that
`(L ⋙ β) ≫ α₂ = α₁ ≫ γ`, then postcomposing with `β` on the left corresponds to postcomposing
with `γ` on the right. -/
public lemma homEquivOfIsRightKanExtension_naturality_right {D₁ D₂ H : Type*} [Category D₁]
    [Category D₂] [Category H] {L : D₁ ⥤ D₂} {F₁ F₂ : D₁ ⥤ H} {F₁' F₂' : D₂ ⥤ H}
    {α₁ : L ⋙ F₁' ⟶ F₁} {α₂ : L ⋙ F₂' ⟶ F₂} [F₁'.IsRightKanExtension α₁]
    [F₂'.IsRightKanExtension α₂] {β : F₁' ⟶ F₂'} {γ : F₁ ⟶ F₂}
    (h : Functor.whiskerLeft L β ≫ α₂ = α₁ ≫ γ) (G : D₂ ⥤ H) (g : G ⟶ F₁') :
    Functor.homEquivOfIsRightKanExtension F₂' α₂ G (g ≫ β) =
      Functor.homEquivOfIsRightKanExtension F₁' α₁ G g ≫ γ := by
  ext X
  simpa using congrArg (g.app (L.obj X) ≫ ·) (NatTrans.congr_app h X)

variable {C : Type u} [Category.{v} C] (n : ℕ)
  [∀ F : (SimplexCategory.Truncated n)ᵒᵖ ⥤ C,
    (SimplexCategory.Truncated.inclusion n).op.HasPointwiseRightKanExtension F]
  (V : SimplicialObject C)

/-- The counit `sk_n cosk_n sk_n V ⟶ sk_n V` of the coskeleton, after applying
`G_X = Mor_C(X, -)`. -/
private noncomputable abbrev coyonedaCounit (X : C) :
    (SimplexCategory.Truncated.inclusion n).op ⋙ (((cosk n).obj V) ⋙ coyoneda.obj (op X)) ⟶
      ((truncation n).obj V) ⋙ coyoneda.obj (op X) :=
  (Functor.associator (SimplexCategory.Truncated.inclusion n).op ((cosk n).obj V)
      (coyoneda.obj (op X))).inv ≫
    Functor.whiskerRight ((coskAdj n).counit.app ((truncation n).obj V)) (coyoneda.obj (op X))

/-- Since `G_X = Mor_C(X, -)` preserves limits and `cosk_n sk_n V` is a *pointwise* right Kan
extension of `sk_n V`, the simplicial set `(cosk_n sk_n V) ⋙ G_X` is a right Kan extension of
`(sk_n V) ⋙ G_X`. This is the whole content of the result below. -/
private lemma isRightKanExtension_comp_coyoneda (X : C) :
    (((cosk n).obj V) ⋙ coyoneda.obj (op X)).IsRightKanExtension (coyonedaCounit n V X) :=
  Functor.PreservesRightKanExtension.preserves
    (G := coyoneda.obj (op X)) (F := (truncation n).obj V)
    (L := (SimplexCategory.Truncated.inclusion n).op)
    ((cosk n).obj V) ((coskAdj n).counit.app ((truncation n).obj V))

attribute [local instance] isRightKanExtension_comp_coyoneda

/-- The interchange law between the counit of the coskeleton and the transformation
`G_{X'} ⟶ G_X` induced by a morphism `f : X ⟶ X'`. -/
private lemma whiskerLeft_comp_coyonedaCounit {X X' : C} (f : X ⟶ X') :
    Functor.whiskerLeft (SimplexCategory.Truncated.inclusion n).op
        (Functor.whiskerLeft ((cosk n).obj V) (coyoneda.map f.op)) ≫ coyonedaCounit n V X =
      coyonedaCounit n V X' ≫ Functor.whiskerLeft (SimplexCategory.Truncated.inclusion n).op
        (Functor.whiskerLeft V (coyoneda.map f.op)) :=
  NatTrans.ext (funext fun _ => ((coyoneda.map f.op).naturality _).symm)

variable (m : ℕ)

/-- The bijection: `Mor_C(X, (cosk_n sk_n V)_m) = Mor_{SSet}(i_{n!} sk_n Δ[m], G_X V)` is the
Yoneda lemma, followed by the universal property of the right Kan extension
`(cosk_n sk_n V) ⋙ G_X`, followed by the adjunction `i_{n!} ⊣ sk_n`. -/
private noncomputable def coyonedaHomEquiv (X : C) :
    (X ⟶ ((cosk n).obj V) _⦋m⦌) ≃ ((sk n).obj Δ[m] ⟶ V ⋙ coyoneda.obj (op X)) :=
  (SSet.yonedaEquiv (X := ((cosk n).obj V) ⋙ coyoneda.obj (op X)) (n := ⦋m⦌)).symm.trans
    ((Functor.homEquivOfIsRightKanExtension (((cosk n).obj V) ⋙ coyoneda.obj (op X))
        (coyonedaCounit n V X) Δ[m]).trans
      ((skAdj n).homEquiv ((truncation n).obj Δ[m]) (V ⋙ coyoneda.obj (op X))).symm)

/-- Naturality in `X` of the bijection `coyonedaHomEquiv`: the three steps are compatible with
the transformation `G_{X'} ⟶ G_X` induced by `f : X ⟶ X'`. -/
private lemma coyonedaHomEquiv_comp {X X' : C} (f : X ⟶ X') (g : X' ⟶ ((cosk n).obj V) _⦋m⦌) :
    coyonedaHomEquiv n V m X (f ≫ g) =
      coyonedaHomEquiv n V m X' g ≫ Functor.whiskerLeft V (coyoneda.map f.op) := by
  have hy : SSet.yonedaEquiv.symm (f ≫ g) = SSet.yonedaEquiv.symm g ≫
      Functor.whiskerLeft ((cosk n).obj V) (coyoneda.map f.op) := by
    rw [SSet.yonedaEquiv_symm_comp]; rfl
  refine Eq.trans (congrArg ((skAdj n).homEquiv ((truncation n).obj Δ[m])
    (V ⋙ coyoneda.obj (op X))).symm ?_) ((skAdj n).homEquiv_naturality_right_symm _ _)
  rw [hy]
  exact homEquivOfIsRightKanExtension_naturality_right (whiskerLeft_comp_coyonedaCounit n V f) _ _

end HomOutOfSkeleton

/-- **Stacks 018V**.
Let `V` be a simplicial object of a category `C` and let `n m : ℕ`, and assume the `n`-th
coskeleton of `C` exists pointwise, as it does when `C` has finite limits. Then the object of
`m`-simplices of `cosk_n sk_n V` represents the presheaf
`X ↦ Mor_{Simp(C)}(X × i_{n!} sk_n Δ[m], V)` on `C`, equally
`X ↦ Mor_{SSet}(i_{n!} sk_n Δ[m], V ⋙ coyoneda.obj (op X))`; that is,
`(cosk_n sk_n V)_m = Hom(i_{n!} sk_n Δ[m], V)₀`. For `m = n + 1` the simplicial
set `i_{n!} sk_n Δ[n + 1]` is the boundary `∂Δ[n + 1]`, and a morphism
`X ⟶ (cosk_n sk_n V)_{n + 1}` is a matching family of `(n + 1)`-simplices of `V` with values in
`X`. -/
@[stacks 018V "stated in an arbitrary degree `m`, the source's display being the case \
  `m = n + 1`, and as representability of the presheaf that the source's `Hom(-, V)₀` \
  represents, so that neither finite coproducts nor Tag 017L is needed"]
public theorem nonempty_representableBy_hom_sk_stdSimplex {C : Type u} [Category.{v} C] (n : ℕ)
    [∀ F : (SimplexCategory.Truncated n)ᵒᵖ ⥤ C,
      (SimplexCategory.Truncated.inclusion n).op.HasPointwiseRightKanExtension F]
    (V : SimplicialObject C) (m : ℕ) :
    Nonempty ((coyoneda ⋙ (Functor.whiskeringLeft SimplexCategoryᵒᵖ C (Type v)).obj V ⋙
      coyoneda.obj (op ((sk n).obj Δ[m]))).RepresentableBy (((cosk n).obj V) _⦋m⦌)) :=
  ⟨{ homEquiv := coyonedaHomEquiv n V m _
     homEquiv_comp := coyonedaHomEquiv_comp n V m }⟩

end CategoryTheory.SimplicialObject

end

/-!
## The colimit of a truncated simplicial object over a truncated coslice category

Let `C` be a category and let `U` be an `m`-truncated simplicial object of `C`, that is a functor
`(Δ_{≤ m})ᵒᵖ ⥤ C`, where `Δ_{≤ m}` is the full subcategory of the simplex category on the objects
`[k]` with `k ≤ m`; write `U_k = U([k])`. For an object `[n]` of `Δ_{≤ m}` the comma category
`([n]/Δ)_{≤ m}` has as objects the morphisms `α : [n] → [k]` of `Δ` with `k ≤ m`, and as morphisms
`α' → α` the maps `ψ : [k'] → [k]` with `ψ ∘ α' = α`; the diagram
`U(n) : (([n]/Δ)_{≤ m})ᵒᵖ ⥤ C` sends such an `α` to `U_k` and such a `ψ` to `U(ψ)`. Then the
colimit of `U(n)` exists in `C` and is canonically isomorphic to `U_n`: the cocone with apex `U_n`
whose leg at `α : [n] → [k]` is `U(α) : U_k → U_n` is a colimit cocone. This is because
`id_{[n]} : [n] → [n]` is an initial object of `([n]/Δ)_{≤ m}`, hence a terminal object of the
opposite category, where the colimit of a diagram is its value.

### Main definitions

* `underDiagram`: the diagram `U(n) : (([n]/Δ)_{≤ m})ᵒᵖ ⥤ C`.
* `underTerminalIdOp`: `id_{[n]}` is a terminal object of `(([n]/Δ)_{≤ m})ᵒᵖ`.
* `underCocone`: the cocone on `U(n)` with apex `U_n` and leg `U(α)` at `α : [n] → [k]`.

### Main results

* `underCocone_isColimit`: `underCocone` is a colimit cocone.
* `hasColimit_underDiagram`: the diagram `U(n)` has a colimit in `C`.
* `nonempty_colimit_underDiagram_iso`: that colimit is isomorphic to `U_n`.

### References

* [Stacks, Tag 018M](https://stacks.math.columbia.edu/tag/018M)
-/

section

@[expose] public section

open CategoryTheory Limits Opposite

namespace CategoryTheory.SimplicialObject.Truncated

variable {C : Type*} [Category C] {m : ℕ}
variable (U : SimplicialObject.Truncated C m) (n : SimplexCategory.Truncated m)

/-- The diagram `U(n) : (([n]/Δ)_{≤ m})ᵒᵖ ⥤ C`, the composite of the opposite of the forgetful
functor `Under.forget n : ([n]/Δ)_{≤ m} → Δ_{≤ m}`, `(α : [n] → [k]) ↦ [k]`, with `U`. It sends an
object `α : [n] → [k]` to `U_k` and a morphism `ψ` to `U(ψ)`. -/
noncomputable def underDiagram : (Under n)ᵒᵖ ⥤ C := (Under.forget n).op ⋙ U

/-- The identity `id_{[n]} : [n] → [n]` is initial in `([n]/Δ)_{≤ m} = Under n`, hence its image
in the opposite category is terminal. -/
noncomputable def underTerminalIdOp : IsTerminal (op (Under.mk (𝟙 n))) :=
  terminalOpOfInitial Under.mkIdInitial

/-- The cocone on `U(n)` whose apex is `U_n = U([n])`, definitionally `U.obj (op n)`, and whose
leg at an object `α : [n] → [k]` is `U(α) : U_k → U_n`. -/
noncomputable def underCocone : Cocone (underDiagram U n) :=
  coconeOfDiagramTerminal (underTerminalIdOp n) (underDiagram U n)

/-- The apex of the canonical cocone is `U_n`. -/
example : (underCocone U n).pt = U.obj (op n) := rfl

/-- **Stacks 018M**.
Let `C` be a category and let `U` be an `m`-truncated simplicial object of `C`. For an object
`[n]` of `Δ_{≤ m}` the cocone `underCocone`, with apex `U_n` and leg `U(α) : U_k → U_n` at an
object `α : [n] → [k]`, exhibits `U_n` as the colimit of the diagram `U(n)`. -/
@[stacks 018M]
theorem underCocone_isColimit : Nonempty (IsColimit (underCocone U n)) :=
  ⟨colimitOfDiagramTerminal (underTerminalIdOp n) (underDiagram U n)⟩

/-- The colimit of `U(n)` over `(([n]/Δ)_{≤ m})ᵒᵖ` exists in `C`, with no cocompleteness
hypothesis on `C`. -/
theorem hasColimit_underDiagram : HasColimit (underDiagram U n) :=
  HasColimit.mk ⟨underCocone U n, colimitOfDiagramTerminal (underTerminalIdOp n) (underDiagram U n)⟩

/-- There is a canonical isomorphism `colim U(n) ≅ U_n`. -/
theorem nonempty_colimit_underDiagram_iso [HasColimit (underDiagram U n)] :
    Nonempty (colimit (underDiagram U n) ≅ U.obj (op n)) :=
  ⟨colimit.isoColimitCocone
    ⟨underCocone U n, colimitOfDiagramTerminal (underTerminalIdOp n) (underDiagram U n)⟩⟩

end CategoryTheory.SimplicialObject.Truncated

end

end

/-!
## Simplices of a left-adjoint extension above the truncation level are degenerate

Let `Δ` be the simplex category, the finite nonempty ordinals `[k] = {0, 1, …, k}` with the
order-preserving maps, and for `m : ℕ` let `Δ_{≤ m}` be its full subcategory on the objects `[k]`
with `k ≤ m`. Restriction along `Δ_{≤ m} ⊆ Δ` is the truncation functor
`sk_m : SSet ⥤ SSet.Truncated m`, and it admits a left adjoint
`i_{m!} = SSet.Truncated.sk m : SSet.Truncated m ⥤ SSet`, characterized by
`Mor(i_{m!} U, V) = Mor(U, sk_m V)`. An `n`-simplex of a simplicial set `V` is degenerate when it
lies in the range of `V(φ)` for some `φ : [n] → [k]` with `k < n`.

For an `m`-truncated simplicial set `U` and `n > m`, every `n`-simplex of `i_{m!} U` is
degenerate. Indeed `i_{m!} U` is a pointwise left Kan extension of `U` along `Δ_{≤ m} ⊆ Δ`, so
every `n`-simplex of it is the image of a `k`-simplex under the map induced by some `[n] → [k]`
with `k ≤ m`, and `k ≤ m < n`.

### Main results

* `SSet.Truncated.mem_degenerate_sk_obj`: for `n > m`, every `n`-simplex of `i_{m!} U` lies in
  `SSet.degenerate _ n`.
* `SSet.Truncated.exists_surjective_eq_map_of_sk_obj`: the same statement with a surjection
  `φ : [n] → [k]`, `k < n`, and the `k`-simplex the given `n`-simplex comes from, exhibited.

### References

* [Stacks, Tag 018O](https://stacks.math.columbia.edu/tag/018O)
-/

section

@[expose] public section

open CategoryTheory SimplexCategory SSet Opposite

namespace SSet.Truncated

/-- **Stacks 018O**.
For an `m`-truncated simplicial set `U` and `n > m`, every `n`-simplex of
`i_{m!} U = (SSet.Truncated.sk m).obj U` is degenerate. -/
@[stacks 018O]
theorem mem_degenerate_sk_obj (m : ℕ) (U : SSet.Truncated m) (n : ℕ) (hn : m < n)
    (x : ((Truncated.sk m).obj U).obj (op (SimplexCategory.mk n))) :
    x ∈ ((Truncated.sk m).obj U).degenerate n :=
  mem_degenerate_sk_obj_of_lt U hn x

/-- For an `m`-truncated simplicial set `U` and `n > m`, every `n`-simplex `x` of `i_{m!} U`
equals `V(φ)(y)` for some `k < n`, some surjective order-preserving map `φ : [n] → [k]` and some
`k`-simplex `y`. -/
theorem exists_surjective_eq_map_of_sk_obj (m : ℕ) (U : SSet.Truncated m) (n : ℕ) (hn : m < n)
    (x : ((Truncated.sk m).obj U).obj (op (SimplexCategory.mk n))) :
    ∃ (k : ℕ) (_ : k < n) (φ : SimplexCategory.mk n ⟶ SimplexCategory.mk k)
      (_ : Function.Surjective (SimplexCategory.Hom.toOrderHom φ))
      (y : ((Truncated.sk m).obj U).obj (op (SimplexCategory.mk k))),
      x = ((Truncated.sk m).obj U).map φ.op y := by
  obtain ⟨k₀, hk₀, φ, y, rfl⟩ := exists_eq_map_of_sk_obj U x
  have hk' : (Limits.image φ).len < n := by
    have : (Limits.image φ).len ≤ k₀ := SimplexCategory.len_le_of_mono (Limits.image.ι φ)
    omega
  refine ⟨_, hk', Limits.factorThruImage φ, ?_, ((Truncated.sk m).obj U).map
    (Limits.image.ι φ).op y, ?_⟩
  · exact SimplexCategory.epi_iff_surjective.mp inferInstance
  · rw [← Functor.map_comp_apply, ← op_comp, Limits.image.fac]

end SSet.Truncated

namespace SSet

universe u

/-- **Stacks 017T**.
The sub-simplicial set generated by the simplices of `X` in degrees at most `n` is
`X.skeleton (n + 1)`. It agrees with `X` through degree `n`, and every simplex in a higher degree
is degenerate. -/
@[stacks 017T]
public theorem skeleton_obj_eq_top_and_hasDimensionLE (X : SSet.{u}) (n : ℕ) :
    (∀ i : ℕ, i ≤ n → (X.skeleton (n + 1)).obj (op (SimplexCategory.mk i)) = ⊤) ∧
      HasDimensionLE (X.skeleton (n + 1) : SSet) n := by
  refine ⟨fun i hi => X.skeleton_obj_eq_top (by omega), ?_⟩
  obtain ⟨e, _⟩ := exists_iso_skeleton_hom_ι_eq_skAdj_counit X n
  show HasDimensionLT (X.skeleton (n + 1) : SSet) (n + 1)
  rw [← hasDimensionLT_iff_of_iso e (n + 1)]
  constructor
  intro m hm
  ext x
  simp only [Set.top_eq_univ, Set.mem_univ, iff_true]
  exact Truncated.mem_degenerate_sk_obj n ((truncation n).obj X) m (by omega) x

end SSet

end

end
