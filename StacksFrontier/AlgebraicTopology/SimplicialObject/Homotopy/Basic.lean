@[expose] public section

open CategoryTheory CategoryTheory.Limits Simplicial SSet

universe w v v' u u' t t'

namespace CategoryTheory.SimplicialObject

section Copower

variable {J : Type t} [Category.{t'} J] {C : Type u} [Category.{v} C] {V W : J ⥤ C}
  {X : J ⥤ Type w} [∀ j, HasCoproduct fun _ : X.obj j => V.obj j]

/-- The morphism `V.copower X ⟶ W` out of a copower determined by a family of morphisms
`κ j : X j → (V j ⟶ W j)` compatible with the structure maps, in degree `j` the morphism
`∐_{u ∈ X j} V j ⟶ W j` with components the `κ j u`. -/
private noncomputable def copowerDesc (κ : ∀ j, X.obj j → (V.obj j ⟶ W.obj j))
    (hκ : ∀ ⦃i j : J⦄ (f : i ⟶ j) (u : X.obj i), V.map f ≫ κ j (X.map f u) = κ i u ≫ W.map f) :
    V.copower X ⟶ W where
  app j := Limits.Sigma.desc (κ j)
  naturality _ _ f := by
    apply Sigma.hom_ext
    intro u
    simp [Functor.copower, hκ f u]

/-- The restriction of `copowerDesc κ hκ` to the summand of `∐_{u ∈ X j} V j` indexed by `u`
is `κ j u`. -/
private lemma ι_comp_copowerDesc_app (κ : ∀ j, X.obj j → (V.obj j ⟶ W.obj j))
    (hκ : ∀ ⦃i j : J⦄ (f : i ⟶ j) (u : X.obj i), V.map f ≫ κ j (X.map f u) = κ i u ≫ W.map f)
    (j : J) (u : X.obj j) :
    Sigma.ι (fun _ : X.obj j => V.obj j) u ≫ (copowerDesc κ hκ).app j = κ j u :=
  Limits.Sigma.ι_desc _ _

section Whisker

variable {D : Type u'} [Category.{v'} D] (F : C ⥤ D)
  [∀ j, HasCoproduct fun _ : X.obj j => (V ⋙ F).obj j]

/-- **The comparison morphism between the two copowers attached to a functor `F : C ⥤ D`**,
from the copower of `V ⋙ F` to the image of the copower of `V`, in degree `j` the morphism
`∐_{u ∈ X j} F(V j) ⟶ F(∐_{u ∈ X j} V j)` with components the `F(ι_u)`. It exists for every `F`,
and is an isomorphism exactly when `F` preserves the coproducts in question. -/
private noncomputable def copowerComparison : (V ⋙ F).copower X ⟶ V.copower X ⋙ F :=
  copowerDesc (fun j u => F.map (Sigma.ι (fun _ : X.obj j => V.obj j) u))
    fun {_ _} f u => (F.map_comp _ _).symm.trans
      ((congrArg F.map (Sigma.ι_comp_map' (f := fun _ : X.obj _ => V.obj _)
        (g := fun _ : X.obj _ => V.obj _) (X.map f) (fun _ => V.map f) u).symm).trans
        (F.map_comp _ _))

/-- The restriction of the comparison morphism to the summand indexed by `u` is `F(ι_u)`. -/
private lemma ι_comp_copowerComparison_app (j : J) (u : X.obj j) :
    Sigma.ι (fun _ : X.obj j => (V ⋙ F).obj j) u ≫ (copowerComparison F).app j =
      F.map (Sigma.ι (fun _ : X.obj j => V.obj j) u) :=
  ι_comp_copowerDesc_app _ _ j u

/-- The image of a morphism `k : V.copower X ⟶ W` out of a copower, transported along the
comparison morphism to a morphism `(V ⋙ F).copower X ⟶ W ⋙ F`, restricts on the summand
indexed by `u` to `F` applied to the restriction of `k` to that summand. -/
private lemma ι_comp_copowerComparison_comp_whiskerRight_app (k : V.copower X ⟶ W) (j : J)
    (u : X.obj j) :
    Sigma.ι (fun _ : X.obj j => (V ⋙ F).obj j) u ≫
        (copowerComparison F ≫ Functor.whiskerRight k F).app j =
      F.map (Sigma.ι (fun _ : X.obj j => V.obj j) u ≫ k.app j) :=
  (Category.assoc _ _ _).symm.trans
    ((ι_comp_copowerComparison_app F j u =≫ F.map (k.app j)).trans (F.map_comp _ _).symm)

end Whisker

end Copower

variable {C : Type u} [Category.{v} C] {D : Type u'} [Category.{v'} D]

/-- **Stacks 019M**.
Functors preserve homotopies of simplicial objects. Let `F : C ⥤ D` be any functor between any two
categories, let `U`, `V` be simplicial objects of `C`, and let `a, b : U ⟶ V`. If
`k : U × Δ[1] ⟶ V` is a homotopy from `a` to `b` in the sense of [Stacks, Tag 019K], then there is
a homotopy `l : F(U) × Δ[1] ⟶ F(V)` from `F(a)` to `F(b)` whose component at each simplex
`α ∈ Δ[1]_m` is `F` applied to the component of `k` at `α`; in the notation of [Stacks, Tag 019L],
`l` is the family `{F(h_{m, i})}`. No compatibility of `F` with the coproducts making up the two
products with `Δ[1]` is required. -/
@[stacks 019M "the remark's concluding deduction: a functor preserves the notion of homotopy \
  of 019K whenever the two products with `Δ[1]` exist, with the transported homotopy pinned to \
  the family `{F(h_{n, i})}` rather than merely asserted to exist. The remark's other content \
  is already in Mathlib or is a composite of existing declarations, see the module docstring: \
  the notion of homotopy for an arbitrary category is `SimplicialObject.Homotopy`, its \
  preservation by a functor is `SimplicialObject.Homotopy.whiskerRight`, and being homotopic \
  is `Relation.EqvGen fun a b => ∃ h, IsHomotopy h a b` as in 019K"]
public theorem IsHomotopy.exists_whiskerRight {U V : SimplicialObject C}
    [∀ m, HasCoproduct fun _ : (Δ[1] : SSet.{w}).obj m => U.obj m] (F : C ⥤ D)
    [∀ m, HasCoproduct fun _ : (Δ[1] : SSet.{w}).obj m => (U ⋙ F).obj m]
    {a b : U ⟶ V} {k : U.copower Δ[1] ⟶ V} (hk : IsHomotopy k a b) :
    ∃ l : (U ⋙ F).copower Δ[1] ⟶ V ⋙ F,
      (∀ (m : SimplexCategoryᵒᵖ) (α : (Δ[1] : SSet.{w}).obj m),
          Sigma.ι (fun _ : (Δ[1] : SSet.{w}).obj m => (U ⋙ F).obj m) α ≫ l.app m =
            F.map (Sigma.ι (fun _ : (Δ[1] : SSet.{w}).obj m => U.obj m) α ≫ k.app m)) ∧
        IsHomotopy l (Functor.whiskerRight a F) (Functor.whiskerRight b F) :=
  ⟨copowerComparison F ≫ Functor.whiskerRight k F,
    ι_comp_copowerComparison_comp_whiskerRight_app F k,
    fun m => (ι_comp_copowerComparison_comp_whiskerRight_app F k m _).trans
      (congrArg F.map (hk.1 m)),
    fun m => (ι_comp_copowerComparison_comp_whiskerRight_app F k m _).trans
      (congrArg F.map (hk.2 m))⟩

end CategoryTheory.SimplicialObject

end

end

/-!
## Homotopy equivalences of simplicial objects

Let `C` be a category, with no assumptions whatsoever, and let `U`, `V` be simplicial objects
of `C`. Two morphisms `f, g : U ⟶ V` are *homotopic* when they are related by the equivalence
relation generated by the existence of a simplicial homotopy, that is, when there is a chain
`f = f₀, f₁, …, f_n = g` in which each consecutive pair carries a homotopy in one direction or
the other ([Stacks, Tag 019M]). A morphism `a : U ⟶ V` is a *homotopy equivalence* when there
is a morphism `b : V ⟶ U` with `a ∘ b` homotopic to `𝟙 V` and `b ∘ a` homotopic to `𝟙 U`, and
`U` and `V` are *homotopy equivalent* when some `a : U ⟶ V` is a homotopy equivalence.

### Main definitions

* `CategoryTheory.SimplicialObject.homotopyEquivalences`: the morphism property on
  `SimplicialObject C` consisting of the homotopy equivalences.

### References

* [Stacks, Tag 019N](https://stacks.math.columbia.edu/tag/019N)
-/

section

@[expose] public section

open CategoryTheory

universe v u

namespace CategoryTheory.SimplicialObject

variable (C : Type u) [Category.{v} C]

/-- **Stacks 019N** (the first sentence).
Let `C` be any category. A morphism `a : U ⟶ V` of simplicial objects of `C` is a *homotopy
equivalence* if there is a morphism `b : V ⟶ U` such that `a ≫ b` is homotopic to `𝟙 U` and
`b ≫ a` is homotopic to `𝟙 V`, where two morphisms are *homotopic* when they are related by the
equivalence relation generated by the existence of a simplicial homotopy ([Stacks, Tag 019M]). The
simplicial objects `U` and `V` are *homotopy equivalent* when some `a : U ⟶ V` is a homotopy
equivalence, that is, when `∃ a : U ⟶ V, homotopyEquivalences C a`. -/
@[stacks 019N "the first sentence; being homotopy equivalent, the second sentence, is the \
  composite `∃ a : U ⟶ V, homotopyEquivalences C a` and gets no name, as in Mathlib for \
  complexes, where it is `Nonempty (HomotopyEquiv K L)`. Stated as a `MorphismProperty`, the \
  shape of the sibling `HomologicalComplex.homotopyEquivalences`; being homotopic is \
  `Relation.EqvGen fun f g => Nonempty (Homotopy f g)` as in 019S"]
public def homotopyEquivalences : MorphismProperty (SimplicialObject C) :=
  fun U V a => ∃ b : V ⟶ U,
    Relation.EqvGen (fun f g : U ⟶ U => Nonempty (Homotopy f g)) (a ≫ b) (𝟙 U) ∧
      Relation.EqvGen (fun f g : V ⟶ V => Nonempty (Homotopy f g)) (b ≫ a) (𝟙 V)

end CategoryTheory.SimplicialObject

end

end

/-!
## Homotopy classes of morphisms of simplicial objects form a category

Let `C` be a category, with no assumptions whatsoever, and let `U`, `V` be simplicial objects of
`C`. Following [Stacks, Tag 019M], a *homotopy* from `a : U ⟶ V` to `a' : U ⟶ V` is a family of
morphisms `h_{n,i} : Uₙ ⟶ Vₙ` satisfying the relations of [Stacks, Tag 019L]; this is Mathlib's
`CategoryTheory.SimplicialObject.Homotopy a a'` (recorded there through the composites
`h_{n+1,i+1} ∘ sⁿᵢ : Uₙ ⟶ V_{n+1}`, the convention of the footnote to 019M). The relation "there
is a homotopy from `a` to `a'`" is reflexive ([Stacks, Tag 07KA], Mathlib's `Homotopy.refl`) but in
general neither symmetric nor transitive, so the source calls `a` and `a'` *homotopic* when they
are joined by a chain `a = a₀, a₁, …, a_n = a'` admitting at each step a homotopy in one direction
or the other ([Stacks, Tag 019K] (2), [Stacks, Tag 019M]): that is, the equivalence relation
generated by "there is a homotopy from `a` to `a'`", written below as
`Relation.EqvGen fun a a' ↦ Nonempty (Homotopy a a')`.

The content of this remark is that being homotopic is compatible with composition: it is a
`CategoryTheory.Congruence` on `SimplicialObject C`. Consequently `CategoryTheory.Quotient` of it
*is* the source's `hSimp(C)` — the category with the same objects as `Simp(C) = SimplicialObject C`
and with the homotopy classes of morphisms as its morphisms, the last clause being
`CategoryTheory.Quotient.functor_map_eq_iff`, whose hypothesis is exactly the congruence property
stated here — and `CategoryTheory.Quotient.functor` is the canonical functor
`Simp(C) ⟶ hSimp(C)`, which is surjective on objects, in particular essentially surjective
(`Quotient.essSurj_functor`), and full, i.e. surjective on sets of morphisms
(`Quotient.full_functor`).

### Main results

* `CategoryTheory.SimplicialObject.congruence_homotopic`: on morphisms of simplicial objects of an
  arbitrary category, being homotopic — the equivalence relation generated by the existence of a
  simplicial homotopy — is a congruence, so that homotopy classes of morphisms are the morphisms
  of a category.

### References

* [Stacks, Tag 08RJ](https://stacks.math.columbia.edu/tag/08RJ)
-/

section

open CategoryTheory

universe v u

namespace CategoryTheory.SimplicialObject

variable (C : Type u) [Category.{v} C]

/-- The equivalence closure of a relation is functorial: a map `F` carrying `r` into `s` carries
the equivalence relation generated by `r` into the one generated by `s`. -/
public theorem _root_.Relation.EqvGen.map {α β : Type*} {r : α → α → Prop} {s : β → β → Prop}
    (F : α → β) (hF : ∀ a a', r a a' → s (F a) (F a')) {a a' : α}
    (h : Relation.EqvGen r a a') : Relation.EqvGen s (F a) (F a') := by
  induction h with
  | rel a a' h => exact .rel _ _ (hF _ _ h)
  | refl a => exact .refl _
  | symm a a' _ ih => exact .symm _ _ ih
  | trans a a' a'' _ _ ih ih' => exact .trans _ _ _ ih ih'

/-- **Stacks 08RJ**.
Let `C` be any category. Being homotopic — the equivalence relation on morphisms of simplicial
objects of `C` generated by the existence of a simplicial homotopy — is a congruence: if `a` and
`a'` are homotopic then so are `b ∘ a` and `b ∘ a'` for any `b : V ⟶ W`, and so are `a ∘ c` and
`a' ∘ c` for any `c : X ⟶ U`. Hence `CategoryTheory.Quotient` of this relation is the source's
`hSimp(C)`, the category whose objects are the simplicial objects of `C` and whose morphisms are
the homotopy classes of morphisms of simplicial objects, and `CategoryTheory.Quotient.functor` is
the canonical functor `Simp(C) ⟶ hSimp(C)`, essentially surjective and surjective on sets of
morphisms. -/
@[stacks 08RJ]
public theorem congruence_homotopic :
    Congruence fun (U V : SimplicialObject C) (a a' : U ⟶ V) ↦
      Relation.EqvGen (fun a a' : U ⟶ V ↦ Nonempty (Homotopy a a')) a a' :=
  { equivalence := Relation.EqvGen.is_equivalence _
    comp_left := fun f => Relation.EqvGen.map (f ≫ ·) fun _ _ ⟨H⟩ => ⟨H.precomp f⟩
    comp_right := fun g => Relation.EqvGen.map (· ≫ g) fun _ _ ⟨H⟩ => ⟨H.postcomp g⟩ }

end CategoryTheory.SimplicialObject

end
