@[expose] public section

open CategoryTheory CategoryTheory.Limits Simplicial Opposite SSet

universe w v u

namespace SSet.stdSimplex

/-- The `n`-simplex `objMk₁ 0` of `Δ[1]` is the constant simplex of value `1`. -/
lemma objMk₁_zero (n : ℕ) : objMk₁.{w} (0 : Fin (n + 2)) = const 1 1 (op ⦋n⦌) := by
  ext j
  simp [objMk₁_apply, const]

/-- The `n`-simplex `objMk₁ (Fin.last (n + 1))` of `Δ[1]` is the constant simplex of value `0`. -/
lemma objMk₁_last (n : ℕ) : objMk₁.{w} (Fin.last (n + 1)) = const 1 0 (op ⦋n⦌) := by
  ext j
  simp [objMk₁_apply, const]

/-- The morphism of `SimplexCategory` underlying the simplex `objMk₁ i` of `Δ[1]` is
`SimplexCategory.toMk₁ i`. -/
lemma objEquiv_objMk₁ {n : ℕ} (i : Fin (n + 2)) :
    objEquiv (objMk₁.{w} i) = SimplexCategory.toMk₁ i := by
  ext j : 3
  rw [objEquiv_toOrderHom_apply, objMk₁_apply]
  exact (SimplexCategory.toMk₁_apply i j).symm

end SSet.stdSimplex

namespace CategoryTheory.SimplicialObject

variable {C : Type u} [Category.{v} C]

section

variable {U V : SimplicialObject C} [∀ m, HasCoproduct fun _ : (Δ[1] : SSet.{w}).obj m => U.obj m]

/-- The component `h_{n, i} : U_n ⟶ V_n` of `h : U × Δ[1] ⟶ V`, the restriction of `h_n` to the
summand `U_n · α^n_i` indexed by the `n`-simplex `α^n_i = stdSimplex.objMk₁ i` of `Δ[1]`. -/
noncomputable def homotopyComponent (h : U.copower Δ[1] ⟶ V) (n : ℕ) (i : Fin (n + 2)) :
    U.obj (op ⦋n⦌) ⟶ V.obj (op ⦋n⦌) :=
  Sigma.ι (fun _ : (Δ[1] : SSet.{w}).obj (op ⦋n⦌) => U.obj (op ⦋n⦌)) (stdSimplex.objMk₁ i) ≫
    h.app _

/-- A structure map of `V` after the restriction of `h : U × Δ[1] ⟶ V` to the summand indexed by
a simplex `x` of `Δ[1]` is the corresponding structure map of `U` followed by the restriction of
`h` to the summand indexed by the image of `x`. -/
@[reassoc]
lemma ι_comp_app_comp_map (h : U.copower Δ[1] ⟶ V) {m m' : SimplexCategoryᵒᵖ} (φ : m ⟶ m')
    (x : (Δ[1] : SSet.{w}).obj m) :
    Sigma.ι (fun _ : (Δ[1] : SSet.{w}).obj m => U.obj m) x ≫ h.app m ≫ V.map φ =
      U.map φ ≫ Sigma.ι (fun _ : (Δ[1] : SSet.{w}).obj m' => U.obj m') (Δ[1].map φ x) ≫
        h.app m' := by
  rw [← h.naturality, Functor.copower_map, Sigma.ι_comp_map'_assoc]

/-- A face map of `V` after the restriction of `h` to the summand indexed by `x` is the face map of
`U` followed by the restriction of `h` to the summand indexed by the image of `x`. -/
private lemma ι_comp_app_comp_δ (h : U.copower Δ[1] ⟶ V) {n : ℕ} (j : Fin (n + 2))
    (x : (Δ[1] : SSet.{w}).obj (op ⦋n + 1⦌)) :
    Sigma.ι (fun _ : (Δ[1] : SSet.{w}).obj (op ⦋n + 1⦌) => U.obj (op ⦋n + 1⦌)) x ≫ h.app _ ≫
        V.δ j =
      U.δ j ≫ Sigma.ι (fun _ : (Δ[1] : SSet.{w}).obj (op ⦋n⦌) => U.obj (op ⦋n⦌)) (Δ[1].δ j x) ≫
        h.app _ := by
  rw [SimplicialObject.δ_def, ι_comp_app_comp_map, ← SimplicialObject.δ_def U,
    ← SimplicialObject.δ_def Δ[1]]

/-- A degeneracy map of `V` after the restriction of `h` to the summand indexed by `x` is the
degeneracy map of `U` followed by the restriction of `h` to the summand indexed by the image of
`x`. -/
private lemma ι_comp_app_comp_σ (h : U.copower Δ[1] ⟶ V) {n : ℕ} (j : Fin (n + 1))
    (x : (Δ[1] : SSet.{w}).obj (op ⦋n⦌)) :
    Sigma.ι (fun _ : (Δ[1] : SSet.{w}).obj (op ⦋n⦌) => U.obj (op ⦋n⦌)) x ≫ h.app _ ≫ V.σ j =
      U.σ j ≫ Sigma.ι (fun _ : (Δ[1] : SSet.{w}).obj (op ⦋n + 1⦌) => U.obj (op ⦋n + 1⦌))
        (Δ[1].σ j x) ≫ h.app _ := by
  rw [SimplicialObject.σ_def, ι_comp_app_comp_map, ← SimplicialObject.σ_def U,
    ← SimplicialObject.σ_def Δ[1]]

end

/-- The relations of [Stacks, Tag 019L] on a family of morphisms `hc n i : U_n ⟶ V_n`
(`i : Fin (n + 2)`, that is `i = 0, …, n + 1`) relative to `a b : U ⟶ V`: two boundary conditions
identifying `hc n 0` with `b_n` and `hc n (n + 1)` with `a_n`, and four commutation relations
against the face maps `d^n_j = U.δ j`, `V.δ j` and the degeneracy maps `s^n_j = U.σ j`, `V.σ j`,
split according to whether `i > j` or `i ≤ j`. -/
@[sga "4 Vbis 3.0.2.2"]
structure HtpyRel {U V : SimplicialObject C} (a b : U ⟶ V)
    (hc : ∀ (n : ℕ), Fin (n + 2) →
      (U.obj (op (SimplexCategory.mk n)) ⟶ V.obj (op (SimplexCategory.mk n)))) : Prop where
  /-- Relation 1 (boundary value at `i = 0`): `h_{n,0} = b_n`. -/
  bdry₀ : ∀ (n : ℕ), hc n 0 = b.app (op (SimplexCategory.mk n))
  /-- Relation 1 (boundary value at `i = n+1`): `h_{n,n+1} = a_n`. -/
  bdry₁ : ∀ (n : ℕ), hc n (Fin.last (n+1)) = a.app (op (SimplexCategory.mk n))
  /-- Relation 2: `d^n_j ∘ h_{n,i} = h_{n-1,i-1} ∘ d^n_j` when `i > j`. -/
  face_gt : ∀ (n : ℕ) (j : Fin (n+2)) (i : Fin (n+3)) (hij : j.castSucc < i),
    hc (n+1) i ≫ V.δ j = U.δ j ≫ hc n (i.pred (Fin.ne_zero_of_lt hij))
  /-- Relation 3: `d^n_j ∘ h_{n,i} = h_{n-1,i} ∘ d^n_j` when `i ≤ j`. -/
  face_le : ∀ (n : ℕ) (j : Fin (n+2)) (i : Fin (n+3)) (hij : i ≤ j.castSucc),
    hc (n+1) i ≫ V.δ j
      = U.δ j ≫ hc n (i.castPred (by rintro rfl; exact absurd hij (by simp [Fin.le_def])))
  /-- Relation 4: `s^n_j ∘ h_{n,i} = h_{n+1,i+1} ∘ s^n_j` when `i > j`. -/
  degen_gt : ∀ (n : ℕ) (j : Fin (n+1)) (i : Fin (n+2)) (_ : j.castSucc < i),
    hc n i ≫ V.σ j = U.σ j ≫ hc (n+1) i.succ
  /-- Relation 5: `s^n_j ∘ h_{n,i} = h_{n+1,i} ∘ s^n_j` when `i ≤ j`. -/
  degen_le : ∀ (n : ℕ) (j : Fin (n+1)) (i : Fin (n+2)) (_ : i ≤ j.castSucc),
    hc n i ≫ V.σ j = U.σ j ≫ hc (n+1) i.castSucc

/-- **Stacks 019L**.
The components `h_{n, i}` of a homotopy `h : U × Δ[1] ⟶ V` from `a` to `b` satisfy the relations
`HtpyRel a b`. -/
@[stacks 019L]
theorem htpy_forward {U V : SimplicialObject C}
    [∀ m, HasCoproduct fun _ : (Δ[1] : SSet.{w}).obj m => U.obj m] (a b : U ⟶ V)
    (h : U.copower Δ[1] ⟶ V) (hh : IsHomotopy h a b) :
    HtpyRel a b (homotopyComponent h) where
  bdry₀ n := by
    rw [homotopyComponent, stdSimplex.objMk₁_zero]
    exact hh.2 _
  bdry₁ n := by
    rw [homotopyComponent, stdSimplex.objMk₁_last]
    exact hh.1 _
  face_gt n j i hij := by
    rw [homotopyComponent, homotopyComponent, Category.assoc, ι_comp_app_comp_δ,
      stdSimplex.δ_objMk₁_of_lt _ _ hij]
  face_le n j i hij := by
    rw [homotopyComponent, homotopyComponent, Category.assoc, ι_comp_app_comp_δ,
      stdSimplex.δ_objMk₁_of_le _ _ hij]
  degen_gt n j i hij := by
    rw [homotopyComponent, homotopyComponent, Category.assoc, ι_comp_app_comp_σ,
      stdSimplex.σ_objMk₁_of_lt _ _ hij]
  degen_le n j i hij := by
    rw [homotopyComponent, homotopyComponent, Category.assoc, ι_comp_app_comp_σ,
      stdSimplex.σ_objMk₁_of_le _ _ hij]

/-- Two morphisms `h, h' : U × Δ[1] ⟶ V` with the same components `hc` are equal. -/
lemma htpy_converse_unique {U V : SimplicialObject C}
    [∀ m, HasCoproduct fun _ : (Δ[1] : SSet.{w}).obj m => U.obj m]
    (hc : ∀ (n : ℕ), Fin (n + 2) →
      (U.obj (op (SimplexCategory.mk n)) ⟶ V.obj (op (SimplexCategory.mk n))))
    (h h' : U.copower Δ[1] ⟶ V)
    (hcomp : ∀ (n : ℕ) (i : Fin (n + 2)), homotopyComponent h n i = hc n i)
    (hcomp' : ∀ (n : ℕ) (i : Fin (n + 2)), homotopyComponent h' n i = hc n i) :
    h = h' := by
  ext ⟨⟨n⟩⟩
  refine Sigma.hom_ext _ _ fun x => ?_
  obtain ⟨i, rfl⟩ := stdSimplex.objMk₁_surjective x
  unfold homotopyComponent at hcomp hcomp'
  rw [hcomp, hcomp']

/-- Compatibility of a family `hc` with a morphism `ψ : Y ⟶ X` of `Δ`: for every `α : X ⟶ ⦋1⦌`, the
component of `hc` at the index of `α` followed by `V.map ψ.op` agrees with `U.map ψ.op` followed by
the component of `hc` at the index of `ψ ≫ α`. -/
private def HtpyCompat {U V : SimplicialObject C}
    (hc : ∀ (n : ℕ), Fin (n + 2) →
      (U.obj (op (SimplexCategory.mk n)) ⟶ V.obj (op (SimplexCategory.mk n))))
    {Y X : SimplexCategory} (ψ : Y ⟶ X) : Prop :=
  ∀ (α : X ⟶ SimplexCategory.mk 1),
    hc X.len (SimplexCategory.toMk₁Equiv.symm α) ≫ V.map ψ.op
      = U.map ψ.op ≫ hc Y.len (SimplexCategory.toMk₁Equiv.symm (ψ ≫ α))

/-- `SimplexCategory.toMk₁Equiv.symm` recovers the index of `SimplexCategory.toMk₁ k`. -/
private lemma toMk₁Equiv_symm_toMk₁ {m : ℕ} (k : Fin (m + 2)) :
    SimplexCategory.toMk₁Equiv.symm (SimplexCategory.toMk₁ k) = k := by
  rw [show SimplexCategory.toMk₁ k = SimplexCategory.toMk₁Equiv k from rfl,
      Equiv.symm_apply_apply]

/-- Every family is compatible with an identity morphism of `Δ`. -/
private lemma htpyCompat_id {U V : SimplicialObject C}
    (hc : ∀ (n : ℕ), Fin (n + 2) →
      (U.obj (op (SimplexCategory.mk n)) ⟶ V.obj (op (SimplexCategory.mk n))))
    (X : SimplexCategory) : HtpyCompat hc (𝟙 X) := by
  intro α
  simp

/-- Compatibility of a family with morphisms of `Δ` is stable under composition. -/
private lemma htpyCompat_comp {U V : SimplicialObject C}
    (hc : ∀ (n : ℕ), Fin (n + 2) →
      (U.obj (op (SimplexCategory.mk n)) ⟶ V.obj (op (SimplexCategory.mk n))))
    {Y Z X : SimplexCategory} (ψ : Y ⟶ Z) (χ : Z ⟶ X)
    (hψ : HtpyCompat hc ψ) (hχ : HtpyCompat hc χ) :
    HtpyCompat hc (ψ ≫ χ) := by
  intro α
  have e1 := hχ α
  have e2 := hψ (χ ≫ α)
  rw [op_comp, Functor.map_comp, Functor.map_comp, ← Category.assoc, e1, Category.assoc, e2,
    ← Category.assoc, Category.assoc ψ χ α]

/-- A family satisfying `HtpyRel a b` is compatible with every face map `SimplexCategory.δ j`; this
is the content of the two face relations. -/
private lemma htpyCompat_δ {U V : SimplicialObject C} (a b : U ⟶ V)
    (hc : ∀ (n : ℕ), Fin (n + 2) →
      (U.obj (op (SimplexCategory.mk n)) ⟶ V.obj (op (SimplexCategory.mk n))))
    (hrel : HtpyRel a b hc) (n : ℕ) (j : Fin (n + 2)) :
    HtpyCompat hc (SimplexCategory.δ j) := by
  intro α
  obtain ⟨i, rfl⟩ := SimplexCategory.toMk₁_surjective α
  dsimp only [SimplexCategory.len_mk]
  rw [← SimplicialObject.δ_def, ← SimplicialObject.δ_def, toMk₁Equiv_symm_toMk₁]
  rcases lt_or_ge (j.castSucc) i with hlt | hle
  · rw [SimplexCategory.δ_comp_toMk₁_of_lt _ _ hlt, toMk₁Equiv_symm_toMk₁]
    exact hrel.face_gt n j i hlt
  · rw [SimplexCategory.δ_comp_toMk₁_of_le _ _ hle, toMk₁Equiv_symm_toMk₁]
    exact hrel.face_le n j i hle

/-- A family satisfying `HtpyRel a b` is compatible with every degeneracy map
`SimplexCategory.σ j`; this is the content of the two degeneracy relations. -/
private lemma htpyCompat_σ {U V : SimplicialObject C} (a b : U ⟶ V)
    (hc : ∀ (n : ℕ), Fin (n + 2) →
      (U.obj (op (SimplexCategory.mk n)) ⟶ V.obj (op (SimplexCategory.mk n))))
    (hrel : HtpyRel a b hc) (n : ℕ) (j : Fin (n + 1)) :
    HtpyCompat hc (SimplexCategory.σ j) := by
  intro α
  obtain ⟨i, rfl⟩ := SimplexCategory.toMk₁_surjective α
  dsimp only [SimplexCategory.len_mk]
  rw [← SimplicialObject.σ_def, ← SimplicialObject.σ_def, toMk₁Equiv_symm_toMk₁]
  rcases lt_or_ge (j.castSucc) i with hlt | hle
  · rw [SimplexCategory.σ_comp_toMk₁_of_lt _ _ hlt, toMk₁Equiv_symm_toMk₁]
    exact hrel.degen_gt n j i hlt
  · rw [SimplexCategory.σ_comp_toMk₁_of_le _ _ hle, toMk₁Equiv_symm_toMk₁]
    exact hrel.degen_le n j i hle

/-- A family satisfying `HtpyRel a b` is compatible with every morphism of `Δ`. -/
private lemma htpyCompat_all {U V : SimplicialObject C} (a b : U ⟶ V)
    (hc : ∀ (n : ℕ), Fin (n + 2) →
      (U.obj (op (SimplexCategory.mk n)) ⟶ V.obj (op (SimplexCategory.mk n))))
    (hrel : HtpyRel a b hc) :
    ∀ (N : ℕ) {Y X : SimplexCategory} (ψ : Y ⟶ X), Y.len + X.len = N → HtpyCompat hc ψ := by
  intro N
  induction N using Nat.strong_induction_on with
  | _ N IH =>
    intro Y X ψ hN
    by_cases hinj : Function.Injective ⇑(SimplexCategory.Hom.toOrderHom ψ)
    · by_cases hsurj : Function.Surjective ⇑(SimplexCategory.Hom.toOrderHom ψ)
      · have hbij : Function.Bijective (SimplexCategory.Hom.toOrderHom ψ).toFun := ⟨hinj, hsurj⟩
        have hiso : CategoryTheory.IsIso ψ := SimplexCategory.isIso_of_bijective hbij
        have hlen : Y.len = X.len := SimplexCategory.len_eq_of_isIso ψ
        have hYX : Y = X := by
          have hY : Y = SimplexCategory.mk Y.len := rfl
          rw [hY, hlen]
        subst hYX
        have : ψ = 𝟙 Y := SimplexCategory.eq_id_of_isIso ψ
        rw [this]
        exact htpyCompat_id hc Y
      · induction X using SimplexCategory.rec with | _ x => ?_
        cases x with
        | zero => exact absurd (fun y => ⟨0, Fin.subsingleton_one.elim _ _⟩) hsurj
        | succ xl =>
          obtain ⟨i, ψ', rfl⟩ := SimplexCategory.eq_comp_δ_of_not_surjective ψ hsurj
          exact htpyCompat_comp hc ψ' _ (IH _ (by dsimp only at hN ⊢; omega) ψ' rfl)
            (htpyCompat_δ a b hc hrel xl i)
    · induction Y using SimplexCategory.rec with | _ y => ?_
      cases y with
      | zero => exact absurd (fun p q _ => Fin.subsingleton_one.elim _ _) hinj
      | succ yl =>
        obtain ⟨i, ψ', rfl⟩ := SimplexCategory.eq_σ_comp_of_not_injective ψ hinj
        exact htpyCompat_comp hc _ ψ' (htpyCompat_σ a b hc hrel yl i)
          (IH _ (by dsimp only at hN ⊢; omega) ψ' rfl)

/-- A family `hc` satisfying `HtpyRel a b hc` is the family of components of a morphism
`h : U × Δ[1] ⟶ V` which is a homotopy from `a` to `b`. -/
lemma htpy_converse_exists {U V : SimplicialObject C}
    [∀ m, HasCoproduct fun _ : (Δ[1] : SSet.{w}).obj m => U.obj m] (a b : U ⟶ V)
    (hc : ∀ (n : ℕ), Fin (n + 2) →
      (U.obj (op (SimplexCategory.mk n)) ⟶ V.obj (op (SimplexCategory.mk n))))
    (hrel : HtpyRel a b hc) :
    ∃ h : U.copower Δ[1] ⟶ V,
      IsHomotopy h a b ∧ (∀ (n : ℕ) (i : Fin (n+2)), homotopyComponent h n i = hc n i) := by
  let happ : ∀ (m : SimplexCategoryᵒᵖ), (U.copower Δ[1]).obj m ⟶ V.obj m :=
    fun m => Sigma.desc fun x : (Δ[1] : SSet.{w}).obj m =>
      hc m.unop.len (SimplexCategory.toMk₁Equiv.symm (stdSimplex.objEquiv x))
  have key : ∀ (m : SimplexCategoryᵒᵖ) (x : (Δ[1] : SSet.{w}).obj m),
      Sigma.ι (fun _ : (Δ[1] : SSet.{w}).obj m => U.obj m) x ≫ happ m
        = hc m.unop.len (SimplexCategory.toMk₁Equiv.symm (stdSimplex.objEquiv x)) :=
    fun m x => Sigma.ι_desc _ _
  have hnat : ∀ {m m' : SimplexCategoryᵒᵖ} (φ : m ⟶ m'),
      (U.copower Δ[1]).map φ ≫ happ m' = happ m ≫ V.map φ := by
    intro m m' φ
    refine Sigma.hom_ext _ _ fun x => ?_
    rw [Functor.copower_map, Sigma.ι_comp_map'_assoc, key, ← Category.assoc, key]
    exact (htpyCompat_all a b hc hrel (m'.unop.len + m.unop.len) φ.unop rfl
      (stdSimplex.objEquiv x)).symm
  have hι : ∀ (n : ℕ) (i : Fin (n + 2)),
      Sigma.ι (fun _ : (Δ[1] : SSet.{w}).obj (op ⦋n⦌) => U.obj (op ⦋n⦌)) (stdSimplex.objMk₁ i) ≫
        happ (op ⦋n⦌) = hc n i := fun n i => by
    rw [key, stdSimplex.objEquiv_objMk₁, toMk₁Equiv_symm_toMk₁]
  refine ⟨{ app := happ, naturality := fun _ _ => hnat }, ⟨fun m => ?_, fun m => ?_⟩, hι⟩
  · induction m using Opposite.rec with | op m => ?_
    induction m using SimplexCategory.rec with | _ n => ?_
    rw [← stdSimplex.objMk₁_last]
    exact (hι n _).trans (hrel.bdry₁ n)
  · induction m using Opposite.rec with | op m => ?_
    induction m using SimplexCategory.rec with | _ n => ?_
    rw [← stdSimplex.objMk₁_zero]
    exact (hι n _).trans (hrel.bdry₀ n)

/-- **Stacks 019L**.
Given a family of morphisms `hc n i : U_n ⟶ V_n` satisfying the relations `HtpyRel a b`, there is a
unique morphism of simplicial objects `h : U × Δ[1] ⟶ V` whose components are the given `hc`, and
it is a homotopy from `a` to `b`. -/
@[stacks 019L]
theorem htpy_converse {U V : SimplicialObject C}
    [∀ m, HasCoproduct fun _ : (Δ[1] : SSet.{w}).obj m => U.obj m] (a b : U ⟶ V)
    (hc : ∀ (n : ℕ), Fin (n + 2) →
      (U.obj (op (SimplexCategory.mk n)) ⟶ V.obj (op (SimplexCategory.mk n))))
    (hrel : HtpyRel a b hc) :
    ∃! h : U.copower Δ[1] ⟶ V,
      IsHomotopy h a b ∧ (∀ (n : ℕ) (i : Fin (n+2)), homotopyComponent h n i = hc n i) := by
  obtain ⟨h, hhom, hcomp⟩ := htpy_converse_exists a b hc hrel
  refine ExistsUnique.intro h ⟨hhom, hcomp⟩ ?_
  rintro h' ⟨-, hcomp'⟩
  exact htpy_converse_unique hc h' h hcomp' hcomp

end CategoryTheory.SimplicialObject

end

end

/-!
## Functors preserve homotopies of simplicial objects

Let `C` be a category, with no assumptions whatsoever, and let `U`, `V` be simplicial objects
of `C`. A *homotopy* from `a : U ⟶ V` to `b : U ⟶ V` is a family of morphisms
`h_{n, i} : Uₙ ⟶ Vₙ`, for `n ≥ 0` and `i = 0, …, n + 1`, satisfying the relations of
[Stacks, Tag 019L]: `h_{n, 0} = bₙ`, `h_{n, n + 1} = aₙ`, and the compatibilities of the
`h_{n, i}` with the face maps `dⁿⱼ` and the degeneracy maps `sⁿⱼ`. Two morphisms are
*homotopic* when they are related by the equivalence relation generated by the existence of a
homotopy, that is, when they are joined by a chain `a = a₀, a₁, …, a_n = b` in which each step
carries a homotopy in one direction or the other.

A functor `F : C ⥤ D` carries a homotopy `{h_{n, i}}` from `a` to `b` to the homotopy
`{F(h_{n, i})}` from `F(a)` to `F(b)`, because the defining relations are equations between
composites of morphisms and are therefore preserved by `F`; consequently `F` carries homotopic
morphisms to homotopic ones. When the coproducts involved exist, a family `{h_{n, i}}` is the
same thing as a morphism `h : U × Δ[1] ⟶ V` with `a = e₀ ≫ h` and `b = e₁ ≫ h`
([Stacks, Tag 019L], [Stacks, Tag 019K]), the two descriptions being related by
`h_{n, i} = ι_{αⁿᵢ} ≫ hₙ`. Combining the two statements: a functor preserves the notion of
homotopy of [Stacks, Tag 019K] as well, even though it is defined through coproducts that `F`
is not assumed to preserve. That deduction is the result stated here.

### Main results

* `CategoryTheory.SimplicialObject.IsHomotopy.exists_whiskerRight`: for any functor
  `F : C ⥤ D` and any homotopy `k : U × Δ[1] ⟶ V` from `a` to `b` in the sense of
  [Stacks, Tag 019K], there is a homotopy `l : F(U) × Δ[1] ⟶ F(V)` from `F(a)` to `F(b)` whose
  components are the `F(k_{m, α})`; no compatibility of `F` with coproducts is required.

### Implementation notes

The notion of homotopy for an arbitrary category is not defined here: it is Mathlib's
`CategoryTheory.SimplicialObject.Homotopy`, which is this notion recorded through the composites
`h_{n + 1, i + 1} ∘ sⁿᵢ : Uₙ ⟶ V_{n + 1}` — the convention of the source's footnote — and hence
satisfying the relations those composites satisfy in place of the ones of [Stacks, Tag 019L]. That
a functor carries such a homotopy to one is Mathlib's
`CategoryTheory.SimplicialObject.Homotopy.whiskerRight`, whose components are the images under `F`
of the components of the original. Being homotopic is
`Relation.EqvGen fun a b => ∃ h, IsHomotopy h a b`, as in [Stacks, Tag 019K]: `Relation.EqvGen` is
the smallest equivalence relation containing a relation, so its constructors are exactly the
source's chains.

### References

* [Stacks, Tag 019M](https://stacks.math.columbia.edu/tag/019M)
-/

