module

public import StacksFrontier.AlgebraicGeometry.Descent.Module.CechConerve

/-!
# The Čech conerve of a morphism with a retraction

Let `f : X ⟶ Y` be a morphism of a category `C` whose iterated pushouts `Y ⨿_X ⋯ ⨿_X Y` exist,
and let `U = f.cechConerve` be the cosimplicial object of [Stacks, Tag 016N] built from `f`.
Suppose `f` has a retraction `s : Y ⟶ X`, i.e. `s ∘ f = id_X`. Then the self map of `U` which in
each degree is `f ∘ s` on each factor `Y` is homotopic to the identity of `U`, and `U` is homotopy
equivalent to the constant cosimplicial object `X`.

The self map is `Arrow.mapCechConerve` of the endomorphism `(𝟙 X, s ≫ f)` of the arrow `f`, and
its homotopy to the identity is `Arrow.exists_homotopy_mapCechConerve_id`. The homotopy
equivalence is the morphism `Arrow.cechSectionMap s : U ⟶ X` which is `s` on each factor, with
inverse the augmentation `X ⟶ U` of the augmented Čech conerve, the inclusion of the base in
each degree: the composite `X ⟶ U ⟶ X` is the identity, and the composite `U ⟶ X ⟶ U` is the
self map above.

Homotopies of cosimplicial objects are, as in [Stacks, Tag 0FKJ], families of morphisms
`h_{n, α} : Uₙ ⟶ Vₙ` indexed by the simplices `α ∈ Δ[1]ₙ` satisfying the relations of
[Stacks, Tag 07KB], which needs no products in `C`; being homotopic is the equivalence relation
generated by the existence of a homotopy.

### Main results

* `CategoryTheory.Arrow.homotopyEquiv_cechConerve_const_of_retraction`: [Stacks, Tag 019Z].

### References

* [Stacks, Tag 019Z](https://stacks.math.columbia.edu/tag/019Z)
* [Stacks, Tag 016N](https://stacks.math.columbia.edu/tag/016N)
* [Stacks, Tag 019N](https://stacks.math.columbia.edu/tag/019N)
* [Stacks, Tag 0FKJ](https://stacks.math.columbia.edu/tag/0FKJ)
-/

@[expose] public section

universe v u

open CategoryTheory CategoryTheory.Limits Opposite Simplicial SSet

namespace CategoryTheory.Arrow

variable {C : Type u} [Category.{v} C] {f : Arrow C}
  [∀ n : ℕ, HasWidePushout f.left (fun _ : Fin (n + 1) => f.right) fun _ => f.hom]

/-- **Stacks 019Z**.
Let `f : X ⟶ Y` be a morphism of a category `C` whose iterated pushouts `Y ⨿_X ⋯ ⨿_X Y` exist and
let `s : Y ⟶ X` satisfy `s ∘ f = id_X`. Let `U = f.cechConerve` be the cosimplicial object of
[Stacks, Tag 016N] built from `f`, with `cechι n i : Y ⟶ Uₙ` the inclusion of the `i`-th factor.
Then:
1. there is a morphism `φ : U ⟶ U` which in each degree is `f ∘ s` on each factor, i.e.
  `φₙ ∘ cechι n i = cechι n i ∘ f ∘ s`, and every such `φ` admits a homotopy to `𝟙 U` in the sense
  of [Stacks, Tag 0FKJ]: a family `h_{n, α} : Uₙ ⟶ Uₙ`, `α ∈ Δ[1]ₙ`, with
  `h_{m, α} ∘ U(g) = U(g) ∘ h_{n, α ∘ g}` for every `g : ⦋n⦌ ⟶ ⦋m⦌`, whose components at the
  constant maps with values `0` and `1` are `φₙ` and `id`; in particular `φ` and `𝟙 U` are
  homotopic;
2. `U` is homotopy equivalent to the constant cosimplicial object `X` (the notion dual to
  [Stacks, Tag 019N]): there are `a : U ⟶ X` and `b : X ⟶ U` such that `b ∘ a` is homotopic to
  `𝟙 U` and `a ∘ b` is homotopic to `𝟙 X`, homotopic being the equivalence relation generated by
  the existence of a homotopy. -/
@[stacks 019Z "the existence of the iterated pushouts `Y ⨿_X ⋯ ⨿_X Y`, which is all Example \
  016N uses, replaces the source's pushouts in `C`. The self map is characterised by its \
  composites with the factor inclusions `cechι n i`, it exists, and every such map admits a \
  homotopy to the identity, which is stronger than being homotopic. A homotopy is its family \
  of components as in 0FKJ and 07KB, which needs no products in `C`; homotopic is \
  `Relation.EqvGen` of the existence of a homotopy, the spelling of 019Y and 0FKK; homotopy \
  equivalent is the dual of 019N, spelled out"]
public theorem homotopyEquiv_cechConerve_const_of_retraction (s : f.right ⟶ f.left)
    (hs : f.hom ≫ s = 𝟙 f.left) :
    ((∃ φ : f.cechConerve ⟶ f.cechConerve,
        ∀ (n : SimplexCategory) (i : Fin (n.len + 1)),
          cechι n i ≫ φ.app n = (s ≫ f.hom) ≫ cechι n i) ∧
      ∀ φ : f.cechConerve ⟶ f.cechConerve,
        (∀ (n : SimplexCategory) (i : Fin (n.len + 1)),
          cechι n i ≫ φ.app n = (s ≫ f.hom) ≫ cechι n i) →
        ∃ h : ∀ n : SimplexCategory, (Δ[1] : SSet.{0}).obj (op n) →
            (f.cechConerve.obj n ⟶ f.cechConerve.obj n),
          (∀ ⦃n m : SimplexCategory⦄ (g : n ⟶ m) (α : (Δ[1] : SSet.{0}).obj (op m)),
              f.cechConerve.map g ≫ h m α =
                h n ((Δ[1] : SSet.{0}).map g.op α) ≫ f.cechConerve.map g) ∧
            (∀ n : SimplexCategory, h n (stdSimplex.const 1 0 (op n)) = φ.app n) ∧
            (∀ n : SimplexCategory, h n (stdSimplex.const 1 1 (op n)) =
              𝟙 (f.cechConerve.obj n))) ∧
      ∃ (a : f.cechConerve ⟶ (CosimplicialObject.const C).obj f.left)
        (b : (CosimplicialObject.const C).obj f.left ⟶ f.cechConerve),
        Relation.EqvGen (fun x y : f.cechConerve ⟶ f.cechConerve =>
            ∃ h : ∀ n : SimplexCategory, (Δ[1] : SSet.{0}).obj (op n) →
              (f.cechConerve.obj n ⟶ f.cechConerve.obj n),
            (∀ ⦃n m : SimplexCategory⦄ (g : n ⟶ m) (α : (Δ[1] : SSet.{0}).obj (op m)),
                f.cechConerve.map g ≫ h m α =
                  h n ((Δ[1] : SSet.{0}).map g.op α) ≫ f.cechConerve.map g) ∧
              (∀ n : SimplexCategory, h n (stdSimplex.const 1 0 (op n)) = x.app n) ∧
              (∀ n : SimplexCategory, h n (stdSimplex.const 1 1 (op n)) = y.app n))
          (a ≫ b) (𝟙 f.cechConerve) ∧
        Relation.EqvGen (fun x y : (CosimplicialObject.const C).obj f.left ⟶
              (CosimplicialObject.const C).obj f.left =>
            ∃ h : ∀ n : SimplexCategory, (Δ[1] : SSet.{0}).obj (op n) →
              (((CosimplicialObject.const C).obj f.left).obj n ⟶
                ((CosimplicialObject.const C).obj f.left).obj n),
            (∀ ⦃n m : SimplexCategory⦄ (g : n ⟶ m) (α : (Δ[1] : SSet.{0}).obj (op m)),
                ((CosimplicialObject.const C).obj f.left).map g ≫ h m α =
                  h n ((Δ[1] : SSet.{0}).map g.op α) ≫
                    ((CosimplicialObject.const C).obj f.left).map g) ∧
              (∀ n : SimplexCategory, h n (stdSimplex.const 1 0 (op n)) = x.app n) ∧
              (∀ n : SimplexCategory, h n (stdSimplex.const 1 1 (op n)) = y.app n))
          (b ≫ a) (𝟙 _) := by
  let F : f ⟶ f := cechRetractionEndomorphism s hs
  have hF : F.left ≫ f.hom = f.hom := Category.id_comp _
  have hφF : ∀ φ : f.cechConerve ⟶ f.cechConerve,
      (∀ (n : SimplexCategory) (i : Fin (n.len + 1)),
        cechι n i ≫ φ.app n = (s ≫ f.hom) ≫ cechι n i) → φ = mapCechConerve F :=
    fun φ hφ => NatTrans.ext <| funext fun n => cech_hom_ext fun i => by
      rw [hφ, cechι_comp_mapCechConerve]
      rfl
  refine ⟨⟨⟨mapCechConerve F, fun n i => cechι_comp_mapCechConerve F n i⟩, fun φ hφ => ?_⟩,
    cechSectionMap s hs, f.augmentedCechConerve.hom, ?_, ?_⟩
  · rw [hφF φ hφ]
    exact exists_homotopy_mapCechConerve_id F hF
  · obtain ⟨h, h₁, h₂, h₃⟩ := exists_homotopy_mapCechConerve_id F hF
    exact Relation.EqvGen.rel _ _ ⟨h, h₁, fun n => (h₂ n).trans
      (congrArg (fun φ => NatTrans.app φ n) (cechSection_augmentation_comp s hs).symm), h₃⟩
  · convert Relation.EqvGen.refl _ using 1
    exact (cechAugmentation_section_comp s hs).symm

end CategoryTheory.Arrow
