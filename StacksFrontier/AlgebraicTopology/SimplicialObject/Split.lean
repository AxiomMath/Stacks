universe v u

namespace CategoryTheory.SimplicialObject

variable {C : Type u} [Category.{v} C]

/-- **Stacks 017P**, for full simplicial objects.
A splitting by subobjects is a Mathlib splitting whose structure maps `N(U_n) ⟶ U_n` are
monomorphisms, so that they represent the subobjects required by the source definition. -/
@[stacks 017P "the definition for full simplicial objects; a monomorphism represents each source \
  subobject, and `Splitting.isColimit'` is exactly the displayed coproduct isomorphism"]
structure SubobjectSplitting (X : SimplicialObject C) extends X.Splitting where
  /-- Each summand map represents a subobject of the corresponding simplicial degree. -/
  mono_ι : ∀ n, Mono (toSplitting.ι n)

namespace Truncated

namespace SubobjectSplitting

variable {r : ℕ} (X : SimplicialObject.Truncated C r)

/-- The target truncated simplex of a surjection out of `Δ`. -/
private def target (Δ : (SimplexCategory.Truncated r)ᵒᵖ)
    (A : SimplicialObject.Splitting.IndexSet (op Δ.unop.obj)) :
    SimplexCategory.Truncated r :=
  ⟨A.1.unop, (SimplexCategory.len_le_of_epi A.e).trans Δ.unop.property⟩

/-- The surjection in the truncated simplex category underlying an index of the splitting. -/
private def hom (Δ : (SimplexCategory.Truncated r)ᵒᵖ)
    (A : SimplicialObject.Splitting.IndexSet (op Δ.unop.obj)) :
    Δ.unop ⟶ target Δ A :=
  ObjectProperty.homMk A.e

variable (N : SimplexCategory.Truncated r → C)

/-- The family of summands indexed by all surjections out of a truncated simplex. -/
private def summand (Δ : (SimplexCategory.Truncated r)ᵒᵖ)
    (A : SimplicialObject.Splitting.IndexSet (op Δ.unop.obj)) : C :=
  N (target Δ A)

variable (ι : ∀ Δ, N Δ ⟶ X.obj (op Δ))

/-- The canonical coproduct cofan attached to proposed nondegenerate subobjects. -/
private abbrev cofan' (Δ : (SimplexCategory.Truncated r)ᵒᵖ) :
    Cofan (summand N Δ) :=
  Cofan.mk (X.obj Δ) (fun A ↦ ι (target Δ A) ≫ X.map (hom Δ A).op)

end SubobjectSplitting

/-- **Stacks 017P**, for truncated simplicial objects.
A splitting of an `r`-truncated simplicial object consists of subobjects in every degree at most
`r` whose images under all surjections form a coproduct decomposition in each truncated degree. -/
@[stacks 017P "the definition for truncated simplicial objects; the index category is the \
  surjections `[n] → [m]`, automatically with `m ≤ n ≤ r`"]
structure SubobjectSplitting {r : ℕ} (X : SimplicialObject.Truncated C r) where
  /-- The proposed nondegenerate summand in each truncated degree. -/
  N : SimplexCategory.Truncated r → C
  /-- The inclusion of each summand. -/
  ι : ∀ Δ, N Δ ⟶ X.obj (op Δ)
  /-- Each inclusion represents a subobject. -/
  mono_ι : ∀ Δ, Mono (ι Δ)
  /-- The canonical family of summands is a coproduct decomposition in every degree. -/
  isColimit' : ∀ Δ, IsColimit (SubobjectSplitting.cofan' X N ι Δ)

end Truncated

/-! ### Summandwise retracts of coproduct decompositions -/

section Retract

variable {C : Type*} [Category* C] {ι : Type*} {f g : ι → C}

/-- A summandwise retract of a coproduct decomposition is a coproduct decomposition: if the cofan
`c` on `f` is colimiting, each summand `g j` is a retract of `f j`, and `d.pt` is the corresponding
retract of `c.pt` — compatibly with the injections, in both directions — then the cofan `d` on `g`
is colimiting. -/
private def isColimitOfRetract {c : Cofan f} (hc : IsColimit c) {d : Cofan g}
    (ρ : ∀ j, Retract (g j) (f j)) (σ : Retract d.pt c.pt)
    (hi : ∀ j, d.inj j ≫ σ.i = (ρ j).i ≫ c.inj j)
    (hr : ∀ j, c.inj j ≫ σ.r = (ρ j).r ≫ d.inj j) :
    IsColimit d :=
  Cofan.IsColimit.mk _ (fun T => σ.i ≫ Cofan.IsColimit.desc hc fun j => (ρ j).r ≫ T.inj j)
    (fun T j => by
      rw [← assoc, hi, assoc, Cofan.IsColimit.fac, ← assoc, (ρ j).retract, id_comp])
    (fun T m hm => by
      have h : σ.r ≫ m = Cofan.IsColimit.desc hc fun j => (ρ j).r ≫ T.inj j :=
        Cofan.IsColimit.hom_ext hc _ _ fun j => by
          rw [← assoc, hr, assoc, hm, Cofan.IsColimit.fac]
      rw [← h, ← assoc, σ.retract, id_comp])

/-- A subobject factors a morphism exactly when that morphism factors through its inclusion. -/
private lemma factors_iff_exists {A B : C} (P : Subobject B) (f : A ⟶ B) :
    P.Factors f ↔ ∃ g : A ⟶ (P : C), g ≫ P.arrow = f :=
  ⟨fun h => ⟨P.factorThru f h, P.factorThru_arrow f h⟩,
    fun ⟨_, hg⟩ => hg ▸ Subobject.factors_comp_arrow _⟩

/-- A cofan that is isomorphic to a colimiting cofan summand by summand, up to a reindexing of the
summands, is colimiting. -/
private def isColimitOfIsoEquiv {κ : Type*} {g' : κ → C} {c : Cofan f} (hc : IsColimit c)
    {d : Cofan g'} (ε : κ ≃ ι) (w : ∀ k, g' k ≅ f (ε k)) (e : d.pt ≅ c.pt)
    (h : ∀ k, d.inj k ≫ e.hom = (w k).hom ≫ c.inj (ε k)) :
    IsColimit d :=
  isColimitOfRetract (Cofan.isColimitEquivOfEquiv ε c hc)
    (fun k => ⟨(w k).hom, (w k).inv, (w k).hom_inv_id⟩) ⟨e.hom, e.inv, e.hom_inv_id⟩
    (fun k => by simpa using h k)
    (fun k => by rw [cofan_mk_inj, Iso.comp_inv_eq, assoc, h k, Iso.inv_hom_id_assoc])

end Retract

/-! ### The Moore splitting -/

section Moore

variable {C : Type*} [Category* C] [Abelian C] (X : SimplicialObject C)

/-- An intersection of kernel subobjects is killed by each of the morphisms it is built from. -/
private lemma finset_inf_kernelSubobject_arrow_comp {Y Z : C} {κ : Type*} (f : κ → (Y ⟶ Z))
    (s : Finset κ) (i : κ) (hi : i ∈ s) :
    (s.inf fun k => kernelSubobject (f k)).arrow ≫ f i = 0 := by
  rw [← Subobject.factorThru_arrow _ _ (Subobject.finset_inf_arrow_factors s _ i hi), assoc,
    kernelSubobject_arrow_comp, comp_zero]

/-- The Moore subobject in degree `n + 1` is killed by the faces `d_i` with `i ≥ 1`. -/
private lemma arrow_objX_comp_δ_succ (n : ℕ) (i : Fin (n + 1)) :
    (objX X (n + 1)).arrow ≫ X.δ i.succ = 0 := by
  rw [objX_add_one]
  exact finset_inf_kernelSubobject_arrow_comp (fun k : Fin (n + 1) => X.δ k.succ) _ i
    (Finset.mem_univ _)

/-- The Moore subobject `N[X]_n ⊆ X _⦋n⦌` is fixed by the idempotent `PInfty`. -/
private lemma arrow_comp_PInfty_f (n : ℕ) :
    (objX X n).arrow ≫ PInfty.f n = (objX X n).arrow := by
  cases n with
  | zero =>
    rw [PInfty_f_0]
    exact comp_id _
  | succ n =>
    rw [PInfty_f]
    refine HigherFacesVanish.comp_P_eq_self ?_
    rw [HigherFacesVanish]
    exact fun j _ => arrow_objX_comp_δ_succ X n j

/-- The Moore subobject is a retract of `X _⦋n⦌`, retracted by the factorization of `PInfty`
through it. -/
private lemma arrow_comp_factorThru_PInfty_f (n : ℕ) :
    (objX X n).arrow ≫ (objX X n).factorThru (PInfty.f n) (factors_normalizedMooreComplex_PInfty n)
      = 𝟙 _ := by
  rw [← cancel_mono (objX X n).arrow, assoc, Subobject.factorThru_arrow, arrow_comp_PInfty_f,
    id_comp]

/-- The Dold–Kan comparison `Γ₀.obj K[X] ⟶ X`, in degree `Δ`. -/
private noncomputable def γ (Δ : SimplexCategoryᵒᵖ) : (Γ₀.obj K[X]).obj Δ ⟶ X.obj Δ :=
  (Γ₂N₁.natTrans.app X).f.app Δ

/-- The inverse Dold–Kan comparison `X ⟶ Γ₀.obj K[X]`, in degree `Δ`. -/
private noncomputable def γinv (Δ : SimplexCategoryᵒᵖ) : X.obj Δ ⟶ (Γ₀.obj K[X]).obj Δ :=
  (inv (Γ₂N₁.natTrans.app X)).f.app Δ

/-- The Dold–Kan comparison sends the summand of `Γ₀.obj K[X]` indexed by `A` into `X` by `PInfty`
followed by the degeneracy `A.e`. -/
@[reassoc]
private lemma inj_comp_γ (Δ : SimplexCategoryᵒᵖ) (A : Splitting.IndexSet Δ) :
    ((Γ₀.splitting (K[X])).cofan Δ).inj A ≫ γ X Δ = PInfty.f A.1.unop.len ≫ X.map A.e.op :=
  (Γ₀.splitting (K[X])).ι_desc Δ _ A

/-- The composite of the Dold–Kan comparison with its inverse is the idempotent `Γ₀.map PInfty` of
`Γ₀.obj K[X]`. -/
private lemma γ_comp_γinv (Δ : SimplexCategoryᵒᵖ) :
    γ X Δ ≫ γinv X Δ = ((Γ₀ (C := C)).map (PInfty (X := X))).app Δ :=
  congrArg (fun φ => φ.f.app Δ) (IsIso.hom_inv_id (Γ₂N₁.natTrans.app X))

/-- The composite of the inverse Dold–Kan comparison with the comparison is the identity of `X`. -/
private lemma γinv_comp_γ (Δ : SimplexCategoryᵒᵖ) : γinv X Δ ≫ γ X Δ = 𝟙 _ :=
  congrArg (fun φ => φ.f.app Δ) (IsIso.inv_hom_id (Γ₂N₁.natTrans.app X))

/-- `Γ₀.map PInfty` acts on the summand of `Γ₀.obj K[X]` indexed by `A` as `PInfty`. -/
private lemma inj_comp_γ_comp_γinv (Δ : SimplexCategoryᵒᵖ) (A : Splitting.IndexSet Δ) :
    ((Γ₀.splitting (K[X])).cofan Δ).inj A ≫ γ X Δ ≫ γinv X Δ
      = PInfty.f A.1.unop.len ≫ ((Γ₀.splitting (K[X])).cofan Δ).inj A := by
  rw [γ_comp_γinv]
  exact (Γ₀.splitting (K[X])).ι_desc Δ _ A

/-- The inverse comparison carries the summand of `X _⦋Δ⦌` cut out by the Moore subobject `N[X]_m`
into the summand of `Γ₀.obj K[X]` indexed by `A`, by the inclusion of `N[X]_m`. -/
private lemma mooreCofan_inj_comp_γinv (Δ : SimplexCategoryᵒᵖ) (A : Splitting.IndexSet Δ) :
    ((objX X A.1.unop.len).arrow ≫ X.map A.e.op) ≫ γinv X Δ
      = (objX X A.1.unop.len).arrow ≫ ((Γ₀.splitting (K[X])).cofan Δ).inj A := by
  calc ((objX X A.1.unop.len).arrow ≫ X.map A.e.op) ≫ γinv X Δ
      = ((objX X A.1.unop.len).arrow ≫ PInfty.f _) ≫ X.map A.e.op ≫ γinv X Δ :=
        (assoc _ _ _).trans (congrArg (· ≫ _) (arrow_comp_PInfty_f X _).symm)
    _ = (objX X A.1.unop.len).arrow ≫ ((Γ₀.splitting (K[X])).cofan Δ).inj A ≫ γ X Δ ≫ γinv X Δ :=
        (assoc _ _ _).trans
          (congrArg (_ ≫ ·) ((assoc _ _ _).symm.trans (inj_comp_γ_assoc X Δ A _).symm))
    _ = (objX X A.1.unop.len).arrow ≫ ((Γ₀.splitting (K[X])).cofan Δ).inj A :=
        (congrArg (_ ≫ ·) (inj_comp_γ_comp_γinv X Δ A)).trans
          ((assoc _ _ _).symm.trans (congrArg (· ≫ _) (arrow_comp_PInfty_f X _)))

/-- The comparison carries the summand of `Γ₀.obj K[X]` indexed by `A` into the summand cut out by
`N[X]_m`, by the factorization of `PInfty` through `N[X]_m`. -/
private lemma inj_comp_γ_eq (Δ : SimplexCategoryᵒᵖ) (A : Splitting.IndexSet Δ) :
    ((Γ₀.splitting (K[X])).cofan Δ).inj A ≫ γ X Δ
      = (objX X A.1.unop.len).factorThru (PInfty.f _) (factors_normalizedMooreComplex_PInfty _) ≫
          ((objX X A.1.unop.len).arrow ≫ X.map A.e.op) := by
  rw [inj_comp_γ, ← assoc, Subobject.factorThru_arrow]

/-- The normalized Moore subobjects `N[X]_n = ⋂_{i = 1}^{n} Ker(d^n_i)` decompose `X _⦋Δ⦌`. -/
private noncomputable def isColimitMooreCofan (Δ : SimplexCategoryᵒᵖ) :
    IsColimit (Splitting.cofan' (fun n => (objX X n : C)) X (fun n => (objX X n).arrow) Δ) :=
  isColimitOfRetract ((Γ₀.splitting (K[X])).isColimit Δ)
    (fun A =>
      { i := (objX X A.1.unop.len).arrow
        r := (objX X A.1.unop.len).factorThru (PInfty.f _) (factors_normalizedMooreComplex_PInfty _)
        retract := arrow_comp_factorThru_PInfty_f X A.1.unop.len })
    { i := γinv X Δ
      r := γ X Δ
      retract := γinv_comp_γ X Δ }
    (mooreCofan_inj_comp_γinv X Δ) (inj_comp_γ_eq X Δ)

/-- Every simplicial object of an abelian category is split by its normalized Moore subobjects
`⋂_{i = 1}^{n} Ker(d^n_i)`, included by `Subobject.arrow`. -/
@[implicit_reducible]
private noncomputable def mooreSplitting : X.Splitting where
  N n := (objX X n : C)
  ι n := (objX X n).arrow
  isColimit' := isColimitMooreCofan X

end Moore

/-! ### Order reversal -/

section Rev

variable {C : Type*} [Category* C] (X : SimplicialObject C)

/-- The order-reversal of a simplicial object `X`: `X` precomposed with the involution
`SimplexCategory.rev`, so that it has the same `n`-simplices as `X` and its face `d_i` is the face
`d_{n - i}` of `X`. -/
public abbrev revObj : SimplicialObject C := SimplexCategory.rev.op ⋙ X

/-- The faces of the order-reversal are the reversed faces. -/
public lemma revObj_δ {n : ℕ} (i : Fin (n + 2)) : (revObj X).δ i = X.δ i.rev := by
  simp [SimplicialObject.δ]

/-- Reversing the epimorphism that indexes a summand of a split simplicial object, an involution of
`Splitting.IndexSet Δ`. -/
private noncomputable def revIndexSet (Δ : SimplexCategoryᵒᵖ) :
    Equiv.Perm (Splitting.IndexSet Δ) :=
  Function.Involutive.toPerm (fun A => ⟨A.1, SimplexCategory.rev.map A.e, inferInstance⟩)
    fun A => Splitting.IndexSet.ext _ _ rfl (by simp [Splitting.IndexSet.e])

@[simp]
private lemma revIndexSet_fst {Δ : SimplexCategoryᵒᵖ} (A : Splitting.IndexSet Δ) :
    (revIndexSet Δ A).1 = A.1 := rfl

@[simp]
private lemma revIndexSet_e {Δ : SimplexCategoryᵒᵖ} (A : Splitting.IndexSet Δ) :
    (revIndexSet Δ A).e = SimplexCategory.rev.map A.e := rfl

/-- A splitting of the order-reversal `revObj X` read as a splitting of `X`, with the same
nondegenerate objects and inclusions. -/
@[implicit_reducible]
private noncomputable def splittingOfRevObj (t : (revObj X).Splitting) : X.Splitting where
  N := t.N
  ι := t.ι
  isColimit' Δ := isColimitOfIsoEquiv (t.isColimit Δ) (revIndexSet Δ) (fun _ => Iso.refl _)
    (Iso.refl _) fun A => by simp [Splitting.cofan_inj_eq]

end Rev

/-! ### The splitting in the source's convention, and its functoriality -/

section Source

variable {C : Type*} [Category* C] [Abelian C] (X : SimplicialObject C)

/-- The Moore subobject of `revObj X` in degree `n + 1` is killed by the faces `d_i` of `X` with
`i ≤ n`. -/
private lemma arrow_objX_rev_comp_δ_castSucc (n : ℕ) (i : Fin (n + 1)) :
    (objX (revObj X) (n + 1)).arrow ≫ X.δ i.castSucc = 0 := by
  have h := arrow_objX_comp_δ_succ (revObj X) n i.rev
  rwa [revObj_δ, Fin.rev_succ, Fin.rev_rev] at h

/-- A morphism of simplicial objects carries the normalized Moore subobjects into each other. -/
private lemma objX_factors_arrow_comp_app (Y : SimplicialObject C) (F : X ⟶ Y) (n : ℕ) :
    (objX Y n).Factors ((objX X n).arrow ≫ F.app (op ⦋n⦌)) := by
  cases n with
  | zero =>
    rw [objX_zero Y]
    exact Subobject.top_factors _
  | succ n =>
    rw [objX_add_one Y, Subobject.finset_inf_factors]
    intro i _
    refine kernelSubobject_factors _ _ ?_
    rw [assoc, SimplicialObject.δ, ← F.naturality, ← assoc, ← SimplicialObject.δ_def,
      arrow_objX_comp_δ_succ, zero_comp]

/-- The Moore subobject of the order-reversal `revObj X` in degree `n + 1` is the
intersection of the kernels of the faces `d^{n + 1}_i` of `X` with `i ≤ n`. -/
private lemma objX_revObj_add_one (n : ℕ) :
    objX (revObj X) (n + 1)
      = Finset.univ.inf fun i : Fin (n + 1) => kernelSubobject (X.δ i.castSucc) := by
  have h : ∀ k : Fin (n + 1),
      (revObj X).δ k.succ = X.δ k.rev.castSucc := fun k => by
    rw [revObj_δ, Fin.rev_succ]
  rw [objX_add_one]
  conv_rhs => rw [← Finset.map_univ_equiv (Fin.revPerm (n := n + 1)), Finset.inf_map]
  simp [h, Function.comp_def]

/-- The splitting of a simplicial object of an abelian category whose nondegenerate part in degree
`n + 1` is `⋂_{i = 0}^{n} Ker(d^{n + 1}_i)`: the Moore splitting of the order-reversal, read back
on `X`. -/
@[implicit_reducible]
private noncomputable def splitting : X.Splitting :=
  splittingOfRevObj X (mooreSplitting (revObj X))

private lemma mono_splitting_ι (n : ℕ) : Mono ((splitting X).ι n) :=
  Subobject.arrow_mono _

omit [Abelian C] in
/-- A morphism of split simplicial objects is determined by the underlying morphism of simplicial
objects, as soon as the inclusions of the target are monomorphisms. -/
private lemma hom_ext_of_F {S T : Split C} (Φ Ψ : S ⟶ T) (hm : ∀ n, Mono (T.s.ι n))
    (h : Φ.F = Ψ.F) : Φ = Ψ := by
  refine Split.hom_ext _ _ fun n => ?_
  have := hm n
  rw [← cancel_mono (T.s.ι n), ← Φ.comm n, ← Ψ.comm n, h]

/-- The functor sending a simplicial object of an abelian category to itself equipped with the
splitting whose nondegenerate parts are `⋂_{i = 0}^{m - 1} Ker(d^m_i)`; it is a section of
`Split.forget`. -/
@[implicit_reducible]
private noncomputable def splittingFunctor : SimplicialObject C ⥤ Split C where
  obj X := ⟨X, splitting X⟩
  map {X Y} F :=
    { F := F
      f := fun n =>
        (objX (revObj Y) n).factorThru
          ((objX (revObj X) n).arrow ≫
            (Functor.whiskerLeft SimplexCategory.rev.op F).app (op ⦋n⦌))
          (objX_factors_arrow_comp_app _ _ (Functor.whiskerLeft SimplexCategory.rev.op F) n)
      comm := fun _ => (Subobject.factorThru_arrow _ _ _).symm }
  map_id X := hom_ext_of_F _ _ (mono_splitting_ι X) rfl
  map_comp _ _ := hom_ext_of_F _ _ (mono_splitting_ι _) rfl

end Source

section Statement

variable (A : Type u) [Category.{v} A] [Abelian A]

/-- **Stacks 017V**.
Every simplicial object `U` of an abelian category `A` has a splitting whose nondegenerate parts
are `N(U₀) = U₀` and `N(U_{n + 1}) = ⋂_{i = 0}^{n} Ker(d^{n + 1}_i)`, and this splitting is
functorial: the splittings are the values of a functor `SimplicialObject A ⥤ Split A` which is a
section of the functor forgetting the splitting. -/
@[stacks 017V]
public theorem exists_splittingFunctor_mk_ι_eq_inf_kernelSubobject :
    ∃ F : SimplicialObject A ⥤ Split A,
      F ⋙ Split.forget A = 𝟭 (SimplicialObject A) ∧
      (∀ U : SimplicialObject A, IsIso ((F.obj U).s.ι 0)) ∧
      ∀ (U : SimplicialObject A) (n : ℕ), ∃ _ : Mono ((F.obj U).s.ι (n + 1)),
        Subobject.mk ((F.obj U).s.ι (n + 1)) =
          Finset.univ.inf
            fun i : Fin (n + 1) => kernelSubobject ((F.obj U).X.δ i.castSucc) := by
  refine ⟨splittingFunctor, rfl, fun U => ?_, fun U n => ⟨mono_splitting_ι U (n + 1), ?_⟩⟩
  · exact (Subobject.isIso_arrow_iff_eq_top
      (objX (revObj U) 0)).mpr (objX_zero _)
  · exact (Subobject.mk_arrow (objX (revObj U) (n + 1))).trans
      (objX_revObj_add_one U n)

end Statement

/-! ### Simplicial abelian groups: the nondegenerate part as a subgroup -/

section AddCommGrp

/-- The homomorphism `ULift ℤ →+ A` sending `1` to `y`. -/
private noncomputable def zsmulHom (A : AddCommGrpCat.{u}) (y : A) :
    AddCommGrpCat.of (ULift.{u} ℤ) ⟶ A :=
  AddCommGrpCat.ofHom (AddMonoidHom.mk' (fun k : ULift.{u} ℤ => k.down • y)
    (fun a b => add_zsmul y a.down b.down))

private lemma zsmulHom_comp {A B : AddCommGrpCat.{u}} (y : A) (φ : A ⟶ B) :
    zsmulHom A y ≫ φ = zsmulHom B (φ.hom y) :=
  AddCommGrpCat.hom_ext (by ext k; simp [zsmulHom, map_zsmul])

private lemma zsmulHom_zero (A : AddCommGrpCat.{u}) : zsmulHom A 0 = 0 :=
  AddCommGrpCat.hom_ext (by ext k; simp [zsmulHom])

/-- An element of an abelian group lies in the range of the inclusion of a subobject if and only if
that subobject factors multiplication by the element. -/
private lemma mem_range_arrow_iff {A : AddCommGrpCat.{u}} (P : Subobject A) (y : A) :
    y ∈ (P.arrow).hom.range ↔ P.Factors (zsmulHom A y) := by
  rw [factors_iff_exists]
  refine ⟨fun ⟨x, hx⟩ => ⟨zsmulHom _ x, hx ▸ zsmulHom_comp x P.arrow⟩,
    fun ⟨g, hg⟩ => ⟨g.hom (ULift.up 1), ?_⟩⟩
  simpa [zsmulHom] using
    congrArg (fun (φ : AddCommGrpCat.of (ULift.{u} ℤ) ⟶ A) => φ.hom (ULift.up 1)) hg

private lemma range_arrow_eq_top {A : AddCommGrpCat.{u}} (P : Subobject A) (h : P = ⊤) :
    (P.arrow).hom.range = ⊤ := by
  have : IsIso P.arrow := (Subobject.isIso_arrow_iff_eq_top P).mpr h
  exact (AddSubgroup.eq_top_iff' _).mpr fun y =>
    AddMonoidHom.mem_range.mpr ⟨(inv P.arrow).hom y, by simp⟩

/-- The Moore subobject of `revObj U` in degree `n + 1` is the intersection of the kernels
of the faces `d_i` of `U` with `i ≤ n`. -/
private lemma range_arrow_objX_op_succ (U : SimplicialObject AddCommGrpCat.{u}) (n : ℕ) :
    ((objX (revObj U) (n + 1)).arrow).hom.range
      = ⨅ i : Fin (n + 1), (U.δ i.castSucc).hom.ker := by
  ext y
  simp only [AddSubgroup.mem_iInf, AddMonoidHom.mem_ker]
  refine ⟨fun ⟨x, hx⟩ i => ?_, fun hy => ?_⟩
  · rw [← hx, ← AddMonoidHom.comp_apply, ← AddCommGrpCat.hom_comp,
      arrow_objX_rev_comp_δ_castSucc, AddCommGrpCat.hom_zero, AddMonoidHom.zero_apply]
  · rw [mem_range_arrow_iff, objX_add_one, Subobject.finset_inf_factors]
    intro k _
    have h : ((revObj U).δ k.succ).hom y = 0 := by
      rw [revObj_δ, Fin.rev_succ]
      exact hy k.rev
    rw [kernelSubobject_factors_iff, zsmulHom_comp, h, zsmulHom_zero]

/-- **Stacks 017U**.
Every simplicial abelian group `U` has a splitting whose nondegenerate part is `N(U_0) = U_0` and
`N(U_m) = ⋂_{i = 0}^{m - 1} Ker(d^m_i)` for `m ≥ 1`, and this splitting is functorial: any morphism
of simplicial abelian groups carries `N(U_m)` into `N(V_m)`. -/
@[stacks 017U]
public theorem exists_splitting_range_ι_eq_iInf_ker_δ :
    ∃ s : ∀ U : SimplicialObject AddCommGrpCat.{u}, U.Splitting,
      (∀ (U : SimplicialObject AddCommGrpCat.{u}) (n : ℕ), Mono ((s U).ι n)) ∧
      (∀ U : SimplicialObject AddCommGrpCat.{u}, ((s U).ι 0).hom.range = ⊤) ∧
      (∀ (U : SimplicialObject AddCommGrpCat.{u}) (n : ℕ), ((s U).ι (n + 1)).hom.range =
        ⨅ i : Fin (n + 1), (U.δ i.castSucc).hom.ker) ∧
      (∀ (U V : SimplicialObject AddCommGrpCat.{u}) (f : U ⟶ V) (n : ℕ),
        ∃ g : (s U).N n ⟶ (s V).N n, (s U).ι n ≫ f.app (op ⦋n⦌) = g ≫ (s V).ι n) := by
  refine ⟨splitting, fun U n => ?_, fun U => ?_, fun U n => ?_, fun U V f n => ?_⟩
  · exact mono_splitting_ι U n
  · exact range_arrow_eq_top _ (objX_zero _)
  · exact range_arrow_objX_op_succ U n
  · exact ⟨(splittingFunctor.map f).f n, (splittingFunctor.map f).comm n⟩

end AddCommGrp

end CategoryTheory.SimplicialObject

/-! ### Uniqueness of the splitting of a simplicial set -/

namespace SSet

section Splitting

variable {X : SSet.{u}} (s : X.Splitting)

/-- Every `n`-simplex of a split simplicial set is of the form `X.map f.op (s.ι m y)` for some
epimorphism `f : ⦋n⦌ ⟶ ⦋m⦌` and some `y : s.N m`. -/
private lemma exists_epi_eq_map_ι {n : ℕ} (x : X _⦋n⦌) :
    ∃ (m : ℕ) (f : ⦋n⦌ ⟶ ⦋m⦌) (_ : Epi f) (y : s.N m), x = X.map f.op (s.ι m y) := by
  obtain ⟨A, y, hy⟩ := Cofan.inj_jointly_surjective_of_isColimit (s.isColimit (op ⦋n⦌)) x
  obtain ⟨⟨m⟩, f, hf⟩ := A
  induction m using SimplexCategory.rec with | _ m
  exact ⟨m, f, hf, y, hy.symm⟩

/-- Two ways of writing a simplex of a split simplicial set as `X.map f.op (s.ι m y)` with `f` an
epimorphism have the same index `m`. -/
private lemma dim_eq_of_map_ι_eq {n m₁ m₂ : ℕ} (f₁ : ⦋n⦌ ⟶ ⦋m₁⦌) [Epi f₁] (f₂ : ⦋n⦌ ⟶ ⦋m₂⦌)
    [Epi f₂] (y₁ : s.N m₁) (y₂ : s.N m₂)
    (h : X.map f₁.op (s.ι m₁ y₁) = X.map f₂.op (s.ι m₂ y₂)) : m₁ = m₂ :=
  congrArg (fun A => (unop (Sigma.fst A)).len)
    (Cofan.eq_of_inj_apply_eq_of_isColimit (s.isColimit (op ⦋n⦌))
      (i₁ := Splitting.IndexSet.mk f₁) (i₂ := Splitting.IndexSet.mk f₂) y₁ y₂ h)

/-- The inclusion `s.ι n` of a splitting of a simplicial set is injective. -/
private lemma ι_injective (n : ℕ) : Function.Injective (s.ι n) := by
  have h := Cofan.inj_injective_of_isColimit (s.isColimit (op ⦋n⦌))
    (Splitting.IndexSet.id (op ⦋n⦌))
  rwa [Splitting.cofan_inj_id] at h

/-- The image of the inclusion `s.ι n` of a splitting of a simplicial set consists of nondegenerate
simplices. -/
private lemma ι_mem_nonDegenerate (n : ℕ) (y : s.N n) : s.ι n y ∈ X.nonDegenerate n := by
  rw [SSet.mem_nonDegenerate_iff_notMem_degenerate, SSet.mem_degenerate_iff]
  rintro ⟨m, hm, f, hf, z, hz⟩
  obtain ⟨k, g, hg, w, rfl⟩ := exists_epi_eq_map_ι s z
  have hk : k ≤ m := SimplexCategory.len_le_of_epi g
  have hcomp : X.map (𝟙 ⦋n⦌).op (s.ι n y) = X.map (f ≫ g).op (s.ι k w) := by
    rw [op_comp, Functor.map_comp, comp_apply]
    simp [← hz]
  have := dim_eq_of_map_ι_eq s (𝟙 ⦋n⦌) (f ≫ g) y w hcomp
  omega

/-- The image of the inclusion `s.ι n` of a splitting of a simplicial set `X` is exactly the set of
nondegenerate `n`-simplices of `X`. -/
private lemma range_ι (n : ℕ) : Set.range (s.ι n) = X.nonDegenerate n := by
  apply Set.Subset.antisymm
  · rintro _ ⟨y, rfl⟩
    exact ι_mem_nonDegenerate s n y
  · intro x hx
    obtain ⟨m, f, hf, y, hy⟩ := exists_epi_eq_map_ι s x
    have := X.isIso_of_nonDegenerate ⟨x, hx⟩ f (s.ι m y) hy.symm
    obtain rfl : m = n :=
      le_antisymm (SimplexCategory.len_le_of_epi f) (SimplexCategory.len_le_of_mono f)
    obtain rfl : f = 𝟙 _ := SimplexCategory.eq_id_of_epi f
    exact Set.mem_range.mpr ⟨y, by simpa using hy.symm⟩

end Splitting

section Statement

variable {X : SSet.{u}}

/-- **Stacks 017R**.
If `s` is a splitting of a simplicial set `X`, then for every `n` there is a unique bijection
between `s.N n` and the set of nondegenerate `n`-simplices of `X` compatible with the maps `s.ι n`
and `Subtype.val` to `X _⦋n⦌`. -/
@[stacks 017R]
public theorem Splitting.existsUnique_equiv_nonDegenerate (s : X.Splitting) (n : ℕ) :
    ∃! e : s.N n ≃ X.nonDegenerate n, ∀ x, (e x : X _⦋n⦌) = s.ι n x :=
  ⟨(Equiv.ofInjective _ (ι_injective s n)).trans (Equiv.subtypeEquivProp (range_ι s n)),
    fun _ => rfl, fun _ he => Equiv.ext fun x => Subtype.ext (he x)⟩

end Statement

end SSet

/-! ### The normalized Moore complex functor reflects degreewise monos, epis and isos -/

namespace AlgebraicTopology

section HomologicalComplex

variable {V : Type u} [Category.{v} V] [HasZeroMorphisms V] {ι : Type*} {c : ComplexShape ι}
  {K L : HomologicalComplex V c} (φ : K ⟶ L)

/-- A morphism of homological complexes is a monomorphism if and only if each component is. -/
private lemma mono_iff_mono_f [HasFiniteLimits V] : Mono φ ↔ ∀ i, Mono (φ.f i) :=
  ⟨fun _ _ => inferInstance, HomologicalComplex.mono_of_mono_f φ⟩

/-- A morphism of homological complexes is an epimorphism if and only if each component is. -/
private lemma epi_iff_epi_f [HasFiniteColimits V] : Epi φ ↔ ∀ i, Epi (φ.f i) :=
  ⟨fun _ _ => inferInstance, HomologicalComplex.epi_of_epi_f φ⟩

/-- A morphism of homological complexes is an isomorphism if and only if each component is. -/
private lemma isIso_iff_isIso_f : IsIso φ ↔ ∀ i, IsIso (φ.f i) :=
  ⟨fun _ _ => inferInstance, fun _ => HomologicalComplex.Hom.isIso_of_components φ⟩

end HomologicalComplex

/-- The normalized Moore complex functor of an abelian category is an equivalence of categories. -/
public theorem isEquivalence_normalizedMooreComplex (A : Type u) [Category.{v} A] [Abelian A] :
    (normalizedMooreComplex A).IsEquivalence :=
  Functor.isEquivalence_of_iso (eqToIso (Abelian.DoldKan.equivalence_functor (A := A)))

section Statement

variable {A : Type u} [Category.{v} A] [Abelian A] {U V : SimplicialObject A}

/-- **Stacks 017W**.
The normalized Moore complex functor `N` of an abelian category reflects (and preserves) degreewise
monomorphisms, epimorphisms and isomorphisms: for a morphism `f : U ⟶ V` of simplicial objects, `f`
is a monomorphism in each degree if and only if `N(f)_m` is a monomorphism for every `m`, and
likewise for epimorphisms and for isomorphisms. -/
@[stacks 017W]
public theorem NormalizedMooreComplex.mono_epi_isIso_app_iff_map_f (f : U ⟶ V) :
    ((∀ Δ : SimplexCategoryᵒᵖ, Mono (f.app Δ)) ↔
        ∀ m : ℕ, Mono (((normalizedMooreComplex A).map f).f m)) ∧
      ((∀ Δ : SimplexCategoryᵒᵖ, Epi (f.app Δ)) ↔
        ∀ m : ℕ, Epi (((normalizedMooreComplex A).map f).f m)) ∧
      ((∀ Δ : SimplexCategoryᵒᵖ, IsIso (f.app Δ)) ↔
        ∀ m : ℕ, IsIso (((normalizedMooreComplex A).map f).f m)) :=
  have := isEquivalence_normalizedMooreComplex A
  ⟨(NatTrans.mono_iff_mono_app f).symm.trans
      (((normalizedMooreComplex A).mono_map_iff_mono f).symm.trans (mono_iff_mono_f _)),
    (NatTrans.epi_iff_epi_app f).symm.trans
      (((normalizedMooreComplex A).epi_map_iff_epi f).symm.trans (epi_iff_epi_f _)),
    (NatTrans.isIso_iff_isIso_app f).symm.trans
      ((isIso_iff_of_reflects_iso f (normalizedMooreComplex A)).symm.trans (isIso_iff_isIso_f _))⟩

end Statement

end AlgebraicTopology

end

/-!
## The sub simplicial object generated by the images from degrees `≤ n`

Let `A` be an abelian category, let `U` be a simplicial object of `A` and let `n ≥ 0`. The rule
`U'_m = Σ_{φ : [m] → [i], i ≤ n} Im(U(φ))`, the sum over all `0 ≤ i ≤ n` and all
order-preserving maps `φ : [m] → [i]`, defines a sub simplicial object `U' ⊆ U` with
`U'_i = U_i` for `i ≤ n`, and `N(U'_m) = 0` for every `m > n`, where `N` is the normalized
Moore object `N(V_m) = ⋂_{i < m} Ker(d^m_i)` of [Stacks, Tag 017V]. That splitting gives
`N(U'_m) = U'_m ∩ N(U_m)` as subobjects of `U_m`, and the vanishing is stated in that form.

### Main definitions

* `Usub`: the subobject `U'_m ⊆ U_m`, the sum of the images of `U(φ)` over the maps
  `φ : [m] → [i]` with `i ≤ n`.
* `normalizedMoore`: the normalized Moore object `⋂_{i < m} Ker(d^m_i) ⊆ U_m`, equal to `U_0`
  for `m = 0`.
* `Degen`: the degenerate subobject `Σ_{φ : [m] → [k], k < m} Im(U(φ)) ⊆ U_m`.
* `revObj`: the simplicial object `SimplexCategory.rev.op ⋙ U`, whose face maps are those of `U`
  reindexed by `Fin.rev`.

### Main results

* `Usub_isSubSimplicial`: `U(ψ)` maps `U'_m` into `U'_{m'}` for every `ψ : [m'] → [m]`.
* `Usub_eq_top_of_le`: `U'_i = U_i` for every `i ≤ n`.
* `Usub_inf_moore_eq_bot`: `U'_m ⊓ N(U_m) = ⊥` for every `m > n`.
* `degenerate_inf_moore_eq_bot`: `Degen U m ⊓ normalizedMoore U m = ⊥` for every `m > 0`.

### References

* [Stacks, Tag 017Y](https://stacks.math.columbia.edu/tag/017Y)
-/

section

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe v u

variable {C : Type u} [Category.{v} C] [Abelian C]

namespace CategoryTheory.SimplicialObject

/-- The subobject `U'_m = Σ_{φ : [m] → [i], i ≤ n} Im(U(φ))` of `U_m`, the supremum in the
lattice of subobjects of `U_m` of the images of `U(φ) : U_i → U_m` over all integers
`0 ≤ i ≤ n` and all order-preserving maps `φ : [m] → [i]`. -/
noncomputable def Usub (U : SimplicialObject C) (n m : ℕ) :
    Subobject (U.obj (Opposite.op (SimplexCategory.mk m))) :=
  letI : Fintype (Σ i : Fin (n + 1), SimplexCategory.mk m ⟶ SimplexCategory.mk i.val) :=
    Fintype.ofFinite _
  Finset.univ.sup
    (fun (p : Σ i : Fin (n + 1), SimplexCategory.mk m ⟶ SimplexCategory.mk i.val) =>
      imageSubobject (U.map p.2.op))

/-- The normalized Moore object of `U` in degree `m` in the *Stacks* convention:
`N(U_m) = ⋂_{i=0}^{m-1} Ker(d^m_i)` for `m ≥ 1`, and `N(U_0) = U_0`. For `m = k + 1` the face
map `d^m_i : U_m → U_{m-1}` is `U.δ i` with `i : Fin (k + 2)`, and the intersection is over the
indices `Fin (k + 1)` embedded by `Fin.castSucc`, omitting the last index `m`. -/
noncomputable def normalizedMoore (U : SimplicialObject C) (m : ℕ) :
    Subobject (U.obj (Opposite.op (SimplexCategory.mk m))) :=
  match m with
  | 0 => ⊤
  | (k + 1) =>
      Finset.univ.inf (fun (i : Fin (k + 1)) =>
        kernelSubobject (U.δ (i.castSucc : Fin (k + 2))))

/-- A morphism factors through a subobject `Q` exactly when its image subobject is
`≤ Q`. -/
theorem factors_of_imageSubobject_le {Y Z : C} (Q : Subobject Y) (f : Z ⟶ Y)
    (h : imageSubobject f ≤ Q) : Q.Factors f :=
  Subobject.factors_of_le f h <| by
    simpa only [imageSubobject_arrow_comp] using
      Subobject.factors_comp_arrow (P := imageSubobject f) (factorThruImageSubobject f)

/-- The image of `U(φ)` for a map `φ : [m] → [i]` with `i ≤ n` is contained in `U'_m`. -/
private lemma imageSubobject_map_le_Usub (U : SimplicialObject C) {n m i : ℕ} (hi : i ≤ n)
    (φ : SimplexCategory.mk m ⟶ SimplexCategory.mk i) :
    imageSubobject (U.map φ.op) ≤ Usub U n m := by
  unfold Usub
  let : Fintype (Σ j : Fin (n + 1), SimplexCategory.mk m ⟶ SimplexCategory.mk j.val) :=
    Fintype.ofFinite _
  exact Finset.le_sup (f := fun (p : Σ j : Fin (n + 1),
      SimplexCategory.mk m ⟶ SimplexCategory.mk j.val) => imageSubobject (U.map p.2.op))
    (b := ⟨⟨i, by omega⟩, φ⟩) (Finset.mem_univ _)

/-- **Stacks 017Y** (1).
`U'` is a sub simplicial object of `U`: for every order-preserving map `ψ : [m'] → [m]` the
morphism `U(ψ) : U_m → U_{m'}` maps `U'_m` into `U'_{m'}`, that is, the composite
`(U'_m).arrow ≫ U(ψ)` factors through `U'_{m'}`. -/
@[stacks 017Y "(1)"]
theorem Usub_isSubSimplicial (U : SimplicialObject C) (n m m' : ℕ)
    (ψ : SimplexCategory.mk m' ⟶ SimplexCategory.mk m) :
    (Usub U n m').Factors ((Usub U n m).arrow ≫ U.map ψ.op) := by
  set h : U.obj (Opposite.op (SimplexCategory.mk m)) ⟶
      U.obj (Opposite.op (SimplexCategory.mk m')) := U.map ψ.op with hh
  apply factors_of_imageSubobject_le
  rw [← Subobject.exists_eq_imageSubobject, (Subobject.existsPullbackAdj h).gc.le_iff_le]
  apply Finset.sup_le
  rintro ⟨i, φ⟩ _
  have hcomp : U.map φ.op ≫ h = U.map ((ψ ≫ φ).op) := by
    rw [hh, ← U.map_comp]
    congr 1
  rw [← (Subobject.existsPullbackAdj h).gc.le_iff_le, ← Subobject.imageSubobject_comp_eq_exists,
    hcomp]
  exact imageSubobject_map_le_Usub U i.is_le _

/-- **Stacks 017Y** (2).
For every `i ≤ n` one has `U'_i = U_i`, that is, `U'_i` is the top subobject of `U_i`. -/
@[stacks 017Y "(2)"]
theorem Usub_eq_top_of_le (U : SimplicialObject C) (n i : ℕ) (h : i ≤ n) :
    Usub U n i = ⊤ := by
  rw [eq_top_iff]
  refine le_trans ?_ (imageSubobject_map_le_Usub U h (𝟙 (SimplexCategory.mk i)))
  have hid : U.map (𝟙 (SimplexCategory.mk i)).op = 𝟙 _ := by
    rw [op_id, U.map_id]
  rw [hid]
  have : IsIso (imageSubobject (𝟙 (U.obj (Opposite.op (SimplexCategory.mk i))))).arrow := by
    have : IsSplitEpi (imageSubobject (𝟙 (U.obj (Opposite.op (SimplexCategory.mk i))))).arrow :=
      ⟨⟨{ section_ := factorThruImageSubobject _, id := imageSubobject_arrow_comp _ }⟩⟩
    exact isIso_of_mono_of_isSplitEpi _
  exact (Subobject.eq_top_of_isIso_arrow _).ge

/-- The *degenerate subobject* `D(U_m) = Σ_{φ : [m] → [k], k < m} Im(U(φ))` of `U_m`, the sum
of the images of `U(φ)` over all order-preserving maps `φ` to a *strictly lower* degree. Since
every such `φ` factors through a surjection `[m] ↠ [k']` with `k' ≤ k < m`, this equals the sum
of `Im(U(σ))` over the surjections `σ : [m] ↠ [k']` with `k' < m`, the degenerate part of `U_m`
in the splitting of [Stacks, Tag 017V]. -/
noncomputable def Degen (U : SimplicialObject C) (m : ℕ) :
    Subobject (U.obj (Opposite.op (SimplexCategory.mk m))) :=
  letI : Fintype (Σ k : Fin m, SimplexCategory.mk m ⟶ SimplexCategory.mk k.val) :=
    Fintype.ofFinite _
  Finset.univ.sup
    (fun (p : Σ k : Fin m, SimplexCategory.mk m ⟶ SimplexCategory.mk k.val) =>
      imageSubobject (U.map p.2.op))

/-- For `n < m` the subobject `U'_m` is contained in the degenerate part: every map
`φ : [m] → [i]` with `i ≤ n < m` factors as an epi `[m] ↠ [k]` followed by a mono `[k] ↪ [i]`
with `k < m`, so `Im(U(φ))` lies in `Degen U m`. -/
theorem Usub_le_degenerate (U : SimplicialObject C) (n m : ℕ) (h : n < m) :
    Usub U n m ≤ Degen U m := by
  unfold Usub Degen
  let : Fintype (Σ i : Fin (n + 1), SimplexCategory.mk m ⟶ SimplexCategory.mk i.val) :=
    Fintype.ofFinite _
  let : Fintype (Σ k : Fin m, SimplexCategory.mk m ⟶ SimplexCategory.mk k.val) :=
    Fintype.ofFinite _
  apply Finset.sup_le
  rintro ⟨i, φ⟩ _
  have hki : (image φ).len ≤ i.val := SimplexCategory.len_le_of_mono (image.ι φ)
  have hkm : (image φ).len < m := by omega
  set ι₀ : image φ ⟶ SimplexCategory.mk ((image φ).len) :=
    eqToHom (SimplexCategory.mk_len (image φ)).symm
  set e' : SimplexCategory.mk m ⟶ SimplexCategory.mk ((image φ).len) :=
    factorThruImage φ ≫ ι₀ with he'
  refine le_trans ?_ (Finset.le_sup (f := fun (p : Σ k : Fin m,
      SimplexCategory.mk m ⟶ SimplexCategory.mk k.val) => imageSubobject (U.map p.2.op))
    (b := ⟨⟨(image φ).len, hkm⟩, e'⟩) (Finset.mem_univ _))
  have hee' : imageSubobject (U.map e'.op)
      = imageSubobject (U.map (factorThruImage φ).op) := by
    rw [he', op_comp, U.map_comp]
    exact imageSubobject_iso_comp (U.map ι₀.op) (U.map (factorThruImage φ).op)
  rw [hee']
  -- Rewriting the goal by `hcomp` is not possible: the `HasImage` instance argument of
  -- `imageSubobject` depends on the morphism, so the motive is not type correct.
  have hcomp : U.map φ.op
      = U.map (image.ι φ).op ≫ U.map (factorThruImage φ).op := by
    rw [← U.map_comp, ← op_comp, image.fac]
  have hle := imageSubobject_comp_le (U.map (image.ι φ).op) (U.map (factorThruImage φ).op)
  rwa [← hcomp] at hle

section Reversal

open AlgebraicTopology SimplexCategory AlgebraicTopology.DoldKan

omit [Abelian C] in
/-- The action of `revObj U` on `f.op` is the action of `U` on `(rev.map f).op`. -/
theorem revObj_map (U : SimplicialObject C) {X Y : SimplexCategory} (f : X ⟶ Y) :
    (revObj U).map f.op = U.map (rev.map f).op := rfl

/-- Mathlib's normalized Moore object of `revObj U` in degree `k + 1` is the Stacks Moore object
of `U` in degree `k + 1`. -/
theorem objX_revObj_eq (U : SimplicialObject C) (k : ℕ) :
    AlgebraicTopology.NormalizedMooreComplex.objX (revObj U) (k+1) = normalizedMoore U (k+1) := by
  rw [objX_revObj_add_one, normalizedMoore]

/-- **Stacks 017X**.
The last face carries the Stacks-convention normalized Moore subobject in degree `n + 1` into the
normalized Moore subobject in degree `n`. -/
@[stacks 017X]
theorem normalizedMoore_factors_arrow_comp_δ_last (U : SimplicialObject C) (n : ℕ) :
    (normalizedMoore U n).Factors
      ((normalizedMoore U (n + 1)).arrow ≫ U.δ (Fin.last (n + 1))) := by
  cases n with
  | zero =>
      rw [normalizedMoore]
      exact Subobject.top_factors _
  | succ n =>
      show (Finset.univ.inf (fun i : Fin (n + 1) =>
          kernelSubobject (U.δ i.castSucc))).Factors
        ((Finset.univ.inf (fun j : Fin (n + 2) =>
          kernelSubobject (U.δ j.castSucc))).arrow ≫ U.δ (Fin.last (n + 2)))
      rw [Subobject.finset_inf_factors]
      intro i _
      apply kernelSubobject_factors
      rw [Category.assoc, U.δ_comp_δ' (Fin.castSucc_lt_last i.castSucc), ← Category.assoc,
        finset_inf_kernelSubobject_arrow_comp (fun j : Fin (n + 2) ↦ U.δ j.castSucc) _
          i.castSucc (Finset.mem_univ _), zero_comp]

/-- A degeneracy generator of `Degen U m` is killed by `PInfty (revObj U)`:
for `φ : [m] ⟶ [k]` with `k < m`, `U(φ) ≫ PInfty(revObj U)_m = 0`. -/
theorem degen_gen_comp_PInfty (U : SimplicialObject C) {m k : ℕ} (hk : k < m)
    (φ : SimplexCategory.mk m ⟶ SimplexCategory.mk k) :
    U.map φ.op ≫ (PInfty (X := revObj U)).f m = 0 := by
  have hmap : (revObj U).map (rev.map φ).op = U.map φ.op := by
    rw [revObj_map]
    exact congrArg (fun g => U.map g.op) (rev_map_rev_map φ)
  rw [← hmap]
  have hnm : ¬ Mono (rev.map φ) := by
    intro hm
    have h2 := SimplexCategory.len_le_of_mono (rev.map φ)
    simp only [rev_obj, SimplexCategory.len_mk] at h2
    omega
  exact degeneracy_comp_PInfty (revObj U) m (rev.map φ) hnm

/-- A subobject whose arrow is the zero morphism is `⊥`. -/
theorem sub_eq_bot_of_arrow_zero {Y : C} (S : Subobject Y) (h : S.arrow = 0) : S = ⊥ := by
  rw [← le_bot_iff]
  apply Subobject.le_of_comm (0 : (S : C) ⟶ ((⊥ : Subobject Y) : C))
  rw [zero_comp, h]

end Reversal

open AlgebraicTopology SimplexCategory AlgebraicTopology.DoldKan

/-- If an endomorphism `e` of `Y` annihilates the subobject `S` and fixes the subobject `T`,
then `S ⊓ T = ⊥`. -/
theorem inf_eq_bot_of_le_kernelSubobject {Y : C} {S T : Subobject Y} (e : Y ⟶ Y)
    (hS : S ≤ kernelSubobject e) (hT : T.arrow ≫ e = T.arrow) : S ⊓ T = ⊥ := by
  have hA : (S ⊓ T).arrow ≫ e = 0 := by
    rw [← Subobject.ofLE_arrow (inf_le_left.trans hS), Category.assoc,
      kernelSubobject_arrow_comp, comp_zero]
  have hB : (S ⊓ T).arrow ≫ e = (S ⊓ T).arrow := by
    rw [← Subobject.ofLE_arrow inf_le_right, Category.assoc, hT, Subobject.ofLE_arrow]
  exact sub_eq_bot_of_arrow_zero _ (hB.symm.trans hA)

/-- For `m > 0` the degenerate part of `U_m` meets the normalized Moore object in the zero
subobject: `Degen U m ⊓ normalizedMoore U m = ⊥`. This is the intersection of the two summands of
the direct-sum decomposition `U_m = N(U_m) ⊕ D(U_m)` of [Stacks, Tag 017V]. -/
theorem degenerate_inf_moore_eq_bot (U : SimplicialObject C) (m : ℕ) (h : 0 < m) :
    Degen U m ⊓ normalizedMoore U m = ⊥ := by
  obtain ⟨k, rfl⟩ : ∃ k, m = k + 1 := ⟨m - 1, by omega⟩
  refine inf_eq_bot_of_le_kernelSubobject ((PInfty (X := revObj U)).f (k+1)) ?_ ?_
  · unfold Degen
    let : Fintype (Σ j : Fin (k+1), SimplexCategory.mk (k+1) ⟶ SimplexCategory.mk j.val) :=
      Fintype.ofFinite _
    exact Finset.sup_le fun ⟨j, φ⟩ _ => image_le_kernel _ _ (degen_gen_comp_PInfty U j.isLt φ)
  · rw [← objX_revObj_eq U k, PInfty_f]
    refine HigherFacesVanish.comp_P_eq_self (X := revObj U) (q := k + 1) ?_
    rw [HigherFacesVanish]
    intro j _
    exact arrow_objX_comp_δ_succ (revObj U) k j

/-- **Stacks 017Y** (3).
For every `m > n` one has `N(U'_m) = 0`. By the splitting of [Stacks, Tag 017V] one has
`N(U'_m) = U'_m ∩ N(U_m)` as subobjects of `U_m`, so the assertion is that the intersection
`U'_m ⊓ N(U_m)` is the zero subobject. -/
@[stacks 017Y "(3)"]
theorem Usub_inf_moore_eq_bot (U : SimplicialObject C) (n m : ℕ) (h : n < m) :
    Usub U n m ⊓ normalizedMoore U m = ⊥ := by
  have hbot : Degen U m ⊓ normalizedMoore U m = ⊥ :=
    degenerate_inf_moore_eq_bot U m (by omega)
  rw [← le_bot_iff] at hbot ⊢
  exact le_trans (inf_le_inf_right _ (Usub_le_degenerate U n m h)) hbot

end CategoryTheory.SimplicialObject

