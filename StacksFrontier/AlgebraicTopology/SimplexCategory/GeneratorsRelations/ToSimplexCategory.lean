/-!
# `Δ` is presented by the faces and the degeneracies

Mathlib's `SimplexCategoryGenRel` is the category presented by generating morphisms `δ i`, `σ i`
and *exactly* the simplicial identities of [Stacks, Tag 0167]: it is the path category on the
quiver `FreeSimplexQuiver` modulo `FreeSimplexQuiver.homRel`. The canonical comparison functor
`SimplexCategoryGenRel.toSimplexCategory` sends `mk n` to `⦋n⦌` and the generators to
`SimplexCategory.δ i` and `SimplexCategory.σ i`. This file proves that it is an isomorphism of
categories: it is faithful, full and bijective on objects, and it has a two-sided inverse
functor on the nose.

That is the content of [Stacks, Tag 0166] and [Stacks, Tag 0168] — `Δ` is generated by the
`δ^n_j` and the `σ^n_j` subject to the relations of [Stacks, Tag 0167] and nothing more — and it
is what makes a simplicial object of `C` the same datum as a system `(U_n, d^n_j, s^n_j)`
satisfying those relations ([Stacks, Tag 016B]) and a cosimplicial object the same datum as a
coface–codegeneracy system ([Stacks, Tag 016K]).

Faithfulness is the substance. Every morphism of `SimplexCategoryGenRel` factors as a composite
of degeneracies followed by a composite of faces
(`SimplexCategoryGenRel.exists_P_σ_P_δ_factorization`), and in `Δ` such a factorization is an
epi-mono factorization, so it is unique up to unique isomorphism — and `Δ` being skeletal, on the
nose. So it suffices to know that a composite of faces, resp. of degeneracies, in
`SimplexCategoryGenRel` is determined by its image in `Δ`, which is proved by induction on the
length of the composite: a composite of faces whose image misses an index `t` can be rewritten so
that its last factor is `δ t`, and dually a composite of degeneracies whose image identifies `t`
and `t + 1` can be rewritten so that its first factor is `σ t`. The bookkeeping for those
rewritings is the arithmetic of `Fin.succAbove` and `Fin.predAbove` recorded first.

Fullness is the observation that the morphisms of `Δ` in the image of `toSimplexCategory` form a
multiplicative morphism property containing the faces and the degeneracies, hence all of `Δ` by
`SimplexCategory.morphismProperty_eq_top`. Bijectivity on objects is `SimplexCategoryGenRel.ext`
together with `mk`.

## Main results

* `SimplexCategoryGenRel.toSimplexCategory_faithful`,
  `SimplexCategoryGenRel.toSimplexCategory_full`,
  `SimplexCategoryGenRel.toSimplexCategory_bijective_obj`: the comparison functor is faithful,
  full and bijective on objects.
* `SimplexCategoryGenRel.toSimplexCategory_op_bijective_obj`: the same on objects for the
  opposite functor, which is what a presheaf statement needs.
* `SimplexCategoryGenRel.toSimplexCategoryInv`: the inverse functor `Δ ⥤ SimplexCategoryGenRel`,
  together with `SimplexCategoryGenRel.toSimplexCategoryInv_comp_toSimplexCategory` and
  `SimplexCategoryGenRel.toSimplexCategory_comp_toSimplexCategoryInv`, the two composites being
  the identity functors on the nose rather than isomorphic to them.

## Implementation notes

The inverse is built by choosing, for each morphism `φ` of `Δ`, a preimage under fullness, and
the two composite identities are then `CategoryTheory.Functor.hext` applied to the object
equality `mk x.len = x`, which holds by `rfl`, and to faithfulness on morphisms. Both composites
are therefore *equalities* of functors, which is what [Stacks, Tag 016B] and [Stacks, Tag 016K]
need: an equivalence of categories would pin the (co)simplicial object of the source only up to
isomorphism, and the source asserts `U_n = U(⦋n⦌)` on the nose.

The relations of [Stacks, Tag 0167] are not spelled out anywhere here; they are the defining
relations of `SimplexCategoryGenRel`, namely `SimplexCategoryGenRel.δ_comp_δ`,
`δ_comp_σ_of_le`, `δ_comp_σ_self`, `δ_comp_σ_succ`, `δ_comp_σ_of_gt` and `σ_comp_σ`.

## References

* [Stacks, Tag 0166](https://stacks.math.columbia.edu/tag/0166)
* [Stacks, Tag 0167](https://stacks.math.columbia.edu/tag/0167)
* [Stacks, Tag 0168](https://stacks.math.columbia.edu/tag/0168)
-/

open CategoryTheory Opposite Simplicial

universe v u

namespace SimplexCategoryGenRel


/-! ### Arithmetic of `Fin.succAbove` and `Fin.predAbove` -/

/-- Removing the index `i` from `Fin (n + 1)` and then collapsing at `i` sends the lower end of
the gap at `i.succAbove t` to the lower end of the gap at `t`. -/
private lemma predAbove_castSucc_succAbove {n : ℕ} (i : Fin (n + 1)) (t : Fin n) :
    i.predAbove (i.succAbove t).castSucc = t.castSucc := by
  rcases Fin.lt_or_ge t.castSucc i with h | h
  · rw [Fin.succAbove_of_castSucc_lt _ _ h, Fin.predAbove_castSucc_of_le _ _ h.le]
  · rw [Fin.succAbove_of_le_castSucc _ _ h, ← Fin.succ_castSucc,
      Fin.predAbove_succ_of_le _ _ h]

/-- Removing the index `i` from `Fin (n + 1)` and then collapsing at `i` sends the upper end of
the gap at `i.succAbove t` to the upper end of the gap at `t`. -/
private lemma predAbove_succ_succAbove {n : ℕ} (i : Fin (n + 1)) (t : Fin n) :
    i.predAbove (i.succAbove t).succ = t.succ := by
  rcases Fin.lt_or_ge t.castSucc i with h | h
  · rw [Fin.succAbove_of_castSucc_lt _ _ h, Fin.predAbove_succ_of_lt _ _ h]
    ext; simp
  · rw [Fin.succAbove_of_le_castSucc _ _ h,
      Fin.predAbove_succ_of_le _ _ (h.trans (Fin.castSucc_le_succ t))]

/-- Collapsing at `i` identifies `t.castSucc` and `t.succ` exactly when `t = i`. -/
private lemma predAbove_castSucc_eq_predAbove_succ_iff {n : ℕ} (i t : Fin (n + 1)) :
    i.predAbove t.castSucc = i.predAbove t.succ ↔ t = i := by
  refine ⟨fun h => ?_, fun h => by subst h; simp⟩
  by_contra hne
  rcases lt_or_gt_of_ne hne with hlt | hgt
  · rw [Fin.predAbove_castSucc_of_le _ _ hlt.le, Fin.predAbove_succ_of_lt _ _ hlt] at h
    exact absurd (congrArg Fin.val h) (by simp)
  · rw [Fin.predAbove_castSucc_of_lt _ _ hgt, Fin.predAbove_succ_of_le _ _ hgt.le] at h
    have h' := congrArg Fin.val h
    simp only [Fin.val_pred, Fin.val_castSucc] at h'
    have : 0 < t.val := lt_of_le_of_lt (Nat.zero_le _) hgt
    omega

/-! ### Moving a generator through a composite of generators -/

/-- Either `i = w.succ` for some `t ≤ w`, or `i = w.castSucc` for some `w ≤ t`, according to which
side of `i` the gap `t` lies on, and `i.succAbove t` is the matching end of the gap. -/
private lemma exists_eq_succ_or_eq_castSucc {n : ℕ} (i : Fin (n + 2)) (t : Fin (n + 1)) :
    (∃ w, t ≤ w ∧ i = w.succ ∧ i.succAbove t = t.castSucc) ∨
      (∃ w, w ≤ t ∧ i = w.castSucc ∧ i.succAbove t = t.succ) := by
  rcases lt_or_ge t.castSucc i with hlt | hge
  · refine Or.inl ⟨i.pred (Fin.ne_zero_of_lt hlt), ?_, (Fin.succ_pred _ _).symm,
      Fin.succAbove_of_castSucc_lt _ _ hlt⟩
    simp only [Fin.lt_def, Fin.val_castSucc] at hlt
    simp only [Fin.le_def, Fin.val_pred]
    omega
  · have hne : i ≠ Fin.last (n + 1) :=
      Fin.ne_last_of_lt (lt_of_le_of_lt hge (Fin.castSucc_lt_last t))
    refine Or.inr ⟨i.castPred hne, ?_, (Fin.castSucc_castPred _ _).symm,
      Fin.succAbove_of_le_castSucc _ _ hge⟩
    simp only [Fin.le_def, Fin.val_castSucc] at hge
    simp only [Fin.le_def, Fin.coe_castPred]
    omega

/-- Any composite `δ s ≫ δ i` of two faces can be rewritten as a composite of two faces whose
second factor is `δ (i.succAbove s)`. -/
private lemma exists_δ_comp_δ_eq {c : ℕ} (s : Fin (c + 2)) (i : Fin (c + 3)) :
    ∃ w : Fin (c + 2), δ s ≫ δ i = δ w ≫ δ (i.succAbove s) := by
  rcases exists_eq_succ_or_eq_castSucc i s with ⟨w, hw, rfl, h⟩ | ⟨w, hw, rfl, h⟩
  · exact ⟨w, by rw [h]; exact δ_comp_δ hw⟩
  · exact ⟨w, by rw [h]; exact (δ_comp_δ hw).symm⟩

/-- Any composite `σ i ≫ σ t` of two degeneracies can be rewritten as a composite of two
degeneracies whose first factor is `σ (i.succAbove t)`. -/
private lemma exists_σ_comp_σ_eq {n : ℕ} (i : Fin (n + 2)) (t : Fin (n + 1)) :
    ∃ w : Fin (n + 1), σ i ≫ σ t = σ (i.succAbove t) ≫ σ w := by
  rcases exists_eq_succ_or_eq_castSucc i t with ⟨w, hw, rfl, h⟩ | ⟨w, hw, rfl, h⟩
  · exact ⟨w, by rw [h]; exact (σ_comp_σ hw).symm⟩
  · exact ⟨w, by rw [h]; exact σ_comp_σ hw⟩

/-! ### Lengths -/

/-- A composite of degeneracies is an identity, or strictly decreases the length. -/
private lemma eq_or_len_lt_of_P_σ {x y : SimplexCategoryGenRel} {f : x ⟶ y} (hf : P_σ f) :
    (∃ h : x = y, f = eqToHom h) ∨ y.len < x.len := by
  induction hf with
  | of _ hx => cases hx; right; simp
  | id => exact Or.inl ⟨rfl, by simp⟩
  | comp_of u g _ hg h' =>
    cases hg with | σ k =>
    refine Or.inr ?_
    rcases h' with ⟨e, -⟩ | h'
    · subst e; simp
    · simp only [mk_len] at h' ⊢; omega

/-! ### Factoring out a face or a degeneracy -/

/-- A composite of faces whose image in `Δ` misses `t` can be rewritten as a composite of faces
whose last factor is `δ t`. -/
private lemma exists_P_δ_eq_comp_δ {x y : SimplexCategoryGenRel} {m : x ⟶ y} (hm : P_δ m) :
    ∀ {c : ℕ} (h : y = mk (c + 1)) (t : Fin (c + 2)),
      (∀ j, (toSimplexCategory.map (m ≫ eqToHom h)).toOrderHom j ≠ t) →
      ∃ u : x ⟶ mk c, P_δ u ∧ m ≫ eqToHom h = u ≫ δ t := by
  induction hm with
  | of f hf =>
    cases hf with | @δ n i =>
    intro c h t ht
    obtain rfl : n = c := by simpa using congrArg len h
    refine ⟨𝟙 _, P_δ.id_mem _, ?_⟩
    have hti : t = i := by
      by_contra hne
      obtain ⟨j, hj⟩ := Fin.exists_succAbove_eq hne
      refine ht j ?_
      simp only [eqToHom_refl, Category.comp_id, toSimplexCategory_map_δ]
      rw [← hj]
      rfl
    subst hti
    simp
  | id z =>
    intro c h t ht
    subst h
    refine absurd ?_ (ht t)
    simp only [eqToHom_refl, Category.comp_id]
    rfl
  | @comp_of x' y' z' f g hf hg hrec =>
    cases hg with | @δ n i =>
    intro c h t ht
    obtain rfl : n = c := by simpa using congrArg len h
    rw [eqToHom_refl, Category.comp_id] at ht ⊢
    by_cases hti : t = i
    · exact ⟨f, hf, by rw [hti]⟩
    obtain ⟨s, hs⟩ := Fin.exists_succAbove_eq hti
    have hf' : ∀ j, (toSimplexCategory.map
        (f ≫ eqToHom (rfl : (mk n : SimplexCategoryGenRel) = mk n))).toOrderHom j ≠ s := by
      intro j hj
      rw [eqToHom_refl, Category.comp_id] at hj
      refine ht j ?_
      rw [Functor.map_comp, SimplexCategory.comp_toOrderHom]
      simp only [OrderHom.comp_coe, Function.comp_apply, hj, toSimplexCategory_map_δ]
      rw [← hs]
      rfl
    obtain _ | c' := n
    · exact absurd (Subsingleton.elim (α := Fin 1) _ _) (hf' 0)
    obtain ⟨u', hu', hfu⟩ := hrec (c := c') rfl s hf'
    rw [eqToHom_refl, Category.comp_id] at hfu
    obtain ⟨w, hw⟩ := exists_δ_comp_δ_eq s i
    refine ⟨u' ≫ δ w, P_δ.comp_mem _ _ hu' (P_δ.δ w), ?_⟩
    rw [hfu, Category.assoc, hw, hs, Category.assoc]

/-- A composite of degeneracies whose image in `Δ` identifies `t` and `t + 1` can be rewritten
as a composite of degeneracies whose first factor is `σ t`. -/
private lemma exists_P_σ_eq_σ_comp {x y : SimplexCategoryGenRel} {e : x ⟶ y} (he : P_σ e) :
    ∀ {a : ℕ} (h : mk (a + 1) = x) (t : Fin (a + 1)),
      (toSimplexCategory.map (eqToHom h ≫ e)).toOrderHom t.castSucc
          = (toSimplexCategory.map (eqToHom h ≫ e)).toOrderHom t.succ →
      ∃ v : mk a ⟶ y, P_σ v ∧ eqToHom h ≫ e = σ t ≫ v := by
  replace he : degeneracies.multiplicativeClosure' e := by
    rwa [← MorphismProperty.multiplicativeClosure_eq_multiplicativeClosure']
  induction he with
  | of f hf =>
    cases hf with | @σ n i =>
    intro a h t ht
    obtain rfl : a = n := by simpa using congrArg len h
    rw [eqToHom_refl, Category.id_comp] at ht ⊢
    rw [toSimplexCategory_map_σ] at ht
    obtain rfl : t = i := (predAbove_castSucc_eq_predAbove_succ_iff i t).mp ht
    exact ⟨𝟙 _, P_σ.id_mem _, by simp⟩
  | id z =>
    intro a h t ht
    subst h
    simp only [eqToHom_refl, Category.id_comp] at ht
    exact absurd (ht : t.castSucc = t.succ) Fin.castSucc_lt_succ.ne
  | @of_comp x' y' z' f g hf hg hrec =>
    cases hf with | @σ n i =>
    intro a h t ht
    obtain rfl : a = n := by simpa using congrArg len h
    rw [eqToHom_refl, Category.id_comp] at ht ⊢
    by_cases hti : t = i
    · refine ⟨g, ?_, by rw [hti]⟩
      change degeneracies.multiplicativeClosure g
      rw [MorphismProperty.multiplicativeClosure_eq_multiplicativeClosure']
      exact hg
    obtain ⟨t', hs⟩ := Fin.exists_succAbove_eq hti
    subst hs
    obtain _ | a' := a
    · exact t'.elim0
    have ht2 : (toSimplexCategory.map g).toOrderHom
          ((SimplexCategory.σ i).toOrderHom (i.succAbove t').castSucc)
        = (toSimplexCategory.map g).toOrderHom
          ((SimplexCategory.σ i).toOrderHom (i.succAbove t').succ) := by
      rwa [Functor.map_comp, toSimplexCategory_map_σ] at ht
    have hA : (SimplexCategory.σ i).toOrderHom (i.succAbove t').castSucc = t'.castSucc :=
      predAbove_castSucc_succAbove i t'
    have hB : (SimplexCategory.σ i).toOrderHom (i.succAbove t').succ = t'.succ :=
      predAbove_succ_succAbove i t'
    have hg' : (toSimplexCategory.map
          (eqToHom (rfl : (mk (a' + 1) : SimplexCategoryGenRel) = mk (a' + 1)) ≫ g)).toOrderHom
          t'.castSucc
        = (toSimplexCategory.map
          (eqToHom (rfl : (mk (a' + 1) : SimplexCategoryGenRel) = mk (a' + 1)) ≫ g)).toOrderHom
          t'.succ := by
      rw [eqToHom_refl, Category.id_comp]
      exact (congrArg (⇑(toSimplexCategory.map g).toOrderHom) hA.symm).trans
        (ht2.trans (congrArg (⇑(toSimplexCategory.map g).toOrderHom) hB))
    obtain ⟨v', hv', hgv⟩ := hrec (a := a') rfl t' hg'
    rw [eqToHom_refl, Category.id_comp] at hgv
    obtain ⟨w, hw⟩ := exists_σ_comp_σ_eq i t'
    exact ⟨σ w ≫ v', P_σ.comp_mem _ _ (P_σ.σ w) hv', by
      rw [hgv, ← Category.assoc, hw, Category.assoc]⟩

/-! ### Rigidity of the two factors -/

/-- A composite of faces is determined by its image in `Δ`. -/
private lemma eq_of_P_δ_of_map_eq : ∀ (b : ℕ) {x : SimplexCategoryGenRel} {m₁ m₂ : x ⟶ mk b},
    P_δ m₁ → P_δ m₂ → toSimplexCategory.map m₁ = toSimplexCategory.map m₂ → m₁ = m₂ := by
  have base : ∀ {b : ℕ} {x : SimplexCategoryGenRel} {m₁ m₂ : x ⟶ mk b},
      P_δ m₁ → P_δ m₂ → b ≤ x.len → m₁ = m₂ := by
    intro b x m₁ m₂ h₁ h₂ hb
    obtain ⟨e₁, rfl⟩ | hlt₁ := eq_or_len_le_of_P_δ h₁
    · obtain ⟨e₂, rfl⟩ | hlt₂ := eq_or_len_le_of_P_δ h₂
      · rfl
      · rw [e₁] at hlt₂; simp at hlt₂
    · simp only [mk_len] at hlt₁; omega
  intro b
  induction b with
  | zero => intro x m₁ m₂ h₁ h₂ _; exact base h₁ h₂ (Nat.zero_le _)
  | succ b ih =>
    intro x m₁ m₂ h₁ h₂ hmap
    by_cases hsurj : Function.Surjective (toSimplexCategory.map m₁).toOrderHom
    · have hcard := Fintype.card_le_of_surjective _ hsurj
      simp only [Fintype.card_fin] at hcard
      simp only [toSimplexCategory_len, mk_len] at hcard
      exact base h₁ h₂ (by omega)
    · obtain ⟨t, ht⟩ := not_forall.mp hsurj
      have ht₁ : ∀ j, (toSimplexCategory.map
          (m₁ ≫ eqToHom (rfl : (mk (b + 1) : SimplexCategoryGenRel) = mk (b + 1)))).toOrderHom
            j ≠ t := by
        simpa using not_exists.mp ht
      have ht₂ : ∀ j, (toSimplexCategory.map
          (m₂ ≫ eqToHom (rfl : (mk (b + 1) : SimplexCategoryGenRel) = mk (b + 1)))).toOrderHom
            j ≠ t := by
        simpa [← hmap] using not_exists.mp ht
      obtain ⟨u₁, hu₁, e₁⟩ := exists_P_δ_eq_comp_δ h₁ rfl t ht₁
      obtain ⟨u₂, hu₂, e₂⟩ := exists_P_δ_eq_comp_δ h₂ rfl t ht₂
      rw [eqToHom_refl, Category.comp_id] at e₁ e₂
      have hr : toSimplexCategory.map (δ t) ≫
          toSimplexCategory.map (splitMonoδ t).retraction = 𝟙 _ := by
        rw [← Functor.map_comp, (splitMonoδ t).id, CategoryTheory.Functor.map_id]
      have hmapu : toSimplexCategory.map u₁ = toSimplexCategory.map u₂ := by
        have h' : toSimplexCategory.map u₁ ≫ toSimplexCategory.map (δ t) =
            toSimplexCategory.map u₂ ≫ toSimplexCategory.map (δ t) := by
          rw [← Functor.map_comp, ← Functor.map_comp, ← e₁, ← e₂, hmap]
        simpa only [Category.assoc, hr, Category.comp_id] using
          h' =≫ toSimplexCategory.map (splitMonoδ t).retraction
      rw [e₁, e₂, ih hu₁ hu₂ hmapu]

/-- A composite of degeneracies is determined by its image in `Δ`. -/
private lemma eq_of_P_σ_of_map_eq : ∀ (a : ℕ) {y : SimplexCategoryGenRel} {e₁ e₂ : mk a ⟶ y},
    P_σ e₁ → P_σ e₂ → toSimplexCategory.map e₁ = toSimplexCategory.map e₂ → e₁ = e₂ := by
  have base : ∀ {a : ℕ} {y : SimplexCategoryGenRel} {e₁ e₂ : mk a ⟶ y},
      P_σ e₁ → P_σ e₂ → a ≤ y.len → e₁ = e₂ := by
    intro a y e₁ e₂ h₁ h₂ ha
    obtain ⟨f₁, rfl⟩ | hlt₁ := eq_or_len_lt_of_P_σ h₁
    · obtain ⟨f₂, rfl⟩ | hlt₂ := eq_or_len_lt_of_P_σ h₂
      · rfl
      · rw [← f₁] at hlt₂; simp at hlt₂
    · simp only [mk_len] at hlt₁; omega
  intro a
  induction a with
  | zero => intro y e₁ e₂ h₁ h₂ _; exact base h₁ h₂ (Nat.zero_le _)
  | succ a ih =>
    intro y e₁ e₂ h₁ h₂ hmap
    by_cases hinj : Function.Injective (toSimplexCategory.map e₁).toOrderHom
    · have hcard := Fintype.card_le_of_injective _ hinj
      simp only [Fintype.card_fin] at hcard
      simp only [toSimplexCategory_len, mk_len] at hcard
      exact base h₁ h₂ (by omega)
    · obtain ⟨i, θ, hθ⟩ := SimplexCategory.eq_σ_comp_of_not_injective _ hinj
      have ht₁ : (toSimplexCategory.map
            (eqToHom (rfl : (mk (a + 1) : SimplexCategoryGenRel) = mk (a + 1)) ≫ e₁)).toOrderHom
            i.castSucc
          = (toSimplexCategory.map
            (eqToHom (rfl : (mk (a + 1) : SimplexCategoryGenRel) = mk (a + 1)) ≫ e₁)).toOrderHom
            i.succ := by
        rw [eqToHom_refl, Category.id_comp, hθ]
        exact (congrArg (⇑θ.toOrderHom) (Fin.predAbove_castSucc_self i)).trans
          (congrArg (⇑θ.toOrderHom) (Fin.predAbove_succ_self i)).symm
      have ht₂ : (toSimplexCategory.map
            (eqToHom (rfl : (mk (a + 1) : SimplexCategoryGenRel) = mk (a + 1)) ≫ e₂)).toOrderHom
            i.castSucc
          = (toSimplexCategory.map
            (eqToHom (rfl : (mk (a + 1) : SimplexCategoryGenRel) = mk (a + 1)) ≫ e₂)).toOrderHom
            i.succ := by simpa [← hmap] using ht₁
      obtain ⟨v₁, hv₁, f₁⟩ := exists_P_σ_eq_σ_comp h₁ rfl i ht₁
      obtain ⟨v₂, hv₂, f₂⟩ := exists_P_σ_eq_σ_comp h₂ rfl i ht₂
      rw [eqToHom_refl, Category.id_comp] at f₁ f₂
      have hs : toSimplexCategory.map (splitEpiσ i).section_ ≫
          toSimplexCategory.map (σ i) = 𝟙 _ := by
        rw [← Functor.map_comp, (splitEpiσ i).id, CategoryTheory.Functor.map_id]
      have hmapv : toSimplexCategory.map v₁ = toSimplexCategory.map v₂ := by
        have h' : toSimplexCategory.map (σ i) ≫ toSimplexCategory.map v₁ =
            toSimplexCategory.map (σ i) ≫ toSimplexCategory.map v₂ := by
          rw [← Functor.map_comp, ← Functor.map_comp, ← f₁, ← f₂, hmap]
        simpa only [← Category.assoc, hs, Category.id_comp] using
          toSimplexCategory.map (splitEpiσ i).section_ ≫= h'
      rw [f₁, f₂, ih hv₁ hv₂ hmapv]

/-! ### `toSimplexCategory` is an isomorphism of categories -/

/-- The two factors of an epi-mono factorization in `Δ` are determined by the morphism. -/
private lemma SimplexCategory.eq_of_epi_comp_mono {X Y Z₁ Z₂ : SimplexCategory}
    (e₁ : X ⟶ Z₁) (m₁ : Z₁ ⟶ Y) (e₂ : X ⟶ Z₂) (m₂ : Z₂ ⟶ Y) [Epi e₁] [Mono m₁] [Epi e₂]
    [Mono m₂] (h : e₁ ≫ m₁ = e₂ ≫ m₂) :
    ∃ hz : Z₁ = Z₂, e₁ ≫ eqToHom hz = e₂ ∧ eqToHom hz ≫ m₂ = m₁ := by
  have h₁ : Limits.image (e₁ ≫ m₁) = Z₁ := SimplexCategory.image_eq rfl
  have h₂ : Limits.image (e₁ ≫ m₁) = Z₂ := SimplexCategory.image_eq h.symm
  refine ⟨h₁.symm.trans h₂, ?_, ?_⟩
  · have hi₁ : Limits.factorThruImage (e₁ ≫ m₁) = e₁ ≫ eqToHom h₁.symm :=
      SimplexCategory.factorThruImage_eq (i := eqToHom h₁ ≫ m₁) (by simp)
    have hi₂ : Limits.factorThruImage (e₁ ≫ m₁) = e₂ ≫ eqToHom h₂.symm :=
      SimplexCategory.factorThruImage_eq (i := eqToHom h₂ ≫ m₂) (by simp [h])
    have hii := hi₁.symm.trans hi₂
    rw [← cancel_mono (eqToHom h₂ : Limits.image (e₁ ≫ m₁) ⟶ Z₂)] at hii
    simpa [eqToHom_trans] using hii
  · have hi₁ : Limits.image.ι (e₁ ≫ m₁) = eqToHom h₁ ≫ m₁ :=
      SimplexCategory.image_ι_eq (e := e₁ ≫ eqToHom h₁.symm) (by simp)
    have hi₂ : Limits.image.ι (e₁ ≫ m₁) = eqToHom h₂ ≫ m₂ :=
      SimplexCategory.image_ι_eq (e := e₂ ≫ eqToHom h₂.symm) (by simp [h])
    calc eqToHom (h₁.symm.trans h₂) ≫ m₂
        = eqToHom h₁.symm ≫ eqToHom h₂ ≫ m₂ := by rw [← Category.assoc, eqToHom_trans]
      _ = eqToHom h₁.symm ≫ eqToHom h₁ ≫ m₁ := by rw [← hi₂, hi₁]
      _ = m₁ := by rw [← Category.assoc, eqToHom_trans, eqToHom_refl, Category.id_comp]

/-- **`toSimplexCategory` is faithful.** A morphism of `SimplexCategoryGenRel` is determined
by its image in `Δ`. -/
public theorem toSimplexCategory_faithful : toSimplexCategory.Faithful where
  map_injective := by
    intro x y f g h
    induction x using SimplexCategoryGenRel.rec with | _ a
    induction y using SimplexCategoryGenRel.rec with | _ b
    obtain ⟨z₁, e₁, m₁, he₁, hm₁, hf⟩ := exists_P_σ_P_δ_factorization f
    obtain ⟨z₂, e₂, m₂, he₂, hm₂, hg⟩ := exists_P_σ_P_δ_factorization g
    have := isSplitEpi_toSimplexCategory_map_of_P_σ he₁
    have := isSplitEpi_toSimplexCategory_map_of_P_σ he₂
    have := isSplitMono_toSimplexCategory_map_of_P_δ hm₁
    have := isSplitMono_toSimplexCategory_map_of_P_δ hm₂
    have hcomp : toSimplexCategory.map e₁ ≫ toSimplexCategory.map m₁ =
        toSimplexCategory.map e₂ ≫ toSimplexCategory.map m₂ := by
      rw [← Functor.map_comp, ← Functor.map_comp, ← hf, ← hg, h]
    obtain ⟨hz, hfac, hm⟩ := SimplexCategory.eq_of_epi_comp_mono _ _ _ _ hcomp
    obtain rfl : z₁ = z₂ := by
      apply SimplexCategoryGenRel.ext
      simpa using congrArg SimplexCategory.len hz
    simp only [eqToHom_refl, Category.comp_id, Category.id_comp] at hfac hm
    rw [hf, hg, eq_of_P_σ_of_map_eq _ he₁ he₂ hfac, eq_of_P_δ_of_map_eq _ hm₁ hm₂ hm.symm]

/-- **`toSimplexCategory` is full.** Every morphism of `Δ` is a composite of faces and
degeneracies. -/
public theorem toSimplexCategory_full : toSimplexCategory.Full where
  map_surjective := by
    intro x y f
    let W : MorphismProperty SimplexCategory := fun X Y φ =>
      ∃ g : mk X.len ⟶ mk Y.len, toSimplexCategory.map g = φ
    have hmul : W.IsMultiplicative :=
      { id_mem := fun X => ⟨𝟙 _, by simp⟩
        comp_mem := by
          rintro X Y Z φ ψ ⟨g₁, rfl⟩ ⟨g₂, rfl⟩
          exact ⟨g₁ ≫ g₂, CategoryTheory.Functor.map_comp _ _ _⟩ }
    have hW : W = ⊤ := SimplexCategory.morphismProperty_eq_top W
      (fun {n} i => ⟨SimplexCategoryGenRel.δ i, rfl⟩)
      (fun {n} i => ⟨SimplexCategoryGenRel.σ i, rfl⟩)
    exact (show W f by rw [hW]; trivial)

/-- `toSimplexCategory` is bijective on objects: both categories have one object of each
length. -/
public theorem toSimplexCategory_bijective_obj : Function.Bijective toSimplexCategory.obj :=
  ⟨fun _ _ h => SimplexCategoryGenRel.ext (by simpa using congrArg SimplexCategory.len h),
    fun Y => ⟨mk Y.len, rfl⟩⟩

/-- **Stacks 0168**.
The category `Δ` is presented by the face and degeneracy generators and the simplicial
relations: the canonical functor from the category defined by those generators and relations is
full and faithful and is bijective on objects. Thus every morphism is generated by faces and
degeneracies, and every equality between such composites follows from the defining relations. -/
@[stacks 0168]
public theorem toSimplexCategory_full_faithful_bijective_obj :
    toSimplexCategory.Full ∧ toSimplexCategory.Faithful ∧
      Function.Bijective toSimplexCategory.obj :=
  ⟨toSimplexCategory_full, toSimplexCategory_faithful, toSimplexCategory_bijective_obj⟩

/-- `toSimplexCategory.op` is bijective on objects. -/
public theorem toSimplexCategory_op_bijective_obj :
    Function.Bijective toSimplexCategory.op.obj := by
  refine ⟨fun _ _ h => Opposite.unop_injective (toSimplexCategory_bijective_obj.1 ?_), fun Y => ?_⟩
  · simpa using congrArg Opposite.unop h
  · obtain ⟨x, hx⟩ := toSimplexCategory_bijective_obj.2 Y.unop
    exact ⟨op x, by simp [Functor.op_obj, hx]⟩

/-! ### The inverse functor -/

/-- Faithfulness in the form used below: two morphisms of `SimplexCategoryGenRel` with the same
image in `Δ` are equal. -/
private lemma faithful {x y : SimplexCategoryGenRel} (f g : x ⟶ y)
    (h : toSimplexCategory.map f = toSimplexCategory.map g) : f = g :=
  toSimplexCategory_faithful.map_injective h

/-- Fullness in the form used below: every morphism of `Δ` is the image of a morphism of
`SimplexCategoryGenRel`. -/
private lemma exists_map_eq {x y : SimplexCategory} (φ : x ⟶ y) :
    ∃ u : mk x.len ⟶ mk y.len, toSimplexCategory.map u = φ :=
  have := toSimplexCategory_full
  toSimplexCategory.map_surjective (X := mk x.len) (Y := mk y.len) φ

/-- A choice of preimage of a morphism of `Δ` under `toSimplexCategory`. -/
private noncomputable def liftHom {x y : SimplexCategory} (φ : x ⟶ y) :
    mk x.len ⟶ mk y.len :=
  (exists_map_eq φ).choose

private lemma liftHom_spec {x y : SimplexCategory} (φ : x ⟶ y) :
    toSimplexCategory.map (liftHom φ) = φ :=
  (exists_map_eq φ).choose_spec

private lemma liftHom_map {x y : SimplexCategoryGenRel} (u : x ⟶ y) :
    liftHom (toSimplexCategory.map u) = u :=
  faithful _ _ (liftHom_spec _)

/-- The inverse of `SimplexCategoryGenRel.toSimplexCategory`: it sends an object `x` of `Δ` to
`mk x.len` and a morphism to its preimage under fullness. -/
public noncomputable def toSimplexCategoryInv : SimplexCategory ⥤ SimplexCategoryGenRel where
  obj x := mk x.len
  map φ := liftHom φ
  map_id x := faithful _ _ (by rw [liftHom_spec]; simp)
  map_comp f g := faithful _ _ (by rw [liftHom_spec]; simp [liftHom_spec])

/-- `toSimplexCategoryInv` is a right inverse of `toSimplexCategory`, on the nose. -/
public theorem toSimplexCategoryInv_comp_toSimplexCategory :
    toSimplexCategoryInv ⋙ toSimplexCategory = 𝟭 SimplexCategory :=
  CategoryTheory.Functor.hext (fun _ => rfl)
    (fun x y φ => heq_of_eq (by simpa [toSimplexCategoryInv] using liftHom_spec φ))

/-- `toSimplexCategoryInv` is a left inverse of `toSimplexCategory`, on the nose. -/
public theorem toSimplexCategory_comp_toSimplexCategoryInv :
    toSimplexCategory ⋙ toSimplexCategoryInv = 𝟭 SimplexCategoryGenRel :=
  CategoryTheory.Functor.hext (fun _ => rfl)
    (fun x y φ => heq_of_eq (by simpa [toSimplexCategoryInv] using liftHom_map φ))

end SimplexCategoryGenRel
