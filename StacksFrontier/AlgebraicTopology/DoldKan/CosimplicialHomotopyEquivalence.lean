module

public import StacksFrontier.AlgebraicTopology.DoldKan.Cosimplicial
public import StacksFrontier.AlgebraicTopology.SimplicialObject.Homotopy.Cosimplicial
import StacksCore.Tactic.StacksAttribute

/-!
# Homotopy equivalences of cosimplicial objects and their cochain complexes

Let `a : U ⟶ V` be a homotopy equivalence of cosimplicial objects of an additive category `A`.
Then the map `s(a) : s(U) ⟶ s(V)` of Moore cochain complexes is a homotopy equivalence of cochain
complexes, and when `A` is abelian so is the map `Q(a) : Q(U) ⟶ Q(V)` of normalized cochain
complexes.

The normalized cochain complex `Q` of [Stacks, Tag 019I] is characterised here by the projection
`π : s ⟶ Q`: an isomorphism in degree `0` and, in degree `n + 1`, a cokernel of the cofaces
`δ i : Uₙ ⟶ Uₙ₊₁`, `i ≤ n`. These conditions determine `Q` up to unique isomorphism under `s`, and
the statement holds for every such `Q`; one exists by [Stacks, Tag 019I].

## Main results

* `AlgebraicTopology.homotopyEquivalences_moore_and_normalizedCochainComplex_map`

## References

* [Stacks, Tag 0FKK](https://stacks.math.columbia.edu/tag/0FKK)
* [Stacks, Tag 019I](https://stacks.math.columbia.edu/tag/019I)
* [Stacks, Tag 01A0](https://stacks.math.columbia.edu/tag/01A0)
-/

open CategoryTheory CategoryTheory.Limits Opposite Simplicial SSet

universe v u

namespace AlgebraicTopology

section

variable {A : Type u} [Category.{v} A] [Abelian A]

/-- Any normalized cochain complex functor `Q`, given with its projection `π : s ⟶ Q` which is an
isomorphism in degree `0` and a cokernel of the cofaces `δ i`, `i ≤ n`, in degree `n + 1`, has
each `π.app U` a homotopy equivalence of cochain complexes. -/
private theorem homotopyEquivalences_app_of_isCokernel
    (Q : CosimplicialObject A ⥤ CochainComplex A ℕ) (π : alternatingCofaceMapComplex A ⟶ Q)
    (h₀ : ∀ U : CosimplicialObject A, IsIso ((π.app U).f 0))
    (hc : ∀ (U : CosimplicialObject A) (n : ℕ),
      ∃ e : cokernel (Sigma.desc (f := fun _ : Fin (n + 1) => U.obj ⦋n⦌)
          fun i => U.δ i.castSucc) ≅ (Q.obj U).X (n + 1),
        cokernel.π _ ≫ e.hom = (π.app U).f (n + 1))
    (U : CosimplicialObject A) :
    HomologicalComplex.homotopyEquivalences A (ComplexShape.up ℕ) (π.app U) := by
  obtain ⟨Q₀, π₀, h₀₀, hc₀, hπ₀⟩ := exists_normalizedCochainComplex_homotopyEquivalences A
  have key : ∀ k : ℕ, ∃ e : (Q₀.obj U).X k ≅ (Q.obj U).X k,
      (π₀.app U).f k ≫ e.hom = (π.app U).f k ∧ Epi ((π₀.app U).f k) := by
    intro k
    cases k with
    | zero =>
      have := h₀₀ U
      have := h₀ U
      exact ⟨(asIso ((π₀.app U).f 0)).symm ≪≫ asIso ((π.app U).f 0), by simp, inferInstance⟩
    | succ n =>
      obtain ⟨e₀, he₀⟩ := hc₀ U n
      obtain ⟨e, he⟩ := hc U n
      refine ⟨e₀.symm ≪≫ e, ?_, ?_⟩
      · have h₁ : (π₀.app U).f (n + 1) ≫ e₀.inv = cokernel.π _ :=
          (Iso.comp_inv_eq e₀).mpr he₀.symm
        exact (Category.assoc _ _ _).symm.trans ((congrArg (· ≫ e.hom) h₁).trans he)
      · have : Epi (cokernel.π _ ≫ e₀.hom) := epi_comp _ _
        exact he₀ ▸ this
  choose e he hepi using key
  let φ : Q₀.obj U ≅ Q.obj U := HomologicalComplex.Hom.isoOfComponents e (fun i j _ => by
    have := hepi i
    rw [← cancel_epi ((π₀.app U).f i)]
    calc (π₀.app U).f i ≫ (e i).hom ≫ (Q.obj U).d i j = (π.app U).f i ≫ (Q.obj U).d i j := by
          rw [← Category.assoc, he i]
      _ = ((alternatingCofaceMapComplex A).obj U).d i j ≫ (π.app U).f j := (π.app U).comm i j
      _ = ((alternatingCofaceMapComplex A).obj U).d i j ≫ (π₀.app U).f j ≫ (e j).hom := by
          rw [he j]
      _ = ((π₀.app U).f i ≫ (Q₀.obj U).d i j) ≫ (e j).hom := by
          rw [← Category.assoc, ← (π₀.app U).comm i j]
      _ = (π₀.app U).f i ≫ (Q₀.obj U).d i j ≫ (e j).hom := Category.assoc _ _ _)
  have hφ : π.app U = π₀.app U ≫ φ.hom := by
    ext k
    simp [φ, he]
  obtain ⟨E, hE⟩ := hπ₀ U
  rw [hφ, ← hE]
  exact ⟨E.trans (HomotopyEquiv.ofIso φ), rfl⟩

end

/-- **Stacks 0FKK**.
Homotopy equivalences of cosimplicial objects induce homotopy equivalences of cochain complexes.
Let `a : U ⟶ V` be a homotopy equivalence of cosimplicial objects of `A`: there is `b : V ⟶ U`
such that `a ≫ b` is homotopic to `𝟙 U` and `b ≫ a` is homotopic to `𝟙 V`, where two morphisms
`f`, `g` of cosimplicial objects are *homotopic* when they are related by the equivalence relation
generated by the existence of a homotopy from one to the other, a homotopy being a family of
morphisms `h_{n, α}` indexed by the simplices `α ∈ Δ[1]ₙ` with
`h_{m, α} ∘ U(u) = V(u) ∘ h_{n, α ∘ u}` for every morphism `u : ⦋n⦌ ⟶ ⦋m⦌` of `Δ`, whose
components at the constant maps `⦋n⦌ ⟶ ⦋1⦌` with values `0` and `1` are `f_n` and `g_n`
([Stacks, Tag 0FKJ]).
1. If `A` is preadditive, then `s(a) : s(U) ⟶ s(V)` is a homotopy equivalence of Moore cochain
  complexes.
2. If `A` is abelian, then `Q(a) : Q(U) ⟶ Q(V)` is a homotopy equivalence of normalized cochain
  complexes, for any normalized cochain complex functor `Q` with projection `π : s ⟶ Q`, which is
  an isomorphism in degree `0` and a cokernel of the cofaces `δ i : Uₙ ⟶ Uₙ₊₁`, `i ≤ n`, in degree
  `n + 1` ([Stacks, Tag 019I]). -/
@[stacks 0FKK "the source's additive `A` is generalized to preadditive in the assertion for \
  `s`, which is all `s` uses. Being a homotopy equivalence of cochain complexes is \
  `HomologicalComplex.homotopyEquivalences`, which pins the map. A homotopy equivalence of \
  cosimplicial objects is spelled out (the source defines it by duality with 019N): a homotopy \
  is its family of components as in 0FKJ and 07KB, which needs no products in `A`, and being \
  homotopic is `Relation.EqvGen` of the existence of such a family, the spelling of 01A0. The \
  normalized cochain complex `Q` is any functor with a projection `π : s ⟶ Q` that is an \
  isomorphism in degree 0 and the cokernel of the cofaces `δ_i`, `i < n`, in degree `n`, the \
  description of 019I, which provides one; the differential of `Q` is then the one induced by \
  `(-1)^{n+1} δ_{n+1}`"]
public theorem homotopyEquivalences_moore_and_normalizedCochainComplex_map :
    (∀ (A : Type u) [Category.{v} A] [Preadditive A] (U V : CosimplicialObject A) (a : U ⟶ V),
      (∃ b : V ⟶ U,
        Relation.EqvGen (fun f₁ f₂ : U ⟶ U => ∃ h : ∀ n : SimplexCategory,
            (Δ[1] : SSet.{0}).obj (op n) → (U.obj n ⟶ U.obj n),
          (∀ ⦃n m : SimplexCategory⦄ (u : n ⟶ m) (α : (Δ[1] : SSet.{0}).obj (op m)),
              U.map u ≫ h m α = h n ((Δ[1] : SSet.{0}).map u.op α) ≫ U.map u) ∧
            (∀ n : SimplexCategory, h n (stdSimplex.const 1 0 (op n)) = f₁.app n) ∧
            (∀ n : SimplexCategory, h n (stdSimplex.const 1 1 (op n)) = f₂.app n))
          (a ≫ b) (𝟙 U) ∧
        Relation.EqvGen (fun f₁ f₂ : V ⟶ V => ∃ h : ∀ n : SimplexCategory,
            (Δ[1] : SSet.{0}).obj (op n) → (V.obj n ⟶ V.obj n),
          (∀ ⦃n m : SimplexCategory⦄ (u : n ⟶ m) (α : (Δ[1] : SSet.{0}).obj (op m)),
              V.map u ≫ h m α = h n ((Δ[1] : SSet.{0}).map u.op α) ≫ V.map u) ∧
            (∀ n : SimplexCategory, h n (stdSimplex.const 1 0 (op n)) = f₁.app n) ∧
            (∀ n : SimplexCategory, h n (stdSimplex.const 1 1 (op n)) = f₂.app n))
          (b ≫ a) (𝟙 V)) →
      HomologicalComplex.homotopyEquivalences A (ComplexShape.up ℕ)
        ((alternatingCofaceMapComplex A).map a)) ∧
    (∀ (A : Type u) [Category.{v} A] [Abelian A]
      (Q : CosimplicialObject A ⥤ CochainComplex A ℕ) (π : alternatingCofaceMapComplex A ⟶ Q),
      (∀ U : CosimplicialObject A, IsIso ((π.app U).f 0)) →
      (∀ (U : CosimplicialObject A) (n : ℕ),
        ∃ e : cokernel (Sigma.desc (f := fun _ : Fin (n + 1) => U.obj ⦋n⦌)
            fun i => U.δ i.castSucc) ≅ (Q.obj U).X (n + 1),
          cokernel.π _ ≫ e.hom = (π.app U).f (n + 1)) →
      ∀ (U V : CosimplicialObject A) (a : U ⟶ V),
      (∃ b : V ⟶ U,
        Relation.EqvGen (fun f₁ f₂ : U ⟶ U => ∃ h : ∀ n : SimplexCategory,
            (Δ[1] : SSet.{0}).obj (op n) → (U.obj n ⟶ U.obj n),
          (∀ ⦃n m : SimplexCategory⦄ (u : n ⟶ m) (α : (Δ[1] : SSet.{0}).obj (op m)),
              U.map u ≫ h m α = h n ((Δ[1] : SSet.{0}).map u.op α) ≫ U.map u) ∧
            (∀ n : SimplexCategory, h n (stdSimplex.const 1 0 (op n)) = f₁.app n) ∧
            (∀ n : SimplexCategory, h n (stdSimplex.const 1 1 (op n)) = f₂.app n))
          (a ≫ b) (𝟙 U) ∧
        Relation.EqvGen (fun f₁ f₂ : V ⟶ V => ∃ h : ∀ n : SimplexCategory,
            (Δ[1] : SSet.{0}).obj (op n) → (V.obj n ⟶ V.obj n),
          (∀ ⦃n m : SimplexCategory⦄ (u : n ⟶ m) (α : (Δ[1] : SSet.{0}).obj (op m)),
              V.map u ≫ h m α = h n ((Δ[1] : SSet.{0}).map u.op α) ≫ V.map u) ∧
            (∀ n : SimplexCategory, h n (stdSimplex.const 1 0 (op n)) = f₁.app n) ∧
            (∀ n : SimplexCategory, h n (stdSimplex.const 1 1 (op n)) = f₂.app n))
          (b ≫ a) (𝟙 V)) →
      HomologicalComplex.homotopyEquivalences A (ComplexShape.up ℕ) (Q.map a)) := by
  refine ⟨fun A _ _ U V a ha => homotopyEquivalences_alternatingCofaceMapComplex_map ha,
    fun A _ _ Q π h₀ hc U V a ha => ?_⟩
  refine MorphismProperty.of_precomp (W := HomologicalComplex.homotopyEquivalences A _) _
    (Q.map a) (homotopyEquivalences_app_of_isCokernel Q π h₀ hc U) ?_
  rw [← π.naturality a]
  exact MorphismProperty.comp_mem _ _ _ (homotopyEquivalences_alternatingCofaceMapComplex_map ha)
    (homotopyEquivalences_app_of_isCokernel Q π h₀ hc V)

end AlgebraicTopology
