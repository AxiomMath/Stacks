namespace AlgebraicTopology

section MooreComplexExact

open CategoryTheory Limits Opposite

/-- The Moore complex functor preserves the kernel of a morphism of simplicial objects. -/
private lemma alternatingFaceMapComplex_preservesLimit_parallelPair {C : Type u}
    [Category.{v} C] [Preadditive C] [HasKernels C] {U V : SimplicialObject C} (f : U ⟶ V) :
    PreservesLimit (parallelPair f 0) (alternatingFaceMapComplex C) where
  preserves {_} hc := ⟨HomologicalComplex.isLimitOfEval _ _ fun n =>
    ((evaluation_preservesLimit_of_hasKernel_app f
      (op (SimplexCategory.mk n))).preserves hc).some⟩

/-- The Moore complex functor preserves the cokernel of a morphism of simplicial objects. -/
private lemma alternatingFaceMapComplex_preservesColimit_parallelPair {C : Type u}
    [Category.{v} C] [Preadditive C] [HasCokernels C] {U V : SimplicialObject C} (f : U ⟶ V) :
    PreservesColimit (parallelPair f 0) (alternatingFaceMapComplex C) where
  preserves {_} hc := ⟨HomologicalComplex.isColimitOfEval _ _ fun n =>
    ((evaluation_preservesColimit_of_hasCokernel_app f
      (op (SimplexCategory.mk n))).preserves hc).some⟩

section

variable (C : Type u) [Category.{v} C] [Preadditive C] [HasKernels C] [HasCokernels C]

/-- **Stacks 0195**.
The Moore complex functor `s : Simp(C) ⥤ Ch_{≥0}(C)`, sending a simplicial object `U` of a
preadditive category `C` to the chain complex `U₀ ← U₁ ← U₂ ← …` with differentials the alternating
sums of the face maps, is exact: it preserves kernels and cokernels. -/
@[stacks 0195]
public instance alternatingFaceMapComplex_preservesHomology :
    (alternatingFaceMapComplex C).PreservesHomology :=
  { preservesKernels := fun {_ _} f => alternatingFaceMapComplex_preservesLimit_parallelPair f
    preservesCokernels := fun {_ _} f =>
      alternatingFaceMapComplex_preservesColimit_parallelPair f }

end

end MooreComplexExact

end AlgebraicTopology

namespace AlgebraicTopology.DoldKan

section EilenbergMacLaneHomology

open CategoryTheory Limits HomologicalComplex _root_.AlgebraicTopology

open scoped _root_.DoldKan

section TwoTerm

variable {C : Type u} [Category.{v} C] [Preadditive C] [HasZeroObject C]
  {ι : Type*} {c : ComplexShape ι}

/-- A complex is exact at `i` when the differential `K.d i j` out of `i` is a monomorphism and the
differential into `i` vanishes. -/
private lemma exactAt_of_mono_d (K : HomologicalComplex C c) {i j : ι} (hij : c.Rel i j)
    (h : K.d (c.prev i) i = 0) [Mono (K.d i j)] [K.HasHomology i] : K.ExactAt i :=
  (K.exactAt_iff' _ i j rfl (c.next_eq' hij)).mpr
    ((ShortComplex.exact_iff_mono _ h).mpr ‹Mono (K.d i j)›)

/-- A complex is exact at `j` when the differential `K.d i j` into `j` is an epimorphism and the
differential out of `j` vanishes. -/
private lemma exactAt_of_epi_d (K : HomologicalComplex C c) {i j : ι} (hij : c.Rel i j)
    (h : K.d j (c.next j) = 0) [Epi (K.d i j)] [K.HasHomology j] : K.ExactAt j :=
  (K.exactAt_iff' i j _ (c.prev_eq' hij) rfl).mpr
    ((ShortComplex.exact_iff_epi _ h).mpr ‹Epi (K.d i j)›)

variable {X₀ X₁ : C} (f : X₀ ⟶ X₁) {i₀ i₁ : ι}

/-- The differential `i₀ ⟶ i₁` of the two-term complex `double f hi₀₁` is a monomorphism when `f`
is. -/
private lemma mono_double_d [Mono f] (hi₀₁ : c.Rel i₀ i₁) (hne : i₀ ≠ i₁) :
    Mono ((double f hi₀₁).d i₀ i₁) := by
  rw [double_d f hi₀₁ hne]
  infer_instance

/-- The differential `i₀ ⟶ i₁` of the two-term complex `double f hi₀₁` is an epimorphism when `f`
is. -/
private lemma epi_double_d [Epi f] (hi₀₁ : c.Rel i₀ i₁) (hne : i₀ ≠ i₁) :
    Epi ((double f hi₀₁).d i₀ i₁) := by
  rw [double_d f hi₀₁ hne]
  infer_instance

/-- A two-term complex on a morphism which is both a monomorphism and an epimorphism, in particular
on an isomorphism, is acyclic. -/
private lemma acyclic_double [CategoryWithHomology C] [Mono f] [Epi f] (hi₀₁ : c.Rel i₀ i₁)
    (hne : i₀ ≠ i₁) : (double f hi₀₁).Acyclic := by
  have := mono_double_d f hi₀₁ hne
  have := epi_double_d f hi₀₁ hne
  intro i
  obtain rfl | h₀ := eq_or_ne i i₀
  · exact exactAt_of_mono_d _ hi₀₁ (double_d_eq_zero₁ f hi₀₁ _ _ hne)
  obtain rfl | h₁ := eq_or_ne i i₁
  · exact exactAt_of_epi_d _ hi₀₁ (double_d_eq_zero₀ f hi₀₁ _ _ h₀)
  exact .of_isZero (isZero_double_X f hi₀₁ i h₀ h₁)

end TwoTerm

section Gamma

variable {C : Type u} [Category.{v} C] [Preadditive C] [HasFiniteCoproducts C]

/-- The Moore complex of `Γ₀ L`, for `Γ₀` the inverse of the Dold-Kan equivalence, is homotopy
equivalent to `L`. -/
private noncomputable def homotopyEquivAlternatingFaceMapComplexΓ₀ (L : ChainComplex C ℕ) :
    HomotopyEquiv K[Γ₀.obj L] L :=
  (Γ₀.splitting L).homotopyEquivNondegComplex.trans (.ofIso (Γ₀NondegComplexIso L))

/-- If a chain complex `L` is acyclic, then so is the Moore complex of the split simplicial object
`Γ₀ L` it corresponds to under the inverse of the Dold-Kan equivalence. -/
private lemma acyclic_alternatingFaceMapComplex_Γ₀ [CategoryWithHomology C]
    {L : ChainComplex C ℕ} (hL : L.Acyclic) : K[Γ₀.obj L].Acyclic := fun i =>
  (exactAt_iff_of_quasiIsoAt (homotopyEquivAlternatingFaceMapComplexΓ₀ L).hom i).mpr (hL i)

end Gamma

section Statements

variable {C : Type u} [Category.{v} C] [Preadditive C] [HasFiniteCoproducts C]
  [HasZeroObject C] [CategoryWithHomology C]

/-- The Moore complex of `Γ₀ L`, for `Γ₀` the inverse of the Dold-Kan equivalence and `L` the
two-term chain complex `A --𝟙--> A` in degrees `k + 1` and `k`, is acyclic. This is a Dold-Kan
counterpart of [Stacks, Tag 0196]; the statement of that tag, about the explicit simplicial object
`E` of [Stacks, Tag 0192], is `AlgebraicTopology.acyclic_alternatingFaceMapComplex_emEobj`. -/
public theorem acyclic_alternatingFaceMapComplex_Γ₀_double (A : C) (k : ℕ) :
    K[Γ₀.obj (HomologicalComplex.double (𝟙 A)
      (show (ComplexShape.down ℕ).Rel (k + 1) k by simp))].Acyclic :=
  acyclic_alternatingFaceMapComplex_Γ₀ (acyclic_double (𝟙 A) _ (Nat.succ_ne_self k))

/-- The Moore complex of `Γ₀.obj L`, for `L` the chain complex `A` concentrated in degree `k` and
`Γ₀` the inverse of the Dold-Kan equivalence, of an object `A` of an additive category with
homology, has homology `A` in degree `k` and zero homology in every other degree. For an abelian
category, `Γ₀.obj L` is isomorphic to the Eilenberg-MacLane object `K(A, k) = i_{k!}U` by
`AlgebraicTopology.eilenbergMacLaneIsoΓ₀Single`, and [Stacks, Tag 0197] for `K(A, k)` itself is
`AlgebraicTopology.homology_alternatingFaceMapComplex_eilenbergMacLane`, both in
`StacksFrontier.AlgebraicTopology.MooreComplexEilenbergMacLane`. -/
public theorem homology_alternatingFaceMapComplex_Γ₀_single (A : C) (k : ℕ) :
    IsIsomorphic
        (K[Γ₀.obj ((HomologicalComplex.single C (ComplexShape.down ℕ) k).obj A)].homology k) A ∧
      ∀ i ≠ k, IsZero
        (K[Γ₀.obj ((HomologicalComplex.single C (ComplexShape.down ℕ) k).obj A)].homology i) := by
  rw [IsIsomorphic]
  refine ⟨⟨((Γ₀.splitting _).homotopyEquivNondegComplex.toHomologyIso k).trans
      ((HomologicalComplex.homologyMapIso (Γ₀NondegComplexIso _) k).trans
        (HomologicalComplex.singleObjHomologySelfIso _ k A))⟩, fun i hi => ?_⟩
  exact ((HomologicalComplex.isZero_single_obj_homology _ _ _ _ hi).of_iso
    (HomologicalComplex.homologyMapIso (Γ₀NondegComplexIso _) i)).of_iso
    ((Γ₀.splitting _).homotopyEquivNondegComplex.toHomologyIso i)

end Statements

end EilenbergMacLaneHomology

end AlgebraicTopology.DoldKan

namespace AlgebraicTopology

section EilenbergMacLaneAcyclic

open CategoryTheory Limits Opposite Simplicial CategoryTheory.SimplicialObject.EilenbergMacLane

/-- The map `α' : ⦋n + 1⦌ ⟶ ⦋k + 1⦌` extending `α : ⦋n⦌ ⟶ ⦋k + 1⦌` by `α'(n + 1) = k + 1`. -/
private def extendTop {n k : ℕ} (α : ⦋n⦌ ⟶ ⦋k + 1⦌) : ⦋n + 1⦌ ⟶ ⦋k + 1⦌ :=
  SimplexCategory.Hom.mk
    { toFun := fun i => if h : (i : ℕ) < n + 1 then α.toOrderHom ⟨i, h⟩ else Fin.last (k + 1)
      monotone' := by
        intro i j hij
        dsimp only
        split_ifs with hi hj hj
        · exact α.toOrderHom.monotone (Fin.mk_le_mk.mpr hij)
        · exact Fin.le_last _
        · exact absurd (lt_of_le_of_lt (Fin.le_def.mp hij) hj) hi
        · exact le_rfl }

/-- The values of `extendTop α`. -/
private lemma extendTop_apply {n k : ℕ} (α : ⦋n⦌ ⟶ ⦋k + 1⦌) (i : Fin (n + 2)) :
    (extendTop α).toOrderHom i =
      if h : (i : ℕ) < n + 1 then α.toOrderHom ⟨i, h⟩ else Fin.last (k + 1) :=
  rfl

/-- The image of `α'` is that of `α` together with `k + 1`, so `α'` attains every value `≤ k`
exactly when `α` does. -/
private lemma coversBelow_extendTop_iff {n k : ℕ} (α : ⦋n⦌ ⟶ ⦋k + 1⦌) :
    coversBelow k (extendTop α) ↔ coversBelow k α := by
  simp only [coversBelow, imageFinset, Finset.mem_image, Finset.mem_univ, true_and]
  refine ⟨fun h i hi => ?_, fun h i hi => ?_⟩
  · obtain ⟨x, hx⟩ := h i hi
    rw [extendTop_apply] at hx
    split_ifs at hx with hxn
    · exact ⟨_, hx⟩
    · subst hx
      simp at hi
  · obtain ⟨x, hx⟩ := h i hi
    refine ⟨x.castSucc, ?_⟩
    rw [extendTop_apply, dite_eq_left (by simpa using x.isLt)]
    exact hx

/-- The value of `p.succAbove i`. -/
private lemma val_succAbove {n : ℕ} (p : Fin (n + 1)) (i : Fin n) :
    ((p.succAbove i : Fin (n + 1)) : ℕ) = if (i : ℕ) < p then (i : ℕ) else i + 1 := by
  unfold Fin.succAbove
  split_ifs with h₁ h₂ h₂ <;> simp_all [Fin.lt_def]

/-- The face map `δ p` acts as `p.succAbove`. -/
private lemma δ_apply {n : ℕ} (p : Fin (n + 2)) (i : Fin (n + 1)) :
    (SimplexCategory.δ p).toOrderHom i = p.succAbove i := rfl

/-- `α' ∘ δ_{n + 1} = α`. -/
private lemma δ_last_comp_extendTop {n k : ℕ} (α : ⦋n⦌ ⟶ ⦋k + 1⦌) :
    SimplexCategory.δ (Fin.last (n + 1)) ≫ extendTop α = α := by
  ext i : 3
  rw [SimplexCategory.comp_toOrderHom, OrderHom.comp_coe, Function.comp_apply, δ_apply,
    Fin.succAbove_last, extendTop_apply, dite_eq_left (by simpa using i.isLt)]
  rfl

/-- `α' ∘ δ_j = (α ∘ δ_j)'` for `j ≤ n`. -/
private lemma δ_castSucc_comp_extendTop {m k : ℕ} (α : ⦋m + 1⦌ ⟶ ⦋k + 1⦌) (j : Fin (m + 2)) :
    SimplexCategory.δ j.castSucc ≫ extendTop α = extendTop (SimplexCategory.δ j ≫ α) := by
  ext i : 3
  simp only [SimplexCategory.comp_toOrderHom, OrderHom.comp_coe, Function.comp_apply,
    extendTop_apply, δ_apply]
  have hv := val_succAbove j.castSucc i
  have hlt : (i : ℕ) < m + 2 := i.isLt
  simp only [Fin.val_castSucc] at hv
  split_ifs with h₁ h₂ h₂
  · refine congrArg α.toOrderHom (Fin.ext ?_)
    rw [Fin.val_mk, hv, val_succAbove]
  · split_ifs at hv <;> omega
  · split_ifs at hv <;> omega
  · rfl

/-- For `α : [0] → [k + 1]` the composite `α' ∘ δ_0` is constant with value `k + 1`, so it misses
`0` and is not admissible. -/
private lemma not_coversBelow_δ_zero_comp_extendTop {k : ℕ} (α : ⦋0⦌ ⟶ ⦋k + 1⦌) :
    ¬ coversBelow k (SimplexCategory.δ 0 ≫ extendTop α) := by
  intro h
  obtain ⟨x, -, hx⟩ := Finset.mem_image.mp (h 0 (Nat.zero_le _))
  rw [SimplexCategory.comp_toOrderHom, OrderHom.comp_coe, Function.comp_apply, δ_apply,
    extendTop_apply, dite_eq_right (by simp)] at hx
  exact absurd (congrArg Fin.val hx) (by simp)


section Homotopy

variable {𝒜 : Type*} [Category 𝒜] [Abelian 𝒜] [HasFiniteBiproducts 𝒜] (A : 𝒜) (k : ℕ)

/-- The inclusion of the summand of `E_n` indexed by `β`, and zero when `β` is not admissible. -/
private noncomputable def summandι {n : ℕ} (β : ⦋n⦌ ⟶ ⦋k + 1⦌) : A ⟶ (emEobj A k).obj (op ⦋n⦌) :=
  if h : coversBelow k β then
    biproduct.ι (fun _ : {α : ⦋n⦌ ⟶ ⦋k + 1⦌ // coversBelow k α} => A) ⟨β, h⟩
  else 0

/-- `summandι` vanishes on a non-admissible index. -/
private lemma summandι_of_not {n : ℕ} {β : ⦋n⦌ ⟶ ⦋k + 1⦌} (h : ¬ coversBelow k β) :
    summandι A k β = 0 :=
  dite_eq_right h

/-- The structure map of `E` along `φ` sends the summand of `β` to the summand of `φ ≫ β`. -/
private lemma summandι_map {m n : ℕ} (β : ⦋n⦌ ⟶ ⦋k + 1⦌) (φ : ⦋m⦌ ⟶ ⦋n⦌) :
    summandι A k β ≫ (emEobj A k).map φ.op = summandι A k (φ ≫ β) := by
  by_cases hβ : coversBelow k β
  · rw [summandι, dite_eq_left hβ, emObject_map A _ _ (coversBelow_hP k) φ.op]
    refine biproduct.hom_ext _ _ fun b => ?_
    rw [Category.assoc, biproduct.matrix_π, biproduct.ι_desc]
    unfold summandι
    split_ifs with h₁ h₂ h₂
    · rw [biproduct.ι_π, dite_eq_left (Subtype.ext h₁.symm), eqToHom_refl]
    · exact absurd (h₁ ▸ b.2) h₂
    · rw [biproduct.ι_π_ne _ (fun e => h₁ (congrArg Subtype.val e).symm)]
    · rw [zero_comp]
  · rw [summandι_of_not A k hβ, zero_comp,
      summandι_of_not A k (fun h => hβ (coversBelow_of_precomp k φ β h))]

/-- Two morphisms out of `E_n` agree when they agree on every admissible summand. -/
private lemma ext_summand {n : ℕ} {Y : 𝒜} (f g : (emEobj A k).obj (op ⦋n⦌) ⟶ Y)
    (h : ∀ α : ⦋n⦌ ⟶ ⦋k + 1⦌, coversBelow k α → summandι A k α ≫ f = summandι A k α ≫ g) :
    f = g :=
  biproduct.hom_ext' _ _ fun α => by
    have := h α.1 α.2
    rwa [summandι, dite_eq_left α.2] at this

/-- A morphism `E_n ⟶ E_n` restricting to the inclusion on every admissible summand is the
identity. -/
private lemma ext_summand_id {n : ℕ}
    (f : (emEobj A k).obj (op ⦋n⦌) ⟶ (emEobj A k).obj (op ⦋n⦌))
    (h : ∀ α : ⦋n⦌ ⟶ ⦋k + 1⦌, coversBelow k α → summandι A k α ≫ f = summandι A k α) :
    f = 𝟙 _ :=
  ext_summand A k _ _ fun α hα => (h α hα).trans (Category.comp_id _).symm

/-- The map `h_n : E_n ⟶ E_{n + 1}` sending the summand of `α` to the summand of `α'`. -/
private noncomputable def extendTopHom (n : ℕ) :
    (emEobj A k).obj (op ⦋n⦌) ⟶ (emEobj A k).obj (op ⦋n + 1⦌) :=
  biproduct.desc fun α => summandι A k (extendTop α.1)

/-- `h_n` sends the summand of `β` to the summand of `β'`. -/
private lemma summandι_extendTopHom {n : ℕ} (β : ⦋n⦌ ⟶ ⦋k + 1⦌) :
    summandι A k β ≫ extendTopHom A k n = summandι A k (extendTop β) := by
  by_cases hβ : coversBelow k β
  · rw [summandι, dite_eq_left hβ, extendTopHom, biproduct.ι_desc]
  · rw [summandι_of_not A k hβ, zero_comp,
      summandι_of_not A k ((coversBelow_extendTop_iff β).not.mpr hβ)]

/-- The differential of `s(E)` on the summand of `β` is `∑ᵢ (-1)ⁱ` (summand of `β ∘ δᵢ`). -/
private lemma summandι_d {m : ℕ} (β : ⦋m + 1⦌ ⟶ ⦋k + 1⦌) :
    summandι A k β ≫ ((alternatingFaceMapComplex 𝒜).obj (emEobj A k)).d (m + 1) m =
      ∑ i : Fin (m + 2), (-1 : ℤ) ^ (i : ℕ) • summandι A k (SimplexCategory.δ i ≫ β) := by
  change summandι A k β ≫ (AlternatingFaceMapComplex.obj (emEobj A k)).d (m + 1) m = _
  rw [AlternatingFaceMapComplex.obj_d_eq, Preadditive.comp_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Preadditive.comp_zsmul]
  exact congrArg _ (summandι_map A k β _)

/-- The null-homotopy `(-1)^(n + 1) h_n`. -/
private noncomputable def homotopyHom : ∀ i j, (ComplexShape.down ℕ).Rel j i →
    (((alternatingFaceMapComplex 𝒜).obj (emEobj A k)).X i ⟶
      ((alternatingFaceMapComplex 𝒜).obj (emEobj A k)).X j) :=
  fun i _ hij => ((-1 : ℤ) ^ (i + 1)) • (extendTopHom A k i ≫
    eqToHom (congrArg ((alternatingFaceMapComplex 𝒜).obj (emEobj A k)).X hij))

/-- The null-homotopic map built from `(-1)^(n + 1) h_n` is the identity of `s(E)`. -/
private lemma nullHomotopicMap'_homotopyHom :
    Homotopy.nullHomotopicMap' (homotopyHom A k) = 𝟙 _ := by
  ext n : 1
  rcases n with _ | m
  · rw [Homotopy.nullHomotopicMap'_f_of_not_rel_left (show (ComplexShape.down ℕ).Rel 1 0 from rfl)
      (fun l hl => by simp at hl)]
    refine ext_summand A k _ _ fun α _ => ?_
    simp only [homotopyHom, eqToHom_refl, Category.comp_id, HomologicalComplex.id_f]
    rw [Preadditive.zsmul_comp, Preadditive.comp_zsmul, ← Category.assoc, summandι_extendTopHom,
      summandι_d, Fin.sum_univ_castSucc, Fin.sum_univ_one, Fin.castSucc_zero,
      summandι_of_not A k (not_coversBelow_δ_zero_comp_extendTop α), δ_last_comp_extendTop]
    simp
  · rw [Homotopy.nullHomotopicMap'_f (show (ComplexShape.down ℕ).Rel (m + 2) (m + 1) from rfl)
      (show (ComplexShape.down ℕ).Rel (m + 1) m from rfl)]
    refine ext_summand_id A k _ fun α _ => ?_
    simp only [homotopyHom, eqToHom_refl, Category.comp_id]
    simp only [Preadditive.comp_add, Preadditive.zsmul_comp, Preadditive.comp_zsmul,
      ← Category.assoc, summandι_d, Preadditive.sum_comp, summandι_extendTopHom]
    rw [Fin.sum_univ_castSucc (n := m + 2)]
    simp only [δ_last_comp_extendTop, δ_castSucc_comp_extendTop, Fin.val_castSucc, Fin.val_last]
    have e : ((-1 : ℤ)) ^ (m + 1 + 1) = -(-1) ^ (m + 1) := by rw [pow_succ, mul_neg_one]
    have e2 : ((-1 : ℤ)) ^ (m + 1 + 1) * (-1) ^ (m + 1 + 1) = 1 := by
      rw [← pow_add]; exact Even.neg_one_pow ⟨m + 1 + 1, rfl⟩
    rw [smul_add, smul_smul, e2, one_smul, e, neg_smul]
    abel

/-- **Stacks 0196**.
Let `𝒜` be an abelian category, let `A` be an object of `𝒜` and let `k ≥ 0` be an integer. The
Moore complex `s(E)` of the simplicial object `E = emEobj A k` of [Stacks, Tag 0192], whose
`n`-simplices are `⨁ A` over the monotone maps `α : [n] → [k + 1]` with image `[k]` or `[k + 1]`,
is acyclic. Following Stacks, the maps `h_n : E_n ⟶ E_{n + 1}` sending the summand of `α` to the
summand of its extension `α'` by `α'(n + 1) = k + 1` satisfy `d h_n - h_{n - 1} d = (-1)^(n + 1)`,
so `(-1)^(n + 1) h_n` is a null-homotopy of the identity of `s(E)`. -/
@[stacks 0196]
public theorem acyclic_alternatingFaceMapComplex_emEobj :
    ((alternatingFaceMapComplex 𝒜).obj (emEobj A k)).Acyclic := by
  have ho : Homotopy (𝟙 _) 0 :=
    (Homotopy.ofEq (nullHomotopicMap'_homotopyHom A k).symm).trans (Homotopy.nullHomotopy' _)
  intro i
  rw [HomologicalComplex.exactAt_iff_isZero_homology, IsZero.iff_id_eq_zero,
    ← HomologicalComplex.homologyMap_id, ho.homologyMap_eq, HomologicalComplex.homologyMap_zero]

end Homotopy

end EilenbergMacLaneAcyclic

end AlgebraicTopology

namespace AlgebraicTopology

section NormalizedEilenbergMacLane

open CategoryTheory CategoryTheory.Limits Opposite
open CategoryTheory.SimplicialObject AlgebraicTopology.NormalizedMooreComplex

open scoped Simplicial

/-- A homological complex `K` whose terms vanish in every degree other than `j`, and whose degree
`j` term is identified with `A` by `e`, is isomorphic to the complex `A` concentrated in degree
`j`. -/
private noncomputable def isoSingle {ι : Type*} [DecidableEq ι] {c : ComplexShape ι}
    {V : Type u'} [Category.{v'} V] [HasZeroMorphisms V] [HasZeroObject V]
    (K : HomologicalComplex V c) {j : ι} {A : V} (e : K.X j ≅ A) (hj : ¬ c.Rel j j)
    (h : ∀ i, i ≠ j → IsZero (K.X i)) :
    K ≅ (HomologicalComplex.single V c j).obj A :=
  HomologicalComplex.Hom.isoOfComponents
    (fun i => if hi : i = j then
        (K.XIsoOfEq hi).trans (e.trans (HomologicalComplex.singleObjXIsoOfEq c j A i hi).symm)
      else (h i hi).iso (HomologicalComplex.isZero_single_obj_X c j A i hi))
    (fun i i' hii' => by
      by_cases hi' : i' = j
      · subst hi'
        exact IsZero.eq_of_src (h i fun hij => hj (hij ▸ hii')) _ _
      · exact IsZero.eq_of_tgt (HomologicalComplex.isZero_single_obj_X c j A i' hi') _ _)

variable {C : Type u} [Category.{v} C] [Abelian C]

/-- The unit of the adjunction `i_{m!} ⊣ sk_m` of [Stacks, Tag 018N] identifies an `m`-truncated
simplicial object `U` with the truncation of its left Kan extension: `U_x ≅ (i_{m!}U)_x` for every
object `x` of the `m`-truncated simplex category. -/
private noncomputable def skObjIso {m : ℕ} (U : SimplicialObject.Truncated C m)
    (x : (SimplexCategory.Truncated m)ᵒᵖ) :
    U.obj x ≅ ((SimplicialObject.Truncated.sk m).obj U).obj (op x.unop.obj) :=
  ((asIso ((SimplicialObject.skAdj m).unit)).app U).app x

/-- The Eilenberg-MacLane object `K(A, k)` vanishes in degrees below `k`. -/
private lemma isZero_eilenbergMacLane_obj (A : C) {k i : ℕ} (h : i < k) :
    IsZero ((SimplicialObject.eilenbergMacLane A k).obj (op ⦋i⦌)) := by
  refine IsZero.of_iso ?_ (skObjIso _ (op (⟨⦋i⦌, h.le⟩ : SimplexCategory.Truncated k))).symm
  dsimp only
  rw [ite_eq_right (show ¬ (⦋i⦌ : SimplexCategory).len = k from h.ne)]
  exact isZero_zero C

/-- The degree `k` term of the Eilenberg-MacLane object `K(A, k)` is `A`. -/
private noncomputable def eilenbergMacLaneObjIso (A : C) (k : ℕ) :
    (SimplicialObject.eilenbergMacLane A k).obj (op ⦋k⦌) ≅ A :=
  (skObjIso _ (op (⟨⦋k⦌, le_rfl⟩ : SimplexCategory.Truncated k))).symm.trans
    (eqToIso (by dsimp only; rw [ite_eq_left (rfl : (⦋k⦌ : SimplexCategory).len = k)]))

/-- If `X_n` is a zero object, then the degree `n + 1` normalized Moore subobject of `X` is all of
`X_{n + 1}`. -/
private lemma objX_succ_eq_top_of_isZero (X : SimplicialObject C) {n : ℕ}
    (h : IsZero (X.obj (op ⦋n⦌))) : objX X (n + 1) = ⊤ := by
  rw [objX_add_one]
  refine le_antisymm le_top (Finset.le_inf fun i _ => ?_)
  rw [show X.δ i.succ = 0 from h.eq_of_tgt _ _, kernelSubobject_zero]

/-- **Stacks 0199**.
The normalized complex `N(K(A, k))` of the Eilenberg-MacLane object `K(A, k) = i_{k!}U` of an
object `A` of an abelian category is isomorphic to the chain complex `A` concentrated in degree
`k`; in particular `N(K(A, k))ᵢ` is `A` for `i = k` and `0` otherwise. -/
@[stacks 0199]
public theorem isIsomorphic_normalizedMooreComplex_eilenbergMacLane_single (A : C) (k : ℕ) :
    IsIsomorphic ((normalizedMooreComplex C).obj (SimplicialObject.eilenbergMacLane A k))
      ((HomologicalComplex.single C (ComplexShape.down ℕ) k).obj A) := by
  have htop : objX (SimplicialObject.eilenbergMacLane A k) k = ⊤ := by
    cases k with
    | zero => exact objX_zero _
    | succ m =>
      exact objX_succ_eq_top_of_isZero _ (isZero_eilenbergMacLane_obj A (Nat.lt_succ_self m))
  have hk : ((normalizedMooreComplex C).obj (SimplicialObject.eilenbergMacLane A k)).X k
      = ((⊤ : Subobject ((SimplicialObject.eilenbergMacLane A k).obj (op ⦋k⦌))) : C) :=
    congrArg (fun S : Subobject ((SimplicialObject.eilenbergMacLane A k).obj (op ⦋k⦌)) =>
      (S : C)) htop
  rw [IsIsomorphic]
  refine ⟨isoSingle _ (eqToIso hk ≪≫ asIso (⊤ : Subobject _).arrow ≪≫
    eilenbergMacLaneObjIso A k) (by simp) fun i hi => ?_⟩
  rw [normalizedMooreComplex_obj, NormalizedMooreComplex.obj_X]
  rcases lt_or_gt_of_ne hi with h | h
  · exact IsZero.of_mono (objX (SimplicialObject.eilenbergMacLane A k) i).arrow
      (isZero_eilenbergMacLane_obj A h)
  · rw [show objX (SimplicialObject.eilenbergMacLane A k) i = ⊥ from
      objX_sk_obj_eq_bot _ h]
    exact IsZero.of_iso (isZero_zero C) Subobject.botCoeIsoZero

end NormalizedEilenbergMacLane

section NormalizedIsSummand

open CategoryTheory CategoryTheory.Limits AlgebraicTopology.DoldKan Simplicial

/-- A retraction `r` of a morphism `f : X ⟶ Y` in a preadditive category presents `Y` as the
biproduct of `X` and the kernel of `r`, in such a way that `f` becomes the inclusion of the first
summand. -/
private theorem exists_iso_biprod_of_retraction {C : Type u₁} [Category.{v₁} C]
    [Preadditive C] [HasBinaryBiproducts C] {X Y : C} (f : X ⟶ Y) (r : Y ⟶ X) [HasKernel r]
    (hr : f ≫ r = 𝟙 X) :
    ∃ (D : C) (e : X ⊞ D ≅ Y), biprod.inl ≫ e.hom = f := by
  have := isIso_biprod_desc_kernel_ι f r hr
  exact ⟨kernel r, asIso (biprod.desc f (kernel.ι r)), by simp⟩

section

variable (A : Type u) [Category.{v} A] [Abelian A]

/-- **Stacks 019A**.
Let `A` be an abelian category. The canonical morphism of chain complexes `N(U) ⟶ s(U)` from the
normalized complex of a simplicial object `U` of `A` to its Moore complex is split, functorially in
`U`: there are a functor `D` from simplicial objects of `A` to chain complexes, the degenerate
part, and a natural isomorphism `N ⊞ D ≅ s` which on the first summand is the canonical inclusion.
In other words `s(U) = N(U) ⊕ D(U)`, naturally in `U`. -/
@[stacks 019A]
public theorem exists_degenerateComplex :
    ∃ (D : SimplicialObject A ⥤ ChainComplex A ℕ)
      (e : normalizedMooreComplex A ⊞ D ≅ alternatingFaceMapComplex A),
      biprod.inl ≫ e.hom = inclusionOfMooreComplex A :=
  exists_iso_biprod_of_retraction _ (natTransPInftyToNormalizedMooreComplex A)
    (inclusionOfMooreComplex_comp_natTrans A)

end

end NormalizedIsSummand

section NormalizedExact

open CategoryTheory CategoryTheory.Limits

section Retract

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]
  {J : Type w} [Category.{w'} J] {F G : C ⥤ D}

/-- A retract of functors is objectwise a retract. -/
@[reassoc]
private lemma i_app_comp_r_app (h : Retract F G) (X : C) :
    h.i.app X ≫ h.r.app X = 𝟙 (F.obj X) :=
  (h.map ((evaluation C D).obj X)).retract

/-- A retract of functors dualizes: `F.op` is a retract of `G.op`. -/
private def retractOp (h : Retract F G) : Retract F.op G.op :=
  h.op.map (Functor.opHom C D)

/-- A cone over `K ⋙ F` transported along the inclusion `h.i` to a cone over `K ⋙ G`. -/
private abbrev transportCone (h : Retract F G) (K : J ⥤ C) (t : Cone (K ⋙ F)) : Cone (K ⋙ G) :=
  (Cone.postcompose (Functor.whiskerLeft K h.i)).obj t

/-- Transporting along `h.i` detects factorizations through the image of a cone: for a retract
`h : Retract F G` of functors and a cone `c` over `K`, a morphism `m` factors the leg `j` of a cone
`t` over `K ⋙ F` through `F.mapCone c` if and only if `m ≫ h.i` factors the leg `j` of the
transported cone `transportCone h K t` through `G.mapCone c`. -/
private lemma comp_π_iff (h : Retract F G) {K : J ⥤ C} {c : Cone K} {t : Cone (K ⋙ F)}
    (m : t.pt ⟶ F.obj c.pt) (j : J) :
    m ≫ F.map (c.π.app j) = t.π.app j ↔
      (m ≫ h.i.app c.pt) ≫ G.map (c.π.app j) = t.π.app j ≫ h.i.app (K.obj j) := by
  have : IsSplitMono (h.i.app (K.obj j)) := IsSplitMono.mk' ⟨h.r.app _, i_app_comp_r_app h _⟩
  rw [Category.assoc, ← h.i.naturality, ← Category.assoc, cancel_mono]

/-- A retract of a functor preserving the limit of `K` preserves the limit of `K`. -/
private lemma preservesLimit_of_retract (h : Retract F G) (K : J ⥤ C) [PreservesLimit K G] :
    PreservesLimit K F where
  preserves {c} hc := by
    have hG := isLimitOfPreserves G hc
    have hfac : ∀ (t : Cone (K ⋙ F)) (j : J), hG.lift (transportCone h K t) ≫ G.map (c.π.app j) =
        t.π.app j ≫ h.i.app (K.obj j) := fun t j => by simpa using hG.fac (transportCone h K t) j
    refine ⟨{ lift := fun t => hG.lift (transportCone h K t) ≫ h.r.app c.pt
              fac := fun t j => (comp_π_iff h _ j).mpr ?_
              uniq := fun t m hm => ?_ }⟩
    · rw [Category.assoc, Category.assoc, ← h.i.naturality, ← h.r.naturality_assoc,
        ← Category.assoc, hfac t j, Category.assoc, i_app_comp_r_app_assoc]
    · have key : m ≫ h.i.app c.pt = hG.lift (transportCone h K t) :=
        hG.uniq (transportCone h K t) _ fun j => by
          simpa using (comp_π_iff h m j).mp (by simpa using hm j)
      rw [← key, Category.assoc, i_app_comp_r_app]
      exact (Category.comp_id m).symm

/-- A retract of a functor preserving finite limits preserves finite limits. -/
private lemma preservesFiniteLimits_of_retract (h : Retract F G)
    [PreservesFiniteLimits G] : PreservesFiniteLimits F :=
  ⟨fun _ _ _ => ⟨fun {K} => preservesLimit_of_retract h K⟩⟩

/-- A retract of a functor preserving finite colimits preserves finite colimits. -/
private lemma preservesFiniteColimits_of_retract (h : Retract F G)
    [PreservesFiniteColimits G] : PreservesFiniteColimits F :=
  have : PreservesFiniteLimits G.op := preservesFiniteLimits_op G
  have : PreservesFiniteLimits F.op := preservesFiniteLimits_of_retract (retractOp h)
  preservesFiniteColimits_of_op F

end Retract

section

variable (C : Type u) [Category.{v} C] [Abelian C]

/-- **Stacks 019B**.
The normalized complex functor `N : Simp(C) ⥤ Ch_{≥0}(C)` of an abelian category `C` is exact, i.e.
it preserves finite limits and finite colimits. -/
@[stacks 019B]
public theorem exactFunctor_normalizedMooreComplex :
    exactFunctor (SimplicialObject C) (ChainComplex C ℕ) (normalizedMooreComplex C) := by
  obtain ⟨D, e, -⟩ := exists_degenerateComplex C
  have hr : Retract (normalizedMooreComplex C) (alternatingFaceMapComplex C) :=
    { i := biprod.inl ≫ e.hom
      r := e.inv ≫ biprod.fst
      retract := by simp }
  have : PreservesFiniteLimits (alternatingFaceMapComplex C) :=
    Functor.preservesFiniteLimits_of_preservesHomology _
  have : PreservesFiniteColimits (alternatingFaceMapComplex C) :=
    Functor.preservesFiniteColimits_of_preservesHomology _
  exact (exactFunctor_iff _).mpr
    ⟨preservesFiniteLimits_of_retract hr, preservesFiniteColimits_of_retract hr⟩

end

end NormalizedExact

end AlgebraicTopology

