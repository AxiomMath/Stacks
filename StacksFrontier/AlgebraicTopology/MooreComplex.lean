/-!
# Moore complexes of simplicial objects in abelian categories

The Moore complex `s(U)` and the normalized complex `N(U)` of a simplicial object `U` of an abelian
category: `N(U)` is a functorial direct summand of `s(U)` whose complement is generated by the
degeneracies, both functors are exact, and the Moore and normalized complexes of the
Eilenberg–MacLane objects are computed.
-/

/-!
## The degenerate part of the Moore complex is generated by the degeneracies

Let `A` be an abelian category and let `U` be a simplicial object of `A`. By [Stacks, Tag 019A]
the canonical inclusion of the normalized complex is split functorially, `s(U) = N(U) ⊕ D(U)`,
where `s = alternatingFaceMapComplex A` is the Moore complex and `N = normalizedMooreComplex A`.
The complement `D(U)` constructed there is a subcomplex of `s(U)` whose term in degree `n` is the
image of `⊕_{φ : ⦋n⦌ ↠ ⦋m⦌, m < n} N(U_m) ⟶ U_n`; the assertion recorded here is that the
subobjects `N(U_m)` may be dropped from that formula, so that
`D(U)_n = Im(⊕_{φ : ⦋n⦌ ↠ ⦋m⦌, m < n} U_m ⟶ U_n)`: the degenerate part is the sum of the images of
*all* the operators `U(φ)` coming from surjections `φ : ⦋n⦌ ↠ ⦋m⦌` with `m < n`, equivalently the
sum of the images of the `n` degeneracy operators `σ_i : U_{n - 1} ⟶ U_n`. For a simplicial abelian
group this says that `D(U)_n` consists exactly of the sums of degenerate `n`-simplices.

### Main results

* `AlgebraicTopology.exists_degenerateComplex_eq_sup_imageSubobject_σ`: the functorial splitting
  `s = N ⊞ D` of [Stacks, Tag 019A] can be chosen with the degenerate part described degreewise as
  the sum of the images of the degeneracy operators,
  `D(U)_{n + 1} = ⨆_{i ≤ n} Im(σ_i : U_n ⟶ U_{n + 1})`, and `D(U)_0 = 0`.

### References

* [Stacks, Tag 0FKI](https://stacks.math.columbia.edu/tag/0FKI)
-/

section

open CategoryTheory Limits Simplicial Opposite

universe v u v₁ u₁

namespace AlgebraicTopology

section Helpers

open AlgebraicTopology.DoldKan

section Image

variable {C : Type u₁} [Category.{v₁} C] {X Y Z : C}

/-- If a morphism factors through a subobject, then its image is contained in that subobject. -/
private lemma imageSubobject_le_of_factors (S : Subobject Y) (f : X ⟶ Y) [HasImage f]
    (h : S.Factors f) : imageSubobject f ≤ S :=
  imageSubobject_le f (S.factorThru f h) (S.factorThru_arrow f h)

variable [HasImages C]

/-- A morphism which factors through another one has the smaller image. -/
private lemma imageSubobject_le_of_comp_eq {a : X ⟶ Z} {b : Y ⟶ Z} (u : X ⟶ Y)
    (hu : u ≫ b = a) : imageSubobject a ≤ imageSubobject b :=
  hu ▸ imageSubobject_comp_le u b

/-- Two morphisms with the same codomain which factor through one another have the same image. -/
private lemma imageSubobject_eq_of_comp_eq {a : X ⟶ Z} {b : Y ⟶ Z} (u : X ⟶ Y) (v : Y ⟶ X)
    (hu : u ≫ b = a) (hv : v ≫ a = b) : imageSubobject a = imageSubobject b :=
  le_antisymm (imageSubobject_le_of_comp_eq u hu) (imageSubobject_le_of_comp_eq v hv)

end Image

section Sum

variable {C : Type u₁} [Category.{v₁} C] [Preadditive C] {X Y : C}

/-- A subobject through which every member of a finite family of morphisms factors is one through
which their sum factors. -/
private lemma factors_sum (S : Subobject Y) {ι : Type*} (s : Finset ι) (f : ι → (X ⟶ Y))
    (h : ∀ i ∈ s, S.Factors (f i)) : S.Factors (∑ i ∈ s, f i) := by
  classical
  induction s using Finset.induction with
  | empty => simpa using Subobject.factors_zero (P := S) (X := X)
  | @insert a s ha ih =>
      rw [Finset.sum_insert ha]
      exact Subobject.factors_add _ _ (h a (Finset.mem_insert_self a s))
        (ih fun i hi => h i (Finset.mem_insert_of_mem hi))

end Sum

section Retraction

variable {C : Type u₁} [Category.{v₁} C] [Preadditive C] {X Y : C} (f : X ⟶ Y) (r : Y ⟶ X)
  [HasKernel r] (hr : f ≫ r = 𝟙 X)

/-- The projection of `Y` onto the complement of a retract: for `r : Y ⟶ X` a retraction of
`f : X ⟶ Y`, the factorization of the idempotent `𝟙 Y - r ≫ f` through `Ker(r)`. -/
private noncomputable def kernelProjOfRetraction : Y ⟶ kernel r :=
  kernel.lift r (𝟙 Y - r ≫ f) (by simp [hr])

/-- The projection onto the complement, followed by the inclusion of `Ker(r)`, is the idempotent
`𝟙 Y - r ≫ f`. -/
@[local simp] private lemma kernelProjOfRetraction_comp_ι :
    kernelProjOfRetraction f r hr ≫ kernel.ι r = 𝟙 Y - r ≫ f :=
  kernel.lift_ι _ _ _

/-- The retract `X` is killed by the projection onto its complement. -/
@[local simp] private lemma comp_kernelProjOfRetraction :
    f ≫ kernelProjOfRetraction f r hr = 0 := by
  rw [← cancel_mono (kernel.ι r)]; simp [reassoc_of% hr]

/-- The complement is fixed by the idempotent `𝟙 Y - r ≫ f`. -/
@[local simp] private lemma kernel_ι_comp_sub :
    kernel.ι r ≫ (𝟙 Y - r ≫ f) = kernel.ι r := by
  simp [Preadditive.comp_sub]

/-- The projection onto the complement is the identity on the complement. -/
@[local simp] private lemma kernel_ι_comp_kernelProjOfRetraction :
    kernel.ι r ≫ kernelProjOfRetraction f r hr = 𝟙 (kernel r) := by
  rw [← cancel_mono (kernel.ι r)]; simp

include hr in
/-- **A retraction splits off a direct summand.** If `r : Y ⟶ X` is a retraction of `f : X ⟶ Y` in
a preadditive category, then `Y` is the biproduct of `X` and `Ker(r)`: the map `X ⊞ Ker(r) ⟶ Y`
which is `f` on the first summand and the inclusion of `Ker(r)` on the second is an
isomorphism. -/
private theorem isIso_biprod_desc_kernel_ι [HasBinaryBiproduct X (kernel r)] :
    IsIso (biprod.desc f (kernel.ι r)) :=
  ⟨biprod.lift r (kernelProjOfRetraction f r hr),
    biprod.hom_ext' _ _
      (biprod.hom_ext _ _ (by simp [hr]) (by simp))
      (biprod.hom_ext _ _ (by simp) (by simp)),
    by simp⟩

end Retraction

section Degeneracy

variable {C : Type u₁} [Category.{v₁} C] [Preadditive C]

/-- Each degeneracy is fixed by the projection `QInfty`. -/
private lemma σ_comp_QInfty (X : SimplicialObject C) {n : ℕ} (i : Fin (n + 1)) :
    X.σ i ≫ (QInfty (X := X)).f (n + 1) = X.σ i := by
  simp [QInfty, HomologicalComplex.sub_f_apply, σ_comp_PInfty]

end Degeneracy

section Degenerate

variable (A : Type u) [Category.{v} A] [Abelian A]

/-- The retraction of the canonical inclusion `N ⟶ s` of the normalized complex into the Moore
complex, as a morphism of functors: at a simplicial object `X` it is
`PInftyToNormalizedMooreComplex X`. -/
private noncomputable def natTransPInftyToNormalizedMooreComplex :
    alternatingFaceMapComplex A ⟶ normalizedMooreComplex A where
  app X := PInftyToNormalizedMooreComplex X
  naturality _ _ f := PInftyToNormalizedMooreComplex_naturality f

/-- `natTransPInftyToNormalizedMooreComplex A` is a retraction of the canonical inclusion
`N ⟶ s`. -/
private lemma inclusionOfMooreComplex_comp_natTrans :
    inclusionOfMooreComplex A ≫ natTransPInftyToNormalizedMooreComplex A = 𝟙 _ := by
  ext X : 2
  exact (splitMonoInclusionOfMooreComplexMap X).id

/-- The complementary idempotent of the natural retraction is `QInfty` in every degree. -/
private lemma natTrans_sub_app_f (U : SimplicialObject A) (n : ℕ) :
    ((𝟙 (alternatingFaceMapComplex A) - natTransPInftyToNormalizedMooreComplex A ≫
      inclusionOfMooreComplex A).app U).f n = (QInfty (X := U)).f n := by
  have h : (natTransPInftyToNormalizedMooreComplex A ≫ inclusionOfMooreComplex A).app U
      = PInfty := by
    rw [NatTrans.comp_app, inclusionOfMooreComplex_app]
    exact PInftyToNormalizedMooreComplex_comp_inclusionOfMooreComplexMap U
  simp only [QInfty, NatTrans.app_sub, NatTrans.id_app, HomologicalComplex.sub_f_apply,
    HomologicalComplex.id_f, h]
  rfl

/-- Degreewise, the inclusion of the complement of `N` into the Moore complex is fixed by
`QInfty`. -/
private lemma kernel_ι_app_f_comp_QInfty_f (U : SimplicialObject A) (n : ℕ) :
    ((kernel.ι (natTransPInftyToNormalizedMooreComplex A)).app U).f n ≫ (QInfty (X := U)).f n
      = ((kernel.ι (natTransPInftyToNormalizedMooreComplex A)).app U).f n := by
  rw [← natTrans_sub_app_f A U n, ← HomologicalComplex.comp_f, ← NatTrans.comp_app,
    kernel_ι_comp_sub (inclusionOfMooreComplex A)]

/-- Degreewise, the complement of `N` in the Moore complex is the image of `QInfty`. -/
private lemma imageSubobject_kernel_ι_app_f (U : SimplicialObject A) (n : ℕ) :
    imageSubobject (((kernel.ι (natTransPInftyToNormalizedMooreComplex A)).app U).f n)
      = imageSubobject ((QInfty (X := U)).f n) :=
  imageSubobject_eq_of_comp_eq _
    (((kernelProjOfRetraction (inclusionOfMooreComplex A)
      (natTransPInftyToNormalizedMooreComplex A)
      (inclusionOfMooreComplex_comp_natTrans A)).app U).f n)
    (kernel_ι_app_f_comp_QInfty_f A U n)
    (by rw [← HomologicalComplex.comp_f, ← NatTrans.comp_app,
      kernelProjOfRetraction_comp_ι, natTrans_sub_app_f])

/-- The complement of `N` in the Moore complex vanishes in degree `0`. -/
private lemma isZero_kernel_obj_X_zero (U : SimplicialObject A) :
    IsZero (((kernel (natTransPInftyToNormalizedMooreComplex A)).obj U).X 0) := by
  refine (IsZero.iff_id_eq_zero _).mpr ?_
  have h0 : ((kernel.ι (natTransPInftyToNormalizedMooreComplex A)).app U).f 0 = 0 := by
    rw [← kernel_ι_app_f_comp_QInfty_f A U 0, QInfty_f_0, comp_zero]
  rw [← HomologicalComplex.id_f, ← NatTrans.id_app,
    ← kernel_ι_comp_kernelProjOfRetraction (inclusionOfMooreComplex A) _
      (inclusionOfMooreComplex_comp_natTrans A),
    NatTrans.comp_app, HomologicalComplex.comp_f, h0, zero_comp]

/-- **The degenerate part of the Moore complex.** The image of `QInfty` in degree `n + 1` is
the subobject of `U_{n + 1}` generated by the degenerate simplices, that is, the supremum of
the images of the degeneracy operators `σ_i : U_n ⟶ U_{n + 1}`. -/
private theorem imageSubobject_QInfty_f_succ (U : SimplicialObject A) (n : ℕ) :
    imageSubobject ((QInfty (X := U)).f (n + 1)) =
      Finset.univ.sup fun i : Fin (n + 1) => imageSubobject (U.σ i) := by
  refine le_antisymm ?_ (Finset.sup_le fun i _ =>
    imageSubobject_le_of_comp_eq _ (σ_comp_QInfty U i))
  refine imageSubobject_le_of_factors _ _ ?_
  rw [QInfty_f, decomposition_Q]
  refine factors_sum _ _ _ fun i _ => Subobject.finset_sup_factors ⟨i.rev, Finset.mem_univ _, ?_⟩
  rw [← Category.assoc]
  exact imageSubobject_factors_comp_self _ _

end Degenerate

end Helpers

variable (A : Type u) [Category.{v} A] [Abelian A]

/-- **Stacks 0FKI**.
Let `A` be an abelian category. The functorial splitting `s(U) = N(U) ⊕ D(U)` of the Moore complex
of a simplicial object `U` of `A` along its normalized subcomplex ([Stacks, Tag 019A]) can be
chosen so that the degenerate part is described degreewise as the subobject of `U_n` generated by
the degenerate simplices: `D(U)_0 = 0` and `D(U)_{n + 1}` is the supremum of the images of the
degeneracy operators `σ_i : U_n ⟶ U_{n + 1}`, `i = 0, …, n`. For a simplicial abelian group this
says that the elements of `D(U)_n` are exactly the sums of degenerate `n`-simplices. -/
@[stacks 0FKI]
public theorem exists_degenerateComplex_eq_sup_imageSubobject_σ :
    ∃ (D : SimplicialObject A ⥤ ChainComplex A ℕ)
      (e : normalizedMooreComplex A ⊞ D ≅ alternatingFaceMapComplex A),
      biprod.inl ≫ e.hom = inclusionOfMooreComplex A ∧
        ∀ U : SimplicialObject A,
          IsZero ((D.obj U).X 0) ∧
            ∀ n : ℕ, imageSubobject (((biprod.inr ≫ e.hom).app U).f (n + 1)) =
              Finset.univ.sup fun i : Fin (n + 1) => imageSubobject (U.σ i) := by
  have := isIso_biprod_desc_kernel_ι (inclusionOfMooreComplex A)
    (natTransPInftyToNormalizedMooreComplex A) (inclusionOfMooreComplex_comp_natTrans A)
  refine ⟨kernel (natTransPInftyToNormalizedMooreComplex A),
    asIso (biprod.desc (inclusionOfMooreComplex A)
      (kernel.ι (natTransPInftyToNormalizedMooreComplex A))), by simp,
    fun U => ⟨isZero_kernel_obj_X_zero A U, fun n => ?_⟩⟩
  simp only [asIso_hom, biprod.inr_desc]
  rw [imageSubobject_kernel_ι_app_f, imageSubobject_QInfty_f_succ]

end AlgebraicTopology

end

/-!
## Simplicial objects and chain complexes

Let `C` be a preadditive category. The *associated chain complex*, or *Moore complex*, of a
simplicial object `U` of `C` is `… → U₂ → U₁ → U₀ → 0 → …` with boundary maps `dₙ = ∑ᵢ (-1)ⁱ dⁿᵢ`;
it is Mathlib's `AlgebraicTopology.alternatingFaceMapComplex C`, the functor `s`, and it satisfies
`s(U)ₙ = Uₙ`. It is exact: it preserves kernels and cokernels, and hence, for an abelian `C`, all
finite limits and all finite colimits, so it carries a short exact sequence of simplicial objects
to a short exact sequence of chain complexes.

The *Eilenberg-MacLane object* `K(A, k)` of an object `A` and an integer `k ≥ 0` is the simplicial
object whose object of `n`-simplices is `⨁ A`, the sum being over the surjective monotone maps
`α : [n] → [k]`, and whose structural map along `φ : [m] → [n]` sends the summand indexed by `α` by
the identity of `A` to the summand indexed by `α ∘ φ` if `α ∘ φ` is again surjective, and to zero
otherwise. Its Moore complex `s(K(A, k))` has homology `A` in degree `k` and zero in all other
degrees. The simplicial object `E` of [Stacks, Tag 0192] sits in a termwise split short exact
sequence `0 → K(A, k) → E → K(A, k + 1) → 0`; its object of `n`-simplices is `⨁ A` over the
monotone maps `α : [n] → [k + 1]` whose image is `[k]` or `[k + 1]`, and its Moore complex `s(E)` is
acyclic, by an explicit null-homotopy of its identity. The same holds for `Γ₀ L`, for `L` the
two-term chain complex `A --𝟙--> A` in degrees `k + 1` and `k`.

The *normalized complex* `N(U)` is the subcomplex of `s(U)` obtained by intersecting the kernels of
all but one of the face maps in each degree, with differential the restriction of the remaining
face map; it is Mathlib's `AlgebraicTopology.normalizedMooreComplex`, and the inclusion
`N(U) ⟶ s(U)` of [Stacks, Tag 0198] is Mathlib's `AlgebraicTopology.inclusionOfMooreComplex`, a
monomorphism of complexes, natural in `U`. That canonical inclusion is split, functorially in `U`:
there are a functor `D`, the degenerate part, and a natural isomorphism `N ⊞ D ≅ s` whose
restriction to the first summand is the canonical inclusion, so `s(U) = N(U) ⊕ D(U)` naturally in
`U`. The functor `N` is exact as well, and for an abelian `C` the normalized complex of the
Eilenberg-MacLane object `K(A, k) = i_{k!}U`, the left Kan extension of the `k`-truncated object
concentrated in the top degree, has `A` in degree `k` and `0` in every other degree.

### Main results

* `AlgebraicTopology.alternatingFaceMapComplex_preservesHomology`: the Moore complex functor
  `s : Simp(C) ⥤ Ch_{≥0}(C)` is exact.
* `AlgebraicTopology.acyclic_alternatingFaceMapComplex_emEobj`: the Moore complex of the
  simplicial object `E` of [Stacks, Tag 0192] is acyclic.
* `AlgebraicTopology.DoldKan.acyclic_alternatingFaceMapComplex_Γ₀_double`: the Moore complex of
  `Γ₀` of the two-term complex `A --𝟙--> A` in degrees `k + 1` and `k` is acyclic.
* `AlgebraicTopology.DoldKan.homology_alternatingFaceMapComplex_Γ₀_single`: the Moore complex of
  `Γ₀` of the complex `A` concentrated in degree `k` has homology `A` in degree `k`, and zero
  homology in every other degree.
* `AlgebraicTopology.isIsomorphic_normalizedMooreComplex_eilenbergMacLane_single`: the normalized
  complex of the Eilenberg-MacLane object `K(A, k)` is isomorphic to the chain complex `A`
  concentrated in degree `k`.
* `AlgebraicTopology.exists_degenerateComplex`: the canonical morphism `N(U) ⟶ s(U)` is split,
  functorially in `U`, that is `s = N ⊕ D` in the functor category `Simp(A) ⥤ Ch_{≥0}(A)` for a
  functor `D`, compatibly with the canonical inclusion of `N`.
* `AlgebraicTopology.exactFunctor_normalizedMooreComplex`: the normalized complex functor
  `N : Simp(C) ⥤ Ch_{≥0}(C)` of an abelian category `C` is exact.

### References

* [Stacks, Tag 0195](https://stacks.math.columbia.edu/tag/0195)
* [Stacks, Tag 0196](https://stacks.math.columbia.edu/tag/0196)
* [Stacks, Tag 0197](https://stacks.math.columbia.edu/tag/0197)
* [Stacks, Tag 0199](https://stacks.math.columbia.edu/tag/0199)
* [Stacks, Tag 019A](https://stacks.math.columbia.edu/tag/019A)
* [Stacks, Tag 019B](https://stacks.math.columbia.edu/tag/019B)
* [Stacks, Tag 018N](https://stacks.math.columbia.edu/tag/018N)
* [Stacks, Tag 0192](https://stacks.math.columbia.edu/tag/0192)
* [Stacks, Tag 0198](https://stacks.math.columbia.edu/tag/0198)
-/

