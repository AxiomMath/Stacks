module

public import Mathlib.Algebra.Polynomial.Div
public import Mathlib.RingTheory.Polynomial.Ideal
public import StacksFrontier.CategoryTheory.Sites.Cohomology.ChaoticSite.SymmetricPowerDecalage
public import StacksFrontier.CategoryTheory.Sites.Cohomology.ChaoticSite.SymmetricPowerQuillenCoinvariants
public import StacksFrontier.Cotangent.SurjectionSiteConormal
public import StacksFrontier.Cotangent.SurjectionSiteExteriorConormal

/-!
# The intermediate step of Remark 08SG is false

Remark 08SG asserts `H_k(C, Sym^k_{B̲}(F)) = ∧^k_B(H_1(C, F))`, and that assertion is true over
every commutative ring:
`Stacks.ChaoticSite.nonempty_linearEquiv_leftDerivedColim_symmetricPowerDiagram` proves it by
décalage, and carries the tag. The remark reaches it instead through an intermediate step whose
verification it omits — that `H_k(C, Sym^k_{B̲}(F))` is the `S_k`-coinvariants of
`H_1(C, F)^{⊗ k}` for the permutation action multiplied by the sign character, written
`Stacks.ChaoticSite.QuillenSignedCoinvariants` — and this file shows that that step is false
over `ℤ`.

## Main results

* `Stacks.ChaoticSite.not_quillenSignedCoinvariants_int`:
  `¬ Stacks.ChaoticSite.QuillenSignedCoinvariants ℤ`.

## Implementation notes

The witness is the polynomial site of the surjection `ℤ[x] → ℤ`, `x ↦ 0`, at `k = 2`. For that
situation `H_1(C_{B/A}, Ω) = I/I²` with `I = (x)`, which is free of rank one over `ℤ`
(`Ideal.cotangentIntEquivKerEvalZero`), so the décalage identity gives
`H_2(C_{B/A}, Sym²(Ω)) = ∧²_ℤ ℤ = 0` while the sign-twisted coinvariants of `ℤ^{⊗ 2}` are
`ℤ/2 ≠ 0`. The two cannot be isomorphic, which is
`Stacks.SignedTensorPower.not_nonempty_linearEquiv_exteriorPower_two_of_equivInt`: over `ℤ`, a
module free of rank one has vanishing second exterior power — every wedge of two multiples of
one generator is zero — and nonvanishing sign-twisted second coinvariants, the class of
`g ⊗ g` being detected by `Stacks.SignedTensorPower.mk_tprod_one_ne_zero`.

The structural reason for the failure is that `S_k`-coinvariants is not an exact functor, so the
derived symmetric power is not the coinvariants of the derived tensor power; the correct
identification is Illusie's and Quillen's décalage `LSym^k(M[1]) = (∧^k M)[k]`, and the naive
coinvariants differ from it by the higher homology of `S_k`, which at `k = 2` is the `2`-torsion
above.

## References

* [Stacks Project, Tag 08SG](https://stacks.math.columbia.edu/tag/08SG)
* [Stacks Project, Tag 08RD](https://stacks.math.columbia.edu/tag/08RD)
* [Stacks Project, Tag 08RG](https://stacks.math.columbia.edu/tag/08RG)
-/

@[expose] public noncomputable section

open scoped TensorProduct

open CategoryTheory CategoryTheory.Limits

/-! ### A module free of rank one over `ℤ` separates the two sides -/

namespace Stacks.SignedTensorPower

/-- **The second exterior power of a module generated by one element vanishes**: the generators
`x ∧ y` of `∧²` are multiples of `g ∧ g = 0`. -/
public theorem exteriorPower_two_eq_zero_of_span_singleton
    {R : Type} [CommRing R] {M : Type} [AddCommGroup M] [Module R M] (g : M)
    (hgen : Submodule.span R ({g} : Set M) = ⊤) (y : ⋀[R]^2 M) : y = 0 := by
  have hdiag : exteriorPower.ιMulti R 2 (fun _ : Fin 2 => g) = 0 :=
    (exteriorPower.ιMulti R 2).map_eq_zero_of_eq (fun _ : Fin 2 => g) (i := 0) (j := 1) rfl
      (by decide)
  have hy : y ∈ Submodule.span R (Set.range (exteriorPower.ιMulti R 2 (M := M))) := by
    rw [exteriorPower.ιMulti_span]
    exact Submodule.mem_top
  induction hy using Submodule.span_induction with
  | mem z hz =>
      obtain ⟨v, rfl⟩ := hz
      have hmem : ∀ i : Fin 2, ∃ c : R, c • g = v i := fun i =>
        Submodule.mem_span_singleton.mp (by rw [hgen]; exact Submodule.mem_top)
      choose c hc using hmem
      have hv : v = fun i => c i • g := funext fun i => (hc i).symm
      have hsmul : exteriorPower.ιMulti R 2 (fun i => c i • g) =
          (∏ i, c i) • exteriorPower.ιMulti R 2 (fun _ : Fin 2 => g) :=
        (exteriorPower.ιMulti R 2).toMultilinearMap.map_smul_univ _ _
      rw [hv, hsmul, hdiag, smul_zero]
  | zero => rfl
  | add a b _ _ ha hb => rw [ha, hb, add_zero]
  | smul c a _ ha => rw [ha, smul_zero]

/-- **Over `ℤ`, the sign-twisted second coinvariants of a module free of rank one are not its
second exterior power.** The exterior power vanishes, because every wedge of two multiples of
the generator does; the coinvariants do not, the class of `g ⊗ g` being carried onto the
nonzero class of `1 ⊗ 1` of `Stacks.SignedTensorPower.mk_tprod_one_ne_zero`.

This is the failure of the intermediate step of Remark 08SG: that step identifies the two. -/
public theorem not_nonempty_linearEquiv_exteriorPower_two_of_equivInt
    {M : Type} [AddCommGroup M] [Module ℤ M] (ψ₀ : M ≃+ ℤ) :
    ¬ Nonempty (signedCoinvariants ℤ M 2 ≃ₗ[ℤ] ⋀[ℤ]^2 M) := by
  rintro ⟨e⟩
  set ψ : M ≃ₗ[ℤ] ℤ := ψ₀.toIntLinearEquiv
  have hgen : Submodule.span ℤ ({ψ.symm 1} : Set M) = ⊤ :=
    eq_top_iff.mpr fun y _ => Submodule.mem_span_singleton.mpr
      ⟨ψ y, by simpa using (ψ.symm.toLinearMap.map_smul (ψ y) (1 : ℤ)).symm⟩
  have hne : Representation.Coinvariants.mk (signedPermRep ℤ M 2)
      (⨂ₜ[ℤ] _ : Fin 2, ψ.symm 1) ≠ 0 := by
    intro h0
    have h1 := congrArg (signedCoinvariantsMap ℤ M 2 (ψ : M →ₗ[ℤ] ℤ)) h0
    rw [map_zero, signedCoinvariantsMap_mk_tprod] at h1
    exact mk_tprod_one_ne_zero (by simpa using h1)
  exact hne (e.injective ((exteriorPower_two_eq_zero_of_span_singleton _ hgen _).trans
    (map_zero e).symm))

end Stacks.SignedTensorPower

/-! ### The conormal module of `ℤ[x] → ℤ` -/

namespace Ideal

/-- `I = ker(ℤ[x] → ℤ)` is the principal ideal `(x)`. -/
public theorem ker_evalRingHom_zero_int :
    RingHom.ker (Polynomial.evalRingHom (0 : ℤ)) = Ideal.span {Polynomial.X} := by
  simpa using Polynomial.ker_evalRingHom (0 : ℤ)

/-- Membership in `I²` for `I = ker(ℤ[x] → ℤ)`: the first two coefficients vanish. -/
public theorem mem_sq_ker_evalRingHom_zero_int {p : Polynomial ℤ} :
    p ∈ RingHom.ker (Polynomial.evalRingHom (0 : ℤ)) ^ 2 ↔ ∀ d < 2, p.coeff d = 0 := by
  rw [ker_evalRingHom_zero_int, Ideal.span_singleton_pow, Ideal.mem_span_singleton,
    Polynomial.X_pow_dvd_iff]

/-- **`I/I² = ℤ` for `I = ker(ℤ[x] → ℤ)`**, the ideal `(x)` of polynomials vanishing at `0`: the
conormal module of the surjection `ℤ[x] → ℤ`, `x ↦ 0`, is free of rank one on the class of `x`,
and the coordinate is the coefficient of `x`. -/
public def cotangentIntEquivKerEvalZero :
    ℤ ≃+ (RingHom.ker (Polynomial.evalRingHom (0 : ℤ))).Cotangent :=
  AddEquiv.ofBijective
    (zmultiplesHom _ (Ideal.toCotangent (RingHom.ker (Polynomial.evalRingHom (0 : ℤ)))
      ⟨Polynomial.X, by simp [RingHom.mem_ker]⟩)) (by
    refine ⟨fun m n hmn => ?_, fun y => ?_⟩
    · have h0 : Ideal.toCotangent (RingHom.ker (Polynomial.evalRingHom (0 : ℤ)))
          ((m - n) • ⟨Polynomial.X, by simp [RingHom.mem_ker]⟩) = 0 := by
        rw [map_zsmul, sub_smul, ← zmultiplesHom_apply, ← zmultiplesHom_apply, hmn, sub_self]
      rw [Ideal.toCotangent_eq_zero] at h0
      have h1 : ∀ d < 2, ((m - n) • (Polynomial.X : Polynomial ℤ)).coeff d = 0 :=
        mem_sq_ker_evalRingHom_zero_int.mp (by simpa using h0)
      have h2 := h1 1 (by norm_num)
      simp only [Polynomial.coeff_smul, Polynomial.coeff_X_one, smul_eq_mul, mul_one] at h2
      exact sub_eq_zero.mp h2
    · obtain ⟨p, rfl⟩ := Ideal.toCotangent_surjective _ y
      have hp0 : (p : Polynomial ℤ).coeff 0 = 0 := by
        have hp := p.2
        rw [RingHom.mem_ker] at hp
        simpa [Polynomial.coeff_zero_eq_eval_zero] using hp
      refine ⟨(p : Polynomial ℤ).coeff 1, ?_⟩
      rw [zmultiplesHom_apply, ← map_zsmul, Ideal.toCotangent_eq]
      refine mem_sq_ker_evalRingHom_zero_int.mpr fun d hd => ?_
      interval_cases d <;> simp [hp0])

end Ideal

/-! ### The intermediate step of Remark 08SG is false over `ℤ` -/

namespace Stacks.ChaoticSite

/-- **The intermediate step of Remark 08SG is false over `ℤ`.** The remark deduces
`H_k(C, Sym^k_{B̲}(F)) = ∧^k_B(H_1(C, F))` from the claim that `H_k(C, Sym^k_{B̲}(F))` is the
`S_k`-coinvariants of `H_1(C, F)^{⊗ k}` for the permutation action multiplied by the sign
character — `Stacks.ChaoticSite.QuillenSignedCoinvariants` — and omits the verification. That
claim does not hold for the coefficient ring `ℤ`.

The witness is the polynomial site `C_{B/A}` of the surjection `A = ℤ[x] → B = ℤ`, `x ↦ 0`, with
coefficients in `Ω = Ω_{𝒪/A} ⊗_𝒪 B̲`, at `k = 2`: that is a situation of Tag 08RD, since `Ω` is
a flat `B̲`-module with `H_0(C_{B/A}, Ω) = 0`, and its first homology is the conormal module
`I/I² = ℤ` of `I = (x)`, free of rank one. The conclusion
`H_2(C_{B/A}, Sym²_{B̲}(Ω)) = ∧²_ℤ(I/I²) = 0` holds — it is
`Stacks.ChaoticSite.nonempty_linearEquiv_leftDerivedColim_symmetricPowerDiagram`, which carries
the tag — whereas the sign-twisted `S_2`-coinvariants of `(I/I²)^{⊗ 2}` are `ℤ/2`, by
`Stacks.SignedTensorPower.mk_tprod_one_ne_zero`. So the remark's conclusion is true and its
route to it is not; see
`Stacks.SignedTensorPower.not_nonempty_linearEquiv_exteriorPower_two_of_equivInt`. -/
public theorem not_quillenSignedCoinvariants_int : ¬ QuillenSignedCoinvariants ℤ := by
  intro hQ
  let : Algebra (Polynomial ℤ) ℤ := (Polynomial.evalRingHom (0 : ℤ)).toAlgebra
  let B : CommAlgCat.{0} (Polynomial ℤ) := CommAlgCat.of (Polynomial ℤ) ℤ
  have h : Function.Surjective (algebraMap (Polynomial ℤ) (B : Type)) := by
    intro n
    refine ⟨Polynomial.C n, ?_⟩
    change Polynomial.eval 0 (Polynomial.C n) = n
    simp
  obtain ⟨e₁⟩ := hQ
    (CommAlgCat.smallBoundedPolynomialSite (Polynomial ℤ) B
      (CommAlgCat.standardResolutionVarCardinal (Polynomial ℤ) B))
    (CommAlgCat.standardResolutionSmallCosimplicialObject (Polynomial ℤ) B)
    (CommAlgCat.isPointResolution_standardResolutionSmallCosimplicialObject (Polynomial ℤ) B)
    (CommAlgCat.smallPolynomialCotangentModulePresheaf (Polynomial ℤ) B
      (CommAlgCat.standardResolutionVarCardinal (Polynomial ℤ) B))
    (CommAlgCat.flat_smallPolynomialCotangentModulePresheaf_obj (Polynomial ℤ) B _)
    (CommAlgCat.isZero_leftDerivedColimZero_polynomialCotangentModulePresheaf_of_surjective
      (Polynomial ℤ) B h)
    2
  obtain ⟨e₂⟩ := nonempty_linearEquiv_leftDerivedColim_symmetricPowerDiagram
    (CommAlgCat.smallBoundedPolynomialSite (Polynomial ℤ) B
      (CommAlgCat.standardResolutionVarCardinal (Polynomial ℤ) B)) ℤ
    (CommAlgCat.standardResolutionSmallCosimplicialObject (Polynomial ℤ) B)
    (CommAlgCat.isPointResolution_standardResolutionSmallCosimplicialObject (Polynomial ℤ) B)
    (CommAlgCat.smallPolynomialCotangentModulePresheaf (Polynomial ℤ) B
      (CommAlgCat.standardResolutionVarCardinal (Polynomial ℤ) B))
    (CommAlgCat.flat_smallPolynomialCotangentModulePresheaf_obj (Polynomial ℤ) B _)
    (CommAlgCat.isZero_leftDerivedColimZero_polynomialCotangentModulePresheaf_of_surjective
      (Polynomial ℤ) B h)
    2
  refine SignedTensorPower.not_nonempty_linearEquiv_exteriorPower_two_of_equivInt
    ?_ ⟨e₁.trans e₂⟩
  have hcong := CommAlgCat.leftDerivedColimOneConormalLinearEquiv (Polynomial ℤ) B h
  have k₁ := AddEquiv.mk' (Equiv.ofBijective _ (EquivLike.bijective hcong))
    (fun x y => map_add hcong x y)
  have k₂ := k₁.trans (CommAlgCat.surjectionConormalAddEquiv (Polynomial ℤ) B h)
  exact k₂.trans Ideal.cotangentIntEquivKerEvalZero.symm

end Stacks.ChaoticSite

end
