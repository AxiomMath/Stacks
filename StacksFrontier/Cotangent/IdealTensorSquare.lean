module

public import Mathlib.LinearAlgebra.TensorProduct.Finiteness
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.Algebra.MvPolynomial.Rename

/-!
# The tensor square of an ideal

For an ideal `I` of a commutative ring `R` this file studies `I ⊗_R I`, its multiplication map
`I ⊗_R I → R`, and the submodule spanned by the antisymmetric tensors `a ⊗ b - b ⊗ a`. The kernel
of the multiplication map modulo the antisymmetric tensors is the part of `Tor₂^R(R/I, R/I)`
that survives in the second homology of the cotangent complex of `R/I`.

## Main definitions

* `Stacks.Cotangent.idealTensorMul`: the multiplication map `I ⊗_R I → R`.
* `Stacks.Cotangent.idealTensorAntisymm`: the submodule spanned by `a ⊗ b - b ⊗ a`.
* `Stacks.Cotangent.idealTensorMap`: the map `I ⊗_R I → I' ⊗_{R'} I'` induced by a ring map
  sending `I` into `I'`.

## Main results

* `Stacks.Cotangent.exists_eq_sum_trivial_of_sum_mul_X_eq_zero`: the first Koszul syzygies of a
  family of distinct variables of a polynomial ring are the trivial ones.
* `Stacks.Cotangent.idealTensorMap_sub_mem_antisymm`: two maps out of a polynomial ring which
  agree modulo an ideal `I'` induce, on the kernel of the multiplication map, maps
  `I ⊗ I → I' ⊗ I'` which agree modulo antisymmetric tensors.

## Implementation notes

The second result is reduced to a universal case: the polynomial ring on two copies of the
variables, where the differences `x_i - y_i` of the two copies are again a family of distinct
variables after a change of coordinates, so that their Koszul syzygies are trivial.
-/

@[expose] public section

open TensorProduct

universe u v w

namespace Stacks.Cotangent

/-! ### Koszul syzygies of variables -/

section Koszul

variable {R : Type u} [CommRing R] {σ : Type v} {ι : Type w}

/-- A polynomial `p` with `p * X k` in the ideal generated by the variables of a set `s` not
containing `k` lies in that ideal itself: `X k` is a nonzerodivisor modulo the other variables. -/
theorem mem_span_X_image_of_mul_X_mem {s : Set σ} {k : σ} (hk : k ∉ s)
    {p : MvPolynomial σ R}
    (hp : p * MvPolynomial.X k ∈ Ideal.span (MvPolynomial.X '' s : Set (MvPolynomial σ R))) :
    p ∈ Ideal.span (MvPolynomial.X '' s : Set (MvPolynomial σ R)) := by
  rw [MvPolynomial.mem_ideal_span_X_image] at hp ⊢
  intro m hm
  obtain ⟨i, hi, hne⟩ := hp (m + Finsupp.single k 1) (by
    rw [MvPolynomial.support_mul_X]
    exact Finset.mem_map_of_mem _ hm)
  refine ⟨i, hi, ?_⟩
  have hik : i ≠ k := fun h => hk (h ▸ hi)
  simpa [Finsupp.single_apply, hik.symm] using hne

/-- The trivial Koszul syzygy `X (j b) • e_a - X (j a) • e_b` of a family of variables. -/
noncomputable def koszulTrivial (j : ι → σ) (a b : ι) : ι →₀ MvPolynomial σ R :=
  Finsupp.single a (MvPolynomial.X (j b)) - Finsupp.single b (MvPolynomial.X (j a))

/-- The trivial Koszul syzygies are syzygies: `X (j b) X (j a) - X (j a) X (j b) = 0`. -/
theorem linearCombination_koszulTrivial (j : ι → σ) (a b : ι) :
    Finsupp.linearCombination (MvPolynomial σ R)
      (fun i => (MvPolynomial.X (j i) : MvPolynomial σ R))
      (koszulTrivial (R := R) j a b) = 0 := by
  simp [koszulTrivial, mul_comm]

/-- **The first Koszul syzygies of distinct variables are trivial.** If `j` is injective and
`∑ γ_i X_{j i} = 0` in `R[σ]`, then `γ` is a linear combination of the trivial syzygies
`X_{j b} e_a - X_{j a} e_b`. -/
theorem exists_eq_sum_trivial_of_sum_mul_X_eq_zero {j : ι → σ} (hj : Function.Injective j)
    (γ : ι →₀ MvPolynomial σ R)
    (hγ : Finsupp.linearCombination (MvPolynomial σ R)
      (fun i => (MvPolynomial.X (j i) : MvPolynomial σ R)) γ = 0) :
    γ ∈ Submodule.span (MvPolynomial σ R)
      (Set.range fun p : ι × ι => koszulTrivial (R := R) j p.1 p.2) := by
  classical
  set L := Finsupp.linearCombination (MvPolynomial σ R)
    (fun i => (MvPolynomial.X (j i) : MvPolynomial σ R))
  set S := Submodule.span (MvPolynomial σ R)
    (Set.range fun p : ι × ι => koszulTrivial (R := R) j p.1 p.2)
  suffices H : ∀ n : ℕ, ∀ γ : ι →₀ MvPolynomial σ R, γ.support.card ≤ n → L γ = 0 → γ ∈ S from
    H _ γ le_rfl hγ
  intro n
  induction n with
  | zero =>
    intro γ hn _
    rw [Nat.le_zero, Finset.card_eq_zero, Finsupp.support_eq_empty] at hn
    rw [hn]
    exact S.zero_mem
  | succ n ih =>
    intro γ hn hγ
    rcases γ.support.eq_empty_or_nonempty with he | ⟨i₀, hi₀⟩
    · rw [Finsupp.support_eq_empty] at he
      rw [he]
      exact S.zero_mem
    set F := γ.support.erase i₀ with hF
    have hsum : L γ = γ i₀ * MvPolynomial.X (j i₀) + ∑ i ∈ F, γ i * MvPolynomial.X (j i) := by
      rw [Finsupp.linearCombination_apply, Finsupp.sum, ← Finset.add_sum_erase _ _ hi₀]
      simp [smul_eq_mul, hF]
    have hmem : γ i₀ * MvPolynomial.X (j i₀) ∈
        Ideal.span (MvPolynomial.X '' (j '' (F : Set ι)) : Set (MvPolynomial σ R)) := by
      have : γ i₀ * MvPolynomial.X (j i₀) = -∑ i ∈ F, γ i * MvPolynomial.X (j i) := by
        rw [eq_neg_iff_add_eq_zero, ← hsum, hγ]
      rw [this]
      refine (Ideal.neg_mem_iff _).2 (Ideal.sum_mem _ fun i hi => Ideal.mul_mem_left _ _ ?_)
      exact Ideal.subset_span ⟨j i, ⟨i, hi, rfl⟩, rfl⟩
    have hk : j i₀ ∉ j '' (F : Set ι) := by
      rintro ⟨i, hi, he⟩
      rw [hj he] at hi
      exact Finset.notMem_erase i₀ γ.support hi
    have hγ₀ := mem_span_X_image_of_mul_X_mem hk hmem
    rw [Set.image_image, Ideal.span, Finsupp.mem_span_image_iff_linearCombination] at hγ₀
    obtain ⟨l, hl, hlγ⟩ := hγ₀
    have hl₀ : l i₀ = 0 := by
      by_contra h
      have := hl (Finsupp.mem_support_iff.2 h)
      simp [hF] at this
    let δ : ι →₀ MvPolynomial σ R := l.sum fun i c => c • koszulTrivial j i₀ i
    have hδS : δ ∈ S :=
      Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨(i₀, i), rfl⟩)
    have hLδ : L δ = 0 := by
      simp only [δ, Finsupp.sum, map_sum, map_smul, L, linearCombination_koszulTrivial,
        smul_zero, Finset.sum_const_zero]
    have hδapp : ∀ k, δ k = (if i₀ = k then L l else 0) - l k * MvPolynomial.X (j i₀) := by
      intro k
      have h1 : δ k = ∑ i ∈ l.support, (l i * (if i₀ = k then MvPolynomial.X (j i) else 0) -
          l i * (if i = k then MvPolynomial.X (j i₀) else 0)) := by
        simp only [δ, Finsupp.sum, Finsupp.finset_sum_apply, Finsupp.smul_apply, koszulTrivial,
          Finsupp.sub_apply, Finsupp.single_apply, smul_eq_mul, mul_sub]
      rw [h1, Finset.sum_sub_distrib]
      congr 1
      · split_ifs with hk
        · rw [Finsupp.linearCombination_apply, Finsupp.sum]
          simp [smul_eq_mul]
        · simp
      · simp only [mul_ite, mul_zero, Finset.sum_ite_eq', Finsupp.mem_support_iff]
        split_ifs with hk
        · rfl
        · rw [not_not.1 hk, zero_mul]
    have hγ' : (γ - δ).support ⊆ F := by
      intro k hk
      rw [Finsupp.mem_support_iff, Finsupp.sub_apply, hδapp] at hk
      rw [hF, Finset.mem_erase]
      by_cases hki : k = i₀
      · subst hki
        simp only [hl₀, zero_mul, sub_zero] at hk
        exact (hk (by rw [show L l = γ k from hlγ, if_pos trivial, sub_self])).elim
      · refine ⟨hki, ?_⟩
        by_cases hlk : l k = 0
        · rw [Finsupp.mem_support_iff]
          intro hzero
          simp [Ne.symm hki, hzero, hlk] at hk
        · exact Finset.mem_of_mem_erase (hl (Finsupp.mem_support_iff.2 hlk))
    have hcard : (γ - δ).support.card ≤ n := by
      have := Finset.card_le_card hγ'
      rw [hF, Finset.card_erase_of_mem hi₀] at this
      omega
    have hrest := ih (γ - δ) hcard (by rw [map_sub, hγ, hLδ, sub_self])
    simpa only [sub_add_cancel] using S.add_mem hrest hδS

/-- The Koszul lemma in the form of an explicit finite combination of trivial syzygies. -/
theorem exists_finsupp_trivial_of_sum_mul_X_eq_zero {j : ι → σ} (hj : Function.Injective j)
    (γ : ι →₀ MvPolynomial σ R)
    (hγ : Finsupp.linearCombination (MvPolynomial σ R)
      (fun i => (MvPolynomial.X (j i) : MvPolynomial σ R)) γ = 0) :
    ∃ c : ι × ι →₀ MvPolynomial σ R, (c.sum fun p a => a • koszulTrivial j p.1 p.2) = γ :=
  Finsupp.mem_span_range_iff_exists_finsupp.1 (exists_eq_sum_trivial_of_sum_mul_X_eq_zero hj γ hγ)

end Koszul

/-! ### The tensor square of an ideal -/

section TensorSquare

variable {R : Type u} [CommRing R] (I : Ideal R)

/-- The multiplication map `I ⊗_R I → R`. -/
noncomputable def idealTensorMul : I ⊗[R] I →ₗ[R] R :=
  TensorProduct.lift ((LinearMap.mul R R).compl₁₂ I.subtype I.subtype)

/-- The multiplication map sends `a ⊗ b` to `a * b`. -/
@[simp]
theorem idealTensorMul_tmul (a b : I) : idealTensorMul I (a ⊗ₜ b) = (a : R) * b := rfl

/-- The submodule of `I ⊗_R I` spanned by the antisymmetric tensors `a ⊗ b - b ⊗ a`. -/
def idealTensorAntisymm : Submodule R (I ⊗[R] I) :=
  Submodule.span R (Set.range fun p : I × I => p.1 ⊗ₜ[R] p.2 - p.2 ⊗ₜ[R] p.1)

/-- The tensor `a ⊗ b - b ⊗ a` lies in `idealTensorAntisymm I`. -/
theorem tmul_sub_tmul_mem_idealTensorAntisymm (a b : I) :
    a ⊗ₜ[R] b - b ⊗ₜ[R] a ∈ idealTensorAntisymm I :=
  Submodule.subset_span ⟨(a, b), rfl⟩

/-- Antisymmetric tensors lie in the kernel of multiplication. -/
theorem idealTensorMul_eq_zero_of_mem_antisymm {x : I ⊗[R] I}
    (hx : x ∈ idealTensorAntisymm I) : idealTensorMul I x = 0 := by
  refine Submodule.span_induction ?_ (by simp) (fun x y _ _ hx hy => by rw [map_add, hx, hy,
    add_zero]) (fun r x _ hx => by rw [map_smul, hx, smul_zero]) hx
  rintro _ ⟨⟨a, b⟩, rfl⟩
  simp [mul_comm]

variable {R' : Type v} [CommRing R'] {I} {I' : Ideal R'}

/-- The restriction `I → I'` of a ring map sending `I` into `I'`. -/
def idealRestrict (f : R →+* R') (h : ∀ a ∈ I, f a ∈ I') : I →+ I' where
  toFun a := ⟨f a, h a a.2⟩
  map_zero' := by ext; simp
  map_add' a b := by ext; simp

/-- The restriction `idealRestrict f h` sends `a` to `f a`. -/
@[simp]
theorem idealRestrict_apply_coe (f : R →+* R') (h : ∀ a ∈ I, f a ∈ I') (a : I) :
    (idealRestrict f h a : R') = f a := rfl

/-- The map `I ⊗_R I → I' ⊗_{R'} I'`, `a ⊗ b ↦ f a ⊗ f b`, induced by a ring map `f` sending
`I` into `I'`. -/
noncomputable def idealTensorMap (f : R →+* R') (h : ∀ a ∈ I, f a ∈ I') :
    I ⊗[R] I →+ I' ⊗[R'] I' :=
  TensorProduct.liftAddHom
    (AddMonoidHom.mk' (fun a => AddMonoidHom.mk'
        (fun b => idealRestrict f h a ⊗ₜ[R'] idealRestrict f h b)
        (fun b b' => by rw [map_add, tmul_add]))
      (fun a a' => by ext b; simp [add_tmul]))
    (fun r a b => by
      change idealRestrict f h (r • a) ⊗ₜ[R'] idealRestrict f h b =
        idealRestrict f h a ⊗ₜ[R'] idealRestrict f h (r • b)
      have hs : ∀ c : I, idealRestrict f h (r • c) = f r • idealRestrict f h c := fun c => by
        ext; simp [idealRestrict]
      rw [hs, hs, smul_tmul])

/-- The map `idealTensorMap f h` sends `a ⊗ b` to `f a ⊗ f b`. -/
@[simp]
theorem idealTensorMap_tmul (f : R →+* R') (h : ∀ a ∈ I, f a ∈ I') (a b : I) :
    idealTensorMap f h (a ⊗ₜ b) = idealRestrict f h a ⊗ₜ[R'] idealRestrict f h b := rfl

/-- The map `idealTensorMap f h` is semilinear along `f`: it sends `r • x` to `f r • x'`, where
`x'` is the image of `x`. -/
theorem idealTensorMap_smul (f : R →+* R') (h : ∀ a ∈ I, f a ∈ I') (r : R) (x : I ⊗[R] I) :
    idealTensorMap f h (r • x) = f r • idealTensorMap f h x := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul a b =>
    rw [smul_tmul', idealTensorMap_tmul, idealTensorMap_tmul, smul_tmul']
    congr 1
    ext
    simp [idealRestrict]
  | add x y hx hy => rw [smul_add, map_add, map_add, hx, hy, smul_add]

/-- The map `idealTensorMap f h` is compatible with the multiplication maps: multiplying the
image of `x` gives `f` applied to the product of `x`. -/
theorem idealTensorMul_idealTensorMap (f : R →+* R') (h : ∀ a ∈ I, f a ∈ I') (x : I ⊗[R] I) :
    idealTensorMul I' (idealTensorMap f h x) = f (idealTensorMul I x) := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul a b => simp [idealRestrict]
  | add x y hx hy => rw [map_add, map_add, hx, hy, map_add, map_add]

/-- The map `idealTensorMap f h` sends antisymmetric tensors to antisymmetric tensors. -/
theorem idealTensorMap_mem_antisymm (f : R →+* R') (h : ∀ a ∈ I, f a ∈ I') {x : I ⊗[R] I}
    (hx : x ∈ idealTensorAntisymm I) : idealTensorMap f h x ∈ idealTensorAntisymm I' := by
  refine Submodule.span_induction ?_ (by simp) (fun x y _ _ hx hy => by
    rw [map_add]; exact add_mem hx hy) (fun r x _ hx => by
    rw [idealTensorMap_smul]; exact Submodule.smul_mem _ _ hx) hx
  rintro _ ⟨⟨a, b⟩, rfl⟩
  rw [map_sub, idealTensorMap_tmul, idealTensorMap_tmul]
  exact tmul_sub_tmul_mem_idealTensorAntisymm I' _ _

/-- The map induced by a composite `g ∘ f` is the composite of the induced maps. -/
theorem idealTensorMap_comp {R'' : Type w} [CommRing R''] {I'' : Ideal R''}
    (f : R →+* R') (h : ∀ a ∈ I, f a ∈ I') (g : R' →+* R'') (h' : ∀ a ∈ I', g a ∈ I'')
    (x : I ⊗[R] I) :
    idealTensorMap g h' (idealTensorMap f h x) =
      idealTensorMap (g.comp f) (fun a ha => h' _ (h a ha)) x := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul a b => rfl
  | add x y hx hy => rw [map_add, map_add, hx, hy, map_add]

/-- The map induced by the identity is the identity. -/
theorem idealTensorMap_id (h : ∀ a ∈ I, (RingHom.id R) a ∈ I) (x : I ⊗[R] I) :
    idealTensorMap (RingHom.id R) h x = x := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul a b => rfl
  | add x y hx hy => rw [map_add, hx, hy]

end TensorSquare

/-! ### Two maps agreeing modulo an ideal -/

section Homotopy

variable {A : Type u} [CommRing A] {V : Type w}

open MvPolynomial

/-- The difference `x_i - y_i` of the two copies of the `i`-th variable in `A[X ⊔ X]`. -/
noncomputable def diagonalDifference (i : V) : MvPolynomial (V ⊕ V) A :=
  MvPolynomial.X (Sum.inl i) - MvPolynomial.X (Sum.inr i)

/-- The two copies `p(x)` and `p(y)` of a polynomial differ by an element of the ideal spanned
by the differences `x_i - y_i`. -/
theorem rename_inl_sub_rename_inr_mem (p : MvPolynomial V A) :
    rename Sum.inl p - rename Sum.inr p ∈
      Ideal.span (Set.range (diagonalDifference (A := A) (V := V))) := by
  induction p using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq => rw [map_add, map_add, add_sub_add_comm]; exact Ideal.add_mem _ hp hq
  | mul_X p i hp =>
    have : rename Sum.inl (p * X i) - rename Sum.inr (p * X i) =
        (rename Sum.inl p - rename Sum.inr p) * X (Sum.inl i) +
          rename Sum.inr p * diagonalDifference i := by
      simp only [map_mul, rename_X, diagonalDifference]; ring
    rw [this]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hp)
      (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩))

/-- The change of coordinates `x_i ↦ x_i - y_i`, `y_i ↦ y_i` of `A[X ⊔ X]`. -/
noncomputable def diagonalCoordinates : MvPolynomial (V ⊕ V) A ≃ₐ[A] MvPolynomial (V ⊕ V) A :=
  AlgEquiv.ofAlgHom
    (aeval (Sum.elim (fun i => diagonalDifference (A := A) i) (fun i => X (Sum.inr i))))
    (aeval (Sum.elim (fun i => X (Sum.inl i) + X (Sum.inr i)) (fun i => X (Sum.inr i))))
    (by ext (i | i) <;> simp [diagonalDifference])
    (by ext (i | i) <;> simp [diagonalDifference])

/-- The change of coordinates `diagonalCoordinates` sends `x_i` to `x_i - y_i`. -/
theorem diagonalCoordinates_X_inl (i : V) :
    diagonalCoordinates (A := A) (X (Sum.inl i)) = diagonalDifference i := by
  simp [diagonalCoordinates]

/-- The Koszul syzygies of the differences `x_i - y_i` are trivial. -/
theorem exists_finsupp_trivial_diagonalDifference (γ : V →₀ MvPolynomial (V ⊕ V) A)
    (hγ : Finsupp.linearCombination _ (diagonalDifference (A := A)) γ = 0) :
    ∃ c : V × V →₀ MvPolynomial (V ⊕ V) A, ∀ k, γ k =
      c.sum fun p a => a * ((Finsupp.single p.1 (diagonalDifference (A := A) p.2) -
        Finsupp.single p.2 (diagonalDifference p.1) : V →₀ MvPolynomial (V ⊕ V) A) k) := by
  classical
  let θ := diagonalCoordinates (A := A) (V := V)
  let γ' : V →₀ MvPolynomial (V ⊕ V) A := γ.mapRange θ.symm (map_zero _)
  have hγ' : Finsupp.linearCombination (MvPolynomial (V ⊕ V) A)
      (fun i => (MvPolynomial.X (Sum.inl i) : MvPolynomial (V ⊕ V) A)) γ' = 0 := by
    apply θ.injective
    rw [map_zero, Finsupp.linearCombination_apply, Finsupp.sum_mapRange_index (by simp),
      map_finsuppSum]
    rw [Finsupp.linearCombination_apply] at hγ
    rw [← hγ]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp [θ, smul_eq_mul, diagonalCoordinates_X_inl]
  obtain ⟨c, hc⟩ := exists_finsupp_trivial_of_sum_mul_X_eq_zero Sum.inl_injective γ' hγ'
  refine ⟨c.mapRange θ (map_zero _), fun k => ?_⟩
  have hk := congrArg (fun g => θ (g k)) hc
  simp only [γ', Finsupp.mapRange_apply, AlgEquiv.apply_symm_apply] at hk
  rw [← hk, Finsupp.sum_mapRange_index (by simp), Finsupp.sum, Finsupp.sum,
    Finsupp.finset_sum_apply, map_sum]
  refine Finset.sum_congr rfl fun p _ => ?_
  simp only [Finsupp.smul_apply, koszulTrivial, Finsupp.sub_apply, Finsupp.single_apply,
    smul_eq_mul, map_mul]
  split_ifs <;> simp [θ, diagonalCoordinates_X_inl]

/-- Equal ring maps induce equal maps `I ⊗ I → I'' ⊗ I''`. -/
theorem idealTensorMap_congr {R : Type*} [CommRing R] {I : Ideal R} {R'' : Type*}
    [CommRing R''] {I'' : Ideal R''} {f g : R →+* R''} (hfg : f = g)
    (hf : ∀ a ∈ I, f a ∈ I'') (hg : ∀ a ∈ I, g a ∈ I'') (x : I ⊗[R] I) :
    idealTensorMap f hf x = idealTensorMap g hg x := by
  subst hfg; rfl

section Universal

variable {I : Ideal (MvPolynomial V A)}

/-- The ideal of `A[X ⊔ X]` generated by the first copy of `I` and the differences
`x_i - y_i`; it contains both copies of `I`. -/
noncomputable def diagonalIdeal (I : Ideal (MvPolynomial V A)) :
    Ideal (MvPolynomial (V ⊕ V) A) :=
  Ideal.span (rename Sum.inl '' (I : Set (MvPolynomial V A)) ∪
    Set.range (diagonalDifference (A := A)))

/-- The first copy `a(x)` of an element `a ∈ I` lies in `diagonalIdeal I`. -/
theorem rename_inl_mem_diagonalIdeal (a : MvPolynomial V A) (ha : a ∈ I) :
    (rename Sum.inl : MvPolynomial V A →ₐ[A] _).toRingHom a ∈ diagonalIdeal I :=
  Ideal.subset_span (Or.inl ⟨a, ha, rfl⟩)

/-- The difference `x_i - y_i` lies in `diagonalIdeal I`. -/
theorem diagonalDifference_mem_diagonalIdeal (i : V) :
    diagonalDifference (A := A) i ∈ diagonalIdeal I :=
  Ideal.subset_span (Or.inr ⟨i, rfl⟩)

/-- The second copy `a(y)` of an element `a ∈ I` lies in `diagonalIdeal I`. -/
theorem rename_inr_mem_diagonalIdeal (a : MvPolynomial V A) (ha : a ∈ I) :
    (rename Sum.inr : MvPolynomial V A →ₐ[A] _).toRingHom a ∈ diagonalIdeal I := by
  have h := rename_inl_sub_rename_inr_mem (A := A) a
  have hle : Ideal.span (Set.range (diagonalDifference (A := A) (V := V))) ≤ diagonalIdeal I :=
    Ideal.span_mono Set.subset_union_right
  have : rename Sum.inr a = rename Sum.inl a - (rename Sum.inl a - rename Sum.inr a) := by ring
  show rename Sum.inr a ∈ _
  rw [this]
  exact Ideal.sub_mem _ (rename_inl_mem_diagonalIdeal a ha) (hle h)

/-- The difference `x_i - y_i` as an element of `diagonalIdeal I`. -/
noncomputable def diagonalDifferenceElem (I : Ideal (MvPolynomial V A)) (i : V) :
    diagonalIdeal I := ⟨diagonalDifference i, diagonalDifference_mem_diagonalIdeal i⟩

/-- The linear map `(V →₀ J) → J ⊗ J`, `γ ↦ ∑ (x_i - y_i) ⊗ γ_i`, where `J = diagonalIdeal I`. -/
noncomputable def diagonalTensor (I : Ideal (MvPolynomial V A)) :
    (V →₀ diagonalIdeal I) →ₗ[MvPolynomial (V ⊕ V) A]
      diagonalIdeal I ⊗[MvPolynomial (V ⊕ V) A] diagonalIdeal I :=
  Finsupp.lsum (MvPolynomial (V ⊕ V) A) fun i =>
    TensorProduct.mk (MvPolynomial (V ⊕ V) A) _ _ (diagonalDifferenceElem I i)

/-- The map `diagonalTensor I` sends `(δ_i • y)_i` to `∑ (x_i - y_i) ⊗ δ_i • y`. -/
theorem diagonalTensor_mapRange_smul (δ : V →₀ MvPolynomial (V ⊕ V) A) (y : diagonalIdeal I) :
    diagonalTensor I (δ.mapRange (fun c => c • y) (zero_smul _ _)) =
      δ.sum fun i c => diagonalDifferenceElem I i ⊗ₜ (c • y) := by
  rw [diagonalTensor, Finsupp.lsum_apply, Finsupp.sum_mapRange_index (by simp)]
  rfl

/-- The element `∑ δ_i • (x_i - y_i)` of `diagonalIdeal I` has underlying polynomial
`∑ δ_i (x_i - y_i)`. -/
theorem sum_smul_diagonalDifferenceElem (δ : V →₀ MvPolynomial (V ⊕ V) A) :
    ((δ.sum fun i c => c • diagonalDifferenceElem I i : diagonalIdeal I) :
      MvPolynomial (V ⊕ V) A) = δ.sum fun i c => c • diagonalDifference (A := A) i := by
  rw [Finsupp.sum, Finsupp.sum, Submodule.coe_sum]
  rfl

/-- For every `ξ ∈ I ⊗ I` there is `γ` with `∑ γ_i (x_i - y_i) = m(ξ)(x) - m(ξ)(y)`, where `m` is
multiplication, and such that `ξ(x) - ξ(y) - diagonalTensor I γ` is antisymmetric. -/
private theorem universal_aux (ξ : I ⊗[MvPolynomial V A] I) :
    ∃ γ : V →₀ diagonalIdeal I,
      Finsupp.linearCombination _ (diagonalDifference (A := A))
          (γ.mapRange Subtype.val rfl) =
        rename Sum.inl (idealTensorMul I ξ) - rename Sum.inr (idealTensorMul I ξ) ∧
      idealTensorMap _ rename_inl_mem_diagonalIdeal ξ -
          idealTensorMap _ rename_inr_mem_diagonalIdeal ξ - diagonalTensor I γ ∈
        idealTensorAntisymm (diagonalIdeal I) := by
  induction ξ using TensorProduct.induction_on with
  | zero => exact ⟨0, by simp, by simp⟩
  | tmul a b =>
    obtain ⟨δa, hδa⟩ := Finsupp.mem_span_range_iff_exists_finsupp.1
      (rename_inl_sub_rename_inr_mem (A := A) (a : MvPolynomial V A))
    obtain ⟨δb, hδb⟩ := Finsupp.mem_span_range_iff_exists_finsupp.1
      (rename_inl_sub_rename_inr_mem (A := A) (b : MvPolynomial V A))
    set a₁ : diagonalIdeal I := ⟨_, rename_inl_mem_diagonalIdeal a a.2⟩
    set a₂ : diagonalIdeal I := ⟨_, rename_inr_mem_diagonalIdeal a a.2⟩
    set b₁ : diagonalIdeal I := ⟨_, rename_inl_mem_diagonalIdeal b b.2⟩
    set b₂ : diagonalIdeal I := ⟨_, rename_inr_mem_diagonalIdeal b b.2⟩
    have hd : ∀ (u v : diagonalIdeal I) (δ : V →₀ MvPolynomial (V ⊕ V) A),
        (δ.sum fun i c => c • diagonalDifference (A := A) i) = (u : MvPolynomial (V ⊕ V) A) - v →
        u - v = δ.sum fun i c => c • diagonalDifferenceElem I i := fun u v δ h => by
      apply Subtype.ext
      rw [sum_smul_diagonalDifferenceElem, h]
      rfl
    have he : ∀ (δ : V →₀ MvPolynomial (V ⊕ V) A) (y q : MvPolynomial (V ⊕ V) A),
        (δ.sum fun i c => c • diagonalDifference (A := A) i) = q →
        (δ.sum fun i c => c * y * diagonalDifference i) = y * q := by
      rintro δ y _ rfl
      rw [Finsupp.mul_sum]
      exact Finset.sum_congr rfl fun i _ => by dsimp only; rw [smul_eq_mul]; ring
    have ha := hd a₁ a₂ δa hδa
    have hb := hd b₁ b₂ δb hδb
    refine ⟨δa.mapRange (fun c => c • b₁) (zero_smul _ _) +
      δb.mapRange (fun c => c • a₂) (zero_smul _ _), ?_, ?_⟩
    · rw [Finsupp.mapRange_add (by simp), map_add, Finsupp.mapRange_mapRange,
        Finsupp.mapRange_mapRange, Finsupp.linearCombination_apply,
        Finsupp.linearCombination_apply, Finsupp.sum_mapRange_index (by simp),
        Finsupp.sum_mapRange_index (by simp)]
      simp only [Function.comp_apply, Submodule.coe_smul, smul_eq_mul, idealTensorMul_tmul,
        map_mul]
      rw [he δa _ _ hδa, he δb _ _ hδb]
      simp only [a₂, b₁, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
      ring
    · rw [map_add, diagonalTensor_mapRange_smul, diagonalTensor_mapRange_smul,
        idealTensorMap_tmul, idealTensorMap_tmul]
      show a₁ ⊗ₜ b₁ - a₂ ⊗ₜ b₂ - _ ∈ _
      have key : a₁ ⊗ₜ[MvPolynomial (V ⊕ V) A] b₁ - a₂ ⊗ₜ b₂ =
          (a₁ - a₂) ⊗ₜ b₁ + a₂ ⊗ₜ (b₁ - b₂) := by
        rw [sub_tmul, tmul_sub]; abel
      rw [key, ha, hb, Finsupp.sum, Finsupp.sum, sum_tmul, tmul_sum, Finsupp.sum, Finsupp.sum]
      have h1 : ∀ i, (δa i • diagonalDifferenceElem I i) ⊗ₜ[MvPolynomial (V ⊕ V) A] b₁ =
          diagonalDifferenceElem I i ⊗ₜ (δa i • b₁) := fun i => by rw [smul_tmul]
      simp only [h1]
      have h2 : ∀ i, a₂ ⊗ₜ[MvPolynomial (V ⊕ V) A] (δb i • diagonalDifferenceElem I i) -
          diagonalDifferenceElem I i ⊗ₜ (δb i • a₂) =
          δb i • (a₂ ⊗ₜ diagonalDifferenceElem I i - diagonalDifferenceElem I i ⊗ₜ a₂) :=
        fun i => by rw [smul_sub, tmul_smul, tmul_smul]
      have : (∑ i ∈ δa.support, diagonalDifferenceElem I i ⊗ₜ[MvPolynomial (V ⊕ V) A]
            (δa i • b₁)) + (∑ i ∈ δb.support, a₂ ⊗ₜ (δb i • diagonalDifferenceElem I i)) -
          ((∑ i ∈ δa.support, diagonalDifferenceElem I i ⊗ₜ (δa i • b₁)) +
            ∑ i ∈ δb.support, diagonalDifferenceElem I i ⊗ₜ (δb i • a₂)) =
          ∑ i ∈ δb.support, δb i •
            (a₂ ⊗ₜ diagonalDifferenceElem I i - diagonalDifferenceElem I i ⊗ₜ a₂) := by
        rw [← Finset.sum_congr rfl fun i _ => h2 i, Finset.sum_sub_distrib]; abel
      rw [this]
      exact Submodule.sum_mem _ fun i _ =>
        Submodule.smul_mem _ _ (tmul_sub_tmul_mem_idealTensorAntisymm _ _ _)
  | add x y hx hy =>
    obtain ⟨γx, hx1, hx2⟩ := hx
    obtain ⟨γy, hy1, hy2⟩ := hy
    refine ⟨γx + γy, ?_, ?_⟩
    · rw [Finsupp.mapRange_add (by simp), map_add, hx1, hy1, map_add, map_add, map_add]; ring
    · rw [map_add, map_add, map_add]
      convert add_mem hx2 hy2 using 1
      abel

/-- On the kernel of multiplication, the two maps `I ⊗ I → J ⊗ J` induced by `x ↦ x` and
`x ↦ y`, where `J = diagonalIdeal I`, agree modulo antisymmetric tensors. -/
theorem universal_sub_mem_antisymm (ξ : I ⊗[MvPolynomial V A] I) (hξ : idealTensorMul I ξ = 0) :
    idealTensorMap _ rename_inl_mem_diagonalIdeal ξ -
        idealTensorMap _ rename_inr_mem_diagonalIdeal ξ ∈
      idealTensorAntisymm (diagonalIdeal I) := by
  classical
  obtain ⟨γ, hγ1, hγ2⟩ := universal_aux ξ
  rw [hξ, map_zero, map_zero, sub_zero] at hγ1
  obtain ⟨c, hc⟩ := exists_finsupp_trivial_diagonalDifference _ hγ1
  have hγ : γ = c.sum fun p a => a • (Finsupp.single p.1 (diagonalDifferenceElem I p.2) -
      Finsupp.single p.2 (diagonalDifferenceElem I p.1)) := by
    refine Finsupp.ext fun k => Subtype.ext ?_
    have hk := hc k
    rw [Finsupp.mapRange_apply] at hk
    rw [hk]
    simp only [Finsupp.sum, Finsupp.finset_sum_apply, Submodule.coe_sum, Finsupp.smul_apply,
      Finsupp.sub_apply, Submodule.coe_smul, Submodule.coe_sub, Finsupp.single_apply]
    refine Finset.sum_congr rfl fun p _ => ?_
    split_ifs <;> simp [diagonalDifferenceElem, smul_eq_mul]
  have hL : diagonalTensor I γ ∈ idealTensorAntisymm (diagonalIdeal I) := by
    rw [hγ, Finsupp.sum, map_sum]
    refine Submodule.sum_mem _ fun p _ => ?_
    rw [map_smul, map_sub, diagonalTensor, Finsupp.lsum_single, Finsupp.lsum_single]
    exact Submodule.smul_mem _ _ (tmul_sub_tmul_mem_idealTensorAntisymm _ _ _)
  simpa using add_mem hγ2 hL

end Universal

variable {R' : Type v} [CommRing R'] [Algebra A R'] {I : Ideal (MvPolynomial V A)} {I' : Ideal R'}

/-- **Two maps agreeing modulo an ideal agree on `Ker(I ⊗ I → I²)` modulo antisymmetric
tensors.** Let `e₁, e₂ : A[V] → R'` be `A`-algebra maps sending `I` into `I'` with
`e₁(x_i) ≡ e₂(x_i)` modulo `I'`. Then for every `ξ ∈ I ⊗ I` with `ξ ↦ 0` under multiplication,
`e₁(ξ) - e₂(ξ)` is a sum of antisymmetric tensors. -/
theorem idealTensorMap_sub_mem_antisymm (e₁ e₂ : MvPolynomial V A →ₐ[A] R')
    (h₁ : ∀ a ∈ I, e₁.toRingHom a ∈ I') (h₂ : ∀ a ∈ I, e₂.toRingHom a ∈ I')
    (hX : ∀ i, e₁ (X i) - e₂ (X i) ∈ I')
    (ξ : I ⊗[MvPolynomial V A] I) (hξ : idealTensorMul I ξ = 0) :
    idealTensorMap _ h₁ ξ - idealTensorMap _ h₂ ξ ∈ idealTensorAntisymm I' := by
  let g : MvPolynomial (V ⊕ V) A →ₐ[A] R' := aeval (Sum.elim (fun i => e₁ (X i))
    (fun i => e₂ (X i)))
  have hg₁ : g.comp (rename Sum.inl) = e₁ := by ext i; simp [g]
  have hg₂ : g.comp (rename Sum.inr) = e₂ := by ext i; simp [g]
  have hg : ∀ a ∈ diagonalIdeal I, g.toRingHom a ∈ I' := by
    intro a ha
    refine (Ideal.span_le (I := I'.comap g.toRingHom)).2 ?_ ha
    rintro _ (⟨b, hb, rfl⟩ | ⟨i, rfl⟩)
    · show g (rename Sum.inl b) ∈ I'
      rw [← AlgHom.comp_apply, hg₁]
      exact h₁ b hb
    · show g (diagonalDifference i) ∈ I'
      simpa [g, diagonalDifference] using hX i
  have e1 := idealTensorMap_comp _ rename_inl_mem_diagonalIdeal g.toRingHom hg ξ
  have e2 := idealTensorMap_comp _ rename_inr_mem_diagonalIdeal g.toRingHom hg ξ
  rw [idealTensorMap_congr (g := e₁.toRingHom) (by rw [← hg₁]; rfl) _ h₁] at e1
  rw [idealTensorMap_congr (g := e₂.toRingHom) (by rw [← hg₂]; rfl) _ h₂] at e2
  rw [← e1, ← e2, ← map_sub]
  exact idealTensorMap_mem_antisymm _ hg (universal_sub_mem_antisymm ξ hξ)

end Homotopy

end Stacks.Cotangent
