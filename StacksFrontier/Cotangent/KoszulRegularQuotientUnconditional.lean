module

public import StacksFrontier.Cotangent.KoszulRegularQuotient
public import StacksFrontier.Cotangent.PolynomialRetractionUnconditional

/-!
# Lemma 08SJ with the fundamental triangle supplied

`StacksFrontier.Cotangent.KoszulRegularQuotient` proves [Stacks, Tag 08SJ] under Proposition 08QX
for the towers `R → P → R` with `P` a polynomial algebra over `R` carrying a retraction, taken
as a parameter. This file supplies it from Proposition 08QX,
`CommAlgCat.productFundamentalTriangle_distinguished`, through
`CommAlgCat.hasFundamentalTriangleAt`, and states Tag 08SJ under exactly the source's
hypotheses.

## Main results

* `CommAlgCat.nonempty_cotangentComplex_iso_single_of_isKoszulRegular_sequence_unconditional`:
  **[Stacks, Tag 08SJ]**.

## References

* [Stacks Project, Tag 08SJ](https://stacks.math.columbia.edu/tag/08SJ)
* [Stacks Project, Tag 08QX](https://stacks.math.columbia.edu/tag/08QX), the fundamental
  triangle.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated

universe u

namespace CommAlgCat

attribute [local instance] HasDerivedCategory.standard

section KoszulRegular

variable (R : Type u) [CommRing R] (S : CommAlgCat.{u} R)

/-- **Stacks Project, Tag 08SJ.** Let `R → S` be a surjective map of commutative rings whose
kernel `I` is generated by a Koszul-regular sequence `f₁, …, f_r ∈ R`. Then `L_{S/R}` is
isomorphic in `D(S)` to the conormal module `I/I²` placed in cohomological degree `-1`.

This is `CommAlgCat.nonempty_cotangentComplex_iso_single_of_isKoszulRegular_sequence` with the
fundamental triangles of the towers `R → P → R` supplied by
`CommAlgCat.hasFundamentalTriangleAt`. -/
@[stacks 08SJ "the lemma for a kernel generated by a Koszul-regular SEQUENCE f_1,...,f_r. I/I^2 \
  is the conormal module of the surjection, as the cotangent module of the corresponding algebra \
  extension. NOTHING is carried: the fundamental triangle of the towers R -> P -> R with P a \
  polynomial algebra over R carrying a retraction is Proposition 08QX, \
  `CommAlgCat.productFundamentalTriangle_distinguished`. The triangle of Tag 08SD does not \
  apply, needing the middle map injective whereas an augmentation is surjective; the \
  proposition does, assuming nothing"]
theorem nonempty_cotangentComplex_iso_single_of_isKoszulRegular_sequence_unconditional
    (h : Function.Surjective (algebraMap R (S : Type u)))
    {r : ℕ} (f : Fin r → R) (hf : Koszul.IsKoszulRegular f)
    (hI : RingHom.ker (algebraMap R (S : Type u)) = Ideal.span (Set.range f)) :
    Nonempty (DerivedCategory.Q.obj (cotangentComplex R S) ≅
      (DerivedCategory.singleFunctor (ModuleCat.{u} (S : Type u)) (-1)).obj
        (ModuleCat.of (S : Type u) (surjectionExtension R S h).Cotangent)) :=
  nonempty_cotangentComplex_iso_single_of_isKoszulRegular_sequence R S h f hf hI
    fun P _ _ _ _ _ => hasFundamentalTriangleAt R P R

end KoszulRegular

end CommAlgCat

end
