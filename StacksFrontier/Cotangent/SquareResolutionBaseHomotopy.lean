module

public import StacksFrontier.Cotangent.StandardResolutionFrobeniusHomotopy
public import StacksFrontier.Cotangent.StandardResolutionIsResolution

/-!
# A square factoring through the base ring of the target, on standard resolutions

Let `A → A'`, `B → B'` be a commutative square of ring maps compatible with the algebra structures
`A → B` and `A' → B'`, and suppose it is cut by an arrow `κ : B → A'`, meaning that `κ` recovers
`A → A'` on the image of `A` and that `A' → B'` recovers `B → B'` after `κ`. The functoriality map
`P_• → P'_•` of the two standard resolutions is then homotopic, as a map of simplicial commutative
rings, to the composition `P_• → B → A' → P'_•`: evaluation of the resolution, then `κ`, then the
structure map of `P'_•` over `A'`.

## Main definitions

* `CommAlgCat.squareResolutionRingMap`: the functoriality map `P_• → P'_•` of a square, read as a
  map of simplicial commutative rings.
* `CommAlgCat.squareResolutionRingBaseMap`: the composition `P_• → B → A' → P'_•` attached to
  `κ : B → A'`.
* `CommAlgCat.emptyPoly`, `CommAlgCat.emptyInclusion` and `CommAlgCat.emptyCollapse`: the
  polynomial algebra `A'[∅]` on the empty set, the unique `A'`-algebra map out of it, and the
  endomorphism of its standard resolution which evaluates to `A'[∅]` and includes it again.

## Main results

* `CommAlgCat.eqvGen_homotopy_emptyCollapse_id`: the standard resolution of the polynomial algebra
  on the empty set is contractible — `emptyCollapse` is homotopic to the identity.
* `CommAlgCat.cotangentTermDifferential_squareResolutionRingBaseMap`: the composition through `κ`
  kills differentials.
* `CommAlgCat.eqvGen_homotopy_squareResolutionRingMap_baseMap`: **Stacks 08SB**, the claim of the
  remark.

## Implementation notes

The source of the two compared maps is a simplicial `A`-algebra and their target a simplicial
`A'`-algebra, so neither is a map inside one category of algebras; both are maps of simplicial
*rings*, which is also the category the source works in, and the ambient category here is the one
`CommAlgCat.resolutionRing` names: the standard resolution pushed along
`forget₂ (CommAlgCat A) CommRingCat`. Homotopic means related by the equivalence relation
generated by the existence of a simplicial homotopy, `Relation.EqvGen` of
`Nonempty (SimplicialObject.Homotopy _ _)`, as in [Stacks, Tag 019N] and [Stacks, Tag 08RJ]; this
is the notion [Stacks, Tag 08ND] is stated for.

The source's factorization is followed. Using `κ`, the square is the horizontal composition of a
square `A → A'`, `B → A'[∅]` with a square `A' → A'`, `A'[∅] → B'`, so the functoriality map
factors through the standard resolution of `A'[∅]` over `A'`. Two points of the argument are
carried by the fact that `A'[∅]` has exactly one `A'`-algebra map to any `A'`-algebra
(`CommAlgCat.emptyPoly_hom_ext`): it makes `emptyCollapse` natural, and it identifies the homotopy
inverse that [Stacks, Tag 08ND] produces — which that statement only asserts to exist — with the
structure morphism, which is the source's own observation at this point of the proof.

The middle algebra is `A'[∅]` rather than `A'` itself for two reasons. It is the value at the empty
set of the polynomial-algebra functor, which is what makes [Stacks, Tag 08ND] applicable to it:
that statement contracts the standard resolution of a *free* object, in the form of the whiskering
`ε ⋆ 1_U` of the augmentation. And `A'` itself would be one universe too low, the two base rings
being supplied in a single universe `u` while the algebras live in `max u v`; `A'[∅]` is a
universe-correct model of `A'`, as `ULift A'` is in
`StacksFrontier.Cotangent.SquareFactoringThroughBase`.

## References

* [Stacks Project, Tag 08SB](https://stacks.math.columbia.edu/tag/08SB)
-/

@[expose] public section

open CategoryTheory Opposite Simplicial

universe u v

namespace CommAlgCat

/-- Whiskering with a functor carries homotopic maps of simplicial objects to homotopic maps. -/
private theorem eqvGen_homotopy_whiskerRight {C D : Type*}
    [Category C] [Category D] (F : C ⥤ D) {X Y : SimplicialObject C} {f g : X ⟶ Y}
    (h : Relation.EqvGen (fun f g : X ⟶ Y => Nonempty (SimplicialObject.Homotopy f g)) f g) :
    Relation.EqvGen (fun f g : X ⋙ F ⟶ Y ⋙ F => Nonempty (SimplicialObject.Homotopy f g))
      (Functor.whiskerRight f F) (Functor.whiskerRight g F) :=
  Relation.EqvGen.map (fun k => Functor.whiskerRight k F)
    (fun _ _ hxy => hxy.map fun H => H.whiskerRight F) h

/-! ### The polynomial algebra on the empty set -/

section EmptyPoly

variable (A' : Type u) [CommRing A']

/-- The polynomial algebra on the empty set over `A'`, a universe-correct model of `A'` which is
the value of the polynomial-algebra functor at the empty set. -/
public noncomputable def emptyPoly : CommAlgCat.{max u v} A' :=
  CommAlgCat.of A' (MvPolynomial (PEmpty.{max u v + 1}) A')

/-- The polynomial algebra on the empty set is the value of the polynomial-algebra functor at the
empty set. -/
public theorem emptyPoly_eq_free :
    emptyPoly.{u, v} A' = (free.{u, v} A').obj (PEmpty.{max u v + 1}) := rfl

/-- There is at most one `A'`-algebra map out of the polynomial algebra on the empty set. -/
public theorem emptyPoly_hom_ext {R : CommAlgCat.{max u v} A'}
    (f g : emptyPoly.{u, v} A' ⟶ R) : f = g :=
  CommAlgCat.hom_ext (MvPolynomial.algHom_ext fun e => e.elim)

/-- The unique `A'`-algebra map from the polynomial algebra on the empty set to an `A'`-algebra. -/
public noncomputable def emptyInclusion (R : CommAlgCat.{max u v} A') : emptyPoly.{u, v} A' ⟶ R :=
  CommAlgCat.ofHom (MvPolynomial.aeval (fun e : PEmpty.{max u v + 1} => e.elim))

/-- The unique `A'`-algebra map out of `A'[∅]` carries the structure map of `A'[∅]` to that of the
target. -/
public theorem emptyInclusion_algebraMap (R : CommAlgCat.{max u v} A') (a : A') :
    emptyInclusion.{u, v} A' R (algebraMap A' (emptyPoly.{u, v} A') a) = algebraMap A' R a :=
  (emptyInclusion.{u, v} A' R).hom.commutes a

/-- The endomorphism of the standard resolution of `A'[∅]` which evaluates a term down to `A'[∅]`
along the augmentation and then includes `A'[∅]` again. Its being homotopic to the identity is the
contractibility of that resolution. -/
public noncomputable def emptyCollapse :
    (standardResolution.{u, max u v} A' (emptyPoly.{u, v} A')).left ⟶
      (standardResolution.{u, max u v} A' (emptyPoly.{u, v} A')).left where
  app n := (standardResolution.{u, max u v} A' (emptyPoly.{u, v} A')).hom.app n ≫
    emptyInclusion.{u, v} A'
      ((standardResolution.{u, max u v} A' (emptyPoly.{u, v} A')).left.obj n)
  naturality i j f := by
    have h : (standardResolution.{u, max u v} A' (emptyPoly.{u, v} A')).left.map f ≫
        (standardResolution.{u, max u v} A' (emptyPoly.{u, v} A')).hom.app j =
        (standardResolution.{u, max u v} A' (emptyPoly.{u, v} A')).hom.app i := by
      simp
    rw [← Category.assoc, h, Category.assoc]
    congr 1
    exact emptyPoly_hom_ext.{u, v} A' _ _

end EmptyPoly

/-! ### Contractibility of the standard resolution of the polynomial algebra on the empty set -/

section Contractible


/-- Two morphisms with the same target out of objects identified by an equality agree as soon as
the target admits at most one morphism from the second object. -/
private theorem hom_ext_of_obj_eq {A' : Type u} [CommRing A']
    {R S T : CommAlgCat.{max u v} A'} (h : R = S) (huniq : ∀ f g : S ⟶ T, f = g)
    (f g : R ⟶ T) : f = g := by
  subst h
  exact huniq f g

/-- The whiskered augmentation `ε ⋆ 1_U` of the standard resolution of `CommAlgCat A'` has a
homotopy inverse on one side: the instance of [Stacks, Tag 08ND] for the polynomial comonad. -/
private theorem exists_homotopyInverse_whiskerLeft_free_standardEndofunctor (A' : Type u)
    [CommRing A'] :
    ∃ r : (Functor.const SimplexCategoryᵒᵖ).obj
        (free.{u, v} A' ⋙ (standardEndofunctor.{u, v} A').right) ⟶
        (standardEndofunctor.{u, v} A').left ⋙
          (Functor.whiskeringLeft (Type (max u v)) (CommAlgCat.{max u v} A')
            (CommAlgCat.{max u v} A')).obj (free.{u, v} A'),
      Relation.EqvGen (fun f g => Nonempty (SimplicialObject.Homotopy f g))
        (Functor.whiskerRight (standardEndofunctor.{u, v} A').hom
          ((Functor.whiskeringLeft (Type (max u v)) (CommAlgCat.{max u v} A')
            (CommAlgCat.{max u v} A')).obj (free.{u, v} A')) ≫ r) (𝟙 _) := by
  classical
  let adjA := adj.{u, v} A'
  let X := standardEndofunctor.{u, v} A'
  let C := CommAlgCat.{max u v} A'
  let V := forget C
  let U := free.{u, v} A'
  let Z : ℕ → (C ⥤ C) := fun n => (adjA.toComonad : C ⥤ C).iterate n
  let a := Functor.whiskerRight X.hom ((Functor.whiskeringRight C C (Type (max u v))).obj V)
  let b := Functor.whiskerRight X.hom ((Functor.whiskeringLeft (Type (max u v)) C C).obj U)
  have hND := CategoryTheory.Adjunction.exists_homotopyInverse_whiskered_standardResolution
    adjA Z
    (fun _ => rfl)
    (fun n j => Godement.face adjA.toComonad.ε n j)
    (fun n j => Godement.degeneracy adjA.toComonad.δ n j)
    rfl
    (fun n => (Godement.Prep.face_zero adjA.toComonad.ε n).trans (Category.id_comp _).symm)
    (fun n j => (Godement.Prep.face_succ adjA.toComonad.ε n j).trans (by simp))
    (fun n => (Godement.Prep.degeneracy_zero adjA.toComonad.δ n).trans
      (eq_id_comp_comp_whiskerRight_id' (K := (adjA.toComonad : C ⥤ C).iterate (n + 1))
        (adjA.toComonad : C ⥤ C) (Functor.whiskerLeft (Z n) adjA.toComonad.δ)))
    (fun n j => (Godement.Prep.degeneracy_succ adjA.toComonad.δ n j).trans (by simp))
    X
    (standardEndofunctor_obj A')
    (standardEndofunctor_right A')
    (fun n j => by simpa [adjA, polynomialComonad] using standardEndofunctor_face A' n j)
    (fun n j => by simpa [adjA, polynomialComonad] using standardEndofunctor_degeneracy A' n j)
    (by simpa [adjA, polynomialComonad] using standardEndofunctor_augmentation A')
    a
    (fun _ => rfl)
    b
    (fun _ => rfl)
  exact hND.2.imp fun _ h => h.1

/-- **The standard resolution of the polynomial algebra on the empty set is contractible.** The
endomorphism `CommAlgCat.emptyCollapse`, which evaluates along the augmentation and includes the
base again, is homotopic to the identity.

This is the instance of [Stacks, Tag 08ND] the proof of [Stacks, Tag 08SB] uses, with the homotopy
inverse that statement produces identified — by `CommAlgCat.emptyPoly_hom_ext` — with the
structure morphism of the resolution over `A'[∅]`. -/
public theorem eqvGen_homotopy_emptyCollapse_id (A' : Type u) [CommRing A'] :
    Relation.EqvGen
      (fun f g : (standardResolution.{u, max u v} A' (emptyPoly.{u, v} A')).left ⟶
          (standardResolution.{u, max u v} A' (emptyPoly.{u, v} A')).left =>
        Nonempty (SimplicialObject.Homotopy f g))
      (emptyCollapse.{u, v} A') (𝟙 _) := by
  classical
  let X := standardEndofunctor.{u, v} A'
  let C := CommAlgCat.{max u v} A'
  let U := free.{u, v} A'
  let b := Functor.whiskerRight X.hom ((Functor.whiskeringLeft (Type (max u v)) C C).obj U)
  obtain ⟨r, hr₁⟩ := exists_homotopyInverse_whiskerLeft_free_standardEndofunctor.{u, v} A'
  let E := PEmpty.{max u v + 1}
  let Ev := (evaluation (Type (max u v)) C).obj E
  have hB : X.right.obj (emptyPoly.{u, v} A') = emptyPoly.{u, v} A' :=
    congrArg (fun F : C ⥤ C => F.obj (emptyPoly.{u, v} A')) (standardEndofunctor_right A')
  have h' : Relation.EqvGen
      (fun f g : (standardResolution.{u, max u v} A' (emptyPoly.{u, v} A')).left ⟶
          (standardResolution.{u, max u v} A' (emptyPoly.{u, v} A')).left =>
        Nonempty (SimplicialObject.Homotopy f g))
      (Functor.whiskerRight (b ≫ r) Ev)
      (Functor.whiskerRight
        (𝟙 (X.left ⋙ (Functor.whiskeringLeft (Type (max u v)) C C).obj U)) Ev) :=
    eqvGen_homotopy_whiskerRight Ev hr₁
  have hcol : Functor.whiskerRight (b ≫ r) Ev = emptyCollapse.{u, v} A' := by
    refine NatTrans.ext (funext fun n => ?_)
    have huniq : (r.app n).app E =
        eqToHom hB ≫ emptyInclusion.{u, v} A'
          ((standardResolution.{u, max u v} A' (emptyPoly.{u, v} A')).left.obj n) :=
      hom_ext_of_obj_eq hB (emptyPoly_hom_ext.{u, v} A') _ _
    refine CommAlgCat.hom_ext (AlgHom.ext fun x => ?_)
    exact congrArg
      (fun k : X.right.obj (emptyPoly.{u, v} A') ⟶
          (standardResolution.{u, max u v} A' (emptyPoly.{u, v} A')).left.obj n =>
        k ((X.hom.app n).app (emptyPoly.{u, v} A') x))
      huniq
  rw [Functor.whiskerRight_id', hcol] at h'
  exact h'

end Contractible

/-! ### The two maps of simplicial rings attached to a square cut by an arrow `κ : B → A'` -/

section Square

variable {A A' : Type u} [CommRing A] [CommRing A']
  {B : CommAlgCat.{max u v} A} {B' : CommAlgCat.{max u v} A'}

/-- The augmentation of the standard resolution, read as a ring homomorphism, is the augmentation
of the augmented simplicial algebra. -/
public theorem standardResolutionAugmentationHom_apply (A : Type u) [CommRing A]
    (B : CommAlgCat.{max u v} A) (n : SimplexCategoryᵒᵖ)
    (p : (standardResolution.{u, max u v} A B).left.obj n) :
    standardResolutionAugmentationHom.{u, max u v} A B n p =
      (standardResolution.{u, max u v} A B).hom.app n p := rfl

/-- The functoriality map `P_• → P'_•` of the two standard resolutions over a commutative square
of ring maps, read as a map of simplicial commutative rings. -/
public noncomputable def squareResolutionRingMap (sq : AlgebraSquare.{u, v, u} A A' B B') :
    resolutionRing.{u, v} A B ⟶ resolutionRing.{u, v} A' B' where
  app n := CommRingCat.ofHom ((squareFunctoriality.{u, v, u} sq).resolution n)
  naturality {i j} f := by
    ext x
    exact (squareFunctoriality.{u, v, u} sq).resolution_naturality f x

/-- The composition `P_• → B → A' → P'_•` attached to an arrow `κ : B → A'`: the augmentation of
the standard resolution of `B` over `A`, then `κ`, then the structure map of the standard
resolution of `B'` over `A'`. -/
public noncomputable def squareResolutionRingBaseMap (κ : B →+* A') :
    resolutionRing.{u, v} A B ⟶ resolutionRing.{u, v} A' B' where
  app n := CommRingCat.ofHom
    (((algebraMap A' ((standardResolution.{u, max u v} A' B').left.obj n)).comp κ).comp
      (standardResolutionAugmentationHom.{u, max u v} A B n))
  naturality {i j} f := by
    ext x
    have haug : standardResolutionAugmentationHom.{u, max u v} A B j
        ((standardResolution.{u, max u v} A B).left.map f x) =
        standardResolutionAugmentationHom.{u, max u v} A B i x :=
      RingHom.congr_fun (standardResolutionAugmentationHom_naturality.{u, max u v} A B f) x
    change algebraMap A' ((standardResolution.{u, max u v} A' B').left.obj j)
        (κ (standardResolutionAugmentationHom.{u, max u v} A B j
          ((standardResolution.{u, max u v} A B).left.map f x))) =
      (standardResolution.{u, max u v} A' B').left.map f
        (algebraMap A' ((standardResolution.{u, max u v} A' B').left.obj i)
          (κ (standardResolutionAugmentationHom.{u, max u v} A B i x)))
    rw [haug, ((standardResolution.{u, max u v} A' B').left.map f).hom.commutes]

/-- The composition `P_• → B → A' → P'_•` lands in the image of `A'`, so it kills differentials:
the pure differential `1 ⊗ d` of each of its values vanishes. This is the step by which the
source passes from the homotopy below to the vanishing, up to homotopy, of the induced map on
cotangent complexes. -/
@[stacks 08SB "the remark's observation that the composition through `κ` induces the zero map on \
differentials, read degreewise on the pure differentials `1 ⊗ d p` which generate the terms of \
the cotangent complex."]
public theorem cotangentTermDifferential_squareResolutionRingBaseMap
    (κ : B →+* A') (n : SimplexCategoryᵒᵖ)
    (p : (standardResolution.{u, max u v} A B).left.obj n) :
    cotangentTermDifferential.{u, max u v} A' B' n
      ((squareResolutionRingBaseMap.{u, v} (B' := B') κ).app n p) = 0 :=
  cotangentTermDifferential_algebraMap.{u, max u v} A' B' n
    (κ (standardResolutionAugmentationHom.{u, max u v} A B n p))

/-- The square `A → A'`, `B → A'[∅]` through which `κ : B → A'` factors a square, given that `κ`
recovers the map of base rings `f : A → A'` on the image of `A`. -/
private noncomputable def squareToEmptyPoly (f : A →+* A') (κ : B →+* A')
    (hκ : ∀ a : A, κ (algebraMap A B a) = f a) :
    AlgebraSquare.{u, v, u} A A' B (emptyPoly.{u, v} A') where
  base := f
  map := (algebraMap A' (emptyPoly.{u, v} A')).comp κ
  map_algebraMap a := congrArg (algebraMap A' (emptyPoly.{u, v} A')) (hκ a)

/-- The square `A' → A'`, `A'[∅] → B'` given by the unique `A'`-algebra map out of `A'[∅]`. -/
private noncomputable def emptyPolySquare (B' : CommAlgCat.{max u v} A') :
    AlgebraSquare.{u, v, u} A' A' (emptyPoly.{u, v} A') B' where
  base := RingHom.id A'
  map := (emptyInclusion.{u, v} A' B').hom.toRingHom
  map_algebraMap a := emptyInclusion_algebraMap.{u, v} A' B' a

/-- A square cut by `κ : B → A'` is the composition of `CommAlgCat.squareToEmptyPoly` with
`CommAlgCat.emptyPolySquare`. -/
private theorem squareToEmptyPoly_comp_emptyPolySquare (sq : AlgebraSquare.{u, v, u} A A' B B')
    (κ : B →+* A') (hκ : ∀ a : A, κ (algebraMap A B a) = sq.base a)
    (hκ' : ∀ b : B, algebraMap A' B' (κ b) = sq.map b) :
    (squareToEmptyPoly.{u, v} sq.base κ hκ).comp (emptyPolySquare.{u, v} B') = sq := by
  have hext : ∀ s t : AlgebraSquare.{u, v, u} A A' B B',
      s.base = t.base → s.map = t.map → s = t := by
    rintro ⟨b₁, m₁, h₁⟩ ⟨b₂, m₂, h₂⟩ rfl rfl
    rfl
  exact hext _ _ (RingHom.id_comp _) (RingHom.ext fun b => by
    change emptyInclusion.{u, v} A' B' (algebraMap A' (emptyPoly.{u, v} A') (κ b)) = sq.map b
    rw [emptyInclusion_algebraMap, hκ'])

/-- Collapsing the middle resolution of the factorization through `A'[∅]` gives the composition
`P_• → B → A' → P'_•` through `κ`. -/
private theorem squareResolutionRingMap_comp_emptyCollapse_comp
    (sq : AlgebraSquare.{u, v, u} A A' B B') (κ : B →+* A')
    (hκ : ∀ a : A, κ (algebraMap A B a) = sq.base a) :
    squareResolutionRingMap.{u, v} (squareToEmptyPoly.{u, v} sq.base κ hκ) ≫
        Functor.whiskerRight (emptyCollapse.{u, v} A')
          (forget₂ (CommAlgCat.{max u v} A') CommRingCat.{max u v}) ≫
        squareResolutionRingMap.{u, v} (emptyPolySquare.{u, v} B') =
      squareResolutionRingBaseMap.{u, v} (B' := B') κ := by
  let M : CommAlgCat.{max u v} A' := emptyPoly.{u, v} A'
  let sq₁ := squareToEmptyPoly.{u, v} sq.base κ hκ
  let sq₂ := emptyPolySquare.{u, v} B'
  ext n x
  have h₁ : standardResolutionAugmentationHom.{u, max u v} A' M n
      ((squareFunctoriality.{u, v, u} sq₁).resolution n x) =
      algebraMap A' M (κ (standardResolutionAugmentationHom.{u, max u v} A B n x)) :=
    (squareFunctoriality.{u, v, u} sq₁).resolution_augmentation n x
  have h₂ : (squareFunctoriality.{u, v, u} sq₂).resolution n
      (algebraMap A' ((standardResolution.{u, max u v} A' M).left.obj n)
        (κ (standardResolutionAugmentationHom.{u, max u v} A B n x))) =
      algebraMap A' ((standardResolution.{u, max u v} A' B').left.obj n)
        (κ (standardResolutionAugmentationHom.{u, max u v} A B n x)) :=
    (squareFunctoriality.{u, v, u} sq₂).resolution_algebraMap n _
  change (squareFunctoriality.{u, v, u} sq₂).resolution n
      (emptyInclusion.{u, v} A' ((standardResolution.{u, max u v} A' M).left.obj n)
        ((standardResolution.{u, max u v} A' M).hom.app n
          ((squareFunctoriality.{u, v, u} sq₁).resolution n x))) =
    algebraMap A' ((standardResolution.{u, max u v} A' B').left.obj n)
      (κ (standardResolutionAugmentationHom.{u, max u v} A B n x))
  rw [← standardResolutionAugmentationHom_apply, h₁, emptyInclusion_algebraMap, h₂]

/-! ### The remark -/

/-- **Stacks Project, Tag 08SB.** Let `A → A'`, `B → B'` be a commutative square of ring maps
compatible with the algebra structures `A → B` and `A' → B'`, and let `κ : B → A'` be a ring map
which agrees with `A → A'` on the image of `A` and which recovers `B → B'` after `A' → B'`. Then
the functoriality map `P_• → P'_•` of the two standard resolutions is homotopic, as a map of
simplicial commutative rings, to the composition `P_• → B → A' → P'_•`. -/
@[stacks 08SB "the claim of the remark: the functoriality map of standard resolutions is \
homotopic to the composition through `κ`. The consequence drawn from it, that the induced map of \
cotangent complexes is homotopic to zero, is \
`CommAlgCat.nonempty_homotopy_squareCotangentComplexMap_zero`."]
public theorem eqvGen_homotopy_squareResolutionRingMap_baseMap
    (sq : AlgebraSquare.{u, v, u} A A' B B') (κ : B →+* A')
    (hκ : ∀ a : A, κ (algebraMap A B a) = sq.base a)
    (hκ' : ∀ b : B, algebraMap A' B' (κ b) = sq.map b) :
    Relation.EqvGen
      (fun f g : resolutionRing.{u, v} A B ⟶ resolutionRing.{u, v} A' B' =>
        Nonempty (SimplicialObject.Homotopy f g))
      (squareResolutionRingMap.{u, v} sq) (squareResolutionRingBaseMap.{u, v} (B' := B') κ) := by
  classical
  let M : CommAlgCat.{max u v} A' := emptyPoly.{u, v} A'
  let sq₁ := squareToEmptyPoly.{u, v} sq.base κ hκ
  let sq₂ := emptyPolySquare.{u, v} B'
  -- the two halves of the factorization
  let u₁ := squareResolutionRingMap.{u, v} sq₁
  let u₂ := squareResolutionRingMap.{u, v} sq₂
  have hfac : squareResolutionRingMap.{u, v} sq = u₁ ≫ u₂ := by
    rw [← squareToEmptyPoly_comp_emptyPolySquare.{u, v} sq κ hκ hκ']
    ext n x
    exact RingHom.congr_fun (squareFunctoriality_resolution_comp.{u, v} sq₁ sq₂ n) x
  -- the middle resolution is contractible
  let G := forget₂ (CommAlgCat.{max u v} A') CommRingCat.{max u v}
  have hring : Relation.EqvGen
      (fun f g : resolutionRing.{u, v} A' M ⟶ resolutionRing.{u, v} A' M =>
        Nonempty (SimplicialObject.Homotopy f g))
      (Functor.whiskerRight (emptyCollapse.{u, v} A') G)
      (Functor.whiskerRight (𝟙 ((standardResolution.{u, max u v} A' M).left)) G) :=
    eqvGen_homotopy_whiskerRight G (eqvGen_homotopy_emptyCollapse_id.{u, v} A')
  rw [Functor.whiskerRight_id'] at hring
  -- paste the contraction into the factorization
  have hpaste : Relation.EqvGen
      (fun f g : resolutionRing.{u, v} A B ⟶ resolutionRing.{u, v} A' B' =>
        Nonempty (SimplicialObject.Homotopy f g))
      (u₁ ≫ Functor.whiskerRight (emptyCollapse.{u, v} A') G ≫ u₂)
      (u₁ ≫ 𝟙 (resolutionRing.{u, v} A' M) ≫ u₂) :=
    Relation.EqvGen.map (fun k => u₁ ≫ k ≫ u₂)
      (fun _ _ h => h.map fun H => by
        simpa [Category.assoc] using (H.precomp u₁).postcomp u₂) hring
  rw [Category.id_comp, ← hfac, squareResolutionRingMap_comp_emptyCollapse_comp.{u, v} sq κ hκ]
    at hpaste
  exact hpaste.symm

end Square

end CommAlgCat

