module

public import StacksFrontier.AlgebraicGeometry.Simplicial.Degeneracies.Degeneracies
public import StacksFrontier.Cotangent.TorTwoPolynomialExtension

/-!
# `Tor₂` in degrees zero and one of the explicit resolution of Stacks Example 09D4

Let `P_•` be the resolution of `B` over `A` of Stacks Example 09D4: `P₀ = A[u_i]` surjects onto
`B` with kernel `J₀` generated by the `f_t`, `P₁ = A[u_i, x_t]`, `d₀(x_t) = 0`, `d₁(x_t) = f_t`
and `s₀` fixes the `u_i`. With `J_n = Ker(P_n → B)` and `Tor₂^{P_n}(B, B)` read in the
tensor-kernel model `Ker(J_n ⊗_{P_n} J_n → J_n²)`
(`Stacks.Cotangent.torTwoSelfIsoMulKernel`), Stacks Remark 09D6 claims

`Tor₂^{P₁}(B, B) = ∧²(⨁_{t ∈ T} B) ⊕ ⨁_{t ∈ T} J₀/J₀² ⊕ Tor₂^{P₀}(B, B)`,

with `x_t ∧ x_{t'} ↔ x_t ⊗ x_{t'} - x_{t'} ⊗ x_t`, `x_t ⊗ f̄ ↔ x_t ⊗ s₀(f) - s₀(f) ⊗ x_t` and the
last summand embedded by `s₀`; computes `d₀ - d₁ : Tor₂^{P₁}(B, B) → Tor₂^{P₀}(B, B)` on the
three summands; and concludes that

`∧²_B(J₀/J₀²) → Tor₂^{P₀}(B, B) → Coker(d₀ - d₁) → 0`

is exact. This file proves all of it for the actual resolution
`Algebra.PolynomialPresentationWithKernelGenerators.Degeneracies.explicitResolution`, with its
actual face and degeneracy maps, by identifying `P₁` with the polynomial ring `P₀[x_t]` compatibly
with `s₀`, `d₀`, `d₁` and the augmentation, and transporting the corresponding statements for
polynomial extensions (`polyDecomposition`, `polyFace`, `range_polyFace`).

## Main definitions

* `Stacks.Cotangent.TorTwo.Explicit.aug`: the augmentation `P_n → B` of the resolution.
* `Stacks.Cotangent.TorTwo.Explicit.polyEquiv`: the ring isomorphism `P₁ ≃ P₀[x_t]`.
* `Stacks.Cotangent.TorTwo.Explicit.face`: `d₀ - d₁` on `Tor₂`.
* `Stacks.Cotangent.TorTwo.Explicit.decomposition`: **the decomposition of `Tor₂^{P₁}(B, B)`**.
* `Stacks.Cotangent.TorTwo.Explicit.torTwoDecomposition`: the same decomposition on Mathlib's
  `Tor'`.

## Main results

* `Stacks.Cotangent.TorTwo.Explicit.decomposition_wedge`, `decomposition_mixed`,
  `decomposition_degen`: the correspondences.
* `Stacks.Cotangent.TorTwo.Explicit.face_degen`, `face_mixed`, `face_wedge`: `d₀ - d₁` on the
  summands.
* `Stacks.Cotangent.TorTwo.Explicit.range_face`: the image of `d₀ - d₁` is that of `∧²_B(J₀/J₀²)`.
* `Stacks.Cotangent.TorTwo.Explicit.exact_wedgeAntisymm_face`: the exact sequence.

## References

* [Stacks Project, Tag 09D6](https://stacks.math.columbia.edu/tag/09D6)
* [Stacks Project, Tag 09D4](https://stacks.math.columbia.edu/tag/09D4)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite MvPolynomial
open scoped Simplicial TensorProduct

universe u v w x

namespace Stacks.Cotangent.TorTwo.Explicit

open Algebra.PolynomialPresentationWithKernelGenerators

variable (p : Algebra.PolynomialPresentationWithKernelGenerators.{u, v, w, x})

/-- The explicit resolution of Stacks Example 09D4. -/
abbrev res := Degeneracies.explicitResolution p

/-- The term `P_n` of the explicit resolution. -/
abbrev term (n : ℕ) : Type (max u v w x) := (res p).simplicial.obj (op ⦋n⦌)

/-- The target `B` of the resolution, in the universe of its terms. -/
abbrev target : Type (max u v w x) := Degeneracies.commAlgB p

/-- The augmentation `P_n → B`. -/
def aug (n : ℕ) : term p n →+* target p :=
  ((res p).augmentation.app (op ⦋n⦌)).hom.toRingHom

/-- The face map `d_i : P₁ → P₀`. -/
def faceMap (i : Fin 2) : term p 1 →+* term p 0 :=
  ((res p).simplicial.δ i).hom.toRingHom

/-- The degeneracy `s₀ : P₀ → P₁`. -/
def degenMap : term p 0 →+* term p 1 :=
  ((res p).simplicial.σ (0 : Fin 1)).hom.toRingHom

/-- The augmentation of `P₀` composed with the face map `d_i` is the augmentation of `P₁`. -/
theorem aug_comp_faceMap (i : Fin 2) : (aug p 0).comp (faceMap p i) = aug p 1 := by
  have h := (res p).augmentation.naturality (SimplexCategory.δ i).op
  ext y
  exact congrArg (fun f => f.hom y) h

/-- The augmentation of `P₁` composed with the degeneracy `s₀` is the augmentation of `P₀`. -/
theorem aug_comp_degenMap : (aug p 1).comp (degenMap p) = aug p 0 := by
  have h := (res p).augmentation.naturality (SimplexCategory.σ (0 : Fin 1)).op
  ext y
  exact congrArg (fun f => f.hom y) h

/-! ### The comparison with the structure fields -/

/-- `P₀ ≅ A[u_i]`. -/
abbrev zIso := (res p).zeroIso

/-- `P₁ ≅ A[u_i, x_t]`. -/
abbrev oIso := (res p).oneIso

/-- Under `P₁ ≅ A[u_i, x_t]` and `P₀ ≅ A[u_i]`, the face map `d₀` is `DegreeOne.faceZeroLift`. -/
theorem faceMap_zero_oneIso (y : ULift.{max u v w x, max u w x} (DegreeOne.P1 p)) :
    faceMap p 0 ((oIso p).inv.hom y) = (zIso p).inv.hom (DegreeOne.faceZeroLift p y) := by
  have h : (oIso p).inv ≫ (Degeneracies.underlying p (res p).simplicial).δ (0 : Fin 2) =
      AlgCat.ofHom (DegreeOne.faceZeroLift p) ≫ (zIso p).inv := by
    rw [← (res p).faceZeroOne_eq]
    simp
  exact congrArg (fun f => f.hom y) h

/-- Under `P₁ ≅ A[u_i, x_t]` and `P₀ ≅ A[u_i]`, the face map `d₁` is `DegreeOne.faceOneLift`. -/
theorem faceMap_one_oneIso (y : ULift.{max u v w x, max u w x} (DegreeOne.P1 p)) :
    faceMap p 1 ((oIso p).inv.hom y) = (zIso p).inv.hom (DegreeOne.faceOneLift p y) := by
  have h : (oIso p).inv ≫ (Degeneracies.underlying p (res p).simplicial).δ (1 : Fin 2) =
      AlgCat.ofHom (DegreeOne.faceOneLift p) ≫ (zIso p).inv := by
    rw [← (res p).faceOneOne_eq]
    simp
  exact congrArg (fun f => f.hom y) h

/-- Under `P₀ ≅ A[u_i]` and `P₁ ≅ A[u_i, x_t]`, the degeneracy `s₀` is
`DegreeOne.degeneracyZeroLift`. -/
theorem degenMap_zeroIso (y : ULift.{max u v w x, max u w} p.P0) :
    degenMap p ((zIso p).inv.hom y) = (oIso p).inv.hom (DegreeOne.degeneracyZeroLift p y) := by
  have h : (zIso p).inv ≫ (Degeneracies.underlying p (res p).simplicial).σ (0 : Fin 1) =
      AlgCat.ofHom (DegreeOne.degeneracyZeroLift p) ≫ (oIso p).inv := by
    rw [← (res p).degeneracyZeroOne_eq]
    simp
  exact congrArg (fun f => f.hom y) h

/-- Under `P₀ ≅ A[u_i]`, the augmentation `P₀ → B` is `DegreeOne.augmentationZeroLift`. -/
theorem aug_zeroIso (y : ULift.{max u v w x, max u w} p.P0) :
    aug p 0 ((zIso p).inv.hom y) = DegreeOne.augmentationZeroLift p y := by
  have h := (res p).augmentation_eq
  exact congrArg (fun f => f.hom y) h

/-- The inverse of `zIso` followed by `zIso` is the identity of `A[u_i]`. -/
theorem zIso_hom_inv (y : ULift.{max u v w x, max u w} p.P0) :
    (zIso p).hom.hom ((zIso p).inv.hom y) = y :=
  congrArg (fun f => f.hom y) (zIso p).inv_hom_id

/-- `zIso` followed by its inverse is the identity of `P₀`. -/
theorem zIso_inv_hom (y : term p 0) : (zIso p).inv.hom ((zIso p).hom.hom y) = y :=
  congrArg (fun f => f.hom y) (zIso p).hom_inv_id

/-- The inverse of `oIso` followed by `oIso` is the identity of `A[u_i, x_t]`. -/
theorem oIso_hom_inv (y : ULift.{max u v w x, max u w x} (DegreeOne.P1 p)) :
    (oIso p).hom.hom ((oIso p).inv.hom y) = y :=
  congrArg (fun f => f.hom y) (oIso p).inv_hom_id

/-- `oIso` followed by its inverse is the identity of `P₁`. -/
theorem oIso_inv_hom (y : term p 1) : (oIso p).inv.hom ((oIso p).hom.hom y) = y :=
  congrArg (fun f => f.hom y) (oIso p).hom_inv_id

/-! ### `P₁ = P₀[x_t]` -/

/-- `A[u_i] → P₀`, with the target read as the term of the resolution. -/
def zInv : ULift.{max u v w x, max u w} p.P0 →ₐ[p.A] term p 0 := (zIso p).inv.hom

/-- `zInv` is the inverse of `zIso`. -/
theorem zInv_apply (y : ULift.{max u v w x, max u w} p.P0) : zInv p y = (zIso p).inv.hom y := rfl

/-- The variable `u_i` of `P₀`. -/
def uVar (i : p.variableIndex) : term p 0 := (zIso p).inv.hom (ULift.up (X i))

/-- The generator `f_t` of `J₀`, as an element of `P₀`. -/
def rel (t : p.relationIndex) : term p 0 :=
  let : Algebra p.A p.B := p.algebraMap.toAlgebra
  (zIso p).inv.hom (ULift.up (p.presentation.relation t))

/-- The variable `x_t` of `P₁`. -/
def xOne (t : p.relationIndex) : term p 1 := (oIso p).inv.hom (ULift.up (X (Sum.inr t)))

/-- `A[u_i, x_t] → P₀[x_t]`. -/
def toPolyAux : DegreeOne.P1 p →ₐ[p.A] MvPolynomial p.relationIndex (term p 0) :=
  MvPolynomial.aeval (Sum.elim (fun i => C (uVar p i)) X)

/-- `P₁ → P₀[x_t]`. -/
def toPoly : term p 1 →+* MvPolynomial p.relationIndex (term p 0) :=
  (toPolyAux p).toRingHom.comp
    ((ULift.ringEquiv.toRingHom).comp (oIso p).hom.hom.toRingHom)

/-- `P₀[x_t] → P₁`, `x_t ↦ x_t` and `P₀ → P₁` the degeneracy `s₀`. -/
def ofPoly : MvPolynomial p.relationIndex (term p 0) →+* term p 1 :=
  eval₂Hom (degenMap p) (xOne p)

/-- `toPoly` sends the image in `P₁` of `y ∈ A[u_i, x_t]` to `toPolyAux y`. -/
theorem toPoly_oIso_inv (y : DegreeOne.P1 p) :
    toPoly p ((oIso p).inv.hom (ULift.up y)) = toPolyAux p y := by
  show toPolyAux p (ULift.ringEquiv ((oIso p).hom.hom ((oIso p).inv.hom (ULift.up y)))) = _
  rw [oIso_hom_inv]
  rfl

/-- `toPolyAux` sends `DegreeOne.degeneracyZero y`, for `y ∈ A[u_i]`, to the constant polynomial on
the image of `y` in `P₀`. -/
theorem toPolyAux_degeneracyZero (y : p.P0) :
    toPolyAux p (DegreeOne.degeneracyZero p y) = C (zInv p (ULift.up y)) := by
  have h : (toPolyAux p).comp (DegreeOne.degeneracyZero p) =
      (IsScalarTower.toAlgHom p.A (term p 0) (MvPolynomial p.relationIndex (term p 0))).comp
        ((zInv p).comp (ULift.algEquiv (R := p.A)).symm.toAlgHom) := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [toPolyAux, DegreeOne.degeneracyZero, uVar, MvPolynomial.algebraMap_eq]
    rfl
  exact congrArg (fun f => f y) h

/-- `toPoly` sends `s₀(r)` to the constant polynomial `C r`. -/
theorem toPoly_degenMap (r : term p 0) : toPoly p (degenMap p r) = C r := by
  rw [← zIso_inv_hom p r, degenMap_zeroIso]
  set z := (zIso p).hom.hom r
  show toPoly p ((oIso p).inv.hom (ULift.up (DegreeOne.degeneracyZero p z.down))) = _
  rw [toPoly_oIso_inv, toPolyAux_degeneracyZero]
  rfl

/-- `P₁ → A[u_i, x_t]`, with the source read as the term of the resolution. -/
def oInv : ULift.{max u v w x, max u w x} (DegreeOne.P1 p) →ₐ[p.A] term p 1 := (oIso p).inv.hom

/-- `toPolyAux` sends a constant `r ∈ A` to the constant polynomial on its image in `P₀`. -/
theorem toPolyAux_C (r : p.A) :
    toPolyAux p (C r) = C (algebraMap p.A (term p 0) r) := by
  rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes, MvPolynomial.algebraMap_apply]

/-- `toPolyAux` sends the variable `u_i` to the constant polynomial `C u_i`. -/
theorem toPolyAux_X_inl (i : p.variableIndex) :
    toPolyAux p (X (Sum.inl i)) = C (uVar p i) := by
  simp [toPolyAux]

/-- `toPolyAux` sends the variable `x_t` to the variable `X t`. -/
theorem toPolyAux_X_inr (t : p.relationIndex) : toPolyAux p (X (Sum.inr t)) = X t := by
  simp [toPolyAux]

/-- `toPoly` sends `oInv y` to `toPolyAux y`. -/
theorem toPoly_oInv (y : DegreeOne.P1 p) :
    toPoly p (oInv p (ULift.up y)) = toPolyAux p y :=
  toPoly_oIso_inv p y

/-- `toPoly` sends the variable `x_t` of `P₁` to the variable `X t`. -/
theorem toPoly_xOne (t : p.relationIndex) : toPoly p (xOne p t) = X t := by
  rw [xOne, toPoly_oIso_inv, toPolyAux_X_inr]

/-- A ring map `g : P₀[x_t] → P₀` retracting the constants sends `toPolyAux y` to the image in `P₀`
of `F y`, as soon as this holds on the variables, for `F : A[u_i, x_t] → A[u_i]`. -/
private theorem map_toPolyAux_eq (g : MvPolynomial p.relationIndex (term p 0) →+* term p 0)
    (F : DegreeOne.P1 p →ₐ[p.A] p.P0) (hC : ∀ r, g (C r) = r)
    (hu : ∀ i, F (X (Sum.inl i)) = X i)
    (hx : ∀ t, g (X t) = zInv p (ULift.ringEquiv.symm (F (X (Sum.inr t))))) (y : DegreeOne.P1 p) :
    g (toPolyAux p y) = zInv p (ULift.up (F y)) := by
  have h : g.comp (toPolyAux p).toRingHom =
      (zInv p).toRingHom.comp (ULift.ringEquiv.symm.toRingHom.comp F.toRingHom) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        toPolyAux_C, hC]
      rw [← MvPolynomial.algebraMap_eq, AlgHom.commutes]
      exact ((zInv p).commutes r).symm
    · rintro (i | t)
      · simp [toPolyAux_X_inl, hC, hu, uVar, zInv]
        rfl
      · simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
          RingHom.coe_coe, toPolyAux_X_inr]
        exact hx t
  exact congrArg (fun f => f y) h

/-- The constant coefficient of `toPolyAux y` is the image in `P₀` of `DegreeOne.faceZero y`. -/
theorem constantCoeff_toPolyAux (y : DegreeOne.P1 p) :
    constantCoeff (toPolyAux p y) = zInv p (ULift.up (DegreeOne.faceZero p y)) :=
  map_toPolyAux_eq p constantCoeff (DegreeOne.faceZero p) (constantCoeff_C _)
    (fun i => by simp [DegreeOne.faceZero]) (fun t => by simp [DegreeOne.faceZero]) y

/-- Evaluating `toPolyAux y` at `x_t ↦ f_t` gives the image in `P₀` of `DegreeOne.faceOne y`. -/
theorem eval_toPolyAux (y : DegreeOne.P1 p) :
    eval (rel p) (toPolyAux p y) = zInv p (ULift.up (DegreeOne.faceOne p y)) :=
  map_toPolyAux_eq p (eval (rel p)) (DegreeOne.faceOne p) eval_C
    (fun i => by simp [DegreeOne.faceOne]) (fun t => by simp [DegreeOne.faceOne, rel, zInv]; rfl) y

/-- The face map `d₀` sends `oInv y` to the image in `P₀` of `DegreeOne.faceZero y`. -/
theorem faceMap_zero_oInv (y : DegreeOne.P1 p) :
    faceMap p 0 (oInv p (ULift.up y)) = zInv p (ULift.up (DegreeOne.faceZero p y)) :=
  faceMap_zero_oneIso p (ULift.up y)

/-- The face map `d₁` sends `oInv y` to the image in `P₀` of `DegreeOne.faceOne y`. -/
theorem faceMap_one_oInv (y : DegreeOne.P1 p) :
    faceMap p 1 (oInv p (ULift.up y)) = zInv p (ULift.up (DegreeOne.faceOne p y)) :=
  faceMap_one_oneIso p (ULift.up y)

/-- Every `y ∈ P₁` is `oInv` of its image in `A[u_i, x_t]`. -/
theorem term_one_eq (y : term p 1) : y = oInv p (ULift.up ((oIso p).hom.hom y).down) :=
  (oIso_inv_hom p y).symm

/-- Under `P₁ = P₀[x_t]`, the face map `d₀` is the constant coefficient. -/
theorem constantCoeff_comp_toPoly : constantCoeff.comp (toPoly p) = faceMap p 0 := by
  ext y
  rw [term_one_eq p y, RingHom.comp_apply, toPoly_oInv, constantCoeff_toPolyAux,
    faceMap_zero_oInv]

/-- Under `P₁ = P₀[x_t]`, the face map `d₁` is evaluation at `x_t ↦ f_t`. -/
theorem eval_comp_toPoly : (eval (rel p)).comp (toPoly p) = faceMap p 1 := by
  ext y
  rw [term_one_eq p y, RingHom.comp_apply, toPoly_oInv, eval_toPolyAux, faceMap_one_oInv]

/-- Under `P₁ = P₀[x_t]`, the degeneracy `s₀` is the inclusion of constant polynomials. -/
theorem toPoly_comp_degenMap : (toPoly p).comp (degenMap p) = C :=
  RingHom.ext (toPoly_degenMap p)

/-- `ofPoly` sends `toPolyAux y` to `oInv y`. -/
theorem ofPoly_toPolyAux (y : DegreeOne.P1 p) :
    ofPoly p (toPolyAux p y) = oInv p (ULift.up y) := by
  have h : (ofPoly p).comp (toPolyAux p).toRingHom =
      (oInv p).toRingHom.comp (ULift.ringEquiv.symm.toRingHom) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe, RingHom.coe_coe,
        toPolyAux_C, ofPoly, eval₂Hom_C]
      exact (AlgHom.commutes _ r).trans ((oInv p).commutes r).symm
    · intro i
      cases i with
      | inl i =>
        simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
          RingHom.coe_coe, toPolyAux_X_inl, ofPoly, eval₂Hom_C, uVar]
        rw [degenMap_zeroIso]
        simp [DegreeOne.degeneracyZeroLift, DegreeOne.degeneracyZero, oInv]
        rfl
      | inr t =>
        simp [toPolyAux_X_inr, ofPoly, xOne, oInv]
        rfl
  exact congrArg (fun f => f y) h

/-- `ofPoly` is a left inverse of `toPoly`. -/
theorem ofPoly_toPoly (y : term p 1) : ofPoly p (toPoly p y) = y := by
  conv_lhs => rw [term_one_eq p y]
  rw [toPoly_oInv, ofPoly_toPolyAux, ← term_one_eq]

/-- `ofPoly` is a right inverse of `toPoly`. -/
theorem toPoly_ofPoly (q : MvPolynomial p.relationIndex (term p 0)) :
    toPoly p (ofPoly p q) = q := by
  have h : (toPoly p).comp (ofPoly p) = RingHom.id _ := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp [ofPoly, toPoly_degenMap]
    · intro t
      simp [ofPoly, toPoly_xOne]
  exact congrArg (fun f => f q) h

/-- **`P₁ = P₀[x_t]`**, compatibly with `s₀`, `d₀` and `d₁`. -/
def polyEquiv : term p 1 ≃+* MvPolynomial p.relationIndex (term p 0) :=
  RingEquiv.ofRingHom (toPoly p) (ofPoly p) (RingHom.ext (toPoly_ofPoly p))
    (RingHom.ext (ofPoly_toPoly p))

/-! ### The augmentations -/

/-- The augmentation `P₀ → B` sends `zInv y` to `DegreeOne.augmentationZeroLift y`. -/
theorem aug_zInv (y : ULift.{max u v w x, max u w} p.P0) :
    aug p 0 (zInv p y) = DegreeOne.augmentationZeroLift p y :=
  aug_zeroIso p y

/-- The augmentation `P₀ → B` is surjective. -/
theorem aug_zero_surjective : Function.Surjective (aug p 0) := by
  let : Algebra p.A p.B := p.algebraMap.toAlgebra
  intro b
  obtain ⟨z, hz⟩ := p.presentation.aeval_val_surjective b.down
  refine ⟨zInv p (ULift.up z), ?_⟩
  rw [aug_zInv]
  exact ULift.down_injective hz

/-- The augmentation `P₁ → B` is surjective. -/
theorem aug_one_surjective : Function.Surjective (aug p 1) := by
  intro b
  obtain ⟨r, rfl⟩ := aug_zero_surjective p b
  exact ⟨degenMap p r, by rw [← RingHom.comp_apply, aug_comp_degenMap]⟩

/-- The augmentation `P₀ → B` is surjective. -/
instance : Fact (Function.Surjective (aug p 0)) := ⟨aug_zero_surjective p⟩

/-- The augmentation `P₁ → B` is surjective. -/
instance : Fact (Function.Surjective (aug p 1)) := ⟨aug_one_surjective p⟩

/-- Each generator `f_t` lies in the kernel of the augmentation `P₀ → B`. -/
theorem aug_rel (t : p.relationIndex) : aug p 0 (rel p t) = 0 := by
  let : Algebra p.A p.B := p.algebraMap.toAlgebra
  show aug p 0 (zInv p (ULift.up (p.presentation.relation t))) = 0
  rw [aug_zInv]
  exact ULift.down_injective (p.presentation.aeval_val_relation t)

/-- The kernel `J₀` of the augmentation `P₀ → B` is generated by the `f_t`. -/
theorem span_rel : Ideal.span (Set.range (rel p)) = RingHom.ker (aug p 0) := by
  let : Algebra p.A p.B := p.algebraMap.toAlgebra
  apply le_antisymm
  · rw [Ideal.span_le]
    rintro _ ⟨t, rfl⟩
    exact aug_rel p t
  · intro r hr
    set g : p.P0 →+* term p 0 := (zInv p).toRingHom.comp ULift.ringEquiv.symm.toRingHom
    set z : p.P0 := ((zIso p).hom.hom r).down
    have hrz : r = g z := (zIso_inv_hom p r).symm
    have hz : z ∈ Ideal.span (Set.range p.presentation.relation) := by
      rw [p.presentation.span_range_relation_eq_ker, p.presentation.ker_eq_ker_aeval_val,
        RingHom.mem_ker]
      have : aug p 0 (g z) = 0 := by rwa [← hrz]
      change aug p 0 (zInv p (ULift.up z)) = 0 at this
      rw [aug_zInv] at this
      exact congrArg ULift.down this
    have hmap := Ideal.mem_map_of_mem g hz
    rw [Ideal.map_span, ← Set.range_comp] at hmap
    rwa [hrz]

/-- Under `P₁ = P₀[x_t]`, the augmentation of `P₁` is `polyAug` of the augmentation of `P₀`. -/
theorem polyAug_comp_toPoly :
    (polyAug (aug p 0) p.relationIndex).comp (toPoly p) = aug p 1 := by
  rw [← comp_constantCoeff, RingHom.comp_assoc, constantCoeff_comp_toPoly, aug_comp_faceMap]

/-- The augmentation of `P₁` composed with `ofPoly` is `polyAug` of the augmentation of `P₀`. -/
theorem aug_comp_ofPoly : (aug p 1).comp (ofPoly p) = polyAug (aug p 0) p.relationIndex := by
  rw [← polyAug_comp_toPoly, RingHom.comp_assoc]
  ext q
  · simp [toPoly_ofPoly]
  · simp [toPoly_ofPoly]

/-! ### Transport of the tensor-kernel model -/

/-- `Tor₂^{P₁}(B, B) ≅ Tor₂^{P₀[x_t]}(B, B)` along `P₁ = P₀[x_t]`. -/
def kerEquiv :
    mulKernel (aug p 1) ≃ₗ[target p] mulKernel (polyAug (aug p 0) p.relationIndex) :=
  LinearEquiv.ofLinear (mulKernelMap (toPoly p) (polyAug_comp_toPoly p))
    (mulKernelMap (ofPoly p) (aug_comp_ofPoly p))
    (by
      ext k
      simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.id_coe, id_eq]
      rw [← mulKernelMap_comp, mulKernelMap_congr (RingHom.ext (toPoly_ofPoly p)) _
        (RingHom.comp_id _), mulKernelMap_id])
    (by
      ext k
      simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.id_coe, id_eq]
      rw [← mulKernelMap_comp, mulKernelMap_congr (RingHom.ext (ofPoly_toPoly p)) _
        (RingHom.comp_id _), mulKernelMap_id])

/-- The variable `x_t` as an element of `J₁ = Ker(P₁ → B)`. -/
def xJ (t : p.relationIndex) : RingHom.ker (aug p 1) :=
  ⟨xOne p t, by
    rw [RingHom.mem_ker, ← polyAug_comp_toPoly, RingHom.comp_apply, toPoly_xOne]
    simp [polyAug]⟩

/-- `f_t` as an element of `J₀ = Ker(P₀ → B)`. -/
def relJ (t : p.relationIndex) : RingHom.ker (aug p 0) := ⟨rel p t, aug_rel p t⟩

/-- `s₀ : J₀ → J₁`. -/
def degenJ : RingHom.ker (aug p 0) →+ RingHom.ker (aug p 1) :=
  kerMap (degenMap p) (aug_comp_degenMap p)

/-- `ofPoly` sends the variable `x_t` of `Ker(P₀[x_t] → B)` to `x_t ∈ J₁`. -/
theorem kerMap_ofPoly_xVar (t : p.relationIndex) :
    kerMap (ofPoly p) (aug_comp_ofPoly p) (xVar t) = xJ p t :=
  Subtype.ext (by simp [ofPoly, xJ])

/-- `ofPoly` sends the constant `a ∈ J₀` of `Ker(P₀[x_t] → B)` to `s₀(a) ∈ J₁`. -/
theorem kerMap_ofPoly_constIdeal (a : RingHom.ker (aug p 0)) :
    kerMap (ofPoly p) (aug_comp_ofPoly p) (constIdeal (T := p.relationIndex) a) = degenJ p a :=
  Subtype.ext (by simp [ofPoly, degenJ])

/-- `toPoly` sends `x_t ∈ J₁` to the variable `x_t` of `Ker(P₀[x_t] → B)`. -/
theorem kerMap_toPoly_xJ (t : p.relationIndex) :
    kerMap (toPoly p) (polyAug_comp_toPoly p) (xJ p t) = xVar t :=
  Subtype.ext (by simp [xJ, toPoly_xOne])

/-- `toPoly` sends `s₀(a) ∈ J₁`, for `a ∈ J₀`, to the constant `a` of `Ker(P₀[x_t] → B)`. -/
theorem kerMap_toPoly_degenJ (a : RingHom.ker (aug p 0)) :
    kerMap (toPoly p) (polyAug_comp_toPoly p) (degenJ p a) = constIdeal a :=
  Subtype.ext (by simp [degenJ, toPoly_degenMap])

/-! ### The decomposition of `Tor₂^{P₁}(B, B)` -/

/-- **The decomposition of `Tor₂^{P₁}(B, B)` for the explicit resolution**:

`Tor₂^{P₁}(B, B) = ∧²_B(⨁_{t ∈ T} B) ⊕ ⨁_{t ∈ T} J₀/J₀² ⊕ Tor₂^{P₀}(B, B)`

as `B`-modules, `Tor₂` read in the tensor-kernel model. The correspondences are
`decomposition_wedge`, `decomposition_mixed` and `decomposition_degen`. -/
@[stacks 09D6 "the decomposition Tor₂^{P₁}(B, B) = ∧²(⨁_{t ∈ T} B) ⊕ ⨁_{t ∈ T} J₀/J₀² ⊕ \
  Tor₂^{P₀}(B, B) for the resolution P_• of Example 09D4, as B-modules, with Tor₂^{P_n}(B, B) read \
  as Ker(J_n ⊗_{P_n} J_n → J_n²) (the remark's own identification, \
  Stacks.Cotangent.torTwoSelfIsoMulKernel); the correspondences are decomposition_wedge, \
  decomposition_mixed and decomposition_degen"]
def decomposition :
    (⋀[target p]^2 (p.relationIndex →₀ target p) ×
        (p.relationIndex →₀ (RingHom.ker (aug p 0)).Cotangent) × mulKernel (aug p 0)) ≃ₗ[target p]
      mulKernel (aug p 1) :=
  polyDecomposition.trans (kerEquiv p).symm

/-- The inverse of `kerEquiv` is induced by `ofPoly`. -/
theorem kerEquiv_symm_apply (k : mulKernel (polyAug (aug p 0) p.relationIndex)) :
    (kerEquiv p).symm k = mulKernelMap (ofPoly p) (aug_comp_ofPoly p) k := rfl

/-- `kerEquiv` is induced by `toPoly`. -/
theorem kerEquiv_apply (k : mulKernel (aug p 1)) :
    kerEquiv p k = mulKernelMap (toPoly p) (polyAug_comp_toPoly p) k := rfl

/-- The basis element `x_t ∧ x_{t'}` of `∧²(⨁_T B)` corresponds to
`x_t ⊗ x_{t'} - x_{t'} ⊗ x_t`. -/
@[stacks 09D6 "the basis element x_t ∧ x_{t'} of the first summand corresponds to \
  x_t ⊗ x_{t'} - x_{t'} ⊗ x_t in J₁ ⊗_{P₁} J₁"]
theorem decomposition_wedge (t t' : p.relationIndex) :
    decomposition p (wedgeBilin (Finsupp.single t 1) (Finsupp.single t' 1), 0, 0) =
      antisymm (xJ p t) (xJ p t') := by
  rw [decomposition, LinearEquiv.trans_apply, polyDecomposition_wedge, kerEquiv_symm_apply,
    mulKernelMap_antisymm, kerMap_ofPoly_xVar, kerMap_ofPoly_xVar]

/-- For `f ∈ J₀`, the element `x_t ⊗ f̄` of `⨁_T J₀/J₀²` corresponds to
`x_t ⊗ s₀(f) - s₀(f) ⊗ x_t`. -/
@[stacks 09D6 "for f ∈ J₀ the element x_t ⊗ f̄ of the second summand corresponds to \
  x_t ⊗ s₀(f) - s₀(f) ⊗ x_t in J₁ ⊗_{P₁} J₁"]
theorem decomposition_mixed (t : p.relationIndex) (f : RingHom.ker (aug p 0)) :
    decomposition p (0, Finsupp.single t ((RingHom.ker (aug p 0)).toCotangent f), 0) =
      antisymm (xJ p t) (degenJ p f) := by
  rw [decomposition, LinearEquiv.trans_apply, polyDecomposition_mixed, kerEquiv_symm_apply,
    mulKernelMap_antisymm, kerMap_ofPoly_xVar, kerMap_ofPoly_constIdeal]

/-- The map `Tor₂^{P₀}(B, B) → Tor₂^{P₁}(B, B)` onto the last summand is given by `s₀`. -/
@[stacks 09D6 "the map Tor₂^{P₀}(B, B) → Tor₂^{P₁}(B, B) onto the last summand is given by s₀"]
theorem decomposition_degen (k : mulKernel (aug p 0)) :
    decomposition p (0, 0, k) = mulKernelMap (degenMap p) (aug_comp_degenMap p) k := by
  rw [decomposition, LinearEquiv.trans_apply, polyDecomposition_degen, kerEquiv_symm_apply,
    ← mulKernelMap_comp]
  exact mulKernelMap_congr (RingHom.ext fun r => by simp [ofPoly, degenMap]) _ _ k

/-! ### The alternating face `d₀ - d₁` -/

/-- **`d₀ - d₁ : Tor₂^{P₁}(B, B) → Tor₂^{P₀}(B, B)`**, for the actual face maps of the
resolution. -/
def face : mulKernel (aug p 1) →ₗ[target p] mulKernel (aug p 0) :=
  mulKernelMap (faceMap p 0) (aug_comp_faceMap p 0) -
    mulKernelMap (faceMap p 1) (aug_comp_faceMap p 1)

/-- Under `kerEquiv`, `d₀ - d₁` is `polyFace`. -/
theorem face_eq (k : mulKernel (aug p 1)) : face p k = polyFace (aug_rel p) (kerEquiv p k) := by
  rw [face, polyFace, kerEquiv_apply, LinearMap.sub_apply, LinearMap.sub_apply,
    ← mulKernelMap_comp, ← mulKernelMap_comp]
  rw [mulKernelMap_congr (constantCoeff_comp_toPoly p).symm _ _,
    mulKernelMap_congr (eval_comp_toPoly p).symm _ _]

/-- `d₀ - d₁` vanishes on the summand `Tor₂^{P₀}(B, B)`. -/
@[stacks 09D6 "d₀ - d₁ : Tor₂^{P₁}(B, B) → Tor₂^{P₀}(B, B) is zero on the last summand"]
theorem face_degen (k : mulKernel (aug p 0)) :
    face p (mulKernelMap (degenMap p) (aug_comp_degenMap p) k) = 0 := by
  rw [← decomposition_degen, decomposition, LinearEquiv.trans_apply, face_eq,
    LinearEquiv.apply_symm_apply, polyDecomposition_degen, polyFace_degen]

/-- `d₀ - d₁` sends `x_t ⊗ f̄` to `f ⊗ f_t - f_t ⊗ f`. -/
@[stacks 09D6 "d₀ - d₁ maps x_t ⊗ f̄ to f ⊗ f_t - f_t ⊗ f"]
theorem face_mixed (t : p.relationIndex) (f : RingHom.ker (aug p 0)) :
    face p (antisymm (xJ p t) (degenJ p f)) = antisymm f (relJ p t) := by
  rw [face_eq, kerEquiv_apply, mulKernelMap_antisymm, kerMap_toPoly_xJ, kerMap_toPoly_degenJ,
    polyFace_mixed]
  rfl

/-- `d₀ - d₁` sends `x_t ∧ x_{t'}` to `f_{t'} ⊗ f_t - f_t ⊗ f_{t'}`. -/
@[stacks 09D6 "d₀ - d₁ maps x_t ∧ x_{t'} to f_{t'} ⊗ f_t - f_t ⊗ f_{t'}"]
theorem face_wedge (t t' : p.relationIndex) :
    face p (antisymm (xJ p t) (xJ p t')) = antisymm (relJ p t') (relJ p t) := by
  rw [face_eq, kerEquiv_apply, mulKernelMap_antisymm, kerMap_toPoly_xJ, kerMap_toPoly_xJ,
    polyFace_wedge]
  rfl

/-- **The image of `d₀ - d₁` is the image of `∧²_B(J₀/J₀²) → Tor₂^{P₀}(B, B)`.** -/
theorem range_face :
    LinearMap.range (face p) = LinearMap.range (wedgeAntisymm (φ := aug p 0)) := by
  have h : face p = polyFace (aug_rel p) ∘ₗ (kerEquiv p).toLinearMap :=
    LinearMap.ext (face_eq p)
  rw [h, LinearMap.range_comp, LinearEquiv.range, Submodule.map_top,
    range_polyFace (aug_rel p) (span_rel p)]

/-- **Stacks 09D6, the exact sequence** `∧²_B(J₀/J₀²) → Tor₂^{P₀}(B, B) → Coker(d₀ - d₁) → 0`
for the resolution of 09D4: exactness at `Tor₂^{P₀}(B, B)`; the map onto the cokernel is
surjective by construction. -/
theorem exact_wedgeAntisymm_face :
    Function.Exact (wedgeAntisymm (φ := aug p 0)) (LinearMap.range (face p)).mkQ := by
  rw [LinearMap.exact_iff, Submodule.ker_mkQ, range_face]

/-! ### The decomposition read on Mathlib's `Tor` -/

/-- **The decomposition of `Tor₂^{P₁}(B, B)`, on Mathlib's `Tor'`**: for the
`P₁`-algebra `B` (through the augmentation),

`Tor₂^{P₁}(B, B) ≅ ∧²_B(⨁_T B) ⊕ ⨁_T J₀/J₀² ⊕ Tor₂^{P₀}(B, B)`,

an additive isomorphism which is `P₁`-linear for `P₁` acting on the right through `P₁ → B`
(`torTwoDecomposition_smul`). It is `Stacks.Cotangent.torTwoSelfIsoMulKernel` followed by the
inverse of `decomposition`. -/
@[stacks 09D6 "the decomposition of Tor₂^{P₁}(B, B) read on Mathlib's Tor' itself"]
def torTwoDecomposition :
    letI : Algebra (term p 1) (target p) := (aug p 1).toAlgebra
    ((CategoryTheory.Tor' (ModuleCat.{max u v w x} (term p 1)) 2).obj
        (ModuleCat.of (term p 1) (target p))).obj (ModuleCat.of (term p 1) (target p)) ≃+
      (⋀[target p]^2 (p.relationIndex →₀ target p) ×
        (p.relationIndex →₀ (RingHom.ker (aug p 0)).Cotangent) × mulKernel (aug p 0)) :=
  let : Algebra (term p 1) (target p) := (aug p 1).toAlgebra
  (torTwoSelfIsoMulKernel (aug_one_surjective p)).toLinearEquiv.toAddEquiv.trans
    (decomposition p).symm.toAddEquiv

/-- `torTwoDecomposition` is linear for `P₁` acting on the target through `P₁ → B`. -/
theorem torTwoDecomposition_smul (r : term p 1)
    (t : letI : Algebra (term p 1) (target p) := (aug p 1).toAlgebra
      ((CategoryTheory.Tor' (ModuleCat.{max u v w x} (term p 1)) 2).obj
        (ModuleCat.of (term p 1) (target p))).obj (ModuleCat.of (term p 1) (target p))) :
    torTwoDecomposition p (r • t) = aug p 1 r • torTwoDecomposition p t := by
  let : Algebra (term p 1) (target p) := (aug p 1).toAlgebra
  show (decomposition p).symm ((torTwoSelfIsoMulKernel (aug_one_surjective p)).toLinearEquiv
    (r • t)) = aug p 1 r • (decomposition p).symm
      ((torTwoSelfIsoMulKernel (aug_one_surjective p)).toLinearEquiv t)
  have h1 : (torTwoSelfIsoMulKernel (aug_one_surjective p)).toLinearEquiv (r • t) =
      r • (torTwoSelfIsoMulKernel (aug_one_surjective p)).toLinearEquiv t :=
    LinearEquiv.map_smul _ r t
  rw [h1]
  exact (congrArg (decomposition p).symm (algebraMap_smul_mulKernel (φ := aug p 1) r
    ((torTwoSelfIsoMulKernel (aug_one_surjective p)).toLinearEquiv t :
      mulKernel (aug p 1))).symm).trans (LinearEquiv.map_smul _ _ _)

end Stacks.Cotangent.TorTwo.Explicit

end
