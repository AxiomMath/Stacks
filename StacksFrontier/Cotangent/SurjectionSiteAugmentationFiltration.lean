public import Mathlib.RingTheory.TensorProduct.MvPolynomial
public import StacksFrontier.Cotangent.PolynomialAlgebraSiteCoefficientChange

/-!
# The sheaf `Ō = 𝒪 ⊗_A B̲` on the polynomial site, and the powers of its augmentation ideal

Let `A → B` be a ring map and let `C_{B/A}` be the polynomial site, on the small model
`CommAlgCat.smallBoundedPolynomialSite A B κ` of its cardinality-restricted form. This file
builds the presheaf

`Ō = 𝒪 ⊗_A B̲`

of commutative `B`-algebras on that site — for `A → B` surjective with kernel `I` this is the
`𝒪/I𝒪` of the proof of [Stacks, Tag 08RF] — together with its augmentation `Ō → B̲`, the
augmentation ideal `𝒦 = ker(Ō → B̲)`, and the decreasing filtration

`… ⊆ 𝒦³ ⊆ 𝒦² ⊆ 𝒦 ⊆ Ō`

by subpresheaves of `B`-modules.

Over an object `(P, α)` of the small model, with `P = A[S]` and `α` sending the variable `X_s` to
`g s ∈ B`, the sections of `Ō` are the polynomial ring `B[S]` and the augmentation is evaluation
at `g`, so the sections of `𝒦` are the ideal generated by the elements `X_s - g s`. That
description is `CommAlgCat.smallPolynomialQuotientAlgEquiv` and
`CommAlgCat.smallPolynomialQuotientAug_eq` below, and it is what makes the graded pieces of the
filtration the symmetric powers of `Ω`.

## Main definitions

* `Stacks.submoduleFunctor`: a diagram of modules together with a stable choice of submodule of
  each of its values, as a diagram of modules.
* `CommAlgCat.baseChangeFunctor`: base change of commutative algebras along a ring map, as a
  functor `CommAlgCat A ⥤ CommAlgCat S`.
* `CommAlgCat.smallPolynomialQuotientAlgebra`: the presheaf `Ō = 𝒪 ⊗_A B̲` of commutative
  `B`-algebras.
* `CommAlgCat.smallPolynomialQuotientAug`: its augmentation to `B` over an object.
* `CommAlgCat.smallPolynomialAugmentationIdeal`: the ideal `𝒦(U) = ker(Ō(U) → B)`.
* `CommAlgCat.smallPolynomialQuotientModule`: `Ō` read as a presheaf of `B`-modules.
* `CommAlgCat.smallPolynomialAugmentationIdealPow`: `𝒦ⁿ`, as a presheaf of `B`-modules.
* `CommAlgCat.smallPolynomialAugmentationIdealPowIncl` and
  `CommAlgCat.smallPolynomialAugmentationIdealPowι`: the inclusions `𝒦ⁿ⁺¹ ⊆ 𝒦ⁿ` and `𝒦ⁿ ⊆ Ō`.

## Main results

* `CommAlgCat.smallPolynomialQuotientAlgEquiv` and `CommAlgCat.smallPolynomialQuotientAug_eq`:
  the sections of `Ō` over an object of the small model are a polynomial ring over `B` on the
  same variables, with the augmentation evaluation at the point naming the object.

## Implementation notes

Base change is used rather than the quotient `𝒪/I𝒪` because `B ⊗_A P` is functorial in `P` with
no hypothesis on `A → B` and carries its `B`-algebra structure for free; for a surjective `A → B`
with kernel `I` the two agree. Nothing in this file needs `A → B` to be surjective.

### Where this sits in the proof of Theorem 08RF

The gap audit in the module docstring of `StacksFrontier.Cotangent.QuillenSpectralSequence` lists
five absent ingredients of the proof of [Stacks, Tag 08RF]. This file and its two companions,
`StacksFrontier.Cotangent.SurjectionSiteAugmentationGraded` and
`StacksFrontier.Cotangent.SurjectionSiteAugmentationSections`, supply the first: the presheaves `Ō`,
`𝒦` and `𝒦ⁿ` on the small model of `C_{B/A}`, in the universe shape
`Cᵒᵖ ⥤ ModuleCat.{u} B` that the 08RD/08RF machinery of this library works in, together with
their graded pieces and the description of their sections as a polynomial ring over `B`.

What is still absent is, in order of depth: the identification `𝒦ᵏ/𝒦ᵏ⁺¹ ≅ Sym^k_{B̲}(Ω)` as
presheaves; the identification of `H_*(C_{B/A}, Ō)` with `Tor^A_*(B, B)`; and the convergence
vanishing — for every `k` there is an `N` with `H_i(C_{B/A}, 𝒦ⁿ) = 0` for `i < k` and `n ≥ N`
— which is what makes the filtration of the complex degreewise finite after canonical
truncation. That last one is not a formal consequence of the vanishing of the graded pieces: a
filtered complex which is degreewise the direct sum of its graded pieces can have all its graded
pieces acyclic and still have nonzero cohomology (take `Kⁿ = ⨁_{p ≥ 0} B` in degrees `0, 1`
with `d(e_p) = f_p - f_{p+1}` and `F^m` the sum over `p ≥ m`: every `gr^p` is `B = B`, and
`H¹ = B`). It is the step the source proves from [Stacks, Tag 08RE] through the change of rings
spectral sequence of [Stacks, Tag 068F] and the truncation argument of [Stacks, Tag 08Q2].

## References

* [Stacks Project, Tag 08RF](https://stacks.math.columbia.edu/tag/08RF)
* [Stacks Project, Tag 08PR](https://stacks.math.columbia.edu/tag/08PR)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

open scoped TensorProduct

universe u v

namespace Stacks

/-! ### Subdiagrams of a diagram of modules -/

section Subfunctor

variable {D : Type*} [Category D] {R : Type u} [Ring R]

/-- A diagram of modules together with a choice of submodule of each of its values which the
transition maps respect is again a diagram of modules. -/
def submoduleFunctor (F : D ⥤ ModuleCat.{u} R) (S : ∀ X : D, Submodule R ↥(F.obj X))
    (hS : ∀ {X Y : D} (f : X ⟶ Y) (x : ↥(F.obj X)), x ∈ S X → (F.map f).hom x ∈ S Y) :
    D ⥤ ModuleCat.{u} R where
  obj X := ModuleCat.of R ↥(S X)
  map f := ModuleCat.ofHom ((F.map f).hom.restrict (fun x hx => hS f x hx))
  map_id X := ModuleCat.hom_ext (LinearMap.ext fun x => Subtype.ext (by
    change (F.map (𝟙 X)).hom (x : ↥(F.obj X)) = (x : ↥(F.obj X))
    rw [F.map_id]
    rfl))
  map_comp := fun {X _ _} f g => ModuleCat.hom_ext (LinearMap.ext fun x => Subtype.ext (by
    change (F.map (f ≫ g)).hom (x : ↥(F.obj X)) = _
    rw [F.map_comp]
    rfl))

/-- The inclusion of one subdiagram of a diagram of modules into a larger one. -/
def submoduleFunctorIncl (F : D ⥤ ModuleCat.{u} R) (S T : ∀ X : D, Submodule R ↥(F.obj X))
    (hS : ∀ {X Y : D} (f : X ⟶ Y) (x : ↥(F.obj X)), x ∈ S X → (F.map f).hom x ∈ S Y)
    (hT : ∀ {X Y : D} (f : X ⟶ Y) (x : ↥(F.obj X)), x ∈ T X → (F.map f).hom x ∈ T Y)
    (hle : ∀ X : D, S X ≤ T X) :
    submoduleFunctor F S hS ⟶ submoduleFunctor F T hT where
  app X := ModuleCat.ofHom (Submodule.inclusion (hle X))
  naturality _ _ _ := ModuleCat.hom_ext (LinearMap.ext fun _ => Subtype.ext rfl)

/-- The inclusion of a subdiagram of a diagram of modules into the diagram. -/
def submoduleFunctorι (F : D ⥤ ModuleCat.{u} R) (S : ∀ X : D, Submodule R ↥(F.obj X))
    (hS : ∀ {X Y : D} (f : X ⟶ Y) (x : ↥(F.obj X)), x ∈ S X → (F.map f).hom x ∈ S Y) :
    submoduleFunctor F S hS ⟶ F where
  app X := ModuleCat.ofHom (S X).subtype
  naturality _ _ _ := ModuleCat.hom_ext (LinearMap.ext fun _ => rfl)

end Subfunctor

end Stacks

namespace CommAlgCat

/-! ### Base change of commutative algebras -/

section BaseChange

variable (A : Type u) [CommRing A] (S : Type u) [CommRing S] [Algebra A S]

/-- **Base change of commutative algebras** along `A → S`, as a functor: `P ↦ S ⊗_A P`. -/
def baseChangeFunctor : CommAlgCat.{u} A ⥤ CommAlgCat.{u} S where
  obj P := CommAlgCat.of S (S ⊗[A] (P : Type u))
  map f := CommAlgCat.ofHom (Algebra.TensorProduct.map (AlgHom.id S S) f.hom)
  map_id P := by
    simp only [hom_id, Algebra.TensorProduct.map_id]
    rfl
  map_comp f g := by
    simp only [hom_comp]
    rw [Algebra.TensorProduct.map_id_comp, ofHom_comp]

/-- Base change of a map `f : P → Q` sends `s ⊗ p` to `s ⊗ f p`. -/
lemma baseChangeFunctor_map_tmul {P Q : CommAlgCat.{u} A} (f : P ⟶ Q) (s : S) (p : P) :
    ((baseChangeFunctor A S).map f).hom (s ⊗ₜ[A] p) = s ⊗ₜ[A] f.hom p :=
  rfl

end BaseChange

/-! ### The presheaf `Ō` and its augmentation ideal -/

section Filtration

variable (A : Type u) [CommRing A] (B : CommAlgCat.{u} A) (κ : Cardinal.{u})

/-- **The presheaf `Ō = 𝒪 ⊗_A B̲`** of commutative `B`-algebras on the small model of the
polynomial site: the base change along `A → B` of the tautological presheaf `𝒪`. For a
surjective `A → B` with kernel `I` this is the `𝒪/I𝒪` of the proof of [Stacks, Tag 08RF]. -/
def smallPolynomialQuotientAlgebra :
    (smallBoundedPolynomialSite A B κ)ᵒᵖ ⥤ CommAlgCat.{u} (B : Type u) :=
  smallSiteToOver A B κ ⋙ Over.forget B ⋙ baseChangeFunctor A (B : Type u)

/-- The augmentation of the object of the site over which sections are taken, as an
`A`-algebra map. -/
abbrev smallSiteAug (X : ((smallBoundedPolynomialSite A B κ)ᵒᵖ)) :
    (((smallSiteToOver A B κ).obj X).left : Type u) →ₐ[A] (B : Type u) :=
  (((smallSiteToOver A B κ).obj X).hom).hom

/-- The augmentations of the objects of the site are compatible with the transition maps. -/
lemma smallSiteAug_naturality {X Y : ((smallBoundedPolynomialSite A B κ)ᵒᵖ)} (f : X ⟶ Y)
    (p : (((smallSiteToOver A B κ).obj X).left : Type u)) :
    smallSiteAug A B κ Y (((smallSiteToOver A B κ).map f).left.hom p) =
      smallSiteAug A B κ X p :=
  congrArg (fun g : ((smallSiteToOver A B κ).obj X).left ⟶ B => g.hom p)
    (Over.w ((smallSiteToOver A B κ).map f))

/-- **The augmentation `Ō → B`** over an object of the site: the `B`-algebra map `B ⊗_A P → B`
determined by the augmentation `α : P → B` of that object. -/
def smallPolynomialQuotientAug (X : ((smallBoundedPolynomialSite A B κ)ᵒᵖ)) :
    ((smallPolynomialQuotientAlgebra A B κ).obj X : Type u) →ₐ[(B : Type u)] (B : Type u) :=
  AlgHom.liftEquiv A (B : Type u) (((smallSiteToOver A B κ).obj X).left : Type u) (B : Type u)
    (smallSiteAug A B κ X)

/-- The augmentation `Ō → B` sends `b ⊗ p` to `b • α p`, for `α` the augmentation of the object. -/
lemma smallPolynomialQuotientAug_tmul (X : ((smallBoundedPolynomialSite A B κ)ᵒᵖ))
    (b : (B : Type u)) (p : (((smallSiteToOver A B κ).obj X).left : Type u)) :
    smallPolynomialQuotientAug A B κ X (b ⊗ₜ[A] p) = b • smallSiteAug A B κ X p :=
  rfl

/-- The augmentation is natural: `Ō → B̲` is a map of presheaves. -/
lemma smallPolynomialQuotientAug_comp {X Y : ((smallBoundedPolynomialSite A B κ)ᵒᵖ)} (f : X ⟶ Y) :
    (smallPolynomialQuotientAug A B κ Y).comp
        ((smallPolynomialQuotientAlgebra A B κ).map f).hom =
      smallPolynomialQuotientAug A B κ X := by
  refine Algebra.TensorProduct.ext_ring (AlgHom.ext fun p => ?_)
  exact congrArg ((1 : (B : Type u)) • ·) (smallSiteAug_naturality A B κ f p)

/-- The augmentation is natural, read on a section. -/
lemma smallPolynomialQuotientAug_map {X Y : ((smallBoundedPolynomialSite A B κ)ᵒᵖ)} (f : X ⟶ Y)
    (x : ((smallPolynomialQuotientAlgebra A B κ).obj X : Type u)) :
    smallPolynomialQuotientAug A B κ Y
        (((smallPolynomialQuotientAlgebra A B κ).map f).hom x) =
      smallPolynomialQuotientAug A B κ X x :=
  DFunLike.congr_fun (smallPolynomialQuotientAug_comp A B κ f) x

/-- **The augmentation ideal `𝒦 = ker(Ō → B̲)`** over an object of the site. -/
def smallPolynomialAugmentationIdeal (X : ((smallBoundedPolynomialSite A B κ)ᵒᵖ)) :
    Ideal ((smallPolynomialQuotientAlgebra A B κ).obj X : Type u) :=
  RingHom.ker (smallPolynomialQuotientAug A B κ X : _ →+* (B : Type u))

/-- A section of `Ō` lies in the augmentation ideal exactly when its augmentation vanishes. -/
lemma mem_smallPolynomialAugmentationIdeal {X : ((smallBoundedPolynomialSite A B κ)ᵒᵖ)}
    (x : ((smallPolynomialQuotientAlgebra A B κ).obj X : Type u)) :
    x ∈ smallPolynomialAugmentationIdeal A B κ X ↔
      smallPolynomialQuotientAug A B κ X x = 0 :=
  RingHom.mem_ker

/-- The transition maps of `Ō` carry the augmentation ideal into the augmentation ideal. -/
lemma smallPolynomialAugmentationIdeal_map_le
    {X Y : ((smallBoundedPolynomialSite A B κ)ᵒᵖ)} (f : X ⟶ Y) :
    Ideal.map (((smallPolynomialQuotientAlgebra A B κ).map f).hom : _ →+* _)
        (smallPolynomialAugmentationIdeal A B κ X) ≤
      smallPolynomialAugmentationIdeal A B κ Y := by
  rw [Ideal.map_le_iff_le_comap]
  intro x hx
  rw [Ideal.mem_comap, mem_smallPolynomialAugmentationIdeal]
  exact (smallPolynomialQuotientAug_map A B κ f x).trans
    ((mem_smallPolynomialAugmentationIdeal A B κ x).1 hx)

/-- The transition maps of `Ō` carry the `n`-th power of the augmentation ideal into the `n`-th
power of the augmentation ideal. -/
lemma smallPolynomialAugmentationIdealPow_map_mem (n : ℕ)
    {X Y : ((smallBoundedPolynomialSite A B κ)ᵒᵖ)} (f : X ⟶ Y)
    (x : ((smallPolynomialQuotientAlgebra A B κ).obj X : Type u))
    (hx : x ∈ smallPolynomialAugmentationIdeal A B κ X ^ n) :
    ((smallPolynomialQuotientAlgebra A B κ).map f).hom x ∈
      smallPolynomialAugmentationIdeal A B κ Y ^ n := by
  have h : Ideal.map (((smallPolynomialQuotientAlgebra A B κ).map f).hom : _ →+* _)
      (smallPolynomialAugmentationIdeal A B κ X ^ n) ≤
      smallPolynomialAugmentationIdeal A B κ Y ^ n := by
    rw [Ideal.map_pow]
    exact Ideal.pow_right_mono (smallPolynomialAugmentationIdeal_map_le A B κ f) n
  exact h (Ideal.mem_map_of_mem _ hx)

/-- **`Ō` read as a presheaf of `B`-modules.**

This is `@[reducible]` on purpose: its sections are definitionally those of
`CommAlgCat.smallPolynomialQuotientAlgebra`, and the ideals of that ring are what the filtration
below is built from, so instance search has to see through it. -/
abbrev smallPolynomialQuotientModule :
    (smallBoundedPolynomialSite A B κ)ᵒᵖ ⥤ ModuleCat.{u} (B : Type u) :=
  { obj := fun X =>
      ModuleCat.of (B : Type u) ((smallPolynomialQuotientAlgebra A B κ).obj X : Type u)
    map := fun f =>
      ModuleCat.ofHom (((smallPolynomialQuotientAlgebra A B κ).map f).hom.toLinearMap)
    map_id := fun X => ModuleCat.hom_ext (LinearMap.ext fun x => by
      change ((smallPolynomialQuotientAlgebra A B κ).map (𝟙 X)).hom x = x
      rw [(smallPolynomialQuotientAlgebra A B κ).map_id]
      rfl)
    map_comp := fun {X _ _} f g => ModuleCat.hom_ext (LinearMap.ext fun x => by
      change ((smallPolynomialQuotientAlgebra A B κ).map (f ≫ g)).hom x = _
      rw [(smallPolynomialQuotientAlgebra A B κ).map_comp]
      rfl) }

/-- The `n`-th power of the augmentation ideal, as a `B`-submodule of the sections of `Ō`. -/
def smallPolynomialAugmentationIdealPowSubmodule (n : ℕ)
    (X : ((smallBoundedPolynomialSite A B κ)ᵒᵖ)) :
    Submodule (B : Type u) ↥((smallPolynomialQuotientModule A B κ).obj X) :=
  Submodule.restrictScalars (B : Type u) (smallPolynomialAugmentationIdeal A B κ X ^ n)

/-- The filtration by powers of the augmentation ideal is decreasing. -/
lemma smallPolynomialAugmentationIdealPowSubmodule_antitone {m n : ℕ} (h : m ≤ n)
    (X : ((smallBoundedPolynomialSite A B κ)ᵒᵖ)) :
    smallPolynomialAugmentationIdealPowSubmodule A B κ n X ≤
      smallPolynomialAugmentationIdealPowSubmodule A B κ m X :=
  fun _ hx => Ideal.pow_le_pow_right h hx

/-- **The filtration `𝒦ⁿ` of `Ō`**: the `n`-th power of the augmentation ideal, as a presheaf of
`B`-modules on the small model of the polynomial site. -/
def smallPolynomialAugmentationIdealPow (n : ℕ) :
    (smallBoundedPolynomialSite A B κ)ᵒᵖ ⥤ ModuleCat.{u} (B : Type u) :=
  Stacks.submoduleFunctor (smallPolynomialQuotientModule A B κ)
    (smallPolynomialAugmentationIdealPowSubmodule A B κ n)
    (fun f x hx => smallPolynomialAugmentationIdealPow_map_mem A B κ n f x hx)

/-- The inclusion `𝒦ⁿ⁺¹ ⊆ 𝒦ⁿ`. -/
def smallPolynomialAugmentationIdealPowIncl (n : ℕ) :
    smallPolynomialAugmentationIdealPow A B κ (n + 1) ⟶
      smallPolynomialAugmentationIdealPow A B κ n :=
  Stacks.submoduleFunctorIncl _ _ _ _ _
    (smallPolynomialAugmentationIdealPowSubmodule_antitone A B κ (Nat.le_succ n))

/-- The inclusion `𝒦ⁿ ⊆ Ō`. -/
def smallPolynomialAugmentationIdealPowι (n : ℕ) :
    smallPolynomialAugmentationIdealPow A B κ n ⟶ smallPolynomialQuotientModule A B κ :=
  Stacks.submoduleFunctorι _ _ _

/-- The zeroth step of the filtration is the whole of `Ō`. -/
lemma smallPolynomialAugmentationIdealPowSubmodule_zero
    (X : ((smallBoundedPolynomialSite A B κ)ᵒᵖ)) :
    smallPolynomialAugmentationIdealPowSubmodule A B κ 0 X = ⊤ := by
  refine eq_top_iff.2 fun x _ => ?_
  change x ∈ smallPolynomialAugmentationIdeal A B κ X ^ 0
  rw [pow_zero, Ideal.one_eq_top]
  exact Submodule.mem_top

/-! ### The sections of `Ō` are a polynomial ring over `B` -/

/-- **The sections of `Ō` over an object of the small model are a polynomial ring over `B`** on
the same set of variables: `B ⊗_A A[S] = B[S]`. -/
def smallPolynomialQuotientAlgEquiv (X : ((smallBoundedPolynomialSite A B κ)ᵒᵖ)) :
    ((smallPolynomialQuotientAlgebra A B κ).obj X : Type u) ≃ₐ[(B : Type u)]
      MvPolynomial ↥(X.unop.unop.1) (B : Type u) :=
  MvPolynomial.algebraTensorAlgEquiv A (B : Type u)

/-- Evaluation over `B` of a polynomial with coefficients pushed forward from `A` is evaluation
over `A`. -/
lemma aeval_map_algebraMap_eq {σ : Type u} (g : σ → (B : Type u)) (q : MvPolynomial σ A) :
    MvPolynomial.aeval (R := (B : Type u)) g
        (MvPolynomial.map (algebraMap A (B : Type u)) q) =
      MvPolynomial.aeval (R := A) g q := by
  simp only [MvPolynomial.aeval_def, MvPolynomial.eval₂_map]
  congr 1

/-- Evaluating the identification `B ⊗_A A[σ] = B[σ]` is evaluation over `A`, scaled. -/
lemma aeval_algebraTensorAlgEquiv {σ : Type u} (g : σ → (B : Type u)) (b : (B : Type u))
    (q : MvPolynomial σ A) :
    MvPolynomial.aeval (R := (B : Type u)) g
        (MvPolynomial.algebraTensorAlgEquiv A (B : Type u) (b ⊗ₜ[A] q)) =
      b • MvPolynomial.aeval (R := A) g q := by
  rw [MvPolynomial.algebraTensorAlgEquiv_tmul, map_smul, aeval_map_algebraMap_eq]

/-- Under the identification of the sections of `Ō` with a polynomial ring over `B`, the
augmentation is evaluation at the point `g : S → B` naming the object. -/
lemma smallPolynomialQuotientAug_eq (X : ((smallBoundedPolynomialSite A B κ)ᵒᵖ)) :
    smallPolynomialQuotientAug A B κ X =
      (MvPolynomial.aeval (R := (B : Type u))
          (fun s : ↥(X.unop.unop.1) => (X.unop.unop.2 s : (B : Type u)))).comp
        (smallPolynomialQuotientAlgEquiv A B κ X).toAlgHom := by
  refine Algebra.TensorProduct.ext_ring (AlgHom.ext fun p => ?_)
  exact (aeval_algebraTensorAlgEquiv A B
    (fun s : ↥(X.unop.unop.1) => (X.unop.unop.2 s : (B : Type u))) 1 p).symm

/-- Under the identification of the sections of `Ō` with a polynomial ring over `B`, the
augmentation of a section is its evaluation at the point naming the object. -/
lemma smallPolynomialQuotientAug_apply (X : ((smallBoundedPolynomialSite A B κ)ᵒᵖ))
    (x : ((smallPolynomialQuotientAlgebra A B κ).obj X : Type u)) :
    smallPolynomialQuotientAug A B κ X x =
      MvPolynomial.aeval (R := (B : Type u))
        (fun s : ↥(X.unop.unop.1) => (X.unop.unop.2 s : (B : Type u)))
        (smallPolynomialQuotientAlgEquiv A B κ X x) :=
  DFunLike.congr_fun (smallPolynomialQuotientAug_eq A B κ X) x

end Filtration

end CommAlgCat

end
