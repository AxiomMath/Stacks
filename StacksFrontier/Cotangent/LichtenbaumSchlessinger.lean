module

public import Mathlib.Algebra.Category.ModuleCat.Basic
public import Mathlib.Algebra.Homology.HomologicalComplex
public import Mathlib.LinearAlgebra.Quotient.Basic
public import Mathlib.RingTheory.Extension.Cotangent.Basic
public import Mathlib.RingTheory.Extension.Presentation.Basic
public import StacksCore.Tactic.StacksAttribute

/-!
# The Lichtenbaum–Schlessinger complex

Given a polynomial presentation of an algebra and a chosen generating family for its ideal of
relations, this file constructs the three-term complex formed from relations modulo trivial
relations, the free module on the chosen relations, and relative Kähler differentials.

## Main definitions

* `Algebra.Presentation.relationMap`: sends a formal linear combination of the chosen equations
  to the corresponding polynomial.
* `Algebra.Presentation.relations` and `Algebra.Presentation.trivialRelations`: the module of
  relations and its submodule of Koszul, or trivial, relations.
* `Algebra.Presentation.relationDifferential`: sends the basis vector of an equation to its
  relative differential.
* `Algebra.Presentation.relationModule`: the descended `B`-module structure on
  `Rel / TrivRel`.
* `Algebra.Presentation.LichtenbaumSchlessingerComplex`: records the three-term complex and its
  canonical identifications and differentials. In particular, it records the descended
  `B`-module structure on `Rel / TrivRel` and the canonical base-change equivalence identifying
  that module with `B ⊗[P] (Rel / TrivRel)`.

## Main results

* `Algebra.Presentation.lichtenbaumSchlessingerComplex`: the Lichtenbaum–Schlessinger complex
  attached to a polynomial presentation.

## Implementation notes

`Algebra.Presentation A B X T` packages the polynomial algebra `A[X]`, its surjection onto `B`,
and the chosen generators indexed by `T` of its kernel. The kernel of `A[X] → B` annihilates
`Rel / TrivRel`; consequently its `A[X]`-module structure descends uniquely to a `B`-module
structure. Both this source term and its canonical base-change presentation are retained,
together with the equivalence between them. Tensor factors are placed with `B` on the left,
following Mathlib's convention.

## References

* [Stacks Project, Tag 09CD](https://stacks.math.columbia.edu/tag/09CD)
-/

@[expose] public section

open CategoryTheory KaehlerDifferential TensorProduct

universe u v w

noncomputable section

namespace Algebra.Presentation

variable {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]
variable {X T : Type w}

/-- The map from the free module on the chosen equations to the polynomial algebra, sending the
basis vector indexed by `s` to the equation `P.relation s`. -/
def relationMap (P : Algebra.Presentation A B X T) :
    (T →₀ P.Ring) →ₗ[P.Ring] P.Ring :=
  Finsupp.lsum P.Ring fun s ↦ LinearMap.toSpanSingleton P.Ring P.Ring (P.relation s)

/-- The module of relations among the chosen generators of the defining ideal. -/
abbrev relations (P : Algebra.Presentation A B X T) :=
  LinearMap.ker (relationMap P)

/-- The elementary relation `f_s e_t - f_t e_s`. -/
def trivialRelation (P : Algebra.Presentation A B X T) (s t : T) : T →₀ P.Ring :=
  Finsupp.single t (P.relation s) - Finsupp.single s (P.relation t)

/-- An elementary trivial relation, regarded as an element of `Rel`. -/
def trivialRelationInRelations (P : Algebra.Presentation A B X T) (s t : T) :
    relations P :=
  ⟨trivialRelation P s t, by
    change relationMap P (trivialRelation P s t) = 0
    rw [trivialRelation, map_sub]
    simp [relationMap]
    ring⟩

/-- The submodule of `Rel` generated by the elementary trivial relations. -/
def trivialRelations (P : Algebra.Presentation A B X T) :
    Submodule P.Ring (relations P) :=
  Submodule.span P.Ring
    (Set.range fun p : T × T ↦ trivialRelationInRelations P p.1 p.2)

/-- Relations modulo trivial relations. -/
abbrev relationQuotient (P : Algebra.Presentation A B X T) :=
  relations P ⧸ trivialRelations P

/-- The map from the free module on the equations to relative differentials, sending the basis
vector indexed by `s` to `d(P.relation s)`. -/
def relationDifferential (P : Algebra.Presentation A B X T) :
    (T →₀ P.Ring) →ₗ[P.Ring] Ω[P.Ring⁄A] :=
  Finsupp.lsum P.Ring fun s ↦
    LinearMap.toSpanSingleton P.Ring Ω[P.Ring⁄A] (D A P.Ring (P.relation s))

/-- A three-term cochain complex together with the identifications which say that it is
`Rel/TrivRel → F ⊗_P B → Ω[P/A] ⊗_P B`, with its last term in degree zero.

The equations on pure tensors specify the two arrows: the first is induced by the inclusion of
relations into the free module, and the second sends the basis vector belonging to an equation
`f_s` to `d f_s`. -/
structure LichtenbaumSchlessingerComplex (P : Algebra.Presentation A B X T) where
  /-- The `B`-module structure on `Rel / TrivRel` obtained by descent along the surjection
  `P.Ring → B`. -/
  relationModule : Module B (relationQuotient P)
  /-- The descended action restricts to the original `P.Ring`-module action. -/
  algebraMap_smul_relation :
    letI := relationModule
    ∀ (p : P.Ring) (q : relationQuotient P),
      algebraMap P.Ring B p • q = p • q
  /-- The canonical identification of the scalar extension of `Rel / TrivRel` with its descended
  `B`-module. -/
  relationBaseChangeEquiv :
    letI := relationModule
    (B ⊗[P.Ring] relationQuotient P) ≃ₗ[B] relationQuotient P
  /-- The base-change identification sends `1 ⊗ q` to `q`. -/
  relationBaseChangeEquiv_tmul :
    letI := relationModule
    ∀ q : relationQuotient P,
      relationBaseChangeEquiv (1 ⊗ₜ[P.Ring] q) = q
  /-- The underlying cochain complex of `B`-modules. -/
  complex : CochainComplex (ModuleCat.{max u v w} B) ℤ
  /-- Identification of the term in degree `-2`; the preceding base-change equivalence identifies
  this with the source's `Rel / TrivRel`. -/
  relationIso : complex.X (-2) ≅
    ModuleCat.of B (B ⊗[P.Ring] relationQuotient P)
  /-- Identification of the term in degree `-1`. -/
  freeIso : complex.X (-1) ≅ ModuleCat.of B (B ⊗[P.Ring] (T →₀ P.Ring))
  /-- Identification of the term in degree `0`. -/
  differentialIso : complex.X 0 ≅ ModuleCat.of B (B ⊗[P.Ring] Ω[P.Ring⁄A])
  /-- The first differential is the natural map induced by `Rel ⊆ F`. -/
  d_relation : ∀ r : relations P,
    freeIso.hom
        (complex.d (-2) (-1)
          (relationIso.inv (1 ⊗ₜ[P.Ring] Submodule.mkQ (trivialRelations P) r))) =
      1 ⊗ₜ[P.Ring] (r : T →₀ P.Ring)
  /-- The second differential sends an equation to its relative differential. -/
  d_free : ∀ (b : B) (x : T →₀ P.Ring),
    differentialIso.hom
        (complex.d (-1) 0 (freeIso.inv (b ⊗ₜ[P.Ring] x))) =
      b ⊗ₜ[P.Ring] relationDifferential P x
  /-- All terms except those in degrees `-2`, `-1`, and `0` vanish. -/
  isZero_X (n : ℤ) (hn2 : n ≠ -2) (hn1 : n ≠ -1) (hn0 : n ≠ 0) :
    Limits.IsZero (complex.X n)

/-- `relationMap P x` is the sum of `x s * P.relation s` over the support of `x`. -/
lemma relationMap_apply (P : Algebra.Presentation A B X T) (x : T →₀ P.Ring) :
    relationMap P x = x.sum (fun s c ↦ c * P.relation s) :=
  rfl

/-- The linear map sending the basis vector indexed by `t` to the elementary trivial relation
`f_s e_t - f_t e_s`. -/
def trivialCombination (P : Algebra.Presentation A B X T) (s : T) :
    (T →₀ P.Ring) →ₗ[P.Ring] relations P :=
  Finsupp.lsum P.Ring fun t ↦
    LinearMap.toSpanSingleton P.Ring (relations P) (trivialRelationInRelations P s t)

/-- As a map into the free module, `trivialCombination P s` is `x ↦ f_s x - (relationMap P x) e_s`.
-/
lemma trivialCombination_formula (P : Algebra.Presentation A B X T) (s : T) :
    (relations P).subtype.comp (trivialCombination P s) =
      (P.relation s) • (LinearMap.id : (T →₀ P.Ring) →ₗ[P.Ring] (T →₀ P.Ring)) -
        (Finsupp.lsingle s).comp (relationMap P) := by
  ext t
  simp [trivialCombination, relationMap, trivialRelationInRelations, trivialRelation]

/-- For every relation `r`, the multiple `f_s r` is a trivial relation. -/
lemma relation_scalar_mem_trivialRelations (P : Algebra.Presentation A B X T)
    (s : T) (r : relations P) :
    (P.relation s) • r ∈ trivialRelations P := by
  classical
  have hz : trivialCombination P s r.1 = (P.relation s) • r :=
    Subtype.ext <| by simpa using LinearMap.congr_fun (trivialCombination_formula P s) r.1
  rw [← hz]
  change r.1.sum (fun t c ↦ c • trivialRelationInRelations P s t) ∈ trivialRelations P
  exact Submodule.sum_mem _ fun t _ ↦
    Submodule.smul_mem _ _ (Submodule.subset_span ⟨(s, t), rfl⟩)

/-- The kernel of `P.Ring → B` is contained in the annihilator of `Rel / TrivRel`. -/
lemma relationKer_le_annihilator (P : Algebra.Presentation A B X T) :
    P.ker ≤ Module.annihilator P.Ring (relationQuotient P) := by
  rw [← P.span_range_relation_eq_ker]
  refine Ideal.span_le.mpr ?_
  rintro f ⟨s, rfl⟩
  refine Module.mem_annihilator.mpr fun q ↦ ?_
  obtain ⟨r, rfl⟩ := Submodule.mkQ_surjective (trivialRelations P) q
  change Submodule.Quotient.mk ((P.relation s) • r) = 0
  exact (Submodule.Quotient.mk_eq_zero (trivialRelations P)).2
    (relation_scalar_mem_trivialRelations P s r)

/-- The kernel of `P.Ring → B` annihilates `Rel / TrivRel`. -/
lemma isTorsionBySet_relationQuotient (P : Algebra.Presentation A B X T) :
    Module.IsTorsionBySet P.Ring (relationQuotient P) (P.ker : Set P.Ring) :=
  (Module.isTorsionBySet_iff_subset_annihilator P.Ring (relationQuotient P)).2
    (relationKer_le_annihilator P)

/-- The `B`-module structure on `Rel / TrivRel` obtained by descent along `P.Ring → B`. -/
@[instance_reducible]
noncomputable def relationModule (P : Algebra.Presentation A B X T) :
    Module B (relationQuotient P) :=
  letI : Module (P.Ring ⧸ P.ker) (relationQuotient P) :=
    Module.IsTorsionBySet.module (isTorsionBySet_relationQuotient P)
  Module.compHom (relationQuotient P) P.quotientEquiv.symm.toRingHom

/-- Under `relationModule P`, the image of `p : P.Ring` in `B` acts on `Rel / TrivRel` as `p`
does. -/
lemma relationModule_smul (P : Algebra.Presentation A B X T) :
    letI := relationModule P
    ∀ (p : P.Ring) (q : relationQuotient P),
      (algebraMap P.Ring B p) • q = p • q := by
  let _ : Module (P.Ring ⧸ P.ker) (relationQuotient P) :=
    Module.IsTorsionBySet.module (isTorsionBySet_relationQuotient P)
  intro p q
  change (P.quotientEquiv.symm (algebraMap P.Ring B p)) • q = p • q
  rw [show P.quotientEquiv.symm (algebraMap P.Ring B p) = Ideal.Quotient.mk P.ker p from
    P.quotientEquiv.injective (by simp)]
  exact Module.IsTorsionBySet.mk_smul (isTorsionBySet_relationQuotient P) p q

/-- The canonical identification of the scalar extension of `Rel / TrivRel` with its descended
`B`-module structure. -/
noncomputable def relationBaseChangeEquiv (P : Algebra.Presentation A B X T) :
    letI := relationModule P
    (B ⊗[P.Ring] relationQuotient P) ≃ₗ[B] relationQuotient P := by
  letI := relationModule P
  letI : IsScalarTower P.Ring B (relationQuotient P) :=
    ⟨fun r b q ↦ by
      rw [Algebra.smul_def, ← relationModule_smul P r (b • q)]
      exact smul_assoc (algebraMap P.Ring B r) b q⟩
  haveI : _root_.TensorProduct.CompatibleSMul P.Ring B B (relationQuotient P) :=
    _root_.TensorProduct.CompatibleSMul.of_algebraMap_surjective B (relationQuotient P)
      P.algebraMap_surjective
  exact _root_.TensorProduct.lidOfCompatibleSMul P.Ring B (relationQuotient P)

/-- `relationBaseChangeEquiv P` sends `1 ⊗ q` to `q`. -/
lemma relationBaseChangeEquiv_tmul (P : Algebra.Presentation A B X T)
    (q : relationQuotient P) :
    letI := relationModule P
    relationBaseChangeEquiv P (1 ⊗ₜ[P.Ring] q) = q := by
  let _ := relationModule P
  simp [relationBaseChangeEquiv, _root_.TensorProduct.lidOfCompatibleSMul_tmul]

/-- The first differential of the Lichtenbaum–Schlessinger complex, as a `P.Ring`-linear map out
of the quotient of relations. -/
noncomputable def relationBoundaryR (P : Algebra.Presentation A B X T) :
    relationQuotient P →ₗ[P.Ring] B ⊗[P.Ring] (T →₀ P.Ring) :=
  Submodule.liftQ (trivialRelations P)
    ((_root_.TensorProduct.mk P.Ring B (T →₀ P.Ring) (1 : B)).comp
      (relations P).subtype)
    (by
      rw [trivialRelations]
      refine Submodule.span_le.mpr ?_
      rintro x ⟨⟨s, t⟩, rfl⟩
      change (1 : B) ⊗ₜ[P.Ring] trivialRelation P s t = 0
      rw [trivialRelation, _root_.TensorProduct.tmul_sub]
      rw [← Finsupp.smul_single_one t (P.relation s),
        ← Finsupp.smul_single_one s (P.relation t)]
      rw [← _root_.TensorProduct.smul_tmul, ← _root_.TensorProduct.smul_tmul]
      have hs : algebraMap P.Ring B (P.relation s) = 0 := by
        rw [P.algebraMap_apply]
        exact P.aeval_val_relation s
      have ht : algebraMap P.Ring B (P.relation t) = 0 := by
        rw [P.algebraMap_apply]
        exact P.aeval_val_relation t
      simp [Algebra.smul_def, hs, ht])

/-- `relationBoundaryR P` sends the class of a relation `r` to `1 ⊗ r`. -/
lemma relationBoundaryR_mk (P : Algebra.Presentation A B X T) (r : relations P) :
    relationBoundaryR P (Submodule.mkQ (trivialRelations P) r) =
      (1 : B) ⊗ₜ[P.Ring] (r : T →₀ P.Ring) := by
  simp [relationBoundaryR]

/-- The first differential of the Lichtenbaum–Schlessinger complex, as a `B`-linear map out of
the quotient of relations. -/
noncomputable def relationBoundaryB (P : Algebra.Presentation A B X T) :
    letI := relationModule P
    relationQuotient P →ₗ[B] B ⊗[P.Ring] (T →₀ P.Ring) := by
  letI := relationModule P
  letI : IsScalarTower P.Ring B (relationQuotient P) :=
    ⟨fun r b q ↦ by
      rw [Algebra.smul_def, ← relationModule_smul P r (b • q)]
      exact smul_assoc (algebraMap P.Ring B r) b q⟩
  refine
    { toFun := relationBoundaryR P
      map_add' := (relationBoundaryR P).map_add
      map_smul' := ?_ }
  intro b q
  obtain ⟨p, rfl⟩ := P.algebraMap_surjective b
  rw [relationModule_smul P p q, map_smul]
  exact (IsScalarTower.algebraMap_smul B p (relationBoundaryR P q)).symm

/-- The second differential of the Lichtenbaum–Schlessinger complex. -/
noncomputable def relationDifferentialB (P : Algebra.Presentation A B X T) :
    (B ⊗[P.Ring] (T →₀ P.Ring)) →ₗ[B] B ⊗[P.Ring] Ω[P.Ring⁄A] :=
  _root_.TensorProduct.AlgebraTensorModule.lTensor B B (relationDifferential P)

/-- `relationDifferentialB P` sends `b ⊗ x` to `b ⊗ relationDifferential P x`. -/
lemma relationDifferentialB_tmul (P : Algebra.Presentation A B X T)
    (b : B) (x : T →₀ P.Ring) :
    relationDifferentialB P (b ⊗ₜ[P.Ring] x) =
      b ⊗ₜ[P.Ring] relationDifferential P x := by
  simp [relationDifferentialB]

/-- The first differential of the Lichtenbaum–Schlessinger complex, on the base-changed source
term. -/
noncomputable def relationBoundary (P : Algebra.Presentation A B X T) :
    letI := relationModule P
    (B ⊗[P.Ring] relationQuotient P) →ₗ[B] B ⊗[P.Ring] (T →₀ P.Ring) := by
  letI := relationModule P
  exact (relationBoundaryB P).comp (relationBaseChangeEquiv P).toLinearMap

/-- `relationBoundary P` sends `1 ⊗ [r]` to `1 ⊗ r` for every relation `r`. -/
lemma relationBoundary_tmul (P : Algebra.Presentation A B X T) (r : relations P) :
    letI := relationModule P
    relationBoundary P (1 ⊗ₜ[P.Ring] Submodule.mkQ (trivialRelations P) r) =
      1 ⊗ₜ[P.Ring] (r : T →₀ P.Ring) := by
  let _ := relationModule P
  change relationBoundaryB P
    (relationBaseChangeEquiv P (1 ⊗ₜ[P.Ring] Submodule.mkQ (trivialRelations P) r)) = _
  rw [relationBaseChangeEquiv_tmul]
  exact relationBoundaryR_mk P r

/-- Leibniz rule: `d(∑ x_s f_s) = ∑ x_s d f_s + ∑ f_s d x_s`. -/
lemma derivation_relationMap (P : Algebra.Presentation A B X T) (x : T →₀ P.Ring) :
    D A P.Ring (relationMap P x) = relationDifferential P x +
      x.sum (fun s c ↦ P.relation s • D A P.Ring c) := by
  classical
  simp only [relationMap_apply, relationDifferential, Finsupp.lsum_apply, Finsupp.sum, map_sum,
    Derivation.leibniz, Finset.sum_add_distrib]
  simp [LinearMap.toSpanSingleton_apply]

/-- For every relation `r`, the element `1 ⊗ relationDifferential P r` of `B ⊗[P.Ring] Ω[P.Ring⁄A]`
vanishes. -/
lemma baseTensor_relationDifferential_zero (P : Algebra.Presentation A B X T)
    (r : relations P) :
    (1 : B) ⊗ₜ[P.Ring] relationDifferential P (r : T →₀ P.Ring) = 0 := by
  have hsum : relationDifferential P (r : T →₀ P.Ring) +
      (r : T →₀ P.Ring).sum (fun s c ↦ P.relation s • D A P.Ring c) = 0 := by
    simpa [r.2] using (derivation_relationMap P (r : T →₀ P.Ring)).symm
  have hsumTensor : (1 : B) ⊗ₜ[P.Ring]
      (r : T →₀ P.Ring).sum (fun s c ↦ P.relation s • D A P.Ring c) = 0 := by
    rw [Finsupp.sum, _root_.TensorProduct.tmul_sum]
    refine Finset.sum_eq_zero fun s _ ↦ ?_
    rw [_root_.TensorProduct.tmul_smul (P.relation s) (1 : B)
      (D A P.Ring ((r : T →₀ P.Ring) s))]
    change (P.relation s • (1 : B)) ⊗ₜ[P.Ring]
      D A P.Ring ((r : T →₀ P.Ring) s) = 0
    rw [Algebra.smul_def, P.algebraMap_apply, P.aeval_val_relation]
    simp
  rw [eq_neg_of_add_eq_zero_left hsum, _root_.TensorProduct.tmul_neg, hsumTensor, neg_zero]

/-- The composite of the two differentials of the Lichtenbaum–Schlessinger complex is zero. -/
lemma relationDifferentialB_comp_relationBoundary (P : Algebra.Presentation A B X T) :
    letI := relationModule P
    (relationDifferentialB P).comp (relationBoundary P) = 0 := by
  let _ := relationModule P
  refine LinearMap.ext fun z ↦ ?_
  induction z using _root_.TensorProduct.inductionOn with
  | tmul b q =>
      obtain ⟨r, rfl⟩ := Submodule.mkQ_surjective (trivialRelations P) q
      have hb : relationBaseChangeEquiv P
          (b ⊗ₜ[P.Ring] Submodule.mkQ (trivialRelations P) r) =
          b • Submodule.mkQ (trivialRelations P) r := by
        simp [relationBaseChangeEquiv, _root_.TensorProduct.lidOfCompatibleSMul_tmul]
      change relationDifferentialB P (relationBoundaryB P
        (relationBaseChangeEquiv P
          (b ⊗ₜ[P.Ring] Submodule.mkQ (trivialRelations P) r))) = 0
      rw [hb, (relationBoundaryB P).map_smul]
      change relationDifferentialB P
        (b • relationBoundaryR P (Submodule.mkQ (trivialRelations P) r)) = 0
      rw [relationBoundaryR_mk P r, (relationDifferentialB P).map_smul,
        relationDifferentialB_tmul, baseTensor_relationDifferential_zero P r]
      simp
  | add x y hx hy =>
      change relationDifferentialB P (relationBoundary P x) = 0 at hx
      change relationDifferentialB P (relationBoundary P y) = 0 at hy
      change relationDifferentialB P (relationBoundary P (x + y)) = 0
      rw [(relationBoundary P).map_add, (relationDifferentialB P).map_add, hx, hy]
      simp

/-- The Lichtenbaum–Schlessinger complex associated to a polynomial presentation and chosen
generators of its defining ideal. -/
@[stacks 09CD]
noncomputable def lichtenbaumSchlessingerComplex
    (P : Algebra.Presentation A B X T) : LichtenbaumSchlessingerComplex P := by
  letI : Module B (relationQuotient P) := relationModule P
  let Cneg2 : ModuleCat.{max u v w} B :=
    ModuleCat.of B (B ⊗[P.Ring] relationQuotient P)
  let Cneg1 : ModuleCat.{max u v w} B :=
    ModuleCat.of B (B ⊗[P.Ring] (T →₀ P.Ring))
  let Czero : ModuleCat.{max u v w} B :=
    ModuleCat.of B (B ⊗[P.Ring] Ω[P.Ring⁄A])
  let Xc : ℤ → ModuleCat.{max u v w} B := fun n ↦
    if n = -2 then Cneg2 else if n = -1 then Cneg1 else if n = 0 then Czero
      else ModuleCat.of B PUnit
  let d : ∀ n : ℤ, Xc n ⟶ Xc (n + 1) := fun n ↦
    if h : n = -2 then
      (eqToHom (by subst n; norm_num [Xc]) : Xc n ⟶ Cneg2) ≫
        ModuleCat.ofHom (relationBoundary P) ≫
        eqToHom (by subst n; norm_num [Xc]; rfl)
    else if h : n = -1 then
      (eqToHom (by subst n; norm_num [Xc]) : Xc n ⟶ Cneg1) ≫
        ModuleCat.ofHom (relationDifferentialB P) ≫
        eqToHom (by subst n; norm_num [Xc]; rfl)
    else 0
  have hd : ∀ n : ℤ, d n ≫ d (n + 1) = 0 := by
    intro n
    by_cases h₂ : n = -2
    · subst n
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro z
      simpa [d, Xc, Cneg2, Cneg1, Czero] using
        LinearMap.congr_fun (relationDifferentialB_comp_relationBoundary P) z
    · by_cases h₁ : n = -1
      · subst n
        simp [d, Xc, Cneg2, Cneg1, Czero]
      · simp [d, Xc, Cneg2, Cneg1, Czero, h₂, h₁]
  let C := CochainComplex.of Xc d hd
  refine
    { relationModule := relationModule P
      algebraMap_smul_relation := ?_
      relationBaseChangeEquiv := relationBaseChangeEquiv P
      relationBaseChangeEquiv_tmul := relationBaseChangeEquiv_tmul P
      complex := C
      relationIso := Iso.refl _
      freeIso := Iso.refl _
      differentialIso := Iso.refl _
      d_relation := ?_
      d_free := ?_
      isZero_X := ?_ }
  · intro p q
    exact relationModule_smul P p q
  · intro r
    change (C.d (-2) (-1)) (1 ⊗ₜ[P.Ring]
      Submodule.mkQ (trivialRelations P) r) = _
    have h : C.d (-2) (-1) = d (-2) := by
      simp [C, CochainComplex.of.d]
    rw [h]
    exact relationBoundary_tmul P r
  · intro b x
    change (C.d (-1) 0) (b ⊗ₜ[P.Ring] x) = _
    have h : C.d (-1) 0 = d (-1) := by
      simp [C, CochainComplex.of.d]
    rw [h]
    exact relationDifferentialB_tmul P b x
  · intro n hn2 hn1 hn0
    simp [C, Xc, hn2, hn1, hn0, ModuleCat.isZero_of_subsingleton]

end Algebra.Presentation

