module

public import Mathlib.Algebra.Algebra.Prod
public import Mathlib.RingTheory.Flat.Localization
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.Localization.BaseChange
public import StacksFrontier.Cotangent.ResolutionTorBaseChange
public import StacksFrontier.Homology.Tor.Presentation

/-!
# The localization square which splits a product of algebras

Let `R → B` and `R → C` be ring maps and suppose some `x : R` has image `1` in `B` and image `0`
in `C`. Its image in `B × C` is then the idempotent `(1, 0)`, and inverting it kills the `C`
factor: `B` is the localization of `B × C` away from that idempotent. Consequently the square

```
R  ---→  R[1/x]
|          |
B × C ---→  B
```

is a pushout of rings, and it is Tor independent because `R → R[1/x]` is flat. Those are exactly
the two hypotheses of [Stacks, Tag 08QQ]. This file discharges them.

This is the input the source's proof of [Stacks, Tag 08SC] uses over the base `A[x]`: there
`x ↦ (1, 0)`, so `x` has image `1` in `B` and `0` in `C`, and the mirror element `1 - x` has
image `0` in `B` and `1` in `C`, which kills the `B` factor instead. Nothing in this file refers
to a polynomial ring: only the two equations `algebraMap R B x = 1` and `algebraMap R C x = 0`
are used.

## Main results

* `IsLocalization.algebraMapSubmonoid_prod_fst`: the multiplicative set generated by the image of
  the powers of `x` in `B × C` is the set of powers of the idempotent `(1, 0)`.
* `IsLocalization.isLocalization_algebraMapSubmonoid_prod_fst`: **`B` is the localization of
  `B × C` at that multiplicative set**, which is `IsLocalization.away_fst` of Mathlib read
  through the previous result.
* `IsLocalization.awayAlgebraOfIsUnit` and `IsLocalization.isScalarTower_awayAlgebraOfIsUnit`:
  the `R[1/x]`-algebra structure on a ring in which `x` is already a unit, and the scalar tower
  it fits into. This is what makes the right-hand column of the square above exist.
* `IsLocalization.isPushout_prod_fst`: **the square above is a pushout of rings**, in the
  orientation `Algebra.IsPushout R (B × C) R[1/x] B` which Tag 08QQ takes, by
  `Algebra.isPushout_of_isLocalization`. With
  `CommAlgCat.bijective_baseChangeUnit_of_isPushout` this is the hypothesis `hpush` of
  [Stacks, Tag 08QQ].
* `IsLocalization.algebraMapSubmonoid_prod_snd`,
  `IsLocalization.isLocalization_algebraMapSubmonoid_prod_snd` and
  `IsLocalization.isPushout_prod_snd`: the mirror statements, for an element of image `0` in `B`
  and `1` in `C`, which kills the `B` factor instead. They rest on Mathlib's
  `IsLocalization.away_snd` and are otherwise identical.
* `IsLocalization.isPushout_of_isUnit`: **the square `R → R[1/x]`, `D → D` is a pushout** when `x`
  is already a unit in `D`. Inverting an element that is already invertible changes nothing, so
  `D` is its own localization at the image of the powers of `x`
  (`IsLocalization.of_le_isUnit`). This is the hypothesis `hpush` of [Stacks, Tag 08QQ] at the
  *second* square of the composite used for Tag 08SC, the one whose top map is the identity.
* `CommAlgCat.torIndependent_localization_away`: `R[1/x]` and any `R`-algebra are Tor independent
  over `R`, `R → R[1/x]` being flat — the hypothesis `hTor`.

## Implementation notes

The `Algebra (B × C) B` under which `B` is a localization of `B × C` is the one attached to the
first projection, `(RingHom.fst B C).toAlgebra`; it is introduced by `letI` inside each statement
rather than as an instance, exactly as Mathlib's `IsLocalization.away_fst` does, since `B` is not
canonically an algebra over `B × C`.

*Why the Tor independence is proved in place.* The general statement, that a flat algebra is Tor
independent from every algebra, is `CommAlgCat.torIndependent_of_flat` of
`StacksFrontier.Cotangent.EtaleVanishing`. That file sits downstream of a large part of the
cotangent-complex development, so `CommAlgCat.torIndependent_localization_away` repeats its four
lines over `isZero_Tor_succ_of_flat` of `StacksFrontier.Homology.Tor.Presentation` rather than
attaching all of it to the product-decomposition files.

## References

* [Stacks Project, Tag 08QQ](https://stacks.math.columbia.edu/tag/08QQ)
* [Stacks Project, Tag 08SC](https://stacks.math.columbia.edu/tag/08SC)
-/

@[expose] public section

universe u

namespace IsLocalization

variable {R B C : Type u} [CommRing R] [CommRing B] [CommRing C] [Algebra R B] [Algebra R C]
  {x : R}

/-- **The image of `x` in `B × C` is the idempotent `(1, 0)`** when `x` has image `1` in `B` and
image `0` in `C`. -/
theorem algebraMap_prod_eq_idempotent (hB : algebraMap R B x = 1) (hC : algebraMap R C x = 0) :
    algebraMap R (B × C) x = ((1 : B), (0 : C)) := by
  rw [Prod.algebraMap_apply, hB, hC]

/-- **The multiplicative set generated by the image of the powers of `x` in `B × C` is the set of
powers of the idempotent `(1, 0)`.** -/
theorem algebraMapSubmonoid_prod_fst (hB : algebraMap R B x = 1) (hC : algebraMap R C x = 0) :
    Algebra.algebraMapSubmonoid (B × C) (Submonoid.powers x) =
      Submonoid.powers ((1 : B), (0 : C)) := by
  rw [Algebra.algebraMapSubmonoid, Submonoid.map_powers,
    algebraMap_prod_eq_idempotent hB hC]

/-- **`B` is the localization of `B × C` at the image of the powers of `x`.** Inverting the
idempotent `(1, 0)` kills the `C` factor; this is `IsLocalization.away_fst` of Mathlib, read
through `IsLocalization.algebraMapSubmonoid_prod_fst`. -/
theorem isLocalization_algebraMapSubmonoid_prod_fst
    (hB : algebraMap R B x = 1) (hC : algebraMap R C x = 0) :
    letI := (RingHom.fst B C).toAlgebra
    IsLocalization (Algebra.algebraMapSubmonoid (B × C) (Submonoid.powers x)) B := by
  let := (RingHom.fst B C).toAlgebra
  rw [algebraMapSubmonoid_prod_fst hB hC]
  exact IsLocalization.away_fst

/-- **The `R[1/x]`-algebra structure on a ring where `x` is already a unit.** The structure map
is `IsLocalization.Away.lift`, the unique extension of `R → B` to the localization. It is not an
instance: it depends on the proof that `x` becomes a unit. -/
@[instance_reducible]
noncomputable def awayAlgebraOfIsUnit (R' : Type u) [CommRing R'] [Algebra R R']
    [IsLocalization.Away x R'] (hx : IsUnit (algebraMap R B x)) : Algebra R' B :=
  (IsLocalization.Away.lift (S := R') x hx).toAlgebra

/-- The structure map of `IsLocalization.awayAlgebraOfIsUnit` extends `R → B`, so `R`, `R[1/x]`
and `B` form a scalar tower. -/
theorem isScalarTower_awayAlgebraOfIsUnit (R' : Type u) [CommRing R'] [Algebra R R']
    [IsLocalization.Away x R'] (hx : IsUnit (algebraMap R B x)) :
    letI := awayAlgebraOfIsUnit (B := B) R' hx
    IsScalarTower R R' B :=
  let := awayAlgebraOfIsUnit (B := B) R' hx
  IsScalarTower.of_algebraMap_eq' (IsLocalization.Away.lift_comp (S := R') x hx).symm

/-- **The square `R → R[1/x]`, `B × C → B` is a pushout of rings.** `B` is the localization of
`B × C` at the image of the powers of `x`, so this is
`Algebra.isPushout_of_isLocalization`. Together with
`CommAlgCat.bijective_baseChangeUnit_of_isPushout` it discharges the hypothesis `hpush` of
[Stacks, Tag 08QQ] at this square. -/
theorem isPushout_prod_fst (R' : Type u) [CommRing R'] [Algebra R R']
    [IsLocalization.Away x R'] [Algebra R' B] [IsScalarTower R R' B]
    (hB : algebraMap R B x = 1) (hC : algebraMap R C x = 0) :
    letI := (RingHom.fst B C).toAlgebra
    haveI : IsScalarTower R (B × C) B := IsScalarTower.of_algebraMap_eq fun _ => rfl
    Algebra.IsPushout R (B × C) R' B := by
  let := (RingHom.fst B C).toAlgebra
  have : IsScalarTower R (B × C) B := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have := isLocalization_algebraMapSubmonoid_prod_fst hB hC
  exact Algebra.isPushout_of_isLocalization (Submonoid.powers x) R' (B × C) B

/-! ### The mirror statements, which kill the `B` factor -/

/-- **The multiplicative set generated by the image of the powers of `x` in `B × C` is the set of
powers of the idempotent `(0, 1)`** when `x` has image `0` in `B` and image `1` in `C`. -/
theorem algebraMapSubmonoid_prod_snd (hB : algebraMap R B x = 0) (hC : algebraMap R C x = 1) :
    Algebra.algebraMapSubmonoid (B × C) (Submonoid.powers x) =
      Submonoid.powers ((0 : B), (1 : C)) := by
  rw [Algebra.algebraMapSubmonoid, Submonoid.map_powers, Prod.algebraMap_apply, hB, hC]

/-- **`C` is the localization of `B × C` at the image of the powers of `x`** when `x` has image
`0` in `B` and image `1` in `C`. Inverting the idempotent `(0, 1)` kills the `B` factor; this is
`IsLocalization.away_snd` of Mathlib, read through
`IsLocalization.algebraMapSubmonoid_prod_snd`. -/
theorem isLocalization_algebraMapSubmonoid_prod_snd
    (hB : algebraMap R B x = 0) (hC : algebraMap R C x = 1) :
    letI := (RingHom.snd B C).toAlgebra
    IsLocalization (Algebra.algebraMapSubmonoid (B × C) (Submonoid.powers x)) C := by
  let := (RingHom.snd B C).toAlgebra
  rw [algebraMapSubmonoid_prod_snd hB hC]
  exact IsLocalization.away_snd

/-- **The square `R → R[1/x]`, `B × C → C` is a pushout of rings** when `x` has image `0` in `B`
and image `1` in `C`. This is the mirror of `IsLocalization.isPushout_prod_fst`; for the
application to [Stacks, Tag 08SC] it is used at the element `1 - x`. -/
theorem isPushout_prod_snd (R' : Type u) [CommRing R'] [Algebra R R']
    [IsLocalization.Away x R'] [Algebra R' C] [IsScalarTower R R' C]
    (hB : algebraMap R B x = 0) (hC : algebraMap R C x = 1) :
    letI := (RingHom.snd B C).toAlgebra
    haveI : IsScalarTower R (B × C) C := IsScalarTower.of_algebraMap_eq fun _ => rfl
    Algebra.IsPushout R (B × C) R' C := by
  let := (RingHom.snd B C).toAlgebra
  have : IsScalarTower R (B × C) C := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have := isLocalization_algebraMapSubmonoid_prod_snd hB hC
  exact Algebra.isPushout_of_isLocalization (Submonoid.powers x) R' (B × C) C

/-! ### Inverting an element that is already invertible -/

/-- **The square `R → R[1/x]`, `D → D` is a pushout of rings** when `x` is already a unit in `D`:
`D` is then its own localization at the image of the powers of `x`, every such image being a
unit (`IsLocalization.of_le_isUnit`).

With `CommAlgCat.bijective_baseChangeUnit_of_isPushout` this is the hypothesis `hpush` of
[Stacks, Tag 08QQ] at the square whose top map is the identity of `D` — the second factor of the
composite square through which [Stacks, Tag 08SC] is proved over a base carrying a splitting
element. -/
theorem isPushout_of_isUnit (R' : Type u) [CommRing R'] [Algebra R R'] [IsLocalization.Away x R']
    (D : Type u) [CommRing D] [Algebra R D] [Algebra R' D] [IsScalarTower R R' D]
    (hx : IsUnit (algebraMap R D x)) :
    Algebra.IsPushout R D R' D := by
  have : IsLocalization (Algebra.algebraMapSubmonoid D (Submonoid.powers x)) D := by
    refine IsLocalization.of_le_isUnit ?_
    rw [Algebra.algebraMapSubmonoid, Submonoid.map_powers, Submonoid.powers_le]
    exact hx
  exact Algebra.isPushout_of_isLocalization (Submonoid.powers x) R' D D

end IsLocalization

namespace CommAlgCat

open CategoryTheory CategoryTheory.Limits

variable {R : Type u} [CommRing R]

/-- **`R[1/x]` is Tor independent from any `R`-algebra over `R`**, a localization being flat.
This is the hypothesis `hTor` of [Stacks, Tag 08QQ] at a localization square. -/
theorem torIndependent_localization_away (x : R) (R' : Type u) [CommRing R'] [Algebra R R']
    [IsLocalization.Away x R'] (D : Type u) [CommRing D] [Algebra R D] :
    RingTheory.TorIndependence.TorIndependent R R' D := by
  have : Module.Flat R R' := IsLocalization.flat R' (Submonoid.powers x)
  rw [RingTheory.TorIndependence.torIndependent_iff_isZero_tor]
  intro i hi
  obtain ⟨k, rfl⟩ : ∃ k, i = k + 1 := ⟨i - 1, by omega⟩
  exact isZero_Tor_succ_of_flat (ModuleCat.of R R') (ModuleCat.of R D) k

end CommAlgCat

end
