module

public import StacksFrontier.RingTheory.RelativeKoszulCompare
public import StacksFrontier.RingTheory.VariableIdealPowFree

/-!
# Tor maps between powers of the ideal of variables

Let `P = A[E]` be a polynomial ring and let `I` be the ideal generated by its variables.  For a
`P`-module on which `I` acts as zero -- equivalently, for a module over the coefficient ring
regarded as a `P`-module through the augmentation -- the inclusion `I ^ (n + 1) → I ^ n` induces
the zero map on Tor in every degree.  This is the vanishing which makes Quillen's spectral
sequence for the cotangent complex degenerate, and it is Tag 08RE.

## Main results

* `MvPolynomial.tor_map_variableIdeal_pow_succ_eq_zero`: the maps on Tor induced by successive
  inclusions of powers of the ideal of variables are zero, with an arbitrary module killed by
  the ideal of variables in the first variable.

## Implementation notes

The Koszul complex of the variables and its contraction live in
`StacksFrontier.RingTheory.Koszul.Variables`.  The first variable may be arbitrary because Tor is
computed here from a projective resolution of the *second* variable: the relative Koszul
resolution, that is the Koszul resolution of the diagonal, which resolves `I ^ n` by modules
whose tensor product with a module killed by `I` is the Koszul complex of the base, where the
contraction lives.  See `StacksFrontier.RingTheory.RelativeKoszulResolution` and
`StacksFrontier.RingTheory.RelativeKoszulCompare`.

## References

* [Stacks Project, Tag 08RE](https://stacks.math.columbia.edu/tag/08RE)
-/

@[expose] public section

open CategoryTheory
open scoped TensorProduct

universe u v

namespace MvPolynomial

/-- A composite whose middle factor vanishes is zero. -/
private lemma comp_middle_eq_zero {C : Type*} [Category C]
    [CategoryTheory.Limits.HasZeroMorphisms C] {W X Y Z : C} (a : W ⟶ X) (b : Y ⟶ Z)
    {g : X ⟶ Y} (hg : g = 0) : a ≫ g ≫ b = 0 := by
  rw [hg, CategoryTheory.Limits.zero_comp, CategoryTheory.Limits.comp_zero]

/-- **Tag 08RE.** Let `P = A[E]` be a polynomial ring and let `I` be the ideal generated by its
variables.  For any `P`-module on which `I` acts as zero -- equivalently, for any module over
the coefficient ring, pulled back along the augmentation -- the inclusion `I ^ (n + 1) ⊆ I ^ n`
induces the zero map on `Tor_i^P` in every degree. -/
@[stacks 08RE]
theorem tor_map_variableIdeal_pow_succ_eq_zero
    (A : Type u) [CommRing A] (E : Type v) (i n : ℕ)
    (M : ModuleCat.{max u v} (MvPolynomial E A))
    (hM : ∀ r ∈ (Ideal.span (Set.range (MvPolynomial.X : E → MvPolynomial E A)) :
        Ideal (MvPolynomial E A)), ∀ m : M, r • m = 0) :
    ((Tor (ModuleCat.{max u v} (MvPolynomial E A)) i).obj M).map
        (ModuleCat.ofHom
          (Submodule.inclusion
            (Ideal.pow_le_pow_right (Nat.le_succ n) :
              (Ideal.span (Set.range (MvPolynomial.X : E → MvPolynomial E A)) ^ (n + 1) :
                  Ideal (MvPolynomial E A)) ≤
                Ideal.span (Set.range (MvPolynomial.X : E → MvPolynomial E A)) ^ n))) = 0 := by
  classical
  have hle : (Ideal.span (Set.range (MvPolynomial.X : E → MvPolynomial E A)) ^ (n + 1) :
      Ideal (MvPolynomial E A)) ≤
      Ideal.span (Set.range (MvPolynomial.X : E → MvPolynomial E A)) ^ n :=
    Ideal.pow_le_pow_right (Nat.le_succ n)
  let : LinearOrder E := linearOrderOfSTO WellOrderingRel
  let : Module A (M : Type max u v) :=
    Module.compHom (M : Type max u v) (algebraMap A (MvPolynomial E A))
  have : IsScalarTower A (MvPolynomial E A) (M : Type max u v) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  have : Module.Free A
      (↥(Ideal.span (Set.range (MvPolynomial.X : E → MvPolynomial E A)) ^ (n + 1))) :=
    free_variableIdeal_pow A E (n + 1)
  have : Module.Free A (↥(Ideal.span (Set.range (MvPolynomial.X : E → MvPolynomial E A)) ^ n)) :=
    free_variableIdeal_pow A E n
  have hX : ∀ (e : E) (x : (M : Type max u v)),
      (MvPolynomial.X e : MvPolynomial E A) • x = 0 :=
    fun e x => hM _ (Ideal.subset_span ⟨e, rfl⟩) x
  have key : ((((MonoidalCategory.tensoringLeft (ModuleCat.{max u v} (MvPolynomial E A))).obj
          M).mapHomologicalComplex (ComplexShape.down ℕ)) ⋙
      HomologicalComplex.homologyFunctor (ModuleCat.{max u v} (MvPolynomial E A))
        (ComplexShape.down ℕ) i).map
        (relKoszulMap A E (Submodule.inclusion hle)) = 0 := by
    apply (chain_homologyMap_eq_zero_iff_cycles _ (i + 1) i (i - 1) (by simp)
      (by cases i <;> simp)).2
    intro x hx
    rw [Functor.mapHomologicalComplex_obj_d, Functor.mapHomologicalComplex_map_f,
      relKoszulComplex_d]
    refine ⟨_, relKoszulCompareEquiv_boundary A E _ (M : Type max u v) _
      (Submodule.inclusion hle) hX i
      (LinearMap.lTensor (M : Type max u v) (koszulTensorContract A E i n)) x ?_⟩
    cases i with
    | zero =>
      exact LinearMap.congr_fun
        (lTensor_koszulTensorContract_homotopy_zero_map A E (M : Type max u v) n) _
    | succ q =>
      have hz := relKoszulCompareEquiv_symm_cycle A E _ (M : Type max u v) hX q x (by
        rw [Nat.add_sub_cancel, Functor.mapHomologicalComplex_obj_d,
          relKoszulComplex_d] at hx
        exact hx)
      have h := LinearMap.congr_fun
        (lTensor_koszulTensorContract_homotopy_map A E (M : Type max u v) q n)
        ((relKoszulCompareEquiv A E _ (M : Type max u v) (q + 1)).symm x)
      simp only [LinearMap.add_apply, LinearMap.comp_apply] at h
      have h2 := (congrArg (LinearMap.lTensor (M : Type max u v)
        (koszulTensorContract A E q n)) hz).trans (map_zero _)
      refine Eq.trans ?_ h
      rw [h2, add_zero]
  show (((MonoidalCategory.tensoringLeft
      (ModuleCat.{max u v} (MvPolynomial E A))).obj M).leftDerived i).map
    (ModuleCat.ofHom (Submodule.inclusion hle)) = 0
  rw [Functor.leftDerived_map_eq
    ((MonoidalCategory.tensoringLeft (ModuleCat.{max u v} (MvPolynomial E A))).obj M) i
    (ModuleCat.ofHom (Submodule.inclusion hle))
    (P := relKoszulResolution A E
      ↥(Ideal.span (Set.range (MvPolynomial.X : E → MvPolynomial E A)) ^ (n + 1)))
    (Q := relKoszulResolution A E
      ↥(Ideal.span (Set.range (MvPolynomial.X : E → MvPolynomial E A)) ^ n))
    (relKoszulMap A E (Submodule.inclusion hle))
    (relKoszulMap_pi A E _)]
  exact comp_middle_eq_zero _ _ key

end MvPolynomial

end
