module

public import Mathlib.RepresentationTheory.Homological.GroupCohomology.LowDegree
public import StacksFrontier.Algebra.Homology.DerivedCategory.Ext.ExtOneQuotient
public import StacksFrontier.RepresentationTheory.GroupAlgebraExtOne

/-! # `Ext¹` over a group algebra is first group cohomology

Let `k` be a field, `Γ` a group, and let `M` and `N` be `k[Γ]`-modules, that is, `k`-linear
representations `ρ` and `σ` of `Γ`. Then

`Ext¹_{k[Γ]}(M, N) = H¹(Γ, Hom_k(M, N))`

for the conjugation action of `Γ` on `Hom_k(M, N)`.

The proof is the classical cocycle computation, carried out on a single free presentation
rather than on a resolution. Choose a `k`-basis of `M` and let `π : F → M` be the `k[Γ]`-linear
surjection from the free `k[Γ]`-module on that basis, with `s : M → F` the `k`-linear — not
`k[Γ]`-linear — section reading off coordinates. Then:

* `Ext¹(M, N)` is the quotient of `Hom_{k[Γ]}(ker π, N)` by the maps that extend over `F`
  (`CategoryTheory.Abelian.Ext.extOneQuotientEquiv`, using that `F` is projective);
* the relation module `ker π` is generated by the discrepancies `γ · s(m) - s(γ · m)`, and a
  `k[Γ]`-linear map out of it is therefore the same thing as a `1`-cocycle: the assignment
  `γ ↦ (m ↦ φ(γ · s(m) - s(γ · m)))`, twisted by `ρ(γ)⁻¹`, satisfies the cocycle identity
  for the conjugation action, and every cocycle arises this way;
* under that correspondence the maps extending over `F` are exactly the coboundaries, because
  a `k[Γ]`-linear `ψ : F → N` restricts to the discrepancy of the `k`-linear map `ψ ∘ s`.

The inverse construction is the extension attached to a cocycle: a cocycle `c` makes
`N × M` into a `k[Γ]`-module by `γ · (n, m) = (γ · n + c(γ)(m), γ · m)`, the free module maps
to it by the universal property, and the first component of that map restricted to `ker π` is
the wanted `k[Γ]`-linear map.

## Main definitions

* `MonoidAlgebra.cocycleOfRelationHom`: the `1`-cocycle attached to a `k[Γ]`-linear map out of
  the relation module.
* `MonoidAlgebra.relationHomEquivCocycles`: that assignment is a `k`-linear isomorphism onto
  the `1`-cocycles.

## Main results

* `MonoidAlgebra.extOneEquivGroupCohomologyOne`: the isomorphism
  `Ext¹_{k[Γ]}(M, N) ≃ H¹(Γ, Hom_k(M, N))`.
-/

@[expose] public noncomputable section

open CategoryTheory MonoidAlgebra

attribute [local instance] ModuleCat.moduleOfAlgebraModule
  ModuleCat.isScalarTower_of_algebra_moduleCat

universe w t

namespace MonoidAlgebra

variable {k : Type w} [Field k] {Γ : Type w} [Group Γ]
  {M F N : ModuleCat.{w} (MonoidAlgebra k Γ)} {d : ℕ}
  (b : Module.Basis (Fin d) k M) (e : Module.Basis (Fin d) (MonoidAlgebra k Γ) F)

/-! ### The relation module and its discrepancy generators -/

/-- The relation module of the free presentation determined by a `k`-basis of `M` and a
`k[Γ]`-basis of `F` of the same rank. -/
abbrev relationModule : Submodule (MonoidAlgebra k Γ) F :=
  LinearMap.ker (presentationMap b e)

/-- Each discrepancy `γ · s(m) - s(γ · m)` of the section lies in the relation module. -/
theorem sectionDiscrepancy_mem (γ : Γ) (m : M) :
    sectionDiscrepancy b e γ m ∈ relationModule b e := by
  simp only [relationModule, LinearMap.mem_ker, sectionDiscrepancy, LinearMap.coe_mk,
    AddHom.coe_mk, map_sub, map_smul, presentationMap_section, sub_self]

/-- The discrepancy `m ↦ γ · s(m) - s(γ · m)` of the section, as a `k`-linear map into the
relation module. -/
def relationDiscrepancy (γ : Γ) : M →ₗ[k] relationModule b e where
  toFun m := ⟨sectionDiscrepancy b e γ m, sectionDiscrepancy_mem b e γ m⟩
  map_add' x y := Subtype.ext (by simp)
  map_smul' a x := Subtype.ext (by simp)

/-- The underlying element of `relationDiscrepancy b e γ m` is the discrepancy of the section. -/
@[simp]
theorem relationDiscrepancy_coe (γ : Γ) (m : M) :
    (relationDiscrepancy b e γ m : F) = sectionDiscrepancy b e γ m := rfl

/-- The discrepancy of the section at the identity vanishes. -/
theorem sectionDiscrepancy_one (m : M) : sectionDiscrepancy b e (1 : Γ) m = 0 := by
  simp only [sectionDiscrepancy, LinearMap.coe_mk, AddHom.coe_mk, map_one, one_smul, sub_self]

/-- **The cocycle identity for the discrepancy of the section.** -/
theorem sectionDiscrepancy_mul (γ δ : Γ) (m : M) :
    sectionDiscrepancy b e (γ * δ) m =
      of k Γ γ • sectionDiscrepancy b e δ m + sectionDiscrepancy b e γ (of k Γ δ • m) := by
  simp only [sectionDiscrepancy, LinearMap.coe_mk, AddHom.coe_mk, map_mul, mul_smul, smul_sub]
  abel

/-- The set of all discrepancies of the section, over every group element and every vector. -/
def discrepancySet : Set F :=
  Set.range fun p : Γ × M ↦ sectionDiscrepancy b e p.1 p.2

/-- Each discrepancy lies in the span of all discrepancies. -/
theorem sectionDiscrepancy_mem_spanDiscrepancy (γ : Γ) (m : M) :
    sectionDiscrepancy b e γ m ∈
      Submodule.span (MonoidAlgebra k Γ) (discrepancySet b e) :=
  Submodule.subset_span ⟨(γ, m), rfl⟩

/-- For every `c ∈ k[Γ]`, the element `c · s(m) - s(c · m)` lies in the span of the
discrepancies. -/
theorem smul_section_sub_mem_spanDiscrepancy (c : MonoidAlgebra k Γ) (m : M) :
    c • presentationSection b e m - presentationSection b e (c • m) ∈
      Submodule.span (MonoidAlgebra k Γ) (discrepancySet b e) := by
  induction c using MonoidAlgebra.induction_on with
  | of γ => exact sectionDiscrepancy_mem_spanDiscrepancy b e γ m
  | add x y hx hy =>
      convert Submodule.add_mem _ hx hy using 1
      simp only [add_smul, map_add]
      abel
  | smul a x hx =>
      have hrw : (a • x) • presentationSection b e m -
            presentationSection b e ((a • x) • m) =
          a • (x • presentationSection b e m - presentationSection b e (x • m)) := by
        rw [smul_assoc, smul_assoc, map_smul, smul_sub]
      rw [hrw, ← IsScalarTower.algebraMap_smul (MonoidAlgebra k Γ) a]
      exact Submodule.smul_mem _ _ hx

/-- Every `x ∈ F` differs from `s(π(x))` by an element of the span of the discrepancies. -/
theorem sub_section_presentationMap_mem_spanDiscrepancy (x : F) :
    x - presentationSection b e (presentationMap b e x) ∈
      Submodule.span (MonoidAlgebra k Γ) (discrepancySet b e) := by
  have hx : x ∈ Submodule.span (MonoidAlgebra k Γ) (Set.range e) := by
    rw [e.span_eq]
    exact Submodule.mem_top
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨i, rfl⟩ := hy
    rw [presentationMap_basis, presentationSection_basis, sub_self]
    exact Submodule.zero_mem _
  | zero => simp
  | add x y _ _ hx hy =>
    convert Submodule.add_mem _ hx hy using 1
    simp only [map_add]
    abel
  | smul c x _ hx =>
    convert Submodule.add_mem _ (Submodule.smul_mem _ c hx)
      (smul_section_sub_mem_spanDiscrepancy b e c (presentationMap b e x)) using 1
    simp only [map_smul, smul_sub]
    abel

/-- **The relation module is generated by the discrepancies of the section.** No finiteness
hypothesis on the group is needed: the discrepancies over *all* group elements are taken. -/
theorem relationModule_eq_span_discrepancySet :
    relationModule b e = Submodule.span (MonoidAlgebra k Γ) (discrepancySet b e) := by
  refine le_antisymm (fun x hx ↦ ?_) ?_
  · have h := sub_section_presentationMap_mem_spanDiscrepancy b e x
    rw [relationModule, LinearMap.mem_ker] at hx
    rwa [hx, map_zero, sub_zero] at h
  · rw [Submodule.span_le]
    rintro x ⟨p, rfl⟩
    exact sectionDiscrepancy_mem b e p.1 p.2

/-- **A map out of the relation module is determined by its values on the discrepancies.** -/
theorem relationHom_ext {φ ψ : relationModule b e →ₗ[MonoidAlgebra k Γ] N}
    (h : ∀ (γ : Γ) (m : M), φ (relationDiscrepancy b e γ m) = ψ (relationDiscrepancy b e γ m)) :
    φ = ψ := by
  have hspan : Submodule.span (MonoidAlgebra k Γ)
      {x : relationModule b e | (x : F) ∈ discrepancySet b e} = ⊤ :=
    Submodule.span_subtype_eq_top _ _ (relationModule_eq_span_discrepancySet b e).symm
      (fun x hx ↦ by obtain ⟨p, rfl⟩ := hx; exact sectionDiscrepancy_mem b e p.1 p.2)
  refine LinearMap.ext_on hspan ?_
  rintro x ⟨p, hp⟩
  obtain rfl : x = relationDiscrepancy b e p.1 p.2 := Subtype.ext hp.symm
  exact h p.1 p.2

/-! ### Equivariant maps are `k[Γ]`-linear -/

/-- A `k`-linear map between `k[Γ]`-modules which commutes with the action of the group
elements is `k[Γ]`-linear: the group elements span the group algebra over `k`. -/
def ofEquivariantLinearMap {X Y : Type*} [AddCommGroup X] [Module k X]
    [Module (MonoidAlgebra k Γ) X] [IsScalarTower k (MonoidAlgebra k Γ) X]
    [AddCommGroup Y] [Module k Y] [Module (MonoidAlgebra k Γ) Y]
    [IsScalarTower k (MonoidAlgebra k Γ) Y]
    (f : X →ₗ[k] Y) (hf : ∀ (γ : Γ) (x : X), f (of k Γ γ • x) = of k Γ γ • f x) :
    X →ₗ[MonoidAlgebra k Γ] Y where
  toFun := f
  map_add' := f.map_add
  map_smul' c x := by
    induction c using MonoidAlgebra.induction_on with
    | of γ => exact hf γ x
    | add p q hp hq => simp only [add_smul, map_add, hp, hq, RingHom.id_apply]
    | smul a p hp => simp only [smul_assoc, map_smul, hp, RingHom.id_apply]

/-- `ofEquivariantLinearMap f hf` has the same underlying function as `f`. -/
@[simp]
theorem ofEquivariantLinearMap_apply {X Y : Type*} [AddCommGroup X] [Module k X]
    [Module (MonoidAlgebra k Γ) X] [IsScalarTower k (MonoidAlgebra k Γ) X]
    [AddCommGroup Y] [Module k Y] [Module (MonoidAlgebra k Γ) Y]
    [IsScalarTower k (MonoidAlgebra k Γ) Y]
    (f : X →ₗ[k] Y) (hf : ∀ (γ : Γ) (x : X), f (of k Γ γ • x) = of k Γ γ • f x) (x : X) :
    ofEquivariantLinearMap f hf x = f x := rfl

/-! ### The cocycle attached to a map out of the relation module -/

section Cocycle

variable {V W : Type w} [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]
  {ρ : Representation k Γ V} {σ : Representation k Γ W}
  (eV : V ≃ₗ[k] M) (eW : W ≃ₗ[k] N)
  (heV : ∀ (γ : Γ) (v : V), eV (ρ γ v) = of k Γ γ • eV v)
  (heW : ∀ (γ : Γ) (x : W), eW (σ γ x) = of k Γ γ • eW x)

include heV in
/-- The inverse of an equivariant identification `V ≃ M` intertwines the action of `γ` on `M`
with `ρ(γ)`. -/
theorem symm_smul_of (γ : Γ) (m : M) : eV.symm (of k Γ γ • m) = ρ γ (eV.symm m) := by
  rw [LinearEquiv.symm_apply_eq, heV, LinearEquiv.apply_symm_apply]

/-- **The `1`-cocycle attached to a `k[Γ]`-linear map out of the relation module.** Its value
at `γ` is the endomorphism `m ↦ φ(γ · s(m) - s(γ · m))` of the representation, twisted by
`ρ(γ)⁻¹` so as to be a cocycle for the conjugation action on `Hom_k(V, W)`. -/
def cocycleOfRelationHom (φ : relationModule b e →ₗ[MonoidAlgebra k Γ] N) (γ : Γ) :
    V →ₗ[k] W :=
  eW.symm.toLinearMap ∘ₗ (φ.restrictScalars k) ∘ₗ relationDiscrepancy b e γ ∘ₗ
    eV.toLinearMap ∘ₗ (ρ γ⁻¹ : V →ₗ[k] V)

/-- The value of `cocycleOfRelationHom` at `γ` on `v` is `φ` applied to the discrepancy at
`ρ(γ)⁻¹ v`. -/
theorem cocycleOfRelationHom_apply (φ : relationModule b e →ₗ[MonoidAlgebra k Γ] N) (γ : Γ)
    (v : V) :
    cocycleOfRelationHom b e eV eW (ρ := ρ) φ γ v =
      eW.symm (φ (relationDiscrepancy b e γ (eV (ρ γ⁻¹ v)))) := rfl

/-- Acting by `γ` on `eV (ρ(γ)⁻¹ v)` recovers `eV v`. -/
private theorem of_smul_eV_inv_apply
    (h : ∀ (γ : Γ) (v : V), eV (ρ γ v) = of k Γ γ • eV v) (γ : Γ) (v : V) :
    of k Γ γ • eV (ρ γ⁻¹ v) = eV v := by
  rw [← h, Representation.self_inv_apply]

include heV heW in
/-- `cocycleOfRelationHom φ` is a `1`-cocycle for the conjugation action on `Hom_k(V, W)`. -/
theorem cocycleOfRelationHom_mem (φ : relationModule b e →ₗ[MonoidAlgebra k Γ] N) :
    cocycleOfRelationHom b e eV eW (ρ := ρ) φ ∈
      groupCohomology.cocycles₁ (Rep.of (Representation.linHom ρ σ)) := by
  rw [groupCohomology.mem_cocycles₁_iff]
  intro γ δ
  refine LinearMap.ext fun v ↦ ?_
  set m : M := eV (ρ δ⁻¹ (ρ γ⁻¹ v)) with hmdef
  have hmv : eV (ρ (γ * δ)⁻¹ v) = m := by
    rw [hmdef, mul_inv_rev, map_mul]
    rfl
  have hshift : of k Γ δ • m = eV (ρ γ⁻¹ v) := of_smul_eV_inv_apply eV heV δ _
  have hsplit : relationDiscrepancy b e (γ * δ) m =
      of k Γ γ • relationDiscrepancy b e δ m + relationDiscrepancy b e γ (of k Γ δ • m) :=
    Subtype.ext (sectionDiscrepancy_mul b e γ δ m)
  rw [cocycleOfRelationHom_apply, hmv, hsplit, map_add, map_smul]
  have hleft : eW.symm (of k Γ γ • φ (relationDiscrepancy b e δ m)) =
      σ γ (eW.symm (φ (relationDiscrepancy b e δ m))) :=
    (symm_smul_of eW heW γ _).trans rfl
  rw [map_add, hleft, hshift]
  show σ γ (eW.symm (φ (relationDiscrepancy b e δ m))) +
      eW.symm (φ (relationDiscrepancy b e γ (eV (ρ γ⁻¹ v)))) =
    (Representation.linHom ρ σ) γ (cocycleOfRelationHom b e eV eW (ρ := ρ) φ δ) v +
      cocycleOfRelationHom b e eV eW (ρ := ρ) φ γ v
  rw [Representation.linHom_apply]
  simp only [LinearMap.coe_comp, Function.comp_apply, cocycleOfRelationHom_apply, hmdef]

end Cocycle

/-! ### The map out of the relation module attached to a cocycle -/

section Inverse

variable {V W : Type w} [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]
  {ρ : Representation k Γ V} {σ : Representation k Γ W}
  (eV : V ≃ₗ[k] M) (eW : W ≃ₗ[k] N)
  (heV : ∀ (γ : Γ) (v : V), eV (ρ γ v) = of k Γ γ • eV v)
  (heW : ∀ (γ : Γ) (x : W), eW (σ γ x) = of k Γ γ • eW x)
  (c : groupCohomology.cocycles₁ (Rep.of (Representation.linHom ρ σ)))

/-- On the module attached to a representation `τ`, the group element `γ` acts by `τ(γ)`. -/
theorem asModuleEquiv_of_smul {X : Type*} [AddCommGroup X] [Module k X]
    (τ : Representation k Γ X) (γ : Γ) (x : τ.asModule) :
    τ.asModuleEquiv (of k Γ γ • x) = τ γ (τ.asModuleEquiv x) := by
  rw [Representation.asModuleEquiv_map_smul, Representation.asAlgebraHom_of]

/-- The untwisted form `γ ↦ c(γ) ∘ ρ(γ)` of a `1`-cocycle: the cocycle for the action of `Γ` on
the extension, as opposed to the conjugation action on `Hom_k(V, W)`. -/
def untwist (γ : Γ) : V →ₗ[k] W := (c γ).comp (ρ γ)

/-- The value of `untwist c γ` on `v` is `c(γ)(ρ(γ) v)`. -/
theorem untwist_apply (γ : Γ) (v : V) : untwist c γ v = c γ (ρ γ v) := rfl

/-- The untwisted cocycle vanishes at the identity. -/
theorem untwist_one : untwist c 1 = 0 := by
  refine LinearMap.ext fun v ↦ ?_
  rw [untwist_apply, groupCohomology.cocycles₁_map_one c]
  rfl

/-- The cocycle identity for the untwisted form of a `1`-cocycle. -/
theorem untwist_mul (γ δ : Γ) :
    untwist c (γ * δ) = (σ γ).comp (untwist c δ) + (untwist c γ).comp (ρ δ) := by
  have h := (groupCohomology.mem_cocycles₁_iff
    (A := Rep.of (Representation.linHom ρ σ)) (c : Γ → (V →ₗ[k] W))).1 c.2 γ δ
  refine LinearMap.ext fun v ↦ ?_
  have hρ : ρ (γ * δ) v = ρ γ (ρ δ v) := by rw [map_mul, Module.End.mul_apply]
  rw [untwist_apply, hρ, h]
  simp only [LinearMap.add_apply, LinearMap.comp_apply, untwist_apply,
    Representation.linHom_apply, Representation.inv_self_apply]

/-- The linear endomorphism of `W × V` by which `γ` acts on the extension determined by a
`1`-cocycle. -/
def twistedMap (γ : Γ) : (W × V) →ₗ[k] (W × V) :=
  LinearMap.prod ((σ γ).comp (LinearMap.fst k W V) + (untwist c γ).comp (LinearMap.snd k W V))
    ((ρ γ).comp (LinearMap.snd k W V))

/-- `twistedMap c γ` sends `(x, v)` to `(σ(γ)x + c(γ)(ρ(γ)v), ρ(γ)v)`. -/
@[simp]
theorem twistedMap_apply (γ : Γ) (p : W × V) :
    twistedMap c γ p = (σ γ p.1 + untwist c γ p.2, ρ γ p.2) := rfl

/-- **The extension of `σ` by `ρ` determined by a `1`-cocycle.** The group acts on `W × V` by
`γ · (x, v) = (σ(γ)x + c(γ)(ρ(γ)v), ρ(γ)v)`; this is an action exactly because `c` is a
cocycle. -/
def twistedRep : Representation k Γ (W × V) where
  toFun := twistedMap c
  map_one' := by
    refine LinearMap.ext fun p ↦ Prod.ext ?_ ?_
    · change σ 1 p.1 + untwist c 1 p.2 = p.1
      rw [untwist_one, map_one]
      simp
    · change ρ 1 p.2 = p.2
      rw [map_one]
      rfl
  map_mul' γ δ := by
    refine LinearMap.ext fun p ↦ Prod.ext ?_ ?_
    · change σ (γ * δ) p.1 + untwist c (γ * δ) p.2 =
        σ γ (σ δ p.1 + untwist c δ p.2) + untwist c γ (ρ δ p.2)
      rw [untwist_mul, map_mul]
      simp only [Module.End.mul_apply, LinearMap.add_apply, LinearMap.comp_apply, map_add]
      abel
    · change ρ (γ * δ) p.2 = ρ γ (ρ δ p.2)
      rw [map_mul, Module.End.mul_apply]

/-- `γ` acts on the extension by `(x, v) ↦ (σ(γ)x + c(γ)(ρ(γ)v), ρ(γ)v)`. -/
@[simp]
theorem twistedRep_apply (γ : Γ) (p : W × V) :
    twistedRep c γ p = (σ γ p.1 + untwist c γ p.2, ρ γ p.2) := rfl

/-- The `k[Γ]`-linear map from the free module of the presentation to the extension attached to
a cocycle, sending the `i`-th basis vector to the `i`-th basis vector of `M`, lifted by zero. -/
def freeToTwisted : F →ₗ[MonoidAlgebra k Γ] (twistedRep c).asModule :=
  e.constr k fun i ↦ (twistedRep c).asModuleEquiv.symm (0, eV.symm (b i))

/-- `freeToTwisted` sends the `i`-th basis vector of `F` to `(0, b i)`. -/
theorem freeToTwisted_basis (i : Fin d) :
    (twistedRep c).asModuleEquiv (freeToTwisted b e eV c (e i)) = (0, eV.symm (b i)) := by
  rw [freeToTwisted, Module.Basis.constr_basis, LinearEquiv.apply_symm_apply]

include heV in
/-- The projection of the extension onto `M`, which is `k[Γ]`-linear. -/
def twistedToM : (twistedRep c).asModule →ₗ[MonoidAlgebra k Γ] M :=
  ofEquivariantLinearMap
    (eV.toLinearMap ∘ₗ (LinearMap.snd k W V) ∘ₗ (twistedRep c).asModuleEquiv.toLinearMap)
    (fun γ x ↦ by
      simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
        asModuleEquiv_of_smul, twistedRep_apply, LinearMap.snd_apply]
      exact heV γ _)

include heV in
/-- Projecting `freeToTwisted` onto `M` recovers the presentation map. -/
theorem twistedToM_freeToTwisted (x : F) :
    twistedToM eV heV c (freeToTwisted b e eV c x) = presentationMap b e x := by
  refine LinearMap.congr_fun (e.ext (fun i ↦ ?_) :
    (twistedToM eV heV c).comp (freeToTwisted b e eV c) = presentationMap b e) x
  simp only [LinearMap.coe_comp, Function.comp_apply, twistedToM,
    ofEquivariantLinearMap_apply, freeToTwisted_basis, LinearEquiv.coe_coe,
    LinearMap.snd_apply, LinearEquiv.apply_symm_apply, presentationMap_basis]

include heV in
/-- On the relation module, `freeToTwisted` has vanishing second component. -/
theorem freeToTwisted_snd_eq_zero (x : relationModule b e) :
    ((twistedRep c).asModuleEquiv (freeToTwisted b e eV c (x : F))).2 = 0 := by
  have h : eV (((twistedRep c).asModuleEquiv (freeToTwisted b e eV c (x : F))).2) = 0 := by
    have := twistedToM_freeToTwisted b e eV heV c (x : F)
    rw [show presentationMap b e (x : F) = 0 from x.2] at this
    exact this
  simpa using h

include heV heW in
/-- **The `k[Γ]`-linear map out of the relation module attached to a `1`-cocycle.** -/
def relationHomOfCocycle : relationModule b e →ₗ[MonoidAlgebra k Γ] N :=
  ofEquivariantLinearMap
    (eW.toLinearMap ∘ₗ (LinearMap.fst k W V) ∘ₗ
      ((twistedRep c).asModuleEquiv.toLinearMap ∘ₗ
        ((freeToTwisted b e eV c).restrictScalars k).comp
          ((relationModule b e).subtype.restrictScalars k)))
    (fun γ x ↦ by
      have h0 := freeToTwisted_snd_eq_zero b e eV heV c x
      simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
        LinearMap.coe_restrictScalars, Submodule.coe_subtype, Submodule.coe_smul,
        map_smul, asModuleEquiv_of_smul, twistedRep_apply, LinearMap.fst_apply, h0,
        map_zero, add_zero]
      exact heW γ _)

/-- `relationHomOfCocycle c` is the first component of `freeToTwisted` on the relation
module. -/
theorem relationHomOfCocycle_apply (x : relationModule b e) :
    relationHomOfCocycle b e eV eW heV heW c x =
      eW (((twistedRep c).asModuleEquiv (freeToTwisted b e eV c (x : F))).1) := rfl

end Inverse

/-! ### The cocycle correspondence -/

section Equiv

variable {V W : Type w} [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]
  {ρ : Representation k Γ V} {σ : Representation k Γ W}
  (eV : V ≃ₗ[k] M) (eW : W ≃ₗ[k] N)
  (heV : ∀ (γ : Γ) (v : V), eV (ρ γ v) = of k Γ γ • eV v)
  (heW : ∀ (γ : Γ) (x : W), eW (σ γ x) = of k Γ γ • eW x)

/-- `freeToTwisted` sends the section `s(m)` to `(0, m)`. -/
theorem freeToTwisted_section
    (c : groupCohomology.cocycles₁ (Rep.of (Representation.linHom ρ σ))) (m : M) :
    (twistedRep c).asModuleEquiv (freeToTwisted b e eV c (presentationSection b e m)) =
      (0, eV.symm m) := by
  refine LinearMap.congr_fun (b.ext (fun i ↦ ?_) :
    (twistedRep c).asModuleEquiv.toLinearMap ∘ₗ
        ((freeToTwisted b e eV c).restrictScalars k) ∘ₗ presentationSection b e =
      (LinearMap.inr k W V) ∘ₗ eV.symm.toLinearMap) m
  simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.coe_restrictScalars,
    presentationSection_basis, freeToTwisted_basis, LinearEquiv.coe_coe, LinearMap.inr_apply]

include heV heW in
/-- The cocycle of the map attached to a cocycle `c` is `c`. -/
theorem cocycleOfRelationHom_relationHomOfCocycle
    (c : groupCohomology.cocycles₁ (Rep.of (Representation.linHom ρ σ))) :
    cocycleOfRelationHom b e eV eW (ρ := ρ) (relationHomOfCocycle b e eV eW heV heW c) =
      (c : Γ → (V →ₗ[k] W)) := by
  funext γ
  refine LinearMap.ext fun v ↦ ?_
  set m : M := eV (ρ γ⁻¹ v) with hmd
  have hd : ((relationDiscrepancy b e γ m : F)) =
      of k Γ γ • presentationSection b e m - presentationSection b e (of k Γ γ • m) := rfl
  have h1 : (twistedRep c).asModuleEquiv
      (freeToTwisted b e eV c ((relationDiscrepancy b e γ m : F))) =
      (untwist c γ (eV.symm m), 0) := by
    rw [hd, map_sub, map_smul, map_sub, asModuleEquiv_of_smul,
      freeToTwisted_section b e eV c m,
      freeToTwisted_section b e eV c (of k Γ γ • m), symm_smul_of eV heV γ m,
      twistedRep_apply]
    exact Prod.ext (by simp) (by simp)
  rw [cocycleOfRelationHom_apply, relationHomOfCocycle_apply, h1]
  simp only [LinearEquiv.symm_apply_apply, untwist_apply, hmd,
    Representation.self_inv_apply]

/-- `MonoidAlgebra.cocycleOfRelationHom` as a `k`-linear map. -/
def cocycleHom : (relationModule b e →ₗ[MonoidAlgebra k Γ] N) →ₗ[k] (Γ → (V →ₗ[k] W)) where
  toFun φ := cocycleOfRelationHom b e eV eW (ρ := ρ) φ
  map_add' φ ψ := by
    funext γ
    exact LinearMap.ext fun v ↦ by simp [cocycleOfRelationHom_apply]
  map_smul' a φ := by
    funext γ
    exact LinearMap.ext fun v ↦ by simp [cocycleOfRelationHom_apply]

/-- `cocycleHom` is `cocycleOfRelationHom`. -/
@[simp]
theorem cocycleHom_apply (φ : relationModule b e →ₗ[MonoidAlgebra k Γ] N) :
    cocycleHom b e eV eW (ρ := ρ) φ = cocycleOfRelationHom b e eV eW (ρ := ρ) φ := rfl

/-- A map out of the relation module is determined by its cocycle. -/
theorem cocycleHom_injective :
    Function.Injective (cocycleHom b e eV eW (ρ := ρ) (N := N)) := by
  intro φ ψ hφψ
  refine relationHom_ext b e fun γ m ↦ ?_
  have h := congrFun hφψ γ
  have hv := LinearMap.congr_fun h (ρ γ (eV.symm m))
  have hm : eV (ρ γ⁻¹ (ρ γ (eV.symm m))) = m := by
    rw [Representation.inv_self_apply, LinearEquiv.apply_symm_apply]
  rw [cocycleHom_apply, cocycleHom_apply, cocycleOfRelationHom_apply,
    cocycleOfRelationHom_apply, hm] at hv
  exact eW.symm.injective hv

include heV heW in
/-- **A `k[Γ]`-linear map out of the relation module is the same thing as a `1`-cocycle.** -/
def relationHomEquivCocycles : (relationModule b e →ₗ[MonoidAlgebra k Γ] N) ≃ₗ[k]
    groupCohomology.cocycles₁ (Rep.of (Representation.linHom ρ σ)) :=
  LinearEquiv.ofBijective
    ((cocycleHom b e eV eW (ρ := ρ) (N := N)).codRestrict _
      (fun φ ↦ cocycleOfRelationHom_mem b e eV eW heV heW φ))
    ⟨fun φ ψ h ↦ cocycleHom_injective b e eV eW (ρ := ρ) (by
        simpa [LinearMap.codRestrict] using congrArg Subtype.val h),
      fun c ↦ ⟨relationHomOfCocycle b e eV eW heV heW c,
        Subtype.ext (cocycleOfRelationHom_relationHomOfCocycle b e eV eW heV heW c)⟩⟩

/-- The cocycle underlying `relationHomEquivCocycles φ` is `cocycleOfRelationHom φ`. -/
@[simp]
theorem relationHomEquivCocycles_coe
    (φ : relationModule b e →ₗ[MonoidAlgebra k Γ] N) :
    ((relationHomEquivCocycles b e eV eW heV heW φ : Γ → (V →ₗ[k] W))) =
      cocycleOfRelationHom b e eV eW (ρ := ρ) φ := rfl

end Equiv

/-! ### Coboundaries are the maps extending over the free module -/

section Coboundaries

variable {V W : Type w} [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]
  {ρ : Representation k Γ V} {σ : Representation k Γ W}
  (eV : V ≃ₗ[k] M) (eW : W ≃ₗ[k] N)
  (heV : ∀ (γ : Γ) (v : V), eV (ρ γ v) = of k Γ γ • eV v)
  (heW : ∀ (γ : Γ) (x : W), eW (σ γ x) = of k Γ γ • eW x)

include heV heW in
/-- **The cocycle of a map extending over the free module is a coboundary.** -/
theorem cocycleHom_comp_subtype (ψ : F →ₗ[MonoidAlgebra k Γ] N) :
    cocycleHom b e eV eW (ρ := ρ) (ψ.comp (relationModule b e).subtype) =
      (groupCohomology.d₀₁ (Rep.of (Representation.linHom ρ σ))).hom
        (eW.symm.toLinearMap ∘ₗ (ψ.restrictScalars k) ∘ₗ
          presentationSection b e ∘ₗ eV.toLinearMap) := by
  funext γ
  refine LinearMap.ext fun v ↦ ?_
  have hd : ((relationDiscrepancy b e γ (eV (ρ γ⁻¹ v)) : F)) =
      of k Γ γ • presentationSection b e (eV (ρ γ⁻¹ v)) -
        presentationSection b e (of k Γ γ • eV (ρ γ⁻¹ v)) := rfl
  rw [cocycleHom_apply, cocycleOfRelationHom_apply, LinearMap.comp_apply,
    Submodule.subtype_apply, hd, of_smul_eV_inv_apply eV heV, map_sub, map_smul, map_sub,
    symm_smul_of eW heW, groupCohomology.d₀₁_hom_apply]
  simp only [Representation.linHom_apply, LinearMap.sub_apply, LinearMap.coe_comp,
    Function.comp_apply, LinearEquiv.coe_coe, LinearMap.coe_restrictScalars]

include heV heW in
/-- **Every coboundary is the cocycle of a map extending over the free module.** -/
theorem exists_hom_cocycleHom_eq_d₀₁ (f : V →ₗ[k] W) :
    ∃ ψ : F →ₗ[MonoidAlgebra k Γ] N,
      cocycleHom b e eV eW (ρ := ρ) (ψ.comp (relationModule b e).subtype) =
        (groupCohomology.d₀₁ (Rep.of (Representation.linHom ρ σ))).hom f := by
  refine ⟨e.constr k fun i ↦ eW (f (eV.symm (b i))), ?_⟩
  rw [cocycleHom_comp_subtype b e eV eW heV heW]
  congr 1
  have key : ((e.constr k fun i ↦ eW (f (eV.symm (b i)))).restrictScalars k) ∘ₗ
      presentationSection b e = eW.toLinearMap ∘ₗ f ∘ₗ eV.symm.toLinearMap := by
    refine b.ext fun i ↦ ?_
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.coe_restrictScalars,
      presentationSection_basis, Module.Basis.constr_basis, LinearEquiv.coe_coe]
  refine LinearMap.ext fun v ↦ ?_
  have hv := LinearMap.congr_fun key (eV v)
  simp only [LinearMap.coe_comp, Function.comp_apply, LinearMap.coe_restrictScalars,
    LinearEquiv.coe_coe, LinearEquiv.symm_apply_apply] at hv ⊢
  rw [hv, LinearEquiv.symm_apply_apply]

end Coboundaries

/-! ### `Ext¹` over a group algebra is first group cohomology -/

section Main

variable {V W : Type w} [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]
  {ρ : Representation k Γ V} {σ : Representation k Γ W}
  (eV : V ≃ₗ[k] M) (eW : W ≃ₗ[k] N)
  (heV : ∀ (γ : Γ) (v : V), eV (ρ γ v) = of k Γ γ • eV v)
  (heW : ∀ (γ : Γ) (x : W), eW (σ γ x) = of k Γ γ • eW x)
  [HasExt.{t} (ModuleCat.{w} (MonoidAlgebra k Γ))]

include heV heW in
/-- **`Ext¹_{k[Γ]}(M, N)` is `H¹(Γ, Hom_k(M, N))`**, given a free presentation of `M`
determined by a `k`-basis of `M` and a `k[Γ]`-basis of a free module of the same rank. -/
def extOneEquivGroupCohomologyOneOfBasis :
    Abelian.Ext.{t} M N 1 ≃ₗ[k]
      (groupCohomology (Rep.of (Representation.linHom ρ σ)) 1 : Type _) := by
  classical
  set S := (presentationMap b e).shortComplexKer with hSdef
  have hS : S.ShortExact :=
    LinearMap.shortExact_shortComplexKer (presentationMap_surjective b e)
  have : CategoryTheory.Projective S.X₂ := ModuleCat.projective_of_free e
  set Φ : (S.X₁ ⟶ N) ≃ₗ[k]
      groupCohomology.cocycles₁ (Rep.of (Representation.linHom ρ σ)) :=
    (ModuleCat.homLinearEquiv (S := k)).trans
      (relationHomEquivCocycles b e eV eW heV heW) with hΦ
  have hsurj : Function.Surjective
      (groupCohomology.H1π (Rep.of (Representation.linHom ρ σ))).hom :=
    (ModuleCat.epi_iff_surjective _).1 inferInstance
  have hmap : Submodule.map Φ.toLinearMap
      (LinearMap.range (Abelian.Ext.restrictHom (k := k) (S := S) N)) =
      LinearMap.ker (groupCohomology.H1π (Rep.of (Representation.linHom ρ σ))).hom := by
    apply le_antisymm
    · rintro y ⟨x, ⟨χ, rfl⟩, rfl⟩
      rw [LinearMap.mem_ker, groupCohomology.H1π_eq_zero_iff, LinearEquiv.coe_coe]
      have hcoe : ((Φ (Abelian.Ext.restrictHom (k := k) (S := S) N χ) :
            Γ → (V →ₗ[k] W))) =
          cocycleHom b e eV eW (ρ := ρ) (χ.hom.comp (relationModule b e).subtype) := rfl
      rw [hcoe, cocycleHom_comp_subtype b e eV eW heV heW]
      exact ⟨_, rfl⟩
    · intro y hy
      rw [LinearMap.mem_ker, groupCohomology.H1π_eq_zero_iff] at hy
      obtain ⟨f, hf⟩ := hy
      obtain ⟨ψ, hψ⟩ := exists_hom_cocycleHom_eq_d₀₁ b e eV eW heV heW (ρ := ρ) (σ := σ) f
      refine ⟨Φ.symm y, ⟨ModuleCat.ofHom ψ, ?_⟩, Φ.apply_symm_apply y⟩
      apply Φ.injective
      rw [Φ.apply_symm_apply]
      refine Subtype.ext ?_
      change cocycleHom b e eV eW (ρ := ρ) (ψ.comp (relationModule b e).subtype) = _
      rw [hψ, hf]
      rfl
  exact ((Abelian.Ext.extOneQuotientEquiv (k := k) hS N).symm.trans
    ((Submodule.Quotient.equiv _ _ Φ hmap).trans
      (LinearMap.quotKerEquivOfSurjective _ hsurj)))

include heV heW in
/-- **`Ext¹_{k[Γ]}(M, N) = H¹(Γ, Hom_k(M, N))`** for a `k[Γ]`-module `M` which is finite
dimensional over `k`: the free presentation is built from a `k`-basis of `M` and the free
`k[Γ]`-module of the same finite rank. -/
def extOneEquivGroupCohomologyOne [Module.Finite k (M : Type w)] :
    Abelian.Ext.{t} M N 1 ≃ₗ[k]
      (groupCohomology (Rep.of (Representation.linHom ρ σ)) 1 : Type _) :=
  extOneEquivGroupCohomologyOneOfBasis (Module.finBasis k (M : Type w))
    (F := ModuleCat.of (MonoidAlgebra k Γ)
      (Fin (Module.finrank k (M : Type w)) →₀ MonoidAlgebra k Γ))
    Finsupp.basisSingleOne eV eW heV heW

end Main

end MonoidAlgebra

end
