module

public import Mathlib.Algebra.Homology.HomotopyCategory.Acyclic
public import Mathlib.Algebra.Homology.Localization
public import StacksFrontier.Algebra.Homology.KFlat
public import StacksFrontier.Homology.KFlat.LargeUniverse
public import StacksFrontier.Homology.TensorComplex.Monoidal
public import StacksCore.Tactic.StacksAttribute

@[expose] public section

/-!
# K-flat tensor products preserve quasi-isomorphisms

Let `R` be a commutative ring and `K` a K-flat cochain complex of `R`-modules. Tensoring with
`K` and taking the total complex sends quasi-isomorphisms in the homotopy category
`K(Mod_R)` to quasi-isomorphisms.

## Main results

* `CochainComplex.KFlat.kFlat_tright_preserves_quasiIso`: the tensor-total functor `Tright K`
  associated to a K-flat complex `K` preserves quasi-isomorphisms.

## Implementation notes

The total complex of `L ⊗ K` is represented by the right tensor-total functor `Tright K` on the
homotopy category. Preservation of quasi-isomorphisms is expressed as containment in the inverse
image of the quasi-isomorphism morphism property.

The proof passes through the acyclic subcategory. Mathlib's
`HomotopyCategory.quasiIso_eq_trW_subcategoryAcyclic` identifies the quasi-isomorphisms of
`K(Mod_R)` with the class of morphisms generated by `HomotopyCategory.subcategoryAcyclic` under
`ObjectProperty.trW`, so it suffices to know that `Tright K` sends acyclic objects to acyclic
objects — which is exactly K-flatness of `K` — and that `Tright K` is an exact functor of
triangulated categories, which is Stacks tag 064J
(`TotalTensorComplex.tright_isTriangulated`). The transfer from objects to morphisms is then
`ObjectProperty.trW_monotone` together with `ObjectProperty.inverseImage_trW_iff`.

The module universe is independent of the universe of `R`: the modules live in
`Type (max u v)` for an arbitrary `v`, with the tensor product supplied by
`ModuleCat.liftedModuleMonoidalStruct`, and K-flatness is the central
`CochainComplex.KFlat`, which is stated at that same generality. Taking `v = u` recovers the
statement for `ModuleCat.{u} R` directly — there is one predicate here, not a large-universe
variant needing to be reconciled with a same-universe one.

## References

* [The Stacks Project, Tag 06Y0](https://stacks.math.columbia.edu/tag/06Y0)
-/

open CategoryTheory

namespace CochainComplex.KFlat

universe u v

/-- Tensoring with a K-flat complex and taking the total complex preserves
quasi-isomorphisms in the homotopy category. -/
@[stacks 06Y0]
public theorem kFlat_tright_preserves_quasiIso {R : Type u} [CommRing R]
    (K : CochainComplex (ModuleCat.{max u v} R) ℤ) (hK : K.KFlat) :
    HomotopyCategory.quasiIso (ModuleCat.{max u v} R) (ComplexShape.up ℤ) ≤
      (HomotopyCategory.quasiIso (ModuleCat.{max u v} R) (ComplexShape.up ℤ)).inverseImage
        (Tright K) := by
  obtain ⟨_, _⟩ := TotalTensorComplex.tright_isTriangulated K
  rw [HomotopyCategory.quasiIso_eq_trW_subcategoryAcyclic]
  let P := HomotopyCategory.subcategoryAcyclic (ModuleCat.{max u v} R)
  have hobj : P ≤ P.inverseImage (Tright K) := by
    intro X hX
    obtain ⟨L, rfl⟩ := HomotopyCategory.quotient_obj_surjective X
    rw [ObjectProperty.prop_inverseImage_iff]
    change HomotopyCategory.subcategoryAcyclic _
      ((HomotopyCategory.quotient _ _).obj L) at hX
    change HomotopyCategory.subcategoryAcyclic _
      ((HomotopyCategory.quotient _ _).obj ((TrightCochain K).obj L))
    rw [HomotopyCategory.quotient_obj_mem_subcategoryAcyclic_iff_acyclic] at hX ⊢
    exact hK L hX
  intro X Y f hf
  rw [MorphismProperty.inverseImage_iff]
  rw [← ObjectProperty.inverseImage_trW_iff (P := P) (F := Tright K)]
  exact ObjectProperty.trW_monotone hobj _ hf

end CochainComplex.KFlat

end
