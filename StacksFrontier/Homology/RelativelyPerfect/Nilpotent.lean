/-! ### The thickening of the algebra -/

/-- Base change of a surjection with nilpotent kernel along an arbitrary ring map is again
surjective with nilpotent kernel: the kernel of `A → A ⊗[R] S` is contained in the ideal
generated by the image of `Ker(R → S)`, so the `n`-th power of the former vanishes as soon as
the `n`-th power of the latter does. This carries no tag. -/
private lemma nilpotent_ker_includeLeft
    {R S A : Type u} [CommRing R] [CommRing S] [CommRing A]
    [Algebra R S] [Algebra R A]
    (hsurj : Function.Surjective (algebraMap R S))
    (hnil : IsNilpotent (RingHom.ker (algebraMap R S))) :
    Function.Surjective (Algebra.TensorProduct.includeLeftRingHom : A →+* A ⊗[R] S) ∧
      IsNilpotent (RingHom.ker (Algebra.TensorProduct.includeLeftRingHom : A →+* A ⊗[R] S)) := by
  let g : R →ₐ[R] S := Algebra.ofId R S
  let F : A ⊗[R] R →+* A ⊗[R] S :=
    (Algebra.TensorProduct.map (AlgHom.id R A) g).toRingHom
  let e : A ⊗[R] R ≃ₐ[R] A := Algebra.TensorProduct.rid R R A
  let s : A →+* A ⊗[R] R := e.symm.toRingHom
  have hf : (Algebra.TensorProduct.includeLeftRingHom : A →+* A ⊗[R] S) = F.comp s := by
    ext a
    simp [F, s, e, g, Algebra.TensorProduct.rid_symm_apply]
  have hsurj' : Function.Surjective
      (Algebra.TensorProduct.includeLeftRingHom : A →+* A ⊗[R] S) := by
    rw [hf]
    show Function.Surjective (F ∘ s)
    exact (Algebra.TensorProduct.map_surjective (AlgHom.id R A) g (fun a => ⟨a, rfl⟩)
      hsurj).comp e.symm.surjective
  have hkerF : RingHom.ker F =
      Ideal.map (Algebra.TensorProduct.includeRight : R →ₐ[R] A ⊗[R] R)
        (RingHom.ker (algebraMap R S)) :=
    Algebra.TensorProduct.lTensor_ker g hsurj
  have hker_le : RingHom.ker (Algebra.TensorProduct.includeLeftRingHom : A →+* A ⊗[R] S) ≤
      Ideal.map (algebraMap R A) (RingHom.ker (algebraMap R S)) := by
    intro a ha
    have hsa : s a ∈ RingHom.ker F := by
      rw [hf] at ha
      simpa only [RingHom.mem_ker, RingHom.comp_apply] using ha
    rw [hkerF] at hsa
    have hmap := Ideal.mem_map_of_mem e.toAlgHom hsa
    rw [Ideal.map_mapₐ] at hmap
    have he : e.toAlgHom.comp
        (Algebra.TensorProduct.includeRight : R →ₐ[R] A ⊗[R] R) = Algebra.ofId R A := by
      ext
    rw [he] at hmap
    show a ∈ Ideal.map (Algebra.ofId R A) (RingHom.ker (algebraMap R S))
    simpa [s] using hmap
  refine ⟨hsurj', ?_⟩
  obtain ⟨n, hn⟩ := hnil
  refine ⟨n, le_antisymm ?_ bot_le⟩
  calc
    RingHom.ker (Algebra.TensorProduct.includeLeftRingHom : A →+* A ⊗[R] S) ^ n ≤
      (Ideal.map (algebraMap R A) (RingHom.ker (algebraMap R S))) ^ n :=
      pow_le_pow_left₀ bot_le hker_le n
    _ = ⊥ := by
      rw [← Ideal.map_pow, hn]
      simp

section Thickening

attribute [local instance] Algebra.TensorProduct.rightAlgebra

/-! ### Tor amplitude does not depend on the certificate -/

/-- Tor amplitude against a bifunctor certified as in Stacks 0652 agrees with Tor amplitude
against the derived tensoring datum of Stacks 0655 determined by the canonical derived tensor
product of Stacks 0BYI.

The certificate makes each `- ⊗ᴸ M[0]` a total left derived functor of termwise tensoring by
`M`, and so does the canonical certificate of the canonical bifunctor, so the two functors are
identified by uniqueness of total left derived functors. This carries no tag. -/
private lemma hasTorAmplitude_iff_canonical {R : Type u} [CommRing R]
    (derivedTensor :
      DerivedCategory (ModuleCat.{u} R) ⥤
        DerivedCategory (ModuleCat.{u} R) ⥤ DerivedCategory (ModuleCat.{u} R))
    (comparison : ∀ M : ModuleCat.{u} R,
      DerivedCategory.Q ⋙
          derivedTensor.flip.obj ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj M) ⟶
        (tensorModuleRight M).mapHomologicalComplex (ComplexShape.up ℤ) ⋙ DerivedCategory.Q)
    (isLeftDerived : ∀ M : ModuleCat.{u} R,
      (derivedTensor.flip.obj
          ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj M)).IsLeftDerivedFunctor
        (comparison M)
        (HomologicalComplex.quasiIso (ModuleCat.{u} R) (ComplexShape.up ℤ)))
    (K : DerivedCategory (ModuleCat.{u} R)) (a b : ℤ) :
    HasTorAmplitude derivedTensor comparison isLeftDerived K a b ↔
      Stacks.TorAmplitudeTriangle.HasTorAmplitudeIn
        (derivedTensoringOfCertified
          (CochainComplex.DerivedTensor.canonicalDerivedTensorProduct R)) K a b := by
  rw [hasTorAmplitudeIn_iff_hasTorAmplitude
    (CochainComplex.DerivedTensor.canonicalDerivedTensorProduct R)
    (canonicalTensorComparison R) (canonicalTensorIsLeftDerived R) K a b]
  have key : ∀ M : ModuleCat.{u} R,
      (derivedTensor.obj K).obj ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj M) ≅
        ((CochainComplex.DerivedTensor.canonicalDerivedTensorProduct R).tensor.obj K).obj
          ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj M) := by
    intro M
    have := isLeftDerived M
    have := canonicalTensorIsLeftDerived R M
    exact (Functor.leftDerivedNatIso
      (derivedTensor.flip.obj ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj M))
      ((CochainComplex.DerivedTensor.canonicalDerivedTensorProduct R).tensor.flip.obj
        ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj M))
      (comparison M) (canonicalTensorComparison R M)
      (HomologicalComplex.quasiIso (ModuleCat.{u} R) (ComplexShape.up ℤ)) (Iso.refl _)).app K
  exact ⟨fun h M i hi => (h M i hi).of_iso
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} R) i).mapIso (key M)).symm,
    fun h M i hi => (h M i hi).of_iso
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} R) i).mapIso (key M))⟩

/-! ### Stacks 0DJG -/

set_option backward.isDefEq.respectTransparency false in
/-- **Stacks 0DJG.** Let `R' → A'` be a flat ring map of finite presentation, let `R' → R` be a
surjective ring map whose kernel is a nilpotent ideal and set `A = A' ⊗[R'] R`. If the derived
extension of scalars of `K' ∈ D(A')` to `A` is perfect relative to `R`, then `K'` is perfect
relative to `R'`. -/
@[stacks 0DJG]
theorem isRelativelyPerfect_of_derivedExtensionScalars
    {R' A' R : Type u} [CommRing R'] [CommRing A'] [CommRing R]
    [Algebra R' A'] [Algebra R' R] [Module.Flat R' A']
    [Algebra.FinitePresentation R' A']
    (hsurj : Function.Surjective (algebraMap R' R))
    (hnil : IsNilpotent (RingHom.ker (algebraMap R' R)))
    (derivedTensorR' :
      DerivedCategory (ModuleCat.{u} R') ⥤
        DerivedCategory (ModuleCat.{u} R') ⥤ DerivedCategory (ModuleCat.{u} R'))
    (comparisonR' : ∀ M : ModuleCat.{u} R',
      DerivedCategory.Q ⋙
          derivedTensorR'.flip.obj ((DerivedCategory.singleFunctor (ModuleCat.{u} R') 0).obj M) ⟶
        (tensorModuleRight M).mapHomologicalComplex (ComplexShape.up ℤ) ⋙ DerivedCategory.Q)
    (isLeftDerivedR' : ∀ M : ModuleCat.{u} R',
      (derivedTensorR'.flip.obj
          ((DerivedCategory.singleFunctor (ModuleCat.{u} R') 0).obj M)).IsLeftDerivedFunctor
        (comparisonR' M)
        (HomologicalComplex.quasiIso (ModuleCat.{u} R') (ComplexShape.up ℤ)))
    (derivedTensorR :
      DerivedCategory (ModuleCat.{u} R) ⥤
        DerivedCategory (ModuleCat.{u} R) ⥤ DerivedCategory (ModuleCat.{u} R))
    (comparisonR : ∀ M : ModuleCat.{u} R,
      DerivedCategory.Q ⋙
          derivedTensorR.flip.obj ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj M) ⟶
        (tensorModuleRight M).mapHomologicalComplex (ComplexShape.up ℤ) ⋙ DerivedCategory.Q)
    (isLeftDerivedR : ∀ M : ModuleCat.{u} R,
      (derivedTensorR.flip.obj
          ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj M)).IsLeftDerivedFunctor
        (comparisonR M)
        (HomologicalComplex.quasiIso (ModuleCat.{u} R) (ComplexShape.up ℤ)))
    (K' : DerivedCategory (ModuleCat.{u} A')) :
    let A := A' ⊗[R'] R
    let e : (R ⊗[R'] A') ≃ₐ[R] A :=
      AlgEquiv.ofRingEquiv (f := (Algebra.TensorProduct.comm R' R A').toRingEquiv)
        (fun r => by
          change (Algebra.TensorProduct.comm R' R A')
            (algebraMap R (R ⊗[R'] A') r) = _
          rw [Algebra.TensorProduct.algebraMap_apply, Algebra.algebraMap_self_apply,
            Algebra.TensorProduct.comm_tmul]
          rfl)
    letI : Module.Flat R A := Module.Flat.of_linearEquiv e.symm.toLinearEquiv
    letI : Algebra.FinitePresentation R A := Algebra.FinitePresentation.equiv e
    let f : A' →+* A := Algebra.TensorProduct.includeLeftRingHom
    IsRelativelyPerfect.{u, u, u} derivedTensorR comparisonR isLeftDerivedR
        ((totalDerivedExtensionScalars.{u, u, u} f).functor.obj K') →
      IsRelativelyPerfect.{u, u, u} derivedTensorR' comparisonR' isLeftDerivedR' K' := by
  dsimp only
  intro hK
  obtain ⟨hfsurj, hfnil⟩ :=
    nilpotent_ker_includeLeft (A := A') (S := R) hsurj hnil
  refine ⟨(StacksDraft.Perfect.isPseudoCoherent_derivedExtensionScalars_iff
      (Algebra.TensorProduct.includeLeftRingHom : A' →+* A' ⊗[R'] R) hfsurj hfnil K').mp hK.1, ?_⟩
  obtain ⟨a, b, hab⟩ := hK.2
  refine ⟨a, b, ?_⟩
  let Tg := totalDerivedExtensionScalars.{u, u, u} (algebraMap R' R)
  let Th := totalDerivedExtensionScalars.{u, u, u} (algebraMap A' (A' ⊗[R'] R))
  let ResR' := (ModuleCat.restrictScalars (algebraMap R' A')).mapDerivedCategory
  let cmp := (derivedBaseChangeComparison.{u, u, u, u, u, u + 1, u + 1, u + 1, u + 1}
    (algebraMap R' A') (algebraMap R' R) (algebraMap A' (A' ⊗[R'] R))
    (algebraMap R (A' ⊗[R'] R))
    ((IsScalarTower.algebraMap_eq R' A' (A' ⊗[R'] R)).symm.trans
      (IsScalarTower.algebraMap_eq R' R (A' ⊗[R'] R)))
    Tg.functor Th.functor Tg.comparison Th.comparison).2.1
  have : IsIso cmp := derivedBaseChangeComparison_isIso_of_torIndependent.{u, u, u, u, u,
      u + 1, u + 1, u + 1, u + 1} (R := R') (A := A') (R' := R) (A' := A' ⊗[R'] R)
    torIndependent_of_flat Tg.functor Th.functor Tg.comparison Th.comparison
  have hbase : HasTorAmplitude derivedTensorR comparisonR isLeftDerivedR
      (Tg.functor.obj (ResR'.obj K')) a b :=
    (hasTorAmplitude_of_iso (asIso (cmp.app K')) a b).mpr hab
  have := Tg.isLeftDerived
  exact (hasTorAmplitude_iff_canonical derivedTensorR' comparisonR' isLeftDerivedR'
      (ResR'.obj K') a b).mpr
    ((hasTorAmplitudeIn_derivedExtensionScalars_iff_sameUniverse (algebraMap R' R) hsurj hnil
      Tg.functor Tg.comparison
      (CochainComplex.DerivedTensor.canonicalDerivedTensorProduct R')
      (CochainComplex.DerivedTensor.canonicalDerivedTensorProduct R)
      (ResR'.obj K') a b).mp
      ((hasTorAmplitude_iff_canonical derivedTensorR comparisonR isLeftDerivedR
        (Tg.functor.obj (ResR'.obj K')) a b).mp hbase))

end Thickening

end PseudoCoherence
