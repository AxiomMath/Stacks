/-! ### The regular module generates the derived category -/

/-- The regular module is a compact object of the category of `R`-modules: a homomorphism out of
`R` is determined by the image of `1`, which lies in a finite subsum. -/
private lemma moduleCat_isCompactObject_of_finite
    {R : Type u} [Ring R] {M : Type v} [AddCommGroup M] [Module R M]
    [HasCoproducts.{v} (ModuleCat.{v} R)]
    (hM : Module.Finite R M) :
    IsCompactObject.{v} (ModuleCat.of R M) := by
  classical
  let : Preadditive (ModuleCat.{v} R) := ModuleCat.instPreadditive
  let : Module.Finite R M := hM
  constructor
  intro J _ E _
  refine ⟨StacksDraft.Perfect.injective_directSumToHom _ E, ?_⟩
  intro f
  obtain ⟨n, g, hg⟩ := Module.Finite.exists_fin (R := R) (M := M)
  let e := ModuleCat.coprodIsoDirectSum E
  let φ : M →ₗ[R] DirectSum J (fun j => (E j : Type v)) := e.hom.hom.comp f.hom
  let s : Finset J := Finset.univ.biUnion fun i : Fin n => (φ (g i)).support
  let a (j : J) : ModuleCat.of R M ⟶ E j :=
    ModuleCat.ofHom ((DirectSum.component R J (fun j => (E j : Type v)) j).comp φ)
  have hgen (i : Fin n) :
      ∑ j ∈ s, DFinsupp.single j (φ (g i) j) = φ (g i) := by
    have hsmall :
        ∑ j ∈ (φ (g i)).support, DFinsupp.single j (φ (g i) j) = φ (g i) := by
      change (φ (g i)).sum DFinsupp.single = _
      exact DFinsupp.sum_single
    have hsub : (φ (g i)).support ⊆ s :=
      Finset.subset_biUnion_of_mem (s := Finset.univ)
        (u := fun i : Fin n => (φ (g i)).support) (Finset.mem_univ i)
    calc
      ∑ j ∈ s, DFinsupp.single j (φ (g i) j) =
          ∑ j ∈ (φ (g i)).support, DFinsupp.single j (φ (g i) j) := by
        symm
        apply Finset.sum_subset hsub
        intro j hj hjs
        simp [DFinsupp.notMem_support_iff.mp hjs]
      _ = φ (g i) := hsmall
  refine ⟨∑ j ∈ s, DirectSum.of _ j (a j), ?_⟩
  apply (cancel_mono e.hom).1
  simp only [map_sum, DirectSum.toAddMonoid_of, Preadditive.rightComp,
    AddMonoidHom.mk'_apply, Preadditive.sum_comp, Category.assoc]
  simp only [e, ModuleCat.ι_coprodIsoDirectSum_hom]
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro m
  have hm : m ∈ Submodule.span R (Set.range g) := by
    rw [hg]
    exact Submodule.mem_top
  refine Submodule.span_induction ?_ ?_ ?_ ?_ hm
  · rintro x ⟨i, rfl⟩
    simp only [ModuleCat.hom_sum, ModuleCat.hom_comp, ModuleCat.hom_ofHom,
      LinearMap.sum_apply, LinearMap.comp_apply, a]
    change ∑ j ∈ s, DFinsupp.single j ((φ (g i)) j) = φ (g i)
    exact hgen i
  · simp [a, φ]
  · intro x y hx hy hpx hpy
    rw [map_add, hpx, hpy, map_add]
  · intro r x hx hpx
    rw [map_smul, hpx, map_smul]

