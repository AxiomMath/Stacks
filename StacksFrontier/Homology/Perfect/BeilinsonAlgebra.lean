/-- The upper triangular algebra with `(i, j)` entry the homogeneous polynomials
of degree `j - i` in `k[X₀, ..., Xₙ]`. -/
noncomputable def beilinsonAlgebra (k : Type u) [Field k] (n : ℕ) :
    Subalgebra k (Matrix (Fin (n + 1)) (Fin (n + 1)) (MvPolynomial (Fin (n + 1)) k)) :=
  Algebra.adjoin k {A | ∀ i j,
    (i ≤ j → (A i j).IsHomogeneous (j - i)) ∧ (j < i → A i j = 0)}

private def homogeneousMatrixSubalgebra (k : Type u) [Field k] (n : ℕ) :
    Subalgebra k (Matrix (Fin (n + 1)) (Fin (n + 1))
      (MvPolynomial (Fin (n + 1)) k)) where
  carrier := {A | ∀ i j,
    (i ≤ j → (A i j).IsHomogeneous (j - i)) ∧ (j < i → A i j = 0)}
  zero_mem' := by
    intro i j
    exact ⟨fun _ => MvPolynomial.isHomogeneous_zero _ _ _, fun _ => rfl⟩
  one_mem' := by
    intro i j
    constructor
    · intro hij
      by_cases h : i = j
      · subst j
        simpa using (MvPolynomial.isHomogeneous_C (Fin (n + 1)) (1 : k))
      · rw [Matrix.one_apply, ite_eq_right h]
        exact MvPolynomial.isHomogeneous_zero _ _ _
    · intro hji
      simp [ne_of_gt hji]
  add_mem' := by
    intro A B hA hB i j
    constructor
    · intro hij
      exact (hA i j).1 hij |>.add ((hB i j).1 hij)
    · intro hji
      change A i j + B i j = 0
      rw [(hA i j).2 hji, (hB i j).2 hji]
      simp
  mul_mem' := by
    intro A B hA hB i j
    constructor
    · intro hij
      rw [Matrix.mul_apply]
      apply MvPolynomial.IsHomogeneous.sum
      intro x hx
      by_cases hix : i ≤ x
      · by_cases hxj : x ≤ j
        · have hm := ((hA i x).1 hix).mul ((hB x j).1 hxj)
          change (A i x * B x j).IsHomogeneous _ at hm
          have hdeg : (↑x : ℕ) - ↑i + (↑j - ↑x) = ↑j - ↑i := by omega
          simpa only [Fin.sub_val_of_le hix, Fin.sub_val_of_le hxj, hdeg] using hm
        · have hzero : B x j = 0 := (hB x j).2 (by omega)
          rw [hzero, mul_zero]
          exact MvPolynomial.isHomogeneous_zero _ _ _
      · have hzero : A i x = 0 := (hA i x).2 (by omega)
        rw [hzero, zero_mul]
        exact MvPolynomial.isHomogeneous_zero _ _ _
    · intro hji
      rw [Matrix.mul_apply]
      apply Finset.sum_eq_zero
      intro x hx
      by_cases hix : i ≤ x
      · have hxj : j < x := by omega
        rw [(hB x j).2 hxj, mul_zero]
      · rw [(hA i x).2 (by omega), zero_mul]
  algebraMap_mem' := by
    intro r i j
    constructor
    · intro hij
      by_cases h : i = j
      · subst j
        simpa [Matrix.algebraMap_matrix_apply] using
          (MvPolynomial.isHomogeneous_C (Fin (n + 1)) r)
      · rw [Matrix.algebraMap_matrix_apply, ite_eq_right h]
        exact MvPolynomial.isHomogeneous_zero _ _ _
    · intro hji
      simp [Matrix.algebraMap_matrix_apply, ne_of_gt hji]

private lemma beilinsonAlgebra_eq_homogeneousMatrixSubalgebra
    (k : Type u) [Field k] (n : ℕ) :
    beilinsonAlgebra k n = homogeneousMatrixSubalgebra k n := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    intro A hA
    exact hA
  · intro A hA
    exact Algebra.subset_adjoin hA

private lemma beilinsonAlgebra_entry_property
    (k : Type u) [Field k] (n : ℕ) (A : beilinsonAlgebra k n) (i j : Fin (n + 1)) :
    (i ≤ j → (A.val i j).IsHomogeneous (j - i)) ∧ (j < i → A.val i j = 0) := by
  have hsubset : beilinsonAlgebra k n ≤ homogeneousMatrixSubalgebra k n := by
    apply Algebra.adjoin_le
    intro B hB
    exact hB
  let A' : homogeneousMatrixSubalgebra k n := ⟨A.val, hsubset A.property⟩
  exact A'.property i j

private lemma single_diagonal_mem_generators
    (k : Type u) [Field k] (n : ℕ) (i : Fin (n + 1)) :
    Matrix.single i i (1 : MvPolynomial (Fin (n + 1)) k) ∈
      {A | ∀ a b,
        (a ≤ b → (A a b).IsHomogeneous (b - a)) ∧ (b < a → A a b = 0)} := by
  intro a b
  constructor
  · intro hab
    by_cases h : i = a ∧ i = b
    · rcases h with ⟨rfl, rfl⟩
      simp only [Matrix.single_apply_same]
      simpa using (MvPolynomial.isHomogeneous_C (Fin (n + 1)) (1 : k))
    · simpa [Matrix.single_apply, h] using
        (MvPolynomial.isHomogeneous_zero (Fin (n + 1)) k (b - a))
  · intro hba
    have h : ¬ (i = a ∧ i = b) := by
      rintro ⟨rfl, rfl⟩
      omega
    simp [h]

private noncomputable def diagonalIdempotent
    (k : Type u) [Field k] (n : ℕ) (i : Fin (n + 1)) : beilinsonAlgebra k n :=
  ⟨Matrix.single i i (1 : MvPolynomial (Fin (n + 1)) k),
    Algebra.subset_adjoin (single_diagonal_mem_generators k n i)⟩

private lemma diagonalIdempotent_mul_self
    (k : Type u) [Field k] (n : ℕ) (i : Fin (n + 1)) :
    diagonalIdempotent k n i * diagonalIdempotent k n i = diagonalIdempotent k n i := by
  apply Subtype.ext
  change Matrix.single i i (1 : MvPolynomial (Fin (n + 1)) k) *
      Matrix.single i i 1 = Matrix.single i i 1
  simp

/-- The row module cut out by a diagonal vertex idempotent is projective: it is the image of
the idempotent right-multiplication map on the regular module. -/
private lemma diagonalRow_projective
    (k : Type u) [Field k] (n : ℕ) (i : Fin (n + 1)) :
    Module.Projective (beilinsonAlgebra k n)ᵐᵒᵖ
      (LinearMap.range (LinearMap.mulRight ((beilinsonAlgebra k n)ᵐᵒᵖ) (MulOpposite.op
        (diagonalIdempotent k n i)))) := by
  let A := beilinsonAlgebra k n
  let : Ring A := inferInstance
  let R := Aᵐᵒᵖ
  let : Ring R := inferInstance
  let e : R := MulOpposite.op (diagonalIdempotent k n i)
  let f : R →ₗ[R] R := LinearMap.mulRight R e
  have he : e * e = e := by
    change MulOpposite.op (diagonalIdempotent k n i * diagonalIdempotent k n i) = e
    rw [diagonalIdempotent_mul_self]
  have hf (x : R) : f (f x) = f x := by
    change (x * e) * e = x * e
    rw [mul_assoc, he]
  let : Module.Projective R R := inferInstance
  apply Module.Projective.of_split (LinearMap.range f).subtype f.rangeRestrict
  ext x
  change f x = x
  obtain ⟨y, hy⟩ := x.property
  rw [← hy]
  exact hf y

private lemma diagonalRow_moduleFinite
    (k : Type u) [Field k] (n : ℕ) (i : Fin (n + 1)) :
    Module.Finite ((beilinsonAlgebra k n)ᵐᵒᵖ)
      (LinearMap.range (LinearMap.mulRight ((beilinsonAlgebra k n)ᵐᵒᵖ)
        (MulOpposite.op (diagonalIdempotent k n i)))) := by
  let R := (beilinsonAlgebra k n)ᵐᵒᵖ
  let e := MulOpposite.op (diagonalIdempotent k n i)
  let f : R →ₗ[R] R := LinearMap.mulRight R e
  exact Module.Finite.of_surjective f.rangeRestrict (fun x => by
    obtain ⟨y, hy⟩ := x.property
    exact ⟨y, Subtype.ext hy⟩)

private lemma diagonalRow_vanishesAtLT
    (k : Type u) [Field k] (n : ℕ) (i j : Fin (n + 1)) (hji : j < i) :
    ∀ x : LinearMap.range (LinearMap.mulRight ((beilinsonAlgebra k n)ᵐᵒᵖ)
        (MulOpposite.op (diagonalIdempotent k n i))),
      MulOpposite.op (diagonalIdempotent k n j) • x = 0 := by
  intro x
  obtain ⟨y, hy⟩ := x.property
  apply Subtype.ext
  change MulOpposite.op (diagonalIdempotent k n j) * x.val = 0
  rw [← hy]
  change MulOpposite.op (diagonalIdempotent k n j) *
      (y * MulOpposite.op (diagonalIdempotent k n i)) = 0
  apply MulOpposite.unop_injective
  simp only [MulOpposite.unop_mul, MulOpposite.unop_op]
  apply Subtype.ext
  change Matrix.single i i (1 : MvPolynomial (Fin (n + 1)) k) *
      y.unop.val * Matrix.single j j 1 = 0
  have hentry := (beilinsonAlgebra_entry_property k n y.unop i j).2 hji
  rw [Matrix.single_mul_mul_single]
  simp [hentry]

private lemma sum_diagonalIdempotents (k : Type u) [Field k] (n : ℕ) :
    ∑ i : Fin (n + 1), diagonalIdempotent k n i = 1 := by
  apply Subtype.ext
  change (beilinsonAlgebra k n).val (∑ i : Fin (n + 1), diagonalIdempotent k n i) =
    (beilinsonAlgebra k n).val 1
  rw [map_sum]
  simpa [diagonalIdempotent] using
    (Matrix.sum_single_one :
      (∑ i : Fin (n + 1), Matrix.single i i
        (1 : MvPolynomial (Fin (n + 1)) k)) = 1)

private lemma finite_beilinsonAlgebra (k : Type u) [Field k] (n : ℕ) :
    Module.Finite k (beilinsonAlgebra k n) := by
  rw [beilinsonAlgebra_eq_homogeneousMatrixSubalgebra]
  let F := Fin (n + 1)
  let E : F → F → Type u := fun i j => MvPolynomial.homogeneousSubmodule F k (j - i)
  have (i : F) (j : F) : Module.Finite k (E i j) :=
    Module.Finite.of_fg (MvPolynomial.homogeneousSubmodule_fg F k (j - i))
  have : Module.Finite k (∀ i j : F, E i j) := Module.Finite.pi
  let f : homogeneousMatrixSubalgebra k n →ₗ[k] (∀ i j : F, E i j) := {
    toFun A i j := ⟨A.val i j, by
      by_cases hij : i ≤ j
      · exact (A.property i j).1 hij
      · have hji : j < i := lt_of_not_ge hij
        rw [(A.property i j).2 hji]
        exact (MvPolynomial.homogeneousSubmodule F k (j - i)).zero_mem⟩
    map_add' A B := by ext i j; rfl
    map_smul' r A := by ext i j; rfl }
  apply FiniteDimensional.of_injective f
  intro A B h
  apply Subtype.ext
  apply Matrix.ext
  intro i j
  exact congrArg Subtype.val (congrFun (congrFun h i) j)

private lemma finiteLength_of_finiteDimensional_base
    {k A M : Type*} [Field k] [Ring A] [AddCommGroup M]
    [Module k A] [IsScalarTower k A A] [Module k M] [Module A M]
    [IsScalarTower k A M]
    (hM : Module.Finite k M) : IsFiniteLength A M := by
  let : Module.Finite k M := hM
  have : IsArtinian A M := isArtinian_of_tower k inferInstance
  have : IsNoetherian A M := isNoetherian_of_tower k inferInstance
  exact isFiniteLength_iff_isNoetherian_isArtinian.mpr ⟨inferInstance, inferInstance⟩

private lemma diagonalRow_finiteLength
    (k : Type u) [Field k] (n : ℕ) (i : Fin (n + 1)) :
    IsFiniteLength (beilinsonAlgebra k n)ᵐᵒᵖ
      (LinearMap.range (LinearMap.mulRight ((beilinsonAlgebra k n)ᵐᵒᵖ)
        (MulOpposite.op (diagonalIdempotent k n i)))) := by
  let A := beilinsonAlgebra k n
  let R := Aᵐᵒᵖ
  let M := LinearMap.range (LinearMap.mulRight R
    (MulOpposite.op (diagonalIdempotent k n i)))
  have hA : Module.Finite k R := by
    let : Module.Finite k A := finite_beilinsonAlgebra k n
    infer_instance
  have hM : Module.Finite k M := by
    let : Module.Finite k R := hA
    infer_instance
  exact finiteLength_of_finiteDimensional_base hM


private lemma diagonalRow_isCompact_small
    (k : Type u) [Field k] (n : ℕ) [Small.{v} (beilinsonAlgebra k n)]
    (i : Fin (n + 1)) :
    IsCompactObject.{v} ((DerivedCategory.singleFunctor
      (ModuleCat.{v} ((beilinsonAlgebra k n)ᵐᵒᵖ)) 0).obj
      (ModuleCat.of ((beilinsonAlgebra k n)ᵐᵒᵖ)
        (Shrink.{v} (LinearMap.range (LinearMap.mulRight ((beilinsonAlgebra k n)ᵐᵒᵖ)
          (MulOpposite.op (diagonalIdempotent k n i))))))) := by
  let R := (beilinsonAlgebra k n)ᵐᵒᵖ
  let row := LinearMap.range (LinearMap.mulRight R
    (MulOpposite.op (diagonalIdempotent k n i)))
  have : Module.Projective R row := diagonalRow_projective k n i
  have : Module.Finite R row := diagonalRow_moduleFinite k n i
  have : Module.Projective R (Shrink.{v} row) :=
    Module.Projective.of_equiv (Shrink.linearEquiv R row).symm
  have : Module.Finite R (Shrink.{v} row) :=
    Module.Finite.equiv (Shrink.linearEquiv R row).symm
  have : Projective (ModuleCat.of R (Shrink.{v} row)) :=
    ModuleCat.projective_of_categoryTheory_projective _
  have : IsCompactObject.{v} (ModuleCat.of R (Shrink.{v} row)) :=
    CompactSupport.moduleCat_isCompactObject_of_finite inferInstance
  exact StacksDraft.Perfect.isCompactObject_derived_single _ 0

private def VanishesAtLE (R M : Type*) [Semiring R] [AddCommMonoid M] [Module R M]
    {n : ℕ} (e : Fin (n + 1) → R) (i : Fin (n + 1)) : Prop :=
  ∀ j, j ≤ i → ∀ x : M, e j • x = 0

private lemma diagonalRow_vertexProjection
    (k : Type u) [Field k] (n : ℕ) (i : Fin (n + 1))
    (x : LinearMap.range (LinearMap.mulRight ((beilinsonAlgebra k n)ᵐᵒᵖ)
      (MulOpposite.op (diagonalIdempotent k n i)))) :
    ∃ c : k, MulOpposite.op (diagonalIdempotent k n i) • x =
      (algebraMap k ((beilinsonAlgebra k n)ᵐᵒᵖ) c) •
        (⟨MulOpposite.op (diagonalIdempotent k n i), by
          refine ⟨1, ?_⟩
          simp [LinearMap.mulRight]⟩ :
          LinearMap.range (LinearMap.mulRight ((beilinsonAlgebra k n)ᵐᵒᵖ)
            (MulOpposite.op (diagonalIdempotent k n i)))) := by
  let R := (beilinsonAlgebra k n)ᵐᵒᵖ
  let e : R := MulOpposite.op (diagonalIdempotent k n i)
  obtain ⟨y, hy⟩ := x.property
  let c : k := (y.unop.val i i).coeff 0
  have hhom : (y.unop.val i i).IsHomogeneous 0 := by
    simpa using (beilinsonAlgebra_entry_property k n y.unop i i).1 le_rfl
  have hconst : y.unop.val i i = MvPolynomial.C c := by
    have hdegree : (y.unop.val i i).totalDegree = 0 :=
      (MvPolynomial.totalDegree_zero_iff_isHomogeneous (σ := Fin (n + 1))).mpr hhom
    exact (MvPolynomial.totalDegree_eq_zero_iff_eq_C).mp hdegree
  refine ⟨c, ?_⟩
  apply Subtype.ext
  change e * x.val = algebraMap k R c * e
  rw [← hy]
  change e * (y * e) = algebraMap k R c * e
  apply MulOpposite.unop_injective
  change MulOpposite.unop
      (MulOpposite.op (diagonalIdempotent k n i) *
        (y * MulOpposite.op (diagonalIdempotent k n i))) =
    MulOpposite.unop
      (algebraMap k R c * MulOpposite.op (diagonalIdempotent k n i))
  rw [MulOpposite.unop_mul, MulOpposite.unop_mul, MulOpposite.unop_op,
    MulOpposite.unop_mul, MulOpposite.unop_op]
  apply Subtype.ext
  change Matrix.single i i (1 : MvPolynomial (Fin (n + 1)) k) *
      y.unop.val * Matrix.single i i 1 =
    Matrix.single i i (1 : MvPolynomial (Fin (n + 1)) k) *
      (algebraMap k (beilinsonAlgebra k n) c).val
  rw [Matrix.single_mul_mul_single, hconst]
  ext a b
  simp [Matrix.mul_apply, Matrix.algebraMap_matrix_apply, Matrix.single_apply]

private lemma isCompactObject_single_of_isFiniteLength_of_vanishesAtLE
    {R : Type u} [Ring R] [HasCoproducts.{v} (DerivedCategory (ModuleCat.{v} R))]
    {M : Type v} [AddCommGroup M] [Module R M] {n : ℕ}
    (e : Fin (n + 1) → R) (i : Fin (n + 1))
    (hM : IsFiniteLength R M)
    (hvanish : VanishesAtLE R M e i)
    (hSimple : ∀ (N : Type v) [AddCommGroup N] [Module R N] [IsSimpleModule R N],
      VanishesAtLE R N e i →
      IsCompactObject.{v} ((DerivedCategory.singleFunctor (ModuleCat.{v} R) 0).obj
        (ModuleCat.of R N))) :
    IsCompactObject.{v} ((DerivedCategory.singleFunctor (ModuleCat.{v} R) 0).obj
      (ModuleCat.of R M)) := by
  induction hM with
  | @of_subsingleton M _ _ hsub =>
      let : Subsingleton M := hsub
      have hzero : IsZero (ModuleCat.of R M) := ModuleCat.isZero_iff_subsingleton.mpr inferInstance
      have hsingle : IsZero ((DerivedCategory.singleFunctor (ModuleCat.{v} R) 0).obj
          (ModuleCat.of R M)) := Functor.map_isZero _ hzero
      constructor
      intro I _ E _
      exact ⟨fun a b _ => DFinsupp.ext fun j => hsingle.eq_of_src _ _,
        fun t => ⟨0, hsingle.eq_of_src _ _⟩⟩
  | @of_simple_quotient M _ _ N hN hNfinite ih =>
      have hNvanish : VanishesAtLE R N e i := by
        intro j hj x
        apply Subtype.ext
        exact hvanish j hj x
      have hQvanish : VanishesAtLE R (M ⧸ N) e i := by
        intro j hj x
        obtain ⟨y, rfl⟩ := N.mkQ_surjective x
        change N.mkQ (e j • y) = 0
        rw [hvanish j hj y]
        simp
      let hExact := LinearMap.exact_subtype_mkQ N
      let S := ModuleCat.shortComplexOfConj (LinearEquiv.refl R N)
        (LinearEquiv.refl R M) (LinearEquiv.refl R (M ⧸ N)) N.subtype N.mkQ
        hExact.linearMap_comp_eq_zero
      have hSq : S.ShortExact := ModuleCat.shortComplexOfConj_shortExact
        (LinearEquiv.refl R N) (LinearEquiv.refl R M) (LinearEquiv.refl R (M ⧸ N))
        N.subtype N.mkQ hExact N.subtype_injective N.mkQ_surjective
      let T := hSq.singleTriangle.invRotate
      have hT : T ∈ distTriang (DerivedCategory (ModuleCat.{v} R)) :=
        Pretriangulated.inv_rot_of_distTriang _ hSq.singleTriangle_distinguished
      have hfirst : IsCompactObject.{v} T.obj₁ := by
        change IsCompactObject.{v} (((DerivedCategory.singleFunctor (ModuleCat.{v} R) 0).obj
          (ModuleCat.of R (M ⧸ N)))⟦(-1 : ℤ)⟧)
        exact isCompactObject_shift (hSimple (M ⧸ N) hQvanish) (-1)
      have hsecond : IsCompactObject.{v} T.obj₂ := by
        change IsCompactObject.{v} ((DerivedCategory.singleFunctor (ModuleCat.{v} R) 0).obj
          (ModuleCat.of R N))
        exact ih hNvanish
      have hthird : IsCompactObject.{v} T.obj₃ :=
        CategoryTheory.isCompactObject_obj₃ T hT hfirst hsecond
      simpa [T, S, ModuleCat.shortComplexOfConj] using hthird

private lemma isCompactObject_single_of_isFiniteLength
    {R : Type u} [Ring R] [HasCoproducts.{v} (DerivedCategory (ModuleCat.{v} R))]
    {M : Type v} [AddCommGroup M] [Module R M]
    (hM : IsFiniteLength R M)
    (hSimple : ∀ (N : Type v) [AddCommGroup N] [Module R N] [IsSimpleModule R N],
      IsCompactObject.{v} ((DerivedCategory.singleFunctor (ModuleCat.{v} R) 0).obj
        (ModuleCat.of R N))) :
    IsCompactObject.{v} ((DerivedCategory.singleFunctor (ModuleCat.{v} R) 0).obj
      (ModuleCat.of R M)) :=
  isCompactObject_single_of_isFiniteLength_of_vanishesAtLE (n := 0)
    (fun _ => 0) 0 hM (by simp [VanishesAtLE]) (fun N _ _ _ _ => hSimple N)

private lemma diagonalSimple_isCompact_of_compact_successors
    (k : Type u) [Field k] (n : ℕ) [Small.{v} (beilinsonAlgebra k n)]
    (N : Type v) [AddCommGroup N] [Module ((beilinsonAlgebra k n)ᵐᵒᵖ) N]
    [IsSimpleModule ((beilinsonAlgebra k n)ᵐᵒᵖ) N]
    (hSimple : ∀ (j : Fin (n + 1))
      (_hj : ∃ x : N, MulOpposite.op (diagonalIdempotent k n j) • x ≠ 0)
      (M : Type v) [AddCommGroup M]
      [Module ((beilinsonAlgebra k n)ᵐᵒᵖ) M]
      [IsSimpleModule ((beilinsonAlgebra k n)ᵐᵒᵖ) M],
      VanishesAtLE ((beilinsonAlgebra k n)ᵐᵒᵖ) M
        (fun l => MulOpposite.op (diagonalIdempotent k n l)) j →
      IsCompactObject.{v} ((DerivedCategory.singleFunctor
        (ModuleCat.{v} ((beilinsonAlgebra k n)ᵐᵒᵖ)) 0).obj
          (ModuleCat.of ((beilinsonAlgebra k n)ᵐᵒᵖ) M))) :
    IsCompactObject.{v} ((DerivedCategory.singleFunctor
      (ModuleCat.{v} ((beilinsonAlgebra k n)ᵐᵒᵖ)) 0).obj
        (ModuleCat.of ((beilinsonAlgebra k n)ᵐᵒᵖ) N)) := by
  let A := beilinsonAlgebra k n
  let R := Aᵐᵒᵖ
  let e (j : Fin (n + 1)) : R := MulOpposite.op (diagonalIdempotent k n j)
  let : Module k N := Module.compHom N (algebraMap k R)
  let : Nontrivial N := IsSimpleModule.nontrivial R N
  obtain ⟨x, y, hxy⟩ := exists_pair_ne N
  let z : N := x - y
  have hz : z ≠ 0 := sub_ne_zero.mpr hxy
  have hdecomp : ∑ j : Fin (n + 1), e j = (1 : R) := by
    have hs := congrArg MulOpposite.op (sum_diagonalIdempotents k n)
    simpa [e] using hs
  have hex : ∃ j : Fin (n + 1), e j • z ≠ 0 := by
    by_contra h
    push Not at h
    have hzero : (∑ j : Fin (n + 1), e j) • z = 0 := by
      rw [Finset.sum_smul]
      exact Finset.sum_eq_zero fun j _ => h j
    rw [hdecomp] at hzero
    exact hz (by simpa using hzero)
  obtain ⟨j, hzj⟩ := hex
  let m : N := e j • z
  have hm : m ≠ 0 := hzj
  let raw := LinearMap.range (LinearMap.mulRight R (e j))
  let row := Shrink.{v} raw
  let rowEquiv : row ≃ₗ[R] raw := Shrink.linearEquiv R raw
  have hmap (r : R) (x : row) : rowEquiv (r • x) = r • rowEquiv x :=
    rowEquiv.map_smul r x
  let : AddCommGroup row := inferInstance
  let : Module R row := inferInstance
  let erow : row := rowEquiv.symm ⟨e j, by
    refine ⟨1, ?_⟩
    simp [LinearMap.mulRight, e]⟩
  let φ : row →ₗ[R] N :=
    (LinearMap.toSpanSingleton R N m).comp (raw.subtype.comp rowEquiv.toLinearMap)
  have herm : e j • m = m := by
    change e j • (e j • z) = e j • z
    rw [← mul_smul]
    change MulOpposite.op (diagonalIdempotent k n j * diagonalIdempotent k n j) • z = _
    rw [diagonalIdempotent_mul_self]
  have hφerow : φ erow = m := by
    simpa [φ, erow] using herm
  have hsurj : Function.Surjective φ := by
    rw [← LinearMap.range_eq_top]
    apply (eq_bot_or_eq_top (LinearMap.range φ)).resolve_left
    intro hbot
    have hmem : φ erow ∈ LinearMap.range φ := ⟨erow, rfl⟩
    rw [hbot] at hmem
    have hzero : φ erow = 0 := by simpa using hmem
    exact hm (by simpa [hφerow] using hzero)
  have hkernelVan : VanishesAtLE R (LinearMap.ker φ)
      (fun l => e l) j := by
    intro l hlj a
    apply Subtype.ext
    change e l • a.val = 0
    by_cases hlj' : l < j
    · apply rowEquiv.injective
      simpa only [hmap, rowEquiv.map_zero] using
        diagonalRow_vanishesAtLT k n j l hlj' (rowEquiv a.val)
    · have hEq : l = j := le_antisymm hlj (not_lt.mp hlj')
      subst l
      obtain ⟨c, hc⟩ := diagonalRow_vertexProjection k n j (rowEquiv a.val)
      have hc' : e j • a.val = algebraMap k R c • erow := by
        apply rowEquiv.injective
        dsimp only [erow]
        rw [hmap, hmap, rowEquiv.apply_symm_apply]
        exact hc
      have happly := congrArg φ hc'
      have hleft : φ (e j • a.val) = 0 := by
        rw [map_smul, a.property, smul_zero]
      have hright : φ (algebraMap k R c • erow) = algebraMap k R c • m := by
        rw [map_smul, hφerow]
      rw [hleft, hright] at happly
      have hc0 : c = 0 := by
        have hcm : c • m = 0 := happly.symm
        exact (smul_eq_zero.mp hcm).resolve_right hm
      apply rowEquiv.injective
      rw [hmap, rowEquiv.map_zero]
      rw [hc, hc0, map_zero, zero_smul]
  let : AddCommGroup (LinearMap.ker φ) := inferInstance
  let : Module R (LinearMap.ker φ) := inferInstance
  have hkerFiniteLength : IsFiniteLength R (LinearMap.ker φ) :=
    IsFiniteLength.of_injective (diagonalRow_finiteLength k n j)
      (f := rowEquiv.toLinearMap.comp (LinearMap.ker φ).subtype)
      (rowEquiv.injective.comp (LinearMap.ker φ).subtype_injective)
  let : HasCoproducts.{v} (DerivedCategory (ModuleCat.{v} R)) :=
    fun J => hasCoproductsOfShape_derivedCategory J
  have hkerCompact : IsCompactObject.{v} ((DerivedCategory.singleFunctor
      (ModuleCat.{v} R) 0).obj (ModuleCat.of R (LinearMap.ker φ))) :=
    isCompactObject_single_of_isFiniteLength_of_vanishesAtLE
      (fun l => e l) j hkerFiniteLength hkernelVan
        (fun M _ _ _ hV => hSimple j ⟨z, hzj⟩ M hV)
  let S := φ.shortComplexKer
  have hS : S.ShortExact := LinearMap.shortExact_shortComplexKer hsurj
  let T := hS.singleTriangle
  have hT : T ∈ distTriang (DerivedCategory (ModuleCat.{v} R)) :=
    hS.singleTriangle_distinguished
  have hrow : IsCompactObject.{v} ((DerivedCategory.singleFunctor
      (ModuleCat.{v} R) 0).obj (ModuleCat.of R row)) := by
    exact diagonalRow_isCompact_small k n j
  have hNcompact : IsCompactObject.{v} T.obj₃ :=
    CategoryTheory.isCompactObject_obj₃ T hT hkerCompact hrow
  simpa [T, S, LinearMap.shortComplexKer] using hNcompact

private lemma diagonalSimple_isCompact_of_vanishesAtLE
    (k : Type u) [Field k] (n : ℕ) [Small.{v} (beilinsonAlgebra k n)] (i : Fin (n + 1))
    (N : Type v) [AddCommGroup N] [Module ((beilinsonAlgebra k n)ᵐᵒᵖ) N]
    [IsSimpleModule ((beilinsonAlgebra k n)ᵐᵒᵖ) N]
    (hN : VanishesAtLE ((beilinsonAlgebra k n)ᵐᵒᵖ) N
      (fun j => MulOpposite.op (diagonalIdempotent k n j)) i)
    (hSimple : ∀ (j : Fin (n + 1)) (_hij : i < j) (M : Type v) [AddCommGroup M]
      [Module ((beilinsonAlgebra k n)ᵐᵒᵖ) M]
      [IsSimpleModule ((beilinsonAlgebra k n)ᵐᵒᵖ) M],
      VanishesAtLE ((beilinsonAlgebra k n)ᵐᵒᵖ) M
        (fun l => MulOpposite.op (diagonalIdempotent k n l)) j →
      IsCompactObject.{v} ((DerivedCategory.singleFunctor
        (ModuleCat.{v} ((beilinsonAlgebra k n)ᵐᵒᵖ)) 0).obj
          (ModuleCat.of ((beilinsonAlgebra k n)ᵐᵒᵖ) M))) :
    IsCompactObject.{v} ((DerivedCategory.singleFunctor
      (ModuleCat.{v} ((beilinsonAlgebra k n)ᵐᵒᵖ)) 0).obj
        (ModuleCat.of ((beilinsonAlgebra k n)ᵐᵒᵖ) N)) := by
  apply diagonalSimple_isCompact_of_compact_successors k n N
  intro j ⟨x, hx⟩ M _ _ _ hV
  have hij : i < j := by
    by_contra h
    exact hx (hN j (le_of_not_gt h) x)
  exact hSimple j hij M hV

private lemma diagonalSimple_isCompact_by_induction
    (k : Type u) [Field k] (n : ℕ) [Small.{v} (beilinsonAlgebra k n)] :
    ∀ (i : Fin (n + 1)) (N : Type v) [AddCommGroup N]
      [Module ((beilinsonAlgebra k n)ᵐᵒᵖ) N]
      [IsSimpleModule ((beilinsonAlgebra k n)ᵐᵒᵖ) N],
      VanishesAtLE ((beilinsonAlgebra k n)ᵐᵒᵖ) N
        (fun j => MulOpposite.op (diagonalIdempotent k n j)) i →
      IsCompactObject.{v} ((DerivedCategory.singleFunctor
        (ModuleCat.{v} ((beilinsonAlgebra k n)ᵐᵒᵖ)) 0).obj
          (ModuleCat.of ((beilinsonAlgebra k n)ᵐᵒᵖ) N)) := by
  intro i N instAdd instModule instSimple hN
  suffices h : ∀ d : ℕ, ∀ (i : Fin (n + 1)), n - i.val = d →
      ∀ (N : Type v) [AddCommGroup N]
        [Module ((beilinsonAlgebra k n)ᵐᵒᵖ) N]
        [IsSimpleModule ((beilinsonAlgebra k n)ᵐᵒᵖ) N],
        VanishesAtLE ((beilinsonAlgebra k n)ᵐᵒᵖ) N
          (fun j => MulOpposite.op (diagonalIdempotent k n j)) i →
        IsCompactObject.{v} ((DerivedCategory.singleFunctor
          (ModuleCat.{v} ((beilinsonAlgebra k n)ᵐᵒᵖ)) 0).obj
            (ModuleCat.of ((beilinsonAlgebra k n)ᵐᵒᵖ) N)) from
    h (n - i.val) i rfl N hN
  intro d
  induction d using Nat.strong_induction_on with
  | h d ih =>
      intro i hi N instAdd instModule instSimple hN
      apply diagonalSimple_isCompact_of_vanishesAtLE k n i N hN
      intro j hij M instAdd' instModule' instSimple' hV
      exact ih (n - j.val) (by omega) j rfl M hV

private lemma diagonalSimple_isCompact
    (k : Type u) [Field k] (n : ℕ) [Small.{v} (beilinsonAlgebra k n)]
    (N : Type v) [AddCommGroup N]
    [Module ((beilinsonAlgebra k n)ᵐᵒᵖ) N]
    [IsSimpleModule ((beilinsonAlgebra k n)ᵐᵒᵖ) N] :
    IsCompactObject.{v} ((DerivedCategory.singleFunctor
      (ModuleCat.{v} ((beilinsonAlgebra k n)ᵐᵒᵖ)) 0).obj
        (ModuleCat.of ((beilinsonAlgebra k n)ᵐᵒᵖ) N)) := by
  apply diagonalSimple_isCompact_of_compact_successors k n N
  intro j hj M _ _ _ hV
  exact diagonalSimple_isCompact_by_induction k n j M hV

private lemma diagonalFiniteLength_single_isCompact
    (k : Type u) [Field k] (n : ℕ) [Small.{v} (beilinsonAlgebra k n)]
    (M : Type v) [AddCommGroup M]
    [Module ((beilinsonAlgebra k n)ᵐᵒᵖ) M]
    (hM : IsFiniteLength ((beilinsonAlgebra k n)ᵐᵒᵖ) M) :
    IsCompactObject.{v} ((DerivedCategory.singleFunctor
      (ModuleCat.{v} ((beilinsonAlgebra k n)ᵐᵒᵖ)) 0).obj
        (ModuleCat.of ((beilinsonAlgebra k n)ᵐᵒᵖ) M)) := by
  let : HasCoproducts.{v} (DerivedCategory
      (ModuleCat.{v} ((beilinsonAlgebra k n)ᵐᵒᵖ))) :=
    fun J => hasCoproductsOfShape_derivedCategory J
  exact isCompactObject_single_of_isFiniteLength hM
    (fun N _ _ _ => diagonalSimple_isCompact k n N)

private lemma diagonalFinite_single_isCompact
    (k : Type u) [Field k] (n : ℕ) [Small.{v} (beilinsonAlgebra k n)]
    (M : Type v) [AddCommGroup M]
    [Module ((beilinsonAlgebra k n)ᵐᵒᵖ) M]
    (hM : @Module.Finite k M _ _ (Module.compHom M
      (algebraMap k ((beilinsonAlgebra k n)ᵐᵒᵖ)))) :
    IsCompactObject.{v} ((DerivedCategory.singleFunctor
      (ModuleCat.{v} ((beilinsonAlgebra k n)ᵐᵒᵖ)) 0).obj
        (ModuleCat.of ((beilinsonAlgebra k n)ᵐᵒᵖ) M)) := by
  let A := beilinsonAlgebra k n
  let R := Aᵐᵒᵖ
  let : Module k M := Module.compHom M (algebraMap k R)
  have : IsScalarTower k R M := IsScalarTower.of_compHom k R M
  let : Module.Finite k M := hM
  exact diagonalFiniteLength_single_isCompact k n M
    (finiteLength_of_finiteDimensional_base hM)

private lemma homologyMap_mor₁_isIso_of_isZero
    {R : Type u} [Ring R] [HasDerivedCategory.{max u (v + 1)} (ModuleCat.{v} R)]
    (T : CategoryTheory.Pretriangulated.Triangle
      (DerivedCategory (ModuleCat.{v} R)))
    (hT : T ∈ distTriang (DerivedCategory (ModuleCat.{v} R))) (i : ℤ)
    (hPrev : IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{v} R) (i - 1)).obj
      T.obj₃))
    (hNow : IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{v} R) i).obj T.obj₃)) :
    IsIso ((DerivedCategory.homologyFunctor (ModuleCat.{v} R) i).map T.mor₁) := by
  have hmono : Mono ((DerivedCategory.homologyFunctor (ModuleCat.{v} R) i).map T.mor₁) := by
    have hS := DerivedCategory.HomologySequence.exact₁ T hT (i - 1) i (by omega)
    have hz : DerivedCategory.HomologySequence.δ T (i - 1) i (by omega) = 0 :=
      hPrev.eq_of_src _ _
    exact hS.mono_g hz
  have hepi : Epi ((DerivedCategory.homologyFunctor (ModuleCat.{v} R) i).map T.mor₁) := by
    have hS := DerivedCategory.HomologySequence.exact₂ T hT i
    have hz : (DerivedCategory.homologyFunctor (ModuleCat.{v} R) i).map T.mor₂ = 0 :=
      hNow.eq_of_tgt _ _
    exact hS.epi_f hz
  exact isIso_of_mono_of_epi _

private lemma homologyMap_mor₂_isIso_of_isZero
    {R : Type u} [Ring R] [HasDerivedCategory.{max u (v + 1)} (ModuleCat.{v} R)]
    (T : CategoryTheory.Pretriangulated.Triangle
      (DerivedCategory (ModuleCat.{v} R)))
    (hT : T ∈ distTriang (DerivedCategory (ModuleCat.{v} R))) (i : ℤ)
    (hNow : IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{v} R) i).obj
      T.obj₁))
    (hNext : IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{v} R) (i + 1)).obj
      T.obj₁)) :
    IsIso ((DerivedCategory.homologyFunctor (ModuleCat.{v} R) i).map T.mor₂) := by
  have hmono : Mono ((DerivedCategory.homologyFunctor (ModuleCat.{v} R) i).map T.mor₂) := by
    have hS := DerivedCategory.HomologySequence.exact₂ T hT i
    have hz : (DerivedCategory.homologyFunctor (ModuleCat.{v} R) i).map T.mor₁ = 0 :=
      hNow.eq_of_src _ _
    exact hS.mono_g hz
  have hepi : Epi ((DerivedCategory.homologyFunctor (ModuleCat.{v} R) i).map T.mor₂) := by
    have hS := DerivedCategory.HomologySequence.exact₃ T hT i (i + 1) rfl
    have hz : DerivedCategory.HomologySequence.δ T i (i + 1) rfl = 0 :=
      hNext.eq_of_tgt _ _
    exact hS.epi_f hz
  exact isIso_of_mono_of_epi _

/-- An epimorphism of modules preserves finiteness. -/
private lemma moduleCat_finite_of_epi {S : Type*} [Ring S] {X Y : ModuleCat S} (f : X ⟶ Y)
    [Epi f] [Module.Finite S X] : Module.Finite S Y :=
  Module.Finite.of_surjective f.hom ((ModuleCat.epi_iff_surjective f).mp inferInstance)

/-- A module with no nontrivial structure is a zero object. -/
private lemma moduleCat_isZero_of_not_nontrivial {S : Type*} [Ring S] {X : ModuleCat S}
    (h : ¬ Nontrivial X) : IsZero X :=
  ModuleCat.isZero_iff_subsingleton.mpr (not_nontrivial_iff_subsingleton.mp h)

/-- A monomorphism of modules preserves nontriviality. -/
private lemma moduleCat_nontrivial_of_mono {S : Type*} [Ring S] {X Y : ModuleCat S}
    (f : X ⟶ Y) [Mono f] (h : Nontrivial X) : Nontrivial Y :=
  ((ModuleCat.mono_iff_injective f).mp inferInstance).nontrivial

private lemma concentratedFiniteCohom_isCompact
    (k : Type u) [Field k] (n : ℕ) [Small.{v} (beilinsonAlgebra k n)]
    (K : DerivedCategory (ModuleCat.{v} (beilinsonAlgebra k n)ᵐᵒᵖ))
    (a : ℤ) [K.IsGE a] [K.IsLE a]
    (hfinite : Module.Finite k ((ModuleCat.restrictScalars
      (algebraMap k (beilinsonAlgebra k n)ᵐᵒᵖ)).obj
      ((DerivedCategory.homologyFunctor (ModuleCat.{v} (beilinsonAlgebra k n)ᵐᵒᵖ) a).obj K))) :
    IsCompactObject.{v} K := by
  let : HasCoproducts.{v} (DerivedCategory (ModuleCat.{v} (beilinsonAlgebra k n)ᵐᵒᵖ)) :=
    fun J => hasCoproductsOfShape_derivedCategory J
  let R := (beilinsonAlgebra k n)ᵐᵒᵖ
  let H := DerivedCategory.homologyFunctor (ModuleCat.{v} R) a
  let F := ModuleCat.restrictScalars (algebraMap k R)
  obtain ⟨M, ⟨e⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE K a
  let eM := F.mapIso (H.mapIso e ≪≫
    (DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat.{v} R) a).app M)
  have : Module.Finite k (F.obj (H.obj K)) := hfinite
  have hM : Module.Finite k (F.obj M) := moduleCat_finite_of_epi eM.hom
  let eShift := ((DerivedCategory.singleFunctors (ModuleCat.{v} R)).shiftIso
    (-a) a 0 (by omega)).app M
  exact isCompactObject_of_iso e
    (isCompactObject_of_iso eShift.symm
      (isCompactObject_shift (diagonalFinite_single_isCompact k n M hM) (-a)))

private lemma boundedFiniteCohom_isCompact
    (k : Type u) [Field k] (n : ℕ) [Small.{v} (beilinsonAlgebra k n)]
    (K : DerivedCategory (ModuleCat.{v} ((beilinsonAlgebra k n)ᵐᵒᵖ)))
    (a b : ℤ) [K.IsGE a] [K.IsLE b] (hab : a ≤ b)
    (hfinite : ∀ i : ℤ, Module.Finite k
      ((ModuleCat.restrictScalars
        (algebraMap k ((beilinsonAlgebra k n)ᵐᵒᵖ))).obj
        ((DerivedCategory.homologyFunctor
          (ModuleCat.{v} ((beilinsonAlgebra k n)ᵐᵒᵖ)) i).obj K))) :
    IsCompactObject.{v} K := by
  let R := (beilinsonAlgebra k n)ᵐᵒᵖ
  let H := DerivedCategory.homologyFunctor (ModuleCat.{v} R)
  let F := ModuleCat.restrictScalars (algebraMap k R)
  let : HasCoproducts.{v} (DerivedCategory (ModuleCat.{v} R)) :=
    fun J => hasCoproductsOfShape_derivedCategory J
  suffices h : ∀ d : ℕ, ∀ (K : DerivedCategory (ModuleCat.{v} R))
      (a b : ℤ), [K.IsGE a] → [K.IsLE b] → a ≤ b → b - a = (d : ℤ) →
      (∀ i : ℤ, Module.Finite k (F.obj ((H i).obj K))) → IsCompactObject.{v} K from
    h (Int.toNat (b - a)) K a b hab (by omega) hfinite
  intro d
  induction d using Nat.strong_induction_on with
  | h d ih =>
      intro K a b hGE hLE hab hd hfinite
      by_cases hab' : a = b
      · subst b
        exact concentratedFiniteCohom_isCompact k n K a (hfinite a)
      · have hab'' : a < b := lt_of_le_of_ne hab hab'
        let t := DerivedCategory.TStructure.t (C := ModuleCat.{v} R)
        let T := (t.triangleLEGE (b - 1) b (by omega)).obj K
        have hT : T ∈ distTriang (DerivedCategory (ModuleCat.{v} R)) :=
          t.triangleLEGE_distinguished (b - 1) b (by omega) K
        have : T.obj₁.IsGE a := by
          change ((t.truncLE (b - 1)).obj K).IsGE a
          infer_instance
        have : T.obj₁.IsLE (b - 1) := by
          change ((t.truncLE (b - 1)).obj K).IsLE (b - 1)
          infer_instance
        have : T.obj₃.IsGE b := by
          change ((t.truncGE b).obj K).IsGE b
          infer_instance
        have : T.obj₃.IsLE b := by
          change ((t.truncGE b).obj K).IsLE b
          infer_instance
        have : IsIso ((H b).map T.mor₂) :=
          homologyMap_mor₂_isIso_of_isZero T hT b
            (DerivedCategory.isZero_of_isLE T.obj₁ (b - 1) b (by omega))
            (DerivedCategory.isZero_of_isLE T.obj₁ (b - 1) (b + 1) (by omega))
        have : Module.Finite k (F.obj ((H b).obj T.obj₂)) := hfinite b
        have hT3 : IsCompactObject.{v} T.obj₃ := by
          apply concentratedFiniteCohom_isCompact k n T.obj₃ b
          let e := F.mapIso (asIso ((H b).map T.mor₂))
          exact moduleCat_finite_of_epi e.hom
        have hT1finite (i : ℤ) : Module.Finite k (F.obj ((H i).obj T.obj₁)) := by
          by_cases hi : i ≤ b - 1
          · have : IsIso ((H i).map T.mor₁) :=
              homologyMap_mor₁_isIso_of_isZero T hT i
                (DerivedCategory.isZero_of_isGE T.obj₃ b (i - 1) (by omega))
                (DerivedCategory.isZero_of_isGE T.obj₃ b i (by omega))
            have : Module.Finite k (F.obj ((H i).obj T.obj₂)) := hfinite i
            let e := F.mapIso (asIso ((H i).map T.mor₁))
            exact moduleCat_finite_of_epi e.inv
          · have hz := DerivedCategory.isZero_of_isLE T.obj₁ (b - 1) i (by omega)
            have : Subsingleton (F.obj ((H i).obj T.obj₁)) :=
              ModuleCat.isZero_iff_subsingleton.mp (F.map_isZero hz)
            infer_instance
        have hT1 : IsCompactObject.{v} T.obj₁ :=
          ih (d - 1) (by omega) T.obj₁ a (b - 1) (by omega) (by omega) hT1finite
        exact CategoryTheory.isCompactObject_obj₃ T.invRotate
          (Pretriangulated.inv_rot_of_distTriang _ hT)
          (isCompactObject_shift hT3 (-1)) hT1

/-- A derived right-module object has finite total cohomology if each of its
cohomology modules is finite-dimensional and only finitely many cohomological
degrees are nonzero. -/
abbrev HasFiniteTotalCohomology {k : Type u} [Field k] {R : Type*} [Ring R]
    [Algebra k R] (K : DerivedCategory (ModuleCat.{v} Rᵐᵒᵖ)) : Prop :=
  (∀ i : ℤ,
    Module.Finite k ((ModuleCat.restrictScalars (algebraMap k Rᵐᵒᵖ)).obj
      ((DerivedCategory.homologyFunctor (ModuleCat.{v} Rᵐᵒᵖ) i).obj K))) ∧
    Set.Finite {i : ℤ |
      Nontrivial ((DerivedCategory.homologyFunctor (ModuleCat.{v} Rᵐᵒᵖ) i).obj K)}

private lemma finiteTotalCohom_isCompact_sameUniverse
    (k : Type u) [Field k] (n : ℕ) [Small.{v} (beilinsonAlgebra k n)]
    (K : DerivedCategory (ModuleCat.{v} ((beilinsonAlgebra k n)ᵐᵒᵖ)))
    (hK : HasFiniteTotalCohomology (k := k) K) : IsCompactObject.{v} K := by
  let R := (beilinsonAlgebra k n)ᵐᵒᵖ
  let H := DerivedCategory.homologyFunctor (ModuleCat.{v} R)
  let S : Set ℤ := {i | Nontrivial ((H i).obj K)}
  have hS : S.Finite := hK.2
  obtain ⟨a₀, ha₀⟩ := hS.bddBelow
  obtain ⟨b₀, hb₀⟩ := hS.bddAbove
  let a := min a₀ b₀
  let b := max a₀ b₀
  have hab : a ≤ b := by omega
  have hGE : K.IsGE a := by
    rw [DerivedCategory.isGE_iff]
    exact fun i hi => moduleCat_isZero_of_not_nontrivial fun hn =>
      absurd (le_trans (min_le_left _ _) (ha₀ hn)) (not_le.mpr hi)
  have hLE : K.IsLE b := by
    rw [DerivedCategory.isLE_iff]
    exact fun i hi => moduleCat_isZero_of_not_nontrivial fun hn =>
      absurd (le_trans (hb₀ hn) (le_max_right _ _)) (not_le.mpr hi)
  let : K.IsGE a := hGE
  let : K.IsLE b := hLE
  exact boundedFiniteCohom_isCompact k n K a b hab hK.1

private lemma finiteTotalCohom_obj₂_of_distTriangle
    (k : Type u) [Field k] (A : Type*) [Ring A] [Algebra k A]
    (T : CategoryTheory.Pretriangulated.Triangle
      (DerivedCategory (ModuleCat.{v} Aᵐᵒᵖ)))
    (hT : T ∈ distTriang
      (DerivedCategory (ModuleCat.{v} Aᵐᵒᵖ)))
    (h₁ : HasFiniteTotalCohomology (k := k) T.obj₁)
    (h₃ : HasFiniteTotalCohomology (k := k) T.obj₃) :
    HasFiniteTotalCohomology (k := k) T.obj₂ := by
  let R := Aᵐᵒᵖ
  let H := DerivedCategory.homologyFunctor (ModuleCat.{v} R)
  constructor
  · intro i
    let : Module k ((H i).obj T.obj₁) := Module.compHom _ (algebraMap k R)
    let : Module k ((H i).obj T.obj₂) := Module.compHom _ (algebraMap k R)
    let : Module k ((H i).obj T.obj₃) := Module.compHom _ (algebraMap k R)
    have : IsScalarTower k R ((H i).obj T.obj₁) := IsScalarTower.of_compHom k R _
    have : IsScalarTower k R ((H i).obj T.obj₂) := IsScalarTower.of_compHom k R _
    have : IsScalarTower k R ((H i).obj T.obj₃) := IsScalarTower.of_compHom k R _
    let f : ((H i).obj T.obj₁) →ₗ[k] ((H i).obj T.obj₂) :=
      ((H i).map T.mor₁).hom.restrictScalars k
    let g : ((H i).obj T.obj₂) →ₗ[k] ((H i).obj T.obj₃) :=
      ((H i).map T.mor₂).hom.restrictScalars k
    have hExactR := DerivedCategory.HomologySequence.exact₂ T hT i
    have hExact : Function.Exact f g :=
      (CategoryTheory.ShortComplex.ShortExact.moduleCat_exact_iff_function_exact _).mp hExactR
    let gr : ((H i).obj T.obj₂) →ₗ[k] LinearMap.range g := g.rangeRestrict
    have hExact' : Function.Exact f gr := by
      intro x
      simpa only [gr, LinearMap.codRestrict_apply, Subtype.ext_iff, Submodule.coe_zero] using
        hExact x
    let : Module.Finite k ((H i).obj T.obj₁) := by
      change Module.Finite k ((ModuleCat.restrictScalars (algebraMap k R)).obj
        ((H i).obj T.obj₁))
      exact h₁.1 i
    let : Module.Finite k ((H i).obj T.obj₃) := by
      change Module.Finite k ((ModuleCat.restrictScalars (algebraMap k R)).obj
        ((H i).obj T.obj₃))
      exact h₃.1 i
    let : Module.Finite k (LinearMap.range g) := by infer_instance
    exact Module.Finite.of_exact hExact' (LinearMap.surjective_rangeRestrict g)
  · let S₁ : Set ℤ := {i | Nontrivial ((H i).obj T.obj₁)}
    let S₃ : Set ℤ := {i | Nontrivial ((H i).obj T.obj₃)}
    let S₂ : Set ℤ := {i | Nontrivial ((H i).obj T.obj₂)}
    have hsub : S₂ ⊆ S₁ ∪ S₃ := by
      intro i hi
      by_contra hnot
      have hzero₁ := moduleCat_isZero_of_not_nontrivial fun h => hnot (Or.inl h)
      have hzero₃ := moduleCat_isZero_of_not_nontrivial fun h => hnot (Or.inr h)
      have hS := DerivedCategory.HomologySequence.exact₂ T hT i
      have hzero₂ := hS.isZero_X₂ (hzero₁.eq_of_src _ _) (hzero₃.eq_of_tgt _ _)
      exact (not_nontrivial_iff_subsingleton.mpr
        (ModuleCat.isZero_iff_subsingleton.mp hzero₂)) hi
    exact h₁.2.union h₃.2 |>.subset hsub

/-- Finite total cohomology follows from finiteness on a finite set of degrees and
vanishing elsewhere. -/
private lemma finiteTotalCohom_of_isZero_outside
    {k : Type u} [Field k] {R : Type*} [Ring R] [Algebra k R]
    {K : DerivedCategory (ModuleCat.{v} Rᵐᵒᵖ)} (s : Set ℤ) (hs : s.Finite)
    (hfin : ∀ i ∈ s, Module.Finite k ((ModuleCat.restrictScalars (algebraMap k Rᵐᵒᵖ)).obj
      ((DerivedCategory.homologyFunctor (ModuleCat.{v} Rᵐᵒᵖ) i).obj K)))
    (hz : ∀ i ∉ s, IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{v} Rᵐᵒᵖ) i).obj K)) :
    HasFiniteTotalCohomology (k := k) K := by
  constructor
  · intro i
    by_cases hi : i ∈ s
    · exact hfin i hi
    · exact Module.Finite.of_surjective (0 : k →ₗ[k] _)
        fun x => ⟨0, (ModuleCat.isZero_iff_subsingleton.mp (hz i hi)).elim _ _⟩
  · refine hs.subset fun i hi => ?_
    by_contra h
    have := ModuleCat.isZero_iff_subsingleton.mp (hz i h)
    exact not_nontrivial _ hi

private lemma finiteTotalCohom_of_retract
    {k : Type u} [Field k] {R : Type*} [Ring R] [Algebra k R]
    {K L : DerivedCategory (ModuleCat.{v} Rᵐᵒᵖ)} (r : Retract K L)
    (hL : HasFiniteTotalCohomology (k := k) L) :
    HasFiniteTotalCohomology (k := k) K := by
  constructor
  · intro i
    let F := DerivedCategory.homologyFunctor (ModuleCat.{v} Rᵐᵒᵖ) i ⋙
      ModuleCat.restrictScalars (algebraMap k Rᵐᵒᵖ)
    have : Module.Finite k (F.obj L) := hL.1 i
    exact moduleCat_finite_of_epi (r.map F).r
  · exact hL.2.subset fun i hi =>
      moduleCat_nontrivial_of_mono (r.map (DerivedCategory.homologyFunctor _ i)).i hi

private lemma finiteTotalCohom_shift
    {k : Type u} [Field k] {R : Type*} [Ring R] [Algebra k R]
    {K : DerivedCategory (ModuleCat.{v} Rᵐᵒᵖ)}
    (hK : HasFiniteTotalCohomology (k := k) K) (a : ℤ) :
    HasFiniteTotalCohomology (k := k) (K⟦a⟧) := by
  let H := DerivedCategory.homologyFunctor (ModuleCat.{v} Rᵐᵒᵖ)
  let e (i : ℤ) : (H i).obj (K⟦a⟧) ≅ (H (a + i)).obj K :=
    ((H 0).shiftIso a i (a + i) rfl).app K
  constructor
  · intro i
    let e' := (ModuleCat.restrictScalars (algebraMap k Rᵐᵒᵖ)).mapIso (e i)
    have := hK.1 (a + i)
    exact moduleCat_finite_of_epi e'.inv
  · exact ((Set.Finite.preimage (f := fun i : ℤ => a + i)
      (fun _ _ _ _ h => add_left_cancel h) hK.2)).subset fun i hi =>
        moduleCat_nontrivial_of_mono (e i).hom hi

private lemma finiteTotalCohom_single
    {k : Type u} [Field k] {R : Type*} [Ring R] [Algebra k R]
    (M : ModuleCat.{v} Rᵐᵒᵖ)
    (hM : Module.Finite k ((ModuleCat.restrictScalars (algebraMap k Rᵐᵒᵖ)).obj M)) :
    HasFiniteTotalCohomology (k := k)
      ((DerivedCategory.singleFunctor (ModuleCat.{v} Rᵐᵒᵖ) 0).obj M) := by
  let K := (DerivedCategory.singleFunctor (ModuleCat.{v} Rᵐᵒᵖ) 0).obj M
  let H := DerivedCategory.homologyFunctor (ModuleCat.{v} Rᵐᵒᵖ)
  refine finiteTotalCohom_of_isZero_outside {0} (Set.finite_singleton 0) ?_ fun i hi => ?_
  · intro i hi
    rw [Set.mem_singleton_iff.mp hi]
    let e := (ModuleCat.restrictScalars (algebraMap k Rᵐᵒᵖ)).mapIso
      ((DerivedCategory.singleFunctorCompHomologyFunctorIso (ModuleCat.{v} Rᵐᵒᵖ) 0).app M)
    have : Module.Finite k
        ((ModuleCat.restrictScalars (algebraMap k Rᵐᵒᵖ)).obj ((𝟭 _).obj M)) := hM
    exact moduleCat_finite_of_epi e.inv
  · rcases lt_or_gt_of_ne (Set.notMem_singleton_iff.mp hi) with hi | hi
    · exact DerivedCategory.isZero_of_isGE K 0 i hi
    · exact DerivedCategory.isZero_of_isLE K 0 i hi

private lemma finiteTotalCohom_of_isCompact_sameUniverse
    (k : Type u) [Field k] (A : Type v) [Ring A] [Algebra k A] [Module.Finite k A]
    (K : DerivedCategory (ModuleCat.{v} Aᵐᵒᵖ))
    (hK : IsCompactObject.{v} K) : HasFiniteTotalCohomology (k := k) K := by
  let R := Aᵐᵒᵖ
  let P : ObjectProperty (DerivedCategory (ModuleCat.{v} R)) :=
    HasFiniteTotalCohomology (k := k)
  let : P.IsStableUnderRetracts := ⟨fun r h => finiteTotalCohom_of_retract r h⟩
  let : P.IsStableUnderShift ℤ := ⟨fun a => ⟨fun _ h => finiteTotalCohom_shift h a⟩⟩
  let : P.IsTriangulatedClosed₂ := .mk' (fun T hT h₁ h₃ =>
    finiteTotalCohom_obj₂_of_distTriangle k A T hT h₁ h₃)
  have hR : P ((DerivedCategory.singleFunctor (ModuleCat.{v} R) 0).obj
      (ModuleCat.of R R)) := by
    apply finiteTotalCohom_single
    let e : R ≃ₗ[k] (ModuleCat.restrictScalars (algebraMap k R)).obj
        (ModuleCat.of R R) :=
      { __ := Equiv.refl R
        map_add' := fun _ _ => rfl
        map_smul' := fun c r => Algebra.smul_def c r }
    exact Module.Finite.equiv e
  let : P.Nonempty := ⟨_, hR⟩
  let : P.IsTriangulated := {}
  apply ((ObjectProperty.triangEnvelope_le_iff _).mpr
    (show ObjectProperty.singleton ((DerivedCategory.singleFunctor (ModuleCat.{v} R) 0).obj
      (ModuleCat.of R R)) ≤ P by simpa using hR))
  rwa [triangEnvelope_eq_isCompactObject_regularModule]

private lemma finiteTotalCohom_of_isCompact_of_small
    (k : Type u) [Field k] (A : Type*) [Ring A] [Algebra k A]
    [Module.Finite k A] [Small.{v} A]
    (K : DerivedCategory (ModuleCat.{v} Aᵐᵒᵖ)) (hK : IsCompactObject.{v} K) :
    HasFiniteTotalCohomology (k := k) K := by
  let S := Shrink.{v} A
  let e : S ≃ₐ[k] A := Shrink.algEquiv k A
  let G := ModuleCat.restrictScalars.{v} (AlgEquiv.op e).toRingHom
  have : G.IsEquivalence := ModuleCat.restrictScalars_isEquivalence_of_ringEquiv _
  have : G.IsLeftAdjoint := ⟨_, ⟨G.asEquivalence.toAdjunction⟩⟩
  have : G.IsRightAdjoint := ⟨_, ⟨G.asEquivalence.symm.toAdjunction⟩⟩
  have : G.mapDerivedCategory.IsEquivalence := Stacks.Injectives.mapDerivedCategory_isEquivalence G
  have hS : @Module.Finite k S _ _ (Algebra.toModule : Module k S) :=
    Module.Finite.equiv e.symm.toLinearEquiv
  have hJ := @finiteTotalCohom_of_isCompact_sameUniverse k _ S _ _ hS
    (G.mapDerivedCategory.obj K)
    ((isCompactObject_iff_isCompactObject_obj G.mapDerivedCategory K).mp hK)
  let H := DerivedCategory.homologyFunctor (ModuleCat.{v} Aᵐᵒᵖ)
  let HS := DerivedCategory.homologyFunctor (ModuleCat.{v} Sᵐᵒᵖ)
  let F := ModuleCat.restrictScalars.{v} (algebraMap k Aᵐᵒᵖ)
  let FS := ModuleCat.restrictScalars.{v} (algebraMap k Sᵐᵒᵖ)
  let eH (i : ℤ) : FS.obj ((HS i).obj (G.mapDerivedCategory.obj K)) ≅
      F.obj ((H i).obj K) :=
    FS.mapIso ((StacksDraft.DerivedCategoryHomology.mapDerivedCategoryHomologyIso G i).app K) ≪≫
      ((ModuleCat.restrictScalarsComp' (algebraMap k Sᵐᵒᵖ)
        (AlgEquiv.op e).toRingHom (algebraMap k Aᵐᵒᵖ)
        (by ext c; exact ((AlgEquiv.op e).commutes c).symm)).app ((H i).obj K)).symm
  constructor
  · intro i
    have : Module.Finite k (FS.obj ((HS i).obj (G.mapDerivedCategory.obj K))) := hJ.1 i
    exact moduleCat_finite_of_epi (eH i).hom
  · exact hJ.2.subset fun i hi => moduleCat_nontrivial_of_mono (S := k) (eH i).inv hi

private lemma subsingleton_of_not_small_field
    (k : Type u) [Field k] (M : Type v) [AddCommGroup M] [Module k M]
    (hk : ¬ Small.{v} k) : Subsingleton M := by
  classical
  by_contra hM
  have : Nontrivial M := not_subsingleton_iff_nontrivial.mp hM
  obtain ⟨m, hm⟩ := exists_ne (0 : M)
  exact hk (small_of_injective (smul_left_injective k hm))

/-- **Stacks Project, Tag 0FYA.** An object of the derived category of right
modules over the Beilinson algebra has finite-dimensional total cohomology if
and only if it is compact. -/
@[stacks 0FYA]
lemma hasFiniteTotalCohomology_iff_isCompactObject
    (k : Type u) [Field k] (n : ℕ)
    (K : DerivedCategory (ModuleCat.{v} (beilinsonAlgebra k n)ᵐᵒᵖ)) :
    HasFiniteTotalCohomology (k := k) K ↔ IsCompactObject.{v} K := by
  classical
  let A := beilinsonAlgebra k n
  have : Module.Finite k A := finite_beilinsonAlgebra k n
  by_cases hk : Small.{v} k
  · have : Small.{v} k := hk
    have : Small.{v} A := Module.Finite.small k A
    exact ⟨finiteTotalCohom_isCompact_sameUniverse k n K,
      finiteTotalCohom_of_isCompact_of_small k A K⟩
  · let H := DerivedCategory.homologyFunctor (ModuleCat.{v} Aᵐᵒᵖ)
    have hz (i : ℤ) : IsZero ((H i).obj K) := by
      let : Module k ((H i).obj K) := Module.compHom _ (algebraMap k Aᵐᵒᵖ)
      exact ModuleCat.isZero_iff_subsingleton.mpr
        (subsingleton_of_not_small_field k ((H i).obj K) hk)
    have hzero : IsZero K := isZero_of_homology_isZero K hz
    have hcompact : IsCompactObject.{v} K := by
      constructor
      intro I _ E _
      exact ⟨fun a b _ => DFinsupp.ext fun i => hzero.eq_of_src _ _,
        fun t => ⟨0, hzero.eq_of_src _ _⟩⟩
    exact iff_of_true (finiteTotalCohom_of_isZero_outside ∅ Set.finite_empty (by simp)
      fun i _ => hz i) hcompact

end StacksDraft.Perfect
