module

public import StacksFrontier.AlgebraicGeometry.PseudoCoherent.FittingIdeal
public import StacksFrontier.Homology.Eta.Perfect.DeterminantalIdeal

/-!
# Fitting ideals of a bounded complex of finite free modules

Let `A` be a commutative ring and let `M^•` be a bounded complex of finite free `A`-modules,
written in chosen bases as a `BoundedComplex A` with ranks `n_i` and differential matrices `d^i`.
For integers `i` and `k`, the ideal `Fit_{i,k}` is generated by the minors of `d^i` of size
`n_{i+1} - n_{i+2} + n_{i+3} - ⋯ - k`, with the convention that minors of nonpositive size
generate the unit ideal. This is the local description of the Fitting ideals of a perfect
object. We show that this ideal commutes with base change and only depends on the object of
the derived category `D(A)` represented by `M^•`.

## Main definitions

* `BoundedComplex.fittingMinorIdeal`: the ideal of minors of `d^i` of size
  `n_{i+1} - n_{i+2} + ⋯ - k`.

## Main results

* `BoundedComplex.map_fittingMinorIdeal`: the ideal commutes with base change.
* `BoundedComplex.fittingMinorIdeal_fg`: the ideal is finitely generated.
* `BoundedComplex.fittingMinorIdeal_eq_of_iso`: the ideal is unchanged by an isomorphism of
  cochain complexes, that is, by a change of bases.
* `BoundedComplex.fittingMinorIdeal_eq_of_derivedIso`: bounded complexes of finite free modules
  representing isomorphic objects of `D(A)` have the same ideals.

## Implementation notes

The independence of the representative is checked locally: near every prime, two
representatives of isomorphic objects of `D(A)` become isomorphic after adding finite sums of
trivial two-term complexes `A → A` (`StacksDraft.Perfect.exists_away_iso_biprod_trivial_complexes`).
Adding `s` such complexes in degrees `i, i + 1` adds an identity block of size `s` to `d^i` and
raises `n_{i+1} - n_{i+2} + ⋯` by `s`; adding them in other degrees changes neither.

## References

* [The Stacks Project, Tag 0ESP](https://stacks.math.columbia.edu/tag/0ESP)
* [The Stacks Project, Tag 0ESQ](https://stacks.math.columbia.edu/tag/0ESQ)
-/

@[expose] public noncomputable section

universe u

open CategoryTheory CategoryTheory.Limits Stacks.Eta.DeterminantalIdeal

section MinorIdeal

/-- Two matrices of the same linear map in different bases of free modules of finite rank over a
nontrivial ring have the same ideals of minors. -/
theorem minorIdeal_eq_of_linearEquiv {R : Type*} [CommRing R] [Nontrivial R] {r s r' s' : ℕ}
    (D : Matrix (Fin s) (Fin r) R) (E : Matrix (Fin s') (Fin r') R)
    (e : (Fin r → R) ≃ₗ[R] (Fin r' → R)) (e' : (Fin s → R) ≃ₗ[R] (Fin s' → R))
    (h : e'.toLinearMap.comp D.mulVecLin = E.mulVecLin.comp e.toLinearMap) (t : ℕ) :
    minorIdeal D t = minorIdeal E t := by
  obtain rfl : r = r' := eq_of_fin_equiv R e
  obtain rfl : s = s' := eq_of_fin_equiv R e'
  let U : (Matrix (Fin r) (Fin r) R)ˣ :=
    ⟨LinearMap.toMatrix' e.symm.toLinearMap, LinearMap.toMatrix' e.toLinearMap,
      by simp [← LinearMap.toMatrix'_comp], by simp [← LinearMap.toMatrix'_comp]⟩
  let V : (Matrix (Fin s) (Fin s) R)ˣ :=
    ⟨LinearMap.toMatrix' e'.toLinearMap, LinearMap.toMatrix' e'.symm.toLinearMap,
      by simp [← LinearMap.toMatrix'_comp], by simp [← LinearMap.toMatrix'_comp]⟩
  have hE : (V : Matrix (Fin s) (Fin s) R) * D * (U : Matrix (Fin r) (Fin r) R) = E := by
    have hD : LinearMap.toMatrix' D.mulVecLin = D := LinearMap.toMatrix'_toLin' D
    have hE : LinearMap.toMatrix' E.mulVecLin = E := LinearMap.toMatrix'_toLin' E
    have hc : (V : Matrix (Fin s) (Fin s) R) * D = E * LinearMap.toMatrix' e.toLinearMap := by
      simpa only [LinearMap.toMatrix'_comp, hD, hE] using congrArg LinearMap.toMatrix' h
    rw [hc, Matrix.mul_assoc]
    simp [U, ← LinearMap.toMatrix'_comp]
  rw [← hE, minorIdeal_units_mul_mul_units_eq]

/-- If the ideals of minors of a second block are `⊤` up to size `s` and `⊥` beyond, the
antidiagonal sum of products of ideals of minors of a block diagonal matrix is the ideal of
minors of the first block of size `r - s`. -/
theorem sum_antidiagonal_minorIdeal_mul_ite {R : Type*} [CommRing R] {l o : Type*}
    (T : Matrix l o R) (s r : ℕ) :
    ∑ p ∈ Finset.HasAntidiagonal.antidiagonal r, minorIdeal T p.1 * (if p.2 ≤ s then ⊤ else ⊥) =
      minorIdeal T (r - s) := by
  refine le_antisymm ?_ ?_
  · refine Finset.sum_induction _ (· ≤ minorIdeal T (r - s)) (fun a b ha hb => sup_le ha hb)
      bot_le ?_
    rintro ⟨a, b⟩ hp
    have hab : a + b = r := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
    split_ifs with hb
    · rw [Ideal.mul_top]
      exact antitone_nat_of_succ_le (minorIdeal_succ_le T) (by omega)
    · rw [Ideal.mul_bot]
      exact bot_le
  · have hmem := Finset.single_le_sum
      (f := fun p : ℕ × ℕ => minorIdeal T p.1 * (if p.2 ≤ s then ⊤ else ⊥ : Ideal R))
      (a := (r - s, r - (r - s))) (fun _ _ => bot_le)
      (Finset.HasAntidiagonal.mem_antidiagonal.mpr (show r - s + (r - (r - s)) = r by omega))
    refine le_trans ?_ hmem
    simp [show r - (r - s) ≤ s by omega]

end MinorIdeal

namespace BoundedComplex

variable {A B : Type u} [CommRing A] [CommRing B]

/-- The ideal `Fit_{i,k}` of a bounded complex of finite free modules: the ideal generated by
the minors of the matrix of `d^i : M^i → M^{i+1}` of size `n_{i+1} - n_{i+2} + n_{i+3} - ⋯ - k`,
where `n_j` is the rank of `M^j`. A nonpositive size gives the unit ideal. -/
def fittingMinorIdeal (C : BoundedComplex A) (i k : ℤ) : Ideal A :=
  minorIdeal (C.d i) (C.tailEulerCharacteristic (i + 1) - k).toNat

/-- The ideal `Fit_{i,k}` commutes with base change along a ring homomorphism. -/
theorem map_fittingMinorIdeal (φ : A →+* B) (C : BoundedComplex A) (i k : ℤ) :
    Ideal.map φ (C.fittingMinorIdeal i k) = (C.baseChange φ).fittingMinorIdeal i k := by
  rw [fittingMinorIdeal, fittingMinorIdeal, map_minorIdeal]
  rfl

/-- The ideal `Fit_{i,k}` is finitely generated. -/
theorem fittingMinorIdeal_fg (C : BoundedComplex A) (i k : ℤ) :
    (C.fittingMinorIdeal i k).FG :=
  fg_minorIdeal _ _

/-- The ideal `Fit_{i,k}` is unchanged by an isomorphism of the cochain complexes, that is, by
a change of the chosen bases. -/
theorem fittingMinorIdeal_eq_of_iso (M N : BoundedComplex A)
    (e : M.toCochainComplex ≅ N.toCochainComplex) (i k : ℤ) :
    M.fittingMinorIdeal i k = N.fittingMinorIdeal i k := by
  nontriviality A
  rw [fittingMinorIdeal, fittingMinorIdeal, tailEulerCharacteristic_eq_of_iso M N e]
  apply minorIdeal_eq_of_linearEquiv (M.d i) (N.d i)
    (HomologicalComplex.Hom.isoApp e i).toLinearEquiv
    (HomologicalComplex.Hom.isoApp e (i + 1)).toLinearEquiv
  have h := congrArg ModuleCat.Hom.hom (e.hom.comm i (i + 1)).symm
  rwa [BoundedComplex.toCochainComplex_d, BoundedComplex.toCochainComplex_d] at h

/-- The minors of the differential of a direct sum: `I_r(diag(d_M^i, d_P^i))` is the sum of
the products `I_a(d_M^i) I_b(d_P^i)` over `a + b = r`. -/
theorem minorIdeal_d_boundedComplexDirectSum (M P : BoundedComplex A) (i : ℤ) (r : ℕ) :
    minorIdeal ((boundedComplexDirectSum M P).d i) r =
      ∑ p ∈ Finset.HasAntidiagonal.antidiagonal r,
        minorIdeal (M.d i) p.1 * minorIdeal (P.d i) p.2 :=
  (minorIdeal_reindex _ _ _ r).trans (minorIdeal_fromBlocks _ _ r)

/-- If the ideals of minors of the `i`-th differential of `P` are `⊤` up to size `s` and `⊥`
beyond, the ideals of minors of that of `M ⊕ P` are those of `M` shifted down by `s`. -/
private theorem minorIdeal_d_boundedComplexDirectSum_of_ite (M P : BoundedComplex A) (i : ℤ)
    (s : ℕ) (hP : ∀ b, minorIdeal (P.d i) b = if b ≤ s then ⊤ else ⊥) (r : ℕ) :
    minorIdeal ((boundedComplexDirectSum M P).d i) r = minorIdeal (M.d i) (r - s) := by
  simp_rw [minorIdeal_d_boundedComplexDirectSum, hP]
  exact sum_antidiagonal_minorIdeal_mul_ite _ _ _

/-- Adding to `M^•` a complex `P^•` whose `i`-th differential has the ideals of minors of the
identity matrix of size `s = ∑_{j > i} (-1)^(j-i-1) rank Pʲ` does not change `Fit_{i,k}`. -/
theorem fittingMinorIdeal_boundedComplexDirectSum (M P : BoundedComplex A) (i k : ℤ) (s : ℕ)
    (hs : P.tailEulerCharacteristic (i + 1) = s)
    (hP : ∀ b, minorIdeal (P.d i) b = if b ≤ s then ⊤ else ⊥) :
    (boundedComplexDirectSum M P).fittingMinorIdeal i k = M.fittingMinorIdeal i k := by
  rw [fittingMinorIdeal, fittingMinorIdeal, minorIdeal_d_boundedComplexDirectSum_of_ite _ _ _ _ hP,
    tailEulerCharacteristic_directSum, hs]
  congr 1
  omega

/-- The ideals of minors of the `i`-th differential of the trivial two-term complex `A → A` in
degrees `j, j + 1` are those of the `1 × 1` identity matrix when `i = j`, and those of a matrix
with no rows or no columns otherwise. -/
theorem minorIdeal_d_trivialBoundedComplex (j i : ℤ) (b : ℕ) :
    minorIdeal ((trivialBoundedComplex (A := A) j).d i) b =
      if b ≤ (if i = j then 1 else 0) then ⊤ else ⊥ := by
  rcases b with _ | b
  · simp [minorIdeal_zero]
  by_cases hij : i = j
  · subst hij
    rcases b with _ | b
    · let u : Fin ((trivialBoundedComplex (A := A) i).rank (i + 1)) :=
        ⟨0, by simp [trivialBoundedComplex]⟩
      let v : Fin ((trivialBoundedComplex (A := A) i).rank i) :=
        ⟨0, by simp [trivialBoundedComplex]⟩
      rw [minorIdeal_one_eq_top_of_entry_one _ u v (by simp [trivialBoundedComplex]; rfl)]
      simp
    · rw [minorIdeal_eq_bot_of_card_lt _ _ (Or.inr (by simp [trivialBoundedComplex]))]
      simp
  · rw [ite_eq_right hij, ite_eq_right (by omega)]
    refine minorIdeal_eq_bot_of_card_lt _ _ ?_
    by_cases h : i = j + 1
    · exact Or.inl (by simp [trivialBoundedComplex, show i + 1 ≠ j by omega,
        show i + 1 ≠ j + 1 by omega])
    · exact Or.inr (by simp [trivialBoundedComplex, hij, h])

/-- A finite sum of cones of identities of rank-one free modules has a bounded matrix
presentation whose `i`-th differential has the ideals of minors of an identity matrix of size
`s`, where `s` is its tail Euler characteristic in degree `i + 1`. -/
theorem exists_trivialSum_minorIdeal (n : ℕ) (degree : Fin n → ℤ) (i : ℤ) :
    ∃ (P : BoundedComplex A) (s : ℕ),
      Nonempty (P.toCochainComplex ≅ ∏ᶜ fun j => CochainComplex.mappingCone
        (𝟙 ((CochainComplex.singleFunctor (ModuleCat A) (degree j)).obj
          (ModuleCat.of A (ULift.{0} A))))) ∧
      P.tailEulerCharacteristic (i + 1) = s ∧
      ∀ b, minorIdeal (P.d i) b = if b ≤ s then ⊤ else ⊥ := by
  classical
  induction n with
  | zero =>
    let Z : BoundedComplex A :=
      { rank := fun _ => 0
        d := fun _ => 0
        dd := by simp
        bounded := by simp }
    have hZ : IsZero Z.toCochainComplex := by
      apply (IsZero.iff_id_eq_zero _).mpr
      ext k x
      exact Subsingleton.elim (α := Fin 0 → A) _ _
    refine ⟨Z, 0, ⟨hZ.iso ((IsZero.iff_id_eq_zero _).mpr (Pi.hom_ext _ _ fun j => j.elim0))⟩,
      by simp [BoundedComplex.tailEulerCharacteristic, Z], ?_⟩
    rintro (_ | b)
    · simp [minorIdeal_zero]
    · rw [minorIdeal_eq_bot_of_card_lt _ _ (Or.inr (by simp [Z]))]
      simp
  | succ n ih =>
    obtain ⟨P, s, hP, hsP, hIP⟩ := ih (fun j => degree j.succ)
    let D := trivialBoundedComplex (A := A) (degree 0 - 1)
    have hD : Nonempty (D.toCochainComplex ≅ CochainComplex.mappingCone
        (𝟙 ((CochainComplex.singleFunctor (ModuleCat A) (degree 0)).obj
          (ModuleCat.of A (ULift.{0} A))))) :=
      ⟨trivialBoundedComplexIsoMappingCone (A := A) (degree 0 - 1) ≪≫
        eqToIso (congrArg (fun k : ℤ => CochainComplex.mappingCone
          (𝟙 ((CochainComplex.singleFunctor (ModuleCat A) k).obj
            (ModuleCat.of A (ULift.{0} A))))) (sub_add_cancel (degree 0) 1))⟩
    obtain ⟨e⟩ := exists_boundedPresentation_biprod _ _ D P hD hP
    refine ⟨boundedComplexDirectSum D P, (if i = degree 0 - 1 then 1 else 0) + s,
      ⟨e ≪≫ (piFinSuccIsoBiprod (fun j => CochainComplex.mappingCone
        (𝟙 ((CochainComplex.singleFunctor (ModuleCat A) (degree j)).obj
          (ModuleCat.of A (ULift.{0} A)))))).symm⟩, ?_, ?_⟩
    · rw [tailEulerCharacteristic_directSum, hsP, tailEulerCharacteristic_trivialBoundedComplex]
      split_ifs <;> push_cast <;> omega
    · intro b
      rw [minorIdeal_d_boundedComplexDirectSum_of_ite _ _ _ _ hIP,
        minorIdeal_d_trivialBoundedComplex]
      exact if_congr (by split_ifs <;> omega) rfl rfl

attribute [local instance] HasDerivedCategory.standard

/-- **The ideal `Fit_{i,k}` only depends on the object of `D(A)`.** If two bounded complexes of
finite free `A`-modules represent isomorphic objects of the derived category `D(A)`, then they
have the same ideals `Fit_{i,k}`. -/
theorem fittingMinorIdeal_eq_of_derivedIso (M N : BoundedComplex A)
    (h : Nonempty (DerivedCategory.Q.obj M.toCochainComplex ≅
      DerivedCategory.Q.obj N.toCochainComplex)) (i k : ℤ) :
    M.fittingMinorIdeal i k = N.fittingMinorIdeal i k := by
  apply ideal_eq_of_away_eq
  intro p hp
  let := hp
  have hterms (C : BoundedComplex A) (j : ℤ) :
      Module.Finite A (C.toCochainComplex.X j) ∧ Projective (C.toCochainComplex.X j) := by
    change Module.Finite A (Fin (C.rank j) → A) ∧
      Projective (ModuleCat.of A (Fin (C.rank j) → A))
    constructor <;> infer_instance
  obtain ⟨g, hg, P, Q, ⟨a, da, ⟨eP⟩⟩, ⟨b, db, ⟨eQ⟩⟩, ⟨e⟩⟩ :=
    StacksDraft.Perfect.exists_away_iso_biprod_trivial_complexes.{_, 0} p
      M.toCochainComplex N.toCochainComplex
      (toCochainComplex_bounded M) (toCochainComplex_bounded N)
      (hterms M) (hterms N) h
  obtain ⟨P', s, ⟨eP'⟩, hsP, hP⟩ :=
    exists_trivialSum_minorIdeal (A := Localization.Away g) a da i
  obtain ⟨Q', t, ⟨eQ'⟩, hsQ, hQ⟩ :=
    exists_trivialSum_minorIdeal (A := Localization.Away g) b db i
  refine ⟨g, hg, ?_⟩
  rw [map_fittingMinorIdeal, map_fittingMinorIdeal,
    ← fittingMinorIdeal_boundedComplexDirectSum (M.baseChange _) P' i k s hsP hP,
    ← fittingMinorIdeal_boundedComplexDirectSum (N.baseChange _) Q' i k t hsQ hQ]
  exact fittingMinorIdeal_eq_of_iso _ _ (directSumCochainIso _ _ ≪≫
    biprod.mapIso (baseChangeCochainIso (algebraMap A _) M).symm (eP' ≪≫ eP.symm) ≪≫
    e ≪≫ biprod.mapIso (baseChangeCochainIso (algebraMap A _) N) (eQ ≪≫ eQ'.symm) ≪≫
    (directSumCochainIso _ _).symm) i k

end BoundedComplex
