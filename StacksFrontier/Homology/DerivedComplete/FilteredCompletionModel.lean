/-!
# The telescope model of the derived completion of a filtered complex

Let `A` be a commutative ring and let `f : Fin r → A` be a finite family of elements. The
*telescope Hom model* `homModel f` is an exact endofunctor of `CochainComplex (ModuleCat A) ℤ`
which computes, degreewise and by countable products only, the derived completion of a complex
with respect to the ideal generated by `f`. Applied to a filtered complex it produces a filtered
complex `filteredCompletionModel f K` whose total complex represents the derived completion of
`K` and whose filtration is `Hom(P, F^pK)`, so that the spectral sequence of
`StacksFrontier.Algebra.Homology.SpectralSequence.FilteredComplex.Canonical` applied to it is the
derived-completion spectral sequence.

## Main definitions

* `AdicFilteredCompletion.homModel`: the telescope Hom model, built one generator at a time.
* `AdicFilteredCompletion.filteredCompletionModel`: the Hom model with the induced filtration,
  as a filtered complex in the sense of `CochainComplex.Filtered`.

## Main results

* `AdicFilteredCompletion.nonempty_iso_completion_homModel`: the Hom model represents the
  derived completion.
* `AdicFilteredCompletion.homModel_graded_iso`: the graded pieces of the filtered model are the
  Hom models of the graded pieces of `K`.
* `AdicFilteredCompletion.filteredCompletionModel_isDegreewiseFinite`: the filtration of the
  model is finite in each degree whenever that of `K` is.
* `AdicFilteredCompletion.converges_of_filtrationSubobject_finite`: convergence of the spectral
  sequence of a filtered complex whose filtration is finite in each degree, assembled from
  [Stacks, Tag 012W], [Stacks, Tag 012Q] and [Stacks, Tag 012V].

## Implementation notes

Derived completion is represented abstractly by any left adjoint to the inclusion of the full
subcategory of derived-complete objects, so nothing here depends on a choice of generators or of
a model for completion. The filtered complex produced is a
`CategoryTheory.FilteredObject (CochainComplex (ModuleCat A) ℤ) ℤᵒᵖ`, its degreewise filtration
is `CochainComplex.filtrationSubobject` and the filtration it induces on cohomology is
`CochainComplex.Filtered.inducedFiltrationStep`; these are reused rather than respelled.

## References

* [The Stacks Project, Tag 0BKD](https://stacks.math.columbia.edu/tag/0BKD)
* [Bhatt--Scholze, *Projectivity of the Witt vector affine Grassmannian*][BS]
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v

namespace AdicFilteredCompletion

section Cone

variable {C : Type*} [Category C] [Preadditive C] [HasBinaryBiproducts C]

open CochainComplex

variable {K₁ L₁ K₂ L₂ : CochainComplex C ℤ} (φ₁ : K₁ ⟶ L₁) (φ₂ : K₂ ⟶ L₂)
  (a : K₁ ⟶ K₂) (b : L₁ ⟶ L₂) (comm : φ₁ ≫ b = a ≫ φ₂)

private lemma coneMap_congr (a' : K₁ ⟶ K₂) (b' : L₁ ⟶ L₂)
    (ha : a = a') (hb : b = b') :
    CochainComplex.mappingCone.map φ₁ φ₂ a b comm =
      CochainComplex.mappingCone.map φ₁ φ₂ a' b' (ha ▸ hb ▸ comm) := by
  subst ha hb; rfl

end Cone

@[expose] section HomSide

open CochainComplex.FilteredInjective.Hom

variable {A : Type u} [CommRing A]

/-- `M ↦ ∏_ℕ M`. -/
public noncomputable def seqFunctor : ModuleCat.{v} A ⥤ ModuleCat.{v} A where
  obj M := ModuleCat.of A (ℕ → M)
  map g := ModuleCat.ofHom (LinearMap.compLeft g.hom ℕ)
  map_id _ := rfl
  map_comp _ _ := rfl

/-- The sequence functor `M ↦ ∏_ℕ M` is additive. -/
public noncomputable instance : (seqFunctor (A := A)).Additive where
  map_add := by intros; rfl

/-- `(y_n) ↦ (y_n - f y_{n+1})`. -/
public noncomputable def seqDifference (f : A) : seqFunctor (A := A) ⟶ seqFunctor where
  app M := ModuleCat.ofHom (LinearMap.id - f • LinearMap.funLeft A M Nat.succ)
  naturality _ _ g := by
    ext x
    funext n
    change g.hom (x n) - f • g.hom (x (n + 1)) = g.hom (x n - f • x (n + 1))
    rw [map_sub, map_smul]

/-- Evaluation at `0`. -/
public noncomputable def seqEval : seqFunctor (A := A) ⟶ 𝟭 (ModuleCat.{v} A) where
  app _ := ModuleCat.ofHom (LinearMap.proj 0)
  naturality _ _ _ := rfl

/-- The functor `seqFunctor` applied degreewise to cochain complexes. -/
public noncomputable abbrev seqComplexFunctor :
    CochainComplex (ModuleCat.{v} A) ℤ ⥤ CochainComplex (ModuleCat.{v} A) ℤ :=
  seqFunctor.mapHomologicalComplex (ComplexShape.up ℤ)

/-- The map `seqDifference f` applied degreewise to the complex `∏_ℕ H`. -/
public noncomputable abbrev seqComplexDifference (f : A)
    (H : CochainComplex (ModuleCat.{v} A) ℤ) :
    seqComplexFunctor.obj H ⟶ seqComplexFunctor.obj H :=
  (NatTrans.mapHomologicalComplex (seqDifference f) (ComplexShape.up ℤ)).app H

/-- Evaluation at `0`, applied degreewise: the natural transformation `∏_ℕ H ⟶ H`. -/
public noncomputable def seqComplexEval :
    seqComplexFunctor (A := A) ⟶ 𝟭 _ :=
  NatTrans.mapHomologicalComplex seqEval (ComplexShape.up ℤ) ≫
    (Functor.mapHomologicalComplexIdIso _ _).hom

/-- The map of mapping cones `cone(1 - f·shift)` induced by a map of complexes `H ⟶ H'`. -/
public noncomputable def homStepConeMap (f : A)
    {H H' : CochainComplex (ModuleCat.{v} A) ℤ} (g : H ⟶ H') :
    CochainComplex.mappingCone (seqComplexDifference f H) ⟶
      CochainComplex.mappingCone (seqComplexDifference f H') :=
  CochainComplex.mappingCone.map _ _ (seqComplexFunctor.map g) (seqComplexFunctor.map g)
    ((NatTrans.mapHomologicalComplex (seqDifference f) (ComplexShape.up ℤ)).naturality g).symm

/-- The dual comparison `cone(1 - f·shift) ⟶ H[1]`. -/
public noncomputable def homStepMap (f : A) (H : CochainComplex (ModuleCat.{v} A) ℤ) :
    CochainComplex.mappingCone (seqComplexDifference f H) ⟶ H⟦(1 : ℤ)⟧ :=
  (CochainComplex.mappingCone.triangle (seqComplexDifference f H)).mor₃ ≫
    (seqComplexEval.app H)⟦(1 : ℤ)⟧'

/-- The comparison `homStepMap f` is natural in the complex `H`. -/
public lemma homStepMap_naturality (f : A) {H H' : CochainComplex (ModuleCat.{v} A) ℤ}
    (g : H ⟶ H') :
    homStepMap f H ≫ g⟦(1 : ℤ)⟧' = homStepConeMap f g ≫ homStepMap f H' := by
  have h := (CochainComplex.mappingCone.triangleMap (seqComplexDifference f H)
    (seqComplexDifference f H') _ _
    ((NatTrans.mapHomologicalComplex (seqDifference f) (ComplexShape.up ℤ)).naturality
      g).symm).comm₃
  simp only [CochainComplex.mappingCone.triangleMap_hom₃,
    CochainComplex.mappingCone.triangleMap_hom₁] at h
  simp only [homStepMap, homStepConeMap]
  have hn : seqComplexEval.app H ≫ g = seqComplexFunctor.map g ≫ seqComplexEval.app H' :=
    (seqComplexEval.naturality g).symm
  erw [Category.assoc, ← Functor.map_comp, hn, Functor.map_comp, ← Category.assoc, h,
    Category.assoc]

private lemma homStepConeMap_id (f : A) (H : CochainComplex (ModuleCat.{v} A) ℤ) :
    homStepConeMap f (𝟙 H) = 𝟙 _ := by
  simp only [homStepConeMap]
  rw [coneMap_congr _ _ _ _ _ _ _ (seqComplexFunctor.map_id H) (seqComplexFunctor.map_id H)]
  exact CochainComplex.mappingCone.map_id _

private lemma homStepConeMap_comp (f : A) {H H' H'' : CochainComplex (ModuleCat.{v} A) ℤ}
    (g : H ⟶ H') (g' : H' ⟶ H'') :
    homStepConeMap f (g ≫ g') = homStepConeMap f g ≫ homStepConeMap f g' := by
  simp only [homStepConeMap]
  rw [coneMap_congr _ _ _ _ _ _ _ (seqComplexFunctor.map_comp g g')
    (seqComplexFunctor.map_comp g g')]
  exact CochainComplex.mappingCone.map_comp _ _ _ _ _ _ _ _ _

/-- The map `cone(homStepMap f H) ⟶ cone(homStepMap f H')` induced by a map of complexes
`H ⟶ H'`. -/
public noncomputable def homStepCone (f : A) {H H' : CochainComplex (ModuleCat.{v} A) ℤ}
    (g : H ⟶ H') :
    CochainComplex.mappingCone (homStepMap f H) ⟶ CochainComplex.mappingCone (homStepMap f H') :=
  CochainComplex.mappingCone.map _ _ (homStepConeMap f g) (g⟦(1 : ℤ)⟧')
    (homStepMap_naturality f g)

private lemma homStepCone_id (f : A) (H : CochainComplex (ModuleCat.{v} A) ℤ) :
    homStepCone f (𝟙 H) = 𝟙 _ := by
  unfold homStepCone
  rw [coneMap_congr _ _ _ _ _ _ _ (homStepConeMap_id f H)
    ((shiftFunctor (CochainComplex (ModuleCat.{v} A) ℤ) (1 : ℤ)).map_id H)]
  exact CochainComplex.mappingCone.map_id _

private lemma homStepCone_comp (f : A) {H H' H'' : CochainComplex (ModuleCat.{v} A) ℤ}
    (g : H ⟶ H') (g' : H' ⟶ H'') :
    homStepCone f (g ≫ g') = homStepCone f g ≫ homStepCone f g' := by
  unfold homStepCone
  rw [coneMap_congr _ _ _ _ _ _ _ (homStepConeMap_comp f g g')
    ((shiftFunctor (CochainComplex (ModuleCat.{v} A) ℤ) (1 : ℤ)).map_comp g g')]
  exact CochainComplex.mappingCone.map_comp _ _ _ _ _ _ _ _ _

/-- One step `H ↦ cone(cone(1 - f·shift) ⟶ H[1])[-1]` of the explicit telescope Hom model. -/
public noncomputable def homStep (f : A) :
    CochainComplex (ModuleCat.{v} A) ℤ ⥤ CochainComplex (ModuleCat.{v} A) ℤ where
  obj H := (CochainComplex.mappingCone (homStepMap f H))⟦(-1 : ℤ)⟧
  map g := (homStepCone f g)⟦(-1 : ℤ)⟧'
  map_id H := by rw [homStepCone_id, CategoryTheory.Functor.map_id]
  map_comp g g' := by rw [homStepCone_comp, CategoryTheory.Functor.map_comp]

/-- The explicit model `H ↦ Hom(P, H)` for the tensor product `P` of the telescope complexes of
the generators, built one generator at a time. -/
public noncomputable def homModel : {r : ℕ} → (Fin r → A) →
    CochainComplex (ModuleCat.{v} A) ℤ ⥤ CochainComplex (ModuleCat.{v} A) ℤ
  | 0, _ => 𝟭 _
  | _ + 1, generators => homModel (Fin.tail generators) ⋙ homStep (generators 0)

private lemma seqFunctor_map_injective {M N : ModuleCat.{v} A} (g : M ⟶ N)
    (hg : Function.Injective g) : Function.Injective (seqFunctor.map g) := by
  intro x y h
  funext n
  exact hg (congrFun h n)

private lemma homStep_map_f_mono (f : A) {H H' : CochainComplex (ModuleCat.{v} A) ℤ}
    (g : H ⟶ H') (n : ℤ) (h₀ : Mono (g.f n)) (h₁ : Mono (g.f (n + 1))) :
    Mono (((homStep f).map g).f n) := by
  have hs : ∀ m, Mono (g.f m) → Mono ((seqComplexFunctor.map g).f m) := fun m hm => by
    rw [ModuleCat.mono_iff_injective] at hm ⊢
    exact seqFunctor_map_injective _ hm
  show Mono ((homStepCone f g).f (n + -1))
  refine CochainComplex.mappingCone.mono_map_f _ _ _ _ _ _ ?_ ?_
  · refine CochainComplex.mappingCone.mono_map_f _ _ _ _ _ _ ?_
      (hs _ (by rwa [show n + -1 + 1 = n by omega]))
    exact hs _ (by rwa [show n + -1 + 1 + 1 = n + 1 by omega])
  · show Mono (g.f (n + -1 + 1))
    rwa [show n + -1 + 1 = n by omega]

private lemma homStep_map_f_isIso (f : A) {H H' : CochainComplex (ModuleCat.{v} A) ℤ}
    (g : H ⟶ H') (n : ℤ) (h₀ : IsIso (g.f n)) (h₁ : IsIso (g.f (n + 1))) :
    IsIso (((homStep f).map g).f n) := by
  have hs : ∀ m, IsIso (g.f m) → IsIso ((seqComplexFunctor.map g).f m) := fun m hm => by
    show IsIso (seqFunctor.map (g.f m)); infer_instance
  have e₀ : IsIso (g.f (n + -1 + 1)) := by rwa [show n + -1 + 1 = n by omega]
  have e₁ : IsIso ((seqComplexFunctor.map g).f (n + -1 + 1)) := hs _ e₀
  have e₂ : IsIso ((seqComplexFunctor.map g).f (n + -1 + 1 + 1)) :=
    hs _ (by rwa [show n + -1 + 1 + 1 = n + 1 by omega])
  have c : IsIso ((homStepConeMap f g).f (n + -1 + 1)) := by
    have hc := ((NatTrans.mapHomologicalComplex (seqDifference f) (ComplexShape.up ℤ)).naturality
      g).symm
    have := CochainComplex.mappingCone.mono_map_f _ _ _ _ hc (n + -1 + 1)
      inferInstance inferInstance
    have := CochainComplex.mappingCone.epi_map_f _ _ _ _ hc (n + -1 + 1)
      inferInstance inferInstance
    unfold homStepConeMap
    exact isIso_of_mono_of_epi _
  have e₃ : IsIso ((g⟦(1 : ℤ)⟧').f (n + -1)) := e₀
  show IsIso ((homStepCone f g).f (n + -1))
  have := CochainComplex.mappingCone.mono_map_f _ _ _ _ (homStepMap_naturality f g) (n + -1)
    (inferInstanceAs (Mono ((homStepConeMap f g).f (n + -1 + 1))))
    (inferInstanceAs (Mono ((g⟦(1 : ℤ)⟧').f (n + -1))))
  have := CochainComplex.mappingCone.epi_map_f _ _ _ _ (homStepMap_naturality f g) (n + -1)
    (inferInstanceAs (Epi ((homStepConeMap f g).f (n + -1 + 1))))
    (inferInstanceAs (Epi ((g⟦(1 : ℤ)⟧').f (n + -1))))
  unfold homStepCone
  exact isIso_of_mono_of_epi _

private lemma homStep_obj_X_isZero (f : A) (H : CochainComplex (ModuleCat.{v} A) ℤ) (n : ℤ)
    (h₀ : IsZero (H.X n)) (h₁ : IsZero (H.X (n + 1))) :
    IsZero (((homStep f).obj H).X n) := by
  have hs : ∀ m, IsZero (H.X m) → IsZero ((seqComplexFunctor.obj H).X m) := fun m hm =>
    seqFunctor.map_isZero hm
  show IsZero ((CochainComplex.mappingCone (homStepMap f H)).X (n + -1))
  rw [CochainComplex.mappingCone.isZero_X_iff, CochainComplex.mappingCone.isZero_X_iff]
  refine ⟨⟨hs _ ?_, hs _ ?_⟩, ?_⟩
  · rwa [show n + -1 + 1 + 1 = n + 1 by omega]
  · rwa [show n + -1 + 1 = n by omega]
  · show IsZero (H.X (n + -1 + 1))
    rwa [show n + -1 + 1 = n by omega]

/-- The telescope Hom model sends a map that is a monomorphism in degrees `n, …, n + r` to a map
that is a monomorphism in degree `n`. -/
public lemma homModel_map_f_mono : ∀ {r : ℕ} (generators : Fin r → A)
    {H H' : CochainComplex (ModuleCat.{v} A) ℤ} (g : H ⟶ H') (n : ℤ),
    (∀ m : ℤ, n ≤ m → m ≤ n + r → Mono (g.f m)) → Mono (((homModel generators).map g).f n)
  | 0, _, _, _, g, n, h => h n le_rfl (by simp)
  | r + 1, generators, _, _, g, n, h => by
    show Mono (((homStep (generators 0)).map ((homModel (Fin.tail generators)).map g)).f n)
    refine homStep_map_f_mono _ _ _ ?_ ?_
    · exact homModel_map_f_mono _ g n fun m h₁ h₂ => h m h₁ (by push_cast; omega)
    · exact homModel_map_f_mono _ g (n + 1) fun m h₁ h₂ => h m (by omega) (by push_cast; omega)

/-- The telescope Hom model sends a map that is an isomorphism in degrees `n, …, n + r` to a map
that is an isomorphism in degree `n`. -/
public lemma homModel_map_f_isIso : ∀ {r : ℕ} (generators : Fin r → A)
    {H H' : CochainComplex (ModuleCat.{v} A) ℤ} (g : H ⟶ H') (n : ℤ),
    (∀ m : ℤ, n ≤ m → m ≤ n + r → IsIso (g.f m)) → IsIso (((homModel generators).map g).f n)
  | 0, _, _, _, g, n, h => h n le_rfl (by simp)
  | r + 1, generators, _, _, g, n, h => by
    show IsIso (((homStep (generators 0)).map ((homModel (Fin.tail generators)).map g)).f n)
    refine homStep_map_f_isIso _ _ _ ?_ ?_
    · exact homModel_map_f_isIso _ g n fun m h₁ h₂ => h m h₁ (by push_cast; omega)
    · exact homModel_map_f_isIso _ g (n + 1) fun m h₁ h₂ => h m (by omega) (by push_cast; omega)

/-- The telescope Hom model of a complex that is zero in degrees `n, …, n + r` is zero in
degree `n`. -/
public lemma homModel_obj_X_isZero : ∀ {r : ℕ} (generators : Fin r → A)
    (H : CochainComplex (ModuleCat.{v} A) ℤ) (n : ℤ),
    (∀ m : ℤ, n ≤ m → m ≤ n + r → IsZero (H.X m)) → IsZero (((homModel generators).obj H).X n)
  | 0, _, H, n, h => h n le_rfl (by simp)
  | r + 1, generators, H, n, h => by
    show IsZero (((homStep (generators 0)).obj ((homModel (Fin.tail generators)).obj H)).X n)
    refine homStep_obj_X_isZero _ _ _ ?_ ?_
    · exact homModel_obj_X_isZero _ H n fun m h₁ h₂ => h m h₁ (by push_cast; omega)
    · exact homModel_obj_X_isZero _ H (n + 1) fun m h₁ h₂ => h m (by omega) (by push_cast; omega)

/-- The telescope Hom model preserves monomorphisms of complexes. -/
public lemma homModel_map_mono {r : ℕ} (generators : Fin r → A)
    {H H' : CochainComplex (ModuleCat.{v} A) ℤ} (g : H ⟶ H') [Mono g] :
    Mono ((homModel generators).map g) :=
  HomologicalComplex.mono_of_mono_f _ fun n =>
    homModel_map_f_mono generators g n fun _ _ _ => inferInstance

end HomSide

@[expose] section Filtered

variable {A : Type u} [CommRing A]

private lemma filtration_isIso_of_le {X : CochainComplex (ModuleCat.{v} A) ℤ}
    (F : Filtration X ℤᵒᵖ) {p p' : ℤ} (h : p' ≤ p) (n : ℤ)
    (hp : IsIso ((F.ι.app (op p)).f n)) : IsIso ((F.ι.app (op p')).f n) := by
  have : Epi ((F.ι.app (op p')).f n) := epi_of_epi_fac (f := (F.diagram.map (homOfLE h).op).f n)
    (by rw [← HomologicalComplex.comp_f, Filtration.diagram_map_comp_ι_app])
  exact isIso_of_mono_of_epi _

private lemma filtration_isZero_of_le {X : CochainComplex (ModuleCat.{v} A) ℤ}
    (F : Filtration X ℤᵒᵖ) {q q' : ℤ} (h : q ≤ q') (n : ℤ)
    (hq : IsZero ((F.obj (op q)).X n)) : IsZero ((F.obj (op q')).X n) := by
  have : Mono ((F.diagram.map (homOfLE h).op).f n) := mono_of_mono_fac
    (show _ ≫ (F.ι.app (op q)).f n = (F.ι.app (op q')).f n by
      rw [← HomologicalComplex.comp_f, Filtration.diagram_map_comp_ι_app])
  exact IsZero.of_mono ((F.diagram.map (homOfLE h).op).f n) hq

private lemma filtration_window {X : CochainComplex (ModuleCat.{v} A) ℤ}
    (F : Filtration X ℤᵒᵖ) (hF : F.IsDegreewiseFinite) (n : ℤ) :
    ∀ r : ℕ, ∃ p q : ℤ, p ≤ q ∧ ∀ m : ℤ, n ≤ m → m ≤ n + r →
      IsIso ((F.ι.app (op p)).f m) ∧ IsZero ((F.obj (op q)).X m)
  | 0 => by
    obtain ⟨p, q, hp, hq⟩ := hF n
    refine ⟨min p q, q, min_le_right _ _, fun m h₁ h₂ => ?_⟩
    obtain rfl : m = n := by push_cast at h₂; omega
    exact ⟨filtration_isIso_of_le F (min_le_left _ _) _ hp, hq⟩
  | r + 1 => by
    obtain ⟨p, q, hpq, h⟩ := filtration_window F hF n r
    obtain ⟨p', q', hp', hq'⟩ := hF (n + (r + 1 : ℕ))
    refine ⟨min p p', max q q', le_trans (min_le_left _ _) (le_trans hpq (le_max_left _ _)),
      fun m h₁ h₂ => ?_⟩
    by_cases hm : m ≤ n + r
    · exact ⟨filtration_isIso_of_le F (min_le_left _ _) _ (h m h₁ hm).1,
        filtration_isZero_of_le F (le_max_left _ _) _ (h m h₁ hm).2⟩
    · obtain rfl : m = n + (r + 1 : ℕ) := by push_cast at h₂ ⊢; omega
      exact ⟨filtration_isIso_of_le F (min_le_right _ _) _ hp',
        filtration_isZero_of_le F (le_max_right _ _) _ hq'⟩

/-- The filtration `F^p Hom(P, K) = Hom(P, F^p K)` of the explicit model of `Hom(P, K)`. -/
public noncomputable def homModelFiltration {r : ℕ} (generators : Fin r → A)
    (filtered : FilteredObject (CochainComplex (ModuleCat.{v} A) ℤ) ℤᵒᵖ) (p : ℤ) :
    Subobject ((homModel generators).obj filtered.X) :=
  haveI := homModel_map_mono generators (filtered.filtration.ι.app (op p))
  Subobject.mk ((homModel generators).map (filtered.filtration.ι.app (op p)))

/-- The filtration `homModelFiltration` of the telescope Hom model is antitone. -/
public lemma homModelFiltration_antitone {r : ℕ} (generators : Fin r → A)
    (filtered : FilteredObject (CochainComplex (ModuleCat.{v} A) ℤ) ℤᵒᵖ) :
    Antitone (homModelFiltration generators filtered) := by
  intro p p' h
  have := homModel_map_mono generators (filtered.filtration.ι.app (op p))
  have := homModel_map_mono generators (filtered.filtration.ι.app (op p'))
  refine Subobject.mk_le_mk_of_comm
    ((homModel generators).map (filtered.filtration.diagram.map (homOfLE h).op)) ?_
  rw [← Functor.map_comp, filtered.filtration.ι.naturality]
  simp

end Filtered

@[expose] section FilteredModel

variable {A : Type u} [CommRing A]

/-- The filtered complex `Hom(P, K)` with filtration `Hom(P, F^pK)`, where `P` is the telescope
Čech model on `generators`, computed by countable products in the universe of the
coefficients. -/
noncomputable def filteredCompletionModel {r : ℕ} (generators : Fin r → A)
    (filtered : FilteredObject (CochainComplex (ModuleCat.{v} A) ℤ) ℤᵒᵖ) :
    CochainComplex.Filtered (ModuleCat.{v} A) where
  X := (homModel generators).obj filtered.X
  filtration := Filtration.ofAntitone (homModelFiltration generators filtered)
    (homModelFiltration_antitone generators filtered)

/-- The total complex of the filtered completion model is the telescope Hom model. -/
theorem filteredCompletionModel_X {r : ℕ} (generators : Fin r → A)
    (filtered : FilteredObject (CochainComplex (ModuleCat.{v} A) ℤ) ℤᵒᵖ) :
    (filteredCompletionModel generators filtered).X =
      (homModel generators).obj filtered.X :=
  rfl

/-- The filtration is obtained by applying the telescope Hom functor to the original
filtration. -/
theorem filteredCompletionModel_subobject {r : ℕ} (generators : Fin r → A)
    (filtered : FilteredObject (CochainComplex (ModuleCat.{v} A) ℤ) ℤᵒᵖ) (p : ℤ) :
    (filteredCompletionModel generators filtered).filtration.subobject (op p) =
      homModelFiltration generators filtered p :=
  Filtration.subobject_ofAntitone (homModelFiltration generators filtered)
    (homModelFiltration_antitone generators filtered) p

/-- If the filtration of `K` is finite in each degree, so is the filtration of the telescope
model of `Hom(P, K)`. -/
theorem filteredCompletionModel_isDegreewiseFinite {r : ℕ} (generators : Fin r → A)
    (filtered : FilteredObject (CochainComplex (ModuleCat.{v} A) ℤ) ℤᵒᵖ)
    (hfinite : filtered.filtration.IsDegreewiseFinite) :
    (filteredCompletionModel generators filtered).filtration.IsDegreewiseFinite := by
  intro degree
  obtain ⟨p, q, -, h⟩ := filtration_window filtered.filtration hfinite degree r
  refine ⟨p, q, ?_, ?_⟩
  · have := homModel_map_mono generators (filtered.filtration.ι.app (op p))
    have hι : IsIso (((homModel generators).map (filtered.filtration.ι.app (op p))).f degree) :=
      homModel_map_f_isIso generators _ degree fun m h₁ h₂ => (h m h₁ h₂).1
    let e := (HomologicalComplex.eval _ _ degree).mapIso (Subobject.underlyingIso
      ((homModel generators).map (filtered.filtration.ι.app (op p))))
    have hc : e.hom ≫ ((homModel generators).map (filtered.filtration.ι.app (op p))).f degree =
        (Subobject.arrow (Subobject.mk
          ((homModel generators).map (filtered.filtration.ι.app (op p))))).f degree := by
      simp [e, ← HomologicalComplex.comp_f]
    show IsIso ((Subobject.arrow (Subobject.mk
      ((homModel generators).map (filtered.filtration.ι.app (op p))))).f degree)
    rw [← hc]
    infer_instance
  · have := homModel_map_mono generators (filtered.filtration.ι.app (op q))
    have hz : IsZero (((homModel generators).obj (filtered.filtration.obj (op q))).X degree) :=
      homModel_obj_X_isZero generators _ degree fun m h₁ h₂ => (h m h₁ h₂).2
    exact hz.of_iso ((HomologicalComplex.eval _ _ degree).mapIso (Subobject.underlyingIso
      ((homModel generators).map (filtered.filtration.ι.app (op q)))))

end FilteredModel


section Convergence

variable {C : Type u} [Category.{v} C] [Abelian C]

/-- The graded piece `im(h) / im(g ≫ f)` computed by `image.preComp` agrees with the quotient
of image subobjects, compatibly with the projections from `im f`. -/
private lemma exists_cokernel_preComp_iso {X Y Z : C} (g : X ⟶ Y) (f : Y ⟶ Z) (h : X ⟶ Z)
    (hh : h = g ≫ f) :
    ∃ (hle : imageSubobject h ≤ imageSubobject f)
      (e : cokernel (image.preComp g f) ≅ cokernel (Subobject.ofLE _ _ hle)),
      cokernel.π _ ≫ e.hom = (imageSubobjectIso f).inv ≫ cokernel.π _ := by
  subst hh
  have w : image.preComp g f ≫ (imageSubobjectIso f).inv =
      (imageSubobjectIso (g ≫ f)).inv ≫ Subobject.ofLE _ _ (imageSubobject_comp_le g f) := by
    rw [← cancel_mono (imageSubobject f).arrow]
    simp
  refine ⟨imageSubobject_comp_le g f,
    cokernel.mapIso _ _ (imageSubobjectIso (g ≫ f)).symm (imageSubobjectIso f).symm w, ?_⟩
  simp [cokernel.mapIso]

/-- **Convergence of the spectral sequence of a filtered complex whose filtration is finite in
each degree**, in the form used by [Stacks, Tag 0BKD]: the first page is supported on finitely
many antidiagonal positions, the induced filtration on each cohomology object is finite, the
differentials vanish for large `r`, the stable cycles and boundaries exist and are the expected
subobjects, and the associated graded of the induced filtration is the stable page. -/
lemma converges_of_filtrationSubobject_finite (L : CochainComplex.Filtered C)
    (hL : L.filtration.IsDegreewiseFinite) :
    let E := CochainComplex.Filtered.spectralSequenceFunctor.obj L
    (∀ n : ℤ, {p : ℤ | ¬ IsZero ((E.page 1 (by omega)).X (p, n - p))}.Finite) ∧
    (∀ n : ℤ, ∃ a b : ℤ, a ≤ b ∧
      L.inducedFiltrationStep n a = ⊤ ∧ L.inducedFiltrationStep n b = ⊥) ∧
    (∀ p q : ℤ, ∃ b : ℤ, ∀ (r : ℤ) (hr : 0 ≤ r), b ≤ r →
      (E.page r hr).d (p, q) (p + r, q - r + 1) = 0) ∧
    (∀ p n : ℤ,
      IsGLB (Set.range fun r : ℕ ↦
          CochainComplex.filtrationSubobject L p n ⊓
            (Subobject.pullback (L.X.d n (n + 1))).obj
              (CochainComplex.filtrationSubobject L (p + r) (n + 1)) ⊔
            CochainComplex.filtrationSubobject L (p + 1) n)
        (kernelSubobject (L.X.d n (n + 1)) ⊓ CochainComplex.filtrationSubobject L p n ⊔
          CochainComplex.filtrationSubobject L (p + 1) n) ∧
      IsLUB (Set.range fun r : ℕ ↦
          CochainComplex.filtrationSubobject L p n ⊓
            (Subobject.«exists» (L.X.d (n - 1) n)).obj
              (CochainComplex.filtrationSubobject L (p - r) (n - 1)) ⊔
            CochainComplex.filtrationSubobject L (p + 1) n)
        (imageSubobject (L.X.d (n - 1) n) ⊓ CochainComplex.filtrationSubobject L p n ⊔
          CochainComplex.filtrationSubobject L (p + 1) n)) ∧
    (∀ p n : ℤ,
      let A := (Subobject.pullback (L.X.iCycles n)).obj
        (CochainComplex.filtrationSubobject L p n)
      let N := kernelSubobject (L.X.d n (n + 1)) ⊓ CochainComplex.filtrationSubobject L p n ⊔
        CochainComplex.filtrationSubobject L (p + 1) n
      let B := imageSubobject (L.X.d (n - 1) n) ⊓ CochainComplex.filtrationSubobject L p n ⊔
        CochainComplex.filtrationSubobject L (p + 1) n
      ∃ (a : (A : C) ⟶ (N : C))
        (b : (A : C) ⟶ (L.inducedFiltrationStep n p : C))
        (hFH : L.inducedFiltrationStep n (p + 1) ≤ L.inducedFiltrationStep n p)
        (e : cokernel (Subobject.ofLE (B ⊓ N) N inf_le_right) ≅
          cokernel (Subobject.ofLE _ _ hFH)),
        A.arrow ≫ L.X.iCycles n = a ≫ N.arrow ∧
        A.arrow ≫ L.X.homologyπ n = b ≫ (L.inducedFiltrationStep n p).arrow ∧
        a ≫ cokernel.π (Subobject.ofLE (B ⊓ N) N inf_le_right) ≫ e.hom =
          b ≫ cokernel.π (Subobject.ofLE _ _ hFH)) := by
  intro E
  obtain ⟨hbounded, hfinite, hregular, hstable, -⟩ :=
    CochainComplex.isBounded_and_converges_of_isDegreewiseFinite L hL
      (CochainComplex.filtrationSubobject L) (fun _ _ => rfl)
      (FilteredComplexSpectralSequence.cycles L.X (CochainComplex.filtrationSubobject L))
      (fun _ _ _ => rfl)
      (FilteredComplexSpectralSequence.boundaries L.X (CochainComplex.filtrationSubobject L))
      (fun _ _ _ => rfl)
      (fun n p => L.inducedFiltrationStep n p) (fun _ _ => rfl)
      E (fun r p q n hr hn => by
        subst n
        exact CochainComplex.Filtered.pageIso L r p q hr)
  refine ⟨fun n => (hbounded n).subset fun p hp h0 => hp ?_, hfinite, hregular, hstable, ?_⟩
  · exact E.isZero_page_of_le le_rfl _ h0 1 (by omega) _
  intro p n A N B
  obtain ⟨-, a, b, _, _, _, ha, hb, _⟩ :=
    CochainComplex.exists_epi_gradedPiece_homology_of_isGLB_isLUB L p n
      (CochainComplex.filtrationSubobject L) (fun _ _ => rfl) A rfl N B
      (hstable p n).1 (hstable p n).2
  obtain ⟨hFH, e₂, he₂⟩ := exists_cokernel_preComp_iso
    (HomologicalComplex.homologyMap (L.filtration.diagram.map
      (homOfLE (Int.le_add_one le_rfl) : (p : ℤ) ⟶ p + 1).op) n)
    (HomologicalComplex.homologyMap (L.filtration.ι.app (op p)) n)
    (HomologicalComplex.homologyMap (L.filtration.ι.app (op (p + 1))) n) (by
      rw [← HomologicalComplex.homologyMap_comp, Filtration.diagram_map_comp_ι_app])
  obtain ⟨e, he⟩ :=
    ((CochainComplex.exists_iso_stablePage_iff_and_isGLB_isLUB_inducedFiltration_iff
      L p n (CochainComplex.filtrationSubobject L) (fun _ _ => rfl) A rfl N B rfl rfl
      (fun p' => L.inducedFiltrationStep n p') (fun _ => rfl)).1 N B
      (hstable p n).1 (hstable p n).2 a ha.symm b hb.symm).2 ⟨rfl, rfl⟩
  refine ⟨a, b ≫ (imageSubobjectIso _).inv, hFH, e ≪≫ e₂, ha, ?_, ?_⟩
  · have := b ≫= imageSubobject_arrow' (HomologicalComplex.homologyMap
      (L.filtration.ι.app (op p)) n)
    rw [← Category.assoc] at this
    exact hb.trans this.symm
  · have := he =≫ e₂.hom
    simp only [Category.assoc, he₂] at this
    exact this.trans (Category.assoc _ _ _).symm

end Convergence


section Reflection

open CategoryTheory.Pretriangulated

/-- If `η : X ⟶ Y` with `Y` in a reflective subcategory induces bijections on morphisms into
every object of the subcategory, then `Y` is isomorphic to the reflection of `X`. -/
private lemma nonempty_iso_reflection_of_bijective {D : Type*} [Category D]
    {P : ObjectProperty D} {L : D ⥤ P.FullSubcategory} (adj : L ⊣ P.ι) {X Y : D}
    (η : X ⟶ Y) (hY : P Y)
    (h : ∀ E, P E → Function.Bijective (fun g : Y ⟶ E => η ≫ g)) :
    Nonempty (Y ≅ (L ⋙ P.ι).obj X) := by
  obtain ⟨a, ha⟩ := (h _ ((L.obj X).property)).2 (adj.unit.app X)
  simp only at ha
  let b : (L ⋙ P.ι).obj X ⟶ Y := P.ι.map ((adj.homEquiv X ⟨Y, hY⟩).symm η)
  have hb : adj.unit.app X ≫ b = η := by
    simp only [b]
    exact (adj.homEquiv_apply X ⟨Y, hY⟩ _).symm.trans ((adj.homEquiv X ⟨Y, hY⟩).apply_symm_apply η)
  refine ⟨⟨a, b, ?_, ?_⟩⟩
  · apply (h Y hY).1
    show η ≫ a ≫ b = η ≫ 𝟙 Y
    rw [reassoc_of% ha, hb, Category.comp_id]
  · have key : ∀ g g' : L.obj X ⟶ L.obj X,
        adj.unit.app X ≫ P.ι.map g = adj.unit.app X ≫ P.ι.map g' → g = g' := fun g g' hg =>
      (adj.homEquiv _ _).injective (by rw [adj.homEquiv_unit, adj.homEquiv_unit]; exact hg)
    have := key (P.fullyFaithfulι.preimage (b ≫ a)) (𝟙 _) (by
      rw [Functor.FullyFaithful.map_preimage, CategoryTheory.Functor.map_id]
      show adj.unit.app X ≫ b ≫ a = adj.unit.app X ≫ 𝟙 _
      rw [reassoc_of% hb, ha, Category.comp_id])
    have h2 := congrArg P.ι.map this
    rwa [Functor.FullyFaithful.map_preimage, CategoryTheory.Functor.map_id] at h2

section Orthogonal

variable {C : Type*} [Category C] [HasZeroObject C] [HasShift C ℤ] [Preadditive C]
  [∀ n : ℤ, (shiftFunctor C n).Additive] [Pretriangulated C]

/-- In a distinguished triangle `X ⟶ Y ⟶ Z ⟶ X[1]`, precomposition with `X ⟶ Y` is bijective on
morphisms into `E` as soon as `Z` and `Z[-1]` have no nonzero morphisms to `E`. -/
private lemma bijective_precomp_of_orthogonal (T : Triangle C) (hT : T ∈ distTriang C) (E : C)
    (h₀ : ∀ g : T.obj₃ ⟶ E, g = 0) (h₁ : ∀ g : T.obj₃⟦(-1 : ℤ)⟧ ⟶ E, g = 0) :
    Function.Bijective (fun g : T.obj₂ ⟶ E => T.mor₁ ≫ g) := by
  constructor
  · intro g g' hg
    rw [← sub_eq_zero]
    obtain ⟨k, hk⟩ := Triangle.yoneda_exact₂ T hT (g - g')
      (by simpa [Preadditive.comp_sub, sub_eq_zero] using hg)
    rw [hk, h₀ k, comp_zero]
  · intro k
    obtain ⟨g, hg⟩ := Triangle.yoneda_exact₂ _ (inv_rot_of_distTriang _ hT) k (h₁ _)
    exact ⟨g, hg.symm⟩

end Orthogonal

end Reflection

attribute [local instance] HasDerivedCategory.standard

open CategoryTheory.Pretriangulated in
/-- A morphism from an object on which `f` acts invertibly to an object whose derived limit
`T(E, f)` vanishes is zero. -/
private lemma hom_eq_zero_of_isIso_smul_of_derivedLimit_isZero
    {A : Type u} [CommRing A] [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{v} A))]
    (f : A) {X E : DerivedCategory (ModuleCat.{v} A)} (hX : IsIso (f • 𝟙 X))
    (hE : ∃ L, Pretriangulated.IsDerivedLimit
      (Functor.ofOpSequence (X := fun _ : ℕ => E) (fun _ => f • 𝟙 E)) L ∧ IsZero L)
    (g : X ⟶ E) : g = 0 := by
  obtain ⟨L, ⟨p, δ, hT⟩, hL⟩ := hE
  have hD := (Triangle.isZero₁_iff_isIso₂ _ hT).mp hL
  simp only [Triangle.mk_mor₂, Functor.ofOpSequence_map_homOfLE_succ] at hD
  let w : End X := .of (inv (f • 𝟙 X))
  have hw : (f • 𝟙 X) ≫ w.asHom = 𝟙 X := IsIso.hom_inv_id _
  let a : X ⟶ ∏ᶜ fun _ : ℕ => E := Pi.lift fun n => (w ^ n).asHom ≫ g
  have ha : a ≫ Pi.lift (fun n : ℕ => Pi.π (fun _ : ℕ => E) n -
      Pi.π (fun _ : ℕ => E) (n + 1) ≫ (f • 𝟙 E)) = 0 := by
    apply Pi.hom_ext
    intro n
    simp only [a, Category.assoc, Pi.lift_comp_π, Preadditive.comp_sub, Pi.lift_comp_π_assoc,
      zero_comp]
    rw [sub_eq_zero, Linear.comp_smul, Category.comp_id, pow_succ, End.mul_asHom]
    have hc : (w ^ n).asHom ≫ (f • 𝟙 X) = (f • 𝟙 X) ≫ (w ^ n).asHom := by
      simp only [Linear.comp_smul, Linear.smul_comp, Category.comp_id, Category.id_comp]
    have hw' : w.asHom ≫ (f • 𝟙 X) = 𝟙 X := IsIso.inv_hom_id _
    rw [show f • g = (f • 𝟙 X) ≫ g by simp, Category.assoc, reassoc_of% hc,
      reassoc_of% hw']
  have hD' : IsIso (Pi.lift (fun n : ℕ => Pi.π (fun _ : ℕ => E) n -
      Pi.π (fun _ : ℕ => E) (n + 1) ≫ (f • 𝟙 E))) := hD
  have h0 : a = 0 := by
    rw [← cancel_mono (Pi.lift (fun n : ℕ => Pi.π (fun _ : ℕ => E) n -
      Pi.π (fun _ : ℕ => E) (n + 1) ≫ (f • 𝟙 E))), ha, zero_comp]
  have := congrArg (· ≫ Pi.π (fun _ : ℕ => E) 0) h0
  simpa [a] using this

/-- Multiplication by `f` stays invertible after shifting. -/
private lemma isIso_smul_shift {A : Type u} [CommRing A] (f : A)
    {X : DerivedCategory (ModuleCat.{v} A)} (hX : IsIso (f • 𝟙 X)) (n : ℤ) :
    IsIso (f • 𝟙 (X⟦n⟧)) := by
  have : f • 𝟙 (X⟦n⟧) = (f • 𝟙 X)⟦n⟧' := by
    rw [Functor.map_smul, CategoryTheory.Functor.map_id]
  rw [this]
  infer_instance

open CategoryTheory.Pretriangulated in
/-- In a distinguished triangle `X ⟶ X ⟶ Y ⟶ X⟦1⟧` whose first map is `1 - f · s` for an
endomorphism `s` commuting with it, `f` acts invertibly on `Y`. -/
private lemma isIso_smul_of_distTriang {A : Type u} [CommRing A] (f : A)
    {X Y : DerivedCategory (ModuleCat.{v} A)}
    (Dm : X ⟶ X) (g : X ⟶ Y) (h : Y ⟶ X⟦(1 : ℤ)⟧) (hT : Triangle.mk Dm g h ∈ distTriang _)
    (s : X ⟶ X) (hs : f • s = 𝟙 X - Dm) (hDs : Dm ≫ s = s ≫ Dm) : IsIso (f • 𝟙 Y) := by
  obtain ⟨σ, h₂, h₃⟩ := complete_distinguished_triangle_morphism _ _ hT hT s s hDs
  change Y ⟶ Y at σ
  change g ≫ σ = s ≫ g at h₂
  change h ≫ s⟦(1 : ℤ)⟧' = σ ≫ h at h₃
  have hDg : Dm ≫ g = 0 := comp_distTriang_mor_zero₁₂ _ hT
  have hhD : h ≫ Dm⟦(1 : ℤ)⟧' = 0 := comp_distTriang_mor_zero₃₁ _ hT
  let N : Y ⟶ Y := f • σ - 𝟙 Y
  have hgN : g ≫ N = 0 := by
    simp only [N, Preadditive.comp_sub, Linear.comp_smul, h₂, ← Linear.smul_comp, hs,
      Preadditive.sub_comp, hDg, Category.id_comp, Category.comp_id, sub_zero, sub_self]
  have hNh : N ≫ h = 0 := by
    have : (f • s)⟦(1 : ℤ)⟧' = 𝟙 _ - Dm⟦(1 : ℤ)⟧' := by
      rw [hs, Functor.map_sub, CategoryTheory.Functor.map_id]
    rw [Functor.map_smul] at this
    simp only [N, Preadditive.sub_comp, Linear.smul_comp, ← h₃, ← Linear.comp_smul, this,
      Preadditive.comp_sub, hhD, Category.id_comp, Category.comp_id, sub_zero, sub_self]
  have hNN : N ≫ N = 0 := by
    obtain ⟨a, ha⟩ := Triangle.yoneda_exact₃ _ hT N hgN
    change N = h ≫ a at ha
    rw [ha, ← Category.assoc, ← ha, hNh, zero_comp]
  have hfσ : f • σ = 𝟙 Y + N := by simp [N]
  clear_value N
  have key : f • (σ ≫ (𝟙 Y - N)) = 𝟙 Y := by
    rw [← Linear.smul_comp, hfσ, Preadditive.add_comp, Category.id_comp, Preadditive.comp_sub]
    simp only [Category.comp_id, hNN]
    abel
  refine ⟨σ ≫ (𝟙 Y - N), ?_, ?_⟩
  · rw [Linear.smul_comp, Category.id_comp, key]
  · rw [Linear.comp_smul, Category.comp_id, key]

section Fan
variable {A : Type u} [CommRing A]

/-- The projection `∏_ℕ H ⟶ H` onto the `n`-th factor. -/
private def seqπ (n : ℕ) (H : CochainComplex (ModuleCat.{v} A) ℤ) :
    seqComplexFunctor.obj H ⟶ H where
  f _ := ModuleCat.ofHom (LinearMap.proj n)
  comm' _ _ _ := rfl

private def seqShift (H : CochainComplex (ModuleCat.{v} A) ℤ) :
    seqComplexFunctor.obj H ⟶ seqComplexFunctor.obj H where
  f i := ModuleCat.ofHom (LinearMap.funLeft A (H.X i) Nat.succ)
  comm' _ _ _ := rfl

private lemma seqComplexEval_app (H : CochainComplex (ModuleCat.{v} A) ℤ) :
    seqComplexEval.app H = seqπ 0 H := by
  ext i x
  simp [seqComplexEval, seqπ, seqEval]
  rfl

private lemma seqComplexDifference_π (f : A) (H : CochainComplex (ModuleCat.{v} A) ℤ) (n : ℕ) :
    seqComplexDifference f H ≫ seqπ n H = seqπ n H - f • seqπ (n + 1) H := by
  ext i x
  simp [seqπ, seqDifference, seqComplexDifference]
  rfl

private lemma smul_seqShift (f : A) (H : CochainComplex (ModuleCat.{v} A) ℤ) :
    f • seqShift H = 𝟙 _ - seqComplexDifference f H := by
  ext i x
  funext n
  show f • x (n + 1) = x n - (x n - f • x (n + 1))
  abel

private lemma seqComplexDifference_seqShift (f : A) (H : CochainComplex (ModuleCat.{v} A) ℤ) :
    seqComplexDifference f H ≫ seqShift H = seqShift H ≫ seqComplexDifference f H := by
  ext i x
  rfl

private def isLimit_seqFan (H : CochainComplex (ModuleCat.{v} A) ℤ) :
    IsLimit (Fan.mk (seqComplexFunctor.obj H) fun n => seqπ n H) :=
  HomologicalComplex.isLimitOfEval _ _ fun i =>
    (isLimitMapConeFanMkEquiv _ _ _).symm (ModuleCat.productConeIsLimit fun _ : ℕ => H.X i)

local instance : HasExactLimitsOfShape (Discrete ℕ) (ModuleCat.{v} A) :=
  moduleCat_hasExactLimitsOfShape_discrete.{v} A ℕ

private def isLimit_Q_seqFan (H : CochainComplex (ModuleCat.{v} A) ℤ) :
    IsLimit (Fan.mk (DerivedCategory.Q.obj (seqComplexFunctor.obj H))
      fun n => DerivedCategory.Q.map (seqπ n H)) :=
  have : PreservesLimitsOfShape (Discrete ℕ) (DerivedCategory.Q (C := ModuleCat.{v} A)) :=
    Stacks.DerivedProducts.preservesLimitsOfShape_Q
  isLimitFanMkObjOfIsLimit DerivedCategory.Q _ _ (isLimit_seqFan H)

end Fan

section FanAlgebra
variable {A : Type u} [CommRing A] {D : Type*} [Category D] [Preadditive D] [Linear A D]
  {f : A} {E : D} {c : Fan fun _ : ℕ => E} (hc : IsLimit c) {Dm : c.pt ⟶ c.pt}
  (hDm : ∀ n, Dm ≫ c.proj n = c.proj n - f • c.proj (n + 1))
  {Z : D} (hZ : IsIso (f • 𝟙 Z))

omit [Linear A D] in
private lemma smul_inv_comp {Z Y : D} [Linear A D] (hZ : IsIso (f • 𝟙 Z)) (t : Z ⟶ Y) :
    f • (inv (f • 𝟙 Z) ≫ t) = t := by
  have h : (f • inv (f • 𝟙 Z)) = 𝟙 Z := by
    rw [← Category.id_comp (inv _), ← Linear.smul_comp, IsIso.hom_inv_id]
  rw [← Linear.smul_comp, h, Category.id_comp]

include hc hDm hZ

/-- Multiplication by `1 - f · shift` on a countable power is onto on morphisms from an object on
which `f` is invertible. -/
private lemma exists_comp_difference_eq (y : Z ⟶ c.pt) : ∃ x : Z ⟶ c.pt, x ≫ Dm = y := by
  let w := inv (f • 𝟙 Z)
  let xs : ℕ → (Z ⟶ E) := fun n => Nat.rec 0 (fun k xk => w ≫ (xk - y ≫ c.proj k)) n
  refine ⟨Fan.IsLimit.lift hc xs, Fan.IsLimit.hom_ext hc _ _ fun n => ?_⟩
  rw [Category.assoc, hDm, Preadditive.comp_sub, Linear.comp_smul, Fan.IsLimit.fac,
    Fan.IsLimit.fac]
  show xs n - f • (w ≫ (xs n - y ≫ c.proj n)) = _
  rw [smul_inv_comp hZ]
  abel

private lemma eq_zero_of_comp_difference (x : Z ⟶ c.pt) (hx : x ≫ Dm = 0)
    (h0 : x ≫ c.proj 0 = 0) : x = 0 := by
  have key : ∀ n, x ≫ c.proj n = 0 := by
    intro n
    induction n with
    | zero => exact h0
    | succ n ih =>
      have h := congrArg (· ≫ c.proj n) hx
      simp only [Category.assoc, hDm, Preadditive.comp_sub, Linear.comp_smul, ih, zero_comp,
        zero_sub, neg_eq_zero] at h
      rw [← smul_inv_comp hZ (x ≫ c.proj (n + 1)), ← Linear.comp_smul, h, comp_zero]
  exact Fan.IsLimit.hom_ext hc _ _ fun n => by rw [key, zero_comp]

private lemma exists_comp_difference_eq_zero (t : Z ⟶ E) :
    ∃ x : Z ⟶ c.pt, x ≫ Dm = 0 ∧ x ≫ c.proj 0 = t := by
  let w : End Z := .of (inv (f • 𝟙 Z))
  refine ⟨Fan.IsLimit.lift hc fun n => (w ^ n).asHom ≫ t,
    Fan.IsLimit.hom_ext hc _ _ fun n => ?_, by simp [Fan.IsLimit.fac]⟩
  rw [Category.assoc, hDm, Preadditive.comp_sub, Linear.comp_smul, Fan.IsLimit.fac,
    Fan.IsLimit.fac, zero_comp, pow_succ', End.mul_asHom, Category.assoc, ← Linear.comp_smul]
  rw [smul_inv_comp hZ]
  exact sub_self _

end FanAlgebra

section TriangleAlgebra

open CategoryTheory.Pretriangulated
variable {A : Type u} [CommRing A]

/-- In a distinguished triangle `X ⟶ X ⟶ X₃ ⟶ X⟦1⟧` whose first map is `1 - f · shift` on a
countable power `X` of `E`, morphisms from an `f`-invertible `Z` to `X₃` correspond to morphisms
`Z ⟶ E⟦1⟧`. -/
private lemma bijective_comp_mor₃_proj {f : A} {E : DerivedCategory (ModuleCat.{v} A)}
    {c : Fan fun _ : ℕ => E} (hc : IsLimit c) {Dm : c.pt ⟶ c.pt}
    (hDm : ∀ n, Dm ≫ c.proj n = c.proj n - f • c.proj (n + 1))
    {X₃ : DerivedCategory (ModuleCat.{v} A)} (g : c.pt ⟶ X₃) (h : X₃ ⟶ c.pt⟦(1 : ℤ)⟧)
    (hT : Triangle.mk Dm g h ∈ distTriang _)
    {Z : DerivedCategory (ModuleCat.{v} A)} (hZ : IsIso (f • 𝟙 Z)) :
    Function.Bijective fun k : Z ⟶ X₃ => k ≫ h ≫ (c.proj 0)⟦(1 : ℤ)⟧' := by
  let adj := (shiftEquiv' (DerivedCategory (ModuleCat.{v} A)) (-1 : ℤ) 1 (by omega)).toAdjunction
  have hZ' : IsIso (f • 𝟙 (Z⟦(-1 : ℤ)⟧)) := isIso_smul_shift f hZ _
  have hnat : ∀ {Y Y' : DerivedCategory (ModuleCat.{v} A)}
      (a : (shiftEquiv' (DerivedCategory (ModuleCat.{v} A)) (-1 : ℤ) 1 (by omega)).functor.obj Z
        ⟶ Y) (b : Y ⟶ Y'),
      adj.homEquiv Z Y' (a ≫ b) = adj.homEquiv Z Y a ≫ b⟦(1 : ℤ)⟧' := fun a b =>
    adj.homEquiv_naturality_right a b
  have h0 : ∀ Y, adj.homEquiv Z Y 0 = 0 := fun Y => by
    rw [Adjunction.homEquiv_apply, Functor.map_zero, comp_zero]
  have hzero : ∀ y : Z ⟶ c.pt⟦(1 : ℤ)⟧, y ≫ Dm⟦(1 : ℤ)⟧' = 0 →
      y ≫ (c.proj 0)⟦(1 : ℤ)⟧' = 0 → y = 0 := by
    intro y h₁ h₀
    obtain ⟨y', rfl⟩ := (adj.homEquiv Z _).surjective y
    have e₁ : y' ≫ Dm = 0 :=
      (adj.homEquiv Z _).injective ((hnat _ _).trans (h₁.trans (h0 _).symm))
    have e₀ : y' ≫ c.proj 0 = 0 :=
      (adj.homEquiv Z _).injective ((hnat _ _).trans (h₀.trans (h0 _).symm))
    rw [eq_zero_of_comp_difference hc hDm hZ' y' e₁ e₀]
    exact h0 _
  constructor
  · intro k₁ k₂ hk₁₂
    rw [← sub_eq_zero]
    have hk : (k₁ - k₂) ≫ h ≫ (c.proj 0)⟦(1 : ℤ)⟧' = 0 := by
      simpa [Preadditive.sub_comp, sub_eq_zero] using hk₁₂
    generalize k₁ - k₂ = k at hk ⊢
    have hk' : k ≫ h = 0 := hzero _ (by
      rw [Category.assoc]; exact (comp_distTriang_mor_zero₃₁ _ hT).symm ▸ comp_zero)
      (by simpa using hk)
    obtain ⟨x, hx⟩ := Triangle.coyoneda_exact₃ _ hT k hk'
    obtain ⟨x', rfl⟩ := exists_comp_difference_eq hc hDm hZ x
    rw [hx]
    show (x' ≫ Dm) ≫ g = 0
    rw [Category.assoc, show Dm ≫ g = 0 from comp_distTriang_mor_zero₁₂ _ hT, comp_zero]
  · intro t
    obtain ⟨t', rfl⟩ := (adj.homEquiv Z _).surjective t
    obtain ⟨x', hx₁, hx₀⟩ := exists_comp_difference_eq_zero hc hDm hZ' t'
    obtain ⟨k, hk⟩ := Triangle.coyoneda_exact₁ _ hT (adj.homEquiv Z _ x') (by
      show _ ≫ Dm⟦(1 : ℤ)⟧' = 0
      exact (hnat _ _).symm.trans ((congrArg _ hx₁).trans (h0 _)))
    refine ⟨k, ?_⟩
    show k ≫ h ≫ _ = _
    rw [← Category.assoc]
    exact (congrArg (· ≫ (c.proj 0)⟦(1 : ℤ)⟧') hk.symm).trans
      ((hnat _ _).symm.trans (congrArg _ hx₀))

end TriangleAlgebra

section Orthogonality

open CategoryTheory.Pretriangulated

variable {A : Type u} [CommRing A]

/-- Bijectivity of postcomposition is transported along shifts. -/
private lemma bijective_comp_shift {Z X Y : DerivedCategory (ModuleCat.{v} A)} (n : ℤ)
    (u : X ⟶ Y) (h : Function.Bijective fun k : Z⟦-n⟧ ⟶ X => k ≫ u) :
    Function.Bijective fun k : Z ⟶ X⟦n⟧ => k ≫ u⟦n⟧' := by
  let adj := (shiftEquiv' (DerivedCategory (ModuleCat.{v} A)) (-n) n (by omega)).toAdjunction
  have e : (fun k : Z ⟶ X⟦n⟧ => k ≫ u⟦n⟧') =
      adj.homEquiv Z Y ∘ (fun k : Z⟦-n⟧ ⟶ X => k ≫ u) ∘ (adj.homEquiv Z X).symm := by
    funext k
    show _ = adj.homEquiv Z Y ((adj.homEquiv Z X).symm k ≫ u)
    rw [adj.homEquiv_naturality_right]
    erw [Equiv.apply_symm_apply]
    rfl
  rw [e]
  exact (adj.homEquiv Z Y).bijective.comp (h.comp (adj.homEquiv Z X).symm.bijective)

/-- `E` receives no nonzero morphism from an object on which `f` acts invertibly. -/
private def IsSmulOrthogonal (f : A) (E : DerivedCategory (ModuleCat.{v} A)) : Prop :=
  ∀ ⦃Z : DerivedCategory (ModuleCat.{v} A)⦄, IsIso (f • 𝟙 Z) → ∀ k : Z ⟶ E, k = 0

private lemma IsSmulOrthogonal.of_iso {f : A} {E E' : DerivedCategory (ModuleCat.{v} A)}
    (h : IsSmulOrthogonal f E) (e : E ≅ E') : IsSmulOrthogonal f E' := fun Z hZ k => by
  rw [← Category.comp_id k, ← e.inv_hom_id, ← Category.assoc, h hZ (k ≫ e.inv), zero_comp]

private lemma IsSmulOrthogonal.shift {f : A} {E : DerivedCategory (ModuleCat.{v} A)}
    (h : IsSmulOrthogonal f E) (n : ℤ) : IsSmulOrthogonal f (E⟦n⟧) := fun Z hZ k => by
  let adj := (shiftEquiv' (DerivedCategory (ModuleCat.{v} A)) (-n) n (by omega)).toAdjunction
  have h0 : adj.homEquiv Z E 0 = 0 := by
    rw [Adjunction.homEquiv_apply, Functor.map_zero, comp_zero]
  obtain ⟨k', rfl⟩ := (adj.homEquiv Z E).surjective k
  obtain rfl : k' = 0 := h (isIso_smul_shift f hZ (-n)) k'
  exact h0

private lemma IsSmulOrthogonal.of_isLimit {f : A} {E : DerivedCategory (ModuleCat.{v} A)}
    {c : Fan fun _ : ℕ => E} (hc : IsLimit c) (h : IsSmulOrthogonal f E) :
    IsSmulOrthogonal f c.pt := fun Z hZ k =>
  Fan.IsLimit.hom_ext hc _ _ fun n => by rw [h hZ (k ≫ c.proj n), zero_comp]

private lemma IsSmulOrthogonal.mor₂ {f : A} (T : Triangle (DerivedCategory (ModuleCat.{v} A)))
    (hT : T ∈ distTriang _) (h₁ : IsSmulOrthogonal f T.obj₁) (h₃ : IsSmulOrthogonal f T.obj₃) :
    IsSmulOrthogonal f T.obj₂ := fun Z hZ k => by
  obtain ⟨x, hx⟩ := Triangle.coyoneda_exact₂ T hT k (h₃ hZ _)
  rw [hx, h₁ hZ x, zero_comp]

private lemma IsSmulOrthogonal.obj₃ {f : A} (T : Triangle (DerivedCategory (ModuleCat.{v} A)))
    (hT : T ∈ distTriang _) (h₂ : IsSmulOrthogonal f T.obj₂)
    (h₁ : IsSmulOrthogonal f (T.obj₁⟦(1 : ℤ)⟧)) : IsSmulOrthogonal f T.obj₃ :=
  IsSmulOrthogonal.mor₂ _ (rot_of_distTriang _ hT) h₂ h₁

/-- The third vertex of a distinguished triangle whose first map induces bijections on morphisms
from `f`-invertible objects is `f`-orthogonal. -/
private lemma IsSmulOrthogonal.obj₃_of_bijective {f : A}
    (T : Triangle (DerivedCategory (ModuleCat.{v} A))) (hT : T ∈ distTriang _)
    (h : ∀ ⦃Z : DerivedCategory (ModuleCat.{v} A)⦄, IsIso (f • 𝟙 Z) →
      Function.Bijective fun k : Z ⟶ T.obj₁ => k ≫ T.mor₁) :
    IsSmulOrthogonal f T.obj₃ := fun Z hZ k => by
  have hm : k ≫ T.mor₃ = 0 := by
    apply (bijective_comp_shift 1 T.mor₁ (h (isIso_smul_shift f hZ _))).1
    simp only [Category.assoc, comp_distTriang_mor_zero₃₁ _ hT, comp_zero, zero_comp]
  obtain ⟨y, rfl⟩ := Triangle.coyoneda_exact₃ T hT k hm
  obtain ⟨k', rfl⟩ := (h hZ).2 y
  simp only [Category.assoc, comp_distTriang_mor_zero₁₂ _ hT, comp_zero]

variable [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{v} A))]

/-- Multiplication by `f` is invertible on every derived limit `T(E, f)` of the tower
`⋯ → E → E` with transition maps multiplication by `f`. -/
private lemma isIso_smul_of_isDerivedLimit (f : A) {E T : DerivedCategory (ModuleCat.{v} A)}
    (hT : Pretriangulated.IsDerivedLimit
      (Functor.ofOpSequence (X := fun _ : ℕ => E) (fun _ => f • 𝟙 E)) T) :
    IsIso (f • 𝟙 T) := by
  obtain ⟨p, δ, hTr⟩ := hT
  let P := ∏ᶜ fun _ : ℕ => E
  let D : P ⟶ P := Pi.lift (fun n : ℕ => Pi.π (fun _ : ℕ => E) n -
      Pi.π (fun _ : ℕ => E) (n + 1) ≫ (f • 𝟙 E))
  have hTr' : Triangle.mk (p : T ⟶ P) D δ ∈ distTriang _ := by
    simp only [Functor.ofOpSequence_map_homOfLE_succ] at hTr
    exact hTr
  clear hTr
  change T ⟶ P at p
  change P ⟶ T⟦(1 : ℤ)⟧ at δ
  let sh : P ⟶ P := Pi.lift fun n : ℕ => Pi.π (fun _ : ℕ => E) (n + 1)
  have hfs : f • sh = 𝟙 P - D := by
    apply Pi.hom_ext
    intro n
    simp [sh, D, P]
  have hDs : D ≫ sh = sh ≫ D := by
    apply Pi.hom_ext
    intro n
    simp [sh, D, P, Preadditive.comp_sub]
  have h := isIso_smul_of_distTriang f D δ _ (rot_of_distTriang _ hTr') sh hfs hDs
  have : IsIso ((shiftFunctor (DerivedCategory (ModuleCat.{v} A)) (1 : ℤ)).map (f • 𝟙 T)) := by
    rwa [Functor.map_smul, CategoryTheory.Functor.map_id]
  exact isIso_of_reflects_iso (f • 𝟙 T) (shiftFunctor (DerivedCategory (ModuleCat.{v} A)) (1 : ℤ))

/-- An `f`-orthogonal object has vanishing derived limit `T(E, f)`. -/
private lemma IsSmulOrthogonal.exists_derivedLimit_isZero {f : A}
    {E : DerivedCategory (ModuleCat.{v} A)} (h : IsSmulOrthogonal f E) :
    ∃ L, Pretriangulated.IsDerivedLimit
      (Functor.ofOpSequence (X := fun _ : ℕ => E) (fun _ => f • 𝟙 E)) L ∧ IsZero L := by
  obtain ⟨L, hL⟩ := Pretriangulated.exists_isDerivedLimit
    (Functor.ofOpSequence (X := fun _ : ℕ => E) (fun _ => f • 𝟙 E))
  refine ⟨L, hL, ?_⟩
  have hf := isIso_smul_of_isDerivedLimit f hL
  obtain ⟨p, δ, hT⟩ := hL
  have hP : IsSmulOrthogonal f (∏ᶜ fun n : ℕ =>
      (Functor.ofOpSequence (X := fun _ : ℕ => E) (fun _ => f • 𝟙 E)).obj ⟨n⟩) :=
    h.of_isLimit (productIsProduct fun _ : ℕ => E)
  have hp : p = 0 := hP hf p
  have hT' := inv_rot_of_distTriang _ hT
  obtain ⟨x, hx⟩ := Triangle.coyoneda_exact₂ _ hT' (𝟙 L) (by
    show 𝟙 L ≫ p = 0
    rw [hp, comp_zero])
  have hx0 : x = 0 := (hP.shift (-1)) hf x
  rw [IsZero.iff_id_eq_zero, hx, hx0]
  exact zero_comp

end Orthogonality

section HomStepCompletion

open CategoryTheory.Pretriangulated

variable {A : Type u} [CommRing A]

private lemma Q_seqComplexDifference_π (f : A) (H : CochainComplex (ModuleCat.{v} A) ℤ)
    (n : ℕ) :
    DerivedCategory.Q.map (seqComplexDifference f H) ≫ DerivedCategory.Q.map (seqπ n H) =
      DerivedCategory.Q.map (seqπ n H) - f • DerivedCategory.Q.map (seqπ (n + 1) H) := by
  rw [← Functor.map_comp, seqComplexDifference_π, Functor.map_sub, Functor.map_smul]

/-- `f` acts invertibly on `cone(1 - f · shift)`, a model of `T(H, f)[1]`. -/
private lemma isIso_smul_Q_mappingCone (f : A) (H : CochainComplex (ModuleCat.{v} A) ℤ) :
    IsIso (f • 𝟙 (DerivedCategory.Q.obj
      (CochainComplex.mappingCone (seqComplexDifference f H)))) := by
  have hT := DerivedCategory.mappingCone_triangle_distinguished (seqComplexDifference f H)
  refine isIso_smul_of_distTriang f _ _ _ hT (DerivedCategory.Q.map (seqShift H)) ?_ ?_
  · have : f • DerivedCategory.Q.map (seqShift H) =
        𝟙 _ - DerivedCategory.Q.map (seqComplexDifference f H) := by
      rw [← Functor.map_smul, smul_seqShift, Functor.map_sub, CategoryTheory.Functor.map_id]
    exact this
  · show DerivedCategory.Q.map (seqComplexDifference f H) ≫ DerivedCategory.Q.map (seqShift H) =
      DerivedCategory.Q.map (seqShift H) ≫ DerivedCategory.Q.map (seqComplexDifference f H)
    rw [← Functor.map_comp, ← Functor.map_comp, seqComplexDifference_seqShift]

/-- Postcomposition with `Q (homStepMap f H)` is bijective on morphisms from `f`-invertible
objects. -/
private lemma bijective_comp_Q_homStepMap (f : A) (H : CochainComplex (ModuleCat.{v} A) ℤ)
    {Z : DerivedCategory (ModuleCat.{v} A)} (hZ : IsIso (f • 𝟙 Z)) :
    Function.Bijective fun k : Z ⟶ DerivedCategory.Q.obj
        (CochainComplex.mappingCone (seqComplexDifference f H)) =>
      k ≫ DerivedCategory.Q.map (homStepMap f H) := by
  have hT := DerivedCategory.mappingCone_triangle_distinguished (seqComplexDifference f H)
  have hC := bijective_comp_mor₃_proj (isLimit_Q_seqFan H)
    (Dm := DerivedCategory.Q.map (seqComplexDifference f H))
    (fun n => Q_seqComplexDifference_π f H n) _ _ hT hZ
  let e := (DerivedCategory.Q.commShiftIso (1 : ℤ)).app H
  have heq : (fun k : Z ⟶ DerivedCategory.Q.obj
      (CochainComplex.mappingCone (seqComplexDifference f H)) =>
      (k ≫ DerivedCategory.Q.map (homStepMap f H)) ≫ e.hom) =
      fun k => k ≫ (DerivedCategory.Q.map (CochainComplex.mappingCone.triangle
          (seqComplexDifference f H)).mor₃ ≫
          (DerivedCategory.Q.commShiftIso (1 : ℤ)).hom.app _) ≫
          (DerivedCategory.Q.map (seqπ 0 H))⟦(1 : ℤ)⟧' := by
    funext k
    have hm : DerivedCategory.Q.map (homStepMap f H) =
        DerivedCategory.Q.map (CochainComplex.mappingCone.triangle
          (seqComplexDifference f H)).mor₃ ≫ DerivedCategory.Q.map ((seqπ 0 H)⟦(1 : ℤ)⟧') := by
      rw [← seqComplexEval_app]
      exact DerivedCategory.Q.map_comp _ _
    rw [hm]
    dsimp only [e, CochainComplex.mappingCone.triangle, Triangle.mk]
    simp only [Iso.app_hom, Category.assoc]
    rw [Functor.commShiftIso_hom_naturality DerivedCategory.Q (seqπ 0 H) (1 : ℤ)]
  have hC' : Function.Bijective fun k : Z ⟶ DerivedCategory.Q.obj
      (CochainComplex.mappingCone (seqComplexDifference f H)) =>
      (k ≫ DerivedCategory.Q.map (homStepMap f H)) ≫ e.hom := by
    rw [heq]
    exact hC
  refine ⟨fun a b hab => hC'.1 (by simp only at hab ⊢; rw [hab]), fun t => ?_⟩
  obtain ⟨k, hk⟩ := hC'.2 (t ≫ e.hom)
  exact ⟨k, (cancel_mono e.hom).1 hk⟩

private noncomputable def Q_homStep_iso (f : A) (H : CochainComplex (ModuleCat.{v} A) ℤ) :
    DerivedCategory.Q.obj ((homStep f).obj H) ≅
      (DerivedCategory.Q.obj (CochainComplex.mappingCone (homStepMap f H)))⟦(-1 : ℤ)⟧ :=
  (DerivedCategory.Q.commShiftIso (-1 : ℤ)).app _

private lemma isSmulOrthogonal_Q_homStep_self (f : A) (H : CochainComplex (ModuleCat.{v} A) ℤ) :
    IsSmulOrthogonal f (DerivedCategory.Q.obj ((homStep f).obj H)) := by
  have hT := DerivedCategory.mappingCone_triangle_distinguished (homStepMap f H)
  have h := IsSmulOrthogonal.obj₃_of_bijective _ hT fun Z hZ => bijective_comp_Q_homStepMap f H hZ
  exact (h.shift (-1)).of_iso (Q_homStep_iso f H).symm

private lemma isSmulOrthogonal_Q_homStep (f f' : A) (H : CochainComplex (ModuleCat.{v} A) ℤ)
    (h : IsSmulOrthogonal f' (DerivedCategory.Q.obj H)) :
    IsSmulOrthogonal f' (DerivedCategory.Q.obj ((homStep f).obj H)) := by
  have hP := h.of_isLimit (isLimit_Q_seqFan H)
  have hD := IsSmulOrthogonal.obj₃ _
    (DerivedCategory.mappingCone_triangle_distinguished (seqComplexDifference f H)) hP
    (hP.shift 1)
  have hH : IsSmulOrthogonal f' (DerivedCategory.Q.obj (H⟦(1 : ℤ)⟧)) :=
    (h.shift 1).of_iso ((DerivedCategory.Q.commShiftIso (1 : ℤ)).app H).symm
  have hC := IsSmulOrthogonal.obj₃ _
    (DerivedCategory.mappingCone_triangle_distinguished (homStepMap f H)) hH (hD.shift 1)
  exact (hC.shift (-1)).of_iso (Q_homStep_iso f H).symm

private lemma isSmulOrthogonal_Q_homModel : ∀ {r : ℕ} (g : Fin r → A)
    (H : CochainComplex (ModuleCat.{v} A) ℤ) (i : Fin r),
    IsSmulOrthogonal (g i) (DerivedCategory.Q.obj ((homModel g).obj H))
  | 0, _, _, i => i.elim0
  | r + 1, g, H, i => by
    refine Fin.cases ?_ (fun j => ?_) i
    · exact isSmulOrthogonal_Q_homStep_self (g 0) ((homModel (Fin.tail g)).obj H)
    · exact isSmulOrthogonal_Q_homStep (g 0) _ _ (isSmulOrthogonal_Q_homModel (Fin.tail g) H j)

variable [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{v} A))]

/-- The explicit model of `Hom(P, H)` is derived complete for the ideal generated by the
generators. -/
private lemma isDerivedComplete_Q_homModel {r : ℕ} (g : Fin r → A)
    (H : CochainComplex (ModuleCat.{v} A) ℤ) :
    IsDerivedComplete (Ideal.span (Set.range g))
      (DerivedCategory.Q.obj ((homModel g).obj H)) := by
  obtain ⟨J, -, hJ⟩ := exists_isRadical_ideal_isDerivedCompleteAt A
    (DerivedCategory.Q.obj ((homModel g).obj H))
  have hle : Ideal.span (Set.range g) ≤ J := Ideal.span_le.2 (by
    rintro _ ⟨i, rfl⟩
    exact (hJ _).2 ((isDerivedCompleteAt_iff_exists_isDerivedLimit_isZero _ _).2
      (isSmulOrthogonal_Q_homModel g H i).exists_derivedLimit_isZero))
  intro f hf
  exact (hJ f).1 (hle hf)

omit [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{v} A))] in
private lemma bijective_precomp_iso {X X' Y Y' E : DerivedCategory (ModuleCat.{v} A)}
    (a : X' ≅ X) (u : X ⟶ Y) (b : Y ≅ Y')
    (h : Function.Bijective fun k : Y ⟶ E => u ≫ k) :
    Function.Bijective fun k : Y' ⟶ E => (a.hom ≫ u ≫ b.hom) ≫ k := by
  have hiso : ∀ {S T : DerivedCategory (ModuleCat.{v} A)} (i : S ≅ T),
      Function.Bijective fun k : T ⟶ E => i.hom ≫ k := fun i =>
    ⟨fun x y hxy => by simpa using congrArg (i.inv ≫ ·) hxy, fun k => ⟨i.inv ≫ k, by simp⟩⟩
  have e : (fun k : Y' ⟶ E => (a.hom ≫ u ≫ b.hom) ≫ k) =
      (fun k => a.hom ≫ k) ∘ (fun k => u ≫ k) ∘ (fun k => b.hom ≫ k) := by
    funext k; simp
  rw [e]
  exact (hiso a).comp (h.comp (hiso b))

/-- A unit `Q H ⟶ Q (homStep f H)` which is initial among morphisms to objects with vanishing
`T(-, f)`. -/
private lemma exists_unit_homStep (f : A) (H : CochainComplex (ModuleCat.{v} A) ℤ)
    (P : DerivedCategory (ModuleCat.{v} A) → Prop)
    (hP : ∀ E, P E → ∃ L, Pretriangulated.IsDerivedLimit
      (Functor.ofOpSequence (X := fun _ : ℕ => E) (fun _ => f • 𝟙 E)) L ∧ IsZero L) :
    ∃ η : DerivedCategory.Q.obj H ⟶ DerivedCategory.Q.obj ((homStep f).obj H),
      ∀ E, P E → Function.Bijective fun k : _ ⟶ E => η ≫ k := by
  let T := DerivedCategory.Q.mapTriangle.obj
    (CochainComplex.mappingCone.triangle (homStepMap f H))
  have hT : T ∈ distTriang _ := DerivedCategory.mappingCone_triangle_distinguished _
  have hT' := inv_rot_of_distTriang _ (inv_rot_of_distTriang _ hT)
  have hX := isIso_smul_Q_mappingCone f H
  let a : DerivedCategory.Q.obj H ≅ (DerivedCategory.Q.obj (H⟦(1 : ℤ)⟧))⟦(-1 : ℤ)⟧ :=
    DerivedCategory.Q.mapIso ((shiftFunctorCompIsoId _ (1 : ℤ) (-1) (by omega)).symm.app H) ≪≫
      (DerivedCategory.Q.commShiftIso (-1 : ℤ)).app _
  refine ⟨a.hom ≫ (T.invRotate.invRotate).mor₁ ≫ (Q_homStep_iso f H).inv, fun E hE => ?_⟩
  refine bijective_precomp_iso a _ (Q_homStep_iso f H).symm ?_
  refine bijective_precomp_of_orthogonal _ hT' E (fun k => ?_) (fun k => ?_)
  · exact hom_eq_zero_of_isIso_smul_of_derivedLimit_isZero f hX (hP E hE) k
  · exact hom_eq_zero_of_isIso_smul_of_derivedLimit_isZero f (isIso_smul_shift f hX _)
      (hP E hE) k

private lemma exists_unit_homModel (P : DerivedCategory (ModuleCat.{v} A) → Prop) :
    ∀ {r : ℕ} (g : Fin r → A)
    (_ : ∀ i E, P E → ∃ L, Pretriangulated.IsDerivedLimit
      (Functor.ofOpSequence (X := fun _ : ℕ => E) (fun _ => g i • 𝟙 E)) L ∧ IsZero L)
    (H : CochainComplex (ModuleCat.{v} A) ℤ),
    ∃ η : DerivedCategory.Q.obj H ⟶ DerivedCategory.Q.obj ((homModel g).obj H),
      ∀ E, P E → Function.Bijective fun k : _ ⟶ E => η ≫ k
  | 0, _, _, H => by
    refine ⟨𝟙 _, fun E _ => ?_⟩
    show Function.Bijective (fun k : DerivedCategory.Q.obj H ⟶ E => 𝟙 _ ≫ k)
    exact ⟨fun a b h => (Category.id_comp a).symm.trans (h.trans (Category.id_comp b)),
      fun k => ⟨k, Category.id_comp k⟩⟩
  | r + 1, g, hP, H => by
    obtain ⟨η₁, h₁⟩ := exists_unit_homModel P (Fin.tail g) (fun i => hP i.succ) H
    obtain ⟨η₂, h₂⟩ := exists_unit_homStep (g 0) ((homModel (Fin.tail g)).obj H) P (hP 0)
    refine ⟨η₁ ≫ η₂, fun E hE => ?_⟩
    show Function.Bijective (fun k : DerivedCategory.Q.obj
      ((homStep (g 0)).obj ((homModel (Fin.tail g)).obj H)) ⟶ E => (η₁ ≫ η₂) ≫ k)
    simpa only [Function.comp_def, Category.assoc] using (h₁ E hE).comp (h₂ E hE)

/-- The explicit model of `Hom(P, H)` represents the derived completion of `H`. -/
lemma nonempty_iso_completion_homModel {r : ℕ} (g : Fin r → A)
    (H : CochainComplex (ModuleCat.{v} A) ℤ)
    (completion : DerivedCategory (ModuleCat.{v} A) ⥤
      ObjectProperty.FullSubcategory (fun L ↦ IsDerivedComplete
        (Ideal.span (Set.range g)) L))
    (adj : completion ⊣ ObjectProperty.ι _) :
    Nonempty (DerivedCategory.Q.obj ((homModel g).obj H) ≅
      (completion ⋙ ObjectProperty.ι _).obj (DerivedCategory.Q.obj H)) := by
  obtain ⟨η, hη⟩ := exists_unit_homModel
    (fun L ↦ IsDerivedComplete (Ideal.span (Set.range g)) L) g
    (fun i E hE => (isDerivedCompleteAt_iff_exists_isDerivedLimit_isZero _ _).1
      (hE (g i) (Ideal.subset_span ⟨i, rfl⟩))) H
  exact nonempty_iso_reflection_of_bijective adj η (isDerivedComplete_Q_homModel g H) hη

end HomStepCompletion

section HomModelExactness

open CochainComplex

section ConeExactness

variable {A : Type u} [Ring A]
variable {K₁ L₁ K₂ L₂ K₃ L₃ : CochainComplex (ModuleCat.{v} A) ℤ}

private lemma proof_coneMap_fst (φ₁ : K₁ ⟶ L₁) (φ₂ : K₂ ⟶ L₂)
    (a : K₁ ⟶ K₂) (b : L₁ ⟶ L₂) (w : φ₁ ≫ b = a ≫ φ₂) (n : ℤ) :
    (mappingCone.map φ₁ φ₂ a b w).f n ≫ (mappingCone.fst φ₂).1.v n (n + 1) rfl =
      (mappingCone.fst φ₁).1.v n (n + 1) rfl ≫ a.f (n + 1) := by
  simp [mappingCone.map, mappingCone.desc_f _ _ _ _ n (n + 1) rfl]

private lemma proof_coneMap_snd (φ₁ : K₁ ⟶ L₁) (φ₂ : K₂ ⟶ L₂)
    (a : K₁ ⟶ K₂) (b : L₁ ⟶ L₂) (w : φ₁ ≫ b = a ≫ φ₂) (n : ℤ) :
    (mappingCone.map φ₁ φ₂ a b w).f n ≫ (mappingCone.snd φ₂).v n n (add_zero n) =
      (mappingCone.snd φ₁).v n n (add_zero n) ≫ b.f n := by
  simp [mappingCone.map, mappingCone.desc_f _ _ _ _ n (n + 1) rfl]

private lemma coneMap_fst_apply (φ₁ : K₁ ⟶ L₁) (φ₂ : K₂ ⟶ L₂)
    (a : K₁ ⟶ K₂) (b : L₁ ⟶ L₂) (w : φ₁ ≫ b = a ≫ φ₂) (n : ℤ)
    (x : (mappingCone φ₁).X n) :
    (mappingCone.fst φ₂).1.v n (n + 1) rfl ((mappingCone.map φ₁ φ₂ a b w).f n x) =
      a.f (n + 1) ((mappingCone.fst φ₁).1.v n (n + 1) rfl x) :=
  ConcreteCategory.congr_hom (proof_coneMap_fst φ₁ φ₂ a b w n) x

private lemma coneMap_snd_apply (φ₁ : K₁ ⟶ L₁) (φ₂ : K₂ ⟶ L₂)
    (a : K₁ ⟶ K₂) (b : L₁ ⟶ L₂) (w : φ₁ ≫ b = a ≫ φ₂) (n : ℤ)
    (x : (mappingCone φ₁).X n) :
    (mappingCone.snd φ₂).v n n (add_zero n) ((mappingCone.map φ₁ φ₂ a b w).f n x) =
      b.f n ((mappingCone.snd φ₁).v n n (add_zero n) x) :=
  ConcreteCategory.congr_hom (proof_coneMap_snd φ₁ φ₂ a b w n) x

private lemma cone_ext_element (φ : K₁ ⟶ L₁) (n : ℤ)
    {x y : (mappingCone φ).X n}
    (h₁ : (mappingCone.fst φ).1.v n (n + 1) rfl x =
      (mappingCone.fst φ).1.v n (n + 1) rfl y)
    (h₂ : (mappingCone.snd φ).v n n (add_zero n) x =
      (mappingCone.snd φ).v n n (add_zero n) y) : x = y := by
  have hx := ConcreteCategory.congr_hom (mappingCone.id_X φ n (n + 1) rfl) x
  have hy := ConcreteCategory.congr_hom (mappingCone.id_X φ n (n + 1) rfl) y
  change (mappingCone.inl φ).v (n + 1) n (by omega)
      ((mappingCone.fst φ).1.v n (n + 1) rfl x) +
      (mappingCone.inr φ).f n ((mappingCone.snd φ).v n n (add_zero n) x) = x at hx
  change (mappingCone.inl φ).v (n + 1) n (by omega)
      ((mappingCone.fst φ).1.v n (n + 1) rfl y) +
      (mappingCone.inr φ).f n ((mappingCone.snd φ).v n n (add_zero n) y) = y at hy
  rw [← hx, ← hy, h₁, h₂]

private lemma coneMap_f_surjective (φ₁ : K₁ ⟶ L₁) (φ₂ : K₂ ⟶ L₂)
    (a : K₁ ⟶ K₂) (b : L₁ ⟶ L₂) (w : φ₁ ≫ b = a ≫ φ₂) (n : ℤ)
    (ha : Function.Surjective (a.f (n + 1))) (hb : Function.Surjective (b.f n)) :
    Function.Surjective ((mappingCone.map φ₁ φ₂ a b w).f n) := by
  intro y
  obtain ⟨x, hx⟩ := ha ((mappingCone.fst φ₂).1.v n (n + 1) rfl y)
  obtain ⟨z, hz⟩ := hb ((mappingCone.snd φ₂).v n n (add_zero n) y)
  refine ⟨(mappingCone.inl φ₁).v (n + 1) n (by omega) x + (mappingCone.inr φ₁).f n z,
    cone_ext_element φ₂ n ?_ ?_⟩
  · rw [← ModuleCat.comp_apply, proof_coneMap_fst]
    simpa [← ModuleCat.comp_apply] using hx
  · rw [← ModuleCat.comp_apply, proof_coneMap_snd]
    simpa [← ModuleCat.comp_apply] using hz

private lemma coneMap_f_exact (φ₁ : K₁ ⟶ L₁) (φ₂ : K₂ ⟶ L₂) (φ₃ : K₃ ⟶ L₃)
    (a₁ : K₁ ⟶ K₂) (b₁ : L₁ ⟶ L₂) (w₁ : φ₁ ≫ b₁ = a₁ ≫ φ₂)
    (a₂ : K₂ ⟶ K₃) (b₂ : L₂ ⟶ L₃) (w₂ : φ₂ ≫ b₂ = a₂ ≫ φ₃) (n : ℤ)
    (ha : Function.Exact (a₁.f (n + 1)) (a₂.f (n + 1)))
    (hb : Function.Exact (b₁.f n) (b₂.f n)) :
    Function.Exact ((mappingCone.map φ₁ φ₂ a₁ b₁ w₁).f n)
      ((mappingCone.map φ₂ φ₃ a₂ b₂ w₂).f n) := by
  intro y
  constructor
  · intro hy
    have hfst : a₂.f (n + 1) ((mappingCone.fst φ₂).1.v n (n + 1) rfl y) = 0 := by
      rw [← ModuleCat.comp_apply, ← proof_coneMap_fst _ _ _ _ w₂, ModuleCat.comp_apply, hy,
        map_zero]
    have hsnd : b₂.f n ((mappingCone.snd φ₂).v n n (add_zero n) y) = 0 := by
      rw [← ModuleCat.comp_apply, ← proof_coneMap_snd _ _ _ _ w₂, ModuleCat.comp_apply, hy,
        map_zero]
    obtain ⟨x, hx⟩ := (ha _).1 hfst
    obtain ⟨z, hz⟩ := (hb _).1 hsnd
    refine ⟨(mappingCone.inl φ₁).v (n + 1) n (by omega) x + (mappingCone.inr φ₁).f n z,
      cone_ext_element φ₂ n ?_ ?_⟩
    · rw [← ModuleCat.comp_apply, proof_coneMap_fst]
      simpa [← ModuleCat.comp_apply] using hx
    · rw [← ModuleCat.comp_apply, proof_coneMap_snd]
      simpa [← ModuleCat.comp_apply] using hz
  · rintro ⟨x, rfl⟩
    apply cone_ext_element φ₃ n
    · simp only [coneMap_fst_apply, map_zero, ha.apply_apply_eq_zero]
    · simp only [coneMap_snd_apply, map_zero, hb.apply_apply_eq_zero]

private lemma coneMap_zero (φ₁ : K₁ ⟶ L₁) (φ₂ : K₂ ⟶ L₂) :
    mappingCone.map φ₁ φ₂ 0 0 (by simp) = 0 := by
  ext n : 1
  apply mappingCone.ext_to φ₂ n (n + 1) rfl
  · simp [proof_coneMap_fst]
  · simp [proof_coneMap_snd]

end ConeExactness

variable {A : Type u} [CommRing A]

private lemma homStep_preservesZeroMorphisms (f : A) :
    (homStep f : CochainComplex (ModuleCat.{v} A) ℤ ⥤ _).PreservesZeroMorphisms where
  map_zero H H' := by
    have h : homStepConeMap f (0 : H ⟶ H') = 0 := by
      simp only [homStepConeMap, Functor.map_zero, coneMap_zero]
    simp only [homStep, homStepCone, h, Functor.map_zero, coneMap_zero]
    rfl

attribute [local instance] homStep_preservesZeroMorphisms

private lemma homModel_preservesZeroMorphisms : ∀ {r : ℕ} (g : Fin r → A),
    (homModel g : CochainComplex (ModuleCat.{v} A) ℤ ⥤ _).PreservesZeroMorphisms
  | 0, _ => by
    show (𝟭 _).PreservesZeroMorphisms
    infer_instance
  | r + 1, g => by
    have := homModel_preservesZeroMorphisms (Fin.tail g)
    show (homModel (Fin.tail g) ⋙ homStep (g 0)).PreservesZeroMorphisms
    infer_instance

attribute [local instance] homModel_preservesZeroMorphisms

private lemma seqFunctor_map_surjective {M N : ModuleCat.{v} A} (a : M ⟶ N)
    (h : Function.Surjective a) : Function.Surjective (seqFunctor.map a) := by
  intro y
  choose x hx using fun n : ℕ => h (y n)
  exact ⟨x, funext hx⟩

private lemma seqFunctor_map_exact {M N P : ModuleCat.{v} A} (a : M ⟶ N) (b : N ⟶ P)
    (h : Function.Exact a b) : Function.Exact (seqFunctor.map a) (seqFunctor.map b) := by
  intro y
  constructor
  · intro hy
    choose x hx using fun n : ℕ => (h (y n)).1 (congrFun hy n)
    exact ⟨x, funext hx⟩
  · rintro ⟨x, rfl⟩
    funext n
    exact h.apply_apply_eq_zero (x n)

private lemma homStep_map_f_surjective (f : A) {H H' : CochainComplex (ModuleCat.{v} A) ℤ}
    (a : H ⟶ H') (n : ℤ) (h₀ : Function.Surjective (a.f n))
    (h₁ : Function.Surjective (a.f (n + 1))) :
    Function.Surjective (((homStep f).map a).f n) := by
  show Function.Surjective ((homStepCone f a).f (n + -1))
  apply coneMap_f_surjective
  · apply coneMap_f_surjective
    · exact seqFunctor_map_surjective (a.f _) (by rwa [show n + -1 + 1 + 1 = n + 1 by omega])
    · exact seqFunctor_map_surjective (a.f _) (by rwa [show n + -1 + 1 = n by omega])
  · show Function.Surjective (a.f (n + -1 + 1))
    rwa [show n + -1 + 1 = n by omega]

private lemma homStep_map_f_exact (f : A) {H H' H'' : CochainComplex (ModuleCat.{v} A) ℤ}
    (a : H ⟶ H') (b : H' ⟶ H'') (n : ℤ)
    (h₀ : Function.Exact (a.f n) (b.f n))
    (h₁ : Function.Exact (a.f (n + 1)) (b.f (n + 1))) :
    Function.Exact (((homStep f).map a).f n) (((homStep f).map b).f n) := by
  show Function.Exact ((homStepCone f a).f (n + -1)) ((homStepCone f b).f (n + -1))
  apply coneMap_f_exact
  · apply coneMap_f_exact
    · exact seqFunctor_map_exact (a.f _) (b.f _) (by rwa [show n + -1 + 1 + 1 = n + 1 by omega])
    · exact seqFunctor_map_exact (a.f _) (b.f _) (by rwa [show n + -1 + 1 = n by omega])
  · show Function.Exact (a.f (n + -1 + 1)) (b.f (n + -1 + 1))
    rwa [show n + -1 + 1 = n by omega]

private lemma homModel_map_f_surjective : ∀ {r : ℕ} (g : Fin r → A)
    {H H' : CochainComplex (ModuleCat.{v} A) ℤ} (a : H ⟶ H'),
    (∀ n, Function.Surjective (a.f n)) → ∀ n, Function.Surjective (((homModel g).map a).f n)
  | 0, _, _, _, _, h, n => h n
  | r + 1, g, _, _, a, h, n => by
    show Function.Surjective (((homStep (g 0)).map ((homModel (Fin.tail g)).map a)).f n)
    exact homStep_map_f_surjective _ _ _
      (homModel_map_f_surjective (Fin.tail g) a h n)
      (homModel_map_f_surjective (Fin.tail g) a h (n + 1))

private lemma homModel_map_f_exact : ∀ {r : ℕ} (g : Fin r → A)
    {H H' H'' : CochainComplex (ModuleCat.{v} A) ℤ} (a : H ⟶ H') (b : H' ⟶ H''),
    (∀ n, Function.Exact (a.f n) (b.f n)) →
      ∀ n, Function.Exact (((homModel g).map a).f n) (((homModel g).map b).f n)
  | 0, _, _, _, _, _, _, h, n => h n
  | r + 1, g, _, _, _, a, b, h, n => by
    show Function.Exact (((homStep (g 0)).map ((homModel (Fin.tail g)).map a)).f n)
      (((homStep (g 0)).map ((homModel (Fin.tail g)).map b)).f n)
    exact homStep_map_f_exact _ _ _ _
      (homModel_map_f_exact (Fin.tail g) a b h n)
      (homModel_map_f_exact (Fin.tail g) a b h (n + 1))

private lemma homModel_map_exact {r : ℕ} (g : Fin r → A)
    (S : ShortComplex (CochainComplex (ModuleCat.{v} A) ℤ)) (hS : S.ShortExact) :
    (S.map (homModel g)).ShortExact := by
  apply HomologicalComplex.shortExact_of_degreewise_shortExact
  intro n
  have hs := (HomologicalComplex.shortExact_iff_degreewise_shortExact S).1 hS
  refine ShortComplex.ShortExact.mk' ?_ ?_ ?_
  · apply (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact _).2
    exact homModel_map_f_exact g S.f S.g (fun m =>
      (ShortComplex.ShortExact.moduleCat_exact_iff_function_exact _).1 (hs m).exact) n
  · have := hS.mono_f
    have := homModel_map_mono g S.f
    show Mono (((homModel g).map S.f).f n)
    infer_instance
  · rw [ModuleCat.epi_iff_surjective]
    exact homModel_map_f_surjective g S.g (fun m => (hs m).moduleCat_surjective_g) n

/-- The graded pieces of the filtered telescope model are the telescope models of the graded
pieces: the Hom model is exact, so it carries the short exact sequence presenting `gr^pK` to the
one presenting `gr^p Hom(P, K)`. -/
lemma homModel_graded_iso {r : ℕ} (g : Fin r → A)
    (K : FilteredObject (CochainComplex (ModuleCat.{v} A) ℤ) ℤᵒᵖ) (p : ℤ) :
    Nonempty ((FilteredObject.gr p).obj (filteredCompletionModel g K) ≅
      (homModel g).obj ((FilteredObject.gr p).obj K)) := by
  let F : CochainComplex (ModuleCat.{v} A) ℤ ⥤ _ := homModel g
  let M := filteredCompletionModel g K
  let t := K.filtration.step (FilteredObject.succHom p)
  have ht : Mono t := inferInstance
  let S := ShortComplex.mk t (cokernel.π t) (cokernel.condition t)
  have hS : S.ShortExact := ShortComplex.ShortExact.mk'
    (ShortComplex.exact_of_g_is_cokernel _ (cokernelIsCokernel t)) ht inferInstance
  have hFS := homModel_map_exact g S hS
  have hp : Mono (F.map (K.filtration.ι.app (op p))) := homModel_map_mono _ _
  have hp' : Mono (F.map (K.filtration.ι.app (op (p + 1)))) := homModel_map_mono _ _
  let e (q : ℤ) : M.filtration.obj (op q) ≅ F.obj (K.filtration.obj (op q)) :=
    have := homModel_map_mono g (K.filtration.ι.app (op q))
    Subobject.underlyingIso (F.map (K.filtration.ι.app (op q)))
  have he (q : ℤ) : (e q).hom ≫ F.map (K.filtration.ι.app (op q)) =
      M.filtration.ι.app (op q) := by
    have := homModel_map_mono g (K.filtration.ι.app (op q))
    exact Subobject.underlyingIso_hom_comp_eq_mk _
  have hw : M.filtration.step (FilteredObject.succHom p) ≫ (e p).hom =
      (e (p + 1)).hom ≫ F.map t := by
    rw [← cancel_mono (F.map (K.filtration.ι.app (op p))), Category.assoc, Category.assoc,
      he p, ← F.map_comp,
      show t ≫ K.filtration.ι.app (op p) = K.filtration.ι.app (op (p + 1)) from
        Filtration.step_comp_ι_app K.filtration (FilteredObject.succHom p),
      he (p + 1)]
    exact Filtration.step_comp_ι_app M.filtration (FilteredObject.succHom p)
  exact ⟨cokernel.mapIso (M.filtration.step (FilteredObject.succHom p)) (F.map t)
      (e (p + 1)) (e p) hw ≪≫
    (cokernelIsCokernel (F.map t)).coconePointUniqueUpToIso hFS.gIsCokernel⟩

end HomModelExactness


