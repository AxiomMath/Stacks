/-!
# Vanishing of derived completion after inverting an element

Let an ideal of a commutative ring be generated by a finite family. If an element of the ideal
acts invertibly on an object of the derived category, then the derived completion of that object
is zero.

## Main definitions

The derived-completion functor is `cechCompletionFunctor`.

## Main results

* `isZero_cechCompletion_of_isIso_smul`: derived completion vanishes when an element
  of the ideal acts invertibly.

## Implementation notes

A finitely generated ideal is presented by a finite family `g : Fin r → A`; its derived
completion is the functorial Čech model associated to `g`. The hypothesis that `x` acts as an
isomorphism is expressed by `IsIso (x • 𝟙 K)`.

## References

* [The Stacks Project, Tag 0A6D](https://stacks.math.columbia.edu/tag/0A6D)
* [Bhatt--Scholze, *Projectivity of the Witt vector affine Grassmannian*][BS]
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

attribute [local instance] HasDerivedCategory.standard

universe u

end

end

section

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated

attribute [local instance] HasDerivedCategory.standard

universe u

namespace CechCompletion

private lemma hom_subsingleton_of_isIso_smul_of_derivedLimit_isZero
    (A : Type u) [CommRing A]
    (K E : DerivedCategory (ModuleCat.{u} A))
    [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A))]
    (x : A) [IsIso (x • 𝟙 K)]
    (hE : ∃ L : DerivedCategory (ModuleCat.{u} A),
      IsDerivedLimit (Functor.ofOpSequence (X := fun _ : ℕ => E) (fun _ => x • 𝟙 E)) L ∧
        IsZero L) :
    Subsingleton (K ⟶ E) := by
  let d : (∏ᶜ fun _ : ℕ => E) ⟶ (∏ᶜ fun _ : ℕ => E) := Pi.lift fun n : ℕ =>
    Pi.π (fun _ : ℕ => E) n - x • Pi.π (fun _ : ℕ => E) (n + 1)
  have hd : IsIso d := ((DerivedHomAway.tfae_ext_localization_vanishing A x E).2.2.out 3 7).mp hE
  refine ⟨fun f g => ?_⟩
  suffices f - g = 0 by simpa [sub_eq_zero] using this
  let a : K ⟶ K := x • 𝟙 K
  let q : ℕ → (K ⟶ E) := fun n => Nat.rec (f - g) (fun _ z => inv a ≫ z) n
  let s : K ⟶ (∏ᶜ fun _ : ℕ => E) := Pi.lift q
  have hs : s ≫ d = 0 := by
    apply Pi.hom_ext
    intro n
    simp only [d, s, Category.assoc, Pi.lift_comp_π, Preadditive.comp_sub,
      Linear.comp_smul, zero_comp]
    rw [← Category.id_comp (q (n + 1)), ← Linear.smul_comp]
    change q n - a ≫ q (n + 1) = 0
    rw [show q (n + 1) = inv a ≫ q n by simp [q], IsIso.hom_inv_id_assoc]
    simp
  have hs_zero : s = 0 := (cancel_mono d).mp (by simpa using hs)
  simpa [s, q] using congrArg
    (fun t : K ⟶ (∏ᶜ fun _ : ℕ => E) => t ≫ Pi.π (fun _ : ℕ => E) 0) hs_zero

private theorem isZero_cechCompletion_aux (A : Type u) [CommRing A] {r : ℕ}
    (g : Fin r → A) (K : DerivedCategory (ModuleCat.{u} A))
    [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A))]
    {x : A} (hx : x ∈ Ideal.span (Set.range g)) [IsIso (x • 𝟙 K)] :
    IsZero ((cechCompletionFunctor A g).obj K) := by
  obtain ⟨η, hcomplete, huniversal⟩ := cechCompletion_isReflection A g
  let C := (cechCompletionFunctor A g).obj K
  refine (IsZero.iff_id_eq_zero C).2 ((huniversal K C (hcomplete K)).1 ?_)
  change η.app K ≫ 𝟙 C = η.app K ≫ 0
  exact (hom_subsingleton_of_isIso_smul_of_derivedLimit_isZero A K C x
    ((isDerivedCompleteAt_iff_exists_isDerivedLimit_isZero C x).mp
      (hcomplete K x hx))).elim _ _

end CechCompletion

end



end

section

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

attribute [local instance] HasDerivedCategory.standard

universe u

namespace CechCompletion

/-- **Stacks 0A6D.** Let `I` be the ideal generated by a finite family `g`. If some `x ∈ I`
acts invertibly on `K ∈ D(A)`, then the derived completion of `K` with respect to `I` is zero. -/
@[stacks 0A6D]
public theorem isZero_cechCompletion_of_isIso_smul (A : Type u) [CommRing A] {r : ℕ}
    (g : Fin r → A) (K : DerivedCategory (ModuleCat.{u} A))
    [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A))]
    {x : A} (hx : x ∈ Ideal.span (Set.range g)) [IsIso (x • 𝟙 K)] :
    IsZero ((cechCompletionFunctor A g).obj K) :=
  isZero_cechCompletion_aux A g K hx

end CechCompletion

end



end
