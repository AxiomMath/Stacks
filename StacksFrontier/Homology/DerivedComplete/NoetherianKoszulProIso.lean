/-!
# Pro-isomorphism between Koszul complexes on powers and their quotients

Let `A` be a commutative ring and `f : Fin r → A` a finite sequence. For every `n` the Koszul
complex `K(f₀^{n+1}, …, f_{r-1}^{n+1})` carries a canonical augmentation onto
`A / (f₀^{n+1}, …, f_{r-1}^{n+1})`, and these augmentations assemble into a natural
transformation of inverse systems in `D(A)`. When `A` is Noetherian this natural transformation
is an isomorphism of pro-objects: at each level it admits an inverse after passing to a
sufficiently late level.

This is the Noetherian input for the description of derived completion with respect to an ideal
`I` as the derived limit of the reductions modulo the powers of `I`.

## Main definitions

* `NoetherianKoszulProIso.koszulPowerTransition`, `NoetherianKoszulProIso.quotientPowerTransition`:
  the transition maps of the two inverse systems, selected from the canonical inverse system of
  Stacks 0BKC.
* `Koszul.koszulAugmentation`: the canonical augmentation of a Koszul
  complex onto the quotient by its defining sequence.
* `NoetherianKoszulProIso.koszulPowerSystem`: the inverse system of Koszul complexes in `D(A)`.
* `NoetherianKoszulProIso.quotientPowerSystem`: the inverse system of the corresponding
  quotients, concentrated in degree zero.
* `NoetherianKoszulProIso.koszulQuotientComparison`: the canonical natural comparison from the
  Koszul power system to the quotient power system.

## Main results

* `NoetherianKoszulProIso.koszulPowerSystem_proIso_quotientPowerSystem`: over a Noetherian ring
  the two inverse systems are isomorphic as pro-objects.

## Implementation notes

Positive powers are indexed by `n : ℕ` using the exponent `n + 1`. The homological Koszul complex
is extended along `j ↦ -(j : ℤ)` before passing to the cohomological derived category. Since
Mathlib has no category of pro-objects, the isomorphism is expressed by a natural comparison of
inverse systems together with inverses after cofinal refinement. The vanishing of the transition
maps on the negative cohomology of the Koszul system is obtained from the Artin--Rees lemma
applied to the cycles of the Koszul complex, which is where the Noetherian hypothesis enters.

## References

* [Stacks Project, Tag 0921](https://stacks.math.columbia.edu/tag/0921)
-/

@[expose] public section

set_option maxRecDepth 4096

open CategoryTheory Opposite

universe u

namespace NoetherianKoszulProIso

noncomputable instance (A : Type u) [CommRing A] :
    HasDerivedCategory (ModuleCat.{u} A) := HasDerivedCategory.standard _

/-- The transition map between the Koszul complexes on two positive powers of a finite
sequence, selected from the canonical inverse system of Stacks 0BKC. -/
@[ega "III 1.1.6" "(1.1.6.1)"]
public noncomputable def koszulPowerTransition
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    ∀ (m n : ℕ), n ≤ m →
      (Koszul.seqComplex (fun i ↦ f i ^ (m + 1)) ⟶
        Koszul.seqComplex (fun i ↦ f i ^ (n + 1))) :=
  Classical.choose (_root_.koszulPowerComplexes_form_inverseSystem f)

/-- The transition map between quotients by the ideals generated by two positive powers of a
finite sequence, selected from the canonical inverse system of Stacks 0BKC. -/
public noncomputable def quotientPowerTransition
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    ∀ (m n : ℕ), n ≤ m →
      (ModuleCat.of A (A ⧸ Ideal.span (Set.range fun i ↦ f i ^ (m + 1))) ⟶
        ModuleCat.of A (A ⧸ Ideal.span (Set.range fun i ↦ f i ^ (n + 1)))) :=
  Classical.choose (Classical.choose_spec
    (_root_.koszulPowerComplexes_form_inverseSystem f))

/-- **The selected transition map is the explicit one**: scaling the `i`-th coordinate of `Aʳ` by
`f i ^ (m - n)` and taking the induced map of exterior powers.  The selection is a
`Classical.choose`, but the fifth clause of Stacks 0BKC pins it on the wedges of vectors, which
span each exterior power, so the choice is determined
(`choose_koszulPowerComplexes_form_inverseSystem_eq`). -/
public theorem koszulPowerTransition_eq
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) (m n : ℕ) (h : n ≤ m) :
    koszulPowerTransition f m n h = _root_.transition f m n h :=
  _root_.choose_koszulPowerComplexes_form_inverseSystem_eq f m n h

/-- The formula for the selected transition map between Koszul complexes. -/
public theorem koszulPowerTransition_apply_ιMulti
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (m n : ℕ) (h : n ≤ m) (j : ℕ) (v : Fin j → Fin r → A) :
    (koszulPowerTransition f m n h).f j
        ⟨ExteriorAlgebra.ιMulti A j v, Koszul.ιMulti_mem j v⟩ =
      ⟨ExteriorAlgebra.ιMulti A j (fun k i ↦ f i ^ (m - n) * v k i),
        Koszul.ιMulti_mem j (fun k i ↦ f i ^ (m - n) * v k i)⟩ := by
  rw [koszulPowerTransition_eq f m n h]
  apply Subtype.ext
  change ExteriorAlgebra.map (scale f (m - n)) (ExteriorAlgebra.ιMulti A j v) = _
  rw [ExteriorAlgebra.map_apply_ιMulti]
  rfl

/-- The selected transition between quotients is the canonical quotient map. -/
public theorem quotientPowerTransition_comp_mkQ
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (m n : ℕ) (h : n ≤ m) :
    ModuleCat.ofHom
          (Ideal.span (Set.range fun i ↦ f i ^ (m + 1))).mkQ ≫
        quotientPowerTransition f m n h =
      ModuleCat.ofHom
        (Ideal.span (Set.range fun i ↦ f i ^ (n + 1))).mkQ := by
  unfold quotientPowerTransition
  rcases Classical.choose_spec (Classical.choose_spec
      (_root_.koszulPowerComplexes_form_inverseSystem f)) with
    ⟨e, η, hid, hcomp, hsid, hscomp, hformula, hη, hητ, hσ, he, hlast⟩
  exact hσ m n h


/-- The inverse system in `D(A)` of the Koszul complexes on the positive powers of `f`. -/
@[sga "2 II Lemma9"]
public noncomputable def koszulPowerSystem
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    ℕᵒᵖ ⥤ DerivedCategory (ModuleCat.{u} A) :=
  Functor.ofOpSequence (X := fun n ↦ DerivedCategory.Q.obj
    ((Koszul.seqComplex (fun i ↦ f i ^ (n + 1))).extend
      ComplexShape.embeddingDownNat))
    (fun n ↦ DerivedCategory.Q.map
      (HomologicalComplex.extendMap
        (koszulPowerTransition f (n + 1) n (Nat.le_succ n))
        ComplexShape.embeddingDownNat))

/-- The inverse system in `D(A)` of the quotients by the ideals generated by the positive
powers of `f`. -/
public noncomputable def quotientPowerSystem
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    ℕᵒᵖ ⥤ DerivedCategory (ModuleCat.{u} A) :=
  Functor.ofOpSequence (X := fun n ↦ DerivedCategory.Q.obj
    (((ChainComplex.single₀ (ModuleCat.{u} A)).obj
      (ModuleCat.of A (A ⧸ Ideal.span (Set.range fun i ↦ f i ^ (n + 1))))).extend
        ComplexShape.embeddingDownNat))
    (fun n ↦ DerivedCategory.Q.map
      (HomologicalComplex.extendMap
        ((ChainComplex.single₀ (ModuleCat.{u} A)).map
          (quotientPowerTransition f (n + 1) n (Nat.le_succ n)))
        ComplexShape.embeddingDownNat))

set_option backward.isDefEq.respectTransparency false in
/-- The canonical Koszul augmentations commute with the transition maps of the two power
systems. -/
public theorem koszulQuotientAugmentation_naturality
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) (n : ℕ) :
    koszulPowerTransition f (n + 1) n (Nat.le_succ n) ≫
        Koszul.koszulAugmentation (fun i ↦ f i ^ (n + 1)) =
      Koszul.koszulAugmentation (fun i ↦ f i ^ (n + 2)) ≫
        (ChainComplex.single₀ (ModuleCat.{u} A)).map
          (quotientPowerTransition f (n + 1) n (Nat.le_succ n)) := by
  apply (ChainComplex.toSingle₀Equiv _ _).injective
  apply Subtype.ext
  simp only [ChainComplex.toSingle₀Equiv_apply_coe, HomologicalComplex.comp_f,
    ChainComplex.single₀_map_f_zero]
  apply ModuleCat.hom_ext
  ext x
  dsimp only [Koszul.seqComplex, Koszul.complex, ChainComplex.of] at x
  change (⋀[A]^0 (Fin r → A)) at x
  let t : (⋀[A]^0 (Fin r → A)) →ₗ[A] (⋀[A]^0 (Fin r → A)) := by
    simpa only [Koszul.seqComplex, Koszul.complex, ChainComplex.of] using
      (koszulPowerTransition f (n + 1) n (Nat.le_succ n)).f 0 |>.hom
  simp only [Koszul.koszulAugmentation, ChainComplex.toSingle₀Equiv_symm_apply_f_zero,
    ModuleCat.hom_comp, ModuleCat.hom_ofHom, LinearMap.coe_comp, Function.comp_apply]
  change (Ideal.span (Set.range fun i ↦ f i ^ (n + 1))).mkQ
      (exteriorPower.zeroEquiv A (Fin r → A) (t x)) =
    (quotientPowerTransition f (n + 1) n (Nat.le_succ n))
      ((Ideal.span (Set.range fun i ↦ f i ^ (n + 2))).mkQ
        (exteriorPower.zeroEquiv A (Fin r → A) x))
  have hq := ConcreteCategory.congr_hom
    (quotientPowerTransition_comp_mkQ f (n + 1) n (Nat.le_succ n))
    (exteriorPower.zeroEquiv A (Fin r → A) x)
  change (quotientPowerTransition f (n + 1) n (Nat.le_succ n))
      ((Ideal.span (Set.range fun i ↦ f i ^ (n + 2))).mkQ
        (exteriorPower.zeroEquiv A (Fin r → A) x)) =
    (Ideal.span (Set.range fun i ↦ f i ^ (n + 1))).mkQ
      (exteriorPower.zeroEquiv A (Fin r → A) x) at hq
  rw [hq]
  congr 1
  have ht := koszulPowerTransition_apply_ιMulti f (n + 1) n (Nat.le_succ n) 0
    (fun i : Fin 0 ↦ Fin.elim0 i)
  let g : ⋀[A]^0 (Fin r → A) :=
    ⟨ExteriorAlgebra.ιMulti A 0 (fun i : Fin 0 ↦ Fin.elim0 i),
      Koszul.ιMulti_mem 0 _⟩
  change t g = _ at ht
  have hg : exteriorPower.zeroEquiv A (Fin r → A) g = 1 := by
    apply Koszul.zeroEquiv_eq_of_coe
    simp [g, ExteriorAlgebra.ιMulti]
  have ht' : t g = g := by
    rw [ht]
    apply Subtype.ext
    simp [g, ExteriorAlgebra.ιMulti]
  have hx' : x = (exteriorPower.zeroEquiv A (Fin r → A) x) • g := by
    apply (exteriorPower.zeroEquiv A (Fin r → A)).injective
    simp [hg]
  rw [hx', map_smul, ht']

set_option backward.isDefEq.respectTransparency false in
/-- The canonical natural comparison from the Koszul power system to the quotient power
system, induced levelwise by the Koszul augmentation. -/
public noncomputable def koszulQuotientComparison
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    koszulPowerSystem f ⟶ quotientPowerSystem f :=
  NatTrans.ofOpSequence
    (fun n ↦ DerivedCategory.Q.map
      (HomologicalComplex.extendMap
        (Koszul.koszulAugmentation (fun i ↦ f i ^ (n + 1)))
        ComplexShape.embeddingDownNat))
    (fun n ↦ by
      simp only [koszulPowerSystem, quotientPowerSystem,
        Functor.ofOpSequence_map_homOfLE_succ]
      rw [← Functor.map_comp, ← Functor.map_comp]
      congr 1
      rw [← HomologicalComplex.extendMap_comp, ← HomologicalComplex.extendMap_comp,
        koszulQuotientAugmentation_naturality])

/-- Each component of `koszulQuotientComparison` is the image in the derived category of the
canonical Koszul augmentation. -/
public theorem koszulQuotientComparison_app
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) (n : ℕ) :
    (koszulQuotientComparison f).app (op n) =
      DerivedCategory.Q.map (HomologicalComplex.extendMap
        (Koszul.koszulAugmentation (fun i ↦ f i ^ (n + 1)))
        ComplexShape.embeddingDownNat) := rfl

end NoetherianKoszulProIso

end

@[expose] public section

set_option maxRecDepth 4096
set_option backward.isDefEq.respectTransparency false

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace NoetherianKoszulProIso

/-! ### Artin--Rees input: the transitions kill the negative Koszul cohomology -/

public theorem artinRees_cycles_bound
    {R M : Type*} [CommRing R] [IsNoetherianRing R]
    [AddCommGroup M] [Module R M] [Module.Finite R M]
    (J : Ideal R) (N B : Submodule R M) (hJB : J • N ≤ B) :
    ∃ k : ℕ, (J ^ k • (⊤ : Submodule R M)) ⊓ N ≤ B := by
  obtain ⟨c, hc⟩ := J.exists_pow_inf_eq_pow_smul N
  refine ⟨c + 1, ?_⟩
  rw [hc (c + 1) (by omega)]
  simpa using ((smul_mono_right J inf_le_right).trans hJB)

public theorem shortComplex_homologyMap_eq_zero_of_ideal_range
    {R : Type*} [CommRing R] [IsNoetherianRing R]
    (S T : ShortComplex (ModuleCat R)) (φ : S ⟶ T)
    (J : Ideal R) (k : ℕ)
    (hk : J ^ k • (⊤ : Submodule R T.X₂) ⊓ LinearMap.ker T.g.hom ≤
      LinearMap.range T.f.hom)
    (hφ : LinearMap.range φ.τ₂.hom ≤
        J ^ k • (⊤ : Submodule R T.X₂)) :
    ShortComplex.homologyMap φ = 0 := by
  apply (cancel_mono T.homologyι).1
  apply (cancel_epi S.homologyπ).1
  rw [← Category.assoc, S.homologyπ_naturality φ, Category.assoc, T.homology_π_ι]
  apply ModuleCat.hom_ext
  ext x
  have hx : T.g (φ.τ₂ (S.iCycles x)) = 0 := by
    rw [← ConcreteCategory.comp_apply, φ.comm₂₃, ConcreteCategory.comp_apply]
    have hS : S.g (S.iCycles x) = 0 := by
      have h := congrArg (fun q : S.cycles ⟶ S.X₃ => q x) S.iCycles_g
      simpa only [ConcreteCategory.comp_apply, ModuleCat.hom_zero,
        LinearMap.zero_apply] using h
    simp [hS]
  have hmem : φ.τ₂ (S.iCycles x) ∈ LinearMap.range T.f.hom := by
    apply hk
    exact ⟨hφ ⟨S.iCycles x, rfl⟩, LinearMap.mem_ker.mpr hx⟩
  simpa [ModuleCat.hom_comp, ModuleCat.hom_zero] using
    (T.moduleCat_pOpcycles_eq_zero_iff (φ.τ₂ (S.iCycles x))).2 hmem

public theorem ideal_smul_ker_le_range_of_annihilator
    {R : Type*} [CommRing R] (T : ShortComplex (ModuleCat R))
    (J : Ideal R) (hJ : J ≤ Module.annihilator R T.homology) :
    J • LinearMap.ker T.g.hom ≤ LinearMap.range T.f.hom := by
  apply Submodule.smul_le.mpr
  intro a ha z hz
  let z' : LinearMap.ker T.g.hom := ⟨z, hz⟩
  have han : a • (T.homologyπ (T.moduleCatCyclesIso.inv z')) = 0 :=
    (Module.mem_annihilator.mp (hJ ha)) _
  have hq : T.moduleCatLeftHomologyData.π (a • z') = 0 := by
    have heq := congrArg (fun q : T.cycles ⟶ T.moduleCatLeftHomologyData.H =>
        q (T.moduleCatCyclesIso.inv (a • z')))
      (T.π_moduleCatCyclesIso_hom)
    have hinv : T.moduleCatCyclesIso.inv (a • z') =
        a • T.moduleCatCyclesIso.inv z' := map_smul _ _ _
    simp only [ConcreteCategory.comp_apply] at heq
    rw [hinv, map_smul, han, map_zero] at heq
    have h_iso : T.moduleCatCyclesIso.hom
        (a • T.moduleCatCyclesIso.inv z') = a • z' := by
      rw [map_smul]
      congr 1
      have hc := congrArg
        (fun q : T.moduleCatLeftHomologyData.K ⟶ T.moduleCatLeftHomologyData.K => q z')
        T.moduleCatCyclesIso.inv_hom_id
      change T.moduleCatCyclesIso.hom (T.moduleCatCyclesIso.inv z') = z' at hc
      exact hc
    rw [h_iso] at heq
    exact heq.symm
  have hm : a • z' ∈ LinearMap.range T.moduleCatToCycles := by
    exact (Submodule.Quotient.mk_eq_zero _).mp hq
  obtain ⟨w, hw⟩ := hm
  exact ⟨w, congrArg Subtype.val hw⟩

public theorem weighted_vector_mem_ideal
    {R : Type*} [CommRing R] {r : ℕ} (I : Ideal R)
    (c v : Fin r → R) (hc : ∀ i, c i ∈ I) :
    (fun i => c i * v i) ∈ I • (⊤ : Submodule R (Fin r → R)) := by
  classical
  have heq : (fun i => c i * v i) = ∑ i, c i • Pi.single i (v i) := by
    ext i
    simp [Finset.sum_apply, Pi.single_apply, smul_eq_mul]
  rw [heq]
  exact Submodule.sum_mem _ (fun i _ => Submodule.smul_mem_smul (hc i) (Submodule.mem_top))

public theorem linearMap_mem_ideal_smul_top
    {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] (I : Ideal R) (L : M →ₗ[R] N) {x : M}
    (hx : x ∈ I • (⊤ : Submodule R M)) :
    L x ∈ I • (⊤ : Submodule R N) := by
  have h := Submodule.mem_map_of_mem hx (f := L)
  rw [Submodule.map_smul''] at h
  exact (smul_mono_right I
    (le_top : (⊤ : Submodule R M).map L ≤ (⊤ : Submodule R N))) h

public theorem ιMulti_succ_mem_ideal
    {R : Type*} [CommRing R] {r q : ℕ} (I : Ideal R)
    (v : Fin (q + 1) → Fin r → R)
    (hv : v 0 ∈ I • (⊤ : Submodule R (Fin r → R))) :
    (⟨ExteriorAlgebra.ιMulti R (q + 1) v,
      Koszul.ιMulti_mem (q + 1) v⟩ : ⋀[R]^(q + 1) (Fin r → R)) ∈
        I • (⊤ : Submodule R (⋀[R]^(q + 1) (Fin r → R))) := by
  let L : (Fin r → R) →ₗ[R] (⋀[R]^(q + 1) (Fin r → R)) := {
    toFun x := ⟨ExteriorAlgebra.ιMulti R (q + 1)
      (Matrix.vecCons x (Matrix.vecTail v)), Koszul.ιMulti_mem _ _⟩
    map_add' x y := by
      apply Subtype.ext
      exact (ExteriorAlgebra.ιMulti R (q + 1)).map_vecCons_add (Matrix.vecTail v) x y
    map_smul' c x := by
      apply Subtype.ext
      exact (ExteriorAlgebra.ιMulti R (q + 1)).map_vecCons_smul (Matrix.vecTail v) c x
  }
  have h := linearMap_mem_ideal_smul_top I L hv
  convert h using 1
  congr 1
  exact (congrArg (ExteriorAlgebra.ιMulti R (q + 1)) (Matrix.cons_head_tail v)).symm

private theorem koszulPowerTransition_range_le_ideal
    {R : Type*} [CommRing R] {r : ℕ} (f : Fin r → R)
    (m n : ℕ) (hmn : n ≤ m) (q : ℕ) (I : Ideal R)
    (hf : ∀ i, f i ^ (m - n) ∈ I) :
    LinearMap.range ((koszulPowerTransition f m n hmn).f (q + 1)).hom ≤
      I • (⊤ : Submodule R (⋀[R]^(q + 1) (Fin r → R))) := by
  let L : (⋀[R]^(q + 1) (Fin r → R)) →ₗ[R]
      (⋀[R]^(q + 1) (Fin r → R)) :=
    ((koszulPowerTransition f m n hmn).f (q + 1)).hom
  change LinearMap.range L ≤ I • (⊤ : Submodule R (⋀[R]^(q + 1) (Fin r → R)))
  have hgen (v : Fin (q + 1) → Fin r → R) :
      L (exteriorPower.ιMulti R (q + 1) v) ∈
        I • (⊤ : Submodule R (⋀[R]^(q + 1) (Fin r → R))) := by
    have hformula := koszulPowerTransition_apply_ιMulti f m n hmn (q + 1) v
    change L (exteriorPower.ιMulti R (q + 1) v) =
      (⟨ExteriorAlgebra.ιMulti R (q + 1)
        (fun k i => f i ^ (m - n) * v k i), Koszul.ιMulti_mem _ _⟩ :
        ⋀[R]^(q + 1) (Fin r → R)) at hformula
    rw [hformula]
    apply ιMulti_succ_mem_ideal
    exact weighted_vector_mem_ideal I _ _ hf
  have hspan : Submodule.span R
      (Set.range (exteriorPower.ιMulti R (q + 1) :
        (Fin (q + 1) → Fin r → R) → ⋀[R]^(q + 1) (Fin r → R))) ≤
      (I • (⊤ : Submodule R (⋀[R]^(q + 1) (Fin r → R)))).comap L := by
    rw [Submodule.span_le]
    rintro _ ⟨v, rfl⟩
    exact hgen v
  rw [exteriorPower.ιMulti_span] at hspan
  intro x hx
  obtain ⟨y, rfl⟩ := hx
  exact hspan (Submodule.mem_top)

public theorem power_generator_mem_span_pow
    {R : Type*} [CommRing R] {r : ℕ} (f : Fin r → R)
    (n k : ℕ) (i : Fin r) :
    f i ^ ((n + (n + 1) * k) - n) ∈
      (Ideal.span (Set.range fun j => f j ^ (n + 1))) ^ k := by
  have hf : f i ^ (n + 1) ∈ Ideal.span (Set.range fun j => f j ^ (n + 1)) :=
    Ideal.subset_span ⟨i, rfl⟩
  convert Ideal.pow_mem_pow hf k using 1
  simp [pow_mul]

theorem koszulPowerTransition_homologyMap_eq_zero_pos
    {R : Type*} [CommRing R] [IsNoetherianRing R] {r : ℕ}
    (f : Fin r → R) (n j : ℕ) (hj : 0 < j) :
    ∃ (m : ℕ) (h : n ≤ m),
      HomologicalComplex.homologyMap
        (koszulPowerTransition f m n h) j = 0 := by
  cases j with
  | zero => omega
  | succ q =>
    let J : Ideal R := Ideal.span (Set.range fun i => f i ^ (n + 1))
    let K := Koszul.seqComplex (fun i => f i ^ (n + 1))
    let T := K.sc (q + 1)
    let : Module.Finite R T.X₂ := by
      change Module.Finite R (⋀[R]^(q + 1) (Fin r → R))
      infer_instance
    have hJ : J ≤ Module.annihilator R T.homology := by
      exact (Koszul.koszulSeq_smul_nullHomotopic_and_span_le_annihilator
        (fun i => f i ^ (n + 1))).2 (q + 1)
    have hJB := ideal_smul_ker_le_range_of_annihilator T J hJ
    obtain ⟨k, hk⟩ := artinRees_cycles_bound J
      (LinearMap.ker T.g.hom) (LinearMap.range T.f.hom) hJB
    let m := n + (n + 1) * k
    have hmn : n ≤ m := by dsimp [m]; omega
    let S := (Koszul.seqComplex (fun i => f i ^ (m + 1))).sc (q + 1)
    let φ : S ⟶ T :=
      (HomologicalComplex.shortComplexFunctor (ModuleCat R) (ComplexShape.down ℕ) (q + 1)).map
        (koszulPowerTransition f m n hmn)
    have hrange : LinearMap.range φ.τ₂.hom ≤ J ^ k • (⊤ : Submodule R T.X₂) := by
      exact koszulPowerTransition_range_le_ideal f m n hmn q (J ^ k)
        (power_generator_mem_span_pow f n k)
    have hzero := shortComplex_homologyMap_eq_zero_of_ideal_range S T φ J k hk hrange
    exact ⟨m, hmn, hzero⟩

public theorem koszulUnit_comp_augmentation
    {R : Type*} [CommRing R] {r : ℕ} (f : Fin r → R)
    (η : (ChainComplex.single₀ (ModuleCat R)).obj (ModuleCat.of R R) ⟶
      Koszul.seqComplex f)
    (hη : ∀ a : R, η.f 0 a =
      a • (⟨ExteriorAlgebra.ιMulti R 0 (fun i => Fin.elim0 i),
        Koszul.ιMulti_mem 0 (fun i => Fin.elim0 i)⟩ : ⋀[R]^0 (Fin r → R))) :
    η ≫ Koszul.koszulAugmentation f =
      (ChainComplex.single₀ (ModuleCat R)).map
        (ModuleCat.ofHom (Ideal.span (Set.range f)).mkQ) := by
  apply (ChainComplex.toSingle₀Equiv _ _).injective
  apply Subtype.ext
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro a
  simp only [ChainComplex.toSingle₀Equiv_apply_coe, HomologicalComplex.comp_f,
    ChainComplex.single₀_map_f_zero, Koszul.koszulAugmentation_f_zero,
    ModuleCat.hom_comp, ModuleCat.hom_ofHom, LinearMap.coe_comp, Function.comp_apply]
  rw [hη]
  have hg : exteriorPower.zeroEquiv R (Fin r → R)
      (⟨ExteriorAlgebra.ιMulti R 0 (fun i => Fin.elim0 i),
        Koszul.ιMulti_mem 0 _⟩ : ⋀[R]^0 (Fin r → R)) = 1 := by
    apply Koszul.zeroEquiv_eq_of_coe
    simp [ExteriorAlgebra.ιMulti]
  congr 1
  apply Koszul.zeroEquiv_eq_of_coe
  simp [Algebra.algebraMap_eq_smul_one]

public theorem koszulPowerAugmentation_homologyMap_zero_isIso
    {R : Type*} [CommRing R] {r : ℕ} (f : Fin r → R) (n : ℕ) :
    IsIso (HomologicalComplex.homologyMap
      (Koszul.koszulAugmentation (fun i => f i ^ (n + 1))) 0) := by
  let Q : ℕ → ModuleCat R := fun t =>
    ModuleCat.of R (R ⧸ Ideal.span (Set.range fun i => f i ^ (t + 1)))
  let H := _root_.koszulPowerComplexes_form_inverseSystem f
  rcases Classical.choose_spec H with
    ⟨σ, e, η, hid, hcomp, hsid, hscomp, hformula, hη, hητ, hσ, he, hlast⟩
  let U := (HomologicalComplex.singleObjHomologySelfIso
    (ComplexShape.down ℕ) 0 (ModuleCat.of R R)).inv ≫
    HomologicalComplex.homologyMap (η n) 0
  let α := Koszul.koszulAugmentation (fun i => f i ^ (n + 1))
  let V := HomologicalComplex.singleObjHomologySelfIso
    (ComplexShape.down ℕ) 0 (Q n)
  have hηα : η n ≫ α = (ChainComplex.single₀ (ModuleCat R)).map
      (ModuleCat.ofHom (Ideal.span (Set.range fun i => f i ^ (n + 1))).mkQ) :=
    koszulUnit_comp_augmentation _ (η n) (hη n)
  have hUV : U ≫ HomologicalComplex.homologyMap α 0 ≫ V.hom =
      ModuleCat.ofHom (Ideal.span (Set.range fun i => f i ^ (n + 1))).mkQ := by
    change ((HomologicalComplex.singleObjHomologySelfIso
      (ComplexShape.down ℕ) 0 (ModuleCat.of R R)).inv ≫
      HomologicalComplex.homologyMap (η n) 0) ≫
      HomologicalComplex.homologyMap α 0 ≫ V.hom = _
    have hcomp : ((HomologicalComplex.singleObjHomologySelfIso
        (ComplexShape.down ℕ) 0 (ModuleCat.of R R)).inv ≫
        HomologicalComplex.homologyMap (η n) 0) ≫
        HomologicalComplex.homologyMap α 0 =
      (HomologicalComplex.singleObjHomologySelfIso
        (ComplexShape.down ℕ) 0 (ModuleCat.of R R)).inv ≫
        HomologicalComplex.homologyMap (η n ≫ α) 0 := by
      rw [HomologicalComplex.homologyMap_comp, ← Category.assoc]
    rw [← Category.assoc, hcomp, hηα]
    rw [HomologicalComplex.singleObjHomologySelfIso_inv_naturality]
    simp [V]
  have hUe : U ≫ (e n).hom =
      ModuleCat.ofHom (Ideal.span (Set.range fun i => f i ^ (n + 1))).mkQ :=
    hlast n
  have : Epi U := by
    have hq : Epi (ModuleCat.ofHom
        (Ideal.span (Set.range fun i => f i ^ (n + 1))).mkQ) :=
      (ModuleCat.epi_iff_surjective _).2 (Submodule.mkQ_surjective _)
    have hU : U = ModuleCat.ofHom
        (Ideal.span (Set.range fun i => f i ^ (n + 1))).mkQ ≫ (e n).inv := by
      rw [← hUe, Category.assoc, Iso.hom_inv_id, Category.comp_id]
    rw [hU]
    infer_instance
  have hα : HomologicalComplex.homologyMap α 0 ≫ V.hom = (e n).hom := by
    apply (cancel_epi U).1
    simpa only [Category.assoc] using hUV.trans hUe.symm
  have hi : IsIso (HomologicalComplex.homologyMap α 0 ≫ V.hom) := by
    rw [hα]
    infer_instance
  exact IsIso.of_isIso_comp_right _ V.hom

/-- The homology of the image of a chain map in the derived category is conjugate to its
homology map by the comparison isomorphisms. -/
private theorem homologyFunctor_Q_map_eq_comp
    {R : Type u} [CommRing R] [HasDerivedCategory.{u + 1} (ModuleCat.{u} R)]
    {K L : CochainComplex (ModuleCat.{u} R) ℤ} (φ : K ⟶ L) (i : ℤ) :
    (DerivedCategory.homologyFunctor.{u+1,u,u+1} (ModuleCat.{u} R) i).map
      (DerivedCategory.Q.{u+1,u,u+1}.map φ) =
    ((DerivedCategory.homologyFunctorFactors.{u+1,u,u+1} (ModuleCat.{u} R) i).app K).hom ≫
      HomologicalComplex.homologyMap φ i ≫
      ((DerivedCategory.homologyFunctorFactors.{u+1,u,u+1} (ModuleCat.{u} R) i).app L).inv := by
  have hn := DerivedCategory.homologyFunctorFactors_hom_naturality.{u+1,u,u+1} φ i
  rw [← Category.assoc, Iso.eq_comp_inv]
  exact hn

public theorem homologyFunctor_Q_map_eq_zero_of_homologyMap_eq_zero
    {R : Type u} [CommRing R] [HasDerivedCategory.{u + 1} (ModuleCat.{u} R)]
    {K L : CochainComplex (ModuleCat.{u} R) ℤ}
    (φ : K ⟶ L) (i : ℤ) (h : HomologicalComplex.homologyMap φ i = 0) :
    (DerivedCategory.homologyFunctor.{u+1,u,u+1} (ModuleCat.{u} R) i).map
      (DerivedCategory.Q.{u+1,u,u+1}.map φ) = 0 := by
  rw [homologyFunctor_Q_map_eq_comp, h]
  simp

public theorem homologyFunctor_Q_map_isIso_of_homologyMap_isIso
    {R : Type u} [CommRing R] [HasDerivedCategory.{u + 1} (ModuleCat.{u} R)]
    {K L : CochainComplex (ModuleCat.{u} R) ℤ}
    (φ : K ⟶ L) (i : ℤ) [IsIso (HomologicalComplex.homologyMap φ i)] :
    IsIso ((DerivedCategory.homologyFunctor.{u+1,u,u+1} (ModuleCat.{u} R) i).map
      (DerivedCategory.Q.{u+1,u,u+1}.map φ)) := by
  rw [homologyFunctor_Q_map_eq_comp]
  infer_instance

/-- The homology map of the extension of a chain map is conjugate to the original homology map
by the extension isomorphisms. -/
private theorem homologyMap_extendMap_eq_comp
    {R : Type u} [CommRing R]
    {K L : ChainComplex (ModuleCat.{u} R) ℕ} (φ : K ⟶ L) (j : ℕ) :
    HomologicalComplex.homologyMap
      (HomologicalComplex.extendMap φ ComplexShape.embeddingDownNat) (-(j : ℤ)) =
    (K.extendHomologyIso ComplexShape.embeddingDownNat (j' := -(j : ℤ)) rfl).hom ≫
      HomologicalComplex.homologyMap φ j ≫
      (L.extendHomologyIso ComplexShape.embeddingDownNat (j' := -(j : ℤ)) rfl).inv := by
  rw [← Category.assoc, Iso.eq_comp_inv]
  exact HomologicalComplex.extendHomologyIso_hom_naturality φ
    ComplexShape.embeddingDownNat (j := j) (j' := -(j : ℤ)) rfl

public theorem homologyMap_extendDown_eq_zero_of_homologyMap_eq_zero
    {R : Type u} [CommRing R]
    {K L : ChainComplex (ModuleCat.{u} R) ℕ} (φ : K ⟶ L) (j : ℕ)
    (h : HomologicalComplex.homologyMap φ j = 0) :
    HomologicalComplex.homologyMap
      (HomologicalComplex.extendMap φ ComplexShape.embeddingDownNat) (-(j : ℤ)) = 0 := by
  rw [homologyMap_extendMap_eq_comp, h]
  simp

public theorem homologyMap_extendDown_isIso_of_homologyMap_isIso
    {R : Type u} [CommRing R]
    {K L : ChainComplex (ModuleCat.{u} R) ℕ} (φ : K ⟶ L) (j : ℕ)
    [IsIso (HomologicalComplex.homologyMap φ j)] :
    IsIso (HomologicalComplex.homologyMap
      (HomologicalComplex.extendMap φ ComplexShape.embeddingDownNat) (-(j : ℤ))) := by
  rw [homologyMap_extendMap_eq_comp]
  infer_instance

public theorem koszul_seqComplex_isZero_X_of_gt
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R) (j : ℕ) (hj : r < j) :
    IsZero ((Koszul.seqComplex f).X j) := by
  apply ModuleCat.isZero_iff_subsingleton.mpr
  change Subsingleton (⋀[R]^j (Fin r → R))
  apply exteriorPower.subsingleton_of_span_eq_top_of_card_lt
    (fun i : Fin r => (Pi.basisFun R (Fin r)) i)
    (Pi.basisFun R (Fin r)).span_eq j
  simpa using hj

/-- The extension of a chain complex along `j ↦ -j` has vanishing homology in degree `i` as soon
as the terms indexed by the `j` with `-j = i` vanish. -/
private theorem isZero_homology_extendDown_of_isZero_X
    {R : Type u} [CommRing R] (K : ChainComplex (ModuleCat.{u} R) ℕ) (i : ℤ)
    (hK : ∀ j : ℕ, -(j : ℤ) = i → IsZero (K.X j)) :
    IsZero ((K.extend ComplexShape.embeddingDownNat).homology i) := by
  have hX : IsZero ((K.extend ComplexShape.embeddingDownNat).X i) := by
    by_cases hp : ∃ j : ℕ, -(j : ℤ) = i
    · obtain ⟨j, hj⟩ := hp
      exact (hK j hj).of_iso (K.extendXIso ComplexShape.embeddingDownNat hj)
    · exact K.isZero_extend_X ComplexShape.embeddingDownNat i
        (fun j hj => hp ⟨j, hj⟩)
  exact (K.extend ComplexShape.embeddingDownNat).sc i |>.isZero_homology_of_isZero_X₂ hX

/-- The homology functor on the derived category kills an object coming from a complex with
vanishing homology in that degree. -/
private theorem isZero_homologyFunctor_obj_Q_of_isZero_homology
    {R : Type u} [CommRing R] [HasDerivedCategory.{u + 1} (ModuleCat.{u} R)]
    (E : CochainComplex (ModuleCat.{u} R) ℤ) (i : ℤ) (hE : IsZero (E.homology i)) :
    IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} R) i).obj
      (DerivedCategory.Q.obj E)) :=
  hE.of_iso ((DerivedCategory.homologyFunctorFactors (ModuleCat.{u} R) i).app E)

public theorem koszul_extendDown_isZero_homology_outside
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (i : ℤ) (hi : i < -(r : ℤ) ∨ 0 < i) :
    IsZero (((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat).homology i) :=
  isZero_homology_extendDown_of_isZero_X _ i fun j hj =>
    koszul_seqComplex_isZero_X_of_gt f j (by rcases hi with hi | hi <;> omega)

public theorem single_extendDown_isZero_homology_of_ne_zero
    {R : Type u} [CommRing R] (Q : ModuleCat.{u} R)
    (i : ℤ) (hi : i ≠ 0) :
    IsZero ((((ChainComplex.single₀ (ModuleCat.{u} R)).obj Q).extend
      ComplexShape.embeddingDownNat).homology i) :=
  isZero_homology_extendDown_of_isZero_X _ i fun j hj =>
    HomologicalComplex.isZero_single_obj_X (ComplexShape.down ℕ) 0 Q j (by omega)

public theorem homologyFunctor_koszulPowerSystem_isZero_outside
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (i : ℤ) (hi : i < -(r : ℤ) ∨ 0 < i) (n : ℕ) :
    IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} R) i).obj
      ((koszulPowerSystem f).obj (Opposite.op n))) :=
  isZero_homologyFunctor_obj_Q_of_isZero_homology _ i
    (koszul_extendDown_isZero_homology_outside (fun j => f j ^ (n + 1)) i hi)

public theorem homologyFunctor_quotientPowerSystem_isZero_of_ne_zero
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (i : ℤ) (hi : i ≠ 0) (n : ℕ) :
    IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} R) i).obj
      ((quotientPowerSystem f).obj (Opposite.op n))) :=
  isZero_homologyFunctor_obj_Q_of_isZero_homology _ i
    (single_extendDown_isZero_homology_of_ne_zero _ i hi)

/-- The identity law of the selected transition maps: the transition from a power to itself is
the identity of the Koszul complex on that power. -/
@[ega "III 1.1.6" "partial"]
public theorem koszulPowerTransition_id
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R) (n : ℕ) :
    koszulPowerTransition f n n (le_refl n) = 𝟙 _ := by
  unfold koszulPowerTransition
  rcases Classical.choose_spec (_root_.koszulPowerComplexes_form_inverseSystem f) with
    ⟨σ, e, η, hid, hcomp, hsid, hscomp, hformula, hη, hητ, hσ, he, hlast⟩
  exact hid n

/-- The composition law of the selected transition maps: transitions compose along
`n ≤ m ≤ k`, so the Koszul complexes on the powers of `f` form an inverse system. -/
@[ega "III 1.1.6" "partial"]
public theorem koszulPowerTransition_comp
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (k m n : ℕ) (hkm : m ≤ k) (hmn : n ≤ m) :
    koszulPowerTransition f k m hkm ≫
        koszulPowerTransition f m n hmn =
      koszulPowerTransition f k n (hmn.trans hkm) := by
  unfold koszulPowerTransition
  rcases Classical.choose_spec (_root_.koszulPowerComplexes_form_inverseSystem f) with
    ⟨σ, e, η, hid, hcomp, hsid, hscomp, hformula, hη, hητ, hσ, he, hlast⟩
  exact hcomp k m n hkm hmn

private theorem koszulPowerSystem_map_homOfLE
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (m n : ℕ) (h : n ≤ m) :
    (koszulPowerSystem f).map (homOfLE h).op =
      DerivedCategory.Q.map (HomologicalComplex.extendMap
        (koszulPowerTransition f m n h)
        ComplexShape.embeddingDownNat) := by
  induction m, h using Nat.le_induction with
  | base =>
      rw [koszulPowerTransition_id]
      simp [koszulPowerSystem]
      rfl
  | succ m hnm ih =>
      have hcat : (homOfLE (hnm.trans (Nat.le_succ m))).op =
          (homOfLE (Nat.le_succ m)).op ≫ (homOfLE hnm).op :=
        Subsingleton.elim _ _
      rw [hcat, Functor.map_comp, ih]
      rw [show (koszulPowerSystem f).map
          (homOfLE (Nat.le_succ m)).op =
            DerivedCategory.Q.map (HomologicalComplex.extendMap
              (koszulPowerTransition f (m + 1) m (Nat.le_succ m))
              ComplexShape.embeddingDownNat) from by
                exact Functor.ofOpSequence_map_homOfLE_succ _ m]
      rw [← Functor.map_comp, ← HomologicalComplex.extendMap_comp,
        koszulPowerTransition_comp]

public theorem homologyFunctor_koszulPowerSystem_transition_eq_zero_neg
    {R : Type u} [CommRing R] [IsNoetherianRing R] {r : ℕ} (f : Fin r → R)
    (i : ℤ) (hi : i < 0) (n : ℕ) :
    ∃ (m : ℕ) (h : n ≤ m),
      (DerivedCategory.homologyFunctor (ModuleCat.{u} R) i).map
        ((koszulPowerSystem f).map (homOfLE h).op) = 0 := by
  let j : ℕ := (-i).toNat
  have hj : 0 < j := by dsimp [j]; omega
  have hji : i = -(j : ℤ) := by dsimp [j]; omega
  obtain ⟨m, h, hzero⟩ := koszulPowerTransition_homologyMap_eq_zero_pos f n j hj
  refine ⟨m, h, ?_⟩
  rw [hji, koszulPowerSystem_map_homOfLE]
  exact homologyFunctor_Q_map_eq_zero_of_homologyMap_eq_zero _ _
    (homologyMap_extendDown_eq_zero_of_homologyMap_eq_zero _ j hzero)

public theorem homologyFunctor_koszulQuotientComparison_isIso_zero
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R) (n : ℕ) :
    IsIso ((DerivedCategory.homologyFunctor (ModuleCat.{u} R) 0).map
      ((koszulQuotientComparison f).app (op n))) := by
  rw [koszulQuotientComparison_app]
  let α := Koszul.koszulAugmentation (fun i ↦ f i ^ (n + 1))
  have : IsIso (HomologicalComplex.homologyMap α 0) :=
    koszulPowerAugmentation_homologyMap_zero_isIso f n
  have : IsIso (HomologicalComplex.homologyMap
      (HomologicalComplex.extendMap α ComplexShape.embeddingDownNat) 0) :=
    homologyMap_extendDown_isIso_of_homologyMap_isIso α 0
  exact homologyFunctor_Q_map_isIso_of_homologyMap_isIso
    (HomologicalComplex.extendMap α ComplexShape.embeddingDownNat) 0

/-! ### The pro-isomorphism -/

/-- **Stacks Project, Tag 0921.** Over a Noetherian ring, the inverse systems in the derived
category formed by the Koszul complexes on the positive powers of a finite sequence and by the
corresponding quotients are isomorphic as pro-objects. Concretely, the comparison is a natural
transformation, and at every level it admits an inverse after passing to a later level. The first
of the two displayed identities is precisely the factorization through the quotient asserted in
the source. -/
@[stacks 0921]
public theorem koszulPowerSystem_proIso_quotientPowerSystem
    {A : Type u} [CommRing A] [IsNoetherianRing A] {r : ℕ} (f : Fin r → A) :
    ∀ n : ℕ, ∃ (m : ℕ) (h : n ≤ m)
      (s : (quotientPowerSystem f).obj (op m) ⟶
        (koszulPowerSystem f).obj (op n)),
      (koszulQuotientComparison f).app (op m) ≫ s =
          (koszulPowerSystem f).map (homOfLE h).op ∧
        s ≫ (koszulQuotientComparison f).app (op n) =
          (quotientPowerSystem f).map (homOfLE h).op := by
  intro n
  let α := koszulQuotientComparison f
  let H := DerivedCategory.homologyFunctor (ModuleCat.{u} A)
  have hA (i : ℤ) (hi : i < -(r : ℤ) ∨ 0 < i) (j : ℕᵒᵖ) :
      IsZero ((H i).obj ((koszulPowerSystem f).obj j)) := by
    exact homologyFunctor_koszulPowerSystem_isZero_outside f i hi j.unop
  have hB (i : ℤ) (hi : i < -(r : ℤ) ∨ 0 < i) (j : ℕᵒᵖ) :
      IsZero ((H i).obj ((quotientPowerSystem f).obj j)) := by
    apply homologyFunctor_quotientPowerSystem_isZero_of_ne_zero f i
    omega
  have hH (i : ℤ) (j : ℕᵒᵖ) :
      ∃ (k : ℕᵒᵖ) (g : k ⟶ j)
        (s : (H i).obj ((quotientPowerSystem f).obj k) ⟶
          (H i).obj ((koszulPowerSystem f).obj j)),
        (H i).map (α.app k) ≫ s =
          (H i).map ((koszulPowerSystem f).map g) ∧
          s ≫ (H i).map (α.app j) =
          (H i).map ((quotientPowerSystem f).map g) := by
    by_cases hi0 : i = 0
    · subst i
      have : IsIso ((H 0).map (α.app j)) :=
        homologyFunctor_koszulQuotientComparison_isIso_zero f j.unop
      refine ⟨j, 𝟙 j, inv ((H 0).map (α.app j)), ?_, ?_⟩
      · simp [IsIso.hom_inv_id]
      · simp [IsIso.inv_hom_id]
    · by_cases hin : i < 0
      · obtain ⟨m, h, hzero⟩ :=
          homologyFunctor_koszulPowerSystem_transition_eq_zero_neg f i hin j.unop
        let g : op m ⟶ j := (homOfLE h).op
        have hq : IsZero ((H i).obj ((quotientPowerSystem f).obj (op m))) :=
          homologyFunctor_quotientPowerSystem_isZero_of_ne_zero f i hi0 m
        refine ⟨op m, g, 0, ?_, ?_⟩
        · simpa [g] using hzero.symm
        · exact hq.eq_of_src _ _
      · have hip : 0 < i := by omega
        have hAj := hA i (Or.inr hip) j
        have hBj := hB i (Or.inr hip) j
        refine ⟨j, 𝟙 j, 0, ?_, ?_⟩
        · exact hAj.eq_of_tgt _ _
        · exact hBj.eq_of_src _ _
  obtain ⟨k, g, s, hs₁, hs₂⟩ :=
    DerivedCategory.exists_proInverse_of_proInverse_homology α (-(r : ℤ)) 0
      hA hB hH (op n)
  have h : n ≤ k.unop := leOfHom g.unop
  have hg : g = (homOfLE h).op := Subsingleton.elim _ _
  refine ⟨k.unop, h, s, ?_, ?_⟩
  · simpa [α, hg] using hs₁
  · simpa [α, hg] using hs₂

end NoetherianKoszulProIso

end

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace NoetherianKoszulProIso

/-! ### A chain of powers along which every positive homology map vanishes

`koszulPowerTransition_homologyMap_eq_zero_pos` kills one chosen homological degree at a time.
The chain-level form of Stacks 0921 needed for Tag 0GZ4 kills *all* positive degrees at once, and
iterates: aggregating over degrees is possible because the Koszul complex of a sequence of length
`r` is zero in degrees `> r`, so only the finitely many degrees `1, …, r` have to be arranged,
and a transition map that vanishes on `H_j` continues to vanish after it is prolonged, because
`koszulPowerTransition` is functorial and `homologyMap` preserves composition. -/

/-- Above the length of the sequence the Koszul complex is zero, so every transition map vanishes
on homology in those degrees. -/
private theorem koszulPowerTransition_homologyMap_eq_zero_of_lt
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (m n : ℕ) (h : n ≤ m) (j : ℕ) (hj : r < j) :
    HomologicalComplex.homologyMap (koszulPowerTransition f m n h) j = 0 := by
  have hz : IsZero ((Koszul.seqComplex (fun i => f i ^ (n + 1))).X j) :=
    koszul_seqComplex_isZero_X_of_gt (fun i => f i ^ (n + 1)) j hj
  have hH : IsZero ((Koszul.seqComplex (fun i => f i ^ (n + 1))).homology j) :=
    ((Koszul.seqComplex (fun i => f i ^ (n + 1))).sc j).isZero_homology_of_isZero_X₂ hz
  exact hH.eq_of_tgt _ _

/-- A transition map that vanishes on `H_j` still vanishes after being prolonged to a higher
power, because it factors through the shorter transition. -/
private theorem koszulPowerTransition_homologyMap_eq_zero_of_le
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (m m' n : ℕ) (h : n ≤ m) (h' : m ≤ m') (hmn : n ≤ m') (j : ℕ)
    (hz : HomologicalComplex.homologyMap (koszulPowerTransition f m n h) j = 0) :
    HomologicalComplex.homologyMap (koszulPowerTransition f m' n hmn) j = 0 := by
  have hcomp : koszulPowerTransition f m' n hmn =
      koszulPowerTransition f m' m h' ≫ koszulPowerTransition f m n h :=
    (koszulPowerTransition_comp f m' m n h' h).symm
  rw [hcomp, HomologicalComplex.homologyMap_comp, hz, comp_zero]

/-- Over a Noetherian ring one single later power kills the homology of the transition map in
**all** positive degrees simultaneously, and it may be taken strictly larger than the given one.
Only the degrees `1, …, r` need attention, the rest being zero by
`koszulPowerTransition_homologyMap_eq_zero_of_lt`, so a finite supremum suffices. -/
private theorem exists_koszulPowerTransition_homologyMap_eq_zero_all_pos
    {R : Type u} [CommRing R] [IsNoetherianRing R] {r : ℕ} (f : Fin r → R) (n : ℕ) :
    ∃ m : ℕ, n < m ∧ ∀ j : ℕ, 0 < j → ∃ h : n ≤ m,
      HomologicalComplex.homologyMap (koszulPowerTransition f m n h) j = 0 := by
  classical
  have hex : ∀ j : ℕ, ∃ m : ℕ, ∃ h : n ≤ m, 0 < j →
      HomologicalComplex.homologyMap (koszulPowerTransition f m n h) j = 0 := by
    intro j
    by_cases hj : 0 < j
    · obtain ⟨m, h, hm⟩ := koszulPowerTransition_homologyMap_eq_zero_pos f n j hj
      exact ⟨m, h, fun _ => hm⟩
    · exact ⟨n, le_refl n, fun hj' => absurd hj' hj⟩
  choose g hg hgz using hex
  have hnm : n ≤ max (n + 1) ((Finset.range (r + 1)).sup g) :=
    (Nat.le_succ n).trans (le_max_left _ _)
  refine ⟨max (n + 1) ((Finset.range (r + 1)).sup g),
    (Nat.lt_succ_self n).trans_le (le_max_left _ _), fun j hj => ⟨hnm, ?_⟩⟩
  by_cases hjr : r < j
  · exact koszulPowerTransition_homologyMap_eq_zero_of_lt f _ n hnm j hjr
  · have hgj : g j ≤ max (n + 1) ((Finset.range (r + 1)).sup g) :=
      (Finset.le_sup (Finset.mem_range.2 (by omega))).trans (le_max_right _ _)
    exact koszulPowerTransition_homologyMap_eq_zero_of_le f (g j) _ n (hg j) hgj hnm j
      (hgz j hj)

/-- **The chain-level form of Stacks 0921.** Over a Noetherian ring, for every starting power `n`
and every length `k` there is a strictly increasing chain `n = c 0 < c 1 < ⋯` of powers along
which each successive Koszul transition map `K_{c (i+1)} → K_{c i}` induces the zero map on
homology in every positive degree.

This is the input to Tag 0GZ4, where the chain `n_r > ⋯ > n_1 > n_0 = n` is used to lift a Tate
resolution to the Koszul algebras: at stage `m` of the tower a cycle is pushed into
`K_{c (k - m)}`, where it becomes a boundary precisely because the transition out of
`K_{c (k - m + 1)}` is zero on positive homology.

As elsewhere in this file the index `i` stands for the exponent `i + 1`, so `c i` names the
Koszul algebra on the sequence `fun i => f i ^ (c i + 1)`. -/
public theorem exists_chain_koszulPowerTransition_homologyMap_eq_zero
    {R : Type u} [CommRing R] [IsNoetherianRing R] {r : ℕ} (f : Fin r → R) (n k : ℕ) :
    ∃ c : ℕ → ℕ, c 0 = n ∧ StrictMono c ∧
      ∀ i ≤ k, ∀ j : ℕ, 0 < j → ∃ h : c i ≤ c (i + 1),
        HomologicalComplex.homologyMap (koszulPowerTransition f (c (i + 1)) (c i) h) j = 0 := by
  choose g hg1 hg2 using exists_koszulPowerTransition_homologyMap_eq_zero_all_pos f
  refine ⟨fun i => Nat.rec n (fun _ x => g x) i, rfl,
    strictMono_nat_of_lt_succ fun i => ?_, fun i _ j hj => ?_⟩
  · exact hg1 _
  · exact hg2 _ j hj

/-! ### From the vanishing of a homology map to boundaries of elements

Tag 0GZ4 consumes Stacks 0921 one *element* at a time: at each stage of the Tate tower it has a
cycle of the Koszul algebra on the higher power and needs a primitive for its image in the Koszul
algebra on the lower power. The vanishing of `HomologicalComplex.homologyMap` is turned into that
statement by `moduleCat_mem_range_d_of_homologyMap_eq_zero`, which says exactly that a cycle is
carried into the image of the differential, and the result is then read off in the exterior
algebra rather than in the subtypes `⋀ⁿ(Rʳ)` that the Koszul complex has for its terms.

The bridge to the exterior algebra is `koszulPowerTransition_f_val`: the degree-`j` component of
the transition map is the restriction of `ExteriorAlgebra.map` of the diagonal endomorphism
`x ↦ (fun i => fᵢ^(m-n)) * x` of `Rʳ`. Both maps are linear and agree on the wedges of `j`
vectors, which span `⋀ʲ(Rʳ)`; on those, the formula for the transition map is
`koszulPowerTransition_apply_ιMulti`. -/

/-- **A cycle of a complex of modules is carried into the image of the differential by any chain
map whose induced map on homology in that degree vanishes.** This is the element-level content of
`HomologicalComplex.homologyMap φ i = 0`, obtained by factoring
`homologyπ ≫ homologyMap φ ≫ homologyι` as `iCycles ≫ φ.f i ≫ pOpcycles` and using the explicit
description of the opcycles of a short complex of modules as a quotient by the range. -/
public theorem moduleCat_mem_range_d_of_homologyMap_eq_zero
    {R : Type u} [CommRing R] {ι : Type*} {c : ComplexShape ι}
    {K L : HomologicalComplex (ModuleCat.{u} R) c} (φ : K ⟶ L) (i : ι)
    (h : HomologicalComplex.homologyMap φ i = 0)
    {x : K.X i} (hx : K.d i (c.next i) x = 0) :
    φ.f i x ∈ LinearMap.range (L.d (c.prev i) i).hom := by
  have hzero : K.iCycles i ≫ φ.f i ≫ L.pOpcycles i = 0 := by
    have h1 : K.homologyπ i ≫ HomologicalComplex.homologyMap φ i ≫ L.homologyι i =
        K.iCycles i ≫ φ.f i ≫ L.pOpcycles i := by
      rw [← Category.assoc, HomologicalComplex.homologyπ_naturality, Category.assoc,
        HomologicalComplex.homology_π_ι, ← Category.assoc,
        HomologicalComplex.cyclesMap_i, Category.assoc]
    rw [← h1, h, zero_comp, comp_zero]
  obtain ⟨y, hiy⟩ : ∃ y : ↑(K.cycles i), K.iCycles i y = x :=
    ⟨(K.sc i).moduleCatCyclesIso.inv ⟨x, hx⟩,
      (K.sc i).moduleCatCyclesIso_inv_iCycles_apply ⟨x, hx⟩⟩
  have h2 : L.pOpcycles i (φ.f i (K.iCycles i y)) = 0 := by
    rw [← CategoryTheory.comp_apply, ← CategoryTheory.comp_apply, hzero]
    simp
  rw [hiy] at h2
  exact ((L.sc i).moduleCat_pOpcycles_eq_zero_iff (φ.f i x)).1 h2

/-- **The degree-`j` component of the Koszul transition map is `ExteriorAlgebra.map` of the
diagonal endomorphism `x ↦ (fun i => fᵢ^(m-n)) * x` of `Rʳ`.** The endomorphism is written
`LinearMap.mulLeft R`, which is multiplication for the componentwise algebra structure of `Rʳ`,
that is the diagonal matrix with entries `fᵢ^(m-n)`. -/
public theorem koszulPowerTransition_f_val {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R)
    (m n : ℕ) (h : n ≤ m) (j : ℕ) (x : ↥(⋀[R]^j (Fin r → R))) :
    Subtype.val ((koszulPowerTransition f m n h).f j x) =
      ExteriorAlgebra.map (LinearMap.mulLeft R (fun i => f i ^ (m - n))) (x : _) := by
  have key : ((⋀[R]^j (Fin r → R)).subtype ∘ₗ
        (show ↥(⋀[R]^j (Fin r → R)) →ₗ[R] ↥(⋀[R]^j (Fin r → R)) from
          ((koszulPowerTransition f m n h).f j).hom)) =
      (ExteriorAlgebra.map (LinearMap.mulLeft R (fun i => f i ^ (m - n)))).toLinearMap ∘ₗ
        (⋀[R]^j (Fin r → R)).subtype := by
    refine LinearMap.ext_on (exteriorPower.ιMulti_span R j (Fin r → R)) ?_
    rintro _ ⟨v, rfl⟩
    have hformula := koszulPowerTransition_apply_ιMulti f m n h j v
    change Subtype.val ((koszulPowerTransition f m n h).f j
        (exteriorPower.ιMulti R j v : ↥(⋀[R]^j (Fin r → R)))) = _
    rw [show (exteriorPower.ιMulti R j v : ↥(⋀[R]^j (Fin r → R))) =
      ⟨ExteriorAlgebra.ιMulti R j v, Koszul.ιMulti_mem j v⟩ from rfl]
    rw [hformula]
    change ExteriorAlgebra.ιMulti R j (fun k i => f i ^ (m - n) * v k i) =
      ExteriorAlgebra.map (LinearMap.mulLeft R (fun i => f i ^ (m - n)))
        (ExteriorAlgebra.ιMulti R j v)
    rw [ExteriorAlgebra.map_apply_ιMulti]
    rfl
  exact LinearMap.congr_fun key x

/-- **The element-level form of Stacks 0921 that Tag 0GZ4 consumes.** If the Koszul transition
map from the `(m+1)`-st to the `(n+1)`-st powers vanishes on homology in degree `j + 1`, then
every element `z` of `⋀^(j+1)(Rʳ)` killed by the Koszul differential of the `(m+1)`-st powers has
the property that its image under the transition map — scaling the `i`-th generator by
`fᵢ^(m-n)` — is a boundary for the Koszul differential of the `(n+1)`-st powers, with a primitive
in `⋀^(j+2)(Rʳ)`.

This is the hypothesis `hdt` of
`DividedPowers.TateResolution.finiteTateStep_exists_gradedDPHom_comm_differential`: the chosen
primitive is the value given to the new variable of the next stage of the Tate tower. -/
public theorem exists_contraction_eq_map_mulLeft
    {R : Type u} [CommRing R] {r : ℕ} (f : Fin r → R) (m n j : ℕ) (h : n ≤ m)
    (hvan : HomologicalComplex.homologyMap (koszulPowerTransition f m n h) (j + 1) = 0)
    {z : ExteriorAlgebra R (Fin r → R)} (hz : z ∈ ⋀[R]^(j + 1) (Fin r → R))
    (hdz : Koszul.contraction (Koszul.seqDual (fun i => f i ^ (m + 1))) z = 0) :
    ∃ w, w ∈ ⋀[R]^(j + 2) (Fin r → R) ∧
      ExteriorAlgebra.map (LinearMap.mulLeft R (fun i => f i ^ (m - n))) z =
        Koszul.contraction (Koszul.seqDual (fun i => f i ^ (n + 1))) w := by
  have hnext : (ComplexShape.down ℕ).next (j + 1) = j :=
    (ComplexShape.down ℕ).next_eq' (by simp [ComplexShape.down])
  have hprev : (ComplexShape.down ℕ).prev (j + 1) = j + 2 :=
    (ComplexShape.down ℕ).prev_eq' (by simp [ComplexShape.down])
  have hx : (Koszul.seqComplex (fun i => f i ^ (m + 1))).d (j + 1)
      ((ComplexShape.down ℕ).next (j + 1))
      (show ↥(⋀[R]^(j + 1) (Fin r → R)) from ⟨z, hz⟩) = 0 := by
    rw [hnext, Koszul.seqComplex_d]
    refine Subtype.ext ?_
    change Koszul.contraction (Koszul.seqDual (fun i => f i ^ (m + 1))) z = 0
    exact hdz
  have hmem := moduleCat_mem_range_d_of_homologyMap_eq_zero
    (koszulPowerTransition f m n h) (j + 1) hvan hx
  rw [hprev, Koszul.seqComplex_d] at hmem
  obtain ⟨u, hu⟩ := hmem
  refine ⟨Subtype.val (show ↥(⋀[R]^(j + 2) (Fin r → R)) from u), ?_, ?_⟩
  · exact (show ↥(⋀[R]^(j + 2) (Fin r → R)) from u).2
  · have hu' := congrArg (fun y => Subtype.val (show ↥(⋀[R]^(j + 1) (Fin r → R)) from y)) hu
    simp only at hu'
    rw [koszulPowerTransition_f_val f m n h (j + 1) ⟨z, hz⟩] at hu'
    exact hu'.symm

end NoetherianKoszulProIso

end
