/-!
# The derived completion adjunction and the category of derived complete modules

Let `A` be a commutative ring and `I ⊂ A` an ideal generated by `r` elements. Derived completion
along `I` — any left adjoint to the inclusion of the full subcategory of derived complete objects
of `D(A)` — has cohomological amplitude contained in `[-r, 0]`. Consequently the full subcategory
of derived complete `A`-modules is abelian with all limits, its inclusion into `A`-modules is
exact and preserves limits, and when `I` is finitely generated the subcategory also has all
colimits and the inclusion admits a left adjoint.

## Main results

* `CompletionAdjunction.derivedCompletion_finiteCohomologicalDimension` gives the upper and lower
  cohomological bounds for derived completion along an ideal generated by a finite family.
* `CompletionAdjunction.derivedCompleteModules_abelian_hasLimits_exact_hasColimits` records the
  categorical properties of the category of derived complete modules.
* `CompletionAdjunction.isDerivedComplete_isTriangulated`: the derived complete objects form a
  triangulated subcategory of `D(A)`.

## Implementation notes

An ideal generated by `r` elements is presented as the span of the range of a map `Fin r → A`, and
derived completion is an arbitrary left adjoint to the inclusion of the full subcategory of
derived complete objects. The category of derived complete modules is the full subcategory of
`ModuleCat A` cut out by `IsDerivedCompleteModule`. Exactness of the inclusion is expressed as
preservation of finite limits and finite colimits.

## References

* [The Stacks Project, Tag 0AAJ](https://stacks.math.columbia.edu/tag/0AAJ)
* [The Stacks Project, Tag 0ARD](https://stacks.math.columbia.edu/tag/0ARD)
* [The Stacks Project, Tag 0GLP](https://stacks.math.columbia.edu/tag/0GLP)
* [Bhatt--Scholze, *Projectivity of the Witt vector affine Grassmannian*][BS]
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated ZeroObject
  MonoidalCategory

attribute [local instance] HasDerivedCategory.standard

universe u v w

namespace CompletionAdjunction

/-! ### Amplitude of the Koszul-power tower -/

section Amplitude

variable {A : Type u} [CommRing A]

/-- The inverse system `K ⊗ᴸ Kₙ`, where `Kₙ` is the Koszul complex on the `(n + 1)`-st powers of
a finite family. -/
private noncomputable abbrev koszulTensorTower {r : ℕ} (f : Fin r → A)
    (T : CochainComplex.DerivedTensor.DerivedTensorProduct A)
    (K : DerivedCategory (ModuleCat.{u} A)) :
    ℕᵒᵖ ⥤ DerivedCategory (ModuleCat.{u} A) :=
  AdicKoszul.canonicalKoszulPowerSystem f ⋙ T.tensor.obj K

/-- The inclusion of the top nonzero term of a complex, placed in its degree. -/
private noncomputable def singleTopHom {C : Type u} [Category.{v} C] [Abelian C] (t : ℤ)
    (P : CochainComplex C ℤ) (hP : ∀ i, t < i → IsZero (P.X i)) :
    (HomologicalComplex.single C (.up ℤ) t).obj (P.X t) ⟶ P :=
  HomologicalComplex.mkHomFromSingle (𝟙 _) fun i hi ↦
    (hP i (by change t + 1 = i at hi; omega)).eq_of_tgt _ _

/-- The cokernel of the inclusion of the top term of a complex is short exact and vanishes under a
homological functor, given the vanishing of the lower terms and an inductive hypothesis. -/
private lemma singleTopHom_shortExact_isZero
    {C : Type u} [Category.{v} C] [Abelian C]
    {B : Type w} [Category B] [Abelian B]
    (H : DerivedCategory C ⥤ B) [H.IsHomological]
    (n : ℕ) (t : ℤ) (P : CochainComplex C ℤ)
    (hP : ∀ i, t < i → IsZero (P.X i))
    (hlow : ∀ i, i < t - n → IsZero (P.X i))
    (hH : ∀ i, t - n ≤ i → i < t →
      IsZero (H.obj ((DerivedCategory.singleFunctor C i).obj (P.X i))))
    (ih : ∀ P' : CochainComplex C ℤ, (∀ i, i < t - n ∨ t ≤ i → IsZero (P'.X i)) →
      (∀ i, t - n ≤ i → i < t →
        IsZero (H.obj ((DerivedCategory.singleFunctor C i).obj (P'.X i)))) →
      IsZero (H.obj (DerivedCategory.Q.obj P'))) :
    (ShortComplex.cokernelSequence (singleTopHom t P hP)).ShortExact ∧
      IsZero (H.obj (DerivedCategory.Q.obj (cokernel (singleTopHom t P hP)))) := by
  let s := singleTopHom t P hP
  have hs : IsIso (s.f t) := by
    dsimp [s, singleTopHom]
    rw [HomologicalComplex.mkHomFromSingle_f, Category.comp_id]
    infer_instance
  have hsmono : Mono s := HomologicalComplex.mono_of_mono_f s (fun i ↦ by
    by_cases hi : i = t
    · subst i; infer_instance
    · exact (HomologicalComplex.isZero_single_obj_X _ _ _ _ hi).mono _)
  let S := ShortComplex.cokernelSequence s
  have : Mono S.f := hsmono
  have hS : S.ShortExact := ⟨ShortComplex.cokernelSequence_exact s⟩
  have hSi (i : ℤ) := hS.map_of_exact (HomologicalComplex.eval C (.up ℤ) i)
  have hz : IsZero ((cokernel s).X t) := (hSi t).isIso_f_iff.mp hs
  have hi (i : ℤ) (hit : i ≠ t) : IsIso ((cokernel.π s).f i) :=
    (hSi i).isIso_g_iff.mpr (HomologicalComplex.isZero_single_obj_X (.up ℤ) t (P.X t) i hit)
  refine ⟨hS, ih _ (fun i h ↦ ?_) (fun i h₁ h₂ ↦ ?_)⟩
  · by_cases hit : i = t
    · subst i; exact hz
    · have := hi i hit
      exact (h.elim (hlow i) fun h' ↦ hP i (by omega)).of_iso
        (asIso ((cokernel.π s).f i)).symm
  · have := hi i (by omega)
    exact (hH i h₁ h₂).of_iso
      (H.mapIso ((DerivedCategory.singleFunctor C i).mapIso
        (asIso ((cokernel.π s).f i)))).symm

/-- A homological functor vanishes on a bounded complex if it vanishes on its terms placed in
their respective degrees. -/
private lemma isZero_of_bounded_single
    {C : Type u} [Category.{v} C] [Abelian C]
    {B : Type w} [Category B] [Abelian B]
    (H : DerivedCategory C ⥤ B) [H.IsHomological]
    (n : ℕ) (b : ℤ) (P : CochainComplex C ℤ)
    (hP : ∀ i, i < b - n ∨ b ≤ i → IsZero (P.X i))
    (hH : ∀ i, b - n ≤ i → i < b →
      IsZero (H.obj ((DerivedCategory.singleFunctor C i).obj (P.X i)))) :
    IsZero (H.obj (DerivedCategory.Q.obj P)) := by
  induction n generalizing b P with
  | zero =>
    apply (DerivedCategory.Q ⋙ H).map_isZero
    apply (IsZero.iff_id_eq_zero _).2
    ext i
    exact (hP i (by omega)).eq_of_src _ _
  | succ n ih =>
    obtain ⟨hS, hquot⟩ := singleTopHom_shortExact_isZero H n (b - 1) P
      (fun i hi ↦ hP i (Or.inr (by omega)))
      (fun i hi ↦ hP i (Or.inl (by push_cast at *; omega)))
      (fun i h₁ h₂ ↦ hH i (by push_cast at *; omega) (by omega)) (ih (b - 1))
    exact (H.map_distinguished_exact _
      (DerivedCategory.triangleOfSES_distinguished hS)).isZero_of_both_isZero
        (hH (b - 1) (by omega) (by omega)) hquot

/-- An additive functor vanishing on the ring vanishes on every finite free module. -/
private lemma isZero_obj_of_basis
    {A : Type u} [Ring A] {B : Type v} [Category B] [Preadditive B]
    (G : ModuleCat.{u} A ⥤ B) [G.Additive]
    (hG : IsZero (G.obj (ModuleCat.of A A)))
    (M : ModuleCat.{u} A) {ι : Type w} [Finite ι] (b : Module.Basis ι A M) :
    IsZero (G.obj M) := by
  classical
  let := Fintype.ofFinite ι
  let p (i : ι) : M ⟶ ModuleCat.of A A := ModuleCat.ofHom (b.coord i)
  let q (i : ι) : ModuleCat.of A A ⟶ M :=
    ModuleCat.ofHom (LinearMap.toSpanSingleton A M (b i))
  have hid : 𝟙 M = ∑ i, p i ≫ q i := by
    ext x
    simp [p, q]
  rw [IsZero.iff_id_eq_zero, ← G.map_id, hid, G.map_sum]
  apply Finset.sum_eq_zero
  intro i _
  rw [G.map_comp, hG.eq_of_src (G.map (q i)) 0, comp_zero]

/-- Tensoring with the ring placed in degree `i` shifts cohomological degrees by `i`. -/
private lemma isZero_homology_tensor_single
    {A : Type u} [CommRing A] (T : CochainComplex.DerivedTensor.DerivedTensorProduct A)
    (K : DerivedCategory (ModuleCat.{u} A)) (i j : ℤ)
    (hK : IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) (j - i)).obj K)) :
    IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) j).obj
      ((T.tensor.obj K).obj
        ((DerivedCategory.singleFunctor (ModuleCat.{u} A) i).obj (ModuleCat.of A A)))) := by
  let F := T.tensor.obj K
  let e : F.obj ((DerivedCategory.singleFunctor (ModuleCat.{u} A) i).obj
      (ModuleCat.of A A)) ≅ K⟦-i⟧ :=
    F.mapIso (((DerivedCategory.singleFunctors (ModuleCat.{u} A)).shiftIso
      (-i) i 0 (by omega)).app (ModuleCat.of A A)).symm ≪≫
      (F.commShiftIso (-i)).app _ ≪≫
      (shiftFunctor _ (-i)).mapIso (T.rightUnitor.app K)
  apply IsZero.of_iso hK
  exact (DerivedCategory.homologyFunctor _ j).mapIso e ≪≫
    ((DerivedCategory.homologyFunctor _ 0).shiftIso (-i) j (j - i) (by omega)).app K

/-- The Koszul complex on `r` elements is concentrated in degrees `[-r, 0]`. -/
private lemma isZero_koszul_X
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) (i : ℤ)
    (hi : i < -(r : ℤ) ∨ 0 < i) :
    IsZero (((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} A)).obj
      (Koszul.seqComplex f)).X i) := by
  by_cases hi₀ : i ≤ 0
  · let j := (-i).toNat
    have hj : ComplexShape.embeddingDownNat.f j = i := by
      show -(j : ℤ) = i
      dsimp [j]
      omega
    apply IsZero.of_iso _ (HomologicalComplex.extendXIso _ _ hj)
    show IsZero (ModuleCat.of A (⋀[A]^j (Fin r → A)))
    have := exteriorPower.subsingleton_of_span_eq_top_of_card_lt
      (Pi.basisFun A (Fin r)) (Pi.basisFun A (Fin r)).span_eq j
      (by simp only [Nat.card_fin]; dsimp [j]; omega)
    exact ModuleCat.isZero_of_subsingleton _
  · apply HomologicalComplex.isZero_extend_X
    intro j
    show -(j : ℤ) ≠ i
    omega

/-- The exterior powers in a Koszul complex are finite free, so vanishing on the ring implies
vanishing on each term in the same degree. -/
private lemma isZero_single_koszul_X
    {A : Type u} [CommRing A] {B : Type v} [Category B] [Preadditive B]
    (H : DerivedCategory (ModuleCat.{u} A) ⥤ B) [H.Additive]
    {r : ℕ} (f : Fin r → A) (i : ℤ) (hi : i ≤ 0)
    (hH : IsZero (H.obj ((DerivedCategory.singleFunctor (ModuleCat.{u} A) i).obj
      (ModuleCat.of A A)))) :
    IsZero (H.obj ((DerivedCategory.singleFunctor (ModuleCat.{u} A) i).obj
      (((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} A)).obj
        (Koszul.seqComplex f)).X i))) := by
  let j := (-i).toNat
  have hj : ComplexShape.embeddingDownNat.f j = i := by
    show -(j : ℤ) = i
    dsimp [j]
    omega
  apply IsZero.of_iso _ (H.mapIso ((DerivedCategory.singleFunctor _ i).mapIso
    (HomologicalComplex.extendXIso _ _ hj)))
  exact isZero_obj_of_basis (DerivedCategory.singleFunctor _ i ⋙ H) hH _
    ((Pi.basisFun A (Fin r)).exteriorPower j)

/-- A homological functor vanishing on the ring in degrees `[-r, 0]` vanishes on the Koszul
complex. -/
private lemma isZero_homological_koszul
    {A : Type u} [CommRing A] {B : Type v} [Category B] [Abelian B]
    (H : DerivedCategory (ModuleCat.{u} A) ⥤ B) [H.IsHomological]
    {r : ℕ} (f : Fin r → A)
    (hH : ∀ i : ℤ, -(r : ℤ) ≤ i → i ≤ 0 →
      IsZero (H.obj ((DerivedCategory.singleFunctor (ModuleCat.{u} A) i).obj
        (ModuleCat.of A A)))) :
    IsZero (H.obj (DerivedCategory.Q.obj
      ((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} A)).obj
        (Koszul.seqComplex f)))) := by
  apply isZero_of_bounded_single H (r + 1) 1
  · intro i hi
    exact isZero_koszul_X f i (by omega)
  · intro i hi₁ hi₂
    exact isZero_single_koszul_X H f i (by omega) (hH i (by omega) (by omega))

/-- A morphism that is invertible in the highest degree induces an epimorphism under a homological
functor when the lower terms of its target vanish under that functor. -/
private lemma epi_map_of_bounded_single
    {C : Type u} [Category.{v} C] [Abelian C]
    {B : Type w} [Category B] [Abelian B]
    (H : DerivedCategory C ⥤ B) [H.IsHomological]
    (n : ℕ) (b : ℤ) {P Q : CochainComplex C ℤ} (φ : P ⟶ Q)
    (hP : ∀ i, b < i → IsZero (P.X i))
    (hQ : ∀ i, i < b - n ∨ b < i → IsZero (Q.X i))
    (hH : ∀ i, b - n ≤ i → i < b →
      IsZero (H.obj ((DerivedCategory.singleFunctor C i).obj (Q.X i))))
    [IsIso (φ.f b)] : Epi (H.map (DerivedCategory.Q.map φ)) := by
  have hQ' (i : ℤ) (hi : b < i) : IsZero (Q.X i) := hQ i (Or.inr hi)
  let s := singleTopHom b Q hQ'
  obtain ⟨hS, hquot⟩ := singleTopHom_shortExact_isZero H n b Q hQ'
    (fun i hi ↦ hQ i (Or.inl hi)) hH (isZero_of_bounded_single H n b)
  have hepi : Epi (H.map (DerivedCategory.Q.map s)) :=
    (H.map_distinguished_exact _ (DerivedCategory.triangleOfSES_distinguished hS)).epi_f
      (hquot.eq_of_tgt _ _)
  let t : (HomologicalComplex.single C (.up ℤ) b).obj (Q.X b) ⟶ P :=
    HomologicalComplex.mkHomFromSingle (inv (φ.f b)) (fun i hi ↦ by
      apply (hP i (by change b + 1 = i at hi; omega)).eq_of_tgt)
  have ht : t ≫ φ = s := by
    apply HomologicalComplex.from_single_hom_ext
    simp [t, s, singleTopHom, HomologicalComplex.mkHomFromSingle_f]
  exact epi_of_epi_fac (show (H.map (DerivedCategory.Q.map t)) ≫
      H.map (DerivedCategory.Q.map φ) = H.map (DerivedCategory.Q.map s) by
    rw [← H.map_comp, ← DerivedCategory.Q.map_comp, ht])

/-- Tensoring with a term of the Koszul-power tower preserves an upper cohomological bound. -/
private lemma koszulTensorTower_isLE
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (T : CochainComplex.DerivedTensor.DerivedTensorProduct A)
    (K : DerivedCategory (ModuleCat.{u} A)) (b : ℤ) (hK : K.IsLE b) (n : ℕ) :
    ((koszulTensorTower f T K).obj ⟨n⟩).IsLE b := by
  rw [DerivedCategory.isLE_iff]
  intro j hj
  apply isZero_homological_koszul (T.tensor.obj K ⋙ DerivedCategory.homologyFunctor _ j)
  intro i _ hi
  exact isZero_homology_tensor_single T K i j
    ((DerivedCategory.isLE_iff K b).mp hK _ (by omega))

/-- Tensoring with a term of the Koszul-power tower lowers a lower cohomological bound by at most
the number of generators. -/
private lemma koszulTensorTower_isGE
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (T : CochainComplex.DerivedTensor.DerivedTensorProduct A)
    (K : DerivedCategory (ModuleCat.{u} A)) (a : ℤ) (hK : K.IsGE a) (n : ℕ) :
    ((koszulTensorTower f T K).obj ⟨n⟩).IsGE (a - (r : ℤ)) := by
  rw [DerivedCategory.isGE_iff]
  intro j hj
  apply isZero_homological_koszul (T.tensor.obj K ⋙ DerivedCategory.homologyFunctor _ j)
  intro i hi _
  exact isZero_homology_tensor_single T K i j
    ((DerivedCategory.isGE_iff K a).mp hK _ (by omega))

/-- The Koszul-power transition maps are the identity in degree zero. -/
private lemma koszulPowerTransition_f_zero
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (m n : ℕ) (h : n ≤ m) :
    (AdicKoszul.koszulPowerTransition f m n h).f 0 = 𝟙 _ := by
  apply ModuleCat.hom_ext
  apply exteriorPower.linearMap_ext
  apply AlternatingMap.ext
  intro v
  have ht := (Classical.choose_spec (Classical.choose_spec (Classical.choose_spec
    (Classical.choose_spec (_root_.koszulPowerComplexes_form_inverseSystem f))))).2.2.2.2.1
      m n h 0 v
  show (AdicKoszul.koszulPowerTransition f m n h).f 0
    ⟨ExteriorAlgebra.ιMulti A 0 v, _⟩ = ⟨ExteriorAlgebra.ιMulti A 0 v, _⟩
  have hv : (fun (k : Fin 0) (i : Fin r) ↦ f i ^ (m - n) * v k i) = v :=
    funext fun k ↦ Fin.elim0 k
  simpa only [AdicKoszul.koszulPowerTransition, hv] using ht

/-- The transition maps of the Koszul-power tower are epimorphisms on boundary cohomology. -/
private lemma koszulTensorTower_boundary_epi
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (T : CochainComplex.DerivedTensor.DerivedTensorProduct A)
    (K : DerivedCategory (ModuleCat.{u} A)) (b : ℤ) (hK : K.IsLE b) (n : ℕ) :
    Epi ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) b).map
      ((koszulTensorTower f T K).map (homOfLE (Nat.le_succ n)).op)) := by
  let τ := AdicKoszul.koszulPowerTransition f (n + 1) n (Nat.le_succ n)
  have : IsIso (τ.f 0) := by
    dsimp [τ]
    rw [koszulPowerTransition_f_zero]
    show IsIso (𝟙 (ModuleCat.of A (⋀[A]^0 (Fin r → A))))
    infer_instance
  let φ := (ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} A)).map τ
  have : IsIso (φ.f 0) := by
    show IsIso ((HomologicalComplex.extendMap τ ComplexShape.embeddingDownNat).f 0)
    rw [HomologicalComplex.extendMap_f _ _ (show ComplexShape.embeddingDownNat.f 0 = 0 from rfl)]
    infer_instance
  show Epi ((T.tensor.obj K ⋙ DerivedCategory.homologyFunctor (ModuleCat.{u} A) b).map
    ((AdicKoszul.canonicalKoszulPowerSystem f).map (homOfLE (Nat.le_succ n)).op))
  rw [Functor.ofOpSequence_map_homOfLE_succ]
  apply epi_map_of_bounded_single _ r 0 φ
  · intro i hi
    exact isZero_koszul_X _ i (Or.inr hi)
  · intro i hi
    exact isZero_koszul_X _ i (by omega)
  · intro i hi₁ hi₂
    apply isZero_single_koszul_X
      (T.tensor.obj K ⋙ DerivedCategory.homologyFunctor (ModuleCat.{u} A) b) _ i (by omega)
    exact isZero_homology_tensor_single T K i b
      ((DerivedCategory.isLE_iff K b).mp hK _ (by omega))

/-- The difference map on products of a tower of epimorphisms of modules is an epimorphism. -/
private lemma epi_pi_lift_sub
    {A : Type u} [Ring A] (X : ℕ → ModuleCat.{u} A)
    (τ : ∀ n, X (n + 1) ⟶ X n) (hτ : ∀ n, Epi (τ n)) :
    Epi (Pi.lift fun n ↦ Pi.π X n - Pi.π X (n + 1) ≫ τ n) := by
  classical
  let e := ModuleCat.piIsoPi X
  let δ := Pi.lift fun n ↦ Pi.π X n - Pi.π X (n + 1) ≫ τ n
  choose s hs using fun n ↦ ((ModuleCat.epi_iff_surjective (τ n)).mp (hτ n)).hasRightInverse
  apply (ModuleCat.epi_iff_surjective δ).mpr
  intro y
  let v : ∀ n, X n := Nat.rec 0 (fun n x ↦ s n (x - (Pi.π X n) y))
  refine ⟨e.inv v, ?_⟩
  apply (ModuleCat.mono_iff_injective e.hom).mp inferInstance
  funext n
  have he (z : ↑(∏ᶜ X)) : e.hom z n = (Pi.π X n) z :=
    congrArg (fun f ↦ (ConcreteCategory.hom f) z) (ModuleCat.piIsoPi_hom_ker_subtype X n)
  rw [he, he, ← ModuleCat.comp_apply, Pi.lift_π]
  show (Pi.π X n) (e.inv v) - (τ n) ((Pi.π X (n + 1)) (e.inv v)) = (Pi.π X n) y
  have hv (k : ℕ) : (Pi.π X k) (e.inv v) = v k := by
    rw [← ModuleCat.comp_apply, ModuleCat.piIsoPi_inv_kernel_ι]
    rfl
  rw [hv, hv]
  show v n - (τ n) (s n (v n - (Pi.π X n) y)) = (Pi.π X n) y
  rw [hs n]
  abel

/-- A degree of a derived limit vanishes when it vanishes termwise and the maps one degree below
are epimorphisms, so that the `R¹lim` contribution disappears. -/
private lemma isZero_homology_derivedLimit
    {A : Type u} [Ring A] (F : ℕᵒᵖ ⥤ DerivedCategory (ModuleCat.{u} A))
    [HasProduct fun n : ℕ ↦ F.obj ⟨n⟩]
    (L : DerivedCategory (ModuleCat.{u} A)) (hL : IsDerivedLimit F L) (i : ℤ)
    (hzero : ∀ n : ℕ, IsZero
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj (F.obj ⟨n⟩)))
    (hepi : ∀ n : ℕ, Epi
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) (i - 1)).map
        (F.map (homOfLE (Nat.le_succ n)).op))) :
    IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj L) := by
  obtain ⟨a, b, _, h⟩ := DerivedCategory.isDerivedLimit_homology_shortExact F L hL
  obtain ⟨e, k, q, w, _, _, _, hS⟩ := h i
  apply hS.exact.isZero_of_both_isZero
  · have := epi_pi_lift_sub
      (fun n : ℕ ↦ (DerivedCategory.homologyFunctor (ModuleCat.{u} A) (i - 1)).obj (F.obj ⟨n⟩))
      (fun n ↦ (DerivedCategory.homologyFunctor (ModuleCat.{u} A) (i - 1)).map
        (F.map (homOfLE (Nat.le_succ n)).op)) hepi
    exact @isZero_cokernel_of_epi _ _ _ _ _ _ this _
  · exact (limit.isLimit _).isZero_pt (Functor.isZero _ (fun n ↦ hzero n.unop))

/-- Tensoring with the Koszul complexes on powers of `r` elements has amplitude `[-r, 0]`. For an
upper-bounded object, the maps on cohomology in the boundary degree are epimorphisms and the
derived inverse limit keeps the upper bound. A lower bound is shifted down by at most `r`, both
termwise and after taking the derived inverse limit. -/
private theorem koszulTensorTower_amplitude_and_derivedLimit_bounds
    (A : Type u) [CommRing A] {r : ℕ} (f : Fin r → A)
    (T : CochainComplex.DerivedTensor.DerivedTensorProduct A)
    (K L : DerivedCategory (ModuleCat.{u} A))
    [HasProduct fun n : ℕ ↦ (koszulTensorTower f T K).obj ⟨n⟩]
    (hL : IsDerivedLimit (koszulTensorTower f T K) L) :
    (∀ b : ℤ, K.IsLE b →
      (∀ n : ℕ, ((koszulTensorTower f T K).obj ⟨n⟩).IsLE b) ∧
      (∀ n : ℕ, Epi ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) b).map
        ((koszulTensorTower f T K).map (homOfLE (Nat.le_succ n)).op))) ∧
      L.IsLE b) ∧
    (∀ a : ℤ, K.IsGE a →
      (∀ n : ℕ, ((koszulTensorTower f T K).obj ⟨n⟩).IsGE (a - (r : ℤ))) ∧
      L.IsGE (a - (r : ℤ))) := by
  constructor
  · intro b hK
    refine ⟨koszulTensorTower_isLE f T K b hK, koszulTensorTower_boundary_epi f T K b hK, ?_⟩
    rw [DerivedCategory.isLE_iff]
    intro i hi
    apply isZero_homology_derivedLimit _ L hL i
    · intro n
      exact (DerivedCategory.isLE_iff _ b).mp (koszulTensorTower_isLE f T K b hK n) i hi
    · intro n
      by_cases h : i - 1 = b
      · subst b
        exact koszulTensorTower_boundary_epi f T K (i - 1) hK n
      · exact ((DerivedCategory.isLE_iff _ b).mp
          (koszulTensorTower_isLE f T K b hK n) (i - 1) (by omega)).epi _
  · intro a hK
    refine ⟨koszulTensorTower_isGE f T K a hK, ?_⟩
    rw [DerivedCategory.isGE_iff]
    intro i hi
    apply isZero_homology_derivedLimit _ L hL i
    · intro n
      exact (DerivedCategory.isGE_iff _ _).mp (koszulTensorTower_isGE f T K a hK n) i hi
    · intro n
      exact ((DerivedCategory.isGE_iff _ _).mp
        (koszulTensorTower_isGE f T K a hK n) (i - 1) (by omega)).epi _

end Amplitude

/-! ### The derived complete objects form a triangulated subcategory -/

section Triangulated

/-- The derived complete objects form a triangulated subcategory of `D(A)`: they contain zero,
are closed under isomorphisms and shifts, and satisfy two-out-of-three in distinguished
triangles. -/
theorem isDerivedComplete_isTriangulated (A : Type u) [CommRing A] (I : Ideal A)
    [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A))] :
    (show ObjectProperty (DerivedCategory (ModuleCat.{u} A)) from
      fun K ↦ IsDerivedComplete I K).IsTriangulated := by
  let P : ObjectProperty (DerivedCategory (ModuleCat.{u} A)) :=
    fun K ↦ IsDerivedComplete I K
  have hP : P.IsClosedUnderIsomorphisms :=
    ⟨fun e hX ↦ DerivedCompleteRecurrence.isDerivedComplete_of_iso e hX⟩
  have hzero : P.ContainsZero := by
    refine ⟨⟨0, isZero_zero _, ?_⟩⟩
    intro a _
    refine isDerivedCompleteAt_of_isNilpotent (L := (0 : DerivedCategory (ModuleCat.{u} A)))
      ⟨1, ?_⟩
    rw [pow_one]
    exact (isZero_zero (DerivedCategory (ModuleCat.{u} A))).eq_of_src _ _
  have hshift : P.IsStableUnderShift ℤ :=
    ⟨fun n ↦ ⟨fun X hX ↦ isDerivedComplete_shift I hX n⟩⟩
  have hext : P.IsTriangulatedClosed₂ := .mk' fun T hT h₁ h₃ a ha ↦
    isDerivedCompleteAt_of_distTriang (rot_of_distTriang T hT) (h₃ a ha)
      (isDerivedComplete_shift I h₁ 1 a ha)
  exact { }

end Triangulated

/-! ### Finite cohomological dimension of derived completion -/

section FiniteDimension

variable {A : Type u} [CommRing A]

/-- The cone of a morphism which is an epimorphism in degree `i` and a monomorphism in degree
`i + 1` vanishes in degree `i`. -/
private theorem cone_homology_isZero_of_epi_of_mono
    {B : Type u} [Category.{v} B] [Abelian B] [HasDerivedCategory.{w} B]
    (T : Triangle (DerivedCategory B)) (hT : T ∈ distTriang _)
    (i : ℤ) [Epi ((DerivedCategory.homologyFunctor B i).map T.mor₁)]
    [Mono ((DerivedCategory.homologyFunctor B (i + 1)).map T.mor₁)] :
    IsZero ((DerivedCategory.homologyFunctor B i).obj T.obj₃) := by
  apply (DerivedCategory.HomologySequence.exact₃ T hT i (i + 1)).isZero_of_both_zeros
  · exact (DerivedCategory.HomologySequence.epi_homologyMap_mor₁_iff T hT i).mp
      inferInstance
  · exact (DerivedCategory.HomologySequence.mono_homologyMap_mor₁_iff T hT i (i + 1)).mp
      inferInstance

/-- Vanishing of the cone in degree `i` makes the first map an epimorphism in degree `i`. -/
private theorem epi_homologyMap_of_isZero_cone
    {B : Type u} [Category.{v} B] [Abelian B] [HasDerivedCategory.{w} B]
    (T : Triangle (DerivedCategory B)) (hT : T ∈ distTriang _) (i : ℤ)
    (h : IsZero ((DerivedCategory.homologyFunctor B i).obj T.obj₃)) :
    Epi ((DerivedCategory.homologyFunctor B i).map T.mor₁) :=
  (DerivedCategory.HomologySequence.epi_homologyMap_mor₁_iff T hT i).mpr
    (h.eq_zero_of_tgt _)

/-- Vanishing of the cone in degree `i - 1` makes the first map a monomorphism in degree `i`. -/
private theorem mono_homologyMap_of_isZero_cone
    {B : Type u} [Category.{v} B] [Abelian B] [HasDerivedCategory.{w} B]
    (T : Triangle (DerivedCategory B)) (hT : T ∈ distTriang _) (i : ℤ)
    (h : IsZero ((DerivedCategory.homologyFunctor B (i - 1)).obj T.obj₃)) :
    Mono ((DerivedCategory.homologyFunctor B i).map T.mor₁) :=
  (DerivedCategory.HomologySequence.mono_homologyMap_mor₁_iff
    T hT (i - 1) i (by omega)).mpr (h.eq_zero_of_src _)

/-- Vanishing of the cone in degrees `i` and `i - 1` makes the first map an isomorphism in
degree `i`. -/
private theorem isIso_homologyMap_of_isZero_cone
    {B : Type u} [Category.{v} B] [Abelian B] [HasDerivedCategory.{w} B]
    (T : Triangle (DerivedCategory B)) (hT : T ∈ distTriang _) (i : ℤ)
    (h₁ : IsZero ((DerivedCategory.homologyFunctor B i).obj T.obj₃))
    (h₂ : IsZero ((DerivedCategory.homologyFunctor B (i - 1)).obj T.obj₃)) :
    IsIso ((DerivedCategory.homologyFunctor B i).map T.mor₁) :=
  have := epi_homologyMap_of_isZero_cone T hT i h₁
  have := mono_homologyMap_of_isZero_cone T hT i h₂
  isIso_of_mono_of_epi _

/-- The cone of a morphism which is an epimorphism on `H^i` and a monomorphism on `H^{i+1}` has
vanishing `H^i`. -/
public alias isZero_homologyFunctor_obj₃_of_epi_of_mono := cone_homology_isZero_of_epi_of_mono

/-- If the cone of a morphism has vanishing `H^i`, the morphism is an epimorphism on `H^i`. -/
public alias epi_homologyFunctor_map_mor₁_of_isZero := epi_homologyMap_of_isZero_cone

/-- Derived completion along an ideal generated by `r` elements preserves an upper cohomological
bound and lowers a lower bound by at most `r`. -/
private theorem completion_bounds (A : Type u) [CommRing A]
    {r : ℕ} (f : Fin r → A)
    (C : DerivedCategory (ModuleCat.{u} A) ⥤
      (show ObjectProperty (DerivedCategory (ModuleCat.{u} A)) from
        fun K ↦ IsDerivedComplete (Ideal.span (Set.range f)) K).FullSubcategory)
    (adj : C ⊣ (show ObjectProperty (DerivedCategory (ModuleCat.{u} A)) from
      fun K ↦ IsDerivedComplete (Ideal.span (Set.range f)) K).ι)
    (K : DerivedCategory (ModuleCat.{u} A)) :
    (∀ b : ℤ, K.IsLE b → (C.obj K).obj.IsLE b) ∧
    (∀ a : ℤ, K.IsGE a → (C.obj K).obj.IsGE (a - (r : ℤ))) := by
  let P : ObjectProperty (DerivedCategory (ModuleCat.{u} A)) :=
    fun K ↦ IsDerivedComplete (Ideal.span (Set.range f)) K
  let T := CochainComplex.DerivedTensor.canonicalDerivedTensorProduct (ULift.{u} A)
  obtain ⟨L, ⟨adjL⟩, hL⟩ :=
    AdicKoszulAdjunction.koszulPowerDerivedLimit_isLeftAdjoint A f T
  let F := AdicKoszul.moduleUniverseLift.{u, u} A
  let e := P.ι.mapIso ((adjL.leftAdjointUniq adj).app K)
  have hb := koszulTensorTower_amplitude_and_derivedLimit_bounds
    (ULift.{u} A) (fun i ↦ (ULift.up (f i) : ULift.{u} A)) T
    (F.mapDerivedCategory.obj K) (F.mapDerivedCategory.obj ((L ⋙ P.ι).obj K)) (hL K)
  have hz (X : DerivedCategory (ModuleCat.{u} A)) (i : ℤ) :=
    KoszulLiftReflectionAudit.isZero_homology_mapDerivedCategory_iff F X i
  constructor
  · intro b hK
    have hK' : (F.mapDerivedCategory.obj K).IsLE b := by
      rw [DerivedCategory.isLE_iff] at hK ⊢
      intro i hi
      exact (hz K i).mpr (hK i hi)
    have h := (hb.1 b hK').2.2
    rw [DerivedCategory.isLE_iff] at h ⊢
    intro i hi
    exact ((hz _ i).mp (h i hi)).of_iso
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).mapIso e.symm)
  · intro a hK
    have hK' : (F.mapDerivedCategory.obj K).IsGE a := by
      rw [DerivedCategory.isGE_iff] at hK ⊢
      intro i hi
      exact (hz K i).mpr (hK i hi)
    have h := (hb.2 a hK').2
    rw [DerivedCategory.isGE_iff] at h ⊢
    intro i hi
    exact ((hz _ i).mp (h i hi)).of_iso
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).mapIso e.symm)

/-- Derived completion along an ideal generated by `r` elements has cohomological amplitude
contained in `[-r, 0]`: it preserves isomorphisms in positive cohomological degrees and
epimorphisms in degree zero, and it sends isomorphisms in negative degrees together with a
monomorphism in degree zero to isomorphisms below degree `-r` and a monomorphism in degree `-r`. -/
@[stacks 0AAJ]
public theorem derivedCompletion_finiteCohomologicalDimension
    (A : Type u) [CommRing A]
    [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A))]
    {r : ℕ} (f : Fin r → A) :
    let P : ObjectProperty (DerivedCategory (ModuleCat.{u} A)) :=
      fun K ↦ IsDerivedComplete (Ideal.span (Set.range f)) K
    ∀ (C : DerivedCategory (ModuleCat.{u} A) ⥤ P.FullSubcategory),
      (C ⊣ P.ι) →
      ∀ {K L : DerivedCategory (ModuleCat.{u} A)} (φ : K ⟶ L),
        (((∀ i : ℤ, 1 ≤ i →
              IsIso ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).map φ)) ∧
            Epi ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) 0).map φ)) →
          ((∀ i : ℤ, 1 ≤ i →
              IsIso ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).map
                ((C ⋙ P.ι).map φ))) ∧
            Epi ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) 0).map
              ((C ⋙ P.ι).map φ)))) ∧
        (((∀ i : ℤ, i ≤ -1 →
              IsIso ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).map φ)) ∧
            Mono ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) 0).map φ)) →
          ((∀ i : ℤ, i ≤ -(r : ℤ) - 1 →
              IsIso ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).map
                ((C ⋙ P.ι).map φ))) ∧
            Mono ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) (-(r : ℤ))).map
              ((C ⋙ P.ι).map φ)))) := by
  intro P C adj K L φ
  have : P.IsTriangulated := isDerivedComplete_isTriangulated A (Ideal.span (Set.range f))
  let := adj.leftAdjointCommShift ℤ
  have := adj.commShift_of_rightAdjoint ℤ
  have : C.IsTriangulated := adj.isTriangulated_leftAdjoint
  let F := C ⋙ P.ι
  obtain ⟨Z, g, h, hT⟩ := distinguished_cocone_triangle φ
  let T := Triangle.mk φ g h
  have hFT : F.mapTriangle.obj T ∈ distTriang _ := F.map_distinguished T hT
  have hb := completion_bounds A f C adj Z
  constructor
  · intro hφ
    have hZ : Z.IsLE (-1) := by
      rw [DerivedCategory.isLE_iff]
      intro i hi
      have he : Epi ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).map φ) := by
        by_cases h0 : i = 0
        · subst i
          exact hφ.2
        · have := hφ.1 i (by omega)
          infer_instance
      have := hφ.1 (i + 1) (by omega)
      have : Epi ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).map T.mor₁) :=
        inferInstanceAs (Epi ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).map φ))
      have : Mono ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) (i + 1)).map T.mor₁) :=
        inferInstanceAs (Mono ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) (i + 1)).map φ))
      exact cone_homology_isZero_of_epi_of_mono T hT i
    have hFZ := (DerivedCategory.isLE_iff _ _).mp (hb.1 (-1) hZ)
    constructor
    · intro i hi
      exact isIso_homologyMap_of_isZero_cone (F.mapTriangle.obj T) hFT i (hFZ i (by omega))
        (hFZ (i - 1) (by omega))
    · exact epi_homologyMap_of_isZero_cone (F.mapTriangle.obj T) hFT 0
        (hFZ 0 (by omega))
  · intro hφ
    have hZ : Z.IsGE 0 := by
      rw [DerivedCategory.isGE_iff]
      intro i hi
      have := hφ.1 i (by omega)
      have hm : Mono ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) (i + 1)).map φ) := by
        by_cases h0 : i + 1 = 0
        · rw [h0]
          exact hφ.2
        · have := hφ.1 (i + 1) (by omega)
          infer_instance
      have : Epi ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).map T.mor₁) :=
        inferInstanceAs (Epi ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).map φ))
      have : Mono ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) (i + 1)).map T.mor₁) :=
        inferInstanceAs (Mono ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) (i + 1)).map φ))
      exact cone_homology_isZero_of_epi_of_mono T hT i
    have hFZ := (DerivedCategory.isGE_iff _ _).mp (hb.2 0 hZ)
    constructor
    · intro i hi
      exact isIso_homologyMap_of_isZero_cone (F.mapTriangle.obj T) hFT i (hFZ i (by omega))
        (hFZ (i - 1) (by omega))
    · exact mono_homologyMap_of_isZero_cone (F.mapTriangle.obj T) hFT (-(r : ℤ))
        (hFZ (-(r : ℤ) - 1) (by omega))

end FiniteDimension

/-! ### The category of derived complete modules -/

section CategoryOfCompleteModules

/-- A functor with universal arrows into it is a right adjoint. -/
private theorem isRightAdjoint_of_universalArrows
    {C D : Type*} [Category C] [Category D] (F : D ⥤ C)
    (h : ∀ X, ∃ Y, ∃ η : X ⟶ F.obj Y,
      ∀ Z, Function.Bijective (fun g : Y ⟶ Z ↦ η ≫ F.map g)) :
    F.IsRightAdjoint := by
  choose Y η hη using h
  let e := fun X Z ↦ Equiv.ofBijective (fun g : Y X ⟶ Z ↦ η X ≫ F.map g) (hη X Z)
  exact (Adjunction.adjunctionOfEquivLeft e
    (fun X Z Z' g f ↦ by simp [e, Functor.map_comp])).isRightAdjoint

/-- An upper-bounded object whose degree-zero cohomology lies in a full subcategory admits a
universal map to an object of that subcategory placed in degree zero. -/
private theorem exists_single_reflection
    {C : Type*} [Category C] [Abelian C] [HasDerivedCategory C]
    (P : ObjectProperty C) [P.IsClosedUnderIsomorphisms]
    (K : DerivedCategory C) [K.IsLE 0]
    (hK : P ((DerivedCategory.homologyFunctor C 0).obj K)) :
    ∃ N, P N ∧ ∃ q : K ⟶ (DerivedCategory.singleFunctor C 0).obj N,
      ∀ Z, Function.Bijective (fun g : (DerivedCategory.singleFunctor C 0).obj N ⟶
        (DerivedCategory.singleFunctor C 0).obj Z ↦ q ≫ g) := by
  let t := DerivedCategory.TStructure.t (C := C)
  obtain ⟨N, ⟨e⟩⟩ := DerivedCategory.exists_iso_singleFunctor_obj_of_isGE_of_isLE
    ((t.truncGE 0).obj K) 0
  have hπ := DerivedCategory.isIso_homologyFunctor_map_truncGEπ 0 0 le_rfl K
  refine ⟨N, P.prop_of_iso
    (asIso ((DerivedCategory.homologyFunctor C 0).map ((t.truncGEπ 0).app K)) ≪≫
      (DerivedCategory.homologyFunctor C 0).mapIso e ≪≫
      (DerivedCategory.singleFunctorCompHomologyFunctorIso C 0).app N) hK,
    (t.truncGEπ 0).app K ≫ e.hom, fun Z ↦ ⟨?_, ?_⟩⟩
  · intro a b hab
    apply (cancel_epi e.hom).mp
    apply t.from_truncGE_obj_ext
    simpa only [Category.assoc] using hab
  · intro g
    exact ⟨e.inv ≫ t.descTruncGE g 0, by simp⟩

/-- The inclusion of the derived complete objects has a left adjoint when the ideal is generated
by a finite family. -/
private theorem derivedComplete_ι_isRightAdjoint (A : Type u) [CommRing A]
    {r : ℕ} (f : Fin r → A) :
    (show ObjectProperty (DerivedCategory (ModuleCat.{u} A)) from
      (fun K ↦ IsDerivedComplete (Ideal.span (Set.range f)) K)).ι.IsRightAdjoint := by
  obtain ⟨L, ⟨adjL⟩, _⟩ := AdicKoszulAdjunction.koszulPowerDerivedLimit_isLeftAdjoint A f
    (CochainComplex.DerivedTensor.canonicalDerivedTensorProduct (ULift.{u} A))
  exact adjL.isRightAdjoint

/-- Derived completion of a module, viewed in the derived category, is upper-bounded in degree
zero. -/
private theorem completion_single_isLE (A : Type u) [CommRing A]
    {r : ℕ} (f : Fin r → A)
    (C : DerivedCategory (ModuleCat.{u} A) ⥤
      (show ObjectProperty (DerivedCategory (ModuleCat.{u} A)) from
        (fun K ↦ IsDerivedComplete (Ideal.span (Set.range f)) K)).FullSubcategory)
    (adj : C ⊣ (show ObjectProperty (DerivedCategory (ModuleCat.{u} A)) from
        (fun K ↦ IsDerivedComplete (Ideal.span (Set.range f)) K)).ι)
    (M : ModuleCat.{u} A) :
    ((C.obj ((DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj M)).obj).IsLE 0 := by
  let P : ObjectProperty (DerivedCategory (ModuleCat.{u} A)) :=
    fun K ↦ IsDerivedComplete (Ideal.span (Set.range f)) K
  let K := (DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj M
  have hC0 : IsZero (C.obj 0) := by
    rw [IsZero.iff_id_eq_zero]
    apply (adj.homEquiv 0 (C.obj 0)).injective
    exact (isZero_zero _).eq_of_src _ _
  have h0 : IsZero ((C.obj 0).obj) := P.ι.map_isZero hC0
  have hφ := (derivedCompletion_finiteCohomologicalDimension A f C adj
    (0 : K ⟶ 0)).1
  have hφ' := hφ ⟨fun i hi ↦
    (DerivedCategory.isZero_of_isLE K 0 i (by omega)).isIso
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).map_isZero (isZero_zero _)) _,
    ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) 0).map_isZero
      (isZero_zero _)).epi _⟩
  rw [DerivedCategory.isLE_iff]
  intro i hi
  have := hφ'.1 i (by omega)
  exact ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).map_isZero h0).of_iso
    (asIso ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).map
      ((C ⋙ P.ι).map (0 : K ⟶ 0))))

/-- The inclusion of the derived complete modules has a left adjoint when the ideal is generated
by a finite family. -/
private theorem derivedCompleteModule_ι_isRightAdjoint_span (A : Type u) [CommRing A]
    {r : ℕ} (f : Fin r → A) :
    (show ObjectProperty (ModuleCat.{u} A) from
      fun M ↦ IsDerivedCompleteModule (Ideal.span (Set.range f)) M).ι.IsRightAdjoint := by
  let I := Ideal.span (Set.range f)
  let P : ObjectProperty (ModuleCat.{u} A) := fun M ↦ IsDerivedCompleteModule I M
  let D : ObjectProperty (DerivedCategory (ModuleCat.{u} A)) := fun K ↦ IsDerivedComplete I K
  let s := DerivedCategory.singleFunctor (ModuleCat.{u} A) 0
  have hS := AdicWeakSerre.derivedCompleteModules_isWeakSerreClass_and_homology_iff A I
  have : P.IsWeakSerreClass := hS.1
  have : D.ι.IsRightAdjoint := derivedComplete_ι_isRightAdjoint A f
  let C := D.ι.leftAdjoint
  let adj : C ⊣ D.ι := Adjunction.ofIsRightAdjoint D.ι
  apply isRightAdjoint_of_universalArrows
  intro M
  let K := (C.obj (s.obj M)).obj
  have : K.IsLE 0 := completion_single_isLE A f C adj M
  obtain ⟨N, hN, q, hq⟩ := exists_single_reflection P K
    ((hS.2 K).mpr (C.obj (s.obj M)).property 0)
  let η : M ⟶ N := s.preimage (adj.unit.app (s.obj M) ≫ q)
  refine ⟨⟨N, hN⟩, η, fun E ↦ ?_⟩
  let E' : D.FullSubcategory := ⟨s.obj E.obj, E.property⟩
  have hu : Function.Bijective (fun g : K ⟶ s.obj E.obj ↦ adj.unit.app (s.obj M) ≫ g) :=
    ((adj.homEquiv (s.obj M) E').bijective).comp
      ((D.fullyFaithfulι.homEquiv (X := C.obj (s.obj M)) (Y := E')).symm.bijective)
  have ht := hu.comp ((hq E.obj).comp
    ((Functor.FullyFaithful.ofFullyFaithful s).map_bijective N E.obj))
  have hb : Function.Bijective (fun g : N ⟶ E.obj ↦ η ≫ g) := by
    constructor
    · intro a b hab
      apply ht.injective
      simpa only [Function.comp_apply, Functor.map_comp, η, Functor.map_preimage,
        Category.assoc] using congrArg s.map hab
    · intro g
      obtain ⟨g', hg'⟩ := ht.surjective (s.map g)
      refine ⟨g', s.map_injective ?_⟩
      simpa only [Function.comp_apply, Functor.map_comp, η, Functor.map_preimage,
        Category.assoc] using hg'
  exact hb.comp (P.fullyFaithfulι.homEquiv.bijective)

/-- The inclusion of the derived complete modules has a left adjoint when the ideal is finitely
generated. -/
private theorem derivedCompleteModule_ι_isRightAdjoint (A : Type u) [CommRing A]
    (I : Ideal A) (hI : I.FG) :
    (show ObjectProperty (ModuleCat.{u} A) from
      fun M ↦ IsDerivedCompleteModule I M).ι.IsRightAdjoint := by
  obtain ⟨r, f, hf⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hI
  rw [← hf]
  exact derivedCompleteModule_ι_isRightAdjoint_span A f

/-- A reflective full subcategory of a category with limits of a given shape is closed under those
limits. -/
private theorem isClosedUnderLimitsOfShape_of_isRightAdjoint
    {C : Type*} [Category C] (P : ObjectProperty C)
    [P.IsClosedUnderIsomorphisms] [P.ι.IsRightAdjoint]
    (J : Type*) [Category J] [HasLimitsOfShape J C] :
    P.IsClosedUnderLimitsOfShape J := by
  let : Reflective P.ι :=
    { L := P.ι.leftAdjoint
      adj := Adjunction.ofIsRightAdjoint P.ι }
  have : HasLimitsOfShape J P.FullSubcategory := hasLimitsOfShape_of_reflective P.ι
  exact P.isClosedUnderLimitsOfShape_of_preservesLimitsOfShape_ι J

/-- The derived complete modules are closed under all limits. -/
private theorem derivedCompleteModule_isClosedUnderLimitsOfShape (A : Type u) [CommRing A]
    (I : Ideal A) (J : Type u) [Category.{u} J] :
    (show ObjectProperty (ModuleCat.{u} A) from
      fun M ↦ IsDerivedCompleteModule I M).IsClosedUnderLimitsOfShape J := by
  let P : ObjectProperty (ModuleCat.{u} A) := fun M ↦ IsDerivedCompleteModule I M
  have : P.IsWeakSerreClass :=
    (AdicWeakSerre.derivedCompleteModules_isWeakSerreClass_and_homology_iff A I).1
  apply ObjectProperty.IsClosedUnderLimitsOfShape.mk'
  rintro _ ⟨F, hF⟩
  intro f hf
  let Q : ObjectProperty (ModuleCat.{u} A) :=
    fun M ↦ IsDerivedCompleteModule (Ideal.span {f}) M
  have : Q.IsWeakSerreClass :=
    (AdicWeakSerre.derivedCompleteModules_isWeakSerreClass_and_homology_iff A
      (Ideal.span {f})).1
  have : Q.ι.IsRightAdjoint :=
    derivedCompleteModule_ι_isRightAdjoint A (Ideal.span {f}) (Submodule.fg_span_singleton f)
  have : Q.IsClosedUnderLimitsOfShape J := isClosedUnderLimitsOfShape_of_isRightAdjoint Q J
  have hQ : Q (limit F) := Q.prop_limit F (fun j g hg ↦
    hF j g ((Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hf)) hg))
  exact hQ f (Ideal.subset_span (Set.mem_singleton f))

/-- The full subcategory of modules derived complete with respect to an ideal is abelian and has
all limits, and its inclusion into modules is exact and preserves limits. If the ideal is
finitely generated, the subcategory has all colimits and the inclusion has a left adjoint. -/
@[stacks 0GLP]
public theorem derivedCompleteModules_abelian_hasLimits_exact_hasColimits
    (A : Type u) [CommRing A] (I : Ideal A) :
    letI : HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A)) :=
      Stacks.DerivedProducts.hasProductsOfShape_derivedCategory
    let P : ObjectProperty (ModuleCat.{u} A) :=
      fun M => IsDerivedCompleteModule I M
    let C := P.FullSubcategory
    let F : C ⥤ ModuleCat.{u} A := P.ι
    Nonempty (Abelian C) ∧
      HasLimitsOfSize.{u, u} C ∧
      PreservesLimitsOfSize.{u, u} F ∧
      exactFunctor C (ModuleCat.{u} A) F ∧
      (I.FG → HasColimitsOfSize.{u, u} C ∧ F.IsRightAdjoint) := by
  let P : ObjectProperty (ModuleCat.{u} A) := fun M => IsDerivedCompleteModule I M
  have : P.IsWeakSerreClass :=
    (AdicWeakSerre.derivedCompleteModules_isWeakSerreClass_and_homology_iff A I).1
  have (J : Type u) [Category.{u} J] : P.IsClosedUnderLimitsOfShape J :=
    derivedCompleteModule_isClosedUnderLimitsOfShape A I J
  have hlim : HasLimitsOfSize.{u, u} P.FullSubcategory := ⟨fun _ _ ↦ inferInstance⟩
  have hpres : PreservesLimitsOfSize.{u, u} P.ι := ⟨inferInstance⟩
  refine ⟨⟨inferInstance⟩, hlim, hpres,
    ⟨P.preservesFiniteLimits_ι_of_isWeakSerreClass,
      P.preservesFiniteColimits_ι_of_isWeakSerreClass⟩, fun hI ↦ ?_⟩
  have hright : P.ι.IsRightAdjoint := derivedCompleteModule_ι_isRightAdjoint A I hI
  let : Reflective P.ι :=
    { L := P.ι.leftAdjoint
      adj := Adjunction.ofIsRightAdjoint P.ι }
  exact ⟨hasColimits_of_reflective P.ι, hright⟩

end CategoryOfCompleteModules

end CompletionAdjunction

