module

public import Mathlib.Algebra.Homology.SingleHomology
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import StacksFrontier.RingTheory.Koszul.Functoriality
public import StacksFrontier.RingTheory.Koszul.Relations
public import StacksFrontier.RingTheory.Koszul.Augmentation
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The inverse system of Koszul complexes on powers of a sequence

The Koszul complexes on the positive powers of a finite sequence `f : Fin r → A` form an
inverse system. Its degree-zero homology is naturally the inverse system of quotients
`A / (f₁^{n+1}, …, f_r^{n+1})`, and the canonical maps from the ring to the complexes are
compatible with the transition maps. This is the inverse system whose derived limit computes
the derived completion of an object of `D(A)` along the ideal generated by `f`.

## Main definitions

The complexes are the existing `Koszul.seqComplex` applied to the sequences
`i ↦ f i ^ (n + 1)`; the transition maps, the quotient system, the degree-zero comparison
isomorphisms and the augmentations from `A` are produced by the main result.

## Main results

* `koszulPowerComplexes_form_inverseSystem`: the transition maps, their functoriality,
  and their compatibility with degree-zero homology and the canonical maps from the ring.

## Implementation notes

The source views the homological Koszul complex in cohomological degrees `-r, …, 0`. We retain
Mathlib's equivalent chain-complex convention, with exterior degree `j` in homological degree
`j`. Positive powers are indexed by `n : ℕ` using exponent `n + 1`. The transition map from
exponent `m + 1` to exponent `n + 1` (for `n ≤ m`) is induced by multiplying the `i`-th
coordinate by `f i ^ (m - n)`; its compatibility with the Koszul differential is
`koszul_map_comm` (Stacks 0624).

## References

* [Stacks Project, Tag 0BKC](https://stacks.math.columbia.edu/tag/0BKC)
-/

@[expose] public section

open CategoryTheory
open scoped ExteriorAlgebra

universe u

public noncomputable def scale {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (q : ℕ) : (Fin r → A) →ₗ[A] (Fin r → A) where
  toFun v i := f i ^ q * v i
  map_add' _ _ := by ext; simp [mul_add]
  map_smul' _ _ := by ext; simp [mul_assoc, mul_comm]

private theorem scale_apply {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (q : ℕ) (v : Fin r → A) (i : Fin r) :
    scale f q v i = f i ^ q * v i := rfl

private theorem seqDual_scale {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (m n : ℕ) (h : n ≤ m) :
    (Koszul.seqDual (fun i ↦ f i ^ (n + 1))).comp (scale f (m - n)) =
      Koszul.seqDual (fun i ↦ f i ^ (m + 1)) := by
  refine LinearMap.ext fun v ↦ ?_
  simp only [LinearMap.comp_apply, Koszul.seqDual_apply, scale_apply]
  refine Finset.sum_congr rfl fun i _ ↦ ?_
  rw [show m + 1 = m - n + (n + 1) by omega, pow_add]
  ring

public theorem map_mem_exteriorPower {A : Type u} [CommRing A]
    {M N : Type u} [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (g : M →ₗ[A] N) (n : ℕ) (x : ExteriorAlgebra A M) (hx : x ∈ ⋀[A]^n M) :
    ExteriorAlgebra.map g x ∈ ⋀[A]^n N := by
  induction hx using Submodule.pow_induction_on_left' with
  | algebraMap a =>
      rw [AlgHom.commutes]
      change algebraMap A (ExteriorAlgebra A N) a ∈
        (LinearMap.range (ExteriorAlgebra.ι A : N →ₗ[A] _)) ^ 0
      rw [pow_zero]
      exact Submodule.algebraMap_mem a
  | add x y i hx hy ihx ihy =>
      rw [map_add]
      exact Submodule.add_mem _ ihx ihy
  | mem_mul x hx i y hy ih =>
      rw [map_mul]
      obtain ⟨z, rfl⟩ := hx
      rw [ExteriorAlgebra.map_apply_ι]
      change (ExteriorAlgebra.ι A) (g z) * (ExteriorAlgebra.map g) y ∈
        (LinearMap.range (ExteriorAlgebra.ι A : N →ₗ[A] _)) ^ (i + 1)
      rw [pow_succ']
      exact Submodule.mul_mem_mul (LinearMap.mem_range_self _ _) ih

public noncomputable def exteriorPowerMap {A : Type u} [CommRing A]
    {M N : Type u} [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (g : M →ₗ[A] N) (n : ℕ) : (⋀[A]^n M) →ₗ[A] (⋀[A]^n N) :=
  (ExteriorAlgebra.map g).toLinearMap.domRestrict (⋀[A]^n M) |>.codRestrict _
    (fun x ↦ map_mem_exteriorPower g n x x.2)

private theorem exteriorPowerMap_ιMulti {A : Type u} [CommRing A]
    {M N : Type u} [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (g : M →ₗ[A] N) (n : ℕ) (v : Fin n → M) :
    exteriorPowerMap g n ⟨ExteriorAlgebra.ιMulti A n v, Koszul.ιMulti_mem n v⟩ =
      ⟨ExteriorAlgebra.ιMulti A n (g ∘ v), Koszul.ιMulti_mem n (g ∘ v)⟩ := by
  ext
  exact ExteriorAlgebra.map_apply_ιMulti g v

private theorem exteriorPowerMap_eq_map {A : Type u} [CommRing A]
    {M N : Type u} [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (g : M →ₗ[A] N) (n : ℕ) :
    exteriorPowerMap g n = exteriorPower.map n g := by
  apply exteriorPower.linearMap_ext
  ext v
  simp only [LinearMap.compAlternatingMap_apply]
  exact congrArg Subtype.val ((exteriorPowerMap_ιMulti g n v).trans
    (exteriorPower.map_apply_ιMulti g v).symm)

private theorem zeroEquiv_exteriorPowerMap {A : Type u} [CommRing A]
    {M N : Type u} [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (g : M →ₗ[A] N) :
    (exteriorPower.zeroEquiv A N).comp (exteriorPowerMap g 0) =
      exteriorPower.zeroEquiv A M := by
  rw [exteriorPowerMap_eq_map]
  exact exteriorPower.zeroEquiv_naturality g

private theorem exteriorPowerMap_id {A : Type u} [CommRing A]
    {M : Type u} [AddCommGroup M] [Module A M] (n : ℕ) :
    exteriorPowerMap (LinearMap.id (R := A) (M := M)) n = LinearMap.id := by
  rw [exteriorPowerMap_eq_map, exteriorPower.map_id]

private theorem exteriorPowerMap_comp {A : Type u} [CommRing A]
    {M N P : Type u} [AddCommGroup M] [Module A M]
    [AddCommGroup N] [Module A N] [AddCommGroup P] [Module A P]
    (g : M →ₗ[A] N) (h : N →ₗ[A] P) (n : ℕ) :
    exteriorPowerMap (h.comp g) n =
      (exteriorPowerMap h n).comp (exteriorPowerMap g n) := by
  rw [exteriorPowerMap_eq_map, exteriorPowerMap_eq_map,
    exteriorPowerMap_eq_map, exteriorPower.map_comp]

private theorem scale_zero {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    scale f 0 = LinearMap.id := by
  ext v i
  simp [scale_apply]

private theorem scale_add {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (a b : ℕ) :
    scale f (a + b) = (scale f a).comp (scale f b) := by
  ext v i
  simp [scale_apply, pow_add, mul_assoc]

@[ega "III 1.1.6" "partial"]
public noncomputable def transition {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (m n : ℕ) (h : n ≤ m) :
    Koszul.seqComplex (fun i ↦ f i ^ (m + 1)) ⟶
      Koszul.seqComplex (fun i ↦ f i ^ (n + 1)) :=
  HomologicalComplex.Hom.mk
    (fun j ↦ ModuleCat.ofHom (exteriorPowerMap (scale f (m - n)) j))
    (by
      rintro j j' rfl
      rw [Koszul.seqComplex_d, Koszul.seqComplex_d]
      apply ModuleCat.hom_ext
      apply LinearMap.ext
      intro x
      apply Subtype.ext
      symm
      change
        ExteriorAlgebra.map (scale f (m - n))
            (Koszul.contraction (Koszul.seqDual (fun i ↦ f i ^ (m + 1))) x.1) =
          Koszul.contraction (Koszul.seqDual (fun i ↦ f i ^ (n + 1)))
            (ExteriorAlgebra.map (scale f (m - n)) x.1)
      simpa [exteriorPowerMap, Koszul.d] using
        koszul_map_comm _ _ _ (seqDual_scale f m n h) x.1)

/-- The underlying element of `exteriorPowerMap`: it is `ExteriorAlgebra.map` of the same linear
map, restricted to the exterior power. -/
public theorem exteriorPowerMap_coe {A : Type u} [CommRing A]
    {M N : Type u} [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (g : M →ₗ[A] N) (n : ℕ) (x : ⋀[A]^n M) :
    ((exteriorPowerMap g n x : ⋀[A]^n N) : ExteriorAlgebra A N) =
      ExteriorAlgebra.map g (x : ExteriorAlgebra A M) := rfl

/-- The components of the transition map are the exterior powers of `scale f (m - n)`. -/
public theorem transition_f {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (m n : ℕ) (h : n ≤ m) (j : ℕ) :
    (transition f m n h).f j = ModuleCat.ofHom (exteriorPowerMap (scale f (m - n)) j) := rfl

/-- **The transition map scales the `i`-th coordinate by `f i ^ (m - n)`**, read on the wedges
of vectors of `Aʳ`.  These wedges span each exterior power, so this determines the map; that is
`transition_eq_of_ιMulti` below. -/
private theorem transition_ιMulti {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (m n : ℕ) (h : n ≤ m) (j : ℕ) (v : Fin j → Fin r → A) :
    (transition f m n h).f j ⟨ExteriorAlgebra.ιMulti A j v, Koszul.ιMulti_mem j v⟩ =
      ⟨ExteriorAlgebra.ιMulti A j (fun k i ↦ f i ^ (m - n) * v k i),
        Koszul.ιMulti_mem j (fun k i ↦ f i ^ (m - n) * v k i)⟩ :=
  exteriorPowerMap_ιMulti (scale f (m - n)) j v

private theorem transition_id {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (n : ℕ) :
    transition f n n (le_refl n) = 𝟙 (Koszul.seqComplex (fun i ↦ f i ^ (n + 1))) := by
  apply HomologicalComplex.hom_ext
  intro j
  apply ModuleCat.hom_ext
  change exteriorPowerMap (scale f (n - n)) j = LinearMap.id
  rw [Nat.sub_self, scale_zero, exteriorPowerMap_id]

private theorem transition_comp {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (k m n : ℕ) (hkm : m ≤ k) (hmn : n ≤ m) :
    transition f k m hkm ≫ transition f m n hmn =
      transition f k n (hmn.trans hkm) := by
  apply HomologicalComplex.hom_ext
  intro j
  apply ModuleCat.hom_ext
  change (exteriorPowerMap (scale f (m - n)) j).comp
      (exteriorPowerMap (scale f (k - m)) j) =
    exteriorPowerMap (scale f (k - n)) j
  rw [← exteriorPowerMap_comp, ← scale_add]
  congr 2
  omega

private theorem zeroEquiv_transition {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (m n : ℕ) (h : n ≤ m) :
    (exteriorPower.zeroEquiv A (Fin r → A)).comp
        ((transition f m n h).f 0).hom =
      (exteriorPower.zeroEquiv A (Fin r → A)).toLinearMap :=
  zeroEquiv_exteriorPowerMap (scale f (m - n))

public theorem powerIdeal_antitone {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (m n : ℕ) (h : n ≤ m) :
    Ideal.span (Set.range fun i ↦ f i ^ (m + 1)) ≤
      Ideal.span (Set.range fun i ↦ f i ^ (n + 1)) := by
  rw [Ideal.span_le]
  rintro _ ⟨i, rfl⟩
  change f i ^ (m + 1) ∈ Ideal.span (Set.range fun i ↦ f i ^ (n + 1))
  rw [show m + 1 = m - n + (n + 1) by omega, pow_add]
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

public noncomputable def quotientTransition {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (m n : ℕ) (h : n ≤ m) :
    ModuleCat.of A (A ⧸ Ideal.span (Set.range fun i ↦ f i ^ (m + 1))) ⟶
      ModuleCat.of A (A ⧸ Ideal.span (Set.range fun i ↦ f i ^ (n + 1))) :=
  ModuleCat.ofHom (Submodule.factor (powerIdeal_antitone f m n h))

private theorem quotientTransition_id {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (n : ℕ) :
    quotientTransition f n n (le_refl n) = 𝟙 _ := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  rintro ⟨a⟩
  rfl

private theorem quotientTransition_comp {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (k m n : ℕ) (hkm : m ≤ k) (hmn : n ≤ m) :
    quotientTransition f k m hkm ≫ quotientTransition f m n hmn =
      quotientTransition f k n (hmn.trans hkm) := by
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  rintro ⟨a⟩
  rfl

private theorem quotientTransition_mkQ {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (m n : ℕ) (h : n ≤ m) :
    ModuleCat.ofHom (Ideal.span (Set.range fun i ↦ f i ^ (m + 1))).mkQ ≫
      quotientTransition f m n h =
    ModuleCat.ofHom (Ideal.span (Set.range fun i ↦ f i ^ (n + 1))).mkQ :=
  ModuleCat.hom_ext (LinearMap.ext fun _ ↦ rfl)

public noncomputable def ringToKoszul {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) :
    (ChainComplex.single₀ (ModuleCat.{u} A)).obj (ModuleCat.of A A) ⟶
      Koszul.seqComplex f :=
  (ChainComplex.fromSingle₀Equiv (Koszul.seqComplex f) (ModuleCat.of A A)).symm
    (ModuleCat.ofHom (exteriorPower.zeroEquiv A (Fin r → A)).symm.toLinearMap)

public theorem ringToKoszul_f_zero {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) :
    (ringToKoszul f).f 0 =
      ModuleCat.ofHom (exteriorPower.zeroEquiv A (Fin r → A)).symm.toLinearMap :=
  ChainComplex.fromSingle₀Equiv_symm_apply_f_zero _

set_option backward.isDefEq.respectTransparency false in
public theorem ringToKoszul_f_zero_apply {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (a : A) :
    (ringToKoszul f).f 0 a =
      a • ⟨ExteriorAlgebra.ιMulti A 0 (fun i ↦ Fin.elim0 i),
        Koszul.ιMulti_mem 0 (fun i ↦ Fin.elim0 i)⟩ := by
  rw [ringToKoszul_f_zero]
  change (exteriorPower.zeroEquiv A (Fin r → A)).symm a = _
  apply (exteriorPower.zeroEquiv A (Fin r → A)).injective
  rw [LinearEquiv.apply_symm_apply, map_smul]
  change a = a • (exteriorPower.zeroEquiv A (Fin r → A))
    (exteriorPower.ιMulti A 0 (fun i ↦ Fin.elim0 i))
  rw [exteriorPower.zeroEquiv_ιMulti, smul_eq_mul, mul_one]

set_option backward.isDefEq.respectTransparency false in
public theorem ringToKoszul_transition {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (m n : ℕ) (h : n ≤ m) :
    ringToKoszul (fun i ↦ f i ^ (m + 1)) ≫ transition f m n h =
      ringToKoszul (fun i ↦ f i ^ (n + 1)) := by
  apply (ChainComplex.fromSingle₀Equiv
    (Koszul.seqComplex (fun i ↦ f i ^ (n + 1))) (ModuleCat.of A A)).injective
  change (ringToKoszul (fun i ↦ f i ^ (m + 1))).f 0 ≫
      (transition f m n h).f 0 =
    (ringToKoszul (fun i ↦ f i ^ (n + 1))).f 0
  rw [ringToKoszul_f_zero, ringToKoszul_f_zero]
  refine ModuleCat.hom_ext (LinearMap.ext fun a ↦ ?_)
  apply (exteriorPower.zeroEquiv A (Fin r → A)).injective
  simp only [ModuleCat.hom_comp, ModuleCat.hom_ofHom, LinearMap.comp_apply]
  exact LinearMap.congr_fun (zeroEquiv_transition f m n h) _

/-- The degree-zero homology identification sends the class of `x` to the class of its image in
`A`. -/
private theorem homologyZeroIso_fac_apply {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (x : (Koszul.seqComplex f).X 0) :
    (Koszul.homologyZeroIso f).hom.hom
        ((Koszul.seqComplex f).isoHomologyι₀.inv.hom (((Koszul.seqComplex f).pOpcycles 0).hom x)) =
      (Ideal.span (Set.range f)).mkQ (exteriorPower.zeroEquiv A (Fin r → A) x) :=
  congrArg (fun g ↦ g.hom x) (Koszul.homologyZeroIso_fac f)

set_option backward.isDefEq.respectTransparency.types false in
public theorem homologyZeroIso_transition {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (m n : ℕ) (h : n ≤ m) :
    (Koszul.homologyZeroIso (fun i ↦ f i ^ (m + 1))).inv ≫
        HomologicalComplex.homologyMap (transition f m n h) 0 ≫
        (Koszul.homologyZeroIso (fun i ↦ f i ^ (n + 1))).hom =
      quotientTransition f m n h := by
  rw [← cancel_epi (Koszul.homologyZeroIso (fun i ↦ f i ^ (m + 1))).hom]
  simp only [Iso.hom_inv_id_assoc]
  rw [← cancel_epi (Koszul.seqComplex (fun i ↦ f i ^ (m + 1))).isoHomologyι₀.inv,
    ← cancel_epi ((Koszul.seqComplex (fun i ↦ f i ^ (m + 1))).pOpcycles 0),
    ChainComplex.isoHomologyι₀_inv_naturality_assoc, HomologicalComplex.p_opcyclesMap_assoc]
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro x
  change ⋀[A]^0 (Fin r → A) at x
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply]
  rw [homologyZeroIso_fac_apply, homologyZeroIso_fac_apply]
  change (Ideal.span (Set.range fun i ↦ f i ^ (n + 1))).mkQ
      ((exteriorPower.zeroEquiv A (Fin r → A)) (((transition f m n h).f 0).hom x)) =
    (quotientTransition f m n h).hom
      ((Ideal.span (Set.range fun i ↦ f i ^ (m + 1))).mkQ
        ((exteriorPower.zeroEquiv A (Fin r → A)) x))
  have hz := LinearMap.congr_fun (zeroEquiv_transition f m n h) x
  change (exteriorPower.zeroEquiv A (Fin r → A))
    (((transition f m n h).f 0).hom x) =
    (exteriorPower.zeroEquiv A (Fin r → A)) x at hz
  rw [hz]
  exact (congrArg (fun (g : ModuleCat.of A A ⟶
      ModuleCat.of A (A ⧸ Ideal.span (Set.range fun i ↦ f i ^ (n + 1)))) ↦
        g.hom ((exteriorPower.zeroEquiv A (Fin r → A)) x))
    (quotientTransition_mkQ f m n h)).symm

set_option backward.isDefEq.respectTransparency.types false in
public theorem singleZeroHomology_fac {A : Type u} [CommRing A] :
    let S := (ChainComplex.single₀ (ModuleCat.{u} A)).obj (ModuleCat.of A A)
    (HomologicalComplex.singleObjXSelf (ComplexShape.down ℕ) 0 (ModuleCat.of A A)).hom ≫
      (HomologicalComplex.singleObjHomologySelfIso
        (ComplexShape.down ℕ) 0 (ModuleCat.of A A)).inv =
      S.pOpcycles 0 ≫ S.isoHomologyι₀.inv := by
  dsimp only
  rw [← cancel_mono ((ChainComplex.single₀ (ModuleCat.{u} A)).obj
    (ModuleCat.of A A)).isoHomologyι₀.hom]
  simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  change (HomologicalComplex.singleObjXSelf (ComplexShape.down ℕ) 0
      (ModuleCat.of A A)).hom ≫
      (HomologicalComplex.singleObjHomologySelfIso (ComplexShape.down ℕ) 0
        (ModuleCat.of A A)).inv ≫
        ((ChainComplex.single₀ (ModuleCat.{u} A)).obj (ModuleCat.of A A)).homologyι 0 =
    ((ChainComplex.single₀ (ModuleCat.{u} A)).obj (ModuleCat.of A A)).pOpcycles 0
  rw [HomologicalComplex.singleObjHomologySelfIso_inv_homologyι,
    HomologicalComplex.singleObjOpcyclesSelfIso_hom]
  simp only [Iso.hom_inv_id_assoc]

set_option backward.isDefEq.respectTransparency.types false in
public theorem homologyZeroIso_ringToKoszul {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) :
    (HomologicalComplex.singleObjHomologySelfIso
          (ComplexShape.down ℕ) 0 (ModuleCat.of A A)).inv ≫
        HomologicalComplex.homologyMap (ringToKoszul f) 0 ≫
        (Koszul.homologyZeroIso f).hom =
      ModuleCat.ofHom (Ideal.span (Set.range f)).mkQ := by
  rw [← cancel_epi (HomologicalComplex.singleObjXSelf
    (ComplexShape.down ℕ) 0 (ModuleCat.of A A)).hom, ← Category.assoc, singleZeroHomology_fac,
    Category.assoc, ChainComplex.isoHomologyι₀_inv_naturality_assoc,
    HomologicalComplex.p_opcyclesMap_assoc]
  apply ModuleCat.hom_ext
  apply LinearMap.ext
  intro a
  change A at a
  simp only [ModuleCat.hom_comp, LinearMap.comp_apply]
  rw [homologyZeroIso_fac_apply]
  change (Ideal.span (Set.range f)).mkQ
      ((exteriorPower.zeroEquiv A (Fin r → A)) (((ringToKoszul f).f 0).hom a)) =
    (Ideal.span (Set.range f)).mkQ
      ((HomologicalComplex.singleObjXSelf (ComplexShape.down ℕ) 0
        (ModuleCat.of A A)).hom.hom a)
  have hE : (exteriorPower.zeroEquiv A (Fin r → A))
      (((ringToKoszul f).f 0).hom a) = a := by
    rw [ringToKoszul_f_zero]
    change (exteriorPower.zeroEquiv A (Fin r → A))
      ((exteriorPower.zeroEquiv A (Fin r → A)).symm a) = a
    exact LinearEquiv.apply_symm_apply _ _
  have hX : ((HomologicalComplex.singleObjXSelf (ComplexShape.down ℕ) 0
      (ModuleCat.of A A)).hom).hom a = a := by
    simp [HomologicalComplex.singleObjXSelf,
      HomologicalComplex.singleObjXIsoOfEq, HomologicalComplex.single]
    rfl
  rw [hE, hX]

/-- **Stacks Project, Tag 0BKC.** The Koszul complexes on the positive powers of a finite
sequence form an inverse system. The displayed formula says that its transition maps are the
maps of Koszul complexes induced by multiplying the `i`-th basis vector by the appropriate
power of `f i`. The system is compatible both with its canonical maps from `A` and, under the
natural identifications in degree zero, with the inverse system of quotients by the ideals
generated by the powered sequences. -/
@[stacks 0BKC, sga "2 II Lemma9" "partial"]
public theorem koszulPowerComplexes_form_inverseSystem
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    let K : ℕ → ChainComplex (ModuleCat.{u} A) ℕ := fun n ↦
      Koszul.seqComplex (fun i ↦ f i ^ (n + 1))
    let Q : ℕ → ModuleCat.{u} A := fun n ↦
      ModuleCat.of A (A ⧸ Ideal.span (Set.range fun i ↦ f i ^ (n + 1)))
    ∃ (τ : ∀ (m n : ℕ), n ≤ m → (K m ⟶ K n))
      (σ : ∀ (m n : ℕ), n ≤ m → (Q m ⟶ Q n))
      (e : ∀ n, (K n).homology 0 ≅ Q n)
      (η : ∀ n, (ChainComplex.single₀ (ModuleCat.{u} A)).obj (ModuleCat.of A A) ⟶ K n),
      (∀ n, τ n n (le_refl n) = 𝟙 (K n)) ∧
      (∀ (k m n : ℕ) (hkm : m ≤ k) (hmn : n ≤ m),
        τ k m hkm ≫ τ m n hmn = τ k n (hmn.trans hkm)) ∧
      (∀ n, σ n n (le_refl n) = 𝟙 (Q n)) ∧
      (∀ (k m n : ℕ) (hkm : m ≤ k) (hmn : n ≤ m),
        σ k m hkm ≫ σ m n hmn = σ k n (hmn.trans hkm)) ∧
      (∀ (m n : ℕ) (hmn : n ≤ m) (j : ℕ) (v : Fin j → Fin r → A),
        (τ m n hmn).f j
            ⟨ExteriorAlgebra.ιMulti A j v, Koszul.ιMulti_mem j v⟩ =
          ⟨ExteriorAlgebra.ιMulti A j
              (fun k i ↦ f i ^ (m - n) * v k i),
            Koszul.ιMulti_mem j (fun k i ↦ f i ^ (m - n) * v k i)⟩) ∧
      (∀ (n : ℕ) (a : A),
        (η n).f 0 a =
          a • ⟨ExteriorAlgebra.ιMulti A 0 (fun i ↦ Fin.elim0 i),
            Koszul.ιMulti_mem 0 (fun i ↦ Fin.elim0 i)⟩) ∧
      (∀ (m n : ℕ) (hmn : n ≤ m), η m ≫ τ m n hmn = η n) ∧
      (∀ (m n : ℕ) (hmn : n ≤ m),
        ModuleCat.ofHom
              (Ideal.span (Set.range fun i ↦ f i ^ (m + 1))).mkQ ≫
            σ m n hmn =
          ModuleCat.ofHom
            (Ideal.span (Set.range fun i ↦ f i ^ (n + 1))).mkQ) ∧
      (∀ (m n : ℕ) (hmn : n ≤ m),
        (e m).inv ≫ HomologicalComplex.homologyMap (τ m n hmn) 0 ≫ (e n).hom =
          σ m n hmn) ∧
      ∀ n,
        (HomologicalComplex.singleObjHomologySelfIso
              (ComplexShape.down ℕ) 0 (ModuleCat.of A A)).inv ≫
            HomologicalComplex.homologyMap (η n) 0 ≫ (e n).hom =
          ModuleCat.ofHom
            (Ideal.span (Set.range fun i ↦ f i ^ (n + 1))).mkQ :=
  ⟨transition f, quotientTransition f,
    fun n ↦ Koszul.homologyZeroIso (fun i ↦ f i ^ (n + 1)),
    fun n ↦ ringToKoszul (fun i ↦ f i ^ (n + 1)),
    transition_id f, transition_comp f, quotientTransition_id f, quotientTransition_comp f,
    transition_ιMulti f, fun _ ↦ ringToKoszul_f_zero_apply _, ringToKoszul_transition f,
    quotientTransition_mkQ f, homologyZeroIso_transition f,
    fun _ ↦ homologyZeroIso_ringToKoszul _⟩

/-- **The wedges of vectors determine a map of Koszul complexes.** The degree-`j` term of
`Koszul.seqComplex` is the exterior power `⋀ʲ(Aʳ)`, which is spanned by the wedges
`ExteriorAlgebra.ιMulti A j v` (`exteriorPower.ιMulti_span`), so a map out of it is determined by
its values on those. -/
public theorem transition_eq_of_ιMulti {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) (m n : ℕ) (h : n ≤ m)
    (τ : Koszul.seqComplex (fun i ↦ f i ^ (m + 1)) ⟶
      Koszul.seqComplex (fun i ↦ f i ^ (n + 1)))
    (hτ : ∀ (j : ℕ) (v : Fin j → Fin r → A),
      (τ.f j) ⟨ExteriorAlgebra.ιMulti A j v, Koszul.ιMulti_mem j v⟩ =
        ⟨ExteriorAlgebra.ιMulti A j (fun k i ↦ f i ^ (m - n) * v k i),
          Koszul.ιMulti_mem j (fun k i ↦ f i ^ (m - n) * v k i)⟩) :
    τ = transition f m n h := by
  apply HomologicalComplex.hom_ext
  intro j
  apply ModuleCat.hom_ext
  refine LinearMap.ext_on (exteriorPower.ιMulti_span A j (Fin r → A)) ?_
  rintro _ ⟨v, rfl⟩
  exact (hτ j v).trans (transition_ιMulti f m n h j v).symm

/-- **The transition maps selected from Stacks 0BKC are the explicit ones.** The existential of
`koszulPowerComplexes_form_inverseSystem` is witnessed by `transition`, and its fifth clause pins
the chosen maps on the wedges of vectors of `Aʳ`, which span each exterior power. So the choice,
however it is made, is `transition` — and a tower built on `Classical.choose` of that statement is
a tower of the explicit maps `exteriorPowerMap (scale f (m - n))`.

This is what makes the Koszul power tower of the exterior-power model computable: without it the
transition maps are opaque and no equation about them can be stated, only their values on
generators. -/
public theorem choose_koszulPowerComplexes_form_inverseSystem_eq {A : Type u} [CommRing A]
    {r : ℕ} (f : Fin r → A) (m n : ℕ) (h : n ≤ m) :
    Classical.choose (koszulPowerComplexes_form_inverseSystem f) m n h =
      transition f m n h := by
  obtain ⟨σ, e, η, -, -, -, -, hformula, -⟩ :=
    Classical.choose_spec (koszulPowerComplexes_form_inverseSystem f)
  exact transition_eq_of_ιMulti f m n h _ (hformula m n h)

end
