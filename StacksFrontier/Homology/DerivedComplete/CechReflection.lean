module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.Homology.DerivedComplete
public import StacksFrontier.Homology.DerivedComplete.CechCompletion

section

/-!
# Derived completion as a reflection

Let `I` be a finitely generated ideal in a commutative ring `A`. The left adjoint to the
inclusion of the derived-complete objects into `D(A)` is called derived completion. Its unit is
a natural, and hence functorial, map from every object to its derived completion.

## Main definitions

* `DerivedCompletion.derivedCompletionFunctor`: derived completion with respect to the ideal
  generated by a finite family.
* `DerivedCompletion.derivedCompletionUnit`: the natural map from an object to its derived
  completion.

## Main results

* `DerivedCompletion.derivedCompletion_isReflection`: derived completion takes values in the
  derived-complete objects and satisfies the universal property of the left adjoint to their
  inclusion.

## Implementation notes

A finitely generated ideal is presented by a family indexed by `Fin r`. Derived completion is
the functor `CechCompletion.cechCompletionFunctor` built from the extended alternating Čech
complex, and its unit is chosen from `CechCompletion.cechCompletion_isReflection`; the
universal property makes this choice unique up to the canonical isomorphism of reflections.

## References

* [The Stacks Project, Tag 0G3E](https://stacks.math.columbia.edu/tag/0G3E)
* [Bhatt--Scholze, *Projectivity of the Witt vector affine Grassmannian*][BS]
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

attribute [local instance] HasDerivedCategory.standard

universe u

namespace DerivedCompletion

/-- Derived completion with respect to the ideal generated by the finite family `f`. -/
public noncomputable abbrev derivedCompletionFunctor (A : Type u) [CommRing A] {r : ℕ}
    (f : Fin r → A) :
    DerivedCategory (ModuleCat.{u} A) ⥤ DerivedCategory (ModuleCat.{u} A) :=
  CechCompletion.cechCompletionFunctor A f

/-- The functorial map from an object to its derived completion. -/
public noncomputable def derivedCompletionUnit (A : Type u) [CommRing A] {r : ℕ}
    (f : Fin r → A)
    [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A))] :
    Functor.id (DerivedCategory (ModuleCat.{u} A)) ⟶ derivedCompletionFunctor A f :=
  (CechCompletion.cechCompletion_isReflection A f).choose

/-- Derived completion with respect to a finitely generated ideal is the reflection into the
derived-complete objects: it takes derived-complete values, and its unit `K ⟶ K̂` induces a
bijection from maps out of `K̂` to maps out of `K` whenever the target is derived complete. -/
@[stacks 0G3E]
public theorem derivedCompletion_isReflection (A : Type u) [CommRing A] {r : ℕ}
    (f : Fin r → A)
    [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A))] :
    (∀ K, IsDerivedComplete (Ideal.span (Set.range f))
      ((derivedCompletionFunctor A f).obj K)) ∧
    ∀ (K E : DerivedCategory (ModuleCat.{u} A)),
      IsDerivedComplete (Ideal.span (Set.range f)) E →
        Function.Bijective
          (fun g : (derivedCompletionFunctor A f).obj K ⟶ E ↦
            (derivedCompletionUnit A f).app K ≫ g) :=
  (CechCompletion.cechCompletion_isReflection A f).choose_spec

end DerivedCompletion

end

end
