module

public import StacksFrontier.Homology.DerivedComplete.CechReflection
public import StacksFrontier.RingTheory.Dualizing.TorsionComplete.DerivedHomCompletionTorsion

/-!
# Derived completion is an exact functor of triangulated categories

Let `A` be a commutative ring and let `f : Fin r → A` generate the ideal `I`. Derived `I`-adic
completion `DerivedCompletion.derivedCompletionFunctor A f` is the left adjoint of the inclusion
of the derived `I`-complete objects into `D(A)`. That subcategory is a triangulated subcategory,
so its inclusion is an exact functor, and a left adjoint of an exact functor between
pretriangulated categories is exact. Hence derived completion commutes with the shift and carries
distinguished triangles to distinguished triangles, which is what lets a localization triangle be
completed term by term.

## Main definitions

* `DerivedCompletion.derivedCompletionAdjunction` — derived completion, corestricted to the
  derived-complete objects, as a left adjoint of their inclusion.

## Main results

* `DerivedCompletion.commShift_derivedCompletionFunctor` — derived completion commutes with the
  shift by `ℤ`.
* `DerivedCompletion.isTriangulated_derivedCompletionFunctor` — derived completion carries
  distinguished triangles to distinguished triangles.

## Implementation notes

The ideal is taken to be `Ideal.span (Set.range f)` on the nose, so that the two instances have
no argument beyond the generating family and fire by unification.

## References

* [Stacks Project, Tag 091V](https://stacks.math.columbia.edu/tag/091V)
* [Stacks Project, Tag 0920](https://stacks.math.columbia.edu/tag/0920)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

attribute [local instance] HasDerivedCategory.standard
  Dualizing.hasProductsOfShape_nat_derivedCategory

universe u

namespace DerivedCompletion

variable (A : Type u) [CommRing A] {r : ℕ} (f : Fin r → A)

/-- The derived completion of an object is derived complete for the ideal generated by `f`. -/
theorem derivedCompleteProperty_derivedCompletionFunctor_obj
    (K : DerivedCategory (ModuleCat.{u} A)) :
    Dualizing.derivedCompleteProperty.{u, u} A (Ideal.span (Set.range f))
      ((derivedCompletionFunctor A f).obj K) :=
  (derivedCompletion_isReflection A f).1 K

/-- **Derived completion as a reflection, packaged as an adjunction.** The Čech model of derived
completion along the ideal generated by `f`, corestricted to the derived-complete objects, is
left adjoint to the inclusion of those objects into `D(A)`. -/
def derivedCompletionAdjunction :
    (Dualizing.derivedCompleteProperty.{u, u} A (Ideal.span (Set.range f))).lift
        (derivedCompletionFunctor A f)
        (derivedCompleteProperty_derivedCompletionFunctor_obj A f) ⊣
      (Dualizing.derivedCompleteProperty.{u, u} A (Ideal.span (Set.range f))).ι :=
  Dualizing.reflectionAdjunctionOfUniversal _ _ (derivedCompletionUnit A f)
    (derivedCompleteProperty_derivedCompletionFunctor_obj A f)
    (fun X E hE => (derivedCompletion_isReflection A f).2 X E hE)

/-- **Derived completion commutes with the shift.** It is a left adjoint of the inclusion of the
derived-complete objects, which is shift-compatible because that subcategory is stable under
shifts. -/
instance commShift_derivedCompletionFunctor :
    (derivedCompletionFunctor A f).CommShift ℤ :=
  letI := (derivedCompletionAdjunction A f).leftAdjointCommShift ℤ
  inferInstanceAs
    (((Dualizing.derivedCompleteProperty.{u, u} A (Ideal.span (Set.range f))).lift
        (derivedCompletionFunctor A f)
        (derivedCompleteProperty_derivedCompletionFunctor_obj A f) ⋙
      (Dualizing.derivedCompleteProperty.{u, u} A (Ideal.span (Set.range f))).ι).CommShift ℤ)

/-- **Derived completion is exact.** A left adjoint of an exact functor between pretriangulated
categories is exact, and the inclusion of the derived-complete objects is exact because they
form a triangulated subcategory; so derived completion carries distinguished triangles to
distinguished triangles. -/
instance isTriangulated_derivedCompletionFunctor :
    (derivedCompletionFunctor A f).IsTriangulated :=
  letI := (derivedCompletionAdjunction A f).leftAdjointCommShift ℤ
  letI := (derivedCompletionAdjunction A f).commShift_of_rightAdjoint ℤ
  letI := (derivedCompletionAdjunction A f).isTriangulated_leftAdjoint
  inferInstanceAs
    (((Dualizing.derivedCompleteProperty.{u, u} A (Ideal.span (Set.range f))).lift
        (derivedCompletionFunctor A f)
        (derivedCompleteProperty_derivedCompletionFunctor_obj A f) ⋙
      (Dualizing.derivedCompleteProperty.{u, u} A (Ideal.span (Set.range f))).ι).IsTriangulated)

end DerivedCompletion

end
