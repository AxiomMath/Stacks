@[expose] public noncomputable section

/-!
# Detecting positive cohomology of a derived complete complex

Let `A` be a commutative ring and let the ideal `I ⊆ A` be generated by a finite sequence
`f = (f₁, …, f_r)`. For a complex `K` derived complete with respect to `I`, vanishing of the
positive cohomology of `K` can be detected either after derived reduction modulo `I` or after
derived tensoring with the Koszul complex of `f`. As a consequence, a derived complete complex
whose derived reduction modulo a finitely generated ideal vanishes is itself zero: the derived
Nakayama lemma.

## Main results

* `KoszulTensorVanishing.positive_homology_isZero_iff_derivedTensorProduct_mod_ideal_iff_koszul`:
  the three equivalent positive-cohomology vanishing conditions, Stacks 0H83.
* `KoszulTensorVanishing.isZero_of_isDerivedComplete_of_derivedTensorProduct_mod_ideal_isZero`:
  the derived Nakayama lemma, Stacks 0G1U.

## Implementation notes

The ideal generated by the chosen sequence `f` is `Ideal.span (Set.range f)`. The homological
Koszul complex `Koszul.seqComplex f` is extended from nonnegative homological degrees to a
cochain complex indexed by the integers along `ComplexShape.embeddingDownNat`, placing exterior
degree `j` in cohomological degree `-j`, before passing to the derived category. The derived
tensor product is the canonical one of
`CochainComplex.DerivedTensor.canonicalDerivedTensorProductFunctor`.

The implication from the Koszul criterion back to `K` itself is an induction on the length of
the sequence: appending a generator `a` replaces the Koszul complex by the cone of multiplication
by `a` (Stacks 0629), whose derived tensor product with `K` sits in a distinguished triangle
whose first map is multiplication by `a`. The comparison of that cone, taken in cochain
complexes, with the explicit `ℕ`-indexed cone `Stacks.MappingCone.NatIndexed.coneComplex` is the
content of the `ConeBridge` section, whose single public export
`KoszulTensorVanishing.ConeBridge.coneIso` is the comparison isomorphism itself.

Derived completeness of a module is `IsDerivedCompleteModule`, and of a complex
`IsDerivedComplete`; the quotient module `A ⧸ I` is regarded as an object of `D(A)` concentrated
in degree zero, and vanishing is the invariant predicate `IsZero`.

## References

* [Stacks Project, Tag 0H83](https://stacks.math.columbia.edu/tag/0H83)
* [Stacks Project, Tag 0G1U](https://stacks.math.columbia.edu/tag/0G1U)
* [Bhatt--Scholze, *Projectivity of the Witt vector affine Grassmannian*][BS]
* [Dwyer--Greenlees, *Complete modules and torsion modules*][Dwyer-Greenlees]
-/

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open CochainComplex.DerivedTensor StacksDraft.PowerTorsionVanishing
open scoped ZeroObject

attribute [local instance] HasDerivedCategory.standard

namespace KoszulTensorVanishing

universe u w

/-! ### Derived completeness along shifts and triangles -/

/-- Derived completeness is preserved under the third vertex of a distinguished triangle. -/
private theorem isDerivedComplete_of_distinguished_triangle
    {A : Type u} [CommRing A] (I : Ideal A)
    [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A))]
    (T : Triangle (DerivedCategory (ModuleCat.{u} A))) (hT : T ∈ distTriang _)
    (h₁ : IsDerivedComplete I T.obj₁)
    (h₂ : IsDerivedComplete I T.obj₂) :
    IsDerivedComplete I T.obj₃ := by
  intro a ha
  exact isDerivedCompleteAt_of_distTriang (rot_of_distTriang _ (rot_of_distTriang T hT))
    (isDerivedComplete_shift I h₁ 1 a ha) (isDerivedComplete_shift I h₂ 1 a ha)

/-! ### Elementary reductions -/

/-- Surjectivity of multiplication by an element of an ideal kills reduction by the ideal. -/
private theorem subsingleton_quotient_smul_of_surjective_smul
    {A : Type u} [CommRing A] (I : Ideal A) (M : ModuleCat.{u} A)
    (f : A) (hf : f ∈ I)
    (hsurj : Function.Surjective (fun x : M => f • x)) :
    Subsingleton (M ⧸ (I • ⊤ : Submodule A M)) := by
  have htop : (I • ⊤ : Submodule A M) = ⊤ := by
    apply top_unique
    intro x _
    obtain ⟨y, rfl⟩ := hsurj x
    exact Submodule.smul_mem_smul hf (Submodule.mem_top)
  rw [htop]
  infer_instance

/-! ### The Koszul complex in the derived category -/

/-- The cochain Koszul complex has homology only between degrees `-r` and `0`. -/
private theorem koszul_extend_isZero_homology_outside
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (i : ℤ) (hi : i < -(r : ℤ) ∨ 0 < i) :
    IsZero (((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat).homology i) := by
  let K := Koszul.seqComplex f
  have hX : IsZero ((K.extend ComplexShape.embeddingDownNat).X i) := by
    by_cases hp : ∃ j : ℕ, -(j : ℤ) = i
    · obtain ⟨j, hj⟩ := hp
      have hgt : r < j := by rcases hi with hi | hi <;> omega
      exact (Koszul.seqComplex_isZero_of_lt f j hgt).of_iso
        (K.extendXIso ComplexShape.embeddingDownNat hj)
    · exact K.isZero_extend_X ComplexShape.embeddingDownNat i
        (fun j hj => hp ⟨j, hj⟩)
  exact (K.extend ComplexShape.embeddingDownNat).sc i |>.isZero_homology_of_isZero_X₂ hX

/-- The derived Koszul complex is concentrated in degrees `[-r, 0]`. -/
private theorem koszul_derived_isBounded
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    let K₁ : DerivedCategory (ModuleCat.{u} A) := DerivedCategory.Q.obj
        ((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} A)).obj
          (Koszul.seqComplex f))
    K₁.IsGE (-(r : ℤ)) ∧ K₁.IsLE 0 := by
  constructor
  · rw [DerivedCategory.isGE_Q_obj_iff, CochainComplex.isGE_iff]
    intro i hi
    rw [HomologicalComplex.exactAt_iff_isZero_homology]
    exact koszul_extend_isZero_homology_outside f i (Or.inl hi)
  · rw [DerivedCategory.isLE_Q_obj_iff, CochainComplex.isLE_iff]
    intro i hi
    rw [HomologicalComplex.exactAt_iff_isZero_homology]
    exact koszul_extend_isZero_homology_outside f i (Or.inr hi)

/-- Extending a scalar endomorphism preserves its scalar. -/
private theorem extendMap_smul_id {A : Type u} [CommRing A]
    (C : ChainComplex (ModuleCat.{u} A) ℕ) (a : A) :
    HomologicalComplex.extendMap (a • 𝟙 C) ComplexShape.embeddingDownNat =
      a • 𝟙 (C.extend ComplexShape.embeddingDownNat) := by
  ext1 i
  by_cases hi : ∃ n, ComplexShape.embeddingDownNat.f n = i
  · obtain ⟨n, rfl⟩ := hi
    simp [HomologicalComplex.extendMap_f]
  · exact (C.isZero_extend_X _ i (fun n hn => hi ⟨n, hn⟩)).eq_of_src _ _

/-- Multiplication by a Koszul generator vanishes on the associated derived object. -/
private theorem koszul_generator_smul_id_eq_zero
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) (i : Fin r) :
    f i • 𝟙 (DerivedCategory.Q.obj
      ((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} A)).obj
        (Koszul.seqComplex f))) = 0 := by
  obtain ⟨h⟩ := (Koszul.koszulSeq_smul_nullHomotopic_and_span_le_annihilator f).1 i
  have hE := h.extend ComplexShape.embeddingDownNat
  have hE' : Homotopy
      (HomologicalComplex.extendMap (f i • 𝟙 (Koszul.seqComplex f))
        ComplexShape.embeddingDownNat) 0 := by
    convert hE using 1
    all_goals simp
  have hd := AdicKoszul.Q_map_eq_zero_of_homotopy hE'
  rw [extendMap_smul_id] at hd
  rw [← DerivedCategory.Q.map_id, ← DerivedCategory.Q.map_smul]
  exact hd

/-- The cohomology of a Koszul complex is power torsion for its generating ideal. -/
private theorem koszul_derived_homology_power_torsion
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) (i : ℤ) :
    IsIPowerTorsion A
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj
        (DerivedCategory.Q.obj
          ((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} A)).obj
            (Koszul.seqComplex f))))
      (Ideal.span (Set.range f)) := by
  let K₁ : DerivedCategory (ModuleCat.{u} A) := DerivedCategory.Q.obj
    ((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} A)).obj
      (Koszul.seqComplex f))
  let H := DerivedCategory.homologyFunctor (ModuleCat.{u} A) i
  let : Functor.Linear A H :=
    DerivedCategory.homologyFunctor_linear (C := ModuleCat.{u} A) A i
  have hann : Ideal.span (Set.range f) ≤ Module.annihilator A (H.obj K₁) := by
    rw [Ideal.span_le]
    rintro a ⟨j, rfl⟩
    apply Module.mem_annihilator.mpr
    intro x
    have heq : f j • 𝟙 (H.obj K₁) = 0 := by
      calc
        f j • 𝟙 (H.obj K₁) = H.map (f j • 𝟙 K₁) := by simp
        _ = 0 := by rw [koszul_generator_smul_id_eq_zero f j]; simp
    have hx := congrArg (fun h : H.obj K₁ ⟶ H.obj K₁ => h x) heq
    change f j • x = (0 : H.obj K₁) at hx
    exact hx
  intro x
  refine ⟨1, by omega, ?_⟩
  intro a ha
  exact (Module.mem_annihilator.mp (hann (by simpa using ha))) x

/-- Derived reduction controls positive cohomology after tensoring with a Koszul complex. -/
private theorem nonpositive_derivedTensorProduct_koszul_of_mod_ideal
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (K : DerivedCategory (ModuleCat.{u} A))
    (h₂ : ∀ i : ℤ, 0 < i →
      IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj
        (((canonicalDerivedTensorProductFunctor A).obj K).obj
          ((DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj
            (ModuleCat.of A (A ⧸ Ideal.span (Set.range f))))))) :
    ∀ i : ℤ, 0 < i →
      IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj
        (((canonicalDerivedTensorProductFunctor A).obj K).obj
          (DerivedCategory.Q.obj
            ((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} A)).obj
              (Koszul.seqComplex f))))) := by
  let K₁ : DerivedCategory (ModuleCat.{u} A) := DerivedCategory.Q.obj
    ((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} A)).obj
      (Koszul.seqComplex f))
  let hK₁ := koszul_derived_isBounded f
  let M : DerivedCategory.Bounded (ModuleCat.{u} A) :=
    ⟨K₁, ⟨⟨-(r : ℤ), hK₁.1⟩, ⟨0, hK₁.2⟩⟩⟩
  exact (positive_homology_derivedTensorProduct_isZero_of_mod_ideal
    (Ideal.span (Set.range f)) K h₂).2.2 M
    (by intro i; exact koszul_derived_homology_power_torsion f i)
    (by intro i hi; exact (DerivedCategory.isLE_iff K₁ 0).1 hK₁.2 i hi)

/-- A derived complete complex has no positive cohomology if multiplication by one element
of the defining ideal has a nonpositive cone. -/
private theorem positive_homology_isZero_of_cone_smul
    {A : Type u} [CommRing A]
    [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A))]
    (I : Ideal A) (hI : I.FG)
    (L N : DerivedCategory (ModuleCat.{u} A))
    (hL : IsDerivedComplete I L)
    (f : A) (hf : f ∈ I)
    (b : L ⟶ N) (c : N ⟶ L⟦(1 : ℤ)⟧)
    (hT : Triangle.mk (f • 𝟙 L) b c ∈ distTriang _)
    (hN : N.IsLE 0) :
    L.IsLE 0 := by
  let : HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A)) :=
    Stacks.DerivedProducts.hasProductsOfShape_derivedCategory
  let : HasExactLimitsOfShape (Discrete ℕ) (ModuleCat.{u} A) :=
    moduleCat_hasExactLimitsOfShape_discrete.{u} A ℕ
  have hcomplete (i : ℤ) :
      IsDerivedCompleteModule I
        ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj L) :=
    ((AdicWeakSerre.derivedCompleteModules_isWeakSerreClass_and_homology_iff A I).2 L).2 hL i
  apply (DerivedCategory.isLE_iff L 0).2
  intro i hi
  let H := DerivedCategory.homologyFunctor (ModuleCat.{u} A) i
  let : Functor.Linear A H :=
    DerivedCategory.homologyFunctor_linear (C := ModuleCat.{u} A) A i
  have hz : IsZero (H.obj N) := (DerivedCategory.isLE_iff N 0).1 hN i hi
  have hb : H.map b = 0 := hz.eq_zero_of_tgt _
  have hepi : Epi (H.map (f • 𝟙 L)) := by
    exact (ShortComplex.exact_iff_epi _ hb).mp
      (DerivedCategory.HomologySequence.exact₂ (Triangle.mk (f • 𝟙 L) b c) hT i)
  have hmap : H.map (f • 𝟙 L) = f • 𝟙 (H.obj L) := by
    simp
  rw [hmap] at hepi
  have hsurj : Function.Surjective (fun x : H.obj L => f • x) := by
    intro x
    obtain ⟨y, hy⟩ :=
      (ModuleCat.epi_iff_surjective (f • 𝟙 (H.obj L))).mp hepi x
    exact ⟨y, by simpa [← ModuleCat.lsmul_eq_smul_id, LinearMap.lsmul_apply] using hy⟩
  have hsub : Subsingleton (H.obj L) :=
    subsingleton_of_isDerivedCompleteModule_of_quotient_smul
      A I (H.obj L) hI (hcomplete i)
      (subsingleton_quotient_smul_of_surjective_smul I (H.obj L) f hf hsurj)
  exact ModuleCat.isZero_of_subsingleton _

/-- Derived tensoring a nonpositively concentrated complex with a module keeps it
nonpositively concentrated. -/
private theorem nonpositive_tensor_module {A : Type u} [CommRing A]
    (K : DerivedCategory (ModuleCat.{u} A))
    (hK : K.IsLE 0) (M : ModuleCat.{u} A) :
    (((canonicalDerivedTensorProductFunctor A).obj K).obj
      ((DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj M)).IsLE 0 := by
  let e : ModuleCat.of A (A ⧸ (⊥ : Ideal A)) ≅ ModuleCat.of A A :=
    (AlgEquiv.quotientBot A A).toLinearEquiv.toModuleIso
  let E := ((canonicalDerivedTensorProductFunctor A).obj K).mapIso
    ((DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).mapIso e) ≪≫
      derivedTensorProductRightUnitorIso K
  have hzero : ∀ i : ℤ, 0 < i → IsZero
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj
        (((canonicalDerivedTensorProductFunctor A).obj K).obj
          ((DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj
            (ModuleCat.of A (A ⧸ (⊥ : Ideal A)))))) := by
    intro i hi
    exact ((DerivedCategory.isLE_iff K 0).mp hK i hi).of_iso
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).mapIso E)
  apply (DerivedCategory.isLE_iff _ 0).mpr
  apply (positive_homology_derivedTensorProduct_isZero_of_mod_ideal
    (⊥ : Ideal A) K hzero).2.1 M
  intro x
  refine ⟨1, by omega, ?_⟩
  intro a ha
  have : a = 0 := by simpa using ha
  simp [this]

/-! ### Comparing the cochain mapping cone with the explicit cone complex -/

section ConeBridgeSection

open HomologicalComplex CochainComplex MonoidalCategory

namespace ConeBridge

variable {R : Type u} [CommRing R]
variable (A B : ChainComplex (ModuleCat.{u} R) ℕ) (g : A ⟶ B)

/-- The embedding of `ℕ`-indexed chain complexes into `ℤ`-indexed cochain complexes. -/
private abbrev E := ComplexShape.embeddingDownNat

/-- The cochain mapping cone of the extension of `g`. -/
private abbrev C := mappingCone (extendMap g E)

/-- The projection of the cone onto the term of `B`. -/
private abbrev S (n : ℕ) : (C A B g).X (E.f n) ⟶ B.X n :=
  (mappingCone.snd (extendMap g E)).v _ _ (add_zero _) ≫ (B.extendXIso E rfl).hom

/-- The projection of the cone onto the term of `A`. -/
private abbrev P (n : ℕ) : (C A B g).X (E.f (n+1)) ⟶ A.X n :=
  (mappingCone.fst (extendMap g E)).1.v _ _
      (by simp only [E, ComplexShape.embeddingDownNat_f]; omega) ≫
    (A.extendXIso E rfl).hom

/-- The comparison of the restricted cochain mapping cone with the explicit cone complex,
componentwise. -/
private noncomputable def cmp : (n : ℕ) →
    ((C A B g).restriction E).X n ⟶ (Stacks.MappingCone.NatIndexed.coneComplex A B g).X n
  | 0 => S A B g 0
  | n+1 => ModuleCat.ofHom ((S A B g (n+1)).hom.prod (P A B g n).hom)

private theorem d_S (n : ℕ) :
    (C A B g).d (E.f (n+1)) (E.f n) ≫ S A B g n =
      P A B g n ≫ g.f n + S A B g (n+1) ≫ B.d (n+1) n := by
  dsimp [S, P]
  rw [mappingCone.d_snd_v_assoc _ _ _ (by simp only [E, ComplexShape.embeddingDownNat_f]; omega)]
  simp [extendMap_f _ _ rfl, extend_d_eq B E (i := n+1) (j := n) rfl rfl]

private theorem d_P (n : ℕ) :
    (C A B g).d (E.f (n+2)) (E.f (n+1)) ≫ P A B g n =
      -(P A B g (n+1) ≫ A.d (n+1) n) := by
  dsimp [P]
  rw [mappingCone.d_fst_v_assoc _ _ _ _
    (by simp only [E, ComplexShape.embeddingDownNat_f]; omega)
    (by simp only [E, ComplexShape.embeddingDownNat_f]; omega)]
  simp [extend_d_eq A E (i := n+1) (j := n) rfl rfl]

private theorem cmp_comm (n : ℕ) :
    cmp A B g (n+1) ≫ (Stacks.MappingCone.NatIndexed.coneComplex A B g).d (n+1) n =
      ((C A B g).restriction E).d (n+1) n ≫ cmp A B g n := by
  have hs := d_S A B g n
  cases n with
  | zero =>
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    have hx := congrArg (fun k => (k : (C A B g).X (-1) ⟶ B.X 0) x) hs
    change (B.d 1 0) (S A B g 1 x) + (g.f 0) (P A B g 0 x) = _
    change S A B g 0 ((C A B g).d (E.f 1) (E.f 0) x) =
      g.f 0 (P A B g 0 x) + B.d 1 0 (S A B g 1 x) at hx
    exact (add_comm _ _).trans hx.symm
  | succ n =>
    have hp := d_P A B g n
    apply ModuleCat.hom_ext
    apply LinearMap.ext
    intro x
    simp only [Stacks.MappingCone.NatIndexed.coneComplex, ChainComplex.of_d]
    apply Prod.ext
    · have hx := congrArg (fun k => (k : (C A B g).X (E.f (n+2)) ⟶ B.X (n+1)) x) hs
      change (B.d (n+2) (n+1)) (S A B g (n+2) x) +
        (g.f (n+1)) (P A B g (n+1) x) = _
      change S A B g (n+1) ((C A B g).d (E.f (n+2)) (E.f (n+1)) x) =
        g.f (n+1) (P A B g (n+1) x) + B.d (n+2) (n+1) (S A B g (n+2) x) at hx
      exact (add_comm _ _).trans hx.symm
    · have hx := congrArg (fun k => (k : (C A B g).X (E.f (n+2)) ⟶ A.X n) x) hp
      change -((A.d (n+1) n) (P A B g (n+1) x)) = _
      exact hx.symm

/-- The comparison of the restricted cochain mapping cone with the explicit cone complex. -/
private noncomputable def cmpHom : (C A B g).restriction E ⟶
    Stacks.MappingCone.NatIndexed.coneComplex A B g :=
  ChainComplex.ofHom (cmp A B g) (cmp_comm A B g)

private theorem cofiber_XIsoBiprod_hom_snd
    {F G : CochainComplex (ModuleCat.{u} R) ℤ} (q : F ⟶ G)
    (i j : ℤ) (h : (ComplexShape.up ℤ).Rel i j) :
    (homotopyCofiber.XIsoBiprod q i j h).hom ≫ biprod.snd =
      homotopyCofiber.sndX q i := by
  obtain rfl := (ComplexShape.up ℤ).next_eq' h
  simp [homotopyCofiber.sndX]

private theorem cmp_isIso (n : ℕ) : IsIso (cmp A B g n) := by
  cases n with
  | zero =>
    let q := extendMap g E
    let j : B.X 0 ⟶ (C A B g).X (E.f 0) :=
      (B.extendXIso E rfl).inv ≫ (mappingCone.inr q).f (E.f 0)
    have hzero : IsZero ((A.extend E).X (1 : ℤ)) :=
      A.isZero_extend_X E 1 (by intro n; simp only [E, ComplexShape.embeddingDownNat_f]; omega)
    change IsIso (S A B g 0)
    refine ⟨⟨j, ?_, ?_⟩⟩
    · dsimp [cmp, S, j, q]
      simp only [Category.assoc, Iso.hom_inv_id_assoc]
      apply mappingCone.ext_to q _ 1 (by simp [E])
      · exact hzero.eq_of_tgt _ _
      · simp [q]
    · simp [S, j, q]
  | succ n =>
    let q := extendMap g E
    let e := homotopyCofiber.XIsoBiprod q (E.f (n+1)) (E.f n)
      (by simp [E]) ≪≫
      biprod.mapIso (A.extendXIso E (i := n) rfl) (B.extendXIso E (i := n+1) rfl) ≪≫
      biprod.braiding (A.X n) (B.X (n+1)) ≪≫ ModuleCat.biprodIsoProd _ _
    -- Both projections are stated through the homotopy cofiber, the spelling in which `e` is
    -- built, so that the comparison below never has to identify the two.
    change IsIso (ModuleCat.ofHom
      ((homotopyCofiber.sndX q (E.f (n+1)) ≫ (B.extendXIso E (i := n+1) rfl).hom).hom.prod
        (homotopyCofiber.fstX q (E.f (n+1)) (E.f n) (by simp [E]) ≫
          (A.extendXIso E (i := n) rfl).hom).hom))
    have he : ModuleCat.ofHom
        ((homotopyCofiber.sndX q (E.f (n+1)) ≫ (B.extendXIso E (i := n+1) rfl).hom).hom.prod
          (homotopyCofiber.fstX q (E.f (n+1)) (E.f n) (by simp [E]) ≫
            (A.extendXIso E (i := n) rfl).hom).hom) = e.hom := by
      refine (cancel_mono (ModuleCat.biprodIsoProd (B.X (n+1)) (A.X n)).inv).mp ?_
      apply biprod.hom_ext
      · simp only [Category.assoc, ModuleCat.biprodIsoProd_inv_comp_fst]
        change homotopyCofiber.sndX q (E.f (n+1)) ≫ (B.extendXIso E (i := n+1) rfl).hom = _
        simp [e, ← ModuleCat.biprodIsoProd_inv_comp_fst]
        simp [← Category.assoc, cofiber_XIsoBiprod_hom_snd]
      · simp only [Category.assoc, ModuleCat.biprodIsoProd_inv_comp_snd]
        change homotopyCofiber.fstX q (E.f (n+1)) (E.f n) (by simp [E]) ≫
          (A.extendXIso E (i := n) rfl).hom = _
        simp [e, homotopyCofiber.fstX, ← ModuleCat.biprodIsoProd_inv_comp_snd]
    rw [he]
    infer_instance

/-- The cochain mapping cone of the extension of `g` is the extension of the explicit cone
complex of `g`.

This is the one member of `ConeBridge` that consumers outside this file need: the comparison is
built here componentwise from the helpers above, which stay private. Its type is spelled out
rather than written through the private abbreviations `C` and `E`. -/
@[no_expose] noncomputable def coneIso :
    mappingCone (extendMap g ComplexShape.embeddingDownNat) ≅
      (Stacks.MappingCone.NatIndexed.coneComplex A B g).extend
        ComplexShape.embeddingDownNat := by
  let φ := cmpHom A B g
  have hφ : E.HasLift φ := by
    intro j hj
    exact hj.false_of_isTruncLE.elim
  let ψ := E.liftExtend φ hφ
  have hψ (i : ℤ) : IsIso (ψ.f i) := by
    by_cases hi : ∃ n, E.f n = i
    · obtain ⟨n, hn⟩ := hi
      apply (E.isIso_liftExtend_f_iff φ hφ hn).mpr
      exact cmp_isIso A B g n
    · have hip : 0 < i := by
        by_contra h
        apply hi
        refine ⟨(-i).toNat, ?_⟩
        change -(((-i).toNat : ℕ) : ℤ) = i
        rw [Int.toNat_of_nonneg (show 0 ≤ -i by omega)]
        omega
      have hz (D : ChainComplex (ModuleCat.{u} R) ℕ) (j : ℤ) (hj : 0 < j) :
          IsZero ((D.extend E).X j) :=
        D.isZero_extend_X E j (by intro n; simp only [E, ComplexShape.embeddingDownNat_f]; omega)
      have hc : IsZero ((C A B g).X i) :=
        (mappingCone.isZero_X_iff _ i).mpr ⟨hz A (i+1) (by omega), hz B i hip⟩
      have ht := hz (Stacks.MappingCone.NatIndexed.coneComplex A B g) i hip
      exact IsZero.isIso hc ht _
  letI := hψ
  letI := HomologicalComplex.Hom.isIso_of_components ψ
  exact asIso ψ

end ConeBridge

end ConeBridgeSection

/-! ### The induction on the length of the sequence -/

/-- The Koszul complex of an empty sequence is the tensor unit.

Stated at an arbitrary model `[HasDerivedCategory.{w} (ModuleCat.{u} A)]` rather than at the
file's ambient `CategoryTheory.HasDerivedCategory.standard`: the isomorphism is the image under
`DerivedCategory.Q` of an isomorphism of cochain complexes, so it exists at every chosen derived
category. Consumers needing `D(A)` with small morphisms can therefore instantiate this form. -/
private noncomputable def koszul_empty_iso_single {A : Type u} [CommRing A]
    [HasDerivedCategory.{w} (ModuleCat.{u} A)]
    (f : Fin 0 → A) :
    DerivedCategory.Q.obj ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat) ≅
      (DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj (ModuleCat.of A A) := by
  let S := (HomologicalComplex.single (ModuleCat.{u} A) (ComplexShape.down ℕ) 0).obj
    (ModuleCat.of A A)
  let e (n : ℕ) : (Koszul.seqComplex f).X n ≅ S.X n := by
    by_cases hn : n = 0
    · subst n
      exact (exteriorPower.zeroEquiv A (Fin 0 → A)).toModuleIso ≪≫
        (HomologicalComplex.singleObjXSelf _ _ _).symm
    · exact (Koszul.seqComplex_isZero_of_lt f n (by omega)).iso
        (HomologicalComplex.isZero_single_obj_X _ _ _ _ hn)
  let eK : Koszul.seqComplex f ≅ S :=
    HomologicalComplex.Hom.isoOfComponents e (by
      intro i j hij
      apply (Koszul.seqComplex_isZero_of_lt f i (by change j+1=i at hij; omega)).eq_of_src)
  exact DerivedCategory.Q.mapIso
    ((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} A)).mapIso eK ≪≫
      HomologicalComplex.extendSingleIso _ _ 0 0 rfl)

/-- Adjoining a Koszul generator gives the distinguished triangle of multiplication. -/
private theorem tensor_koszul_snoc_triangle {A : Type u} [CommRing A]
    {r : ℕ} (f : Fin r → A) (a : A) (K : DerivedCategory (ModuleCat.{u} A)) :
    let L := ((canonicalDerivedTensorProductFunctor A).obj K).obj
      (DerivedCategory.Q.obj ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat))
    let N := ((canonicalDerivedTensorProductFunctor A).obj K).obj
      (DerivedCategory.Q.obj
        ((Koszul.seqComplex (Fin.snoc f a)).extend ComplexShape.embeddingDownNat))
    ∃ (b : L ⟶ N) (c : N ⟶ L⟦(1 : ℤ)⟧),
      Triangle.mk (a • 𝟙 L) b c ∈ distTriang _ := by
  dsimp only
  let C := Koszul.seqComplex f
  let g := Stacks.MappingCone.NatIndexed.mulByF C a
  let E := ComplexShape.embeddingDownNat
  let F := (canonicalDerivedTensorProductFunctor A).obj K
  let q := HomologicalComplex.extendMap g E
  obtain ⟨eK⟩ := Koszul.seqComplex_snoc_iso_cone f a
  let eC : CochainComplex.mappingCone q ≅ (Koszul.seqComplex (Fin.snoc f a)).extend E :=
    ConeBridge.coneIso C C g ≪≫ (E.extendFunctor (ModuleCat.{u} A)).mapIso eK.symm
  let T := F.mapTriangle.obj
    (DerivedCategory.Q.mapTriangle.obj (CochainComplex.mappingCone.triangle q))
  let e := F.mapIso (DerivedCategory.Q.mapIso eC)
  have hT : T ∈ distTriang _ := F.map_distinguished _
    (DerivedCategory.mappingCone_triangle_distinguished q)
  have h₁ : T.mor₁ = a • 𝟙 (F.obj (DerivedCategory.Q.obj (C.extend E))) := by
    change F.map (DerivedCategory.Q.map (HomologicalComplex.extendMap (a • 𝟙 C) E)) = _
    rw [extendMap_smul_id, Functor.map_smul, DerivedCategory.Q.map_id,
      Stacks.DerivedTensor.map_smul_id_right]
  refine ⟨T.mor₂ ≫ e.hom, e.inv ≫ T.mor₃, ?_⟩
  let T' := Triangle.mk (a • 𝟙 (F.obj (DerivedCategory.Q.obj (C.extend E))))
    (T.mor₂ ≫ e.hom) (e.inv ≫ T.mor₃)
  have eT : T ≅ T' := Triangle.isoMk T T' (Iso.refl _) (Iso.refl _) e
    (by
      change T.mor₁ ≫ 𝟙 _ = 𝟙 _ ≫ (a • 𝟙 _)
      rw [Category.comp_id, Category.id_comp]
      exact h₁)
    (by
      change T.mor₂ ≫ e.hom = 𝟙 _ ≫ (T.mor₂ ≫ e.hom)
      rw [Category.id_comp])
    (by
      change T.mor₃ ≫ (CategoryTheory.shiftFunctor _ (1 : ℤ)).map (𝟙 _) =
        e.hom ≫ (e.inv ≫ T.mor₃)
      rw [CategoryTheory.Functor.map_id, Category.comp_id]
      exact (Iso.hom_inv_id_assoc e T.mor₃).symm)
  change T' ∈ distTriang _
  exact Pretriangulated.isomorphic_distinguished T hT T' eT.symm

/-- Koszul tensoring preserves completeness and detects a nonpositive bound. -/
private theorem tensor_koszul_complete_and_isLE {A : Type u} [CommRing A]
    [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A))]
    (I : Ideal A) (hI : I.FG) (K : DerivedCategory (ModuleCat.{u} A))
    (hK : IsDerivedComplete I K) (r : ℕ) (f : Fin r → A)
    (hf : ∀ i, f i ∈ I) :
    let L := ((canonicalDerivedTensorProductFunctor A).obj K).obj
      (DerivedCategory.Q.obj ((Koszul.seqComplex f).extend ComplexShape.embeddingDownNat))
    IsDerivedComplete I L ∧ (L.IsLE 0 → K.IsLE 0) := by
  induction r with
  | zero =>
    let e := ((canonicalDerivedTensorProductFunctor A).obj K).mapIso
      (koszul_empty_iso_single f) ≪≫ derivedTensorProductRightUnitorIso K
    refine ⟨DerivedCompleteRecurrence.isDerivedComplete_of_iso e.symm hK, ?_⟩
    intro h
    apply (DerivedCategory.isLE_iff K 0).mpr
    intro i hi
    exact ((DerivedCategory.isLE_iff _ 0).mp h i hi).of_iso
      ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).mapIso e.symm)
  | succ r ih =>
    let f₀ := Fin.init f
    let a := f (Fin.last r)
    have hf₀ : ∀ i, f₀ i ∈ I := fun i => hf i.castSucc
    have he : Fin.snoc f₀ a = f := Fin.snoc_init_self f
    obtain ⟨hL, hdetect⟩ := ih f₀ hf₀
    have htri := tensor_koszul_snoc_triangle f₀ a K
    dsimp only at htri
    rw [he] at htri
    obtain ⟨b, c, hT⟩ := htri
    refine ⟨isDerivedComplete_of_distinguished_triangle I _ hT hL hL, ?_⟩
    intro hN
    exact hdetect (positive_homology_isZero_of_cone_smul I hI _ _ hL a
      (hf (Fin.last r)) b c hT hN)

/-! ### Stacks 0H83 -/

/-- **Stacks Project, Tag 0H83.** For a complex derived complete with respect to the ideal
generated by a finite sequence, the following are equivalent: it has no positive cohomology,
its derived reduction modulo that ideal has no positive cohomology, and its derived tensor
product with the Koszul complex of the sequence has no positive cohomology. -/
@[stacks 0H83]
theorem positive_homology_isZero_iff_derivedTensorProduct_mod_ideal_iff_koszul
    {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A)
    (K : DerivedCategory (ModuleCat.{u} A)) :
    letI : HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A)) :=
      Stacks.DerivedProducts.hasProductsOfShape_derivedCategory
    IsDerivedComplete (Ideal.span (Set.range f)) K →
    let I := Ideal.span (Set.range f)
    let K₁ : DerivedCategory (ModuleCat.{u} A) :=
      DerivedCategory.Q.obj
        ((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} A)).obj
          (Koszul.seqComplex f))
    let p₁ := ∀ i : ℤ, 0 < i →
      IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj K)
    let p₂ := ∀ i : ℤ, 0 < i →
      IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj
        (((canonicalDerivedTensorProductFunctor A).obj K).obj
          ((DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj
            (ModuleCat.of A (A ⧸ I)))))
    let p₃ := ∀ i : ℤ, 0 < i →
      IsZero ((DerivedCategory.homologyFunctor (ModuleCat.{u} A) i).obj
        (((canonicalDerivedTensorProductFunctor A).obj K).obj K₁))
    (p₁ ↔ p₂) ∧ (p₂ ↔ p₃) := by
  let : HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A)) :=
    Stacks.DerivedProducts.hasProductsOfShape_derivedCategory
  intro hK
  dsimp only
  have h₁₂ : K.IsLE 0 →
      (((canonicalDerivedTensorProductFunctor A).obj K).obj
        ((DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj
          (ModuleCat.of A (A ⧸ Ideal.span (Set.range f))))).IsLE 0 :=
    fun h => nonpositive_tensor_module K h _
  have h₂₃ := nonpositive_derivedTensorProduct_koszul_of_mod_ideal f K
  have h₃₁ := (tensor_koszul_complete_and_isLE (Ideal.span (Set.range f))
    (Submodule.fg_span (Set.finite_range f)) K hK r f
    (fun i => Ideal.subset_span (Set.mem_range_self i))).2
  constructor
  · constructor
    · intro h
      exact (DerivedCategory.isLE_iff _ 0).mp (h₁₂ ((DerivedCategory.isLE_iff K 0).mpr h))
    · intro h
      exact (DerivedCategory.isLE_iff K 0).mp
        (h₃₁ ((DerivedCategory.isLE_iff _ 0).mpr (h₂₃ h)))
  · constructor
    · exact h₂₃
    · intro h
      exact (DerivedCategory.isLE_iff _ 0).mp
        (h₁₂ (h₃₁ ((DerivedCategory.isLE_iff _ 0).mpr h)))

/-! ### Stacks 0G1U -/

/-- **Derived Nakayama lemma, Stacks Project, Tag 0G1U.** A derived-complete complex with
respect to a finitely generated ideal is zero if its derived reduction modulo that ideal is
zero. -/
@[stacks 0G1U]
theorem isZero_of_isDerivedComplete_of_derivedTensorProduct_mod_ideal_isZero
    {A : Type u} [CommRing A] (I : Ideal A) (hI : I.FG)
    (K : DerivedCategory (ModuleCat.{u} A)) :
    letI : HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A)) :=
      Stacks.DerivedProducts.hasProductsOfShape_derivedCategory
    IsDerivedComplete I K →
      IsZero
        (((canonicalDerivedTensorProductFunctor A).obj K).obj
          ((DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj
            (ModuleCat.of A (A ⧸ I)))) →
      IsZero K := by
  let : HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A)) :=
    Stacks.DerivedProducts.hasProductsOfShape_derivedCategory
  intro hcomp hred
  obtain ⟨r, f, hf⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hI
  rw [← hf] at hcomp hred
  rw [DerivedCategory.isZero_iff_forall_isZero_homology]
  intro n
  let a : ℤ := n - 1
  let Ks := K⟦a⟧
  have hmods := (AdicWeakSerre.derivedCompleteModules_isWeakSerreClass_and_homology_iff
    A (Ideal.span (Set.range f))).2 K |>.mpr hcomp
  have hweak := (AdicWeakSerre.derivedCompleteModules_isWeakSerreClass_and_homology_iff
    A (Ideal.span (Set.range f))).1
  let C : ObjectProperty (ModuleCat.{u} A) := fun M =>
    IsDerivedCompleteModule (Ideal.span (Set.range f)) M
  let : C.IsWeakSerreClass := hweak
  have hcomps : IsDerivedComplete (Ideal.span (Set.range f)) Ks := by
    apply (AdicWeakSerre.derivedCompleteModules_isWeakSerreClass_and_homology_iff
      A (Ideal.span (Set.range f))).2 Ks |>.mp
    intro i
    set F := DerivedCategory.homologyFunctor (ModuleCat.{u} A) 0
    change IsDerivedCompleteModule (Ideal.span (Set.range f)) ((F.shift i).obj Ks)
    exact C.prop_of_iso ((F.shiftIso a i (a + i) rfl).app K).symm (hmods (a + i))
  have hreds : IsZero
      (((canonicalDerivedTensorProductFunctor A).obj Ks).obj
        ((DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj
          (ModuleCat.of A (A ⧸ Ideal.span (Set.range f))))) := by
    let Q := (DerivedCategory.singleFunctor (ModuleCat.{u} A) 0).obj
      (ModuleCat.of A (A ⧸ Ideal.span (Set.range f)))
    exact (Functor.map_isZero (shiftFunctor _ a) hred).of_iso
      ((Functor.commShiftIso
        ((canonicalDerivedTensorProductFunctor A).flip.obj Q) a).app K)
  have hp :=
    (positive_homology_isZero_iff_derivedTensorProduct_mod_ideal_iff_koszul
      f Ks hcomps).1
  have hz := hp.2 (fun i _ => Functor.map_isZero _ hreds) 1 (by omega)
  set F := DerivedCategory.homologyFunctor (ModuleCat.{u} A) 0
  change IsZero ((F.shift n).obj K)
  exact hz.of_iso ((F.shiftIso a 1 n (by simp [a])).app K).symm

end KoszulTensorVanishing

