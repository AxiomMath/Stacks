/-!
# The kernel of principal adic completion of a derived complete module

Let `A` be a commutative ring, `f : A`, and let `J = ⋂ₙ (f)ⁿ` be the intersection of all powers
of the principal ideal generated by `f`. If an `A`-module `M` is derived complete with respect to
`(f)`, then `J` annihilates the kernel of the canonical map `M → M^` to the `f`-adic completion.
Applied to `A` itself this says that `J` is square-zero whenever `A` is derived complete with
respect to `(f)`.

## Main definitions

There are no new definitions; derived completeness is
`IsDerivedCompleteModule` of `StacksFrontier.Homology.DerivedComplete`.

## Main results

* `PrincipalCompletionKernel.iInf_principal_powers_annihilates_ker_adicCompletion`: the
  intersection of the powers of `(f)` annihilates the completion kernel, together with the
  square-zero corollary for the ring itself.

## Implementation notes

Derived completeness is the predicate `IsDerivedCompleteModule` of
`StacksFrontier.Homology.DerivedComplete`, namely that `1 - f · shift` is an isomorphism on the
countable product of the module (placed in degree zero) with itself; by
`isDerivedComplete_iff_forall_exists_isDerivedLimit_isZero` this is the vanishing derived limit
of Stacks 091S. The inverse limit of the quotients `M / fⁿ M` is Mathlib's
`AdicCompletion (Ideal.span {f}) M` with its canonical map `AdicCompletion.of`. The ring and
module universes are independent, so both countable-product hypotheses are supplied by Stacks
07KC rather than assumed; the compatible-sequence module used in the proof is built inside the
universe of the module.

## References

* [The Stacks Project, Tag 0G3G](https://stacks.math.columbia.edu/tag/0G3G)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated

attribute [local instance] HasDerivedCategory.standard

noncomputable section

universe u v

namespace PrincipalCompletionKernel

private lemma eq_zero_of_smul_succ
    (A : Type u) [CommRing A] (f : A) (M : Type v)
    [AddCommGroup M] [Module A M]
    [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{v} A))]
    (hcomplete : IsDerivedCompleteModule (Ideal.span ({f} : Set A)) (ModuleCat.of A M))
    (y : ℕ → M) (hy : ∀ n, y n = f • y (n + 1)) : y 0 = 0 := by
  let K := (DerivedCategory.singleFunctor (ModuleCat.{v} A) 0).obj (ModuleCat.of A M)
  have hδ : IsIso (Pi.lift fun n : ℕ =>
      Pi.π (fun _ : ℕ => K) n - f • Pi.π (fun _ : ℕ => K) (n + 1)) := by
    have h : IsIso (Pi.lift fun n : ℕ =>
        Pi.π (fun _ : ℕ => K) n - Pi.π (fun _ : ℕ => K) (n + 1) ≫ (f • 𝟙 K)) :=
      hcomplete f (Ideal.subset_span (Set.mem_singleton f))
    simpa only [Linear.comp_smul, Category.comp_id] using h
  -- The module of compatible sequences lives in the universe of M, even when A is larger.
  let S : Submodule A (ℕ → M) :=
    { carrier := {z | ∀ n, z n = f • z (n + 1)}
      zero_mem' := by simp
      add_mem' := by
        intro z w hz hw n
        change z n + w n = f • (z (n + 1) + w (n + 1))
        rw [hz n, hw n, smul_add]
      smul_mem' := by
        intro a z hz n
        change a • z n = f • (a • z (n + 1))
        rw [hz n, smul_comm a f] }
  let ev (n : ℕ) : ModuleCat.of A S ⟶ ModuleCat.of A M :=
    ModuleCat.ofHom
      { toFun := fun z => z.val n
        map_add' := fun _ _ => rfl
        map_smul' := fun _ _ => rfl }
  let sS := (DerivedCategory.singleFunctor (ModuleCat.{v} A) 0).obj (ModuleCat.of A S)
  let v (n : ℕ) : sS ⟶ K :=
    (DerivedCategory.singleFunctor (ModuleCat.{v} A) 0).map (ev n)
  have hv (n : ℕ) : v n = f • v (n + 1) := by
    dsimp only [v]
    rw [← CategoryTheory.Functor.map_smul]
    congr 1
    ext z
    exact z.property n
  let q : sS ⟶ ∏ᶜ fun _ : ℕ => K := Pi.lift v
  have hq : q ≫ (Pi.lift fun n : ℕ =>
      Pi.π (fun _ : ℕ => K) n - f • Pi.π (fun _ : ℕ => K) (n + 1)) = 0 := by
    apply Limits.Pi.hom_ext
    intro n
    simp only [Category.assoc, Pi.lift_comp_π, Preadditive.comp_sub, Linear.comp_smul,
      zero_comp, q]
    exact sub_eq_zero.mpr (hv n)
  have hqzero : q = 0 := by
    rw [← cancel_mono (Pi.lift fun n : ℕ =>
      Pi.π (fun _ : ℕ => K) n - f • Pi.π (fun _ : ℕ => K) (n + 1))]
    rw [hq, zero_comp]
  have hvzero : v 0 = 0 := by
    rw [← Pi.lift_comp_π v 0]
    change q ≫ Pi.π (fun _ : ℕ => K) 0 = 0
    rw [hqzero, zero_comp]
  have hevzero : ev 0 = 0 := by
    apply (DerivedCategory.singleFunctor (ModuleCat.{v} A) 0).map_injective
    simpa only [Functor.map_zero] using hvzero
  exact LinearMap.congr_fun (congr_arg ModuleCat.Hom.hom hevzero) ⟨y, hy⟩

private lemma annihilates_of_smul_succ
    (A : Type u) [CommRing A] (f : A) (N : Type v) [AddCommGroup N] [Module A N]
    (hseq : ∀ y : ℕ → N, (∀ n, y n = f • y (n + 1)) → y 0 = 0) :
    (⨅ n : ℕ, (Ideal.span ({f} : Set A)) ^ n) •
      (AdicCompletion.of (Ideal.span ({f} : Set A)) N).ker = ⊥ := by
  let I := Ideal.span ({f} : Set A)
  rw [eq_bot_iff]
  intro z hz
  rw [Submodule.mem_bot]
  refine Submodule.smul_induction_on hz ?_ fun a b ha hb => by simp [ha, hb]
  intro g hg x hx
  have hxpow : ∀ n : ℕ, ∃ x' : N, x = f ^ n • x' := by
    intro n
    have hof : AdicCompletion.of I N x = 0 := (LinearMap.mem_ker.mp hx)
    rw [AdicCompletion.ext_iff] at hof
    have hmem : x ∈ I ^ n • (⊤ : Submodule A N) := by
      simpa [AdicCompletion.of_apply, Submodule.Quotient.mk_eq_zero] using hof n
    rw [show I ^ n = Ideal.span ({f ^ n} : Set A) by
      simp [I, Ideal.span_singleton_pow], Submodule.ideal_span_singleton_smul] at hmem
    obtain ⟨x', -, hx'⟩ :=
      (Submodule.mem_smul_pointwise_iff_exists x (f ^ n) (⊤ : Submodule A N)).mp hmem
    exact ⟨x', hx'.symm⟩
  choose x' hx' using hxpow
  have hgpow : ∀ n : ℕ, ∃ a : A, g = f ^ n * a := by
    intro n
    have hn : g ∈ I ^ n := (iInf_le (fun n : ℕ => I ^ n) n) hg
    rw [show I ^ n = Ideal.span ({f ^ n} : Set A) by
      simp [I, Ideal.span_singleton_pow], Ideal.mem_span_singleton] at hn
    exact hn
  let y : ℕ → N := fun n => g • x' (n + 1)
  have hy : ∀ n, y n = f • y (n + 1) := by
    intro n
    obtain ⟨a, ha⟩ := hgpow (n + 1)
    have heq : f ^ (n + 1) • x' (n + 1) =
        f ^ (n + 1) • (f • x' (n + 2)) := by
      calc
        f ^ (n + 1) • x' (n + 1) = x := (hx' (n + 1)).symm
        _ = f ^ (n + 2) • x' (n + 2) := hx' (n + 2)
        _ = f ^ (n + 1) • (f • x' (n + 2)) := by
          rw [show n + 2 = n + 1 + 1 by omega, pow_succ, mul_smul]
    dsimp [y]
    calc
      g • x' (n + 1) = a • (f ^ (n + 1) • x' (n + 1)) := by
        rw [ha, mul_smul]
        exact smul_comm _ _ _
      _ = a • (f ^ (n + 1) • (f • x' (n + 2))) := congrArg (a • ·) heq
      _ = f • (g • x' (n + 2)) := by
        rw [ha]
        simp only [smul_smul]
        congr 1
        ring
  have hy0 : y 0 = 0 := hseq y hy
  rw [hx' 1, pow_one, smul_comm g f]
  simpa [y] using congrArg (fun t : N => f • t) hy0

/-- **Stacks 0G3G.** Let `J` be the intersection of all powers of the principal ideal `(f)`.
If `M` is derived complete with respect to `f`, then `J` annihilates the kernel of the canonical
map from `M` to its `f`-adic completion. In particular, if `A` is derived complete with respect
to `f`, then `J` is square-zero. -/
@[stacks 0G3G]
public theorem iInf_principal_powers_annihilates_ker_adicCompletion
    (A : Type u) [CommRing A] (f : A) (M : Type v) [AddCommGroup M] [Module A M] :
    letI : HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{v} A)) :=
      Stacks.DerivedProducts.hasProductsOfShape_derivedCategory
    letI : HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A)) :=
      Stacks.DerivedProducts.hasProductsOfShape_derivedCategory
    let I := Ideal.span ({f} : Set A)
    let J := ⨅ n : ℕ, I ^ n
    (IsDerivedCompleteModule I (ModuleCat.of A M) →
      J • (AdicCompletion.of I M).ker = ⊥) ∧
    (IsDerivedCompleteModule I (ModuleCat.of A A) →
        J ^ 2 = ⊥) := by
  let : HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{v} A)) :=
    Stacks.DerivedProducts.hasProductsOfShape_derivedCategory
  let : HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A)) :=
    Stacks.DerivedProducts.hasProductsOfShape_derivedCategory
  dsimp only
  let I := Ideal.span ({f} : Set A)
  let J := ⨅ n : ℕ, I ^ n
  refine ⟨fun hcomplete => annihilates_of_smul_succ A f M (eq_zero_of_smul_succ A f M hcomplete),
    fun hcomplete => ?_⟩
  have hann := annihilates_of_smul_succ A f A (eq_zero_of_smul_succ A f A hcomplete)
  have hJker : J ≤ (AdicCompletion.of I A).ker := by
    intro g hg
    rw [LinearMap.mem_ker, AdicCompletion.ext_iff]
    intro n
    rw [AdicCompletion.of_apply]
    refine (Submodule.Quotient.mk_eq_zero _).2 ?_
    simpa [smul_eq_mul, Ideal.mul_top] using (iInf_le (fun n : ℕ => I ^ n) n) hg
  rw [pow_two, ← smul_eq_mul]
  exact le_antisymm ((Submodule.smul_mono le_rfl hJker).trans_eq hann) bot_le

end PrincipalCompletionKernel

end

end
