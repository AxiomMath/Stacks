@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated

universe u v

namespace AdicKoszulAdjunction

attribute [local instance 2000] HasDerivedCategory.standard

/-- If a unit `unit : 𝟭 C ⟶ completion` is an isomorphism at `target` and `completion` sends the
unit at `source` to an epimorphism, then precomposition with `unit.app source` is a bijection from
`completion.obj source ⟶ target` to `source ⟶ target`. -/
public theorem completion_hom_bijective
    {C : Type u} [Category.{v} C]
    (completion : C ⥤ C) (unit : 𝟭 C ⟶ completion)
    (source target : C) [IsIso (unit.app target)]
    [Epi (completion.map (unit.app source))] :
    Function.Bijective
      (fun map : completion.obj source ⟶ target => unit.app source ≫ map) := by
  constructor
  · intro g h equality
    have mapEquality : completion.map g = completion.map h :=
      (cancel_epi (completion.map (unit.app source))).1 <| by
        simpa only [Functor.map_comp] using congrArg completion.map equality
    have naturality := unit.naturality g
    rw [mapEquality, ← unit.naturality h] at naturality
    exact (cancel_mono (unit.app target)).1 (by simpa using naturality)
  · intro map
    refine ⟨completion.map map ≫ inv (unit.app target), ?_⟩
    show unit.app source ≫ (completion.map map ≫ inv (unit.app target)) = map
    have hm : unit.app source ≫ completion.map map = map ≫ unit.app target := by
      simpa using (unit.naturality map).symm
    rw [← Category.assoc, hm]
    simp

/-- The Koszul power transition maps act on wedges by multiplying by powers of the family, and the
unit chains are the unit in degree zero. -/
private theorem koszulPowerTransition_on_wedges_and_unit_on_degree_zero
    {ring : Type u} [CommRing ring] {rank : ℕ} (family : Fin rank → ring) :
    (∀ (later earlier : ℕ) (order : earlier ≤ later)
      (degree : ℕ) (vectors : Fin degree → Fin rank → ring),
      (AdicKoszul.koszulPowerTransition family later earlier order).f degree
          ⟨ExteriorAlgebra.ιMulti ring degree vectors, Koszul.ιMulti_mem degree vectors⟩ =
        ⟨ExteriorAlgebra.ιMulti ring degree
          (fun slot index => family index ^ (later - earlier) * vectors slot index),
          Koszul.ιMulti_mem degree
            (fun slot index => family index ^ (later - earlier) * vectors slot index)⟩) ∧
    ∀ (stage : ℕ) (element : ring),
      (AdicKoszul.koszulPowerUnitChain family stage).f 0 element =
        element • ⟨ExteriorAlgebra.ιMulti ring 0 (fun index => Fin.elim0 index),
          Koszul.ιMulti_mem 0 (fun index => Fin.elim0 index)⟩ := by
  have specification := Classical.choose_spec (Classical.choose_spec (Classical.choose_spec
    (Classical.choose_spec (_root_.koszulPowerComplexes_form_inverseSystem family))))
  exact ⟨specification.2.2.2.2.1, specification.2.2.2.2.2.1⟩

private theorem moduleSystem_colimit_isHomotopyColimit
    {ring : Type u} [Ring ring]
    [HasExactColimitsOfShape ℕ (ModuleCat.{v} ring)]
    (diagram : ℕ ⥤ CochainComplex (ModuleCat.{v} ring) ℤ)
    [HasCoproduct (diagram ⋙ DerivedCategory.Q).obj] :
    IsHomotopyColimit (diagram ⋙ DerivedCategory.Q)
      (DerivedCategory.Q.obj (colimit diagram)) :=
  DerivedCategory.isHomotopyColimit_Q_obj_colimit diagram

/-- For a functor `completion` with values in `P` and a unit `𝟭 C ⟶ completion` that is an
isomorphism on objects of `P` and is inverted by `completion`, morphisms from the completion of
`X` to an object `Y` of `P` correspond to morphisms `X ⟶ Y`, by precomposition with the unit. -/
public noncomputable def completionHomEquiv
    {C : Type u} [Category.{v} C] (P : ObjectProperty C)
    (completion : C ⥤ C) (unit : 𝟭 C ⟶ completion)
    (complete : ∀ X, P (completion.obj X))
    (isIso_unit : ∀ X, P X → IsIso (unit.app X))
    (isIso_map_unit : ∀ X, IsIso (completion.map (unit.app X)))
    (X : C) (Y : P.FullSubcategory) :
    ((P.lift completion complete).obj X ⟶ Y) ≃ (X ⟶ P.ι.obj Y) :=
  haveI := isIso_unit Y.obj Y.property
  haveI := isIso_map_unit X
  (ObjectProperty.fullyFaithfulι P).homEquiv.trans
    (Equiv.ofBijective _ (completion_hom_bijective completion unit X Y.obj))

/-- `completionHomEquiv` is precomposition with the unit. -/
public theorem completionHomEquiv_apply
    {C : Type u} [Category.{v} C] (P : ObjectProperty C)
    (completion : C ⥤ C) (unit : 𝟭 C ⟶ completion)
    (complete : ∀ X, P (completion.obj X))
    (isIso_unit : ∀ X, P X → IsIso (unit.app X))
    (isIso_map_unit : ∀ X, IsIso (completion.map (unit.app X)))
    (X : C) (Y : P.FullSubcategory) (g : (P.lift completion complete).obj X ⟶ Y) :
    completionHomEquiv P completion unit complete isIso_unit isIso_map_unit X Y g =
      unit.app X ≫ g.hom :=
  rfl

/-- A functor `completion` with values in `P` and a unit `𝟭 C ⟶ completion` that is an
isomorphism on objects of `P` and is inverted by `completion` is left adjoint to the inclusion of
`P`. -/
public noncomputable def reflectionOfCompletion
    {C : Type u} [Category.{v} C] (P : ObjectProperty C)
    (completion : C ⥤ C) (unit : 𝟭 C ⟶ completion)
    (complete : ∀ X, P (completion.obj X))
    (isIso_unit : ∀ X, P X → IsIso (unit.app X))
    (isIso_map_unit : ∀ X, IsIso (completion.map (unit.app X))) :
    P.lift completion complete ⊣ P.ι :=
  Adjunction.mkOfHomEquiv
    { homEquiv := completionHomEquiv P completion unit complete isIso_unit isIso_map_unit
      homEquiv_naturality_left_symm := by
        intro X' X Y g h
        rw [Equiv.symm_apply_eq]
        conv_lhs => rw [← (completionHomEquiv P completion unit complete isIso_unit
          isIso_map_unit X Y).apply_symm_apply h]
        simp only [completionHomEquiv_apply]
        rw [ObjectProperty.FullSubcategory.comp_hom, ← Category.assoc, ← Category.assoc]
        congr 1
        exact unit.naturality g
      homEquiv_naturality_right := by
        intro X Y Y' g h
        rw [completionHomEquiv_apply, completionHomEquiv_apply]
        simp }
private theorem koszulPowerDerivedLimit_reflection
    (A : Type u) [CommRing A] {r : ℕ} (f : Fin r → A)
    (T : CochainComplex.DerivedTensor.DerivedTensorProduct (ULift.{v} A))
    [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{v} A))] :
    letI : HasExactLimitsOfShape (Discrete ℕ) (ModuleCat.{max u v} (ULift.{v} A)) :=
      moduleCat_hasExactLimitsOfShape_discrete.{max u v} (ULift.{v} A) ℕ
    letI : HasProductsOfShape ℕ
        (DerivedCategory (ModuleCat.{max u v} (ULift.{v} A))) :=
      Stacks.DerivedProducts.hasProductsOfShape_derivedCategory
    let P : ObjectProperty (DerivedCategory (ModuleCat.{v} A)) :=
      fun K ↦ IsDerivedComplete (Ideal.span (Set.range f)) K
    ∃ L : DerivedCategory (ModuleCat.{v} A) ⥤ P.FullSubcategory,
      Nonempty (L ⊣ P.ι) ∧
        ∀ K, IsDerivedLimit (AdicKoszul.tensorKoszulPowerSystem f T K)
          ((AdicKoszul.derivedUniverseLift A).obj ((L ⋙ P.ι).obj K)) := by
  intro P
  let completion := KoszulCompletion.completionData f T
  have complete : ∀ object, P (completion.functor.obj object) :=
    _root_.koszulPowerCompletion_complete A f T completion
  exact ⟨P.lift completion.functor complete,
    ⟨reflectionOfCompletion P completion.functor completion.unit complete
      (fun object ↦ (_root_.canonicalCompletion_criterion f T object).1)
      (canonicalCompletion_map_unit_isIso f T)⟩,
    fun object ↦ completion.isDerivedLimit object⟩

/-- For a finite family `f`, the inclusion of the derived-complete objects into `D(A)` has a left
adjoint whose value at `K` is a derived limit of the tensor--Koszul tower of `K`. -/
public theorem koszulPowerDerivedLimitSolution
    (A : Type u) [CommRing A] {r : ℕ} (f : Fin r → A)
    (T : CochainComplex.DerivedTensor.DerivedTensorProduct (ULift.{v} A))
    [HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{v} A))] :
    letI : HasExactLimitsOfShape (Discrete ℕ) (ModuleCat.{max u v} (ULift.{v} A)) :=
      moduleCat_hasExactLimitsOfShape_discrete.{max u v} (ULift.{v} A) ℕ
    letI : HasProductsOfShape ℕ
        (DerivedCategory (ModuleCat.{max u v} (ULift.{v} A))) :=
      Stacks.DerivedProducts.hasProductsOfShape_derivedCategory
    let P : ObjectProperty (DerivedCategory (ModuleCat.{v} A)) :=
      fun K ↦ IsDerivedComplete (Ideal.span (Set.range f)) K
    ∃ L : DerivedCategory (ModuleCat.{v} A) ⥤ P.FullSubcategory,
      Nonempty (L ⊣ P.ι) ∧
        ∀ K, IsDerivedLimit (AdicKoszul.tensorKoszulPowerSystem f T K)
          ((AdicKoszul.derivedUniverseLift A).obj ((L ⋙ P.ι).obj K)) :=
  koszulPowerDerivedLimit_reflection A f T

end AdicKoszulAdjunction

end

