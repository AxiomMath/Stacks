/-!
# Derived completeness of Koszul-power towers

Let `A` be a commutative ring and let `I = (f₁, …, f_r)` be generated by a finite sequence.
Derived tensoring an arbitrary complex with the Koszul complexes on the positive powers of that
sequence produces an inverse system in `D(A)`, and its derived limit is derived complete with
respect to `I`.

## Main definitions

* `AdicKoszul.koszulPowerSystem`: the inverse system in `D(A)` built from transition maps between
  the Koszul complexes on successive positive powers of `f`.

## Main results

* `AdicKoszul.isDerivedComplete_of_isDerivedLimit_tensor`: a derived limit of a tower obtained by
  derived tensoring a tower on which every element of `I` acts nilpotently is derived complete.
* `AdicKoszul.rlim_derivedTensor_koszulPowers_isDerivedComplete`: derived completeness of the
  derived limit of the derived-tensored Koszul-power tower.

## Implementation notes

The homological Koszul complexes are extended from nonnegative homological degrees to nonpositive
cohomological degrees along `ComplexShape.embeddingDownNat` before passing to the derived
category. The result is stated for arbitrary transition maps between the prescribed terms; in
particular it applies to the canonical transition maps of Stacks 0BKC.

Nilpotence of the scalar action after derived tensoring is read off the comparison of the derived
tensor product with the ordinary total tensor product of K-flat representatives, which is what
`CochainComplex.DerivedTensor.DerivedTensorProduct` records; no linearity of the tensor
bifunctor is assumed.

## References

* [The Stacks Project, Tag 091Y](https://stacks.math.columbia.edu/tag/091Y)
* [Bhatt--Scholze, *Projectivity of the Witt vector affine Grassmannian*][BS]
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open CochainComplex.DerivedTensor

attribute [local instance] HasDerivedCategory.standard

universe u

namespace AdicKoszul

variable {A : Type u} [CommRing A]

/-- The derived category of `R`-modules has products indexed by `ℕ`. -/
local instance derivedCountableProductsSameUniverse (R : Type u) [CommRing R] :
    HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} R)) :=
  Stacks.DerivedProducts.hasProductsOfShape_derivedCategory

/-! ### Scalars act on a derived tensor product through the K-flat comparison -/

/-- On K-flat representatives the scalar action is computed by the ordinary total tensor
product of complexes. -/
private lemma tensorComplex_map_smul_id (P Q : CochainComplex (ModuleCat.{u} A) ℤ) (a : A) :
    HomologicalComplex.mapBifunctorMap (𝟙 P) (a • 𝟙 Q)
        (moduleTensor A) (ComplexShape.up ℤ) =
      a • 𝟙 (tensorComplex P Q) := by
  apply HomologicalComplex.Hom.ext
  funext n
  apply HomologicalComplex.mapBifunctor.hom_ext
  intro i j h
  rw [HomologicalComplex.ι_mapBifunctorMap]
  simp only [HomologicalComplex.id_f, HomologicalComplex.smul_f_apply,
    CategoryTheory.Functor.map_id, NatTrans.id_app, Category.id_comp, Linear.comp_smul,
    Category.comp_id]
  have hs : ((moduleTensor A).obj (P.X i)).map (a • 𝟙 (Q.X j)) =
      a • 𝟙 (((moduleTensor A).obj (P.X i)).obj (Q.X j)) := by
    apply ModuleCat.hom_ext
    show LinearMap.lTensor (P.X i) (a • (LinearMap.id : (Q.X j) →ₗ[A] (Q.X j))) =
      a • LinearMap.id
    rw [LinearMap.lTensor_smul, LinearMap.lTensor_id]
  rw [hs, Linear.smul_comp, Category.id_comp]

/-- Scalar multiples of identities commute with every morphism. -/
private lemma smul_id_comp_comm {C : Type*} [Category C] [Preadditive C] [Linear A C]
    {X Y : C} (g : X ⟶ Y) (a : A) : (a • 𝟙 X) ≫ g = g ≫ (a • 𝟙 Y) := by
  simp only [Linear.smul_comp, Linear.comp_smul, Category.id_comp, Category.comp_id]

private lemma tensor_map_smul_id_representatives
    (T : DerivedTensorProductGeneral.{u, u} A)
    (P Q : CochainComplex (ModuleCat.{u} A) ℤ)
    (hP : P.KFlat) (hQ : Q.KFlat) (a : A) :
    (T.tensor.obj (DerivedCategory.Q.obj P)).map (a • 𝟙 (DerivedCategory.Q.obj Q)) =
      a • 𝟙 ((T.tensor.obj (DerivedCategory.Q.obj P)).obj (DerivedCategory.Q.obj Q)) := by
  have h := T.comparison_naturality (𝟙 P) (a • 𝟙 Q) hP hP hQ hQ
  simp only [CategoryTheory.Functor.map_id, NatTrans.id_app, Category.id_comp,
    Functor.Linear.map_smul, tensorComplex_map_smul_id] at h
  apply (cancel_mono (T.comparison P Q hP hQ).hom).mp
  simpa only [Linear.comp_smul, Linear.smul_comp, Category.comp_id, Category.id_comp] using h

/-- Scalars act on a derived tensor product through the second variable exactly as they act on
the object itself. -/
lemma tensor_map_smul_id (T : DerivedTensorProductGeneral.{u, u} A)
    (K L : DerivedCategory (ModuleCat.{u} A)) (a : A) :
    (T.tensor.obj K).map (a • 𝟙 L) = a • 𝟙 ((T.tensor.obj K).obj L) := by
  obtain ⟨P, hP, ⟨eP⟩⟩ := CochainComplex.KFlat.exists_kFlat_representative K
  obtain ⟨Q, hQ, ⟨eQ⟩⟩ := CochainComplex.KFlat.exists_kFlat_representative L
  have hL : (T.tensor.obj (DerivedCategory.Q.obj P)).map (a • 𝟙 L) =
      a • 𝟙 ((T.tensor.obj (DerivedCategory.Q.obj P)).obj L) := by
    let F := T.tensor.obj (DerivedCategory.Q.obj P)
    apply (cancel_mono (F.map eQ.inv)).mp
    show F.map (a • 𝟙 L) ≫ F.map eQ.inv = (a • 𝟙 (F.obj L)) ≫ F.map eQ.inv
    rw [← F.map_comp]
    rw [smul_id_comp_comm eQ.inv a, F.map_comp, tensor_map_smul_id_representatives T P Q hP hQ]
    exact (smul_id_comp_comm (F.map eQ.inv) a).symm
  let η := T.tensor.map eP.hom
  apply (cancel_epi (η.app L)).mp
  rw [← η.naturality (a • 𝟙 L), hL]
  exact smul_id_comp_comm (η.app L) a

/-! ### Derived limits of derived-tensored nilpotent towers -/

/-- **Stacks 091W**, in the form used below. If every element of `I` acts nilpotently on every
term of an inverse system `Ksys`, then any derived limit of the inverse system obtained by
derived tensoring `Ksys` with `K` is derived complete with respect to `I`. -/
theorem isDerivedComplete_of_isDerivedLimit_tensor (I : Ideal A)
    (Ksys : ℕᵒᵖ ⥤ DerivedCategory (ModuleCat.{u} A))
    (hzero : ∀ a ∈ I, ∀ n : ℕ, ∃ e : ℕ,
      a ^ e • 𝟙 (Ksys.obj ⟨n⟩) = (0 : Ksys.obj ⟨n⟩ ⟶ Ksys.obj ⟨n⟩))
    (T : DerivedTensorProductGeneral.{u, u} A)
    (K K' : DerivedCategory (ModuleCat.{u} A))
    (hRlim : IsDerivedLimit (Ksys ⋙ T.tensor.obj K) K') :
    IsDerivedComplete I K' := by
  intro a ha
  obtain ⟨p, δ, hT⟩ := hRlim
  have hnil : ∀ n : ℕ, IsNilpotent
      (a • (1 : End ((Ksys ⋙ T.tensor.obj K).obj ⟨n⟩))) := by
    intro n
    obtain ⟨e, he⟩ := hzero a ha n
    refine ⟨e, End.ext ?_⟩
    rw [smul_id_pow, End.zero_asHom]
    have h := congrArg (T.tensor.obj K).map he
    rwa [tensor_map_smul_id, Functor.map_zero] at h
  have hprod : IsDerivedCompleteAt
      (∏ᶜ fun n : ℕ => (Ksys ⋙ T.tensor.obj K).obj ⟨n⟩) a :=
    isDerivedCompleteAt_pi fun n => isDerivedCompleteAt_of_isNilpotent (hnil n)
  exact isDerivedCompleteAt_of_distTriang hT hprod hprod

/-! ### The Koszul-power tower -/

/-- The inverse system in `D(A)` obtained from transition maps between the Koszul complexes on
successive positive powers of `f`. The chain complexes are placed in nonpositive cohomological
degrees before passing to the derived category. -/
noncomputable abbrev koszulPowerSystem {r : ℕ} (f : Fin r → A)
    (τ : ∀ n : ℕ,
      Koszul.seqComplex (fun i ↦ f i ^ (n + 2)) ⟶
        Koszul.seqComplex (fun i ↦ f i ^ (n + 1))) :
    ℕᵒᵖ ⥤ DerivedCategory (ModuleCat.{u} A) :=
  Functor.ofOpSequence
    (X := fun n ↦ DerivedCategory.Q.obj
      ((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} A)).obj
        (Koszul.seqComplex (fun i ↦ f i ^ (n + 1)))))
    (fun n ↦ DerivedCategory.Q.map
      ((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} A)).map (τ n)))

/-- A null-homotopic cochain map vanishes after passage to the derived category. -/
lemma Q_map_eq_zero_of_homotopy {K L : CochainComplex (ModuleCat.{u} A) ℤ}
    {g : K ⟶ L} (h : Homotopy g 0) : DerivedCategory.Q.map g = 0 := by
  rw [← cancel_epi ((DerivedCategory.quotientCompQhIso (ModuleCat.{u} A)).hom.app K),
    ← DerivedCategory.quotientCompQhIso_hom_naturality,
    (HomotopyCategory.quotient_map_eq_zero_iff g).2 ⟨h⟩, Functor.map_zero, zero_comp,
    comp_zero]

private lemma koszulPower_generator_smul_id_eq_zero {r n : ℕ} (f : Fin r → A) (i : Fin r) :
    f i ^ (n + 1) • 𝟙 (DerivedCategory.Q.obj
      ((ComplexShape.embeddingDownNat.extendFunctor (ModuleCat.{u} A)).obj
        (Koszul.seqComplex (fun i ↦ f i ^ (n + 1))))) = 0 := by
  obtain ⟨h⟩ := (Koszul.koszulSeq_smul_nullHomotopic_and_span_le_annihilator
    (fun i ↦ f i ^ (n + 1))).1 i
  have hE' : Homotopy
      (HomologicalComplex.extendMap
        (f i ^ (n + 1) • 𝟙 (Koszul.seqComplex (fun i ↦ f i ^ (n + 1))))
        ComplexShape.embeddingDownNat) 0 := by
    convert h.extend ComplexShape.embeddingDownNat using 1
    simp
  have hs : HomologicalComplex.extendMap
      (f i ^ (n + 1) • 𝟙 (Koszul.seqComplex (fun i ↦ f i ^ (n + 1))))
      ComplexShape.embeddingDownNat =
      f i ^ (n + 1) • 𝟙 ((Koszul.seqComplex (fun i ↦ f i ^ (n + 1))).extend
        ComplexShape.embeddingDownNat) := by
    ext1 j
    by_cases hj : ∃ k, ComplexShape.embeddingDownNat.f k = j
    · obtain ⟨k, rfl⟩ := hj
      simp [HomologicalComplex.extendMap_f]
    · exact ((Koszul.seqComplex (fun i ↦ f i ^ (n + 1))).isZero_extend_X
        ComplexShape.embeddingDownNat j (fun k hk ↦ hj ⟨k, hk⟩)).eq_of_src _ _
  rw [← DerivedCategory.Q.map_id, ← DerivedCategory.Q.map_smul]
  show DerivedCategory.Q.map
    (f i ^ (n + 1) • 𝟙 ((Koszul.seqComplex (fun i ↦ f i ^ (n + 1))).extend
      ComplexShape.embeddingDownNat)) = 0
  rw [← hs]
  exact Q_map_eq_zero_of_homotopy hE'

/-- Every element of the ideal generated by `f` acts nilpotently on each term of the
Koszul-power tower. -/
lemma koszulPower_smul_id_nilpotent {r n : ℕ} (f : Fin r → A)
    (τ : ∀ n : ℕ,
      Koszul.seqComplex (fun i ↦ f i ^ (n + 2)) ⟶
        Koszul.seqComplex (fun i ↦ f i ^ (n + 1)))
    (a : A) (ha : a ∈ Ideal.span (Set.range f)) :
    ∃ e : ℕ, a ^ e • 𝟙 ((koszulPowerSystem f τ).obj ⟨n⟩) = 0 := by
  let X := (koszulPowerSystem f τ).obj ⟨n⟩
  let J : Ideal A := RingHom.ker (algebraMap A (End X))
  have hJ : ∀ c : A, c ∈ J ↔ c • 𝟙 X = 0 := by
    intro c
    rw [RingHom.mem_ker, Algebra.algebraMap_eq_smul_one]
    constructor
    · intro h
      simpa [End.smul_asHom, End.one_asHom] using congr($(h).asHom)
    · intro h
      ext
      simpa [End.smul_asHom, End.one_asHom] using h
  have hspan : Ideal.span (Set.range f) ≤ J.radical := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    exact Ideal.mem_radical_iff.mpr
      ⟨n + 1, (hJ _).mpr (koszulPower_generator_smul_id_eq_zero f i)⟩
  obtain ⟨e, he⟩ := Ideal.mem_radical_iff.mp (hspan ha)
  exact ⟨e, (hJ _).mp he⟩

/-- **Stacks 091Y.** Let `I` be generated by a finite sequence `f`. For any inverse system whose
`n`-th term is the Koszul complex on `f i ^ (n + 1)`, the derived limit after derived tensoring
with `K` is derived complete with respect to `I`. -/
@[stacks 091Y]
theorem rlim_derivedTensor_koszulPowers_isDerivedComplete
    {r : ℕ} (f : Fin r → A)
    (τ : ∀ n : ℕ,
      Koszul.seqComplex (fun i ↦ f i ^ (n + 2)) ⟶
        Koszul.seqComplex (fun i ↦ f i ^ (n + 1)))
    (T : DerivedTensorProduct A)
    (K K' : DerivedCategory (ModuleCat.{u} A))
    (hRlim : IsDerivedLimit (koszulPowerSystem f τ ⋙ T.tensor.obj K) K') :
    IsDerivedComplete (Ideal.span (Set.range f)) K' := by
  apply isDerivedComplete_of_isDerivedLimit_tensor
    (Ideal.span (Set.range f)) (koszulPowerSystem f τ) ?_ T.toGeneral K K' hRlim
  intro a ha n
  simpa only [koszulPowerSystem, Functor.ofOpSequence_obj] using
    koszulPower_smul_id_nilpotent f τ a ha (n := n)

end AdicKoszul

