/-!
# The kernel of completion for a finitely generated ideal is nilpotent

Let `I` be an ideal generated by `r` elements in a commutative ring `A` which is derived complete
with respect to `I`. Then the intersection of all powers of `I` has `2 ^ r`-th power zero. In
particular a reduced ring which is derived complete with respect to a finitely generated ideal is
adically complete with respect to that ideal.

## Main definitions

There are no new definitions.

## Main results

* `iInf_powers_pow_two_pow_eq_bot_of_isDerivedComplete`: the intersection of the powers of an
  `r`-generated ideal in a derived complete ring is nilpotent of exponent `2 ^ r`.
* `isAdicComplete_of_isReduced_of_isDerivedComplete`: a reduced ring which is derived complete
  with respect to a finitely generated ideal is adically complete.

## Implementation notes

That `I` can be generated by `r` elements is represented by a family indexed by `Fin r` whose
range spans `I`. The induction on `r` splits off one generator `a` and passes to the quotient by
`(a ^ t)`; derived completeness of that quotient, as a ring over itself, comes from closure of the
derived complete modules under cokernels (`DerivedCompleteRecurrence.completeModules`) together
with the change-of-rings comparison of Stacks 0924. The base of the induction, one generator, is
the square-zero statement of Stacks 0G3G. For the reduced case the separatedness needed to
characterise adic completeness follows by comparing all powers of the ideal with the cofinal
sequence of powers whose intersection is nilpotent, hence zero.

## References

* [The Stacks Project, Tag 0G3I](https://stacks.math.columbia.edu/tag/0G3I)
* [The Stacks Project, Tag 0G5V](https://stacks.math.columbia.edu/tag/0G5V)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

attribute [local instance] HasDerivedCategory.standard

noncomputable section

universe u v

namespace PrincipalCompletionNilpotent

attribute [local instance] KoszulCompletion.derivedCountableProducts

/-- If `A` is derived complete with respect to `I`, then so is `A ⧸ (a)` as a ring over itself,
with respect to the image of `I`. -/
private lemma isDerivedCompleteModule_quotient_span_singleton
    (A : Type u) [CommRing A] (I : Ideal A) (a : A)
    (hA : IsDerivedCompleteModule I (ModuleCat.of A A)) :
    IsDerivedCompleteModule (I.map (Ideal.Quotient.mk (Ideal.span {a})))
      (ModuleCat.of (A ⧸ Ideal.span {a}) (A ⧸ Ideal.span {a})) := by
  set φ : A →+* A ⧸ Ideal.span {a} := Ideal.Quotient.mk (Ideal.span {a})
  set M : ModuleCat.{u} (A ⧸ Ideal.span {a}) :=
    ModuleCat.of (A ⧸ Ideal.span {a}) (A ⧸ Ideal.span {a})
  -- `A ⧸ (a)`, seen as an `A`-module, is derived complete: it is a cokernel.
  have hcoker : DerivedCompleteRecurrence.completeModules.{u, u} I
      (ModuleCat.of A (A ⧸ LinearMap.range (LinearMap.mul A A a))) :=
    DerivedCompleteRecurrence.completeModules_rangeQuotient I
      (ModuleCat.ofHom (LinearMap.mul A A a)) hA hA
  have hq : DerivedCompleteRecurrence.completeModules.{u, u} I
      (ModuleCat.of A (A ⧸ Ideal.span {a})) :=
    ObjectProperty.prop_of_iso _
      (Submodule.quotEquivOfEq _ _ (Ideal.range_mul' a)).toModuleIso hcoker
  -- transport along the identification with the restriction of scalars of `A ⧸ (a)`
  have e : ModuleCat.of A (A ⧸ Ideal.span {a}) ≅ (ModuleCat.restrictScalars φ).obj M :=
    LinearEquiv.toModuleIso
      { toFun := fun x => x
        invFun := fun x => x
        left_inv := fun _ => rfl
        right_inv := fun _ => rfl
        map_add' := fun _ _ => rfl
        map_smul' := fun r x => by
          change r • x = φ r * x
          exact Algebra.smul_def r x }
  have hq' : DerivedCompleteRecurrence.completeModules.{u, u} I
      ((ModuleCat.restrictScalars φ).obj M) :=
    ObjectProperty.prop_of_iso _ e hq
  exact (isDerivedComplete_restrictScalars_iff A _ φ I
    ((DerivedCategory.singleFunctor (ModuleCat.{u} (A ⧸ Ideal.span {a})) 0).obj M)).mp
    (DerivedCompleteRecurrence.isDerivedComplete_of_iso
      (((ModuleCat.restrictScalars φ).mapDerivedCategorySingleFunctor 0).app M).symm hq')

private lemma map_iInf_pow_le_of_pow_eq_bot
    {A : Type u} {B : Type v} [CommSemiring A] [CommSemiring B]
    (φ : A →+* B) (K P : Ideal A) (t : ℕ) (hP : (P.map φ) ^ t = ⊥) :
    (⨅ n : ℕ, (K ⊔ P) ^ n).map φ ≤ ⨅ n : ℕ, (K.map φ) ^ n := by
  refine le_iInf fun n => ?_
  calc
    (⨅ k : ℕ, (K ⊔ P) ^ k).map φ ≤ ((K ⊔ P) ^ (n + t)).map φ :=
      Ideal.map_mono (iInf_le _ _)
    _ ≤ (K ^ n ⊔ P ^ t).map φ := Ideal.map_mono Ideal.sup_pow_add_le_pow_sup_pow
    _ = (K.map φ) ^ n := by rw [Ideal.map_sup, Ideal.map_pow, Ideal.map_pow, hP, sup_bot_eq]

/-- **Stacks 0G3I.** If a commutative ring is derived complete with respect to an ideal `I`
generated by `r` elements, then the `2 ^ r`-th power of the intersection of all powers of `I`
is zero. -/
@[stacks 0G3I]
theorem iInf_powers_pow_two_pow_eq_bot_of_isDerivedComplete
    (A : Type u) [CommRing A] (I : Ideal A) (r : ℕ) (f : Fin r → A)
    (hI : I = Ideal.span (Set.range f)) :
    letI : HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A)) :=
      Stacks.DerivedProducts.hasProductsOfShape_nat
    IsDerivedCompleteModule I (ModuleCat.of A A) →
      (⨅ n : ℕ, I ^ n) ^ (2 ^ r) = ⊥ := by
  intro hA
  induction r generalizing A with
  | zero =>
    have hI' : I = ⊥ := by simpa using hI
    subst I
    apply bot_unique
    simpa using (iInf_le (fun n : ℕ => (⊥ : Ideal A) ^ n) 1)
  | succ r ih =>
    set a := f 0
    set K := Ideal.span (Set.range (fun i : Fin r => f i.succ)) with hK
    set P := Ideal.span ({a} : Set A) with hP
    have hsplit : I = K ⊔ P := by
      rw [hI, Fin.range_fin_succ, Ideal.span_insert, sup_comm]
      rfl
    have hKI : K ≤ I := hsplit ▸ le_sup_left
    have hPI : P ≤ I := hsplit ▸ le_sup_right
    have hprincipal : (⨅ n : ℕ, P ^ n) ^ 2 = ⊥ :=
      (PrincipalCompletionKernel.iInf_principal_powers_annihilates_ker_adicCompletion
        A a A).2 (fun g hg => hA g (hPI hg))
    have hle : (⨅ n : ℕ, I ^ n) ^ (2 ^ r) ≤ ⨅ t : ℕ, P ^ t := by
      refine le_iInf fun t => ?_
      set Q := Ideal.span ({a ^ t} : Set A)
      set φ : A →+* A ⧸ Q := Ideal.Quotient.mk Q
      have hB := isDerivedCompleteModule_quotient_span_singleton A I (a ^ t) hA
      have hBK : IsDerivedCompleteModule (K.map φ)
          (ModuleCat.of (A ⧸ Q) (A ⧸ Q)) :=
        fun g hg => hB g (Ideal.map_mono hKI hg)
      have hgen : K.map φ = Ideal.span (Set.range (fun i : Fin r => φ (f i.succ))) := by
        simp only [hK, Ideal.map_span, ← Set.range_comp']
      have hnil := ih (A ⧸ Q) (K.map φ) (fun i : Fin r => φ (f i.succ)) hgen hBK
      have hPt : (P.map φ) ^ t = ⊥ := by
        rw [← Ideal.map_pow, hP, Ideal.span_singleton_pow]
        exact Ideal.map_quotient_self Q
      have hmap : (⨅ n : ℕ, I ^ n).map φ ≤ ⨅ n : ℕ, (K.map φ) ^ n := by
        rw [hsplit]
        exact map_iInf_pow_le_of_pow_eq_bot φ K P t hPt
      have hz : ((⨅ n : ℕ, I ^ n) ^ (2 ^ r)).map φ = ⊥ := by
        rw [Ideal.map_pow]
        exact bot_unique ((pow_le_pow_left' hmap _).trans (le_of_eq hnil))
      have hk' : (⨅ n : ℕ, I ^ n) ^ (2 ^ r) ≤ Q := by
        rw [← Ideal.mk_ker (I := Q)]
        exact (Ideal.map_eq_bot_iff_le_ker φ).mp hz
      simpa only [hP, Ideal.span_singleton_pow] using hk'
    apply bot_unique
    calc
      (⨅ n : ℕ, I ^ n) ^ (2 ^ (r + 1)) = ((⨅ n : ℕ, I ^ n) ^ (2 ^ r)) ^ 2 := by
        rw [pow_succ, pow_mul]
      _ ≤ (⨅ n : ℕ, P ^ n) ^ 2 := pow_le_pow_left' hle 2
      _ = ⊥ := hprincipal

private lemma iInf_powers_eq_bot_of_isDerivedComplete
    (A : Type u) [CommRing A] [IsReduced A] (I : Ideal A) (hI : I.FG)
    (hcomplete : IsDerivedCompleteModule I (ModuleCat.of A A)) : (⨅ n : ℕ, I ^ n) = ⊥ := by
  obtain ⟨r, f, hf⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hI
  have hnil := iInf_powers_pow_two_pow_eq_bot_of_isDerivedComplete A I r f hf.symm hcomplete
  refine eq_bot_iff.2 fun x hx => Ideal.isRadical_bot ⟨2 ^ r, ?_⟩
  rw [← hnil]
  exact Ideal.pow_mem_pow hx _

/-- **Stacks 0G5V.** A reduced commutative ring which is derived complete with respect to a
finitely generated ideal is adically complete with respect to that ideal. -/
@[stacks 0G5V]
theorem isAdicComplete_of_isReduced_of_isDerivedComplete
    (A : Type u) [CommRing A] [IsReduced A] (I : Ideal A) (hI : I.FG) :
    letI : HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{u} A)) :=
      Stacks.DerivedProducts.hasProductsOfShape_nat
    IsDerivedCompleteModule I (ModuleCat.of A A) → IsAdicComplete I A := by
  intro hcomplete
  exact (isAdicComplete_iff_isDerivedCompleteModule_and_iInf_pow_smul_top_eq_bot
    A I hI A).2 ⟨hcomplete, by
      simp [iInf_powers_eq_bot_of_isDerivedComplete A I hI hcomplete]⟩

end PrincipalCompletionNilpotent

end

