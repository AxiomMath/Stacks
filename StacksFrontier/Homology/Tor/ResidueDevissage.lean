module

public import StacksFrontier.Homology.Tor.ExtremalDegrees

/-!
# The dévissage of a module killed by a maximal ideal

Let `A` be a commutative ring, `m` a maximal ideal and `κ = A / m` the residue field. Let
`F : D(A) → D(D)` be an exact functor and `N` an `A`-module killed by `m`.

* If `N` is finite then `F(N[0])` satisfies every property of the target that `F(κ[0])`
  satisfies, among properties closed under isomorphism, holding at zero objects and
  two-out-of-three in the middle along a distinguished triangle. Taking the property to be
  `D^{≥ c}`, respectively `D^{≤ d}`, this says that `F(N[0])` has the same cohomological window
  as `F(κ[0])`.

* If `N ≠ 0` then a nonvanishing cohomology module of `F(κ[0])` forces the corresponding one of
  `F(N[0])` to be nonzero, for any functor `F` and any `N`, finite or not.

Consequently, for `T` with cohomology in `[a, b]`, all of it killed by `m` and finite, and with
`H^a(T)` and `H^b(T)` nonzero, the cohomology of `F(T)` lies in `[a + c, b + d]` and is nonzero
at both ends, where `[c, d]` is the window of `F(κ[0])` and `c`, `d` are nonvanishing degrees of
it.

## Main results

* `StacksDraft.ResidueDevissage.isZero_or_nonempty_iso_residueField` — a module generated by one
  element and killed by a maximal ideal is zero or isomorphic to the residue field.
* `StacksDraft.ResidueDevissage.exists_retraction_residueField` — the residue field is a retract
  of every nonzero module killed by the maximal ideal.
* `StacksDraft.ResidueDevissage.not_isZero_map_of_retraction` — a functor whose value at `X` is
  nonzero is nonzero at every object of which `X` is a retract.
* `StacksDraft.ResidueDevissage.of_residueField` — a property of the target closed under
  isomorphism, holding at zero objects and two-out-of-three along a distinguished triangle, which
  holds at `F(κ[0])` holds at `F(N[0])` for every finite `N` killed by `m`.
* `StacksDraft.ResidueDevissage.isGE_map_single_of_isTorsionBySet`,
  `StacksDraft.ResidueDevissage.isLE_map_single_of_isTorsionBySet` — `F(N[0])` has the
  cohomological bounds of `F(κ[0])`.
* `StacksDraft.ResidueDevissage.not_isZero_homology_map_single_of_isTorsionBySet` — a nonvanishing
  cohomology module of `F(κ[0])` forces the corresponding one of `F(N[0])` to be nonzero.
* `StacksDraft.ResidueDevissage.extremalDegrees_of_isTorsionBySet` — the extremal degrees of
  `F(T)` are those of `T` shifted by those of `F(κ[0])`.
* `StacksDraft.ResidueDevissage.eq_zero_of_iso_of_isTorsionBySet` — an exact endofunctor with
  `F(T) ≅ T`, for such a `T`, carries the residue field to an object concentrated in degree zero.

## References

* [Stacks Project, Tag 0E2D](https://stacks.math.columbia.edu/tag/0E2D)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open DerivedCategory

attribute [local instance] HasDerivedCategory.standard

namespace StacksDraft.ResidueDevissage

universe u w w'

variable {A : Type u} [CommRing A]
  {D : Type w} [Category.{w'} D] [Abelian D]

/-! ### Modules killed by a maximal ideal -/

/-- A module all of whose elements are multiples of one element `x`, killed by a maximal ideal
`m`, is either zero — when `x = 0` — or isomorphic to the residue field `A / m`. -/
theorem isZero_or_nonempty_iso_residueField (m : Ideal A) [m.IsMaximal] (M : ModuleCat.{u} A)
    (hM : Module.IsTorsionBySet A M (m : Set A)) (x : M) (hx : ∀ y : M, ∃ a : A, y = a • x) :
    IsZero M ∨ Nonempty (M ≅ ModuleCat.of A (A ⧸ m)) := by
  by_cases hx0 : x = 0
  · refine Or.inl (ModuleCat.isZero_iff_subsingleton.2 (subsingleton_of_forall_eq 0 fun y ↦ ?_))
    obtain ⟨a, ha⟩ := hx y
    simp [ha, hx0]
  · refine Or.inr ⟨?_⟩
    have hmle : m ≤ LinearMap.ker (LinearMap.toSpanSingleton A M x) := by
      intro a ha
      simpa only [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply] using @hM x ⟨a, ha⟩
    have hne : LinearMap.ker (LinearMap.toSpanSingleton A M x) ≠ ⊤ := fun h ↦ hx0 <| by
      have : (1 : A) ∈ LinearMap.ker (LinearMap.toSpanSingleton A M x) := h ▸ Submodule.mem_top
      simpa only [LinearMap.mem_ker, LinearMap.toSpanSingleton_apply, one_smul] using this
    have hker : LinearMap.ker (LinearMap.toSpanSingleton A M x) ≤ m :=
      le_of_eq ((Ideal.IsMaximal.eq_of_le ‹m.IsMaximal› hne hmle).symm)
    let φ : (A ⧸ m) →ₗ[A] M := m.liftQ (LinearMap.toSpanSingleton A M x) hmle
    have hsurj : Function.Surjective φ := by
      intro y
      obtain ⟨a, ha⟩ := hx y
      exact ⟨Submodule.Quotient.mk a, ha.symm⟩
    exact (LinearEquiv.ofBijective φ
      ⟨LinearMap.ker_eq_bot.1 (m.ker_liftQ_eq_bot _ hmle hker), hsurj⟩).toModuleIso.symm

/-- The residue field is a retract of every nonzero module killed by the maximal ideal. -/
theorem exists_retraction_residueField (m : Ideal A) [m.IsMaximal] (N : ModuleCat.{u} A)
    (hN : Module.IsTorsionBySet A N (m : Set A)) (hNne : ¬ IsZero N) :
    ∃ (i : ModuleCat.of A (A ⧸ m) ⟶ N) (p : N ⟶ ModuleCat.of A (A ⧸ m)), i ≫ p = 𝟙 _ := by
  classical
  have : Nontrivial N :=
    not_subsingleton_iff_nontrivial.1 (mt ModuleCat.isZero_iff_subsingleton.2 hNne)
  obtain ⟨y, hy0⟩ := exists_ne (0 : N)
  let k := A ⧸ m
  let _ : Field k := Ideal.Quotient.field m
  let _ : Module k N := hN.module
  let _ : IsScalarTower A k N := hN.isScalarTower
  let iota : k →ₗ[k] N := LinearMap.toSpanSingleton k N y
  obtain ⟨pk, hpk⟩ :=
    iota.exists_leftInverse_of_injective (LinearMap.ker_toSpanSingleton k hy0)
  exact ⟨ModuleCat.ofHom (iota.restrictScalars A), ModuleCat.ofHom (pk.restrictScalars A),
    ModuleCat.hom_ext (LinearMap.ext fun z ↦ LinearMap.congr_fun hpk z)⟩

/-! ### The nonvanishing half -/

/-- If the image of `X` under a functor is nonzero then so is the image of any object of which `X`
is a retract. -/
theorem not_isZero_map_of_retraction {C' : Type*} [Category C'] {E : Type*} [Category E]
    [HasZeroMorphisms E] (G : C' ⥤ E) {X Y : C'} (i : X ⟶ Y) (p : Y ⟶ X) (hip : i ≫ p = 𝟙 X)
    (hX : ¬ IsZero (G.obj X)) : ¬ IsZero (G.obj Y) := by
  intro hY
  refine hX ((IsZero.iff_id_eq_zero _).2 ?_)
  have hz : G.map i ≫ G.map p = 0 := by rw [hY.eq_of_tgt (G.map i) 0, zero_comp]
  rw [← G.map_id, ← hip, G.map_comp, hz]

/-- For any functor `F` out of `D(A)` and any nonzero module `N` killed by the maximal ideal, a
nonvanishing `i`-th cohomology module of `F` at the residue field forces the `i`-th cohomology of
`F(N[0])` to be nonzero. -/
theorem not_isZero_homology_map_single_of_isTorsionBySet
    (F : DerivedCategory (ModuleCat.{u} A) ⥤ DerivedCategory D) (m : Ideal A) [m.IsMaximal]
    (N : ModuleCat.{u} A) (hN : Module.IsTorsionBySet A N (m : Set A)) (hNne : ¬ IsZero N)
    (i : ℤ)
    (hk : ¬ IsZero ((homologyFunctor D i).obj
      (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj (ModuleCat.of A (A ⧸ m)))))) :
    ¬ IsZero ((homologyFunctor D i).obj
      (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj N))) := by
  obtain ⟨j, p, hjp⟩ := exists_retraction_residueField m N hN hNne
  exact not_isZero_map_of_retraction
    (singleFunctor (ModuleCat.{u} A) 0 ⋙ F ⋙ homologyFunctor D i) j p hjp hk

/-! ### The window half -/

/-- `StacksDraft.ResidueDevissage.of_residueField` for a module with a spanning set of at most `n`
elements. -/
private theorem of_residueField_aux
    (F : DerivedCategory (ModuleCat.{u} A) ⥤ DerivedCategory D)
    [F.CommShift ℤ] [F.IsTriangulated] (m : Ideal A) [m.IsMaximal]
    (Q : DerivedCategory D → Prop)
    (hiso : ∀ {X Y : DerivedCategory D}, (X ≅ Y) → Q X → Q Y)
    (hzero : ∀ X : DerivedCategory D, IsZero X → Q X)
    (htri : ∀ T : Triangle (DerivedCategory D), T ∈ distTriang (DerivedCategory D) →
      Q T.obj₁ → Q T.obj₃ → Q T.obj₂)
    (hk : Q (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj (ModuleCat.of A (A ⧸ m))))) :
    ∀ (n : ℕ) (N : ModuleCat.{u} A), Module.IsTorsionBySet A N (m : Set A) →
      ∀ s : Finset N, s.card ≤ n → Submodule.span A (s : Set N) = ⊤ →
      Q (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj N)) := by
  classical
  have hzero' : ∀ N : ModuleCat.{u} A, IsZero N →
      Q (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj N)) := fun N hN ↦
    hzero _ (F.map_isZero ((singleFunctor (ModuleCat.{u} A) 0).map_isZero hN))
  have hempty : ∀ (N : ModuleCat.{u} A) (s : Finset N), s = ∅ →
      Submodule.span A (s : Set N) = ⊤ →
      Q (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj N)) := by
    intro N s hs hspan
    subst hs
    refine hzero' N (ModuleCat.isZero_iff_subsingleton.2 (subsingleton_of_forall_eq 0 fun y ↦ ?_))
    have hy : y ∈ Submodule.span A ((∅ : Finset N) : Set N) := hspan ▸ Submodule.mem_top
    simpa only [Finset.coe_empty, Submodule.span_empty, Submodule.mem_bot] using hy
  intro n
  induction n with
  | zero =>
      intro N hN s hcard hspan
      exact hempty N s (Finset.card_eq_zero.1 (Nat.le_zero.1 hcard)) hspan
  | succ n ih =>
      intro N hN s hcard hspan
      rcases Finset.eq_empty_or_nonempty s with hs | ⟨x, hxs⟩
      · exact hempty N s hs hspan
      · let L : Submodule A N := Submodule.span A {x}
        let S : ShortComplex (ModuleCat.{u} A) :=
          ShortComplex.mk (ModuleCat.ofHom L.subtype) (ModuleCat.ofHom L.mkQ) (by
            ext z
            exact (Submodule.Quotient.mk_eq_zero L).2 z.property)
        have hS : S.ShortExact := by
          refine { exact := ?_, mono_f := ?_, epi_g := ?_ }
          · rw [ShortComplex.moduleCat_exact_iff]
            intro z hz
            exact ⟨⟨z, (Submodule.Quotient.mk_eq_zero L).1 hz⟩, rfl⟩
          · exact (ModuleCat.mono_iff_injective _).2 L.subtype_injective
          · exact (ModuleCat.epi_iff_surjective _).2 L.mkQ_surjective
        have h₁ : Q (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj S.X₁)) := by
          have hL : Module.IsTorsionBySet A (ModuleCat.of A L) (m : Set A) := by
            intro z a
            exact Subtype.ext (@hN (z : N) a)
          have hgen : ∀ z : (ModuleCat.of A L : ModuleCat.{u} A),
              ∃ a : A, z = a • (⟨x, Submodule.mem_span_singleton_self x⟩ : L) := by
            intro z
            obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.1 z.property
            exact ⟨a, Subtype.ext ha.symm⟩
          rcases isZero_or_nonempty_iso_residueField m (ModuleCat.of A L) hL _ hgen with
            hz | hres
          · exact hzero' _ hz
          · obtain ⟨e⟩ := hres
            exact hiso (F.mapIso ((singleFunctor (ModuleCat.{u} A) 0).mapIso e.symm)) hk
        have h₃ : Q (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj S.X₃)) := by
          have hNL : Module.IsTorsionBySet A (ModuleCat.of A (N ⧸ L)) (m : Set A) := by
            intro z a
            obtain ⟨y, rfl⟩ := L.mkQ_surjective z
            change (a : A) • L.mkQ y = 0
            rw [← L.mkQ.map_smul, @hN y a, map_zero]
          refine ih (ModuleCat.of A (N ⧸ L)) hNL ((s.erase x).image L.mkQ) ?_ ?_
          · have h := Finset.card_image_le (f := L.mkQ) (s := s.erase x)
            rw [Finset.card_erase_of_mem hxs] at h
            omega
          · have h1 : Submodule.span A (L.mkQ '' (s : Set N)) = ⊤ := by
              rw [← Submodule.map_span, hspan, Submodule.map_top, LinearMap.range_eq_top]
              exact L.mkQ_surjective
            refine le_antisymm le_top ?_
            rw [← h1]
            refine Submodule.span_le.2 ?_
            rintro z ⟨y, hy, rfl⟩
            by_cases hyx : y = x
            · subst hyx
              have : L.mkQ y = 0 :=
                (Submodule.Quotient.mk_eq_zero L).2 (Submodule.mem_span_singleton_self y)
              rw [this]
              exact zero_mem _
            · refine Submodule.subset_span ?_
              rw [Finset.coe_image]
              exact ⟨y, by simpa only [Finset.coe_erase, Set.mem_sdiff, Set.mem_singleton_iff]
                using ⟨hy, hyx⟩, rfl⟩
        exact htri (F.mapTriangle.obj hS.singleTriangle)
          (F.map_distinguished _ hS.singleTriangle_distinguished) h₁ h₃

/-- Let `F : D(A) → D(D)` be an exact functor and `Q` a property of objects of the target which is
closed under isomorphism, holds at zero objects, and holds at the middle term of a distinguished
triangle whenever it holds at the two outer terms. If `Q` holds at `F(κ[0])` for the residue field
`κ = A / m`, then it holds at `F(N[0])` for every finite `A`-module `N` killed by `m`. -/
theorem of_residueField (F : DerivedCategory (ModuleCat.{u} A) ⥤ DerivedCategory D)
    [F.CommShift ℤ] [F.IsTriangulated] (m : Ideal A) [m.IsMaximal]
    (Q : DerivedCategory D → Prop)
    (hiso : ∀ {X Y : DerivedCategory D}, (X ≅ Y) → Q X → Q Y)
    (hzero : ∀ X : DerivedCategory D, IsZero X → Q X)
    (htri : ∀ T : Triangle (DerivedCategory D), T ∈ distTriang (DerivedCategory D) →
      Q T.obj₁ → Q T.obj₃ → Q T.obj₂)
    (hk : Q (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj (ModuleCat.of A (A ⧸ m)))))
    (N : ModuleCat.{u} A) (hN : Module.IsTorsionBySet A N (m : Set A)) [Module.Finite A N] :
    Q (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj N)) := by
  obtain ⟨s, hs⟩ := Module.finite_def.1 (inferInstance : Module.Finite A N)
  exact of_residueField_aux F m Q hiso hzero htri hk s.card N hN s le_rfl hs

/-- If `F(κ[0])` has no cohomology below `c`, neither has `F(N[0])` for any finite module `N`
killed by the maximal ideal. -/
theorem isGE_map_single_of_isTorsionBySet
    (F : DerivedCategory (ModuleCat.{u} A) ⥤ DerivedCategory D)
    [F.CommShift ℤ] [F.IsTriangulated] (m : Ideal A) [m.IsMaximal] (c : ℤ)
    (hk : (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj (ModuleCat.of A (A ⧸ m)))).IsGE c)
    (N : ModuleCat.{u} A) (hN : Module.IsTorsionBySet A N (m : Set A)) [Module.Finite A N] :
    (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj N)).IsGE c :=
  of_residueField F m (fun X ↦ X.IsGE c)
    (fun e hX ↦ have := hX; TStructure.t.isGE_of_iso e c)
    (fun _ hX ↦ TStructure.t.isGE_of_isZero hX c)
    (fun T hT h₁ h₃ ↦ TStructure.t.isGE₂ T hT c h₁ h₃) hk N hN

/-- If `F(κ[0])` has no cohomology above `d`, neither has `F(N[0])` for any finite module `N`
killed by the maximal ideal. -/
theorem isLE_map_single_of_isTorsionBySet
    (F : DerivedCategory (ModuleCat.{u} A) ⥤ DerivedCategory D)
    [F.CommShift ℤ] [F.IsTriangulated] (m : Ideal A) [m.IsMaximal] (d : ℤ)
    (hk : (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj (ModuleCat.of A (A ⧸ m)))).IsLE d)
    (N : ModuleCat.{u} A) (hN : Module.IsTorsionBySet A N (m : Set A)) [Module.Finite A N] :
    (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj N)).IsLE d :=
  of_residueField F m (fun X ↦ X.IsLE d)
    (fun e hX ↦ have := hX; TStructure.t.isLE_of_iso e d)
    (fun _ hX ↦ TStructure.t.isLE_of_isZero hX d)
    (fun T hT h₁ h₃ ↦ TStructure.t.isLE₂ T hT d h₁ h₃) hk N hN

/-! ### The extremal-degree Künneth step -/

/-- Let `F : D(A) → D(D)` be an exact functor, let `T` have cohomology concentrated in `[a, b]`
with every cohomology module finite and killed by the maximal ideal `m`, and let `H^a(T)` and
`H^b(T)` be nonzero. If `F(κ[0])` has cohomology concentrated in `[c, d]` for the residue field
`κ = A / m` and does not vanish in degrees `c` and `d`, then `F(T)` has cohomology concentrated
in `[a + c, b + d]` and does not vanish in degrees `a + c` and `b + d`. -/
theorem extremalDegrees_of_isTorsionBySet
    (F : DerivedCategory (ModuleCat.{u} A) ⥤ DerivedCategory D)
    [F.CommShift ℤ] [F.IsTriangulated] (m : Ideal A) [m.IsMaximal]
    (T : DerivedCategory (ModuleCat.{u} A)) (a b c d : ℤ) (ha : T.IsGE a) (hb : T.IsLE b)
    (hkill : ∀ i : ℤ, Module.IsTorsionBySet A
      ((homologyFunctor (ModuleCat.{u} A) i).obj T) (m : Set A))
    (hfin : ∀ i : ℤ, Module.Finite A ((homologyFunctor (ModuleCat.{u} A) i).obj T))
    (hGE : (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj (ModuleCat.of A (A ⧸ m)))).IsGE c)
    (hLE : (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj (ModuleCat.of A (A ⧸ m)))).IsLE d)
    (hc : ¬ IsZero ((homologyFunctor D c).obj
      (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj (ModuleCat.of A (A ⧸ m))))))
    (hd : ¬ IsZero ((homologyFunctor D d).obj
      (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj (ModuleCat.of A (A ⧸ m))))))
    (hbot : ¬ IsZero ((homologyFunctor (ModuleCat.{u} A) a).obj T))
    (htop : ¬ IsZero ((homologyFunctor (ModuleCat.{u} A) b).obj T)) :
    (F.obj T).IsGE (a + c) ∧ (F.obj T).IsLE (b + d) ∧
      ¬ IsZero ((homologyFunctor D (a + c)).obj (F.obj T)) ∧
      ¬ IsZero ((homologyFunctor D (b + d)).obj (F.obj T)) := by
  refine ExtremalDegrees.extremalDegrees F T a b c d ha hb (fun i ↦ ?_) (fun i ↦ ?_) ?_ ?_
  · have := hfin i
    exact isGE_map_single_of_isTorsionBySet F m c hGE _ (hkill i)
  · have := hfin i
    exact isLE_map_single_of_isTorsionBySet F m d hLE _ (hkill i)
  · exact not_isZero_homology_map_single_of_isTorsionBySet F m _ (hkill a) hbot c hc
  · exact not_isZero_homology_map_single_of_isTorsionBySet F m _ (hkill b) htop d hd

/-- Let `F` be an exact endofunctor of `D(A)`, let `T` have cohomology concentrated in `[a, b]`,
all of it finite and killed by the maximal ideal `m`, with `H^a(T)` and `H^b(T)` nonzero, and let
`F(T) ≅ T`. If `F(κ[0])` has cohomology concentrated in `[c, d]` and does not vanish in those two
degrees, then `c = 0` and `d = 0`: `F` carries the residue field to an object concentrated in
degree zero, nonzero there. -/
theorem eq_zero_of_iso_of_isTorsionBySet
    (F : DerivedCategory (ModuleCat.{u} A) ⥤ DerivedCategory (ModuleCat.{u} A))
    [F.CommShift ℤ] [F.IsTriangulated] (m : Ideal A) [m.IsMaximal]
    (T : DerivedCategory (ModuleCat.{u} A)) (a b c d : ℤ) (ha : T.IsGE a) (hb : T.IsLE b)
    (hkill : ∀ i : ℤ, Module.IsTorsionBySet A
      ((homologyFunctor (ModuleCat.{u} A) i).obj T) (m : Set A))
    (hfin : ∀ i : ℤ, Module.Finite A ((homologyFunctor (ModuleCat.{u} A) i).obj T))
    (hGE : (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj (ModuleCat.of A (A ⧸ m)))).IsGE c)
    (hLE : (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj (ModuleCat.of A (A ⧸ m)))).IsLE d)
    (hc : ¬ IsZero ((homologyFunctor (ModuleCat.{u} A) c).obj
      (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj (ModuleCat.of A (A ⧸ m))))))
    (hd : ¬ IsZero ((homologyFunctor (ModuleCat.{u} A) d).obj
      (F.obj ((singleFunctor (ModuleCat.{u} A) 0).obj (ModuleCat.of A (A ⧸ m))))))
    (hbot : ¬ IsZero ((homologyFunctor (ModuleCat.{u} A) a).obj T))
    (htop : ¬ IsZero ((homologyFunctor (ModuleCat.{u} A) b).obj T))
    (e : F.obj T ≅ T) :
    c = 0 ∧ d = 0 := by
  obtain ⟨h₁, h₂, h₃, h₄⟩ := extremalDegrees_of_isTorsionBySet F m T a b c d ha hb hkill hfin
    hGE hLE hc hd hbot htop
  exact ExtremalDegrees.extremalDegrees_eq_zero_of_iso T (F.obj T) a b c d ha hb hbot htop e
    h₁ h₂ h₃ h₄

end StacksDraft.ResidueDevissage

end
