section Transfer

variable {A : Type u₁} [Category.{v₁} A] [Abelian A] [HasDerivedCategory.{w₁} A]
  {B : Type u₂} [Category.{v₂} B] [Abelian B] [HasDerivedCategory.{w₂} B]
  (Φ : A ≌ B) [Φ.functor.Additive] [Φ.inverse.Additive]

/-- Abbreviation for the quasi-isomorphisms of cochain complexes. -/
private abbrev qis (A : Type u₁) [Category.{v₁} A] [Abelian A] :
    MorphismProperty (CochainComplex A ℤ) :=
  HomologicalComplex.quasiIso A (ComplexShape.up ℤ)

/-- The composite of the two functors on complexes induced by an equivalence, followed by the
localization functor, is isomorphic to the localization functor. -/
private noncomputable def mapComplexCompIso :
    ((Φ.functor.mapHomologicalComplex (ComplexShape.up ℤ) ⋙ DerivedCategory.Q) ⋙
        Φ.inverse.mapDerivedCategory) ≅ DerivedCategory.Q (C := A) :=
  Functor.associator _ _ _ ≪≫
    Functor.isoWhiskerLeft _ (Localization.Lifting.iso (DerivedCategory.Q (C := B)) (qis B)
      (Φ.inverse.mapHomologicalComplex (ComplexShape.up ℤ) ⋙ DerivedCategory.Q)
      Φ.inverse.mapDerivedCategory) ≪≫
    (Functor.associator _ _ _).symm ≪≫
    Functor.isoWhiskerRight (Functor.mapHomologicalComplexCompIso Φ.unitIso.symm _) _ ≪≫
    Functor.isoWhiskerRight (Functor.mapHomologicalComplexIdIso A _) _ ≪≫
    Functor.leftUnitor _

/-- The equivalence of derived categories induced by an exact equivalence of abelian categories.
Its functor is `Φ.functor.mapDerivedCategory` and its inverse is
`Φ.inverse.mapDerivedCategory`, both of which are triangulated. -/
private noncomputable def mapDerivedCategoryEquivalence :
    DerivedCategory A ≌ DerivedCategory B :=
  letI : Φ.symm.functor.Additive := ‹Φ.inverse.Additive›
  letI : Φ.symm.inverse.Additive := ‹Φ.functor.Additive›
  Localization.equivalence (DerivedCategory.Q (C := A)) (qis A)
    (DerivedCategory.Q (C := B)) (qis B)
    (Φ.functor.mapHomologicalComplex (ComplexShape.up ℤ) ⋙ DerivedCategory.Q)
    Φ.functor.mapDerivedCategory
    (Φ.inverse.mapHomologicalComplex (ComplexShape.up ℤ) ⋙ DerivedCategory.Q)
    Φ.inverse.mapDerivedCategory
    (mapComplexCompIso Φ) (mapComplexCompIso Φ.symm)

private lemma mapDerivedCategoryEquivalence_functor :
    (mapDerivedCategoryEquivalence Φ).functor = Φ.functor.mapDerivedCategory := rfl

private lemma mapDerivedCategoryEquivalence_inverse :
    (mapDerivedCategoryEquivalence Φ).inverse = Φ.inverse.mapDerivedCategory := rfl

end Transfer

section Shrink

/-- A Grothendieck abelian category relative to a universe `w₁` is Grothendieck abelian relative
to any smaller universe `w₂` in which it is locally small. -/
private lemma isGrothendieckAbelian_of_univLE (C : Type u₁) [Category.{v₁} C] [Abelian C]
    [IsGrothendieckAbelian.{w₁} C] [LocallySmall.{w₂} C] [UnivLE.{w₂, w₁}] :
    IsGrothendieckAbelian.{w₂} C :=
  have : HasFilteredColimitsOfSize.{w₂, w₂} C :=
    hasFilteredColimitsOfSize_of_univLE.{w₂, w₂, w₁, w₁, v₁, u₁}
  { locallySmall := inferInstance
    hasFilteredColimitsOfSize := inferInstance
    ab5OfSize := AB5OfSize_of_univLE.{w₂, w₂, w₁, w₁, v₁, u₁} C
    hasSeparator := inferInstance }

end Shrink

section CompactBridge

open Opposite

variable {D : Type u₁} [Category.{v₁} D] [Preadditive D]

/-- For a compact object `K`, the cofan obtained by applying `Hom(K, -)` to the coprojections of
a direct sum is a colimit cofan of abelian groups: that is what the bijectivity defining
compactness says. -/
private noncomputable def isColimitPreadditiveCoyonedaCofan
    (K : D) (hK : IsCompactObject.{v₁} K) {α : Type v₁} (E : α → D) [HasCoproduct E] :
    IsColimit (Cofan.mk ((preadditiveCoyoneda.obj (op K)).obj (∐ E))
      (fun j => (preadditiveCoyoneda.obj (op K)).map (Sigma.ι E j))) := by
  classical
  let d : (DirectSum α fun j => (K ⟶ E j)) ≃+ (K ⟶ ∐ E) :=
    AddEquiv.ofBijective (DirectSum.toAddMonoid fun j => Preadditive.rightComp K (Sigma.ι E j))
      (hK.bijective_toAddMonoid_rightComp_sigmaι E)
  have hd (j : α) (x : K ⟶ E j) :
      d (DirectSum.of (fun i => (K ⟶ E i)) j x) = x ≫ Sigma.ι E j :=
    DirectSum.toAddMonoid_of (fun i => Preadditive.rightComp K (Sigma.ι E i)) j x
  let u : ∀ (t : Cofan fun j => (preadditiveCoyoneda.obj (op K)).obj (E j)) (i : α),
      (K ⟶ E i) →+ (↑t.pt : Type v₁) := fun t i => (t.inj i).hom
  refine Cofan.IsColimit.mk _
    (fun t => AddCommGrpCat.ofHom ((DirectSum.toAddMonoid (u t)).comp d.symm.toAddMonoidHom))
    ?_ ?_
  · intro t j
    have hx : ∀ x' : K ⟶ E j,
        DirectSum.toAddMonoid (u t) (d.symm (x' ≫ Sigma.ι E j)) = u t j x' := by
      intro x'
      rw [← hd j x', d.symm_apply_apply, DirectSum.toAddMonoid_of]
    ext x
    exact hx x
  · intro t m hm
    have key : m.hom.comp d.toAddMonoidHom = DirectSum.toAddMonoid (u t) := by
      refine DirectSum.addHom_ext (fun j x => ?_)
      change m.hom (d (DirectSum.of (fun i => (K ⟶ E i)) j x)) =
        DirectSum.toAddMonoid (u t) (DirectSum.of (fun i => (K ⟶ E i)) j x)
      rw [hd, DirectSum.toAddMonoid_of]
      exact ConcreteCategory.congr_hom (hm j) x
    ext y
    conv_lhs => rw [← d.apply_symm_apply y]
    exact DFunLike.congr_fun key (d.symm y)

/-- Compactness in the sense of [Stacks, Tag 07LS] is the hypothesis of Brown representability:
the `AddCommGrpCat`-valued functor `Hom(K, -)` preserves direct sums. -/
private lemma preservesColimitsOfShape_preadditiveCoyoneda_of_isCompactObject
    (K : D) (hK : IsCompactObject.{v₁} K) [HasCoproducts.{v₁} D] (α : Type v₁) :
    PreservesColimitsOfShape (Discrete α) (preadditiveCoyoneda.obj (op K)) := by
  constructor
  intro F
  have : PreservesColimit (Discrete.functor fun j => F.obj ⟨j⟩)
      (preadditiveCoyoneda.obj (op K)) :=
    preservesColimit_of_preserves_colimit_cocone (coproductIsCoproduct _)
      ((isColimitMapCoconeCofanMkEquiv _ _ (Sigma.ι _)).symm
        (isColimitPreadditiveCoyonedaCofan K hK _))
  exact preservesColimit_of_iso_diagram (K₁ := Discrete.functor (fun j => F.obj ⟨j⟩))
    (preadditiveCoyoneda.obj (op K)) (Discrete.natIso (fun _ => Iso.refl _))

end CompactBridge

section Core

open Opposite CategoryTheory.Pretriangulated CategoryTheory.Pretriangulated.Opposite

/-- For an adjunction whose right adjoint is fully faithful, the counit is an isomorphism. -/
private lemma isIso_counit_of_full_faithful_right {C : Type*} [Category* C] {D : Type*}
    [Category* D] {L : C ⥤ D} {R : D ⥤ C} (adj : L ⊣ R) [R.Full] [R.Faithful] :
    IsIso adj.counit :=
  inferInstance

/-- Let `Fu ⊣ Rt` be an adjunction with `Rt` fully faithful into a Karoubian category, and let the
unit `L ⟶ Rt (Fu L)` be split by `r`. A presheaf naturally isomorphic to `Hom(Rt -, L)` is
representable. -/
lemma isRepresentable_of_retraction_unit {T : Type u₂} [Category.{v₂} T] {D : Type u₁}
    [Category.{v₁} D] [IsIdempotentComplete D] {Fu : T ⥤ D} {Rt : D ⥤ T} [Rt.Full]
    [Rt.Faithful] (adj : Fu ⊣ Rt) {L : T} {r : Rt.obj (Fu.obj L) ⟶ L}
    (hηr : adj.unit.app L ≫ r = 𝟙 L) (F : Dᵒᵖ ⥤ Type w₂)
    (θ : ∀ X : D, F.obj (op X) ≃ (Rt.obj X ⟶ L))
    (hθ : ∀ {X X' : D} (f : X ⟶ X') (z : F.obj (op X')),
      θ X (F.map f.op z) = Rt.map f ≫ θ X' z) :
    F.IsRepresentable := by
  -- Split the resulting idempotent of `Fu.obj L`.
  have hp : (r ≫ adj.unit.app L) ≫ (r ≫ adj.unit.app L) = r ≫ adj.unit.app L := by
    rw [Category.assoc, reassoc_of% hηr]
  have hRε : Rt.map (Rt.preimage (r ≫ adj.unit.app L)) = r ≫ adj.unit.app L :=
    Rt.map_preimage _
  have hε : Rt.preimage (r ≫ adj.unit.app L) ≫ Rt.preimage (r ≫ adj.unit.app L) =
      Rt.preimage (r ≫ adj.unit.app L) :=
    Rt.map_injective (by rw [Rt.map_comp, hRε, hp])
  obtain ⟨Y, i, sY, his, hsi⟩ :=
    IsIdempotentComplete.idempotents_split (Fu.obj L) (Rt.preimage (r ≫ adj.unit.app L)) hε
  have hiε : i ≫ Rt.preimage (r ≫ adj.unit.app L) ≫ sY = 𝟙 Y := by
    rw [← hsi, ← Category.assoc, ← Category.assoc, his, Category.id_comp, his]
  -- The two round trips.
  have hK1 : ∀ {X : D} (g : X ⟶ Y),
      Rt.preimage ((Rt.map (g ≫ i) ≫ r) ≫ adj.unit.app L) ≫ sY = g := by
    intro X g
    have e1 : (Rt.map (g ≫ i) ≫ r) ≫ adj.unit.app L =
        Rt.map ((g ≫ i) ≫ Rt.preimage (r ≫ adj.unit.app L)) := by
      rw [Rt.map_comp (g ≫ i) (Rt.preimage (r ≫ adj.unit.app L)), hRε, Category.assoc]
    rw [e1, Rt.preimage_map]
    simp only [Category.assoc, hiε, Category.comp_id]
  have hK2 : ∀ {X : D} (a : Rt.obj X ⟶ L),
      Rt.map ((Rt.preimage (a ≫ adj.unit.app L) ≫ sY) ≫ i) ≫ r = a := by
    intro X a
    rw [Category.assoc, Rt.map_comp, Rt.map_preimage, hsi, hRε]
    simp only [Category.assoc, hηr, Category.comp_id]
  let ee : ∀ X : D, (X ⟶ Y) ≃ F.obj (op X) := fun X =>
    { toFun := fun g => (θ X).symm (Rt.map (g ≫ i) ≫ r)
      invFun := fun z => Rt.preimage (θ X z ≫ adj.unit.app L) ≫ sY
      left_inv := fun g => by
        dsimp only
        rw [Equiv.apply_symm_apply]
        exact hK1 g
      right_inv := fun z => by
        dsimp only
        rw [hK2 (θ X z), Equiv.symm_apply_apply] }
  have hee : ∀ (X : D) (g : X ⟶ Y), ee X g = (θ X).symm (Rt.map (g ≫ i) ≫ r) := fun _ _ => rfl
  refine Functor.RepresentableBy.isRepresentable
    (Y := Y) { homEquiv := fun {X} => ee X, homEquiv_comp := ?_ }
  intro X X' f g
  refine (θ X).injective ?_
  rw [hee X (f ≫ g), hθ f, hee X' g, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
  simp only [Rt.map_comp, Category.assoc]

/-- Let `Fu ⊣ Rt` be an adjunction between pretriangulated categories with `Fu` triangulated and
invertible counit. If every morphism into `L` from an object killed by `Fu` vanishes, the unit at
`L` is a split monomorphism. -/
lemma exists_retraction_unit_of_isZero {T : Type u₂} [Category.{v₂} T] [Preadditive T]
    [HasZeroObject T] [HasShift T ℤ] [∀ n : ℤ, (shiftFunctor T n).Additive] [Pretriangulated T]
    {D : Type u₁} [Category.{v₁} D] [Preadditive D] [HasZeroObject D] [HasShift D ℤ]
    [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
    {Fu : T ⥤ D} [Fu.CommShift ℤ] [Fu.IsTriangulated] {Rt : D ⥤ T} (adj : Fu ⊣ Rt)
    [IsIso adj.counit] {L : T} (hL : ∀ {N : T} (f : N ⟶ L), IsZero (Fu.obj N) → f = 0) :
    ∃ r : Rt.obj (Fu.obj L) ⟶ L, adj.unit.app L ≫ r = 𝟙 L := by
  -- The unit at `L`, and a distinguished triangle completing it on the left.
  obtain ⟨N, aN, cN, hT⟩ :=
    distinguished_cocone_triangle₁ (adj.unit.app L : L ⟶ Rt.obj (Fu.obj L))
  -- `Fu` kills `N`, because `Fu.map (adj.unit.app L)` is an isomorphism.
  have hFuη : IsIso (Fu.map (adj.unit.app L)) := by
    have h1 : IsIso (Fu.map (adj.unit.app L) ≫ adj.counit.app (Fu.obj L)) := by
      rw [adj.left_triangle_components L]
      exact IsIso.id _
    exact IsIso.of_isIso_comp_right _ (adj.counit.app (Fu.obj L))
  have hFN : IsZero (Fu.obj N) := by
    have hz : IsZero ((Fu.obj N)⟦(1 : ℤ)⟧) :=
      Triangle.isZero₃_of_isIso₁ _ (rot_of_distTriang _ (Fu.map_distinguished _ hT))
        (by dsimp; exact hFuη)
    exact ((shiftFunctor D (-1 : ℤ)).map_isZero hz).of_iso
      ((shiftFunctorCompIsoId D (1 : ℤ) (-1) (by simp)).app (Fu.obj N)).symm
  -- The unit at `L` is therefore a split monomorphism.
  exact (Triangle.yoneda_exact₂ _ hT (𝟙 L) (by simp [hL aN hFN])).imp fun _ h => h.symm

variable {A : Type u₁} [Category.{v₁} A] [Abelian A] [HasDerivedCategory.{w₁} A]

/-- The core of [Stacks, Tag 0F5X]. Let `T` be a compactly generated triangulated category with
direct sums and `Fu : T ⥤ D(A)` an exact functor with a fully faithful right adjoint `Rt`. Then
a contravariant cohomological functor `H` on `D(A)` taking direct sums to products is a direct
summand of a representable functor, hence representable as soon as `D(A)` is Karoubian. -/
private theorem isRepresentable_of_compactGenerators_adjunction
    (T : Type u₂) [Category.{v₂} T] [Preadditive T] [HasZeroObject T] [HasShift T ℤ]
    [∀ n : ℤ, (shiftFunctor T n).Additive] [Pretriangulated T] [IsTriangulated T]
    [HasCoproducts.{v₂} T]
    {ι : Type v₂} (E : ι → T)
    (hcompact : ∀ (i : ι) (α : Type v₂),
      PreservesColimitsOfShape (Discrete α) (preadditiveCoyoneda.obj (op (E i))))
    (hE : ∀ Y : T, ((ObjectProperty.ofObj E).shiftClosure ℤ).rightOrthogonal Y → IsZero Y)
    (Fu : T ⥤ DerivedCategory A) [Fu.CommShift ℤ] [Fu.IsTriangulated]
    (Rt : DerivedCategory A ⥤ T) [Rt.Full] [Rt.Faithful] (adj : Fu ⊣ Rt)
    (H : (DerivedCategory A)ᵒᵖ ⥤ AddCommGrpCat.{v₂}) [H.IsHomological]
    [∀ J : Type v₂, PreservesLimitsOfShape (Discrete J) H]
    [IsIdempotentComplete (DerivedCategory A)] :
    (H ⋙ forget AddCommGrpCat).IsRepresentable := by
  have hcounit : IsIso adj.counit := isIso_counit_of_full_faithful_right adj
  have : Fu.IsLeftAdjoint := adj.isLeftAdjoint
  have : ∀ J : Type v₂, PreservesLimitsOfShape (Discrete J) (Fu.op ⋙ H) := fun J => by
    have : PreservesLimitsOfShape (Discrete J) Fu.op := preservesLimitsOfShape_op (Discrete J) Fu
    infer_instance
  obtain ⟨L, ⟨e⟩⟩ :=
    exists_iso_preadditiveYoneda_of_compactlyGenerated E hE (Fu.op ⋙ H)
  -- Every morphism into `L` from an object killed by `Fu` vanishes, so the unit at `L` is a
  -- split monomorphism.
  obtain ⟨r, hηr⟩ := exists_retraction_unit_of_isZero adj (L := L) fun {N} f hFN => by
    have h1 : IsZero ((preadditiveYoneda.obj L).obj (op N)) :=
      (H.map_isZero hFN.op).of_iso (e.app (op N)).symm
    exact ConcreteCategory.congr_hom (h1.eq_of_src (𝟙 _) 0) f
  -- The natural identification `H(X) ≃ Hom_T(Rt X, L)`.
  let θ : ∀ X : DerivedCategory A,
      (H ⋙ forget AddCommGrpCat).obj (op X) ≃ (Rt.obj X ⟶ L) := fun X =>
    ((forget AddCommGrpCat).mapIso
      (asIso (H.map (adj.counit.app X).op) ≪≫ e.app (op (Rt.obj X)))).toEquiv
  refine isRepresentable_of_retraction_unit adj hηr _ θ fun {X X'} f z => ?_
  have h1 : H.map f.op ≫ H.map (adj.counit.app X).op =
      H.map (adj.counit.app X').op ≫ H.map ((Fu.map (Rt.map f)).op) := by
    rw [← H.map_comp, ← H.map_comp, ← op_comp, ← op_comp]
    congr 1
    simp
  have h3 : H.map f.op ≫ H.map (adj.counit.app X).op ≫ (e.app (op (Rt.obj X))).hom =
      (H.map (adj.counit.app X').op ≫ (e.app (op (Rt.obj X'))).hom) ≫
        (preadditiveYoneda.obj L).map ((Rt.map f).op) := by
    rw [← Category.assoc, h1, Category.assoc, Category.assoc]
    congr 1
    exact e.hom.naturality ((Rt.map f).op)
  exact ConcreteCategory.congr_hom h3 z

end Core

section Aux

open Opposite CategoryTheory.Pretriangulated CategoryTheory.Pretriangulated.Opposite

/-- An object of `D(R)` right orthogonal to every shift of the regular module in degree zero
is zero. -/
private lemma isZero_of_rightOrthogonal_shiftClosure_regularModule {R : Type v₂} [Ring R]
    [HasDerivedCategory.{w₂} (ModuleCat.{v₂} R)] (Y : DerivedCategory (ModuleCat.{v₂} R))
    (hY : ((ObjectProperty.ofObj (fun _ : PUnit.{v₂ + 1} =>
      (DerivedCategory.singleFunctor (ModuleCat.{v₂} R) 0).obj (ModuleCat.of R R))).shiftClosure
        ℤ).rightOrthogonal Y) :
    IsZero Y := by
  have heq : ObjectProperty.ofObj (fun _ : PUnit.{v₂ + 1} =>
        (DerivedCategory.singleFunctor (ModuleCat.{v₂} R) 0).obj (ModuleCat.of R R)) =
      ObjectProperty.singleton
        ((DerivedCategory.singleFunctor (ModuleCat.{v₂} R) 0).obj (ModuleCat.of R R)) := by
    ext Z
    simp [ObjectProperty.ofObj_iff]
  exact StacksDraft.Perfect.isWeakTriangulatedGenerator_regularModule Y (by rwa [← heq])

/-- **Brown representability**, in the form proved by the Gabriel--Popescu embedding: `A` is an
abelian category equivalent to a Grothendieck abelian category `B` whose morphisms live in the
universe of the values of `H`. -/
private theorem isRepresentable_of_equivalence_isGrothendieckAbelian
    {A : Type u₁} [Category.{v₁} A] [Abelian A] [HasDerivedCategory.{w₁} A]
    {B : Type u₂} [Category.{v₂} B] [Abelian B] [IsGrothendieckAbelian.{v₂} B]
    (Φ : A ≌ B) [Φ.functor.Additive] [Φ.inverse.Additive]
    (H : (DerivedCategory A)ᵒᵖ ⥤ AddCommGrpCat.{v₂}) [H.IsHomological]
    [∀ J : Type v₂, PreservesLimitsOfShape (Discrete J) H] :
    (H ⋙ forget AddCommGrpCat).IsRepresentable := by
  classical
  have : IsGrothendieckAbelian.{v₂} A := IsGrothendieckAbelian.of_equivalence Φ.symm
  have : HasCoproducts.{v₂} (DerivedCategory A) :=
    Stacks.Injectives.hasCoproducts_derivedCategory A
  have : HasCoproducts.{0} (DerivedCategory A) := has_smallest_coproducts_of_hasCoproducts
  have : IsIdempotentComplete (DerivedCategory A) :=
    (isIdempotentComplete_of_hasCountableProducts_or_coproducts (DerivedCategory A)).2
  obtain ⟨G, hG⟩ : ∃ G : B, IsSeparator G := ⟨separator B, isSeparator_separator B⟩
  let hMsmall : HasDerivedCategory.{v₂} (ModuleCat.{v₂} (End G)ᵐᵒᵖ) :=
    Stacks.Injectives.hasDerivedCategory_of_isGrothendieckAbelian _
  have : ∀ n : ℤ, (shiftFunctor
      (@DerivedCategory (ModuleCat.{v₂} (End G)ᵐᵒᵖ) _ _ hMsmall) n).Additive :=
    inferInstance
  have : ∀ n : ℤ, (shiftFunctor (@DerivedCategory (ModuleCat.{v₂} (End G)ᵐᵒᵖ) _ _
      (HasDerivedCategory.standard (ModuleCat.{v₂} (End G)ᵐᵒᵖ))) n).Additive := by
    let := HasDerivedCategory.standard (ModuleCat.{v₂} (End G)ᵐᵒᵖ)
    infer_instance
  let hBstd : HasDerivedCategory.{max u₂ v₂} B := HasDerivedCategory.standard B
  obtain ⟨data⟩ := Stacks.Injectives.exists_derivedGabrielPopescuData G hG
  -- the comparison between the two models of the derived category of the module category
  let e₁ := StacksDraft.Perfect.derivedEquivalence hMsmall
    (HasDerivedCategory.standard (ModuleCat.{v₂} (End G)ᵐᵒᵖ))
  let : e₁.functor.CommShift ℤ := StacksDraft.Perfect.derivedEquivalenceCommShift _ _
  have : e₁.functor.IsTriangulated := StacksDraft.Perfect.derivedEquivalence_isTriangulated _ _
  -- the comparison between `D(A)` and `D(B)`
  let e₂ := (mapDerivedCategoryEquivalence Φ).symm
  have : data.rightDerived.Full := data.fullyFaithful.full
  have : data.rightDerived.Faithful := data.fullyFaithful.faithful
  -- the compact generator of the derived category of the module category
  have : HasCoproducts.{v₂} (DerivedCategory (ModuleCat.{v₂} (End G)ᵐᵒᵖ)) :=
    Stacks.Injectives.hasCoproducts_derivedCategory _
  have hQcpt : IsCompactObject.{v₂}
      ((DerivedCategory.singleFunctor (ModuleCat.{v₂} (End G)ᵐᵒᵖ) 0).obj
        (ModuleCat.of (End G)ᵐᵒᵖ (End G)ᵐᵒᵖ)) := by
    have : IsCompactObject.{v₂} (ModuleCat.of (End G)ᵐᵒᵖ (End G)ᵐᵒᵖ) :=
      StacksDraft.Perfect.isCompactObject_regularModule
    exact StacksDraft.Perfect.isCompactObject_derived_single _ 0
  exact isRepresentable_of_compactGenerators_adjunction
    (DerivedCategory (ModuleCat.{v₂} (End G)ᵐᵒᵖ))
    (ι := PUnit.{v₂ + 1})
    (fun _ => (DerivedCategory.singleFunctor (ModuleCat.{v₂} (End G)ᵐᵒᵖ) 0).obj
      (ModuleCat.of (End G)ᵐᵒᵖ (End G)ᵐᵒᵖ))
    (fun _ => preservesColimitsOfShape_preadditiveCoyoneda_of_isCompactObject _ hQcpt)
    isZero_of_rightOrthogonal_shiftClosure_regularModule
    ((e₁.functor ⋙ Stacks.Injectives.derivedTensorObj G hG) ⋙ Φ.inverse.mapDerivedCategory)
    (e₂.inverse ⋙ data.rightDerived ⋙ e₁.inverse)
    ((e₁.toAdjunction.comp data.adjunction).comp e₂.toAdjunction) H

end Aux

section Main

open Opposite CategoryTheory.Pretriangulated CategoryTheory.Pretriangulated.Opposite

universe z w v u u'

/-- **Brown representability for Grothendieck abelian categories**, with the Grothendieck
condition `IsGrothendieckAbelian.{v} A` in the universe `v` of the morphisms of `A`: for a
Grothendieck abelian category `A`, a contravariant cohomological functor
`H : D(A)ᵒᵖ ⥤ AddCommGrpCat.{v}` which transforms direct sums indexed by `Type v` into products
is representable.

This is the statement of [Stacks, Tag 0F5X] for every ordinary Grothendieck abelian category,
e.g. `ModuleCat.{v} R`. The model of `D(A)` is arbitrary; in the model with morphisms in `Type v`
(which exists by `hasDerivedCategory_of_isGrothendieckAbelian`) the functors
`Hom(-, X) = preadditiveYoneda.obj X` themselves satisfy the hypotheses. -/
@[stacks 0F5X "Brown representability: a contravariant cohomological functor D(A) → Ab, A a \
Grothendieck abelian category, which transforms direct sums into products is representable"]
public theorem isRepresentable_of_isHomological_of_isGrothendieckAbelian (A : Type u)
    [Category.{v} A] [Abelian A] [IsGrothendieckAbelian.{v} A] [HasDerivedCategory.{z} A]
    (H : (DerivedCategory A)ᵒᵖ ⥤ AddCommGrpCat.{v}) [H.IsHomological]
    [∀ J : Type v, PreservesLimitsOfShape (Discrete J) H] :
    (H ⋙ forget AddCommGrpCat).IsRepresentable := by
  let Φ : A ≌ A := CategoryTheory.Equivalence.refl
  have : Φ.functor.Additive := inferInstanceAs (𝟭 A).Additive
  have : Φ.inverse.Additive := inferInstanceAs (𝟭 A).Additive
  exact isRepresentable_of_equivalence_isGrothendieckAbelian Φ H

/-- Brown representability under the hypothesis `IsGrothendieckAbelian.{max w u v} A`, with `A`
in `Type u` and its morphisms in `Type v`. That hypothesis gives coproducts indexed by the type
of all morphisms of `A`, so by Freyd's Cantor argument every hom-set of `A` is a subsingleton
and `A` is equivalent to the zero category: this statement is vacuous for every nontrivial `A`.
The faithful statement of [Stacks, Tag 0F5X] is
`isRepresentable_of_isHomological_of_isGrothendieckAbelian`. -/
public theorem isRepresentable_of_isGrothendieckAbelian (A : Type u) [Category.{v} A] [Abelian A]
    [IsGrothendieckAbelian.{max w u v} A] [HasDerivedCategory.{z} A]
    (H : (DerivedCategory A)ᵒᵖ ⥤ AddCommGrpCat.{max u v}) [H.IsHomological]
    [∀ J : Type (max w u v), PreservesLimitsOfShape (Discrete J) H] :
    (H ⋙ forget AddCommGrpCat).IsRepresentable := by
  have : ∀ J : Type (max u v), PreservesLimitsOfShape (Discrete J) H := fun J =>
    preservesLimitsOfShape_of_equiv
      (Discrete.equivalence (Equiv.ulift : ULift.{max w u v} J ≃ J)) H
  have : LocallySmall.{max u v} A := locallySmall_max
  have : IsGrothendieckAbelian.{max w u v} (ShrinkHoms A) :=
    IsGrothendieckAbelian.of_equivalence (ShrinkHoms.equivalence A)
  have : IsGrothendieckAbelian.{max u v} (ShrinkHoms A) :=
    isGrothendieckAbelian_of_univLE.{max w u v, max u v} (ShrinkHoms A)
  have : (ShrinkHoms.equivalence A).functor.Additive :=
    inferInstanceAs ((ShrinkHoms.functor A).Additive)
  have : (ShrinkHoms.equivalence A).inverse.Additive :=
    inferInstanceAs ((ShrinkHoms.inverse A).Additive)
  exact isRepresentable_of_equivalence_isGrothendieckAbelian (ShrinkHoms.equivalence A) H

/-- Let `A` be an abelian category which is Grothendieck abelian relative to the universe
`max w u v`, and `D` a triangulated category. An exact functor `F : D(A) ⥤ D` which transforms
direct sums indexed by `Type (max w u v)` into direct sums has an exact right adjoint: a functor
`G`, an adjunction `F ⊣ G`, and a commutation of `G` with the shift making `G` triangulated.

This is not the statement of [Stacks, Tag 0F5Y]: the hypothesis
`IsGrothendieckAbelian.{max w u v} A` holds for no category with a nonzero object, since a direct
sum `⨁_κ G` of a nonzero `G` over a type `κ` above `v` would give `Hom(⨁_κ G, G) = ∏_κ End(G)`,
too large for `Type v`. The tag is carried by
`Stacks.Injectives.exists_exact_rightAdjoint_of_isGrothendieckAbelian`, which asks for
`IsGrothendieckAbelian.{v} A` and direct sums indexed by `Type v`. -/
public theorem exists_exact_rightAdjoint (A : Type u) [Category.{v} A] [Abelian A]
    [IsGrothendieckAbelian.{max w u v} A] [HasDerivedCategory.{z} A]
    (D : Type u') [Category.{max u v} D] [HasZeroObject D] [HasShift D ℤ] [Preadditive D]
    [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D]
    (F : DerivedCategory A ⥤ D) [F.CommShift ℤ] [F.IsTriangulated]
    [∀ J : Type (max w u v), PreservesColimitsOfShape (Discrete J) F] :
    ∃ (G : D ⥤ DerivedCategory A) (_ : F ⊣ G) (commShift : G.CommShift ℤ),
      let := commShift
      G.IsTriangulated := by
  have hDefined : F.rightAdjointObjIsDefined = ⊤ := by
    refine eq_top_iff.mpr fun Y _ ↦ ?_
    let H : (DerivedCategory A)ᵒᵖ ⥤ AddCommGrpCat.{max u v} :=
      F.op ⋙ preadditiveYoneda.obj Y
    have := main_statement_comp_triangulated_homological F.op (preadditiveYoneda.obj Y)
    have : ∀ J : Type (max w u v), PreservesLimitsOfShape (Discrete J) H := fun J ↦ by
      have := preservesLimitsOfShape_op (Discrete J) F
      have : PreservesLimitsOfShape (Discrete J)
          (preadditiveYoneda.obj Y ⋙ forget AddCommGrpCat) :=
        (inferInstance : PreservesLimitsOfShape (Discrete J) (yoneda.obj Y))
      have : PreservesLimitsOfShape (Discrete J) (preadditiveYoneda.obj Y) :=
        preservesLimitsOfShape_of_reflects_of_preserves _ (forget AddCommGrpCat)
      infer_instance
    obtain ⟨X, ⟨r⟩⟩ :=
      (isRepresentable_of_isGrothendieckAbelian.{z, w, v, u} A H).has_representation
    rw [Functor.rightAdjointObjIsDefined_iff]
    exact (Functor.RepresentableBy.ofIso r
      (NatIso.ofComponents (fun _ ↦ Iso.refl _) (by intros; ext; rfl))).isRepresentable
  have : F.IsLeftAdjoint := Functor.isLeftAdjoint_of_rightAdjointObjIsDefined_eq_top hDefined
  let adj : F ⊣ F.rightAdjoint := Adjunction.ofIsLeftAdjoint F
  let : F.rightAdjoint.CommShift ℤ := adj.rightAdjointCommShift ℤ
  let : adj.CommShift ℤ := adj.commShift_of_leftAdjoint ℤ
  exact ⟨F.rightAdjoint, adj, inferInstance, adj.isTriangulated_rightAdjoint⟩

end Main

end Stacks.Injectives
