/-!
# The Yoneda embedding of an abelian category into abelian sheaves on its epimorphism site

Let `𝒜` be an abelian category with pullbacks and equip it with the pretopology of Tag 05PM,
whose covering families are the singletons `{f : V ⟶ U}` with `f` an epimorphism. Tag 05PN
records two facts about the resulting site.

First, every additive representable presheaf `Hom(-, X)` is a sheaf: a compatible family for a
single epimorphism cover `f : V ⟶ U` is a map out of `V` killing `kernel f`, and `Abelian.epiDesc`
descends it uniquely. The additive Yoneda functor therefore lifts to a functor
`𝒜 ⥤ Sheaf 𝒜_epi AddCommGrpCat`, which is fully faithful because Yoneda is, and exact: it
preserves finite limits because the composite with `sheafToPresheaf` does, and it preserves
finite colimits because after a universe shift it is additive, preserves epimorphisms (a
surjection of sheaves can be checked locally, and the relevant local lift exists because
`𝒜` has pullbacks of epimorphisms along arbitrary maps) and preserves kernels, hence preserves
homology.

Second, the site has enough points. Every covering sieve is refined by a single-arrow family,
so the finite-refinement criterion
`GrothendieckTopology.hasEnoughPoints_of_exists_finite_refinement` applies, and enough points
gives a conservative family.

## Main definitions

* `Stacks.Injectives.epiPretopology`: the pretopology of Tag 05PM, whose coverings are
  `Stacks.Sites.EpiPretopology.EpiCoverings`.
* `Stacks.Injectives.yonedaSheaf`: the additive Yoneda functor regarded as a functor into
  abelian sheaves for this topology.

## Main results

* `Stacks.Injectives.preadditiveYoneda_obj_isSheaf`: additive representable presheaves are
  sheaves for the epimorphism topology.
* `Stacks.Injectives.yonedaSheaf_full` and `Stacks.Injectives.yonedaSheaf_faithful`: the
  functor is fully faithful.
* `Stacks.Injectives.yonedaSheaf_preservesFiniteLimits` and
  `Stacks.Injectives.yonedaSheaf_preservesFiniteColimits`: the functor is exact.
* `Stacks.Injectives.epiPretopology_hasEnoughPoints`: the site has a conservative family of
  points.

## Implementation notes

Tag 05PM is stated as the *existence* statement
`Stacks.Sites.EpiPretopology.exists_pretopology_epiCoverings`, which cannot be used to name a
site. The pretopology is therefore assembled here as `epiPretopology` out of the axiom lemmas
`Stacks.Sites.EpiPretopology.epiCoverings_has_isos`, `_pullbacks` and `_transitive`, and
`epiPretopology_coverings` records that its coverings are
`Stacks.Sites.EpiPretopology.EpiCoverings` on the nose.

Enough points is expressed by the existence of a conservative family, without requiring that
family to be small.

## References

* [Stacks Project, Tag 05PN](https://stacks.math.columbia.edu/tag/05PN)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u v

namespace Stacks.Injectives

variable (𝒜 : Type u) [Category.{v} 𝒜] [Abelian 𝒜]

/-- The pretopology on an abelian category whose covering presieves are the singletons
generated by epimorphisms. -/
def epiPretopology : Pretopology 𝒜 where
  coverings := Stacks.Sites.EpiPretopology.EpiCoverings 𝒜
  has_isos _ _ f _ := Stacks.Sites.EpiPretopology.epiCoverings_has_isos 𝒜 f
  pullbacks _ _ f S hS := Stacks.Sites.EpiPretopology.epiCoverings_pullbacks 𝒜 f S hS
  transitive _ S Ti hS hTi := Stacks.Sites.EpiPretopology.epiCoverings_transitive 𝒜 S Ti hS hTi

/-- The covering families in the epimorphism pretopology are exactly the singleton families
whose arrow is an epimorphism. -/
theorem epiPretopology_coverings (U : 𝒜) :
    (epiPretopology 𝒜).coverings U = Stacks.Sites.EpiPretopology.EpiCoverings 𝒜 U := rfl

/-- Additive representable presheaves on an abelian category are sheaves for the topology
generated by epimorphism covers. -/
@[stacks 05PN "the embedding"]
theorem preadditiveYoneda_obj_isSheaf (X : 𝒜) :
    Presheaf.IsSheaf (epiPretopology 𝒜).toGrothendieck (preadditiveYoneda.obj X) := by
  intro E
  let Q : 𝒜ᵒᵖ ⥤ Type v := preadditiveYoneda.obj X ⋙ coyoneda.obj (Opposite.op E)
  change Presieve.IsSheaf _ Q
  rw [Presieve.isSheaf_pretopology (epiPretopology 𝒜)]
  intro U R hR
  rw [epiPretopology_coverings] at hR
  obtain ⟨V, f, hf, rfl⟩ := hR
  let : Epi f := hf
  apply Presieve.isSeparatedFor_and_exists_isAmalgamation_iff_isSheafFor.1
  constructor
  · intro x s t hs ht
    apply ConcreteCategory.hom_ext
    intro e
    apply (cancel_epi f).1
    have hse := congrArg (fun z : E ⟶ (preadditiveYoneda.obj X).obj (Opposite.op V) =>
      ConcreteCategory.hom z e) (hs f (by simp))
    have hte := congrArg (fun z : E ⟶ (preadditiveYoneda.obj X).obj (Opposite.op V) =>
      ConcreteCategory.hom z e) (ht f (by simp))
    change f ≫ ConcreteCategory.hom s e = ConcreteCategory.hom (x f (by simp)) e at hse
    change f ≫ ConcreteCategory.hom t e = ConcreteCategory.hom (x f (by simp)) e at hte
    exact hse.trans hte.symm
  · intro x hx
    have hx' : ∀ {Z : 𝒜} (p₁ p₂ : Z ⟶ V), p₁ ≫ f = p₂ ≫ f →
        Q.map p₁.op (x f (by simp)) = Q.map p₂.op (x f (by simp)) :=
      (Presieve.FamilyOfElements.compatible_singleton_iff f x).1 hx
    have hkernel (e : E) : kernel.ι f ≫ ConcreteCategory.hom (x f (by simp)) e = 0 := by
      have h := hx' (Z := kernel f) (kernel.ι f) 0 (by simp)
      have h' := congrArg (fun z : E ⟶ (preadditiveYoneda.obj X).obj
        (Opposite.op (kernel f)) => ConcreteCategory.hom z e) h
      change kernel.ι f ≫ ConcreteCategory.hom (x f (by simp)) e =
        (0 : kernel f ⟶ V) ≫ ConcreteCategory.hom (x f (by simp)) e at h'
      exact h'.trans zero_comp
    let t : E ⟶ (preadditiveYoneda.obj X).obj (Opposite.op U) :=
      AddCommGrpCat.ofHom {
        toFun := fun e => Abelian.epiDesc f (ConcreteCategory.hom (x f (by simp)) e) (hkernel e)
        map_zero' := by
          apply (cancel_epi f).1
          refine (Abelian.comp_epiDesc f _ _).trans ?_
          refine (map_zero _).trans ?_
          exact comp_zero.symm
        map_add' := by
          intro e₁ e₂
          apply (cancel_epi f).1
          refine (Abelian.comp_epiDesc f _ _).trans ?_
          refine (map_add _ e₁ e₂).trans ?_
          refine (congrArg₂ (· + ·) (Abelian.comp_epiDesc f _ (hkernel e₁)).symm
            (Abelian.comp_epiDesc f _ (hkernel e₂)).symm).trans ?_
          exact (Preadditive.comp_add _ _ _ _ _ _).symm }
    refine ⟨t, (Presieve.FamilyOfElements.isAmalgamation_singleton_iff f x t).2 ?_⟩
    apply ConcreteCategory.hom_ext
    intro e
    change f ≫ Abelian.epiDesc f (ConcreteCategory.hom (x f (by simp)) e) (hkernel e) =
      ConcreteCategory.hom (x f (by simp)) e
    exact Abelian.comp_epiDesc f _ _

/-- The Yoneda functor from an abelian category to abelian sheaves for its epimorphism
topology. Its underlying presheaf functor is definitionally the additive Yoneda functor. -/
@[stacks 05PN "the embedding"]
noncomputable def yonedaSheaf :
    𝒜 ⥤ Sheaf (epiPretopology 𝒜).toGrothendieck AddCommGrpCat.{v} :=
  ObjectProperty.lift _ preadditiveYoneda (preadditiveYoneda_obj_isSheaf 𝒜)

/-- The Yoneda functor into abelian sheaves is full. -/
@[stacks 05PN "the embedding"]
theorem yonedaSheaf_full : (yonedaSheaf 𝒜).Full := by
  dsimp only [yonedaSheaf]
  infer_instance

/-- The Yoneda functor into abelian sheaves is faithful. -/
@[stacks 05PN "the embedding"]
theorem yonedaSheaf_faithful : (yonedaSheaf 𝒜).Faithful := by
  dsimp only [yonedaSheaf]
  infer_instance

/-- The Yoneda functor into abelian sheaves preserves finite limits. -/
@[stacks 05PN "the embedding"]
theorem yonedaSheaf_preservesFiniteLimits : PreservesFiniteLimits (yonedaSheaf 𝒜) := by
  have : PreservesFiniteLimits (yonedaSheaf 𝒜 ⋙ sheafToPresheaf _ _) := by
    change PreservesFiniteLimits (preadditiveYoneda : 𝒜 ⥤ 𝒜ᵒᵖ ⥤ AddCommGrpCat.{v})
    refine ⟨fun J _ _ => ?_⟩
    apply preservesLimitsOfShape_of_evaluation
    intro X
    change PreservesLimitsOfShape J (preadditiveCoyoneda.obj X)
    infer_instance
  exact preservesFiniteLimits_of_reflects_of_preserves (yonedaSheaf 𝒜) (sheafToPresheaf _ _)

/-- The Yoneda functor into abelian sheaves preserves finite colimits. -/
@[stacks 05PN "the embedding"]
theorem yonedaSheaf_preservesFiniteColimits : PreservesFiniteColimits (yonedaSheaf 𝒜) := by
  let J := (epiPretopology 𝒜).toGrothendieck
  let L := sheafCompose J AddCommGrpCat.uliftFunctor.{u, v}
  let F := yonedaSheaf 𝒜 ⋙ L
  have : PreservesFiniteLimits (F ⋙ sheafToPresheaf J AddCommGrpCat.{max u v}) := by
    refine ⟨fun K _ _ => ?_⟩
    apply preservesLimitsOfShape_of_evaluation
    intro X
    change PreservesLimitsOfShape K
      (preadditiveCoyoneda.obj X ⋙ AddCommGrpCat.uliftFunctor.{u, v})
    infer_instance
  have : PreservesFiniteLimits F :=
    preservesFiniteLimits_of_reflects_of_preserves F (sheafToPresheaf J _)
  have : F.Additive := F.additive_of_preserves_binary_products
  have : F.PreservesEpimorphisms := by
    constructor
    intro X Y f hf
    have : Sheaf.IsLocallySurjective (F.map f) := by
      constructor
      intro U s
      change Presheaf.imageSieve _ s ∈ (epiPretopology 𝒜).toGrothendieck U
      rw [Pretopology.mem_toGrothendieck]
      refine ⟨Presieve.singleton (pullback.fst s.down f), ?_, ?_⟩
      · rw [epiPretopology_coverings]
        exact ⟨pullback s.down f, pullback.fst s.down f,
          Abelian.epi_pullback_of_epi_g s.down f, rfl⟩
      · rintro V g ⟨⟩
        refine ⟨ULift.up (pullback.snd s.down f), ?_⟩
        change ULift.up (pullback.snd s.down f ≫ f) =
          ULift.up (pullback.fst s.down f ≫ s.down)
        exact congrArg ULift.up pullback.condition.symm
    exact Sheaf.epi_of_isLocallySurjective (F.map f)
  have : F.PreservesHomology := F.preservesHomology_of_preservesEpis_and_kernels
  have : PreservesFiniteColimits F := F.preservesFiniteColimits_of_preservesHomology
  have : ReflectsColimits L := fullyFaithful_reflectsColimits L
  have : ReflectsFiniteColimits L := ReflectsColimitsOfSize.reflectsFiniteColimits L
  exact preservesFiniteColimits_of_reflects_of_preserves (yonedaSheaf 𝒜) L

/-- The site on an abelian category whose covers are singleton epimorphisms has enough
points. -/
@[stacks 05PN "enough points"]
theorem epiPretopology_hasEnoughPoints :
    GrothendieckTopology.HasConservativeFamily.{max u v}
      (epiPretopology 𝒜).toGrothendieck := by
  have : GrothendieckTopology.HasEnoughPoints.{max u v}
      (epiPretopology 𝒜).toGrothendieck := by
    apply GrothendieckTopology.hasEnoughPoints_of_exists_finite_refinement
    intro X S hS
    obtain ⟨R, hR, hRS⟩ := (Pretopology.mem_toGrothendieck _ _ _).mp hS
    obtain ⟨V, f, hf, rfl⟩ := (epiPretopology_coverings 𝒜 X) ▸ hR
    refine ⟨Unit, inferInstance, fun _ => V, fun _ => f, ?_, ?_⟩
    · intro Z q hq
      obtain ⟨i, a, rfl⟩ := (Sieve.mem_ofArrows_iff _ _ q).mp hq
      exact S.downward_closed (hRS _ _ Presieve.singleton.mk) a
    · apply (Pretopology.mem_toGrothendieck _ X (Sieve.ofArrows _ _)).2
      refine ⟨Presieve.singleton f, ?_, ?_⟩
      · exact (epiPretopology_coverings 𝒜 X).symm ▸ ⟨V, f, hf, rfl⟩
      · rintro Z q ⟨⟩
        exact Sieve.ofArrows_mk _ _ ()
  exact GrothendieckTopology.HasConservativeFamily.of_hasEnoughPoints _

end Stacks.Injectives
