  [∀ J : Type w, PreservesColimitsOfShape (Discrete J) G]
  (τ : F ⟶ G)

/-- **The dévissage for a locally small category, with no compatibility of `τ` with the shift.**
Let `D` be a pre-triangulated category which is `LocallySmall.{w}`, has `Type w`-indexed direct
sums, and is generated by a family `E`, indexed by `Type w`, of objects compact for
`Type w`-indexed direct sums, and let `F, G : D ⥤ D'` be exact functors preserving those direct
sums. A morphism `τ : F ⟶ G` which is invertible at every shift of every `E i` is invertible at
every object of `D`.

This is `StacksDraft.CompactDevissage.isIso_app_of_isCompactlyGenerated_of_forall_shift`
transported along the triangulated equivalence of `D` with a model with `w`-small morphisms. -/
theorem isIso_app_of_isCompactlyGenerated_of_forall_shift_of_locallySmall {ι : Type w}
    (E : ι → D) (hEc : ∀ i, IsCompactObject.{w} (E i))
    (hE : ∀ Y : D, ((ofObj E).shiftClosure ℤ).rightOrthogonal Y → IsZero Y)
    (hτ : ∀ i (n : ℤ), IsIso (τ.app ((E i)⟦n⟧))) (X : D) : IsIso (τ.app X) := by
  obtain ⟨D₀, _, _, _, _, _, _, e, _, _, _, _, _, _, -⟩ :=
    exists_triangulatedEquivalence_of_locallySmall.{w} D
  have : HasCoproducts.{w} D₀ := fun _ => Adjunction.hasColimitsOfShape_of_equivalence e.inverse
  let E₀ : ι → D₀ := fun i => e.functor.obj (E i)
  have hEc₀ : ∀ i, IsCompactObject.{w} (E₀ i) := fun i =>
    (isCompactObject_iff_isCompactObject_obj e.functor (E i)).1 (hEc i)
  have hE₀ : ∀ Y : D₀, ((ofObj E₀).shiftClosure ℤ).rightOrthogonal Y → IsZero Y := fun Y hY =>
    (Functor.map_isZero e.functor
      (hE _ (rightOrthogonal_shiftClosure_ofObj_inverse e E Y hY))).of_iso (e.counitIso.app Y).symm
  have hτ₀ : ∀ i (n : ℤ), IsIso ((Functor.whiskerLeft e.inverse τ).app ((E₀ i)⟦n⟧)) :=
    fun i n => (τ.isIso_app_iff_of_iso ((e.inverse.commShiftIso n).app (E₀ i) ≪≫
      (shiftFunctor D n).mapIso (e.unitIso.app (E i)).symm)).2 (hτ i n)
  exact (τ.isIso_app_iff_of_iso (e.unitIso.app X)).2
    (isIso_app_of_isCompactlyGenerated_of_forall_shift (Functor.whiskerLeft e.inverse τ)
      E₀ hEc₀ hE₀ hτ₀ (e.functor.obj X))

end LocallySmall

