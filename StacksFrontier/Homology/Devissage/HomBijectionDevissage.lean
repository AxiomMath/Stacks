module

public import StacksFrontier.Homology.Devissage.CompactGeneratedNatTransProp

/-!
# Dévissage for a natural family of maps between groups of morphisms

Let `E : D ⥤ D₁` and `F : D ⥤ D₂` be exact functors of pre-triangulated categories, `Z₁` an object
of `D₁` and `Z₂` one of `D₂`, and let `ψ_L : Hom(E L, Z₁) → Hom(F L, Z₂)` be additive maps,
natural in `L`. The objects `L` all of whose shifts have `ψ` bijective satisfy the closure
properties of a localizing subcategory: they are closed under isomorphisms, shifts, cones and,
when `E` and `F` preserve direct sums, direct sums. The extension step is the five lemma for the
long exact sequences of groups of morphisms of the triangles `E(T)` and `F(T)`; no compatibility
of `ψ` with the shifts is needed, because the connecting morphisms enter only as morphisms of `D`.

## Main results

* `StacksDraft.CompactDevissage.bijective_obj₂_of_distTriang`: the five lemma.
* `StacksDraft.CompactDevissage.bijective_of_isCompactlyGenerated`: if `D` has direct sums and is
  generated by compact objects at all of whose shifts `ψ` is bijective, then `ψ` is bijective at
  every object.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Pretriangulated
open CategoryTheory.Functor CategoryTheory.ObjectProperty

namespace StacksDraft.CompactDevissage

universe v v₁ v₂ v₃ u u₁ u₂ u₃

section HomBijection

variable {D : Type u} [Category.{v} D] {D₁ : Type u₁} [Category.{v₁} D₁]
  {D₂ : Type u₂} [Category.{v₂} D₂] (E : D ⥤ D₁) (F : D ⥤ D₂) {Z₁ : D₁} {Z₂ : D₂}
  (ψ : ∀ L : D, (E.obj L ⟶ Z₁) → (F.obj L ⟶ Z₂))
  (hnat : ∀ {L L' : D} (ℓ : L ⟶ L') (x : E.obj L' ⟶ Z₁), ψ L (E.map ℓ ≫ x) = F.map ℓ ≫ ψ L' x)

section Additive

variable [Preadditive D₁] [Preadditive D₂]
  (hadd : ∀ (L : D) (x x' : E.obj L ⟶ Z₁), ψ L (x + x') = ψ L x + ψ L x')

include hadd in
/-- `ψ L` sends `0` to `0`. -/
theorem map_zero_of_add (L : D) : ψ L 0 = 0 := by
  have h := hadd L 0 0
  rw [add_zero] at h
  exact add_eq_left.mp h.symm

include hadd in
/-- `ψ L` commutes with subtraction. -/
theorem map_sub_of_add (L : D) (x x' : E.obj L ⟶ Z₁) : ψ L (x - x') = ψ L x - ψ L x' :=
  eq_sub_of_add_eq (by rw [← hadd, sub_add_cancel])

include hadd in
/-- `ψ L` is injective as soon as its kernel is zero. -/
theorem injective_of_eq_zero {L : D} (h : ∀ x, ψ L x = 0 → x = 0) : Function.Injective (ψ L) :=
  fun x x' hx => sub_eq_zero.mp (h _ (by rw [map_sub_of_add E F ψ hadd, hx, sub_self]))

end Additive

/-- Injectivity of `ψ` at `L` gives injectivity at an isomorphic object `L'`. -/
private theorem injective_of_iso_aux
    {C C₁ C₂ : Type*} [Category C] [Category C₁] [Category C₂] (E : C ⥤ C₁) (F : C ⥤ C₂)
    {Z₁ : C₁} {Z₂ : C₂} (ψ : ∀ L : C, (E.obj L ⟶ Z₁) → (F.obj L ⟶ Z₂))
    (hnat : ∀ {L L' : C} (ℓ : L ⟶ L') (x : E.obj L' ⟶ Z₁),
      ψ L (E.map ℓ ≫ x) = F.map ℓ ≫ ψ L' x)
    {L L' : C} (e : L ≅ L') (h : Function.Injective (ψ L)) : Function.Injective (ψ L') :=
    fun x x' hxx' => by
  simpa using congrArg (fun t => E.map e.inv ≫ t)
    (h (by rw [hnat, hnat, hxx'] : ψ L (E.map e.hom ≫ x) = ψ L (E.map e.hom ≫ x')))

/-- Surjectivity of `ψ` at `L` gives surjectivity at an isomorphic object `L'`. -/
private theorem surjective_of_iso_aux
    {C C₁ C₂ : Type*} [Category C] [Category C₁] [Category C₂] (E : C ⥤ C₁) (F : C ⥤ C₂)
    {Z₁ : C₁} {Z₂ : C₂} (ψ : ∀ L : C, (E.obj L ⟶ Z₁) → (F.obj L ⟶ Z₂))
    (hnat : ∀ {L L' : C} (ℓ : L ⟶ L') (x : E.obj L' ⟶ Z₁),
      ψ L (E.map ℓ ≫ x) = F.map ℓ ≫ ψ L' x)
    {L L' : C} (e : L ≅ L') (h : Function.Surjective (ψ L)) : Function.Surjective (ψ L') := by
  intro b
  obtain ⟨a, ha⟩ := h (F.map e.hom ≫ b)
  refine ⟨E.map e.inv ≫ a, ?_⟩
  rw [hnat, ha, ← Category.assoc, ← F.map_comp, e.inv_hom_id, F.map_id, Category.id_comp]

include hnat in
/-- Bijectivity of `ψ` transports along isomorphisms. -/
theorem bijective_of_iso {L L' : D} (e : L ≅ L') (h : Function.Bijective (ψ L)) :
    Function.Bijective (ψ L') :=
  ⟨injective_of_iso_aux E F ψ hnat e h.1, surjective_of_iso_aux E F ψ hnat e h.2⟩

include hnat in
/-- Injectivity of `ψ` transports along isomorphisms. -/
theorem injective_of_iso {L L' : D} (e : L ≅ L') (h : Function.Injective (ψ L)) :
    Function.Injective (ψ L') :=
  injective_of_iso_aux E F ψ hnat e h

include hnat in
/-- Surjectivity of `ψ` transports along isomorphisms. -/
theorem surjective_of_iso {L L' : D} (e : L ≅ L') (h : Function.Surjective (ψ L)) :
    Function.Surjective (ψ L') :=
  surjective_of_iso_aux E F ψ hnat e h

include hnat in
/-- `ψ` is bijective at a direct sum preserved by `E` and `F` as soon as it is bijective at each
summand. -/
theorem bijective_of_isColimit {J : Type*} {G : Discrete J ⥤ D} {c : Cocone G} (hc : IsColimit c)
    [PreservesColimit G E] [PreservesColimit G F] (h : ∀ j, Function.Bijective (ψ (G.obj j))) :
    Function.Bijective (ψ c.pt) := by
  have hcE : IsColimit (E.mapCocone c) := isColimitOfPreserves E hc
  have hcF : IsColimit (F.mapCocone c) := isColimitOfPreserves F hc
  refine ⟨fun x x' hxx' => hcE.hom_ext fun j => (h j).1 ?_, fun b => ?_⟩
  · exact (hnat (c.ι.app j) x).trans
      ((congrArg (fun t => F.map (c.ι.app j) ≫ t) hxx').trans (hnat (c.ι.app j) x').symm)
  · choose a ha using fun j => (h j).2 (F.map (c.ι.app j) ≫ b)
    let s : Cocone (G ⋙ E) := ⟨Z₁, Discrete.natTrans a⟩
    refine ⟨hcE.desc s, hcF.hom_ext fun j => ?_⟩
    exact (hnat (c.ι.app j) _).symm.trans ((congrArg (ψ (G.obj j)) (hcE.fac s j)).trans (ha j))

section Shift

variable [HasShift D ℤ]

/-- The objects all of whose shifts have `ψ` bijective. -/
def shiftBijective : ObjectProperty D :=
  fun L => ∀ n : ℤ, Function.Bijective (ψ (L⟦n⟧))

include hnat in
/-- The objects all of whose shifts have `ψ` bijective are closed under isomorphisms. -/
theorem shiftBijective_isClosedUnderIsomorphisms :
    (shiftBijective E F ψ).IsClosedUnderIsomorphisms :=
  ⟨fun e h n => bijective_of_iso E F ψ hnat ((shiftFunctor D n).mapIso e) (h n)⟩

include hnat in
/-- The objects all of whose shifts have `ψ` bijective are closed under shifts. -/
theorem shiftBijective_shift (L : D) (m : ℤ) (h : shiftBijective E F ψ L) :
    shiftBijective E F ψ (L⟦m⟧) :=
  fun n => bijective_of_iso E F ψ hnat ((shiftFunctorAdd' D m n (m + n) rfl).app L) (h (m + n))

include hnat in
/-- The objects all of whose shifts have `ψ` bijective are closed under direct sums indexed by `J`
when `E` and `F` preserve them. -/
theorem shiftBijective_of_colimitsOfShape {J : Type*} [PreservesColimitsOfShape (Discrete J) E]
    [PreservesColimitsOfShape (Discrete J) F] (X : D)
    (hX : (shiftBijective E F ψ).colimitsOfShape (Discrete J) X) : shiftBijective E F ψ X := by
  obtain ⟨p⟩ := hX
  intro n
  exact bijective_of_isColimit E F ψ hnat (G := p.diag ⋙ shiftFunctor D n)
    (isColimitOfPreserves (shiftFunctor D n) p.isColimit) fun j => p.prop_diag_obj j n

end Shift

section Triangulated

variable [Preadditive D] [HasZeroObject D] [HasShift D ℤ] [∀ n : ℤ, (shiftFunctor D n).Additive]
  [Pretriangulated D] [Preadditive D₁] [HasZeroObject D₁] [HasShift D₁ ℤ]
  [∀ n : ℤ, (shiftFunctor D₁ n).Additive] [Pretriangulated D₁] [Preadditive D₂] [HasZeroObject D₂]
  [HasShift D₂ ℤ] [∀ n : ℤ, (shiftFunctor D₂ n).Additive] [Pretriangulated D₂]
  [E.CommShift ℤ] [F.CommShift ℤ] [E.IsTriangulated] [F.IsTriangulated]
  (hadd : ∀ (L : D) (x x' : E.obj L ⟶ Z₁), ψ L (x + x') = ψ L x + ψ L x')

/-- The image of a distinguished triangle under an exact functor is exact for morphisms into a
fixed object, at its second vertex. -/
theorem exists_eq_map_comp_of_distTriang {D' : Type u₃} [Category.{v₃} D'] [Preadditive D']
    [HasZeroObject D'] [HasShift D' ℤ] [∀ n : ℤ, (shiftFunctor D' n).Additive] [Pretriangulated D']
    (G : D ⥤ D') [G.CommShift ℤ] [G.IsTriangulated] (T : Triangle D) (hT : T ∈ distTriang D)
    {Z : D'} (x : G.obj T.obj₂ ⟶ Z) (hx : G.map T.mor₁ ≫ x = 0) :
    ∃ y : G.obj T.obj₃ ⟶ Z, x = G.map T.mor₂ ≫ y :=
  Triangle.yoneda_exact₂ _ (G.map_distinguished T hT) x hx

include hnat hadd in
/-- **The five lemma.** For a distinguished triangle `A ⟶ B ⟶ C ⟶ A⟦1⟧`, if `ψ` is bijective at
`A` and at `C`, surjective at `A⟦1⟧` and injective at `C⟦-1⟧`, then it is bijective at `B`. -/
theorem bijective_obj₂_of_distTriang (T : Triangle D) (hT : T ∈ distTriang D)
    (h₁ : Function.Bijective (ψ T.obj₁)) (h₃ : Function.Bijective (ψ T.obj₃))
    (h₁s : Function.Surjective (ψ (T.obj₁⟦(1 : ℤ)⟧)))
    (h₃i : Function.Injective (ψ (T.obj₃⟦(-1 : ℤ)⟧))) :
    Function.Bijective (ψ T.obj₂) := by
  have hrot := rot_of_distTriang T hT
  have hinv := inv_rot_of_distTriang T hT
  refine ⟨injective_of_eq_zero E F ψ hadd fun x hx => ?_, fun b => ?_⟩
  · have hux : E.map T.mor₁ ≫ x = 0 := h₁.1 (by
      rw [hnat, hx, Limits.comp_zero, map_zero_of_add E F ψ hadd])
    obtain ⟨y, rfl⟩ := exists_eq_map_comp_of_distTriang E T hT x hux
    have hy : F.map T.mor₂ ≫ ψ T.obj₃ y = 0 := by rw [← hnat]; exact hx
    obtain ⟨z₂, hz₂⟩ := exists_eq_map_comp_of_distTriang F T.rotate hrot (ψ T.obj₃ y) hy
    obtain ⟨z₁, rfl⟩ := h₁s z₂
    have hy' : y = E.map T.mor₃ ≫ z₁ := h₃.1 (by rw [hnat]; exact hz₂)
    rw [hy', ← Category.assoc, ← E.map_comp, comp_distTriang_mor_zero₂₃ T hT, E.map_zero,
      Limits.zero_comp]
  · obtain ⟨a, ha⟩ := h₁.2 (F.map T.mor₁ ≫ b)
    let w' : T.obj₃⟦(-1 : ℤ)⟧ ⟶ T.obj₁ := T.invRotate.mor₁
    have h0 : w' ≫ T.mor₁ = 0 := comp_distTriang_mor_zero₁₂ _ hinv
    have hwa : E.map w' ≫ a = 0 := by
      refine h₃i ((hnat w' a).trans ?_)
      rw [map_zero_of_add E F ψ hadd, ha, ← Category.assoc, ← F.map_comp, h0, F.map_zero,
        Limits.zero_comp]
    obtain ⟨s, hs⟩ : ∃ s : E.obj T.obj₂ ⟶ Z₁, a = E.map T.mor₁ ≫ s :=
      exists_eq_map_comp_of_distTriang E T.invRotate hinv a hwa
    have hbs : F.map T.mor₁ ≫ (b - ψ T.obj₂ s) = 0 := by
      rw [Preadditive.comp_sub, ← ha, ← hnat, ← hs, sub_self]
    obtain ⟨c, hc⟩ := exists_eq_map_comp_of_distTriang F T hT _ hbs
    obtain ⟨y, rfl⟩ := h₃.2 c
    refine ⟨s + E.map T.mor₂ ≫ y, ?_⟩
    rw [hadd, hnat, ← hc, add_sub_cancel]

include hnat hadd in
/-- The objects all of whose shifts have `ψ` bijective are closed under cones. -/
theorem shiftBijective_obj₃ (T : Triangle D) (hT : T ∈ distTriang D)
    (h₁ : shiftBijective E F ψ T.obj₁) (h₂ : shiftBijective E F ψ T.obj₂) :
    shiftBijective E F ψ T.obj₃ := by
  intro n
  have hTn := Triangle.shift_distinguished _ (rot_of_distTriang T hT) n
  refine bijective_obj₂_of_distTriang E F ψ hnat hadd _ hTn (h₂ n) ?_ ?_ ?_
  · exact bijective_of_iso E F ψ hnat ((shiftFunctorAdd' D 1 n (1 + n) rfl).app T.obj₁)
      (h₁ (1 + n))
  · exact (bijective_of_iso E F ψ hnat ((shiftFunctorAdd' D n 1 (n + 1) rfl).app T.obj₂)
      (h₂ (n + 1))).2
  · exact (bijective_of_iso E F ψ hnat
      ((shiftFunctorAdd' D (1 + n) (-1) n (by omega)).app T.obj₁ ≪≫
        (shiftFunctor D (-1)).mapIso ((shiftFunctorAdd' D 1 n (1 + n) rfl).app T.obj₁))
      (h₁ n)).1

include hnat hadd in
/-- **The dévissage.** Let `D` have direct sums and be generated by a family `G` of compact
objects, and let `E` and `F` preserve direct sums. If `ψ` is bijective at every shift of every
`G i`, it is bijective at every object of `D`. -/
theorem bijective_of_isCompactlyGenerated [HasCoproducts.{v} D]
    [∀ J : Type v, PreservesColimitsOfShape (Discrete J) E]
    [∀ J : Type v, PreservesColimitsOfShape (Discrete J) F] {ι : Type v} (G : ι → D)
    (hGc : ∀ i, IsCompactObject.{v} (G i))
    (hG : ∀ Y : D, ((ofObj G).shiftClosure ℤ).rightOrthogonal Y → IsZero Y)
    (hgen : ∀ i (n : ℤ), Function.Bijective (ψ ((G i)⟦n⟧))) (X : D) :
    Function.Bijective (ψ X) := by
  have := shiftBijective_isClosedUnderIsomorphisms E F ψ hnat
  have hP := prop_of_isCompactlyGenerated (shiftBijective E F ψ)
    (shiftBijective_shift E F ψ hnat) (shiftBijective_obj₃ E F ψ hnat hadd)
    (fun J X hX => shiftBijective_of_colimitsOfShape E F ψ hnat X hX) G hGc hG hgen X
  exact bijective_of_iso E F ψ hnat ((shiftFunctorZero D ℤ).app X) (hP 0)

end Triangulated

end HomBijection

end StacksDraft.CompactDevissage
