  {F G : D ⥤ D'} [F.CommShift ℤ] [G.CommShift ℤ] [F.IsTriangulated] [G.IsTriangulated]
  (τ : F ⟶ G) [NatTrans.CommShift τ ℤ]


end Triangulated

/-! ### Direct sums of shifts -/

section DirectSums

variable {D : Type u} [Category.{v} D] [HasShift D ℤ]
  {D' : Type u'} [Category.{v'} D'] [HasShift D' ℤ]
  {F G : D ⥤ D'} [F.CommShift ℤ] [G.CommShift ℤ]
  [∀ J : Type v, PreservesColimitsOfShape (Discrete J) F]
  [∀ J : Type v, PreservesColimitsOfShape (Discrete J) G]
  (τ : F ⟶ G) [NatTrans.CommShift τ ℤ]

/-- `τ` is invertible on every direct sum of shifts of a family on which it is invertible. This is
the object property that the cell presentation puts on the base of its tower and on each of the
cells attached along the way. -/
lemma isIso_app_of_colimitsOfShape_shiftClosure {ι : Type v} (E : ι → D)
    (hτ : ∀ i, IsIso (τ.app (E i))) (Y : D)
    (hY : (⨆ J : Type v, ((ofObj E).shiftClosure ℤ).colimitsOfShape (Discrete J)) Y) :
    IsIso (τ.app Y) := by
  rw [ObjectProperty.prop_iSup_iff] at hY
  obtain ⟨J, hJ⟩ := hY
  obtain ⟨p⟩ := hJ
  refine isIso_app_of_isColimit τ p.diag p.isColimit fun j => ?_
  obtain ⟨W, n, e, ⟨i⟩⟩ := p.prop_diag_obj j
  exact isIso_app_of_iso τ e.symm (isIso_app_shift τ (hτ i) n)

end DirectSums

/-! ### The dévissage -/

section Devissage

variable {D : Type u} [Category.{v} D] [Preadditive D] [HasZeroObject D] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D] [HasCoproducts.{v} D]
  {D' : Type u'} [Category.{v'} D'] [Preadditive D'] [HasZeroObject D'] [HasShift D' ℤ]
  [∀ n : ℤ, (shiftFunctor D' n).Additive] [Pretriangulated D']
  {F G : D ⥤ D'} [F.CommShift ℤ] [G.CommShift ℤ] [F.IsTriangulated] [G.IsTriangulated]
  [∀ J : Type v, PreservesColimitsOfShape (Discrete J) F]
  [∀ J : Type v, PreservesColimitsOfShape (Discrete J) G]
  (τ : F ⟶ G) [NatTrans.CommShift τ ℤ]

/-- **The dévissage.** Let `D` be a pre-triangulated category with direct sums generated by a
family `E` of compact objects, and let `F, G : D ⥤ D'` be exact functors preserving those direct
sums. A morphism `τ : F ⟶ G` compatible with the shift which is invertible at each `E i` is
invertible at every object of `D`.

Every object `X` of `D` has a cell presentation `X = hocolim Xₙ` whose base and whose attached
cells are direct sums of shifts of the `E i` ([stacks 09SN]); `τ` is invertible on all of those by
the direct-sum and shift steps, hence on each `Xₙ` by the extension step, hence on `∐ Xₙ` and so on
`X` itself. -/
theorem isIso_app_of_isCompactlyGenerated {ι : Type v} (E : ι → D)
    (hEc : ∀ i, IsCompactObject.{v} (E i))
    (hE : ∀ Y : D, ((ofObj E).shiftClosure ℤ).rightOrthogonal Y → IsZero Y)
    (hτ : ∀ i, IsIso (τ.app (E i))) (X : D) : IsIso (τ.app X) := by
  have := hEc
  obtain ⟨W, hcolim, h₀, hstep⟩ :=
    Pretriangulated.exists_isHomotopyColimit_of_compactlyGenerated E hE X
  have hW : ∀ n : ℕ, IsIso (τ.app (W.obj n)) := by
    intro n
    induction n with
    | zero => exact isIso_app_of_colimitsOfShape_shiftClosure τ E hτ _ h₀
    | succ n ih =>
        obtain ⟨Y, hY, f, g, hT⟩ := hstep n
        exact isIso_app_obj₃ τ (Triangle.mk f (W.map (homOfLE (Nat.le_succ n))) g) hT
          (isIso_app_of_colimitsOfShape_shiftClosure τ E hτ _ hY) ih
  obtain ⟨p, q, hT⟩ := hcolim
  -- the direct sum in the defining triangle of the derived colimit is indexed by `ℕ`, which is
  -- `ULift.{v} ℕ` up to an equivalence of discrete categories
  have : PreservesColimitsOfShape (Discrete ℕ) F :=
    preservesColimitsOfShape_of_equiv
      (Discrete.equivalence (Equiv.ulift : ULift.{v} ℕ ≃ ℕ)) F
  have : PreservesColimitsOfShape (Discrete ℕ) G :=
    preservesColimitsOfShape_of_equiv
      (Discrete.equivalence (Equiv.ulift : ULift.{v} ℕ ≃ ℕ)) G
  have hsum : IsIso (τ.app (∐ W.obj)) :=
    isIso_app_of_isColimit τ (Discrete.functor W.obj) (colimit.isColimit _) fun j => hW j.as
  exact isIso_app_obj₃ τ _ hT hsum hsum

/-- The dévissage, read as the invertibility of `τ` in the functor category. -/
theorem isIso_of_isCompactlyGenerated {ι : Type v} (E : ι → D)
    (hEc : ∀ i, IsCompactObject.{v} (E i))
    (hE : ∀ Y : D, ((ofObj E).shiftClosure ℤ).rightOrthogonal Y → IsZero Y)
    (hτ : ∀ i, IsIso (τ.app (E i))) : IsIso τ := by
  have : ∀ X, IsIso (τ.app X) := isIso_app_of_isCompactlyGenerated τ E hEc hE hτ
  exact NatIso.isIso_of_isIso_app τ

/-- The dévissage, read as a natural isomorphism. -/
def natIsoOfIsCompactlyGenerated {ι : Type v} (E : ι → D)
    (hEc : ∀ i, IsCompactObject.{v} (E i))
    (hE : ∀ Y : D, ((ofObj E).shiftClosure ℤ).rightOrthogonal Y → IsZero Y)
    (hτ : ∀ i, IsIso (τ.app (E i))) : F ≅ G :=
  have := isIso_of_isCompactlyGenerated τ E hEc hE hτ
  asIso τ

end Devissage

/-! ### The case of the derived category of a ring -/

section DerivedModuleCat

variable {R : Type u} [CommRing R] [HasDerivedCategory.{u} (ModuleCat.{u} R)]
  {D' : Type u'} [Category.{v'} D'] [Preadditive D'] [HasZeroObject D'] [HasShift D' ℤ]
  [∀ n : ℤ, (shiftFunctor D' n).Additive] [Pretriangulated D']
  {F G : DerivedCategory (ModuleCat.{u} R) ⥤ D'}
  [F.CommShift ℤ] [G.CommShift ℤ] [F.IsTriangulated] [G.IsTriangulated]
  [∀ J : Type u, PreservesColimitsOfShape (Discrete J) F]
  [∀ J : Type u, PreservesColimitsOfShape (Discrete J) G]
  (τ : F ⟶ G) [NatTrans.CommShift τ ℤ]

/-- **Two exact direct-sum-preserving functors out of `D(R)` which agree on `R[0]` agree.** A
morphism `τ : F ⟶ G` of exact functors out of a chosen derived category of `R`-modules which
preserve direct sums, compatible with the shift, is an isomorphism as soon as it is invertible on
the regular module placed in degree zero.

The hypothesis `[HasDerivedCategory.{u} (ModuleCat.{u} R)]` is a *free* choice of model, and the
morphism universe `u` is forced rather than chosen: `R[0]` is compact at level `u`
(`StacksDraft.Perfect.isCompactObject_derived_single` applied to
`StacksDraft.Perfect.isCompactObject_regularModule`), while the cell presentation tests compactness
at the hom universe of the category. At `HasDerivedCategory.standard` the latter is `u + 1`, where
`CategoryTheory.IsCompactObject` is a strictly stronger condition, so the hypothesis could not be
met there. A model with morphisms in `Type u` exists, by
`StacksDraft.Perfect.AnyModel.nonempty_locallySmallDerivedCategory`. -/
theorem isIso_of_isIso_app_regularModule
    (hτ : IsIso (τ.app ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
      (ModuleCat.of R R)))) : IsIso τ := by
  have : HasExactLimitsOfShape (Discrete ℕ) (ModuleCat.{u} R) :=
    StacksDraft.Perfect.moduleCat_hasExactLimitsOfShape_discrete_nat.{u, u}
  have : IsCompactObject.{u} (ModuleCat.of R R) :=
    StacksDraft.Perfect.isCompactObject_regularModule
  have : HasCoproducts.{u} (DerivedCategory (ModuleCat.{u} R)) :=
    Stacks.SmallDerivedCategory.hasCoproducts_derivedCategory (ModuleCat.{u} R)
  have hgen := StacksDraft.Perfect.isWeakTriangulatedGenerator_regularModule (R := R)
  -- `ObjectProperty.singleton` is indexed by `Unit : Type 0`, while the dévissage needs its index
  -- type in the morphism universe; the two generating properties are compared by hand
  have hle : ∀ Z : DerivedCategory (ModuleCat.{u} R),
      ((ObjectProperty.singleton ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
          (ModuleCat.of R R))).shiftClosure ℤ) Z →
        ((ObjectProperty.ofObj (fun _ : PUnit.{u + 1} =>
          (DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
            (ModuleCat.of R R))).shiftClosure ℤ) Z := by
    intro Z hZ
    obtain ⟨W, n, e, ⟨_⟩⟩ := hZ
    exact ⟨_, n, e, ObjectProperty.ofObj_apply _ PUnit.unit⟩
  exact isIso_of_isCompactlyGenerated τ
    (fun _ : PUnit.{u + 1} => (DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
      (ModuleCat.of R R))
    (fun _ => StacksDraft.Perfect.isCompactObject_derived_single _ 0)
    (fun Y hY => hgen Y fun {_Z} f hZ => hY f (hle _ hZ)) fun _ => hτ

/-- The identification of the two functors supplied by `isIso_of_isIso_app_regularModule`. -/
def natIsoOfIsIsoAppRegularModule
    (hτ : IsIso (τ.app ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
      (ModuleCat.of R R)))) : F ≅ G :=
  have := isIso_of_isIso_app_regularModule τ hτ
  asIso τ

end DerivedModuleCat

end StacksDraft.CompactDevissage

end
