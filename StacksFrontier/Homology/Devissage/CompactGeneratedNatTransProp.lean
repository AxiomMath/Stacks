/-! ### The dévissage for a property of objects -/

section ClassDevissage

variable {D : Type u} [Category.{v} D] [Preadditive D] [HasZeroObject D] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D] [HasCoproducts.{v} D]

/-- **The dévissage for a property of objects.** Let `D` be a pre-triangulated category with
direct sums generated by a family `E` of compact objects. A property of objects closed under
isomorphisms, shifts, cones (the third vertex of a distinguished triangle whose first two
vertices have it) and direct sums, and satisfied by each `E i`, holds for every object.

This is the argument of `isIso_app_of_isCompactlyGenerated` for the property itself: the cell
presentation of [stacks 09SN] builds every object from direct sums of shifts of the `E i` by
cones and one derived colimit. -/
theorem prop_of_isCompactlyGenerated (P : ObjectProperty D) [P.IsClosedUnderIsomorphisms]
    (hshift : ∀ (X : D) (n : ℤ), P X → P (X⟦n⟧))
    (hcone : ∀ T ∈ distTriang D, P T.obj₁ → P T.obj₂ → P T.obj₃)
    (hsum : ∀ (J : Type v) (X : D), P.colimitsOfShape (Discrete J) X → P X)
    {ι : Type v} (E : ι → D) (hEc : ∀ i, IsCompactObject.{v} (E i))
    (hE : ∀ Y : D, ((ofObj E).shiftClosure ℤ).rightOrthogonal Y → IsZero Y)
    (hgen : ∀ i, P (E i)) (X : D) : P X := by
  have := hEc
  have hsc : (ofObj E).shiftClosure ℤ ≤ P := by
    rintro Y ⟨W, n, e, ⟨i⟩⟩
    exact P.prop_of_iso e.symm (hshift _ n (hgen i))
  have hcol : ∀ Y : D,
      (⨆ J : Type v, ((ofObj E).shiftClosure ℤ).colimitsOfShape (Discrete J)) Y → P Y := by
    intro Y hY
    rw [ObjectProperty.prop_iSup_iff] at hY
    obtain ⟨J, ⟨p⟩⟩ := hY
    exact hsum J Y ⟨p.ofLE hsc⟩
  obtain ⟨W, hcolim, h₀, hstep⟩ :=
    Pretriangulated.exists_isHomotopyColimit_of_compactlyGenerated E hE X
  have hW : ∀ n : ℕ, P (W.obj n) := by
    intro n
    induction n with
    | zero => exact hcol _ h₀
    | succ n ih =>
        obtain ⟨Y, hY, f, g, hT⟩ := hstep n
        exact hcone _ hT (hcol _ hY) ih
  obtain ⟨p, q, hT⟩ := hcolim
  have hsum' : P (∐ W.obj) := by
    have hc : P.ColimitOfShape (Discrete ℕ) (∐ W.obj) :=
      ObjectProperty.ColimitOfShape.colimit (Discrete.functor W.obj) fun j => hW j.as
    exact hsum (ULift.{v} ℕ) _
      ⟨hc.reindex (Discrete.equivalence (Equiv.ulift : ULift.{v} ℕ ≃ ℕ)).functor⟩
  exact hcone _ hT hsum' hsum'

end ClassDevissage

/-! ### The contravariant dévissage -/

section Contravariant

open CategoryTheory.Pretriangulated.Opposite

variable {D : Type u} [Category.{v} D] [Preadditive D] [HasZeroObject D] [HasShift D ℤ]
  [∀ n : ℤ, (shiftFunctor D n).Additive] [Pretriangulated D] [HasCoproducts.{v} D]
  {D' : Type u'} [Category.{v'} D'] [Preadditive D'] [HasZeroObject D'] [HasShift D' ℤ]
  [∀ n : ℤ, (shiftFunctor D' n).Additive] [Pretriangulated D']

/-- **The contravariant dévissage.** Let `D` be a pre-triangulated category with direct sums
generated by a family `E` of compact objects, and let `F, G : Dᵒᵖ ⥤ D'` be contravariant exact
functors carrying direct sums of `D` to products of `D'`, that is, `F.rightOp, G.rightOp :
D ⥤ D'ᵒᵖ` are exact and preserve direct sums. A morphism `τ : F ⟶ G` whose opposite is
compatible with the shifts and which is invertible at each `E i` is invertible at every object.

This is `isIso_app_of_isCompactlyGenerated` for `τ.rightOp : G.rightOp ⟶ F.rightOp`. -/
theorem isIso_app_op_of_isCompactlyGenerated {F G : Dᵒᵖ ⥤ D'}
    (hFs : F.rightOp.CommShift ℤ) (hGs : G.rightOp.CommShift ℤ)
    (hFt : letI := hFs; F.rightOp.IsTriangulated) (hGt : letI := hGs; G.rightOp.IsTriangulated)
    (hFc : ∀ J : Type v, PreservesColimitsOfShape (Discrete J) F.rightOp)
    (hGc : ∀ J : Type v, PreservesColimitsOfShape (Discrete J) G.rightOp)
    (τ : F ⟶ G) (hτs : letI := hFs; letI := hGs; NatTrans.CommShift (NatTrans.rightOp τ) ℤ)
    {ι : Type v} (E : ι → D) (hEc : ∀ i, IsCompactObject.{v} (E i))
    (hE : ∀ Y : D, ((ofObj E).shiftClosure ℤ).rightOrthogonal Y → IsZero Y)
    (hτ : ∀ i, IsIso (τ.app (Opposite.op (E i)))) (X : D) :
    IsIso (τ.app (Opposite.op X)) := by
  let := hFs
  let := hGs
  have := hFt
  have := hGt
  have := hFc
  have := hGc
  have := hτs
  exact (isIso_op_iff _).1 (isIso_app_of_isCompactlyGenerated (NatTrans.rightOp τ) E hEc hE
    (fun i => (isIso_op_iff _).2 (hτ i)) X)

end Contravariant

