@[expose] public section

/-!
# Local freeness of the terms of the eta complex

Let `A` be a commutative ring, let `f ∈ A` be a nonzerodivisor and let `M^•` be a bounded
complex of finite free `A`-modules, written in chosen bases as a `BoundedComplex A`. Write
`I_i(M^•, f)` (`idealI`) for the ideal generated by the `r_i × r_i` minors of the matrix of
`(f, d^i)`. This file proves that principality of `I_i(M^•, f)` makes the degree-`i` term
`(η_f M)^i` of the décalage finite locally free of rank `r_i`, exhibits it as a direct summand
of `f^i M^i × f^{i+1} M^{i+1}` via the graph map `(1, d^i)`, and shows that the décalage then
commutes with any base change preserving the nonzerodivisor.

## Main definitions

* `Stacks.Eta.LocallyFreeTerms.ambientBaseChangeMap`: the canonical `B`-linear comparison map
  `B ⊗_A (M^i)_f ⟶ (M^i ⊗_A B)_g` between the two ambient localizations, along which Tag 0F7X
  compares the two décalage terms.
* `Stacks.Eta.LocallyFreeTerms.etaTermBaseChangeMap`, and its reading as an isomorphism
  `Stacks.Eta.LocallyFreeTerms.etaTermBaseChangeEquiv`: the corestriction of that ambient
  comparison to the degree-`i` décalage terms.

The décalage terms themselves are `EtaPow.fetaTerm` and the power submodules are
`EtaPow.fpowSub`.

## Main results

* `EtaPow.LocallyFree.etaTerm_finite_projective_and_split_of_idealI_isPrincipal` (Tag 0F7W): if
  `I_i(M^•, f)` is principal then `(η_f M)^i` is finite and projective with
  `Module.rankAtStalk` constantly `r_i`, and the graph map `(1, d^i)` admits a linear
  retraction.
* `Stacks.Eta.LocallyFreeTerms.eta_baseChange_of_idealI_isPrincipal` (Tag 0F7X): under the same
  hypothesis the
  décalage commutes with base change along a ring map sending `f` to a nonzerodivisor.
* `Stacks.Eta.LocallyFreeTerms.etaTermBaseChangeEquiv` (Tag 0F7X, as an isomorphism): that
  base-change comparison is bijective in every degree, and
  `Stacks.Eta.LocallyFreeTerms.ambientBaseChangeMap_comp_fLoc` makes the degreewise
  isomorphisms compatible with the differentials.

## Implementation notes

Finite free modules are expressed in their chosen bases as function modules on finite types,
and the décalage terms live in the localization at the powers of `f`. Finite local freeness of
rank `r` is expressed by finiteness, projectivity and constant `Module.rankAtStalk` equal to
`r`; being a direct summand is expressed by a linear retraction of the graph map. The
base-change statement is an equality of submodules of the localization of the finite free
`B`-module, obtained after the canonical localization--base-change identification
`Stacks.Eta.BaseChange.psiEquiv` and the canonical `B ⊗[A] Aⁿ ≃ₗ[B] Bⁿ`.

## References

* [Stacks Project, Tag 0F7W](https://stacks.math.columbia.edu/tag/0F7W)
* [Stacks Project, Tag 0F7X](https://stacks.math.columbia.edu/tag/0F7X)
* [Berthelot--Ogus, Section 8][Berthelot-Ogus]
* [Bhatt--Morrow--Scholze, Section 6][BMS]
-/

/-! ## Finite local freeness of the eta terms (Tag 0F7W) -/

section FiniteLocalFreeness

noncomputable section

namespace EtaPow.LocallyFree


open EtaPow Matrix

private theorem maximalMinorIdeal_eq_span_rows
    {R ι : Type*} [CommRing R] {n : ℕ} (A : Matrix ι (Fin n) R) :
    minorIdealInjective A n = Ideal.span (Set.range fun r : Fin n → ι =>
      (A.submatrix r id).det) := by
  classical
  apply le_antisymm
  · apply Ideal.span_le.mpr
    rintro _ ⟨r, c, hr, hc, rfl⟩
    let e : Equiv.Perm (Fin n) := Equiv.ofBijective c
      ⟨hc, (Finite.injective_iff_surjective).mp hc⟩
    have he : A.submatrix r c = (A.submatrix r id).submatrix id e := rfl
    rw [he, Matrix.det_permute']
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨r, rfl⟩)
  · apply Ideal.span_le.mpr
    rintro _ ⟨r, rfl⟩
    by_cases hr : Function.Injective r
    · exact Ideal.subset_span ⟨r, id, hr, Function.injective_id, rfl⟩
    · have hzero : (A.submatrix r id).det = 0 := by
        obtain ⟨a, b, hab, he⟩ := Function.not_injective_iff.mp hr
        exact Matrix.det_zero_of_row_eq he (by ext j; exact congrArg (fun t => A t j) hab)
      change (A.submatrix r id).det ∈ _
      rw [hzero]
      exact Ideal.zero_mem _

private theorem mul_adjugate_submatrix_apply
    {R ι : Type*} [CommRing R] {n : ℕ} (A : Matrix ι (Fin n) R)
    (r : Fin n → ι) (i : ι) (j : Fin n) :
    (A * (A.submatrix r id).adjugate) i j =
      (A.submatrix (Function.update r j i) id).det := by
  classical
  let B := A.submatrix r id
  have hv : A i = ∑ k, A i k • (Pi.single k 1 : Fin n → R) := by
    ext t
    simp [Pi.single_apply]
  have hsum (s : Finset (Fin n)) :
      (B.updateRow j (∑ k ∈ s, A i k • (Pi.single k 1 : Fin n → R))).det =
        ∑ k ∈ s, A i k * (B.updateRow j (Pi.single k 1)).det := by
    induction s using Finset.induction with
    | empty =>
      simp only [Finset.sum_empty]
      exact Matrix.det_eq_zero_of_row_eq_zero j (by simp)
    | insert a s ha ih =>
      rw [Finset.sum_insert ha, Finset.sum_insert ha, Matrix.det_updateRow_add,
        Matrix.det_updateRow_smul, ih]
  have hup : A.submatrix (Function.update r j i) id = B.updateRow j (A i) := by
    ext a b
    by_cases h : a = j <;> simp [B, Matrix.updateRow, Function.update, h]
  rw [hup, hv, hsum, Matrix.mul_apply]
  apply Finset.sum_congr rfl
  intro k _
  rw [Matrix.adjugate_apply]

private theorem regular_smul_pi_injective
    {A ι : Type*} [CommRing A] (f : A) (hf : IsRegular f) :
    Function.Injective (fun x : ι → A => f • x) := by
  intro x y h
  ext j
  exact hf.left (congrFun h j)

private theorem exists_retraction_of_regular_smul
    {R ι : Type*} [CommRing R] (K : Submodule R (ι → R))
    (g : R) (hg : IsRegular g) (H : (ι → R) →ₗ[R] (ι → R))
    (hdiv : ∀ x j, H x j ∈ Ideal.span {g})
    (hmem : ∀ x, H x ∈ K)
    (hsat : ∀ x, g • x ∈ K → x ∈ K)
    (hfix : ∀ x ∈ K, H x = g • x) :
    ∃ p : (ι → R) →ₗ[R] K, p.comp K.subtype = LinearMap.id := by
  classical
  have hd (x : ι → R) (j : ι) : ∃ a : R, g * a = H x j := by
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton.mp (hdiv x j)
    exact ⟨a, ha.symm⟩
  let p (x : ι → R) : ι → R := fun j => (hd x j).choose
  have hp (x : ι → R) : g • p x = H x := by
    ext j
    exact (hd x j).choose_spec
  have hinj := regular_smul_pi_injective (ι := ι) g hg
  let P : (ι → R) →ₗ[R] (ι → R) :=
    { toFun := p
      map_add' := fun x y => hinj (by dsimp only; rw [smul_add, hp, hp, hp, map_add])
      map_smul' := fun a x => hinj (by dsimp only; rw [hp, smul_comm g, hp, map_smul]; rfl) }
  refine ⟨P.codRestrict K (fun x => hsat (p x) ((hp x).symm ▸ hmem x)), ?_⟩
  ext x j
  exact congrFun (hinj ((hp x).trans (hfix x x.property))) j

private theorem exists_retraction_of_maximalMinorIdeal_isPrincipal
    {R ι : Type*} [CommRing R] [Finite ι] {n : ℕ}
    (A : Matrix ι (Fin n) R) (K : Submodule R (ι → R))
    (f : R) (hf : IsRegular f)
    (hI : (minorIdealInjective A n).IsPrincipal)
    (hpow : f ^ n ∈ minorIdealInjective A n)
    (hAK : LinearMap.range A.mulVecLin ≤ K)
    (hKA : ∀ x ∈ K, f • x ∈ LinearMap.range A.mulVecLin)
    (hsat : ∀ g : R, IsRegular g → ∀ x, g • x ∈ K → x ∈ K) :
    ∃ p : (ι → R) →ₗ[R] K, p.comp K.subtype = LinearMap.id := by
  classical
  let := hI
  let := Fintype.ofFinite ι
  let g := Submodule.IsPrincipal.generator (minorIdealInjective A n)
  have hIg : minorIdealInjective A n = Ideal.span {g} :=
    (Ideal.span_singleton_generator _).symm
  have hg : IsRegular g := by
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton.mp (hIg ▸ hpow)
    exact IsRegular.of_mul_left (ha ▸ hf.pow n)
  let Δ (r : Fin n → ι) := (A.submatrix r id).det
  have hspan : Ideal.span (Set.range Δ) = Ideal.span {g} :=
    (maximalMinorIdeal_eq_span_rows A).symm.trans hIg
  have hgm : g ∈ Submodule.span R (Set.range Δ) := by
    change g ∈ Ideal.span (Set.range Δ)
    rw [hspan]
    exact Ideal.mem_span_singleton_self g
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp hgm
  let L (r : Fin n → ι) : (ι → R) →ₗ[R] (ι → R) :=
    (A * (A.submatrix r id).adjugate).mulVecLin.comp
      (LinearMap.pi fun j => LinearMap.proj (r j))
  have hL (r : Fin n → ι) (x : Fin n → R) :
      L r (A.mulVecLin x) = Δ r • A.mulVecLin x := by
    change (A * (A.submatrix r id).adjugate) *ᵥ ((A *ᵥ x) ∘ r) = _
    have heq : (A *ᵥ x) ∘ r = (A.submatrix r id) *ᵥ x := by ext j; rfl
    rw [heq, Matrix.mulVec_mulVec, Matrix.mul_assoc, Matrix.adjugate_mul,
      Matrix.mul_smul, Matrix.mul_one, Matrix.smul_mulVec]
    rfl
  let H : (ι → R) →ₗ[R] (ι → R) := ∑ r, c r • L r
  apply exists_retraction_of_regular_smul K g hg H
  · intro x j
    change (∑ r, c r • L r) x j ∈ _
    simp only [LinearMap.sum_apply, Finset.sum_apply, LinearMap.smul_apply,
      Pi.smul_apply]
    apply Ideal.sum_mem
    intro r _
    apply Submodule.smul_mem
    change ∑ k, (A * (A.submatrix r id).adjugate) j k * x (r k) ∈ _
    apply Ideal.sum_mem
    intro k _
    apply Ideal.mul_mem_right
    rw [mul_adjugate_submatrix_apply]
    rw [← hspan]
    exact Ideal.subset_span ⟨Function.update r k j, rfl⟩
  · intro x
    change (∑ r, c r • L r) x ∈ K
    simp only [LinearMap.sum_apply, LinearMap.smul_apply]
    apply Submodule.sum_mem
    intro r _
    apply Submodule.smul_mem
    apply hAK
    refine ⟨(A.submatrix r id).adjugate *ᵥ (x ∘ r), ?_⟩
    change A *ᵥ ((A.submatrix r id).adjugate *ᵥ (x ∘ r)) = _
    exact Matrix.mulVec_mulVec _ _ _
  · exact hsat g hg
  · intro x hx
    obtain ⟨y, hy⟩ := hKA x hx
    have hHx : H (f • x) = g • (f • x) := by
      rw [← hy]
      change (∑ r, c r • L r) (A.mulVecLin y) = _
      simp only [LinearMap.sum_apply, LinearMap.smul_apply, hL, ← mul_smul]
      rw [← Finset.sum_smul]
      have hc' : ∑ r, c r * Δ r = g := hc
      rw [hc']
    ext j
    apply hf.left
    have hh := congrFun hHx j
    simpa only [map_smul, Pi.smul_apply, smul_eq_mul, mul_left_comm g f] using hh

private noncomputable def boundary {A U V : Type*} [CommRing A]
    [AddCommGroup U] [Module A U] [AddCommGroup V] [Module A V]
    (f : A) (d : U →ₗ[A] V) (i : ℤ) :
    fpowSub f U i × fpowSub f V (i + 1) →ₗ[A] Loc f V where
  toFun p := fLoc f d p.1 - p.2
  map_add' p q := by
    simp
    abel
  map_smul' a p := by simp [smul_sub]

private noncomputable def etaKerEquiv {A U V : Type*} [CommRing A]
    [AddCommGroup U] [Module A U] [AddCommGroup V] [Module A V]
    (f : A) (d : U →ₗ[A] V) (i : ℤ) :
    fetaTerm f d i ≃ₗ[A] LinearMap.ker (boundary f d i) := by
  let e : fetaTerm f d i →ₗ[A] fpowSub f U i × fpowSub f V (i + 1) :=
    LinearMap.prod
      (LinearMap.codRestrict (fpowSub f U i) (fetaTerm f d i).subtype
        (fun x => x.2.1))
      (LinearMap.codRestrict (fpowSub f V (i + 1))
        ((fLoc f d).comp (fetaTerm f d i).subtype) (fun x => x.2.2))
  have he : ∀ x, e x ∈ LinearMap.ker (boundary f d i) := by
    intro x
    change fLoc f d x.1 - fLoc f d x.1 = 0
    exact sub_self _
  let e' := LinearMap.codRestrict (LinearMap.ker (boundary f d i)) e he
  have hinj : Function.Injective e' := fun x y h => Subtype.ext <|
    congrArg (fun z : LinearMap.ker (boundary f d i) =>
      ((z : fpowSub f U i × fpowSub f V (i + 1)).1 : Loc f U)) h
  have hsurj : Function.Surjective e' := by
    intro p
    let x : fetaTerm f d i :=
      ⟨(p.1.1 : Loc f U), p.1.1.2, by
        have hp : fLoc f d (p.1.1 : Loc f U) - (p.1.2 : Loc f V) = 0 := p.2
        change fLoc f d (p.1.1 : Loc f U) ∈ fpowSub f V (i + 1)
        rw [sub_eq_zero.mp hp]
        exact p.1.2.2⟩
    refine ⟨x, ?_⟩
    apply Subtype.ext
    apply Prod.ext
    · exact Subtype.ext rfl
    · apply Subtype.ext
      have hp : fLoc f d (p.1.1 : Loc f U) - (p.1.2 : Loc f V) = 0 := p.2
      exact sub_eq_zero.mp hp
  exact LinearEquiv.ofBijective e' ⟨hinj, hsurj⟩

private theorem finite_projective_of_retraction
    {A E W : Type*} [CommRing A]
    [AddCommGroup E] [Module A E] [AddCommGroup W] [Module A W]
    [Module.Finite A W] [Module.Projective A W]
    (inclusion : E →ₗ[A] W) (retraction : W →ₗ[A] E)
    (h : retraction.comp inclusion = LinearMap.id) :
    ∃ hfin : Module.Finite A E,
      letI := hfin
      Module.Projective A E := by
  have hr : Function.Surjective retraction := fun x =>
    ⟨inclusion x, by simpa using LinearMap.congr_fun h x⟩
  exact ⟨.of_surjective retraction hr, Module.Projective.of_split inclusion retraction h⟩

private noncomputable def fpowSubEquiv
    {A M : Type*} [CommRing A] [AddCommGroup M] [Module A M]
    (f : A) (i : ℤ) (hinj : Function.Injective (toLoc f M)) :
    M ≃ₗ[A] fpowSub f M i := by
  let e : M →ₗ[A] fpowSub f M i :=
    LinearMap.codRestrict (fpowSub f M i) (fpowMap f M i) (by
      intro x
      rw [fpowSub_eq_range]
      exact ⟨x, rfl⟩)
  have heinj : Function.Injective e := fun x y hxy =>
    hinj (fUnit_zpow_smul_injective i (congrArg Subtype.val hxy))
  have hesurj : Function.Surjective e := fun x =>
    (mem_fpowSub.mp x.2).imp fun _ hm => Subtype.ext hm
  exact LinearEquiv.ofBijective e ⟨heinj, hesurj⟩


private theorem fpowMap_injective
    {A M : Type*} [CommRing A] [AddCommGroup M] [Module A M]
    (f : A) (i : ℤ) (hinj : Function.Injective (toLoc f M)) :
    Function.Injective (fpowMap f M i) :=
  fun _ _ h => hinj (fUnit_zpow_smul_injective i h)

private theorem fpowMap_add_one
    {A M : Type*} [CommRing A] [AddCommGroup M] [Module A M]
    (f : A) (i : ℤ) (x : M) :
    fpowMap f M (i + 1) x = fpowMap f M i (f • x) := by
  simp only [fpowMap_apply, ← fUnit_zpow_smul_smul,
    fUnit_zpow_one_smul_toLoc]

private theorem mapMatrix_mulVecLin
    {A : Type*} [CommRing A] {m n : ℕ} (f : A)
    (d : Matrix (Fin n) (Fin m) A) (x : Fin m → A) :
    (mapMatrix f d).mulVecLin x = Sum.elim (f • x) (d.mulVecLin x) := by
  classical
  ext j
  cases j with
  | inl j =>
    change ((f • (1 : Matrix (Fin m) (Fin m) A)) *ᵥ x) j = _
    rw [Matrix.smul_mulVec, Matrix.one_mulVec]
    rfl
  | inr j => rfl

private theorem pow_mem_maximalMinorIdeal_mapMatrix
    {A : Type*} [CommRing A] {m n : ℕ} (f : A)
    (d : Matrix (Fin n) (Fin m) A) :
    f ^ m ∈ minorIdealInjective (mapMatrix f d) m := by
  classical
  apply Ideal.subset_span
  refine ⟨Sum.inl, id, Sum.inl_injective, Function.injective_id, ?_⟩
  change f ^ m = (f • (1 : Matrix (Fin m) (Fin m) A)).det
  simp

private theorem etaTerm_retraction_of_minorIdeal_isPrincipal
    {A : Type*} [CommRing A] (f : A) (hf : IsRegular f)
    {m n : ℕ} (D : Matrix (Fin n) (Fin m) A) (i : ℤ)
    (hI : (minorIdealInjective (mapMatrix f D) m).IsPrincipal) :
    let d := D.mulVecLin
    let E := fetaTerm f d i
    let P := fpowSub f (Fin m → A) i
    let Q := fpowSub f (Fin n → A) (i + 1)
    let inclusion : E →ₗ[A] P × Q := LinearMap.prod
      (LinearMap.codRestrict P E.subtype (fun x => x.2.1))
      (LinearMap.codRestrict Q ((fLoc f d).comp E.subtype) (fun x => x.2.2))
    ∃ retraction : P × Q →ₗ[A] E,
      retraction.comp inclusion = LinearMap.id := by
  classical
  let U := Fin m → A
  let V := Fin n → A
  let W := (Fin m ⊕ Fin n) → A
  let d := D.mulVecLin
  let P := fpowSub f U i
  let Q := fpowSub f V (i + 1)
  let E := fetaTerm f d i
  have hU : Function.Injective (toLoc f U) := toLoc_injective_of_isSMulRegular hf.isSMulRegular
  have hV : Function.Injective (toLoc f V) := toLoc_injective_of_isSMulRegular hf.isSMulRegular
  let eP := fpowSubEquiv f i hU
  let eQ := fpowSubEquiv f (i + 1) hV
  let eW : W ≃ₗ[A] P × Q :=
    (LinearEquiv.sumArrowLequivProdArrow _ _ A A).trans (eP.prodCongr eQ)
  let B := boundary f d i
  let K := (LinearMap.ker B).comap eW.toLinearMap
  have hB (w : W) : B (eW w) =
      fpowMap f V i (d (w ∘ Sum.inl) - f • (w ∘ Sum.inr)) := by
    change fLoc f d (fpowMap f U i (w ∘ Sum.inl)) -
      fpowMap f V (i + 1) (w ∘ Sum.inr) = _
    rw [fpowMap_add_one, map_sub]
    congr 1
    exact (fLoc_zpow_smul d i _).trans (congrArg _ (fLoc_toLoc d _))
  have hK (w : W) : w ∈ K ↔ d (w ∘ Sum.inl) = f • (w ∘ Sum.inr) := by
    change B (eW w) = 0 ↔ _
    rw [hB, (fpowMap_injective f i hV).eq_iff' (map_zero _), sub_eq_zero]
  obtain ⟨r, hr⟩ := exists_retraction_of_maximalMinorIdeal_isPrincipal
    (mapMatrix f D) K f hf hI (pow_mem_maximalMinorIdeal_mapMatrix f D)
    (by
      rintro _ ⟨x, rfl⟩
      rw [hK, mapMatrix_mulVecLin]
      change d (f • x) = f • d x
      exact map_smul d f x)
    (by
      intro w hw
      refine ⟨w ∘ Sum.inl, ?_⟩
      rw [mapMatrix_mulVecLin]
      ext j
      cases j with
      | inl j => rfl
      | inr j => exact congrFun ((hK w).mp hw) j)
    (by
      intro g hg w hw
      rw [hK] at hw ⊢
      have hh : g • d (w ∘ Sum.inl) = g • (f • (w ∘ Sum.inr)) := by
        change d (g • (w ∘ Sum.inl)) = f • (g • (w ∘ Sum.inr)) at hw
        simpa only [map_smul, smul_comm f g] using hw
      exact regular_smul_pi_injective g hg hh)
  let eK : K ≃ₗ[A] LinearMap.ker B := eW.ofSubmodule' _
  let eE : E ≃ₗ[A] K := (etaKerEquiv f d i).trans eK.symm
  let p : P × Q →ₗ[A] E := eE.symm.toLinearMap.comp (r.comp eW.symm.toLinearMap)
  refine ⟨p, ?_⟩
  apply LinearMap.ext
  intro x
  change eE.symm (r (eW.symm _)) = x
  have he : eW.symm
      (LinearMap.prod
        (LinearMap.codRestrict P E.subtype (fun x => x.2.1))
        (LinearMap.codRestrict Q ((fLoc f d).comp E.subtype) (fun x => x.2.2)) x) =
      (eE x : W) := rfl
  have hx : r (eE x) = eE x := LinearMap.congr_fun hr (eE x)
  rw [he, hx]
  exact eE.symm_apply_apply x

private theorem rankAtStalk_le_of_injective
    {A M N : Type*} [CommRing A] [AddCommGroup M] [Module A M]
    [AddCommGroup N] [Module A N] [Module.Finite A N]
    (l : M →ₗ[A] N) (hl : Function.Injective l) (p : PrimeSpectrum A) :
    Module.rankAtStalk (R := A) M p ≤ Module.rankAtStalk (R := A) N p :=
  LinearMap.finrank_le_finrank_of_injective
    (LocalizedModule.map_injective p.asIdeal.primeCompl l hl)


/-- **Stacks 0F7W.** Let `f` be a nonzerodivisor and let `C` be a bounded complex of finite
free modules. If the ideal generated by the maximal minors of `(f, dⁱ)` is principal, then the
degree-`i` eta term is finite locally free of rank `rank C i`. Its natural map `x ↦ (x, dⁱx)`
into `fⁱ Cⁱ × fⁱ⁺¹ Cⁱ⁺¹` admits a linear retraction, and hence includes it as a direct
summand. -/
@[stacks 0F7W]
public theorem etaTerm_finite_projective_and_split_of_idealI_isPrincipal
    {A : Type*} [CommRing A] (C : BoundedComplex A) (f : A) (hf : IsRegular f) (i : ℤ)
    (hI : (idealI C f i).IsPrincipal) :
    let d := (C.d i).mulVecLin
    let E := fetaTerm f d i
    let P := fpowSub f (Fin (C.rank i) → A) i
    let Q := fpowSub f (Fin (C.rank (i + 1)) → A) (i + 1)
    let inclusion : E →ₗ[A] P × Q := LinearMap.prod
      (LinearMap.codRestrict P E.subtype (fun x => x.2.1))
      (LinearMap.codRestrict Q ((fLoc f d).comp E.subtype) (fun x => x.2.2))
    (∃ hfin : Module.Finite A E,
      letI := hfin
      ∃ hproj : Module.Projective A E,
        letI := hproj
        Module.rankAtStalk (R := A) E = fun _ => C.rank i) ∧
      ∃ retraction : P × Q →ₗ[A] E,
        retraction.comp inclusion = LinearMap.id := by
  let U := Fin (C.rank i) → A
  let V := Fin (C.rank (i + 1)) → A
  let d := (C.d i).mulVecLin
  let E := fetaTerm f d i
  let P := fpowSub f U i
  let Q := fpowSub f V (i + 1)
  let inclusion : E →ₗ[A] P × Q := LinearMap.prod
    (LinearMap.codRestrict P E.subtype (fun x => x.2.1))
    (LinearMap.codRestrict Q ((fLoc f d).comp E.subtype) (fun x => x.2.2))
  have hU : Function.Injective (toLoc f U) := toLoc_injective_of_isSMulRegular hf.isSMulRegular
  have hV : Function.Injective (toLoc f V) := toLoc_injective_of_isSMulRegular hf.isSMulRegular
  let eP := fpowSubEquiv f i hU
  let eQ := fpowSubEquiv f (i + 1) hV
  have : Module.Finite A P := Module.Finite.equiv eP
  have : Module.Finite A Q := Module.Finite.equiv eQ
  have : Module.Projective A P := Module.Projective.of_equiv' eP
  have : Module.Projective A Q := Module.Projective.of_equiv' eQ
  obtain ⟨r, hr⟩ := etaTerm_retraction_of_minorIdeal_isPrincipal f hf (C.d i) i hI
  obtain ⟨hfin, hproj⟩ := finite_projective_of_retraction inclusion r hr
  let : Module.Finite A E := hfin
  let : Module.Projective A E := hproj
  refine ⟨⟨hfin, hproj, ?_⟩, r, hr⟩
  have hP : Module.rankAtStalk (R := A) P = Module.rankAtStalk (R := A) U :=
    (Module.rankAtStalk_eq_of_equiv eP).symm
  let upper : E →ₗ[A] P := LinearMap.codRestrict P E.subtype (fun x => x.2.1)
  have hu : Function.Injective upper := fun x y h =>
    Subtype.ext (congrArg (fun z : P => (z : Loc f U)) h)
  have hmem (x : U) : fpowMap f U (i + 1) x ∈ E := by
    constructor
    · change fpowMap f U (i + 1) x ∈ fpowSub f U i
      rw [fpowMap_add_one, fpowSub_eq_range]
      exact ⟨f • x, rfl⟩
    · change fLoc f d (fpowMap f U (i + 1) x) ∈ fpowSub f V (i + 1)
      rw [fpowMap_apply, fLoc_zpow_smul, fLoc_toLoc]
      exact mem_fpowSub.mpr ⟨d x, rfl⟩
  let lower : U →ₗ[A] E := LinearMap.codRestrict E (fpowMap f U (i + 1)) hmem
  have hl : Function.Injective lower := fun x y h =>
    fpowMap_injective f (i + 1) hU (congrArg Subtype.val h)
  funext p
  have : Nontrivial A := p.nontrivial
  have hUrank : Module.rankAtStalk (R := A) U p = C.rank i := by
    rw [Module.rankAtStalk_eq_finrank_of_free]
    exact Module.finrank_fin_fun A
  apply Nat.le_antisymm
  · simpa only [hP, hUrank] using rankAtStalk_le_of_injective upper hu p
  · simpa only [hUrank] using rankAtStalk_le_of_injective lower hl p


end EtaPow.LocallyFree

end

end FiniteLocalFreeness

/-! ## The eta terms under base change (Tag 0F7X) -/

section EtaTermBaseChange

noncomputable section

open scoped TensorProduct

namespace Stacks.Eta.LocallyFreeTerms

open EtaPow

private lemma baseChange_ker_of_split
    {A B X Y : Type*} [CommRing A] [CommRing B] [Algebra A B]
    [AddCommGroup X] [Module A X] [AddCommGroup Y] [Module A Y]
    (f : A) (h : X →ₗ[A] Y) (v : Y →ₗ[A] X)
    (hv : h.comp v = f • LinearMap.id)
    (r : X →ₗ[A] LinearMap.ker h) (hr : r.comp (LinearMap.ker h).subtype = LinearMap.id)
    (hg : IsSMulRegular (B ⊗[A] X) (algebraMap A B f)) :
    Submodule.baseChange B (LinearMap.ker h) = LinearMap.ker (h.baseChange B) := by
  let j := (LinearMap.ker h).subtype
  let t : X →ₗ[A] LinearMap.ker h := (f • LinearMap.id - v.comp h).codRestrict
    (LinearMap.ker h) (by
      intro x
      change h (f • x - v (h x)) = 0
      rw [map_sub, map_smul, show h (v (h x)) = f • h x from LinearMap.congr_fun hv (h x)]
      exact sub_self _)
  have ht : j.comp t = f • LinearMap.id - v.comp h := rfl
  have hsplit : (r.baseChange B).comp (j.baseChange B) = LinearMap.id := by
    rw [← LinearMap.baseChange_comp, hr, LinearMap.baseChange_id]
  have hzero : (h.baseChange B).comp (j.baseChange B) = 0 := by
    rw [← LinearMap.baseChange_comp]
    have hj : h.comp j = 0 := by ext x; exact x.2
    rw [hj, LinearMap.baseChange_zero]
  change LinearMap.range (j.baseChange B) = _
  apply le_antisymm
  · rintro _ ⟨x, rfl⟩
    exact LinearMap.congr_fun hzero x
  · intro x hx
    have hx0 : h.baseChange B x = 0 := hx
    have htB : (j.baseChange B) ((t.baseChange B) x) = (algebraMap A B f) • x := by
      have he := congrArg (LinearMap.baseChange B) ht
      simp only [LinearMap.baseChange_comp, LinearMap.baseChange_sub,
        LinearMap.baseChange_smul, LinearMap.baseChange_id] at he
      have he' := LinearMap.congr_fun he x
      simpa [hx0, algebraMap_smul] using he'
    refine ⟨(r.baseChange B) x, hg ?_⟩
    change (algebraMap A B f) • _ = (algebraMap A B f) • x
    rw [← map_smul, ← map_smul, ← htB]
    have he := LinearMap.congr_fun hsplit ((t.baseChange B) x)
    change (r.baseChange B) ((j.baseChange B) ((t.baseChange B) x)) = _ at he
    rw [he]
    rfl

private lemma graph_ker_split
    {A M N : Type*} [CommRing A] [AddCommGroup M] [Module A M]
    [AddCommGroup N] [Module A N] (f : A) (hM : IsSMulRegular M f)
    (hN : IsSMulRegular N f) (d : M →ₗ[A] N) (i : ℤ)
    (r : fpowSub f M i × fpowSub f N (i + 1) →ₗ[A] fetaTerm f d i)
    (hr : r.comp (LinearMap.prod
      (LinearMap.codRestrict (fpowSub f M i) (fetaTerm f d i).subtype (fun x => x.2.1))
      (LinearMap.codRestrict (fpowSub f N (i + 1))
        ((fLoc f d).comp (fetaTerm f d i).subtype) (fun x => x.2.2))) = LinearMap.id) :
    ∃ s : M × N →ₗ[A] LinearMap.ker (graphMap f d),
      s.comp (LinearMap.ker (graphMap f d)).subtype = LinearMap.id := by
  let e := LinearEquiv.ofBijective (graphToEta f d i)
    ⟨graphToEta_injective f hM hN d i, graphToEta_surjective f hN d i⟩
  let p := (fpowEquiv f hM i).prodCongr (fpowEquiv f hN (i + 1))
  refine ⟨e.symm.toLinearMap.comp (r.comp p.toLinearMap), ?_⟩
  refine LinearMap.ext fun x => e.injective ?_
  change e (e.symm (r (p x.1))) = e x
  rw [e.apply_symm_apply]
  have he : p x.1 =
      (⟨(e x : Loc f M), (e x).2.1⟩,
       ⟨fLoc f d (e x : Loc f M), (e x).2.2⟩) := by
    apply Prod.ext
    · exact Subtype.ext rfl
    · apply Subtype.ext
      change fpowMap f N (i + 1) x.1.2 = fLoc f d (fpowMap f M i x.1.1)
      rw [fpowMap_succ]
      have hx : d x.1.1 = f • x.1.2 := sub_eq_zero.mp x.2
      simp only [fpowMap_apply, fLoc_zpow_smul, fLoc_toLoc, hx]
  rw [he]
  exact LinearMap.congr_fun hr (e x)

private lemma baseChange_map
    {A B X Y : Type*} [CommRing A] [CommRing B] [Algebra A B]
    [AddCommGroup X] [Module A X] [AddCommGroup Y] [Module A Y]
    (p : Submodule A X) (l : X →ₗ[A] Y) :
    Submodule.baseChange B (p.map l) = (p.baseChange B).map (l.baseChange B) := by
  let t : p →ₗ[A] p.map l := (l.comp p.subtype).codRestrict _
    (fun x => Submodule.mem_map_of_mem x.2)
  have ht : Function.Surjective t := by
    rintro ⟨y, x, hx, hxy⟩
    exact ⟨⟨x, hx⟩, Subtype.ext hxy⟩
  have he : (p.map l).subtype.comp t = l.comp p.subtype := rfl
  unfold Submodule.baseChange
  rw [← LinearMap.range_comp, ← LinearMap.baseChange_comp, ← he, LinearMap.baseChange_comp]
  exact (LinearMap.range_comp_of_range_eq_top _
    (LinearMap.range_eq_top.mpr (LinearMap.baseChange_surjective B ht))).symm

private lemma fetaTerm_eq_map_graph
    {A M N : Type*} [CommRing A] [AddCommGroup M] [Module A M]
    [AddCommGroup N] [Module A N] (f : A) (hN : IsSMulRegular N f)
    (d : M →ₗ[A] N) (i : ℤ) :
    fetaTerm f d i = (LinearMap.ker (graphMap f d)).map
      ((fpowMap f M i).comp (LinearMap.fst A M N)) := by
  ext x
  constructor
  · intro hx
    obtain ⟨y, hy⟩ := graphToEta_surjective f hN d i ⟨x, hx⟩
    exact ⟨y.1, y.2, congrArg Subtype.val hy⟩
  · rintro ⟨y, hy, rfl⟩
    exact (graphToEta f d i ⟨y, hy⟩).2

private lemma ambientMap_fpowMap
    {A B M P : Type*} [CommRing A] [CommRing B] [Algebra A B]
    [AddCommGroup M] [Module A M] [AddCommGroup P] [Module A P] [Module B P]
    [IsScalarTower A B P] (f : A) (i : ℤ) (e : B ⊗[A] M →ₗ[B] P) :
    (((LocalizedModule.map (Submonoid.powers (algebraMap A B f)) e).restrictScalars B).comp
      (Stacks.Eta.BaseChange.psiEquiv f M).toLinearMap).comp ((fpowMap f M i).baseChange B) =
        (fpowMap (algebraMap A B f) P i).comp e := by
  apply TensorProduct.AlgebraTensorModule.ext
  intro b m
  have ht : b ⊗ₜ[A] fpowMap f M i m = b • ((1 : B) ⊗ₜ[A] fpowMap f M i m) := by
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  simp only [LinearMap.comp_apply, LinearMap.baseChange_tmul, LinearEquiv.coe_coe]
  rw [ht, map_smul, ← Stacks.Eta.BaseChange.etaBCPsi_eq_psiEquiv,
    Stacks.Eta.BaseChange.etaBCPsi_fpowMap, map_smul]
  change b • fLoc (algebraMap A B f) e
    (fpowMap (algebraMap A B f) (B ⊗[A] M) i ((1 : B) ⊗ₜ[A] m)) = _
  rw [fpowMap_apply, fLoc_zpow_smul, fLoc_toLoc]
  change b • fpowMap (algebraMap A B f) P i (e ((1 : B) ⊗ₜ[A] m)) = _
  rw [← map_smul, ← map_smul, TensorProduct.smul_tmul', smul_eq_mul, mul_one]

/-- A split injection stays injective after base change. -/
private lemma injective_baseChange_subtype_of_split
    {A X Y : Type*} (B : Type*) [CommRing A] [CommRing B] [Algebra A B]
    [AddCommGroup X] [Module A X] [AddCommGroup Y] [Module A Y]
    (j : X →ₗ[A] Y) (s : Y →ₗ[A] X) (hs : s.comp j = LinearMap.id) :
    Function.Injective (j.baseChange B) := by
  have h : (s.baseChange B).comp (j.baseChange B) = LinearMap.id := by
    rw [← LinearMap.baseChange_comp, hs, LinearMap.baseChange_id]
  exact Function.LeftInverse.injective (LinearMap.congr_fun h)

/-- Base change of a product is detected by the base changes of the two projections. -/
private lemma bijective_prod_baseChange_fst_snd
    {A M N : Type*} (B : Type*) [CommRing A] [CommRing B] [Algebra A B]
    [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N] :
    Function.Bijective (LinearMap.prod (LinearMap.baseChange B (LinearMap.fst A M N))
      (LinearMap.baseChange B (LinearMap.snd A M N))) := by
  have hpr : (TensorProduct.prodRight A B B M N).toLinearMap =
      LinearMap.prod (LinearMap.baseChange B (LinearMap.fst A M N))
        (LinearMap.baseChange B (LinearMap.snd A M N)) :=
    TensorProduct.AlgebraTensorModule.ext fun _ _ => rfl
  rw [← hpr]
  exact (TensorProduct.prodRight A B B M N).bijective

/-- The graph map `(m, n) ↦ d m - f n` after base change. -/
private lemma baseChange_graphMap_apply
    {A M N : Type*} (B : Type*) [CommRing A] [CommRing B] [Algebra A B]
    [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (f : A) (d : M →ₗ[A] N) (z : B ⊗[A] (M × N)) :
    LinearMap.baseChange B (graphMap f d) z =
      LinearMap.baseChange B d (LinearMap.baseChange B (LinearMap.fst A M N) z) -
        f • LinearMap.baseChange B (LinearMap.snd A M N) z := by
  simp only [graphMap, LinearMap.baseChange_sub, LinearMap.baseChange_comp,
    LinearMap.baseChange_smul, LinearMap.sub_apply, LinearMap.comp_apply,
    LinearMap.smul_apply]

/-- Minus the inclusion of the second factor is a section of the graph map up to `f`. -/
private lemma graphMap_comp_neg_inr
    {A M N : Type*} [CommRing A] [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (f : A) (d : M →ₗ[A] N) :
    (graphMap f d).comp (-(LinearMap.inr A M N)) = f • LinearMap.id := by
  refine LinearMap.ext fun y => ?_
  simp only [graphMap, LinearMap.comp_apply, LinearMap.neg_apply, LinearMap.inr_apply, map_neg,
    LinearMap.sub_apply, LinearMap.smul_apply, LinearMap.id_apply, LinearMap.fst_apply,
    LinearMap.snd_apply, map_zero, zero_sub]
  exact neg_neg _

/-- **Stacks 0F7X.** Let `A → B` be a ring map, let `f` be a nonzerodivisor of `A` whose image
is a nonzerodivisor of `B`, and let `C` be a bounded complex of finite free `A`-modules. If
every determinantal ideal `Iᵢ(C, f)` is principal, then base change of the eta construction
agrees in every degree with the eta construction of the base-changed complex. The equality
takes place inside the localization of the finite free `B`-module after applying the canonical
localization--base-change and finite-free base-change identifications. -/
@[stacks 0F7X]
public theorem eta_baseChange_of_idealI_isPrincipal
    {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    (C : BoundedComplex A) (f : A) (hf : IsRegular f)
    (hg : IsRegular (algebraMap A B f))
    (hI : ∀ i : ℤ, (idealI C f i).IsPrincipal) :
    ∀ i : ℤ,
      let freeBaseChange := TensorProduct.piScalarRight A B B (Fin (C.rank i))
      let ambientMap :=
        ((LocalizedModule.map (Submonoid.powers (algebraMap A B f))
            freeBaseChange.toLinearMap).restrictScalars B).comp
          (Stacks.Eta.BaseChange.psiEquiv f (Fin (C.rank i) → A)).toLinearMap
      Submodule.map ambientMap
          (Submodule.baseChange B (fetaTerm f (C.d i).mulVecLin i)) =
        fetaTerm (algebraMap A B f)
          ((C.baseChange (algebraMap A B)).d i).mulVecLin i := by
  intro i
  let M := Fin (C.rank i) → A
  let N := Fin (C.rank (i + 1)) → A
  let P := Fin (C.rank i) → B
  let Q := Fin (C.rank (i + 1)) → B
  let d : M →ₗ[A] N := (C.d i).mulVecLin
  let g := algebraMap A B f
  let dB : P →ₗ[B] Q := ((C.baseChange (algebraMap A B)).d i).mulVecLin
  let eM : B ⊗[A] M ≃ₗ[B] P := TensorProduct.piScalarRight A B B (Fin (C.rank i))
  let eN : B ⊗[A] N ≃ₗ[B] Q := TensorProduct.piScalarRight A B B (Fin (C.rank (i + 1)))
  let e : B ⊗[A] (M × N) ≃ₗ[B] P × Q :=
    (TensorProduct.prodRight A B B M N).trans (eM.prodCongr eN)
  let L : B ⊗[A] Loc f M →ₗ[B] Loc g P :=
    ((LocalizedModule.map (Submonoid.powers g) eM.toLinearMap).restrictScalars B).comp
      (Stacks.Eta.BaseChange.psiEquiv f M).toLinearMap
  change (Submodule.baseChange B (fetaTerm f d i)).map L = fetaTerm g dB i
  have hM : IsSMulRegular M f := hf.isSMulRegular
  have hN : IsSMulRegular N f := hf.isSMulRegular
  have hQ : IsSMulRegular Q g := hg.isSMulRegular
  obtain ⟨r, hr⟩ :=
    (EtaPow.LocallyFree.etaTerm_finite_projective_and_split_of_idealI_isPrincipal C f hf i (hI i)).2
  obtain ⟨s, hs⟩ := graph_ker_split f hM hN d i r hr
  have he_fst : (LinearMap.fst B P Q).comp e.toLinearMap =
      eM.toLinearMap.comp ((LinearMap.fst A M N).baseChange B) :=
    TensorProduct.AlgebraTensorModule.ext fun _ _ => rfl
  have he_snd : (LinearMap.snd B P Q).comp e.toLinearMap =
      eN.toLinearMap.comp ((LinearMap.snd A M N).baseChange B) :=
    TensorProduct.AlgebraTensorModule.ext fun _ _ => rfl
  have hd : eN.toLinearMap.comp (d.baseChange B) = dB.comp eM.toLinearMap :=
    _root_.piScalarRight_mulVec (C.d i)
  have he_graph : (graphMap g dB).comp e.toLinearMap =
      eN.toLinearMap.comp ((graphMap f d).baseChange B) := by
    simp only [graphMap, LinearMap.sub_comp, LinearMap.smul_comp,
      LinearMap.baseChange_sub, LinearMap.baseChange_comp, LinearMap.baseChange_smul,
      LinearMap.comp_sub, LinearMap.comp_smul]
    simp only [LinearMap.comp_assoc, he_fst, he_snd]
    rw [← LinearMap.comp_assoc, ← hd]
    simp only [LinearMap.comp_assoc]
    congr 1
    apply LinearMap.ext
    intro x
    change g • eN ((LinearMap.snd A M N).baseChange B x) =
      f • eN ((LinearMap.snd A M N).baseChange B x)
    exact algebraMap_smul B f _
  have hreg : IsSMulRegular (B ⊗[A] (M × N)) g :=
    .of_injective e e.injective (hg.isSMulRegular : IsSMulRegular (P × Q) g)
  have hk : Submodule.baseChange B (LinearMap.ker (graphMap f d)) =
      LinearMap.ker ((graphMap f d).baseChange B) := by
    exact baseChange_ker_of_split f (graphMap f d) _ (graphMap_comp_neg_inr f d) s hs hreg
  have hk' : (Submodule.baseChange B (LinearMap.ker (graphMap f d))).map e.toLinearMap =
      LinearMap.ker (graphMap g dB) := by
    rw [hk]
    ext x
    constructor
    · rintro ⟨y, hy, rfl⟩
      change graphMap g dB (e y) = 0
      have heq := LinearMap.congr_fun he_graph y
      change graphMap g dB (e y) = eN ((graphMap f d).baseChange B y) at heq
      rw [heq, show (graphMap f d).baseChange B y = 0 from hy, map_zero]
    · intro hx
      refine ⟨e.symm x, ?_, e.apply_symm_apply x⟩
      apply eN.injective
      change eN ((graphMap f d).baseChange B (e.symm x)) = eN 0
      have heq := LinearMap.congr_fun he_graph (e.symm x)
      change graphMap g dB (e (e.symm x)) =
        eN ((graphMap f d).baseChange B (e.symm x)) at heq
      rw [← heq, e.apply_symm_apply, show graphMap g dB x = 0 from hx, map_zero]
  rw [fetaTerm_eq_map_graph f hN d i, baseChange_map,
    ← Submodule.map_comp, LinearMap.baseChange_comp, ← LinearMap.comp_assoc,
    ambientMap_fpowMap, LinearMap.comp_assoc, ← he_fst,
    ← LinearMap.comp_assoc, Submodule.map_comp, hk',
    ← fetaTerm_eq_map_graph g hQ dB i]



end Stacks.Eta.LocallyFreeTerms

end

end EtaTermBaseChange

end

@[expose] public section

/-! ## Tag 0F7X as a degreewise isomorphism

The submodule equality of Tag 0F7X, read along the ambient comparison map
`B ⊗_A (M^i)_f ⟶ (M^i ⊗_A B)_g`, becomes an isomorphism
`(η_f M^•)^i ⊗_A B ≅ (η_g (M^• ⊗_A B))^i`: the equality gives surjectivity, and injectivity is
the splitting of Tag 0F7W carried through base change.
-/

section EtaTermBaseChangeIso

noncomputable section

open scoped TensorProduct

namespace Stacks.Eta.LocallyFreeTerms

open EtaPow

universe u

section BaseChangeIso

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]

/-- The **ambient comparison map** of [Stacks, Tag 0F7X] in degree `i`: the canonical `B`-linear
map `B ⊗_A (M^i)_f ⟶ (M^i ⊗_A B)_g`, namely the localization--base-change identification
`Stacks.Eta.BaseChange.psiEquiv` followed by the finite free base-change identification
`TensorProduct.piScalarRight`.  Tag 0F7X compares the two décalage terms along it. -/
noncomputable def ambientBaseChangeMap (C : BoundedComplex A) (f : A) (i : ℤ) :
    B ⊗[A] Loc f (Fin (C.rank i) → A) →ₗ[B]
      Loc (algebraMap A B f) (Fin (C.rank i) → B) :=
  ((LocalizedModule.map (Submonoid.powers (algebraMap A B f))
      (TensorProduct.piScalarRight A B B (Fin (C.rank i))).toLinearMap).restrictScalars B).comp
    (Stacks.Eta.BaseChange.psiEquiv f (Fin (C.rank i) → A)).toLinearMap

/-- On a generator `1 ⊗ x` the ambient comparison map is the canonical comparison map `etaBCPsi`
of `StacksFrontier.Homology.Eta.BaseChange`, followed by the localized free base change. -/
theorem ambientBaseChangeMap_one_tmul (C : BoundedComplex A) (f : A) (i : ℤ)
    (x : Loc f (Fin (C.rank i) → A)) :
    ambientBaseChangeMap (B := B) C f i ((1 : B) ⊗ₜ[A] x) =
      fLoc (algebraMap A B f)
        (TensorProduct.piScalarRight A B B (Fin (C.rank i))).toLinearMap
        (Stacks.Eta.BaseChange.etaBCPsi f (Fin (C.rank i) → A) x) := by
  rw [Stacks.Eta.BaseChange.etaBCPsi_eq_psiEquiv]
  rfl

/-- The ambient comparison map turns the base change of multiplication by `fⁱ` on `M^i` into
multiplication by `gⁱ` on `M^i ⊗_A B`.  This is `ambientMap_fpowMap` read at the free base
change. -/
theorem ambientBaseChangeMap_comp_fpowMap (C : BoundedComplex A) (f : A) (i : ℤ) :
    (ambientBaseChangeMap (B := B) C f i).comp
        (LinearMap.baseChange B (fpowMap f (Fin (C.rank i) → A) i)) =
      (fpowMap (algebraMap A B f) (Fin (C.rank i) → B) i).comp
        (TensorProduct.piScalarRight A B B (Fin (C.rank i))).toLinearMap :=
  ambientMap_fpowMap f i (TensorProduct.piScalarRight A B B (Fin (C.rank i))).toLinearMap

/-- On a generator `1 ⊗ x` the ambient comparison map intertwines the localized differential
`dⁱ` of `M^•` with the localized differential of the base-changed complex. -/
theorem ambientBaseChangeMap_fLoc_one_tmul (C : BoundedComplex A) (f : A) (i : ℤ)
    (x : Loc f (Fin (C.rank i) → A)) :
    ambientBaseChangeMap (B := B) C f (i + 1)
        ((1 : B) ⊗ₜ[A] fLoc f (C.d i).mulVecLin x) =
      fLoc (algebraMap A B f) ((C.d i).map (algebraMap A B)).mulVecLin
        (ambientBaseChangeMap (B := B) C f i ((1 : B) ⊗ₜ[A] x)) := by
  rw [ambientBaseChangeMap_one_tmul, ambientBaseChangeMap_one_tmul,
    Stacks.Eta.BaseChange.etaBCPsi_fLoc]
  simp only [EtaComplex.localizedMap_comp_apply]
  exact congrArg (fun m => fLoc (algebraMap A B f) m
    (Stacks.Eta.BaseChange.etaBCPsi f (Fin (C.rank i) → A) x))
    (_root_.piScalarRight_mulVec (C.d i))

/-- The ambient comparison map intertwines the localized differential `dⁱ` of `M^•` with the
localized differential of the base-changed complex.  This is the compatibility that makes the
degreewise comparisons below a map of complexes. -/
theorem ambientBaseChangeMap_comp_fLoc (C : BoundedComplex A) (f : A) (i : ℤ) :
    (ambientBaseChangeMap (B := B) C f (i + 1)).comp
        (LinearMap.baseChange B (fLoc f (C.d i).mulVecLin)) =
      (fLoc (algebraMap A B f) ((C.d i).map (algebraMap A B)).mulVecLin).comp
        (ambientBaseChangeMap (B := B) C f i) := by
  apply TensorProduct.AlgebraTensorModule.ext
  intro b x
  have hb : b ⊗ₜ[A] x = b • ((1 : B) ⊗ₜ[A] x) := by
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  have e1 := LinearMap.map_smul ((ambientBaseChangeMap (B := B) C f (i + 1)).comp
    (LinearMap.baseChange B (fLoc f (C.d i).mulVecLin))) b ((1 : B) ⊗ₜ[A] x)
  have e2 := LinearMap.map_smul
    ((fLoc (algebraMap A B f) ((C.d i).map (algebraMap A B)).mulVecLin).comp
      (ambientBaseChangeMap (B := B) C f i)) b ((1 : B) ⊗ₜ[A] x)
  rw [hb, e1]
  refine Eq.trans (congrArg (fun t => b • t) ?_) e2.symm
  simpa only [LinearMap.comp_apply, LinearMap.baseChange_tmul]
    using ambientBaseChangeMap_fLoc_one_tmul (B := B) C f i x

/-- **[Stacks, Tag 0F7X], restated with the ambient comparison map named.** -/
theorem map_ambientBaseChangeMap_baseChange_fetaTerm (C : BoundedComplex A) (f : A)
    (hf : IsRegular f) (hg : IsRegular (algebraMap A B f))
    (hI : ∀ i : ℤ, (idealI C f i).IsPrincipal) (i : ℤ) :
    Submodule.map (ambientBaseChangeMap (B := B) C f i)
        (Submodule.baseChange B (fetaTerm f (C.d i).mulVecLin i)) =
      fetaTerm (algebraMap A B f) ((C.d i).map (algebraMap A B)).mulVecLin i :=
  eta_baseChange_of_idealI_isPrincipal C f hf hg hI i

/-- **The canonical comparison map of [Stacks, Tag 0F7X] in degree `i`.** The base change of the
degree-`i` décalage term of `M^•` maps to the degree-`i` décalage term of the base-changed
complex, by the ambient comparison `ambientBaseChangeMap`.

That the ambient comparison carries the one submodule *onto* the other is exactly
`Stacks.Eta.LocallyFreeTerms.eta_baseChange_of_idealI_isPrincipal`, which is why the
principality hypothesis is needed already to form the corestriction. -/
noncomputable def etaTermBaseChangeMap (C : BoundedComplex A) (f : A) (hf : IsRegular f)
    (hg : IsRegular (algebraMap A B f)) (hI : ∀ i : ℤ, (idealI C f i).IsPrincipal) (i : ℤ) :
    (B ⊗[A] (fetaTerm f (C.d i).mulVecLin i)) →ₗ[B]
      fetaTerm (algebraMap A B f) ((C.d i).map (algebraMap A B)).mulVecLin i :=
  LinearMap.codRestrict _
    ((ambientBaseChangeMap C f i).comp
      (LinearMap.baseChange B (fetaTerm f (C.d i).mulVecLin i).subtype))
    fun x => by
      rw [← map_ambientBaseChangeMap_baseChange_fetaTerm C f hf hg hI i]
      exact Submodule.mem_map_of_mem (LinearMap.mem_range_self _ x)

/-- The comparison map of [Stacks, Tag 0F7X] is surjective: by that tag the ambient comparison
carries the base change of the décalage term onto the décalage term of the base change. -/
theorem surjective_etaTermBaseChangeMap (C : BoundedComplex A) (f : A) (hf : IsRegular f)
    (hg : IsRegular (algebraMap A B f)) (hI : ∀ i : ℤ, (idealI C f i).IsPrincipal) (i : ℤ) :
    Function.Surjective (etaTermBaseChangeMap C f hf hg hI i) := by
  intro y
  have hy : y.1 ∈ Submodule.map (ambientBaseChangeMap (B := B) C f i)
      (Submodule.baseChange B (fetaTerm f (C.d i).mulVecLin i)) := by
    rw [map_ambientBaseChangeMap_baseChange_fetaTerm C f hf hg hI i]
    exact y.2
  obtain ⟨z, hz, hzy⟩ := hy
  obtain ⟨x, rfl⟩ := hz
  exact ⟨x, Subtype.ext hzy⟩

/-- The comparison map of [Stacks, Tag 0F7X] is injective.

By Tag 0F7W the décalage term is the kernel of the graph map `(m, n) ↦ dⁱm - fn` on the finite
free module `M^i × M^{i+1}`, and that kernel is a direct summand, so its inclusion stays
injective after base change.  The first component of an element of the base-changed kernel
determines the second, because `g` is a nonzerodivisor on `M^{i+1} ⊗_A B`; and the ambient
comparison composed with the first component is multiplication by `gⁱ` after the free base
change, which is injective. -/
theorem injective_etaTermBaseChangeMap (C : BoundedComplex A) (f : A) (hf : IsRegular f)
    (hg : IsRegular (algebraMap A B f)) (hI : ∀ i : ℤ, (idealI C f i).IsPrincipal) (i : ℤ) :
    Function.Injective (etaTermBaseChangeMap C f hf hg hI i) := by
  let M := Fin (C.rank i) → A
  let N := Fin (C.rank (i + 1)) → A
  let d : M →ₗ[A] N := (C.d i).mulVecLin
  have hMreg : IsSMulRegular M f := hf.isSMulRegular
  have hNreg : IsSMulRegular N f := hf.isSMulRegular
  let eM : B ⊗[A] M ≃ₗ[B] (Fin (C.rank i) → B) :=
    TensorProduct.piScalarRight A B B (Fin (C.rank i))
  let eN : B ⊗[A] N ≃ₗ[B] (Fin (C.rank (i + 1)) → B) :=
    TensorProduct.piScalarRight A B B (Fin (C.rank (i + 1)))
  let K := LinearMap.ker (graphMap f d)
  have hinj := (bijective_prod_baseChange_fst_snd (A := A) (M := M) (N := N) B).1
  -- `g` is a nonzerodivisor on `B ⊗ N`, which is finite free over `B`
  have hNBreg : IsSMulRegular (B ⊗[A] N) (algebraMap A B f) :=
    .of_injective eN eN.injective
      (hg.isSMulRegular : IsSMulRegular (Fin (C.rank (i + 1)) → B) (algebraMap A B f))
  -- the splitting of Tag 0F7W, in its graph form
  obtain ⟨r, hr⟩ :=
    (EtaPow.LocallyFree.etaTerm_finite_projective_and_split_of_idealI_isPrincipal
      C f hf i (hI i)).2
  obtain ⟨s, hs⟩ := graph_ker_split f hMreg hNreg d i r hr
  -- the inclusion of the kernel of the graph map is split, hence injective after base change
  have hsub := injective_baseChange_subtype_of_split B K.subtype s hs
  -- the graph map kills the base change of its kernel
  have hgraph : ∀ z : B ⊗[A] K,
      LinearMap.baseChange B (graphMap f d) (LinearMap.baseChange B K.subtype z) = 0 := by
    intro z
    rw [← LinearMap.comp_apply, ← LinearMap.baseChange_comp,
      show (graphMap f d).comp K.subtype = 0 from LinearMap.ext fun w => w.2,
      LinearMap.baseChange_zero, LinearMap.zero_apply]
  -- the first component of the base-changed graph inclusion is injective
  have hfst : ∀ z w : B ⊗[A] K,
      LinearMap.baseChange B (LinearMap.fst A M N) (LinearMap.baseChange B K.subtype z) =
          LinearMap.baseChange B (LinearMap.fst A M N) (LinearMap.baseChange B K.subtype w) →
        z = w := by
    intro z w hzw
    have hsnd : LinearMap.baseChange B (LinearMap.snd A M N)
          (LinearMap.baseChange B K.subtype z) =
        LinearMap.baseChange B (LinearMap.snd A M N) (LinearMap.baseChange B K.subtype w) := by
      refine hNBreg ?_
      have hz := baseChange_graphMap_apply B f d (LinearMap.baseChange B K.subtype z)
      have hw := baseChange_graphMap_apply B f d (LinearMap.baseChange B K.subtype w)
      rw [hgraph z] at hz
      rw [hgraph w] at hw
      rw [hzw] at hz
      simp only [algebraMap_smul]
      exact sub_right_inj.mp (hz.symm.trans hw)
    refine hsub (hinj ?_)
    simp only [LinearMap.prod_apply, Function.prod, Prod.mk.injEq]
    exact ⟨hzw, hsnd⟩
  -- the graph description of the décalage term
  let ge : K ≃ₗ[A] fetaTerm f d i :=
    LinearEquiv.ofBijective (graphToEta f d i)
      ⟨graphToEta_injective f hMreg hNreg d i, graphToEta_surjective f hNreg d i⟩
  let egbL := LinearMap.baseChange B ge.toLinearMap
  have hegbSurj : Function.Surjective egbL :=
    (LinearEquiv.baseChange A B K (fetaTerm f d i) ge).surjective
  have hcomp : ∀ w : B ⊗[A] K,
      ambientBaseChangeMap (B := B) C f i
          (LinearMap.baseChange B (fetaTerm f d i).subtype (egbL w)) =
        fpowMap (algebraMap A B f) (Fin (C.rank i) → B) i
          (eM ((LinearMap.baseChange B (LinearMap.fst A M N))
            (LinearMap.baseChange B K.subtype w))) := by
    intro w
    have hge := congrArg (LinearMap.baseChange B)
      (show (fetaTerm f d i).subtype.comp ge.toLinearMap =
        (fpowMap f M i).comp ((LinearMap.fst A M N).comp K.subtype) from rfl)
    rw [LinearMap.baseChange_comp, LinearMap.baseChange_comp,
      LinearMap.baseChange_comp] at hge
    have h1 : LinearMap.baseChange B (fetaTerm f d i).subtype (egbL w) =
        LinearMap.baseChange B (fpowMap f M i)
          (LinearMap.baseChange B (LinearMap.fst A M N)
            (LinearMap.baseChange B K.subtype w)) := LinearMap.congr_fun hge w
    rw [h1]
    exact LinearMap.congr_fun (ambientBaseChangeMap_comp_fpowMap (B := B) C f i)
      (LinearMap.baseChange B (LinearMap.fst A M N) (LinearMap.baseChange B K.subtype w))
  -- assemble
  intro x y hxy
  obtain ⟨w, rfl⟩ := hegbSurj x
  obtain ⟨w', rfl⟩ := hegbSurj y
  have hval : ambientBaseChangeMap (B := B) C f i
        (LinearMap.baseChange B (fetaTerm f d i).subtype (egbL w)) =
      ambientBaseChangeMap (B := B) C f i
        (LinearMap.baseChange B (fetaTerm f d i).subtype (egbL w')) :=
    congrArg Subtype.val hxy
  rw [hcomp w, hcomp w'] at hval
  exact congrArg (fun z => egbL z) (hfst w w'
    (eM.injective (fpowMap_injective (algebraMap A B f) hg.isSMulRegular i hval)))

/-- **[Stacks, Tag 0F7X] in degree `i`, as an isomorphism.** For a ring map `A → B` under which
the nonzerodivisor `f` stays a nonzerodivisor, and a bounded complex `M^•` of finite free
`A`-modules all of whose determinantal ideals `I_i(M^•, f)` are principal, the canonical map
`(η_f M^•)^i ⊗_A B ⟶ (η_g (M^• ⊗_A B))^i` of
`Stacks.Eta.LocallyFreeTerms.etaTermBaseChangeMap` is an isomorphism. -/
@[stacks 0F7X "the canonical isomorphism, degreewise: the comparison map \
etaTermBaseChangeMap, induced by the ambient comparison, is bijective in every degree.  That \
these degreewise isomorphisms are compatible with the two differentials is \
ambientBaseChangeMap_comp_fLoc; they are not assembled into one isomorphism of cochain \
complexes here."]
noncomputable def etaTermBaseChangeEquiv (C : BoundedComplex A) (f : A) (hf : IsRegular f)
    (hg : IsRegular (algebraMap A B f)) (hI : ∀ i : ℤ, (idealI C f i).IsPrincipal) (i : ℤ) :
    (B ⊗[A] (fetaTerm f (C.d i).mulVecLin i)) ≃ₗ[B]
      fetaTerm (algebraMap A B f) ((C.d i).map (algebraMap A B)).mulVecLin i :=
  LinearEquiv.ofBijective (etaTermBaseChangeMap C f hf hg hI i)
    ⟨injective_etaTermBaseChangeMap C f hf hg hI i,
      surjective_etaTermBaseChangeMap C f hf hg hI i⟩

end BaseChangeIso

end Stacks.Eta.LocallyFreeTerms

end

end EtaTermBaseChangeIso

end

@[expose] public section

/-! ## Tag 0F7X as preservation of a fibre product

The degree-`i` term of `η_f M^•` is the fibre product of `dⁱ : M^i → M^{i+1}` and multiplication
by `f` on `M^{i+1}`, read through multiplication by `fⁱ` and `fⁱ⁺¹`. Under the hypotheses of
Tag 0F7X extension of scalars preserves this fibre product: the kernel of the graph map
`(m, n) ↦ dⁱ m - f n` is a direct summand by Tag 0F7W, and `f` stays a nonzerodivisor after base
change, so the kernel commutes with base change.
-/

section EtaFibreProductBaseChange

noncomputable section

open scoped TensorProduct

namespace CategoryTheory.Limits

/-- A functor which carries a pullback square to a pullback square preserves the pullback of
its cospan: the comparison map is an isomorphism. -/
theorem isIso_pullbackComparison_of_isPullback {C D : Type*} [Category C]
    [Category D] (G : C ⥤ D) {P X Y Z : C} {p : P ⟶ X} {q : P ⟶ Y} {a : X ⟶ Z} {b : Y ⟶ Z}
    (h : IsPullback p q a b) (hG : IsPullback (G.map p) (G.map q) (G.map a) (G.map b))
    [HasPullback a b] [HasPullback (G.map a) (G.map b)] :
    IsIso (pullbackComparison G a b) := by
  have e : pullbackComparison G a b = G.map h.isoPullback.inv ≫ hG.isoPullback.hom := by
    refine pullback.hom_ext ?_ ?_
    · rw [pullbackComparison_comp_fst, Category.assoc, IsPullback.isoPullback_hom_fst,
        ← G.map_comp, IsPullback.isoPullback_inv_fst]
    · rw [pullbackComparison_comp_snd, Category.assoc, IsPullback.isoPullback_hom_snd,
        ← G.map_comp, IsPullback.isoPullback_inv_snd]
  rw [e]
  infer_instance

end CategoryTheory.Limits

namespace Stacks.Eta.LocallyFreeTerms

open EtaPow

universe u

variable {A B : Type u} [CommRing A] [CommRing B]

/-- A nonzerodivisor of `B` acts regularly on the base change of a finite free `A`-module. -/
theorem isSMulRegular_tensor_pi [Algebra A B] {f : A} (hg : IsRegular (algebraMap A B f))
    (r : ℕ) : IsSMulRegular (B ⊗[A] (Fin r → A)) (algebraMap A B f) := by
  have hQ : IsSMulRegular (Fin r → B) (algebraMap A B f) := hg.isSMulRegular
  exact .of_injective (TensorProduct.piScalarRight A B B (Fin r))
    (TensorProduct.piScalarRight A B B (Fin r)).injective hQ

/-- **[Stacks, Tag 0F7X], as preservation of a fibre product.** Let `M^•` be a bounded complex of
finite free `A`-modules, let `f ∈ A` be a nonzerodivisor all of whose determinantal ideals
`I_i(M^•, f)` are principal, and let `φ : A → B` be a ring map with `φ f` a nonzerodivisor. Then
extension of scalars along `φ` preserves the fibre product of `dⁱ : M^i → M^{i+1}` and
multiplication by `f` on `M^{i+1}`, whose fibre product is, through multiplication by `fⁱ`, the
degree-`i` décalage term. -/
theorem isIso_pullbackComparison_extendScalars_mulVecLin (φ : A →+* B) (C : BoundedComplex A)
    (f : A) (hf : IsRegular f) (hg : IsRegular (φ f)) (hI : ∀ i : ℤ, (idealI C f i).IsPrincipal)
    (n : ℤ) :
    CategoryTheory.IsIso (CategoryTheory.Limits.pullbackComparison (ModuleCat.extendScalars φ)
      (ModuleCat.ofHom (C.d n).mulVecLin :
        ModuleCat.of A (Fin (C.rank n) → A) ⟶ ModuleCat.of A (Fin (C.rank (n + 1)) → A))
      (ModuleCat.ofHom (f • LinearMap.id) :
        ModuleCat.of A (Fin (C.rank (n + 1)) → A) ⟶
          ModuleCat.of A (Fin (C.rank (n + 1)) → A))) := by
  let : Algebra A B := φ.toAlgebra
  let M := Fin (C.rank n) → A
  let N := Fin (C.rank (n + 1)) → A
  let d : M →ₗ[A] N := (C.d n).mulVecLin
  let K := LinearMap.ker (graphMap f d)
  let p : ModuleCat.of A K ⟶ ModuleCat.of A M :=
    ModuleCat.ofHom ((LinearMap.fst A M N).comp K.subtype)
  let q : ModuleCat.of A K ⟶ ModuleCat.of A N :=
    ModuleCat.ofHom ((LinearMap.snd A M N).comp K.subtype)
  let a : ModuleCat.of A M ⟶ ModuleCat.of A N := ModuleCat.ofHom d
  let b : ModuleCat.of A N ⟶ ModuleCat.of A N := ModuleCat.ofHom (f • LinearMap.id)
  have hw : CategoryTheory.CategoryStruct.comp p a =
      CategoryTheory.CategoryStruct.comp q b :=
    ModuleCat.hom_ext (LinearMap.ext fun x => sub_eq_zero.mp x.2)
  have hP : CategoryTheory.IsPullback p q a b := by
    apply CategoryTheory.IsPullback.of_map (CategoryTheory.forget (ModuleCat A)) hw
    rw [CategoryTheory.Limits.Types.isPullback_iff]
    refine ⟨by rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp, hw],
      ?_, ?_⟩
    · rintro x y ⟨h1, h2⟩
      exact Subtype.ext (Prod.ext h1 h2)
    · intro u v huv
      exact ⟨⟨(u, v), sub_eq_zero.mpr huv⟩, rfl, rfl⟩
  have hMreg : IsSMulRegular M f := hf.isSMulRegular
  have hNreg : IsSMulRegular N f := hf.isSMulRegular
  -- the splitting of Tag 0F7W, in its graph form
  obtain ⟨r, hr⟩ :=
    (EtaPow.LocallyFree.etaTerm_finite_projective_and_split_of_idealI_isPrincipal
      C f hf n (hI n)).2
  obtain ⟨s, hs⟩ := graph_ker_split f hMreg hNreg d n r hr
  have hbij := bijective_prod_baseChange_fst_snd (A := A) (M := M) (N := N) B
  have hsub := injective_baseChange_subtype_of_split B K.subtype s hs
  have hXreg : IsSMulRegular (B ⊗[A] (M × N)) (algebraMap A B f) := by
    intro z w hzw
    have h1 := congrArg (TensorProduct.prodRight A B B M N) hzw
    simp only [map_smul] at h1
    refine (TensorProduct.prodRight A B B M N).injective (Prod.ext ?_ ?_)
    · exact isSMulRegular_tensor_pi (B := B) (f := f) hg _ (congrArg Prod.fst h1)
    · exact isSMulRegular_tensor_pi (B := B) (f := f) hg _ (congrArg Prod.snd h1)
  have hker := baseChange_ker_of_split (B := B) f (graphMap f d) _ (graphMap_comp_neg_inr f d)
    s hs hXreg
  refine CategoryTheory.Limits.isIso_pullbackComparison_of_isPullback _ hP ?_
  apply CategoryTheory.IsPullback.of_map (CategoryTheory.forget (ModuleCat B))
    (by rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp, hw])
  rw [CategoryTheory.Limits.Types.isPullback_iff]
  refine ⟨by rw [← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp,
    ← CategoryTheory.Functor.map_comp, ← CategoryTheory.Functor.map_comp, hw], ?_, ?_⟩
  · rintro z0 w0 ⟨h1, h2⟩
    let z : B ⊗[A] K := z0
    let w : B ⊗[A] K := w0
    have h1' : LinearMap.baseChange B ((LinearMap.fst A M N).comp K.subtype) z =
        LinearMap.baseChange B ((LinearMap.fst A M N).comp K.subtype) w := h1
    have h2' : LinearMap.baseChange B ((LinearMap.snd A M N).comp K.subtype) z =
        LinearMap.baseChange B ((LinearMap.snd A M N).comp K.subtype) w := h2
    rw [LinearMap.baseChange_comp, LinearMap.comp_apply, LinearMap.comp_apply] at h1' h2'
    refine hsub (hbij.1 ?_)
    simp only [LinearMap.prod_apply, Function.prod, Prod.mk.injEq]
    exact ⟨h1', h2'⟩
  · intro u0 v0 huv
    let u : B ⊗[A] M := u0
    let v : B ⊗[A] N := v0
    obtain ⟨x, hx⟩ := hbij.2 (u, v)
    have hxu : LinearMap.baseChange B (LinearMap.fst A M N) x = u := congrArg Prod.fst hx
    have hxv : LinearMap.baseChange B (LinearMap.snd A M N) x = v := congrArg Prod.snd hx
    have huv' : LinearMap.baseChange B d u = LinearMap.baseChange B (f • LinearMap.id) v := huv
    rw [LinearMap.baseChange_smul, LinearMap.baseChange_id, LinearMap.smul_apply,
      LinearMap.id_apply] at huv'
    have hx0 : x ∈ LinearMap.ker (LinearMap.baseChange B (graphMap f d)) := by
      rw [LinearMap.mem_ker, baseChange_graphMap_apply, hxu, hxv, huv', sub_self]
    rw [← hker] at hx0
    obtain ⟨w, hw'⟩ := hx0
    refine ⟨w, ?_, ?_⟩
    · change (LinearMap.baseChange B ((LinearMap.fst A M N).comp K.subtype)) w = u
      rw [LinearMap.baseChange_comp, LinearMap.comp_apply, hw', hxu]
    · change (LinearMap.baseChange B ((LinearMap.snd A M N).comp K.subtype)) w = v
      rw [LinearMap.baseChange_comp, LinearMap.comp_apply, hw', hxv]

end Stacks.Eta.LocallyFreeTerms

end

end EtaFibreProductBaseChange

end
