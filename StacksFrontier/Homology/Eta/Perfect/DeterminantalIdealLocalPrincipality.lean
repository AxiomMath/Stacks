module

public import StacksFrontier.Homology.Eta.Perfect.DeterminantalIdeal
public import StacksFrontier.RingTheory.Localization.FGIdealAway

/-!
# The determinantal ideals of a complex with free cohomology are locally principal

Let `A` be a commutative ring, `f ∈ A` a nonzerodivisor and `M^•` a bounded complex of finite
free `A`-modules.  More on Algebra, Tag 0GSV says that if the cohomology modules of `M^•` become
free over the local ring at a prime `p`, then each determinantal ideal `I_i(M^•, f)` becomes
generated by a power of `f` over that local ring.

This file upgrades that statement from the local ring at `p` to a standard open neighbourhood of
`p`: there is an element `g ∉ p` such that `I_i(M^•, f)` is generated by a power of `f` already
in `A[1/g]`.  This is the sentence "the ideals `I_i(M^•, f)` are locally generated by a power of
`f`" with which the Stacks proof of Tag 0F8W begins.

## Main results

* `Stacks.DeterminantalIdeal.fg_minorIdealInjective`: the ideal of `r × r` minors of a matrix
  indexed by finite types is finitely generated, there being only finitely many minors.
* `Stacks.DeterminantalIdeal.fg_idealI`: the determinantal ideal `I_i(M^•, f)` is finitely
  generated.
* `Stacks.DeterminantalIdeal.minorIdealInjective_zero_eq_top` and
  `Stacks.DeterminantalIdeal.idealI_eq_top_of_rank_eq_zero`: a degree in which `M^•` vanishes
  contributes the unit ideal, so a product of determinantal ideals over the degrees has only
  finitely many nontrivial factors.
* `Stacks.DeterminantalIdeal.FreeHomology.exists_away_map_idealI_eq_span_pow_of_free_homology`:
  the Zariski-local form of Tag 0GSV described above.

## Implementation notes

Finite generation of the minor ideal is what makes the descent possible, and it holds for the
cheapest possible reason: the generating set of
`minorIdealInjective` is contained in the range of a map out of
`(Fin r → m) × (Fin r → n)`, a finite type.  The descent itself is
`Stacks.Localization.exists_mem_map_eq_map_localizationAway`, applied to `I_i(M^•, f)` and the
principal ideal generated by `f ^ n`, both finitely generated.

## References

* [Stacks Project, Tag 0GSV](https://stacks.math.columbia.edu/tag/0GSV)
* [Stacks Project, Tag 0F8W](https://stacks.math.columbia.edu/tag/0F8W)
-/

@[expose] public noncomputable section

namespace Stacks.DeterminantalIdeal

/-- The ideal of `r × r` minors of a matrix whose rows and columns are indexed by finite types
is finitely generated: the minors are indexed by the finite type of pairs of a choice of `r` rows
and a choice of `r` columns. -/
theorem fg_minorIdealInjective {A : Type*} [CommRing A] {m n : Type*} [Finite m] [Finite n]
    (T : Matrix m n A) (r : ℕ) : (minorIdealInjective T r).FG := by
  classical
  apply Submodule.fg_span
  refine Set.Finite.subset
    (Set.finite_range fun q : (Fin r → m) × (Fin r → n) => (T.submatrix q.1 q.2).det) ?_
  rintro x ⟨ri, ci, -, -, rfl⟩
  exact ⟨(ri, ci), rfl⟩

/-- The determinantal ideal `I_i(M^•, f)` of a bounded complex of finite free modules is
finitely generated. -/
theorem fg_idealI {A : Type*} [CommRing A] (C : BoundedComplex A) (f : A) (i : ℤ) :
    (idealI C f i).FG :=
  fg_minorIdealInjective _ _

/-- The ideal of `0 × 0` minors of a matrix is the unit ideal: the only minor is the determinant
of the empty matrix, which is `1`. -/
theorem minorIdealInjective_zero_eq_top {A : Type*} [CommRing A] {m n : Type*}
    (T : Matrix m n A) : minorIdealInjective T 0 = ⊤ :=
  (Ideal.eq_top_iff_one _).mpr <|
    Ideal.subset_span ⟨Fin.elim0, Fin.elim0, fun j => Fin.elim0 j, fun j => Fin.elim0 j, by simp⟩

/-- In a degree where the complex vanishes the determinantal ideal is the unit ideal.  Only the
finitely many degrees in which `M^•` is nonzero therefore contribute to a product of
determinantal ideals over the degrees. -/
theorem idealI_eq_top_of_rank_eq_zero {A : Type*} [CommRing A] (C : BoundedComplex A) (f : A)
    {i : ℤ} (h : C.rank i = 0) : idealI C f i = ⊤ := by
  change minorIdealInjective (mapMatrix f (C.d i)) (C.rank i) = ⊤
  simpa only [h] using minorIdealInjective_zero_eq_top (mapMatrix f (C.d i))

namespace FreeHomology

/-- **The Zariski-local form of Stacks 0GSV.**  If the localization at a prime `p` of every
cohomology module of a bounded complex `M^•` of finite free `A`-modules is free, then for every
degree there is an element `g ∉ p` such that the determinantal ideal `I_i(M^•, f)` is generated
by a power of the nonzerodivisor `f` already in `A[1/g]`.

Tag 0GSV gives the statement over the local ring at `p`; the determinantal ideal and the
principal ideal generated by that power of `f` are both finitely generated, so the equality
descends to a standard open neighbourhood of `p` by
`Stacks.Localization.exists_mem_map_eq_map_localizationAway`. -/
theorem exists_away_map_idealI_eq_span_pow_of_free_homology
    {A : Type*} [CommRing A] (p : Ideal A) [p.IsPrime]
    (f : A) (hf : f ∈ nonZeroDivisors A) (M : BoundedComplex A)
    (hfree : ∀ i : ℤ, Module.Free (Localization.AtPrime p)
      (LocalizedModule p.primeCompl
        ((HomologicalComplex.homologyFunctor (ModuleCat A) (ComplexShape.up ℤ) i).obj
          M.toCochainComplex)))
    (i : ℤ) :
    ∃ g ∈ p.primeCompl, ∃ n : ℕ,
      Ideal.map (algebraMap A (Localization.Away g)) (idealI M f i)
        = Ideal.span {algebraMap A (Localization.Away g) f ^ n} := by
  obtain ⟨n, hn⟩ := localized_idealI_eq_span_pow_of_free_homology p f hf M hfree i
  obtain ⟨g, hg, heq⟩ := Stacks.Localization.exists_mem_map_eq_map_localizationAway
    p.primeCompl (Localization.AtPrime p) (fg_idealI M f i)
    (Submodule.fg_span (Set.finite_singleton (f ^ n)))
    (by simp [hn, Ideal.map_span])
  exact ⟨g, hg, n, by simp [heq, Ideal.map_span]⟩

end FreeHomology

end Stacks.DeterminantalIdeal

end
