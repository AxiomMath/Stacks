/-!
# Minor-type ideals of a perfect complex and the eta operator

Let `A` be a commutative ring, let `f ∈ A` be a nonzerodivisor and let `M^•` be a bounded
complex of finite free `A`-modules, written in chosen bases as a `BoundedComplex A`. The
ideal `I_i(M^•, f)` (`idealI`) is generated by the `r_i × r_i` minors of the matrix of
`(f, d^i) : M^i → M^i ⊕ M^{i+1}`. This file shows that, suitably normalized by a power of
`f`, this ideal only depends on the object of `D(A)` that `M^•` represents, and computes it
at a prime where the localized cohomology is free.

## Main definitions

* `BoundedComplex.toCochainComplex`: a bounded matrix complex viewed as a cochain complex of
  finite free modules, i.e. the object of `D(A)` it represents.
* `BoundedComplex.tailEulerCharacteristic`: the alternating sum `∑_{j ≥ i} (-1)^(j-i) r_j` of
  the ranks in degrees at least `i`.

## Main results

* `Stacks.Eta.DeterminantalIdeal.pow_mul_idealI_eq_of_derived_iso` (Tag 0GSS): if `M^•` and `N^•`
  represent
  isomorphic objects of `D(A)` and `m + χ_i(M^•) = n + χ_i(N^•)`, then
  `f^m I_i(M^•, f) = f^n I_i(N^•, f)`.
* `Stacks.DeterminantalIdeal.FreeHomology.localized_idealI_eq_span_pow_of_free_homology` (Tag
  0GSV): if every cohomology
  module of `M^•` is free after localizing at a prime `p`, then each localization of
  `I_i(M^•, f)` is generated by a power of `f`.

## Implementation notes

Finite free modules are expressed in their chosen bases as function modules on finite types.
The product `f^m I` of an element and an ideal is represented by multiplication with the
principal ideal generated by `f^m`; the source's nonnegative exponents are natural numbers.
Localization of an ideal is extension along the canonical map to `Localization.AtPrime p`.

## References

* [The Stacks Project, Tag 0GSS](https://stacks.math.columbia.edu/tag/0GSS)
* [The Stacks Project, Tag 0GSV](https://stacks.math.columbia.edu/tag/0GSV)
-/

/-! ## Bounded matrix complexes as cochain complexes -/

section Cochain

open CategoryTheory

noncomputable section

namespace BoundedComplex

/-- Realize a bounded complex given in finite free bases as a cochain complex of modules. -/
public def toCochainComplex {A : Type*} [CommRing A] (C : BoundedComplex A) :
    CochainComplex (ModuleCat A) ℤ :=
  CochainComplex.of
    (fun i ↦ ModuleCat.of A (Fin (C.rank i) → A))
    (fun i ↦ ModuleCat.ofHom (C.d i).mulVecLin)
    (fun i ↦ by
      rw [← ModuleCat.ofHom_comp, ← Matrix.mulVecLin_mul, C.dd]
      simp)

/-- The degree `i` term of `C.toCochainComplex` is the free module `Fin (C.rank i) → A`. -/
@[simp]
public theorem toCochainComplex_X {A : Type*} [CommRing A] (C : BoundedComplex A) (i : ℤ) :
    C.toCochainComplex.X i = ModuleCat.of A (Fin (C.rank i) → A) := rfl

/-- The differential of `C.toCochainComplex` from degree `i` to degree `i + 1` is
multiplication by the matrix `C.d i`. -/
@[simp]
public theorem toCochainComplex_d {A : Type*} [CommRing A] (C : BoundedComplex A) (i : ℤ) :
    C.toCochainComplex.d i (i + 1) = ModuleCat.ofHom (C.d i).mulVecLin := by
  simp [toCochainComplex]

/-- The alternating sum `∑_{j ≥ i} (-1)^(j-i) rank(Cʲ)`. Boundedness makes the sum
finite. -/
public def tailEulerCharacteristic {A : Type*} [CommRing A]
    (C : BoundedComplex A) (i : ℤ) : ℤ :=
  ∑ j ∈ C.bounded.toFinset.filter (i ≤ ·), (-1 : ℤ) ^ (j - i).toNat * C.rank j

end BoundedComplex

end

end Cochain

/-! ## Normalized minor ideals of a perfect representative (Tag 0GSS) -/

section NormalizedMinorIdeals

namespace Stacks.Eta.DeterminantalIdeal

private theorem minorIdealInjective_eq_minorIdeal
    {A : Type*} [CommRing A] {m n : Type*} (T : Matrix m n A) (r : ℕ) :
    minorIdealInjective T r = minorIdeal T r := by
  apply le_antisymm
  · rw [minorIdealInjective, minorIdeal, Ideal.span_le]
    rintro x ⟨ri, ci, hri, hci, rfl⟩
    exact Ideal.subset_span ⟨ri, ci, rfl⟩
  · rw [minorIdeal, minorIdealInjective, Ideal.span_le]
    rintro x ⟨ri, ci, rfl⟩
    by_cases hri : Function.Injective ri
    · by_cases hci : Function.Injective ci
      · exact Ideal.subset_span ⟨ri, ci, hri, hci, rfl⟩
      · obtain ⟨i, j, heq, hij⟩ := Function.not_injective_iff.mp hci
        have hzero : (T.submatrix ri ci).det = 0 := by
          apply Matrix.det_zero_of_column_eq hij
          intro k
          simp [Matrix.submatrix, heq]
        exact hzero ▸ Ideal.zero_mem _
    · obtain ⟨i, j, heq, hij⟩ := Function.not_injective_iff.mp hri
      have hzero : (T.submatrix ri ci).det = 0 := by
        apply Matrix.det_zero_of_row_eq hij
        ext k
        simp [Matrix.submatrix, heq]
      exact hzero ▸ Ideal.zero_mem _

private theorem minorIdeal_fromBlocks_maximal
    {A : Type*} [CommRing A] {l₁ l₂ : Type*} [Fintype l₁] [Fintype l₂]
    (r s : ℕ) (T : Matrix l₁ (Fin r) A) (U : Matrix l₂ (Fin s) A) :
    minorIdeal (Matrix.fromBlocks T 0 0 U) (r + s) =
      minorIdeal T r * minorIdeal U s := by
  classical
  rw [minorIdeal_fromBlocks]
  let F : ℕ × ℕ → Ideal A := fun p => minorIdeal T p.1 * minorIdeal U p.2
  change (∑ p ∈ Finset.HasAntidiagonal.antidiagonal (r + s), F p) = F (r, s)
  apply Finset.sum_eq_single (r, s)
  · intro p hp hne
    have hsum : p.1 + p.2 = r + s := Finset.HasAntidiagonal.mem_antidiagonal.mp hp
    have hcase : r < p.1 ∨ s < p.2 := by
      by_contra hn
      push Not at hn
      exact hne (Prod.ext (by omega) (by omega))
    rcases hcase with h | h
    · have hbot : minorIdeal T p.1 = ⊥ :=
        minorIdeal_eq_bot_of_card_lt T p.1 (Or.inr (by simpa using h))
      simp [F, hbot]
    · have hbot : minorIdeal U p.2 = ⊥ :=
        minorIdeal_eq_bot_of_card_lt U p.2 (Or.inr (by simpa using h))
      simp [F, hbot]
  · simp

private theorem minorIdeal_fromBlocks_one_column
    {A : Type*} [CommRing A] {l₁ l₂ : Type*} [Fintype l₁] [Fintype l₂]
    (r : ℕ) (T : Matrix l₁ (Fin r) A) (U : Matrix l₂ (Fin 1) A) :
    minorIdeal (Matrix.fromBlocks T 0 0 U) (r + 1) =
      minorIdeal T r * minorIdeal U 1 :=
  minorIdeal_fromBlocks_maximal r 1 T U

private theorem minorIdeal_one_column
    {A : Type*} [CommRing A] {l : Type*} (U : Matrix l (Fin 1) A) :
    minorIdeal U 1 = Ideal.span (Set.range fun j : l => U j 0) := by
  apply le_antisymm
  · rw [minorIdeal, Ideal.span_le]
    rintro x ⟨ri, ci, rfl⟩
    rw [Matrix.det_fin_one]
    exact Ideal.subset_span ⟨ri 0, by simp [Subsingleton.elim (ci 0) 0]⟩
  · rw [Ideal.span_le]
    rintro x ⟨j, rfl⟩
    apply Ideal.subset_span
    refine ⟨(fun _ : Fin 1 => j), (fun _ : Fin 1 => 0), ?_⟩
    simp

/-- A matrix with an entry equal to `1` has the unit ideal as its ideal of `1 × 1` minors. -/
theorem minorIdeal_one_eq_top_of_entry_one
    {A : Type*} [CommRing A] {l o : Type*} (U : Matrix l o A)
    (j : l) (k : o) (hjk : U j k = 1) : minorIdeal U 1 = ⊤ := by
  rw [Ideal.eq_top_iff_one]
  apply Ideal.subset_span
  refine ⟨(fun _ : Fin 1 => j), (fun _ : Fin 1 => k), ?_⟩
  simpa [Matrix.det_fin_one] using hjk.symm

private theorem minorIdeal_one_eq_span_singleton_of_entries
    {A : Type*} [CommRing A] {l o : Type*} (U : Matrix l o A)
    (f : A) (j : l) (k : o) (h : ∀ x y, U x y = f) :
    minorIdeal U 1 = Ideal.span {f} := by
  apply le_antisymm
  · rw [minorIdeal, Ideal.span_le]
    rintro x ⟨ri, ci, rfl⟩
    simp only [Matrix.det_fin_one, Matrix.submatrix_apply, h]
    exact Ideal.subset_span (by simp)
  · rw [Ideal.span_le]
    rintro _ rfl
    apply Ideal.subset_span
    refine ⟨(fun _ : Fin 1 => j), (fun _ : Fin 1 => k), ?_⟩
    simpa [Matrix.det_fin_one] using (h j k).symm

private theorem minorIdeal_single_entry
    {A : Type*} [CommRing A] (f : A) :
    minorIdeal (Matrix.of fun (_ _ : Fin 1) => f) 1 = Ideal.span {f} := by
  rw [minorIdeal_one_column]
  congr 1
  ext x
  simp

private theorem minorIdeal_fromBlocks_single_entry
    {A : Type*} [CommRing A] {l : Type*} [Fintype l]
    (r : ℕ) (T : Matrix l (Fin r) A) (f : A) :
    minorIdeal (Matrix.fromBlocks T 0 0 (Matrix.of fun (_ _ : Fin 1) => f)) (r + 1) =
      Ideal.span {f} * minorIdeal T r := by
  rw [minorIdeal_fromBlocks_one_column, minorIdeal_single_entry, mul_comm]

private theorem minorIdeal_fromBlocks_unit_column
    {A : Type*} [CommRing A] {l₁ l₂ : Type*} [Fintype l₁] [Fintype l₂]
    (r : ℕ) (T : Matrix l₁ (Fin r) A) (U : Matrix l₂ (Fin 1) A)
    (j : l₂) (hj : U j 0 = 1) :
    minorIdeal (Matrix.fromBlocks T 0 0 U) (r + 1) = minorIdeal T r := by
  rw [minorIdeal_fromBlocks_one_column,
    minorIdeal_one_eq_top_of_entry_one U j 0 hj, Ideal.mul_top]

private theorem minorIdeal_transpose
    {A : Type*} [CommRing A] {l o : Type*}
    (T : Matrix l o A) (r : ℕ) :
    minorIdeal T.transpose r = minorIdeal T r := by
  apply le_antisymm
  · rw [minorIdeal, Ideal.span_le]
    rintro x ⟨ri, ci, rfl⟩
    apply Ideal.subset_span
    refine ⟨ci, ri, ?_⟩
    rw [show T.transpose.submatrix ri ci = (T.submatrix ci ri).transpose from rfl,
      Matrix.det_transpose]
  · rw [minorIdeal, Ideal.span_le]
    rintro x ⟨ri, ci, rfl⟩
    apply Ideal.subset_span
    refine ⟨ci, ri, ?_⟩
    rw [show T.transpose.submatrix ci ri = (T.submatrix ri ci).transpose from rfl,
      Matrix.det_transpose]

private theorem minorIdeal_mul_right_le
    {A : Type*} [CommRing A] {l o : Type*} [Fintype o]
    (T : Matrix l o A) (C : Matrix o o A) (r : ℕ) :
    minorIdeal (T * C) r ≤ minorIdeal T r := by
  rw [← minorIdeal_transpose (T * C) r, ← minorIdeal_transpose T r]
  simpa only [Matrix.transpose_mul] using minorIdeal_mul_le C.transpose T.transpose r

/-- Reindexing the rows and the columns of a matrix along bijections does not change its ideal
of `r × r` minors. -/
theorem minorIdeal_reindex
    {A : Type*} [CommRing A] {l o l' o' : Type*}
    (T : Matrix l o A) (e : l ≃ l') (e' : o ≃ o') (r : ℕ) :
    minorIdeal (T.reindex e e') r = minorIdeal T r := by
  apply le_antisymm
  · rw [minorIdeal, Ideal.span_le]
    rintro x ⟨ri, ci, rfl⟩
    exact Ideal.subset_span ⟨e.symm ∘ ri, e'.symm ∘ ci, rfl⟩
  · rw [minorIdeal, Ideal.span_le]
    rintro x ⟨ri, ci, rfl⟩
    exact Ideal.subset_span ⟨e ∘ ri, e' ∘ ci, by simp [Matrix.submatrix, Matrix.reindex]⟩

private theorem minorIdeal_mul_eq_of_left_inverse
    {A : Type*} [CommRing A] {l o : Type*} [Fintype l] [DecidableEq l]
    (U V : Matrix l l A) (T : Matrix l o A) (r : ℕ) (hVU : V * U = 1) :
    minorIdeal (U * T) r = minorIdeal T r := by
  refine le_antisymm (minorIdeal_mul_le U T r) ?_
  convert minorIdeal_mul_le V (U * T) r using 1
  rw [← Matrix.mul_assoc, hVU, Matrix.one_mul]

private theorem minorIdeal_mul_eq_of_right_inverse
    {A : Type*} [CommRing A] {l o : Type*} [Fintype o] [DecidableEq o]
    (T : Matrix l o A) (U V : Matrix o o A) (r : ℕ) (hUV : U * V = 1) :
    minorIdeal (T * U) r = minorIdeal T r := by
  refine le_antisymm (minorIdeal_mul_right_le T U r) ?_
  convert minorIdeal_mul_right_le (T * U) V r using 1
  rw [Matrix.mul_assoc, hUV, Matrix.mul_one]

private theorem map_pow_mul_idealI
    {A B : Type*} [CommRing A] [CommRing B] (φ : A →+* B)
    (C : BoundedComplex A) (f : A) (i : ℤ) (m : ℕ) :
    Ideal.map φ (Ideal.span {f ^ m} * idealI C f i) =
      Ideal.span {(φ f) ^ m} * idealI (C.baseChange φ) (φ f) i := by
  rw [Ideal.map_mul, Ideal.map_span, map_idealI_eq_idealI_baseChange]
  simp only [Set.image_singleton, map_pow]

private theorem tailEulerCharacteristic_baseChange
    {A B : Type*} [CommRing A] [CommRing B] (φ : A →+* B)
    (C : BoundedComplex A) (i : ℤ) :
    (C.baseChange φ).tailEulerCharacteristic i = C.tailEulerCharacteristic i := rfl

private def sumRowsInterchange {a b c d : Type*} :
    ((a ⊕ c) ⊕ (b ⊕ d)) ≃ ((a ⊕ b) ⊕ (c ⊕ d)) where
  toFun
    | .inl (.inl x) => .inl (.inl x)
    | .inl (.inr x) => .inr (.inl x)
    | .inr (.inl x) => .inl (.inr x)
    | .inr (.inr x) => .inr (.inr x)
  invFun
    | .inl (.inl x) => .inl (.inl x)
    | .inl (.inr x) => .inr (.inl x)
    | .inr (.inl x) => .inl (.inr x)
    | .inr (.inr x) => .inr (.inr x)
  left_inv := by rintro ((_ | _) | (_ | _)) <;> rfl
  right_inv := by rintro ((_ | _) | (_ | _)) <;> rfl

private def mapMatrixGeneral {A : Type*} [CommRing A] {l m : Type*}
    [DecidableEq l] (f : A) (D : Matrix m l A) : Matrix (l ⊕ m) l A :=
  Matrix.fromRows (f • (1 : Matrix l l A)) D

private theorem mapMatrixGeneral_fromBlocks {A : Type*} [CommRing A]
    {a b c d : Type*} [DecidableEq a] [DecidableEq c]
    (f : A) (D : Matrix b a A) (E : Matrix d c A) :
    (mapMatrixGeneral f (Matrix.fromBlocks D 0 0 E)).submatrix
      (sumRowsInterchange (a := a) (b := b) (c := c) (d := d)).symm id =
      Matrix.fromBlocks (mapMatrixGeneral f D) 0 0 (mapMatrixGeneral f E) := by
  ext row col
  rcases row with ⟨⟨i⟩ | ⟨i⟩⟩ | ⟨⟨i⟩ | ⟨i⟩⟩ <;>
    rcases col with ⟨j⟩ | ⟨j⟩ <;>
    simp [mapMatrixGeneral, Matrix.submatrix, sumRowsInterchange,
      Matrix.fromRows_apply_inl, Matrix.fromRows_apply_inr,
      Matrix.fromBlocks_apply₁₁, Matrix.fromBlocks_apply₁₂,
      Matrix.fromBlocks_apply₂₁, Matrix.fromBlocks_apply₂₂,
      Matrix.one_apply, Matrix.smul_apply]

private theorem minorIdeal_mapMatrixGeneral_fromBlocks_maximal
    {A : Type*} [CommRing A] {b d : Type*} [Fintype b] [Fintype d]
    (f : A) (r s : ℕ) (D : Matrix b (Fin r) A) (E : Matrix d (Fin s) A) :
    minorIdeal (mapMatrixGeneral f (Matrix.fromBlocks D 0 0 E)) (r + s) =
      minorIdeal (mapMatrixGeneral f D) r *
        minorIdeal (mapMatrixGeneral f E) s := by
  classical
  let e := sumRowsInterchange (a := Fin r) (b := b) (c := Fin s) (d := d)
  calc
    minorIdeal (mapMatrixGeneral f (Matrix.fromBlocks D 0 0 E)) (r + s) =
        minorIdeal ((mapMatrixGeneral f (Matrix.fromBlocks D 0 0 E)).reindex
          e (Equiv.refl _)) (r + s) :=
      (minorIdeal_reindex _ e (Equiv.refl _) _).symm
    _ = minorIdeal (Matrix.fromBlocks (mapMatrixGeneral f D) 0 0
          (mapMatrixGeneral f E)) (r + s) := by
      rw [Matrix.reindex_apply]
      exact congrArg (fun T => minorIdeal T (r + s))
        (mapMatrixGeneral_fromBlocks f D E)
    _ = _ := minorIdeal_fromBlocks_maximal r s _ _

private theorem minorIdeal_mapMatrixGeneral_fromBlocks_one_column
    {A : Type*} [CommRing A] {b d : Type*} [Fintype b] [Fintype d]
    (f : A) (r : ℕ) (D : Matrix b (Fin r) A) (E : Matrix d (Fin 1) A) :
    minorIdeal (mapMatrixGeneral f (Matrix.fromBlocks D 0 0 E)) (r + 1) =
      minorIdeal (mapMatrixGeneral f D) r *
        minorIdeal (mapMatrixGeneral f E) 1 :=
  minorIdeal_mapMatrixGeneral_fromBlocks_maximal f r 1 D E

private theorem minorIdeal_mapMatrixGeneral_zero_one_column
    {A : Type*} [CommRing A] (f : A) :
    minorIdeal (mapMatrixGeneral f (0 : Matrix (Fin 0) (Fin 1) A)) 1 =
      Ideal.span {f} := by
  rw [minorIdeal_one_column]
  congr 1
  ext x
  simp [mapMatrixGeneral, Matrix.fromRows_apply_inl, eq_comm]

private theorem minorIdeal_mapMatrixGeneral_unit_one_column
    {A : Type*} [CommRing A] (f : A) :
    minorIdeal (mapMatrixGeneral f (1 : Matrix (Fin 1) (Fin 1) A)) 1 = ⊤ := by
  apply minorIdeal_one_eq_top_of_entry_one _ (Sum.inr 0) 0
  simp [mapMatrixGeneral]

private theorem minorIdeal_mapMatrixGeneral_fromBlocks_zero_one_column
    {A : Type*} [CommRing A] {b : Type*} [Fintype b]
    (f : A) (r : ℕ) (D : Matrix b (Fin r) A) :
    minorIdeal (mapMatrixGeneral f (Matrix.fromBlocks D 0 0
      (0 : Matrix (Fin 0) (Fin 1) A))) (r + 1) =
      Ideal.span {f} * minorIdeal (mapMatrixGeneral f D) r := by
  rw [minorIdeal_mapMatrixGeneral_fromBlocks_one_column,
    minorIdeal_mapMatrixGeneral_zero_one_column, mul_comm]

private theorem minorIdeal_mapMatrixGeneral_fromBlocks_unit_one_column
    {A : Type*} [CommRing A] {b : Type*} [Fintype b]
    (f : A) (r : ℕ) (D : Matrix b (Fin r) A) :
    minorIdeal (mapMatrixGeneral f (Matrix.fromBlocks D 0 0
      (1 : Matrix (Fin 1) (Fin 1) A))) (r + 1) =
      minorIdeal (mapMatrixGeneral f D) r := by
  rw [minorIdeal_mapMatrixGeneral_fromBlocks_one_column,
    minorIdeal_mapMatrixGeneral_unit_one_column, Ideal.mul_top]

private theorem mapMatrixGeneral_fin
    {A : Type*} [CommRing A] {r s : ℕ}
    (f : A) (D : Matrix (Fin s) (Fin r) A) :
    mapMatrixGeneral f D = mapMatrix f D := by
  ext row col
  cases row with
  | inl j => rfl
  | inr j => rfl

private theorem mapMatrixGeneral_reindex {A : Type*} [CommRing A]
    {l m l' m' : Type*} [DecidableEq l] [DecidableEq l']
    (f : A) (D : Matrix m l A) (eL : l ≃ l') (eM : m ≃ m') :
    mapMatrixGeneral f (D.reindex eM eL) =
      (mapMatrixGeneral f D).reindex (Equiv.sumCongr eL eM) eL := by
  ext row col
  cases row with
  | inl j =>
      simp [mapMatrixGeneral, Matrix.reindex_apply, Matrix.submatrix,
        Matrix.fromRows_apply_inl, Matrix.smul_apply, Matrix.one_apply]
  | inr j =>
      simp [mapMatrixGeneral, Matrix.reindex_apply, Matrix.submatrix,
        Matrix.fromRows_apply_inr]

private theorem minorIdeal_mapMatrix_fromBlocks_maximal
    {A : Type*} [CommRing A] (f : A) (r s t u : ℕ)
    (D : Matrix (Fin t) (Fin r) A) (E : Matrix (Fin u) (Fin s) A) :
    minorIdeal (mapMatrix f ((Matrix.fromBlocks D 0 0 E).reindex
      (finSumFinEquiv (m := t) (n := u)) (finSumFinEquiv (m := r) (n := s))))
      (r + s) =
      minorIdeal (mapMatrix f D) r * minorIdeal (mapMatrix f E) s := by
  classical
  rw [← mapMatrixGeneral_fin,
    mapMatrixGeneral_reindex,
    minorIdeal_reindex,
    minorIdeal_mapMatrixGeneral_fromBlocks_maximal,
    mapMatrixGeneral_fin, mapMatrixGeneral_fin]

private theorem minorIdeal_mapMatrix_fromBlocks_one_column
    {A : Type*} [CommRing A] (f : A) (r s t : ℕ)
    (D : Matrix (Fin s) (Fin r) A) (E : Matrix (Fin t) (Fin 1) A) :
    minorIdeal (mapMatrix f ((Matrix.fromBlocks D 0 0 E).reindex
      (finSumFinEquiv (m := s) (n := t)) (finSumFinEquiv (m := r) (n := 1))))
      (r + 1) =
      minorIdeal (mapMatrix f D) r * minorIdeal (mapMatrix f E) 1 :=
  minorIdeal_mapMatrix_fromBlocks_maximal f r 1 s t D E

private theorem minorIdeal_mapMatrix_fromBlocks_zero_one_column
    {A : Type*} [CommRing A] (f : A) (r s : ℕ)
    (D : Matrix (Fin s) (Fin r) A) :
    minorIdeal (mapMatrix f ((Matrix.fromBlocks D 0 0
      (0 : Matrix (Fin 0) (Fin 1) A)).reindex
      (finSumFinEquiv (m := s) (n := 0)) (finSumFinEquiv (m := r) (n := 1))))
      (r + 1) =
      Ideal.span {f} * minorIdeal (mapMatrix f D) r := by
  have hE : minorIdeal (mapMatrix f (0 : Matrix (Fin 0) (Fin 1) A)) 1 =
      Ideal.span {f} := by
    rw [← mapMatrixGeneral_fin]
    exact minorIdeal_mapMatrixGeneral_zero_one_column f
  rw [minorIdeal_mapMatrix_fromBlocks_one_column, hE, mul_comm]

private theorem minorIdeal_mapMatrix_fromBlocks_unit_one_column
    {A : Type*} [CommRing A] (f : A) (r s : ℕ)
    (D : Matrix (Fin s) (Fin r) A) :
    minorIdeal (mapMatrix f ((Matrix.fromBlocks D 0 0
      (1 : Matrix (Fin 1) (Fin 1) A)).reindex
      (finSumFinEquiv (m := s) (n := 1)) (finSumFinEquiv (m := r) (n := 1))))
      (r + 1) =
      minorIdeal (mapMatrix f D) r := by
  have hE : minorIdeal (mapMatrix f (1 : Matrix (Fin 1) (Fin 1) A)) 1 = ⊤ := by
    rw [← mapMatrixGeneral_fin]
    exact minorIdeal_mapMatrixGeneral_unit_one_column f
  rw [minorIdeal_mapMatrix_fromBlocks_one_column, hE, Ideal.mul_top]

private theorem pow_mul_ideal_of_mul_f
    {A : Type*} [CommRing A] (f : A) (I : Ideal A) (n : ℕ) :
    Ideal.span {f ^ (n + 1)} * I =
      Ideal.span {f ^ n} * (Ideal.span {f} * I) := by
  rw [← mul_assoc, Ideal.span_singleton_mul_span_singleton, pow_succ]

/-- The direct sum `M^• ⊕ N^•` of two bounded complexes of finite free modules: its rank in
degree `i` is `rank Mⁱ + rank Nⁱ` and its differentials are the block diagonal matrices
`diag(d_M^i, d_N^i)`, reindexed along `Fin a ⊕ Fin b ≃ Fin (a + b)`. -/
noncomputable def boundedComplexDirectSum {A : Type*} [CommRing A]
    (M N : BoundedComplex A) : BoundedComplex A where
  rank i := M.rank i + N.rank i
  d i := (Matrix.fromBlocks (M.d i) 0 0 (N.d i)).reindex
    (finSumFinEquiv (m := M.rank (i + 1)) (n := N.rank (i + 1)))
    (finSumFinEquiv (m := M.rank i) (n := N.rank i))
  dd := by
    intro i
    simp only [Matrix.reindex_apply]
    rw [Matrix.submatrix_mul_equiv]
    simp [Matrix.fromBlocks_multiply, M.dd, N.dd]
  bounded := by
    apply (M.bounded.union N.bounded).subset
    intro i hi
    by_contra hnot
    simp only [Set.mem_union, Set.mem_ofPred_eq, not_or] at hnot
    simp only [not_ne_iff] at hnot
    change M.rank i + N.rank i ≠ 0 at hi
    exact hi (by simp [hnot.1, hnot.2])

/-- `I_i(C, f)` is the ideal of `k × k` minors of the matrix `(f, dⁱ)`, where `k = rank Cⁱ`. -/
private theorem idealI_eq_minorIdeal
    {A : Type*} [CommRing A] (C : BoundedComplex A) (f : A) (i : ℤ) (k : ℕ)
    (hk : C.rank i = k) :
    idealI C f i = minorIdeal (mapMatrix f (C.d i)) k :=
  (minorIdealInjective_eq_minorIdeal _ _).trans (congrArg _ hk)

private theorem idealI_boundedComplexDirectSum
    {A : Type*} [CommRing A] (M N : BoundedComplex A) (f : A) (i : ℤ) :
    idealI (boundedComplexDirectSum M N) f i =
      idealI M f i * idealI N f i := by
  classical
  simp only [idealI_eq_minorIdeal _ f i _ rfl, boundedComplexDirectSum]
  exact minorIdeal_mapMatrix_fromBlocks_maximal f
    (M.rank i) (N.rank i) (M.rank (i + 1)) (N.rank (i + 1)) (M.d i) (N.d i)

/-- The trivial two-term complex `A → A` with identity differential, placed in degrees `j` and
`j + 1`. -/
noncomputable def trivialBoundedComplex {A : Type*} [CommRing A]
    (j : ℤ) : BoundedComplex A where
  rank i := if i = j ∨ i = j + 1 then 1 else 0
  d i := if i = j then Matrix.of (fun _ _ => (1 : A)) else 0
  dd := by
    intro i
    by_cases h : i = j <;> simp [h]
  bounded := by
    classical
    apply ((Set.finite_singleton (j + 1)).insert j).subset
    intro i hi
    change (if i = j ∨ i = j + 1 then 1 else 0) ≠ 0 at hi
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
    by_contra hnot
    simp only [not_or] at hnot
    exact hi (by simp [hnot.1, hnot.2])

private theorem idealI_eq_top_of_rank_zero
    {A : Type*} [CommRing A] (C : BoundedComplex A) (f : A) (i : ℤ)
    (h : C.rank i = 0) : idealI C f i = ⊤ := by
  rw [idealI_eq_minorIdeal C f i 0 h, minorIdeal_zero]

private theorem idealI_trivialBoundedComplex_at_first
    {A : Type*} [CommRing A] (f : A) (j : ℤ) :
    idealI (trivialBoundedComplex (A := A) j) f j = ⊤ := by
  let Q := trivialBoundedComplex (A := A) j
  have hr : Q.rank j = 1 := by simp [Q, trivialBoundedComplex]
  let u : Fin (Q.rank (j + 1)) := ⟨0, by simp [Q, trivialBoundedComplex]⟩
  let v : Fin (Q.rank j) := ⟨0, by simp [Q, trivialBoundedComplex]⟩
  have hEntry : mapMatrix f (Q.d j) (Sum.inr u) v = 1 := by
    change (Q.d j) u v = 1
    simp [Q, trivialBoundedComplex]
    rfl
  rw [idealI_eq_minorIdeal _ f j 1 hr]
  exact minorIdeal_one_eq_top_of_entry_one _ (Sum.inr u) v hEntry

private theorem idealI_trivialBoundedComplex_at_second
    {A : Type*} [CommRing A] (f : A) (j : ℤ) :
    idealI (trivialBoundedComplex (A := A) j) f (j + 1) = Ideal.span {f} := by
  let Q := trivialBoundedComplex (A := A) j
  have hr : Q.rank (j + 1) = 1 := by simp [Q, trivialBoundedComplex]
  have hs : Q.rank (j + 1 + 1) = 0 := by
    simp [Q, trivialBoundedComplex, show j + 1 + 1 ≠ j by omega]
  let v : Fin (Q.rank (j + 1)) := ⟨0, by simp [hr]⟩
  have hEntry : ∀ x y, mapMatrix f (Q.d (j + 1)) x y = f := by
    intro x y
    cases x with
    | inl x =>
      have heq : x = y := Fin.ext (by have := x.isLt; have := y.isLt; omega)
      subst y
      simp [mapMatrix, Matrix.one_apply]
    | inr x => have := x.isLt; omega
  rw [idealI_eq_minorIdeal _ f (j + 1) 1 hr]
  exact minorIdeal_one_eq_span_singleton_of_entries _ f (.inl v) v hEntry

private theorem tailEulerCharacteristic_eq_sum
    {A : Type*} [CommRing A] (C : BoundedComplex A) (i : ℤ) (s : Finset ℤ)
    (hs : ∀ j, C.rank j ≠ 0 → j ∈ s) :
    C.tailEulerCharacteristic i =
      ∑ j ∈ s, if i ≤ j then (-1 : ℤ) ^ (j - i).toNat * C.rank j else 0 := by
  classical
  rw [BoundedComplex.tailEulerCharacteristic, Finset.sum_filter]
  apply Finset.sum_subset
  · exact fun j hj => hs j (C.bounded.mem_toFinset.mp hj)
  · intro j hj hnot
    simp [show C.rank j = 0 by simpa using hnot]

/-- The tail Euler characteristic is additive in direct sums of bounded complexes. -/
theorem tailEulerCharacteristic_directSum
    {A : Type*} [CommRing A] (M N : BoundedComplex A) (i : ℤ) :
    (boundedComplexDirectSum M N).tailEulerCharacteristic i =
      M.tailEulerCharacteristic i + N.tailEulerCharacteristic i := by
  classical
  let s := M.bounded.toFinset ∪ N.bounded.toFinset
  have hM : ∀ j, M.rank j ≠ 0 → j ∈ s := fun j hj =>
    Finset.mem_union_left _ (M.bounded.mem_toFinset.mpr hj)
  have hN : ∀ j, N.rank j ≠ 0 → j ∈ s := fun j hj =>
    Finset.mem_union_right _ (N.bounded.mem_toFinset.mpr hj)
  have hMN : ∀ j, (boundedComplexDirectSum M N).rank j ≠ 0 → j ∈ s := by
    intro j hj
    by_cases h : M.rank j = 0
    · exact hN j (by simpa [boundedComplexDirectSum, h] using hj)
    · exact hM j h
  rw [tailEulerCharacteristic_eq_sum _ i s hMN,
    tailEulerCharacteristic_eq_sum _ i s hM, tailEulerCharacteristic_eq_sum _ i s hN,
    ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro j hj
  by_cases hij : i ≤ j <;> simp [boundedComplexDirectSum, mul_add, hij]

/-- The tail Euler characteristic `∑_{k ≥ i} (-1)^(k-i) rank` of the trivial two-term complex
in degrees `j, j + 1` is `1` when `i = j + 1` and `0` otherwise. -/
theorem tailEulerCharacteristic_trivialBoundedComplex
    {A : Type*} [CommRing A] (j i : ℤ) :
    (trivialBoundedComplex (A := A) j).tailEulerCharacteristic i =
      if i = j + 1 then 1 else 0 := by
  classical
  rw [tailEulerCharacteristic_eq_sum _ i {j, j + 1} (by
    intro k hk
    by_contra hn
    exact hk (by simpa [trivialBoundedComplex] using hn))]
  have hne : j ≠ j + 1 := by omega
  rw [Finset.sum_insert (by simp [hne]), Finset.sum_singleton]
  simp only [trivialBoundedComplex, true_or, or_true, ite_true, Nat.cast_one, mul_one]
  by_cases hi : i ≤ j
  · have hi' : i ≤ j + 1 := by omega
    have he : (j + 1 - i).toNat = (j - i).toNat + 1 := by omega
    simp [hi, hi', he, pow_succ, show i ≠ j + 1 by omega]
  · by_cases hi' : i = j + 1
    · simp [hi']
    · simp [hi, hi', show ¬i ≤ j + 1 by omega]

private theorem idealI_trivialBoundedComplex
    {A : Type*} [CommRing A] (f : A) (j i : ℤ) :
    idealI (trivialBoundedComplex (A := A) j) f i =
      Ideal.span {f ^ (if i = j + 1 then 1 else 0 : ℕ)} := by
  classical
  by_cases hi : i = j + 1
  · subst i
    simpa using idealI_trivialBoundedComplex_at_second f j
  · by_cases hij : i = j
    · subst i
      simp [idealI_trivialBoundedComplex_at_first, hi]
    · rw [idealI_eq_top_of_rank_zero _ f i (by simp [trivialBoundedComplex, hi, hij])]
      simp [hi]

private theorem minorIdeal_mapMatrixGeneral_conjugate
    {A : Type*} [CommRing A] {l m : Type*} [Fintype l] [Fintype m]
    [DecidableEq l] [DecidableEq m]
    (f : A) (D : Matrix m l A) (U U' : Matrix l l A) (V V' : Matrix m m A)
    (hU : U * U' = 1) (hV : V' * V = 1) (r : ℕ) :
    minorIdeal (mapMatrixGeneral f (V * D * U)) r =
      minorIdeal (mapMatrixGeneral f D) r := by
  let L := Matrix.fromBlocks U' 0 0 V
  let L' := Matrix.fromBlocks U 0 0 V'
  have hL : L' * L = 1 := by
    simp [L, L', Matrix.fromBlocks_multiply, hU, hV, Matrix.fromBlocks_one]
  have hT : mapMatrixGeneral f (V * D * U) = L * mapMatrixGeneral f D * U := by
    simp only [mapMatrixGeneral, L, Matrix.fromBlocks_mul_fromRows,
      Matrix.zero_mul, add_zero, zero_add, Matrix.fromRows_mul]
    congr 1
    rw [Matrix.mul_smul, Matrix.smul_mul, Matrix.mul_one]
    have hU' : U' * U = 1 := (mul_eq_one_comm).mp hU
    rw [hU']
  rw [hT, minorIdeal_mul_eq_of_right_inverse _ U U' r hU,
    minorIdeal_mul_eq_of_left_inverse L L' _ r hL]

private theorem minorIdeal_mapMatrix_eq_of_linearEquiv
    {A : Type*} [CommRing A] [Nontrivial A] {r s r' s' : ℕ}
    (f : A) (D : Matrix (Fin s) (Fin r) A) (E : Matrix (Fin s') (Fin r') A)
    (e : (Fin r → A) ≃ₗ[A] (Fin r' → A))
    (e' : (Fin s → A) ≃ₗ[A] (Fin s' → A))
    (h : e'.toLinearMap.comp D.mulVecLin = E.mulVecLin.comp e.toLinearMap) :
    minorIdeal (mapMatrix f D) r = minorIdeal (mapMatrix f E) r' := by
  obtain rfl : r = r' := eq_of_fin_equiv A e
  obtain rfl : s = s' := eq_of_fin_equiv A e'
  let U := LinearMap.toMatrix' e.symm.toLinearMap
  let U' := LinearMap.toMatrix' e.toLinearMap
  let V := LinearMap.toMatrix' e'.toLinearMap
  let V' := LinearMap.toMatrix' e'.symm.toLinearMap
  have hU : U * U' = 1 := by
    simp [U, U', ← LinearMap.toMatrix'_comp]
  have hV : V' * V = 1 := by
    simp [V, V', ← LinearMap.toMatrix'_comp]
  have hE : V * D * U = E := by
    have hD : LinearMap.toMatrix' D.mulVecLin = D := LinearMap.toMatrix'_toLin' D
    have hE : LinearMap.toMatrix' E.mulVecLin = E := LinearMap.toMatrix'_toLin' E
    have hc : V * D = E * U' := by
      simpa only [LinearMap.toMatrix'_comp, hD, hE] using
        congrArg LinearMap.toMatrix' h
    rw [hc, Matrix.mul_assoc, (mul_eq_one_comm).mp hU, Matrix.mul_one]
  rw [← hE, ← mapMatrixGeneral_fin, ← mapMatrixGeneral_fin]
  exact (minorIdeal_mapMatrixGeneral_conjugate f D U U' V V' hU hV r).symm

open CategoryTheory in
private theorem rank_eq_of_iso {A : Type*} [CommRing A] [Nontrivial A]
    (M N : BoundedComplex A) (e : M.toCochainComplex ≅ N.toCochainComplex) (i : ℤ) :
    M.rank i = N.rank i :=
  eq_of_fin_equiv A (HomologicalComplex.Hom.isoApp e i).toLinearEquiv

open CategoryTheory in
set_option backward.isDefEq.respectTransparency false in
private theorem idealI_eq_of_iso {A : Type*} [CommRing A]
    (M N : BoundedComplex A) (e : M.toCochainComplex ≅ N.toCochainComplex)
    (f : A) (i : ℤ) : idealI M f i = idealI N f i := by
  nontriviality A
  rw [idealI_eq_minorIdeal _ f i _ rfl, idealI_eq_minorIdeal _ f i _ rfl]
  apply minorIdeal_mapMatrix_eq_of_linearEquiv f (M.d i) (N.d i)
    (HomologicalComplex.Hom.isoApp e i).toLinearEquiv
    (HomologicalComplex.Hom.isoApp e (i + 1)).toLinearEquiv
  have h := e.hom.comm i (i + 1)
  simpa only [BoundedComplex.toCochainComplex_d, ModuleCat.hom_comp,
    ModuleCat.hom_ofHom, CategoryTheory.Iso.toLinearMap_toLinearEquiv,
    HomologicalComplex.Hom.isoApp_hom] using congrArg ModuleCat.Hom.hom h.symm

open CategoryTheory in
/-- Bounded complexes of finite free modules over a nontrivial ring whose cochain complexes are
isomorphic have the same tail Euler characteristics: the ranks agree degreewise. -/
theorem tailEulerCharacteristic_eq_of_iso
    {A : Type*} [CommRing A] [Nontrivial A]
    (M N : BoundedComplex A) (e : M.toCochainComplex ≅ N.toCochainComplex) (i : ℤ) :
    M.tailEulerCharacteristic i = N.tailEulerCharacteristic i := by
  have h : M.rank = N.rank := funext (rank_eq_of_iso M N e)
  simp only [BoundedComplex.tailEulerCharacteristic, h]

open CategoryTheory CategoryTheory.Limits
open scoped Matrix TensorProduct

private noncomputable def directSumTermEquiv {A : Type*} [CommRing A]
    (M N : BoundedComplex A) (i : ℤ) :
    (Fin ((boundedComplexDirectSum M N).rank i) → A) ≃ₗ[A]
      ((Fin (M.rank i) → A) × (Fin (N.rank i) → A)) :=
  (LinearEquiv.funCongrLeft A A finSumFinEquiv).trans
    (LinearEquiv.sumArrowLequivProdArrow _ _ A A)

set_option backward.isDefEq.respectTransparency false in
private theorem directSumTermEquiv_d {A : Type*} [CommRing A]
    (M N : BoundedComplex A) (i : ℤ)
    (x : Fin ((boundedComplexDirectSum M N).rank i) → A) :
    directSumTermEquiv M N (i + 1) ((boundedComplexDirectSum M N).d i *ᵥ x) =
      ((M.d i *ᵥ (directSumTermEquiv M N i x).1),
        (N.d i *ᵥ (directSumTermEquiv M N i x).2)) := by
  change ((fun k => ((boundedComplexDirectSum M N).d i *ᵥ x)
      (finSumFinEquiv (.inl k))),
    (fun k => ((boundedComplexDirectSum M N).d i *ᵥ x)
      (finSumFinEquiv (.inr k)))) = _
  simp only [boundedComplexDirectSum, Matrix.reindex_apply,
    Matrix.submatrix_mulVec_equiv]
  ext k <;> simp only [Function.comp_apply,
    Equiv.symm_apply_apply, Matrix.fromBlocks_mulVec, Matrix.zero_mulVec, add_zero, zero_add,
    Sum.elim_inl, Sum.elim_inr]
  · rfl
  · rfl

private theorem biprodXIso_inv_fst {A : Type*} [CommRing A]
    (M N : CochainComplex (ModuleCat A) ℤ) (i : ℤ) :
    (HomologicalComplex.biprodXIso M N i).inv ≫ (biprod.fst : M ⊞ N ⟶ M).f i =
      biprod.fst := by
  rw [Iso.inv_comp_eq]
  exact (HomologicalComplex.biprodXIso_hom_fst M N i).symm

private theorem biprodXIso_inv_snd {A : Type*} [CommRing A]
    (M N : CochainComplex (ModuleCat A) ℤ) (i : ℤ) :
    (HomologicalComplex.biprodXIso M N i).inv ≫ (biprod.snd : M ⊞ N ⟶ N).f i =
      biprod.snd := by
  rw [Iso.inv_comp_eq]
  exact (HomologicalComplex.biprodXIso_hom_snd M N i).symm

set_option backward.isDefEq.respectTransparency false in
/-- The cochain complex of the direct sum of two bounded matrix complexes is the biproduct of
their cochain complexes. -/
@[no_expose]
noncomputable def directSumCochainIso {A : Type*} [CommRing A]
    (M N : BoundedComplex A) :
    (boundedComplexDirectSum M N).toCochainComplex ≅
      M.toCochainComplex ⊞ N.toCochainComplex := by
  refine HomologicalComplex.Hom.isoOfComponents (fun i =>
    (directSumTermEquiv M N i).toModuleIso ≪≫
      (ModuleCat.biprodIsoProd (M.toCochainComplex.X i) (N.toCochainComplex.X i)).symm ≪≫
      (HomologicalComplex.biprodXIso _ _ i).symm) ?_
  intro i j hij
  obtain rfl : j = i + 1 := hij.symm
  apply HomologicalComplex.biprodX_ext_to
  · simp only [Category.assoc, ← HomologicalComplex.Hom.comm,
      Iso.trans_hom, Iso.symm_hom, biprodXIso_inv_fst,
      ModuleCat.biprodIsoProd_inv_comp_fst,
      reassoc_of% biprodXIso_inv_fst, reassoc_of% ModuleCat.biprodIsoProd_inv_comp_fst,
      BoundedComplex.toCochainComplex_d]
    ext x
    exact (congrArg Prod.fst (directSumTermEquiv_d M N i x)).symm
  · simp only [Category.assoc, ← HomologicalComplex.Hom.comm,
      Iso.trans_hom, Iso.symm_hom, biprodXIso_inv_snd,
      ModuleCat.biprodIsoProd_inv_comp_snd,
      reassoc_of% biprodXIso_inv_snd, reassoc_of% ModuleCat.biprodIsoProd_inv_comp_snd,
      BoundedComplex.toCochainComplex_d]
    ext x
    exact (congrArg Prod.snd (directSumTermEquiv_d M N i x)).symm

/-- A term of a bounded matrix complex of rank `0` is a zero module. -/
private theorem isZero_toCochainComplex_X_of_rank_eq_zero {A : Type*} [CommRing A]
    (M : BoundedComplex A) (i : ℤ) (hz : M.rank i = 0) : IsZero (M.toCochainComplex.X i) := by
  have : Subsingleton (M.toCochainComplex.X i) := by
    change Subsingleton (Fin (M.rank i) → A)
    rw [hz]
    infer_instance
  exact ModuleCat.isZero_of_subsingleton _

/-- The cochain complex of a bounded matrix complex is strictly bounded above and below. -/
theorem toCochainComplex_bounded {A : Type*} [CommRing A]
    (M : BoundedComplex A) :
    ∃ a b : ℤ, M.toCochainComplex.IsStrictlyGE a ∧ M.toCochainComplex.IsStrictlyLE b := by
  obtain ⟨a, ha⟩ := M.bounded.bddBelow
  obtain ⟨b, hb⟩ := M.bounded.bddAbove
  exact ⟨a, b, (M.toCochainComplex.isStrictlyGE_iff a).mpr fun i hi =>
      isZero_toCochainComplex_X_of_rank_eq_zero M i
        (Classical.byContradiction fun h => (not_le_of_gt hi) (ha h)),
    (M.toCochainComplex.isStrictlyLE_iff b).mpr fun i hi =>
      isZero_toCochainComplex_X_of_rank_eq_zero M i
        (Classical.byContradiction fun h => (not_le_of_gt hi) (hb h))⟩

/-- **The cochain complex of a bounded matrix complex is K-projective.**  It is strictly bounded
above by `Stacks.Eta.DeterminantalIdeal.toCochainComplex_bounded` and each of its terms is a
finite free, hence projective, `A`-module, so
`CochainComplex.isKProjective_of_projective` applies. -/
theorem isKProjective_toCochainComplex {A : Type*} [CommRing A] (M : BoundedComplex A) :
    M.toCochainComplex.IsKProjective := by
  obtain ⟨-, b, -, hb⟩ := toCochainComplex_bounded M
  have := hb
  have (i : ℤ) : CategoryTheory.Projective (M.toCochainComplex.X i) := by
    change CategoryTheory.Projective (ModuleCat.of A (Fin (M.rank i) → A))
    infer_instance
  exact CochainComplex.isKProjective_of_projective _ b

private theorem span_mul_cancel {A : Type*} [CommRing A] (a : A)
    (ha : Function.Injective (a * ·)) (I J : Ideal A) :
    Ideal.span {a} * I = Ideal.span {a} * J ↔ I = J := by
  have key {I J : Ideal A} (h : Ideal.span {a} * I = Ideal.span {a} * J) : I ≤ J := by
    intro x hx
    have : a * x ∈ Ideal.span {a} * I := Ideal.mem_span_singleton_mul.mpr ⟨x, hx, rfl⟩
    rw [h, Ideal.mem_span_singleton_mul] at this
    obtain ⟨y, hy, he⟩ := this
    exact (ha he) ▸ hy
  exact ⟨fun h => le_antisymm (key h) (key h.symm), congrArg (Ideal.span {a} * ·)⟩

/-- Extension of scalars along `φ : A →+* B` applied to the free module `A^r` is the free
module `B^r`: the `B`-basis obtained from the standard `A`-basis by base change gives the
coordinates. This is the term-by-term comparison underlying
`Stacks.Eta.DeterminantalIdeal.baseChangeCochainIso`. -/
noncomputable def baseChangeTermEquiv
    {A B : Type*} [CommRing A] [CommRing B] (φ : A →+* B) (r : ℕ) :
    ((ModuleCat.extendScalars φ).obj (ModuleCat.of A (Fin r → A))) ≃ₗ[B] (Fin r → B) :=
  letI := φ.toAlgebra
  ((Pi.basisFun A (Fin r)).baseChange B).equivFun

set_option backward.isDefEq.respectTransparency false in
/-- The comparison `Stacks.Eta.DeterminantalIdeal.baseChangeTermEquiv` on a pure tensor:
`b ⊗ x` has coordinates `k ↦ φ (x k) * b`. -/
theorem baseChangeTermEquiv_tmul
    {A B : Type*} [CommRing A] [CommRing B] (φ : A →+* B) (r : ℕ)
    (b : B) (x : Fin r → A) :
    letI := φ.toAlgebra
    baseChangeTermEquiv φ r (b ⊗ₜ[A] x) = fun k => φ (x k) * b := by
  let := φ.toAlgebra
  ext k
  change ((Pi.basisFun A (Fin r)).baseChange B).repr (b ⊗ₜ[A] x) k = _
  simp only [Module.Basis.baseChange_repr_tmul, Pi.basisFun_repr,
    Algebra.smul_def]
  rfl

set_option backward.isDefEq.respectTransparency false in
/-- Under `Stacks.Eta.DeterminantalIdeal.baseChangeTermEquiv`, extension of scalars of the
linear map with matrix `D` is the linear map with matrix `D.map φ`: the matrix of a base-changed
map is the entrywise image of the matrix. -/
theorem baseChangeTermEquiv_naturality
    {A B : Type*} [CommRing A] [CommRing B] (φ : A →+* B) {r s : ℕ}
    (D : Matrix (Fin s) (Fin r) A)
    (x : (ModuleCat.extendScalars φ).obj (ModuleCat.of A (Fin r → A))) :
    baseChangeTermEquiv φ s
        ((ModuleCat.extendScalars φ).map (ModuleCat.ofHom D.mulVecLin) x) =
      D.map φ *ᵥ baseChangeTermEquiv φ r x := by
  let := φ.toAlgebra
  induction x using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy => simp [map_add, Matrix.mulVec_add, hx, hy]
  | tmul b x =>
    rw [ModuleCat.ExtendScalars.map_tmul, baseChangeTermEquiv_tmul,
      baseChangeTermEquiv_tmul]
    ext k
    simp [Matrix.mulVec, dotProduct, map_sum, map_mul, Finset.sum_mul, mul_assoc]

universe u

set_option backward.isDefEq.respectTransparency false in
/-- **Base change of a bounded matrix complex realizes extension of scalars.** Extending the
scalars of the cochain complex of a bounded complex `M^•` of finite free `A`-modules along
`φ : A →+* B` gives the cochain complex of the base change `M^• ⊗_A B`, whose differentials are
the entrywise images under `φ` of the differentials of `M^•`. -/
noncomputable def baseChangeCochainIso
    {A B : Type u} [CommRing A] [CommRing B] (φ : A →+* B) (M : BoundedComplex A) :
    ((ModuleCat.extendScalars φ).mapHomologicalComplex (ComplexShape.up ℤ)).obj
      M.toCochainComplex ≅ (M.baseChange φ).toCochainComplex := by
  refine HomologicalComplex.Hom.isoOfComponents
    (fun i => (baseChangeTermEquiv φ (M.rank i)).toModuleIso) ?_
  intro i j hij
  obtain rfl : j = i + 1 := hij.symm
  ext x
  simp only [Functor.mapHomologicalComplex_obj_d, BoundedComplex.toCochainComplex_d,
    LinearEquiv.toModuleIso, ModuleCat.hom_comp, ModuleCat.hom_ofHom,
    LinearMap.comp_apply]
  convert! (baseChangeTermEquiv_naturality φ (M.d i) x).symm using 1

private theorem pow_mul_ideal_eq_of_pow_mul_eq
    {A : Type*} [CommRing A] (f : A) (hf : f ∈ nonZeroDivisors A)
    (I J : Ideal A) (m n p q : ℕ)
    (h : Ideal.span {f ^ p} * I = Ideal.span {f ^ q} * J)
    (he : m + q = n + p) :
    Ideal.span {f ^ m} * I = Ideal.span {f ^ n} * J := by
  apply (span_mul_cancel (f ^ p)
    (isRegular_iff_mem_nonZeroDivisors.mpr (pow_mem hf p)).left _ _).mp
  calc
    Ideal.span {f ^ p} * (Ideal.span {f ^ m} * I) =
        Ideal.span {f ^ m} * (Ideal.span {f ^ p} * I) := by ac_rfl
    _ = Ideal.span {f ^ m} * (Ideal.span {f ^ q} * J) := by rw [h]
    _ = Ideal.span {f ^ (m + q)} * J := by
      rw [← mul_assoc, Ideal.span_singleton_mul_span_singleton, ← pow_add]
    _ = Ideal.span {f ^ (n + p)} * J := by rw [he]
    _ = Ideal.span {f ^ p} * (Ideal.span {f ^ n} * J) := by
      rw [← mul_assoc, Ideal.span_singleton_mul_span_singleton, ← pow_add, Nat.add_comm p n]

private theorem pow_mul_idealI_eq_of_stabilized_iso
    {A : Type*} [CommRing A] [Nontrivial A]
    (f : A) (hf : f ∈ nonZeroDivisors A) (M N P Q : BoundedComplex A)
    (e : (boundedComplexDirectSum M P).toCochainComplex ≅
      (boundedComplexDirectSum N Q).toCochainComplex)
    (i : ℤ) (m n p q : ℕ)
    (hP : idealI P f i = Ideal.span {f ^ p})
    (hQ : idealI Q f i = Ideal.span {f ^ q})
    (heP : P.tailEulerCharacteristic i = p) (heQ : Q.tailEulerCharacteristic i = q)
    (he : (m : ℤ) + M.tailEulerCharacteristic i =
      (n : ℤ) + N.tailEulerCharacteristic i) :
    Ideal.span {f ^ m} * idealI M f i = Ideal.span {f ^ n} * idealI N f i := by
  have hI := idealI_eq_of_iso _ _ e f i
  rw [idealI_boundedComplexDirectSum, idealI_boundedComplexDirectSum, hP, hQ,
    mul_comm (idealI M f i), mul_comm (idealI N f i)] at hI
  have hE := tailEulerCharacteristic_eq_of_iso _ _ e i
  rw [tailEulerCharacteristic_directSum, tailEulerCharacteristic_directSum, heP, heQ] at hE
  exact pow_mul_ideal_eq_of_pow_mul_eq f hf _ _ m n p q hI (by omega)

/-- Two ideals are equal if every prime `p` admits `g ∉ p` such that their extensions to the
localization `A_g` agree. -/
theorem ideal_eq_of_away_eq {A : Type*} [CommRing A] (I J : Ideal A)
    (h : ∀ (p : Ideal A), p.IsPrime → ∃ g : A, g ∉ p ∧
      Ideal.map (algebraMap A (Localization.Away g)) I =
        Ideal.map (algebraMap A (Localization.Away g)) J) : I = J := by
  apply Ideal.eq_of_localization_maximal
  intro p hp
  let := hp
  obtain ⟨g, hg, he⟩ := h p hp.isPrime
  have hu : IsUnit (algebraMap A (Localization.AtPrime p) g) :=
    IsLocalization.map_units (M := p.primeCompl) (Localization.AtPrime p) ⟨g, hg⟩
  let φ : Localization.Away g →+* Localization.AtPrime p :=
    IsLocalization.Away.lift g hu
  have hc : φ.comp (algebraMap A (Localization.Away g)) =
      algebraMap A (Localization.AtPrime p) := IsLocalization.Away.lift_comp g hu
  have he' := congrArg (Ideal.map φ) he
  simpa only [Ideal.map_map, hc] using he'

private theorem pow_mul_idealI_eq_of_away_stabilized_iso
    {A : Type u} [CommRing A] (f : A) (hf : f ∈ nonZeroDivisors A)
    (M N : BoundedComplex A) (i : ℤ) (m n : ℕ)
    (he : (m : ℤ) + M.tailEulerCharacteristic i =
      (n : ℤ) + N.tailEulerCharacteristic i)
    (h : ∀ (p : Ideal A), p.IsPrime → ∃ g : A, g ∉ p ∧
      ∃ (P Q : BoundedComplex (Localization.Away g)) (a b : ℕ),
        Nonempty ((boundedComplexDirectSum (M.baseChange (algebraMap A _)) P).toCochainComplex ≅
          (boundedComplexDirectSum (N.baseChange (algebraMap A _)) Q).toCochainComplex) ∧
        idealI P (algebraMap A _ f) i = Ideal.span {(algebraMap A _ f) ^ a} ∧
        idealI Q (algebraMap A _ f) i = Ideal.span {(algebraMap A _ f) ^ b} ∧
        P.tailEulerCharacteristic i = a ∧ Q.tailEulerCharacteristic i = b) :
    Ideal.span {f ^ m} * idealI M f i = Ideal.span {f ^ n} * idealI N f i := by
  apply ideal_eq_of_away_eq
  intro p hp
  obtain ⟨g, hg, P, Q, a, b, ⟨e⟩, hP, hQ, heP, heQ⟩ := h p hp
  refine ⟨g, hg, ?_⟩
  rw [map_pow_mul_idealI, map_pow_mul_idealI]
  by_cases hS : Subsingleton (Localization.Away g)
  · let := hS
    exact Subsingleton.elim _ _
  · have : Nontrivial (Localization.Away g) := not_subsingleton_iff_nontrivial.mp hS
    exact pow_mul_idealI_eq_of_stabilized_iso _
      (IsLocalization.nonZeroDivisors_le_comap (Submonoid.powers g) (Localization.Away g) hf)
      _ _ P Q e i m n a b hP hQ heP heQ he

/-- A finite product indexed by `Fin (n + 1)` splits off its first factor as a binary
biproduct. -/
noncomputable def piFinSuccIsoBiprod
    {C : Type*} [Category C] [Preadditive C] [HasFiniteProducts C] [HasBinaryBiproducts C]
    {n : ℕ} (F : Fin (n + 1) → C) :
    (∏ᶜ F) ≅ F 0 ⊞ ∏ᶜ (fun j : Fin n => F j.succ) where
  hom := biprod.lift (Pi.π F 0) (Pi.lift (fun j => Pi.π F j.succ))
  inv := Pi.lift (Fin.cases biprod.fst (fun j => biprod.snd ≫ Pi.π _ j))
  hom_inv_id := by
    apply Pi.hom_ext
    intro j
    cases j using Fin.cases <;> simp
  inv_hom_id := by
    apply biprod.hom_ext
    · simp
    · apply Pi.hom_ext
      intro j
      simp

/-- If `M^•` and `N^•` present the cochain complexes `K` and `L`, their direct sum presents the
biproduct `K ⊞ L`. -/
theorem exists_boundedPresentation_biprod
    {A : Type*} [CommRing A] (K L : CochainComplex (ModuleCat A) ℤ)
    (M N : BoundedComplex A)
    (hM : Nonempty (M.toCochainComplex ≅ K))
    (hN : Nonempty (N.toCochainComplex ≅ L)) :
    Nonempty ((boundedComplexDirectSum M N).toCochainComplex ≅ K ⊞ L) := by
  obtain ⟨e⟩ := hM
  obtain ⟨e'⟩ := hN
  exact ⟨directSumCochainIso M N ≪≫ biprod.mapIso e e'⟩

/-- Two complexes supported in consecutive degrees with invertible differentials are
isomorphic as soon as their first nonzero terms are isomorphic. -/
private noncomputable def isoOfTwoTerm
    {C : Type*} [Category C] [HasZeroMorphisms C]
    (K L : CochainComplex C ℤ) (j : ℤ)
    (hK : ∀ i, i ≠ j → i ≠ j + 1 → IsZero (K.X i))
    (hL : ∀ i, i ≠ j → i ≠ j + 1 → IsZero (L.X i))
    [IsIso (K.d j (j + 1))] [IsIso (L.d j (j + 1))]
    (e : K.X j ≅ L.X j) : K ≅ L := by
  classical
  let E : ∀ i, K.X i ≅ L.X i := fun i =>
    if h : i = j then
      K.XIsoOfEq h ≪≫ e ≪≫ (L.XIsoOfEq h).symm
    else if h' : i = j + 1 then
      K.XIsoOfEq h' ≪≫ (asIso (K.d j (j + 1))).symm ≪≫ e ≪≫
        asIso (L.d j (j + 1)) ≪≫ (L.XIsoOfEq h').symm
    else (hK i h h').iso (hL i h h')
  refine HomologicalComplex.Hom.isoOfComponents E ?_
  intro i k hik
  obtain rfl : k = i + 1 := hik.symm
  by_cases hi : i = j
  · subst i
    simp [E]
  · by_cases hi' : i = j + 1
    · exact (hL (i + 1) (by omega) (by omega)).eq_of_tgt _ _
    · exact (hK i hi hi').eq_of_src _ _

private noncomputable def mappingConeInlIso
    {C : Type*} [Category C] [Preadditive C] [HasBinaryBiproducts C]
    {F G : CochainComplex C ℤ} (φ : F ⟶ G) (j : ℤ) (h : IsZero (G.X j)) :
    F.X (j + 1) ≅ (CochainComplex.mappingCone φ).X j where
  hom := (CochainComplex.mappingCone.inl φ).v (j + 1) j (by omega)
  inv := (CochainComplex.mappingCone.fst φ).1.v j (j + 1) rfl
  hom_inv_id := by simp
  inv_hom_id := by
    have hz : (CochainComplex.mappingCone.snd φ).v j j (add_zero j) = 0 :=
      h.eq_of_tgt _ _
    simpa only [hz, comp_zero, zero_comp, add_zero] using
      CochainComplex.mappingCone.id_X φ j (j + 1) rfl

private noncomputable def mappingConeInrIso
    {C : Type*} [Category C] [Preadditive C] [HasBinaryBiproducts C]
    {F G : CochainComplex C ℤ} (φ : F ⟶ G) (j : ℤ) (h : IsZero (F.X (j + 1))) :
    G.X j ≅ (CochainComplex.mappingCone φ).X j where
  hom := (CochainComplex.mappingCone.inr φ).f j
  inv := (CochainComplex.mappingCone.snd φ).v j j (add_zero j)
  hom_inv_id := by simp
  inv_hom_id := by
    have hz : (CochainComplex.mappingCone.fst φ).1.v j (j + 1) rfl = 0 :=
      h.eq_of_tgt _ _
    simpa only [hz, zero_comp, zero_add] using
      CochainComplex.mappingCone.id_X φ j (j + 1) rfl

private theorem isZero_trivialBoundedComplex_X {A : Type*} [CommRing A]
    (j i : ℤ) (hi : i ≠ j) (hi' : i ≠ j + 1) :
    IsZero ((trivialBoundedComplex (A := A) j).toCochainComplex.X i) := by
  apply isZero_toCochainComplex_X_of_rank_eq_zero
  simp [trivialBoundedComplex, hi, hi']

private noncomputable def trivialBoundedComplexTermIso {A : Type*} [CommRing A]
    (j i : ℤ) (hi : i = j ∨ i = j + 1) :
    (trivialBoundedComplex (A := A) j).toCochainComplex.X i ≅ ModuleCat.of A A := by
  have hr : (trivialBoundedComplex (A := A) j).rank i = 1 := by
    simp [trivialBoundedComplex, hi]
  exact (LinearEquiv.funCongrLeft A A (finCongr hr).symm).toModuleIso ≪≫
    (LinearEquiv.funUnique (Fin 1) A A).toModuleIso

set_option backward.isDefEq.respectTransparency false in
private theorem isIso_trivialBoundedComplex_d {A : Type*} [CommRing A] (j : ℤ) :
    IsIso ((trivialBoundedComplex (A := A) j).toCochainComplex.d j (j + 1)) := by
  let e := trivialBoundedComplexTermIso (A := A) j j (Or.inl rfl)
  let e' := trivialBoundedComplexTermIso (A := A) j (j + 1) (Or.inr rfl)
  have he : (trivialBoundedComplex (A := A) j).toCochainComplex.d j (j + 1) ≫
      e'.hom = e.hom := by
    ext x
    simp only [BoundedComplex.toCochainComplex_d, trivialBoundedComplex]
    change (∑ k, (1 : A) * x k) = x _
    simp only [one_mul]
    have : Unique (Fin ((trivialBoundedComplex (A := A) j).rank j)) := by
      simpa [trivialBoundedComplex] using (inferInstance : Unique (Fin 1))
    exact (Fintype.sum_unique x).trans (congrArg x (Subsingleton.elim _ _))
  exact IsIso.of_isIso_fac_right he

/-- The cone of the identity on a single rank-one free module is a two-term
identity complex in the preceding and the specified degree. -/
@[no_expose]
noncomputable def trivialBoundedComplexIsoMappingCone
    {A : Type u} [CommRing A] (j : ℤ) :
    (trivialBoundedComplex (A := A) j).toCochainComplex ≅
      CochainComplex.mappingCone
        (𝟙 ((CochainComplex.singleFunctor (ModuleCat A) (j + 1)).obj
          (ModuleCat.of A (ULift.{0} A)))) := by
  let S := (CochainComplex.singleFunctor (ModuleCat A) (j + 1)).obj
    (ModuleCat.of A (ULift.{0} A))
  let K := CochainComplex.mappingCone (𝟙 S)
  have hS (i : ℤ) (hi : i ≠ j + 1) : IsZero (S.X i) :=
    HomologicalComplex.isZero_single_obj_X _ _ _ _ hi
  let e₁ := mappingConeInlIso (𝟙 S) j (hS j (by omega))
  let e₂ := mappingConeInrIso (𝟙 S) (j + 1) (hS (j + 1 + 1) (by omega))
  have hd : e₁.hom ≫ K.d j (j + 1) = e₂.hom := by
    simpa [e₁, e₂, mappingConeInlIso, mappingConeInrIso, S] using
      CochainComplex.mappingCone.inl_v_d (𝟙 S) (j + 1) j (j + 1 + 1)
        (by omega) (by omega)
  have : IsIso (K.d j (j + 1)) := IsIso.of_isIso_fac_left hd
  have := isIso_trivialBoundedComplex_d (A := A) j
  refine isoOfTwoTerm _ K j (isZero_trivialBoundedComplex_X j) ?_
    (trivialBoundedComplexTermIso j j (Or.inl rfl) ≪≫
      (ULift.moduleEquiv (R := A) (M := A)).symm.toModuleIso ≪≫
      (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) (j + 1)
        (ModuleCat.of A (ULift.{0} A))).symm ≪≫ e₁)
  intro i hi hi'
  exact (CochainComplex.mappingCone.isZero_X_iff (𝟙 S) i).mpr
    ⟨hS (i + 1) (by omega), hS i hi'⟩

/-- A finite sum of rank-one identity cones has a bounded matrix presentation whose
minor ideal is the power of the scalar specified by its tail Euler characteristic. -/
private theorem exists_boundedPresentation_trivialSum
    {A : Type u} [CommRing A] (n : ℕ) (degree : Fin n → ℤ) (f : A) (i : ℤ) :
    ∃ (P : BoundedComplex A) (a : ℕ),
      Nonempty (P.toCochainComplex ≅ ∏ᶜ fun j => CochainComplex.mappingCone
        (𝟙 ((CochainComplex.singleFunctor (ModuleCat A) (degree j)).obj
          (ModuleCat.of A (ULift.{0} A))))) ∧
      idealI P f i = Ideal.span {f ^ a} ∧ P.tailEulerCharacteristic i = a := by
  classical
  induction n with
  | zero =>
    let Z : BoundedComplex A :=
      { rank := fun _ => 0
        d := fun _ => 0
        dd := by simp
        bounded := by simp }
    have hZ : IsZero Z.toCochainComplex := by
      apply (IsZero.iff_id_eq_zero _).mpr
      ext k x
      exact Subsingleton.elim (α := Fin 0 → A) _ _
    have hP : IsZero (∏ᶜ fun j : Fin 0 => CochainComplex.mappingCone
        (𝟙 ((CochainComplex.singleFunctor (ModuleCat A) (degree j)).obj
          (ModuleCat.of A (ULift.{0} A))))) :=
      (IsZero.iff_id_eq_zero _).mpr (Pi.hom_ext _ _ fun j => j.elim0)
    refine ⟨Z, 0, ⟨hZ.iso hP⟩, ?_, ?_⟩
    · simpa using idealI_eq_top_of_rank_zero Z f i rfl
    · simp [BoundedComplex.tailEulerCharacteristic, Z]
  | succ n ih =>
    obtain ⟨P, a, hP, hI, hE⟩ := ih (fun j => degree j.succ)
    let D := trivialBoundedComplex (A := A) (degree 0 - 1)
    have hD : Nonempty (D.toCochainComplex ≅ CochainComplex.mappingCone
        (𝟙 ((CochainComplex.singleFunctor (ModuleCat A) (degree 0)).obj
          (ModuleCat.of A (ULift.{0} A))))) :=
      ⟨trivialBoundedComplexIsoMappingCone (A := A) (degree 0 - 1) ≪≫
        eqToIso (congrArg (fun k : ℤ => CochainComplex.mappingCone
          (𝟙 ((CochainComplex.singleFunctor (ModuleCat A) k).obj
            (ModuleCat.of A (ULift.{0} A))))) (sub_add_cancel (degree 0) 1))⟩
    obtain ⟨e⟩ := exists_boundedPresentation_biprod _ _ D P hD hP
    refine ⟨boundedComplexDirectSum D P, (if i = degree 0 then 1 else 0) + a,
      ⟨e ≪≫ (piFinSuccIsoBiprod (fun j => CochainComplex.mappingCone
        (𝟙 ((CochainComplex.singleFunctor (ModuleCat A) (degree j)).obj
          (ModuleCat.of A (ULift.{0} A)))))).symm⟩, ?_, ?_⟩
    · rw [idealI_boundedComplexDirectSum, hI, idealI_trivialBoundedComplex,
        Ideal.span_singleton_mul_span_singleton, ← pow_add]
      simp
    · simp [tailEulerCharacteristic_directSum, D,
        tailEulerCharacteristic_trivialBoundedComplex, hE]

attribute [local instance] HasDerivedCategory.standard

/-- **Stacks 0GSS.** Let `f` be a nonzerodivisor and let `M` and `N` be bounded complexes of
finite free modules representing isomorphic objects of the derived category. If `m` and `n`
are nonnegative integers such that
`m + ∑_{j ≥ i} (-1)^(j-i) rank(Mʲ) = n + ∑_{j ≥ i} (-1)^(j-i) rank(Nʲ)`,
then `fᵐ I_i(M, f) = fⁿ I_i(N, f)` as ideals. -/
@[stacks 0GSS]
public theorem pow_mul_idealI_eq_of_derived_iso
    {A : Type*} [CommRing A] (f : A) (hf : f ∈ nonZeroDivisors A)
    (M N : BoundedComplex A) (i : ℤ) (m n : ℕ)
    (hMN : Nonempty ((DerivedCategory.Q).obj M.toCochainComplex ≅
      (DerivedCategory.Q).obj N.toCochainComplex))
    (hEuler : (m : ℤ) + M.tailEulerCharacteristic i =
      (n : ℤ) + N.tailEulerCharacteristic i) :
    Ideal.span {f ^ m} * idealI M f i = Ideal.span {f ^ n} * idealI N f i := by
  apply pow_mul_idealI_eq_of_away_stabilized_iso f hf M N i m n hEuler
  intro p hp
  let := hp
  have hterms (C : BoundedComplex A) (j : ℤ) :
      Module.Finite A (C.toCochainComplex.X j) ∧ Projective (C.toCochainComplex.X j) := by
    change Module.Finite A (Fin (C.rank j) → A) ∧
      Projective (ModuleCat.of A (Fin (C.rank j) → A))
    constructor <;> infer_instance
  obtain ⟨g, hg, P, Q, ⟨a, da, ⟨eP⟩⟩, ⟨b, db, ⟨eQ⟩⟩, ⟨e⟩⟩ :=
    StacksDraft.Perfect.exists_away_iso_biprod_trivial_complexes.{_, 0} p
      M.toCochainComplex N.toCochainComplex
      (toCochainComplex_bounded M) (toCochainComplex_bounded N)
      (hterms M) (hterms N) hMN
  obtain ⟨P', a', ⟨eP'⟩, hIP, hEP⟩ :=
    exists_boundedPresentation_trivialSum a da (algebraMap A (Localization.Away g) f) i
  obtain ⟨Q', b', ⟨eQ'⟩, hIQ, hEQ⟩ :=
    exists_boundedPresentation_trivialSum b db (algebraMap A (Localization.Away g) f) i
  refine ⟨g, hg, P', Q', a', b', ?_, hIP, hIQ, hEP, hEQ⟩
  exact ⟨directSumCochainIso _ _ ≪≫
    biprod.mapIso (baseChangeCochainIso (algebraMap A _) M).symm (eP' ≪≫ eP.symm) ≪≫
    e ≪≫ biprod.mapIso (baseChangeCochainIso (algebraMap A _) N) (eQ ≪≫ eQ'.symm) ≪≫
    (directSumCochainIso _ _).symm⟩

