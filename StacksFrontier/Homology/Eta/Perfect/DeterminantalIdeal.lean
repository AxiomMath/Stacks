/-! ## Minor ideals at a prime with free cohomology (Tag 0GSV) -/

section MinorIdealsAtPrime

noncomputable section

set_option backward.isDefEq.respectTransparency false

open Matrix CategoryTheory CategoryTheory.Limits

attribute [local instance] HasDerivedCategory.standard

namespace Stacks.DeterminantalIdeal.FreeHomology

private lemma localized_idealI_eq_baseChange {A : Type*} [CommRing A]
    (p : Ideal A) [p.IsPrime] (M : BoundedComplex A) (f : A) (i : ℤ) :
    Ideal.map (algebraMap A (Localization.AtPrime p)) (idealI M f i) =
      idealI (M.baseChange (algebraMap A (Localization.AtPrime p)))
        (algebraMap A (Localization.AtPrime p) f) i :=
  map_idealI_eq_idealI_baseChange _ _ _ _

private lemma mapMatrix_zero_eq_smul {R : Type*} [CommRing R]
    {r s : ℕ} (f : R) :
    mapMatrix f (0 : Matrix (Fin s) (Fin r) R) =
      f • mapMatrix 1 (0 : Matrix (Fin s) (Fin r) R) := by
  ext (_ | j) k <;> simp [mapMatrix]

private lemma pow_mem_minorIdeal_mapMatrix_zero {R : Type*} [CommRing R]
    {r s : ℕ} (f : R) :
    f ^ r ∈ minorIdealInjective
      (mapMatrix f (0 : Matrix (Fin s) (Fin r) R)) r := by
  apply Ideal.subset_span
  refine ⟨Sum.inl, id, Sum.inl_injective, Function.injective_id, ?_⟩
  change f ^ r = (f • (1 : Matrix (Fin r) (Fin r) R)).det
  simp

private lemma minorIdeal_mapMatrix_zero_le {R : Type*} [CommRing R]
    {r s : ℕ} (f : R) :
    minorIdealInjective (mapMatrix f (0 : Matrix (Fin s) (Fin r) R)) r ≤
      Ideal.span {f ^ r} := by
  rw [minorIdealInjective, Ideal.span_le]
  rintro x ⟨ri, ci, hri, hci, rfl⟩
  rw [mapMatrix_zero_eq_smul]
  change (f • ((mapMatrix 1 (0 : Matrix (Fin s) (Fin r) R)).submatrix ri ci)).det ∈
    Ideal.span {f ^ r}
  rw [Matrix.det_smul]
  simpa using Ideal.mul_mem_right
    ((mapMatrix 1 (0 : Matrix (Fin s) (Fin r) R)).submatrix ri ci).det
    (Ideal.span {f ^ r}) (Ideal.mem_span_singleton_self (f ^ r))

private lemma idealI_eq_span_pow_of_d_eq_zero {R : Type*} [CommRing R]
    (C : BoundedComplex R) (f : R) (i : ℤ) (hd : C.d i = 0) :
    idealI C f i = Ideal.span {f ^ C.rank i} := by
  unfold idealI
  rw [hd]
  exact le_antisymm (minorIdeal_mapMatrix_zero_le f)
    ((Ideal.span_singleton_le_iff_mem _).mpr (pow_mem_minorIdeal_mapMatrix_zero f))

private lemma span_singleton_mul_right_injective_of_mem_nonZeroDivisors
    {R : Type*} [CommRing R] (a : R)
    (ha : a ∈ nonZeroDivisors R) {I J : Ideal R}
    (h : Ideal.span {a} * I = Ideal.span {a} * J) : I = J :=
  (Stacks.Eta.DeterminantalIdeal.span_mul_cancel a
    (fun _ _ hxy => (mul_cancel_left_mem_nonZeroDivisors ha).mp hxy) I J).mp h

private lemma ideal_eq_span_pow_of_span_pow_mul_eq {R : Type*} [CommRing R]
    (f : R) (hf : f ∈ nonZeroDivisors R) (I : Ideal R) (a b : ℕ)
    (h : Ideal.span {f ^ a} * I = Ideal.span {f ^ b}) :
    ∃ n : ℕ, I = Ideal.span {f ^ n} := by
  by_cases hab : a ≤ b
  · refine ⟨b - a,
      span_singleton_mul_right_injective_of_mem_nonZeroDivisors (f ^ a) (pow_mem hf _) ?_⟩
    rwa [Ideal.span_singleton_mul_span_singleton, ← pow_add, Nat.add_sub_of_le hab]
  · have h' : Ideal.span {f ^ b} * (Ideal.span {f ^ (a - b)} * I) =
        Ideal.span {f ^ b} * ⊤ := by
      rwa [Ideal.mul_top, ← mul_assoc, Ideal.span_singleton_mul_span_singleton,
        ← pow_add, Nat.add_sub_of_le (by omega : b ≤ a)]
    have htop := span_singleton_mul_right_injective_of_mem_nonZeroDivisors (f ^ b) (pow_mem hf _) h'
    exact ⟨0, by simpa using top_unique (htop ▸ Ideal.mul_le_right : ⊤ ≤ I)⟩

private lemma finite_homology_of_free {R : Type*} [CommRing R] [Nontrivial R]
    {ι : Type*} {c : ComplexShape ι}
    (C : HomologicalComplex (ModuleCat R) c) (i : ι)
    [Module.Free R (C.homology i)] [Module.Finite R (C.X i)] :
    Module.Finite R (C.homology i) := by
  let s := Projective.factorThru (𝟙 (C.homology i)) (C.homologyπ i)
  have hs : s ≫ C.homologyπ i = 𝟙 _ := Projective.factorThru_comp _ _
  have : Mono s := mono_of_mono_fac hs
  let t := s ≫ C.iCycles i
  exact Module.rank_lt_aleph0_iff.mp
    ((t.hom.rank_le_of_injective ((ModuleCat.mono_iff_injective t).mp inferInstance)).trans_lt
      (Module.rank_lt_aleph0 R (C.X i)))

private lemma exists_zero_differential_of_free_homology {R : Type*} [CommRing R] [Nontrivial R]
    (M : BoundedComplex R)
    (hfree : ∀ i, Module.Free R (M.toCochainComplex.homology i)) :
    ∃ N : BoundedComplex R, (∀ i, N.d i = 0) ∧
      Nonempty (DerivedCategory.Q.obj N.toCochainComplex ≅
        DerivedCategory.Q.obj M.toCochainComplex) := by
  let C := M.toCochainComplex
  let {i : ℤ} : Module.Free R (C.homology i) := hfree i
  have {i : ℤ} : Module.Finite R (C.homology i) := by
    have : Module.Finite R (C.X i) := by
      change Module.Finite R (Fin (M.rank i) → R)
      infer_instance
    exact finite_homology_of_free C i
  let N : BoundedComplex R := {
    rank := fun i ↦ Module.finrank R (C.homology i)
    d := fun i ↦ 0
    dd := by simp
    bounded := M.bounded.subset (by
      intro i hi
      change Module.finrank R (C.homology i) ≠ 0 at hi
      change M.rank i ≠ 0
      intro hz
      have hzero : IsZero (C.homology i) :=
        (C.sc i).isZero_homology_of_isZero_X₂
          (Stacks.Eta.DeterminantalIdeal.isZero_toCochainComplex_X_of_rank_eq_zero M i hz)
      have := ModuleCat.isZero_iff_subsingleton.mp hzero
      exact hi Module.finrank_zero_of_subsingleton) }
  have hd (i j : ℤ) : N.toCochainComplex.d i j = 0 := by
    by_cases hij : i + 1 = j
    · subst j
      rw [BoundedComplex.toCochainComplex_d]
      ext x k
      simp [N]
    · exact N.toCochainComplex.shape i j hij
  let e (i : ℤ) : N.toCochainComplex.X i ≅ C.homology i :=
    (Module.finBasis R (C.homology i)).equivFun.symm.toModuleIso
  have {i : ℤ} : Projective (N.toCochainComplex.X i) := by
    change Projective (ModuleCat.of R (Fin (N.rank i) → R))
    infer_instance
  let s (i : ℤ) := Projective.factorThru (e i).hom (C.homologyπ i)
  have hs (i : ℤ) : s i ≫ C.homologyπ i = (e i).hom := Projective.factorThru_comp _ _
  let φ : N.toCochainComplex ⟶ C := {
    f := fun i ↦ s i ≫ C.iCycles i
    comm' := by
      intro i j hij
      obtain rfl : i + 1 = j := hij
      rw [Category.assoc, C.iCycles_d, comp_zero, hd, zero_comp] }
  have : QuasiIso φ := by
    refine ⟨fun i => ?_⟩
    rw [quasiIsoAt_iff_isIso_homologyMap]
    have hπ : IsIso (N.toCochainComplex.homologyπ i) :=
      N.toCochainComplex.isIso_homologyπ (i - 1) i (by simp) (hd _ _)
    have hι : IsIso (N.toCochainComplex.iCycles i) :=
      N.toCochainComplex.isIso_iCycles i (i + 1) (by simp) (hd _ _)
    have heq : N.toCochainComplex.homologyπ i ≫ HomologicalComplex.homologyMap φ i =
        N.toCochainComplex.iCycles i ≫ (e i).hom := by
      rw [HomologicalComplex.homologyπ_naturality]
      have hc : HomologicalComplex.cyclesMap φ i =
          N.toCochainComplex.iCycles i ≫ s i := by
        apply (cancel_mono (C.iCycles i)).mp
        rw [HomologicalComplex.cyclesMap_i]
        exact (Category.assoc _ _ _).symm
      rw [hc, Category.assoc, hs]
    have : IsIso (N.toCochainComplex.homologyπ i ≫ HomologicalComplex.homologyMap φ i) :=
      heq ▸ inferInstance
    exact IsIso.of_isIso_comp_left (N.toCochainComplex.homologyπ i) _
  exact ⟨N, fun _ ↦ rfl, ⟨asIso (DerivedCategory.Q.map φ)⟩⟩

private def localizedModuleIsoBaseChange {R : Type*} [CommRing R]
    (S : Submonoid R) (M : BoundedComplex R) :
    ((ModuleCat.localizedModuleFunctor S).mapHomologicalComplex (ComplexShape.up ℤ)).obj
      M.toCochainComplex ≅
        (M.baseChange (algebraMap R (Localization S))).toCochainComplex := by
  let l (n : ℕ) : (Fin n → R) →ₗ[R] (Fin n → Localization S) :=
    LinearMap.pi fun i ↦ (Algebra.linearMap R (Localization S)) ∘ₗ LinearMap.proj i
  let (n : ℕ) : IsLocalizedModule S (l n) := by dsimp [l]; infer_instance
  let e (i : ℤ) : ((M.toCochainComplex.X i).localizedModule S) ≃ₗ[Localization S]
      (Fin (M.rank i) → Localization S) := by
    change ((ModuleCat.of R (Fin (M.rank i) → R)).localizedModule S) ≃ₗ[Localization S] _
    let := ModuleCat.localizedModule_isLocalizedModule (ModuleCat.of R (Fin (M.rank i) → R)) S
    exact (IsLocalizedModule.linearEquiv S
      ((ModuleCat.of R (Fin (M.rank i) → R)).localizedModuleMkLinearMap S)
      (l (M.rank i))).extendScalarsOfIsLocalization S (Localization S)
  refine HomologicalComplex.Hom.isoOfComponents (fun i ↦ (e i).toModuleIso) ?_
  intro i j hij
  obtain rfl : i + 1 = j := hij
  simp only [Functor.mapHomologicalComplex_obj_d, BoundedComplex.toCochainComplex_d]
  change (e i).toModuleIso.hom ≫
      ModuleCat.ofHom ((M.d i).map (algebraMap R (Localization S))).mulVecLin =
    ModuleCat.localizedModuleMap S (ModuleCat.ofHom (M.d i).mulVecLin) ≫
      (e (i + 1)).toModuleIso.hom
  apply ModuleCat.hom_ext
  apply LinearMap.restrictScalars_injective R
  apply IsLocalizedModule.linearMap_ext S
    ((M.toCochainComplex.X i).localizedModuleMkLinearMap S) (l (M.rank (i + 1)))
  ext x k
  simp [e, l, ModuleCat.localizedModuleMap,
    IsLocalizedModule.mapExtendScalars, IsLocalizedModule.linearEquiv_apply,
    IsLocalizedModule.map_apply, Matrix.mulVec, dotProduct, map_sum]

/-- **Freeness of the localized cohomology passes to the cohomology of the base change.**  If
every localization at `S` of a cohomology module of a bounded complex `M^•` of finite free
`A`-modules is free over `S⁻¹A`, then so is every cohomology module of the base change
`M^• ⊗_A S⁻¹A`: localization is exact, so the two cohomologies agree. -/
public lemma free_homology_baseChange_of_free_localizedModule {R : Type*} [CommRing R]
    (S : Submonoid R) (M : BoundedComplex R)
    (hfree : ∀ i, Module.Free (Localization S) (LocalizedModule S
      (M.toCochainComplex.homology i))) (i : ℤ) :
    Module.Free (Localization S)
      ((M.baseChange (algebraMap R (Localization S))).toCochainComplex.homology i) := by
  let F := ModuleCat.localizedModuleFunctor S
  let e := (HomologicalComplex.homologyMapIso (localizedModuleIsoBaseChange S M).symm i) ≪≫
    (M.toCochainComplex.sc i).mapHomologyIso F
  let : Module.Free (Localization S)
      (LocalizedModule S ((M.toCochainComplex.sc i).homology)) := hfree i
  exact Module.Free.of_equiv (e.toLinearEquiv.trans (Shrink.linearEquiv (Localization S) _)).symm

/-- **Stacks 0GSV.** If the localization at `p` of every cohomology module of a bounded
complex `M` of finite free modules is free, then for every degree the localization of
`I_i(M, f)` is generated by a power of the nonzerodivisor `f`. -/
@[stacks 0GSV]
public theorem localized_idealI_eq_span_pow_of_free_homology
    {A : Type*} [CommRing A] (p : Ideal A) [p.IsPrime]
    (f : A) (hf : f ∈ nonZeroDivisors A) (M : BoundedComplex A)
    (hfree : ∀ i : ℤ, Module.Free (Localization.AtPrime p)
      (LocalizedModule p.primeCompl
        ((HomologicalComplex.homologyFunctor (ModuleCat A) (ComplexShape.up ℤ) i).obj
          M.toCochainComplex))) :
    ∀ i : ℤ, ∃ n : ℕ,
      Ideal.map (algebraMap A (Localization.AtPrime p)) (idealI M f i) =
        Ideal.span {(algebraMap A (Localization.AtPrime p) f) ^ n} := by
  let R := Localization.AtPrime p
  let g : R := algebraMap A R f
  let C := M.baseChange (algebraMap A R)
  have hg : g ∈ nonZeroDivisors R :=
    IsLocalization.nonZeroDivisors_le_comap p.primeCompl R hf
  obtain ⟨N, hN, ⟨e⟩⟩ := exists_zero_differential_of_free_homology C
    (free_homology_baseChange_of_free_localizedModule p.primeCompl M hfree)
  intro i
  rw [localized_idealI_eq_baseChange]
  let d : ℤ := N.tailEulerCharacteristic i - C.tailEulerCharacteristic i
  let a := d.toNat
  let b := (-d).toNat
  have hEuler : (a : ℤ) + C.tailEulerCharacteristic i =
      (b : ℤ) + N.tailEulerCharacteristic i := by
    dsimp [a, b, d]
    omega
  have h := Stacks.Eta.DeterminantalIdeal.pow_mul_idealI_eq_of_derived_iso g hg C N i a b
    ⟨e.symm⟩ hEuler
  rw [idealI_eq_span_pow_of_d_eq_zero N g i (hN i),
    Ideal.span_singleton_mul_span_singleton, ← pow_add] at h
  exact ideal_eq_span_pow_of_span_pow_mul_eq g hg (idealI C g i) a (b + N.rank i) h

end Stacks.DeterminantalIdeal.FreeHomology

end

