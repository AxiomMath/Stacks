@[expose] public section

/-!
# Problem Description

Throughout, `A` is a commutative unital ring, `f ∈ A` is a nonzerodivisor, and "module"
means `A`-module unless otherwise qualified. All tensor products are over `A` unless a
different base is indicated.

This is Lemma 15.97.10 of the Stacks project (tag 0GSR): the décalage operator `η_f`
commutes with flat base change.

## Main Definitions

* Definition 1 (`f`-torsion free module). An `A`-module `M` is *`f`-torsion free* if `f` is a
  nonzerodivisor on `M`, i.e. for all `x ∈ M`, `f x = 0` implies `x = 0`. We encode this as
  `IsSMulRegular M f` (multiplication by `f` is injective on `M`). For such `M` the
  localization map `M → M_f` is injective.

  For an `f`-torsion free module `M` and `i ∈ ℤ`, the submodule
  `f^i M = { f^i x | x ∈ M } ⊆ M_f` is the image of multiplication by `f^i` inside the
  localization `M_f = LocalizedModule (powers f) M` (for `i ≥ 0` it is the usual submodule of
  `M`; for `i < 0` it lives in `M_f`). We model this as the range of the `A`-linear map
  `x ↦ f^i • (mk x)`, where `f^i` is the `i`-th power (`i ∈ ℤ`) of the unit
  `Stacks.GradedLaurent.awayUnit f ∈ (Localization (powers f))ˣ` acting on `M_f`.

* Definition 2 (the décalage operator `η_f` on complexes). For a cochain complex `M^•` of
  `f`-torsion free `A`-modules with differentials `d^i : M^i → M^{i+1}` (extended to the
  localizations `M^i_f`),
  `(η_f M)^i = { x ∈ f^i M^i | d^i x ∈ f^{i+1} M^{i+1} } ⊆ M^i_f`,
  with differential the restriction of `d^i`. The degree-`i` term is the submodule
  `fetaTerm f (M.d i (i + 1)).hom i ⊆ M^i_f`.

* Definition 3 (base change of a complex). For a flat ring map `A → B`, the complex
  `M^• ⊗_A B` has terms `M^i ⊗_A B` (modelled as the `B`-module `B ⊗[A] M^i`) and
  differentials `d^i ⊗ id_B` (modelled as `LinearMap.baseChange B (d^i)`).

* Definition 4 (the identification used in Statement 3). For `A → B` flat, `g = algebraMap A B f`
  the image of `f`, the natural map `(M^i)_f ⊗_A B → (M^i ⊗_A B)_g` is an isomorphism. We make
  the underlying canonical comparison map explicit as the `A`-linear map
  `etaBCPsi f M^i : (M^i)_f → (M^i ⊗_A B)_g`,
  `mk_f(m, f^n) ↦ mk_g(1 ⊗ m, g^n)`, obtained as the localization lift of `m ↦ mk_g (1 ⊗ m)`.
  The two subcomplexes of Statement 3 are then compared *inside the single ambient module*
  `(M^i ⊗_A B)_g = LocalizedModule (powers g) (B ⊗[A] M^i)`:
  - the base change `(η_f M)^i ⊗_A B` is the `B`-submodule of `(M^i ⊗_A B)_g` generated by the
    image `etaBCPsi f M^i '' (η_f M)^i`;
  - the décalage `(η_g (M^• ⊗_A B))^i` is the submodule `fetaTerm g (d^i ⊗ id_B) i` of the
    same module.

## Main Statements

Let `A → B` be a flat ring map, `g = algebraMap A B f` the image of `f`, and `M^•` a complex
of `f`-torsion free `A`-modules. Then:

* Statement 1: `g` is a nonzerodivisor in `B`.
* Statement 2: each `M^i ⊗_A B` is `g`-torsion free.
* Statement 3: `η_f M^• ⊗_A B = η_g (M^• ⊗_A B)` as complexes of `g`-torsion free
  `B`-modules; concretely, an equality of `B`-submodules inside `(M^i ⊗_A B)_g` for every
  `i ∈ ℤ`, compatible with the (localized) differentials.
-/

open scoped TensorProduct

namespace Stacks.Eta.BaseChange

open EtaPow

variable {A : Type*} [CommRing A]

-- Main Definition(s)

/-! The submodules `f^i M ⊆ M_f` (`EtaPow.fpowSub`), the localized differential
(`EtaPow.fLoc`) and the degree-`i` décalage term `(η_f)^i` (`EtaPow.fetaTerm`) are the
substrate `StacksFrontier.Algebra.Homology.Eta` specialized to `Submonoid.powers f`; they are
taken from `StacksDraft.Sec96.Tag0F7P`.  Only the base-change layer is proper to this
file. -/

/-- Two consecutive differentials of a cochain complex of modules compose to zero, stated for
the underlying `A`-linear maps. -/
theorem d_hom_comp_d_hom (M : CochainComplex (ModuleCat A) ℤ) (i j k : ℤ) :
    (M.d j k).hom ∘ₗ (M.d i j).hom = 0 := by
  rw [← ModuleCat.hom_comp, HomologicalComplex.d_comp_d]; rfl

/-- **Definition 2 (correctness: `η_f M^•` is a complex).** The (localized) differential `d^i`
maps the degree-`i` décalage term into the degree-`(i+1)` one, so `η_f M^•` is indeed a
subcomplex. -/
theorem fLoc_mem_fetaTerm_complex (f : A) (M : CochainComplex (ModuleCat A) ℤ) (i : ℤ)
    {x : LocalizedModule (Submonoid.powers f) (M.X i)}
    (hx : x ∈ fetaTerm f (M.d i (i + 1)).hom i) :
    fLoc f (M.d i (i + 1)).hom x ∈ fetaTerm f (M.d (i + 1) (i + 1 + 1)).hom (i + 1) :=
  fLoc_mem_fetaTerm (d_hom_comp_d_hom M i (i + 1) (i + 1 + 1)) i hx

variable {B : Type*} [CommRing B] [Algebra A B]

/-- **Definition 4 (units lemma).** Every power of `f` acts invertibly on the localized module
`(M^i ⊗_A B)_g = LocalizedModule (powers g) (B ⊗_A M)` (where `g = algebraMap A B f`), since `g`
is inverted there and `f` acts as `g` by the scalar tower. This is the hypothesis needed to lift
maps out of the localization `M_f`. -/
theorem isUnit_algebraMap_end_baseChange (f : A) (M : Type*) [AddCommGroup M] [Module A M] :
    ∀ x : Submonoid.powers f, IsUnit ((algebraMap A (Module.End A
      (LocalizedModule (Submonoid.powers (algebraMap A B f)) (B ⊗[A] M)))) ↑x) := by
  rintro ⟨y, n, rfl⟩
  have hg := IsLocalizedModule.map_units
    (LocalizedModule.mkLinearMap (Submonoid.powers (algebraMap A B f)) (B ⊗[A] M))
    (⟨(algebraMap A B f) ^ n, n, rfl⟩ : Submonoid.powers (algebraMap A B f))
  rw [Module.End.isUnit_iff] at hg ⊢
  have heq : ∀ x : LocalizedModule (Submonoid.powers (algebraMap A B f)) (B ⊗[A] M),
      (algebraMap A (Module.End A _) (f ^ n)) x
        = (algebraMap B (Module.End B _) ((algebraMap A B f) ^ n)) x := by
    intro x
    rw [Module.algebraMap_end_apply, Module.algebraMap_end_apply, ← map_pow, algebraMap_smul]
  refine ⟨fun x y hxy => hg.injective (by rw [← heq, ← heq]; exact hxy), fun y => ?_⟩
  obtain ⟨x, hx⟩ := hg.surjective y; exact ⟨x, by rw [heq]; exact hx⟩

/-- **Definition 4 (base map).** The `A`-linear map `M → (M ⊗_A B)_g`, `m ↦ mk_g (1 ⊗ m)`. -/
noncomputable def etaBCBaseToLoc (f : A) (M : Type*) [AddCommGroup M] [Module A M] :
    M →ₗ[A] LocalizedModule (Submonoid.powers (algebraMap A B f)) (B ⊗[A] M) :=
  ((LocalizedModule.mkLinearMap (Submonoid.powers (algebraMap A B f)) (B ⊗[A] M)).restrictScalars
      A).comp
    (TensorProduct.mk A B M 1)

/-- **Definition 4 (the canonical comparison map).** The `A`-linear map
`etaBCPsi f M : M_f → (M ⊗_A B)_g`, `mk_f(m, f^n) ↦ mk_g(1 ⊗ m, g^n)`, obtained as the
localization lift of `etaBCBaseToLoc`. It is the underlying map of the canonical isomorphism
`(M)_f ⊗_A B ≅ (M ⊗_A B)_g` of Definition 4 precomposed with the unit `m_f ↦ 1 ⊗ m_f`; its
`B`-linear extension is an isomorphism. -/
noncomputable def etaBCPsi (f : A) (M : Type*) [AddCommGroup M] [Module A M] :
    LocalizedModule (Submonoid.powers f) M →ₗ[A]
      LocalizedModule (Submonoid.powers (algebraMap A B f)) (B ⊗[A] M) :=
  LocalizedModule.lift (Submonoid.powers f) (etaBCBaseToLoc f M)
    (isUnit_algebraMap_end_baseChange f M)

/-- **Definition 4 (base change of the décalage term).** The base change `(η_f M)^i ⊗_A B`,
viewed inside the ambient module `(M^i ⊗_A B)_g`, is the `B`-submodule generated by the image
of `(η_f M)^i` under the canonical comparison map `etaBCPsi`. -/
noncomputable def etaBaseChangeTerm (f : A) (M : CochainComplex (ModuleCat A) ℤ) (i : ℤ) :
    Submodule B (LocalizedModule (Submonoid.powers (algebraMap A B f)) (B ⊗[A] (M.X i : Type _))) :=
  Submodule.span B
    ((etaBCPsi f (M.X i)) ''
      (fetaTerm f (M.d i (i + 1)).hom i : Set (LocalizedModule (Submonoid.powers f) (M.X i))))

-- Main Statement(s)

/-- General subcomplex lemma: if `d2 ∘ d1 = 0`, the localized `d1` carries the degree-`i`
décalage term for `d1` into the degree-`(i+1)` décalage term for `d2`. -/
theorem fetaTerm_map_le (f : A) {M N P : Type*} [AddCommGroup M] [Module A M]
    [AddCommGroup N] [Module A N] [AddCommGroup P] [Module A P]
    (d1 : M →ₗ[A] N) (d2 : N →ₗ[A] P) (hd : d2 ∘ₗ d1 = 0) (i : ℤ) :
    Submodule.map (fLoc f d1) (fetaTerm f d1 i) ≤ fetaTerm f d2 (i + 1) := by
  rintro _ ⟨y, hy, rfl⟩
  exact fLoc_mem_fetaTerm hd i hy

/-- **Statement 1.** If `f` is a nonzerodivisor in `A` and `A → B` is flat, then its image
`g = algebraMap A B f` is a nonzerodivisor in `B`. -/
@[stacks 0GSR "g is a nonzerodivisor"]
theorem algebraMap_mem_nonZeroDivisors (f : A) [Module.Flat A B] (hf : f ∈ nonZeroDivisors A) :
    (algebraMap A B f) ∈ nonZeroDivisors B :=
  isRegular_iff_mem_nonZeroDivisors.mp <| (Commute.isRegular_iff (Commute.all _)).mpr
    (isRegular_iff_mem_nonZeroDivisors.mpr hf).left.isSMulRegular.of_flat

/-- **Statement 2.** For `A → B` flat and `M^•` a complex of `f`-torsion free `A`-modules, each
base-changed term `M^i ⊗_A B` is `g`-torsion free, where `g = algebraMap A B f`. -/
@[stacks 0GSR "the base change is g-torsion free"]
theorem isSMulRegular_baseChange_X (f : A) [Module.Flat A B] (M : CochainComplex (ModuleCat A) ℤ)
    (hM : ∀ i, IsSMulRegular (M.X i) f) (i : ℤ) :
    IsSMulRegular (B ⊗[A] (M.X i : Type _)) (algebraMap A B f) :=
  (hM i).of_flat_of_isBaseChange (TensorProduct.isBaseChange A (M.X i : Type _) B)

/-- **Sub-lemma (1): `etaBCPsi` intertwines the localized differentials.**
The comparison map `ψ = etaBCPsi` is natural in the module argument: applying the localized
differential `d` downstairs and then `ψ` equals applying `ψ` first and then the localized
base-changed differential `bcd = baseChange B d`. Concretely,
`ψ_N (fLoc f d x) = fLoc g (bcd) (ψ_M x)` for all `x ∈ M_f`.

INFORMAL ARGUMENT. Both sides are `A`-linear in `x`, and every `x ∈ M_f` is of the form
`mk(m, fⁿ)`. By `LocalizedModule.induction_on` it suffices to check on `x = mk(m, fⁿ)`.
Unwinding the definitions of `fLoc` (= `LocalizedModule.map`), `etaBCPsi` (=
`LocalizedModule.lift etaBCBaseToLoc`) and `etaBCBaseToLoc` (= `m ↦ mk_g(1 ⊗ m)`):
- `ψ_N (fLoc f d (mk(m,fⁿ)))`: `fLoc f d (mk(m,fⁿ)) = mk(d m, fⁿ)`
  (`LocalizedModule.map_mk`), and `ψ_N` of that is `(gⁿ)⁻¹ • mk_g(1 ⊗ d m)` by the lift
  formula (`LocalizedModule.lift_mk`).
- `fLoc g bcd (ψ_M (mk(m,fⁿ)))`: `ψ_M (mk(m,fⁿ)) = (gⁿ)⁻¹ • mk_g(1 ⊗ m)`, and applying
  `fLoc g bcd = LocalizedModule.map (powers g) bcd` (a `B`-, hence `A`-, linear map, so it
  commutes with the scalar action of the unit `(gⁿ)⁻¹`) gives
  `(gⁿ)⁻¹ • mk_g(bcd (1 ⊗ m))`, and `bcd (1 ⊗ m) = (baseChange B d)(1 ⊗ m) = 1 ⊗ d m`
  (`LinearMap.baseChange_tmul`).
Both sides equal `(gⁿ)⁻¹ • mk_g(1 ⊗ d m)`. STRATEGY: `induction x using
LocalizedModule.induction_on`, then `simp [etaBCPsi, etaBCBaseToLoc, fLoc,
LocalizedModule.lift_mk, LocalizedModule.map_mk, LinearMap.baseChange_tmul]`, finishing the
unit-scalar bookkeeping by hand if `simp` stalls (the unit `(gⁿ)⁻¹` is the image of `(fⁿ)⁻¹`
under the scalar tower, so the two scalar actions agree by `algebraMap_smul`). -/
theorem etaBCPsi_fLoc (f : A) {M N : Type*} [AddCommGroup M] [Module A M]
    [AddCommGroup N] [Module A N] (d : M →ₗ[A] N)
    (x : LocalizedModule (Submonoid.powers f) M) :
    etaBCPsi f N (fLoc f d x)
      = fLoc (algebraMap A B f) (LinearMap.baseChange B d) (etaBCPsi f M x) := by
  induction x using LocalizedModule.induction_on with
  | h m s =>
    show etaBCPsi f N ((LocalizedModule.map (Submonoid.powers f) d) (LocalizedModule.mk m s)) = _
    rw [LocalizedModule.map_mk, etaBCPsi, etaBCPsi,
      LocalizedModule.lift_mk, LocalizedModule.lift_mk]
    -- the localized base-changed differential sends `mk_g (1 ⊗ m)` to `mk_g (1 ⊗ d m)`
    have core : (fLoc (algebraMap A B f) (LinearMap.baseChange B d))
          (etaBCBaseToLoc (B := B) f M m)
        = etaBCBaseToLoc (B := B) f N (d m) := by
      simp only [etaBCBaseToLoc, Eta.locMap, LinearMap.coe_comp, Function.comp_apply,
        LinearMap.coe_restrictScalars, TensorProduct.mk_apply, LocalizedModule.mkLinearMap_apply,
        LocalizedModule.map_mk, LinearMap.baseChange_tmul]
    set hM := isUnit_algebraMap_end_baseChange (B := B) f M s
    set hN := isUnit_algebraMap_end_baseChange (B := B) f N s
    -- the two ambient localized base-changed modules
    set PM := LocalizedModule (Submonoid.powers (algebraMap A B f)) (B ⊗[A] M)
    set PN := LocalizedModule (Submonoid.powers (algebraMap A B f)) (B ⊗[A] N)
    -- scalar action of `↑s` via the units
    have hsmulN : ∀ w : PN, (hN.unit : Module.End A PN) w = (↑s : A) • w := fun w => by
      rw [IsUnit.unit_spec, Module.algebraMap_end_apply]
    have hsmulM : ∀ w : PM, (hM.unit : Module.End A PM) w = (↑s : A) • w := fun w => by
      rw [IsUnit.unit_spec, Module.algebraMap_end_apply]
    -- `↑s • (↑hM.unit⁻¹ z) = z` and `↑hN.unit (↑hN.unit⁻¹ z) = z`
    have hMcancel : ∀ z : PM, (↑s : A) • ((↑hM.unit⁻¹ : Module.End A PM) z) = z := fun z => by
      rw [← hsmulM, ← Module.End.mul_apply, hM.unit.mul_inv, Module.End.one_apply]
    have hNcancel : ∀ z : PN, (hN.unit : Module.End A PN) ((↑hN.unit⁻¹ : Module.End A PN) z) = z :=
      fun z => by rw [← Module.End.mul_apply, hN.unit.mul_inv, Module.End.one_apply]
    -- injectivity of `↑hN.unit`
    have hNinj : Function.Injective (⇑(hN.unit : Module.End A PN)) := fun u v huv => by
      have h2 := congrArg (fun w => (↑hN.unit⁻¹ : Module.End A PN) w) huv
      simpa only [← Module.End.mul_apply, hN.unit.inv_mul, Module.End.one_apply] using h2
    -- conclude by applying the injective `↑hN.unit`
    apply hNinj
    rw [hNcancel, hsmulN, ← LinearMap.map_smul_of_tower, hMcancel, core]

/-- A simple tensor `b ⊗ z` is `b` times `1 ⊗ z`. -/
private theorem tmul_eq_smul_one_tmul {N : Type*} [AddCommGroup N] [Module A N] (b : B) (z : N) :
    b ⊗ₜ[A] z = b • ((1 : B) ⊗ₜ[A] z) := by
  rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]

/-- `etaBCPsi` sends `mk m 1` to `mk_g (1 ⊗ m)`. -/
private theorem etaBCPsi_mk_one (f : A) (M : Type*) [AddCommGroup M] [Module A M] (m : M) :
    etaBCPsi f M (LocalizedModule.mk m (1 : Submonoid.powers f))
      = (LocalizedModule.mk ((1 : B) ⊗ₜ[A] m) 1 :
          LocalizedModule (Submonoid.powers (algebraMap A B f)) (B ⊗[A] M)) :=
  LinearMap.congr_fun (LocalizedModule.lift_comp (Submonoid.powers f) (etaBCBaseToLoc (B := B) f M)
    (isUnit_algebraMap_end_baseChange (B := B) f M)) m

/-- `ψ` carries the action of the unit `Stacks.GradedLaurent.awayUnit f` on `M_f` to the action
of the corresponding unit `Stacks.GradedLaurent.awayUnit g` on `(B⊗M)_g`. -/
theorem etaBCPsi_fUnit_smul (f : A) (P : Type*) [AddCommGroup P] [Module A P]
    (y : LocalizedModule (Submonoid.powers f) P) :
    etaBCPsi f P ((↑(Stacks.GradedLaurent.awayUnit f) : Localization (Submonoid.powers f)) • y)
      = (↑(Stacks.GradedLaurent.awayUnit (algebraMap A B f)) :
            Localization (Submonoid.powers (algebraMap A B f)))
          • (etaBCPsi f P y :
              LocalizedModule (Submonoid.powers (algebraMap A B f)) (B ⊗[A] P)) := by
  have h1 : (↑(Stacks.GradedLaurent.awayUnit f) : Localization (Submonoid.powers f)) • y = f • y :=
    fUnit_smul y
  have h2 : (↑(Stacks.GradedLaurent.awayUnit (algebraMap A B f)) :
        Localization (Submonoid.powers (algebraMap A B f)))
      • (etaBCPsi f P y :
          LocalizedModule (Submonoid.powers (algebraMap A B f)) (B ⊗[A] P))
      = (algebraMap A B f) • etaBCPsi f P y := fUnit_smul _
  rw [h1, h2, map_smul, algebraMap_smul B]

/-- `ψ` commutes with the inverse of the unit `Stacks.GradedLaurent.awayUnit f`. -/
theorem etaBCPsi_fUnit_inv_smul (f : A) (P : Type*) [AddCommGroup P] [Module A P]
    (y : LocalizedModule (Submonoid.powers f) P) :
    etaBCPsi f P ((↑(Stacks.GradedLaurent.awayUnit f)⁻¹ : Localization (Submonoid.powers f)) • y)
      = (↑(Stacks.GradedLaurent.awayUnit (algebraMap A B f))⁻¹ :
            Localization (Submonoid.powers (algebraMap A B f)))
          • (etaBCPsi f P y :
              LocalizedModule (Submonoid.powers (algebraMap A B f)) (B ⊗[A] P)) := by
  have key := etaBCPsi_fUnit_smul (B := B) f P
    ((↑(Stacks.GradedLaurent.awayUnit f)⁻¹ : Localization (Submonoid.powers f)) • y)
  rw [smul_smul, Units.mul_inv, one_smul] at key
  conv_rhs => rw [key]
  rw [smul_smul, Units.inv_mul, one_smul]

/-- `ψ` commutes with any integer power of the unit `Stacks.GradedLaurent.awayUnit f`. -/
theorem etaBCPsi_fUnit_zpow_smul (f : A) (P : Type*) [AddCommGroup P] [Module A P]
    (k : ℤ) (y : LocalizedModule (Submonoid.powers f) P) :
    etaBCPsi f P
        ((↑((Stacks.GradedLaurent.awayUnit f) ^ k) : Localization (Submonoid.powers f)) • y)
      = (↑((Stacks.GradedLaurent.awayUnit (algebraMap A B f)) ^ k) :
            Localization (Submonoid.powers (algebraMap A B f)))
          • (etaBCPsi f P y :
              LocalizedModule (Submonoid.powers (algebraMap A B f)) (B ⊗[A] P)) := by
  induction k using Int.induction_on generalizing y with
  | zero => simp
  | succ n ih =>
      rw [zpow_add_one, zpow_add_one]
      push_cast
      rw [mul_smul, mul_smul, ih, etaBCPsi_fUnit_smul]
  | pred n ih =>
      rw [zpow_sub_one, zpow_sub_one]
      push_cast
      rw [mul_smul, mul_smul, ih, etaBCPsi_fUnit_inv_smul]

/-- The generator identity `ψ (fpowMap f P k p) = fpowMap g (B⊗P) k (1 ⊗ p)`. -/
theorem etaBCPsi_fpowMap (f : A) (P : Type*) [AddCommGroup P] [Module A P] (k : ℤ) (p : P) :
    etaBCPsi f P (fpowMap f P k p)
      = fpowMap (algebraMap A B f) (B ⊗[A] P) k ((1 : B) ⊗ₜ[A] p) := by
  rw [fpowMap_apply, fpowMap_apply, toLoc_apply, toLoc_apply, Units.smul_def, Units.smul_def,
    etaBCPsi_fUnit_zpow_smul, etaBCPsi_mk_one]

/-- **Sub-lemma (2): `etaBCPsi` carries `fᵏ M` into `gᵏ (B ⊗ M)`.**
The comparison map sends the submodule `fpowSub f M j = fʲ M ⊆ M_f` into
`fpowSub g (B⊗M) j = gʲ (B⊗M) ⊆ (B⊗M)_g`.

An element of `fʲ M = range (fpowMap f M j)` is `fpowMap f M j p` for some `m = p`.
By `etaBCPsi_fpowMap`, `ψ (fpowMap f M j p) = fpowMap g (B⊗M) j (1 ⊗ p)`, which lies in
`range (fpowMap g (B⊗M) j) = fpowSub g (B⊗M) j`. -/
theorem etaBCPsi_mem_fpowSub (f : A) (M : Type*) [AddCommGroup M] [Module A M] (j : ℤ)
    {x : LocalizedModule (Submonoid.powers f) M} (hx : x ∈ fpowSub f M j) :
    etaBCPsi f M x
      ∈ fpowSub (algebraMap A B f) (B ⊗[A] M) j := by
  -- `x ∈ fpowSub f M j = range (fpowMap f M j)`, so `x = fpowMap f M j p`.
  rw [fpowSub_eq_range] at hx
  obtain ⟨p, rfl⟩ := hx
  -- `ψ (fpowMap f M j p) = fpowMap g (B⊗M) j (1 ⊗ p)` by `etaBCPsi_fpowMap`, which is in the
  -- range.
  rw [etaBCPsi_fpowMap, fpowSub_eq_range]
  exact ⟨(1 : B) ⊗ₜ[A] p, rfl⟩

/-- **Sub-lemma (3): the easy inclusion `(η_f M)^i ⊗ B ≤ η_g (M ⊗ B)^i`.**
`etaBaseChangeTerm f M i ≤ fetaTerm g bcd i`, where `g = algebraMap A B f`,
`bcd = baseChange B (d^i)`.

INFORMAL ARGUMENT. `etaBaseChangeTerm f M i` is the `B`-span of `ψ '' (η_f M)^i`. By
`Submodule.span_le` it suffices to show every generator `ψ x`, for `x ∈ (η_f M)^i`, lies in
the `B`-submodule `fetaTerm g bcd i = gⁱ(B⊗Mi) ⊓ (g^{i+1}(B⊗Mi1)).comap (fLoc g bcd)`.
- First component: `x ∈ fⁱ Mi`, so by Sub-lemma (2) `ψ x ∈ gⁱ (B⊗Mi)`.
- Second component: `fLoc f d x ∈ f^{i+1} Mi1`; by Sub-lemma (1)
  `fLoc g bcd (ψ x) = ψ (fLoc f d x)`, and by Sub-lemma (2) (at `i+1`)
  `ψ (fLoc f d x) ∈ g^{i+1}(B⊗Mi1)`. Hence `ψ x ∈ (g^{i+1}(B⊗Mi1)).comap (fLoc g bcd)`. -/
theorem etaBaseChangeTerm_le_fetaTerm (f : A) (M : CochainComplex (ModuleCat A) ℤ) (i : ℤ) :
    etaBaseChangeTerm f M i
      ≤ fetaTerm (algebraMap A B f) (LinearMap.baseChange B (M.d i (i + 1)).hom) i := by
  apply Submodule.span_le.mpr
  rintro _ ⟨x, hx, rfl⟩
  rw [SetLike.mem_coe, mem_fetaTerm] at hx
  obtain ⟨hx1, hx2⟩ := hx
  rw [SetLike.mem_coe, mem_fetaTerm]
  refine ⟨etaBCPsi_mem_fpowSub f (M.X i) i hx1, ?_⟩
  rw [← etaBCPsi_fLoc f (M.d i (i + 1)).hom x]
  exact etaBCPsi_mem_fpowSub f (M.X (i + 1)) (i + 1) hx2

/-- **Sub-lemma (4a): `fpow` base-changes to `fpow` (Lemma A of the informal proof).**
The base-changed power submodule `gᵏ (B⊗P)` inside `(B⊗P)_g` is exactly the `B`-span of the
`ψ`-image of the power submodule `fᵏ P` inside `P_f`.

INFORMAL ARGUMENT (no flatness). `fpowSub g (B⊗P) k` is the `B`-submodule of `(B⊗P)_g`
generated by `(gUnit g)ᵏ • mk_g(ξ)`, `ξ ∈ B⊗P`. As `mk_g` is `B`-linear and additive and the
simple tensors `b ⊗ p` generate `B⊗P`, this is the `B`-span of
`(gUnit g)ᵏ • mk_g(b ⊗ p) = b • (gUnit g)ᵏ • mk_g(1 ⊗ p)`, which equals
`b • ψ((Stacks.GradedLaurent.awayUnit f)ᵏ • mk(p))` by the defining formula of `ψ` (cf. the
generator computation inside `etaBCPsi_mem_fpowSub`). The generators
`(Stacks.GradedLaurent.awayUnit f)ᵏ • mk(p) = fpowMap f P k p` range over a generating set of
`fpowSub f P k`, so the `B`-span equals `span B (ψ '' fpowSub f P k)`.

STRATEGY. `apply le_antisymm`.
* `⊇`: `Submodule.span_le`; each generator `ψ x` with `x ∈ fpowSub f P k` lies in
  `fpowSub g (B⊗P) k` by `etaBCPsi_mem_fpowSub`.
* `⊆`: `fpowSub g (B⊗P) k = LinearMap.range (fpowMap g (B⊗P) k)`; rewrite `range` as a
  `span` of generators `fpowMap g (B⊗P) k ξ` and reduce on `ξ` via the simple-tensor generators
  of `B ⊗ P` (`TensorProduct.span_tmul_eq_top` / induction), matching `fpowMap g (B⊗P) k (b⊗p)`
  with `b • ψ (fpowMap f P k p)` (`etaBCPsi_mem_fpowSub`'s generator identity + `B`-linearity of
  `fpowMap g` and of `mk_g`). -/
theorem fpowSub_baseChange_eq (f : A) (P : Type*) [AddCommGroup P] [Module A P] (k : ℤ) :
    fpowSub (algebraMap A B f) (B ⊗[A] P) k
      = Submodule.span B
          ((etaBCPsi f P) '' (fpowSub f P k :
            Set (LocalizedModule (Submonoid.powers f) P))) := by
  apply le_antisymm
  · rw [fpowSub_eq_range]
    rintro y ⟨ξ, rfl⟩
    induction ξ using TensorProduct.induction_on with
    | zero => simp
    | tmul b p =>
        rw [tmul_eq_smul_one_tmul, map_smul, ← etaBCPsi_fpowMap]
        exact Submodule.smul_mem _ _
          (Submodule.subset_span ⟨fpowMap f P k p, (fpowSub_eq_range k).ge ⟨p, rfl⟩, rfl⟩)
    | add ξ η hξ hη =>
        rw [map_add]
        exact Submodule.add_mem _ hξ hη
  · rw [Submodule.span_le]
    rintro _ ⟨x, hx, rfl⟩
    exact etaBCPsi_mem_fpowSub f P k hx

/-- Forward action of `equivTensorProduct` on `mk m 1`. -/
theorem equivTensorProduct_mk_one (f : A) (M : Type*) [AddCommGroup M] [Module A M] (m : M) :
    (LocalizedModule.equivTensorProduct (Submonoid.powers f) M) (LocalizedModule.mk m 1)
      = (1 : Localization (Submonoid.powers f)) ⊗ₜ[A] m := by
  apply (LocalizedModule.equivTensorProduct (Submonoid.powers f) M).symm.injective
  rw [LinearEquiv.symm_apply_apply]; simp [LocalizedModule.equivTensorProduct]

/-- Backward action of `equivTensorProduct` on `1 ⊗ m`. -/
theorem equivTensorProduct_symm_one_tmul (f : A) (M : Type*) [AddCommGroup M] [Module A M] (m : M) :
    (LocalizedModule.equivTensorProduct (Submonoid.powers f) M).symm
        ((1 : Localization (Submonoid.powers f)) ⊗ₜ[A] m) = LocalizedModule.mk m 1 := by
  simp [LocalizedModule.equivTensorProduct]

/-- The canonical iso of a localized module evaluated on `mk m 1`. -/
theorem iso_apply_mk_one (f : A) {M M' : Type*} [AddCommGroup M] [Module A M]
    [AddCommGroup M'] [Module A M'] (φ : M →ₗ[A] M') [IsLocalizedModule (Submonoid.powers f) φ]
    (m : M) :
    (IsLocalizedModule.iso (Submonoid.powers f) φ) (LocalizedModule.mk m 1) = φ m := by
  rw [IsLocalizedModule.iso_apply_mk]; simp

/-- The `A`-linear iso `(B ⊗ M)_f ≃ B ⊗ M'` when `M'` localizes `M` at `powers f`. -/
noncomputable def bchEquiv (f : A)
    {M M' : Type*} [AddCommGroup M] [Module A M] [AddCommGroup M'] [Module A M']
    (φ : M →ₗ[A] M') [IsLocalizedModule (Submonoid.powers f) φ] :
    LocalizedModule (Submonoid.powers f) (B ⊗[A] M) ≃ₗ[A] B ⊗[A] M' :=
  ((LocalizedModule.equivTensorProduct (Submonoid.powers f) (B ⊗[A] M)).restrictScalars A).trans
    ((TensorProduct.leftComm A (Localization (Submonoid.powers f)) B M).trans
      ((TensorProduct.congr (LinearEquiv.refl A B)
          ((LocalizedModule.equivTensorProduct (Submonoid.powers f) M).restrictScalars
              A).symm).trans
        (TensorProduct.congr (LinearEquiv.refl A B) (IsLocalizedModule.iso (Submonoid.powers f)
            φ))))

/-- `bchEquiv f φ` sends `mk (b ⊗ m) 1` to `b ⊗ φ m`. -/
theorem bchEquiv_mk (f : A)
    {M M' : Type*} [AddCommGroup M] [Module A M] [AddCommGroup M'] [Module A M']
    (φ : M →ₗ[A] M') [IsLocalizedModule (Submonoid.powers f) φ] (b : B) (m : M) :
    bchEquiv (B := B) f φ (LocalizedModule.mk (b ⊗ₜ[A] m) 1) = b ⊗ₜ[A] φ m := by
  unfold bchEquiv
  simp only [LinearEquiv.trans_apply, LinearEquiv.restrictScalars_apply]
  rw [equivTensorProduct_mk_one, TensorProduct.leftComm_tmul]
  simp only [TensorProduct.congr_tmul, LinearEquiv.refl_apply]
  rw [LinearEquiv.restrictScalars_symm_apply, equivTensorProduct_symm_one_tmul, iso_apply_mk_one]

/-- Precomposing `bchEquiv f φ` with the localization map of `B ⊗ M` gives the base change
`φ ⊗ id_B`, viewed as an `A`-linear map. -/
theorem bchEquiv_comp (f : A)
    {M M' : Type*} [AddCommGroup M] [Module A M] [AddCommGroup M'] [Module A M']
    (φ : M →ₗ[A] M') [IsLocalizedModule (Submonoid.powers f) φ] :
    (bchEquiv (B := B) f φ : _ →ₗ[A] _)
        ∘ₗ (LocalizedModule.mkLinearMap (Submonoid.powers f) (B ⊗[A] M))
      = (LinearMap.baseChange B φ).restrictScalars A := by
  apply LinearMap.ext
  intro x
  simp only [LinearMap.coe_comp, Function.comp_apply, LocalizedModule.mkLinearMap_apply,
    LinearMap.coe_restrictScalars, LinearEquiv.coe_coe]
  induction x with
  | tmul b m => rw [LinearMap.baseChange_tmul]; exact bchEquiv_mk (B := B) f φ b m
  | add x y hx hy =>
      rw [show LocalizedModule.mk (x + y) (1 : Submonoid.powers f)
            = LocalizedModule.mk x 1 + LocalizedModule.mk y 1 by
          rw [LocalizedModule.mk_add_mk]; simp]
      rw [map_add, map_add, hx, hy]

/-- If `φ : M → M'` is a localization at the powers of `f`, then so is its base change
`B ⊗ M → B ⊗ M'`, viewed as an `A`-linear map. -/
theorem isLocalizedModule_baseChange_restrictScalars (f : A)
    {M M' : Type*} [AddCommGroup M] [Module A M] [AddCommGroup M'] [Module A M']
    (φ : M →ₗ[A] M') [IsLocalizedModule (Submonoid.powers f) φ] :
    IsLocalizedModule (Submonoid.powers f) ((LinearMap.baseChange B φ).restrictScalars A) := by
  rw [← bchEquiv_comp (B := B) f φ]
  exact IsLocalizedModule.of_linearEquiv (Submonoid.powers f)
    (LocalizedModule.mkLinearMap (Submonoid.powers f) (B ⊗[A] M)) (bchEquiv (B := B) f φ)

/-- Base change of a localized-module map is a localized module at the image submonoid. -/
theorem isLocalizedModule_baseChange (f : A)
    {M M' : Type*} [AddCommGroup M] [Module A M] [AddCommGroup M'] [Module A M']
    (φ : M →ₗ[A] M') [IsLocalizedModule (Submonoid.powers f) φ] :
    IsLocalizedModule (Submonoid.powers (algebraMap A B f)) (LinearMap.baseChange B φ) := by
  have hsub : Submonoid.powers (algebraMap A B f)
      = Algebra.algebraMapSubmonoid B (Submonoid.powers f) := by
    rw [Algebra.algebraMapSubmonoid, ← Submonoid.map_powers]
  rw [hsub]
  have := isLocalizedModule_baseChange_restrictScalars (B := B) f φ
  exact IsLocalizedModule.of_restrictScalars (Submonoid.powers f) (LinearMap.baseChange B φ)

/-- Flat base change preserves kernels. -/
theorem baseChange_ker [Module.Flat A B]
    {M N : Type*} [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (d : M →ₗ[A] N) :
    Submodule.baseChange B (LinearMap.ker d) = LinearMap.ker (LinearMap.baseChange B d) := by
  have h := Module.Flat.ker_lTensor_eq (R := A) B (M := B) d
  have he : (TensorProduct.AlgebraTensorModule.lTensor B B d) = LinearMap.baseChange B d := by
    ext b; simp [TensorProduct.AlgebraTensorModule.lTensor, LinearMap.baseChange_tmul]
  have he2 : (TensorProduct.AlgebraTensorModule.lTensor B B (LinearMap.ker d).subtype)
      = LinearMap.baseChange B (LinearMap.ker d).subtype := by
    ext b; simp [TensorProduct.AlgebraTensorModule.lTensor, LinearMap.baseChange_tmul]
  rw [he, he2] at h
  rw [Submodule.baseChange, ← h]

/-- Flat base change of a submodule `W` is the kernel of the base change of `W.mkQ`. -/
private theorem baseChange_eq_ker_baseChange_mkQ [Module.Flat A B]
    {M : Type*} [AddCommGroup M] [Module A M] (W : Submodule A M) :
    Submodule.baseChange B W = LinearMap.ker (LinearMap.baseChange B W.mkQ) := by
  rw [← baseChange_ker (B := B) W.mkQ, Submodule.ker_mkQ]

/-- Flat base change commutes with `Submodule.comap`. -/
theorem baseChange_comap [Module.Flat A B]
    {M N : Type*} [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (L : M →ₗ[A] N) (W : Submodule A N) :
    Submodule.baseChange B (W.comap L)
      = Submodule.comap (LinearMap.baseChange B L) (Submodule.baseChange B W) := by
  have e1 : W.comap L = LinearMap.ker (W.mkQ ∘ₗ L) := by
    rw [LinearMap.ker_comp, Submodule.ker_mkQ]
  rw [e1, baseChange_ker (B := B) (W.mkQ ∘ₗ L), baseChange_eq_ker_baseChange_mkQ,
    LinearMap.baseChange_comp, LinearMap.ker_comp]

/-- Flat base change commutes with intersection of submodules. -/
theorem baseChange_inf [Module.Flat A B]
    {M : Type*} [AddCommGroup M] [Module A M] (W1 W2 : Submodule A M) :
    Submodule.baseChange B (W1 ⊓ W2)
      = Submodule.baseChange B W1 ⊓ Submodule.baseChange B W2 := by
  have e1 : W1 ⊓ W2 = LinearMap.ker ((W1.mkQ).prod (W2.mkQ)) := by
    rw [LinearMap.ker_prod, Submodule.ker_mkQ, Submodule.ker_mkQ]
  have eprod : LinearMap.ker (LinearMap.baseChange B ((W1.mkQ).prod (W2.mkQ)))
      = LinearMap.ker ((LinearMap.baseChange B W1.mkQ).prod (LinearMap.baseChange B W2.mkQ)) := by
    have hcomp : ((TensorProduct.prodRight A B B (M ⧸ W1) (M ⧸ W2)).toLinearMap).comp
            (LinearMap.baseChange B ((W1.mkQ).prod (W2.mkQ)))
        = (LinearMap.baseChange B W1.mkQ).prod (LinearMap.baseChange B W2.mkQ) := by
      ext x
      · simp [LinearMap.baseChange_tmul]
      · simp [LinearMap.baseChange_tmul]
    rw [← hcomp]
    refine (LinearMap.ker_comp_of_ker_eq_bot _ ?_).symm
    rw [LinearMap.ker_eq_bot]
    exact (TensorProduct.prodRight A B B _ _).injective
  rw [e1, baseChange_ker (B := B) ((W1.mkQ).prod (W2.mkQ)), eprod, LinearMap.ker_prod,
    baseChange_eq_ker_baseChange_mkQ, baseChange_eq_ker_baseChange_mkQ]

/-- The localization-base-change iso `B ⊗ M_f ≃ₗ[B] (B⊗M)_g`. -/
noncomputable def psiEquiv (f : A) (M : Type*) [AddCommGroup M] [Module A M] :
    (B ⊗[A] LocalizedModule (Submonoid.powers f) M) ≃ₗ[B]
      LocalizedModule (Submonoid.powers (algebraMap A B f)) (B ⊗[A] M) :=
  letI := isLocalizedModule_baseChange (B := B) f
    (LocalizedModule.mkLinearMap (Submonoid.powers f) M)
  IsLocalizedModule.linearEquiv (Submonoid.powers (algebraMap A B f))
    (LinearMap.baseChange B (LocalizedModule.mkLinearMap (Submonoid.powers f) M))
    (LocalizedModule.mkLinearMap (Submonoid.powers (algebraMap A B f)) (B ⊗[A] M))

/-- `etaBCPsi` is the localization-base-change iso precomposed with `z ↦ 1 ⊗ z`. -/
theorem etaBCPsi_eq_psiEquiv (f : A) (M : Type*) [AddCommGroup M] [Module A M]
    (z : LocalizedModule (Submonoid.powers f) M) :
    etaBCPsi f M z = psiEquiv f M ((1 : B) ⊗ₜ[A] z) := by
  let := isLocalizedModule_baseChange (B := B) f
    (LocalizedModule.mkLinearMap (Submonoid.powers f) M)
  have key : (etaBCPsi f M)
      = ((((psiEquiv (B := B) f M).restrictScalars A).toLinearMap : _ →ₗ[A] _).comp
          ((TensorProduct.mk A B (LocalizedModule (Submonoid.powers f) M) 1))) := by
    apply IsLocalizedModule.ext (Submonoid.powers f)
      (LocalizedModule.mkLinearMap (Submonoid.powers f) M) (isUnit_algebraMap_end_baseChange f M)
    apply LinearMap.ext
    intro m
    simp only [LinearMap.coe_comp, Function.comp_apply,
      LinearEquiv.coe_coe, TensorProduct.mk_apply, LocalizedModule.mkLinearMap_apply]
    rw [etaBCPsi_mk_one]
    have h1 : (1 : B) ⊗ₜ[A] (LocalizedModule.mk m (1 : Submonoid.powers f))
        = LinearMap.baseChange B (LocalizedModule.mkLinearMap (Submonoid.powers f) M)
            ((1 : B) ⊗ₜ[A] m) := by
      rw [LinearMap.baseChange_tmul, LocalizedModule.mkLinearMap_apply]
    rw [h1, psiEquiv, LinearEquiv.restrictScalars_apply,
      IsLocalizedModule.linearEquiv_apply (Submonoid.powers (algebraMap A B f))
        (LinearMap.baseChange B (LocalizedModule.mkLinearMap (Submonoid.powers f) M))
        (LocalizedModule.mkLinearMap (Submonoid.powers (algebraMap A B f)) (B ⊗[A] M))]
    rfl
  exact LinearMap.congr_fun key z

/-- Bridge: the `B`-span of the `ψ`-image of a submodule `W` is the `Ψ`-image of `W`'s
base change. -/
theorem span_image_etaBCPsi (f : A) (M : Type*) [AddCommGroup M] [Module A M]
    (W : Submodule A (LocalizedModule (Submonoid.powers f) M)) :
    Submodule.span B ((etaBCPsi (B := B) f M) ''
        (W : Set (LocalizedModule (Submonoid.powers f) M)))
      = Submodule.map (psiEquiv (B := B) f M : _ →ₗ[B] _) (Submodule.baseChange B W) := by
  rw [Submodule.baseChange_eq_span, Submodule.map_span, Submodule.map_coe,
    ← Set.image_comp]
  congr 1
  apply Set.image_congr'
  intro z
  simp only [Function.comp_apply, TensorProduct.mk_apply]
  rw [etaBCPsi_eq_psiEquiv]
  rfl

/-- **Sub-lemma (4b-i): flatness `comap` step (eq. (12) of the informal proof).**
The base-changed pullback `(g^{i+1}(B⊗N)).comap (fLoc g bcd)` equals the `B`-span of the
`ψ`-image of the `A`-pullback `(f^{i+1} N).comap (fLoc f d)`. This is the single genuinely
flatness-using obligation: by the kernel presentation `comap L W = ker (quot_W ∘ L)` and
`Module.Flat.lTensor_exact`, base change commutes with this `comap`. It is stated for an
arbitrary `A`-linear `d : M → N` (the differential), transported through the
localization-base-change iso `Ψ` (with `Ψ(z⊗1) = etaBCPsi z`) so that `fLoc g (baseChange B
d)`
becomes the transported `fLoc f d` (`etaBCPsi_fLoc`) and `fpowSub g (B⊗N)`
becomes `span B (ψ '' fpowSub f N)` (Sub-lemma 4a `fpowSub_baseChange_eq`).

STRATEGY. Present `comap (fLoc f d) (fpowSub f N (i+1))` as the kernel of
`N1f_quotient ∘ (fLoc f d)` where `N1f_quotient : Mi1_f → Mi1_f / fpowSub f N (i+1)`,
giving an exact sequence `0 → comap … → Mi_f → Mi1_f/V`. Apply `Module.Flat.lTensor_exact`
(and `Module.Flat.lTensor_preserves_injective_linearMap` for the injection at the left) to base
change it; identify the base-changed kernel with the `g`-side `comap` via the localization isos
`Ψ, Ψ'` and `etaBCPsi_fLoc`, and the base-changed quotient's submodule via
`fpowSub_baseChange_eq`. -/
theorem comap_fLoc_baseChange_eq (f : A) [Module.Flat A B] {M N : Type*}
    [AddCommGroup M] [Module A M] [AddCommGroup N] [Module A N]
    (d : M →ₗ[A] N) (k : ℤ) :
    (fpowSub (algebraMap A B f) (B ⊗[A] N) k).comap
        (fLoc (algebraMap A B f) (LinearMap.baseChange B d))
      = Submodule.span B
          ((etaBCPsi f M) ''
            ((fpowSub f N k).comap (fLoc f d) :
              Set (LocalizedModule (Submonoid.powers f) M))) := by
  set V : Submodule A (LocalizedModule (Submonoid.powers f) N) := fpowSub f N k
  set L : LocalizedModule (Submonoid.powers f) M →ₗ[A] LocalizedModule (Submonoid.powers f) N
    := fLoc f d
  -- the intertwining of `fLoc g bcd` with `Ψ_M, Ψ_N`
  have hint : (fLoc (algebraMap A B f) (LinearMap.baseChange B d)).comp
        (psiEquiv (B := B) f M : _ →ₗ[B] _)
      = (psiEquiv (B := B) f N : _ →ₗ[B] _).comp
        (LinearMap.baseChange B L) := by
    apply TensorProduct.AlgebraTensorModule.curry_injective
    apply LinearMap.ext; intro b
    apply LinearMap.ext; intro z
    simp only [TensorProduct.AlgebraTensorModule.curry_apply, LinearMap.coe_comp,
      LinearMap.coe_restrictScalars, Function.comp_apply, TensorProduct.curry_apply,
      LinearEquiv.coe_coe]
    rw [tmul_eq_smul_one_tmul, map_smul, map_smul, ← etaBCPsi_eq_psiEquiv, map_smul,
      ← etaBCPsi_fLoc f d z, map_smul, LinearMap.baseChange_tmul, ← etaBCPsi_eq_psiEquiv]
  -- RHS rewritten via the bridge and flat base change of comap
  rw [span_image_etaBCPsi f M ((fpowSub f N k).comap (fLoc f d))]
  -- LHS: fpow g = map Ψ_N (baseChange B V)
  rw [fpowSub_baseChange_eq f N k, span_image_etaBCPsi f N V]
  -- baseChange of comap = comap of baseChange (flatness)
  rw [baseChange_comap (B := B) L V]
  -- transport: the map equation Ψ_N.symm ∘ fLoc g bcd = baseChange L ∘ Ψ_M.symm
  have hsymm : ((psiEquiv (B := B) f N).symm : _ →ₗ[B] _).comp
        (fLoc (algebraMap A B f) (LinearMap.baseChange B d))
      = (LinearMap.baseChange B L).comp ((psiEquiv (B := B) f M).symm : _ →ₗ[B] _) := by
    apply LinearMap.ext; intro y
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe]
    have := LinearMap.congr_fun hint ((psiEquiv (B := B) f M).symm y)
    simp only [LinearMap.coe_comp, Function.comp_apply, LinearEquiv.coe_coe,
      LinearEquiv.apply_symm_apply] at this
    rw [this, LinearEquiv.symm_apply_apply]
  rw [Submodule.map_equiv_eq_comap_symm (psiEquiv (B := B) f N) (Submodule.baseChange B V),
    ← Submodule.comap_comp, hsymm, Submodule.comap_comp,
    Submodule.map_equiv_eq_comap_symm (psiEquiv (B := B) f M)]

/-- **Sub-lemma (4b-ii): flatness `⊓` step (Lemma C / eq. (13) of the informal proof).**
The `B`-span of the `ψ`-image commutes with intersection: for submodules `W1 W2` of `M_f`,
`span B (ψ '' (W1 ⊓ W2)) = span B (ψ '' W1) ⊓ span B (ψ '' W2)`. This is the flat-intersection
step: apply `Module.Flat.lTensor_exact` to `0 → W1 ⊓ W2 → M_f → M_f/W1 ⊕ M_f/W2` (so that
`W1 ⊓ W2 = ker (q1, q2)`), and transport through the localization-base-change iso `Ψ`. Only the
`≥` inclusion uses flatness; `≤` (`span B (ψ '' (W1 ⊓ W2)) ≤ span B (ψ '' W1) ⊓ span B (ψ '' W2)`)
is purely monotonicity of `span`/`image` under `W1 ⊓ W2 ≤ W1`, `≤ W2`. -/
@[ega "0 1.3.2" "more general", ega "0 6.1.3" "special case"]
theorem span_image_etaBCPsi_inf (f : A) [Module.Flat A B] {M : Type*}
    [AddCommGroup M] [Module A M]
    (W1 W2 : Submodule A (LocalizedModule (Submonoid.powers f) M)) :
    Submodule.span B
        ((etaBCPsi (B := B) f M) ''
          ((W1 ⊓ W2 : Submodule A (LocalizedModule (Submonoid.powers f) M)) :
            Set (LocalizedModule (Submonoid.powers f) M)))
      = (Submodule.span B
            ((etaBCPsi (B := B) f M) '' (W1 : Set (LocalizedModule (Submonoid.powers f) M))))
          ⊓ (Submodule.span B
            ((etaBCPsi (B := B) f M) '' (W2 : Set (LocalizedModule (Submonoid.powers f) M)))) := by
  rw [span_image_etaBCPsi f M (W1 ⊓ W2), span_image_etaBCPsi f M W1, span_image_etaBCPsi f M W2,
    baseChange_inf (B := B) W1 W2,
    Submodule.map_equiv_eq_comap_symm, Submodule.map_equiv_eq_comap_symm,
    Submodule.map_equiv_eq_comap_symm, Submodule.comap_inf]

/-- For `A → B` flat and `g` the image of `f`, the degree-`i` décalage term of the base-changed
complex `M^• ⊗_A B` with respect to `g` equals the base change `(η_f M)^i ⊗_A B`. -/
theorem fetaTerm_baseChange_eq (f : A) [Module.Flat A B] (M : CochainComplex (ModuleCat A) ℤ)
    (i : ℤ) :
    fetaTerm (algebraMap A B f) (LinearMap.baseChange B (M.d i (i + 1)).hom) i
      = etaBaseChangeTerm f M i := by
  rw [fetaTerm_eq_inf]
  rw [fpowSub_baseChange_eq f (M.X i) i]
  rw [comap_fLoc_baseChange_eq f (M.d i (i + 1)).hom (i + 1)]
  rw [← span_image_etaBCPsi_inf f (fpowSub f (M.X i) i)
        ((fpowSub f (M.X (i + 1)) (i + 1)).comap (fLoc f (M.d i (i + 1)).hom))]
  rw [etaBaseChangeTerm, fetaTerm_eq_inf]

/-- **Statement 3.** With the identification of Definition 4,
`η_f M^• ⊗_A B = η_g (M^• ⊗_A B)` as complexes of `g`-torsion free `B`-modules.

This is the equality, for every `i ∈ ℤ`, of two `B`-submodules of the common ambient module
`(M^i ⊗_A B)_g = LocalizedModule (powers g) (B ⊗_A M^i)`:

* the base change `(η_f M)^i ⊗_A B` (`etaBaseChangeTerm f M i`), and
* the degree-`i` term `(η_g (M^• ⊗_A B))^i` of the décalage of the base-changed complex,
  `fetaTerm g (d^i ⊗ id_B) i`.

The second conjunct records compatibility with the differentials: the localized base-changed
differential `d^i ⊗ id_B` carries the degree-`i` term into the degree-`(i+1)` term, exhibiting
the equality as an equality of *subcomplexes*. -/
@[stacks 0GSR "eta commutes with the base change"]
theorem etaBaseChangeTerm_eq_fetaTerm (f : A) [Module.Flat A B] (M : CochainComplex (ModuleCat A) ℤ)
    (i : ℤ) :
    (etaBaseChangeTerm f M i
        = fetaTerm (algebraMap A B f)
            (LinearMap.baseChange B (M.d i (i + 1)).hom) i) ∧
      Submodule.map (fLoc (algebraMap A B f) (LinearMap.baseChange B (M.d i (i + 1)).hom))
          (fetaTerm (algebraMap A B f) (LinearMap.baseChange B (M.d i (i + 1)).hom) i)
        ≤ fetaTerm (algebraMap A B f) (LinearMap.baseChange B (M.d (i + 1) (i + 1 + 1)).hom) (i +
            1) := by
  refine ⟨?_, ?_⟩
  · exact le_antisymm (etaBaseChangeTerm_le_fetaTerm f M i) (fetaTerm_baseChange_eq f M i).le
  · apply fetaTerm_map_le
    rw [← LinearMap.baseChange_comp, d_hom_comp_d_hom M i (i + 1) (i + 1 + 1),
      LinearMap.baseChange_zero]

@[deprecated (since := "2026-09-27")]
alias etaBaseChangeTerm_eq_fetaTerm_and_map_le := etaBaseChangeTerm_eq_fetaTerm

end Stacks.Eta.BaseChange
