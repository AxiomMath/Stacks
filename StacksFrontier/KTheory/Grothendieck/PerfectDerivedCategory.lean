module

public import Mathlib.Algebra.Category.ModuleCat.Biproducts
public import Mathlib.CategoryTheory.Preadditive.AdditiveFunctor
public import StacksFrontier.CategoryTheory.Triangulated.KGroup.Basic
public import StacksFrontier.CategoryTheory.Triangulated.OperationsOnFullSubcategories
public import StacksFrontier.Homology.Perfect.Characterizing
public import StacksFrontier.KTheory.Grothendieck.PerfectComplex

/-!
# `K₀` of the perfect derived category

Let `R` be a commutative ring. The Euler characteristic of a perfect complex is additive on
distinguished triangles, so it descends to a homomorphism from the `K`-group of the perfect
derived category to `K₀(R)`; sending a finite projective module to its class in degree zero is
inverse to it, because the perfect objects are generated by `R` as a triangulated subcategory.
Hence the two `K`-groups agree.

## Main results

* `K0.exists_k0_perfectDerivedCategory_addEquiv`: for the property of being perfect, the
  `K`-group of the corresponding full subcategory of the derived category is isomorphic to
  `K₀(R)`, by an isomorphism computing the class of an object as the alternating sum of the
  classes of the terms of a bounded finite-projective representative.

## Implementation notes

The `K`-group of a triangulated category is `CategoryTheory.Pretriangulated.K0`, the free abelian
group on objects modulo the relations of distinguished triangles; the class of an object is
`CategoryTheory.Pretriangulated.K0.cls`. Both directions are built by descending a map defined on
the free abelian group, using that a homomorphism out of either `K`-group is determined by its
values on classes of objects.

## References

* [Stacks Project, Tag 0FCU](https://stacks.math.columbia.edu/tag/0FCU)
-/

section

universe u

open CategoryTheory

attribute [local instance] HasDerivedCategory.standard

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Pretriangulated
open CategoryTheory.Limits
open ZeroObject
open ComplexShape

attribute [local instance] HasDerivedCategory.standard

variable (R : Type u) [CommRing R]

private abbrev Perf : ObjectProperty (DerivedCategory (ModuleCat.{u} R)) :=
  (ObjectProperty.singleton
    ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
      (ModuleCat.of R R))).triangEnvelope

private noncomputable instance : ObjectProperty.IsTriangulated (Perf R) := by
  infer_instance

private noncomputable instance : (Perf R).ContainsZero :=
  ObjectProperty.IsTriangulated.toContainsZero

private noncomputable instance : (Perf R).IsStableUnderShift ℤ :=
  ObjectProperty.IsTriangulated.toIsStableUnderShift

private noncomputable instance : (Perf R).IsTriangulatedClosed₂ :=
  ObjectProperty.IsTriangulated.toIsTriangulatedClosed₂

private noncomputable instance : HasZeroObject (Perf R).FullSubcategory := by
  infer_instance

private abbrev cls (X : (Perf R).FullSubcategory) :
    CategoryTheory.Pretriangulated.K0 (Perf R).FullSubcategory :=
  CategoryTheory.Pretriangulated.K0.cls X

private lemma cls_eq_add {T : Triangle (Perf R).FullSubcategory}
    (hT : T ∈ distTriang (Perf R).FullSubcategory) :
    cls R T.obj₂ = cls R T.obj₁ + cls R T.obj₃ := by
  have hzero := CategoryTheory.Pretriangulated.K0.cls_rel T hT
  rw [sub_sub] at hzero
  exact sub_eq_zero.mp hzero

private lemma cls_zero : cls R (0 : (Perf R).FullSubcategory) = 0 := by
  have h := cls_eq_add R (contractible_distinguished (0 : (Perf R).FullSubcategory))
  exact left_eq_add.mp h

private lemma cls_eq_of_iso {X Y : (Perf R).FullSubcategory} (e : X ≅ Y) :
    cls R X = cls R Y := by
  have h : cls R Y = cls R X + cls R (0 : (Perf R).FullSubcategory) :=
    cls_eq_add R (T := Triangle.mk e.hom (0 : Y ⟶ 0) 0)
      ((Triangle.distinguished_iff_of_isZero₃ _ (isZero_zero _)).2 (by dsimp; infer_instance))
  rw [h, cls_zero R, add_zero]

private lemma cls_eq_add_of_distTriang_ι {X Y Z : (Perf R).FullSubcategory}
    (f : X.obj ⟶ Y.obj) (g : Y.obj ⟶ Z.obj) (h : Z.obj ⟶ X.obj⟦(1 : ℤ)⟧)
    (hT : Triangle.mk f g h ∈ distTriang (DerivedCategory (ModuleCat.{u} R))) :
    cls R Y = cls R X + cls R Z := by
  obtain ⟨Z', p, q, hZ'⟩ :=
    distinguished_cocone_triangle (ObjectProperty.homMk f : X ⟶ Y)
  have hadd := cls_eq_add R hZ'
  change cls R Y = cls R X + cls R Z' at hadd
  rw [hadd]
  exact congrArg (fun z => cls R X + z) (cls_eq_of_iso R (ObjectProperty.isoMk _
    (Triangle.π₃.mapIso (isoTriangleOfIso₁₂ _ _
    (show (Perf R).ι.mapTriangle.obj
      (Triangle.mk (ObjectProperty.homMk f) p q) ∈ distTriang _ from hZ') hT
      (Iso.refl _) (Iso.refl _) ((Category.comp_id _).trans (Category.id_comp f).symm)))))

private noncomputable def eulerHom
    (c : (Perf R).FullSubcategory → K0 R)
    (hadd : ∀ (T : Triangle (DerivedCategory (ModuleCat.{u} R))),
      T ∈ distTriang (DerivedCategory (ModuleCat.{u} R)) →
      ∀ (h₁ : Perf R T.obj₁) (h₂ : Perf R T.obj₂) (h₃ : Perf R T.obj₃),
        c ⟨T.obj₂, h₂⟩ = c ⟨T.obj₁, h₁⟩ + c ⟨T.obj₃, h₃⟩) :
    CategoryTheory.Pretriangulated.K0 (Perf R).FullSubcategory →+ K0 R := by
  refine QuotientAddGroup.lift _ (FreeAbelianGroup.lift c) ?_
  intro x hx
  refine AddSubgroup.closure_induction ?_ ?_ ?_ ?_ hx
  · rintro y ⟨T, hT, rfl⟩
    change (FreeAbelianGroup.lift c)
      (FreeAbelianGroup.of T.obj₂ - FreeAbelianGroup.of T.obj₁ -
        FreeAbelianGroup.of T.obj₃) = 0
    simp only [map_sub, FreeAbelianGroup.lift_apply_of]
    have hT' : (Perf R).ι.mapTriangle.obj T ∈
        distTriang (DerivedCategory (ModuleCat.{u} R)) := hT
    have hh := hadd ((Perf R).ι.mapTriangle.obj T) hT'
      T.obj₁.property T.obj₂.property T.obj₃.property
    change c T.obj₂ = c T.obj₁ + c T.obj₃ at hh
    rw [hh]
    abel
  · simp
  · intro a b _ _ ha hb
    exact (FreeAbelianGroup.lift c).ker.add_mem ha hb
  · intro a _ ha
    exact (FreeAbelianGroup.lift c).ker.neg_mem ha

@[simp] private lemma eulerHom_mk
    (c : (Perf R).FullSubcategory → K0 R)
    (hadd : ∀ (T : Triangle (DerivedCategory (ModuleCat.{u} R))),
      T ∈ distTriang (DerivedCategory (ModuleCat.{u} R)) →
      ∀ (h₁ : Perf R T.obj₁) (h₂ : Perf R T.obj₂) (h₃ : Perf R T.obj₃),
        c ⟨T.obj₂, h₂⟩ = c ⟨T.obj₁, h₁⟩ + c ⟨T.obj₃, h₃⟩)
    (X : (Perf R).FullSubcategory) : eulerHom R c hadd (cls R X) = c X := by
  change FreeAbelianGroup.lift c (FreeAbelianGroup.of X) = c X
  simp

private lemma finite_of_isZero {X : ModuleCat.{u} R} (h : IsZero X) : Module.Finite R X := by
  let := ModuleCat.isZero_iff_subsingleton.mp h
  infer_instance

private lemma projective_of_isZero {X : ModuleCat.{u} R} (h : IsZero X) :
    Module.Projective R X := by
  let := ModuleCat.isZero_iff_subsingleton.mp h
  infer_instance

private lemma finite_single (M : FGProj R) (i : ℤ) :
    Module.Finite R (((CochainComplex.singleFunctor (ModuleCat.{u} R) 0).obj
      (ModuleCat.of R M.carrier)).X i) := by
  rcases eq_or_ne i 0 with rfl | hi
  · exact M.finite
  · exact finite_of_isZero R (HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0
      (ModuleCat.of R M.carrier) i hi)

private lemma projective_single (M : FGProj R) (i : ℤ) :
    Module.Projective R (((CochainComplex.singleFunctor (ModuleCat.{u} R) 0).obj
      (ModuleCat.of R M.carrier)).X i) := by
  rcases eq_or_ne i 0 with rfl | hi
  · exact M.projective
  · exact projective_of_isZero R (HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0
      (ModuleCat.of R M.carrier) i hi)

private lemma perfect_of_bounded (L : CochainComplex (ModuleCat.{u} R) ℤ)
    (a b : ℤ) (hge : L.IsStrictlyGE a) (hle : L.IsStrictlyLE b)
    (hfinite : ∀ i : ℤ, Module.Finite R (L.X i))
    (hprojective : ∀ i : ℤ, Module.Projective R (L.X i)) :
    Perf R (DerivedCategory.Q.obj L) := by
  change (ObjectProperty.singleton
    ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
      (ModuleCat.of R R))).triangEnvelope (DerivedCategory.Q.obj L)
  rw [← StacksDraft.Perfect.isPerfect_eq_triangEnvelope_singleton_regularModule]
  exact ⟨L, a, b, hge, hle, hfinite, hprojective, ⟨Iso.refl _⟩⟩

private lemma perfect_single (M : FGProj R) :
    Perf R ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
      (ModuleCat.of R M.carrier)) :=
  (Perf R).prop_of_iso
    ((DerivedCategory.singleFunctorIsoCompQ (ModuleCat.{u} R) 0).app
      (ModuleCat.of R M.carrier)).symm
    (perfect_of_bounded R _ 0 0 inferInstance inferInstance (finite_single R M)
      (projective_single R M))

private noncomputable def singleObj (M : FGProj R) : (Perf R).FullSubcategory :=
  ⟨(DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
    (ModuleCat.of R M.carrier), perfect_single R M⟩

private noncomputable def singleIsoDirectSum (M N : FGProj R) :
    singleObj R (M.directSum N) ≅ singleObj R M ⊞ singleObj R N := by
  let F := DerivedCategory.singleFunctor (ModuleCat.{u} R) 0
  letI : F.Additive := inferInstance
  letI : PreservesFiniteBiproducts F := Functor.preservesFiniteBiproductsOfAdditive F
  letI : PreservesBinaryBiproduct
      (ModuleCat.of R M.carrier) (ModuleCat.of R N.carrier) F :=
    preservesBinaryBiproduct_of_preservesBiproduct F _ _
  letI : PreservesBinaryBiproduct
      (singleObj R M) (singleObj R N) (Perf R).ι :=
    preservesBinaryBiproduct_of_preservesBiproduct (Perf R).ι _ _
  exact ObjectProperty.isoMk _
    (F.mapIso (ModuleCat.biprodIsoProd (ModuleCat.of R M.carrier)
      (ModuleCat.of R N.carrier)).symm ≪≫
      F.mapBiprod (ModuleCat.of R M.carrier) (ModuleCat.of R N.carrier) ≪≫
      ((Perf R).ι.mapBiprod (singleObj R M) (singleObj R N)).symm)

private lemma cls_single_directSum (M N : FGProj R) :
    cls R (singleObj R (M.directSum N)) = cls R (singleObj R M) + cls R (singleObj R N) := by
  rw [cls_eq_of_iso R (singleIsoDirectSum R M N)]
  simpa using cls_eq_add R
    (binaryBiproductTriangle_distinguished (singleObj R M) (singleObj R N))

private noncomputable def inverseAux : FreeAbelianGroup (FGProj R) →+
    CategoryTheory.Pretriangulated.K0 (Perf R).FullSubcategory :=
  FreeAbelianGroup.lift fun M => cls R (singleObj R M)

private lemma inverseAux_vanishes (x : FreeAbelianGroup (FGProj R)) (hx : x ∈ K0.rels R) :
    inverseAux R x = 0 := by
  refine AddSubgroup.closure_induction ?_ ?_ ?_ ?_ hx
  · rintro y (⟨M, N, rfl⟩ | ⟨M, N, ⟨e⟩, rfl⟩)
    · simp only [map_sub, inverseAux, FreeAbelianGroup.lift_apply_of]
      rw [cls_single_directSum R M N]
      abel
    · simp only [map_sub, inverseAux, FreeAbelianGroup.lift_apply_of, sub_eq_zero]
      exact cls_eq_of_iso R (ObjectProperty.isoMk _ <|
        (DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).mapIso e.toModuleIso)
  · simp
  · intro a b _ _ ha hb
    simpa using congrArg₂ (· + ·) ha hb
  · intro a _ ha
    simpa using congrArg Neg.neg ha

private noncomputable def inverseHom : K0 R →+
    CategoryTheory.Pretriangulated.K0 (Perf R).FullSubcategory :=
  QuotientAddGroup.lift (K0.rels R) (inverseAux R) (inverseAux_vanishes R)

@[simp] private lemma inverseHom_mk (M : FGProj R) :
    inverseHom R (K0.mk M) = cls R (singleObj R M) := by
  rfl


private lemma cls_shift_one (X : (Perf R).FullSubcategory) :
    cls R (X⟦(1 : ℤ)⟧) = -cls R X := by
  have h := cls_eq_add R (contractible_distinguished₂ X)
  change cls R (0 : (Perf R).FullSubcategory) = cls R X + cls R (X⟦(1 : ℤ)⟧) at h
  rw [cls_zero R] at h
  exact eq_neg_of_add_eq_zero_right h.symm

private lemma cls_shift_succ (X : (Perf R).FullSubcategory) (n : ℤ) :
    cls R (X⟦n + 1⟧) = -cls R (X⟦n⟧) := by
  rw [cls_eq_of_iso R
    ((shiftFunctorAdd' (Perf R).FullSubcategory n 1 (n + 1) rfl).app X)]
  change cls R ((X⟦n⟧)⟦(1 : ℤ)⟧) = -cls R (X⟦n⟧)
  exact cls_shift_one R _

private lemma cls_shift_pred (X : (Perf R).FullSubcategory) (n : ℤ) :
    cls R (X⟦n - 1⟧) = -cls R (X⟦n⟧) := by
  have h : cls R (X⟦n⟧) = -cls R (X⟦n - 1⟧) := by
    simpa only [sub_add_cancel] using cls_shift_succ R X (n - 1)
  simpa only [neg_neg] using congrArg Neg.neg h.symm

private lemma cls_shift (X : (Perf R).FullSubcategory) (n : ℤ) :
    cls R (X⟦n⟧) = (n.negOnePow : ℤ) • cls R X := by
  induction n using Int.induction_on with
  | zero =>
    rw [cls_eq_of_iso R ((shiftFunctorZero (Perf R).FullSubcategory ℤ).app X)]
    simp
  | succ n ih =>
    rw [cls_shift_succ, ih]
    simp [Int.negOnePow_add, Int.negOnePow_one]
  | pred n ih =>
    rw [cls_shift_pred, ih]
    simp [Int.negOnePow_sub, Int.negOnePow_one]

private noncomputable def singleAtObj (M : FGProj R) (i : ℤ) :
    (Perf R).FullSubcategory := by
  let e := ((DerivedCategory.singleFunctors (ModuleCat.{u} R)).shiftIso
    (-i) i 0 (by omega)).app (ModuleCat.of R M.carrier)
  exact ⟨(DerivedCategory.singleFunctor (ModuleCat.{u} R) i).obj
    (ModuleCat.of R M.carrier),
    (Perf R).prop_of_iso e ((Perf R).le_shift (-i) _ (perfect_single R M))⟩

private lemma cls_singleAtObj (M : FGProj R) (i : ℤ) :
    cls R (singleAtObj R M i) = (i.negOnePow : ℤ) • cls R (singleObj R M) := by
  let e := ((DerivedCategory.singleFunctors (ModuleCat.{u} R)).shiftIso
    (-i) i 0 (by omega)).app (ModuleCat.of R M.carrier)
  have e' : (singleAtObj R M i).obj ≅ ((singleObj R M)⟦-i⟧).obj :=
    e.symm ≪≫ (((Perf R).ι.commShiftIso (-i)).app (singleObj R M)).symm
  have h : cls R (singleAtObj R M i) = cls R ((singleObj R M)⟦-i⟧) :=
    cls_eq_of_iso R (ObjectProperty.isoMk _ e')
  rw [h, cls_shift]
  simp only [Int.negOnePow_neg]

private lemma finite_stupidTruncLE (L : CochainComplex (ModuleCat.{u} R) ℤ)
    (m : ℤ) (hfinite : ∀ i : ℤ, Module.Finite R (L.X i)) (i : ℤ) :
    Module.Finite R ((L.stupidTrunc (embeddingUpIntLE m)).X i) := by
  by_cases hi : i ≤ m
  · let := hfinite i
    exact Module.Finite.equiv
      ((L.stupidTruncXIso _ (DerivedCategory.embeddingUpIntLE_f_toNat m i hi)).symm.toLinearEquiv)
  · exact finite_of_isZero R (DerivedCategory.isZero_stupidTrunc_X_of_lt L (by omega))

private lemma projective_stupidTruncLE (L : CochainComplex (ModuleCat.{u} R) ℤ)
    (m : ℤ) (hprojective : ∀ i : ℤ, Module.Projective R (L.X i)) (i : ℤ) :
    Module.Projective R ((L.stupidTrunc (embeddingUpIntLE m)).X i) := by
  by_cases hi : i ≤ m
  · let := hprojective i
    exact Module.Projective.of_equiv'
      ((L.stupidTruncXIso _ (DerivedCategory.embeddingUpIntLE_f_toNat m i hi)).symm.toLinearEquiv)
  · exact projective_of_isZero R (DerivedCategory.isZero_stupidTrunc_X_of_lt L (by omega))

private lemma cls_single_complex (L : CochainComplex (ModuleCat.{u} R) ℤ)
    (a : ℤ) (hge : L.IsStrictlyGE a) (hle : L.IsStrictlyLE a)
    (hfinite : ∀ i : ℤ, Module.Finite R (L.X i))
    (hprojective : ∀ i : ℤ, Module.Projective R (L.X i)) :
    cls R ⟨DerivedCategory.Q.obj L,
      perfect_of_bounded R L a a hge hle hfinite hprojective⟩ =
      cls R (singleAtObj R
        ({ carrier := L.X a, finite := hfinite a, projective := hprojective a } : FGProj R)
        a) := by
  let := hge
  let := hle
  obtain ⟨Y, ⟨e⟩⟩ := CochainComplex.exists_iso_single L a
  let eY : L.X a ≅ Y :=
    (HomologicalComplex.eval (ModuleCat.{u} R) (ComplexShape.up ℤ) a).mapIso e ≪≫
      HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) a Y
  let e' : DerivedCategory.Q.obj L ≅
      (DerivedCategory.singleFunctor (ModuleCat.{u} R) a).obj (L.X a) :=
    DerivedCategory.Q.mapIso e ≪≫
      ((DerivedCategory.singleFunctorIsoCompQ (ModuleCat.{u} R) a).app Y).symm ≪≫
      (DerivedCategory.singleFunctor (ModuleCat.{u} R) a).mapIso eY.symm
  exact cls_eq_of_iso R (ObjectProperty.isoMk _ e')

private abbrev eulerTerm (L : CochainComplex (ModuleCat.{u} R) ℤ)
    (hfinite : ∀ i : ℤ, Module.Finite R (L.X i))
    (hprojective : ∀ i : ℤ, Module.Projective R (L.X i)) (i : ℤ) : K0 R :=
  (i.negOnePow : ℤ) • K0.mk
    ({ carrier := L.X i, finite := hfinite i, projective := hprojective i } : FGProj R)

private lemma eulerTerm_stupidTruncLE (L : CochainComplex (ModuleCat.{u} R) ℤ)
    (m i : ℤ) (hi : i ≤ m)
    (hfinite : ∀ j : ℤ, Module.Finite R (L.X j))
    (hprojective : ∀ j : ℤ, Module.Projective R (L.X j)) :
    eulerTerm R (L.stupidTrunc (embeddingUpIntLE m))
      (finite_stupidTruncLE R L m hfinite) (projective_stupidTruncLE R L m hprojective) i =
      eulerTerm R L hfinite hprojective i := by
  unfold eulerTerm
  congr 1
  exact K0.mk_eq_of_iso _ _
    (L.stupidTruncXIso _ (DerivedCategory.embeddingUpIntLE_f_toNat m i hi)).toLinearEquiv

private lemma cls_bounded_aux (a : ℤ) :
    ∀ (n : ℕ) (b : ℤ), a + (n : ℤ) = b →
      ∀ (L : CochainComplex (ModuleCat.{u} R) ℤ)
        (hge : L.IsStrictlyGE a) (hle : L.IsStrictlyLE b)
        (hfinite : ∀ i : ℤ, Module.Finite R (L.X i))
        (hprojective : ∀ i : ℤ, Module.Projective R (L.X i)),
      cls R ⟨DerivedCategory.Q.obj L,
        perfect_of_bounded R L a b hge hle hfinite hprojective⟩ =
        inverseHom R (∑ i ∈ Finset.Icc a b, eulerTerm R L hfinite hprojective i) := by
  intro n
  induction n with
  | zero =>
    intro b hb L hge hle hfinite hprojective
    simp only [Nat.cast_zero, add_zero] at hb
    subst b
    rw [cls_single_complex R L a hge hle hfinite hprojective]
    simp only [Finset.Icc_self, Finset.sum_singleton, eulerTerm, map_zsmul,
      inverseHom_mk]
    exact cls_singleAtObj R
      ({ carrier := L.X a, finite := hfinite a, projective := hprojective a } : FGProj R) a
  | succ n ih =>
    intro b hb L hge hle hfinite hprojective
    have hab : a ≤ b := by omega
    have ham : a ≤ b - 1 := by omega
    let T : CochainComplex (ModuleCat.{u} R) ℤ :=
      L.stupidTrunc (embeddingUpIntLE (b - 1))
    have hgeT : T.IsStrictlyGE a := by
      let := hge
      infer_instance
    have hleT : T.IsStrictlyLE (b - 1) := by infer_instance
    have hfiniteT : ∀ i : ℤ, Module.Finite R (T.X i) :=
      finite_stupidTruncLE R L (b - 1) hfinite
    have hprojectiveT : ∀ i : ℤ, Module.Projective R (T.X i) :=
      projective_stupidTruncLE R L (b - 1) hprojective
    let M : FGProj R :=
      { carrier := L.X b, finite := hfinite b, projective := hprojective b }
    let := hle
    obtain ⟨f, g, h, htri⟩ := DerivedCategory.exists_distTriang_singleFunctor_obj_X_stupidTrunc L b
    have hstep : cls R ⟨DerivedCategory.Q.obj L,
        perfect_of_bounded R L a b hge hle hfinite hprojective⟩ =
        cls R (singleAtObj R M b) +
          cls R ⟨DerivedCategory.Q.obj T,
            perfect_of_bounded R T a (b - 1) hgeT hleT hfiniteT hprojectiveT⟩ :=
      cls_eq_add_of_distTriang_ι R f g h htri
    have hrec := ih (b - 1) (by omega) T hgeT hleT hfiniteT hprojectiveT
    have hbTerm : cls R (singleAtObj R M b) =
        inverseHom R (eulerTerm R L hfinite hprojective b) := by
      rw [cls_singleAtObj]
      change (b.negOnePow : ℤ) • cls R (singleObj R M) =
        inverseHom R ((b.negOnePow : ℤ) • K0.mk M)
      rw [map_zsmul, inverseHom_mk]
    have hsumTrunc :
        (∑ i ∈ Finset.Icc a (b - 1), eulerTerm R T hfiniteT hprojectiveT i) =
          ∑ i ∈ Finset.Icc a (b - 1), eulerTerm R L hfinite hprojective i :=
      Finset.sum_congr rfl fun i hi =>
        eulerTerm_stupidTruncLE R L (b - 1) i (Finset.mem_Icc.mp hi).2 hfinite hprojective
    have hsum : (∑ i ∈ Finset.Icc a b, eulerTerm R L hfinite hprojective i) =
        (∑ i ∈ Finset.Icc a (b - 1), eulerTerm R L hfinite hprojective i) +
          eulerTerm R L hfinite hprojective b := by
      have hmem : b ∉ Finset.Icc a (b - 1) := by simp [Finset.mem_Icc]
      have hIcc : Finset.Icc a b = insert b (Finset.Icc a (b - 1)) := by
        ext i
        simp only [Finset.mem_Icc, Finset.mem_insert]
        omega
      rw [hIcc, Finset.sum_insert hmem]
      abel
    calc
      cls R ⟨DerivedCategory.Q.obj L,
        perfect_of_bounded R L a b hge hle hfinite hprojective⟩ =
          cls R (singleAtObj R M b) +
            cls R ⟨DerivedCategory.Q.obj T,
              perfect_of_bounded R T a (b - 1) hgeT hleT hfiniteT hprojectiveT⟩ := hstep
      _ = inverseHom R (eulerTerm R L hfinite hprojective b) +
            inverseHom R (∑ i ∈ Finset.Icc a (b - 1),
              eulerTerm R T hfiniteT hprojectiveT i) := by rw [hbTerm, hrec]
      _ = inverseHom R (∑ i ∈ Finset.Icc a b,
            eulerTerm R L hfinite hprojective i) := by
          rw [hsumTrunc, hsum, map_add, add_comm]

private lemma cls_bounded (L : CochainComplex (ModuleCat.{u} R) ℤ)
    (a b : ℤ) (hge : L.IsStrictlyGE a) (hle : L.IsStrictlyLE b)
    (hfinite : ∀ i : ℤ, Module.Finite R (L.X i))
    (hprojective : ∀ i : ℤ, Module.Projective R (L.X i)) :
    cls R ⟨DerivedCategory.Q.obj L,
      perfect_of_bounded R L a b hge hle hfinite hprojective⟩ =
      inverseHom R (∑ i ∈ Finset.Icc a b, eulerTerm R L hfinite hprojective i) := by
  by_cases hab : a ≤ b
  · exact cls_bounded_aux R a (b - a).toNat b (by omega) L hge hle hfinite hprojective
  · have hzeroL : IsZero L := by
      apply (IsZero.iff_id_eq_zero L).2
      apply HomologicalComplex.hom_ext
      intro i
      change (𝟙 (L.X i)) = 0
      by_cases hi : i < a
      · exact (L.isZero_of_isStrictlyGE a i hi).eq_of_src _ _
      · exact (L.isZero_of_isStrictlyLE b i (by omega)).eq_of_src _ _
    have hzeroQ : IsZero (DerivedCategory.Q.obj L) :=
      DerivedCategory.Q.map_isZero hzeroL
    have e : (⟨DerivedCategory.Q.obj L,
        perfect_of_bounded R L a b hge hle hfinite hprojective⟩ :
          (Perf R).FullSubcategory) ≅ 0 :=
      ObjectProperty.isoMk _ (hzeroQ.isoZero ≪≫ ((Perf R).ι.mapZeroObject).symm)
    have hcls : cls R ⟨DerivedCategory.Q.obj L,
        perfect_of_bounded R L a b hge hle hfinite hprojective⟩ = 0 := by
      rw [cls_eq_of_iso R e, cls_zero R]
    have hsum : Finset.Icc a b = ∅ := Finset.Icc_eq_empty_of_lt (by omega)
    simp [hcls, hsum]

private lemma quotientFree_hom_ext {X : Type*} {A : Type*} [AddCommGroup A]
    (S : AddSubgroup (FreeAbelianGroup X))
    (f g : (FreeAbelianGroup X ⧸ S) →+ A)
    (h : ∀ x : X, f (QuotientAddGroup.mk' S (FreeAbelianGroup.of x)) =
      g (QuotientAddGroup.mk' S (FreeAbelianGroup.of x))) : f = g := by
  apply AddMonoidHom.ext
  intro z
  refine QuotientAddGroup.induction_on z ?_
  intro a
  induction a using FreeAbelianGroup.induction_on with
  | zero => simp
  | of x => exact h x
  | neg x ih =>
    change f ((QuotientAddGroup.mk' S) (-FreeAbelianGroup.of x)) =
      g ((QuotientAddGroup.mk' S) (-FreeAbelianGroup.of x))
    rw [map_neg, map_neg, map_neg, h x]
  | add p q ihp ihq =>
    change f ((QuotientAddGroup.mk' S) (p + q)) =
      g ((QuotientAddGroup.mk' S) (p + q))
    change f ((QuotientAddGroup.mk' S) p) = g ((QuotientAddGroup.mk' S) p) at ihp
    change f ((QuotientAddGroup.mk' S) q) = g ((QuotientAddGroup.mk' S) q) at ihq
    rw [map_add, map_add, map_add, ihp, ihq]

private lemma perfect_of_perf (K : (Perf R).FullSubcategory) :
    StacksDraft.Perfect.IsPerfect K.obj := by
  rw [StacksDraft.Perfect.isPerfect_eq_triangEnvelope_singleton_regularModule]
  exact K.property

/-- **Stacks 0FCU.** Euler characteristic induces an additive equivalence from the zeroth
K-group of the perfect derived category of `R` to the zeroth K-group of finite projective
`R`-modules. On a bounded finite-projective representative it is the alternating sum of the
classes of its terms. -/
@[stacks 0FCU]
public theorem K0.exists_k0_perfectDerivedCategory_addEquiv (R : Type u) [CommRing R] :
    let P : ObjectProperty (DerivedCategory (ModuleCat.{u} R)) :=
      (ObjectProperty.singleton
        ((DerivedCategory.singleFunctor (ModuleCat.{u} R) 0).obj
          (ModuleCat.of R R))).triangEnvelope
    ∃ e : CategoryTheory.Pretriangulated.K0 P.FullSubcategory ≃+ K0 R,
      ∀ (K : P.FullSubcategory)
        (Q : CochainComplex (ModuleCat.{u} R) ℤ) (a b : ℤ),
        Q.IsStrictlyGE a → Q.IsStrictlyLE b →
        (hfinite : ∀ i : ℤ, Module.Finite R (Q.X i)) →
        (hprojective : ∀ i : ℤ, Module.Projective R (Q.X i)) →
        Nonempty (K.obj ≅ DerivedCategory.Q.obj Q) →
        e (CategoryTheory.Pretriangulated.K0.cls K) = ∑ i ∈ Finset.Icc a b,
          (i.negOnePow : ℤ) • K0.mk
            ({ carrier := Q.X i, finite := hfinite i, projective := hprojective i } : FGProj R)
    := by
  obtain ⟨c, _, hcTri, hcFormula⟩ := K0.exists_eulerChar_perfect R
  let c' : (Perf R).FullSubcategory → K0 R :=
    fun K => c ⟨K.obj, perfect_of_perf R K⟩
  have hc'Tri : ∀ (T : Triangle (DerivedCategory (ModuleCat.{u} R))),
      T ∈ distTriang (DerivedCategory (ModuleCat.{u} R)) →
      ∀ (h₁ : Perf R T.obj₁) (h₂ : Perf R T.obj₂) (h₃ : Perf R T.obj₃),
        c' ⟨T.obj₂, h₂⟩ = c' ⟨T.obj₁, h₁⟩ + c' ⟨T.obj₃, h₃⟩ := by
    intro T hT h₁ h₂ h₃
    exact hcTri T hT (perfect_of_perf R ⟨T.obj₁, h₁⟩)
      (perfect_of_perf R ⟨T.obj₂, h₂⟩) (perfect_of_perf R ⟨T.obj₃, h₃⟩)
  let f := eulerHom R c' hc'Tri
  have hcSingle (M : FGProj R) : c' (singleObj R M) = K0.mk M := by
    let Q : CochainComplex (ModuleCat.{u} R) ℤ :=
      (CochainComplex.singleFunctor (ModuleCat.{u} R) 0).obj
        (ModuleCat.of R M.carrier)
    have hQfinite : ∀ i : ℤ, Module.Finite R (Q.X i) := finite_single R M
    have hQprojective : ∀ i : ℤ, Module.Projective R (Q.X i) := projective_single R M
    have h := hcFormula (singleObj R M).obj (perfect_of_perf R (singleObj R M)) Q 0 0
      inferInstance inferInstance hQfinite hQprojective
      ⟨(DerivedCategory.singleFunctorIsoCompQ (ModuleCat.{u} R) 0).app (ModuleCat.of R M.carrier)⟩
    change c' (singleObj R M) = _ at h
    have hmk : K0.mk
        ({ carrier := Q.X 0, finite := hQfinite 0, projective := hQprojective 0 } :
          FGProj R) = K0.mk M :=
      K0.mk_eq_of_iso _ _ (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0
        (ModuleCat.of R M.carrier)).toLinearEquiv
    simpa [hmk] using h
  have hfi : f.comp (inverseHom R) = AddMonoidHom.id (K0 R) :=
    quotientFree_hom_ext (K0.rels R) _ _ fun M => by
      change f (inverseHom R (K0.mk M)) = K0.mk M
      rw [inverseHom_mk]
      exact (eulerHom_mk R c' hc'Tri (singleObj R M)).trans (hcSingle M)
  have hif : (inverseHom R).comp f =
      AddMonoidHom.id (CategoryTheory.Pretriangulated.K0 (Perf R).FullSubcategory) := by
    apply CategoryTheory.Pretriangulated.K0.hom_ext
    intro K
    change inverseHom R (f (cls R K)) = cls R K
    obtain ⟨Q, a, b, hge, hle, hfinite, hprojective, ⟨iso⟩⟩ :=
      perfect_of_perf R K
    calc
      inverseHom R (f (cls R K)) =
          inverseHom R (∑ i ∈ Finset.Icc a b, eulerTerm R Q hfinite hprojective i) := by
        rw [eulerHom_mk]
        exact congrArg (inverseHom R)
          (hcFormula K.obj (perfect_of_perf R K) Q a b hge hle hfinite hprojective ⟨iso⟩)
      _ = cls R ⟨DerivedCategory.Q.obj Q,
            perfect_of_bounded R Q a b hge hle hfinite hprojective⟩ :=
        (cls_bounded R Q a b hge hle hfinite hprojective).symm
      _ = cls R K := (cls_eq_of_iso R (ObjectProperty.isoMk _ iso)).symm
  let e : CategoryTheory.Pretriangulated.K0 (Perf R).FullSubcategory ≃+ K0 R :=
    { toFun := f
      invFun := inverseHom R
      left_inv := fun x => DFunLike.congr_fun hif x
      right_inv := fun y => DFunLike.congr_fun hfi y
      map_add' := f.map_add }
  refine ⟨e, fun K Q a b hge hle hfinite hprojective hiso => ?_⟩
  exact (eulerHom_mk R c' hc'Tri K).trans
    (hcFormula K.obj (perfect_of_perf R K) Q a b hge hle hfinite hprojective hiso)

end

