module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.KTheory.Grothendieck.Defs

/-!
# The two factors of a product ring, as modules over the product

For the product ring `R = R_1 \times R_2` with complementary central
idempotents `e_1 = (1,0)`, `e_2 = (0,1)`, every `R`-module `M` decomposes as
`M = e_1 M \oplus e_2 M`, where `e_i M = M \otimes_R R_i` is naturally an
`R_i`-module. The two ring projections `p_i : R -> R_i` induce the product map
`[M] \mapsto ([e_1 M], [e_2 M]) = ([M \otimes_R R_1], [M \otimes_R R_2])`,
and the assertion is that this map is an isomorphism of abelian groups.

This file records the module-theoretic input to that assertion: each factor
`R_i`, viewed as an `R`-module along `p_i`, is finite and projective (it is the
image of the idempotent `e_i`, hence a direct factor of `R`); base change along
`p_i` undoes restriction of scalars along `p_i` (`Prod.tensorFstEquiv`,
`Prod.tensorSndEquiv`); and base change along `p_i` kills a module restricted
along the *other* projection.
-/

@[expose] public section

universe u

/-- The direct factor `R₁` is a finite `(R₁ × R₂)`-module via `fst` (`R₁` is the
image of the idempotent `e₁ = (1,0)`; `R₁ × R₂ ≅ R₁ ⊕ R₂` as `(R₁×R₂)`-modules).
Mathlib hints: `R₁` as `fst`-module is `(R₁×R₂) ⧸ (RingHom.ker fst)` and also a
direct summand of the free rank-1 module `R₁×R₂`; or use the idempotent
`e₁`-decomposition.  Needed to instantiate `FGProj.restrict`/`K0prime.restrictMk`. -/
theorem Prod.fst_finite (R1 R2 : Type u) [CommRing R1] [CommRing R2] :
    letI : Module (R1 × R2) R1 := ((RingHom.fst R1 R2).toAlgebra).toModule
    Module.Finite (R1 × R2) R1 := by
  let : Algebra (R1 × R2) R1 := (RingHom.fst R1 R2).toAlgebra
  refine Module.finite_def.mpr ?_
  refine ⟨{1}, ?_⟩
  rw [eq_top_iff]
  intro x _
  have hx : x = ((x, 0) : R1 × R2) • (1 : R1) := by
    change x = (RingHom.fst R1 R2) (x, 0) * 1
    simp
  rw [hx]
  exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))

/-- `R₁`, viewed as an `R₁ × R₂`-module along the first projection, is projective: it is
the direct summand of `R₁ × R₂` cut out by the idempotent `(1, 0)`. -/
theorem Prod.fst_projective (R1 R2 : Type u) [CommRing R1] [CommRing R2] :
    letI : Module (R1 × R2) R1 := ((RingHom.fst R1 R2).toAlgebra).toModule
    Module.Projective (R1 × R2) R1 := by
  let : Algebra (R1 × R2) R1 := (RingHom.fst R1 R2).toAlgebra
  let i : R1 →ₗ[R1 × R2] (R1 × R2) :=
    { toFun := fun x => (x, 0)
      map_add' _ _ := by simp
      map_smul' := by
        intro c x
        change (c.fst * x, 0) = c * (x, 0)
        ext <;> simp }
  let s : (R1 × R2) →ₗ[R1 × R2] R1 :=
    { toFun := fun p => p.fst
      map_add' _ _ := rfl
      map_smul' := by
        intro c x
        change (c * x).fst = c.fst * x.fst
        rfl }
  refine Module.Projective.of_split i s ?_
  ext x
  rfl

/-- `R₂`, viewed as an `R₁ × R₂`-module along the second projection, is finite: it is
generated by `1`. -/
theorem Prod.snd_finite (R1 R2 : Type u) [CommRing R1] [CommRing R2] :
    letI : Module (R1 × R2) R2 := ((RingHom.snd R1 R2).toAlgebra).toModule
    Module.Finite (R1 × R2) R2 := by
  let : Algebra (R1 × R2) R2 := (RingHom.snd R1 R2).toAlgebra
  refine Module.finite_def.mpr ?_
  refine ⟨{1}, ?_⟩
  rw [eq_top_iff]
  intro x _
  have hx : x = ((0, x) : R1 × R2) • (1 : R2) := by
    change x = (RingHom.snd R1 R2) (0, x) * 1
    simp
  rw [hx]
  exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))

/-- `R₂`, viewed as an `R₁ × R₂`-module along the second projection, is projective: it is
the direct summand of `R₁ × R₂` cut out by the idempotent `(0, 1)`. -/
theorem Prod.snd_projective (R1 R2 : Type u) [CommRing R1] [CommRing R2] :
    letI : Module (R1 × R2) R2 := ((RingHom.snd R1 R2).toAlgebra).toModule
    Module.Projective (R1 × R2) R2 := by
  let : Algebra (R1 × R2) R2 := (RingHom.snd R1 R2).toAlgebra
  let i : R2 →ₗ[R1 × R2] (R1 × R2) :=
    { toFun := fun x => (0, x)
      map_add' _ _ := by simp
      map_smul' := by
        intro c x
        change (0, c.snd * x) = c * (0, x)
        ext <;> simp }
  let s : (R1 × R2) →ₗ[R1 × R2] R2 :=
    { toFun := fun p => p.snd
      map_add' _ _ := rfl
      map_smul' := by
        intro c x
        change (c * x).snd = c.snd * x.snd
        rfl }
  refine Module.Projective.of_split i s ?_
  ext x
  rfl

/-- For an `R₁`-module `N`, viewed as an `R₁ × R₂`-module along `fst`, base change back
along `fst` recovers `N`: `R₁ ⊗_{R₁ × R₂} N ≃ N`. -/
noncomputable def Prod.tensorFstEquiv (R1 R2 : Type u) [CommRing R1] [CommRing R2]
    (N : Type u) [AddCommGroup N] [Module R1 N] :
    letI : Algebra (R1 × R2) R1 := (RingHom.fst R1 R2).toAlgebra
    letI : Module (R1 × R2) N := Module.compHom N (RingHom.fst R1 R2)
    TensorProduct (R1 × R2) R1 N ≃ₗ[R1] N := by
  letI : Algebra (R1 × R2) R1 := (RingHom.fst R1 R2).toAlgebra
  letI : Module (R1 × R2) N := Module.compHom N (RingHom.fst R1 R2)
  let b : R1 →ₗ[R1 × R2] N →ₗ[R1 × R2] N :=
    { toFun := fun s =>
        { toFun := fun n => ((s, 0) : R1 × R2) • n
          map_add' := fun x y => by simp
          map_smul' := fun c x => by
            simp only [RingHom.id_apply, smul_smul]
            congr 1
            ext <;> simp [mul_comm] }
      map_add' := fun x y => by
        ext m
        simp only [LinearMap.coe_mk, AddHom.coe_mk, LinearMap.add_apply]
        rw [show ((x + y, 0) : R1 × R2) = (x, 0) + (y, 0) by ext <;> simp, add_smul]
      map_smul' := fun c x => by
        ext m
        simp only [LinearMap.coe_mk, AddHom.coe_mk, RingHom.id_apply, LinearMap.smul_apply,
          smul_smul]
        congr 1
        change (c.fst * x, 0) = c * (x, 0)
        ext <;> simp }
  let fwdRaw : TensorProduct (R1 × R2) R1 N →ₗ[R1 × R2] N :=
    TensorProduct.lift b
  let fwd : TensorProduct (R1 × R2) R1 N →ₗ[R1] N :=
    { toFun := fwdRaw
      map_add' := fun x y => by simp
      map_smul' := fun (r1 : R1) t => by
        simp only [RingHom.id_apply]
        induction t using TensorProduct.inductionOn with
        | tmul s n =>
          change fwdRaw ((r1 • s) ⊗ₜ[R1 × R2] n) = r1 • fwdRaw (s ⊗ₜ[R1 × R2] n)
          change ((r1 • s, 0) : R1 × R2) • n = r1 • (((s, 0) : R1 × R2) • n)
          change (r1 * s) • n = r1 • (s • n)
          rw [mul_smul]
        | add a c ha hc =>
          rw [smul_add, map_add, map_add, ha, hc, smul_add] }
  let bwd : N →ₗ[R1] TensorProduct (R1 × R2) R1 N :=
    { toFun := fun n => (1 : R1) ⊗ₜ[R1 × R2] n
      map_add' := fun x y => by rw [TensorProduct.tmul_add]
      map_smul' := fun (r1 : R1) n => by
        simp only [RingHom.id_apply]
        change (1 : R1) ⊗ₜ[R1 × R2] (r1 • n) = r1 • ((1 : R1) ⊗ₜ[R1 × R2] n)
        change (1 : R1) ⊗ₜ[R1 × R2] (r1 • n) = (r1 • (1 : R1)) ⊗ₜ[R1 × R2] n
        rw [show r1 • (1 : R1) = ((r1, 0) : R1 × R2) • (1 : R1) by
              change r1 * 1 = (RingHom.fst R1 R2) (r1, 0) * 1; simp]
        rw [TensorProduct.smul_tmul]
        congr 1 }
  have hfb : ∀ n : N, fwd (bwd n) = n := by
    intro n
    change fwdRaw ((1 : R1) ⊗ₜ[R1 × R2] n) = n
    change ((1, 0) : R1 × R2) • n = n
    change (RingHom.fst R1 R2) (1, 0) • n = n
    simp
  have hbf : ∀ t : TensorProduct (R1 × R2) R1 N, bwd (fwd t) = t := by
    intro t
    induction t using TensorProduct.inductionOn with
    | tmul s n =>
      change bwd (fwdRaw (s ⊗ₜ[R1 × R2] n)) = s ⊗ₜ[R1 × R2] n
      change (1 : R1) ⊗ₜ[R1 × R2] (((s, 0) : R1 × R2) • n) = s ⊗ₜ[R1 × R2] n
      rw [← TensorProduct.smul_tmul]
      congr 1
      change ((s, 0) : R1 × R2) • (1 : R1) = s
      change (RingHom.fst R1 R2) (s, 0) * 1 = s
      simp
    | add a c ha hc => simp only [map_add]; rw [ha, hc]
  exact LinearEquiv.ofLinearMap fwd bwd (LinearMap.ext hfb) (LinearMap.ext hbf)

/-- For an `R₂`-module `N`, viewed as an `R₁ × R₂`-module along `snd`, base change back
along `snd` recovers `N`: `R₂ ⊗_{R₁ × R₂} N ≃ N`. -/
noncomputable def Prod.tensorSndEquiv (R1 R2 : Type u) [CommRing R1] [CommRing R2]
    (N : Type u) [AddCommGroup N] [Module R2 N] :
    letI : Algebra (R1 × R2) R2 := (RingHom.snd R1 R2).toAlgebra
    letI : Module (R1 × R2) N := Module.compHom N (RingHom.snd R1 R2)
    TensorProduct (R1 × R2) R2 N ≃ₗ[R2] N := by
  letI : Algebra (R1 × R2) R2 := (RingHom.snd R1 R2).toAlgebra
  letI : Module (R1 × R2) N := Module.compHom N (RingHom.snd R1 R2)
  let b : R2 →ₗ[R1 × R2] N →ₗ[R1 × R2] N :=
    { toFun := fun s =>
        { toFun := fun n => ((0, s) : R1 × R2) • n
          map_add' := fun x y => by simp
          map_smul' := fun c x => by
            simp only [RingHom.id_apply, smul_smul]
            congr 1
            ext <;> simp [mul_comm] }
      map_add' := fun x y => by
        ext m
        simp only [LinearMap.coe_mk, AddHom.coe_mk, LinearMap.add_apply]
        rw [show ((0, x + y) : R1 × R2) = (0, x) + (0, y) by ext <;> simp, add_smul]
      map_smul' := fun c x => by
        ext m
        simp only [LinearMap.coe_mk, AddHom.coe_mk, RingHom.id_apply, LinearMap.smul_apply,
          smul_smul]
        congr 1
        change (0, c.snd * x) = c * (0, x)
        ext <;> simp }
  let fwdRaw : TensorProduct (R1 × R2) R2 N →ₗ[R1 × R2] N :=
    TensorProduct.lift b
  let fwd : TensorProduct (R1 × R2) R2 N →ₗ[R2] N :=
    { toFun := fwdRaw
      map_add' := fun x y => by simp
      map_smul' := fun (r2 : R2) t => by
        simp only [RingHom.id_apply]
        induction t using TensorProduct.inductionOn with
        | tmul s n =>
          change fwdRaw ((r2 • s) ⊗ₜ[R1 × R2] n) = r2 • fwdRaw (s ⊗ₜ[R1 × R2] n)
          change ((0, r2 • s) : R1 × R2) • n = r2 • (((0, s) : R1 × R2) • n)
          change (r2 * s) • n = r2 • (s • n)
          rw [mul_smul]
        | add a c ha hc =>
          rw [smul_add, map_add, map_add, ha, hc, smul_add] }
  let bwd : N →ₗ[R2] TensorProduct (R1 × R2) R2 N :=
    { toFun := fun n => (1 : R2) ⊗ₜ[R1 × R2] n
      map_add' := fun x y => by rw [TensorProduct.tmul_add]
      map_smul' := fun (r2 : R2) n => by
        simp only [RingHom.id_apply]
        change (1 : R2) ⊗ₜ[R1 × R2] (r2 • n) = r2 • ((1 : R2) ⊗ₜ[R1 × R2] n)
        change (1 : R2) ⊗ₜ[R1 × R2] (r2 • n) = (r2 • (1 : R2)) ⊗ₜ[R1 × R2] n
        rw [show r2 • (1 : R2) = ((0, r2) : R1 × R2) • (1 : R2) by
              change r2 * 1 = (RingHom.snd R1 R2) (0, r2) * 1; simp]
        rw [TensorProduct.smul_tmul]
        congr 1 }
  have hfb : ∀ n : N, fwd (bwd n) = n := by
    intro n
    change fwdRaw ((1 : R2) ⊗ₜ[R1 × R2] n) = n
    change ((0, 1) : R1 × R2) • n = n
    change (RingHom.snd R1 R2) (0, 1) • n = n
    simp
  have hbf : ∀ t : TensorProduct (R1 × R2) R2 N, bwd (fwd t) = t := by
    intro t
    induction t using TensorProduct.inductionOn with
    | tmul s n =>
      change bwd (fwdRaw (s ⊗ₜ[R1 × R2] n)) = s ⊗ₜ[R1 × R2] n
      change (1 : R2) ⊗ₜ[R1 × R2] (((0, s) : R1 × R2) • n) = s ⊗ₜ[R1 × R2] n
      rw [← TensorProduct.smul_tmul]
      congr 1
      change ((0, s) : R1 × R2) • (1 : R2) = s
      change (RingHom.snd R1 R2) (0, s) * 1 = s
      simp
    | add a c ha hc => simp only [map_add]; rw [ha, hc]
  exact LinearEquiv.ofLinearMap fwd bwd (LinearMap.ext hfb) (LinearMap.ext hbf)

/-- An `R₁`-module, viewed as an `R₁ × R₂`-module along `fst`, is killed by base change
along `snd`. -/
theorem Prod.subsingleton_tensor_snd_of_fst (R1 R2 : Type u) [CommRing R1] [CommRing R2]
    (N : Type u) [AddCommGroup N] [Module R1 N] :
    letI : Algebra (R1 × R2) R2 := (RingHom.snd R1 R2).toAlgebra
    letI : Module (R1 × R2) N := Module.compHom N (RingHom.fst R1 R2)
    Subsingleton (TensorProduct (R1 × R2) R2 N) := by
  let : Algebra (R1 × R2) R2 := (RingHom.snd R1 R2).toAlgebra
  let : Module (R1 × R2) N := Module.compHom N (RingHom.fst R1 R2)
  refine subsingleton_of_forall_eq 0 fun t => ?_
  induction t using TensorProduct.inductionOn with
  | tmul r2 n =>
    have hn : n = ((1, 0) : R1 × R2) • n := by
      change n = (RingHom.fst R1 R2) (1, 0) • n
      simp
    have hz : ((1, 0) : R1 × R2) • r2 = (0 : R2) := by
      change (RingHom.snd R1 R2) (1, 0) * r2 = 0
      simp
    calc r2 ⊗ₜ[R1 × R2] n
        = r2 ⊗ₜ[R1 × R2] (((1, 0) : R1 × R2) • n) := by rw [← hn]
      _ = (((1, 0) : R1 × R2) • r2) ⊗ₜ[R1 × R2] n := by
            rw [TensorProduct.tmul_smul, TensorProduct.smul_tmul']
      _ = (0 : R2) ⊗ₜ[R1 × R2] n := by rw [hz]
      _ = 0 := TensorProduct.zero_tmul _ _
  | add a c ha hc => rw [ha, hc, add_zero]

/-- An `R₂`-module, viewed as an `R₁ × R₂`-module along `snd`, is killed by base change
along `fst`. -/
theorem Prod.subsingleton_tensor_fst_of_snd (R1 R2 : Type u) [CommRing R1] [CommRing R2]
    (N : Type u) [AddCommGroup N] [Module R2 N] :
    letI : Algebra (R1 × R2) R1 := (RingHom.fst R1 R2).toAlgebra
    letI : Module (R1 × R2) N := Module.compHom N (RingHom.snd R1 R2)
    Subsingleton (TensorProduct (R1 × R2) R1 N) := by
  let : Algebra (R1 × R2) R1 := (RingHom.fst R1 R2).toAlgebra
  let : Module (R1 × R2) N := Module.compHom N (RingHom.snd R1 R2)
  refine subsingleton_of_forall_eq 0 fun t => ?_
  induction t using TensorProduct.inductionOn with
  | tmul r1 n =>
    have hn : n = ((0, 1) : R1 × R2) • n := by
      change n = (RingHom.snd R1 R2) (0, 1) • n
      simp
    have hz : ((0, 1) : R1 × R2) • r1 = (0 : R1) := by
      change (RingHom.fst R1 R2) (0, 1) * r1 = 0
      simp
    calc r1 ⊗ₜ[R1 × R2] n
        = r1 ⊗ₜ[R1 × R2] (((0, 1) : R1 × R2) • n) := by rw [← hn]
      _ = (((0, 1) : R1 × R2) • r1) ⊗ₜ[R1 × R2] n := by
            rw [TensorProduct.tmul_smul, TensorProduct.smul_tmul']
      _ = (0 : R1) ⊗ₜ[R1 × R2] n := by rw [hz]
      _ = 0 := TensorProduct.zero_tmul _ _
  | add a c ha hc => rw [ha, hc, add_zero]
