module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.KTheory.Grothendieck.Defs

/-!
# Base change and restriction of scalars for Grothendieck-group classes

This file collects the constructions, valid for an arbitrary ring homomorphism
`f : R →+* S`, out of which the comparison between the Grothendieck groups of
`R_1 \times R_2` and of its two factors is built: base change `M ↦ S ⊗_R M` and
restriction of scalars along `f`, both at the level of bundled finite
projective modules and at the level of classes in `K'_0`, together with the
well-definedness of `K'_0`-classes on isomorphism classes and on short exact
sequences.

Here `K_0(R)` is the Grothendieck group of the category of finite projective
`R`-modules: the abelian group generated by isomorphism classes `[M]` of
finite (= finitely generated) projective `R`-modules subject to the relations
`[M'] + [M''] = [M]` for every short exact sequence
`0 -> M' -> M -> M'' -> 0` (equivalently, by the direct-sum relations, since
such sequences split for projective modules).

`K'_0(R)`, defined for Noetherian `R`, is the Grothendieck group of the
category of finite (= finitely generated) `R`-modules: the abelian group
generated by isomorphism classes `[M]` of finite `R`-modules subject to the
relations `[M'] + [M''] = [M]` for every short exact sequence
`0 -> M' -> M -> M'' -> 0`.
-/

@[expose] public section

/-
## Background and infrastructure used from the `stacks` environment

The `stacks` environment already provides the Grothendieck group `K0` of
finite projective modules together with:
* `FGProj R` : a bundled finitely generated projective `R`-module
  (carrier + `AddCommGroup` + `Module` + `Module.Finite` + `Module.Projective`);
* `K0 R := FreeAbelianGroup (FGProj R) ⧸ K0.rels R`, an `AddCommGroup`;
* `K0.mk : FGProj R → K0 R`;
* `FGProj.directSum`, `K0.mk_directSum_eq`, `K0.mk_eq_of_iso`, ... .

It also provides, for finitely generated (presented) modules:
* `FGPres R` : a finite presentation (`rank` and a submodule of `Fin rank → R`),
  with `FGPres.module` the associated finite `R`-module;
* `K0Rel R` : the inductive short-exact-sequence relation on
  `FreeAbelianGroup (FGPres R)` (constructors `K0Rel.iso` and `K0Rel.ses`);
* `FGPres.skeleton_surjective` : every finite `R`-module is isomorphic to the
  module of some `FGPres`.

There is no `K'_0` quotient predefined, so we build it below as the quotient of
`FreeAbelianGroup (FGPres R)` by the subgroup generated by `K0Rel R`.
-/

universe u

/-- Base change of a finite projective module along a ring homomorphism
`f : R →+* S`, i.e. `M ↦ S ⊗_R M`, packaged as an `FGProj S`.  This realizes
`e_i M = M ⊗_R R_i` at the level of bundled finite projective modules. -/
noncomputable def FGProj.baseChangeHom {R : Type u} [CommRing R] {S : Type u} [CommRing S]
    (f : R →+* S) (M : FGProj R) : FGProj S :=
  letI : Algebra R S := f.toAlgebra
  { carrier := TensorProduct R S M.carrier }



/-- The class in `K'_0(R)` of an arbitrary finite `R`-module `M`, obtained by
choosing any finite presentation of `M` (which exists by
`FGPres.skeleton_surjective`).  This is well defined on classes because the
relation `K0Rel` identifies isomorphic modules. -/
noncomputable def K0prime.mkModule (R : Type u) [CommRing R] (M : Type u) [AddCommGroup M]
    [Module R M] [Module.Finite R M] : K0prime R :=
  K0prime.mk (FGPres.skeleton_surjective M).choose

/-- Base change of a finite `R`-module `M` along a ring homomorphism
`f : R →+* S`, viewed as a class in `K'_0(S)`, i.e. `[M ⊗_R S]`. -/
noncomputable def K0prime.baseChangeMk {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S)
    (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M] : K0prime S :=
  letI : Algebra R S := f.toAlgebra
  K0prime.mkModule S (TensorProduct R S M)

/-- Restriction of scalars of a finite projective module along a ring
homomorphism `f : R →+* S`: an `S`-module becomes an `R`-module via `f`.  Used
with `f = fst`/`snd` to view an `Rᵢ`-module as an `R = R₁ × R₂`-module
(extension by zero of the complementary idempotent).

The naive statement is FALSE for arbitrary `f` (counterexample `R = ℤ`, `S = ℚ`,
`f = Int.castRingHom ℚ`).  Restriction of
scalars along `f : R →+* S` preserves "finite"/"projective" ONLY when `S` is
itself a finite projective `R`-module (via `f`).  We therefore require the
hypotheses `hfin : Module.Finite R S` and `hproj : Module.Projective R S`
(relative to the `Module R S` coming from `f.toAlgebra`).  For the intended uses
`f = fst`/`snd : R₁×R₂ →+* Rᵢ` these hold because `Rᵢ` is a direct factor of
`R₁×R₂` (idempotent `eᵢ`); those facts are packaged as
`Prod.fst_finite`/`Prod.fst_projective`/`Prod.snd_finite`/`Prod.snd_projective`
below.

The two facts that make the construction go through are `IsScalarTower R S M.carrier`
(immediate from the `compHom` definition of the `R`-action, `r • m = f r • m`) and
transitivity of projectivity and finiteness along `R → S → M.carrier`. -/
noncomputable def FGProj.restrict {R S : Type u} [CommRing R] [CommRing S]
    (f : R →+* S)
    (hfin : letI : Module R S := (f.toAlgebra).toModule; Module.Finite R S)
    (hproj : letI : Module R S := (f.toAlgebra).toModule; Module.Projective R S)
    (M : FGProj S) : FGProj R :=
  letI : Algebra R S := f.toAlgebra
  letI : Module R M.carrier := Module.compHom M.carrier f
  haveI : Module.Finite R S := hfin
  haveI : Module.Projective R S := hproj
  haveI : IsScalarTower R S M.carrier := IsScalarTower.of_algebraMap_smul fun r m => rfl
  haveI : Module.Finite R M.carrier := Module.Finite.trans S M.carrier
  haveI : Module.Projective R M.carrier := by
    classical
    obtain ⟨s, hs⟩ := Module.projective_def'.mp M.projective
    set i : (M.carrier →₀ S) →ₗ[R] M.carrier :=
      (Finsupp.linearCombination S id).restrictScalars R with hi
    set j : M.carrier →ₗ[R] (M.carrier →₀ S) := s.restrictScalars R with hj
    have : Module.Projective R (M.carrier →₀ S) :=
      Module.Projective.of_equiv (finsuppLequivDFinsupp R).symm
    refine Module.Projective.of_split j i ?_
    ext x
    simpa [hi, hj] using DFunLike.congr_fun hs x
  { carrier := M.carrier }

/-- Restriction of scalars of a finite module along `f : R →+* S`, recorded as a
class in `K'₀(R)`: view a finite `S`-module `M` as an `R`-module via `f` and take
its class.  Used with `f = fst`/`snd` to send an `Rᵢ`-module to `K'₀(R₁×R₂)`.

The naive statement is FALSE for arbitrary `f` (the same ℤ ↪ ℚ counterexample as for
`FGProj.restrict`).  Deducing `Module.Finite R M` from `Module.Finite S M` is valid only when
`S` is a finite `R`-module (via `f`), so we add the hypothesis `hfin : Module.Finite R S`;
for `f = fst`/`snd` use `Prod.fst_finite`/`Prod.snd_finite`.  The step then goes through
`IsScalarTower R S M` (immediate from `compHom`) and `Module.Finite.trans S M`. -/
noncomputable def K0prime.restrictMk {R S : Type u} [CommRing R] [CommRing S]
    (f : R →+* S)
    (hfin : letI : Module R S := (f.toAlgebra).toModule; Module.Finite R S)
    (M : Type u) [AddCommGroup M] [Module S M] [Module.Finite S M] :
    K0prime R :=
  letI : Algebra R S := f.toAlgebra
  letI : Module R M := Module.compHom M f
  haveI : Module.Finite R S := hfin
  haveI : IsScalarTower R S M := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  haveI : Module.Finite R M := Module.Finite.trans S M
  K0prime.mkModule R M

/-- `K0prime.mkModule` is well defined on isomorphism classes of finite modules:
isomorphic finite `R`-modules have the same class in `K'₀(R)`. -/
theorem K0prime.mkModule_eq_of_iso {R : Type u} [CommRing R] (A B : Type u)
    [AddCommGroup A] [Module R A] [Module.Finite R A]
    [AddCommGroup B] [Module R B] [Module.Finite R B] (e : A ≃ₗ[R] B) :
    K0prime.mkModule R A = K0prime.mkModule R B := by
  classical
  -- the chosen presentations of `A` and `B`
  obtain ⟨eA⟩ := (FGPres.skeleton_surjective (R := R) A).choose_spec
  obtain ⟨eB⟩ := (FGPres.skeleton_surjective (R := R) B).choose_spec
  set PA := (FGPres.skeleton_surjective (R := R) A).choose with hPA
  set PB := (FGPres.skeleton_surjective (R := R) B).choose with hPB
  -- the relation `of PA - of PB ∈ K0Sub R`, hence `mk PA = mk PB`
  exact QuotientAddGroup.eq_iff_sub_mem.2
    (AddSubgroup.subset_closure (K0Rel.iso PA PB (eA.trans (e.trans eB.symm))))

/-- `K0prime.mkModule` is additive on short exact sequences of finite `R`-modules:
given `f : A' →ₗ A` injective, `g : A →ₗ A''` surjective with `Function.Exact f g`,
we have `mkModule A = mkModule A' + mkModule A''`. -/
theorem K0prime.mkModule_add_of_ses {R : Type u} [CommRing R] (A A' A'' : Type u)
    [AddCommGroup A] [Module R A] [Module.Finite R A]
    [AddCommGroup A'] [Module R A'] [Module.Finite R A']
    [AddCommGroup A''] [Module R A''] [Module.Finite R A'']
    (f : A' →ₗ[R] A) (g : A →ₗ[R] A'')
    (hf : Function.Injective f) (hg : Function.Surjective g) (he : Function.Exact f g) :
    K0prime.mkModule R A = K0prime.mkModule R A' + K0prime.mkModule R A'' := by
  classical
  obtain ⟨eA⟩ := (FGPres.skeleton_surjective (R := R) A).choose_spec
  obtain ⟨eA'⟩ := (FGPres.skeleton_surjective (R := R) A').choose_spec
  obtain ⟨eA''⟩ := (FGPres.skeleton_surjective (R := R) A'').choose_spec
  set PA := (FGPres.skeleton_surjective (R := R) A).choose with hPA
  set PA' := (FGPres.skeleton_surjective (R := R) A').choose with hPA'
  set PA'' := (FGPres.skeleton_surjective (R := R) A'').choose with hPA''
  -- transport the SES along the presentation isos
  let f' : PA'.module →ₗ[R] PA.module := eA.symm.toLinearMap.comp (f.comp eA'.toLinearMap)
  let g' : PA.module →ₗ[R] PA''.module := eA''.symm.toLinearMap.comp (g.comp eA.toLinearMap)
  have hf'apply : ∀ x, f' x = eA.symm (f (eA' x)) := fun x => rfl
  have hg'apply : ∀ x, g' x = eA''.symm (g (eA x)) := fun x => rfl
  have hf' : Function.Injective f' := by
    intro x y hxy
    rw [hf'apply, hf'apply] at hxy
    exact eA'.injective (hf (eA.symm.injective hxy))
  have hg' : Function.Surjective g' := by
    intro z
    obtain ⟨a, ha⟩ := hg (eA'' z)
    refine ⟨eA.symm a, ?_⟩
    rw [hg'apply, eA.apply_symm_apply, ha, eA''.symm_apply_apply]
  have he' : Function.Exact f' g' := by
    refine fun x => ⟨fun hx => ?_, fun ⟨w, hw⟩ => ?_⟩
    · rw [hg'apply] at hx
      obtain ⟨w, hw⟩ := (he (eA x)).mp (eA''.symm.injective (by simp [hx]))
      refine ⟨eA'.symm w, ?_⟩
      rw [hf'apply, eA'.apply_symm_apply, hw, eA.symm_apply_apply]
    · rw [hg'apply, ← hw, hf'apply, eA.apply_symm_apply, (he _).mpr ⟨eA' w, rfl⟩, map_zero]
  change QuotientAddGroup.mk (FreeAbelianGroup.of PA) =
    QuotientAddGroup.mk (FreeAbelianGroup.of PA') + QuotientAddGroup.mk (FreeAbelianGroup.of PA'')
  rw [← QuotientAddGroup.mk_add, QuotientAddGroup.eq_iff_sub_mem, ← sub_sub]
  exact AddSubgroup.subset_closure (K0Rel.ses PA PA' PA'' f' g' hf' hg' he')
