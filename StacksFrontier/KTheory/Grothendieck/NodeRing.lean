module

public import Mathlib.RingTheory.Ideal.AssociatedPrime.Finiteness
public import StacksFrontier.KTheory.Grothendieck.PID
public import StacksFrontier.RingTheory.NodeRing.Gluing

/-!
# The Grothendieck groups of the node ring

Let `k` be a field and `R = {f ∈ k[x] ∣ f(0) = f(1)}` (`nodeRing k`). This file proves
Stacks, Example 10.55.5 (tag `00JG`):

`K₀(R) ≅ k^* ⊕ ℤ` and `K'₀(R) ≅ ℤ`.

Here `K₀` and `K'₀` are the Grothendieck groups `K0OfProjGen` and `K0PrimeOfFinPres` of
Stacks, Section 10.55: they are generated by the classes of the modules `R^n / K`
(finite projective ones for `K₀`, all of them for `K'₀`), with the relations coming from short
exact sequences.

## `K'₀(R) ≅ ℤ`

The rank `M ↦ dim_{Frac R} (M ⊗ Frac R)` is additive, so it gives `K'₀(R) → ℤ`, sending `[R]`
to `1`. It is an isomorphism because every class is a multiple of `[R]`: `R` is noetherian, so
every finite module is a successive extension of modules `R/𝔭` with `𝔭` prime; for `𝔭 = 0`
this is `R`, and for `𝔭 ≠ 0` we show `R/𝔭 ≅ k[x]/(g)` as `R`-modules for some `g ≠ 0`, whose
class is `[k[x]] - [k[x]] = 0` by the exact sequence `0 → k[x] → k[x] → k[x]/(g) → 0`.

## `K₀(R) ≅ k^* ⊕ ℤ`

Every finite projective `R`-module is a glued module `glued φ`
(`NodeRing.exists_linearEquiv_glued`), and the size `n` and determinant `det φ ∈ k^*` of `φ`
are isomorphism invariants (`NodeRing.card_eq_and_det_eq_of_linearEquiv`), additive on direct
sums. This gives `K₀(R) → k^* ⊕ ℤ`. Its inverse sends `(u, n)` to `[L_u] - [R] + n [R]`, where
`L_u = {f ∣ f(1) = u f(0)}`; it is additive because `L_u ⊕ L_v ≅ L_{uv} ⊕ R`, and every class is
in its image because `glued φ ≅ L_{d₁} ⊕ ⋯ ⊕ L_{dₙ}` after diagonalising `φ` by transvections.
-/

@[expose] public noncomputable section

open Polynomial Matrix

namespace NodeRing

universe u

variable {k : Type u} [Field k]

/-! ### `K'₀(R) ≅ ℤ` -/

/-- The multiplication map `a ↦ x(x - 1) a`, landing in the node ring. -/
def sMul (a : k[X]) : nodeRing k := ⟨X * (X - 1) * a, Stacks.NodalCurve.mul_mem_nodeRing k a⟩

/-- The element `s = x(x - 1)` of the node ring. -/
def sElt : nodeRing k := ⟨X * (X - 1), X_mul_X_sub_one_mem_nodeRing k⟩

lemma sMul_coe (r : nodeRing k) : sMul (r : k[X]) = sElt * r := Subtype.ext rfl

instance (q : Ideal k[X]) : Module.Finite (nodeRing k) (k[X] ⧸ q) :=
  Module.Finite.trans k[X] (k[X] ⧸ q)

/-- For `g ≠ 0`, the class of `k[x]/(g)` in `K'₀(R)` is `0`. -/
theorem mkM_quotient_eq_zero {q : Ideal k[X]} (hq : q ≠ ⊥) :
    K0PrimeOfFinPres.mkM (nodeRing k) (k[X] ⧸ q) = 0 := by
  obtain ⟨g, hg⟩ := (IsPrincipalIdealRing.principal q).principal
  have hg0 : g ≠ 0 := by
    rintro rfl
    exact hq (by rw [hg]; simp)
  let f : k[X] →ₗ[nodeRing k] k[X] := (LinearMap.mulLeft k[X] g).restrictScalars (nodeRing k)
  let π : k[X] →ₗ[nodeRing k] k[X] ⧸ q := (Submodule.mkQ q).restrictScalars (nodeRing k)
  have hf : Function.Injective f := fun a b h => mul_left_cancel₀ hg0 h
  have hπ : Function.Surjective π := Submodule.mkQ_surjective q
  have hfπ : LinearMap.range f = LinearMap.ker π := by
    ext a
    simp only [LinearMap.mem_range, LinearMap.mem_ker, f, π, LinearMap.restrictScalars_apply,
      LinearMap.mulLeft_apply, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero, hg,
      Submodule.mem_span_singleton, smul_eq_mul]
    constructor
    · rintro ⟨b, rfl⟩; exact ⟨b, mul_comm b g⟩
    · rintro ⟨b, rfl⟩; exact ⟨b, mul_comm g b⟩
  have h := K0PrimeOfFinPres.mkM_shortExact f π hf hπ hfπ
  simpa using h

/-- If `k[x] → k[x]/q` restricted to `R` is surjective with kernel `𝔭`, then
`R/𝔭 ≅ k[x]/q` as `R`-modules. -/
lemma nonempty_quotient_equiv (p : Ideal (nodeRing k)) (q : Ideal k[X])
    (hsurj : ∀ a : k[X], ∃ r : nodeRing k, a - r ∈ q)
    (hker : ∀ r : nodeRing k, (r : k[X]) ∈ q ↔ r ∈ p) :
    Nonempty ((nodeRing k ⧸ p) ≃ₗ[nodeRing k] (k[X] ⧸ q)) := by
  let L : nodeRing k →ₗ[nodeRing k] k[X] ⧸ q :=
    (Submodule.mkQ q).restrictScalars (nodeRing k) ∘ₗ Algebra.linearMap (nodeRing k) k[X]
  have hL : Function.Surjective L := by
    intro x
    obtain ⟨a, rfl⟩ := Submodule.mkQ_surjective q x
    obtain ⟨r, hr⟩ := hsurj a
    refine ⟨r, (Submodule.Quotient.eq q).2 ?_⟩
    have := q.neg_mem hr
    rw [neg_sub] at this
    exact this
  have hkerL : p = LinearMap.ker L := by
    ext r
    simp only [LinearMap.mem_ker, L, LinearMap.coe_comp, Function.comp_apply,
      LinearMap.restrictScalars_apply, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
      Algebra.linearMap_apply]
    exact (hker r).symm
  exact ⟨(Submodule.quotEquivOfEq p _ hkerL).trans (L.quotKerEquivOfSurjective hL)⟩

/-- If `s ∈ 𝔭` then `𝔭` contains every element of `R` vanishing at `0`. -/
lemma mem_of_eval_zero {p : Ideal (nodeRing k)} [hp : p.IsPrime] (hs : sElt ∈ p)
    {r : nodeRing k} (h0 : (r : k[X]).eval 0 = 0) : r ∈ p := by
  have h1 : (r : k[X]).eval 1 = 0 := by rw [← (mem_nodeRing_iff _).1 r.2, h0]
  obtain ⟨a, ha⟩ := X_mul_X_sub_one_dvd h0 h1
  have hrr : r * r = sElt * sMul (a * a) := by
    apply Subtype.ext
    simp only [Subring.coe_mul, ha, sElt, sMul]
    ring
  have : r * r ∈ p := hrr ▸ p.mul_mem_right _ hs
  rcases hp.mem_or_mem this with h | h <;> exact h

/-- For a nonzero prime `𝔭` of `R`, `R/𝔭 ≅ k[x]/q` as `R`-modules for a nonzero ideal `q`. -/
theorem exists_quotient_equiv (p : Ideal (nodeRing k)) [hp : p.IsPrime] (hp0 : p ≠ ⊥) :
    ∃ q : Ideal k[X], q ≠ ⊥ ∧ Nonempty ((nodeRing k ⧸ p) ≃ₗ[nodeRing k] (k[X] ⧸ q)) := by
  by_cases hs : sElt ∈ p
  · -- `𝔭` is the singular point: `R/𝔭 ≅ k[x]/(x)`
    refine ⟨Ideal.span {X}, by simp [X_ne_zero], nonempty_quotient_equiv p _ ?_ ?_⟩
    · intro a
      refine ⟨Stacks.NodalCurve.constToNodeRing k (a.eval 0), ?_⟩
      rw [Stacks.NodalCurve.mem_span_X_iff]
      simp [Stacks.NodalCurve.constToNodeRing]
    · intro r
      rw [Stacks.NodalCurve.mem_span_X_iff]
      constructor
      · exact mem_of_eval_zero hs
      · intro hr
        by_contra h0
        set c := (r : k[X]).eval 0
        have hr' : r - Stacks.NodalCurve.constToNodeRing k c ∈ p :=
          mem_of_eval_zero hs (by simp [Stacks.NodalCurve.constToNodeRing, c])
        have hc : Stacks.NodalCurve.constToNodeRing k c ∈ p := by
          simpa using p.sub_mem hr hr'
        exact hp.ne_top (Ideal.eq_top_of_isUnit_mem _ hc
          ((isUnit_iff_ne_zero.mpr h0).map (Stacks.NodalCurve.constToNodeRing k)))
  · -- `s ∉ 𝔭`: `q = {a ∣ s a ∈ 𝔭}`
    let q : Ideal k[X] :=
      { carrier := {a | sMul a ∈ p}
        add_mem' := fun {a b} ha hb => by
          have : sMul (a + b) = sMul a + sMul b := Subtype.ext (by simp [sMul]; ring)
          simpa [this] using p.add_mem ha hb
        zero_mem' := by
          have : sMul (0 : k[X]) = 0 := Subtype.ext (by simp [sMul])
          simp [this]
        smul_mem' := fun c a ha => by
          have hmul : sMul (c * a) * sElt = sMul a * sMul c :=
            Subtype.ext (by simp [sMul, sElt]; ring)
          have : sMul (c * a) * sElt ∈ p := hmul ▸ p.mul_mem_right _ ha
          rcases hp.mem_or_mem this with h | h
          · exact h
          · exact absurd h hs }
    have hmemq : ∀ a : k[X], a ∈ q ↔ sMul a ∈ p := fun a => Iff.rfl
    have hker : ∀ r : nodeRing k, (r : k[X]) ∈ q ↔ r ∈ p := by
      intro r
      rw [hmemq, sMul_coe]
      constructor
      · intro h
        rcases hp.mem_or_mem h with h | h
        · exact absurd h hs
        · exact h
      · exact p.mul_mem_left _
    obtain ⟨f, hfp, hf0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hp0
    have hq0 : q ≠ ⊥ := by
      intro hq
      have : (f : k[X]) ∈ q := (hker f).2 hfp
      rw [hq, Ideal.mem_bot] at this
      exact hf0 (Subtype.ext this)
    refine ⟨q, hq0, nonempty_quotient_equiv p q ?_ hker⟩
    have hqprime : q.IsPrime := by
      refine ⟨fun h => hs ?_, fun {a b} hab => ?_⟩
      · have h1 : (1 : k[X]) ∈ q := h ▸ Submodule.mem_top
        have : sMul (1 : k[X]) = sElt := Subtype.ext (by simp [sMul, sElt])
        rw [hmemq, this] at h1
        exact h1
      · have hmul : sMul (a * b) * sElt = sMul a * sMul b :=
          Subtype.ext (by simp [sMul, sElt]; ring)
        have : sMul a * sMul b ∈ p := hmul ▸ p.mul_mem_right _ hab
        exact hp.mem_or_mem this
    have hqmax : q.IsMaximal := Ideal.IsPrime.isMaximal hqprime hq0
    obtain ⟨g, hgq, hg01⟩ : ∃ g ∈ q, g.eval 1 ≠ 0 ∨ g.eval 0 ≠ 0 := by
      by_contra H
      simp only [not_exists, not_and, not_or, not_not] at H
      have hle : q ≤ Ideal.span {X} := fun g hg =>
        (Stacks.NodalCurve.mem_span_X_iff k g).2 (H g hg).2
      have hXne : Ideal.span {(X : k[X])} ≠ ⊤ := (Stacks.NodalCurve.isMaximal_span_X k).ne_top
      have heq : q = Ideal.span {X} := hqmax.eq_of_le hXne hle
      have hX : (X : k[X]) ∈ q := heq ▸ Ideal.mem_span_singleton_self X
      simpa using (H X hX).1
    have hgq' : ∀ t : k[X], g * t ∈ q := fun t => Ideal.mul_mem_right t _ hgq
    intro a
    rcases hg01 with h1 | h0
    · let t : k[X] := C ((a.eval 0 - a.eval 1) / g.eval 1) * X
      have hr : a + g * t ∈ nodeRing k := by
        rw [mem_nodeRing_iff]
        simp only [eval_add, eval_mul, eval_C, eval_X, t]
        field_simp
        ring
      refine ⟨⟨a + g * t, hr⟩, ?_⟩
      have : a - (a + g * t) = g * (-t) := by ring
      simpa [this] using hgq' (-t)
    · let t : k[X] := C ((a.eval 1 - a.eval 0) / g.eval 0) * (1 - X)
      have hr : a + g * t ∈ nodeRing k := by
        rw [mem_nodeRing_iff]
        simp only [eval_add, eval_mul, eval_C, eval_X, eval_sub, eval_one, t]
        field_simp
        ring
      refine ⟨⟨a + g * t, hr⟩, ?_⟩
      have : a - (a + g * t) = g * (-t) := by ring
      simpa [this] using hgq' (-t)

/-- For a nonzero prime `𝔭` of `R`, the class of `R/𝔭` in `K'₀(R)` is `0`. -/
theorem mkM_quotient_prime_eq_zero (p : Ideal (nodeRing k)) [p.IsPrime] (hp0 : p ≠ ⊥) :
    K0PrimeOfFinPres.mkM (nodeRing k) (nodeRing k ⧸ p) = 0 := by
  obtain ⟨q, hq, ⟨e⟩⟩ := exists_quotient_equiv p hp0
  rw [K0PrimeOfFinPres.mkM_iso e, mkM_quotient_eq_zero hq]

/-- The class `[R]` of the free module of rank one in `K'₀(R)`. -/
abbrev freeClass' : K0PrimeOfFinPres (nodeRing k) :=
  K0PrimeOfFinPres.mk (nodeRing k) (K0'Gen.free1 (nodeRing k))

/-- In `K'₀(R)`, the class of every finite module `M` is `rank M • [R]`. -/
theorem mkM_eq_rankZM_smul (M : Type u) [AddCommGroup M] [Module (nodeRing k) M]
    [Module.Finite (nodeRing k) M] :
    K0PrimeOfFinPres.mkM (nodeRing k) M = rankZM (nodeRing k) M • freeClass' := by
  refine IsNoetherianRing.induction_on_isQuotientEquivQuotientPrime (A := nodeRing k)
    (motive := fun (N : Type u) [AddCommGroup N] [Module (nodeRing k) N]
      [Module.Finite (nodeRing k) N] =>
      K0PrimeOfFinPres.mkM (nodeRing k) N = rankZM (nodeRing k) N • freeClass')
    (inferInstance : Module.Finite (nodeRing k) M) ?_ ?_ ?_
  · intro N _ _ _ _
    rw [K0PrimeOfFinPres.mkM_subsingleton]
    simp [rankZM, rank_subsingleton']
  · intro N _ _ _ p e
    by_cases hp : p.asIdeal = ⊥
    · let e' : N ≃ₗ[nodeRing k] (Fin 1 → nodeRing k) :=
        e.trans ((Submodule.quotEquivOfEqBot _ hp).trans
          (LinearEquiv.funUnique (Fin 1) (nodeRing k) (nodeRing k)).symm)
      rw [K0PrimeOfFinPres.mkM_iso e', K0PrimeOfFinPres.mkM_free, rankZM_iso e', rankZM_free]
    · have := p.isPrime
      rw [K0PrimeOfFinPres.mkM_iso e, mkM_quotient_prime_eq_zero p.asIdeal hp, rankZM_iso e]
      obtain ⟨f, hfp, hf0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hp
      have htor : Module.IsTorsion (nodeRing k) (nodeRing k ⧸ p.asIdeal) := by
        intro x
        refine ⟨⟨f, mem_nonZeroDivisors_of_ne_zero hf0⟩, ?_⟩
        induction x using Submodule.Quotient.induction_on with
        | _ a =>
          rw [Submonoid.smul_def, ← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
          exact p.asIdeal.mul_mem_right a hfp
      simp [rankZM, Module.rank_eq_zero_iff_isTorsion.mpr htor]
  · intro N₁ _ _ _ N₂ _ _ _ N₃ _ _ _ f g hf hg hfg h₁ h₃
    have hrange : LinearMap.range f = LinearMap.ker g := hfg.linearMap_ker_eq.symm
    rw [K0PrimeOfFinPres.mkM_shortExact f g hf hg hrange, h₁, h₃,
      rankZM_shortExact f g hf hg hrange, add_smul]

/-- Every element of `K'₀(R)` is its rank times `[R]`. -/
theorem eq_rankHom_smul_freeClass' (x : K0PrimeOfFinPres (nodeRing k)) :
    x = rankHom (nodeRing k) x • freeClass' := by
  let π : FreeAbelianGroup (K0'Gen (nodeRing k)) →+ K0PrimeOfFinPres (nodeRing k) :=
    QuotientAddGroup.mk' (K0'Rel (nodeRing k))
  obtain ⟨z, rfl⟩ := QuotientAddGroup.mk'_surjective (K0'Rel (nodeRing k)) x
  change π z = rankHom _ (π z) • freeClass'
  induction z using FreeAbelianGroup.induction_on with
  | zero => simp
  | of p =>
    change K0PrimeOfFinPres.mk _ p = rankHom _ (K0PrimeOfFinPres.mk _ p) • freeClass'
    rw [rankHom_mk, ← K0PrimeOfFinPres.mkM_eq_mk_of_iso (K0'Gen.module _ p)
      (LinearEquiv.refl _ _), mkM_eq_rankZM_smul]
    rfl
  | neg p ih =>
    rw [map_neg, map_neg, neg_smul]
    exact congrArg Neg.neg ih
  | add x y ihx ihy => rw [map_add, map_add, add_smul, ← ihx, ← ihy]

/-- **`K'₀(R) ≅ ℤ`**, via the rank, with `[R] ↦ 1`. -/
theorem exists_K0prime_addEquiv_int :
    ∃ e : K0PrimeOfFinPres (nodeRing k) ≃+ ℤ, e freeClass' = 1 := by
  have hbij : Function.Bijective (rankHom (nodeRing k)) := by
    refine ⟨fun x y hxy => ?_, fun n => ⟨n • freeClass', ?_⟩⟩
    · rw [eq_rankHom_smul_freeClass' x, eq_rankHom_smul_freeClass' y, hxy]
    · rw [map_zsmul, rankHom_free1, smul_eq_mul, mul_one]
  exact ⟨AddEquiv.ofBijective _ hbij, rankHom_free1⟩

/-! ### Line bundles are finite projective -/

/-- `L_u ⊕ L_{u⁻¹} ≅ R ⊕ R`. -/
def lineModProdInvEquiv (u : kˣ) :
    (lineMod (u : k) × lineMod ((u⁻¹ : kˣ) : k)) ≃ₗ[nodeRing k] (nodeRing k × nodeRing k) :=
  (lineModProdEquiv u.ne_zero _).trans
    (LinearEquiv.prodCongr
      ((LinearEquiv.ofEq _ _ (congrArg lineMod (u.mul_inv))).trans lineModOneEquiv)
      lineModOneEquiv)

instance (u : kˣ) : Module.Projective (nodeRing k) (lineMod (u : k)) :=
  Module.Projective.of_split ((lineModProdInvEquiv u).toLinearMap ∘ₗ LinearMap.inl _ _ _)
    (LinearMap.fst _ _ _ ∘ₗ (lineModProdInvEquiv u).symm.toLinearMap)
    (LinearMap.ext fun x => by simp)

instance (u : kˣ) : Module.Finite (nodeRing k) (lineMod (u : k)) :=
  Module.Finite.of_surjective (LinearMap.fst _ _ _ ∘ₗ (lineModProdInvEquiv u).symm.toLinearMap)
    (fun x => ⟨lineModProdInvEquiv u (x, 0), by simp⟩)

/-! ### `K₀(R) ≅ k^* ⊕ ℤ` -/

/-- The class `[R]` of the free module of rank one in `K₀(R)`. -/
abbrev freeClass : K0OfProjGen (nodeRing k) :=
  K0OfProjGen.mk (nodeRing k) (K0Gen.free1 (nodeRing k))

/-- The class of `L_1 ≅ R` is `[R]`. -/
lemma mkM_lineMod_one :
    K0OfProjGen.mkM (nodeRing k) (lineMod ((1 : kˣ) : k)) = freeClass := by
  refine K0OfProjGen.mkM_eq_mk_of_iso _ ?_
  exact (Submodule.quotEquivOfEqBot _ rfl).trans
    ((LinearEquiv.funUnique (Fin 1) (nodeRing k) (nodeRing k)).trans lineModOneEquiv.symm)

/-- `[L_u] + [L_v] = [L_{uv}] + [R]` in `K₀(R)`. -/
lemma mkM_lineMod_add (u v : kˣ) :
    K0OfProjGen.mkM (nodeRing k) (lineMod (u : k)) +
        K0OfProjGen.mkM (nodeRing k) (lineMod (v : k)) =
      K0OfProjGen.mkM (nodeRing k) (lineMod ((u * v : kˣ) : k)) + freeClass := by
  let e : (lineMod (u : k) × lineMod (v : k)) ≃ₗ[nodeRing k]
      (lineMod ((u * v : kˣ) : k) × lineMod ((1 : kˣ) : k)) := lineModProdEquiv u.ne_zero v
  rw [← K0OfProjGen.mkM_prod, K0OfProjGen.mkM_iso e, K0OfProjGen.mkM_prod, mkM_lineMod_one]

/-- `u ↦ [L_u] - [R]`, a homomorphism `k^* → K₀(R)`. -/
def unitsHom : Additive kˣ →+ K0OfProjGen (nodeRing k) :=
  AddMonoidHom.mk' (fun a => K0OfProjGen.mkM (nodeRing k) (lineMod ((a.toMul : kˣ) : k))
      - freeClass) (fun a b => by
    simp only [toMul_add]
    rw [sub_add_sub_comm, mkM_lineMod_add]
    abel)

/-- The inverse map `k^* ⊕ ℤ → K₀(R)`, `(u, n) ↦ [L_u] - [R] + n [R]`. -/
def invHom : Additive kˣ × ℤ →+ K0OfProjGen (nodeRing k) :=
  unitsHom.coprod (zmultiplesHom _ freeClass)

lemma invHom_apply (a : Additive kˣ) (n : ℤ) :
    invHom (a, n) = K0OfProjGen.mkM (nodeRing k) (lineMod ((a.toMul : kˣ) : k)) - freeClass
      + n • freeClass := by
  simp [invHom, unitsHom]

/-- The invariant `(det φ, n)` of a finite projective module `P ≅ glued φ`. -/
def gluedInvariant (k : Type u) [Field k] (P : Type u) [AddCommGroup P] [Module (nodeRing k) P]
    [Module.Finite (nodeRing k) P] [Module.Projective (nodeRing k) P] : Additive kˣ × ℤ :=
  let h := exists_linearEquiv_glued (k := k) P
  (Additive.ofMul h.choose_spec.choose_spec.1.unit, (h.choose : ℤ))

/-- The invariant may be computed from any presentation `P ≅ glued φ`. -/
theorem gluedInvariant_eq (P : Type u) [AddCommGroup P] [Module (nodeRing k) P]
    [Module.Finite (nodeRing k) P] [Module.Projective (nodeRing k) P]
    {ι : Type*} [Fintype ι] [DecidableEq ι] {φ : Matrix ι ι k} (hφ : IsUnit φ.det)
    (e : P ≃ₗ[nodeRing k] glued φ) :
    gluedInvariant k P = (Additive.ofMul hφ.unit, (Fintype.card ι : ℤ)) := by
  have h := exists_linearEquiv_glued (k := k) P
  obtain ⟨hcard, hdet⟩ := card_eq_and_det_eq_of_linearEquiv
    (exists_linearEquiv_glued (k := k) P).choose_spec.choose_spec.1 hφ
    ((exists_linearEquiv_glued (k := k) P).choose_spec.choose_spec.2.some.symm.trans e)
  simp only [gluedInvariant, Fintype.card_fin] at hcard ⊢
  refine Prod.ext ?_ ?_
  · dsimp only
    congr 1
    exact Units.ext (by simpa using hdet)
  · dsimp only
    exact_mod_cast hcard

theorem gluedInvariant_iso {P Q : Type u} [AddCommGroup P] [Module (nodeRing k) P]
    [Module.Finite (nodeRing k) P] [Module.Projective (nodeRing k) P] [AddCommGroup Q]
    [Module (nodeRing k) Q] [Module.Finite (nodeRing k) Q] [Module.Projective (nodeRing k) Q]
    (e : P ≃ₗ[nodeRing k] Q) : gluedInvariant k P = gluedInvariant k Q := by
  obtain ⟨n, φ, hφ, ⟨eQ⟩⟩ := exists_linearEquiv_glued (k := k) Q
  rw [gluedInvariant_eq P hφ (e.trans eQ), gluedInvariant_eq Q hφ eQ]

theorem gluedInvariant_prod (P Q : Type u) [AddCommGroup P] [Module (nodeRing k) P]
    [Module.Finite (nodeRing k) P] [Module.Projective (nodeRing k) P] [AddCommGroup Q]
    [Module (nodeRing k) Q] [Module.Finite (nodeRing k) Q] [Module.Projective (nodeRing k) Q] :
    gluedInvariant k (P × Q) = gluedInvariant k P + gluedInvariant k Q := by
  classical
  obtain ⟨n, φ, hφ, ⟨eP⟩⟩ := exists_linearEquiv_glued (k := k) P
  obtain ⟨m, ψ, hψ, ⟨eQ⟩⟩ := exists_linearEquiv_glued (k := k) Q
  have hφψ := isUnit_det_fromBlocks hφ hψ
  rw [gluedInvariant_eq (P × Q) hφψ ((eP.prodCongr eQ).trans (gluedFromBlocksEquiv φ ψ).symm),
    gluedInvariant_eq P hφ eP, gluedInvariant_eq Q hψ eQ]
  refine Prod.ext ?_ ?_
  · simp only [Prod.fst_add]
    rw [← ofMul_mul]
    congr 1
    exact Units.ext (by simp [det_fromBlocks_zero₂₁])
  · simp

theorem gluedInvariant_shortExact {A B C : Type u} [AddCommGroup A] [Module (nodeRing k) A]
    [Module.Finite (nodeRing k) A] [Module.Projective (nodeRing k) A] [AddCommGroup B]
    [Module (nodeRing k) B] [Module.Finite (nodeRing k) B] [Module.Projective (nodeRing k) B]
    [AddCommGroup C] [Module (nodeRing k) C] [Module.Finite (nodeRing k) C]
    [Module.Projective (nodeRing k) C] (f : A →ₗ[nodeRing k] B) (g : B →ₗ[nodeRing k] C)
    (hf : Function.Injective f) (hg : Function.Surjective g)
    (hfg : LinearMap.range f = LinearMap.ker g) :
    gluedInvariant k B = gluedInvariant k A + gluedInvariant k C := by
  obtain ⟨l, hl⟩ := Module.projective_lifting_property g LinearMap.id hg
  have hex : Function.Exact f g := LinearMap.exact_iff.mpr hfg.symm
  rw [gluedInvariant_iso ((Function.Exact.splitSurjectiveEquiv hex hf) ⟨l, hl⟩).1,
    gluedInvariant_prod]

/-- The invariant on the generators of `K₀(R)`. -/
def genInvariant (p : K0Gen (nodeRing k)) : Additive kˣ × ℤ :=
  haveI : Module.Projective (nodeRing k) (K0'Gen.module (nodeRing k) p.1) := p.2
  gluedInvariant k (K0'Gen.module (nodeRing k) p.1)

/-- The homomorphism `K₀(R) → k^* ⊕ ℤ`, `[P] ↦ (det φ, n)` for `P ≅ glued φ`. -/
def invariantHom : K0OfProjGen (nodeRing k) →+ Additive kˣ × ℤ :=
  QuotientAddGroup.lift (K0RelOfProjGen (nodeRing k)) (FreeAbelianGroup.lift genInvariant) (by
    rw [K0RelOfProjGen, AddSubgroup.closure_le]
    rintro x ⟨p₁, p₂, p₃, ⟨f, g, hf, hg, hfg⟩, rfl⟩
    have : Module.Projective (nodeRing k) (K0'Gen.module (nodeRing k) p₁.1) := p₁.2
    have : Module.Projective (nodeRing k) (K0'Gen.module (nodeRing k) p₂.1) := p₂.2
    have : Module.Projective (nodeRing k) (K0'Gen.module (nodeRing k) p₃.1) := p₃.2
    have h := gluedInvariant_shortExact f g hf hg hfg
    simp only [SetLike.mem_coe, AddMonoidHom.mem_ker, map_sub, FreeAbelianGroup.lift_apply_of,
      genInvariant]
    rw [h]
    abel)

lemma invariantHom_mk (p : K0Gen (nodeRing k)) :
    invariantHom (K0OfProjGen.mk (nodeRing k) p) = genInvariant p :=
  FreeAbelianGroup.lift_apply_of _ _

lemma invariantHom_mkM (P : Type u) [AddCommGroup P] [Module (nodeRing k) P]
    [Module.Finite (nodeRing k) P] [Module.Projective (nodeRing k) P] :
    invariantHom (K0OfProjGen.mkM (nodeRing k) P) = gluedInvariant k P := by
  obtain ⟨p, ⟨e⟩⟩ := K0OfProjGen.exists_gen_of_iso (R := nodeRing k) P
  have : Module.Projective (nodeRing k) (K0'Gen.module (nodeRing k) p.1) := p.2
  rw [K0OfProjGen.mkM_eq_mk_of_iso P e, invariantHom_mk]
  exact gluedInvariant_iso e

lemma gluedInvariant_lineMod (u : kˣ) :
    gluedInvariant k (lineMod (u : k)) = (Additive.ofMul u, 1) := by
  let D : Fin 1 → k := fun _ => u
  have hD : IsUnit (diagonal D).det := by simp [D]
  rw [gluedInvariant_eq (lineMod (u : k)) hD
    ((LinearEquiv.funUnique (Fin 1) (nodeRing k) (lineMod (u : k))).symm.trans
      (gluedDiagonalEquiv D).symm)]
  refine Prod.ext ?_ (by simp)
  simp only
  congr 1
  exact Units.ext (by simp [D])

lemma invariantHom_freeClass : invariantHom (freeClass (k := k)) = (0, 1) := by
  rw [← mkM_lineMod_one, invariantHom_mkM, gluedInvariant_lineMod]
  simp

lemma invariantHom_invHom (x : Additive kˣ × ℤ) : invariantHom (invHom x) = x := by
  obtain ⟨a, n⟩ := x
  rw [invHom_apply, map_add, map_sub, map_zsmul, invariantHom_mkM, gluedInvariant_lineMod,
    invariantHom_freeClass]
  refine Prod.ext ?_ ?_ <;> simp

/-- The class of `glued (diagonal U)` is `invHom (∏ U, n)`. -/
lemma mkM_glued_diagonal (n : ℕ) (U : Fin n → kˣ)
    [Module.Finite (nodeRing k) (glued (diagonal fun i => (U i : k)))]
    [Module.Projective (nodeRing k) (glued (diagonal fun i => (U i : k)))] :
    K0OfProjGen.mkM (nodeRing k) (glued (diagonal fun i => (U i : k))) =
      invHom (Additive.ofMul (∏ i, U i), (n : ℤ)) := by
  induction n with
  | zero =>
    have : Subsingleton (glued (diagonal fun i => (U i : k))) :=
      ⟨fun a b => Subtype.ext (funext fun i => Fin.elim0 i)⟩
    rw [K0OfProjGen.mkM_subsingleton, invHom_apply]
    simp only [Fin.prod_univ_zero, toMul_ofMul, Nat.cast_zero, zero_smul, add_zero]
    rw [mkM_lineMod_one, sub_self]
  | succ n ih =>
    let e : glued (diagonal fun i => (U i : k)) ≃ₗ[nodeRing k]
        lineMod (U 0 : k) × glued (diagonal fun i : Fin n => (U i.succ : k)) :=
      (gluedDiagonalEquiv _).trans ((piFinSuccEquiv (R := nodeRing k) n
        (fun i => lineMod (U i : k))).trans
        (LinearEquiv.prodCongr (LinearEquiv.refl _ _) (gluedDiagonalEquiv _).symm))
    have : Module.Projective (nodeRing k) (glued (diagonal fun i : Fin n => (U i.succ : k))) :=
      Module.Projective.of_split (e.symm.toLinearMap ∘ₗ LinearMap.inr _ _ _)
        (LinearMap.snd _ _ _ ∘ₗ e.toLinearMap) (LinearMap.ext fun x => by simp)
    have : Module.Finite (nodeRing k) (glued (diagonal fun i : Fin n => (U i.succ : k))) :=
      Module.Finite.of_surjective (LinearMap.snd _ _ _ ∘ₗ e.toLinearMap)
        (fun x => ⟨e.symm (0, x), by simp⟩)
    rw [K0OfProjGen.mkM_iso e, K0OfProjGen.mkM_prod, ih (fun i => U i.succ),
      Fin.prod_univ_succ, ofMul_mul]
    rw [show ((Additive.ofMul (U 0) + Additive.ofMul (∏ i : Fin n, U i.succ)),
        ((n + 1 : ℕ) : ℤ)) = (Additive.ofMul (U 0), (1 : ℤ)) +
          (Additive.ofMul (∏ i : Fin n, U i.succ), (n : ℤ)) by
        refine Prod.ext rfl ?_; simp [add_comm], map_add, invHom_apply (Additive.ofMul (U 0))]
    simp

lemma invHom_invariantHom (y : K0OfProjGen (nodeRing k)) : invHom (invariantHom y) = y := by
  let π : FreeAbelianGroup (K0Gen (nodeRing k)) →+ K0OfProjGen (nodeRing k) :=
    QuotientAddGroup.mk' (K0RelOfProjGen (nodeRing k))
  obtain ⟨z, rfl⟩ := QuotientAddGroup.mk'_surjective (K0RelOfProjGen (nodeRing k)) y
  change invHom (invariantHom (π z)) = π z
  induction z using FreeAbelianGroup.induction_on with
  | zero => simp
  | of p =>
    change invHom (invariantHom (K0OfProjGen.mk _ p)) = K0OfProjGen.mk _ p
    have : Module.Projective (nodeRing k) (K0'Gen.module (nodeRing k) p.1) := p.2
    rw [← K0OfProjGen.mkM_eq_mk_of_iso (K0'Gen.module _ p.1) (LinearEquiv.refl _ _),
      invariantHom_mkM]
    obtain ⟨n, φ, hφ, ⟨e⟩⟩ := exists_linearEquiv_glued (k := k) (K0'Gen.module _ p.1)
    obtain ⟨D, hD, ⟨e'⟩⟩ := exists_gluedEquiv_diagonal φ
    have hD0 : ∀ i, D i ≠ 0 := by
      have : ∏ i, D i ≠ 0 := by rw [hD]; exact hφ.ne_zero
      exact fun i => (Finset.prod_ne_zero_iff.mp this) i (Finset.mem_univ i)
    let U : Fin n → kˣ := fun i => Units.mk0 (D i) (hD0 i)
    have hDU : D = fun i => (U i : k) := rfl
    let e₂ : K0'Gen.module (nodeRing k) p.1 ≃ₗ[nodeRing k] glued (diagonal fun i => (U i : k)) :=
      e.trans (hDU ▸ e')
    have : Module.Projective (nodeRing k) (glued (diagonal fun i => (U i : k))) :=
      Module.Projective.of_equiv e₂
    have : Module.Finite (nodeRing k) (glued (diagonal fun i => (U i : k))) :=
      Module.Finite.equiv e₂
    rw [gluedInvariant_eq _ hφ e, K0OfProjGen.mkM_iso e₂, mkM_glued_diagonal, Fintype.card_fin]
    congr 3
    exact Units.ext (by simp [U, ← hD])
  | neg p ih =>
    rw [map_neg, map_neg, map_neg]
    exact congrArg Neg.neg ih
  | add x y ihx ihy => rw [map_add, map_add, map_add, ihx, ihy]

/-- **`K₀(R) ≅ k^* ⊕ ℤ`**, with `[R] ↦ (1, 1)` and `[L_u] ↦ (u, 1)` (`k^*` written additively, so
`(1, 1)` is `(0, 1)`). -/
theorem exists_K0_addEquiv :
    ∃ e : K0OfProjGen (nodeRing k) ≃+ Additive kˣ × ℤ,
      e freeClass = (0, 1) ∧
        ∀ u : kˣ, e (K0OfProjGen.mkM (nodeRing k) (lineMod (u : k))) = (Additive.ofMul u, 1) :=
  ⟨{ toFun := invariantHom
     invFun := invHom
     left_inv := invHom_invariantHom
     right_inv := invariantHom_invHom
     map_add' := map_add _ },
    invariantHom_freeClass, fun u => by
      change invariantHom (K0OfProjGen.mkM (nodeRing k) (lineMod (u : k))) = _
      rw [invariantHom_mkM, gluedInvariant_lineMod]⟩

end NodeRing

open NodeRing in
/-- **Stacks Example 10.55.5 (tag `00JG`).** Let `k` be a field and
`R = {f ∈ k[x] ∣ f(0) = f(1)}`. Then `K₀(R) ≅ k^* ⊕ ℤ`, but `K'₀(R) ≅ ℤ`.

Here `K₀(R)` (`K0OfProjGen`) and `K'₀(R)` (`K0PrimeOfFinPres`) are the Grothendieck groups of
finite projective, respectively finite, `R`-modules, with relations from short exact sequences,
and `k^*` is written additively. The isomorphisms are `NodeRing.exists_K0_addEquiv` (sending
`[R]` to `(1, 1)` and the line bundle `L_u = {f ∣ f(1) = u f(0)}` to `(u, 1)`) and
`NodeRing.exists_K0prime_addEquiv_int` (the rank, sending `[R]` to `1`). -/
@[stacks 00JG "`K₀(R) ≅ k^* ⊕ ℤ` and `K'₀(R) ≅ ℤ` for `R = {f ∈ k[x] ∣ f(0) = f(1)}`"]
theorem nodeRing_K0_addEquiv_and_K0prime_addEquiv (k : Type*) [Field k] :
    Nonempty (K0OfProjGen (nodeRing k) ≃+ Additive kˣ × ℤ) ∧
      Nonempty (K0PrimeOfFinPres (nodeRing k) ≃+ ℤ) :=
  ⟨⟨(exists_K0_addEquiv (k := k)).choose⟩, ⟨(exists_K0prime_addEquiv_int (k := k)).choose⟩⟩
