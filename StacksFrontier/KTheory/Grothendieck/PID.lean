/-!
# The Grothendieck groups of the polynomial ring in one variable

We follow the Stacks Project, Section 10.55 (tag `00JC`).  Throughout `R` is a
commutative ring and all modules are `R`-modules.  A *finite `R`-module* means a
finitely generated `R`-module.

## Main definitions

* **`K0'(R)`** is the Grothendieck group of all finite `R`-modules: it is the
  quotient of the free abelian group on (isomorphism classes of) finite modules by
  the relations `[M] = [M'] + [M'']` coming from short exact sequences
  `0 → M' → M → M'' → 0`.

  Concretely (to avoid set-theoretic issues) one takes as generators the modules
  `R^n / K` for `n : ℕ` and `K ⊆ R^n` a submodule, and quotients the free abelian
  group on these generators by the subgroup generated by the relations
  `[N] - [N'] - [N'']` arising from short exact sequences `0 → N' → N → N'' → 0`. This is
  `K0PrimeOfFinPres`.

* **`K0(R)`** is the analogous Grothendieck group built from *finite projective*
  `R`-modules only. This is `K0OfProjGen`.

* **The canonical map `ι : K0(R) → K0'(R)`** sends `[M] ↦ [M]` (every finite
  projective module is finite).

## Main results

Let `k` be a field and `R = k[x] = Polynomial k`.

* **Statement 1.** `K0(k[x]) ≅ ℤ` as abelian groups, via the rank map `[k[x]] ↦ 1`.
* **Statement 2.** `K0'(k[x]) ≅ ℤ` as abelian groups, via the rank map `[k[x]] ↦ 1`.
* **Statement 3.** The canonical homomorphism `ι : K0(k[x]) → K0'(k[x])` is an
  isomorphism.

This is Example 10.55.4 (tag `00JF`) of the Stacks Project, the special case
`R = k[x]` of the fact (tag `0FJ8`) that `K0(R) = K0'(R) = ℤ` for any PID `R`.
-/

@[expose] public section

variable (R : Type*) [CommRing R]

/-- A generator: a natural number `n` together with a submodule `K ⊆ R^n`,
    representing the finite module `(Fin n → R) ⧸ K`.  Every finite `R`-module is
    isomorphic to one of these (it admits a presentation `R^n / K`). -/
abbrev K0'Gen :=
  Σ n : ℕ, Submodule R (Fin n → R)

/-- The finite `R`-module attached to a generator `⟨n, K⟩`, namely `R^n / K`. -/
abbrev K0'Gen.module (p : K0'Gen R) : Type _ :=
  (Fin p.fst → R) ⧸ p.snd

/-- The predicate that there is a short exact sequence
    `0 → (module p₁) → (module p₂) → (module p₃) → 0`
    between the modules attached to three generators: an injective `f`, a surjective
    `g`, with `range f = ker g`. -/
def K0'Gen.ShortExact (p₁ p₂ p₃ : K0'Gen R) : Prop :=
  ∃ (f : K0'Gen.module R p₁ →ₗ[R] K0'Gen.module R p₂) (g :
    K0'Gen.module R p₂ →ₗ[R] K0'Gen.module R p₃),
    Function.Injective f ∧ Function.Surjective g ∧ LinearMap.range f = LinearMap.ker g

open FreeAbelianGroup in
/-- The subgroup of relations defining `K0'(R)`: generated by `[N] - [N'] - [N'']`
    for every short exact sequence `0 → N' → N → N'' → 0` of finite modules. -/
def K0'Rel : AddSubgroup (FreeAbelianGroup (K0'Gen R)) :=
  AddSubgroup.closure
    {x | ∃ p₁ p₂ p₃ : K0'Gen R, K0'Gen.ShortExact R p₁ p₂ p₃ ∧ x = of p₂ - of p₁ - of p₃}

/-- **`K0'(R)`**: the Grothendieck group of finite `R`-modules, as the free abelian
    group on the generators `R^n / K` modulo the short-exact-sequence relations. -/
@[sga "6 IV 2.2" "special case"]
def K0PrimeOfFinPres :=
  FreeAbelianGroup (K0'Gen R) ⧸ K0'Rel R

/-- The abelian group structure on `K0'(R)`. -/
noncomputable instance : AddCommGroup (K0PrimeOfFinPres R) := by
  unfold K0PrimeOfFinPres; infer_instance

/-- Generators for `K0(R)`: those generators `⟨n, K⟩` whose module `R^n / K` is
    (finite) projective. -/
abbrev K0Gen :=
  { p : K0'Gen R // Module.Projective R (K0'Gen.module R p) }

open FreeAbelianGroup in
/-- The relation subgroup defining `K0(R)`: generated by `[N] - [N'] - [N'']` for
    short exact sequences of finite projective modules. -/
def K0RelOfProjGen : AddSubgroup (FreeAbelianGroup (K0Gen R)) :=
  AddSubgroup.closure
    {x |
      ∃ p₁ p₂ p₃ : K0Gen R, K0'Gen.ShortExact R p₁.val p₂.val p₃.val ∧ x = of p₂ - of p₁ - of p₃}

/-- **`K0(R)`**: the Grothendieck group of finite projective `R`-modules, as the free
    abelian group on the projective generators `R^n / K` modulo the short-exact-sequence
    relations. -/
@[sga "6 IV 2.2" "special case",
  sga "6 IV 2.6" "K'_naif(A', special case",
  sga "6 V 2.2" "special case",
  sga "6 V 3.9.1" "(X), special case"]
def K0OfProjGen :=
  FreeAbelianGroup (K0Gen R) ⧸ K0RelOfProjGen R

/-- The abelian group structure on `K0(R)`. -/
noncomputable instance : AddCommGroup (K0OfProjGen R) := by
  unfold K0OfProjGen; infer_instance

/-- The class `[R^n / K]` of a generator in `K0'(R)`. -/
@[sga "6 X 1.1" "(F), special case"]
def K0PrimeOfFinPres.mk (p : K0'Gen R) : K0PrimeOfFinPres R :=
  QuotientAddGroup.mk' (K0'Rel R) (FreeAbelianGroup.of p)

/-- The class `[M]` of a finite projective generator in `K0(R)`. -/
@[sga "6 X 1.2" "special case"]
def K0OfProjGen.mk (p : K0Gen R) : K0OfProjGen R :=
  QuotientAddGroup.mk' (K0RelOfProjGen R) (FreeAbelianGroup.of p)

/-- The rank-1 free module `R = R^1 / 0` as a generator. -/
def K0'Gen.free1 : K0'Gen R :=
  ⟨1, ⊥⟩

/-- The rank-1 free module is projective, hence a `K0`-generator. -/
theorem K0'Gen.free1_projective : Module.Projective R (K0'Gen.module R (K0'Gen.free1 R)) := by
  have e : (K0'Gen.module R (K0'Gen.free1 R)) ≃ₗ[R] (Fin 1 → R) := Submodule.quotEquivOfEqBot _ rfl
  exact Module.Projective.of_equiv e.symm

/-- The class of `k[x]` (the rank-1 free module) as a `K0`-generator. -/
def K0Gen.free1 : K0Gen R :=
  ⟨K0'Gen.free1 R, K0'Gen.free1_projective R⟩

open FreeAbelianGroup in
/-- The map on free abelian groups underlying the canonical map: send a projective
    generator to the same generator regarded as an arbitrary finite-module generator. -/
noncomputable def K0toK0'Free : FreeAbelianGroup (K0Gen R) →+ FreeAbelianGroup (K0'Gen R) :=
  FreeAbelianGroup.map (fun p => p.val)

/-- The `K0`-relations are sent into the `K0'`-relations by the underlying map. -/
theorem K0RelOfProjGen_le_comap :
    K0RelOfProjGen R ≤ AddSubgroup.comap (K0toK0'Free R) (K0'Rel R) := by
  rw [K0RelOfProjGen, AddSubgroup.closure_le]
  rintro x ⟨p₁, p₂, p₃, hse, rfl⟩
  simp only [SetLike.mem_coe, AddSubgroup.mem_comap]
  have :
    (K0toK0'Free R) (FreeAbelianGroup.of p₂ - FreeAbelianGroup.of p₁ - FreeAbelianGroup.of p₃) =
      FreeAbelianGroup.of p₂.val - FreeAbelianGroup.of p₁.val - FreeAbelianGroup.of p₃.val := by
    simp only [K0toK0'Free, map_sub, FreeAbelianGroup.map_of_apply]
  rw [this, K0'Rel]
  exact AddSubgroup.subset_closure ⟨p₁.val, p₂.val, p₃.val, hse, rfl⟩

/-- **The canonical homomorphism `ι : K0(R) → K0'(R)`** of Definition 3. -/
@[sga "6 0 3.1" "(X), special case",
  sga "6 X 1.3.3" "(X), special case",
  sga "6 X 7.6" "(X), special case"]
noncomputable def K0toK0' : K0OfProjGen R →+ K0PrimeOfFinPres R :=
  QuotientAddGroup.map (K0RelOfProjGen R) (K0'Rel R) (K0toK0'Free R) (K0RelOfProjGen_le_comap R)

