section Rank

/-- The integer rank of the module attached to a generator, over a PID `R`. -/
noncomputable def K0'Gen.rankZ (R : Type*) [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]
    (p : K0'Gen R) : ℤ :=
  ((Module.rank R (K0'Gen.module R p)).toNat : ℤ)

universe u

/-- Rank is additive on short exact sequences of finite modules over a PID
    (all modules in the same universe). -/
@[sga "6 I 6.0" "(ii), special case"]
theorem rank_shortExact {R : Type u} [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]
    {M₁ M₂ M₃ : Type u} [AddCommGroup M₁] [Module R M₁] [AddCommGroup M₂] [Module R M₂]
    [AddCommGroup M₃] [Module R M₃] (f : M₁ →ₗ[R] M₂) (g : M₂ →ₗ[R] M₃) (hf : Function.Injective f)
    (hg : Function.Surjective g) (hfg : LinearMap.range f = LinearMap.ker g) :
    Module.rank R M₂ = Module.rank R M₁ + Module.rank R M₃ := by
  -- M₃ ≃ M₂ / ker g
  have e3 : (M₂ ⧸ LinearMap.ker g) ≃ₗ[R] M₃ := g.quotKerEquivOfSurjective hg
  -- M₁ ≃ range f = ker g
  have e1 : M₁ ≃ₗ[R] (LinearMap.range f) := LinearEquiv.ofInjective f hf
  have hq := Submodule.rank_quotient_add_rank (LinearMap.ker g)
  rw [e3.rank_eq] at hq
  have hr1 : Module.rank R M₁ = Module.rank R (LinearMap.ker g) := by rw [e1.rank_eq, ← hfg]
  rw [hr1, add_comm]
  exact hq.symm

section RankZ

variable {R : Type u} [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]

omit [IsPrincipalIdealRing R] in
/-- Each generator's module has finite rank. -/
theorem K0'Gen.rank_lt_aleph0 (p : K0'Gen R) :
    Module.rank R (K0'Gen.module R p) < Cardinal.aleph0 :=
  Module.rank_lt_aleph0 R _

/-- Integer rank is additive on short exact sequences of generators. -/
@[sga "6 I 6.0" "(ii), special case"]
theorem K0'Gen.rankZ_shortExact {p₁ p₂ p₃ : K0'Gen R} (h : K0'Gen.ShortExact R p₁ p₂ p₃) :
    K0'Gen.rankZ R p₂ = K0'Gen.rankZ R p₁ + K0'Gen.rankZ R p₃ := by
  obtain ⟨f, g, hf, hg, hfg⟩ := h
  have hrank := rank_shortExact f g hf hg hfg
  unfold K0'Gen.rankZ
  have h1 := K0'Gen.rank_lt_aleph0 (R := R) p₁
  have h3 := K0'Gen.rank_lt_aleph0 (R := R) p₃
  rw [hrank, Cardinal.toNat_add h1 h3]
  push_cast
  ring

end RankZ

section Classes

variable {R : Type u} [CommRing R]

/-- The zero generator `⟨0, ⊥⟩`; its module is the trivial module. -/
def K0'Gen.zero (R : Type u) [CommRing R] : K0'Gen R :=
  ⟨0, ⊥⟩

/-- The module of the zero generator `⟨0, ⊥⟩` is trivial. -/
instance : Subsingleton (K0'Gen.module R (K0'Gen.zero R)) := by
  unfold K0'Gen.module K0'Gen.zero
  have : Subsingleton (Fin 0 → R) := by
    constructor
    intro a b
    funext i
    exact absurd i.isLt (by simp)
  infer_instance

/-- `K0'.mk` is additive across a short exact sequence:
    `[p₂] = [p₁] + [p₃]`. -/
theorem K0PrimeOfFinPres.mk_shortExact {p₁ p₂ p₃ : K0'Gen R} (h : K0'Gen.ShortExact R p₁ p₂ p₃) :
    K0PrimeOfFinPres.mk R p₂ = K0PrimeOfFinPres.mk R p₁ + K0PrimeOfFinPres.mk R p₃ := by
  have hmem :
    (FreeAbelianGroup.of p₂ - FreeAbelianGroup.of p₁ - FreeAbelianGroup.of p₃) ∈ K0'Rel R :=
    AddSubgroup.subset_closure ⟨p₁, p₂, p₃, h, rfl⟩
  have :
    (QuotientAddGroup.mk' (K0'Rel R))
        (FreeAbelianGroup.of p₂ - FreeAbelianGroup.of p₁ - FreeAbelianGroup.of p₃) =
      0 := by
    rw [QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff]
    exact hmem
  simp only [map_sub] at this
  have h2 : K0PrimeOfFinPres.mk R p₂ - K0PrimeOfFinPres.mk R p₁ - K0PrimeOfFinPres.mk R p₃ = 0 :=
    this
  rwa [sub_sub, sub_eq_zero] at h2

/-- Generators presenting the terms of a short exact sequence of modules form a short exact
    sequence of generators. -/
private theorem K0'Gen.shortExact_of_equivs {A B C : Type*} [AddCommGroup A] [Module R A]
    [AddCommGroup B] [Module R B] [AddCommGroup C] [Module R C] {pA pB pC : K0'Gen R}
    (eA : K0'Gen.module R pA ≃ₗ[R] A) (eB : K0'Gen.module R pB ≃ₗ[R] B)
    (eC : K0'Gen.module R pC ≃ₗ[R] C) (f : A →ₗ[R] B) (g : B →ₗ[R] C) (hf : Function.Injective f)
    (hg : Function.Surjective g) (hfg : LinearMap.range f = LinearMap.ker g) :
    K0'Gen.ShortExact R pA pB pC := by
  refine
    ⟨eB.symm.toLinearMap ∘ₗ f ∘ₗ eA.toLinearMap, eC.symm.toLinearMap ∘ₗ g ∘ₗ eB.toLinearMap, ?_,
      ?_, ?_⟩
  · intro a b hab
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe] at hab
    exact eA.injective (hf (eB.symm.injective hab))
  · intro c
    obtain ⟨b, hb⟩ := hg (eC c)
    refine ⟨eB.symm b, ?_⟩
    simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply, hb,
      LinearEquiv.symm_apply_apply]
  · ext x
    simp only [LinearMap.mem_range, LinearMap.mem_ker, LinearMap.comp_apply, LinearEquiv.coe_coe]
    constructor
    · rintro ⟨a, rfl⟩
      simp only [LinearEquiv.apply_symm_apply]
      have hmem : f (eA a) ∈ LinearMap.range f := ⟨_, rfl⟩
      rw [hfg, LinearMap.mem_ker] at hmem
      rw [hmem, map_zero]
    · intro hx
      have hgx : eB x ∈ LinearMap.ker g := by
        rw [LinearMap.mem_ker]
        exact eC.symm.injective (by simpa using hx)
      rw [← hfg] at hgx
      obtain ⟨a, ha⟩ := hgx
      refine ⟨eA.symm a, ?_⟩
      simp only [LinearEquiv.apply_symm_apply, ha, LinearEquiv.symm_apply_apply]

/-- An isomorphism of generator modules with a trivial third module is a short exact sequence. -/
private theorem K0'Gen.shortExact_of_equiv {p₁ p₂ p₃ : K0'Gen R}
    [Subsingleton (K0'Gen.module R p₃)] (e : K0'Gen.module R p₁ ≃ₗ[R] K0'Gen.module R p₂) :
    K0'Gen.ShortExact R p₁ p₂ p₃ :=
  K0'Gen.shortExact_of_equivs (LinearEquiv.refl R _) (LinearEquiv.refl R _) (LinearEquiv.refl R _)
    e.toLinearMap 0 e.injective (fun _ => ⟨0, Subsingleton.elim _ _⟩)
    (by simp [LinearMap.ker_zero, LinearMap.range_eq_top.mpr e.surjective])

/-- The class of the zero generator is zero. -/
theorem K0PrimeOfFinPres.mk_zero : K0PrimeOfFinPres.mk R (K0'Gen.zero R) = 0 := by
  have h2 : K0PrimeOfFinPres.mk R (K0'Gen.zero R) = _ + _ := K0PrimeOfFinPres.mk_shortExact
    (K0'Gen.shortExact_of_equiv (p₃ := K0'Gen.zero R) (LinearEquiv.refl R _))
  have h4 :
    K0PrimeOfFinPres.mk R (K0'Gen.zero R) -
        (K0PrimeOfFinPres.mk R (K0'Gen.zero R) + K0PrimeOfFinPres.mk R (K0'Gen.zero R)) =
      0 :=
    sub_eq_zero.mpr h2
  simpa using h4

/-- Isomorphic generators have the same class: if `module p₁ ≅ module p₂`, then
    `[p₁] = [p₂]`. -/
theorem K0PrimeOfFinPres.mk_iso {p₁ p₂ : K0'Gen R}
    (e : K0'Gen.module R p₁ ≃ₗ[R] K0'Gen.module R p₂) :
    K0PrimeOfFinPres.mk R p₁ = K0PrimeOfFinPres.mk R p₂ := by
  have h2 := K0PrimeOfFinPres.mk_shortExact (K0'Gen.shortExact_of_equiv (p₃ := K0'Gen.zero R) e)
  rw [K0PrimeOfFinPres.mk_zero, add_zero] at h2
  exact h2.symm

end Classes

section RankHom

variable (R : Type u) [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]

/-- The rank map on the free abelian group of generators. -/
noncomputable def rankFree : FreeAbelianGroup (K0'Gen R) →+ ℤ :=
  FreeAbelianGroup.lift (fun p => K0'Gen.rankZ R p)

/-- The rank map sends a generator to the rank of its module. -/
@[simp]
theorem rankFree_of (p : K0'Gen R) : rankFree R (FreeAbelianGroup.of p) = K0'Gen.rankZ R p := by
  simp [rankFree]

/-- The rank relations map to zero. -/
theorem K0'Rel_le_ker_rankFree : K0'Rel R ≤ (rankFree R).ker := by
  rw [K0'Rel, AddSubgroup.closure_le]
  rintro x ⟨p₁, p₂, p₃, hse, rfl⟩
  simp only [SetLike.mem_coe, AddMonoidHom.mem_ker, map_sub, rankFree_of]
  rw [K0'Gen.rankZ_shortExact hse]
  ring

/-- The rank homomorphism `K0'(R) → ℤ`. -/
noncomputable def rankHom : K0PrimeOfFinPres R →+ ℤ :=
  QuotientAddGroup.lift (K0'Rel R) (rankFree R)
    (by
      intro x hx
      have := K0'Rel_le_ker_rankFree R hx
      simpa [AddMonoidHom.mem_ker] using this)

/-- The rank homomorphism sends the class `[R^n / K]` to the rank of `R^n / K`. -/
@[simp]
theorem rankHom_mk (p : K0'Gen R) : rankHom R (K0PrimeOfFinPres.mk R p) = K0'Gen.rankZ R p := by
  rw [rankHom, K0PrimeOfFinPres.mk]
  exact rankFree_of R p

end RankHom

section Presentation

variable {R : Type u} [CommRing R]

/-- Every finite module over `R` admits a presentation as `R^n / K`, i.e. is
    isomorphic to the module of some generator. -/
theorem exists_generator_iso (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M] :
    ∃ p : K0'Gen R, Nonempty (K0'Gen.module R p ≃ₗ[R] M) := by
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
  -- f : (Fin n → R) →ₗ[R] M surjective
  refine ⟨⟨n, LinearMap.ker f⟩, ⟨?_⟩⟩
  exact f.quotKerEquivOfSurjective hf

end Presentation

end Rank

/-! ##############################################################################
    ## DECOMPOSITION SKETCH for the three main statements.
    ##
    ## The whole proof rests on one substantive structural fact (D1): in `K0'(R)`
    ## over a PID, the class of every generator is `(rankZ p) • [R]`.  Granting
    ## D1, the three statements are routine assembly via the rank homomorphism.
    ############################################################################## -/

/-- If a quotient of a free abelian group has every generator class equal to its `φ`-value times
    a fixed class `c`, then so does every element. -/
private theorem eq_hom_smul_of_gens {X : Type*} {H : AddSubgroup (FreeAbelianGroup X)}
    (φ : FreeAbelianGroup X ⧸ H →+ ℤ) (c : FreeAbelianGroup X ⧸ H)
    (h : ∀ p, QuotientAddGroup.mk' H (FreeAbelianGroup.of p) =
      φ (QuotientAddGroup.mk' H (FreeAbelianGroup.of p)) • c) (y : FreeAbelianGroup X ⧸ H) :
    y = φ y • c := by
  obtain ⟨z, rfl⟩ := QuotientAddGroup.mk'_surjective H y
  induction z using FreeAbelianGroup.induction_on with
  | zero => simp
  | of p => exact h p
  | neg p ih =>
    rw [map_neg, map_neg, neg_smul]
    exact congrArg Neg.neg ih
  | add x y ihx ihy => rw [map_add, map_add, add_smul, ← ihx, ← ihy]

/-- A homomorphism to `ℤ` sending `c` to `1` is bijective if every element is a multiple of `c`
    by its value. -/
private theorem bijective_of_eq_smul {G : Type*} [AddCommGroup G] (φ : G →+ ℤ) (c : G)
    (h1 : φ c = 1) (h : ∀ x, x = φ x • c) : Function.Bijective φ :=
  ⟨fun x y hxy => by rw [h x, h y, hxy],
    fun n => ⟨n • c, by rw [map_zsmul, h1, smul_eq_mul, mul_one]⟩⟩

/-- The splitting `R^(m+1) ≃ R × R^m` of a free module. -/
private def piFinSuccEquivFree (R : Type*) [CommRing R] (m : ℕ) :
    (Fin (m + 1) → R) ≃ₗ[R] R × (Fin m → R) where
  toFun f := (f 0, fun i => f i.succ)
  map_add' f g := rfl
  map_smul' c f := rfl
  invFun p := Fin.cons p.fst p.snd
  left_inv f := by
    funext i; refine Fin.cases ?_ ?_ i <;> simp
  right_inv p := by refine Prod.ext ?_ ?_ <;> simp

/-- The module of the rank-1 free generator is `R`. -/
private def K0'Gen.free1Equiv (R : Type*) [CommRing R] : K0'Gen.module R (K0'Gen.free1 R) ≃ₗ[R] R :=
  (Submodule.quotEquivOfEqBot _ rfl).trans (LinearEquiv.funUnique (Fin 1) R R)

section Sketch

universe u
variable {R : Type u} [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]
open scoped DirectSum

/-- The abstract class in `K0'` of an arbitrary finite `R`-module, defined as the
    class of a chosen generator presenting it. -/
noncomputable def K0PrimeOfFinPres.mkM (R : Type u) [CommRing R] [IsDomain R]
    [IsPrincipalIdealRing R] (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M] :
    K0PrimeOfFinPres R :=
  K0PrimeOfFinPres.mk R (exists_generator_iso (R := R) M).choose

/-- The abstract integer rank of a finite module. -/
noncomputable def rankZM (R : Type u) [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]
    (M : Type u) [AddCommGroup M] [Module R M] : ℤ :=
  ((Module.rank R M).toNat : ℤ)

/-- A presenting isomorphism identifies the abstract class with a generator class. -/
theorem K0PrimeOfFinPres.mkM_eq_mk_of_iso (M : Type u) [AddCommGroup M] [Module R M]
    [Module.Finite R M] {p : K0'Gen R} (e : K0'Gen.module R p ≃ₗ[R] M) :
    K0PrimeOfFinPres.mkM R M = K0PrimeOfFinPres.mk R p := by
  unfold K0PrimeOfFinPres.mkM
  have e2 := (exists_generator_iso (R := R) M).choose_spec.some
  exact K0PrimeOfFinPres.mk_iso (e2.trans e.symm)

/-- Isomorphic finite modules have the same abstract class. -/
theorem K0PrimeOfFinPres.mkM_iso {M N : Type u} [AddCommGroup M] [Module R M] [Module.Finite R M]
    [AddCommGroup N] [Module R N] [Module.Finite R N] (e : M ≃ₗ[R] N) :
    K0PrimeOfFinPres.mkM R M = K0PrimeOfFinPres.mkM R N := by
  obtain ⟨p, ⟨ep⟩⟩ := exists_generator_iso (R := R) M
  rw [K0PrimeOfFinPres.mkM_eq_mk_of_iso M ep, K0PrimeOfFinPres.mkM_eq_mk_of_iso N (ep.trans e)]

/-- The abstract rank agrees with `K0'Gen.rankZ` through a presenting isomorphism. -/
theorem rankZM_eq_of_iso (M : Type u) [AddCommGroup M] [Module R M] {p : K0'Gen R}
    (e : K0'Gen.module R p ≃ₗ[R] M) : rankZM R M = K0'Gen.rankZ R p := by
  unfold rankZM K0'Gen.rankZ
  rw [e.rank_eq]

/-- The abstract rank is invariant under isomorphism. -/
theorem rankZM_iso {M N : Type u} [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (e : M ≃ₗ[R] N) : rankZM R M = rankZM R N := by
  unfold rankZM
  rw [e.rank_eq]

/-- Abstract additivity of the class across a short exact sequence of finite modules. -/
theorem K0PrimeOfFinPres.mkM_shortExact {A B C : Type u} [AddCommGroup A] [Module R A]
    [Module.Finite R A] [AddCommGroup B] [Module R B] [Module.Finite R B] [AddCommGroup C]
    [Module R C] [Module.Finite R C] (f : A →ₗ[R] B) (g : B →ₗ[R] C) (hf : Function.Injective f)
    (hg : Function.Surjective g) (hfg : LinearMap.range f = LinearMap.ker g) :
    K0PrimeOfFinPres.mkM R B = K0PrimeOfFinPres.mkM R A + K0PrimeOfFinPres.mkM R C := by
  obtain ⟨pA, ⟨eA⟩⟩ := exists_generator_iso (R := R) A
  obtain ⟨pB, ⟨eB⟩⟩ := exists_generator_iso (R := R) B
  obtain ⟨pC, ⟨eC⟩⟩ := exists_generator_iso (R := R) C
  rw [K0PrimeOfFinPres.mkM_eq_mk_of_iso A eA, K0PrimeOfFinPres.mkM_eq_mk_of_iso B eB,
    K0PrimeOfFinPres.mkM_eq_mk_of_iso C eC,
    K0PrimeOfFinPres.mk_shortExact (K0'Gen.shortExact_of_equivs eA eB eC f g hf hg hfg)]

/-- Abstract additivity of the rank across a short exact sequence of finite modules. -/
@[sga "6 I 6.0" "(ii), special case"]
theorem rankZM_shortExact {A B C : Type u} [AddCommGroup A] [Module R A] [Module.Finite R A]
    [AddCommGroup B] [Module R B] [Module.Finite R B] [AddCommGroup C] [Module R C]
    [Module.Finite R C] (f : A →ₗ[R] B) (g : B →ₗ[R] C) (hf : Function.Injective f)
    (hg : Function.Surjective g) (hfg : LinearMap.range f = LinearMap.ker g) :
    rankZM R B = rankZM R A + rankZM R C := by
  unfold rankZM
  rw [rank_shortExact f g hf hg hfg,
    Cardinal.toNat_add (Module.rank_lt_aleph0 R A) (Module.rank_lt_aleph0 R C)]
  push_cast
  ring

/-- The class is additive over binary products. -/
theorem K0PrimeOfFinPres.mkM_prod (M N : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M]
    [AddCommGroup N] [Module R N] [Module.Finite R N] :
    K0PrimeOfFinPres.mkM R (M × N) = K0PrimeOfFinPres.mkM R M + K0PrimeOfFinPres.mkM R N := by
  refine
    K0PrimeOfFinPres.mkM_shortExact (LinearMap.inl R M N) (LinearMap.snd R M N)
      (fun a b h => by simpa using h) Prod.snd_surjective (LinearMap.range_inl R M N)

/-- The rank is additive over binary products. -/
@[ega "I 6.4.5" "(6.4.5.1), special case"]
theorem rankZM_prod (M N : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M]
    [AddCommGroup N] [Module R N] [Module.Finite R N] :
    rankZM R (M × N) = rankZM R M + rankZM R N := by
  refine
    rankZM_shortExact (LinearMap.inl R M N) (LinearMap.snd R M N) (fun a b h => by simpa using h)
      Prod.snd_surjective (LinearMap.range_inl R M N)

/-- A subsingleton (trivial) finite module has class `0`. -/
theorem K0PrimeOfFinPres.mkM_subsingleton (M : Type u) [AddCommGroup M] [Module R M]
    [Module.Finite R M] [Subsingleton M] : K0PrimeOfFinPres.mkM R M = 0 := by
  have e : K0'Gen.module R (K0'Gen.zero R) ≃ₗ[R] M :=
    { toFun := fun _ => 0
      map_add' := fun _ _ => Subsingleton.elim _ _
      map_smul' := fun _ _ => Subsingleton.elim _ _
      invFun := fun _ => 0
      left_inv := fun _ => Subsingleton.elim _ _
      right_inv := fun _ => Subsingleton.elim _ _ }
  rw [K0PrimeOfFinPres.mkM_eq_mk_of_iso M e, K0PrimeOfFinPres.mk_zero]

/-- The class of the free module `R^n` is `n • [R]`. -/
theorem K0PrimeOfFinPres.mkM_free (n : ℕ) :
    K0PrimeOfFinPres.mkM R (Fin n → R) = (n : ℤ) • (K0PrimeOfFinPres.mk R (K0'Gen.free1 R)) := by
  induction n with
  | zero =>
    rw [K0PrimeOfFinPres.mkM_subsingleton (Fin 0 → R)]
    simp
  | succ m
    ih =>
    rw [K0PrimeOfFinPres.mkM_iso (piFinSuccEquivFree R m), K0PrimeOfFinPres.mkM_prod, ih, ←
      K0PrimeOfFinPres.mkM_eq_mk_of_iso R (K0'Gen.free1Equiv R)]
    push_cast
    rw [add_smul, one_smul, add_comm]

/-- The rank of the free module `R^n` is `n`. -/
theorem rankZM_free (n : ℕ) : rankZM R (Fin n → R) = (n : ℤ) := by
  unfold rankZM
  rw [rank_fun']
  simp

/-- A nonzero-modulus cyclic quotient `R/(d)` has class `0`. -/
theorem K0PrimeOfFinPres.mkM_cyclic_zero (d : R) (hd : d ≠ 0) :
    K0PrimeOfFinPres.mkM R (R ⧸ R ∙ d) = 0 := by
  have hkey :
    K0PrimeOfFinPres.mkM R R = K0PrimeOfFinPres.mkM R R + K0PrimeOfFinPres.mkM R (R ⧸ R ∙ d) := by
    refine
      K0PrimeOfFinPres.mkM_shortExact (LinearMap.lsmul R R d) (Submodule.mkQ (R ∙ d)) ?_
        (Submodule.mkQ_surjective _) ?_
    · intro a b hab
      simp only [LinearMap.lsmul_apply, smul_eq_mul] at hab
      exact mul_left_cancel₀ hd hab
    · rw [Submodule.ker_mkQ]
      ext x
      simp only [LinearMap.mem_range, LinearMap.lsmul_apply, smul_eq_mul,
        Submodule.mem_span_singleton]
      constructor
      · rintro ⟨y, rfl⟩; exact ⟨y, by ring⟩
      · rintro ⟨a, rfl⟩; exact ⟨a, by ring⟩
  simpa using sub_eq_zero.mpr hkey.symm

/-- A nonzero-modulus cyclic quotient `R/(d)` has rank `0`. -/
theorem rankZM_cyclic_zero (d : R) (hd : d ≠ 0) : rankZM R (R ⧸ R ∙ d) = 0 := by
  have htor : Module.IsTorsion R (R ⧸ R ∙ d) := by
    intro x
    refine ⟨⟨d, ?_⟩, ?_⟩
    · simpa using hd
    · induction x using Submodule.Quotient.induction_on with
      | _ a =>
        rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
        rw [Submodule.mem_span_singleton]
        refine ⟨a, ?_⟩
        rw [Submonoid.smul_def, smul_eq_mul, smul_eq_mul]
        ring
  unfold rankZM
  rw [Module.rank_eq_zero_iff_isTorsion.mpr htor]
  simp

/-- The generic splitting `(∀ i : Fin (m+1), N i) ≃ N 0 × (∀ i : Fin m, N i.succ)`. -/
noncomputable def piFinSuccEquiv (m : ℕ) (N : Fin (m + 1) → Type u) [∀ i, AddCommGroup (N i)]
    [∀ i, Module R (N i)] : (Π i, N i) ≃ₗ[R] N 0 × (Π i : Fin m, N i.succ)
    where
  toFun f := (f 0, fun i => f i.succ)
  map_add' f g := rfl
  map_smul' c f := rfl
  invFun p := Fin.cons p.fst p.snd
  left_inv f := by
    funext i; refine Fin.cases ?_ ?_ i <;> simp
  right_inv p := by refine Prod.ext ?_ ?_ <;> simp

/-- A finite product of nonzero-modulus cyclic quotients has class `0`. -/
theorem K0PrimeOfFinPres.mkM_pi_cyclic_zero (m : ℕ) (d : Fin m → R) (hd : ∀ i, d i ≠ 0) :
    K0PrimeOfFinPres.mkM R (Π i : Fin m, R ⧸ R ∙ d i) = 0 := by
  induction m with
  | zero => exact K0PrimeOfFinPres.mkM_subsingleton _
  | succ k ih =>
    rw [K0PrimeOfFinPres.mkM_iso (piFinSuccEquiv k (fun i => R ⧸ R ∙ d i)),
      K0PrimeOfFinPres.mkM_prod, K0PrimeOfFinPres.mkM_cyclic_zero (d 0) (hd 0),
      ih (fun i => d i.succ) (fun i => hd i.succ), add_zero]

/-- A finite product of nonzero-modulus cyclic quotients has rank `0`. -/
theorem rankZM_pi_cyclic_zero (m : ℕ) (d : Fin m → R) (hd : ∀ i, d i ≠ 0) :
    rankZM R (Π i : Fin m, R ⧸ R ∙ d i) = 0 := by
  induction m with
  | zero =>
    unfold rankZM
    rw [Module.rank_eq_zero_iff_isTorsion.mpr ?_]
    · simp
    · intro x; exact ⟨1, Subsingleton.elim _ _⟩
  | succ k ih =>
    rw [rankZM_iso (piFinSuccEquiv k (fun i => R ⧸ R ∙ d i)), rankZM_prod,
      rankZM_cyclic_zero (d 0) (hd 0), ih (fun i => d i.succ) (fun i => hd i.succ), add_zero]

/-- **D1 (the structural kernel).**  In `K0'(R)` over a PID, every generator class
    is `(rankZ p) • [R]`, where `[R] = K0PrimeOfFinPres.mk R (K0'Gen.free1 R)` is the
    class of the rank-1 free module. -/
@[sga "6 IX 1.7" "partial"]
theorem K0PrimeOfFinPres.mk_eq_rankZ_smul_free1 (p : K0'Gen R) :
    K0PrimeOfFinPres.mk R p = (K0'Gen.rankZ R p) • (K0PrimeOfFinPres.mk R (K0'Gen.free1 R)) := by
  obtain ⟨n, ι, hιfin, pr, hirr, e, ⟨equ⟩⟩ :=
    Module.equiv_free_prod_directSum R (K0'Gen.module R p)
  classical
  let m := Fintype.card ι
  let eFin : Fin m ≃ ι := (Fintype.equivFin ι).symm
  let dfun : Fin m → R := fun j => pr (eFin j) ^ e (eFin j)
  have hd : ∀ j, dfun j ≠ 0 := fun j => pow_ne_zero _ (hirr (eFin j)).ne_zero
  have efree : (Fin n →₀ R) ≃ₗ[R] (Fin n → R) := Finsupp.linearEquivFunOnFinite R R (Fin n)
  have eds : (⨁ i : ι, R ⧸ R ∙ pr i ^ e i) ≃ₗ[R] (Π j : Fin m, R ⧸ R ∙ dfun j) :=
    (DirectSum.linearEquivFunOnFintype R ι (fun i => R ⧸ R ∙ pr i ^ e i)).trans
      (LinearEquiv.piCongrLeft R (fun i => R ⧸ R ∙ pr i ^ e i) eFin).symm
  have eM : K0'Gen.module R p ≃ₗ[R] (Fin n → R) × (Π j : Fin m, R ⧸ R ∙ dfun j) :=
    equ.trans (LinearEquiv.prodCongr efree eds)
  have hmk : K0PrimeOfFinPres.mk R p = K0PrimeOfFinPres.mkM R (K0'Gen.module R p) :=
    (K0PrimeOfFinPres.mkM_eq_mk_of_iso (K0'Gen.module R p) (LinearEquiv.refl R _)).symm
  rw [hmk, K0PrimeOfFinPres.mkM_iso eM, K0PrimeOfFinPres.mkM_prod, K0PrimeOfFinPres.mkM_free,
    K0PrimeOfFinPres.mkM_pi_cyclic_zero m dfun hd, add_zero]
  have hrankZ : K0'Gen.rankZ R p = (n : ℤ) := by
    rw [show K0'Gen.rankZ R p = rankZM R (K0'Gen.module R p) from rfl, rankZM_iso eM, rankZM_prod,
      rankZM_free, rankZM_pi_cyclic_zero m dfun hd, add_zero]
  rw [hrankZ]

/-- **D2.**  The rank-1 free generator has integer rank `1`.

    Argument: `module (free1) = (Fin 1 → R) ⧸ ⊥ ≅ (Fin 1 → R)`, a free module of
    rank `1`, so `Module.rank R = 1` and `rankZ = (1 : Cardinal).toNat = 1`.
    Tactic hint: `Submodule.quotEquivOfEqBot`, `LinearEquiv.rank_eq`,
    `rank_fun'` / `Module.rank_fin_fun` (rank of `Fin 1 → R` is `1`),
    `Cardinal.toNat_one`. -/
theorem K0'Gen.rankZ_free1 : K0'Gen.rankZ R (K0'Gen.free1 R) = 1 := by
  have e : (K0'Gen.module R (K0'Gen.free1 R)) ≃ₗ[R] (Fin 1 → R) := Submodule.quotEquivOfEqBot _ rfl
  unfold K0'Gen.rankZ
  rw [e.rank_eq, rank_fun']
  simp

/-- **D3.**  `rankHom` sends the free class to `1`. -/
@[sga "6 IX 1.7" "partial"]
theorem rankHom_free1 : rankHom R (K0PrimeOfFinPres.mk R (K0'Gen.free1 R)) = 1 := by
  rw [rankHom_mk, K0'Gen.rankZ_free1]

omit [IsDomain R] [IsPrincipalIdealRing R] in
/-- **D4 (surjectivity of `K0'.mk` onto `K0'`).**  `K0'(R)` is generated by the
    classes `K0PrimeOfFinPres.mk R p`; in fact every element is `K0PrimeOfFinPres.mk`
    of some generator's class composed via the group structure.  We only need: the
    subgroup generated by `{K0PrimeOfFinPres.mk R p}` is the whole group, which holds
    because `K0PrimeOfFinPres` is the quotient of `FreeAbelianGroup (K0'Gen R)` and
    `K0PrimeOfFinPres.mk` is the composite of `of` with the quotient map (a
    surjection). -/
theorem K0PrimeOfFinPres.mk_generates (x : K0PrimeOfFinPres R) :
    ∃ (z : FreeAbelianGroup (K0'Gen R)), QuotientAddGroup.mk' (K0'Rel R) z = x :=
  QuotientAddGroup.mk'_surjective (K0'Rel R) x

-- needed: the `rw [hrz]`-style steps in `K0PrimeOfFinPres.eq_rankHom_smul_free1` match only
-- when defeq unfolds `rankHom`/`K0'Gen.rankZ` past the default transparency
set_option backward.isDefEq.respectTransparency false in
/-- **D5 (every element of `K0'` is a `ℤ`-multiple of `[R]`).**  Combining D1 with
    the fact that the quotient map is additive and `of` generators span the free
    group: every `x : K0PrimeOfFinPres R` equals `(rankHom R x) • [R]`.  This is the
    key to injectivity of `rankHom`.

    Argument: `x = mk' z` for some `z : FreeAbelianGroup (K0'Gen R)` (D4).  Induct
    on `z` using `FreeAbelianGroup` induction (`FreeAbelianGroup.induction_on`):
    on a generator `of p`, `mk' (of p) = K0PrimeOfFinPres.mk R p = rankZ p • [R]` by
    D1, and `rankHom (mk' (of p)) = rankZ p`; additivity and negation propagate the
    linear relation.  Hence `x = (rankHom R x) • [R]`. -/
@[sga "6 IX 1.7" "partial"]
theorem K0PrimeOfFinPres.eq_rankHom_smul_free1 (x : K0PrimeOfFinPres R) :
    x = (rankHom R x) • (K0PrimeOfFinPres.mk R (K0'Gen.free1 R)) := by
  refine eq_hom_smul_of_gens (rankHom R) _ (fun p => ?_) x
  have h := K0PrimeOfFinPres.mk_eq_rankZ_smul_free1 p
  rw [← rankHom_mk] at h
  exact h

/-- **D6 (`rankHom` is bijective).**  Surjective: `rankHom (n • [R]) = n` since
    `rankHom [R] = 1` (D3) and `rankHom` is additive.  Injective: if
    `rankHom x = 0` then `x = (rankHom x) • [R] = 0` by D5. -/
@[sga "6 IX 1.7"]
theorem rankHom_bijective : Function.Bijective (rankHom R) :=
  bijective_of_eq_smul _ _ rankHom_free1 K0PrimeOfFinPres.eq_rankHom_smul_free1

/-- **D7 (`K0'(R) ≃+ ℤ` via `rankHom`).** -/
@[sga "6 IX 1.7"]
noncomputable def K0PrimeOfFinPres.rankEquiv : K0PrimeOfFinPres R ≃+ ℤ :=
  AddEquiv.ofBijective (rankHom R) (rankHom_bijective)

end Sketch

/-! ##############################################################################
    ## K0 side: build the analogous rank homomorphism on `K0`.
    ##
    ## Route (b): define `rankHomK0 := rankHom ∘ K0toK0'` and show
    ## it is bijective.  Over a PID every finite projective module is finite free,
    ## so `K0 → K0'` is itself an isomorphism, and `rankHomK0` inherits the rank
    ## structure.
    ############################################################################## -/

section SketchK0

universe u
variable (R : Type u) [CommRing R] [IsDomain R] [IsPrincipalIdealRing R]

/-- The composite rank homomorphism on `K0`. -/
@[sga "6 IX 1.7", sga "6 V 3.9.1" "partial"]
noncomputable def rankHomK0 : K0OfProjGen R →+ ℤ :=
  (rankHom R).comp (K0toK0' R)

omit [IsDomain R] [IsPrincipalIdealRing R] in
/-- `K0toK0'` sends the free generator class to the free generator class.

    Argument: both sides unfold to the quotient map applied to `of` of the same
    generator data; `K0toK0'` is `QuotientAddGroup.map` of `K0toK0'Free`, which is
    `FreeAbelianGroup.map (·.1)`, and `(K0Gen.free1 R).1 = K0'Gen.free1 R` by
    definition.  Tactic hint: unfold `K0toK0'`, `K0OfProjGen.mk`, `K0PrimeOfFinPres.mk`,
    `QuotientAddGroup.map_mk'`, `K0toK0'Free`, `FreeAbelianGroup.map_of_apply`. -/
theorem K0toK0'_free1 :
    K0toK0' R (K0OfProjGen.mk R (K0Gen.free1 R)) = K0PrimeOfFinPres.mk R (K0'Gen.free1 R) := rfl

/-- `rankHomK0` sends the free class to `1`. -/
@[sga "6 IX 1.7" "partial"]
theorem rankHomK0_free1 : rankHomK0 R (K0OfProjGen.mk R (K0Gen.free1 R)) = 1 := by
  rw [rankHomK0, AddMonoidHom.comp_apply, K0toK0'_free1, rankHom_free1]

/-! ### `K0`-side mirror of the `K0'` class layer (restricted to projective generators).

    These helpers mirror `K0PrimeOfFinPres.mk_shortExact`, `K0PrimeOfFinPres.mk_zero`,
    `K0PrimeOfFinPres.mk_iso`, and the `K0PrimeOfFinPres.mkM` layer, but on the `K0`
    side where every generator is projective. -/

section K0Classes

variable {R : Type u} [CommRing R]

/-- `K0.mk` is additive across a short exact sequence of projective generators. -/
theorem K0OfProjGen.mk_shortExact {p₁ p₂ p₃ : K0Gen R} (h : K0'Gen.ShortExact R p₁.1 p₂.1 p₃.1) :
    K0OfProjGen.mk R p₂ = K0OfProjGen.mk R p₁ + K0OfProjGen.mk R p₃ := by
  have hmem :
    (FreeAbelianGroup.of p₂ - FreeAbelianGroup.of p₁ - FreeAbelianGroup.of p₃) ∈
      K0RelOfProjGen R :=
    AddSubgroup.subset_closure ⟨p₁, p₂, p₃, h, rfl⟩
  have :
    (QuotientAddGroup.mk' (K0RelOfProjGen R))
        (FreeAbelianGroup.of p₂ - FreeAbelianGroup.of p₁ - FreeAbelianGroup.of p₃) =
      0 := by
    rw [QuotientAddGroup.mk'_apply, QuotientAddGroup.eq_zero_iff]
    exact hmem
  simp only [map_sub] at this
  have h2 : K0OfProjGen.mk R p₂ - K0OfProjGen.mk R p₁ - K0OfProjGen.mk R p₃ = 0 := this
  rwa [sub_sub, sub_eq_zero] at h2

/-- The projective zero generator `⟨⟨0, ⊥⟩, _⟩`. -/
def K0Gen.zero (R : Type u) [CommRing R] : K0Gen R :=
  ⟨⟨0, ⊥⟩, by
    have e : (K0'Gen.module R (⟨0, ⊥⟩ : K0'Gen R)) ≃ₗ[R] (Fin 0 → R) :=
      Submodule.quotEquivOfEqBot _ rfl
    exact Module.Projective.of_equiv e.symm⟩

/-- The module of the zero projective generator is trivial. -/
instance : Subsingleton (K0'Gen.module R (K0Gen.zero R).1) := by
  change Subsingleton ((Fin 0 → R) ⧸ (⊥ : Submodule R (Fin 0 → R)))
  have : Subsingleton (Fin 0 → R) := by
    constructor
    intro a b
    funext i
    exact absurd i.isLt (by simp)
  infer_instance

/-- The class of the zero generator is zero. -/
theorem K0OfProjGen.mk_zero : K0OfProjGen.mk R (K0Gen.zero R) = 0 := by
  have h2 : K0OfProjGen.mk R (K0Gen.zero R) = _ + _ := K0OfProjGen.mk_shortExact
    (K0'Gen.shortExact_of_equiv (p₃ := (K0Gen.zero R).1) (LinearEquiv.refl R _))
  have h4 :
    K0OfProjGen.mk R (K0Gen.zero R) -
        (K0OfProjGen.mk R (K0Gen.zero R) + K0OfProjGen.mk R (K0Gen.zero R)) =
      0 :=
    sub_eq_zero.mpr h2
  simpa using h4

/-- Isomorphic projective generators have the same class. -/
theorem K0OfProjGen.mk_iso {p₁ p₂ : K0Gen R}
    (e : K0'Gen.module R p₁.1 ≃ₗ[R] K0'Gen.module R p₂.1) :
    K0OfProjGen.mk R p₁ = K0OfProjGen.mk R p₂ := by
  have h2 := K0OfProjGen.mk_shortExact (K0'Gen.shortExact_of_equiv (p₃ := (K0Gen.zero R).1) e)
  rw [K0OfProjGen.mk_zero, add_zero] at h2
  exact h2.symm

/-- A finite projective module presents as a projective generator's module. -/
theorem K0OfProjGen.exists_gen_of_iso (M : Type u) [AddCommGroup M] [Module R M]
    [Module.Finite R M] [Module.Projective R M] :
    ∃ p : K0Gen R, Nonempty (K0'Gen.module R p.1 ≃ₗ[R] M) := by
  obtain ⟨n, f, hf⟩ := Module.Finite.exists_fin' R M
  refine ⟨⟨⟨n, LinearMap.ker f⟩, ?_⟩, ⟨?_⟩⟩
  · exact Module.Projective.of_equiv (f.quotKerEquivOfSurjective hf).symm
  · exact f.quotKerEquivOfSurjective hf

/-- The abstract class in `K0` of a finite projective module. -/
noncomputable def K0OfProjGen.mkM (R : Type u) [CommRing R] (M : Type u) [AddCommGroup M]
    [Module R M] [Module.Finite R M] [Module.Projective R M] : K0OfProjGen R :=
  K0OfProjGen.mk R (K0OfProjGen.exists_gen_of_iso (R := R) M).choose

/-- A presenting isomorphism identifies the abstract class with a generator class. -/
theorem K0OfProjGen.mkM_eq_mk_of_iso (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M]
    [Module.Projective R M] {p : K0Gen R} (e : K0'Gen.module R p.1 ≃ₗ[R] M) :
    K0OfProjGen.mkM R M = K0OfProjGen.mk R p := by
  unfold K0OfProjGen.mkM
  have e2 := (K0OfProjGen.exists_gen_of_iso (R := R) M).choose_spec.some
  exact K0OfProjGen.mk_iso (e2.trans e.symm)

/-- Isomorphic finite projective modules have the same abstract class. -/
theorem K0OfProjGen.mkM_iso {M N : Type u} [AddCommGroup M] [Module R M] [Module.Finite R M]
    [Module.Projective R M] [AddCommGroup N] [Module R N] [Module.Finite R N]
    [Module.Projective R N] (e : M ≃ₗ[R] N) : K0OfProjGen.mkM R M = K0OfProjGen.mkM R N := by
  obtain ⟨p, ⟨ep⟩⟩ := K0OfProjGen.exists_gen_of_iso (R := R) M
  rw [K0OfProjGen.mkM_eq_mk_of_iso M ep, K0OfProjGen.mkM_eq_mk_of_iso N (ep.trans e)]

/-- Abstract additivity of the class across a short exact sequence of finite
    projective modules. -/
theorem K0OfProjGen.mkM_shortExact {A B C : Type u} [AddCommGroup A] [Module R A]
    [Module.Finite R A] [Module.Projective R A] [AddCommGroup B] [Module R B] [Module.Finite R B]
    [Module.Projective R B] [AddCommGroup C] [Module R C] [Module.Finite R C]
    [Module.Projective R C] (f : A →ₗ[R] B) (g : B →ₗ[R] C) (hf : Function.Injective f)
    (hg : Function.Surjective g) (hfg : LinearMap.range f = LinearMap.ker g) :
    K0OfProjGen.mkM R B = K0OfProjGen.mkM R A + K0OfProjGen.mkM R C := by
  obtain ⟨pA, ⟨eA⟩⟩ := K0OfProjGen.exists_gen_of_iso (R := R) A
  obtain ⟨pB, ⟨eB⟩⟩ := K0OfProjGen.exists_gen_of_iso (R := R) B
  obtain ⟨pC, ⟨eC⟩⟩ := K0OfProjGen.exists_gen_of_iso (R := R) C
  rw [K0OfProjGen.mkM_eq_mk_of_iso A eA, K0OfProjGen.mkM_eq_mk_of_iso B eB,
    K0OfProjGen.mkM_eq_mk_of_iso C eC,
    K0OfProjGen.mk_shortExact (K0'Gen.shortExact_of_equivs eA eB eC f g hf hg hfg)]

/-- The class is additive over binary products. -/
theorem K0OfProjGen.mkM_prod (M N : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M]
    [Module.Projective R M] [AddCommGroup N] [Module R N] [Module.Finite R N]
    [Module.Projective R N] :
    K0OfProjGen.mkM R (M × N) = K0OfProjGen.mkM R M + K0OfProjGen.mkM R N := by
  refine
    K0OfProjGen.mkM_shortExact (LinearMap.inl R M N) (LinearMap.snd R M N)
      (fun a b h => by simpa using h) Prod.snd_surjective (LinearMap.range_inl R M N)

/-- A subsingleton (trivial) finite projective module has class `0`. -/
theorem K0OfProjGen.mkM_subsingleton (M : Type u) [AddCommGroup M] [Module R M] [Module.Finite R M]
    [Module.Projective R M] [Subsingleton M] : K0OfProjGen.mkM R M = 0 := by
  have e : K0'Gen.module R (K0Gen.zero R).val ≃ₗ[R] M :=
    { toFun := fun _ => 0
      map_add' := fun _ _ => Subsingleton.elim _ _
      map_smul' := fun _ _ => Subsingleton.elim _ _
      invFun := fun _ => 0
      left_inv := fun _ => Subsingleton.elim _ _
      right_inv := fun _ => Subsingleton.elim _ _ }
  rw [K0OfProjGen.mkM_eq_mk_of_iso M e, K0OfProjGen.mk_zero]

/-- The class of the free module `R^n` is `n • [R]`. -/
theorem K0OfProjGen.mkM_free (n : ℕ) :
    K0OfProjGen.mkM R (Fin n → R) = (n : ℤ) • (K0OfProjGen.mk R (K0Gen.free1 R)) := by
  induction n with
  | zero =>
    rw [K0OfProjGen.mkM_subsingleton (Fin 0 → R)]
    simp
  | succ m
    ih =>
    rw [K0OfProjGen.mkM_iso (piFinSuccEquivFree R m), K0OfProjGen.mkM_prod, ih,
      ← K0OfProjGen.mkM_eq_mk_of_iso R (K0'Gen.free1Equiv R)]
    push_cast
    rw [add_smul, one_smul, add_comm]

/-- **The `K0`-side analogue of D1.**  Over a PID, every finite projective module is
    finite free, so the class of every projective generator is `(rankZ p.1) • [R]`. -/
theorem K0OfProjGen.mk_eq_rankZ_smul_free1 [IsDomain R] [IsPrincipalIdealRing R] (p : K0Gen R) :
    K0OfProjGen.mk R p = (K0'Gen.rankZ R p.1) • (K0OfProjGen.mk R (K0Gen.free1 R)) := by
  have hproj : Module.Projective R (K0'Gen.module R p.val) := p.property
  have hfree : Module.Free R (K0'Gen.module R p.val) := by
    rw [Module.free_iff_isTorsionFree]; infer_instance
  set n := Module.finrank R (K0'Gen.module R p.val) with hn
  have e : K0'Gen.module R p.val ≃ₗ[R] (Fin n → R) :=
    (Module.finBasis R (K0'Gen.module R p.val)).equivFun
  have hmk : K0OfProjGen.mk R p = K0OfProjGen.mkM R (K0'Gen.module R p.val) :=
    (K0OfProjGen.mkM_eq_mk_of_iso (K0'Gen.module R p.val) (LinearEquiv.refl R _)).symm
  rw [hmk, K0OfProjGen.mkM_iso e, K0OfProjGen.mkM_free]
  have hrz : K0'Gen.rankZ R p.val = (n : ℤ) := by
    unfold K0'Gen.rankZ
    have hr : (Module.rank R (K0'Gen.module R p.val)).toNat = n := rfl
    rw [hr]
  rw [hrz]

end K0Classes

-- needed: same as D5 above, for `K0OfProjGen.eq_rankHomK0_smul_free1` — its rewrites need
-- `rankHomK0`/`K0Gen.rankZ` unfolded past the default transparency
set_option backward.isDefEq.respectTransparency false in
/-- **D8 (`K0toK0'` is injective).**  Over a PID, every finite projective module is
    finite free.  A `K0`-generator `p` therefore has `module p ≅ R^(rankZ p)`, and
    the same structural collapse used for `K0'` shows every `K0`-class is a
    `ℤ`-multiple of `[R]`.  Since `K0toK0'` sends `[R]_{K0} ↦ [R]_{K0'}` (D7-K0)
    and `rankHom` separates multiples of `[R]_{K0'}`, the composite `rankHomK0` is
    injective; hence so is `K0toK0'`.

    Concretely we prove the analogue of D5 on the `K0` side: every `y : K0OfProjGen R`
    equals `(rankHomK0 R y) • [R]_{K0}`.  The argument mirrors D1/D5 but the only
    generators are projective = free modules `R^n`, whose classes are `n • [R]`
    directly (no torsion summands to kill), so it is in fact *simpler*. -/
theorem K0OfProjGen.eq_rankHomK0_smul_free1 (y : K0OfProjGen R) :
    y = (rankHomK0 R y) • (K0OfProjGen.mk R (K0Gen.free1 R)) := by
  refine eq_hom_smul_of_gens (rankHomK0 R) _ (fun p => ?_) y
  have h := K0OfProjGen.mk_eq_rankZ_smul_free1 p
  rwa [← show rankHomK0 R (K0OfProjGen.mk R p) = K0'Gen.rankZ R p.val from
    (rankHom_mk R p.val)] at h

/-- **D9 (`rankHomK0` is bijective).** Mirrors D6 using D8 + `rankHomK0_free1`. -/
@[sga "6 IX 1.7" "partial"]
theorem rankHomK0_bijective : Function.Bijective (rankHomK0 R) :=
  bijective_of_eq_smul _ _ (rankHomK0_free1 R) (K0OfProjGen.eq_rankHomK0_smul_free1 R)

/-- **D10 (`K0(R) ≃+ ℤ` via `rankHomK0`).** -/
@[sga "6 IX 1.7"]
noncomputable def K0OfProjGen.rankEquiv : K0OfProjGen R ≃+ ℤ :=
  AddEquiv.ofBijective (rankHomK0 R) (rankHomK0_bijective R)

end SketchK0

/-- `K0(k[x]) ≅ ℤ`, exhibited by an explicit isomorphism that sends
    the class `[k[x]]` of the rank-1 free module to `1`.  (The rank map.) -/
@[stacks 00JF "K0(k[x]) ≅ ℤ", sga "6 IX 1.7" "special case"]
theorem K0_polynomial_isoZ (k : Type*) [Field k] :
    ∃ e : K0OfProjGen (Polynomial k) ≃+ ℤ,
      e (K0OfProjGen.mk (Polynomial k) (K0Gen.free1 (Polynomial k))) = 1 := by
  refine ⟨K0OfProjGen.rankEquiv (Polynomial k), ?_⟩
  rw [K0OfProjGen.rankEquiv, AddEquiv.ofBijective_apply, rankHomK0_free1]

/-- `K0'(k[x]) ≅ ℤ`, exhibited by an explicit isomorphism that sends
    the class `[k[x]]` to `1` (the rank of the free part).  Every torsion finite
    module has class `0`. -/
@[stacks 00JF "K0'(k[x]) ≅ ℤ",
  sga "6 IX 1.7" "Lemma 1.7, case A = k[T]",
  sga "6 IX 3.4" "Case S = Spec k"]
theorem K0'_polynomial_isoZ (k : Type*) [Field k] :
    ∃ e : K0PrimeOfFinPres (Polynomial k) ≃+ ℤ,
      e (K0PrimeOfFinPres.mk (Polynomial k) (K0'Gen.free1 (Polynomial k))) = 1 := by
  refine ⟨K0PrimeOfFinPres.rankEquiv, ?_⟩
  rw [K0PrimeOfFinPres.rankEquiv, AddEquiv.ofBijective_apply, rankHom_free1]

/-- The canonical homomorphism `ι : K0(k[x]) → K0'(k[x])` is an
    isomorphism (it is bijective).

    Argument: `rankHom ∘ K0toK0' = rankHomK0` (definitionally, `rankHomK0`), and
    both `rankHom` (D6) and `rankHomK0` (D9) are bijective.  Therefore
    `K0toK0' = rankHom.symm ∘ rankHomK0` (as maps), a composite of bijections,
    hence bijective.  Formally: `K0toK0'` is injective because
    `rankHom ∘ K0toK0' = rankHomK0` is injective; it is surjective because
    `rankHom` is bijective and `rankHomK0 = rankHom ∘ K0toK0'` is surjective. -/
@[stacks 00JF "K0(k[x]) ≅ K0'(k[x])"]
theorem K0toK0'_polynomial_bijective (k : Type*) [Field k] :
    Function.Bijective (K0toK0' (Polynomial k)) := by
  refine ⟨fun _ _ h => (rankHomK0_bijective (Polynomial k)).injective
    (congrArg (rankHom (Polynomial k)) h), fun w => ?_⟩
  obtain ⟨y, hy⟩ := (rankHomK0_bijective (Polynomial k)).surjective (rankHom (Polynomial k) w)
  exact ⟨y, (rankHom_bijective (R := Polynomial k)).injective hy⟩
