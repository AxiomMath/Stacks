module

public import StacksFrontier.AlgebraicGeometry.PseudoCoherent.FittingIdealFreeModelBasis
public import StacksFrontier.AlgebraicGeometry.PseudoCoherent.FittingIdealLocalDescription

/-!
# The value of the Fitting ideal sheaf on an affine open

`AlgebraicGeometry.fittingIdealSheafOfDerivedModels` is `Scheme.IdealSheafData.ofIdeals` applied to
the family `AlgebraicGeometry.fittingIdealFamily` whose value on an affine open `U` is the infimum
of the ideals of minors of all bounded-above finite free models over `U` of all complexes
representing `E`. The inclusion `AlgebraicGeometry.ideal_fittingIdealSheafOfDerivedModels_le` is
free; the reverse one is not, because `ofIdeals A` is the *supremum* of the quasi-coherent ideal
sheaves below `A`, and a lower bound on a supremum means exhibiting one of them, that is, a family
which really is the family of ideals of a quasi-coherent ideal sheaf.

`Scheme.IdealSheafData.ofIdeals A` recovers `A` exactly when `A` satisfies the compatibility
`Scheme.IdealSheafData.map_ideal_basicOpen`: the base change of `A U` along
`Γ(X, U) → Γ(X, D(f))` is `A (D(f))`. This file reduces that compatibility to the two inputs the
proof of [Stacks, Tag 0ESP] supplies, and nothing else:

* **existence** — every affine open carries a complex representing `E` together with a
  bounded-above finite free model of it (this is the sentence "`E` locally on `X` has the shape as
  stated in the lemma" of the source, read on an affine open, where a pseudo-coherent complex is
  globally of that shape);
* **independence** — on an affine open the ideal of minors does not depend on the chosen complex
  or the chosen model (this is the whole content of the source's proof: reduce to local rings,
  split off trivial complexes, and appeal to the uniqueness of the resulting minimal complex).

With those two in hand, the family *is* the family of ideals of a quasi-coherent ideal sheaf
(`AlgebraicGeometry.fittingIdealSheafDataOfIndep`), that ideal sheaf is the Fitting ideal sheaf,
and the local description of the source holds as an equality
(`AlgebraicGeometry.ideal_fittingIdealSheafOfDerivedModels_eq_minorIdeal_of_indep`). What makes the
compatibility provable is `AlgebraicGeometry.DerivedFreeModel.exists_restrict`: a model over `U`
restricts to a model over `D(f)` whose ideal of minors is the base change of the original.

Both inputs are supplied in
`StacksFrontier/AlgebraicGeometry/PseudoCoherent/FittingIdealLocalEquality.lean`, which is where
[Stacks, Tag 0ESP] is registered; the statements here take them as explicit arguments so that the
reduction is separated from them.

## Main definitions

* `AlgebraicGeometry.fittingIdealFamily`: the family of ideals of minors that
  `AlgebraicGeometry.fittingIdealSheafOfDerivedModels` is `Scheme.IdealSheafData.ofIdeals` of.
* `AlgebraicGeometry.fittingIdealSheafDataOfIndep`: that family as a quasi-coherent ideal sheaf,
  from existence and independence.

## Main results

* `AlgebraicGeometry.fittingIdealFamily_eq_of_indep`: with independence, the family takes the
  value of any one model on an affine open which has one.
* `AlgebraicGeometry.map_fittingIdealFamily_basicOpen_of_indep`: with existence and
  independence, the family is compatible with passing to a standard open. This is where
  `AlgebraicGeometry.DerivedFreeModel.exists_restrict` is used.
* `AlgebraicGeometry.fittingIdealSheafOfDerivedModels_eq_of_indep` and
  `AlgebraicGeometry.ideal_fittingIdealSheafOfDerivedModels_eq_minorIdeal_of_indep`: the Fitting
  ideal sheaf is then that ideal sheaf, and on an affine open it is the ideal generated by the
  minors of the matrix of `d_p` of size `-k + n_{p+1} - n_{p+2} + ⋯ + (-1)^{b-p+1} n_b`.
* `AlgebraicGeometry.isFiniteType_fittingIdealSheafOfDerivedModels_of_indep`: and it is of finite
  type.

## References

* [Stacks Project, Tag 0ESP](https://stacks.math.columbia.edu/tag/0ESP)
-/

@[expose] public section

namespace AlgebraicGeometry

open CategoryTheory CategoryTheory.Limits TopologicalSpace
open scoped AlgebraicGeometry

noncomputable section

universe u w

variable {X : Scheme.{u}} [HasDerivedCategory.{w} X.Modules]

/-- The family of ideals of minors whose largest quasi-coherent ideal sheaf is the Fitting ideal
sheaf: on an affine open `U`, the infimum over every complex representing `E` and every
bounded-above finite free model of it over `U`. -/
def fittingIdealFamily (E : DerivedCategory X.Modules) (p k : ℤ) (U : X.affineOpens) :
    Ideal Γ(X, U) :=
  ⨅ (K : CochainComplex X.Modules ℤ) (_ : Nonempty (DerivedCategory.Q.obj K ≅ E))
    (M : DerivedFreeModel K U.1), M.fittingIdeal p k

/-- The Fitting ideal sheaf is the largest quasi-coherent ideal sheaf contained in
`fittingIdealFamily E p k`. -/
theorem fittingIdealSheafOfDerivedModels_eq_ofIdeals (E : DerivedCategory X.Modules) (p k : ℤ) :
    fittingIdealSheafOfDerivedModels E p k =
      Scheme.IdealSheafData.ofIdeals (fittingIdealFamily E p k) := rfl

/-- **For a family of models with the same ideal of minors, the defining family takes the value of
any one of them.** -/
theorem fittingIdealFamily_eq_of_indep (E : DerivedCategory X.Modules) (p k : ℤ)
    (hindep : ∀ (V : X.affineOpens) (K₁ : CochainComplex X.Modules ℤ)
      (_ : Nonempty (DerivedCategory.Q.obj K₁ ≅ E)) (M₁ : DerivedFreeModel K₁ V.1)
      (K₂ : CochainComplex X.Modules ℤ) (_ : Nonempty (DerivedCategory.Q.obj K₂ ≅ E))
      (M₂ : DerivedFreeModel K₂ V.1), M₁.fittingIdeal p k = M₂.fittingIdeal p k)
    (U : X.affineOpens) (K : CochainComplex X.Modules ℤ)
    (hK : Nonempty (DerivedCategory.Q.obj K ≅ E)) (M : DerivedFreeModel K U.1) :
    fittingIdealFamily E p k U = M.fittingIdeal p k := by
  refine le_antisymm ((iInf_le _ K).trans ((iInf_le _ hK).trans (iInf_le _ M))) ?_
  exact le_iInf fun K' => le_iInf fun hK' => le_iInf fun M' =>
    le_of_eq (hindep U K hK M K' hK' M')

/-- **With existence and independence of the model, the defining family is compatible with
passing to a standard open.** This is the hypothesis `Scheme.IdealSheafData.map_ideal_basicOpen` of
a quasi-coherent ideal sheaf, and the point at which
`AlgebraicGeometry.DerivedFreeModel.exists_restrict` is used: the model over `U` restricts to one
over `D(f)` whose ideal of minors is the base change of the original. -/
theorem map_fittingIdealFamily_basicOpen_of_indep (E : DerivedCategory X.Modules) (p k : ℤ)
    (hex : ∀ V : X.affineOpens, ∃ K : CochainComplex X.Modules ℤ,
      Nonempty (DerivedCategory.Q.obj K ≅ E) ∧ Nonempty (DerivedFreeModel K V.1))
    (hindep : ∀ (V : X.affineOpens) (K₁ : CochainComplex X.Modules ℤ)
      (_ : Nonempty (DerivedCategory.Q.obj K₁ ≅ E)) (M₁ : DerivedFreeModel K₁ V.1)
      (K₂ : CochainComplex X.Modules ℤ) (_ : Nonempty (DerivedCategory.Q.obj K₂ ≅ E))
      (M₂ : DerivedFreeModel K₂ V.1), M₁.fittingIdeal p k = M₂.fittingIdeal p k)
    (U : X.affineOpens) (f : Γ(X, U)) :
    (fittingIdealFamily E p k U).map (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom =
      fittingIdealFamily E p k (X.affineBasicOpen f) := by
  obtain ⟨K, hK, ⟨M⟩⟩ := hex U
  obtain ⟨M', -, -, hM'⟩ := M.exists_restrict (X.basicOpen_le f)
  rw [fittingIdealFamily_eq_of_indep E p k hindep U K hK M,
    fittingIdealFamily_eq_of_indep E p k hindep (X.affineBasicOpen f) K hK M']
  exact (hM' p k).symm

/-- **The defining family of the Fitting ideal sheaf as a quasi-coherent ideal sheaf**, from
existence and independence of the model on every affine open. -/
def fittingIdealSheafDataOfIndep (E : DerivedCategory X.Modules) (p k : ℤ)
    (hex : ∀ V : X.affineOpens, ∃ K : CochainComplex X.Modules ℤ,
      Nonempty (DerivedCategory.Q.obj K ≅ E) ∧ Nonempty (DerivedFreeModel K V.1))
    (hindep : ∀ (V : X.affineOpens) (K₁ : CochainComplex X.Modules ℤ)
      (_ : Nonempty (DerivedCategory.Q.obj K₁ ≅ E)) (M₁ : DerivedFreeModel K₁ V.1)
      (K₂ : CochainComplex X.Modules ℤ) (_ : Nonempty (DerivedCategory.Q.obj K₂ ≅ E))
      (M₂ : DerivedFreeModel K₂ V.1), M₁.fittingIdeal p k = M₂.fittingIdeal p k) :
    X.IdealSheafData where
  ideal := fittingIdealFamily E p k
  map_ideal_basicOpen := map_fittingIdealFamily_basicOpen_of_indep E p k hex hindep

/-- **The Fitting ideal sheaf is the defining family itself**, from existence and independence
of the model: the family is the family of ideals of a quasi-coherent ideal sheaf, and
`Scheme.IdealSheafData.ofIdeals` recovers such a family. -/
theorem fittingIdealSheafOfDerivedModels_eq_of_indep (E : DerivedCategory X.Modules) (p k : ℤ)
    (hex : ∀ V : X.affineOpens, ∃ K : CochainComplex X.Modules ℤ,
      Nonempty (DerivedCategory.Q.obj K ≅ E) ∧ Nonempty (DerivedFreeModel K V.1))
    (hindep : ∀ (V : X.affineOpens) (K₁ : CochainComplex X.Modules ℤ)
      (_ : Nonempty (DerivedCategory.Q.obj K₁ ≅ E)) (M₁ : DerivedFreeModel K₁ V.1)
      (K₂ : CochainComplex X.Modules ℤ) (_ : Nonempty (DerivedCategory.Q.obj K₂ ≅ E))
      (M₂ : DerivedFreeModel K₂ V.1), M₁.fittingIdeal p k = M₂.fittingIdeal p k) :
    fittingIdealSheafOfDerivedModels E p k = fittingIdealSheafDataOfIndep E p k hex hindep :=
  Scheme.IdealSheafData.ofIdeals_ideal (fittingIdealSheafDataOfIndep E p k hex hindep)

/-- The value of the Fitting ideal sheaf on an affine open, from existence and independence of
the model. -/
theorem ideal_fittingIdealSheafOfDerivedModels_eq_of_indep (E : DerivedCategory X.Modules) (p k : ℤ)
    (hex : ∀ V : X.affineOpens, ∃ K : CochainComplex X.Modules ℤ,
      Nonempty (DerivedCategory.Q.obj K ≅ E) ∧ Nonempty (DerivedFreeModel K V.1))
    (hindep : ∀ (V : X.affineOpens) (K₁ : CochainComplex X.Modules ℤ)
      (_ : Nonempty (DerivedCategory.Q.obj K₁ ≅ E)) (M₁ : DerivedFreeModel K₁ V.1)
      (K₂ : CochainComplex X.Modules ℤ) (_ : Nonempty (DerivedCategory.Q.obj K₂ ≅ E))
      (M₂ : DerivedFreeModel K₂ V.1), M₁.fittingIdeal p k = M₂.fittingIdeal p k)
    (U : X.affineOpens) :
    (fittingIdealSheafOfDerivedModels E p k).ideal U = fittingIdealFamily E p k U :=
  congr($(fittingIdealSheafOfDerivedModels_eq_of_indep E p k hex hindep).ideal U)

/-- **The local description of [Stacks, Tag 0ESP] as an equality**, from existence and
independence of the model on every affine open: on an affine open `U` with a bounded-above finite
free model of a complex representing `E`, the Fitting ideal sheaf is the ideal generated by the
minors of the matrix of `d_p` of size `-k + n_{p+1} - n_{p+2} + ⋯ + (-1)^{b-p+1} n_b`. -/
theorem ideal_fittingIdealSheafOfDerivedModels_eq_minorIdeal_of_indep
    (E : DerivedCategory X.Modules) (p k : ℤ)
    (hex : ∀ V : X.affineOpens, ∃ K : CochainComplex X.Modules ℤ,
      Nonempty (DerivedCategory.Q.obj K ≅ E) ∧ Nonempty (DerivedFreeModel K V.1))
    (hindep : ∀ (V : X.affineOpens) (K₁ : CochainComplex X.Modules ℤ)
      (_ : Nonempty (DerivedCategory.Q.obj K₁ ≅ E)) (M₁ : DerivedFreeModel K₁ V.1)
      (K₂ : CochainComplex X.Modules ℤ) (_ : Nonempty (DerivedCategory.Q.obj K₂ ≅ E))
      (M₂ : DerivedFreeModel K₂ V.1), M₁.fittingIdeal p k = M₂.fittingIdeal p k)
    (U : X.affineOpens) (K : CochainComplex X.Modules ℤ)
    (hK : Nonempty (DerivedCategory.Q.obj K ≅ E)) (M : DerivedFreeModel K U.1) :
    (fittingIdealSheafOfDerivedModels E p k).ideal U =
      minorIdeal (M.matrix p) (M.toFreeData.minorSize p k).toNat := by
  rw [ideal_fittingIdealSheafOfDerivedModels_eq_of_indep E p k hex hindep U,
    fittingIdealFamily_eq_of_indep E p k hindep U K hK M, M.fittingIdeal_eq p k]

/-- **The Fitting ideal sheaf of a pseudo-coherent complex is of finite type**, from existence
and independence of the model on every affine open: on an affine open it is the ideal of minors of
one model, and an ideal generated by the minors of a fixed size of a matrix with finitely many
rows and columns is finitely generated. -/
theorem isFiniteType_fittingIdealSheafOfDerivedModels_of_indep
    (E : DerivedCategory X.Modules) (p k : ℤ)
    (hex : ∀ V : X.affineOpens, ∃ K : CochainComplex X.Modules ℤ,
      Nonempty (DerivedCategory.Q.obj K ≅ E) ∧ Nonempty (DerivedFreeModel K V.1))
    (hindep : ∀ (V : X.affineOpens) (K₁ : CochainComplex X.Modules ℤ)
      (_ : Nonempty (DerivedCategory.Q.obj K₁ ≅ E)) (M₁ : DerivedFreeModel K₁ V.1)
      (K₂ : CochainComplex X.Modules ℤ) (_ : Nonempty (DerivedCategory.Q.obj K₂ ≅ E))
      (M₂ : DerivedFreeModel K₂ V.1), M₁.fittingIdeal p k = M₂.fittingIdeal p k) :
    (fittingIdealSheafOfDerivedModels E p k).IsFiniteType := by
  intro U
  obtain ⟨K, hK, ⟨M⟩⟩ := hex U
  rw [ideal_fittingIdealSheafOfDerivedModels_eq_minorIdeal_of_indep E p k hex hindep U K hK M]
  exact fg_minorIdeal _ _

end

end AlgebraicGeometry

end
