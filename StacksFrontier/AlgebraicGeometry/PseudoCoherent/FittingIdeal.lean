module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Free
public import Mathlib.Algebra.Homology.DerivedCategory.Basic
public import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
public import Mathlib.AlgebraicGeometry.Modules.Sheaf
public import Mathlib.LinearAlgebra.Matrix.Basis
public import Mathlib.RingTheory.Ideal.Maps
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.LinearAlgebra.Matrix.MinorIdeal

/-!
# Fitting ideals of a pseudo-coherent complex

Let `X` be a scheme and let `E` be a pseudo-coherent object of `D(𝒪_X)`. For `p k : ℤ` the
Fitting ideal sheaf `Fit_{p,k}(E) ⊆ 𝒪_X` is a quasi-coherent sheaf of ideals which, on an open
`U` over which `E` is isomorphic to a bounded-above complex of finite free modules
`⋯ → 𝒪_U^{n_{b-1}} → 𝒪_U^{n_b} → 0`, is generated by the minors of the matrix of `d_p` of size
`-k + n_{p+1} - n_{p+2} + ⋯ + (-1)^{b-p+1} n_b`.

## Main definitions

* `Stacks.FittingComplex.FreeData`: the rank function and the matrices of the differentials of a
  bounded-above complex of finite free modules in chosen bases.
* `Stacks.FittingComplex.FreeData.minorSize`: the size of the minors.
* `Stacks.FittingComplex.FreeData.fittingIdeal`: the ideal generated by those minors.
* `AlgebraicGeometry.FreeModel`: a bounded-above finite free model, over an open subscheme, of a
  complex of `𝒪_X`-modules.
* `AlgebraicGeometry.fittingIdealSheaf`: the Fitting ideal sheaf of a pseudo-coherent object
  of `D(𝒪_X)`.

## Main results

* `Stacks.FittingComplex.FreeData.fittingIdeal_eq_top_of_minorSize_nonpos` and
  `Stacks.FittingComplex.FreeData.fittingIdeal_eq_bot_of_card_lt_minorSize`: the two
  conventions of the source, that the ideal is the unit ideal when the size is `≤ 0` and the
  zero ideal when the size exceeds `min (n_p) (n_{p+1})`.
* `Stacks.FittingComplex.FreeData.fittingIdeal_fg`: the ideal is finitely generated.
* `Stacks.FittingComplex.FreeData.map_fittingIdeal`: it commutes with base change.
* `Stacks.FittingComplex.FreeData.fittingIdeal_eq_of_units_mul_mul`: it does not depend on the
  chosen bases, two choices differing by invertible matrices on either side.
* `minorIdeal_fromBlocks_one` and `minorIdeal_fromBlocks_of_isEmpty`: adjoining an identity
  block of size `m` and raising the size of the minors by `m` leaves the ideal unchanged, and
  adjoining a block with an empty index set leaves it unchanged at the same size. Together these
  are the computation that fixes the size of the minors: splitting off `m` trivial two-term
  complexes from a complex of finite free modules changes the matrix of `d_p` and the
  alternating sum of the ranks above `p` by cancelling amounts.
* `AlgebraicGeometry.ideal_fittingIdealSheaf_le`: on an affine open carrying a bounded-above
  finite free model of a complex representing `E`, the Fitting ideal sheaf is contained in the
  ideal of minors prescribed by the source.

## Implementation notes

A bounded-above complex of finite free modules is recorded by a rank function `rank : ℤ → ℕ`
vanishing above `top` together with matrices `d i : Matrix (Fin (rank (i + 1))) (Fin (rank i)) R`,
the matrix of the differential `R^{rank i} → R^{rank (i + 1)}` in the standard bases. The
alternating sum of the ranks above `p` is a finite sum because the ranks vanish above `top`.
The size of the minors is an integer, and `Int.toNat` implements the source's convention that a
nonpositive size gives the unit ideal: `minorIdeal A 0 = ⊤`. The second convention of the
source, that a size exceeding the number of rows or of columns gives the zero ideal, is likewise
automatic for `minorIdeal`.

The ideal sheaf is `Scheme.IdealSheafData.ofIdeals` applied to the family whose value on an
affine open `U` is the infimum, over every complex representing `E` and every bounded-above
finite free model of it over `U`, of the ideal of minors of that model. This is a construction,
not a choice: no representing complex and no model is selected. On an affine open the family
takes the common value of the ideals of minors as soon as one model exists there, which is the
situation the source's hypothesis describes.

## References

* [Stacks Project, Tag 0ESP](https://stacks.math.columbia.edu/tag/0ESP)
* [Stacks Project, Tag 07Z7](https://stacks.math.columbia.edu/tag/07Z7)
-/

@[expose] public section

open Matrix

section MinorIdeal

variable {R : Type*} {S : Type*} [CommRing R] [CommRing S] {l o : Type*}

/-- The ideal generated by the `r × r` minors of a matrix with finitely many rows and columns is
finitely generated: there are only finitely many such minors. -/
theorem fg_minorIdeal [Finite l] [Finite o] (A : Matrix l o R) (r : ℕ) :
    (minorIdeal A r).FG := by
  have hset : {x : R | ∃ (f : Fin r → l) (g : Fin r → o), x = (A.submatrix f g).det} =
      Set.range fun fg : (Fin r → l) × (Fin r → o) => (A.submatrix fg.1 fg.2).det := by
    ext x
    exact ⟨fun ⟨f, g, h⟩ => ⟨(f, g), h.symm⟩, fun ⟨fg, h⟩ => ⟨fg.1, fg.2, h.symm⟩⟩
  rw [minorIdeal, hset]
  exact Submodule.fg_span (Set.finite_range _)

/-- The ideal generated by the `r × r` minors commutes with base change along a ring
homomorphism. -/
theorem map_minorIdeal (A : Matrix l o R) (r : ℕ) (φ : R →+* S) :
    Ideal.map φ (minorIdeal A r) = minorIdeal (A.map φ) r := by
  rw [minorIdeal, minorIdeal, Ideal.map_span]
  congr 1
  ext x
  constructor
  · rintro ⟨y, ⟨f, g, rfl⟩, rfl⟩
    refine ⟨f, g, ?_⟩
    rw [Matrix.submatrix_map]
    exact RingHom.map_det φ _
  · rintro ⟨f, g, rfl⟩
    refine ⟨(A.submatrix f g).det, ⟨f, g, rfl⟩, ?_⟩
    rw [Matrix.submatrix_map]
    exact RingHom.map_det φ _

/-- Every `r × r` minor of the transpose of a matrix is an `r × r` minor of the matrix, so
`I_r(Aᵀ) ⊆ I_r(A)`. -/
theorem minorIdeal_transpose_le (A : Matrix l o R) (r : ℕ) :
    minorIdeal Aᵀ r ≤ minorIdeal A r := by
  rw [minorIdeal, Ideal.span_le]
  rintro x ⟨f, g, rfl⟩
  exact Ideal.subset_span ⟨g, f, by rw [← Matrix.transpose_submatrix, Matrix.det_transpose]⟩

/-- The ideal generated by the `r × r` minors is unchanged by transposing the matrix. -/
theorem minorIdeal_transpose (A : Matrix l o R) (r : ℕ) :
    minorIdeal Aᵀ r = minorIdeal A r := by
  refine le_antisymm (minorIdeal_transpose_le A r) ?_
  have h := minorIdeal_transpose_le Aᵀ r
  rwa [Matrix.transpose_transpose] at h

/-- Multiplying a matrix on the right by a square matrix does not enlarge the ideal generated by
its `r × r` minors. -/
theorem minorIdeal_mul_le_right [Fintype o]
    (A : Matrix l o R) (Q : Matrix o o R) (r : ℕ) :
    minorIdeal (A * Q) r ≤ minorIdeal A r :=
  calc minorIdeal (A * Q) r = minorIdeal (A * Q)ᵀ r := (minorIdeal_transpose _ _).symm
    _ = minorIdeal (Qᵀ * Aᵀ) r := by rw [Matrix.transpose_mul]
    _ ≤ minorIdeal Aᵀ r := minorIdeal_mul_le _ _ _
    _ = minorIdeal A r := minorIdeal_transpose _ _

/-- Multiplying a matrix on the right by an invertible square matrix does not change the ideal
generated by its `r × r` minors: a change of basis of the source. -/
theorem minorIdeal_mul_units_eq [Fintype o] [DecidableEq o]
    (A : Matrix l o R) (Q : (Matrix o o R)ˣ) (r : ℕ) :
    minorIdeal (A * (Q : Matrix o o R)) r = minorIdeal A r := by
  refine le_antisymm (minorIdeal_mul_le_right _ _ _) ?_
  calc minorIdeal A r
      = minorIdeal (A * (Q : Matrix o o R) * ((Q⁻¹ : (Matrix o o R)ˣ) :
          Matrix o o R)) r := by
        rw [Matrix.mul_assoc, Units.mul_inv, Matrix.mul_one]
    _ ≤ minorIdeal (A * (Q : Matrix o o R)) r := minorIdeal_mul_le_right _ _ _

/-- Multiplying a matrix on the left by an invertible square matrix does not change the ideal
generated by its `r × r` minors: a change of basis of the target. -/
theorem minorIdeal_units_mul_eq [Fintype l] [DecidableEq l]
    (A : Matrix l o R) (P : (Matrix l l R)ˣ) (r : ℕ) :
    minorIdeal ((P : Matrix l l R) * A) r = minorIdeal A r := by
  refine le_antisymm (minorIdeal_mul_le _ _ _) ?_
  calc minorIdeal A r
      = minorIdeal (((P⁻¹ : (Matrix l l R)ˣ) : Matrix l l R) *
          ((P : Matrix l l R) * A)) r := by
        rw [← Matrix.mul_assoc, Units.inv_mul, Matrix.one_mul]
    _ ≤ minorIdeal ((P : Matrix l l R) * A) r := minorIdeal_mul_le _ _ _

/-- The ideal generated by the `r × r` minors depends only on the linear map the matrix
represents, not on the chosen bases: changing both bases by invertible matrices leaves it
unchanged. -/
theorem minorIdeal_units_mul_mul_units_eq [Fintype l] [Fintype o]
    [DecidableEq l] [DecidableEq o]
    (A : Matrix l o R) (P : (Matrix l l R)ˣ) (Q : (Matrix o o R)ˣ) (r : ℕ) :
    minorIdeal ((P : Matrix l l R) * A * (Q : Matrix o o R)) r = minorIdeal A r := by
  rw [minorIdeal_mul_units_eq, minorIdeal_units_mul_eq]

/-- The `b × b` minors of the `m × m` identity matrix generate the unit ideal as soon as
`b ≤ m`. -/
theorem minorIdeal_one_eq_top {m b : ℕ} (h : b ≤ m) :
    minorIdeal (1 : Matrix (Fin m) (Fin m) R) b = ⊤ := by
  rw [Ideal.eq_top_iff_one, minorIdeal]
  exact Ideal.subset_span ⟨Fin.castLE h, Fin.castLE h, by
    rw [Matrix.submatrix_one _ (Fin.castLE_injective h), Matrix.det_one]⟩

/-- Adjoining a block `B` with `I_s(B) = ⊤` and `I_b(B) = ⊥` for `b > s` raises the size of the
minors by `s` without changing the ideal they generate. -/
private theorem minorIdeal_fromBlocks_add_eq {l₂ o₂ : Type*} (A : Matrix l o R)
    (B : Matrix l₂ o₂ R) (r s : ℕ) (htop : minorIdeal B s = ⊤)
    (hbot : ∀ b, s < b → minorIdeal B b = ⊥) :
    minorIdeal (Matrix.fromBlocks A 0 0 B) (r + s) = minorIdeal A r := by
  rw [minorIdeal_fromBlocks]
  refine le_antisymm ?_ ?_
  · refine Finset.sum_induction _ (· ≤ minorIdeal A r) (fun a b ha hb => sup_le ha hb)
      bot_le ?_
    rintro ⟨a, b⟩ hp
    have hab : a + b = r + s := Finset.mem_antidiagonal.mp hp
    by_cases hbs : b ≤ s
    · exact Ideal.mul_le_left.trans
        (antitone_nat_of_succ_le (minorIdeal_succ_le A) (by omega : r ≤ a))
    · rw [hbot b (not_le.mp hbs), Ideal.mul_bot]
      exact bot_le
  · have hmem := Finset.single_le_sum
      (f := fun q : ℕ × ℕ => minorIdeal A q.1 * minorIdeal B q.2)
      (a := (r, s)) (fun _ _ => bot_le) (Finset.mem_antidiagonal.mpr rfl)
    refine le_trans ?_ hmem
    rw [htop, Ideal.mul_top]

/-- Adjoining an identity block of size `m` to a matrix raises the size of the minors by `m`
without changing the ideal they generate: `I_{r+m}(diag(A, 1_m)) = I_r(A)`.

This is the computation that fixes the size of the minors in the Fitting ideals of a complex of
finite free modules. Splitting off `m` trivial two-term complexes in degrees `p` and `p + 1`
adds an identity block of size `m` to the matrix of `d_p` and raises the alternating sum
`n_{p+1} - n_{p+2} + ⋯` by exactly `m`, so the two changes cancel. -/
theorem minorIdeal_fromBlocks_one (A : Matrix l o R) (m r : ℕ) :
    minorIdeal (Matrix.fromBlocks A 0 0 (1 : Matrix (Fin m) (Fin m) R)) (r + m) =
      minorIdeal A r :=
  minorIdeal_fromBlocks_add_eq _ _ _ _ (minorIdeal_one_eq_top le_rfl) fun _ hb =>
    minorIdeal_eq_bot_of_card_lt _ _ (Or.inl (by simpa using hb))

/-- Adjoining a block with an empty index set changes neither the size of the minors nor the
ideal they generate: `I_r(diag(A, B)) = I_r(A)` when `B` has no rows, or no columns.

Splitting off trivial two-term complexes in a pair of degrees other than `p, p + 1` adds such a
block to the matrix of `d_p` and leaves the alternating sum of the ranks above `p` unchanged. -/
theorem minorIdeal_fromBlocks_of_isEmpty {l₂ o₂ : Type*} (A : Matrix l o R)
    (B : Matrix l₂ o₂ R) (r : ℕ) (hB : IsEmpty l₂ ∨ IsEmpty o₂) :
    minorIdeal (Matrix.fromBlocks A 0 0 B) r = minorIdeal A r :=
  minorIdeal_fromBlocks_add_eq A B r 0 (minorIdeal_zero _) fun b hb => by
    rw [minorIdeal, Ideal.span_eq_bot]
    rintro x ⟨f, g, rfl⟩
    rcases hB with h | h
    · exact h.elim (f ⟨0, hb⟩)
    · exact h.elim (g ⟨0, hb⟩)

end MinorIdeal

namespace Stacks.FittingComplex

universe u v

/-- The numerical data of a bounded-above complex of finite free modules over a commutative
ring, written in chosen bases: a rank in each degree, vanishing above `top`, together with the
matrices of the differentials. `d i` is the matrix of `R^{rank i} → R^{rank (i + 1)}`. The
condition that consecutive differentials compose to zero is irrelevant to the ideals below and
is therefore not recorded. -/
structure FreeData (R : Type u) [CommRing R] where
  /-- The rank of the free module in degree `i`. -/
  rank : ℤ → ℕ
  /-- A degree above which the complex vanishes. -/
  top : ℤ
  /-- The complex vanishes above `top`. -/
  rank_eq_zero_of_top_lt : ∀ i : ℤ, top < i → rank i = 0
  /-- The matrix of the differential `R^{rank i} → R^{rank (i + 1)}` in the standard bases. -/
  d : ∀ i : ℤ, Matrix (Fin (rank (i + 1))) (Fin (rank i)) R

namespace FreeData

variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] (C : FreeData R)

/-- The alternating sum `n_{p+1} - n_{p+2} + ⋯ + (-1)^{b-p+1} n_b` of the ranks in the degrees
above `p`, where `b` is a degree above which the complex vanishes. -/
def tailAlternatingRank (p : ℤ) : ℤ :=
  ∑ j ∈ Finset.range (C.top - p).toNat, (-1 : ℤ) ^ j * (C.rank (p + 1 + j) : ℤ)

/-- The size of the minors of `d_p` cutting out the `(p, k)`-th Fitting ideal:
`-k + n_{p+1} - n_{p+2} + ⋯ + (-1)^{b-p+1} n_b`. -/
def minorSize (p k : ℤ) : ℤ :=
  C.tailAlternatingRank p - k

/-- The `(p, k)`-th Fitting ideal of a bounded-above complex of finite free modules: the ideal
generated by the minors of the matrix of `d_p` of size `minorSize p k`. -/
def fittingIdeal (p k : ℤ) : Ideal R :=
  minorIdeal (C.d p) (C.minorSize p k).toNat

/-- The alternating sum of the ranks above `p` vanishes when `p` is at least the top degree. -/
theorem tailAlternatingRank_of_top_le {p : ℤ} (hp : C.top ≤ p) :
    C.tailAlternatingRank p = 0 := by
  rw [tailAlternatingRank, Int.toNat_of_nonpos (by omega), Finset.range_zero,
    Finset.sum_empty]

/-- A nonpositive size of minors gives the unit ideal, one of the two conventions of the
source. -/
theorem fittingIdeal_eq_top_of_minorSize_nonpos {p k : ℤ} (h : C.minorSize p k ≤ 0) :
    C.fittingIdeal p k = ⊤ := by
  rw [fittingIdeal, Int.toNat_of_nonpos h, minorIdeal_zero]

/-- A size of minors exceeding the number of rows or of columns of the matrix of `d_p` gives the
zero ideal, the second convention of the source. -/
theorem fittingIdeal_eq_bot_of_card_lt_minorSize {p k : ℤ}
    (h : (C.rank p : ℤ) < C.minorSize p k ∨ (C.rank (p + 1) : ℤ) < C.minorSize p k) :
    C.fittingIdeal p k = ⊥ := by
  refine minorIdeal_eq_bot_of_card_lt _ _ ?_
  simp only [Fintype.card_fin]
  omega

/-- The Fitting ideals of a bounded-above complex of finite free modules are of finite type. -/
theorem fittingIdeal_fg (p k : ℤ) : (C.fittingIdeal p k).FG :=
  fg_minorIdeal _ _

/-- Base change of the complex along a ring homomorphism, applied to each matrix. -/
def map (φ : R →+* S) : FreeData S where
  rank := C.rank
  top := C.top
  rank_eq_zero_of_top_lt := C.rank_eq_zero_of_top_lt
  d i := (C.d i).map φ

/-- Base change does not change the ranks of the complex. -/
@[simp]
theorem map_rank (φ : R →+* S) : (C.map φ).rank = C.rank := rfl

/-- Base change does not change the top degree of the complex. -/
@[simp]
theorem map_top (φ : R →+* S) : (C.map φ).top = C.top := rfl

/-- Base change does not change the alternating sum of the ranks above a degree. -/
@[simp]
theorem map_tailAlternatingRank (φ : R →+* S) (p : ℤ) :
    (C.map φ).tailAlternatingRank p = C.tailAlternatingRank p := rfl

/-- Base change does not change the size of the minors defining a Fitting ideal. -/
@[simp]
theorem map_minorSize (φ : R →+* S) (p k : ℤ) : (C.map φ).minorSize p k = C.minorSize p k := rfl

/-- The Fitting ideals of a bounded-above complex of finite free modules commute with base
change. -/
theorem map_fittingIdeal (φ : R →+* S) (p k : ℤ) :
    Ideal.map φ (C.fittingIdeal p k) = (C.map φ).fittingIdeal p k := by
  rw [fittingIdeal, fittingIdeal, map_minorIdeal, map_minorSize]
  rfl

/-- The Fitting ideal does not depend on the chosen bases: replacing the matrix of `d_p` by
`P * d_p * Q` for invertible `P` and `Q` leaves it unchanged. -/
theorem fittingIdeal_eq_of_units_mul_mul (p k : ℤ)
    (P : (Matrix (Fin (C.rank (p + 1))) (Fin (C.rank (p + 1))) R)ˣ)
    (Q : (Matrix (Fin (C.rank p)) (Fin (C.rank p)) R)ˣ) :
    minorIdeal ((P : Matrix (Fin (C.rank (p + 1))) (Fin (C.rank (p + 1))) R) * C.d p *
        (Q : Matrix (Fin (C.rank p)) (Fin (C.rank p)) R))
        (C.minorSize p k).toNat = C.fittingIdeal p k :=
  minorIdeal_units_mul_mul_units_eq _ _ _ _

end FreeData

end Stacks.FittingComplex

/-! ### The Fitting ideal sheaf of a pseudo-coherent object on a scheme -/

namespace AlgebraicGeometry

open CategoryTheory CategoryTheory.Limits TopologicalSpace
open scoped AlgebraicGeometry

noncomputable section

universe u w

/-- Restriction of `𝒪_X`-modules to an open subscheme preserves zero morphisms, hence acts on
complexes degreewise. -/
instance Scheme.Modules.restrictFunctor_preservesZeroMorphisms {X : Scheme.{u}} (U : X.Opens) :
    (Scheme.Modules.restrictFunctor U.ι).PreservesZeroMorphisms where
  map_zero _ _ := by
    ext _ _
    rfl

/-- Restriction of a complex of `𝒪_X`-modules to an open subscheme, applied degreewise. -/
abbrev Scheme.Modules.restrictComplex {X : Scheme.{u}} (K : CochainComplex X.Modules ℤ)
    (U : X.Opens) : CochainComplex (U.toScheme).Modules ℤ :=
  ((Scheme.Modules.restrictFunctor U.ι).mapHomologicalComplex (ComplexShape.up ℤ)).obj K

/-- A bounded-above finite free model of a complex of `𝒪_X`-modules over an open `U`: a complex
of `𝒪_X`-modules which over `U` is finite free in each degree and vanishes above `top`, together
with a map to the given complex which is a quasi-isomorphism over `U`. This is the local
situation in the hypothesis of [Stacks, Tag 0ESP]. -/
structure FreeModel {X : Scheme.{u}} (K : CochainComplex X.Modules ℤ) (U : X.Opens) where
  /-- The modelling complex. -/
  model : CochainComplex X.Modules ℤ
  /-- The rank of the model in degree `i`. -/
  rank : ℤ → ℕ
  /-- A degree above which the model vanishes over `U`. -/
  top : ℤ
  /-- The model vanishes above `top`. -/
  rank_eq_zero_of_top_lt : ∀ i : ℤ, top < i → rank i = 0
  /-- Over `U` the model is free of rank `rank i` in degree `i`. -/
  isFree : ∀ i : ℤ, Nonempty ((Scheme.Modules.restrictFunctor U.ι).obj (model.X i) ≅
    SheafOfModules.free (R := (U.toScheme).ringCatSheaf) (ULift.{u} (Fin (rank i))))
  /-- The chosen basis of the sections of the model over `U` in degree `i`. -/
  basis : ∀ i : ℤ, Module.Basis (Fin (rank i)) Γ(X, U) Γ(model.X i, U)
  /-- The comparison map to the given complex. -/
  hom : model ⟶ K
  /-- The comparison map is a quasi-isomorphism over `U`. -/
  quasiIso : QuasiIso
    (((Scheme.Modules.restrictFunctor U.ι).mapHomologicalComplex (ComplexShape.up ℤ)).map hom)

namespace FreeModel

variable {X : Scheme.{u}} {K : CochainComplex X.Modules ℤ} {U : X.Opens} (M : FreeModel K U)

/-- The matrix of the differential of the model in degree `p`, in the chosen bases of its
sections over `U`. -/
noncomputable def matrix (p : ℤ) :
    Matrix (Fin (M.rank (p + 1))) (Fin (M.rank p)) Γ(X, U) :=
  LinearMap.toMatrix (M.basis p) (M.basis (p + 1))
    ((M.model.d p (p + 1)).val.app (Opposite.op U)).hom

/-- The bounded-above complex of finite free `Γ(X, U)`-modules that a finite free model over `U`
presents: its ranks and the matrices of its differentials. -/
noncomputable def toFreeData : Stacks.FittingComplex.FreeData Γ(X, U) where
  rank := M.rank
  top := M.top
  rank_eq_zero_of_top_lt := M.rank_eq_zero_of_top_lt
  d := M.matrix

/-- The `(p, k)`-th Fitting ideal computed from a finite free model over `U`: the ideal of
`Γ(X, U)` generated by the minors of the matrix of `d_p` of the size prescribed by the
alternating sum of the ranks above `p`. -/
noncomputable def fittingIdeal (p k : ℤ) : Ideal Γ(X, U) :=
  M.toFreeData.fittingIdeal p k

/-- The Fitting ideal computed from a finite free model is the ideal of minors of
`M.matrix p` of size `minorSize p k`. -/
theorem fittingIdeal_eq (p k : ℤ) :
    M.fittingIdeal p k =
      minorIdeal (M.matrix p) (M.toFreeData.minorSize p k).toNat := rfl

/-- The Fitting ideal computed from a finite free model is finitely generated. -/
theorem fittingIdeal_fg (p k : ℤ) : (M.fittingIdeal p k).FG :=
  M.toFreeData.fittingIdeal_fg p k

end FreeModel

/-- The `(p, k)`-th Fitting ideal sheaf of a pseudo-coherent object of `D(𝒪_X)`, the largest
quasi-coherent sheaf of ideals which on every affine open is contained in the ideal of minors of
`d_p` computed from every bounded-above finite free model, over `U`, of every complex
representing `E`. -/
@[stacks 0ESP "the quasi-coherent ideal sheaf Fit_{p,k}(E)"]
noncomputable def fittingIdealSheaf {X : Scheme.{u}} [HasDerivedCategory.{w} X.Modules]
    (E : DerivedCategory X.Modules) (p k : ℤ) : X.IdealSheafData :=
  Scheme.IdealSheafData.ofIdeals fun U ↦
    ⨅ (K : CochainComplex X.Modules ℤ) (_ : Nonempty (DerivedCategory.Q.obj K ≅ E))
      (M : FreeModel K U.1), M.fittingIdeal p k

/-- On an affine open `U` over which a complex representing `E` has a bounded-above finite free
model, the Fitting ideal sheaf is contained in the ideal generated by the minors of the matrix of
`d_p` of size `-k + n_{p+1} - n_{p+2} + ⋯ + (-1)^{b-p+1} n_b`. -/
@[stacks 0ESP "the local description, the inclusion into the ideal of minors"]
theorem ideal_fittingIdealSheaf_le {X : Scheme.{u}} [HasDerivedCategory.{w} X.Modules]
    (E : DerivedCategory X.Modules) (p k : ℤ) (U : X.affineOpens)
    (K : CochainComplex X.Modules ℤ) (hK : Nonempty (DerivedCategory.Q.obj K ≅ E))
    (M : FreeModel K U.1) :
    (fittingIdealSheaf E p k).ideal U ≤
      minorIdeal (M.matrix p) (M.toFreeData.minorSize p k).toNat :=
  (Scheme.IdealSheafData.ideal_ofIdeals_le _ U).trans
    ((iInf_le _ K).trans ((iInf_le _ hK).trans (iInf_le _ M)))

end

end AlgebraicGeometry

