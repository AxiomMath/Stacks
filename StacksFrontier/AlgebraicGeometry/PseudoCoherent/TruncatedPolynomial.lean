/-!
# Truncated polynomial algebras

Fix a commutative ring `R`, a family of variables `σ` and exponents `N : σ → ℕ`. The ideal
generated by the powers `Xᵢ^{N i}` is a monomial ideal, so the quotient
`R[σ] / (Xᵢ^{N i} : i)` is free as an `R`-module on the monomials whose exponent in each
variable is smaller than the prescribed bound. When `σ` is finite that quotient is finite free,
and when moreover every `N i` is nonzero it is a nilpotent thickening of `R`: the map killing
every variable is an `R`-algebra retraction whose kernel consists of nilpotents, so `R` and the
quotient have homeomorphic spectra.

These algebras are the intermediate ring `R[x_i, y_j]/(y_j^N)` appearing in the proof of
Stacks 09VG, where they interpolate between a polynomial algebra and a finite-type algebra whose
generators differ from elements of a subalgebra by nilpotents.

## Main definitions

* `MvPolynomial.variablePowerIdeal`: the ideal generated by the prescribed powers of the
  variables.
* `MvPolynomial.quotientVariablePowerIdealEquiv`: the quotient is `R`-linearly isomorphic to the
  span of the bounded monomials.
* `MvPolynomial.truncatedPolynomialAugmentation`: the `R`-algebra retraction killing every
  variable.

## Main results

* `MvPolynomial.free_quotient_variablePowerIdeal` and
  `MvPolynomial.finite_quotient_variablePowerIdeal`: the quotient is free, and finite when the
  variables are.
* `MvPolynomial.exists_surjective_truncatedPolynomialMap`: if `B` is generated over a quotient
  `A` of `R` by elements differing from elements of `A` by nilpotents of prescribed order, then
  `B` is a quotient of a truncated polynomial algebra over `R`.
* `MvPolynomial.isHomeomorph_comap_truncatedPolynomial`: the spectrum of the quotient is
  homeomorphic to the spectrum of `R`.
* `Algebra.exists_generators_nilpotent_sub_algebraMap`: a finite-type algebra all of whose
  elements differ from an element of the base by a nilpotent has a finite generating family whose
  members differ from elements of the base by nilpotents of one common order.

## References

* [Stacks Project, Tag 09VG](https://stacks.math.columbia.edu/tag/09VG)
-/

@[expose] public noncomputable section

namespace MvPolynomial

universe u v

variable (R : Type u) [CommRing R] {σ : Type v}

/-- The ideal of `R[σ]` generated by the powers `Xᵢ^{N i}` of the variables. -/
public abbrev variablePowerIdeal (N : σ → ℕ) : Ideal (MvPolynomial σ R) :=
  Ideal.span (Set.range fun i => X i ^ N i)

/-- Membership in `MvPolynomial.variablePowerIdeal` is a condition on the support: a polynomial
lies in the ideal generated by the powers `Xᵢ^{N i}` exactly when every monomial occurring in it
is divisible by one of them.

This is Mathlib's description of a monomial ideal,
`MvPolynomial.mem_ideal_span_monomial_image`. -/
public theorem mem_variablePowerIdeal_iff (N : σ → ℕ) (p : MvPolynomial σ R) :
    p ∈ variablePowerIdeal R N ↔ ∀ d ∈ p.support, ∃ i, N i ≤ d i := by
  classical
  have hgen : (Set.range fun i => (X i : MvPolynomial σ R) ^ N i) =
      (fun d => monomial d (1 : R)) '' (Set.range fun i => Finsupp.single i (N i)) := by
    rw [← Set.range_comp]
    exact congrArg Set.range (funext fun i => X_pow_eq_monomial)
  rw [variablePowerIdeal, hgen, mem_ideal_span_monomial_image]
  simp

/-- `MvPolynomial.variablePowerIdeal`, read as an `R`-submodule, is the span of the monomials
whose exponent in some variable reaches the prescribed bound. -/
public theorem variablePowerIdeal_restrictScalars (N : σ → ℕ) :
    (variablePowerIdeal R N).restrictScalars R =
      restrictSupport R {d | ∃ i, N i ≤ d i} := by
  ext p
  exact mem_variablePowerIdeal_iff R N p

/-- The spans of a set of monomials and of its complement are complementary submodules of
`R[σ]`, the monomials being a basis. -/
public theorem isCompl_restrictSupport (s : Set (σ →₀ ℕ)) :
    IsCompl (restrictSupport R s) (restrictSupport R sᶜ) := by
  rw [restrictSupport_eq_span, restrictSupport_eq_span]
  refine ⟨?_, ?_⟩
  · simpa only [coe_basisMonomials] using
      (basisMonomials σ R).linearIndependent.disjoint_span_image
        (disjoint_compl_right : Disjoint s sᶜ)
  · rw [codisjoint_iff, ← Submodule.span_union, ← Set.image_union, Set.union_compl_self,
      Set.image_univ]
    exact (basisMonomials σ R).span_eq

/-- The quotient of `R[σ]` by `MvPolynomial.variablePowerIdeal` is `R`-linearly isomorphic to the
span of the monomials bounded by the prescribed exponents, the ideal being spanned by the
remaining monomials. -/
@[ega "III 2.1.8" "more general"]
public def quotientVariablePowerIdealEquiv (N : σ → ℕ) :
    (MvPolynomial σ R ⧸ variablePowerIdeal R N) ≃ₗ[R]
      restrictSupport R {d | ∀ i, d i < N i} :=
  have hcompl : IsCompl ((variablePowerIdeal R N).restrictScalars R)
      (restrictSupport R {d | ∃ i, N i ≤ d i}ᶜ) :=
    variablePowerIdeal_restrictScalars R N ▸ isCompl_restrictSupport R {d | ∃ i, N i ≤ d i}
  have hsc : {d : σ →₀ ℕ | ∃ i, N i ≤ d i}ᶜ = {d | ∀ i, d i < N i} :=
    Set.ext fun d => by simp
  (Submodule.Quotient.restrictScalarsEquiv R (variablePowerIdeal R N)).symm ≪≫ₗ
    (Submodule.quotientEquivOfIsCompl _ _ hcompl) ≪≫ₗ
      LinearEquiv.ofEq _ _ (congrArg (restrictSupport R) hsc)

/-- The quotient of `R[σ]` by the powers `Xᵢ^{N i}` of the variables is a free `R`-module, on the
monomials bounded by the prescribed exponents. -/
@[ega "III 2.1.8" "partial"]
public theorem free_quotient_variablePowerIdeal (N : σ → ℕ) :
    Module.Free R (MvPolynomial σ R ⧸ variablePowerIdeal R N) :=
  have : Module.Free R (restrictSupport R {d : σ →₀ ℕ | ∀ i, d i < N i}) :=
    Module.Free.of_basis (basisRestrictSupport R {d | ∀ i, d i < N i})
  Module.Free.of_equiv (quotientVariablePowerIdealEquiv R N).symm

/-- The quotient of `R[σ]` by the powers `Xᵢ^{N i}` of the variables is a finite `R`-module when
there are finitely many variables: there are only finitely many monomials with exponent smaller
than `N i` in the variable `i`. -/
public theorem finite_quotient_variablePowerIdeal [Finite σ] (N : σ → ℕ) :
    Module.Finite R (MvPolynomial σ R ⧸ variablePowerIdeal R N) := by
  have he : Function.Injective (fun d : {d : σ →₀ ℕ | ∀ i, d i < N i} =>
      fun i => (⟨d.val i, d.property i⟩ : Fin (N i))) :=
    fun a b h => Subtype.ext (Finsupp.ext fun i => congrArg Fin.val (congrFun h i))
  have : Finite {d : σ →₀ ℕ | ∀ i, d i < N i} := Finite.of_injective _ he
  have : Module.Finite R (restrictSupport R {d : σ →₀ ℕ | ∀ i, d i < N i}) :=
    Module.Finite.of_basis (basisRestrictSupport R {d | ∀ i, d i < N i})
  exact Module.Finite.equiv (quotientVariablePowerIdealEquiv R N).symm

/-- Translating the variables by elements of the base does not change the image of the evaluation
map: if the elements `Q.val i` generate `B` as an `A`-algebra, then so do the differences
`Q.val i - a i` for any `a : σ → A`. -/
public theorem surjective_aeval_sub_algebraMap {A B : Type u} [CommRing A] [CommRing B]
    [Algebra A B] (Q : Algebra.Generators A B σ) (a : σ → A) :
    Function.Surjective (aeval (R := A) fun i => Q.val i - algebraMap A B (a i)) := by
  have h : (aeval (R := A) fun i => Q.val i - algebraMap A B (a i)).comp
      (aeval (R := A) fun i => (X i : MvPolynomial σ A) + C (a i)) = aeval Q.val := by
    ext i
    simp
  have hQ : Function.Surjective (aeval (R := A) Q.val) := Q.aeval_val_surjective
  rw [← h] at hQ
  exact Function.Surjective.of_comp hQ

/-- **A nilpotent thickening is a quotient of a truncated polynomial algebra.** Let `R → A` be
surjective and let `B` be an `A`-algebra generated by elements `Q.val i` each of which differs
from an element `a i` of `A` by a nilpotent of order `N i`. Then `B` is a quotient of
`R[σ] / (Xᵢ^{N i} : i)` as an `R`-algebra.

Mapping `Xᵢ` to the nilpotent `Q.val i - a i` is surjective by
`MvPolynomial.surjective_aeval_sub_algebraMap`, and kills the powers `Xᵢ^{N i}`. -/
public theorem exists_surjective_truncatedPolynomialMap {A B : Type u} [CommRing A] [CommRing B]
    [Algebra R A] [Algebra A B] [Algebra R B] [IsScalarTower R A B]
    (hA : Function.Surjective (algebraMap R A)) (Q : Algebra.Generators A B σ) (a : σ → A)
    (N : σ → ℕ) (hN : ∀ i, (Q.val i - algebraMap A B (a i)) ^ N i = 0) :
    ∃ ψ : (MvPolynomial σ R ⧸ variablePowerIdeal R N) →ₐ[R] B, Function.Surjective ψ := by
  set b : σ → B := fun i => Q.val i - algebraMap A B (a i) with hb
  set φ : MvPolynomial σ R →ₐ[R] B := aeval b with hφdef
  have heq : φ.toRingHom =
      (aeval b : MvPolynomial σ A →ₐ[A] B).toRingHom.comp (map (algebraMap R A)) := by
    ext r <;> simp [hφdef, ← IsScalarTower.algebraMap_apply R A B]
  have hφ : Function.Surjective φ := by
    change Function.Surjective φ.toRingHom
    rw [heq]
    exact (surjective_aeval_sub_algebraMap Q a).comp (map_surjective _ hA)
  have hker : variablePowerIdeal R N ≤ RingHom.ker φ.toRingHom := by
    refine Ideal.span_le.2 ?_
    rintro x ⟨i, rfl⟩
    change φ (X i ^ N i) = 0
    simpa [hφdef, hb] using hN i
  refine ⟨Ideal.Quotient.liftₐ (variablePowerIdeal R N) φ fun x hx => hker hx, fun x => ?_⟩
  obtain ⟨p, hp⟩ := hφ x
  exact ⟨Ideal.Quotient.mk _ p, hp⟩

/-- Each variable is nilpotent in `R[σ] / (Xᵢ^{N i} : i)`. -/
public theorem isNilpotent_quotient_variablePowerIdeal_X (N : σ → ℕ) (i : σ) :
    IsNilpotent (Ideal.Quotient.mk (variablePowerIdeal R N) (X i)) := by
  refine ⟨N i, ?_⟩
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span ⟨i, rfl⟩

/-- In `R[σ] / (Xᵢ^{N i} : i)` every element differs from the value of its constant term by a
nilpotent: the variables are nilpotent, and the nilpotents form an ideal. -/
public theorem isNilpotent_quotient_sub_constantCoeff (N : σ → ℕ) (p : MvPolynomial σ R) :
    IsNilpotent (Ideal.Quotient.mk (variablePowerIdeal R N) p -
      algebraMap R (MvPolynomial σ R ⧸ variablePowerIdeal R N)
        (aeval (R := R) (fun _ : σ => (0 : R)) p)) := by
  induction p using MvPolynomial.induction_on with
  | C a =>
    rw [show Ideal.Quotient.mk (variablePowerIdeal R N) (C a) =
        algebraMap R (MvPolynomial σ R ⧸ variablePowerIdeal R N) a from rfl,
      show aeval (R := R) (fun _ : σ => (0 : R)) (C a) = a by simp, sub_self]
    exact IsNilpotent.zero
  | add p q hp hq =>
    simp only [map_add]
    rw [add_sub_add_comm]
    exact (Commute.all _ _).isNilpotent_add hp hq
  | mul_X p i hp =>
    rw [map_mul, map_mul, aeval_X, mul_zero, map_zero, sub_zero]
    exact (Commute.all _ _).isNilpotent_mul_left
      (isNilpotent_quotient_variablePowerIdeal_X R N i)

/-- The `R`-algebra retraction of `R[σ] / (Xᵢ^{N i} : i)` that kills every variable. It is
defined when every exponent is nonzero, which is what makes the evaluation at zero vanish on the
ideal. -/
public def truncatedPolynomialAugmentation (N : σ → ℕ) (hN : ∀ i, N i ≠ 0) :
    (MvPolynomial σ R ⧸ variablePowerIdeal R N) →ₐ[R] R :=
  have hker : variablePowerIdeal R N ≤
      RingHom.ker (aeval (R := R) (fun _ : σ => (0 : R))).toRingHom := by
    refine Ideal.span_le.2 ?_
    rintro p ⟨i, rfl⟩
    have h : (aeval (R := R) (fun _ : σ => (0 : R))) (X i ^ N i) = 0 := by simp [hN i]
    exact h
  Ideal.Quotient.liftₐ (variablePowerIdeal R N) (aeval (R := R) (fun _ : σ => (0 : R)))
    fun x hx => hker hx

/-- `MvPolynomial.truncatedPolynomialAugmentation` takes the class of a polynomial to its value
at the origin. -/
public theorem truncatedPolynomialAugmentation_mk (N : σ → ℕ) (hN : ∀ i, N i ≠ 0)
    (p : MvPolynomial σ R) :
    truncatedPolynomialAugmentation R N hN (Ideal.Quotient.mk (variablePowerIdeal R N) p) =
      aeval (R := R) (fun _ : σ => (0 : R)) p :=
  rfl

/-- `MvPolynomial.truncatedPolynomialAugmentation` is surjective, being an `R`-algebra map to
`R`. -/
public theorem truncatedPolynomialAugmentation_surjective (N : σ → ℕ) (hN : ∀ i, N i ≠ 0) :
    Function.Surjective (truncatedPolynomialAugmentation R N hN) :=
  fun r => ⟨algebraMap R _ r, (truncatedPolynomialAugmentation R N hN).commutes r⟩

/-- The kernel of `MvPolynomial.truncatedPolynomialAugmentation` consists of nilpotents: an
element of the kernel is represented by a polynomial vanishing at the origin, and such a
polynomial becomes nilpotent in the quotient by
`MvPolynomial.isNilpotent_quotient_sub_constantCoeff`. -/
public theorem ker_truncatedPolynomialAugmentation_le_nilradical (N : σ → ℕ)
    (hN : ∀ i, N i ≠ 0) :
    RingHom.ker (truncatedPolynomialAugmentation R N hN).toRingHom ≤
      nilradical (MvPolynomial σ R ⧸ variablePowerIdeal R N) := by
  intro x hx
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective x
  have hp : aeval (R := R) (fun _ : σ => (0 : R)) p = 0 := hx
  have h := isNilpotent_quotient_sub_constantCoeff R N p
  rw [hp, map_zero, sub_zero] at h
  exact mem_nilradical.mpr h

end MvPolynomial

namespace PrimeSpectrum

universe u v

/-- **An algebra with a retraction whose kernel is nilpotent has the same spectrum as its base.**
If `ε : A →ₐ[R] R` is an `R`-algebra retraction whose kernel consists of nilpotents, then
`Spec A → Spec R` is a homeomorphism.

`PrimeSpectrum.isHomeomorph_comap` applies to `ε`, which is surjective and has nilpotent kernel;
the structure map is a section of `ε`, so the map it induces on spectra is the inverse of a
homeomorphism. -/
public theorem isHomeomorph_comap_algebraMap_of_augmentation {R : Type u} {A : Type v}
    [CommRing R] [CommRing A] [Algebra R A] (ε : A →ₐ[R] R)
    (hε : RingHom.ker ε.toRingHom ≤ nilradical A) :
    IsHomeomorph (PrimeSpectrum.comap (algebraMap R A)) := by
  have hs : Function.Surjective ε := fun r => ⟨algebraMap R A r, ε.commutes r⟩
  have he := PrimeSpectrum.isHomeomorph_comap ε.toRingHom
    (fun r => ⟨1, Nat.one_pos, by
      obtain ⟨a, ha⟩ := hs r
      exact ⟨a, by simpa using ha⟩⟩) hε
  have hcomp : ε.toRingHom.comp (algebraMap R A) = RingHom.id R :=
    RingHom.ext fun r => ε.commutes r
  have hinv : PrimeSpectrum.comap (algebraMap R A) = he.homeomorph.symm := by
    funext p
    obtain ⟨q, rfl⟩ := he.bijective.2 p
    have h := congrFun (PrimeSpectrum.comap_comp (algebraMap R A) ε.toRingHom) q
    rw [hcomp, PrimeSpectrum.comap_id] at h
    exact h.symm.trans (he.homeomorph.symm_apply_apply q).symm
  rw [hinv]
  exact he.homeomorph.symm.isHomeomorph

/-- **A truncated polynomial algebra is a nilpotent thickening of its base.** When every exponent
is nonzero the structure map `R → R[σ] / (Xᵢ^{N i} : i)` induces a homeomorphism of spectra. -/
public theorem isHomeomorph_comap_truncatedPolynomial (R : Type u) [CommRing R] {σ : Type v}
    (N : σ → ℕ) (hN : ∀ i, N i ≠ 0) :
    IsHomeomorph (PrimeSpectrum.comap
      (algebraMap R (MvPolynomial σ R ⧸ MvPolynomial.variablePowerIdeal R N))) :=
  isHomeomorph_comap_algebraMap_of_augmentation
    (MvPolynomial.truncatedPolynomialAugmentation R N hN)
    (MvPolynomial.ker_truncatedPolynomialAugmentation_le_nilradical R N hN)

end PrimeSpectrum

namespace Algebra

universe u

/-- **A finite-type algebra whose elements are nilpotent modulo the base has nilpotent generators
of a uniform order.** If every `b : B` differs from the image of some element of `A` by a
nilpotent, then `B` is generated over `A` by finitely many elements `Q.val j` for which
`(Q.val j - a j) ^ N = 0` with one exponent `N` serving for all of them.

Take any finite generating family, choose for each generator an element of `A` making the
difference nilpotent, and let `N` be large enough for all of the finitely many orders. -/
public theorem exists_generators_nilpotent_sub_algebraMap {A B : Type u} [CommRing A]
    [CommRing B] [Algebra A B] [Algebra.FiniteType A B]
    (hred : ∀ b : B, ∃ a : A, IsNilpotent (b - algebraMap A B a)) :
    ∃ (m N : ℕ) (Q : Algebra.Generators A B (Fin m)) (a : Fin m → A),
      ∀ j, (Q.val j - algebraMap A B (a j)) ^ N = 0 := by
  obtain ⟨m, ⟨Q⟩⟩ := (Algebra.FiniteType.iff_exists_generators (R := A) (S := B)).mp inferInstance
  classical
  choose a ha using fun j => hred (Q.val j)
  refine ⟨m, ∑ j : Fin m, ((ha j).choose + 1), Q, a, fun j => ?_⟩
  refine pow_eq_zero_of_le ?_ (ha j).choose_spec
  calc (ha j).choose ≤ (ha j).choose + 1 := Nat.le_succ _
    _ ≤ ∑ k : Fin m, ((ha k).choose + 1) :=
        Finset.single_le_sum (f := fun k : Fin m => (ha k).choose + 1)
          (fun k _ => Nat.zero_le _) (Finset.mem_univ j)

end Algebra

end
