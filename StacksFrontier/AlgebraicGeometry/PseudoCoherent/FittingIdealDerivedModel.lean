module

public import StacksFrontier.AlgebraicGeometry.PseudoCoherent.FittingIdeal

/-!
# Finite free models up to isomorphism in the derived category

The local situation in the hypothesis of [Stacks, Tag 0ESP] is that `E|_U` is represented by a
bounded-above complex of finite free `𝒪_U`-modules: an *isomorphism in `D(𝒪_U)`*, not a map of
complexes. `AlgebraicGeometry.FreeModel` records a model together with a map of complexes to the
given complex which is a quasi-isomorphism over `U`; this file records the model together with
an isomorphism in `D(𝒪_U)` only, which is what a pseudo-coherent object provides locally, and
builds the Fitting ideal sheaf out of such models.

## Main definitions

* `AlgebraicGeometry.Scheme.Modules.IsoOverOpen`: two complexes whose restrictions to an open
  `U` are isomorphic in `D(𝒪_U)`.
* `AlgebraicGeometry.DerivedFreeModel`: a bounded-above finite free model, over an open `U`, of
  a complex of `𝒪_X`-modules, up to isomorphism in `D(𝒪_U)`.
* `AlgebraicGeometry.fittingIdealSheafOfDerivedModels`: the `(p, k)`-th Fitting ideal sheaf of
  an object of `D(𝒪_X)`, computed from such models.

## Main results

* `AlgebraicGeometry.ideal_fittingIdealSheafOfDerivedModels_le`: on an affine open carrying such
  a model of a complex representing `E`, the Fitting ideal sheaf is contained in the ideal of
  minors prescribed by the source.

## References

* [Stacks Project, Tag 0ESP](https://stacks.math.columbia.edu/tag/0ESP)
-/

@[expose] public section

namespace AlgebraicGeometry

open CategoryTheory CategoryTheory.Limits TopologicalSpace
open scoped AlgebraicGeometry

noncomputable section

universe u w

/-- Two complexes of `𝒪_X`-modules whose restrictions to an open `U` are isomorphic in the
derived category `D(𝒪_U)`: the relation "`C|_U` represents `D|_U`" of [Stacks, Tag 0ESP]. The
derived category of `𝒪_U`-modules is the standard one,
`CategoryTheory.HasDerivedCategory.standard`; any two choices are canonically equivalent, so the
relation does not depend on it. -/
def Scheme.Modules.IsoOverOpen {X : Scheme.{u}} (U : X.Opens)
    (C D : CochainComplex X.Modules ℤ) : Prop :=
  letI := HasDerivedCategory.standard (U.toScheme).Modules
  Nonempty (DerivedCategory.Q.obj (Scheme.Modules.restrictComplex C U) ≅
    DerivedCategory.Q.obj (Scheme.Modules.restrictComplex D U))

/-- The relation is reflexive. -/
theorem Scheme.Modules.isoOverOpen_refl {X : Scheme.{u}} (U : X.Opens)
    (C : CochainComplex X.Modules ℤ) : Scheme.Modules.IsoOverOpen U C C :=
  ⟨Iso.refl _⟩

/-- A bounded-above finite free model of a complex of `𝒪_X`-modules over an open `U`, up to
isomorphism in `D(𝒪_U)`: a complex of `𝒪_X`-modules which over `U` is finite free in each degree
and vanishes above `top`, together with chosen bases of its sections over `U` and an isomorphism,
in `D(𝒪_U)`, between its restriction to `U` and the restriction of the given complex. This is
the local situation in the hypothesis of [Stacks, Tag 0ESP]: `E|_U` is represented by a
bounded-above complex of finite free `𝒪_U`-modules. -/
structure DerivedFreeModel {X : Scheme.{u}} (K : CochainComplex X.Modules ℤ) (U : X.Opens) where
  /-- The modelling complex. -/
  model : CochainComplex X.Modules ℤ
  /-- The rank of the model in degree `i`. -/
  rank : ℤ → ℕ
  /-- A degree above which the model vanishes over `U`. -/
  top : ℤ
  /-- The model vanishes above `top`. -/
  rank_eq_zero_of_top_lt : ∀ i : ℤ, top < i → rank i = 0
  /-- Over `U` the model is free of rank `rank i` in degree `i`. -/
  isFree : ∀ i : ℤ, Nonempty ((Scheme.Modules.restrictFunctor U.ι).obj (model.X i) ≅
    SheafOfModules.free (R := (U.toScheme).ringCatSheaf) (ULift.{u} (Fin (rank i))))
  /-- The chosen basis of the sections of the model over `U` in degree `i`. -/
  basis : ∀ i : ℤ, Module.Basis (Fin (rank i)) Γ(X, U) Γ(model.X i, U)
  /-- Over `U` the model represents the given complex. -/
  derivedIso : Scheme.Modules.IsoOverOpen U model K

namespace DerivedFreeModel

variable {X : Scheme.{u}} {K : CochainComplex X.Modules ℤ} {U : X.Opens}

/-- The matrix of the differential of the model in degree `p`, in the chosen bases of its
sections over `U`. -/
noncomputable def matrix (M : DerivedFreeModel K U) (p : ℤ) :
    Matrix (Fin (M.rank (p + 1))) (Fin (M.rank p)) Γ(X, U) :=
  LinearMap.toMatrix (M.basis p) (M.basis (p + 1))
    ((M.model.d p (p + 1)).val.app (Opposite.op U)).hom

/-- The bounded-above complex of finite free `Γ(X, U)`-modules that a model over `U` presents:
its ranks and the matrices of its differentials. -/
noncomputable def toFreeData (M : DerivedFreeModel K U) :
    Stacks.FittingComplex.FreeData Γ(X, U) where
  rank := M.rank
  top := M.top
  rank_eq_zero_of_top_lt := M.rank_eq_zero_of_top_lt
  d := M.matrix

/-- The `(p, k)`-th Fitting ideal computed from a model over `U`: the ideal of `Γ(X, U)`
generated by the minors of the matrix of `d_p` of the size prescribed by the alternating sum of
the ranks above `p`. -/
noncomputable def fittingIdeal (M : DerivedFreeModel K U) (p k : ℤ) : Ideal Γ(X, U) :=
  M.toFreeData.fittingIdeal p k

/-- The Fitting ideal computed from a model over `U` is the ideal generated by the minors of the
matrix of `d_p` of size `minorSize p k`. -/
theorem fittingIdeal_eq (M : DerivedFreeModel K U) (p k : ℤ) :
    M.fittingIdeal p k =
      minorIdeal (M.matrix p) (M.toFreeData.minorSize p k).toNat := rfl

/-- The Fitting ideal computed from a model is finitely generated. -/
theorem fittingIdeal_fg (M : DerivedFreeModel K U) (p k : ℤ) : (M.fittingIdeal p k).FG :=
  M.toFreeData.fittingIdeal_fg p k

end DerivedFreeModel

/-- **Stacks Project, Tag 0ESP**, the ideal sheaf. The `(p, k)`-th Fitting ideal sheaf of an
object `E` of `D(𝒪_X)`: the largest quasi-coherent sheaf of ideals which on every affine open
`U` is contained in the ideal of minors of `d_p` computed from every bounded-above finite free
complex representing `E|_U` in `D(𝒪_U)`. -/
noncomputable def fittingIdealSheafOfDerivedModels {X : Scheme.{u}}
    [HasDerivedCategory.{w} X.Modules] (E : DerivedCategory X.Modules) (p k : ℤ) :
    X.IdealSheafData :=
  Scheme.IdealSheafData.ofIdeals fun U ↦
    ⨅ (K : CochainComplex X.Modules ℤ) (_ : Nonempty (DerivedCategory.Q.obj K ≅ E))
      (M : DerivedFreeModel K U.1), M.fittingIdeal p k

/-- On an affine open `U` over which a complex representing `E` has a finite free model up to
isomorphism in `D(𝒪_U)`, the Fitting ideal sheaf is contained in the ideal generated by the
minors of the matrix of `d_p` of size `-k + n_{p+1} - n_{p+2} + ⋯ + (-1)^{b-p+1} n_b`. -/
theorem ideal_fittingIdealSheafOfDerivedModels_le {X : Scheme.{u}}
    [HasDerivedCategory.{w} X.Modules] (E : DerivedCategory X.Modules) (p k : ℤ)
    (U : X.affineOpens) (K : CochainComplex X.Modules ℤ)
    (hK : Nonempty (DerivedCategory.Q.obj K ≅ E)) (M : DerivedFreeModel K U.1) :
    (fittingIdealSheafOfDerivedModels E p k).ideal U ≤
      minorIdeal (M.matrix p) (M.toFreeData.minorSize p k).toNat :=
  (Scheme.IdealSheafData.ideal_ofIdeals_le _ U).trans
    ((iInf_le _ K).trans ((iInf_le _ hK).trans (iInf_le _ M)))

end

end AlgebraicGeometry

end
