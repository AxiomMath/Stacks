module

public import StacksFrontier.AlgebraicGeometry.PseudoCoherent.FittingIdealFreeModelExistence
public import StacksFrontier.AlgebraicGeometry.PseudoCoherent.FittingIdealSheafValue
public import StacksFrontier.AlgebraicGeometry.PseudoCoherent.FittingIdealStalkIndependence

/-!
# The Fitting ideal sheaf of a pseudo-coherent complex, and its local description

[Stacks, Tag 0ESP] attaches to a pseudo-coherent object `E` of `D(𝒪_X)` and integers `p`, `k` a
finite type quasi-coherent sheaf of ideals `Fit_{p,k}(E) ⊆ 𝒪_X` characterized by the property that
on an open `U` over which `E` is isomorphic to a bounded-above complex of finite free modules
`⋯ → 𝒪_U^{n_{b-1}} → 𝒪_U^{n_b} → 0` its restriction is *generated by* the minors of the matrix of
`d_p` of size `-k + n_{p+1} - n_{p+2} + ⋯ + (-1)^{b-p+1} n_b`. This file proves that, for `E`
pseudo-coherent, with `Fit_{p,k}(E)` the ideal sheaf
`AlgebraicGeometry.fittingIdealSheafOfDerivedModels`.

`AlgebraicGeometry.fittingIdealSheafOfDerivedModels` is `Scheme.IdealSheafData.ofIdeals` applied to
the family of those ideals of minors, so the inclusion
`AlgebraicGeometry.ideal_fittingIdealSheafOfDerivedModels_le` is free and the content is the
reverse one. `ofIdeals` recovers a family exactly when the family is the family of ideals of a
quasi-coherent ideal sheaf, and
`StacksFrontier/AlgebraicGeometry/PseudoCoherent/FittingIdealSheafValue.lean` reduces that to two
inputs, both of which are theorems:

* **independence** — the ideal of minors over an affine open depends on neither the model nor the
  representing complex. This is the whole content of the source's proof — reduce to the local
  rings, split off trivial two-term complexes, compare the resulting minimal complexes — and it is
  `AlgebraicGeometry.DerivedFreeModel.fittingIdeal_eq_of_isAffineOpen`, proved in
  `StacksFrontier/AlgebraicGeometry/PseudoCoherent/FittingIdealStalkIndependence.lean`.
* **existence** — every affine open carries a bounded-above finite free model of a complex
  representing `E`. This is the sentence "such local free resolutions exist" of the source's
  proof, and it is `AlgebraicGeometry.nonempty_freeModel_of_isAffineOpen`, proved from
  pseudo-coherence in
  `StacksFrontier/AlgebraicGeometry/PseudoCoherent/FittingIdealFreeModelExistence.lean`.

## Main results

* `AlgebraicGeometry.fittingIdeal_indep`: the ideal of minors over an affine open depends on
  neither the model nor the representing complex.
* `AlgebraicGeometry.exists_freeModel_affineOpens_of_isPseudoCoherent`: every affine open carries
  a complex representing `E` together with a bounded-above finite free model of it there.
* `AlgebraicGeometry.ideal_fittingIdealSheafOfDerivedModels_eq_minorIdeal_of_isPseudoCoherent`:
  **the local description of [Stacks, Tag 0ESP] as an equality** — on an affine open with a
  bounded-above finite free model of a complex representing `E`, the Fitting ideal sheaf *is* the
  ideal generated by the minors of the matrix of `d_p` of size
  `-k + n_{p+1} - n_{p+2} + ⋯ + (-1)^{b-p+1} n_b`.
* `AlgebraicGeometry.ideal_fittingIdealSheafOfDerivedModels_eq_map_minorIdeal_of_isPseudoCoherent`:
  the same over an arbitrary open — on every affine open inside it, the Fitting ideal sheaf is
  generated by the images of those minors.
* `AlgebraicGeometry.isFiniteType_fittingIdealSheafOfDerivedModels_of_isPseudoCoherent`: the
  Fitting ideal sheaf is of finite type.
* `AlgebraicGeometry.fittingIdealSheafOfDerivedModels_isFiniteType_and_ideal_eq_minorIdeal`:
  **[Stacks, Tag 0ESP]** — the three together.

## References

* [Stacks Project, Tag 0ESP](https://stacks.math.columbia.edu/tag/0ESP)
-/

@[expose] public section

namespace AlgebraicGeometry

open CategoryTheory CategoryTheory.Limits TopologicalSpace
open scoped AlgebraicGeometry

noncomputable section

universe u w

variable {X : Scheme.{u}} [HasDerivedCategory.{w} X.Modules]

/-- The chosen derived category of `𝒪_X`-modules, read in the `StrictlyPerfect.OXMod` spelling of
that category in which pseudo-coherence is phrased. The two spellings are the same category, but
instance search does not cross between them. -/
local instance hasDerivedCategory_oxmod :
    HasDerivedCategory.{w} (StrictlyPerfect.OXMod.{u, u, u} X.toRingedSpace) :=
  inferInstanceAs (HasDerivedCategory.{w} X.Modules)

/-- **The ideal of minors of a bounded-above finite free model over an affine open depends on
neither the model nor the representing complex.** -/
theorem fittingIdeal_indep (E : DerivedCategory X.Modules) (p k : ℤ)
    (V : X.affineOpens) (K₁ : CochainComplex X.Modules ℤ)
    (h₁ : Nonempty (DerivedCategory.Q.obj K₁ ≅ E)) (M₁ : DerivedFreeModel K₁ V.1)
    (K₂ : CochainComplex X.Modules ℤ) (h₂ : Nonempty (DerivedCategory.Q.obj K₂ ≅ E))
    (M₂ : DerivedFreeModel K₂ V.1) : M₁.fittingIdeal p k = M₂.fittingIdeal p k :=
  DerivedFreeModel.fittingIdeal_eq_of_isAffineOpen V.2 E h₁.some h₂.some M₁ M₂ p k

/-- **`E` has, on every affine open, the shape the statement of [Stacks, Tag 0ESP] describes**:
every affine open carries a complex representing `E` together with a bounded-above finite free
model of it there. This is the sentence "such local free resolutions exist" of the source's
proof. -/
theorem exists_freeModel_affineOpens_of_isPseudoCoherent (E : DerivedCategory X.Modules)
    (hE : RingedSpace.IsPseudoCoherent (X := X.toRingedSpace) E) :
    ∀ V : X.affineOpens, ∃ K : CochainComplex X.Modules ℤ,
      Nonempty (DerivedCategory.Q.obj K ≅ E) ∧ Nonempty (DerivedFreeModel K V.1) := by
  obtain ⟨K, hK, eK⟩ := hE
  exact fun V => ⟨K, eK, nonempty_freeModel_of_isAffineOpen V.2 K hK⟩

/-- **Stacks Project, Tag 0ESP**, the local description of the Fitting ideal sheaf of a
pseudo-coherent object of `D(𝒪_X)` as an equality: on an affine open `U` over which a complex
representing `E` has a bounded-above finite free model, the Fitting ideal sheaf *is* the ideal
generated by the minors of the matrix of `d_p` of size
`-k + n_{p+1} - n_{p+2} + ⋯ + (-1)^{b-p+1} n_b`. In particular that ideal is the same for every
model and every representing complex. -/
theorem ideal_fittingIdealSheafOfDerivedModels_eq_minorIdeal_of_isPseudoCoherent
    (E : DerivedCategory X.Modules)
    (hE : RingedSpace.IsPseudoCoherent (X := X.toRingedSpace) E) (p k : ℤ) (U : X.affineOpens)
    (K : CochainComplex X.Modules ℤ) (hK : Nonempty (DerivedCategory.Q.obj K ≅ E))
    (M : DerivedFreeModel K U.1) :
    (fittingIdealSheafOfDerivedModels E p k).ideal U =
      minorIdeal (M.matrix p) (M.toFreeData.minorSize p k).toNat :=
  ideal_fittingIdealSheafOfDerivedModels_eq_minorIdeal_of_indep E p k
    (exists_freeModel_affineOpens_of_isPseudoCoherent E hE) (fittingIdeal_indep E p k) U K hK M

/-- **The Fitting ideal sheaf of a pseudo-coherent object of `D(𝒪_X)` is of finite type.** On an
affine open it is the ideal of minors of one model, and an ideal generated by the minors of a
fixed size of a matrix with finitely many rows and columns is finitely generated. -/
theorem isFiniteType_fittingIdealSheafOfDerivedModels_of_isPseudoCoherent
    (E : DerivedCategory X.Modules)
    (hE : RingedSpace.IsPseudoCoherent (X := X.toRingedSpace) E) (p k : ℤ) :
    (fittingIdealSheafOfDerivedModels E p k).IsFiniteType :=
  isFiniteType_fittingIdealSheafOfDerivedModels_of_indep E p k
    (exists_freeModel_affineOpens_of_isPseudoCoherent E hE) (fittingIdeal_indep E p k)

/-- **Stacks Project, Tag 0ESP** over an arbitrary open: on every affine open `V` inside an open
`U` over which a complex representing `E` has a bounded-above finite free model, the Fitting ideal
sheaf is the ideal generated by the images of the minors of the matrix of `d_p`. A quasi-coherent
sheaf of ideals is its family of ideals on the affine opens, so this says that
`Fit_{p,k}(E)|_U` is generated by those minors, for `U` an arbitrary open.

The model over `U` restricts to one over `V` whose matrix is the entrywise image of the one over
`U` (`AlgebraicGeometry.DerivedFreeModel.exists_restrict`), and the ideal of minors commutes with
that base change. -/
theorem ideal_fittingIdealSheafOfDerivedModels_eq_map_minorIdeal_of_isPseudoCoherent
    (E : DerivedCategory X.Modules)
    (hE : RingedSpace.IsPseudoCoherent (X := X.toRingedSpace) E) (p k : ℤ) {U : X.Opens}
    (K : CochainComplex X.Modules ℤ) (hK : Nonempty (DerivedCategory.Q.obj K ≅ E))
    (M : DerivedFreeModel K U) (V : X.affineOpens) (hVU : V.1 ≤ U) :
    (fittingIdealSheafOfDerivedModels E p k).ideal V =
      Ideal.map (X.presheaf.map (homOfLE hVU).op).hom
        (minorIdeal (M.matrix p) (M.toFreeData.minorSize p k).toNat) := by
  obtain ⟨M', -, -, hM'⟩ := M.exists_restrict hVU
  rw [ideal_fittingIdealSheafOfDerivedModels_eq_minorIdeal_of_isPseudoCoherent E hE p k V K hK M',
    ← M'.fittingIdeal_eq p k, hM' p k, M.fittingIdeal_eq p k]

/-- **Stacks Project, Tag 0ESP.** Let `X` be a scheme and let `E` be a pseudo-coherent object of
`D(𝒪_X)`. For all integers `p`, `k` the Fitting ideal sheaf `Fit_{p,k}(E) ⊆ 𝒪_X` is a finite type
quasi-coherent sheaf of ideals whose restriction to an open `U` over which `E` is isomorphic to a
bounded-above complex of finite free modules `⋯ → 𝒪_U^{n_{b-1}} → 𝒪_U^{n_b} → 0` is generated by
the minors of the matrix of `d_p` of size `-k + n_{p+1} - n_{p+2} + ⋯ + (-1)^{b-p+1} n_b`: on an
affine `U` it is the ideal of those minors, and on an arbitrary `U` it is, over every affine open
inside `U`, the ideal generated by their images. In particular the ideal of minors is the same for
every such complex and every such model, which is the independence the source's proof
establishes. -/
@[stacks 0ESP "the finite type ideal sheaf Fit_{p,k}(E) and the minors of d_p generating it"]
theorem fittingIdealSheafOfDerivedModels_isFiniteType_and_ideal_eq_minorIdeal
    (E : DerivedCategory X.Modules)
    (hE : RingedSpace.IsPseudoCoherent (X := X.toRingedSpace) E) (p k : ℤ) :
    (fittingIdealSheafOfDerivedModels E p k).IsFiniteType ∧
      (∀ (U : X.affineOpens) (K : CochainComplex X.Modules ℤ)
        (_ : Nonempty (DerivedCategory.Q.obj K ≅ E)) (M : DerivedFreeModel K U.1),
        (fittingIdealSheafOfDerivedModels E p k).ideal U =
          minorIdeal (M.matrix p) (M.toFreeData.minorSize p k).toNat) ∧
      ∀ (U : X.Opens) (K : CochainComplex X.Modules ℤ)
        (_ : Nonempty (DerivedCategory.Q.obj K ≅ E)) (M : DerivedFreeModel K U)
        (V : X.affineOpens) (hVU : V.1 ≤ U),
        (fittingIdealSheafOfDerivedModels E p k).ideal V =
          Ideal.map (X.presheaf.map (homOfLE hVU).op).hom
            (minorIdeal (M.matrix p) (M.toFreeData.minorSize p k).toNat) :=
  ⟨isFiniteType_fittingIdealSheafOfDerivedModels_of_isPseudoCoherent E hE p k,
    fun U K hK M =>
      ideal_fittingIdealSheafOfDerivedModels_eq_minorIdeal_of_isPseudoCoherent E hE p k U K hK M,
    fun _ K hK M V hVU =>
      ideal_fittingIdealSheafOfDerivedModels_eq_map_minorIdeal_of_isPseudoCoherent E hE p k K hK M V
        hVU⟩

end

end AlgebraicGeometry

end
