module

public import StacksFrontier.AlgebraicGeometry.PseudoCoherent.FittingIdeal
public import StacksFrontier.RingTheory.Fitting.Basic
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The Fitting ideal of a complex is a Fitting ideal of the cokernel of its differential

Let `R` be a commutative ring and let `F^•` be a bounded-above complex of finite free
`R`-modules, recorded as a `Stacks.FittingComplex.FreeData R`. Its `(p, k)`-th Fitting ideal is
the ideal generated by the minors of the matrix of `d_p` of size
`-k + n_{p+1} - n_{p+2} + ⋯`. The columns of that matrix span the image of `d_p`, so the matrix
is a finite free presentation of `Coker(d_p)` with `n_{p+1}` generators, and the Fitting ideal of
a finite module at index `j` is generated by the `(n - j) × (n - j)` minors of any presentation
with `n` generators. Since

`n_{p+1} - (-k + n_{p+1} - n_{p+2} + ⋯) = k + n_{p+2} - n_{p+3} + ⋯`,

the `(p, k)`-th Fitting ideal of the complex is the Fitting ideal of `Coker(d_p)` at the index
`k + n_{p+2} - n_{p+3} + ⋯`, the alternating sum of the ranks above `p + 1` shifted by `k`.

## Main results

* `Stacks.FittingComplex.FreeData.tailAlternatingRank_succ`: the recursion
  `n_{p+1} - n_{p+2} + ⋯ = n_{p+1} - (n_{p+2} - n_{p+3} + ⋯)` for the alternating sum of the
  ranks above a degree.
* `Stacks.FittingComplex.FreeData.minorSize_eq_sub_tailAlternatingRank_succ`: hence the
  prescribed size of the minors of `d_p` is `n_{p+1}` minus the shifted index.
* `Stacks.FittingComplex.FreeData.fittingIdeal_eq_fittingIdeal_cokernel`: the `(p, k)`-th Fitting
  ideal of the complex is the Fitting ideal of `Coker(d_p)` at the shifted index.
* `AlgebraicGeometry.FreeModel.minorIdeal_matrix_eq_fittingIdeal_cokernel`: the same statement for
  the ideal of minors read off a bounded-above finite free model over an open subscheme.

## Implementation notes

The index of `AlgebraicGeometry.fittingIdeal` and of `fittingIdeal` is an integer, and the two
conventions at the ends of the range are what make the statement hold with no side condition on
`k`. When the shifted index is negative the Fitting ideal of the module is the zero ideal by
`fittingIdeal_eq_bot_of_lt_zero`, and the prescribed size of the minors then exceeds the number
of rows of the matrix, so the ideal of minors vanishes too by `minorIdeal_eq_bot_of_card_lt`.
When the shifted index exceeds `n_{p+1}` the prescribed size is nonpositive, the truncated
subtraction in the module-level formula gives `0`, and both sides are the unit ideal.

## References

* [Stacks Project, Tag 0ESQ](https://stacks.math.columbia.edu/tag/0ESQ)
* [Stacks Project, Tag 0ESP](https://stacks.math.columbia.edu/tag/0ESP)
* [Stacks Project, Tag 07Z9](https://stacks.math.columbia.edu/tag/07Z9)
-/

@[expose] public section

namespace Stacks.FittingComplex.FreeData

universe u

variable {R : Type u} [CommRing R] (C : FreeData R)

/-- The alternating sum of the ranks above `p` satisfies the recursion
`n_{p+1} - n_{p+2} + ⋯ = n_{p+1} - (n_{p+2} - n_{p+3} + ⋯)`: peeling off the first term of the
alternating sum flips the sign of the remaining tail. -/
theorem tailAlternatingRank_succ (p : ℤ) :
    C.tailAlternatingRank p = (C.rank (p + 1) : ℤ) - C.tailAlternatingRank (p + 1) := by
  rcases le_or_gt C.top p with hp | hp
  · rw [C.tailAlternatingRank_of_top_le hp,
      C.tailAlternatingRank_of_top_le (by omega : C.top ≤ p + 1),
      C.rank_eq_zero_of_top_lt (p + 1) (by omega)]
    simp
  · have hlen : (C.top - p).toNat = (C.top - (p + 1)).toNat + 1 := by omega
    rw [tailAlternatingRank, tailAlternatingRank, hlen, Finset.sum_range_succ']
    have hshift : ∀ j ∈ Finset.range (C.top - (p + 1)).toNat,
        (-1 : ℤ) ^ (j + 1) * (C.rank (p + 1 + (j + 1 : ℕ)) : ℤ) =
          -((-1 : ℤ) ^ j * (C.rank (p + 1 + 1 + j) : ℤ)) := by
      intro j _
      have hdeg : p + 1 + ((j : ℤ) + 1) = p + 1 + 1 + j := by ring
      rw [pow_succ]
      push_cast
      rw [hdeg]
      ring
    rw [Finset.sum_congr rfl hshift, Finset.sum_neg_distrib]
    push_cast
    ring_nf

/-- The prescribed size of the minors of `d_p` cutting out the `(p, k)`-th Fitting ideal is the
rank in degree `p + 1` minus the index `k + n_{p+2} - n_{p+3} + ⋯`. -/
theorem minorSize_eq_sub_tailAlternatingRank_succ (p k : ℤ) :
    C.minorSize p k = (C.rank (p + 1) : ℤ) - (C.tailAlternatingRank (p + 1) + k) := by
  rw [minorSize, C.tailAlternatingRank_succ p]
  ring

/-- **The Fitting ideal of a complex is a Fitting ideal of the cokernel of its differential.**
The `(p, k)`-th Fitting ideal of the complex — the ideal of minors of `d_p` of size
`-k + n_{p+1} - n_{p+2} + ⋯` — is the Fitting ideal of `Coker(d_p)` at the index
`k + n_{p+2} - n_{p+3} + ⋯`. -/
@[sga "7 VI 4.16" "special case"]
theorem fittingIdeal_eq_fittingIdeal_cokernel (p k : ℤ) :
    C.fittingIdeal p k =
      _root_.fittingIdeal (R := R)
        (M := (Fin (C.rank (p + 1)) → R) ⧸
          Submodule.span R (Set.range fun j : Fin (C.rank p) => fun i => C.d p i j))
        (C.tailAlternatingRank (p + 1) + k) := by
  have hsize := C.minorSize_eq_sub_tailAlternatingRank_succ p k
  rcases lt_or_ge (C.tailAlternatingRank (p + 1) + k) 0 with hneg | hpos
  · rw [_root_.fittingIdeal_eq_bot_of_lt_zero hneg, FreeData.fittingIdeal]
    refine minorIdeal_eq_bot_of_card_lt _ _ (Or.inl ?_)
    simp only [Fintype.card_fin]
    omega
  · obtain ⟨jn, hjn⟩ := Int.eq_ofNat_of_zero_le hpos
    rw [hjn, _root_.fittingIdeal_eq_minorIdeal_of_presentation (C.d p) jn (LinearEquiv.refl _ _),
      FreeData.fittingIdeal]
    congr 1
    omega

end Stacks.FittingComplex.FreeData

namespace AlgebraicGeometry

open CategoryTheory Stacks.FittingComplex

universe u

/-- **The ideal of minors read off a bounded-above finite free model is a Fitting ideal of the
cokernel of the model's differential.** -/
theorem FreeModel.minorIdeal_matrix_eq_fittingIdeal_cokernel {X : Scheme.{u}}
    {K : CochainComplex X.Modules ℤ} {V : X.Opens} (M : FreeModel K V) (p k : ℤ) :
    minorIdeal (M.matrix p) (M.toFreeData.minorSize p k).toNat =
      _root_.fittingIdeal (R := Γ(X, V))
        (M := (Fin (M.rank (p + 1)) → Γ(X, V)) ⧸
          Submodule.span Γ(X, V)
            (Set.range fun j : Fin (M.rank p) => fun i => M.matrix p i j))
        (M.toFreeData.tailAlternatingRank (p + 1) + k) :=
  M.toFreeData.fittingIdeal_eq_fittingIdeal_cokernel p k

end AlgebraicGeometry

end
