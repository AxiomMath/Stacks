module

public import StacksFrontier.AlgebraicGeometry.Blowup.ExceptionalChart
public import StacksFrontier.RingTheory.AffineBlowup.ChartEquiv
public import StacksFrontier.RingTheory.AffineBlowup.ModelComparison

/-!
# The affine charts of a blowup in the quotient model of `R[I/a]`

The affine charts of a blowup are available as `Stacks.Blowup.blowUpAffineChart`, whose source is
the spectrum of `affineBlowup (ℐ(U)) a`, the *subalgebra* model of `R[I/a]` inside
`Localization.Away a`. The affine flattening engine of [Stacks, Tag 0810] — whose scheme-level
form is `Stacks.StrictTransform.exists_fg_ideal_forall_chartFreeOfRank` — speaks instead about
the *quotient* model `Blowup (ℐ(U)) a` of formal fractions `x/aⁿ`. This file carries the charts
across that change of model, so that a chart of the blowup is available with the same ring the
engine's conclusion is stated for.

## Main definitions

* `Stacks.Blowup.blowUpChartModelIso`: the change of model, as an isomorphism of chart rings in
  `CommRingCat`.
* `Stacks.Blowup.blowUpQuotientChart`: the affine chart `Spec Γ(S, U)[ℐ(U)/a] ⟶ Bl_ℐ(S)` of a
  blowup, with the chart ring in the quotient model.

## Main results

* `Stacks.AffineBlowup.affineBlowupAlgebra_eq_affineBlowup`: the two subalgebras of
  `Localization.Away a` modelling `R[I/a]` are equal.
* `Stacks.AffineBlowup.blowupEquivAffineBlowup_symm_commutes`: the inverse of the change of model
  carries the image of `r : R` in the subalgebra model to its image in the quotient model.
* `Stacks.Blowup.blowUpQuotientChart_blowUpToBase`: the composite of the chart with the structure
  morphism of the blowup is `Spec` of the structure map `Γ(S, U) ⟶ Γ(S, U)[ℐ(U)/a]` of the
  quotient model, followed by the inclusion of the affine open `U`.
* `Stacks.Blowup.iSup_opensRange_blowUpQuotientChart` and
  `Stacks.Blowup.exists_blowUpQuotientChart_preimage`: the preimage of `U` in the blowup is
  covered by the images of these charts, and so every point of the blowup over `U` lies in one of
  them. This is [Stacks, Tag 0804] read in the quotient model.

## Implementation notes

The change of model itself is `Stacks.AffineBlowup.blowupEquivAffineBlowup` of
`StacksFrontier/RingTheory/AffineBlowup/ModelComparison.lean`, which identifies the quotient model
`Blowup I a` with the subalgebra `affineBlowup I a` of `Localization.Away a` as `R`-algebras. It
is a ring isomorphism, so the chart is `Stacks.Blowup.blowUpAffineChart` precomposed with
`Spec` of its inverse, and each statement below is the corresponding statement for
`Stacks.Blowup.blowUpAffineChart` transported along that isomorphism. The transport of the
compatibility with the structure morphism uses only that the isomorphism is one of `R`-algebras,
through `AlgEquiv.commutes`.

The ring structure of the quotient model needs `a ∈ I`, so that hypothesis is carried as a
`Fact` instance: it already appears in the type of the chart, not only in its construction.

The blowup here is `Stacks.Blowup.blowUp`, the construction the charts of [Stacks, Tag 0804] and
`Stacks.Blowup.IsAdmissibleBlowup` are phrased with, and not `AlgebraicGeometry.blowUp`, which
the strict transform of [Stacks, Tag 080D] is phrased with. The transport to the latter along
`Stacks.Blowup.blowUpIso` is in
`StacksFrontier.AlgebraicGeometry.StrictTransform.QuotientModelBaseChangeChart`.

The equality of the two subalgebra models is `affineBlowup_mem_iff` against
`Stacks.AffineBlowup.mem_affineBlowupAlgebra`: both describe the fractions `x/aⁿ` with `x ∈ Iⁿ`,
the first as an equation `z = x/aⁿ` and the second as the cleared equation `z·aⁿ = x`, and
`Stacks.AffineBlowup.eq_awayDiv_iff` is the passage between them.

## References

* [Stacks Project, Tag 0804](https://stacks.math.columbia.edu/tag/0804)
* [Stacks Project, Tag 0810](https://stacks.math.columbia.edu/tag/0810)
* [Stacks Project, Tag 052Q](https://stacks.math.columbia.edu/tag/052Q)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace Stacks.AffineBlowup

variable {R : Type*} [CommRing R] {I : Ideal R} {a : R}

/-- **The two subalgebra models of `R[I/a]` agree.** For `a ∈ I` the subalgebra
`Stacks.AffineBlowup.affineBlowupAlgebra I a ha` of `Localization.Away a`, defined by the cleared
equation `z·aⁿ = x` with `x ∈ Iⁿ`, is the subalgebra `affineBlowup I a` generated by the
fractions `x/a` with `x ∈ I`.

Both are the set of fractions `x/aⁿ` with `x ∈ Iⁿ`: for the second this is
`affineBlowup_mem_iff`, and `Stacks.AffineBlowup.eq_awayDiv_iff` turns the equation
`z = x/aⁿ` into the cleared one. -/
public theorem affineBlowupAlgebra_eq_affineBlowup (ha : a ∈ I) :
    affineBlowupAlgebra I a ha = affineBlowup I a := by
  refine SetLike.ext fun z ↦ ?_
  rw [mem_affineBlowupAlgebra ha, affineBlowup_mem_iff I a ha]
  refine ⟨fun ⟨n, x, hx, h⟩ ↦ ⟨n, x, hx, ?_⟩, fun ⟨n, x, hx, h⟩ ↦ ⟨n, x, hx, ?_⟩⟩
  · rw [Localization.mk_eq_mk']
    exact (eq_awayDiv_iff a).mpr h
  · rw [h, Localization.mk_eq_mk']
    exact awayDiv_mul_pow a n x

variable [ha : Fact (a ∈ I)]

/-- The inverse of the bridge to `affineBlowup I a` is an `R`-algebra map: it carries the image
of `r : R` in the subalgebra model to its image in the quotient model. -/
public theorem blowupEquivAffineBlowup_symm_commutes (r : R) :
    (blowupEquivAffineBlowup (I := I) (a := a)).symm (algebraMap R (affineBlowup I a) r)
      = algebraMap R (Blowup I a) r :=
  (blowupEquivAffineBlowup (I := I) (a := a)).symm.commutes r

end Stacks.AffineBlowup

namespace Stacks.Blowup

variable {S : Scheme.{u}} (ℐ : S.IdealSheafData) (U : S.affineOpens) (a : Γ(S, U.1))
  [ha : Fact (a ∈ ℐ.ideal U)]

/-- The change-of-model isomorphism of chart rings, as an isomorphism in `CommRingCat`. -/
public noncomputable def blowUpChartModelIso :
    CommRingCat.of (Blowup (ℐ.ideal U) a) ≅ CommRingCat.of (affineBlowup (ℐ.ideal U) a) :=
  (Stacks.AffineBlowup.blowupEquivAffineBlowup
    (I := ℐ.ideal U) (a := a)).toRingEquiv.toCommRingCatIso

/-- **The affine chart of a blowup, with the chart ring in the quotient model.** For an affine
open `U` of the base and a section `a ∈ ℐ(U)`, this is the chart
`Spec Γ(S, U)[ℐ(U)/a] ⟶ Bl_ℐ(S)` of [Stacks, Tag 0804], with `Γ(S, U)[ℐ(U)/a]` realized as the
quotient model `Blowup (ℐ(U)) a`.

It is `Stacks.Blowup.blowUpAffineChart` precomposed with `Spec` of the change of model. -/
public noncomputable def blowUpQuotientChart :
    Spec (CommRingCat.of (Blowup (ℐ.ideal U) a)) ⟶ blowUp ℐ :=
  Spec.map (blowUpChartModelIso ℐ U a).inv ≫ blowUpAffineChart ℐ U ha.out

/-- The chart in the quotient model is an open immersion: the change of model is an isomorphism,
and `Stacks.Blowup.blowUpAffineChart` is an open immersion. -/
public instance isOpenImmersion_blowUpQuotientChart :
    IsOpenImmersion (blowUpQuotientChart ℐ U a) := by
  have h₁ : IsOpenImmersion (Spec.map (blowUpChartModelIso ℐ U a).inv) :=
    IsOpenImmersion.of_isIso _
  have h₂ : IsOpenImmersion (blowUpAffineChart ℐ U ha.out) := inferInstance
  exact MorphismProperty.comp_mem @IsOpenImmersion _ _ h₁ h₂

/-- The chart in the quotient model has the same image as `Stacks.Blowup.blowUpAffineChart`: the two
differ by an isomorphism of their sources. -/
public theorem opensRange_blowUpQuotientChart :
    (blowUpQuotientChart ℐ U a).opensRange = (blowUpAffineChart ℐ U ha.out).opensRange :=
  Scheme.Hom.opensRange_comp_of_isIso _ _

/-- **The chart in the quotient model, over the base.** The composite
`Spec Γ(S, U)[ℐ(U)/a] ⟶ Bl_ℐ(S) ⟶ S` is `Spec` of the structure map of the quotient model,
followed by the inclusion of the affine open `U`.

This is `Stacks.Blowup.blowUpAffineChart_blowUpToBase` transported along the change of model,
which is an isomorphism of `Γ(S, U)`-algebras. -/
public theorem blowUpQuotientChart_blowUpToBase :
    blowUpQuotientChart ℐ U a ≫ blowUpToBase ℐ
      = Spec.map (CommRingCat.ofHom (algebraMap Γ(S, U.1) (Blowup (ℐ.ideal U) a)))
          ≫ (Stacks.RelativeProj.isAffineOpen U).fromSpec := by
  rw [show blowUpQuotientChart ℐ U a
      = Spec.map (blowUpChartModelIso ℐ U a).inv ≫ blowUpAffineChart ℐ U ha.out from rfl,
    Category.assoc, blowUpAffineChart_blowUpToBase, ← Spec.map_comp_assoc]
  congr 2
  refine CommRingCat.hom_ext (RingHom.ext fun r ↦ ?_)
  exact Stacks.AffineBlowup.blowupEquivAffineBlowup_symm_commutes (I := ℐ.ideal U) (a := a) r

/-- **Stacks Project, Tag 0804, second assertion, in the quotient model.** The preimage of an
affine open `U` of the base in the blowup is covered by the images of the charts
`Spec Γ(S, U)[ℐ(U)/a] ⟶ Bl_ℐ(S)`, `a ∈ ℐ(U)`, with the chart rings in the quotient model. -/
public theorem iSup_opensRange_blowUpQuotientChart :
    ⨆ r : ℐ.ideal U,
        (blowUpQuotientChart ℐ U (r : Γ(S, U.1)) (ha := ⟨r.2⟩)).opensRange
      = blowUpToBase ℐ ⁻¹ᵁ (U : S.Opens) := by
  rw [← iSup_opensRange_blowUpAffineChart ℐ U]
  exact iSup_congr fun r ↦ opensRange_blowUpQuotientChart ℐ U (r : Γ(S, U.1)) (ha := ⟨r.2⟩)

/-- **Every point of the blowup over an affine open is in the image of a chart in the quotient
model.** This is the covering statement
`Stacks.Blowup.iSup_opensRange_blowUpQuotientChart` read pointwise. -/
public theorem exists_blowUpQuotientChart_preimage (s : blowUp ℐ)
    (hs : blowUpToBase ℐ s ∈ (U : S.Opens)) :
    ∃ r : ℐ.ideal U,
      letI : Fact ((r : Γ(S, U.1)) ∈ ℐ.ideal U) := ⟨r.2⟩
      ∃ t : Spec (CommRingCat.of (Blowup (ℐ.ideal U) (r : Γ(S, U.1)))),
        blowUpQuotientChart ℐ U (r : Γ(S, U.1)) t = s := by
  have hmem : s ∈ ⨆ r : ℐ.ideal U,
      (blowUpQuotientChart ℐ U (r : Γ(S, U.1)) (ha := ⟨r.2⟩)).opensRange := by
    rw [iSup_opensRange_blowUpQuotientChart ℐ U]
    exact hs
  obtain ⟨r, hr⟩ := Opens.mem_iSup.mp hmem
  obtain ⟨t, ht⟩ := hr
  exact ⟨r, t, ht⟩

end Stacks.Blowup

end
