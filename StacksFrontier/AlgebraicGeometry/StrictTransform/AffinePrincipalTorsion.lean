module

public import StacksFrontier.AlgebraicGeometry.AffineQcohPushforward.Colimits
public import StacksFrontier.AlgebraicGeometry.Divisors.SupportedSections.Basic
public import StacksFrontier.AlgebraicGeometry.Modules.AffineSections
public import StacksFrontier.AlgebraicGeometry.SupportedQuotient.Basic

/-!
# The quotient by the sections supported on a principal zero locus

Let `R` be a ring, `a : R` and `F` a quasi-coherent module on `Spec R`. The sections of `F`
supported on the zero locus `V(a)` are precisely the `a`-power torsion of `Γ(F, Spec R)`, and so
the quotient of `F` by them is `(Γ(F, Spec R) / a`-power torsion`)^~`.

That is the computation which turns the strict transform of [Stacks, Tag 080D] into the
ring-level strict transform of [Stacks, Tag 0810]: over an affine chart on which the inverse image
of the centre is generated by one element `a`, the geometric quotient by the supported sections
*is* the algebraic quotient by the `a`-power torsion, which is the module the ring-level statement
is about.

## Main definitions

* `AlgebraicGeometry.supportedQuotientZeroLocusTildeIso`: the quotient of a quasi-coherent `F` by
  the sections supported on `V(a)` is `(Γ(F) / a`-power torsion`)^~`.
* `AlgebraicGeometry.tildeSupportedQuotientZeroLocusIso`: the same for `F = M^~`, with the answer
  written in terms of `M` itself.
* `Stacks.quotientTorsionPowersEquiv`: a linear equivalence descends to the quotients by the
  torsion for the powers of a fixed element.

## Main results

* `AlgebraicGeometry.mem_supportedSectionsSubmodule_zeroLocus_span_singleton_iff`: a section of a
  quasi-coherent module on `Spec R` is supported on `V(a)` exactly when a power of `a` kills it.
* `AlgebraicGeometry.range_moduleSpecΓFunctor_map_supportedSectionsι_zeroLocus`: the global
  sections of the supported-sections submodule, as a submodule of `Γ(F)`, are the `a`-power
  torsion.

## Implementation notes

The membership criterion is
`AlgebraicGeometry.mem_supportedSectionsSubmodule_iff_exists_pow_le_annihilator`, the affine-open
description of [Stacks, Tag 07ZP], at the finitely generated ideal `(a)`; passing from "some power
of `(a)` annihilates the section" to "some power of `a` kills it" is `Ideal.span_singleton_pow`.
The scalar action on `Γ(F, ⊤)` used by the tag is the one of `Γ(Spec R, ⊤)` while the one of
`Submodule.torsion'` here is the one of `R`; the two agree by
`AlgebraicGeometry.Scheme.Modules.smul_Spec_def`, the restriction map along `⊤ ≤ ⊤` being the
identity.

For the quotient, the global-sections functor is applied to the defining short exact sequence.
That needs the supported-sections submodule to be quasi-coherent, which is [Stacks, Tag 07ZP]
again (`AlgebraicGeometry.supportedSectionsSubmodule_isQuasicoherent`) and is unconditional here:
`V(a)` is closed and its complement is the basic open of `a`, hence retrocompact. Then
`AlgebraicGeometry.cokernelSpecΓIso` computes the sections of the quotient as the quotient of the
sections, `CategoryTheory.Limits.ModuleCat.cokernelIsoRangeQuotient` presents that as a quotient
by a range, and the range is rewritten into the torsion submodule before the isomorphism is
built, so that no transport across a `Submodule` equality is needed afterwards.

## References

* [Stacks Project, Tag 07ZP](https://stacks.math.columbia.edu/tag/07ZP)
* [Stacks Project, Tag 080D](https://stacks.math.columbia.edu/tag/080D)
* [Stacks Project, Tag 0810](https://stacks.math.columbia.edu/tag/0810)
* [Stacks Project, Tag 084L](https://stacks.math.columbia.edu/tag/084L)
-/

@[expose] public noncomputable section

open CategoryTheory Limits AlgebraicGeometry Opposite TopologicalSpace
open AlgebraicGeometry.Scheme.Modules

universe u v w

namespace Stacks

/-- Membership in the torsion submodule for the powers of `a` unwound: an element is killed by
some power of `a`. -/
public lemma mem_torsion'_powers_iff {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    (a : R) (m : M) :
    m ∈ Submodule.torsion' R M (Submonoid.powers a) ↔ ∃ n : ℕ, a ^ n • m = 0 := by
  rw [Submodule.mem_torsion'_iff]
  exact ⟨fun ⟨⟨_, n, rfl⟩, hm⟩ ↦ ⟨n, hm⟩, fun ⟨n, hn⟩ ↦ ⟨⟨a ^ n, n, rfl⟩, hn⟩⟩

/-- A linear equivalence descends to the quotients by the torsion for the powers of a fixed
element of the base ring. -/
public def quotientTorsionPowersEquiv {R M N : Type*} [CommRing R] [AddCommGroup M]
    [AddCommGroup N] [Module R M] [Module R N] (a : R) (e : M ≃ₗ[R] N) :
    (M ⧸ Submodule.torsion' R M (Submonoid.powers a)) ≃ₗ[R]
      (N ⧸ Submodule.torsion' R N (Submonoid.powers a)) := by
  refine Submodule.Quotient.equiv _ _ e ?_
  refine Submodule.ext fun x ↦ ?_
  rw [Submodule.mem_map, mem_torsion'_powers_iff]
  constructor
  · rintro ⟨y, hy, rfl⟩
    obtain ⟨n, hn⟩ := (mem_torsion'_powers_iff a y).mp hy
    exact ⟨n, by simpa using congrArg e hn⟩
  · rintro ⟨n, hn⟩
    exact ⟨e.symm x, (mem_torsion'_powers_iff a _).mpr ⟨n, by simpa using congrArg e.symm hn⟩,
      by simp⟩

end Stacks

namespace AlgebraicGeometry

variable {R : CommRingCat.{u}}

/-- The zero locus of a single global function on `Spec R`, written as the zero locus of the
principal ideal it generates: the closed subset on which the quotient defining a strict transform
over a blowup chart is taken. -/
public abbrev principalZeroLocus (R : CommRingCat.{u}) (a : R) : Set (Spec R) :=
  (Spec R).zeroLocus (U := ⊤) (Ideal.span {(Scheme.ΓSpecIso R).inv a} : Set Γ(Spec R, ⊤))

/-- The zero locus of `a` is the complement of its basic open. -/
public lemma principalZeroLocus_eq_compl (a : R) :
    principalZeroLocus R a =
      (((Spec R).basicOpen ((Scheme.ΓSpecIso R).inv a)) : Set (Spec R))ᶜ := by
  rw [principalZeroLocus, Scheme.zeroLocus_span, Scheme.zeroLocus_singleton]

/-- The zero locus of `a` is closed. -/
public lemma isClosed_principalZeroLocus (a : R) : IsClosed (principalZeroLocus R a) :=
  (Spec R).zeroLocus_isClosed _

/-- The complement of the zero locus of `a` is retrocompact: it is the basic open of `a`. -/
public lemma isRetrocompact_compl_principalZeroLocus (a : R) :
    IsRetrocompact (principalZeroLocus R a)ᶜ := by
  rw [principalZeroLocus_eq_compl, compl_compl]
  exact isRetrocompact_basicOpen _

/-- **The sections supported on a principal zero locus are the torsion for the powers of its
generator.** A global section of a quasi-coherent module on `Spec R` has all its germs outside
`V(a)` zero exactly when some power of `a` kills it.

This is the affine-open description of [Stacks, Tag 07ZP] at the ideal `(a)`, which is finitely
generated; the passage from a power of the ideal to a power of the element is
`Ideal.span_singleton_pow`. -/
@[stacks 07ZP "the sections supported on V(a) are the a-power torsion"]
public lemma mem_supportedSectionsSubmodule_zeroLocus_span_singleton_iff
    (F : (Spec R).Modules) [F.IsQuasicoherent] (a : R) (s : Γ(F, ⊤)) :
    s ∈ (supportedSectionsSubmodule (principalZeroLocus R a) F).toSubmodule.obj (op ⊤) ↔
      ∃ n : ℕ, a ^ n • s = 0 := by
  have hsmul (n : ℕ) : ((Scheme.ΓSpecIso R).inv a) ^ n • s = a ^ n • s := by
    rw [Scheme.Modules.smul_Spec_def]
    simp only [Opens.leTop, homOfLE_refl, op_id, (Spec R).presheaf.map_id,
      CommRingCat.id_apply, ← map_pow]
  rw [mem_supportedSectionsSubmodule_iff_exists_pow_le_annihilator (principalZeroLocus R a) F
    (isAffineOpen_top (Spec R))
    (Submodule.fg_span (Set.finite_singleton ((Scheme.ΓSpecIso R).inv a))) rfl s]
  constructor
  · rintro ⟨n, hn⟩
    exact ⟨n, (hsmul n).symm.trans
      (hn _ (Ideal.pow_mem_pow (Ideal.mem_span_singleton_self _) n))⟩
  · rintro ⟨n, hn⟩
    refine ⟨n, fun r hr ↦ ?_⟩
    rw [Ideal.span_singleton_pow, Ideal.mem_span_singleton] at hr
    obtain ⟨c, rfl⟩ := hr
    rw [mul_comm, mul_smul, hsmul n, hn, smul_zero]

/-- **The global sections of the supported-sections submodule are the torsion submodule.** The
image in `Γ(F)` of the global sections of the submodule of sections supported on `V(a)` is the
submodule of elements killed by a power of `a`. -/
public lemma range_moduleSpecΓFunctor_map_supportedSectionsι_zeroLocus
    (F : (Spec R).Modules) [F.IsQuasicoherent] (a : R) :
    LinearMap.range
        (moduleSpecΓFunctor.map (supportedSectionsι (principalZeroLocus R a) F)).hom =
      Submodule.torsion' R (moduleSpecΓFunctor.obj F) (Submonoid.powers a) := by
  refine Submodule.ext fun m ↦ ?_
  have hmem : m ∈ LinearMap.range
        (moduleSpecΓFunctor.map (supportedSectionsι (principalZeroLocus R a) F)).hom ↔
      m ∈ (supportedSectionsSubmodule (principalZeroLocus R a) F).toSubmodule.obj (op ⊤) := by
    rw [LinearMap.mem_range]
    exact ⟨fun ⟨x, hx⟩ ↦ hx ▸ x.property, fun hm ↦ ⟨⟨m, hm⟩, rfl⟩⟩
  exact hmem.trans ((mem_supportedSectionsSubmodule_zeroLocus_span_singleton_iff F a m).trans
    (Stacks.mem_torsion'_powers_iff a m).symm)

/-- The submodule of sections supported on a principal zero locus is quasi-coherent: the zero
locus is closed and its complement, a basic open, is retrocompact. -/
public instance isQuasicoherent_supportedSectionsObj_principalZeroLocus
    (F : (Spec R).Modules) [F.IsQuasicoherent] (a : R) :
    (supportedSectionsObj (principalZeroLocus R a) F).IsQuasicoherent :=
  supportedSectionsSubmodule_isQuasicoherent _ (isClosed_principalZeroLocus a)
    (isRetrocompact_compl_principalZeroLocus a) F

/-- **The quotient by the sections supported on a principal zero locus.** For a quasi-coherent
module `F` on `Spec R` and `a : R`, the quotient of `F` by the sections supported on `V(a)` is the
module attached to the quotient of `Γ(F)` by its `a`-power torsion.

This is the geometric form of the module the ring-level [Stacks, Tag 0810] produces: on a blowup
chart the inverse image of the centre is generated by one element, and the strict transform of
[Stacks, Tag 080D] is the quotient by the sections supported on its zero locus. -/
public def supportedQuotientZeroLocusTildeIso (F : (Spec R).Modules) [F.IsQuasicoherent]
    (a : R) :
    cokernel (supportedSectionsι (principalZeroLocus R a) F) ≅
      tilde (ModuleCat.of R (moduleSpecΓFunctor.obj F ⧸
        Submodule.torsion' R (moduleSpecΓFunctor.obj F) (Submonoid.powers a))) := by
  rw [← range_moduleSpecΓFunctor_map_supportedSectionsι_zeroLocus F a]
  exact (asIso (Scheme.Modules.fromTildeΓ
      (cokernel (supportedSectionsι (principalZeroLocus R a) F)))).symm ≪≫
    (tilde.functor R).mapIso ((cokernelSpecΓIso
      (supportedSectionsι (principalZeroLocus R a) F)).symm ≪≫
        ModuleCat.cokernelIsoRangeQuotient _)

/-- **The quotient of `M^~` by the sections supported on a principal zero locus**, with the answer
written in terms of `M` itself: it is `(M / a`-power torsion`)^~`.

This is the identification the affine engine of [Stacks, Tag 0810] needs: its output module is
the quotient of the base change by its `a`-power torsion, and this says that quotient is the
strict transform of [Stacks, Tag 080D] read on the chart. -/
public def tildeSupportedQuotientZeroLocusIso (M : ModuleCat.{u} R) (a : R) :
    cokernel (supportedSectionsι (principalZeroLocus R a) (tilde M)) ≅
      tilde (ModuleCat.of R (M ⧸ Submodule.torsion' R M (Submonoid.powers a))) :=
  supportedQuotientZeroLocusTildeIso (tilde M) a ≪≫
    (tilde.functor R).mapIso
      (Stacks.quotientTorsionPowersEquiv a
        ((tilde.toTildeΓNatIso (R := R)).app M).toLinearEquiv).symm.toModuleIso

end AlgebraicGeometry

end
