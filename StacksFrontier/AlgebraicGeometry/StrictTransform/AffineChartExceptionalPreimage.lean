/-!
# The exceptional preimage on an affine chart is a principal zero locus

The strict transform of [Stacks, Tag 080D] is a quotient by the sections supported on
`pr_{S'}^{-1}(Supp E)`, and its chart-level computation
`Stacks.StrictTransform.affineChartSheafIso` asks for that closed set, pulled back to an affine
chart `Spec B` of the base change, to be the zero locus of a single element `β : B`. This file
proves that hypothesis for a blowup: on a chart over which the centre becomes a principal ideal,
the exceptional preimage is the zero locus of its generator.

The route has two halves, each of independent use.

*Moving the preimage to the other leg.* For a blowup, the exceptional ideal is the inverse image
of the centre (`AlgebraicGeometry.exceptionalIdeal`), so its support is the preimage of the
support of the centre; and the base-change square commutes, so the preimage of that along the
projection to the blowup is the preimage along `X ×_S S' ⟶ X ⟶ S`. That is what makes an affine
computation possible at all: the chart maps to `X`, not to the blowup.

*The affine computation.* On an affine scheme the support of an ideal sheaf is the zero locus of
its ideal of global sections, and the preimage of a zero locus along a morphism out of a spectrum
presented as `Spec` of a ring map is the zero locus of the extended ideal. When that extended
ideal is principal the result is `AlgebraicGeometry.principalZeroLocus`.

## Main results

* `Stacks.StrictTransform.exceptionalPreimage_blowUp_eq_preimage_support`: the exceptional
  preimage is the preimage of the support of the centre along `X ×_S Bl(S) ⟶ X ⟶ S`.
* `Stacks.StrictTransform.preimage_exceptionalPreimage_blowUp_eq_preimage_support`: the same,
  pulled back along an arbitrary chart of the base change.
* `AlgebraicGeometry.Scheme.IdealSheafData.coe_support_eq_zeroLocus_top`: on an affine scheme the
  support of an ideal sheaf is the zero locus of its global ideal.
* `AlgebraicGeometry.preimage_coe_support_eq_zeroLocus_map`: the preimage of that support along a
  morphism `Spec B ⟶ S` presented as `Spec` of `ρ` is the zero locus of the extended ideal.
* `AlgebraicGeometry.preimage_coe_support_eq_principalZeroLocus`: the same when the extended ideal
  is generated by one element.
* `Stacks.StrictTransform.preimage_exceptionalPreimage_eq_principalZeroLocus`: the two halves
  composed — the hypothesis `hZ` of `Stacks.StrictTransform.affineChartSheafIso`.
* `Ideal.map_algebraMap_tensorProduct_eq_span_of_right`: the ring-level input, that a centre which
  becomes principal in `T` becomes principal in `S ⊗_R T`, generated by the image of the same
  generator through `S`.

## Implementation notes

The commuting of the base-change square is read pointwise:
`CategoryTheory.Limits.pullback.condition` gives the equality of the two composites
`X ×_S S' ⟶ S`, and `congrArg` at a point turns it into the equality of images needed to rewrite
membership in the support.

`Ideal.map_algebraMap_tensorProduct_eq_span_of_right` goes through
`Algebra.TensorProduct.rightAlgebra`, which is not an instance, so it is installed locally; the
two routes `R → T → S ⊗_R T` and `R → S → S ⊗_R T` agree by
`Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap`.

## References

* [Stacks Project, Tag 080D](https://stacks.math.columbia.edu/tag/080D)
* [Stacks Project, Tag 0810](https://stacks.math.columbia.edu/tag/0810)
* [Stacks Project, Tag 07Z3](https://stacks.math.columbia.edu/tag/07Z3)
-/

@[expose] public section

open CategoryTheory Limits AlgebraicGeometry TopologicalSpace
open scoped TensorProduct

universe u

/-! ### The ring-level input -/

/-- **A centre which becomes principal in `T` becomes principal in `S ⊗_R T`.** If the image of
`I ⊆ R` in `T` is generated by the image of `a : R`, then its image in `S ⊗_R T` is generated by
the image of `a` through `S`.

This is how the generator `β` of the chart-level exceptional ideal is produced: `T` is the affine
blowup algebra `R[I/a]`, where the statement for `T` is [Stacks, Tag 07Z3] (2), and `S ⊗_R T` is
the chart of the base change. -/
public theorem Ideal.map_algebraMap_tensorProduct_eq_span_of_right (R S T : Type u) [CommRing R]
    [CommRing S] [CommRing T] [Algebra R S] [Algebra R T] (I : Ideal R) (a : R)
    (h : Ideal.map (algebraMap R T) I = Ideal.span {(algebraMap R T) a}) :
    Ideal.map (algebraMap R (S ⊗[R] T)) I =
      Ideal.span {(algebraMap S (S ⊗[R] T)) ((algebraMap R S) a)} := by
  let : Algebra T (S ⊗[R] T) := Algebra.TensorProduct.rightAlgebra
  calc
    Ideal.map (algebraMap R (S ⊗[R] T)) I =
        Ideal.map (algebraMap T (S ⊗[R] T)) (Ideal.map (algebraMap R T) I) := by
      rw [Ideal.map_map]
      change Ideal.map ((Algebra.TensorProduct.includeLeftRingHom (R := R) (A := S)
          (B := T)).comp (algebraMap R S)) I =
        Ideal.map ((Algebra.TensorProduct.includeRight (R := R) (A := S)
          (B := T)).toRingHom.comp (algebraMap R T)) I
      exact congrArg (fun φ : R →+* S ⊗[R] T => Ideal.map φ I)
        Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap
    _ = Ideal.span {(algebraMap S (S ⊗[R] T)) ((algebraMap R S) a)} := by
      rw [h, Ideal.map_span]
      have he : (algebraMap T (S ⊗[R] T)) ((algebraMap R T) a) =
          (algebraMap S (S ⊗[R] T)) ((algebraMap R S) a) :=
        (congrArg (fun φ : R →+* S ⊗[R] T => φ a)
          (Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap (R := R) (A := S)
            (B := T))).symm
      simp only [Set.image_singleton, he]

namespace AlgebraicGeometry

/-! ### The support of an ideal sheaf on an affine scheme -/

/-- **On an affine scheme the support of an ideal sheaf is the zero locus of its global ideal.**
This is `AlgebraicGeometry.Scheme.IdealSheafData.coe_support_inter` at the affine open `⊤`. -/
public theorem Scheme.IdealSheafData.coe_support_eq_zeroLocus_top {S : Scheme.{u}} [IsAffine S]
    (ℐ : S.IdealSheafData) :
    (ℐ.support : Set S) =
      S.zeroLocus (U := ⊤) (ℐ.ideal ⟨⊤, isAffineOpen_top S⟩ : Set Γ(S, ⊤)) := by
  simpa using ℐ.coe_support_inter ⟨⊤, isAffineOpen_top S⟩

/-- **The preimage of the support of an ideal sheaf under a morphism from a spectrum.** If
`g : Spec B ⟶ S` is `Spec` of `ρ : Γ(S, ⊤) →+* B` through the affine identification of `S`, then
the preimage of the support is the zero locus of the extension of the global ideal along `ρ`. -/
public theorem preimage_coe_support_eq_zeroLocus_map {S : Scheme.{u}} [IsAffine S]
    (ℐ : S.IdealSheafData) (B : CommRingCat.{u}) (g : Spec B ⟶ S) (ρ : Γ(S, ⊤) →+* B)
    (hg : g ≫ S.isoSpec.hom = Spec.map (CommRingCat.ofHom ρ)) :
    g.base ⁻¹' (ℐ.support : Set S) =
      PrimeSpectrum.zeroLocus (Ideal.map ρ (ℐ.ideal ⟨⊤, isAffineOpen_top S⟩) : Set B) := by
  rw [Scheme.IdealSheafData.coe_support_eq_zeroLocus_top, ← S.toSpecΓ_preimage_zeroLocus]
  change (g ≫ S.isoSpec.hom).base ⁻¹' _ = _
  rw [hg]
  ext p
  change ℐ.ideal ⟨⊤, isAffineOpen_top S⟩ ≤ p.asIdeal.comap ρ ↔
    (ℐ.ideal ⟨⊤, isAffineOpen_top S⟩).map ρ ≤ p.asIdeal
  exact Ideal.map_le_iff_le_comap.symm

/-- **The preimage of the support of an ideal sheaf which becomes principal on the chart.** In the
situation of `AlgebraicGeometry.preimage_coe_support_eq_zeroLocus_map`, if the extended ideal is
generated by `β : B`, the preimage is `AlgebraicGeometry.principalZeroLocus B β`. -/
public theorem preimage_coe_support_eq_principalZeroLocus {S : Scheme.{u}} [IsAffine S]
    (ℐ : S.IdealSheafData) (B : CommRingCat.{u}) (g : Spec B ⟶ S) (ρ : Γ(S, ⊤) →+* B) (β : B)
    (hg : g ≫ S.isoSpec.hom = Spec.map (CommRingCat.ofHom ρ))
    (hI : Ideal.map ρ (ℐ.ideal ⟨⊤, isAffineOpen_top S⟩) = Ideal.span {β}) :
    g.base ⁻¹' (ℐ.support : Set S) = principalZeroLocus B β := by
  rw [preimage_coe_support_eq_zeroLocus_map ℐ B g ρ hg, hI, principalZeroLocus,
    Scheme.zeroLocus_span]
  simpa only [Set.image_singleton, PrimeSpectrum.zeroLocus_span] using
    (Spec_zeroLocus_eq_zeroLocus ({β} : Set B)).symm

end AlgebraicGeometry

namespace Stacks.StrictTransform

/-! ### The exceptional preimage of a blowup -/

/-- **The exceptional preimage is the preimage of the support of the centre along the other leg.**
The exceptional ideal of a blowup is the inverse image of the centre, so its support is the
preimage of the support of the centre; and the base-change square commutes, so pulling that back
along the projection to the blowup is the same as pulling the support of the centre back along
`X ×_S Bl(S) ⟶ X ⟶ S`.

This is the step that makes the chart-level computation possible: an affine chart of the base
change is presented through its map to `X`, not through its map to the blowup. -/
public theorem exceptionalPreimage_blowUp_eq_preimage_support {X S : Scheme.{u}} (f : X ⟶ S)
    (ℐ : S.IdealSheafData) :
    exceptionalPreimage f (blowUpToBase ℐ) (exceptionalIdeal ℐ) =
      (pullback.fst f (blowUpToBase ℐ) ≫ f).base ⁻¹' (ℐ.support : Set S) := by
  have hs : ((exceptionalIdeal ℐ).support : Set (blowUp ℐ)) =
      (blowUpToBase ℐ).base ⁻¹' (ℐ.support : Set S) := by
    rw [exceptionalIdeal, Scheme.IdealSheafData.support_comap]
    rfl
  change (pullback.snd f (blowUpToBase ℐ)).base ⁻¹'
      ((exceptionalIdeal ℐ).support : Set _) = _
  rw [hs]
  ext x
  change (blowUpToBase ℐ) ((pullback.snd f (blowUpToBase ℐ)) x) ∈ ℐ.support ↔
    f ((pullback.fst f (blowUpToBase ℐ)) x) ∈ ℐ.support
  have h := congrArg (fun g : baseChange f (blowUpToBase ℐ) ⟶ S => g x)
    (pullback.condition (f := f) (g := blowUpToBase ℐ))
  have hpoint : (blowUpToBase ℐ) ((pullback.snd f (blowUpToBase ℐ)) x) =
      f ((pullback.fst f (blowUpToBase ℐ)) x) := by
    simpa only [Scheme.Hom.comp_apply] using h.symm
  rw [hpoint]

/-- The exceptional preimage pulled back along an arbitrary chart of the base change, as a
preimage of the support of the centre. -/
public theorem preimage_exceptionalPreimage_blowUp_eq_preimage_support {X S Y : Scheme.{u}}
    (f : X ⟶ S) (ℐ : S.IdealSheafData) (j : Y ⟶ baseChange f (blowUpToBase ℐ)) :
    j.base ⁻¹' exceptionalPreimage f (blowUpToBase ℐ) (exceptionalIdeal ℐ) =
      (j ≫ pullback.fst f (blowUpToBase ℐ) ≫ f).base ⁻¹' (ℐ.support : Set S) := by
  rw [exceptionalPreimage_blowUp_eq_preimage_support]
  rfl

/-- **The hypothesis `hZ` of `Stacks.StrictTransform.affineChartSheafIso`, for a blowup of an
affine scheme.** Let `S` be affine, `ℐ` a centre on it, and `j : Spec B ⟶ X ×_S Bl_ℐ(S)` a chart
whose composite to `S` is `Spec` of `ρ : Γ(S, ⊤) →+* B`. If `ρ` carries the global ideal of `ℐ`
onto the principal ideal of `β : B`, then the exceptional preimage pulled back to the chart is the
zero locus of `β`.

This is `Stacks.StrictTransform.preimage_exceptionalPreimage_blowUp_eq_preimage_support` followed
by `AlgebraicGeometry.preimage_coe_support_eq_principalZeroLocus`. -/
public theorem preimage_exceptionalPreimage_eq_principalZeroLocus {X S : Scheme.{u}} [IsAffine S]
    (f : X ⟶ S) (ℐ : S.IdealSheafData) (B : CommRingCat.{u})
    (j : Spec B ⟶ baseChange f (blowUpToBase ℐ)) (ρ : Γ(S, ⊤) →+* B) (β : B)
    (hj : (j ≫ pullback.fst f (blowUpToBase ℐ) ≫ f) ≫ S.isoSpec.hom =
      Spec.map (CommRingCat.ofHom ρ))
    (hI : Ideal.map ρ (ℐ.ideal ⟨⊤, isAffineOpen_top S⟩) = Ideal.span {β}) :
    j.base ⁻¹' exceptionalPreimage f (blowUpToBase ℐ) (exceptionalIdeal ℐ) =
      principalZeroLocus B β := by
  rw [preimage_exceptionalPreimage_blowUp_eq_preimage_support f ℐ j]
  exact preimage_coe_support_eq_principalZeroLocus ℐ B
    (j ≫ pullback.fst f (blowUpToBase ℐ) ≫ f) ρ β hj hI

end Stacks.StrictTransform

end
