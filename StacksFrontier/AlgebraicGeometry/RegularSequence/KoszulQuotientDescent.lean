module

public import StacksFrontier.Algebra.Category.ModuleCat.Presheaf.InternalHomAnnihilator
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.RestrictScalarsEssentialImage
public import StacksFrontier.AlgebraicGeometry.RegularSequence.KoszulQuotientAnnihilation
public import StacksFrontier.CategoryTheory.Sites.Modules.QuotientRingSheafEpi

/-!
# Descent of modules along the quotient by the ideal generated by a morphism

Let `O` be a sheaf of commutative rings on a site and let `φ : F ⟶ O` be a morphism of sheaves of
modules, with `𝓘` the sheaf of ideals it generates and `O/𝓘` the quotient sheaf of rings. A sheaf
of `O`-modules annihilated by `𝓘` is the restriction of scalars of a sheaf of `O/𝓘`-modules.
Moreover:

* the quotient `O/𝓘`, read as a sheaf of `O`-modules — that is, the cokernel of `φ` — is
  annihilated by `𝓘`;
* every homomorphism into a sheaf annihilated by `𝓘` is annihilated by `𝓘`, so the internal Hom
  sheaves into the quotient are too.

## Main definitions

* `Stacks.RegularSequence.descendedModule`: a sheaf of `O`-modules annihilated by `𝓘`, read as a
  sheaf of `O/𝓘`-modules, together with
  `Stacks.RegularSequence.restrictScalars_descendedModule_iso` identifying its restriction of
  scalars with the original sheaf.

## Main results

* `Stacks.RegularSequence.smul_koszulQuotient_eq_zero_of_mem_idealOfHom`: the sheaf of ideals
  generated by `φ` annihilates the cokernel of `φ`.
* `Stacks.RegularSequence.smulHom_eq_zero_of_mem_idealOfHom`: it annihilates every homomorphism
  into a sheaf of modules it annihilates.
* `Stacks.RegularSequence.isLocallySurjective_quotientRingHom_idealOfHom`: the quotient map onto
  `O/𝓘`, read on the underlying sheaves of rings, is locally surjective.
* `Stacks.RegularSequence.mem_idealOfHom_of_mem_ker`: a section killed by the quotient map lies in
  the sheaf of ideals.

## Implementation notes

The lemmas `Stacks.SheafOfModules.ChangeOfRings.sectionRestrict_smul` and
`Stacks.SheafOfModules.ChangeOfRings.sectionRestrict_zero` are written with their full names:
`sectionRestrict_smul` is declared several times in this library with different argument orders,
and which one a bare reference resolves to depends on the import closure.

## References

* [Stacks Project, Tag 0930](https://stacks.math.columbia.edu/tag/0930)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Sheaf Opposite

universe u

namespace Stacks.RegularSequence

open Stacks.Sites Stacks.SheafOfModules.ChangeOfRings

variable {C : Type u} [Category.{u} C] {J : GrothendieckTopology C}
  [J.HasSheafCompose (forget₂ CommRingCat.{u} RingCat.{u})]
  {Osharp : Sheaf J CommRingCat.{u}} [HasWeakSheafify J CommRingCat.{u}]
  [HasSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  {F : SheafOfModules.{u} (toRingCat J Osharp)}
  (φ : F ⟶ SheafOfModules.unit (toRingCat J Osharp))

omit [HasWeakSheafify J CommRingCat.{u}] in
/-- **The sheaf of ideals generated by `φ` annihilates the quotient.** -/
theorem smul_koszulQuotient_eq_zero_of_mem_idealOfHom (X : Cᵒᵖ)
    (a : (toRingCat J Osharp).obj.obj X) (ha : a ∈ (idealOfHom φ).obj X)
    (s : (koszulQuotient φ).val.obj X) : a • s = 0 := by
  refine Stacks.SheafOfModules.ChangeOfRings.sections_ext (koszulQuotient φ) ha ?_
  intro Y g hg
  obtain ⟨e, he⟩ := hg
  have h2 : (toRingCat J Osharp).obj.map g.op a = unitScalar φ (op Y) e := he.symm
  rw [Stacks.SheafOfModules.ChangeOfRings.sectionRestrict_smul, h2,
    Stacks.SheafOfModules.ChangeOfRings.sectionRestrict_zero]
  exact smul_koszulQuotient_eq_zero φ (op Y) e _

omit [HasWeakSheafify J CommRingCat.{u}] [HasSheafify J AddCommGrpCat.{u}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- **A homomorphism into a sheaf annihilated by the sheaf of ideals is annihilated by it.** -/
theorem smulHom_eq_zero_of_mem_idealOfHom
    (A G : SheafOfModules.{u} (toRingCat J Osharp))
    (hG : ∀ (X : Cᵒᵖ) (b : (toRingCat J Osharp).obj.obj X), b ∈ (idealOfHom φ).obj X →
      ∀ m : G.val.obj X, b • m = 0)
    (U : C) (a : Osharp.obj.obj (op U)) (ha : a ∈ (idealOfHom φ).obj (op U))
    (α : (restrFun Osharp.obj U).obj A.val ⟶ (restrFun Osharp.obj U).obj G.val) :
    smulHom Osharp.obj A.val G.val U a α = 0 :=
  smulHom_eq_zero Osharp.obj A.val G.val U a
    (fun V x => hG (op V.unop.left) _ ((idealOfHom φ).map_mem _ ha) x) α

/-- **The quotient map onto `O/𝓘` is locally surjective on the underlying sheaves of rings.** -/
instance isLocallySurjective_quotientRingHom_idealOfHom :
    Presheaf.IsLocallySurjective J (quotientRingHom (idealOfHom φ)).hom where
  imageSieve_mem {_X} y :=
    haveI := isLocallySurjective_toQuotientRingSheaf (idealOfHom φ)
    Presheaf.imageSieve_mem J (toQuotientRingSheaf (idealOfHom φ)).hom y

omit [HasSheafify J AddCommGrpCat.{u}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- A section of the structure sheaf killed by the quotient map lies in the sheaf of ideals. -/
theorem mem_idealOfHom_of_mem_ker (X : Cᵒᵖ) (b : (toRingCat J Osharp).obj.obj X)
    (hb : b ∈ RingHom.ker ((quotientRingHom (idealOfHom φ)).hom.app X).hom) :
    b ∈ (idealOfHom φ).obj X :=
  (SetLike.ext_iff.1 (congrArg (fun N : IdealSubsheaf Osharp => N.obj X)
      (kerIdeal_quotientRingHom (idealOfHom φ))) b).1
    ((SheafOfModules.mem_kerIdeal (quotientRingHom (idealOfHom φ)) X b).2 hb)

/-- **A sheaf of modules annihilated by the sheaf of ideals, read over the quotient.** The
underlying presheaf of abelian groups is unchanged; the action of a section of `O/𝓘` is the
action of any local lift of it along the quotient map.

The result type is left to be inferred: naming it would make the elaborator compare a written
copy of the quotient ring sheaf with the inferred one, which unfolds to a sheafification. -/
def descendedModule (G : SheafOfModules.{u} (toRingCat J Osharp))
    (hG : ∀ (X : Cᵒᵖ) (b : (toRingCat J Osharp).obj.obj X), b ∈ (idealOfHom φ).obj X →
      ∀ m : G.val.obj X, b • m = 0) :=
  liftedSheaf (quotientRingHom (idealOfHom φ)) G
    (fun X b hb m => hG X b (mem_idealOfHom_of_mem_ker φ X b hb) m)

/-- Restriction of scalars takes the descended sheaf back to the one it came from. Its type is
likewise left to be inferred. -/
def restrictScalars_descendedModule_iso (G : SheafOfModules.{u} (toRingCat J Osharp))
    (hG : ∀ (X : Cᵒᵖ) (b : (toRingCat J Osharp).obj.obj X), b ∈ (idealOfHom φ).obj X →
      ∀ m : G.val.obj X, b • m = 0) :=
  restrictScalarsLiftedSheafIso (quotientRingHom (idealOfHom φ)) G
    (fun X b hb m => hG X b (mem_idealOfHom_of_mem_ker φ X b hb) m)

end Stacks.RegularSequence

end
