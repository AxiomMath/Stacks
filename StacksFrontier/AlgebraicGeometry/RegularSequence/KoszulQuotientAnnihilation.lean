module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EpiLocallySurjective
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ULiftUnit
public import StacksFrontier.AlgebraicGeometry.RegularSequence.KoszulAugmentation

/-!
# The ideal generated by a morphism annihilates the quotient by it

Let `O♯` be a sheaf of commutative rings on a site, let `F` be a sheaf of `O♯`-modules and let
`φ : F ⟶ O♯` be a morphism of sheaves of modules, with ideal sheaf `I` its image and quotient
`O♯/I = coker φ`. Every section of the form `φ(e)` then acts as zero on every section of
`O♯/I`: the ideal annihilates the quotient.

This is the reason the Koszul differential dies in the quotient. That differential is, on the
exterior basis, an alternating sum of terms whose coefficients are the scalars `φ(e)` attached
to the tautological generators; each such coefficient kills a section of `O♯/I`, so the whole
sum does.

## Main results

* `Stacks.RegularSequence.unitScalar_mul`: the scalar attached by `φ` to a section, times a
  section of the structure sheaf, is the scalar attached by `φ` to the rescaled section.
* `Stacks.RegularSequence.smul_koszulQuotientπ_eq_zero`: a scalar attached by `φ` kills every
  section of the quotient which comes from a section of the structure sheaf.
* `Stacks.RegularSequence.smul_koszulQuotient_eq_zero`: **a scalar attached by `φ` kills every
  section of the quotient `O♯/I`.**
* `Stacks.RegularSequence.mul_unitScalar_smul_koszulQuotient_eq_zero`: the same for a scalar
  attached by `φ` multiplied by an arbitrary section of the structure sheaf, which is the form
  in which the coefficients of the Koszul differential appear.

## Implementation notes

The quotient map `O♯ ↠ O♯/I` is an epimorphism of sheaves of modules, hence locally
surjective, so a section of the quotient is only *locally* the image of a section of the
structure sheaf; that is why the argument goes through a covering sieve and finishes with the
separatedness of the quotient, rather than lifting the section outright. The two inputs are
`Stacks.SheafOfModules.EpiMono.exists_covering_of_epi` and
`Stacks.SheafOfModules.eq_zero_of_locally_eq_zero`.

The scalar attached by `φ` to a local section is `Stacks.RegularSequence.unitScalar`, a
definition rather than a type ascription: the sections of `SheafOfModules.unit R` over an object
and the sections of `R` over it are the same type, but instance search does not unfold the
former, so the scalar has to be named at the latter in order to be usable as a scalar. The
commutativity of the structure sheaf enters once, to move that scalar past a section of the
structure sheaf.

## References

* [Stacks Project, Tag 0622](https://stacks.math.columbia.edu/tag/0622)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Sheaf Opposite

universe u v w

namespace Stacks.RegularSequence

open Stacks.SheafOfModules

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  {Osharp : Sheaf J CommRingCat.{w}}
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}]
  {F : SheafOfModules.{w} (toRingCat J Osharp)}

omit [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}] in
/-- **Moving a section of the structure sheaf inside the scalar attached by `φ`.** The scalar
attached to `e` times a section `t` of the structure sheaf is the scalar attached to `t • e`;
this uses the commutativity of the structure sheaf, since `φ` is linear and so produces the
product in the other order. -/
theorem unitScalar_mul (φ : F ⟶ SheafOfModules.unit (toRingCat J Osharp))
    (W : Cᵒᵖ) (e : F.val.obj W) (t : (toRingCat J Osharp).obj.obj W) :
    unitScalar φ W e * t = unitScalar φ W (t • e) := by
  have h1 : φ.val.app W (t • e) = t • φ.val.app W e := map_smul _ _ _
  have h2 : unitScalar φ W (t • e) = t * unitScalar φ W e := h1
  rw [h2]
  exact mul_comm _ _

/-- **A scalar attached by `φ` kills every section of the quotient coming from a section of the
structure sheaf.** Such a product is the image under the quotient map of a section in the image
of `φ`, and the quotient map kills the image of `φ`. -/
theorem smul_koszulQuotientπ_eq_zero (φ : F ⟶ SheafOfModules.unit (toRingCat J Osharp))
    (W : Cᵒᵖ) (e : F.val.obj W) (t : (toRingCat J Osharp).obj.obj W) :
    unitScalar φ W e • (koszulQuotientπ φ).val.app W t = 0 := by
  have hlin : unitScalar φ W e • (koszulQuotientπ φ).val.app W t
      = (koszulQuotientπ φ).val.app W (unitScalar φ W e * t) := (map_smul _ _ _).symm
  rw [hlin, unitScalar_mul]
  have h0 : (φ ≫ koszulQuotientπ φ).val.app W (t • e) = 0 := by
    rw [comp_koszulQuotientπ]
    rfl
  exact h0

/-- **The ideal sheaf generated by `φ` annihilates the quotient `O♯/I`.** A section of the
quotient is, after restriction along the arrows of a covering sieve, the image of a section of
the structure sheaf, where the product with a scalar attached by `φ` vanishes; the quotient is a
sheaf, so the product vanishes outright. -/
theorem smul_koszulQuotient_eq_zero (φ : F ⟶ SheafOfModules.unit (toRingCat J Osharp))
    (U : Cᵒᵖ) (e : F.val.obj U) (s : (koszulQuotient φ).val.obj U) :
    unitScalar φ U e • s = 0 := by
  obtain ⟨S, hS, hlift⟩ := EpiMono.exists_covering_of_epi (koszulQuotientπ φ) s
  refine eq_zero_of_locally_eq_zero _ hS fun {V} g hg => ?_
  obtain ⟨t, ht⟩ := hlift g hg
  have hs : (koszulQuotient φ).val.map g.op s = (koszulQuotientπ φ).val.app (op V) t := ht.symm
  have hnat : (toRingCat J Osharp).obj.map g.op (unitScalar φ U e)
      = unitScalar φ (op V) (F.val.map g.op e) :=
    (PresheafOfModules.naturality_apply φ.val g.op e).symm
  rw [PresheafOfModules.map_smul, hs, hnat]
  exact smul_koszulQuotientπ_eq_zero φ (op V) (F.val.map g.op e) t

/-- **An arbitrary multiple of a scalar attached by `φ` kills every section of the quotient
`O♯/I`.** This is the form in which the coefficients of the Koszul differential on the exterior
basis appear: each is a sign times a scalar attached by `φ` to a tautological generator. -/
theorem mul_unitScalar_smul_koszulQuotient_eq_zero
    (φ : F ⟶ SheafOfModules.unit (toRingCat J Osharp)) (U : Cᵒᵖ)
    (c : (toRingCat J Osharp).obj.obj U) (e : F.val.obj U)
    (s : (koszulQuotient φ).val.obj U) : (c * unitScalar φ U e) • s = 0 := by
  rw [mul_smul, smul_koszulQuotient_eq_zero, smul_zero]

end Stacks.RegularSequence

end
