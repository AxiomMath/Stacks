attribute [local instance] HasDerivedCategory.standard

variable {X : TopCat.{u}} {Osharp : Sheaf (Opens.grothendieckTopology ↥X) CommRingCat.{u}}
  [HasSheafify (Opens.grothendieckTopology ↥X) AddCommGrpCat.{u}]
  [(Opens.grothendieckTopology ↥X).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [HasWeakSheafify (Opens.grothendieckTopology ↥X) CommRingCat.{u}]
  {r : ℕ}
  (φ : koszulFreeSheaf Osharp r ⟶
    SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp))

omit [HasWeakSheafify (Opens.grothendieckTopology ↥X) CommRingCat.{u}] in
/-- **The two spellings of the Koszul augmentation agree as instances.**
`Stacks.RegularSequence.koszulAugmentation` is by definition the augmentation of
`Stacks.RegularSequence.koszulChainData`, but it is a plain definition, which instance search does
not unfold; the acyclicity bridges conclude in the first spelling while the self-Ext development
asks for the second. The conversion is the identity, and it is what makes those bridges usable
here.

It is a theorem and not an instance on purpose. As an instance it never fires: instance search
would have to unfold `Stacks.RegularSequence.koszulAugmentation` to match its own hypothesis
against what the bridges supply, which is exactly the unfolding it does not perform. Supplying
the conversion as a term is what works, and a consumer introduces it with `letI`. -/
theorem quasiIso_koszulChainData_augmentation (h : QuasiIso (koszulAugmentation φ)) :
    QuasiIso (koszulChainData φ).augmentation :=
  h

/-- **The comparison of Stacks 0BQY is an isomorphism in every degree, for the canonical Koszul
chain datum.** `Stacks.RegularSequence.KoszulChainData.isIso_extComparison_forall` instantiated at
`Stacks.RegularSequence.koszulChainData`; the quasi-isomorphism hypothesis is the one the
acyclicity bridges produce, `Stacks.RegularSequence.koszulAugmentation` being by definition the
augmentation of that datum.

The hypothesis is spelled as the augmentation of the datum, not as
`Stacks.RegularSequence.koszulAugmentation`: the two are the same term, but the latter is a plain
definition, which instance search does not unfold, and the *statement* needs the instance — the
descended self-Ext algebra is defined through `Stacks.RegularSequence.KoszulChainData.homIso`,
which takes it. A consumer holding the bridges' conclusion introduces it with `haveI`, the
conversion being by definition. -/
theorem isIso_extComparison_koszulChainData
    [QuasiIso (koszulChainData φ).augmentation] (i : ℤ) :
    IsIso (KoszulChainData.extComparison Osharp (koszulChainData φ) i) :=
  KoszulChainData.isIso_extComparison_forall Osharp (koszulChainData φ) i

/-- **The self-Ext algebra of the quotient is an exterior algebra on its degree-one piece, for the
canonical Koszul chain datum.** The equivalent formulation of
`isIso_extComparison_koszulChainData`. -/
theorem isExteriorAlgebra_extSelfAlgebra_koszulChainData
    [QuasiIso (koszulChainData φ).augmentation] :
    SheafOfModules.GradedAlgebra.IsExteriorAlgebra
      (KoszulChainData.extSelfAlgebra Osharp (koszulChainData φ))
      (𝟙 ((KoszulChainData.extSelfAlgebra Osharp (koszulChainData φ)).piece 1)) :=
  KoszulChainData.isExteriorAlgebra_extSelfAlgebra Osharp (koszulChainData φ)

end Stacks.RegularSequence

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

open Stacks.RegularSequence Stacks.AlgebraicGeometry.QuasiRegular

attribute [local instance] HasDerivedCategory.standard


/-- **The comparison of Stacks 0BQY is an isomorphism in every degree, on an open where the
local condition of tag 063D holds.** Let `f₁, …, f_r` be sections of `O_X` over an open `U` whose
Koszul complex is acyclic in positive degrees — the condition that
`Stacks.AlgebraicGeometry.RegularIdealSheaf.IsKoszulRegularIdealSheaf` asks for near every point
of the support of the quotient. Then on the restricted ringed space `X|_U`, composition makes

`⋀ⁱ(Ext¹(O/I, O/I)) ⟶ Extⁱ(O/I, O/I)`

an isomorphism in every degree `i`, for the Koszul model of the quotient attached to that
sequence.

Together with `IsKoszulRegularIdealSheaf` itself, which hands over such a `U` and such an `f` at
every point of the support, this is the conclusion of [Stacks, Tag 0BQY] on each member of a
cover, from the tag's own hypothesis and nothing stronger. It is **not** the tag: see the
implementation notes.

The quasi-isomorphism the self-Ext development needs is produced from the hypothesis by
`Stacks.RegularSequence.quasiIso_koszulAugmentation_restrict` and introduced in the statement, so
that the hypothesis here is the geometric one rather than an assumption about a Koszul model.

It is therefore not registered under [stacks 0BQY], which is registered on
`Stacks.AlgebraicGeometry.RegularIdealSheaf.isIso_desc_app_isKoszulRegularIdealSheaf`. -/
theorem forall_isIso_extComparison_of_isKoszulSequenceExactOn
    (X : RingedSpace.{u}) (U : Opens X) {r : ℕ} (f : Fin r → X.presheaf.obj (op U))
    [HasSheafify (Opens.grothendieckTopology ↥(X.restrict U.isOpenEmbedding)) AddCommGrpCat.{u}]
    [(Opens.grothendieckTopology ↥(X.restrict U.isOpenEmbedding)).WEqualsLocallyBijective
      AddCommGrpCat.{u}]
    [HasWeakSheafify (Opens.grothendieckTopology ↥(X.restrict U.isOpenEmbedding))
      CommRingCat.{u}]
    (h : IsKoszulSequenceExactOn X U f (fun j => 0 < j)) :
    letI := quasiIso_koszulChainData_augmentation _
      (quasiIso_koszulAugmentation_restrict X U f h)
    ∀ i : ℤ, IsIso (KoszulChainData.extComparison
      (X.restrict U.isOpenEmbedding).sheaf
      (koszulChainData (koszulHomOfSections (X.restrict U.isOpenEmbedding).sheaf
        (fun j => sectionOnRestriction X U (f j)))) i) :=
  let := quasiIso_koszulChainData_augmentation _
    (quasiIso_koszulAugmentation_restrict X U f h)
  fun i => isIso_extComparison_koszulChainData _ i

end Stacks.AlgebraicGeometry.RegularIdealSheaf

