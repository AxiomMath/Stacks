variable {Y : RingedSpace.{u, u}} (J : (structureSheafModule Y).Submodule)
  [HasSheafify (Opens.grothendieckTopology Y.carrier) AddCommGrpCat.{u}]
  [(Opens.grothendieckTopology Y.carrier).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    HasSheafify ((Opens.grothendieckTopology Y.carrier).over V) AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    ((Opens.grothendieckTopology Y.carrier).over V).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier, HasSheafify (Opens.grothendieckTopology ↥V) AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    (Opens.grothendieckTopology ↥V).WEqualsLocallyBijective AddCommGrpCat.{u}]
  {L : CochainComplex (_root_.SheafOfModules.{u} (structureSheafRing Y)) ℤ}
  (eL : L ≅ (single (_root_.SheafOfModules.{u} (structureSheafRing Y)) (ComplexShape.up ℤ) 0).obj
    (cokernel J.ι))

/-- The quotient map `O_Y ⟶ O_Y/J`, with its source written as the structure sheaf of `Y`. -/
def quotientπ : _root_.SheafOfModules.unit (structureSheafRing Y) ⟶ cokernel J.ι :=
  cokernel.π J.ι

/-- The restriction of the structure sheaf of `Y` to an open subspace is its structure
sheaf. -/
def openSubspaceRestrictUnitIso (U : Opens Y.carrier) :
    openSubspaceRestrictModule U (_root_.SheafOfModules.unit (structureSheafRing Y)) ≅
      _root_.SheafOfModules.unit (structureSheafRing (openSubspace U)) :=
  Iso.refl _

/-- The restriction to an open subspace of a complex presenting `O_Y/J`, read against the
quotient of the structure sheaf there by a Koszul presentation of `J`. -/
def openSubspaceRestrictQuotientDerivedIso (d : KoszulPresentation Y J) :
    DerivedCategory.Q.obj (openSubspaceRestrictComplex d.U L) ≅
      KoszulChainData.quotientDerived (openSubspace d.U).sheaf
        (φ := koszulHomOfSections (openSubspace d.U).sheaf
          fun j => sectionOnRestriction Y d.U (d.f j)) :=
  DerivedCategory.Q.mapIso ((openSubspacePushComplex d.U).mapIso
      (((_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) d.U).mapHomologicalComplex
        (ComplexShape.up ℤ)).mapIso eL) ≪≫
    openSubspaceRestrictSingleIso d.U (cokernel J.ι) 0 ≪≫
    (single _ (ComplexShape.up ℤ) 0).mapIso
      (koszulRestrictedQuotientIso d.U d.f J.ι
        (fun W => sectionIdeal_sliceIdealOfSections_eq d.U d.f J d.generated W)))

variable (I : CochainComplex (_root_.SheafOfModules.{u} (structureSheafRing Y)) ℤ)
  (hI : I.IsKInjective)
  (e : DerivedCategory.Q.obj
      ((single (_root_.SheafOfModules.{u} (structureSheafRing Y)) (ComplexShape.up ℤ) 0).obj
        (_root_.SheafOfModules.unit (structureSheafRing Y))) ≅ DerivedCategory.Q.obj I)

/-- The restriction to an open subspace of a K-injective complex presenting `O_Y` presents the
structure sheaf there. -/
def openSubspaceRestrictUnitDerivedIso (U : Opens Y.carrier) :
    DerivedCategory.Q.obj (openSubspaceRestrictComplex U I) ≅
      KoszulChainData.unitDerived (openSubspace U).sheaf :=
  (openSubspaceRestrictSingleDerivedIso U (_root_.SheafOfModules.unit (structureSheafRing Y)) 0
    I hI e).symm

/-- Over a Koszul presentation, the augmentation of the Koszul chain data is a
quasi-isomorphism. -/
private theorem quasiIso_augmentation_of_presentation {Y : RingedSpace.{u, u}}
    {J : (structureSheafModule Y).Submodule}
    [∀ V : Opens Y.carrier, HasSheafify (Opens.grothendieckTopology ↥V) AddCommGrpCat.{u}]
    [∀ V : Opens Y.carrier,
      (Opens.grothendieckTopology ↥V).WEqualsLocallyBijective AddCommGrpCat.{u}]
    (d : KoszulPresentation Y J) :
    QuasiIso (koszulChainData (koszulHomOfSections (openSubspace d.U).sheaf
      fun j => sectionOnRestriction Y d.U (d.f j))).augmentation :=
  quasiIso_koszulChainData_augmentation _
    (quasiIso_koszulAugmentation_restrict Y d.U d.f d.koszulExact)

include eL hI e in
/-- **Over a Koszul presentation of `J`, the cohomology sheaves of `𝓗om^•(L, I)` vanish off the
length of the presentation.** -/
theorem isZero_over_homology_sheafHomComplex_of_presentation (d : KoszulPresentation Y J)
    {n : ℤ} (hn : n ≠ d.r) :
    IsZero ((_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) d.U).obj
      ((RingedSite.sheafHomComplex (ringedSite Y.sheaf) L I).obj.homology n)) := by
  let Rc := (openSubspace d.U).sheaf
  let φ := koszulHomOfSections Rc fun j => sectionOnRestriction Y d.U (d.f j)
  have := quasiIso_augmentation_of_presentation d
  have : (openSubspaceRestrictComplex d.U I).IsKInjective :=
    isKInjective_openSubspaceRestrictComplex d.U I hI
  have h := KoszulChainData.isZero_homology_sheafHomComplex_of_ne Rc (koszulChainData φ) _
    (freeHomEquiv_koszulHomOfSections Rc _) (openSubspaceRestrictQuotientDerivedIso J eL d)
    (openSubspaceRestrictUnitDerivedIso I hI e d.U) hn
  exact IsZero.of_iso (Functor.map_isZero (openSubspaceEquiv d.U).inverse
      (h.of_iso (sheafHomHomologyOpenSubspaceIso d.U L I n)))
    ((openSubspaceEquiv d.U).unitIso.app _)

omit [∀ V : Opens Y.carrier, HasSheafify (Opens.grothendieckTopology ↥V) AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    (Opens.grothendieckTopology ↥V).WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- Off the support of the quotient the quotient restricts to zero. -/
theorem isZero_over_cokernel_of_one_mem (U : Opens Y.carrier)
    (h1 : (1 : Y.presheaf.obj (op U)) ∈ J.obj (op U)) :
    IsZero ((_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) U).obj
      (cokernel J.ι)) := by
  have : IsIso ((_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) U).map J.ι) := by
    refine Stacks.SheafOfModules.isIso_of_bijective_app _ fun V =>
      ⟨Subtype.val_injective, fun s => ?_⟩
    have hV : (1 : Y.presheaf.obj (op V.unop.left)) ∈ J.obj (op V.unop.left) := by
      have := J.map_mem (homOfLE (show V.unop.left ≤ U from V.unop.hom.le)).op h1
      change (Y.presheaf.map (homOfLE (show V.unop.left ≤ U from V.unop.hom.le)).op).hom 1 ∈ _
        at this
      rwa [map_one] at this
    refine ⟨⟨s, ?_⟩, rfl⟩
    have e : ∀ t : Y.presheaf.obj (op V.unop.left), t * 1 = t := mul_one
    exact e s ▸ (J.obj (op V.unop.left)).smul_mem s hV
  exact (isZero_cokernel_of_epi _).of_iso
    (PreservesCokernel.iso (_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) U) J.ι)

omit [∀ V : Opens Y.carrier, HasSheafify (Opens.grothendieckTopology ↥V) AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    (Opens.grothendieckTopology ↥V).WEqualsLocallyBijective AddCommGrpCat.{u}] in
include eL in
/-- **Off the support of the quotient the cohomology sheaves of `𝓗om^•(L, M)` restrict to
zero**, for every complex `M`. -/
theorem isZero_over_homology_sheafHomComplex_of_one_mem (U : Opens Y.carrier)
    (h1 : (1 : Y.presheaf.obj (op U)) ∈ J.obj (op U))
    (M : CochainComplex (_root_.SheafOfModules.{u} (structureSheafRing Y)) ℤ) (n : ℤ) :
    IsZero ((_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) U).obj
      ((RingedSite.sheafHomComplex (ringedSite Y.sheaf) L M).obj.homology n)) := by
  have : HasSheafify ((ringedSite Y.sheaf).over U).J AddCommGrpCat.{u} :=
    inferInstanceAs (HasSheafify ((Opens.grothendieckTopology Y.carrier).over U) _)
  have : ((ringedSite Y.sheaf).over U).J.WEqualsLocallyBijective AddCommGrpCat.{u} :=
    inferInstanceAs (((Opens.grothendieckTopology Y.carrier).over U).WEqualsLocallyBijective _)
  refine IsZero.of_iso ?_ (RingedSite.sheafHomHomologyOverIso (ringedSite Y.sheaf) U L M n)
  have hsrc : IsZero (RingedSite.restrictComplex (ringedSite Y.sheaf) L U) := by
    refine RingedSite.complex_isZero_of_terms _ fun k => ?_
    refine IsZero.of_iso ?_ ((_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) U).mapIso
      ((HomologicalComplex.eval _ _ k).mapIso eL))
    by_cases hk : k = 0
    · subst hk
      exact (isZero_over_cokernel_of_one_mem J U h1).of_iso
        ((_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) U).mapIso
          (singleObjXSelf (ComplexShape.up ℤ) 0 _))
    · exact (_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) U).map_isZero
        (isZero_single_obj_X (ComplexShape.up ℤ) 0 _ k hk)
  have hC := RingedSite.sheafHomComplex_isZero_of_isZero ((ringedSite Y.sheaf).over U) hsrc
    (RingedSite.restrictComplex (ringedSite Y.sheaf) M U)
  refine StacksDraft.TotalComplexQuasiIso.isZero_homology_of_isZero_X n ?_
  rw [IsZero.iff_id_eq_zero]
  exact (HomologicalComplex.id_f _ n).symm.trans
    (congrArg (fun φ => HomologicalComplex.Hom.f φ n) (hC.eq_of_src (𝟙 _) 0))

/-- The opens of `Y` over which the ideal sheaf has a Koszul presentation of length `r`, or over
which it contains the unit section. -/
def KoszulCoverIndex (r : ℕ) : Type u :=
  {d : KoszulPresentation Y J // d.r = r} ⊕ {U : Opens Y.carrier //
    (1 : Y.presheaf.obj (op U)) ∈ J.obj (op U)}

/-- The open attached to an index of the cover. -/
def KoszulCoverIndex.U {r : ℕ} : KoszulCoverIndex J r → Opens Y.carrier
  | Sum.inl d => d.1.U
  | Sum.inr U => U.1

omit [HasSheafify (Opens.grothendieckTopology Y.carrier) AddCommGrpCat.{u}]
  [(Opens.grothendieckTopology Y.carrier).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    HasSheafify ((Opens.grothendieckTopology Y.carrier).over V) AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    ((Opens.grothendieckTopology Y.carrier).over V).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier, HasSheafify (Opens.grothendieckTopology ↥V) AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    (Opens.grothendieckTopology ↥V).WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- If near every point of the support of the quotient the ideal sheaf has a Koszul
presentation of length `r`, these presentations and the opens off the support cover `Y`. -/
theorem coversTop_koszulCoverIndex {r : ℕ}
    (hr : ∀ x ∈ idealQuotientSupport Y J, ∃ d : KoszulPresentation Y J, x ∈ d.U ∧ d.r = r) :
    (Opens.grothendieckTopology Y.carrier).CoversTop (KoszulCoverIndex.U J (r := r)) := by
  refine (Opens.coversTop_iff _ _).mpr (IsOpenCover.mk ?_)
  refine SetLike.ext fun x => ⟨fun _ => Opens.mem_top x, fun _ => ?_⟩
  by_cases hx : x ∈ idealQuotientSupport Y J
  · obtain ⟨d, hxd, hdr⟩ := hr x hx
    exact Opens.mem_iSup.mpr ⟨Sum.inl ⟨d, hdr⟩, hxd⟩
  · obtain ⟨U, hxU, h1⟩ := (notMem_idealQuotientSupport_iff J x).mp hx
    exact Opens.mem_iSup.mpr ⟨Sum.inr ⟨U, h1⟩, hxU⟩

include eL hI e in
/-- **The Ext sheaves of the quotient into the structure sheaf vanish outside the length.** If
near every point of the support of `O_Y/J` the ideal sheaf `J` is generated by a sequence of
length `r` whose Koszul complex is acyclic in positive degrees, then for a complex `L`
presenting `O_Y/J` and a K-injective complex `I` presenting `O_Y`, the cohomology sheaves of
`𝓗om^•(L, I)` vanish in every degree `n ≠ r`. -/
theorem isZero_homology_sheafHomComplex_of_ne {r : ℕ}
    (hr : ∀ x ∈ idealQuotientSupport Y J, ∃ d : KoszulPresentation Y J, x ∈ d.U ∧ d.r = r)
    {n : ℤ} (hn : n ≠ r) :
    IsZero ((RingedSite.sheafHomComplex (ringedSite Y.sheaf) L I).obj.homology n) := by
  refine Stacks.SheafOfModules.isZero_of_coversTop (coversTop_koszulCoverIndex J hr) _ ?_
  rintro (d | ⟨U, h1⟩)
  · exact isZero_over_homology_sheafHomComplex_of_presentation J eL I hI e d.1
      (by rwa [d.2])
  · exact isZero_over_homology_sheafHomComplex_of_one_mem J eL U h1 I n

/-! ### The top degree -/

variable (Qc : CochainComplex (_root_.SheafOfModules.{u} (structureSheafRing Y)) ℤ)
  (hQc : Qc.IsKInjective)
  (eQ : DerivedCategory.Q.obj
      ((single (_root_.SheafOfModules.{u} (structureSheafRing Y)) (ComplexShape.up ℤ) 0).obj
        (cokernel J.ι)) ≅ DerivedCategory.Q.obj Qc)

/-- The restriction to an open subspace of a K-injective complex presenting `O_Y/J`, read
against the quotient of the structure sheaf there by a Koszul presentation of `J`. -/
def openSubspaceRestrictQuotientModelIso (d : KoszulPresentation Y J) :
    DerivedCategory.Q.obj (openSubspaceRestrictComplex d.U Qc) ≅
      KoszulChainData.quotientDerived (openSubspace d.U).sheaf
        (φ := koszulHomOfSections (openSubspace d.U).sheaf
          fun j => sectionOnRestriction Y d.U (d.f j)) :=
  (openSubspaceRestrictSingleDerivedIso d.U (cokernel J.ι) 0 Qc hQc eQ).symm ≪≫
    DerivedCategory.Q.mapIso ((single _ (ComplexShape.up ℤ) 0).mapIso
      (koszulRestrictedQuotientIso d.U d.f J.ι
        (fun W => sectionIdeal_sliceIdealOfSections_eq d.U d.f J d.generated W)))

omit [∀ V : Opens Y.carrier,
    HasSheafify ((Opens.grothendieckTopology Y.carrier).over V) AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    ((Opens.grothendieckTopology Y.carrier).over V).WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- Two chain maps into a K-injective complex which agree in the derived category stay equal
there after restriction to an open subspace: they are homotopic, and restriction carries
homotopies to homotopies. -/
theorem Q_map_openSubspaceRestrictComplexMap_eq (U : Opens Y.carrier)
    {M : CochainComplex (_root_.SheafOfModules.{u} (structureSheafRing Y)) ℤ}
    {N : CochainComplex (_root_.SheafOfModules.{u} (structureSheafRing Y)) ℤ} [N.IsKInjective]
    {a b : M ⟶ N} (h : DerivedCategory.Q.map a = DerivedCategory.Q.map b) :
    DerivedCategory.Q.map (openSubspaceRestrictComplexMap U a) =
      DerivedCategory.Q.map (openSubspaceRestrictComplexMap U b) := by
  have hK : (HomotopyCategory.quotient _ (ComplexShape.up ℤ)).map a =
      (HomotopyCategory.quotient _ (ComplexShape.up ℤ)).map b := by
    refine (CochainComplex.IsKInjective.Qh_map_bijective _ N).injective ?_
    have ha := DerivedCategory.quotientCompQhIso_hom_naturality
      (C := _root_.SheafOfModules.{u} (structureSheafRing Y)) a
    have hb := DerivedCategory.quotientCompQhIso_hom_naturality
      (C := _root_.SheafOfModules.{u} (structureSheafRing Y)) b
    rw [h, ← hb] at ha
    exact (cancel_mono _).1 ha
  exact DerivedCategory.Q_map_eq_of_homotopy _
    ((openSubspaceEquiv U).functor.mapHomotopy
      ((_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) U).mapHomotopy
        (HomotopyCategory.homotopyOfEq _ _ hK)))

omit [∀ V : Opens Y.carrier,
    HasSheafify ((Opens.grothendieckTopology Y.carrier).over V) AddCommGrpCat.{u}] in
/-- The identification of the restricted quotient with the Koszul quotient carries the
restricted quotient map to the Koszul quotient map. -/
theorem openSubspaceRestrict_π_comp_koszulRestrictedQuotientIso (d : KoszulPresentation Y J) :
    (openSubspaceEquiv d.U).functor.map
        ((_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) d.U).map
          (quotientπ J)) ≫
      (koszulRestrictedQuotientIso d.U d.f J.ι
        (fun W => sectionIdeal_sliceIdealOfSections_eq d.U d.f J d.generated W)).hom =
      koszulQuotientπ (koszulHomOfSections (openSubspace d.U).sheaf
        fun j => sectionOnRestriction Y d.U (d.f j)) :=
  openSubspaceRestrict_π_comp_quotientIsoOfSlice d.U J.ι _ _

omit [HasSheafify (Opens.grothendieckTopology Y.carrier) AddCommGrpCat.{u}]
  [(Opens.grothendieckTopology Y.carrier).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    HasSheafify ((Opens.grothendieckTopology Y.carrier).over V) AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    ((Opens.grothendieckTopology Y.carrier).over V).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier, HasSheafify (Opens.grothendieckTopology ↥V) AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    (Opens.grothendieckTopology ↥V).WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- Restriction of morphisms of complexes to an open subspace respects composition. -/
theorem openSubspaceRestrictComplexMap_comp (U : Opens Y.carrier)
    {M M' M'' : CochainComplex (_root_.SheafOfModules.{u} (structureSheafRing Y)) ℤ}
    (a : M ⟶ M') (b : M' ⟶ M'') :
    openSubspaceRestrictComplexMap U (a ≫ b) =
      openSubspaceRestrictComplexMap U a ≫ openSubspaceRestrictComplexMap U b := by
  dsimp only [openSubspaceRestrictComplexMap]
  rw [Functor.map_comp]
  exact Functor.map_comp _ _ _

/-- The interchange of restriction to an open subspace and `HomologicalComplex.single` is
natural. -/
theorem openSubspaceRestrictSingleIso_natural (U : Opens Y.carrier)
    {M M' : _root_.SheafOfModules.{u} (structureSheafRing Y)} (p : M ⟶ M') :
    openSubspaceRestrictComplexMap U
        ((single (_root_.SheafOfModules.{u} (structureSheafRing Y)) (ComplexShape.up ℤ) 0).map p) ≫
      (openSubspaceRestrictSingleIso U M' 0).hom =
    (openSubspaceRestrictSingleIso U M 0).hom ≫
      (single _ (ComplexShape.up ℤ) 0).map ((openSubspaceEquiv U).functor.map
        ((_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) U).map p)) := by
  have h1 := (HomologicalComplex.singleMapHomologicalComplex
    (_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) U)
    (ComplexShape.up ℤ) 0).hom.naturality p
  have h2 := (HomologicalComplex.singleMapHomologicalComplex (openSubspaceEquiv U).functor
    (ComplexShape.up ℤ) 0).hom.naturality
      ((_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) U).map p)
  have key : ∀ {C D : Type (u + 1)} [Category.{u} C] [Category.{u} D] (P : C ⥤ D)
      {A A' B B' : C} {E E' : D} (x : A ⟶ A') (a : A ⟶ B) (a' : A' ⟶ B') (y : B ⟶ B')
      (b : P.obj B ⟶ E) (b' : P.obj B' ⟶ E') (z : E ⟶ E'),
      x ≫ a' = a ≫ y → P.map y ≫ b' = b ≫ z → P.map x ≫ P.map a' ≫ b' = (P.map a ≫ b) ≫ z := by
    intro C D _ _ P A A' B B' E E' x a a' y b b' z e1 e2
    rw [← P.map_comp_assoc, e1, P.map_comp_assoc, e2, Category.assoc]
  exact key (openSubspacePushComplex U) _ _ _ _ _ _ _ h1 h2

/-- The restricted resolution of the structure sheaf, on morphisms. -/
theorem openSubspaceRestrictUnitDerivedIso_inv (U : Opens Y.carrier) :
    (openSubspaceRestrictUnitDerivedIso I hI e U).inv =
      DerivedCategory.Q.map (openSubspaceRestrictSingleIso U
          (_root_.SheafOfModules.unit (structureSheafRing Y)) 0).inv ≫
        (openSubspaceRestrictDerivedIso U _ I hI e).hom := by
  dsimp only [openSubspaceRestrictUnitDerivedIso, openSubspaceRestrictSingleDerivedIso,
    Iso.trans_hom, Iso.symm_hom, Iso.trans_inv, Iso.symm_inv, Functor.mapIso_hom,
    Functor.mapIso_inv]

/-- The restricted resolution of the quotient, on morphisms. -/
theorem openSubspaceRestrictQuotientModelIso_hom (d : KoszulPresentation Y J) :
    (openSubspaceRestrictQuotientModelIso J Qc hQc eQ d).hom =
      (openSubspaceRestrictDerivedIso d.U _ Qc hQc eQ).inv ≫
        DerivedCategory.Q.map (openSubspaceRestrictSingleIso d.U (cokernel J.ι) 0).hom ≫
        DerivedCategory.Q.map ((single _ (ComplexShape.up ℤ) 0).map
          (koszulRestrictedQuotientIso d.U d.f J.ι
            (fun W => sectionIdeal_sliceIdealOfSections_eq d.U d.f J d.generated W)).hom) := by
  dsimp only [openSubspaceRestrictQuotientModelIso, openSubspaceRestrictSingleDerivedIso,
    Iso.trans_hom, Iso.symm_hom, Iso.trans_inv, Iso.symm_inv, Functor.mapIso_hom,
    Functor.mapIso_inv]
  simp only [Category.assoc]
  rfl

include hQc in
/-- A morphism of K-injective models lying over the quotient map `O_Y ⟶ O_Y/J` restricts, over
a Koszul presentation, to one lying over the Koszul quotient map. -/
theorem restrict_comp_eq_quotientDerivedπ (d : KoszulPresentation Y J) (g : I ⟶ Qc)
    (hg : e.hom ≫ DerivedCategory.Q.map g ≫ eQ.inv =
      DerivedCategory.Q.map ((single (_root_.SheafOfModules.{u} (structureSheafRing Y))
        (ComplexShape.up ℤ) 0).map (quotientπ J))) :
    (openSubspaceRestrictUnitDerivedIso I hI e d.U).inv ≫
        DerivedCategory.Q.map (openSubspaceRestrictComplexMap d.U g) ≫
        (openSubspaceRestrictQuotientModelIso J Qc hQc eQ d).hom =
      KoszulChainData.quotientDerivedπ (openSubspace d.U).sheaf
        (φ := koszulHomOfSections (openSubspace d.U).sheaf
          fun j => sectionOnRestriction Y d.U (d.f j)) := by
  have := hI
  have := hQc
  set sI := CochainComplex.realizeDerivedIso _ I e
  set tQ := CochainComplex.realizeDerivedIso _ Qc eQ
  have hs : DerivedCategory.Q.map sI = e.hom := CochainComplex.Q_map_realizeDerivedIso _ I e
  have ht : DerivedCategory.Q.map tQ = eQ.hom := CochainComplex.Q_map_realizeDerivedIso _ Qc eQ
  have hglob : DerivedCategory.Q.map (sI ≫ g) = DerivedCategory.Q.map
      ((single (_root_.SheafOfModules.{u} (structureSheafRing Y)) (ComplexShape.up ℤ) 0).map
        (quotientπ J) ≫ tQ) := by
    rw [Functor.map_comp, Functor.map_comp, hs, ht, ← hg]
    simp
  have hloc := Q_map_openSubspaceRestrictComplexMap_eq d.U hglob
  rw [openSubspaceRestrictComplexMap_comp, openSubspaceRestrictComplexMap_comp,
    Functor.map_comp, Functor.map_comp] at hloc
  rw [openSubspaceRestrictUnitDerivedIso_inv, openSubspaceRestrictQuotientModelIso_hom]
  have hnat' := congrArg DerivedCategory.Q.map
    (openSubspaceRestrictSingleIso_natural d.U (quotientπ J))
  rw [Functor.map_comp, Functor.map_comp] at hnat'
  have skel : ∀ {C : Type (u + 1)} [Category.{u + 1} C] {S R R' S' T IU QU : C}
      (q1 : S ⟶ R) (r : R ⟶ S) (p : R ⟶ R') (q2 : R' ⟶ S') (m : S ⟶ S') (q3 : S' ⟶ T)
      (k : S ⟶ T) (s : R ⟶ IU) (g : IU ⟶ QU) (t : R' ≅ QU),
      q1 ≫ r = 𝟙 S → p ≫ q2 = r ≫ m → m ≫ q3 = k → s ≫ g = p ≫ t.hom →
        (q1 ≫ s) ≫ g ≫ t.inv ≫ q2 ≫ q3 = k := by
    intro C _ S R R' S' T IU QU q1 r p q2 m q3 k s g t e1 e2 e3 e4
    rw [Category.assoc, reassoc_of% e4, Iso.hom_inv_id_assoc, reassoc_of% e2,
      reassoc_of% e1, e3]
  refine skel _ _ _ _ _ _ _ _ _ (openSubspaceRestrictDerivedIso d.U _ Qc hQc eQ)
    (DerivedCategory.Q.mapIso (openSubspaceRestrictSingleIso d.U
      (_root_.SheafOfModules.unit (structureSheafRing Y)) 0)).inv_hom_id hnat' ?_ hloc
  refine (Functor.map_comp _ _ _).symm.trans ?_
  refine (congrArg DerivedCategory.Q.map
    ((single _ (ComplexShape.up ℤ) 0).map_comp _ _).symm).trans ?_
  exact congrArg (fun φ => DerivedCategory.Q.map ((single _ (ComplexShape.up ℤ) 0).map φ))
    (openSubspaceRestrict_π_comp_koszulRestrictedQuotientIso J d)

include eL hI e hQc eQ in
/-- **Over a Koszul presentation of `J` of length `r`, a morphism of K-injective models lying
over the quotient map `O_Y ⟶ O_Y/J` induces an isomorphism on the degree-`r` cohomology sheaves
of `𝓗om^•(L, -)`.** -/
theorem isIso_over_homologyMap_homMap_of_presentation (d : KoszulPresentation Y J) (g : I ⟶ Qc)
    (hg : e.hom ≫ DerivedCategory.Q.map g ≫ eQ.inv =
      DerivedCategory.Q.map ((single (_root_.SheafOfModules.{u} (structureSheafRing Y))
        (ComplexShape.up ℤ) 0).map (quotientπ J))) :
    IsIso ((_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) d.U).map
      (homologyMap (RingedSite.homMap (ringedSite Y.sheaf) (𝟙 L) g) (d.r : ℤ))) := by
  let Rc := (openSubspace d.U).sheaf
  let φ := koszulHomOfSections Rc fun j => sectionOnRestriction Y d.U (d.f j)
  have := quasiIso_augmentation_of_presentation d
  have : (openSubspaceRestrictComplex d.U I).IsKInjective :=
    isKInjective_openSubspaceRestrictComplex d.U I hI
  have : (openSubspaceRestrictComplex d.U Qc).IsKInjective :=
    isKInjective_openSubspaceRestrictComplex d.U Qc hQc
  have h := KoszulChainData.isIso_homologyMap_homMap_of_comp Rc (koszulChainData φ) _
    (freeHomEquiv_koszulHomOfSections Rc _) (openSubspaceRestrictQuotientDerivedIso J eL d)
    (openSubspaceRestrictUnitDerivedIso I hI e d.U)
    (openSubspaceRestrictQuotientModelIso J Qc hQc eQ d) (openSubspaceRestrictComplexMap d.U g)
    (restrict_comp_eq_quotientDerivedπ J I hI e Qc hQc eQ d g hg)
  have hid : openSubspaceRestrictComplexMap d.U (𝟙 L) = 𝟙 _ :=
    (congrArg (openSubspacePushComplex d.U).map (CategoryTheory.Functor.map_id _ _)).trans
      (CategoryTheory.Functor.map_id _ _)
  have hsq := sheafHomHomologyOpenSubspaceIso_natural d.U (𝟙 L) g (d.r : ℤ)
  rw [hid] at hsq
  have : IsIso ((openSubspaceEquiv d.U).functor.map
      ((_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) d.U).map
        (homologyMap (RingedSite.homMap (ringedSite Y.sheaf) (𝟙 L) g) (d.r : ℤ)))) := by
    have : IsIso ((openSubspaceEquiv d.U).functor.map
        ((_root_.SheafOfModules.overFunctor.{u} (structureSheafRing Y) d.U).map
          (homologyMap (RingedSite.homMap (ringedSite Y.sheaf) (𝟙 L) g) (d.r : ℤ))) ≫
        (sheafHomHomologyOpenSubspaceIso d.U L Qc (d.r : ℤ)).hom) := by
      rw [hsq]
      exact IsIso.comp_isIso' (Iso.isIso_hom _) h
    exact @IsIso.of_isIso_comp_right _ _ _ _ _ _ _ (Iso.isIso_hom _) this
  exact isIso_of_reflects_iso _ (openSubspaceEquiv d.U).functor

include eL hI e hQc eQ in
/-- **The top degree of [Stacks, Tag 0BQZ].** If near every point of the support of `O_Y/J` the
ideal sheaf `J` is generated by a sequence of length `r` whose Koszul complex is acyclic in
positive degrees, then a morphism `g : I ⟶ Q` of K-injective models of `O_Y` and `O_Y/J` lying
over the quotient map induces an isomorphism
`Hʳ(𝓗om^•(L, I)) ≅ Hʳ(𝓗om^•(L, Q))`, that is, `𝓔xtʳ(O_Y/J, O_Y) ≅ 𝓔xtʳ(O_Y/J, O_Y/J)`. -/
theorem isIso_homologyMap_homMap_quotientπ {r : ℕ}
    (hr : ∀ x ∈ idealQuotientSupport Y J, ∃ d : KoszulPresentation Y J, x ∈ d.U ∧ d.r = r)
    (g : I ⟶ Qc)
    (hg : e.hom ≫ DerivedCategory.Q.map g ≫ eQ.inv =
      DerivedCategory.Q.map ((single (_root_.SheafOfModules.{u} (structureSheafRing Y))
        (ComplexShape.up ℤ) 0).map (quotientπ J))) :
    IsIso (homologyMap (RingedSite.homMap (ringedSite Y.sheaf) (𝟙 L) g) (r : ℤ)) := by
  refine Stacks.AlgebraicGeometry.QcohRestrictEquiv.isIso_of_isIso_over
    (coversTop_koszulCoverIndex J hr) _ ?_
  rintro (⟨d, hd⟩ | ⟨U, h1⟩)
  · subst hd
    exact isIso_over_homologyMap_homMap_of_presentation J eL I hI e Qc hQc eQ d g hg
  · exact StacksDraft.TotalComplexQuasiIso.isIso_of_isZero _
      (isZero_over_homology_sheafHomComplex_of_one_mem J eL U h1 I _)
      (isZero_over_homology_sheafHomComplex_of_one_mem J eL U h1 Qc _)

end Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

open Stacks.Sites Stacks.SheafOfModules Stacks.RegularSequence
open Stacks.AlgebraicGeometry.QuasiRegular Stacks.RingedSpace

attribute [local instance] HasDerivedCategory.standard

variable {Y : RingedSpace.{u, u}} (J : (structureSheafModule Y).Submodule)
  [HasSheafify (Opens.grothendieckTopology Y.carrier) AddCommGrpCat.{u}]
  [(Opens.grothendieckTopology Y.carrier).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    HasSheafify ((Opens.grothendieckTopology Y.carrier).over V) AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    ((Opens.grothendieckTopology Y.carrier).over V).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier, HasSheafify (Opens.grothendieckTopology ↥V) AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    (Opens.grothendieckTopology ↥V).WEqualsLocallyBijective AddCommGrpCat.{u}]
  {L : CochainComplex (_root_.SheafOfModules.{u} (structureSheafRing Y)) ℤ}
  (eL : L ≅ (single (_root_.SheafOfModules.{u} (structureSheafRing Y)) (ComplexShape.up ℤ) 0).obj
    (cokernel J.ι))
  (I : CochainComplex (_root_.SheafOfModules.{u} (structureSheafRing Y)) ℤ)
  (hI : I.IsKInjective)
  (e : DerivedCategory.Q.obj
      ((single (_root_.SheafOfModules.{u} (structureSheafRing Y)) (ComplexShape.up ℤ) 0).obj
        (_root_.SheafOfModules.unit (structureSheafRing Y))) ≅ DerivedCategory.Q.obj I)
  (Qc : CochainComplex (_root_.SheafOfModules.{u} (structureSheafRing Y)) ℤ)
  (hQc : Qc.IsKInjective)
  (eQ : DerivedCategory.Q.obj
      ((single (_root_.SheafOfModules.{u} (structureSheafRing Y)) (ComplexShape.up ℤ) 0).obj
        (cokernel J.ι)) ≅ DerivedCategory.Q.obj Qc)

/-- The quasi-isomorphism from a complex presenting `O_Y/J` to a K-injective model of it. -/
def quotientModelHom : L ⟶ Qc :=
  haveI := hQc
  CochainComplex.realizeDerivedIso L Qc (DerivedCategory.Q.mapIso eL ≪≫ eQ)

omit [∀ V : Opens Y.carrier,
    HasSheafify ((Opens.grothendieckTopology Y.carrier).over V) AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    ((Opens.grothendieckTopology Y.carrier).over V).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier, HasSheafify (Opens.grothendieckTopology ↥V) AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    (Opens.grothendieckTopology ↥V).WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- The morphism `quotientModelHom` is a quasi-isomorphism. -/
theorem quasiIso_quotientModelHom : QuasiIso (quotientModelHom J eL Qc hQc eQ) :=
  have := hQc
  CochainComplex.quasiIso_realizeDerivedIso _ _ _

omit [∀ V : Opens Y.carrier, HasSheafify (Opens.grothendieckTopology ↥V) AddCommGrpCat.{u}]
  [∀ V : Opens Y.carrier,
    (Opens.grothendieckTopology ↥V).WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- The map of sheaf hom complexes `𝓗om^•(Q, Q) ⟶ 𝓗om^•(L, Q)` induced by `quotientModelHom` is a
quasi-isomorphism. -/
theorem quasiIso_homMap_quotientModelHom :
    QuasiIso (RingedSite.homMap (ringedSite Y.sheaf) (quotientModelHom J eL Qc hQc eQ)
      (𝟙 Qc)) := by
  let Q' : CochainComplex (_root_.SheafOfModules.{u}
    (Stacks.SheafOfModules.Tensor.ringSheaf (ringedSite Y.sheaf).O)) ℤ := Qc
  have : Q'.IsKInjective := hQc
  let L' : CochainComplex (_root_.SheafOfModules.{u}
    (Stacks.SheafOfModules.Tensor.ringSheaf (ringedSite Y.sheaf).O)) ℤ := L
  let q' : L' ⟶ Q' := quotientModelHom J eL Qc hQc eQ
  have : QuasiIso q' := quasiIso_quotientModelHom J eL Qc hQc eQ
  exact RingedSite.homMap_quasiIso (ringedSite Y.sheaf) (𝟙 Q') q'

/-- The cohomology sheaves of `𝓗om^•(Q, Q)` are those of `𝓗om^•(L, Q)`. -/
def endComplexHomologyIso (n : ℤ) :
    (RingedSite.sheafHomComplex (ringedSite Y.sheaf) Qc Qc).obj.homology n ≅
      (RingedSite.sheafHomComplex (ringedSite Y.sheaf) L Qc).obj.homology n :=
  haveI := quasiIso_homMap_quotientModelHom J eL Qc hQc eQ
  asIso (homologyMap (RingedSite.homMap (ringedSite Y.sheaf)
    (quotientModelHom J eL Qc hQc eQ) (𝟙 Qc)) n)

/-- **`𝓔xtʳ(O_Y/J, O_Y) ≅ 𝓔xtʳ(O_Y/J, O_Y/J)`, read on models**: for constant-length Koszul
presentations, the degree-`r` cohomology sheaf of `𝓗om^•(L, I)` is that of `𝓗om^•(Q, Q)`, the
degree-`r` piece of the self-Ext algebra of `O_Y/J` on the model `Q`. -/
def homologyTopIso {r : ℕ}
    (hr : ∀ x ∈ idealQuotientSupport Y J, ∃ d : KoszulPresentation Y J, x ∈ d.U ∧ d.r = r)
    (g : I ⟶ Qc)
    (hg : e.hom ≫ DerivedCategory.Q.map g ≫ eQ.inv =
      DerivedCategory.Q.map ((single (_root_.SheafOfModules.{u} (structureSheafRing Y))
        (ComplexShape.up ℤ) 0).map (quotientπ J))) :
    (RingedSite.sheafHomComplex (ringedSite Y.sheaf) L I).obj.homology r ≅
      (RingedSite.sheafHomComplex (ringedSite Y.sheaf) Qc Qc).obj.homology r :=
  haveI := isIso_homologyMap_homMap_quotientπ J eL I hI e Qc hQc eQ hr g hg
  asIso (homologyMap (RingedSite.homMap (ringedSite Y.sheaf) (𝟙 L) g) (r : ℤ)) ≪≫
    (endComplexHomologyIso J eL Qc hQc eQ (r : ℤ)).symm

end Stacks.AlgebraicGeometry.RegularIdealSheaf
