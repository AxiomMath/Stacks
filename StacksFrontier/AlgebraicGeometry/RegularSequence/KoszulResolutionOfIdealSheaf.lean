module

public import StacksFrontier.Algebra.Homology.StrictlyPerfectRestriction
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularImmersion.KoszulRegularSmoothCover
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Regular
public import StacksFrontier.AlgebraicGeometry.RegularSequence.KoszulAcyclicity

/-!
# A Koszul-regular ideal sheaf is locally resolved by a Koszul complex

Let `X` be a ringed space and `J ⊆ O_X` a Koszul-regular sheaf of ideals in the sense of Stacks
tag 063D: near every point of the support of `O_X/J` the ideal is generated by a sequence
`f₁, …, f_r` of sections over an open `U` whose Koszul complex is acyclic in positive degrees.
On that `U` the Koszul complex of sheaves is then a resolution of the quotient: its augmentation

`K_•(O_U, f₁, …, f_r) ⟶ (O_U/I)[0]`

is a quasi-isomorphism.

Two passages separate the hypothesis from the conclusion. The Koszul complex of sheaves is built
from a morphism `(O♯)ʳ ⟶ O♯` of sheaves of modules on a space whose *global* sections are the
`fᵢ`, while the hypothesis speaks of sections over `U`; so the statement is read on the restricted
ringed space `X|_U`, whose global sections over `U` are the sections of `O_X` over `U`. And the
hypothesis is germwise in the stalks of `O_X` at points of `U`, while the conclusion is germwise
in the stalks of `O_X|_U`; those two rings are identified by the canonical isomorphism of stalks
along an open immersion, which carries one sequence of germs to the other, and Koszul-regularity
transports along a ring isomorphism.

## Main definitions

* `Stacks.RegularSequence.koszulHomOfSections`: the morphism `(O♯)ʳ ⟶ O♯` of sheaves of modules
  attached to a sequence of `r` global sections of `O♯`.

## Main results

* `Stacks.RegularSequence.freeHomEquiv_koszulHomOfSections`: that morphism has the prescribed
  sections as its values on the tautological generators, which is the hypothesis the stalk
  comparison for the Koszul complex takes.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.isKoszulRegular_germSequence_restrict`:
  Koszul-regularity of the germs of a sequence of sections over `U`, read on the restricted
  ringed space.
* `Stacks.RegularSequence.quasiIso_koszulAugmentation_restrict`: **the Koszul complex of a
  sequence of sections over `U` whose Koszul complex is exact in positive degrees is a resolution
  of the quotient**, on the ringed space `X|_U`.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf`
  `.exists_quasiIso_koszulAugmentation_of_isKoszulRegularIdealSheaf`: **a Koszul-regular ideal
  sheaf is, near every point of the support of its quotient, generated by a sequence whose
  Koszul complex of sheaves resolves the quotient.**

## Implementation notes

The morphism attached to a sequence of global sections is built from the universal property of a
free sheaf of modules, `SheafOfModules.freeHomEquiv`, whose data is a family of *sections* — that
is, compatible families over all opens — rather than of values over a single open. On a
topological space a section is determined by, and may be built from, its value over the whole
space, by restriction; that is `Stacks.PresheafOfModules.sectionOfTop`, and it is what turns the
sequence `f₁, …, f_r` into the required family. The index type of the free sheaf is
`ULift (Fin r)`, which is why the generators are indexed by `ULift.up k`.

The transport of Koszul-regularity along the isomorphism of stalks is
`Stacks.AlgebraicGeometry.isKoszulRegular_map_ringEquiv`, applied to the *inverse* of
`Stacks.AlgebraicGeometry.RegularIdealSheaf.restrictStalkEquiv`: the comparison lemma available
is the one sending the germs on the restricted space to the germs on `X`, and the hypothesis is
about the latter.

## References

* [Stacks Project, Tag 062K](https://stacks.math.columbia.edu/tag/062K)
* [Stacks Project, Tag 063C](https://stacks.math.columbia.edu/tag/063C)
* [Stacks Project, Tag 063D](https://stacks.math.columbia.edu/tag/063D)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Sheaf Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.RingedSpace

universe u

namespace Stacks.RegularSequence

variable {X : TopCat.{u}} (Osharp : Sheaf (Opens.grothendieckTopology ↥X) CommRingCat.{u})
  {r : ℕ} (f : Fin r → ↑(Osharp.obj.obj (op (⊤ : Opens ↥X))))

/-- **The morphism `(O♯)ʳ ⟶ O♯` attached to a sequence of `r` global sections of `O♯`**: the
morphism out of the free sheaf of modules on `r` generators sending the `k`-th tautological
generator to `f k`, that is, to the section of `O♯` obtained by restricting `f k` to every open.

Its Koszul complex is the Koszul complex of the sequence `f₁, …, f_r`. -/
def koszulHomOfSections :
    koszulFreeSheaf Osharp r ⟶
      SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp) :=
  (SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).freeHomEquiv.symm
    fun k => Stacks.PresheafOfModules.sectionOfTop _ (f k.down)

/-- **The morphism attached to a sequence of global sections takes the prescribed values on the
tautological generators.** This is the compatibility hypothesis of the stalk comparison for the
Koszul complex of a sequence of global sections. -/
theorem freeHomEquiv_koszulHomOfSections (k : Fin r) :
    ((SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp)).freeHomEquiv
      (koszulHomOfSections Osharp f) (ULift.up k)).val (op (⊤ : Opens ↥X)) = f k := by
  rw [koszulHomOfSections, Equiv.apply_symm_apply]
  exact Stacks.PresheafOfModules.sectionOfTop_val_top _ _

/-- **The Koszul complex of a sequence of global sections whose germs are everywhere
Koszul-regular is a resolution of the quotient.** This is
`Stacks.RegularSequence.quasiIso_koszulAugmentation_of_forall_germ_isKoszulRegular` for the
morphism attached to the sequence, whose compatibility hypothesis is automatic. -/
theorem quasiIso_koszulAugmentation_koszulHomOfSections
    (h : ∀ x : ↥X, Koszul.IsKoszulRegular fun k =>
      TopCat.Presheaf.germ Osharp.obj (⊤ : Opens ↥X) x (Opens.mem_top x) (f k)) :
    QuasiIso (koszulAugmentation (koszulHomOfSections Osharp f)) :=
  quasiIso_koszulAugmentation_of_forall_germ_isKoszulRegular _ f
    (freeHomEquiv_koszulHomOfSections Osharp f) h

end Stacks.RegularSequence

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

open Stacks.AlgebraicGeometry.QuasiRegular

/-- **Koszul-regularity of the germs of a sequence of sections over `U`, read on the restricted
ringed space.** The isomorphism of stalks along the open immersion `X|_U ⟶ X` carries the germs
at `x` of the sections regarded as global sections of `X|_U` to the germs at `x` of the original
sections, and Koszul-regularity transports along a ring isomorphism. -/
theorem isKoszulRegular_germSequence_restrict (X : RingedSpace.{u}) (U : Opens X) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op U)) (x : ↥(X.restrict U.isOpenEmbedding))
    (h : Koszul.IsKoszulRegular (germFamily X U f x.1 x.2)) :
    Koszul.IsKoszulRegular (germSequence (X.restrict U.isOpenEmbedding)
      (fun j => sectionOnRestriction X U (f j)) x) := by
  have key := Stacks.AlgebraicGeometry.isKoszulRegular_map_ringEquiv
    (restrictStalkEquiv X U x.1 x.2).symm h
  have heq : (fun k => (restrictStalkEquiv X U x.1 x.2).symm (germFamily X U f x.1 x.2 k)) =
      germSequence (X.restrict U.isOpenEmbedding)
        (fun j => sectionOnRestriction X U (f j)) x := by
    funext k
    rw [← restrictStalkEquiv_germSequence X U f x.1 x.2 k]
    exact (restrictStalkEquiv X U x.1 x.2).symm_apply_apply _
  rwa [heq] at key

end Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.RegularSequence

open Stacks.AlgebraicGeometry.RegularIdealSheaf Stacks.AlgebraicGeometry.QuasiRegular

/-- **The Koszul complex of a sequence of sections over `U` whose Koszul complex is exact in
positive degrees is a resolution of the quotient**, on the ringed space `X|_U`. The sequence is
read as a sequence of global sections there, and the positive-degree exactness hypothesis of
Stacks tag 063D is exactly Koszul-regularity of all of its sequences of germs. -/
theorem quasiIso_koszulAugmentation_restrict (X : RingedSpace.{u}) (U : Opens X) {r : ℕ}
    (f : Fin r → X.presheaf.obj (op U))
    (h : IsKoszulSequenceExactOn X U f (fun j => 0 < j)) :
    QuasiIso (koszulAugmentation (koszulHomOfSections (X.restrict U.isOpenEmbedding).sheaf
      (fun j => sectionOnRestriction X U (f j)))) :=
  quasiIso_koszulAugmentation_koszulHomOfSections _ _ fun x =>
    isKoszulRegular_germSequence_restrict X U f x
      ((isKoszulSequenceExactOn_iff_forall_germ_isKoszulRegular X U f).1 h x.1 x.2)

end Stacks.RegularSequence

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

open Stacks.RegularSequence Stacks.AlgebraicGeometry.QuasiRegular

/-- **A Koszul-regular ideal sheaf is locally resolved by a Koszul complex.** Near every point
of the support of `O_X/J` there is an open `U` on which `J` is generated by a sequence
`f₁, …, f_r` of sections whose Koszul complex of sheaves on `X|_U` is a resolution of the
quotient of the structure sheaf by the ideal they generate: the augmentation of that Koszul
complex is a quasi-isomorphism. -/
theorem exists_quasiIso_koszulAugmentation_of_isKoszulRegularIdealSheaf
    (X : RingedSpace.{u}) (J : (structureSheafModule X).Submodule)
    (hJ : IsKoszulRegularIdealSheaf X J) (x : X) (hx : x ∈ idealQuotientSupport X J) :
    ∃ (U : Opens X) (_hx : x ∈ U) (r : ℕ) (f : Fin r → X.presheaf.obj (op U)),
      IsGeneratedByOn X J U f ∧
        QuasiIso (koszulAugmentation (koszulHomOfSections (X.restrict U.isOpenEmbedding).sheaf
          (fun j => sectionOnRestriction X U (f j)))) := by
  obtain ⟨U, hxU, r, f, hK, hG⟩ := hJ x hx
  exact ⟨U, hxU, r, f, hG, quasiIso_koszulAugmentation_restrict X U f hK⟩

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
