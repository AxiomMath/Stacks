open AlgebraicGeometry HomologicalComplex Stacks.ChainComplex

universe u

namespace Stacks.RegularSequence.KoszulChainData

open Stacks.Sites Stacks.SheafOfModules Stacks.SheafOfModules.SheafHomStalk
open Stacks.RegularSequence

attribute [local instance] HasDerivedCategory.standard

variable {X : TopCat.{u}} (Rc : TopCat.Sheaf CommRingCat.{u} X)
  [HasSheafify (Opens.grothendieckTopology ↥X) AddCommGrpCat.{u}]
  [(Opens.grothendieckTopology ↥X).WEqualsLocallyBijective AddCommGrpCat.{u}]
  [HasWeakSheafify (Opens.grothendieckTopology ↥X) CommRingCat.{u}]
  {r : ℕ}
  {A : SheafOfModules.TensorExteriorSymmetricAlgebras (Opens.grothendieckTopology ↥X)
    (koszulFreeSheaf Rc r)}
  {φ : koszulFreeSheaf Rc r ⟶
    SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Rc)}
  (K : KoszulChainData.{u, u, u} A φ)

omit [HasWeakSheafify (Opens.grothendieckTopology ↥X) CommRingCat.{u}] in
/-- **The degree-zero augmentation, followed by the transport onto the quotient.** It is the
trivialisation of the degree-zero term of the Koszul complex followed by the quotient map.

This is `chainXZeroIsoUnit_comp_quotientPi` — the degree-zero component of the augmentation is the
trivialisation followed by `quotientPi` — composed with `quotientPi_comp_eqToHom`, which cancels
the transport against `quotientPi`. -/
theorem augSingle_f_zero_comp_eqToHom :
    (augSingle Rc K).f 0 ≫
        eqToHom (show ((single (StructureSheafModules Rc) (ComplexShape.up ℤ) 0).obj
            (quotient Rc (φ := φ))).X ((0 : ℤ) - 0) = quotient Rc (φ := φ) from
          by rw [sub_self]; rfl) =
      K.chainXZeroIsoUnit.hom ≫ koszulQuotientπ.{u, u, u} φ := by
  refine Eq.trans (congrArg (fun z => z ≫ eqToHom (show
      ((single (StructureSheafModules Rc) (ComplexShape.up ℤ) 0).obj
        (quotient Rc (φ := φ))).X ((0 : ℤ) - 0) = quotient Rc (φ := φ) from
      by rw [sub_self]; rfl)) (chainXZeroIsoUnit_comp_quotientPi Rc K).symm) ?_
  refine Eq.trans (Category.assoc _ _ _) ?_
  exact congrArg (fun z => K.chainXZeroIsoUnit.hom ≫ z) (quotientPi_comp_eqToHom Rc K)

omit [HasWeakSheafify (Opens.grothendieckTopology ↥X) CommRingCat.{u}] in
/-- **The iterated contraction at propositionally normalised degrees, followed by the
augmentation.** For degrees `p` and `n` that are propositionally `i` and `0`, the `i`-fold
coordinate contraction from `K_p` to `K_{-n}`, read as a map out of `K_i` and followed by the
degree-`n` component of the augmentation and the transport onto the quotient, is the `i`-fold
contraction between the nonnegative degrees of the complex followed by the trivialisation of the
degree-zero term and the quotient map.

Substituting the two equations of integers makes every transport one along an equality of a term
with itself, leaving `tupleCoordKoszulDOf_eq_tupleCoordKoszulD` and
`augSingle_f_zero_comp_eqToHom`. -/
theorem eqToHom_comp_tupleCoordKoszulDOf_comp_augSingle (i : ℕ) (f : Fin i → ULift.{u} (Fin r))
    {p n : ℤ} (hp : p = ((i : ℕ) : ℤ)) (hn : n = 0) (h : -n + ((i : ℕ) : ℤ) = p)
    (hq : ((single (StructureSheafModules Rc) (ComplexShape.up ℤ) 0).obj
      (quotient Rc (φ := φ))).X n = quotient Rc (φ := φ)) :
    eqToHom (congrArg K.chain.X hp.symm) ≫ K.tupleCoordKoszulDOf i f h ≫
        (augSingle Rc K).f n ≫ eqToHom hq =
      K.tupleCoordKoszulD i f ≫ K.chainXZeroIsoUnit.hom ≫ koszulQuotientπ.{u, u, u} φ := by
  subst hp
  subst hn
  refine Eq.trans (congrArg (fun z => z ≫ K.tupleCoordKoszulDOf i f h ≫
    (augSingle Rc K).f 0 ≫ eqToHom hq) (eqToHom_refl _ _)) ?_
  refine Eq.trans (Category.id_comp _) ?_
  refine Eq.trans (congrArg (fun z => z ≫ (augSingle Rc K).f 0 ≫ eqToHom hq)
    (K.tupleCoordKoszulDOf_eq_tupleCoordKoszulD i f h)) ?_
  exact congrArg (fun z => K.tupleCoordKoszulD i f ≫ z) (augSingle_f_zero_comp_eqToHom Rc K)

omit [HasWeakSheafify (Opens.grothendieckTopology ↥X) CommRingCat.{u}] in
/-- **The degree-zero term of the complex, read from the exterior power, is the structure
sheaf.** Both `chainXIso` and `chainXZeroIsoUnit` begin with the transport along the equality of
objects `chain_X`, in opposite directions, so the two transports cancel and what is left is the
degree-zero identification of the exterior algebra.

This is what lets the degree-zero end of an iterated contraction be read on the exterior powers,
where the stalk formulas live, rather than on the terms of the complex. -/
theorem chainXIso_zero_comp_chainXZeroIsoUnit :
    (K.chainXIso 0).hom ≫ K.chainXZeroIsoUnit.hom = A.exteriorPieceZeroIsoUnit.hom := by
  simp [KoszulChainData.chainXIso, KoszulChainData.chainXZeroIsoUnit]

/-- **The stalk identification of the quotient, on the germ of the image of a section of
`O♯`.** The germ at `x` of the image of `a` under the quotient map is carried, by the
identification of the stalk of the cokernel of `φ` with the stalk of `O_X`, to the image of the
germ of `a` under the stalk of the quotient map.

The identification is the stalk of `Stacks.Sites.cokernelIsoQuotientRingOfHom` followed by the
stalk identification of a unit module. The first factor carries the projection onto the cokernel
to the quotient map (`Stacks.Sites.cokernelπ_comp_cokernelIsoQuotientRingOfHom`); the second
carries a germ to the germ (`unitModuleStalkAddEquiv_germ`); and the germ of the image of `a`
under the quotient map is the image of the germ under its stalk
(`quotientStalkHom_germ`). -/
theorem cokernelStalkLinearEquivStructureStalk_germAt_koszulQuotientπ (x : ↥X) (U : Opens ↥X)
    (hx : x ∈ U) (a : Rc.obj.obj (op U)) :
    cokernelStalkLinearEquivStructureStalk Rc φ x
        (germAt (quotient Rc (φ := φ)) U x hx
          ((koszulQuotientπ.{u, u, u} φ).val.app (op U) a)) =
      quotientStalkHom Rc (φ := φ) x (TopCat.Presheaf.germ Rc.obj U x hx a) := by
  have hsec : (Stacks.Sites.cokernelIsoQuotientRingOfHom φ).hom.val.app (op U)
        ((koszulQuotientπ.{u, u, u} φ).val.app (op U) a) =
      (quotientRingHom (quotientIdeal Rc φ)).hom.app (op U) a :=
    (SheafOfModules.comp_val_app_apply (cokernel.π φ)
        (Stacks.Sites.cokernelIsoQuotientRingOfHom φ).hom (op U) a).symm.trans
      (congrFun (congrArg (fun g => ⇑(ConcreteCategory.hom
        ((_root_.SheafOfModules.Hom.val g).app (op U))))
        (Stacks.Sites.cokernelπ_comp_cokernelIsoQuotientRingOfHom φ)) a)
  refine Eq.trans (congrArg (unitStalkBaseLinearEquiv Rc φ x)
    (Eq.trans (Stacks.SheafOfModules.modStalkEquivOfIso_germ Rc
      (Stacks.Sites.cokernelIsoQuotientRingOfHom φ) x U hx _) (congrArg _ hsec))) ?_
  refine Eq.trans (Stacks.AlgebraicGeometry.ReflexiveModules.unitModuleStalkAddEquiv_germ
    (quotientStructureSheaf Rc φ).obj x U hx _) ?_
  exact (quotientStalkHom_germ Rc (φ := φ) x U hx a).symm

/-- **The degree-zero end of the local computation, at a stalk.** The stalk of

`⋀⁰((O♯)ʳ) ≅ O♯ ⟶ O♯/𝓘`

carries an element of the stalk of `⋀⁰((O♯)ʳ)` to the image, under the stalk of the quotient map,
of the scalar that element is — the scalar being read off by
`ExteriorAlgebra.algebraMapInv`, which is the spelling
`SheafOfModules.TensorExteriorSymmetricAlgebras.listContractionDual_exteriorKoszulStalkEquiv`
produces.

Checked on germs: every element of the stalk is a germ
(`Stacks.RegularSequence.exists_germAddHom_eq`), and a degree-zero section of the exterior algebra
is a scalar multiple of the unit
(`SheafOfModules.TensorExteriorSymmetricAlgebras.exists_exterior_eq_smul_one`). On such a section
the left side reads off the scalar by
`Stacks.RegularSequence.exteriorPieceZeroIsoUnit_smul_one_apply` and the right by
`Stacks.SheafOfModules.exteriorKoszulStalkEquiv_germ_smul_exteriorBasisSection`, the empty
exterior product being the unit. -/
theorem cokernelStalkLinearEquivStructureStalk_stalkLin_exteriorPieceZeroIsoUnit (x : ↥X)
    (z : ↑(TopCat.Presheaf.stalk (A.exteriorPower 0).val.presheaf x)) :
    cokernelStalkLinearEquivStructureStalk Rc φ x
        (Stacks.RegularSequence.stalkLin
          (A.exteriorPieceZeroIsoUnit.hom ≫ koszulQuotientπ.{u, u, u} φ).val x z) =
      quotientStalkHom Rc (φ := φ) x
        (ExteriorAlgebra.algebraMapInv
          ((Stacks.SheafOfModules.exteriorKoszulStalkEquiv A 0 x z :
              ⋀[↑(TopCat.Presheaf.stalk Rc.obj x)]^0
                (Fin r → ↑(TopCat.Presheaf.stalk Rc.obj x))) :
            ExteriorAlgebra ↑(TopCat.Presheaf.stalk Rc.obj x)
              (Fin r → ↑(TopCat.Presheaf.stalk Rc.obj x)))) := by
  obtain ⟨U, hx, s, rfl⟩ := Stacks.RegularSequence.exists_germAddHom_eq (A.exteriorPower 0).val z
  obtain ⟨a, rfl⟩ := A.exists_exterior_eq_smul_one (op U) s
  have hr : ExteriorAlgebra.algebraMapInv
      ((Stacks.SheafOfModules.exteriorKoszulStalkEquiv A 0 x
          (Stacks.SheafOfModules.germAddHom (A.exteriorPower 0).val U hx
            (a • A.exterior.one.eval (op U))) :
          ⋀[↑(TopCat.Presheaf.stalk Rc.obj x)]^0
            (Fin r → ↑(TopCat.Presheaf.stalk Rc.obj x))) :
        ExteriorAlgebra ↑(TopCat.Presheaf.stalk Rc.obj x)
          (Fin r → ↑(TopCat.Presheaf.stalk Rc.obj x))) =
      TopCat.Presheaf.germ Rc.obj U x hx a := by
    refine Eq.trans (congrArg (fun w : ⋀[↑(TopCat.Presheaf.stalk Rc.obj x)]^0
        (Fin r → ↑(TopCat.Presheaf.stalk Rc.obj x)) =>
        ExteriorAlgebra.algebraMapInv
          (w : ExteriorAlgebra ↑(TopCat.Presheaf.stalk Rc.obj x)
            (Fin r → ↑(TopCat.Presheaf.stalk Rc.obj x))))
      (Stacks.SheafOfModules.exteriorKoszulStalkEquiv_germ_smul_exteriorBasisSection
        A 0 U hx a Fin.elim0)) ?_
    simp [Algebra.smul_def]
  refine Eq.trans (congrArg (cokernelStalkLinearEquivStructureStalk Rc φ x)
    (Stacks.RegularSequence.stalkLin_germAddHom
      (A.exteriorPieceZeroIsoUnit.hom ≫ koszulQuotientπ.{u, u, u} φ).val U hx _)) ?_
  refine Eq.trans (congrArg (fun w => cokernelStalkLinearEquivStructureStalk Rc φ x
    (Stacks.SheafOfModules.germAddHom (quotient Rc (φ := φ)).val U hx w))
    ((SheafOfModules.comp_val_app_apply A.exteriorPieceZeroIsoUnit.hom
      (koszulQuotientπ.{u, u, u} φ) (op U) (a • A.exterior.one.eval (op U))).trans
      (congrArg (fun t => (koszulQuotientπ.{u, u, u} φ).val.app (op U) t)
        (exteriorPieceZeroIsoUnit_smul_one_apply A (op U) a)))) ?_
  refine Eq.trans (cokernelStalkLinearEquivStructureStalk_germAt_koszulQuotientπ Rc x U hx a) ?_
  exact congrArg (quotientStalkHom Rc (φ := φ) x) hr.symm

omit [HasWeakSheafify (Opens.grothendieckTopology ↥X) CommRingCat.{u}] in
/-- **The whole degree-`i` composite, read on the exterior powers.** The composite

`⋀ⁱ((O♯)ʳ) ≅ K_i ⟶ K_0 ≅ O♯ ⟶ O♯/𝓘`

that the normalised germ formula produces is the `i`-fold coordinate contraction on the exterior
powers, followed by the degree-zero identification of the exterior algebra and the quotient map.
The two transports of `chainXIso` cancel, by `tupleCoordKoszulD_eq` at the source end and by
`chainXIso_zero_comp_chainXZeroIsoUnit` at the target end.

Nothing of the Koszul complex is left: both factors are data of the exterior algebra, which is
where the stalk formulas for iterated contraction live. -/
theorem chainXIso_comp_tupleCoordKoszulD_comp_quotientπ (i : ℕ) (g : Fin i → ULift.{u} (Fin r)) :
    (K.chainXIso ((i : ℕ) : ℤ)).hom ≫ K.tupleCoordKoszulD i g ≫ K.chainXZeroIsoUnit.hom ≫
        koszulQuotientπ.{u, u, u} φ =
      A.tupleCoordKoszulD i g ≫
        A.exteriorPieceZeroIsoUnit.hom ≫ koszulQuotientπ.{u, u, u} φ := by
  rw [K.tupleCoordKoszulD_eq i g, ← chainXIso_zero_comp_chainXZeroIsoUnit Rc K]
  simp only [Category.assoc, Iso.hom_inv_id_assoc]
  rfl

omit [HasWeakSheafify (Opens.grothendieckTopology ↥X) CommRingCat.{u}] in
/-- **The empty iterate is a single contraction.** The one-fold composite of contractions is the
contraction itself, so the two classes are the classes of two cycles with the same image inside
the complex, and the inclusion of cycles is a monomorphism.

This is the base case the degree-one identification needs: the stalk formula for the
iterated-contraction class is stated for an iterate of length `i + 1`, and at `i = 0` it must be
the formula for a single contraction class. -/
theorem iteratedContractionClassOn_zero (f : Fin 1 → ULift.{u} (Fin r)) (U : (Opens ↥X)ᵒᵖ) :
    iteratedContractionClassOn Rc K 0 f U = contractionClassOn Rc K (f 0) U :=
  congrArg
    (fun z => ((endComplex Rc (cochain Rc K)).homologyπ ((0 + 1 : ℕ) : ℤ)).val.app U z)
    (injective_app_of_mono
      ((endComplex Rc (cochain Rc K)).iCycles ((0 + 1 : ℕ) : ℤ)) U
      ((iCycles_iteratedContractionCycle Rc K 0 f U).trans
        (iCycles_contractionCycle Rc K (f 0) U).symm))


section QuasiIso

variable [QuasiIso K.augmentation]

omit [HasWeakSheafify (Opens.grothendieckTopology ↥X) CommRingCat.{u}] in
/-- **The stalk identification on the germ of the iterated-contraction class, in normalised
form.** The germ at `x` of the class of the `i`-fold iterated contraction is carried to the
`O_x`-linear map whose value on the basis wedge indexed by `v` is the germ of the image of the
corresponding basis section of the exterior power under the composite

`⋀ⁱ((O♯)ʳ) ≅ K_i ⟶ K_0 ≅ O♯ ⟶ O♯/𝓘`

whose middle map is the `i`-fold coordinate contraction between the nonnegative degrees of the
Koszul complex.

This is `homologyPieceStalkEquiv_germ_iteratedContractionClassOn` with its three transports of
section types moved to the sheaf level by `Stacks.SheafOfModules.eqToHom_over_val_app` and
`Stacks.SheafOfModules.over_val_app_id`, and then collapsed by
`eqToHom_comp_tupleCoordKoszulDOf_comp_augSingle`. No degree of the form `i - i` or `-(-i)`
remains. -/
theorem homologyPieceStalkEquiv_germ_iteratedContraction (m : ℕ)
    (j : Fin (m + 1) → ULift.{u} (Fin r)) (x : ↥X) (U : Opens ↥X) (hx : x ∈ U)
    (v : Fin (m + 1) → Fin r) :
    homologyPieceStalkEquiv Rc K (m + 1) x
        (germAt ((homologyGradedAlgebra Rc (cochain Rc K)).piece (((m + 1 : ℕ) : ℕ) : ℤ)) U x hx
          (iteratedContractionClassOn Rc K m j (op U)))
        (exteriorPower.ιMulti ↑(TopCat.Presheaf.stalk Rc.obj x) (m + 1)
          fun k => Pi.single (v k) 1) =
      germAt (quotient Rc (φ := φ)) U x hx
        (((K.chainXIso (((m + 1 : ℕ) : ℕ) : ℤ)).hom ≫
            K.tupleCoordKoszulD (m + 1) (fun k => j k.rev) ≫ K.chainXZeroIsoUnit.hom ≫
            koszulQuotientπ.{u, u, u} φ).val.app (op U)
          (exteriorBasisSection A U (m + 1) v)) := by
  have hT : ((single (StructureSheafModules Rc) (ComplexShape.up ℤ) 0).obj
      (quotient Rc (φ := φ))).X (((m + 1 : ℕ) : ℤ) - ((m + 1 : ℕ) : ℤ))
        = quotient Rc (φ := φ) := by rw [sub_self]; rfl
  have h1 : K.chain.X (((m + 1 : ℕ) : ℕ) : ℤ) = K.chain.X (-(-((m + 1 : ℕ) : ℤ))) :=
    (congrArg K.chain.X (neg_neg ((m + 1 : ℕ) : ℤ))).symm
  have h2 : A.exterior.piece (((m + 1 : ℕ) : ℕ) : ℤ) = K.chain.X (((m + 1 : ℕ) : ℕ) : ℤ) :=
    (K.chain_X (((m + 1 : ℕ) : ℕ) : ℤ)).symm
  have hdeg : -(((m + 1 : ℕ) : ℤ) - ((m + 1 : ℕ) : ℤ)) + (((m + 1 : ℕ) : ℕ) : ℤ)
      = -(-((m + 1 : ℕ) : ℤ)) := by push_cast; ring
  have b : ∀ {M N : StructureSheafModules Rc} (h : M = N)
      (z : (M.over U).val.obj (op (Over.mk (𝟙 U)))),
      eqToHom (congrArg (fun Z : StructureSheafModules Rc =>
          (Z.over U).val.obj (op (Over.mk (𝟙 U)))) h) z = (eqToHom h).val.app (op U) z :=
    fun h z =>
      (Stacks.SheafOfModules.eqToHom_over_val_app Rc h U (op (Over.mk (𝟙 U))) z).symm.trans
        (Stacks.SheafOfModules.over_val_app_id Rc (eqToHom h) U z)
  refine Eq.trans (homologyPieceStalkEquiv_germ_iteratedContractionClassOn Rc K m j x U hx v) ?_
  refine congrArg (germAt (quotient Rc (φ := φ)) U x hx) ?_
  refine Eq.trans (b hT _) ?_
