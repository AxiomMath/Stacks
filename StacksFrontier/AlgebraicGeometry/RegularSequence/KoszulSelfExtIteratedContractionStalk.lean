theorem isIso_extComparison_of_pos {i : ℤ} (hi : 0 < i) : IsIso (extComparison Rc K i) := by
  obtain ⟨n, rfl⟩ := Int.eq_ofNat_of_zero_le hi.le
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  refine (AlgebraicGeometry.SheafOfModules.isIso_iff_bijective_stalkMap
    (extComparison Rc K (((m + 1 : ℕ) : ℕ) : ℤ))).2 (fun x => ?_)
  exact Eq.mp (congrArg Function.Bijective (funext
    (SheafOfModules.stalkMap_hom_eq_stalkMapL x (extComparison Rc K (((m + 1 : ℕ) : ℕ) : ℤ))))).symm
