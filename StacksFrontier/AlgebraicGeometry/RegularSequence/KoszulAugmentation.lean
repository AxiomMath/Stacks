/-!
# The augmentation of a Koszul complex of sheaves of modules

Let `O♯` be a sheaf of commutative rings on a site `(C, J)`, let `F` be a sheaf of `O♯`-modules
and let `φ : F ⟶ O♯` be a morphism of sheaves of modules.  The image of `φ` is an ideal sheaf
`I ⊆ O♯`, and the Koszul complex of `φ`

`⋯ ⟶ ⋀²F ⟶ ⋀¹F ⟶ ⋀⁰F ⟶ 0 ⟶ ⋯`

packaged as `Stacks.RegularSequence.KoszulChainData` sits in nonnegative degrees with `⋀⁰F = O♯`
and with degree-one differential `φ`.  Its degree-zero homology is therefore the quotient
`O♯/I`, with no hypothesis on `φ` whatever, and the complex comes with a canonical augmentation
to the complex concentrated in degree zero on that quotient.  Exactness of the Koszul complex in
positive degrees — Koszul-regularity of `φ` — is exactly the extra condition making the
augmentation a quasi-isomorphism, that is, making the Koszul complex a resolution of `O♯/I`.

## Main definitions

* `Stacks.RegularSequence.koszulQuotient`: the quotient `O♯/I` of the structure sheaf by the
  ideal sheaf generated by `φ`, namely the cokernel of `φ`.
* `Stacks.RegularSequence.KoszulChainData.augmentationZero`: the degree-zero component
  `⋀⁰F = O♯ ⟶ O♯/I` of the augmentation, the quotient map.
* `Stacks.RegularSequence.KoszulChainData.augmentation`: **the augmentation** of the Koszul
  complex, a morphism of chain complexes to `(O♯/I)[0]`.
* `Stacks.RegularSequence.KoszulChainData.homologyZeroIso`: **`H₀` of the Koszul complex is
  `O♯/I`**, unconditionally.

## Main results

* `Stacks.RegularSequence.KoszulChainData.exteriorGenerator_comp_d_one`: through the degree-zero
  identification `⋀⁰F ≅ O♯` and the degree-one identification `F ≅ ⋀¹F`, the first Koszul
  differential is `φ`.  This is what makes the augmentation a chain map and what computes `H₀`.
* `Stacks.RegularSequence.KoszulChainData.d_comp_augmentationZero`: the augmentation kills the
  image of the first differential, i.e. it is a morphism of chain complexes.
* `Stacks.RegularSequence.KoszulChainData.quasiIsoAt_augmentation_zero`: the augmentation is a
  quasi-isomorphism in degree zero, again with no hypothesis.
* `Stacks.RegularSequence.KoszulChainData.quasiIso_augmentation`: **the Koszul complex of a
  sequence whose Koszul complex is acyclic in nonzero degrees is a resolution of `O♯/I`.**

All four are stated for an arbitrary term of `Stacks.RegularSequence.KoszulChainData`, and are
instantiated at the Koszul complex of a morphism `(O♯)ʳ ⟶ O♯` on a topological space, built on
the constructed bundle of algebras `Stacks.RegularSequence.koszulAlgebras`, as
`Stacks.RegularSequence.koszulAugmentation`, `Stacks.RegularSequence.koszulHomologyZeroIso` and
`Stacks.RegularSequence.quasiIso_koszulAugmentation`.

## Implementation notes

The quotient is taken to be the cokernel of `φ` rather than the cokernel of the inclusion of a
separately given ideal sheaf.  The two agree whenever the ideal sheaf is the image of `φ`, since
a morphism and the inclusion of its image have the same cokernel; taking the cokernel of `φ`
avoids having to name the image, and it is what the universal property used below is about.

The complex is `ℤ`-indexed and vanishes in negative degrees, so degree zero is neither the end of
the complex nor an interior degree in the sense the `ℕ`-indexed API expects: `H₀` is computed as
the opcycles in degree zero, which is legitimate because the differential *out* of degree zero
lands in `⋀^{-1}F = 0`, and the opcycles in degree zero are the cokernel of the differential
coming in from degree one.  Both steps are the general `HomologicalComplex` lemmas
`HomologicalComplex.isoHomologyι` and `HomologicalComplex.opcyclesIsCokernel`, instantiated at
`ComplexShape.down ℤ`.

The identity `d₁ = φ` is proved as an equality of morphisms of sheaves of modules, checked on
local sections: the Koszul data gives the value of `d₁` only on the image of the degree-one
generator `F ⟶ ⋀¹F`, which suffices precisely because that generator is an isomorphism.

## References

* [Stacks Project, Tag 0622](https://stacks.math.columbia.edu/tag/0622)
* [Stacks Project, Tag 062K](https://stacks.math.columbia.edu/tag/062K)
* [Stacks Project, Tag 063C](https://stacks.math.columbia.edu/tag/063C)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Sheaf Opposite

universe v u w

namespace Stacks.RegularSequence

variable {C : Type u} [Category.{v} C] {J : GrothendieckTopology C}
  [J.HasSheafCompose (forget₂ CommRingCat.{w} RingCat.{w})]
  {Osharp : Sheaf J CommRingCat.{w}}
  [J.WEqualsLocallyBijective AddCommGrpCat.{w}] [HasSheafify J AddCommGrpCat.{w}]
  {F : SheafOfModules.{w} (toRingCat J Osharp)}
  {A : SheafOfModules.TensorExteriorSymmetricAlgebras J F}

/-! ### The quotient of the structure sheaf by the ideal generated by `φ` -/

section Quotient

variable (φ : F ⟶ SheafOfModules.unit (toRingCat J Osharp))

/-- **The quotient `O♯/I`** of the structure sheaf by the ideal sheaf `I` generated by `φ`, that
is, the cokernel of `φ`.  A morphism of sheaves of modules and the inclusion of its image have
the same cokernel, so this is the quotient by the image of `φ`. -/
noncomputable abbrev koszulQuotient : SheafOfModules.{w} (toRingCat J Osharp) :=
  cokernel φ

/-- **The quotient map `O♯ ⟶ O♯/I`.** -/
noncomputable abbrev koszulQuotientπ :
    SheafOfModules.unit (toRingCat J Osharp) ⟶ koszulQuotient φ :=
  cokernel.π φ

/-- The composite of `φ` with the quotient map `O♯ ⟶ O♯/I` is zero. -/
@[reassoc (attr := simp)]
theorem comp_koszulQuotientπ : φ ≫ koszulQuotientπ φ = 0 :=
  cokernel.condition φ

end Quotient

/-! ### The first Koszul differential is `φ` -/

section DegreeOne

variable (A)

/-- A degree-zero exterior section with a prescribed scalar is sent to that scalar by the
degree-zero identification `⋀⁰F ≅ O♯`. -/
theorem exteriorPieceZeroIsoUnit_smul_one_apply (U : Cᵒᵖ)
    (r : (toRingCat J Osharp).obj.obj U) :
    A.exteriorPieceZeroIsoUnit.hom.val.app U (r • A.exterior.one.eval U) = r := by
  have hr : A.exteriorPieceZeroIsoUnit.hom.val.app U
      (A.exteriorPieceZeroIsoUnit.inv.val.app U r) = r :=
    iso_hom_val_app_inv_val_app A.exteriorPieceZeroIsoUnit U r
  rw [A.exteriorPieceZeroIsoUnit_smul_one U _ r hr]
  exact hr

end DegreeOne

namespace KoszulChainData

variable {φ : F ⟶ SheafOfModules.unit (toRingCat J Osharp)} (K : KoszulChainData A φ)

/-- **The first Koszul differential, read on the degree-one generator, is `φ`.** The Koszul data
prescribes `d₁` on the image of the generator `F ⟶ ⋀¹F`; composed with the degree-zero
identification `⋀⁰F ≅ O♯` it is exactly the given morphism `φ`. -/
theorem exteriorGenerator_comp_d_one :
    A.exteriorGenerator ≫ K.d 1 ≫ A.exteriorPieceZeroIsoUnit.hom = φ := by
  refine SheafOfModules.hom_ext (PresheafOfModules.hom_ext fun U =>
    ModuleCat.hom_ext (LinearMap.ext fun e => ?_))
  show A.exteriorPieceZeroIsoUnit.hom.val.app U
      ((K.d 1).val.app U (A.exteriorGenerator.val.app U e)) = φ.val.app U e
  rw [K.d_exteriorGenerator U e, exteriorPieceZeroIsoUnit_smul_one_apply]
  rfl

/-- **The first Koszul differential is `φ`**, through the identifications `F ≅ ⋀¹F` and
`⋀⁰F ≅ O♯`.  Since the degree-one generator is an isomorphism, this is the previous statement
with the generator moved to the other side. -/
@[reassoc]
theorem d_one_comp_exteriorPieceZeroIsoUnit :
    K.d 1 ≫ A.exteriorPieceZeroIsoUnit.hom = A.exteriorGeneratorIso.inv ≫ φ := by
  refine Eq.symm (A.exteriorGeneratorIso.inv_comp_eq.2 ?_)
  rw [A.exteriorGeneratorIso_hom]
  exact K.exteriorGenerator_comp_d_one.symm

/-! ### The augmentation -/

/-- **The degree-zero term of the Koszul complex is the structure sheaf.** -/
noncomputable def chainXZeroIsoUnit :
    K.chain.X 0 ≅ SheafOfModules.unit (toRingCat J Osharp) :=
  eqToIso (K.chain_X 0) ≪≫ A.exteriorPieceZeroIsoUnit

/-- **The degree-one term of the Koszul complex is `F`.** -/
noncomputable def chainXOneIso : K.chain.X 1 ≅ F :=
  eqToIso (K.chain_X 1) ≪≫ A.exteriorGeneratorIso.symm

/-- The differential from degree one to degree zero, in terms of the Koszul differential on the
exterior powers. -/
theorem chain_d_one_zero :
    K.chain.d 1 0 = eqToHom (K.chain_X 1) ≫ K.d 1 ≫ eqToHom (K.chain_X 0).symm := by
  have h : eqToHom (K.chain_X 1).symm ≫ K.chain.d 1 0 ≫ eqToHom (K.chain_X 0) = K.d 1 :=
    K.chain_d 1
  rw [← h]
  simp

/-- **The first differential of the Koszul complex is `φ`**, read through the identifications of
the degree-one and degree-zero terms. -/
theorem chain_d_one_zero_comp_chainXZeroIsoUnit :
    K.chain.d 1 0 ≫ K.chainXZeroIsoUnit.hom = K.chainXOneIso.hom ≫ φ := by
  rw [chain_d_one_zero, chainXZeroIsoUnit, chainXOneIso]
  simp [K.d_one_comp_exteriorPieceZeroIsoUnit]

/-- **The degree-zero component of the augmentation**: the quotient map `⋀⁰F = O♯ ⟶ O♯/I`. -/
noncomputable def augmentationZero : K.chain.X 0 ⟶ koszulQuotient φ :=
  K.chainXZeroIsoUnit.hom ≫ koszulQuotientπ φ

/-- **The augmentation is a chain map**: it kills the image of the differential coming in from
degree one, because that differential is `φ` and the quotient is by the image of `φ`. -/
theorem d_comp_augmentationZero (i : ℤ) (hi : (ComplexShape.down ℤ).Rel i 0) :
    K.chain.d i 0 ≫ K.augmentationZero = 0 := by
  have hi' : (0 : ℤ) + 1 = i := hi
  obtain rfl : i = 1 := by omega
  rw [augmentationZero, ← Category.assoc, chain_d_one_zero_comp_chainXZeroIsoUnit,
    Category.assoc, comp_koszulQuotientπ, comp_zero]

/-- **The augmentation of the Koszul complex**, a morphism of chain complexes from the Koszul
complex of `φ` to the complex concentrated in degree zero on the quotient `O♯/I`.  It is the
quotient map `⋀⁰F = O♯ ↠ O♯/I` in degree zero and zero in every other degree. -/
noncomputable def augmentation :
    K.chain ⟶ (HomologicalComplex.single (SheafOfModules.{w} (toRingCat J Osharp))
      (ComplexShape.down ℤ) 0).obj (koszulQuotient φ) :=
  HomologicalComplex.mkHomToSingle K.augmentationZero K.d_comp_augmentationZero

/-- The degree-zero component of the augmentation is the quotient map. -/
theorem augmentation_f_zero :
    K.augmentation.f 0 = K.augmentationZero ≫
      (HomologicalComplex.singleObjXSelf (ComplexShape.down ℤ) 0 (koszulQuotient φ)).inv :=
  HomologicalComplex.mkHomToSingle_f _ _

/-! ### The degree-zero homology -/

section Homology

/-- In the `ℤ`-indexed homological grading, degree `-1` follows degree `0`. -/
theorem down_next_zero : (ComplexShape.down ℤ).next 0 = -1 :=
  (ComplexShape.down ℤ).next_eq' (show (-1 : ℤ) + 1 = 0 by ring)

/-- In the `ℤ`-indexed homological grading, degree `1` precedes degree `0`. -/
theorem down_prev_zero : (ComplexShape.down ℤ).prev 0 = 1 :=
  (ComplexShape.down ℤ).prev_eq' (show (0 : ℤ) + 1 = 1 by ring)

/-- The Koszul complex has no differential out of degree zero, since it vanishes in degree
`-1`. -/
theorem chain_d_zero_neg_one : K.chain.d 0 (-1) = 0 :=
  (K.isZero_chain_X_of_neg (show (-1 : ℤ) < 0 by norm_num)).eq_zero_of_tgt _

/-- **The degree-zero homology of the Koszul complex is its degree-zero opcycles**, because the
complex vanishes in degree `-1`. -/
noncomputable def isoHomologyιZero : K.chain.homology 0 ≅ K.chain.opcycles 0 :=
  K.chain.isoHomologyι 0 (-1) down_next_zero K.chain_d_zero_neg_one

/-- The forward map of `isoHomologyιZero` is the canonical map from the degree-zero homology to
the degree-zero opcycles. -/
@[simp]
theorem isoHomologyιZero_hom : K.isoHomologyιZero.hom = K.chain.homologyι 0 := rfl

/-- **The degree-zero opcycles of the Koszul complex are the cokernel of the first
differential.** -/
noncomputable def opcyclesZeroIsoCokernel :
    K.chain.opcycles 0 ≅ cokernel (K.chain.d 1 0) where
  hom := K.chain.descOpcycles (cokernel.π (K.chain.d 1 0)) 1 down_prev_zero
    (cokernel.condition (K.chain.d 1 0))
  inv := cokernel.desc (K.chain.d 1 0) (K.chain.pOpcycles 0) (K.chain.d_pOpcycles 1 0)
  hom_inv_id := by
    rw [← cancel_epi (K.chain.pOpcycles 0)]
    simp
  inv_hom_id := by
    rw [← cancel_epi (cokernel.π (K.chain.d 1 0))]
    simp

/-- The projection onto the degree-zero opcycles followed by `opcyclesZeroIsoCokernel` is the
cokernel projection of the first differential. -/
@[reassoc]
theorem pOpcycles_opcyclesZeroIsoCokernel_hom :
    K.chain.pOpcycles 0 ≫ K.opcyclesZeroIsoCokernel.hom = cokernel.π (K.chain.d 1 0) :=
  K.chain.p_descOpcycles (cokernel.π (K.chain.d 1 0)) 1 down_prev_zero
    (cokernel.condition (K.chain.d 1 0))

/-- **`H₀` of the Koszul complex of `φ` is the quotient `O♯/I`**, with no hypothesis on `φ`.
The complex vanishes in degree `-1`, so `H₀` is the cokernel of the first differential, and that
differential is `φ` up to the identifications of the degree-one and degree-zero terms. -/
noncomputable def homologyZeroIso : K.chain.homology 0 ≅ koszulQuotient φ :=
  K.isoHomologyιZero ≪≫ K.opcyclesZeroIsoCokernel ≪≫
    cokernel.mapIso (K.chain.d 1 0) φ K.chainXOneIso K.chainXZeroIsoUnit
      K.chain_d_one_zero_comp_chainXZeroIsoUnit

/-- The identification of `H₀` with the quotient is compatible with the augmentation: composed
with the projection onto the opcycles it is the degree-zero component of the augmentation. -/
theorem pOpcycles_homologyZeroIso :
    K.chain.pOpcycles 0 ≫ K.isoHomologyιZero.inv ≫ K.homologyZeroIso.hom =
      K.augmentationZero := by
  rw [homologyZeroIso]
  simp only [Iso.trans_hom, Iso.inv_hom_id_assoc]
  rw [← Category.assoc, pOpcycles_opcyclesZeroIsoCokernel_hom]
  simp [cokernel.map, augmentationZero]

end Homology

/-! ### The augmentation is a quasi-isomorphism -/

section QuasiIso

/-- For the complex concentrated in degree zero, the identification of its homology with its
single term factors through the opcycles. -/
private theorem singleObj_pOpcycles_fac (Q : SheafOfModules.{w} (toRingCat J Osharp))
    (hLd : ((HomologicalComplex.single (SheafOfModules.{w} (toRingCat J Osharp))
      (ComplexShape.down ℤ) 0).obj Q).d 0 (-1) = 0) :
    ((HomologicalComplex.single (SheafOfModules.{w} (toRingCat J Osharp))
          (ComplexShape.down ℤ) 0).obj Q).pOpcycles 0 ≫
        (((HomologicalComplex.single (SheafOfModules.{w} (toRingCat J Osharp))
            (ComplexShape.down ℤ) 0).obj Q).isoHomologyι 0 (-1) down_next_zero hLd).inv ≫
          (HomologicalComplex.singleObjHomologySelfIso (ComplexShape.down ℤ) 0 Q).hom =
      (HomologicalComplex.singleObjXSelf (ComplexShape.down ℤ) 0 Q).hom := by
  have h1 : (((HomologicalComplex.single (SheafOfModules.{w} (toRingCat J Osharp))
          (ComplexShape.down ℤ) 0).obj Q).isoHomologyι 0 (-1) down_next_zero hLd).inv ≫
        (HomologicalComplex.singleObjHomologySelfIso (ComplexShape.down ℤ) 0 Q).hom =
      (HomologicalComplex.singleObjOpcyclesSelfIso (ComplexShape.down ℤ) 0 Q).inv := by
    rw [Iso.inv_comp_eq, HomologicalComplex.isoHomologyι_hom,
      HomologicalComplex.homologyι_singleObjOpcyclesSelfIso_inv]
  rw [h1, ← cancel_mono (HomologicalComplex.singleObjOpcyclesSelfIso
    (ComplexShape.down ℤ) 0 Q).hom]
  simp [HomologicalComplex.singleObjOpcyclesSelfIso_hom]

/-- **The augmentation is a quasi-isomorphism in degree zero**, with no hypothesis on `φ`: the
map it induces on `H₀` is the identification of `H₀` of the Koszul complex with `O♯/I`. -/
@[sga "3 III 4.6.1" "more general"]
theorem quasiIsoAt_augmentation_zero : QuasiIsoAt K.augmentation 0 := by
  rw [quasiIsoAt_iff_isIso_homologyMap]
  have hLd : ((HomologicalComplex.single (SheafOfModules.{w} (toRingCat J Osharp))
      (ComplexShape.down ℤ) 0).obj (koszulQuotient φ)).d 0 (-1) = 0 := by simp
  have hmap : HomologicalComplex.homologyMap K.augmentation 0 ≫
      (HomologicalComplex.singleObjHomologySelfIso (ComplexShape.down ℤ) 0
        (koszulQuotient φ)).hom = K.homologyZeroIso.hom := by
    rw [← cancel_epi K.isoHomologyιZero.inv, ← cancel_epi (K.chain.pOpcycles 0),
      K.pOpcycles_homologyZeroIso]
    have hnat : K.isoHomologyιZero.inv ≫ HomologicalComplex.homologyMap K.augmentation 0 =
        HomologicalComplex.opcyclesMap K.augmentation 0 ≫
          (((HomologicalComplex.single (SheafOfModules.{w} (toRingCat J Osharp))
            (ComplexShape.down ℤ) 0).obj (koszulQuotient φ)).isoHomologyι 0 (-1)
              down_next_zero hLd).inv := by
      rw [← cancel_mono (((HomologicalComplex.single
        (SheafOfModules.{w} (toRingCat J Osharp)) (ComplexShape.down ℤ) 0).obj
          (koszulQuotient φ)).isoHomologyι 0 (-1) down_next_zero hLd).hom,
        Category.assoc, Category.assoc, Iso.inv_hom_id, Category.comp_id,
        ← cancel_epi K.isoHomologyιZero.hom, Iso.hom_inv_id_assoc]
      exact HomologicalComplex.homologyι_naturality K.augmentation 0
    rw [← Category.assoc K.isoHomologyιZero.inv, hnat, Category.assoc,
      ← Category.assoc (K.chain.pOpcycles 0), HomologicalComplex.p_opcyclesMap,
      Category.assoc, singleObj_pOpcycles_fac (koszulQuotient φ) hLd,
      augmentation_f_zero, Category.assoc, Iso.inv_hom_id, Category.comp_id]
  have hiso : IsIso (HomologicalComplex.homologyMap K.augmentation 0 ≫
      (HomologicalComplex.singleObjHomologySelfIso (ComplexShape.down ℤ) 0
        (koszulQuotient φ)).hom) := by
    rw [hmap]; infer_instance
  exact IsIso.of_isIso_comp_right (HomologicalComplex.homologyMap K.augmentation 0)
    (HomologicalComplex.singleObjHomologySelfIso (ComplexShape.down ℤ) 0
      (koszulQuotient φ)).hom

/-- **The Koszul complex of `φ` is a resolution of `O♯/I` when it is acyclic in nonzero
degrees.** This is the sheaf-level form of Koszul-regularity: the positive-degree exactness
supplied by the hypothesis together with the unconditional computation of `H₀` says exactly that
the augmentation is a quasi-isomorphism. -/
@[sga "3 III 4.6.1" "(f)"]
theorem quasiIso_augmentation (h : ∀ n : ℤ, n ≠ 0 → IsZero (K.chain.homology n)) :
    QuasiIso K.augmentation := by
  rw [quasiIso_iff]
  intro n
  by_cases hn : n = 0
  · subst hn
    exact K.quasiIsoAt_augmentation_zero
  · rw [quasiIsoAt_iff_isIso_homologyMap]
    have hz : IsZero (((HomologicalComplex.single (SheafOfModules.{w} (toRingCat J Osharp))
        (ComplexShape.down ℤ) 0).obj (koszulQuotient φ)).homology n) :=
      HomologicalComplex.isZero_single_obj_homology (ComplexShape.down ℤ) 0
        (koszulQuotient φ) n hn
    exact ⟨0, (h n hn).eq_of_src _ _, hz.eq_of_src _ _⟩

end QuasiIso

end KoszulChainData

/-! ### The Koszul complex of a sequence of global sections on a space -/

section Algebras

variable {X : TopCat.{u}} {Osharp : Sheaf (Opens.grothendieckTopology ↥X) CommRingCat.{u}} {r : ℕ}
  (φ : koszulFreeSheaf Osharp r ⟶
    SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Osharp))

/-- **The augmentation of the Koszul complex of `φ`** on the constructed bundle of algebras:
the quotient map `⋀⁰((O♯)ʳ) = O♯ ↠ O♯/I` in degree zero and zero elsewhere, where `I` is the
ideal sheaf generated by `φ`. -/
noncomputable def koszulAugmentation :
    (koszulChainData φ).chain ⟶
      (HomologicalComplex.single
        (SheafOfModules.{u} (toRingCat (Opens.grothendieckTopology ↥X) Osharp))
        (ComplexShape.down ℤ) 0).obj (koszulQuotient φ) :=
  (koszulChainData φ).augmentation

/-- **`H₀` of the Koszul complex of `φ` is `O♯/I`**, with no hypothesis on `φ`. -/
noncomputable def koszulHomologyZeroIso :
    (koszulChainData φ).chain.homology 0 ≅ koszulQuotient φ :=
  (koszulChainData φ).homologyZeroIso

/-- **The Koszul complex of `φ` is a resolution of `O♯/I` when it is acyclic in nonzero
degrees.** -/
theorem quasiIso_koszulAugmentation
    (h : ∀ n : ℤ, n ≠ 0 → IsZero ((koszulChainData φ).chain.homology n)) :
    QuasiIso (koszulAugmentation φ) :=
  (koszulChainData φ).quasiIso_augmentation h

end Algebras

end Stacks.RegularSequence

end
