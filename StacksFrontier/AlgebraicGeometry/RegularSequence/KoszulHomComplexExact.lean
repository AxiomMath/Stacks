module

public import StacksFrontier.AlgebraicGeometry.RegularSequence.KoszulAcyclicity
public import StacksFrontier.AlgebraicGeometry.RegularSequence.KoszulHomComplexStalk
public import StacksFrontier.AlgebraicGeometry.RegularSequence.KoszulQuotientStalk
public import StacksFrontier.AlgebraicGeometry.Reflexive.ExtensionChain.StalkCriterion
public import StacksFrontier.RingTheory.Koszul.SelfDuality
public import StacksFrontier.Topology.Sheaves.Modules.StalkAcyclic

/-!
# The internal Hom complex out of a Koszul resolution into the structure sheaf

Let `O♯` be a sheaf of commutative rings on a space and `K` the Koszul complex of global
sections `f₁, …, f_r` resolving `O♯/I`. The internal Hom complex `𝓗om^•(K, O♯[0])` is exact in
every degree `n < r`, and in degree `r` the quotient map `O♯ ⟶ O♯/I` induces an isomorphism
`Hʳ(𝓗om^•(K, O♯[0])) ≅ Hʳ(𝓗om^•(K, (O♯/I)[0]))`.

## Main results

* `Stacks.RegularSequence.KoszulChainData.isKoszulRegular_germ`: the germs are Koszul-regular.
* `Stacks.RegularSequence.KoszulChainData.exactAt_homComplex_unit`: exactness below `r`.
* `Stacks.RegularSequence.stalkGermIdeal_eq_span`: the ideal of germs is generated by the germs
  of the sequence.
* `Stacks.RegularSequence.KoszulChainData.quasiIsoAt_homComplexQuotientMap`: the top degree.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Sheaf Opposite TopologicalSpace
open AlgebraicGeometry HomologicalComplex Stacks.ChainComplex

universe u

attribute [local implicit_reducible] CategoryTheory.sheafCompose
  Stacks.SheafOfModules.Tensor.ringSheaf

namespace Stacks.RegularSequence.KoszulChainData

open Stacks.SheafOfModules Stacks.SheafOfModules.SheafHomStalk
  Stacks.AlgebraicGeometry.ReflexiveModules

attribute [local instance] HasDerivedCategory.standard

variable {X : TopCat.{u}} (Rc : TopCat.Sheaf CommRingCat.{u} X)
  [HasSheafify (Opens.grothendieckTopology X) AddCommGrpCat.{u}]
  [(Opens.grothendieckTopology X).WEqualsLocallyBijective AddCommGrpCat.{u}]
  {r : ℕ}
  {A : SheafOfModules.TensorExteriorSymmetricAlgebras (Opens.grothendieckTopology ↥X)
    (koszulFreeSheaf Rc r)}
  {φ : koszulFreeSheaf Rc r ⟶
    SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Rc)}
  (K : KoszulChainData.{u, u, u} A φ)
  (f : Fin r → ↑(Rc.obj.obj (op (⊤ : Opens ↥X))))
  (hφ : ∀ k : Fin r,
    ((SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Rc)).freeHomEquiv φ
      (ULift.up k)).val (op (⊤ : Opens ↥X)) = f k)

include hφ in
/-- The germs of a sequence whose Koszul complex resolves the quotient are Koszul-regular. -/
theorem isKoszulRegular_germ [QuasiIso K.augmentation] (x : X) :
    Koszul.IsKoszulRegular fun k =>
      TopCat.Presheaf.germ Rc.obj (⊤ : Opens ↥X) x (Opens.mem_top x) (f k) := by
  intro i hi
  obtain ⟨n, rfl⟩ : ∃ n, i = n + 1 := ⟨i - 1, by omega⟩
  have hex : K.chain.ExactAt ((n + 1 : ℕ) : ℤ) := by
    rw [HomologicalComplex.exactAt_iff_isZero_homology]
    exact (HomologicalComplex.isZero_single_obj_homology _ _ _ _ (by omega)).of_iso
      (asIso (HomologicalComplex.homologyMap K.augmentation ((n + 1 : ℕ) : ℤ)))
  exact ((HomologicalComplex.exactAt_iff_isZero_homology _ _).mp
    ((exactAt_chain_natCast_iff K f hφ (n + 1)).mp hex x))

/-- The structure sheaf as a module over itself. -/
abbrev unitMod : StructureSheafModules Rc :=
  SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Rc)

/-- The stalk of `O♯`, as a module over itself, is the stalk ring. -/
abbrev unitStalkEquiv (x : X) : modStalk (unitMod Rc) x ≃ₗ[ringStalk Rc x] ringStalk Rc x :=
  Stacks.AlgebraicGeometry.ReflexiveModules.unitModuleStalkLinearEquiv Rc.obj x

/-- Postcomposition with a linear map commutes with precomposition. -/
theorem comp_comp_eq {R : Type*} [CommRing R] {P Q M N : Type*} [AddCommGroup P] [Module R P]
    [AddCommGroup Q] [Module R Q] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (e : M →ₗ[R] N) (ψ : P →ₗ[R] M) (d : Q →ₗ[R] P) : (e ∘ₗ ψ) ∘ₗ d = e ∘ₗ (ψ ∘ₗ d) := rfl

/-- Undoing a postcomposition with an isomorphism, up to a sign. -/
theorem sign_comp_symm_comp {R : Type*} [CommRing R] {P Q M N : Type*} [AddCommGroup P]
    [Module R P] [AddCommGroup Q] [Module R Q] [AddCommGroup M] [Module R M] [AddCommGroup N]
    [Module R N] (u : ℤˣ) (e : M ≃ₗ[R] N) (χ : P →ₗ[R] N) (d : Q →ₗ[R] P) (ψ : Q →ₗ[R] M)
    (h : χ ∘ₗ d = e.toLinearMap ∘ₗ ψ) :
    u • ((u : ℤ) • e.symm.toLinearMap ∘ₗ χ) ∘ₗ d = ψ := by
  refine LinearMap.ext fun w => ?_
  have hw := LinearMap.congr_fun h w
  rw [LinearMap.comp_apply, LinearMap.comp_apply] at hw
  rw [Units.smul_def, LinearMap.smul_apply, LinearMap.comp_apply, LinearMap.smul_apply,
    smul_smul, ← Units.val_mul, Int.units_mul_self, Units.val_one, one_smul,
    LinearMap.comp_apply, hw]
  exact e.symm_apply_apply _

/-- A stalk element of `𝓗om^•(K, O♯[0])` whose image functional factors through the transposed
Koszul differential is a boundary. -/
private theorem exists_stalkLin_d_eq_unit
    (hφ : ∀ k : Fin r,
      ((SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Rc)).freeHomEquiv φ
        (ULift.up k)).val (op (⊤ : Opens ↥X)) = f k) (m : ℕ) (x : X)
    (z : modStalk ((homComplex Rc K (unitMod Rc)).X ((m + 1 : ℕ) : ℤ)) x)
    (χ : ⋀[ringStalk Rc x]^m (Fin r → ringStalk Rc x) →ₗ[ringStalk Rc x] ringStalk Rc x)
    (hχ : χ ∘ₗ Koszul.d (Koszul.seqDual fun k =>
        TopCat.Presheaf.germ Rc.obj (⊤ : Opens ↥X) x (Opens.mem_top x) (f k)) m =
      (unitStalkEquiv Rc x).toLinearMap ∘ₗ homComplexStalkEquiv Rc K (unitMod Rc) (m + 1) x z) :
    ∃ y, Stacks.RegularSequence.stalkLin ((homComplex Rc K (unitMod Rc)).d m (m + 1)).val x y =
      z := by
  refine ⟨(homComplexStalkEquiv Rc K (unitMod Rc) m x).symm
    (((((m : ℕ) : ℤ) + 1).negOnePow : ℤ) • ((unitStalkEquiv Rc x).symm.toLinearMap ∘ₗ χ)), ?_⟩
  apply (homComplexStalkEquiv Rc K (unitMod Rc) (m + 1) x).injective
  refine (homComplexStalkEquiv_stalkLin_d Rc K f hφ (unitMod Rc) m x _).trans ?_
  rw [LinearEquiv.apply_symm_apply]
  exact sign_comp_symm_comp _ _ _ _ _ hχ

include hφ in
/-- For a Koszul complex `K` of length `r` resolving the quotient, `𝓗om^•(K, O♯[0])` is exact in
every degree `n < r`. -/
theorem exactAt_homComplex_unit [QuasiIso K.augmentation] {n : ℕ} (hn : n < r) :
    (homComplex Rc K (unitMod Rc)).ExactAt n := by
  refine (exactAt_iff_forall_stalkAbFunctor_exactAt (Osharp := Rc) _ _).mpr fun x => ?_
  have hreg := isKoszulRegular_germ Rc K f hφ x
  set dR := fun k => Koszul.d (Koszul.seqDual fun k =>
    TopCat.Presheaf.germ Rc.obj (⊤ : Opens ↥X) x (Opens.mem_top x) (f k)) k with hdR
  have hkill : ∀ (k : ℕ) (z : modStalk ((homComplex Rc K (unitMod Rc)).X k) x),
      Stacks.RegularSequence.stalkLin ((homComplex Rc K (unitMod Rc)).d k (k + 1)).val x z = 0 →
      (unitStalkEquiv Rc x).toLinearMap ∘ₗ homComplexStalkEquiv Rc K (unitMod Rc) k x z ∘ₗ
        dR k = 0 := by
    intro k z hz
    have h1 := homComplexStalkEquiv_stalkLin_d Rc K f hφ (unitMod Rc) k x z
    rw [hz, map_zero] at h1
    have h2 : homComplexStalkEquiv Rc K (unitMod Rc) k x z ∘ₗ dR k = 0 := by
      simpa only [smul_zero, inv_smul_smul] using
        congrArg (fun g => ((((k : ℕ) : ℤ) + 1).negOnePow)⁻¹ • g) h1.symm
    rw [h2, LinearMap.comp_zero]
  cases n with
  | zero =>
    rw [HomologicalComplex.exactAt_iff' _ (-1) ((0 : ℕ) : ℤ) (((0 : ℕ) : ℤ) + 1) (by simp)
      (by simp), ShortComplex.ab_exact_iff]
    intro z hz
    refine ⟨0, ?_⟩
    rw [map_zero]
    have h3 := Koszul.eq_zero_of_comp_d_eq_zero _ hreg hn _
      ((comp_comp_eq _ _ _).trans (hkill 0 z hz))
    have h4 : homComplexStalkEquiv Rc K (unitMod Rc) 0 x z = 0 := by
      refine LinearMap.ext fun w => (unitStalkEquiv Rc x).injective ?_
      rw [LinearMap.zero_apply, map_zero]
      exact LinearMap.congr_fun h3 w
    exact ((homComplexStalkEquiv Rc K (unitMod Rc) 0 x).map_eq_zero_iff.mp h4).symm
  | succ m =>
    rw [HomologicalComplex.exactAt_iff' _ ((m : ℕ) : ℤ) ((m + 1 : ℕ) : ℤ)
      (((m + 1 : ℕ) : ℤ) + 1) (by simp) (by simp), ShortComplex.ab_exact_iff]
    intro z hz
    obtain ⟨χ, hχ⟩ := Koszul.exists_comp_d_eq _ hreg hn _
      ((comp_comp_eq _ _ _).trans (hkill (m + 1) z hz))
    exact exists_stalkLin_d_eq_unit Rc K f hφ m x z χ hχ

end Stacks.RegularSequence.KoszulChainData

namespace Stacks.RegularSequence

open Stacks.SheafOfModules Stacks.SheafOfModules.SheafHomStalk
  Stacks.AlgebraicGeometry.ReflexiveModules

variable {X : TopCat.{u}} (Rc : TopCat.Sheaf CommRingCat.{u} X)
  [HasSheafify (Opens.grothendieckTopology X) AddCommGrpCat.{u}]
  [(Opens.grothendieckTopology X).WEqualsLocallyBijective AddCommGrpCat.{u}]
  {r : ℕ}
  (φ : koszulFreeSheaf Rc r ⟶
    SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Rc))
  (f : Fin r → ↑(Rc.obj.obj (op (⊤ : Opens ↥X))))
  (hφ : ∀ k : Fin r,
    ((SheafOfModules.unit (toRingCat (Opens.grothendieckTopology ↥X) Rc)).freeHomEquiv φ
      (ULift.up k)).val (op (⊤ : Opens ↥X)) = f k)

include hφ in
/-- The stalk of `φ`, read on `(O_x)ʳ` and in `O_x`, is the linear form attached to the germs. -/
theorem unitStalk_stalkLin_koszulFree (x : X) :
    (unitModuleStalkLinearEquiv Rc.obj x).toLinearMap ∘ₗ stalkLin φ.val x ∘ₗ
        (koszulFreeStalkEquiv (Osharp := Rc) (r := r) x).symm.toLinearMap =
      Fintype.linearCombination ↑(TopCat.Presheaf.stalk Rc.obj x) (fun k =>
        TopCat.Presheaf.germ Rc.obj (⊤ : Opens ↥X) x (Opens.mem_top x) (f k)) := by
  refine LinearMap.pi_ext' fun k => LinearMap.ext_ring ?_
  show (unitModuleStalkLinearEquiv Rc.obj x) (stalkLin φ.val x
    ((koszulFreeStalkEquiv (Osharp := Rc) (r := r) x).symm (Pi.single k 1))) =
      Fintype.linearCombination ↑(TopCat.Presheaf.stalk Rc.obj x) (fun k =>
        TopCat.Presheaf.germ Rc.obj (⊤ : Opens ↥X) x (Opens.mem_top x) (f k)) (Pi.single k 1)
  rw [show (koszulFreeStalkEquiv (Osharp := Rc) (r := r) x).symm (Pi.single k 1) = _ from
      (LinearEquiv.symm_apply_eq _).mpr (koszulFreeStalkEquiv_germ_freeSection ⊤ (Opens.mem_top x)
        k).symm]
  refine ((congrArg (unitModuleStalkLinearEquiv Rc.obj x)
    (stalkLin_germAddHom φ.val ⊤ (Opens.mem_top x) _)).trans
    (unitModuleStalkAddEquiv_germ Rc.obj x ⊤ (Opens.mem_top x) _)).trans ?_
  rw [Fintype.linearCombination_apply_single, one_smul]
  exact germ_unitScalar_freeSection f hφ ⊤ (Opens.mem_top x) k

include hφ in
/-- The ideal of germs is generated by the germs of the generating sections. -/
theorem stalkGermIdeal_eq_span (x : X) :
    stalkGermIdeal Rc φ x = Ideal.span (Set.range fun k =>
      TopCat.Presheaf.germ Rc.obj (⊤ : Opens ↥X) x (Opens.mem_top x) (f k)) := by
  refine Eq.trans ?_ (Fintype.range_linearCombination _ _)
  refine Eq.trans ?_ (congrArg LinearMap.range (unitStalk_stalkLin_koszulFree Rc φ f hφ x))
  refine Eq.trans ?_ (LinearMap.range_comp _ _).symm
  exact congrArg (Submodule.map _)
    (LinearMap.range_comp_of_range_eq_top _ (LinearEquiv.range _)).symm

namespace KoszulChainData

attribute [local instance] HasDerivedCategory.standard

variable {A : SheafOfModules.TensorExteriorSymmetricAlgebras (Opens.grothendieckTopology ↥X)
    (koszulFreeSheaf Rc r)} (K : KoszulChainData.{u, u, u} A φ)

/-- A linear map out of a free module lifts along a surjection. -/
theorem exists_comp_eq_of_surjective {R : Type*} [CommRing R] {L M N : Type*} [AddCommGroup L]
    [Module R L] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N] {q : M →ₗ[R] N}
    (hq : Function.Surjective q) {ι : Type*} (B : Module.Basis ι R L) (χ : L →ₗ[R] N) :
    ∃ ψ : L →ₗ[R] M, q ∘ₗ ψ = χ :=
  ⟨B.constr R fun t => (hq (χ (B t))).choose, B.ext fun t => by
    rw [LinearMap.comp_apply, Module.Basis.constr_basis]
    exact (hq _).choose_spec⟩

/-- The terms of `𝓗om^•(K, M[0])` above the length vanish. -/
theorem isZero_homComplex_X_of_lt (M : StructureSheafModules Rc) {n : ℤ} (hn : (r : ℤ) < n) :
    IsZero ((homComplex Rc K M).X n) := by
  refine IsZero.of_iso ?_ (RingedSite.homDegreeIsoSingle (ringedSite Rc) (cochain Rc K) M n)
  refine RingedSite.internalHomSheaf_isZero_of_isZero (ringedSite Rc) ?_
  show IsZero (K.chain.X (-(-n)))
  rw [neg_neg]
  exact IsZero.of_iso (RingedSite.isZero_exteriorPiece_of_card_lt (ringedSite Rc) A
    (ULift.{u} (Fin r)) (Iso.refl _) n (by simpa using hn)) (eqToIso (K.chain_X n))

/-- The map `𝓗om^•(K, O♯[0]) ⟶ 𝓗om^•(K, (O♯/I)[0])` induced by the quotient map. -/
abbrev homComplexQuotientMap :
    homComplex Rc K (unitMod Rc) ⟶ homComplex Rc K (koszulQuotient.{u, u, u} φ) :=
  RingedSite.homMap (ringedSite Rc) (𝟙 (cochain Rc K))
    ((single (StructureSheafModules Rc) (ComplexShape.up ℤ) 0).map (koszulQuotientπ φ))

include hφ in
/-- In the top degree `r` the quotient map induces an isomorphism
`Hʳ(𝓗om^•(K, O♯[0])) ≅ Hʳ(𝓗om^•(K, (O♯/I)[0]))`. -/
theorem quasiIsoAt_homComplexQuotientMap {b : ℕ} (hr : r = b + 1) :
    QuasiIsoAt (homComplexQuotientMap Rc φ K) ((b + 1 : ℕ) : ℤ) := by
  subst hr
  rw [AlgebraicGeometry.SheafOfModules.quasiIsoAt_iff_forall_stalk_quasiIsoAt]
  intro x
  rw [quasiIsoAt_iff' _ ((b : ℕ) : ℤ) ((b + 1 : ℕ) : ℤ) (((b + 1 : ℕ) : ℤ) + 1) (by simp)
    (by simp)]
  refine (ShortComplex.quasiIso_iff_of_zeros' _ ?_ ?_ ?_).mpr ⟨?_, ?_⟩
  · exact Functor.map_isZero (AlgebraicGeometry.SheafOfModules.stalkFunctor _ x)
      (isZero_homComplex_X_of_lt Rc φ K (unitMod Rc)
        (n := ((b + 1 : ℕ) : ℤ) + 1) (by omega)) |>.eq_of_tgt _ _
  · show (AlgebraicGeometry.SheafOfModules.stalkFunctor _ x).map
      ((homComplex Rc K (koszulQuotient.{u, u, u} φ)).d (b : ℤ) ((b : ℤ) + 1)) = 0
    rw [sheafHomComplex_d_eq_zero K (b : ℤ), Functor.map_zero]
  · exact Functor.map_isZero (AlgebraicGeometry.SheafOfModules.stalkFunctor _ x)
      (isZero_homComplex_X_of_lt Rc φ K (koszulQuotient.{u, u, u} φ)
        (n := ((b + 1 : ℕ) : ℤ) + 1) (by omega)) |>.eq_of_tgt _ _
  · rw [ShortComplex.moduleCat_exact_iff]
    intro z hz
    change Stacks.RegularSequence.stalkLin _ x z = 0 at hz
    have h1 := homComplexStalkEquiv_stalkLin_homMap Rc K (koszulQuotientπ φ) (b + 1) x z
    rw [hz, map_zero] at h1
    have hker : LinearMap.ker (quotientStalkMap Rc φ x) = Ideal.span (Set.range fun k =>
        TopCat.Presheaf.germ Rc.obj (⊤ : Opens ↥X) x (Opens.mem_top x) (f k)) :=
      (ker_quotientStalkMap Rc φ x).trans (stalkGermIdeal_eq_span Rc φ f hφ x)
    have key := Koszul.exists_comp_d_eq_of_comp_eq_zero (R := ringStalk Rc x)
      (M := modStalk (koszulQuotient.{u, u, u} φ) x)
      (fun k => TopCat.Presheaf.germ Rc.obj (⊤ : Opens ↥X) x (Opens.mem_top x) (f k))
      (quotientStalkMap Rc φ x) hker
    have key2 := key ((unitStalkEquiv Rc x).toLinearMap ∘ₗ
      homComplexStalkEquiv Rc K (unitMod Rc) (b + 1) x z)
    have key3 := key2 (LinearMap.ext fun w =>
      (congrArg (Stacks.RegularSequence.stalkLin (koszulQuotientπ φ).val x)
        ((unitStalkEquiv Rc x).symm_apply_apply _)).trans (LinearMap.congr_fun h1.symm w))
    exact KoszulChainData.exists_stalkLin_d_eq_unit Rc K f hφ b x z _ key3.choose_spec
  · rw [ModuleCat.epi_iff_surjective]
    intro z
    show ∃ y, Stacks.RegularSequence.stalkLin _ x y = z
    obtain ⟨ψ, hψ⟩ := exists_comp_eq_of_surjective (quotientStalkMap_surjective Rc φ x)
      (Koszul.stdBasis (R := ringStalk Rc x) (b + 1) (b + 1))
      (homComplexStalkEquiv Rc K (koszulQuotient.{u, u, u} φ) (b + 1) x z)
    refine ⟨(homComplexStalkEquiv Rc K (unitMod Rc) (b + 1) x).symm
      ((unitStalkEquiv Rc x).symm.toLinearMap ∘ₗ ψ), ?_⟩
    apply (homComplexStalkEquiv Rc K (koszulQuotient.{u, u, u} φ) (b + 1) x).injective
    refine (homComplexStalkEquiv_stalkLin_homMap Rc K (koszulQuotientπ φ) (b + 1) x _).trans ?_
    rw [LinearEquiv.apply_symm_apply]
    exact hψ

end KoszulChainData

end Stacks.RegularSequence
