/-!
# Vanishing of `Ext` along a regular closed immersion

Let `i : Z → X` be a closed immersion of schemes which is *regular of codimension `c`*, that is,
whose defining ideal sheaf is locally generated by a regular sequence of `c` functions. Let `F`
be an arbitrary `𝒪_Z`-module and let `E` be a locally free `𝒪_X`-module. Then
`Ext^q_{𝒪_X}(i_*F, E) = 0` for every `q < c`.

## Main definitions

* `Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularIdealSheafOfCodim`: an ideal sheaf is
  regular of codimension `c` when it is locally generated by a regular sequence of `c` sections.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.IsRegularClosedImmersionOfCodim`: a closed
  immersion is regular of codimension `c` when its defining ideal sheaf is.

## Main results

* `Stacks.AlgebraicGeometry.RegularIdealSheaf.definingIdealOfHom_le_annihilator_pushforward` and
  `Stacks.AlgebraicGeometry.RegularIdealSheaf.globalSmulCenter_restrict_pushforward_eq_zero`: a
  section of the defining ideal sheaf acts as zero on a direct image.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.mem_idealQuotientSupport_of_mem_range`: the image of
  the immersion lies in the support of the quotient by its defining ideal sheaf, which is where
  the local regular sequences are available.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.exists_affine_isWeaklyRegular_and_iso_free`: an
  affine open on which the ideal is generated by a weakly regular sequence and `E` is free.
* `Stacks.RegularSequence.subsingleton_ext_pushforward_of_affine`: the vanishing, granted its
  affine case.
* `Stacks.RegularSequence.subsingleton_ext_pushforward_of_isRegularClosedImmersionOfCodim`:
  `Ext^q_{𝒪_X}(i_*F, E) = 0` for `q < c`.

## References

* [Stacks Project, Tag 0G5I](https://stacks.math.columbia.edu/tag/0G5I)
* [Stacks Project, Tag 063D](https://stacks.math.columbia.edu/tag/063D)
* [Stacks Project, Tag 063G](https://stacks.math.columbia.edu/tag/063G)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.AlgebraicGeometry.QuasiRegular
open Stacks.RingedSpace

universe u

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

/-- **A regular ideal sheaf of codimension `c`.** The ideal sheaf `J` is regular of codimension
`c` when, near every point of the support of `𝒪_X/J`, it is generated by a regular sequence of
`c` sections. -/
def IsRegularIdealSheafOfCodim (X : RingedSpace.{u})
    (J : (structureSheafModule X).Submodule) (c : ℕ) : Prop :=
  ∀ x : X, x ∈ idealQuotientSupport X J →
    ∃ (U : Opens X) (_hx : x ∈ U) (f : Fin c → X.presheaf.obj (op U)),
      IsRegularSequenceOn X U f ∧ IsGeneratedByOn X J U f

/-- An ideal sheaf which is regular of some codimension is regular. -/
theorem IsRegularIdealSheafOfCodim.isRegularIdealSheaf {X : RingedSpace.{u}}
    {J : (structureSheafModule X).Submodule} {c : ℕ}
    (h : IsRegularIdealSheafOfCodim X J c) : IsRegularIdealSheaf X J := fun x hx => by
  obtain ⟨U, hx, f, hreg, hgen⟩ := h x hx
  exact ⟨U, hx, c, f, hreg, hgen⟩

/-- **A closed immersion which is regular of codimension `c`.** The closed immersion `i` is
regular of codimension `c` when its defining ideal sheaf is regular of codimension `c`, that is,
when `i` is locally cut out by a regular sequence of `c` functions. -/
@[sga "6 0 3.2" "special case"]
def IsRegularClosedImmersionOfCodim {Z X : Scheme.{u}} (i : Z ⟶ X) (c : ℕ) : Prop :=
  IsRegularIdealSheafOfCodim X.toLocallyRingedSpace.toRingedSpace (definingIdealOfHom i) c

/-- The defining ideal sheaf of a morphism annihilates the sections of a direct image. -/
theorem definingIdealOfHom_le_annihilator_pushforward {Z X : Scheme.{u}} (i : Z ⟶ X)
    (F : Z.Modules) (U : X.Opens) (s : X.presheaf.obj (op U))
    (hs : s ∈ (definingIdealOfHom i).obj (op U)) :
    s ∈ Module.annihilator Γ(X, U) Γ((Scheme.Modules.pushforward i).obj F, U) := by
  refine Module.mem_annihilator.mpr fun m => ?_
  have hs' := (mem_definingIdealOfHom i U s).mp hs
  change i.app U s = 0 at hs'
  change Γ(F, i ⁻¹ᵁ U) at m
  change (i.app U s) • m = 0
  rw [hs', zero_smul]

/-- A section of the defining ideal sheaf of a morphism acts as zero on the restriction of a
direct image to the corresponding open subscheme. -/
theorem globalSmulCenter_restrict_pushforward_eq_zero {Z X : Scheme.{u}} (i : Z ⟶ X)
    (F : Z.Modules) (U : X.Opens) (s : Γ(X, U))
    (hs : s ∈ (definingIdealOfHom i).obj (op U)) :
    (Stacks.RegularSequence.globalSmulCenter U.toScheme (U.topIso.inv s)).app
      (((Scheme.Modules.pushforward i).obj F).restrict U.ι) = 0 := by
  apply Scheme.Modules.hom_ext
  intro V
  ext m
  rw [Stacks.RegularSequence.globalSmulCenter_app_app]
  have he : U.topIso.inv ≫ U.toScheme.presheaf.map V.leTop.op =
      X.presheaf.map (homOfLE (U.ι_image_le V)).op := by
    have hcomp : ∀ {A B C : (Opens (X : TopCat.{u}))ᵒᵖ} (a : A ⟶ B) (b : B ⟶ C) (c : A ⟶ C),
        X.presheaf.map a ≫ X.presheaf.map b = X.presheaf.map c := by
      intro A B C a b c
      rw [← X.presheaf.map_comp]
      congr 1
    simp only [Scheme.Opens.topIso_inv, Scheme.Opens.toScheme_presheaf_map]
    exact hcomp _ _ _
  have hh := congrArg (fun g : Γ(X, U) ⟶ Γ(U.toScheme, V) => g s) he
  change U.toScheme.presheaf.map V.leTop.op (U.topIso.inv s) = _ at hh
  rw [hh]
  change Γ((Scheme.Modules.pushforward i).obj F, U.ι ''ᵁ V) at m
  change (U.ι.appIso V).inv (X.presheaf.map (homOfLE (U.ι_image_le V)).op s) • m = 0
  rw [Scheme.Opens.ι_appIso]
  exact Module.mem_annihilator.mp
    (definingIdealOfHom_le_annihilator_pushforward i F (U.ι ''ᵁ V) _
      ((definingIdealOfHom i).toSubmodule.map (homOfLE (U.ι_image_le V)).op hs)) m

/-- A direct image restricts to zero on an open whose preimage is empty. -/
theorem isZero_restrict_pushforward_of_preimage_eq_bot {Z X : Scheme.{u}} (i : Z ⟶ X)
    (F : Z.Modules) (U : X.Opens) (hU : i ⁻¹ᵁ U = ⊥) :
    IsZero (((Scheme.Modules.pushforward i).obj F).restrict U.ι) := by
  have hs : (1 : Γ(X, U)) ∈ (definingIdealOfHom i).obj (op U) := by
    apply (mem_definingIdealOfHom i U (1 : Γ(X, U))).mpr
    change i.app U 1 = 0
    have _ : Subsingleton Γ(Z, i ⁻¹ᵁ U) := by rw [hU]; infer_instance
    exact Subsingleton.elim _ _
  have h := globalSmulCenter_restrict_pushforward_eq_zero i F U 1 hs
  apply (IsZero.iff_id_eq_zero _).mpr
  convert h using 1
  apply Scheme.Modules.hom_ext
  intro V
  ext m
  simp [Stacks.RegularSequence.globalSmulCenter_app_app]

/-- Every point in the image of a morphism lies in the support of the quotient by its defining
ideal sheaf. -/
theorem mem_idealQuotientSupport_of_mem_range {Z X : Scheme.{u}} (i : Z ⟶ X) (z : Z) :
    i.base z ∈ idealQuotientSupport X.toLocallyRingedSpace.toRingedSpace
      (definingIdealOfHom i) := by
  by_contra hn
  obtain ⟨U, hzU, h1⟩ := (notMem_idealQuotientSupport_iff _ _).mp hn
  have h0 := (mem_definingIdealOfHom i U (1 : Γ(X, U))).mp h1
  change (i.app U).hom 1 = 0 at h0
  have hz : z ∈ i ⁻¹ᵁ U := hzU
  have hstalk := congrArg (Z.presheaf.germ (i ⁻¹ᵁ U) z hz) h0
  exact one_ne_zero (by simpa only [map_one, map_zero] using hstalk)

/-- A trivialisation of a sheaf of modules over an open set restricts to any smaller open
set. -/
def restrictIsoFreeOfLe {X : Scheme.{u}} (E : X.Modules) {V W : X.Opens} (hVW : V ≤ W)
    (ι : Type u) (e : E.restrict W.ι ≅ SheafOfModules.free.{u} ι) :
    E.restrict V.ι ≅ SheafOfModules.free.{u} ι :=
  (Scheme.Modules.restrictFunctorCongr (X.homOfLE_ι hVW).symm).app E ≪≫
    (Scheme.Modules.restrictFunctorComp (X.homOfLE hVW) W.ι).app E ≪≫
    (Scheme.Modules.restrictFunctor (X.homOfLE hVW)).mapIso e ≪≫
    (Scheme.Modules.restrictFreeIso (X.homOfLE hVW) ι).symm

/-- **One affine open carrying both local data.** For an ideal sheaf which is regular of
codimension `c` and a locally free module `E`, every point of the support of the quotient has,
inside any neighbourhood, an affine neighbourhood on which the ideal is generated by `c` sections
forming a weakly regular sequence in the ring of sections *and* `E` is free. -/
theorem exists_affine_isWeaklyRegular_and_iso_free {X : Scheme.{u}}
    (J : (structureSheafModule X.toLocallyRingedSpace.toRingedSpace).Submodule) (c : ℕ)
    (h : IsRegularIdealSheafOfCodim X.toLocallyRingedSpace.toRingedSpace J c)
    (E : X.Modules) (hE : Scheme.Modules.IsLocallyFree E) (x : X)
    (hx : x ∈ idealQuotientSupport X.toLocallyRingedSpace.toRingedSpace J)
    (U : X.Opens) (hxU : x ∈ U) :
    ∃ (V : X.Opens) (_ : x ∈ V) (_ : V ≤ U) (_ : IsAffineOpen V) (ι : Type u),
      Nonempty (E.restrict V.ι ≅ SheafOfModules.free.{u} ι) ∧
        ∃ f : Fin c → Γ(X, V), RingTheory.Sequence.IsWeaklyRegular Γ(X, V) (List.ofFn f) ∧
          ∀ k, f k ∈ J.obj (op V) := by
  obtain ⟨A, hxA, g, hreg, hgen⟩ := h x hx
  obtain ⟨W, hxW, ι, ⟨e⟩⟩ := hE x
  obtain ⟨V, hV, hxV, hVle⟩ := Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens
    (show x ∈ U ⊓ A ⊓ W from ⟨⟨hxU, hxA⟩, hxW⟩)
  have hVA : V ≤ A := hVle.trans (inf_le_left.trans inf_le_right)
  have hVW : V ≤ W := hVle.trans inf_le_right
  refine ⟨V, hxV, hVle.trans (inf_le_left.trans inf_le_left), hV, ι,
    ⟨restrictIsoFreeOfLe E hVW ι e⟩,
    fun k => X.presheaf.map (homOfLE hVA).op (g k), ?_, ?_⟩
  · rw [← isRegularSequenceOn_iff_isWeaklyRegular X V hV]
    exact isRegularSequenceOn_of_le X.toLocallyRingedSpace.toRingedSpace hVA g hreg
  · exact fun k => (isGeneratedByOn_of_le A g hgen V hVA V le_rfl).ge
      (mem_generatedIdealOn X.toLocallyRingedSpace.toRingedSpace V _ k)

/-- Weak regularity of a sequence of sections over an open set transports to the ring of global
functions of the corresponding open subscheme. -/
theorem isWeaklyRegular_map_topIso_inv {X : Scheme.{u}} (U : X.Opens) (rs : List Γ(X, U))
    (h : RingTheory.Sequence.IsWeaklyRegular Γ(X, U) rs) :
    RingTheory.Sequence.IsWeaklyRegular Γ(U.toScheme, ⊤) (rs.map U.topIso.inv) := by
  let er := U.topIso.symm.commRingCatIsoToRingEquiv
  exact (AddEquiv.isWeaklyRegular_congr (e := er.toAddEquiv)
    (List.forall₂_map_right_iff.mpr
      (List.forall₂_same.mpr fun r _ x => er.map_mul r x))).mp h

end Stacks.AlgebraicGeometry.RegularIdealSheaf

namespace Stacks.RegularSequence

open Stacks.AlgebraicGeometry.RegularIdealSheaf

attribute [local instance] HasDerivedCategory.standard HasExt.standard

/-- **Vanishing of `Ext` along a regular closed immersion, granted the affine case.** Let
`i : Z ⟶ X` be a closed immersion which is regular of codimension `c`, let `F` be any
`𝒪_Z`-module and let `E` be a locally free `𝒪_X`-module. Then `Ext^q(i_*F, E) = 0` for `q < c`,
provided the corresponding vanishing holds on an affine scheme for a free target and a weakly
regular annihilating sequence of global functions. -/
theorem subsingleton_ext_pushforward_of_affine {Z X : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] (c : ℕ) (hi : IsRegularClosedImmersionOfCodim i c)
    (F : Z.Modules) (E : X.Modules) (hE : Scheme.Modules.IsLocallyFree E)
    (haff : ∀ (V : X.Opens), IsAffineOpen V → ∀ (N' E' : V.toScheme.Modules) (ι : Type u),
      (E' ≅ SheafOfModules.free.{u} ι) → ∀ rs : List Γ(V.toScheme, ⊤),
      (∀ r ∈ rs, (globalSmulCenter V.toScheme r).app N' = 0) →
      RingTheory.Sequence.IsWeaklyRegular Γ(V.toScheme, ⊤) rs →
      ∀ m : ℕ, m < rs.length → Subsingleton (Abelian.Ext N' E' m))
    (q : ℕ) (hq : q < c) :
    Subsingleton (Abelian.Ext ((Scheme.Modules.pushforward i).obj F) E q) := by
  refine (Equiv.subsingleton_congr Abelian.Ext.homEquiv).mpr ?_
  refine Stacks.SheafOfModules.subsingleton_shiftedHom_single_of_locally_restrict X
    ((Scheme.Modules.pushforward i).obj F) E q
    (fun V => ∀ m : ℕ, m ≤ q → Subsingleton (ShiftedHom
      ((DerivedCategory.singleFunctor V.toScheme.Modules 0).obj
        (((Scheme.Modules.pushforward i).obj F).restrict V.ι))
      ((DerivedCategory.singleFunctor V.toScheme.Modules 0).obj (E.restrict V.ι)) (m : ℤ)))
    ?_ (fun U hU => hU)
  intro x U hx
  by_cases hxi : x ∈ Set.range i.base
  · obtain ⟨z, rfl⟩ := hxi
    obtain ⟨V, hzV, hVU, hV, ι, ⟨e⟩, f, hreg, hmem⟩ :=
      exists_affine_isWeaklyRegular_and_iso_free (definingIdealOfHom i) c hi E hE (i.base z)
        (mem_idealQuotientSupport_of_mem_range i z) U hx
    refine ⟨V, hzV, hVU, fun m hm => ?_⟩
    have _ : IsAffine V.toScheme := hV
    refine (Equiv.subsingleton_congr Abelian.Ext.homEquiv).mp ?_
    refine haff V hV _ _ ι e ((List.ofFn f).map V.topIso.inv) ?_
      (isWeaklyRegular_map_topIso_inv V (List.ofFn f) hreg) m ?_
    · intro r hr
      obtain ⟨a, ha, rfl⟩ := List.mem_map.mp hr
      obtain ⟨k, rfl⟩ := List.mem_ofFn.mp ha
      exact globalSmulCenter_restrict_pushforward_eq_zero i F V (f k) (hmem k)
    · simpa using hm.trans_lt hq
  · let W : X.Opens := ⟨(Set.range i.base)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
    have hbot : i ⁻¹ᵁ (U ⊓ W) = ⊥ := le_antisymm (fun z hz => (hz.2 ⟨z, rfl⟩).elim) bot_le
    exact ⟨U ⊓ W, ⟨hx, hxi⟩, inf_le_left, fun m _ =>
      ⟨((DerivedCategory.singleFunctor _ 0).map_isZero
        (isZero_restrict_pushforward_of_preimage_eq_bot i F _ hbot)).eq_of_src⟩⟩

/-- Let `i : Z ⟶ X` be a closed immersion of schemes which is regular of codimension `c`, let
`F` be an arbitrary `𝒪_Z`-module and let `E` be a locally free `𝒪_X`-module. Then
`Ext^q_{𝒪_X}(i_*F, E) = 0` for every `q < c`. -/
@[stacks 0G5I, sga "4½ Cycle 2.2.1" "more general"]
theorem subsingleton_ext_pushforward_of_isRegularClosedImmersionOfCodim {Z X : Scheme.{u}}
    (i : Z ⟶ X) [IsClosedImmersion i] (c : ℕ) (hi : IsRegularClosedImmersionOfCodim i c)
    (F : Z.Modules) (E : X.Modules) (hE : Scheme.Modules.IsLocallyFree E)
    (q : ℕ) (hq : q < c) :
    Subsingleton (Abelian.Ext ((Scheme.Modules.pushforward i).obj F) E q) :=
  subsingleton_ext_pushforward_of_affine i c hi F E hE
    (fun V hV N' E' ι e rs hann hreg m hm =>
      have _ : IsAffine V.toScheme := hV
      subsingleton_ext_of_isAffine_of_iso_free N' E' ι e rs hann hreg m hm) q hq

end Stacks.RegularSequence

