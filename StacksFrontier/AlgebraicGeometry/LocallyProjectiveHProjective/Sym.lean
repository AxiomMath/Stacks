-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open PresheafOfModules
open Stacks.SymGraded
open Stacks.AlgebraicGeometry.RelativeProjBridge

universe u

namespace Stacks.LocallyProjectiveHProjective

/-! ### The algebraic input -/

section Algebra

variable {R : Type u} [CommRing R] (M : Type u) [AddCommGroup M] [Module R M]

/-- **The degree-zero piece of a symmetric algebra is the multiples of the unit.** -/
theorem exists_smul_oneG (t : gradedPiece (R := R) M 0) : ∃ r : R, r • oneG M = t := by
  have h0 : (t : SymmetricAlgebra R M) ∈ (1 : Submodule R (SymmetricAlgebra R M)) := by
    rw [← gradedPiece_zero (R := R) (M := M)]
    exact t.2
  obtain ⟨r, hr⟩ := Submodule.mem_one.mp h0
  exact ⟨r, Subtype.ext ((Algebra.algebraMap_eq_smul_one r).symm.trans hr)⟩

/-- **The degree-one piece of a symmetric algebra is spanned by the images of a generating
family of the module.** -/
theorem exists_sum_smul_ιG {k : ℕ} (g : Fin k → M) (hg : Submodule.span R (Set.range g) = ⊤)
    (t : gradedPiece (R := R) M 1) : ∃ c : Fin k → R, t = ∑ j, c j • ιG M (g j) := by
  have hmem : (t : SymmetricAlgebra R M) ∈ LinearMap.range (SymmetricAlgebra.ι R M) := by
    have h : (t : SymmetricAlgebra R M) ∈ SymPow.symmetricPower 1 R M := t.2
    rwa [SymPow.symmetricPower, pow_one] at h
  obtain ⟨m, hm⟩ := hmem
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp
    (show m ∈ Submodule.span R (Set.range g) from hg ▸ Submodule.mem_top)
  refine ⟨c, ?_⟩
  rw [show t = ιG (R := R) M m from Subtype.ext hm.symm, ← hc]
  simp

end Algebra

/-! ### The sheaf-level consequences -/

variable {X : Scheme.{u}} (E : X.Modules) [E.IsQuasicoherent]
  (hqc : IsQuasicoherentPieces E) {V : X.Opens} (hV : IsAffineOpen V)

include hV in
/-- **Every degree-zero section of `Sym(E)` over an affine open is a multiple of the unit.** -/
theorem exists_smul_one_eq (z : (schemeSheafGradedAlgebra E hqc).sectionPieces V 0) :
    ∃ r : ↥Γ(X, V), r • (schemeSheafGradedAlgebra E hqc).one V = z := by
  obtain ⟨t, ht⟩ := (bijective_sheafifyUnit_app_of_isAffineOpen E hV 0).2 z
  obtain ⟨r, hr⟩ := exists_smul_oneG (R := ↥Γ(X, V)) ↥Γ(E, V) t
  exact ⟨r, ((map_smul _ r (oneG (R := ↥Γ(X, V)) ↥Γ(E, V))).symm.trans
    (congrArg _ hr)).trans ht⟩

include hV in
/-- **The degree-one sections of `Sym(E)` over an affine open are spanned by finitely many of
them**, for `E` quasi-coherent of finite type: the sections of `E` over the open are a finite
module by [Stacks, Tag 01PB], and the degree-one piece of the symmetric algebra of a module is
the image of the module. -/
theorem exists_fin_span_piece_one [E.IsFiniteType] :
    ∃ (k : ℕ) (u : Fin k → (schemeSheafGradedAlgebra E hqc).sectionPieces V 1),
      ∀ w : (schemeSheafGradedAlgebra E hqc).sectionPieces V 1,
        ∃ c : Fin k → ↥Γ(X, V), w = ∑ j, c j • u j := by
  have hfin : Module.Finite ↥Γ(X, V) ↥Γ(E, V) :=
    Stacks.AlgebraicGeometry.CoherentFinite.finite_sections E hV
  obtain ⟨k, g, hg⟩ := Module.Finite.exists_fin (R := ↥Γ(X, V)) (M := ↥Γ(E, V))
  let F : gradedPiece (R := ↥Γ(X, V)) ↥Γ(E, V) 1 →ₗ[↥Γ(X, V)]
      (schemeSheafGradedAlgebra E hqc).sectionPieces V 1 :=
    (Hom.app (sheafifyUnit (R := X.ringCatSheaf) (𝟙 X.ringCatSheaf.obj)
      (siteGradedPiece E.val 1)) (op V)).hom
  refine ⟨k, fun j => F (ιG (R := ↥Γ(X, V)) ↥Γ(E, V) (g j)), fun w => ?_⟩
  obtain ⟨t, ht⟩ := (bijective_sheafifyUnit_app_of_isAffineOpen E hV 1).2 w
  obtain ⟨c, hc⟩ := exists_sum_smul_ιG (R := ↥Γ(X, V)) ↥Γ(E, V) g hg t
  refine ⟨c, ?_⟩
  have hFt : F t = w := ht
  rw [← hFt, hc, map_sum]
  exact Finset.sum_congr rfl fun j _ => map_smul F (c j) _

/-! ### The hypotheses of the chart statement, for the symmetric algebra -/

include hV in
/-- **The degree-zero part of the ring of sections of `Sym(E)` over an affine open is the image
of the structure map.** -/
theorem exists_strHom_eq (z : (schemeSheafGradedAlgebra E hqc).sectionRing V)
    (hz : z ∈ (schemeSheafGradedAlgebra E hqc).grading V 0) :
    ∃ r : ↥Γ(X, V), (schemeSheafGradedAlgebra E hqc).strHom V r = z := by
  obtain ⟨w, hw⟩ := ((schemeSheafGradedAlgebra E hqc).mem_grading_iff V z).mp hz
  obtain ⟨r, hr⟩ := exists_smul_one_eq E hqc hV w
  refine ⟨r, ?_⟩
  rw [(schemeSheafGradedAlgebra E hqc).strHom_apply V r, hr]
  exact hw

include hV in
/-- **The degree-one part of the ring of sections of `Sym(E)` over an affine open is generated,
as a module over the functions on that open, by finitely many elements.** -/
theorem exists_fin_span_grading_one [E.IsFiniteType] :
    ∃ (k : ℕ) (y : Fin (k + 1) → (schemeSheafGradedAlgebra E hqc).sectionRing V),
      (∀ j, y j ∈ (schemeSheafGradedAlgebra E hqc).grading V 1) ∧
        ∀ z ∈ (schemeSheafGradedAlgebra E hqc).grading V 1,
          ∃ c : Fin (k + 1) → ↥Γ(X, V),
            z = ∑ j, (schemeSheafGradedAlgebra E hqc).strHom V (c j) * y j := by
  obtain ⟨k, u, hu⟩ := exists_fin_span_piece_one E hqc hV
  refine ⟨k, Fin.cons 0 fun j => DirectSum.of _ 1 (u j), ?_, ?_⟩
  · refine Fin.cases ?_ ?_
    · rw [Fin.cons_zero]
      exact AddSubgroup.zero_mem _
    · intro j
      rw [Fin.cons_succ]
      exact (schemeSheafGradedAlgebra E hqc).of_mem_grading V (u j)
  · intro z hz
    obtain ⟨w, hw⟩ := ((schemeSheafGradedAlgebra E hqc).mem_grading_iff V z).mp hz
    obtain ⟨c, hc⟩ := hu w
    refine ⟨Fin.cons 0 c, ?_⟩
    rw [Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_zero, map_zero, zero_mul, zero_add, ← hw, hc,
      map_sum]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Fin.cons_succ, Fin.cons_succ]
    exact ((schemeSheafGradedAlgebra E hqc).strHom_mul_of V (c j) (u j)).symm

/-! ### The conclusion -/

section Conclusion

variable {Y Z : Scheme.{u}} {f : Y ⟶ Z}

/-- **A projective morphism is H-projective over every affine open of its base.** -/
theorem isProjectiveMorphism_pullback_snd_of_isProjective (hf : IsProjective f) {V : Z.Opens}
    (hV : IsAffineOpen V) : IsProjectiveMorphism (pullback.snd f V.ι) := by
  obtain ⟨E, hq, hft, hqc, i, hi, hif⟩ := hf
  have := hq
  have := hft
  obtain ⟨k, y, hy, hspan⟩ := exists_fin_span_grading_one E hqc hV
  exact isProjectiveMorphism_pullback_snd_of_degreeOne (schemeSheafGradedAlgebra E hqc)
    (schemeProjectiveBundle E hqc) i hi hif hV
    ((schemeSheafGradedAlgebra E hqc).adjoin_grading_one_eq_top V
      (isGeneratedInDegreeOneAt_schemeSheafGradedAlgebra E hqc hV))
    (fun z hz => exists_strHom_eq E hqc hV z hz) y hy hspan

/-- H-projectivity of the base change along an open immersion is that of the restriction. -/
private theorem isProjectiveMorphism_pullback_snd_iff (f : Y ⟶ Z) (V : Z.Opens) :
    IsProjectiveMorphism (pullback.snd f V.ι) ↔ IsProjectiveMorphism (f ∣_ V) := by
  have e := pullbackRestrictIsoRestrict_hom_morphismRestrict f V
  refine ⟨fun h => ?_, fun h => ?_⟩
  · rw [← e] at h
    have h2 := Stacks.ProperRelativeAmpleProjective.isProjectiveMorphism_iso_hom_comp
      (pullbackRestrictIsoRestrict f V).symm h
    rwa [Iso.symm_hom, Iso.inv_hom_id_assoc] at h2
  · rw [← e]
    exact Stacks.ProperRelativeAmpleProjective.isProjectiveMorphism_iso_hom_comp _ h

/-- **A projective morphism restricted to an affine open of its base is H-projective.** -/
theorem isProjectiveMorphism_morphismRestrict_of_isProjective (hf : IsProjective f) {V : Z.Opens}
    (hV : IsAffineOpen V) : IsProjectiveMorphism (f ∣_ V) :=
  (isProjectiveMorphism_pullback_snd_iff f V).mp
    (isProjectiveMorphism_pullback_snd_of_isProjective hf hV)

/-- **Stacks Project, Tag 01WB, the implication (1) ⟹ (2).** A locally projective morphism is
H-projective over the members of an open covering of its base.

Over each member `U` of the covering witnessing local projectivity the morphism is projective,
so over each affine open `V` of `U` it is H-projective; and the images of those affine opens,
over all members of the covering, cover the base. -/
@[stacks 01WB "(1) ⟹ (2): locally projective implies locally H-projective"]
theorem isLocallyProjectiveMorphism_of_isLocallyProjective (hf : IsLocallyProjective f) :
    IsLocallyProjectiveMorphism f := by
  obtain ⟨ι, U, hU, hP⟩ := hf
  refine ⟨Scheme.Cover.mkOfCovers (Σ i : ι, (U i).toScheme.affineOpens)
    (fun p => ((U p.1).ι ''ᵁ (p.2.1 : (U p.1).toScheme.Opens)).toScheme)
    (fun p => ((U p.1).ι ''ᵁ (p.2.1 : (U p.1).toScheme.Opens)).ι) (fun x => ?_), fun p => ?_⟩
  · have hxtop : x ∈ ⨆ i, U i := by rw [hU]; trivial
    obtain ⟨i, hx⟩ := TopologicalSpace.Opens.mem_iSup.mp hxtop
    have hytop : (⟨x, hx⟩ : (U i).toScheme) ∈
        ⨆ V : (U i).toScheme.affineOpens, (V.1 : (U i).toScheme.Opens) := by
      rw [iSup_affineOpens_eq_top]; trivial
    obtain ⟨V, hxV⟩ := TopologicalSpace.Opens.mem_iSup.mp hytop
    exact ⟨⟨i, V⟩, ⟨x, ⟨⟨x, hx⟩, hxV, rfl⟩⟩, rfl⟩
  · obtain ⟨i, V⟩ := p
    have h1 : IsProjectiveMorphism ((f ∣_ U i) ∣_ (V.1 : (U i).toScheme.Opens)) :=
      isProjectiveMorphism_morphismRestrict_of_isProjective (hP i) V.2
    have e := morphismRestrictRestrict f (U i) (V.1 : (U i).toScheme.Opens)
    have h2 : IsProjectiveMorphism (f ∣_ (U i).ι ''ᵁ (V.1 : (U i).toScheme.Opens)) :=
      h1.of_iso (Arrow.leftFunc.mapIso e) (Arrow.rightFunc.mapIso e) (Arrow.w e.hom)
    exact (isProjectiveMorphism_pullback_snd_iff f _).mpr h2

/-- **Stacks Project, Tag 01WB.** A morphism of schemes is locally projective if and only if its
base is covered by opens over which it is H-projective. -/
@[stacks 01WB]
theorem isLocallyProjective_iff_isLocallyProjectiveMorphism :
    IsLocallyProjective f ↔ IsLocallyProjectiveMorphism f :=
  ⟨isLocallyProjectiveMorphism_of_isLocallyProjective,
    isLocallyProjective_of_isLocallyProjectiveMorphism⟩

end Conclusion

end Stacks.LocallyProjectiveHProjective

end
