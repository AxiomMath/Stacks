/-! ### Nakayama's lemma across a ring map -/

/-- **The multiples of a module by an ideal of a base ring form a submodule over the top ring.**
For `φ : A →+* R` and `M` an `R`-module whose `A`-action is the restriction of its `R`-action
along `φ`, the `A`-submodule `𝔞 · M` is the underlying set of an `R`-submodule.

It is generated over `A` by the elements `a · m` with `a ∈ 𝔞`, and
`c · (a · m) = (c · φ(a)) · m = (φ(a) · c) · m = a · (c · m)` because `R` is commutative. The
submodule is produced existentially, with its membership predicate, so that the statements built
on it never have to unfold the construction. -/
theorem exists_submodule_mem_iff_mem_smul_top {A R M : Type u} [CommRing A] [CommRing R]
    [AddCommGroup M] [Module R M] [Module A M] (φ : A →+* R)
    (hcompat : ∀ (a : A) (x : M), a • x = φ a • x) (𝔞 : Ideal A) :
    ∃ N : Submodule R M, ∀ y : M, y ∈ N ↔ y ∈ 𝔞 • (⊤ : Submodule A M) := by
  refine ⟨{ (𝔞 • (⊤ : Submodule A M)).toAddSubmonoid with smul_mem' := ?_ }, fun _ => Iff.rfl⟩
  intro c y hy
  refine Submodule.smul_induction_on (p := fun z => c • z ∈ 𝔞 • (⊤ : Submodule A M)) hy ?_ ?_
  · intro a ha n _
    have hc : c • (a • n) = a • (c • n) := by
      rw [hcompat a n, hcompat a (c • n), smul_smul, smul_smul, mul_comm]
    rw [hc]
    exact Submodule.smul_mem_smul ha Submodule.mem_top
  · intro y₁ y₂ h₁ h₂
    rw [smul_add]
    exact Submodule.add_mem _ h₁ h₂

/-- **An `R`-submodule closed under the elements of `𝔞` is closed under `Ideal.map φ 𝔞`.** The
generators `φ(a)` of `Ideal.map φ 𝔞` act on `M` as the elements `a` of `𝔞` do, and the
`R`-multiples of a generator stay inside because the target is an `R`-submodule; so
`Submodule.span_induction` over `φ '' 𝔞` concludes. -/
theorem smul_mem_of_mem_map {A R M : Type u} [CommRing A] [CommRing R] [AddCommGroup M]
    [Module R M] [Module A M] (φ : A →+* R)
    (hcompat : ∀ (a : A) (x : M), a • x = φ a • x) (𝔞 : Ideal A) (N : Submodule R M)
    (hN : ∀ a ∈ 𝔞, ∀ x : M, a • x ∈ N) :
    ∀ r ∈ Ideal.map φ 𝔞, ∀ n : M, r • n ∈ N := by
  intro r hr
  replace hr : r ∈ Submodule.span R (⇑φ '' (𝔞 : Set A)) := hr
  induction hr using Submodule.span_induction with
  | mem z hz =>
      obtain ⟨a, ha, rfl⟩ := hz
      intro n
      rw [← hcompat a n]
      exact hN a ha n
  | zero => intro n; rw [zero_smul]; exact N.zero_mem
  | add z w _ _ ihz ihw => intro n; rw [add_smul]; exact N.add_mem (ihz n) (ihw n)
  | smul c z _ ih => intro n; rw [smul_eq_mul, mul_smul]; exact N.smul_mem c (ih n)

/-- **Nakayama's lemma for a module over `R` which is finite over a local ring `A` mapping to
`R`.** Let `φ : A →+* R` with `A` local, let `M` be an `R`-module which is also an `A`-module by
restriction along `φ`, and suppose `M` is finite over `A`. If `M` is its own multiple by the
`R`-ideal generated by the image of the maximal ideal of `A`, then every element of `M` is zero.

The `A`-submodule `𝔪 · M` is an `R`-submodule — `exists_submodule_mem_iff_mem_smul_top` — and it
absorbs `Ideal.map φ 𝔪` — `smul_mem_of_mem_map`. So the hypothesis gives `M = 𝔪 · M` over `A`,
and `Submodule.eq_bot_of_le_smul_of_le_jacobson_bot` applies, the maximal ideal of a local ring
being the Jacobson radical of `0` (`IsLocalRing.jacobson_eq_maximalIdeal`). -/
@[ega "0 7.1.13" "special case", ega "IV 2.5.5.4" "more general"]
theorem eq_zero_of_top_le_smul_map_maximalIdeal {A : Type u} [CommRing A] [IsLocalRing A]
    {R : Type u} [CommRing R] (φ : A →+* R) {M : Type u} [AddCommGroup M] [Module R M]
    [Module A M] [Module.Finite A M] (hcompat : ∀ (a : A) (x : M), a • x = φ a • x)
    (hle : (⊤ : Submodule R M) ≤
      Ideal.map φ (IsLocalRing.maximalIdeal A) • (⊤ : Submodule R M)) (x : M) :
    x = 0 := by
  obtain ⟨N, hNmem⟩ :=
    exists_submodule_mem_iff_mem_smul_top φ hcompat (IsLocalRing.maximalIdeal A)
  have hN : ∀ a ∈ IsLocalRing.maximalIdeal A, ∀ y : M, a • y ∈ N := fun a ha y =>
    (hNmem _).2 (Submodule.smul_mem_smul ha Submodule.mem_top)
  have hIN : Ideal.map φ (IsLocalRing.maximalIdeal A) • (⊤ : Submodule R M) ≤ N :=
    Submodule.smul_le.2 fun r hr n _ =>
      smul_mem_of_mem_map φ hcompat (IsLocalRing.maximalIdeal A) N hN r hr n
  have hle' : (⊤ : Submodule A M) ≤ IsLocalRing.maximalIdeal A • (⊤ : Submodule A M) :=
    fun y _ => (hNmem y).1 (hIN (hle (Submodule.mem_top (x := y))))
  have hjac : IsLocalRing.maximalIdeal A ≤ Ideal.jacobson (⊥ : Ideal A) :=
    le_of_eq (IsLocalRing.jacobson_eq_maximalIdeal (⊥ : Ideal A) bot_ne_top).symm
  have hbot : (⊤ : Submodule A M) = ⊥ :=
    Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ ⊤ Module.Finite.fg_top hle' hjac
  exact (Submodule.mem_bot A).1 (hbot.le (Submodule.mem_top (x := x)))

/-! ### The two inputs of the Nakayama step -/

/-- **The auxiliary kernel of `epi_map_rightDerived_idealMultiples` is quasi-coherent.** For `ℱ`
quasi-coherent, the kernel of `⨁_{a ∈ I} ℱ ⟶ Iℱ` is quasi-coherent.

The coproduct of copies of `ℱ` is quasi-coherent by instance search; `ℱ/Iℱ` is then
quasi-coherent because quasi-coherent modules are closed under cokernels, the subsheaf
`Iℱ = ker(ℱ ⟶ ℱ/Iℱ)` because they are closed under kernels, and the kernel in question for the
same reason. -/
theorem isQuasicoherent_kernel_factorThruImage_idealMultiples (X : Scheme.{u})
    (I : Ideal ↥Γ(X, ⊤)) (F : X.Modules) [F.IsQuasicoherent] :
    (kernel (Abelian.factorThruImage (idealMultiples X I F))).IsQuasicoherent := by
  have hsum : (∐ fun _ : ↥I => F).IsQuasicoherent := inferInstance
  have hcok : (cokernel (idealMultiples X I F)).IsQuasicoherent :=
    (SheafOfModules.isQuasicoherent X.ringCatSheaf).prop_cokernel (idealMultiples X I F) hsum
      ‹F.IsQuasicoherent›
  have himg : (kernel (cokernel.π (idealMultiples X I F))).IsQuasicoherent :=
    (SheafOfModules.isQuasicoherent X.ringCatSheaf).prop_kernel
      (cokernel.π (idealMultiples X I F)) ‹F.IsQuasicoherent› hcok
  exact (SheafOfModules.isQuasicoherent X.ringCatSheaf).prop_kernel
    (Abelian.factorThruImage (idealMultiples X I F)) hsum himg

/-- **Vanishing for the coherent modules gives vanishing for the quasi-coherent ones**, in the
`ℕ`-indexed spelling. This is
`isZero_rightDerivedPlus_moduleGlobalSections_of_forall_isCoherent` of
`FinitePresentationSuffices.lean` read through `Stacks.DerivedIndexing.rightDerivedIso`. -/
theorem isZero_rightDerived_of_forall_isCoherent (X : Scheme.{u}) [IsLocallyNoetherian X]
    [CompactSpace (X : Type u)] [QuasiSeparatedSpace (X : Type u)] (q : ℕ) (F : X.Modules)
    [F.IsQuasicoherent]
    (h : ∀ G : X.Modules, G.IsCoherent →
      IsZero (((moduleGlobalSections X).rightDerived q).obj G)) :
    IsZero (((moduleGlobalSections X).rightDerived q).obj F) :=
  (Stacks.DerivedIndexing.isZero_rightDerived_obj_iff (moduleGlobalSections X) q F).2
    (isZero_rightDerivedPlus_moduleGlobalSections_of_forall_isCoherent X ((q : ℕ) : ℤ)
      (Int.natCast_nonneg q) F fun G hG =>
        (Stacks.DerivedIndexing.isZero_rightDerived_obj_iff (moduleGlobalSections X) q G).1
          (h G hG))

/-! ### The Nakayama step over the base ring -/

section LocalBase

variable {A : Type u} [CommRing A] [IsLocalRing A]

/-- **`Hᵖ(X, ℱ) = 0` from the acyclicity of `ℱ/𝔪ℱ`, with Nakayama run over the base ring.**
This is `isZero_rightDerived_of_isZero_cokernel` of `IdealMultiplesCohomology.lean` with the two
side conditions of Nakayama's lemma read over `A` instead of over `Γ(X, ⊤)`: the finiteness is
asked for the cohomology as an `A`-module, and the Jacobson condition has disappeared because `A`
is local.

`top_le_smul_top_rightDerived` makes `Hᵖ(X, ℱ)` its own multiple by `baseMaximalIdeal f`, which
is by definition `Ideal.map φ 𝔪` for `φ : A →+* Γ(X, ⊤)` the structure map on global functions,
and `eq_zero_of_top_le_smul_map_maximalIdeal` turns that into the vanishing. -/
theorem isZero_rightDerived_of_isZero_cokernel_baseRing {X : Scheme.{u}}
    [CompactSpace (X : Type u)] [QuasiSeparatedSpace (X : Type u)] (f : X ⟶ Spec (.of A))
    (F : X.Modules) (p : ℕ)
    (hfin : Module.Finite A ↥((ModuleCat.restrictScalars
        ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom).obj
      (((moduleGlobalSections X).rightDerived p).obj F)))
    (hcoker : IsZero (((moduleGlobalSections X).rightDerived p).obj
      (cokernel (idealMultiples X (baseMaximalIdeal f) F))))
    (hker : IsZero (((moduleGlobalSections X).rightDerived (p + 1)).obj
      (kernel (Abelian.factorThruImage (idealMultiples X (baseMaximalIdeal f) F))))) :
    IsZero (((moduleGlobalSections X).rightDerived p).obj F) := by
  have hle := top_le_smul_top_rightDerived X (baseMaximalIdeal f) F p hcoker hker
  set φ : A →+* ↥Γ(X, ⊤) := ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom with hφ
  set H := ((moduleGlobalSections X).rightDerived p).obj F with hHdef
  let : Module A ↥H := ((ModuleCat.restrictScalars φ).obj H).isModule
  have : Module.Finite A ↥H := hfin
  have hcompat : ∀ (a : A) (x : ↥H), a • x = φ a • x := fun _ _ => rfl
  have hle' : (⊤ : Submodule ↥Γ(X, ⊤) ↥H) ≤
      Ideal.map φ (IsLocalRing.maximalIdeal A) • (⊤ : Submodule ↥Γ(X, ⊤) ↥H) := hle
  refine ModuleCat.isZero_iff_subsingleton.mpr ⟨fun x y => ?_⟩
  have hz : ∀ z : ↥H, z = 0 := fun z =>
    eq_zero_of_top_le_smul_map_maximalIdeal φ hcompat hle' z
  rw [hz x, hz y]

/-! ### The vanishing -/

variable [IsNoetherianRing A]

/-- **The cohomology of a quasi-coherent module vanishes above the dimension of the closed
fibre.** Let `A` be a Noetherian local ring, let `f : X ⟶ Spec A` be proper and suppose the fibre
over the closed point has topological Krull dimension at most `d`. Then `Hᵖ(X, ℱ) = 0` for every
`p > d` and every quasi-coherent `ℱ`.

This is the conclusion of [Stacks, Tag 02V7] at the closed point of the spectrum of a local ring;
see the implementation notes for why it is not the tag.

The proof is a descending induction on the degree.
`AlgebraicGeometry.exists_isZero_rightDerived_moduleGlobalSections_of_isProper` supplies a degree
`N` above which there is nothing to prove, and the step from `p + 1` to `p` is: restrict to the
coherent modules by `isZero_rightDerived_of_forall_isCoherent`; for a coherent `𝒢` the acyclicity
of `𝒢/𝔪𝒢` in degree `p` is
`isZero_rightDerived_cokernel_idealMultiples_baseMaximalIdeal`, the vanishing of `Hᵖ⁺¹` on the
auxiliary kernel is the inductive hypothesis at the quasi-coherent module
`isQuasicoherent_kernel_factorThruImage_idealMultiples` produces, the finiteness of `Hᵖ(X, 𝒢)`
over `A` is [Stacks, Tag 02O6], and `isZero_rightDerived_of_isZero_cokernel_baseRing` concludes. -/
@[ega "III 4.2.2" "special case", sga "6 XII 4.4" "partial"]
theorem isZero_rightDerived_of_closedFibre_dim_le {X : Scheme.{u}} (f : X ⟶ Spec (.of A))
    [IsProper f] {d : ℕ}
    (hdim : topologicalKrullDim (f.fiber (IsLocalRing.closedPoint A)) ≤ (d : WithBot ℕ∞))
    (p : ℕ) (hp : d < p) (F : X.Modules) (hF : F.IsQuasicoherent) :
    IsZero (((moduleGlobalSections X).rightDerived p).obj F) := by
  have : IsLocallyNoetherian X := AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian f
  have : CompactSpace (X : Type u) := QuasiCompact.compactSpace_of_compactSpace f
  have : QuasiSeparatedSpace (X : Type u) := quasiSeparatedSpace_of_quasiSeparated f
  have : IsLocallyNoetherian (Spec (.of A)) :=
    isLocallyNoetherian_Spec.2 ‹IsNoetherianRing A›
  have hsurj : Function.Surjective (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom :=
    (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of A)).inv).2
  obtain ⟨N, hN⟩ :=
    AlgebraicGeometry.exists_isZero_rightDerived_moduleGlobalSections_of_isProper A f
  have key : ∀ k q : ℕ, N ≤ q + k → d < q → ∀ G : X.Modules, G.IsQuasicoherent →
      IsZero (((moduleGlobalSections X).rightDerived q).obj G) := by
    intro k
    induction k with
    | zero => exact fun q hq _ G hG => hN G hG q (by omega)
    | succ k ih =>
      intro q hq hdq G hG
      have := hG
      refine isZero_rightDerived_of_forall_isCoherent X q G fun Gc hGc => ?_
      have := hGc
      have : Gc.IsQuasicoherent := _root_.isQuasicoherent_of_isCoherent Gc
      have hfin : Module.Finite A ↥((ModuleCat.restrictScalars
          ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom).obj
          (((moduleGlobalSections X).rightDerived q).obj Gc)) :=
        have _ := AlgebraicGeometry.ProperCoherenceWitness.moduleFinite_cohomology f Gc q
        Stacks.AlgebraicGeometry.ProperCohomologyFinite.moduleFinite_compHom_of_surjective
          (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom hsurj
          ((ModuleCat.restrictScalars f.appTop.hom).obj
            (((moduleGlobalSections X).rightDerived q).obj Gc))
      have hcoker :=
        isZero_rightDerived_cokernel_idealMultiples_baseMaximalIdeal f Gc hdim hdq
      have hker := ih (q + 1) (by omega) (by omega)
        (kernel (Abelian.factorThruImage (idealMultiples X (baseMaximalIdeal f) Gc)))
        (isQuasicoherent_kernel_factorThruImage_idealMultiples X (baseMaximalIdeal f) Gc)
      exact isZero_rightDerived_of_isZero_cokernel_baseRing f Gc q hfin hcoker hker
  exact key N p (by omega) hp F hF

/-- **The same vanishing in the `ℤ`-indexed spelling**, which is the indexing the statements of
`StacksFrontier/AlgebraicGeometry/TopDegreeBaseChange/` are written in. -/
theorem isZero_rightDerivedPlus_of_closedFibre_dim_le {X : Scheme.{u}} (f : X ⟶ Spec (.of A))
    [IsProper f] {d : ℕ}
    (hdim : topologicalKrullDim (f.fiber (IsLocalRing.closedPoint A)) ≤ (d : WithBot ℕ∞))
    (i : ℤ) (hi : (d : ℤ) < i) (F : X.Modules) (hF : F.IsQuasicoherent) :
    IsZero (((moduleGlobalSections X).rightDerivedPlus i).obj F) := by
  obtain ⟨q, rfl⟩ := Int.eq_ofNat_of_zero_le (show (0 : ℤ) ≤ i by omega)
  exact (Stacks.DerivedIndexing.isZero_rightDerivedPlus_obj_iff (moduleGlobalSections X)
    (rfl : ((q : ℕ) : ℤ) = (q : ℕ)) F).2
    (isZero_rightDerived_of_closedFibre_dim_le f hdim q (by omega) F hF)

/-- **The case `d = 1`.** For `A` Noetherian local, `f : X ⟶ Spec A` proper whose closed fibre has
dimension at most one, and `ℱ` quasi-coherent, `Hᵖ(X, ℱ) = 0` for every `p > 1`.

This is what clause (1) of [Stacks, Tag 0B4X] needs, and it replaces the hypothesis
`CohomologyVanishesAboveOne` there — which is the same statement over an arbitrary affine base. -/
theorem isZero_rightDerivedPlus_of_closedFibre_dim_le_one {X : Scheme.{u}}
    (f : X ⟶ Spec (.of A)) [IsProper f]
    (hdim : topologicalKrullDim (f.fiber (IsLocalRing.closedPoint A)) ≤ ((1 : ℕ) : WithBot ℕ∞))
    (i : ℤ) (hi : 1 < i) (F : X.Modules) (hF : F.IsQuasicoherent) :
    IsZero (((moduleGlobalSections X).rightDerivedPlus i).obj F) :=
  isZero_rightDerivedPlus_of_closedFibre_dim_le f hdim i (by exact_mod_cast hi) F hF

end LocalBase

end

end Stacks.AlgebraicGeometry.TopDegreeBaseChange

