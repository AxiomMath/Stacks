namespace Stacks.AlgebraicGeometry.TopDegreeBaseChange

attribute [local instance] HasDerivedCategory.standard

noncomputable section

/-! ### A module killed by a global function -/

/-- A module element killed by a unit is zero. Stated abstractly because at the sheaf spelling
the scalar and the module live in bundled categories, where `IsUnit.smul_eq_zero` does not
match. -/
private lemma eq_zero_of_isUnit_smul_eq_zero {R M : Type*} [Ring R] [AddCommGroup M]
    [Module R M] {r : R} (hr : IsUnit r) {y : M} (h : r • y = 0) : y = 0 :=
  hr.smul_eq_zero.1 h

/-- **A sheaf of modules killed by a global function has no stalk where that function is
invertible.** If `a • 𝟙 ℱ = 0` for a global function `a` on `X`, then the stalk of `ℱ` at every
point of `X.basicOpen a` is a zero object.

A stalk element is the germ of a section `s` over some open `U` containing the point. Over
`U ⊓ X.basicOpen a` the function `a` is invertible
(`AlgebraicGeometry.RingedSpace.isUnit_of_isUnit_germ`, each germ of `a` there being a unit by
the definition of the basic open) while it still annihilates the sections of `ℱ`
(`Stacks.SheafOfModules.smul_val_app`); so the restriction of `s` vanishes, and with it the
germ. -/
theorem isZero_stalk_of_smul_id_eq_zero (X : Scheme.{u}) (F : X.Modules) (a : ↥Γ(X, ⊤))
    (ha : a • 𝟙 F = 0) (x : (X : Type u)) (hx : x ∈ X.basicOpen a) :
    IsZero (TopCat.Presheaf.stalk (X := X.toTopCat) F.val.presheaf x) := by
  rw [AddCommGrpCat.isZero_iff_subsingleton]
  have key : ∀ t : ↥(TopCat.Presheaf.stalk (X := X.toTopCat) F.val.presheaf x), t = 0 := by
    intro t
    obtain ⟨U, hxU, s, hs⟩ :=
      TopCat.Presheaf.exists_germ_eq (X := X.toTopCat) F.val.presheaf t
    set V : Opens (X : Type u) := U ⊓ X.basicOpen a
    have hxV : x ∈ V := ⟨hxU, hx⟩
    have hiVU : V ≤ U := inf_le_left
    -- `a` restricts to a unit on `V`, because every one of its germs there is a unit.
    have hunitC : IsUnit (X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op a) := by
      refine X.toRingedSpace.isUnit_of_isUnit_germ V _ fun y hy => ?_
      rw [X.presheaf.germ_res_apply (homOfLE (le_top : V ≤ ⊤)) y hy a]
      exact (X.toRingedSpace.mem_basicOpen a y True.intro).1 hy.2
    have hunit : IsUnit (X.ringCatSheaf.obj.map (homOfLE (le_top : V ≤ ⊤)).op a) := hunitC
    -- and it still annihilates the sections of `ℱ` over `V`.
    have hkill : ∀ y : F.val.obj (op V),
        (X.ringCatSheaf.obj.map (homOfLE (le_top : V ≤ ⊤)).op a) • y = 0 := by
      intro y
      have hmor : (isTerminalTop.from ((op V).unop) : V ⟶ ⊤) = homOfLE (le_top : V ≤ ⊤) :=
        Subsingleton.elim _ _
      have h1 := Stacks.SheafOfModules.smul_val_app X.ringCatSheaf ↥Γ(X, ⊤) ⊤ isTerminalTop
        (RingHom.id ↥Γ(X, ⊤)) a (𝟙 F) (op V) y
      rw [hmor] at h1
      exact h1.symm.trans (congrArg (fun g : F ⟶ F => (g.val.app (op V)) y) ha)
    have hzero : F.val.presheaf.map (homOfLE hiVU).op s = 0 :=
      eq_zero_of_isUnit_smul_eq_zero hunit (hkill (F.val.map (homOfLE hiVU).op s))
    calc t = TopCat.Presheaf.germ (X := X.toTopCat) F.val.presheaf U x hxU s := hs.symm
      _ = TopCat.Presheaf.germ (X := X.toTopCat) F.val.presheaf V x hxV
            (F.val.presheaf.map (homOfLE hiVU).op s) :=
          (TopCat.Presheaf.germ_res_apply (X := X.toTopCat) F.val.presheaf
            (homOfLE hiVU) x hxV s).symm
      _ = 0 := by rw [hzero, map_zero]
  exact ⟨fun u v => (key u).trans (key v).symm⟩

/-! ### The quotient by the multiples of an ideal of global functions -/

variable (X : Scheme.{u}) (I : Ideal ↥Γ(X, ⊤)) (F : X.Modules)

/-- **`ℱ/Iℱ` is killed by every element of `I`.** Multiplication by `a ∈ I` on `ℱ` is the `a`-th
component of `ψ : ⨁_{a ∈ I} ℱ ⟶ ℱ` composed with `ψ`, so it vanishes after the cokernel
projection; the projection is an epimorphism, and multiplication by `a` commutes with it. -/
theorem smul_id_cokernel_idealMultiples_eq_zero {a : ↥Γ(X, ⊤)} (ha : a ∈ I) :
    a • 𝟙 (cokernel (idealMultiples X I F)) = 0 := by
  have hcomp : (a • 𝟙 F) ≫ cokernel.π (idealMultiples X I F) = 0 := by
    rw [← ι_idealMultiples X I F ⟨a, ha⟩, Category.assoc, cokernel.condition, comp_zero]
  have hsmul : a • cokernel.π (idealMultiples X I F)
      = (a • 𝟙 F) ≫ cokernel.π (idealMultiples X I F) := by
    rw [Linear.smul_comp, Category.id_comp]
  refine (cancel_epi (cokernel.π (idealMultiples X I F))).1 ?_
  rw [comp_zero, Linear.comp_smul, Category.comp_id, hsmul, hcomp]

/-- **The stalks of `ℱ/Iℱ` vanish off the zero locus of `I`.** At a point where some `a ∈ I` is
invertible this is `isZero_stalk_of_smul_id_eq_zero` applied to
`smul_id_cokernel_idealMultiples_eq_zero`. -/
theorem isZero_stalk_cokernel_idealMultiples {x : (X : Type u)}
    (hx : ∃ a ∈ I, x ∈ X.basicOpen a) :
    IsZero (TopCat.Presheaf.stalk (X := X.toTopCat)
      (cokernel (idealMultiples X I F)).val.presheaf x) := by
  obtain ⟨a, ha, hax⟩ := hx
  exact isZero_stalk_of_smul_id_eq_zero X (cokernel (idealMultiples X I F)) a
    (smul_id_cokernel_idealMultiples_eq_zero X I F ha) x hax

/-- **The acyclicity of `ℱ/Iℱ` above the dimension of the zero locus of `I`.** Let `S` be a
closed subset of `X` which is Noetherian of topological Krull dimension at most `d` and off which
some element of `I` is invertible at every point. Then `Hᵖ(X, ℱ/Iℱ) = 0` for every `p > d`.

This is the hypothesis `hcoker` of `epi_map_rightDerived_idealMultiples`,
`top_le_smul_top_rightDerived` and `isZero_rightDerived_of_isZero_cokernel`. There is no
hypothesis on `X` beyond the scheme structure, none on `ℱ`, and none relating `I` to a morphism:
`S` is a parameter, which a geometric input supplies as a fibre. -/
theorem isZero_rightDerived_cokernel_idealMultiples_of_dim_le
    (S : Set (X : Type u)) (hS : IsClosed S) [NoetherianSpace S] {d p : ℕ}
    (hdim : topologicalKrullDim S ≤ (d : WithBot ℕ∞)) (hp : d < p)
    (hzl : ∀ x : (X : Type u), x ∉ S → ∃ a ∈ I, x ∈ X.basicOpen a) :
    IsZero (((moduleGlobalSections X).rightDerived p).obj (cokernel (idealMultiples X I F))) :=
  Stacks.CohomologyVanishing.isZero_rightDerived_moduleGlobalSections_of_forall_stalk_isZero
    X S hS hdim hp _ fun x hx => isZero_stalk_cokernel_idealMultiples X I F (hzl x hx)

/-- **The acyclicity of `ℱ/Iℱ` above the dimension of the zero locus of `I`, in the `ℤ`-indexed
spelling.** This is `isZero_rightDerived_cokernel_idealMultiples_of_dim_le` for
`Functor.rightDerivedPlus`, the indexing the statements of
`StacksFrontier/AlgebraicGeometry/TopDegreeBaseChange/` are written in. -/
theorem isZero_rightDerivedPlus_cokernel_idealMultiples_of_dim_le
    (S : Set (X : Type u)) (hS : IsClosed S) [NoetherianSpace S] {d : ℕ} {i : ℤ}
    (hdim : topologicalKrullDim S ≤ (d : WithBot ℕ∞)) (hi : (d : ℤ) < i)
    (hzl : ∀ x : (X : Type u), x ∉ S → ∃ a ∈ I, x ∈ X.basicOpen a) :
    IsZero (((moduleGlobalSections X).rightDerivedPlus i).obj
      (cokernel (idealMultiples X I F))) :=
  Stacks.CohomologyVanishing.isZero_rightDerivedPlus_moduleGlobalSections_of_forall_stalk_isZero
    X S hS hdim hi _ fun x hx => isZero_stalk_cokernel_idealMultiples X I F (hzl x hx)

/-! ### The quotient by the maximal ideal of a local affine base -/

section LocalBase

variable {A : Type u} [CommRing A] [IsLocalRing A] {Y : Scheme.{u}}

/-- **The ideal of global functions generated by the maximal ideal of a local affine base.**
For `f : X ⟶ Spec A` with `A` local, this is the ideal `𝔪 · Γ(X, ⊤)` whose quotient
`ℱ/𝔪ℱ` is supported on the closed fibre. -/
def baseMaximalIdeal {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) : Ideal ↥Γ(X, ⊤) :=
  Ideal.map ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom (IsLocalRing.maximalIdeal A)

/-- **Off the closed fibre some element of `𝔪 · Γ(X, ⊤)` is invertible.** If `x` does not lie
over the closed point then the prime `f(x)` is strictly contained in `𝔪`, so some `a ∈ 𝔪` is
outside it; the image of such an `a` is invertible at `x`, because the preimage of the basic
open of `a` is the basic open of its image (`AlgebraicGeometry.Scheme.preimage_basicOpen_top`)
and on `Spec A` the basic open of `a` is the set of primes avoiding it. -/
theorem exists_mem_baseMaximalIdeal_mem_basicOpen {X : Scheme.{u}} (f : X ⟶ Spec (.of A))
    {x : (X : Type u)} (hx : f.base x ≠ IsLocalRing.closedPoint A) :
    ∃ a ∈ baseMaximalIdeal f, x ∈ X.basicOpen a := by
  have _ : (f.base x).asIdeal.IsPrime := (f.base x).2
  have hlt : (f.base x).asIdeal < IsLocalRing.maximalIdeal A :=
    lt_of_le_of_ne (IsLocalRing.le_maximalIdeal_of_isPrime _) fun h => hx (PrimeSpectrum.ext h)
  obtain ⟨a, ham, hax⟩ := IsConcreteLE.exists_of_lt hlt
  refine ⟨((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop) a, Ideal.mem_map_of_mem _ ham, ?_⟩
  have h1 : X.basicOpen (f.appTop ((Scheme.ΓSpecIso (.of A)).inv a)) =
      f ⁻¹ᵁ ((Spec (.of A)).basicOpen ((Scheme.ΓSpecIso (.of A)).inv a)) :=
    (Scheme.preimage_basicOpen_top f _).symm
  have h2 : x ∈ f ⁻¹ᵁ ((Spec (.of A)).basicOpen ((Scheme.ΓSpecIso (.of A)).inv a)) := by
    rw [basicOpen_eq_of_affine]
    exact PrimeSpectrum.mem_basicOpen a (f.base x) |>.2 hax
  rw [show ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop) a
      = f.appTop ((Scheme.ΓSpecIso (.of A)).inv a) from rfl, h1]
  exact h2

/-- **The acyclicity of `ℱ/𝔪ℱ` above the dimension of the closed fibre.** Let `A` be a
Noetherian local ring and `f : X ⟶ Spec A` a proper morphism whose fibre over the closed point
has topological Krull dimension at most `d`. Then for every sheaf of modules `ℱ` on `X` and
every `p > d`,

`Hᵖ(X, ℱ/𝔪ℱ) = 0`,

`𝔪ℱ` being the multiples of `ℱ` by the ideal `baseMaximalIdeal f` of global functions.

This is the input `hcoker` of `IdealMultiplesCohomology.lean`'s
`epi_map_rightDerived_idealMultiples`, `top_le_smul_top_rightDerived` and
`isZero_rightDerived_of_isZero_cokernel`, and it is what the proof of [Stacks, Tag 02V7] obtains
from Grothendieck vanishing on the infinitesimal neighbourhoods of the fibre.

The closed fibre is the preimage of the closed point, closed because the closed point is
(`IsLocalRing.isClosed_singleton_closedPoint`); its underlying space is Noetherian because `X`
is — proper over a Noetherian affine base, hence locally Noetherian
(`AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian`) and compact, hence a Noetherian
space, and a subspace of one is one — and it is homeomorphic to the scheme-theoretic fibre
(`AlgebraicGeometry.Scheme.Hom.fiberHomeo`), which carries the dimension bound. Off it some
element of `𝔪 · Γ(X, ⊤)` is invertible, so
`isZero_rightDerived_cokernel_idealMultiples_of_dim_le` applies. -/
theorem isZero_rightDerived_cokernel_idealMultiples_baseMaximalIdeal [IsNoetherianRing A]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) [IsProper f] (F : X.Modules) {d p : ℕ}
    (hdim : topologicalKrullDim (f.fiber (IsLocalRing.closedPoint A)) ≤ (d : WithBot ℕ∞))
    (hp : d < p) :
    IsZero (((moduleGlobalSections X).rightDerived p).obj
      (cokernel (idealMultiples X (baseMaximalIdeal f) F))) := by
  have _ : IsLocallyNoetherian X := AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian f
  have _ : CompactSpace (X : Type u) := QuasiCompact.compactSpace_of_compactSpace f
  have _ : AlgebraicGeometry.IsNoetherian X := ⟨⟩
  have hS : IsClosed (f ⁻¹' {IsLocalRing.closedPoint A}) :=
    (IsLocalRing.isClosed_singleton_closedPoint A).preimage f.base.hom.continuous
  have hdimS : topologicalKrullDim (f ⁻¹' {IsLocalRing.closedPoint A}) ≤ (d : WithBot ℕ∞) :=
    (IsHomeomorph.topologicalKrullDim_eq _
      (f.fiberHomeo (IsLocalRing.closedPoint A)).isHomeomorph) ▸ hdim
  exact isZero_rightDerived_cokernel_idealMultiples_of_dim_le X (baseMaximalIdeal f) F
    (f ⁻¹' {IsLocalRing.closedPoint A}) hS hdimS hp fun x hx =>
      exists_mem_baseMaximalIdeal_mem_basicOpen f fun h =>
        hx (Set.mem_preimage.2 (Set.mem_singleton_iff.2 h))

end LocalBase

end

end Stacks.AlgebraicGeometry.TopDegreeBaseChange

