/-! ### Generation of the first cohomology by images of a generating family -/

/-- **The legs of a colimit cocone over a discrete category span its point.** In a category of
modules, the quotient of the point by the span of the images of the legs receives the zero map
from every leg, so the projection onto it is zero by the uniqueness half of the universal
property. -/
theorem iSup_range_eq_top_of_isColimit_cofan {A : Type u} [Ring A] {I : Type u}
    {M : I → ModuleCat.{u} A} {P : ModuleCat.{u} A} (g : ∀ i, M i ⟶ P)
    (hc : IsColimit (Cofan.mk P g)) :
    (⨆ i : I, LinearMap.range (g i).hom) = ⊤ := by
  set Q : Submodule A P := ⨆ i : I, LinearMap.range (g i).hom
  let π : P ⟶ ModuleCat.of A (P ⧸ Q) := ModuleCat.ofHom Q.mkQ
  have hleg : ∀ i : I, g i ≫ π = g i ≫ 0 := by
    intro i
    rw [comp_zero]
    ext x
    change Q.mkQ ((g i).hom x) = 0
    rw [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact le_iSup (fun i : I => LinearMap.range (g i).hom) i ⟨x, rfl⟩
  have hπ : π = 0 := Cofan.IsColimit.hom_ext hc _ _ hleg
  rw [eq_top_iff]
  intro x _
  have h := congrArg (fun φ : P ⟶ ModuleCat.of A (P ⧸ Q) => φ.hom x) hπ
  change Q.mkQ x = 0 at h
  rwa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h

/-- **A surjection of quasi-coherent modules is surjective on `H¹` when `H²` vanishes.** -/
private theorem surjective_rightDerived_one_map_of_epi {X : Scheme.{u}} {F G : X.Modules}
    [F.IsQuasicoherent] [G.IsQuasicoherent] (u : F ⟶ G) (hu : Epi u)
    (h₂ : ∀ K : X.Modules, K.IsQuasicoherent →
      IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerivedPlus 2).obj K)) :
    Function.Surjective
      (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived 1).map u).hom := by
  have hS : (ShortComplex.mk (kernel.ι u) u (kernel.condition u)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ (kernelIsKernel u))
      (mono_of_isLimit_fork (c := Fork.ofι _ _) (kernelIsKernel u)) hu
  have hker : (kernel u).IsQuasicoherent :=
    (SheafOfModules.isQuasicoherent X.ringCatSheaf).prop_kernel u ‹_› ‹_›
  have h₁ : IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerivedPlus
      (((1 : ℕ) : ℤ) + 1)).obj (kernel u)) := by
    rw [show ((1 : ℕ) : ℤ) + 1 = 2 by norm_num]
    exact h₂ _ hker
  obtain ⟨-, hepi⟩ := exact_and_epi_map_rightDerived_of_isZero
    (Stacks.Cohomology.AffineBase.moduleGlobalSections X) hS 1 h₁
  exact (ModuleCat.epi_iff_surjective _).mp hepi

/-- **`H¹` of a globally generated quasi-coherent module is spanned by the images of `H¹(X, 𝒪_X)`
along the generating sections.** On a quasi-compact quasi-separated scheme whose quasi-coherent
modules have vanishing `H²`, every class in `H¹(X, ℱ)` lies in the span of the images of the maps
`H¹(X, 𝒪_X) ⟶ H¹(X, ℱ)` induced by the morphisms `𝒪_X ⟶ ℱ` of a generating family.

The generating epimorphism `⨁ 𝒪_X ⟶ ℱ` has quasi-coherent kernel, whose `H²` vanishes, so it
induces an epimorphism on `H¹`; and `H¹(X, -)` preserves coproducts ([Stacks, Tag 01FF]), so
`H¹(X, ⨁ 𝒪_X)` is spanned by the images of its summands. -/
theorem mem_iSup_range_rightDerived_one_of_generatingSections {X : Scheme.{u}}
    [CompactSpace (X : Type u)] [QuasiSeparatedSpace (X : Type u)] (F : X.Modules)
    [F.IsQuasicoherent] (σ : SheafOfModules.GeneratingSections F)
    (h₂ : ∀ G : X.Modules, G.IsQuasicoherent →
      IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerivedPlus 2).obj G))
    (z : ((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived 1).obj F) :
    z ∈ ⨆ i : σ.I, LinearMap.range
      (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived 1).map
        (F.unitHomEquiv.symm (σ.s i))).hom := by
  let H := (Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived 1
  have hsurj : Function.Surjective (H.map σ.π).hom :=
    surjective_rightDerived_one_map_of_epi σ.π σ.epi h₂
  obtain ⟨w, hw0⟩ := hsurj z
  have hpres : PreservesColimitsOfShape (Discrete σ.I) H :=
    preservesColimitsOfShape_discrete_rightDerived_moduleGlobalSections X 1 σ.I
  have hpres' : PreservesColimit
      (Discrete.functor fun _ : σ.I => SheafOfModules.unit X.ringCatSheaf) H :=
    hpres.preservesColimit
  have hcol := isColimitCofanMkObjOfIsColimit H (fun _ : σ.I => SheafOfModules.unit X.ringCatSheaf)
    (fun i => SheafOfModules.ιFree i) (SheafOfModules.isColimitFreeCofan σ.I)
  have hw : w ∈ ⨆ i : σ.I, LinearMap.range (H.map (SheafOfModules.ιFree
      (R := X.ringCatSheaf) i)).hom := by
    rw [iSup_range_eq_top_of_isColimit_cofan _ hcol]; trivial
  have hmap := Submodule.mem_map_of_mem (f := (H.map σ.π).hom) hw
  rw [Submodule.map_iSup] at hmap
  change z ∈ ⨆ i : σ.I, LinearMap.range (H.map (F.unitHomEquiv.symm (σ.s i))).hom
  rw [← hw0]
  refine (IsConcreteLE.le_iff.mp (iSup_mono fun i => ?_)) hmap
  rintro _ ⟨_, ⟨v, rfl⟩, rfl⟩
  refine ⟨v, ?_⟩
  have key : SheafOfModules.ιFree i ≫ σ.π = F.unitHomEquiv.symm (σ.s i) := by
    have h := SheafOfModules.unitHomEquiv_symm_freeHomEquiv_apply σ.π i
    have h2 : F.freeHomEquiv σ.π i = σ.s i := by simp [SheafOfModules.GeneratingSections.π]
    rw [h2] at h
    exact h.symm
  rw [← key]
  exact congrArg (fun φ => (ModuleCat.Hom.hom φ) v) (H.map_comp (SheafOfModules.ιFree i) σ.π)

/-- The leg of a morphism out of a free module. -/
theorem ιFree_freeHomEquiv_symm {X : Scheme.{u}} (M : X.Modules) {I : Type u}
    (s : I → M.sections) (i : I) :
    SheafOfModules.ιFree i ≫ M.freeHomEquiv.symm s = M.unitHomEquiv.symm (s i) := by
  have h := SheafOfModules.unitHomEquiv_symm_freeHomEquiv_apply (M.freeHomEquiv.symm s) i
  rw [Equiv.apply_symm_apply] at h
  exact h.symm

/-! ### Epimorphisms of quasi-coherent modules on an affine scheme -/

/-- **On an affine scheme a morphism of quasi-coherent modules which is surjective on global
sections is an epimorphism.** Its cokernel is quasi-coherent, the projection onto the cokernel is
surjective on global sections (`Stacks.SectionEpiAffine.surjective_app_of_isAffineOpen`) and
kills the image, so the cokernel has no global sections, hence vanishes. -/
theorem epi_of_surjective_app_top {T : Scheme.{u}} [IsAffine T] {F G : T.Modules}
    [F.IsQuasicoherent] [G.IsQuasicoherent] (g : F ⟶ G)
    (h : Function.Surjective (g.val.app (op ⊤))) : Epi g := by
  have hqc : (cokernel g).IsQuasicoherent :=
    (SheafOfModules.isQuasicoherent T.ringCatSheaf).prop_cokernel g ‹_› ‹_›
  refine Preadditive.epi_of_isZero_cokernel g ?_
  refine isZero_of_isZero_sections_of_isAffine (cokernel g) ?_
  rw [ModuleCat.isZero_iff_subsingleton]
  refine ⟨fun y y' => ?_⟩
  have hs := Stacks.SectionEpiAffine.surjective_app_of_isAffineOpen T (cokernel.π g) ⊤
    (isAffineOpen_top T)
  have hz : ∀ y : (cokernel g).val.obj (op ⊤), y = 0 := by
    intro y
    obtain ⟨x, rfl⟩ := hs y
    obtain ⟨w, rfl⟩ := h x
    exact congrArg (fun φ : F ⟶ cokernel g => (φ.val.app (op ⊤)).hom w) (cokernel.condition g)
  exact (hz y).trans (hz y').symm

/-! ### A generating family for the direct image of the structure sheaf along `Spec B ⟶ Spec R` -/

section SpecGenerators

variable {R B : Type u} [CommRing R] [CommRing B] (φ : R →+* B)

omit [CommRing R] in
/-- Multiplication by a scalar of the base ring, read on sections. -/
theorem smul_id_app_apply (A : Type u) [CommRing A] (X : Over (Spec (.of A))) (M : X.left.Modules)
    (r : A) (U : X.left.Opens) (x : Γ(M, U)) :
    letI := modulesLinear A X
    ((r • 𝟙 M).app U) x = (id (baseRingToSections A X (op U) r) : Γ(X.left, U)) • x := rfl

/-- The morphism `𝒪_{Spec R} ⟶ (Spec φ)_* 𝒪_{Spec B}` sending `1` to `b`: the canonical map
followed by the direct image of multiplication by `b`. -/
def specMulMap (b : B) :
    Scheme.unitModule (Spec (.of R)) ⟶
      (Scheme.Modules.pushforward (Spec.map (CommRingCat.ofHom φ))).obj
        (Scheme.unitModule (Spec (.of B))) :=
  letI : Linear B (Spec (.of B)).Modules := modulesLinear B (Over.mk (𝟙 (Spec (.of B))))
  Scheme.Modules.unitToPushforwardUnit (Spec.map (CommRingCat.ofHom φ)) ≫
    (Scheme.Modules.pushforward (Spec.map (CommRingCat.ofHom φ))).map
      (b • 𝟙 (Scheme.unitModule (Spec (.of B))))

/-- **`(Spec φ)_* 𝒪_{Spec B}` is generated by the global sections `b ∈ B`.** -/
def specGeneratingSections :
    SheafOfModules.GeneratingSections
      ((Scheme.Modules.pushforward (Spec.map (CommRingCat.ofHom φ))).obj
        (Scheme.unitModule (Spec (.of B)))) where
  I := B
  s b := SheafOfModules.unitHomEquiv _ (specMulMap φ b)
  epi := by
    have : ((Scheme.Modules.pushforward (Spec.map (CommRingCat.ofHom φ))).obj
        (Scheme.unitModule (Spec (.of B)))).IsQuasicoherent :=
      _root_.Stacks.Modules.isQuasicoherent_pushforward_of_isAffineHom _ _ inferInstance
    refine epi_of_surjective_app_top _ fun y => ?_
    refine ⟨(SheafOfModules.freeSection (R := (Spec (.of R)).ringCatSheaf)
      ((Scheme.ΓSpecIso (.of B)).hom y)).val (op ⊤), ?_⟩
    have key := congrArg (fun t : SheafOfModules.sections _ => t.val (op ⊤))
      (SheafOfModules.sectionsMap_freeHomEquiv_symm_freeSection
        (fun b => SheafOfModules.unitHomEquiv ((Scheme.Modules.pushforward
          (Spec.map (CommRingCat.ofHom φ))).obj (Scheme.unitModule (Spec (.of B))))
          (specMulMap φ b)) ((Scheme.ΓSpecIso (.of B)).hom y))
    refine key.trans ?_
    change ((specMulMap φ ((Scheme.ΓSpecIso (.of B)).hom y)).app ⊤)
      (1 : Γ(Spec (.of R), ⊤)) = y
    let : Linear B (Spec (.of B)).Modules := modulesLinear B (Over.mk (𝟙 (Spec (.of B))))
    change (((Scheme.ΓSpecIso (.of B)).hom y • 𝟙 (Scheme.unitModule (Spec (.of B)))).app
      ((Spec.map (CommRingCat.ofHom φ)) ⁻¹ᵁ ⊤))
      (((Scheme.Modules.unitToPushforwardUnit (Spec.map (CommRingCat.ofHom φ))).app ⊤)
        (1 : Γ(Spec (.of R), ⊤))) = y
    refine (smul_id_app_apply B (Over.mk (𝟙 (Spec (.of B)))) (Scheme.unitModule (Spec (.of B)))
      ((Scheme.ΓSpecIso (.of B)).hom y) _ _).trans ?_
    have h1 : (id (((Scheme.Modules.unitToPushforwardUnit (Spec.map (CommRingCat.ofHom φ))).app ⊤)
        (1 : Γ(Spec (.of R), ⊤))) : Γ(Spec (.of B), (Spec.map (CommRingCat.ofHom φ)) ⁻¹ᵁ ⊤)) = 1 :=
      map_one ((Spec.map (CommRingCat.ofHom φ)).app ⊤).hom
    change (id (baseRingToSections B (Over.mk (𝟙 (Spec (.of B))))
        (op ((Spec.map (CommRingCat.ofHom φ)) ⁻¹ᵁ ⊤)) ((Scheme.ΓSpecIso (.of B)).hom y)) :
          Γ(Spec (.of B), (Spec.map (CommRingCat.ofHom φ)) ⁻¹ᵁ ⊤)) *
      (id (((Scheme.Modules.unitToPushforwardUnit (Spec.map (CommRingCat.ofHom φ))).app ⊤)
        (1 : Γ(Spec (.of R), ⊤))) : Γ(Spec (.of B), (Spec.map (CommRingCat.ofHom φ)) ⁻¹ᵁ ⊤)) = y
    rw [h1, mul_one]
    simp only [id, baseRingToSections_apply]
    have h2 : (Opens.leTop ((Spec.map (CommRingCat.ofHom φ)) ⁻¹ᵁ ⊤)).op =
        𝟙 (op (⊤ : (Spec (.of B)).Opens)) := Subsingleton.elim _ _
    rw [h2]
    have h3 : ∀ x, ((Over.mk (𝟙 (Spec (CommRingCat.of B)))).left.ringCatSheaf.obj.map
        (𝟙 (op (⊤ : (Spec (.of B)).Opens)))).hom x = x := by
      intro x
      rw [CategoryTheory.Functor.map_id]
      rfl
    refine (h3 _).trans ?_
    change (Scheme.Hom.appTop (𝟙 (Spec (.of B)))).hom ((Scheme.ΓSpecIso (.of B)).inv.hom
      ((Scheme.ΓSpecIso (.of B)).hom.hom y)) = y
    simp only [Scheme.Hom.id_appTop, CommRingCat.id_apply]
    exact congrArg (fun f : Γ(Spec (.of B), ⊤) ⟶ Γ(Spec (.of B), ⊤) => f.hom y)
      (Scheme.ΓSpecIso (.of B)).hom_inv_id

/-- The morphism `𝒪_Z ⟶ g'_* 𝒪_P` sending `1` to the image of `b ∈ B`, for `P` over `Spec B`:
the canonical map followed by the direct image of multiplication by `b`. -/
def pushforwardMulMap {Z P : Scheme.{u}} (g' : P ⟶ Z) (h : P ⟶ Spec (.of B)) (b : B) :
    Scheme.unitModule Z ⟶ (Scheme.Modules.pushforward g').obj (Scheme.unitModule P) :=
  letI : Linear B P.Modules := modulesLinear B (Over.mk h)
  Scheme.Modules.unitToPushforwardUnit g' ≫
    (Scheme.Modules.pushforward g').map (b • 𝟙 (Scheme.unitModule P))

/-- **The pulled-back generators, read through affine base change.** For a cartesian square
`g' ≫ π = h ≫ Spec φ`, the morphism `𝒪_Z ⟶ g'_* 𝒪_P` obtained by pulling back `specMulMap φ b`
along `π` and composing with the base-change isomorphism of [Stacks, Tag 02KG] is the canonical
map `𝒪_Z ⟶ g'_* 𝒪_P` followed by the direct image of multiplication by `b`. -/
theorem pullback_specMulMap_baseChange {Z P : Scheme.{u}} {π : Z ⟶ Spec (.of R)} {g' : P ⟶ Z}
    {h : P ⟶ Spec (.of B)} (sq : IsPullback g' h π (Spec.map (CommRingCat.ofHom φ))) (b : B) :
    (Scheme.Modules.pullbackUnitIso π).inv ≫ (Scheme.Modules.pullback π).map (specMulMap φ b) ≫
        (AffinePushforward.baseChangeNatTrans sq.flip.w).app (Scheme.unitModule (Spec (.of B))) ≫
          (Scheme.Modules.pushforward g').map (Scheme.Modules.pullbackUnitIso h).hom =
      pushforwardMulMap g' h b := by
  let iP : Linear B P.Modules := modulesLinear B (Over.mk h)
  let iB : Linear B (Spec (.of B)).Modules := modulesLinear B (Over.mk (𝟙 (Spec (.of B))))
  let hs : Over.mk h ⟶ Over.mk (𝟙 (Spec (.of B))) := Over.homMk h (by simp)
  have hlin : (Scheme.Modules.pullback h).Linear B := over_pullback_linear B hs
  have hnat := (AffinePushforward.baseChangeNatTrans sq.flip.w).naturality
    (b • 𝟙 (Scheme.unitModule (Spec (.of B))))
  simp only [Functor.comp_map] at hnat
  have hpb : (Scheme.Modules.pullback h).map (b • 𝟙 (Scheme.unitModule (Spec (.of B)))) =
      b • 𝟙 _ := by
    rw [Functor.map_smul, CategoryTheory.Functor.map_id]
  have hcomm : (b • 𝟙 ((Scheme.Modules.pullback h).obj (Scheme.unitModule (Spec (.of B))))) ≫
      (Scheme.Modules.pullbackUnitIso h).hom =
      (Scheme.Modules.pullbackUnitIso h).hom ≫ (b • 𝟙 (Scheme.unitModule P)) := by
    rw [Linear.smul_comp, Linear.comp_smul, Category.id_comp, Category.comp_id]
  have hunit := unitToPushforwardUnit_comp_pushforwardBaseChange sq.flip.w
  rw [← FlatBaseChange.baseChangeNatTrans_app_eq_pushforwardBaseChange] at hunit
  simp only [specMulMap, pushforwardMulMap, Functor.map_comp, Category.assoc]
  rw [reassoc_of% hnat, hpb, ← Functor.map_comp, hcomm, Functor.map_comp,
    ← reassoc_of% hunit]
  simp only [Iso.inv_hom_id_assoc, ← Functor.map_comp_assoc, Iso.inv_hom_id,
    CategoryTheory.Functor.map_id, Category.id_comp]

end SpecGenerators

/-! ### Finiteness of the first cohomology after an affine base change -/

/-- Applying an isomorphism of modules and then its inverse is the identity. -/
private theorem inv_hom_apply_hom {A : Type u} [Ring A] {M N : ModuleCat.{u} A} (e : M ≅ N)
    (x : M) : e.inv.hom (e.hom.hom x) = x := by
  change (e.hom ≫ e.inv).hom x = x
  rw [e.hom_inv_id]
  rfl

/-- Applying the inverse of an isomorphism of modules and then the isomorphism is the identity. -/
private theorem hom_inv_apply_inv {A : Type u} [Ring A] {M N : ModuleCat.{u} A} (e : M ≅ N)
    (y : N) : e.hom.hom (e.inv.hom y) = y := by
  change (e.inv ≫ e.hom).hom y = y
  rw [e.inv_hom_id]
  rfl

section BaseChangeFinite

open Stacks.Cohomology.AffineBase Stacks.Cohomology.AffineComparison

variable {R B : Type u} [CommRing R] [CommRing B] (φ : R →+* B)

/-- **The generating family of `g'_* 𝒪_P` indexed by `b ∈ B`**, for a cartesian square
`g' ≫ π = h ≫ Spec φ`: the section attached to `b` is the canonical map `𝒪_Z ⟶ g'_* 𝒪_P`
followed by multiplication by `b`. It generates because it is, up to the base-change
isomorphism of [Stacks, Tag 02KG], the pullback of `specGeneratingSections`. -/
def baseChangeGeneratingSections {Z P : Scheme.{u}} {π : Z ⟶ Spec (.of R)} {g' : P ⟶ Z}
    {h : P ⟶ Spec (.of B)} (sq : IsPullback g' h π (Spec.map (CommRingCat.ofHom φ))) :
    SheafOfModules.GeneratingSections
      ((Scheme.Modules.pushforward g').obj (Scheme.unitModule P)) where
  I := B
  s b := SheafOfModules.unitHomEquiv _ (pushforwardMulMap g' h b)
  epi := by
    have : IsIso ((AffinePushforward.baseChangeNatTrans sq.flip.w).app
        (Scheme.unitModule (Spec (.of B)))) :=
      AffineBaseChangeIso.isIso_baseChangeNatTrans_of_isAffineHom sq.flip _
    have hpres : PreservesColimitsOfSize.{u, u} (Scheme.Modules.pullback π) :=
      (Scheme.Modules.pullbackPushforwardAdjunction π).leftAdjoint_preservesColimits
    have hpres1 : PreservesColimitsOfShape (Discrete B) (Scheme.Modules.pullback π) :=
      hpres.preservesColimitsOfShape
    have hpres2 : PreservesColimit (Discrete.functor fun _ : B => Scheme.unitModule (Spec (.of R)))
        (Scheme.Modules.pullback π) := hpres1.preservesColimit
    have hcol := isColimitCofanMkObjOfIsColimit (Scheme.Modules.pullback π)
      (fun _ : B => Scheme.unitModule (Spec (.of R))) (fun b => SheafOfModules.ιFree b)
      (SheafOfModules.isColimitFreeCofan B)
    let σ0 := specGeneratingSections φ
    let e := (AffinePushforward.baseChangeNatTrans sq.flip.w).app
        (Scheme.unitModule (Spec (.of B))) ≫
      (Scheme.Modules.pushforward g').map (Scheme.Modules.pullbackUnitIso h).hom
    have he : Epi e :=
      epi_comp' (IsIso.epi_of_iso _)
        (IsIso.epi_of_iso ((Scheme.Modules.pushforward g').mapIso
          (Scheme.Modules.pullbackUnitIso h)).hom)
    have hpe : (Scheme.Modules.pullback π).PreservesEpimorphisms :=
      Functor.preservesEpimorphisms_of_adjunction (Scheme.Modules.pullbackPushforwardAdjunction π)
    have hσ0 : Epi ((Scheme.Modules.pullback π).map σ0.π) :=
      @Functor.map_epi _ _ _ _ (Scheme.Modules.pullback π) hpe _ _ σ0.π σ0.epi
    have hepi : Epi ((Scheme.Modules.pullback π).map σ0.π ≫ e) := epi_comp _ _
    refine ⟨fun {T} u v huv => ?_⟩
    have hlegs : ∀ b : B, (Scheme.Modules.pullback π).map (SheafOfModules.ιFree b) ≫
        ((Scheme.Modules.pullback π).map σ0.π ≫ e ≫ u) =
        (Scheme.Modules.pullback π).map (SheafOfModules.ιFree b) ≫
        ((Scheme.Modules.pullback π).map σ0.π ≫ e ≫ v) := by
      intro b
      have hs : SheafOfModules.ιFree b ≫ σ0.π = specMulMap φ b :=
        (ιFree_freeHomEquiv_symm _ _ b).trans (Equiv.symm_apply_apply _ _)
      have hk : (Scheme.Modules.pullback π).map (SheafOfModules.ιFree b) ≫
          (Scheme.Modules.pullback π).map σ0.π ≫ e =
          (Scheme.Modules.pullbackUnitIso π).hom ≫ pushforwardMulMap g' h b := by
        rw [← pullback_specMulMap_baseChange φ sq b, Iso.hom_inv_id_assoc]
        refine Eq.trans ?_ (congrArg (fun k => (Scheme.Modules.pullback π).map k ≫ e) hs)
        refine Eq.trans ?_ (congrArg (· ≫ e)
          ((Scheme.Modules.pullback π).map_comp (SheafOfModules.ιFree b) σ0.π).symm)
        exact (Category.assoc _ _ _).symm
      have e1 : SheafOfModules.ιFree b ≫ (SheafOfModules.freeHomEquiv _).symm
          (fun b : B => SheafOfModules.unitHomEquiv _ (pushforwardMulMap g' h b)) =
          pushforwardMulMap g' h b :=
        (ιFree_freeHomEquiv_symm _ _ b).trans (Equiv.symm_apply_apply _ _)
      have hb : pushforwardMulMap g' h b ≫ u = pushforwardMulMap g' h b ≫ v := by
        have h1 := congrArg (SheafOfModules.ιFree b ≫ ·) huv
        have a1 := @Category.assoc (SheafOfModules Z.ringCatSheaf) _ _ _ _ _
          (SheafOfModules.ιFree b) ((SheafOfModules.freeHomEquiv _).symm
            (fun b : B => SheafOfModules.unitHomEquiv _ (pushforwardMulMap g' h b))) u
        have a2 := @Category.assoc (SheafOfModules Z.ringCatSheaf) _ _ _ _ _
          (SheafOfModules.ιFree b) ((SheafOfModules.freeHomEquiv _).symm
            (fun b : B => SheafOfModules.unitHomEquiv _ (pushforwardMulMap g' h b))) v
        exact (congrArg (· ≫ u) e1).symm.trans (a1.trans (h1.trans
          (a2.symm.trans (congrArg (· ≫ v) e1))))
      let A := (Scheme.Modules.pullback π).map
        (SheafOfModules.ιFree (R := (Spec (.of R)).ringCatSheaf) b)
      let Bm := (Scheme.Modules.pullback π).map σ0.π
      have x : ∀ w : (Scheme.Modules.pushforward g').obj (Scheme.unitModule P) ⟶ T,
          A ≫ (Bm ≫ (e ≫ w)) = (Scheme.Modules.pullbackUnitIso π).hom ≫
            (pushforwardMulMap g' h b ≫ w) := fun w =>
        (congrArg (A ≫ ·) (@Category.assoc (SheafOfModules Z.ringCatSheaf) _ _ _ _ _
          Bm e w).symm).trans ((@Category.assoc (SheafOfModules Z.ringCatSheaf) _ _ _ _ _
          A (Bm ≫ e) w).symm.trans ((congrArg (· ≫ w) hk).trans
          (@Category.assoc (SheafOfModules Z.ringCatSheaf) _ _ _ _ _ _ _ w)))
      exact (x u).trans ((congrArg _ hb).trans (x v).symm)
    have hfin := Cofan.IsColimit.hom_ext hcol
      ((Scheme.Modules.pullback π).map σ0.π ≫ e ≫ u)
      ((Scheme.Modules.pullback π).map σ0.π ≫ e ≫ v) fun b => hlegs b
    refine (cancel_epi ((Scheme.Modules.pullback π).map σ0.π ≫ e)).1 ?_
    exact (@Category.assoc (SheafOfModules Z.ringCatSheaf) _ _ _ _ _ _ e u).trans
      (hfin.trans (@Category.assoc (SheafOfModules Z.ringCatSheaf) _ _ _ _ _ _ e v).symm)

/-- **`H¹(X, 𝒪)` stays finite under an affine base change.** Let `g' ≫ π = h ≫ Spec φ` be a
cartesian square with `Z` quasi-compact and quasi-separated over `Spec R`, and suppose `H²`
vanishes on the quasi-coherent modules of `Z`. If `H¹(Z, 𝒪_Z)` is a finite `R`-module, then
`H¹(P, 𝒪_P)` is a finite `B`-module.

`H¹(P, 𝒪_P) = H¹(Z, g'_* 𝒪_P)` ([Stacks, Tag 089W]), and `g'_* 𝒪_P` is generated by the sections
`b ∈ B` (`baseChangeGeneratingSections`), so by
`mem_iSup_range_rightDerived_one_of_generatingSections` every class is a sum of images of
`H¹(Z, 𝒪_Z)` under multiplication by elements of `B`; the comparison of [Stacks, Tag 089W]
carries multiplication by `b` downstairs to the `B`-action upstairs
(`Stacks.Cohomology.AffineComparison.cohomologyIsoPushforward_baseSmul`). -/
theorem moduleFinite_cohomologyOne_baseChange_of_isAffine {Z P : Scheme.{u}}
    {π : Z ⟶ Spec (.of R)} {g' : P ⟶ Z} {h : P ⟶ Spec (.of B)}
    (sq : IsPullback g' h π (Spec.map (CommRingCat.ofHom φ)))
    [CompactSpace (Z : Type u)] [QuasiSeparatedSpace (Z : Type u)]
    (h₂ : ∀ G : Z.Modules, G.IsQuasicoherent →
      IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections Z).rightDerivedPlus 2).obj G))
    (hfin : Module.Finite R ((ModuleCat.restrictScalars
      ((Scheme.ΓSpecIso (.of R)).inv ≫ π.appTop).hom).obj
        (((Stacks.Cohomology.AffineBase.moduleGlobalSections Z).rightDerived 1).obj
          (SheafOfModules.unit Z.ringCatSheaf)))) :
    Module.Finite B ((ModuleCat.restrictScalars
      ((Scheme.ΓSpecIso (.of B)).inv ≫ h.appTop).hom).obj
        (((Stacks.Cohomology.AffineBase.moduleGlobalSections P).rightDerived 1).obj
          (SheafOfModules.unit P.ringCatSheaf))) := by
  let : Linear B P.Modules := modulesLinear B (Over.mk h)
  have hg' : IsAffineHom g' := MorphismProperty.of_isPullback (P := @IsAffineHom) sq.flip
    inferInstance
  let O' : P.Modules := SheafOfModules.unit P.ringCatSheaf
  have hG : ((Scheme.Modules.pushforward g').obj O').IsQuasicoherent :=
    _root_.Stacks.Modules.isQuasicoherent_pushforward_of_isAffineHom _ _ inferInstance
  let H := (Stacks.Cohomology.AffineBase.moduleGlobalSections Z).rightDerived 1
  let Θ := cohomologyIsoPushforward g' O' 1
  let c := Scheme.Modules.unitToPushforwardUnit g'
  let ρB := ((Scheme.ΓSpecIso (.of B)).inv ≫ h.appTop).hom
  let ρR := ((Scheme.ΓSpecIso (.of R)).inv ≫ π.appTop).hom
  let fz : H.obj (SheafOfModules.unit Z.ringCatSheaf) →
      (((Stacks.Cohomology.AffineBase.moduleGlobalSections P).rightDerived 1).obj O') :=
    fun x => Θ.inv.hom ((H.map c).hom x)
  -- the two actions of `R` agree
  have hring : ∀ r : R, g'.appTop.hom (ρR r) = ρB (φ r) := by
    intro r
    have h1 : π.appTop ≫ g'.appTop = (Spec.map (CommRingCat.ofHom φ)).appTop ≫ h.appTop := by
      rw [← Scheme.Hom.comp_appTop, ← Scheme.Hom.comp_appTop, sq.w]
    have h2 := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom φ)
    have h3 : (Scheme.ΓSpecIso (.of R)).inv ≫ π.appTop ≫ g'.appTop =
        CommRingCat.ofHom φ ≫ (Scheme.ΓSpecIso (.of B)).inv ≫ h.appTop := by
      rw [h1, ← Category.assoc, ← h2, Category.assoc]
    exact congrArg (fun k : CommRingCat.of R ⟶ Γ(P, ⊤) => k.hom r) h3
  have smul_fz : ∀ (t : Γ(Z, ⊤)) x, fz (t • x) = g'.appTop.hom t • fz x := by
    intro t x
    change Θ.inv.hom ((H.map c).hom (t • x)) = _
    exact (congrArg Θ.inv.hom ((H.map c).hom.map_smul t x)).trans (Θ.inv.hom.map_smul _ _)
  obtain ⟨G0, hG0⟩ := hfin.fg_top
  let MB := (ModuleCat.restrictScalars ρB).obj
    (((Stacks.Cohomology.AffineBase.moduleGlobalSections P).rightDerived 1).obj O')
  let MR := (ModuleCat.restrictScalars ρR).obj (H.obj (SheafOfModules.unit Z.ringCatSheaf))
  let fzR : MR → MB := fun x => fz x
  let Sp : Submodule B MB := Submodule.span B (fzR '' (G0 : Set MR))
  have claim1 : ∀ x : MR, fzR x ∈ Sp := by
    intro x
    have hx : x ∈ Submodule.span R (G0 : Set MR) := hG0 ▸ Submodule.mem_top (x := x)
    induction hx using Submodule.span_induction with
    | mem y hy => exact Submodule.subset_span ⟨y, hy, rfl⟩
    | zero =>
      have : fzR 0 = 0 :=
        (congrArg Θ.inv.hom ((H.map c).hom.map_zero)).trans Θ.inv.hom.map_zero
      rw [this]
      exact Sp.zero_mem
    | add y z _ _ hy hz =>
      have : fzR (y + z) = fzR y + fzR z :=
        (congrArg Θ.inv.hom ((H.map c).hom.map_add y z)).trans (Θ.inv.hom.map_add _ _)
      rw [this]
      exact Sp.add_mem hy hz
    | smul r y _ hy =>
      have : fzR (r • y) = φ r • fzR y := by
        refine (smul_fz (ρR r) y).trans ?_
        rw [hring]
        rfl
      rw [this]
      exact Sp.smul_mem _ hy
  have claim2 : ∀ z : MB, z ∈ Sp := by
    intro z
    have hmem := mem_iSup_range_rightDerived_one_of_generatingSections _
      (baseChangeGeneratingSections φ sq) h₂ (Θ.hom.hom z)
    have hz : Θ.inv.hom (Θ.hom.hom z) = z := inv_hom_apply_hom Θ z
    rw [← hz]
    refine Submodule.iSup_induction _ (motive := fun y => (Θ.inv.hom y : MB) ∈ Sp) hmem ?_ ?_ ?_
    · rintro (b : B) y ⟨x, rfl⟩
      have hbs := cohomologyIsoPushforward_baseSmul (Y := Over.mk h) g' O' 1 b (fz x)
      have hz' : Θ.hom.hom (fz x) = (H.map c).hom x := hom_inv_apply_inv Θ _
      have e0 : (((Scheme.Modules.pushforward g').obj (Scheme.unitModule P)).unitHomEquiv.symm
          ((baseChangeGeneratingSections φ sq).s b)) = pushforwardMulMap g' h b :=
        Equiv.symm_apply_apply _ _
      have key : (H.map (((Scheme.Modules.pushforward g').obj
          (Scheme.unitModule P)).unitHomEquiv.symm ((baseChangeGeneratingSections φ sq).s b))).hom x
          = Θ.hom.hom (ρB b • fz x) := by
        rw [e0]
        refine Eq.trans ?_ hbs.symm
        rw [hz']
        exact congrArg (fun k => k.hom x) (H.map_comp c
          ((Scheme.Modules.pushforward g').map (b • 𝟙 O')))
      have key2 : Θ.inv.hom ((H.map (((Scheme.Modules.pushforward g').obj
          (Scheme.unitModule P)).unitHomEquiv.symm
            ((baseChangeGeneratingSections φ sq).s b))).hom x)
          = ρB b • fz x := by
        rw [key]
        exact inv_hom_apply_hom Θ _
      change Θ.inv.hom _ ∈ Sp
      rw [key2]
      exact Sp.smul_mem b (claim1 x)
    · change (Θ.inv.hom 0 : MB) ∈ Sp
      rw [Θ.inv.hom.map_zero]
      exact Sp.zero_mem
    · intro y z hy hz
      rw [Θ.inv.hom.map_add]
      exact Sp.add_mem hy hz
  classical
  refine ⟨⟨(G0.image fzR : Finset MB), ?_⟩⟩
  rw [Finset.coe_image]
  exact eq_top_iff.mpr fun z _ => claim2 z

end BaseChangeFinite

/-! ### Passing to a closed subscheme -/

section ClosedSubscheme

open Stacks.Cohomology.AffineBase Stacks.Cohomology.AffineComparison

/-- **`H¹` of a closed subscheme is a quotient of `H¹` of the ambient scheme**, when `H²` vanishes
on the ambient scheme: for a closed immersion `k : X ⟶ P` the surjection `𝒪_P ⟶ k_* 𝒪_X` has
quasi-coherent kernel, so it is surjective on `H¹`, and `H¹(P, k_* 𝒪_X) = H¹(X, 𝒪_X)`
([Stacks, Tag 089W]). Finiteness over a ring acting through `P ⟶ Y` therefore descends. -/
theorem moduleFinite_cohomologyOne_of_isClosedImmersion {X P Y : Scheme.{u}} (k : X ⟶ P)
    [IsClosedImmersion k] (p : P ⟶ Y)
    (h₂ : ∀ G : P.Modules, G.IsQuasicoherent →
      IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections P).rightDerivedPlus 2).obj G))
    (hfin : Module.Finite Γ(Y, ⊤) ((ModuleCat.restrictScalars p.appTop.hom).obj
      (((Stacks.Cohomology.AffineBase.moduleGlobalSections P).rightDerived 1).obj
        (SheafOfModules.unit P.ringCatSheaf)))) :
    Module.Finite Γ(Y, ⊤) ((ModuleCat.restrictScalars (k ≫ p).appTop.hom).obj
      (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived 1).obj
        (SheafOfModules.unit X.ringCatSheaf))) := by
  let u := ClosedImmersionCoherentImage.unitToPushforwardUnit k
  have hu : Epi u := ClosedImmersionCoherentImage.epi_unitToPushforwardUnit k
  have hqc :
      ((Scheme.Modules.pushforward k).obj (SheafOfModules.unit X.ringCatSheaf)).IsQuasicoherent :=
    ClosedImmersionCoherentImage.isQuasicoherent_pushforward_unit k
  let H := (Stacks.Cohomology.AffineBase.moduleGlobalSections P).rightDerived 1
  have hsurj : Function.Surjective (H.map u).hom := surjective_rightDerived_one_map_of_epi u hu h₂
  let Θ := cohomologyIsoPushforward k (SheafOfModules.unit X.ringCatSheaf) 1
  let L : (ModuleCat.restrictScalars p.appTop.hom).obj (H.obj (SheafOfModules.unit P.ringCatSheaf))
      →ₗ[Γ(Y, ⊤)] (ModuleCat.restrictScalars (k ≫ p).appTop.hom).obj
        (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived 1).obj
          (SheafOfModules.unit X.ringCatSheaf)) :=
    { toFun := fun x => Θ.inv.hom ((H.map u).hom x)
      map_add' := fun x y =>
        (congrArg Θ.inv.hom ((H.map u).hom.map_add x y)).trans (Θ.inv.hom.map_add _ _)
      map_smul' := fun y x =>
        (congrArg Θ.inv.hom ((H.map u).hom.map_smul (p.appTop.hom y) x)).trans
          (Θ.inv.hom.map_smul _ _) }
  refine Module.Finite.of_surjective L fun z => ?_
  obtain ⟨x, hx⟩ := hsurj (Θ.hom.hom z)
  refine ⟨x, ?_⟩
  change Θ.inv.hom ((H.map u).hom x) = z
  rw [hx]
  exact inv_hom_apply_hom Θ z

end ClosedSubscheme

/-! ### The finite presentation case over an affine base -/

section FinitePresentation

open Stacks.Cohomology.AffineBase

/-- The ring map `Γ(S, ⊤) ⟶ Γ(W, ⊤)` read through `S ≅ Spec Γ(S, ⊤)` is `g.appTop`. -/
private theorem ΓSpecIso_inv_comp_appTop_comp_isoSpec_hom {W S : Scheme.{u}} [IsAffine S]
    (g : W ⟶ S) :
    ((Scheme.ΓSpecIso (.of Γ(S, ⊤))).inv ≫ (g ≫ S.isoSpec.hom).appTop).hom = g.appTop.hom := by
  rw [Scheme.Hom.comp_appTop, Scheme.isoSpec_hom, Scheme.toSpecΓ_appTop]
  exact congrArg CommRingCat.Hom.hom (Iso.inv_hom_id_assoc (Scheme.ΓSpecIso Γ(S, ⊤)) _)

/-- **`H¹(X, 𝒪_X)` is finite for a proper morphism of finite presentation with one-dimensional
fibres onto an affine scheme.** The morphism is the base change of a proper morphism with
one-dimensional fibres onto an affine Noetherian scheme
(`AlgebraicGeometry.exists_isProper_finitePresentation_relativeDimensionLE_baseChange_of_isAffine`,
[Stacks, Tags 01ZM, 081F, 05M5]), whose `H¹(𝒪)` is finite by [Stacks, Tag 02O6]; finiteness passes
along the affine base change (`moduleFinite_cohomologyOne_baseChange_of_isAffine`), and from the
fibre product to `X` along the isomorphism. -/
theorem moduleFinite_cohomologyOne_of_finitePresentation {X Y : Scheme.{u}} (f : X ⟶ Y)
    [IsProper f] [IsAffine Y] (hfp : FinitePresentation f)
    (hdim : ∀ y : Y, topologicalKrullDim (f.fiber y) ≤ ((1 : ℕ) : WithBot ℕ∞)) :
    Module.Finite Γ(Y, ⊤) ((ModuleCat.restrictScalars f.appTop.hom).obj
      (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived 1).obj
        (SheafOfModules.unit X.ringCatSheaf))) := by
  have : IsProper (Over.mk f).hom := ‹IsProper f›
  obtain ⟨T, q, XT, hTaff, hTN, -, -, hXTprop, hXTdim, ⟨e⟩⟩ :=
    exists_isProper_finitePresentation_relativeDimensionLE_baseChange_of_isAffine Y (Over.mk f)
      hfp 1 hdim
  have _ : IsAffine T := hTaff
  have _ : IsNoetherian T := hTN
  have _ : IsProper XT.hom := hXTprop
  have _ : CompactSpace (XT.left : Type u) := QuasiCompact.compactSpace_of_compactSpace XT.hom
  have _ : QuasiSeparatedSpace (XT.left : Type u) := quasiSeparatedSpace_of_quasiSeparated XT.hom
  let k : X ⟶ pullback XT.hom q := e.hom.left
  have hk : k ≫ pullback.snd XT.hom q = f := Over.w e.hom
  have _ : IsIso k := inferInstanceAs (IsIso ((Over.forget _).map e.hom))
  -- the square of spectra
  have sq0 := IsPullback.of_hasPullback XT.hom q
  have sq : IsPullback (pullback.fst XT.hom q) (pullback.snd XT.hom q ≫ Y.isoSpec.hom)
      (XT.hom ≫ T.isoSpec.hom) (Spec.map (CommRingCat.ofHom q.appTop.hom)) :=
    sq0.of_iso (Iso.refl _) (Iso.refl _) Y.isoSpec T.isoSpec (by simp) (by simp) (by simp)
      (by rw [CommRingCat.ofHom_hom, Scheme.isoSpec_hom_naturality])
  -- finiteness on the Noetherian model
  have hfinT := TopDegreeFiniteType.moduleFinite_cohomology_of_isFiniteType_rightDerived
    XT.hom (SheafOfModules.unit XT.left.ringCatSheaf) 1
    (TopDegreeFiniteType.isFiniteType_rightDerived_of_isProper_of_isLocallyNoetherian
      XT.hom (SheafOfModules.unit XT.left.ringCatSheaf) 1)
  have h₂T : ∀ G : XT.left.Modules, G.IsQuasicoherent →
      IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections
        XT.left).rightDerivedPlus 2).obj G) :=
    fun G hG => cohomologyVanishesAboveOne XT.hom inferInstance inferInstance hXTdim 2
      (by norm_num) G hG
  have hP := moduleFinite_cohomologyOne_baseChange_of_isAffine q.appTop.hom sq h₂T
    (by rwa [ΓSpecIso_inv_comp_appTop_comp_isoSpec_hom])
  rw [ΓSpecIso_inv_comp_appTop_comp_isoSpec_hom] at hP
  -- from the fibre product to `X`
  have _ : IsProper (pullback.snd XT.hom q) :=
    MorphismProperty.of_isPullback (P := @IsProper) sq0 inferInstance
  have hdimP : ∀ y : Y, topologicalKrullDim ((pullback.snd XT.hom q).fiber y) ≤
      ((1 : ℕ) : WithBot ℕ∞) := fun y =>
    topologicalKrullDim_fiber_le_of_isPullback sq0 1 y (hXTdim _)
  have h₂P : ∀ G : (pullback XT.hom q).Modules, G.IsQuasicoherent →
      IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections
        (pullback XT.hom q)).rightDerivedPlus 2).obj G) :=
    fun G hG => cohomologyVanishesAboveOne (pullback.snd XT.hom q) inferInstance inferInstance
      hdimP 2 (by norm_num) G hG
  have := moduleFinite_cohomologyOne_of_isClosedImmersion k (pullback.snd XT.hom q) h₂P hP
  rwa [hk] at this

end FinitePresentation

/-! ### The finite-type clause of Tag 0EX4 for `R¹ f_* 𝒪_X` -/

section Main

/-- **`H¹(X, 𝒪_X)` is finite for a proper morphism with one-dimensional fibres onto an affine
scheme.** `f` factors as a closed immersion into a proper morphism of finite presentation with
one-dimensional fibres (`AlgebraicGeometry.exists_isClosedImmersion_isProper_finitePresentation`
and `exists_finitePresentation_closedImmersion_of_forall_topologicalKrullDim_fiber_le`,
[Stacks, Tags 09ZR, 05M6]); the finitely presented case is
`moduleFinite_cohomologyOne_of_finitePresentation`, and `H¹` of the closed subscheme is a quotient
(`moduleFinite_cohomologyOne_of_isClosedImmersion`), the obstruction `H²` vanishing by
[Stacks, Tag 0E7D]. -/
theorem moduleFinite_cohomologyOne_of_isAffine {X Y : Scheme.{u}} (f : X ⟶ Y)
    [IsProper f] [IsAffine Y]
    (hdim : ∀ y : Y, topologicalKrullDim (f.fiber y) ≤ ((1 : ℕ) : WithBot ℕ∞)) :
    Module.Finite Γ(Y, ⊤) ((ModuleCat.restrictScalars f.appTop.hom).obj
      (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived 1).obj
        (SheafOfModules.unit X.ringCatSheaf))) := by
  obtain ⟨W, h, ι, hιcl, hfac, hprop, hfpres⟩ :=
    _root_.AlgebraicGeometry.exists_isClosedImmersion_isProper_finitePresentation f
  have _ : IsClosedImmersion ι := hιcl
  have _ : IsProper h := hprop
  have hdim' : ∀ s : Y, topologicalKrullDim ((ι ≫ h).fiber s) ≤ ((1 : ℕ) : WithBot ℕ∞) := by
    rw [hfac]
    exact hdim
  obtain ⟨Z, j, k, hjcl, hkcl, hιk, hjfp, hZdim⟩ :=
    exists_finitePresentation_closedImmersion_of_forall_topologicalKrullDim_fiber_le
      h hfpres ι 1 hdim'
