open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open Stacks.Cohomology.AffineBase

universe u

namespace Stacks.AlgebraicGeometry.TopDegreeBaseChange

attribute [local instance] HasDerivedCategory.standard

noncomputable section

/-! ### Substrate

Pullback commutes with restriction to an open of the target, and global generation survives the
passage from the base to the preimage of an affine open. Nothing here mentions
[Stacks, Tag 0E7H]. -/

/-- An isomorphism followed by an epimorphism is an epimorphism, with both data explicit.

The hypothesis is explicit because the two spellings of the category of modules on a scheme are
not interchangeable by instance search; see the implementation notes. -/
theorem epi_iso_hom_comp {C : Type*} [Category C] {A B D : C} (e : A ≅ B) {p : B ⟶ D}
    (hp : Epi p) : Epi (e.hom ≫ p) := by
  have := hp
  infer_instance

/-- **Pullback commutes with restriction to an open of the target**, for a morphism of schemes:
`(f ∣_ V)^*(𝒢|_V) ≅ (f^*𝒢)|_{f⁻¹(V)}`.

Restriction along an open immersion is pullback along it
(`AlgebraicGeometry.Scheme.Modules.restrictFunctorIsoPullback`), pullback is pseudofunctorial
(`AlgebraicGeometry.Scheme.Modules.pullbackComp`), and the restriction square commutes on the
nose: `AlgebraicGeometry.morphismRestrict_ι` says `f ∣_ V ≫ V.ι = (f ⁻¹ᵁ V).ι ≫ f`, so the two
pullbacks along the composite are the *same* functor and no coherence datum is needed. -/
def pullbackRestrictComparison {X Y : Scheme.{u}} (f : X ⟶ Y) (V : Y.Opens) (G : Y.Modules) :
    (Scheme.Modules.pullback (f ∣_ V)).obj ((Scheme.Modules.restrictFunctor V.ι).obj G) ≅
      (Scheme.Modules.restrictFunctor (f ⁻¹ᵁ V).ι).obj ((Scheme.Modules.pullback f).obj G) := by
  refine (Scheme.Modules.pullback (f ∣_ V)).mapIso
      ((Scheme.Modules.restrictFunctorIsoPullback V.ι).app G) ≪≫ ?_
  refine (Scheme.Modules.pullbackComp (f ∣_ V) V.ι).app G ≪≫ ?_
  rw [morphismRestrict_ι]
  exact ((Scheme.Modules.pullbackComp (f ⁻¹ᵁ V).ι f).app G).symm ≪≫
    ((Scheme.Modules.restrictFunctorIsoPullback (f ⁻¹ᵁ V).ι).app _).symm

/-- **A quotient of a pullback is globally generated over the preimage of an affine open.** If
`𝒢` is quasi-coherent on `Y`, `V ⊆ Y` is an affine open and `f^*𝒢 ⟶ ℱ` is surjective, then
`ℱ|_{f⁻¹(V)}` is generated by global sections.

This is the sentence *"Since `Y` is affine, the quasi-coherent module `𝒢` is globally generated,
and hence so is `f^*𝒢` and `ℱ`"* in the proof of [Stacks, Tag 0E7H], applied over `V`: the
restriction `𝒢|_V` is quasi-coherent on an affine scheme, hence globally generated
(`AlgebraicGeometry.generatingSectionsOfIsAffine`); pullback along `f ∣_ V` preserves colimits
and carries `𝒪_V` to `𝒪_{f⁻¹(V)}`, so it preserves global generation
(`AlgebraicGeometry.generatingSectionsMap`); and `pullbackRestrictComparison` identifies the
result with `(f^*𝒢)|_{f⁻¹(V)}`, which surjects onto `ℱ|_{f⁻¹(V)}`. -/
def generatingSectionsRestrictPreimage {X Y : Scheme.{u}} (f : X ⟶ Y) (V : Y.Opens)
    [IsAffine V.toScheme] (G : Y.Modules) [G.IsQuasicoherent] (F : X.Modules)
    (p : (Scheme.Modules.pullback f).obj G ⟶ F) (hp : Epi p) :
    SheafOfModules.GeneratingSections ((Scheme.Modules.restrictFunctor (f ⁻¹ᵁ V).ι).obj F) :=
  have hpres : PreservesColimitsOfSize.{u, u} (Scheme.Modules.pullback (f ∣_ V)) := inferInstance
  AlgebraicGeometry.generatingSectionsOfEpi
    (AlgebraicGeometry.generatingSectionsMap
      (AlgebraicGeometry.generatingSectionsOfIsAffine
        ((Scheme.Modules.restrictFunctor V.ι).obj G))
      (Scheme.Modules.pullback (f ∣_ V)) hpres
      (Scheme.Modules.pullbackUnitIso (f ∣_ V)).symm)
    ((pullbackRestrictComparison f V G).hom ≫
      (Scheme.Modules.restrictFunctor (f ⁻¹ᵁ V).ι).map p)
    (epi_iso_hom_comp _ (@Functor.PreservesEpimorphisms.preserves _ _ _ _
      (Scheme.Modules.restrictFunctor (f ⁻¹ᵁ V).ι) inferInstance _ _ p hp))

/-! ### The two hypotheses of Tag 0E7G, quantified over all morphisms -/

/-- **The finite-type clause of [Stacks, Tag 0EX4] at degree one for the structure sheaf**, as a
statement about every proper morphism all of whose fibres have dimension at most one.

This is the hypothesis `hft` of
`exists_isOpen_isZero_restrict_firstDirectImage_of_isZero_cohomologyOne_fiber`
([Stacks, Tag 0E7G]), universally quantified. Only the quasi-coherence clause of
[Stacks, Tag 0EX4] is formalized in this development; the finite-type clause is available for
`d ≥ 1` only granted a further hypothesis, see
`StacksFrontier/AlgebraicGeometry/TopDegreeFiniteType/`. -/
abbrev FirstDirectImageFiniteTypeOfFibreDimensionOne : Prop :=
  ∀ {X₀ Y₀ : Scheme.{u}} (g : X₀ ⟶ Y₀), IsProper g →
    (∀ s : Y₀, topologicalKrullDim (g.fiber s) ≤ ((1 : ℕ) : WithBot ℕ∞)) →
      (firstDirectImageStructureSheaf g).IsFiniteType

/-- **The base-change clause [Stacks, Tag 0EX3] (b) for the structure sheaf in degree one**, as a
statement about every proper morphism all of whose fibres have dimension at most one.

This is the hypothesis `hbc` of
`exists_isOpen_isZero_restrict_firstDirectImage_of_isZero_cohomologyOne_fiber`
([Stacks, Tag 0E7G]), universally quantified. Of [Stacks, Tag 0EX3] only conclusion (a) is
formalized in this development, in
`StacksFrontier/AlgebraicGeometry/TopDegreeBaseChange/BaseChangeVanishing.lean`. -/
abbrev FirstDirectImageCommutesBaseChangeOfFibreDimensionOne : Type (u + 1) :=
  ∀ {X₀ Y₀ : Scheme.{u}} (g : X₀ ⟶ Y₀), IsProper g →
    (∀ s : Y₀, topologicalKrullDim (g.fiber s) ≤ ((1 : ℕ) : WithBot ℕ∞)) →
      FirstDirectImageCommutesBaseChange g

/-! ### `R¹ f_* 𝒪_X = 0`, the input clause (4) may not take from itself -/

/-- **`R¹ f_* 𝒪_X = 0` for a proper morphism with one-dimensional fibres whose fibres have
vanishing first cohomology.** This is [Stacks, Tag 0E7G] globalised: that tag produces, for each
`y`, an open neighbourhood on which `R¹ f_* 𝒪_X` restricts to zero, and a sheaf of modules all
of whose stalks vanish is a zero object.

It is this statement, and not clause (4) applied to `𝒪_X`, that gives the vanishing
`H¹(X, 𝒪_X) = 0` which the last paragraph of the proof of [Stacks, Tag 0E7H] uses. -/
theorem isZero_firstDirectImageStructureSheaf
    (hft : FirstDirectImageFiniteTypeOfFibreDimensionOne.{u})
    (hbc : FirstDirectImageCommutesBaseChangeOfFibreDimensionOne.{u})
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsProper f]
    (hdim : ∀ y : Y, topologicalKrullDim (f.fiber y) ≤ ((1 : ℕ) : WithBot ℕ∞))
    (hfib : ∀ y : Y, IsZero (firstCohomologyStructureSheaf (f.fiber y))) :
    IsZero (firstDirectImageStructureSheaf f) := by
  refine AlgebraicGeometry.isZero_of_forall_isZero_stalk _ fun y => ?_
  obtain ⟨V, hyV, hV, -⟩ :=
    exists_isOpen_isZero_restrict_firstDirectImage_of_isZero_cohomologyOne_fiber f y (hdim y)
      (hft f ‹IsProper f› hdim) (hbc f ‹IsProper f› hdim) (hfib y)
  exact SchemeHigherDirectImage.isZero_stalk_of_isZero_restrict V _ y hyV hV

end

end Stacks.AlgebraicGeometry.TopDegreeBaseChange

