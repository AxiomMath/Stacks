/-! ### Nakayama's lemma at every maximal ideal -/

/-- **Nakayama's lemma across a ring map, run at every maximal ideal.** Let `φ : A →+* R`, let
`M` be an `R`-module which is also an `A`-module by restriction along `φ`, and suppose `M` is
finite over `A`. If for every maximal ideal `𝔪` of `A` the module `M` is its own multiple by the
`R`-ideal generated by the image of `𝔪`, then every element of `M` is zero.

The `A`-submodule `𝔪 · M` is an `R`-submodule (`exists_submodule_mem_iff_mem_smul_top`) which
absorbs `Ideal.map φ 𝔪` (`smul_mem_of_mem_map`), so the hypothesis gives `M = 𝔪 · M` over `A`
for every maximal `𝔪`. The determinant trick
(`Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul`) then produces `r` with
`r - 1 ∈ 𝔪` and `r · M = 0`; such an `r` is not in `𝔪`, since otherwise `1 ∈ 𝔪`. So the
annihilator of `M` lies in no maximal ideal, hence is the unit ideal.

This is `eq_zero_of_top_le_smul_map_maximalIdeal` with the local hypothesis on `A` removed and
the hypothesis asked at every maximal ideal instead of at the unique one. -/
theorem eq_zero_of_forall_isMaximal_top_le_smul_map {A : Type u} [CommRing A] {R : Type u}
    [CommRing R] (φ : A →+* R) {M : Type u} [AddCommGroup M] [Module R M] [Module A M]
    [Module.Finite A M] (hcompat : ∀ (a : A) (x : M), a • x = φ a • x)
    (hle : ∀ 𝔪 : Ideal A, 𝔪.IsMaximal →
      (⊤ : Submodule R M) ≤ Ideal.map φ 𝔪 • (⊤ : Submodule R M)) (x : M) :
    x = 0 := by
  have hbase : ∀ 𝔪 : Ideal A, 𝔪.IsMaximal →
      (⊤ : Submodule A M) ≤ 𝔪 • (⊤ : Submodule A M) := by
    intro 𝔪 h𝔪
    obtain ⟨N, hNmem⟩ := exists_submodule_mem_iff_mem_smul_top φ hcompat 𝔪
    have hN : ∀ a ∈ 𝔪, ∀ y : M, a • y ∈ N := fun a ha y =>
      (hNmem _).2 (Submodule.smul_mem_smul ha Submodule.mem_top)
    have hIN : Ideal.map φ 𝔪 • (⊤ : Submodule R M) ≤ N :=
      Submodule.smul_le.2 fun r hr n _ => smul_mem_of_mem_map φ hcompat 𝔪 N hN r hr n
    exact fun y _ => (hNmem y).1 (hIN (hle 𝔪 h𝔪 (Submodule.mem_top (x := y))))
  have hann : Module.annihilator A M = ⊤ := by
    by_contra hne
    obtain ⟨𝔪, h𝔪, hsub⟩ := Ideal.exists_le_maximal _ hne
    obtain ⟨r, hr1, hr2⟩ :=
      Submodule.exists_sub_one_mem_and_smul_eq_zero_of_fg_of_le_smul 𝔪 (⊤ : Submodule A M)
        Module.Finite.fg_top (hbase 𝔪 h𝔪)
    have hone : (1 : A) ∈ 𝔪 := by
      simpa using 𝔪.sub_mem (hsub (Module.mem_annihilator.2 fun n => hr2 n Submodule.mem_top)) hr1
    exact h𝔪.ne_top (Ideal.eq_top_of_isUnit_mem _ hone isUnit_one)
  have hone : (1 : A) ∈ Module.annihilator A M := by simp [hann]
  simpa using Module.mem_annihilator.1 hone x

/-! ### The multiples by an ideal of the base ring -/

section RingBase

variable {A : Type u} [CommRing A]

/-- **The ideal of global functions generated by an ideal of the base ring.** For
`f : X ⟶ Spec A` and `𝔞` an ideal of `A`, this is `𝔞 · Γ(X, ⊤)`, the image ideal of `𝔞` under
the structure map on global functions. -/
def baseIdeal {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) (𝔞 : Ideal A) : Ideal ↥Γ(X, ⊤) :=
  Ideal.map ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom 𝔞

/-- For a local base ring, `baseIdeal` at the maximal ideal is `baseMaximalIdeal`. -/
theorem baseIdeal_maximalIdeal [IsLocalRing A] {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) :
    baseIdeal f (IsLocalRing.maximalIdeal A) = baseMaximalIdeal f := rfl

/-- The dimension of the preimage of a point equals that of the scheme-theoretic fibre. -/
private theorem topologicalKrullDim_preimage_singleton_eq {X Y : Scheme.{u}} (g : X ⟶ Y) (y : Y) :
    topologicalKrullDim ((g : X → Y) ⁻¹' {y}) = topologicalKrullDim (g.fiber y) :=
  (IsHomeomorph.topologicalKrullDim_eq _ (g.fiberHomeo y).isHomeomorph).symm

/-- **Off the fibre over a maximal ideal some element of `𝔪 · Γ(X, ⊤)` is invertible.** If `x`
does not lie over the point `𝔪` then the prime `f(x)` does not contain `𝔪`, because a prime
containing a maximal ideal is that ideal; so some `a ∈ 𝔪` is outside it, and the image of such
an `a` is invertible at `x`, the preimage of the basic open of `a` being the basic open of its
image (`AlgebraicGeometry.Scheme.preimage_basicOpen_top`). -/
theorem exists_mem_baseIdeal_mem_basicOpen {X : Scheme.{u}} (f : X ⟶ Spec (.of A))
    {𝔪 : Ideal A} (h𝔪 : 𝔪.IsMaximal) {x : (X : Type u)}
    (hx : f.base x ≠ (⟨𝔪, h𝔪.isPrime⟩ : PrimeSpectrum A)) :
    ∃ a ∈ baseIdeal f 𝔪, x ∈ X.basicOpen a := by
  have hnle : ¬ 𝔪 ≤ (f.base x).asIdeal := fun hle =>
    hx (PrimeSpectrum.ext (h𝔪.eq_of_le (f.base x).isPrime.ne_top hle).symm)
  obtain ⟨a, ham, hax⟩ := IsConcreteLE.not_le_iff_exists.1 hnle
  refine ⟨((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop) a, Ideal.mem_map_of_mem _ ham, ?_⟩
  rw [show ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop) a
      = f.appTop ((Scheme.ΓSpecIso (.of A)).inv a) from rfl,
    ← Scheme.preimage_basicOpen_top, basicOpen_eq_of_affine]
  exact (PrimeSpectrum.mem_basicOpen a (f.base x)).2 hax

/-- **The acyclicity of `ℱ/𝔪ℱ` above the dimension of the fibre over `𝔪`.** Let `A` be a
Noetherian ring, `f : X ⟶ Spec A` proper and `𝔪` a maximal ideal whose fibre has topological
Krull dimension at most `d`. Then `Hᵖ(X, ℱ/𝔪ℱ) = 0` for every sheaf of modules `ℱ` on `X` and
every `p > d`.

The fibre is the preimage of the point `𝔪`, which is closed because `𝔪` is maximal
(`PrimeSpectrum.isClosed_singleton_iff_isMaximal`); its space is Noetherian because `X` is, and
it is homeomorphic to the scheme-theoretic fibre, which carries the dimension bound. Off it some
element of `baseIdeal f 𝔪` is invertible, so
`isZero_rightDerived_cokernel_idealMultiples_of_dim_le` applies.

This is `isZero_rightDerived_cokernel_idealMultiples_baseMaximalIdeal` with the local hypothesis
on `A` replaced by maximality of `𝔪`. -/
theorem isZero_rightDerived_cokernel_idealMultiples_baseIdeal [IsNoetherianRing A]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) [IsProper f] (F : X.Modules) {𝔪 : Ideal A}
    (h𝔪 : 𝔪.IsMaximal) {d p : ℕ}
    (hdim : topologicalKrullDim (f.fiber (⟨𝔪, h𝔪.isPrime⟩ : PrimeSpectrum A)) ≤
      (d : WithBot ℕ∞))
    (hp : d < p) :
    IsZero (((moduleGlobalSections X).rightDerived p).obj
      (cokernel (idealMultiples X (baseIdeal f 𝔪) F))) := by
  have _ : IsLocallyNoetherian X := AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian f
  have _ : CompactSpace (X : Type u) := QuasiCompact.compactSpace_of_compactSpace f
  have _ : AlgebraicGeometry.IsNoetherian X := ⟨⟩
  have hS : IsClosed (f ⁻¹' {(⟨𝔪, h𝔪.isPrime⟩ : PrimeSpectrum A)}) :=
    ((PrimeSpectrum.isClosed_singleton_iff_isMaximal
      (⟨𝔪, h𝔪.isPrime⟩ : PrimeSpectrum A)).2 h𝔪).preimage f.base.hom.continuous
  have hdimS : topologicalKrullDim (f ⁻¹' {(⟨𝔪, h𝔪.isPrime⟩ : PrimeSpectrum A)}) ≤
      (d : WithBot ℕ∞) :=
    (topologicalKrullDim_preimage_singleton_eq f _).trans_le hdim
  exact isZero_rightDerived_cokernel_idealMultiples_of_dim_le X (baseIdeal f 𝔪) F
    (f ⁻¹' {(⟨𝔪, h𝔪.isPrime⟩ : PrimeSpectrum A)}) hS hdimS hp fun x hx =>
      exists_mem_baseIdeal_mem_basicOpen f h𝔪 fun h =>
        hx (Set.mem_preimage.2 (Set.mem_singleton_iff.2 h))

/-- **`Hᵖ(X, ℱ) = 0` from the acyclicity of `ℱ/𝔪ℱ` at every maximal ideal of the base ring.**
This is `isZero_rightDerived_of_isZero_cokernel_baseRing` with the local hypothesis on `A`
dropped: the two side conditions of the Nakayama step are asked at every maximal ideal, and
`eq_zero_of_forall_isMaximal_top_le_smul_map` concludes from all of them together. -/
theorem isZero_rightDerived_of_forall_isMaximal_isZero_cokernel {X : Scheme.{u}}
    [CompactSpace (X : Type u)] [QuasiSeparatedSpace (X : Type u)] (f : X ⟶ Spec (.of A))
    (F : X.Modules) (p : ℕ)
    (hfin : Module.Finite A ↥((ModuleCat.restrictScalars
        ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom).obj
      (((moduleGlobalSections X).rightDerived p).obj F)))
    (hcoker : ∀ 𝔪 : Ideal A, 𝔪.IsMaximal →
      IsZero (((moduleGlobalSections X).rightDerived p).obj
        (cokernel (idealMultiples X (baseIdeal f 𝔪) F))))
    (hker : ∀ 𝔪 : Ideal A, 𝔪.IsMaximal →
      IsZero (((moduleGlobalSections X).rightDerived (p + 1)).obj
        (kernel (Abelian.factorThruImage (idealMultiples X (baseIdeal f 𝔪) F))))) :
    IsZero (((moduleGlobalSections X).rightDerived p).obj F) := by
  set φ : A →+* ↥Γ(X, ⊤) := ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom
  set H := ((moduleGlobalSections X).rightDerived p).obj F
  let : Module A ↥H := ((ModuleCat.restrictScalars φ).obj H).isModule
  have : Module.Finite A ↥H := hfin
  have hle : ∀ 𝔪 : Ideal A, 𝔪.IsMaximal →
      (⊤ : Submodule ↥Γ(X, ⊤) ↥H) ≤ Ideal.map φ 𝔪 • (⊤ : Submodule ↥Γ(X, ⊤) ↥H) :=
    fun 𝔪 h𝔪 => top_le_smul_top_rightDerived X (baseIdeal f 𝔪) F p (hcoker 𝔪 h𝔪) (hker 𝔪 h𝔪)
  exact ModuleCat.isZero_iff_subsingleton.mpr <| subsingleton_of_forall_eq 0 <|
    eq_zero_of_forall_isMaximal_top_le_smul_map φ (fun _ _ => rfl) hle

/-! ### The vanishing -/

variable [IsNoetherianRing A]

/-- **The cohomology of a quasi-coherent module vanishes above the dimension of the fibres.** Let
`A` be a Noetherian ring, let `f : X ⟶ Spec A` be proper and suppose every fibre of `f` has
topological Krull dimension at most `d`. Then `Hᵖ(X, ℱ) = 0` for every `p > d` and every
quasi-coherent `ℱ`.

This is `isZero_rightDerived_of_closedFibre_dim_le` with the local hypothesis on `A` traded for
the bound at every fibre; the proof is the same descending induction on the degree, with the
Nakayama step run at every maximal ideal of `A` at once.
`AlgebraicGeometry.exists_isZero_rightDerived_moduleGlobalSections_of_isProper` supplies a degree
`N` above which there is nothing to prove, and the step from `p + 1` to `p` is: restrict to the
coherent modules by `isZero_rightDerived_of_forall_isCoherent`; for a coherent `𝒢` and each
maximal `𝔪` the acyclicity of `𝒢/𝔪𝒢` in degree `p` is
`isZero_rightDerived_cokernel_idealMultiples_baseIdeal`, the vanishing of `Hᵖ⁺¹` on the auxiliary
kernel is the inductive hypothesis at the quasi-coherent module
`isQuasicoherent_kernel_factorThruImage_idealMultiples` produces, the finiteness of `Hᵖ(X, 𝒢)`
over `A` is [Stacks, Tag 02O6], and `isZero_rightDerived_of_forall_isMaximal_isZero_cokernel`
concludes. -/
@[ega "III 4.2.2" "special case", sga "6 XII 4.4" "partial"]
theorem isZero_rightDerived_of_forall_fiber_dim_le {X : Scheme.{u}} (f : X ⟶ Spec (.of A))
    [IsProper f] {d : ℕ}
    (hdim : ∀ s : Spec (.of A), topologicalKrullDim (f.fiber s) ≤ (d : WithBot ℕ∞))
    (p : ℕ) (hp : d < p) (F : X.Modules) (hF : F.IsQuasicoherent) :
    IsZero (((moduleGlobalSections X).rightDerived p).obj F) := by
  have : IsLocallyNoetherian X := AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian f
  have : CompactSpace (X : Type u) := QuasiCompact.compactSpace_of_compactSpace f
  have : QuasiSeparatedSpace (X : Type u) := quasiSeparatedSpace_of_quasiSeparated f
  have : IsLocallyNoetherian (Spec (.of A)) :=
    isLocallyNoetherian_Spec.2 ‹IsNoetherianRing A›
  have hsurj : Function.Surjective (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom :=
    (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of A)).inv).2
  obtain ⟨N, hN⟩ :=
    AlgebraicGeometry.exists_isZero_rightDerived_moduleGlobalSections_of_isProper A f
  have key : ∀ k q : ℕ, N ≤ q + k → d < q → ∀ G : X.Modules, G.IsQuasicoherent →
      IsZero (((moduleGlobalSections X).rightDerived q).obj G) := by
    intro k
    induction k with
    | zero => exact fun q hq _ G hG => hN G hG q (by omega)
    | succ k ih =>
      intro q hq hdq G hG
      refine isZero_rightDerived_of_forall_isCoherent X q G fun Gc hGc => ?_
      have : Gc.IsQuasicoherent := _root_.isQuasicoherent_of_isCoherent Gc
      have hfin : Module.Finite A ↥((ModuleCat.restrictScalars
          ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom).obj
          (((moduleGlobalSections X).rightDerived q).obj Gc)) :=
        have _ := AlgebraicGeometry.ProperCoherenceWitness.moduleFinite_cohomology f Gc q
        Stacks.AlgebraicGeometry.ProperCohomologyFinite.moduleFinite_compHom_of_surjective
          (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom hsurj
          ((ModuleCat.restrictScalars f.appTop.hom).obj
            (((moduleGlobalSections X).rightDerived q).obj Gc))
      exact isZero_rightDerived_of_forall_isMaximal_isZero_cokernel f Gc q hfin
        (fun 𝔪 h𝔪 => isZero_rightDerived_cokernel_idealMultiples_baseIdeal f Gc h𝔪
          (hdim _) hdq)
        (fun 𝔪 _ => ih (q + 1) (by omega) (by omega)
          (kernel (Abelian.factorThruImage (idealMultiples X (baseIdeal f 𝔪) Gc)))
          (isQuasicoherent_kernel_factorThruImage_idealMultiples X (baseIdeal f 𝔪) Gc))
  exact key N p (by omega) hp F hF

/-- **The same vanishing in the `ℤ`-indexed spelling**, which is the indexing the statements of
`StacksFrontier/AlgebraicGeometry/TopDegreeBaseChange/` are written in. -/
theorem isZero_rightDerivedPlus_of_forall_fiber_dim_le {X : Scheme.{u}} (f : X ⟶ Spec (.of A))
    [IsProper f] {d : ℕ}
    (hdim : ∀ s : Spec (.of A), topologicalKrullDim (f.fiber s) ≤ (d : WithBot ℕ∞))
    (i : ℤ) (hi : (d : ℤ) < i) (F : X.Modules) (hF : F.IsQuasicoherent) :
    IsZero (((moduleGlobalSections X).rightDerivedPlus i).obj F) := by
  obtain ⟨q, rfl⟩ := Int.eq_ofNat_of_zero_le (show (0 : ℤ) ≤ i by omega)
  exact (Stacks.DerivedIndexing.isZero_rightDerivedPlus_obj_iff (moduleGlobalSections X)
    (rfl : ((q : ℕ) : ℤ) = (q : ℕ)) F).2
    (isZero_rightDerived_of_forall_fiber_dim_le f hdim q (by omega) F hF)

end RingBase

/-! ### Over an abstract affine base -/

/-- **The fibre bound transports along `AlgebraicGeometry.Scheme.isoSpec`.** For `Y` affine, the
fibres of `g ≫ Y.isoSpec.hom` are the fibres of `g`: the isomorphism is a homeomorphism on
points, so the preimage of a point of `Spec Γ(Y, ⊤)` is the preimage of the corresponding point
of `Y`, and `AlgebraicGeometry.Scheme.Hom.fiberHomeo` identifies each preimage with the
scheme-theoretic fibre. -/
theorem topologicalKrullDim_fiber_comp_isoSpec_le {X Y : Scheme.{u}} [IsAffine Y] (g : X ⟶ Y)
    {d : ℕ} (hdim : ∀ y : Y, topologicalKrullDim (g.fiber y) ≤ (d : WithBot ℕ∞))
    (s : Spec (.of (Γ(Y, ⊤) : Type u))) :
    topologicalKrullDim ((g ≫ Y.isoSpec.hom).fiber s) ≤ (d : WithBot ℕ∞) := by
  obtain ⟨y, hy⟩ : ∃ y : (Y : Type u), Y.isoSpec.hom y = s :=
    ⟨(Scheme.homeoOfIso Y.isoSpec).symm s, (Scheme.homeoOfIso Y.isoSpec).apply_symm_apply s⟩
  have hset : (g ≫ Y.isoSpec.hom) ⁻¹' {s} = (g : X → Y) ⁻¹' {y} := by
    ext x
    simp only [Set.mem_preimage, Set.mem_singleton_iff, Scheme.Hom.comp_apply]
    exact ⟨fun h => (Scheme.homeoOfIso Y.isoSpec).injective (h.trans hy.symm),
      fun h => by rw [h, hy]⟩
  rw [← topologicalKrullDim_preimage_singleton_eq, hset, topologicalKrullDim_preimage_singleton_eq]
  exact hdim y

/-- **The vanishing over an abstract affine locally Noetherian base.** For `g : X₀ ⟶ Y₀` proper
onto an affine locally Noetherian scheme all of whose fibres have dimension at most `d`, and `F`
quasi-coherent, `Hⁱ(X₀, F) = 0` for every `i > d`.

This is `isZero_rightDerivedPlus_of_forall_fiber_dim_le` read through
`AlgebraicGeometry.Scheme.isoSpec`: the cohomology `Hⁱ(X₀, F)` does not mention the base at all,
so composing `g` with the isomorphism `Y₀ ≅ Spec Γ(Y₀, ⊤)` changes neither the hypothesis
(`topologicalKrullDim_fiber_comp_isoSpec_le`) nor the conclusion. The ring `Γ(Y₀, ⊤)` is
Noetherian because `⊤` is an affine open of `Y₀`.

The statement is written at the exact shape of the hypothesis `hcoh` of
`exists_isAffineOpen_vanishing_of_cohomology_vanishing` and of
`isZero_stalk_rightDerivedPlus_of_cohomology_vanishing`, with the single extra hypothesis that
the base is locally Noetherian. -/
theorem cohomology_vanishing_of_forall_fiber_dim_le_of_isLocallyNoetherian (d : ℕ)
    {X₀ Y₀ : Scheme.{u}} (g : X₀ ⟶ Y₀) (hg : IsProper g) (hY₀ : IsAffine Y₀)
    (hYN : IsLocallyNoetherian Y₀)
    (hfib : ∀ s : Y₀, topologicalKrullDim (g.fiber s) ≤ (d : WithBot ℕ∞))
    (i : ℤ) (hi : (d : ℤ) < i) (F : X₀.Modules) (hF : F.IsQuasicoherent) :
    IsZero (((moduleGlobalSections X₀).rightDerivedPlus i).obj F) := by
  have hN : IsNoetherianRing (Γ(Y₀, ⊤) : Type u) :=
    IsLocallyNoetherian.component_noetherian ⟨⊤, isAffineOpen_top Y₀⟩
  exact isZero_rightDerivedPlus_of_forall_fiber_dim_le (g ≫ Y₀.isoSpec.hom)
    (topologicalKrullDim_fiber_comp_isoSpec_le g hfib) i hi F hF

end

