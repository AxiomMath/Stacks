/-! ### Cyclic modules and surjectivity of ring maps -/

/-- A ring map whose target is generated, as a module over the source, by a single element is
surjective: the generator is a unit times the image of the source, hence itself in the image. -/
private theorem surjective_of_cyclic {A B : Type u} [CommRing A] [CommRing B]
    (φ : A →+* B) (t : B) (h : ∀ b : B, ∃ a : A, b = φ a * t) :
    Function.Surjective φ := by
  obtain ⟨a, ha⟩ := h 1
  obtain ⟨c, hc⟩ := h (t * t)
  have ht : t = φ c := by linear_combination (t - φ c) * ha + φ a * hc
  intro b
  obtain ⟨d, hd⟩ := h b
  exact ⟨d * c, by rw [map_mul, hd, ht]⟩

/-- A ring map read as a morphism of modules from the rank-one free module over the source to
the target ring with scalars restricted along the map. -/
private def unitHomOfRingHom {A C : CommRingCat.{u}} (φ : A ⟶ C) :
    ModuleCat.of A A ⟶ (ModuleCat.restrictScalars φ.hom).obj (ModuleCat.of C C) :=
  ModuleCat.ofHom (Y := (ModuleCat.restrictScalars φ.hom).obj (ModuleCat.of C C))
    { toFun := fun a => φ.hom a
      map_add' := fun a b => map_add φ.hom a b
      map_smul' := fun a b => (map_mul φ.hom a b).trans
        (@ModuleCat.restrictScalars.smul_def _ _ _ _ φ.hom (ModuleCat.of C C) a (φ.hom b)).symm }

/-- A surjective ring map gives an epimorphism out of the rank-one free module. -/
private theorem epi_unitHomOfRingHom {A C : CommRingCat.{u}} (φ : A ⟶ C)
    (hφ : Function.Surjective φ.hom) : Epi (unitHomOfRingHom φ) :=
  (ModuleCat.epi_iff_surjective _).mpr hφ

/-- A ring map is surjective as soon as the target, viewed as a module over the source, is a
quotient of the rank-one free module. -/
private theorem surjective_of_epi_unitHom {B C : CommRingCat.{u}} (ψ : B ⟶ C)
    (γ : ModuleCat.of B B ⟶ (ModuleCat.restrictScalars ψ.hom).obj (ModuleCat.of C C))
    (hγ : Epi γ) : Function.Surjective ψ.hom := by
  have hs : Function.Surjective γ.hom := (ModuleCat.epi_iff_surjective γ).mp hγ
  obtain ⟨t, ht⟩ : ∃ t : C, γ.hom (1 : ModuleCat.of B B) = t :=
    ⟨γ.hom (1 : ModuleCat.of B B), rfl⟩
  refine surjective_of_cyclic ψ.hom t fun y => ?_
  obtain ⟨b, hb⟩ := hs y
  refine ⟨b, ?_⟩
  have key : γ.hom (b • (1 : ModuleCat.of B B)) = ψ.hom b * t := by
    have h1 := map_smul γ.hom b (1 : ModuleCat.of B B)
    have h2 := @ModuleCat.restrictScalars.smul_def _ _ _ _ ψ.hom (ModuleCat.of C C) b
      (γ.hom (1 : ModuleCat.of B B))
    rw [h1, h2, ← ht, smul_eq_mul]
  have hb1 : (b • (1 : ModuleCat.of B B) : ModuleCat.of B B) = b := by
    rw [smul_eq_mul, mul_one]
  exact hb.symm.trans ((congrArg (fun z => γ.hom z) hb1).symm.trans key)

/-! ### Factoring a morphism of affine schemes as a closed immersion followed by a flat map -/

/-- The polynomial algebra on the elements of the target of a ring map: every ring map factors
through it as a flat map followed by a surjection. -/
private def polyRing {A A' : CommRingCat.{u}} (φ : A ⟶ A') : CommRingCat.{u} :=
  letI : Algebra A A' := φ.hom.toAlgebra
  CommRingCat.of (MvPolynomial A' A)

/-- The flat structure map of the polynomial algebra. -/
private def polyIn {A A' : CommRingCat.{u}} (φ : A ⟶ A') : A ⟶ polyRing φ :=
  letI : Algebra A A' := φ.hom.toAlgebra
  CommRingCat.ofHom (algebraMap A (MvPolynomial A' A))

/-- The tautological surjection from the polynomial algebra onto the target. -/
private def polyOut {A A' : CommRingCat.{u}} (φ : A ⟶ A') : polyRing φ ⟶ A' :=
  letI : Algebra A A' := φ.hom.toAlgebra
  CommRingCat.ofHom (MvPolynomial.aeval (R := A) (fun a : A' => a)).toRingHom

/-- The factorization recovers the original ring map. -/
private theorem polyIn_comp_polyOut {A A' : CommRingCat.{u}} (φ : A ⟶ A') :
    polyIn φ ≫ polyOut φ = φ := by
  let _ : Algebra A A' := φ.hom.toAlgebra
  refine CommRingCat.hom_ext (RingHom.ext fun x => ?_)
  exact (MvPolynomial.aeval (R := A) (fun a : A' => a)).commutes x

/-- Each element of the target is the image of its own variable. -/
private theorem surjective_polyOut {A A' : CommRingCat.{u}} (φ : A ⟶ A') :
    Function.Surjective (polyOut φ).hom := by
  let _ : Algebra A A' := φ.hom.toAlgebra
  exact fun a => ⟨MvPolynomial.X (R := A) a, MvPolynomial.aeval_X (fun a : A' => a) a⟩

/-- A polynomial algebra is free, hence flat, over its base. -/
private theorem flat_polyIn {A A' : CommRingCat.{u}} (φ : A ⟶ A') :
    RingHom.Flat (polyIn φ).hom := by
  let _ : Algebra A A' := φ.hom.toAlgebra
  change RingHom.Flat (algebraMap A (MvPolynomial A' A))
  exact RingHom.flat_algebraMap_iff.mpr (Module.Flat.of_free (R := A) (M := MvPolynomial A' A))

/-- The affine scheme through which a morphism of affine schemes is factored as a closed
immersion followed by a flat morphism. -/
private abbrev polyMid {Y' Y : Scheme.{u}} [IsAffine Y] [IsAffine Y']
    (m : Y' ⟶ Y) : Scheme.{u} := Spec (polyRing m.appTop)

/-- The flat half of the factorization of a morphism of affine schemes. -/
private def polyFlat {Y' Y : Scheme.{u}} [IsAffine Y] [IsAffine Y']
    (m : Y' ⟶ Y) : polyMid m ⟶ Y :=
  Spec.map (polyIn m.appTop) ≫ Y.isoSpec.inv

/-- The closed-immersion half of the factorization of a morphism of affine schemes. -/
private def polyImm {Y' Y : Scheme.{u}} [IsAffine Y] [IsAffine Y']
    (m : Y' ⟶ Y) : Y' ⟶ polyMid m :=
  Y'.isoSpec.hom ≫ Spec.map (polyOut m.appTop)

private instance {Y' Y : Scheme.{u}} [IsAffine Y] [IsAffine Y'] (m : Y' ⟶ Y) :
    Flat (polyFlat m) := by
  have h : Flat (Spec.map (polyIn m.appTop)) :=
    (HasRingHomProperty.Spec_iff (P := @Flat)).mpr (flat_polyIn m.appTop)
  change Flat (Spec.map (polyIn m.appTop) ≫ Y.isoSpec.inv)
  infer_instance

private instance {Y' Y : Scheme.{u}} [IsAffine Y] [IsAffine Y'] (m : Y' ⟶ Y) :
    IsClosedImmersion (polyImm m) := by
  have h : IsClosedImmersion (Spec.map (polyOut m.appTop)) :=
    IsClosedImmersion.spec_of_surjective _ (surjective_polyOut m.appTop)
  change IsClosedImmersion (Y'.isoSpec.hom ≫ Spec.map (polyOut m.appTop))
  infer_instance

/-- The two halves of the factorization compose to the original morphism. -/
private theorem polyImm_comp_polyFlat {Y' Y : Scheme.{u}} [IsAffine Y] [IsAffine Y']
    (m : Y' ⟶ Y) : polyImm m ≫ polyFlat m = m := by
  rw [polyImm, polyFlat, Category.assoc, ← Category.assoc (Spec.map (polyOut m.appTop)),
    ← Spec.map_comp, polyIn_comp_polyOut, ← Category.assoc, Scheme.isoSpec_hom,
    ← Scheme.toSpecΓ_naturality, ← Scheme.isoSpec_hom, Category.assoc, Iso.hom_inv_id,
    Category.comp_id]

/-! ### Sections over an open, and surjectivity under restriction -/

/-- Surjectivity is unaffected by pre- and post-composition with isomorphisms. -/
private theorem surjective_comp_iso_iff {A B C D : CommRingCat.{u}}
    (a : A ≅ B) (b : B ⟶ C) (c : C ≅ D) :
    Function.Surjective (a.hom ≫ b ≫ c.hom).hom ↔ Function.Surjective b.hom := by
  have ha : Function.Surjective a.hom.hom := (ConcreteCategory.bijective_of_isIso a.hom).2
  have hcb : Function.Bijective c.hom.hom := ConcreteCategory.bijective_of_isIso c.hom
  constructor
  · intro h y
    obtain ⟨x, hx⟩ := h (c.hom.hom y)
    exact ⟨a.hom.hom x, hcb.1 (by simpa using hx)⟩
  · intro h
    exact hcb.2.comp (h.comp ha)

/-- Global functions of a morphism restricted over an open of the target are the sections of
the original morphism over that open. -/
private theorem surjective_morphismRestrict_appTop_iff {X Y : Scheme.{u}} (f : X ⟶ Y)
    (V : Y.Opens) :
    Function.Surjective (f ∣_ V).appTop.hom ↔ Function.Surjective (f.app V).hom := by
  have hLE : f.appLE V (f ⁻¹ᵁ V) le_rfl = f.app V := by simp [Scheme.Hom.appLE]
  have key : (f ∣_ V).app ⊤ =
      V.topIso.hom ≫ f.app V ≫ (f ⁻¹ᵁ V).topIso.inv := by
    rw [← Scheme.Hom.resLE_eq_morphismRestrict, Scheme.Hom.resLE_app_top, hLE]
  have hiff : Function.Surjective ((f ∣_ V).app ⊤).hom ↔
      Function.Surjective (f.app V).hom := by
    rw [key]
    exact surjective_comp_iso_iff V.topIso (f.app V) (f ⁻¹ᵁ V).topIso.symm
  exact hiff

/-- Around any point of an open of `Y'` there is an affine open contained in it whose image is
contained in an affine open of `Y`. This is the refinement along which the source's "we may
assume `Y` and `Y'` affine" is carried out. -/
private theorem exists_affine_le_with_affine_image
    {Y' Y : Scheme.{u}} (g : Y' ⟶ Y) (U : Y'.Opens) (y : Y') (hy : y ∈ U) :
    ∃ (V : Y'.Opens) (W : Y.Opens), IsAffineOpen V ∧ IsAffineOpen W ∧
      V ≤ U ∧ y ∈ V ∧ ∀ z : Y', z ∈ V → g z ∈ W := by
  obtain ⟨-, ⟨W, hW, rfl⟩, hgyW, -⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (g y)) isOpen_univ
  have hy' : y ∈ U ⊓ g ⁻¹ᵁ W := ⟨hy, hgyW⟩
  obtain ⟨-, ⟨V, hV, rfl⟩, hyV, hVsub⟩ :=
    Y'.isBasis_affineOpens.exists_subset_of_mem_open hy' (U ⊓ g ⁻¹ᵁ W).2
  exact ⟨V, W, hV, hW, fun z hz => (hVsub hz).1, hyV, fun z hz => (hVsub hz).2⟩

/-! ### Local surjectivity of the structure-sheaf comparison -/

/-- Local surjectivity of a structure-sheaf map is a local condition on the target: it is
enough to find, inside each open of the target and around each of its points, one open on whose
sections the map is surjective. -/
private theorem isLocallySurjective_of_surjective_on_refinement
    {X Y : Scheme.{u}} (f : X ⟶ Y)
    (hf : ∀ (U : Y.Opens) (y : Y), y ∈ U → ∃ V : Y.Opens, V ≤ U ∧ y ∈ V ∧
      Function.Surjective (fun s => (f.toRingCatSheafHom.hom.app (op V)) s)) :
    Sheaf.IsLocallySurjective f.toRingCatSheafHom := by
  constructor
  intro U s x hx
  obtain ⟨V, hVU, hxV, hsurj⟩ := hf U x hx
  obtain ⟨t, ht⟩ := hsurj (s |_ V)
  exact ⟨V, homOfLE hVU, ⟨t, ht⟩, hxV⟩

/-- The structure-sheaf comparison is locally surjective as a map of abelian sheaves exactly when
it is locally surjective as a map of sheaves of rings. -/
private theorem isLocallySurjective_toSheaf_map_iff {X Y : Scheme.{u}} (f : X ⟶ Y) :
    Presheaf.IsLocallySurjective (Opens.grothendieckTopology Y)
      ((SheafOfModules.toSheaf Y.ringCatSheaf).map
        (SheafOfModules.unitToPushforwardObjUnit f.toRingCatSheafHom)).hom ↔
    Presheaf.IsLocallySurjective (Opens.grothendieckTopology Y) f.toRingCatSheafHom.hom := by
  constructor <;> intro h <;> constructor <;> intro U s <;> convert h.imageSieve_mem s using 1 <;>
    ext V i <;> rfl

/-- A locally surjective structure-sheaf map is an epimorphism of sheaves of modules: the
module category is abelian, so there `Epi` and local surjectivity agree, and transporting along
the forgetful functor turns the ring-level statement into the module-level one. -/
private theorem epi_unitToPushforwardUnit_of_isLocallySurjective
    {X Y : Scheme.{u}} (f : X ⟶ Y) [Sheaf.IsLocallySurjective f.toRingCatSheafHom] :
    Epi (Scheme.Modules.unitToPushforwardUnit f) := by
  let p := SheafOfModules.unitToPushforwardObjUnit f.toRingCatSheafHom
  let F := SheafOfModules.toSheaf Y.ringCatSheaf
  have hEpi : Epi (F.map p) := by
    rw [← CategoryTheory.Sheaf.isLocallySurjective_iff_epi'
        (J := Opens.grothendieckTopology Y) AddCommGrpCat (F.map p),
      ← CategoryTheory.Sheaf.isLocallySurjective_sheafToPresheaf_map_iff (F.map p)]
    exact (isLocallySurjective_toSheaf_map_iff f).mpr
      (inferInstanceAs (Sheaf.IsLocallySurjective f.toRingCatSheafHom))
  exact F.epi_of_epi_map hEpi

/-! ### Transporting the fibrewise hypotheses to a base change -/

/-- The local Krull dimension at a point is bounded by the Krull dimension of the space. -/
@[ega "0 14.1.6" "partial"]
private theorem topologicalKrullDimAt_le_global
    {T : Type u} [TopologicalSpace T] (x : T) :
    topologicalKrullDimAt T x ≤ topologicalKrullDim T := by
  change (⨅ U : {U : Set T // x ∈ U ∧ IsOpen U},
    topologicalKrullDim (↥U.1)) ≤ topologicalKrullDim T
  exact (iInf_le _ ⟨Set.univ, Set.mem_univ x, isOpen_univ⟩).trans
    (topologicalKrullDim_subspace_le T Set.univ)

/-- A point of a fibre is recovered from its image in the total space. -/
private theorem asFiber_eq_of_fiberι_eq
    {X S : Scheme.{u}} (f : X ⟶ S) (s : S) (z : f.fiber s) (x : X)
    (hx : f x = s) (h : x = f.fiberι s z) : hx ▸ f.asFiber x = z := by
  apply (f.fiberι s).isEmbedding.injective
  cases hx
  simpa using h

/-- **The fibre-dimension hypothesis passes to a base change.** The fibres of a base change are
base changes of fibres, and the local dimension of a fibre at a point is unchanged by base
change ([Stacks, Tag 02FY] part (1)); the global bound is then the supremum of the local
ones. -/
private theorem fiber_dimension_le_one_of_isPullback
    {X' X Y' Y : Scheme.{u}} (f' : X' ⟶ Y') (g' : X' ⟶ X)
    (f : X ⟶ Y) (g : Y' ⟶ Y) (h : IsPullback g' f' f g)
    [LocallyOfFiniteType f]
    (hdim : ∀ y : Y, topologicalKrullDim (f.fiber y) ≤ ((1 : ℕ) : WithBot ℕ∞)) :
    ∀ y' : Y', topologicalKrullDim (f'.fiber y') ≤ ((1 : ℕ) : WithBot ℕ∞) := by
  intro y'
  have hpointwise : ∀ x' : X',
      topologicalKrullDimAt (f'.fiber (f' x')) (f'.asFiber x') ≤ ((1 : ℕ) : WithBot ℕ∞) := by
    intro x'
    have hbase := congrArg (fun k : X' ⟶ Y => k x') h.w
    change f (g' x') = g (f' x') at hbase
    have hdim' : topologicalKrullDim (f.fiber (f (g' x'))) ≤ ((1 : ℕ) : WithBot ℕ∞) := by
      rw [hbase]
      exact hdim (g (f' x'))
    have hlocal : topologicalKrullDimAt (f.fiber (f (g' x'))) (f.asFiber (g' x')) ≤
        ((1 : ℕ) : WithBot ℕ∞) :=
      (topologicalKrullDimAt_le_global _).trans hdim'
    exact (AlgebraicGeometry.topologicalKrullDimAt_fiber_eq_of_isPullback
      h x').symm ▸ hlocal
  rw [topologicalKrullDim_eq_iSup_localKrullDim]
  apply iSup_le
  intro x'
  rw [← topologicalKrullDimAt_eq_localKrullDim]
  let x := f'.fiberι y' x'
  have hx : f' x = y' := by
    simpa [x] using congrArg (fun k : f'.fiber y' ⟶ Y' => k x') (f'.fiber_fac y')
  have hlocal' : topologicalKrullDimAt (f'.fiber y') (hx ▸ f'.asFiber x) ≤
      ((1 : ℕ) : WithBot ℕ∞) :=
    Eq.rec (motive := fun t ht =>
      topologicalKrullDimAt (f'.fiber t) (ht ▸ f'.asFiber x) ≤ ((1 : ℕ) : WithBot ℕ∞))
      (hpointwise x) hx
  simpa only [asFiber_eq_of_fiberι_eq f' y' x' x hx rfl] using hlocal'

/-- The structure sheaf is quasi-coherent: it is the free module on a one-element index type. -/
private lemma unit_isQuasicoherent (X : Scheme.{u}) :
    (SheafOfModules.unit X.ringCatSheaf).IsQuasicoherent := by
  let e : SheafOfModules.free (R := X.ringCatSheaf) PUnit.{u + 1} ≅
      SheafOfModules.unit X.ringCatSheaf :=
    Limits.coproductUniqueIso (fun _ : PUnit.{u + 1} ↦
      SheafOfModules.unit X.ringCatSheaf)
  exact (SheafOfModules.isQuasicoherent X.ringCatSheaf).prop_of_iso e
    (inferInstanceAs
      (SheafOfModules.free (R := X.ringCatSheaf) PUnit.{u + 1}).IsQuasicoherent)

/-- The morphism from a fibre to the spectrum of the residue field is quasi-compact: it is a
base change of the morphism itself. -/
private instance quasiCompact_fiberToSpecResidueField {X Y : Scheme.{u}} (f : X ⟶ Y)
    [QuasiCompact f] (y : Y) : QuasiCompact (f.fiberToSpecResidueField y) := by
  change QuasiCompact (pullback.snd f (Y.fromSpecResidueField y))
  infer_instance

/-- The morphism from a fibre to the spectrum of the residue field is quasi-separated: it is a
base change of the morphism itself. -/
private instance quasiSeparated_fiberToSpecResidueField {X Y : Scheme.{u}} (f : X ⟶ Y)
    [QuasiSeparated f] (y : Y) : QuasiSeparated (f.fiberToSpecResidueField y) := by
  change QuasiSeparated (pullback.snd f (Y.fromSpecResidueField y))
  infer_instance

/-- The structure sheaf of a fibre is quasi-coherent. -/
private instance unitFiber_isQuasicoherent {X Y : Scheme.{u}} (f : X ⟶ Y) (y : Y) :
    (SheafOfModules.unit (f.fiber y).ringCatSheaf).IsQuasicoherent :=
  unit_isQuasicoherent (f.fiber y)

/-- **The hypothesis `H¹(X_y, 𝒪_{X_y}) = 0` passes to a base change.** The fibre of the base
change over `y'` is the base change of the fibre over `g y'` along the extension of residue
fields `κ(g y') ⟶ κ(y')`, which is flat, so flat base change over affine bases
([Stacks, Tag 02KH] part (2)) identifies the first cohomology of the structure sheaf of the new
fibre with the old one tensored up. -/
private theorem fiber_h1_of_isPullback
    {X' X Y' Y : Scheme.{u}} (f' : X' ⟶ Y') (g' : X' ⟶ X)
    (f : X ⟶ Y) (g : Y' ⟶ Y) (h : IsPullback g' f' f g) [QuasiCompact f] [QuasiSeparated f]
    (y' : Y')
    (hH₁ : IsZero (firstCohomologyStructureSheaf (f.fiber (g y')))) :
    IsZero (firstCohomologyStructureSheaf (f'.fiber y')) := by
  let k := Spec.map (g.residueFieldMap y')
  let r := pullback.map f' (Y'.fromSpecResidueField y') f
    (Y.fromSpecResidueField (g y')) g' k g h.w.symm (by simp [k])
  have hsq : IsPullback r (f'.fiberToSpecResidueField y')
      (f.fiberToSpecResidueField (g y')) k :=
    isPullback_fiberToSpecResidueField_of_isPullback h y'
  have : Flat k := inferInstanceAs (Flat (Spec.map (g.residueFieldMap y')))
  have hsource : IsZero ((ModuleCat.extendScalars k.appTop.hom).obj
      (Stacks.AlgebraicGeometry.FlatBaseChangeDerived.cohomologyOver
        (f.fiberToSpecResidueField (g y'))
        (SheafOfModules.unit (f.fiber (g y')).ringCatSheaf) 1)) :=
    Functor.map_isZero (ModuleCat.extendScalars k.appTop.hom)
      (Functor.map_isZero
        (ModuleCat.restrictScalars (f.fiberToSpecResidueField (g y')).appTop.hom) hH₁)
  have htargetR : IsZero (Stacks.AlgebraicGeometry.FlatBaseChangeDerived.cohomologyOver
      (f'.fiberToSpecResidueField y')
      ((Scheme.Modules.pullback r).obj
        (SheafOfModules.unit (f.fiber (g y')).ringCatSheaf)) 1) :=
    IsZero.of_iso hsource
      (Stacks.AlgebraicGeometry.FlatBaseChangeDerived.cohomologyBaseChangeIso
        (f := f.fiberToSpecResidueField (g y')) (f' := f'.fiberToSpecResidueField y')
        (g := k) (g' := r) hsq
        (SheafOfModules.unit (f.fiber (g y')).ringCatSheaf) 1).symm
  have hsub : Subsingleton (Stacks.AlgebraicGeometry.FlatBaseChangeDerived.cohomologyOver
      (f'.fiberToSpecResidueField y')
      ((Scheme.Modules.pullback r).obj
        (SheafOfModules.unit (f.fiber (g y')).ringCatSheaf)) 1) :=
    ModuleCat.subsingleton_of_isZero htargetR
  have htarget : IsZero
      (((Stacks.Cohomology.AffineBase.moduleGlobalSections (f'.fiber y')).rightDerivedPlus 1).obj
        ((Scheme.Modules.pullback r).obj
          (SheafOfModules.unit (f.fiber (g y')).ringCatSheaf))) :=
    ModuleCat.isZero_iff_subsingleton.mpr hsub
  exact IsZero.of_iso htarget
    (((Stacks.Cohomology.AffineBase.moduleGlobalSections (f'.fiber y')).rightDerivedPlus 1).mapIso
      (Scheme.Modules.pullbackUnitIso r)).symm

/-- A base change of a proper morphism satisfying the fibre hypotheses is proper and satisfies
them too. -/
private theorem fiber_hypotheses_of_isPullback
    {X' X Y' Y : Scheme.{u}} (f' : X' ⟶ Y') (g' : X' ⟶ X)
    (f : X ⟶ Y) (g : Y' ⟶ Y) (h : IsPullback g' f' f g) [IsProper f]
    (hdim : ∀ y : Y, topologicalKrullDim (f.fiber y) ≤ ((1 : ℕ) : WithBot ℕ∞))
    (hfib : ∀ y : Y, IsZero (firstCohomologyStructureSheaf (f.fiber y))) :
    IsProper f' ∧ (∀ y' : Y', topologicalKrullDim (f'.fiber y') ≤ ((1 : ℕ) : WithBot ℕ∞)) ∧
      ∀ y' : Y', IsZero (firstCohomologyStructureSheaf (f'.fiber y')) :=
  ⟨MorphismProperty.of_isPullback h inferInstance,
    fiber_dimension_le_one_of_isPullback _ _ f g h hdim,
    fun y' => fiber_h1_of_isPullback _ _ f g h y' (hfib (g y'))⟩

/-! ### Global sections over an affine base -/

/-- Global sections agree with the zeroth right derived functor of global sections. -/
private def globalSectionsIsoRightDerivedZero (X : Scheme.{u}) (F : X.Modules) :
    (Stacks.Cohomology.AffineBase.moduleGlobalSections X).obj F ≅
      ((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerivedPlus (0 : ℤ)).obj F :=
  (Stacks.RightDerivedPlus.rightDerivedPlusZeroObjIso
    (Stacks.Cohomology.AffineBase.moduleGlobalSections X) F).symm

/-- Over an affine scheme a quasi-coherent module is generated by global sections: it is the
tilde of its module of sections, and a module is generated by its own elements. -/
private theorem exists_generatingSections_of_affine_qc
    (R : CommRingCat.{u}) (F : (Spec R).Modules) [F.IsQuasicoherent] :
    Nonempty F.GeneratingSections := by
  let M : ModuleCat R := (moduleSpecΓFunctor (R := R)).obj F
  let _ : Module R (↑M) := M.isModule
  let φ' : (M →₀ R) →ₗ[R] M := Finsupp.linearCombination R (fun x : M => x)
  let φ₀ : ModuleCat.of R (M →₀ R) ⟶ ModuleCat.of R M := ModuleCat.ofHom φ'
  let e : ModuleCat.of R M ≅ M := Iso.refl M
  let φ : ModuleCat.of R (M →₀ R) ⟶ M := φ₀ ≫ e.hom
  have hsurj : Function.Surjective φ' := fun x =>
    ⟨Finsupp.single x 1, by simp [φ', Finsupp.linearCombination_single]⟩
  have _ : Epi φ₀ := (ModuleCat.epi_iff_surjective _).mpr (by simpa [φ₀] using hsurj)
  have _ : Functor.PreservesEpimorphisms (tilde.functor (R := R)) :=
    Functor.preservesEpimorphisms_of_adjunction (tilde.adjunction (R := R))
  have htilde : Epi ((tilde.functor (R := R)).map φ) :=
    Functor.map_epi (tilde.functor (R := R)) φ
  let eF : tilde (ModuleCat.of R (M →₀ R)) ≅
      SheafOfModules.free (R := (Spec R).ringCatSheaf) M := tildeFinsupp (R := R) M
  let q : SheafOfModules.free (R := (Spec R).ringCatSheaf) M ⟶ F :=
    eF.inv ≫ (tilde.functor (R := R)).map φ ≫ F.fromTildeΓ
  have hq : Epi q := by
    have h1 : Epi eF.inv := @IsIso.epi_of_iso _ _ _ _ eF.inv (Iso.isIso_inv eF)
    have h2 : Epi F.fromTildeΓ := @IsIso.epi_of_iso _ _ _ _ F.fromTildeΓ
      (Scheme.Modules.isIso_fromTildeΓ_of_isQuasicoherent F)
    exact epi_comp' h1 (epi_comp' htilde h2)
  exact ⟨{ I := M, s := F.freeHomEquiv q, epi := by simpa using hq }⟩

/-- **An epimorphism of quasi-coherent modules is surjective on the sections over an affine
open.** On an affine scheme the quasi-coherent modules are equivalent to modules over the
sections of the structure sheaf, where epimorphisms are the surjections; the general case
follows by restricting to the affine open. -/
private theorem affine_open_sections_surjective_of_epi
    {X : Scheme.{u}} {M N : X.Modules} (hM : M.IsQuasicoherent) (hN : N.IsQuasicoherent)
    (p : M ⟶ N) (hp : Epi p) (U : X.affineOpens) :
    Function.Surjective (p.app U.1) := by
  have _ := hM
  have _ := hN
  have _ := hp
  let i := U.2.fromSpec
  let _ : IsOpenImmersion i := U.2.isOpenImmersion_fromSpec
  let p' := (Scheme.Modules.restrictFunctor i).map p
  let P := SheafOfModules.isQuasicoherent (Spec (CommRingCat.of Γ(X, U))).ringCatSheaf
  let M' : P.FullSubcategory := ⟨M.restrict i, by infer_instance⟩
  let N' : P.FullSubcategory := ⟨N.restrict i, by infer_instance⟩
  let p'' : M' ⟶ N' := ObjectProperty.homMk p'
  have hp'' : Epi p'' :=
    ⟨fun _ _ hab => ObjectProperty.hom_ext _ ((cancel_epi p').mp (congrArg (fun k => k.hom) hab))⟩
  let E := AlgebraicGeometry.tildeEquiv (R := CommRingCat.of Γ(X, U))
  have hsurj : Function.Surjective (p'.app ⊤) :=
    (ModuleCat.epi_iff_surjective (E.inverse.map p'')).mp (Functor.map_epi E.inverse p'')
  have hnat : p'.app ⊤ ≫ (N.restrictAppIso i ⊤).hom =
      (M.restrictAppIso i ⊤).hom ≫ p.app (i ''ᵁ ⊤) := by
    ext x
    rfl
  have hU : i ''ᵁ ⊤ = U.1 := by
    rw [Scheme.Hom.image_top_eq_opensRange, U.2.opensRange_fromSpec]
  rw [← hU]
  intro y
  obtain ⟨x, hx⟩ := hsurj ((N.restrictAppIso i ⊤).inv y)
  refine ⟨(M.restrictAppIso i ⊤).hom x, ?_⟩
  have h : (N.restrictAppIso i ⊤).hom (p'.app ⊤ x) =
      p.app (i ''ᵁ ⊤) ((M.restrictAppIso i ⊤).hom x) := congrArg (fun k => k x) hnat
  rw [← h, hx]
  simp

/-- The pushforward of the structure sheaf along a quasi-compact and quasi-separated morphism
is quasi-coherent, by [Stacks, Tag 01XJ] in degree zero. -/
private lemma pushforward_unit_isQuasicoherent {X Y : Scheme.{u}} (f : X ⟶ Y)
    [QuasiCompact f] [QuasiSeparated f] :
    ((Scheme.Modules.pushforward f).obj
      (SheafOfModules.unit X.ringCatSheaf)).IsQuasicoherent := by
  let e := Stacks.RightDerivedPlus.rightDerivedPlusZeroObjIso
    (Scheme.Modules.pushforward f) (SheafOfModules.unit X.ringCatSheaf)
  exact (SheafOfModules.isQuasicoherent Y.ringCatSheaf).prop_of_iso e
    (@Stacks.AlgebraicGeometry.Tag01XJQcohInduction.higherDirectImage_isQuasicoherent X Y f _ _
      (SheafOfModules.unit X.ringCatSheaf) (unit_isQuasicoherent X) 0)

/-- Over an affine open of the target, a locally surjective structure-sheaf map is surjective on
sections: both the structure sheaf and its pushforward are quasi-coherent, and the open is
affine. -/
private theorem surjective_app_of_isLocallySurjective {X Y : Scheme.{u}} (f : X ⟶ Y)
    [QuasiCompact f] [QuasiSeparated f] [Sheaf.IsLocallySurjective f.toRingCatSheafHom]
    (W : Y.Opens) (hW : IsAffineOpen W) :
    Function.Surjective (f.app W).hom :=
  affine_open_sections_surjective_of_epi (unit_isQuasicoherent Y)
    (pushforward_unit_isQuasicoherent f)
    (Scheme.Modules.unitToPushforwardUnit f)
    (epi_unitToPushforwardUnit_of_isLocallySurjective f) ⟨W, hW⟩

/-! ### The closed-immersion half -/

/-- **The cohomological heart of [Stacks, Tag 0E7I].** Over an affine base, and under the fibre
hypotheses, global sections turn the epimorphism of a short exact sequence whose sub-object is
quasi-coherent and globally generated into an epimorphism: the vanishing `H¹(X, S.X₁) = 0` of
clause (4) of [Stacks, Tag 0E7H] kills the obstruction in the long exact sequence. -/
private theorem epi_globalSections_map_of_shortExact
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsProper f] [IsAffine Y]
    (hdim : ∀ y : Y, topologicalKrullDim (f.fiber y) ≤ ((1 : ℕ) : WithBot ℕ∞))
    (hfib : ∀ y : Y, IsZero (firstCohomologyStructureSheaf (f.fiber y)))
    (S : ShortComplex X.Modules) (hS : S.ShortExact) (hqc : S.X₁.IsQuasicoherent)
    (σ : SheafOfModules.GeneratingSections S.X₁) :
    Epi ((Stacks.Cohomology.AffineBase.moduleGlobalSections X).map S.g) :=
  have := hqc
  CategoryTheory.Functor.epi_map_g (Stacks.Cohomology.AffineBase.moduleGlobalSections X) hS
    (isZero_cohomology_one_of_generatingSections_of_isAffine f hdim hfib S.X₁ σ)

/-- Over an affine base, global functions on `X` surject onto global functions on a closed
subscheme `j : Z ⟶ X` whose ideal sheaf is globally generated. This is the closed-immersion
case: the ideal sheaf sits in `0 ⟶ ℐ ⟶ 𝒪_X ⟶ j_* 𝒪_Z ⟶ 0` by definition, and it is
quasi-coherent because `j` is a closed immersion. -/
private theorem epi_globalSections_unitToPushforward_of_isClosedImmersion
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsProper f] [IsAffine Y]
    (hdim : ∀ y : Y, topologicalKrullDim (f.fiber y) ≤ ((1 : ℕ) : WithBot ℕ∞))
    (hfib : ∀ y : Y, IsZero (firstCohomologyStructureSheaf (f.fiber y)))
    {Z : Scheme.{u}} (j : Z ⟶ X) [IsClosedImmersion j]
    (hgen : Nonempty (Stacks.ClosedImmersion.idealSheaf j.toLRSHom.toShHom).GeneratingSections) :
    Epi ((Stacks.Cohomology.AffineBase.moduleGlobalSections X).map
      (SheafOfModules.unitToPushforwardObjUnit j.toRingCatSheafHom)) := by
  obtain ⟨σ⟩ := hgen
  let q := SheafOfModules.unitToPushforwardObjUnit
    (RingedSpaceModuleAdjunction.structureSheafHom j.toLRSHom.toShHom)
  let S : ShortComplex X.Modules := ShortComplex.mk (kernel.ι q) q (kernel.condition q)
  have _ : Mono S.f := equalizer.ι_mono
  have _ : Epi S.g :=
    Stacks.AlgebraicGeometry.ClosedImmersionTFAE.epi_unitToPushforwardObjUnit_of_isClosedImmersion j
  have hS : S.ShortExact := { exact := ShortComplex.exact_kernel q }
  exact epi_globalSections_map_of_shortExact f hdim hfib S hS
    (Stacks.AlgebraicGeometry.ClosedImmersionTFAE.isQuasicoherent_idealSheaf j) σ

/-- Over an affine base, the ideal sheaf of a base-changed closed immersion is generated by
global sections: by [Stacks, Tag 01JU] it is the image of the pullback of the ideal of the
immersion, and that ideal is globally generated because the base is affine. -/
private theorem nonempty_generatingSections_idealSheaf_pullbackSnd
    {R : CommRingCat.{u}} {X : Scheme.{u}} (f : X ⟶ Spec R)
    {Y' : Scheme.{u}} (i : Y' ⟶ Spec R) [IsClosedImmersion i] :
    Nonempty (Stacks.ClosedImmersion.idealSheaf
      (pullback.snd i f).toLRSHom.toShHom).GeneratingSections := by
  have hcol : PreservesColimitsOfSize.{u, u, u, u, u + 1, u + 1} (Scheme.Modules.pullback f) :=
    (Scheme.Modules.pullbackPushforwardAdjunction f).leftAdjoint_preservesColimits
  let I := Stacks.ClosedImmersion.idealSheaf i.toLRSHom.toShHom
  let m := Stacks.ClosedImmersion.pullbackIdealMap f.toLRSHom I
    (kernel.ι (SheafOfModules.unitToPushforwardObjUnit
      (RingedSpaceModuleAdjunction.structureSheafHom i.toLRSHom.toShHom)))
  have hIqc : I.IsQuasicoherent :=
    Stacks.AlgebraicGeometry.ClosedImmersionTFAE.isQuasicoherent_idealSheaf i
  obtain ⟨G⟩ := @exists_generatingSections_of_affine_qc R I hIqc
  obtain ⟨e', -⟩ :=
    (Stacks.ClosedImmersion.existsUnique_idealSheaf_pullbackSnd_iso_pullbackIdeal i f I _
      (Iso.refl _) (Category.id_comp _)).exists
  let pr := cokernel.π (kernel.ι m) ≫ (Abelian.coimageIsoImage m).hom
  have hpr : Epi pr := epi_comp' inferInstance (IsIso.epi_of_iso _)
  let Gp := AlgebraicGeometry.generatingSectionsMap G (Scheme.Modules.pullback f) hcol
    (Scheme.Modules.pullbackUnitIso f).symm
  exact ⟨SheafOfModules.GeneratingSections.equivOfIso e'.symm
    (AlgebraicGeometry.generatingSectionsOfEpi Gp pr hpr)⟩

/-- Over an affine base, global functions surject onto global functions of the base change of
the base along a closed immersion. -/
private theorem surjective_appTop_of_closedImmersion_base
    {R : CommRingCat.{u}} {X : Scheme.{u}} (f : X ⟶ Spec R) [IsProper f]
    (hdim : ∀ y : Spec R, topologicalKrullDim (f.fiber y) ≤ ((1 : ℕ) : WithBot ℕ∞))
    (hfib : ∀ y : Spec R, IsZero (firstCohomologyStructureSheaf (f.fiber y)))
    {Y' : Scheme.{u}} (i : Y' ⟶ Spec R) [IsClosedImmersion i] :
    Function.Surjective (pullback.snd i f).appTop.hom := by
  have _ : IsClosedImmersion (pullback.snd i f) :=
    MorphismProperty.of_isPullback (IsPullback.of_hasPullback i f) inferInstance
  exact (ModuleCat.epi_iff_surjective _).mp
    (epi_globalSections_unitToPushforward_of_isClosedImmersion f hdim hfib
      (pullback.snd i f) (nonempty_generatingSections_idealSheaf_pullbackSnd f i))

/-! ### The flat half -/

/-- **Flat base change makes global functions upstairs a cyclic module over global functions on
the new base**, which forces the comparison ring map to be surjective. This is the flat half of
the source's reduction, carried out with [Stacks, Tag 02KH]. -/
private theorem surjective_appTop_of_flat_base
    {X Y : Scheme.{u}} (f : X ⟶ Y) [QuasiCompact f] [QuasiSeparated f] [IsAffine Y]
    (hsurj : Function.Surjective f.appTop.hom)
    {X'' Y'' : Scheme.{u}} [IsAffine Y''] (p : X'' ⟶ Y'') (q : X'' ⟶ X) (u : Y'' ⟶ Y)
    (hpb : IsPullback q p f u) [Flat u] :
    Function.Surjective p.appTop.hom := by
  have _ : (SheafOfModules.unit X.ringCatSheaf).IsQuasicoherent := unit_isQuasicoherent X
  let ES := ModuleCat.extendScalars u.appTop.hom
  let RSf := ModuleCat.restrictScalars f.appTop.hom
  let RSp := ModuleCat.restrictScalars p.appTop.hom
  let θ : ModuleCat.of Γ(Y'', ⊤) Γ(Y'', ⊤) ⟶ ES.obj (ModuleCat.of Γ(Y, ⊤) Γ(Y, ⊤)) :=
    (Functor.Monoidal.εIso ES).hom
  have hθ : Epi θ := by
    have _ : IsIso θ := (Functor.Monoidal.εIso ES).isIso_hom
    infer_instance
  let α := unitHomOfRingHom f.appTop
  have _ : Functor.PreservesEpimorphisms ES :=
    Functor.preservesEpimorphisms_of_adjunction
      (ModuleCat.extendRestrictScalarsAdj u.appTop.hom)
  have _ : Epi α := epi_unitHomOfRingHom f.appTop hsurj
  let bigIso : ES.obj (RSf.obj (ModuleCat.of Γ(X, ⊤) Γ(X, ⊤))) ≅
      RSp.obj (ModuleCat.of Γ(X'', ⊤) Γ(X'', ⊤)) :=
    ES.mapIso (RSf.mapIso (globalSectionsIsoRightDerivedZero X
        (SheafOfModules.unit X.ringCatSheaf))) ≪≫
      Stacks.AlgebraicGeometry.FlatBaseChangeDerived.cohomologyBaseChangeIso
        (f := f) (f' := p) (g := u) (g' := q) hpb
        (SheafOfModules.unit X.ringCatSheaf) 0 ≪≫
      RSp.mapIso (globalSectionsIsoRightDerivedZero X''
        ((Scheme.Modules.pullback q).obj (SheafOfModules.unit X.ringCatSheaf))).symm ≪≫
      RSp.mapIso ((Stacks.Cohomology.AffineBase.moduleGlobalSections X'').mapIso
        (Scheme.Modules.pullbackUnitIso q))
  refine surjective_of_epi_unitHom p.appTop (θ ≫ ES.map α ≫ bigIso.hom) ?_
  exact epi_comp' hθ (epi_comp' (Functor.map_epi ES α) (IsIso.epi_of_iso bigIso.hom))

/-! ### The affine case, and the reduction to it -/

/-- **The affine heart of [Stacks, Tag 0E7I]**: with both bases affine, the base-changed
morphism is surjective on global functions. The morphism of bases is factored through the
spectrum of a polynomial algebra, the flat half handled by flat base change and the
closed-immersion half by the ideal-sheaf argument. -/
private theorem surjective_appTop_of_isPullback_affine
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsProper f] [IsAffine Y]
    (hdim : ∀ y : Y, topologicalKrullDim (f.fiber y) ≤ ((1 : ℕ) : WithBot ℕ∞))
    (hfib : ∀ y : Y, IsZero (firstCohomologyStructureSheaf (f.fiber y)))
    (hsurj : Function.Surjective f.appTop.hom)
    {X' Y' : Scheme.{u}} [IsAffine Y'] (p : X' ⟶ Y') (r : X' ⟶ X) (m : Y' ⟶ Y)
    (hpb : IsPullback r p f m) :
    Function.Surjective p.appTop.hom := by
  let v := polyFlat m
  let j := polyImm m
  have hpbv : IsPullback (pullback.fst f v) (pullback.snd f v) f v :=
    IsPullback.of_hasPullback f v
  obtain ⟨_, hdimv, hfibv⟩ := fiber_hypotheses_of_isPullback _ _ f v hpbv hdim hfib
  have hv : Function.Surjective (pullback.snd f v).appTop.hom :=
    surjective_appTop_of_flat_base f hsurj (pullback.snd f v) (pullback.fst f v) v hpbv
  have hk : Function.Surjective (pullback.snd j (pullback.snd f v)).appTop.hom :=
    surjective_appTop_of_closedImmersion_base (pullback.snd f v) hdimv hfibv j
  have hfac : Function.Surjective
      (j.appTop ≫ (pullback.fst j (pullback.snd f v)).appTop).hom := by
    rw [← Scheme.Hom.comp_appTop, (IsPullback.of_hasPullback j (pullback.snd f v)).w,
      Scheme.Hom.comp_appTop]
    exact hk.comp hv
  have hpb2 : IsPullback (pullback.snd j (pullback.snd f v) ≫ pullback.fst f v)
      (pullback.fst j (pullback.snd f v)) f m := by
    have hh := ((IsPullback.of_hasPullback j (pullback.snd f v)).flip).paste_horiz hpbv
    rwa [polyImm_comp_polyFlat] at hh
  have hp : p.appTop = (pullback.fst j (pullback.snd f v)).appTop ≫
      (IsPullback.isoIsPullback X Y' hpb hpb2).hom.appTop := by
    rw [← Scheme.Hom.comp_appTop, IsPullback.isoIsPullback_hom_snd]
  rw [hp]
  have hsurje : Function.Surjective
      (IsPullback.isoIsPullback X Y' hpb hpb2).hom.appTop.hom := by
    intro z
    refine ⟨(IsPullback.isoIsPullback X Y' hpb hpb2).inv.appTop.hom z, ?_⟩
    have h2 : (IsPullback.isoIsPullback X Y' hpb hpb2).inv.appTop ≫
        (IsPullback.isoIsPullback X Y' hpb hpb2).hom.appTop = 𝟙 _ := by
      rw [← Scheme.Hom.comp_appTop, Iso.hom_inv_id, Scheme.Hom.id_appTop]
    simpa using congrArg (fun k => (CommRingCat.Hom.hom k) z) h2
  exact hsurje.comp (Function.Surjective.of_comp hfac)

/-- If the structure-sheaf comparison is an epimorphism of sheaves of **modules**, then it is
locally surjective as a map of sheaves of rings: the module category is abelian, so there `Epi`
and local surjectivity agree, and transporting along the forgetful functor turns the
module-level statement into the ring-level one. -/
private theorem isLocallySurjective_of_module_epi {X Y : Scheme.{u}} (f : X ⟶ Y)
    [Epi (Scheme.Modules.unitToPushforwardUnit f)] :
    Sheaf.IsLocallySurjective f.toRingCatSheafHom := by
  let p := SheafOfModules.unitToPushforwardObjUnit f.toRingCatSheafHom
  let F := SheafOfModules.toSheaf Y.ringCatSheaf
  have hp0 : Epi p := ‹Epi (Scheme.Modules.unitToPushforwardUnit f)›
  have hp : Epi (F.map p) := Functor.map_epi F p
  have h := (CategoryTheory.Sheaf.isLocallySurjective_iff_epi' AddCommGrpCat (F.map p)).mpr hp
  change Presheaf.IsLocallySurjective (Opens.grothendieckTopology Y) (F.map p).hom at h
  exact (isLocallySurjective_toSheaf_map_iff f).mp h

/-- If `V` maps into `W` under `g`, then the preimage of `V` in `X ×_Y Y'` lies over `f⁻¹ W`. -/
private theorem preimage_snd_le_preimage_fst {X Y Y' : Scheme.{u}} (f : X ⟶ Y) (g : Y' ⟶ Y)
    {V : Y'.Opens} {W : Y.Opens} (hVW : ∀ z : Y', z ∈ V → g z ∈ W) :
    pullback.snd f g ⁻¹ᵁ V ≤ pullback.fst f g ⁻¹ᵁ (f ⁻¹ᵁ W) := by
  intro x hx
  have hbase := congrArg (fun k : pullback f g ⟶ Y => k x) (IsPullback.of_hasPullback f g).w
  change f (pullback.fst f g x) = g (pullback.snd f g x) at hbase
  change f (pullback.fst f g x) ∈ W
  rw [hbase]
  exact hVW _ hx

/-- Restricting the pullback square of `f` and `g` over an open `W` of the base and an open `V`
of `Y'` mapping into it gives the pullback square of `f ∣_ W` and `V ⟶ W`. -/
private theorem isPullback_resLE_morphismRestrict {X Y Y' : Scheme.{u}} (f : X ⟶ Y) (g : Y' ⟶ Y)
    (V : Y'.Opens) (W : Y.Opens) (hle : V ≤ g ⁻¹ᵁ W)
    (hle2 : pullback.snd f g ⁻¹ᵁ V ≤ pullback.fst f g ⁻¹ᵁ (f ⁻¹ᵁ W)) :
    IsPullback ((pullback.fst f g).resLE (f ⁻¹ᵁ W) (pullback.snd f g ⁻¹ᵁ V) hle2)
      (pullback.snd f g ∣_ V) (f ∣_ W) (g.resLE W V hle) := by
  have hpbg : IsPullback (pullback.fst f g) (pullback.snd f g) f g :=
    IsPullback.of_hasPullback f g
  have hmι : g.resLE W V hle ≫ W.ι = V.ι ≫ g := Scheme.Hom.resLE_comp_ι g hle
  have hsq1 : IsPullback ((pullback.snd f g ⁻¹ᵁ V).ι ≫ pullback.fst f g)
      (pullback.snd f g ∣_ V) f (V.ι ≫ g) :=
    (isPullback_morphismRestrict (pullback.snd f g) V).flip.paste_horiz hpbg
  have hcι : (pullback.fst f g).resLE (f ⁻¹ᵁ W) (pullback.snd f g ⁻¹ᵁ V) hle2 ≫
      (f ⁻¹ᵁ W).ι = (pullback.snd f g ⁻¹ᵁ V).ι ≫ pullback.fst f g :=
    Scheme.Hom.resLE_comp_ι _ hle2
  have h1 : ((pullback.fst f g).resLE (f ⁻¹ᵁ W) (pullback.snd f g ⁻¹ᵁ V) hle2 ≫
      (f ∣_ W)) ≫ W.ι =
      (pullback.snd f g ⁻¹ᵁ V).ι ≫ pullback.snd f g ≫ g := by
    rw [Category.assoc, morphismRestrict_ι, ← Category.assoc, hcι, Category.assoc, hpbg.w]
  have h2 : ((pullback.snd f g ∣_ V) ≫ g.resLE W V hle) ≫ W.ι =
      (pullback.snd f g ⁻¹ᵁ V).ι ≫ pullback.snd f g ≫ g := by
    rw [Category.assoc, hmι, ← Category.assoc, morphismRestrict_ι, Category.assoc]
  have hsq1' : IsPullback ((pullback.fst f g).resLE (f ⁻¹ᵁ W)
      (pullback.snd f g ⁻¹ᵁ V) hle2 ≫ (f ⁻¹ᵁ W).ι)
      (pullback.snd f g ∣_ V) f (g.resLE W V hle ≫ W.ι) := by
    rwa [hcι, hmι]
  exact IsPullback.of_right hsq1' ((cancel_mono W.ι).mp (h1.trans h2.symm))
    (isPullback_morphismRestrict f W).flip

/-- **The reduction to the affine case.** With `V ⊆ Y'` affine mapping into an affine `W ⊆ Y`,
every function on the base-changed source over `V` comes from a function on `V`.

Both the source and the target of the base change are restricted over the affine opens, which
exhibits the restricted base-changed morphism as a base change of `f ∣_ W` along the induced
morphism of affine schemes `V ⟶ W`; the affine statement is
`surjective_appTop_of_isPullback_affine`. -/
private theorem surjective_app_pullback_snd_of_affine
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsProper f]
    (hdim : ∀ y : Y, topologicalKrullDim (f.fiber y) ≤ ((1 : ℕ) : WithBot ℕ∞))
    (hfib : ∀ y : Y, IsZero (firstCohomologyStructureSheaf (f.fiber y)))
    [Sheaf.IsLocallySurjective f.toRingCatSheafHom]
    {Y' : Scheme.{u}} (g : Y' ⟶ Y)
    (V : Y'.Opens) (W : Y.Opens) (hV : IsAffineOpen V) (hW : IsAffineOpen W)
    (hVW : ∀ z : Y', z ∈ V → g z ∈ W) :
    Function.Surjective
      (fun s => ((pullback.snd f g).toRingCatSheafHom.hom.app (op V)) s) := by
  have hWaff : IsAffine W.toScheme := hW
  have hVaff : IsAffine V.toScheme := hV
  have hsqW : IsPullback (f ⁻¹ᵁ W).ι (f ∣_ W) f W.ι := (isPullback_morphismRestrict f W).flip
  obtain ⟨hpropW, hdimW, hfibW⟩ := fiber_hypotheses_of_isPullback _ _ f W.ι hsqW hdim hfib
  have hsurjW : Function.Surjective (f ∣_ W).appTop.hom :=
    (surjective_morphismRestrict_appTop_iff f W).mpr
      (surjective_app_of_isLocallySurjective f W hW)
  have hle : V ≤ g ⁻¹ᵁ W := fun z hz => hVW z hz
  have hle2 := preimage_snd_le_preimage_fst f g hVW
  have hres := surjective_appTop_of_isPullback_affine (f ∣_ W) hdimW hfibW hsurjW
    (pullback.snd f g ∣_ V) ((pullback.fst f g).resLE (f ⁻¹ᵁ W)
    (pullback.snd f g ⁻¹ᵁ V) hle2) (g.resLE W V hle)
    (isPullback_resLE_morphismRestrict f g V W hle hle2)
  exact (surjective_morphismRestrict_appTop_iff (pullback.snd f g) V).mp hres

/-! ### The tag -/

/-- **[Stacks, Tag 0E7I].** Let `f : X ⟶ Y` be a proper morphism of schemes such that
`dim(X_y) ≤ 1` and `H¹(X_y, 𝒪_{X_y}) = 0` for every `y ∈ Y`, and suppose `𝒪_Y ⟶ f_* 𝒪_X` is
surjective. Then `𝒪_{Y'} ⟶ f'_* 𝒪_{X'}` is surjective for every base change `f'` of `f`.

Surjectivity is local on the base, and around each point of `Y'` there is an affine open mapping
into an affine open of `Y`; over such a pair the restricted base change is a base change of
`f ∣_ W` along a morphism of affine schemes, which factors as a closed immersion followed by a
flat morphism through the spectrum of a polynomial algebra. The flat half is
`surjective_appTop_of_flat_base`, and the closed-immersion half is
`surjective_appTop_of_closedImmersion_base`, where clause (4) of [Stacks, Tag 0E7H] is
applied to the ideal sheaf of the closed immersion.

Mathlib's `IsProper` is separated, universally closed and locally of finite type; universal
closedness gives quasi-compactness, so this is Stacks' notion of proper. -/
@[stacks 0E7I]
theorem epi_unitToPushforwardUnit_of_baseChange
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsProper f]
    (hdim : ∀ y : Y, topologicalKrullDim (f.fiber y) ≤ ((1 : ℕ) : WithBot ℕ∞))
    (hfib : ∀ y : Y, IsZero (firstCohomologyStructureSheaf (f.fiber y)))
    (hsurj : Epi (Scheme.Modules.unitToPushforwardUnit f))
    {Y' : Scheme.{u}} (g : Y' ⟶ Y) :
    Epi (Scheme.Modules.unitToPushforwardUnit (pullback.snd f g)) := by
  have _ := hsurj
  have _ : Sheaf.IsLocallySurjective f.toRingCatSheafHom := isLocallySurjective_of_module_epi f
  have _ : Sheaf.IsLocallySurjective (pullback.snd f g).toRingCatSheafHom :=
    isLocallySurjective_of_surjective_on_refinement (pullback.snd f g) fun U y hy => by
      obtain ⟨V, W, hV, hW, hVU, hyV, hVW⟩ := exists_affine_le_with_affine_image g U y hy
      exact ⟨V, hVU, hyV,
        surjective_app_pullback_snd_of_affine f hdim hfib g V W hV hW hVW⟩
  exact epi_unitToPushforwardUnit_of_isLocallySurjective (pullback.snd f g)

end

end Stacks.AlgebraicGeometry.TopDegreeBaseChange

