/-!
# Torsors under a group scheme and torsors on the big site

For each of the Zariski, étale, smooth, syntomic and fppf topologies, an action of a group
scheme is a torsor exactly when its functor of points is a torsor on the corresponding big
site over the base.

## Main definitions

* `AlgebraicGeometry.sectionAction` is the action of the points of a group scheme on the points
  of a scheme it acts on.
* `AlgebraicGeometry.IsSiteTorsor` says that the functor of points of an acted-on scheme is a
  torsor for the functor of points of the group scheme, on a given topology over the base.

## Main results

* `AlgebraicGeometry.isTorsorFor_iff_isSiteTorsor` compares the geometric and the
  sheaf-theoretic notion for any subcanonical topology generated by a multiplicative,
  base-change-stable class of morphisms.
* `AlgebraicGeometry.isZariskiTorsor_iff_isSiteTorsor` and its étale, smooth, syntomic and fppf
  counterparts are the five instances of that comparison.

## Implementation notes

The big site is the slice category of schemes over the base with the topology induced from
schemes.  The identifications of the sheaf of groups and of the torsor with the representable
presheaves are natural isomorphisms, and the action is required to agree with the given
group-scheme action on every test scheme.  Subcanonicality of the four smaller topologies is
deduced from subcanonicality of the fppf topology, which is why the comparisons of the
topologies with the fppf topology are proved first.

## References

* [Stacks Project, Tag 049B](https://stacks.math.columbia.edu/tag/049B)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite
open scoped MonoidalCategory

universe u

namespace AlgebraicGeometry

/-- The action of the `T`-points of a group scheme on the `T`-points of a scheme it acts on. -/
noncomputable def sectionAction (S : Scheme.{u}) (G X : Over S) [GrpObj G] [ModObj G X]
    (T : Over S) (g : (yoneda.obj G).obj (op T)) (x : (yoneda.obj X).obj (op T)) :
    (yoneda.obj X).obj (op T) :=
  (show T ⟶ G from g) • (show T ⟶ X from x)

/-- The functor of points of a scheme acted on by a group scheme is a torsor on a topology over
the base, for the functor of points of the group scheme acting by `sectionAction`. -/
def IsSiteTorsor (S : Scheme.{u}) (J : GrothendieckTopology (Over S)) (G X : Over S)
    [GrpObj G] [ModObj G X] : Prop :=
  ∃ (H : SheafOfGroups J) (F : PseudoTorsor H) (eG : H.presheaf ≅ yoneda.obj G)
    (eX : F.presheaf ≅ yoneda.obj X),
      F.IsTorsor ∧
        ∀ (T : Over S) (g : H.presheaf.obj (op T)) (x : F.presheaf.obj (op T)),
          eX.hom.app (op T) (F.act (op T) g x) =
            sectionAction S G X T (eG.hom.app (op T) g) (eX.hom.app (op T) x)

/-- The functor of points of a group scheme, as a sheaf of groups for a subcanonical
topology. -/
noncomputable def representedGroupSheaf (S : Scheme.{u}) (J : GrothendieckTopology (Over S))
    [J.Subcanonical] (G : Over S) [GrpObj G] : SheafOfGroups J where
  presheaf := yoneda.obj G
  isSheaf := (isSheaf_iff_isSheaf_of_type J (yoneda.obj G)).2
    (GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _)
  group U := by
    change Group (unop U ⟶ G)
    exact CategoryTheory.Hom.group
  map_mul := by
    intro U V f g h
    let _ : Group ((yoneda.obj G).obj U) := CategoryTheory.Hom.group
    let _ : Group ((yoneda.obj G).obj V) := CategoryTheory.Hom.group
    change (yoneda.obj G).map f (g * h) =
      (yoneda.obj G).map f g * (yoneda.obj G).map f h
    exact ((CategoryTheory.yonedaGrpObj G).map f).hom.map_mul g h

/-- The functor of points of a scheme carrying a pseudo-torsor action, as a pseudo-torsor for
the functor of points of the group scheme. -/
noncomputable def representedPseudoTorsor (S : Scheme.{u}) (J : GrothendieckTopology (Over S))
    [J.Subcanonical] (G X : Over S) [GrpObj G] [ModObj G X] (hP : IsPseudoTorsor G X) :
    PseudoTorsor (representedGroupSheaf S J G) where
  presheaf := yoneda.obj X
  isSheaf := (isSheaf_iff_isSheaf_of_type J (yoneda.obj X)).2
    (GrothendieckTopology.Subcanonical.isSheaf_of_isRepresentable _)
  act := fun T g x => sectionAction S G X (unop T) g x
  one_act := by
    intro T x
    let _ : Group (unop T ⟶ G) := CategoryTheory.Hom.group
    change (1 : unop T ⟶ G) • (show unop T ⟶ X from x) = x
    exact one_smul _ _
  mul_act := by
    intro T g h x
    let _ : Group (unop T ⟶ G) := CategoryTheory.Hom.group
    let g' : unop T ⟶ G := g
    let h' : unop T ⟶ G := h
    change (g' * h') • (show unop T ⟶ X from x) = g' • (h' • (show unop T ⟶ X from x))
    exact mul_smul g' h' _
  naturality := by
    intro U V f g x
    exact CategoryTheory.ModObj.comp_smul (unop f) g x
  simplyTransitive T _ x y := (CategoryTheory.ModObj.isIso_leftSMul_iff.mp hP) (unop T) x y

/-- A site torsor whose sheaf of groups and whose torsor are the functors of points of a group
scheme and of a scheme it acts on arises from a pseudo-torsor action. -/
theorem isPseudoTorsor_of_siteTorsorData (S : Scheme.{u}) (J : GrothendieckTopology (Over S))
    (G X : Over S) [GrpObj G] [ModObj G X] (H : SheafOfGroups J) (F : PseudoTorsor H)
    (eG : H.presheaf ≅ yoneda.obj G) (eX : F.presheaf ≅ yoneda.obj X)
    (hact : ∀ (T : Over S) (g : H.presheaf.obj (op T)) (x : F.presheaf.obj (op T)),
      eX.hom.app (op T) (F.act (op T) g x) =
        sectionAction S G X T (eG.hom.app (op T) g) (eX.hom.app (op T) x)) :
    IsPseudoTorsor G X := by
  refine CategoryTheory.ModObj.isIso_leftSMul_iff.mpr fun T x y => ?_
  let xF := eX.inv.app (op T) x
  let yF := eX.inv.app (op T) y
  obtain ⟨gF, hgy, huniq⟩ := F.simplyTransitive (op T) ⟨xF⟩ xF yF
  have hx : eX.hom.app (op T) xF = x := by simp [xF]
  have hy : eX.hom.app (op T) yF = y := by simp [yF]
  refine ⟨eG.hom.app (op T) gF, ?_, ?_⟩
  · calc sectionAction S G X T (eG.hom.app (op T) gF) x
        = sectionAction S G X T (eG.hom.app (op T) gF) (eX.hom.app (op T) xF) := by rw [hx]
      _ = eX.hom.app (op T) (F.act (op T) gF xF) := (hact T gF xF).symm
      _ = y := by rw [hgy, hy]
  · intro g h
    let gF' := eG.inv.app (op T) g
    have hg : eG.hom.app (op T) gF' = g := by simp [gF']
    have hval : eX.hom.app (op T) (F.act (op T) gF' xF) = eX.hom.app (op T) yF := by
      calc eX.hom.app (op T) (F.act (op T) gF' xF)
          = sectionAction S G X T (eG.hom.app (op T) gF') (eX.hom.app (op T) xF) :=
            hact T gF' xF
        _ = y := by rwa [hg, hx]
        _ = eX.hom.app (op T) yF := hy.symm
    calc g = eG.hom.app (op T) gF' := hg.symm
      _ = eG.hom.app (op T) gF :=
        congrArg (eG.hom.app (op T)) (huniq gF' ((eX.app (op T)).toEquiv.injective hval))

/-- A torsor trivialized by a covering of a class of morphisms gives a torsor on the
corresponding big site over the base. -/
theorem isSiteTorsor_of_isTorsorFor (S : Scheme.{u}) (P : MorphismProperty Scheme.{u})
    [((Scheme.precoverage P).toGrothendieck).Subcanonical] (G X : Over S) [GrpObj G]
    [ModObj G X] (h : IsTorsorFor S G X (Scheme.precoverage P)) :
    IsSiteTorsor S ((Scheme.precoverage P).toGrothendieck.over S) G X := by
  obtain ⟨hP, I, T, f, hcover, hsections⟩ := h
  let H := representedGroupSheaf S ((Scheme.precoverage P).toGrothendieck.over S) G
  let F := representedPseudoTorsor S ((Scheme.precoverage P).toGrothendieck.over S) G X hP
  let U₀ : Over S := Over.mk (𝟙 S)
  let Ti (i : I) : Over S := Over.mk (f i)
  let R₀ : Sieve U₀ := Sieve.ofArrows Ti fun i => Over.homMk (f i) (Category.comp_id (f i))
  have hR₀ : R₀ ∈ ((Scheme.precoverage P).toGrothendieck.over S) U₀ := by
    rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_ofArrows]
    change Sieve.generate (Presieve.ofArrows T f) ∈ (Scheme.precoverage P).toGrothendieck S
    exact Precoverage.generate_mem_toGrothendieck hcover
  have hFt : F.IsTorsor := by
    intro U
    let q : U ⟶ U₀ := Over.homMk U.hom (Category.comp_id U.hom)
    refine ⟨R₀.pullback q,
      ((Scheme.precoverage P).toGrothendieck.over S).pullback_stable q hR₀, fun V g hg => ?_⟩
    rw [Sieve.pullback_apply] at hg
    obtain ⟨i, a, -⟩ := Sieve.ofArrows.exists hg
    obtain ⟨s⟩ := hsections i
    let xA := ((Over.mapPullbackAdj (f i)).homEquiv (𝟙_ (Over (T i))) X).symm s
    exact ⟨a ≫ (Over.homMk xA.left xA.w : Ti i ⟶ X)⟩
  exact ⟨H, F, Iso.refl _, Iso.refl _, hFt, fun T g x => rfl⟩

/-- A torsor on the big site of a class of morphisms over the base is trivialized by a
covering of that class. -/
theorem isTorsorFor_of_isSiteTorsor (S : Scheme.{u}) (P : MorphismProperty Scheme.{u})
    [P.IsStableUnderBaseChange] [P.IsMultiplicative] (G X : Over S) [GrpObj G]
    [ModObj G X] (h : IsSiteTorsor S ((Scheme.precoverage P).toGrothendieck.over S) G X) :
    IsTorsorFor S G X (Scheme.precoverage P) := by
  obtain ⟨H, F, eG, eX, hFT, hact⟩ := h
  let U₀ : Over S := Over.mk (𝟙 S)
  obtain ⟨R, hR, hRloc⟩ := hFT U₀
  have hbase : (Sieve.overEquiv U₀ R) ∈ (Scheme.precoverage P).toGrothendieck S := by
    rwa [GrothendieckTopology.mem_over_iff] at hR
  obtain ⟨𝒰, h𝒰⟩ := Scheme.exists_cover_of_mem_grothendieckTopology hbase
  refine ⟨isPseudoTorsor_of_siteTorsorData S _ G X H F eG eX hact, ULift.{u + 1, u} 𝒰.I₀,
    fun i => 𝒰.X i.down, fun i => 𝒰.f i.down, ?_, fun i => ?_⟩
  · refine (Scheme.ofArrows_mem_precoverage_iff P).2 ⟨fun x => ?_, fun i => 𝒰.map_prop i.down⟩
    obtain ⟨y, hy⟩ := 𝒰.covers x
    exact ⟨⟨𝒰.idx x⟩, y, hy⟩
  · let Ti : Over S := Over.mk (𝒰.f i.down)
    let qi : Ti ⟶ U₀ := Over.homMk (𝒰.f i.down) (by simp [Ti, U₀])
    obtain ⟨s⟩ := hRloc ((Sieve.overEquiv_iff R (𝒰.f i.down)).1 (h𝒰 _ _ ⟨i.down⟩) : R qi)
    let t : Ti ⟶ X := eX.hom.app (op Ti) s
    exact ⟨(Over.mapPullbackAdj (𝒰.f i.down)).homEquiv (𝟙_ (Over (𝒰.X i.down))) X
      (Over.homMk t.left t.w)⟩

/-- **Stacks Project, Tag 049B.** For a subcanonical topology generated by a multiplicative,
base-change-stable class of morphisms, an action of a group scheme is a torsor trivialized by
a covering of that class exactly when its functor of points is a torsor on the corresponding
big site over the base. -/
theorem isTorsorFor_iff_isSiteTorsor (S : Scheme.{u}) (P : MorphismProperty Scheme.{u})
    [P.IsStableUnderBaseChange] [P.IsMultiplicative]
    [((Scheme.precoverage P).toGrothendieck).Subcanonical] (G X : Over S) [GrpObj G]
    [ModObj G X] :
    IsTorsorFor S G X (Scheme.precoverage P) ↔
      IsSiteTorsor S ((Scheme.precoverage P).toGrothendieck.over S) G X :=
  ⟨isSiteTorsor_of_isTorsorFor S P G X, isTorsorFor_of_isSiteTorsor S P G X⟩

/-! ### Comparison of the smaller topologies with the fppf topology -/

/-- A topology generated by flat morphisms locally of finite presentation is coarser than the
fppf topology. -/
private theorem toGrothendieck_le_fppfTopology {P : MorphismProperty Scheme.{u}}
    (h : P ≤ (@Flat ⊓ @LocallyOfFinitePresentation : MorphismProperty Scheme.{u})) :
    (Scheme.precoverage P).toGrothendieck ≤ Scheme.fppfTopology :=
  Precoverage.toGrothendieck_mono (Scheme.precoverage_mono h)

/-- The étale topology is coarser than the fppf topology. -/
theorem etaleTopology_le_fppfTopology : Scheme.etaleTopology ≤ Scheme.fppfTopology :=
  toGrothendieck_le_fppfTopology fun _ _ _ _ => ⟨inferInstance, inferInstance⟩

/-- The smooth topology is coarser than the fppf topology. -/
theorem smoothTopology_le_fppfTopology :
    (Scheme.precoverage @Smooth).toGrothendieck ≤ Scheme.fppfTopology :=
  toGrothendieck_le_fppfTopology fun _ _ _ _ => ⟨inferInstance, inferInstance⟩

/-- The syntomic topology is coarser than the fppf topology. -/
theorem syntomicTopology_le_fppfTopology :
    (Scheme.precoverage @Syntomic).toGrothendieck ≤ Scheme.fppfTopology :=
  toGrothendieck_le_fppfTopology fun _ _ _ hf => ⟨flat hf, locallyOfFinitePresentation hf⟩

/-- Smooth morphisms are closed under composition and contain the identities. -/
local instance smooth_isMultiplicative :
    MorphismProperty.IsMultiplicative (@Smooth : MorphismProperty Scheme.{u}) where
  id_mem _ := by infer_instance
  comp_mem _ _ hf hg := by
    let _ : Smooth _ := hf
    let _ : Smooth _ := hg
    infer_instance

/-- The identity morphism of a scheme is syntomic. -/
theorem syntomic_id (X : Scheme.{u}) : Syntomic (𝟙 X) := by
  intro x
  rw [syntomicAt_iff]
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, _⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  let U' : X.affineOpens := ⟨U, hU⟩
  have hUU : (U' : X.Opens) ≤ (𝟙 X) ⁻¹ᵁ (U' : X.Opens) := by simp
  refine ⟨U', hxU, U', hUU, ?_⟩
  let e := Scheme.Hom.appLE (𝟙 X) U' U' hUU
  have hId : e = 𝟙 Γ(X, U') := by
    change Scheme.Hom.app (𝟙 X) U' ≫ X.presheaf.map (homOfLE hUU).op = _
    rw [Scheme.Hom.id_app]
    change 𝟙 Γ(X, U') ≫ X.presheaf.map (𝟙 U').op = _
    rw [Category.id_comp]
    exact X.presheaf.map_id _
  let _ : Algebra Γ(X, U') Γ(X, U') := e.hom.toAlgebra
  have hsmooth : Algebra.Smooth Γ(X, U') Γ(X, U') := by
    change e.hom.Smooth
    rw [hId]
    exact RingHom.Smooth.id _
  exact Algebra.Smooth.syntomic _ _

/-- Syntomic morphisms are closed under composition and contain the identities. -/
local instance syntomic_isMultiplicative :
    MorphismProperty.IsMultiplicative (@Syntomic : MorphismProperty Scheme.{u}) where
  id_mem := syntomic_id
  comp_mem _ _ hf hg := syntomic_isStableUnderComposition.comp_mem _ _ hf hg

/-- Morphisms locally of finite presentation are closed under composition and contain the
identities. -/
local instance locallyOfFinitePresentation_isMultiplicative :
    MorphismProperty.IsMultiplicative
      (@LocallyOfFinitePresentation : MorphismProperty Scheme.{u}) where
  id_mem _ := by infer_instance
  comp_mem _ _ hf hg := locallyOfFinitePresentation_comp _ _

/-- Flat morphisms locally of finite presentation are closed under composition and contain the
identities. -/
local instance fppf_isMultiplicative :
    MorphismProperty.IsMultiplicative
      ((@Flat ⊓ @LocallyOfFinitePresentation) : MorphismProperty Scheme.{u}) :=
  MorphismProperty.IsMultiplicative.inf

/-- Syntomic morphisms are stable under base change. -/
alias syntomic_isStableUnderBaseChange' := AlgebraicGeometry.syntomic_isStableUnderBaseChange

/-- Flat morphisms locally of finite presentation are stable under base change. -/
@[ega "IV 1.4.3" "(iii), special case", sga "3 III 0.13" "special case"]
local instance fppf_isStableUnderBaseChange :
    MorphismProperty.IsStableUnderBaseChange
      ((@Flat ⊓ @LocallyOfFinitePresentation) : MorphismProperty Scheme.{u}) :=
  MorphismProperty.IsStableUnderBaseChange.inf

/-- The étale topology is subcanonical. -/
local instance etaleTopology_subcanonical : Scheme.etaleTopology.Subcanonical :=
  GrothendieckTopology.Subcanonical.of_le etaleTopology_le_fppfTopology

/-- The smooth topology is subcanonical. -/
local instance smoothTopology_subcanonical :
    ((Scheme.precoverage @Smooth).toGrothendieck).Subcanonical :=
  GrothendieckTopology.Subcanonical.of_le smoothTopology_le_fppfTopology

/-- The syntomic topology is subcanonical. -/
local instance syntomicTopology_subcanonical :
    ((Scheme.precoverage @Syntomic).toGrothendieck).Subcanonical :=
  GrothendieckTopology.Subcanonical.of_le syntomicTopology_le_fppfTopology

/-- The fppf topology, presented through the class of flat morphisms locally of finite
presentation, is subcanonical. -/
local instance fppfPrecoverage_subcanonical :
    ((Scheme.precoverage (@Flat ⊓ @LocallyOfFinitePresentation)).toGrothendieck).Subcanonical :=
  inferInstanceAs Scheme.fppfTopology.Subcanonical

/-- Being trivialized by a syntomic covering is being trivialized by a covering in the
precoverage of syntomic morphisms. -/
theorem isSyntomicTorsor_iff_isTorsorFor (S : Scheme.{u}) (G X : Over S) [GrpObj G]
    [ModObj G X] :
    IsSyntomicTorsor S G X ↔ IsTorsorFor S G X (Scheme.precoverage @Syntomic) := by
  constructor
  · rintro ⟨hP, I, T, f, ⟨hmap, hsurj⟩, hs⟩
    refine ⟨hP, I, T, f, (Scheme.ofArrows_mem_precoverage_iff _).2 ⟨fun x => ?_, hmap⟩, hs⟩
    have hx : x ∈ ⋃ i, Set.range (f i) := hsurj ▸ Set.mem_univ x
    simpa only [Set.mem_iUnion, Set.mem_range] using hx
  · rintro ⟨hP, I, T, f, hc, hs⟩
    obtain ⟨hcov, hmap⟩ := (Scheme.ofArrows_mem_precoverage_iff _).1 hc
    refine ⟨hP, I, T, f, ⟨hmap, Set.eq_univ_iff_forall.mpr fun x => ?_⟩, hs⟩
    simpa only [Set.mem_iUnion, Set.mem_range] using hcov x

/-- **Stacks Project, Tag 049B.** Zariski torsors under group schemes are exactly the torsors
of their functors of points on the big Zariski site. -/
@[stacks 049B "Zariski"]
theorem isZariskiTorsor_iff_isSiteTorsor (S : Scheme.{u}) (G X : Over S) [GrpObj G]
    [ModObj G X] :
    IsZariskiTorsor S G X ↔ IsSiteTorsor S (Scheme.zariskiTopology.over S) G X :=
  isTorsorFor_iff_isSiteTorsor S @IsOpenImmersion G X

/-- **Stacks Project, Tag 049B.** Étale torsors under group schemes are exactly the torsors of
their functors of points on the big étale site. -/
@[stacks 049B "étale"]
theorem isEtaleTorsor_iff_isSiteTorsor (S : Scheme.{u}) (G X : Over S) [GrpObj G]
    [ModObj G X] :
    IsEtaleTorsor S G X ↔ IsSiteTorsor S (Scheme.etaleTopology.over S) G X :=
  isTorsorFor_iff_isSiteTorsor S @Etale G X

/-- **Stacks Project, Tag 049B.** Smooth torsors under group schemes are exactly the torsors of
their functors of points on the big smooth site. -/
@[stacks 049B "smooth"]
theorem isSmoothTorsor_iff_isSiteTorsor (S : Scheme.{u}) (G X : Over S) [GrpObj G]
    [ModObj G X] :
    IsSmoothTorsor S G X ↔
      IsSiteTorsor S ((Scheme.precoverage @Smooth).toGrothendieck.over S) G X :=
  isTorsorFor_iff_isSiteTorsor S @Smooth G X

/-- **Stacks Project, Tag 049B.** Syntomic torsors under group schemes are exactly the torsors
of their functors of points on the big syntomic site. -/
@[stacks 049B "syntomic"]
theorem isSyntomicTorsor_iff_isSiteTorsor (S : Scheme.{u}) (G X : Over S) [GrpObj G]
    [ModObj G X] :
    IsSyntomicTorsor S G X ↔
      IsSiteTorsor S ((Scheme.precoverage @Syntomic).toGrothendieck.over S) G X :=
  (isSyntomicTorsor_iff_isTorsorFor S G X).trans (isTorsorFor_iff_isSiteTorsor S @Syntomic G X)

/-- **Stacks Project, Tag 049B.** Fppf torsors under group schemes are exactly the torsors of
their functors of points on the big fppf site. -/
@[stacks 049B "fppf"]
theorem isFppfTorsor_iff_isSiteTorsor (S : Scheme.{u}) (G X : Over S) [GrpObj G]
    [ModObj G X] :
    IsFppfTorsor S G X ↔ IsSiteTorsor S (Scheme.fppfTopology.over S) G X :=
  isTorsorFor_iff_isSiteTorsor S (@Flat ⊓ @LocallyOfFinitePresentation) G X

end AlgebraicGeometry

end
