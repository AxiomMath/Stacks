module

public import StacksFrontier.AlgebraicGeometry.Groupoids.InvariantSubscheme.Basic
public import StacksFrontier.AlgebraicGeometry.Groupoids.Stabilizer.AffineBasis
public import StacksFrontier.AlgebraicGeometry.Scheme.CarrierPrimeSpectrum
public import StacksFrontier.RingTheory.Etale.RetractionKernelPushout

/-!
# An invariant function cuts out an invariant closed set

Let `G` be a groupoid scheme with affine object and arrow schemes, and let `a` be a global
function on the object scheme whose pullbacks along the source and the target maps agree,
`s^♯ a = t^♯ a`. Then the zero locus of `a` — the set of points of the object scheme whose prime
ideal contains `a` — is an **invariant** set: an arrow starting in it ends in it.

Invariance of a subset of the object scheme is a statement about points of the arrow scheme; here it
is reduced to the **single ring equation** `s^♯ a = t^♯ a`, because a point of an affine scheme is a
prime of its ring of global functions and the source and target maps act on those primes by
contraction.

That is the form in which invariance is *descended* in [Stacks Project, Tag 0DT9]: the sheet of
the section produced over a strictly henselian base is the zero locus of an idempotent, its
invariance is the one equation above, and an equation between two elements of a filtered colimit
of étale algebras holds at a finite stage.

## Main results

* `AlgebraicGeometry.GroupoidScheme.isInvariantSet_zeroLocus_of_sourceMap_eq_targetMap`: **the
  zero locus of a function with equal source and target pullbacks is invariant.**
* `AlgebraicGeometry.GroupoidScheme.isInvariantSet_setOf_span_singleton_le`: the same stated for
  the points whose prime contains the ideal generated by the function, which is how the range of
  a section with that kernel is described by
  `AlgebraicGeometry.exists_section_of_ker_eq_span_isIdempotentElem`.
* `AlgebraicGeometry.GroupoidScheme.sourceMap_eq_targetMap_of_isInvariantSet`: **the converse for
  an idempotent** — the zero locus of an idempotent is invariant only if its source and target
  pullbacks agree. This is the direction that *produces* the equation to be descended: invariance
  of the sheet is proved geometrically over the strictly henselian base, and the equation is what
  descends to a finite étale stage.

## References

* [Stacks Project, Tag 03BC](https://stacks.math.columbia.edu/tag/03BC)
* [Stacks Project, Tag 0DT9](https://stacks.math.columbia.edu/tag/0DT9)

## Tags

groupoid scheme, invariant set, zero locus, idempotent, source, target
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Stacks.Groupoids

noncomputable section

universe u

namespace AlgebraicGeometry.GroupoidScheme

variable {S : Scheme.{u}} (G : GroupoidScheme S) [IsAffine G.objects.left]
  [IsAffine G.arrows.left]

/-- A point of the object scheme is in the zero locus of `a` after applying the source map
exactly when `s^♯ a` lies in the prime of the given point of the arrow scheme. -/
theorem mem_asIdeal_base_source_iff (a : Γ(G.objects.left, ⊤)) (r : G.arrows.left) :
    a ∈ (G.objects.left.carrierEquivPrimeSpectrum (G.source.left.base r)).asIdeal ↔
      sourceMap G a ∈ (G.arrows.left.carrierEquivPrimeSpectrum r).asIdeal := by
  rw [Scheme.carrierEquivPrimeSpectrum_naturality G.source.left r]
  exact Iff.rfl

/-- A point of the object scheme is in the zero locus of `a` after applying the target map
exactly when `t^♯ a` lies in the prime of the given point of the arrow scheme. -/
theorem mem_asIdeal_base_target_iff (a : Γ(G.objects.left, ⊤)) (r : G.arrows.left) :
    a ∈ (G.objects.left.carrierEquivPrimeSpectrum (G.target.left.base r)).asIdeal ↔
      targetMap G a ∈ (G.arrows.left.carrierEquivPrimeSpectrum r).asIdeal := by
  rw [Scheme.carrierEquivPrimeSpectrum_naturality G.target.left r]
  exact Iff.rfl

/-- **The zero locus of a global function whose source and target pullbacks agree is an
invariant set.** An arrow lies over the zero locus through its source exactly when `s^♯ a` is in
its prime, and over it through its target exactly when `t^♯ a` is, and the two conditions are the
same equation. -/
theorem isInvariantSet_zeroLocus_of_sourceMap_eq_targetMap (a : Γ(G.objects.left, ⊤))
    (ha : sourceMap G a = targetMap G a) :
    IsInvariantSet G
      {y : G.objects.left | a ∈ (G.objects.left.carrierEquivPrimeSpectrum y).asIdeal} := by
  intro r hr
  rw [Set.mem_ofPred_eq, mem_asIdeal_base_target_iff G a r, ← ha]
  exact (mem_asIdeal_base_source_iff G a r).mp hr

/-- **The set of points whose prime contains the ideal generated by a global function with equal
source and target pullbacks is invariant.** This is the shape in which the range of a section of
an affine morphism is given: it is the set of points whose prime contains the kernel of the
corresponding retraction, and that kernel is generated by a single element. -/
theorem isInvariantSet_setOf_span_singleton_le (a : Γ(G.objects.left, ⊤))
    (ha : sourceMap G a = targetMap G a) :
    IsInvariantSet G {y : G.objects.left |
      Ideal.span {a} ≤ (G.objects.left.carrierEquivPrimeSpectrum y).asIdeal} := by
  have hset : {y : G.objects.left |
        Ideal.span {a} ≤ (G.objects.left.carrierEquivPrimeSpectrum y).asIdeal} =
      {y : G.objects.left | a ∈ (G.objects.left.carrierEquivPrimeSpectrum y).asIdeal} := by
    ext y
    simp only [Set.mem_ofPred_eq, Ideal.span_singleton_le_iff_mem]
  rw [hset]
  exact isInvariantSet_zeroLocus_of_sourceMap_eq_targetMap G a ha

/-- **An idempotent whose zero locus is invariant has equal source and target pullbacks.** The
two pullbacks are idempotents of the arrow ring, invariance says that a point of the arrow scheme
contains the one exactly when it contains the other, and an idempotent is determined by the closed
set it cuts out (`IsIdempotentElem.eq_of_zeroLocus_singleton_eq`).

Together with `AlgebraicGeometry.GroupoidScheme.isInvariantSet_zeroLocus_of_sourceMap_eq_targetMap`
this makes invariance of the sheet cut out by an idempotent *equivalent* to a single ring
equation, which is what a filtered-colimit descent can carry. -/
theorem sourceMap_eq_targetMap_of_isInvariantSet (a : Γ(G.objects.left, ⊤))
    (ha : IsIdempotentElem a)
    (h : IsInvariantSet G
      {y : G.objects.left | a ∈ (G.objects.left.carrierEquivPrimeSpectrum y).asIdeal}) :
    sourceMap G a = targetMap G a := by
  have hs : IsIdempotentElem (sourceMap G a) := ha.map (sourceMap G)
  have ht : IsIdempotentElem (targetMap G a) := ha.map (targetMap G)
  have hiff : ∀ r : G.arrows.left,
      a ∈ (G.objects.left.carrierEquivPrimeSpectrum (G.source.left.base r)).asIdeal ↔
        a ∈ (G.objects.left.carrierEquivPrimeSpectrum (G.target.left.base r)).asIdeal := by
    intro r
    refine ⟨fun hr => h r hr, fun hr => ?_⟩
    have hsource : G.source.left.base (G.inverse.left.base r) = G.target.left.base r :=
      congrArg (fun k : G.arrows.left ⟶ G.objects.left => k.base r)
        (by simpa only [Over.comp_left] using congrArg Over.Hom.left G.source_inverse)
    have htarget : G.target.left.base (G.inverse.left.base r) = G.source.left.base r :=
      congrArg (fun k : G.arrows.left ⟶ G.objects.left => k.base r)
        (by simpa only [Over.comp_left] using congrArg Over.Hom.left G.target_inverse)
    have := h (G.inverse.left.base r) (by rw [hsource]; exact hr)
    rwa [htarget] at this
  refine hs.eq_of_zeroLocus_singleton_eq ht (Set.ext fun q => ?_)
  have hq := hiff (G.arrows.left.carrierEquivPrimeSpectrum.symm q)
  rw [mem_asIdeal_base_source_iff, mem_asIdeal_base_target_iff,
    Equiv.apply_symm_apply] at hq
  simpa only [PrimeSpectrum.mem_zeroLocus, Set.singleton_subset_iff, SetLike.mem_coe] using hq

end AlgebraicGeometry.GroupoidScheme

end

end
