open CategoryTheory CategoryTheory.Limits IsLocalRing Stacks.Groupoids

universe u

namespace Stacks.CohenMacaulay.ParameterChoice

/-- **A parameter cutting a Cohen-Macaulay local ring down by one.** Let `C` be a Noetherian
local Cohen-Macaulay ring, let `t : A →+* C` be a ring map carrying an ideal `I` of `A` into the
maximal ideal of `C`, and suppose the extension of `I` cuts the dimension of `C` down strictly.
Then some `f ∈ I` has `t f` a nonzerodivisor on `C`, with `C ⧸ (t f)` again a Cohen-Macaulay
local ring and of dimension one less than that of `C`.

This is the step Stacks 0461 takes after choosing its affine charts: there `C` is the local ring
of the fibre `F_u` at `e(u)`, `t` is the target map, and `I` is the ideal of the point `u`. The
choice of `f` is `exists_mem_isSMulRegular_map`, and the two statements about the quotient are
Stacks 02JN at the one-element sequence `[t f]`. The dimension drop is stated additively; see
the module docstring. -/
public theorem exists_mem_isSMulRegular_cohenMacaulay_quotient {A C : Type*} [CommRing A]
    [CommRing C] [IsNoetherianRing C] [IsLocalRing C]
    (hC : Module.IsMaximalCohenMacaulay C C) (t : A →+* C) (I : Ideal A)
    (hI : ∀ a ∈ I, t a ∈ maximalIdeal C)
    (hdim : ringKrullDim (C ⧸ Ideal.map t I) < ringKrullDim C) :
    ∃ f ∈ I, IsSMulRegular C (t f) ∧
      ∃ _ : IsLocalRing (C ⧸ Ideal.span {t f}),
        IsCohenMacaulayLocalRing (C ⧸ Ideal.span {t f}) ∧
          ringKrullDim (C ⧸ Ideal.span {t f}) + 1 = ringKrullDim C := by
  obtain ⟨f, hfI, hf⟩ := exists_mem_isSMulRegular_map hC t I hdim
  have hmem : ∀ r ∈ [t f], r ∈ maximalIdeal C := by
    intro r hr
    simpa [List.mem_singleton.mp hr] using hI f hfI
  -- A nonzerodivisor lying in the maximal ideal is a regular sequence of length one.
  have hreg : RingTheory.Sequence.IsRegular C [t f] := by
    refine RingTheory.Sequence.IsRegular.of_isWeaklyRegular_of_mem_maximalIdeal C hmem ?_
    rw [RingTheory.Sequence.isWeaklyRegular_cons_iff]
    exact ⟨hf, RingTheory.Sequence.IsWeaklyRegular.nil C _⟩
  obtain ⟨-, hquot⟩ :=
    (hC.isRegular_iff_ringKrullDim_add_length_eq_ringKrullDim [t f] hmem).2 hreg
  obtain ⟨hloc, hCM, hdrop⟩ := hquot 1 (le_refl _)
  have hloc' : IsLocalRing (C ⧸ Ideal.ofList [t f]) := hloc
  -- Stacks 02JN answers for `Ideal.ofList [t f]`; transport onto `Ideal.span {t f}`.
  let e : (C ⧸ Ideal.ofList [t f]) ≃+* (C ⧸ Ideal.span {t f}) :=
    Ideal.quotEquivOfEq (Ideal.ofList_singleton (t f))
  have hnt : Nontrivial (C ⧸ Ideal.span {t f}) :=
    Ideal.Quotient.nontrivial_iff.mpr fun htop =>
      (maximalIdeal.isMaximal C).ne_top <|
        top_le_iff.mp <| htop ▸ Ideal.span_le.mpr (by simpa using hI f hfI)
  have hlocSpan : IsLocalRing (C ⧸ Ideal.span {t f}) :=
    IsLocalRing.of_surjective' (e : (C ⧸ Ideal.ofList [t f]) →+* _) e.surjective
  refine ⟨f, hfI, hf, hlocSpan, ?_, ?_⟩
  · exact (isCohenMacaulayLocalRing_iff_of_ringEquiv e).mp
      ((isCohenMacaulayLocalRing_iff_isMaximalCohenMacaulay _).mpr hCM)
  · rw [← ringKrullDim_eq_of_ringEquiv e]
    exact_mod_cast hdrop

end Stacks.CohenMacaulay.ParameterChoice

section FibreRegular

open scoped Pointwise

/-- A ring element is a nonzerodivisor as soon as its image under a ring isomorphism is. -/
private lemma isSMulRegular_of_ringEquiv {M N : Type*} [CommRing M] [CommRing N] (e : M ≃+* N)
    {c : M} (h : IsSMulRegular N (e c)) : IsSMulRegular M c := by
  intro p q hpq
  refine e.injective (h ?_)
  simpa [smul_eq_mul, ← map_mul] using congrArg e hpq

/-- **Stacks 046Z with both quotients taken by ideals.** Let `R → S` be a local homomorphism of
local rings which is essentially of finite presentation and makes `S` flat over `R`. If `a ∈ S`
is a nonzerodivisor on the fibre `S ⧸ 𝔪S`, then `a` is a nonzerodivisor on `S` and `S ⧸ (a)` is
again flat over `R`.

This is the `M = S` case of
`Module.Flat.isSMulRegular_and_flat_quotient_smul_of_isSMulRegular_maximalIdeal`, restated with
the fibre and the quotient written as quotients of the ring by ideals rather than as quotients of
the module `S` by `I • ⊤`. The two agree because extending an ideal to the top submodule of the
ring returns the ideal, and that identification is an equality of submodules, so the hypothesis
and the conclusion are transported along `Submodule.quotEquivOfEq` rather than compared as
types. -/
@[stacks 046Z "the case M := S, spelled with ring quotients by ideals",
  ega "IV 11.3.8" "(c) ⇒ (a), special case"]
public theorem Module.Flat.isSMulRegular_and_flat_quotient_span_of_isSMulRegular_quotient
    {R S : Type*} [CommRing R] [CommRing S] [IsLocalRing R] [IsLocalRing S] [Algebra R S]
    [IsLocalHom (algebraMap R S)] [Module.Flat R S]
    (hS : (algebraMap R S).EssentiallyOfFinitePresentation) {a : S}
    (ha : IsSMulRegular (S ⧸ Ideal.map (algebraMap R S) (maximalIdeal R)) a) :
    IsSMulRegular S a ∧ Module.Flat R (S ⧸ Ideal.span {a}) := by
  obtain ⟨h1, h2⟩ :=
    Module.Flat.isSMulRegular_and_flat_quotient_smul_of_isSMulRegular_maximalIdeal
      (M := S) hS (f := a)
      (isSMulRegular_of_linearEquiv
        (Submodule.quotEquivOfEq (Ideal.map (algebraMap R S) (maximalIdeal R))
          (Ideal.map (algebraMap R S) (maximalIdeal R) • (⊤ : Submodule S S))
          (Ideal.smul_top_eq_self (Ideal.map (algebraMap R S) (maximalIdeal R))).symm) ha)
  exact ⟨h1, Ideal.smul_top_eq_self (Ideal.span {a}) ▸ h2⟩

namespace AlgebraicGeometry

/-- **Stacks 046Z at a point of a morphism of schemes.** Let `f : X ⟶ Y` be a morphism of
schemes and `x` a point of `X` at which the local ring of `X` is flat over the local ring of `Y`
and essentially of finite presentation over it. If `a ∈ 𝒪_{X, x}` has nonzerodivisor image in the
local ring of the scheme-theoretic fibre `f⁻¹(f x)` at `x`, then `a` is a nonzerodivisor in
`𝒪_{X, x}` and `𝒪_{X, x} ⧸ (a)` is flat over `𝒪_{Y, f x}`.

The local ring of the fibre is reached through `quotientStalkEquivFiberStalk`, which presents it
as `𝒪_{X, x}` modulo the extension of the maximal ideal of `𝒪_{Y, f x}`; that is the ideal
appearing in the fibre hypothesis of 046Z, so the hypothesis here is the fibre hypothesis of
046Z read through that isomorphism. This is the form in which clause (4) of Stacks 0461 needs
046Z: there `f` is the source map of the groupoid, `x` the identity arrow at `u`, and `a` the
image under the target map of the parameter chosen by
`Stacks.CohenMacaulay.ParameterChoice.exists_mem_isSMulRegular_cohenMacaulay_quotient`. -/
public theorem isSMulRegular_stalk_and_flat_quotient_of_isSMulRegular_fiberStalk
    {X Y : Scheme.{u}} (f : X ⟶ Y) (x : X) :
    letI : Algebra (Y.presheaf.stalk (f x)) (X.presheaf.stalk x) :=
      (f.stalkMap x).hom.toAlgebra
    ∀ (_ : Module.Flat (Y.presheaf.stalk (f x)) (X.presheaf.stalk x))
      (_ : (f.stalkMap x).hom.EssentiallyOfFinitePresentation)
      (a : X.presheaf.stalk x)
      (_ : IsSMulRegular ((f.fiber (f x)).presheaf.stalk (f.asFiber x))
        (quotientStalkEquivFiberStalk f x (Ideal.Quotient.mk _ a))),
      IsSMulRegular (X.presheaf.stalk x) a ∧
        Module.Flat (Y.presheaf.stalk (f x)) (X.presheaf.stalk x ⧸ Ideal.span {a}) := by
  intro hflat hfp a ha
  let : Algebra (Y.presheaf.stalk (f x)) (X.presheaf.stalk x) :=
    (f.stalkMap x).hom.toAlgebra
  have : Module.Flat (Y.presheaf.stalk (f x)) (X.presheaf.stalk x) := hflat
  have : IsLocalHom (algebraMap (Y.presheaf.stalk (f x)) (X.presheaf.stalk x)) :=
    inferInstanceAs (IsLocalHom (f.stalkMap x).hom)
  exact Module.Flat.isSMulRegular_and_flat_quotient_span_of_isSMulRegular_quotient hfp
    (isSMulRegular_of_ringEquiv (quotientStalkEquivFiberStalk f x) ha)

end AlgebraicGeometry

end FibreRegular

namespace AlgebraicGeometry.GroupoidScheme

/-- **Stacks 0461, clauses (1), (2) and (3).** At a finite type point `u` of the object scheme of
a groupoid scheme there are an affine scheme `U'` over the base and a morphism `g : U' ⟶ U` which
is an immersion locally of finite presentation, together with a point of `U'` mapping to `u`.

These three clauses of the slicing lemma hold for any cut of an affine chart around `u` by a
section vanishing there, so they need none of the lemma's Cohen-Macaulayness or dimension
hypotheses; the content of the lemma is the choice of the section, which enters only in its
clauses (4) and (5). See the module docstring. -/
public theorem exists_affine_slice_of_isFiniteTypePoint {S : Scheme.{u}} (G : GroupoidScheme S)
    {u : G.objects.left} (hu : IsFiniteTypePoint u) :
    ∃ (U' : Over S) (g : U' ⟶ G.objects) (u' : U'.left),
      IsAffine U'.left ∧ IsImmersion g.left ∧ LocallyOfFinitePresentation g.left ∧
        g.left u' = u := by
  obtain ⟨A, B, huA, -, -, -, -⟩ := exists_affineOpens_of_isFiniteTypePoint G hu
  exact exists_slice_of_mem_primeIdealOf G A huA 0 (Submodule.zero_mem _)

/-- **The parameter choice of Stacks 0461, with its dimension hypothesis supplied
geometrically.** Let `u` be a finite type point of the object scheme of a groupoid scheme whose
source and target are locally of finite type, write `F_u` for the source fibre at `u` and `C` for
the local ring of `F_u` at the identity arrow, and suppose `C` is Cohen-Macaulay and the
stabilizer fibre at `u` has dimension strictly smaller than `C`. Then some element of the maximal
ideal of `𝒪_{U, u}` has image in `C` a nonzerodivisor cutting `C` down to a Cohen-Macaulay local
ring of dimension one less.

This is the engine of this file applied to the target map on the source fibre, with `I` the
maximal ideal of `𝒪_{U, u}`. The engine's hypothesis on the dimension of
`C ⧸ Ideal.map t I` is exactly the strict inequality assumed here, because that quotient is the
local ring of the arrow scheme of the restriction of the groupoid to the residue field at `u`,
whose dimension is the dimension of the stabilizer fibre; that identification is
`ringKrullDim_quotient_stalk_sourceFiber_eq_stabilizerFiber` and it is what makes the engine
applicable at all. The hypothesis on `t` carrying the maximal ideal into the maximal ideal holds
because the map of local rings induced by a morphism of schemes is local. -/
public theorem exists_mem_maximalIdeal_isSMulRegular_cohenMacaulay_quotient
    {S : Scheme.{u}} (G : GroupoidScheme S) [LocallyOfFiniteType G.source.left]
    [LocallyOfFiniteType G.target.left] (u : G.objects.left) (hu : IsFiniteTypePoint u)
    [IsNoetherianRing ((G.source.left.fiber u).presheaf.stalk (sourceFiberIdentity G u))]
    (hCM : Module.IsMaximalCohenMacaulay
      ((G.source.left.fiber u).presheaf.stalk (sourceFiberIdentity G u))
      ((G.source.left.fiber u).presheaf.stalk (sourceFiberIdentity G u)))
    (hlt : topologicalKrullDim ((stabilizer G).hom.fiber u) <
      ringKrullDim ((G.source.left.fiber u).presheaf.stalk (sourceFiberIdentity G u))) :
    ∃ f ∈ maximalIdeal (G.objects.left.presheaf.stalk u),
      IsSMulRegular ((G.source.left.fiber u).presheaf.stalk (sourceFiberIdentity G u))
          ((targetSourceFiberStalkMap G u).hom f) ∧
        ∃ _ : IsLocalRing ((G.source.left.fiber u).presheaf.stalk (sourceFiberIdentity G u) ⧸
            Ideal.span {(targetSourceFiberStalkMap G u).hom f}),
          IsCohenMacaulayLocalRing
              ((G.source.left.fiber u).presheaf.stalk (sourceFiberIdentity G u) ⧸
                Ideal.span {(targetSourceFiberStalkMap G u).hom f}) ∧
            ringKrullDim ((G.source.left.fiber u).presheaf.stalk (sourceFiberIdentity G u) ⧸
                Ideal.span {(targetSourceFiberStalkMap G u).hom f}) + 1 =
              ringKrullDim
                ((G.source.left.fiber u).presheaf.stalk (sourceFiberIdentity G u)) := by
  refine Stacks.CohenMacaulay.ParameterChoice.exists_mem_isSMulRegular_cohenMacaulay_quotient
    hCM (targetSourceFiberStalkMap G u).hom
    (maximalIdeal (G.objects.left.presheaf.stalk u)) (fun a ha => ?_) ?_
  · exact map_nonunit _ a ha
  · rw [ringKrullDim_quotient_stalk_sourceFiber_eq_stabilizerFiber G u hu]
    exact hlt

end AlgebraicGeometry.GroupoidScheme

namespace AlgebraicGeometry.SliceSituation

/-- The target of the identity arrow at a point of the object scheme is that point. -/
private theorem target_identity_apply {S : Scheme.{u}} (G : GroupoidScheme S)
    (u : G.objects.left) : G.target.left (G.identity.left u) = u := by
  simpa using congrArg (fun f : G.objects.left ⟶ G.objects.left => f u)
    (identity_left_comp_target_left G)

/-- The point `(u', e(u))` of `U' ×_{g,U,t} R`, pinned by its two projections.

The scheme is a fibre product, so the point is not available as a pair; it is produced from the
surjectivity of the comparison of a fibre product of schemes with the fibre product of the
underlying spaces, and the two projection equations are all that is known about it. -/
public structure IdentityArrowPoint (D : SliceSituation) where
  /-- The point of `U' ×_{g,U,t} R` itself. -/
  point : D.arrowSource.left
  /-- Its projection to `U'` is `u'`. -/
  point_fst : (pullback.fst D.g D.groupoid.target).left point = D.u'
  /-- Its projection to `R` is the identity arrow at `u`. -/
  point_snd :
    (pullback.snd D.g D.groupoid.target).left point = D.groupoid.identity.left D.u

/-- **The point `(u', e(u))` of `U' ×_{g,U,t} R`.** The restricting morphism carries `u'` to `u`
and the target map carries the identity arrow at `u` to `u`, so the two points are compatible
over the object scheme and the fibre product has a point above them.

It is produced from the surjectivity of the comparison map of a fibre square of schemes onto the
fibre product of the underlying spaces. -/
public noncomputable def identityArrowPoint (D : SliceSituation) : IdentityArrowPoint D :=
  Classical.choice (by
    have hsq : IsPullback (pullback.fst D.g D.groupoid.target).left
        (pullback.snd D.g D.groupoid.target).left D.g.left D.groupoid.target.left :=
      (IsPullback.of_hasPullback _ _).map (Over.forget D.S)
    obtain ⟨p, hp₁, hp₂⟩ := Scheme.exists_preimage_of_isPullback hsq D.u'
      (D.groupoid.identity.left D.u)
      (by rw [D.mapsTo, target_identity_apply])
    exact ⟨p, hp₁, hp₂⟩)

/-- The morphism `h = s ∘ pr₂ : U' ×_{g,U,t} R ⟶ U` carries `(u', e(u))` to `u`, because the
source of the identity arrow at `u` is `u`. -/
public theorem sourceMap_point (D : SliceSituation) (P : IdentityArrowPoint D) :
    D.sourceMap.left P.point = D.u :=
  (congrArg D.groupoid.source.left P.point_snd).trans (source_identity_apply D.groupoid D.u)

/-- The point `(u', e(u))` viewed as a point of the scheme-theoretic fibre `h⁻¹(u)`.

This is `Scheme.Hom.asFiber` transported along `sourceMap_point`; the transport is needed
because `asFiber` lands in the fibre over the image of the point rather than over `u` itself. -/
public noncomputable def identityArrowFiberPoint (D : SliceSituation)
    (P : IdentityArrowPoint D) : D.sourceMap.left.fiber D.u :=
  sourceMap_point D P ▸ D.sourceMap.left.asFiber P.point

/-- The fibre point determined by `(u', e(u))` lies over `(u', e(u))`. This equation is what
pins it: it is the shape in which `quotientStalkEquivFiberStalkAtPoint` takes a point of a
fibre. -/
@[simp]
public theorem fiberι_identityArrowFiberPoint (D : SliceSituation)
    (P : IdentityArrowPoint D) :
    D.sourceMap.left.fiberι D.u (identityArrowFiberPoint D P) = P.point :=
  fiberι_cast_asFiber _ _ (sourceMap_point D P)

/-- A point of `h⁻¹(u)` lying over `(u', e(u))` is the fibre point determined by it. -/
public theorem identityArrowFiberPoint_injective_eq (D : SliceSituation)
    (P : IdentityArrowPoint D) (z : D.sourceMap.left.fiber D.u)
    (hz : D.sourceMap.left.fiberι D.u z = P.point) :
    z = identityArrowFiberPoint D P :=
  (D.sourceMap.left.fiberι D.u).isEmbedding.injective
    (hz.trans (fiberι_identityArrowFiberPoint D P).symm)

end AlgebraicGeometry.SliceSituation

end
