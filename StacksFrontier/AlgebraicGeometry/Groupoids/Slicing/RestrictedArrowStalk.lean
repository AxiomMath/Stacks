module

public import StacksFrontier.AlgebraicGeometry.Groupoids.Slicing.SliceChart
public import StacksFrontier.AlgebraicGeometry.Groupoids.Slicing.SourceFiberIdentity
public import StacksFrontier.AlgebraicGeometry.Morphisms.CohenMacaulay.Defs
public import StacksFrontier.AlgebraicGeometry.Morphisms.CohenMacaulay.FibreStalk

/-!
# The local ring of a restricted arrow scheme at the identity arrow

Fix a groupoid scheme `(U, R, s, t, c, e, i)` over a base and a point `u` of `U`. Write
`F_u = s⁻¹(u)` for the scheme-theoretic source fibre and `R''` for the arrow scheme of the
restriction of the groupoid along `Spec(κ(u)) ⟶ U`.

This file identifies the local ring of `R''` at the identity arrow with a quotient of the local
ring of `F_u` at the identity arrow. The identification has two steps, each recorded on its own.

Geometrically, `R''` is the fibre over `u` of the target map read on `F_u`: an arrow of the
restricted groupoid is an arrow of `R` whose source and target both lie over `u`, so after
cutting out the arrows with source `u` — which is exactly `F_u` — what remains to impose is that
the target lies over `u` as well. Both descriptions are iterated fibre products of the same
cospan taken in a different order, and `restrictedArrowsFiberComparison` is the resulting
isomorphism, recorded with its projection to `R` so that it can be evaluated at the identity
arrow.

Ring-theoretically, the local ring of a scheme-theoretic fibre is the quotient of the local ring
of the source by the extended maximal ideal of the local ring of the target; this is
`quotientStalkEquivFiberStalk`, which is applied here to the target map read on `F_u`.

Composing the two gives `sourceFiberQuotientEquivRestrictedArrowStalk`: the local ring of `R''`
at the identity arrow is `𝒪_{F_u, e(u)}` modulo the ideal generated by the image of the maximal
ideal of `𝒪_{U, u}` under the target map. Combined with
`ringKrullDim_stalk_restrictedArrows_eq_stabilizerFiber` this computes the dimension of that
quotient as the dimension of the stabilizer fibre `G_u`, which is the shape in which the
dimension hypothesis of the parameter-choice engine of `SliceDimensionDrop.lean` is supplied.

## Main definitions

* `AlgebraicGeometry.quotientStalkEquivFiberStalkAtPoint` is the quotient-to-fibre equivalence of
  local rings, read at a point of the fibre given by its image in the source.
* `AlgebraicGeometry.stalkRingEquivOfSchemeIso` transports a local ring along an isomorphism of
  schemes.
* `AlgebraicGeometry.GroupoidScheme.residueChart` is the morphism `Spec(κ(u)) ⟶ U` along which
  the groupoid is restricted, viewed over the base.
* `AlgebraicGeometry.GroupoidScheme.targetOnSourceFiber` is the target map read on `F_u`.
* `AlgebraicGeometry.GroupoidScheme.targetSourceFiberStalkMap` is the induced map of local rings
  `𝒪_{U, u} ⟶ 𝒪_{F_u, e(u)}`.
* `AlgebraicGeometry.GroupoidScheme.RestrictedArrowsFiberComparison` records the isomorphism of
  `R''` with the fibre of the target map on `F_u`, together with its projection to `R`.
* `AlgebraicGeometry.GroupoidScheme.restrictedIdentityArrow` is the identity arrow of the
  restriction, read in the iterated fibre product presenting `R''`.
* `AlgebraicGeometry.pullbackFstSymmIso` and `AlgebraicGeometry.sourceTargetDoubleFiberIso`
  reorder an iterated fibre product of schemes.
* `AlgebraicGeometry.restrictedArrows_iso_sourceFiberTargetCut` is the bare isomorphism of `R''`
  with the fibre of the target map on `F_u` over the image of the identity arrow, assembled from
  those two.

## Main results

* `AlgebraicGeometry.GroupoidScheme.restrictedArrowsFiberComparison`: the geometric
  identification.
* `AlgebraicGeometry.restrictedStabilizer_fiber_dimension` and
  `AlgebraicGeometry.restrictedArrows_dimension_eq_stabilizerFiber`: the stabilizer of the
  restriction, and its arrow scheme, have the dimension of the stabilizer fibre `G_u`.
* `AlgebraicGeometry.GroupoidScheme.sourceFiberQuotientEquivRestrictedArrowStalk`: the local ring
  of `R''` at the identity arrow is `𝒪_{F_u, e(u)}` modulo the extended maximal ideal of
  `𝒪_{U, u}`.
* `AlgebraicGeometry.GroupoidScheme.ringKrullDim_quotient_stalk_sourceFiber_eq_stabilizerFiber`:
  that quotient has the dimension of the stabilizer fibre at `u`.

## Implementation notes

The restriction is taken along `Scheme.fromSpecResidueField` viewed as a morphism over the base
through `Over.homMk`, which is the shape used by `SliceChart.lean`; `residueChart` names exactly
that morphism, so the statements below are directly comparable with the ones there.

The target of the target map at the identity arrow is `u` only up to a propositional equality of
points, so the map of local rings `targetSourceFiberStalkMap` is the stalk map of
`targetOnSourceFiber` precomposed with the transport of local rings along that equality.  For the
same reason the point of the fibre at which the quotient-to-fibre equivalence is read is not
`Scheme.Hom.asFiber` on the nose; `quotientStalkEquivFiberStalkAtPoint` therefore takes that
point as data, pinned by its image in the source, which is where the comparison isomorphism
delivers it.

The identity arrow of the restriction is only available through the universal property packaged
in `AlgebraicGeometry.GroupoidScheme.Restriction`, so `restrictedIdentityArrow` reads it off the
identity section of the chosen restricted groupoid, transported along `arrows_eq`; its image in
`R` is computed from the identity compatibility of the canonical morphism of groupoid schemes.

## References

* [Stacks Project, Tag 04MQ](https://stacks.math.columbia.edu/tag/04MQ)
* [Stacks Project, Tag 0461](https://stacks.math.columbia.edu/tag/0461)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Stacks.Groupoids

universe u

namespace AlgebraicGeometry

/-- The local ring of the fibre of `f` at a point of that fibre lying over `x`, as the quotient
of the local ring at `x` by the extended maximal ideal of the local ring at the image of `x`.

The point of the fibre is taken as data, pinned by its image in the source; the base point is
likewise given by an equality rather than as the image of `x`. -/
public noncomputable def quotientStalkEquivFiberStalkAtPoint {X Y : Scheme.{u}} (f : X ⟶ Y)
    (x : X) {y : Y} (h : f x = y) (z : f.fiber y) (hz : f.fiberι y z = x) :
    ((X.presheaf.stalk x) ⧸
        Ideal.map ((Y.presheaf.stalkCongr (.of_eq h.symm)).hom ≫ f.stalkMap x).hom
          (IsLocalRing.maximalIdeal (Y.presheaf.stalk y))) ≃+*
      ((f.fiber y).presheaf.stalk z) := by
  cases h
  have hz' : z = f.asFiber x := (f.fiberι _).isEmbedding.injective (by simpa using hz)
  cases hz'
  refine (Ideal.quotEquivOfEq ?_).trans (quotientStalkEquivFiberStalk f x)
  simp

/-- An isomorphism of schemes carrying one point to another identifies the local rings there. -/
public noncomputable def stalkRingEquivOfSchemeIso {X Y : Scheme.{u}} (e : X ≅ Y) (x : X)
    {y : Y} (h : e.hom x = y) : Y.presheaf.stalk y ≃+* X.presheaf.stalk x := by
  cases h
  exact (asIso (e.hom.stalkMap x)).commRingCatIsoToRingEquiv

namespace GroupoidScheme

variable {S : Scheme.{u}} (G : GroupoidScheme S) (u : G.objects.left)

/-- The morphism `Spec(κ(u)) ⟶ U` from the residue field at a point of the object scheme of a
groupoid scheme, viewed as a morphism over the base. -/
public noncomputable def residueChart :
    Over.mk (G.objects.left.fromSpecResidueField u ≫ G.objects.hom) ⟶ G.objects :=
  Over.homMk (G.objects.left.fromSpecResidueField u)

/-- The target map read on the source fibre at `u`: it sends an arrow with source `u` to its
target. -/
public noncomputable def targetOnSourceFiber : G.source.left.fiber u ⟶ G.objects.left :=
  G.source.left.fiberι u ≫ G.target.left

/-- The identity arrow at `u`, viewed as a point of the source fibre at `u`, has target `u`. -/
public theorem targetOnSourceFiber_sourceFiberIdentity :
    targetOnSourceFiber G u (sourceFiberIdentity G u) = u := by
  show G.target.left (G.source.left.fiberι u (sourceFiberIdentity G u)) = u
  rw [fiberι_sourceFiberIdentity]
  simpa using congrArg (fun f : G.objects.left ⟶ G.objects.left => f u)
    (identity_left_comp_target_left G)

/-- The map of local rings `𝒪_{U, u} ⟶ 𝒪_{F_u, e(u)}` induced by the target map read on the
source fibre. -/
public noncomputable def targetSourceFiberStalkMap :
    G.objects.left.presheaf.stalk u ⟶
      (G.source.left.fiber u).presheaf.stalk (sourceFiberIdentity G u) :=
  (G.objects.left.presheaf.stalkCongr
      (.of_eq (targetOnSourceFiber_sourceFiberIdentity G u).symm)).hom ≫
    (targetOnSourceFiber G u).stalkMap (sourceFiberIdentity G u)

/-- The map of local rings induced by the target map read on the source fibre is local: it is a
stalk map of a morphism of schemes, precomposed with a transport of local rings. -/
public instance isLocalHom_targetSourceFiberStalkMap :
    IsLocalHom (targetSourceFiberStalkMap G u).hom := by
  have h : (targetSourceFiberStalkMap G u).hom =
      ((targetOnSourceFiber G u).stalkMap (sourceFiberIdentity G u)).hom.comp
        (G.objects.left.presheaf.stalkCongr
          (.of_eq (targetOnSourceFiber_sourceFiberIdentity G u).symm)).hom.hom := rfl
  rw [h]
  infer_instance

/-- The arrow scheme of a restriction, its target projection and its projection to the inner
fibre product of the source map form a fibre square over the object scheme. -/
private lemma isPullback_restrictionTarget {U' : Over S} (g : U' ⟶ G.objects) :
    IsPullback
      (pullback.snd (pullback.snd g G.target) (pullback.fst G.source g)).left
      (pullback.fst (pullback.snd g G.target) (pullback.fst G.source g) ≫
        pullback.fst g G.target).left
      (pullback.fst G.source g ≫ G.target).left
      g.left := by
  have h₁ : IsPullback
      (pullback.snd (pullback.snd g G.target) (pullback.fst G.source g))
      (pullback.fst (pullback.snd g G.target) (pullback.fst G.source g))
      (pullback.fst G.source g) (pullback.snd g G.target) :=
    (IsPullback.of_hasPullback _ _).flip
  have h₂ : IsPullback (pullback.snd g G.target) (pullback.fst g G.target) G.target g :=
    (IsPullback.of_hasPullback _ _).flip
  exact (h₁.paste_vert h₂).map (Over.forget S)

/-- The canonical identification of the arrow scheme of the restriction of a groupoid scheme to
the residue field at `u` with the fibre over `u` of the target map read on the source fibre,
recorded together with its projection to the original arrow scheme. -/
public structure RestrictedArrowsFiberComparison where
  /-- The identification itself. -/
  iso : (restrictionArrows G (residueChart G u)).left ≅ (targetOnSourceFiber G u).fiber u
  /-- Followed by the two fibre embeddings, the identification is the canonical map from the
  restricted arrow scheme to the original arrow scheme. -/
  iso_hom_arrow :
    iso.hom ≫ (targetOnSourceFiber G u).fiberι u ≫ G.source.left.fiberι u =
      (restrictionArrowsToArrows G (residueChart G u)).left

/-- The comparison isomorphism, extracted from the fibre square of the restriction. -/
private noncomputable def restrictedArrowsFiberComparisonData :
    RestrictedArrowsFiberComparison G u := by
  have hB : IsPullback (pullback.fst G.source (residueChart G u)).left
      (pullback.snd G.source (residueChart G u)).left G.source.left
      (residueChart G u).left := (IsPullback.of_hasPullback _ _).map (Over.forget S)
  have hfst : hB.isoPullback.hom ≫ G.source.left.fiberι u =
      (pullback.fst G.source (residueChart G u)).left := hB.isoPullback_hom_fst
  have hsq : IsPullback
      ((pullback.snd (pullback.snd (residueChart G u) G.target)
          (pullback.fst G.source (residueChart G u))).left ≫ hB.isoPullback.hom)
      (pullback.fst (pullback.snd (residueChart G u) G.target)
          (pullback.fst G.source (residueChart G u)) ≫
        pullback.fst (residueChart G u) G.target).left
      (targetOnSourceFiber G u) (G.objects.left.fromSpecResidueField u) :=
    (isPullback_restrictionTarget G (residueChart G u)).of_iso (Iso.refl _) hB.isoPullback
      (Iso.refl _) (Iso.refl _) (by simp) (by simp)
      (by
        have e := congrArg (fun m => m ≫ G.target.left) hfst
        exact (Category.comp_id _).trans ((Category.assoc _ _ _).symm.trans e).symm)
      (by simp [residueChart])
  refine ⟨hsq.isoPullback, ?_⟩
  have e₁ := congrArg (fun m => m ≫ G.source.left.fiberι u) hsq.isoPullback_hom_fst
  have e₂ := congrArg (fun m => (pullback.snd (pullback.snd (residueChart G u) G.target)
      (pullback.fst G.source (residueChart G u))).left ≫ m) hfst
  have e₃ := congrArg (fun m : restrictionArrows G (residueChart G u) ⟶ G.arrows => m.left)
    (pullback.condition (f := pullback.snd (residueChart G u) G.target)
      (g := pullback.fst G.source (residueChart G u)))
  exact (Category.assoc _ _ _).symm.trans
    (e₁.trans ((Category.assoc _ _ _).trans (e₂.trans e₃.symm)))

/-- **The arrow scheme of a restriction to a residue field is a fibre of the source fibre.** The
arrows of the groupoid restricted to `Spec(κ(u))` are the arrows with source `u`, which form the
source fibre `F_u`, and whose target also lies over `u`; so they form the fibre over `u` of the
target map read on `F_u`. -/
public noncomputable def restrictedArrowsFiberComparison :
    RestrictedArrowsFiberComparison G u :=
  Classical.choice (by exact ⟨restrictedArrowsFiberComparisonData G u⟩)

/-- A point of the object scheme of the chosen restriction of a groupoid scheme to the residue
field at `u`. -/
public noncomputable def restrictedObjectPoint :
    (GroupoidScheme.restrict G (residueChart G u)).groupoid.objects.left :=
  (eqToHom (GroupoidScheme.restrict G (residueChart G u)).objects_eq.symm).left
    (IsLocalRing.closedPoint (G.objects.left.residueField u))

/-- The identity arrow of the chosen restriction of a groupoid scheme to the residue field at
`u`, read in the iterated fibre product presenting the restricted arrow scheme. -/
public noncomputable def restrictedIdentityArrow
    (w : (GroupoidScheme.restrict G (residueChart G u)).groupoid.objects.left) :
    (restrictionArrows G (residueChart G u)).left :=
  (eqToHom (GroupoidScheme.restrict G (residueChart G u)).arrows_eq).left
    ((GroupoidScheme.restrict G (residueChart G u)).groupoid.identity.left w)

/-- The identity arrow of a restriction maps to the identity arrow of the original groupoid at
the image of the base point. -/
private lemma restrictionArrowsToArrows_identity {U' : Over S} (g : U' ⟶ G.objects)
    (w : (GroupoidScheme.restrict G g).groupoid.objects.left) :
    (restrictionArrowsToArrows G g).left
        ((eqToHom (GroupoidScheme.restrict G g).arrows_eq).left
          ((GroupoidScheme.restrict G g).groupoid.identity.left w)) =
      G.identity.left (g.left ((eqToHom (GroupoidScheme.restrict G g).objects_eq).left w)) := by
  have h := (GroupoidScheme.restrict G g).hom.map_identity
  rw [(GroupoidScheme.restrict G g).mapObjects_eq,
    (GroupoidScheme.restrict G g).mapArrows_eq] at h
  simpa using (congrArg
    (fun m : (GroupoidScheme.restrict G g).groupoid.objects ⟶ G.arrows => m.left w) h).symm

/-- The identity arrow of the restriction to the residue field at `u` maps to the identity arrow
at `u`. -/
public theorem restrictionArrowsToArrows_restrictedIdentityArrow
    (w : (GroupoidScheme.restrict G (residueChart G u)).groupoid.objects.left) :
    (restrictionArrowsToArrows G (residueChart G u)).left (restrictedIdentityArrow G u w) =
      G.identity.left u := by
  rw [restrictedIdentityArrow, restrictionArrowsToArrows_identity]
  simp [residueChart]

/-- The comparison isomorphism carries the identity arrow of the restriction to a point of the
fibre lying over the identity arrow of the source fibre. -/
public theorem fiberι_restrictedArrowsFiberComparison_hom
    (w : (GroupoidScheme.restrict G (residueChart G u)).groupoid.objects.left) :
    (targetOnSourceFiber G u).fiberι u
        ((restrictedArrowsFiberComparison G u).iso.hom (restrictedIdentityArrow G u w)) =
      sourceFiberIdentity G u := by
  refine sourceFiberIdentity_injective_eq G u _ ?_
  rw [← Scheme.Hom.comp_apply, ← Scheme.Hom.comp_apply,
    (restrictedArrowsFiberComparison G u).iso_hom_arrow]
  exact restrictionArrowsToArrows_restrictedIdentityArrow G u w

/-- **The local ring of the restricted arrow scheme at the identity arrow.** The local ring of
the arrow scheme of the restriction of a groupoid scheme to the residue field at `u`, taken at
the identity arrow, is the local ring of the source fibre `F_u` at the identity arrow modulo the
ideal generated by the image of the maximal ideal of `𝒪_{U, u}` under the target map. -/
public noncomputable def sourceFiberQuotientEquivRestrictedArrowStalk
    (w : (GroupoidScheme.restrict G (residueChart G u)).groupoid.objects.left) :
    ((G.source.left.fiber u).presheaf.stalk (sourceFiberIdentity G u) ⧸
        Ideal.map (targetSourceFiberStalkMap G u).hom
          (IsLocalRing.maximalIdeal (G.objects.left.presheaf.stalk u))) ≃+*
      ((GroupoidScheme.restrict G (residueChart G u)).groupoid.arrows.left.presheaf.stalk
        ((GroupoidScheme.restrict G (residueChart G u)).groupoid.identity.left w)) :=
  (quotientStalkEquivFiberStalkAtPoint (targetOnSourceFiber G u) (sourceFiberIdentity G u)
      (targetOnSourceFiber_sourceFiberIdentity G u)
      ((restrictedArrowsFiberComparison G u).iso.hom (restrictedIdentityArrow G u w))
      (fiberι_restrictedArrowsFiberComparison_hom G u w)).trans
    ((stalkRingEquivOfSchemeIso (restrictedArrowsFiberComparison G u).iso
        (restrictedIdentityArrow G u w) rfl).trans
      (stalkRingEquivOfSchemeIso
        ((Over.forget S).mapIso
          (eqToIso (GroupoidScheme.restrict G (residueChart G u)).arrows_eq))
        ((GroupoidScheme.restrict G (residueChart G u)).groupoid.identity.left w)
        (show ((Over.forget S).mapIso
            (eqToIso (GroupoidScheme.restrict G (residueChart G u)).arrows_eq)).hom
              ((GroupoidScheme.restrict G (residueChart G u)).groupoid.identity.left w) =
            restrictedIdentityArrow G u w from rfl)))

/-- **Stacks Project, Tag 04MQ, read at the identity arrow of a restriction.** The local ring of
the source fibre `F_u` at the identity arrow, modulo the ideal generated by the image of the
maximal ideal of `𝒪_{U, u}` under the target map, has the dimension of the stabilizer fibre at
`u`.

This is the dimension `d₁` of Stacks 0461: it is the dimension of the local ring of the arrow
scheme of the restriction of the groupoid to the residue field at `u`, by
`sourceFiberQuotientEquivRestrictedArrowStalk`, and that is the dimension of the stabilizer
fibre, by `ringKrullDim_stalk_restrictedArrows_eq_stabilizerFiber`. -/
public theorem ringKrullDim_quotient_stalk_sourceFiber_eq_stabilizerFiber
    [LocallyOfFiniteType G.source.left] [LocallyOfFiniteType G.target.left]
    (hu : IsFiniteTypePoint u) :
    ringKrullDim ((G.source.left.fiber u).presheaf.stalk (sourceFiberIdentity G u) ⧸
        Ideal.map (targetSourceFiberStalkMap G u).hom
          (IsLocalRing.maximalIdeal (G.objects.left.presheaf.stalk u))) =
      topologicalKrullDim ((stabilizer G).hom.fiber u) := by
  rw [ringKrullDim_eq_of_ringEquiv
    (sourceFiberQuotientEquivRestrictedArrowStalk G u (restrictedObjectPoint G u))]
  exact ringKrullDim_stalk_restrictedArrows_eq_stabilizerFiber G hu (restrictedObjectPoint G u)

end GroupoidScheme

/-! ### Shared fibre-product comparisons for the restriction

These serve the two proofs that read the arrow scheme of a restriction to a residue field
as a fibre of the target map on the source fibre: Tag 0461 in
`StacksFrontier.AlgebraicGeometry.Groupoids.Slicing.SliceDimensionDrop` and the Tag 04MZ bound in
`StacksFrontier.AlgebraicGeometry.Groupoids.Slicing.StabilizerFiberDimension`. -/

open GroupoidScheme

/-- Swapping the two factors of the inner fibre product of an iterated fibre product. -/
public noncomputable def pullbackFstSymmIso {R U K : Scheme.{u}} (s t : R ⟶ U) (p : K ⟶ U) :
    pullback (pullback.fst s p ≫ t) p ≅ pullback (pullback.snd p s ≫ t) p :=
  asIso (pullback.map (pullback.fst s p ≫ t) p (pullback.snd p s ≫ t) p
    (pullbackSymmetry s p).hom (𝟙 K) (𝟙 U) (by simp) (by simp))

/-- Exchanging the roles of two morphisms with common target in an iterated fibre product with
a third one. -/
public noncomputable def sourceTargetDoubleFiberIso {R U K : Scheme.{u}} (s t : R ⟶ U) (p : K ⟶ U) :
    pullback (pullback.fst s p ≫ t) p ≅ pullback (pullback.snd p t ≫ s) p :=
  pullbackFstSymmIso s t p ≪≫ pullbackAssoc p s t p ≪≫
    pullbackSymmetry p (pullback.fst t p ≫ s) ≪≫ pullbackFstSymmIso t s p

/-- The stabilizer of the restriction of `G` to the residue field at `u` has the dimension of
the fibre of the stabilizer of `G` at `u`. -/
public theorem restrictedStabilizer_fiber_dimension {S : Scheme.{u}}
    (G : GroupoidScheme S) (u : G.objects.left) :
    topologicalKrullDim (stabilizer (GroupoidScheme.restrict G (residueChart G u)).groupoid).left =
      topologicalKrullDim ((stabilizer G).hom.fiber u) := by
  have eSt : Over.mk ((stabilizer (GroupoidScheme.restrict G (residueChart G u)).groupoid).hom ≫
        eqToHom (congrArg Over.left
          (GroupoidScheme.restrict G (residueChart G u)).objects_eq)) ≅
      Over.mk (pullback.fst (G.objects.left.fromSpecResidueField u) (stabilizer G).hom) :=
    restrictStabilizerIso G (G.objects.left.fromSpecResidueField u)
  exact (IsHomeomorph.topologicalKrullDim_eq _
      ((Over.forget _).mapIso eSt).hom.homeomorph.isHomeomorph).trans
    (IsHomeomorph.topologicalKrullDim_eq _
      (pullbackSymmetry (G.objects.left.fromSpecResidueField u)
        (stabilizer G).hom).hom.homeomorph.isHomeomorph)

/-- The arrow scheme of the restriction of `G` to the residue field at `u` has the dimension of
the fibre of the stabilizer of `G` at `u`. -/
public theorem restrictedArrows_dimension_eq_stabilizerFiber {S : Scheme.{u}}
    (G : GroupoidScheme S) (u : G.objects.left) (hu : IsFiniteTypePoint u)
    [LocallyOfFinitePresentation G.source.left]
    [LocallyOfFinitePresentation G.target.left] :
    topologicalKrullDim (GroupoidScheme.restrict G (residueChart G u)).groupoid.arrows.left =
      topologicalKrullDim ((stabilizer G).hom.fiber u) := by
  have hp : LocallyOfFiniteType (G.objects.left.fromSpecResidueField u) := hu.1
  have hs : LocallyOfFiniteType
      (GroupoidScheme.restrict G (residueChart G u)).groupoid.source.left :=
    restrictionSource_locallyOfFiniteType G (G.objects.left.fromSpecResidueField u)
  have ht : LocallyOfFiniteType
      (GroupoidScheme.restrict G (residueChart G u)).groupoid.target.left :=
    restrictionTarget_locallyOfFiniteType G (G.objects.left.fromSpecResidueField u)
  let e : (GroupoidScheme.restrict G (residueChart G u)).groupoid.objects.left ≅
      Spec (.of (G.objects.left.residueField u)) :=
    eqToIso (congrArg Over.left (GroupoidScheme.restrict G (residueChart G u)).objects_eq)
  exact (GroupoidScheme.topologicalKrullDim_arrows_eq_stabilizer _ e).trans
    (restrictedStabilizer_fiber_dimension G u)

/-- The arrow scheme of the restriction of `G` to the residue field at `u` is the fibre of the
restricted target map over the image of the identity arrow. -/
public noncomputable def restrictedArrows_iso_sourceFiberTargetCut {S : Scheme.{u}}
    (G : GroupoidScheme S) (u : G.objects.left) :
    (GroupoidScheme.restrict G (residueChart G u)).groupoid.arrows.left ≅
      (targetOnSourceFiber G u).fiber
        ((targetOnSourceFiber G u) (sourceFiberIdentity G u)) := by
  let g := residueChart G u
  let R := GroupoidScheme.restrict G g
  let eR : R.groupoid.arrows.left ≅ (restrictionArrows G g).left :=
    eqToIso (congrArg Over.left R.arrows_eq)
  let eA : (restrictionArrows G g).left ≅
      (pullback (pullback.snd g G.target ≫ G.source) g).left :=
    (Over.forget S).mapIso
      (pullbackRightPullbackFstIso G.source g (pullback.snd g G.target))
  let eF : (pullback (pullback.snd g G.target ≫ G.source) g).left ≅
      pullback (pullback.snd g G.target ≫ G.source).left g.left :=
    overPullbackLeftIso _ _
  let eT : (pullback g G.target).left ≅ pullback g.left G.target.left :=
    overPullbackLeftIso g G.target
  have heT : eT.hom ≫ (pullback.snd g.left G.target.left ≫ G.source.left) =
      (pullback.snd g G.target ≫ G.source).left := by
    rw [Over.comp_left, ← Category.assoc, overPullbackLeftIso_hom_snd]
  let eH : pullback (pullback.snd g G.target ≫ G.source).left g.left ≅
      pullback (pullback.snd g.left G.target.left ≫ G.source.left) g.left :=
    asIso (pullback.map (pullback.snd g G.target ≫ G.source).left g.left
      (pullback.snd g.left G.target.left ≫ G.source.left) g.left eT.hom
      (𝟙 _) (𝟙 _) (by simpa using heT.symm) (by simp))
  let eD : pullback (pullback.snd g.left G.target.left ≫ G.source.left) g.left ≅
      pullback (pullback.fst G.source.left g.left ≫ G.target.left) g.left :=
    (sourceTargetDoubleFiberIso G.source.left G.target.left g.left).symm
  let eC : pullback (pullback.fst G.source.left g.left ≫ G.target.left) g.left ≅
      (targetOnSourceFiber G u).fiber u := Iso.refl _
  let eY : (targetOnSourceFiber G u).fiber u ≅
      (targetOnSourceFiber G u).fiber
        ((targetOnSourceFiber G u) (sourceFiberIdentity G u)) :=
    fiberIsoOfEq (targetOnSourceFiber G u) (targetOnSourceFiber_sourceFiberIdentity G u).symm
  exact eR ≪≫ eA ≪≫ eF ≪≫ eH ≪≫ eD ≪≫ eC ≪≫ eY

end AlgebraicGeometry

