module

public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import Mathlib.RingTheory.Localization.Ideal

/-!
# The local ring of a subscheme cut out by an ideal on an affine open

Let `i : Z ⟶ Y` be a morphism of schemes, let `V` be an affine open of `Y` whose preimage is an
affine open of `Z`, and suppose the map on sections `Γ(Y, V) ⟶ Γ(Z, i⁻¹V)` is surjective — that
is, `Z` is cut out of `Y` over `V` by the ideal `J` which is the kernel of that map. Then for a
point `z` of `Z` lying over `V` the local ring of `Z` at `z` is the local ring of `Y` at `i z`
modulo the ideal generated by the germs of the elements of `J`.

This is the shape in which the two local-ring computations that clauses (4) and (5) of Stacks
0461 need are stated: there `Z ⟶ Y` is the base change of the slice `Spec(A/fA) ⟶ Spec(A)` along
the target map — once along `t : R ⟶ U`, giving the local ring of `U' ×_{g,U,t} R`, and once on
the source fibre, giving the local ring of `h⁻¹(u)` — and `J` is the ideal generated by the image
of the cutting parameter. The computation is reduced here to the affine statement about `J`.

## Main definitions

* `AlgebraicGeometry.quotientSectionsToQuotientStalk` is the induced map from `Γ(Y, V) ⧸ J` to the
  quotient of the local ring of `Y` at `i z` by the extension of `J`, and
  `AlgebraicGeometry.quotientStalkAlgebra` the algebra structure it defines.
* `AlgebraicGeometry.quotientStalkEquivStalkOfSurjectiveApp` is the identification of that
  quotient with the local ring of `Z` at `z`.

## Main results

* `AlgebraicGeometry.isLocalization_quotientStalk`: the quotient of the local ring of `Y` at `i z`
  by the extension of any ideal `J` of `Γ(Y, V)` is the localization of `Γ(Y, V) ⧸ J` at the image
  of the prime complement of `i z`.
* `AlgebraicGeometry.map_primeCompl_app`: a surjection on sections over an affine open carries the
  prime complement at `i z` onto the prime complement at `z`.
* `AlgebraicGeometry.quotientStalkEquivStalkOfSurjectiveApp_mk_germ`: the identification carries
  the class of the germ of a section over `V` to the germ of its image in `Γ(Z, i⁻¹V)`. This pins
  it down, the germs of sections over an affine open generating the local ring.

## Implementation notes

Both local rings are localizations of the corresponding rings of sections at the prime of the
point, by `AlgebraicGeometry.IsAffineOpen.isLocalization_stalk`, and the two primes correspond
under the surjection, by `AlgebraicGeometry.IsAffineOpen.comap_primeIdealOf_appLE`. So the
quotient `𝒪_{Y, i z} ⧸ J·𝒪_{Y, i z}` is a localization of `Γ(Y, V) ⧸ J` at the image of the prime
complement — a quotient of a localization is the localization of the quotient, which is
`IsLocalization.of_surjective` — and `Γ(Y, V) ⧸ J` is `Γ(Z, i⁻¹V)` by the first isomorphism
theorem; the identification is then uniqueness of localizations,
`IsLocalization.ringEquivOfRingEquiv`.

The algebra structures making the local rings localizations of the rings of sections are the ones
`TopCat.Presheaf.algebra_section_stalk` provides, but instance search cannot find them at a point
presented as `i z` rather than as a point of the open, so they are introduced as local `let`s with
the germ written out in the statements. For the same reason the algebra structure on the quotient
of the local ring is given a name of its own rather than left to the instance for a quotient by an
extended ideal, whose statement is indexed by `algebraMap` and so does not match the germ.

## References

* [Stacks Project, Tag 0461](https://stacks.math.columbia.edu/tag/0461)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry

variable {Y Z : Scheme.{u}} (i : Z ⟶ Y) {V : Y.Opens} (hV : IsAffineOpen V)
  (hW : IsAffineOpen (i ⁻¹ᵁ V)) (hsurj : Function.Surjective (i.app V).hom)
  {z : Z} (hz : i z ∈ V)

/-- The map from `Γ(Y, V) ⧸ J` to the quotient of the local ring of `Y` at a point of `V` by the
ideal generated by the germs of `J`, induced by taking germs. -/
public noncomputable def quotientSectionsToQuotientStalk (J : Ideal Γ(Y, V)) :
    (Γ(Y, V) ⧸ J) →+* ((Y.presheaf.stalk (i z)) ⧸
      Ideal.map (Y.presheaf.germ V (i z) hz).hom J) :=
  Ideal.quotientMap _ (Y.presheaf.germ V (i z) hz).hom Ideal.le_comap_map

/-- The algebra structure on the quotient of the local ring of `Y` at a point of `V` by the ideal
generated by the germs of `J`, over `Γ(Y, V) ⧸ J`. -/
@[instance_reducible]
public noncomputable def quotientStalkAlgebra (J : Ideal Γ(Y, V)) :
    Algebra (Γ(Y, V) ⧸ J) ((Y.presheaf.stalk (i z)) ⧸
      Ideal.map (Y.presheaf.germ V (i z) hz).hom J) :=
  (quotientSectionsToQuotientStalk i hz J).toAlgebra

/-- **A quotient of a local ring of an affine open is a localization of the quotient of the ring
of sections.** For an ideal `J` of `Γ(Y, V)` with `V` affine, the quotient of the local ring of
`Y` at a point of `V` by the ideal generated by the germs of `J` is the localization of
`Γ(Y, V) ⧸ J` at the image of the prime complement of that point. -/
public theorem isLocalization_quotientStalk (J : Ideal Γ(Y, V)) :
    @IsLocalization (Γ(Y, V) ⧸ J) _
      (Submonoid.map (Ideal.Quotient.mk J)
        (hV.primeIdealOf (⟨i z, hz⟩ : V)).asIdeal.primeCompl)
      ((Y.presheaf.stalk (i z)) ⧸ Ideal.map (Y.presheaf.germ V (i z) hz).hom J) _
      (quotientStalkAlgebra i hz J) := by
  let algY : Algebra Γ(Y, V) (Y.presheaf.stalk (i z)) :=
    (Y.presheaf.germ V (i z) hz).hom.toAlgebra
  have hlocY : IsLocalization.AtPrime (Y.presheaf.stalk (i z))
      (hV.primeIdealOf (⟨i z, hz⟩ : V)).asIdeal := hV.isLocalization_stalk (⟨i z, hz⟩ : V)
  let algQ : Algebra (Γ(Y, V) ⧸ J) ((Y.presheaf.stalk (i z)) ⧸
      Ideal.map (Y.presheaf.germ V (i z) hz).hom J) := quotientStalkAlgebra i hz J
  exact IsLocalization.of_surjective
    (hV.primeIdealOf (⟨i z, hz⟩ : V)).asIdeal.primeCompl (Y.presheaf.stalk (i z))
    (Ideal.Quotient.mk J) Ideal.Quotient.mk_surjective
    (Ideal.Quotient.mk (Ideal.map (Y.presheaf.germ V (i z) hz).hom J))
    Ideal.Quotient.mk_surjective rfl
    (by
      rw [Ideal.mk_ker, Ideal.mk_ker]
      exact le_rfl)

/-- The prime of `Γ(Y, V)` at `i z` is the contraction of the prime of `Γ(Z, i⁻¹V)` at `z`. -/
private lemma comap_primeIdealOf_app_self :
    Ideal.comap (i.app V).hom (hW.primeIdealOf (⟨z, hz⟩ : (i ⁻¹ᵁ V))).asIdeal =
      (hV.primeIdealOf (⟨i z, hz⟩ : V)).asIdeal := by
  have h := IsAffineOpen.comap_primeIdealOf_appLE (f := i) V hV (i ⁻¹ᵁ V) hW le_rfl hz
  rw [Scheme.Hom.appLE_eq_app] at h
  exact congrArg PrimeSpectrum.asIdeal h

include hsurj in
/-- A surjection of rings of sections over an affine open and its affine preimage carries the
complement of the prime at `i z` onto the complement of the prime at `z`. -/
public lemma map_primeCompl_app :
    Submonoid.map (i.app V).hom
        (hV.primeIdealOf (⟨i z, hz⟩ : V)).asIdeal.primeCompl =
      (hW.primeIdealOf (⟨z, hz⟩ : (i ⁻¹ᵁ V))).asIdeal.primeCompl := by
  have hc := comap_primeIdealOf_app_self i hV hW hz
  refine le_antisymm ?_ ?_
  · rintro _ ⟨c, hc', rfl⟩
    exact fun hmem => hc' (hc.le (Ideal.mem_comap.mpr hmem))
  · intro d hd
    obtain ⟨c, rfl⟩ := hsurj d
    exact ⟨c, fun hc' => hd (Ideal.mem_comap.mp (hc.ge hc')), rfl⟩

include hsurj in
/-- The image of the prime complement at `i z` under the quotient by the kernel, pushed forward
along the first isomorphism theorem, is the prime complement at `z`. -/
public lemma map_quotientKerEquiv_map_primeCompl :
    Submonoid.map
        ((RingHom.quotientKerEquivOfSurjective hsurj :
          (Γ(Y, V) ⧸ RingHom.ker (i.app V).hom) ≃+* Γ(Z, i ⁻¹ᵁ V)) :
            (Γ(Y, V) ⧸ RingHom.ker (i.app V).hom) ≃* Γ(Z, i ⁻¹ᵁ V)).toMonoidHom
        (Submonoid.map (Ideal.Quotient.mk (RingHom.ker (i.app V).hom))
          (hV.primeIdealOf (⟨i z, hz⟩ : V)).asIdeal.primeCompl) =
      (hW.primeIdealOf (⟨z, hz⟩ : (i ⁻¹ᵁ V))).asIdeal.primeCompl := by
  rw [← map_primeCompl_app i hV hW hsurj hz]
  refine Submonoid.ext fun d => ⟨?_, ?_⟩
  · rintro ⟨-, ⟨c, hc, rfl⟩, rfl⟩
    exact ⟨c, hc, rfl⟩
  · rintro ⟨c, hc, rfl⟩
    exact ⟨_, ⟨c, hc, rfl⟩, rfl⟩

include hsurj in
/-- **The local ring of a subscheme cut out by an ideal on an affine open.** Let `i : Z ⟶ Y` be a
morphism of schemes, let `V` be an affine open of `Y` with affine preimage in `Z`, and suppose the
map `Γ(Y, V) ⟶ Γ(Z, i⁻¹V)` is surjective with kernel `J`. Then the local ring of `Y` at `i z`
modulo the ideal generated by the germs of the elements of `J` is the local ring of `Z` at `z`.

Both sides are localizations of `Γ(Z, i⁻¹V) = Γ(Y, V) ⧸ J` at the prime of `z`: the right-hand
side because `i⁻¹V` is affine, the left-hand side by `isLocalization_quotientStalk`. -/
public noncomputable def quotientStalkEquivStalkOfSurjectiveApp :
    ((Y.presheaf.stalk (i z)) ⧸
        Ideal.map (Y.presheaf.germ V (i z) hz).hom (RingHom.ker (i.app V).hom)) ≃+*
      Z.presheaf.stalk z :=
  letI _algQ := quotientStalkAlgebra i hz (RingHom.ker (i.app V).hom)
  haveI _hlocQ := isLocalization_quotientStalk i hV hz (RingHom.ker (i.app V).hom)
  letI _algZ : Algebra Γ(Z, i ⁻¹ᵁ V) (Z.presheaf.stalk z) :=
    (Z.presheaf.germ (i ⁻¹ᵁ V) z hz).hom.toAlgebra
  haveI _hlocZ : IsLocalization.AtPrime (Z.presheaf.stalk z)
      (hW.primeIdealOf (⟨z, hz⟩ : (i ⁻¹ᵁ V))).asIdeal :=
    hW.isLocalization_stalk (⟨z, hz⟩ : (i ⁻¹ᵁ V))
  IsLocalization.ringEquivOfRingEquiv _ _ (RingHom.quotientKerEquivOfSurjective hsurj)
    (map_quotientKerEquiv_map_primeCompl i hV hW hsurj hz)

include hsurj in
/-- The identification of `quotientStalkEquivStalkOfSurjectiveApp` carries the class of the germ
at `i z` of a section over `V` to the germ at `z` of its image in `Γ(Z, i⁻¹V)`. -/
public theorem quotientStalkEquivStalkOfSurjectiveApp_mk_germ (c : Γ(Y, V)) :
    quotientStalkEquivStalkOfSurjectiveApp i hV hW hsurj hz
        (Ideal.Quotient.mk _ (Y.presheaf.germ V (i z) hz c)) =
      Z.presheaf.germ (i ⁻¹ᵁ V) z hz ((i.app V) c) := by
  let _algQ := quotientStalkAlgebra i hz (RingHom.ker (i.app V).hom)
  have _hlocQ := isLocalization_quotientStalk i hV hz (RingHom.ker (i.app V).hom)
  let _algZ : Algebra Γ(Z, i ⁻¹ᵁ V) (Z.presheaf.stalk z) :=
    (Z.presheaf.germ (i ⁻¹ᵁ V) z hz).hom.toAlgebra
  have _hlocZ : IsLocalization.AtPrime (Z.presheaf.stalk z)
      (hW.primeIdealOf (⟨z, hz⟩ : (i ⁻¹ᵁ V))).asIdeal :=
    hW.isLocalization_stalk (⟨z, hz⟩ : (i ⁻¹ᵁ V))
  exact IsLocalization.ringEquivOfRingEquiv_eq
    (map_quotientKerEquiv_map_primeCompl i hV hW hsurj hz) (Ideal.Quotient.mk _ c)

end AlgebraicGeometry

end
