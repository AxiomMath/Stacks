module

public import Mathlib.AlgebraicGeometry.Pullbacks
public import Mathlib.RingTheory.TensorProduct.Quotient

/-!
# The base change of a quotient immersion is the quotient by the extended ideal

Let `A → B` be a ring map and `I` an ideal of `A`. The closed immersion
`Spec(A/I) ⟶ Spec(A)` has a base change along `Spec(B) ⟶ Spec(A)`, and this file identifies that
base change with the closed immersion `Spec(B/IB) ⟶ Spec(B)`: the ideal cutting out the base
change is the ideal generated by the image of `I`.

This is the affine case of the step clause (4) of Stacks 0461 turns on. There the slice is
`U' = Spec(A/fA)` for a section `f` of an affine chart `Spec(A) ⊆ U` around `u`, and the scheme
whose local ring clause (4) is about is `U' ×_{g,U,t} R`; on an affine chart `Spec(B) ⊆ R` carried
into `Spec(A)` by the target map, that fibre product is the vanishing locus of the image `t(f)` of
the parameter, which is what the identification below says. Combined with
`AlgebraicGeometry.quotientStalkEquivStalkOfSurjectiveApp` it computes the local ring of the fibre
product as `𝒪_{R, e(u)} ⧸ (t f)`.

## Main definitions

* `AlgebraicGeometry.quotientBaseChangeIso`: the identification of
  `Spec(A/I) ×_{Spec A} Spec(B)` with `Spec(B/IB)`.

## Main results

* `AlgebraicGeometry.quotientBaseChangeIso_hom_snd`: the identification is compatible with the
  projection to `Spec(B)`, which is the quotient map `B ⟶ B/IB`. This pins it down: a base change
  is determined by its two projections, and the projection to `Spec(A/I)` carries no information
  beyond the square.

## Implementation notes

The fibre product of two affine schemes is the spectrum of the tensor product, by
`AlgebraicGeometry.pullbackSpecIso`, and `(A/I) ⊗_A B` is `B/IB`, by
`Algebra.TensorProduct.quotIdealMapEquivQuotTensor`; the identification is the composite. Both
halves send the class of `b` to `1 ⊗ b`, so the compatibility with the projection is an equality
of ring maps checked on elements.

## References

* [Stacks Project, Tag 0461](https://stacks.math.columbia.edu/tag/0461)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TensorProduct

universe u

namespace AlgebraicGeometry

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B] (I : Ideal A)

/-- **The base change of a quotient immersion.** The fibre product of `Spec(A/I) ⟶ Spec(A)` with
`Spec(B) ⟶ Spec(A)` is `Spec(B/IB)`. -/
public noncomputable def quotientBaseChangeIso :
    pullback (Spec.map (CommRingCat.ofHom (algebraMap A (A ⧸ I))))
        (Spec.map (CommRingCat.ofHom (algebraMap A B))) ≅
      Spec (CommRingCat.of (B ⧸ I.map (algebraMap A B))) :=
  pullbackSpecIso A (A ⧸ I) B ≪≫
    Scheme.Spec.mapIso (Iso.op
      (Algebra.TensorProduct.quotIdealMapEquivQuotTensor B I).toRingEquiv.toCommRingCatIso)

/-- The quotient map `B ⟶ B/IB` is carried by `Algebra.TensorProduct.quotIdealMapEquivQuotTensor`
to the inclusion of `B` as the right factor of `(A/I) ⊗_A B`. -/
private lemma ofHom_mk_comp_quotIdealMapEquivQuotTensor :
    CommRingCat.ofHom (Ideal.Quotient.mk (I.map (algebraMap A B))) ≫
        (Algebra.TensorProduct.quotIdealMapEquivQuotTensor B
          I).toRingEquiv.toCommRingCatIso.hom =
      CommRingCat.ofHom
        (Algebra.TensorProduct.includeRight (R := A) (A := A ⧸ I) (B := B)).toRingHom := by
  ext b
  exact Algebra.TensorProduct.quotIdealMapEquivQuotTensor_mk B I b

/-- **The base change identification is the quotient map on the second projection.** Composing
`quotientBaseChangeIso` with the closed immersion `Spec(B/IB) ⟶ Spec(B)` gives the projection of
the fibre product to `Spec(B)`. -/
public lemma quotientBaseChangeIso_hom_snd :
    (quotientBaseChangeIso I).hom ≫
        Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.map (algebraMap A B)))) =
      pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap A (A ⧸ I))))
        (Spec.map (CommRingCat.ofHom (algebraMap A B))) := by
  rw [← pullbackSpecIso_hom_snd A (A ⧸ I) B, quotientBaseChangeIso, Iso.trans_hom,
    Category.assoc]
  refine congrArg (fun m => (pullbackSpecIso A (A ⧸ I) B).hom ≫ m) ?_
  rw [Functor.mapIso_hom, Iso.op_hom, Scheme.Spec_map, Quiver.Hom.unop_op, ← Spec.map_comp,
    ofHom_mk_comp_quotIdealMapEquivQuotTensor]
  rfl

end AlgebraicGeometry

end
