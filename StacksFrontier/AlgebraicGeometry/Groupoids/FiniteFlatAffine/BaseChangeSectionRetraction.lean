module

public import StacksFrontier.AlgebraicGeometry.Groupoids.FiniteFlatAffine.BaseChangeArrowBridge
public import StacksFrontier.AlgebraicGeometry.Groupoids.FiniteFlatAffine.InvariantFibrePrimeSpectrum
public import StacksFrontier.RingTheory.Etale.RetractionKernelPushout

/-!
# A section of a base-changed map on object schemes as a retraction of one ring map

Let `F : G' ⟶ G` be a morphism of affine groupoid schemes, `C ⟶ C₁` an extension of the invariant
ring of `G`, and `f₁ : U'₁ ⟶ U₁` the map on object schemes of the induced morphism of base
changes. A **section** `σ` of `f₁` is the same thing as a retraction of `f₁^♯` on coordinate
rings, and this file reads that retraction as a map out of `A' = Γ(U', ⊤)` itself:

```
ρ : A' ⟶ A ⊗[C] C₁,   ρ ∘ f^♯ = (a ↦ a ⊗ 1).
```

In other words `σ` is an `A`-algebra map `A' ⟶ A ⊗[C] C₁`, which is the *one ring map* the
descent of [Stacks Project, Tag 0DT9] descends: the source of the descent is the strict
henselization `C₁ = C^{sh}_p`, which is a filtered colimit of étale `C`-algebras, and `A'` is of
finite presentation over `A` because `f : U' ⟶ U` is étale.

The reverse passage is also here: an `A`-algebra map `A' ⟶ A ⊗[C] C₁` gives a retraction of
`f₁^♯` on coordinate rings, hence — once the kernel is known to be generated by an idempotent — a
section of `f₁`. That is how the datum produced at an étale stage is turned back into geometry.

## Main definitions

* `AlgebraicGeometry.GroupoidScheme.sectionRetraction`: the `A`-algebra map `A' ⟶ A ⊗[C] C₁`
  attached to a section of the base-changed map on object schemes.
* `AlgebraicGeometry.GroupoidScheme.retractionAppTop`: the retraction of `f₁^♯` attached to an
  `A`-algebra map `A' ⟶ A ⊗[C] C₁`.

## Main results

* `AlgebraicGeometry.GroupoidScheme.appTop_comp_section`: a section of the base-changed map is a
  retraction on coordinate rings, read out of `A'`.
* `AlgebraicGeometry.GroupoidScheme.retractionAppTop_comp`: the attached map really is a
  retraction of `f₁^♯`.
* `AlgebraicGeometry.GroupoidScheme.retractionAppTop_of_section`: the two passages are inverse to
  one another, so the kernel of the retraction of `f₁^♯` attached to the descended datum is the
  kernel of the one the section gives.
* `AlgebraicGeometry.GroupoidScheme.ker_tensorRetraction_of_section`: that kernel read on the
  tensor product `A' ⊗[C] C₁`, which is where a descent along a filtered colimit can see it.
* `AlgebraicGeometry.GroupoidScheme.map_mapObjectsAlgHom_comp_tensorRetraction`: the retraction on
  tensor products really is a retraction of the base change of `f^♯`.
* `AlgebraicGeometry.GroupoidScheme.map_comp_tensorRetraction_eq`: **the retraction is compatible
  with a change of the extension ring**, which is the square the kernel comparison of
  `CommRingCat.ker_eq_span_singleton_map_of_isPushout` needs.
* `AlgebraicGeometry.GroupoidScheme.eq_map_of_ker_eq_span_singleton`: **the idempotent cutting out
  the sheet over a larger extension is the image of the one over a smaller one.** This is the step
  that lets the invariance equation proved over the strict henselization be read as an equation
  between images from an étale stage, and so be descended to a stage.

## References

* [Stacks Project, Tag 0DT9](https://stacks.math.columbia.edu/tag/0DT9)

## Tags

groupoid scheme, base change, section, retraction, tensor product
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Stacks.Groupoids
open scoped TensorProduct

noncomputable section

universe u

namespace AlgebraicGeometry.GroupoidScheme

/-- Categorical shape of the retraction computation: around a cocartesian square, a map out of
the pushout composed with a map back is the identity as soon as the two edges are checked. -/
private theorem comp_eq_id_of_isPushout {Z X Y P X' P' : CommRingCat.{u}} {f : Z ⟶ X} {gg : Z ⟶ Y}
    {iX : X ⟶ P} {iY : Y ⟶ P} (po : IsPushout f gg iX iY) {ι : X ⟶ X'} {jX : X' ⟶ P'}
    {jY : Y ⟶ P'} {m : P ⟶ P'} {r : P' ⟶ P} (hm1 : iX ≫ m = ι ≫ jX) (hm2 : iY ≫ m = jY)
    (hr1 : ι ≫ jX ≫ r = iX) (hr2 : jY ≫ r = iY) :
    m ≫ r = 𝟙 P := by
  refine po.hom_ext ?_ ?_
  · rw [← Category.assoc, hm1, Category.assoc, hr1, Category.comp_id]
  · rw [← Category.assoc, hm2, hr2, Category.comp_id]

/-- Categorical shape of the two edge computations: a map into the pushout which factors through
an identification, composed with the transported map back, is the factorisation followed by the
second identification. -/
private theorem edge_comp_transport {X Pt P' Q P : CommRingCat.{u}} (incl : X ⟶ Pt)
    (e₂ : Pt ≅ P') (T : Pt ⟶ Q) (e₁ : Q ≅ P) {j : X ⟶ P'} (hj : incl ≫ e₂.hom = j)
    {q : X ⟶ Q} (hT : incl ≫ T = q) :
    j ≫ e₂.inv ≫ T ≫ e₁.hom = q ≫ e₁.hom := by
  rw [← hj, Category.assoc, Iso.hom_inv_id_assoc, ← Category.assoc, hT]

variable {S : Scheme.{u}} {G G' : GroupoidScheme S} (F : GroupoidScheme.Hom G' G)

/-- `Γ(U', ⊤)` as an algebra over `Γ(U, ⊤)`, through the map on object schemes. -/
@[instance_reducible]
def objectRingAlgebraMapObjects : Algebra Γ(G.objects.left, ⊤) Γ(G'.objects.left, ⊤) :=
  F.mapObjects.left.appTop.hom.toAlgebra

/-- The invariant ring of `G` acts on `Γ(U', ⊤)` through `Γ(U, ⊤)`: the inclusion of the
invariant ring commutes with pullback of global functions along the map on object schemes. -/
theorem isScalarTower_objectRingAlgebra :
    letI := objectRingAlgebraMapObjects F
    letI := objectRingAlgebraOfHom F
    IsScalarTower (invariantRing G) Γ(G.objects.left, ⊤) Γ(G'.objects.left, ⊤) :=
  let := objectRingAlgebraMapObjects F
  let := objectRingAlgebraOfHom F
  IsScalarTower.of_algebraMap_eq' (invariantRingMap_comp_subtype_appTop F)

/-- The map on object schemes, read as a homomorphism of algebras over the invariant ring of
`G`. -/
def mapObjectsAlgHom :
    letI := objectRingAlgebraOfHom F
    Γ(G.objects.left, ⊤) →ₐ[invariantRing G] Γ(G'.objects.left, ⊤) :=
  letI := objectRingAlgebraOfHom F
  { __ := F.mapObjects.left.appTop.hom
    commutes' := fun c => (RingHom.congr_fun (invariantRingMap_comp_subtype_appTop F) c).symm }

section BaseChange

variable {C₁ : Type u} [CommRing C₁] [Algebra (invariantRing G) C₁]
  (bc : AffineInvariantBaseChange G C₁)
  (bc' : AffineInvariantBaseChange G' (tensorBaseRing F C₁))

/-- The map on object schemes of the morphism of base changes induced by `F`, with the new base
ring of `G'` the tensor product `C' ⊗[C] C₁`. -/
def tensorMapObjects : bc'.groupoid.objects.left ⟶ bc.groupoid.objects.left :=
  baseChangeMapObjects F (tensorBaseRingMap F C₁) (tensorBaseRing_compatible F C₁) bc bc'

/-- The map on object schemes of the morphism of base changes is `F` over the two projections. -/
@[reassoc]
theorem tensorMapObjects_comp_objectsProjection :
    tensorMapObjects F bc bc' ≫ bc.objectsProjection =
      bc'.objectsProjection ≫ F.mapObjects.left :=
  baseChangeMapObjects_comp_objectsProjection F (tensorBaseRingMap F C₁)
    (tensorBaseRing_compatible F C₁) bc bc'

/-- The map on object schemes of the morphism of base changes lies over `C₁ ⟶ C' ⊗[C] C₁`. -/
@[reassoc]
theorem tensorMapObjects_comp_hom :
    tensorMapObjects F bc bc' ≫ bc.groupoid.objects.hom =
      bc'.groupoid.objects.hom ≫
        Spec.map (CommRingCat.ofHom (tensorBaseRingMap F C₁)) :=
  baseChangeMapObjects_comp_hom F (tensorBaseRingMap F C₁)
    (tensorBaseRing_compatible F C₁) bc bc'

variable [IsAffine G.objects.left]
  {σ : bc.groupoid.objects.left ⟶ bc'.groupoid.objects.left}
  (hσ : σ ≫ tensorMapObjects F bc bc' = 𝟙 bc.groupoid.objects.left)

include hσ

omit [IsAffine G.objects.left] in
/-- **A section of the base-changed map on object schemes is a retraction on coordinate rings,
read out of `A'`:** pulling a global function on `U` back to `U'`, then to `U'₁`, then along the
section, is pulling it back to `U₁`. -/
theorem appTop_comp_section :
    F.mapObjects.left.appTop ≫ bc'.objectsProjection.appTop ≫ σ.appTop =
      bc.objectsProjection.appTop := by
  rw [← Category.assoc, ← Scheme.Hom.comp_appTop,
    ← tensorMapObjects_comp_objectsProjection F bc bc', Scheme.Hom.comp_appTop,
    Category.assoc, ← Scheme.Hom.comp_appTop, hσ, Scheme.Hom.id_appTop, Category.comp_id]

/-- The retraction of the previous result, read into `A ⊗[C] C₁`, is the inclusion of the left
tensor factor. -/
theorem appTop_comp_section_comp_objectsBaseChangeIso_inv :
    F.mapObjects.left.appTop ≫ bc'.objectsProjection.appTop ≫ σ.appTop ≫
        (objectsBaseChangeIso bc).inv =
      CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
        Γ(G.objects.left, ⊤) →+* objectRingBaseChange G C₁) := by
  have h1 : F.mapObjects.left.appTop ≫ bc'.objectsProjection.appTop ≫ σ.appTop ≫
      (objectsBaseChangeIso bc).inv =
      (F.mapObjects.left.appTop ≫ bc'.objectsProjection.appTop ≫ σ.appTop) ≫
        (objectsBaseChangeIso bc).inv := by
    simp only [Category.assoc]
  rw [h1, appTop_comp_section F bc bc' hσ, ← objectsBaseChangeIso_includeLeft bc,
    Category.assoc, Iso.hom_inv_id, Category.comp_id]

/-- **The `A`-algebra map `A' ⟶ A ⊗[C] C₁` attached to a section of the base-changed map on
object schemes.** -/
def sectionRetraction :
    letI := objectRingAlgebraMapObjects F
    Γ(G'.objects.left, ⊤) →ₐ[Γ(G.objects.left, ⊤)] objectRingBaseChange G C₁ :=
  letI := objectRingAlgebraMapObjects F
  { __ := (bc'.objectsProjection.appTop ≫ σ.appTop ≫ (objectsBaseChangeIso bc).inv).hom
    commutes' := fun a =>
      congr($(appTop_comp_section_comp_objectsBaseChangeIso_inv F bc bc' hσ).hom a) }

/-- `sectionRetraction` sends `a'` to its pullback to `U'₁`, then along the section, then through
the identification with `A ⊗[C] C₁`. -/
@[simp]
theorem sectionRetraction_apply (a' : Γ(G'.objects.left, ⊤)) :
    letI := objectRingAlgebraMapObjects F
    sectionRetraction F bc bc' hσ a' =
      (bc'.objectsProjection.appTop ≫ σ.appTop ≫ (objectsBaseChangeIso bc).inv).hom a' :=
  rfl

end BaseChange

/-! ### From an algebra map out of `A'` back to a retraction on coordinate rings -/

section Retraction

variable {C₁ : Type u} [CommRing C₁] [Algebra (invariantRing G) C₁]
  (bc : AffineInvariantBaseChange G C₁)
  (bc' : AffineInvariantBaseChange G' (tensorBaseRing F C₁))
  [IsAffine G.objects.left] [IsAffine G'.objects.left]
  (g : Γ(G'.objects.left, ⊤) ⟶ CommRingCat.of (objectRingBaseChange G C₁))
  (hg : F.mapObjects.left.appTop ≫ g =
    CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
      Γ(G.objects.left, ⊤) →+* objectRingBaseChange G C₁))

include hg

omit [IsAffine G.objects.left] [IsAffine G'.objects.left] in
/-- The square the universal map out of `A' ⊗[C] C₁` needs: an `A`-algebra map out of `A'` into
`A ⊗[C] C₁` agrees on the invariant ring with the inclusion of the right tensor factor. -/
theorem algebraMap_comp_eq_of_includeLeft :
    letI := objectRingAlgebraOfHom F
    CommRingCat.ofHom (algebraMap (invariantRing G) Γ(G'.objects.left, ⊤)) ≫ g =
      CommRingCat.ofHom (algebraMap (invariantRing G) C₁) ≫
        CommRingCat.ofHom (Algebra.TensorProduct.includeRight.toRingHom :
          C₁ →+* objectRingBaseChange G C₁) := by
  let := objectRingAlgebraOfHom F
  have hfac : (CommRingCat.ofHom
        (algebraMap (invariantRing G) Γ(G'.objects.left, ⊤)) :
      CommRingCat.of (invariantRing G) ⟶ Γ(G'.objects.left, ⊤)) =
      CommRingCat.ofHom (algebraMap (invariantRing G) Γ(G.objects.left, ⊤)) ≫
        F.mapObjects.left.appTop := by
    ext c
    exact RingHom.congr_fun (invariantRingMap_comp_subtype_appTop F) c
  rw [hfac, Category.assoc, hg]
  exact (CommRingCat.isPushout_tensorProduct (invariantRing G) Γ(G.objects.left, ⊤) C₁).w

/-- **The retraction of `A' ⊗[C] C₁ ⟶ A ⊗[C] C₁` determined by an `A`-algebra map
`A' ⟶ A ⊗[C] C₁`.** -/
def tensorRetraction :
    letI := objectRingAlgebraOfHom F
    CommRingCat.of (Γ(G'.objects.left, ⊤) ⊗[invariantRing G] C₁) ⟶
      CommRingCat.of (objectRingBaseChange G C₁) :=
  letI := objectRingAlgebraOfHom F
  (CommRingCat.isPushout_tensorProduct (invariantRing G) Γ(G'.objects.left, ⊤) C₁).desc g
    (CommRingCat.ofHom (Algebra.TensorProduct.includeRight.toRingHom :
      C₁ →+* objectRingBaseChange G C₁))
    (algebraMap_comp_eq_of_includeLeft F g hg)

omit [IsAffine G.objects.left] [IsAffine G'.objects.left] in
/-- On the left tensor factor `A'`, `tensorRetraction` restricts to `g`. -/
@[reassoc]
theorem includeLeft_comp_tensorRetraction :
    letI := objectRingAlgebraOfHom F
    CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
        Γ(G'.objects.left, ⊤) →+* Γ(G'.objects.left, ⊤) ⊗[invariantRing G] C₁) ≫
      tensorRetraction F g hg = g :=
  let := objectRingAlgebraOfHom F
  IsPushout.inl_desc _ _ _ _

omit [IsAffine G.objects.left] [IsAffine G'.objects.left] in
/-- On the right tensor factor `C₁`, `tensorRetraction` restricts to the inclusion of `C₁` into
`A ⊗[C] C₁`. -/
@[reassoc]
theorem includeRight_comp_tensorRetraction :
    letI := objectRingAlgebraOfHom F
    CommRingCat.ofHom (Algebra.TensorProduct.includeRight.toRingHom :
        C₁ →+* Γ(G'.objects.left, ⊤) ⊗[invariantRing G] C₁) ≫ tensorRetraction F g hg =
      CommRingCat.ofHom (Algebra.TensorProduct.includeRight.toRingHom :
        C₁ →+* objectRingBaseChange G C₁) :=
  let := objectRingAlgebraOfHom F
  IsPushout.inr_desc _ _ _ _

/-- **The retraction of the base-changed map on coordinate rings determined by an `A`-algebra map
`A' ⟶ A ⊗[C] C₁`**, read through the two identifications of the coordinate rings of the base
changes with tensor products. -/
def retractionAppTop :
    Γ(bc'.groupoid.objects.left, ⊤) ⟶ Γ(bc.groupoid.objects.left, ⊤) :=
  (objectsTensorBaseRingIso F C₁ bc').inv ≫ tensorRetraction F g hg ≫
    (objectsBaseChangeIso bc).hom

omit [IsAffine G.objects.left] [IsAffine G'.objects.left] hg in
/-- The projection to `U` composed with the base-changed map on coordinate rings is the map on
object schemes of `F` composed with the projection to `U'`. -/
theorem objectsProjection_appTop_comp_tensorMapObjects_appTop :
    bc.objectsProjection.appTop ≫ (tensorMapObjects F bc bc').appTop =
      F.mapObjects.left.appTop ≫ bc'.objectsProjection.appTop := by
  rw [← Scheme.Hom.comp_appTop, tensorMapObjects_comp_objectsProjection F bc bc',
    Scheme.Hom.comp_appTop]

omit [IsAffine G.objects.left] [IsAffine G'.objects.left] hg in
/-- The structure map to `Spec C₁` composed with the base-changed map on coordinate rings is the
structure map of the base change of `G'`, read over `Spec C₁`. -/
theorem invΓSpecIso_comp_tensorMapObjects_appTop :
    ((Scheme.ΓSpecIso (.of C₁)).inv ≫ bc.groupoid.objects.hom.appTop) ≫
        (tensorMapObjects F bc bc').appTop =
      (Scheme.ΓSpecIso (.of C₁)).inv ≫ (bc'.groupoid.objects.hom ≫
        Spec.map (CommRingCat.ofHom (tensorBaseRingMap F C₁))).appTop :=
  (Category.assoc _ _ _).trans (congrArg (fun k => (Scheme.ΓSpecIso (.of C₁)).inv ≫ k)
    ((Scheme.Hom.comp_appTop _ _).symm.trans
      (congrArg Scheme.Hom.appTop (tensorMapObjects_comp_hom F bc bc'))))

/-- The defining factorisation of the retraction on coordinate rings. -/
theorem retractionAppTop_eq :
    retractionAppTop F bc bc' g hg = (objectsTensorBaseRingIso F C₁ bc').inv ≫
      tensorRetraction F g hg ≫ (objectsBaseChangeIso bc).hom := rfl

/-- On the `A'` edge the retraction is the given map. -/
theorem objectsProjection_appTop_comp_retractionAppTop :
    F.mapObjects.left.appTop ≫ bc'.objectsProjection.appTop ≫
        retractionAppTop F bc bc' g hg =
      bc.objectsProjection.appTop := by
  let := objectRingAlgebraOfHom F
  rw [retractionAppTop_eq F bc bc' g hg,
    edge_comp_transport _ (objectsTensorBaseRingIso F C₁ bc') (tensorRetraction F g hg)
      (objectsBaseChangeIso bc) (objectsTensorBaseRingIso_includeLeft F C₁ bc')
      (includeLeft_comp_tensorRetraction F g hg),
    ← Category.assoc, hg, objectsBaseChangeIso_includeLeft bc]

/-- On the `C₁` edge the retraction is the inclusion of the right tensor factor. -/
theorem invΓSpecIso_comp_retractionAppTop :
    ((Scheme.ΓSpecIso (.of C₁)).inv ≫ (bc'.groupoid.objects.hom ≫
          Spec.map (CommRingCat.ofHom (tensorBaseRingMap F C₁))).appTop) ≫
        retractionAppTop F bc bc' g hg =
      (Scheme.ΓSpecIso (.of C₁)).inv ≫ bc.groupoid.objects.hom.appTop := by
  let := objectRingAlgebraOfHom F
  rw [retractionAppTop_eq F bc bc' g hg,
    edge_comp_transport _ (objectsTensorBaseRingIso F C₁ bc') (tensorRetraction F g hg)
      (objectsBaseChangeIso bc) (objectsTensorBaseRingIso_includeRight F C₁ bc')
      (includeRight_comp_tensorRetraction F g hg),
    objectsBaseChangeIso_includeRight bc]

/-- **The attached map is a retraction of the base-changed map on coordinate rings.** Both edges
of the cocartesian square presenting `Γ(U₁, ⊤)` are checked: on the `A` edge the computation is
that the given map is a map of `A`-algebras, and on the `C₁` edge that both maps restrict to the
inclusion of the right tensor factor. -/
theorem baseChange_appTop_comp_retractionAppTop :
    (tensorMapObjects F bc bc').appTop ≫ retractionAppTop F bc bc' g hg =
      𝟙 Γ(bc.groupoid.objects.left, ⊤) :=
  comp_eq_id_of_isPushout (isPushout_objectsProjection_appTop bc)
    (objectsProjection_appTop_comp_tensorMapObjects_appTop F bc bc')
    (invΓSpecIso_comp_tensorMapObjects_appTop F bc bc')
    (objectsProjection_appTop_comp_retractionAppTop F bc bc' g hg)
    (invΓSpecIso_comp_retractionAppTop F bc bc' g hg)

end Retraction

/-! ### The two passages are inverse to one another -/

section SectionKernel

variable {C₁ : Type u} [CommRing C₁] [Algebra (invariantRing G) C₁]
  (bc : AffineInvariantBaseChange G C₁)
  (bc' : AffineInvariantBaseChange G' (tensorBaseRing F C₁))
  [IsAffine G.objects.left] [IsAffine G'.objects.left]
  {σ : bc.groupoid.objects.left ⟶ bc'.groupoid.objects.left}
  (hσ : σ ≫ tensorMapObjects F bc bc' = 𝟙 bc.groupoid.objects.left)

include hσ

/-- **The retraction attached to the `A`-algebra map of a section is the section itself.** Both
edges of the cocartesian square presenting `Γ(U'₁, ⊤)` are checked: on the `A'` edge the
computation is the defining property of the attached map, and on the `C₁` edge that the section
lies over `Spec C₁`.

This is what makes the two passages of this file inverse to one another, and hence what lets the
idempotent cutting out the range of a section be recognised in the kernel of the retraction that
the descent carries. -/
theorem retractionAppTop_of_section :
    retractionAppTop F bc bc'
        (bc'.objectsProjection.appTop ≫ σ.appTop ≫ (objectsBaseChangeIso bc).inv)
        (appTop_comp_section_comp_objectsBaseChangeIso_inv F bc bc' hσ) = σ.appTop := by
  let := objectRingAlgebraOfHom F
  have hcomp : σ ≫ bc'.groupoid.objects.hom ≫
      Spec.map (CommRingCat.ofHom (tensorBaseRingMap F C₁)) = bc.groupoid.objects.hom := by
    rw [← tensorMapObjects_comp_hom F bc bc', ← Category.assoc, hσ, Category.id_comp]
  refine (isPushout_appTop_of_isPullback_specMap
    (CommRingCat.ofHom (algebraMap (invariantRing G) Γ(G'.objects.left, ⊤)))
    (CommRingCat.ofHom (algebraMap (invariantRing G) C₁))
    (isPullback_objectsProjection_tensorBaseRing F C₁ bc')).hom_ext ?_ ?_
  · rw [retractionAppTop_eq]
    refine (edge_comp_transport _ (objectsTensorBaseRingIso F C₁ bc') (tensorRetraction F _
      (appTop_comp_section_comp_objectsBaseChangeIso_inv F bc bc' hσ))
      (objectsBaseChangeIso bc) (objectsTensorBaseRingIso_includeLeft F C₁ bc')
      (includeLeft_comp_tensorRetraction F _ _)).trans ?_
    simp only [Category.assoc, Iso.inv_hom_id, Category.comp_id]
  · refine (invΓSpecIso_comp_retractionAppTop F bc bc' _ _).trans ?_
    exact Eq.symm ((Category.assoc _ _ _).trans
      (congrArg ((Scheme.ΓSpecIso (.of C₁)).inv ≫ ·)
        ((Scheme.Hom.comp_appTop _ _).symm.trans (congrArg Scheme.Hom.appTop hcomp))))

/-- **The kernel of the retraction on tensor products attached to a section**, whose generator is
the generator of the kernel of the section read through the identification of the coordinate ring
of the base change with `A' ⊗[C] C₁`. -/
theorem ker_tensorRetraction_of_section (ε : Γ(bc'.groupoid.objects.left, ⊤))
    (hker : RingHom.ker σ.appTop.hom = Ideal.span {ε}) :
    RingHom.ker (tensorRetraction F
        (bc'.objectsProjection.appTop ≫ σ.appTop ≫ (objectsBaseChangeIso bc).inv)
        (appTop_comp_section_comp_objectsBaseChangeIso_inv F bc bc' hσ)).hom =
      Ideal.span {(objectsTensorBaseRingIso F C₁ bc').inv.hom ε} := by
  have heq : (objectsTensorBaseRingIso F C₁ bc').inv ≫ tensorRetraction F
        (bc'.objectsProjection.appTop ≫ σ.appTop ≫ (objectsBaseChangeIso bc).inv)
        (appTop_comp_section_comp_objectsBaseChangeIso_inv F bc bc' hσ) ≫
      (objectsBaseChangeIso bc).hom = σ.appTop :=
    (retractionAppTop_eq F bc bc' _ _).symm.trans (retractionAppTop_of_section F bc bc' hσ)
  exact CommRingCat.ker_eq_span_singleton_of_iso_comp (objectsTensorBaseRingIso F C₁ bc')
    (objectsBaseChangeIso bc) _
    ((congrArg (fun k : Γ(bc'.groupoid.objects.left, ⊤) ⟶ Γ(bc.groupoid.objects.left, ⊤) =>
      RingHom.ker k.hom) heq).trans hker)

end SectionKernel

/-! ### The retraction under a change of the extension ring -/

section StageCompatibility

variable {C₁ C₂ : Type u} [CommRing C₁] [CommRing C₂] [Algebra (invariantRing G) C₁]
  [Algebra (invariantRing G) C₂] [IsAffine G.objects.left] [IsAffine G'.objects.left]
  (g : Γ(G'.objects.left, ⊤) ⟶ CommRingCat.of (objectRingBaseChange G C₁))
  (hg : F.mapObjects.left.appTop ≫ g =
    CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
      Γ(G.objects.left, ⊤) →+* objectRingBaseChange G C₁))

omit [IsAffine G.objects.left] [IsAffine G'.objects.left] in
/-- The base change of `f ⊗ h` on the left tensor factor: `includeLeft` is natural in `f`. -/
private theorem includeLeft_comp_map {R A B A' B' : Type u} [CommRing R] [CommRing A] [CommRing B]
    [CommRing A'] [CommRing B'] [Algebra R A] [Algebra R B] [Algebra R A'] [Algebra R B']
    (f : A →ₐ[R] A') (h : B →ₐ[R] B') :
    CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : A →+* A ⊗[R] B) ≫
      CommRingCat.ofHom (Algebra.TensorProduct.map f h).toRingHom =
    CommRingCat.ofHom f.toRingHom ≫
      CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom : A' →+* A' ⊗[R] B') := by
  ext a
  simp

omit [IsAffine G.objects.left] [IsAffine G'.objects.left] in
/-- The base change of `f ⊗ h` on the right tensor factor: `includeRight` is natural in `h`. -/
private theorem includeRight_comp_map {R A B A' B' : Type u} [CommRing R] [CommRing A] [CommRing B]
    [CommRing A'] [CommRing B'] [Algebra R A] [Algebra R B] [Algebra R A'] [Algebra R B']
    (f : A →ₐ[R] A') (h : B →ₐ[R] B') :
    CommRingCat.ofHom (Algebra.TensorProduct.includeRight.toRingHom : B →+* A ⊗[R] B) ≫
      CommRingCat.ofHom (Algebra.TensorProduct.map f h).toRingHom =
    CommRingCat.ofHom h.toRingHom ≫
      CommRingCat.ofHom (Algebra.TensorProduct.includeRight.toRingHom : B' →+* A' ⊗[R] B') := by
  ext b
  simp

include hg

omit [IsAffine G.objects.left] [IsAffine G'.objects.left] in
/-- **The retraction on tensor products is a retraction of the base change of `f^♯`.** Both edges
of the cocartesian square presenting `A ⊗[C] C₁` are checked: on the `A` edge the computation is
that the given map is a map of `A`-algebras, and on the `C₁` edge that both maps restrict to the
inclusion of the right tensor factor. -/
theorem map_mapObjectsAlgHom_comp_tensorRetraction :
    letI := objectRingAlgebraOfHom F
    CommRingCat.ofHom (Algebra.TensorProduct.map (mapObjectsAlgHom F)
        (AlgHom.id (invariantRing G) C₁)).toRingHom ≫ tensorRetraction F g hg =
      𝟙 (CommRingCat.of (objectRingBaseChange G C₁)) :=
  let := objectRingAlgebraOfHom F
  comp_eq_id_of_isPushout
    (CommRingCat.isPushout_tensorProduct (invariantRing G) Γ(G.objects.left, ⊤) C₁)
    (includeLeft_comp_map (mapObjectsAlgHom F) (AlgHom.id (invariantRing G) C₁))
    (includeRight_comp_map (mapObjectsAlgHom F) (AlgHom.id (invariantRing G) C₁))
    ((congrArg (F.mapObjects.left.appTop ≫ ·) (includeLeft_comp_tensorRetraction F g hg)).trans hg)
    (includeRight_comp_tensorRetraction F g hg)

variable (h : C₁ →ₐ[invariantRing G] C₂)
  (g₂ : Γ(G'.objects.left, ⊤) ⟶ CommRingCat.of (objectRingBaseChange G C₂))
  (hg₂ : F.mapObjects.left.appTop ≫ g₂ =
    CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
      Γ(G.objects.left, ⊤) →+* objectRingBaseChange G C₂))
  (hcompat : g ≫ CommRingCat.ofHom (Algebra.TensorProduct.map
      (AlgHom.id (invariantRing G) Γ(G.objects.left, ⊤)) h).toRingHom = g₂)

include hg₂ hcompat

omit [IsAffine G.objects.left] [IsAffine G'.objects.left] in
/-- **The retraction on tensor products is compatible with a change of the extension ring.** For a
map `h : C₁ ⟶ C₂` of extensions of the invariant ring and two compatible `A`-algebra maps out of
`A'`, the square formed by the two retractions and the two base changes of `h` commutes.

This is exactly the square `CommRingCat.ker_eq_span_singleton_map_of_isPushout` needs around the
cocartesian square `Algebra.TensorProduct.isPushout_map (f^♯) h`. -/
theorem map_comp_tensorRetraction_eq :
    letI := objectRingAlgebraOfHom F
    CommRingCat.ofHom (Algebra.TensorProduct.map
          (AlgHom.id (invariantRing G) Γ(G'.objects.left, ⊤)) h).toRingHom ≫
        tensorRetraction F g₂ hg₂ =
      tensorRetraction F g hg ≫ CommRingCat.ofHom (Algebra.TensorProduct.map
        (AlgHom.id (invariantRing G) Γ(G.objects.left, ⊤)) h).toRingHom := by
  let := objectRingAlgebraOfHom F
  have hL := includeLeft_comp_map (AlgHom.id (invariantRing G) Γ(G'.objects.left, ⊤)) h
  have hR := includeRight_comp_map (AlgHom.id (invariantRing G) Γ(G'.objects.left, ⊤)) h
  have hRA := includeRight_comp_map (AlgHom.id (invariantRing G) Γ(G.objects.left, ⊤)) h
  refine (CommRingCat.isPushout_tensorProduct (invariantRing G) Γ(G'.objects.left, ⊤)
    C₁).hom_ext ?_ ?_
  · refine (comp_assoc_left hL _).trans ?_
    refine (includeLeft_comp_tensorRetraction F g₂ hg₂).trans ?_
    exact Eq.symm ((comp_assoc_left (includeLeft_comp_tensorRetraction F g hg) _).trans hcompat)
  · refine (comp_assoc_left₂ hR (includeRight_comp_tensorRetraction F g₂ hg₂)).trans ?_
    exact Eq.symm ((comp_assoc_left (includeRight_comp_tensorRetraction F g hg) _).trans hRA)

omit [IsAffine G.objects.left] [IsAffine G'.objects.left] in
/-- **The idempotent cutting out the sheet over a larger extension is the image of the one over a
smaller one.** The two kernels are the two horizontal edges of the cocartesian square
`Algebra.TensorProduct.isPushout_map (f^♯) h`, so the second is generated by the image of the
generator of the first by `CommRingCat.ker_eq_span_singleton_map_of_isPushout`; both generators
are idempotents, and an idempotent is determined by the ideal it generates.

This is what lets the invariance equation, proved over the strict henselization, be read as an
equation between the images of two elements of an étale stage — the only form in which a filtered
colimit descends it. -/
theorem eq_map_of_ker_eq_span_singleton :
    letI := objectRingAlgebraOfHom F
    ∀ (e₁ : Γ(G'.objects.left, ⊤) ⊗[invariantRing G] C₁)
      (ε : Γ(G'.objects.left, ⊤) ⊗[invariantRing G] C₂),
      IsIdempotentElem e₁ → IsIdempotentElem ε →
        RingHom.ker (tensorRetraction F g hg).hom = Ideal.span {e₁} →
        RingHom.ker (tensorRetraction F g₂ hg₂).hom = Ideal.span {ε} →
          ε = Algebra.TensorProduct.map
            (AlgHom.id (invariantRing G) Γ(G'.objects.left, ⊤)) h e₁ := by
  let := objectRingAlgebraOfHom F
  intro e₁ ε he₁ hε hker₁ hker₂
  have hkey := CommRingCat.ker_eq_span_singleton_map_of_isPushout
    (Algebra.TensorProduct.isPushout_map (mapObjectsAlgHom F) h)
    (map_mapObjectsAlgHom_comp_tensorRetraction F g hg)
    (map_mapObjectsAlgHom_comp_tensorRetraction F g₂ hg₂)
    (map_comp_tensorRetraction_eq F g hg h g₂ hg₂ hcompat) hker₁
  refine hε.eq_of_span_singleton_eq ?_ (hker₂.symm.trans hkey)
  change _ * _ = _
  rw [← map_mul, he₁]

end StageCompatibility

end AlgebraicGeometry.GroupoidScheme

