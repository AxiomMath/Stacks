/-- The structure morphism of the object scheme of a base-changed groupoid factors through its own
invariant spectrum by the canonical map to the invariant functions. -/
theorem objectsToInvariantSpectrum_comp_specMap_canonicalMapToInvariantFunctions {S : Scheme.{u}}
    {G : GroupoidScheme S} {C₁ : Type u} [CommRing C₁] [Algebra (invariantRing G) C₁]
    (bc : AffineInvariantBaseChange G C₁) :
    objectsToInvariantSpectrum bc.groupoid ≫
        Spec.map (CommRingCat.ofHom bc.canonicalMapToInvariantFunctions) =
      bc.groupoid.objects.hom := by
  rw [objectsToInvariantSpectrum, Category.assoc, ← Spec.map_comp]
  show bc.groupoid.objects.left.toSpecΓ ≫
    Spec.map ((Scheme.ΓSpecIso (.of C₁)).inv ≫ bc.groupoid.objects.hom.appTop) = _
  rw [Spec.map_comp, ← Scheme.toSpecΓ_naturality_assoc]
  simp

variable {S : Scheme.{u}} {G G' : GroupoidScheme S} (F : GroupoidScheme.Hom G' G)

section StrictlyHenselian

