/-- **The section of the "Claim" of [Stacks Project, Tag 0DT9] read on a compatible pair of
extensions.** Let `C ⟶ C₁` and `C' ⟶ C'₁` be extensions of the two invariant rings compatible
through `ψ`, with `C₁` strictly henselian local, let the two canonical maps of Tag 03BK be
bijective, and let `x` be a point of `Spec C'₁` above the closed point of `Spec C₁`. Then the map
on object schemes of the induced morphism of base changes admits a section which is an open
immersion with closed invariant range, and that range contains a point of `U'₁` above `x`.

The chosen point is carried onto the invariant ring of the base change by the canonical map of
Tag 03BK, the Claim is applied there, and the resulting point of the sheet is carried back. -/
theorem exists_section_of_strictlyHenselian_of_bijective
    (hsource : IsPullback F.mapArrows.left G'.source.left G.source.left F.mapObjects.left)
    (htarget : IsPullback F.mapArrows.left G'.target.left G.target.left F.mapObjects.left)
    (hstab : IsPullback (stabilizerMap F).left (stabilizer G').hom (stabilizer G).hom
      F.mapObjects.left)
    (hbc : Function.Bijective bc.canonicalMapToInvariantFunctions)
    (hbc' : Function.Bijective bc'.canonicalMapToInvariantFunctions)
    (hobj : Etale (baseChangeHom F ψ hψ bc bc').mapObjects.left)
    (x : Spec (.of C'₁))
    (hx : (Spec.map (CommRingCat.ofHom ψ)).base x =
      (IsLocalRing.closedPoint C₁ : Spec (.of C₁))) :
    ∃ σ : bc.groupoid.objects.left ⟶ bc'.groupoid.objects.left, IsOpenImmersion σ ∧
      σ ≫ (baseChangeHom F ψ hψ bc bc').mapObjects.left = 𝟙 bc.groupoid.objects.left ∧
      IsClosed (Set.range σ.base) ∧ IsInvariantSet bc'.groupoid (Set.range σ.base) ∧
      ∃ u' : bc'.groupoid.objects.left, u' ∈ Set.range σ.base ∧
        bc'.groupoid.objects.hom.base u' = x := by
  have : StrictlyHenselianLocalRing (invariantRing bc.groupoid) :=
    strictlyHenselianLocalRing_of_ringEquiv (RingEquiv.ofBijective _ hbc)
  have : IsFiniteLocallyFree bc.groupoid.source.left := bc.source_isFiniteLocallyFree
  have : IsFiniteLocallyFree bc.groupoid.target.left := bc.target_isFiniteLocallyFree
  have : IsFiniteLocallyFree
      (bc'.groupoid.pushforward (Spec.map (CommRingCat.ofHom ψ))).source.left :=
    bc'.source_isFiniteLocallyFree
  have : IsFiniteLocallyFree
      (bc'.groupoid.pushforward (Spec.map (CommRingCat.ofHom ψ))).target.left :=
    bc'.target_isFiniteLocallyFree
  have : IsAffine (bc'.groupoid.pushforward (Spec.map (CommRingCat.ofHom ψ))).objects.left :=
    inferInstanceAs (IsAffine bc'.groupoid.objects.left)
  have : IsAffine (bc'.groupoid.pushforward (Spec.map (CommRingCat.ofHom ψ))).arrows.left :=
    inferInstanceAs (IsAffine bc'.groupoid.arrows.left)
  have := hobj
  obtain ⟨P', hPeB, hP⟩ := exists_point_specMap_of_ringEquiv_square ψ
    (invariantRingMap (baseChangeHom F ψ hψ bc bc'))
    (RingEquiv.ofBijective _ hbc) (RingEquiv.ofBijective _ hbc')
    (invariantRingMap_baseChangeHom_comp_ofBijective F ψ hψ bc bc' hbc hbc') x hx
  have hs := source_isPullback_mapArrows_baseChangeHom F ψ hψ bc bc' hsource
  have ht := target_isPullback_mapArrows_baseChangeHom F ψ hψ bc bc' htarget
  have hg := isPullback_stabilizerMap_baseChangeHom F ψ hψ bc bc' htarget hstab
  obtain ⟨σ, hoi, hσ, hcl, hfib⟩ :=
    exists_section_of_strictlyHenselian (baseChangeHom F ψ hψ bc bc') hs ht hg P' hP
  have := hoi
  have hV := isInvariantSet_range_of_section (baseChangeHom F ψ hψ bc bc') hs ht hg P' hP hσ
    σ.opensRange.isOpen hfib
  obtain ⟨u, hu⟩ := surjective_objectsToInvariantSpectrum bc.groupoid
    (IsLocalRing.closedPoint (invariantRing bc.groupoid) :
      Spec (.of (invariantRing bc.groupoid)))
  have hσu := mem_fibre_of_section_of_mem_closedFibre (baseChangeHom F ψ hψ bc bc') hs ht hg
    P' hP hσ hfib u hu
  refine ⟨σ, hoi, hσ, hcl, hV, σ.base u, ⟨u, rfl⟩, ?_⟩
  have heB : CommRingCat.ofHom (RingEquiv.ofBijective _ hbc').toRingHom =
      CommRingCat.ofHom bc'.canonicalMapToInvariantFunctions :=
    CommRingCat.hom_ext (RingHom.ext fun _ => rfl)
  have hstep : bc'.groupoid.objects.hom.base (σ.base u) =
      (Spec.map (CommRingCat.ofHom bc'.canonicalMapToInvariantFunctions)).base
        ((objectsToInvariantSpectrum bc'.groupoid).base (σ.base u)) :=
    (congrArg (fun k : bc'.groupoid.objects.left ⟶ Spec (.of C'₁) => k.base (σ.base u))
      (objectsToInvariantSpectrum_comp_specMap_canonicalMapToInvariantFunctions bc')).symm
  rw [hstep, ← heB, show (objectsToInvariantSpectrum bc'.groupoid).base (σ.base u) = P' from hσu]
  exact hPeB

end Induced

