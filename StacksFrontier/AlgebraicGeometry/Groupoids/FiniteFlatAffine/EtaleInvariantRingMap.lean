tensor product presentation, where the two bijectivity hypotheses are Tag 03BK for the two
extensions and étaleness of the map on object schemes of the induced morphism is
`AlgebraicGeometry.GroupoidScheme.etale_baseChangeMapObjects_tensorBaseRing`. -/
theorem exists_section_tensorBaseRing_of_strictlyHenselian
    (hsource : IsPullback F.mapArrows.left G'.source.left G.source.left F.mapObjects.left)
    (htarget : IsPullback F.mapArrows.left G'.target.left G.target.left F.mapObjects.left)
    (hstab : IsPullback (stabilizerMap F).left (stabilizer G').hom (stabilizer G).hom
      F.mapObjects.left)
    (C₁ : Type u) [CommRing C₁] [Algebra (invariantRing G) C₁]
    [Module.Flat (invariantRing G) C₁] [StrictlyHenselianLocalRing C₁]
    (bc : AffineInvariantBaseChange G C₁)
    (bc' : AffineInvariantBaseChange G' (tensorBaseRing F C₁))
    (x : Spec (.of (tensorBaseRing F C₁)))
    (hx : (Spec.map (CommRingCat.ofHom (tensorBaseRingMap F C₁))).base x =
      (IsLocalRing.closedPoint C₁ : Spec (.of C₁))) :
    ∃ σ : bc.groupoid.objects.left ⟶ bc'.groupoid.objects.left, IsOpenImmersion σ ∧
      σ ≫ tensorMapObjects F bc bc' = 𝟙 bc.groupoid.objects.left ∧
      IsClosed (Set.range σ.base) ∧ IsInvariantSet bc'.groupoid (Set.range σ.base) ∧
      ∃ u' : bc'.groupoid.objects.left, u' ∈ Set.range σ.base ∧
        bc'.groupoid.objects.hom.base u' = x :=
  exists_section_of_strictlyHenselian_of_bijective F (tensorBaseRingMap F C₁)
    (tensorBaseRing_compatible F C₁) bc bc' hsource htarget hstab
    (canonicalMapToInvariantFunctions_bijective_of_flat bc)
    (canonicalMapToInvariantFunctions_bijective_of_flat bc')
    (etale_baseChangeMapObjects_tensorBaseRing F C₁ bc bc') x hx

end StrictlyHenselian

/-! ### The sheet of a section as an idempotent of a tensor product -/

section Datum

/-- An isomorphism of `CommRingCat` is injective on elements. Stated for an abstract isomorphism so
that it can be instantiated at the identification of the coordinate ring of a base change with a
tensor product without any rewrite inside that term. -/
private theorem iso_hom_apply_injective {R S : CommRingCat.{u}} (i : R ≅ S) {a b : R}
    (h : i.hom a = i.hom b) : a = b := by
  have h2 : i.inv (i.hom a) = i.inv (i.hom b) := congrArg i.inv h
  rwa [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, Iso.hom_inv_id,
    CommRingCat.id_apply, CommRingCat.id_apply] at h2

/-- The forward map of an isomorphism of `CommRingCat` undoes its inverse. -/
private theorem iso_hom_inv_apply {R S : CommRingCat.{u}} (i : R ≅ S) (x : S) :
    i.hom (i.inv.hom x) = x := congr($(i.inv_hom_id).hom x)

/-- An ideal generated by one element is contained in another exactly when that element is. -/
private theorem le_iff_mem_of_eq_span_singleton {R : Type u} [CommRing R] {I J : Ideal R} {a : R}
    (h : I = Ideal.span {a}) : I ≤ J ↔ a ∈ J := by
  subst h
  rw [Ideal.span_le, Set.singleton_subset_iff]
  exact Iff.rfl

/-- Membership in an ideal is unchanged by rewriting the element. -/
private theorem mem_iff_of_eq {R : Type u} [CommRing R] {I : Ideal R} {a b : R} (h : a = b) :
    a ∈ I ↔ b ∈ I := by rw [h]

/-- The image of an idempotent under a ring homomorphism is an idempotent. Stated over abstract
rings so that no rewrite takes place inside a coordinate ring of a base change. -/
private theorem isIdempotentElem_ringHom {R S : Type u} [CommRing R] [CommRing S] (f : R →+* S)
    {e : R} (he : IsIdempotentElem e) : IsIdempotentElem (f e) := by
  show f e * f e = f e
  rw [← map_mul, he]

/-- The generator of the kernel of a map read through identifications of its source and its target,
in the direction opposite to `CommRingCat.ker_eq_span_singleton_of_iso_comp`: the kernel of
`i⁻¹ ≫ T ≫ j` is generated by the image under `i` of a generator of the kernel of `T`. -/
private theorem ker_eq_span_singleton_iso_comp {R R' S S' : CommRingCat.{u}} (i : R ≅ R')
    (j : S ≅ S') (T : R ⟶ S) {e : R} (h : RingHom.ker T.hom = Ideal.span {e}) :
    RingHom.ker (i.inv ≫ T ≫ j.hom).hom = Ideal.span {i.hom e} := by
  have hc : i.symm.inv ≫ (i.inv ≫ T ≫ j.hom) ≫ j.symm.hom = T := by
    simp only [Iso.symm_inv, Iso.symm_hom, Category.assoc, Iso.hom_inv_id, Category.comp_id,
      Iso.hom_inv_id_assoc]
  have hkey := CommRingCat.ker_eq_span_singleton_of_iso_comp i.symm j.symm (i.inv ≫ T ≫ j.hom)
    (show RingHom.ker (i.symm.inv ≫ (i.inv ≫ T ≫ j.hom) ≫ j.symm.hom).hom =
      Ideal.span {e} by rw [hc]; exact h)
  simpa only [Iso.symm_inv] using hkey

variable [IsAffine G.objects.left] [IsAffine G.arrows.left]
  [IsAffine G'.objects.left] [IsAffine G'.arrows.left] [Etale F.mapObjects.left]
  {C₁ : Type u} [CommRing C₁] [Algebra (invariantRing G) C₁]
  (bc : AffineInvariantBaseChange G C₁)
  (bc' : AffineInvariantBaseChange G' (tensorBaseRing F C₁))

omit [IsAffine G.objects.left] [IsAffine G.arrows.left] [Etale F.mapObjects.left] in
/-- The equation `(s'^♯ ⊗ id) e = (t'^♯ ⊗ id) e` holds exactly when the zero locus of the
corresponding global function is invariant. -/
private theorem map_sourceAlgHom_eq_iff_sourceMap_eq
    (e : letI := objectRingAlgebraOfHom F; Γ(G'.objects.left, ⊤) ⊗[invariantRing G] C₁) :
    (letI := objectRingAlgebraOfHom F
     letI := arrowRingAlgebraOfHom F
     Algebra.TensorProduct.map (sourceAlgHomOfHom F) (AlgHom.id (invariantRing G) C₁) e =
       Algebra.TensorProduct.map (targetAlgHomOfHom F) (AlgHom.id (invariantRing G) C₁) e) ↔
    (letI := objectRingAlgebraOfHom F
     sourceMap bc'.groupoid ((objectsTensorBaseRingIso F C₁ bc').hom e) =
       targetMap bc'.groupoid ((objectsTensorBaseRingIso F C₁ bc').hom e)) :=
  let := objectRingAlgebraOfHom F
  let := arrowRingAlgebraOfHom F
  have hs := sourceMap_objectsTensorBaseRingIso F C₁ bc' e
  have ht := targetMap_objectsTensorBaseRingIso F C₁ bc' e
  ⟨fun hinv => (hs.trans (congrArg (arrowsTensorBaseRingIso F C₁ bc').hom hinv)).trans ht.symm,
    fun h => iso_hom_apply_injective (arrowsTensorBaseRingIso F C₁ bc')
      (hs.symm.trans (h.trans ht))⟩

omit [IsAffine G.objects.left] [IsAffine G.arrows.left] [Etale F.mapObjects.left] in
/-- Invariance of the zero locus of an element of `A' ⊗[C] C₁` is the single equation
`(s'^♯ ⊗ id) e = (t'^♯ ⊗ id) e`. -/
private theorem sourceMap_eq_targetMap_objectsTensorBaseRingIso
    (e : letI := objectRingAlgebraOfHom F; Γ(G'.objects.left, ⊤) ⊗[invariantRing G] C₁)
    (hinv : letI := objectRingAlgebraOfHom F
      letI := arrowRingAlgebraOfHom F
      Algebra.TensorProduct.map (sourceAlgHomOfHom F) (AlgHom.id (invariantRing G) C₁) e =
        Algebra.TensorProduct.map (targetAlgHomOfHom F) (AlgHom.id (invariantRing G) C₁) e) :
    letI := objectRingAlgebraOfHom F
    sourceMap bc'.groupoid ((objectsTensorBaseRingIso F C₁ bc').hom e) =
      targetMap bc'.groupoid ((objectsTensorBaseRingIso F C₁ bc').hom e) :=
  (map_sourceAlgHom_eq_iff_sourceMap_eq F bc' e).mp hinv

omit [IsAffine G.arrows.left] in
/-- **The sheet of a section, read as an idempotent of `A' ⊗[C] C₁`.** A section of the
base-changed map on object schemes whose range is invariant determines an idempotent of
`A' ⊗[C] C₁` which generates the kernel of the attached retraction on tensor products, satisfies
the invariance equation `(s'^♯ ⊗ id) e = (t'^♯ ⊗ id) e`, and cuts out the range of the section.

This is the datum that the descent along a filtered colimit of étale algebras carries. -/
theorem exists_isIdempotentElem_ker_tensorRetraction_of_section
    {σ : bc.groupoid.objects.left ⟶ bc'.groupoid.objects.left}
    (hσ : σ ≫ tensorMapObjects F bc bc' = 𝟙 bc.groupoid.objects.left)
    (hinvσ : IsInvariantSet bc'.groupoid (Set.range σ.base)) :
    letI := objectRingAlgebraOfHom F
    letI := arrowRingAlgebraOfHom F
    ∃ e : Γ(G'.objects.left, ⊤) ⊗[invariantRing G] C₁, IsIdempotentElem e ∧
      RingHom.ker (tensorRetraction F
          (bc'.objectsProjection.appTop ≫ σ.appTop ≫ (objectsBaseChangeIso bc).inv)
          (appTop_comp_section_comp_objectsBaseChangeIso_inv F bc bc' hσ)).hom =
        Ideal.span {e} ∧
      Algebra.TensorProduct.map (sourceAlgHomOfHom F) (AlgHom.id (invariantRing G) C₁) e =
        Algebra.TensorProduct.map (targetAlgHomOfHom F) (AlgHom.id (invariantRing G) C₁) e ∧
      ∀ y : bc'.groupoid.objects.left, y ∈ Set.range σ.base ↔
        (objectsTensorBaseRingIso F C₁ bc').hom e ∈
          (bc'.groupoid.objects.left.carrierEquivPrimeSpectrum y).asIdeal := by
  let := objectRingAlgebraOfHom F
  let := arrowRingAlgebraOfHom F
  have hA : IsAffine bc.groupoid.objects.left := inferInstance
  have hA' : IsAffine bc'.groupoid.objects.left := inferInstance
  have hEt : Etale (tensorMapObjects F bc bc') :=
    etale_baseChangeMapObjects_tensorBaseRing F C₁ bc bc'
  have key : ∃ ε : Γ(bc'.groupoid.objects.left, ⊤), IsIdempotentElem ε ∧
      RingHom.ker σ.appTop.hom = Ideal.span {ε} ∧
      ∀ y : bc'.groupoid.objects.left, y ∈ Set.range σ.base ↔
        ε ∈ (bc'.groupoid.objects.left.carrierEquivPrimeSpectrum y).asIdeal :=
    @exists_isIdempotentElem_ker_appTop_of_section
      bc.groupoid.objects.left bc'.groupoid.objects.left hA hA' (tensorMapObjects F bc bc') σ
      hEt hσ
  obtain ⟨ε, hε, hker, hmem⟩ := key
  have hback := iso_hom_inv_apply (objectsTensorBaseRingIso F C₁ bc') ε
  have hinvε : sourceMap bc'.groupoid ε = targetMap bc'.groupoid ε :=
    sourceMap_eq_targetMap_of_isInvariantSet bc'.groupoid ε hε
      (fun r hr => (hmem _).mp (hinvσ r ((hmem _).mpr hr)))
  exact ⟨(objectsTensorBaseRingIso F C₁ bc').inv.hom ε,
    isIdempotentElem_ringHom (objectsTensorBaseRingIso F C₁ bc').inv.hom hε,
    ker_tensorRetraction_of_section F bc bc' hσ ε hker,
    (map_sourceAlgHom_eq_iff_sourceMap_eq F bc' _).mpr
      ((congrArg (sourceMap bc'.groupoid) hback).trans
        (hinvε.trans (congrArg (targetMap bc'.groupoid) hback).symm)),
    fun y => (hmem y).trans (mem_iff_of_eq hback.symm)⟩

omit [IsAffine G.arrows.left] in
/-- **The section cut out by an idempotent with the invariance equation.** Conversely to
`AlgebraicGeometry.GroupoidScheme.exists_isIdempotentElem_ker_tensorRetraction_of_section`, an
`A`-algebra map `A' ⟶ A ⊗[C] C₁` whose attached retraction on tensor products has kernel generated
by an idempotent satisfying the invariance equation determines a section of the base-changed map on
object schemes whose range is an invariant clopen cutting out that idempotent. -/
theorem exists_section_of_isIdempotentElem_ker_tensorRetraction
    (g : Γ(G'.objects.left, ⊤) ⟶ CommRingCat.of (objectRingBaseChange G C₁))
    (hg : F.mapObjects.left.appTop ≫ g =
      CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
        Γ(G.objects.left, ⊤) →+* objectRingBaseChange G C₁))
    (e : letI := objectRingAlgebraOfHom F; Γ(G'.objects.left, ⊤) ⊗[invariantRing G] C₁)
    (hker : letI := objectRingAlgebraOfHom F
      RingHom.ker (tensorRetraction F g hg).hom = Ideal.span {e})
    (hinv : letI := objectRingAlgebraOfHom F
      letI := arrowRingAlgebraOfHom F
      Algebra.TensorProduct.map (sourceAlgHomOfHom F) (AlgHom.id (invariantRing G) C₁) e =
        Algebra.TensorProduct.map (targetAlgHomOfHom F) (AlgHom.id (invariantRing G) C₁) e) :
    ∃ σ : bc.groupoid.objects.left ⟶ bc'.groupoid.objects.left, IsOpenImmersion σ ∧
      σ ≫ tensorMapObjects F bc bc' = 𝟙 bc.groupoid.objects.left ∧
      IsClosed (Set.range σ.base) ∧ IsInvariantSet bc'.groupoid (Set.range σ.base) ∧
      ∀ y : bc'.groupoid.objects.left, y ∈ Set.range σ.base ↔
        (objectsTensorBaseRingIso F C₁ bc').hom e ∈
          (bc'.groupoid.objects.left.carrierEquivPrimeSpectrum y).asIdeal := by
  let := objectRingAlgebraOfHom F
  let := arrowRingAlgebraOfHom F
  have hA : IsAffine bc.groupoid.objects.left := inferInstance
  have hA' : IsAffine bc'.groupoid.objects.left := inferInstance
  have hEt : Etale (tensorMapObjects F bc bc') :=
    etale_baseChangeMapObjects_tensorBaseRing F C₁ bc bc'
  have hτ : ((retractionAppTop F bc bc' g hg).hom).comp
      (tensorMapObjects F bc bc').appTop.hom = RingHom.id Γ(bc.groupoid.objects.left, ⊤) :=
    RingHom.ext fun a =>
      congr($(baseChange_appTop_comp_retractionAppTop F bc bc' g hg).hom a)
  have key : ∃ σ : bc.groupoid.objects.left ⟶ bc'.groupoid.objects.left, IsOpenImmersion σ ∧
      σ ≫ tensorMapObjects F bc bc' = 𝟙 bc.groupoid.objects.left ∧
      IsClosed (Set.range σ.base) ∧
      ∀ y : bc'.groupoid.objects.left, y ∈ Set.range σ.base ↔
        RingHom.ker (retractionAppTop F bc bc' g hg).hom ≤
          (bc'.groupoid.objects.left.carrierEquivPrimeSpectrum y).asIdeal :=
    @exists_section_of_retraction_of_etale
      bc.groupoid.objects.left bc'.groupoid.objects.left hA hA' (tensorMapObjects F bc bc') hEt
      (retractionAppTop F bc bc' g hg).hom hτ
  obtain ⟨σ, hoi, hσ, hcl, hmem⟩ := key
  have hker' : RingHom.ker (retractionAppTop F bc bc' g hg).hom =
      Ideal.span {(objectsTensorBaseRingIso F C₁ bc').hom e} :=
    ker_eq_span_singleton_iso_comp (objectsTensorBaseRingIso F C₁ bc')
      (objectsBaseChangeIso bc) (tensorRetraction F g hg) hker
  have hmem' : ∀ y : bc'.groupoid.objects.left, y ∈ Set.range σ.base ↔
      (objectsTensorBaseRingIso F C₁ bc').hom e ∈
        (bc'.groupoid.objects.left.carrierEquivPrimeSpectrum y).asIdeal := fun y =>
    (hmem y).trans (le_iff_mem_of_eq_span_singleton hker')
  have hiv := isInvariantSet_zeroLocus_of_sourceMap_eq_targetMap bc'.groupoid
    ((objectsTensorBaseRingIso F C₁ bc').hom e)
    (sourceMap_eq_targetMap_objectsTensorBaseRingIso F bc' e hinv)
  exact ⟨σ, hoi, hσ, hcl, fun r hr => (hmem' _).mpr (hiv r ((hmem' _).mp hr)), hmem'⟩

end Datum

/-! ### The descent of the datum to an étale stage -/

section Descent

/-- Changing the base ring of the `AlgHom.id` factor of a tensor product map does not change the
underlying function. -/
private theorem map_id_apply_eq {R A B D : Type u} [CommRing R] [CommRing A] [CommRing B]
    [CommRing D] [Algebra R A] [Algebra R B] [Algebra R D] (h : B →ₐ[R] D) (z : A ⊗[R] B) :
    Algebra.TensorProduct.map (AlgHom.id A A) h z =
      Algebra.TensorProduct.map (AlgHom.id R A) h z := rfl

/-- The two tensor product maps out of `A ⊗[R] C₁` built from a map of the left and a map of the
right factor commute, both composites being the map of the pair. -/
private theorem map_id_comm {R A B C₁ C₂ : Type u} [CommRing R] [CommRing A] [CommRing B]
    [CommRing C₁] [CommRing C₂] [Algebra R A] [Algebra R B] [Algebra R C₁] [Algebra R C₂]
    (f : A →ₐ[R] B) (h : C₁ →ₐ[R] C₂) :
    (Algebra.TensorProduct.map f (AlgHom.id R C₂)).comp
        (Algebra.TensorProduct.map (AlgHom.id R A) h) =
      (Algebra.TensorProduct.map (AlgHom.id R B) h).comp
        (Algebra.TensorProduct.map f (AlgHom.id R C₁)) := by
  rw [← Algebra.TensorProduct.map_comp, ← Algebra.TensorProduct.map_comp, AlgHom.comp_id,
    AlgHom.id_comp, AlgHom.id_comp, AlgHom.comp_id]

/-- The base change of a map of the right tensor factor fixes the left factor. -/
private theorem map_id_includeLeft {R A C₁ C₂ : Type u} [CommRing R] [CommRing A] [CommRing C₁]
    [CommRing C₂] [Algebra R A] [Algebra R C₁] [Algebra R C₂] (h : C₁ →ₐ[R] C₂) (a : A) :
    Algebra.TensorProduct.map (AlgHom.id R A) h
        (Algebra.TensorProduct.includeLeftRingHom a) =
      (Algebra.TensorProduct.includeLeftRingHom a : A ⊗[R] C₂) := by
  show Algebra.TensorProduct.map (AlgHom.id R A) h (a ⊗ₜ (1 : C₁)) = a ⊗ₜ (1 : C₂)
  rw [Algebra.TensorProduct.map_tmul, map_one]
  rfl

/-- The composite of two consecutive tensor product maps of the right factor. -/
private theorem map_id_comp_apply {R A C₁ C₂ C₃ : Type u} [CommRing R] [CommRing A] [CommRing C₁]
    [CommRing C₂] [CommRing C₃] [Algebra R A] [Algebra R C₁] [Algebra R C₂] [Algebra R C₃]
    (h : C₂ →ₐ[R] C₃) (φ : C₁ →ₐ[R] C₂) (z : A ⊗[R] C₁) :
    Algebra.TensorProduct.map (AlgHom.id R A) h
        (Algebra.TensorProduct.map (AlgHom.id R A) φ z) =
      Algebra.TensorProduct.map (AlgHom.id R A) (h.comp φ) z := by
  have hkey := Algebra.TensorProduct.map_comp (AlgHom.id R A) (AlgHom.id R A) h φ
  rw [AlgHom.id_comp] at hkey
  exact (DFunLike.congr_fun hkey z).symm

/-- Pushing the image of an element of a stage forward along a map of the left tensor factor. -/
theorem map_push {R A B C₀ Λ : Type u} [CommRing R] [CommRing A] [CommRing B]
    [CommRing C₀] [CommRing Λ] [Algebra R A] [Algebra R B] [Algebra R C₀] [Algebra R Λ]
    (f : A →ₐ[R] B) (h₀ : C₀ →ₐ[R] Λ) {e : A ⊗[R] Λ} {e₀ : A ⊗[R] C₀}
    (heq₀ : e = Algebra.TensorProduct.map (AlgHom.id R A) h₀ e₀) :
    Algebra.TensorProduct.map (AlgHom.id B B) h₀
        (Algebra.TensorProduct.map f (AlgHom.id R C₀) e₀) =
      Algebra.TensorProduct.map f (AlgHom.id R Λ) e :=
  (map_id_apply_eq h₀ _).trans
    ((DFunLike.congr_fun (map_id_comm f h₀) e₀).symm.trans
      (congrArg (Algebra.TensorProduct.map f (AlgHom.id R Λ)) heq₀.symm))

/-- An equation between the images of two elements of a stage, read at the next stage. -/
theorem map_eq_of_map_eq {R A B C₁ C₂ : Type u} [CommRing R] [CommRing A] [CommRing B]
    [CommRing C₁] [CommRing C₂] [Algebra R A] [Algebra R B] [Algebra R C₁] [Algebra R C₂]
    (s t : A →ₐ[R] B) (φ : C₁ →ₐ[R] C₂) {e₀ : A ⊗[R] C₁} {eD : A ⊗[R] C₂}
    (heqD' : eD = Algebra.TensorProduct.map (AlgHom.id R A) φ e₀)
    (heqD : Algebra.TensorProduct.map (AlgHom.id B B) φ
        (Algebra.TensorProduct.map s (AlgHom.id R C₁) e₀) =
      Algebra.TensorProduct.map (AlgHom.id B B) φ
        (Algebra.TensorProduct.map t (AlgHom.id R C₁) e₀)) :
    Algebra.TensorProduct.map s (AlgHom.id R C₂) eD =
      Algebra.TensorProduct.map t (AlgHom.id R C₂) eD :=
  ((congrArg (Algebra.TensorProduct.map s (AlgHom.id R C₂)) heqD').trans
    ((DFunLike.congr_fun (map_id_comm s φ) e₀).trans
      (((map_id_apply_eq φ _).symm.trans (heqD.trans (map_id_apply_eq φ _))).trans
        (DFunLike.congr_fun (map_id_comm t φ) e₀).symm))).trans
    (congrArg (Algebra.TensorProduct.map t (AlgHom.id R C₂)) heqD').symm

/-- Composing the two stage maps: an element presented at the first stage is the image of its
presentation at the second. -/
theorem eq_map_of_eq_map_comp {R A C₀ C₁ Λ : Type u} [CommRing R] [CommRing A]
    [CommRing C₀] [CommRing C₁] [CommRing Λ] [Algebra R A] [Algebra R C₀] [Algebra R C₁]
    [Algebra R Λ] (hD : C₁ →ₐ[R] Λ) (φ : C₀ →ₐ[R] C₁) {h₀ : C₀ →ₐ[R] Λ}
    (hφ : hD.comp φ = h₀) {e : A ⊗[R] Λ} {e₀ : A ⊗[R] C₀} {eD : A ⊗[R] C₁}
    (heq₀ : e = Algebra.TensorProduct.map (AlgHom.id R A) h₀ e₀)
    (heqD' : eD = Algebra.TensorProduct.map (AlgHom.id R A) φ e₀) :
    e = Algebra.TensorProduct.map (AlgHom.id R A) hD eD :=
  heq₀.trans
    (((congrArg (fun k : C₀ →ₐ[R] Λ => Algebra.TensorProduct.map (AlgHom.id R A) k e₀)
        hφ).symm.trans (map_id_comp_apply hD φ e₀).symm).trans
      (congrArg (Algebra.TensorProduct.map (AlgHom.id R A) hD) heqD'.symm))

variable [IsAffine G.objects.left] [IsAffine G.arrows.left]
  [IsAffine G'.objects.left] [IsAffine G'.arrows.left] [Etale F.mapObjects.left]
  [IsFiniteLocallyFree G.source.left] [IsFiniteLocallyFree G.target.left]
  [IsFiniteLocallyFree G'.source.left] [IsFiniteLocallyFree G'.target.left]
  {C₁ : Type u} [CommRing C₁] [Algebra (invariantRing G) C₁]

/-- **The kernel of the retraction on tensor products attached to an `A`-algebra map
`A' ⟶ A ⊗[C] C₁` is generated by an idempotent.** The retraction of coordinate rings it induces at
a base change is a retraction of an étale morphism of affine schemes, so its kernel is generated by
an idempotent, and that generator is carried onto the tensor product by the identification of the
coordinate ring of the base change. -/
theorem exists_isIdempotentElem_ker_tensorRetraction
    (g : Γ(G'.objects.left, ⊤) ⟶ CommRingCat.of (objectRingBaseChange G C₁))
    (hg : F.mapObjects.left.appTop ≫ g =
      CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
        Γ(G.objects.left, ⊤) →+* objectRingBaseChange G C₁)) :
    letI := objectRingAlgebraOfHom F
    ∃ e : Γ(G'.objects.left, ⊤) ⊗[invariantRing G] C₁, IsIdempotentElem e ∧
      RingHom.ker (tensorRetraction F g hg).hom = Ideal.span {e} := by
  let := objectRingAlgebraOfHom F
  obtain ⟨bc⟩ := exists_affineInvariantBaseChange G C₁
  obtain ⟨bc'⟩ := exists_affineInvariantBaseChange G' (tensorBaseRing F C₁)
  have hA : IsAffine bc.groupoid.objects.left := inferInstance
  have hA' : IsAffine bc'.groupoid.objects.left := inferInstance
  have hEt : Etale (tensorMapObjects F bc bc') :=
    etale_baseChangeMapObjects_tensorBaseRing F C₁ bc bc'
  have key : ∃ ε : Γ(bc'.groupoid.objects.left, ⊤), IsIdempotentElem ε ∧
      RingHom.ker (retractionAppTop F bc bc' g hg).hom = Ideal.span {ε} :=
    @exists_isIdempotentElem_ker_of_retraction_of_etale bc.groupoid.objects.left
      bc'.groupoid.objects.left hA hA' (tensorMapObjects F bc bc') hEt
      (retractionAppTop F bc bc' g hg) (baseChange_appTop_comp_retractionAppTop F bc bc' g hg)
  obtain ⟨ε, hε, hker⟩ := key
  exact ⟨(objectsTensorBaseRingIso F C₁ bc').inv.hom ε,
    isIdempotentElem_ringHom (objectsTensorBaseRingIso F C₁ bc').inv.hom hε,
    CommRingCat.ker_eq_span_singleton_of_iso_comp (objectsTensorBaseRingIso F C₁ bc')
      (objectsBaseChangeIso bc) (tensorRetraction F g hg) hker⟩

omit [IsAffine G.arrows.left] [IsAffine G'.arrows.left]
  [IsFiniteLocallyFree G.source.left] [IsFiniteLocallyFree G.target.left]
  [IsFiniteLocallyFree G'.source.left] [IsFiniteLocallyFree G'.target.left] in
/-- **An `A`-algebra map `A' ⟶ A ⊗[C] Λ` into an ind-étale extension factors through a single
étale stage.** The map is of finite presentation over `A`, because `f : U' ⟶ U` is étale, so
`StacksDraft.exists_etale_stage_of_indEtale` applies; what is added here is the translation between
an `A`-algebra homomorphism and a morphism of `CommRingCat` out of `A'` with the prescribed
restriction to `A`. -/
theorem exists_etale_stage_map {Λ : Type u} [CommRing Λ] [Algebra (invariantRing G) Λ]
    (hΛ : StacksDraft.IndEtale (invariantRing G) Λ)
    (g : Γ(G'.objects.left, ⊤) ⟶ CommRingCat.of (objectRingBaseChange G Λ))
    (hg : F.mapObjects.left.appTop ≫ g =
      CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
        Γ(G.objects.left, ⊤) →+* objectRingBaseChange G Λ)) :
    ∃ (D : Type u) (_ : CommRing D) (_ : Algebra (invariantRing G) D),
      Algebra.Etale (invariantRing G) D ∧
      ∃ (hD : D →ₐ[invariantRing G] Λ)
        (gD : Γ(G'.objects.left, ⊤) ⟶ CommRingCat.of (objectRingBaseChange G D))
        (_ : F.mapObjects.left.appTop ≫ gD =
          CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
            Γ(G.objects.left, ⊤) →+* objectRingBaseChange G D)),
        gD ≫ CommRingCat.ofHom (Algebra.TensorProduct.map
          (AlgHom.id (invariantRing G) Γ(G.objects.left, ⊤)) hD).toRingHom = g := by
  let := objectRingAlgebraMapObjects F
  have hetA : Algebra.Etale Γ(G.objects.left, ⊤) Γ(G'.objects.left, ⊤) :=
    RingHom.etale_algebraMap.mp
      (HasRingHomProperty.appTop (P := @Etale) F.mapObjects.left inferInstance)
  obtain ⟨D, hCRD, hAlgD, hDet, hD, g₀, hcompat₀⟩ :=
    StacksDraft.exists_etale_stage_of_indEtale hΛ
      (inferInstance : Algebra.FinitePresentation Γ(G.objects.left, ⊤) Γ(G'.objects.left, ⊤))
      { __ := g.hom, commutes' := fun a => congr($(hg).hom a) }
  refine ⟨D, hCRD, hAlgD, hDet, hD,
    CommRingCat.ofHom (g₀ : Γ(G'.objects.left, ⊤) →+* objectRingBaseChange G D),
    CommRingCat.hom_ext (RingHom.ext fun a => g₀.commutes a), ?_⟩
  exact CommRingCat.hom_ext (RingHom.ext fun a' =>
    (map_id_apply_eq hD (g₀ a')).symm.trans (DFunLike.congr_fun hcompat₀ a'))

omit [IsAffine G.objects.left] [IsAffine G.arrows.left] [IsAffine G'.objects.left]
  [IsAffine G'.arrows.left] [Etale F.mapObjects.left]
  [IsFiniteLocallyFree G.source.left] [IsFiniteLocallyFree G.target.left]
  [IsFiniteLocallyFree G'.source.left] [IsFiniteLocallyFree G'.target.left] in
/-- **Moving an `A`-algebra map `A' ⟶ A ⊗[C] C₁` along a map `C₁ ⟶ C₂` of extensions.** -/
theorem exists_map_of_algHom {C₂ : Type u} [CommRing C₂] [Algebra (invariantRing G) C₂]
    (φ : C₁ →ₐ[invariantRing G] C₂)
    (g : Γ(G'.objects.left, ⊤) ⟶ CommRingCat.of (objectRingBaseChange G C₁))
    (hg : F.mapObjects.left.appTop ≫ g =
      CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
        Γ(G.objects.left, ⊤) →+* objectRingBaseChange G C₁)) :
    ∃ (g₂ : Γ(G'.objects.left, ⊤) ⟶ CommRingCat.of (objectRingBaseChange G C₂))
      (_ : F.mapObjects.left.appTop ≫ g₂ =
        CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom :
          Γ(G.objects.left, ⊤) →+* objectRingBaseChange G C₂)),
      g ≫ CommRingCat.ofHom (Algebra.TensorProduct.map
        (AlgHom.id (invariantRing G) Γ(G.objects.left, ⊤)) φ).toRingHom = g₂ :=
  ⟨g ≫ CommRingCat.ofHom (Algebra.TensorProduct.map
      (AlgHom.id (invariantRing G) Γ(G.objects.left, ⊤)) φ).toRingHom,
    (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ CommRingCat.ofHom (Algebra.TensorProduct.map
          (AlgHom.id (invariantRing G) Γ(G.objects.left, ⊤)) φ).toRingHom) hg).trans
        (CommRingCat.hom_ext (RingHom.ext fun a => map_id_includeLeft φ a))),
    rfl⟩

/-- Membership of a prime of the target is membership of the pullback in the prime of the
source. -/
theorem mem_comap_iff {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y] (f : X ⟶ Y) (x : X)
    (a : Γ(Y, ⊤)) :
    a ∈ (Y.carrierEquivPrimeSpectrum (f.base x)).asIdeal ↔
      f.appTop.hom a ∈ (X.carrierEquivPrimeSpectrum x).asIdeal := by
  rw [Scheme.carrierEquivPrimeSpectrum_naturality f x]
  exact Iff.rfl

/-- Applying a morphism of `CommRingCat` through its coercion is applying its ring
homomorphism. -/
theorem coe_hom_apply {R S : CommRingCat.{u}} (f : R ⟶ S) (x : R) : f x = f.hom x := rfl

/-- Two equal morphisms of schemes agree on points. -/
theorem base_congr {X Y : Scheme.{u}} {f g : X ⟶ Y} (h : f = g) (x : X) :
    f.base x = g.base x := congrArg (fun k : X ⟶ Y => k.base x) h

/-- **The map on invariant rings is étale at the image of a point of the sheet of an invariant
section.** This is `AlgebraicGeometry.GroupoidScheme.etaleAt_specMap_invariantRingMap_of_section`
read at the point of the invariant spectrum of the sheet determined by a point of `U`, as in the
proof of `AlgebraicGeometry.GroupoidScheme.etaleAt_specMap_invariantRingMap_of_strictlyHenselian`.

Stated for an abstract morphism of groupoid schemes so that it can be instantiated at a morphism of
base changes without the identification of the sheet's map on object schemes with the inclusion of
the open being unfolded inside that term.

Both the open immersion hypothesis and the invariance hypothesis are taken as explicit arguments
about `Set.range σ.base`, rather than as an instance and a statement about `σ.opensRange`: at a
morphism of base changes the codomain of the section is the object scheme of a pushforward, which
is only definitionally the object scheme itself, and instance search does not bridge that gap. -/
theorem etaleAt_specMap_invariantRingMap_section_point {S : Scheme.{u}}
    {H H' : GroupoidScheme S} (E : GroupoidScheme.Hom H' H) [IsAffine H.objects.left]
    [IsAffine H.arrows.left] [IsAffine H'.objects.left] [IsAffine H'.arrows.left]
    (hsource : IsPullback E.mapArrows.left H'.source.left H.source.left E.mapObjects.left)
    {σ : H.objects.left ⟶ H'.objects.left} (hoi : IsOpenImmersion σ)
    (hσ : σ ≫ E.mapObjects.left = 𝟙 H.objects.left) (hcl : IsClosed (Set.range σ.base))
    (hV : IsInvariantSet H' (Set.range σ.base)) (v : H.objects.left) :
    EtaleAt (Spec.map (CommRingCat.ofHom (invariantRingMap E)))
      ((objectsToInvariantSpectrum H').base (σ.base v)) := by
  have := hoi
  have hV' : IsInvariantOpen H' σ.opensRange := hV
  have hpt : (restrictInvariantOpenHom H' σ.opensRange hV').mapObjects.left.base
      ((liftSection σ).base v) = σ.base v :=
    congrArg (fun k : H.objects.left ⟶ H'.objects.left => k.base v) (liftSection_ι (σ := σ))
  have hbase := base_objectsToInvariantSpectrum_mapObjects
    (restrictInvariantOpenHom H' σ.opensRange hV') ((liftSection σ).base v)
  rw [hpt] at hbase
  rw [hbase]
  exact etaleAt_specMap_invariantRingMap_of_section E hsource hσ hcl hV' _

/-- **An étale cover through a point at which a morphism is étale.** Given a commuting square
`m ≫ n = f ≫ r` with `m` and `r` étale and `f` étale at a point `x`, the morphism `n` has an étale
morphism through `m.base x` whose composite with it is étale: an affine open neighbourhood of `x`
on which `f` is étale, followed by `m`.

Stated for abstract schemes so that its proof is carried out on small terms. -/
theorem exists_etale_comp_of_etaleAt_of_square {X Y Z T : Scheme.{u}} (f : X ⟶ Y)
    (m : X ⟶ Z) (n : Z ⟶ T) (r : Y ⟶ T) [Etale m] [Etale r] (hsq : m ≫ n = f ≫ r) {x : X}
    (hx : EtaleAt f x) {z : Z} (hz : m.base x = z) :
    ∃ (W : Scheme.{u}) (gg : W ⟶ Z), Etale gg ∧ Etale (gg ≫ n) ∧ z ∈ Set.range gg.base := by
  obtain ⟨V, hVaff, hxV, hEtV⟩ := exists_isAffineOpen_etale_comp_ι_of_etaleAt f x hx
  have := hEtV
  refine ⟨V.toScheme, V.ι ≫ m, inferInstance, ?_, ⟨⟨x, hxV⟩, hz⟩⟩
  rw [Category.assoc, hsq, ← Category.assoc]
  infer_instance

end Descent

end AlgebraicGeometry.GroupoidScheme

