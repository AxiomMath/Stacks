module

public import StacksFrontier.AlgebraicGeometry.Groupoids.FiniteFlatAffine.StrictlyHenselianSplitting
public import StacksFrontier.AlgebraicGeometry.Scheme.SectionOfRetraction

/-!
# The section of `U' ⟶ U` produced by the splitting of the object ring

The "Claim" in the proof of [Stacks Project, Tag 0DT9] splits `A' = Γ(U', ⊤)` as a product
`A × A''` of `A = Γ(U, ⊤)`-algebras over a strictly henselian invariant ring. This file reads
that splitting geometrically: the first projection `τ : A' → A` is a retraction of `A → A'`, so
`Spec` of it is a **section** `σ : U ⟶ U'` of `f : U' ⟶ U`, its image is **open and closed** — the
kernel of a retraction of an étale algebra is generated by an idempotent, and the image is the
zero locus of that kernel — and it **contains the fibre** `U'_{p'}`, because the kernel of `τ`
lies in the ideal cutting out that fibre.

Those three facts are exactly the hypotheses of
`AlgebraicGeometry.GroupoidScheme.isInvariantSet_range_of_section`, so the sheet of `σ` is an
invariant open of `U'`.

## Main results

* `AlgebraicGeometry.GroupoidScheme.exists_section_of_strictlyHenselian`: **the section of
  `U' ⟶ U` of the "Claim" of [Stacks Project, Tag 0DT9]**, an open immersion with closed image
  whose range contains the fibre `U'_{p'}`.

## Implementation notes

The passage from the retraction to the section is
`AlgebraicGeometry.exists_section_of_retraction_of_etale`, which knows nothing of groupoids or of
strict henselianity: all that is used of the situation here is that `f : U' ⟶ U` is étale and that
the splitting provides a retraction of `f^♯`. What is left to do is the containment of the fibre,
which is the one place the reduction statement of the splitting is needed.

## References

* [Stacks Project, Tag 0DT9](https://stacks.math.columbia.edu/tag/0DT9)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Stacks.Groupoids Stacks.Morphisms

noncomputable section

universe u

namespace AlgebraicGeometry

namespace GroupoidScheme

variable {S : Scheme.{u}} {G G' : GroupoidScheme S} (F : GroupoidScheme.Hom G' G)

section StrictlyHenselian

variable [IsAffine G.objects.left] [IsAffine G.arrows.left]
  [IsAffine G'.objects.left] [IsAffine G'.arrows.left]
  [IsFiniteLocallyFree G.source.left] [IsFiniteLocallyFree G.target.left]
  [IsFiniteLocallyFree G'.source.left] [IsFiniteLocallyFree G'.target.left]
  [StrictlyHenselianLocalRing (invariantRing G)] [Etale F.mapObjects.left]

/-- **The section of `f : U' ⟶ U` of the "Claim" of [Stacks Project, Tag 0DT9].** Over a strictly
henselian invariant ring, and for a point `p'` of `Spec C'` above the closed point of `Spec C`,
the morphism `f` admits a section which is an open immersion with closed range, that range
containing the fibre `U'_{p'}`.

The section is `Spec` of the first projection of the ring splitting `A' ≃ A × A''`; its range is
the zero locus of the kernel of that projection, which is generated by an idempotent because `A'`
is étale over `A`, hence open as well as closed; and it contains `U'_{p'}` because that kernel is
contained in the ideal cutting out the fibre, which is the reduction statement of the
splitting. -/
theorem exists_section_of_strictlyHenselian
    (hsource : IsPullback F.mapArrows.left G'.source.left G.source.left F.mapObjects.left)
    (htarget : IsPullback F.mapArrows.left G'.target.left G.target.left F.mapObjects.left)
    (hstab : IsPullback (stabilizerMap F).left (stabilizer G').hom (stabilizer G).hom
      F.mapObjects.left)
    (p' : Spec (.of (invariantRing G')))
    (hp' : (Spec.map (CommRingCat.ofHom (invariantRingMap F))).base p' =
      (IsLocalRing.closedPoint (invariantRing G) : Spec (.of (invariantRing G)))) :
    ∃ σ : G.objects.left ⟶ G'.objects.left, IsOpenImmersion σ ∧
      σ ≫ F.mapObjects.left = 𝟙 G.objects.left ∧ IsClosed (Set.range σ.base) ∧
      ∀ u' : G'.objects.left, (objectsToInvariantSpectrum G').base u' = p' →
        u' ∈ Set.range σ.base := by
  let : Algebra Γ(G.objects.left, ⊤) Γ(G'.objects.left, ⊤) :=
    F.mapObjects.left.appTop.hom.toAlgebra
  have : Algebra.Etale Γ(G.objects.left, ⊤) Γ(G'.objects.left, ⊤) :=
    RingHom.etale_algebraMap.mp
      (HasRingHomProperty.appTop (P := @Etale) F.mapObjects.left inferInstance)
  obtain ⟨A'', _, _, τ, _, _, hker⟩ :=
    exists_algEquiv_prod_appTop_of_strictlyHenselian F hsource htarget hstab p' hp'
  have hτ : τ.toRingHom.comp F.mapObjects.left.appTop.hom = RingHom.id Γ(G.objects.left, ⊤) :=
    RingHom.ext fun a => τ.commutes a
  obtain ⟨σ, hoi, hσ, hclosed, hrange⟩ :=
    exists_section_of_retraction_of_etale F.mapObjects.left τ.toRingHom hτ
  refine ⟨σ, hoi, hσ, hclosed, fun u' hu' => (hrange u').mpr (hker.trans ?_)⟩
  have hp'max : p'.asIdeal.IsMaximal := isMaximal_asIdeal_of_comap_eq_closedPoint F p' hp'
  refine (PrimeSpectrum.comap_eq_iff_radical_map_le (invariantRing G').subtype hp'max
    (G'.objects.left.carrierEquivPrimeSpectrum u')).mp ?_
  rw [Scheme.carrierEquivPrimeSpectrum_apply, ← objectsToInvariantSpectrum_base G' u']
  exact hu'

end StrictlyHenselian

end GroupoidScheme

end AlgebraicGeometry

end

end
