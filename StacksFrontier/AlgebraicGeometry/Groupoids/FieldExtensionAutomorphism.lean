* [Stacks Project, Tag 02YF](https://stacks.math.columbia.edu/tag/02YF)
* [Stacks Project, Tag 04LP](https://stacks.math.columbia.edu/tag/04LP)
-/

@[expose] public section

open Polynomial

namespace Stacks.Groupoids

variable {L K : Type*} [Field L] [Field K] [Algebra L K]

/-- A linear form `e * c + f` with coefficients in `L`, not both zero, is nonzero at an element
`c` transcendental over `L`. -/
theorem linear_ne_zero_of_transcendental {c : K} (hc : Transcendental L c) {e f : L}
    (h : ¬(e = 0 ∧ f = 0)) : algebraMap L K e * c + algebraMap L K f ≠ 0 := by
  intro h0
  have hp : C e * X + C f = (0 : L[X]) := by
    refine transcendental_iff.mp hc _ ?_
    simpa using h0
  exact h ⟨by simpa using congrArg (fun p : L[X] => p.coeff 1) hp,
    by simpa using congrArg (fun p : L[X] => p.coeff 0) hp⟩

/-- If `c` is transcendental over `L` and the matrix `!![a, b; e, f]` over `L` is invertible,
then `(a * c + b) ^ 2 ≠ c * (e * c + f) ^ 2`.

This is the cleared-denominator form of `linearFractional_sq_ne_of_transcendental`.  The reason
is that the polynomial
`X * (e X + f) ^ 2 - (a X + b) ^ 2`, that is,
`e ^ 2 X ^ 3 + (2 e f - a ^ 2) X ^ 2 + (f ^ 2 - 2 a b) X - b ^ 2`,
is nonzero: its degree `3` coefficient is `e ^ 2`, so `e = 0`; its constant coefficient is
`-b ^ 2`, so `b = 0`; its degree `1` coefficient is then `f ^ 2`, so `f = 0`; and that
contradicts `a * f - b * e ≠ 0`. -/
theorem sq_linear_ne_mul_sq_linear_of_transcendental {c : K} (hc : Transcendental L c)
    {a b e f : L} (h : a * f - b * e ≠ 0) :
    (algebraMap L K a * c + algebraMap L K b) ^ 2 ≠
      c * (algebraMap L K e * c + algebraMap L K f) ^ 2 := by
  intro hsq
  have hp : C (e ^ 2) * X ^ 3 + C (2 * e * f - a ^ 2) * X ^ 2 + C (f ^ 2 - 2 * a * b) * X ^ 1
      + C (-b ^ 2) * X ^ 0 = (0 : L[X]) := by
    refine transcendental_iff.mp hc _ ?_
    simp only [map_add, map_mul, map_pow, map_sub, map_ofNat, map_neg, aeval_C, aeval_X]
    linear_combination -hsq
  have hcoeff : ∀ n : ℕ, (C (e ^ 2) * X ^ 3 + C (2 * e * f - a ^ 2) * X ^ 2
      + C (f ^ 2 - 2 * a * b) * X ^ 1 + C (-b ^ 2) * X ^ 0).coeff n = 0 := fun n => by
    rw [hp, coeff_zero]
  have he : e = 0 := by
    have h3 := hcoeff 3
    simp only [coeff_add, coeff_C_mul_X_pow] at h3
    norm_num at h3
    exact h3
  have hb : b = 0 := by
    have h0 := hcoeff 0
    simp only [coeff_add, coeff_C_mul_X_pow] at h0
    norm_num at h0
    exact h0
  have hf : f = 0 := by
    have h1 := hcoeff 1
    simp only [coeff_add, coeff_C_mul_X_pow] at h1
    norm_num [hb] at h1
    exact h1
  exact h (by rw [he, hb, hf]; ring)

/-- No fractional linear transformation with coefficients in `L` carries an element `c`
transcendental over `L` to a square root of `c`. -/
theorem linearFractional_sq_ne_of_transcendental {c : K} (hc : Transcendental L c) {a b e f : L}
    (h : a * f - b * e ≠ 0) :
    ((algebraMap L K a * c + algebraMap L K b) /
      (algebraMap L K e * c + algebraMap L K f)) ^ 2 ≠ c := by
  have hD : algebraMap L K e * c + algebraMap L K f ≠ 0 :=
    linear_ne_zero_of_transcendental hc (by rintro ⟨rfl, rfl⟩; simp at h)
  intro hsq
  refine sq_linear_ne_mul_sq_linear_of_transcendental hc h ?_
  rwa [div_pow, div_eq_iff (pow_ne_zero 2 hD)] at hsq

end Stacks.Groupoids

end
