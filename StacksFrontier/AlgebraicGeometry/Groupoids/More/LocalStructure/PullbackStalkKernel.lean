module

public import Mathlib.RingTheory.Localization.Ideal
public import Mathlib.RingTheory.TensorProduct.Basic
public import StacksFrontier.AlgebraicGeometry.Groupoids.More.LocalStructure.StalkConormal
public import StacksFrontier.AlgebraicGeometry.Perfect.BaseChangeStalk

/-!
# The kernel of a section of a fibre product on stalks

Let
```
X ×_Z Y --p--> X
|q             |f
Y ------g----> Z
```
be a fibre product of schemes and let `x'` be a point of it.  Suppose the local ring of the
fibre product at `x'` carries a retraction `e` onto the local ring of `Z` at the image of
`x'`, splitting the structure map.  Then `ker e` is generated by the images of `ker (e ∘ p)`
and `ker (e ∘ q)` under the two projections.

## Main results

* `Algebra.TensorProduct.ker_lift`: the kernel of the map out of a tensor product determined
  by two augmentations is generated by the two kernels.
* `IsLocalization.ker_eq_map_ker`: the kernel of a ring map out of a localization is the image
  of the kernel of its restriction.
* `AlgebraicGeometry.ker_eq_sup_map_stalkMap_of_isPullback`: the geometric statement above,
  with the two projections written as `AlgebraicGeometry.Scheme.Hom.stalkMap`.
* `AlgebraicGeometry.ker_eq_sup_map_stalkMapAt_of_isPullback`: the same with the projections
  written as `AlgebraicGeometry.Scheme.Hom.stalkMapAt` at prescribed image points.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TensorProduct

universe u v w

/-- The kernel of the map `B ⊗[A] D → A` determined by two augmentations `f : B → A` and
`g : D → A` is generated by the images of their kernels. -/
theorem Algebra.TensorProduct.ker_lift (A : Type u) (B : Type v) (D : Type w)
    [CommRing A] [CommRing B] [CommRing D] [Algebra A B] [Algebra A D]
    (f : B →ₐ[A] A) (g : D →ₐ[A] A) :
    RingHom.ker ((Algebra.TensorProduct.lift f g fun _ _ ↦ Commute.all _ _).toRingHom) =
      (RingHom.ker f.toRingHom).map Algebra.TensorProduct.includeLeftRingHom ⊔
        (RingHom.ker g.toRingHom).map Algebra.TensorProduct.includeRight.toRingHom := by
  set T := TensorProduct A B D
  set K : Ideal T :=
    (RingHom.ker f.toRingHom).map Algebra.TensorProduct.includeLeftRingHom ⊔
      (RingHom.ker g.toRingHom).map Algebra.TensorProduct.includeRight.toRingHom
  set q : T →+* T ⧸ K := Ideal.Quotient.mk K
  set j : A →+* T ⧸ K := q.comp (algebraMap A T)
  set ev : T →+* A := (Algebra.TensorProduct.lift f g fun _ _ ↦ Commute.all _ _).toRingHom
  have key (u x : T) (a : A) (hx : x ∈ K) (h : x = u - algebraMap A T a) : q u = j a :=
    Ideal.Quotient.eq.mpr (h ▸ hx)
  have hleft (b : B) : q (Algebra.TensorProduct.includeLeftRingHom b) = j (f b) :=
    key _ (Algebra.TensorProduct.includeLeftRingHom (b - algebraMap A B (f b))) _
      (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ (by simp)))
      (by simp [TensorProduct.sub_tmul]; rfl)
  have hright (d : D) : q (Algebra.TensorProduct.includeRight d) = j (g d) :=
    key _ (Algebra.TensorProduct.includeRight (d - algebraMap A D (g d))) _
      (Ideal.mem_sup_right (Ideal.mem_map_of_mem _ (by simp)))
      (by simp [TensorProduct.tmul_sub, Algebra.algebraMap_eq_smul_one]; rfl)
  have heq : q = j.comp ev := by
    refine RingHom.ext fun z ↦ ?_
    induction z using TensorProduct.inductionOn with
    | add x y hx hy => simp [hx, hy]
    | tmul b d =>
      change q (b ⊗ₜ[A] d) = j (f b * g d)
      have ht : b ⊗ₜ[A] d =
          (Algebra.TensorProduct.includeLeftRingHom b) *
            Algebra.TensorProduct.includeRight d := by
        simp [Algebra.TensorProduct.includeLeftRingHom_apply]
      rw [ht, map_mul, hleft, hright]
      simp [j]
  refine le_antisymm (fun z hz ↦ ?_) (sup_le ?_ ?_)
  · have hqz : q z = 0 := by
      rw [heq]
      change q (algebraMap A T (ev z)) = 0
      rw [show ev z = 0 from hz]
      simp [q]
    change Ideal.Quotient.mk K z = 0 at hqz
    simpa only [Ideal.Quotient.eq_zero_iff_mem] using hqz
  · refine Ideal.map_le_iff_le_comap.mpr fun b hb ↦ ?_
    change f b * g 1 = 0
    simpa using (RingHom.mem_ker.mp hb : f.toRingHom b = 0)
  · refine Ideal.map_le_iff_le_comap.mpr fun d hd ↦ ?_
    change f 1 * g d = 0
    simpa using (RingHom.mem_ker.mp hd : g.toRingHom d = 0)

/-- The kernel of a ring map out of a localization `C` of `T` is the image of the kernel of
its restriction along `algebraMap T C`.  Compare `IsLocalization.ker_map`, which computes the
kernel of a map between two localizations. -/
theorem IsLocalization.ker_eq_map_ker {T C A : Type*} [CommRing T] [CommRing C] [CommRing A]
    {M : Submonoid T} [Algebra T C] (hM : IsLocalization M C) (g : T →+* A) (f : C →+* A)
    (hf : f.comp (algebraMap T C) = g) :
    RingHom.ker f = (RingHom.ker g).map (algebraMap T C) := by
  have := hM
  refine le_antisymm (fun c hc ↦ ?_) (Ideal.map_le_iff_le_comap.mpr fun t ht ↦ ?_)
  · obtain ⟨⟨t, m⟩, hcm⟩ := IsLocalization.surj M c
    have ht : g t = 0 := by
      have he := congrArg f hcm
      rw [map_mul] at he
      change f c * f (algebraMap T C m) = f (algebraMap T C t) at he
      rw [show f c = 0 from hc, ← RingHom.comp_apply, hf, ← RingHom.comp_apply, hf,
        zero_mul] at he
      exact he.symm
    rw [IsLocalization.mem_map_algebraMap_iff M]
    exact ⟨(⟨t, ht⟩, m), hcm⟩
  · change f (algebraMap T C t) = 0
    rwa [← RingHom.comp_apply, hf]

/-- The kernel of a ring map out of a localization of `B ⊗[A] D` determined by two
augmentations is generated by the images of the two kernels. -/
private theorem IsLocalization.ker_eq_sup_map_of_lift (A : Type u) (B : Type v) (D : Type w)
    (C : Type*) [CommRing A] [CommRing B] [CommRing D] [CommRing C] [Algebra A B] [Algebra A D]
    [Algebra (TensorProduct A B D) C] (M : Submonoid (TensorProduct A B D))
    (hM : IsLocalization M C) (f : B →ₐ[A] A) (g : D →ₐ[A] A) (fC : C →+* A)
    (hf : fC.comp (algebraMap (TensorProduct A B D) C) =
      (Algebra.TensorProduct.lift f g fun _ _ ↦ Commute.all _ _).toRingHom) :
    RingHom.ker fC =
      (RingHom.ker f.toRingHom).map
          ((algebraMap (TensorProduct A B D) C).comp
            Algebra.TensorProduct.includeLeftRingHom) ⊔
        (RingHom.ker g.toRingHom).map
          ((algebraMap (TensorProduct A B D) C).comp
            Algebra.TensorProduct.includeRight.toRingHom) := by
  rw [IsLocalization.ker_eq_map_ker hM _ fC hf, Algebra.TensorProduct.ker_lift A B D f g,
    Ideal.map_sup, Ideal.map_map, Ideal.map_map]

namespace AlgebraicGeometry

/-- Let `x'` be a point of a fibre product `X ×_Z Y` and let `e` be a retraction of the local
ring of the fibre product at `x'` onto the local ring of `Z` at the image of `x'`, splitting
the structure map.  Then `ker e` is generated by the images under the two projections of the
kernels of the two restrictions of `e`. -/
theorem ker_eq_sup_map_stalkMap_of_isPullback {X Y Z : Scheme.{u}} (f : X ⟶ Z) (g : Y ⟶ Z)
    (p : (pullback f g).carrier) (z : Z) (hz : (pullback.fst f g ≫ f) p = z)
    (e : (pullback f g).presheaf.stalk p →+* Z.presheaf.stalk z)
    (he : e.comp ((pullback.fst f g ≫ f).stalkMapAt p z hz) = RingHom.id _) :
    RingHom.ker e =
      (RingHom.ker (e.comp ((pullback.fst f g).stalkMap p).hom)).map
          ((pullback.fst f g).stalkMap p).hom ⊔
        (RingHom.ker (e.comp ((pullback.snd f g).stalkMap p).hom)).map
          ((pullback.snd f g).stalkMap p).hom := by
  subst z
  let h : (pullback.fst f g ≫ f) p = (pullback.snd f g ≫ g) p :=
    congrArg (fun k : pullback f g ⟶ Z ↦ k p) pullback.condition
  let R := Z.presheaf.stalk ((pullback.fst f g ≫ f) p)
  let A := X.presheaf.stalk ((pullback.fst f g) p)
  let B := Y.presheaf.stalk ((pullback.snd f g) p)
  let C := (pullback f g).presheaf.stalk p
  let : Algebra R A := (f.stalkMap ((pullback.fst f g) p)).hom.toAlgebra
  let : Algebra R B :=
    (eqToHom (congrArg Z.presheaf.stalk h) ≫ g.stalkMap ((pullback.snd f g) p)).hom.toAlgebra
  let a : A →ₐ[R] R :=
    { e.comp ((pullback.fst f g).stalkMap p).hom with
      commutes' := by
        intro r
        have he' := DFunLike.congr_fun he r
        change e (((pullback.fst f g ≫ f).stalkMap p).hom r) = r at he'
        rwa [Scheme.Hom.stalkMap_comp] at he' }
  let b : B →ₐ[R] R :=
    { e.comp ((pullback.snd f g).stalkMap p).hom with
      commutes' := by
        intro r
        have hcongr :
            (pullback.snd f g ≫ g).stalkMapAt p ((pullback.fst f g ≫ f) p) h.symm =
              (pullback.fst f g ≫ f).stalkMapAt p ((pullback.fst f g ≫ f) p) rfl :=
          Scheme.Hom.stalkMapAt_congr _ _
            (pullback.condition (f := f) (g := g)).symm _ _ _ _
        have hfactor :
            (pullback.snd f g ≫ g).stalkMapAt p ((pullback.fst f g ≫ f) p) h.symm =
              ((pullback.snd f g).stalkMap p).hom.comp (algebraMap R B) := by
          unfold Scheme.Hom.stalkMapAt
          rw [Scheme.Hom.stalkMap_comp]
          rfl
        change e ((((pullback.snd f g).stalkMap p).hom.comp (algebraMap R B)) r) = r
        rw [← hfactor, hcongr]
        exact DFunLike.congr_fun he r }
  obtain ⟨φ, hφa, hφb, M, hM⟩ := BaseChangeStalk.pullback_stalk_isLocalization f g p
  let : Algebra (TensorProduct R A B) C := φ.toAlgebra
  have hev : e.comp φ = (Algebra.TensorProduct.lift a b fun _ _ ↦ Commute.all _ _).toRingHom := by
    refine Algebra.TensorProduct.ringHom_ext ?_ ?_
    · rw [RingHom.comp_assoc, hφa]
      exact (congrArg AlgHom.toRingHom
        (Algebra.TensorProduct.lift_comp_includeLeft a b fun _ _ ↦ Commute.all _ _)).symm
    · rw [RingHom.comp_assoc, hφb]
      exact (congrArg AlgHom.toRingHom
        (Algebra.TensorProduct.lift_comp_includeRight a b fun _ _ ↦ Commute.all _ _)).symm
  have hk := IsLocalization.ker_eq_sup_map_of_lift R A B C M hM a b e hev
  change RingHom.ker e =
    (RingHom.ker a.toRingHom).map (φ.comp Algebra.TensorProduct.includeLeftRingHom) ⊔
      (RingHom.ker b.toRingHom).map (φ.comp Algebra.TensorProduct.includeRight.toRingHom) at hk
  rwa [hφa, hφb] at hk

/-- `AlgebraicGeometry.ker_eq_sup_map_stalkMap_of_isPullback` with the two projections written
as stalk maps at prescribed image points. -/
theorem ker_eq_sup_map_stalkMapAt_of_isPullback {X Y Z : Scheme.{u}} (f : X ⟶ Z) (g : Y ⟶ Z)
    (p : (pullback f g).carrier) (a : X) (b : Y) (z : Z)
    (ha : (pullback.fst f g) p = a) (hb : (pullback.snd f g) p = b)
    (hz : (pullback.fst f g ≫ f) p = z)
    (e : (pullback f g).presheaf.stalk p →+* Z.presheaf.stalk z)
    (he : e.comp ((pullback.fst f g ≫ f).stalkMapAt p z hz) = RingHom.id _) :
    RingHom.ker e =
      (RingHom.ker (e.comp ((pullback.fst f g).stalkMapAt p a ha))).map
          ((pullback.fst f g).stalkMapAt p a ha) ⊔
        (RingHom.ker (e.comp ((pullback.snd f g).stalkMapAt p b hb))).map
          ((pullback.snd f g).stalkMapAt p b hb) := by
  subst a b
  exact ker_eq_sup_map_stalkMap_of_isPullback f g p z hz e he

end AlgebraicGeometry

end
