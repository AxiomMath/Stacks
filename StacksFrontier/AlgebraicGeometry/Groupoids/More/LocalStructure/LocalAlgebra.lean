module

public import Mathlib.RingTheory.Ideal.Cotangent

/-!
# The local model of a groupoid at an identity

Fix a groupoid whose object of objects and object of arrows are affine, and a point of the
objects at which the identity is taken.  Passing to local rings turns the groupoid axioms into
a diagram of three commutative rings
```
A --source, target--> B --first, second, comp--> C
```
with retractions `identity : B → A` of source and target, and retractions
`rightUnit, leftUnit, inversePair : C → B` of the three maps `B → C`, together with an
inversion `inverse : B → B`.  Here `A` is the local ring of the objects, `B` that of the
arrows at the identity, and `C` that of the composable pairs at the pair of identities.
`Stacks.Groupoids.LocalGroupoidAlgebra` bundles that diagram.

Write `I = ker identity` and `J = ker (identity ∘ rightUnit)`.  The last axiom is the
identification `J = I·C + C·I`, that is, `J` is generated by the images of `I` under the two
maps `B → C`.  Granting it, composition adds the two first-order directions and inversion
negates the first-order direction: these are `mapCotangent_comp` and `mapCotangent_inverse`.

## Main definitions

* `Stacks.Groupoids.LocalGroupoidAlgebra`: the diagram of local rings above.
* `Stacks.Groupoids.LocalGroupoidAlgebra.identityIdeal`: the ideal `I = ker identity`.
* `Stacks.Groupoids.LocalGroupoidAlgebra.pairIdeal`: the ideal `J = ker (identity ∘ rightUnit)`.

## Main results

* `Stacks.Groupoids.LocalGroupoidAlgebra.mapCotangent_comp`: on `I/I² → J/J²`, composition is
  the diagonal followed by the two maps induced by `first` and `second`.
* `Stacks.Groupoids.LocalGroupoidAlgebra.mapCotangent_inverse`: inversion acts by `-1` on
  `I/I²`.
* `Stacks.Groupoids.LocalGroupoidAlgebra.mapCotangent_comp_eq`,
  `Stacks.Groupoids.LocalGroupoidAlgebra.mapCotangent_inverse_eq` and
  `Stacks.Groupoids.LocalGroupoidAlgebra.bijective_coprod_mapCotangent`: the same two statements
  for the induced `ℤ`-linear maps `Ideal.mapCotangent`, with the target taken to be any ideal
  `J` equal to the ideal of the pair of identities, and the bijectivity of
  `I/I² ⊕ I/I² → J/J²`.

## Implementation notes

The statements are about the classes `Ideal.toCotangent` of elements rather than about the
induced linear maps, so that they apply verbatim to the conormal maps of a groupoid scheme at
an identity, which are `Ideal.mapCotangent` of the corresponding stalk maps.

The membership `comp x ∈ I·C + C·I` for `x ∈ I` is not a field of the structure: it follows
from `ideal_pairs`, and is `comp_mem`.

## References

* [Stacks Project, Tag 0CK4](https://stacks.math.columbia.edu/tag/0CK4)
-/

@[expose] public section

universe u v w

namespace Stacks.Groupoids

/-- The local model of a groupoid at an identity: three commutative rings `A`, `B`, `C`
standing for the local rings of the objects, of the arrows at an identity and of the
composable pairs at the pair of identities, with the ring maps induced by source, target,
identity, the two projections, composition and inversion, and the retractions of the three
maps `B → C` induced by the right unit, the left unit and the pairing of an arrow with its
inverse.

The final axiom `ideal_pairs` is the identification `J = I·C + C·I` of the ideal of the pair
of identities. -/
structure LocalGroupoidAlgebra (A : Type u) (B : Type v) (C : Type w)
    [CommRing A] [CommRing B] [CommRing C] where
  /-- The map induced by the source of an arrow. -/
  source : A →+* B
  /-- The map induced by the target of an arrow. -/
  target : A →+* B
  /-- The map induced by the identity arrow at an object. -/
  identity : B →+* A
  /-- The map induced by the first projection of a composable pair. -/
  first : B →+* C
  /-- The map induced by the second projection of a composable pair. -/
  second : B →+* C
  /-- The map induced by composition of a composable pair. -/
  comp : B →+* C
  /-- The map induced by inversion of an arrow. -/
  inverse : B →+* B
  /-- The map induced by pairing an arrow with the identity at its source. -/
  rightUnit : C →+* B
  /-- The map induced by pairing the identity at the target of an arrow with the arrow. -/
  leftUnit : C →+* B
  /-- The map induced by pairing an arrow with its inverse. -/
  inversePair : C →+* B
  identity_source : identity.comp source = RingHom.id A
  identity_target : identity.comp target = RingHom.id A
  rightUnit_first : rightUnit.comp first = RingHom.id B
  rightUnit_second : rightUnit.comp second = source.comp identity
  leftUnit_first : leftUnit.comp first = target.comp identity
  leftUnit_second : leftUnit.comp second = RingHom.id B
  rightUnit_comp : rightUnit.comp comp = RingHom.id B
  leftUnit_comp : leftUnit.comp comp = RingHom.id B
  inversePair_first : inversePair.comp first = RingHom.id B
  inversePair_second : inversePair.comp second = inverse
  inversePair_comp : inversePair.comp comp = target.comp identity
  identity_inverse : identity.comp inverse = identity
  ideal_pairs : RingHom.ker (identity.comp rightUnit) =
    (RingHom.ker identity).map first ⊔ (RingHom.ker identity).map second

namespace LocalGroupoidAlgebra

variable {A : Type u} {B : Type v} {C : Type w} [CommRing A] [CommRing B] [CommRing C]
  (G : LocalGroupoidAlgebra A B C)

/-- The ideal `I = ker identity` of the arrow ring: the ideal of the identity. -/
abbrev identityIdeal : Ideal B := RingHom.ker G.identity

/-- The ideal `J = ker (identity ∘ rightUnit)` of the ring of composable pairs: the ideal of
the pair of identities. -/
abbrev pairIdeal : Ideal C := RingHom.ker (G.identity.comp G.rightUnit)

/-- The ideal of the pair of identities is generated by the two images of the ideal of the
identity.  This is `ideal_pairs` phrased with `identityIdeal` and `pairIdeal`. -/
theorem pairIdeal_eq_sup :
    G.pairIdeal = G.identityIdeal.map G.first ⊔ G.identityIdeal.map G.second :=
  G.ideal_pairs

/-- Composition carries the ideal of the identity into the ideal of the pair of identities. -/
theorem comp_mem (x : G.identityIdeal) :
    G.comp x ∈ G.identityIdeal.map G.first ⊔ G.identityIdeal.map G.second := by
  rw [← G.pairIdeal_eq_sup]
  change G.identity (G.rightUnit (G.comp x)) = 0
  rw [← RingHom.comp_apply G.rightUnit G.comp,
    ← RingHom.comp_apply G.identity (G.rightUnit.comp G.comp), G.rightUnit_comp,
    RingHom.comp_id]
  exact x.property

/-- The left unit carries the ideal of the pair of identities into the ideal of the
identity. -/
theorem leftUnit_mem_identityIdeal {x : C} (hx : x ∈ G.pairIdeal) :
    G.leftUnit x ∈ G.identityIdeal := by
  have h : G.pairIdeal ≤ G.identityIdeal.comap G.leftUnit := by
    rw [G.pairIdeal_eq_sup]
    refine sup_le (Ideal.map_le_iff_le_comap.mpr fun b hb ↦ ?_)
      (Ideal.map_le_iff_le_comap.mpr fun b hb ↦ ?_)
    · change G.identity (G.leftUnit (G.first b)) = 0
      rw [← RingHom.comp_apply G.leftUnit, G.leftUnit_first]
      change G.identity (G.target (G.identity b)) = 0
      rw [show G.identity b = 0 from hb, map_zero, map_zero]
    · change G.identity (G.leftUnit (G.second b)) = 0
      rw [← RingHom.comp_apply G.leftUnit, G.leftUnit_second]
      exact hb
  exact h hx

/-- The two unit retractions agree after composing with the identity map. -/
theorem identity_leftUnit_eq_identity_rightUnit (c : C) :
    G.identity (G.leftUnit c) = G.identity (G.rightUnit c) := by
  have h₁ := RingHom.congr_fun G.rightUnit_first
  have h₂ := RingHom.congr_fun G.leftUnit_first
  have h₃ := RingHom.congr_fun G.identity_target
  simp only [RingHom.comp_apply, RingHom.id_apply] at h₁ h₂ h₃
  have h := G.leftUnit_mem_identityIdeal (x := c - G.first (G.rightUnit c)) (by
    simp [RingHom.mem_ker, h₁])
  simpa [RingHom.mem_ker, h₂, h₃, sub_eq_zero] using h

/-- Every element of the ring of composable pairs agrees, modulo the ideal of the pair of
identities, with the first-coordinate image of its right unit. -/
theorem sub_first_rightUnit_mem_pairIdeal (c : C) :
    c - G.first (G.rightUnit c) ∈ G.pairIdeal := by
  change G.identity (G.rightUnit (c - _)) = 0
  rw [map_sub, map_sub, ← RingHom.comp_apply G.rightUnit G.first, G.rightUnit_first]
  exact sub_self _

/-- Every element of the ring of composable pairs agrees, modulo the ideal of the pair of
identities, with the second-coordinate image of its left unit. -/
theorem sub_second_leftUnit_mem_pairIdeal (c : C) :
    c - G.second (G.leftUnit c) ∈ G.pairIdeal := by
  have h₁ := RingHom.congr_fun G.rightUnit_second
  have h₂ := RingHom.congr_fun G.identity_source
  simp only [RingHom.comp_apply, RingHom.id_apply] at h₁ h₂
  simp [RingHom.mem_ker, h₁, h₂, G.identity_leftUnit_eq_identity_rightUnit]

/-- Modulo `J²`, an element of the ideal of the pair of identities is the sum of the
first-coordinate image of its right unit and the second-coordinate image of its left unit. -/
theorem mk_pairIdeal_sq_eq_add (c : C) (hc : c ∈ G.pairIdeal) :
    Ideal.Quotient.mk (G.pairIdeal ^ 2) c =
      Ideal.Quotient.mk (G.pairIdeal ^ 2) (G.first (G.rightUnit c)) +
        Ideal.Quotient.mk (G.pairIdeal ^ 2) (G.second (G.leftUnit c)) := by
  set q := Ideal.Quotient.mk (G.pairIdeal ^ 2)
  have hf : ∀ z ∈ G.identityIdeal.map G.first, q z = q (G.first (G.rightUnit z)) := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨b, hb, rfl⟩ := hz
      rw [← RingHom.comp_apply G.rightUnit G.first, G.rightUnit_first]
      rfl
    | zero => simp
    | add x y hx hy ihx ihy => simp only [map_add, ihx, ihy]
    | smul a z hz ih =>
      change q (a * z) = q (G.first (G.rightUnit (a * z)))
      rw [map_mul, map_mul, map_mul, map_mul, ← ih]
      refine sub_eq_zero.mp ?_
      rw [← sub_mul, ← map_sub, ← map_mul]
      refine Ideal.Quotient.eq_zero_iff_mem.mpr ?_
      rw [pow_two]
      exact Ideal.mul_mem_mul (G.sub_first_rightUnit_mem_pairIdeal a)
        (by rw [G.pairIdeal_eq_sup]; exact Ideal.mem_sup_left hz)
  have hs : ∀ z ∈ G.identityIdeal.map G.second, q z = q (G.second (G.leftUnit z)) := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
      obtain ⟨b, hb, rfl⟩ := hz
      rw [← RingHom.comp_apply G.leftUnit G.second, G.leftUnit_second]
      rfl
    | zero => simp
    | add x y hx hy ihx ihy => simp only [map_add, ihx, ihy]
    | smul a z hz ih =>
      change q (a * z) = q (G.second (G.leftUnit (a * z)))
      rw [map_mul, map_mul, map_mul, map_mul, ← ih]
      refine sub_eq_zero.mp ?_
      rw [← sub_mul, ← map_sub, ← map_mul]
      refine Ideal.Quotient.eq_zero_iff_mem.mpr ?_
      rw [pow_two]
      exact Ideal.mul_mem_mul (G.sub_second_leftUnit_mem_pairIdeal a)
        (by rw [G.pairIdeal_eq_sup]; exact Ideal.mem_sup_right hz)
  have hlf : G.identityIdeal.map G.first ≤ RingHom.ker G.leftUnit := by
    refine Ideal.map_le_iff_le_comap.mpr fun b hb ↦ ?_
    change G.leftUnit (G.first b) = 0
    rw [← RingHom.comp_apply G.leftUnit G.first, G.leftUnit_first]
    change G.target (G.identity b) = 0
    rw [show G.identity b = 0 from hb, map_zero]
  have hrs : G.identityIdeal.map G.second ≤ RingHom.ker G.rightUnit := by
    refine Ideal.map_le_iff_le_comap.mpr fun b hb ↦ ?_
    change G.rightUnit (G.second b) = 0
    rw [← RingHom.comp_apply G.rightUnit G.second, G.rightUnit_second]
    change G.source (G.identity b) = 0
    rw [show G.identity b = 0 from hb, map_zero]
  rw [G.pairIdeal_eq_sup] at hc
  obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp hc
  change q (a + b) = q (G.first (G.rightUnit (a + b))) + q (G.second (G.leftUnit (a + b)))
  simp only [map_add, show G.leftUnit a = 0 from hlf ha, show G.rightUnit b = 0 from hrs hb,
    add_zero, zero_add]
  rw [hf a ha, hs b hb]

/-- Composition sends a first-order tangent vector to the sum of its copies in the two factors
of the ring of composable pairs. -/
theorem mapCotangent_comp (x : G.identityIdeal) :
    G.pairIdeal.toCotangent ⟨G.comp x, by
      change G.comp x ∈ RingHom.ker (G.identity.comp G.rightUnit)
      rw [G.ideal_pairs]
      exact G.comp_mem x⟩ =
      G.pairIdeal.toCotangent ⟨G.first x, by
        change G.first x ∈ RingHom.ker (G.identity.comp G.rightUnit)
        rw [G.ideal_pairs]
        exact Ideal.mem_sup_left (Ideal.mem_map_of_mem G.first x.property)⟩ +
      G.pairIdeal.toCotangent ⟨G.second x, by
        change G.second x ∈ RingHom.ker (G.identity.comp G.rightUnit)
        rw [G.ideal_pairs]
        exact Ideal.mem_sup_right (Ideal.mem_map_of_mem G.second x.property)⟩ := by
  refine G.pairIdeal.cotangentToQuotientSquare_injective ?_
  simp only [map_add, Ideal.toCotangent_to_quotient_square]
  have h := G.mk_pairIdeal_sq_eq_add (G.comp x) (by
    rw [G.pairIdeal_eq_sup]
    exact G.comp_mem x)
  have hr : G.rightUnit (G.comp x) = x := DFunLike.congr_fun G.rightUnit_comp (x : B)
  have hl : G.leftUnit (G.comp x) = x := DFunLike.congr_fun G.leftUnit_comp (x : B)
  simpa only [hr, hl, Submodule.mkQ_apply, Ideal.Quotient.mk_eq_mk] using h

/-- Inversion acts as `-1` on the conormal module of the identity. -/
theorem mapCotangent_inverse (x : G.identityIdeal) :
    G.identityIdeal.toCotangent ⟨G.inverse x, by
      change G.identity (G.inverse x) = 0
      rw [← RingHom.comp_apply, G.identity_inverse]
      exact x.property⟩ = -G.identityIdeal.toCotangent x := by
  have hj : G.pairIdeal ≤ G.identityIdeal.comap G.inversePair := by
    rw [G.pairIdeal_eq_sup]
    refine sup_le (Ideal.map_le_iff_le_comap.mpr fun b hb ↦ ?_)
      (Ideal.map_le_iff_le_comap.mpr fun b hb ↦ ?_)
    · change G.identity (G.inversePair (G.first b)) = 0
      rw [← RingHom.comp_apply G.inversePair G.first, G.inversePair_first]
      exact hb
    · change G.identity (G.inversePair (G.second b)) = 0
      rw [← RingHom.comp_apply G.inversePair G.second, G.inversePair_second,
        ← RingHom.comp_apply G.identity G.inverse, G.identity_inverse]
      exact hb
  have hj2 : G.pairIdeal ^ 2 ≤ (G.identityIdeal ^ 2).comap G.inversePair := by
    refine Ideal.map_le_iff_le_comap.mp ?_
    rw [Ideal.map_pow]
    exact pow_le_pow_left' (Ideal.map_le_iff_le_comap.mpr hj) 2
  have h := congrArg G.pairIdeal.cotangentToQuotientSquare (G.mapCotangent_comp x)
  simp only [map_add, Ideal.toCotangent_to_quotient_square] at h
  have hm : G.comp x - (G.first x + G.second x) ∈ G.pairIdeal ^ 2 :=
    (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).mp
      (by simpa only [map_add, Submodule.mkQ_apply, Ideal.Quotient.mk_eq_mk] using h)
  have hm' := hj2 hm
  change G.inversePair (G.comp x - (G.first x + G.second x)) ∈ G.identityIdeal ^ 2 at hm'
  have hc : G.inversePair (G.comp x) = G.target (G.identity x) :=
    DFunLike.congr_fun G.inversePair_comp (x : B)
  have hf : G.inversePair (G.first x) = x := DFunLike.congr_fun G.inversePair_first (x : B)
  have hs : G.inversePair (G.second x) = G.inverse x :=
    DFunLike.congr_fun G.inversePair_second (x : B)
  simp only [map_sub, map_add, hc, hf, hs, show G.identity x = 0 from x.property, map_zero,
    zero_sub] at hm'
  rw [← map_neg, Ideal.toCotangent_eq]
  change G.inverse x - -(x : B) ∈ G.identityIdeal ^ 2
  simpa only [sub_neg_eq_add, add_comm, neg_neg] using (G.identityIdeal ^ 2).neg_mem hm'

/-! ### The maps of conormal modules -/

/-- The first projection carries the ideal of the identity into an ideal `J` equal to the ideal
of the pair of identities. -/
theorem identityIdeal_le_comap_first (J : Ideal C) (hJ : J = G.pairIdeal) :
    G.identityIdeal ≤ J.comap G.first.toIntAlgHom := by
  subst hJ
  intro x hx
  rw [Ideal.mem_comap, G.pairIdeal_eq_sup]
  exact Ideal.mem_sup_left (Ideal.mem_map_of_mem G.first hx)

/-- The second projection carries the ideal of the identity into an ideal `J` equal to the
ideal of the pair of identities. -/
theorem identityIdeal_le_comap_second (J : Ideal C) (hJ : J = G.pairIdeal) :
    G.identityIdeal ≤ J.comap G.second.toIntAlgHom := by
  subst hJ
  intro x hx
  rw [Ideal.mem_comap, G.pairIdeal_eq_sup]
  exact Ideal.mem_sup_right (Ideal.mem_map_of_mem G.second hx)

/-- Composition carries the ideal of the identity into an ideal `J` equal to the ideal of the
pair of identities. -/
theorem identityIdeal_le_comap_comp (J : Ideal C) (hJ : J = G.pairIdeal) :
    G.identityIdeal ≤ J.comap G.comp.toIntAlgHom := by
  subst hJ
  intro x hx
  rw [Ideal.mem_comap, G.pairIdeal_eq_sup]
  exact G.comp_mem ⟨x, hx⟩

/-- Inversion carries the ideal of the identity into itself. -/
theorem identityIdeal_le_comap_inverse :
    G.identityIdeal ≤ G.identityIdeal.comap G.inverse.toIntAlgHom := by
  intro x hx
  rw [Ideal.mem_comap, RingHom.mem_ker]
  change G.identity (G.inverse x) = 0
  rw [← RingHom.comp_apply, G.identity_inverse]
  exact hx

/-- On `I/I² → J/J²`, the map induced by composition is the diagonal followed by the sum of the
maps induced by the two projections, for any ideal `J` equal to the ideal of the pair of
identities. -/
theorem mapCotangent_comp_eq (J : Ideal C) (hJ : J = G.pairIdeal) :
    Ideal.mapCotangent G.identityIdeal J G.comp.toIntAlgHom (G.identityIdeal_le_comap_comp J hJ) =
      ((Ideal.mapCotangent G.identityIdeal J G.first.toIntAlgHom
          (G.identityIdeal_le_comap_first J hJ)).coprod
        (Ideal.mapCotangent G.identityIdeal J G.second.toIntAlgHom
          (G.identityIdeal_le_comap_second J hJ))).comp (LinearMap.id.prod LinearMap.id) := by
  subst hJ
  refine LinearMap.ext fun w ↦ ?_
  obtain ⟨x, rfl⟩ := Ideal.toCotangent_surjective G.identityIdeal w
  simp only [LinearMap.comp_apply, LinearMap.prod_apply, LinearMap.coprod_apply]
  exact G.mapCotangent_comp x

/-- Inversion acts as `-1` on `I/I²`, stated for the induced linear map. -/
theorem mapCotangent_inverse_eq :
    Ideal.mapCotangent G.identityIdeal G.identityIdeal G.inverse.toIntAlgHom
      G.identityIdeal_le_comap_inverse = -LinearMap.id := by
  refine LinearMap.ext fun w ↦ ?_
  obtain ⟨x, rfl⟩ := Ideal.toCotangent_surjective G.identityIdeal w
  simp only [Ideal.mapCotangent_toCotangent, LinearMap.neg_apply, LinearMap.id_apply]
  exact G.mapCotangent_inverse x

/-- Two classes in a conormal module agree when their representatives do. -/
private theorem toCotangent_congr {R : Type*} [CommRing R] (K : Ideal R) {a b : R}
    (ha : a ∈ K) (hb : b ∈ K) (h : a = b) : K.toCotangent ⟨a, ha⟩ = K.toCotangent ⟨b, hb⟩ := by
  subst h
  rfl

/-- **The arrow `I/I² ⊕ I/I² → J/J²` coming from `J = I·C + C·I` is an isomorphism**, for any
ideal `J` equal to the ideal of the pair of identities.  Its inverse is induced by the two
retractions `rightUnit` and `leftUnit`. -/
theorem bijective_coprod_mapCotangent (J : Ideal C) (hJ : J = G.pairIdeal) :
    Function.Bijective
      ((Ideal.mapCotangent G.identityIdeal J G.first.toIntAlgHom
          (G.identityIdeal_le_comap_first J hJ)).coprod
        (Ideal.mapCotangent G.identityIdeal J G.second.toIntAlgHom
          (G.identityIdeal_le_comap_second J hJ))) := by
  subst hJ
  have hr : G.pairIdeal ≤ G.identityIdeal.comap G.rightUnit.toIntAlgHom := fun c hc ↦
    Ideal.mem_comap.mpr (RingHom.mem_ker.mpr (RingHom.mem_ker.mp hc))
  have hl : G.pairIdeal ≤ G.identityIdeal.comap G.leftUnit.toIntAlgHom := fun c hc ↦
    Ideal.mem_comap.mpr (G.leftUnit_mem_identityIdeal hc)
  have h₁ := RingHom.congr_fun G.rightUnit_first
  have h₂ := RingHom.congr_fun G.rightUnit_second
  have h₃ := RingHom.congr_fun G.leftUnit_first
  have h₄ := RingHom.congr_fun G.leftUnit_second
  simp only [RingHom.comp_apply, RingHom.id_apply] at h₁ h₂ h₃ h₄
  set f := Ideal.mapCotangent G.identityIdeal G.pairIdeal G.first.toIntAlgHom
    (G.identityIdeal_le_comap_first _ rfl)
  set g := Ideal.mapCotangent G.identityIdeal G.pairIdeal G.second.toIntAlgHom
    (G.identityIdeal_le_comap_second _ rfl)
  set r := Ideal.mapCotangent G.pairIdeal G.identityIdeal G.rightUnit.toIntAlgHom hr
  set l := Ideal.mapCotangent G.pairIdeal G.identityIdeal G.leftUnit.toIntAlgHom hl
  have hinv : Function.LeftInverse (r.prod l) (f.coprod g) := by
    rintro ⟨u, v⟩
    obtain ⟨x, rfl⟩ := Ideal.toCotangent_surjective G.identityIdeal u
    obtain ⟨y, rfl⟩ := Ideal.toCotangent_surjective G.identityIdeal v
    have hx : G.identity x = 0 := x.property
    have hy : G.identity y = 0 := y.property
    have e₁ : r (f (G.identityIdeal.toCotangent x)) = G.identityIdeal.toCotangent x :=
      toCotangent_congr G.identityIdeal _ x.property (h₁ x)
    have e₂ : r (g (G.identityIdeal.toCotangent y)) = 0 :=
      (Ideal.toCotangent_eq_zero _ _).mpr (by
        change G.rightUnit (G.second y) ∈ _
        rw [h₂, hy, map_zero]
        exact zero_mem _)
    have e₃ : l (f (G.identityIdeal.toCotangent x)) = 0 :=
      (Ideal.toCotangent_eq_zero _ _).mpr (by
        change G.leftUnit (G.first x) ∈ _
        rw [h₃, hx, map_zero]
        exact zero_mem _)
    have e₄ : l (g (G.identityIdeal.toCotangent y)) = G.identityIdeal.toCotangent y :=
      toCotangent_congr G.identityIdeal _ y.property (h₄ y)
    rw [LinearMap.coprod_apply, map_add]
    exact Prod.ext (by simp [e₁, e₂]) (by simp [e₃, e₄])
  refine ⟨hinv.injective, fun w ↦ ⟨(r.prod l) w, ?_⟩⟩
  obtain ⟨c, rfl⟩ := Ideal.toCotangent_surjective G.pairIdeal w
  simp only [f, g, r, l, LinearMap.coprod_apply, LinearMap.prod_apply]
  refine G.pairIdeal.cotangentToQuotientSquare_injective ?_
  simp only [map_add, Ideal.toCotangent_to_quotient_square]
  exact (G.mk_pairIdeal_sq_eq_add c c.property).symm

end LocalGroupoidAlgebra

end Stacks.Groupoids

