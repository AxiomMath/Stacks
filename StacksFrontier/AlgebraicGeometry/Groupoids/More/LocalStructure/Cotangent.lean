module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Groupoids.FieldExtensionEvaluation
public import StacksFrontier.AlgebraicGeometry.Groupoids.More.LocalStructure.LocalAlgebra
public import StacksFrontier.AlgebraicGeometry.Groupoids.More.LocalStructure.PullbackStalkKernel
public import StacksFrontier.AlgebraicGeometry.Groupoids.More.OverPullback

/-!
# First-order structure of a groupoid scheme at an identity

Let `G` be a groupoid scheme over `S` and let `x` be a point of its scheme of objects.  The
identity section `e` carries `x` to a point of the scheme of arrows; write `I` for the ideal of
the stalk of the arrows at that point which is the kernel of the stalk map of `e`, so that
`I/I²` is the conormal module of `e` at `x`.  Likewise the pair `(e, e)` is a section of the
scheme of composable arrows and cuts out an ideal `J` there.

**Composition induces on `I/I² → J/J²` the diagonal followed by the two maps coming from the
projections, and inversion induces `-1` on `I/I²`.**  These are `cotangent_composition` and
`cotangent_inverse`.

## Main definitions

* `Stacks.Groupoids.GroupoidScheme.identityPair`: the section `(e, e)` of the scheme of
  composable arrows.
* `Stacks.Groupoids.GroupoidScheme.identityIdeal` and
  `Stacks.Groupoids.GroupoidScheme.pairIdeal`: the ideals `I` and `J`.
* `Stacks.Groupoids.GroupoidScheme.compositionCotangent`,
  `Stacks.Groupoids.GroupoidScheme.firstCotangent`,
  `Stacks.Groupoids.GroupoidScheme.secondCotangent` and
  `Stacks.Groupoids.GroupoidScheme.inverseCotangent`: the maps of conormal modules induced by
  composition, the two projections and inversion.
* `Stacks.Groupoids.GroupoidScheme.stalkLocalGroupoidAlgebra`: the local model
  `Stacks.Groupoids.LocalGroupoidAlgebra` assembled from the stalk maps at `x`.

## Main results

* `Stacks.Groupoids.GroupoidScheme.pairIdeal_eq_sup`: `J` is generated by the two images of
  `I`.
* `Stacks.Groupoids.GroupoidScheme.cotangent_composition` and
  `Stacks.Groupoids.GroupoidScheme.cotangent_inverse`: the two assertions of Tag 0CK4, which
  are also the two assertions of Tag 0CKA.

## Implementation notes

All the stalk maps are taken at prescribed image points, using
`AlgebraicGeometry.Scheme.Hom.stalkMapAt`, so that the ring maps of the local model compose on
the nose; the groupoid axioms then give the equations of
`Stacks.Groupoids.LocalGroupoidAlgebra` by `stalkMapAt_congr`.  The identification `J = I·C +
C·I` is `AlgebraicGeometry.ker_eq_sup_map_stalkMapAt_of_isPullback`, transported along the
comparison of the scheme of composable arrows, a fibre product in `Over S`, with the fibre
product of the underlying schemes.

Equality of the conormal maps is stated for the underlying `ℤ`-linear maps, which specifies
the value on every element of `I/I²`.

## References

* [Stacks Project, Tag 0CK4](https://stacks.math.columbia.edu/tag/0CK4)
* [Stacks Project, Tag 0CKA](https://stacks.math.columbia.edu/tag/0CKA)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

namespace Stacks.Groupoids.GroupoidScheme

variable {S : Scheme.{u}} (G : GroupoidScheme S)

/-! ### Sections of the scheme of composable arrows -/

/-- The pair of identities: the section of the scheme of composable arrows sending an object to
the pair consisting of its identity twice. -/
noncomputable def identityPair : G.objects ⟶ pullback G.source G.target :=
  pullback.lift G.identity G.identity (by rw [G.source_identity, G.target_identity])

/-- The section of the scheme of composable arrows sending an arrow to the pair consisting of
it and the identity at its source. -/
noncomputable def rightUnitPair : G.arrows ⟶ pullback G.source G.target :=
  pullback.lift (𝟙 G.arrows) (G.source ≫ G.identity)
    (by simp [Category.assoc, G.target_identity])

/-- The section of the scheme of composable arrows sending an arrow to the pair consisting of
the identity at its target and the arrow. -/
noncomputable def leftUnitPair : G.arrows ⟶ pullback G.source G.target :=
  pullback.lift (G.target ≫ G.identity) (𝟙 G.arrows)
    (by simp [Category.assoc, G.source_identity])

/-- The section of the scheme of composable arrows sending an arrow to its pair with its
inverse. -/
noncomputable def inversePair : G.arrows ⟶ pullback G.source G.target :=
  pullback.lift (𝟙 G.arrows) G.inverse
    (by simpa only [Category.id_comp] using G.target_inverse.symm)

/-- The first member of the right unit pair of an arrow is the arrow. -/
@[simp]
theorem rightUnitPair_fst :
    G.rightUnitPair ≫ pullback.fst G.source G.target = 𝟙 G.arrows :=
  pullback.lift_fst _ _ _

/-- The second member of the right unit pair of an arrow is the identity at its source. -/
@[simp]
theorem rightUnitPair_snd :
    G.rightUnitPair ≫ pullback.snd G.source G.target = G.source ≫ G.identity :=
  pullback.lift_snd _ _ _

/-- The first member of the left unit pair of an arrow is the identity at its target. -/
@[simp]
theorem leftUnitPair_fst :
    G.leftUnitPair ≫ pullback.fst G.source G.target = G.target ≫ G.identity :=
  pullback.lift_fst _ _ _

/-- The second member of the left unit pair of an arrow is the arrow. -/
@[simp]
theorem leftUnitPair_snd :
    G.leftUnitPair ≫ pullback.snd G.source G.target = 𝟙 G.arrows :=
  pullback.lift_snd _ _ _

/-- The first member of the inverse pair of an arrow is the arrow. -/
@[simp]
theorem inversePair_fst : G.inversePair ≫ pullback.fst G.source G.target = 𝟙 G.arrows :=
  pullback.lift_fst _ _ _

/-- The second member of the inverse pair of an arrow is its inverse. -/
@[simp]
theorem inversePair_snd : G.inversePair ≫ pullback.snd G.source G.target = G.inverse :=
  pullback.lift_snd _ _ _

/-- The first member of the pair of identities is the identity. -/
@[simp]
theorem identityPair_fst : G.identityPair ≫ pullback.fst G.source G.target = G.identity :=
  pullback.lift_fst _ _ _

/-- The second member of the pair of identities is the identity. -/
@[simp]
theorem identityPair_snd : G.identityPair ≫ pullback.snd G.source G.target = G.identity :=
  pullback.lift_snd _ _ _

/-- Composing an arrow with the identity at its source gives back the arrow. -/
theorem rightUnitPair_comp : G.rightUnitPair ≫ G.comp = 𝟙 G.arrows := by
  simpa only [rightUnitPair, Category.id_comp] using
    G.right_identity G.arrows (𝟙 G.arrows) (by simp [Category.assoc, G.target_identity])

/-- Composing the identity at the target of an arrow with the arrow gives back the arrow. -/
theorem leftUnitPair_comp : G.leftUnitPair ≫ G.comp = 𝟙 G.arrows := by
  simpa only [leftUnitPair, Category.id_comp] using
    G.left_identity G.arrows (𝟙 G.arrows) (by simp [Category.assoc, G.source_identity])

/-- Composing an arrow with its inverse gives the identity at its target. -/
theorem inversePair_comp : G.inversePair ≫ G.comp = G.target ≫ G.identity := by
  simpa only [inversePair, Category.id_comp] using
    G.right_inverse G.arrows (𝟙 G.arrows)
      (by simpa only [Category.id_comp] using G.target_inverse.symm)

/-- Composing the pair of identities gives the identity. -/
theorem identityPair_comp : G.identityPair ≫ G.comp = G.identity := by
  convert G.right_identity G.objects G.identity
    (by simp [← Category.assoc, G.source_identity, G.target_identity]) using 1
  congr 1
  apply pullback.hom_ext <;> simp [identityPair, ← Category.assoc, G.source_identity]

/-- The inverse of an identity arrow is that identity arrow. -/
theorem identity_comp_inverse : G.identity ≫ G.inverse = G.identity := by
  let x : G.Evaluation G.objects := 𝟙 G.objects
  have h : Groupoid.inv (𝟙 x) = 𝟙 x := by rw [Groupoid.inv_eq_inv, IsIso.inv_id]
  have h' := congrArg GroupoidScheme.EvaluationHom.arrow h
  change (𝟙 G.objects ≫ G.identity) ≫ G.inverse = 𝟙 G.objects ≫ G.identity at h'
  simpa only [Category.id_comp] using h'

/-- Restricting the right unit section along the identity gives the pair of identities. -/
theorem identity_comp_rightUnitPair : G.identity ≫ G.rightUnitPair = G.identityPair := by
  apply pullback.hom_ext
  · rw [Category.assoc, rightUnitPair_fst, Category.comp_id, identityPair_fst]
  · rw [Category.assoc, rightUnitPair_snd, ← Category.assoc, G.source_identity,
      Category.id_comp, identityPair_snd]

/-- Restricting the left unit section along the identity gives the pair of identities. -/
theorem identity_comp_leftUnitPair : G.identity ≫ G.leftUnitPair = G.identityPair := by
  apply pullback.hom_ext
  · rw [Category.assoc, leftUnitPair_fst, ← Category.assoc, G.target_identity,
      Category.id_comp, identityPair_fst]
  · rw [Category.assoc, leftUnitPair_snd, Category.comp_id, identityPair_snd]

/-- Restricting the inverse-pair section along the identity gives the pair of identities. -/
theorem identity_comp_inversePair : G.identity ≫ G.inversePair = G.identityPair := by
  apply pullback.hom_ext
  · rw [Category.assoc, inversePair_fst, Category.comp_id, identityPair_fst]
  · rw [Category.assoc, inversePair_snd, G.identity_comp_inverse, identityPair_snd]

/-! ### The points in play -/

/-- Applying the underlying maps of composable morphisms of `Over S` at a point, when their
composite is a third morphism. -/
private theorem left_apply_comp_eq {S : Scheme.{u}} {X Y Z : Over S} (f : X ⟶ Y) (g : Y ⟶ Z)
    (h : X ⟶ Z) (e : f ≫ g = h) (x : X.left) : g.left (f.left x) = h.left x := by
  rw [← Scheme.Hom.comp_apply, ← Over.comp_left, e]

/-- The source of an identity arrow is the object it sits at. -/
theorem source_apply_identity (x : G.objects.left) : G.source.left (G.identity.left x) = x :=
  left_apply_comp_eq _ _ _ G.source_identity x

/-- The target of an identity arrow is the object it sits at. -/
theorem target_apply_identity (x : G.objects.left) : G.target.left (G.identity.left x) = x :=
  left_apply_comp_eq _ _ _ G.target_identity x

/-- The first member of the pair of identities at `x` is the identity at `x`. -/
theorem fst_apply_identityPair (x : G.objects.left) :
    (pullback.fst G.source G.target).left (G.identityPair.left x) = G.identity.left x :=
  left_apply_comp_eq _ _ _ G.identityPair_fst x

/-- The second member of the pair of identities at `x` is the identity at `x`. -/
theorem snd_apply_identityPair (x : G.objects.left) :
    (pullback.snd G.source G.target).left (G.identityPair.left x) = G.identity.left x :=
  left_apply_comp_eq _ _ _ G.identityPair_snd x

/-- The composite of the pair of identities at `x` is the identity at `x`. -/
theorem comp_apply_identityPair (x : G.objects.left) :
    G.comp.left (G.identityPair.left x) = G.identity.left x :=
  left_apply_comp_eq _ _ _ G.identityPair_comp x

/-- Inversion fixes an identity arrow. -/
theorem inverse_apply_identity (x : G.objects.left) :
    G.inverse.left (G.identity.left x) = G.identity.left x :=
  left_apply_comp_eq _ _ _ G.identity_comp_inverse x

/-- The right unit section carries an identity arrow to the pair of identities. -/
theorem rightUnitPair_apply_identity (x : G.objects.left) :
    G.rightUnitPair.left (G.identity.left x) = G.identityPair.left x :=
  left_apply_comp_eq _ _ _ G.identity_comp_rightUnitPair x

/-- The left unit section carries an identity arrow to the pair of identities. -/
theorem leftUnitPair_apply_identity (x : G.objects.left) :
    G.leftUnitPair.left (G.identity.left x) = G.identityPair.left x :=
  left_apply_comp_eq _ _ _ G.identity_comp_leftUnitPair x

/-- The inverse-pair section carries an identity arrow to the pair of identities. -/
theorem inversePair_apply_identity (x : G.objects.left) :
    G.inversePair.left (G.identity.left x) = G.identityPair.left x :=
  left_apply_comp_eq _ _ _ G.identity_comp_inversePair x

/-! ### The stalk maps at an identity -/

variable (x : G.objects.left)

/-- The map on local rings induced by the source, at an identity. -/
noncomputable def stalkSource :
    G.objects.left.presheaf.stalk x →+* G.arrows.left.presheaf.stalk (G.identity.left x) :=
  G.source.left.stalkMapAt (G.identity.left x) x (G.source_apply_identity x)

/-- The map on local rings induced by the target, at an identity. -/
noncomputable def stalkTarget :
    G.objects.left.presheaf.stalk x →+* G.arrows.left.presheaf.stalk (G.identity.left x) :=
  G.target.left.stalkMapAt (G.identity.left x) x (G.target_apply_identity x)

/-- The map on local rings induced by the identity section, at an identity. -/
noncomputable def stalkIdentity :
    G.arrows.left.presheaf.stalk (G.identity.left x) →+* G.objects.left.presheaf.stalk x :=
  G.identity.left.stalkMapAt x (G.identity.left x) rfl

/-- The map on local rings induced by the first projection, at the pair of identities. -/
noncomputable def stalkFirst :
    G.arrows.left.presheaf.stalk (G.identity.left x) →+*
      (pullback G.source G.target).left.presheaf.stalk (G.identityPair.left x) :=
  (pullback.fst G.source G.target).left.stalkMapAt (G.identityPair.left x) (G.identity.left x)
    (G.fst_apply_identityPair x)

/-- The map on local rings induced by the second projection, at the pair of identities. -/
noncomputable def stalkSecond :
    G.arrows.left.presheaf.stalk (G.identity.left x) →+*
      (pullback G.source G.target).left.presheaf.stalk (G.identityPair.left x) :=
  (pullback.snd G.source G.target).left.stalkMapAt (G.identityPair.left x) (G.identity.left x)
    (G.snd_apply_identityPair x)

/-- The map on local rings induced by composition, at the pair of identities. -/
noncomputable def stalkComposition :
    G.arrows.left.presheaf.stalk (G.identity.left x) →+*
      (pullback G.source G.target).left.presheaf.stalk (G.identityPair.left x) :=
  G.comp.left.stalkMapAt (G.identityPair.left x) (G.identity.left x)
    (G.comp_apply_identityPair x)

/-- The map on local rings induced by the right unit section, at an identity. -/
noncomputable def stalkRightUnit :
    (pullback G.source G.target).left.presheaf.stalk (G.identityPair.left x) →+*
      G.arrows.left.presheaf.stalk (G.identity.left x) :=
  G.rightUnitPair.left.stalkMapAt (G.identity.left x) (G.identityPair.left x)
    (G.rightUnitPair_apply_identity x)

/-- The map on local rings induced by the left unit section, at an identity. -/
noncomputable def stalkLeftUnit :
    (pullback G.source G.target).left.presheaf.stalk (G.identityPair.left x) →+*
      G.arrows.left.presheaf.stalk (G.identity.left x) :=
  G.leftUnitPair.left.stalkMapAt (G.identity.left x) (G.identityPair.left x)
    (G.leftUnitPair_apply_identity x)

/-- The map on local rings induced by the inverse-pair section, at an identity. -/
noncomputable def stalkInversePair :
    (pullback G.source G.target).left.presheaf.stalk (G.identityPair.left x) →+*
      G.arrows.left.presheaf.stalk (G.identity.left x) :=
  G.inversePair.left.stalkMapAt (G.identity.left x) (G.identityPair.left x)
    (G.inversePair_apply_identity x)

/-- The map on local rings induced by inversion, at an identity. -/
noncomputable def stalkInverse :
    G.arrows.left.presheaf.stalk (G.identity.left x) →+*
      G.arrows.left.presheaf.stalk (G.identity.left x) :=
  G.inverse.left.stalkMapAt (G.identity.left x) (G.identity.left x)
    (G.inverse_apply_identity x)

/-! ### The conormal modules and the maps between them -/

/-- The ideal `I` of the identity: the kernel of the stalk map of the identity section at
`x`. -/
noncomputable abbrev identityIdeal : Ideal (G.arrows.left.presheaf.stalk (G.identity.left x)) :=
  G.identity.left.conormalIdeal x

/-- The ideal `J` of the pair of identities: the kernel of the stalk map of the section
`(e, e)` at `x`. -/
noncomputable abbrev pairIdeal :
    Ideal ((pullback G.source G.target).left.presheaf.stalk (G.identityPair.left x)) :=
  G.identityPair.left.conormalIdeal x

/-- The map `I/I² → J/J²` induced by composition. -/
noncomputable def compositionCotangent :
    (G.identityIdeal x).Cotangent →ₗ[ℤ] (G.pairIdeal x).Cotangent :=
  Scheme.Hom.conormalMap G.identity.left G.identityPair.left G.comp.left
    (congrArg Over.Hom.left G.identityPair_comp) x

/-- The map `I/I² → J/J²` induced by the first projection. -/
noncomputable def firstCotangent :
    (G.identityIdeal x).Cotangent →ₗ[ℤ] (G.pairIdeal x).Cotangent :=
  Scheme.Hom.conormalMap G.identity.left G.identityPair.left
    (pullback.fst G.source G.target).left (congrArg Over.Hom.left G.identityPair_fst) x

/-- The map `I/I² → J/J²` induced by the second projection. -/
noncomputable def secondCotangent :
    (G.identityIdeal x).Cotangent →ₗ[ℤ] (G.pairIdeal x).Cotangent :=
  Scheme.Hom.conormalMap G.identity.left G.identityPair.left
    (pullback.snd G.source G.target).left (congrArg Over.Hom.left G.identityPair_snd) x

/-- The endomorphism of `I/I²` induced by inversion. -/
noncomputable def inverseCotangent :
    (G.identityIdeal x).Cotangent →ₗ[ℤ] (G.identityIdeal x).Cotangent :=
  Scheme.Hom.conormalMap G.identity.left G.identity.left G.inverse.left
    (congrArg Over.Hom.left G.identity_comp_inverse) x

/-! ### Comparison with the fibre product of the underlying schemes -/

/-- The scheme of composable arrows, a fibre product in `Over S`, compared with the fibre
product of the underlying schemes. -/
noncomputable def pairSchemeIso :
    (pullback G.source G.target).left ≅ pullback G.source.left G.target.left :=
  (overFibreProduct_isPullback G.source G.target).isoPullback

/-- The comparison isomorphism `pairSchemeIso` is compatible with the first projections. -/
@[simp]
theorem pairSchemeIso_hom_fst :
    G.pairSchemeIso.hom ≫ pullback.fst G.source.left G.target.left =
      (pullback.fst G.source G.target).left :=
  (overFibreProduct_isPullback G.source G.target).isoPullback_hom_fst

/-- The comparison isomorphism `pairSchemeIso` is compatible with the second projections. -/
@[simp]
theorem pairSchemeIso_hom_snd :
    G.pairSchemeIso.hom ≫ pullback.snd G.source.left G.target.left =
      (pullback.snd G.source G.target).left :=
  (overFibreProduct_isPullback G.source G.target).isoPullback_hom_snd

/-- The pair of identities at `x`, read in the fibre product of the underlying schemes. -/
noncomputable def schemePairIdentityPoint : (pullback G.source.left G.target.left).carrier :=
  G.pairSchemeIso.hom (G.identityPair.left x)

/-- The first projection of `schemePairIdentityPoint x` is the identity at `x`. -/
theorem schemePairIdentity_fst :
    (pullback.fst G.source.left G.target.left) (G.schemePairIdentityPoint x) =
      G.identity.left x := by
  rw [schemePairIdentityPoint, ← Scheme.Hom.comp_apply, G.pairSchemeIso_hom_fst]
  exact G.fst_apply_identityPair x

/-- The second projection of `schemePairIdentityPoint x` is the identity at `x`. -/
theorem schemePairIdentity_snd :
    (pullback.snd G.source.left G.target.left) (G.schemePairIdentityPoint x) =
      G.identity.left x := by
  rw [schemePairIdentityPoint, ← Scheme.Hom.comp_apply, G.pairSchemeIso_hom_snd]
  exact G.snd_apply_identityPair x

/-- The source of the first projection of `schemePairIdentityPoint x` is `x`. -/
theorem schemePairIdentity_source :
    (pullback.fst G.source.left G.target.left ≫ G.source.left)
      (G.schemePairIdentityPoint x) = x := by
  rw [Scheme.Hom.comp_apply, G.schemePairIdentity_fst]
  exact G.source_apply_identity x

/-! ### The ideal of the pair of identities -/

/-- The ideal `J` is the kernel of the local ring map obtained by composing the right unit with
the identity. -/
theorem pairIdeal_eq_ker :
    G.pairIdeal x = RingHom.ker ((G.stalkIdentity x).comp (G.stalkRightUnit x)) := by
  unfold pairIdeal Scheme.Hom.conormalIdeal
  have hpt : G.identityPair.left x = G.identityPair.left.base x := rfl
  change RingHom.ker (G.identityPair.left.stalkMapAt x (G.identityPair.left x) hpt) = _
  congr 1
  rw [stalkIdentity, stalkRightUnit, Scheme.Hom.stalkMapAt_comp_left,
    Scheme.Hom.stalkMapAt_congr _ _ (congrArg Over.Hom.left G.identity_comp_rightUnitPair)]

/-- **The identification `J = I·C + C·I`.**  The ideal of the pair of identities is generated
by the two images of the ideal of the identity. -/
theorem pairIdeal_eq_sup :
    G.pairIdeal x = (G.identityIdeal x).map (G.stalkFirst x) ⊔
      (G.identityIdeal x).map (G.stalkSecond x) := by
  let p := G.identityPair.left x
  let t := G.pairSchemeIso.hom
  let q := t p
  have ha : (pullback.fst G.source.left G.target.left) q = G.identity.left x :=
    G.schemePairIdentity_fst x
  have hb : (pullback.snd G.source.left G.target.left) q = G.identity.left x :=
    G.schemePairIdentity_snd x
  have hz : (pullback.fst G.source.left G.target.left ≫ G.source.left) q = x :=
    G.schemePairIdentity_source x
  let e := (G.identityPair.left.stalkMap x).hom
  let k := (t.stalkMap p).hom
  let a := (pullback.fst G.source.left G.target.left).stalkMapAt q (G.identity.left x) ha
  let b := (pullback.snd G.source.left G.target.left).stalkMapAt q (G.identity.left x) hb
  have hka : k.comp a = G.stalkFirst x := by
    change (t.stalkMapAt p q rfl).comp a = _
    dsimp only [a]
    rw [Scheme.Hom.stalkMapAt_comp]
    exact Scheme.Hom.stalkMapAt_congr _ _ (G.pairSchemeIso_hom_fst) _ _ _ _
  have hkb : k.comp b = G.stalkSecond x := by
    change (t.stalkMapAt p q rfl).comp b = _
    dsimp only [b]
    rw [Scheme.Hom.stalkMapAt_comp]
    exact Scheme.Hom.stalkMapAt_congr _ _ (G.pairSchemeIso_hom_snd) _ _ _ _
  have hea : e.comp (G.stalkFirst x) = G.stalkIdentity x :=
    Scheme.Hom.stalkMapAt_triangle G.identity.left G.identityPair.left
      (pullback.fst G.source G.target).left (congrArg Over.Hom.left G.identityPair_fst) x
  have heb : e.comp (G.stalkSecond x) = G.stalkIdentity x :=
    Scheme.Hom.stalkMapAt_triangle G.identity.left G.identityPair.left
      (pullback.snd G.source G.target).left (congrArg Over.Hom.left G.identityPair_snd) x
  have he : (e.comp k).comp
      ((pullback.fst G.source.left G.target.left ≫ G.source.left).stalkMapAt q x hz) =
        RingHom.id _ := by
    change ((G.identityPair.left.stalkMapAt x p rfl).comp (t.stalkMapAt p q rfl)).comp _ = _
    rw [Scheme.Hom.stalkMapAt_comp, Scheme.Hom.stalkMapAt_comp]
    have ht : (G.identityPair.left ≫ t) ≫
        (pullback.fst G.source.left G.target.left ≫ G.source.left) = 𝟙 G.objects.left := by
      rw [Category.assoc, ← Category.assoc t, G.pairSchemeIso_hom_fst, ← Category.assoc]
      change ((G.identityPair ≫ pullback.fst G.source G.target) ≫ G.source).left = _
      rw [identityPair_fst, G.source_identity]
      rfl
    rw [Scheme.Hom.stalkMapAt_congr _ _ ht x x _ rfl]
    exact Scheme.Hom.stalkMapAt_id _ _
  have h := ker_eq_sup_map_stalkMapAt_of_isPullback G.source.left G.target.left q
    (G.identity.left x) (G.identity.left x) x ha hb hz (e.comp k) he
  change RingHom.ker (e.comp k) =
    (RingHom.ker ((e.comp k).comp a)).map a ⊔ (RingHom.ker ((e.comp k).comp b)).map b at h
  have hm := congrArg (Ideal.map k) h
  rw [← RingHom.comap_ker,
    Ideal.map_comap_of_surjective k (ConcreteCategory.bijective_of_isIso (t.stalkMap p)).2] at hm
  simp only [Ideal.map_sup, Ideal.map_map, RingHom.comp_assoc, hka, hkb, hea, heb] at hm
  exact hm

/-- The local model of the groupoid at the identity above `x`: the stalk maps of source,
target, identity, the two projections, composition, inversion and the three unit sections,
together with the identification `J = I·C + C·I`. -/
noncomputable def stalkLocalGroupoidAlgebra :
    LocalGroupoidAlgebra (G.objects.left.presheaf.stalk x)
      (G.arrows.left.presheaf.stalk (G.identity.left x))
      ((pullback G.source G.target).left.presheaf.stalk (G.identityPair.left x)) where
  source := G.stalkSource x
  target := G.stalkTarget x
  identity := G.stalkIdentity x
  first := G.stalkFirst x
  second := G.stalkSecond x
  comp := G.stalkComposition x
  inverse := G.stalkInverse x
  rightUnit := G.stalkRightUnit x
  leftUnit := G.stalkLeftUnit x
  inversePair := G.stalkInversePair x
  identity_source := by
    rw [stalkIdentity, stalkSource, Scheme.Hom.stalkMapAt_comp_left,
      Scheme.Hom.stalkMapAt_congr _ _ (congrArg Over.Hom.left G.source_identity)]
    exact Scheme.Hom.stalkMapAt_id' _ _ (by simp)
  identity_target := by
    rw [stalkIdentity, stalkTarget, Scheme.Hom.stalkMapAt_comp_left,
      Scheme.Hom.stalkMapAt_congr _ _ (congrArg Over.Hom.left G.target_identity)]
    exact Scheme.Hom.stalkMapAt_id' _ _ (by simp)
  rightUnit_first := by
    rw [stalkRightUnit, stalkFirst, Scheme.Hom.stalkMapAt_comp_left,
      Scheme.Hom.stalkMapAt_congr _ _ (congrArg Over.Hom.left G.rightUnitPair_fst)]
    exact Scheme.Hom.stalkMapAt_id' _ _ (by simp)
  rightUnit_second := by
    rw [stalkRightUnit, stalkSecond, stalkSource, stalkIdentity,
      Scheme.Hom.stalkMapAt_comp_left, Scheme.Hom.stalkMapAt_comp_left,
      Scheme.Hom.stalkMapAt_congr _ _ (congrArg Over.Hom.left G.rightUnitPair_snd)]
  leftUnit_first := by
    rw [stalkLeftUnit, stalkFirst, stalkTarget, stalkIdentity,
      Scheme.Hom.stalkMapAt_comp_left, Scheme.Hom.stalkMapAt_comp_left,
      Scheme.Hom.stalkMapAt_congr _ _ (congrArg Over.Hom.left G.leftUnitPair_fst)]
  leftUnit_second := by
    rw [stalkLeftUnit, stalkSecond, Scheme.Hom.stalkMapAt_comp_left,
      Scheme.Hom.stalkMapAt_congr _ _ (congrArg Over.Hom.left G.leftUnitPair_snd)]
    exact Scheme.Hom.stalkMapAt_id' _ _ (by simp)
  rightUnit_comp := by
    rw [stalkRightUnit, stalkComposition, Scheme.Hom.stalkMapAt_comp_left,
      Scheme.Hom.stalkMapAt_congr _ _ (congrArg Over.Hom.left G.rightUnitPair_comp)]
    exact Scheme.Hom.stalkMapAt_id' _ _ (by simp)
  leftUnit_comp := by
    rw [stalkLeftUnit, stalkComposition, Scheme.Hom.stalkMapAt_comp_left,
      Scheme.Hom.stalkMapAt_congr _ _ (congrArg Over.Hom.left G.leftUnitPair_comp)]
    exact Scheme.Hom.stalkMapAt_id' _ _ (by simp)
  inversePair_first := by
    rw [stalkInversePair, stalkFirst, Scheme.Hom.stalkMapAt_comp_left,
      Scheme.Hom.stalkMapAt_congr _ _ (congrArg Over.Hom.left G.inversePair_fst)]
    exact Scheme.Hom.stalkMapAt_id' _ _ (by simp)
  inversePair_second := by
    rw [stalkInversePair, stalkSecond, stalkInverse, Scheme.Hom.stalkMapAt_comp_left,
      Scheme.Hom.stalkMapAt_congr _ _ (congrArg Over.Hom.left G.inversePair_snd)]
  inversePair_comp := by
    rw [stalkInversePair, stalkComposition, stalkTarget, stalkIdentity,
      Scheme.Hom.stalkMapAt_comp_left, Scheme.Hom.stalkMapAt_comp_left,
      Scheme.Hom.stalkMapAt_congr _ _ (congrArg Over.Hom.left G.inversePair_comp)]
  identity_inverse := by
    rw [stalkIdentity, stalkInverse, Scheme.Hom.stalkMapAt_comp_left,
      Scheme.Hom.stalkMapAt_congr _ _ (congrArg Over.Hom.left G.identity_comp_inverse)]
  ideal_pairs := by
    rw [← G.pairIdeal_eq_ker x]
    exact G.pairIdeal_eq_sup x

/-- At an identity of a groupoid scheme, the map `I/I² → J/J²` induced by composition is the
diagonal followed by the two maps induced by the projections. -/
@[stacks 0CK4 "composition on I/I²"]
theorem cotangent_composition :
    G.compositionCotangent x =
      ((G.firstCotangent x).coprod (G.secondCotangent x)).comp
        (LinearMap.id.prod LinearMap.id) := by
  set K := G.stalkLocalGroupoidAlgebra x with hK
  refine LinearMap.ext fun z ↦ ?_
  obtain ⟨b, rfl⟩ := Ideal.toCotangent_surjective (G.identityIdeal x) z
  have hcomp := K.mapCotangent_comp b
  simp only [LinearMap.comp_apply, LinearMap.prod_apply, LinearMap.coprod_apply] at *
  simp only [compositionCotangent, firstCotangent, secondCotangent,
    Scheme.Hom.conormalMap_toCotangent] at *
  change (G.pairIdeal x).toCotangent _ =
    (G.pairIdeal x).toCotangent _ + (G.pairIdeal x).toCotangent _
  refine (G.pairIdeal x).cotangentToQuotientSquare_injective ?_
  have hq := congrArg K.pairIdeal.cotangentToQuotientSquare hcomp
  simp only [map_add, Ideal.toCotangent_to_quotient_square] at hq ⊢
  rwa [show K.pairIdeal = G.pairIdeal x from (G.pairIdeal_eq_ker x).symm] at hq

/-- At an identity of a groupoid scheme, inversion acts by `-1` on `I/I²`. -/
@[stacks 0CK4 "inversion on I/I²"]
theorem cotangent_inverse : G.inverseCotangent x = -LinearMap.id := by
  refine LinearMap.ext fun z ↦ ?_
  obtain ⟨b, rfl⟩ := Ideal.toCotangent_surjective (G.identityIdeal x) z
  exact (G.stalkLocalGroupoidAlgebra x).mapCotangent_inverse b

/- For a groupoid in algebraic spaces the first-order structure at an identity is computed on an
étale scheme chart, where it is the groupoid-scheme computation above: composition is the
diagonal followed by the two projections and inversion is `-1`. -/
add_to_stacks 0CKA "composition on I/I²"
  Stacks.Groupoids.GroupoidScheme.cotangent_composition
add_to_stacks 0CKA "inversion on I/I²" Stacks.Groupoids.GroupoidScheme.cotangent_inverse

end Stacks.Groupoids.GroupoidScheme

end
