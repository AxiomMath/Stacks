/-!
# The two "it suffices" claims of Stacks 0AIW, for arbitrary ideal sheaves

**Stacks 0AIW** makes two claims of the form "it suffices to check":

1. an ideal sheaf `ℐ ⊆ 𝒪_𝔛` is an ideal of definition as soon as `ℐ(𝔘)` is an ideal of definition
   of `𝒪_𝔛(𝔘)` for the members `𝔘` of an affine open covering, and a family of ideals of
   definition is a fundamental system as soon as it is one over the members of such a covering;
2. on a quasi-compact `𝔛`, a fundamental system `{ℐ_λ}` of *weak* ideals of definition consists of
   ideals of definition for `λ` sufficiently large, "since we only need to check on the finitely
   many members of an affine open covering".

Both are false for ideal sheaves in the generality in which the source states them — an ideal
sheaf is any sheaf of ideals of `𝒪_𝔛`, as in
`AlgebraicGeometry.LocallyTopologicallyRingedSpace.IdealSheaf` — and this file proves it with one
explicit formal scheme à la EGA: the pseudo-discretisation of the affine scheme
`Spec E`, `E = ℤ[X₀, X₁, …] / (X_k ^ (k + 1))`. The claims hold for the ideal sheaves the source
has in mind, those determined over each affine formal open by their sections there; an arbitrary
ideal sheaf is not, because nothing ties its sections over a small affine formal open to those
over a large one beyond the restriction maps.

## The counterexample

`E` has the reduction `E → ℤ` killing all variables, its kernel is the nilradical, and every
element with non-zero reduction is a non-zero-divisor; so `Spec E` has the topology of `Spec ℤ`,
and a section of `𝒪` over an open that vanishes near one point vanishes
(`AlgebraicGeometry.eq_zero_of_germ_eq_zero_of_isAffine`). The nilradical of `E` is not nilpotent:
`X_m` is nilpotent with `X_m ^ m ≠ 0`.

For a global section `c` and ideals `P z` of the stalks, the sections whose germs lie in `P z`
everywhere and vanish at every point outside the basic open `D(c)` form an ideal sheaf
(`AlgebraicGeometry.LocallyTopologicallyRingedSpace.IdealSheaf.germsVanishingOff`). Over an open
containing a point outside `D(c)` it is zero; over `D(c)` it contains the global sections whose
germs lie in the `P z`.

* With `P z` the nilradical of the stalk and `c = n!`, the ideal sheaves `ℐ_n` form a
  nonempty, decreasing family which is a fundamental system of weak ideals of definition over
  the affine formal opens — over a nonempty quasi-compact open, some `ℐ_n` is zero, since the open
  contains a point at which some `n!` vanishes — and no `ℐ_n` is an ideal of definition, since its
  sections over `D(n!)` contain the whole nilradical of `E`. This refutes claim 2, and with the
  covering `{𝔛}`, over which `ℐ_n` is zero for `n` large, the first half of claim 1.
* With `P z` the ideal generated by the germ of `X₁`, whose square is zero, the ideal sheaf `𝒥`
  is an ideal of definition over every affine formal open and is zero over `𝔛`, so `{𝒥}` is a
  fundamental system over the covering `{𝔛}`; but over `D(c)` its sections contain `X₁ ≠ 0` while
  `{0}` is open. This refutes the second half of claim 1, even for a nonempty directed family of
  ideals of definition.

## Main results

* `AlgebraicGeometry.LocallyTopologicallyRingedSpace`
  `.not_forall_exists_isIdealOfDefinitionOn_of_isFundamentalSystemOfWeakIdealsOfDefinitionOn`:
  claim 2 is false.
* `AlgebraicGeometry.LocallyTopologicallyRingedSpace.not_forall_isIdealOfDefinitionOn_of_cover`:
  the first half of claim 1 is false.
* `AlgebraicGeometry.LocallyTopologicallyRingedSpace`
  `.not_forall_isFundamentalSystemOfIdealsOfDefinitionOn_of_hasBasis_cover`: the second half of
  claim 1 is false.

The corrected forms are `IdealSheaf.isIdealOfDefinitionOn_of_cover`,
`isFundamentalSystemOfIdealsOfDefinitionOn_of_cover_of_directed` and
`exists_isIdealOfDefinition_of_isFundamentalSystemOfWeakIdealsOfDefinitionOn`, where the
conditions are checked on the affine formal opens *contained in* the members of a covering, and
the eventual conclusion holds over the members of a finite covering.

## References

* [Stacks Project, Tag 0AIW](https://stacks.math.columbia.edu/tag/0AIW)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

namespace AlgebraicGeometry

universe u

/-! ### Affine formal opens of a pseudo-discretised scheme -/

/-- An affine open of a scheme is an affine formal open subscheme of its pseudo-discretisation:
its ring of sections, with the discrete topology, is admissible, and the formal spectrum of a
discrete ring is its spectrum. -/
theorem isAffineFormalOpen_schemeToLTRSObj (X : Scheme.{u}) {U : X.Opens}
    (hU : IsAffineOpen U) : IsAffineFormalOpen (schemeToLTRSObj X) U := by
  let R : CommRingCat.{u} := Γ(X, U)
  let _ : TopologicalSpace R := ⊥
  let _ : DiscreteTopology R := discreteTopology_bot R
  refine ⟨TopCommRingCat.of R, inferInstance, isAdmissible_discrete R, ?_⟩
  let affineIso : X.restrict U.isOpenEmbedding ≅ Spec R := hU.isoSpec
  refine ⟨?_ ≪≫ pseudoDiscreteSpaceIso ((Scheme.forgetToLocallyRingedSpace ⋙
    LocallyRingedSpace.forgetToSheafedSpace ⋙
    SheafedSpace.forgetToPresheafedSpace).mapIso affineIso)
    ≪≫ discreteSpecSpfIsoOn R (isIdealOfDefinition_bot_discrete R)⟩
  exact PresheafedSpace.isoOfComponents (Iso.refl _)
    (pseudoDiscreteWhiskerIso U.inclusion' U.isOpenEmbedding' X.presheaf).symm

/-- On the pseudo-discretisation of a scheme the sections over a quasi-compact open are
discrete. -/
theorem discreteTopology_schemeToLTRSObj (X : Scheme.{u}) {W : X.Opens}
    (hW : IsCompact (W : Set X)) :
    DiscreteTopology ((schemeToLTRSObj X).presheaf.obj (op W)).α :=
  ⟨pseudoDiscreteTopology_eq_bot X.presheaf hW⟩

/-- An affine formal open subscheme is quasi-compact: it is homeomorphic to the space of open
primes of a pre-admissible ring. -/
theorem isCompact_of_isAffineFormalOpen {X : LTRS.{u}} {U : Opens X}
    (hU : IsAffineFormalOpen X U) : IsCompact (U : Set X) := by
  obtain ⟨A, hlin, hA, ⟨e⟩⟩ := hU
  let _ := hlin
  have : CompactSpace (spfSpace A.α) := compactSpace_spfSpace A.α hA.1
  let eU : U ≃ₜ spfSpace A.α := TopCat.homeoOfIso ((PresheafedSpace.forget _).mapIso e)
  have : CompactSpace U := eU.symm.compactSpace
  exact isCompact_iff_compactSpace.mpr inferInstance

/-! ### Sections of a scheme seen through their germs -/

/-- The germ of a section at a point of its basic open is a unit, hence not nilpotent. -/
private theorem not_isNilpotent_germ_of_mem_basicOpen {X : Scheme.{u}} {U : X.Opens}
    {f : Γ(X, U)} {x : X} (hx : x ∈ X.basicOpen f) :
    ¬ IsNilpotent (X.presheaf.germ U x (X.basicOpen_le f hx) f) :=
  ((X.mem_basicOpen f x _).mp hx).not_isNilpotent

/-- A section over a quasi-compact open of a scheme whose germs are all nilpotent is
nilpotent. -/
theorem isNilpotent_of_forall_isNilpotent_germ (X : Scheme.{u}) {V : X.Opens}
    (hV : IsCompact (V : Set X)) (s : Γ(X, V))
    (h : ∀ z (hz : z ∈ V), IsNilpotent (X.presheaf.germ V z hz s)) : IsNilpotent s := by
  rw [Scheme.isNilpotent_iff_basicOpen_eq_bot_of_isCompact hV]
  refine eq_bot_iff.mpr fun x hx => ?_
  exact (not_isNilpotent_germ_of_mem_basicOpen hx (h x _)).elim

/-- A section is not nilpotent at a point of its basic open, where its germ is a unit of a local
ring. -/
theorem not_isNilpotent_of_mem_basicOpen {X : Scheme.{u}} {U : X.Opens} {f : Γ(X, U)} {x : X}
    (hx : x ∈ X.basicOpen f) : ¬ IsNilpotent f :=
  fun h => not_isNilpotent_germ_of_mem_basicOpen hx (h.map _)

/-- On an affine scheme whose non-nilpotent global sections are non-zero-divisors, a section over
any open which vanishes near one point of the open vanishes. Two basic opens inside the open
meet in the basic open of the product, a non-zero-divisor, and restriction to it is injective on
the localization at either factor. -/
theorem eq_zero_of_germ_eq_zero_of_isAffine (X : Scheme.{u}) [IsAffine X]
    (hreg : ∀ a : Γ(X, ⊤), ¬ IsNilpotent a → a ∈ nonZeroDivisors Γ(X, ⊤))
    {V : X.Opens} (s : Γ(X, V)) {z : X} (hz : z ∈ V)
    (h : X.presheaf.germ V z hz s = 0) : s = 0 := by
  obtain ⟨W, hzW, iU, iV, heq⟩ := X.presheaf.germ_eq z hz hz s 0 (by rw [h, map_zero])
  rw [map_zero] at heq
  obtain ⟨_, ⟨hh, rfl⟩, hzh, hhW⟩ := (Opens.isBasis_iff_nbhd.mp (isBasis_basicOpen X)) hzW
  refine TopCat.Presheaf.section_ext X.sheaf V s 0 fun y hy => ?_
  obtain ⟨_, ⟨g, rfl⟩, hyg, hgV⟩ := (Opens.isBasis_iff_nbhd.mp (isBasis_basicOpen X)) hy
  have hgnil : ¬ IsNilpotent g := not_isNilpotent_of_mem_basicOpen hyg
  have hhnil : ¬ IsNilpotent hh := not_isNilpotent_of_mem_basicOpen hzh
  have hgh : g * hh ∈ nonZeroDivisors Γ(X, ⊤) := mul_mem (hreg g hgnil) (hreg hh hhnil)
  have hle : X.basicOpen (g * hh) ≤ X.basicOpen g := by
    rw [X.basicOpen_mul]; exact inf_le_left
  have hle' : X.basicOpen (g * hh) ≤ W := by
    rw [X.basicOpen_mul]; exact inf_le_right.trans hhW
  have hres : X.presheaf.map (homOfLE hle).op (X.presheaf.map (homOfLE hgV).op s) = 0 := by
    have hcomp : X.presheaf.map (homOfLE hle).op (X.presheaf.map (homOfLE hgV).op s) =
        X.presheaf.map (homOfLE hle').op (X.presheaf.map iU.op s) := by
      rw [← ConcreteCategory.comp_apply, ← ConcreteCategory.comp_apply, ← Functor.map_comp,
        ← Functor.map_comp]
      rfl
    rw [hcomp, heq, map_zero]
  have halg : ∀ a : Γ(X, ⊤), X.presheaf.map (homOfLE hle).op (algebraMap Γ(X, ⊤)
      Γ(X, X.basicOpen g) a) = algebraMap Γ(X, ⊤) Γ(X, X.basicOpen (g * hh)) a := by
    intro a
    show X.presheaf.map (homOfLE hle).op (X.presheaf.map (homOfLE (X.basicOpen_le g)).op a) =
      X.presheaf.map (homOfLE (X.basicOpen_le (g * hh))).op a
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have ht0 : X.presheaf.map (homOfLE hgV).op s = 0 := by
    obtain ⟨⟨a, m⟩, hm⟩ := IsLocalization.mk'_surjective
      (S := Γ(X, X.basicOpen g)) (Submonoid.powers g) (X.presheaf.map (homOfLE hgV).op s)
    dsimp only at hm
    have hspec := IsLocalization.mk'_spec Γ(X, X.basicOpen g) a m
    rw [hm] at hspec
    have ha : algebraMap Γ(X, ⊤) Γ(X, X.basicOpen (g * hh)) a = 0 := by
      rw [← halg, ← hspec, map_mul, hres, zero_mul]
    have ha0 : a = 0 := by
      have hinj := IsLocalization.injective Γ(X, X.basicOpen (g * hh))
        (M := Submonoid.powers (g * hh)) (Submonoid.powers_le.mpr hgh)
      exact hinj (by rw [ha, map_zero])
    rw [ha0, IsLocalization.mk'_zero] at hm
    exact hm.symm
  show X.presheaf.germ V y hy s = X.presheaf.germ V y hy 0
  rw [map_zero, ← TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE hgV) y hyg s,
    ht0, map_zero]


/-! ### Ideal sheaves cut out by conditions on germs -/

/-- On a scheme `X`, given an ideal `P z` of every stalk and a global section `c`, the ideal of
sections over `W` whose germ at every point `z` lies in `P z`, and vanishes when `z` lies outside
the basic open of `c`. -/
noncomputable def germsVanishingOffIdeal (X : Scheme.{u}) (P : ∀ z : X, Ideal (X.presheaf.stalk z))
    (c : Γ(X, ⊤)) (W : X.Opens) : Ideal Γ(X, W) :=
  ⨅ (z : X) (hz : z ∈ W), Ideal.comap (X.presheaf.germ W z hz).hom
    (P z ⊓ ⨅ (_ : z ∉ X.basicOpen c), ⊥)

/-- Membership in `germsVanishingOffIdeal`, unfolded. -/
theorem mem_germsVanishingOffIdeal (X : Scheme.{u}) (P : ∀ z : X, Ideal (X.presheaf.stalk z))
    (c : Γ(X, ⊤)) (W : X.Opens) (s : Γ(X, W)) :
    s ∈ germsVanishingOffIdeal X P c W ↔ ∀ z (hz : z ∈ W),
      X.presheaf.germ W z hz s ∈ P z ∧ (z ∉ X.basicOpen c → X.presheaf.germ W z hz s = 0) := by
  simp only [germsVanishingOffIdeal, Submodule.mem_iInf, Ideal.mem_comap, Submodule.mem_inf]
  refine forall_congr' fun z => forall_congr' fun hz => and_congr Iff.rfl ?_
  refine ⟨fun h hc => ?_, fun h hc => ?_⟩
  · simpa using h hc
  · simpa using h hc

namespace LocallyTopologicallyRingedSpace.IdealSheaf

/-- On the pseudo-discretisation of a scheme `X`, given an ideal `P z` of every stalk and a global
section `c`, the ideal sheaf of sections whose germ at every point `z` lies in `P z`, and vanishes
when `z` lies outside the basic open of `c`. Both conditions are conditions on germs, which is why
this is a sheaf. -/
noncomputable def germsVanishingOff (X : Scheme.{u}) (P : ∀ z : X, Ideal (X.presheaf.stalk z))
    (c : Γ(X, ⊤)) : IdealSheaf (schemeToLTRSObj X) where
  ideal W := germsVanishingOffIdeal X P c W
  map_mem := by
    intro U V h s hs
    refine (mem_germsVanishingOffIdeal X P c V _).mpr fun z hz => ?_
    have hgerm : X.presheaf.germ V z hz (X.presheaf.map (homOfLE h).op s) =
        X.presheaf.germ U z (h hz) s :=
      TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE h) z hz s
    have hs' := (mem_germsVanishingOffIdeal X P c U s).mp hs z (h hz)
    exact ⟨hgerm ▸ hs'.1, fun hc => hgerm ▸ hs'.2 hc⟩
  mem_of_locally_mem := by
    intro U s hs
    refine (mem_germsVanishingOffIdeal X P c U s).mpr fun z hz => ?_
    obtain ⟨V, h, hzV, hmem⟩ := hs z hz
    have hgerm : X.presheaf.germ V z hzV (X.presheaf.map (homOfLE h).op s) =
        X.presheaf.germ U z hz s :=
      TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE h) z hzV s
    have hs' := (mem_germsVanishingOffIdeal X P c V _).mp hmem z hzV
    exact ⟨hgerm ▸ hs'.1, fun hc => hgerm ▸ hs'.2 hc⟩

/-- The ideal of sections of `germsVanishingOff` over an open. -/
theorem germsVanishingOff_ideal (X : Scheme.{u}) (P : ∀ z : X, Ideal (X.presheaf.stalk z))
    (c : Γ(X, ⊤)) (W : X.Opens) :
    (germsVanishingOff X P c).ideal W = germsVanishingOffIdeal X P c W := rfl

end LocallyTopologicallyRingedSpace.IdealSheaf

/-- Over an open containing a point outside the basic open of `c`, the ideal is zero, on an affine
scheme whose non-nilpotent global sections are non-zero-divisors: the germs of its sections vanish
at that point. -/
theorem germsVanishingOffIdeal_eq_bot (X : Scheme.{u}) [IsAffine X]
    (hreg : ∀ a : Γ(X, ⊤), ¬ IsNilpotent a → a ∈ nonZeroDivisors Γ(X, ⊤))
    (P : ∀ z : X, Ideal (X.presheaf.stalk z)) (c : Γ(X, ⊤)) {W : X.Opens} {z : X}
    (hz : z ∈ W) (hc : z ∉ X.basicOpen c) :
    germsVanishingOffIdeal X P c W = ⊥ :=
  eq_bot_iff.mpr fun s hs => (Ideal.mem_bot).mpr
    (eq_zero_of_germ_eq_zero_of_isAffine X hreg s hz
      (((mem_germsVanishingOffIdeal X P c W s).mp hs z hz).2 hc))

/-- The ideal shrinks as `c` is replaced by a multiple: the basic open shrinks. -/
theorem germsVanishingOffIdeal_antitone (X : Scheme.{u}) (P : ∀ z : X, Ideal (X.presheaf.stalk z))
    {c d : Γ(X, ⊤)} (h : c ∣ d) (W : X.Opens) :
    germsVanishingOffIdeal X P d W ≤ germsVanishingOffIdeal X P c W := by
  intro s hs
  rw [mem_germsVanishingOffIdeal] at hs ⊢
  obtain ⟨e, rfl⟩ := h
  intro z hz
  refine ⟨(hs z hz).1, fun hc => (hs z hz).2 fun hd => hc ?_⟩
  rw [X.basicOpen_mul] at hd
  exact hd.1

/-- Over the basic open of `c` the ideal contains the restriction of every global section whose
germs lie in the ideals `P z`. -/
theorem algebraMap_mem_germsVanishingOffIdeal (X : Scheme.{u})
    (P : ∀ z : X, Ideal (X.presheaf.stalk z)) (c a : Γ(X, ⊤))
    (ha : ∀ z, X.presheaf.Γgerm z a ∈ P z) :
    algebraMap Γ(X, ⊤) Γ(X, X.basicOpen c) a ∈ germsVanishingOffIdeal X P c (X.basicOpen c) := by
  rw [mem_germsVanishingOffIdeal]
  intro z hz
  have hgerm : X.presheaf.germ (X.basicOpen c) z hz (algebraMap Γ(X, ⊤) Γ(X, X.basicOpen c) a) =
      X.presheaf.Γgerm z a :=
    TopCat.Presheaf.germ_res_apply X.presheaf (homOfLE (X.basicOpen_le c)) z hz a
  exact ⟨hgerm ▸ ha z, fun h => absurd hz h⟩

/-- On an affine scheme, restriction to the basic open of a non-zero-divisor is injective. -/
theorem algebraMap_basicOpen_injective (X : Scheme.{u}) [IsAffine X] {c : Γ(X, ⊤)}
    (hc : c ∈ nonZeroDivisors Γ(X, ⊤)) :
    Function.Injective (algebraMap Γ(X, ⊤) Γ(X, X.basicOpen c)) :=
  IsLocalization.injective Γ(X, X.basicOpen c) (M := Submonoid.powers c)
    (Submonoid.powers_le.mpr hc)

/-! ### Sections with nilpotent germs -/

namespace LocallyTopologicallyRingedSpace

/-- Over an open with discrete sections, the ideals of sections of a family containing an ideal
sheaf that is zero there form a neighbourhood basis of zero. -/
private theorem hasBasis_nhds_zero_of_exists_ideal_eq_bot {X : LTRS.{u}} {W : Opens X}
    [DiscreteTopology (X.presheaf.obj (op W)).α] {𝒮 : Set (IdealSheaf X)}
    (h : ∃ I ∈ 𝒮, I.ideal W = ⊥) :
    (nhds (0 : (X.presheaf.obj (op W)).α)).HasBasis (· ∈ 𝒮)
      fun I : IdealSheaf X => (I.ideal W : Set (X.presheaf.obj (op W)).α) := by
  obtain ⟨I, hI, hbot⟩ := h
  refine ⟨fun t => ⟨fun ht => ⟨I, hI, ?_⟩, fun ⟨J, _, hJt⟩ => ?_⟩⟩
  · rw [hbot, Submodule.bot_coe, Set.singleton_subset_iff]
    exact mem_of_mem_nhds ht
  · exact Filter.mem_of_superset ((isOpen_discrete _).mem_nhds (Submodule.zero_mem _)) hJt

/-- The sections with nilpotent germs that vanish outside the basic open of `c n`, for a sequence
`c` such that every non-empty basic open contains a point outside some `D(c n)`, form a
fundamental system of weak ideals of definition over the affine formal opens of the
pseudo-discretisation of an affine scheme whose non-nilpotent global sections are
non-zero-divisors. Over a quasi-compact open the sections are discrete and nilpotent; over a
non-empty one some member is zero, and over an empty one every section is. -/
theorem isFundamentalSystemOfWeakIdealsOfDefinitionOn_germsVanishingOff_nilradical
    (X : Scheme.{u}) [IsAffine X]
    (hreg : ∀ a : Γ(X, ⊤), ¬ IsNilpotent a → a ∈ nonZeroDivisors Γ(X, ⊤))
    (c : ℕ → Γ(X, ⊤))
    (hexh : ∀ g : Γ(X, ⊤), ¬ IsNilpotent g → ∃ n, ∃ z ∈ X.basicOpen g, z ∉ X.basicOpen (c n)) :
    IsFundamentalSystemOfWeakIdealsOfDefinitionOn
      (Set.range fun n => IdealSheaf.germsVanishingOff X (fun _ => nilradical _) (c n))
      (IsAffineFormalOpen (schemeToLTRSObj X)) := by
  refine ⟨?_, fun W hW => ?_⟩
  · rintro _ ⟨n, rfl⟩ W hW
    have hcpt : IsCompact (W : Set (schemeToLTRSObj X)) := isCompact_of_isAffineFormalOpen hW
    have := discreteTopology_schemeToLTRSObj X hcpt
    refine ⟨isOpen_discrete _, fun s hs => ?_⟩
    have hnil : IsNilpotent (s : Γ(X, W)) := isNilpotent_of_forall_isNilpotent_germ X (V := W) hcpt
      s fun z hz => mem_nilradical.mp
        ((mem_germsVanishingOffIdeal X (fun z => nilradical _) (c n) W s).mp hs z hz).1
    exact hnil.isTopologicallyNilpotent
  · have := discreteTopology_schemeToLTRSObj X (isCompact_of_isAffineFormalOpen hW)
    refine hasBasis_nhds_zero_of_exists_ideal_eq_bot ?_
    by_cases hne : ∃ x, x ∈ W
    · obtain ⟨x, hx⟩ := hne
      obtain ⟨_, ⟨g, rfl⟩, hxg, hgW⟩ := (Opens.isBasis_iff_nbhd.mp (isBasis_basicOpen X)) hx
      obtain ⟨n, z, hzg, hzc⟩ := hexh g (not_isNilpotent_of_mem_basicOpen hxg)
      exact ⟨_, ⟨n, rfl⟩,
        germsVanishingOffIdeal_eq_bot X hreg (fun z => nilradical _) (c n) (hgW hzg) hzc⟩
    · push Not at hne
      refine ⟨_, ⟨0, rfl⟩, (Submodule.eq_bot_iff _).mpr fun s _ => ?_⟩
      exact TopCat.Presheaf.section_ext X.sheaf W s 0 fun y hy => absurd hy (hne y)

/-- The sections with nilpotent germs that vanish outside `D(c)` are not an ideal of definition
over the affine formal opens, when the nilradical of the global sections is not nilpotent and `c`
is not nilpotent: over the affine open `D(c)`, whose sections are discrete, they contain the
restriction of every nilpotent global section, and restriction to `D(c)` is injective. -/
theorem not_isIdealOfDefinitionOn_germsVanishingOff_nilradical (X : Scheme.{u}) [IsAffine X]
    (hreg : ∀ a : Γ(X, ⊤), ¬ IsNilpotent a → a ∈ nonZeroDivisors Γ(X, ⊤))
    (hnil : ∀ m : ℕ, ∃ a : Γ(X, ⊤), IsNilpotent a ∧ a ^ m ≠ 0)
    (c : Γ(X, ⊤)) (hc : ¬ IsNilpotent c) :
    ¬ (IdealSheaf.germsVanishingOff X (fun _ => nilradical _) c).IsIdealOfDefinitionOn
      (IsAffineFormalOpen (schemeToLTRSObj X)) := by
  intro hdef
  have haff : IsAffineOpen (X.basicOpen c) := (isAffineOpen_top X).basicOpen c
  have hD := hdef (X.basicOpen c) (isAffineFormalOpen_schemeToLTRSObj X haff)
  have := discreteTopology_schemeToLTRSObj X haff.isCompact
  obtain ⟨m, hm⟩ := hD.2 {0} ((isOpen_discrete _).mem_nhds rfl)
  obtain ⟨a, ha, ham⟩ := hnil m
  have hmem := algebraMap_mem_germsVanishingOffIdeal X (fun z => nilradical _) c a
    fun z => mem_nilradical.mpr (ha.map _)
  have hpow : (algebraMap Γ(X, ⊤) Γ(X, X.basicOpen c) a) ^ m = 0 :=
    hm (Ideal.pow_mem_pow hmem m)
  rw [← map_pow] at hpow
  exact ham (algebraMap_basicOpen_injective X (hreg c hc) (by rw [hpow, map_zero]))

/-! ### Sections with germs in a square-zero ideal -/

/-- The sections whose germs are multiples of the germ of a global section `ε` of square zero,
vanishing outside `D(c)`, are an ideal of definition over every quasi-compact open of the
pseudo-discretisation of a scheme: the sections there are discrete, and a product of two such
sections has vanishing germs, so the square of the ideal is zero. -/
theorem isIdealOfDefinition_germsVanishingOff_span (X : Scheme.{u}) {ε : Γ(X, ⊤)} (hε : ε ^ 2 = 0)
    (c : Γ(X, ⊤)) {W : X.Opens} (hW : IsCompact (W : Set X)) :
    letI := discreteTopology_schemeToLTRSObj X hW
    TopologicalRing.IsIdealOfDefinition
      ((IdealSheaf.germsVanishingOff X
        (fun z => Ideal.span {X.presheaf.Γgerm z ε}) c).ideal W) := by
  let := discreteTopology_schemeToLTRSObj X hW
  have key : ∀ s t : Γ(X, W),
      s ∈ germsVanishingOffIdeal X (fun z => Ideal.span {X.presheaf.Γgerm z ε}) c W →
      t ∈ germsVanishingOffIdeal X (fun z => Ideal.span {X.presheaf.Γgerm z ε}) c W →
      s * t = 0 := by
    intro s t hs ht
    have hs' := (mem_germsVanishingOffIdeal X _ c W s).mp hs
    have ht' := (mem_germsVanishingOffIdeal X _ c W t).mp ht
    refine TopCat.Presheaf.section_ext X.sheaf W (s * t) 0 fun y hy => ?_
    show X.presheaf.germ W y hy (s * t) = X.presheaf.germ W y hy 0
    obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp (hs' y hy).1
    obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp (ht' y hy).1
    have hεy : (X.presheaf.Γgerm y ε) ^ 2 = 0 := by rw [← map_pow, hε, map_zero]
    rw [map_mul, map_zero, ← ha, ← hb]
    linear_combination (a * b) * hεy
  have hsq : ((IdealSheaf.germsVanishingOff X
      (fun z => Ideal.span {X.presheaf.Γgerm z ε}) c).ideal W) ^ 2 = ⊥ := by
    rw [pow_two]
    exact eq_bot_iff.mpr (Ideal.mul_le.mpr fun s hs t ht => (Ideal.mem_bot).mpr (key s t hs ht))
  refine ⟨isOpen_discrete _, fun V hV => ⟨2, ?_⟩⟩
  rw [hsq, Submodule.bot_coe, Set.singleton_subset_iff]
  exact mem_of_mem_nhds hV

/-- The sections whose germs are multiples of the germ of a global section `ε ≠ 0`, vanishing
outside the basic open of a non-zero-divisor `c`, do not form a neighbourhood basis of zero over
the affine open `D(c)` on the pseudo-discretisation of an affine scheme: those sections are
discrete, and contain the restriction of `ε`, which is not zero. -/
theorem not_hasBasis_germsVanishingOff_span (X : Scheme.{u}) [IsAffine X] {ε : Γ(X, ⊤)}
    (hε : ε ≠ 0) {c : Γ(X, ⊤)} (hc : c ∈ nonZeroDivisors Γ(X, ⊤)) :
    ¬ (nhds (0 : ((schemeToLTRSObj X).presheaf.obj (op (X.basicOpen c))).α)).HasBasis
      (· ∈ ({IdealSheaf.germsVanishingOff X (fun z => Ideal.span {X.presheaf.Γgerm z ε}) c} :
        Set (IdealSheaf (schemeToLTRSObj X))))
      fun I => (I.ideal (X.basicOpen c) :
        Set ((schemeToLTRSObj X).presheaf.obj (op (X.basicOpen c))).α) := by
  intro hbasis
  have := discreteTopology_schemeToLTRSObj X ((isAffineOpen_top X).basicOpen c).isCompact
  obtain ⟨I, hI, hIt⟩ := hbasis.mem_iff.mp ((isOpen_discrete ({0} : Set
    ((schemeToLTRSObj X).presheaf.obj (op (X.basicOpen c))).α)).mem_nhds rfl)
  rw [Set.mem_singleton_iff.mp hI] at hIt
  have hmem := algebraMap_mem_germsVanishingOffIdeal X
    (fun z => Ideal.span {X.presheaf.Γgerm z ε}) c ε fun z => Ideal.mem_span_singleton_self _
  have h0 : algebraMap Γ(X, ⊤) Γ(X, X.basicOpen c) ε = 0 := hIt hmem
  exact hε (algebraMap_basicOpen_injective X hc (by rw [h0, map_zero]))

end LocallyTopologicallyRingedSpace

/-! ### The ring -/

namespace TruncatedPolynomialCounterexample

noncomputable section

open MvPolynomial

/-- The ideal `(X_k ^ (k + 1) : k ∈ ℕ)` of `ℤ[X_0, X_1, …]`. -/
def truncationIdeal : Ideal (MvPolynomial ℕ ℤ) :=
  Ideal.span (Set.range fun k : ℕ => X k ^ (k + 1))

/-- The ring `ℤ[X_0, X_1, …] / (X_k ^ (k + 1))`: its nilradical is not nilpotent. -/
abbrev TruncRing : Type := MvPolynomial ℕ ℤ ⧸ truncationIdeal

/-- The ideal `(X_k ^ (k + 1))` is the monomial ideal of the exponents `k + 1` at `k`. -/
theorem truncationIdeal_eq :
    truncationIdeal = Ideal.span ((fun s => monomial s (1 : ℤ)) ''
      Set.range fun k : ℕ => Finsupp.single k (k + 1)) := by
  rw [truncationIdeal, ← Set.range_comp]
  congr 1
  ext p
  simp [X_pow_eq_monomial]

/-- Membership in the monomial ideal `(X_k ^ (k + 1))`: every monomial of the support is divisible
by some `X_k ^ (k + 1)`. -/
theorem mem_truncationIdeal_iff (p : MvPolynomial ℕ ℤ) :
    p ∈ truncationIdeal ↔ ∀ m ∈ p.support, ∃ k : ℕ, Finsupp.single k (k + 1) ≤ m := by
  rw [truncationIdeal_eq, mem_ideal_span_monomial_image]
  simp

/-- The members of `(X_k ^ (k + 1))` have constant coefficient zero. -/
theorem constantCoeff_eq_zero_of_mem {p : MvPolynomial ℕ ℤ} (hp : p ∈ truncationIdeal) :
    constantCoeff p = 0 := by
  have hle : truncationIdeal ≤ RingHom.ker (constantCoeff (R := ℤ) (σ := ℕ)) := by
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨k, rfl⟩
    simp
  exact hle hp

/-- The reduction `ℤ[X_0, X_1, …] / (X_k ^ (k + 1)) → ℤ` sending every variable to zero. -/
noncomputable def reduction : TruncRing →+* ℤ :=
  Ideal.Quotient.lift truncationIdeal constantCoeff fun _ hp => constantCoeff_eq_zero_of_mem hp

/-- The reduction of the class of a polynomial is its constant coefficient. -/
theorem reduction_mk (p : MvPolynomial ℕ ℤ) :
    reduction (Ideal.Quotient.mk truncationIdeal p) = constantCoeff p :=
  Ideal.Quotient.lift_mk _ _ _

/-- The image of `X_k` is nilpotent, of order at most `k + 1`. -/
theorem isNilpotent_mk_X (k : ℕ) : IsNilpotent (Ideal.Quotient.mk truncationIdeal (X k)) :=
  ⟨k + 1, by rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]; exact Ideal.subset_span ⟨k, rfl⟩⟩

/-- An element with zero reduction is nilpotent: it lies in the ideal generated by the images of
the variables, which are nilpotent. -/
theorem isNilpotent_of_reduction_eq_zero {e : TruncRing} (he : reduction e = 0) :
    IsNilpotent e := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective e
  rw [reduction_mk] at he
  have hp : p ∈ Ideal.span (X '' (Set.univ : Set ℕ)) := by
    refine mem_ideal_span_X_image.mpr fun m hm => ?_
    by_contra hall
    push Not at hall
    have hm0 : m = 0 := Finsupp.ext fun i => hall i (Set.mem_univ i)
    rw [hm0, mem_support_iff] at hm
    exact hm (by simpa [MvPolynomial.constantCoeff_eq] using he)
  have hmap : Ideal.map (Ideal.Quotient.mk truncationIdeal) (Ideal.span (X '' Set.univ)) ≤
      nilradical TruncRing := by
    rw [Ideal.map_span]
    refine Ideal.span_le.mpr ?_
    rintro _ ⟨_, ⟨k, -, rfl⟩, rfl⟩
    exact mem_nilradical.mpr (isNilpotent_mk_X k)
  exact mem_nilradical.mp (hmap (Ideal.mem_map_of_mem _ hp))

/-- A non-zero integer is a non-zero-divisor: the ideal `(X_k ^ (k + 1))` is a monomial ideal, so
multiplying by a non-zero constant does not change membership. -/
theorem eq_zero_of_intCast_mul_eq_zero {n : ℤ} (hn : n ≠ 0) {t : TruncRing}
    (ht : (n : TruncRing) * t = 0) :
    t = 0 := by
  obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective t
  rw [← map_intCast (Ideal.Quotient.mk truncationIdeal), ← map_mul,
    Ideal.Quotient.eq_zero_iff_mem] at ht
  rw [Ideal.Quotient.eq_zero_iff_mem]
  rw [mem_truncationIdeal_iff] at ht ⊢
  intro m hm
  refine ht m ?_
  rw [← eq_intCast C n, C_mul', support_smul_eq hn]
  exact hm

/-- An element with non-zero reduction `n` is a non-zero-divisor: it is `n` plus a nilpotent `ν`,
and `t * e = 0` gives `t * n ^ j = t * (-ν) ^ j` for all `j`, which vanishes for `j` large. -/
theorem mem_nonZeroDivisors_of_reduction_ne_zero {e : TruncRing} (he : reduction e ≠ 0) :
    e ∈ nonZeroDivisors TruncRing := by
  set ν : TruncRing := e - (reduction e : TruncRing) with hν
  have hνnil : IsNilpotent ν := isNilpotent_of_reduction_eq_zero
    (by rw [hν, map_sub, map_intCast, Int.cast_id, sub_self])
  obtain ⟨k, hk⟩ := hνnil
  refine mem_nonZeroDivisors_iff_right.mpr fun t ht => ?_
  have h1 : t * (reduction e : TruncRing) = t * (-ν) := by linear_combination ht + t * hν
  have hstep : ∀ j : ℕ, t * (reduction e : TruncRing) ^ j = t * (-ν) ^ j := by
    intro j
    induction j with
    | zero => simp
    | succ j ih => linear_combination (-ν) ^ j * h1 + (reduction e : TruncRing) * ih
  have hzero : ((reduction e ^ k : ℤ) : TruncRing) * t = 0 := by
    rw [Int.cast_pow, mul_comm, hstep k, neg_pow, hk, mul_zero, mul_zero]
  exact eq_zero_of_intCast_mul_eq_zero (pow_ne_zero k he) hzero

/-- A non-nilpotent element has non-zero reduction. -/
theorem reduction_ne_zero_of_not_isNilpotent {e : TruncRing} (he : ¬ IsNilpotent e) :
    reduction e ≠ 0 := fun h => he (isNilpotent_of_reduction_eq_zero h)

/-- A non-nilpotent element is a non-zero-divisor. -/
theorem mem_nonZeroDivisors_of_not_isNilpotent {e : TruncRing} (he : ¬ IsNilpotent e) :
    e ∈ nonZeroDivisors TruncRing :=
  mem_nonZeroDivisors_of_reduction_ne_zero (reduction_ne_zero_of_not_isNilpotent he)

/-- The factorials are not nilpotent: their reductions are non-zero integers. -/
theorem not_isNilpotent_factorial (n : ℕ) : ¬ IsNilpotent (n.factorial : TruncRing) := by
  intro h
  have h' : IsNilpotent (reduction (n.factorial : TruncRing)) := h.map reduction
  rw [map_natCast] at h'
  exact (Nat.factorial_ne_zero n) (by exact_mod_cast h'.eq_zero)

/-- A non-nilpotent element lies outside a prime containing some factorial: reduce modulo a prime
number `p` larger than the absolute value of its reduction, and take `n = p`. -/
theorem exists_prime_not_mem_factorial_mem {e : TruncRing} (he : ¬ IsNilpotent e) :
    ∃ n : ℕ, ∃ z : PrimeSpectrum TruncRing,
      e ∉ z.asIdeal ∧ (n.factorial : TruncRing) ∈ z.asIdeal := by
  have hne := reduction_ne_zero_of_not_isNilpotent he
  obtain ⟨p, hple, hp⟩ := Nat.exists_infinite_primes ((reduction e).natAbs + 1)
  have : Fact p.Prime := ⟨hp⟩
  let ψ : TruncRing →+* ZMod p := (Int.castRingHom (ZMod p)).comp reduction
  refine ⟨p, ⟨RingHom.ker ψ, RingHom.ker_isPrime ψ⟩, ?_, ?_⟩
  · intro hmem
    change ((reduction e : ℤ) : ZMod p) = 0 at hmem
    rw [ZMod.intCast_zmod_eq_zero_iff_dvd] at hmem
    have hdvd : p ∣ (reduction e).natAbs := Int.natCast_dvd.mp hmem
    have := Nat.le_of_dvd (Int.natAbs_pos.mpr hne) hdvd
    omega
  · show ((reduction (p.factorial : TruncRing) : ℤ) : ZMod p) = 0
    rw [map_natCast, Int.cast_natCast, ZMod.natCast_eq_zero_iff]
    exact Nat.dvd_factorial hp.pos le_rfl

/-- The `m`-th power of the image of `X_m` does not vanish: the monomial `X_m ^ m` is divisible by
none of the generators `X_k ^ (k + 1)`. -/
theorem mk_X_pow_self_ne_zero (m : ℕ) : (Ideal.Quotient.mk truncationIdeal (X m)) ^ m ≠ 0 := by
  rw [← map_pow, Ne, Ideal.Quotient.eq_zero_iff_mem, mem_truncationIdeal_iff, X_pow_eq_monomial]
  intro h
  obtain ⟨k, hk⟩ := h (Finsupp.single m m) (by
    rw [support_monomial, if_neg one_ne_zero]; exact Finset.mem_singleton_self _)
  have hkk := hk k
  rw [Finsupp.single_eq_same] at hkk
  by_cases hkm : k = m
  · subst hkm; rw [Finsupp.single_eq_same] at hkk; omega
  · rw [Finsupp.single_eq_of_ne hkm] at hkk; omega

/-- The nilradical of `ℤ[X_0, X_1, …] / (X_k ^ (k + 1))` is not nilpotent: for every `m` it
contains an element whose `m`-th power does not vanish. -/
theorem exists_isNilpotent_pow_ne_zero (m : ℕ) :
    ∃ e : TruncRing, IsNilpotent e ∧ e ^ m ≠ 0 :=
  ⟨Ideal.Quotient.mk truncationIdeal (X m), isNilpotent_mk_X m, mk_X_pow_self_ne_zero m⟩

/-- The affine scheme `Spec (ℤ[X_0, X_1, …] / (X_k ^ (k + 1)))`. -/
abbrev scheme : Scheme.{0} := Spec (CommRingCat.of TruncRing)

/-- The global sections of `scheme` are the ring itself. -/
def globalSectionsEquiv : Γ(scheme, ⊤) ≃+* TruncRing :=
  (Scheme.ΓSpecIso (CommRingCat.of TruncRing)).commRingCatIsoToRingEquiv

/-- Nilpotence of a global section is nilpotence of the element of the ring it is. -/
theorem isNilpotent_globalSectionsEquiv_iff (a : Γ(scheme, ⊤)) :
    IsNilpotent (globalSectionsEquiv a) ↔ IsNilpotent a :=
  IsNilpotent.map_iff globalSectionsEquiv.injective

/-- A non-nilpotent global section of `scheme` is a non-zero-divisor. -/
theorem mem_nonZeroDivisors_of_not_isNilpotent_global {a : Γ(scheme, ⊤)} (ha : ¬ IsNilpotent a) :
    a ∈ nonZeroDivisors Γ(scheme, ⊤) := by
  have he := mem_nonZeroDivisors_of_not_isNilpotent
    (mt (isNilpotent_globalSectionsEquiv_iff a).mp ha)
  refine mem_nonZeroDivisors_iff_right.mpr fun x hx => ?_
  have hx' : globalSectionsEquiv x * globalSectionsEquiv a = 0 := by
    rw [← map_mul, hx, map_zero]
  exact globalSectionsEquiv.injective
    (by rw [mem_nonZeroDivisors_iff_right.mp he _ hx', map_zero])

/-- The basic open of a global section of `scheme` is the basic open of the element it is. -/
theorem basicOpen_scheme (a : Γ(scheme, ⊤)) :
    scheme.basicOpen a = PrimeSpectrum.basicOpen (globalSectionsEquiv a) :=
  basicOpen_eq_of_affine' a

/-- Every non-empty basic open of `scheme` contains a point outside the basic open of some
factorial. -/
theorem exists_mem_basicOpen_not_mem_basicOpen_factorial {g : Γ(scheme, ⊤)}
    (hg : ¬ IsNilpotent g) :
    ∃ n : ℕ, ∃ z ∈ scheme.basicOpen g, z ∉ scheme.basicOpen (n.factorial : Γ(scheme, ⊤)) := by
  obtain ⟨n, z, hgz, hnz⟩ := exists_prime_not_mem_factorial_mem
    (mt (isNilpotent_globalSectionsEquiv_iff g).mp hg)
  refine ⟨n, z, ?_, ?_⟩
  · rw [basicOpen_scheme]; exact hgz
  · rw [basicOpen_scheme, map_natCast]
    exact fun h => (PrimeSpectrum.mem_basicOpen _ z).mp h hnz

/-- The factorials are not nilpotent as global sections of `scheme`. -/
theorem not_isNilpotent_factorial_global (n : ℕ) :
    ¬ IsNilpotent (n.factorial : Γ(scheme, ⊤)) := by
  rw [← isNilpotent_globalSectionsEquiv_iff, map_natCast]
  exact not_isNilpotent_factorial n

/-- The nilradical of the global sections of `scheme` is not nilpotent. -/
theorem exists_isNilpotent_pow_ne_zero_global (m : ℕ) :
    ∃ a : Γ(scheme, ⊤), IsNilpotent a ∧ a ^ m ≠ 0 := by
  obtain ⟨e, he, hem⟩ := exists_isNilpotent_pow_ne_zero m
  refine ⟨globalSectionsEquiv.symm e, ?_, ?_⟩
  · rw [← isNilpotent_globalSectionsEquiv_iff, RingEquiv.apply_symm_apply]; exact he
  · rw [← map_pow]; exact fun h => hem (globalSectionsEquiv.symm.injective (by rw [h, map_zero]))

/-- The global section `X₁` of `scheme`: its square is zero. -/
def squareZeroSection : Γ(scheme, ⊤) :=
  globalSectionsEquiv.symm (Ideal.Quotient.mk truncationIdeal (X 1))

/-- The section `X₁` has square zero. -/
theorem squareZeroSection_sq : squareZeroSection ^ 2 = 0 := by
  have h : Ideal.Quotient.mk truncationIdeal (X 1 ^ 2) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨1, by norm_num⟩)
  rw [squareZeroSection, ← map_pow, ← map_pow, h, map_zero]

/-- The section `X₁` is not zero. -/
theorem squareZeroSection_ne_zero : squareZeroSection ≠ 0 := by
  intro h
  apply mk_X_pow_self_ne_zero 1
  rw [pow_one]
  have := congrArg globalSectionsEquiv h
  rwa [squareZeroSection, RingEquiv.apply_symm_apply, map_zero] at this

end

end TruncatedPolynomialCounterexample


/-! ### The refutations -/

namespace LocallyTopologicallyRingedSpace

open TruncatedPolynomialCounterexample

/-- **The sections with nilpotent germs vanishing outside `D(n!)`.** On the pseudo-discretisation
of `Spec (ℤ[X₀, X₁, …] / (X_k ^ (k + 1)))`, a quasi-compact formal scheme à la EGA, these ideal
sheaves form a nonempty, decreasing fundamental system of weak ideals of definition over the
affine formal opens, none of whose members is an ideal of definition over them. -/
theorem exists_isFundamentalSystemOfWeakIdealsOfDefinitionOn_forall_not_isIdealOfDefinitionOn :
    ∃ (X : LTRS.{0}) (_ : IsFormalScheme X) (_ : CompactSpace X) (𝒮 : Set (IdealSheaf X)),
      𝒮.Nonempty ∧
      (∀ I ∈ 𝒮, ∀ J ∈ 𝒮, ∃ K ∈ 𝒮, ∀ W : Opens X,
        K.ideal W ≤ I.ideal W ∧ K.ideal W ≤ J.ideal W) ∧
      IsFundamentalSystemOfWeakIdealsOfDefinitionOn 𝒮 (IsAffineFormalOpen X) ∧
      ∀ I ∈ 𝒮, ¬ I.IsIdealOfDefinitionOn (IsAffineFormalOpen X) := by
  refine ⟨schemeToLTRSObj scheme, isFormalScheme_schemeToLTRSObj scheme,
    inferInstanceAs (CompactSpace scheme),
    Set.range fun n : ℕ => IdealSheaf.germsVanishingOff scheme (fun z => nilradical _)
      (n.factorial : Γ(scheme, ⊤)), ⟨_, ⟨0, rfl⟩⟩, ?_, ?_, ?_⟩
  · rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    refine ⟨_, ⟨max a b, rfl⟩, fun W => ⟨?_, ?_⟩⟩
    · exact germsVanishingOffIdeal_antitone scheme _
        (Nat.cast_dvd_cast (Nat.factorial_dvd_factorial (le_max_left a b))) W
    · exact germsVanishingOffIdeal_antitone scheme _
        (Nat.cast_dvd_cast (Nat.factorial_dvd_factorial (le_max_right a b))) W
  · exact isFundamentalSystemOfWeakIdealsOfDefinitionOn_germsVanishingOff_nilradical scheme
      (fun _ => mem_nonZeroDivisors_of_not_isNilpotent_global) _
      fun _ hg => exists_mem_basicOpen_not_mem_basicOpen_factorial hg
  · rintro _ ⟨n, rfl⟩
    exact not_isIdealOfDefinitionOn_germsVanishingOff_nilradical scheme
      (fun _ => mem_nonZeroDivisors_of_not_isNilpotent_global)
      exists_isNilpotent_pow_ne_zero_global _ (not_isNilpotent_factorial_global n)

/-- Over `⊤`, the ideal sheaf of sections of `scheme` with germs in `P z` vanishing outside `D(n!)`
is zero as soon as some point lies outside `D(n!)`. -/
private theorem germsVanishingOff_factorial_ideal_top_eq_bot
    (P : ∀ z : scheme, Ideal (scheme.presheaf.stalk z)) {n : ℕ} {z : scheme}
    (hz : z ∉ scheme.basicOpen (n.factorial : Γ(scheme, ⊤))) :
    (IdealSheaf.germsVanishingOff scheme P (n.factorial : Γ(scheme, ⊤))).ideal ⊤ = ⊥ :=
  germsVanishingOffIdeal_eq_bot scheme (fun _ => mem_nonZeroDivisors_of_not_isNilpotent_global) P
    _ trivial hz

/-- **Stacks 0AIW, the eventual ideals of definition, is false as printed.** It is not true that on
every quasi-compact formal scheme à la EGA a fundamental system `{ℐ_λ}` of weak ideals of
definition consists of ideals of definition for `λ` sufficiently large, even for a nonempty
system directed by inclusion: in the system of
`exists_isFundamentalSystemOfWeakIdealsOfDefinitionOn_forall_not_isIdealOfDefinitionOn` no member
at all is an ideal of definition over the affine formal opens.

The source's argument shows that `ℐ_λ(𝔘)` is an ideal of definition for `λ` large on the finitely
many members `𝔘` of an affine open covering, which is true
(`exists_isIdealOfDefinition_of_isFormalScheme`), and concludes by the locality claim refuted in
`not_forall_isIdealOfDefinitionOn_of_cover`. -/
@[stacks 0AIW "`ℐ_λ` is an ideal of definition for `λ` large: FALSE as printed, for ideal sheaves \
in the source's generality, on a quasi-compact (even affine) formal scheme à la EGA and for a \
nonempty directed system; the true statement is over the members of a finite affine open \
covering, `exists_isIdealOfDefinition_of_isFormalScheme`"]
theorem not_forall_exists_isIdealOfDefinitionOn_of_isFundamentalSystemOfWeakIdealsOfDefinitionOn :
    ¬ ∀ (X : LTRS.{0}), IsFormalScheme X → CompactSpace X → ∀ 𝒮 : Set (IdealSheaf X),
      𝒮.Nonempty →
      (∀ I ∈ 𝒮, ∀ J ∈ 𝒮, ∃ K ∈ 𝒮, ∀ W : Opens X,
        K.ideal W ≤ I.ideal W ∧ K.ideal W ≤ J.ideal W) →
      IsFundamentalSystemOfWeakIdealsOfDefinitionOn 𝒮 (IsAffineFormalOpen X) →
      ∃ I₀ ∈ 𝒮, ∀ I ∈ 𝒮, (∀ W : Opens X, I.ideal W ≤ I₀.ideal W) →
        I.IsIdealOfDefinitionOn (IsAffineFormalOpen X) := by
  intro h
  obtain ⟨X, hX, hcpt, 𝒮, hne, hdir, hfund, hnot⟩ :=
    exists_isFundamentalSystemOfWeakIdealsOfDefinitionOn_forall_not_isIdealOfDefinitionOn
  obtain ⟨I₀, hI₀, hdef⟩ := h X hX hcpt 𝒮 hne hdir hfund
  exact hnot I₀ hI₀ (hdef I₀ hI₀ fun _ => le_rfl)

/-- A point of `scheme` outside the basic open of some `n!`. -/
theorem exists_not_mem_basicOpen_factorial :
    ∃ n : ℕ, ∃ z : scheme, z ∉ scheme.basicOpen (n.factorial : Γ(scheme, ⊤)) := by
  obtain ⟨n, z, -, hz⟩ := exists_mem_basicOpen_not_mem_basicOpen_factorial
    (g := (1 : Γ(scheme, ⊤))) (by simpa using not_isNilpotent_factorial_global 0)
  exact ⟨n, z, hz⟩

/-- **Stacks 0AIW, the locality of the ideal-of-definition condition, is false as printed.** It is
not true that an ideal sheaf on a formal scheme à la EGA is an ideal of definition as soon as its
ideals of sections over the members of an affine open covering are ideals of definition: on the
pseudo-discretisation of `Spec (ℤ[X₀, X₁, …] / (X_k ^ (k + 1)))` the sections with nilpotent germs
vanishing outside `D(n!)` are zero over the whole space, which is affine, and are not an ideal of
definition over `D(n!)`.

The corrected statement checks the condition on the affine formal opens contained in the members
of the covering: `IdealSheaf.isIdealOfDefinitionOn_of_cover`. -/
@[stacks 0AIW "it suffices to check the ideal-of-definition condition on an affine open covering: \
FALSE as printed, for ideal sheaves in the source's generality, already for the covering of an \
affine formal scheme by itself"]
theorem not_forall_isIdealOfDefinitionOn_of_cover :
    ¬ ∀ (X : LTRS.{0}), IsFormalScheme X → ∀ (I : IdealSheaf X) (𝒰 : Set (Opens X)),
      (∀ V ∈ 𝒰, IsAffineFormalOpen X V) → sSup 𝒰 = ⊤ →
      (∀ V ∈ 𝒰, TopologicalRing.IsIdealOfDefinition (I.ideal V)) →
      I.IsIdealOfDefinitionOn (IsAffineFormalOpen X) := by
  intro h
  obtain ⟨n, z, hz⟩ := exists_not_mem_basicOpen_factorial
  have : DiscreteTopology ((schemeToLTRSObj scheme).presheaf.obj (op ⊤)).α :=
    discreteTopology_schemeToLTRSObj scheme (W := ⊤) isCompact_univ
  refine not_isIdealOfDefinitionOn_germsVanishingOff_nilradical scheme
    (fun _ => mem_nonZeroDivisors_of_not_isNilpotent_global)
    exists_isNilpotent_pow_ne_zero_global _ (not_isNilpotent_factorial_global n)
    (h (schemeToLTRSObj scheme) (isFormalScheme_schemeToLTRSObj scheme) _ {⊤}
      (by rintro V rfl; exact isAffineFormalOpen_schemeToLTRSObj scheme (isAffineOpen_top _))
      sSup_singleton ?_)
  rintro V rfl
  rw [germsVanishingOff_factorial_ideal_top_eq_bot _ hz]
  exact isIdealOfDefinition_bot_discrete _

/-- **Stacks 0AIW, the locality of the fundamental-system condition, is false as printed.** It is
not true that a family of ideals of definition on a formal scheme à la EGA is a fundamental system
as soon as its ideals of sections form a neighbourhood basis of zero over the members of an affine
open covering, even for a nonempty directed family whose members are ideals of definition over
every affine formal open: on the pseudo-discretisation of `Spec (ℤ[X₀, X₁, …] / (X_k ^ (k + 1)))`
the sections whose germs are multiples of the germ of `X₁`, vanishing outside `D(n!)`, form an
ideal of definition which is zero over the whole space, which is affine, but whose sections over
`D(n!)`, which are discrete, contain `X₁ ≠ 0`.

The corrected statement checks the condition on the affine formal opens contained in the members
of the covering: `isFundamentalSystemOfIdealsOfDefinitionOn_of_cover_of_directed`. -/
@[stacks 0AIW "it suffices to check the fundamental-system condition on an affine open covering: \
FALSE as printed, for ideal sheaves in the source's generality, already for a single ideal of \
definition and the covering of an affine formal scheme by itself"]
theorem not_forall_isFundamentalSystemOfIdealsOfDefinitionOn_of_hasBasis_cover :
    ¬ ∀ (X : LTRS.{0}), IsFormalScheme X → ∀ (𝒮 : Set (IdealSheaf X)) (𝒰 : Set (Opens X)),
      𝒮.Nonempty →
      (∀ I ∈ 𝒮, ∀ J ∈ 𝒮, ∃ K ∈ 𝒮, ∀ W : Opens X,
        K.ideal W ≤ I.ideal W ∧ K.ideal W ≤ J.ideal W) →
      (∀ V ∈ 𝒰, IsAffineFormalOpen X V) → sSup 𝒰 = ⊤ →
      (∀ I ∈ 𝒮, I.IsIdealOfDefinitionOn (IsAffineFormalOpen X)) →
      (∀ V ∈ 𝒰, (nhds (0 : (X.presheaf.obj (op V)).α)).HasBasis (· ∈ 𝒮)
        fun I : IdealSheaf X => (I.ideal V : Set (X.presheaf.obj (op V)).α)) →
      IsFundamentalSystemOfIdealsOfDefinitionOn 𝒮 (IsAffineFormalOpen X) := by
  intro h
  obtain ⟨n, z, hz⟩ := exists_not_mem_basicOpen_factorial
  have hreg := fun (a : Γ(scheme, ⊤)) (ha : ¬ IsNilpotent a) =>
    mem_nonZeroDivisors_of_not_isNilpotent_global ha
  let P : ∀ z : scheme, Ideal (scheme.presheaf.stalk z) :=
    fun z => Ideal.span {scheme.presheaf.Γgerm z squareZeroSection}
  let 𝒥 := IdealSheaf.germsVanishingOff scheme P (n.factorial : Γ(scheme, ⊤))
  have hfund := h (schemeToLTRSObj scheme) (isFormalScheme_schemeToLTRSObj scheme) {𝒥} {⊤}
    ⟨𝒥, rfl⟩ (by rintro _ rfl _ rfl; exact ⟨𝒥, rfl, fun _ => ⟨le_rfl, le_rfl⟩⟩)
    (by rintro V rfl; exact isAffineFormalOpen_schemeToLTRSObj scheme (isAffineOpen_top _))
    sSup_singleton
    (by
      rintro _ rfl W hW
      exact isIdealOfDefinition_germsVanishingOff_span scheme squareZeroSection_sq _
        (isCompact_of_isAffineFormalOpen hW))
    (by
      rintro V rfl
      have : DiscreteTopology ((schemeToLTRSObj scheme).presheaf.obj (op ⊤)).α :=
        discreteTopology_schemeToLTRSObj scheme (W := ⊤) isCompact_univ
      exact hasBasis_nhds_zero_of_exists_ideal_eq_bot
        ⟨𝒥, rfl, germsVanishingOff_factorial_ideal_top_eq_bot P hz⟩)
  exact not_hasBasis_germsVanishingOff_span scheme squareZeroSection_ne_zero
    (hreg _ (not_isNilpotent_factorial_global n))
    (hfund.2 _ (isAffineFormalOpen_schemeToLTRSObj scheme ((isAffineOpen_top _).basicOpen _)))

