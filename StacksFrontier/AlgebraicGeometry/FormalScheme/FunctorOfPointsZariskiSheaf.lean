module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.FormalScheme.SchemeToFormalSchemeRestrict

/-!
# The functor of points of a formal scheme is a Zariski sheaf

Let `𝔛` be a formal scheme. Its functor of points `h_𝔛(T) = Mor(T, 𝔛)` on the category of all
schemes is a sheaf for the big Zariski topology. This is the Zariski half of Stacks 0AI2 in full:
the separatedness clause and the gluing clause, for every Zariski covering sieve.

`AlgebraicGeometry.isSheafFor_opensCover_formalSchemePoints` proves the sheaf condition for a
covering of a scheme by *open subschemes*. A general Zariski covering is a jointly surjective
family of arbitrary open immersions `π i : U i ⟶ T`, so the two differ by the isomorphisms
`U i ≅ (π i).opensRange` of `AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq`. Rather than
transporting a matching family across those isomorphisms, the argument here observes that the two
presieves *generate the same sieve* — each arrow of either factors through an arrow of the other —
and appeals to `CategoryTheory.Presieve.isSheafFor_iff_generate`.

## Main results

* `AlgebraicGeometry.isSheafFor_ofArrows_formalSchemePoints`: the sheaf condition for a jointly
  surjective family of arbitrary open immersions.
* `AlgebraicGeometry.isSheaf_zariskiTopology_formalSchemePoints`: **Stacks 0AI2**, the Zariski
  case in full. The functor of points of a formal scheme is a sheaf for
  `AlgebraicGeometry.Scheme.zariskiTopology`.

## References

* [Stacks Project, Tag 0AI2](https://stacks.math.columbia.edu/tag/0AI2)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace AlgebraicGeometry

/-- A jointly surjective family of open subsets of a scheme covers it. -/
theorem iSup_eq_top_of_forall_exists_mem {T : Scheme.{u}} {ι : Type*} (V : ι → T.Opens)
    (hV : ∀ x : T, ∃ i, x ∈ V i) : iSup V = ⊤ := by
  refine Opens.ext (Set.eq_univ_iff_forall.mpr fun x => ?_)
  obtain ⟨i, hi⟩ := hV x
  rw [Opens.coe_iSup]
  exact Set.mem_iUnion.mpr ⟨i, hi⟩

/-- A jointly surjective family of open immersions and the family of open subschemes cut out by
their ranges generate the same sieve: each arrow of either factors through an arrow of the
other, through the isomorphism of `AlgebraicGeometry.IsOpenImmersion.isoOfRangeEq`. -/
theorem generate_ofArrows_eq_generate_ofArrows_opensRange {T : Scheme.{u}} {ι : Type*}
    (U : ι → Scheme.{u}) (π : ∀ i, U i ⟶ T) [∀ i, IsOpenImmersion (π i)] :
    (Sieve.generate (Presieve.ofArrows U π) : Sieve T)
      = Sieve.generate (Presieve.ofArrows (fun i => ((π i).opensRange).toScheme)
          (fun i => ((π i).opensRange).ι)) := by
  have hrange : ∀ i, Set.range ⇑(π i) = Set.range ⇑((π i).opensRange).ι :=
    fun i => (((π i).opensRange).range_ι).symm
  refine le_antisymm ?_ ?_
  · rw [Sieve.generate_le_iff]
    rintro Z f ⟨i⟩
    exact ⟨_, (IsOpenImmersion.isoOfRangeEq (π i) _ (hrange i)).hom, _,
      Presieve.ofArrows.mk i, IsOpenImmersion.isoOfRangeEq_hom_fac (π i) _ (hrange i)⟩
  · rw [Sieve.generate_le_iff]
    rintro Z f ⟨i⟩
    refine ⟨_, (IsOpenImmersion.isoOfRangeEq (π i) _ (hrange i)).inv, π i,
      Presieve.ofArrows.mk i, ?_⟩
    exact (congrArg (fun m => (IsOpenImmersion.isoOfRangeEq (π i) _ (hrange i)).inv ≫ m)
        (IsOpenImmersion.isoOfRangeEq_hom_fac (π i) _ (hrange i)).symm).trans
      (Iso.inv_hom_id_assoc _ _)

/-- The functor of points of a formal scheme satisfies the sheaf condition for a jointly
surjective family of arbitrary open immersions into a scheme. -/
theorem isSheafFor_ofArrows_formalSchemePoints {T : Scheme.{u}} (X : FormalScheme.{u})
    {ι : Type*} (U : ι → Scheme.{u}) (π : ∀ i, U i ⟶ T) [∀ i, IsOpenImmersion (π i)]
    (hsurj : ∀ x : T, ∃ i, x ∈ Set.range ⇑(π i)) :
    Presieve.IsSheafFor (formalSchemePoints X) (Presieve.ofArrows U π) := by
  have hV : (iSup fun i => ((π i).opensRange)) = ⊤ :=
    iSup_eq_top_of_forall_exists_mem _ fun x => hsurj x
  rw [Presieve.isSheafFor_iff_generate,
    generate_ofArrows_eq_generate_ofArrows_opensRange U π,
    ← Presieve.isSheafFor_iff_generate]
  exact isSheafFor_opensCover_formalSchemePoints X _ hV

/-- **Stacks 0AI2**, the Zariski case in full. The functor of points of a formal scheme, on the
category of all schemes, is a sheaf for the big Zariski topology: a matching family of points on
the members of any Zariski covering of a scheme has a unique amalgamation.

Zariski coverings are the jointly surjective families of open immersions, so this follows from
`AlgebraicGeometry.isSheafFor_ofArrows_formalSchemePoints` once the sheaf condition for a
Grothendieck topology generated by a precoverage is reduced to its covering families, which is
`CategoryTheory.Precoverage.isSheaf_toGrothendieck_iff_of_isStableUnderBaseChange`. -/
@[stacks 0AI2 "Zariski case in full, separatedness and gluing: the functor of points is a sheaf \
for the big Zariski topology on all schemes"]
theorem isSheaf_zariskiTopology_formalSchemePoints (X : FormalScheme.{u}) :
    Presieve.IsSheaf Scheme.zariskiTopology.{u} (formalSchemePoints X) := by
  rw [show Scheme.zariskiTopology.{u}
      = (Scheme.precoverage @IsOpenImmersion).toGrothendieck from rfl,
    Precoverage.isSheaf_toGrothendieck_iff_of_isStableUnderBaseChange]
  intro Y R hR
  obtain ⟨ι, U, π, rfl⟩ := R.exists_eq_ofArrows
  have hdata := (Scheme.presieve₀_mem_precoverage_iff (P := @IsOpenImmersion)
    (⟨ι, U, π⟩ : PreZeroHypercover Y)).mp hR
  have : ∀ i, IsOpenImmersion (π i) := fun i => hdata.2 i
  exact isSheafFor_ofArrows_formalSchemePoints X U π fun x => hdata.1 x

end AlgebraicGeometry

end
