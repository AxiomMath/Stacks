module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.FormalScheme.IdealOfDefinition
public import StacksFrontier.AlgebraicGeometry.FormalScheme.WeakIdealOfDefinitionPoints

/-!
# Eventual ideals of definition for systems cut out by their sections

**Stacks 0AIW** asserts that on a quasi-compact formal scheme à la EGA a fundamental system
`{ℐ_λ}` of weak ideals of definition consists of ideals of definition for `λ` sufficiently large,
"since we only need to check on the finitely many members of an affine open covering". For
arbitrary ideal sheaves this is false
(`not_forall_exists_isIdealOfDefinitionOn_of_isFundamentalSystemOfWeakIdealsOfDefinitionOn`), and
what the source's argument proves is the statement over the members of a finite affine open
covering (`exists_isIdealOfDefinition_of_isFormalScheme`).

The ideal sheaves the source has in mind are those *cut out by their sections over the affine
formal opens* (`AlgebraicGeometry.LocallyTopologicallyRingedSpace.IdealSheaf.IsCutOutOn`, the
condition of Stacks 0AIV singling out the weak ideals of definition that come from thickenings):
over an affine formal open `𝔘`, a section over `V ⊆ 𝔘` lies in `ℐ(V)` exactly when every point
`T → 𝔘` of a scheme killing `ℐ(𝔘)` kills it. For a directed system of such ideal sheaves the
eventual statement holds over *every* affine formal open, with no finite-covering restriction.
This file proves it.

## The argument

Let `𝔘₁, …, 𝔘_r` be the finite affine covering and `ℐ_{λ₀}` a member below which every member is an
ideal of definition over the `𝔘ᵢ`. Let `ℐ ≤ ℐ_{λ₀}`, let `𝔙` be any affine formal open, and let `𝒦`
be a member of the system below `ℐ`; the ideals `𝒦(𝔙)` are a neighbourhood basis of zero, so it
suffices to find `n` with `ℐ(𝔙)ⁿ ⊆ 𝒦(𝔙)`. Choose `n` with `ℐ(𝔘ᵢ)ⁿ ⊆ 𝒦(𝔘ᵢ)` for all `i`. Since `𝒦`
is cut out over `𝔙`, it suffices that every point `f : T → 𝔙` killing `𝒦(𝔙)` kills `ℐ(𝔙)ⁿ`; such a
point kills `𝒦` everywhere, again because `𝒦` is cut out over `𝔙`. Over `Tᵢ = f⁻¹(𝔘ᵢ)` the image
`𝔞ᵢ` of `ℐ(𝔘ᵢ)` in `Γ(Tᵢ, 𝒪)` satisfies `𝔞ᵢⁿ = 0`, because `ℐ(𝔘ᵢ)ⁿ ⊆ 𝒦(𝔘ᵢ)`. On the closed
subscheme `Zᵢ = V(𝔞ᵢ) ⊆ Tᵢ` the point kills `ℐ(𝔘ᵢ)`, hence — `ℐ` being cut out over `𝔘ᵢ` — it kills
`ℐ(𝔙 ∩ 𝔘ᵢ)`; so `f` sends `ℐ(𝔙 ∩ 𝔘ᵢ)` into the kernel of `𝒪_{Tᵢ} → 𝒪_{Zᵢ}`, whose `n`-th power is
zero because `𝔞ᵢⁿ = 0`. Hence `f` kills `ℐ(𝔙)ⁿ` over each `Tᵢ`, hence over `T`.

## Main results

* `AlgebraicGeometry.LocallyTopologicallyRingedSpace.IdealSheaf.pow_ideal_le_of_isCutOutOn`: the
  comparison of powers over an arbitrary member of the class.
* `AlgebraicGeometry.LocallyTopologicallyRingedSpace`
  `.exists_forall_isIdealOfDefinitionOn_of_isCutOutOn`:
  **Stacks 0AIW**, the members of the system are ideals of definition over every affine formal
  open for `λ` large.
* `AlgebraicGeometry.LocallyTopologicallyRingedSpace`
  `.exists_isFundamentalSystemOfIdealsOfDefinitionOn_of_isCutOutOn`: those members form a
  fundamental system of ideals of definition.

## References

* [Stacks Project, Tag 0AIW](https://stacks.math.columbia.edu/tag/0AIW)
* [Stacks Project, Tag 0AIV](https://stacks.math.columbia.edu/tag/0AIV)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

namespace AlgebraicGeometry

universe u

/-- A section of a scheme over an open vanishes as soon as its restrictions to the affine opens
inside the open do. -/
theorem Scheme.eq_zero_of_forall_affine_res_eq_zero (T : Scheme.{u}) {W : T.Opens} (x : Γ(T, W))
    (h : ∀ W' : T.affineOpens, (hW' : W'.1 ≤ W) → T.presheaf.map (homOfLE hW').op x = 0) :
    x = 0 := by
  refine TopCat.Presheaf.section_ext T.sheaf W x 0 fun y hy => ?_
  obtain ⟨W', hW'aff, hyW', hW'W⟩ :=
    (Opens.isBasis_iff_nbhd.mp T.isBasis_affineOpens) hy
  show T.presheaf.germ W y hy x = T.presheaf.germ W y hy 0
  rw [map_zero, ← TopCat.Presheaf.germ_res_apply T.presheaf (homOfLE hW'W) y hyW' x,
    h ⟨W', hW'aff⟩ hW'W, map_zero]

/-- A ring map sending `I` into `J` sends `I ^ n` into `J ^ n`. -/
private theorem apply_mem_pow_of_map_le {R S : Type*} [CommRing R] [CommRing S] {f : R →+* S}
    {I : Ideal R} {J : Ideal S} (h : I.map f ≤ J) (n : ℕ) {x : R} (hx : x ∈ I ^ n) :
    f x ∈ J ^ n := by
  have := Ideal.mem_map_of_mem f hx
  rw [Ideal.map_pow] at this
  exact Ideal.pow_right_mono h n this

variable {T : Scheme.{u}} (𝔞 : Ideal Γ(T, ⊤))

/-- The closed subscheme cut out by an ideal `𝔞` of the global sections kills a section whose
restrictions to the affine opens lie in the ideal generated by `𝔞`. -/
theorem subschemeι_app_ofIdealTop_eq_zero {W : T.Opens} (x : Γ(T, W))
    (hx : ∀ W' : T.affineOpens, (hW' : W'.1 ≤ W) →
      T.presheaf.map (homOfLE hW').op x ∈ 𝔞.map (T.presheaf.map (homOfLE le_top).op).hom) :
    (Scheme.IdealSheafData.ofIdealTop 𝔞).subschemeι.app W x = 0 := by
  set j := (Scheme.IdealSheafData.ofIdealTop 𝔞).subschemeι
  refine TopCat.Presheaf.section_ext (Scheme.IdealSheafData.ofIdealTop 𝔞).subscheme.sheaf
    (j ⁻¹ᵁ W) (j.app W x) 0 fun z hz => ?_
  obtain ⟨W', hW'aff, hzW', hW'W⟩ :=
    (Opens.isBasis_iff_nbhd.mp T.isBasis_affineOpens) (show j.base z ∈ W from hz)
  have hmem : j.app W' (T.presheaf.map (homOfLE hW'W).op x) = 0 := by
    have := hx ⟨W', hW'aff⟩ hW'W
    rwa [← Scheme.IdealSheafData.ofIdealTop_ideal, ← Scheme.IdealSheafData.ker_subschemeι_app]
      at this
  have hnat := congrArg (fun φ => φ.hom x) (j.naturality (homOfLE hW'W).op)
  simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply] at hnat
  show (Scheme.IdealSheafData.ofIdealTop 𝔞).subscheme.presheaf.germ _ z hz (j.app W x) =
    (Scheme.IdealSheafData.ofIdealTop 𝔞).subscheme.presheaf.germ _ z hz 0
  have hgerm := TopCat.Presheaf.germ_res_apply
    (Scheme.IdealSheafData.ofIdealTop 𝔞).subscheme.presheaf
    ((Opens.map j.base).map (homOfLE hW'W).op.unop) z (show z ∈ j ⁻¹ᵁ W' from hzW') (j.app W x)
  have hzero : (Scheme.IdealSheafData.ofIdealTop 𝔞).subscheme.presheaf.map
      ((Opens.map j.base).map (homOfLE hW'W).op.unop).op (j.app W x) = 0 :=
    hnat.symm.trans hmem
  rw [map_zero, ← hgerm, hzero, map_zero]

/-- Over any open, the kernel of the closed subscheme cut out by an ideal `𝔞` of the global
sections with `𝔞 ^ n = 0` has vanishing `n`-th power: over an affine open the kernel is generated
by `𝔞`, and a section vanishing on the affine opens vanishes. -/
theorem ker_subschemeι_app_ofIdealTop_pow_eq_bot {n : ℕ} (h𝔞 : 𝔞 ^ n = ⊥) (W : T.Opens) :
    (RingHom.ker ((Scheme.IdealSheafData.ofIdealTop 𝔞).subschemeι.app W).hom) ^ n = ⊥ := by
  set j := (Scheme.IdealSheafData.ofIdealTop 𝔞).subschemeι
  refine eq_bot_iff.mpr fun x hx => Ideal.mem_bot.mpr ?_
  refine Scheme.eq_zero_of_forall_affine_res_eq_zero T x fun W' hW'W => ?_
  have hle : Ideal.map (T.presheaf.map (homOfLE hW'W).op).hom (RingHom.ker (j.app W).hom) ≤
      (Scheme.IdealSheafData.ofIdealTop 𝔞).ideal W' := by
    rw [← Scheme.IdealSheafData.ker_subschemeι_app]
    refine Ideal.map_le_iff_le_comap.mpr fun y hy => ?_
    rw [Ideal.mem_comap, RingHom.mem_ker]
    have hnat := congrArg (fun φ => φ.hom y) (j.naturality (homOfLE hW'W).op)
    simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply] at hnat
    rw [hnat, RingHom.mem_ker.mp hy, map_zero]
  have h2 := apply_mem_pow_of_map_le hle n hx
  rwa [Scheme.IdealSheafData.ofIdealTop_ideal, ← Ideal.map_pow, h𝔞, Ideal.map_bot,
    Ideal.mem_bot] at h2

namespace LocallyTopologicallyRingedSpace.IdealSheaf

variable {X : LTRS.{u}}

/-- A section lies in the kernel of a point `T → X` of a scheme as soon as it lies in the kernels
of its restrictions to the members of an open cover of `T`. -/
theorem mem_ker_of_openCover {T : Scheme.{u}} (f : schemeToLTRSObj T ⟶ X)
    {ι : Type*} (W : ι → T.Opens) (hW : iSup W = ⊤) {V : Opens X}
    {s : (X.presheaf.obj (op V)).α}
    (h : ∀ i, s ∈ (ker (schemeToLTRS.map (W i).ι ≫ f)).ideal V) : s ∈ (ker f).ideal V := by
  rw [mem_ker_iff]
  refine eq_zero_of_locally_zero (schemeToLTRSObj T).IsSheaf fun p hp => ?_
  obtain ⟨i, hi⟩ : ∃ i, p ∈ W i := Opens.mem_iSup.mp (hW ▸ trivial : p ∈ iSup W)
  exact ⟨(W i).ι ''ᵁ ((W i).ι ⁻¹ᵁ (Opens.map f.toHom.base).obj V),
    fun _ ⟨q, hq, hqe⟩ => hqe ▸ hq, ⟨⟨p, hi⟩, hp, rfl⟩, mem_ker_iff.mp (h i)⟩

/-- For a morphism landing in an open `U`, a section over `V` lies in the kernel as soon as its
restriction to `V ⊓ U` does: the preimages of `V` and `V ⊓ U` agree. -/
theorem mem_ker_of_range_subset {Y : LTRS.{u}} (f : Y ⟶ X) {U : Opens X}
    (hf : Set.range f.toHom.base ⊆ (U : Set X)) {V : Opens X} {s : (X.presheaf.obj (op V)).α}
    (h : (X.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op).1 s ∈ (ker f).ideal (V ⊓ U)) :
    s ∈ (ker f).ideal V := by
  rw [mem_ker_iff] at h ⊢
  have heq : (Opens.map f.toHom.base).obj (V ⊓ U) = (Opens.map f.toHom.base).obj V :=
    Opens.ext (Set.ext fun y => ⟨fun hy => hy.1, fun hy => ⟨hy, hf (Set.mem_range_self y)⟩⟩)
  have hnat := congrArg (fun φ => φ.1 s) (f.toHom.c.naturality (homOfLE (inf_le_left :
    V ⊓ U ≤ V)).op)
  have hiso := isIso_presheaf_map_of_opens_eq Y.presheaf heq.symm
    ((Opens.map f.toHom.base).op.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op)
  have hinj : Function.Injective (Y.presheaf.map
      ((Opens.map f.toHom.base).op.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op)).1 :=
    (TopCat.homeoOfIso ((forget₂ TopCommRingCat TopCat).mapIso (asIso _))).injective
  exact hinj ((hnat.symm.trans h).trans (map_zero _).symm)

/-- A point `f : T → X` of a scheme landing in a member `U` of `𝒜` kills `I(V) ^ n` as soon as,
for an ideal `𝔞` of `Γ(T, ⊤)` with `𝔞 ^ n = 0`, its restriction to the closed subscheme cut out by
`𝔞` kills `I(U)`, where `I` is cut out by its sections over `𝒜`. -/
theorem mem_ker_of_subschemeι_kills {𝒜 : Opens X → Prop} {I : IdealSheaf X}
    (hIc : I.IsCutOutOn 𝒜) {T : Scheme.{u}} (f : schemeToLTRSObj T ⟶ X) {U : Opens X} (hU : 𝒜 U)
    (hf : Set.range f.toHom.base ⊆ (U : Set X)) (𝔞 : Ideal Γ(T, ⊤)) {n : ℕ} (h𝔞 : 𝔞 ^ n = ⊥)
    (hI : ∀ t ∈ I.ideal U, ((schemeToLTRS.map (Scheme.IdealSheafData.ofIdealTop 𝔞).subschemeι ≫
      f).toHom.c.app (op U)).1 t = 0)
    {V : Opens X} {s : (X.presheaf.obj (op V)).α} (hs : s ∈ (I.ideal V) ^ n) :
    s ∈ (ker f).ideal V := by
  refine mem_ker_of_range_subset f hf ?_
  let jZ := (Scheme.IdealSheafData.ofIdealTop 𝔞).subschemeι
  let g : schemeToLTRSObj (Scheme.IdealSheafData.ofIdealTop 𝔞).subscheme ⟶ X :=
    schemeToLTRS.map jZ ≫ f
  let O' : T.Opens := (Opens.map f.toHom.base).obj (V ⊓ U)
  let ψ : (X.presheaf.obj (op (V ⊓ U))).α →+* Γ(T, O') := (f.toHom.c.app (op (V ⊓ U))).1
  have hψ : Ideal.map ψ (I.ideal (V ⊓ U)) ≤ RingHom.ker (jZ.app O').hom :=
    Ideal.map_le_iff_le_comap.mpr fun t ht =>
      (hIc U hU (V ⊓ U) inf_le_right t).mp ht _ g
        (by rintro _ ⟨z, rfl⟩; exact hf (Set.mem_range_self _)) hI
  have hres : (X.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op).1 s ∈
      (I.ideal (V ⊓ U)) ^ n := by
    have hmap : Ideal.map (X.presheaf.map (homOfLE (inf_le_left : V ⊓ U ≤ V)).op).1
        (I.ideal V) ≤ I.ideal (V ⊓ U) :=
      Ideal.map_le_iff_le_comap.mpr fun t ht => I.map_mem inf_le_left ht
    exact apply_mem_pow_of_map_le hmap n hs
  rw [mem_ker_iff]
  have := apply_mem_pow_of_map_le hψ n hres
  rwa [ker_subschemeι_app_ofIdealTop_pow_eq_bot 𝔞 h𝔞, Ideal.mem_bot] at this

/-- A point `f : T → X` of a scheme landing in a member `U` of `𝒜` and killing `K` kills `I(V) ^ n`
when `I(U) ^ n ≤ K(U)` and `I` is cut out by its sections over `𝒜`: the image `𝔞` of `I(U)` in
`Γ(T, ⊤)` has `𝔞 ^ n = 0`, and the point restricted to the closed subscheme `V(𝔞)` kills `I(U)`. -/
theorem mem_ker_of_pow_ideal_le_of_kills {𝒜 : Opens X → Prop} {I K : IdealSheaf X}
    (hIc : I.IsCutOutOn 𝒜) {T : Scheme.{u}} (f : schemeToLTRSObj T ⟶ X) {U : Opens X} (hU : 𝒜 U)
    (hf : Set.range f.toHom.base ⊆ (U : Set X)) (hKf : K.Kills f) {n : ℕ}
    (hn : (I.ideal U) ^ n ≤ K.ideal U) {V : Opens X} {s : (X.presheaf.obj (op V)).α}
    (hs : s ∈ (I.ideal V) ^ n) : s ∈ (ker f).ideal V := by
  have htop : (⊤ : T.Opens) ≤ ((Opens.map f.toHom.base).obj U : T.Opens) :=
    fun p _ => hf (Set.mem_range_self p)
  let ρ : (X.presheaf.obj (op U)).α →+* Γ(T, ⊤) :=
    (T.presheaf.map (homOfLE htop).op).hom.comp (f.toHom.c.app (op U)).1
  let 𝔞 : Ideal Γ(T, ⊤) := Ideal.map ρ (I.ideal U)
  have h𝔞 : 𝔞 ^ n = ⊥ := by
    rw [← Ideal.map_pow]
    refine eq_bot_iff.mpr ((Ideal.map_mono hn).trans ?_)
    refine Ideal.map_le_iff_le_comap.mpr fun t ht => ?_
    rw [Ideal.mem_comap, Ideal.mem_bot]
    show T.presheaf.map (homOfLE htop).op ((f.toHom.c.app (op U)).1 t) = 0
    rw [mem_ker_iff.mp (hKf U ht)]
    exact map_zero _
  refine mem_ker_of_subschemeι_kills hIc f hU hf 𝔞 h𝔞 (fun t ht => ?_) hs
  show (Scheme.IdealSheafData.ofIdealTop 𝔞).subschemeι.app
    ((Opens.map f.toHom.base).obj U : T.Opens) ((f.toHom.c.app (op U)).1 t) = 0
  refine subschemeι_app_ofIdealTop_eq_zero 𝔞 _ fun W' hW' => ?_
  have hres : T.presheaf.map (homOfLE hW').op ((f.toHom.c.app (op U)).1 t) =
      T.presheaf.map (homOfLE (le_top : W'.1 ≤ ⊤)).op (ρ t) := by
    have h₁ := congrArg (fun φ => φ.hom ((f.toHom.c.app (op U)).1 t))
      (T.presheaf.map_comp (homOfLE htop).op (homOfLE (le_top : W'.1 ≤ ⊤)).op)
    simp only [CommRingCat.hom_comp, RingHom.coe_comp] at h₁
    exact h₁
  rw [hres]
  exact Ideal.mem_map_of_mem _ (Ideal.mem_map_of_mem ρ ht)

/-- **Powers of an ideal sheaf cut out by its sections.** Let `I` and `K` be ideal sheaves cut out
by their sections over the members of a class `𝒜` of opens, and let `U` be a covering of `X` by
members of `𝒜` with `I(U i) ^ n ≤ K(U i)` for all `i`. Then `I(V) ^ n ≤ K(V)` for every member `V`
of `𝒜`. A point of a scheme into `V` killing `K(V)` kills `I(V) ^ n` over the preimage of each
`U i`: on the closed subscheme cut out by the image of `I(U i)`, whose `n`-th power vanishes, the
point kills `I(U i)`, hence `I(V ⊓ U i)`. -/
theorem pow_ideal_le_of_isCutOutOn {𝒜 : Opens X → Prop} {I K : IdealSheaf X}
    (hIc : I.IsCutOutOn 𝒜) (hKc : K.IsCutOutOn 𝒜) {V : Opens X} (hV : 𝒜 V)
    {ι : Type*} (U : ι → Opens X) (hU : ∀ i, 𝒜 (U i)) (hcov : iSup U = ⊤) {n : ℕ}
    (hn : ∀ i, (I.ideal (U i)) ^ n ≤ K.ideal (U i)) :
    (I.ideal V) ^ n ≤ K.ideal V := by
  intro s hs
  refine (hKc V hV V le_rfl s).mpr fun T f hf hK => ?_
  have hKf : K.Kills f := kills_of_range_subset K f hf fun V' hV' t ht =>
    mem_ker_iff.mpr ((hKc V hV V' hV' t).mp ht T f hf hK)
  rw [← mem_ker_iff]
  let W : ι → T.Opens := fun i => (Opens.map f.toHom.base).obj (U i)
  have hW : iSup W = ⊤ := by
    refine eq_top_iff.mpr fun p _ => ?_
    obtain ⟨i, hi⟩ := Opens.mem_iSup.mp (hcov ▸ trivial : f.toHom.base p ∈ iSup U)
    exact Opens.mem_iSup.mpr ⟨i, hi⟩
  refine mem_ker_of_openCover f W hW fun i =>
    mem_ker_of_pow_ideal_le_of_kills hIc _ (hU i) ?_ (hKf.comp _) (hn i) hs
  rintro _ ⟨⟨p, hp⟩, rfl⟩
  exact hp

end LocallyTopologicallyRingedSpace.IdealSheaf

namespace LocallyTopologicallyRingedSpace

/-- **Stacks 0AIW, the eventual ideals of definition, for a system cut out by its sections.** On a
quasi-compact formal scheme à la EGA, let `𝒮` be a nonempty, directed fundamental system of weak
ideals of definition over the affine formal opens, each member cut out by its sections over the
affine formal opens. Then there is a member `I₀` such that every member below it is an ideal of
definition over every affine formal open.

The finite affine covering produced by quasi-compactness gives `I₀` with ideals of definition over
the members of the covering (`exists_isIdealOfDefinition_of_isFormalScheme`), and
`IdealSheaf.pow_ideal_le_of_isCutOutOn` carries the comparison of powers from the covering to an
arbitrary affine formal open. -/
@[stacks 0AIW "`ℐ_λ` is an ideal of definition for `λ` large, over EVERY affine formal open, for a \
directed system whose members are cut out by their sections over the affine formal opens (the \
condition of Stacks 0AIV singling out the ideal sheaves of thickenings); for arbitrary ideal \
sheaves the statement is false, \
`not_forall_exists_isIdealOfDefinitionOn_of_isFundamentalSystemOfWeakIdealsOfDefinitionOn`"]
theorem exists_forall_isIdealOfDefinitionOn_of_isCutOutOn {X : LTRS.{u}} [CompactSpace ↥X]
    (hX : IsFormalScheme X) (𝒮 : Set (IdealSheaf X)) (hne : 𝒮.Nonempty)
    (hdir : ∀ I ∈ 𝒮, ∀ J ∈ 𝒮, ∃ K ∈ 𝒮, ∀ W : Opens X,
      K.ideal W ≤ I.ideal W ∧ K.ideal W ≤ J.ideal W)
    (hfund : IsFundamentalSystemOfWeakIdealsOfDefinitionOn 𝒮 (IsAffineFormalOpen X))
    (hcut : ∀ I ∈ 𝒮, I.IsCutOutOn (IsAffineFormalOpen X)) :
    ∃ I₀ ∈ 𝒮, ∀ I ∈ 𝒮, (∀ W : Opens X, I.ideal W ≤ I₀.ideal W) →
      I.IsIdealOfDefinitionOn (IsAffineFormalOpen X) := by
  obtain ⟨𝒰, h𝒰fin, h𝒰aff, h𝒰sup, I₀, hI₀, hdef⟩ :=
    exists_isIdealOfDefinition_of_isFormalScheme hX 𝒮 hne hdir hfund
  refine ⟨I₀, hI₀, fun I hI hIle V hV => ⟨(hfund.1 I hI V hV).1, fun N hN => ?_⟩⟩
  obtain ⟨J, hJ, hJN⟩ := (hfund.2 V hV).mem_iff.mp hN
  obtain ⟨K, hK, hKle⟩ := hdir I hI J hJ
  have hpow : ∀ U : 𝒰, ∃ n : ℕ, (I.ideal U) ^ n ≤ K.ideal U := by
    intro U
    obtain ⟨n, hn⟩ := (hdef I hI hIle U U.2).2 _
      ((hfund.1 K hK U (h𝒰aff U U.2)).1.mem_nhds (K.ideal U).zero_mem)
    exact ⟨n, hn⟩
  choose n hn using hpow
  have : Finite 𝒰 := h𝒰fin.to_subtype
  obtain ⟨m, hm⟩ : ∃ m : ℕ, ∀ U : 𝒰, n U ≤ m := by
    obtain ⟨m, hm⟩ := (Set.finite_range n).bddAbove
    exact ⟨m, fun U => hm (Set.mem_range_self U)⟩
  have hcov : iSup (fun U : 𝒰 => (U : Opens X)) = ⊤ := by
    rwa [← sSup_eq_iSup']
  have hle := IdealSheaf.pow_ideal_le_of_isCutOutOn (hcut I hI) (hcut K hK) hV
    (fun U : 𝒰 => (U : Opens X)) (fun U => h𝒰aff U U.2) hcov
    (n := m) fun U => (Ideal.pow_le_pow_right (hm U)).trans (hn U)
  exact ⟨m, fun x hx => hJN ((hKle V).2 (hle hx))⟩

/-- **Stacks 0AIW, a fundamental system of weak ideals of definition cut out by its sections
yields a fundamental system of ideals of definition.** The members below the `I₀` of
`exists_forall_isIdealOfDefinitionOn_of_isCutOutOn` form a nonempty, directed fundamental system
of ideals of definition over the affine formal opens, each member cut out by its sections, since
it is a member of the original system. -/
theorem exists_isFundamentalSystemOfIdealsOfDefinitionOn_of_isCutOutOn {X : LTRS.{u}}
    [CompactSpace ↥X] (hX : IsFormalScheme X) (𝒮 : Set (IdealSheaf X)) (hne : 𝒮.Nonempty)
    (hdir : ∀ I ∈ 𝒮, ∀ J ∈ 𝒮, ∃ K ∈ 𝒮, ∀ W : Opens X,
      K.ideal W ≤ I.ideal W ∧ K.ideal W ≤ J.ideal W)
    (hfund : IsFundamentalSystemOfWeakIdealsOfDefinitionOn 𝒮 (IsAffineFormalOpen X))
    (hcut : ∀ I ∈ 𝒮, I.IsCutOutOn (IsAffineFormalOpen X)) :
    ∃ 𝒮' ⊆ 𝒮, 𝒮'.Nonempty ∧
      (∀ I ∈ 𝒮', ∀ J ∈ 𝒮', ∃ K ∈ 𝒮', ∀ W : Opens X,
        K.ideal W ≤ I.ideal W ∧ K.ideal W ≤ J.ideal W) ∧
      IsFundamentalSystemOfIdealsOfDefinitionOn 𝒮' (IsAffineFormalOpen X) := by
  obtain ⟨I₀, hI₀, hdef⟩ :=
    exists_forall_isIdealOfDefinitionOn_of_isCutOutOn hX 𝒮 hne hdir hfund hcut
  refine ⟨{I | I ∈ 𝒮 ∧ ∀ W : Opens X, I.ideal W ≤ I₀.ideal W}, fun _ hI => hI.1,
    ⟨I₀, hI₀, fun _ => le_rfl⟩, ?_, fun I hI => hdef I hI.1 hI.2, fun V hV => ?_⟩
  · rintro I ⟨hI, hIle⟩ J ⟨hJ, -⟩
    obtain ⟨K, hK, hKle⟩ := hdir I hI J hJ
    exact ⟨K, ⟨hK, fun W => (hKle W).1.trans (hIle W)⟩, hKle⟩
  · refine ⟨fun t => ⟨fun ht => ?_, ?_⟩⟩
    · obtain ⟨I, hI, hIt⟩ := (hfund.2 V hV).mem_iff.mp ht
      obtain ⟨K, hK, hKle⟩ := hdir I hI I₀ hI₀
      exact ⟨K, ⟨hK, fun W => (hKle W).2⟩,
        fun _ hx => hIt (SetLike.coe_subset_coe.mpr (hKle V).1 hx)⟩
    · rintro ⟨I, hI, hIt⟩
      exact Filter.mem_of_superset ((hfund.2 V hV).mem_of_mem hI.1) hIt

end LocallyTopologicallyRingedSpace

end AlgebraicGeometry

