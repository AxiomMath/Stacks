module

public import StacksFrontier.AlgebraicGeometry.Descent.QuasiAffineFlatBaseChange
public import StacksFrontier.AlgebraicGeometry.Variety.Geometrically.ProperGlobalSections
public import StacksFrontier.AlgebraicGeometry.InvertibleTrivialization.Basic
public import StacksFrontier.AlgebraicGeometry.GroupScheme.OverField.GroupoidInvariantSubmodule

/-!
# Global functions on base changes of a proper geometrically integral scheme, and endomorphisms of
invertible modules

Two facts about global functions used to compare sections of invertible modules on the base
changes `X_T = X ×_k T` of a proper geometrically integral scheme `X` over a field `k`.

* For `T` affine over `k`, every global function on `X_T` comes from `T`: the map
  `Γ(T, 𝒪) ⟶ Γ(X_T, 𝒪)` is an isomorphism. This is flat base change in degree zero
  (`AlgebraicGeometry.isPushout_appTop_of_flat`, every `k`-scheme being flat over `k`) together
  with `Γ(X, 𝒪) = k` ([Stacks, Tag 0BUG]).
* On any scheme, an endomorphism of an invertible module acts on global sections as
  multiplication by a global function. Over an open on which the module is generated by one
  section `a` the endomorphism sends `a` to `c • a` for a unique `c`; the local `c` agree on
  overlaps because `a` is a basis there, and glue.

## Main results

* `AlgebraicGeometry.isIso_appTop_snd_of_geometricallyIntegral`: `Γ(T, 𝒪) ≅ Γ(X_T, 𝒪)`.
* `AlgebraicGeometry.exists_app_top_eq_smul_of_isInvertible`: an endomorphism of an invertible
  module is multiplication by a global function on global sections.

## References

* [Stacks Project, Tag 0BUG](https://stacks.math.columbia.edu/tag/0BUG)
* [Stacks Project, Tag 02KH](https://stacks.math.columbia.edu/tag/02KH)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite

universe u

namespace AlgebraicGeometry

/-- **Global functions on a base change of a proper geometrically integral scheme over a field
come from the base**: for `X` proper and geometrically integral over `k` and `T'` affine over
`k`, the pullback `Γ(T', 𝒪) ⟶ Γ(X ×_k T', 𝒪)` is an isomorphism. -/
theorem isIso_appTop_snd_of_geometricallyIntegral (k : Type u) [Field k] {X T' Y' : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) [GeometricallyIntegral f] [IsProper f] (g : T' ⟶ Spec (.of k))
    [IsAffine T'] {p : Y' ⟶ X} {q : Y' ⟶ T'} (H : IsPullback p q f g) : IsIso q.appTop := by
  have hiso := isIso_globalSections_of_geometricallyIntegral k f
  have : IsIso f.appTop := by
    rw [show f.appTop =
      (Scheme.ΓSpecIso (.of k)).hom ≫ ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop) by simp]
    infer_instance
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  have : QuasiSeparatedSpace X := quasiSeparatedSpace_of_quasiSeparated f
  exact (isPushout_appTop_of_flat H).isIso_inr_of_isIso

/-- An endomorphism of an `𝒪`-module, over an open on which the module is freely generated by
one section, is multiplication by a function on that open. -/
theorem exists_app_eq_smul_of_bijective {Z : Scheme.{u}} {L : Z.Modules} (φ : L ⟶ L)
    {W : Z.Opens} (a : Γ(L, W))
    (ha : ∀ (V : Z.Opens) (hV : V ≤ W),
      Function.Bijective fun c : Γ(Z, V) => c • L.presheaf.map (homOfLE hV).op a) :
    ∃ c : Γ(Z, W), ∀ (V : Z.Opens) (hV : V ≤ W) (t : Γ(L, V)),
      φ.app V t = Z.presheaf.map (homOfLE hV).op c • t := by
  obtain ⟨c, hc⟩ := (ha W le_rfl).2 (φ.app W (L.presheaf.map (homOfLE (le_refl W)).op a))
  refine ⟨c, fun V hV t => ?_⟩
  obtain ⟨d, rfl⟩ := (ha V hV).2 t
  show φ.app V (d • L.presheaf.map (homOfLE hV).op a) =
    Z.presheaf.map (homOfLE hV).op c • d • L.presheaf.map (homOfLE hV).op a
  have e₁ : L.presheaf.map (homOfLE hV).op a = L.presheaf.map (homOfLE hV).op
      (L.presheaf.map (homOfLE (le_refl W)).op a) := by
    simp
  rw [Scheme.Modules.Hom.app_smul, e₁, Stacks.AlgebraicGeometry.CardinalGeneration.app_map, ← hc,
    Scheme.Modules.map_smul, smul_comm]

open TopologicalSpace in
/-- **An endomorphism of an invertible module is multiplication by a global function**, on
global sections. -/
theorem exists_app_top_eq_smul_of_isInvertible {Z : Scheme.{u}} (L : Z.Modules)
    [Stacks.SheafOfModules.IsInvertible Z.presheaf
      (structureSheafRing Z.toRingedSpace).property L] (φ : L ⟶ L) :
    ∃ r : Γ(Z, ⊤), ∀ s : Γ(L, ⊤), φ.app ⊤ s = r • s := by
  classical
  have : ∀ z : Z.toRingedSpace.carrier,
      IsLocalRing (Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk Z.toRingedSpace z) :=
    Z.isLocalRing
  choose W hzW a ha using fun z : Z =>
    Stacks.SheafOfModules.exists_bijective_smul_of_isInvertible (X := Z.toRingedSpace) L z
  choose c hloc using fun z => exists_app_eq_smul_of_bijective φ (a z) (ha z)
  have hcompat : TopCat.Presheaf.IsCompatible Z.sheaf.1 W c := by
    intro z z'
    set V := W z ⊓ W z'
    have h₁ := hloc z V inf_le_left (L.presheaf.map (homOfLE (inf_le_left : V ≤ W z)).op (a z))
    have h₂ := hloc z' V inf_le_right (L.presheaf.map (homOfLE (inf_le_left : V ≤ W z)).op (a z))
    exact (ha z V inf_le_left).1 (h₁.symm.trans h₂)
  obtain ⟨r₀, hr, -⟩ := Z.sheaf.existsUnique_gluing' W ⊤ (fun z => homOfLE le_top)
    (fun z _ => Opens.mem_iSup.mpr ⟨z, hzW z⟩) c hcompat
  set r : Γ(Z, ⊤) := r₀
  refine ⟨r, fun t => ?_⟩
  refine Stacks.AlgebraicGeometry.GroupoidCardinalGeneration.sections_eq_of_locally_eq L _ _
    fun z _ => ⟨W z, le_top, hzW z, ?_⟩
  have hcz : Z.presheaf.map (homOfLE (le_refl (W z))).op (c z) =
      Z.presheaf.map (homOfLE (le_top : W z ≤ ⊤)).op r := by
    rw [← hr z]
    simp [homOfLE_refl]
    rfl
  calc L.presheaf.map (homOfLE (le_top : W z ≤ ⊤)).op (φ.app ⊤ t)
      = φ.app (W z) (L.presheaf.map (homOfLE (le_top : W z ≤ ⊤)).op t) :=
        (Stacks.AlgebraicGeometry.CardinalGeneration.app_map φ _ t).symm
    _ = Z.presheaf.map (homOfLE (le_refl (W z))).op (c z) •
          L.presheaf.map (homOfLE (le_top : W z ≤ ⊤)).op t := hloc z (W z) le_rfl _
    _ = Z.presheaf.map (homOfLE (le_top : W z ≤ ⊤)).op r •
          L.presheaf.map (homOfLE (le_top : W z ≤ ⊤)).op t := by rw [hcz]
    _ = L.presheaf.map (homOfLE (le_top : W z ≤ ⊤)).op (r • t) :=
          (Scheme.Modules.map_smul L _ r t).symm

end AlgebraicGeometry

end
