module

public import StacksFrontier.CategoryTheory.Sites.OverPullbackPushforward
public import StacksFrontier.AlgebraicGeometry.GroupScheme.AbelianSchemeFirstCohomologyGenericPoint
public import StacksFrontier.AlgebraicGeometry.Thickenings
public import StacksFrontier.AlgebraicGeometry.Spaces.TorsorEtaleLocalSections
public import StacksFrontier.AlgebraicGeometry.Sites.BigFppfEtaleLiftThickening
public import StacksFrontier.AlgebraicGeometry.Descent.FlatCoproductRefinement
public import StacksFrontier.CategoryTheory.Sites.Cohomology.Torsors.FiberOverObject
public import StacksFrontier.CategoryTheory.Sites.Cohomology.Torsors.ClassVanishingOfLift
public import StacksFrontier.CategoryTheory.Sites.Cohomology.DerivedSections.RightDerivedSectionsEssentiallySmall
public import StacksFrontier.CategoryTheory.Sites.Cohomology.InternalHom.EssentiallySmallInternalHom
public import StacksFrontier.AlgebraicGeometry.Size.EssentiallySmall

/-!
# Torsors under a smooth group become trivial étale-locally across a thickening

Let `S` be a scheme of a big fppf site, `z : Z ⟶ S` a morphism of the site, `G` a smooth
commutative group scheme over `S` and `U` an object over `S` such that `U_Z := U ×_S Z ⟶ U` is a
thickening. Every class `c ∈ H¹_fppf(U_Z, G)` dies on `T ×_S Z` for the members `T ⟶ U` of a
covering sieve of `U`; the proof produces a sieve generated by étale morphisms.

The class `c` is the obstruction to lifting a section of a quotient
(`Stacks.Cohomology.Torsors.exists_shortExact_cohomologyPresheaf_map_eq_zero_of_lift`); the
lifts form an fppf torsor under `G` over `U_Z`
(`Stacks.Cohomology.Torsors.fiberOverObject`), which, `G` being smooth, has sections over an
étale covering of `U_Z` (`AlgebraicGeometry.exists_etale_section_of_isPullback_prod`, through
algebraic spaces and Stacks 055U). Étale schemes over `U_Z` lift to étale schemes over `U`
across the thickening (`AlgebraicGeometry.BigFppfOver.exists_etale_lift_baseChange_of_isThickening`,
Stacks 04DY/039R), and the lifts form the covering.

## Main results

* `AlgebraicGeometry.yonedaGroupSchemeObjIso`: the functor of points of a group scheme of the
  site is the presheaf underlying its sheaf of points.
* `AlgebraicGeometry.exists_mem_topology_cohomologyPresheaf_map_baseChange_eq_zero`: the
  statement above.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite

universe w u

namespace AlgebraicGeometry

variable (B : BigFppfSite.{u}) {S : Scheme.{u}} (hS : B.Contains S)

/-- The functor of points of a group scheme over `S` in the site is the presheaf underlying its
sheaf of points. -/
def yonedaGroupSchemeObjIso (G : Over S) [GrpObj G] [IsCommMonObj G] (hG : B.Contains G.left) :
    yoneda.obj (groupSchemeObj B S hS G hG) ≅
      (pointsSheaf B S hS G hG).obj ⋙ forget AddCommGrpCat.{u} :=
  NatIso.ofComponents (fun Z => Equiv.toIso
      ((Functor.FullyFaithful.ofFullyFaithful
        (Over.post (X := B.obj hS) B.inclusion)).homEquiv)) (by
    intro Z Z' φ
    ext g
    exact (Over.post (X := B.obj hS) B.inclusion).map_comp φ.unop g)

/-- **Classes of torsors under a smooth group die étale-locally across a thickening.** Let
`U_Z = U ×_S Z ⟶ U` be a thickening and `G` a smooth commutative group scheme over `S`. Every
class in `H¹_fppf(U_Z, G)` restricts to zero on `T ×_S Z` for every member `T ⟶ U` of some
covering sieve of `U`. The proof produces a sieve generated by étale morphisms. -/
theorem exists_mem_topology_cohomologyPresheaf_map_baseChange_eq_zero
    {Z : Scheme.{u}} (hZ : B.Contains Z) (z : B.obj hZ ⟶ B.obj hS)
    [HasSheafify (BigFppfOver.topology B S hS) AddCommGrpCat.{u}]
    [HasExt.{w} (Sheaf (BigFppfOver.topology B S hS) AddCommGrpCat.{u})]
    (G : Over S) [GrpObj G] [IsCommMonObj G] [Smooth G.hom] (hG : B.Contains G.left)
    (U : BigFppfOver B S hS)
    (hU : Stacks.Thickenings.IsThickening (B.inclusion.map (Sheaf.baseChangeFst z U).left))
    (c : Sheaf.H' (pointsSheaf B S hS G hG) 1 ((Over.map z).obj ((Over.pullback z).obj U))) :
    ∃ R ∈ BigFppfOver.topology B S hS U, ∀ ⦃T : BigFppfOver B S hS⦄ (t : T ⟶ U), R t →
      ((pointsSheaf B S hS G hG).cohomologyPresheaf 1).map
        ((Over.map z).map ((Over.pullback z).map t)).op c = 0 := by
  classical
  have : EssentiallySmall.{u} B.Schemes := essentiallySmall_schemeBelow B.cutoff
  have : EssentiallySmall.{u} (BigFppfOver B S hS) := Stacks.essentiallySmall_over.{u} _
  have : EnoughInjectives (Sheaf (BigFppfOver.topology B S hS) AddCommGrpCat.{u}) :=
    Stacks.Cohomology.FreeYonedaUnivLE.enoughInjectives_essentiallySmallSite _
  obtain ⟨I, Q, ι, π, w, hSES, σ, hvan⟩ :=
    Stacks.Cohomology.Torsors.exists_shortExact_cohomologyPresheaf_map_eq_zero_of_lift
      (pointsSheaf B S hS G hG) _ c
  let Sc := ShortComplex.mk ι π w
  let P := Stacks.Cohomology.Torsors.fiberOverObject Sc σ
  let p := Stacks.Cohomology.Torsors.fiberOverObjectToYoneda Sc σ
  have hP : Presheaf.IsSheaf (BigFppfOver.topology B S hS) P :=
    Stacks.Cohomology.Torsors.fiberOverObject_isSheaf Sc σ
      (BigFppfOver.isSheaf_yoneda_obj B S hS _)
  let Gr := groupSchemeObj B S hS G hG
  have hGr : Smooth ((BigFppfOver.toScheme B S hS).map (Over.mkIdTerminal.from Gr)) := by
    have h : (Over.mkIdTerminal.from Gr).left = Gr.hom := by
      simp
    change Smooth (B.inclusion.map (Over.mkIdTerminal.from Gr).left)
    rw [h]
    exact (inferInstance : Smooth G.hom)
  have htriv : ∀ (W : BigFppfOver B S hS) (l : P.obj (op W)),
      ∃ φ : yoneda.obj W ⨯ yoneda.obj Gr ⟶ P,
        IsPullback φ prod.fst p (yoneda.map (p.app (op W) l)) := by
    intro W l
    let e := yonedaGroupSchemeObjIso B hS G hG
    have h₁ : IsPullback (prod.map (𝟙 (yoneda.obj W)) e.hom) prod.fst prod.fst
        (𝟙 (yoneda.obj W)) :=
      IsPullback.of_horiz_isIso ⟨by simp⟩
    have h := h₁.paste_horiz (Stacks.Cohomology.Torsors.isPullback_fiberOverObject Sc σ hSES l)
    rw [Category.id_comp] at h
    exact ⟨_, h⟩
  have hcov := Stacks.Cohomology.Torsors.exists_cover_fiberOverObject Sc σ hSES
  -- for every point of `U`, an étale neighbourhood whose base change carries a section
  have hpt (u : (BigFppfOver.toScheme B S hS).obj U) :
      ∃ (T : BigFppfOver B S hS) (t : T ⟶ U) (l : P.obj (op ((Over.map z).obj
            ((Over.pullback z).obj T)))),
        Etale ((BigFppfOver.toScheme B S hS).map t) ∧
        u ∈ Set.range ((BigFppfOver.toScheme B S hS).map t) ∧
        p.app _ l = (Over.map z).map ((Over.pullback z).map t) := by
    obtain ⟨x, hx⟩ := hU.2 u
    obtain ⟨V, e, he, ⟨v, hv⟩, l, hl⟩ :=
      exists_etale_section_of_isPullback_prod B S hS hP p Gr hGr hcov htriv x
    obtain ⟨T, t, k, ht, hu, hk⟩ :=
      BigFppfOver.exists_etale_lift_baseChange_of_isThickening B S hS hZ z U hU e he v
    refine ⟨T, t, P.map k.op l, ht, ?_, ?_⟩
    · have : (BigFppfOver.toScheme B S hS).map (e ≫ Sheaf.baseChangeFst z U) v = u := by
        rw [Functor.map_comp, Scheme.Hom.comp_apply, hv]
        exact hx
      rwa [this] at hu
    · change k ≫ p.app _ l = _
      rw [hl, hk]
  choose T t l ht hu hl using hpt
  refine ⟨Sieve.ofArrows T t, BigFppfOver.ofArrows_mem_topology_of_flat_lfp B S hS T t
    (fun u => ⟨u, hu u⟩) (fun _ => inferInstance) (fun _ => inferInstance), ?_⟩
  intro T' t' ht'
  obtain ⟨u, d, rfl⟩ := Sieve.ofArrows.exists ht'
  let m := (Over.map z).map ((Over.pullback z).map d)
  refine hvan _ (P.map m.op (l u)).1.2 ((P.map m.op (l u)).2.trans ?_)
  change Q.obj.map (m ≫ p.app _ (l u)).op σ = _
  rw [hl u, ← Functor.map_comp, ← Functor.map_comp]

end AlgebraicGeometry

end
