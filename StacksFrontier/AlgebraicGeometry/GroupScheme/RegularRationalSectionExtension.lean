/-!
# Rational sections of proper group schemes over regular schemes

Let `X` be an integral Noetherian regular scheme and let `G` be a proper group scheme over `X`.
Every section of `G` over the generic point of `X` extends to a section of `G ⟶ X`. No bound on
the dimension of `X` enters. This is the extension of rational sections behind
[Stacks, Tag 0H8E].

## Main results

* `AlgebraicGeometry.GroupScheme.bijective_presheaf_map_of_forall_coheight_eq_one`: algebraic
  Hartogs for an open subscheme of an affine normal integral Noetherian scheme containing every
  point of codimension one.
* `AlgebraicGeometry.GroupScheme.exists_section_of_forall_mem_isAffineOpen`: over a regular local
  ring of dimension at least three, a partial section defined off the closed point, which sends
  the points of a hypersurface `t = 0` into an affine open, extends.
* `AlgebraicGeometry.GroupScheme.exists_section_of_three_le_ringKrullDim`: the inductive step over
  a regular local ring of dimension at least three.
* `AlgebraicGeometry.GroupScheme.exists_equiv_mem_domain_of_ringKrullDim_le`: a partial section
  extends across every point, by induction on the dimension of the local ring.
* `AlgebraicGeometry.GroupScheme.exists_section_extending_of_regular`: the extension of a section
  over the generic point.

## Implementation notes

The proof is by induction on the dimension `d` of the local ring `R = 𝒪_{X,x}` at the point `x`
across which the partial section is to be extended. For `d ≤ 2` this is the case of regular
surfaces, `AlgebraicGeometry.GroupScheme.exists_section_extending_of_isRegular`, the resolution
argument of Tag 0AF9, applied over `Spec R`. For `d ≥ 3` the partial section first extends across
every strict generization of `x`, by induction, and these extensions glue to a partial section `h`
of the base change of `G` to `Spec R`, defined off the closed point. Choose `t` in the maximal
ideal outside its square; then `R ⧸ t` is regular local of dimension `d - 1`, and by induction the
restriction of `h` to `Spec (R ⧸ t)` extends to a section, which sends the closed point, hence the
whole local scheme `Spec (R ⧸ t)`, into an affine open `V`. Every prime of `R` generated by at most
one element lies, by Krull's height theorem, below a prime other than the maximal ideal which
contains `t`; as `h⁻¹ V` is open, `h` maps such a prime into `V`. Since `R` is a unique
factorization domain this covers the generic point and every point of codimension one, so by
algebraic Hartogs the morphism `h⁻¹ V ⟶ V` into the affine `V` is the restriction of a morphism
`Spec R ⟶ V`, which is a section extending `h`. The section over `Spec R` spreads out to a
neighbourhood of `x` in `X`.

## References

* [Stacks Project, Tag 0AF9](https://stacks.math.columbia.edu/tag/0AF9)
* [Stacks Project, Tag 0AG0](https://stacks.math.columbia.edu/tag/0AG0)
* [Stacks Project, Tag 0H8E](https://stacks.math.columbia.edu/tag/0H8E)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace IsLocalRing

universe u

namespace AlgebraicGeometry.GroupScheme

/-! ### Extending morphisms into affine schemes -/

/-- A morphism from `W` to an affine scheme factors through a morphism `j : W ⟶ X` to an affine
scheme, provided `j` induces an isomorphism on global sections. -/
theorem exists_comp_eq_of_isIso_appTop {X W Y : Scheme.{u}} [IsAffine X] [IsAffine Y]
    (j : W ⟶ X) [IsIso j.appTop] (g : W ⟶ Y) : ∃ s : X ⟶ Y, j ≫ s = g := by
  refine ⟨X.toSpecΓ ≫ Spec.map (g.appTop ≫ inv j.appTop) ≫ inv Y.toSpecΓ, ?_⟩
  rw [Scheme.toSpecΓ_naturality_assoc, ← Spec.map_comp_assoc, Category.assoc, IsIso.inv_hom_id,
    Category.comp_id, ← Scheme.toSpecΓ_naturality_assoc, IsIso.hom_inv_id, Category.comp_id]

/-- **Algebraic Hartogs for an open subscheme.** On an affine normal integral locally Noetherian
scheme, restriction of global sections to an open subscheme containing every point of
codimension one is bijective. -/
theorem bijective_presheaf_map_of_forall_coheight_eq_one {X : Scheme.{u}} [IsIntegral X]
    [IsAffine X] [IsLocallyNoetherian X] [IsNormal X] (U : X.Opens) [Nonempty U]
    (hU : ∀ y : X, Order.coheight y = 1 → y ∈ U) :
    Function.Bijective (X.presheaf.map (homOfLE (le_top : U ≤ ⊤)).op) := by
  refine ⟨fun a b hab => ?_, fun σ => ?_⟩
  · apply X.germToFunctionField_injective ⊤
    have h := congrArg (X.germToFunctionField U) hab
    simpa only [Scheme.germToFunctionField, X.presheaf.germ_res_apply] using h
  · have hA : IsAffineOpen (⊤ : X.Opens) := isAffineOpen_top X
    have : IsDomain Γ(X, ⊤) := AlgebraicGeometry.IsIntegral.component_integral ⊤
    have : IsNoetherianRing Γ(X, ⊤) :=
      IsLocallyNoetherian.component_noetherian ⟨⊤, hA⟩
    have : IsIntegrallyClosed Γ(X, ⊤) :=
      (AlgebraicGeometry.isNormal_iff_forall_affineOpen_normal X).mp inferInstance ⟨⊤, hA⟩
        inferInstance
    have : IsFractionRing Γ(X, ⊤) X.functionField :=
      AlgebraicGeometry.functionField_isFractionRing_of_isAffineOpen X ⊤ hA
    have hz : ∀ q : PrimeSpectrum Γ(X, ⊤), q.asIdeal.height = 1 →
        ∃ a s : Γ(X, ⊤), s ∉ q.asIdeal ∧
          X.germToFunctionField U σ * algebraMap Γ(X, ⊤) X.functionField s =
            algebraMap Γ(X, ⊤) X.functionField a := by
      intro q hq
      let q' : ↥(Spec Γ(X, ⊤)) := q
      have hround : hA.isoSpec.hom.base (hA.isoSpec.inv.base q') = q := by
        rw [← Scheme.Hom.comp_apply, hA.isoSpec.inv_hom_id]
        rfl
      obtain ⟨u, hpq⟩ : ∃ u : (⊤ : X.Opens), hA.primeIdealOf u = q :=
        ⟨hA.isoSpec.inv.base q', hround⟩
      have hch : Order.coheight (u : X) = 1 := by
        rw [show (u : X) = (⊤ : X.Opens).ι.base u from rfl,
          AlgebraicGeometry.coheight_eq_of_isOpenImmersion (⊤ : X.Opens).ι (x := u),
          ← AlgebraicGeometry.coheight_eq_of_isOpenImmersion hA.isoSpec.hom (x := u),
          ← AlgebraicGeometry.idealHeight_eq_coheight, show hA.isoSpec.hom.base u = q from hpq]
        exact hq
      have huU : (u : X) ∈ U := hU _ hch
      have hloc : IsLocalization.AtPrime (X.presheaf.stalk (u : X)) q.asIdeal := by
        rw [← hpq]; exact hA.isLocalization_stalk u
      obtain ⟨⟨b, s⟩, hbs⟩ :=
        IsLocalization.mk'_surjective q.asIdeal.primeCompl (X.presheaf.germ U u huU σ)
      refine ⟨b, s.1, s.2, ?_⟩
      have hbs' : IsLocalization.mk' (X.presheaf.stalk (u : X)) b s =
          X.presheaf.germ U u huU σ := hbs
      have hspec := IsLocalization.mk'_spec (X.presheaf.stalk (u : X)) b s
      rw [hbs'] at hspec
      have hcg := congrArg (algebraMap (X.presheaf.stalk (u : X)) X.functionField) hspec
      rw [map_mul, Scheme.algebraMap_germ_eq_germToFunctionField] at hcg
      rwa [IsScalarTower.algebraMap_apply Γ(X, ⊤) (X.presheaf.stalk (u : X)) X.functionField s.1,
        IsScalarTower.algebraMap_apply Γ(X, ⊤) (X.presheaf.stalk (u : X)) X.functionField b]
    obtain ⟨r, hr⟩ :=
      Stacks.AlgebraicGeometry.UnitsNormalProper.exists_algebraMap_eq_of_forall_height_eq_one
        (R := Γ(X, ⊤)) X.functionField hz
    refine ⟨r, X.germToFunctionField_injective U ?_⟩
    rw [Scheme.germToFunctionField, X.presheaf.germ_res_apply]
    exact hr

/-- On an affine normal integral locally Noetherian scheme, the inclusion of an open subscheme
containing every point of codimension one induces an isomorphism on global sections. -/
theorem isIso_appTop_ι_of_forall_coheight_eq_one {X : Scheme.{u}} [IsIntegral X]
    [IsAffine X] [IsLocallyNoetherian X] [IsNormal X] (U : X.Opens) [Nonempty U]
    (hU : ∀ y : X, Order.coheight y = 1 → y ∈ U) : IsIso U.ι.appTop := by
  have hU' : ∀ y : X, Order.coheight y = 1 → y ∈ U.ι ''ᵁ ⊤ := by
    rw [Scheme.Opens.ι_image_top]; exact hU
  have : Nonempty (U.ι ''ᵁ ⊤) := by rw [Scheme.Opens.ι_image_top]; infer_instance
  rw [Scheme.Opens.ι_appTop]
  exact (ConcreteCategory.isIso_iff_bijective _).mpr
    (bijective_presheaf_map_of_forall_coheight_eq_one _ hU')

/-! ### The extension over a regular local ring of dimension at least three -/

/-- **Extension over a regular local ring of dimension at least three.** Let `R` be a regular
local ring of dimension at least three, `p : Y ⟶ Spec R` separated and `h` a partial section of
`p` defined at every point other than the closed point. Suppose that for some `t` in the maximal
ideal, `h` sends every point of its domain on which `t` vanishes into a fixed affine open `V`.
Then `h` extends to a section of `p`.

By Krull's height theorem, every point `x` of `Spec R` at which the prime ideal is generated by at
most one element specialises to a point other than the closed point on which `t` vanishes; as
`h⁻¹ V` is open, `h` maps `x` into `V`. In the unique factorization domain `R` this covers the
generic point and every point of codimension one, so by algebraic Hartogs `h` restricted to the
preimage of `V` is the restriction of a morphism `Spec R ⟶ V`. -/
theorem exists_section_of_forall_mem_isAffineOpen {R : CommRingCat.{u}} [IsRegularLocalRing R]
    (hdim : (3 : WithBot ℕ∞) ≤ ringKrullDim R) {Y : Scheme.{u}} (p : Y ⟶ Spec R)
    [IsSeparated p] (h : (Spec R).PartialMap Y) (hh : h.hom ≫ p = h.domain.ι)
    (hdom : ∀ x : Spec R, x ≠ closedPoint R → x ∈ h.domain) {t : R}
    (ht : t ∈ maximalIdeal R) (V : Y.Opens) (hV : IsAffineOpen V)
    (htV : ∀ (x : Spec R) (hx : x ∈ h.domain), t ∈ x.asIdeal → h.hom ⟨x, hx⟩ ∈ V) :
    ∃ s : Spec R ⟶ Y, s ≫ p = 𝟙 _ ∧ h.domain.ι ≫ s = h.hom := by
  classical
  have : IsDomain R := IsRegularLocalRing.isDomain R
  have : UniqueFactorizationMonoid R := IsRegularLocalRing.uniqueFactorizationMonoid R
  have hm : ((maximalIdeal R).height : WithBot ℕ∞) = ringKrullDim R :=
    IsLocalRing.maximalIdeal_height_eq_ringKrullDim
  have hne : ∀ I : Ideal R, I.height ≤ 2 → I ≠ maximalIdeal R := by
    rintro I hI rfl
    have h3 : (3 : WithBot ℕ∞) ≤ ((maximalIdeal R).height : WithBot ℕ∞) := hm ▸ hdim
    have h2 : ((maximalIdeal R).height : WithBot ℕ∞) ≤ (2 : ℕ∞) := by exact_mod_cast hI
    exact absurd (h3.trans h2) (by decide)
  have key : ∀ (x : Spec R) (hx : x ∈ h.domain) (s : Finset R), s.card ≤ 1 →
      x.asIdeal = Ideal.span (s : Set R) → h.hom ⟨x, hx⟩ ∈ V := by
    intro x hx s hs hxs
    by_contra hxV
    have hI : Ideal.span ((insert t s : Finset R) : Set R) ≠ ⊤ := by
      refine ne_top_of_le_ne_top (maximalIdeal.isMaximal R).ne_top ?_
      rw [Ideal.span_le, Finset.coe_insert, Set.insert_subset_iff]
      refine ⟨ht, fun a ha => ?_⟩
      have hax : a ∈ x.asIdeal := hxs ▸ Ideal.subset_span ha
      exact le_maximalIdeal x.isPrime.ne_top hax
    obtain ⟨⟨Q, hQ⟩⟩ := Ideal.nonempty_minimalPrimes hI
    have hQp : Q.IsPrime := hQ.1.1
    have hQh : Q.height ≤ 2 := by
      refine (Ideal.height_le_card_of_mem_minimalPrimes_span_finset hQ).trans ?_
      exact_mod_cast (Finset.card_insert_le t s).trans (by omega)
    let y : Spec R := ⟨Q, hQp⟩
    have hy : y ∈ h.domain := hdom y fun e => hne Q hQh (congrArg PrimeSpectrum.asIdeal e)
    have hty : t ∈ y.asIdeal := hQ.1.2 (Ideal.subset_span (by simp))
    have hxy : x ⤳ y := (PrimeSpectrum.le_iff_specializes x y).mp (by
      change x.asIdeal ≤ Q
      rw [hxs]
      exact (Ideal.span_mono (by simp)).trans hQ.1.2)
    have hxy' : (⟨x, hx⟩ : h.domain) ⤳ ⟨y, hy⟩ := (subtype_specializes_iff _ _).mpr hxy
    exact hxV ((hxy'.map h.hom.continuous).mem_open V.2 (htV y hy hty))
  let W' : h.domain.toScheme.Opens := h.hom ⁻¹ᵁ V
  let W : (Spec R).Opens := h.domain.ι ''ᵁ W'
  have hmemW : ∀ (x : Spec R) (hx : x ∈ h.domain), h.hom ⟨x, hx⟩ ∈ V → x ∈ W :=
    fun x hx hxV => ⟨⟨x, hx⟩, hxV, rfl⟩
  have hcodim : ∀ y : Spec R, Order.coheight y = 1 → y ∈ W := by
    intro y hy
    have hy1 : y.asIdeal.height = 1 := by rw [idealHeight_eq_coheight]; exact hy
    obtain ⟨π, hπy, hπ⟩ :=
      y.isPrime.exists_mem_prime_of_ne_bot (Ideal.ne_bot_of_height_eq_one hy1)
    have hyπ : y.asIdeal = Ideal.span {π} :=
      Ideal.eq_span_singleton_of_height_eq_one hy1 hπy hπ
    have hyd : y ∈ h.domain := hdom y fun e =>
      hne y.asIdeal (by rw [hy1]; norm_num) (congrArg PrimeSpectrum.asIdeal e)
    exact hmemW y hyd (key y hyd {π} (by simp) (by simpa using hyπ))
  let η : Spec R := ⟨⊥, Ideal.isPrime_bot⟩
  have hηd : η ∈ h.domain := hdom η fun e =>
    hne ⊥ (by rw [Ideal.height_bot]; norm_num) (congrArg PrimeSpectrum.asIdeal e)
  have : Nonempty W := ⟨⟨η, hmemW η hηd (key η hηd ∅ (by simp) (by simp [η]))⟩⟩
  have htfae := IsLocalRing.isRegularRing_tfae (R := (R : Type u))
  have : IsRegularRing R := (htfae.out 1 3).mp ‹_›
  have hreg : IsRegular (Spec R) := Stacks.isRegular_spec_of_isRegularRing R
  have : IsNormal (Spec R) := isNormal_of_isRegular _ hreg
  have hiso : IsIso W.ι.appTop := isIso_appTop_ι_of_forall_coheight_eq_one W hcodim
  have : IsAffine V.toScheme := hV
  let g : W.toScheme ⟶ V.toScheme := (h.domain.ι.isoImage W').inv ≫ (h.hom ∣_ V)
  obtain ⟨s₀, hs₀⟩ := exists_comp_eq_of_isIso_appTop W.ι g
  have hgV : g ≫ V.ι = (h.domain.ι.isoImage W').inv ≫ W'.ι ≫ h.hom := by
    simp only [g, Category.assoc, morphismRestrict_ι]
    rfl
  have hW : W.ι ≫ (s₀ ≫ V.ι) ≫ p = W.ι ≫ 𝟙 _ := by
    simp only [Category.assoc]
    rw [reassoc_of% hs₀, Category.comp_id, reassoc_of% hgV, hh,
      Scheme.Hom.isoImage_inv_ι]
  have hsp : (s₀ ≫ V.ι) ≫ p = 𝟙 _ := by
    apply ext_of_isAffine
    have h1 := congrArg Scheme.Hom.appTop hW
    simp only [Scheme.Hom.comp_appTop] at h1
    exact (cancel_mono W.ι.appTop).mp h1
  refine ⟨s₀ ≫ V.ι, hsp, ?_⟩
  have hηV : h.hom ⟨η, hηd⟩ ∈ V := key η hηd ∅ (by simp) (by simp [η])
  have : Nonempty h.domain := ⟨⟨η, hηd⟩⟩
  have : IsDominant W'.ι := AlgebraicGeometry.Opens.isDominant_ι (W'.2.dense ⟨⟨η, hηd⟩, hηV⟩)
  refine ext_of_isDominant_of_isSeparated p ?_ W'.ι ?_
  · rw [Category.assoc, hsp, Category.comp_id, hh]
  · rw [← Scheme.Hom.isoImage_hom_ι_assoc, reassoc_of% hs₀, hgV, Iso.hom_inv_id_assoc]

/-! ### Partial sections -/

/-- The pullback of a partial section of `G ⟶ X` along `ψ : X' ⟶ X`, as a partial section of
the base change of `G`, defined on the preimage of the domain. -/
noncomputable def pullbackPartialSection {X X' : Scheme.{u}} (G : Over X) (ψ : X' ⟶ X)
    (f : X.PartialMap G.left) (hf : f.hom ≫ G.hom = f.domain.ι)
    (hd : Dense ((ψ ⁻¹ᵁ f.domain : X'.Opens) : Set X')) :
    X'.PartialMap (pullback G.hom ψ) where
  domain := ψ ⁻¹ᵁ f.domain
  dense_domain := hd
  hom := pullback.lift ((ψ ∣_ f.domain) ≫ f.hom) (ψ ⁻¹ᵁ f.domain).ι
    (by rw [Category.assoc, hf, morphismRestrict_ι])

@[simp]
theorem pullbackPartialSection_domain {X X' : Scheme.{u}} (G : Over X) (ψ : X' ⟶ X)
    (f : X.PartialMap G.left) (hf : f.hom ≫ G.hom = f.domain.ι)
    (hd : Dense ((ψ ⁻¹ᵁ f.domain : X'.Opens) : Set X')) :
    (pullbackPartialSection G ψ f hf hd).domain = ψ ⁻¹ᵁ f.domain := rfl

theorem pullbackPartialSection_hom_snd {X X' : Scheme.{u}} (G : Over X) (ψ : X' ⟶ X)
    (f : X.PartialMap G.left) (hf : f.hom ≫ G.hom = f.domain.ι)
    (hd : Dense ((ψ ⁻¹ᵁ f.domain : X'.Opens) : Set X')) :
    (pullbackPartialSection G ψ f hf hd).hom ≫ pullback.snd _ _ =
      (pullbackPartialSection G ψ f hf hd).domain.ι :=
  pullback.lift_snd _ _ _

theorem pullbackPartialSection_hom_fst {X X' : Scheme.{u}} (G : Over X) (ψ : X' ⟶ X)
    (f : X.PartialMap G.left) (hf : f.hom ≫ G.hom = f.domain.ι)
    (hd : Dense ((ψ ⁻¹ᵁ f.domain : X'.Opens) : Set X')) :
    (pullbackPartialSection G ψ f hf hd).hom ≫ pullback.fst _ _ = (ψ ∣_ f.domain) ≫ f.hom :=
  pullback.lift_fst _ _ _

theorem pullbackPartialSection_hom_fst_apply {X X' : Scheme.{u}} (G : Over X) (ψ : X' ⟶ X)
    (f : X.PartialMap G.left) (hf : f.hom ≫ G.hom = f.domain.ι)
    (hd : Dense ((ψ ⁻¹ᵁ f.domain : X'.Opens) : Set X')) (b : X') (hb : ψ b ∈ f.domain) :
    pullback.fst G.hom ψ ((pullbackPartialSection G ψ f hf hd).hom ⟨b, hb⟩) = f.hom ⟨ψ b, hb⟩ := by
  have e : (pullbackPartialSection G ψ f hf hd).hom ≫ pullback.fst G.hom ψ =
      (ψ ∣_ f.domain) ≫ f.hom := pullback.lift_fst _ _ _
  have e' := congrArg (fun m : (ψ ⁻¹ᵁ f.domain : X'.Opens).toScheme ⟶ G.left =>
    m (⟨b, hb⟩ : (ψ ⁻¹ᵁ f.domain : X'.Opens))) e
  refine e'.trans ?_
  change f.hom ((ψ ∣_ f.domain) ⟨b, hb⟩) = _
  congr 1
  exact Subtype.ext (morphismRestrict_base_coe ψ f.domain ⟨b, hb⟩)

/-- **Gluing partial maps.** Over a separated target, partial maps from a reduced scheme which
are equivalent to a given one glue: for every set of points each lying in the domain of such a
partial map, there is one partial map equivalent to the given one whose domain contains them
all. -/
theorem PartialMap.exists_isOver_equiv_subset_domain {S X Y : Scheme.{u}} [X.Over S] [Y.Over S]
    [IsReduced X] [IsSeparated (Y ↘ S)] (f : X.PartialMap Y) [f.IsOver S] (P : Set X)
    (hP : ∀ x ∈ P, ∃ g : X.PartialMap Y, g.IsOver S ∧ g.equiv f ∧ x ∈ g.domain) :
    ∃ g : X.PartialMap Y, g.IsOver S ∧ g.equiv f ∧ P ⊆ g.domain := by
  let I := {g : X.PartialMap Y // g.IsOver S ∧ g.equiv f}
  let U : I → X.Opens := fun i => i.1.domain
  let i₀ : I := ⟨f, ‹_›, .refl f⟩
  let 𝒰 := Scheme.Opens.iSupOpenCover U
  have hcompat : ∀ i j : I, pullback.fst (𝒰.f i) (𝒰.f j) ≫ i.1.hom =
      pullback.snd (𝒰.f i) (𝒰.f j) ≫ j.1.hom := by
    intro i j
    have := i.2.1
    have := j.2.1
    have hij := (Scheme.PartialMap.equiv_iff_of_isSeparated (S := S) (f := i.1)
      (g := j.1)).mp (i.2.2.trans j.2.2.symm)
    refine (cancel_epi (isPullback_opens_inf_le (le_iSup U i)
      (le_iSup U j)).isoPullback.hom).mp ?_
    simp only [𝒰, Scheme.Opens.iSupOpenCover, IsPullback.isoPullback_hom_fst_assoc,
      IsPullback.isoPullback_hom_snd_assoc]
    exact hij
  have hdense : Dense ((⨆ i, U i : X.Opens) : Set X) :=
    f.dense_domain.mono (le_iSup U i₀)
  let g : X.PartialMap Y := ⟨⨆ i, U i, hdense, 𝒰.glueMorphisms (fun i => i.1.hom) hcompat⟩
  have hres : ∀ i : I, X.homOfLE (le_iSup U i) ≫ g.hom = i.1.hom :=
    fun i => 𝒰.ι_glueMorphisms _ hcompat i
  have hover : g.IsOver S := by
    rw [Scheme.PartialMap.isOver_iff]
    refine 𝒰.hom_ext _ _ fun i => ?_
    have h1 := Scheme.PartialMap.isOver_iff.mp i.2.1
    change X.homOfLE (le_iSup U i) ≫ g.hom ≫ (Y ↘ S) =
      X.homOfLE (le_iSup U i) ≫ g.domain.ι ≫ (X ↘ S)
    rw [reassoc_of% (hres i), Scheme.homOfLE_ι_assoc]
    exact h1
  refine ⟨g, hover, ⟨f.domain, f.dense_domain, le_iSup U i₀, le_rfl, ?_⟩, ?_⟩
  · simp only [Scheme.PartialMap.restrict_hom, Scheme.homOfLE_rfl, Category.id_comp]
    exact hres i₀
  · intro x hx
    obtain ⟨g', hg', hg'f, hxg'⟩ := hP x hx
    exact (le_iSup U ⟨g', hg', hg'f⟩) hxg'

/-- The restriction of a partial map to the function field, computed at a point of the
domain. -/
theorem PartialMap.fromFunctionField_eq_specMap_comp {X Y : Scheme.{u}} [IrreducibleSpace X]
    (f : X.PartialMap Y) {x : X} (hx : x ∈ f.domain) :
    f.fromFunctionField = Spec.map (X.presheaf.stalkSpecializes (genericPoint_specializes x)) ≫
      f.fromSpecStalkOfMem hx := by
  simp only [Scheme.PartialMap.fromFunctionField, Scheme.PartialMap.fromSpecStalkOfMem,
    ← Category.assoc]
  congr 1
  rw [← cancel_mono f.domain.ι]
  simp only [Category.assoc, Scheme.Opens.fromSpecStalkOfMem_ι,
    Scheme.SpecMap_stalkSpecializes_fromSpecStalk]

/-- **From the local ring to a neighbourhood.** A section of `G` over `Spec 𝒪_{X,x}` which agrees
with a partial section `f` at the generic point gives a partial section equivalent to `f` and
defined at `x`. -/
theorem exists_equiv_mem_domain_of_fromSpecStalk {X : Scheme.{u}} [IsIntegral X]
    [IsLocallyNoetherian X] (G : Over X) [IsSeparated G.hom] [LocallyOfFiniteType G.hom]
    (f : X.PartialMap G.left) (x : X) (φ : Spec (X.presheaf.stalk x) ⟶ G.left)
    (hφ : φ ≫ G.hom = X.fromSpecStalk x)
    (hgen : Spec.map (X.presheaf.stalkSpecializes (genericPoint_specializes x)) ≫ φ =
      f.fromFunctionField) :
    ∃ g : X.PartialMap G.left, g.hom ≫ G.hom = g.domain.ι ∧ g.equiv f ∧ x ∈ g.domain := by
  have hφ' : φ ≫ G.hom = X.fromSpecStalk x ≫ 𝟙 X := by rw [hφ, Category.comp_id]
  let g := Scheme.PartialMap.ofFromSpecStalk (𝟙 X) G.hom φ hφ'
  have hx : x ∈ g.domain := Scheme.PartialMap.mem_domain_ofFromSpecStalk (𝟙 X) G.hom φ hφ'
  refine ⟨g, by simpa using Scheme.PartialMap.ofFromSpecStalk_comp (𝟙 X) G.hom φ hφ', ?_, hx⟩
  have hη : genericPoint X ∈ g.domain := (genericPoint_specializes x).mem_open g.domain.2 hx
  have hηf : genericPoint X ∈ f.domain :=
    (genericPoint_specializes _).mem_open f.domain.2 f.dense_domain.nonempty.choose_spec
  refine Scheme.PartialMap.equiv_of_fromSpecStalkOfMem_eq g f hη hηf ?_
  have h1 := PartialMap.fromFunctionField_eq_specMap_comp g hx
  rw [Scheme.PartialMap.fromSpecStalkOfMem_ofFromSpecStalk, hgen] at h1
  exact h1

/-- The agreement at the generic point of a section over `Spec 𝒪_{X,x}` extending the pullback
of a partial section. -/
theorem specMap_comp_fst_eq_fromFunctionField {X : Scheme.{u}} [IsIntegral X] (G : Over X)
    (f : X.PartialMap G.left) (hf : f.hom ≫ G.hom = f.domain.ι) (x : X)
    (hd : Dense ((X.fromSpecStalk x ⁻¹ᵁ f.domain : (Spec (X.presheaf.stalk x)).Opens) :
      Set (Spec (X.presheaf.stalk x))))
    (s : Spec (X.presheaf.stalk x) ⟶ pullback G.hom (X.fromSpecStalk x))
    (hs : (pullbackPartialSection G (X.fromSpecStalk x) f hf hd).domain.ι ≫ s =
      (pullbackPartialSection G (X.fromSpecStalk x) f hf hd).hom) :
    Spec.map (X.presheaf.stalkSpecializes (genericPoint_specializes x)) ≫ s ≫
      pullback.fst _ _ = f.fromFunctionField := by
  let ι := X.fromSpecStalk x
  let sp := Spec.map (X.presheaf.stalkSpecializes (genericPoint_specializes x))
  have hηf : genericPoint X ∈ f.domain :=
    (genericPoint_specializes _).mem_open f.domain.2 f.dense_domain.nonempty.choose_spec
  have hrange : Set.range sp ⊆ Set.range (ι ⁻¹ᵁ f.domain).ι := by
    rintro _ ⟨a, rfl⟩
    rw [Scheme.Opens.range_ι]
    change ι (sp a) ∈ f.domain
    rw [← Scheme.Hom.comp_apply, Scheme.SpecMap_stalkSpecializes_fromSpecStalk]
    have ha : X.fromSpecStalk (genericPoint X) a ∈ Set.range (X.fromSpecStalk (genericPoint X)) :=
      ⟨a, rfl⟩
    rw [Scheme.range_fromSpecStalk] at ha
    exact ha.mem_open f.domain.2 hηf
  let j := IsOpenImmersion.lift (ι ⁻¹ᵁ f.domain).ι sp hrange
  have hj : j ≫ (ι ⁻¹ᵁ f.domain).ι = sp := IsOpenImmersion.lift_fac _ _ _
  have hj' : j ≫ (ι ∣_ f.domain) = f.domain.fromSpecStalkOfMem (genericPoint X) hηf := by
    rw [← cancel_mono f.domain.ι, Category.assoc, morphismRestrict_ι, reassoc_of% hj,
      Scheme.Opens.fromSpecStalkOfMem_ι]
    exact Scheme.SpecMap_stalkSpecializes_fromSpecStalk _
  have hs' : (ι ⁻¹ᵁ f.domain).ι ≫ s =
      (pullbackPartialSection G (X.fromSpecStalk x) f hf hd).hom := hs
  change sp ≫ s ≫ pullback.fst _ _ = f.domain.fromSpecStalkOfMem _ _ ≫ f.hom
  rw [← hj, Category.assoc, reassoc_of% hs']
  simp only [pullbackPartialSection, pullback.lift_fst]
  rw [reassoc_of% hj']

/-- A regular local ring of positive dimension has an element of the maximal ideal outside its
square. -/
theorem exists_mem_maximalIdeal_notMem_sq {R : Type u} [CommRing R] [IsRegularLocalRing R]
    (hdim : (1 : WithBot ℕ∞) ≤ ringKrullDim R) :
    ∃ t ∈ maximalIdeal R, t ∉ maximalIdeal R ^ 2 := by
  by_contra! h
  have hle : maximalIdeal R ≤ maximalIdeal R • maximalIdeal R := by
    intro a ha
    have := h a ha
    rwa [pow_two] at this
  have hbot : maximalIdeal R = ⊥ :=
    Submodule.eq_bot_of_le_smul_of_le_jacobson_bot (maximalIdeal R) (maximalIdeal R)
      (IsNoetherian.noetherian _) hle
      (by rw [IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top])
  have hm : ((maximalIdeal R).height : WithBot ℕ∞) = ringKrullDim R :=
    IsLocalRing.maximalIdeal_height_eq_ringKrullDim
  rw [hbot, Ideal.height_bot] at hm
  rw [← hm] at hdim
  exact absurd hdim (by decide)

/-- **The inductive step over a regular local ring of dimension at least three.** Let `R` be a
regular local ring of dimension at least three, `H` a proper group scheme over `Spec R` and `h` a
partial section of `H` defined at every point other than the closed point. If rational sections
extend across points of local dimension less than that of `R` (`hIH`), then `h` extends to a
section of `H`.

Choose `t` in the maximal ideal outside its square, so that `R ⧸ t` is regular local of dimension
one less. By `hIH`, the restriction of `h` to `Spec (R ⧸ t)` extends to a section there, which
sends the closed point, hence all of `Spec (R ⧸ t)`, into an affine open `V`. So `h` maps every
point on which `t` vanishes into `V`, and `exists_section_of_forall_mem_isAffineOpen` applies. -/
theorem exists_section_of_three_le_ringKrullDim {R : CommRingCat.{u}} [IsRegularLocalRing R]
    (h3 : (3 : WithBot ℕ∞) ≤ ringKrullDim R) (H : Over (Spec R)) [GrpObj H] [IsProper H.hom]
    (h : (Spec R).PartialMap H.left) (hh : h.hom ≫ H.hom = h.domain.ι)
    (hdom : ∀ x : Spec R, x ≠ closedPoint R → x ∈ h.domain)
    (hIH : ∀ (Y : Scheme.{u}) [IsIntegral Y] [IsNoetherian Y], IsRegular Y →
      ∀ (G' : Over Y) [GrpObj G'] [IsProper G'.hom] (f' : Y.PartialMap G'.left),
        f'.hom ≫ G'.hom = f'.domain.ι → ∀ y : Y,
          ringKrullDim (Y.presheaf.stalk y) + 1 ≤ ringKrullDim R →
          ∃ g : Y.PartialMap G'.left, g.hom ≫ G'.hom = g.domain.ι ∧ g.equiv f' ∧ y ∈ g.domain) :
    ∃ s : Spec R ⟶ H.left, s ≫ H.hom = 𝟙 _ ∧ h.domain.ι ≫ s = h.hom := by
  classical
  have : IsDomain R := IsRegularLocalRing.isDomain R
  obtain ⟨t, ht, ht2⟩ := exists_mem_maximalIdeal_notMem_sq (R := R)
    ((by decide : (1 : WithBot ℕ∞) ≤ 3).trans h3)
  let A := R ⧸ Ideal.span {t}
  have : IsRegularLocalRing A :=
    Stacks.RegularLocalRing.DirectedColimit.isRegularLocalRing_quotient_span_singleton ht ht2
  have : IsDomain A := IsRegularLocalRing.isDomain A
  have ht0 : t ∈ nonZeroDivisors R :=
    mem_nonZeroDivisors_of_ne_zero fun h0 => ht2 (h0 ▸ Submodule.zero_mem _)
  have hdimA : ringKrullDim A + 1 = ringKrullDim R :=
    ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors ht0 ht
  have htfae := IsLocalRing.isRegularRing_tfae (R := A)
  have : IsRegularRing A := (htfae.out 1 3).mp ‹_›
  let D : Scheme.{u} := Spec (CommRingCat.of A)
  have hregD : IsRegular D := Stacks.isRegular_spec_of_isRegularRing A
  let i : D ⟶ Spec R := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (Ideal.span {t})))
  have hm : ((maximalIdeal R).height : WithBot ℕ∞) = ringKrullDim R :=
    IsLocalRing.maximalIdeal_height_eq_ringKrullDim
  -- the generic point of `D` maps to a point other than the closed point
  let ηD : D := ⟨⊥, Ideal.isPrime_bot⟩
  have hηD : i ηD ≠ closedPoint R := by
    intro e
    have he : Ideal.span {t} = maximalIdeal R := by
      have := congrArg PrimeSpectrum.asIdeal e
      change Ideal.comap (Ideal.Quotient.mk (Ideal.span {t})) ⊥ = maximalIdeal R at this
      rwa [← RingHom.ker_eq_comap_bot, Ideal.mk_ker] at this
    have hmin : maximalIdeal R ∈ (Ideal.span ({t} : Set R)).minimalPrimes := by
      rw [he, Ideal.minimalPrimes_eq_subsingleton_self]
      rfl
    have h1 := Ideal.height_le_card_of_mem_minimalPrimes_span_finset (s := {t})
      (by simpa using hmin)
    have h1' : ((maximalIdeal R).height : WithBot ℕ∞) ≤ (1 : ℕ∞) := by
      exact_mod_cast (by simpa using h1)
    rw [hm] at h1'
    exact absurd (h3.trans h1') (by decide)
  have hDd : Dense ((i ⁻¹ᵁ h.domain : D.Opens) : Set D) :=
    (i ⁻¹ᵁ h.domain).2.dense ⟨ηD, hdom _ hηD⟩
  let N := (Over.pullback i).mapGrp.obj (.mk H)
  have : IsProper N.X.hom := inferInstanceAs (IsProper (pullback.snd H.hom i))
  let hD := pullbackPartialSection H i h hh hDd
  have hhD : hD.hom ≫ N.X.hom = hD.domain.ι := pullbackPartialSection_hom_snd H i h hh hDd
  have hstalk : ringKrullDim (D.presheaf.stalk (closedPoint A)) + 1 ≤ ringKrullDim R := by
    rw [ringKrullDim_eq_of_ringEquiv
      (stalkClosedPointIso (CommRingCat.of A)).commRingCatIsoToRingEquiv, hdimA]
  obtain ⟨gD, hgD, hgDh, hgDc⟩ := hIH D hregD N.X hD hhD (closedPoint A) hstalk
  have hgDtop : gD.domain = ⊤ := IsLocalRing.closed_point_mem_iff.mp hgDc
  let c : H.left := (gD.hom ≫ pullback.fst H.hom i) ⟨closedPoint A, hgDc⟩
  obtain ⟨V, hV, hcV, -⟩ := exists_isAffineOpen_mem_and_subset (x := c) (U := ⊤) trivial
  -- every point of `D` is sent into `V`
  have hDV : ∀ (b : D) (hb : b ∈ gD.domain), (gD.hom ≫ pullback.fst H.hom i) ⟨b, hb⟩ ∈ V := by
    intro b hb
    let O : D.Opens := gD.domain.ι ''ᵁ ((gD.hom ≫ pullback.fst H.hom i) ⁻¹ᵁ V)
    have hO : O = ⊤ := IsLocalRing.closed_point_mem_iff.mp ⟨⟨closedPoint A, hgDc⟩, hcV, rfl⟩
    have hbO : b ∈ O := hO ▸ trivial
    obtain ⟨b', hb'V, hb'⟩ := hbO
    have : b' = ⟨b, hb⟩ := Subtype.ext hb'
    exact this ▸ hb'V
  -- agreement of `gD` and `hD`
  let : D.Over D := ⟨𝟙 D⟩
  let gD' : D.PartialMap (pullback H.hom i) := gD
  let : (pullback H.hom i).Over D := ⟨pullback.snd H.hom i⟩
  have : IsSeparated (pullback H.hom i ↘ D) := inferInstanceAs (IsSeparated (pullback.snd H.hom i))
  have : gD'.IsOver D := ⟨hgD.trans (Category.comp_id _).symm⟩
  have : hD.IsOver D := ⟨hhD.trans (Category.comp_id _).symm⟩
  have hagree := (Scheme.PartialMap.equiv_iff_of_isSeparated (S := D) (f := gD')
    (g := hD)).mp hgDh
  rw [Scheme.PartialMap.restrict_hom, Scheme.PartialMap.restrict_hom] at hagree
  have htV : ∀ (x : Spec R) (hx : x ∈ h.domain), t ∈ x.asIdeal → h.hom ⟨x, hx⟩ ∈ V := by
    intro x hx htx
    obtain ⟨b, hbi⟩ : ∃ b : D, i b = x := by
      have hxr : x ∈ Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk (Ideal.span {t}))) := by
        rw [range_comap_of_surjective _ _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
        exact (PrimeSpectrum.mem_zeroLocus _ _).mpr fun a ha =>
          (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr htx)) ha
      obtain ⟨b, hb⟩ := hxr
      exact ⟨b, hb⟩
    subst hbi
    have hbD : b ∈ hD.domain := hx
    have hbg : b ∈ gD'.domain := by rw [hgDtop]; trivial
    let pt : (gD'.domain ⊓ hD.domain : D.Opens) := ⟨b, hbg, hbD⟩
    have h1 := congrArg (fun m => m pt) hagree
    have e1 : D.homOfLE inf_le_left pt = ⟨b, hbg⟩ := Scheme.homOfLE_apply' _ b _
    have e2 : D.homOfLE inf_le_right pt = ⟨b, hbD⟩ := Scheme.homOfLE_apply' _ b _
    have h1' : gD'.hom ⟨b, hbg⟩ = hD.hom ⟨b, hbD⟩ := by
      change gD'.hom (D.homOfLE inf_le_left pt) = hD.hom (D.homOfLE inf_le_right pt) at h1
      rwa [e1, e2] at h1
    have h2 := pullbackPartialSection_hom_fst_apply H i h hh hDd b hx
    have h3' := hDV b hbg
    change pullback.fst H.hom i (gD'.hom ⟨b, hbg⟩) ∈ V at h3'
    rw [h1'] at h3'
    rw [← h2]
    exact h3'
  exact exists_section_of_forall_mem_isAffineOpen h3 H.hom h hh hdom ht V hV htV

/-! ### The induction on the dimension of the local rings -/

/-- A Noetherian local ring has dimension at most some natural number. -/
theorem exists_ringKrullDim_le_natCast (R : Type u) [CommRing R] [IsNoetherianRing R]
    [IsLocalRing R] : ∃ d : ℕ, ringKrullDim R ≤ d := by
  have h1 : ringKrullDim R < ⊤ := ringKrullDim_lt_top
  induction hr : ringKrullDim R using WithBot.recBotCoe with
  | bot => exact ⟨0, bot_le⟩
  | coe a =>
    induction a using ENat.recTopCoe with
    | top => rw [hr] at h1; exact absurd h1 (lt_irrefl _)
    | coe n => exact ⟨n, le_rfl⟩

/-- If `a + 1 ≤ b ≤ d` then `a ≤ d - 1`. -/
theorem le_natCast_sub_one_of_add_one_le {a b : WithBot ℕ∞} {d : ℕ} (h : a + 1 ≤ b)
    (hb : b ≤ d) : a ≤ ((d - 1 : ℕ) : WithBot ℕ∞) := by
  have hab := h.trans hb
  induction a using WithBot.recBotCoe with
  | bot => exact bot_le
  | coe a =>
    induction a using ENat.recTopCoe with
    | top =>
      rw [← WithBot.coe_one, ← WithBot.coe_add, top_add] at hab
      exact absurd (WithBot.coe_le_coe.mp hab) (by simp)
    | coe n =>
      have e : ((n : ℕ∞) : WithBot ℕ∞) = ((n : ℕ) : WithBot ℕ∞) := rfl
      rw [e] at hab ⊢
      have hn : n + 1 ≤ d := by exact_mod_cast hab
      exact_mod_cast (by omega : n ≤ d - 1)

/-- An element of `WithBot ℕ∞` which is not at most two is at least three. -/
theorem three_le_of_not_le_two {r : WithBot ℕ∞} (h : ¬ r ≤ 2) : 3 ≤ r := by
  induction r using WithBot.recBotCoe with
  | bot => exact absurd bot_le h
  | coe a =>
    induction a using ENat.recTopCoe with
    | top => exact WithBot.coe_le_coe.mpr le_top
    | coe n =>
      have e : ((n : ℕ∞) : WithBot ℕ∞) = ((n : ℕ) : WithBot ℕ∞) := rfl
      rw [e] at h ⊢
      have hn : ¬ n ≤ 2 := fun hn => h (by exact_mod_cast hn)
      exact_mod_cast (by omega : 3 ≤ n)

/-- A strict generization has a local ring of smaller dimension. -/
theorem ringKrullDim_stalk_add_one_le_of_specializes {X : Scheme.{u}} {x z : X} (h : z ⤳ x)
    (hne : z ≠ x) :
    ringKrullDim (X.presheaf.stalk z) + 1 ≤ ringKrullDim (X.presheaf.stalk x) := by
  rw [ringKrullDim_stalk_eq_coheight, ringKrullDim_stalk_eq_coheight]
  have hlt : x < z := lt_of_le_not_ge (Scheme.le_iff_specializes.mpr h) fun hzx =>
    hne (inseparable_iff_specializes_and.mpr ⟨h, Scheme.le_iff_specializes.mp hzx⟩).eq
  exact_mod_cast Order.coheight_add_one_le hlt

/-- The preimage of a dense open under `Spec 𝒪_{X,x} ⟶ X` is dense, for `X` integral. -/
theorem dense_preimage_fromSpecStalk {X : Scheme.{u}} [IsIntegral X] (x : X) (U : X.Opens)
    (hU : Dense (U : Set X)) :
    Dense ((X.fromSpecStalk x ⁻¹ᵁ U : (Spec (X.presheaf.stalk x)).Opens) :
      Set (Spec (X.presheaf.stalk x))) := by
  have hη : genericPoint X ∈ U := (genericPoint_specializes _).mem_open U.2 hU.nonempty.choose_spec
  have hr : genericPoint X ∈ Set.range (X.fromSpecStalk x) := by
    rw [Scheme.range_fromSpecStalk]
    exact genericPoint_specializes x
  obtain ⟨a, ha⟩ := hr
  exact (X.fromSpecStalk x ⁻¹ᵁ U).2.dense ⟨a, show X.fromSpecStalk x a ∈ U from ha ▸ hη⟩

/-- A point of `Spec 𝒪_{X,x}` other than the closed point maps to a strict generization of
`x`. -/
theorem fromSpecStalk_specializes_and_ne {X : Scheme.{u}} (x : X)
    (a : Spec (X.presheaf.stalk x)) (ha : a ≠ closedPoint (X.presheaf.stalk x)) :
    X.fromSpecStalk x a ⤳ x ∧ X.fromSpecStalk x a ≠ x := by
  refine ⟨?_, fun e => ha ((X.fromSpecStalk x).isEmbedding.injective ?_)⟩
  · have hr : X.fromSpecStalk x a ∈ Set.range (X.fromSpecStalk x) := ⟨a, rfl⟩
    rw [Scheme.range_fromSpecStalk] at hr
    exact hr
  · rw [e, Scheme.fromSpecStalk_closedPoint]

/-- **Extension across a point**, by induction on the dimension `d` of the local ring. Let `X` be
an integral Noetherian regular scheme, `G` a proper group scheme over `X` and `f` a partial section
of `G`. For every point `x` whose local ring has dimension at most `d`, there is a partial section
equivalent to `f` and defined at `x`.

In dimension at most two this is
`AlgebraicGeometry.GroupScheme.exists_section_extending_of_isRegular` applied over
`Spec 𝒪_{X,x}`. In dimension at least three, `f` first extends across all strict
generizations of `x` (by induction, glued), and then across `x` by
`AlgebraicGeometry.GroupScheme.exists_section_of_three_le_ringKrullDim` over `Spec 𝒪_{X,x}`, whose
inductive input is again the induction hypothesis. -/
theorem exists_equiv_mem_domain_of_ringKrullDim_le (d : ℕ) :
    ∀ (X : Scheme.{u}) [IsIntegral X] [IsNoetherian X], IsRegular X →
      ∀ (G : Over X) [GrpObj G] [IsProper G.hom] (f : X.PartialMap G.left),
        f.hom ≫ G.hom = f.domain.ι → ∀ x : X, ringKrullDim (X.presheaf.stalk x) ≤ d →
          ∃ g : X.PartialMap G.left, g.hom ≫ G.hom = g.domain.ι ∧ g.equiv f ∧ x ∈ g.domain := by
  induction d using Nat.strong_induction_on with
  | _ d ih =>
  intro X _ _ hreg G _ _ f hf x hx
  classical
  let ι := X.fromSpecStalk x
  have : IsRegularLocalRing (X.presheaf.stalk x) := IsRegular.isRegularLocalRing_stalk hreg x
  let : X.Over X := ⟨𝟙 X⟩
  let : G.left.Over X := ⟨G.hom⟩
  have : IsSeparated (G.left ↘ X) := inferInstanceAs (IsSeparated G.hom)
  let M := (Over.pullback ι).mapGrp.obj (.mk G)
  have : IsProper M.X.hom := inferInstanceAs (IsProper (pullback.snd G.hom ι))
  let fstG : M.X.left ⟶ G.left := pullback.fst G.hom ι
  have hcond : fstG ≫ G.hom = M.X.hom ≫ ι := pullback.condition
  have hfst : ∀ s : Spec (X.presheaf.stalk x) ⟶ M.X.left, s ≫ M.X.hom = 𝟙 _ →
      (s ≫ fstG) ≫ G.hom = ι := by
    intro s hs
    rw [Category.assoc, hcond, ← Category.assoc, hs, Category.id_comp]
  by_cases h2 : ringKrullDim (X.presheaf.stalk x) ≤ 2
  · have hd := dense_preimage_fromSpecStalk x f.domain f.dense_domain
    let h := pullbackPartialSection G ι f hf hd
    have hh : h.hom ≫ M.X.hom = h.domain.ι := pullbackPartialSection_hom_snd G ι f hf hd
    have htfae := IsLocalRing.isRegularRing_tfae (R := X.presheaf.stalk x)
    have : IsRegularRing (X.presheaf.stalk x) := (htfae.out 1 3).mp ‹_›
    have hregS : IsRegular (Spec (X.presheaf.stalk x)) :=
      Stacks.isRegular_spec_of_isRegularRing (X.presheaf.stalk x)
    have hdimS : topologicalKrullDim (Spec (X.presheaf.stalk x)) ≤ 2 :=
      (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim (R := X.presheaf.stalk x)).trans_le h2
    have hηS : genericPoint (Spec (X.presheaf.stalk x)) ∈ h.domain :=
      (genericPoint_specializes _).mem_open h.domain.2 h.dense_domain.nonempty.choose_spec
    have hσ : h.fromFunctionField ≫ M.X.hom =
        (Spec (X.presheaf.stalk x)).fromSpecStalk (genericPoint _) := by
      change h.domain.fromSpecStalkOfMem _ _ ≫ h.hom ≫ M.X.hom = _
      rw [hh, Scheme.Opens.fromSpecStalkOfMem_ι]
    obtain ⟨s, hs1, hs2⟩ := exists_section_extending_of_isRegular (Spec (X.presheaf.stalk x))
      hregS hdimS M.X h.fromFunctionField hσ
    have hs3 : h.domain.ι ≫ s = h.hom := by
      let S := Spec (X.presheaf.stalk x)
      let : S.Over S := ⟨𝟙 S⟩
      let : M.X.left.Over S := ⟨M.X.hom⟩
      have : IsSeparated (M.X.left ↘ S) := inferInstanceAs (IsSeparated M.X.hom)
      let h' : S.PartialMap M.X.left := h
      have : h'.IsOver S := ⟨hh.trans (Category.comp_id _).symm⟩
      have : s.IsOver S := ⟨hs1⟩
      have heq : h'.equiv s.toPartialMap :=
        Scheme.PartialMap.equiv_of_fromSpecStalkOfMem_eq h' s.toPartialMap hηS trivial
          (by rw [Scheme.PartialMap.fromSpecStalkOfMem_toPartialMap, hs2]; rfl)
      exact ((Scheme.PartialMap.equiv_toPartialMap_iff_of_isSeparated (S := S)).mp heq).symm
    exact exists_equiv_mem_domain_of_fromSpecStalk G f x (s ≫ fstG) (hfst s hs1)
      (specMap_comp_fst_eq_fromFunctionField G f hf x hd s hs3)
  · have h3 : (3 : WithBot ℕ∞) ≤ ringKrullDim (X.presheaf.stalk x) := three_le_of_not_le_two h2
    have hd3 : 3 ≤ d := by exact_mod_cast h3.trans hx
    have hP : ∀ z ∈ {z : X | z ⤳ x ∧ z ≠ x}, ∃ g : X.PartialMap G.left, g.IsOver X ∧
        g.equiv f ∧ z ∈ g.domain := by
      rintro z ⟨hzx, hne⟩
      obtain ⟨g, hg, hgf, hz⟩ := ih (d - 1) (by omega) X hreg G f hf z
        (le_natCast_sub_one_of_add_one_le (ringKrullDim_stalk_add_one_le_of_specializes hzx hne)
          hx)
      exact ⟨g, ⟨hg.trans (Category.comp_id _).symm⟩, hgf, hz⟩
    have : f.IsOver X := ⟨hf.trans (Category.comp_id _).symm⟩
    obtain ⟨g₀, hg₀o, hg₀f, hg₀P⟩ := PartialMap.exists_isOver_equiv_subset_domain (S := X) f _ hP
    have hg₀ : g₀.hom ≫ G.hom = g₀.domain.ι := hg₀o.comp_over.trans (Category.comp_id _)
    have hd := dense_preimage_fromSpecStalk x g₀.domain g₀.dense_domain
    let h := pullbackPartialSection G ι g₀ hg₀ hd
    have hh : h.hom ≫ M.X.hom = h.domain.ι := pullbackPartialSection_hom_snd G ι g₀ hg₀ hd
    have hdom : ∀ a : Spec (X.presheaf.stalk x), a ≠ closedPoint _ → a ∈ h.domain :=
      fun a ha => hg₀P (fromSpecStalk_specializes_and_ne x a ha)
    obtain ⟨s, hs1, hs3⟩ := exists_section_of_three_le_ringKrullDim h3 M.X h hh hdom
      (fun Y _ _ hY G' _ _ f' hf' y hy => ih (d - 1) (by omega) Y hY G' f' hf' y
        (le_natCast_sub_one_of_add_one_le hy hx))
    obtain ⟨g, hg, hgg₀, hxg⟩ := exists_equiv_mem_domain_of_fromSpecStalk G g₀ x
      (s ≫ fstG) (hfst s hs1)
      (specMap_comp_fst_eq_fromFunctionField G g₀ hg₀ x hd s hs3)
    exact ⟨g, hg, hgg₀.trans hg₀f, hxg⟩

/-- **A rational section of a proper group scheme over a regular scheme extends.** Let `X` be an
integral Noetherian regular scheme and let `G` be a proper group scheme over `X`. Every section
`σ` of `G` over the generic point of `X` is the restriction of a section of `G ⟶ X`.

The section spreads out to a partial section, which by
`AlgebraicGeometry.GroupScheme.exists_equiv_mem_domain_of_ringKrullDim_le` extends across every
point, the local rings of `X` having finite dimension; the extensions glue. -/
theorem exists_section_extending_of_regular (X : Scheme.{u}) [IsIntegral X] [IsNoetherian X]
    (hreg : IsRegular X) (G : Over X) [GrpObj G] [IsProper G.hom]
    (σ : Spec X.functionField ⟶ G.left) (hσ : σ ≫ G.hom = X.fromSpecStalk (genericPoint X)) :
    ∃ g : X ⟶ G.left, g ≫ G.hom = 𝟙 X ∧ X.fromSpecStalk (genericPoint X) ≫ g = σ := by
  have hσ' : σ ≫ G.hom = X.fromSpecStalk (genericPoint X) ≫ 𝟙 X := by rw [hσ, Category.comp_id]
  let f := Scheme.PartialMap.ofFromSpecStalk (𝟙 X) G.hom (x := genericPoint X) σ hσ'
  have hf : f.hom ≫ G.hom = f.domain.ι := by
    simpa using Scheme.PartialMap.ofFromSpecStalk_comp (𝟙 X) G.hom (x := genericPoint X) σ hσ'
  have hη := Scheme.PartialMap.mem_domain_ofFromSpecStalk (𝟙 X) G.hom (x := genericPoint X) σ hσ'
  have hσf : f.domain.fromSpecStalkOfMem _ hη ≫ f.hom = σ :=
    Scheme.PartialMap.fromSpecStalkOfMem_ofFromSpecStalk (𝟙 X) G.hom (x := genericPoint X) σ hσ'
  let : X.Over X := ⟨𝟙 X⟩
  let : G.left.Over X := ⟨G.hom⟩
  have : IsSeparated (G.left ↘ X) := inferInstanceAs (IsSeparated G.hom)
  have : f.IsOver X := ⟨hf.trans (Category.comp_id _).symm⟩
  obtain ⟨g', hg'o, hg'f, hg'⟩ := PartialMap.exists_isOver_equiv_subset_domain (S := X) f
    Set.univ fun x _ => by
      obtain ⟨d, hd⟩ := exists_ringKrullDim_le_natCast (X.presheaf.stalk x)
      obtain ⟨g, hg, hgf, hx⟩ := exists_equiv_mem_domain_of_ringKrullDim_le d X hreg G f hf x hd
      exact ⟨g, ⟨hg.trans (Category.comp_id _).symm⟩, hgf, hx⟩
  have htop : ⊤ ≤ g'.domain := fun x _ => hg' trivial
  have hfg' : f.domain ≤ g'.domain := le_top.trans htop
  have hg'1 : g'.hom ≫ G.hom = g'.domain.ι := hg'o.comp_over.trans (Category.comp_id _)
  have hres := (Scheme.PartialMap.equiv_iff_of_isSeparated_of_le (S := X) (f := g') (g := f)
    f.dense_domain hfg' le_rfl).mp hg'f
  simp only [Scheme.PartialMap.restrict_hom, Scheme.homOfLE_rfl, Category.id_comp] at hres
  have hg2 : f.domain.ι ≫ (X.topIso.inv ≫ X.homOfLE htop ≫ g'.hom) = f.hom := by
    rw [← hres]
    simp only [← Category.assoc]
    congr 1
    rw [← cancel_mono g'.domain.ι]
    simp [Scheme.homOfLE_ι, Scheme.toIso_inv_ι]
  refine ⟨X.topIso.inv ≫ X.homOfLE htop ≫ g'.hom, ?_, ?_⟩
  · rw [Category.assoc, Category.assoc, hg'1, Scheme.homOfLE_ι, Scheme.toIso_inv_ι]
  · rw [← Scheme.Opens.fromSpecStalkOfMem_ι f.domain _ hη, Category.assoc, hg2, hσf]

end AlgebraicGeometry.GroupScheme

