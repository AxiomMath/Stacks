module

public import StacksFrontier.AlgebraicGeometry.GroupScheme.OverField.LeftInvariantModel
public import StacksFrontier.AlgebraicGeometry.GroupScheme.OverField.RationalGroup

/-!
# The rational action of a group on an affine quotient model

Let `G` be a group scheme over a field `k`, `V` an open of `G`, `X` an affine `k`-scheme with
`G × X` integral, and `π : V ⟶ X` a morphism over `k`.  Let `p` be a point of
`W = G × V ∩ μ⁻¹ V ⊆ G × G` which `id × π` sends to the generic point of `G × X`; then `id × π`
maps the function field of `G × X` into the local ring of `G × G` at `p`
(`AlgebraicGeometry.GenericQuotientFlat.onePiStalk`).  If, for every global function `a` on `X`,
the germ at `p` of `(g, v) ↦ a (π (g v))` (`AlgebraicGeometry.GenericQuotientFlat.muPiGerm`)
lies in the image, then the `X`-valued point `φ` of `G × X` over its generic point which
describes the left action exists, together with the data `σ` of
`AlgebraicGeometry.GenericQuotientFlat.exists_open_flatAt_of_functionFieldAction`.

## Main results

* `AlgebraicGeometry.GenericQuotientFlat.exists_functionFieldAction_of_mem_range`: if the germs
  of `π ∘ μ` at `p` lie in the image of the function field of `G × X`, the data `φ, σ` exist.
* `AlgebraicGeometry.GenericQuotientFlat.exists_localRationalAction_of_leftInvariant`: if a
  left-invariant subfield `K₁` of `K(G)` (Perrin's approximation,
  `AlgebraicGeometry.GenericQuotientFlat.exists_fg_leftInvariant_functionField`) is generated by
  finitely many pullbacks along `π` and contains all of them, there is a rational map `F` on
  `G × X` with `F (a, π v) = π (a v)`, used for flatness.
* `AlgebraicGeometry.GenericQuotientFlat.onePi_genericPoint`: `id × π` sends the generic point of
  `G × G` to the generic point of `G × X` when `π` is dominant.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits CartesianMonoidalCategory MonoidalCategory
open scoped CategoryTheory.MonObj

universe u

namespace AlgebraicGeometry.GenericQuotientFlat

/-- The generic point of an irreducible scheme lies in every nonempty open. -/
lemma genericPoint_mem_of_nonempty {X : Scheme.{u}} [IrreducibleSpace X] (U : X.Opens)
    (hU : (U : Set X).Nonempty) : genericPoint X ∈ U :=
  ((genericPoint_spec X).mem_open_set_iff U.2).mpr (by simpa using hU)

/-- The inverse of an injective ring map on the image of a ring map landing in its range. -/
noncomputable def preimageHom {A R S : Type*} [CommRing A] [CommRing R] [CommRing S]
    (ρ : R →+* S) (hρ : Function.Injective ρ) (m : A →+* S) (h : ∀ a, m a ∈ ρ.range) :
    A →+* R :=
  ((RingEquiv.ofBijective ρ.rangeRestrict
    ⟨fun _ _ hxy => hρ (congrArg Subtype.val hxy), ρ.rangeRestrict_surjective⟩).symm :
      ρ.range →+* R).comp (m.codRestrict ρ.range h)

/-- Composing `preimageHom ρ hρ m h` with `ρ` recovers `m`. -/
lemma preimageHom_comp {A R S : Type*} [CommRing A] [CommRing R] [CommRing S]
    (ρ : R →+* S) (hρ : Function.Injective ρ) (m : A →+* S) (h : ∀ a, m a ∈ ρ.range) :
    ρ.comp (preimageHom ρ hρ m h) = m := by
  ext a
  let e := RingEquiv.ofBijective ρ.rangeRestrict
    ⟨fun x y hxy => hρ (congrArg Subtype.val hxy), ρ.rangeRestrict_surjective⟩
  have : ρ (e.symm (m.codRestrict ρ.range h a)) = (e (e.symm (m.codRestrict ρ.range h a)) : S) :=
    rfl
  rw [RingEquiv.apply_symm_apply] at this
  exact this

section Model

variable {k : Type u} [Field k] (G : Over (Spec (.of k))) [GrpObj G]

variable (V : G.left.Opens)

/-- The generic point of `G × G` lies in the preimage of a nonempty `V` under any `f : G × G ⟶ G`
which restricts to the identity along `a ↦ (1, a)`. -/
private lemma genericPoint_mem_preimage_of_lift_comp [IsAlgClosed k] [IsIntegral G.left]
    (f : G ⊗ G ⟶ G) (hf : lift (toUnit G ≫ η[G]) (𝟙 G) ≫ f = 𝟙 G)
    (hV : (V : Set G.left).Nonempty) : genericPoint (G ⊗ G).left ∈ f.left ⁻¹ᵁ V := by
  obtain ⟨v, hv⟩ := hV
  refine genericPoint_mem_of_nonempty _ ⟨(lift (toUnit G ≫ η[G]) (𝟙 G)).left v, ?_⟩
  change ((lift (toUnit G ≫ η[G]) (𝟙 G)).left ≫ f.left) v ∈ V
  rw [← Over.comp_left, hf]
  exact hv

/-- The generic point of `G × G` lies in `G × V` when `V` is nonempty. -/
lemma genericPoint_mem_EV [IsAlgClosed k] [IsIntegral G.left] (hV : (V : Set G.left).Nonempty) :
    genericPoint (G ⊗ G).left ∈ EV G V :=
  genericPoint_mem_preimage_of_lift_comp G V _ (lift_snd _ _) hV

/-- The generic point of `G × G` lies in `μ⁻¹ V` when `V` is nonempty. -/
lemma genericPoint_mem_mu [IsAlgClosed k] [IsIntegral G.left] (hV : (V : Set G.left).Nonempty) :
    genericPoint (G ⊗ G).left ∈ μ[G].left ⁻¹ᵁ V :=
  genericPoint_mem_preimage_of_lift_comp G V μ[G] (MonObj.lift_comp_one_left _ _) hV

variable (X : Over (Spec (.of k)))

/-- A morphism to an irreducible scheme whose range contains the generic point is dominant. -/
lemma isDominant_of_apply_eq_genericPoint {Y Z : Scheme.{u}} [IrreducibleSpace Z] (f : Y ⟶ Z)
    (y : Y) (hy : f y = genericPoint Z) : IsDominant f := by
  refine ⟨dense_iff_closure_eq.mpr (Set.eq_univ_of_univ_subset ?_)⟩
  rw [← (genericPoint_spec Z).def]
  exact closure_mono (Set.singleton_subset_iff.mpr ⟨y, hy⟩)

omit [GrpObj G] in
/-- `id × π : G × V ⟶ G × X` is dominant when `π` is. -/
lemma isDominant_onePi [IsAlgClosed k] [IsIntegral G.left] [IsIntegral X.left]
    (π : V.toScheme ⟶ X.left) (hπ : π ≫ X.hom = V.ι ≫ G.hom) [IsDominant π] [Nonempty V] :
    IsDominant (onePi G X V π hπ) := by
  have : IsIntegral (pullback G.hom X.hom : Scheme.{u}) :=
    isIntegral_pullback_of_isAlgClosed G.hom X.hom
  have : IsIntegral (pullback G.hom (π ≫ X.hom) : Scheme.{u}) :=
    isIntegral_pullback_of_isAlgClosed _ _
  have hπgen : π (genericPoint V) = genericPoint X.left := map_genericPoint_of_isDominant π
  have hmem : genericPoint (G ⊗ X).left ∈ Set.range (prodMap G X V π) := by
    rw [range_prodMap]
    have : Surjective (pullback.snd G.hom X.hom) := inferInstance
    refine ⟨genericPoint V, ?_⟩
    rw [hπgen]
    exact (map_genericPoint_of_isDominant (pullback.snd G.hom X.hom)).symm
  obtain ⟨y, hy⟩ := hmem
  have : IsDominant (prodMap G X V π) := isDominant_of_apply_eq_genericPoint _ y hy
  have h : onePi G X V π hπ = (prodIso G X V π hπ).inv ≫ prodMap G X V π := by
    rw [← prodIso_onePi, Iso.inv_hom_id_assoc]
  rw [h]
  infer_instance

omit [GrpObj G] in
/-- `id × π` sends the generic point of `G × G` to the generic point of `G × X`. -/
lemma onePi_genericPoint [IsAlgClosed k] [IsIntegral G.left] [IsIntegral X.left]
    (π : V.toScheme ⟶ X.left) (hπ : π ≫ X.hom = V.ι ≫ G.hom) [IsDominant π]
    (hθE : genericPoint (G ⊗ G).left ∈ EV G V) :
    onePi G X V π hπ ⟨_, hθE⟩ = genericPoint (G ⊗ X).left := by
  have : Nonempty V := ⟨⟨(snd G G).left (genericPoint (G ⊗ G).left), hθE⟩⟩
  have : IsIntegral (pullback G.hom X.hom : Scheme.{u}) :=
    isIntegral_pullback_of_isAlgClosed G.hom X.hom
  have : IsIntegral (G ⊗ X).left := isIntegral_pullback_of_isAlgClosed G.hom X.hom
  have : IsIntegral (G ⊗ G).left := isIntegral_pullback_of_isAlgClosed G.hom G.hom
  have : Nonempty (EV G V) := ⟨⟨_, hθE⟩⟩
  have := isDominant_onePi G V X π hπ
  have hgen : (⟨_, hθE⟩ : (EV G V).toScheme) = genericPoint (EV G V).toScheme :=
    Subtype.ext (genericPoint_eq_of_isOpenImmersion (EV G V).ι).symm
  rw [hgen]
  exact map_genericPoint_of_isDominant _

/-- The open `G × V ∩ μ⁻¹ V` of `G × G`. -/
noncomputable abbrev EVμ : (G ⊗ G).left.Opens := EV G V ⊓ μ[G].left ⁻¹ᵁ V

/-- `(a, v) ↦ a v : G × V ∩ μ⁻¹ V ⟶ V`. -/
noncomputable abbrev muV : (EVμ G V).toScheme ⟶ V.toScheme :=
  IsOpenImmersion.lift V.ι ((EVμ G V).ι ≫ μ[G].left) (range_ι_comp_subset _ inf_le_right)

/-- If `id × π` sends a point `p` of `G × V ∩ μ⁻¹ V` to `z`, then so does the composite of the
inclusion `G × V ∩ μ⁻¹ V ⊆ G × V` with `id × π`. -/
lemma homOfLE_onePi_apply (π : V.toScheme ⟶ X.left) (hπ : π ≫ X.hom = V.ι ≫ G.hom)
    (p : (EVμ G V).toScheme) (z : (G ⊗ X).left)
    (hθgen : onePi G X V π hπ ⟨p.1, p.2.1⟩ = z) :
    ((G ⊗ G).left.homOfLE (inf_le_left : EVμ G V ≤ EV G V) ≫ onePi G X V π hπ) p = z := by
  have : (G ⊗ G).left.homOfLE (inf_le_left : EVμ G V ≤ EV G V) p = ⟨p.1, p.2.1⟩ :=
    Subtype.ext (Scheme.homOfLE_apply _ p)
  rw [Scheme.Hom.comp_apply, this]
  exact hθgen

/-- `id × π`, restricted to `G × V ∩ μ⁻¹ V`, on local rings at a point `p` over a point `z`. -/
noncomputable abbrev onePiStalk (π : V.toScheme ⟶ X.left) (hπ : π ≫ X.hom = V.ι ≫ G.hom)
    (p : (EVμ G V).toScheme) (z : (G ⊗ X).left)
    (hθgen : onePi G X V π hπ ⟨p.1, p.2.1⟩ = z) :
    (G ⊗ X).left.presheaf.stalk z ⟶ (EVμ G V).toScheme.presheaf.stalk p :=
  ((G ⊗ G).left.homOfLE inf_le_left ≫ onePi G X V π hπ).stalkMapOfEq p z
    (homOfLE_onePi_apply G V X π hπ p z hθgen)

/-- `π ∘ μ` on local rings at `p`, evaluated on global sections of `X`. -/
noncomputable abbrev muPiGerm (π : V.toScheme ⟶ X.left) (p : (EVμ G V).toScheme) :
    Γ(X.left, ⊤) ⟶ (EVμ G V).toScheme.presheaf.stalk p :=
  (muV G V ≫ π).appTop ≫ (EVμ G V).toScheme.presheaf.germ ⊤ p trivial

omit [GrpObj G] in
/-- `id × π : G × V ⟶ G × X` is a morphism over `k`. -/
lemma onePi_comp_hom (π : V.toScheme ⟶ X.left) (hπ : π ≫ X.hom = V.ι ≫ G.hom) :
    onePi G X V π hπ ≫ (G ⊗ X).hom = (EV G V).ι ≫ (G ⊗ G).hom := by
  rw [← Over.w (fst G X), reassoc_of% onePi_fst, Over.w (fst G G)]

/-- `π ∘ μ : G × V ∩ μ⁻¹ V ⟶ X` is a morphism over `k`. -/
lemma muV_comp_hom (π : V.toScheme ⟶ X.left) (hπ : π ≫ X.hom = V.ι ≫ G.hom) :
    muV G V ≫ π ≫ X.hom = (EVμ G V).ι ≫ (G ⊗ G).hom := by
  rw [hπ, IsOpenImmersion.lift_fac_assoc, Category.assoc, Over.w μ[G]]

/-- **The rational action on an affine model.**  If every `a ∈ Γ(X)` pulls back along `π ∘ μ` to
a germ at `p` which comes from the function field of `G × X` along `id × π`, then the data `φ, σ`
of `AlgebraicGeometry.GenericQuotientFlat.exists_open_flatAt_of_functionFieldAction` exist. -/
theorem exists_functionFieldAction_of_mem_range [IsIntegral (G ⊗ X).left] [IsAffine X.left]
    (π : V.toScheme ⟶ X.left) (hπ : π ≫ X.hom = V.ι ≫ G.hom)
    (p : (EVμ G V).toScheme)
    (hθgen : onePi G X V π hπ ⟨p.1, p.2.1⟩ = genericPoint (G ⊗ X).left)
    (hrange : ∀ a : Γ(X.left, ⊤), (muPiGerm G V X π p).hom a ∈
      (onePiStalk G V X π hπ p _ hθgen).hom.range) :
    ∃ (φ : Spec (G ⊗ X).left.functionField ⟶ X.left)
      (_ : φ ≫ X.hom = (G ⊗ X).left.fromSpecStalk _ ≫ (G ⊗ X).hom)
      (σ : Spec ((G ⊗ G).left.presheaf.stalk p.1) ⟶ Spec (G ⊗ X).left.functionField)
      (_ : (EV G V).fromSpecStalkOfMem p.1 p.2.1 ≫ onePi G X V π hπ =
        σ ≫ (G ⊗ X).left.fromSpecStalk _),
      σ ≫ φ = (EV G V ⊓ μ[G].left ⁻¹ᵁ V).fromSpecStalkOfMem p.1 p.2 ≫
        IsOpenImmersion.lift V.ι ((EV G V ⊓ μ[G].left ⁻¹ᵁ V).ι ≫ μ[G].left)
          (range_ι_comp_subset _ inf_le_right) ≫ π := by
  let ιW := onePiStalk G V X π hπ p _ hθgen
  have hinj : Function.Injective ιW.hom := ιW.hom.injective
  let ψ : Γ(X.left, ⊤) ⟶ (G ⊗ X).left.functionField :=
    CommRingCat.ofHom (preimageHom ιW.hom hinj (muPiGerm G V X π p).hom hrange)
  have hψ : ψ ≫ ιW = muPiGerm G V X π p := by
    ext1
    exact preimageHom_comp ιW.hom hinj _ hrange
  have hiso : IsIso ((EVμ G V).ι.stalkMap p) := inferInstance
  have : Mono ιW := ConcreteCategory.mono_of_injective _ hinj
  let σ : Spec ((G ⊗ G).left.presheaf.stalk p.1) ⟶ Spec (G ⊗ X).left.functionField :=
    Spec.map (ιW ≫ @inv _ _ _ _ ((EVμ G V).ι.stalkMap p) hiso)
  have hfsm : (EVμ G V).fromSpecStalkOfMem p.1 p.2 =
      Spec.map (inv ((EVμ G V).ι.stalkMap p)) ≫ (EVμ G V).toScheme.fromSpecStalk p := rfl
  refine ⟨Spec.map ψ ≫ X.left.isoSpec.inv, ?_, σ, ?_, ?_⟩
  · -- compatibility with the structure morphisms
    rw [← cancel_mono (Spec (.of k)).isoSpec.hom]
    simp only [Category.assoc, Scheme.isoSpec_hom, Scheme.toSpecΓ_naturality]
    rw [← Scheme.isoSpec_hom, Iso.inv_hom_id_assoc, Scheme.fromSpecStalk_toSpecΓ_assoc,
      ← Spec.map_comp, ← Spec.map_comp]
    congr 1
    have e1 : (muV G V ≫ π) ≫ X.hom =
        ((G ⊗ G).left.homOfLE inf_le_left ≫ onePi G X V π hπ) ≫ (G ⊗ X).hom := by
      rw [Category.assoc, muV_comp_hom G V X π hπ, Category.assoc, onePi_comp_hom G V X π hπ,
        ← Category.assoc, Scheme.homOfLE_ι]
    rw [← cancel_mono ιW, Category.assoc, hψ, Category.assoc, Scheme.Hom.germ_stalkMapOfEq,
      ← Scheme.Hom.comp_appTop_assoc, ← Scheme.Hom.comp_appTop_assoc, e1]
  · rw [← fromSpecStalkOfMem_homOfLE (inf_le_left : EVμ G V ≤ EV G V) p.1 p.2]
    refine (Category.assoc _ _ _).trans ?_
    refine (congrArg (· ≫ _) hfsm).trans ?_
    refine (Category.assoc _ _ _).trans ?_
    refine (congrArg (Spec.map _ ≫ ·) (SpecMap_stalkMapOfEq_fromSpecStalk _ _ _
      (homOfLE_onePi_apply G V X π hπ p _ hθgen)).symm).trans ?_
    refine (Category.assoc _ _ _).symm.trans ?_
    exact congrArg (· ≫ _) (Spec.map_comp _ _).symm
  · rw [← cancel_mono X.left.isoSpec.hom, Category.assoc, Category.assoc, Iso.inv_hom_id,
      Category.comp_id]
    have h3 : π ≫ X.left.isoSpec.hom =
        V.toScheme.toSpecΓ ≫ Spec.map π.appTop := by
      rw [Scheme.isoSpec_hom, Scheme.toSpecΓ_naturality]
    have h4 : muV G V ≫ V.toScheme.toSpecΓ =
        (EVμ G V).toScheme.toSpecΓ ≫ Spec.map (muV G V).appTop :=
      Scheme.toSpecΓ_naturality _
    have key : σ ≫ Spec.map ψ = Spec.map (inv ((EVμ G V).ι.stalkMap p)) ≫
        (EVμ G V).toScheme.fromSpecStalk p ≫ muV G V ≫ π ≫ X.left.isoSpec.hom := by
      rw [h3, reassoc_of% h4, Scheme.fromSpecStalk_toSpecΓ_assoc]
      simp only [σ, ← Spec.map_comp]
      congr 1
      rw [reassoc_of% hψ]
      simp only [Scheme.Hom.comp_appTop, Category.assoc]
      rfl
    exact key.trans ((Category.assoc _ _ _).symm.trans
      (congrArg (· ≫ (muV G V ≫ π ≫ X.left.isoSpec.hom)) hfsm.symm))

omit [GrpObj G] in
/-- The map on local rings along an equality of points is compatible with germs on any open. -/
lemma germ_stalkMapOfEq_of_mem {Y Z : Scheme.{u}} (g : Y ⟶ Z) (U : Z.Opens) (y : Y) (z : Z)
    (h : g y = z) (hz : z ∈ U) :
    Z.presheaf.germ U z hz ≫ g.stalkMapOfEq y z h =
      g.app U ≫ Y.presheaf.germ (g ⁻¹ᵁ U) y (show g y ∈ U from h ▸ hz) := by
  subst h
  rw [Scheme.Hom.stalkMapOfEq, stalkCongr_hom_self, Category.id_comp]
  exact g.germ_stalkMap U y hz

/-- The germ at the generic point of `G` of the pullback along `π : V ⟶ X` of a global function on
`X`. -/
noncomputable abbrev pullbackGerm [IsIntegral G.left] (hgV : genericPoint G.left ∈ V)
    (π : V.toScheme ⟶ X.left)
    (φ : Γ(X.left, ⊤)) : G.left.functionField :=
  G.left.presheaf.germ V (genericPoint G.left) hgV (V.topIso.hom (π.appTop φ))

omit [GrpObj G] in
/-- In the function field of `V`, the restriction of `pullbackGerm G V X hgV π φ` is the pullback
along `π` of the germ of `φ` at the generic point of `X`. -/
lemma functionFieldMap_ι_pullbackGerm [IsIntegral G.left] [IsIntegral X.left]
    (hgV : genericPoint G.left ∈ V) (π : V.toScheme ⟶ X.left) [IsDominant π] [IsIntegral V]
    [IsDominant V.ι] (φ : Γ(X.left, ⊤)) :
    functionFieldMap V.ι (pullbackGerm G V X hgV π φ) =
      functionFieldMap π (X.left.presheaf.germ ⊤ (genericPoint X.left) trivial φ) := by
  have h1 := germ_stalkMapOfEq_of_mem V.ι V (genericPoint V) (genericPoint G.left)
    (map_genericPoint_of_isDominant V.ι) hgV
  have h2 := Scheme.Hom.germ_stalkMapOfEq π (genericPoint V) (genericPoint X.left)
    (map_genericPoint_of_isDominant π)
  show (G.left.presheaf.germ V _ hgV ≫ V.ι.stalkMapOfEq _ _
      (map_genericPoint_of_isDominant V.ι)).hom (V.topIso.hom _) =
    (X.left.presheaf.germ ⊤ _ trivial ≫ π.stalkMapOfEq _ _
      (map_genericPoint_of_isDominant π)).hom φ
  rw [h1, h2, CommRingCat.comp_apply, CommRingCat.comp_apply]
  have e : V.topIso.hom ≫ V.ι.app V =
      V.toScheme.presheaf.map (homOfLE (le_top : V.ι ⁻¹ᵁ V ≤ ⊤)).op := by
    rw [Scheme.Opens.topIso_hom, Scheme.Opens.ι_app, Scheme.Opens.toScheme_presheaf_map]
    exact (G.left.presheaf.map_comp _ _).symm
  have h0 : genericPoint V ∈ V.ι ⁻¹ᵁ V := (genericPoint V).2
  have h3 := congrArg (fun f => (V.toScheme.presheaf.germ (V.ι ⁻¹ᵁ V) (genericPoint V) h0).hom
    (f.hom (π.appTop φ))) e
  exact h3.trans (V.toScheme.presheaf.germ_res_apply _ _ _ _)

end Model

section Bridge

open TensorProduct.RationalGroup

attribute [local instance] functionFieldAlgebra

variable {k : Type u} [Field k] [IsAlgClosed k] (G X : Over (Spec (.of k))) [GrpObj G]
  [IsIntegral G.left] [IsIntegral X.left]

omit [IsAlgClosed k] [GrpObj G] in
/-- Rational functions in a subfield generated by pullbacks along `π` restrict to `V` as pullbacks
of rational functions on `X`. -/
lemma functionFieldMap_ι_mem_range_of_le_adjoin (V : G.left.Opens) [Nonempty V]
    (hgV : genericPoint G.left ∈ V) (π : V.toScheme ⟶ X.left) (hπ : π ≫ X.hom = V.ι ≫ G.hom)
    [IsDominant π] [IsDominant V.ι] (K₁ : IntermediateField k G.left.functionField)
    (t : Finset G.left.functionField)
    (htK₁ : K₁ ≤ IntermediateField.adjoin k (t : Set G.left.functionField))
    (ht : ∀ x ∈ t, ∃ φ : Γ(X.left, ⊤), G.left.presheaf.germ V (genericPoint G.left) hgV
      (V.topIso.hom (π.appTop φ)) = x) :
    ∀ b ∈ K₁, functionFieldMap V.ι b ∈ (functionFieldMap π).fieldRange := by
  let S₀ : Subfield G.left.functionField :=
    (functionFieldMap π).fieldRange.comap (functionFieldMap V.ι)
  have halg : ∀ r : k, algebraMap k G.left.functionField r ∈ S₀ := fun r =>
    ⟨(stalkAlgebraOver k X.hom (genericPoint X.left)).algebraMap r, by
      rw [functionFieldMap_stalkAlgebraOver_algebraMap k X.hom π _ rfl]
      show _ = functionFieldMap V.ι
        ((stalkAlgebraOver k G.hom (genericPoint G.left)).algebraMap r)
      rw [functionFieldMap_stalkAlgebraOver_algebraMap k G.hom V.ι _ rfl, hπ]⟩
  let S : IntermediateField k G.left.functionField := S₀.toIntermediateField halg
  have htS : (t : Set G.left.functionField) ⊆ S := by
    intro x hx
    obtain ⟨φ, rfl⟩ := ht x hx
    exact ⟨_, (functionFieldMap_ι_pullbackGerm G V X hgV π φ).symm⟩
  exact fun b hb ↦ IntermediateField.adjoin_le_iff.mpr htS (htK₁ hb)

/-- **Rational action from left invariance.**  Let `π : V ⟶ X` be a dominant morphism from an
open of an integral group scheme `G` over an algebraically closed field to an integral affine
`k`-scheme of finite type, and `K₁ ⊆ K(G)` a left-invariant subfield
(`Δ(K₁) ⊆ Frac(K₁ ⊗[k] K(G))`, e.g. from `exists_fg_leftInvariant_functionField`) generated by
finitely many pullbacks `π^* φ` and containing all of them.  Then `π (a v)` is a rational function
of `(a, π v)`: there are `F` on a dense open `D` of `G × X` and a dense open `U` of `G × G` with
`F (a, π v) = π (a v)` on `U`. -/
theorem exists_localRationalAction_of_leftInvariant [IsAffine X.left] [LocallyOfFiniteType X.hom]
    (V : G.left.Opens) (hgV : genericPoint G.left ∈ V) (π : V.toScheme ⟶ X.left)
    (hπ : π ≫ X.hom = V.ι ≫ G.hom) [IsDominant π] (K₁ : IntermediateField k G.left.functionField)
    (hK₁ : ∀ y ∈ K₁, functionFieldComul G y ∈
      Set.range (TensorProduct.fractionRingMap G.left.functionField K₁.val))
    (t : Finset G.left.functionField)
    (htK₁ : K₁ ≤ IntermediateField.adjoin k (t : Set G.left.functionField))
    (ht : ∀ x ∈ t, ∃ φ : Γ(X.left, ⊤), G.left.presheaf.germ V (genericPoint G.left) hgV
      (V.topIso.hom (π.appTop φ)) = x)
    (hπK₁ : ∀ φ : Γ(X.left, ⊤), G.left.presheaf.germ V (genericPoint G.left) hgV
      (V.topIso.hom (π.appTop φ)) ∈ K₁) :
    ∃ (D : (G ⊗ X).left.Opens) (F : D.toScheme ⟶ X.left)
      (_ : F ≫ X.hom = D.ι ≫ (G ⊗ X).hom) (U : (G ⊗ G).left.Opens)
      (hU : U ≤ canonicalDomain G X V π hπ D), Dense (U : Set (G ⊗ G).left) ∧
      (G ⊗ G).left.homOfLE hU ≫ IsOpenImmersion.lift D.ι _
          (canonicalDomain_range G X V π hπ D) ≫ F =
        (G ⊗ G).left.homOfLE hU ≫ IsOpenImmersion.lift V.ι
          ((canonicalDomain G X V π hπ D).ι ≫ μ[G].left)
          (range_ι_comp_subset _ (canonicalDomain_le_mu G X V π hπ D)) ≫ π := by
  have hV : (V : Set G.left).Nonempty := ⟨_, hgV⟩
  have : Nonempty V := ⟨⟨_, hgV⟩⟩
  have : IsDominant V.ι := Opens.isDominant_ι (V.2.dense hV)
  have hθE := genericPoint_mem_EV G V hV
  have hθμ := genericPoint_mem_mu G V hV
  have hWne : ((EVμ G V : (G ⊗ G).left.Opens) : Set (G ⊗ G).left).Nonempty :=
    ⟨_, hθE, hθμ⟩
  have : Nonempty (EVμ G V) := ⟨⟨_, hθE, hθμ⟩⟩
  have hWd : Dense ((EVμ G V : (G ⊗ G).left.Opens) : Set (G ⊗ G).left) := (EVμ G V).2.dense hWne
  have : IsDominant (EVμ G V).ι := Opens.isDominant_ι hWd
  have : IsDominant ((G ⊗ G).left.homOfLE (inf_le_left : EVμ G V ≤ EV G V)) :=
    Opens.isDominant_homOfLE hWd _
  have := isDominant_onePi G V X π hπ
  let f₁ := (G ⊗ G).left.homOfLE (inf_le_left : EVμ G V ≤ EV G V) ≫ onePi G X V π hπ
  let p := genericPoint (EVμ G V).toScheme
  have hθgen : onePi G X V π hπ ⟨p.1, p.2.1⟩ = genericPoint (G ⊗ X).left := by
    have h := map_genericPoint_of_isDominant f₁
    have e : (G ⊗ G).left.homOfLE (inf_le_left : EVμ G V ≤ EV G V) p = ⟨p.1, p.2.1⟩ :=
      Subtype.ext (Scheme.homOfLE_apply _ p)
    rwa [Scheme.Hom.comp_apply, e] at h
  -- the subfield of `K(G × G)` coming from `K(G × X)` along `id × π`
  let R : Subfield (G ⊗ G).left.functionField :=
    (functionFieldMap f₁).fieldRange.comap (functionFieldMap (EVμ G V).ι)
  have : IsDominant (fst G X).left := inferInstanceAs (IsDominant (pullback.fst G.hom X.hom))
  have : IsDominant (snd G X).left := inferInstanceAs (IsDominant (pullback.snd G.hom X.hom))
  have h₁ : ∀ c, functionFieldMap (fst G G).left c ∈ R := by
    intro c
    refine ⟨functionFieldMap (fst G X).left c, ?_⟩
    have hc : f₁ ≫ (fst G X).left = (EVμ G V).ι ≫ (fst G G).left := by
      rw [Category.assoc, onePi_fst, ← Category.assoc, Scheme.homOfLE_ι]
    rw [functionFieldMap_comp_apply _ _ hc,
      functionFieldMap_comp_apply _ _ (rfl : (EVμ G V).ι ≫ (fst G G).left = _)]
  -- the restriction `G × V ∩ μ⁻¹ V ⟶ V` of the second projection
  let r := (G ⊗ G).left.homOfLE (inf_le_left : EVμ G V ≤ EV G V) ≫
    (snd G G).left.resLE V (EV G V) le_rfl
  have hr : r ≫ V.ι = (EVμ G V).ι ≫ (snd G G).left := by
    rw [Category.assoc, Scheme.Hom.resLE_comp_ι, ← Category.assoc, Scheme.homOfLE_ι]
  have : IsDominant (r ≫ V.ι) := by rw [hr]; infer_instance
  have : IsDominant r := IsDominant.of_comp_of_isOpenImmersion (g := V.ι) _
  have hK₁π := functionFieldMap_ι_mem_range_of_le_adjoin G X V hgV π hπ K₁ t htK₁ ht
  have h₂ : ∀ b ∈ K₁, functionFieldMap (snd G G).left b ∈ R := by
    intro b hb
    obtain ⟨z, hz⟩ := hK₁π b hb
    refine ⟨functionFieldMap (snd G X).left z, ?_⟩
    have hc : f₁ ≫ (snd G X).left = r ≫ π := by
      rw [Category.assoc, onePi_snd, ← Category.assoc]
    rw [functionFieldMap_comp_apply _ _ hc, ← functionFieldMap_comp_apply r π rfl, hz,
      functionFieldMap_comp_apply r V.ι rfl, functionFieldMap_comp_apply _ _ hr.symm]
  have hμ := functionFieldMap_mu_mem_of_leftInvariant G K₁ hK₁ R h₁ h₂
  -- the range condition of `exists_functionFieldAction_of_mem_range`
  have : IsDominant (muV G V ≫ V.ι) := by
    rw [IsOpenImmersion.lift_fac]; infer_instance
  have : IsDominant (muV G V) := IsDominant.of_comp_of_isOpenImmersion (g := V.ι) _
  have : IsIntegral (pullback G.hom X.hom : Scheme.{u}) :=
    isIntegral_pullback_of_isAlgClosed G.hom X.hom
  have : IsIntegral (G ⊗ X).left := this
  have hrange : ∀ a : Γ(X.left, ⊤), (muPiGerm G V X π p).hom a ∈
      (onePiStalk G V X π hπ p _ hθgen).hom.range := by
    intro a
    obtain ⟨z, hz⟩ := hμ _ (hπK₁ a)
    refine ⟨z, ?_⟩
    show functionFieldMap f₁ z = _
    rw [hz]
    have e1 : (muPiGerm G V X π p).hom a = functionFieldMap (muV G V ≫ π)
        (X.left.presheaf.germ ⊤ (genericPoint X.left) trivial a) := by
      have := Scheme.Hom.germ_stalkMapOfEq (muV G V ≫ π) p (genericPoint X.left)
        (map_genericPoint_of_isDominant _)
      exact (congrArg (fun g => g.hom a) this).symm
    rw [e1, ← functionFieldMap_comp_apply (muV G V) π rfl,
      ← functionFieldMap_ι_pullbackGerm G V X hgV π a, functionFieldMap_comp_apply _ _ rfl,
      functionFieldMap_comp_apply (muV G V) V.ι
        (IsOpenImmersion.lift_fac V.ι ((EVμ G V).ι ≫ μ[G].left) _)]
  obtain ⟨φ, hφ, σ, hσ, hLI⟩ :=
    exists_functionFieldAction_of_mem_range G V X π hπ p hθgen hrange
  exact exists_localRationalAction_of_functionFieldAction G X V π hπ φ hφ p.1 p.2.1 p.2.2 hθgen
    σ hσ hLI

end Bridge

end AlgebraicGeometry.GenericQuotientFlat

