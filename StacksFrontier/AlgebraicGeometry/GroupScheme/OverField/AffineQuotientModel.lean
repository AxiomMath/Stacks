module

public import Mathlib.AlgebraicGeometry.FunctionField
public import Mathlib.AlgebraicGeometry.Morphisms.FiniteType
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
public import StacksFrontier.AlgebraicGeometry.Morphisms.FlatAtPullbackMap
public import StacksFrontier.AlgebraicGeometry.Chow.ProperPushforwardPrincipal.ToProjectiveLine

/-!
# An affine model of finitely many rational functions

Let `G` be an integral scheme over a field `k`, `U₀` a nonempty affine open, `s` a finite set of
functions on `U₀` and `t` a finite set of rational functions of `G`.  This file builds an affine
integral `k`-scheme `X` of finite type and a dominant morphism `π : V ⟶ X` from a nonempty affine
open `V ⊆ U₀`, over `k`, such that every member of `s` (restricted to `V`) and every member of
`t` is pulled back from a function on `X`, and every function on `X` pulls back to an element of
the subfield of `k(G)` generated by `t` and `s` (`AlgebraicGeometry.exists_affineQuotientModel`).

`X` is the spectrum of the `k`-subalgebra of `Γ(V)` generated by `s` and `t`, for `V` a basic
open of `U₀` on which every member of `t` is regular; `π` is `V ⟶ Spec Γ(V) ⟶ X`.  This is part
(B3) of the bridge from left-invariant subfields of the function field of a group scheme to
rational quotient maps, in the proof that group schemes in characteristic zero are reduced
(Stacks, Remark 047O), along Perrin's route.

## References

* D. Perrin, *Schémas en groupes quasi-compacts sur un corps*, thèse, III §2.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

namespace AlgebraicGeometry

universe u

/-- **An affine model of finitely many rational functions.**  Let `G` be an integral scheme over a
field `k`, `U₀` a nonempty affine open of `G`, `s` a finite set of functions on `U₀` and `t` a
finite set of rational functions of `G` (with `k(G)` a `k`-algebra through the structure
morphism).  There are a nonempty affine open `V ⊆ U₀` and a dominant morphism `π : V ⟶ X` over
`k` to an affine integral `k`-scheme `X` of finite type such that every `f ∈ s` restricted to `V`
and every `x ∈ t` is the pull-back of a function on `X`, and every function on `X` pulls back to
an element of the subfield of `k(G)` generated by `t` and the germs of `s`. -/
theorem exists_affineQuotientModel {k : Type u} [Field k] (G : Over (Spec (.of k)))
    [IsIntegral G.left] (U₀ : G.left.Opens) (hU₀ : IsAffineOpen U₀) [Nonempty U₀]
    (s : Finset Γ(G.left, U₀)) (t : Finset G.left.functionField) :
    letI := stalkAlgebraOver k G.hom (genericPoint G.left)
    ∃ (X : Over (Spec (.of k))) (V : G.left.Opens) (hVU₀ : V ≤ U₀) (_ : IsAffineOpen V)
      (hgV : genericPoint G.left ∈ V) (π : V.toScheme ⟶ X.left)
      (_ : π ≫ X.hom = V.ι ≫ G.hom),
      IsAffine X.left ∧ IsIntegral X.left ∧ LocallyOfFiniteType X.hom ∧ IsDominant π ∧
      (∀ f ∈ s, ∃ φ : Γ(X.left, ⊤),
        V.topIso.hom (π.appTop φ) = G.left.presheaf.map (homOfLE hVU₀).op f) ∧
      (∀ φ : Γ(X.left, ⊤), G.left.presheaf.germ V (genericPoint G.left) hgV
          (V.topIso.hom (π.appTop φ)) ∈
        IntermediateField.adjoin k ((t : Set G.left.functionField) ∪
          G.left.germToFunctionField U₀ '' (s : Set Γ(G.left, U₀)))) ∧
      (∀ x ∈ t, ∃ φ : Γ(X.left, ⊤),
        G.left.presheaf.germ V (genericPoint G.left) hgV (V.topIso.hom (π.appTop φ)) = x) := by
  classical
  let : Algebra k G.left.functionField := stalkAlgebraOver k G.hom (genericPoint G.left)
  let η := genericPoint G.left
  have hη : ∀ W : G.left.Opens, (W : Set G.left).Nonempty → η ∈ W := fun W hW ↦
    ((genericPoint_spec G.left).mem_open_set_iff W.isOpen).mpr (by simpa using hW)
  -- every rational function is regular on an open containing the generic point
  choose W hηW a ha using fun x : G.left.functionField ↦
    TopCat.Presheaf.germ_exist G.left.presheaf (x := η) x
  have hηU₀ : η ∈ U₀ := hη U₀ ⟨_, (Nonempty.some ‹Nonempty U₀›).2⟩
  let O : G.left.Opens := ⟨(U₀ : Set G.left) ∩ ⋂ x ∈ t, (W x : Set G.left),
    U₀.isOpen.inter (isOpen_biInter_finset fun x _ ↦ (W x).isOpen)⟩
  have hηO : η ∈ O := ⟨hηU₀, Set.mem_iInter₂.mpr fun x _ ↦ hηW x⟩
  obtain ⟨g, hgO, hηg⟩ := hU₀.exists_basicOpen_le ⟨η, hηO⟩ hηU₀
  let V := G.left.basicOpen g
  have hV : IsAffineOpen V := hU₀.basicOpen g
  have hVU₀ : V ≤ U₀ := G.left.basicOpen_le g
  have hVW : ∀ x ∈ t, V ≤ W x := fun x hx y hy ↦ Set.mem_iInter₂.mp (hgO hy).2 x hx
  have : Nonempty V := ⟨⟨η, hηg⟩⟩
  -- the structure map and the subalgebra generated by `s` and `t`
  have hle : V ≤ G.hom ⁻¹ᵁ ⊤ := fun _ _ ↦ trivial
  let c : CommRingCat.of k ⟶ Γ(G.left, V) :=
    (Scheme.ΓSpecIso (.of k)).inv ≫ G.hom.appLE ⊤ V hle
  let : Algebra k Γ(G.left, V) := c.hom.toAlgebra
  let rs : Γ(G.left, U₀) → Γ(G.left, V) := fun f ↦ G.left.presheaf.map (homOfLE hVU₀).op f
  let rt : t → Γ(G.left, V) := fun x ↦ G.left.presheaf.map (homOfLE (hVW x.1 x.2)).op (a x.1)
  let S : Finset Γ(G.left, V) := s.image rs ∪ t.attach.image rt
  let A : Subalgebra k Γ(G.left, V) := Algebra.adjoin k (S : Set Γ(G.left, V))
  have hsA : ∀ f ∈ s, rs f ∈ A := fun f hf ↦
    Algebra.subset_adjoin (Finset.mem_union_left _ (Finset.mem_image_of_mem rs hf))
  have htA : ∀ x : t, rt x ∈ A := fun x ↦
    Algebra.subset_adjoin (Finset.mem_union_right _ (Finset.mem_image_of_mem rt (t.mem_attach x)))
  let ι : CommRingCat.of A ⟶ Γ(G.left, V) := CommRingCat.ofHom A.val.toRingHom
  let X : Over (Spec (.of k)) := Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k A)))
  let π : V.toScheme ⟶ X.left := V.toSpecΓ ≫ Spec.map ι
  have hιinj : Function.Injective ι.hom := Subtype.val_injective
  -- pulling back functions along `π`
  have hπapp : ∀ φ : Γ(X.left, ⊤),
      V.topIso.hom (π.appTop φ) = (A.val ((Scheme.ΓSpecIso (.of A)).hom φ) : Γ(G.left, V)) := by
    intro φ
    have e : π.appTop ≫ V.topIso.hom = (Scheme.ΓSpecIso (.of A)).hom ≫ ι := by
      rw [Scheme.Hom.comp_appTop, Category.assoc, Scheme.Opens.toSpecΓ_appTop, Category.assoc,
        Iso.inv_hom_id, Category.comp_id, Scheme.ΓSpecIso_naturality]
    exact ConcreteCategory.congr_hom e φ
  have hgerm_alg : ∀ r : k, G.left.presheaf.germ V η hηg (algebraMap k Γ(G.left, V) r) =
      algebraMap k G.left.functionField r := by
    intro r
    show G.left.presheaf.germ V η hηg (G.hom.appLE ⊤ V hle _) = _
    rw [show G.hom.appLE ⊤ V hle = G.hom.app ⊤ ≫ G.left.presheaf.map (homOfLE hle).op from rfl,
      CommRingCat.comp_apply, TopCat.Presheaf.germ_res_apply]
    rfl
  refine ⟨X, V, hVU₀, hV, hηg, π, ?_, inferInstanceAs (IsAffine (Spec _)), ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- `π` lies over `k`
    show V.toSpecΓ ≫ Spec.map ι ≫ Spec.map (CommRingCat.ofHom (algebraMap k A)) = V.ι ≫ G.hom
    have hc : CommRingCat.ofHom (algebraMap k A) ≫ ι = c := by
      ext r
      rfl
    rw [← Spec.map_comp, hc, Spec.map_comp, ← Category.assoc,
      Scheme.Opens.toSpecΓ_SpecMap_appLE, Category.assoc, Scheme.Opens.toSpecΓ_top,
      Category.assoc, toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id, Scheme.Hom.resLE_comp_ι]
  · have : IsDomain A := inferInstance
    exact inferInstanceAs (IsIntegral (Spec (.of A)))
  · -- finite type
    have hfg : A.FG := Subalgebra.fg_adjoin_finset S
    have : Algebra.FiniteType k A := (Subalgebra.fg_iff_finiteType A).mp hfg
    show LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap k A)))
    rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
    exact RingHom.finiteType_algebraMap.mpr inferInstance
  · -- dominant
    have : IsDomain A := inferInstance
    have : IsIso V.toSpecΓ := inferInstanceAs (IsIso hV.isoSpec.hom)
    have := isDominant_Spec_map_of_injective ι hιinj
    exact inferInstanceAs (IsDominant (V.toSpecΓ ≫ Spec.map ι))
  · intro f hf
    refine ⟨(Scheme.ΓSpecIso (.of A)).inv ⟨rs f, hsA f hf⟩, ?_⟩
    rw [hπapp, Iso.inv_hom_id_apply]
    rfl
  · intro φ
    rw [hπapp]
    generalize (Scheme.ΓSpecIso (.of A)).hom φ = z
    obtain ⟨y, hmem⟩ := z
    show G.left.presheaf.germ V η hηg y ∈ _
    induction hmem using Algebra.adjoin_induction with
    | mem y hy =>
      rcases Finset.mem_union.mp hy with hy | hy
      · obtain ⟨f, hf, rfl⟩ := Finset.mem_image.mp hy
        refine IntermediateField.subset_adjoin _ _ (Or.inr ⟨f, hf, ?_⟩)
        exact (TopCat.Presheaf.germ_res_apply _ _ _ _ _).symm
      · obtain ⟨x, -, rfl⟩ := Finset.mem_image.mp hy
        refine IntermediateField.subset_adjoin _ _ (Or.inl ?_)
        show G.left.presheaf.germ V η hηg
          (G.left.presheaf.map (homOfLE (hVW x.1 x.2)).op (a x.1)) ∈ (t : Set _)
        rw [TopCat.Presheaf.germ_res_apply, ha]
        exact x.2
    | algebraMap r =>
      rw [hgerm_alg]
      exact IntermediateField.algebraMap_mem _ r
    | add y z _ _ hy hz =>
      rw [map_add]
      exact add_mem hy hz
    | mul y z _ _ hy hz =>
      rw [map_mul]
      exact mul_mem hy hz
  · intro x hx
    refine ⟨(Scheme.ΓSpecIso (.of A)).inv ⟨rt ⟨x, hx⟩, htA ⟨x, hx⟩⟩, ?_⟩
    rw [hπapp, Iso.inv_hom_id_apply]
    show G.left.presheaf.germ V η hηg
      (G.left.presheaf.map (homOfLE (hVW x hx)).op (a x)) = x
    rw [TopCat.Presheaf.germ_res_apply, ha]

end AlgebraicGeometry

end
