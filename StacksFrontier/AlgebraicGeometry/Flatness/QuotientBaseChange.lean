module

public import Mathlib.AlgebraicGeometry.Pullbacks

/-!
# Base change of the closed immersion cut out by an ideal

For a ring map `φ : R → A` and an ideal `I ⊆ R`, the closed subscheme `Spec(R/I)` of `Spec R`
pulls back along `Spec φ` to the closed subscheme `Spec(A/IA)` of `Spec A`. On rings this is the
statement that `A/IA` is the pushout of `R → A` and `R → R/I`, and the pushout is checked
directly against its universal property: a map out of `A` that kills the image of `I` kills `IA`,
because `IA` is generated by that image.

This is the affine input to the fibrewise criteria of flatness along a thickening
(Stacks Tag 0CF3): a thickening `S ⊆ S'` is affine-locally cut out by an ideal `I` all of whose
elements are nilpotent, and the cartesian condition `X = S ×_{S'} X'` then says affine-locally
that `Γ(X) = Γ(X')/IΓ(X')`.

## Main results

* `Stacks.Flatness.isPushout_quotient`: `A/IA` is the pushout of `R → A` along `R → R/I`.
* `Stacks.Flatness.isPullback_SpecMap_quotient`: the corresponding cartesian square of affine
  schemes.

## Implementation notes

The induced map `R/I → A/IA` is Mathlib's `Ideal.quotientMap`, whose defining hypothesis
`I ≤ (I.map φ).comap φ` is `Ideal.le_comap_map`.

## References

* [Stacks Project, Tag 01JY](https://stacks.math.columbia.edu/tag/01JY)
* [Stacks Project, Tag 0CF3](https://stacks.math.columbia.edu/tag/0CF3)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Limits

universe u

namespace Stacks.Flatness

/-- For a ring map `φ : R ⟶ A` and an ideal `I ⊆ R`, the quotient `A/IA` is the pushout of
`φ` along the quotient map `R → R/I`. -/
theorem isPushout_quotient {R A : CommRingCat.{u}} (φ : R ⟶ A) (I : Ideal R) :
    IsPushout φ (CommRingCat.ofHom (Ideal.Quotient.mk I))
      (CommRingCat.ofHom (Ideal.Quotient.mk (I.map φ.hom)))
      (CommRingCat.ofHom (Ideal.quotientMap (I.map φ.hom) φ.hom Ideal.le_comap_map)) := by
  have hsq : φ ≫ CommRingCat.ofHom (Ideal.Quotient.mk (I.map φ.hom)) =
      CommRingCat.ofHom (Ideal.Quotient.mk I) ≫
        CommRingCat.ofHom (Ideal.quotientMap (I.map φ.hom) φ.hom Ideal.le_comap_map) := by
    ext r
    simp [Ideal.quotientMap]
  refine IsPushout.of_isColimit (c := PushoutCocone.mk _ _ hsq) ?_
  have key : ∀ s : PushoutCocone φ (CommRingCat.ofHom (Ideal.Quotient.mk I)),
      ∀ r : R, s.inl.hom (φ.hom r) = s.inr.hom (Ideal.Quotient.mk I r) :=
    fun s r => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom s.condition) r
  refine PushoutCocone.IsColimit.mk hsq (fun s => CommRingCat.ofHom
    (Ideal.Quotient.lift (I.map φ.hom) s.inl.hom ?_)) ?_ ?_ ?_
  · refine fun a ha => ?_
    refine (Ideal.map_le_iff_le_comap.mpr fun i hi => ?_ : I.map φ.hom ≤ RingHom.ker s.inl.hom) ha
    simp only [Ideal.mem_comap, RingHom.mem_ker, key s i,
      Ideal.Quotient.eq_zero_iff_mem.mpr hi, map_zero]
  · intro s; ext a; rfl
  · intro s; ext r; exact key s r
  · intro s m h₁ _
    ext a
    exact DFunLike.congr_fun (congrArg CommRingCat.Hom.hom h₁) a

/-- The base change of the closed immersion `Spec(R/I) ⟶ Spec R` along `Spec φ` is the closed
immersion `Spec(A/IA) ⟶ Spec A`. -/
theorem isPullback_SpecMap_quotient {R A : CommRingCat.{u}} (φ : R ⟶ A) (I : Ideal R) :
    IsPullback (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (I.map φ.hom))))
      (Spec.map (CommRingCat.ofHom (Ideal.quotientMap (I.map φ.hom) φ.hom Ideal.le_comap_map)))
      (Spec.map φ) (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) :=
  isPullback_SpecMap_of_isPushout _ _ _ _ (isPushout_quotient φ I)

end Stacks.Flatness

end
