/-!
# Flatness across cartesian thickenings

Let `X ⊆ X'`, `Y ⊆ Y'` and `S ⊆ S'` be thickenings, let `f : X ⟶ Y` and `f' : X' ⟶ Y'` be
compatible morphisms over `S` and `S'`, and assume both closed subschemes are the base change of
the base thickening: `X = S ×_{S'} X'` and `Y = S ×_{S'} Y'`. If `X' → S'` is flat and locally of
finite presentation, `Y' → S'` is locally of finite type and `f` is flat, then `f'` is flat; and
at every point the local ring of `Y'` is flat and essentially of finite presentation over the
local ring of `S'`.

## Main results

* `Stacks.Flatness.flat_quotient_smul_top_of_surjective`: the fibre of a ring map over an ideal,
  read off from two surjections with prescribed kernels.
* `Stacks.Flatness.essentiallyOfFinitePresentation_and_flat_and_flat_of_ker`: the local engine,
  in which the critère de platitude par fibres is fed by two surjections whose kernels are
  generated by one ideal of the base.
* `Stacks.Flatness.ker_comp_iso_inv`: precomposing with the inverse of a ring isomorphism
  replaces the kernel by its image.
* `Stacks.Flatness.flat_and_essentiallyOfFinitePresentation_stalkMap_of_isPullback`: the
  pointwise form of Stacks Tag 0CF3, from which all three statements below follow.
* `Stacks.Flatness.flat_of_flat_baseChange_thickening`, Stacks Tag 0CF3: flatness of `f'`.
* `Stacks.Flatness.flat_stalkMap_of_flat_baseChange_thickening` and
  `Stacks.Flatness.essentiallyOfFinitePresentation_stalkMap_of_flat_baseChange_thickening`: the
  two properties of the local rings of `Y'` over those of `S'`.

## Implementation notes

The argument is pointwise. At a point `x` of `X` with images `x' = iX x`, `y' = f' x'` and
`s' = gY' y'`, the local rings `R = 𝒪_{S', s'}`, `T = 𝒪_{Y', y'}` and `A = 𝒪_{X', x'}` form a
chain to which Stacks Tag 05UV applies, with `M = A`. The fibre hypothesis of 05UV is taken over
the ideal `I ⊆ R` cutting out `S` in `S'`, which is legitimate because `I` lies in the maximal
ideal of `R`; this is
`Stacks.Flatness.essentiallyOfFinitePresentation_and_flat_and_flat_of_flat_quotient`. The fibre
is then `𝒪_{Y, y}` and `𝒪_{X, x}`, because
`Stacks.Flatness.ker_stalkMap_of_isPullback` identifies the kernels of `T → 𝒪_{Y, y}` and
`A → 𝒪_{X, x}` with the ideals generated by `I`, and so the fibre hypothesis is exactly the
flatness of `f` at `x`.

Two kinds of bookkeeping separate this from the statement. The points `iY (f x)` and `f' (iX x)`
of `Y'`, and `iS (gY (f x))` and `gY' (f' (iX x))` of `S'`, agree only up to the commutativity of
the squares, so the comparison maps carry a `TopCat.Presheaf.stalkCongr`; and the ideal `I` is
the image of `ker (iS.stalkMap (gY (f x)))` under such a comparison. Both are handled by
`AlgebraicGeometry.Scheme.Hom.stalkMap_congr_point` and
`Stacks.Flatness.ker_comp_iso_inv`. The local engine
`Stacks.Flatness.essentiallyOfFinitePresentation_and_flat_and_flat_of_ker` is stated for bare
ring maps so that none of the algebra instances on stalks appear in the geometric argument.

## References

* [Stacks Project, Tag 0CF3](https://stacks.math.columbia.edu/tag/0CF3)
* [Stacks Project, Tag 05UV](https://stacks.math.columbia.edu/tag/05UV)
* [Stacks Project, Tag 04EX](https://stacks.math.columbia.edu/tag/04EX)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory IsLocalRing Stacks.Thickenings
open Stacks.Thickenings

universe u

namespace Stacks.Flatness

/-! ### Transport of flatness -/

/-- Flatness transports along a ring isomorphism: if `e : A ≃+* A'` and `φ : N ≃+ N'` is
semilinear over `e`, then flatness of `N'` over `A'` gives flatness of `N` over `A`. -/
public theorem flat_of_ringEquiv {A A' N N' : Type*} [CommRing A] [CommRing A']
    [AddCommGroup N] [AddCommGroup N'] [Module A N] [Module A' N'] [Module.Flat A' N']
    (e : A ≃+* A') (φ : N ≃+ N') (hφ : ∀ (a : A) (n : N), φ (a • n) = e a • φ n) :
    Module.Flat A N := by
  let algAA' : Algebra A A' := (e : A →+* A').toAlgebra
  let modAN' : Module A N' := Module.compHom N' (e : A →+* A')
  have hsmul : ∀ (a : A) (n : N'), a • n = e a • n := fun _ _ => rfl
  have : IsScalarTower A A' N' := IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  have : Module.Flat A A' := RingHom.Flat.of_bijective (f := (e : A →+* A')) e.bijective
  have : Module.Flat A N' := Module.Flat.trans A A' N'
  exact Module.Flat.of_linearEquiv (φ.toLinearEquiv (R := A) fun a n => by rw [hφ, hsmul])

/-- The kernel of a ring map out of a local ring into a nonzero ring is contained in the maximal
ideal: a unit in the kernel would make the target zero. -/
private theorem ker_le_maximalIdeal {R S : Type*} [CommRing R] [CommRing S] [IsLocalRing R]
    [Nontrivial S] (φ : R →+* S) : RingHom.ker φ ≤ maximalIdeal R := by
  intro a ha
  by_contra h
  obtain ⟨b, hb⟩ := isUnit_iff_exists_inv.mp (notMem_maximalIdeal.mp h)
  exact one_ne_zero (α := S) <| by
    rw [← map_one φ, ← hb, map_mul, RingHom.mem_ker.mp ha, zero_mul]

/-- **The fibre of a ring map over an ideal, read off from two surjections.** Let `R → T → A` be
a chain of ring maps, let `I` be an ideal of `R`, and let `β : T → T₀` and `α : A → A₀` be
surjections compatible with a ring map `T₀ → A₀`, with `ker β = I·T` and `ker α = I·A`. Then
flatness of `A₀` over `T₀` is flatness of the fibre `A/I·A` over `T/I·T`.

The two fibres are the same rings: `T/I·T ≅ T₀` and `A/I·A ≅ A₀`, the latter as an additive group
isomorphism semilinear over the former, since `I·A` as a `T`-submodule of `A` and `I·A` as an
ideal of `A` have the same elements. -/
theorem flat_quotient_smul_top_of_surjective
    {R T A T₀ A₀ : Type*} [CommRing R] [CommRing T] [CommRing A] [CommRing T₀] [CommRing A₀]
    [Algebra R T] [Algebra T A] [Algebra R A] [IsScalarTower R T A]
    [Algebra T₀ A₀] [Module.Flat T₀ A₀]
    {β : T →+* T₀} {α : A →+* A₀} (hβ : Function.Surjective β) (hα : Function.Surjective α)
    (hcomp : ∀ t : T, α (algebraMap T A t) = algebraMap T₀ A₀ (β t))
    (I : Ideal R)
    (hkβ : RingHom.ker β = I.map (algebraMap R T))
    (hkα : RingHom.ker α = I.map (algebraMap R A)) :
    Module.Flat (T ⧸ I.map (algebraMap R T))
      (A ⧸ (I.map (algebraMap R T) • (⊤ : Submodule T A))) := by
  set J : Ideal T := I.map (algebraMap R T) with hJ
  set K : Ideal A := I.map (algebraMap R A) with hK
  have hJK : J.map (algebraMap T A) = K := by
    rw [hJ, hK, Ideal.map_map, ← IsScalarTower.algebraMap_eq]
  have hset : ((J • (⊤ : Submodule T A) : Submodule T A) : Set A) = (K : Set A) := by
    rw [Ideal.smul_top_eq_map (S := A) J, hJK]
    rfl
  let eT : (T ⧸ J) ≃+* T₀ :=
    (Ideal.quotEquivOfEq hkβ.symm).trans (RingHom.quotientKerEquivOfSurjective hβ)
  let eA : (A ⧸ K) ≃+* A₀ :=
    (Ideal.quotEquivOfEq hkα.symm).trans (RingHom.quotientKerEquivOfSurjective hα)
  let φ : (A ⧸ (J • (⊤ : Submodule T A))) ≃+ A₀ :=
    (Stacks.Flatness.FibrewiseCriterionEssFP.quotAddEquivOfCoeEq _ _ hset).trans eA.toAddEquiv
  refine flat_of_ringEquiv eT φ ?_
  intro t n
  obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective t
  obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ n
  have h1 : ∀ b : A, φ (Submodule.Quotient.mk b) = α b := fun _ => rfl
  have h2 : eT (Ideal.Quotient.mk J t) = β t := rfl
  have h3 : (Ideal.Quotient.mk J t) • (Submodule.Quotient.mk a :
      A ⧸ (J • (⊤ : Submodule T A))) = Submodule.Quotient.mk (algebraMap T A t * a) := by
    rw [← Algebra.smul_def]
    rfl
  rw [h3, h1, h1, h2, map_mul, hcomp, ← Algebra.smul_def]

/-! ### The local engine -/

/-- **The critère de platitude par fibres fed by two surjections.** Let `R → T → A` be local
homomorphisms of local rings with `R → T` essentially of finite type, `R → A` flat and
essentially of finite presentation. Let `γ : R → S₀` be a ring map into a nonzero ring and let
`I = ker γ`. Let `β : T → T₀` and `α : A → A₀` be surjections with `ker β = I·T` and
`ker α = I·A`, compatible with a flat ring map `β₀ : T₀ → A₀`. Then `R → T` is flat and
essentially of finite presentation and `T → A` is flat.

This is Stacks Tag 05UV with the fibre taken over `I` rather than over the maximal ideal of `R`,
packaged so that the caller supplies only ring maps: the algebra instances are installed here. -/
@[ega "IV 11.3.10" "special case",
  sga "1 IV 5.9" "(ii) ⇒ (i) for M = C",
  sga "3 VIB 1.3.0" "special case",
  sga "3 VIB 12.7" "special case",
  sga "3 X 3.5" "partial"]
theorem essentiallyOfFinitePresentation_and_flat_and_flat_of_ker
    {R T A T₀ A₀ S₀ : Type u}
    [CommRing R] [CommRing T] [CommRing A] [CommRing T₀] [CommRing A₀] [CommRing S₀]
    [IsLocalRing R] [IsLocalRing T] [IsLocalRing A] [Nontrivial S₀]
    {ρ : R →+* T} {τ : T →+* A} {β : T →+* T₀} {β₀ : T₀ →+* A₀} {α : A →+* A₀} (γ : R →+* S₀)
    [IsLocalHom ρ] [IsLocalHom τ]
    (hρ : ρ.EssFiniteType) (hflatRA : (τ.comp ρ).Flat)
    (hefpRA : (τ.comp ρ).EssentiallyOfFinitePresentation)
    (hβ : Function.Surjective β) (hα : Function.Surjective α)
    (hcomp : ∀ t : T, α (τ t) = β₀ (β t)) (hflat₀ : β₀.Flat)
    (hkβ : RingHom.ker β = (RingHom.ker γ).map ρ)
    (hkα : RingHom.ker α = (RingHom.ker γ).map (τ.comp ρ)) :
    ρ.EssentiallyOfFinitePresentation ∧ ρ.Flat ∧ τ.Flat := by
  let algRT : Algebra R T := ρ.toAlgebra
  let algTA : Algebra T A := τ.toAlgebra
  let algRA : Algebra R A := (τ.comp ρ).toAlgebra
  have towRTA : IsScalarTower R T A := IsScalarTower.of_algebraMap_eq' rfl
  let algT₀A₀ : Algebra T₀ A₀ := β₀.toAlgebra
  have flat₀ : Module.Flat T₀ A₀ := hflat₀
  have essft : Algebra.EssFiniteType R T := hρ
  have flatRA : Module.Flat R A := hflatRA
  exact essentiallyOfFinitePresentation_and_flat_and_flat_of_flat_quotient hefpRA
    (ker_le_maximalIdeal γ)
    (flat_quotient_smul_top_of_surjective hβ hα hcomp _ hkβ hkα)

/-! ### The kernel of a map precomposed with an isomorphism -/

/-- Precomposing with the inverse of an isomorphism replaces the kernel by its image under the
isomorphism. -/
theorem ker_comp_iso_inv {P Q Z : CommRingCat.{u}} (e : Q ≅ P) (ψ : Q ⟶ Z) :
    RingHom.ker (e.inv ≫ ψ).hom = Ideal.map e.hom.hom (RingHom.ker ψ.hom) := by
  refine le_antisymm (fun a ha => ?_) (Ideal.map_le_iff_le_comap.mpr fun b hb => ?_)
  · have hinv : e.hom.hom (e.inv.hom a) = a :=
      congrArg (fun g : P ⟶ P => g.hom a) e.inv_hom_id
    exact hinv ▸ Ideal.mem_map_of_mem _ (RingHom.mem_ker.mpr ha)
  · have hhom : e.inv.hom (e.hom.hom b) = b :=
      congrArg (fun g : Q ⟶ Q => g.hom b) e.hom_inv_id
    simp only [Ideal.mem_comap, RingHom.mem_ker, CommRingCat.hom_comp, RingHom.coe_comp,
      Function.comp_apply, hhom]
    exact RingHom.mem_ker.mp hb

/-! ### The pointwise statement -/

/-- **Stacks Tag 0CF3 at a point.** For a morphism of thickenings `(X ⊆ X') → (Y ⊆ Y')` over
`(S ⊆ S')` in which both closed subschemes are the base change of the base thickening, with
`X' → S'` flat and locally of finite presentation, `Y' → S'` locally of finite type and `f`
flat, the local ring of `Y'` at the image of a point of `X` is flat and essentially of finite
presentation over the local ring of `S'`, and the local ring of `X'` is flat over it.

This is Stacks Tag 05UV applied to `𝒪_{S', s'} → 𝒪_{Y', y'} → 𝒪_{X', x'}` with the fibre taken
over the ideal cutting out `S` in `S'`; the fibre is then the stalk map of `f` at `x`, which is
flat because `f` is. -/
theorem flat_and_essentiallyOfFinitePresentation_stalkMap_of_isPullback
    {X X' Y Y' S S' : Scheme.{u}} {iX : X ⟶ X'} {iY : Y ⟶ Y'} {iS : S ⟶ S'}
    {f : X ⟶ Y} {f' : X' ⟶ Y'} {gY : Y ⟶ S} {gY' : Y' ⟶ S'} [IsClosedImmersion iS]
    (hcomm : f ≫ iY = iX ≫ f')
    (hX : IsPullback iX (f ≫ gY) (f' ≫ gY') iS) (hY : IsPullback iY gY gY' iS)
    [LocallyOfFiniteType gY'] [Flat (f' ≫ gY')] [LocallyOfFinitePresentation (f' ≫ gY')]
    [Flat f] (x : X) :
    (gY'.stalkMap (f' (iX x))).hom.EssentiallyOfFinitePresentation ∧
      (gY'.stalkMap (f' (iX x))).hom.Flat ∧ (f'.stalkMap (iX x)).hom.Flat := by
  have hiX : IsClosedImmersion iX := MorphismProperty.of_isPullback hX.flip inferInstance
  have hiY : IsClosedImmersion iY := MorphismProperty.of_isPullback hY.flip inferInstance
  -- the three point identities furnished by the two squares and the commuting square
  have hp : iY (f x) = f' (iX x) := congrArg (fun g : X ⟶ Y' => g.base x) hcomm
  have hptX : iS (gY (f x)) = gY' (f' (iX x)) :=
    (congrArg (fun g : X ⟶ S' => g.base x) hX.w).symm
  have hptY : iS (gY (f x)) = gY' (iY (f x)) :=
    (congrArg (fun g : Y ⟶ S' => g.base (f x)) hY.w).symm
  -- the comparison of the two routes `𝒪_{S', iS (gY (f x))} ⟶ 𝒪_{Y', f' (iX x)}`
  have hroute :
      (S'.presheaf.stalkCongr (Inseparable.of_eq hptY)).hom ≫
          gY'.stalkMap (iY (f x)) ≫ (Y'.presheaf.stalkCongr (Inseparable.of_eq hp)).hom =
        (S'.presheaf.stalkCongr (Inseparable.of_eq hptX)).hom ≫ gY'.stalkMap (f' (iX x)) := by
    rw [Scheme.Hom.stalkMap_congr_point gY' (iY (f x)) (f' (iX x)) hp, ← Category.assoc]
    congr 1
    simp only [TopCat.Presheaf.stalkCongr_hom]
    apply TopCat.Presheaf.stalkSpecializes_comp
  -- the kernels of the two surjections, as ideals generated by the ideal of `S` in `S'`
  have hkerX : RingHom.ker (iX.stalkMap x).hom =
      Ideal.map ((S'.presheaf.stalkCongr (Inseparable.of_eq hptX)).hom ≫
          (f' ≫ gY').stalkMap (iX x)).hom
        (RingHom.ker (iS.stalkMap (gY (f x))).hom) :=
    ker_stalkMap_of_isPullback hX x hptX
  have hkerY : RingHom.ker (iY.stalkMap (f x)).hom =
      Ideal.map ((S'.presheaf.stalkCongr (Inseparable.of_eq hptY)).hom ≫
          gY'.stalkMap (iY (f x))).hom
        (RingHom.ker (iS.stalkMap (gY (f x))).hom) :=
    ker_stalkMap_of_isPullback hY (f x) hptY
  refine essentiallyOfFinitePresentation_and_flat_and_flat_of_ker
    (β := ((Y'.presheaf.stalkCongr (Inseparable.of_eq hp)).inv ≫ iY.stalkMap (f x)).hom)
    (β₀ := (f.stalkMap x).hom) (α := (iX.stalkMap x).hom)
    ((S'.presheaf.stalkCongr (Inseparable.of_eq hptX)).inv ≫ iS.stalkMap (gY (f x))).hom
    (LocallyOfFiniteType.stalkMap gY' (f' (iX x))) ?_ ?_ ?_
    (iX.stalkMap_surjective x) ?_ (Flat.stalkMap f x) ?_ ?_
  · have h := Flat.stalkMap (f' ≫ gY') (iX x)
    rwa [Scheme.Hom.stalkMap_comp] at h
  · have h := LocallyOfFinitePresentation.essentiallyOfFinitePresentation_stalkMap
      (f' ≫ gY') (iX x)
    rwa [Scheme.Hom.stalkMap_comp] at h
  · exact (iY.stalkMap_surjective (f x)).comp (ConcreteCategory.bijective_of_isIso
      (Y'.presheaf.stalkCongr (Inseparable.of_eq hp)).inv).2
  · intro t
    have h : (Y'.presheaf.stalkCongr (Inseparable.of_eq hp)).hom ≫
        f'.stalkMap (iX x) ≫ iX.stalkMap x = iY.stalkMap (f x) ≫ f.stalkMap x := by
      rw [← Scheme.Hom.stalkMap_comp, ← Scheme.Hom.stalkMap_comp,
        Scheme.Hom.stalkMap_congr_hom (f ≫ iY) (iX ≫ f') hcomm x]
      rfl
    have ht : (Y'.presheaf.stalkCongr (Inseparable.of_eq hp)).hom.hom
        ((Y'.presheaf.stalkCongr (Inseparable.of_eq hp)).inv.hom t) = t :=
      congrArg
        (fun g : Y'.presheaf.stalk (f' (iX x)) ⟶ Y'.presheaf.stalk (f' (iX x)) => g.hom t)
        (Y'.presheaf.stalkCongr (Inseparable.of_eq hp)).inv_hom_id
    have h2 := congrArg
      (fun g : Y'.presheaf.stalk (iY (f x)) ⟶ X.presheaf.stalk x =>
        g.hom ((Y'.presheaf.stalkCongr (Inseparable.of_eq hp)).inv.hom t)) h
    simpa only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply, ht] using h2
  · rw [ker_comp_iso_inv (Y'.presheaf.stalkCongr (Inseparable.of_eq hp))
        (iY.stalkMap (f x)), hkerY,
      ker_comp_iso_inv (S'.presheaf.stalkCongr (Inseparable.of_eq hptX))
        (iS.stalkMap (gY (f x))), Ideal.map_map, Ideal.map_map]
    refine congrArg
      (fun g : S'.presheaf.stalk (iS (gY (f x))) ⟶ Y'.presheaf.stalk (f' (iX x)) =>
        Ideal.map g.hom (RingHom.ker (iS.stalkMap (gY (f x))).hom)) ?_
    rwa [← Category.assoc] at hroute
  · rw [hkerX, ker_comp_iso_inv (S'.presheaf.stalkCongr (Inseparable.of_eq hptX))
      (iS.stalkMap (gY (f x))), Ideal.map_map]
    congr 1
    simp only [CommRingCat.hom_comp, Scheme.Hom.stalkMap_comp]

/-! ### Stacks Tag 0CF3 -/

/-- The three conclusions of Stacks Tag 0CF3 at a point `x'` of `X'`, from the pointwise form. -/
private theorem stalkMap_properties_of_flat_baseChange_thickening
    {X X' Y Y' S S' : Scheme.{u}} {iX : X ⟶ X'} {iY : Y ⟶ Y'} {iS : S ⟶ S'}
    {f : X ⟶ Y} {f' : X' ⟶ Y'} {gX : X ⟶ S} {gX' : X' ⟶ S'} {gY : Y ⟶ S} {gY' : Y' ⟶ S'}
    (hiX : IsThickening iX) (hiY : IsThickening iY) (hiS : IsThickening iS)
    (hcomm : f ≫ iY = iX ≫ f') (hover : f ≫ gY = gX) (hover' : f' ≫ gY' = gX')
    (hX : IsPullback iX gX gX' iS) (hY : IsPullback iY gY gY' iS)
    [LocallyOfFiniteType gY'] [Flat gX'] [LocallyOfFinitePresentation gX'] (hf : Flat f)
    (x' : X') :
    (gY'.stalkMap (f' x')).hom.EssentiallyOfFinitePresentation ∧
      (gY'.stalkMap (f' x')).hom.Flat ∧ (f'.stalkMap x').hom.Flat := by
  subst hover hover'
  have instS : IsClosedImmersion iS := hiS.1
  have instY : IsClosedImmersion iY := hiY.1
  obtain ⟨x, rfl⟩ := hiX.2 x'
  exact flat_and_essentiallyOfFinitePresentation_stalkMap_of_isPullback hcomm hX hY x

/-- **Flatness lifts across cartesian thickenings.** Let `iX : X ⟶ X'`, `iY : Y ⟶ Y'` and
`iS : S ⟶ S'` be thickenings, let `f : X ⟶ Y` and `f' : X' ⟶ Y'` be compatible morphisms over
`S` and `S'`, and let both `X` and `Y` be the base change of `S` along `X' ⟶ S'` and
`Y' ⟶ S'`. If `Y' ⟶ S'` is locally of finite type, `X' ⟶ S'` is flat and locally of finite
presentation and `f` is flat, then `f'` is flat. -/
@[stacks 0CF3 "flatness of the ambient morphism"]
theorem flat_of_flat_baseChange_thickening
    {X X' Y Y' S S' : Scheme.{u}}
    (iX : X ⟶ X') (iY : Y ⟶ Y') (iS : S ⟶ S')
    (f : X ⟶ Y) (f' : X' ⟶ Y')
    (gX : X ⟶ S) (gX' : X' ⟶ S')
    (gY : Y ⟶ S) (gY' : Y' ⟶ S')
    (hiX : IsThickening iX)
    (hiY : IsThickening iY)
    (hiS : IsThickening iS)
    (hcomm : f ≫ iY = iX ≫ f')
    (hover : f ≫ gY = gX)
    (hover' : f' ≫ gY' = gX')
    (hX : IsPullback iX gX gX' iS)
    (hY : IsPullback iY gY gY' iS)
    [LocallyOfFiniteType gY'] [Flat gX'] [LocallyOfFinitePresentation gX']
    (hf : Flat f) : Flat f' := by
  rw [Flat.iff_flat_stalkMap]
  exact fun x' => (stalkMap_properties_of_flat_baseChange_thickening hiX hiY hiS hcomm hover hover'
    hX hY hf x').2.2

/-- **The local ring of the target is flat over the base.** In the situation of Stacks Tag 0CF3,
the local ring of `Y'` at the image of a point of `X'` is flat over the local ring of `S'`. -/
@[stacks 0CF3 "flatness of the target local ring"]
theorem flat_stalkMap_of_flat_baseChange_thickening
    {X X' Y Y' S S' : Scheme.{u}}
    (iX : X ⟶ X') (iY : Y ⟶ Y') (iS : S ⟶ S')
    (f : X ⟶ Y) (f' : X' ⟶ Y')
    (gX : X ⟶ S) (gX' : X' ⟶ S')
    (gY : Y ⟶ S) (gY' : Y' ⟶ S')
    (hiX : IsThickening iX)
    (hiY : IsThickening iY)
    (hiS : IsThickening iS)
    (hcomm : f ≫ iY = iX ≫ f')
    (hover : f ≫ gY = gX)
    (hover' : f' ≫ gY' = gX')
    (hX : IsPullback iX gX gX' iS)
    (hY : IsPullback iY gY gY' iS)
    [LocallyOfFiniteType gY'] [Flat gX'] [LocallyOfFinitePresentation gX']
    (hf : Flat f) (x' : X') : (gY'.stalkMap (f' x')).hom.Flat := by
  exact (stalkMap_properties_of_flat_baseChange_thickening hiX hiY hiS hcomm hover hover' hX hY hf
    x').2.1

/-- **The local ring of the target is essentially of finite presentation over the base.** In the
situation of Stacks Tag 0CF3, the local ring of `Y'` at the image of a point of `X'` is
essentially of finite presentation over the local ring of `S'`. -/
@[stacks 0CF3 "essential finite presentation of the target local ring"]
theorem essentiallyOfFinitePresentation_stalkMap_of_flat_baseChange_thickening
    {X X' Y Y' S S' : Scheme.{u}}
    (iX : X ⟶ X') (iY : Y ⟶ Y') (iS : S ⟶ S')
    (f : X ⟶ Y) (f' : X' ⟶ Y')
    (gX : X ⟶ S) (gX' : X' ⟶ S')
    (gY : Y ⟶ S) (gY' : Y' ⟶ S')
    (hiX : IsThickening iX)
    (hiY : IsThickening iY)
    (hiS : IsThickening iS)
    (hcomm : f ≫ iY = iX ≫ f')
    (hover : f ≫ gY = gX)
    (hover' : f' ≫ gY' = gX')
    (hX : IsPullback iX gX gX' iS)
    (hY : IsPullback iY gY gY' iS)
    [LocallyOfFiniteType gY'] [Flat gX'] [LocallyOfFinitePresentation gX']
    (hf : Flat f) (x' : X') :
    IsEssentiallyOfFinitePresentation
      (S'.presheaf.stalk (gY' (f' x')))
      (Y'.presheaf.stalk (f' x'))
      (gY'.stalkMap (f' x')).hom := by
  exact (stalkMap_properties_of_flat_baseChange_thickening hiX hiY hiS hcomm hover hover' hX hY hf
    x').1.isEssentiallyOfFinitePresentation

end Stacks.Flatness

