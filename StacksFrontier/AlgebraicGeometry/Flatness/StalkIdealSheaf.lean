module

public import Mathlib.AlgebraicGeometry.Morphisms.Affine
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.Restrict
public import Mathlib.RingTheory.Localization.Algebra

/-!
# The ideal cutting out the base change of a closed immersion, on stalks

Let
```
X  ⟶  X'
↓      ↓
S  ⟶  S'
```
be a cartesian square of schemes whose bottom row `iS : S ⟶ S'` is a closed immersion, so that
`X` is the closed subscheme of `X'` cut out by the ideal defining `S` in `S'`. On stalks: at a
point `x` of `X` with `x' = iX x`, `s = gX x` and `s' = iS s`, the kernel of
`𝒪_{X', x'} → 𝒪_{X, x}` is the ideal generated by the image of the kernel of
`𝒪_{S', s'} → 𝒪_{S, s}`. Equivalently `𝒪_{X, x} = 𝒪_{X', x'} ⧸ I·𝒪_{X', x'}` for
`I = ker(𝒪_{S', s'} → 𝒪_{S, s})`.

## Main results

* `Stacks.Flatness.ker_inl_of_isPushout`: in a pushout square of commutative rings whose one leg
  is surjective, the kernel of the parallel leg is the ideal generated by the image of the
  kernel.
* `Stacks.Flatness.ker_stalkMap_eq_map_germ`: for affine opens `x ∈ V ⊆ f⁻¹(U)` on which `f` is
  surjective on sections, the kernel of `f.stalkMap x` is generated by the image of the kernel of
  `f.appLE U V`.
* `Stacks.Flatness.isPushout_appLE_of_isPullback`: a cartesian square with closed immersion
  bottom row induces, on sections over affine opens, a pushout square of rings.
* `Stacks.Flatness.ker_stalkMap_of_isPullback`: the stalk-level statement described above.

## References

* [Stacks Project, Tag 0CF3](https://stacks.math.columbia.edu/tag/0CF3)
* [Stacks Project, Tag 01JY](https://stacks.math.columbia.edu/tag/01JY)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Limits TopologicalSpace

universe u

namespace Stacks.Flatness

/-- In a pushout square of commutative rings
```
R ⟶ A
↓    ↓
T ⟶ B
```
whose left leg `R ⟶ T` is surjective, the kernel of the parallel leg `A ⟶ B` is the ideal of `A`
generated by the image of the kernel of `R ⟶ T`. -/
theorem ker_inl_of_isPushout {R A T B : CommRingCat.{u}} {φ : R ⟶ A} {ψ : R ⟶ T}
    {ψ' : A ⟶ B} {φ' : T ⟶ B} (H : IsPushout φ ψ ψ' φ')
    (hψ : Function.Surjective ψ.hom) :
    RingHom.ker ψ'.hom = (RingHom.ker ψ.hom).map φ.hom := by
  set I := RingHom.ker ψ.hom
  have hw : ∀ r : R, ψ'.hom (φ.hom r) = φ'.hom (ψ.hom r) :=
    fun r => congrArg (fun f : R ⟶ B => f.hom r) H.w
  refine le_antisymm ?_ (Ideal.map_le_iff_le_comap.mpr fun r hr => ?_)
  · set Q := CommRingCat.of (↑A ⧸ I.map φ.hom)
    let ρ : R →+* Q := (Ideal.Quotient.mk (I.map φ.hom)).comp φ.hom
    have hker : ∀ a ∈ I, ρ a = 0 := fun a ha =>
      Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ ha)
    let e : (↑R ⧸ I) ≃+* ↑T := RingHom.quotientKerEquivOfSurjective hψ
    let χ : T ⟶ Q :=
      CommRingCat.ofHom ((Ideal.Quotient.lift I ρ hker).comp (e.symm : ↑T →+* ↑R ⧸ I))
    have hcomm : φ ≫ CommRingCat.ofHom (Ideal.Quotient.mk (I.map φ.hom)) = ψ ≫ χ := by
      ext r
      change (Ideal.Quotient.mk (I.map φ.hom)) (φ.hom r) =
        (Ideal.Quotient.lift I ρ hker) (e.symm (ψ.hom r))
      have he : e.symm (ψ.hom r) = Ideal.Quotient.mk I r := by
        rw [RingEquiv.symm_apply_eq]
        exact (RingHom.kerLift_mk ψ.hom r).symm
      rw [he]
      rfl
    intro a ha
    have hd := H.inl_desc (CommRingCat.ofHom (Ideal.Quotient.mk (I.map φ.hom))) χ hcomm
    have h3 : (H.desc _ _ hcomm).hom (ψ'.hom a) = (Ideal.Quotient.mk (I.map φ.hom)) a :=
      congrArg (fun f : A ⟶ Q => f.hom a) hd
    refine Ideal.Quotient.eq_zero_iff_mem.mp ?_
    rw [← h3, RingHom.mem_ker.mp ha, map_zero]
  · simp only [Ideal.mem_comap, RingHom.mem_ker, hw r, RingHom.mem_ker.mp hr, map_zero]

/-- Let `f : X ⟶ Y`, let `U` be an affine open of `Y` and `V` an affine open of `X` with
`x ∈ V ⊆ f⁻¹(U)`, and suppose `f.appLE U V` is surjective. Then the kernel of `f.stalkMap x` is
the ideal of `𝒪_{X, x}` generated by the image of the kernel of `f.appLE U V`. -/
theorem ker_stalkMap_eq_map_germ {X Y : Scheme.{u}} (f : X ⟶ Y) {x : X}
    {U : Y.Opens} (hU : IsAffineOpen U) {V : X.Opens} (hV : IsAffineOpen V)
    (hVU : V ≤ f ⁻¹ᵁ U) (hx : x ∈ V) (hfx : f x ∈ U)
    (hsurj : Function.Surjective (f.appLE U V hVU).hom) :
    RingHom.ker (f.stalkMap x).hom =
      (RingHom.ker (f.appLE U V hVU).hom).map (Y.presheaf.germ U (f x) hfx).hom := by
  let algS : Algebra Γ(Y, U) (Y.presheaf.stalk (f x)) :=
    Y.presheaf.algebra_section_stalk ⟨f x, hfx⟩
  let algQ : Algebra Γ(X, V) (X.presheaf.stalk x) := X.presheaf.algebra_section_stalk ⟨x, hx⟩
  set g := (f.appLE U V hVU).hom
  set p := (hU.primeIdealOf ⟨f x, hfx⟩).asIdeal
  set q := (hV.primeIdealOf ⟨x, hx⟩).asIdeal
  have instS : IsLocalization.AtPrime (Y.presheaf.stalk (f x)) p := hU.isLocalization_stalk _
  have instQ : IsLocalization.AtPrime (X.presheaf.stalk x) q := hV.isLocalization_stalk ⟨x, hx⟩
  have hcomap : Ideal.comap g q = p :=
    congrArg PrimeSpectrum.asIdeal (IsAffineOpen.comap_primeIdealOf_appLE U hU V hV hVU hx)
  have hmem : ∀ s : Γ(Y, U), s ∈ p ↔ g s ∈ q := fun s => by
    rw [← hcomap]; exact Ideal.mem_comap
  have hT : Submonoid.map g p.primeCompl = q.primeCompl := by
    refine le_antisymm ?_ fun t ht => ?_
    · rintro t ⟨s, hs, rfl⟩
      exact fun htq => hs ((hmem s).mpr htq)
    · obtain ⟨s, rfl⟩ := hsurj t
      exact ⟨s, fun hsp => ht ((hmem s).mp hsp), rfl⟩
  have hle : p.primeCompl ≤ Submonoid.comap g q.primeCompl := by
    rw [← hT]; exact Submonoid.le_comap_map _
  have hmap : (f.stalkMap x).hom = IsLocalization.map (X.presheaf.stalk x) g hle := by
    refine IsLocalization.ringHom_ext p.primeCompl ?_
    rw [IsLocalization.map_comp]
    change (f.stalkMap x).hom.comp (Y.presheaf.germ U (f x) hfx).hom =
      (X.presheaf.germ V x hx).hom.comp g
    rw [← CommRingCat.hom_comp, ← CommRingCat.hom_comp, f.germ_stalkMap U x hfx]
    congr 1
    rw [Scheme.Hom.appLE]
    simp
  rw [hmap, IsLocalization.ker_map (X.presheaf.stalk x) g hT]
  rfl

/-- For a cartesian square
```
X  ⟶  X'
↓      ↓
S  ⟶  S'
```
with `iS : S ⟶ S'` a closed immersion, an affine open `V'` of `S'` and an affine open `U'` of
`X'` lying over it, the sections over `V'`, `U'`, `iS⁻¹(V')` and `iX⁻¹(U')` form a pushout square
of rings. -/
theorem isPushout_appLE_of_isPullback {X X' S S' : Scheme.{u}} {iX : X ⟶ X'} {gX : X ⟶ S}
    {gX' : X' ⟶ S'} {iS : S ⟶ S'} (H : IsPullback iX gX gX' iS) [IsClosedImmersion iS]
    {V' : S'.Opens} (hV' : IsAffineOpen V') {U' : X'.Opens} (hU' : IsAffineOpen U')
    (hU'V' : U' ≤ gX' ⁻¹ᵁ V') :
    IsPushout (gX'.appLE V' U' hU'V') (iS.appLE V' (iS ⁻¹ᵁ V') le_rfl)
      (iX.appLE U' (iX ⁻¹ᵁ U') le_rfl)
      (gX.appLE (iS ⁻¹ᵁ V') (iX ⁻¹ᵁ U')
        (by
          have h : gX ⁻¹ᵁ iS ⁻¹ᵁ V' = iX ⁻¹ᵁ gX' ⁻¹ᵁ V' := by
            rw [← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage, H.w]
          rw [h]
          exact Scheme.Hom.preimage_mono _ hU'V')) := by
  have hiX : IsClosedImmersion iX := MorphismProperty.of_isPullback H.flip inferInstance
  set U : X.Opens := iX ⁻¹ᵁ U' with hU
  set V : S.Opens := iS ⁻¹ᵁ V' with hV
  have hVaff : IsAffineOpen V := hV'.preimage iS
  have hUaff : IsAffineOpen U := hU'.preimage iX
  have instU' : IsAffine U'.toScheme := hU'
  have instV' : IsAffine V'.toScheme := hV'
  have instV : IsAffine V.toScheme := hVaff
  have hpre : gX ⁻¹ᵁ V = iX ⁻¹ᵁ gX' ⁻¹ᵁ V' := by
    rw [hV, ← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage, H.w]
  have hUY : U = iX ⁻¹ᵁ U' ⊓ gX ⁻¹ᵁ V := by
    rw [hpre, ← hU]
    exact (inf_eq_left.mpr (Scheme.Hom.preimage_mono _ hU'V')).symm
  have hpb := Scheme.Hom.isPullback_resLE H (US := V') (UT := V) (UX := U') le_rfl hU'V' hUY
  exact (isPushout_appTop_of_isPullback hpb).of_iso V'.topIso U'.topIso V.topIso U.topIso
    (arrowResLEAppIso gX' V' U' hU'V').hom.w.symm
    (arrowResLEAppIso iS V' V le_rfl).hom.w.symm
    (arrowResLEAppIso iX U' U le_rfl).hom.w.symm
    (arrowResLEAppIso gX V U _).hom.w.symm

/-- For a closed immersion `f` and an affine open `U`, `f.appLE U (f⁻¹ U)` is surjective. -/
private theorem appLE_surjective_of_isClosedImmersion {X Y : Scheme.{u}} (f : X ⟶ Y)
    [IsClosedImmersion f] {U : Y.Opens} (hU : IsAffineOpen U) :
    Function.Surjective (f.appLE U (f ⁻¹ᵁ U) le_rfl).hom := by
  rw [Scheme.Hom.appLE_eq_app]
  exact f.app_surjective U hU

/-- For a closed immersion `f`, an affine open `U` and `x` with `f x ∈ U`, the kernel of
`f.stalkMap x` is generated by the image of the kernel of `f.appLE U (f⁻¹ U)`. -/
private theorem ker_stalkMap_eq_map_germ_of_isClosedImmersion {X Y : Scheme.{u}} (f : X ⟶ Y)
    [IsClosedImmersion f] {U : Y.Opens} (hU : IsAffineOpen U) {x : X} (hx : f x ∈ U) :
    RingHom.ker (f.stalkMap x).hom =
      (RingHom.ker (f.appLE U (f ⁻¹ᵁ U) le_rfl).hom).map (Y.presheaf.germ U (f x) hx).hom :=
  ker_stalkMap_eq_map_germ f hU (hU.preimage f) le_rfl hx hx
    (appLE_surjective_of_isClosedImmersion f hU)

/-- For a cartesian square
```
X  ⟶  X'
↓      ↓
S  ⟶  S'
```
whose bottom row `iS : S ⟶ S'` is a closed immersion and a point `x` of `X`, the kernel of
`𝒪_{X', iX x} → 𝒪_{X, x}` is the ideal generated by the image of the kernel of
`𝒪_{S', iS (gX x)} → 𝒪_{S, gX x}`. Equivalently `𝒪_{X, x} = 𝒪_{X', iX x} ⧸ I·𝒪_{X', iX x}` for
`I` that kernel.
The comparison map uses `TopCat.Presheaf.stalkCongr` for the equality of points
`iS (gX x) = gX' (iX x)`, which is taken as a hypothesis. -/
theorem ker_stalkMap_of_isPullback {X X' S S' : Scheme.{u}} {iX : X ⟶ X'} {gX : X ⟶ S}
    {gX' : X' ⟶ S'} {iS : S ⟶ S'} (H : IsPullback iX gX gX' iS) [IsClosedImmersion iS] (x : X)
    (hpt : iS (gX x) = gX' (iX x)) :
    RingHom.ker (iX.stalkMap x).hom =
      Ideal.map
        ((S'.presheaf.stalkCongr (Inseparable.of_eq hpt)).hom ≫ gX'.stalkMap (iX x)).hom
        (RingHom.ker (iS.stalkMap (gX x)).hom) := by
  have hiX : IsClosedImmersion iX := MorphismProperty.of_isPullback H.flip inferInstance
  obtain ⟨V', hV', hxV', -⟩ := Opens.isBasis_iff_nbhd.mp S'.isBasis_affineOpens
    (Opens.mem_top <| gX' (iX x))
  obtain ⟨U', hU', hxU', hU'V'⟩ := Opens.isBasis_iff_nbhd.mp X'.isBasis_affineOpens
    (show iX x ∈ gX' ⁻¹ᵁ V' from hxV')
  have hV'a : IsAffineOpen V' := hV'
  have hU'a : IsAffineOpen U' := hU'
  have hsV' : iS (gX x) ∈ V' := hpt ▸ hxV'
  have key : S'.presheaf.germ V' (iS (gX x)) hsV' ≫
        ((S'.presheaf.stalkCongr (Inseparable.of_eq hpt)).hom ≫ gX'.stalkMap (iX x)) =
      gX'.appLE V' U' hU'V' ≫ X'.presheaf.germ U' (iX x) hxU' := by
    rw [← Category.assoc, TopCat.Presheaf.stalkCongr_hom,
      S'.presheaf.germ_stalkSpecializes hsV' (Inseparable.of_eq hpt).ge,
      gX'.germ_stalkMap V' (iX x) hxV', Scheme.Hom.appLE, Category.assoc,
      X'.presheaf.germ_res (homOfLE hU'V') (iX x) hxU']
  rw [ker_stalkMap_eq_map_germ_of_isClosedImmersion iX hU'a hxU',
    ker_stalkMap_eq_map_germ_of_isClosedImmersion iS hV'a hsV',
    ker_inl_of_isPushout (isPushout_appLE_of_isPullback H hV'a hU'a hU'V')
      (appLE_surjective_of_isClosedImmersion iS hV'a),
    Ideal.map_map, Ideal.map_map, ← CommRingCat.hom_comp, ← CommRingCat.hom_comp, key]

end Stacks.Flatness

end
