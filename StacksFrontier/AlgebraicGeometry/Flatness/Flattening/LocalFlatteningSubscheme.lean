module

public import Mathlib.Algebra.Module.FinitePresentation
public import Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme
public import Mathlib.RingTheory.Henselian
public import StacksFrontier.AlgebraicGeometry.Flatness.Flattening.StalkFlatteningSituation
public import StacksFrontier.AlgebraicGeometry.Morphisms.FinitePresentationPoint
public import StacksFrontier.RingTheory.EssentialFiniteness.Composition
public import StacksFrontier.RingTheory.Flat.HenselianFlatteningTheorem

/-!
# The scheme-theoretic local flattening subscheme

Let `f : X ⟶ S` be locally of finite type, let `F` be a finite type quasi-coherent module on
`X`, and let `x` be a point of `X` above a point `s` of `S` which presents `S` as the spectrum
of its own henselian local ring. Stacks Tag 05PH asserts that there is a closed subscheme
`Z ⊆ S` such that for every morphism of pointed schemes `(T, t) ⟶ (S, s)` the pullback of `F`
is flat over `T` at every point of `X ×_S T` above `x` exactly when `Spec 𝒪_{T, t} ⟶ S` factors
through `Z`; and that `Z` may be chosen of finite presentation over `S` when `f` is of finite
presentation at `x` and `F_x` is of finite presentation over `𝒪_{X, x}`.

The flattening ideal `J ⊆ 𝒪_{S, s}` is Stacks Tag 05PG applied to
`AlgebraicGeometry.stalkFlatAtPointSituation`, which is legitimate because the stalk map of a
morphism locally of finite type is essentially of finite type and the stalk of a finite type
module is a finite module. The closed subscheme is the ideal sheaf generated by `J` on global
sections, `AlgebraicGeometry.closedSubschemeOfStalkIdeal`; since `S` is affine, a morphism from
an affine scheme factors through it exactly when `J` dies in the coordinate ring, which is the
condition Stacks Tag 05PG tests. The geometric side of the equivalence is
`AlgebraicGeometry.condition_iff_forall_isFlatOverAt`.

For the finite-presentation refinement, the same ideal `J` can be taken finitely generated, and
over a base which is the spectrum of a local ring the finite-presentation hypothesis at `x`
upgrades the stalk map to one essentially of finite presentation: the affine neighbourhood of
`s` provided by the hypothesis is the whole of `S`, so the germ map on global sections is an
isomorphism.

## Main definitions

* `AlgebraicGeometry.closedSubschemeOfStalkIdeal` is the ideal sheaf cut out by an ideal of the
  local ring at `s`.

## Main results

* `AlgebraicGeometry.exists_closedSubscheme_flatOverAt_iff_factorStalk`: **Stacks Tag 05PH**,
  the local flattening subscheme.
* `AlgebraicGeometry.exists_finitePresentation_closedSubscheme_flatOverAt_iff_factorStalk`:
  **Stacks Tag 05PH**, the finite-presentation refinement.

## Implementation notes

A henselian local scheme with closed point `s` is represented intrinsically, by henselianity of
the stalk at `s` together with the requirement that `Spec 𝒪_{S, s} ⟶ S` be an isomorphism; the
latter in particular makes `S` affine. A closed subscheme is represented by its ideal sheaf
data, and the factorization condition is phrased as the existence of a lift of
`Spec 𝒪_{T, t} ⟶ S` along the closed immersion. The finite-presentation statement makes the
choice of subscheme finitely presented while keeping the same universal property; it does not
assert finite presentation for every subscheme produced by the first statement.

## References

* [Stacks Project, Tag 05PH](https://stacks.math.columbia.edu/tag/05PH)
* [Stacks Project, Tag 05PG](https://stacks.math.columbia.edu/tag/05PG)
* [Stacks Project, Tag 01TP](https://stacks.math.columbia.edu/tag/01TP)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

/-- The closed subscheme of `S` cut out by an ideal of the local ring of `S` at `s`, through
the comparison of global sections with that local ring. -/
def closedSubschemeOfStalkIdeal {S : Scheme.{u}} (s : S)
    (J : Ideal (S.presheaf.stalk s)) : S.IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop
    (J.comap ((S.fromSpecStalk s).appTop ≫
      (Scheme.ΓSpecIso (S.presheaf.stalk s)).hom).hom)

/-- When `S` is presented by `s` as the spectrum of its own local ring, `S` is affine and the
map on global sections of `S.fromSpecStalk s` is an isomorphism. -/
private lemma isAffine_and_isIso_appTop_fromSpecStalk {S : Scheme.{u}} (s : S)
    [IsIso (S.fromSpecStalk s)] : IsAffine S ∧ IsIso (S.fromSpecStalk s).appTop :=
  ⟨(IsAffine.iff_of_isIso (S.fromSpecStalk s)).mp inferInstance, by
    rw [← Scheme.Γ_map_op]
    exact Functor.map_isIso Scheme.Γ (S.fromSpecStalk s).op⟩

/-- The ideal of global sections cut out by `closedSubschemeOfStalkIdeal s J`. -/
private lemma ideal_top_closedSubschemeOfStalkIdeal {S : Scheme.{u}} (s : S) [IsAffine S]
    (J : Ideal (S.presheaf.stalk s)) :
    (closedSubschemeOfStalkIdeal s J).ideal ⟨⊤, isAffineOpen_top S⟩ =
      J.comap ((S.fromSpecStalk s).appTop ≫ (Scheme.ΓSpecIso (S.presheaf.stalk s)).hom).hom := by
  simp [closedSubschemeOfStalkIdeal]

/-- The kernel of the map on global sections of the closed subscheme cut out by `J`. -/
private lemma ker_appTop_subschemeι_closedSubschemeOfStalkIdeal {S : Scheme.{u}} (s : S)
    [IsAffine S] (J : Ideal (S.presheaf.stalk s)) :
    RingHom.ker (closedSubschemeOfStalkIdeal s J).subschemeι.appTop.hom =
      J.comap ((S.fromSpecStalk s).appTop ≫ (Scheme.ΓSpecIso (S.presheaf.stalk s)).hom).hom := by
  rw [← ideal_top_closedSubschemeOfStalkIdeal, ← Scheme.IdealSheafData.ker_subschemeι_app]
  rfl

/-- **A morphism out of an affine scheme which factors through the canonical morphism from the
spectrum of the local ring at `s` factors through the closed subscheme cut out by `J` exactly
when `J` dies in the coordinate ring.** Here `S` is presented by `s` as the spectrum of its own
local ring. -/
private theorem factor_through_stalk_ideal_subscheme_iff
    {S : Scheme.{u}} (s : S) [IsIso (S.fromSpecStalk s)]
    {R : CommRingCat.{u}} (J : Ideal (S.presheaf.stalk s))
    (φ : S.presheaf.stalk s ⟶ R) (q : Spec R ⟶ S)
    (hq : q = Spec.map φ ≫ S.fromSpecStalk s) :
    (∃ h : Spec R ⟶ (closedSubschemeOfStalkIdeal s J).subscheme,
      h ≫ (closedSubschemeOfStalkIdeal s J).subschemeι = q) ↔
      Ideal.map φ.hom J = ⊥ := by
  classical
  obtain ⟨_, _⟩ := isAffine_and_isIso_appTop_fromSpecStalk s
  have hκ : (q.appTop ≫ (Scheme.ΓSpecIso R).hom).hom =
      φ.hom.comp ((S.fromSpecStalk s).appTop ≫
        (Scheme.ΓSpecIso (S.presheaf.stalk s)).hom).hom := by
    rw [hq, Scheme.Hom.comp_appTop, Category.assoc, Scheme.ΓSpecIso_naturality]
    simp only [CommRingCat.hom_comp]
    rfl
  have hκker : RingHom.ker (q.appTop ≫ (Scheme.ΓSpecIso R).hom).hom =
      RingHom.ker q.appTop.hom := by
    change RingHom.ker ((Scheme.ΓSpecIso R).hom.hom.comp q.appTop.hom) = _
    exact RingHom.ker_equiv_comp q.appTop.hom
      (Scheme.ΓSpecIso R).commRingCatIsoToRingEquiv
  constructor
  · rintro ⟨h, hh⟩
    refine (Ideal.map_eq_bot_iff_le_ker φ.hom).2 fun a ha => ?_
    obtain ⟨b, rfl⟩ := ((ConcreteCategory.isIso_iff_bijective ((S.fromSpecStalk s).appTop ≫
      (Scheme.ΓSpecIso (S.presheaf.stalk s)).hom)).mp inferInstance).2 a
    have hcomp : q.appTop =
        (closedSubschemeOfStalkIdeal s J).subschemeι.appTop ≫ h.appTop := by
      rw [← hh, Scheme.Hom.comp_appTop]
    have hbKer : ((closedSubschemeOfStalkIdeal s J).subschemeι).appTop.hom b = 0 := by
      rw [← RingHom.mem_ker, ker_appTop_subschemeι_closedSubschemeOfStalkIdeal]
      exact ha
    have hqKill : (q.appTop ≫ (Scheme.ΓSpecIso R).hom).hom b = 0 := by
      change (Scheme.ΓSpecIso R).hom.hom (q.appTop.hom b) = 0
      rw [hcomp]
      simp [CommRingCat.hom_comp, hbKer]
    rw [hκ] at hqKill
    exact RingHom.mem_ker.mpr hqKill
  · intro hJ
    have hGlobal : J.comap ((S.fromSpecStalk s).appTop ≫
        (Scheme.ΓSpecIso (S.presheaf.stalk s)).hom).hom ≤ RingHom.ker q.appTop.hom := by
      rw [← hκker]
      intro b hb
      refine RingHom.mem_ker.mpr ?_
      rw [hκ]
      exact (Ideal.map_eq_bot_iff_le_ker φ.hom).mp hJ hb
    have hQ : closedSubschemeOfStalkIdeal s J ≤ q.ker := by
      apply Scheme.IdealSheafData.le_of_isAffine
      have hQker : q.ker.ideal (⟨⊤, isAffineOpen_top S⟩ : S.affineOpens) =
          RingHom.ker q.appTop.hom := by
        convert Scheme.Hom.ker_apply q (⟨⊤, isAffineOpen_top S⟩ : S.affineOpens) using 1
        rfl
      rw [hQker, ideal_top_closedSubschemeOfStalkIdeal]
      exact hGlobal
    have hLift : (closedSubschemeOfStalkIdeal s J).subschemeι.ker ≤ q.ker := by
      rwa [(closedSubschemeOfStalkIdeal s J).ker_subschemeι]
    exact ⟨IsClosedImmersion.lift (closedSubschemeOfStalkIdeal s J).subschemeι q hLift,
      IsClosedImmersion.lift_fac _ _ hLift⟩

/-- **The local flattening ideal of a pointed morphism of schemes.** For a morphism locally of
finite type and a finite type module, the local flattening condition of Stacks Tag 05ML on the
local ring of `S` at `s` is cut out by an ideal, finitely generated under finite-presentation
hypotheses. This is Stacks Tag 05PG applied to `AlgebraicGeometry.stalkFlatAtPointSituation`. -/
private theorem exists_local_flattening_ideal {X S : Scheme.{u}} (f : X ⟶ S)
    [LocallyOfFiniteType f] (F : X.Modules) [F.IsFiniteType] (x : X) (s : S) (hxs : f x = s)
    [HenselianLocalRing (S.presheaf.stalk s)] :
    ∃ J : Ideal (S.presheaf.stalk s),
      (∀ R : LocalAlgCat.{u, u} (S.presheaf.stalk s),
        (stalkFlatAtPointSituation f F x s hxs).Condition R ↔
          Ideal.map (algebraMap (S.presheaf.stalk s) R) J = ⊥) ∧
      ((algebraMap (stalkFlatAtPointSituation f F x s hxs).A
            (stalkFlatAtPointSituation f F x s hxs).B).EssentiallyOfFinitePresentation →
        Module.FinitePresentation (stalkFlatAtPointSituation f F x s hxs).B
          (stalkFlatAtPointSituation f F x s hxs).M → J.FG) := by
  have hψ : ((eqToHom (congrArg S.presheaf.stalk hxs).symm ≫
      f.stalkMap x).hom).EssFiniteType := by
    change ((f.stalkMap x).hom.comp
      (eqToHom (congrArg S.presheaf.stalk hxs).symm).hom).EssFiniteType
    exact (RingHom.EssFiniteType.respectsIso.cancel_left_isIso
      (eqToHom (congrArg S.presheaf.stalk hxs).symm) (f.stalkMap x)).mpr
      (LocallyOfFiniteType.stalkMap f x)
  have : Algebra.EssFiniteType (stalkFlatAtPointSituation f F x s hxs).A
      (stalkFlatAtPointSituation f F x s hxs).B := by
    rw [← RingHom.essFiniteType_algebraMap]
    exact hψ
  have : Module.Finite (stalkFlatAtPointSituation f F x s hxs).B
      (stalkFlatAtPointSituation f F x s hxs).M :=
    SheafOfModules.finite_stalk X.sheaf F x
  have : HenselianLocalRing (stalkFlatAtPointSituation f F x s hxs).A :=
    inferInstanceAs (HenselianLocalRing (S.presheaf.stalk s))
  exact Module.FlatAtPointSituation.exists_ideal_condition_iff_map_eq_bot_of_henselian.{u, u, u, u}
    (stalkFlatAtPointSituation f F x s hxs)

/-- The closed subscheme cut out by a local flattening ideal `J` detects flatness of the
pulled-back module above `x`. -/
private theorem forall_isFlatOverAt_iff_exists_factor_closedSubschemeOfStalkIdeal
    {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f]
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType]
    (x : X) (s : S) (hxs : f x = s)
    [HenselianLocalRing (S.presheaf.stalk s)]
    [IsIso (S.fromSpecStalk s)] (J : Ideal (S.presheaf.stalk s))
    (hJ : ∀ R : LocalAlgCat.{u, u} (S.presheaf.stalk s),
      (stalkFlatAtPointSituation f F x s hxs).Condition R ↔
        Ideal.map (algebraMap (S.presheaf.stalk s) R) J = ⊥)
    {T : Scheme.{u}} (g : T ⟶ S) (t : T) (ht : g t = s) :
    (∀ y : pullback (C := Scheme.{u}) f g,
        (pullback.snd f g y = t) →
        (pullback.fst f g y = x) →
          AlgebraicGeometry.IsFlatOverAt
            (pullback.snd f g).toLRSHom.toShHom
            ((Scheme.Modules.pullback (pullback.fst f g)).obj F) y) ↔
      ∃ h : Spec (T.presheaf.stalk t) ⟶ (closedSubschemeOfStalkIdeal s J).subscheme,
        h ≫ (closedSubschemeOfStalkIdeal s J).subschemeι = T.fromSpecStalk t ≫ g :=
  (condition_iff_forall_isFlatOverAt f g F x s t hxs ht).symm.trans
    ((hJ (pointedStalkLocalAlgebra g s t ht)).trans
      (factor_through_stalk_ideal_subscheme_iff s J
        (eqToHom (congrArg S.presheaf.stalk ht).symm ≫ g.stalkMap t)
        (T.fromSpecStalk t ≫ g)
        (BaseChangeStalk.specMap_eqToHom_stalkMap_fromSpecStalk g t ht.symm).symm).symm)

/-- **Stacks Project, Tag 05PH.** A closed subscheme detects flatness of the
pulled-back module at every point of the distinguished fibre lying above `x`. -/
@[stacks 05PH "the local flattening subscheme"]
theorem exists_closedSubscheme_flatOverAt_iff_factorStalk
    {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f]
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType]
    (x : X) (s : S) (hxs : f x = s)
    [HenselianLocalRing (S.presheaf.stalk s)]
    [IsIso (S.fromSpecStalk s)] :
    ∃ I : S.IdealSheafData,
      ∀ {T : Scheme.{u}} (g : T ⟶ S) (t : T) (_ht : g t = s),
        (∀ y : pullback (C := Scheme.{u}) f g,
            (pullback.snd f g y = t) →
            (pullback.fst f g y = x) →
              AlgebraicGeometry.IsFlatOverAt
                (pullback.snd f g).toLRSHom.toShHom
                ((Scheme.Modules.pullback (pullback.fst f g)).obj F) y) ↔
          ∃ h : Spec (T.presheaf.stalk t) ⟶ I.subscheme,
            h ≫ I.subschemeι = T.fromSpecStalk t ≫ g := by
  obtain ⟨J, hJ, -⟩ := exists_local_flattening_ideal f F x s hxs
  refine ⟨closedSubschemeOfStalkIdeal s J, ?_⟩
  intro T g t ht
  exact forall_isFlatOverAt_iff_exists_factor_closedSubschemeOfStalkIdeal f F x s hxs J hJ g t ht

/-- An open subset of a scheme presented by `s` as the spectrum of its own local ring which
contains `s` is the whole scheme. -/
private lemma open_eq_top_of_mem_closedPoint {S : Scheme.{u}} (s : S)
    [IsIso (S.fromSpecStalk s)] (V : S.Opens) (hs : s ∈ V) : V = ⊤ := by
  have hpre : S.fromSpecStalk s ⁻¹ᵁ V = ⊤ :=
    Scheme.preimage_eq_top_of_closedPoint_mem _
      (by simpa only [Scheme.fromSpecStalk_closedPoint] using hs)
  apply top_unique
  intro z _
  obtain ⟨w, rfl⟩ := (S.fromSpecStalk s).surjective z
  change w ∈ S.fromSpecStalk s ⁻¹ᵁ V
  rw [hpre]
  trivial

/-- On a scheme presented by `s` as the spectrum of its own local ring, the germ map on global
sections at `s` is an isomorphism. -/
private lemma isIso_germTop_of_fromSpecStalk {S : Scheme.{u}} (s : S)
    [IsIso (S.fromSpecStalk s)] : IsIso (S.presheaf.germ ⊤ s trivial) := by
  obtain ⟨_, _⟩ := isAffine_and_isIso_appTop_fromSpecStalk s
  have he : S.presheaf.germ ⊤ s trivial =
      (S.fromSpecStalk s).appTop ≫ (Scheme.ΓSpecIso (S.presheaf.stalk s)).hom := by
    rw [Scheme.fromSpecStalk_appTop]
    simp
  rw [he]
  infer_instance

/-- **A morphism of finite presentation at `x` over a base presented by `f x` as the spectrum
of its own local ring induces a stalk homomorphism essentially of finite presentation.** -/
private lemma essentiallyOfFinitePresentation_stalkMap_of_finitePresentationAt
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) [IsIso (S.fromSpecStalk (f x))]
    (hfp : FinitePresentationAt f x) :
    (f.stalkMap x).hom.EssentiallyOfFinitePresentation := by
  obtain ⟨⟨V, hV⟩, ⟨U, hU⟩, hx, hUV, hfp⟩ := hfp
  obtain rfl : V = ⊤ := open_eq_top_of_mem_closedPoint (f x) V (hUV hx)
  have : IsIso (S.presheaf.germ ⊤ (f x) trivial) := isIso_germTop_of_fromSpecStalk (f x)
  let : Algebra (S.presheaf.stalk (f x)) (X.presheaf.stalk x) :=
    (f.stalkMap x).hom.toAlgebra
  let : Algebra (S.presheaf.stalk (f x)) Γ(X, U) :=
    (inv (S.presheaf.germ ⊤ (f x) trivial) ≫ f.appLE ⊤ U hUV).hom.toAlgebra
  let : Algebra Γ(X, U) (X.presheaf.stalk x) := (X.presheaf.germ U x hx).hom.toAlgebra
  have hcomp : S.presheaf.germ ⊤ (f x) trivial ≫ f.stalkMap x =
      f.appLE ⊤ U hUV ≫ X.presheaf.germ U x hx := by
    rw [Scheme.Hom.appLE, Category.assoc, X.presheaf.germ_res]
    exact Scheme.Hom.germ_stalkMap f ⊤ x trivial
  have htower : f.stalkMap x =
      (inv (S.presheaf.germ ⊤ (f x) trivial) ≫ f.appLE ⊤ U hUV) ≫
        X.presheaf.germ U x hx := by
    rw [Category.assoc, ← hcomp]
    simp
  have : IsScalarTower (S.presheaf.stalk (f x)) Γ(X, U) (X.presheaf.stalk x) :=
    IsScalarTower.of_algebraMap_eq' (congrArg CommRingCat.Hom.hom htower)
  have hfp' : (inv (S.presheaf.germ ⊤ (f x) trivial) ≫
      f.appLE ⊤ U hUV).hom.FinitePresentation :=
    RingHom.FinitePresentation.comp hfp
      (RingHom.FinitePresentation.of_bijective
        ((ConcreteCategory.isIso_iff_bijective
          (inv (S.presheaf.germ ⊤ (f x) trivial))).mp inferInstance))
  have : Algebra.FinitePresentation (S.presheaf.stalk (f x)) Γ(X, U) := hfp'
  have : IsLocalization (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl
      (X.presheaf.stalk x) := hU.isLocalization_stalk ⟨x, hx⟩
  exact ⟨Γ(X, U), inferInstance, inferInstance, inferInstance, inferInstance,
    inferInstance, (hU.primeIdealOf ⟨x, hx⟩).asIdeal.primeCompl, inferInstance⟩

/-- The closed subscheme cut out by a finitely generated ideal of the local ring of `S` at `s`
is of finite presentation over `S`, when `S` is presented by `s` as the spectrum of its own
local ring. -/
private lemma finitePresentation_closedSubschemeOfStalkIdeal {S : Scheme.{u}} (s : S)
    [IsIso (S.fromSpecStalk s)] (J : Ideal (S.presheaf.stalk s)) (hJ : J.FG) :
    FinitePresentation (closedSubschemeOfStalkIdeal s J).subschemeι := by
  obtain ⟨_, _⟩ := isAffine_and_isIso_appTop_fromSpecStalk s
  have hK : (J.comap ((S.fromSpecStalk s).appTop ≫
      (Scheme.ΓSpecIso (S.presheaf.stalk s)).hom).hom).FG := by
    have h1 : J.comap ((S.fromSpecStalk s).appTop ≫
          (Scheme.ΓSpecIso (S.presheaf.stalk s)).hom).hom =
        J.map (inv ((S.fromSpecStalk s).appTop ≫
          (Scheme.ΓSpecIso (S.presheaf.stalk s)).hom)).hom :=
      Ideal.comap_symm (I := J)
        ((asIso ((S.fromSpecStalk s).appTop ≫
          (Scheme.ΓSpecIso (S.presheaf.stalk s)).hom)).symm).commRingCatIsoToRingEquiv
    rw [h1]
    exact hJ.map _
  have hker : (RingHom.ker
      (closedSubschemeOfStalkIdeal s J).subschemeι.appTop.hom).FG := by
    rw [ker_appTop_subschemeι_closedSubschemeOfStalkIdeal]
    exact hK
  have : IsAffine (closedSubschemeOfStalkIdeal s J).subscheme :=
    isAffine_of_isAffineHom (closedSubschemeOfStalkIdeal s J).subschemeι
  have : LocallyOfFinitePresentation
      (closedSubschemeOfStalkIdeal s J).subschemeι := by
    refine (HasRingHomProperty.iff_of_isAffine (P := @LocallyOfFinitePresentation)).mpr
      (.of_surjective _ ?_ hker)
    exact (closedSubschemeOfStalkIdeal s J).subschemeι_app_surjective
      ⟨⊤, isAffineOpen_top S⟩
  exact ⟨inferInstance, inferInstance, inferInstance⟩

/-- **Stacks Project, Tag 05PH.** Under pointwise finite-presentation
hypotheses, the local flattening subscheme can be finitely presented. -/
@[stacks 05PH "finite-presentation refinement"]
theorem exists_finitePresentation_closedSubscheme_flatOverAt_iff_factorStalk
    {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f]
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType]
    (x : X) (s : S) (hxs : f x = s)
    [HenselianLocalRing (S.presheaf.stalk s)]
    [IsIso (S.fromSpecStalk s)]
    (hfp : FinitePresentationAt f x)
    (hFfp :
      letI : Module (X.presheaf.stalk x)
          (TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf x) :=
        PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
          (R := X.presheaf) F.val x
      Module.FinitePresentation (X.presheaf.stalk x)
        (TopCat.Presheaf.stalk (C := Ab.{u}) F.val.presheaf x)) :
    ∃ I : S.IdealSheafData,
      FinitePresentation I.subschemeι ∧
      ∀ {T : Scheme.{u}} (g : T ⟶ S) (t : T) (_ht : g t = s),
        (∀ y : pullback (C := Scheme.{u}) f g,
            (pullback.snd f g y = t) →
            (pullback.fst f g y = x) →
              AlgebraicGeometry.IsFlatOverAt
                (pullback.snd f g).toLRSHom.toShHom
                ((Scheme.Modules.pullback (pullback.fst f g)).obj F) y) ↔
          ∃ h : Spec (T.presheaf.stalk t) ⟶ I.subscheme,
            h ≫ I.subschemeι = T.fromSpecStalk t ≫ g := by
  subst s
  obtain ⟨J, hJ, hJfg⟩ := exists_local_flattening_ideal f F x (f x) rfl
  have hB : (algebraMap (stalkFlatAtPointSituation f F x (f x) rfl).A
      (stalkFlatAtPointSituation f F x (f x) rfl).B).EssentiallyOfFinitePresentation := by
    change ((eqToHom (congrArg S.presheaf.stalk (rfl : f x = f x)).symm ≫
      f.stalkMap x).hom).EssentiallyOfFinitePresentation
    rw [show (eqToHom (congrArg S.presheaf.stalk (rfl : f x = f x)).symm ≫
      f.stalkMap x) = f.stalkMap x from by simp]
    exact essentiallyOfFinitePresentation_stalkMap_of_finitePresentationAt f x hfp
  have hM : Module.FinitePresentation (stalkFlatAtPointSituation f F x (f x) rfl).B
      (stalkFlatAtPointSituation f F x (f x) rfl).M := hFfp
  refine ⟨closedSubschemeOfStalkIdeal (f x) J,
