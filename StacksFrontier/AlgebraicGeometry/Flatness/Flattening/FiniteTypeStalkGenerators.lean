module

public import StacksCore.RingTheory.Support
public import StacksFrontier.AlgebraicGeometry.Divisors.AssociatedPoints.Finiteness
public import StacksFrontier.AlgebraicGeometry.Flatness.FlatteningFunctors.FlatPullbackStalkFree
public import StacksFrontier.AlgebraicGeometry.Scheme.Points.ModuleStalkSpecialization

/-!
# Generators on an affine neighbourhood from a free stalk

Let `F` be a quasi-coherent `𝒪_X`-module of finite type and let `x : X` be a point at which the
stalk `F_x` is free of rank `p` over `𝒪_{X,x}`. Then there is an **affine** open `U ∋ x` and `p`
sections of `F` over `U` which generate `Γ(F, U)` as a `Γ(X, U)`-module.

## Main results

* `AlgebraicGeometry.exists_affineOpen_span_sections_of_stalkFreeOfRank`: an affine open
  neighbourhood of `x` on which `p` sections of `F` span the sections of `F`.
* `AlgebraicGeometry.exists_affineOpen_surjective_sections_of_stalkFreeOfRank`: the same
  conclusion read as surjectivity of `fun c ↦ ∑ i, c i • s i`.

## References

* [Stacks Project, Tag 05MS](https://stacks.math.columbia.edu/tag/05MS)
* [Stacks Project, Tag 01B8](https://stacks.math.columbia.edu/tag/01B8)
* [Stacks Project, Tag 0GLX](https://stacks.math.columbia.edu/tag/0GLX)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace
open Stacks.AlgebraicGeometry.QuasicoherentBaseChange
open Stacks.ModuleStalkSpecialization

universe u v w z

namespace AlgebraicGeometry

/-! ### Lifting a spanning family through a localization map -/

/-- **A spanning family of a localized module comes from a family of elements of the module.**
If `f : N →ₗ[A] M` makes `M` the localization of `N` at `q` and `g` spans `M` over the localized
ring `B`, then there is a family `m` in `N`, indexed by the same type, whose image under `f`
spans `M` over `B`. -/
private theorem exists_span_image_eq_top_of_span_eq_top {A : Type u} [CommRing A]
    (q : Submonoid A) {B : Type v} [CommRing B] [Algebra A B] [IsLocalization q B]
    {N : Type w} [AddCommGroup N] [Module A N] {M : Type z} [AddCommGroup M] [Module A M]
    [Module B M] [IsScalarTower A B M] (f : N →ₗ[A] M) [IsLocalizedModule q f]
    {ι : Type*} (g : ι → M) (hg : Submodule.span B (Set.range g) = ⊤) :
    ∃ m : ι → N, Submodule.span B (f '' Set.range m) = ⊤ := by
  classical
  have hsurj : ∀ i, ∃ (n : N) (c : q), (c : A) • g i = f n := fun i ↦ by
    obtain ⟨⟨n, c⟩, hnc⟩ := IsLocalizedModule.surj q f (g i)
    exact ⟨n, c, by simpa [Submonoid.smul_def] using hnc⟩
  choose m c hmc using hsurj
  refine ⟨m, top_le_iff.mp ?_⟩
  rw [← hg]
  refine Submodule.span_le.mpr (Set.range_subset_iff.mpr fun i ↦ ?_)
  obtain ⟨u, hu⟩ := IsLocalization.map_units B (c i)
  have h1 : (algebraMap A B (c i : A)) • g i = f (m i) := by
    rw [algebraMap_smul]; exact hmc i
  have h2 : g i = (↑u⁻¹ : B) • f (m i) := by
    rw [← h1, ← hu, smul_smul, u.inv_mul, one_smul]
  rw [SetLike.mem_coe, h2]
  exact Submodule.smul_mem _ _
    (Submodule.subset_span (Set.mem_image_of_mem f (Set.mem_range_self i)))

/-! ### Generators on an affine neighbourhood -/

/-- **A finite-type quasi-coherent module with free stalk of rank `p` at a point is generated by
`p` sections on an affine neighbourhood of that point.** -/
theorem exists_affineOpen_span_sections_of_stalkFreeOfRank {X : Scheme.{u}} (F : X.Modules)
    [F.IsQuasicoherent] [F.IsFiniteType] (x : X) (p : ℕ)
    (h : AlgebraicGeometry.StalkFreeOfRank F x p) :
    ∃ (U : X.Opens) (_ : IsAffineOpen U) (_ : x ∈ U) (s : Fin p → Γ(F, U)),
      Submodule.span Γ(X, U) (Set.range s) = ⊤ := by
  classical
  obtain ⟨V, hV, hxV, -⟩ :=
    exists_isAffineOpen_mem_and_subset (X := X) (x := x) (U := ⊤) trivial
  let : Algebra Γ(X, V) (X.presheaf.stalk x) := (X.presheaf.germ V x hxV).hom.toAlgebra
  have : IsLocalization.AtPrime (X.presheaf.stalk x) (hV.primeIdealOf ⟨x, hxV⟩).asIdeal :=
    hV.isLocalization_stalk ⟨x, hxV⟩
  let := stalkModule F x
  let := sectionsStalkModule F hxV
  have := isScalarTower_sectionsStalk F hxV
  have := isLocalizedModule_germₗ F hV hxV
  have := moduleFinite_sections_on_affine F V hV
  obtain ⟨e⟩ := h
  have hbspan : Submodule.span (X.presheaf.stalk x)
      (Set.range (Finsupp.basisSingleOne.map e.symm : Fin p → F.presheaf.stalk x)) = ⊤ :=
    (Finsupp.basisSingleOne.map e.symm).span_eq
  obtain ⟨m, hm⟩ := exists_span_image_eq_top_of_span_eq_top
    (hV.primeIdealOf ⟨x, hxV⟩).asIdeal.primeCompl (germₗ F hxV) _ hbspan
  obtain ⟨a, ha, hspan⟩ := Submodule.exists_mem_and_span_image_eq_top
    (hV.primeIdealOf ⟨x, hxV⟩).asIdeal.primeCompl (Set.range m)
    ((Submodule.span_image_eq_top_iff (X.presheaf.stalk x) _ (germₗ F hxV) _).mp hm)
  have hxa : x ∈ X.basicOpen a := by
    rw [X.mem_basicOpen a x hxV]
    exact (IsLocalization.AtPrime.isUnit_to_map_iff (X.presheaf.stalk x)
      (hV.primeIdealOf ⟨x, hxV⟩).asIdeal a).mpr ha
  let := algebraOfLE X (X.basicOpen_le a)
  have := hV.isLocalization_basicOpen a
  let := moduleOfLE F (X.basicOpen_le a)
  have : IsScalarTower Γ(X, V) Γ(X, X.basicOpen a) Γ(F, X.basicOpen a) :=
    isScalarTowerOfLE F (X.basicOpen_le a)
  have := isLocalizedModule_restrictₗ F hV a rfl (X.basicOpen_le a)
  refine ⟨X.basicOpen a, hV.basicOpen a, hxa,
    fun i ↦ restrictₗ F (X.basicOpen_le a) (m i), ?_⟩
  have hfinal := hspan (Rf := Γ(X, X.basicOpen a)) (Mf := Γ(F, X.basicOpen a))
    (restrictₗ F (X.basicOpen_le a))
  rwa [← Set.range_comp] at hfinal

/-- **The spanning family of `exists_affineOpen_span_sections_of_stalkFreeOfRank` read as a
surjection.** Every section of `F` over the affine open is a `Γ(X, U)`-combination of the `p`
sections. -/
theorem exists_affineOpen_surjective_sections_of_stalkFreeOfRank {X : Scheme.{u}}
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType] (x : X) (p : ℕ)
    (h : AlgebraicGeometry.StalkFreeOfRank F x p) :
    ∃ (U : X.Opens) (_ : IsAffineOpen U) (_ : x ∈ U) (s : Fin p → Γ(F, U)),
      Function.Surjective fun c : Fin p → Γ(X, U) ↦ ∑ i, c i • s i := by
  obtain ⟨U, hU, hxU, s, hs⟩ := exists_affineOpen_span_sections_of_stalkFreeOfRank F x p h
  refine ⟨U, hU, hxU, s, fun y ↦ ?_⟩
  exact (Submodule.mem_span_range_iff_exists_fun Γ(X, U)).mp (hs.ge Submodule.mem_top)

end AlgebraicGeometry

end
