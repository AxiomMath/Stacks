/-!
# Charts of Situation 05MP exist

For the family `f : X ⟶ S` of Situation 05MP with its finite type quasi-coherent module `ℱ`, the
module pulled back to the fibre over a point `s` is free of some rank `p(s)` near the generic
point of that fibre, because the fibre is integral and locally Noetherian. Around `s` there is
then a chart of the situation of rank `p(s)`: an affine open `V ∋ s`, inside any prescribed open,
an affine open `U ⊆ f⁻¹(V)` surjecting onto `V`, and a surjection `𝒪_U^{⊕ p(s)} ⟶ ℱ|_U`. This is
the step of the proof of Tag 05UC which shrinks `X` so that `ℱ` is generated by `p(s)` sections.

## Main results

* `AlgebraicGeometry.FreeAtGenericPointsSituation.exists_condition_residueField`: the condition
  of Situation 05MP holds over the spectrum of each residue field of the base, for some rank.
* `AlgebraicGeometry.FreeAtGenericPointsSituation.exists_chart`: a chart of the rank attached to
  a point exists around that point, inside any open neighbourhood of it.

## Implementation notes

Freeness of rank `p` near the generic point of the fibre gives generation by `p` sections near
that point of the fibre, and generation by `p` sections near a point descends along any morphism
(`AlgebraicGeometry.isGeneratedByNear_of_pullback`, a Fitting ideal computation which contains
Nakayama's lemma). The generating sections over an open of `X` become a surjection from a finite
free module on every smaller open subscheme.

## References

* [Stacks Project, Tag 05MP](https://stacks.math.columbia.edu/tag/05MP)
* [Stacks Project, Tag 05UC](https://stacks.math.columbia.edu/tag/05UC)
* [Stacks Project, Tag 0B8J](https://stacks.math.columbia.edu/tag/0B8J)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace AlgebraicGeometry

/-- A module free of rank `r` near a point is generated by `r` sections near that point. -/
theorem isGeneratedByNear_of_freeAtPointOfRank {X : Scheme.{u}} (M : X.Modules) {x : X}
    {r : ℕ} (h : FreeAtPointOfRank M x r) : IsGeneratedByNear M r x := by
  obtain ⟨W, hxW, -, ⟨e⟩⟩ :=
    exists_restrict_iso_free_le_of_freeAtPointOfRank M x r ⊤ trivial h
  refine ⟨W, hxW, ⟨ULift (Fin r), (M.over W).freeHomEquiv (Stacks.Modules.freeIsoOver W M _ e).hom,
    ?_⟩, ⟨Equiv.ulift⟩⟩
  rw [Equiv.symm_apply_apply]
  infer_instance

/-- Generating sections of a module over an open `W` with `n` members give a surjection from the
free module of rank `n` onto the restriction of the module to any smaller open subscheme. -/
theorem exists_epi_coproductUnit_of_generatingSections {X : Scheme.{u}} (F : X.Modules)
    {n : ℕ} {W : X.Opens} (g : (F.over W).GeneratingSections) (e : g.I ≃ Fin n) {U : X.Opens}
    (hU : U ≤ W) :
    ∃ u : (∐ fun _ : Fin n => SheafOfModules.unit U.toScheme.ringCatSheaf :
        U.toScheme.Modules) ⟶ (Scheme.Modules.pullback U.ι).obj F, Epi u := by
  let E := (Scheme.Modules.overEquiv W).functor
  let ι : ULift.{u} (Fin n) ≃ g.I := Equiv.ulift.trans e.symm
  let α : (∐ fun _ : Fin n => SheafOfModules.unit W.toScheme.ringCatSheaf :
      W.toScheme.Modules) ⟶ (Scheme.Modules.pullback W.ι).obj F :=
    (Stacks.StalkFreeBridge.coproductUnitIsoFree n).hom ≫
      ((SheafOfModules.freeFunctor (R := W.toScheme.ringCatSheaf)).mapIso ι.toIso).hom ≫
      (Stacks.Modules.freeOverEquivIso W g.I).hom ≫ E.map g.π ≫
      ((Scheme.Modules.overFunctorEquiv W).app F).hom ≫
      ((Scheme.Modules.restrictFunctorIsoPullback W.ι).app F).hom
  have : Epi (E.map g.π) := E.map_epi g.π
  have : Epi α := by
    dsimp only [α]
    have hiso {A B : W.toScheme.Modules} (i : A ≅ B) : Epi i.hom :=
      @IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_hom i)
    exact epi_comp' (hiso _) (epi_comp' (hiso _) (epi_comp' (hiso _) (epi_comp' ‹_›
      (epi_comp' (hiso _) (hiso _)))))
  let k : U.toScheme ⟶ W.toScheme := X.homOfLE hU
  refine ⟨(pullbackCoproductUnitIso k n).inv ≫ (Scheme.Modules.pullback k).map α ≫
    ((Scheme.Modules.pullbackComp k W.ι).app F).hom ≫
    ((Scheme.Modules.pullbackCongr (X.homOfLE_ι hU)).app F).hom, inferInstance⟩

namespace FreeAtGenericPointsSituation

variable (D : FreeAtGenericPointsSituation.{u})

/-- **The rank at a point of the base.** Over the spectrum of the residue field of a point of the
base, the condition of Situation 05MP holds for some rank: the fibre is integral and locally
Noetherian, so the module pulled back to it is free of some rank near its generic point, and the
spectrum of a field has only one point. -/
theorem exists_condition_residueField (s : D.S) :
    ∃ q, D.Condition q (Over.mk (D.S.fromSpecResidueField s)) := by
  let T : Over D.S := Over.mk (D.S.fromSpecResidueField s)
  let Y : Scheme.{u} := pullback D.f T.hom
  have := D.geometricallyIntegral_f
  have : IsIntegral Y := inferInstanceAs (IsIntegral (D.f.fiber s))
  have : IsLocallyNoetherian T.left :=
    inferInstanceAs (IsLocallyNoetherian (Spec (D.S.residueField s)))
  have : IsLocallyNoetherian Y :=
    LocallyOfFiniteType.isLocallyNoetherian (D.baseChangeMap T)
  have : (D.baseChangeModule T).IsFiniteType :=
    SheafOfModules.pullback_isFiniteType (pullback.fst D.f T.hom).toLRSHom.toShHom D.F
  have : (D.baseChangeModule T).IsCoherent :=
    Stacks.AlgebraicGeometry.CoherentKernel.isCoherent_of_isQuasicoherent_isFiniteType _
  open Stacks.AlgebraicGeometry.IrreducibleDevissage in
  obtain ⟨r, U, hU, ⟨e⟩⟩ := exists_isIso_restrictFunctor_free_near_genericPoint
    (D.baseChangeModule T) (genericPoint Y) (genericPoint_spec Y)
  refine ⟨r, (D.condition_iff_baseRankLocus_eq_univ r T).mpr
    (Set.eq_univ_iff_forall.mpr fun t ↦ ?_)⟩
  refine ⟨genericPoint Y, freeAtPointOfRank_of_restrict_iso_free _ hU r
    (e.symm ≪≫ _root_.restrictFunctor_obj_free_iso U.ι _), ?_⟩
  exact Subsingleton.elim (α := PrimeSpectrum (D.S.residueField s)) _ _

/-- If the condition of Situation 05MP holds with rank `q` over the spectrum of the residue field
of a point `s` of the base, then `ℱ` is generated by `q` sections near some point over `s`. -/
theorem exists_isGeneratedByNear_of_condition_residueField {s : D.S} {q : ℕ}
    (hq : D.Condition q (Over.mk (D.S.fromSpecResidueField s))) :
    ∃ x : D.X, D.f.base x = s ∧ IsGeneratedByNear D.F q x := by
  let T : Over D.S := Over.mk (D.S.fromSpecResidueField s)
  let t : T.left := (default : PrimeSpectrum (D.S.residueField s))
  obtain ⟨ξ, hξ⟩ := D.exists_isGenericPoint_fiber_baseChangeMap T t
  let y := (D.baseChangeMap T).fiberι t ξ
  refine ⟨(pullback.fst D.f T.hom).base y, ?_, isGeneratedByNear_of_pullback _ D.F q y
    (isGeneratedByNear_of_freeAtPointOfRank _ (hq t ξ hξ))⟩
  have hc := congrArg (fun k : pullback D.f T.hom ⟶ D.S ↦ k.base y)
    (pullback.condition (f := D.f) (g := T.hom))
  simp only [Scheme.Hom.comp_base, TopCat.comp_app] at hc
  exact hc.trans (Scheme.fromSpecResidueField_apply _ _)

/-- **Charts exist.** If the condition of Situation 05MP holds with rank `q` over the spectrum of
the residue field of a point `s` of the base, then inside any open neighbourhood `W` of `s` there
is a chart of rank `q` whose affine open of the base contains `s`. -/
theorem exists_chart {s : D.S} (W : D.S.Opens) (hs : s ∈ W) {q : ℕ}
    (hq : D.Condition q (Over.mk (D.S.fromSpecResidueField s))) :
    ∃ c : D.Chart, s ∈ c.V ∧ c.V ≤ W ∧ c.n = q := by
  obtain ⟨x, hxs, W₀, hxW₀, g, ⟨e⟩⟩ :=
    D.exists_isGeneratedByNear_of_condition_residueField hq
  obtain ⟨_, ⟨V₁, hV₁, rfl⟩, hsV₁, hV₁W⟩ :=
    D.S.isBasis_affineOpens.exists_subset_of_mem_open hs W.2
  have hxV₁ : x ∈ W₀ ⊓ D.f ⁻¹ᵁ V₁ := ⟨hxW₀, by simpa [Scheme.Hom.mem_preimage, hxs] using hsV₁⟩
  obtain ⟨_, ⟨U₀, hU₀, rfl⟩, hxU₀, hU₀le⟩ :=
    D.X.isBasis_affineOpens.exists_subset_of_mem_open hxV₁ (W₀ ⊓ D.f ⁻¹ᵁ V₁).2
  have hU₀V₁ : U₀ ≤ D.f ⁻¹ᵁ V₁ := fun _ hz ↦ (hU₀le hz).2
  let O : D.S.Opens := ⟨D.f.base '' (U₀ : Set D.X), D.f.isOpenMap _ U₀.2⟩
  obtain ⟨h, hhO, hsh⟩ := IsAffineOpen.exists_basicOpen_le hV₁ (V := O)
    ⟨s, x, hxU₀, hxs⟩ hsV₁
  let V : D.S.Opens := D.S.basicOpen h
  let U : D.X.Opens := U₀ ⊓ D.f ⁻¹ᵁ V
  have hUeq : U = D.X.basicOpen (D.X.presheaf.map (homOfLE hU₀V₁).op (D.f.app V₁ h)) := by
    rw [Scheme.basicOpen_res, ← Scheme.preimage_basicOpen]
  have hU : IsAffineOpen U := hUeq ▸ IsAffineOpen.basicOpen hU₀ _
  obtain ⟨u, hu⟩ := exists_epi_coproductUnit_of_generatingSections D.F g e
    (U := U) fun _ hz ↦ (hU₀le hz.1).1
  refine ⟨Chart.mk V (hV₁.basicOpen h) U hU inf_le_right (fun v hv ↦ ?_) q u, hsh,
    fun _ hz ↦ hV₁W (D.S.basicOpen_le h hz), rfl⟩
  obtain ⟨x', hx', rfl⟩ := hhO hv
  exact ⟨x', ⟨hx', hv⟩, rfl⟩

end FreeAtGenericPointsSituation

end AlgebraicGeometry

end
