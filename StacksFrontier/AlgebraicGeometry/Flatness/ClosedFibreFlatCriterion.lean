module

public import StacksFrontier.AlgebraicGeometry.Flatness.Flattening.HenselizationReduction
public import StacksFrontier.RingTheory.Flat.ClosedFibreLocalization

/-!
# Flatness from flatness at the associated primes of the closed fibre

Let `R → S` be a local homomorphism of local rings which is essentially of finite type and let
`N` be a finite `S`-module. This file proves that `N` is flat over `R` as soon as `N_p` is flat
over `R` for every associated prime `p` of the closed fibre `N / 𝔪_R N`.

This is the commutative algebra underlying the converse implication of Stacks 05UA, which is
`AlgebraicGeometry.isFlatOverAt_of_forall_isAssociatedPoint_specializes`.

## Main results

* `Stacks.Flatness.injective_mapQ_mkLinearMap_nonZeroSMulDivisors`: the localization map
  `N → Σ⁻¹N` at the elements regular on the closed fibre is injective modulo `𝔪_R`.
* `Stacks.Flatness.flat_of_forall_flat_atPrime_assStacks_closedFibre`: `N` is flat over `R` as
  soon as `N_p` is flat over `R` at every associated prime `p` of the closed fibre.

## Implementation notes

The Stacks proof of 05UA has two steps besides Stacks 0AT4
(`AlgebraicGeometry.universallyInjective_and_finitePresentation_and_flat_of_linearMap`). The
localization step — `Σ⁻¹N` is flat over `R` — is
`Stacks.Flatness.flat_localizedModule_nonZeroSMulDivisors_closedFibre`. The injectivity step is
`injective_mapQ_mkLinearMap_nonZeroSMulDivisors`: writing `P = 𝔪_R S · N` and `W = N / P`, the
localization `Σ⁻¹W` is killed by `𝔪_R S`, so the `S`-linear map `Σ⁻¹N → Σ⁻¹W` induced by `N → W`
kills `𝔪_R S · Σ⁻¹N`; an element of `N` whose image in `Σ⁻¹N` lies in `𝔪_R · Σ⁻¹N` therefore has
zero image in `Σ⁻¹W`, hence is killed in `W` by some element of `Σ`, hence lies in `P` because the
elements of `Σ` act injectively on `W`. The two spellings `𝔪_R • ⊤` over `R` and `𝔪_R S • ⊤` over
`S` of the closed-fibre submodule are reconciled by `Ideal.smul_restrictScalars`.

## References

* [Stacks Project, Tag 0AT4](https://stacks.math.columbia.edu/tag/0AT4)
* [Stacks Project, Tag 05UA](https://stacks.math.columbia.edu/tag/05UA)
-/

@[expose] public section

open IsLocalRing

universe u v w

namespace Stacks.Flatness

section ClosedFibre

variable {R : Type u} {S : Type v} {N : Type w}
  [CommRing R] [IsLocalRing R] [CommRing S] [Algebra R S]
  [AddCommGroup N] [Module S N] [Module R N] [IsScalarTower R S N]

/-- Over the closed-fibre ring the two spellings of the closed-fibre submodule agree: the
`R`-submodule `𝔪_R · X` and the `S`-submodule generated by the extension of `𝔪_R` have the same
elements. -/
theorem mem_maximalIdeal_smul_top_iff_mem_map_smul_top (X : Type*) [AddCommGroup X] [Module S X]
    [Module R X] [IsScalarTower R S X] (x : X) :
    x ∈ maximalIdeal R • (⊤ : Submodule R X) ↔
      x ∈ Ideal.map (algebraMap R S) (maximalIdeal R) • (⊤ : Submodule S X) := by
  rw [← Submodule.restrictScalars_mem R
    (Ideal.map (algebraMap R S) (maximalIdeal R) • (⊤ : Submodule S X)) x,
    Ideal.smul_restrictScalars, Submodule.restrictScalars_top]

omit [Module R N] [IsScalarTower R S N] in
/-- The extension of `𝔪_R` to `S` kills every localization of the closed fibre `N / 𝔪_R N`. -/
private lemma smul_localizedModule_quotient_eq_zero (T : Submonoid S) {a : S}
    (ha : a ∈ Ideal.map (algebraMap R S) (maximalIdeal R))
    (y : LocalizedModule T
      (N ⧸ (Ideal.map (algebraMap R S) (maximalIdeal R) • (⊤ : Submodule S N)))) :
    a • y = 0 := by
  refine LocalizedModule.induction_on (fun w s => ?_) y
  rw [LocalizedModule.smul'_mk]
  obtain ⟨n, rfl⟩ :=
    Submodule.mkQ_surjective
      (Ideal.map (algebraMap R S) (maximalIdeal R) • (⊤ : Submodule S N)) w
  have : a • (Ideal.map (algebraMap R S) (maximalIdeal R) •
      (⊤ : Submodule S N)).mkQ n = 0 := by
    rw [← map_smul, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact Submodule.smul_mem_smul ha trivial
  rw [this, LocalizedModule.zero_mk]

/-- **The localization map at the elements regular on the closed fibre is injective modulo
`𝔪_R`.** An element of `N` whose image in `Σ⁻¹N` lies in `𝔪_R · Σ⁻¹N` is killed in the closed
fibre by an element of `Σ`, hence already lies in `𝔪_R · N`. -/
theorem comap_mkLinearMap_maximalIdeal_smul_top_le (n : N)
    (hn : LocalizedModule.mkLinearMap
        (nonZeroSMulDivisors S
          (N ⧸ (Ideal.map (algebraMap R S) (maximalIdeal R) • (⊤ : Submodule S N)))) N n ∈
      maximalIdeal R • (⊤ : Submodule R (LocalizedModule
        (nonZeroSMulDivisors S
          (N ⧸ (Ideal.map (algebraMap R S) (maximalIdeal R) • (⊤ : Submodule S N)))) N))) :
    n ∈ maximalIdeal R • (⊤ : Submodule R N) := by
  set P : Submodule S N :=
    Ideal.map (algebraMap R S) (maximalIdeal R) • (⊤ : Submodule S N) with hP
  set T : Submonoid S := nonZeroSMulDivisors S (N ⧸ P) with hT
  set Λ := IsLocalizedModule.map T (LocalizedModule.mkLinearMap T N)
    (LocalizedModule.mkLinearMap T (N ⧸ P)) P.mkQ with hΛ
  -- `Λ` kills the closed-fibre submodule of `Σ⁻¹N`.
  have hkill : Ideal.map (algebraMap R S) (maximalIdeal R) •
      (⊤ : Submodule S (LocalizedModule T N)) ≤ LinearMap.ker Λ := by
    refine Submodule.smul_le.mpr fun a ha x _ => ?_
    rw [LinearMap.mem_ker, map_smul]
    exact smul_localizedModule_quotient_eq_zero T ha _
  -- Hence the image of `n` in `Σ⁻¹(N / 𝔪_R N)` vanishes.
  have hzero : LocalizedModule.mkLinearMap T (N ⧸ P) (P.mkQ n) = 0 := by
    have hmem := (mem_maximalIdeal_smul_top_iff_mem_map_smul_top (S := S) _ _).mp hn
    have := hkill hmem
    rwa [LinearMap.mem_ker, hΛ, IsLocalizedModule.map_apply] at this
  -- An element of `Σ` kills the class of `n`, and the elements of `Σ` act injectively.
  obtain ⟨σ, hσ⟩ :=
    (IsLocalizedModule.eq_zero_iff T (LocalizedModule.mkLinearMap T (N ⧸ P))).mp hzero
  have hreg : IsSMulRegular (N ⧸ P) (σ : S) :=
    isSMulRegular_iff_mem_nonZeroSMulDivisors.mpr σ.2
  have hcancel : (σ : S) • P.mkQ n = (σ : S) • (0 : N ⧸ P) := by
    rw [smul_zero, ← Submonoid.smul_def]
    exact hσ
  have : P.mkQ n = 0 := hreg hcancel
  rw [mem_maximalIdeal_smul_top_iff_mem_map_smul_top (S := S), ← hP]
  rwa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at this

/-- **The localization map at the elements regular on the closed fibre is injective modulo
`𝔪_R`**, in the `Submodule.mapQ` form that Situation 0AT0 asks for. -/
theorem injective_mapQ_mkLinearMap_nonZeroSMulDivisors :
    Function.Injective
      ((maximalIdeal R • (⊤ : Submodule R N)).mapQ
        (maximalIdeal R • (⊤ : Submodule R (LocalizedModule
          (nonZeroSMulDivisors S
            (N ⧸ (Ideal.map (algebraMap R S) (maximalIdeal R) • (⊤ : Submodule S N)))) N)))
        ((LocalizedModule.mkLinearMap
          (nonZeroSMulDivisors S
            (N ⧸ (Ideal.map (algebraMap R S) (maximalIdeal R) •
              (⊤ : Submodule S N)))) N).restrictScalars R)
        (Submodule.smul_top_le_comap_smul_top _ _)) :=
  (Stacks.UniversalInjectivity.FGIdealTest.injective_mapQ_iff _ _).mpr fun n hn =>
    comap_mkLinearMap_maximalIdeal_smul_top_le n hn

end ClosedFibre

/-- **The commutative algebra of the converse implication of Stacks 05UA.**
Let `R → S` be a local homomorphism of local rings essentially of finite type and let `N` be a
finite `S`-module. If `N_p` is flat over `R` for every associated prime `p` of the closed fibre
`N / 𝔪_R N`, then `N` is flat over `R`.

Writing `Σ ⊆ S` for the elements acting injectively on the closed fibre, flatness at the
associated primes makes `Σ⁻¹N` flat over `R` by
`flat_localizedModule_nonZeroSMulDivisors_closedFibre`, and the localization map `N → Σ⁻¹N` is
injective modulo `𝔪_R` by `injective_mapQ_mkLinearMap_nonZeroSMulDivisors`; so Stacks 0AT4
(`AlgebraicGeometry.universallyInjective_and_finitePresentation_and_flat_of_linearMap`) applies
to the `S`-linear map `N → Σ⁻¹N`. -/
theorem flat_of_forall_flat_atPrime_assStacks_closedFibre
    {R : Type u} {S : Type v} {N : Type w}
    [CommRing R] [IsLocalRing R] [CommRing S] [IsLocalRing S] [Algebra R S]
    [IsLocalHom (algebraMap R S)] [Algebra.EssFiniteType R S]
    [AddCommGroup N] [Module S N] [Module R N] [IsScalarTower R S N] [Module.Finite S N]
    [IsNoetherianRing (S ⧸ Ideal.map (algebraMap R S) (maximalIdeal R))]
    [Module.Finite (S ⧸ Ideal.map (algebraMap R S) (maximalIdeal R))
      (N ⧸ (Ideal.map (algebraMap R S) (maximalIdeal R) • (⊤ : Submodule S N)))]
    (hflat : ∀ p : Ideal S, ∀ _ : p.IsPrime,
      p ∈ assStacks S (N ⧸ (Ideal.map (algebraMap R S) (maximalIdeal R) • (⊤ : Submodule S N))) →
        Module.Flat R (LocalizedModule p.primeCompl N)) :
    Module.Flat R N := by
  have hM : Module.Flat R (LocalizedModule
      (nonZeroSMulDivisors S
        (N ⧸ (Ideal.map (algebraMap R S) (maximalIdeal R) • (⊤ : Submodule S N)))) N) :=
    flat_localizedModule_nonZeroSMulDivisors_closedFibre hflat
  exact (AlgebraicGeometry.universallyInjective_and_finitePresentation_and_flat_of_linearMap.{u, v,
    max v w, w, 0} (LocalizedModule.mkLinearMap
    (nonZeroSMulDivisors S
      (N ⧸ (Ideal.map (algebraMap R S) (maximalIdeal R) • (⊤ : Submodule S N)))) N)
    injective_mapQ_mkLinearMap_nonZeroSMulDivisors).2.2

end Stacks.Flatness

end
