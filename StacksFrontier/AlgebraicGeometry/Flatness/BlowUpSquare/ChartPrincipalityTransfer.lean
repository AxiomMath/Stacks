module

public import StacksFrontier.AlgebraicGeometry.Duality.RelativeDualizing.DualizingComplexCoverCriterion
public import StacksFrontier.AlgebraicGeometry.Flatness.BlowUpSquare.ChartBaseChange
public import StacksFrontier.AlgebraicGeometry.Flatness.BlowUpSquare.ChartHomologyFreeness
public import StacksFrontier.Homology.Eta.Perfect.BoundedComplexExtendScalars
public import StacksFrontier.Homology.Eta.Perfect.DeterminantalIdealPrincipal

/-!
# Transferring principality of the determinantal ideals to a basic open

Let `(X, D, M)` be a triple as in Situation 0F8S and let `(U₀, A, f, M^•)` be an affine chart for
it whose determinantal ideals `I_i(M^•, f)` are principal.  Let `U = D(g) ⊆ U₀` be a basic open of
the chart, so that `B = Γ(X, U)` is a localization of `A`, and let `N^•` be any bounded complex of
finite free `B`-modules representing `M|_U`.  Then the determinantal ideals `I_i(N^•, f|_U)` are
principal as well.

The transfer runs through the derived category of `B`.  Restricting the chart's representation of
`M|_U₀` along `U ≤ U₀` and commuting the associated-sheaf functor with the base change of section
rings identifies `M|_U` with the sheaf complex of `M^• ⊗_A B`; since `N^•` also represents `M|_U`,
the affine derived Spec–Γ equivalence of Tag 06Z0 makes `M^• ⊗_A B` and `N^•` isomorphic in
`D(B)`.  Tag 0F8T says the determinantal ideals of `M^• ⊗_A B` are the ideals generated by the
images of those of `M^•`, hence principal, and Tag 0GSS transports principality across an
isomorphism in `D(B)`.

## Main results

* `AffineChart.nonempty_derivedIso_baseChange`: over a basic open of the chart, the base change
  `M^• ⊗_A B` and any other representative of `M|_U` are isomorphic in `D(B)`.
* `AffineChart.isPrincipal_idealI_of_eq_basicOpen`: the determinantal ideals of any such
  representative, taken with respect to the restricted equation, are principal.
* `AffineChart.isPrincipal_determinantalIdeal_of_eq_basicOpen`: the same for a second affine
  chart carried by the basic open, whose equation is the restriction of the first chart's.

## Implementation notes

Basic opens are what makes the argument work: `Γ(X, U₀) → Γ(X, D(g))` is a localization, so
extension of scalars along it is exact and the spectrum of the restriction map is an open
immersion, which are the two side conditions of the affine dictionary
`Stacks.AffineTilde.tildeIsoSpecRestrictIso` between two nested affine opens.

The equation of the smaller chart is required to be the restriction of the equation of the larger
one.  Both equations generate the ideal of `D` on the basic open, so they differ by a unit, but
identifying the two determinantal ideals through that unit needs the comparison of the ideal
sheaf of `D` with its restriction, which is not used here; with the equations equal, Tag 0GSS
applies directly.

A triple carries its derived category of `𝒪_X`-modules at the `OXMod` spelling, whereas the
functors restricting along an open immersion and along `U ≅ Spec Γ(X, U)` are stated for
`Scheme.Modules`; `modulesHasDerivedCategory` is the laundering of the one instance into the
other spelling, and is made a local instance of high priority so that it is preferred over the
standard model, at which the remaining derived categories here are taken.

## References

* [Stacks Project, Tag 0GTX](https://stacks.math.columbia.edu/tag/0GTX)
* [Stacks Project, Tag 0F8T](https://stacks.math.columbia.edu/tag/0F8T)
* [Stacks Project, Tag 0GSS](https://stacks.math.columbia.edu/tag/0GSS)
* [Stacks Project, Tag 06Z0](https://stacks.math.columbia.edu/tag/06Z0)
* [Stacks Project, Tag 0F8S](https://stacks.math.columbia.edu/tag/0F8S)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits StrictlyPerfect

attribute [local instance 10000] HasDerivedCategory.standard

universe u d

namespace AlgebraicGeometry.ComplexAndDivisorSituation

attribute [local instance 100000] modulesHasDerivedCategory

namespace AffineChart

variable {S : ComplexAndDivisorSituation.{u, d}}

/-- **Two representatives of `M` over a basic open of an affine chart agree in the derived
category of its sections.** If `W = D(g)` is a basic open of the chart `(U₀, A, f, M^•)` and the
complex `N` of `Γ(X, W)`-modules also represents `M|_W`, then `N` is isomorphic in
`D(Γ(X, W))` to the base change of `M^•` along the restriction map.

The restriction of the chart's representation to `W` is the sheaf complex of the base change,
because extension of scalars to a localization is exact and commutes with taking associated
sheaves; the affine derived Spec–Γ equivalence then identifies the two representatives. -/
public theorem nonempty_derivedIso_baseChange (C₀ : AffineChart S) (g : Γ(S.X, C₀.U))
    {W : S.X.Opens} (hW : IsAffineOpen W) (hle : W ≤ (C₀.U : S.X.Opens))
    (hWe : W = S.X.basicOpen g) (N : CochainComplex (ModuleCat.{u} Γ(S.X, W)) ℤ)
    (hN : Nonempty ((Scheme.Modules.restrictFunctor W.ι).mapDerivedCategory.obj S.M ≅
      (tilde.functor Γ(S.X, W) ⋙
        Scheme.Modules.restrictFunctor hW.isoSpec.hom).mapDerivedCategory.obj
          (DerivedCategory.Q.obj N))) :
    Nonempty (DerivedCategory.Q.obj
        ((C₀.complex.baseChange (S.X.presheaf.map (homOfLE hle).op).hom).toCochainComplex) ≅
      DerivedCategory.Q.obj N) := by
  subst hWe
  have := Stacks.Duality.preservesFiniteLimits_extendScalars_basicOpen C₀.U g
  have := Stacks.Duality.isOpenImmersion_specMap_basicOpen C₀.U g
  obtain ⟨eN⟩ := hN
  obtain ⟨e₀⟩ := Stacks.Duality.nonempty_iso_extendScalars_basicOpen C₀.U g
    (DerivedCategory.Q.obj C₀.complex.toCochainComplex) (representsDerivedIso C₀)
  obtain ⟨e⟩ := Stacks.Duality.nonempty_iso_of_nonempty_iso_tilde hW e₀ eN
  refine ⟨?_ ≪≫ e⟩
  exact (DerivedCategory.Q.mapIso
      (BoundedComplex.extendScalarsIso (S.X.presheaf.map (homOfLE hle).op).hom
        C₀.complex)).symm ≪≫
    ((ModuleCat.extendScalars (S.X.presheaf.map (homOfLE hle).op).hom
      ).mapDerivedCategoryFactors.app C₀.complex.toCochainComplex).symm

/-- **Principality of the determinantal ideals passes to a basic open of an affine chart.** Let
`(U₀, A, f, M^•)` be an affine chart whose determinantal ideal `I_i(M^•, f)` is principal, let
`W = D(g)` be a basic open of `U₀`, and let `N` be a bounded complex of finite free
`Γ(X, W)`-modules representing `M|_W`.  If the restriction of `f` to `W` is a nonzerodivisor,
then `I_i(N, f|_W)` is principal.

The base change `M^• ⊗_A Γ(X, W)` has principal determinantal ideals by Tag 0F8T, and it
represents the same object of `D(Γ(X, W))` as `N`, so Tag 0GSS applies. -/
public theorem isPrincipal_idealI_of_eq_basicOpen (C₀ : AffineChart S) (g : Γ(S.X, C₀.U))
    {W : S.X.Opens} (hW : IsAffineOpen W) (hle : W ≤ (C₀.U : S.X.Opens))
    (hWe : W = S.X.basicOpen g) (N : BoundedComplex Γ(S.X, W))
    (hN : Nonempty ((Scheme.Modules.restrictFunctor W.ι).mapDerivedCategory.obj S.M ≅
      (tilde.functor Γ(S.X, W) ⋙
        Scheme.Modules.restrictFunctor hW.isoSpec.hom).mapDerivedCategory.obj
          (DerivedCategory.Q.obj N.toCochainComplex)))
    (hreg : (S.X.presheaf.map (homOfLE hle).op).hom C₀.f ∈ nonZeroDivisors Γ(S.X, W))
    (i : ℤ) (h₀ : (C₀.determinantalIdeal i).IsPrincipal) :
    (idealI N ((S.X.presheaf.map (homOfLE hle).op).hom C₀.f) i).IsPrincipal :=
  Stacks.Eta.DeterminantalIdeal.isPrincipal_idealI_of_derived_iso
    ((S.X.presheaf.map (homOfLE hle).op).hom C₀.f) hreg _ N i
    (nonempty_derivedIso_baseChange C₀ g hW hle hWe N.toCochainComplex hN)
    (C₀.isPrincipal_determinantalIdeal_baseChange
      (S.X.presheaf.map (homOfLE hle).op).hom i h₀)

/-- **Principality of the determinantal ideals passes from an affine chart to one carried by a
basic open of it.** If the chart `(U₀, A, f, M^•)` has principal determinantal ideal
`I_i(M^•, f)`, and `(U, B, f|_U, N^•)` is an affine chart whose open is the basic open `D(g)` of
`U₀` and whose equation is the restriction of `f`, then `I_i(N^•, f|_U)` is principal too. -/
public theorem isPrincipal_determinantalIdeal_of_eq_basicOpen (C₀ C : AffineChart S)
    (g : Γ(S.X, C₀.U)) (hle : (C.U : S.X.Opens) ≤ (C₀.U : S.X.Opens))
    (hUe : (C.U : S.X.Opens) = S.X.basicOpen g)
    (hf : C.f = (S.X.presheaf.map (homOfLE hle).op).hom C₀.f) (i : ℤ)
    (h₀ : (C₀.determinantalIdeal i).IsPrincipal) :
    (C.determinantalIdeal i).IsPrincipal := by
  have hreg : (S.X.presheaf.map (homOfLE hle).op).hom C₀.f ∈ nonZeroDivisors Γ(S.X, C.U) := by
    rw [← hf]; exact C.regular.mem_nonZeroDivisors
  show (idealI C.complex C.f i).IsPrincipal
  rw [hf]
  exact isPrincipal_idealI_of_eq_basicOpen C₀ g C.U.2 hle hUe C.complex
    ⟨representsDerivedIso C⟩ hreg i h₀

end AffineChart

end AlgebraicGeometry.ComplexAndDivisorSituation

end
