module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EtaSheafPullbackStalkBaseChange
public import StacksFrontier.AlgebraicGeometry.Divisors.EtaGeneratorSection
public import StacksFrontier.AlgebraicGeometry.Divisors.IdealSheafPullbackComap
public import StacksFrontier.AlgebraicGeometry.Flatness.BlowUpSquare.ChartPullback
public import StacksFrontier.Topology.Sheaves.Cohomology.SupportedComplexes.ClosedSubsetPullbackLeftExact

/-!
# Generators of the two stalk ideals of an effective Cartier divisor and its inverse image

Let `h : Y ⟶ X` be a morphism of schemes and `D` an effective Cartier divisor on `X` whose
inverse image `E = h^{-1}D` is defined.  The comparison of décalages asks, at a point `z` of `Y`,
for a generator `a` of the stalk ideal of `ℐ_D` at `h(z)` whose germ generates the stalk ideal of
the *pulled-back* ideal `h^*ℐ_D ⟶ 𝒪_Y` at `z`.  This file produces such a pair from an affine
open on which `D` is principal.

## Main results

* `Stacks.RingedSpace.commStalkGermMap_apply`: the germ map between the commutative stalk rings
  is the stalk map of the morphism.
* `Stacks.IdealTorsion.generatesStalkIdeal_congr`: `GeneratesStalkIdeal` only depends on the
  image of the ideal in `𝒪_X`, so it transfers along an isomorphism of ideals compatible with
  the two inclusions.
* `Stacks.Divisors.Eta.generatesStalkIdeal_pullbackIdealIncl`: **the stalk map of `h` carries the
  germ of a generator of `D.ideal U` to a generator of the stalk ideal of `h^*ℐ_D`.**

## Implementation notes

The pulled-back ideal `h^*ℐ_D ⟶ 𝒪_Y` and the ideal sheaf `ℐ_E ⟶ 𝒪_Y` are the same subsheaf of
`𝒪_Y` — this is `Stacks.Divisors.pullbackIdealSheafComapIso_hom_comp_idealSheafι`, which needs
exactly that `h^{-1}D` is again an effective Cartier divisor — so the statement reduces to one
about `ℐ_E`, and there `Stacks.Divisors.Eta.generatesStalkIdeal_germ` applies on any affine open
`V ∋ z` lying over `U`, where the ideal of `E` is generated by the image of the generator of
`D.ideal U` (`Stacks.IdealSheaf.ideal_comap_appLE`).

## References

* [Stacks Project, Tag 0F8T](https://stacks.math.columbia.edu/tag/0F8T)
* [Stacks Project, Tag 0B8L](https://stacks.math.columbia.edu/tag/0B8L)
* [Stacks Project, Tag 0GT3](https://stacks.math.columbia.edu/tag/0GT3)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

open Stacks.IdealTorsion (GeneratesStalkIdeal idealSection stalkIdeal)

open Stacks.SheafOfModules.TensorStalkRingedSpace (ringGerm ringStalk)

universe u

namespace Stacks.RingedSpace

/-- **The germ map between the commutative stalk rings is the stalk map of the morphism.**
`Stacks.RingedSpace.commStalkGermMap` is the `RingCat`-valued stalk map conjugated by the
comparison of the two spellings of the stalk ring, and
`Stacks.RingedSpace.stalkRingMap_comp_ringStalkCommIso` identifies that conjugate. -/
theorem commStalkGermMap_apply {X Y : RingedSpace.{u}} (f : X ⟶ Y) (x : X)
    (c : ringStalk Y (f.hom.base x)) :
    commStalkGermMap f x c = f.hom.stalkMap x c := by
  have h := ConcreteCategory.congr_hom (stalkRingMap_comp_ringStalkCommIso f x)
    ((SemilinearStalk.commStalkRingEquiv Y.presheaf (f.hom.base x)).symm c)
  rw [RingCat.comp_apply, RingCat.comp_apply] at h
  exact h.trans (congrArg _
    ((SemilinearStalk.commStalkRingEquiv Y.presheaf (f.hom.base x)).apply_symm_apply c))

end Stacks.RingedSpace

namespace Stacks.IdealTorsion

variable {X : RingedSpace.{u}}
  {I I' : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)}
  (ι : I ⟶ SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
  (ι' : I' ⟶ SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))

/-- **Isomorphic ideals with the same inclusion have the same stalk ideal.**  An element of the
stalk ideal of `ι` is the germ of the image in `𝒪_X` of a section `s` of `I`; the image of `s`
under the isomorphism is a section of `I'` with the same image in `𝒪_X`, so that germ lies in the
stalk ideal of `ι'` too, and the inverse isomorphism gives the other inclusion. -/
theorem stalkIdeal_congr (e : I ≅ I') (he : e.hom ≫ ι' = ι) (x : X) :
    stalkIdeal X ι x = stalkIdeal X ι' x := by
  have key : ∀ {J J' : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)}
      (κ : J ⟶ SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf))
      (κ' : J' ⟶ SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)) (d : J ⟶ J'),
      d ≫ κ' = κ → stalkIdeal X κ x ⊆ stalkIdeal X κ' x := by
    rintro J J' κ κ' d hd c ⟨V, hxV, s, hs⟩
    refine ⟨V, hxV, (d.val.app (op V)).hom s, Eq.trans (congrArg (ringGerm X x V hxV) ?_) hs⟩
    exact congrArg (fun φ => (ModuleCat.Hom.hom ((φ : J ⟶ _).val.app (op V))) s) hd
  refine Set.Subset.antisymm (key ι ι' e.hom he) (key ι' ι e.inv ?_)
  rw [← he, ← Category.assoc, e.inv_hom_id, Category.id_comp]

/-- **`Stacks.IdealTorsion.GeneratesStalkIdeal` transfers along an isomorphism of ideals
compatible with the inclusions into `𝒪_X`**, the two stalk ideals being equal. -/
theorem generatesStalkIdeal_congr (e : I ≅ I') (he : e.hom ≫ ι' = ι) (x : X)
    (a : ringStalk X x) (ha : GeneratesStalkIdeal X ι x a) :
    GeneratesStalkIdeal X ι' x a :=
  have h := stalkIdeal_congr ι ι' e he x
  ⟨h ▸ ha.1, fun c hc => ha.2 c (h ▸ hc)⟩

end Stacks.IdealTorsion

namespace Stacks.Divisors.Eta

variable {X Y : Scheme.{u}} (h : Y ⟶ X) (D : X.IdealSheafData)

/-- **The germ of a section over an affine open, carried along the stalk map.**  The stalk map of
`h` takes the germ at `h z` of a section over `U` to the germ at `z` of its image under
`AlgebraicGeometry.Scheme.Hom.appLE` on any open `V ∋ z` lying over `U`. -/
theorem stalkMap_germ_eq_germ_appLE {U : X.Opens} {V : Y.Opens} (hV : V ≤ h ⁻¹ᵁ U) {z : Y}
    (hz : z ∈ V) (b : Γ(X, U)) :
    h.stalkMap z ((X.presheaf.germ U (h.base z) (hV hz)) b) =
      (Y.presheaf.germ V z hz) (h.appLE U V hV b) :=
  (Scheme.Hom.germ_stalkMap_apply h U z (hV hz) b).trans
    (Y.presheaf.germ_res_apply (homOfLE hV) z hz _).symm

/-- **A generator of the stalk ideal of the pulled-back ideal `h^*ℐ_D ⟶ 𝒪_Y`.**  Let `D` be an
effective Cartier divisor on `X` whose inverse image along `h` is defined, let `U` be an affine
open on which `D` is cut out by a nonzerodivisor `f`, and let `z` be a point of `Y` lying over
`U`.  Then the image of the germ of `f` under the germ map of `h` generates the stalk ideal of
`h^*ℐ_D` at `z`. -/
theorem generatesStalkIdeal_pullbackIdealIncl [Stacks.Divisors.IsEffectiveCartierDivisor D]
    (hD : Stacks.Divisors.IsPullbackDefined h D) (U : X.affineOpens) {f : Γ(X, (U : X.Opens))}
    (hf : D.ideal U = Ideal.span {f}) (z : Y) (hz : h.base z ∈ (U : X.Opens)) :
    GeneratesStalkIdeal Y.toRingedSpace
      (Stacks.IdealTorsion.Eta.pullbackIdealIncl h.toLRSHom.toShHom (idealSheaf D)
        (idealSheafι D)) z
      (Stacks.RingedSpace.commStalkGermMap h.toLRSHom.toShHom z
        ((X.presheaf.germ (U : X.Opens) (h.base z) hz).hom f)) := by
  obtain ⟨V, hVaff, hzV, hVU⟩ :=
    AlgebraicGeometry.exists_isAffineOpen_mem_and_subset (U := h ⁻¹ᵁ (U : X.Opens)) (x := z) hz
  have hle : V ≤ h ⁻¹ᵁ (U : X.Opens) := hVU
  set V' : Y.affineOpens := ⟨V, hVaff⟩
  have hideal : (D.comap h).ideal V' = Ideal.span {h.appLE (U : X.Opens) V hle f} := by
    rw [Stacks.IdealSheaf.ideal_comap_appLE D h U V' hle, hf, Ideal.map_span, Set.image_singleton]
  have hgen := generatesStalkIdeal_germ (D.comap h) V' hzV hideal
    (AlgebraicGeometry.isRegular_of_isEffectiveCartierDivisor_of_ideal_eq_span hD V'
      hideal).mem_nonZeroDivisors
  have hgerm : Stacks.RingedSpace.commStalkGermMap h.toLRSHom.toShHom z
        ((X.presheaf.germ (U : X.Opens) (h.base z) hz).hom f) =
      (Y.presheaf.germ V z hzV).hom (h.appLE (U : X.Opens) V hle f) :=
    (Stacks.RingedSpace.commStalkGermMap_apply h.toLRSHom.toShHom z _).trans
      (stalkMap_germ_eq_germ_appLE h hle hzV f)
  rw [hgerm]
  exact Stacks.IdealTorsion.generatesStalkIdeal_congr (idealSheafι (D.comap h)) _
    (Stacks.Divisors.pullbackIdealSheafComapIso h D hD).symm
    ((Iso.inv_comp_eq (Stacks.Divisors.pullbackIdealSheafComapIso h D hD)).2
      (Stacks.Divisors.pullbackIdealSheafComapIso_hom_comp_idealSheafι h D hD).symm) z _ hgen

end Stacks.Divisors.Eta

end
