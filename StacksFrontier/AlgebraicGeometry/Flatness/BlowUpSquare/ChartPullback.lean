* [Stacks Project, Tag 0GSU](https://stacks.math.columbia.edu/tag/0GSU)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits StrictlyPerfect
open Stacks.Cohomology.DerivedAdjunctionOnRingedSpaces

-- The chart vocabulary of `GoodTriple.lean` lives at the standard model of the derived category,
-- while `AffinePullbackComparison` brings the locally small model
-- `AlgebraicGeometry.Scheme.Modules.hasDerivedCategory` into scope; the priority forces the
-- standard model here, so that the isomorphism below has the type the `represents` field wants.
attribute [local instance 10000] HasDerivedCategory.standard

universe u d

namespace AlgebraicGeometry

/-! ### A generator of the ideal of an effective Cartier divisor is a nonzerodivisor -/

/-- **A generator of the ideal of an effective Cartier divisor on an affine open is a
nonzerodivisor.**

At every point of the open the stalk ideal is generated by a nonzerodivisor
(`AlgebraicGeometry.exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor`) and also by the
germ of the given generator, so the two generators differ by a factor and the germ is a
nonzerodivisor.  A section of the structure sheaf whose germs are all nonzerodivisors is a
nonzerodivisor, since a section is zero as soon as all its germs are. -/
theorem isRegular_of_isEffectiveCartierDivisor_of_ideal_eq_span {X : Scheme.{u}}
    {I : X.IdealSheafData} (hI : Stacks.Divisors.IsEffectiveCartierDivisor I)
    (V : X.affineOpens) {g : Γ(X, V)} (hg : I.ideal V = Ideal.span {g}) : IsRegular g := by
  have hgerm : ∀ (y : X) (hy : y ∈ (V : X.Opens)),
      IsRegular ((X.presheaf.germ (V : X.Opens) y hy).hom g) := by
    intro y hy
    obtain ⟨t, ht, hts⟩ := exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor I hI y
    refine isRegular_of_span_singleton_eq ht ?_
    rw [← hts, IdealSheafData.stalk_eq_map_germ I y V hy, hg, Ideal.map_span, Set.image_singleton]
  refine (Commute.isRegular_iff fun b => mul_comm g b).2 ?_
  intro c c' hc
  refine TopCat.Presheaf.section_ext X.sheaf (V : X.Opens) c c' fun y hy => ?_
  have h2 := congrArg (fun z => (X.presheaf.germ (V : X.Opens) y hy).hom z) hc
  simp only [map_mul] at h2
  exact (hgerm y hy).left h2

/-! ### A bounded complex of finite free modules is K-flat -/

/-- A bounded complex of finite free modules, given in chosen bases, is K-flat: it is bounded
above and its terms are free, hence flat, so Stacks 064K applies. -/
theorem kFlat_toCochainComplex {A : Type u} [CommRing A] (M : BoundedComplex A) :
    CochainComplex.KFlat.{u, u} M.toCochainComplex := by
  obtain ⟨b, hb⟩ := M.bounded.bddAbove
  have hle : M.toCochainComplex.IsStrictlyLE b := by
    rw [CochainComplex.isStrictlyLE_iff]
    intro i hi
    have hr : M.rank i = 0 := by
      by_contra hcon
      exact (not_le_of_gt hi) (hb hcon)
    show IsZero (ModuleCat.of A (Fin (M.rank i) → A))
    rw [hr]
    exact ModuleCat.isZero_iff_subsingleton.mpr inferInstance
  have hflat : ∀ i : ℤ, Module.Flat A (M.toCochainComplex.X i) := by
    intro i
    show Module.Flat A (Fin (M.rank i) → A)
    infer_instance
  exact CochainComplex.KFlat.kFlat_of_flat _ b

namespace ComplexAndDivisorSituation.AffineChart

variable {S : ComplexAndDivisorSituation.{u, d}}

/-- The map of coordinate rings `A = Γ(X, U) ⟶ Γ(Y, V) = B` induced by a morphism
`h : Y ⟶ X` on an affine open `V ⊆ Y` lying over the domain `U` of an affine chart. -/
abbrev pullbackRingHom (C : AffineChart S) {Y : Scheme.{u}} (h : Y ⟶ S.X)
    (V : Y.affineOpens) (hV : (V : Y.Opens) ≤ h ⁻¹ᵁ (C.U : S.X.Opens)) :
    Γ(S.X, C.U) ⟶ Γ(Y, V) :=
  h.appLE (C.U : S.X.Opens) (V : Y.Opens) hV

/-- The ideal of the pulled-back divisor on `V` is generated by the image `g` of the equation of
the chart: the ideal of an inverse image on a pair of affine charts is the extension of the
ideal, by `Stacks.IdealSheaf.ideal_comap_appLE`, and no hypothesis on `h` is needed for that. -/
theorem comap_ideal_eq_span (C : AffineChart S) {Y : Scheme.{u}} (h : Y ⟶ S.X)
    (V : Y.affineOpens) (hV : (V : Y.Opens) ≤ h ⁻¹ᵁ (C.U : S.X.Opens)) :
    (S.D.comap h).ideal V = Ideal.span {C.pullbackRingHom h V hV C.f} := by
  rw [Stacks.IdealSheaf.ideal_comap_appLE S.D h C.U V hV, C.divisor_ideal, Ideal.map_span,
    Set.image_singleton]

/-- The image `g ∈ B` of the equation of an affine chart is a nonzerodivisor, whenever the
pullback of the divisor along `h` is defined: it generates the ideal of the effective Cartier
divisor `h⁻¹D` on the affine open `V`. -/
theorem isRegular_pullbackRingHom_f (C : AffineChart S) {Y : Scheme.{u}} (h : Y ⟶ S.X)
    (hD : Stacks.Divisors.IsPullbackDefined h S.D) (V : Y.affineOpens)
    (hV : (V : Y.Opens) ≤ h ⁻¹ᵁ (C.U : S.X.Opens)) :
    IsRegular (C.pullbackRingHom h V hV C.f) :=
  isRegular_of_isEffectiveCartierDivisor_of_ideal_eq_span hD V (C.comap_ideal_eq_span h V hV)

/-- **The transport of the affine comparison square of Stacks 08DW part (2) to the two charts.**
For a complex `E` of `𝒪_Y`-modules representing the derived pullback `Lh^*M`, the restriction of
`E` to the affine open `V ⊆ Y` is isomorphic, in `D(𝒪_V)`, to the sheaf of modules of the
base-changed bounded complex `M^• ⊗_A B`.

This is the `represents` field of the pulled-back chart; the chain of isomorphisms is described
in the module documentation. -/
def pullbackRepresentsIso (C : AffineChart S) {Y : Scheme.{u}} (h : Y ⟶ S.X)
    (V : Y.affineOpens) (hV : (V : Y.Opens) ≤ h ⁻¹ᵁ (C.U : S.X.Opens))
    (E₀ : CochainComplex (OXMod.{u, u} S.X.toRingedSpace) ℤ)
    (hE₀ : (@DerivedCategory.Q _ _ _ S.hasDerivedCategory).obj E₀ ≅ S.M)
    (e : DerivedCategory.Q.obj
        (((Scheme.Modules.restrictFunctor (C.U : S.X.Opens).ι).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj E₀) ≅
      DerivedCategory.Q.obj
        (((tilde.functor Γ(S.X, C.U) ⋙
          Scheme.Modules.restrictFunctor C.U.2.isoSpec.hom).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj C.complex.toCochainComplex))
    (E : CochainComplex (OXMod.{u, u} Y.toRingedSpace) ℤ)
    (α : DerivedCategory.Q.obj E ≅ S.derivedPullbackObject h) :
    DerivedCategory.Q.obj
        (((Scheme.Modules.restrictFunctor (V : Y.Opens).ι).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj E) ≅
      DerivedCategory.Q.obj
        (((tilde.functor Γ(Y, V) ⋙
          Scheme.Modules.restrictFunctor V.2.isoSpec.hom).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj
          (C.complex.baseChange (C.pullbackRingHom h V hV).hom).toCochainComplex) := by
  -- the morphisms of the two squares
  let v : (V : Y.Opens).toScheme ⟶ (C.U : S.X.Opens).toScheme :=
    h.resLE (C.U : S.X.Opens) (V : Y.Opens) hV
  let p : Spec Γ(Y, V) ⟶ Spec Γ(S.X, C.U) := Spec.map (C.pullbackRingHom h V hV)
  -- the object of the standard model of the derived category that `Lh^*M` is formed from
  let N := (Localization.uniq
      (@DerivedCategory.Q _ _ _ S.hasDerivedCategory)
      (@DerivedCategory.Q _ _ _ (HasDerivedCategory.standard
        (OXMod.{u, u} S.X.toRingedSpace)))
      (HomologicalComplex.quasiIso (OXMod.{u, u} S.X.toRingedSpace)
        (ComplexShape.up ℤ))).functor.obj S.M
  -- `M^•` sheafified on `Spec A`
  let K := ((tilde.functor Γ(S.X, C.U)).mapHomologicalComplex (ComplexShape.up ℤ)).obj
    C.complex.toCochainComplex
  -- the two squares
  have hsq : (V : Y.Opens).ι ≫ h = v ≫ (C.U : S.X.Opens).ι :=
    (Scheme.Hom.resLE_comp_ι h hV).symm
  have hvm : v ≫ C.U.2.isoSpec.hom = V.2.isoSpec.hom ≫ p :=
    (Scheme.Opens.toSpecΓ_SpecMap_appLE h (C.U : S.X.Opens) (V : Y.Opens) hV).symm
  have hvm' : v.toLRSHom.toShHom ≫ C.U.2.isoSpec.hom.toLRSHom.toShHom =
      V.2.isoSpec.hom.toLRSHom.toShHom ≫ p.toLRSHom.toShHom := by
    simpa only [Scheme.Hom.comp_toLRSHom, LocallyRingedSpace.comp_toShHom] using
      congrArg (fun k : (V : Y.Opens).toScheme ⟶ Spec Γ(S.X, C.U) => k.toLRSHom.toShHom) hvm
  -- `M` carried from the situation's model of the derived category to the standard one
  have uniqIso : N ≅ DerivedCategory.Q.obj E₀ :=
    (Localization.uniq
        (@DerivedCategory.Q _ _ _ S.hasDerivedCategory)
        (@DerivedCategory.Q _ _ _ (HasDerivedCategory.standard
          (OXMod.{u, u} S.X.toRingedSpace)))
        (HomologicalComplex.quasiIso (OXMod.{u, u} S.X.toRingedSpace)
          (ComplexShape.up ℤ))).functor.mapIso hE₀.symm ≪≫
      (Localization.compUniqFunctor
        (@DerivedCategory.Q _ _ _ S.hasDerivedCategory)
        (@DerivedCategory.Q _ _ _ (HasDerivedCategory.standard
          (OXMod.{u, u} S.X.toRingedSpace)))
        (HomologicalComplex.quasiIso (OXMod.{u, u} S.X.toRingedSpace)
          (ComplexShape.up ℤ))).app E₀
  -- K-flatness of the sheafified chart complex
  have hK : Stacks.Cohomology.KFlatDerivedPullback.KFlatComplex (Spec Γ(S.X, C.U)).toRingedSpace
      K :=
    Stacks.TildeStalk.kFlatComplex_tilde _ C.complex.toCochainComplex
      (kFlat_toCochainComplex C.complex)
  -- regrouping the two composites of functors on complexes
  have a₂ : (((tilde.functor Γ(S.X, C.U) ⋙
          Scheme.Modules.restrictFunctor C.U.2.isoSpec.hom).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj C.complex.toCochainComplex) ≅
      ((Scheme.Modules.restrictFunctor C.U.2.isoSpec.hom).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj K :=
    ((Functor.mapHomologicalComplexCompIso
      (Iso.refl (tilde.functor Γ(S.X, C.U) ⋙
        Scheme.Modules.restrictFunctor C.U.2.isoSpec.hom))
      (ComplexShape.up ℤ)).app C.complex.toCochainComplex).symm
  have a₃ : ((Scheme.Modules.restrictFunctor V.2.isoSpec.hom).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj
        (((tilde.functor Γ(Y, V)).mapHomologicalComplex (ComplexShape.up ℤ)).obj
          (((ModuleCat.extendScalars (C.pullbackRingHom h V hV).hom).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj C.complex.toCochainComplex)) ≅
      (((tilde.functor Γ(Y, V) ⋙
          Scheme.Modules.restrictFunctor V.2.isoSpec.hom).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj
        (((ModuleCat.extendScalars (C.pullbackRingHom h V hV).hom).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj C.complex.toCochainComplex)) :=
    (Functor.mapHomologicalComplexCompIso
      (Iso.refl (tilde.functor Γ(Y, V) ⋙ Scheme.Modules.restrictFunctor V.2.isoSpec.hom))
      (ComplexShape.up ℤ)).app _
  exact
    ((Scheme.Modules.restrictFunctor (V : Y.Opens).ι).mapDerivedCategoryFactors.app E).symm ≪≫
      (Scheme.Modules.restrictFunctor (V : Y.Opens).ι).mapDerivedCategory.mapIso α ≪≫
      Scheme.Modules.openRestrictionDerivedPullbackIso (V : Y.Opens).ι h
        (C.U : S.X.Opens).ι v hsq N ≪≫
      (derivedPullback v.toLRSHom.toShHom).mapIso
        ((Scheme.Modules.restrictFunctor (C.U : S.X.Opens).ι).mapDerivedCategory.mapIso
            uniqIso ≪≫
          (Scheme.Modules.restrictFunctor
            (C.U : S.X.Opens).ι).mapDerivedCategoryFactors.app E₀ ≪≫
          e ≪≫ DerivedCategory.Q.mapIso a₂ ≪≫
          ((Scheme.Modules.restrictFunctor
            C.U.2.isoSpec.hom).mapDerivedCategoryFactors.app K).symm ≪≫
          (Scheme.Modules.derivedRestrictIsoDerivedPullback C.U.2.isoSpec.hom).app
            (DerivedCategory.Q.obj K)) ≪≫
      (Stacks.DerivedPullback.Composition.derivedPullbackCompIsoCanonical
        v.toLRSHom.toShHom C.U.2.isoSpec.hom.toLRSHom.toShHom).app (DerivedCategory.Q.obj K) ≪≫
      eqToIso (congrArg
        (fun k : (V : Y.Opens).toScheme.toRingedSpace ⟶ (Spec Γ(S.X, C.U)).toRingedSpace =>
          (derivedPullback k).obj (DerivedCategory.Q.obj K)) hvm') ≪≫
      ((Stacks.DerivedPullback.Composition.derivedPullbackCompIsoCanonical
        V.2.isoSpec.hom.toLRSHom.toShHom p.toLRSHom.toShHom).app
          (DerivedCategory.Q.obj K)).symm ≪≫
      (derivedPullback V.2.isoSpec.hom.toLRSHom.toShHom).mapIso
        (Stacks.Cohomology.derivedPullbackIsoPullbackOfKFlat p.toLRSHom.toShHom K hK ≪≫
          DerivedCategory.Q.mapIso
            ((tildePullbackComplexIso Γ(S.X, C.U) Γ(Y, V)
              (C.pullbackRingHom h V hV)).app C.complex.toCochainComplex)) ≪≫
      ((Scheme.Modules.derivedRestrictIsoDerivedPullback V.2.isoSpec.hom).app _).symm ≪≫
      (Scheme.Modules.restrictFunctor V.2.isoSpec.hom).mapDerivedCategoryFactors.app _ ≪≫
      DerivedCategory.Q.mapIso (a₃ ≪≫
        ((tilde.functor Γ(Y, V) ⋙
          Scheme.Modules.restrictFunctor V.2.isoSpec.hom).mapHomologicalComplex
            (ComplexShape.up ℤ)).mapIso
          (Stacks.Eta.DeterminantalIdeal.baseChangeCochainIso
            (C.pullbackRingHom h V hV).hom C.complex))

/-- **Stacks tag 0F8T, part (1).**  Let `(X, D, M)` be a triple as in Situation 0F8S, let
`h : Y ⟶ X` be a morphism of schemes along which the pullback `E = h⁻¹D` of the divisor is
defined, let `(U, A, f, M^•)` be an affine chart for `(X, D, M)` and let `V = Spec(B) ⊆ Y` be an
affine open with `h(V) ⊆ U`.  Then `(V, B, g, M^• ⊗_A B)`, with `g ∈ B` the image of `f`, is an
affine chart for `(Y, E, Lh^*M)`.

That `g` is a nonzerodivisor is `isRegular_pullbackRingHom_f`; that it cuts out `E ∩ V` is
`comap_ideal_eq_span`; and that `M^• ⊗_A B` represents the restriction of `Lh^*M` to `V` is
`pullbackRepresentsIso`. -/
@[stacks 0F8T "part (1): an affine chart pulls back, along an arbitrary morphism `h` for which \
the pullback of the divisor is defined, to an affine chart of the pulled-back triple over any \
affine open of the source lying over its domain"]
def pullback (C : AffineChart S) {Y : Scheme.{u}} (h : Y ⟶ S.X)
    (hD : Stacks.Divisors.IsPullbackDefined h S.D) (V : Y.affineOpens)
    (hV : (V : Y.Opens) ≤ h ⁻¹ᵁ (C.U : S.X.Opens)) : AffineChart (S.pullback h hD) where
  U := V
  f := C.pullbackRingHom h V hV C.f
  regular := C.isRegular_pullbackRingHom_f h hD V hV
  divisor_ideal := C.comap_ideal_eq_span h V hV
  complex := C.complex.baseChange (C.pullbackRingHom h V hV).hom
  represents := by
    obtain ⟨E₀, ⟨hE₀⟩, ⟨e⟩⟩ := C.represents
    exact ⟨DerivedCategory.Q.objPreimage (S.derivedPullbackObject h),
      ⟨DerivedCategory.Q.objObjPreimageIso (S.derivedPullbackObject h)⟩,
      ⟨C.pullbackRepresentsIso h V hV E₀ hE₀ e _
        (DerivedCategory.Q.objObjPreimageIso (S.derivedPullbackObject h))⟩⟩

/-- The open of the pulled-back chart `C.pullback h hD V hV` is `V`. -/
@[simp]
theorem pullback_U (C : AffineChart S) {Y : Scheme.{u}} (h : Y ⟶ S.X)
    (hD : Stacks.Divisors.IsPullbackDefined h S.D) (V : Y.affineOpens)
    (hV : (V : Y.Opens) ≤ h ⁻¹ᵁ (C.U : S.X.Opens)) : (C.pullback h hD V hV).U = V :=
  rfl

/-- The equation of the pulled-back chart is the image of `C.f` under
`C.pullbackRingHom h V hV`. -/
@[simp]
theorem pullback_f (C : AffineChart S) {Y : Scheme.{u}} (h : Y ⟶ S.X)
    (hD : Stacks.Divisors.IsPullbackDefined h S.D) (V : Y.affineOpens)
    (hV : (V : Y.Opens) ≤ h ⁻¹ᵁ (C.U : S.X.Opens)) :
    (C.pullback h hD V hV).f = C.pullbackRingHom h V hV C.f :=
  rfl

/-- The complex of the pulled-back chart is the base change of `C.complex` along
`C.pullbackRingHom h V hV`. -/
@[simp]
theorem pullback_complex (C : AffineChart S) {Y : Scheme.{u}} (h : Y ⟶ S.X)
    (hD : Stacks.Divisors.IsPullbackDefined h S.D) (V : Y.affineOpens)
    (hV : (V : Y.Opens) ≤ h ⁻¹ᵁ (C.U : S.X.Opens)) :
    (C.pullback h hD V hV).complex =
      C.complex.baseChange (C.pullbackRingHom h V hV).hom :=
  rfl

/-- **Stacks tag 0F8T, part (2), read on the pulled-back chart.**  The determinantal ideal
`I_i(M^• ⊗_A B, g)` of the pulled-back chart is the extension `I_i(M^•, f)B` of the
determinantal ideal of the original chart.  This is
`AlgebraicGeometry.ComplexAndDivisorSituation.AffineChart.map_determinantalIdeal`, i.e. Stacks
tag 0GSU, applied to the map of coordinate rings. -/
@[simp]
theorem pullback_determinantalIdeal (C : AffineChart S) {Y : Scheme.{u}} (h : Y ⟶ S.X)
    (hD : Stacks.Divisors.IsPullbackDefined h S.D) (V : Y.affineOpens)
    (hV : (V : Y.Opens) ≤ h ⁻¹ᵁ (C.U : S.X.Opens)) (i : ℤ) :
    (C.pullback h hD V hV).determinantalIdeal i =
      Ideal.map (C.pullbackRingHom h V hV).hom (C.determinantalIdeal i) :=
  (C.map_determinantalIdeal (C.pullbackRingHom h V hV).hom i).symm

/-- Principality of the determinantal ideals of a chart is inherited by its pullback: the
extension of a principal ideal is principal, generated by the image of a generator. -/
theorem isPrincipal_pullback_determinantalIdeal (C : AffineChart S) {Y : Scheme.{u}}
    (h : Y ⟶ S.X) (hD : Stacks.Divisors.IsPullbackDefined h S.D) (V : Y.affineOpens)
    (hV : (V : Y.Opens) ≤ h ⁻¹ᵁ (C.U : S.X.Opens)) {i : ℤ}
    (hi : (C.determinantalIdeal i).IsPrincipal) :
    ((C.pullback h hD V hV).determinantalIdeal i).IsPrincipal :=
  C.isPrincipal_determinantalIdeal_baseChange (C.pullbackRingHom h V hV).hom i hi

end ComplexAndDivisorSituation.AffineChart

namespace ComplexAndDivisorSituation

/-- **Stacks tag 0F8T, part (3).**  If `(X, D, M)` is a good triple and `h : Y ⟶ X` is a
morphism of schemes along which the pullback `E = h⁻¹D` of the divisor is defined, then
`(Y, E, Lh^*M)` is a good triple.

A point of `E` maps into `D`, so it has an affine chart `(U, A, f, M^•)` of `(X, D, M)` over it
with principal determinantal ideals; the preimage of `U` is an open neighbourhood of the point,
so it contains an affine open `V` containing it; and part (1) turns the chart into a chart of
`(Y, E, Lh^*M)` over `V`, whose determinantal ideals are principal by part (2). -/
@[stacks 0F8T "part (3): goodness of a triple is inherited by the pulled-back triple"]
theorem isGoodTriple_pullback (S : ComplexAndDivisorSituation.{u, d}) {Y : Scheme.{u}}
    (h : Y ⟶ S.X) (hD : Stacks.Divisors.IsPullbackDefined h S.D) (hS : IsGoodTriple S) :
    IsGoodTriple (S.pullback h hD) := by
  intro y hy
  have hx : h.base y ∈ S.D.supportSet := by
    have h1 : y ∈ (S.D.comap h).support := hy
    rw [Scheme.IdealSheafData.support_comap] at h1
    exact h1
  obtain ⟨C, hyC, hprin⟩ := hS (h.base y) hx
  have hyU : y ∈ (h ⁻¹ᵁ (C.U : S.X.Opens) : Y.Opens) := hyC
  obtain ⟨-, ⟨V, hVaff, rfl⟩, hyV, hVsub⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open hyU
      (h ⁻¹ᵁ (C.U : S.X.Opens) : Y.Opens).isOpen
  exact ⟨C.pullback h hD ⟨V, hVaff⟩ hVsub, hyV, fun i =>
    C.isPrincipal_pullback_determinantalIdeal h hD ⟨V, hVaff⟩ hVsub (hprin i)⟩

end ComplexAndDivisorSituation

end AlgebraicGeometry

