module

public import StacksFrontier.AlgebraicGeometry.Flatness.FittingStratification.ClosedSubschemes
public import StacksFrontier.AlgebraicGeometry.Groupoids.FittingIdealSheaf

/-!
# Exhaustion by the Fitting closed subschemes

Let `F` be a quasi-coherent module of finite type on a scheme `S`.  The closed subschemes
`fittingClosedSubscheme F r` cut out by the Fitting ideals of `F` form a decreasing chain, and
the chain exhausts `S`: no point of `S` lies on every member.

Monotonicity comes from monotonicity of the module-theoretic Fitting ideals, transported to the
ideal sheaves affine-locally.  Exhaustion is local as well: near a point `x` the module of
sections over an affine open `U` is generated by `n` elements, so the `n`-th Fitting ideal is the
unit ideal on `U`, whence the support of the `n`-th Fitting ideal sheaf misses `x`.

## Main results

* `AlgebraicGeometry.fittingClosedSubscheme_antitone`: at indices `i ≤ j` there is a morphism
  over `S` from the `j`-th Fitting closed subscheme to the `i`-th one.
* `AlgebraicGeometry.fittingClosedSubscheme_iInter_range_eq_empty`: the images in `S` of the
  Fitting closed subschemes indexed by the natural numbers have empty intersection.

## Implementation notes

The inclusion of one Fitting closed subscheme in another is a morphism in `Over S`, so it is
recorded as an element of a `Nonempty`: the two subschemes are not literally comparable
subobjects, but the inclusion is unique over `S`.  Only nonnegative indices occur in either
statement, since the members at negative indices are the whole of `S` by
`AlgebraicGeometry.fittingClosedSubscheme_neg` and contribute nothing to the intersection.
Emptiness of the intersection is stated on the underlying point sets, as the ranges of the
structural closed immersions.

## References

* [Stacks Project, Tag 05P8](https://stacks.math.columbia.edu/tag/05P8)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry

/-- At indices coming from natural numbers, the Fitting ideal sheaves of a quasi-coherent module
of finite type increase with the index.  On each affine open this is monotonicity of the
module-theoretic Fitting ideals of the sections. -/
private lemma fittingIdeal_le_of_nat {S : Scheme.{u}} (F : S.Modules) [F.IsFiniteType]
    [F.IsQuasicoherent] {i j : ℕ} (hij : i ≤ j) :
    fittingIdeal F (i : ℤ) ≤ fittingIdeal F (j : ℤ) := by
  rw [Scheme.IdealSheafData.le_def]
  intro U
  have : Module.Finite Γ(S, U.1) Γ(F, U.1) := moduleFinite_sections_on_affine F U.1 U.2
  rw [fittingIdeal_ideal, fittingIdeal_ideal]
  exact Stacks.Fitting.fittingIdeal_monotone (by exact_mod_cast hij)

/-- The closed subschemes cut out by the Fitting ideals of a quasi-coherent module of finite type
decrease with the index: for `i ≤ j` the `j`-th one admits a morphism over the base scheme to the
`i`-th one, namely the inclusion of closed subschemes coming from the inclusion of Fitting
ideals. -/
@[stacks 05P8 "the Fitting ideals cut out a descending chain of closed subschemes"]
theorem fittingClosedSubscheme_antitone {S : Scheme.{u}} (F : S.Modules) [F.IsFiniteType]
    [F.IsQuasicoherent] {i j : ℕ} (hij : i ≤ j) :
    Nonempty (fittingClosedSubscheme F (j : ℤ) ⟶ fittingClosedSubscheme F (i : ℤ)) := by
  rw [fittingClosedSubscheme_ofNat, fittingClosedSubscheme_ofNat]
  exact ⟨Over.homMk (Scheme.IdealSheafData.inclusion (fittingIdeal_le_of_nat F hij))⟩

/-- The Fitting closed subschemes of a quasi-coherent module of finite type exhaust the base
scheme: the images in `S` of the subschemes indexed by the natural numbers meet in the empty set.
Indeed, if `x` lies in an affine open `U` whose module of sections is generated by `n` elements,
then the `n`-th Fitting ideal is the unit ideal on `U`, so `x` avoids the `n`-th member. -/
@[stacks 05P8 "property (1): the Fitting closed subschemes have empty intersection"]
theorem fittingClosedSubscheme_iInter_range_eq_empty {S : Scheme.{u}} (F : S.Modules)
    [F.IsFiniteType] [F.IsQuasicoherent] :
    (⋂ i : ℕ, Set.range (fittingClosedSubscheme F (i : ℤ)).hom.base) = ∅ := by
  rw [Set.iInter_eq_empty_iff]
  intro x
  obtain ⟨U, hU, hxU, -⟩ :=
    exists_isAffineOpen_mem_and_subset (X := S) (x := x) (U := ⊤) (Set.mem_univ x)
  let U' : S.affineOpens := ⟨U, hU⟩
  have : Module.Finite Γ(S, U'.1) Γ(F, U'.1) := moduleFinite_sections_on_affine F U'.1 U'.2
  obtain ⟨n, v, hspan⟩ := Module.Finite.exists_fin (R := Γ(S, U'.1)) (M := Γ(F, U'.1))
  refine ⟨n, fun hxrange => ?_⟩
  have hcomponent : (fittingIdeal F (n : ℤ)).ideal U' = ⊤ := by
    rw [fittingIdeal_ideal]
    exact (fittingIdeal_basic_properties.{u, u, u, u}
      (R := Γ(S, U'.1)) (M := Γ(F, U'.1))).1 n ⟨v, hspan⟩
  have hxsupport : x ∈ (fittingIdeal F (n : ℤ)).support := by
    rw [fittingClosedSubscheme_ofNat] at hxrange
    have hxrange' : x ∈ Set.range (fittingIdeal F (n : ℤ)).subschemeι := hxrange
    simpa [Scheme.IdealSheafData.range_subschemeι] using hxrange'
  have hxzero : x ∈ S.zeroLocus (U := U'.1) ((fittingIdeal F (n : ℤ)).ideal U') :=
    (fittingIdeal F (n : ℤ)).supportSet_subset_zeroLocus U' hxsupport
  exact (by simpa [hcomponent] using hxzero : x ∉ U'.1) hxU

end AlgebraicGeometry

end
