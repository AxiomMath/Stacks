module

public import StacksFrontier.AlgebraicGeometry.Divisors.Meromorphic.FittingIdeals
public import StacksFrontier.AlgebraicGeometry.Flatness.FittingStratification.ClosedSubschemes
public import StacksFrontier.AlgebraicGeometry.Flatness.FittingStratification.GeneratorOpen
public import StacksFrontier.AlgebraicGeometry.Flatness.SubschemeFinitePresentation
public import StacksFrontier.AlgebraicGeometry.Sheaves.SectionsWithSupport.QuasiCompactOpenIdealSheaf

/-!
# Finite presentation of the Fitting stratification of a finitely presented module

Let `F` be a finitely presented sheaf of modules on a scheme `S`.  Both halves of the `r`-th
Fitting stratum of `F` are then of finite presentation over `S`: the closed subscheme cut out by
the `r`-th Fitting ideal of `F`, and its open complement, the locus where `F` is generated by `r`
sections.

## Main results

* `AlgebraicGeometry.fittingClosedSubscheme_finitePresentation`: the closed immersion of the
  `r`-th Fitting closed subscheme of `F` into `S` is of finite presentation.
* `AlgebraicGeometry.fittingGeneratorOpen_finitePresentation`: the open immersion of the `r`-th
  Fitting generator open of `F` into `S` is of finite presentation.

## Implementation notes

The index is taken in `ℕ`, as it is for `AlgebraicGeometry.fittingGeneratorOpen`; at a negative
index the Fitting closed subscheme is the whole of `S`, so nothing is lost.

In the closed case the content is finite generation of the Fitting ideal sheaf on every affine
open, which is `AlgebraicGeometry.fittingIdeal_isFiniteType`, fed to the characterization
`Stacks.Flatness.finitePresentation_subschemeι_iff`.  In the open case local finite presentation
and quasi-separatedness are automatic for an open immersion, so the content is quasi-compactness,
and that is checked one affine open of the target at a time: there the generator open is the
complement of the zero locus of a finitely generated ideal, hence a finite union of basic opens,
by `AlgebraicGeometry.isCompact_compl_zeroLocus_inter_of_fg`.

Finite type and quasi-coherence of `F` are applied by hand rather than found by instance
synthesis.  Both follow from finite presentation, but the universe parameter of
`SheafOfModules.IsFinitePresentation` is not determined by either goal, so the Mathlib instances
`SheafOfModules.instIsFiniteTypeOfIsFinitePresentation` and
`SheafOfModules.instIsQuasicoherentOfIsFinitePresentation` cannot be discharged automatically and
appear as explicit arguments in the statements, which therefore assume finite presentation alone.

## References

* [Stacks Project, Tag 05P8](https://stacks.math.columbia.edu/tag/05P8)
-/

@[expose] public section

open CategoryTheory
open scoped AlgebraicGeometry

universe u

namespace AlgebraicGeometry

/-- Inside an affine open `U` of `S`, the `r`-th Fitting generator open of a finitely presented
module `F` is quasi-compact: there it is the complement of the zero locus of the `r`-th Fitting
ideal of the sections of `F` over `U`, which is a finitely generated ideal. -/
private theorem fittingGeneratorOpen_inter_affine_isCompact {S : Scheme.{u}} (F : S.Modules)
    [F.IsFiniteType] [F.IsQuasicoherent] [F.IsFinitePresentation] (r : ℕ)
    (U : S.affineOpens) :
    IsCompact ((fittingGeneratorOpen F r : Set S) ∩ (U.1 : Set S)) := by
  have hfg : ((fittingIdeal F (r : ℤ)).ideal U).FG := fittingIdeal_isFiniteType F r U
  have hopen : (fittingGeneratorOpen F r : Set S) =
      ((fittingIdeal F (r : ℤ)).support : Set S)ᶜ := by
    change (Set.range (fittingClosedSubscheme F (r : ℤ)).hom.base)ᶜ = _
    rw [fittingClosedSubscheme_ofNat]
    exact congrArg _ (fittingIdeal F (r : ℤ)).range_subschemeι
  have hset : (fittingGeneratorOpen F r : Set S) ∩ (U.1 : Set S) =
      (S.zeroLocus (U := U.1) ((fittingIdeal F (r : ℤ)).ideal U : Set Γ(S, U.1)))ᶜ ∩
        (U.1 : Set S) := by
    rw [hopen]
    refine Set.ext fun x ↦ ?_
    by_cases hxU : x ∈ (U.1 : Set S)
    · simp [hxU, (fittingIdeal F (r : ℤ)).mem_support_iff_of_mem hxU]
    · simp [hxU]
  rw [hset]
  exact isCompact_compl_zeroLocus_inter_of_fg U.2 _ hfg

/-- **Stacks Project, Tag 05P8.** The closed subscheme of `S` cut out by the `r`-th Fitting ideal
of a finitely presented sheaf of modules `F` is of finite presentation over `S`. -/
@[stacks 05P8 "finite presentation of the morphism Z_r to S"]
public theorem fittingClosedSubscheme_finitePresentation {S : Scheme.{u}} (F : S.Modules)
    [F.IsFinitePresentation] (r : ℕ) :
    FinitePresentation
      (@fittingClosedSubscheme S F (SheafOfModules.instIsFiniteTypeOfIsFinitePresentation F)
        (SheafOfModules.instIsQuasicoherentOfIsFinitePresentation F) (r : ℤ)).hom := by
  have : F.IsFiniteType := SheafOfModules.instIsFiniteTypeOfIsFinitePresentation F
  have : F.IsQuasicoherent := SheafOfModules.instIsQuasicoherentOfIsFinitePresentation F
  rw [fittingClosedSubscheme_ofNat]
  change FinitePresentation (fittingIdeal F (r : ℤ)).subschemeι
  exact (Stacks.Flatness.finitePresentation_subschemeι_iff _).mpr (fittingIdeal_isFiniteType F r)

/-- **Stacks Project, Tag 05P8.** The open complement in `S` of the closed subscheme cut out by
the `r`-th Fitting ideal of a finitely presented sheaf of modules `F` — the locus where `F` is
generated by `r` sections — is of finite presentation over `S`. -/
@[stacks 05P8 "finite presentation of the morphism S minus Z_r to S"]
public theorem fittingGeneratorOpen_finitePresentation {S : Scheme.{u}} (F : S.Modules)
    [F.IsFinitePresentation] (r : ℕ) :
    FinitePresentation
      (@fittingGeneratorOpen S F (SheafOfModules.instIsFiniteTypeOfIsFinitePresentation F)
        (SheafOfModules.instIsQuasicoherentOfIsFinitePresentation F) r).ι := by
  have : F.IsFiniteType := SheafOfModules.instIsFiniteTypeOfIsFinitePresentation F
  have : F.IsQuasicoherent := SheafOfModules.instIsQuasicoherentOfIsFinitePresentation F
  have hqc : QuasiCompact (fittingGeneratorOpen F r).ι := by
    rw [quasiCompact_iff_forall_isAffineOpen]
    intro U hU
    rw [TopologicalSpace.Opens.map_coe, ← Set.preimage_inter_range]
    refine (fittingGeneratorOpen F r).ι.isOpenEmbedding.isInducing.isCompact_preimage' ?_ ?_
    · rw [Scheme.Opens.range_ι]
      simpa [Set.inter_comm] using
        fittingGeneratorOpen_inter_affine_isCompact F r ⟨U, hU⟩
    · exact Set.inter_subset_right
  exact ⟨inferInstance, hqc, inferInstance⟩

end AlgebraicGeometry

end
