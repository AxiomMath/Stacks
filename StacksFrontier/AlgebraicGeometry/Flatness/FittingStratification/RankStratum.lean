/-!
# The Fitting rank stratum

Let `F` be a finite type quasi-coherent module on a scheme `S` and let `r` be a natural number.
The locus of `S` over which `F` pulls back to a module that is finite locally free of rank `r`
is the difference of two consecutive Fitting closed subschemes of `F`: the open subscheme of
`Z_{r-1}` lying over the complement of `Z_r`. This difference is a scheme over `S` whose
structural morphism is a locally closed immersion, and it represents the rank `r` functor of
`F`.

## Main definitions

* `AlgebraicGeometry.fittingRankStratum`: the rank `r` Fitting stratum of `F`, namely the part
  of the Fitting closed subscheme of index `r - 1` lying over the open complement of the
  Fitting closed subscheme of index `r`, as an object of `Over S`.

## Main results

* `AlgebraicGeometry.isImmersion_fittingRankStratum`: the structural morphism of the rank `r`
  Fitting stratum is a locally closed immersion.
* `AlgebraicGeometry.rankRFunctor_representableBy_fittingRankStratum`: the rank `r` Fitting
  stratum represents the rank `r` functor of `F`.

## Implementation notes

Indexing the Fitting closed subschemes by an integer makes the index `r - 1` available for
every natural number `r`, with the convention that a negative index gives the whole of `S`; the
rank zero case therefore needs no separate treatment. The structural morphism is a closed
immersion precomposed with an open immersion, which is exactly the factorization asked of a
locally closed immersion.

The rank `r` functor takes either a singleton or an empty value at each scheme over `S`, so
representability reduces to a bijection of hom sets, and the bijection reduces in turn to the
statement that a scheme `T` over `S` pulls `F` back to a module finite locally free of rank `r`
exactly when `T` admits a morphism over `S` to the stratum. The two directions of that
statement are the universal properties of the closed subscheme of an ideal sheaf and of an open
subscheme: a morphism factors through the former exactly when the ideal sheaf pulls back to
zero, and through the latter exactly when its image lands in the open set. Which Fitting ideals
vanish and which are the unit ideal is converted into the rank condition by
`AlgebraicGeometry.finiteLocallyFreeOfRank_tfae_fittingIdeal`.

## References

* [Stacks Project, Tag 05P8](https://stacks.math.columbia.edu/tag/05P8)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry

/-- The rank `r` Fitting stratum of a finite type quasi-coherent module `F` on `S`: the open
part of the Fitting closed subscheme of index `r - 1` lying over the complement of the Fitting
closed subscheme of index `r`, recorded together with its morphism to `S` as an object of
`Over S`. -/
public noncomputable def fittingRankStratum {S : Scheme.{u}} (F : S.Modules)
    [F.IsFiniteType] [F.IsQuasicoherent] (r : ℕ) : Over S :=
  Over.mk
    (((fittingClosedSubscheme F ((r : ℤ) - 1)).hom ⁻¹ᵁ fittingGeneratorOpen F r).ι ≫
      (fittingClosedSubscheme F ((r : ℤ) - 1)).hom)

/-- The structural morphism of the rank `r` Fitting stratum is a locally closed immersion: it
is the inclusion of an open subscheme followed by a closed immersion. -/
@[stacks 05P8 "property (3): the rank r stratum is a locally closed subscheme"]
public theorem isImmersion_fittingRankStratum {S : Scheme.{u}} (F : S.Modules)
    [F.IsFiniteType] [F.IsQuasicoherent] (r : ℕ) :
    IsImmersion (fittingRankStratum F r).hom := by
  dsimp [fittingRankStratum]
  infer_instance

/-- A finite type quasi-coherent module has unit `r`-th Fitting ideal sheaf exactly when it is
generated by `r` sections near every point. -/
private theorem fittingIdeal_eq_top_iff_forall_generated {X : Scheme.{u}} (F : X.Modules)
    [F.IsFiniteType] [F.IsQuasicoherent] (r : ℕ) :
    fittingIdeal F (r : ℤ) = ⊤ ↔ ∀ x : X, IsGeneratedByNear F r x := by
  constructor
  · intro h x
    rw [isGeneratedByNear_iff_fittingIdeal_stalk_eq_top, h]
    change (⨆ U : X.affineOpens, ⨆ hx : x ∈ U.1,
      Ideal.map (X.presheaf.germ U.1 x hx).hom ⊤) = ⊤
    apply le_antisymm le_top
    obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
    refine le_iSup_of_le ⟨U, hU⟩ (le_iSup_of_le hxU ?_)
    rw [Ideal.map_top]
  · intro h
    rw [← Scheme.IdealSheafData.support_eq_bot_iff]
    ext x
    simp only [TopologicalSpace.Closeds.coe_bot, Set.mem_empty_iff_false, iff_false]
    intro hx
    have hstalk : IdealSheafData.stalk (fittingIdeal F (r : ℤ)) x = ⊤ :=
      (isGeneratedByNear_iff_fittingIdeal_stalk_eq_top F r x).mp (h x)
    exact (Stacks.Divisors.stalk_eq_top_iff_notMem_support _ x).mp hstalk hx

/-- A morphism of schemes factors through the closed subscheme cut out by an ideal sheaf exactly
when that ideal sheaf pulls back to the zero ideal sheaf. -/
private theorem factorsThrough_idealSubscheme_iff_comap_eq_bot {T S : Scheme.{u}}
    (I : S.IdealSheafData) (f : T ⟶ S) :
    (∃ g : T ⟶ I.subscheme, g ≫ I.subschemeι = f) ↔ I.comap f = ⊥ := by
  constructor
  · rintro ⟨g, hg⟩
    have hci : I.comap I.subschemeι = ⊥ := by
      refine le_antisymm (Scheme.IdealSheafData.le_map_iff_comap_le.mp ?_) bot_le
      simpa only [Scheme.IdealSheafData.map_bot] using
        (le_of_eq I.ker_subschemeι.symm : I ≤ I.subschemeι.ker)
    rw [← hg, Scheme.IdealSheafData.comap_comp, hci, Scheme.IdealSheafData.comap_bot]
  · intro h
    have hle : I ≤ f.ker := by
      simpa only [h, Scheme.IdealSheafData.map_bot] using
        Scheme.IdealSheafData.le_map_comap I f
    have hker : I.subschemeι.ker ≤ f.ker := by simpa only [I.ker_subschemeι] using hle
    exact ⟨IsClosedImmersion.lift I.subschemeι f hker,
      IsClosedImmersion.lift_fac I.subschemeι f hker⟩

/-- A morphism `a` lands in the preimage of an open set `O` exactly when `a ≫ g` lands in `O`. -/
private theorem range_subset_range_preimage_ι_iff {T Z S : Scheme.{u}} (a : T ⟶ Z) (g : Z ⟶ S)
    (O : S.Opens) :
    Set.range a.base ⊆ Set.range (g ⁻¹ᵁ O).ι.base ↔
      Set.range (a ≫ g).base ⊆ Set.range O.ι.base := by
  simp only [Scheme.Opens.range_ι, Set.range_subset_iff, Scheme.Hom.comp_apply]
  rfl

/-- A scheme `T` over `S` maps over `S` to the Fitting closed subscheme of index `r - 1` exactly
when `r = 0` or the Fitting ideal sheaf of index `r - 1` pulls back to zero on `T`. -/
private theorem exists_factorsThrough_fittingClosedSubscheme_iff {S T : Scheme.{u}}
    (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent] (r : ℕ) (f : T ⟶ S) :
    (∃ a : T ⟶ (fittingClosedSubscheme F ((r : ℤ) - 1)).left,
      a ≫ (fittingClosedSubscheme F ((r : ℤ) - 1)).hom = f) ↔
      r = 0 ∨ (fittingIdeal F ((r : ℤ) - 1)).comap f = ⊥ := by
  by_cases hr : r = 0
  · subst hr
    rw [fittingClosedSubscheme_neg F _ (by norm_num)]
    exact iff_of_true ⟨f, by simp⟩ (Or.inl rfl)
  · rw [fittingClosedSubscheme_of_nonneg F (by omega)]
    exact (factorsThrough_idealSubscheme_iff_comap_eq_bot _ f).trans (or_iff_right hr).symm

/-- A scheme `T` over `S` pulls `F` back to a module that is finite locally free of rank `r`
exactly when `T` admits a morphism over `S` to the rank `r` Fitting stratum of `F`. -/
private theorem finiteLocallyFreeOfRank_iff_nonempty_stratumHom {S : Scheme.{u}}
    (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent] (r : ℕ) (T : Over S) :
    SheafOfModules.IsFiniteLocallyFreeOfRank ((Scheme.Modules.pullback T.hom).obj F) r ↔
      Nonempty (T ⟶ fittingRankStratum F r) := by
  classical
  let G := (Scheme.Modules.pullback T.hom).obj F
  let Z := fittingClosedSubscheme F ((r : ℤ) - 1)
  let O := fittingGeneratorOpen F r
  let U := Z.hom ⁻¹ᵁ O
  change SheafOfModules.IsFiniteLocallyFreeOfRank G r ↔ Nonempty (T ⟶ Over.mk (U.ι ≫ Z.hom))
  have : G.IsFiniteType := SheafOfModules.pullback_isFiniteType T.hom.toLRSHom.toShHom F
  have : G.IsQuasicoherent :=
    @SheafOfModules.modulePullback_isQuasicoherent _ _ T.hom.toLRSHom.toShHom F
      ‹F.IsQuasicoherent›
  have hiff := (finiteLocallyFreeOfRank_tfae_fittingIdeal G r).out 1 2
  constructor
  · intro hrank
    have hchar := hiff.mp hrank
    have hgenerated : ∀ x : T.left, IsGeneratedByNear G r x :=
      (fittingIdeal_eq_top_iff_forall_generated G r).mp (by simpa using hchar.2)
    obtain ⟨b, hb, -⟩ :=
      (locallyGenerated_iff_factorsThrough_fittingGeneratorOpen F r T.hom).mp hgenerated
    obtain ⟨a, ha⟩ := (exists_factorsThrough_fittingClosedSubscheme_iff F r T.hom).2
      (by rw [fittingIdeal_comap]; exact hchar.1)
    have hRangeU : Set.range a.base ⊆ Set.range U.ι.base := by
      rw [range_subset_range_preimage_ι_iff, ha, ← hb]
      exact Set.range_comp_subset_range b.base O.ι.base
    refine ⟨Over.homMk (IsOpenImmersion.lift U.ι a hRangeU) ?_⟩
    change IsOpenImmersion.lift U.ι a hRangeU ≫ U.ι ≫ Z.hom = T.hom
    rw [← Category.assoc, IsOpenImmersion.lift_fac, ha]
  · rintro ⟨h⟩
    have ha : (h.left ≫ U.ι) ≫ Z.hom = T.hom := by simpa using h.w
    have hRangeO : Set.range T.hom.base ⊆ Set.range O.ι.base := by
      rw [← ha, ← range_subset_range_preimage_ι_iff]
      exact Set.range_comp_subset_range h.left.base U.ι.base
    have hgenerated : ∀ x : T.left, IsGeneratedByNear G r x :=
      (locallyGenerated_iff_factorsThrough_fittingGeneratorOpen F r T.hom).2
        ⟨IsOpenImmersion.lift O.ι T.hom hRangeO, IsOpenImmersion.lift_fac O.ι T.hom hRangeO,
          fun g hg ↦ IsOpenImmersion.lift_uniq O.ι T.hom hRangeO g hg⟩
    refine hiff.mpr ⟨?_, (fittingIdeal_eq_top_iff_forall_generated G r).2 hgenerated⟩
    rw [← fittingIdeal_comap]
    exact (exists_factorsThrough_fittingClosedSubscheme_iff F r T.hom).1 ⟨_, ha⟩

/-- **Stacks Project, Tag 05P8.** The rank `r` functor of a finite type quasi-coherent module
`F` on `S` is represented by the rank `r` Fitting stratum of `F`, a locally closed subscheme of
`S`. -/
@[stacks 05P8 "property (3): representability of the functor of local freeness of rank r"]
public theorem rankRFunctor_representableBy_fittingRankStratum {S : Scheme.{u}}
    (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent] (r : ℕ) :
    Nonempty ((rankRFunctor S F r).RepresentableBy (fittingRankStratum F r)) := by
  classical
  let W := fittingRankStratum F r
  let P := rankRFunctor S F r
  have : Mono W.hom := by
    dsimp [W, fittingRankStratum]
    infer_instance
  have (T : Over S) : Subsingleton (P.obj (Opposite.op T)) := by
    dsimp only [P, rankRFunctor]
    infer_instance
  refine ⟨{ homEquiv := ?_, homEquiv_comp := ?_ }⟩
  · intro T
    refine Equiv.ofBijective
      (fun g ↦ ⟨⟨(finiteLocallyFreeOfRank_iff_nonempty_stratumHom F r T).2 ⟨g⟩⟩⟩) ⟨?_, ?_⟩
    · intro g g' _
      refine Over.OverMorphism.ext ((cancel_mono W.hom).1 ?_)
      exact g.w.trans g'.w.symm
    · intro x
      obtain ⟨g⟩ := (finiteLocallyFreeOfRank_iff_nonempty_stratumHom F r T).1 x.down.down
      exact ⟨g, Subsingleton.elim _ _⟩
  · intro T T' f g
    exact Subsingleton.elim _ _

end AlgebraicGeometry

end
