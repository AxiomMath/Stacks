module

public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierStalk.Stalkwise
public import StacksFrontier.AlgebraicGeometry.Divisors.FittingIdeals.Basic
public import StacksFrontier.AlgebraicGeometry.Flatness.FittingStratification.ClosedSubschemes
public import StacksFrontier.Topology.Sheaves.Modules.FiniteType
public import StacksFrontier.Topology.Sheaves.Modules.Quasicoherent

/-!
# The open locus of a bound on the number of local generators

For a finite type quasi-coherent module `F` on a scheme `S`, the condition that a base change
of `F` be locally generated by at most `r` sections is represented by the open complement of
the closed subscheme cut out by the `r`-th Fitting ideal of `F`.

## Main definitions

* `AlgebraicGeometry.fittingGeneratorOpen`: the open subscheme of `S` complementary to the
  `r`-th Fitting closed subscheme of `F`.

## Main results

* `AlgebraicGeometry.locallyGenerated_iff_factorsThrough_fittingGeneratorOpen`: a morphism
  `f : T ⟶ S` pulls `F` back to a module that is generated by `r` sections near every point of
  `T` exactly when `f` factors uniquely through the open immersion of
  `AlgebraicGeometry.fittingGeneratorOpen F r`.

## Implementation notes

The functor whose representability is at stake has either a singleton or an empty value over
each test scheme, so its representability by an open subscheme amounts to the
unique-factorization property of the corresponding open immersion, which is how the main result
is stated. The condition of generation on the test scheme is imposed at every point, using the
neighbourhoodwise notion `AlgebraicGeometry.IsGeneratedByNear`; a generating family indexed by
`Fin r` also expresses a bound of at most `r` by padding with zero sections.

The identification of the two sides runs through the Fitting ideal sheaf: generation by `r`
sections near a point is the condition that the stalk of the `r`-th Fitting ideal sheaf there is
the unit ideal, hence that the point lies off the support of that ideal sheaf, and Fitting ideal
sheaves commute with base change.

## References

* [Stacks Project, Tag 05P8](https://stacks.math.columbia.edu/tag/05P8)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry

/-- The open subscheme of `S` complementary to the closed subscheme cut out by the `r`-th
Fitting ideal of a finite type quasi-coherent module `F`.  Its points are exactly the points of
`S` near which `F` is generated by `r` sections. -/
public def fittingGeneratorOpen {S : Scheme.{u}} (F : S.Modules)
    [F.IsFiniteType] [F.IsQuasicoherent] (r : ℕ) : S.Opens :=
  ⟨(Set.range (fittingClosedSubscheme F (r : ℤ)).hom.base)ᶜ,
    (fittingClosedSubscheme F (r : ℤ)).hom.isClosedEmbedding.isClosed_range.isOpen_compl⟩

/-- A point of `S` lies in the range of the open immersion of the `r`-th Fitting generator open
exactly when it lies off the support of the `r`-th Fitting ideal sheaf. -/
private theorem mem_fittingGeneratorOpen_iff
    {S : Scheme.{u}} (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (r : ℕ) (x : S) :
    x ∈ Set.range (fittingGeneratorOpen F r).ι.base ↔
      x ∉ ((fittingIdeal F (r : ℤ)).support : Set S) := by
  rw [Scheme.Opens.range_ι]
  change x ∉ Set.range (fittingClosedSubscheme F (r : ℤ)).hom.base ↔ _
  rw [fittingClosedSubscheme_ofNat]
  change x ∉ Set.range (fittingIdeal F (r : ℤ)).subschemeι ↔ _
  rw [Scheme.IdealSheafData.range_subschemeι]

/-- **Stacks Project, Tag 05P8.** The pullback of a finite type quasi-coherent module `F` along
`f : T ⟶ S` is generated by `r` sections near every point of `T` if and only if `f` factors
uniquely through the open complement of the `r`-th Fitting closed subscheme of `F`. -/
@[stacks 05P8 "property (2): representability of the functor of generation by <= r sections"]
public theorem locallyGenerated_iff_factorsThrough_fittingGeneratorOpen
    {S T : Scheme.{u}} (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (r : ℕ) (f : T ⟶ S) :
    (∀ t : T, IsGeneratedByNear ((Scheme.Modules.pullback f).obj F) r t) ↔
      ∃! g : T ⟶ (fittingGeneratorOpen F r).toScheme,
        g ≫ (fittingGeneratorOpen F r).ι = f := by
  let I := fittingIdeal F (r : ℤ)
  have : ((Scheme.Modules.pullback f).obj F).IsFiniteType :=
    SheafOfModules.pullback_isFiniteType f.toLRSHom.toShHom F
  have : ((Scheme.Modules.pullback f).obj F).IsQuasicoherent :=
    @SheafOfModules.modulePullback_isQuasicoherent _ _ f.toLRSHom.toShHom F ‹F.IsQuasicoherent›
  have hbase : fittingIdeal ((Scheme.Modules.pullback f).obj F) (r : ℤ) = I.comap f :=
    (fittingIdeal_comap f F (r : ℤ)).symm
  have hgen : (∀ t : T, IsGeneratedByNear ((Scheme.Modules.pullback f).obj F) r t) ↔
      ∀ t : T, f.base t ∉ (I.support : Set S) := by
    simp only [isGeneratedByNear_iff_fittingIdeal_stalk_eq_top, hbase,
      Stacks.Divisors.stalk_eq_top_iff_notMem_support, Scheme.IdealSheafData.support_comap]
    rfl
  rw [hgen]
  constructor
  · intro h
    have hrange : Set.range f.base ⊆ Set.range ((fittingGeneratorOpen F r).ι).base := by
      rw [Set.range_subset_iff]
      exact fun t ↦ (mem_fittingGeneratorOpen_iff F r (f.base t)).2 (h t)
    refine ⟨IsOpenImmersion.lift (fittingGeneratorOpen F r).ι f hrange, ?_, ?_⟩
    · simp
    · exact fun g hg ↦ IsOpenImmersion.lift_uniq (fittingGeneratorOpen F r).ι f hrange g hg
  · rintro ⟨g, hg, _⟩ t
    exact (mem_fittingGeneratorOpen_iff F r (f.base t)).1 ⟨g.base t, congrArg (·.base t) hg⟩

end AlgebraicGeometry

end
