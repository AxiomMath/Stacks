private lemma isRegular_of_span_eq_span {R : Type*} [CommRing R] {x y : R}
    (hy : _root_.IsRegular y) (hspan : Ideal.span {x} = Ideal.span {y}) : _root_.IsRegular x := by
  have hxmem : x ∈ Ideal.span {y} := hspan ▸ Ideal.subset_span rfl
  have hymem : y ∈ Ideal.span {x} := hspan.symm ▸ Ideal.subset_span rfl
  obtain ⟨a, ha⟩ := Ideal.mem_span_singleton'.mp hxmem
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton'.mp hymem
  have hmul : (b * a) * y = y := by rw [mul_assoc, ha, hb]
  have hba : b * a = 1 := by
    apply hy.left
    simpa [mul_comm] using hmul
  have hunit : IsUnit a := IsUnit.of_mul_eq_one b (by simpa [mul_comm] using hba)
  simpa only [ha] using hunit.isRegular.mul hy

private theorem effectiveCartier_affine_generator_local {X : Scheme.{u}}
    (I : X.IdealSheafData)
    (hI : Stacks.Divisors.IsEffectiveCartierDivisor I)
    (x : X) (hx : x ∈ I.supportSet) :
    ∃ (U : X.affineOpens), x ∈ U.1 ∧
      ∃ f : Γ(X, U.1), _root_.IsRegular f ∧ I.ideal U = Ideal.span {f} := by
  obtain ⟨U, hU, hxU, f, hf, e, he⟩ :=
    (Stacks.Divisors.isEffectiveCartierDivisor_iff_affineLocal I).mp hI x hx
  exact ⟨⟨U, hU⟩, hxU, f, hf,
    Stacks.Divisors.ideal_eq_quotient_of_chart I U hU (Ideal.span {f}) e he⟩

private theorem isRegular_germ_of_isRegular {X : Scheme.{u}}
    (x : X) (U : X.affineOpens) (hx : x ∈ U.1) (t : Γ(X, U.1))
    (ht : _root_.IsRegular t) : _root_.IsRegular (X.presheaf.germ U.1 x hx t) := by
  let p : PrimeSpectrum Γ(X, U.1) := U.2.primeIdealOf ⟨x, hx⟩
  let φ : Γ(X, U.1) →+* X.presheaf.stalk x := (X.presheaf.germ U.1 x hx).hom
  let : Algebra Γ(X, U.1) (X.presheaf.stalk x) := φ.toAlgebra
  let : IsLocalization.AtPrime (X.presheaf.stalk x) p.asIdeal :=
    U.2.isLocalization_stalk ⟨x, hx⟩
  have hsmul : IsSMulRegular (X.presheaf.stalk x) (φ t) := by
    change IsSMulRegular (X.presheaf.stalk x) (algebraMap Γ(X, U.1) _ t)
    exact ht.isSMulRegular.of_isLocalization (X.presheaf.stalk x) p.asIdeal.primeCompl
  refine ⟨?_, ?_⟩
  · intro a b hab
    apply hsmul
    simpa [Algebra.smul_def] using hab
  · intro a b hab
    apply hsmul
    simpa [Algebra.smul_def, mul_comm] using hab

private theorem exists_regular_generator_stalk_of_effectiveCartier
    {X : Scheme.{u}} (I : X.IdealSheafData)
    (hI : Stacks.Divisors.IsEffectiveCartierDivisor I)
    (x : X) (hx : x ∈ I.supportSet) :
    ∃ y : X.presheaf.stalk x,
      _root_.IsRegular y ∧ AlgebraicGeometry.IdealSheafData.stalk I x = Ideal.span {y} := by
  obtain ⟨U, hxU, f, hf, hideal⟩ := effectiveCartier_affine_generator_local I hI x hx
  let y := X.presheaf.germ U.1 x hxU f
  refine ⟨y, isRegular_germ_of_isRegular x U hxU f hf, ?_⟩
  rw [IdealSheafData.stalk_eq_map_germ I x U hxU, hideal, Ideal.map_span]
  simp [y]

private theorem stalkVanishingIdeal_singleton_eq_maximalIdeal
    {X : Scheme.{u}} (x : X) :
    AlgebraicGeometry.IdealSheafData.stalk
      (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure ({x} : Set X))) x =
      IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  let Ua : X.affineOpens := ⟨U, hU⟩
  let p := hU.primeIdealOf ⟨x, hxU⟩
  let : IsOpenImmersion hU.fromSpec := hU.isOpenImmersion_fromSpec
  have hpre : (hU.fromSpec : Spec (.of Γ(X, U)) ⟶ X) ⁻¹' ({x} : Set X) =
      ({p} : Set (PrimeSpectrum Γ(X, U))) := by
    ext z
    change hU.fromSpec z = x ↔ z = p
    constructor
    · intro hz
      exact hU.fromSpec.isOpenEmbedding.injective
        (by rw [hU.fromSpec_primeIdealOf]; exact hz)
    · rintro rfl
      exact hU.fromSpec_primeIdealOf ⟨x, hxU⟩
  have hcl : (hU.fromSpec : Spec (.of Γ(X, U)) ⟶ X) ⁻¹'
      closure ({x} : Set X) = closure ({p} : Set (PrimeSpectrum Γ(X, U))) := by
    rw [hU.fromSpec.isOpenEmbedding.isOpenMap.preimage_closure_eq_closure_preimage
      hU.fromSpec.continuous, hpre]
    rfl
  have hvan : PrimeSpectrum.vanishingIdeal
      ((hU.fromSpec : Spec (.of Γ(X, U)) ⟶ X) ⁻¹' closure ({x} : Set X)) = p.asIdeal :=
    (congrArg PrimeSpectrum.vanishingIdeal hcl).trans
      ((PrimeSpectrum.vanishingIdeal_closure ({p} : Set (PrimeSpectrum Γ(X, U)))).trans
        (PrimeSpectrum.vanishingIdeal_singleton p))
  rw [IdealSheafData.stalk_eq_map_germ _ x Ua hxU,
    Scheme.IdealSheafData.vanishingIdeal_ideal]
  change Ideal.map (X.presheaf.germ U x hxU).hom
      (PrimeSpectrum.vanishingIdeal
        ((hU.fromSpec : Spec (.of Γ(X, U)) ⟶ X) ⁻¹' closure ({x} : Set X))) = _
  rw [hvan]
  let : Algebra Γ(X, U) (X.presheaf.stalk x) :=
    (X.presheaf.germ U x hxU).hom.toAlgebra
  have : IsLocalization.AtPrime (X.presheaf.stalk x) p.asIdeal :=
    hU.isLocalization_stalk ⟨x, hxU⟩
  exact IsLocalization.AtPrime.map_eq_maximalIdeal p.asIdeal (X.presheaf.stalk x)

/-- The ideal induced in the local ring at a point by the vanishing ideal of its closure is the
maximal ideal. -/
public alias stalk_vanishingIdeal_closure_singleton_eq_maximalIdeal :=
  stalkVanishingIdeal_singleton_eq_maximalIdeal

private lemma pow_not_mem_maximalIdeal_pow_of_regular_generator
    {A B : Type*} [CommRing A] [IsLocalRing A] [CommRing B] [IsLocalRing B]
    (f : A →+* B) [IsLocalHom f] (x : A)
    (hgen : Ideal.map f (IsLocalRing.maximalIdeal A) = Ideal.span {f x})
    (hx : f x ∈ IsLocalRing.maximalIdeal B) (hreg : _root_.IsRegular (f x)) (n : ℕ) :
    x ^ n ∉ (IsLocalRing.maximalIdeal A) ^ (n + 1) := by
  intro hmem
  have himage : f (x ^ n) ∈ Ideal.map f ((IsLocalRing.maximalIdeal A) ^ (n + 1)) :=
    Ideal.mem_map_of_mem f hmem
  have hspan : f (x ^ n) ∈ Ideal.span {(f x) ^ (n + 1)} := by
    rw [Ideal.map_pow, hgen, Ideal.span_singleton_pow, map_pow] at himage
    simpa using himage
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hspan
  have hzero : (f x) ^ n * (1 - c * f x) = 0 := by
    calc
      (f x) ^ n * (1 - c * f x) = (f x) ^ n - c * (f x) ^ (n + 1) := by
        rw [pow_succ]
        ring
      _ = f (x ^ n) - c * (f x) ^ (n + 1) := by rw [map_pow]
      _ = 0 := by rw [← hc, sub_self]
  have hfactor : 1 - c * f x = 0 := by
    apply (hreg.pow n).left
    simpa using hzero
  have hcf : c * f x ∈ IsLocalRing.maximalIdeal B :=
    Ideal.mul_mem_left _ c hx
  have hnot : 1 - c * f x ∉ IsLocalRing.maximalIdeal B := by
    intro h
    have hone : (1 - c * f x) + c * f x ∈ IsLocalRing.maximalIdeal B :=
      Ideal.add_mem _ h hcf
    have hone' : (1 : B) ∈ IsLocalRing.maximalIdeal B := by simp at hone
    exact (IsLocalRing.maximalIdeal.isMaximal B).ne_top
      ((Ideal.eq_top_iff_one _).mpr hone')
  exact hnot (hfactor ▸ (IsLocalRing.maximalIdeal B).zero_mem)

private theorem exists_isUnit_mul_pow_of_maximalIdeal_eq_span {S : Type*} [CommRing S]
    [IsLocalRing S] [IsHausdorff (IsLocalRing.maximalIdeal S) S] {π : S}
    (hmax : IsLocalRing.maximalIdeal S = Ideal.span {π}) {x : S} (hx : x ≠ 0) :
    ∃ (n : ℕ) (u : Sˣ), x = u * π ^ n := by
  classical
  have hex : ∃ n : ℕ, x ∉ Ideal.span {π ^ n} := by
    by_contra h
    simp only [not_exists, not_not] at h
    exact hx (IsHausdorff.haus ‹IsHausdorff (IsLocalRing.maximalIdeal S) S› x fun n => by
      rw [SModEq.zero, Module.pow_smul_top_eq_span_pow hmax n]
      exact h n)
  obtain ⟨n, hn⟩ : ∃ n, Nat.find hex = n + 1 := by
    have h0 : Nat.find hex ≠ 0 := fun h => Nat.find_spec hex (by simp [h])
    exact ⟨Nat.find hex - 1, by omega⟩
  have hmem : x ∈ Ideal.span {π ^ n} := by
    by_contra h
    have hle : Nat.find hex ≤ n := Nat.find_le h
    omega
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hmem
  have hcu : IsUnit c := by
    refine IsLocalRing.notMem_maximalIdeal.mp fun hcm => Nat.find_spec hex ?_
    rw [hmax, Ideal.mem_span_singleton'] at hcm
    obtain ⟨d, hd⟩ := hcm
    rw [hn]
    exact Ideal.mem_span_singleton'.mpr ⟨d, by rw [← hc, ← hd]; ring⟩
  exact ⟨n, hcu.unit, by rw [hcu.unit_spec, ← hc]⟩

private theorem isNoetherian_of_hausdorff_principal_maximalIdeal
    {S : Type*} [CommRing S] [IsLocalRing S]
    [IsHausdorff (IsLocalRing.maximalIdeal S) S] {π : S}
    (hmax : IsLocalRing.maximalIdeal S = Ideal.span {π}) : IsNoetherianRing S := by
  rw [isNoetherianRing_iff_ideal_fg]
  intro I
  classical
  by_cases hbot : I = ⊥
  · rw [hbot]
    exact Submodule.fg_bot
  · obtain ⟨x, hxI, hx0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hbot
    obtain ⟨n₀, u₀, hu₀⟩ := exists_isUnit_mul_pow_of_maximalIdeal_eq_span hmax hx0
    let P : Set ℕ := {n | ∃ y : S, y ∈ I ∧ y ≠ 0 ∧ ∃ u : Sˣ, y = u * π ^ n}
    have hP : P.Nonempty := ⟨n₀, x, hxI, hx0, u₀, hu₀⟩
    let n := sInf P
    have hnP : n ∈ P := Nat.sInf_mem hP
    obtain ⟨y, hyI, hy0, v, hv⟩ := hnP
    have hspan : I = Ideal.span {y} := by
      apply le_antisymm
      · intro z hz
        by_cases hz0 : z = 0
        · simp [hz0]
        · obtain ⟨m, w, hw⟩ :=
            exists_isUnit_mul_pow_of_maximalIdeal_eq_span hmax hz0
          have hm : m ∈ P := ⟨z, hz, hz0, w, hw⟩
          have hnm : n ≤ m := Nat.sInf_le hm
          have hp : π ^ n ∈ Ideal.span {y} := by
            apply Ideal.mem_span_singleton'.mpr
            refine ⟨(v⁻¹ : Sˣ), ?_⟩
            rw [hv]
            simp [mul_left_comm]
          apply Ideal.mem_span_singleton'.mpr
          refine ⟨(w : S) * π ^ (m - n) * (v⁻¹ : Sˣ), ?_⟩
          calc
            ((w : S) * π ^ (m - n) * (v⁻¹ : Sˣ)) * y =
                (w : S) * π ^ (m - n) * π ^ n := by
              rw [hv]
              simp [mul_comm, mul_left_comm, mul_assoc]
            _ = (w : S) * π ^ m := by rw [mul_assoc, ← pow_add, Nat.sub_add_cancel hnm]
            _ = z := hw.symm
      · exact Ideal.span_le.mpr (by simpa using hyI)
    rw [hspan]
    exact Submodule.fg_span (Set.finite_singleton y)

private theorem isSMulRegular_of_maximalIdeal_eq_span_of_powers_ne_zero
    {S : Type*} [CommRing S] [IsLocalRing S]
    [IsHausdorff (IsLocalRing.maximalIdeal S) S] {π : S}
    (hmax : IsLocalRing.maximalIdeal S = Ideal.span {π})
    (hpow : ∀ n : ℕ, π ^ n ≠ 0) : IsSMulRegular S π := by
  refine IsSMulRegular.of_right_eq_zero_of_smul fun y hy => ?_
  by_contra hy0
  obtain ⟨n, u, hyEq⟩ := exists_isUnit_mul_pow_of_maximalIdeal_eq_span hmax hy0
  have hzero : (u : S) * π ^ (n + 1) = 0 := by
    calc
      (u : S) * π ^ (n + 1) = π * ((u : S) * π ^ n) := by ring
      _ = 0 := by simpa [smul_eq_mul, hyEq] using hy
  have hpowzero : π ^ (n + 1) = 0 := by
    calc
      π ^ (n + 1) = ((u⁻¹ : Sˣ) : S) * ((u : S) * π ^ (n + 1)) := by
        simp
      _ = 0 := by rw [hzero]; simp
  exact (hpow (n + 1)) hpowzero

private theorem exists_isDomain_isDiscreteValuationRing_of_complete_principal_maximalIdeal
    {S : Type*} [CommRing S] [IsLocalRing S] [IsNoetherianRing S]
    [IsAdicComplete (IsLocalRing.maximalIdeal S) S] {π : S}
    (hmax : IsLocalRing.maximalIdeal S = Ideal.span {π})
    (hpow : ∀ n : ℕ, π ^ n ≠ 0) : ∃ _ : IsDomain S, IsDiscreteValuationRing S := by
  have : IsHausdorff (IsLocalRing.maximalIdeal S) S :=
    IsHausdorff.of_isLocalRing (IsLocalRing.maximalIdeal S) S
      (IsLocalRing.maximalIdeal.isMaximal S).ne_top
  have hreg : IsSMulRegular S π :=
    isSMulRegular_of_maximalIdeal_eq_span_of_powers_ne_zero hmax hpow
  have hdom : IsDomain S := by
    have hdom' : NoZeroDivisors S := by
      constructor
      intro a b hab
      by_contra h
      obtain ⟨ha, hb⟩ := not_or.mp h
      obtain ⟨n, u, rfl⟩ := exists_isUnit_mul_pow_of_maximalIdeal_eq_span hmax ha
      obtain ⟨m, v, rfl⟩ := exists_isUnit_mul_pow_of_maximalIdeal_eq_span hmax hb
      have h0 : (u : S) * v = 0 := hreg.pow (n + m) (by
        simp only [smul_eq_mul, mul_zero, pow_add]
        linear_combination hab)
      exact zero_ne_one (isUnit_zero_iff.mp (h0 ▸ (Units.isUnit u).mul (Units.isUnit v)))
    exact NoZeroDivisors.to_isDomain S
  have hne : IsLocalRing.maximalIdeal S ≠ ⊥ := by
    rw [hmax, ne_eq, Ideal.span_singleton_eq_bot]
    exact fun h => hpow 1 (by simp [h])
  have hitem : ∃ _ : IsLocalRing S, IsNoetherianRing S ∧ IsDomain S ∧
      (IsLocalRing.maximalIdeal S).IsPrincipal ∧ IsLocalRing.maximalIdeal S ≠ ⊥ :=
    ⟨‹IsLocalRing S›, ‹IsNoetherianRing S›, hdom, ⟨π, hmax⟩, hne⟩
  obtain ⟨_, hdvr⟩ := ((isDiscreteValuationRing_tfae S).out 4 1).mp hitem
  exact ⟨hdom, hdvr⟩

/-- An infinite sequence of blowups at closed points. -/
structure PointBlowupSequence where
  /-- The scheme at each stage of the sequence. -/
  scheme : ℕ → Scheme.{u}
  /-- The centre of the blowup performed at each stage. -/
  point : (n : ℕ) → scheme n
  /-- Each centre is a closed point. -/
  point_closed : ∀ n, IsClosed ({point n} : Set (scheme n))
  /-- The transition morphism from one stage to the preceding one. -/
  stepMap : (n : ℕ) → scheme (n + 1) ⟶ scheme n
  /-- Each stage is identified with the blowup of the preceding one at its centre. -/
  stepIso : (n : ℕ) → scheme (n + 1) ≅
    blowUp
      (Scheme.IdealSheafData.vanishingIdeal
        (⟨{point n}, point_closed n⟩ : Closeds (scheme n)))
  /-- Under that identification the transition morphism is the blowup morphism. -/
  stepMap_eq : ∀ n, stepMap n = (stepIso n).hom ≫
    blowUpToBase
      (Scheme.IdealSheafData.vanishingIdeal
        (⟨{point n}, point_closed n⟩ : Closeds (scheme n)))
  /-- Each centre lies over the preceding one. -/
  point_step : ∀ n, stepMap n (point (n + 1)) = point n
  /-- The residue field at the centre is unchanged from one stage to the next. -/
  residueFieldIso : ∀ n, IsIso ((stepMap n).residueFieldMap (point (n + 1)))

private abbrev localRingAt (s : PointBlowupSequence.{u}) (n : ℕ) :=
  (s.scheme n).presheaf.stalk (s.point n)

private lemma cast_ideal_eq_map_cast {ι : Type*} {R : ι → Type*}
    [∀ i, CommRing (R i)] {i j : ι} (h : i = j) (I : Ideal (R i)) :
    h ▸ I = Ideal.map (RingEquiv.cast (R := R) h).toRingHom I := by
  cases h
  change I = Ideal.map (RingHom.id _) I
  exact (Ideal.map_id I).symm

private lemma stalkRingEquivCast_eq_stalkCongr_hom {X : Scheme.{u}} {p q : X}
    (h : p = q) :
    (RingEquiv.cast (R := fun z : X => X.presheaf.stalk z) h).toRingHom =
      (X.presheaf.stalkCongr (.of_eq h)).hom.hom := by
  cases h
  ext z
  simp [RingEquiv.cast, TopCat.Presheaf.stalkCongr_hom]

private lemma ringEquivCast_trans {ι : Type*} {R : ι → Type*}
    [∀ i, Mul (R i)] [∀ i, Add (R i)] {i j k : ι}
    (h₁ : i = j) (h₂ : j = k) :
    (RingEquiv.cast (R := R) h₁).trans (RingEquiv.cast (R := R) h₂) =
      RingEquiv.cast (R := R) (h₁.trans h₂) := by
  cases h₁
  cases h₂
  rfl

/-- The composite map from the `n`-th scheme to the initial scheme. -/
def PointBlowupSequence.toBase (s : PointBlowupSequence.{u}) :
    (n : ℕ) → s.scheme n ⟶ s.scheme 0
  | 0 => 𝟙 _
  | n + 1 => s.stepMap n ≫ s.toBase n

private theorem pointToBaseEq (s : PointBlowupSequence.{u}) :
    (n : ℕ) → s.toBase n (s.point n) = s.point 0
  | 0 => rfl
  | n + 1 => by
      change s.toBase n (s.stepMap n (s.point (n + 1))) = s.point 0
      exact (congrArg (s.toBase n) (s.point_step n)).trans (pointToBaseEq s n)

/-- The image of an initial local function in the local ring at stage `n`. -/
def PointBlowupSequence.stalkImage (s : PointBlowupSequence.{u})
    (n : ℕ) (x : (s.scheme 0).presheaf.stalk (s.point 0)) :
    (s.scheme n).presheaf.stalk (s.point n) :=
  let h : s.toBase n (s.point n) = s.point 0 := by
    induction n with
    | zero => rfl
    | succ n ih => simpa [toBase, s.point_step n] using ih
  ((s.toBase n).stalkMap (s.point n)).hom
    (h.symm ▸ x)

/-- The maximal ideal of the preceding local ring, extended to the local ring
at the next selected point. -/
def PointBlowupSequence.exceptionalIdealAt (s : PointBlowupSequence.{u})
    (n : ℕ) : Ideal ((s.scheme (n + 1)).presheaf.stalk (s.point (n + 1))) :=
  Ideal.map ((s.stepMap n).stalkMap (s.point (n + 1))).hom
    ((s.point_step n).symm ▸ IsLocalRing.maximalIdeal
      ((s.scheme n).presheaf.stalk (s.point n)))

private def localStepMap (s : PointBlowupSequence.{u}) (n : ℕ) :
    localRingAt s n →+* localRingAt s (n + 1) :=
  ((s.stepMap n).stalkMap (s.point (n + 1))).hom.comp
    (RingEquiv.cast
      (R := fun p : s.scheme n => (s.scheme n).presheaf.stalk p)
      (s.point_step n).symm).toRingHom

private lemma localStepMap_isLocal (s : PointBlowupSequence.{u}) (n : ℕ) :
    IsLocalHom (localStepMap s n) := by
  dsimp [localStepMap]
  infer_instance

attribute [local instance] localStepMap_isLocal

private lemma localStepMap_residueFieldMap_isIso (s : PointBlowupSequence.{u}) (n : ℕ) :
    IsIso (CommRingCat.ofHom
      (IsLocalRing.ResidueField.map (localStepMap s n))) := by
  let e : localRingAt s n ≃+*
      (s.scheme n).presheaf.stalk (s.stepMap n (s.point (n + 1))) :=
      RingEquiv.cast
      (R := fun p : s.scheme n => (s.scheme n).presheaf.stalk p)
      (s.point_step n).symm
  let : IsLocalHom e.toRingHom := isLocalHom_of_leftInverse
    e.symm.toRingHom e.symm_apply_apply
  let φ := ((s.stepMap n).stalkMap (s.point (n + 1))).hom
  have he : IsIso (CommRingCat.ofHom
      (IsLocalRing.ResidueField.map e.toRingHom)) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr (IsLocalRing.ResidueField.mapEquiv e).bijective
  have hφ := s.residueFieldIso n
  change IsIso (CommRingCat.ofHom (IsLocalRing.ResidueField.map φ)) at hφ
  change IsIso (CommRingCat.ofHom
    (IsLocalRing.ResidueField.map (φ.comp e.toRingHom)))
  rw [IsLocalRing.ResidueField.map_comp]
  exact IsIso.comp_isIso' he hφ

private lemma localStepMap_maximalIdeal_map_eq_exceptionalIdealAt
    (s : PointBlowupSequence.{u}) (n : ℕ) :
    Ideal.map (localStepMap s n) (IsLocalRing.maximalIdeal (localRingAt s n)) =
      s.exceptionalIdealAt n := by
  rw [localStepMap, ← Ideal.map_map]
  congr 1
  exact (cast_ideal_eq_map_cast
    (R := fun p : s.scheme n => (s.scheme n).presheaf.stalk p)
    (s.point_step n).symm _).symm

private def initialToStage (s : PointBlowupSequence.{u}) (n : ℕ) :
    localRingAt s 0 →+* localRingAt s n := by
  let h := pointToBaseEq s n
  exact ((s.toBase n).stalkMap (s.point n)).hom.comp
    (RingEquiv.cast
      (R := fun p : s.scheme 0 => (s.scheme 0).presheaf.stalk p)
      h.symm).toRingHom

private lemma initialToStage_apply (s : PointBlowupSequence.{u}) (n : ℕ)
    (x : localRingAt s 0) : initialToStage s n x = s.stalkImage n x := by
  simp [initialToStage, PointBlowupSequence.stalkImage, RingEquiv.cast, eqRec_eq_cast]

/-- The map from the initial local ring to itself is the identity. -/
private lemma initialToStage_zero (s : PointBlowupSequence.{u}) :
    initialToStage s 0 = RingHom.id (localRingAt s 0) := by
  ext z
  rw [initialToStage_apply]
  simp [PointBlowupSequence.stalkImage, PointBlowupSequence.toBase, Scheme.Hom.stalkMap_id]
  rfl

private lemma localStepMap_stalkImage (s : PointBlowupSequence.{u})
    (x : localRingAt s 0) (n : ℕ) :
    localStepMap s n (s.stalkImage n x) = s.stalkImage (n + 1) x := by
  let hpt := (s.point_step n).symm
  let hbase := pointToBaseEq s n
  let c₁ := (RingEquiv.cast
    (R := fun p : s.scheme n => (s.scheme n).presheaf.stalk p) hpt).toRingHom
  let f₀ := ((s.toBase n).stalkMap (s.point n)).hom
  let c₀ := (RingEquiv.cast
    (R := fun p : s.scheme 0 => (s.scheme 0).presheaf.stalk p) hbase.symm).toRingHom
  let h₂ : (s.toBase n) (s.point n) =
      (s.toBase n) (s.stepMap n (s.point (n + 1))) := congrArg (s.toBase n) hpt
  let c₂ := (RingEquiv.cast
    (R := fun p : s.scheme 0 => (s.scheme 0).presheaf.stalk p) h₂).toRingHom
  let f₂ := ((s.toBase n).stalkMap (s.stepMap n (s.point (n + 1)))).hom
  let f₁ := ((s.stepMap n).stalkMap (s.point (n + 1))).hom
  let h₃ := hbase.symm.trans h₂
  let c₃ := (RingEquiv.cast
    (R := fun p : s.scheme 0 => (s.scheme 0).presheaf.stalk p) h₃).toRingHom
  have hc : c₁.comp f₀ = f₂.comp c₂ := by
    have hh := congrArg CommRingCat.Hom.hom
      (Scheme.Hom.stalkMap_congr_point (s.toBase n) (s.point n)
        (s.stepMap n (s.point (n + 1))) hpt)
    simp only [CommRingCat.hom_comp] at hh
    rw [← stalkRingEquivCast_eq_stalkCongr_hom hpt] at hh
    rw [← stalkRingEquivCast_eq_stalkCongr_hom h₂] at hh
    simpa [c₁, c₂, f₀, f₂] using hh
  have hc₂ : c₂.comp c₀ = c₃ := by
    ext z
    exact congrArg (fun e => e z) (ringEquivCast_trans
      (R := fun p : s.scheme 0 => (s.scheme 0).presheaf.stalk p) hbase.symm h₂)
  rw [← initialToStage_apply s n x, ← initialToStage_apply s (n + 1) x]
  change (f₁.comp c₁) ((f₀.comp c₀) x) =
    (((s.toBase (n + 1)).stalkMap (s.point (n + 1))).hom.comp c₃) x
  calc
    (f₁.comp c₁) ((f₀.comp c₀) x) =
        (f₁.comp ((c₁.comp f₀).comp c₀)) x := by simp [RingHom.comp_assoc]
    _ = (f₁.comp ((f₂.comp c₂).comp c₀)) x := by rw [hc]
    _ = (f₁.comp (f₂.comp c₃)) x := by rw [RingHom.comp_assoc, hc₂]
    _ = (((s.toBase (n + 1)).stalkMap (s.point (n + 1))).hom.comp c₃) x := by
      simp [PointBlowupSequence.toBase, Scheme.Hom.stalkMap_comp, f₁, f₂]
      rfl

private lemma localStepMap_maximalIdeal_map_eq_span_initialImage
    (s : PointBlowupSequence.{u}) (x : localRingAt s 0)
    (hExceptional : ∀ n, s.exceptionalIdealAt n =
      Ideal.span {s.stalkImage (n + 1) x}) (n : ℕ) :
    Ideal.map (localStepMap s n) (IsLocalRing.maximalIdeal (localRingAt s n)) =
      Ideal.span {initialToStage s (n + 1) x} := by
  rw [localStepMap_maximalIdeal_map_eq_exceptionalIdealAt,
    hExceptional, initialToStage_apply]

private lemma initialToStage_succ_eq (s : PointBlowupSequence.{u}) (n : ℕ) :
    initialToStage s (n + 1) = (localStepMap s n).comp (initialToStage s n) := by
  ext x
  rw [RingHom.comp_apply, initialToStage_apply, initialToStage_apply, localStepMap_stalkImage]

private lemma initialToStage_isLocal (s : PointBlowupSequence.{u}) (n : ℕ) :
    IsLocalHom (initialToStage s n) := by
  dsimp [initialToStage]
  infer_instance

private lemma residueField_map_congr {A B : Type*} [CommRing A] [IsLocalRing A]
    [CommRing B] [IsLocalRing B] {f g : A →+* B} [IsLocalHom f] [IsLocalHom g]
    (h : f = g) : IsLocalRing.ResidueField.map f = IsLocalRing.ResidueField.map g := by
  subst g
  rfl

private lemma initialToStage_residueFieldMap_isIso (s : PointBlowupSequence.{u}) (n : ℕ) :
    letI : IsLocalHom (initialToStage s n) := initialToStage_isLocal s n
    IsIso (CommRingCat.ofHom
      (IsLocalRing.ResidueField.map (initialToStage s n))) := by
  induction n with
  | zero =>
      let : IsLocalHom (initialToStage s 0) := initialToStage_isLocal s 0
      rw [residueField_map_congr (initialToStage_zero s), IsLocalRing.ResidueField.map_id]
      exact IsIso.id _
  | succ n ih =>
      let : IsLocalHom (initialToStage s n) := initialToStage_isLocal s n
      let : IsLocalHom (initialToStage s (n + 1)) := initialToStage_isLocal s (n + 1)
      have : IsLocalHom (localStepMap s n) := localStepMap_isLocal s n
      have hmap : IsLocalRing.ResidueField.map (initialToStage s (n + 1)) =
          (IsLocalRing.ResidueField.map (localStepMap s n)).comp
            (IsLocalRing.ResidueField.map (initialToStage s n)) := by
        simpa [initialToStage_succ_eq] using
          (IsLocalRing.ResidueField.map_comp (initialToStage s n) (localStepMap s n))
      rw [hmap]
      exact IsIso.comp_isIso' ih (localStepMap_residueFieldMap_isIso s n)

private lemma stalkVanishingIdeal_cast {X : Scheme.{u}} (p q : X) (h : p = q) :
    (h.symm ▸ IsLocalRing.maximalIdeal (X.presheaf.stalk q)) =
      AlgebraicGeometry.IdealSheafData.stalk
        (Scheme.IdealSheafData.vanishingIdeal (Closeds.closure {q})) p := by
  subst q
  exact (stalkVanishingIdeal_singleton_eq_maximalIdeal p).symm

private lemma exceptionalIdealAt_eq_stalk_comap (s : PointBlowupSequence.{u}) (n : ℕ) :
    s.exceptionalIdealAt n = AlgebraicGeometry.IdealSheafData.stalk
      ((Scheme.IdealSheafData.vanishingIdeal
        (⟨{s.point n}, s.point_closed n⟩ : Closeds (s.scheme n))).comap (s.stepMap n))
      (s.point (n + 1)) := by
  rw [AlgebraicGeometry.IdealSheafData.stalk_comap]
  unfold PointBlowupSequence.exceptionalIdealAt
  congr 1
  have hcl : (⟨{s.point n}, s.point_closed n⟩ : Closeds (s.scheme n)) =
      Closeds.closure {s.point n} := by
    ext z
    simp [(s.point_closed n).closure_eq]
  rw [hcl]
  exact stalkVanishingIdeal_cast _ _ (s.point_step n)

private lemma stalkImage_succ_isRegular (s : PointBlowupSequence.{u})
    (x : localRingAt s 0)
    (hExceptional : ∀ n, s.exceptionalIdealAt n =
      Ideal.span {s.stalkImage (n + 1) x}) (n : ℕ) :
    _root_.IsRegular (s.stalkImage (n + 1) x) := by
  let I := Scheme.IdealSheafData.vanishingIdeal
    (⟨{s.point n}, s.point_closed n⟩ : Closeds (s.scheme n))
  let e := s.stepIso n
  let q := e.hom (s.point (n + 1))
  have hq : blowUpToBase I q = s.point n := by
    have ht := s.point_step n
    rw [s.stepMap_eq n] at ht
    exact ht
  have hsupport : q ∈ (exceptionalIdeal I).supportSet := by
    change q ∈ (I.comap (blowUpToBase I)).support
    rw [Scheme.IdealSheafData.support_comap]
    change blowUpToBase I q ∈ I.supportSet
    rw [hq]
    exact (Scheme.IdealSheafData.le_support_iff_le_vanishingIdeal.mpr
      (show I ≤ I from le_rfl)) (by simp)
  obtain ⟨y, hy, hspan⟩ := exists_regular_generator_stalk_of_effectiveCartier
    (exceptionalIdeal I) (by infer_instance) q hsupport
  let g := e.hom.stalkMap (s.point (n + 1))
  let E := (asIso g).commRingCatIsoToRingEquiv
  have hmap : s.exceptionalIdealAt n =
      Ideal.map g.hom
        (AlgebraicGeometry.IdealSheafData.stalk (exceptionalIdeal I) q) := by
    rw [exceptionalIdealAt_eq_stalk_comap, s.stepMap_eq, Scheme.IdealSheafData.comap_comp,
      AlgebraicGeometry.IdealSheafData.stalk_comap]
  have hspan' : Ideal.span {s.stalkImage (n + 1) x} = Ideal.span {E y} := by
    rw [← hExceptional n, hmap, hspan, Ideal.map_span, Set.image_singleton]
    rfl
  exact isRegular_of_span_eq_span (Stacks.Divisors.isRegular_ringEquiv E hy) hspan'

private def stalkStageHom (s : PointBlowupSequence.{u}) {n m : ℕ} (h : n ≤ m) :
    localRingAt s n →+* localRingAt s m :=
  Nat.leRecOn (C := fun k => localRingAt s n →+* localRingAt s k) h
    (fun {k} f => (localStepMap s k).comp f) (RingHom.id _)

/-- The transition map from a stage to itself is the identity. -/
private lemma stalkStageHom_self (s : PointBlowupSequence.{u}) (n : ℕ) :
    stalkStageHom s (le_refl n) = RingHom.id (localRingAt s n) := by
  simp [stalkStageHom, Nat.leRecOn_self]

/-- Extending a transition map by one more step composes with the local step map. -/
private lemma stalkStageHom_succ (s : PointBlowupSequence.{u}) {n k : ℕ} (hk : n ≤ k) :
    stalkStageHom s (Nat.le_succ_of_le hk) =
      (localStepMap s k).comp (stalkStageHom s hk) := by
  simp only [stalkStageHom, Nat.leRecOn_succ hk]

private lemma stalkStageHom_comp_base (s : PointBlowupSequence.{u})
    {n m k : ℕ} (hmk : m ≤ k) (f : localRingAt s n →+* localRingAt s m) :
    (stalkStageHom s hmk).comp f =
      Nat.leRecOn (C := fun j => localRingAt s n →+* localRingAt s j) hmk
        (fun {j} g => (localStepMap s j).comp g) f :=
  Nat.leRec (motive := fun j hj =>
      (stalkStageHom s hj).comp f =
        Nat.leRecOn (C := fun l => localRingAt s n →+* localRingAt s l) hj
          (fun {l} g => (localStepMap s l).comp g) f)
    (by simp [stalkStageHom, Nat.leRecOn_self])
    (fun {j} hj ih => by
      simp only [stalkStageHom, Nat.leRecOn_succ hj]
      change ((localStepMap s j).comp (stalkStageHom s hj)).comp f =
        (localStepMap s j).comp
          (Nat.leRecOn hj (fun {l} g => (localStepMap s l).comp g) f)
      calc
        ((localStepMap s j).comp (stalkStageHom s hj)).comp f =
            (localStepMap s j).comp ((stalkStageHom s hj).comp f) :=
          RingHom.comp_assoc _ _ _
        _ = (localStepMap s j).comp
              (Nat.leRecOn hj (fun {l} g => (localStepMap s l).comp g) f) := by rw [ih]) hmk

private def stalkStageDiagram (s : PointBlowupSequence.{u}) : ULift.{u} ℕ ⥤ CommRingCat.{u} where
  obj n := CommRingCat.of (localRingAt s n.down)
  map f := CommRingCat.ofHom (stalkStageHom s f.down.down)
  map_id n := by
    ext x
    simp [stalkStageHom, Nat.leRecOn_self]
  map_comp {X Y Z} f g := by
    have : IsFiltered ℕ := inferInstance
    ext x
    change stalkStageHom s (f ≫ g).down.down x =
      stalkStageHom s g.down.down (stalkStageHom s f.down.down x)
    have hcomp := Nat.leRecOn_trans
      (C := fun k => localRingAt s X.down →+* localRingAt s k)
      f.down.down g.down.down
      (next := fun {k} φ => (localStepMap s k).comp φ) (RingHom.id _)
    have hfg : (f ≫ g).down.down = Nat.le_trans f.down.down g.down.down :=
      Subsingleton.elim _ _
    rw [hfg]
    calc
      stalkStageHom s (Nat.le_trans f.down.down g.down.down) x =
          Nat.leRecOn (C := fun k => localRingAt s X.down →+* localRingAt s k)
            g.down.down (fun {k} φ => (localStepMap s k).comp φ)
            (stalkStageHom s f.down.down) x := by
        simpa only [stalkStageHom] using congrArg (fun φ => φ x) hcomp
      _ = stalkStageHom s g.down.down (stalkStageHom s f.down.down x) :=
        congrArg (fun φ : localRingAt s X.down →+* localRingAt s Z.down => φ x)
          (stalkStageHom_comp_base s g.down.down (stalkStageHom s f.down.down)).symm

private noncomputable def stalkLimit (s : PointBlowupSequence.{u}) : CommRingCat.{u} :=
  (Limits.colimit.cocone (stalkStageDiagram s)).pt

private noncomputable def stalkToLimit (s : PointBlowupSequence.{u}) (n : ℕ) :
    localRingAt s n →+* stalkLimit s :=
  ((Limits.colimit.cocone (stalkStageDiagram s)).ι.app (ULift.up n)).hom

/-- The underlying type of the stalk colimit is the colimit of the underlying types. -/
private lemma exists_iso_stalkLimit_forget (s : PointBlowupSequence.{u}) :
    ∃ e : (Limits.colimit.cocone (stalkStageDiagram s ⋙ forget CommRingCat)).pt ≅
        (stalkLimit s : Type u),
      ∀ n y, e.hom ((Limits.colimit.cocone (stalkStageDiagram s ⋙ forget CommRingCat)).ι.app
        (ULift.up n) y) = stalkToLimit s n y := by
  have : IsFiltered (ULift.{u} ℕ) := inferInstance
  have : Limits.PreservesColimitsOfShape (ULift.{u} ℕ) (forget CommRingCat.{u}) :=
    CommRingCat.FilteredColimits.forget_preservesFilteredColimits.{u}.preserves_filtered_colimits
      (ULift.{u} ℕ)
  let hG := Limits.colimit.isColimit (stalkStageDiagram s ⋙ forget CommRingCat)
  let hF := Limits.isColimitOfPreserves (forget CommRingCat)
    (Limits.colimit.isColimit (stalkStageDiagram s))
  refine ⟨hG.coconePointUniqueUpToIso hF, fun n y => ?_⟩
  have hnat : (Limits.colimit.cocone (stalkStageDiagram s ⋙ forget CommRingCat)).ι.app
      (ULift.up n) ≫ (hG.coconePointUniqueUpToIso hF).hom =
      (forget CommRingCat).map ((Limits.colimit.cocone (stalkStageDiagram s)).ι.app
        (ULift.up n)) := by
    simpa only [Functor.mapCocone_ι_app] using hG.comp_coconePointUniqueUpToIso_hom hF _
  exact congrArg (fun f => f y) hnat

private lemma stalkLimit_representation (s : PointBlowupSequence.{u}) (z : stalkLimit s) :
    ∃ n y, stalkToLimit s n y = z := by
  obtain ⟨e, he⟩ := exists_iso_stalkLimit_forget s
  obtain ⟨n, y, hy⟩ := CategoryTheory.Limits.Types.jointly_surjective_of_isColimit
    (Limits.colimit.isColimit (stalkStageDiagram s ⋙ forget CommRingCat)) (e.inv z)
  exact ⟨n.down, y, (he n.down y).symm.trans ((congrArg e.hom hy).trans (e.inv_hom_id_apply z))⟩

private lemma stalkLimit_equality (s : PointBlowupSequence.{u}) {n m : ℕ}
    {x : localRingAt s n} {y : localRingAt s m}
    (h : stalkToLimit s n x = stalkToLimit s m y) :
    ∃ k, ∃ hn : n ≤ k, ∃ hm : m ≤ k, stalkStageHom s hn x = stalkStageHom s hm y := by
  have : IsFiltered (ULift.{u} ℕ) := inferInstance
  obtain ⟨e, he⟩ := exists_iso_stalkLimit_forget s
  have heq := e.toEquiv.injective ((he n x).trans (h.trans (he m y).symm))
  obtain ⟨k, f, g, hfg⟩ := (CategoryTheory.Limits.Types.FilteredColimit.isColimit_eq_iff
    (F := stalkStageDiagram s ⋙ forget CommRingCat)
    (Limits.colimit.isColimit (stalkStageDiagram s ⋙ forget CommRingCat))).mp heq
  exact ⟨k.down, f.down.down, g.down.down, hfg⟩

private lemma stalkStageHom_isLocal (s : PointBlowupSequence.{u}) {n m : ℕ} (h : n ≤ m) :
    IsLocalHom (stalkStageHom s h) :=
  Nat.leRec (motive := fun k hk => IsLocalHom (stalkStageHom s hk))
    (by
      rw [stalkStageHom_self]
      infer_instance)
    (fun {k} hk ih => by
      rw [stalkStageHom_succ s hk]
      let : IsLocalHom (stalkStageHom s hk) := ih
      have : IsLocalHom (localStepMap s k) := localStepMap_isLocal s k
      exact RingHom.isLocalHom_comp _ _) h

private lemma stalkToLimit_succ (s : PointBlowupSequence.{u}) (n : ℕ)
    (y : localRingAt s n) :
    stalkToLimit s n y = stalkToLimit s (n + 1) (localStepMap s n y) := by
  let f : ULift.up n ⟶ ULift.up (n + 1) := homOfLE (Nat.le_succ n)
  have hf : (stalkStageDiagram s).map f =
      CommRingCat.ofHom (localStepMap s n) := by
    apply CommRingCat.hom_ext
    change stalkStageHom s f.down.down = localStepMap s n
    have hle : f.down.down = Nat.le_succ_of_le (le_refl n) := Subsingleton.elim _ _
    rw [hle, stalkStageHom_succ s (le_refl n), stalkStageHom_self, RingHom.comp_id]
  have hw := (Limits.colimit.cocone (stalkStageDiagram s)).w f
  rw [hf] at hw
  have hw' := congrArg (fun g : CommRingCat.of (localRingAt s n) ⟶ stalkLimit s => g y) hw.symm
  have hcomp := CommRingCat.comp_apply (CommRingCat.ofHom (localStepMap s n))
    ((Limits.colimit.cocone (stalkStageDiagram s)).ι.app (ULift.up (n + 1))) y
  have hcomp' :
      (CommRingCat.ofHom (localStepMap s n) ≫
        (Limits.colimit.cocone (stalkStageDiagram s)).ι.app (ULift.up (n + 1))) y =
      (CommRingCat.Hom.hom
          ((Limits.colimit.cocone (stalkStageDiagram s)).ι.app (ULift.up (n + 1))))
          (localStepMap s n y) := by
    convert hcomp using 1
  have hh := hw'.trans hcomp'
  convert hh using 1; rfl

private lemma stalkToLimit_initialToStage (s : PointBlowupSequence.{u})
    (x : localRingAt s 0) (n : ℕ) :
    stalkToLimit s n (initialToStage s n x) = stalkToLimit s 0 x := by
  induction n with
  | zero =>
      rw [initialToStage_zero]
      rfl
  | succ n ih =>
      rw [initialToStage_succ_eq]
      change stalkToLimit s (n + 1)
          (localStepMap s n (initialToStage s n x)) = stalkToLimit s 0 x
      rw [← stalkToLimit_succ, ih]

private lemma stalkToLimit_stageHom (s : PointBlowupSequence.{u}) {n m : ℕ}
    (h : n ≤ m) (y : localRingAt s n) :
    stalkToLimit s n y = stalkToLimit s m (stalkStageHom s h y) :=
  Nat.leRec (motive := fun k hk =>
      ∀ y : localRingAt s n,
        stalkToLimit s n y = stalkToLimit s k (stalkStageHom s hk y))
    (by intro y; rw [stalkStageHom_self]; rfl)
    (fun {k} hk ih => by
      intro y
      rw [stalkStageHom_succ, RingHom.comp_apply, ← stalkToLimit_succ]
      exact ih y) h y

private lemma stalkStageHom_stalkImage (s : PointBlowupSequence.{u})
    (x : localRingAt s 0) {n m : ℕ} (h : n ≤ m) :
    stalkStageHom s h (s.stalkImage n x) = s.stalkImage m x :=
  Nat.leRec (motive := fun k hk =>
      stalkStageHom s hk (s.stalkImage n x) = s.stalkImage k x)
    (by rw [stalkStageHom_self]; rfl)
    (fun {k} hk ih => by
      rw [stalkStageHom_succ s hk, RingHom.comp_apply, ih, localStepMap_stalkImage]) h

private lemma stalkLimit_param_isRegular (s : PointBlowupSequence.{u})
    (x : localRingAt s 0)
    (hreg : ∀ n, _root_.IsRegular (s.stalkImage (n + 1) x)) :
    _root_.IsRegular (stalkToLimit s 0 x) := by
  have hcancel (w : stalkLimit s) (hw : stalkToLimit s 0 x * w = 0) : w = 0 := by
    obtain ⟨n, a, haRep⟩ := stalkLimit_representation s w
    rw [← haRep] at hw
    have hinit := stalkToLimit_initialToStage s x n
    rw [initialToStage_apply] at hinit
    have hw' := hw
    rw [← hinit] at hw'
    have hzero' : stalkToLimit s n (s.stalkImage n x * a) = stalkToLimit s n 0 := by
      simpa only [map_mul, map_zero] using hw'
    obtain ⟨k, hn, hm, heq⟩ := stalkLimit_equality s hzero'
    have hmul : s.stalkImage (k + 1) x *
        localStepMap s k (stalkStageHom s hn a) = 0 := by
      simpa only [map_mul, map_zero, stalkStageHom_stalkImage s x hn,
        localStepMap_stalkImage] using congrArg (localStepMap s k) heq
    have haZero : localStepMap s k (stalkStageHom s hn a) = 0 := by
      apply (hreg k).left
      simpa using hmul
    have hlim := (stalkToLimit_stageHom s hn a).trans
      (stalkToLimit_succ s k (stalkStageHom s hn a))
    rw [haZero] at hlim
    exact haRep.symm.trans (by simpa using hlim)
  refine ⟨fun y z hyz => ?_, fun y z hyz => ?_⟩ <;>
    exact sub_eq_zero.mp (hcancel (y - z) (by linear_combination hyz))

private lemma stalkToLimit_mem_paramIdeal (s : PointBlowupSequence.{u})
    (x : localRingAt s 0)
    (hExceptional : ∀ n, s.exceptionalIdealAt n =
      Ideal.span {s.stalkImage (n + 1) x})
    {n : ℕ} {y : localRingAt s n}
    (hy : y ∈ IsLocalRing.maximalIdeal (localRingAt s n)) :
    stalkToLimit s n y ∈ Ideal.span {stalkToLimit s 0 x} := by
  have hmap := localStepMap_maximalIdeal_map_eq_span_initialImage s x hExceptional n
  have hy' := Ideal.mem_map_of_mem (localStepMap s n) hy
  rw [hmap] at hy'
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hy'
  have heq : stalkToLimit s n y =
      stalkToLimit s (n + 1) c * stalkToLimit s 0 x := by
    calc
      stalkToLimit s n y = stalkToLimit s (n + 1) (localStepMap s n y) :=
        stalkToLimit_succ s n y
      _ = stalkToLimit s (n + 1) (c * initialToStage s (n + 1) x) := by rw [hc]
      _ = stalkToLimit s (n + 1) c * stalkToLimit s (n + 1)
            (initialToStage s (n + 1) x) := map_mul _ _ _
      _ = stalkToLimit s (n + 1) c * stalkToLimit s 0 x := by
        rw [stalkToLimit_initialToStage s x (n + 1)]
  rw [heq]
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)

private lemma stalkLimit_unit_of_not_mem_paramIdeal (s : PointBlowupSequence.{u})
    (x : localRingAt s 0)
    (hExceptional : ∀ n, s.exceptionalIdealAt n =
      Ideal.span {s.stalkImage (n + 1) x})
    {z : stalkLimit s} (hz : z ∉ Ideal.span {stalkToLimit s 0 x}) : IsUnit z := by
  obtain ⟨n, y, rfl⟩ := stalkLimit_representation s z
  have hy : y ∉ IsLocalRing.maximalIdeal (localRingAt s n) :=
    fun h => hz (stalkToLimit_mem_paramIdeal s x hExceptional h)
  exact (IsLocalRing.notMem_maximalIdeal.mp hy).map (stalkToLimit s n)

private lemma stalkToLimit_param_not_unit (s : PointBlowupSequence.{u})
    (x : localRingAt s 0)
    (hx : x ∈ IsLocalRing.maximalIdeal (localRingAt s 0))
    (_hExceptional : ∀ n, s.exceptionalIdealAt n =
      Ideal.span {s.stalkImage (n + 1) x}) :
    ¬ IsUnit (stalkToLimit s 0 x) := by
  intro hxunit
  let z : stalkLimit s :=
    ((hxunit.unit⁻¹ : (↑(stalkLimit s))ˣ) : ↑(stalkLimit s))
  obtain ⟨n, y, hy⟩ := stalkLimit_representation s z
  have hprod : stalkToLimit s n (initialToStage s n x * y) =
      stalkToLimit s 0 (1 : localRingAt s 0) := by
    calc
      stalkToLimit s n (initialToStage s n x * y) =
          stalkToLimit s n (initialToStage s n x) * stalkToLimit s n y := map_mul _ _ _
      _ = stalkToLimit s 0 x * z := by rw [stalkToLimit_initialToStage, hy]
      _ = stalkToLimit s 0 (1 : localRingAt s 0) := by
        rw [← hxunit.unit_spec]
        simp [z]
  obtain ⟨k, hnk, h0k, heq⟩ := stalkLimit_equality s hprod
  let f := stalkStageHom s hnk
  have : IsLocalHom f := stalkStageHom_isLocal s hnk
  have hxinit : initialToStage s n x ∈ IsLocalRing.maximalIdeal (localRingAt s n) := by
    let : IsLocalHom (initialToStage s n) := initialToStage_isLocal s n
    exact IsLocalRing.map_maximalIdeal_le (initialToStage s n)
      (Ideal.mem_map_of_mem (initialToStage s n) hx)
  have hxk : f (initialToStage s n x) ∈ IsLocalRing.maximalIdeal (localRingAt s k) :=
    IsLocalRing.map_maximalIdeal_le f (Ideal.mem_map_of_mem f hxinit)
  have hprodmem : f (initialToStage s n x * y) ∈
      IsLocalRing.maximalIdeal (localRingAt s k) := by
    rw [map_mul]
    exact Ideal.mul_mem_right (f y) _ hxk
  have hone : (1 : localRingAt s k) ∈ IsLocalRing.maximalIdeal (localRingAt s k) := by
    have hone' : (stalkStageHom s h0k) 1 ∈ IsLocalRing.maximalIdeal (localRingAt s k) :=
      heq ▸ hprodmem
    simp at hone'
  exact (IsLocalRing.maximalIdeal.isMaximal (localRingAt s k)).ne_top
    ((Ideal.eq_top_iff_one _).mpr hone)

private theorem stalkLimit_isLocalRing (s : PointBlowupSequence.{u})
    (x : localRingAt s 0)
    (hExceptional : ∀ n, s.exceptionalIdealAt n =
      Ideal.span {s.stalkImage (n + 1) x})
    (hx : x ∈ IsLocalRing.maximalIdeal (localRingAt s 0)) :
    IsLocalRing (stalkLimit s) := by
  have hxnotunit := stalkToLimit_param_not_unit s x hx hExceptional
  have hnontrivial : (0 : stalkLimit s) ≠ 1 := by
    intro h
    have : Subsingleton (stalkLimit s) := subsingleton_of_zero_eq_one h
    exact hxnotunit (isUnit_of_subsingleton _)
  let : Nontrivial (stalkLimit s) := ⟨⟨0, 1, hnontrivial⟩⟩
  exact IsLocalRing.of_isUnit_or_isUnit_one_sub_self fun z => by
    by_cases hz : IsUnit z
    · exact Or.inl hz
    · have hzspan : z ∈ Ideal.span {stalkToLimit s 0 x} := by
        obtain ⟨n, y, rfl⟩ := stalkLimit_representation s z
        have hy : y ∈ IsLocalRing.maximalIdeal (localRingAt s n) := by
          by_contra hy
          exact hz ((IsLocalRing.notMem_maximalIdeal.mp hy).map (stalkToLimit s n))
        exact stalkToLimit_mem_paramIdeal s x hExceptional hy
      right
      apply stalkLimit_unit_of_not_mem_paramIdeal s x hExceptional
      intro hone
      have htop : Ideal.span {stalkToLimit s 0 x} = ⊤ :=
        (Ideal.eq_top_iff_one _).mpr (by
          have hz' := Ideal.add_mem _ hzspan hone
          simpa using hz')
      exact hxnotunit (Ideal.span_singleton_eq_top.mp htop)

private lemma stalkLimit_maximalIdeal_eq_span (s : PointBlowupSequence.{u})
    (x : localRingAt s 0)
    (hExceptional : ∀ n, s.exceptionalIdealAt n =
      Ideal.span {s.stalkImage (n + 1) x})
    (hlocal : IsLocalRing (stalkLimit s))
    (hx : x ∈ IsLocalRing.maximalIdeal (localRingAt s 0)) :
    IsLocalRing.maximalIdeal (stalkLimit s) = Ideal.span {stalkToLimit s 0 x} := by
  let : IsLocalRing (↑(stalkLimit s)) := hlocal
  apply le_antisymm
  · intro z hz
    by_contra hnot
    have hzunit := stalkLimit_unit_of_not_mem_paramIdeal s x hExceptional hnot
    exact (IsLocalRing.notMem_maximalIdeal.mpr hzunit) hz
  · intro z hz
    by_contra hnot
    have huz : IsUnit z := IsLocalRing.notMem_maximalIdeal.mp hnot
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp hz
    exact stalkToLimit_param_not_unit s x hx hExceptional
      (isUnit_of_mul_isUnit_right (x := c) (hc ▸ huz))

private theorem adicCompletion_isDVR_of_principal_maximalIdeal
    {S : Type u} [CommRing S] [IsLocalRing S] {π : S}
    (hmax : IsLocalRing.maximalIdeal S = Ideal.span {π}) (hreg : _root_.IsRegular π) :
    ∃ (hDomain : IsDomain (AdicCompletion (IsLocalRing.maximalIdeal S) S)),
      ∃ (hDVR : IsDiscreteValuationRing (AdicCompletion (IsLocalRing.maximalIdeal S) S)),
        letI : IsDomain (AdicCompletion (IsLocalRing.maximalIdeal S) S) := hDomain
        letI : IsDiscreteValuationRing (AdicCompletion (IsLocalRing.maximalIdeal S) S) := hDVR
        IsAdicComplete
            (IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal S) S))
            (AdicCompletion (IsLocalRing.maximalIdeal S) S) ∧
          IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal S) S) =
            Ideal.span {algebraMap S (AdicCompletion (IsLocalRing.maximalIdeal S) S) π} := by
  have hfg : (IsLocalRing.maximalIdeal S).FG := hmax ▸ Submodule.fg_span (Set.finite_singleton π)
  let : IsLocalRing (AdicCompletion (IsLocalRing.maximalIdeal S) S) :=
    AdicCompletion.isLocalRing_of_fg hfg
  have hcomplete : IsAdicComplete
      (IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal S) S))
      (AdicCompletion (IsLocalRing.maximalIdeal S) S) :=
    AdicCompletion.isAdicComplete_of_fg hfg
  have hmaxC : IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal S) S) =
      Ideal.span {algebraMap S (AdicCompletion (IsLocalRing.maximalIdeal S) S) π} := by
    rw [AdicCompletion.maximalIdeal_eq_map_of_fg hfg, hmax, Ideal.map_span]
    simp
  have hπmem : π ∈ IsLocalRing.maximalIdeal S := hmax ▸ Ideal.subset_span rfl
  have hpowS : ∀ n : ℕ, π ^ n ∉ (IsLocalRing.maximalIdeal S) ^ (n + 1) := by
    intro n
    have hgen : Ideal.map (RingHom.id S) (IsLocalRing.maximalIdeal S) =
        Ideal.span {RingHom.id S π} := by simp [hmax]
    simpa using pow_not_mem_maximalIdeal_pow_of_regular_generator
      (RingHom.id S) π hgen hπmem hreg n
  have hpowC : ∀ n : ℕ,
      (algebraMap S (AdicCompletion (IsLocalRing.maximalIdeal S) S) π) ^ n ≠ 0 := by
    intro n hn
    have hzero : algebraMap S (AdicCompletion (IsLocalRing.maximalIdeal S) S) (π ^ n) = 0 := by
      simpa only [map_pow] using hn
    have heval := congrArg (AdicCompletion.evalₐ (IsLocalRing.maximalIdeal S) (n + 1)) hzero
    have hq : Ideal.Quotient.mk ((IsLocalRing.maximalIdeal S) ^ (n + 1)) (π ^ n) = 0 := by
      simpa [AdicCompletion.algebraMap_apply, AdicCompletion.evalₐ_of] using heval
    have hmem : π ^ n ∈ (IsLocalRing.maximalIdeal S) ^ (n + 1) :=
      (Ideal.Quotient.eq_zero_iff_mem).mp hq
    exact hpowS n hmem
  let : IsHausdorff
      (IsLocalRing.maximalIdeal (AdicCompletion (IsLocalRing.maximalIdeal S) S))
      (AdicCompletion (IsLocalRing.maximalIdeal S) S) := hcomplete.toIsHausdorff
  have : IsNoetherianRing (AdicCompletion (IsLocalRing.maximalIdeal S) S) :=
    isNoetherian_of_hausdorff_principal_maximalIdeal hmaxC
  obtain ⟨hDomain, hDVR⟩ :=
    exists_isDomain_isDiscreteValuationRing_of_complete_principal_maximalIdeal hmaxC hpowC
  exact ⟨hDomain, hDVR, hcomplete, hmaxC⟩

private lemma stalkToLimit_isLocal (s : PointBlowupSequence.{u})
    (x : localRingAt s 0)
    (hx : x ∈ IsLocalRing.maximalIdeal (localRingAt s 0))
    (hExceptional : ∀ n, s.exceptionalIdealAt n =
      Ideal.span {s.stalkImage (n + 1) x})
    [IsLocalRing (stalkLimit s)] (n : ℕ) : IsLocalHom (stalkToLimit s n) := by
  apply ((IsLocalRing.local_hom_TFAE (stalkToLimit s n)).out 3 1).mp
  rw [stalkLimit_maximalIdeal_eq_span s x hExceptional inferInstance hx,
    Ideal.map_le_iff_le_comap]
  exact fun y hy => stalkToLimit_mem_paramIdeal s x hExceptional hy

private lemma stalkToLimit_residueFieldMap_bijective (s : PointBlowupSequence.{u})
    (x : localRingAt s 0)
    (hx : x ∈ IsLocalRing.maximalIdeal (localRingAt s 0))
    (hExceptional : ∀ n, s.exceptionalIdealAt n =
      Ideal.span {s.stalkImage (n + 1) x})
    [IsLocalRing (stalkLimit s)]
    [IsLocalHom (stalkToLimit s 0)] :
    Function.Bijective (IsLocalRing.ResidueField.map (stalkToLimit s 0)) := by
  refine ⟨RingHom.injective _, ?_⟩
  intro z
  obtain ⟨w, rfl⟩ := IsLocalRing.residue_surjective z
  obtain ⟨n, y, rfl⟩ := stalkLimit_representation s w
  have := stalkToLimit_isLocal s x hx hExceptional n
  have := initialToStage_isLocal s n
  obtain ⟨b, hb⟩ := (ConcreteCategory.isIso_iff_bijective _).mp
    (initialToStage_residueFieldMap_isIso s n) |>.2 (IsLocalRing.residue _ y)
  change IsLocalRing.ResidueField.map (initialToStage s n) b =
    IsLocalRing.residue _ y at hb
  refine ⟨b, ?_⟩
  have hcomp : (stalkToLimit s n).comp (initialToStage s n) = stalkToLimit s 0 := by
    ext t
    exact stalkToLimit_initialToStage s t n
  simpa only [← hcomp, IsLocalRing.ResidueField.map_comp, RingHom.comp_apply,
    IsLocalRing.ResidueField.map_residue] using
    congrArg (IsLocalRing.ResidueField.map (stalkToLimit s n)) hb

private lemma specMap_fromSpecStalk_comp {X Y : Scheme.{u}} (g : X ⟶ Y)
    (p : X) (q : Y) (hp : g p = q) {R : CommRingCat.{u}}
    (f : X.presheaf.stalk p ⟶ R) :
    (Spec.map f ≫ X.fromSpecStalk p) ≫ g =
      Spec.map ((Y.presheaf.stalkCongr (.of_eq hp.symm)).hom ≫ g.stalkMap p ≫ f) ≫
        Y.fromSpecStalk q := by
  subst q
  simp [Spec.map_comp, Category.assoc, TopCat.Presheaf.stalkCongr_hom]

private lemma stalkCongr_cast_apply {X : Scheme.{u}} {p q : X}
    (h : p = q) (y : X.presheaf.stalk q) :
    (X.presheaf.stalkCongr (.of_eq h)).hom.hom (h.symm ▸ y) = y := by
  subst q
  simp [TopCat.Presheaf.stalkCongr_hom]

/-- The map at the closed point of a local-ring morphism is the original map up to `stalkCongr`. -/
private lemma stalkClosedPointTo_eq_stalkCongr {X : Scheme.{u}} {R : CommRingCat.{u}}
    [IsLocalRing R] (p : X) (f : X.presheaf.stalk p ⟶ R) [IsLocalHom f.hom] :
    ∃ h : (Spec.map f ≫ X.fromSpecStalk p) (IsLocalRing.closedPoint R) = p,
      Scheme.stalkClosedPointTo (Spec.map f ≫ X.fromSpecStalk p) =
        (X.presheaf.stalkCongr (.of_eq h)).hom ≫ f := by
  have he := (SpecToEquivOfLocalRing X R).apply_symm_apply ⟨p, f, inferInstance⟩
  exact SpecToEquivOfLocalRing_eq_iff.mp he

private lemma stalkClosedPointTo_transport {X : Scheme.{u}} {R : CommRingCat.{u}}
    [IsLocalRing R] (p : X) (f : X.presheaf.stalk p ⟶ R) [IsLocalHom f.hom] :
    ∃ h : (Spec.map f ≫ X.fromSpecStalk p) (IsLocalRing.closedPoint R) = p,
      ∀ y : X.presheaf.stalk p,
        (Scheme.stalkClosedPointTo (Spec.map f ≫ X.fromSpecStalk p)).hom (h.symm ▸ y) =
          f.hom y := by
  obtain ⟨h, hh⟩ := stalkClosedPointTo_eq_stalkCongr p f
  refine ⟨h, fun y => ?_⟩
  rw [hh]
  exact congrArg f.hom (stalkCongr_cast_apply h y)

private lemma residueFieldMap_isIso_of_stalkClosedPointTo {X : Scheme.{u}}
    {R : CommRingCat.{u}} [IsLocalRing R] (a : Spec R ⟶ X)
    (h : Function.Bijective (IsLocalRing.ResidueField.map (Scheme.stalkClosedPointTo a).hom)) :
    IsIso (a.residueFieldMap (IsLocalRing.closedPoint R)) := by
  let p : Spec R := IsLocalRing.closedPoint R
  let e : (Spec R).presheaf.stalk p ≅ R := stalkClosedPointIso R
  have he : Function.Bijective (IsLocalRing.ResidueField.map
      e.hom.hom) :=
    (IsLocalRing.ResidueField.mapEquiv
      e.commRingCatIsoToRingEquiv).bijective
  have hcomp : (IsLocalRing.ResidueField.map (Scheme.stalkClosedPointTo a).hom) =
      (IsLocalRing.ResidueField.map e.hom.hom).comp
        (a.residueFieldMap (IsLocalRing.closedPoint R)).hom :=
    IsLocalRing.ResidueField.map_comp (a.stalkMap p).hom e.hom.hom
  apply (ConcreteCategory.isIso_iff_bijective _).mpr
  change Function.Bijective (a.residueFieldMap p).hom
  refine ⟨RingHom.injective _, ?_⟩
  intro y
  obtain ⟨z, hz⟩ := h.2 (IsLocalRing.ResidueField.map e.hom.hom y)
  refine ⟨z, he.1 ?_⟩
  exact (congrArg (fun φ => φ z) hcomp).symm.trans hz

/-- **Stacks Project, Tag 0BG2.** An infinite point-blowup sequence whose
exceptional divisors are locally defined by the transforms of one initial
function is induced by a nonsingular formal arc. -/
@[stacks 0BG2]
theorem exists_nonsingularFormalArc_of_pointBlowupSequence
    (s : PointBlowupSequence.{u}) [IsLocallyNoetherian (s.scheme 0)]
    (x : (s.scheme 0).presheaf.stalk (s.point 0))
    (hx : x ∈ IsLocalRing.maximalIdeal ((s.scheme 0).presheaf.stalk (s.point 0)))
    (hExceptional : ∀ n, s.exceptionalIdealAt n =
      Ideal.span {s.stalkImage (n + 1) x}) :
    ∃ (R : CommRingCat.{u}) (hDomain : IsDomain R),
      letI : IsDomain R := hDomain
      ∃ (hDVR : IsDiscreteValuationRing R),
        letI : IsDiscreteValuationRing R := hDVR
        ∃ (_hComplete : IsAdicComplete (IsLocalRing.maximalIdeal R) R)
          (a : Spec R ⟶ s.scheme 0)
          (hCenter : a (IsLocalRing.closedPoint R) = s.point 0),
          IsIso (a.residueFieldMap (IsLocalRing.closedPoint R)) ∧
          IsLocalRing.maximalIdeal R =
            Ideal.span {(Scheme.stalkClosedPointTo a).hom (hCenter.symm ▸ x)} ∧
          ∃ lifts : (n : ℕ) → Spec R ⟶ s.scheme n,
            lifts 0 = a ∧
            (∀ n, lifts (n + 1) ≫ s.stepMap n = lifts n) ∧
            (∀ n, lifts n (IsLocalRing.closedPoint R) = s.point n) := by
  let : IsLocalRing (stalkLimit s) := stalkLimit_isLocalRing s x hExceptional hx
  have hmax := stalkLimit_maximalIdeal_eq_span s x hExceptional inferInstance hx
  have hfg : (IsLocalRing.maximalIdeal (stalkLimit s)).FG := by
    rw [hmax]
    exact Submodule.fg_span (Set.finite_singleton _)
  let R : CommRingCat.{u} := .of (AdicCompletion (IsLocalRing.maximalIdeal (stalkLimit s))
    (stalkLimit s))
  obtain ⟨hDomain, hDVR, hComplete, hmaxR⟩ :=
    adicCompletion_isDVR_of_principal_maximalIdeal hmax
      (stalkLimit_param_isRegular s x (stalkImage_succ_isRegular s x hExceptional))
  let : IsDomain R := hDomain
  let : IsDiscreteValuationRing R := hDVR
  let c : stalkLimit s →+* R := algebraMap (stalkLimit s) R
  have : IsLocalHom c := AdicCompletion.algebraMap_isLocalHom_of_fg hfg
  have (n : ℕ) : IsLocalHom (stalkToLimit s n) :=
    stalkToLimit_isLocal s x hx hExceptional n
  let f (n : ℕ) : (s.scheme n).presheaf.stalk (s.point n) ⟶ R :=
    CommRingCat.ofHom (c.comp (stalkToLimit s n))
  have (n : ℕ) : IsLocalHom (f n).hom := RingHom.isLocalHom_comp _ _
  let lifts (n : ℕ) : Spec R ⟶ s.scheme n :=
    Spec.map (f n) ≫ (s.scheme n).fromSpecStalk (s.point n)
  obtain ⟨hCenter, hstalk⟩ := stalkClosedPointTo_transport (s.point 0) (f 0)
  refine ⟨R, hDomain, hDVR, hComplete, lifts 0, hCenter, ?_, ?_, lifts, rfl, ?_, ?_⟩
  · have hf : Function.Bijective (IsLocalRing.ResidueField.map (f 0).hom) := by
      change Function.Bijective (IsLocalRing.ResidueField.map (c.comp (stalkToLimit s 0)))
      rw [IsLocalRing.ResidueField.map_comp]
      exact (AdicCompletion.residueField_map_bijective_of_fg hfg).comp
        (stalkToLimit_residueFieldMap_bijective s x hx hExceptional)
    apply residueFieldMap_isIso_of_stalkClosedPointTo
    obtain ⟨h, hh⟩ := stalkClosedPointTo_eq_stalkCongr (s.point 0) (f 0)
    have ht := hf.comp (IsLocalRing.ResidueField.mapEquiv
      ((s.scheme 0).presheaf.stalkCongr (.of_eq h)).commRingCatIsoToRingEquiv).bijective
    have hh' : (Scheme.stalkClosedPointTo (lifts 0)).hom =
        (f 0).hom.comp ((s.scheme 0).presheaf.stalkCongr (.of_eq h)).hom.hom :=
      congrArg CommRingCat.Hom.hom hh
    have hc := IsLocalRing.ResidueField.map_comp
      ((s.scheme 0).presheaf.stalkCongr (.of_eq h)).hom.hom (f 0).hom
    have hg : IsLocalHom ((f 0).hom.comp
        ((s.scheme 0).presheaf.stalkCongr (.of_eq h)).hom.hom) :=
      hh' ▸ (inferInstance : IsLocalHom (Scheme.stalkClosedPointTo (lifts 0)).hom)
    have hm := (@residueField_map_congr _ _ _ _ _ _ _ _
      (Scheme.isLocalHom_stalkClosedPointTo (lifts 0)) hg hh').trans hc
    rw [hm]
    exact ht
  · rwa [hstalk]
  · intro n
    rw [show lifts (n + 1) = Spec.map (f (n + 1)) ≫
      (s.scheme (n + 1)).fromSpecStalk (s.point (n + 1)) from rfl]
    rw [specMap_fromSpecStalk_comp (s.stepMap n) (s.point (n + 1)) (s.point n)
      (s.point_step n)]
    change Spec.map _ ≫ _ = Spec.map (f n) ≫ _
    congr 2
    apply CommRingCat.hom_ext
    apply RingHom.ext
    intro y
    change c (stalkToLimit s (n + 1)
      (((s.stepMap n).stalkMap (s.point (n + 1))).hom
        (((s.scheme n).presheaf.stalkCongr (.of_eq (s.point_step n).symm)).hom.hom y))) =
      c (stalkToLimit s n y)
    rw [← stalkRingEquivCast_eq_stalkCongr_hom (s.point_step n).symm]
    exact congrArg c (stalkToLimit_succ s n y).symm
  · intro n
    exact (stalkClosedPointTo_transport (s.point n) (f n)).choose

end AlgebraicGeometry

