/-!
# Formal arcs: affine blowup charts

Regularity of a local ring surjecting onto a discrete valuation ring with principal kernel,
the standard affine blowup chart through which the lifted arc factors, and regularity of the
centre from relations modulo the square of the arc kernel.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace IsLocalRing

namespace AlgebraicGeometry

universe u

/-- Nakayama's lemma upgrades relations modulo `p²` to a global generator:
if every chosen generator of `p` is congruent to a multiple of `x` modulo `p²`,
then `x` generates `p`. -/
private theorem ideal_eq_span_singleton_of_generators_mod_square
    {S ι : Type u} [CommRing S] [IsLocalRing S] [Fintype ι]
    (p : Ideal S) (y : ι → S) (k : ι)
    (hp : p = Ideal.span (Set.range y)) (hfg : p.FG)
    (hpm : p ≤ maximalIdeal S)
    (hyk : y k ∈ p)
    (hrel : ∀ i, ∃ c : S, y i - c * y k ∈ p ^ 2) :
    p = Ideal.span {y k} := by
  let q : Ideal S := Ideal.span {y k}
  have hq : q ≤ p := Ideal.span_le.2 (Set.singleton_subset_iff.2 hyk)
  have hp2 : p ^ 2 ≤ maximalIdeal S • p := by
    rw [pow_two, Ideal.smul_eq_mul]
    exact Ideal.mul_mono_left hpm
  have hle : p ≤ q ⊔ maximalIdeal S • p := by
    conv_lhs => rw [hp]
    refine Ideal.span_le.2 ?_
    rintro z ⟨i, rfl⟩
    obtain ⟨c, hc⟩ := hrel i
    simpa using Submodule.add_mem_sup
      (Ideal.mul_mem_left q c (Ideal.mem_span_singleton_self _)) (hp2 hc)
  have hnak := Submodule.sup_eq_sup_smul_of_le_smul_of_le_jacobson
    (N := q) (N' := p) hfg (IsLocalRing.maximalIdeal_le_jacobson (⊥ : Ideal S)) hle
  have hq' : q ⊔ p = q := by simpa [Submodule.bot_smul] using hnak
  exact (sup_eq_right.mpr hq).symm.trans hq'

/-- For a surjection onto a local ring whose maximal ideal is generated by the image of `a`,
the contracted maximal ideal is generated by `a` together with the kernel generators. -/
private theorem comap_maximalIdeal_eq_span
    {A R : Type u} {ι : Type*} [CommRing A] [CommRing R] [IsLocalRing R]
    (f : A →+* R) (hf : Function.Surjective f) (a : A) (x : ι → A)
    (hp : RingHom.ker f = Ideal.span (Set.range x))
    (hπ : maximalIdeal R = Ideal.span {f a}) :
    (maximalIdeal R).comap f = Ideal.span (insert a (Set.range x)) := by
  apply le_antisymm
  · intro b hb
    change f b ∈ maximalIdeal R at hb
    rw [hπ, Ideal.mem_span_singleton] at hb
    obtain ⟨r, hr⟩ := hb
    obtain ⟨c, rfl⟩ := hf r
    have hker : b - c * a ∈ RingHom.ker f := by
      rw [RingHom.mem_ker, map_sub, map_mul, hr]
      ring
    have hmem := Ideal.span_mono (Set.subset_insert a (Set.range x)) (hp ▸ hker)
    have hca : c * a ∈ Ideal.span (insert a (Set.range x)) :=
      Ideal.mul_mem_left _ c (Ideal.subset_span (Set.mem_insert a _))
    simpa using (Ideal.span (insert a (Set.range x))).add_mem hmem hca
  · apply Ideal.span_le.mpr
    rintro b (rfl | ⟨i, rfl⟩)
    · show f b ∈ maximalIdeal R
      rw [hπ]
      exact Ideal.subset_span rfl
    · have hi : x i ∈ RingHom.ker f := hp ▸ Ideal.subset_span ⟨i, rfl⟩
      show f (x i) ∈ maximalIdeal R
      rw [show f (x i) = 0 from hi]
      exact Ideal.zero_mem _

/-- A Noetherian local domain surjecting onto a discrete valuation ring with principal kernel
is a regular local ring. -/
private theorem regular_of_surjective_dvr_of_principal_kernel
    {A R : Type u} [CommRing A] [IsDomain A] [IsLocalRing A] [IsNoetherianRing A]
    [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (f : A →+* R) (hf : Function.Surjective f) (hker : (RingHom.ker f).IsPrincipal) :
    IsRegularLocalRing A := by
  let p := RingHom.ker f
  have : p.IsPrime := RingHom.ker_isPrime f
  by_cases hp : p = ⊥
  · have e : A ≃+* R := RingEquiv.ofBijective f
      ⟨(RingHom.injective_iff_ker_eq_bot f).mpr hp, hf⟩
    exact IsRegularLocalRing.of_ringEquiv e.symm
  have hpn : p ≠ maximalIdeal A := by
    intro h
    have hm := IsLocalRing.map_maximalIdeal_of_surjective f hf
    rw [← h, (Ideal.map_eq_bot_iff_le_ker f).mpr le_rfl] at hm
    exact IsDiscreteValuationRing.not_a_field R hm.symm
  have hplt : p < maximalIdeal A :=
    lt_of_le_of_ne (IsLocalRing.le_maximalIdeal_of_isPrime p) hpn
  have hpone : 1 ≤ p.height :=
    Order.one_le_iff_ne_zero.mpr (fun h => hp (Ideal.height_eq_zero_iff_eq_bot.mp h))
  have hdim : (2 : WithBot ℕ∞) ≤ ringKrullDim A := by
    rw [← maximalIdeal_height_eq_ringKrullDim]
    exact WithBot.coe_le_coe.mpr ((ENat.add_one_le_iff (by simp)).mpr
      (hpone.trans_lt (Ideal.height_strict_mono_of_isPrime hplt)))
  obtain ⟨a, ha⟩ := IsPrincipalIdealRing.principal (maximalIdeal R)
  obtain ⟨t, rfl⟩ := hf a
  obtain ⟨b, hb⟩ := hker
  have : IsLocalHom f := IsLocalHom.of_surjective f hf
  have hmax : maximalIdeal A = Ideal.span ({t, b} : Set A) := by
    have h := comap_maximalIdeal_eq_span f hf t (fun _ : Unit => b)
      (by simpa using hb) ha
    simpa only [IsLocalRing.maximalIdeal_comap, Set.range_const] using h
  apply IsRegularLocalRing.of_spanFinrank_maximalIdeal_le
  apply le_trans _ hdim
  rw [hmax]
  have hcard : ({t, b} : Set A).ncard ≤ 2 := by
    simpa using Set.ncard_insert_le t ({b} : Set A)
  have hfin : (Ideal.span ({t, b} : Set A)).spanFinrank ≤ 2 :=
    (Submodule.spanFinrank_span_le_ncard_of_finite (by simp)).trans hcard
  exact_mod_cast hfin
/-- The kernel of a map out of a localization is the image of the kernel of the original map. -/
private theorem ker_eq_map_of_isLocalization
    {A L R : Type u} [CommRing A] [CommRing L] [CommRing R] [Algebra A L]
    (M : Submonoid A) [IsLocalization M L]
    (f : A →+* R) (g : L →+* R) (hcomp : g.comp (algebraMap A L) = f) :
    RingHom.ker g = (RingHom.ker f).map (algebraMap A L) := by
  apply le_antisymm
  · intro z hz
    obtain ⟨a, s, hs⟩ := IsLocalization.exists_mk'_eq M z
    have ha : a ∈ RingHom.ker f := by
      show f a = 0
      have he := congrArg g (IsLocalization.mk'_spec L a s)
      rw [map_mul, hs, show g z = 0 from hz, zero_mul] at he
      exact (congrArg (fun h : A →+* R => h a) hcomp).symm.trans he.symm
    rw [← hs]
    apply (IsLocalization.mk'_mem_map_algebraMap_iff M L (RingHom.ker f) a s).mpr
    exact ⟨1, M.one_mem, by simpa using ha⟩
  · apply Ideal.map_le_iff_le_comap.mpr
    intro a ha
    show g (algebraMap A L a) = 0
    rw [← RingHom.comp_apply, hcomp]
    exact ha

/-- A generating family for the center ideal gives algebra generators for its
standard affine blowup chart. -/
private theorem affineBlowupAlgebra_eq_adjoin_of_span
    {A S ι : Type*} [CommRing A] [CommRing S] [Algebra A S]
    (a : A) [IsLocalization.Away a S] (x : ι → A) (I : Ideal A)
    (hI : I = Ideal.span (insert a (Set.range x))) :
    affineBlowupAlgebra I a S = Algebra.adjoin A
      (Set.range fun i => IsLocalization.mk' S (x i) ⟨a, Submonoid.mem_powers a⟩) := by
  let d : Submonoid.powers a := ⟨a, Submonoid.mem_powers a⟩
  let T := Algebra.adjoin A (Set.range fun i => IsLocalization.mk' S (x i) d)
  have hfrac (b : A) : IsLocalization.mk' S b d =
      algebraMap A S b * IsLocalization.mk' S 1 d := by
    rw [IsLocalization.mul_mk'_eq_mk'_of_mul, mul_one]
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro b ⟨c, hc, rfl⟩
    show IsLocalization.mk' S c d ∈ T
    rw [hI] at hc
    induction hc using Submodule.span_induction with
    | mem c hc =>
        rcases hc with rfl | ⟨i, rfl⟩
        · simpa only [d, IsLocalization.mk'_self] using T.one_mem
        · exact Algebra.subset_adjoin ⟨i, rfl⟩
    | zero => simpa only [IsLocalization.mk'_zero] using T.zero_mem
    | add b c _ _ hb hc =>
        rw [hfrac b] at hb
        rw [hfrac c] at hc
        rw [hfrac (b + c), map_add, add_mul]
        exact T.add_mem hb hc
    | smul r b _ hb =>
        rw [hfrac b] at hb
        rw [smul_eq_mul, hfrac (r * b), map_mul, mul_assoc]
        exact T.mul_mem (T.algebraMap_mem r) hb
  · apply Algebra.adjoin_le
    rintro b ⟨i, rfl⟩
    apply Algebra.subset_adjoin
    refine ⟨x i, ?_, rfl⟩
    rw [hI]
    exact Ideal.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩)

/-- Modulo the ideal generated by algebra generators, every element comes from
the coefficient ring. -/
private theorem exists_sub_algebraMap_mem_span_of_adjoin_eq_top
    {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    (t : Set B) (ht : Algebra.adjoin A t = ⊤) (b : B) :
    ∃ a : A, b - algebraMap A B a ∈ Ideal.span t := by
  have hb : b ∈ Algebra.adjoin A t := by rw [ht]; trivial
  induction hb using Algebra.adjoin_induction with
  | mem b hb => exact ⟨0, by simpa using Ideal.subset_span hb⟩
  | algebraMap a => exact ⟨a, by simp⟩
  | add b c _ _ hb hc =>
      obtain ⟨a, ha⟩ := hb
      obtain ⟨d, hd⟩ := hc
      refine ⟨a + d, ?_⟩
      simpa only [map_add, add_sub_add_comm] using Ideal.add_mem _ ha hd
  | mul b c _ _ hb hc =>
      obtain ⟨a, ha⟩ := hb
      obtain ⟨d, hd⟩ := hc
      refine ⟨a * d, ?_⟩
      have h := Ideal.add_mem (Ideal.span t)
        (Ideal.mul_mem_right c _ ha) (Ideal.mul_mem_left _ (algebraMap A B a) hd)
      (convert h using 1; simp only [map_mul]; ring)

/-- If the algebra generators vanish under a homomorphism, they generate its
kernel provided the kernel on the coefficient ring is already in their span. -/
private theorem ker_eq_span_of_adjoin_eq_top
    {A B R : Type*} [CommRing A] [CommRing B] [CommRing R] [Algebra A B]
    (f : A →+* R) (g : B →+* R) (hcomp : g.comp (algebraMap A B) = f)
    (t : Set B) (ht : Algebra.adjoin A t = ⊤) (hzero : ∀ b ∈ t, g b = 0)
    (hker : (RingHom.ker f).map (algebraMap A B) ≤ Ideal.span t) :
    RingHom.ker g = Ideal.span t := by
  have hle : Ideal.span t ≤ RingHom.ker g := Ideal.span_le.mpr hzero
  refine le_antisymm (fun b hb => ?_) hle
  obtain ⟨a, ha⟩ := exists_sub_algebraMap_mem_span_of_adjoin_eq_top t ht b
  have hfa : a ∈ RingHom.ker f := by
    have hga := hle ha
    change g (b - algebraMap A B a) = 0 at hga
    rw [map_sub, show g b = 0 from hb, zero_sub, neg_eq_zero] at hga
    show f a = 0
    simpa only [← hcomp, RingHom.comp_apply] using hga
  simpa only [sub_add_cancel] using
    Ideal.add_mem (Ideal.span t) ha (hker (Ideal.mem_map_of_mem (algebraMap A B) hfa))

/-- On an affine blowup chart, the divided old kernel generators generate the
kernel of the lifted arc. -/
private theorem ker_eq_span_of_divided_generators
    {A B R ι : Type*} [CommRing A] [CommRing B] [CommRing R] [Algebra A B]
    (f : A →+* R) (g : B →+* R) (hcomp : g.comp (algebraMap A B) = f)
    (x : ι → A) (y : ι → B) (a : A)
    (hp : RingHom.ker f = Ideal.span (Set.range x))
    (hy : Algebra.adjoin A (Set.range y) = ⊤)
    (hzero : ∀ i, g (y i) = 0)
    (hdiv : ∀ i, algebraMap A B (x i) = algebraMap A B a * y i) :
    RingHom.ker g = Ideal.span (Set.range y) := by
  apply ker_eq_span_of_adjoin_eq_top f g hcomp (Set.range y) hy (Set.forall_mem_range.2 hzero)
  · rw [hp, Ideal.map_span]
    apply Ideal.span_le.mpr
    rintro b ⟨c, ⟨i, rfl⟩, rfl⟩
    rw [hdiv]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

/-- A homomorphism killing the numerators of the divided generators extends to
their algebra when the parameter has nonzero image in a domain. -/
private theorem exists_hom_of_divided_generators
    {A B S R ι : Type*} [CommRing A] [CommRing B] [CommRing S] [CommRing R]
    [IsDomain R] [Algebra A B] [Algebra A S]
    (a : A) [IsLocalization.Away a S] (f : A →+* R) (ha : f a ≠ 0)
    (x : ι → A) (hx : ∀ i, f (x i) = 0)
    (y : ι → B) (hy : Algebra.adjoin A (Set.range y) = ⊤)
    (j : B →ₐ[A] S)
    (hdiv : ∀ i, y i * algebraMap A B a = algebraMap A B (x i)) :
    ∃ g : B →+* R, g.comp (algebraMap A B) = f ∧ ∀ i, g (y i) = 0 := by
  let F : MvPolynomial ι A →ₐ[A] B := MvPolynomial.aeval y
  have hF : Function.Surjective F := by
    apply (AlgHom.range_eq_top F).mp
    dsimp [F]
    rw [MvPolynomial.aeval_range, hy]
  let ε : MvPolynomial ι A →+* R := MvPolynomial.eval₂Hom f (fun _ => 0)
  have hrel : Ideal.span (Set.range fun i : ι =>
      MvPolynomial.C a * MvPolynomial.X i - MvPolynomial.C (x i)) ≤
      RingHom.ker ε := by
    apply Ideal.span_le.mpr
    rintro z ⟨i, rfl⟩
    simp [ε, hx]
  have hφ (i : ι) : (j.comp F) (MvPolynomial.X i) * algebraMap A S a =
      algebraMap A S (x i) := by
    simpa [F] using congrArg j (hdiv i)
  have hker : RingHom.ker F.toRingHom ≤ RingHom.ker ε := by
    intro z hz
    have hz' : (j.comp F) z = 0 := by
      show j (F z) = 0
      rw [show F z = 0 from hz, map_zero]
    obtain ⟨n, hn⟩ :=
      ((Ideal.range_eq_affineBlowup_and_ker_eq_saturation
        (I := Ideal.span (insert a (Set.range x))) rfl (j.comp F) hφ).2 z).mp hz'
    have hε := hrel hn
    change ε (a ^ n • z) = 0 at hε
    have heq : f a ^ n * ε z = 0 := by
      simpa only [MvPolynomial.smul_eq_C_mul, map_mul, ε, MvPolynomial.eval₂Hom_C,
        map_pow] using hε
    exact (mul_eq_zero.mp heq).resolve_left (pow_ne_zero n ha)
  let g := F.toRingHom.liftOfSurjective hF ⟨ε, hker⟩
  have hg (z : MvPolynomial ι A) : g (F z) = ε z :=
    RingHom.liftOfSurjective_comp_apply _ _ _ z
  refine ⟨g, ?_, ?_⟩
  · ext b
    simpa [F, ε] using hg (MvPolynomial.C b)
  · intro i
    simpa [F, ε] using hg (MvPolynomial.X i)

/-- The arc extends to its parameter chart, and its new kernel is generated by
the divided generators of its old kernel. -/
private theorem exists_affineBlowup_arc_hom
    {A R ι : Type*} [CommRing A] [CommRing R] [IsDomain R]
    (f : A →+* R) (a : A) (ha : f a ≠ 0) (x : ι → A)
    (hp : RingHom.ker f = Ideal.span (Set.range x))
    (I : Ideal A) (hI : I = Ideal.span (insert a (Set.range x))) :
    let B := affineBlowupAlgebra I a (Localization.Away a)
    ∃ (y : ι → B) (g : B →+* R),
      (∀ i, (y i : Localization.Away a) =
        IsLocalization.mk' (Localization.Away a) (x i) ⟨a, Submonoid.mem_powers a⟩) ∧
      Algebra.adjoin A (Set.range y) = ⊤ ∧
      g.comp (algebraMap A B) = f ∧ RingHom.ker g = Ideal.span (Set.range y) ∧
      ∀ i, algebraMap A B (x i) = algebraMap A B a * y i := by
  let B := affineBlowupAlgebra I a (Localization.Away a)
  let y : ι → B := fun i =>
    ⟨IsLocalization.mk' (Localization.Away a) (x i) ⟨a, Submonoid.mem_powers a⟩,
      Algebra.subset_adjoin ⟨x i,
        hI ▸ Ideal.subset_span (Set.mem_insert_of_mem _ ⟨i, rfl⟩), rfl⟩⟩
  have hy : Algebra.adjoin A (Set.range y) = ⊤ := by
    apply Subalgebra.map_injective (f := B.val) Subtype.val_injective
    rw [AlgHom.map_adjoin, ← Set.range_comp]
    show Algebra.adjoin A (Set.range fun i =>
      IsLocalization.mk' (Localization.Away a) (x i) ⟨a, Submonoid.mem_powers a⟩) =
        (⊤ : Subalgebra A B).map B.val
    rw [← affineBlowupAlgebra_eq_adjoin_of_span a x I hI]
    rw [Algebra.map_top, Subalgebra.range_val]
  have hdiv (i : ι) : y i * algebraMap A B a = algebraMap A B (x i) :=
    Subtype.val_injective
      (IsLocalization.mk'_spec (Localization.Away a) (x i) ⟨a, Submonoid.mem_powers a⟩)
  have hx (i : ι) : f (x i) = 0 := RingHom.mem_ker.mp (hp ▸ Ideal.subset_span ⟨i, rfl⟩)
  obtain ⟨g, hg, hzero⟩ := exists_hom_of_divided_generators a f ha x hx y hy B.val hdiv
  have hdiv' (i : ι) : algebraMap A B (x i) = algebraMap A B a * y i :=
    (hdiv i).symm.trans (mul_comm _ _)
  exact ⟨y, g, fun _ => rfl, hy, hg,
    ker_eq_span_of_divided_generators f g hg x y a hp hy hzero hdiv', hdiv'⟩

/-- A local homomorphism detects a generator of a proper principal ideal when
its image is irreducible. -/
private theorem ideal_eq_span_of_isPrincipal_of_irreducible_image
    {B R : Type*} [CommRing B] [CommRing R] [IsLocalRing B] [IsLocalRing R]
    (g : B →+* R) [IsLocalHom g] (J : Ideal B) (hJ : J.IsPrincipal)
    (hproper : J ≤ maximalIdeal B) (a : B) (ha : a ∈ J)
    (hirr : Irreducible (g a)) : J = Ideal.span {a} := by
  obtain ⟨b, hb⟩ := hJ
  have hbmem : b ∈ maximalIdeal B := hproper (hb ▸ Ideal.subset_span rfl)
  rw [hb, Ideal.mem_span_singleton] at ha
  obtain ⟨c, hc⟩ := ha
  have hfactor : g a = g b * g c := by rw [← map_mul, hc]
  have hcunit : IsUnit c := (isUnit_map_iff g c).mp ((hirr.isUnit_or_isUnit hfactor).resolve_left
    fun hbu => hbmem ((isUnit_map_iff g b).mp hbu))
  rw [hb, hc]
  exact (Ideal.span_singleton_mul_right_unit hcunit b).symm

open CategoryTheory.Limits TensorProduct Pointwise

/-- A ring map out of an algebra is surjective if its restriction along the structure map is. -/
private theorem surjective_of_comp_algebraMap_eq
    {A B R : Type*} [CommRing A] [CommRing B] [CommRing R] [Algebra A B]
    (f : A →+* R) (g : B →+* R) (hcomp : g.comp (algebraMap A B) = f)
    (hf : Function.Surjective f) : Function.Surjective g :=
  Function.Surjective.of_comp (g := algebraMap A B) (by rw [← RingHom.coe_comp, hcomp]; exact hf)

/-- A parameter whose image along a local test map is irreducible selects the
corresponding standard blowup chart. -/
private theorem mem_affineBlowup_chart_of_irreducible_image
    {X : Scheme.{u}} (I : X.IdealSheafData) (U : X.affineOpens)
    (a : I.ideal U) (x : (blowUp I))
    (hx : (blowUpToBase I) x ∈ U.1)
    {R : Type*} [CommRing R] [IsLocalRing R]
    (g : (blowUp I).presheaf.stalk x →+* R) [IsLocalHom g]
    (hproper : IdealSheafData.stalk I ((blowUpToBase I) x) ≤
      maximalIdeal _)
    (ha : Irreducible (g (((blowUpToBase I).stalkMap x)
      (X.presheaf.germ U.1 ((blowUpToBase I) x) hx a)))) :
    letI := (reesSituation I).sectionRingGradedRing U.1
    letI := (reesSituation I).sectionRingGradingGradedRing U.1
    x ∈ Set.range
      ((Proj.basicOpen ((reesSituation I).sectionRingGrading U.1)
        (reesDegreeOne I U a).1).ι ≫
        ((reesSituation I).relativeProjChart U)) := by
  let := (reesSituation I).sectionRingGradedRing U.1
  let := (reesSituation I).sectionRingGradingGradedRing U.1
  apply (mem_affineBlowupStandardOpen_iff_exceptionalIdeal_stalk_eq_span
    I U a x hx).mpr
  let J := IdealSheafData.stalk (exceptionalIdeal I) x
  have hcover : x ∈ ⋃ b : I.ideal U,
      Set.range ((Proj.basicOpen ((reesSituation I).sectionRingGrading U.1)
        (reesDegreeOne I U b).1).ι ≫
        ((reesSituation I).relativeProjChart U)) := by
    rw [blownUpAffine_chart_cover]
    exact hx
  obtain ⟨b, hb⟩ := Set.mem_iUnion.mp hcover
  have hJ : J.IsPrincipal := by
    rw [show J = _ from
      (mem_affineBlowupStandardOpen_iff_exceptionalIdeal_stalk_eq_span
        I U b x hx).mp hb]
    infer_instance
  have hmap : J = (IdealSheafData.stalk I
      ((blowUpToBase I) x)).map
        ((blowUpToBase I).stalkMap x).hom :=
    AlgebraicGeometry.IdealSheafData.stalk_comap I (blowUpToBase I) x
  have hJproper : J ≤ maximalIdeal _ := by
    rw [hmap, Ideal.map_le_iff_le_comap, IsLocalRing.maximalIdeal_comap]
    exact hproper
  apply ideal_eq_span_of_isPrincipal_of_irreducible_image g J hJ hJproper _ _ ha
  rw [hmap]
  apply Ideal.mem_map_of_mem
  rw [IdealSheafData.stalk_eq_map_germ I _ U hx]
  exact Ideal.mem_map_of_mem _ a.property

/-- At a point of the support of an ideal sheaf the stalk ideal is proper. -/
private theorem idealStalk_le_maximalIdeal_of_mem_support
    {X : Scheme.{u}} (I : X.IdealSheafData) (x : X) (hx : x ∈ I.support) :
    IdealSheafData.stalk I x ≤ maximalIdeal _ := by
  unfold IdealSheafData.stalk
  refine iSup_le fun U => iSup_le fun hxU => ?_
  apply Ideal.map_le_iff_le_comap.mpr
  intro a ha
  show ¬ IsUnit ((X.presheaf.germ U.1 x hxU) a)
  have hzero := (Scheme.IdealSheafData.mem_support_iff.mp hx) U
  exact fun hunit => (X.mem_zeroLocus_iff _ x).mp hzero a ha
    ((X.mem_basicOpen a x hxU).mpr hunit)

/-- On an affine open, the reduced ideal of a closed point in the image of a prime `q` is `q`. -/
private theorem vanishingIdeal_ideal_eq_of_fromSpec_eq
    {X : Scheme.{u}} (U : X.affineOpens) (q : Spec Γ(X, U.1)) (x : X)
    (hq : (isAffineOpen_coe U).fromSpec q = x) (hclosed : IsClosed ({x} : Set X)) :
    (Scheme.IdealSheafData.vanishingIdeal ⟨{x}, hclosed⟩).ideal U = q.asIdeal := by
  have hpre : (isAffineOpen_coe U).fromSpec ⁻¹' ({x} : Set X) = {q} := by
    ext z
    change (isAffineOpen_coe U).fromSpec z = x ↔ z = q
    rw [← hq]
    exact (isAffineOpen_coe U).fromSpec.isOpenEmbedding.injective.eq_iff
  change PrimeSpectrum.vanishingIdeal ((isAffineOpen_coe U).fromSpec ⁻¹' ({x} : Set X)) = _
  exact (congrArg PrimeSpectrum.vanishingIdeal hpre).trans
    (PrimeSpectrum.vanishingIdeal_singleton q)

/-- The ideal sheaf of a closed reduced point has maximal ideal as its stalk
at that point. -/
private theorem stalk_vanishingIdeal_singleton
    {X : Scheme.{u}} (x : X) (hclosed : IsClosed ({x} : Set X)) :
    IdealSheafData.stalk
      (Scheme.IdealSheafData.vanishingIdeal ⟨{x}, hclosed⟩) x = maximalIdeal _ := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hx, _⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  change IsAffineOpen U at hU
  let U' : X.affineOpens := ⟨U, hU⟩
  let q := hU.primeIdealOf ⟨x, hx⟩
  rw [IdealSheafData.stalk_eq_map_germ _ x U' hx,
    vanishingIdeal_ideal_eq_of_fromSpec_eq U' q x (hU.fromSpec_primeIdealOf ⟨x, hx⟩) hclosed]
  let : Algebra Γ(X, U) (X.presheaf.stalk x) := X.presheaf.algebra_section_stalk ⟨x, hx⟩
  let : IsLocalization.AtPrime (X.presheaf.stalk x) q.asIdeal :=
    hU.isLocalization_stalk ⟨x, hx⟩
  exact IsLocalization.AtPrime.map_eq_maximalIdeal q.asIdeal (X.presheaf.stalk x)

/-- A morphism from the spectrum of a local ring whose closed point lands in an affine open
immersion factors through that immersion. -/
private theorem exists_factor_of_closedPoint_mem_range
    {R B : Type u} [CommRing R] [IsLocalRing R] [CommRing B]
    {X : Scheme.{u}} (j : Spec (.of B) ⟶ X) [IsOpenImmersion j]
    (a : Spec (.of R) ⟶ X) (ha : a (closedPoint R) ∈ Set.range j) :
    ∃ f : B →+* R, Spec.map (CommRingCat.ofHom f) ≫ j = a := by
  have hpre : a ⁻¹ᵁ j.opensRange = ⊤ :=
    Scheme.preimage_eq_top_of_closedPoint_mem a ha
  have hrange : Set.range a ⊆ Set.range j := by
    rintro _ ⟨x, rfl⟩
    exact (hpre ▸ trivial : x ∈ a ⁻¹ᵁ j.opensRange)
  refine ⟨(Spec.preimage (IsOpenImmersion.lift j a hrange)).hom, ?_⟩
  rw [CommRingCat.ofHom_hom, Spec.map_preimage]
  exact IsOpenImmersion.lift_fac _ _ _
/-- The standard affine blowup chart is an open immersion over the base,
with its coordinate-ring map equal to the canonical algebra map. -/
private theorem exists_affineBlowup_chart_over
    {X : Scheme.{u}} (I : X.IdealSheafData) (U : X.affineOpens)
    (a : I.ideal U) (x : (blowUp I))
    (hx : letI := (reesSituation I).sectionRingGradedRing U.1
      letI := (reesSituation I).sectionRingGradingGradedRing U.1
      x ∈ Set.range
        ((Proj.basicOpen ((reesSituation I).sectionRingGrading U.1)
          (reesDegreeOne I U a).1).ι ≫
          ((reesSituation I).relativeProjChart U))) :
    let B := affineBlowupAlgebra (I.ideal U) (a : Γ(X, U.1))
      (Localization.Away (a : Γ(X, U.1)))
    ∃ j : Spec (.of B) ⟶ (blowUp I),
      IsOpenImmersion j ∧
      j ≫ (blowUpToBase I) =
        Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U.1) B)) ≫ (isAffineOpen_coe U).fromSpec ∧
      ∃ q : Spec (.of B), j q = x := by
  let := (reesSituation I).sectionRingGradedRing U.1
  let := (reesSituation I).sectionRingGradingGradedRing U.1
  let V := Proj.basicOpen ((reesSituation I).sectionRingGrading U.1)
    (reesDegreeOne I U a).1
  let e := affineBlowupStandardOpenIso I U a
  let j := e.hom ≫ V.ι ≫ ((reesSituation I).relativeProjChart U)
  have hchart : IsOpenImmersion (((reesSituation I).relativeProjChart U)) :=
    MorphismProperty.of_isPullback
      (((reesSituation I).relativeProjChart_isPullback U)).flip
      (show IsOpenImmersion U.1.ι from inferInstance)
  refine ⟨j, inferInstance, ?_, ?_⟩
  · dsimp [j]
    rw [Category.assoc, Category.assoc,
      (((reesSituation I).relativeProjChart_isPullback U)).w]
    simpa only [Category.assoc, IsAffineOpen.fromSpec] using
      congrArg (fun k => k ≫ U.1.ι)
        (affineBlowupStandardOpenIso_over I U a)
  · obtain ⟨z, hz⟩ := hx
    refine ⟨e.inv z, ?_⟩
    show ((V.ι ≫ ((reesSituation I).relativeProjChart U)) (e.hom (e.inv z))) = x
    simpa using hz

/-- A point in an affine chart has the local ring of its corresponding prime. -/
private theorem exists_stalk_equiv_localization_of_mem_range
    {B : Type u} [CommRing B] {X : Scheme.{u}} (j : Spec (.of B) ⟶ X)
    [IsOpenImmersion j] (x : X) (hx : x ∈ Set.range j) :
    ∃ q : PrimeSpectrum B, j q = x ∧
      (letI : q.asIdeal.IsPrime := q.isPrime;
        Nonempty (X.presheaf.stalk x ≃+* Localization.AtPrime q.asIdeal)) := by
  obtain ⟨q, rfl⟩ := hx
  refine ⟨q, rfl, ?_⟩
  let : q.asIdeal.IsPrime := q.isPrime
  exact ⟨(asIso (j.stalkMap q)).commRingCatIsoToRingEquiv.trans
    (Spec.stalkIso (.of B) q).commRingCatIsoToRingEquiv⟩

/-- The local ring at a blowup point tested by a uniformizer is a localization
of the affine blowup algebra at that parameter. -/
private theorem exists_stalk_equiv_affineBlowup_localization
    {X : Scheme.{u}} (I : X.IdealSheafData) (U : X.affineOpens)
    (a : I.ideal U) (x : (blowUp I))
    (hx : (blowUpToBase I) x ∈ U.1)
    {R : Type*} [CommRing R] [IsLocalRing R]
    (g : (blowUp I).presheaf.stalk x →+* R) [IsLocalHom g]
    (hcenter : (blowUpToBase I) x ∈ I.support)
    (ha : Irreducible (g (((blowUpToBase I).stalkMap x)
      (X.presheaf.germ U.1 ((blowUpToBase I) x) hx a)))) :
    let B := affineBlowupAlgebra (I.ideal U) (a : Γ(X, U.1))
      (Localization.Away (a : Γ(X, U.1)))
    ∃ q : PrimeSpectrum B,
      (letI : q.asIdeal.IsPrime := q.isPrime;
        Nonempty ((blowUp I).presheaf.stalk x ≃+*
          Localization.AtPrime q.asIdeal)) := by
  have hchart := mem_affineBlowup_chart_of_irreducible_image I U a x hx g
    (idealStalk_le_maximalIdeal_of_mem_support I _ hcenter) ha
  obtain ⟨j, hj, _, q, hq⟩ := exists_affineBlowup_chart_over I U a x hchart
  obtain ⟨q', _, e⟩ := exists_stalk_equiv_localization_of_mem_range j x ⟨q, hq⟩
  exact ⟨q', e⟩

/-- On an affine open, the germ followed by the closed-point stalk map of a morphism out of a
local ring recovers the defining ring homomorphism. -/
private theorem germ_stalkClosedPointTo_affine
    {R : Type u} [CommRing R] [IsLocalRing R]
    {X : Scheme.{u}} (U : X.affineOpens) (f : Γ(X, U.1) →+* R)
    (hx : (Spec.map (CommRingCat.ofHom f) ≫ (isAffineOpen_coe U).fromSpec) (closedPoint R) ∈ U.1) :
    X.presheaf.germ U.1 _ hx ≫
      Scheme.stalkClosedPointTo (Spec.map (CommRingCat.ofHom f) ≫ (isAffineOpen_coe U).fromSpec) =
      CommRingCat.ofHom f := by
  rw [Scheme.stalkClosedPointTo_comp]
  let z : ↥(Spec Γ(X, U.1)) := Spec.map (CommRingCat.ofHom f) (closedPoint R)
  have hz : (isAffineOpen_coe U).fromSpec z ∈ U.1 := hx
  show X.presheaf.germ U.1 ((isAffineOpen_coe U).fromSpec z) hz ≫
      (isAffineOpen_coe U).fromSpec.stalkMap z ≫
      Scheme.stalkClosedPointTo (Spec.map (CommRingCat.ofHom f)) = _
  rw [(isAffineOpen_coe U).fromSpec.germ_stalkMap_assoc U.1 z hz,
    (isAffineOpen_coe U).fromSpec_app_self]
  have hres := TopCat.Presheaf.germ_res (Spec Γ(X, U.1)).presheaf
    (eqToHom (isAffineOpen_coe U).fromSpec_preimage_self) z hz
  have he := Scheme.germ_stalkClosedPointTo_Spec (CommRingCat.ofHom f)
  exact ((Category.assoc _ _ _).trans
    (congrArg (fun w => (Scheme.ΓSpecIso Γ(X, U.1)).inv ≫ w)
      (((Category.assoc _ _ _).symm.trans
        (congrArg (fun w => w ≫ Scheme.stalkClosedPointTo (Spec.map (CommRingCat.ofHom f)))
          hres)).trans he))).trans
    ((Scheme.ΓSpecIso Γ(X, U.1)).inv_hom_id_assoc _)

/-- Every point in the image of `fromSpec` of an affine open lies in that open. -/
private theorem fromSpec_mem {X : Scheme.{u}} (U : X.affineOpens) (q : Spec Γ(X, U.1)) :
    (isAffineOpen_coe U).fromSpec q ∈ U.1 := by
  rw [← SetLike.mem_coe, ← (isAffineOpen_coe U).range_fromSpec]
  exact Set.mem_range_self q

/-- Relations modulo the square of the arc kernel give a regular closed center
when they express every generator in terms of one generator. -/
theorem regular_stalk_of_generators_mod_square
    {R ι : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    [Fintype ι] {X : Scheme.{u}} (U : X.affineOpens)
    [IsDomain Γ(X, U.1)] [IsNoetherianRing Γ(X, U.1)]
    (f : Γ(X, U.1) →+* R) (hf : Function.Surjective f)
    (x : ι → Γ(X, U.1)) (k : ι)
    (hp : RingHom.ker f = Ideal.span (Set.range x))
    (hrel : ∀ i, ∃ c, x i - c * x k ∈ (RingHom.ker f) ^ 2) :
    IsRegularLocalRing (X.presheaf.stalk
      ((Spec.map (CommRingCat.ofHom f) ≫ (isAffineOpen_coe U).fromSpec) (closedPoint R))) := by
  let a := Spec.map (CommRingCat.ofHom f) ≫ (isAffineOpen_coe U).fromSpec
  let z := a (closedPoint R)
  have hz : z ∈ U.1 := fromSpec_mem U _
  let q := (isAffineOpen_coe U).primeIdealOf ⟨z, hz⟩
  let S := X.presheaf.stalk z
  let : Algebra Γ(X, U.1) S := X.presheaf.algebra_section_stalk ⟨z, hz⟩
  let : IsLocalization.AtPrime S q.asIdeal := (isAffineOpen_coe U).isLocalization_stalk ⟨z, hz⟩
  have : IsDomain S := IsLocalization.isDomain_of_le_nonZeroDivisors S
    q.asIdeal.primeCompl_le_nonZeroDivisors
  have : IsNoetherianRing S := IsLocalization.isNoetherianRing q.asIdeal.primeCompl S
    (inferInstance : IsNoetherianRing Γ(X, U.1))
  let g : S →+* R := (Scheme.stalkClosedPointTo a).hom
  have hg : g.comp (algebraMap Γ(X, U.1) S) = f :=
    congrArg CommRingCat.Hom.hom (germ_stalkClosedPointTo_affine U f hz)
  have hgs : Function.Surjective g := surjective_of_comp_algebraMap_eq f g hg hf
  have hgker : RingHom.ker g = (RingHom.ker f).map (algebraMap Γ(X, U.1) S) :=
    ker_eq_map_of_isLocalization q.asIdeal.primeCompl f g hg
  let y : ι → S := fun i => algebraMap Γ(X, U.1) S (x i)
  have hy : RingHom.ker g = Ideal.span (Set.range y) := by
    rw [hgker, hp, Ideal.map_span, ← Set.range_comp]
    rfl
  have : (RingHom.ker g).IsPrime := RingHom.ker_isPrime g
  have hpm : RingHom.ker g ≤ maximalIdeal S :=
    IsLocalRing.le_maximalIdeal_of_isPrime _
  have hprincipal : (RingHom.ker g).IsPrincipal := by
    have he := ideal_eq_span_singleton_of_generators_mod_square
      (RingHom.ker g) y k hy (IsNoetherian.noetherian _) hpm
      (hy ▸ Ideal.subset_span ⟨k, rfl⟩) ?_
    · rw [he]
      infer_instance
    · intro i
      obtain ⟨c, hc⟩ := hrel i
      refine ⟨algebraMap Γ(X, U.1) S c, ?_⟩
      have hm := Ideal.mem_map_of_mem (algebraMap Γ(X, U.1) S) hc
      rw [Ideal.map_pow, ← hgker] at hm
      simpa only [map_sub, map_mul] using hm
  exact regular_of_surjective_dvr_of_principal_kernel g hgs hprincipal

/-- On an affine neighbourhood containing the center, its reduced ideal is the
inverse image of the maximal ideal of the arc ring. -/
private theorem vanishingIdeal_arc_center_on_affine
    {R : Type u} [CommRing R] [IsLocalRing R] {X : Scheme.{u}}
    (U : X.affineOpens) (f : Γ(X, U.1) →+* R)
    (α : Spec (.of R) ⟶ X)
    (hα : Spec.map (CommRingCat.ofHom f) ≫ (isAffineOpen_coe U).fromSpec = α)
    (hclosed : IsClosed ({α (closedPoint R)} : Set X)) :
    (Scheme.IdealSheafData.vanishingIdeal ⟨{α (closedPoint R)}, hclosed⟩).ideal U =
      (maximalIdeal R).comap f := by
  exact vanishingIdeal_ideal_eq_of_fromSpec_eq U (Spec.map (CommRingCat.ofHom f) (closedPoint R))
    _ (congrArg (fun h : Spec (.of R) ⟶ X => h (closedPoint R)) hα) hclosed

/-- The lifted arc factors through the standard chart at its uniformizer, and
its kernel is generated by the divided kernel generators. -/
theorem exists_affineBlowup_chart_arc
    {R ι : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {X : Scheme.{u}} (U : X.affineOpens)
    (f : Γ(X, U.1) →+* R) (hf : Function.Surjective f)
    (α : Spec (.of R) ⟶ X)
    (hα : Spec.map (CommRingCat.ofHom f) ≫ (isAffineOpen_coe U).fromSpec = α)
    (hclosed : IsClosed ({α (closedPoint R)} : Set X))
    (a : Γ(X, U.1)) (x : ι → Γ(X, U.1))
    (hp : RingHom.ker f = Ideal.span (Set.range x))
    (hπ : maximalIdeal R = Ideal.span {f a})
    (β : Spec (.of R) ⟶ (blowUp
      (Scheme.IdealSheafData.vanishingIdeal ⟨{α (closedPoint R)}, hclosed⟩)))
    (hβ : β ≫ (blowUpToBase
      (Scheme.IdealSheafData.vanishingIdeal ⟨{α (closedPoint R)}, hclosed⟩)) = α) :
    let I := Scheme.IdealSheafData.vanishingIdeal ⟨{α (closedPoint R)}, hclosed⟩
    let B := affineBlowupAlgebra (I.ideal U) a (Localization.Away a)
    ∃ (j : Spec (.of B) ⟶ (blowUp I)) (g : B →+* R) (y : ι → B),
      IsOpenImmersion j ∧ Spec.map (CommRingCat.ofHom g) ≫ j = β ∧
      Function.Surjective g ∧
      g.comp (algebraMap Γ(X, U.1) B) = f ∧
      RingHom.ker g = Ideal.span (Set.range y) ∧
      Algebra.adjoin Γ(X, U.1) (Set.range y) = ⊤ ∧
      ∀ i, algebraMap Γ(X, U.1) B (x i) = algebraMap Γ(X, U.1) B a * y i := by
  let I := Scheme.IdealSheafData.vanishingIdeal ⟨{α (closedPoint R)}, hclosed⟩
  let π : (blowUp I) ⟶ X := (blowUpToBase I)
  let z := β (closedPoint R)
  have hz : π z = α (closedPoint R) :=
    congrArg (fun h : Spec (.of R) ⟶ X => h (closedPoint R)) hβ
  have hx : π z ∈ U.1 := by
    rw [hz, ← hα]
    exact fromSpec_mem U _
  have hI : I.ideal U = Ideal.span (insert a (Set.range x)) := by
    rw [vanishingIdeal_arc_center_on_affine U f α hα hclosed]
    exact comap_maximalIdeal_eq_span f hf a x hp hπ
  have haI : a ∈ I.ideal U := hI ▸ Ideal.subset_span (Set.mem_insert a _)
  have hproper : IdealSheafData.stalk I (π z) ≤ maximalIdeal _ := by
    rw [hz, stalk_vanishingIdeal_singleton]
  have hπ0 : f a ≠ 0 := fun h => IsDiscreteValuationRing.not_a_field R (by simpa [h] using hπ)
  have hirr : Irreducible (f a) :=
    IsDiscreteValuationRing.irreducible_of_span_eq_maximalIdeal (f a) hπ0 hπ
  have hvalue : (Scheme.stalkClosedPointTo β)
      ((π.stalkMap z) (X.presheaf.germ U.1 (π z) hx a)) = f a := by
    have he : X.presheaf.germ U.1 (π z) hx ≫ π.stalkMap z ≫
        Scheme.stalkClosedPointTo β = CommRingCat.ofHom f := by
      rw [← Scheme.stalkClosedPointTo_comp β π]
      have aux (γ : Spec (.of R) ⟶ X)
          (hγ : γ = Spec.map (CommRingCat.ofHom f) ≫ (isAffineOpen_coe U).fromSpec)
          (hh : γ (closedPoint R) ∈ U.1) :
          X.presheaf.germ U.1 (γ (closedPoint R)) hh ≫
            Scheme.stalkClosedPointTo γ = CommRingCat.ofHom f := by
        subst γ
        exact germ_stalkClosedPointTo_affine U f hh
      exact aux (β ≫ π) (hβ.trans hα.symm) hx
    exact congrArg (fun h : Γ(X, U.1) ⟶ CommRingCat.of R => h a) he
  have hchart := mem_affineBlowup_chart_of_irreducible_image I U ⟨a, haI⟩ z hx
    (Scheme.stalkClosedPointTo β).hom hproper (hvalue ▸ hirr)
  obtain ⟨j, hj, hover, q, hq⟩ := exists_affineBlowup_chart_over I U ⟨a, haI⟩ z hchart
  have : IsOpenImmersion j := hj
  obtain ⟨g, hg⟩ := exists_factor_of_closedPoint_mem_range j β ⟨q, hq⟩
  have hcomp : g.comp (algebraMap Γ(X, U.1) _) = f := by
    suffices he : CommRingCat.ofHom (g.comp (algebraMap Γ(X, U.1) _)) =
        CommRingCat.ofHom f by exact congrArg CommRingCat.Hom.hom he
    apply Spec.map_injective
    apply (cancel_mono (isAffineOpen_coe U).fromSpec).mp
    show Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U.1) _) ≫
      CommRingCat.ofHom g) ≫ (isAffineOpen_coe U).fromSpec = _
    rw [Spec.map_comp]
    show Spec.map (CommRingCat.ofHom g) ≫ Spec.map
      (CommRingCat.ofHom (algebraMap Γ(X, U.1) _)) ≫ (isAffineOpen_coe U).fromSpec = _
    rw [← hover, ← Category.assoc, hg, hβ, hα]
  obtain ⟨y, g₀, _, hy, hg₀, _, hdiv⟩ := exists_affineBlowup_arc_hom
    f a hπ0 x hp (I.ideal U) hI
  have hzero (i : ι) : g (y i) = 0 := by
    have h := congrArg g (hdiv i)
    have hf' (b : Γ(X, U.1)) : g (algebraMap Γ(X, U.1) _ b) = f b :=
      congrArg (fun h : Γ(X, U.1) →+* R => h b) hcomp
    have hxi : f (x i) = 0 := RingHom.mem_ker.mp (hp ▸ Ideal.subset_span ⟨i, rfl⟩)
    rw [map_mul, hf', hf', hxi] at h
    exact (mul_eq_zero.mp h.symm).resolve_left hπ0
  have hgs : Function.Surjective g := surjective_of_comp_algebraMap_eq f g hcomp hf
  exact ⟨j, g, y, hj, hg, hgs, hcomp,
    ker_eq_span_of_divided_generators f g hcomp x y a hp hy hzero hdiv, hy, hdiv⟩

end AlgebraicGeometry

