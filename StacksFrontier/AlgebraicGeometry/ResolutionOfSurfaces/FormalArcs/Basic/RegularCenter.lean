/-!
# Formal arcs: a regular centre

Elimination of redundant kernel generators, the lifted arcs at each stage of the blowup
sequence, the decrease of chart relations under blowup, and the main result that some stage
of the sequence has a regular centre.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace IsLocalRing

namespace AlgebraicGeometry

universe u

/-- A two-dimensional Noetherian local ring whose maximal ideal is generated by two
elements is regular. -/
private theorem regular_of_maximalIdeal_eq_span_pair {A : Type u} [CommRing A]
    [IsLocalRing A] [IsNoetherianRing A] (hA : ringKrullDim A = 2)
    (x y : A) (hmax : maximalIdeal A = Ideal.span ({x, y} : Set A)) :
    IsRegularLocalRing A := by
  rw [isRegularLocalRing_iff]
  apply le_antisymm
  · rw [hmax, hA]
    have hcard : ({x, y} : Set A).ncard ≤ 2 := by
      calc
        ({x, y} : Set A).ncard = (insert x ({y} : Set A)).ncard := rfl
        _ ≤ ({y} : Set A).ncard + 1 := Set.ncard_insert_le _ _
        _ = 2 := by simp
    have hfin : (Ideal.span ({x, y} : Set A)).spanFinrank ≤ 2 := by
      show (Submodule.span A ({x, y} : Set A)).spanFinrank ≤ 2
      exact (Submodule.spanFinrank_span_le_ncard_of_finite
        (by simp : ({x, y} : Set A).Finite)).trans hcard
    exact_mod_cast hfin
  · exact ringKrullDim_le_spanFinrank_maximalIdeal A

/-- If the generic kernel is principal and the quotient's maximal ideal is generated
by the image of `x₁`, then `x₁` and a generator of the kernel generate the closed
maximal ideal. -/
private theorem regular_of_kernel_span_singleton
    {A R : Type u} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    [CommRing R] [IsLocalRing R]
    (hA : ringKrullDim A = 2) (f : A →+* R) (hf : Function.Surjective f)
    (p : Ideal A) (hp : RingHom.ker f = p)
    (x₁ x₂ : A) (hx₁ : x₁ ∈ maximalIdeal A) (hx₂ : x₂ ∈ maximalIdeal A)
    (hpgen : p = Ideal.span {x₂})
    (hπ : maximalIdeal R = Ideal.span {f x₁}) : IsRegularLocalRing A := by
  let : IsLocalHom f := IsLocalHom.of_surjective f hf
  have hmax : maximalIdeal A = Ideal.span ({x₁, x₂} : Set A) := by
    apply le_antisymm
    · intro a ha
      have hfa : f a ∈ maximalIdeal R := map_nonunit f a ha
      rw [hπ, Ideal.mem_span_singleton] at hfa
      obtain ⟨b, hb⟩ := hfa
      obtain ⟨b₀, rfl⟩ := hf b
      have hker : a - b₀ * x₁ ∈ p := by
        rw [← hp, RingHom.mem_ker, map_sub, map_mul, hb]
        simp [mul_comm]
      have hker' : a - b₀ * x₁ ∈ Ideal.span ({x₁, x₂} : Set A) :=
        Ideal.span_mono (Set.subset_insert _ _) (hpgen ▸ hker)
      have hbx : b₀ * x₁ ∈ Ideal.span ({x₁, x₂} : Set A) :=
        Ideal.mul_mem_left _ b₀ (Ideal.subset_span (Set.mem_insert x₁ {x₂}))
      simpa using Ideal.add_mem _ hker' hbx
    · apply Ideal.span_le.2
      rintro z (rfl | rfl) <;> assumption
  exact regular_of_maximalIdeal_eq_span_pair hA x₁ x₂ hmax

/-- Lift a generator of the quotient DVR's maximal ideal to the source local ring. -/
private theorem exists_uniformizer_lift
    {A R : Type u} [CommRing A] [IsLocalRing A]
    [CommRing R] [IsLocalRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (f : A →+* R) (hf : Function.Surjective f) :
    ∃ x₁ : A, x₁ ∈ maximalIdeal A ∧ maximalIdeal R = Ideal.span {f x₁} := by
  let : IsLocalHom f := IsLocalHom.of_surjective f hf
  obtain ⟨π, hπ⟩ := IsPrincipalIdealRing.principal (maximalIdeal R)
  obtain ⟨x₁, hx₁⟩ := hf π
  refine ⟨x₁, ?_, ?_⟩
  · rw [← IsLocalRing.maximalIdeal_comap f]
    show f x₁ ∈ maximalIdeal R
    rw [hx₁, hπ]
    exact Ideal.subset_span (Set.mem_singleton π)
  · simpa [hx₁] using hπ

/-- A linear relation which has a unit coefficient on one generator removes that
generator from a generating family. -/
private theorem span_range_eq_span_range_erase_of_unit_relation
    {S ι : Type u} [CommRing S] [IsLocalRing S]
    (y : ι → S) (i : ι) (c : S)
    (hrel : (1 - c) * y i ∈ Ideal.span (y '' {j | j ≠ i}))
    (hc : c ∈ maximalIdeal S) :
    Ideal.span (Set.range y) = Ideal.span (y '' {j | j ≠ i}) := by
  have hy : y i ∈ Ideal.span (y '' {j | j ≠ i}) :=
    (Ideal.unit_mul_mem_iff_mem _ (IsLocalRing.isUnit_one_sub_self_of_mem_nonunits c hc)).mp hrel
  refine le_antisymm (Ideal.span_le.2 ?_) (Ideal.span_mono (Set.image_subset_range _ _))
  rintro z ⟨j, rfl⟩
  by_cases hji : j = i
  · exact hji ▸ hy
  · exact Ideal.subset_span ⟨j, hji, rfl⟩

/-- A quadratic relation among elements of the maximal ideal removes its distinguished
generator from the ideal they generate. Terms containing that generator have a coefficient
in the maximal ideal; all other terms already lie in the ideal of the remaining generators. -/
private theorem span_range_eq_span_range_erase_of_quadratic_relation_with_remainder
    {S ι : Type u} [CommRing S] [IsLocalRing S] [DecidableEq ι]
    (y : ι → S) (i : ι) (t : Finset (ι × ι)) (a : ι × ι → S)
    (hy : ∀ j, y j ∈ maximalIdeal S)
    (extra : S) (hextra : extra ∈ Ideal.span (y '' {j | j ≠ i}))
    (hrel : y i = extra + ∑ q ∈ t, a q * y q.1 * y q.2) :
    Ideal.span (Set.range y) = Ideal.span (y '' {j | j ≠ i}) := by
  let c : S := ∑ q ∈ t,
    (if q.1 = i then a q * y q.2 else if q.2 = i then a q * y q.1 else 0)
  let z : S := ∑ q ∈ t,
    (if q.1 ≠ i ∧ q.2 ≠ i then a q * y q.1 * y q.2 else 0)
  have hsum : (∑ q ∈ t, a q * y q.1 * y q.2) = c * y i + z := by
    rw [Finset.sum_mul, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun q _ => ?_
    by_cases h₁ : q.1 = i
    · simp [h₁]
      ring
    · by_cases h₂ : q.2 = i <;> simp [h₁, h₂]
  have hc : c ∈ maximalIdeal S := Ideal.sum_mem _ fun q _ => by
    split_ifs
    · exact Ideal.mul_mem_left _ _ (hy _)
    · exact Ideal.mul_mem_left _ _ (hy _)
    · exact zero_mem _
  have hz : z ∈ Ideal.span (y '' {j | j ≠ i}) := Ideal.sum_mem _ fun q _ => by
    split_ifs with h
    · exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨q.1, h.1, rfl⟩))
    · exact zero_mem _
  refine span_range_eq_span_range_erase_of_unit_relation y i c ?_ hc
  rw [show (1 - c) * y i = extra + z by linear_combination hrel + hsum]
  exact add_mem hextra hz

/-- The special case with no linear remainder in the quadratic relation. -/
private theorem span_range_eq_span_range_erase_of_quadratic_relation
    {S ι : Type u} [CommRing S] [IsLocalRing S] [DecidableEq ι]
    (y : ι → S) (i : ι) (t : Finset (ι × ι)) (a : ι × ι → S)
    (hy : ∀ j, y j ∈ maximalIdeal S)
    (hrel : y i = ∑ q ∈ t, a q * y q.1 * y q.2) :
    Ideal.span (Set.range y) = Ideal.span (y '' {j | j ≠ i}) := by
  apply span_range_eq_span_range_erase_of_quadratic_relation_with_remainder
    y i t a hy 0
  · exact Ideal.zero_mem _
  · simpa using hrel

/-- The terminal chart relation may retain linear terms in the other generators.
Those terms are absorbed into the remaining ideal, after which the quadratic part
has a coefficient in the maximal ideal on the distinguished generator. -/
private theorem span_range_eq_span_range_erase_of_terminal_chart_relation
    {S ι : Type u} [CommRing S] [IsLocalRing S] [DecidableEq ι]
    (y : ι → S) (i : ι) (s : Finset ι) (d : ι → S)
    (t : Finset (ι × ι)) (a : ι × ι → S)
    (hi : ∀ j ∈ s, j ≠ i)
    (hy : ∀ j, y j ∈ maximalIdeal S)
    (hrel : y i - ∑ j ∈ s, d j * y j = ∑ q ∈ t, a q * y q.1 * y q.2) :
    Ideal.span (Set.range y) = Ideal.span (y '' {j | j ≠ i}) := by
  have hextra : (∑ j ∈ s, d j * y j) ∈ Ideal.span (y '' {j | j ≠ i}) :=
    Ideal.sum_mem _ fun j hj => Ideal.mul_mem_left _ (d j) (Ideal.subset_span ⟨j, hi j hj, rfl⟩)
  exact span_range_eq_span_range_erase_of_quadratic_relation_with_remainder
    y i t a hy _ hextra (by linear_combination hrel)

/-- A relation eliminates its distinguished generator as soon as the coefficient of that
generator lies in the maximal ideal. Coefficients of the other generators are unrestricted. -/
private theorem span_range_eq_span_range_erase_of_self_coefficient_mem_maximalIdeal
    {S ι : Type u} [CommRing S] [IsLocalRing S] [Fintype ι] [DecidableEq ι]
    (y : ι → S) (i : ι) (c : ι → S)
    (hci : c i ∈ maximalIdeal S)
    (hrel : y i = ∑ j ∈ (Finset.univ : Finset ι), c j * y j) :
    Ideal.span (Set.range y) = Ideal.span (y '' {j | j ≠ i}) := by
  have hz : (∑ j ∈ Finset.univ.erase i, c j * y j) ∈ Ideal.span (y '' {j | j ≠ i}) :=
    Ideal.sum_mem _ fun j hj =>
      Ideal.mul_mem_left _ (c j) (Ideal.subset_span ⟨j, (Finset.mem_erase.mp hj).1, rfl⟩)
  have hsum : c i * y i + ∑ j ∈ Finset.univ.erase i, c j * y j = ∑ j, c j * y j :=
    Finset.add_sum_erase _ (fun j => c j * y j) (Finset.mem_univ i)
  refine span_range_eq_span_range_erase_of_unit_relation y i (c i) ?_ hci
  rw [show (1 - c i) * y i = ∑ j ∈ Finset.univ.erase i, c j * y j by
    linear_combination hrel - hsum]
  exact hz

/-- A relation modulo the square of the generated kernel eliminates a generator
once its linear coefficient is in the maximal ideal. -/
private theorem span_range_eq_span_range_erase_of_kernel_square_relation
    {S ι : Type u} [CommRing S] [IsLocalRing S] [Fintype ι] [DecidableEq ι]
    (p : Ideal S) (y : ι → S) (i k : ι) (d : S)
    (hp : p = Ideal.span (Set.range y))
    (hpm : p ≤ maximalIdeal S) (hki : k ≠ i)
    (hrel : y i - d * y k ∈ p ^ 2) :
    Ideal.span (Set.range y) = Ideal.span (y '' {j | j ≠ i}) := by
  have heq : p • Submodule.span S (Set.range y) = p ^ 2 := by
    rw [pow_two, ← Ideal.smul_eq_mul, hp]
  obtain ⟨a, ha, hsum⟩ :=
    (Submodule.mem_ideal_smul_span_iff_exists_sum p y (y i - d * y k)).mp (heq ▸ hrel)
  have hsum' : (∑ j : ι, a j * y j) = y i - d * y k := by
    simpa [Finsupp.sum_fintype] using hsum
  let c : ι → S := fun j => a j + if j = k then d else 0
  have hci : c i ∈ maximalIdeal S := by simpa [c, Ne.symm hki] using hpm (ha i)
  exact span_range_eq_span_range_erase_of_self_coefficient_mem_maximalIdeal
    y i c hci (by simp [c, add_mul, Finset.sum_add_distrib, hsum'])

/-- In a local ring, a quadratic relation among generators removes one of them as soon as
one of the exponents on the two distinguished terms is zero. -/
private theorem kernel_generators_erase_of_zero_power_relation
    {S ι : Type u} [CommRing S] [IsLocalRing S] [Fintype ι] [DecidableEq ι]
    (p : Ideal S) (y : ι → S) (i k : ι) (x₁ u : S) (n m : ℕ)
    (hp : p = Ideal.span (Set.range y)) (hpm : p ≤ maximalIdeal S) (hki : k ≠ i)
    (hu : IsUnit u)
    (hrel : x₁ ^ n * y i - u * x₁ ^ m * y k ∈ p ^ 2)
    (hzero : n = 0 ∨ m = 0) :
    ∃ j : ι, Ideal.span (Set.range y) = Ideal.span (y '' {l | l ≠ j}) := by
  rcases hzero with hn | hm
  · subst n
    exact ⟨i, span_range_eq_span_range_erase_of_kernel_square_relation
      p y i k (u * x₁ ^ m) hp hpm hki (by simpa using hrel)⟩
  · subst m
    refine ⟨k, span_range_eq_span_range_erase_of_kernel_square_relation
      p y k i (↑hu.unit⁻¹ * x₁ ^ n) hp hpm (Ne.symm hki) ?_⟩
    convert neg_mem (Ideal.mul_mem_left (p ^ 2) (↑hu.unit⁻¹ : S) hrel) using 1
    linear_combination (-y k) * hu.val_inv_mul

open CategoryTheory.Limits TensorProduct Pointwise

/-- An affine open immersion identifies its source ring with the sections over the image
affine open. -/
private theorem exists_affineOpen_ringEquiv
    {B : Type u} [CommRing B] {X : Scheme.{u}}
    (j : Spec (.of B) ⟶ X) [IsOpenImmersion j] :
    ∃ (U : X.affineOpens) (e : B ≃+* Γ(X, U.1)),
      Spec.map (CommRingCat.ofHom e.toRingHom) ≫ j = (isAffineOpen_coe U).fromSpec := by
  let U : X.affineOpens := ⟨j.opensRange, isAffineOpen_opensRange j⟩
  let h := IsOpenImmersion.isoOfRangeEq (isAffineOpen_coe U).fromSpec j
    (by rw [(isAffineOpen_coe U).range_fromSpec]; rfl)
  let E : CommRingCat.of B ≅ Γ(X, U.1) :=
    { hom := Spec.preimage h.hom
      inv := Spec.preimage h.inv
      hom_inv_id := by rw [← Spec.preimage_comp, h.inv_hom_id, Spec.preimage_id]
      inv_hom_id := by rw [← Spec.preimage_comp, h.hom_inv_id, Spec.preimage_id] }
  refine ⟨U, E.commRingCatIsoToRingEquiv, ?_⟩
  show Spec.map (Spec.preimage h.hom) ≫ j = (isAffineOpen_coe U).fromSpec
  rw [Spec.map_preimage]
  exact IsOpenImmersion.isoOfRangeEq_hom_fac _ _ _

/-- The composite morphism from the `i`-th blowup down to the affine base. -/
private noncomputable def ArcBlowupSequence.toBase {A R : Type u} [CommRing A] [CommRing R]
    [IsLocalRing R] {f : A →+* R} (s : ArcBlowupSequence A R f) :
    ∀ i, s.scheme i ⟶ Spec (.of A)
  | 0 => s.base.hom
  | i + 1 => s.step i ≫ s.toBase i

/-- Each lifted arc, followed by the morphism to the base, is the original arc. -/
private theorem ArcBlowupSequence.arc_comp_toBase
    {A R : Type u} [CommRing A] [CommRing R] [IsLocalRing R]
    (f : A →+* R) (s : ArcBlowupSequence A R f) (i : ℕ) :
    s.arc i ≫ s.toBase i = Spec.map (CommRingCat.ofHom f) := by
  induction i with
  | zero => exact s.base_arc
  | succ i ih =>
      show s.arc (i + 1) ≫ (s.step i ≫ s.toBase i) = _
      rw [← Category.assoc, s.step_arc i, ih]

/-- The map from the base ring into the local ring of the `i`-th blowup at the arc centre. -/
private noncomputable def ArcBlowupSequence.fromBaseToArcStalk
    {A R : Type u} [CommRing A] [CommRing R] [IsLocalRing R]
    {f : A →+* R} (s : ArcBlowupSequence A R f) (i : ℕ) :
    CommRingCat.of A ⟶
      CommRingCat.of ((s.scheme i).presheaf.stalk (s.arc i (closedPoint R))) :=
  let x : Spec (.of R) := closedPoint R
  (Scheme.ΓSpecIso (.of A)).inv ≫
    (Spec (.of A)).presheaf.germ ⊤ _ (by simp) ≫
      (s.toBase i).stalkMap (s.arc i x)

/-- Composing the map into the arc stalk with the closed-point stalk map of the arc recovers
the original ring homomorphism. -/
private theorem ArcBlowupSequence.fromBaseToArcStalk_comp
    {A R : Type u} [CommRing A] [CommRing R] [IsLocalRing R]
    (f : A →+* R) (s : ArcBlowupSequence A R f) (i : ℕ) :
    s.fromBaseToArcStalk i ≫ Scheme.stalkClosedPointTo (s.arc i) =
      CommRingCat.ofHom f := by
  unfold fromBaseToArcStalk
  let x : Spec (.of R) := closedPoint R
  show ((Scheme.ΓSpecIso (.of A)).inv ≫
      (Spec (.of A)).presheaf.germ ⊤ ((s.arc i ≫ s.toBase i) x)
        (Opens.mem_top _)) ≫
    ((s.toBase i).stalkMap ((s.arc i) x) ≫ Scheme.stalkClosedPointTo (s.arc i)) = _
  have hcomp : Scheme.stalkClosedPointTo (s.arc i ≫ s.toBase i) =
      (s.toBase i).stalkMap ((s.arc i) x) ≫ Scheme.stalkClosedPointTo (s.arc i) := by
    simpa only [Scheme.Hom.comp_apply, x] using
      (Scheme.stalkClosedPointTo_comp (f := s.arc i) (g := s.toBase i))
  refine (congrArg (fun w => ((Scheme.ΓSpecIso (.of A)).inv ≫
      (Spec (.of A)).presheaf.germ ⊤ ((s.arc i ≫ s.toBase i) x)
        (Opens.mem_top _)) ≫ w) hcomp.symm).trans ?_
  rw [ArcBlowupSequence.arc_comp_toBase f s i]
  show (Scheme.ΓSpecIso (.of A)).inv ≫
    ((Spec (.of A)).presheaf.germ ⊤ _ (Opens.mem_top _) ≫
      Scheme.stalkClosedPointTo (Spec.map (CommRingCat.ofHom f))) = _
  rw [Scheme.germ_stalkClosedPointTo_Spec]
  simp

/-- When the arc is surjective on rings, so is the closed-point stalk map at each stage. -/
private theorem ArcBlowupSequence.arcStalkMap_surjective
    {A R : Type u} [CommRing A] [IsDomain A] [IsLocalRing A]
    [CommRing R] [IsLocalRing R]
    (f : A →+* R) (hf : Function.Surjective f)
    (s : ArcBlowupSequence A R f) (i : ℕ) :
    Function.Surjective (Scheme.stalkClosedPointTo (R := CommRingCat.of R) (s.arc i)).hom := by
  intro r
  obtain ⟨a, rfl⟩ := hf r
  exact ⟨s.fromBaseToArcStalk i a, congrArg (fun g : CommRingCat.of A ⟶ CommRingCat.of R => g a)
    (s.fromBaseToArcStalk_comp f i)⟩

/-- The kernel of the closed-point stalk map of a lifted arc is prime, since its target is a
domain. -/
private theorem ArcBlowupSequence.arcStalkMap_kernel_isPrime
    {A R : Type u} [CommRing A] [IsDomain A] [IsLocalRing A]
    [CommRing R] [IsDomain R] [IsLocalRing R]
    {f : A →+* R} (s : ArcBlowupSequence A R f) (i : ℕ) :
    (RingHom.ker (Scheme.stalkClosedPointTo
      (R := CommRingCat.of R) (s.arc i)).hom).IsPrime :=
  RingHom.ker_isPrime _

/-- Contracting the kernel at any closed arc stalk to the original ring recovers the
kernel of the original parametrization. -/
private theorem ArcBlowupSequence.arcStalkMap_kernel_comap
    {A R : Type u} [CommRing A] [IsDomain A] [IsLocalRing A]
    [CommRing R] [IsLocalRing R]
    (f : A →+* R) (s : ArcBlowupSequence A R f) (i : ℕ) :
    (RingHom.ker (Scheme.stalkClosedPointTo
      (R := CommRingCat.of R) (s.arc i)).hom).comap
        (s.fromBaseToArcStalk i).hom = RingHom.ker f := by
  ext a
  show ((s.fromBaseToArcStalk i ≫
    Scheme.stalkClosedPointTo (R := CommRingCat.of R) (s.arc i)).hom a = 0) ↔ f a = 0
  rw [s.fromBaseToArcStalk_comp f i]
  rfl

/-- The image of the maximal ideal of a closed arc stalk in the DVR is the DVR's
maximal ideal. This identifies the transformed exceptional ideal along the arc. -/
private theorem ArcBlowupSequence.arcStalkMap_maximalIdeal_map
    {A R : Type u} [CommRing A] [IsDomain A] [IsLocalRing A]
    [CommRing R] [IsDomain R] [IsLocalRing R]
    (f : A →+* R) (hf : Function.Surjective f)
    (s : ArcBlowupSequence A R f) (i : ℕ) :
    (maximalIdeal ((s.scheme i).presheaf.stalk (s.arc i (closedPoint R)))).map
      (Scheme.stalkClosedPointTo (R := CommRingCat.of R) (s.arc i)).hom =
        maximalIdeal R :=
  IsLocalRing.map_maximalIdeal_of_surjective _ (s.arcStalkMap_surjective f hf i)

/-- At every stage, a uniformizer of the target has a lift in the maximal ideal of
the closed arc stalk. -/
private theorem ArcBlowupSequence.exists_uniformizer_lift_at_arcStalk
    {A R : Type u} [CommRing A] [IsDomain A] [IsLocalRing A]
    [CommRing R] [IsLocalRing R] [IsDomain R] [IsDiscreteValuationRing R]
    {f : A →+* R} (hf : Function.Surjective f)
    (s : ArcBlowupSequence A R f) (i : ℕ) :
    ∃ x : (s.scheme i).presheaf.stalk (s.arc i (closedPoint R)),
      x ∈ maximalIdeal _ ∧ maximalIdeal R = Ideal.span {
        (Scheme.stalkClosedPointTo (R := CommRingCat.of R) (s.arc i)).hom x} :=
  exists_uniformizer_lift
    (Scheme.stalkClosedPointTo (R := CommRingCat.of R) (s.arc i)).hom
    (s.arcStalkMap_surjective f hf i)

/-- Dividing a transformed quadratic relation by the square of the chart parameter lowers
both positive exponents by one. -/
private theorem blowup_chart_relation_decreases_exponents
    {S : Type u} [CommRing S] [IsDomain S]
    (x₁ u yᵢ y₂ z : S) (n m : ℕ) (hn : 0 < n) (hm : 0 < m)
    (hx₁ : x₁ ≠ 0)
    (h : x₁ ^ (n + 1) * yᵢ - u * x₁ ^ (m + 1) * y₂ = x₁ ^ 2 * z) :
    x₁ ^ (n - 1) * yᵢ - u * x₁ ^ (m - 1) * y₂ = z := by
  obtain ⟨n, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hn.ne'
  obtain ⟨m, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hm.ne'
  refine mul_left_cancel₀ (pow_ne_zero 2 hx₁) (Eq.trans ?_ h)
  simp only [Nat.add_one_sub_one]
  ring

/-- Substituting the chart coordinates `xᵢ = x₁ yᵢ` and `x₂ = x₁ y₂` into a relation
with quadratic right hand side gives the one-step exponent decrease. -/
private theorem blowup_chart_relation_decreases
    {S : Type u} [CommRing S] [IsDomain S]
    (x₁ u xᵢ x₂ yᵢ y₂ z : S) (n m : ℕ) (hn : 0 < n) (hm : 0 < m)
    (hx₁ : x₁ ≠ 0) (hxᵢ : xᵢ = x₁ * yᵢ) (hx₂ : x₂ = x₁ * y₂)
    (h : x₁ ^ n * xᵢ - u * x₁ ^ m * x₂ = x₁ ^ 2 * z) :
    x₁ ^ (n - 1) * yᵢ - u * x₁ ^ (m - 1) * y₂ = z := by
  subst hxᵢ hx₂
  exact blowup_chart_relation_decreases_exponents x₁ u yᵢ y₂ z n m hn hm hx₁ (by rw [← h]; ring)

/-- Substituting the chart coordinates `x j = x₁ * y j` into a relation whose right hand side
is a quadratic sum in the `x j` lowers both positive exponents by one. -/
private theorem blowup_chart_quadratic_relation_decreases
    {S ι : Type u} [CommRing S] [IsDomain S]
    (x₁ u xᵢ x₂ yᵢ y₂ : S) (n m : ℕ) (hn : 0 < n) (hm : 0 < m)
    (hx₁ : x₁ ≠ 0) (hxᵢ : xᵢ = x₁ * yᵢ) (hx₂ : x₂ = x₁ * y₂)
    (t : Finset (ι × ι)) (a : ι × ι → S) (x y : ι → S)
    (hx : ∀ j, x j = x₁ * y j)
    (h : x₁ ^ n * xᵢ - u * x₁ ^ m * x₂ =
      ∑ q ∈ t, a q * x q.1 * x q.2) :
    x₁ ^ (n - 1) * yᵢ - u * x₁ ^ (m - 1) * y₂ =
      ∑ q ∈ t, a q * y q.1 * y q.2 := by
  have hscaled : (∑ q ∈ t, a q * x q.1 * x q.2) = x₁ ^ 2 * ∑ q ∈ t, a q * y q.1 * y q.2 := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun q _ => by rw [hx, hx]; ring
  exact blowup_chart_relation_decreases x₁ u xᵢ x₂ yᵢ y₂ _ n m hn hm hx₁ hxᵢ hx₂ (h.trans hscaled)

/-- The same decrease follows directly from ideal membership: in a chart where
the old kernel is generated by `x₁` times the new kernel, its square is generated
by `x₁²` times the new square. -/
private theorem blowup_chart_relation_decreases_of_square_mem
    {S T ι : Type u} [CommRing S] [IsDomain S] [CommRing T] [IsDomain T]
    (g : S →+* T) (p : Ideal S) (q : Ideal T)
    (x₁ : S) (x : ι → S) (y : ι → T) (i k : ι) (c : S)
    (hp : p = Ideal.span (Set.range x)) (hq : q = Ideal.span (Set.range y))
    (hchart : ∀ j, g (x j) = g x₁ * y j)
    (hx₁ : g x₁ ≠ 0) (n m : ℕ) (hn : 0 < n) (hm : 0 < m)
    (hrel : x₁ ^ n * x i - c * x₁ ^ m * x k ∈ p ^ 2) :
    g x₁ ^ (n - 1) * y i - g c * g x₁ ^ (m - 1) * y k ∈ q ^ 2 := by
  have hmap : Ideal.map g p = Ideal.span {g x₁} * q := by
    rw [hp, Ideal.map_span, hq, Ideal.span_mul_span, ← Set.range_comp, Set.singleton_mul,
      ← Set.range_comp]
    exact congrArg (fun s => Ideal.span (Set.range s)) (funext hchart)
  have hmem : g (x₁ ^ n * x i - c * x₁ ^ m * x k) ∈ (Ideal.map g p) ^ 2 := by
    rw [← Ideal.map_pow]
    exact Ideal.mem_map_of_mem _ hrel
  rw [hmap, mul_pow, pow_two, Ideal.span_singleton_mul_span_singleton] at hmem
  obtain ⟨z, hz, hmul⟩ := (Ideal.mem_span_singleton_mul).mp hmem
  have hval : g x₁ ^ n * g (x i) - g c * g x₁ ^ m * g (x k) = g x₁ ^ 2 * z := by
    rw [pow_two, hmul]
    simp
  exact blowup_chart_relation_decreases (g x₁) (g c) (g (x i)) (g (x k))
    (y i) (y k) z n m hn hm hx₁ (hchart i) (hchart k) hval ▸ hz

/-- Along successive parameter charts, a two-term relation eliminates a
kernel generator after the smaller of its two exponents many steps. -/
private theorem exists_redundant_generator_of_iterated_chart_relation
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (B : ℕ → Type u) [∀ l, CommRing (B l)] [∀ l, IsDomain (B l)]
    [∀ l, IsLocalRing (B l)]
    (p : ∀ l, Ideal (B l)) (y : ∀ l, ι → B l) (a c : ∀ l, B l)
    (g : ∀ l, B l →+* B (l + 1))
    (hp : ∀ l, p l = Ideal.span (Set.range (y l)))
    (hpm : ∀ l, p l ≤ maximalIdeal (B l))
    (hchart : ∀ l j, g l (y l j) = g l (a l) * y (l + 1) j)
    (ha : ∀ l, g l (a l) = a (l + 1))
    (hc : ∀ l, g l (c l) = c (l + 1))
    (ha0 : ∀ l, a l ≠ 0)
    (i k : ι) (hki : k ≠ i) (n m : ℕ) (hunit : IsUnit (c 0))
    (hrel : a 0 ^ n * y 0 i - c 0 * a 0 ^ m * y 0 k ∈ p 0 ^ 2) :
    ∃ j : ι, p (min n m) =
      Ideal.span (y (min n m) '' {l | l ≠ j}) := by
  have hrelation (l : ℕ) (hl : l ≤ min n m) :
      a l ^ (n - l) * y l i - c l * a l ^ (m - l) * y l k ∈ p l ^ 2 := by
    induction l with
    | zero => simpa using hrel
    | succ l ih =>
        have hn : 0 < n - l := by omega
        have hm : 0 < m - l := by omega
        have hnonzero : g l (a l) ≠ 0 := ha l ▸ ha0 _
        have h := blowup_chart_relation_decreases_of_square_mem
          (g l) (p l) (p (l + 1)) (a l) (y l) (y (l + 1)) i k (c l)
          (hp l) (hp (l + 1)) (hchart l) hnonzero
          (n - l) (m - l) hn hm (ih (by omega))
        simpa only [ha, hc, Nat.sub_sub, Nat.add_comm l 1] using h
  have hunit' (l : ℕ) : IsUnit (c l) := by
    induction l with
    | zero => exact hunit
    | succ l ih => simpa only [hc] using ih.map (g l)
  have hzero : n - min n m = 0 ∨ m - min n m = 0 := by omega
  obtain ⟨j, hj⟩ := kernel_generators_erase_of_zero_power_relation
    (p (min n m)) (y (min n m)) i k (a (min n m)) (c (min n m))
    (n - min n m) (m - min n m) (hp _) (hpm _) hki
    (hunit' _) (hrelation _ le_rfl) hzero
  exact ⟨j, (hp _).trans hj⟩

/-- A relation with a single linear term eliminates that generator after its
parameter exponent many chart steps. -/
private theorem redundant_generator_of_iterated_chart_torsion_relation
    {ι : Type u} [Fintype ι] [DecidableEq ι]
    (B : ℕ → Type u) [∀ l, CommRing (B l)] [∀ l, IsDomain (B l)]
    [∀ l, IsLocalRing (B l)]
    (p : ∀ l, Ideal (B l)) (y : ∀ l, ι → B l) (a : ∀ l, B l)
    (g : ∀ l, B l →+* B (l + 1))
    (hp : ∀ l, p l = Ideal.span (Set.range (y l)))
    (hpm : ∀ l, p l ≤ maximalIdeal (B l))
    (hchart : ∀ l j, g l (y l j) = g l (a l) * y (l + 1) j)
    (ha : ∀ l, g l (a l) = a (l + 1)) (ha0 : ∀ l, a l ≠ 0)
    (i k : ι) (hki : k ≠ i) (n : ℕ)
    (hrel : a 0 ^ n * y 0 i ∈ p 0 ^ 2) :
    p n = Ideal.span (y n '' {l | l ≠ i}) := by
  have hrelation (l : ℕ) (hl : l ≤ n) :
      a l ^ (n - l) * y l i ∈ p l ^ 2 := by
    induction l with
    | zero => simpa using hrel
    | succ l ih =>
        have hn : 0 < n - l := by omega
        have hnonzero : g l (a l) ≠ 0 := ha l ▸ ha0 _
        have h := blowup_chart_relation_decreases_of_square_mem
          (g l) (p l) (p (l + 1)) (a l) (y l) (y (l + 1)) i k 0
          (hp l) (hp (l + 1)) (hchart l) hnonzero
          (n - l) (n - l) hn hn (by simpa using ih (by omega))
        simpa only [map_zero, zero_mul, sub_zero, ha, Nat.sub_sub,
          Nat.add_comm l 1] using h
  exact (hp n).trans (span_range_eq_span_range_erase_of_kernel_square_relation
    (p n) (y n) i k 0 (hp n) (hpm n) hki (by simpa using hrelation n le_rfl))

/-- The same chart calculation allows any finite sum of linear terms. Each positive
exponent on a coefficient of a chosen parameter decreases by one, while the quadratic
error remains quadratic in the new chart coordinates. -/
private theorem blowup_chart_quadratic_relation_decreases_linear
    {S ι : Type u} [CommRing S] [IsDomain S]
    (x₁ u xᵢ : S) (x y : ι → S) (n : ℕ) (hn : 0 < n)
    (s : Finset ι) (m : ι → ℕ) (c : ι → S)
    (hm : ∀ j ∈ s, 0 < m j) (hx₁ : x₁ ≠ 0)
    (hxᵢ : xᵢ = x₁ * u) (hx : ∀ j, x j = x₁ * y j)
    (t : Finset (ι × ι)) (a : ι × ι → S)
    (h : x₁ ^ n * xᵢ - ∑ j ∈ s, c j * x₁ ^ (m j) * x j =
      ∑ q ∈ t, a q * x q.1 * x q.2) :
    x₁ ^ (n - 1) * u - ∑ j ∈ s, c j * x₁ ^ (m j - 1) * y j =
      ∑ q ∈ t, a q * y q.1 * y q.2 := by
  obtain ⟨n, rfl⟩ := Nat.exists_eq_add_one_of_ne_zero hn.ne'
  subst hxᵢ
  have hS : x₁ ^ 2 * ∑ j ∈ s, c j * x₁ ^ (m j - 1) * y j = ∑ j ∈ s, c j * x₁ ^ (m j) * x j := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun j hj => ?_
    obtain ⟨k, hk⟩ := Nat.exists_eq_add_one_of_ne_zero (hm j hj).ne'
    rw [hk, Nat.add_one_sub_one, hx]
    ring
  have hQ : (∑ q ∈ t, a q * x q.1 * x q.2) = x₁ ^ 2 * ∑ q ∈ t, a q * y q.1 * y q.2 := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl fun q _ => by rw [hx, hx]; ring
  refine mul_left_cancel₀ (pow_ne_zero 2 hx₁) ?_
  simp only [Nat.add_one_sub_one]
  linear_combination h - hS + hQ

/-- If the original kernel is principal, the base center is regular. -/
private theorem ArcBlowupSequence.exists_regular_center_of_kernel_span_singleton
    {A R : Type u} [CommRing A] [IsDomain A] [IsLocalRing A]
    [IsNoetherianRing A] [CommRing R] [IsDomain R] [IsLocalRing R]
    [IsDiscreteValuationRing R]
    (hA : ringKrullDim A = 2) (f : A →+* R) (hf : Function.Surjective f)
    (s : ArcBlowupSequence A R f) (p : Ideal A) (hp : RingHom.ker f = p)
    (x₁ x₂ : A) (hx₁ : x₁ ∈ maximalIdeal A) (hx₂ : x₂ ∈ maximalIdeal A)
    (hpgen : p = Ideal.span {x₂})
    (hπ : maximalIdeal R = Ideal.span {f x₁}) :
    IsRegularLocalRing ((s.scheme 0).presheaf.stalk
      (s.arc 0 (closedPoint R))) := by
  have := regular_of_kernel_span_singleton hA f hf p hp x₁ x₂ hx₁ hx₂ hpgen hπ
  have hregStalk : IsRegularLocalRing ((Spec (.of A)).presheaf.stalk (closedPoint A)) :=
    .of_ringEquiv (stalkClosedPointIso (CommRingCat.of A)).commRingCatIsoToRingEquiv.symm
  have : IsLocalHom f := IsLocalHom.of_surjective f hf
  have hpoint : s.base.hom (s.arc 0 (closedPoint R)) = closedPoint A := by
    show (s.arc 0 ≫ s.base.hom) (closedPoint (CommRingCat.of R)) =
      closedPoint (CommRingCat.of A)
    rw [s.base_arc]
    exact AlgebraicGeometry.Spec_closedPoint
  exact regular_stalk_of_iso s.base _ (hpoint ▸ hregStalk)

/-- A generator of the maximal ideal of a discrete valuation ring is nonzero. -/
private theorem ne_zero_of_maximalIdeal_eq_span
    {R : Type*} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (r : R) (hr : maximalIdeal R = Ideal.span {r}) : r ≠ 0 :=
  fun h => IsDiscreteValuationRing.not_a_field R (by simpa [h] using hr)

/-- Transporting a kernel along a ring equivalence: the kernel of `f ∘ E⁻¹` is the image of
the kernel of `f`. -/
private theorem ker_comp_symm_eq_map {B C R : Type*} [CommRing B] [CommRing C] [CommRing R]
    (E : B ≃+* C) (f : B →+* R) :
    RingHom.ker (f.comp E.symm.toRingHom) = (RingHom.ker f).map E.toRingHom := by
  simp only [RingEquiv.toRingHom_eq_coe]
  rw [Ideal.map_comap_of_equiv]
  rfl

/-- If `ker f` is generated by `x`, then `ker (f ∘ E⁻¹)` is generated by `E ∘ x`. -/
private theorem ker_comp_symm_eq_span_range {B C R ι : Type*} [CommRing B] [CommRing C]
    [CommRing R] (E : B ≃+* C) (f : B →+* R) (x : ι → B)
    (hx : RingHom.ker f = Ideal.span (Set.range x)) :
    RingHom.ker (f.comp E.symm.toRingHom) = Ideal.span (Set.range fun j => E (x j)) := by
  rw [ker_comp_symm_eq_map, hx, Ideal.map_span, ← Set.range_comp]
  rfl

/-- Membership in the square of a kernel is preserved by a ring equivalence. -/
private theorem mem_ker_comp_symm_sq {B C R : Type*} [CommRing B] [CommRing C] [CommRing R]
    (E : B ≃+* C) (f : B →+* R) {z : B} (hz : z ∈ RingHom.ker f ^ 2) :
    E z ∈ RingHom.ker (f.comp E.symm.toRingHom) ^ 2 := by
  rw [ker_comp_symm_eq_map, ← Ideal.map_pow]
  exact Ideal.mem_map_of_mem _ hz

/-- Precomposing a ring map with the inverse of the identification of `B` with the sections
over an affine open moves an arc through `j` to an arc through `fromSpec`. -/
private theorem spec_map_comp_symm_fromSpec {B R : Type u} [CommRing B] [CommRing R]
    {X : Scheme.{u}} {V : X.affineOpens} {j : Spec (.of B) ⟶ X} (E : B ≃+* Γ(X, V.1))
    (hE : Spec.map (CommRingCat.ofHom E.toRingHom) ≫ j = (isAffineOpen_coe V).fromSpec)
    (g : B →+* R) {α : Spec (.of R) ⟶ X} (hg : Spec.map (CommRingCat.ofHom g) ≫ j = α) :
    Spec.map (CommRingCat.ofHom (g.comp E.symm.toRingHom)) ≫
      (isAffineOpen_coe V).fromSpec = α := by
  rw [← hE, ← Category.assoc, ← Spec.map_comp]
  have hEF : CommRingCat.ofHom E.toRingHom ≫ CommRingCat.ofHom (g.comp E.symm.toRingHom) =
      CommRingCat.ofHom g := by ext b; simp
  rw [hEF]
  exact hg

/-- Balanced relations lose one common parameter power on each chart. At
exponent zero, Nakayama's lemma makes the kernel principal at the center. -/
private theorem exists_regular_center_of_balanced_relations
    {A R ι : Type u} [CommRing A] [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] [Fintype ι]
    {f₀ : A →+* R} (s : ArcBlowupSequence A R f₀) (n : ℕ) :
    ∀ (i : ℕ) (U : (s.scheme i).affineOpens)
      [IsDomain Γ(s.scheme i, U.1)] [IsNoetherianRing Γ(s.scheme i, U.1)]
      (f : Γ(s.scheme i, U.1) →+* R) (_ : Function.Surjective f)
      (_ : Spec.map (CommRingCat.ofHom f) ≫ (isAffineOpen_coe U).fromSpec = s.arc i)
      (a : Γ(s.scheme i, U.1)) (x : ι → Γ(s.scheme i, U.1)) (k : ι)
      (c : ι → Γ(s.scheme i, U.1))
      (_ : RingHom.ker f = Ideal.span (Set.range x))
      (_ : maximalIdeal R = Ideal.span {f a})
      (_ : ∀ j, a ^ n * x j - c j * a ^ n * x k ∈ (RingHom.ker f) ^ 2),
      ∃ l : ℕ, IsRegularLocalRing ((s.scheme l).presheaf.stalk
        (s.arc l (closedPoint R))) := by
  classical
  induction n with
  | zero =>
      intro i U _ _ f hf hα a x k c hp hπ hrel
      refine ⟨i, ?_⟩
      rw [← hα]
      exact regular_stalk_of_generators_mod_square U f hf x k hp
        fun j => ⟨c j, by simpa using hrel j⟩
  | succ n ih =>
      intro i U _ _ f hf hα a x k c hp hπ hrel
      let I := Scheme.IdealSheafData.vanishingIdeal
        (⟨{s.arc i (closedPoint R)}, s.center_closed i⟩ : Closeds (s.scheme i))
      obtain ⟨e, he⟩ := s.step_blowup i
      let β := s.arc (i + 1) ≫ e.hom
      have hβ : β ≫ (blowUpToBase I) = s.arc i := by
        dsimp [β]
        rw [Category.assoc, he, s.step_arc]
      obtain ⟨j, g, y, hj, hg, hgs, hcomp, hker, hy, hdiv⟩ :=
        exists_affineBlowup_chart_arc U f hf (s.arc i) hα (s.center_closed i)
          a x hp hπ β hβ
      let B := affineBlowupAlgebra (I.ideal U) a (Localization.Away a)
      have hfa : f a ≠ 0 := ne_zero_of_maximalIdeal_eq_span (f a) hπ
      have ha : a ≠ 0 := fun h => hfa (h ▸ map_zero f)
      have : IsDomain (Localization.Away a) := Localization.Away.isDomain ha
      have : IsDomain B := inferInstance
      have : Algebra.FiniteType Γ(s.scheme i, U.1) B := by
        refine ⟨⟨Finset.univ.image y, ?_⟩⟩
        simpa only [Finset.coe_image, Finset.coe_univ, Set.image_univ] using hy
      have : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing
        Γ(s.scheme i, U.1) B
      have : IsOpenImmersion j := hj
      let j' := j ≫ e.inv
      have hgj : Spec.map (CommRingCat.ofHom g) ≫ j' = s.arc (i + 1) := by
        dsimp [j']
        rw [← Category.assoc, hg]
        simp [β]
      obtain ⟨V, E, hE⟩ := exists_affineOpen_ringEquiv j'
      have : IsDomain Γ(s.scheme (i + 1), V.1) :=
        MulEquiv.isDomain B E.symm.toMulEquiv
      have : IsNoetherianRing Γ(s.scheme (i + 1), V.1) :=
        isNoetherianRing_of_ringEquiv B E
      let F := g.comp E.symm.toRingHom
      let φ := E.toRingHom.comp (algebraMap Γ(s.scheme i, U.1) B)
      have hFφ : F.comp φ = f := by
        ext b
        simpa only [F, φ, RingHom.comp_apply, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
          RingEquiv.symm_apply_apply] using
          congrArg (fun h : Γ(s.scheme i, U.1) →+* R => h b) hcomp
      have hFs : Function.Surjective F := hgs.comp E.symm.surjective
      have hFarc := spec_map_comp_symm_fromSpec E hE g hgj
      have hgenE := ker_comp_symm_eq_span_range E g y hker
      have hπE : maximalIdeal R = Ideal.span {F (φ a)} := by
        rwa [show F (φ a) = f a from congrArg
          (fun h : Γ(s.scheme i, U.1) →+* R => h a) hFφ]
      have haB : algebraMap Γ(s.scheme i, U.1) B a ≠ 0 := fun h => hfa <| by
        rw [← hcomp, RingHom.comp_apply, h, map_zero]
      apply ih (i + 1) V F hFs hFarc (φ a) (fun j => E (y j)) k
        (fun j => φ (c j)) hgenE hπE
      intro l
      have hmap := mem_ker_comp_symm_sq E g (blowup_chart_relation_decreases_of_square_mem
        (algebraMap Γ(s.scheme i, U.1) B) (RingHom.ker f) (RingHom.ker g)
        a x y l k (c l) hp hker hdiv haB (n + 1) (n + 1)
        (Nat.zero_lt_succ n) (Nat.zero_lt_succ n) (hrel l))
      simpa only [Nat.add_sub_cancel, map_sub, map_mul, map_pow,
        RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, φ, F, RingHom.comp_apply] using hmap

/-- A sequence of blowups along a formal arc whose generic image is regular eventually
reaches a regular center. -/
@[stacks 0BG3]
theorem exists_regular_center
    {A R : Type u} [CommRing A] [IsDomain A] [IsLocalRing A]
    [IsNoetherianRing A] [CommRing R] [IsDomain R]
    [IsDiscreteValuationRing R] [IsAdicComplete (maximalIdeal R) R]
    (hA : ringKrullDim A = 2) (f : A →+* R) (hf : Function.Surjective f)
    (hgeneric : IsRegularLocalRing ((Spec (.of A)).presheaf.stalk
      (Spec.map (CommRingCat.ofHom f) (genericPoint (Spec (.of R))))))
    (s : ArcBlowupSequence A R f) :
    ∃ i : ℕ, IsRegularLocalRing ((s.scheme i).presheaf.stalk
      (s.arc i (closedPoint R))) := by
  classical
  obtain ⟨x₁, hx₁, hπ⟩ := exists_uniformizer_lift f hf
  by_cases hprincipal : (RingHom.ker f).IsPrincipal
  · obtain ⟨x₂, hx₂⟩ := hprincipal
    let : (RingHom.ker f).IsPrime := RingHom.ker_isPrime f
    have hx₂m : x₂ ∈ maximalIdeal A :=
      IsLocalRing.le_maximalIdeal_of_isPrime (RingHom.ker f) (hx₂ ▸ Ideal.subset_span rfl)
    exact ⟨0, s.exists_regular_center_of_kernel_span_singleton hA f hf
      (RingHom.ker f) rfl x₁ x₂ hx₁ hx₂m hx₂ hπ⟩
  · obtain ⟨t, ht⟩ := IsNoetherian.noetherian (RingHom.ker f)
    have htne : t.Nonempty := Finset.nonempty_iff_ne_empty.2 fun h => hprincipal <| by
      rw [← ht, h, Finset.coe_empty, Submodule.span_empty]
      infer_instance
    let : Nonempty t := htne.to_subtype
    let x : t → A := Subtype.val
    have hx : RingHom.ker f = Ideal.span (Set.range x) := by
      show RingHom.ker f = Submodule.span A (Set.range x)
      have hset : Set.range x = (t : Set A) := by ext b; simp [x]
      rw [hset]
      exact ht.symm
    let : (RingHom.ker f).IsPrime := RingHom.ker_isPrime f
    obtain ⟨k₀, hk₀⟩ := exists_generic_generator_in_family hA f hf hgeneric x hx
    obtain ⟨N, k, c, hrel⟩ := exists_balanced_power_relations f hf
      (RingHom.ker f) rfl x₁ hπ x (fun i => hx ▸ Ideal.subset_span ⟨i, rfl⟩) k₀ hk₀
    obtain ⟨U, E, hE⟩ := exists_affineOpen_ringEquiv s.base.inv
    have : IsDomain Γ(s.scheme 0, U.1) := MulEquiv.isDomain A E.symm.toMulEquiv
    have : IsNoetherianRing Γ(s.scheme 0, U.1) := isNoetherianRing_of_ringEquiv A E
    let F := f.comp E.symm.toRingHom
    have hFs : Function.Surjective F := hf.comp E.symm.surjective
    have hFarc := spec_map_comp_symm_fromSpec E hE f (α := s.arc 0) (by
      rw [← s.base_arc]
      simp)
    have hgenE := ker_comp_symm_eq_span_range E f x hx
    have hπE : maximalIdeal R = Ideal.span {F (E x₁)} := by simpa [F] using hπ
    apply exists_regular_center_of_balanced_relations s N 0 U F hFs hFarc (E x₁)
      (fun j => E (x j)) k (fun j => E (c j)) hgenE hπE
    intro l
    simpa only [map_sub, map_mul, map_pow, RingEquiv.toRingHom_eq_coe, F,
      RingEquiv.coe_toRingHom] using mem_ker_comp_symm_sq E f (hrel l)

end AlgebraicGeometry

