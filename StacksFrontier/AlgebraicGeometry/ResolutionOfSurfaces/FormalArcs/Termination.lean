/-!
# Termination of a sequence of point blowups over a complete base

An infinite sequence of blowups at closed points whose exceptional divisors are cut out by the
successive transforms of a single element of the initial local ring comes from a nonsingular
formal arc (Tag 0BG2), and a sequence of blowups along a nonsingular formal arc reaches a
regular centre (Tag 0BG3). This file composes the two.

The composition needs one thing that Tag 0BG2 does not state: that the ring homomorphism to the
complete discrete valuation ring produced there is *surjective*, which is what Tag 0BG3
consumes. Over a base whose local ring at the initial centre is complete, surjectivity is a
consequence of the two first-order statements that Tag 0BG2 does supply — the maximal ideal of
the valuation ring is generated by the image of the chosen element, and the residue field is
unchanged — together with successive approximation in the complete ring.

## Main results

* `surjective_of_maximalIdeal_eq_span_image`: a local homomorphism from a ring complete for its
  maximal-ideal-adic topology onto a local ring whose maximal ideal is generated by the image of
  one element, surjective on residue fields, is surjective.
* `AlgebraicGeometry.exists_surjective_nonsingularFormalArc_of_pointBlowupSequence`: Tag 0BG2
  over a base with complete local ring at the initial centre, with the surjectivity of the arc.
* `AlgebraicGeometry.exists_isRegularLocalRing_stalk_point_of_pointBlowupSequence`: such a
  sequence over the spectrum of a two-dimensional complete normal local Noetherian domain has a
  stage whose centre is a regular point. Equivalently, no such sequence has every centre
  singular; this is the termination statement that the resolution of a rational double point in
  Section 54.12 of the source needs.

## References

* [Stacks Project, Tag 0BG2](https://stacks.math.columbia.edu/tag/0BG2)
* [Stacks Project, Tag 0BG3](https://stacks.math.columbia.edu/tag/0BG3)
-/

@[expose] public noncomputable section

open CategoryTheory IsLocalRing

universe u

/-- A local homomorphism from a ring complete for its maximal-ideal-adic topology to a local
ring which is Hausdorff for its own, whose maximal ideal is generated by the image of a single
element of the maximal ideal of the source and which is surjective on residue fields, is
surjective: the image of the maximal ideal is then the whole maximal ideal of the target, and
successive approximation in the complete source lifts any element of the target. -/
public theorem surjective_of_maximalIdeal_eq_span_image {A R : Type*} [CommRing A]
    [IsLocalRing A] [CommRing R] [IsLocalRing R] [IsPrecomplete (maximalIdeal A) A]
    [IsHausdorff (maximalIdeal R) R] (f : A →+* R) [IsLocalHom f] {x : A}
    (hx : x ∈ maximalIdeal A) (hmax : maximalIdeal R = Ideal.span {f x})
    (hres : Function.Surjective ((Ideal.Quotient.mk (maximalIdeal R)).comp f)) :
    Function.Surjective f := by
  have hmap : Ideal.map f (maximalIdeal A) = maximalIdeal R := by
    refine le_antisymm (IsLocalRing.map_maximalIdeal_le f) ?_
    rw [hmax, Ideal.span_le, Set.singleton_subset_iff]
    exact Ideal.mem_map_of_mem f hx
  have : IsHausdorff (Ideal.map f (maximalIdeal A)) R :=
    hmap ▸ (inferInstance : IsHausdorff (maximalIdeal R) R)
  exact surjective_of_mk_map_comp_surjective (I := maximalIdeal A) f (by rw [hmap]; exact hres)

namespace AlgebraicGeometry

/-- A morphism from the spectrum of a local ring, whose closed point goes to `p`, is the
morphism from the spectrum of the stalk at `p` attached to a local homomorphism out of that
stalk. This is `AlgebraicGeometry.Scheme.stalkClosedPointTo` with its base point transported to
`p`, so that the homomorphism is stated on the stalk at `p` itself. -/
@[ega "I 2.4.4" "partial", ega "I 3.4.5" "partial"]
public theorem exists_stalkHom_of_closedPoint_eq {X : Scheme.{u}} {R : CommRingCat.{u}}
    [IsLocalRing R] (a : Spec R ⟶ X) {p : X} (hp : a (closedPoint R) = p) :
    ∃ g : X.presheaf.stalk p ⟶ R, IsLocalHom g.hom ∧
      Spec.map g ≫ X.fromSpecStalk p = a ∧
      Set.range g.hom = Set.range (Scheme.stalkClosedPointTo a).hom ∧
      ∀ y : X.presheaf.stalk p, g.hom y = (Scheme.stalkClosedPointTo a).hom (hp.symm ▸ y) := by
  subst hp
  exact ⟨Scheme.stalkClosedPointTo a, inferInstance,
    Scheme.Spec_stalkClosedPointTo_fromSpecStalk a, rfl, fun _ => rfl⟩

/-- An isomorphism of the residue fields at the closed point translates into surjectivity of the
residue map of the homomorphism out of the stalk: the latter is the former followed by the
residue field of the isomorphism between the stalk of `Spec R` at its closed point and `R`. -/
public theorem surjective_residue_comp_of_isIso_residueFieldMap {X : Scheme.{u}}
    {R : CommRingCat.{u}} [IsLocalRing R] (a : Spec R ⟶ X)
    (hiso : IsIso (a.residueFieldMap (closedPoint R))) :
    Function.Surjective ((Ideal.Quotient.mk (maximalIdeal R)).comp
      (Scheme.stalkClosedPointTo a).hom) := by
  let p : Spec R := IsLocalRing.closedPoint R
  let e : (Spec R).presheaf.stalk p ≅ R := stalkClosedPointIso R
  have hcomp : IsLocalRing.ResidueField.map (Scheme.stalkClosedPointTo a).hom =
      (IsLocalRing.ResidueField.map e.hom.hom).comp (a.residueFieldMap p).hom :=
    IsLocalRing.ResidueField.map_comp (a.stalkMap p).hom e.hom.hom
  have hsurj : Function.Surjective
      (IsLocalRing.ResidueField.map (Scheme.stalkClosedPointTo a).hom) := by
    rw [hcomp]
    exact (IsLocalRing.ResidueField.mapEquiv e.commRingCatIsoToRingEquiv).surjective.comp
      ((ConcreteCategory.isIso_iff_bijective _).mp hiso).2
  exact hsurj.comp IsLocalRing.residue_surjective

/-- The conclusion of [Stacks, Tag 0BG2] over a base whose local ring at the initial centre is
complete, with the surjectivity of the arc added: the homomorphism `g` out of that local ring is
surjective onto the complete discrete valuation ring. Surjectivity is what
`AlgebraicGeometry.exists_regular_center`, Tag 0BG3, consumes, and it is not part of the
statement of `AlgebraicGeometry.exists_nonsingularFormalArc_of_pointBlowupSequence`.

No `stacks 0BG2` attribute is attached here. Completeness of the local ring at the initial
centre is not among that tag's hypotheses, so this is a result about a restricted situation, not
a formalization of the tag; the tag stays on
`AlgebraicGeometry.exists_nonsingularFormalArc_of_pointBlowupSequence`, which assumes no such
thing. In the source the surjection is onto a quotient of the completion of the local ring, and
over a complete base that quotient is a quotient of the local ring itself. -/
public theorem exists_surjective_nonsingularFormalArc_of_pointBlowupSequence
    (s : PointBlowupSequence.{u}) [IsLocallyNoetherian (s.scheme 0)]
    [IsPrecomplete (maximalIdeal ((s.scheme 0).presheaf.stalk (s.point 0)))
      ((s.scheme 0).presheaf.stalk (s.point 0))]
    (x : (s.scheme 0).presheaf.stalk (s.point 0))
    (hx : x ∈ maximalIdeal ((s.scheme 0).presheaf.stalk (s.point 0)))
    (hExceptional : ∀ n, s.exceptionalIdealAt n =
      Ideal.span {s.stalkImage (n + 1) x}) :
    ∃ (R : CommRingCat.{u}) (hDomain : IsDomain R),
      letI : IsDomain R := hDomain
      ∃ (hDVR : IsDiscreteValuationRing R),
        letI : IsDiscreteValuationRing R := hDVR
        ∃ (_hComplete : IsAdicComplete (maximalIdeal R) R)
          (g : (s.scheme 0).presheaf.stalk (s.point 0) ⟶ R),
          Function.Surjective g.hom ∧
          maximalIdeal R = Ideal.span {g.hom x} ∧
          ∃ lifts : (n : ℕ) → Spec R ⟶ s.scheme n,
            lifts 0 = Spec.map g ≫ (s.scheme 0).fromSpecStalk (s.point 0) ∧
            (∀ n, lifts (n + 1) ≫ s.stepMap n = lifts n) ∧
            (∀ n, lifts n (closedPoint R) = s.point n) := by
  obtain ⟨R, hDomain, hDVR, hComplete, a, hCenter, hiso, hmax, lifts, hlift0, hstep, hpt⟩ :=
    exists_nonsingularFormalArc_of_pointBlowupSequence s x hx hExceptional
  let : IsDomain R := hDomain
  let : IsDiscreteValuationRing R := hDVR
  let : IsAdicComplete (maximalIdeal R) R := hComplete
  obtain ⟨g, hglocal, hgspec, hgrange, hgapply⟩ := exists_stalkHom_of_closedPoint_eq a hCenter
  have hgmax : maximalIdeal R = Ideal.span {g.hom x} := by rw [hgapply x]; exact hmax
  have hgres : Function.Surjective ((Ideal.Quotient.mk (maximalIdeal R)).comp g.hom) := by
    intro z
    obtain ⟨y, hy⟩ := surjective_residue_comp_of_isIso_residueFieldMap a hiso z
    obtain ⟨y', hy'⟩ : (Scheme.stalkClosedPointTo a).hom y ∈ Set.range g.hom := by
      rw [hgrange]; exact ⟨y, rfl⟩
    exact ⟨y', by rw [RingHom.comp_apply, hy']; exact hy⟩
  refine ⟨R, hDomain, hDVR, hComplete, g, ?_, hgmax, lifts, ?_, hstep, hpt⟩
  · exact surjective_of_maximalIdeal_eq_span_image g.hom hx hgmax hgres
  · rw [hlift0, hgspec]

/-- The stalk map of an isomorphism of schemes is an isomorphism. This states the instance at a
variable point, so that it applies at a point written as a prime ideal of a ring. -/
public theorem isIso_stalkMap_hom_of_iso {X Y : Scheme.{u}} (e : X ≅ Y) (z : X) :
    IsIso (e.hom.stalkMap z) := inferInstance

/-- An isomorphism of the spectrum of a local ring with a scheme, matching the closed point with
a point `p`, rewrites the canonical morphism from the spectrum of the stalk at `p` as the
spectrum of a homomorphism out of the ring itself: the two sources differ by the isomorphism
`ι` of the ring with the stalk. -/
public theorem exists_isIso_specMap_comp_of_iso_spec {X : Scheme.{u}} (A : Type u) [CommRing A]
    [IsLocalRing A] {R : CommRingCat.{u}} (eA : Spec (.of A) ≅ X) {p : X}
    (hp : eA.hom (closedPoint A) = p) (g : X.presheaf.stalk p ⟶ R) :
    ∃ ι : CommRingCat.of A ⟶ X.presheaf.stalk p, IsIso ι ∧
      Spec.map (ι ≫ g) = (Spec.map g ≫ X.fromSpecStalk p) ≫ eA.inv := by
  subst hp
  have hst : IsIso (eA.hom.stalkMap (closedPoint A)) :=
    isIso_stalkMap_hom_of_iso eA (closedPoint A)
  have hfrom := Scheme.SpecMap_stalkMap_fromSpecStalk (f := eA.hom) (x := closedPoint A)
  have key : X.fromSpecStalk (eA.hom (closedPoint A)) ≫ eA.inv =
      Spec.map (inv (eA.hom.stalkMap (closedPoint A))) ≫
        Spec.map (stalkClosedPointIso (.of A)).inv := by
    rw [Spec_stalkClosedPointIso, Spec.map_inv, IsIso.eq_inv_comp, ← Category.assoc, hfrom,
      Category.assoc, Iso.hom_inv_id, Category.comp_id]
  refine ⟨(stalkClosedPointIso (.of A)).inv ≫ inv (eA.hom.stalkMap (closedPoint A)),
    inferInstance, ?_⟩
  rw [Spec.map_comp, Spec.map_comp, Category.assoc, key]

/-- A stage of a sequence of point blowups is the blowup of the preceding one at any point equal
to its centre. This is `AlgebraicGeometry.PointBlowupSequence.stepIso` with the centre named by
an equation, as `AlgebraicGeometry.ArcBlowupSequence` wants it. -/
public theorem PointBlowupSequence.exists_stepIso_of_eq (s : PointBlowupSequence.{u}) (i : ℕ)
    {y : s.scheme i} (hy : y = s.point i)
    (hyc : IsClosed ({y} : Set (s.scheme i))) :
    ∃ e' : s.scheme (i + 1) ≅ blowUp (Scheme.IdealSheafData.vanishingIdeal
        (⟨{y}, hyc⟩ : TopologicalSpace.Closeds (s.scheme i))),
      e'.hom ≫ blowUpToBase (Scheme.IdealSheafData.vanishingIdeal
        (⟨{y}, hyc⟩ : TopologicalSpace.Closeds (s.scheme i))) = s.stepMap i := by
  subst hy
  exact ⟨s.stepIso i, (s.stepMap_eq i).symm⟩

/-- The kernel of a surjection of a local ring onto a discrete valuation ring is not the maximal
ideal: the quotient by the kernel is the valuation ring, which is not a field. -/
public theorem ker_ne_maximalIdeal_of_surjective_isDiscreteValuationRing {A R : Type*}
    [CommRing A] [IsLocalRing A] [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]
    (f : A →+* R) (hf : Function.Surjective f) : RingHom.ker f ≠ maximalIdeal A := by
  intro hk
  refine IsDiscreteValuationRing.not_isField R ?_
  refine ((f.quotientKerEquivOfSurjective hf).toMulEquiv.isField_congr).mp ?_
  refine (Ideal.Quotient.maximal_ideal_iff_isField_quotient (RingHom.ker f)).mp ?_
  rw [hk]
  exact IsLocalRing.maximalIdeal.isMaximal A

/-- **The termination engine of Tag 0BGE.** Over the spectrum of a two-dimensional normal
Noetherian local domain which is complete for its maximal-ideal-adic topology, an infinite
sequence of blowups at closed points with unchanged residue fields, whose exceptional divisors
are cut out by the successive transforms of a single element of the local ring at the initial
centre, has a stage at which the centre is a regular point.

This composes [Stacks, Tag 0BG2] — such a sequence comes from a nonsingular formal arc — with
[Stacks, Tag 0BG3] — a sequence of blowups along a nonsingular formal arc over a ring which is
regular at the kernel prime reaches a regular centre. Regularity at the kernel prime is Serre's
criterion: the kernel is not the maximal ideal, hence of height at most one, where normality
makes the local ring regular. -/
public theorem exists_isRegularLocalRing_stalk_point_of_pointBlowupSequence (A : Type u)
    [CommRing A] [IsLocalRing A] [IsNormalDomain A] [IsNoetherianRing A]
    [IsAdicComplete (maximalIdeal A) A] (hdim : ringKrullDim A = 2)
    (s : PointBlowupSequence.{u}) (eX : s.scheme 0 ≅ Spec (.of A))
    (hp : eX.inv (closedPoint A) = s.point 0)
    (x : (s.scheme 0).presheaf.stalk (s.point 0))
    (hx : x ∈ maximalIdeal ((s.scheme 0).presheaf.stalk (s.point 0)))
    (hExceptional : ∀ n, s.exceptionalIdealAt n =
      Ideal.span {s.stalkImage (n + 1) x}) :
    ∃ n, IsRegularLocalRing ((s.scheme n).presheaf.stalk (s.point n)) := by
  let : IsLocallyNoetherian (s.scheme 0) := isLocallyNoetherian_of_isOpenImmersion eX.hom
  -- the local ring at the initial centre is the complete ring `A`
  obtain ⟨ι, hιiso, hιspec⟩ :=
    exists_isIso_specMap_comp_of_iso_spec A eX.symm hp (𝟙 ((s.scheme 0).presheaf.stalk (s.point 0)))
  let : IsAdicComplete (maximalIdeal ((s.scheme 0).presheaf.stalk (s.point 0)))
      ((s.scheme 0).presheaf.stalk (s.point 0)) :=
    isAdicComplete_maximalIdeal_of_ringEquiv (asIso ι).commRingCatIsoToRingEquiv
  obtain ⟨R, hDomain, hDVR, hComplete, g, hgsurj, hgmax, lifts, hlift0, hstep, hpt⟩ :=
    exists_surjective_nonsingularFormalArc_of_pointBlowupSequence s x hx hExceptional
  let : IsDomain R := hDomain
  let : IsDiscreteValuationRing R := hDVR
  let : IsAdicComplete (maximalIdeal R) R := hComplete
  -- the arc out of `A` itself
  obtain ⟨κ, hκiso, hκspec⟩ := exists_isIso_specMap_comp_of_iso_spec A eX.symm hp g
  have hfsurj : Function.Surjective (κ ≫ g).hom :=
    hgsurj.comp ((ConcreteCategory.isIso_iff_bijective κ).mp hκiso).2
  -- the arc blowup sequence attached to the sequence of point blowups
  have hκspec' : Spec.map (κ ≫ g) =
      (Spec.map g ≫ (s.scheme 0).fromSpecStalk (s.point 0)) ≫ eX.hom := hκspec
  have hbase : lifts 0 ≫ eX.hom = Spec.map (CommRingCat.ofHom (κ ≫ g).hom) := by
    rw [hlift0, ← hκspec']
    rfl
  let f : A →+* R := (κ ≫ g).hom
  let t : ArcBlowupSequence A R f :=
    { scheme := s.scheme
      arc := lifts
      base := eX
      base_arc := hbase
      center_closed := fun i => (hpt i) ▸ s.point_closed i
      step := s.stepMap
      step_arc := hstep
      step_blowup := fun i =>
        s.exists_stepIso_of_eq i (hpt i) ((hpt i) ▸ s.point_closed i) }
  -- Serre's criterion at the kernel prime
  let : (RingHom.ker f).IsPrime := RingHom.ker_isPrime f
  have hker : Spec.map (CommRingCat.ofHom f) (genericPoint (Spec (.of R))) =
      (⟨RingHom.ker f, inferInstance⟩ : PrimeSpectrum A) := by
    apply PrimeSpectrum.ext
    change (PrimeSpectrum.comap f (genericPoint (Spec (.of R)))).asIdeal = RingHom.ker f
    rw [genericPoint_eq_bot_of_affine]
    ext z
    rfl
  have hgeneric : IsRegularLocalRing ((Spec (.of A)).presheaf.stalk
      (Spec.map (CommRingCat.ofHom f) (genericPoint (Spec (.of R))))) := by
    rw [hker]
    refine (isRegularLocalRing_stalk_spec_iff A _).mpr ?_
    exact isRegularLocalRing_localization_of_isNormalRing
      (IsNormalRing.of_isIntegrallyClosed A) (RingHom.ker f)
      (height_le_one_of_ne_maximalIdeal hdim (RingHom.ker f)
        (ker_ne_maximalIdeal_of_surjective_isDiscreteValuationRing f hfsurj))
  obtain ⟨i, hi⟩ := exists_regular_center hdim f hfsurj hgeneric t
  exact ⟨i, (hpt i) ▸ hi⟩

end AlgebraicGeometry

end
