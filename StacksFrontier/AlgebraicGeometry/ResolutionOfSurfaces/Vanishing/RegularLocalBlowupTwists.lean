section Devissage

/-- **The dévissage of part (3) of [Stacks, Tag 0AGS], out of an arbitrary coproduct.** Let `X`
be a quasi-compact quasi-separated scheme, let `𝒩` be a quasi-coherent module with
`H¹(X, 𝒩) = 0`, and let `𝑐` exhibit an object as a coproduct of copies of `𝒩`. If that object
surjects onto `ℱ` and `H²` vanishes on every quasi-coherent module, then `H¹(X, ℱ) = 0`.

The point of the coproduct is quasi-coherent — `Stacks.AlgebraicGeometry`
`.QuasicoherentColimits.isQuasicoherent_of_isColimit`, quasi-coherence being closed under
colimits — so the kernel of the surjection is quasi-coherent too and the sequence
`0 → ker π → 𝑐.pt → ℱ → 0` can be fed to
`Stacks.AlgebraicGeometry.TopDegreeBaseChange.isZero_rightDerivedPlus_one_of_shortExact`; its
hypothesis on the middle term is
`Stacks.AlgebraicGeometry.TopDegreeBaseChange.isZero_rightDerived_of_isColimit_cofan`, the
commutation of `H¹(X, -)` with direct sums of [Stacks, Tag 01FF].

This is `Stacks.AlgebraicGeometry.TopDegreeBaseChange`
`.isZero_rightDerivedPlus_one_of_generatingSections` with the coproduct of copies of `𝒪_X` there
replaced by a coproduct of copies of an arbitrary quasi-coherent `𝒩`, which is what the second
case of the source's clause (3) needs: there the surjection comes from `⨁_{i ∈ I} 𝒪_X(-1)`. The
vanishing of `H²` is asked for on all quasi-coherent modules rather than on `ker π` alone for the
reason recorded there: the two spellings of the module category carry different `HasKernel`
instances. -/
theorem isZero_rightDerivedPlus_one_of_epi_of_isColimit_cofan {X : Scheme.{u}}
    [CompactSpace (X : Type u)] [QuasiSeparatedSpace (X : Type u)] {J : Type u}
    {N : X.Modules} (c : Cofan fun _ : J => N) (hc : IsColimit c) (hNqc : N.IsQuasicoherent)
    (hN : IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerivedPlus 1).obj
      N))
    (F : X.Modules) [F.IsQuasicoherent] (π : c.pt ⟶ F) (hπ : Epi π)
    (h₂ : ∀ G : X.Modules, G.IsQuasicoherent →
      IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerivedPlus 2).obj G)) :
    IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerivedPlus 1).obj F) := by
  have := hπ
  have hpt : c.pt.IsQuasicoherent :=
    Stacks.AlgebraicGeometry.QuasicoherentColimits.isQuasicoherent_of_isColimit
      (D := Discrete.functor fun _ : J => N) (fun _ => hNqc) hc
  have e : (Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerived 1 ≅
      (Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerivedPlus ((1 : ℕ) : ℤ) :=
    Stacks.DerivedIndexing.rightDerivedIso
      (Stacks.Cohomology.AffineBase.moduleGlobalSections X) 1
  have hmid : IsZero
      (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerivedPlus 1).obj c.pt) :=
    IsZero.of_iso
      (Stacks.AlgebraicGeometry.TopDegreeBaseChange.isZero_rightDerived_of_isColimit_cofan X 1 c hc
        (IsZero.of_iso hN (e.app N))) (e.app c.pt).symm
  have hS : (ShortComplex.mk (kernel.ι π) π (kernel.condition π)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ (kernelIsKernel π))
      (mono_of_isLimit_fork (c := Fork.ofι _ _) (kernelIsKernel π)) hπ
  have hqc : (kernel π).IsQuasicoherent :=
    (_root_.SheafOfModules.isQuasicoherent X.ringCatSheaf).prop_kernel π hpt ‹F.IsQuasicoherent›
  exact Stacks.AlgebraicGeometry.TopDegreeBaseChange.isZero_rightDerivedPlus_one_of_shortExact hS
    hmid (h₂ _ hqc)

end Devissage

section TwoGenerators

variable {A : Type u} [CommRing A] [IsNoetherianRing A] {I : Ideal A}

/-- `H^p(X, ℱ) = 0` iff the `p`-th right derived functor of global sections vanishes on `ℱ`. -/
private theorem isZero_rightDerivedPlus_iff_isZero_hgroup {X : Scheme.{u}} (p : ℕ)
    (G : X.Modules) :
    IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerivedPlus p).obj G) ↔
      IsZero (Hgroup X.ringCatSheaf ⊤ p G) :=
  (Stacks.DerivedIndexing.isZero_rightDerivedPlus_obj_iff _
    (rfl : ((p : ℕ) : ℤ) = ((p : ℕ) : ℕ)) _).trans
    (Stacks.Cohomology.CechAcyclic.isZero_rightDerived_evaluation_iff_isZero_Hgroup
      X.ringCatSheaf ⊤ p G)

/-- **`H¹(X, 𝒪_X(n)) = 0` for `n ≥ -1`** on the blowup of `Spec A` in an ideal generated by two
elements. -/
theorem isZero_hgroup_one_twistingSheaf_of_two_generators
    (x : Fin 2 → A) (hx : ∀ j, x j ∈ I) (hspan : I = Ideal.span (Set.range x))
    {n : ℤ} (hn : -1 ≤ n) :
    IsZero (Hgroup (blowUpSpec I).ringCatSheaf ⊤ 1 (twistingSheaf (reesGrading I) n)) := by
  have : IsClosedImmersion (blowUpSpecToProjSpace I x hx hspan) :=
    isClosedImmersion_blowUpSpecToProjSpace I x hx hspan
  refine isZero_Hgroup_of_isZero_Hgroup_pushforward (blowUpSpecToProjSpace I x hx hspan)
    (twistingSheaf (reesGrading I) n)
    (Stacks.AlgebraicGeometry.Tag0B5QUniformTwistBound.isQuasicoherent_twistingSheaf
      (reesGrading I) n) 1 ?_
  refine IsZero.of_iso ?_
    ((Hfunctor (AlgebraicGeometry.Proj (polyGrading A 1)).ringCatSheaf ⊤ 1).mapIso
      (pushforwardUnitTensorIso (blowUpSpecToProjSpace I x hx hspan)
        (twistingSheaf (polyGrading A 1) n) (twistingSheaf (reesGrading I) n)
        (blowUpSpecToProjSpacePullbackTwistIso I x hx hspan n)).symm)
  have : Epi (projSpaceQuotientMap x hx hspan) := epi_projSpaceQuotientMap x hx hspan
  have hse : (ShortComplex.mk (kernel.ι (projSpaceQuotientMap x hx hspan))
      (projSpaceQuotientMap x hx hspan) (kernel.condition _)).ShortExact :=
    ShortComplex.shortExact_mk_kernel_ι _
  have hseT :=
    Stacks.AlgebraicGeometry.TwistFlatness.shortExact_map_twistFunctor_of_adjoin_degree_one
      (polyGrading A 1)
      (Stacks.ProjectiveSpace.SerreVanishing.adjoin_range_one_polyGrading A 1) n hse
  refine Stacks.Coherent.isZero_Hgroup_X₃_of_shortExact
    (AlgebraicGeometry.Proj (polyGrading A 1)) hseT 1 Nat.one_pos ?_ ?_
  · have h := Stacks.ProjectiveSpace.Cohomology.isZero_lineCohomology_one_of_neg_one_le A hn
    have h' : IsZero (Hgroup (AlgebraicGeometry.Proj (polyGrading A 1)).ringCatSheaf ⊤ 1
        (twistingSheaf (polyGrading A 1) n)) :=
      (Stacks.Cohomology.CechAcyclic.isZero_rightDerived_evaluation_iff_isZero_Hgroup
        (AlgebraicGeometry.Proj (polyGrading A 1)).ringCatSheaf ⊤ 1
        (twistingSheaf (polyGrading A 1) n)).1 h
    have e : twistSheafOfModules (polyGrading A 1)
        (SheafOfModules.unit (AlgebraicGeometry.Proj (polyGrading A 1)).ringCatSheaf) n ≅
        twistingSheaf (polyGrading A 1) n := λ_ (twistingSheaf (polyGrading A 1) n)
    exact h'.of_iso ((Hfunctor (AlgebraicGeometry.Proj (polyGrading A 1)).ringCatSheaf ⊤ 1).mapIso
      e)
  · have : _root_.SheafOfModules.IsCoherent (kernel (projSpaceQuotientMap x hx hspan)) :=
      isCoherent_kernel_projSpaceQuotientMap x hx hspan
    have hq : _root_.SheafOfModules.IsQuasicoherent (kernel (projSpaceQuotientMap x hx hspan)) :=
      isQuasicoherent_of_isCoherent _
    have : _root_.SheafOfModules.IsQuasicoherent
        (R := (AlgebraicGeometry.Proj (polyGrading A 1)).ringCatSheaf)
        (twistSheafOfModules (polyGrading A 1)
          (kernel (projSpaceQuotientMap x hx hspan)) n) :=
      Stacks.AlgebraicGeometry.Tag0B5QUniformTwistBound.isQuasicoherent_twistSheafOfModules
        (polyGrading A 1) (kernel (projSpaceQuotientMap x hx hspan)) hq n
    exact isZero_Hgroup_proj_of_lt A 1
      (twistSheafOfModules (polyGrading A 1) (kernel (projSpaceQuotientMap x hx hspan)) n) 2
      one_lt_two

omit [IsNoetherianRing A] in
/-- **`H^p(X, ℱ) = 0` for `p ≥ 2`** on the blowup of `Spec A` in an ideal generated by two
elements, for every quasi-coherent `ℱ`. Transported along the closed immersion into `𝐏¹_A` from
the cohomological dimension of the projective line. -/
theorem isZero_hgroup_of_two_le_of_two_generators
    (x : Fin 2 → A) (hx : ∀ j, x j ∈ I) (hspan : I = Ideal.span (Set.range x))
    (F : (blowUpSpec I).Modules) [F.IsQuasicoherent] (p : ℕ) (hp : 2 ≤ p) :
    IsZero (Hgroup (blowUpSpec I).ringCatSheaf ⊤ p F) := by
  have : IsClosedImmersion (blowUpSpecToProjSpace I x hx hspan) :=
    isClosedImmersion_blowUpSpecToProjSpace I x hx hspan
  refine isZero_Hgroup_of_isZero_Hgroup_pushforward (blowUpSpecToProjSpace I x hx hspan) F
    inferInstance p ?_
  exact isZero_Hgroup_proj_of_lt A 1
    ((Scheme.Modules.pushforward (blowUpSpecToProjSpace I x hx hspan)).obj F) p hp

/-- `H²` of every quasi-coherent module on the blowup vanishes, in the `rightDerivedPlus` form. -/
private theorem isZero_rightDerivedPlus_two_blowUpSpec {A : Type u} [CommRing A] {I : Ideal A}
    (x : Fin 2 → A) (hx : ∀ j, x j ∈ I) (hspan : I = Ideal.span (Set.range x))
    (G : (blowUpSpec I).Modules) (hG : G.IsQuasicoherent) :
    IsZero (((Stacks.Cohomology.AffineBase.moduleGlobalSections (blowUpSpec I)).rightDerivedPlus
      2).obj G) :=
  have := hG
  (isZero_rightDerivedPlus_iff_isZero_hgroup 2 G).2
    (isZero_hgroup_of_two_le_of_two_generators x hx hspan G 2 le_rfl)

/-- **`H¹(X, ℱ) = 0` for a globally generated quasi-coherent `ℱ`** on the blowup of `Spec A` in
an ideal generated by two elements.

Global generation is `SheafOfModules.GeneratingSections`: a family of global sections whose
associated morphism out of the free module on them is an epimorphism. -/
theorem isZero_hgroup_one_of_generatingSections_of_two_generators
    (x : Fin 2 → A) (hx : ∀ j, x j ∈ I) (hspan : I = Ideal.span (Set.range x))
    (F : (blowUpSpec I).Modules) [F.IsQuasicoherent]
    (σ : _root_.SheafOfModules.GeneratingSections F) :
    IsZero (Hgroup (blowUpSpec I).ringCatSheaf ⊤ 1 F) := by
  have : CompactSpace (blowUpSpec I) :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace (toSpec I)
  have : QuasiSeparatedSpace (blowUpSpec I) :=
    AlgebraicGeometry.quasiSeparatedSpace_of_quasiSeparated (toSpec I)
  have hunit : IsZero (Hgroup (blowUpSpec I).ringCatSheaf ⊤ 1
      (SheafOfModules.unit (blowUpSpec I).ringCatSheaf)) := by
    refine (isZero_hgroup_one_twistingSheaf_of_two_generators x hx hspan
      (n := 0) (by norm_num)).of_iso ?_
    exact (Hfunctor (blowUpSpec I).ringCatSheaf ⊤ 1).mapIso
      (Stacks.AlgebraicGeometry.ProjEulerSequence.twistingSheafZeroIsoUnit (reesGrading I)).symm
  refine (isZero_rightDerivedPlus_iff_isZero_hgroup 1 F).1 ?_
  refine
    Stacks.AlgebraicGeometry.TopDegreeBaseChange.isZero_rightDerivedPlus_one_of_generatingSections
      F σ ?_ ?_
  · exact (isZero_rightDerivedPlus_iff_isZero_hgroup 1 _).2 hunit
  · exact isZero_rightDerivedPlus_two_blowUpSpec x hx hspan

/-- **`H¹(X, ℱ) = 0` for a quasi-coherent `ℱ` with `ℱ(1)` globally generated** on the blowup of
`Spec A` in an ideal generated by two elements.

The source finds a surjection `⨁_{i ∈ I} 𝒪_X(-1) ⟶ ℱ` and repeats the dévissage of the first
case with `H¹(X, 𝒪_X(-1)) = 0`, which is part (2) at `n = -1`. The surjection is produced here by
the autoequivalence `T = - ⊗ 𝒪_X(1)` of the module sheaves — the Rees algebra is generated in
degree one, so `𝒪_X(1)` is invertible and
`Stacks.AlgebraicGeometry.TwistFlatness.isEquivalence_twistFunctor_of_adjoin_degree_one`
applies — used in reverse: `T⁻¹` carries the given epimorphism
`σ.π : ⨁_{i ∈ I} 𝒪_X ⟶ ℱ(1) = T ℱ` to an epimorphism `T⁻¹(⨁_{i ∈ I} 𝒪_X) ⟶ T⁻¹ T ℱ ≅ ℱ`, the
last isomorphism being the unit of the equivalence; and `T⁻¹`, preserving colimits, carries the
presentation of `SheafOfModules.free` as a coproduct of copies of `𝒪_X` to a presentation of its
source as a coproduct of copies of `T⁻¹𝒪_X`, which is `𝒪_X(-1)` because the multiplication
`𝒪_X(-1) ⊗ 𝒪_X(1) ⟶ 𝒪_X(0)` is an isomorphism
(`Stacks.AlgebraicGeometry.ProjRepresentsF1.isIso_twistMultiplicationMap_of_adjoin`) and
`𝒪_X(0) ≅ 𝒪_X`. Going through `T⁻¹` rather than through the twist by `-1` is what makes an
addition law for the twists unnecessary.

That coproduct is quasi-coherent, quasi-coherence being closed under colimits, so
`isZero_rightDerivedPlus_one_of_epi_of_isColimit_cofan` applies with `𝒩 = T⁻¹𝒪_X`. -/
theorem isZero_hgroup_one_of_generatingSections_twist_of_two_generators
    (x : Fin 2 → A) (hx : ∀ j, x j ∈ I) (hspan : I = Ideal.span (Set.range x))
    (F : (blowUpSpec I).Modules) [F.IsQuasicoherent]
    (σ : _root_.SheafOfModules.GeneratingSections (twistSheafOfModules (reesGrading I) F 1)) :
    IsZero (Hgroup (blowUpSpec I).ringCatSheaf ⊤ 1 F) := by
  have : CompactSpace (blowUpSpec I) :=
    AlgebraicGeometry.QuasiCompact.compactSpace_of_compactSpace (toSpec I)
  have : QuasiSeparatedSpace (blowUpSpec I) :=
    AlgebraicGeometry.quasiSeparatedSpace_of_quasiSeparated (toSpec I)
  have hrange : (Set.range fun f : reesGrading I 1 => (f : reesAlgebra I))
      = ((reesGrading I 1 : Submodule A (reesAlgebra I)) : Set (reesAlgebra I)) :=
    Set.ext fun y => ⟨fun ⟨f, hf⟩ => hf ▸ f.2, fun hy => ⟨⟨y, hy⟩, rfl⟩⟩
  have : (twistFunctor (reesGrading I) 1).IsEquivalence :=
    Stacks.AlgebraicGeometry.TwistFlatness.isEquivalence_twistFunctor_of_adjoin_degree_one
      (reesGrading I) (by rw [hrange]; exact adjoin_reesGradingZero_reesGrading_one_eq_top I) 1
  have hchi : twistSheafOfModules (reesGrading I) (twistingSheaf (reesGrading I) (-1)) 1 ≅
      _root_.SheafOfModules.unit (blowUpSpec I).ringCatSheaf :=
    (@asIso _ _ _ _
      (Stacks.AlgebraicGeometry.ProjInvertibleLocus.twistMultiplicationMap
        (reesGrading I) (-1) 1)
      (Stacks.AlgebraicGeometry.ProjRepresentsF1.isIso_twistMultiplicationMap_of_adjoin
        (reesGrading I) (adjoin_reesGradingZero_reesGrading_one_eq_top I) (-1) 1)) ≪≫
      eqToIso (congrArg (fun e : ℤ => twistingSheaf (reesGrading I) e)
        (show (-1 : ℤ) + 1 = 0 by norm_num)) ≪≫
      Stacks.AlgebraicGeometry.ProjEulerSequence.twistingSheafZeroIsoUnit (reesGrading I)
  have hpsi : twistingSheaf (reesGrading I) (-1) ≅
      (twistFunctor (reesGrading I) 1).asEquivalence.inverse.obj
        (_root_.SheafOfModules.unit (blowUpSpec I).ringCatSheaf) :=
    (twistFunctor (reesGrading I) 1).asEquivalence.unitIso.app
        (twistingSheaf (reesGrading I) (-1)) ≪≫
      (twistFunctor (reesGrading I) 1).asEquivalence.inverse.mapIso hchi
  have hNqc : ((twistFunctor (reesGrading I) 1).asEquivalence.inverse.obj
      (_root_.SheafOfModules.unit (blowUpSpec I).ringCatSheaf)).IsQuasicoherent :=
    (_root_.SheafOfModules.isQuasicoherent (blowUpSpec I).ringCatSheaf).prop_of_iso hpsi
      (Stacks.AlgebraicGeometry.Tag0B5QUniformTwistBound.isQuasicoherent_twistingSheaf
        (reesGrading I) (-1))
  have hpres : PreservesColimitsOfSize.{u, u}
      (twistFunctor (reesGrading I) 1).asEquivalence.inverse :=
    Adjunction.leftAdjoint_preservesColimits
      (twistFunctor (reesGrading I) 1).asEquivalence.symm.toAdjunction
  have : (twistFunctor (reesGrading I) 1).asEquivalence.inverse.PreservesEpimorphisms :=
    Functor.preservesEpimorphisms_of_adjunction
      (twistFunctor (reesGrading I) 1).asEquivalence.symm.toAdjunction
  have hc := @isColimitCofanMkObjOfIsColimit _ _ _ _
    (twistFunctor (reesGrading I) 1).asEquivalence.inverse σ.I
    (fun _ : σ.I => _root_.SheafOfModules.unit (blowUpSpec I).ringCatSheaf)
    hpres.preservesColimitsOfShape.preservesColimit _
    (fun i => _root_.SheafOfModules.ιFree i)
    (_root_.SheafOfModules.isColimitFreeCofan (R := (blowUpSpec I).ringCatSheaf) σ.I)
  have hepi : Epi ((twistFunctor (reesGrading I) 1).asEquivalence.inverse.map σ.π ≫
      ((twistFunctor (reesGrading I) 1).asEquivalence.unitIso.app F).inv) :=
    epi_comp' (Functor.map_epi (twistFunctor (reesGrading I) 1).asEquivalence.inverse σ.π)
      (@IsIso.epi_of_iso _ _ _ _ _ (Iso.isIso_inv _))
  refine (isZero_rightDerivedPlus_iff_isZero_hgroup 1 F).1 ?_
  refine isZero_rightDerivedPlus_one_of_epi_of_isColimit_cofan _ hc hNqc ?_ F _ hepi ?_
  · refine (isZero_rightDerivedPlus_iff_isZero_hgroup 1 _).2 ?_
    exact (isZero_hgroup_one_twistingSheaf_of_two_generators x hx hspan
      (n := -1) le_rfl).of_iso
      ((Hfunctor (blowUpSpec I).ringCatSheaf ⊤ 1).mapIso hpsi.symm)
  · exact isZero_rightDerivedPlus_two_blowUpSpec x hx hspan

end TwoGenerators

/-- **Stacks Project, Tag 0AGS part (2).** Let `(A, 𝔪, κ)` be a regular local ring of dimension
two and let `f : X ⟶ S = Spec A` be the blowing up of `A` in `𝔪`. Then

`H¹(X, 𝒪_X(n)) = 0` for every `n ≥ -1`.

The maximal ideal of a two-dimensional regular local ring is generated by two elements, so
`Stacks.Blowup.isZero_hgroup_one_twistingSheaf_of_two_generators` applies. -/
@[stacks 0AGS "part (2): H^1(X, O_X(n)) = 0 for n at least -1"]
theorem isZero_hgroup_one_twistingSheaf_maximalIdeal (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) {n : ℤ} (hn : -1 ≤ n) :
    IsZero (Hgroup (blowUpSpec (IsLocalRing.maximalIdeal A)).ringCatSheaf ⊤ 1
      (twistingSheaf (reesGrading (IsLocalRing.maximalIdeal A)) n)) := by
  obtain ⟨x, hx⟩ := exists_range_eq_maximalIdeal A hdim
  exact isZero_hgroup_one_twistingSheaf_of_two_generators x
    (fun j => hx ▸ Ideal.subset_span (Set.mem_range_self j)) hx hn

/-- **Stacks Project, Tag 0AGS part (3), the globally generated case.** Let `(A, 𝔪, κ)` be a
regular local ring of dimension two and let `f : X ⟶ S = Spec A` be the blowing up of `A` in
`𝔪`. If a quasi-coherent `𝒪_X`-module `ℱ` is globally generated then `H¹(X, ℱ) = 0`.

Global generation is `SheafOfModules.GeneratingSections`: a family of global sections whose
associated morphism out of the free module on them is an epimorphism. This is the first of the
two cases of the source's clause; the second is
`Stacks.Blowup.isZero_hgroup_one_of_generatingSections_twist_maximalIdeal`, and the clause itself
is `Stacks.Blowup.isZero_hgroup_one_of_generatingSections_or_twist_maximalIdeal`. -/
@[stacks 0AGS "part (3), the case where F itself is globally generated"]
theorem isZero_hgroup_one_of_generatingSections_maximalIdeal (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2)
    (F : (blowUpSpec (IsLocalRing.maximalIdeal A)).Modules) [F.IsQuasicoherent]
    (σ : _root_.SheafOfModules.GeneratingSections F) :
    IsZero (Hgroup (blowUpSpec (IsLocalRing.maximalIdeal A)).ringCatSheaf ⊤ 1 F) := by
  obtain ⟨x, hx⟩ := exists_range_eq_maximalIdeal A hdim
  exact isZero_hgroup_one_of_generatingSections_of_two_generators x
    (fun j => hx ▸ Ideal.subset_span (Set.mem_range_self j)) hx F σ

/-- **Stacks Project, Tag 0AGS part (3), the case where `ℱ(1)` is globally generated.** Let
`(A, 𝔪, κ)` be a regular local ring of dimension two and let `f : X ⟶ S = Spec A` be the blowing
up of `A` in `𝔪`. If `ℱ` is a quasi-coherent `𝒪_X`-module whose twist `ℱ(1)` is globally
generated then `H¹(X, ℱ) = 0`.

The maximal ideal of a two-dimensional regular local ring is generated by two elements, so
`Stacks.Blowup.isZero_hgroup_one_of_generatingSections_twist_of_two_generators` applies. -/
@[stacks 0AGS "part (3), the case where F(1) is globally generated"]
theorem isZero_hgroup_one_of_generatingSections_twist_maximalIdeal (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2)
    (F : (blowUpSpec (IsLocalRing.maximalIdeal A)).Modules) [F.IsQuasicoherent]
    (σ : _root_.SheafOfModules.GeneratingSections
      (twistSheafOfModules (reesGrading (IsLocalRing.maximalIdeal A)) F 1)) :
    IsZero (Hgroup (blowUpSpec (IsLocalRing.maximalIdeal A)).ringCatSheaf ⊤ 1 F) := by
  obtain ⟨x, hx⟩ := exists_range_eq_maximalIdeal A hdim
  exact isZero_hgroup_one_of_generatingSections_twist_of_two_generators x
    (fun j => hx ▸ Ideal.subset_span (Set.mem_range_self j)) hx F σ

/-- **Stacks Project, Tag 0AGS part (3).** Let `(A, 𝔪, κ)` be a regular local ring of dimension
two and let `f : X ⟶ S = Spec A` be the blowing up of `A` in `𝔪`. Then, for a quasi-coherent
`𝒪_X`-module `ℱ`,

`H¹(X, ℱ) = 0` if `ℱ` or `ℱ(1)` is globally generated.

The two cases are
`Stacks.Blowup.isZero_hgroup_one_of_generatingSections_maximalIdeal` and
`Stacks.Blowup.isZero_hgroup_one_of_generatingSections_twist_maximalIdeal`. Global generation of
a module sheaf is the existence of a `SheafOfModules.GeneratingSections` for it — a family of
global sections whose associated morphism out of the free module on them is an epimorphism — and
since that is data rather than a proposition the disjunction is taken between its two
`Nonempty`s. -/
@[stacks 0AGS "part (3): H^1(X,F) = 0 if F or F(1) is globally generated"]
theorem isZero_hgroup_one_of_generatingSections_or_twist_maximalIdeal (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2)
    (F : (blowUpSpec (IsLocalRing.maximalIdeal A)).Modules) [F.IsQuasicoherent]
    (hσ : Nonempty (_root_.SheafOfModules.GeneratingSections F) ∨
      Nonempty (_root_.SheafOfModules.GeneratingSections
        (twistSheafOfModules (reesGrading (IsLocalRing.maximalIdeal A)) F 1))) :
    IsZero (Hgroup (blowUpSpec (IsLocalRing.maximalIdeal A)).ringCatSheaf ⊤ 1 F) := by
  rcases hσ with h | h
  · exact h.elim (isZero_hgroup_one_of_generatingSections_maximalIdeal A hdim F)
  · exact h.elim (isZero_hgroup_one_of_generatingSections_twist_maximalIdeal A hdim F)

end Stacks.Blowup

