module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.Vanishing.RegularLocalBlowup
public import StacksFrontier.AlgebraicGeometry.Blowup.ProjectiveLineTwistVanishing

/-!
# Vanishing of `H¹` on the blowup of a regular local surface

Let `(A, 𝔪, κ)` be a regular local ring of dimension two and
`X = Stacks.Blowup.blowUpSpec 𝔪 = Proj(⨁ₙ 𝔪ⁿ)` the blowup of `Spec A` in `𝔪`. This file proves
parts (2) and (3), the latter for a globally generated module, of [Stacks, Tag 0AGS]; part (1) is
`AlgebraicGeometry.isZero_cohomology_of_two_le`.

## Main results

* `AlgebraicGeometry.isZero_cohomology_one_twistingSheaf_of_neg_one_le`: `H¹(X, 𝒪_X(n)) = 0` for
  `n ≥ -1`.
* `AlgebraicGeometry.isZero_cohomology_one_of_generatingSections`: `H¹(X, ℱ) = 0` for `ℱ`
  quasi-coherent and globally generated.

## References

* [Stacks Project, Tag 0AGS](https://stacks.math.columbia.edu/tag/0AGS)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open scoped Pointwise DirectSum

namespace AlgebraicGeometry

universe u v w

/-- For `(A, 𝔪, κ)` a regular local ring of dimension two and
`X = Stacks.Blowup.blowUpSpec 𝔪 = Proj(⨁ₙ 𝔪ⁿ)` the blowup of `Spec A` in `𝔪`,
`H¹(X, 𝒪_X(n)) = 0` for every `n ≥ -1`. -/
@[stacks 0AGS "part (2)"]
public theorem isZero_cohomology_one_twistingSheaf_of_neg_one_le
    (A : Type u) [CommRing A] [IsRegularLocalRing A] (hdim : ringKrullDim A = 2)
    (n : ℤ) (hn : -1 ≤ n) :
    IsZero (_root_.Hgroup
      (Stacks.Blowup.blowUpSpec (IsLocalRing.maximalIdeal A)).ringCatSheaf ⊤ 1
      (ProjectiveSpectrum.Proj.twistingSheaf
        (Stacks.Blowup.reesGrading (IsLocalRing.maximalIdeal A)) n)) :=
  Stacks.Blowup.isZero_Hgroup_one_twistingSheaf_reesGrading_of_two_generators
    (Stacks.Blowup.exists_range_eq_maximalIdeal A hdim) n hn

/-- For `(A, 𝔪, κ)` a regular local ring of dimension two, `X = Stacks.Blowup.blowUpSpec 𝔪` the
blowup of `Spec A` in `𝔪` and `ℱ` a quasi-coherent `𝒪_X`-module generated by global sections
(`SheafOfModules.GeneratingSections`), `H¹(X, ℱ) = 0`. -/
@[stacks 0AGS "part (3), for a globally generated quasi-coherent module"]
public theorem isZero_cohomology_one_of_generatingSections
    (A : Type u) [CommRing A] [IsRegularLocalRing A] (hdim : ringKrullDim A = 2)
    (F : (Stacks.Blowup.blowUpSpec (IsLocalRing.maximalIdeal A)).Modules)
    (hF : F.IsQuasicoherent) (σ : F.GeneratingSections) :
    IsZero (_root_.Hgroup
      (Stacks.Blowup.blowUpSpec (IsLocalRing.maximalIdeal A)).ringCatSheaf ⊤ 1 F) :=
  Stacks.Blowup.isZero_Hgroup_one_of_generatingSections
    (Stacks.Blowup.exists_range_eq_maximalIdeal A hdim) F hF σ

end AlgebraicGeometry

end
