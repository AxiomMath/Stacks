module

public import Mathlib.Algebra.Module.Torsion.Basic
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.Boundedness.Reduction
public import StacksFrontier.RingTheory.Dualizing.ResidueFieldHull.Matlis

/-!
# Annihilating a Matlis dual annihilates the module, and bounds first cohomology

Let `(A, 𝔪, κ)` be a local ring and let `E` be an injective hull of `κ`. The Matlis dual of an
`A`-module `M` is `Hom_A(M, E)`. Because `E` is an injective cogenerator for `A`-modules, the
Matlis dual detects elements: a nonzero `y ∈ M` admits a map `M ⟶ E` not vanishing at `y`.
Consequently, if `d ∈ A` annihilates `Hom_A(M, E)`, then `d` annihilates `M`.

This is the step of the argument for [Stacks, Tag 0B4S] which carries the annihilation of the
cokernel of the trace map across local duality: there the cokernel of
`Γ(X, ω_X) → ω_A` is identified with `Ext²_A(H¹(X, 𝒪_X), ω_A)`, which local duality identifies
with the Matlis dual of `H¹(X, 𝒪_X)`, and it is the lemma below which turns `d` annihilating
that dual into `d` annihilating `H¹(X, 𝒪_X)` itself.

## Main results

* `Dualizing.exists_hom_apply_ne_zero_of_isInjectiveHull`: an injective hull of the residue
  field of a local ring is a cogenerator — every nonzero element of a module is detected by a
  map into it.
* `Dualizing.smul_eq_zero_of_matlisDual_smul_eq_zero`: if a ring element annihilates the Matlis
  dual of a module, it annihilates the module.
* `isReductionToRationalSingularitiesPossible_of_matlisDual_smul_eq_zero`, in the namespace
  `Stacks.ResolutionOfSurfaces`, combines the previous lemma with a bound on the lengths of the
  `d`-torsion submodules of `H¹(X, 𝒪_X)` to conclude that reduction to rational singularities is
  possible.

## Implementation notes

The cogenerator property is proved from the definition of an injective hull rather than from
Matlis duality: `y ≠ 0` gives an injection `A/J ↪ M` with `J` the annihilator of `y`, `J` lies
in `𝔪` because `1 ∉ J`, so `A/J` surjects onto `κ`, and the composite `A/J → κ ⟶ E` extends
along the injection by injectivity of `E`. This avoids the completeness hypothesis that the
biduality theorems `Dualizing.isIso_matlisEvaluation_of_isArtinian` and
`Dualizing.isIso_matlisEvaluation_of_isNoetherian` carry.

In the argument of [Stacks, Tag 0B4S] the trace map `Γ(X, ω_X) → ω_A` of a normal modification
`X → Spec A` arises from the counit `Rf_* ω_X^• ⟶ ω_A^•` of `Rf_* ⊣ f^!` once
`Rf_* ω_X = f_* ω_X`, by Grauert-Riemenschneider ([Stacks, Tag 0AXD]); its cokernel is then
identified with the Matlis dual of `H¹(X, 𝒪_X)` by local duality, using that `ω_X^•` is
normalized relative to `ω_A^•`. The statement below takes that identification as given, so its
hypotheses are the annihilation of that dual by `d` together with the uniform bound on the
lengths of the `d`-torsion submodules of `H¹(X, 𝒪_X)` ([Stacks, Tags 0AXJ] and [0AXK]).

## References

* [Stacks Project, Tag 0B4S](https://stacks.math.columbia.edu/tag/0B4S)
* [Stacks Project, Tag 08Z9](https://stacks.math.columbia.edu/tag/08Z9)
-/

@[expose] public noncomputable section

open CategoryTheory

universe u v

namespace Dualizing

/-- An injective hull `E` of the residue field of a local ring `R` is a cogenerator: a nonzero
element of an `R`-module `M` is not killed by every map `M ⟶ E`.

The map is built on the cyclic submodule generated by `y`: writing `J` for the annihilator of
`y`, the quotient `R ⧸ J` injects into `M` with `1` going to `y`, and `J ≤ 𝔪` because `1 ∉ J`,
so `R ⧸ J` carries a map to the residue field sending `1` to `1`. Composing with `E`'s copy of
the residue field and extending along the injection by injectivity of `E` gives the map. -/
theorem exists_hom_apply_ne_zero_of_isInjectiveHull (R : Type u) [CommRing R] [IsLocalRing R]
    (E : ModuleCat.{max u v} R) (i : residueFieldModule.{u, v} R ⟶ E) [Mono i]
    (hi : Module.IsInjectiveHull i) (M : ModuleCat.{max u v} R) (y : M) (hy : y ≠ 0) :
    ∃ φ : M ⟶ E, φ.hom y ≠ 0 := by
  classical
  let t : R →ₗ[R] M := LinearMap.toSpanSingleton R M y
  let J : Ideal R := LinearMap.ker t
  have hJm : J ≤ IsLocalRing.maximalIdeal R := IsLocalRing.le_maximalIdeal fun h => hy <| by
    simpa [J, t] using (h ▸ Submodule.mem_top : (1 : R) ∈ J)
  have hker : J ≤ LinearMap.ker (Algebra.linearMap R (IsLocalRing.ResidueField R)) :=
    fun a ha => (IsLocalRing.residue_eq_zero_iff a).mpr (hJm ha)
  let Q : ModuleCat.{max u v} R := ModuleCat.of R (ULift.{v} (R ⧸ J))
  let e : (ULift.{v} (R ⧸ J)) →ₗ[R] (R ⧸ J) := ULift.moduleEquiv.toLinearMap
  let ql : (R ⧸ J) →ₗ[R] M := J.liftQ t le_rfl
  let qm : Q ⟶ M := ModuleCat.ofHom (ql ∘ₗ e)
  have hliftinj : Function.Injective ql := by
    rw [← LinearMap.ker_eq_bot, Submodule.ker_liftQ_eq_bot]
    exact le_rfl
  have : Mono qm :=
    (ModuleCat.mono_iff_injective (R := R) _).mpr
      (fun _ _ hab => ULift.moduleEquiv.injective (hliftinj hab))
  let up : IsLocalRing.ResidueField R →ₗ[R] (residueFieldModule.{u, v} R) :=
    ULift.moduleEquiv.symm.toLinearMap
  let rl : (R ⧸ J) →ₗ[R] E :=
    i.hom ∘ₗ up ∘ₗ (J.liftQ (Algebra.linearMap R (IsLocalRing.ResidueField R)) hker)
  let rm : Q ⟶ E := ModuleCat.ofHom (rl ∘ₗ e)
  have : Injective E := hi.1
  obtain ⟨h, hh⟩ := Injective.factors (J := E) rm qm
  refine ⟨h, ?_⟩
  let w : R ⧸ J := Submodule.Quotient.mk (1 : R)
  let z : ULift.{v} (R ⧸ J) := ULift.up w
  have hy' : qm.hom z = y := by
    change J.liftQ t le_rfl (Submodule.Quotient.mk (1 : R)) = y
    rw [Submodule.liftQ_apply]
    simp [t]
  have key := congrArg (fun (f : Q ⟶ E) => f.hom z) hh
  simp only [ModuleCat.hom_comp, LinearMap.coe_comp, Function.comp_apply] at key
  rw [← hy', key]
  change rl w ≠ 0
  intro hzero
  have h1 : up (1 : IsLocalRing.ResidueField R) = 0 := by
    refine (ModuleCat.mono_iff_injective i).mp inferInstance
      (a₁ := up (1 : IsLocalRing.ResidueField R)) (a₂ := 0) ?_
    simp only [rl, w, LinearMap.comp_apply, Submodule.liftQ_apply] at hzero
    simpa using hzero
  exact one_ne_zero (ULift.moduleEquiv.symm.injective (h1.trans (map_zero up).symm))

/-- If `d` annihilates the Matlis dual `Hom_R(M, E)` of an `R`-module `M`, with `E` an injective
hull of the residue field of the local ring `R`, then `d` annihilates `M`.

This is the direction of Matlis duality that the proof of [Stacks, Tag 0B4S] uses to pass from
annihilation of `Ext²_A(H¹(X, 𝒪_X), ω_A)` to annihilation of `H¹(X, 𝒪_X)`. -/
theorem smul_eq_zero_of_matlisDual_smul_eq_zero (R : Type u) [CommRing R] [IsLocalRing R]
    (E : ModuleCat.{max u v} R) (i : residueFieldModule.{u, v} R ⟶ E) [Mono i]
    (hi : Module.IsInjectiveHull i) (M : ModuleCat.{max u v} R) (d : R)
    (hd : ∀ φ : (ModuleCat.of R (M ⟶ E) : ModuleCat.{max u v} R), d • φ = 0) (x : M) :
    d • x = 0 := by
  by_contra hx
  obtain ⟨φ, hφ⟩ := exists_hom_apply_ne_zero_of_isInjectiveHull.{u, v} R E i hi M (d • x) hx
  refine hφ ?_
  rw [map_smul, show d • φ.hom x = (d • φ).hom x from rfl, hd φ]
  rfl

end Dualizing

namespace Stacks.ResolutionOfSurfaces

open AlgebraicGeometry

/-- Reduction to rational singularities is possible for `A` as soon as, for every normal
modification `X → Spec A`, some fixed `d ∈ A` annihilates the Matlis dual of `H¹(X, 𝒪_X)` and
the `d`-torsion submodules of `H¹(X, 𝒪_X)` have lengths bounded by a fixed `N`.

In [Stacks, Tag 0B4S] both hypotheses are consequences of a single one, that `d` annihilate the
cokernel of the trace map `Γ(X, ω_X) → ω_A`: the first follows from Grauert-Riemenschneider
([Stacks, Tag 0AXD]) with the local duality theorem ([Stacks, Tag 0AAK]), which together
identify that cokernel with the Matlis dual of `H¹(X, 𝒪_X)`, and the second from
[Stacks, Tag 0AXJ] with the identification [Stacks, Tag 0AXK]. -/
theorem isReductionToRationalSingularitiesPossible_of_matlisDual_smul_eq_zero
    (A : Type u) [CommRing A] [IsDomain A] [IsLocalRing A]
    (E : ModuleCat.{u} A) (i : Dualizing.residueFieldModule.{u, u} A ⟶ E) [Mono i]
    (hi : Module.IsInjectiveHull i) (d : A) (N : ℕ)
    (hdual : ∀ (X : Scheme.{u}) [IsNormal X] (f : X ⟶ Spec (.of A)), IsModification f →
      ∀ φ : (ModuleCat.of A (firstCohomologyAsBaseModule X f ⟶ E) : ModuleCat.{u} A),
        d • φ = 0)
    (hbound : ∀ (X : Scheme.{u}) [IsNormal X] (f : X ⟶ Spec (.of A)), IsModification f →
      Module.length A
        ↥(Submodule.torsionBy A (firstCohomologyAsBaseModule X f) d) ≤ N) :
    IsReductionToRationalSingularitiesPossible A := by
  refine ⟨N, fun X _ f hf => ?_⟩
  have htop : Submodule.torsionBy A (firstCohomologyAsBaseModule X f) d = ⊤ := by
    ext x
    simp [Submodule.mem_torsionBy_iff,
      Dualizing.smul_eq_zero_of_matlisDual_smul_eq_zero.{u, u} A E i hi _ d (hdual X f hf) x]
  have hb := hbound X f hf
  rwa [htop, Module.length_top] at hb

end Stacks.ResolutionOfSurfaces

end
