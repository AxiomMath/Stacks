module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EpiImageSubsheaf
public import StacksFrontier.AlgebraicGeometry.Scheme.QuasiCoherent.ClosedUnionExactSequence
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.Boundedness.ModificationATorsion

/-!
# The sections of `𝒪_X / a𝒪_X` as functions on the zero scheme of `a`

Let `f : X ⟶ Spec A` be a morphism of schemes and `a ∈ A`. The cokernel `𝒪_X / a𝒪_X` of
multiplication by `a` on `𝒪_X` is a sheaf of `𝒪_X`-modules with no ring structure of its own.
This file compares it with the structure sheaf of the closed subscheme `Z ⊆ X` cut out by the
ideal sheaf generated by `a`: the comparison map `𝒪_X / a𝒪_X ⟶ i_* 𝒪_Z` is injective on sections
over every open, so global sections of `𝒪_X / a𝒪_X` become functions on `Z`.

## Main definitions

* `AlgebraicGeometry.zeroSchemeIdeal`: the ideal sheaf of `X` generated by the image of `a`.
* `AlgebraicGeometry.toZeroSchemeSubscheme`: the comparison map `𝒪_X / a𝒪_X ⟶ i_* 𝒪_Z`.

## Main results

* `AlgebraicGeometry.SheafOfModules.exists_isAffineOpen_lift_of_epi`: a section of the target of
  an epimorphism of `𝒪_X`-modules lifts on an affine neighbourhood of every point.
* `AlgebraicGeometry.toZeroSchemeSubscheme_app_injective`: the comparison map is injective on
  sections over every open.

## Implementation notes

Injectivity is local. A section of the cokernel lifts, on an affine neighbourhood `W` of any
point, to a function `g` on `W`; if its image on `Z` vanishes then `g` lies in the ideal of `Z`
over `W`, which is generated by `a` because `W` is affine, so the section vanishes on `W`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

universe u

namespace AlgebraicGeometry

/-- **A section of the target of an epimorphism of `𝒪_X`-modules lifts locally**, on an affine
open neighbourhood of any given point. -/
theorem SheafOfModules.exists_isAffineOpen_lift_of_epi {X : Scheme.{u}}
    {M N : SheafOfModules.{u} X.ringCatSheaf} (p : M ⟶ N) [Epi p] {V : X.Opens}
    (s : N.val.obj (op V)) {x : X} (hx : x ∈ V) :
    ∃ (W : X.Opens) (hWV : W ≤ V), IsAffineOpen W ∧ x ∈ W ∧
      ∃ m : M.val.obj (op W), p.val.app (op W) m = N.val.map (homOfLE hWV).op s := by
  have hls := Stacks.SheafOfModules.ImageSubsheaf.isLocallySurjective_of_epi
    (C := X.Opens) (J := Opens.grothendieckTopology X) (R := X.ringCatSheaf) p
  obtain ⟨V', hV'V, ⟨m, hm⟩, hxV'⟩ := (TopCat.Presheaf.isLocallySurjective_iff _).1 hls V s x hx
  obtain ⟨W, hWmem, hxW, hWV'⟩ := (Opens.isBasis_iff_nbhd.1 X.isBasis_affineOpens) hxV'
  refine ⟨W, hWV'.trans hV'V, hWmem, hxW, M.val.map (homOfLE hWV').op m, ?_⟩
  have hm' : p.val.app (op V') m = N.val.map (homOfLE hV'V).op s := hm
  refine (ConcreteCategory.congr_hom (p.val.naturality (homOfLE hWV').op) m).trans ?_
  change N.val.map (homOfLE hWV').op (p.val.app (op V') m) = _
  rw [hm']
  exact (ConcreteCategory.congr_hom (N.val.map_comp (homOfLE hV'V).op (homOfLE hWV').op) s).symm

/-- A section of a sheaf of `𝒪_X`-modules vanishes as soon as it vanishes on a neighbourhood of
every point of the open it lives on. -/
theorem SheafOfModules.eq_zero_of_forall_nhds {X : Scheme.{u}}
    (N : SheafOfModules.{u} X.ringCatSheaf) {V : X.Opens} (s : N.val.obj (op V))
    (h : ∀ x ∈ V, ∃ (W : X.Opens) (hWV : W ≤ V), x ∈ W ∧ N.val.map (homOfLE hWV).op s = 0) :
    s = 0 := by
  refine (Scheme.Modules.isSheaf (X := X) N).section_ext (U := op V) fun x hx => ?_
  obtain ⟨W, hWV, hxW, hW⟩ := h x hx
  exact ⟨W, hWV, hxW, hW.trans (map_zero _).symm⟩

variable {A : Type u} [CommRing A] (X : Scheme.{u}) (f : X ⟶ Spec (.of A))

/-- The ideal sheaf of `X` generated by the image of an element of the base ring. -/
def zeroSchemeIdeal (a : A) : X.IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop (Ideal.span {((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom a})

/-- The image of `a` restricted to an open vanishes on the closed subscheme cut out by `a`. -/
theorem subschemeι_app_baseSection_eq_zero (a : A) (U : X.Opens) :
    (zeroSchemeIdeal X f a).subschemeι.app U
      (X.presheaf.map (homOfLE le_top).op (((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom a)) =
        0 := by
  let I := zeroSchemeIdeal X f a
  refine I.subscheme.IsSheaf.section_ext (U := op (I.subschemeι ⁻¹ᵁ U)) fun z hz => ?_
  obtain ⟨W, hWmem, hxW, hWU⟩ :=
    (Opens.isBasis_iff_nbhd.1 X.isBasis_affineOpens) (show I.subschemeι z ∈ U from hz)
  refine ⟨I.subschemeι ⁻¹ᵁ W, fun z (hz : I.subschemeι z ∈ W) => (hWU hz : I.subschemeι z ∈ U),
    hxW, ?_⟩
  let c := ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom a
  have hmem : X.presheaf.map (homOfLE (hWU.trans le_top)).op c ∈ I.ideal ⟨W, hWmem⟩ := by
    simp only [I, zeroSchemeIdeal, Scheme.IdealSheafData.ofIdealTop_ideal]
    exact Ideal.mem_map_of_mem _ (Ideal.subset_span rfl)
  have h0 : I.subschemeι.app W (X.presheaf.map (homOfLE (hWU.trans le_top)).op c) = 0 := by
    rwa [← I.ker_subschemeι_app ⟨W, hWmem⟩] at hmem
  have hres : X.presheaf.map (homOfLE hWU).op (X.presheaf.map (homOfLE le_top).op c) =
      X.presheaf.map (homOfLE (hWU.trans le_top)).op c := by
    rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
    rfl
  have key := ConcreteCategory.congr_hom (I.subschemeι.naturality (homOfLE hWU).op)
    (X.presheaf.map (homOfLE le_top).op c)
  rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply, hres, h0] at key
  rw [map_zero]
  exact key.symm

attribute [local instance] Scheme.commRingRingCatSheafObj

/-- The structure sheaf of the zero scheme of `a`, pushed forward to `X`. -/
abbrev zeroSchemeSubschemeSheaf (a : A) : SheafOfModules.{u} X.ringCatSheaf :=
  Scheme.IdealSheafData.closedSubschemeStructureSheaf (zeroSchemeIdeal X f a)

/-- Restriction of functions to the zero scheme of `a`. -/
def ambientToZeroScheme (a : A) :
    SheafOfModules.unit X.ringCatSheaf ⟶ zeroSchemeSubschemeSheaf X f a :=
  Scheme.IdealSheafData.ambientToClosedSubscheme (zeroSchemeIdeal X f a)

/-- On sections over `U`, restriction to the zero scheme of `a` is the map on sections induced by
the closed immersion of the zero scheme. -/
theorem ambientToZeroScheme_app (a : A) (U : X.Opens) (x : Γ(X, U)) :
    (ambientToZeroScheme X f a).val.app (op U) x = (zeroSchemeIdeal X f a).subschemeι.app U x :=
  rfl

/-- Multiplication by `a` followed by restriction to the zero scheme of `a` vanishes. -/
theorem baseSmulModules_comp_ambientToZeroScheme (a : A) :
    baseSmulModules X f a (SheafOfModules.unit X.ringCatSheaf) ≫ ambientToZeroScheme X f a =
      0 := by
  ext1
  ext1 U
  refine ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
  let x' : Γ(X, U.unop) := x
  change (zeroSchemeIdeal X f a).subschemeι.app U.unop
    (X.presheaf.map (homOfLE le_top).op (((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom a) *
      x') = 0
  rw [map_mul, subschemeι_app_baseSection_eq_zero, zero_mul]

/-- **The comparison map from `𝒪_X / a𝒪_X` to the structure sheaf of the zero scheme of `a`**,
induced on the cokernel by restriction of functions. -/
def toZeroSchemeSubscheme (a : A) :
    zeroSchemeStructureSheaf X f a ⟶ zeroSchemeSubschemeSheaf X f a :=
  cokernel.desc _ (ambientToZeroScheme X f a) (baseSmulModules_comp_ambientToZeroScheme X f a)

/-- The quotient map `𝒪_X ⟶ 𝒪_X / a𝒪_X` followed by the comparison map is restriction of functions
to the zero scheme of `a`. -/
theorem toZeroSchemeStructureSheaf_comp_toZeroSchemeSubscheme (a : A) :
    toZeroSchemeStructureSheaf X f a ≫ toZeroSchemeSubscheme X f a =
      ambientToZeroScheme X f a :=
  cokernel.π_desc _ _ _

/-- A function on an affine open vanishing on the zero scheme of `a` is zero in `𝒪_X / a𝒪_X`. -/
theorem toZeroSchemeStructureSheaf_app_eq_zero_of_subschemeι_app_eq_zero (a : A) {W : X.Opens}
    (hW : IsAffineOpen W) (m : (SheafOfModules.unit X.ringCatSheaf).val.obj (op W))
    (hm : (zeroSchemeIdeal X f a).subschemeι.app W m = 0) :
    (toZeroSchemeStructureSheaf X f a).val.app (op W) m = 0 := by
  let I := zeroSchemeIdeal X f a
  let π := toZeroSchemeStructureSheaf X f a
  let m' : Γ(X, W) := m
  have hmem : m' ∈ I.ideal ⟨W, hW⟩ := by
    rwa [← I.ker_subschemeι_app ⟨W, hW⟩]
  have hmem' : m' ∈ Ideal.span {X.presheaf.map (homOfLE le_top).op
      (((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom a)} := by
    simpa only [I, zeroSchemeIdeal, Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_span,
      Set.image_singleton] using hmem
  obtain ⟨u₀, hu⟩ := Ideal.mem_span_singleton'.mp hmem'
  let u : (SheafOfModules.unit X.ringCatSheaf).val.obj (op W) := u₀
  have hsmul : (baseSmulModules X f a (SheafOfModules.unit X.ringCatSheaf)).val.app (op W) u =
      m := by
    change X.presheaf.map (homOfLE le_top).op
      (((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom a) * u₀ = m'
    rwa [mul_comm]
  have h0 := ConcreteCategory.congr_hom (congrArg (fun g => g.val.app (op W))
    (cokernel.condition (baseSmulModules X f a (SheafOfModules.unit X.ringCatSheaf)))) u
  change π.val.app (op W)
    ((baseSmulModules X f a (SheafOfModules.unit X.ringCatSheaf)).val.app (op W) u) = 0 at h0
  rwa [hsmul] at h0

/-- **The comparison map is injective on sections over every open.** A section lifts on an
affine neighbourhood of each point to a function, which lies in the ideal of the zero scheme
there if its image vanishes; that ideal is generated by `a` on an affine open, so the section
vanishes there. -/
theorem toZeroSchemeSubscheme_app_injective (a : A) (V : X.Opens) :
    Function.Injective ((toZeroSchemeSubscheme X f a).val.app (op V)) := by
  let π := toZeroSchemeStructureSheaf X f a
  let ψ := toZeroSchemeSubscheme X f a
  rw [injective_iff_map_eq_zero]
  intro σ hσ
  have : Epi π := inferInstanceAs (Epi (cokernel.π _))
  refine SheafOfModules.eq_zero_of_forall_nhds (zeroSchemeStructureSheaf X f a) σ
    fun x hx => ?_
  obtain ⟨W, hWV, hWaff, hxW, m, hm⟩ := SheafOfModules.exists_isAffineOpen_lift_of_epi π σ hx
  refine ⟨W, hWV, hxW, ?_⟩
  rw [← hm]
  have hψ : ψ.val.app (op W) (π.val.app (op W) m) = 0 := by
    rw [hm]
    refine (ConcreteCategory.congr_hom (ψ.val.naturality (homOfLE hWV).op) σ).trans ?_
    change (zeroSchemeSubschemeSheaf X f a).val.map (homOfLE hWV).op (ψ.val.app (op V) σ) = 0
    rw [show ψ.val.app (op V) σ = 0 from hσ, map_zero]
  exact toZeroSchemeStructureSheaf_app_eq_zero_of_subschemeι_app_eq_zero X f a hWaff m
    ((ConcreteCategory.congr_hom (congrArg (fun g => g.val.app (op W))
      (toZeroSchemeStructureSheaf_comp_toZeroSchemeSubscheme X f a)) m).symm.trans hψ)

/-- **The comparison map is an isomorphism**: it is injective on sections over every open, and
it is an epimorphism because restriction of functions to a closed subscheme is one. -/
instance isIso_toZeroSchemeSubscheme (a : A) : IsIso (toZeroSchemeSubscheme X f a) := by
  have hmono : Mono (toZeroSchemeSubscheme X f a) := by
    have hmono' : ∀ U, Mono (((PresheafOfModules.toPresheaf X.ringCatSheaf.obj).map
        ((SheafOfModules.forget X.ringCatSheaf).map (toZeroSchemeSubscheme X f a))).app U) :=
      fun U => ConcreteCategory.mono_of_injective _
        (toZeroSchemeSubscheme_app_injective X f a U.unop)
    exact (SheafOfModules.forget _).mono_of_mono_map
      ((PresheafOfModules.toPresheaf _).mono_of_mono_map (NatTrans.mono_of_mono_app _))
  have hφ : Epi (ambientToZeroScheme X f a) :=
    Scheme.IdealSheafData.epi_ambientToPushforward (zeroSchemeIdeal X f a).subschemeι
  have hepi : Epi (toZeroSchemeSubscheme X f a) :=
    epi_of_epi_fac (toZeroSchemeStructureSheaf_comp_toZeroSchemeSubscheme X f a)
  exact isIso_of_mono_of_epi _

/-- The comparison map is bijective on sections over every open. -/
theorem toZeroSchemeSubscheme_app_bijective (a : A) (V : X.Opens) :
    Function.Bijective ((toZeroSchemeSubscheme X f a).val.app (op V)) :=
  ConcreteCategory.bijective_of_isIso
    ((SheafOfModules.evaluation X.ringCatSheaf (op V)).map (toZeroSchemeSubscheme X f a))

end AlgebraicGeometry

end
