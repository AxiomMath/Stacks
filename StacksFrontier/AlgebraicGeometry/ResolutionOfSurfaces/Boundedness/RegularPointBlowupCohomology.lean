/-!
# The first cohomology survives a blowup at a regular point of dimension two

Let `X` be a locally Noetherian scheme and `w ∈ X` a closed point whose local ring is regular of
dimension two, and let `g : X' ⟶ X` be the blowup of `X` at `w`. Then `R¹g_*𝒪_{X'} = 0`: away
from `w` the morphism `g` is an isomorphism, and at `w` flat base change along
`Spec 𝒪_{X, w} ⟶ X` reduces the question to the blowup of the regular local ring `𝒪_{X, w}` in
its maximal ideal, which has no first cohomology because the maximal ideal has two generators.
Hence, by the low-degree Leray sequence, `H¹(X', 𝒪_{X'}) = 0` as soon as `H¹(X, 𝒪_X) = 0` and
`g_*𝒪_{X'} = 𝒪_X`. This is the input of [Stacks, Tag 0B4Q] that the source draws from
[Stacks, Tags 0AGS and 0AXF].

## Main results

* `AlgebraicGeometry.isZero_Hgroup_one_blowUp_maximalIdeal`: `H¹(X, 𝒪_X) = 0` for the blowup of
  a two-dimensional regular local ring in its maximal ideal.
* `AlgebraicGeometry.isZero_rightDerived_one_pushforward_blowUp_pointIdeal`: `R¹g_*𝒪_{X'} = 0`.

## References

* [Stacks Project, Tag 0AGS](https://stacks.math.columbia.edu/tag/0AGS)
* [Stacks Project, Tag 0B4Q](https://stacks.math.columbia.edu/tag/0B4Q)
* [Stacks Project, Tag 02KH](https://stacks.math.columbia.edu/tag/02KH)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

universe u

namespace AlgebraicGeometry

attribute [local instance] HasDerivedCategory.standard

/-- **`H¹(X, 𝒪_X) = 0` for the blowup of a regular local ring of dimension two in its maximal
ideal.** The maximal ideal is generated by two elements, and the blowup is `Proj` of the Rees
algebra (`Stacks.Blowup.nonempty_over_iso_blowUpToBase`). -/
theorem isZero_Hgroup_one_blowUp_maximalIdeal (B : Type u) [CommRing B] [IsRegularLocalRing B]
    (hdim : ringKrullDim B = 2) :
    IsZero (Hgroup (blowUp (Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom
          (IsLocalRing.maximalIdeal B)))).ringCatSheaf ⊤ 1
      (SheafOfModules.unit (blowUp (Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom
          (IsLocalRing.maximalIdeal B)))).ringCatSheaf)) := by
  obtain ⟨x, hx⟩ := Stacks.Blowup.exists_range_eq_maximalIdeal B hdim
  obtain ⟨e⟩ := Stacks.Blowup.nonempty_over_iso_blowUpToBase (R := B)
    (K := IsLocalRing.maximalIdeal B)
  let e' : AlgebraicGeometry.Proj (Stacks.Blowup.reesGrading (IsLocalRing.maximalIdeal B)) ≅
      blowUp (Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of B)).inv.hom (IsLocalRing.maximalIdeal B))) :=
    (Over.forget _).mapIso e
  exact (Stacks.Cohomology.SchemeIso.isZero_Hgroup_pullback_iff e' _ 1).mp
    ((Stacks.Blowup.isZero_Hgroup_one_proj_reesGrading_of_two_generators
      (IsLocalRing.maximalIdeal B) x hx).of_iso
      ((Hfunctor (AlgebraicGeometry.Proj
        (Stacks.Blowup.reesGrading (IsLocalRing.maximalIdeal B))).ringCatSheaf ⊤ 1).mapIso
          (Scheme.Modules.pullbackUnitIso e'.hom)))

/-- Away from the support of `M`, the stalk of `R¹(blowUpToBase M)_*𝒪` vanishes, since the
blowup is an isomorphism there. -/
theorem isZero_stalk_rightDerivedPlus_one_pushforward_blowUpToBase_of_notMem_support
    {X : Scheme.{u}} (M : X.IdealSheafData) (y : X) (hy : y ∉ (M.support : Set X)) :
    IsZero ((((Scheme.Modules.pushforward (blowUpToBase M)).rightDerivedPlus 1).obj
      (SheafOfModules.unit (blowUp M).ringCatSheaf)).presheaf.stalk y) := by
  let V : X.Opens := ⟨M.supportᶜ, M.support.isClosed.isOpen_compl⟩
  have : IsIso (blowUpToBase M ∣_ V) := isIso_blowUp_restrict_compl_support M
  have : ((Scheme.Modules.restrictFunctor (blowUpToBase M ⁻¹ᵁ V).ι).obj
      (SheafOfModules.unit (blowUp M).ringCatSheaf)).IsQuasicoherent :=
    Scheme.Modules.isQuasicoherent_restrictFunctor _ _
  open Stacks.AlgebraicGeometry.SchemeHigherDirectImage in
  exact isZero_stalk_of_isZero_rightDerivedPlus_restrict _ V y hy _ (by norm_num)
    (Stacks.Cohomology.Affine.isZero_rightDerived_pushforward_of_isAffineHom _ _ 1 one_pos)

/-- A quasicoherent module whose pullback to `Spec 𝒪_{X, w}` vanishes has vanishing stalk at
`w`. -/
theorem isZero_stalk_of_isZero_pullback_fromSpecStalk {X : Scheme.{u}} (F : X.Modules)
    [F.IsQuasicoherent] (w : X) (h : IsZero ((Scheme.Modules.pullback (X.fromSpecStalk w)).obj F)) :
    IsZero (F.presheaf.stalk w) := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hwU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ w) isOpen_univ
  obtain ⟨e, -⟩ := exists_fromSpecStalkSectionsStalkLinearEquiv F w hU hwU
  have : Subsingleton (Γ((Scheme.Modules.pullback (X.fromSpecStalk w)).obj F, ⊤)) :=
    ModuleCat.isZero_iff_subsingleton.mp ((SheafOfModules.evaluation _ (op ⊤)).map_isZero h)
  rw [AddCommGrpCat.isZero_iff_subsingleton]
  exact e.symm.toEquiv.subsingleton

/-- At a closed point `w` with regular two-dimensional local ring, the stalk at `w` of
`R¹g_*𝒪_{X'}` for the blowup `g` of `X` at `w` vanishes, by flat base change along
`Spec 𝒪_{X, w} ⟶ X`. -/
theorem isZero_stalk_rightDerivedPlus_one_pushforward_blowUp_pointIdeal {X : Scheme.{u}}
    [IsLocallyNoetherian X] (w : X) (hw : IsClosed ({w} : Set X))
    [IsRegularLocalRing (X.presheaf.stalk w)] (hdim : ringKrullDim (X.presheaf.stalk w) = 2) :
    IsZero ((((Scheme.Modules.pushforward (blowUpToBase
        (Scheme.IdealSheafData.vanishingIdeal (⟨{w}, hw⟩ : Closeds X)))).rightDerivedPlus 1).obj
          (SheafOfModules.unit (blowUp (Scheme.IdealSheafData.vanishingIdeal
            (⟨{w}, hw⟩ : Closeds X))).ringCatSheaf)).presheaf.stalk w) := by
  set M := Scheme.IdealSheafData.vanishingIdeal (⟨{w}, hw⟩ : Closeds X) with hM
  set g := blowUpToBase M
  have hqc (Y : Scheme.{u}) : (SheafOfModules.unit Y.ringCatSheaf).IsQuasicoherent :=
    Stacks.AlgebraicGeometry.AffineQcohPushforward.isQuasicoherent_unit _
  have hF : (((Scheme.Modules.pushforward g).rightDerivedPlus 1).obj
      (SheafOfModules.unit (blowUp M).ringCatSheaf)).IsQuasicoherent :=
    AlgebraicGeometry.ProperCoherentFiniteType.isQuasicoherent_rightDerivedPlus g _ (hqc _) 1
  let b := X.fromSpecStalk w
  have : Flat b := flat_fromSpecStalk X w
  obtain ⟨h, hpb⟩ := exists_isPullback_blowUpToBase_comap b M
  set p := blowUpToBase (M.comap b)
  have hloc : IsZero (Hgroup (blowUp (M.comap b)).ringCatSheaf ⊤ 1
      (SheafOfModules.unit (blowUp (M.comap b)).ringCatSheaf)) := by
    rw [hM, vanishingIdeal_singleton_comap_fromSpecStalk_eq w hw]
    exact isZero_Hgroup_one_blowUp_maximalIdeal _ hdim
  have hp : IsZero (((Scheme.Modules.pushforward p).rightDerivedPlus 1).obj
      (SheafOfModules.unit (blowUp (M.comap b)).ringCatSheaf)) :=
    open Stacks.AlgebraicGeometry.TopDegreeBaseChange Stacks.Cohomology.AffineBase in
    isZero_rightDerivedPlus_pushforward_of_isZero_cohomology p 1 _
      ((isZero_rightDerivedPlus_moduleGlobalSections_iff_isZero_Hgroup _ _ 1).2 hloc)
  have hpull : IsZero ((Scheme.Modules.pullback b).obj
      (((Scheme.Modules.pushforward g).rightDerivedPlus 1).obj
        (SheafOfModules.unit (blowUp M).ringCatSheaf))) :=
    (hp.of_iso (((Scheme.Modules.pushforward p).rightDerivedPlus 1).mapIso
      (Scheme.Modules.pullbackUnitIso h))).of_iso
      (Stacks.AlgebraicGeometry.FlatBaseChangeDerived.higherBaseChangeIso hpb.flip
        (SheafOfModules.unit (blowUp M).ringCatSheaf) 1)
  exact isZero_stalk_of_isZero_pullback_fromSpecStalk _ w hpull

/-- **`R¹g_*𝒪_{X'} = 0` for the blowup `g` of a locally Noetherian scheme at a closed point with
regular two-dimensional local ring.** Away from the point `g` is an isomorphism; at the point
flat base change along `Spec 𝒪_{X, w} ⟶ X` ([Stacks, Tag 02KH]) identifies the question with the
vanishing of `H¹` of the blowup of `𝒪_{X, w}` in its maximal ideal. -/
theorem isZero_rightDerivedPlus_one_pushforward_blowUp_pointIdeal {X : Scheme.{u}}
    [IsLocallyNoetherian X] (w : X) (hw : IsClosed ({w} : Set X))
    [IsRegularLocalRing (X.presheaf.stalk w)] (hdim : ringKrullDim (X.presheaf.stalk w) = 2) :
    IsZero (((Scheme.Modules.pushforward (blowUpToBase
        (Scheme.IdealSheafData.vanishingIdeal (⟨{w}, hw⟩ : Closeds X)))).rightDerivedPlus 1).obj
          (SheafOfModules.unit (blowUp (Scheme.IdealSheafData.vanishingIdeal
            (⟨{w}, hw⟩ : Closeds X))).ringCatSheaf)) := by
  refine isZero_of_forall_isZero_stalk _ fun y => ?_
  obtain rfl | hy := eq_or_ne y w
  · exact isZero_stalk_rightDerivedPlus_one_pushforward_blowUp_pointIdeal _ hw hdim
  · exact isZero_stalk_rightDerivedPlus_one_pushforward_blowUpToBase_of_notMem_support _ y
      (by rwa [Stacks.GenericFlatness.support_vanishingIdeal])

/-- A point of an integral scheme with a two-dimensional local ring is not the generic point. -/
theorem genericPoint_ne_of_ringKrullDim_stalk_eq_two {X : Scheme.{u}} [IsIntegral X] (w : X)
    (hdim : ringKrullDim (X.presheaf.stalk w) = 2) : genericPoint X ≠ w := by
  rintro rfl
  change ringKrullDim X.functionField = 2 at hdim
  rw [ringKrullDim_eq_zero_of_field] at hdim
  exact (by norm_num : (0 : WithBot ℕ∞) ≠ 2) hdim

open Stacks.Cohomology.LerayLowDegree in
/-- **`H¹ = 0` survives a blowup at a regular point of dimension two.** Let `X` be a locally
Noetherian normal integral scheme with `H¹(X, 𝒪_X) = 0`, and `w ∈ X` a closed point whose local
ring is regular of dimension two. Then the blowup `X'` of `X` at `w` has `H¹(X', 𝒪_{X'}) = 0`:
`R¹g_*𝒪_{X'} = 0` and `g_*𝒪_{X'} = 𝒪_X`, so the low-degree Leray sequence gives
`H¹(X', 𝒪_{X'}) = H¹(X, 𝒪_X)`. -/
theorem isZero_rightDerived_evaluation_one_blowUp_pointIdeal {X : Scheme.{u}}
    [IsLocallyNoetherian X] [IsIntegral X] [IsNormal X] (w : X) (hw : IsClosed ({w} : Set X))
    [IsRegularLocalRing (X.presheaf.stalk w)] (hdim : ringKrullDim (X.presheaf.stalk w) = 2)
    (hX : IsZero (((SheafOfModules.evaluation X.ringCatSheaf (op ⊤)).rightDerived 1).obj
      (SheafOfModules.unit X.ringCatSheaf))) :
    IsZero (((SheafOfModules.evaluation (blowUp (Scheme.IdealSheafData.vanishingIdeal
        (⟨{w}, hw⟩ : Closeds X))).ringCatSheaf (op ⊤)).rightDerived 1).obj
      (SheafOfModules.unit (blowUp (Scheme.IdealSheafData.vanishingIdeal
        (⟨{w}, hw⟩ : Closeds X))).ringCatSheaf)) := by
  set M := Scheme.IdealSheafData.vanishingIdeal (⟨{w}, hw⟩ : Closeds X)
  set g := blowUpToBase M
  have hM0 : M ≠ ⊥ := vanishingIdeal_singleton_ne_bot w hw
    (genericPoint_ne_of_ringKrullDim_stalk_eq_two w hdim)
  have : IsIntegral (blowUp M) := isIntegral_blowUp M hM0
  have hgmod : IsModification g := ⟨isBirational_blowUpToBase M hM0, inferInstance, inferInstance⟩
  have := isIso_structureSheafToAbelianPushforward g hgmod.isIso_c_of_isNormal_target
  let FAb := (SheafOfModules.toSheaf (blowUp M).ringCatSheaf).obj
    (SheafOfModules.unit (blowUp M).ringCatSheaf)
  have hSource : IsZero ((abelianPushforward.{u, u} g.base ⋙
      abelianCohomology.{u, u} X.toTopCat ⊤ 1).obj FAb) :=
    ((isZero_rightDerived_evaluation_iff_isZero_abelianCohomology X 1 _).1 hX).of_iso
      ((abelianCohomology.{u, u} X.toTopCat ⊤ 1).mapIso
        (asIso (structureSheafToAbelianPushforward g))).symm
  have hR : IsZero (((Scheme.Modules.pushforward g).rightDerived 1).obj
      (SheafOfModules.unit (blowUp M).ringCatSheaf)) :=
    (isZero_rightDerivedPlus_one_pushforward_blowUp_pointIdeal w hw hdim).of_iso
      ((Stacks.DerivedIndexing.rightDerivedIso (Scheme.Modules.pushforward g) 1).app _)
  have hTarget : IsZero ((abelianSections.{u, u} X.toTopCat ⊤).obj
      (((abelianPushforward.{u, u} g.base).rightDerived 1).obj FAb)) :=
    (abelianSections.{u, u} X.toTopCat ⊤).map_isZero
      ((Functor.map_isZero (SheafOfModules.toSheaf X.ringCatSheaf) hR).of_iso
        ((Stacks.Cohomology.ModulePushforwardComparison.rightDerived_modulePushforward_forget_iso
          g.toLRSHom.toShHom 1).app _).symm)
  have hAb : IsZero ((abelianCohomology.{u, u} (blowUp M).toTopCat ⊤ 1).obj FAb) :=
    ((abelianLerayLowDegreeData.{u, u} g.base).exact FAb).isZero_of_both_zeros
      (hSource.eq_zero_of_src _) (hTarget.eq_zero_of_tgt _)
  exact (isZero_rightDerived_evaluation_iff_isZero_abelianCohomology _ 1 _).2 hAb

end AlgebraicGeometry

