/-!
# Dominating a normal modification upstairs by one finite over a modification downstairs

Let `A → B` be a finite injective map of domains with `A` Nagata and `B` a normal local domain of
dimension at most two (so `B` is Noetherian and Nagata, being finite over `A`). Every normal
modification `Y` of `Spec B` is dominated by a normal modification `Y'` of `Spec B` which is finite
and surjective over a normal modification `X'` of `Spec A`. This is the reduction step of the proof
of [Stacks, Tag 0AXL].

## Implementation notes

The source obtains `X'` from the flattening theorem ([Stacks, Tag 0B49]). We use a valuative
argument instead, which needs nothing beyond the normalization of a modification of `Spec A` in
the fraction field of `B`.

* `Y ⟶ Spec B` contracts finitely many curves; the local ring of `Y` at the generic point `y` of
  each of them is a discrete valuation ring whose residue field contains an element transcendental
  over the residue field of `B`
  (`Stacks.ResolutionOfSurfaces.exists_finite_contracted_forall_exists_lift`). That element can be
  taken of the form `c / c₀` with `c, c₀ ∈ A`
  (`ValuationRing.exists_ratio_transcendental_residue`).
* `X'` is the normalization of the blowup of `Spec A` in the product of the ideals `(c₀, c)`
  over all these curves. At every point of `X'` each ideal `(c₀, c)` becomes principal, hence is
  generated by `c₀` or by `c`, so `c / c₀` or `c₀ / c` is regular there
  (`Ideal.dvd_or_dvd_of_span_pair_mul_eq_span_singleton`).
* `Y'` is the normalization of `X' ×_{Spec A} Spec B` in the fraction field of `B`
  (`AlgebraicGeometry.CompleteCaseStep`); it is finite over `X'` because `B` is Nagata.
* If a point `t` of `Y'` were the centre of the valuation of a contracted curve `y` with `κ(t)`
  algebraic over `κ_B`, the regular function `c / c₀` or `c₀ / c` at the image of `t` in `X'`
  would have a residue at `y` algebraic over `κ_B`, which is not the case. By the criterion this
  makes `Y'` dominate `Y`.

## Main results

* `AlgebraicGeometry.SeparableGoUp.isDominatedByFiniteOverBase`: the reduction step.
* `AlgebraicGeometry.exists_isModification_map_eq_span_singleton`: a nonzero ideal of a Noetherian
  Nagata domain becomes principal on a normal modification of its spectrum.
* `AlgebraicGeometry.CompleteCaseStep.isModification_toBase_of_isNagataRing` and
  `AlgebraicGeometry.CompleteCaseStep.isFinite_toResolution_of_isNagataRing`: the normalization of
  a modification in a finite extension of fraction fields, over a Nagata ring.

## References

* [Stacks Project, Tag 0AXL](https://stacks.math.columbia.edu/tag/0AXL)
* [Stacks Project, Tag 0B49](https://stacks.math.columbia.edu/tag/0B49)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing

universe u

namespace AlgebraicGeometry

/-! ### The map from the base ring to the local rings -/

section BaseRing

variable {A : Type u} [CommRing A]

/-- The map from the base ring to a local ring of a scheme over `Spec A` is compatible with
composition of morphisms. -/
theorem baseRingToStalk_comp {X Y : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Spec (.of A)) (x : X) :
    baseRingToStalk (f ≫ g) x = (f.stalkMap x).hom.comp (baseRingToStalk g (f x)) := by
  simp only [baseRingToStalk, Scheme.Hom.stalkMap_comp]
  rfl

/-- The map from the base ring to the local rings of a scheme over `Spec B`, regarded over
`Spec A` through a ring map `A → B`, is the composite with that ring map. -/
theorem baseRingToStalk_comp_SpecMap {B : Type u} [CommRing B] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of B)) (φ : A →+* B) (x : X) :
    baseRingToStalk (f ≫ Spec.map (CommRingCat.ofHom φ)) x = (baseRingToStalk f x).comp φ := by
  rw [baseRingToStalk_comp]
  ext a
  exact congrArg (f.stalkMap x).hom (stalkMap_toStalk_apply (CommRingCat.ofHom φ) (f x) a)

end BaseRing

/-! ### The normalization of a modification in a finite extension, over a Nagata ring -/

namespace CompleteCaseStep

variable {B A : Type u} [CommRing B] [CommRing A] [IsDomain B] [IsDomain A] [Algebra B A]
  [FaithfulSMul B A] {Y : Scheme.{u}} [IsIntegral Y] {g : Y ⟶ Spec (.of B)}

/-- **The normalization `X` of `Y ×_{Spec B} Spec A` in the fraction field of `A` is finite over
the fibre product when `A` is Nagata** ([Stacks, Tag 0AVK]): the fibre product is of finite type
over `A`, and `Spec K ⟶ Y ×_{Spec B} Spec A` is surjective on residue fields. -/
theorem isFinite_fromNormalization_of_isNagataRing [IsNagataRing A] [LocallyOfFiniteType g]
    (hg : IsBirational g) : IsFinite (liftToFibreProduct B A hg).fromNormalization := by
  have hP : IsNagataScheme (pullback g (baseMap B A)) :=
    isNagataScheme_of_locallyOfFiniteType (pullback.snd g (baseMap B A))
      (isNagataScheme_spec_of_isNagataRing _ inferInstance)
  have : Finite (Spec (fieldK A)) := inferInstanceAs (Finite (PrimeSpectrum (fieldK A)))
  refine AlgebraicGeometry.isFinite_fromNormalization (liftToFibreProduct B A hg) hP
    (fun U _ => have : Finite U := Subtype.finite
      TopologicalSpace.NoetherianSpace.finite_irreducibleComponents) fun x => ?_
  let φ := liftToFibreProduct B A hg
  let := (φ.residueFieldMap x.1).hom.toAlgebra
  have hsurj : Function.Surjective (φ.residueFieldMap x.1).hom := by
    have h := surjective_residueFieldMap_of_surjectiveOnStalks (genericPointToBase A) x.1
    rw [Scheme.Hom.residueFieldMap_congr (liftToFibreProduct_snd hg).symm,
      Scheme.residueFieldMap_comp] at h
    exact fun z => ⟨_, (h z).choose_spec⟩
  have : Algebra.EssFiniteType (pullback g (baseMap B A) |>.residueField (φ x.1))
      ((Spec (fieldK A)).residueField x.1) := by
    rw [← RingHom.essFiniteType_algebraMap, RingHom.algebraMap_toAlgebra]
    exact (RingHom.FiniteType.of_surjective _ hsurj).essFiniteType
  exact IntermediateField.fg_top _ _

/-- **`X ⟶ Spec A` is a modification when `A` is Nagata.** -/
theorem isModification_toBase_of_isNagataRing [IsNagataRing A] [LocallyOfFiniteType g]
    [IsProper g] (hg : IsBirational g) : IsModification (toBase B A hg) := by
  have : IsFinite (liftToFibreProduct B A hg).fromNormalization :=
    isFinite_fromNormalization_of_isNagataRing hg
  refine ⟨isBirational_toBase hg, ?_, inferInstance⟩
  rw [toBase]
  infer_instance

/-- **`X ⟶ Y` is finite when `A` is Nagata and finite over `B`.** -/
theorem isFinite_toResolution_of_isNagataRing [IsNagataRing A] [Module.Finite B A]
    [LocallyOfFiniteType g] (hg : IsBirational g) : IsFinite (toResolution B A hg) := by
  have : IsFinite (liftToFibreProduct B A hg).fromNormalization :=
    isFinite_fromNormalization_of_isNagataRing hg
  have : IsFinite (baseMap B A) := by
    rw [IsFinite.SpecMap_iff]
    exact RingHom.finite_algebraMap.mpr inferInstance
  rw [toResolution]
  infer_instance

end CompleteCaseStep

/-! ### A normal modification on which an ideal becomes principal -/

/-- **Over a Noetherian Nagata domain, a nonzero ideal becomes principal on a normal
modification.** The normalization `X` of the blowup of `Spec A` in `J` is normal, proper and
birational over `Spec A`, and at every point of `X` the image of `J` in the local ring is
principal: it is the pullback of the exceptional divisor of the blowup, an effective Cartier
divisor. -/
theorem exists_isModification_map_eq_span_singleton (A : Type u) [CommRing A] [IsDomain A]
    [IsNagataRing A] (J : Ideal A) (hJ : J ≠ ⊥) :
    ∃ (X : Scheme.{u}) (f : X ⟶ Spec (.of A)), IsNormal X ∧ IsModification f ∧
      ∀ x : X, ∃ d, J.map (baseRingToStalk f x) = Ideal.span {d} := by
  let e := Scheme.ΓSpecIso (CommRingCat.of A)
  let I : (Spec (.of A)).IdealSheafData :=
    Scheme.IdealSheafData.ofIdealTop (Ideal.map e.inv.hom J)
  have hItop : I.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.map e.inv.hom J :=
    Stacks.Blowup.ideal_ofIdealTop_top _
  have hI : I ≠ ⊥ := by
    intro h
    have h0 : Ideal.map e.inv.hom J = ⊥ := by
      rw [← hItop, h]
      rfl
    exact hJ ((Ideal.map_eq_bot_iff_of_injective
      (ConcreteCategory.bijective_of_isIso e.inv).1).mp h0)
  have hX := Stacks.Blowup.finite_irreducibleComponents_blowUp I
    (Stacks.ResolutionOfSurfaces.finite_irreducibleComponents_isCompactOpen_of_isNoetherian
      (X := Spec (.of A)))
  have : IsIntegral (blowUp I) := isIntegral_blowUp I hI
  let ν := Scheme.normalization (blowUp I) hX
  have : IsFinite ν := Scheme.isFinite_normalization
    (isNagataScheme_of_locallyOfFiniteType (blowUpToBase I)
      (isNagataScheme_spec_of_isNagataRing _ inferInstance)) hX
  refine ⟨_, ν ≫ blowUpToBase I, Scheme.isNormal_normalizationScheme _ hX,
    ⟨(Scheme.isBirational_normalization _ hX).comp (isBirational_blowUpToBase I hI),
      inferInstance, inferInstance⟩, fun x => ?_⟩
  obtain ⟨d, -, hd⟩ := exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor
    (exceptionalIdeal I) inferInstance (ν x)
  refine ⟨(ν.stalkMap x).hom d, ?_⟩
  have hstalk : IdealSheafData.stalk I (blowUpToBase I (ν x)) =
      J.map (StructureSheaf.toStalk A (blowUpToBase I (ν x))).hom := by
    rw [IdealSheafData.stalk_eq_map_germ I _ ⟨⊤, isAffineOpen_top _⟩ trivial, hItop,
      Ideal.map_map]
    congr 1
  have key : J.map (baseRingToStalk (blowUpToBase I) (ν x)) = Ideal.span {d} := by
    rw [← hd, stalk_comap I (blowUpToBase I) (ν x), hstalk]
    exact (Ideal.map_map _ _).symm
  rw [baseRingToStalk_comp, ← Ideal.map_map, key, Ideal.map_span, Set.image_singleton]

/-! ### Local homomorphisms over a base and residue fields -/

/-- **A local homomorphism of local rings over a common base carries residues integral over the
base to residues integral over the base.** Let `l : T ⟶ S` and `q : Y ⟶ S`, let `t ∈ T` and
`y ∈ Y` lie over the same point, and let `ψ : 𝒪_{T,t} ⟶ 𝒪_{Y,y}` be a local homomorphism
compatible with the maps from `𝒪_S`. If `κ(t)` is integral over the residue field of `S`, then
so is the residue at `y` of every element of the image of `ψ`. -/
theorem isIntegralElem_residue_of_isLocalHom {S T Y : Scheme.{u}} (l : T ⟶ S) (q : Y ⟶ S)
    {t : T} {y : Y} (ψ : T.presheaf.stalk t ⟶ Y.presheaf.stalk y) [IsLocalHom ψ.hom]
    (ht : l t = q y)
    (hψ : l.stalkMap t ≫ ψ = (S.presheaf.stalkCongr (.of_eq ht)).hom ≫ q.stalkMap y)
    (hint : (l.residueFieldMap t).hom.IsIntegral) (r : T.presheaf.stalk t) :
    (q.residueFieldMap y).hom.IsIntegralElem (Y.residue y (ψ r)) := by
  let c := S.presheaf.stalkCongr (.of_eq ht)
  have : IsLocalHom c.hom.hom := isLocalHom_of_isIso c.hom
  let e : S.residueField (l t) →+* S.residueField (q y) := ResidueField.map c.hom.hom
  have hcomp : (ResidueField.map ψ.hom).comp (l.residueFieldMap t).hom =
      (q.residueFieldMap y).hom.comp e := by
    change (ResidueField.map ψ.hom).comp (ResidueField.map (l.stalkMap t).hom) =
      (ResidueField.map (q.stalkMap y).hom).comp (ResidueField.map c.hom.hom)
    rw [← ResidueField.map_comp, ← ResidueField.map_comp]
    congr 1
    exact congrArg CommRingCat.Hom.hom hψ
  obtain ⟨P, hPm, hP⟩ := (hint (T.residue t r)).map (ResidueField.map ψ.hom)
  refine ⟨P.map e, hPm.map e, ?_⟩
  rwa [Polynomial.eval₂_map, ← hcomp,
    show Y.residue y (ψ r) = ResidueField.map ψ.hom (T.residue t r) from
      (ResidueField.map_residue ψ.hom r).symm]

/-- The map from the base ring to a local ring of the source of a birational morphism of integral
schemes is injective: composed with the map to the function field it is the map from the base
ring to the generic stalk of `Spec B`, a localization, followed by an isomorphism. -/
theorem baseRingToStalk_injective {B : Type u} [CommRing B] [IsDomain B] {Y : Scheme.{u}}
    [IsIntegral Y] (q : Y ⟶ Spec (.of B)) (hq : IsBirational q) (y : Y) :
    Function.Injective (baseRingToStalk q y) := by
  have hiso : IsIso (q.stalkMap (genericPoint Y)) :=
    hq.isIso_stalkMap _ (by simp [genericPoints_eq_singleton])
  have h1 : Function.Injective (q.stalkMap (genericPoint Y)).hom :=
    (ConcreteCategory.bijective_of_isIso (q.stalkMap (genericPoint Y))).1
  let P : PrimeSpectrum B := q (genericPoint Y)
  have h2 : Function.Injective (algebraMap B ((Spec.structureSheaf B).presheaf.stalk P)) :=
    IsLocalization.injective _ P.asIdeal.primeCompl_le_nonZeroDivisors
  have h3 : Function.Injective (baseFun q) := h1.comp h2
  exact fun a b hab => h3 (by rw [← algebraMap_baseRingToStalk q y,
    ← algebraMap_baseRingToStalk q y, hab])

/-- The image of an element of `B` in the stalk of `Spec B` is moved by the identification of the
stalks at equal points to the image of the same element. -/
theorem stalkCongr_toStalk {B : Type u} [CommRing B] {p p' : Spec (.of B)} (h : p = p') (b : B) :
    ((Spec (.of B)).presheaf.stalkCongr (.of_eq h)).hom (StructureSheaf.toStalk B p b) =
      StructureSheaf.toStalk B p' b := by
  subst h
  simp only [TopCat.Presheaf.stalkCongr_hom, TopCat.Presheaf.stalkSpecializes_refl,
    CommRingCat.hom_id, RingHom.coe_id]
  rfl

/-- The map from a local ring to the local ring of its spectrum at a closed point is surjective. -/
theorem toStalk_surjective_of_isClosed {B : Type u} [CommRing B] [IsLocalRing B]
    (p : Spec (.of B)) (hp : IsClosed ({p} : Set (Spec (.of B)))) :
    Function.Surjective (StructureSheaf.toStalk B p).hom := by
  have hmax := (PrimeSpectrum.isClosed_singleton_iff_isMaximal p).mp hp
  obtain rfl : p = IsLocalRing.closedPoint B :=
    PrimeSpectrum.ext (IsLocalRing.eq_maximalIdeal hmax)
  have h := ConcreteCategory.bijective_of_isIso (stalkClosedPointIso (.of B)).inv
  rw [stalkClosedPointIso_inv] at h
  exact h.2

/-- **A residue transcendental over the base is a ratio of elements of an integral subring.** Let
`q : Y ⟶ Spec B` be birational with `Y` integral, let `A → B` be injective and integral, and let
`y ∈ Y` have closed image with `𝒪_{Y,y}` a discrete valuation ring. If `u ∈ 𝒪_{Y,y}` has residue
transcendental over `κ(q y)` and `a = u * b` for `a, b` from `𝒪_{Spec B, q y}` with `b ≠ 0`, then
there are `c, c₀ ∈ A` and `t ∈ 𝒪_{Y,y}` with `c₀ * t = c`, `c₀ ≠ 0`, and residue of `t` not
integral over `κ(q y)`. -/
theorem exists_ratio_not_isIntegralElem_residue {A B : Type u} [CommRing A] [CommRing B]
    [IsDomain B] [IsLocalRing B] [Algebra A B] [Algebra.IsIntegral A B] [FaithfulSMul A B]
    {Y : Scheme.{u}} [IsIntegral Y] (q : Y ⟶ Spec (.of B)) (hq : IsBirational q) {y : Y}
    (hqy : IsClosed ({q y} : Set (Spec (.of B)))) [IsDiscreteValuationRing (Y.presheaf.stalk y)]
    (u : Y.presheaf.stalk y)
    (hu : @Transcendental ((Spec (.of B)).residueField (q y)) (Y.residueField y) _ _
      (q.residueFieldMap y).hom.toAlgebra (Y.residue y u))
    (a b : (Spec (.of B)).presheaf.stalk (q y)) (hb : (q.stalkMap y).hom b ≠ 0)
    (hab : (q.stalkMap y).hom a = u * (q.stalkMap y).hom b) :
    ∃ c c₀ : A, baseRingToStalk q y (algebraMap A B c₀) ≠ 0 ∧ ∃ t,
      baseRingToStalk q y (algebraMap A B c₀) * t = baseRingToStalk q y (algebraMap A B c) ∧
      ¬ (q.residueFieldMap y).hom.IsIntegralElem (Y.residue y t) := by
  obtain ⟨a₁, rfl⟩ := toStalk_surjective_of_isClosed (q y) hqy a
  obtain ⟨b₁, rfl⟩ := toStalk_surjective_of_isClosed (q y) hqy b
  let : Algebra ((Spec (.of B)).residueField (q y)) (ResidueField (Y.presheaf.stalk y)) :=
    (q.residueFieldMap y).hom.toAlgebra
  obtain ⟨c, c₀, hc₀, t, ht, htr⟩ := ValuationRing.exists_ratio_transcendental_residue (A := A)
    (baseRingToStalk q y) (baseRingToStalk_injective q hq y) ((Spec (.of B)).residueField (q y))
    u a₁ b₁ hb hab hu
  exact ⟨c, c₀, hc₀, t, ht, fun h => htr (show _root_.IsIntegral
    ((Spec (.of B)).residueField (q y)) (IsLocalRing.residue (Y.presheaf.stalk y) t) from
    h).isAlgebraic⟩

/-- A finite morphism `π : Z ⟶ X'` of integral schemes is surjective if it lies over a dominant
morphism `p : T ⟶ S` of integral schemes through birational morphisms `Z ⟶ T` and `X' ⟶ S`. -/
theorem surjective_of_isBirational_of_comp_eq {Z X' S T : Scheme.{u}} [IsIntegral Z]
    [IsIntegral X'] [IsIntegral S] [IsIntegral T] (π : Z ⟶ X') [IsFinite π] (f' : X' ⟶ S)
    (g' : Z ⟶ T) (p : T ⟶ S) [IsDominant p] (hf' : IsBirational f') (hg' : IsBirational g')
    (hcomm : π ≫ f' = g' ≫ p) : Surjective π := by
  have h2 : f' (π (genericPoint Z)) = genericPoint S := by
    rw [← Scheme.Hom.comp_apply, hcomm, Scheme.Hom.comp_apply, hg'.genericPoint_eq,
      map_genericPoint_of_isDominant p]
  have (W : Scheme.{u}) [IsIntegral W] : Finite (irreducibleComponents W) := by
    rw [irreducibleComponents_eq_singleton]
    infer_instance
  have hgen : π (genericPoint Z) ∈ f' ⁻¹' genericPoints S := by
    rw [Set.mem_preimage, h2, genericPoints_eq_singleton, Set.mem_singleton_iff]
  rw [preimage_genericPoints_eq_genericPoints_of_isBirational f' hf',
    genericPoints_eq_singleton] at hgen
  exact ⟨fun x => ((genericPoint_spec X').specializes (Set.mem_univ x)).mem_closed
    π.isClosedMap.isClosed_range ⟨_, hgen⟩⟩

/-- A finite product of ideals `(a i, b i)` in a domain is nonzero when every `a i` is. -/
theorem _root_.Ideal.prod_span_pair_ne_bot {ι R : Type*} [CommRing R] [IsDomain R]
    (s : Finset ι) (a b : ι → R) (ha : ∀ i ∈ s, a i ≠ 0) :
    ∏ i ∈ s, Ideal.span {a i, b i} ≠ ⊥ := by
  rw [Ne, ← Ideal.zero_eq_bot, Finset.prod_eq_zero_iff]
  rintro ⟨i, hi, h0⟩
  have hmem : a i ∈ Ideal.span {a i, b i} := Ideal.subset_span (by simp)
  rw [h0, Ideal.zero_eq_bot, Ideal.mem_bot] at hmem
  exact ha i hi hmem

namespace SeparableGoUp

open CompleteCaseStep

/-- **No centre of a contracted curve on a modification where `(c₀, c)` becomes principal has
residue field algebraic over the base.** Let `π : Z ⟶ X'` lie over `Spec B ⟶ Spec A` through
`g' : Z ⟶ Spec B` and `f' : X' ⟶ Spec A`, and let `t ∈ 𝒪_{Y,y}` satisfy `c₀ * t = c` with
`c, c₀ ∈ A` and residue not integral over `κ(q y)`. If `(c₀, c) * K` is nonzero and principal in
the local ring of `X'` at `π t'`, then no local homomorphism `𝒪_{Z,t'} ⟶ 𝒪_{Y,y}` over
`Spec B` has `κ(t')` integral over the residue field of `Spec B`. -/
theorem false_of_isIntegral_of_span_pair_mul_eq_span_singleton {A B : Type u} [CommRing A]
    [CommRing B] [IsDomain B] [Algebra A B] [FaithfulSMul A B] {X' Z Y : Scheme.{u}}
    [IsIntegral X'] [IsIntegral Y] (f' : X' ⟶ Spec (.of A)) (π : Z ⟶ X') (g' : Z ⟶ Spec (.of B))
    (hcomm : π ≫ f' = g' ≫ Spec.map (CommRingCat.ofHom (algebraMap A B)))
    (q : Y ⟶ Spec (.of B)) (hq : IsBirational q) {y : Y} {c c₀ : A} {t : Y.presheaf.stalk y}
    (hc₀ : baseRingToStalk q y (algebraMap A B c₀) ≠ 0)
    (ht : baseRingToStalk q y (algebraMap A B c₀) * t = baseRingToStalk q y (algebraMap A B c))
    (htr : ¬ (q.residueFieldMap y).hom.IsIntegralElem (Y.residue y t)) {K : Ideal A}
    (hJ : Ideal.span {c₀, c} * K ≠ ⊥) {t' : Z} {d : X'.presheaf.stalk (π t')}
    (hd : (Ideal.span {c₀, c} * K).map (baseRingToStalk f' (π t')) = Ideal.span {d})
    (ψ : Z.presheaf.stalk t' ⟶ Y.presheaf.stalk y) [IsLocalHom ψ.hom] (ht' : g' t' = q y)
    (hψ : g'.stalkMap t' ≫ ψ =
      ((Spec (.of B)).presheaf.stalkCongr (.of_eq ht')).hom ≫ q.stalkMap y)
    (hint : (g'.residueFieldMap t').hom.IsIntegral) : False := by
  let α := baseRingToStalk f' (π t')
  let β := (π.stalkMap t').hom
  let γ := (baseRingToStalk q y).comp (algebraMap A B)
  have hcompat (a : A) : ψ.hom (β (α a)) = γ a := by
    have h1 : β (α a) = baseRingToStalk g' t' (algebraMap A B a) := by
      rw [← RingHom.comp_apply, ← baseRingToStalk_comp, hcomm, baseRingToStalk_comp_SpecMap]
      rfl
    rw [h1]
    change (g'.stalkMap t' ≫ ψ).hom (StructureSheaf.toStalk B (g' t') (algebraMap A B a)) = _
    rw [hψ]
    change (q.stalkMap y).hom (((Spec (.of B)).presheaf.stalkCongr (.of_eq ht')).hom
      (StructureSheaf.toStalk B (g' t') (algebraMap A B a))) = _
    rw [stalkCongr_toStalk ht']
    rfl
  have hγ : Function.Injective γ :=
    (baseRingToStalk_injective q hq y).comp (FaithfulSMul.algebraMap_injective A B)
  have hα : Function.Injective α := fun a b hab => hγ (by rw [← hcompat, ← hcompat, hab])
  have hd0 : d ≠ 0 := by
    rintro rfl
    exact hJ ((Ideal.map_eq_bot_iff_of_injective hα).mp
      (hd.trans (Ideal.span_singleton_eq_bot.mpr rfl)))
  have hfac : Ideal.span {α c₀, α c} * K.map α = Ideal.span {d} := by
    rw [← hd]
    change _ = Ideal.map α (Ideal.span {c₀, c} * K)
    rw [Ideal.map_mul, Ideal.map_span, Set.image_pair]
  have hres := isIntegralElem_residue_of_isLocalHom g' q ψ ht' hψ hint
  have hrel (z w : A) (r : X'.presheaf.stalk (π t')) (h : α w = α z * r) :
      γ w = γ z * ψ.hom (β r) := by
    rw [← hcompat, h, map_mul, map_mul, hcompat]
  rcases Ideal.dvd_or_dvd_of_span_pair_mul_eq_span_singleton _ hd0 hfac with ⟨r, hr⟩ | ⟨r, hr⟩
  · -- `c / c₀` is regular at `π t'`
    exact htr (mul_left_cancel₀ hc₀ (ht.trans (hrel _ _ r hr)) ▸ hres (β r))
  · -- `c₀ / c` is regular at `π t'`
    have hrt : t * ψ.hom (β r) = 1 := by
      apply mul_left_cancel₀ hc₀
      rw [mul_one, ← mul_assoc, ht]
      exact (hrel _ _ r hr).symm
    let := (q.residueFieldMap y).hom.toAlgebra
    apply htr
    change _root_.IsIntegral ((Spec (.of B)).residueField (q y)) (Y.residue y t)
    rw [eq_inv_of_mul_eq_one_left (by rw [← map_mul, hrt, map_one] :
      Y.residue y t * Y.residue y (ψ.hom (β r)) = 1)]
    exact (IsAlgebraic.inv_iff.mpr (IsIntegral.isAlgebraic (hres (β r)))).isIntegral

/-- **The reduction step of [Stacks, Tag 0AXL].** Let `A → B` be a finite injective map of
domains with `A` Nagata and `B` a normal local domain of dimension at most two. Every normal
modification `Y` of `Spec B` is dominated by a normal modification `Y'` of `Spec B` which is
finite and surjective over a normal modification `X'` of `Spec A`, compatibly with
`Spec B ⟶ Spec A`.

The modification `X'` is the normalization of the blowup of `Spec A` in a product of ideals
`(c₀, c)`, one for each curve contracted by `Y ⟶ Spec B`, where `c / c₀` is regular at the
generic point of the curve with residue transcendental over `κ_B`; `Y'` is the normalization of
`X'` in the fraction field of `B`. No separability of the extension of fraction fields is used.
-/
theorem isDominatedByFiniteOverBase (A B : Type u) [CommRing A] [IsDomain A] [IsNagataRing A]
    [CommRing B] [IsLocalRing B] [IsNormalDomain B] [Algebra A B] [Module.Finite A B]
    [FaithfulSMul A B] (hdim : ringKrullDim B ≤ 2) : IsDominatedByFiniteOverBase A B := by
  classical
  intro Y _ q hq
  have : IsIntegral Y := hq.source_isIntegral
  have : IsProper q := hq.isProper
  have : IsNagataRing B := IsNagataRing.of_finiteType (A := A) inferInstance
  have : IsNormal (Spec (.of B)) :=
    isNormal_spec_of_isNormalRing (IsNormalRing.of_isIntegrallyClosed B)
  obtain ⟨F, hF, hFy, hlift⟩ :=
    Stacks.ResolutionOfSurfaces.exists_finite_contracted_forall_exists_lift
      (isNagataScheme_spec_of_isNagataRing _ inferInstance)
      ((PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim B).le.trans hdim) q hq.isBirational
  -- at each contracted curve, a ratio of elements of `A` with transcendental residue
  have hdata : ∀ y ∈ F, ∃ c c₀ : A, baseRingToStalk q y (algebraMap A B c₀) ≠ 0 ∧ ∃ t,
      baseRingToStalk q y (algebraMap A B c₀) * t = baseRingToStalk q y (algebraMap A B c) ∧
      ¬ (q.residueFieldMap y).hom.IsIntegralElem (Y.residue y t) := fun y hy => by
    obtain ⟨-, hqy, hdvr, u, hu, a, b, hb, hab⟩ := hFy y hy
    have : IsDiscreteValuationRing (Y.presheaf.stalk y) := hdvr
    exact exists_ratio_not_isIntegralElem_residue q hq.isBirational hqy u hu a b hb hab
  choose! c c₀ hc₀ t ht htr using hdata
  -- the normalized blowup of `Spec A` in the product of the ideals `(c₀, c)`
  have hJ : ∏ y ∈ hF.toFinset, Ideal.span {c₀ y, c y} ≠ ⊥ :=
    Ideal.prod_span_pair_ne_bot _ c₀ c fun y hy h0 =>
      hc₀ y (hF.mem_toFinset.mp hy) (by rw [h0, map_zero, map_zero])
  obtain ⟨X', f', hX'n, hf', hprinc⟩ := exists_isModification_map_eq_span_singleton A _ hJ
  have : IsNormal X' := hX'n
  have : IsIntegral X' := hf'.source_isIntegral
  have : IsProper f' := hf'.isProper
  have hf'b : IsBirational f' := hf'.isBirational
  -- its normalization in the fraction field of `B`
  let g' : (liftToFibreProduct A B hf'b).normalization ⟶ Spec (.of B) := toBase A B hf'b
  let π : (liftToFibreProduct A B hf'b).normalization ⟶ X' := toResolution A B hf'b
  have hg' : IsModification g' := isModification_toBase_of_isNagataRing hf'b
  have : IsNormal (liftToFibreProduct A B hf'b).normalization :=
    CompleteCaseStep.isNormal_normalization hf'b
  have : IsProper g' := hg'.isProper
  have : IsIntegral (liftToFibreProduct A B hf'b).normalization := hg'.source_isIntegral
  have hπ : IsFinite π := isFinite_toResolution_of_isNagataRing hf'b
  have hcomm : π ≫ f' = g' ≫ Spec.map (CommRingCat.ofHom (algebraMap A B)) :=
    toResolution_comp hf'b
  obtain ⟨h, hh⟩ := hlift _ g' hg'.isBirational fun y hy t' ψ ht' _ hψ hint => by
    obtain ⟨d, hd⟩ := hprinc (π t')
    rw [← Finset.mul_prod_erase _ _ (hF.mem_toFinset.mpr hy)] at hJ hd
    exact false_of_isIntegral_of_span_pair_mul_eq_span_singleton f' π g' hcomm q hq.isBirational
      (hc₀ y hy) (ht y hy) (htr y hy) hJ hd ψ ht' hψ hint
  exact ⟨_, X', g', f', π, h, inferInstance, hX'n, hg', hf', hπ,
    surjective_of_isBirational_of_comp_eq π f' g' _ hf'b hg'.isBirational hcomm, hcomm, hh⟩

end SeparableGoUp

