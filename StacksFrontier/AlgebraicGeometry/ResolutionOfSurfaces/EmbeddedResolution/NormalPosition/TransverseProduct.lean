module

public import StacksFrontier.AlgebraicGeometry.DivisorSum.Basic
public import StacksFrontier.AlgebraicGeometry.Etale.NormalCrossings.Defs
public import StacksFrontier.AlgebraicGeometry.F6Rank89.IdealSheafStalk
public import StacksFrontier.AlgebraicGeometry.Morphisms.EtaleBasics.NormalCrossings.Components
public import StacksFrontier.AlgebraicGeometry.ResolutionsAndBounds.IdealSheafStalk
import all StacksFrontier.AlgebraicGeometry.Morphisms.EtaleBasics.NormalCrossings.Components

/-!
# A transversal family of regular divisors has strict normal crossings

Let `W` be a regular locally Noetherian scheme and let `F` be a finite family of effective
Cartier divisors on `W`, each of which is a regular scheme. Suppose that no three distinct
members of `F` pass through a common point, and that wherever two distinct members meet, the
local ring of `W` has dimension two and the two local equations generate its maximal ideal.
Then the sum of the members of `F`, that is, the closed subscheme cut out by the product of
their ideal sheaves, is a strict normal crossings divisor.

## Main results

* `Stacks.ResolutionOfSurfaces.coe_support_prod`: the support of a finite product of ideal
  sheaves is the union of the supports.
* `Stacks.ResolutionOfSurfaces.isStrictNormalCrossingsDivisor_prod_of_transverse`: a
  transversal family of regular effective Cartier divisors multiplies to a strict normal
  crossings divisor.

## Implementation notes

The statement is checked at the stalk at a point `x` of the support. The stalk of the product is
the product of the stalks; members not passing through `x` contribute the unit ideal, and each
member through `x` contributes a principal ideal generated by a nonzerodivisor of the maximal
ideal. At most two members pass through `x`. If only one does, with local equation `f`, the
quotient by `(f)` is the local ring of a regular scheme, hence regular, and `(f)` has height one,
so `f` extends to a regular system of parameters. If two do, with local equations `f` and `g`,
then `[f, g]` generates the maximal ideal of a two-dimensional local ring and so is a regular
system of parameters, and the local equation of the sum is `f g`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry

universe u

namespace Stacks.ResolutionOfSurfaces

/-- The support of a finite product of ideal sheaves is the union of their supports. -/
theorem coe_support_prod {W : Scheme.{u}} (F : Finset W.IdealSheafData) :
    ((∏ Y ∈ F, Y).support : Set W) = ⋃ Y ∈ F, (Y.support : Set W) := by
  classical
  induction F using Finset.induction_on with
  | empty => simp [Scheme.IdealSheafData.one_eq_top]
  | insert Y F hY ih =>
    rw [Finset.prod_insert hY, Scheme.IdealSheafData.support_mul,
      TopologicalSpace.Closeds.coe_sup, ih, Finset.set_biUnion_insert]

/-- The stalk of an ideal sheaf at a point outside its support is the unit ideal. -/
private theorem stalk_eq_one_of_not_mem_support {W : Scheme.{u}} (Y : W.IdealSheafData) (x : W)
    (h : x ∉ (Y.support : Set W)) : IdealSheafData.stalk Y x = 1 := by
  rw [Ideal.one_eq_top]
  exact (IdealSheafData.stalk_eq_top_iff_not_mem_support Y x).mpr h

/-- The stalk of a finite product of ideal sheaves is the product of the stalks. -/
private theorem stalk_prod {W : Scheme.{u}} (F : Finset W.IdealSheafData) (x : W) :
    IdealSheafData.stalk (∏ Y ∈ F, Y) x = ∏ Y ∈ F, IdealSheafData.stalk Y x := by
  classical
  induction F using Finset.induction_on with
  | empty =>
    rw [Finset.prod_empty, Finset.prod_empty, Scheme.IdealSheafData.one_eq_top]
    exact stalk_eq_one_of_not_mem_support _ x fun h => h
  | insert Y F hY ih =>
    rw [Finset.prod_insert hY, Finset.prod_insert hY, IdealSheafData.stalk_mul, ih]

/-- **A transversal family of regular divisors has strict normal crossings.** On a locally
Noetherian scheme, let `F` be a finite family of effective Cartier divisors which are
regular schemes, no three distinct members passing through a common point, and such that at a
common point of two distinct members the local ring is two-dimensional with maximal ideal
generated by the two local equations. Then the product of the ideal sheaves of the members of
`F` is a strict normal crossings divisor. -/
theorem isStrictNormalCrossingsDivisor_prod_of_transverse
    {W : Scheme.{u}} [IsLocallyNoetherian W]
    (F : Finset W.IdealSheafData)
    (hreg : ∀ Y ∈ F, AlgebraicGeometry.IsRegular Y.subscheme)
    (hcart : ∀ Y ∈ F, Stacks.Divisors.IsEffectiveCartierDivisor Y)
    (hthree : ∀ (x : W) (Y₁ Y₂ Y₃ : W.IdealSheafData), Y₁ ∈ F → Y₂ ∈ F → Y₃ ∈ F →
      Y₁ ≠ Y₂ → Y₁ ≠ Y₃ → Y₂ ≠ Y₃ → x ∈ (Y₁.support : Set W) → x ∈ (Y₂.support : Set W) →
      x ∉ (Y₃.support : Set W))
    (htwo : ∀ (x : W) (Y₁ Y₂ : W.IdealSheafData), Y₁ ∈ F → Y₂ ∈ F → Y₁ ≠ Y₂ →
      x ∈ (Y₁.support : Set W) → x ∈ (Y₂.support : Set W) →
      ringKrullDim (W.presheaf.stalk x) = 2 ∧
      AlgebraicGeometry.IdealSheafData.stalk Y₁ x ⊔ AlgebraicGeometry.IdealSheafData.stalk Y₂ x =
        IsLocalRing.maximalIdeal (W.presheaf.stalk x)) :
    Stacks.Divisors.IsStrictNormalCrossingsDivisor (∏ Y ∈ F, Y) := by
  classical
  refine ⟨?_, ?_⟩
  · simpa using Stacks.Divisors.isEffectiveCartierDivisor_prod F id (fun _ => 1) hcart
  intro y
  let x := (∏ Y ∈ F, Y).subschemeι y
  have hx : x ∈ ⋃ Y ∈ F, (Y.support : Set W) := by
    rw [← coe_support_prod, ← Scheme.IdealSheafData.range_subschemeι]
    exact ⟨y, rfl⟩
  obtain ⟨Y₁, hY₁, hx₁⟩ := Set.mem_iUnion₂.mp hx
  obtain ⟨z, hz⟩ : x ∈ Set.range Y₁.subschemeι := by
    rwa [Scheme.IdealSheafData.range_subschemeι]
  have hR : IsRegularLocalRing (W.presheaf.stalk x) := by
    rw [← hz]
    exact Stacks.Divisors.ambient_regular_at_regular_cartier Y₁ (hcart Y₁ hY₁) (hreg Y₁ hY₁) z
  refine ⟨hR, ?_⟩
  rw [Stacks.Divisors.kernel_stalkMap_subscheme, stalk_prod]
  obtain ⟨f, hfm, hfreg, hf⟩ :=
    Stacks.Divisors.exists_regular_generator_at_support Y₁ x (hcart Y₁ hY₁) hx₁
  by_cases h2 : ∃ Y₂ ∈ F, Y₂ ≠ Y₁ ∧ x ∈ (Y₂.support : Set W)
  · obtain ⟨Y₂, hY₂, hne, hx₂⟩ := h2
    obtain ⟨g, -, -, hg⟩ :=
      Stacks.Divisors.exists_regular_generator_at_support Y₂ x (hcart Y₂ hY₂) hx₂
    have hY₂' : Y₂ ∈ F.erase Y₁ := Finset.mem_erase.mpr ⟨hne, hY₂⟩
    have hprod : ∏ Y ∈ F, IdealSheafData.stalk Y x =
        IdealSheafData.stalk Y₁ x * IdealSheafData.stalk Y₂ x := by
      rw [← Finset.mul_prod_erase _ _ hY₁, ← Finset.mul_prod_erase _ _ hY₂',
        Finset.prod_eq_one, mul_one]
      intro Y hY
      obtain ⟨hY2, hY'⟩ := Finset.mem_erase.mp hY
      obtain ⟨hY1, hYF⟩ := Finset.mem_erase.mp hY'
      exact stalk_eq_one_of_not_mem_support Y x
        (hthree x Y₁ Y₂ Y hY₁ hY₂ hYF hne.symm (Ne.symm hY1) (Ne.symm hY2) hx₁ hx₂)
    obtain ⟨hdim, hsup⟩ := htwo x Y₁ Y₂ hY₁ hY₂ hne.symm hx₁ hx₂
    have hgen : Ideal.ofList [f, g] = IsLocalRing.maximalIdeal (W.presheaf.stalk x) := by
      rw [← hsup, hf, hg, Ideal.ofList_cons, Ideal.ofList_singleton]
    refine ⟨[f, g], 2, ⟨?_, ?_⟩, hgen, by norm_num, le_rfl, ?_⟩
    · rw [hgen]
      exact Ideal.IsPrime.radical inferInstance
    · rw [hdim]
      rfl
    · rw [hprod, hf, hg, Ideal.span_singleton_mul_span_singleton]
      simp only [List.take_succ_cons, List.take_zero, List.prod_cons, List.prod_nil, mul_one]
      rfl
  · push Not at h2
    have hprod : ∏ Y ∈ F, IdealSheafData.stalk Y x = IdealSheafData.stalk Y₁ x :=
      Finset.prod_eq_single_of_mem Y₁ hY₁ fun Y hY hne =>
        stalk_eq_one_of_not_mem_support Y x (h2 Y hY hne)
    have hquot : IsRegularLocalRing (W.presheaf.stalk x ⧸ Ideal.ofList [f]) := by
      have key := Stacks.Divisors.regular_stalk_quotient_of_regular_subscheme Y₁
        (hreg Y₁ hY₁) z
      rwa [hz, hf, ← Ideal.ofList_singleton] at key
    have hheight : (Ideal.ofList [f]).height = ([f] : List (W.presheaf.stalk x)).length := by
      rw [Ideal.ofList_singleton, List.length_singleton, Nat.cast_one]
      exact Ideal.height_span_singleton_eq_one_of_mem_nonZeroDivisors
        (isRegular_iff_mem_nonZeroDivisors.mp hfreg) ((IsLocalRing.mem_maximalIdeal f).mp hfm)
    obtain ⟨rs, hgen, hlen, hr, htake⟩ :=
      Stacks.Divisors.exists_parameters_extending_generators [f] hquot hheight
    refine ⟨rs, 1, ⟨?_, ?_⟩, hgen, le_rfl, by simpa using hr, ?_⟩
    · rw [hgen]
      exact Ideal.IsPrime.radical inferInstance
    · rw [← IsRegularLocalRing.spanFinrank_maximalIdeal, hlen]
    · rw [hprod, hf]
      simp only [List.length_singleton] at htake
      rw [htake, List.prod_singleton]

end Stacks.ResolutionOfSurfaces

end
