module

public import Mathlib.RingTheory.Localization.Away.Basic
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.EmbeddedResolution.CartierDescent.ChartSubalgebra

/-!
# The overlap of the two blowup charts is a localization of either chart

Let `A` be a commutative ring with an algebra map to a commutative ring `K` and let `t s : K`
satisfy `t * s = 1`. Write

* `B = Algebra.adjoin A {t}`,
* `C = Algebra.adjoin A {s}`,
* `D = Algebra.adjoin A {t, s}`

for the two chart subalgebras of `K` and their overlap. Since `t ∈ B ⊆ D` and `s = t⁻¹ ∈ D`, the
overlap `D` is `B` with `t` inverted: `D` is `IsLocalization.Away` the element `t` of `B`.

## Main results

* `Stacks.ResolutionOfSurfaces.CartierDescent.chartGen`: the element `t` of the first chart
  `Algebra.adjoin A {t}` — the element one inverts.
* `Stacks.ResolutionOfSurfaces.CartierDescent.adjoin_le_adjoin_pair`: the first chart is
  contained in the overlap.
* `Stacks.ResolutionOfSurfaces.CartierDescent.instAlgebraAdjoinPair`: the overlap as an algebra
  over the first chart, through the inclusion of subalgebras of `K`; its algebra map is described
  by `Stacks.ResolutionOfSurfaces.CartierDescent.algebraMap_adjoin_pair_eq`,
  `Stacks.ResolutionOfSurfaces.CartierDescent.coe_algebraMap_adjoin_pair` and
  `Stacks.ResolutionOfSurfaces.CartierDescent.algebraMap_adjoin_pair_injective`.
* `Stacks.ResolutionOfSurfaces.CartierDescent.exists_pow_mul_mem_adjoin`: a power of `t` carries
  the overlap into the first chart, and
  `Stacks.ResolutionOfSurfaces.CartierDescent.exists_pow_mul_mem_adjoin_symm`: a power of `s`
  carries it into the second chart.
* `Stacks.ResolutionOfSurfaces.CartierDescent.isLocalization_away_adjoin_pair`: **the overlap of
  the two charts is the localization of the first chart away from `t`.**

## Implementation notes

There is no `Algebra ↥B ↥D` instance to be had from Mathlib — `D` is a subalgebra of `K` over
`A`, not over `B` — so one is supplied here, induced by `Subalgebra.inclusion` through
`RingHom.toAlgebra`. It is an instance so that `IsLocalization.Away (chartGen A t) ↥D` can be
stated without a `letI`; since nothing else produces an `Algebra ↥B ↥D`, no diamond is created.
Its algebra map is the inclusion (`algebraMap_adjoin_pair_eq`). That identity is stated through
`RingHom.algebraMap_toAlgebra` rather than proved by `rfl`: the two sides are definitionally equal
only after the `CommRing` structures of the two subalgebras are unfolded, which exhausts the
kernel's unfolding budget.

Nothing about regularity, locality or dimension of `A` is used: the hypothesis is the bare
relation `t * s = 1`.

## References

* [Stacks Project, Tag 0AGT](https://stacks.math.columbia.edu/tag/0AGT)
-/

@[expose] public section

universe u

namespace Stacks.ResolutionOfSurfaces.CartierDescent

variable {A K : Type u} [CommRing A] [CommRing K] [Algebra A K]

variable (A) in
/-- The generator `t` of the first chart, as an element of that chart `Algebra.adjoin A {t}`.
This is the element of the chart which is inverted to produce the overlap of the two charts. -/
public def chartGen (t : K) : Algebra.adjoin A ({t} : Set K) :=
  ⟨t, Algebra.self_mem_adjoin_singleton A t⟩

variable (A) in
/-- `chartGen A t` is `t`, read inside `K`. -/
@[simp]
public theorem coe_chartGen (t : K) : (chartGen A t : K) = t :=
  rfl

/-- **The first chart sits inside the overlap.** The subalgebra of `K` generated by `t` is
contained in the one generated by `t` and `s`. -/
public theorem adjoin_le_adjoin_pair (t s : K) :
    Algebra.adjoin A ({t} : Set K) ≤ Algebra.adjoin A ({t, s} : Set K) :=
  Algebra.adjoin_mono (by simp)

/-- **The overlap is an algebra over the first chart**, through the inclusion
`Algebra.adjoin A {t} ≤ Algebra.adjoin A {t, s}` of subalgebras of `K`. -/
public instance instAlgebraAdjoinPair (t s : K) :
    Algebra ↥(Algebra.adjoin A ({t} : Set K)) ↥(Algebra.adjoin A ({t, s} : Set K)) :=
  (Subalgebra.inclusion (adjoin_le_adjoin_pair t s)).toRingHom.toAlgebra

/-- The algebra map of `instAlgebraAdjoinPair` is the inclusion of the first chart into the
overlap. -/
public theorem algebraMap_adjoin_pair_eq (t s : K) :
    algebraMap ↥(Algebra.adjoin A ({t} : Set K)) ↥(Algebra.adjoin A ({t, s} : Set K)) =
      (Subalgebra.inclusion (adjoin_le_adjoin_pair t s)).toRingHom :=
  RingHom.algebraMap_toAlgebra _

/-- The algebra map from the first chart to the overlap does not move elements of `K`. -/
@[simp]
public theorem coe_algebraMap_adjoin_pair {t s : K} (b : Algebra.adjoin A ({t} : Set K)) :
    ((algebraMap ↥(Algebra.adjoin A ({t} : Set K)) ↥(Algebra.adjoin A ({t, s} : Set K))) b : K)
      = (b : K) := by
  rw [algebraMap_adjoin_pair_eq]
  exact Subalgebra.coe_inclusion (adjoin_le_adjoin_pair t s) b

/-- The algebra map from the first chart to the overlap is injective, the two being subalgebras
of the same ring `K`. -/
public theorem algebraMap_adjoin_pair_injective (t s : K) :
    Function.Injective
      (algebraMap ↥(Algebra.adjoin A ({t} : Set K)) ↥(Algebra.adjoin A ({t, s} : Set K))) :=
  fun _ _ hab => Subtype.ext (by simpa using congrArg Subtype.val hab)

/-- Raising the clearing exponent is harmless: if `t ^ n * z` lies in the first chart and
`n ≤ m`, then so does `t ^ m * z`. -/
public theorem pow_mul_mem_adjoin_of_le {t z : K} {n m : ℕ} (hnm : n ≤ m)
    (hz : t ^ n * z ∈ Algebra.adjoin A ({t} : Set K)) :
    t ^ m * z ∈ Algebra.adjoin A ({t} : Set K) := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le hnm
  rw [show t ^ (n + k) * z = t ^ k * (t ^ n * z) by ring]
  exact mul_mem (pow_mem (Algebra.self_mem_adjoin_singleton A t) k) hz

/-- **A power of `t` carries the overlap into the first chart.** For `t * s = 1` every element
`z` of `Algebra.adjoin A {t, s}` satisfies `t ^ n * z ∈ Algebra.adjoin A {t}` for some `n`: the
overlap of the two charts is the first chart with `t` inverted. -/
public theorem exists_pow_mul_mem_adjoin {t s : K} (hts : t * s = 1) (z : K)
    (hz : z ∈ Algebra.adjoin A ({t, s} : Set K)) :
    ∃ n : ℕ, t ^ n * z ∈ Algebra.adjoin A ({t} : Set K) := by
  induction hz using Algebra.adjoin_induction with
  | mem w hw =>
    rcases hw with rfl | rfl
    · exact ⟨0, by simp⟩
    · exact ⟨1, by simp [hts]⟩
  | algebraMap a => exact ⟨0, by simp⟩
  | add u v _ _ hu hv =>
    obtain ⟨n, hn⟩ := hu
    obtain ⟨m, hm⟩ := hv
    refine ⟨max n m, ?_⟩
    rw [mul_add]
    exact add_mem (pow_mul_mem_adjoin_of_le (le_max_left n m) hn)
      (pow_mul_mem_adjoin_of_le (le_max_right n m) hm)
  | mul u v _ _ hu hv =>
    obtain ⟨n, hn⟩ := hu
    obtain ⟨m, hm⟩ := hv
    refine ⟨n + m, ?_⟩
    rw [show t ^ (n + m) * (u * v) = (t ^ n * u) * (t ^ m * v) by ring]
    exact mul_mem hn hm

/-- **A power of `s` carries the overlap into the second chart**, the mirror image of
`Stacks.ResolutionOfSurfaces.CartierDescent.exists_pow_mul_mem_adjoin` obtained by exchanging the
roles of `t` and `s`; the overlap is unchanged, `{t, s}` and `{s, t}` being the same set. -/
public theorem exists_pow_mul_mem_adjoin_symm {t s : K} (hts : t * s = 1) (z : K)
    (hz : z ∈ Algebra.adjoin A ({t, s} : Set K)) :
    ∃ n : ℕ, s ^ n * z ∈ Algebra.adjoin A ({s} : Set K) :=
  exists_pow_mul_mem_adjoin (by rw [mul_comm]; exact hts) z (by rwa [Set.pair_comm])

/-- **The overlap of the two charts is the localization of the first chart away from `t`.**
For `t * s = 1` the subalgebra `Algebra.adjoin A {t, s}` of `K` is the localization of
`Algebra.adjoin A {t}` at the powers of `chartGen A t`, with respect to the inclusion algebra
structure `instAlgebraAdjoinPair`.

Geometrically: the overlap of the two standard affine charts `A[𝔪/x]`, `A[𝔪/y]` of the blowup of
a regular local surface at its closed point is the locus `t ≠ 0` on the first chart. -/
public theorem isLocalization_away_adjoin_pair {t s : K} (hts : t * s = 1) :
    IsLocalization.Away (chartGen A t) ↥(Algebra.adjoin A ({t, s} : Set K)) := by
  refine IsLocalization.Away.mk _ ?_ (fun z => ?_) (fun a b hab => ?_)
  · refine IsUnit.of_mul_eq_one ⟨s, Algebra.subset_adjoin (by simp)⟩ (Subtype.ext ?_)
    simpa using hts
  · obtain ⟨n, hn⟩ := exists_pow_mul_mem_adjoin hts (z : K) z.2
    refine ⟨n, ⟨t ^ n * (z : K), hn⟩, Subtype.ext ?_⟩
    simpa using mul_comm (z : K) (t ^ n)
  · exact ⟨0, by simpa using algebraMap_adjoin_pair_injective t s hab⟩

end Stacks.ResolutionOfSurfaces.CartierDescent

end
