module

public import Mathlib.Algebra.MvPolynomial.Equiv
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic
public import Mathlib.RingTheory.Polynomial.Quotient
public import StacksFrontier.RingTheory.AffineBlowup.ModelComparison
public import StacksFrontier.RingTheory.Koszul.Blowup
public import StacksFrontier.RingTheory.Koszul.Regular
public import StacksFrontier.RingTheory.RegularLocalRing.Basic

/-!
# The fibre of a standard chart of the blowup of a regular local surface

Let `(A, 𝔪, κ)` be a regular local ring of dimension two, and let `x, y` be a pair of elements
spanning `𝔪`. The blowup of `Spec A` at its closed point is covered by the two standard affine
charts `Spec A[𝔪/x]` and `Spec A[𝔪/y]`, and the exceptional divisor is cut out on the first of
them by the image of `x`. This file computes that fibre: killing `x` in the chart `A[𝔪/x]`
leaves the polynomial ring `κ[T]` in one variable over the residue field, so the exceptional
divisor meets the chart in an affine line `𝔸¹_κ`.

Since `x, y` is a regular sequence spanning `𝔪`, the chart is `A[T]/(xT - y)`; adding `x` to the
relations gives `A[T]/(x, y) = A[T]/𝔪·A[T] = κ[T]`, because `(xT - y, x) = (x, y)` as ideals of
`A[T]`.

## Main results

* `Stacks.ResolutionOfSurfaces.CartierDescent.nonempty_algEquiv_quotient_span_algebraMap`: the
  chart `A[𝔪/x]` modulo the image of `x` is the polynomial ring `κ[T]`.
* `Stacks.ResolutionOfSurfaces.CartierDescent.isDomain_quotient_span_algebraMap`: that quotient
  is a domain.
* `Stacks.ResolutionOfSurfaces.CartierDescent.not_isUnit_algebraMap_x`: `x` is not a unit in the
  chart, so the exceptional divisor really does meet the chart.

## Implementation notes

The chart is `affineBlowup (Ideal.span {x, y}) x`, the subalgebra of `Localization.Away x`
generated by the fractions `z/x` with `z ∈ (x, y)`; this is the realization the affine charts of
the blowup of a *scheme* are the spectra of (`Stacks.Blowup.blowUpAffineChart`). The presentation
as `A[T]/(xT - y)` is stated in the development over `affineBlowupAlgebraAway`, and the two
subalgebras agree by `affineBlowup_eq_affineBlowupAlgebra` together with
`affineBlowupAlgebraAway_eq_affineBlowupAlgebra`; no hypothesis on `x` is needed for that
identification.

Every statement comes in two forms: one taking the regular sequence `x, y` as an explicit
hypothesis, which is the form a caller already holding a regular system of parameters wants, and
one taking only `ringKrullDim A = 2`, from which the regular sequence is produced by Stacks tag
00NQ (`IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay`).
Neither the dimension nor the locality of `A` is needed for the computation itself: over an
arbitrary commutative ring the quotient is `MvPolynomial (Fin 1) (A ⧸ (x, y))`, and that is what
`nonempty_algEquiv_quotient_mvPolynomial_of_isRegular` records.

The one-variable polynomial ring is reached as `MvPolynomial (Fin 1) κ` — the shape the
presentation of the affine blowup algebra produces — and then transported to `Polynomial κ` by
`MvPolynomial.uniqueAlgEquiv`, whose scalars are restricted from `κ` to `A`. The identification
`κ = A ⧸ 𝔪` is definitional, so no bridge is needed there.

## References

* [Stacks Project, Tag 0AGT](https://stacks.math.columbia.edu/tag/0AGT)
* [Stacks Project, Tag 0AGR](https://stacks.math.columbia.edu/tag/0AGR)
-/

@[expose] public noncomputable section

open IsLocalRing MvPolynomial

universe u

namespace Stacks.ResolutionOfSurfaces.CartierDescent

variable {A : Type u} [CommRing A]

/-! ### The presentation of the chart -/

omit [CommRing A] in
/-- The range of the two-element family built from `x` and `y` by `Fin.cases`. -/
private lemma range_fin_cases_pair (x y : A) :
    Set.range (Fin.cases x (fun _ : Fin 1 => y) : Fin 2 → A) = {x, y} := by
  ext z
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff]
  constructor
  · rintro ⟨i, rfl⟩
    exact Fin.cases (Or.inl rfl) (fun _ => Or.inr rfl) i
  · rintro (rfl | rfl)
    · exact ⟨0, rfl⟩
    · exact ⟨1, rfl⟩

/-- The `Localization.mk` realization of the affine blowup algebra, which the scheme charts are
the spectra of, is the realization the presentation of Stacks tag 0BIQ is stated over. -/
private lemma affineBlowup_eq_affineBlowupAlgebraAway (I : Ideal A) (a : A) :
    affineBlowup I a = affineBlowupAlgebraAway I a := by
  rw [affineBlowup_eq_affineBlowupAlgebra, ← affineBlowupAlgebraAway_eq_affineBlowupAlgebra]

/-- The standard chart of the blowup of `Ideal.span {x, y}` at `x` is `A[T]/(xT - y)` when
`x, y` is a regular sequence. -/
private lemma nonempty_presentation (x y : A) (hreg : RingTheory.Sequence.IsRegular A [x, y]) :
    Nonempty (affineBlowup (Ideal.span ({x, y} : Set A)) x ≃ₐ[A]
      MvPolynomial (Fin 1) A ⧸ Ideal.span {C x * X (0 : Fin 1) - C y}) := by
  have hH : Koszul.IsH1Regular (Fin.cases x (fun _ : Fin 1 => y) : Fin 2 → A) := by
    have hlist : List.ofFn (Fin.cases x (fun _ : Fin 1 => y) : Fin 2 → A) = [x, y] := by
      simp [List.ofFn_succ]
    exact ((Koszul.isKoszulRegularOn_and_isKoszulRegular_of_regular (M := A)).2.2
      (by rw [hlist]; exact hreg)).isH1Regular
  obtain ⟨e⟩ := Koszul.exists_affineBlowup_algEquiv_mvPolynomial_quotient_of_isH1Regular _ hH
  rw [range_fin_cases_pair] at e
  have hrel : Ideal.span (Set.range fun i : Fin 1 ↦
        C ((Fin.cases x (fun _ : Fin 1 => y) : Fin 2 → A) 0) * X i -
          C ((Fin.cases x (fun _ : Fin 1 => y) : Fin 2 → A) i.succ)) =
      Ideal.span ({C x * X (0 : Fin 1) - C y} : Set (MvPolynomial (Fin 1) A)) := by
    congr 1
    exact Set.range_unique
  rw [hrel] at e
  exact ⟨(Subalgebra.equivOfEq _ _
    (affineBlowup_eq_affineBlowupAlgebraAway (Ideal.span ({x, y} : Set A)) x)).trans e⟩

/-! ### Adding the denominator to the relations -/

/-- Adjoining `x` to the relation `xT - y` of the presented chart gives the ideal generated by
`x` and `y`: indeed `xT - y ∈ (x, y)` and `y = xT - (xT - y) ∈ (x, xT - y)`. -/
private lemma span_sub_sup_span_C (x y : A) :
    Ideal.span ({C x * X (0 : Fin 1) - C y} : Set (MvPolynomial (Fin 1) A)) ⊔
        Ideal.span {(C x : MvPolynomial (Fin 1) A)} =
      Ideal.map (C : A →+* MvPolynomial (Fin 1) A) (Ideal.span ({x, y} : Set A)) := by
  rw [Ideal.map_span, ← Ideal.span_union]
  have himg : (C : A →+* MvPolynomial (Fin 1) A) '' ({x, y} : Set A) = {C x, C y} := by simp
  rw [himg]
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rw [Set.union_subset_iff, Set.singleton_subset_iff, Set.singleton_subset_iff]
    exact ⟨Ideal.mem_span_pair.mpr ⟨X 0, -1, by ring⟩, Ideal.mem_span_pair.mpr ⟨1, 0, by ring⟩⟩
  · rw [Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨Ideal.subset_span (Or.inr (Set.mem_singleton _)),
      Ideal.mem_span_pair.mpr ⟨-1, X 0, by ring⟩⟩

/-- The fibre of the chart, computed as a polynomial ring over `A ⧸ J` for any ideal `J` that
`x` and `y` span. -/
private lemma nonempty_quotient_equiv_mvPolynomial (x y : A)
    (hreg : RingTheory.Sequence.IsRegular A [x, y]) (J : Ideal A)
    (hJ : Ideal.span ({x, y} : Set A) = J) :
    Nonempty ((affineBlowup (Ideal.span ({x, y} : Set A)) x ⧸
        Ideal.span {algebraMap A (affineBlowup (Ideal.span ({x, y} : Set A)) x) x}) ≃ₐ[A]
      MvPolynomial (Fin 1) (A ⧸ J)) := by
  obtain ⟨e⟩ := nonempty_presentation x y hreg
  have e1 : (affineBlowup (Ideal.span ({x, y} : Set A)) x ⧸
        Ideal.span {algebraMap A (affineBlowup (Ideal.span ({x, y} : Set A)) x) x}) ≃ₐ[A]
      ((MvPolynomial (Fin 1) A ⧸ Ideal.span {C x * X (0 : Fin 1) - C y}) ⧸
        Ideal.span {algebraMap A (MvPolynomial (Fin 1) A ⧸
          Ideal.span {C x * X (0 : Fin 1) - C y}) x}) :=
    Ideal.quotientEquivAlg _ _ e (by
      rw [Ideal.map_span, Set.image_singleton]
      congr 2
      exact (e.commutes x).symm)
  have e2 : ((MvPolynomial (Fin 1) A ⧸ Ideal.span {C x * X (0 : Fin 1) - C y}) ⧸
        Ideal.span {algebraMap A (MvPolynomial (Fin 1) A ⧸
          Ideal.span {C x * X (0 : Fin 1) - C y}) x}) ≃ₐ[A]
      ((MvPolynomial (Fin 1) A ⧸ Ideal.span {C x * X (0 : Fin 1) - C y}) ⧸
        Ideal.map (Ideal.Quotient.mkₐ A (Ideal.span
            ({C x * X (0 : Fin 1) - C y} : Set (MvPolynomial (Fin 1) A))))
          (Ideal.span {(C x : MvPolynomial (Fin 1) A)})) :=
    Ideal.quotientEquivAlgOfEq A (by rw [Ideal.map_span, Set.image_singleton]; rfl)
  have e3 := DoubleQuot.quotQuotEquivQuotSupₐ A
    (Ideal.span ({C x * X (0 : Fin 1) - C y} : Set (MvPolynomial (Fin 1) A)))
    (Ideal.span {(C x : MvPolynomial (Fin 1) A)})
  have e4 : (MvPolynomial (Fin 1) A ⧸
        (Ideal.span ({C x * X (0 : Fin 1) - C y} : Set (MvPolynomial (Fin 1) A)) ⊔
          Ideal.span {(C x : MvPolynomial (Fin 1) A)})) ≃ₐ[A]
      (MvPolynomial (Fin 1) A ⧸ Ideal.map (C : A →+* MvPolynomial (Fin 1) A) J) :=
    Ideal.quotientEquivAlgOfEq A ((span_sub_sup_span_C x y).trans (by rw [hJ]))
  exact ⟨e1.trans (e2.trans (e3.trans (e4.trans
    (MvPolynomial.quotientEquivQuotientMvPolynomial (σ := Fin 1) J).symm)))⟩

/-! ### The fibre of the chart -/

/-- **The fibre of a standard chart of the blowup of a two-generated ideal.** If `x, y` is a
regular sequence in a commutative ring `A`, then killing `x` in the affine blowup algebra
`A[(x, y)/x]` leaves the polynomial ring in one variable over `A ⧸ (x, y)`. -/
public theorem nonempty_algEquiv_quotient_mvPolynomial_of_isRegular (x y : A)
    (hreg : RingTheory.Sequence.IsRegular A [x, y]) :
    Nonempty ((affineBlowup (Ideal.span ({x, y} : Set A)) x ⧸
        Ideal.span {algebraMap A (affineBlowup (Ideal.span ({x, y} : Set A)) x) x}) ≃ₐ[A]
      MvPolynomial (Fin 1) (A ⧸ Ideal.span ({x, y} : Set A))) :=
  nonempty_quotient_equiv_mvPolynomial x y hreg _ rfl

/-- **The fibre of a standard chart of the blowup of a regular local ring at its closed point is
a polynomial line**, given a regular sequence `x, y` spanning the maximal ideal: killing `x` in
the chart `A[𝔪/x]` leaves `κ[T]`, the polynomial ring in one variable over the residue field. -/
public theorem nonempty_algEquiv_quotient_span_algebraMap_of_isRegular (A : Type u) [CommRing A]
    [IsLocalRing A] {x y : A} (hreg : RingTheory.Sequence.IsRegular A [x, y])
    (hspan : Ideal.span ({x, y} : Set A) = IsLocalRing.maximalIdeal A) :
    Nonempty ((affineBlowup (Ideal.span ({x, y} : Set A)) x ⧸
        Ideal.span {algebraMap A (affineBlowup (Ideal.span ({x, y} : Set A)) x) x}) ≃ₐ[A]
      Polynomial (IsLocalRing.ResidueField A)) := by
  obtain ⟨e⟩ := nonempty_quotient_equiv_mvPolynomial x y hreg (maximalIdeal A) hspan
  exact ⟨e.trans ((MvPolynomial.uniqueAlgEquiv (ResidueField A) (Fin 1)).restrictScalars A)⟩

/-! ### The regular sequence from the dimension -/

/-- A pair spanning the maximal ideal of a regular local ring of dimension two is a regular
sequence, by Stacks tag 00NQ. -/
private lemma isRegular_pair_of_span_eq_maximalIdeal (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) {x y : A}
    (hspan : Ideal.span ({x, y} : Set A) = IsLocalRing.maximalIdeal A) :
    RingTheory.Sequence.IsRegular A [x, y] := by
  have hsf : (maximalIdeal A).spanFinrank = 2 := by
    have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
    rw [hdim] at h
    exact_mod_cast h
  have hofList : Ideal.ofList [x, y] = maximalIdeal A := by
    rw [← hspan, Ideal.ofList_cons, Ideal.ofList_cons, Ideal.ofList_nil]
    simp [Ideal.span_insert]
  exact ((IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
    A).1 [x, y] hofList (by simp [hsf])).1

/-- **The fibre of a standard chart of the blowup of a regular local surface at its closed point
is a polynomial line.** Let `(A, 𝔪, κ)` be a regular local ring with `ringKrullDim A = 2` and let
`x, y` span `𝔪`. Then killing `x` in the standard chart `A[𝔪/x]` leaves the polynomial ring
`κ[T]` in one variable over the residue field; geometrically, the exceptional divisor meets the
chart in an affine line over `κ`. -/
public theorem nonempty_algEquiv_quotient_span_algebraMap (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) {x y : A}
    (hspan : Ideal.span ({x, y} : Set A) = IsLocalRing.maximalIdeal A) :
    Nonempty ((affineBlowup (Ideal.span ({x, y} : Set A)) x ⧸
        Ideal.span {algebraMap A (affineBlowup (Ideal.span ({x, y} : Set A)) x) x}) ≃ₐ[A]
      Polynomial (IsLocalRing.ResidueField A)) :=
  nonempty_algEquiv_quotient_span_algebraMap_of_isRegular A
    (isRegular_pair_of_span_eq_maximalIdeal A hdim hspan) hspan

/-! ### Consequences -/

/-- The chart modulo `x` is a domain, given a regular sequence `x, y` spanning the maximal
ideal: it is a polynomial ring in one variable over the residue field. -/
public theorem isDomain_quotient_span_algebraMap_of_isRegular (A : Type u) [CommRing A]
    [IsLocalRing A] {x y : A} (hreg : RingTheory.Sequence.IsRegular A [x, y])
    (hspan : Ideal.span ({x, y} : Set A) = IsLocalRing.maximalIdeal A) :
    IsDomain (affineBlowup (Ideal.span ({x, y} : Set A)) x ⧸
      Ideal.span {algebraMap A (affineBlowup (Ideal.span ({x, y} : Set A)) x) x}) := by
  obtain ⟨e⟩ := nonempty_algEquiv_quotient_span_algebraMap_of_isRegular A hreg hspan
  exact MulEquiv.isDomain (Polynomial (ResidueField A)) e.toMulEquiv

/-- **The chart of the blowup of a regular local surface modulo the denominator is a
one-dimensional domain.** For `(A, 𝔪)` regular local of dimension two and `x, y` spanning `𝔪`,
the quotient of `A[𝔪/x]` by the image of `x` is a domain, being the polynomial ring in one
variable over the residue field. -/
public theorem isDomain_quotient_span_algebraMap (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) {x y : A}
    (hspan : Ideal.span ({x, y} : Set A) = IsLocalRing.maximalIdeal A) :
    IsDomain (affineBlowup (Ideal.span ({x, y} : Set A)) x ⧸
      Ideal.span {algebraMap A (affineBlowup (Ideal.span ({x, y} : Set A)) x) x}) :=
  isDomain_quotient_span_algebraMap_of_isRegular A
    (isRegular_pair_of_span_eq_maximalIdeal A hdim hspan) hspan

/-- `x` is not a unit in the chart `A[𝔪/x]`, given a regular sequence `x, y` spanning `𝔪`: the
quotient by the ideal it generates is a polynomial ring over a field, hence nonzero. -/
public theorem not_isUnit_algebraMap_of_isRegular (A : Type u) [CommRing A] [IsLocalRing A]
    {x y : A} (hreg : RingTheory.Sequence.IsRegular A [x, y])
    (hspan : Ideal.span ({x, y} : Set A) = IsLocalRing.maximalIdeal A) :
    ¬ IsUnit (algebraMap A (affineBlowup (Ideal.span ({x, y} : Set A)) x) x) := by
  intro hu
  have : IsDomain (affineBlowup (Ideal.span ({x, y} : Set A)) x ⧸
      Ideal.span {algebraMap A (affineBlowup (Ideal.span ({x, y} : Set A)) x) x}) :=
    isDomain_quotient_span_algebraMap_of_isRegular A hreg hspan
  exact (Ideal.Quotient.nontrivial_iff.mp inferInstance) (Ideal.span_singleton_eq_top.mpr hu)

/-- **The denominator of a standard chart of the blowup of a regular local surface is not a unit
there.** For `(A, 𝔪)` regular local of dimension two and `x, y` spanning `𝔪`, the image of `x`
in `A[𝔪/x]` is not invertible, so the exceptional divisor meets the chart. -/
public theorem not_isUnit_algebraMap_x (A : Type u) [CommRing A] [IsRegularLocalRing A]
    (hdim : ringKrullDim A = 2) {x y : A}
    (hspan : Ideal.span ({x, y} : Set A) = IsLocalRing.maximalIdeal A) :
    ¬ IsUnit (algebraMap A (affineBlowup (Ideal.span ({x, y} : Set A)) x) x) :=
  not_isUnit_algebraMap_of_isRegular A
    (isRegular_pair_of_span_eq_maximalIdeal A hdim hspan) hspan

end Stacks.ResolutionOfSurfaces.CartierDescent

end
