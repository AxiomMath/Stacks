module

public import StacksFrontier.AlgebraicGeometry.Blowup.DerivedPullbackAnnihilation

/-!
# The charts of a generating family cover a blowup over an affine open

Let `S` be a scheme, `ℐ` a quasi-coherent sheaf of ideals on `S`, `b : X' ⟶ S` the blowup of `S`
in `ℐ` and `U ⊆ S` an affine open. The second assertion of Stacks tag 0804,
`Stacks.Blowup.iSup_opensRange_blowUpAffineChart`, covers `b⁻¹(U)` by the charts
`Spec Γ(S, U)[ℐ(U)/a]` indexed by *all* sections `a ∈ ℐ(U)`. This file cuts the index set down
to a generating family of `ℐ(U)`: if `ℐ(U)` is spanned by the range of `g : ι → Γ(S, U)`, then
the `ι` charts attached to the `g i` already cover `b⁻¹(U)`.

In particular a two-generated centre needs only two charts, which is the cover
`Spec A[𝔪/x] ∪ Spec A[𝔪/y]` of the blowup of a two-dimensional regular local ring `A` at its
closed point used to compute sections and stalks on such a blowup.

The mathematical content is the local statement at the level of `Proj` of the Rees algebra,
`Stacks.Blowup.iSup_opensRange_specAffineBlowupι_of_eq_span`: the degree-one part of the Rees
algebra is a copy of `ℐ(U)`, so it is spanned by the degree-one elements `(g i)⁽¹⁾`, the Rees
algebra is generated in degree one over its degree-zero part, and therefore the standard opens
`D₊((g i)⁽¹⁾)` cover. What is added here is the transport of that statement along the chart
`b⁻¹(U) ≅ Proj (Γ(S, U)[ℐ(U)t])`, exactly as in
`Stacks.Blowup.iSup_opensRange_blowUpAffineChart`.

## Main results

* `Stacks.Blowup.iSup_opensRange_blowUpAffineChart_of_le_span`: the charts attached to a
  generating family of `ℐ(U)` cover `b⁻¹(U)`.
* `Stacks.Blowup.exists_mem_opensRange_blowUpAffineChart_of_span`: the elementwise form of the
  same statement.
* `Stacks.Blowup.iSup_opensRange_blowUpAffineChart_pair`: for `ℐ(U) = (a, b)` the two charts
  `Spec Γ(S, U)[ℐ(U)/a]` and `Spec Γ(S, U)[ℐ(U)/b]` cover `b⁻¹(U)`.
* `Stacks.Blowup.mem_opensRange_blowUpAffineChart_pair`: the elementwise form of the two-chart
  cover, which is what consumers use.

## Implementation notes

The hypothesis of the family version is the inequality `ℐ(U) ≤ span (range g)` rather than an
equality: the reverse inclusion is forced by `hg : ∀ i, g i ∈ ℐ(U)`, and the inequality is the
direction a caller has to hand. No finiteness of `ι` is required.

The pair version is the instance `ι := Fin 2`, `g := ![a, b]`. Since `![a, b] 0` and `![a, b] 1`
are definitionally `a` and `b`, and membership proofs are propositionally irrelevant, the two
charts of that family are *the same morphisms* as the charts attached to `a` and to `b`, so the
two statements differ only by unfolding `⨆ i : Fin 2` into a binary `⊔`.

## References

* [Stacks Project, Tag 0804](https://stacks.math.columbia.edu/tag/0804)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace Stacks.Blowup

variable {S : Scheme.{u}} (ℐ : S.IdealSheafData) (U : S.affineOpens)

/-- **The charts attached to a generating family of the centre cover the blowup over an affine
open.** This refines the second assertion of Stacks tag 0804,
`Stacks.Blowup.iSup_opensRange_blowUpAffineChart`, where the charts are indexed by all of
`ℐ(U)`, to the subfamily indexed by a generating family of `ℐ(U)`. -/
public theorem iSup_opensRange_blowUpAffineChart_of_le_span {ι : Type*} (g : ι → Γ(S, U.1))
    (hg : ∀ i, g i ∈ ℐ.ideal U) (hspan : ℐ.ideal U ≤ Ideal.span (Set.range g)) :
    ⨆ i, (blowUpAffineChart ℐ U (hg i)).opensRange = blowUpToBase ℐ ⁻¹ᵁ (U : S.Opens) := by
  have heq : ℐ.ideal U = Ideal.span (Set.range g) :=
    le_antisymm hspan (Ideal.span_le.mpr (Set.range_subset_iff.mpr hg))
  rw [blowUpToBase_preimage_coe]
  simp only [blowUpAffineChart, Scheme.Hom.opensRange_comp, ← Scheme.Hom.image_iSup,
    iSup_opensRange_specAffineBlowupι_of_eq_span _ hg heq, Scheme.Hom.image_top_eq_opensRange]

/-- Every point of the blowup lying over an affine open `U` lies on the chart attached to some
member of a generating family of `ℐ(U)`. -/
public theorem exists_mem_opensRange_blowUpAffineChart_of_span {ι : Type*} (g : ι → Γ(S, U.1))
    (hg : ∀ i, g i ∈ ℐ.ideal U) (hspan : ℐ.ideal U ≤ Ideal.span (Set.range g))
    (x : blowUp ℐ) (hx : blowUpToBase ℐ x ∈ (U : S.Opens)) :
    ∃ i, x ∈ (blowUpAffineChart ℐ U (hg i)).opensRange :=
  Opens.mem_iSup.mp
    ((iSup_opensRange_blowUpAffineChart_of_le_span ℐ U g hg hspan).symm ▸ (hx : x ∈ _))

/-- **The blowup of a two-generated centre is covered by the two corresponding affine charts over
an affine open.** If `ℐ(U)` is generated by `a` and `b`, then `b⁻¹(U)` is the union of the images
of the charts `Spec Γ(S, U)[ℐ(U)/a]` and `Spec Γ(S, U)[ℐ(U)/b]`. -/
public theorem iSup_opensRange_blowUpAffineChart_pair {a b : Γ(S, U.1)} (ha : a ∈ ℐ.ideal U)
    (hb : b ∈ ℐ.ideal U) (hspan : ℐ.ideal U = Ideal.span {a, b}) :
    (blowUpAffineChart ℐ U ha).opensRange ⊔ (blowUpAffineChart ℐ U hb).opensRange =
      blowUpToBase ℐ ⁻¹ᵁ (U : S.Opens) := by
  have hg : ∀ i : Fin 2, (![a, b] : Fin 2 → Γ(S, U.1)) i ∈ ℐ.ideal U := by
    rw [Fin.forall_fin_two]; exact ⟨ha, hb⟩
  have hrange : Set.range (![a, b] : Fin 2 → Γ(S, U.1)) = {a, b} := by
    ext z; simp [or_comm]
  have hcover := iSup_opensRange_blowUpAffineChart_of_le_span ℐ U ![a, b] hg
    (by rw [hrange, hspan])
  rw [← hcover]
  refine le_antisymm (sup_le
    (le_iSup (fun i : Fin 2 => (blowUpAffineChart ℐ U (hg i)).opensRange) 0)
    (le_iSup (fun i : Fin 2 => (blowUpAffineChart ℐ U (hg i)).opensRange) 1)) (iSup_le ?_)
  rw [Fin.forall_fin_two]
  exact ⟨le_sup_left, le_sup_right⟩

/-- **Elementwise form of the two-chart cover.** A point of the blowup lying over an affine open
`U` on which the centre is generated by `a` and `b` lies on the chart of `a` or on the chart of
`b`. -/
public theorem mem_opensRange_blowUpAffineChart_pair {a b : Γ(S, U.1)} (ha : a ∈ ℐ.ideal U)
    (hb : b ∈ ℐ.ideal U) (hspan : ℐ.ideal U = Ideal.span {a, b}) (x : blowUp ℐ)
    (hx : blowUpToBase ℐ x ∈ (U : S.Opens)) :
    x ∈ (blowUpAffineChart ℐ U ha).opensRange ∨
      x ∈ (blowUpAffineChart ℐ U hb).opensRange :=
  Opens.mem_sup.mp
    ((iSup_opensRange_blowUpAffineChart_pair ℐ U ha hb hspan).symm ▸ (hx : x ∈ _))

end Stacks.Blowup

end
