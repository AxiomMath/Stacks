module

public import Mathlib.RingTheory.Length
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.EmbeddedResolution.CartierDescent.FiniteColength

/-!
# Two length steps in the colength drop of a residual ideal

This file isolates the two purely length-theoretic steps of the colength drop of
[Stacks, Tag 0AGT], so that the geometric argument can quote them.

The first replaces a colength by the length of the image of a principal ideal: if `v` is a
nonzerodivisor of a commutative ring `O` and `b` is an ideal, the image of `(v)` in `O ⧸ (v)·b`
is isomorphic to `O ⧸ b`. Applied at a point of the blowup with `v` the local equation of the
exceptional divisor, this says that the colength of the residual ideal sheaf is the length of the
image of `𝒪_X(-dE)` in `𝒪_X/L𝒪_X` — a module which, unlike the residual ideal sheaf itself, is
canonical, and which receives the global functions of the base.

The second is the final strict inequality: a proper ideal `W` of `A` containing `L` has image in
`A ⧸ L` of strictly smaller length, as soon as `A ⧸ L` has finite length.

## Main results

* `Stacks.ResolutionOfSurfaces.CartierDescent.nonempty_linearEquiv_map_span_singleton` and
  `Stacks.ResolutionOfSurfaces.CartierDescent.length_map_span_singleton_mul` — the image of `(v)`
  in `O ⧸ (v)·b` is `O ⧸ b`, and the two lengths agree over any base.
* `Stacks.ResolutionOfSurfaces.CartierDescent.length_submodule_quotient_lt` and
  `Stacks.ResolutionOfSurfaces.CartierDescent.map_mkQ_ne_top` — the strict inequality, and the
  properness of the image of a proper ideal.

## Implementation notes

`Ideal.span {v} * b` is `{v * c | c ∈ b}` because `b` is an ideal, which is what makes the map
`w ↦ v * w` have kernel exactly `b`; that is `mem_span_singleton_mul_iff` below, and the
nonzerodivisor hypothesis enters only there.

The strict inequality is `Submodule.length_lt` of Mathlib, stated here for an arbitrary proper
`A`-submodule of `A ⧸ L` so that the caller need not match a particular spelling of the image;
the Artinian and Noetherian instances it needs come from the finite length of `A ⧸ L` and from
`A` being a Noetherian ring. `map_mkQ_ne_top` supplies the properness for the image of a proper
ideal `W ⊇ L`.

## References

* [Stacks Project, Tag 0AGT](https://stacks.math.columbia.edu/tag/0AGT)
-/

@[expose] public noncomputable section

universe u v

namespace Stacks.ResolutionOfSurfaces.CartierDescent

variable {O : Type u} [CommRing O]

/-- Membership in `(v)·b` for an ideal `b`: an element of `(v)·b` is `v` times an element of `b`,
and conversely. -/
public theorem mem_span_singleton_mul_iff {v : O} {b : Ideal O} {w : O} :
    w ∈ Ideal.span ({v} : Set O) * b ↔ ∃ c ∈ b, w = v * c := by
  constructor
  · intro hw
    refine Submodule.mul_induction_on hw ?_ ?_
    · intro a ha c hc
      obtain ⟨k, rfl⟩ := Ideal.mem_span_singleton.1 ha
      exact ⟨k * c, b.mul_mem_left k hc, by ring⟩
    · rintro p q ⟨c, hc, rfl⟩ ⟨c', hc', rfl⟩
      exact ⟨c + c', b.add_mem hc hc', by ring⟩
  · rintro ⟨c, hc, rfl⟩
    exact Ideal.mul_mem_mul (Ideal.mem_span_singleton_self v) hc

/-- Multiplication by `v`, followed by the quotient by `(v)·b`: an `O`-linear map whose range is
the image of `(v)` and whose kernel is `b` when `v` is a nonzerodivisor. -/
public def quotientMapPrincipal (v : O) (b : Ideal O) :
    O →ₗ[O] O ⧸ (Ideal.span ({v} : Set O) * b) :=
  (Submodule.mkQ _).comp (LinearMap.mulLeft O v)

/-- The range of `quotientMapPrincipal` is the image of the principal ideal `(v)`. -/
public theorem range_quotientMapPrincipal (v : O) (b : Ideal O) :
    LinearMap.range (quotientMapPrincipal v b) =
      Submodule.map (Submodule.mkQ (Ideal.span ({v} : Set O) * b))
        (Ideal.span ({v} : Set O)) := by
  refine le_antisymm ?_ ?_
  · rintro w ⟨c, rfl⟩
    exact ⟨v * c, Ideal.mul_mem_right _ _ (Ideal.mem_span_singleton_self v), rfl⟩
  · rintro w ⟨z, hz, rfl⟩
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.1 hz
    exact ⟨c, by simp [quotientMapPrincipal]⟩

/-- The kernel of `quotientMapPrincipal` is `b`, when `v` is a nonzerodivisor. -/
public theorem ker_quotientMapPrincipal {v : O} (hv : v ∈ nonZeroDivisors O) (b : Ideal O) :
    LinearMap.ker (quotientMapPrincipal v b) = (b : Submodule O O) := by
  ext w
  simp only [LinearMap.mem_ker, quotientMapPrincipal, LinearMap.coe_comp, Function.comp_apply,
    LinearMap.mulLeft_apply, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
  rw [mem_span_singleton_mul_iff]
  constructor
  · rintro ⟨c, hc, hvw⟩
    have h0 : (w - c) * v = 0 := by
      rw [sub_mul, mul_comm w v, mul_comm c v, ← hvw, sub_self]
    have : w = c := sub_eq_zero.1 ((mem_nonZeroDivisors_iff.mp hv).2 _ h0)
    exact this ▸ hc
  · intro hw
    exact ⟨w, hw, rfl⟩

/-- **The image of a principal ideal generated by a nonzerodivisor.** For `v` a nonzerodivisor of
`O` and `b` an ideal, the image of `(v)` in `O ⧸ (v)·b` is `O`-linearly isomorphic to `O ⧸ b`. -/
public theorem nonempty_linearEquiv_map_span_singleton {v : O} (hv : v ∈ nonZeroDivisors O)
    (b : Ideal O) :
    Nonempty ((O ⧸ (b : Submodule O O)) ≃ₗ[O]
      Submodule.map (Submodule.mkQ (Ideal.span ({v} : Set O) * b))
        (Ideal.span ({v} : Set O))) :=
  ⟨((Submodule.quotEquivOfEq _ _ (ker_quotientMapPrincipal hv b)).symm.trans
      (quotientMapPrincipal v b).quotKerEquivRange).trans
    (LinearEquiv.ofEq _ _ (range_quotientMapPrincipal v b))⟩

/-- **The two lengths agree.** For `v` a nonzerodivisor the image of `(v)` in `O ⧸ (v)·b` has the
same length as `O ⧸ b`, over any base ring acting through `O`. -/
public theorem length_map_span_singleton_mul {A : Type v} [CommRing A] [Algebra A O]
    {v : O} (hv : v ∈ nonZeroDivisors O) (b : Ideal O) :
    Module.length A (Submodule.map (Submodule.mkQ (Ideal.span ({v} : Set O) * b))
        (Ideal.span ({v} : Set O))) =
      Module.length A (O ⧸ (b : Submodule O O)) := by
  obtain ⟨e⟩ := nonempty_linearEquiv_map_span_singleton hv b
  exact ((e.restrictScalars A).length_eq).symm

variable {A : Type u} [CommRing A]

/-- **The final strict inequality of the colength drop.** If `L ≤ W` are ideals of `A`, `W` is
proper and `A ⧸ L` has finite length, then the image of `W` in `A ⧸ L` has strictly smaller
length than `A ⧸ L` itself. -/
public theorem length_submodule_quotient_lt [IsNoetherianRing A] (L : Ideal A)
    [IsArtinianRing (A ⧸ L)] {N : Submodule A (A ⧸ L)} (hN : N ≠ ⊤) :
    Module.length A N < Module.length A (A ⧸ L) := by
  have : IsArtinian A (A ⧸ L) := isArtinian_quotient L
  exact Submodule.length_lt hN

/-- **The image of a proper ideal in a quotient by a smaller ideal is a proper submodule.** -/
public theorem map_mkQ_ne_top {L W : Ideal A} (hLW : L ≤ W) (hW : W ≠ ⊤) :
    Submodule.map (Submodule.mkQ (L : Submodule A A)) (W : Submodule A A) ≠ ⊤ := by
  intro htop
  refine hW ((Ideal.eq_top_iff_one _).2 ?_)
  obtain ⟨w, hw, hw1⟩ := htop.ge (Submodule.mem_top (x := (1 : A ⧸ (L : Submodule A A))))
  have hw1' : (Ideal.Quotient.mk L) w = 1 := hw1
  have hsub : (1 : A) - w ∈ L := by
    refine Ideal.Quotient.eq_zero_iff_mem.1 ?_
    rw [map_sub, hw1', map_one, sub_self]
  have hone : (1 : A) = w + (1 - w) := by ring
  rw [hone]
  exact Ideal.add_mem W hw (hLW hsub)

end Stacks.ResolutionOfSurfaces.CartierDescent

end
