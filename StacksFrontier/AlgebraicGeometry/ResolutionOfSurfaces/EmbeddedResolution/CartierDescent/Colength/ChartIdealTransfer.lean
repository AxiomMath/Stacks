module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.EmbeddedResolution.CartierDescent.GluedSections

/-!
# The extended ideal on a chart, as an ideal of the chart

Let `A` be a commutative ring with an algebra map to a commutative ring `K` and let `S` be an
`A`-subalgebra of `K`. For an ideal `I` of `A`, the extended ideal `I·S` can be read inside the
ambient ring `K`, as the `A`-submodule
`Stacks.ResolutionOfSurfaces.CartierDescent.chartIdealSpan I S` of `K`, or inside `S`, as the
ideal `Ideal.map (algebraMap A S) I` of `S`. An element of `S` lies in the first exactly when it
lies in the second. Two consequences follow: `I·S` is stable under multiplication by elements of
`S`, and if the extension of `I` to `S` is contained in the principal ideal generated by `w ^ d`,
then every element of `I·S` is `w ^ d` times an element of `S`.

## Main results

* `Stacks.ResolutionOfSurfaces.CartierDescent.coe_mem_chartIdealSpan_iff`: for `z : S`, the
  element `z` of `K` lies in `I·S` exactly when `z` lies in `Ideal.map (algebraMap A S) I`.
* `Stacks.ResolutionOfSurfaces.CartierDescent.mul_mem_chartIdealSpan`: `I·S` is stable under
  multiplication by elements of `S`.
* `Stacks.ResolutionOfSurfaces.CartierDescent.exists_eq_mul_pow_of_mem_chartIdealSpan`: if the
  extension of `I` to `S` is contained in the principal ideal generated by `w ^ d`, then every
  element of `I·S` is `w ^ d` times an element of `S`.

## Implementation notes

Nothing about regularity, locality or dimension of `A` is used, and `K` need not be a domain.

## References

* [Stacks Project, Tag 0AGT](https://stacks.math.columbia.edu/tag/0AGT)
-/

@[expose] public section

universe u

namespace Stacks.ResolutionOfSurfaces.CartierDescent

variable {A K : Type u} [CommRing A] [CommRing K] [Algebra A K]

/-- **The extended ideal is stable under multiplication by the chart.** If `w` lies in the
subalgebra `S` and `z` in `I·S`, then `w * z` lies in `I·S`: a generator `a * v` of `I·S` is
carried to the generator `a * (w * v)`. -/
public theorem mul_mem_chartIdealSpan {I : Ideal A} {S : Subalgebra A K} {w : K} (hw : w ∈ S)
    {z : K} (hz : z ∈ chartIdealSpan I S) : w * z ∈ chartIdealSpan I S := by
  refine chartIdealSpan_le (I := I) (S := S)
    (N := Submodule.comap (LinearMap.mulLeft A w) (chartIdealSpan I S)) ?_ hz
  intro a ha v hv
  refine Submodule.mem_comap.2 ?_
  have h : w * (algebraMap A K a * v) = algebraMap A K a * (w * v) := by ring
  simpa only [LinearMap.mulLeft_apply, h] using
    algebraMap_mul_mem_chartIdealSpan ha (mul_mem hw hv)

/-- The extended ideal `I·S`, read inside `K`, contains the image of the extension of `I` to an
ideal of `S`. -/
public theorem coe_mem_chartIdealSpan_of_mem_map (I : Ideal A) (S : Subalgebra A K) {z : S}
    (hz : z ∈ Ideal.map (algebraMap A S) I) : (z : K) ∈ chartIdealSpan I S := by
  rw [Ideal.map, Ideal.span] at hz
  induction hz using Submodule.span_induction with
  | mem u hu =>
    obtain ⟨a, ha, rfl⟩ := hu
    simpa using algebraMap_mul_mem_chartIdealSpan (S := S) ha (one_mem S)
  | zero => simp
  | add u v _ _ hu hv => simpa using Submodule.add_mem _ hu hv
  | smul c u _ hu => simpa using mul_mem_chartIdealSpan c.2 hu

/-- The extended ideal `I·S`, read inside `K`, is contained in the image of the extension of `I`
to an ideal of `S`. -/
public theorem chartIdealSpan_le_map_val (I : Ideal A) (S : Subalgebra A K) :
    chartIdealSpan I S ≤
      Submodule.map S.val.toLinearMap
        ((Ideal.map (algebraMap A S) I).restrictScalars A) := by
  refine chartIdealSpan_le fun a ha v hv => ?_
  refine ⟨algebraMap A S a * ⟨v, hv⟩, ?_, rfl⟩
  exact (Submodule.restrictScalars_mem A _ _).2
    (Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ha))

/-- **The dictionary between the two readings of the extended ideal.** An element `z` of the
subalgebra `S` lies in the `A`-submodule `I·S` of `K` exactly when it lies in the ideal
`Ideal.map (algebraMap A S) I` of `S`. -/
public theorem coe_mem_chartIdealSpan_iff (I : Ideal A) (S : Subalgebra A K) (z : S) :
    (z : K) ∈ chartIdealSpan I S ↔ z ∈ Ideal.map (algebraMap A S) I := by
  refine ⟨fun hz => ?_, coe_mem_chartIdealSpan_of_mem_map I S⟩
  obtain ⟨u, hu, huz⟩ := chartIdealSpan_le_map_val I S hz
  exact (Subtype.ext huz : u = z) ▸ (Submodule.restrictScalars_mem A _ _).1 hu

/-- **Divisibility of the extended ideal by a power of a chart element.** If the extension of `I`
to the subalgebra `S` is contained in the principal ideal generated by `w ^ d`, then every
element of `I·S` is `w ^ d` times an element of `S`. -/
public theorem exists_eq_mul_pow_of_mem_chartIdealSpan (I : Ideal A) (S : Subalgebra A K)
    (w : S) (d : ℕ) (h : Ideal.map (algebraMap A S) I ≤ Ideal.span {w ^ d}) :
    ∀ z ∈ chartIdealSpan I S, ∃ v ∈ S, z = (w : K) ^ d * v := by
  intro z hz
  have hzS : z ∈ S := mem_of_mem_chartIdealSpan hz
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1
    (h ((coe_mem_chartIdealSpan_iff I S ⟨z, hzS⟩).1 hz))
  exact ⟨(c : K), c.2, by simpa [pow_succ, mul_comm] using congrArg Subtype.val hc.symm⟩

end Stacks.ResolutionOfSurfaces.CartierDescent

end
