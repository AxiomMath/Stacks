module

public import StacksFrontier.AlgebraicGeometry.Divisors.RegularImmersion.RelativeFlatness
public import StacksFrontier.RingTheory.RegularLocalRing.Basic

/-!
# Regular systems of parameters on a regular local surface

Let `(A, 𝔪)` be a regular local ring of dimension two. Its maximal ideal is generated by two
elements `x, y`, and such a minimal generating pair is a regular sequence on `A` (Stacks tag
00NQ). The content of being a regular sequence that the two-chart computation of sections on the
blowup of `Spec A` at its closed point uses is the second half: `y` is a nonzerodivisor modulo
`x`, in the concrete form "if `a y ∈ (x)` then `a ∈ (x)`", together with its iterate for powers
of `y`.

## Main results

* `Stacks.ResolutionOfSurfaces.CartierDescent.exists_pair_span_eq_maximalIdeal_isRegular`: the
  maximal ideal of a two-dimensional regular local ring is generated by a pair `x, y` which is a
  regular sequence.
* `Stacks.ResolutionOfSurfaces.CartierDescent.mem_span_singleton_of_mul_mem_span_singleton`: for
  a regular sequence `[x, y]`, the element `y` is a nonzerodivisor modulo `x`.
* `Stacks.ResolutionOfSurfaces.CartierDescent.mem_span_singleton_of_mul_pow_mem_span_singleton`:
  the same for an arbitrary power of `y`.
* `Stacks.ResolutionOfSurfaces.CartierDescent.not_dvd_of_span_pair_eq_maximalIdeal`: neither
  element of a generating pair of the maximal ideal divides the other.

## Implementation notes

The pair of generators is produced as follows: a finset of cardinality `Submodule.spanFinrank 𝔪`
spanning `𝔪` exists because `𝔪` is finitely generated, and
`IsRegularLocalRing.spanFinrank_maximalIdeal` identifies that cardinality with the Krull
dimension, here `2`. Minimality of the generating list in exactly this sense,
`xs.length = (maximalIdeal A).spanFinrank`, is the hypothesis of Stacks tag 00NQ as formalized in
`IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay`, so the
regular-sequence half is read off from it with no further work.

Translating "`y` is a nonzerodivisor on the quotient" into a membership statement goes through
`AlgebraicGeometry.isRegular_cons_iff_quotient_span_singleton`, which restates Mathlib's
`RingTheory.Sequence.isRegular_cons_iff` with the module `QuotSMulTop x A` replaced by the ring
quotient `A ⧸ (x)`; the tail condition is then literally `IsSMulRegular (A ⧸ (x))` for the image
of `y`, and `Ideal.Quotient.eq_zero_iff_mem` converts between the two sides.

That neither generator divides the other needs no regular sequence: divisibility collapses the
span of the pair onto a principal ideal, whose `Submodule.spanFinrank` is at most one by
`Submodule.spanFinrank_span_le_ncard_of_finite`, contradicting the value `2` forced by the
dimension.

## References

* [Stacks Project, Tag 0AGT](https://stacks.math.columbia.edu/tag/0AGT)
* [Stacks Project, Tag 00NQ](https://stacks.math.columbia.edu/tag/00NQ)
-/

@[expose] public noncomputable section

open IsLocalRing

universe u

namespace Stacks.ResolutionOfSurfaces.CartierDescent

/-! ### A regular system of parameters as a regular sequence -/

/-- The maximal ideal of a two-dimensional regular local ring has `spanFinrank` two. -/
private theorem spanFinrank_maximalIdeal_eq_two (A : Type u) [CommRing A] [IsRegularLocalRing A]
    (hdim : ringKrullDim A = 2) : (maximalIdeal A).spanFinrank = 2 := by
  have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := A)
  rw [hdim] at h
  exact_mod_cast h

/-- **The maximal ideal of a two-dimensional regular local ring is generated by a regular
sequence of length two.** Stacks tag 00NQ applied to a minimal generating pair of `𝔪`. -/
public theorem exists_pair_span_eq_maximalIdeal_isRegular (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) :
    ∃ x y : A, Ideal.span ({x, y} : Set A) = IsLocalRing.maximalIdeal A ∧
      RingTheory.Sequence.IsRegular A [x, y] := by
  classical
  obtain ⟨s, hcard, hsspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank
    (maximalIdeal A).fg_of_isNoetherianRing
  have hfr := spanFinrank_maximalIdeal_eq_two A hdim
  rw [hfr] at hcard
  obtain ⟨x, y, -, rfl⟩ := Finset.card_eq_two.mp hcard
  have hxy : Ideal.span ({x, y} : Set A) = maximalIdeal A := by simpa using hsspan
  refine ⟨x, y, hxy, ?_⟩
  have hofList : Ideal.ofList [x, y] = maximalIdeal A := by
    rw [← hxy, Ideal.ofList_cons, Ideal.ofList_cons, Ideal.ofList_nil]
    simp [Ideal.span_insert]
  exact ((IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
    A).1 [x, y] hofList (by simp [hfr])).1

/-! ### The nonzerodivisor consequence -/

/-- **The second element of a regular sequence of length two is a nonzerodivisor modulo the
first.** If `[x, y]` is a regular sequence on `A` and `a y ∈ (x)`, then `a ∈ (x)`. -/
public theorem mem_span_singleton_of_mul_mem_span_singleton {A : Type u} [CommRing A]
    {x y : A} (h : RingTheory.Sequence.IsRegular A [x, y]) (a : A)
    (ha : a * y ∈ Ideal.span ({x} : Set A)) : a ∈ Ideal.span ({x} : Set A) := by
  obtain ⟨-, hy⟩ := (AlgebraicGeometry.isRegular_cons_iff_quotient_span_singleton x [y]).mp h
  rw [List.map_cons, List.map_nil, RingTheory.Sequence.isRegular_cons_iff] at hy
  refine Ideal.Quotient.eq_zero_iff_mem.mp (hy.1 ?_)
  change Ideal.Quotient.mk (Ideal.span ({x} : Set A)) y •
    Ideal.Quotient.mk (Ideal.span ({x} : Set A)) a =
      Ideal.Quotient.mk (Ideal.span ({x} : Set A)) y • (0 : A ⧸ Ideal.span ({x} : Set A))
  rw [smul_zero, smul_eq_mul, ← map_mul, mul_comm]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr ha

/-- **Powers of the second element of a regular sequence of length two are nonzerodivisors
modulo the first.** If `[x, y]` is a regular sequence on `A` and `a yᵐ ∈ (x)`, then `a ∈ (x)`. -/
public theorem mem_span_singleton_of_mul_pow_mem_span_singleton {A : Type u} [CommRing A]
    {x y : A} (h : RingTheory.Sequence.IsRegular A [x, y]) (m : ℕ) (a : A)
    (ha : a * y ^ m ∈ Ideal.span ({x} : Set A)) : a ∈ Ideal.span ({x} : Set A) := by
  induction m generalizing a with
  | zero => simpa using ha
  | succ n ih =>
    refine ih a (mem_span_singleton_of_mul_mem_span_singleton h _ ?_)
    rw [mul_assoc, ← pow_succ]
    exact ha

/-! ### Independence of the two parameters -/

/-- **Neither element of a generating pair of the maximal ideal of a two-dimensional regular
local ring divides the other.** Divisibility would make `𝔪` principal, forcing its
`Submodule.spanFinrank` below the value `2` that the dimension dictates. -/
public theorem not_dvd_of_span_pair_eq_maximalIdeal {A : Type u} [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) {x y : A}
    (hspan : Ideal.span ({x, y} : Set A) = IsLocalRing.maximalIdeal A) : ¬ x ∣ y := by
  intro hdvd
  have hfr := spanFinrank_maximalIdeal_eq_two A hdim
  have hle : Ideal.span ({x, y} : Set A) ≤ Ideal.span ({x} : Set A) := by
    rw [Ideal.span_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨Ideal.mem_span_singleton_self x, Ideal.mem_span_singleton.mpr hdvd⟩
  have hge : Ideal.span ({x} : Set A) ≤ Ideal.span ({x, y} : Set A) :=
    Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _))
  have hprin : Ideal.span ({x} : Set A) = maximalIdeal A :=
    le_antisymm (hge.trans hspan.le) (hspan.symm.le.trans hle)
  have hone : (maximalIdeal A).spanFinrank ≤ 1 := by
    rw [← hprin]
    simpa using Submodule.spanFinrank_span_le_ncard_of_finite (s := ({x} : Set A)) (by simp)
  rw [hfr] at hone
  omega

end Stacks.ResolutionOfSurfaces.CartierDescent

end
