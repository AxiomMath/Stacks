/-!
# The maximal order of an ideal sheaf along an effective Cartier divisor

Let `X` be a scheme, let `D` be the ideal sheaf of an effective Cartier divisor on `X` whose
support contains a point `y`, and let `J` be a quasi-coherent ideal sheaf on `X` with
`D ^ n ≤ J` for some `n`. Then among the exponents `e` with `J ≤ D ^ e` there is a largest one:
the *order* of `J` along `D`. This is the numerical invariant that an embedded resolution
argument decreases, and the hypothesis `D ^ n ≤ J` is what makes it finite.

The second result is the shape in which the invariant is used: `D` is the exceptional ideal of
the blowup of `X` in a centre `M`, which is an effective Cartier divisor by
[Stacks, Tag 02OS], and `J` is replaced by its inverse image on the blowup.

## Main results

* `Stacks.ResolutionOfSurfaces.CartierDescent.exists_maximal_order`: for an effective Cartier
  divisor `D` with a point in its support and an ideal sheaf `J` above some power of `D`, there
  is a largest `d` with `J ≤ D ^ d`.
* `Stacks.ResolutionOfSurfaces.CartierDescent.exists_maximal_order_comap_blowUpToBase`: the
  specialisation to the exceptional ideal of a blowup.

## Implementation notes

The bound is read off at a single point `y` of the support of `D`. There the stalk of `D` is
generated by a regular element `a` of the local ring
(`Stacks.Divisors.exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor`), and `a` is not
a unit precisely because `y` lies in the support
(`AlgebraicGeometry.IdealSheafData.stalk_eq_top_iff_not_mem_support`). Taking stalks of
`D ^ n ≤ J ≤ D ^ e` turns the inclusion into `a ^ e ∣ a ^ n`, which forces `e ≤ n` since `a` is
regular and not a unit. With the set of admissible exponents bounded by `n` and containing `0`
— one always has `J ≤ D ^ 0 = ⊤` — the maximum is `Nat.findGreatest`.

For the blowup, `AlgebraicGeometry.exceptionalIdeal M` is by definition `M.comap b` for the
blowup morphism `b`, so `Stacks.IdealSheaf.comap_pow` rewrites its `n`-th power as the inverse
image of `M ^ n`, and monotonicity of inverse images supplies the hypothesis from `M ^ n ≤ J`
on the base.

## References

* [Stacks Project, Tag 02OS](https://stacks.math.columbia.edu/tag/02OS)
* [Stacks Project, Tag 01OG](https://stacks.math.columbia.edu/tag/01OG)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory

universe u

namespace Stacks.ResolutionOfSurfaces.CartierDescent

/-- A regular nonunit has no accidental divisibilities between its powers: if `a ^ d` divides
`a ^ n` then `d ≤ n`. Were `d` larger, cancelling `a ^ n` would exhibit `a` as a unit. -/
private theorem pow_dvd_pow_le_of_isRegular_of_not_isUnit {R : Type*} [CommRing R] {a : R}
    (ha : IsRegular a) (hna : ¬ IsUnit a) {n d : ℕ} (h : a ^ d ∣ a ^ n) : d ≤ n := by
  by_contra hnd
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le (Nat.succ_le_of_lt (Nat.lt_of_not_ge hnd))
  obtain ⟨b, hb⟩ := h
  have h1 : (1 : R) = a * (a ^ k * b) := (ha.pow n).left <| by
    simpa only [pow_add, pow_succ, mul_assoc, mul_one] using hb
  exact hna (isUnit_iff_dvd_one.mpr ⟨a ^ k * b, h1⟩)

/-- **The maximal order of an ideal sheaf along an effective Cartier divisor.** Let `D` be the
ideal sheaf of an effective Cartier divisor on a scheme `X` whose support contains a point `y`,
and let `J` be a quasi-coherent ideal sheaf with `D ^ n ≤ J` for some `n`. Then there is a
largest `d` with `J ≤ D ^ d`.

The hypothesis `D ^ n ≤ J` cannot be dropped: for `J = ⊥` every exponent is admissible. -/
public theorem exists_maximal_order {X : Scheme.{u}} (D J : X.IdealSheafData)
    (hD : Stacks.Divisors.IsEffectiveCartierDivisor D)
    (y : X) (hy : y ∈ D.support) (n : ℕ) (hn : D ^ n ≤ J) :
    ∃ d : ℕ, J ≤ D ^ d ∧ ∀ e : ℕ, J ≤ D ^ e → e ≤ d := by
  classical
  have hbound : ∀ e : ℕ, J ≤ D ^ e → e ≤ n := by
    intro e he
    obtain ⟨a, ha, hDa⟩ :=
      Stacks.Divisors.exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor D hD y
    have hna : ¬ IsUnit a := by
      intro hunit
      have ht : IdealSheafData.stalk D y = ⊤ :=
        hDa.trans (Ideal.span_singleton_eq_top.mpr hunit)
      exact (IdealSheafData.stalk_eq_top_iff_not_mem_support D y).mp ht hy
    have hne := IdealSheafData.stalk_mono (hn.trans he) y
    rw [IdealSheafData.stalk_pow, IdealSheafData.stalk_pow, hDa,
      Ideal.span_singleton_pow, Ideal.span_singleton_pow] at hne
    exact pow_dvd_pow_le_of_isRegular_of_not_isUnit ha hna
      (Ideal.mem_span_singleton.mp (hne (Ideal.mem_span_singleton_self _)))
  refine ⟨Nat.findGreatest (fun d ↦ J ≤ D ^ d) n, ?_, fun e he ↦ ?_⟩
  · exact Nat.findGreatest_spec (P := fun d ↦ J ≤ D ^ d) (Nat.zero_le n) (by simp)
  · exact Nat.le_findGreatest (hbound e he) he

/-- **The maximal order along the exceptional divisor of a blowup.** Let `M` and `J` be
quasi-coherent ideal sheaves on a scheme `X` with `M ^ n ≤ J` for some `n`, and suppose the
exceptional divisor of the blowup of `X` in `M` has a point. Then there is a largest `d` for
which the inverse image of `J` on the blowup lies in the `d`-th power of the exceptional
ideal. -/
public theorem exists_maximal_order_comap_blowUpToBase {X : Scheme.{u}} (M J : X.IdealSheafData)
    (hM : ((AlgebraicGeometry.exceptionalIdeal M).support :
      Set (AlgebraicGeometry.blowUp M)).Nonempty)
    (n : ℕ) (hn : M ^ n ≤ J) :
    ∃ d : ℕ, J.comap (AlgebraicGeometry.blowUpToBase M) ≤
        AlgebraicGeometry.exceptionalIdeal M ^ d ∧
      ∀ e : ℕ, J.comap (AlgebraicGeometry.blowUpToBase M) ≤
        AlgebraicGeometry.exceptionalIdeal M ^ e → e ≤ d := by
  obtain ⟨y, hy⟩ := hM
  refine exists_maximal_order (AlgebraicGeometry.exceptionalIdeal M) _
    (Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal M) y hy n ?_
  calc AlgebraicGeometry.exceptionalIdeal M ^ n
      = (M ^ n).comap (AlgebraicGeometry.blowUpToBase M) :=
        (Stacks.IdealSheaf.comap_pow M (AlgebraicGeometry.blowUpToBase M) n).symm
    _ ≤ J.comap (AlgebraicGeometry.blowUpToBase M) :=
        Scheme.IdealSheafData.comap_mono _ hn

end Stacks.ResolutionOfSurfaces.CartierDescent

end
