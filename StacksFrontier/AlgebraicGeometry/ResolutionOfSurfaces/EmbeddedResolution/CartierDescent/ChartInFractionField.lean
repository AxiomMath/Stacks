module

public import Mathlib.RingTheory.Adjoin.Basic
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.Tactic.FieldSimp
public import StacksFrontier.RingTheory.AffineBlowup.ChartEquiv

/-!
# The standard blowup chart of a two-generated ideal, read inside the fraction field

Let `A` be a domain with fraction field `K` and let `x ∈ A` be nonzero. The affine blowup chart
`affineBlowup I x` of [Stacks, Tag 052Q] is an `A`-subalgebra of the away-localization `A_x`, and
`A_x` embeds in `K` because every power of `x` is invertible there; that embedding is
`Stacks.AffineBlowup.awayToFractionField`. This file transports the chart along it and computes
the answer for the two-generated centre `I = (x, y)`: the chart is the subring `A[y/x]` of `K`
generated by the single fraction `y / x`.

The point of reading the chart inside `K` is that the two charts `A[y/x]` and `A[x/y]` of the
blowup of a regular local surface at its closed point then live in one ring, where they can be
compared: their sum is the ring of the overlap of the two charts and their intersection is `A`.
That comparison is the computation behind [Stacks, Tag 0AGT].

## Main results

* `Stacks.ResolutionOfSurfaces.CartierDescent.awayToFractionField_mk`: the embedding `A_x → K`
  sends the fraction `z / s`, for `s` a power of `x`, to the quotient of the images of `z` and
  `s` in `K`; with `Stacks.ResolutionOfSurfaces.CartierDescent.awayToFractionField_mk_pow` and
  `Stacks.ResolutionOfSurfaces.CartierDescent.awayToFractionField_mk_self` for the denominators
  `x ^ n` and `x`.
* `Stacks.ResolutionOfSurfaces.CartierDescent.map_affineBlowup_span_pair`: the image of
  `affineBlowup (x, y) x` in `K` is `Algebra.adjoin A {y / x}`.
* `Stacks.ResolutionOfSurfaces.CartierDescent.affineBlowupSpanPairEquivAdjoin`: the resulting
  isomorphism of `A`-algebras `affineBlowup (x, y) x ≃ₐ[A] A[y/x]`.

## Implementation notes

The embedding `A_x → K` and its injectivity are not built here: they are
`Stacks.AffineBlowup.awayToFractionField`, `Stacks.AffineBlowup.awayToFractionFieldAlgHom` and
`Stacks.AffineBlowup.awayToFractionField_injective`. What those lack, and this file adds, is the
value of the embedding on a fraction `Localization.mk z s`; it is obtained from
`IsLocalization.mk'_spec`, which says `(z / s) * s = z` in `A_x`, by applying the embedding and
clearing the denominator in the field `K`.

The hypothesis is `algebraMap A K x ≠ 0` rather than `x ≠ 0`, matching the existing embedding;
for `A` a domain the two are equivalent by
`Stacks.AffineBlowup.algebraMap_ne_zero_of_ne_zero`, which is how a caller with a regular local
ring and a regular parameter `x` discharges it. Likewise `K` is an arbitrary fraction field of
`A` rather than `FractionRing A`, so that these statements compose with the chart-comparison
lemmas, which are stated for a general `K`.

The computation of the image is the image of a generating set: `Subalgebra.map` of an
`Algebra.adjoin` is the `Algebra.adjoin` of the image (`Algebra.adjoin_image`), so it suffices
to see that the image of `affineBlowupGenSet (x, y) x` and the singleton `{y / x}` generate the
same subalgebra. One inclusion holds generator by generator: a generator is `z / x` with
`z = a * x + b * y` in the ideal, whose image `a + b * (y / x)` visibly lies in `A[y/x]`. The
other is the single observation that `y / x` is itself the image of the generator attached to
`y ∈ (x, y)`.

## References

* [Stacks Project, Tag 052Q](https://stacks.math.columbia.edu/tag/052Q)
* [Stacks Project, Tag 0AGT](https://stacks.math.columbia.edu/tag/0AGT)
-/

@[expose] public noncomputable section

open Stacks.AffineBlowup

universe u

namespace Stacks.ResolutionOfSurfaces.CartierDescent

variable {A : Type u} [CommRing A] {K : Type u} [Field K] [Algebra A K] [IsFractionRing A K]
  (x : A) (haz : algebraMap A K x ≠ 0)

include haz

omit [IsFractionRing A K] in
/-- **The embedding `A_x → K` on a fraction.** For `s` a power of `x`, the image in the fraction
field of the element `z / s` of the away-localization is the quotient of the images of `z` and
`s`; the denominator is nonzero in `K` because `x` is. -/
public theorem awayToFractionField_mk (z : A) (s : Submonoid.powers x) :
    awayToFractionField (K := K) x haz (Localization.mk z s) =
      algebraMap A K z / algebraMap A K (s : A) := by
  obtain ⟨n, hn⟩ := s.2
  have hs : algebraMap A K (s : A) ≠ 0 := by
    rw [← hn, map_pow]
    exact pow_ne_zero n haz
  have hspec : (Localization.mk z s : Localization.Away x) *
      algebraMap A (Localization.Away x) (s : A) = algebraMap A (Localization.Away x) z := by
    rw [Localization.mk_eq_mk']
    exact IsLocalization.mk'_spec (Localization.Away x) z s
  have h := congrArg (awayToFractionField (K := K) x haz) hspec
  rw [map_mul, awayToFractionField_comp, awayToFractionField_comp] at h
  rw [eq_div_iff hs]
  exact h

omit [IsFractionRing A K] in
/-- **The embedding `A_x → K` on a fraction with denominator `x ^ n`.** -/
public theorem awayToFractionField_mk_pow (z : A) (n : ℕ) :
    awayToFractionField (K := K) x haz (Localization.mk z ⟨x ^ n, n, rfl⟩) =
      algebraMap A K z / algebraMap A K x ^ n := by
  rw [← map_pow]
  exact awayToFractionField_mk x haz z _

omit [IsFractionRing A K] in
/-- **The embedding `A_x → K` on a fraction with denominator `x`**, the shape in which the
generators of the affine blowup chart `affineBlowup I x` are given. -/
public theorem awayToFractionField_mk_self (z : A) :
    awayToFractionField (K := K) x haz (Localization.mk z ⟨x, Submonoid.mem_powers x⟩) =
      algebraMap A K z / algebraMap A K x :=
  awayToFractionField_mk x haz z _

omit [IsFractionRing A K] in
/-- **The chart of a two-generated centre is `A[y/x]`.** Read inside the fraction field `K`, the
affine blowup chart of the ideal `(x, y)` at `x` is the `A`-subalgebra of `K` generated by the
single fraction `y / x`. -/
public theorem map_affineBlowup_span_pair (y : A) :
    Subalgebra.map (awayToFractionFieldAlgHom (K := K) x haz)
        (affineBlowup (Ideal.span ({x, y} : Set A)) x) =
      Algebra.adjoin A {algebraMap A K y / algebraMap A K x} := by
  have hchart : affineBlowup (Ideal.span ({x, y} : Set A)) x =
      Algebra.adjoin A ((fun z : A =>
          (Localization.mk z ⟨x, Submonoid.mem_powers x⟩ : Localization.Away x)) ''
        (Ideal.span ({x, y} : Set A) : Set A)) := rfl
  rw [hchart, ← Algebra.adjoin_image]
  refine le_antisymm (Algebra.adjoin_le ?_) (Algebra.adjoin_le ?_)
  · rintro - ⟨-, ⟨z, hz, rfl⟩, rfl⟩
    obtain ⟨a, b, rfl⟩ := Ideal.mem_span_pair.1 hz
    rw [awayToFractionFieldAlgHom_apply, awayToFractionField_mk_self,
      show algebraMap A K (a * x + b * y) / algebraMap A K x =
          algebraMap A K a + algebraMap A K b * (algebraMap A K y / algebraMap A K x) by
        field_simp
        simp only [map_add, map_mul]
        ring]
    exact add_mem (Subalgebra.algebraMap_mem _ a)
      (mul_mem (Subalgebra.algebraMap_mem _ b) (Algebra.subset_adjoin rfl))
  · rw [Set.singleton_subset_iff, ← awayToFractionField_mk_self x haz y,
      ← awayToFractionFieldAlgHom_apply]
    exact Algebra.subset_adjoin ⟨_, ⟨y, Ideal.subset_span (by simp), rfl⟩, rfl⟩

/-- **The affine blowup chart of a two-generated centre, as an algebra isomorphism onto
`A[y/x]`.** The chart `affineBlowup (x, y) x` is isomorphic, as an `A`-algebra, to the subring
of the fraction field generated by `y / x`: the embedding of the away-localization into the
fraction field is injective, and the image of the chart is that subring. -/
public noncomputable def affineBlowupSpanPairEquivAdjoin (y : A) :
    affineBlowup (Ideal.span ({x, y} : Set A)) x ≃ₐ[A]
      Algebra.adjoin A {algebraMap A K y / algebraMap A K x} :=
  (Subalgebra.equivMapOfInjective _ (awayToFractionFieldAlgHom (K := K) x haz)
      (awayToFractionField_injective x haz)).trans
    (Subalgebra.equivOfEq _ _ (map_affineBlowup_span_pair x haz y))

end Stacks.ResolutionOfSurfaces.CartierDescent

end
