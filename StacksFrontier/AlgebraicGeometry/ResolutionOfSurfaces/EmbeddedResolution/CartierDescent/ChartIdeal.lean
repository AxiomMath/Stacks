module

public import StacksFrontier.AlgebraicGeometry.Blowup.ExceptionalChart

/-!
# An ideal sheaf on an affine chart of a blowup

Let `S` be a scheme, let `ℐ` be a quasi-coherent sheaf of ideals on `S` and let
`b : X' ⟶ S` be the blowup of `S` in `ℐ`. For an affine open `U ⊆ S` and a section
`a ∈ ℐ(U)` the chart `Stacks.Blowup.blowUpAffineChart` identifies an affine open of `X'` with
`Spec Γ(S, U)[ℐ(U)/a]`, the spectrum of the affine blowup algebra; those charts cover `b⁻¹(U)`
by the second assertion of Stacks tag 0804.

This file computes, on such a chart, the inverse image of an *arbitrary* quasi-coherent ideal
sheaf `J` on `S` — not just of the blowup centre. The answer is the one the formula for the
centre suggests: the sections of `J·𝒪_{X'}` over the chart are the extension of the ideal
`J(U)` along the structure map `Γ(S, U) ⟶ Γ(S, U)[ℐ(U)/a]`.

This is the generic half of `Stacks.Blowup.ideal_comap_exceptionalIdeal_blowUpAffineChart`; for
`J = ℐ` the extra input `Stacks.Blowup.affineBlowup_idealMap_eq_span`, which is special to the
centre, turns the right-hand side into the principal ideal generated by the image of `a`. It is
the local computation behind the colength bookkeeping on the blowup of a regular local surface
needed for Stacks tag 0AGT.

## Main results

* `Stacks.ResolutionOfSurfaces.CartierDescent.ideal_comap_blowUpAffineChart_top`: for ideal
  sheaves `ℐ` and `J` on `S`, the ideal of `J·𝒪_{X'}` on the chart
  `Spec Γ(S, U)[ℐ(U)/a]` is the extension of `J(U)` along
  `Γ(S, U) ⟶ Γ(S, U)[ℐ(U)/a] ⟶ Γ(Spec Γ(S, U)[ℐ(U)/a], ⊤)`.
* `Stacks.ResolutionOfSurfaces.CartierDescent.ideal_comap_blowUpAffineChart_top_eq_map`: the
  same statement with the ideal transported into the affine blowup algebra itself, which is the
  form in which the computation is used.

## Implementation notes

The proof is the first half of the proof of
`Stacks.Blowup.ideal_comap_exceptionalIdeal_blowUpAffineChart` with `J` in place of the centre:
the chart composed with the blowup morphism is `Spec` of the structure map of the affine blowup
algebra followed by the affine identification of `U`
(`Stacks.Blowup.blowUpAffineChart_blowUpToBase`), and the inverse image along that composite is
computed by `Stacks.IdealSheaf.ideal_comap_top_of_isAffine`,
`Stacks.Blowup.ideal_comap_fromSpec_top` and
`Stacks.Blowup.map_appTop_map_ΓSpecIso_inv`. None of those three depends on the ideal sheaf
being the centre; only the final step of the computation for the centre does, and it is dropped
here. As there, the chain is assembled by `congrArg` against lemmas whose types are inferred
rather than by `rw` on the `Scheme.IdealSheafData.comap` chain, which exhausts the heartbeat
budget.

The inverse image is spelled `(J.comap (Stacks.Blowup.blowUpToBase ℐ)).comap
(Stacks.Blowup.blowUpAffineChart ℐ U ha)`, matching
`Stacks.Blowup.exceptionalIdeal ℐ = ℐ.comap (Stacks.Blowup.blowUpToBase ℐ)`: the chart is a
morphism to the blowup, so an ideal sheaf on `S` must first be pulled back to the blowup.

## References

* [Stacks Project, Tag 0804](https://stacks.math.columbia.edu/tag/0804)
* [Stacks Project, Tag 0AGT](https://stacks.math.columbia.edu/tag/0AGT)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CommRingCat

universe u

namespace Stacks.ResolutionOfSurfaces.CartierDescent

/-- **An ideal sheaf read on an affine chart of a blowup.** Let `ℐ` be the centre of a blowup
`X' ⟶ S`, let `U ⊆ S` be an affine open and let `a ∈ ℐ(U)`, so that
`Stacks.Blowup.blowUpAffineChart` identifies an affine open of `X'` with
`Spec Γ(S, U)[ℐ(U)/a]`. For any quasi-coherent ideal sheaf `J` on `S`, the sections of the
inverse image `J·𝒪_{X'}` over that chart form the extension of `J(U)` along the structure map
`Γ(S, U) ⟶ Γ(S, U)[ℐ(U)/a]`.

For `J = ℐ` this is the generic half of
`Stacks.Blowup.ideal_comap_exceptionalIdeal_blowUpAffineChart`. -/
public theorem ideal_comap_blowUpAffineChart_top {S : Scheme.{u}} (ℐ J : S.IdealSheafData)
    (U : S.affineOpens) {a : Γ(S, U.1)} (ha : a ∈ ℐ.ideal U) :
    ((J.comap (Stacks.Blowup.blowUpToBase ℐ)).comap
          (Stacks.Blowup.blowUpAffineChart ℐ U ha)).ideal ⟨⊤, isAffineOpen_top _⟩ =
      Ideal.map ((Scheme.ΓSpecIso (CommRingCat.of (affineBlowup (ℐ.ideal U) a))).inv.hom.comp
          (algebraMap Γ(S, U.1) (affineBlowup (ℐ.ideal U) a)))
        (J.ideal U) := by
  have h0 := Scheme.IdealSheafData.comap_comp J (Stacks.Blowup.blowUpAffineChart ℐ U ha)
    (Stacks.Blowup.blowUpToBase ℐ)
  have h1 := congrArg (fun f : Spec (CommRingCat.of (affineBlowup (ℐ.ideal U) a)) ⟶ S =>
    J.comap f) (Stacks.Blowup.blowUpAffineChart_blowUpToBase ℐ U ha)
  have h2 := Scheme.IdealSheafData.comap_comp J
    (Spec.map (CommRingCat.ofHom (algebraMap Γ(S, U.1) (affineBlowup (ℐ.ideal U) a))))
    (Stacks.RelativeProj.isAffineOpen U).fromSpec
  have hgoal := congrArg
    (fun K : (Spec (CommRingCat.of (affineBlowup (ℐ.ideal U) a))).IdealSheafData =>
      K.ideal ⟨⊤, isAffineOpen_top _⟩) (h0.symm.trans (h1.trans h2))
  have hA := Stacks.IdealSheaf.ideal_comap_top_of_isAffine
    (J.comap (Stacks.RelativeProj.isAffineOpen U).fromSpec)
    (Spec.map (CommRingCat.ofHom (algebraMap Γ(S, U.1) (affineBlowup (ℐ.ideal U) a))))
  have hB := congrArg
    (fun K : Ideal Γ(Spec Γ(S, U.1), ⊤) =>
      Ideal.map ((Spec.map (CommRingCat.ofHom
        (algebraMap Γ(S, U.1) (affineBlowup (ℐ.ideal U) a)))).appTop).hom K)
    (Stacks.Blowup.ideal_comap_fromSpec_top J U)
  have hC := Stacks.Blowup.map_appTop_map_ΓSpecIso_inv
    (CommRingCat.ofHom (algebraMap Γ(S, U.1) (affineBlowup (ℐ.ideal U) a))) (J.ideal U)
  exact hgoal.trans (hA.trans (hB.trans (hC.trans (Ideal.map_map _ _))))

/-- **An ideal sheaf read on an affine chart of a blowup, as an ideal of the affine blowup
algebra.** The form of
`Stacks.ResolutionOfSurfaces.CartierDescent.ideal_comap_blowUpAffineChart_top` in which
consumers want it: transporting the sections of `J·𝒪_{X'}` over the chart
`Spec Γ(S, U)[ℐ(U)/a]` along the canonical identification of those sections with
`Γ(S, U)[ℐ(U)/a]` gives the extension `J(U)·Γ(S, U)[ℐ(U)/a]`. -/
public theorem ideal_comap_blowUpAffineChart_top_eq_map {S : Scheme.{u}}
    (ℐ J : S.IdealSheafData) (U : S.affineOpens) {a : Γ(S, U.1)} (ha : a ∈ ℐ.ideal U) :
    Ideal.map (Scheme.ΓSpecIso (CommRingCat.of (affineBlowup (ℐ.ideal U) a))).hom.hom
        (((J.comap (Stacks.Blowup.blowUpToBase ℐ)).comap
          (Stacks.Blowup.blowUpAffineChart ℐ U ha)).ideal ⟨⊤, isAffineOpen_top _⟩) =
      Ideal.map (algebraMap Γ(S, U.1) (affineBlowup (ℐ.ideal U) a)) (J.ideal U) := by
  have hcomp :
      ((Scheme.ΓSpecIso (CommRingCat.of (affineBlowup (ℐ.ideal U) a))).hom.hom).comp
          (((Scheme.ΓSpecIso (CommRingCat.of (affineBlowup (ℐ.ideal U) a))).inv.hom).comp
            (algebraMap Γ(S, U.1) (affineBlowup (ℐ.ideal U) a)))
        = algebraMap Γ(S, U.1) (affineBlowup (ℐ.ideal U) a) := by
    rw [← RingHom.comp_assoc, ← CommRingCat.hom_comp, Iso.inv_hom_id, CommRingCat.hom_id,
      RingHom.id_comp]
  rw [ideal_comap_blowUpAffineChart_top ℐ J U ha, Ideal.map_map, hcomp]

end Stacks.ResolutionOfSurfaces.CartierDescent

end
