module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.EmbeddedResolution.CartierDescent.ChartSubalgebra

/-!
# Gluing a global function out of sections on the two charts of a blowup

Let `A` be a commutative ring with an algebra map to a commutative ring `K`, let `x y : A` and
let `t s : K` satisfy `t * s = 1` and `x * t = y` (images in `K`, so that `t` plays the role of
`y / x` and `s` of `x / y`), and let `I` be an ideal of `A`. Write

* `B = Algebra.adjoin A {t}`,
* `C = Algebra.adjoin A {s}`,
* `D = Algebra.adjoin A {t, s}`

for the two chart subalgebras of `K` and their overlap, as in the sibling file
`CartierDescent.ChartSubalgebra`. This file carries the extended ideals `I·B`, `I·C`, `I·D` —
read as `A`-submodules of `K` by
`Stacks.ResolutionOfSurfaces.CartierDescent.chartIdealSpan` — along the same two facts, and
deduces the gluing statement: a pair of sections on the two charts which agree modulo `I` on the
overlap comes from a single element of `A`, modulo `I` on each chart.

## Main results

* `Stacks.ResolutionOfSurfaces.CartierDescent.chartIdealSpan`: the `A`-submodule `I·S` of `K`
  attached to an ideal `I` of `A` and a subalgebra `S` of `K`.
* `Stacks.ResolutionOfSurfaces.CartierDescent.chartIdealSpan_le_toSubmodule`: `I·S` is contained
  in `S`.
* `Stacks.ResolutionOfSurfaces.CartierDescent.chartIdealSpan_adjoin_pair_eq_sup`: the extended
  ideal on the overlap is the sum of the extended ideals on the two charts, `I·D = I·B + I·C`.
* `Stacks.ResolutionOfSurfaces.CartierDescent.exists_algebraMap_sub_mem`: **the gluing lemma.**
  If `b ∈ B` and `c ∈ C` satisfy `b - c ∈ I·D`, then some `a : A` has `a - b ∈ I·B` and
  `a - c ∈ I·C`.
* `Stacks.ResolutionOfSurfaces.CartierDescent.exists_algebraMap_sub_mem_and_mem_smul`: the
  refinement in which `b` is divisible by `x ^ d` on `B` and `c` by `y ^ d` on `C`: then the
  glued element is divisible by `x ^ d` on `B` and by `y ^ d` on `C` as well.

## Implementation notes

`chartIdealSpan I S` is the `A`-span inside `K` of the products `a * w` with `a ∈ I` and
`w ∈ S`. It is deliberately an `A`-submodule of `K` rather than an ideal of `S`: the consumer
compares `I·B`, `I·C` and `I·D` with one another and with elements of `K` such as `b - c`, and
all of that happens in the single ambient module `K`. The membership characterisation needed to
recognise elements is `chartIdealSpan_le` (how to prove a containment) together with
`algebraMap_mul_mem_chartIdealSpan` (how to produce a generator).

The gluing proof is three lines of mathematics. Splitting `b - c = p + q` with `p ∈ I·B` and
`q ∈ I·C` is `chartIdealSpan_adjoin_pair_le`, itself the elementwise `B + C = D` of
`exists_add_mem_adjoin` multiplied through by a generator of `I`. The element `w = b - p` then
equals `c + q`, so it lies in `B` (as `p ∈ I·B ≤ B`) and in `C` (as `q ∈ I·C ≤ C`), hence in the
image of `A` by `mem_range_algebraMap_of_mem_adjoin_inter`; and `w - b = -p`, `w - c = q` are
the two required memberships. Nothing beyond those two inputs is used, so — exactly as in the
sibling file — regularity, locality and dimension of `A` play no part.

In the refinement the divisibility hypotheses are stated as explicit existentials
`∃ β' ∈ B, z = x ^ d * β'` rather than as membership in a `Submodule` smul: that is the form in
which the caller discharges them and the form in which the conclusion is consumed, and it keeps
the statement free of a pointwise-scalar-action instance argument.

## References

* [Stacks Project, Tag 0AGT](https://stacks.math.columbia.edu/tag/0AGT)
-/

@[expose] public section

universe u

namespace Stacks.ResolutionOfSurfaces.CartierDescent

variable {A K : Type u} [CommRing A] [CommRing K] [Algebra A K]

/-- The `A`-submodule of `K` generated by the products `a * w` with `a ∈ I` and `w` in the
subalgebra `S`: the ideal `I·S` of `S`, read inside `K`. -/
public def chartIdealSpan (I : Ideal A) (S : Subalgebra A K) : Submodule A K :=
  Submodule.span A {z : K | ∃ a ∈ I, ∃ w ∈ S, z = algebraMap A K a * w}

/-- A generator of `chartIdealSpan I S`: the product of the image of an element of `I` with an
element of `S`. -/
public theorem algebraMap_mul_mem_chartIdealSpan {I : Ideal A} {S : Subalgebra A K} {a : A}
    (ha : a ∈ I) {w : K} (hw : w ∈ S) : algebraMap A K a * w ∈ chartIdealSpan I S :=
  Submodule.subset_span ⟨a, ha, w, hw, rfl⟩

/-- The recognition principle for `chartIdealSpan I S`: a submodule containing every generator
`a * w` with `a ∈ I` and `w ∈ S` contains all of `I·S`. -/
public theorem chartIdealSpan_le {I : Ideal A} {S : Subalgebra A K} {N : Submodule A K}
    (h : ∀ a ∈ I, ∀ w ∈ S, algebraMap A K a * w ∈ N) : chartIdealSpan I S ≤ N := by
  refine Submodule.span_le.2 ?_
  rintro z ⟨a, ha, w, hw, rfl⟩
  exact h a ha w hw

/-- **The extended ideal lies in the chart.** `I·S` is contained in `S`, since a generator
`a * w` is a product of two elements of `S`. -/
public theorem chartIdealSpan_le_toSubmodule (I : Ideal A) (S : Subalgebra A K) :
    chartIdealSpan I S ≤ Subalgebra.toSubmodule S :=
  chartIdealSpan_le fun a _ _ hw =>
    (Subalgebra.mem_toSubmodule _).2 (mul_mem (S.algebraMap_mem a) hw)

/-- The elementwise form of `chartIdealSpan_le_toSubmodule`: an element of `I·S` lies in `S`. -/
public theorem mem_of_mem_chartIdealSpan {I : Ideal A} {S : Subalgebra A K} {z : K}
    (hz : z ∈ chartIdealSpan I S) : z ∈ S :=
  (Subalgebra.mem_toSubmodule _).1 (chartIdealSpan_le_toSubmodule I S hz)

/-- `chartIdealSpan I` is monotone in the subalgebra. -/
public theorem chartIdealSpan_mono_right (I : Ideal A) {S T : Subalgebra A K} (h : S ≤ T) :
    chartIdealSpan I S ≤ chartIdealSpan I T :=
  chartIdealSpan_le fun _ ha _ hw => algebraMap_mul_mem_chartIdealSpan ha (h hw)

/-- **The overlap ideal splits.** For `t * s = 1` the extended ideal `I·Algebra.adjoin A {t, s}`
on the overlap of the two charts is contained in the sum of the extended ideals
`I·Algebra.adjoin A {t}` and `I·Algebra.adjoin A {s}` on the two charts: multiply the
decomposition `exists_add_mem_adjoin` of an element of the overlap through by a generator of
`I`. -/
public theorem chartIdealSpan_adjoin_pair_le {t s : K} (hts : t * s = 1) (I : Ideal A) :
    chartIdealSpan I (Algebra.adjoin A ({t, s} : Set K)) ≤
      chartIdealSpan I (Algebra.adjoin A ({t} : Set K)) ⊔
      chartIdealSpan I (Algebra.adjoin A ({s} : Set K)) := by
  refine chartIdealSpan_le fun a ha w hw => ?_
  obtain ⟨b, hb, c, hc, rfl⟩ := exists_add_mem_adjoin hts w hw
  rw [mul_add]
  exact Submodule.add_mem_sup (algebraMap_mul_mem_chartIdealSpan ha hb)
    (algebraMap_mul_mem_chartIdealSpan ha hc)

/-- The inclusion opposite to `chartIdealSpan_adjoin_pair_le`, which needs no hypothesis: both
charts are contained in their overlap. -/
public theorem le_chartIdealSpan_adjoin_pair (t s : K) (I : Ideal A) :
    chartIdealSpan I (Algebra.adjoin A ({t} : Set K)) ⊔
        chartIdealSpan I (Algebra.adjoin A ({s} : Set K)) ≤
      chartIdealSpan I (Algebra.adjoin A ({t, s} : Set K)) :=
  sup_le (chartIdealSpan_mono_right I (Algebra.adjoin_mono (by simp)))
    (chartIdealSpan_mono_right I (Algebra.adjoin_mono (by simp)))

/-- **The overlap ideal is the sum of the two chart ideals.** For `t * s = 1`,
`I·Algebra.adjoin A {t, s} = I·Algebra.adjoin A {t} + I·Algebra.adjoin A {s}`. -/
public theorem chartIdealSpan_adjoin_pair_eq_sup {t s : K} (hts : t * s = 1) (I : Ideal A) :
    chartIdealSpan I (Algebra.adjoin A ({t, s} : Set K)) =
      chartIdealSpan I (Algebra.adjoin A ({t} : Set K)) ⊔
      chartIdealSpan I (Algebra.adjoin A ({s} : Set K)) :=
  le_antisymm (chartIdealSpan_adjoin_pair_le hts I) (le_chartIdealSpan_adjoin_pair t s I)

/-- **The gluing lemma.** Let `A` embed in a domain `K`, let `t * s = 1` and `x * t = y` in `K`,
let `x ≠ 0` and let `y` be a nonzerodivisor modulo `x` in `A`. If `b` lies on the first chart
`Algebra.adjoin A {t}`, `c` on the second chart `Algebra.adjoin A {s}`, and the two agree modulo
the extended ideal `I·Algebra.adjoin A {t, s}` on the overlap, then they are the restrictions,
modulo the extended ideals on the two charts, of a single element of `A`.

Geometrically: the sections of `𝒪_X/I𝒪_X` on the two standard charts of the blowup of a regular
local surface glue, and a glued section comes from `A`. This is the surjectivity used in
[Stacks, Tag 0AGT](https://stacks.math.columbia.edu/tag/0AGT), proved by hand on the two-chart
cover with no sheaf cohomology. -/
public theorem exists_algebraMap_sub_mem [IsDomain K] (hinj : Function.Injective (algebraMap A K))
    {x y : A} {t s : K} (hts : t * s = 1) (hxt : algebraMap A K x * t = algebraMap A K y)
    (hx : x ≠ 0)
    (hreg : ∀ a : A, a * y ∈ Ideal.span ({x} : Set A) → a ∈ Ideal.span ({x} : Set A))
    (I : Ideal A) (b c : K)
    (hb : b ∈ Algebra.adjoin A ({t} : Set K)) (hc : c ∈ Algebra.adjoin A ({s} : Set K))
    (hbc : b - c ∈ chartIdealSpan I (Algebra.adjoin A ({t, s} : Set K))) :
    ∃ a : A, algebraMap A K a - b ∈ chartIdealSpan I (Algebra.adjoin A ({t} : Set K)) ∧
      algebraMap A K a - c ∈ chartIdealSpan I (Algebra.adjoin A ({s} : Set K)) := by
  obtain ⟨p, hp, q, hq, hpq⟩ := Submodule.mem_sup.1 (chartIdealSpan_adjoin_pair_le hts I hbc)
  have hwB : b - p ∈ Algebra.adjoin A ({t} : Set K) := sub_mem hb (mem_of_mem_chartIdealSpan hp)
  have hwC : b - p ∈ Algebra.adjoin A ({s} : Set K) := by
    have hbp : b - p = c + q := by linear_combination -hpq
    rw [hbp]
    exact add_mem hc (mem_of_mem_chartIdealSpan hq)
  obtain ⟨a, ha⟩ := mem_range_algebraMap_of_mem_adjoin_inter hinj hts hxt hx hreg (b - p) hwB hwC
  refine ⟨a, ?_, ?_⟩
  · have h : algebraMap A K a - b = -p := by rw [ha]; ring
    rw [h]
    exact neg_mem hp
  · have h : algebraMap A K a - c = q := by rw [ha]; linear_combination -hpq
    rw [h]
    exact hq

/-- If `a - u ^ d * δ` is divisible by `u ^ d` in `S` and `δ ∈ S`, so is `a`. -/
private theorem exists_algebraMap_eq_pow_mul {S : Subalgebra A K} {u : A} {d : ℕ} {δ : K}
    {J : Submodule A K} {a : A} (hδ : δ ∈ S)
    (hJ : ∀ z ∈ J, ∃ β' ∈ S, z = algebraMap A K u ^ d * β')
    (h : algebraMap A K a - algebraMap A K u ^ d * δ ∈ J) :
    ∃ β' ∈ S, algebraMap A K a = algebraMap A K u ^ d * β' := by
  obtain ⟨β', hβ', hz⟩ := hJ _ h
  exact ⟨δ + β', add_mem hδ hβ', by rw [mul_add, ← hz]; ring⟩

/-- **The gluing lemma with divisibility.** The refinement of
`Stacks.ResolutionOfSurfaces.CartierDescent.exists_algebraMap_sub_mem` that a consumer computing
with `𝒪_X(-dE)` needs. Suppose the section on the first chart is `x ^ d * β` with `β` on that
chart and the section on the second is `y ^ d * γ` with `γ` on that chart, and suppose the
extended ideal `I·Algebra.adjoin A {t}` is divisible by `x ^ d` on the first chart and
`I·Algebra.adjoin A {s}` by `y ^ d` on the second. Then the glued element `a : A` of
`exists_algebraMap_sub_mem` is itself divisible by `x ^ d` on the first chart and by `y ^ d` on
the second.

Indeed `a = x ^ d * β + (a - x ^ d * β)` with the second summand in `I·Algebra.adjoin A {t}`,
hence of the form `x ^ d * β'`; and symmetrically on the other chart. -/
public theorem exists_algebraMap_sub_mem_and_mem_smul [IsDomain K]
    (hinj : Function.Injective (algebraMap A K))
    {x y : A} {t s : K} (hts : t * s = 1) (hxt : algebraMap A K x * t = algebraMap A K y)
    (hx : x ≠ 0)
    (hreg : ∀ a : A, a * y ∈ Ideal.span ({x} : Set A) → a ∈ Ideal.span ({x} : Set A))
    (I : Ideal A) (d : ℕ) (β γ : K)
    (hβ : β ∈ Algebra.adjoin A ({t} : Set K)) (hγ : γ ∈ Algebra.adjoin A ({s} : Set K))
    (hIB : ∀ z ∈ chartIdealSpan I (Algebra.adjoin A ({t} : Set K)),
      ∃ β' ∈ Algebra.adjoin A ({t} : Set K), z = algebraMap A K x ^ d * β')
    (hIC : ∀ z ∈ chartIdealSpan I (Algebra.adjoin A ({s} : Set K)),
      ∃ γ' ∈ Algebra.adjoin A ({s} : Set K), z = algebraMap A K y ^ d * γ')
    (hbc : algebraMap A K x ^ d * β - algebraMap A K y ^ d * γ ∈
      chartIdealSpan I (Algebra.adjoin A ({t, s} : Set K))) :
    ∃ a : A, algebraMap A K a - algebraMap A K x ^ d * β ∈
        chartIdealSpan I (Algebra.adjoin A ({t} : Set K)) ∧
      algebraMap A K a - algebraMap A K y ^ d * γ ∈
        chartIdealSpan I (Algebra.adjoin A ({s} : Set K)) ∧
      (∃ β' ∈ Algebra.adjoin A ({t} : Set K), algebraMap A K a = algebraMap A K x ^ d * β') ∧
      (∃ γ' ∈ Algebra.adjoin A ({s} : Set K), algebraMap A K a = algebraMap A K y ^ d * γ') := by
  obtain ⟨a, h1, h2⟩ := exists_algebraMap_sub_mem hinj hts hxt hx hreg I _ _
    (mul_mem (pow_mem ((Algebra.adjoin A ({t} : Set K)).algebraMap_mem x) d) hβ)
    (mul_mem (pow_mem ((Algebra.adjoin A ({s} : Set K)).algebraMap_mem y) d) hγ) hbc
  exact ⟨a, h1, h2, exists_algebraMap_eq_pow_mul hβ hIB h1,
    exists_algebraMap_eq_pow_mul hγ hIC h2⟩

end Stacks.ResolutionOfSurfaces.CartierDescent

end
