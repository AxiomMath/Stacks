module

public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.MapDifferenceDiagonalSheaf

/-!
# Nonvanishing of the conormal comparison map of a square of immersions

For a commutative square `i ≫ k = f ≫ j` whose horizontal arrows are immersions, this file gives
a criterion on a single affine chart for the comparison map of [Stacks, Tag 01R4]

`f^* 𝒞_{W/W'} ⟶ 𝒞_{Z/Z'}`

to be nonzero: it is enough that a function cutting out `W` pull back, on some affine chart of
`Z'` presenting `Z` by an ideal `I`, to an element of `I` outside `I²`. In the proof of
[Stacks, Tag 0C5R](https://stacks.math.columbia.edu/tag/0C5R) (Resolution of Surfaces,
Lemma 54.17.1) this is the form taken by the assertion that the comparison map of the two
exceptional curves "is nonzero (as `f'` is an isomorphism in the generic point of `E`)": at that
generic point the local ring is a discrete valuation ring whose maximal ideal is the ideal of the
curve, and a generator of it is not in its square.

## Main results

* `Stacks.Conormal.notMem_sq_of_notMem_sq_of_map_le` — not lying in the square of an ideal is
  detected by any ring map carrying that ideal into another.
* `Stacks.Conormal.notMem_sq_maximalIdeal_of_span_eq` — a generator of a nonzero maximal ideal
  of a local ring is not in its square.
* `Stacks.Conormal.preimage_eq_preimage_of_square` — the two ways round a commutative square give
  the same preimage of an open.
* `Stacks.Conormal.conormalClass_eq_zero_of_immersionConormalSheafMap_eq_zero` — a vanishing
  comparison map kills every conormal class it reaches: if the map of [Stacks, Tag 01R4] of a
  square `i ≫ k = f ≫ j` is zero then so is the conormal class of `k^♯ r` for every `r` cutting
  out the right-hand subscheme.
* `Stacks.Conormal.ne_zero_conormalClass_of_notMem_sq` — a conormal class outside the square of
  the ideal is nonzero: on an affine chart `U` of `X` presenting `Z ∩ U` as
  `Spec (Γ(X, U) ⧸ I)`, the conormal class of `a ∈ I` is nonzero as soon as `a ∉ I²`.
* `Stacks.Conormal.ne_zero_immersionConormalSheafMap_of_notMem_sq` — the chart criterion for
  the nonvanishing: for a commutative square `i ≫ k = f ≫ j` of immersions, an open `V` of `W'`
  and `r ∈ Γ(W', V)` cutting out `W`, and an affine open `U ≤ k⁻¹V` of `Z'` presenting `Z ∩ U` by
  an ideal `I`, the comparison map of [Stacks, Tag 01R4] is nonzero as soon as the restriction of
  `k^♯ r` to `U` lies in `I` but not in `I²`.

## References

* [Stacks Project, Tag 0C5R](https://stacks.math.columbia.edu/tag/0C5R)
* [Stacks Project, Tag 01R2](https://stacks.math.columbia.edu/tag/01R2)
* [Stacks Project, Tag 01R3](https://stacks.math.columbia.edu/tag/01R3)
* [Stacks Project, Tag 01R4](https://stacks.math.columbia.edu/tag/01R4)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open RingedSpaceModuleAdjunction

universe u

namespace Stacks.Conormal

/-! ### Two ideal-theoretic inputs to the chart criterion -/

/-- If `φ : R →+* S` carries the ideal `I` into `J` and `φ a ∉ J²`, then `a ∉ I²`. Only the
containment `I·S ⊆ J` is assumed, so `J` may be strictly larger than the ideal generated by the
image of `I`. -/
public theorem notMem_sq_of_notMem_sq_of_map_le {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (I : Ideal R) (J : Ideal S) (hIJ : I.map φ ≤ J) (a : R)
    (ha : φ a ∉ J ^ 2) : a ∉ I ^ 2 := by
  intro hmem
  have hmap : (I ^ 2).map φ ≤ J ^ 2 := by
    rw [Ideal.map_pow, pow_two, pow_two]
    exact Ideal.mul_mono hIJ hIJ
  exact ha (hmap (Ideal.mem_map_of_mem φ hmem))

/-- If the maximal ideal `m` of a local ring is generated by a single nonzero element `x`, then
`x ∉ m²`. -/
public theorem notMem_sq_maximalIdeal_of_span_eq {R : Type u} [CommRing R] [IsLocalRing R]
    (x : R) (hx : Ideal.span ({x} : Set R) = IsLocalRing.maximalIdeal R) (hne : x ≠ 0) :
    x ∉ (IsLocalRing.maximalIdeal R) ^ 2 := by
  intro hmem
  rw [← hx, pow_two, Ideal.span_singleton_mul_span_singleton,
    Ideal.mem_span_singleton] at hmem
  obtain ⟨c, hc⟩ := hmem
  have hzero : x * (1 - c * x) = 0 := by linear_combination hc
  have hcx : c * x ∈ IsLocalRing.maximalIdeal R := by
    rw [← hx]
    exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self x)
  exact hne ((IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ hcx).mul_left_eq_zero.mp hzero)

/-! ### The two preimages of a square agree -/

/-- For a commutative square `i ≫ k = f ≫ j` and an open `V` of the bottom right corner,
`f⁻¹j⁻¹V = i⁻¹k⁻¹V`, both being the preimage of `V` along the diagonal composite. This refines the
containment `Stacks.Immersion.preimage_le_preimage_of_square` to an equality in the case
`U = k⁻¹V`. -/
public theorem preimage_eq_preimage_of_square {Z Z' W W' : Scheme.{u}} {i : Z ⟶ Z'} {j : W ⟶ W'}
    {f : Z ⟶ W} {k : Z' ⟶ W'} (hcomm : i ≫ k = f ≫ j) (V : W'.Opens) :
    f ⁻¹ᵁ (j ⁻¹ᵁ V) = i ⁻¹ᵁ (k ⁻¹ᵁ V) := by
  rw [← Scheme.Hom.comp_preimage, ← Scheme.Hom.comp_preimage, hcomm]

/-! ### A vanishing comparison map kills every conormal class it reaches -/

/-- Let `i ≫ k = f ≫ j` be a commutative square whose horizontal arrows are immersions, let `V` be
an open of `W'` and let `r ∈ Γ(W', V)` be a function vanishing on `W`. If the map of conormal
sheaves of [Stacks, Tag 01R4] attached to the square is zero, then the conormal class of `k^♯ r` in
`𝒞_{Z/Z'}` is zero. -/
public theorem conormalClass_eq_zero_of_immersionConormalSheafMap_eq_zero
    {Z Z' W W' : Scheme.{u}} (i : Z ⟶ Z') (j : W ⟶ W') (f : Z ⟶ W) (k : Z' ⟶ W')
    [IsImmersion i] [IsImmersion j] (hcomm : i ≫ k = f ≫ j)
    (V : W'.Opens) (D : W.Opens) (hD : D ≤ j ⁻¹ᵁ V)
    (hC : f ⁻¹ᵁ D ≤ i ⁻¹ᵁ (k ⁻¹ᵁ V)) (r : Γ(W', V)) (hr : (j.app V).hom r = 0)
    (h0 : Stacks.Immersion.immersionConormalSheafMap i j f k
      (Stacks.Immersion.toShHom_square hcomm) = 0) :
    conormalClass i (k ⁻¹ᵁ V) hC ((k.app V).hom r)
      (app_app_eq_zero_of_square hcomm V r hr) = 0 := by
  rw [← conormalClass_immersionConormalSheafMap_app i j f k hcomm V D hD hC r hr, h0]
  have hzero : (modulePullbackPushforwardAdjunction f.toLRSHom.toShHom).homEquiv
      (Stacks.ClosedImmersion.conormalSheaf j.liftCoborder.toLRSHom.toShHom)
      (Stacks.ClosedImmersion.conormalSheaf i.liftCoborder.toLRSHom.toShHom) 0 = 0 := by
    rw [Adjunction.homEquiv_unit, modulePushforward_map_zero]
    exact Limits.comp_zero
  rw [hzero]
  rfl

/-! ### A conormal class outside the square of the ideal is nonzero -/

/-- On an affine open `U` of `X` presenting the intersection of the immersion `i : Z ⟶ X` with `U`
as `Spec (Γ(X, U) ⧸ I)`, the conormal class of an element `a ∈ I` is nonzero as soon as `a ∉ I²`.
Here the sections of `𝒞_{Z/X}` over `Z ∩ U` are `I/I²` (part (2) of [Stacks, Tag 01R3]). -/
public theorem ne_zero_conormalClass_of_notMem_sq {Z Y : Scheme.{u}} (i : Z ⟶ Y) [IsImmersion i]
    (U : Y.Opens) (hU : IsAffineOpen U) (I : Ideal Γ(Y, U))
    (e : pullback i U.ι ≅ Spec (.of (Γ(Y, U) ⧸ I)))
    (he : pullback.snd i U.ι ≫ hU.isoSpec.hom =
      e.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))
    (a : I) (ha : (i.app U).hom (a : Γ(Y, U)) = 0) (hnot : (a : Γ(Y, U)) ∉ I ^ 2) :
    conormalClass i U (le_refl (i ⁻¹ᵁ U)) (a : Γ(Y, U)) ha ≠ 0 := by
  intro h0
  refine hnot ((Ideal.toCotangent_eq_zero I a).mp ?_)
  refine (affineConormalIsoCotangent_hom_conormalClass i U hU I e he a ha).symm.trans ?_
  exact (congrArg (ConcreteCategory.hom (affineConormalIsoCotangent i U hU I e he).hom)
    h0).trans (map_zero _)

/-! ### The comparison map is nonzero, read on one affine chart -/

/-- Let `i ≫ k = f ≫ j` be a commutative square whose horizontal arrows are immersions, let `V` be
an open of `W'` and let `r ∈ Γ(W', V)` vanish on `W`. Let `U ≤ k⁻¹V` be an affine open of `Z'`
presenting the intersection of `Z` with `U` as `Spec (Γ(Z', U) ⧸ I)`, and suppose the restriction
of `k^♯ r` to `U` lies in `I` but **not** in `I²`. Then the map of conormal sheaves
`f^* 𝒞_{W/W'} ⟶ 𝒞_{Z/Z'}` of [Stacks, Tag 01R4] attached to the square is nonzero. -/
public theorem ne_zero_immersionConormalSheafMap_of_notMem_sq {Z Z' W W' : Scheme.{u}}
    (i : Z ⟶ Z') (j : W ⟶ W') (f : Z ⟶ W) (k : Z' ⟶ W')
    [IsImmersion i] [IsImmersion j] (hcomm : i ≫ k = f ≫ j)
    (V : W'.Opens) (r : Γ(W', V)) (hr : (j.app V).hom r = 0)
    (U : Z'.Opens) (hUV : U ≤ k ⁻¹ᵁ V) (hU : IsAffineOpen U) (I : Ideal Γ(Z', U))
    (e : pullback i U.ι ≅ Spec (.of (Γ(Z', U) ⧸ I)))
    (he : pullback.snd i U.ι ≫ hU.isoSpec.hom =
      e.hom ≫ Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))
    (a : I) (ha : (a : Γ(Z', U)) =
      (Z'.presheaf.map (homOfLE hUV).op).hom ((k.app V).hom r))
    (hnot : (a : Γ(Z', U)) ∉ I ^ 2) :
    Stacks.Immersion.immersionConormalSheafMap i j f k
      (Stacks.Immersion.toShHom_square hcomm) ≠ 0 := by
  intro h0
  have hC : f ⁻¹ᵁ (j ⁻¹ᵁ V) ≤ i ⁻¹ᵁ (k ⁻¹ᵁ V) :=
    le_of_eq (preimage_eq_preimage_of_square hcomm V)
  have hs : (i.app (k ⁻¹ᵁ V)).hom ((k.app V).hom r) = 0 :=
    app_app_eq_zero_of_square hcomm V r hr
  have hzero := conormalClass_eq_zero_of_immersionConormalSheafMap_eq_zero i j f k hcomm V
    (j ⁻¹ᵁ V) (le_refl _) hC r hr h0
  have hsmall : i ⁻¹ᵁ U ≤ f ⁻¹ᵁ (j ⁻¹ᵁ V) := by
    rw [preimage_eq_preimage_of_square hcomm V]
    exact i.preimage_mono hUV
  have ha' : (i.app U).hom ((Z'.presheaf.map (homOfLE hUV).op).hom ((k.app V).hom r)) = 0 := by
    have hn := congrArg (fun q : Γ(Z', k ⁻¹ᵁ V) ⟶ Γ(Z, i ⁻¹ᵁ U) => q.hom ((k.app V).hom r))
      (Scheme.Hom.naturality i (homOfLE hUV).op)
    simp only [CommRingCat.comp_apply] at hn
    rw [hn, hs, map_zero]
  have haa : (i.app U).hom (a : Γ(Z', U)) = 0 := by rwa [ha]
  refine ne_zero_conormalClass_of_notMem_sq i U hU I e he a haa hnot ?_
  have hrestrict := conormalClass_restrict i (k ⁻¹ᵁ V) U hUV hC (le_refl (i ⁻¹ᵁ U)) hsmall
    ((k.app V).hom r) hs ha'
  rw [conormalClass_congr i U (le_refl (i ⁻¹ᵁ U)) ha haa ha', ← hrestrict, hzero]
  exact map_zero _

end Stacks.Conormal

end
