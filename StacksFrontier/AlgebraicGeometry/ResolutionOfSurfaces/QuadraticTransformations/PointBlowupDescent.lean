/-!
# From the local splitting of a regular local surface to the colength descent on a scheme

The proof of [Stacks, Tag 0AHH] is an induction on the total colength of an ideal sheaf `J`
supported on a finite set `S` of closed points of a scheme `Y` whose local rings are regular of
dimension two. The step blows up a point `y` of the support of `J` and must produce, on the
blowup `X` with exceptional divisor `E`, an exponent `d`, a finite set `S'` of closed points with
regular two-dimensional local rings lying over `S`, and an ideal sheaf `J'` supported in `S'`,
with `E ^ d · J' = J𝒪_X` and strictly smaller total colength. That is the hypothesis `descent` of
`Stacks.ResolutionOfSurfaces.exists_pointBlowupChain_isEffectiveCartierDivisor`.

This file derives that step from the corresponding statement for the blowup of a regular local
ring of dimension two in its maximal ideal (the content of [Stacks, Tag 0AGT]), following the
source's proof: flat base change along `Spec 𝒪_{Y,y} ⟶ Y` ([Stacks, Tag 0805]) identifies the
blowup of `Spec 𝒪_{Y,y}` with the fibre product of `X` over `Y`, and the comparison morphism is a
flat preimmersion, hence an isomorphism on local rings and a topological embedding whose image
contains the whole fibre over `y`. Away from `y` the blowup is an isomorphism.

## Main results

* `Stacks.ResolutionOfSurfaces.pointBlowupDescent` — the `descent` step of Tag 0AHH on an
  arbitrary scheme.
* `Stacks.ResolutionOfSurfaces.exists_maximalIdeal_pow_le_stalk`,
  `Stacks.ResolutionOfSurfaces.length_stalkQuotient_lt_top` — the stalk of an ideal sheaf
  supported on a set of closed points is primary to the maximal ideal and has finite colength.
* `Stacks.ResolutionOfSurfaces.length_stalkQuotient_comap` — colengths are invariant along
  morphisms that are isomorphisms on local rings.

## Implementation notes

The residual ideal is the ideal quotient `J𝒪_X : E ^ d`
(`AlgebraicGeometry.exists_mul_eq_of_le_of_isEffectiveCartierDivisor`) once `J𝒪_X ≤ E ^ d` is
known; that inclusion, the identification of the residual ideal with the local one over the
centre (by cancelling the invertible ideal `E ^ d` stalkwise), and the colength comparison are
all checked on stalks. The total colength over `S'` splits into the fibre over `y`, which is the
local colength sum and drops strictly below the colength at `y`, and the rest, which maps
injectively to `S \ {y}` with the same colengths. No Noetherian hypothesis on `Y` is needed: the
local rings at the points of `S` are regular, hence Noetherian, and that is all the finiteness
the argument uses.

## References

* [Stacks Project, Tag 0AHH](https://stacks.math.columbia.edu/tag/0AHH)
* [Stacks Project, Tag 0AGT](https://stacks.math.columbia.edu/tag/0AGT)
* [Stacks Project, Tag 0805](https://stacks.math.columbia.edu/tag/0805)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace Stacks.ResolutionOfSurfaces

/-! ### Stalks of ideal sheaves along morphisms that are isomorphisms on local rings -/

/-- **An ideal sheaf on `Spec 𝒪_{X,x}` pulled back from `X` is the one generated by its stalk at
`x`.** -/
theorem comap_fromSpecStalk_eq_ofIdealTop {X : Scheme.{u}} (J : X.IdealSheafData) (x : X) :
    J.comap (X.fromSpecStalk x) = Scheme.IdealSheafData.ofIdealTop
      ((IdealSheafData.stalk J x).map (Scheme.ΓSpecIso (X.presheaf.stalk x)).inv.hom) := by
  refine Scheme.IdealSheafData.ext_of_isAffine ?_
  rw [ideal_comap_fromSpecStalk, Scheme.IdealSheafData.ofIdealTop_ideal]
  simp

/-- **Along a morphism that is an isomorphism on the local ring at `x`, inclusions of stalks of
inverse-image ideal sheaves at `x` are inclusions of stalks at the image point.** -/
theorem stalk_comap_le_stalk_comap_iff {X Y : Scheme.{u}} (f : X ⟶ Y) (x : X)
    [IsIso (f.stalkMap x)] (K L : Y.IdealSheafData) :
    IdealSheafData.stalk (K.comap f) x ≤ IdealSheafData.stalk (L.comap f) x ↔
      IdealSheafData.stalk K (f x) ≤ IdealSheafData.stalk L (f x) := by
  rw [IdealSheafData.stalk_comap, IdealSheafData.stalk_comap]
  have hbij := ConcreteCategory.bijective_of_isIso (f.stalkMap x)
  refine ⟨fun h => ?_, Ideal.map_mono⟩
  have hc := Ideal.comap_mono (f := (f.stalkMap x).hom) h
  rwa [Ideal.comap_map_of_bijective _ hbij, Ideal.comap_map_of_bijective _ hbij] at hc

/-- **Along a morphism that is an isomorphism on the local ring at `x`, the colength of an
inverse-image ideal sheaf at `x` is the colength of the ideal sheaf at the image point.** -/
theorem length_stalkQuotient_comap {X Y : Scheme.{u}} (f : X ⟶ Y) (x : X)
    [IsIso (f.stalkMap x)] (K : Y.IdealSheafData) :
    Module.length (X.presheaf.stalk x)
        (X.presheaf.stalk x ⧸ IdealSheafData.stalk (K.comap f) x) =
      Module.length (Y.presheaf.stalk (f x))
        (Y.presheaf.stalk (f x) ⧸ IdealSheafData.stalk K (f x)) := by
  rw [IdealSheafData.stalk_comap,
    Module.quotient_length_eq_of_ringEquiv (asIso (f.stalkMap x)).commRingCatIsoToRingEquiv]
  rfl

/-! ### Ideal sheaves supported at finitely many closed points -/

/-- **A point of `Spec 𝒪_{X,x}` lying over a closed point of a set `T` is the closed point.** Its
image generizes `x`, and a closed point generizes only itself. -/
theorem eq_closedPoint_of_fromSpecStalk_mem {X : Scheme.{u}} (x : X) (T : Set X)
    (hT : ∀ y ∈ T, IsClosed ({y} : Set X)) (z : Spec (X.presheaf.stalk x))
    (hz : X.fromSpecStalk x z ∈ T) : z = IsLocalRing.closedPoint (X.presheaf.stalk x) := by
  have hzx : X.fromSpecStalk x z ⤳ x :=
    ((IsLocalRing.specializes_closedPoint z).map (X.fromSpecStalk x).continuous).trans
      (specializes_of_eq Scheme.fromSpecStalk_closedPoint)
  have hpoint : X.fromSpecStalk x z = x := by
    have h := hzx.mem_closure
    rwa [(hT _ hz).closure_eq, Set.mem_singleton_iff, eq_comm] at h
  apply (X.fromSpecStalk x).isEmbedding.injective
  rw [hpoint, Scheme.fromSpecStalk_closedPoint]

/-- **The stalk of an ideal sheaf supported on a set of closed points cuts out at most the closed
point of the local ring.** -/
theorem zeroLocus_stalk_subset_closedPoint {X : Scheme.{u}} (J : X.IdealSheafData) (T : Set X)
    (hT : ∀ y ∈ T, IsClosed ({y} : Set X)) (hJT : (J.support : Set X) ⊆ T) (x : X) :
    PrimeSpectrum.zeroLocus (IdealSheafData.stalk J x : Set (X.presheaf.stalk x)) ⊆
      {IsLocalRing.closedPoint (X.presheaf.stalk x)} := by
  have hsupp : ((J.comap (X.fromSpecStalk x)).support : Set (Spec (X.presheaf.stalk x))) =
      PrimeSpectrum.zeroLocus (IdealSheafData.stalk J x : Set (X.presheaf.stalk x)) := by
    rw [comap_fromSpecStalk_eq_ofIdealTop, Scheme.IdealSheafData.coe_support_ofIdealTop,
      Spec_zeroLocus, ← Ideal.coe_comap,
      Ideal.comap_map_of_bijective _ (ConcreteCategory.bijective_of_isIso _)]
  rw [← hsupp, Scheme.IdealSheafData.support_comap, TopologicalSpace.Closeds.coe_preimage]
  exact fun z hz => Set.mem_singleton_iff.mpr
    (eq_closedPoint_of_fromSpecStalk_mem x T hT z (hJT hz))

/-- **The stalk of an ideal sheaf supported on a set of closed points is primary to the maximal
ideal**, when the local ring is Noetherian: it contains a power of the maximal ideal. -/
theorem exists_maximalIdeal_pow_le_stalk {X : Scheme.{u}} (J : X.IdealSheafData) (T : Set X)
    (hT : ∀ y ∈ T, IsClosed ({y} : Set X)) (hJT : (J.support : Set X) ⊆ T) (x : X)
    [IsNoetherianRing (X.presheaf.stalk x)] :
    ∃ n : ℕ, IsLocalRing.maximalIdeal (X.presheaf.stalk x) ^ n ≤ IdealSheafData.stalk J x := by
  apply Ideal.exists_pow_le_of_le_radical_of_fg _ (IsNoetherian.noetherian _)
  rw [← PrimeSpectrum.zeroLocus_subset_zeroLocus_iff, zeroLocus_maximalIdeal]
  exact zeroLocus_stalk_subset_closedPoint J T hT hJT x

/-- **The colength of an ideal sheaf supported on a set of closed points is finite** at every
point with Noetherian local ring. -/
theorem length_stalkQuotient_lt_top {X : Scheme.{u}} (J : X.IdealSheafData) (T : Set X)
    (hT : ∀ y ∈ T, IsClosed ({y} : Set X)) (hJT : (J.support : Set X) ⊆ T) (x : X)
    [IsNoetherianRing (X.presheaf.stalk x)] :
    Module.length (X.presheaf.stalk x) (X.presheaf.stalk x ⧸ IdealSheafData.stalk J x) < ⊤ := by
  by_cases htop : IdealSheafData.stalk J x = ⊤
  · rw [htop]
    simp [Module.length_eq_zero]
  · refine lt_top_iff_ne_top.mpr (Module.length_ne_top_iff.mpr (isFiniteLength_of_support ?_))
    rw [Module.support_eq_zeroLocus, Ideal.annihilator_quotient]
    exact (zeroLocus_stalk_subset_closedPoint J T hT hJT x).antisymm
      (Set.singleton_subset_iff.mpr (IsLocalRing.le_maximalIdeal htop))

/-! ### Point-set behaviour of the blowup at a closed point -/

/-- **Away from the centre the blowup at a closed point is an isomorphism on local rings.** -/
theorem isIso_stalkMap_blowUpToBase_of_ne {X : Scheme.{u}} (M : X.IdealSheafData) (y : X)
    (hM : (M.support : Set X) = {y}) (z : blowUp M) (hz : blowUpToBase M z ≠ y) :
    IsIso ((blowUpToBase M).stalkMap z) := by
  let U : X.Opens := ⟨M.supportᶜ, M.support.isClosed.isOpen_compl⟩
  refine isIso_stalkMap_of_isIso_morphismRestrict (U := U) _
    (isIso_blowUp_restrict_compl_support M) ?_
  show blowUpToBase M z ∉ (M.support : Set X)
  rwa [hM]

/-- The stalk of an inverse-image ideal sheaf is the unit ideal iff the image point is off the
support. -/
private theorem stalk_comap_eq_top_iff {X Y : Scheme.{u}} (f : X ⟶ Y) (J : Y.IdealSheafData)
    (z : X) : IdealSheafData.stalk (J.comap f) z = ⊤ ↔ f z ∉ (J.support : Set Y) := by
  rw [IdealSheafData.stalk_eq_top_iff_not_mem_support, Scheme.IdealSheafData.support_comap]
  rfl

/-- **Away from the centre the exceptional ideal is the unit ideal on stalks.** -/
theorem stalk_exceptionalIdeal_eq_top_of_ne {X : Scheme.{u}} (M : X.IdealSheafData) (y : X)
    (hM : (M.support : Set X) = {y}) (z : blowUp M) (hz : blowUpToBase M z ≠ y) :
    IdealSheafData.stalk (exceptionalIdeal M) z = ⊤ :=
  (stalk_comap_eq_top_iff (blowUpToBase M) M z).mpr (by rwa [hM])

/-- Away from the centre, powers of the exceptional ideal are the unit ideal on stalks. -/
private theorem stalk_exceptionalIdeal_pow_eq_top_of_ne {X : Scheme.{u}} (M : X.IdealSheafData)
    (y : X) (hM : (M.support : Set X) = {y}) (d : ℕ) (z : blowUp M) (hz : blowUpToBase M z ≠ y) :
    IdealSheafData.stalk (exceptionalIdeal M ^ d) z = ⊤ := by
  rw [IdealSheafData.stalk_pow, stalk_exceptionalIdeal_eq_top_of_ne M y hM z hz, Ideal.top_pow]

/-- Off the centre, two points of the blowup with the same image in the base are equal. -/
private theorem eq_of_blowUpToBase_eq_of_ne {X : Scheme.{u}} (M : X.IdealSheafData) (y : X)
    (hM : (M.support : Set X) = {y}) {w₁ w₂ : blowUp M} (hw : blowUpToBase M w₁ ≠ y)
    (he : blowUpToBase M w₁ = blowUpToBase M w₂) : w₁ = w₂ :=
  blowUpToBase_injective_of_notMem_support M (by rwa [hM]) he

/-- **Off the centre, a closed point of the base pulls back to a closed point of the blowup.** -/
private theorem isClosed_singleton_of_blowUpToBase_ne {X : Scheme.{u}} (M : X.IdealSheafData)
    (y : X) (hM : (M.support : Set X) = {y}) (w : blowUp M) (hwy : blowUpToBase M w ≠ y)
    (hw : IsClosed ({blowUpToBase M w} : Set X)) : IsClosed ({w} : Set (blowUp M)) := by
  have hpre : blowUpToBase M ⁻¹' {blowUpToBase M w} = {w} := by
    ext b
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    exact ⟨fun hb => (eq_of_blowUpToBase_eq_of_ne M y hM hwy hb.symm).symm, congrArg _⟩
  rw [← hpre]
  exact hw.preimage (blowUpToBase M).continuous

/-- **Off the centre, the blowup is injective over a finite set of points of the base.** -/
private theorem finite_setOf_blowUpToBase_ne_mem {X : Scheme.{u}} (M : X.IdealSheafData) (y : X)
    (hM : (M.support : Set X) = {y}) (S : Finset X) :
    {w : blowUp M | blowUpToBase M w ≠ y ∧ blowUpToBase M w ∈ S}.Finite := by
  refine Set.Finite.of_finite_image (f := blowUpToBase M) (S.finite_toSet.subset ?_) ?_
  · rintro _ ⟨w, hw, rfl⟩
    exact hw.2
  · intro w₁ hw₁ w₂ _ he
    exact eq_of_blowUpToBase_eq_of_ne M y hM hw₁.1 he

/-- **A preimmersion containing the fibre over a closed point maps closed points of that fibre
to closed points.** -/
private theorem isClosed_singleton_of_isPreimmersion {X' X Y : Scheme.{u}} (h : X' ⟶ X)
    [IsPreimmersion h] (p : X ⟶ Y) (y : Y) (hy : IsClosed ({y} : Set Y))
    (hfibre : ∀ b, p b = y → ∃ c, h c = b) (v : X') (hv : IsClosed ({v} : Set X'))
    (hvy : p (h v) = y) : IsClosed ({h v} : Set X) := by
  rw [← closure_subset_iff_isClosed]
  intro b hb
  have hab : h v ⤳ b := specializes_iff_mem_closure.mpr hb
  have hby : p b = y := by
    have hc := (hab.map p.continuous).mem_closure
    rwa [hvy, hy.closure_eq, Set.mem_singleton_iff] at hc
  obtain ⟨c, rfl⟩ := hfibre b hby
  obtain rfl : c = v := by
    have hc := ((IsPreimmersion.isEmbedding h).isInducing.specializes_iff.mp hab).mem_closure
    rwa [hv.closure_eq, Set.mem_singleton_iff] at hc
  exact Set.mem_singleton _

/-- **Ideal sheaves on a blowup cancel against powers of the exceptional ideal.** -/
private theorem eq_of_exceptionalIdeal_pow_mul_eq {X : Scheme.{u}} (M : X.IdealSheafData) (d : ℕ)
    {A B : (blowUp M).IdealSheafData}
    (heq : exceptionalIdeal M ^ d * A = exceptionalIdeal M ^ d * B) : A = B := by
  refine IdealSheafData.eq_of_stalk_eq _ _ fun v => ?_
  obtain ⟨a, ha, hspan⟩ := exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor _
    (Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal M) v
  have hv := congrArg (fun L => IdealSheafData.stalk L v) heq
  simp only [IdealSheafData.stalk_mul, IdealSheafData.stalk_pow, hspan,
    Ideal.span_singleton_pow] at hv
  ext b
  have hb : a ^ d * b ∈ Ideal.span {a ^ d} * IdealSheafData.stalk A v ↔
      a ^ d * b ∈ Ideal.span {a ^ d} * IdealSheafData.stalk B v := by rw [hv]
  simpa only [Ideal.mem_span_singleton_mul, (ha.pow d).left.eq_iff, exists_eq_right] using hb

/-- **Off the centre, the colength of an ideal sheaf on the blowup agreeing with `J𝒪` is bounded
by the colengths of `J` at the remaining points.** -/
private theorem sum_length_filter_ne_le {X : Scheme.{u}} [DecidableEq X] (M : X.IdealSheafData)
    (y : X) (hM : (M.support : Set X) = {y}) (K : (blowUp M).IdealSheafData) (J : X.IdealSheafData)
    (T : Finset (blowUp M)) (S : Finset X)
    (hKoff : ∀ w : blowUp M, blowUpToBase M w ≠ y →
      IdealSheafData.stalk K w = IdealSheafData.stalk (J.comap (blowUpToBase M)) w)
    (hTS : ∀ w ∈ T, blowUpToBase M w ∈ S) :
    ∑ w ∈ T.filter (fun w => blowUpToBase M w ≠ y), Module.length ((blowUp M).presheaf.stalk w)
        ((blowUp M).presheaf.stalk w ⧸ IdealSheafData.stalk K w) ≤
      ∑ s ∈ S.erase y, Module.length (X.presheaf.stalk s)
        (X.presheaf.stalk s ⧸ IdealSheafData.stalk J s) := by
  have hinj : Set.InjOn (blowUpToBase M) (T.filter (fun w => blowUpToBase M w ≠ y) : Set _) :=
    fun w₁ hw₁ w₂ _ he =>
      eq_of_blowUpToBase_eq_of_ne M y hM (Finset.mem_filter.mp hw₁).2 he
  calc ∑ w ∈ T.filter (fun w => blowUpToBase M w ≠ y), Module.length
        ((blowUp M).presheaf.stalk w) ((blowUp M).presheaf.stalk w ⧸ IdealSheafData.stalk K w)
      = ∑ w ∈ T.filter (fun w => blowUpToBase M w ≠ y), Module.length
        (X.presheaf.stalk (blowUpToBase M w))
        (X.presheaf.stalk (blowUpToBase M w) ⧸ IdealSheafData.stalk J (blowUpToBase M w)) := by
        refine Finset.sum_congr rfl fun w hw => ?_
        have hwy := (Finset.mem_filter.mp hw).2
        have := isIso_stalkMap_blowUpToBase_of_ne M y hM w hwy
        rw [hKoff w hwy, length_stalkQuotient_comap (blowUpToBase M) w J]
    _ = ∑ s ∈ (T.filter (fun w => blowUpToBase M w ≠ y)).image (blowUpToBase M),
        Module.length (X.presheaf.stalk s) (X.presheaf.stalk s ⧸ IdealSheafData.stalk J s) :=
        (Finset.sum_image (f := fun s => Module.length (X.presheaf.stalk s)
          (X.presheaf.stalk s ⧸ IdealSheafData.stalk J s)) hinj).symm
    _ ≤ _ := by
        refine Finset.sum_le_sum_of_subset fun s hs => ?_
        obtain ⟨w, hw, rfl⟩ := Finset.mem_image.mp hs
        exact Finset.mem_erase.mpr ⟨(Finset.mem_filter.mp hw).2, hTS w (Finset.mem_filter.mp hw).1⟩

/-- **Along a preimmersion that is an isomorphism on local rings, colengths over a set of points
in the image of `T₀` are bounded by the colengths of the inverse image over `T₀`.** -/
private theorem sum_length_le_of_subset_image {X X' : Scheme.{u}} [DecidableEq X] (h : X' ⟶ X)
    [IsPreimmersion h] [∀ v, IsIso (h.stalkMap v)] (K : X.IdealSheafData) (U : Finset X)
    (T₀ : Finset X') (hU : U ⊆ T₀.image h) :
    ∑ w ∈ U, Module.length (X.presheaf.stalk w) (X.presheaf.stalk w ⧸ IdealSheafData.stalk K w) ≤
      ∑ v ∈ T₀, Module.length (X'.presheaf.stalk v)
        (X'.presheaf.stalk v ⧸ IdealSheafData.stalk (K.comap h) v) := by
  refine (Finset.sum_le_sum_of_subset hU).trans_eq ?_
  rw [Finset.sum_image fun v₁ _ v₂ _ he => (IsPreimmersion.isEmbedding h).injective he]
  exact Finset.sum_congr rfl fun v _ => (length_stalkQuotient_comap h v K).symm

/-- **A sum drops strictly when its part over the fibre of `y` drops below the term at `y` and
the rest is bounded by the remaining terms.** -/
private theorem sum_lt_sum_of_sum_filter_lt {α β : Type*} [DecidableEq β] (f : α → β) (T : Finset α)
    (S : Finset β) {y : β} (hyS : y ∈ S) (a : α → ℕ∞) (b : β → ℕ∞)
    (hfib : ∑ w ∈ T.filter (fun w => f w = y), a w < b y)
    (hoff : ∑ w ∈ T.filter (fun w => f w ≠ y), a w ≤ ∑ s ∈ S.erase y, b s)
    (hfin : ∀ s ∈ S.erase y, b s ≠ ⊤) : ∑ w ∈ T, a w < ∑ s ∈ S, b s := by
  rw [← Finset.sum_filter_add_sum_filter_not T (fun w => f w = y), ← Finset.add_sum_erase S b hyS]
  calc _ ≤ ∑ w ∈ T.filter (fun w => f w = y), a w + ∑ s ∈ S.erase y, b s :=
        add_le_add_right hoff _
    _ < b y + ∑ s ∈ S.erase y, b s := (ENat.add_lt_add_iff_right (ENat.sum_ne_top.mpr hfin)).2 hfib

/-! ### The colength descent -/

/-- **The local splitting at a regular local surface** ([Stacks, Tag 0AGT]): for an ideal `I`
of a two-dimensional regular local ring `A` primary to the maximal ideal, the pullback of `I` to
the blowup of `A` at its closed point is `E ^ d · J'` with `J'` supported on finitely many closed
points and of total colength strictly smaller than that of `I`. -/
private theorem exists_exceptionalIdeal_pow_mul_eq_comap_ofIdealTop (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdimA : ringKrullDim A = 2)
    (ℐ : (Spec (CommRingCat.of A)).IdealSheafData) (hℐ : ℐ = (Stacks.Blowup.residuePoint A).ker)
    (I : Ideal A) (n : ℕ) (hnI : IsLocalRing.maximalIdeal A ^ n ≤ I)
    (hIm : I ≤ IsLocalRing.maximalIdeal A) :
    ∃ (d : ℕ) (J' : (blowUp ℐ).IdealSheafData) (T : Finset (blowUp ℐ)),
      exceptionalIdeal ℐ ^ d * J' = (Scheme.IdealSheafData.ofIdealTop
        (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ) ∧
      (J'.support : Set (blowUp ℐ)) = (T : Set (blowUp ℐ)) ∧
      (∀ x ∈ T, IsClosed ({x} : Set (blowUp ℐ))) ∧
      ∑ x ∈ T, Module.length ((blowUp ℐ).presheaf.stalk x)
        ((blowUp ℐ).presheaf.stalk x ⧸ IdealSheafData.stalk J' x) <
        Module.length A (A ⧸ I) := by
  obtain ⟨d, -, hd, hmax⟩ := exists_maximal_order_comap_ofIdealTop A hdimA ℐ hℐ I n hnI
  obtain ⟨-, J', T', hmul, -, hsupp, hcl, hlt, hle⟩ :=
    exists_residualIdeal_of_maximal_order_of_strict A hdimA ℐ hℐ I n hnI hIm d hd hmax
      fun I' hI' => length_globalSections_lt_length_quotient_blowUp A hdimA ℐ
        (hℐ.trans (ker_residuePoint_eq_ofIdealTop_map A)) I n hnI hIm d hd hmax I' hI'
  exact ⟨d, J', T', hmul, hsupp, hcl, hle.trans_lt hlt⟩

/-- **The ideal sheaf of a closed point pulls back to `Spec 𝒪_{Y,y}` as the ideal of the closed
point.** -/
private theorem comap_fromSpecStalk_vanishingIdeal_eq_ker_residuePoint {Y : Scheme.{u}} (y : Y)
    (hy : IsClosed ({y} : Set Y)) :
    (Scheme.IdealSheafData.vanishingIdeal ⟨{y}, hy⟩).comap (Y.fromSpecStalk y) =
      (Stacks.Blowup.residuePoint (Y.presheaf.stalk y)).ker := by
  rw [vanishingIdeal_singleton_comap_fromSpecStalk y hy, Scheme.ker_SpecMap,
    ker_residuePoint_eq_ofIdealTop_map]
  show Scheme.IdealSheafData.ofIdealTop
    (Ideal.map _ (RingHom.ker (IsLocalRing.residue (Y.presheaf.stalk y)))) = _
  rw [IsLocalRing.ker_residue]
  rfl

/-- **The fibre of the blowup over `y` lies in the image of the blowup of `Spec 𝒪_{Y,y}`.** -/
private theorem exists_eq_of_isPullback_fromSpecStalk {Y : Scheme.{u}} (y : Y)
    (M : Y.IdealSheafData) {h : blowUp (M.comap (Y.fromSpecStalk y)) ⟶ blowUp M}
    (hpb : IsPullback (blowUpToBase (M.comap (Y.fromSpecStalk y))) h (Y.fromSpecStalk y)
      (blowUpToBase M)) (w : blowUp M) (hw : blowUpToBase M w = y) : ∃ v, h v = w := by
  obtain ⟨v, -, hv⟩ := Scheme.exists_preimage_of_isPullback hpb
    (IsLocalRing.closedPoint (Y.presheaf.stalk y)) w
    (Scheme.fromSpecStalk_closedPoint.trans hw.symm)
  exact ⟨v, hv⟩

/-- **The residual ideal on the blowup at a point.** Let `X` be the blowup of `Y` at `y` and
`X₁ ⟶ X` a base change of it along `g : Y₁ ⟶ Y`, an isomorphism on local rings whose image
contains the fibre over `y`. If `J𝒪 = E ^ d · J₀` on `X₁`, then `J𝒪_X = E ^ d · K` with `K`
pulling back to `J₀` and agreeing with `J𝒪_X` off the centre. -/
private theorem exists_eq_exceptionalIdeal_pow_mul_of_isPullback {Y Y₁ : Scheme.{u}} (g : Y₁ ⟶ Y)
    (y : Y) (M : Y.IdealSheafData) (hM : (M.support : Set Y) = {y}) (J : Y.IdealSheafData) (d : ℕ)
    (J₀ : (blowUp (M.comap g)).IdealSheafData)
    (hsplit₀ : exceptionalIdeal (M.comap g) ^ d * J₀ =
      (J.comap g).comap (blowUpToBase (M.comap g)))
    {h : blowUp (M.comap g) ⟶ blowUp M} [∀ v, IsIso (h.stalkMap v)]
    (hpb : IsPullback (blowUpToBase (M.comap g)) h g (blowUpToBase M))
    (hfibre : ∀ w, blowUpToBase M w = y → ∃ v, h v = w) :
    ∃ K : (blowUp M).IdealSheafData,
      J.comap (blowUpToBase M) = exceptionalIdeal M ^ d * K ∧ K.comap h = J₀ ∧
      ∀ w : blowUp M, blowUpToBase M w ≠ y →
        IdealSheafData.stalk K w = IdealSheafData.stalk (J.comap (blowUpToBase M)) w := by
  have hcomap (A : Y.IdealSheafData) :
      (A.comap (blowUpToBase M)).comap h = (A.comap g).comap (blowUpToBase (M.comap g)) := by
    simp only [← Scheme.IdealSheafData.comap_comp, hpb.w]
  have hJh := hcomap J
  have hEdh : (exceptionalIdeal M ^ d).comap h = exceptionalIdeal (M.comap g) ^ d := by
    rw [Stacks.IdealSheaf.comap_pow]
    exact congrArg (· ^ d) (hcomap M)
  -- Step 1: `J𝒪 ≤ E ^ d`.
  have hle : J.comap (blowUpToBase M) ≤ exceptionalIdeal M ^ d := by
    refine IdealSheafData.le_of_stalk_le _ _ fun w => ?_
    by_cases hwy : blowUpToBase M w = y
    · obtain ⟨v, rfl⟩ := hfibre w hwy
      refine (stalk_comap_le_stalk_comap_iff h v _ _).mp ?_
      rw [hJh, hEdh, ← hsplit₀]
      exact IdealSheafData.stalk_mono (Scheme.IdealSheafData.mul_le_left _ _) v
    · rw [stalk_exceptionalIdeal_pow_eq_top_of_ne M y hM d w hwy]
      exact le_top
  -- Step 2: divide by `E ^ d`.
  obtain ⟨K, hKmul⟩ := exists_mul_eq_of_le_of_isEffectiveCartierDivisor _ _
    (Stacks.Divisors.isEffectiveCartierDivisor_pow
      (Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal M) d) hle
  -- Step 3: the residual ideal over the centre is the local one.
  refine ⟨K, hKmul, eq_of_exceptionalIdeal_pow_mul_eq (M.comap g) d ?_, fun w hwy => ?_⟩
  · rw [hsplit₀, ← hJh, hKmul, AlgebraicGeometry.comap_mul, hEdh]
  -- Off the centre the residual ideal is the pulled-back one.
  · rw [hKmul, IdealSheafData.stalk_mul, stalk_exceptionalIdeal_pow_eq_top_of_ne M y hM d w hwy,
      Ideal.top_mul]

/-- **A point in the support of the residual ideal lies either in the image of the local
residual support over `y`, or over a point of `S` other than `y`.** -/
private theorem mem_image_or_mem_of_mem_support_residual {Y : Scheme.{u}} (y : Y)
    (M : Y.IdealSheafData)
    (S : Finset Y) (J : Y.IdealSheafData) (hJS : (J.support : Set Y) ⊆ S) {X' : Scheme.{u}}
    (h : X' ⟶ blowUp M) (hfibre : ∀ w, blowUpToBase M w = y → ∃ v, h v = w)
    (K : (blowUp M).IdealSheafData) (T₀ : Finset X')
    (hsupp : ((K.comap h).support : Set X') = T₀)
    (hKoff : ∀ w : blowUp M, blowUpToBase M w ≠ y →
      IdealSheafData.stalk K w = IdealSheafData.stalk (J.comap (blowUpToBase M)) w)
    (w : blowUp M) (hw : w ∈ (K.support : Set (blowUp M))) :
    (blowUpToBase M w = y ∧ ∃ v ∈ T₀, h v = w) ∨
      (blowUpToBase M w ≠ y ∧ blowUpToBase M w ∈ S) := by
  by_cases hwy : blowUpToBase M w = y
  · obtain ⟨v, rfl⟩ := hfibre w hwy
    refine Or.inl ⟨hwy, v, ?_, rfl⟩
    have hv : v ∈ ((K.comap h).support : Set X') := by
      rw [Scheme.IdealSheafData.support_comap, TopologicalSpace.Closeds.coe_preimage]
      exact hw
    rwa [hsupp] at hv
  · refine Or.inr ⟨hwy, hJS ?_⟩
    have hw' : IdealSheafData.stalk K w ≠ ⊤ :=
      fun htop => (IdealSheafData.stalk_eq_top_iff_not_mem_support K w).mp htop hw
    rw [hKoff w hwy] at hw'
    exact not_not.mp (mt (stalk_comap_eq_top_iff (blowUpToBase M) J w).mpr hw')

/-- **The residual ideal on the blowup at a closed point is supported on a finite set of closed
points lying over `S`**, whose points over `y` come from the local residual support `T₀`. -/
private theorem exists_finset_eq_support_residual {Y : Scheme.{u}} (y : Y)
    (hy : IsClosed ({y} : Set Y))
    (M : Y.IdealSheafData) (hM : (M.support : Set Y) = {y}) (S : Finset Y)
    (hS : ∀ s ∈ S, IsClosed ({s} : Set Y)) (hyS : y ∈ S) (J : Y.IdealSheafData)
    (hJS : (J.support : Set Y) ⊆ S) {X' : Scheme.{u}} (h : X' ⟶ blowUp M) [IsPreimmersion h]
    (hfibre : ∀ w, blowUpToBase M w = y → ∃ v, h v = w) (K : (blowUp M).IdealSheafData)
    (T₀ : Finset X') (hT₀ : ∀ v ∈ T₀, IsClosed ({v} : Set X'))
    (hsupp : ((K.comap h).support : Set X') = T₀)
    (hKoff : ∀ w : blowUp M, blowUpToBase M w ≠ y →
      IdealSheafData.stalk K w = IdealSheafData.stalk (J.comap (blowUpToBase M)) w) :
    ∃ T : Finset (blowUp M), (K.support : Set (blowUp M)) = T ∧
      (∀ w ∈ T, IsClosed ({w} : Set (blowUp M))) ∧ (∀ w ∈ T, blowUpToBase M w ∈ S) ∧
      ∀ w ∈ T, blowUpToBase M w = y → ∃ v ∈ T₀, h v = w := by
  have hsuppK := mem_image_or_mem_of_mem_support_residual y M S J hJS h hfibre K T₀ hsupp hKoff
  have hfin : (K.support : Set (blowUp M)).Finite := by
    refine ((T₀.finite_toSet.image h).union (finite_setOf_blowUpToBase_ne_mem M y hM S)).subset
      fun w hw => ?_
    rcases hsuppK w hw with ⟨-, v, hv, rfl⟩ | hw'
    · exact Or.inl ⟨v, hv, rfl⟩
    · exact Or.inr hw'
  refine ⟨hfin.toFinset, hfin.coe_toFinset.symm, fun w hw => ?_, fun w hw => ?_,
    fun w hw he => ?_⟩ <;>
    rcases hsuppK w (hfin.mem_toFinset.mp hw) with ⟨hwy, v, hv, rfl⟩ | ⟨hwy, hwS⟩
  -- Closedness of the points of the support.
  · exact isClosed_singleton_of_isPreimmersion h (blowUpToBase M) y hy hfibre v (hT₀ v hv) hwy
  · exact isClosed_singleton_of_blowUpToBase_ne M y hM w hwy (hS _ hwS)
  · exact hwy ▸ hyS
  · exact hwS
  · exact ⟨v, hv, rfl⟩
  · exact absurd he hwy

/-- **The colength descent in the proof of [Stacks, Tag 0AHH].** Let `S` be a finite set of
closed points of a scheme `Y` with regular two-dimensional local rings, `J` an ideal sheaf
supported in `S`, `y` a point of the support of `J` and `X` the blowup of `Y` at `y`, with
exceptional divisor `E`. Then `J𝒪_X = E ^ d · J'` for an ideal sheaf `J'` supported on a finite
set `S'` of closed points of `X` with regular two-dimensional local rings lying over `S`, of
strictly smaller total colength.

The statement is `Stacks.ResolutionOfSurfaces.PointBlowupColengthDescent`, the hypothesis
`descent` of `Stacks.ResolutionOfSurfaces.exists_pointBlowupChain_isEffectiveCartierDivisor`.
The local input is [Stacks, Tag 0AGT] for the local ring `𝒪_{Y,y}`
(`AlgebraicGeometry.exists_residualIdeal_of_maximal_order_of_strict` with
`AlgebraicGeometry.length_globalSections_lt_length_quotient_blowUp`), carried to `X` by flat
base change. -/
theorem pointBlowupDescent : PointBlowupColengthDescent.{u} := by
  intro Y S J hSclosed hSreg hSdim hJS y hyJ hy M hM
  classical
  have hyS : y ∈ S := hJS hyJ
  have hreg : IsRegularLocalRing (Y.presheaf.stalk y) := hSreg y hyS
  have hMsupp : (M.support : Set Y) = {y} := by
    rw [hM, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  -- The local data at `y`.
  set g := Y.fromSpecStalk y
  have : Flat g := flat_fromSpecStalk Y y
  obtain ⟨n, hn⟩ := exists_maximalIdeal_pow_le_stalk J (S : Set Y) hSclosed hJS y
  -- The local statement at a regular local surface: [Stacks, Tag 0AGT].
  obtain ⟨d, J₀, T₀, hsplit₀, hsupp₀, hclosed₀, hlt₀⟩ :=
    exists_exceptionalIdeal_pow_mul_eq_comap_ofIdealTop (Y.presheaf.stalk y) (hSdim y hyS)
      (M.comap g) (by rw [hM]; exact comap_fromSpecStalk_vanishingIdeal_eq_ker_residuePoint y hy)
      (IdealSheafData.stalk J y) n hn <| IsLocalRing.le_maximalIdeal fun h =>
        (IdealSheafData.stalk_eq_top_iff_not_mem_support J y).mp h hyJ
  replace hsplit₀ : exceptionalIdeal (M.comap g) ^ d * J₀ =
      (J.comap g).comap (blowUpToBase (M.comap g)) := by
    rwa [comap_fromSpecStalk_eq_ofIdealTop J y]
  -- Flat base change along `Spec 𝒪_{Y,y} ⟶ Y` ([Stacks, Tag 0805]).
  obtain ⟨h, hpb⟩ := exists_isPullback_blowUpToBase_comap g M
  have : Flat h := MorphismProperty.of_isPullback (P := @Flat) hpb inferInstance
  have : IsPreimmersion h := MorphismProperty.of_isPullback (P := @IsPreimmersion) hpb inferInstance
  have hstalkh : ∀ v, IsIso (h.stalkMap v) := fun v => isIso_stalkMap_of_flat_preimmersion h v
  -- Every point over `y` comes from the blowup of the local ring.
  have hfibre := exists_eq_of_isPullback_fromSpecStalk y M hpb
  obtain ⟨K, hKmul, hKh, hKoff⟩ :=
    exists_eq_exceptionalIdeal_pow_mul_of_isPullback g y M hMsupp J d J₀ hsplit₀ hpb hfibre
  -- Step 4: the support of the residual ideal.
  obtain ⟨T, hsuppT, hTclosed, hTS, hTfib⟩ := exists_finset_eq_support_residual y hy M hMsupp S
    hSclosed hyS J hJS h hfibre K T₀ hclosed₀ (by rw [hKh, hsupp₀]) hKoff
  refine ⟨d, T, K, hKmul.symm, hTclosed, fun z hz => ?_, fun z hz => ?_, hsuppT.le, hTS, ?_⟩
  · exact isRegularLocalRing_stalk_blowUp_of_isRegularLocalRing_stalk_blowUpToBase M y hy hM hreg
      (hSdim y hyS) z (hSreg _ (hTS z hz))
  · exact ringKrullDim_stalk_blowUp_eq_two_of_isClosed M y hy hM hreg (hSdim y hyS) z
      (hTclosed z hz) (hSdim _ (hTS z hz))
  -- Step 5: the colength drops.
  set ℓK : blowUp M → ℕ∞ := fun w => Module.length ((blowUp M).presheaf.stalk w)
    ((blowUp M).presheaf.stalk w ⧸ IdealSheafData.stalk K w)
  set ℓJ : Y → ℕ∞ := fun s => Module.length (Y.presheaf.stalk s)
    (Y.presheaf.stalk s ⧸ IdealSheafData.stalk J s)
  have hsub : T.filter (fun w => blowUpToBase M w = y) ⊆ T₀.image h := fun w hw => by
    obtain ⟨v, hv, rfl⟩ := hTfib w (Finset.mem_filter.mp hw).1 (Finset.mem_filter.mp hw).2
    exact Finset.mem_image_of_mem h hv
  have hfib : ∑ w ∈ T.filter (fun w => blowUpToBase M w = y), ℓK w < ℓJ y :=
    (sum_length_le_of_subset_image h K _ T₀ hsub).trans_lt (by rwa [hKh])
  show ∑ w ∈ T, ℓK w < ∑ s ∈ S, ℓJ s
  exact sum_lt_sum_of_sum_filter_lt (blowUpToBase M) T S hyS ℓK ℓJ hfib
    (sum_length_filter_ne_le M y hMsupp K J T S hKoff hTS) fun s hs =>
      have := hSreg s (Finset.mem_of_mem_erase hs)
      (length_stalkQuotient_lt_top J (S : Set Y) hSclosed hJS s).ne

end Stacks.ResolutionOfSurfaces

