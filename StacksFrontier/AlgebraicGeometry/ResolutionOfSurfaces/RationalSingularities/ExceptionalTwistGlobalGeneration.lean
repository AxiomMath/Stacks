@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite IsLocalRing
open Stacks.Cohomology.FormalFunctions (cohomologyDeltaFunctor cohomologyDeltaFunctor_functor)

universe u

namespace AlgebraicGeometry.BlowUpDualizing

variable (S : RationalSingularitySituation.{u})

/-! ### Global generation of the twists -/

/-- **`𝓘ⁿ` is generated by its global sections**, for `𝓘` the ideal sheaf of the exceptional
divisor of the blowup of `Spec(A)` in the maximal ideal.

This is `AlgebraicGeometry.RationalSingularitySituation.exceptionalIdealPowGeneratingSections` at
Situation 0B4W realized at the blowup, whose special fibre is the exceptional divisor by
`AlgebraicGeometry.rationalSingularitySituationBlowUp_exceptionalIdeal`. -/
def generatingSectionsExceptionalIdealPow (n : ℕ) :
    (Stacks.Divisors.idealSheafOfModules
      (exceptionalIdeal (centre S.A) ^ n)).GeneratingSections :=
  SheafOfModules.GeneratingSections.equivOfIso
    (eqToIso (congrArg (fun I => Stacks.Divisors.idealSheafOfModules (I ^ n))
      (rationalSingularitySituationBlowUp_exceptionalIdeal S)))
    ((rationalSingularitySituationBlowUp S).exceptionalIdealPowGeneratingSections
      (rationalSingularitySituationBlowUp S).exceptionalIdealGeneratingSections n)

/-- **`𝒪_E(n)` is generated by its global sections** for every `n ≥ 0`.

It is `i^*𝓘ⁿ` by part (3) of [Stacks, Tag 02OS]
(`AlgebraicGeometry.BlowUpDualizing.pullbackExceptionalIdealPowIso`), and `𝓘ⁿ` is generated by
its global sections; `i^*` preserves colimits, being a left adjoint, and takes `𝒪_X` to `𝒪_E`,
so it carries generating sections to generating sections.

The functor and the preservation of colimits are passed to
`SheafOfModules.GeneratingSections.map` explicitly: `AlgebraicGeometry.Scheme.Modules` is a
plain definition, so the instance available at the spelling `X.Modules` is not found at the
spelling `SheafOfModules X.ringCatSheaf` that the Mathlib lemma is stated at. -/
def generatingSectionsCurveTwistSheaf (n : ℕ) :
    (curveTwistSheaf S.A (n : ℤ)).GeneratingSections := by
  let F : SheafOfModules.{u} (blowUpScheme S.A).ringCatSheaf ⥤
      SheafOfModules.{u} (exceptionalCurve S.A).ringCatSheaf :=
    Scheme.Modules.pullback (exceptionalImmersion S.A)
  have hF : PreservesColimitsOfSize.{u, u, u, u, u + 1, u + 1} F :=
    inferInstanceAs (PreservesColimitsOfSize.{u, u, u, u, u + 1, u + 1}
      (Scheme.Modules.pullback (exceptionalImmersion S.A)))
  exact SheafOfModules.GeneratingSections.equivOfIso (pullbackExceptionalIdealPowIso S.A n)
    (@SheafOfModules.GeneratingSections.map _ _ _ _ _ _ _ _ _ _ _ _ _
      (generatingSectionsExceptionalIdealPow S n) F hF
      (Scheme.Modules.pullbackUnitIso (exceptionalImmersion S.A)).symm)

/-! ### Nontriviality of the twists -/

/-- **`dim_κ H⁰(E, 𝒪_E(n)) ≥ 2` for `n ≥ 1`.** Clause (5) of [Stacks, Tag 0B63] identifies
`H⁰(E, 𝒪_E(n))` with the graded piece `𝔪ⁿ/𝔪ⁿ⁺¹`, and in a Noetherian local ring of dimension
two every such piece with `n ≥ 1` has dimension at least two by Krull's height theorem
(`Stacks.KrullDimension.two_le_finrank_maximalIdealPow_quotient`).

The `κ`-structure on the graded piece, which
`AlgebraicGeometry.BlowUpDualizing.finrank_cohomologyOverField_curveTwistSheaf_zero` asks for
because it is not canonical, is the one the piece carries as a module over `A/𝔪`: it is killed
by `𝔪`. -/
theorem two_le_finrank_cohomologyOverField_curveTwistSheaf_zero (n : ℕ) (hn : n ≠ 0) :
    2 ≤ Module.finrank (ResidueField S.A) (cohomologyOverField (ResidueField S.A)
      (exceptionalDivisorToCentre (Stacks.Blowup.residuePoint S.A))
      (curveTwistSheaf S.A (n : ℤ)) 0) := by
  let : Module (ResidueField S.A)
      ((maximalIdeal S.A ^ n : Ideal S.A) ⧸
        (maximalIdeal S.A • ⊤ : Submodule S.A (maximalIdeal S.A ^ n : Ideal S.A))) :=
    inferInstanceAs (Module (S.A ⧸ maximalIdeal S.A) _)
  have : IsScalarTower S.A (ResidueField S.A)
      ((maximalIdeal S.A ^ n : Ideal S.A) ⧸
        (maximalIdeal S.A • ⊤ : Submodule S.A (maximalIdeal S.A ^ n : Ideal S.A))) :=
    inferInstanceAs (IsScalarTower S.A (S.A ⧸ maximalIdeal S.A) _)
  rw [finrank_cohomologyOverField_curveTwistSheaf_zero S n _ (LinearEquiv.refl _ _)]
  exact Stacks.KrullDimension.two_le_finrank_maximalIdealPow_quotient S.dimension_two hn

/-- **`𝒪_E(n)` is not isomorphic to `𝒪_E`** for `n ≥ 1`. Its space of global sections has
dimension at least two over `κ`, while `H⁰(E, 𝒪_E) = κ` is a line. -/
theorem not_isTrivial_curveTwistSheaf (n : ℕ) (hn : n ≠ 0) :
    ¬ SheafOfModules.IsTrivial
      (cohenMacaulayCurveSituationExceptionalDivisor S).X.presheaf
      (cohenMacaulayCurveSituationExceptionalDivisor S).X.ringCatSheaf.property
      (curveTwistSheaf S.A (n : ℤ)) := by
  rintro ⟨e⟩
  have e' : curveTwistSheaf S.A (n : ℤ) ≅
      SheafOfModules.unit (exceptionalCurve S.A).ringCatSheaf := e
  have h1 := finrank_cohomologyOverField_eq_of_iso (ResidueField S.A)
    (exceptionalDivisorToCentre (Stacks.Blowup.residuePoint S.A)) e' 0
  rw [finrank_cohomologyOverField_unit_zero S] at h1
  have h2 := two_le_finrank_cohomologyOverField_curveTwistSheaf_zero S n hn
  omega

/-! ### Tag 0B62 at the exceptional curve -/

/-- **`H¹(E, ω_E(n+1)) = 0` for every `n ≥ 0`**, for a module `ω_E` on the exceptional curve for
which duality holds in the form
`AlgebraicGeometry.CohenMacaulayCurveSituation.DualityVanishing`.

This is [Stacks, Tag 0B62] in the form that grants duality —
`…CohenMacaulayCurveSituation.isZero_firstCohomology_tensor_of_dualityVanishing` — applied in
Situation [Stacks, Tag 0B5D] at the exceptional curve
(`AlgebraicGeometry.cohenMacaulayCurveSituationExceptionalDivisor`) to the invertible module
`𝒪_E(n+1)`. Its two hypotheses on that module are
`AlgebraicGeometry.BlowUpDualizing.generatingSectionsCurveTwistSheaf` and
`AlgebraicGeometry.BlowUpDualizing.not_isTrivial_curveTwistSheaf`, both proved above.

The conclusion of the tag is stated for `AlgebraicGeometry.cohomologyOverField`, which is the
cohomology of this file's `Stacks.Cohomology.FormalFunctions.cohomologyDeltaFunctor`
with scalars restricted along the structure morphism; the two have the same underlying group, so
one vanishes exactly when the other does. -/
theorem isZero_firstCohomology_curveTwist_of_dualityVanishing
    (ωE : (exceptionalCurve S.A).Modules)
    (hdual : (cohenMacaulayCurveSituationExceptionalDivisor S).DualityVanishing ωE) (n : ℕ) :
    IsZero (((cohomologyDeltaFunctor (exceptionalCurve S.A)).functor 1).obj
      (curveTwist S.A ωE ((n : ℤ) + 1))) := by
  have h := CohenMacaulayCurveSituation.isZero_firstCohomology_tensor_of_dualityVanishing
    (cohenMacaulayCurveSituationExceptionalDivisor S) ωE hdual
    (curveTwistSheaf S.A ((n + 1 : ℕ) : ℤ)) (generatingSectionsCurveTwistSheaf S (n + 1))
    (not_isTrivial_curveTwistSheaf S (n + 1) (by omega))
  rw [ModuleCat.isZero_iff_subsingleton] at h ⊢
  assumption

/-- **`H¹(X, ω_X(n)) = 0` for every `n ≥ 0`**, with the [Stacks, Tag 0B62] vanishing on the
exceptional curve replaced by duality for `ω_E`.

This is
`AlgebraicGeometry.BlowUpDualizing.isZero_firstCohomology_dualizingTwist_of_curveVanishing` with
its `hcurveE` supplied by
`AlgebraicGeometry.BlowUpDualizing.isZero_firstCohomology_curveTwist_of_dualityVanishing`, so the
two inputs left are clause (1) of [Stacks, Tag 0B64], as the isomorphism `e`, and duality for
`ω_E` in the form [Stacks, Tag 0B62] consumes it.

No `@[stacks 0B64]` attribute is attached here, and the reason is not that `DualityVanishing`
stands in for an absent duality — it does not. The predicate has two producers: unconditionally
at `Stacks.Duality.dualizingSheafOverField` of a Situation [Stacks, Tag 0B5D] curve
(`…CohenMacaulayCurveSituation.dualityVanishing_dualizingSheafOverField`), and along an
isomorphism with that sheaf
(`…BlowUpDualizing.dualityVanishing_of_iso_dualizingSheafOverField`); and clause (4) of
[Stacks, Tag 0BS2], the duality they rest on, is proved as
`Stacks.Duality.extDualityLinearEquiv`.

The reason is that neither producer reaches *this* `ω_E`. It is constrained only by
`Stacks.Duality.IsDualizingModule` and by the clause-(1) isomorphism `e`, and that pair does not
pin it to the canonical dualizing sheaf of `E` over `κ`: the counterexample in this file's module
documentation satisfies both with `ω_E = 𝒪_{ℙ¹}(-6)`, for which `H¹(E, ω_E(1))` has dimension
four, so `DualityVanishing ω_E` fails there. The hypothesis `hdual` is therefore a normalization
of `ω_E` strictly stronger than clause (2) grants, and the missing declaration is the isomorphism
`ω_E ≅ Stacks.Duality.dualizingSheafOverField ((cohenMacaulayCurveSituationExceptionalDivisor
S).f)`, which would discharge `hdual` through the second producer.

The attribute site of clause (2) is
`…isZero_firstCohomology_dualizingTwist_of_isDualizingRingModule` of
`…/Duality/ExceptionalDualizingSheafIdentification.lean`, which reaches the clause instead
through the normalization of [Stacks, Remark 0B4R] and assumes nothing.
`…isZero_firstCohomology_dualizingTwist_of_normalized` of
`…/RationalSingularities/BlowUpDualizingSequence.lean` carries no attribute either. -/
theorem isZero_firstCohomology_dualizingTwist_of_dualityVanishing
    (ωX : (blowUpScheme S.A).Modules) (ωE : (exceptionalCurve S.A).Modules)
    (hωX : letI : IsLocallyNoetherian (blowUpScheme S.A) := isLocallyNoetherian_blowUpScheme S.A
      Stacks.Duality.IsDualizingModule ωX)
    (hωE : letI : IsLocallyNoetherian (exceptionalCurve S.A) :=
        isLocallyNoetherian_exceptionalCurve S.A
      Stacks.Duality.IsDualizingModule ωE)
    (e : ωE ≅ curveTwist S.A
      ((Scheme.Modules.pullback (exceptionalImmersion S.A)).obj ωX) (-1))
    (hdual : (cohenMacaulayCurveSituationExceptionalDivisor S).DualityVanishing ωE) (n : ℕ) :
    IsZero (((cohomologyDeltaFunctor (blowUpScheme S.A)).functor 1).obj
      (schemeTwist S.A ωX n)) :=
  isZero_firstCohomology_dualizingTwist_of_curveVanishing S.A ωX ωE hωX hωE e
    (isZero_firstCohomology_curveTwist_of_dualityVanishing S ωE hdual) n

end AlgebraicGeometry.BlowUpDualizing

end
