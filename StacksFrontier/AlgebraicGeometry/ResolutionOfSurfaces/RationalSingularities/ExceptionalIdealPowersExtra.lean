module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalSingularities.ExceptionalIdealPowers
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalSingularities.QuasicoherentCohomologyExtra
public import StacksFrontier.AlgebraicGeometry.Divisors.IdealSheafBaseChangeGenerators
import StacksCore.Tactic.StacksAttribute

/-!
# Powers of the exceptional ideal

In Situation [Stacks, Tag 0B4W], let `𝓘 = 𝔪𝒪_X` be the ideal sheaf of the special fibre. This
file proves that `𝓘` is generated by global sections and that `H¹(X, 𝓘ⁿ) = 0` and
`H⁰(X, 𝓘ⁿ) = 𝔪ⁿ` for every `n`, the latter when the special fibre is an effective Cartier
divisor.

## Main definitions

* `RationalSingularitySituation.exceptionalIdealGeneratingSections`: global sections
  generating `𝓘 = 𝔪𝒪_X`.

## Main results

* `RationalSingularitySituation.exceptionalIdeal_eq_comap`: the ideal sheaf of the special
  fibre is the inverse image along `f` of the ideal sheaf of the closed point.
* `RationalSingularitySituation.isZero_firstCohomology_exceptionalIdealPow_unconditional`:
  `H¹(X, 𝓘ⁿ) = 0` for every `n`.
* `RationalSingularitySituation.idealSheafGlobalSections_exceptionalIdealPow_unconditional`:
  `H⁰(X, 𝓘ⁿ) = 𝔪ⁿ` for every `n`, when the special fibre is an effective Cartier divisor.

## References

* [Stacks Project, Tag 0B4Y](https://stacks.math.columbia.edu/tag/0B4Y)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits RingedSpaceModuleAdjunction

universe u

namespace AlgebraicGeometry

noncomputable section

namespace RationalSingularitySituation

open Stacks.Cohomology.AffineBase

attribute [local instance 10000] HasDerivedCategory.standard

variable (S : RationalSingularitySituation.{u})

/-! ### The global generation of `𝓘` -/

/-- **The ideal sheaf of the special fibre is the inverse image of the ideal sheaf of the closed
point** along `f`. -/
theorem exceptionalIdeal_eq_comap :
    S.exceptionalIdeal =
      ((S.base.fromSpecResidueField S.closedPoint).ker).comap S.f := by
  have : IsClosedImmersion (S.base.fromSpecResidueField S.closedPoint) :=
    (isClosed_singleton_iff_isClosedImmersion (X := S.base) (x := S.closedPoint)).1
      (IsLocalRing.isClosed_singleton_closedPoint S.A)
  exact Scheme.IdealSheafData.ker_fst_of_isClosedImmersion
    (S.base.fromSpecResidueField S.closedPoint) S.f

/-- **`𝓘 = 𝔪𝒪_X` is generated by global sections**: global sections of the ideal sheaf of the
special fibre generating it, the images of generators of `𝔪`. -/
def exceptionalIdealGeneratingSections :
    (Stacks.Divisors.idealSheafOfModules S.exceptionalIdeal).GeneratingSections :=
  SheafOfModules.GeneratingSections.equivOfIso
    (eqToIso (congrArg Stacks.Divisors.idealSheafOfModules S.exceptionalIdeal_eq_comap.symm))
    (Stacks.Divisors.comapIdealGeneratingSections S.f
      (S.base.fromSpecResidueField S.closedPoint).ker
      (isQuasicoherent_idealSheafOfModules _))

/-! ### Cohomology of the powers of `𝓘` -/

/-- In Situation [Stacks, Tag 0B4W], `H¹(X, 𝓘ⁿ) = 0` for every `n`, where `𝓘` is the ideal
sheaf of the special fibre `E = X_s`. -/
@[stacks 0B4Y "the conclusion H¹(X, 𝓘ⁿ) = 0 for all n"]
theorem isZero_firstCohomology_exceptionalIdealPow_unconditional (n : ℕ) :
    IsZero (((moduleGlobalSections S.X).rightDerivedPlus 1).obj
      (S.exceptionalIdealPow n)) := by
  have : (S.exceptionalIdealPow n).IsQuasicoherent :=
    isQuasicoherent_idealSheafOfModules (S.exceptionalIdeal ^ n)
  exact S.isZero_cohomology_one_of_globallyGenerated_unconditional (S.exceptionalIdealPow n)
    (S.exceptionalIdealPowGeneratingSections S.exceptionalIdealGeneratingSections n)

/-- When the special fibre is an effective Cartier divisor and `g` is a family of global sections
generating `𝓘`, `H¹(X, ker(⨁ 𝒪_X ⟶ 𝓘) ⊗ 𝓘ⁿ⁺¹) = 0`. -/
private theorem isZero_firstCohomology_kernelTensorExceptionalIdealPow_unconditional
    (hE : Stacks.Divisors.IsEffectiveCartierDivisor S.exceptionalIdeal)
    (g : (Stacks.Divisors.idealSheafOfModules S.exceptionalIdeal).GeneratingSections) (n : ℕ) :
    IsZero (((moduleGlobalSections S.X).rightDerived 1).obj
      ((((Stacks.SheafOfModules.Tensor.sheafTensor
        ⟨((S.X.toRingedSpace)).presheaf, ((S.X.toRingedSpace)).IsSheaf⟩).obj ((kernel g.π))).obj
          ((Stacks.Divisors.idealSheafOfModules (S.exceptionalIdeal ^ (n + 1))))))) := by
  have hq := isQuasicoherent_kernelTensorIdeal S.exceptionalIdeal (S.exceptionalIdeal ^ (n + 1)) g
  exact (Stacks.DerivedIndexing.isZero_rightDerivedPlus_obj_iff (moduleGlobalSections S.X)
      (m := (1 : ℤ)) (n := 1) rfl _).1
    (@isZero_cohomology_one_of_globallyGenerated_unconditional S _ hq
      (kernelTensorIdealPowGeneratingSections S.exceptionalIdeal hE g n))

/-- In Situation [Stacks, Tag 0B4W] with the special fibre `E = X_s` an effective Cartier
divisor, `H⁰(X, 𝓘ⁿ) = 𝔪ⁿ` for every `n`: the global sections of `𝓘ⁿ` are exactly the image of
`𝔪ⁿ` under the isomorphism `A ≅ Γ(X, 𝒪_X)`. -/
@[stacks 0B4Y "the conclusion H⁰(X, 𝓘ⁿ) = 𝔪ⁿ for all n, under the source's own further \
requirement that the special fibre be an effective Cartier divisor (hE)"]
theorem idealSheafGlobalSections_exceptionalIdealPow_unconditional
    (hE : Stacks.Divisors.IsEffectiveCartierDivisor S.exceptionalIdeal) (n : ℕ) :
    idealSheafGlobalSections (S.exceptionalIdeal ^ n) =
      (S.maximalIdeal ^ n).map ((Scheme.ΓSpecIso (.of S.A)).inv ≫ S.f.appTop).hom := by
  have : IsProper S.f := S.isProper
  have : CompactSpace S.X := QuasiCompact.compactSpace_of_compactSpace S.f
  have hone := S.idealSheafGlobalSections_exceptionalIdeal
  induction n with
  | zero =>
      rw [idealSheafGlobalSections_pow_zero, pow_zero, Ideal.one_eq_top, Ideal.map_top]
  | succ n ih =>
      cases n with
      | zero => rw [pow_one, pow_one]; exact hone
      | succ n =>
          rw [pow_succ' S.exceptionalIdeal (n + 1),
            idealSheafGlobalSections_mul S.exceptionalIdeal (S.exceptionalIdeal ^ (n + 1))
              (Stacks.Divisors.isEffectiveCartierDivisor_pow hE (n + 1))
              S.exceptionalIdealGeneratingSections
              (S.isZero_firstCohomology_kernelTensorExceptionalIdealPow_unconditional hE
                S.exceptionalIdealGeneratingSections n),
            hone, ih, ← Ideal.map_mul, ← pow_succ' S.maximalIdeal (n + 1)]

end RationalSingularitySituation

end

end AlgebraicGeometry

end
