-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry.CohenMacaulayCurveSituation
  (nonempty_generatingSections_dualizing_tensorSheaf_of_isoAlgebraicClosure_of_isFiniteType)

universe u

namespace AlgebraicGeometry.BlowUpDualizing

-- `𝒪_E(n)` is invertible in the spelling Situation 0B5D at the exceptional curve uses. The
-- declaration is the one of `…/RationalSingularities/ExceptionalDualizingGeneration.lean`, made a
-- local instance here too, because instance resolution does not unfold
-- `AlgebraicGeometry.cohenMacaulayCurveSituationExceptionalDivisor`.
attribute [local instance] isInvertible_curveTwistSheaf_situation

variable (S : RationalSingularitySituation.{u})

/-- **`ω_X|_E` is generated by its global sections**, the one input of clause (3) of
[Stacks, Tag 0B64], granted two isomorphisms and nothing about the residue field: `ecan`, that
`ω_E = H¹(a(ω_X))` is the dualizing sheaf of `E` over `κ`, and `e0E32`, [Stacks, Tag 0E32] at
`E`. Both are true statements of the source; the module documentation says which tags each needs
and which of them this repository has.

This is [Stacks, Tag 0B5H] at the canonical dualizing sheaf, where duality, `dim_κ H¹(E, ω_E) =
1`, the absence of a submodule supported in dimension zero and the vanishing section of
[Stacks, Tag 0B58] are all proved rather than carried — in contrast to
`…nonempty_generatingSections_restriction_of_dualityInputs`, whose `hsec` is unsatisfiable over a
`κ` that is not algebraically closed. -/
public theorem nonempty_generatingSections_restriction_of_isoDualizingSheaf
    (hnot : ¬ IsRegularLocalRing S.A)
    (ωX : (blowUpScheme S.A).Modules) (hωX : ωX.IsCoherent)
    (ecan : exceptionalDualizingModule S.A ωX ≅
      Stacks.Duality.dualizingSheafOverField
        (X := (cohenMacaulayCurveSituationExceptionalDivisor S).X)
        (cohenMacaulayCurveSituationExceptionalDivisor S).f)
    (e0E32 : (Scheme.Modules.pullback
          (cohenMacaulayCurveSituationExceptionalDivisor S).algebraicClosureProj).obj
          (Stacks.Duality.dualizingSheafOverField
            (X := (cohenMacaulayCurveSituationExceptionalDivisor S).X)
            (cohenMacaulayCurveSituationExceptionalDivisor S).f) ≅
        Stacks.Duality.dualizingSheafOverField
          (X := (cohenMacaulayCurveSituationExceptionalDivisor S).algebraicClosure.X)
          (cohenMacaulayCurveSituationExceptionalDivisor S).algebraicClosure.f) :
    Nonempty ((Scheme.Modules.pullback (exceptionalImmersion S.A)).obj ωX).GeneratingSections := by
  let : IsLocallyNoetherian (exceptionalCurve S.A) := isLocallyNoetherian_exceptionalCurve S.A
  let := hωX
  obtain ⟨e⟩ := nonempty_exceptionalDualizingModule_iso_curveTwist S.A ωX
  obtain ⟨g⟩ := nonempty_pullback_dualizing_iso_curveTwist e
  let F := ((Stacks.SheafOfModules.Tensor.sheafTensor
          ⟨(cohenMacaulayCurveSituationExceptionalDivisor S).X.presheaf,
            CategoryTheory.Presheaf.isSheaf_of_isSheaf_comp _
              (cohenMacaulayCurveSituationExceptionalDivisor S).X.presheaf
              (CategoryTheory.forget₂ CommRingCat RingCat)
              (cohenMacaulayCurveSituationExceptionalDivisor S).X.ringCatSheaf.property⟩).obj
          (Stacks.Duality.dualizingSheafOverField
            (X := (cohenMacaulayCurveSituationExceptionalDivisor S).X)
            (cohenMacaulayCurveSituationExceptionalDivisor S).f)).obj
        (curveTwistSheaf S.A 1)
  have hgc : (Scheme.Modules.pullback (exceptionalImmersion S.A)).obj ωX ≅ F :=
    g ≪≫ Stacks.RelativeVeryAmple.tensorModulesMapIso (exceptionalCurve S.A) ecan (Iso.refl _)
  have hPft : ((Scheme.Modules.pullback (exceptionalImmersion S.A)).obj ωX).IsFiniteType :=
    (isCoherent_pullback (exceptionalImmersion S.A) ωX).isFiniteType
  have hcanq : (Stacks.Duality.dualizingSheafOverField
      (X := (cohenMacaulayCurveSituationExceptionalDivisor S).X)
      (cohenMacaulayCurveSituationExceptionalDivisor S).f).IsQuasicoherent :=
    Stacks.AlgebraicGeometry.PerfectCohomology.isQuasicoherent_of_iso ecan
      (Stacks.AlgebraicGeometry.PerfectCohomology.isQuasicoherent_of_iso e.symm
        (isQuasicoherent_curveTwist_pullback S.A ωX hωX (-1)))
  have hFq : F.IsQuasicoherent :=
    @AlgebraicGeometry.tensorSheaf_isQuasicoherent (exceptionalCurve S.A).toRingedSpace _ _ hcanq
      (Stacks.AmpleGlobalGeneration.isQuasicoherent_tensorPowModule (curveTwistNegOne S.A) (-1))
  have hFft : F.IsFiniteType :=
    Stacks.Coherent.isFiniteType_of_iso_local hgc hPft
  obtain ⟨G⟩ :=
    @nonempty_generatingSections_dualizing_tensorSheaf_of_isoAlgebraicClosure_of_isFiniteType
    (cohenMacaulayCurveSituationExceptionalDivisor S) (curveTwistSheaf S.A 1) _
    (isRelativelyVeryAmple_curveTwistSheaf_one S.A)
    (two_le_invertibleCurveDegree_curveTwistSheaf_one S hnot) hFq hFft e0E32
  exact ⟨SheafOfModules.GeneratingSections.equivOfIso hgc.symm G⟩

/-- **Clause (3) of [Stacks, Tag 0B64], granted the two isomorphisms.** In Situation
[Stacks, Tag 0B4W] with `A` not regular, for `ω_A` a dualizing module for `A` and `ω_X` the
dualizing module of the blowup normalized relative to `ω_A`, the canonical map `f^*ω_A ⟶ ω_X` of
[Stacks, Tag 0BBU] is an epimorphism — granted `ecan` and `e0E32`.

This is `AlgebraicGeometry.BlowUpDualizing.epi_dualizingPullbackMap_of_normalized` of
`…/RationalSingularities/BlowUpDualizingGeneration.lean`, whose single input `G` is supplied by
`nonempty_generatingSections_restriction_of_isoDualizingSheaf` above. By
`AlgebraicGeometry.BlowUpDualizing.nonempty_generatingSections_restriction_iff_epi` of
`…/RationalSingularities/BlowUpDualizingGenerationEquivalence.lean` the conclusion is equivalent
to that `G`, so this is the whole of what the two isomorphisms buy, and conversely the clause
cannot be reached by any statement weaker than `G`.

No `@[stacks 0B64]` attribute is attached: that clause is registered on
`epi_dualizingPullbackMap_of_normalized`, and two hypotheses are carried here. -/
public theorem epi_dualizingPullbackMap_of_isoDualizingSheaf
    (hnot : ¬ IsRegularLocalRing S.A) (ωA : ModuleCat.{u} S.A)
    (hωA : Stacks.Duality.IsDualizingRingModule S.A ωA)
    (ωX : (blowUpScheme S.A).Modules)
    (N : letI : IsLocallyNoetherian (rationalSingularitySituationBlowUp S).X :=
        isLocallyNoetherian_blowUpScheme S.A
      (rationalSingularitySituationBlowUp S).NormalizedDualizingModule ωA ωX)
    (ecan : exceptionalDualizingModule S.A ωX ≅
      Stacks.Duality.dualizingSheafOverField
        (X := (cohenMacaulayCurveSituationExceptionalDivisor S).X)
        (cohenMacaulayCurveSituationExceptionalDivisor S).f)
    (e0E32 : (Scheme.Modules.pullback
          (cohenMacaulayCurveSituationExceptionalDivisor S).algebraicClosureProj).obj
          (Stacks.Duality.dualizingSheafOverField
            (X := (cohenMacaulayCurveSituationExceptionalDivisor S).X)
            (cohenMacaulayCurveSituationExceptionalDivisor S).f) ≅
        Stacks.Duality.dualizingSheafOverField
          (X := (cohenMacaulayCurveSituationExceptionalDivisor S).algebraicClosure.X)
          (cohenMacaulayCurveSituationExceptionalDivisor S).algebraicClosure.f) :
    letI : IsLocallyNoetherian (rationalSingularitySituationBlowUp S).X :=
      isLocallyNoetherian_blowUpScheme S.A
    Epi ((rationalSingularitySituationBlowUp S).dualizingPullbackMap ωA hωA ωX N.isDualizing
      ((rationalSingularitySituationBlowUp S).dualizingTraceSequenceOfNormalized N)) := by
  let : IsLocallyNoetherian (rationalSingularitySituationBlowUp S).X :=
    isLocallyNoetherian_blowUpScheme S.A
  obtain ⟨G⟩ := nonempty_generatingSections_restriction_of_isoDualizingSheaf S hnot ωX
    N.isDualizing.1 ecan e0E32
  exact epi_dualizingPullbackMap_of_normalized S hnot ωA hωA ωX N G


end AlgebraicGeometry.BlowUpDualizing

end
