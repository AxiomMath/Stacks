open AlgebraicGeometry CategoryTheory CategoryTheory.Limits RingedSpaceModuleAdjunction

universe u

namespace AlgebraicGeometry

noncomputable section

variable {X : Scheme.{u}}

/-- The structure sheaf of a scheme is generated by its unit global section. -/
def unitGeneratingSections (X : Scheme.{u}) :
    (SheafOfModules.unit
      (structureSheafRing X.toRingedSpace)).GeneratingSections where
  I := PUnit.{u + 1}
  s _ := (SheafOfModules.unit
    (structureSheafRing X.toRingedSpace)).unitHomEquiv (𝟙 _)
  epi := by
    set O := SheafOfModules.unit (structureSheafRing X.toRingedSpace) with hO
    let f := O.freeHomEquiv.symm (fun _ : PUnit.{u + 1} => O.unitHomEquiv (𝟙 O))
    have h : SheafOfModules.ιFree PUnit.unit ≫ f = 𝟙 O := by
      apply O.unitHomEquiv.injective
      rw [← SheafOfModules.unitHomEquiv_symm_freeHomEquiv_apply f PUnit.unit]
      simp [f]
    have : IsSplitEpi f := IsSplitEpi.mk' ⟨SheafOfModules.ιFree PUnit.unit, h⟩
    infer_instance

/-- The zeroth power of a sheaf of ideals is the whole structure sheaf. -/
def idealSheafOfModulesPowZeroIso (I : X.IdealSheafData) :
    Stacks.Divisors.idealSheafOfModules (I ^ 0) ≅
      SheafOfModules.unit (structureSheafRing X.toRingedSpace) := by
  haveI : Epi (Stacks.Divisors.idealInclusion (I ^ 0)) := by
    apply Stacks.Divisors.epi_of_surjective_affine
    intro U a
    obtain ⟨y, hy⟩ := (Stacks.Divisors.mem_ideal_iff_exists_idealSheafSection (I ^ 0) U a).1
      (by rw [pow_zero, Scheme.IdealSheafData.one_eq_top, Scheme.IdealSheafData.ideal_top]
          exact Submodule.mem_top)
    exact ⟨y, hy⟩
  haveI : Mono (Stacks.Divisors.idealInclusion (I ^ 0)) :=
    Stacks.Divisors.mono_idealInclusion (I ^ 0)
  haveI : IsIso (Stacks.Divisors.idealInclusion (I ^ 0)) := isIso_of_mono_of_epi _
  exact asIso (Stacks.Divisors.idealInclusion (I ^ 0))

/-- Generating global sections of every power of a sheaf of ideals, from generating global
sections of the ideal itself: the products of the given generators do the job, because the
tensor product of two ideal sheaves maps onto the ideal sheaf of the product. -/
def idealSheafOfModulesPowGeneratingSections (I : X.IdealSheafData)
    (σ : (Stacks.Divisors.idealSheafOfModules I).GeneratingSections) :
    ∀ n : ℕ, (Stacks.Divisors.idealSheafOfModules (I ^ n)).GeneratingSections
  | 0 => SheafOfModules.GeneratingSections.equivOfIso
      (idealSheafOfModulesPowZeroIso I).symm (unitGeneratingSections X)
  | n + 1 => by
      -- naming the tensor product by the project's own abbreviation pins the sheaf of rings,
      -- and the surjectivity of the multiplication is handed to `ofEpi` directly: the two
      -- spellings of the sheaf of rings give `Epi` two instance keys, so a search for it
      -- from here does not find `epi_idealTensorMul`.
      have hσ : (Stacks.Divisors.idealTensorProd (I ^ n) I).GeneratingSections :=
        Stacks.SheafOfModules.tensorSheafGeneratingSections X.toRingedSpace _ _
          (idealSheafOfModulesPowGeneratingSections I σ n) σ
      have g : (Stacks.Divisors.idealSheafOfModules (I ^ n * I)).GeneratingSections :=
        @SheafOfModules.GeneratingSections.ofEpi _ _ _ _ _ _ _ _ hσ
          (Stacks.Divisors.idealTensorMul (I ^ n) I)
          (Stacks.Divisors.epi_idealTensorMul (I ^ n) I)
      exact SheafOfModules.GeneratingSections.equivOfIso
        (eqToIso (congrArg Stacks.Divisors.idealSheafOfModules (pow_succ I n).symm)) g

/-- A sheaf of ideals on a scheme is a quasi-coherent sheaf of modules. -/
theorem isQuasicoherent_idealSheafOfModules (I : X.IdealSheafData) :
    (Stacks.Divisors.idealSheafOfModules I).IsQuasicoherent := by
  have : Stacks.ClosedImmersion.IsClosedImmersion I.subschemeι.toLRSHom.toShHom :=
    ((Stacks.AlgebraicGeometry.ClosedImmersionTFAE.closedImmersion_tfae I.subschemeι).out 1 6).mp
      (inferInstance : IsClosedImmersion I.subschemeι)
  exact Stacks.ClosedImmersion.isQuasicoherent_idealSheaf _ _ I.subschemeι.toLRSHom


/-! ### Global sections of the ideal sheaf of a closed subscheme -/

/-- The global sections of the ideal sheaf of a closed subscheme, read as an ideal of the ring of
global functions: a global function lies in it exactly when it restricts to zero on the closed
subscheme. -/
abbrev idealSheafGlobalSections (I : X.IdealSheafData) : Ideal Γ(X, ⊤) :=
  RingHom.ker I.subschemeι.appTop.hom

/-- A global function restricts to zero on a closed subscheme exactly when it is a global section
of the ideal sheaf. -/
theorem mem_idealSheafGlobalSections_iff (I : X.IdealSheafData) (a : Γ(X, ⊤)) :
    a ∈ idealSheafGlobalSections I ↔
      ∃ y : (Stacks.Divisors.idealSheafOfModules I).val.obj (Opposite.op (⊤ : X.Opens)),
        Stacks.Divisors.idealSheafSection I y = a :=
  Stacks.Divisors.subschemeι_app_eq_zero_iff_exists_idealSheafSection I a

/-- The product of two global sections of ideal sheaves is a global section of the ideal sheaf of
the product closed subscheme, by the multiplication `ℐ_I ⊗ ℐ_J ⟶ ℐ_{I·J}`. -/
theorem idealSheafGlobalSections_mul_le (I J : X.IdealSheafData) :
    idealSheafGlobalSections I * idealSheafGlobalSections J ≤
      idealSheafGlobalSections (I * J) := by
  refine Ideal.mul_le.2 fun a ha b hb => ?_
  obtain ⟨y, rfl⟩ := (mem_idealSheafGlobalSections_iff I a).1 ha
  obtain ⟨m, rfl⟩ := (mem_idealSheafGlobalSections_iff J b).1 hb
  refine (mem_idealSheafGlobalSections_iff (I * J) _).2
    ⟨((Stacks.Divisors.idealTensorMul I J).val.app (Opposite.op (⊤ : X.Opens))).hom
      (Stacks.SheafOfModules.TensorStalkRingedSpace.toTensorSheafSection X.toRingedSpace
        (Stacks.Divisors.idealSheafOfModules I) (Stacks.Divisors.idealSheafOfModules J)
        (Opposite.op (⊤ : X.Opens)) (y ⊗ₜ[Γ(X, ⊤)] m)), ?_⟩
  exact (Stacks.Divisors.idealSheafSection_idealTensorMul I J ⊤ _).trans
    (Stacks.Divisors.idealTensorToUnit_app_tmul I J ⊤ y m)

/-- The ideal sheaf of the zeroth power of a sheaf of ideals includes isomorphically onto the
structure sheaf: the zeroth power is the unit ideal. -/
private theorem isIso_idealInclusion_pow_zero (I : X.IdealSheafData) :
    IsIso (Stacks.Divisors.idealInclusion (I ^ 0)) :=
  (idealSheafOfModulesPowZeroIso I).isIso_hom

/-- The zeroth power of a sheaf of ideals cuts out nothing: every global function is a global
section of its ideal sheaf. -/
theorem idealSheafGlobalSections_pow_zero (I : X.IdealSheafData) :
    idealSheafGlobalSections (I ^ 0) = ⊤ := by
  have := isIso_idealInclusion_pow_zero I
  refine top_unique fun a _ => (mem_idealSheafGlobalSections_iff _ a).2
    ⟨(inv (Stacks.Divisors.idealInclusion (I ^ 0))).val.app (Opposite.op (⊤ : X.Opens)) a, ?_⟩
  exact congrArg
    (fun q : SheafOfModules.unit (structureSheafRing X.toRingedSpace) ⟶
      SheafOfModules.unit (structureSheafRing X.toRingedSpace) =>
      q.val.app (Opposite.op (⊤ : X.Opens)) a)
    (IsIso.inv_hom_id (Stacks.Divisors.idealInclusion (I ^ 0)))

/-- The global sections of the ideal sheaf of the scheme-theoretic image of a closed immersion are
exactly the global functions it annihilates: the factorization through the image is an
isomorphism. -/
theorem idealSheafGlobalSections_ker {Y : Scheme.{u}} (f : X ⟶ Y) [IsClosedImmersion f] :
    idealSheafGlobalSections f.ker = RingHom.ker f.appTop.hom := by
  have : IsIso f.toImage := inferInstance
  have : IsIso f.toImage.appTop := by
    show IsIso (f.toImage.c.app (Opposite.op ⊤))
    infer_instance
  have hinj : Function.Injective f.toImage.appTop :=
    (ConcreteCategory.bijective_of_isIso f.toImage.appTop).1
  have hc : f.appTop = f.ker.subschemeι.appTop ≫ f.toImage.appTop :=
    (congrArg Scheme.Hom.appTop f.toImage_imageι).symm
  ext a
  rw [RingHom.mem_ker, RingHom.mem_ker, hc]
  exact (map_eq_zero_iff _ hinj).symm

/-! ### The long-exact-sequence step -/

section GlobalSectionsMul

open Stacks.Divisors Stacks.SheafOfModules.TensorStalkRingedSpace
open Stacks.Cohomology.AffineBase (moduleGlobalSections)

/-- An isomorphism of sheaves of modules is injective on sections over any object. -/
private theorem injective_app_of_iso {C : Type*} [Category C] {K : GrothendieckTopology C}
    {R : Sheaf K RingCat.{u}} [HasWeakSheafify K AddCommGrpCat.{u}]
    [K.WEqualsLocallyBijective AddCommGrpCat.{u}] {M N : SheafOfModules.{u} R} (e : M ≅ N)
    (V : Cᵒᵖ) : Function.Injective ((e.hom.val.app V).hom) := by
  intro a b hab
  have ha : (e.inv.val.app V).hom ((e.hom.val.app V).hom a) = a :=
    congrArg (fun q : M ⟶ M => (q.val.app V).hom a) e.hom_inv_id
  have hb : (e.inv.val.app V).hom ((e.hom.val.app V).hom b) = b :=
    congrArg (fun q : M ⟶ M => (q.val.app V).hom b) e.hom_inv_id
  rw [← ha, ← hb, hab]

/-- **Element form of `IsColimit.hom_ext` in `ModuleCat`.** The image of a morphism out of the
colimit of a discrete family lies in the span of the images of the components. -/
private theorem mem_span_range_of_isColimit {R : Type u} [Ring R] {ι : Type u}
    {D : Discrete ι ⥤ ModuleCat.{u} R} {c : Limits.Cocone D} (hc : Limits.IsColimit c)
    {C : ModuleCat.{u} R} (φ : c.pt ⟶ C) (w : c.pt) :
    φ.hom w ∈ Submodule.span R (⋃ i : ι, Set.range (c.ι.app ⟨i⟩ ≫ φ).hom) := by
  have hzero : φ ≫ ModuleCat.ofHom
      (Submodule.span R (⋃ i : ι, Set.range (c.ι.app ⟨i⟩ ≫ φ).hom)).mkQ = 0 := by
    refine hc.hom_ext fun j => ?_
    obtain ⟨i⟩ := j
    have h0 : ∀ y, (Submodule.span R
        (⋃ i : ι, Set.range (c.ι.app ⟨i⟩ ≫ φ).hom)).mkQ ((c.ι.app ⟨i⟩ ≫ φ).hom y) = 0 :=
      fun y => (Submodule.Quotient.mk_eq_zero _).2
        (Submodule.subset_span (Set.mem_iUnion.2 ⟨i, y, rfl⟩))
    rw [← Category.assoc, comp_zero]
    exact ModuleCat.hom_ext (LinearMap.ext h0)
  exact (Submodule.Quotient.mk_eq_zero _).1
    (congrArg (fun q : c.pt ⟶ _ => q.hom w) hzero)

/-- Every global section of `𝒪_X ⊗ ℐ_J` is `1 ⊗ m` for a global section `m` of `ℐ_J`. -/
private theorem exists_one_tmul_eq (J : X.IdealSheafData)
    (x : ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨((X.toRingedSpace)).presheaf, ((X.toRingedSpace)).IsSheaf⟩).obj ((SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)))).obj ((idealSheafOfModules J)))).val.obj (Opposite.op (⊤ : X.Opens))) :
    ∃ m : (idealSheafOfModules J).val.obj (Opposite.op (⊤ : X.Opens)),
      toTensorSheafSection X.toRingedSpace
          (SheafOfModules.unit (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)) (idealSheafOfModules J)
          (Opposite.op (⊤ : X.Opens))
          ((1 : (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).obj.obj
            (Opposite.op (⊤ : X.Opens))) ⊗ₜ m) = x := by
  refine ⟨(((tensorUnitIso (idealSheafOfModules J)).hom).val.app
      (Opposite.op (⊤ : X.Opens))).hom x,
    injective_app_of_iso (tensorUnitIso (idealSheafOfModules J))
      (Opposite.op (⊤ : X.Opens)) ?_⟩
  exact (tensorUnitIso_hom_app_tmul (idealSheafOfModules J) ⊤ 1 _).trans (one_smul _ _)

/-- **Global sections of ideal sheaves multiply.** Let `X` be a quasi-compact scheme, let the ideal
sheaf of a closed subscheme `I` be generated by global sections `g`, and let `J` be an effective
Cartier divisor. If `H¹(X, ker(⨁ 𝒪_X ⟶ ℐ_I) ⊗ ℐ_J) = 0` then the global sections of the ideal sheaf
of `I·J` are exactly the products of global sections of `ℐ_I` and of `ℐ_J`.

One inclusion is `AlgebraicGeometry.idealSheafGlobalSections_mul_le`. For the other, the vanishing
hypothesis makes `Γ(X, (⨁ 𝒪_X) ⊗ ℐ_J) ⟶ Γ(X, ℐ_I ⊗ ℐ_J)` surjective, and `ℐ_I ⊗ ℐ_J ≅ ℐ_{I·J}`
because `ℐ_J` is invertible; since sections over a quasi-compact space commute with direct sums, a
global section of `ℐ_{I·J}` is a finite sum of products of a generator `g i` with a global section
of `ℐ_J`. -/
theorem idealSheafGlobalSections_mul [CompactSpace X] (I J : X.IdealSheafData)
    (hJ : IsEffectiveCartierDivisor J)
    (g : (idealSheafOfModules I).GeneratingSections)
    (hH : IsZero (((moduleGlobalSections X).rightDerived 1).obj
      ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨((X.toRingedSpace)).presheaf, ((X.toRingedSpace)).IsSheaf⟩).obj ((kernel g.π))).obj ((idealSheafOfModules J)))))) :
    idealSheafGlobalSections (I * J) =
      idealSheafGlobalSections I * idealSheafGlobalSections J := by
  have hinv : AlgebraicGeometry.SheafOfModules.IsInvertible X.presheaf
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).property
      (idealSheafOfModules J) := hJ
  have hLeq : ((Stacks.SheafOfModules.Tensor.sheafTensor.{_, _, u, u, u} X.sheaf).obj
      (idealSheafOfModules J)).IsEquivalence :=
