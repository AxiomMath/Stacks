end GlobalSectionsMul

namespace RationalSingularitySituation

open Stacks.Cohomology.AffineBase

attribute [local instance 10000] HasDerivedCategory.standard

variable (S : RationalSingularitySituation.{u})

/-- The ideal sheaf of the special fibre `E = X_s` of the modification. -/
abbrev exceptionalIdeal : S.X.IdealSheafData := (S.f.fiberι S.closedPoint).ker

/-- The `n`-th power of the ideal sheaf of the special fibre, as a sheaf of `𝒪_X`-modules. -/
abbrev exceptionalIdealPow (n : ℕ) : S.X.Modules :=
  Stacks.Divisors.idealSheafOfModules (S.exceptionalIdeal ^ n)

/-- Every power of the ideal sheaf of the special fibre is generated by global sections, as
soon as the ideal sheaf itself is: the products of the given generators generate the power. -/
def exceptionalIdealPowGeneratingSections
    (σ : (Stacks.Divisors.idealSheafOfModules S.exceptionalIdeal).GeneratingSections) (n : ℕ) :
    (S.exceptionalIdealPow n).GeneratingSections :=
  idealSheafOfModulesPowGeneratingSections S.exceptionalIdeal σ n

/-! ### The global functions on `X` are `A` -/

/-- The generic point of an irreducible scheme lies in every dense open subset. -/
private theorem genericPoint_mem_of_dense (Y : Scheme.{u}) [IsIntegral Y] (V : Y.Opens)
    (hV : Dense (V : Set Y)) : genericPoint Y ∈ V := by
  obtain ⟨x, -, hxV⟩ := hV.inter_open_nonempty Set.univ isOpen_univ
    ⟨genericPoint Y, Set.mem_univ _⟩
  exact ((genericPoint_spec Y).mem_open_set_iff V.2).2 ⟨x, Set.mem_univ _, hxV⟩

/-- In a pullback square whose right edge and bottom-left edge are isomorphisms, the remaining
edge is an isomorphism: the top-left edge is one by base change, and the square identifies its
composite with the given morphism as a composite of two isomorphisms. -/
private theorem isIso_of_isPullback {C : Type*} [Category C] {P W Y Z : C} {fst : P ⟶ W}
    {snd : P ⟶ Y} {f : W ⟶ Z} {g : Y ⟶ Z} (h : IsPullback fst snd f g) (hg : IsIso g)
    (hsnd : IsIso snd) : IsIso f := by
  have := hg
  have := hsnd
  have : IsIso fst := h.isIso_fst_of_isIso
  have : IsIso (fst ≫ f) := by rw [h.w]; infer_instance
  exact IsIso.of_isIso_comp_left fst f

/-- Transport of the generic-fibre isomorphism along an equality of base points. -/
private theorem isIso_fiberToSpecResidueField_congr {X Y : Scheme.{u}} (f : X ⟶ Y) {y y' : Y}
    (h : y = y') (hy : IsIso (f.fiberToSpecResidueField y)) :
    IsIso (f.fiberToSpecResidueField y') := by
  cases h; exact hy

/-- The fibre of the modification over the generic point of `Spec(A)` is the spectrum of the
function field: a proper birational morphism is an isomorphism over a dense open
([Stacks, Tag 0BAJ]), and the generic point lies in that open. -/
private theorem isIso_fiberToSpecResidueField_genericPoint :
    IsIso (S.f.fiberToSpecResidueField (genericPoint S.base)) := by
  have : IsIntegral S.X := S.source_isIntegral
  have : IsProper S.f := S.isProper
  have : Finite (irreducibleComponents S.X) := by
    rw [irreducibleComponents_eq_singleton]; infer_instance
  have : Finite (irreducibleComponents S.base) := by
    rw [irreducibleComponents_eq_singleton]; infer_instance
  obtain ⟨V, hV, hViso⟩ := exists_dense_open_isIso_morphismRestrict_of_isBirational
    S.f S.modification.isBirational (Or.inl inferInstance)
    (Or.inl ⟨inferInstance, inferInstance⟩)
  have hηV : genericPoint S.base ∈ V := genericPoint_mem_of_dense S.base V hV
  let z : V.toScheme := ⟨genericPoint S.base, hηV⟩
  have hz : V.ι z = genericPoint S.base := rfl
  have : IsIso (S.f ∣_ V) := hViso
  have hg : IsIso (pullback.snd S.f V.ι) := by
    have : IsIso ((pullbackRestrictIsoRestrict S.f V).hom ≫ S.f ∣_ V) := inferInstance
    rwa [pullbackRestrictIsoRestrict_hom_morphismRestrict] at this
  have H := isPullback_fiberToSpecResidueField_of_isPullback
    (IsPullback.of_hasPullback S.f V.ι) z
  have hj : IsIso (Spec.map (V.ι.residueFieldMap z)) :=
    (Scheme.Spec.mapIso (asIso (V.ι.residueFieldMap z)).op).isIso_hom
  have hfib : IsIso ((pullback.snd S.f V.ι).fiberToSpecResidueField z) :=
    pullback_snd_iso_of_left_iso (pullback.snd S.f V.ι)
      (V.toScheme.fromSpecResidueField z)
  exact isIso_fiberToSpecResidueField_congr S.f hz (isIso_of_isPullback H hj hfib)

/-- The unique generic point of `X` lies over the generic point of `Spec(A)`, because a
modification is birational. -/
private theorem map_genericPoints (x : S.X) (hx : x ∈ genericPoints S.X) :
    S.f x = genericPoint S.base := by
  have : IsIntegral S.X := S.source_isIntegral
  have hx' : S.f x ∈ genericPoints S.base := S.modification.isBirational.bijOn.mapsTo hx
  simpa only [genericPoints_eq_singleton, Set.mem_singleton_iff] using hx'

/-- **`Γ(X, 𝒪_X) = A`.** The canonical ring map from `A` to the global functions on the
modification is an isomorphism.

This is [Stacks, Tag 0AY8] at `f`: the base `Spec(A)` is normal and integral because `A` is a
normal domain, the source is reduced because it is integral, the unique generic point of `X` maps
to the generic point of `Spec(A)` because `f` is dominant, and the generic fibre contributes no
functions beyond the function field because it is the spectrum of that field. -/
theorem isIso_globalFunctions :
    IsIso ((Scheme.ΓSpecIso (.of S.A)).inv ≫ S.f.appTop) := by
  have : IsIntegral S.X := S.source_isIntegral
  have : IsProper S.f := S.isProper
  have : AlgebraicGeometry.IsNormal S.base :=
    isNormal_spec_of_isNormalRing (IsNormalRing.of_isIntegrallyClosed S.A)
  have hfib := S.isIso_fiberToSpecResidueField_genericPoint
  have hΓ : IsIso ((Scheme.ΓSpecIso (S.base.residueField (genericPoint S.base))).inv ≫
      (S.f.fiberToSpecResidueField (genericPoint S.base)).appTop) := by
    have : IsIso (S.f.fiberToSpecResidueField (genericPoint S.base)).appTop := by
      show IsIso ((S.f.fiberToSpecResidueField (genericPoint S.base)).c.app (Opposite.op ⊤))
      infer_instance
    infer_instance
  have hc : IsIso S.f.c := Stacks.SteinFactorization.isIso_c_of_isNormal S.f S.map_genericPoints hΓ
  have : IsIso S.f.appTop := by
    show IsIso (S.f.c.app (Opposite.op ⊤))
    infer_instance
  infer_instance

/-! ### The global sections of `𝓘` are `𝔪` -/

/-- A modification is surjective: it is dominant, because the generic point of `X` maps to the
generic point of `Spec(A)`, and it is closed, because it is proper. -/
private theorem surjective_f : Surjective S.f := by
  have : IsIntegral S.X := S.source_isIntegral
  have : IsProper S.f := S.isProper
  have hη : genericPoint S.X ∈ genericPoints S.X := by
    simp only [genericPoints_eq_singleton, Set.mem_singleton_iff]
  have : IsDominant S.f := ⟨by
    rw [DenseRange, dense_iff_closure_eq]
    refine Set.Subset.antisymm (Set.subset_univ _) ?_
    calc Set.univ = closure {genericPoint S.base} := (genericPoint_spec S.base).def.symm
      _ ⊆ closure (Set.range S.f) := closure_mono (by
          intro x hx
          rw [Set.mem_singleton_iff] at hx
          exact ⟨genericPoint S.X, (S.map_genericPoints _ hη).trans hx.symm⟩)⟩
  infer_instance

/-- A function on `Spec(A)` restricts to zero at the closed point exactly when it lies in the
maximal ideal. -/
private theorem fromSpecResidueField_appTop_eq_zero_iff (a : S.A) :
    (S.base.fromSpecResidueField S.closedPoint).appTop
        ((Scheme.ΓSpecIso (.of S.A)).inv a) = 0 ↔ a ∈ S.maximalIdeal := by
  rw [← basicOpen_eq_bot_iff, ← Scheme.preimage_basicOpen_top, basicOpen_eq_of_affine]
  show (S.base.fromSpecResidueField S.closedPoint ⁻¹ᵁ PrimeSpectrum.basicOpen a) = ⊥ ↔
    a ∈ S.maximalIdeal
  constructor
  · intro h
    by_contra hna
    have hm : (default : Spec (S.base.residueField S.closedPoint)) ∈
        (S.base.fromSpecResidueField S.closedPoint ⁻¹ᵁ PrimeSpectrum.basicOpen a) := by
      show S.base.fromSpecResidueField S.closedPoint
        (default : Spec (S.base.residueField S.closedPoint)) ∈ PrimeSpectrum.basicOpen a
      rw [Scheme.fromSpecResidueField_apply]
      exact hna
    rw [h] at hm
    exact hm
  · intro h
    apply TopologicalSpace.Opens.ext
    ext x
    show (S.base.fromSpecResidueField S.closedPoint) x ∈ PrimeSpectrum.basicOpen a ↔ False
    rw [Scheme.fromSpecResidueField_apply]
    exact iff_false_intro (not_not.mpr h)

/-- **`H⁰(X, 𝓘) = 𝔪`.** A global function on `X` is a section of the ideal sheaf of the special
fibre exactly when it comes from the maximal ideal of `A`.

The special fibre is the scheme-theoretic preimage of the closed point, so a function kills it
exactly when its restriction along `X_s ⟶ Spec κ` does; the latter map is injective on global
functions because `X_s ⟶ Spec κ` is surjective and `Spec κ` is reduced. -/
theorem mem_idealSheafGlobalSections_exceptionalIdeal_iff (a : S.A) :
    ((Scheme.ΓSpecIso (.of S.A)).inv ≫ S.f.appTop).hom a ∈
        idealSheafGlobalSections S.exceptionalIdeal ↔ a ∈ S.maximalIdeal := by
  have : IsProper S.f := S.isProper
  have : IsClosedImmersion (S.base.fromSpecResidueField S.closedPoint) :=
    (isClosed_singleton_iff_isClosedImmersion (X := S.base) (x := S.closedPoint)).1
      (IsLocalRing.isClosed_singleton_closedPoint S.A)
  have : IsClosedImmersion (S.f.fiberι S.closedPoint) := by
    show IsClosedImmersion (pullback.fst _ _); infer_instance
  have : Surjective S.f := S.surjective_f
  have : Surjective (S.f.fiberToSpecResidueField S.closedPoint) := by
    show Surjective (pullback.snd _ _); infer_instance
  have : IsSchemeTheoreticallyDominant (S.f.fiberToSpecResidueField S.closedPoint) :=
    IsSchemeTheoreticallyDominant.of_isDominant _
  have hinj : Function.Injective (S.f.fiberToSpecResidueField S.closedPoint).appTop :=
    (S.f.fiberToSpecResidueField S.closedPoint).app_injective ⊤
  have hfac : S.f.appTop ≫ (S.f.fiberι S.closedPoint).appTop =
      (S.base.fromSpecResidueField S.closedPoint).appTop ≫
        (S.f.fiberToSpecResidueField S.closedPoint).appTop :=
    congrArg Scheme.Hom.appTop (S.f.fiber_fac S.closedPoint)
  have key : (S.f.fiberι S.closedPoint).appTop
      (S.f.appTop ((Scheme.ΓSpecIso (.of S.A)).inv a)) =
      (S.f.fiberToSpecResidueField S.closedPoint).appTop
        ((S.base.fromSpecResidueField S.closedPoint).appTop
          ((Scheme.ΓSpecIso (.of S.A)).inv a)) :=
    congrArg (fun q : Γ(S.base, ⊤) ⟶ Γ(S.f.fiber S.closedPoint, ⊤) =>
      q ((Scheme.ΓSpecIso (.of S.A)).inv a)) hfac
  rw [idealSheafGlobalSections_ker (S.f.fiberι S.closedPoint), RingHom.mem_ker]
  show (S.f.fiberι S.closedPoint).appTop
    (S.f.appTop ((Scheme.ΓSpecIso (.of S.A)).inv a)) = 0 ↔ a ∈ S.maximalIdeal
  rw [key, map_eq_zero_iff _ hinj]
  exact S.fromSpecResidueField_appTop_eq_zero_iff a

/-! ### The global sections of `𝓘ⁿ` are `𝔪ⁿ` -/

/-- **`H⁰(X, 𝓘) = 𝔪`.** The global sections of the ideal sheaf of the special fibre are the
image of the maximal ideal under the isomorphism `A ≅ Γ(X, 𝒪_X)`.

This is the case `n = 1` of the global-sections conclusion of [Stacks, Tag 0B4Y]; it needs no
hypothesis on the special fibre, and it is the base case of the general statement
`idealSheafGlobalSections_exceptionalIdealPow_unconditional`. -/
theorem idealSheafGlobalSections_exceptionalIdeal :
    idealSheafGlobalSections S.exceptionalIdeal =
      S.maximalIdeal.map ((Scheme.ΓSpecIso (.of S.A)).inv ≫ S.f.appTop).hom := by
  have hiso := S.isIso_globalFunctions
  have hsurj : Function.Surjective ((Scheme.ΓSpecIso (.of S.A)).inv ≫ S.f.appTop).hom :=
    (ConcreteCategory.bijective_of_isIso ((Scheme.ΓSpecIso (.of S.A)).inv ≫ S.f.appTop)).2
  rw [← Ideal.map_comap_of_surjective _ hsurj (idealSheafGlobalSections S.exceptionalIdeal)]
  refine congrArg (Ideal.map _) ?_
  ext a
  exact S.mem_idealSheafGlobalSections_exceptionalIdeal_iff a

