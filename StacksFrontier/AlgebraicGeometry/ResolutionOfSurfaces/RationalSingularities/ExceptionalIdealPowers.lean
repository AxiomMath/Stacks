/-- The relations of a presentation of an ideal sheaf, tensored with another ideal sheaf, form a
quasi-coherent module. -/
theorem isQuasicoherent_kernelTensorIdeal (I K : X.IdealSheafData)
    (g : (idealSheafOfModules I).GeneratingSections) :
    ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨((X.toRingedSpace)).presheaf, ((X.toRingedSpace)).IsSheaf⟩).obj ((kernel g.π))).obj ((idealSheafOfModules K)))).IsQuasicoherent := by
  have hI : (idealSheafOfModules I).IsQuasicoherent := isQuasicoherent_idealSheafOfModules I
  have hK : (idealSheafOfModules K).IsQuasicoherent := isQuasicoherent_idealSheafOfModules K
  have hfree : (SheafOfModules.free
      (R := Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf) g.I).IsQuasicoherent :=
    inferInstance
  have hker : (kernel g.π).IsQuasicoherent :=
    @Stacks.AlgebraicGeometry.QcohLimits.isQuasicoherent_kernel X _ _ g.π hfree hI
  exact @AlgebraicGeometry.tensorSheaf_isQuasicoherent X.toRingedSpace _ _ hker hK

/-- Functoriality of the tensor product of sheaves of modules on a scheme in the second factor.
It is `Stacks.SheafOfModules.Invertible.tensorProductIso`, read at the Tag 01CB tensor product;
only one comparison of the two constructions is involved, so unlike the associator it needs no
transport along a proved equality. -/
noncomputable def tensorSheafIsoRight
    {M N N' : SheafOfModules.{u} (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf)} (e : N ≅ N') :
    (((Stacks.SheafOfModules.Tensor.sheafTensor ⟨((X.toRingedSpace)).presheaf, ((X.toRingedSpace)).IsSheaf⟩).obj (M)).obj (N)) ≅ (((Stacks.SheafOfModules.Tensor.sheafTensor ⟨((X.toRingedSpace)).presheaf, ((X.toRingedSpace)).IsSheaf⟩).obj (M)).obj (N')) :=
  Stacks.SheafOfModules.Invertible.tensorProductIso X.presheaf
    (_root_.Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).property (Iso.refl M) e

/-- Generating global sections of `ker(⨁ 𝒪_X ⟶ ℐ_I) ⊗ ℐ_{Iⁿ⁺¹}`, for `I` an effective Cartier
divisor whose ideal sheaf is generated by global sections. The case `n = 0` is
[Stacks, Tag 0B3B]; the general case follows, as in the source's "hence the same holds for
`ℱ ⊗ 𝓘ⁿ`", by tensoring it with the globally generated `ℐ_{Iⁿ}` and reassociating with
`Stacks.SheafOfModules.TensorStalkRingedSpace.tensorSheafAssociator`, the product
`ℐ_I ⊗ ℐ_{Iⁿ}` being `ℐ_{Iⁿ⁺¹}` because `ℐ_{Iⁿ}` is invertible. -/
noncomputable def kernelTensorIdealPowGeneratingSections (I : X.IdealSheafData)
    (hI : IsEffectiveCartierDivisor I) (g : (idealSheafOfModules I).GeneratingSections)
    (n : ℕ) :
    ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨((X.toRingedSpace)).presheaf, ((X.toRingedSpace)).IsSheaf⟩).obj ((kernel g.π))).obj ((idealSheafOfModules (I ^ (n + 1)))))).GeneratingSections := by
  have hloc : ∀ z : X.toRingedSpace.carrier, IsLocalRing (ringStalk X.toRingedSpace z) :=
    fun z => X.isLocalRing z
  have hinv : Stacks.SheafOfModules.IsInvertible X.presheaf
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).property (idealSheafOfModules I) :=
    Stacks.SheafOfModules.IsInvertible.ofAlgebraicGeometry X.presheaf
      (Stacks.SheafOfModules.Tensor.ringSheaf X.sheaf).property (idealSheafOfModules I) hI
  refine SheafOfModules.GeneratingSections.equivOfIso
    (Stacks.SheafOfModules.TensorStalkRingedSpace.tensorSheafAssociator X.toRingedSpace
        (kernel g.π) (idealSheafOfModules I) (idealSheafOfModules (I ^ n)) ≪≫
      tensorSheafIsoRight (idealTensorMulIso I (I ^ n)
        (isEffectiveCartierDivisor_pow hI n)) ≪≫
      eqToIso (congrArg (fun K : X.IdealSheafData =>
        (((Stacks.SheafOfModules.Tensor.sheafTensor ⟨((X.toRingedSpace)).presheaf,
            ((X.toRingedSpace)).IsSheaf⟩).obj ((kernel g.π))).obj ((idealSheafOfModules K))))
