module

public import
  StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalSingularities.DualizingTrace
import StacksCore.Tactic.StacksAttribute

/-!
# The canonical map from the pullback of the dualizing module of the base

In Situation [Stacks, Tag 0B4W] — a two-dimensional local normal Nagata domain `A` defining a
rational singularity and a modification `f : X ⟶ Spec(A)` with `X` normal — [Stacks, Tag 0BBU]
asserts that the trace `H⁰(X, ω_X) ⟶ ω_A` is an isomorphism, and *then* that its inverse
induces a canonical map `f^*ω_A ⟶ ω_X`. For the normalized `ω_X` of [Stacks, Remark 0B4R] and
the trace of duality both clauses are proved in `NormalizedDualizingTrace.lean`
(`bijective_normalizedTrace` and `normalizedPullbackMap`, which carry the tag). This file builds
the map from the trace of a `DualizingTraceSequence`
(`AlgebraicGeometry.RationalSingularitySituation.bijective_trace`), a datum equivalent to the
trace isomorphism itself.

## Main definitions

* `AlgebraicGeometry.RationalSingularitySituation.globalSectionsAdjunction`: the adjunction
  `M ↦ f^*M̃ ⊣ ℱ ↦ H⁰(X, ℱ)` between `A`-modules and `𝒪_X`-modules.
* `AlgebraicGeometry.RationalSingularitySituation.traceIso`: the trace, as an isomorphism.
* `AlgebraicGeometry.RationalSingularitySituation.dualizingPullbackMap`: the canonical map
  `f^*ω_A ⟶ ω_X` of [Stacks, Tag 0BBU].

## Main results

* `AlgebraicGeometry.RationalSingularitySituation.dualizingPullbackMap_eq`: the canonical map is
  the counit of `globalSectionsAdjunction` precomposed with an isomorphism.
* `AlgebraicGeometry.RationalSingularitySituation.epi_dualizingPullbackMap_of_epi_counit`: it is
  therefore an epimorphism as soon as the counit at `ω_X` is one, that is, as soon as `ω_X` is
  generated by its global sections.
* `AlgebraicGeometry.RationalSingularitySituation.surjective_appTop_dualizingPullbackMap`: every
  global section of `ω_X` is the image of a global section of `f^*ω_A`.

## Implementation notes

**The adjunction, not the pullback–pushforward adjunction alone.** The source's map is the
adjunct of `ω_A ⟶ f_*ω_X`, so it is the image of the inverse trace under the composite of the
affine comparison `~ ⊣ Γ` (Mathlib's `AlgebraicGeometry.tilde.adjunction`) and the
pullback–pushforward adjunction for module sheaves. That composite is recorded as
`globalSectionsAdjunction`; its right adjoint is `H⁰(X, -)` as an `A`-module, which is
`AlgebraicGeometry.RationalSingularitySituation.globalSectionsModule` — on the nose, which is
`globalSectionsModuleIso`.

Writing the map through the *composite* adjunction rather than through the two adjunctions in
turn is what makes `epi_dualizingPullbackMap_of_epi_counit` unconditional: the inverse trace is
an isomorphism, so the map differs from the composite counit at `ω_X` by an isomorphism, and
nothing has to be known about whether `f_*ω_X` is quasi-coherent.

**The hypothesis `D`.** The map cannot be built without the trace being invertible, which is
[Stacks, Tag 0BBU] itself, and `bijective_trace` takes as hypothesis a
`AlgebraicGeometry.RationalSingularitySituation.DualizingTraceSequence` — the output of
Grauert–Riemenschneider vanishing [Stacks, Tag 0AXD] and of the duality exact sequence
[Stacks, Tag 0B4S]. So that datum appears as the argument `D` of the map, exactly as it appears
in `bijective_trace`. Nothing beyond it is assumed.

## References

* [Stacks Project, Tag 0BBU](https://stacks.math.columbia.edu/tag/0BBU)
* [Stacks Project, Tag 0B4W](https://stacks.math.columbia.edu/tag/0B4W)
* [Stacks Project, Tag 0B4R](https://stacks.math.columbia.edu/tag/0B4R)
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open Stacks.Cohomology.AffineBase

universe u

attribute [local instance] HasDerivedCategory.standard

namespace AlgebraicGeometry.RationalSingularitySituation

variable (S : RationalSingularitySituation.{u})

/-! ### The adjunction `M ↦ f^*M̃ ⊣ ℱ ↦ H⁰(X, ℱ)` -/

/-- **The adjunction `M ↦ f^*M̃ ⊣ ℱ ↦ H⁰(X, ℱ)`** between `A`-modules and `𝒪_X`-modules: the
affine comparison `~ ⊣ Γ` of [Stacks, Tag 01I8] composed with the pullback–pushforward
adjunction for sheaves of modules. -/
public def globalSectionsAdjunction :
    tilde.functor (CommRingCat.of S.A) ⋙ Scheme.Modules.pullback S.f ⊣
      Scheme.Modules.pushforward S.f ⋙ moduleSpecΓFunctor :=
  tilde.adjunction.comp (Scheme.Modules.pullbackPushforwardAdjunction S.f)

/-- **The right adjoint of `globalSectionsAdjunction` is `H⁰(X, -)`.** The global sections of
the pushforward over `Spec(A)` are the global sections upstairs, and the `A`-module structure
through `Γ(Spec A, 𝒪) ≅ A` is the one through `f`. -/
public def globalSectionsModuleIso (F : S.X.Modules) :
    (Scheme.Modules.pushforward S.f ⋙ moduleSpecΓFunctor).obj F ≅ S.globalSectionsModule F :=
  Iso.refl _

/-! ### The canonical map -/

variable [IsLocallyNoetherian S.X]

/-- **[Stacks, Tag 0BBU] as an isomorphism.** The trace `H⁰(X, ω_X) ⟶ ω_A` is bijective, hence
invertible in the category of `A`-modules. -/
public def traceIso (ωA : ModuleCat.{u} S.A)
    (hωA : Stacks.Duality.IsDualizingRingModule S.A ωA) (ωX : S.X.Modules)
    (hωX : Stacks.Duality.IsDualizingModule ωX) (D : S.DualizingTraceSequence ωA ωX) :
    S.globalSectionsModule ωX ≅ ωA :=
  have : IsIso D.trace :=
    (ConcreteCategory.isIso_iff_bijective D.trace).2 (S.bijective_trace ωA hωA ωX hωX D)
  asIso D.trace

/-- **Stacks Project, Tag 0BBU.** The canonical map `f^*ω_A ⟶ ω_X`: the adjunct, under
`globalSectionsAdjunction`, of the inverse `ω_A ⟶ H⁰(X, ω_X)` of the trace.

The source introduces this map immediately after the trace isomorphism, as "the canonical map
`f^*ω_A ⟶ ω_X`"; it is the subject of clause (3) of [Stacks, Tag 0B64]. -/
public def dualizingPullbackMap (ωA : ModuleCat.{u} S.A)
    (hωA : Stacks.Duality.IsDualizingRingModule S.A ωA) (ωX : S.X.Modules)
    (hωX : Stacks.Duality.IsDualizingModule ωX) (D : S.DualizingTraceSequence ωA ωX) :
    (Scheme.Modules.pullback S.f).obj (tilde ωA) ⟶ ωX :=
  (S.globalSectionsAdjunction.homEquiv ωA ωX).symm
    ((S.traceIso ωA hωA ωX hωX D).inv ≫ (S.globalSectionsModuleIso ωX).inv)

/-- The inverse trace, read as a map into the right adjoint of `globalSectionsAdjunction`. -/
public def traceInvHom (ωA : ModuleCat.{u} S.A)
    (hωA : Stacks.Duality.IsDualizingRingModule S.A ωA) (ωX : S.X.Modules)
    (hωX : Stacks.Duality.IsDualizingModule ωX) (D : S.DualizingTraceSequence ωA ωX) :
    ωA ⟶ (Scheme.Modules.pushforward S.f ⋙ moduleSpecΓFunctor).obj ωX :=
  (S.traceIso ωA hωA ωX hωX D).inv ≫ (S.globalSectionsModuleIso ωX).inv

variable (ωA : ModuleCat.{u} S.A)
  (hωA : Stacks.Duality.IsDualizingRingModule S.A ωA) (ωX : S.X.Modules)
  (hωX : Stacks.Duality.IsDualizingModule ωX) (D : S.DualizingTraceSequence ωA ωX)

/-- The inverse trace is an isomorphism. -/
public instance isIso_traceInvHom : IsIso (S.traceInvHom ωA hωA ωX hωX D) := by
  rw [traceInvHom]; infer_instance

/-- The canonical map is the adjunct of the inverse trace. -/
public theorem dualizingPullbackMap_eq_homEquiv_symm :
    S.dualizingPullbackMap ωA hωA ωX hωX D =
      (S.globalSectionsAdjunction.homEquiv ωA ωX).symm (S.traceInvHom ωA hωA ωX hωX D) :=
  rfl

/-- **The canonical map is the counit of `globalSectionsAdjunction` up to an isomorphism.** It is
the counit at `ω_X` precomposed with the image of the inverse trace. -/
public theorem dualizingPullbackMap_eq :
    S.dualizingPullbackMap ωA hωA ωX hωX D =
      (tilde.functor (CommRingCat.of S.A) ⋙ Scheme.Modules.pullback S.f).map
          (S.traceInvHom ωA hωA ωX hωX D) ≫
        S.globalSectionsAdjunction.counit.app ωX :=
  S.globalSectionsAdjunction.homEquiv_counit ωA ωX _

/-- **The canonical map is an epimorphism as soon as `ω_X` is generated by its global sections.**
The two differ by the image under the left adjoint of the inverse trace, which is an
isomorphism. -/
public theorem epi_dualizingPullbackMap_of_epi_counit
    (h : Epi (S.globalSectionsAdjunction.counit.app ωX)) :
    Epi (S.dualizingPullbackMap ωA hωA ωX hωX D) := by
  have h₁ : Epi ((tilde.functor (CommRingCat.of S.A) ⋙ Scheme.Modules.pullback S.f).map
      (S.traceInvHom ωA hωA ωX hωX D)) := inferInstance
  rw [S.dualizingPullbackMap_eq ωA hωA ωX hωX D]
  exact @epi_comp _ _ _ _ _ _ h₁ _ h

/-- **The canonical map is split on global sections.** The unit of the adjunction at `ω_A`,
preceded by the trace, splits `H⁰(X, f^*ω_A) ⟶ H⁰(X, ω_X)`: the adjunct of a map composed with
the unit is the map itself, and here that map is the invertible inverse trace. -/
public theorem globalSections_dualizingPullbackMap_split :
    (inv (S.traceInvHom ωA hωA ωX hωX D) ≫ S.globalSectionsAdjunction.unit.app ωA) ≫
        (Scheme.Modules.pushforward S.f ⋙ moduleSpecΓFunctor).map
          (S.dualizingPullbackMap ωA hωA ωX hωX D) =
      𝟙 ((Scheme.Modules.pushforward S.f ⋙ moduleSpecΓFunctor).obj ωX) := by
  rw [Category.assoc, S.dualizingPullbackMap_eq_homEquiv_symm ωA hωA ωX hωX D,
    ← Adjunction.homEquiv_unit, Equiv.apply_symm_apply, IsIso.inv_hom_id]

/-- **Every global section of `ω_X` is the image of a global section of `f^*ω_A`.** The canonical
map is split on global sections. -/
public theorem surjective_appTop_dualizingPullbackMap :
    Function.Surjective ((S.dualizingPullbackMap ωA hωA ωX hωX D).val.app (op ⊤)) := fun y =>
  ⟨(inv (S.traceInvHom ωA hωA ωX hωX D) ≫ S.globalSectionsAdjunction.unit.app ωA).hom y,
    congrArg (fun k => k.hom y) (S.globalSections_dualizingPullbackMap_split ωA hωA ωX hωX D)⟩

end AlgebraicGeometry.RationalSingularitySituation

end

end
