attribute [local instance 2000] HasDerivedCategory.standard

universe u

namespace Stacks.AlgebraicGeometry.HyperplaneTwistSequence

/-- **The cohomology of a direct sum of copies of an invertible module.** On a quasi-compact
quasi-separated scheme, if `Hᵖ(X, 𝒪_X ⊗ ℳ) = 0` for an invertible `ℳ` then
`Hᵖ(X, (⨁_{i ∈ I} 𝒪_X) ⊗ ℳ) = 0` for every index type `I`.

Tensoring by `ℳ` is an equivalence ([Stacks, Tag 01CS]), hence preserves the coproduct
`SheafOfModules.isColimitFreeCofan` exhibiting the free module as a sum of copies of
`𝒪_X`, and `Hᵖ(X, -)` preserves coproducts by [Stacks, Tag 01FF]
(`preservesColimitsOfShape_discrete_rightDerived_moduleGlobalSections`). So the composite carries
that cofan to a colimit cofan all of whose legs start at a zero object, and such a cofan has a
zero point.

At `ℳ = 𝒪_X` this is `isZero_rightDerived_free_of_isZero_unit`. -/
theorem isZero_rightDerived_tensorRightModules_free {X : _root_.AlgebraicGeometry.Scheme.{u}}
    [CompactSpace (X : Type u)] [QuasiSeparatedSpace (X : Type u)]
    (M : X.Modules) [Stacks.Ample.IsInvertibleModule X M] (q : ℕ) (I : Type u)
    (h : IsZero (((moduleGlobalSections X).rightDerived q).obj
      ((tensorRightModules X M).obj (SheafOfModules.unit X.ringCatSheaf)))) :
    IsZero (((moduleGlobalSections X).rightDerived q).obj
      ((tensorRightModules X M).obj (SheafOfModules.free (R := X.ringCatSheaf) I))) := by
  have : (tensorRightModules X M).IsEquivalence :=
    Stacks.RelativeVeryAmple.isEquivalence_tensorRightFunctor_of_isInvertibleModule X M
  have : (tensorRightModules X M).IsLeftAdjoint :=
    ((tensorRightModules X M).asEquivalence.toAdjunction).isLeftAdjoint
  have : PreservesColimitsOfShape (Discrete I) ((moduleGlobalSections X).rightDerived q) :=
    preservesColimitsOfShape_discrete_rightDerived_moduleGlobalSections X q I
  have hpres : PreservesColimitsOfShape (Discrete I)
      (tensorRightModules X M ⋙ (moduleGlobalSections X).rightDerived q) := inferInstance
  have hpc : PreservesColimit (Discrete.functor fun _ : I => SheafOfModules.unit X.ringCatSheaf)
      (tensorRightModules X M ⋙ (moduleGlobalSections X).rightDerived q) :=
    hpres.preservesColimit
  have hc := (PreservesColimit.preserves (self := hpc)
    (SheafOfModules.isColimitFreeCofan (R := X.ringCatSheaf) I)).some
  exact (IsZero.iff_id_eq_zero _).2 (hc.hom_ext fun _ => h.eq_of_src _ _)

end Stacks.AlgebraicGeometry.HyperplaneTwistSequence

namespace AlgebraicGeometry.BlowUpDualizing

variable (S : RationalSingularitySituation.{u})

/-- **`𝒪_E ⊗ 𝒪_E(n) ≅ 𝒪_E(n)`** on the exceptional curve of the blowup. The structure sheaf is
the zeroth twist (`curveTwistSheafZeroIso`), and the twists add
(`curveTwistSheafAddIso`). -/
def curveTwistUnitIso (n : ℕ) :
    curveTwist S.A (unitModule (exceptionalCurve S.A)) (n : ℤ) ≅ curveTwistSheaf S.A (n : ℤ) :=
  tensorModulesMapIso (exceptionalCurve S.A) (curveTwistSheafZeroIso S.A).symm (Iso.refl _) ≪≫
    curveTwistSheafAddIso S.A 0 (n : ℤ) ≪≫ curveTwistSheafCongr S.A (zero_add _)

/-- **`H¹(E, ℒ(n)) = 0` for every `n ≥ 0` and every `𝒪_E`-module `ℒ` generated by its global
sections**, on the exceptional curve of the blowup of `Spec(A)` in the maximal ideal in Situation
[Stacks, Tag 0B4W]. Nothing further is assumed about `ℒ` — not quasi-coherence — and nothing
about `A` beyond the situation.

The generating family gives a short exact sequence `0 ⟶ 𝒦 ⟶ ⨁_{j ∈ I} 𝒪_E ⟶ ℒ ⟶ 0`, and
tensoring by the invertible `𝒪_E(n)` keeps it short exact. Its middle term has vanishing first
cohomology by `isZero_rightDerived_tensorRightModules_free` together with clause (4) of
[Stacks, Tag 0B63] (`isZero_firstCohomology_curveTwistSheaf`), and its left-hand term vanishing
second cohomology by [Stacks, Tag 02UZ], the exceptional curve being a Noetherian space of
dimension one; so the first cohomology of the right-hand term vanishes. -/
theorem isZero_firstCohomology_curveTwist_of_generatingSections
    (L : (exceptionalCurve S.A).Modules) (G : L.GeneratingSections) (n : ℕ) :
    IsZero (((cohomologyDeltaFunctor (exceptionalCurve S.A)).functor 1).obj
      (curveTwist S.A L (n : ℤ))) := by
  have : NoetherianSpace (exceptionalCurve S.A : Type u) := noetherianSpace_exceptionalCurve S
  have : IsProper (exceptionalDivisorToCentre (Stacks.Blowup.residuePoint S.A)) :=
    isProper_exceptionalDivisorToCentre_residuePoint S.A
  have : CompactSpace (exceptionalCurve S.A : Type u) :=
    QuasiCompact.compactSpace_of_compactSpace
      (exceptionalDivisorToCentre (Stacks.Blowup.residuePoint S.A))
  -- the presentation of `ℒ` by its global generators, tensored by `𝒪_E(n)`
  have hS0 : (ShortComplex.mk (C := (exceptionalCurve S.A).Modules)
      (kernel.ι G.π) G.π (kernel.condition G.π)).ShortExact :=
    ShortComplex.ShortExact.mk' (ShortComplex.exact_of_f_is_kernel _ (kernelIsKernel _))
      (mono_of_isLimit_fork (c := Fork.ofι _ _) (kernelIsKernel _)) G.epi
  have hS := hS0.map_of_exact
    (tensorRightModules (exceptionalCurve S.A) (curveTwistSheaf S.A (n : ℤ)))
  -- `H¹(E, 𝒪_E ⊗ 𝒪_E(n)) = 0` is clause (4) of [Stacks, Tag 0B63]
  have hunit : IsZero (((moduleGlobalSections (exceptionalCurve S.A)).rightDerived 1).obj
      ((tensorRightModules (exceptionalCurve S.A) (curveTwistSheaf S.A (n : ℤ))).obj
        (SheafOfModules.unit (exceptionalCurve S.A).ringCatSheaf))) :=
    IsZero.of_iso (isZero_firstCohomology_curveTwistSheaf S n)
      (((moduleGlobalSections (exceptionalCurve S.A)).rightDerived 1).mapIso
        (curveTwistUnitIso S n))
  have hfree := isZero_rightDerived_tensorRightModules_free
    (curveTwistSheaf S.A (n : ℤ)) 1 G.I hunit
  -- `H²(E, -) = 0` on every module, the curve being Noetherian of dimension one
  have hker : ∀ N : (exceptionalCurve S.A).Modules,
      IsZero (((moduleGlobalSections (exceptionalCurve S.A)).rightDerived 2).obj N) := fun N =>
    Stacks.CohomologyVanishing.isZero_rightDerived_moduleGlobalSections_of_noetherianSpace_of_dim_le
      (exceptionalCurve S.A) (d := 1) (topologicalKrullDim_exceptionalCurve_le S) (by omega) N
  refine (Stacks.DerivedIndexing.isZero_rightDerivedPlus_obj_iff
    (moduleGlobalSections (exceptionalCurve S.A)) (m := (1 : ℤ)) (n := 1) rfl _).1
    (isZero_rightDerivedPlus_one_of_shortExact hS ?_ ?_)
  · exact (Stacks.DerivedIndexing.isZero_rightDerivedPlus_obj_iff
      (moduleGlobalSections (exceptionalCurve S.A)) (m := (1 : ℤ)) (n := 1) rfl _).2 hfree
  · exact (Stacks.DerivedIndexing.isZero_rightDerivedPlus_obj_iff
      (moduleGlobalSections (exceptionalCurve S.A)) (m := (2 : ℤ)) (n := 2) rfl _).2 (hker _)

end AlgebraicGeometry.BlowUpDualizing

end
