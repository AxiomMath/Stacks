open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.AlgebraicGeometry.HyperplaneTwistSequence
open Stacks.Cohomology.FormalFunctions (cohomologyDeltaFunctor cohomologyDeltaFunctor_functor)
open Stacks.Cohomology.AffineBase (moduleGlobalSections)

attribute [local instance 2000] HasDerivedCategory.standard

universe u

namespace AlgebraicGeometry.BlowUpDualizing

/-! ### The exceptional divisor is the fibre over the closed point -/

/-! ### Clause (3) -/

variable (S : RationalSingularitySituation.{u})

/-- **Clause (3) of [Stacks, Tag 0B64] for an arbitrary dualizing module on the blowup.** In
Situation [Stacks, Tag 0B4W] with `A` not regular and carrying a dualizing module `ω_A`, the
canonical map `f^*ω_A ⟶ ω_X` of [Stacks, Tag 0BBU] from the pullback of `ω_A` to a dualizing
module of the blowup of `Spec(A)` in the maximal ideal is surjective.

The generating family `G` of global sections of `ω_X|_E` lifts to global sections of `ω_X`,
because `H¹(X, ω_X(1)) = 0` by clause (2) — whose curve vanishing is itself supplied by `G`,
through `isZero_firstCohomology_curveTwist_of_generatingSections`; those lift along the
canonical map, because it is split on global sections; so the canonical map is an epimorphism
after restriction to `E`, and that suffices because `ω_X` is of finite type, `f` is proper and
`A` is local.

The source's `ω_X` is the dualizing module *normalized* relative to `ω_A`, and for that one the
datum `D` below is `AlgebraicGeometry.RationalSingularitySituation`
`.dualizingTraceSequenceOfNormalized`; the corresponding form of clause (3) is therefore
`epi_dualizingPullbackMap_of_normalized`, which specialises this theorem. -/
public theorem epi_dualizingPullbackMap
    (_hnot : ¬ IsRegularLocalRing S.A) (ωA : ModuleCat.{u} S.A)
    (hωA : Stacks.Duality.IsDualizingRingModule S.A ωA)
    (ωX : (blowUpScheme S.A).Modules)
    (hωX : letI : IsLocallyNoetherian (blowUpScheme S.A) := isLocallyNoetherian_blowUpScheme S.A
      Stacks.Duality.IsDualizingModule ωX)
    (G : SheafOfModules.GeneratingSections
      ((Scheme.Modules.pullback (exceptionalImmersion S.A)).obj ωX))
    (D : (rationalSingularitySituationBlowUp S).DualizingTraceSequence ωA ωX) :
    letI : IsLocallyNoetherian (rationalSingularitySituationBlowUp S).X :=
      isLocallyNoetherian_blowUpScheme S.A
    Epi ((rationalSingularitySituationBlowUp S).dualizingPullbackMap ωA hωA ωX hωX D) := by
  let : IsLocallyNoetherian (blowUpScheme S.A) := isLocallyNoetherian_blowUpScheme S.A
  let : IsLocallyNoetherian (rationalSingularitySituationBlowUp S).X :=
    isLocallyNoetherian_blowUpScheme S.A
  let : IsProper (blowUpToBase (centre S.A)) := isProper_blowUpToBase (centre S.A)
  have hft : ωX.IsFiniteType := hωX.1.isFiniteType
  -- the restriction sequence, with the canonical restriction map as its second map
  obtain ⟨fseq, w, hS⟩ := exists_shortExact_schemeTwist_dualizing_unit S.A ωX hωX
  -- the curve vanishing `H¹(E, (ω_X|_E)(n)) = 0`, from the global generation `G`
  have hcurve : ∀ n : ℕ, IsZero (((cohomologyDeltaFunctor (exceptionalCurve S.A)).functor 1).obj
      (curveTwist S.A ((Scheme.Modules.pullback (exceptionalImmersion S.A)).obj ωX) (n : ℤ))) :=
    fun n => isZero_firstCohomology_curveTwist_of_generatingSections S _ G n
  -- `H¹(X, ω_X(1)) = 0`, in the group-valued cohomology the long exact sequence is extracted for
  have h₂ := isZero_firstCohomology_dualizingTwist_of_restrictionVanishing S.A ωX hωX hcurve 1
  rw [Nat.cast_one] at h₂
  have hH : IsZero (Hgroup (blowUpScheme S.A).ringCatSheaf ⊤ 1 (schemeTwist S.A ωX 1)) :=
    (Stacks.Cohomology.ModuleComparison.isZero_hgroup_iff_isZero_rightDerivedPlus_evaluation
        _ ⊤ (m := (1 : ℤ)) (n := 1) (by norm_num) _).2
      ((Stacks.DerivedIndexing.isZero_rightDerived_obj_iff
        (moduleGlobalSections (blowUpScheme S.A)) 1 _).1 h₂)
  -- global sections of `ω_X` restrict onto global sections of `ω_X|_E`
  have hsurj := Stacks.SerreAffinenessCriterion.surjective_app_of_isZero_hgroup_one
    (blowUpScheme S.A) ⊤ hS hH
  -- each generator of `ω_X|_E` lifts to a global section of `f^*ω_A`, restricted to `E`
  have hlift : ∀ j : G.I, ∃ b : SheafOfModules.sections
      ((Scheme.Modules.pullback (exceptionalImmersion S.A)).obj
        ((Scheme.Modules.pullback (rationalSingularitySituationBlowUp S).f).obj (tilde ωA))),
      SheafOfModules.sectionsMap
          ((Scheme.Modules.pullback (exceptionalImmersion S.A)).map
            ((rationalSingularitySituationBlowUp S).dualizingPullbackMap ωA hωA ωX hωX D)) b =
        G.s j := by
    intro j
    obtain ⟨t, ht⟩ := Scheme.Modules.exists_restrictSections_eq
      (exceptionalImmersion S.A) ωX hsurj (G.s j)
    obtain ⟨b, hb⟩ := Scheme.Modules.exists_sections_eq_of_surjective_app_top
      ((rationalSingularitySituationBlowUp S).dualizingPullbackMap ωA hωA ωX hωX D)
      ((rationalSingularitySituationBlowUp S).surjective_appTop_dualizingPullbackMap
        ωA hωA ωX hωX D) t
    exact ⟨Scheme.Modules.restrictSections (exceptionalImmersion S.A) _ b,
      ((Scheme.Modules.sectionsMap_restrictSections (exceptionalImmersion S.A)
        ((rationalSingularitySituationBlowUp S).dualizingPullbackMap ωA hωA ωX hωX D) b).trans
          (congrArg (Scheme.Modules.restrictSections (exceptionalImmersion S.A) ωX) hb)).trans ht⟩
  choose s hs using hlift
  exact Scheme.Modules.epi_of_epi_pullback_of_range_eq_fibre
    (blowUpToBase (centre S.A)) (exceptionalImmersion S.A) (range_exceptionalImmersion S.A) _ hft
    (Scheme.Modules.epi_of_sections_lift _ G s hs)

/-- **The conclusion of clause (3) of [Stacks, Tag 0B64], from the global generation `G`.** In
Situation [Stacks, Tag 0B4W] with `A` not regular,
let `ω_A` be a dualizing module for `A` and let `ω_X` be the dualizing module of the blowup `X`
of `Spec(A)` in the maximal ideal normalized relative to `ω_A`. Then the canonical map
`f^*ω_A ⟶ ω_X` of [Stacks, Tag 0BBU] is surjective.

The normalization `N` is `AlgebraicGeometry.RationalSingularitySituation`
`.NormalizedDualizingModule`, relative duality in degree zero for the trace, and it supplies
both inputs about `ω_X` that `epi_dualizingPullbackMap` takes separately: `ω_X` is dualizing by
`N.isDualizing`, and the trace of [Stacks, Tag 0BBU] is invertible by
`AlgebraicGeometry.RationalSingularitySituation.bijective_trace_of_normalized`, so the
[Stacks, Tag 0AXD] and [Stacks, Tag 0B4S] datum that `bijective_trace` takes is produced by
`AlgebraicGeometry.RationalSingularitySituation.dualizingTraceSequenceOfNormalized`. The
canonical map therefore exists, and is the one built from the normalized trace.

Neither clause (1) nor [Stacks, Tag 0B62] is among the inputs: the curve vanishing that
clause (2) consumes is taken at the restriction `(ω_X|_E)(n)`, the module that appears in the
restriction sequence, so no module `ω_E` on `E` and no isomorphism `ω_E ≅ (ω_X|_E)(-1)` is
mentioned — and it is *proved* here, from the global generation `G`, by
`isZero_firstCohomology_curveTwist_of_generatingSections`. What is left is `G` itself, the global
generation of [Stacks, Tag 0B5H]; it does not follow from the normalization, which does not
separate `ω_X` from `ω_X(E)`, and it is in fact *equivalent* to the conclusion below, by
`AlgebraicGeometry.BlowUpDualizing.nonempty_generatingSections_restriction_iff_epi` of
`…/RationalSingularities/BlowUpDualizingGenerationEquivalence.lean`.

No `@[stacks 0B64]` attribute is attached, because `G` is an input. Clause (3) is registered,
with `G` proved from [Stacks, Tag 0B5H] at `E` through `κ̄`, on
`AlgebraicGeometry.BlowUpDualizing.epi_normalizedPullbackMap` of
`…/RationalSingularities/BlowUpNormalizedDualizingGeneration.lean`. -/
public theorem epi_dualizingPullbackMap_of_normalized
    (_hnot : ¬ IsRegularLocalRing S.A) (ωA : ModuleCat.{u} S.A)
    (hωA : Stacks.Duality.IsDualizingRingModule S.A ωA)
    (ωX : (blowUpScheme S.A).Modules)
    (N : letI : IsLocallyNoetherian (rationalSingularitySituationBlowUp S).X :=
        isLocallyNoetherian_blowUpScheme S.A
      (rationalSingularitySituationBlowUp S).NormalizedDualizingModule ωA ωX)
    (G : SheafOfModules.GeneratingSections
      ((Scheme.Modules.pullback (exceptionalImmersion S.A)).obj ωX)) :
    letI : IsLocallyNoetherian (rationalSingularitySituationBlowUp S).X :=
      isLocallyNoetherian_blowUpScheme S.A
    Epi ((rationalSingularitySituationBlowUp S).dualizingPullbackMap ωA hωA ωX N.isDualizing
      ((rationalSingularitySituationBlowUp S).dualizingTraceSequenceOfNormalized N)) := by
  let : IsLocallyNoetherian (rationalSingularitySituationBlowUp S).X :=
    isLocallyNoetherian_blowUpScheme S.A
  exact epi_dualizingPullbackMap S _hnot ωA hωA ωX N.isDualizing G
    ((rationalSingularitySituationBlowUp S).dualizingTraceSequenceOfNormalized N)

end AlgebraicGeometry.BlowUpDualizing

end
