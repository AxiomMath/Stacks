/-!
# Global generation of the restricted dualizing module on the exceptional curve

In Situation [Stacks, Tag 0B4W] let `f : X ⟶ Spec(A)` be the blowup in the maximal ideal, let
`i : E ⟶ X` be its exceptional divisor and let `ω_X` be the dualizing module of `X`. The input `G`
of [Stacks, Tag 0B64] clause (3), which asserts that the canonical map `f^*ω_A ⟶ ω_X` is
surjective, is global generation of `ω_X|_E`, which is [Stacks, Tag 0B5H] applied to the curve `E`
over the residue field `κ`.

This file proves that `ω_X|_E` is generated by its global sections for any coherent `𝒪_X`-module
`ω_X` and any `𝒪_E`-module `ω_E` with `ω_E ≅ (ω_X|_E)(-1)`, as in clause (1) of [Stacks, Tag 0B64],
given the inputs of [Stacks, Tag 0B5H] for `ω_E` and `ℒ = 𝒪_E(1)` in Situation [Stacks, Tag 0B5D]
at `E`: duality for `ω_E` (`hdual`), `dim_κ H¹(E, ω_E) = 1` (`hone`), the absence of nonzero
coherent submodules of `ω_E ⊗ 𝒪_E(1)` supported in dimension zero (`hnosub`), `deg 𝒪_E(1) ≥ 2`
(`hd`), and a vanishing-section presentation at every closed point of `E` (`hsec`).

## Main results

* `AlgebraicGeometry.BlowUpDualizing.nonempty_generatingSections_restriction_of_dualityInputs`:
  `ω_X|_E` is generated by its global sections, given the inputs of [Stacks, Tag 0B5H] at `E`.

## Implementation notes

No hypothesis is placed on the residue field `κ`. Over a residue field that is not algebraically
closed `hsec` can fail while the other four inputs hold: for `A = ℚ[x, y, z]/(xz - y²)` localized
at `(x, y, z)` and `ω_X = 𝒪_X`, the curve `E` is `ℙ¹_ℚ` with `𝒪_E(1) = 𝒪_{ℙ¹}(2)`, and there is no
presentation at a closed point of degree three.

## References

* [Stacks Project, Tag 0B4W](https://stacks.math.columbia.edu/tag/0B4W)
* [Stacks Project, Tag 0B5D](https://stacks.math.columbia.edu/tag/0B5D)
* [Stacks Project, Tag 0B5H](https://stacks.math.columbia.edu/tag/0B5H)
* [Stacks Project, Tag 0B64](https://stacks.math.columbia.edu/tag/0B64)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace AlgebraicGeometry.BlowUpDualizing

/-! ### Global generation of the restriction of the dualizing module -/

/-- **`𝒪_E(n)` is invertible** as a module over the structure sheaf of the exceptional curve, in
the form of Situation [Stacks, Tag 0B5D] given by
`AlgebraicGeometry.cohenMacaulayCurveSituationExceptionalDivisor`. -/
local instance isInvertible_curveTwistSheaf_situation
    (S : RationalSingularitySituation.{u}) (n : ℤ) :
    SheafOfModules.IsInvertible
      (cohenMacaulayCurveSituationExceptionalDivisor S).X.presheaf
      (cohenMacaulayCurveSituationExceptionalDivisor S).X.ringCatSheaf.2
      (curveTwistSheaf S.A n) :=
  (inferInstance :
    Stacks.Ample.IsInvertibleModule (exceptionalCurve S.A) (curveTwistSheaf S.A n))

variable (S : RationalSingularitySituation.{u})

/-- **`ω_X|_E` is generated by its global sections**, which is the input `G` of clause (3) of
[Stacks, Tag 0B64]. Here `ω_X` is a coherent `𝒪_X`-module and `ω_E` an `𝒪_E`-module with
`ω_E ≅ (ω_X|_E)(-1)` (the hypothesis `e`, as in clause (1) of [Stacks, Tag 0B64]), and the other
hypotheses are the inputs of [Stacks, Tag 0B5H] for `ω_E` and `𝒪_E(1)` at the exceptional curve:
duality for `ω_E` (`hdual`), `dim_κ H¹(E, ω_E) = 1` (`hone`), the absence of nonzero coherent
submodules of `ω_E ⊗ 𝒪_E(1)` supported in dimension zero (`hnosub`), `deg 𝒪_E(1) ≥ 2` (`hd`), and a
vanishing-section presentation at every closed point (`hsec`). No hypothesis is placed on the
residue field. -/
public theorem nonempty_generatingSections_restriction_of_dualityInputs
    (ωX : (blowUpScheme S.A).Modules) (ωE : (exceptionalCurve S.A).Modules)
    (hωX : ωX.IsCoherent)
    (e : ωE ≅ curveTwist S.A
      ((Scheme.Modules.pullback (exceptionalImmersion S.A)).obj ωX) (-1))
    (hdual : (cohenMacaulayCurveSituationExceptionalDivisor S).FirstCohomologyDuality ωE)
    (hone : Module.finrank (cohenMacaulayCurveSituationExceptionalDivisor S).k
      (cohomologyOverField (cohenMacaulayCurveSituationExceptionalDivisor S).k
        (cohenMacaulayCurveSituationExceptionalDivisor S).f ωE 1) = 1)
    (hnosub :
      (cohenMacaulayCurveSituationExceptionalDivisor S).NoCoherentSubmoduleOfZeroDimensionalSupport
        (curveTwist S.A ωE 1))
    (hd : 2 ≤ invertibleCurveDegree (cohenMacaulayCurveSituationExceptionalDivisor S).k
      (cohenMacaulayCurveSituationExceptionalDivisor S).f
      (le_of_eq (cohenMacaulayCurveSituationExceptionalDivisor S).dimension_one)
      (curveTwistSheaf S.A 1))
    (hsec : ∀ x : exceptionalCurve S.A, IsClosed ({x} : Set (exceptionalCurve S.A)) →
      (cohenMacaulayCurveSituationExceptionalDivisor S).VanishingSectionPresentation ωE
        (curveTwist S.A ωE 1)
        (invertibleCurveDegree (cohenMacaulayCurveSituationExceptionalDivisor S).k
          (cohenMacaulayCurveSituationExceptionalDivisor S).f
          (le_of_eq (cohenMacaulayCurveSituationExceptionalDivisor S).dimension_one)
          (curveTwistSheaf S.A 1)) x) :
    Nonempty ((Scheme.Modules.pullback (exceptionalImmersion S.A)).obj ωX).GeneratingSections := by
  let : IsLocallyNoetherian (exceptionalCurve S.A) := isLocallyNoetherian_exceptionalCurve S.A
  let := hωX
  obtain ⟨g⟩ := nonempty_pullback_dualizing_iso_curveTwist e
  have hPc : ((Scheme.Modules.pullback (exceptionalImmersion S.A)).obj ωX).IsCoherent :=
    isCoherent_pullback (exceptionalImmersion S.A) ωX
  let := hPc
  have hPft : ((Scheme.Modules.pullback (exceptionalImmersion S.A)).obj ωX).IsFiniteType :=
    hPc.isFiniteType
  have hωq : ωE.IsQuasicoherent :=
    Stacks.AlgebraicGeometry.PerfectCohomology.isQuasicoherent_of_iso e.symm
      (isQuasicoherent_curveTwist_pullback S.A ωX hωX (-1))
  have hFq : (curveTwist S.A ωE 1).IsQuasicoherent :=
    @AlgebraicGeometry.tensorSheaf_isQuasicoherent (exceptionalCurve S.A).toRingedSpace _ _ hωq
      (Stacks.AmpleGlobalGeneration.isQuasicoherent_tensorPowModule (curveTwistNegOne S.A) (-1))
  have hFft : (curveTwist S.A ωE 1).IsFiniteType :=
    Stacks.Coherent.isFiniteType_of_iso_local g hPft
  obtain ⟨G⟩ := CohenMacaulayCurveSituation.nonempty_generatingSections_tensorSheaf_of_presentation
    (S := cohenMacaulayCurveSituationExceptionalDivisor S) ωE (curveTwistSheaf S.A 1) hωq hdual
    hone hFq hFft hnosub hd hsec
  exact ⟨SheafOfModules.GeneratingSections.equivOfIso g.symm G⟩

end AlgebraicGeometry.BlowUpDualizing

end
