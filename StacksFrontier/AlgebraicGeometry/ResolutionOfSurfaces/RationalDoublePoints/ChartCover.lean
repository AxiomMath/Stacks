module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ChartEmbeddingDimension

/-!
# The closed points of the blowup of a local ring, in the standard charts

Let `A` be a local ring with maximal ideal generated by `x₁, x₂, x₃`, written over
`Γ = Γ(Spec A, ⊤) ≅ A`. Every closed point `w` of the blowup of `Spec(A)` in its maximal ideal
lying over the closed point lies in one of the three standard charts `Spec Γ[𝔪/xⱼ]`, at a maximal
ideal containing `xⱼ`, and the local ring at `w` is the localization of the chart ring there.

## Main results

* `AlgebraicGeometry.maximalIdealSheaf_ideal_top`: the sections of the maximal ideal sheaf over
  `Spec(A)` are the maximal ideal of `Γ`.
* `AlgebraicGeometry.exists_chart_of_isClosed`: the chart description of a closed point.
-/

@[expose] public noncomputable section

open CategoryTheory IsLocalRing

universe u

namespace AlgebraicGeometry

variable (A : Type u) [CommRing A] [IsLocalRing A]

/-- The global sections of `Spec A` form a local ring. -/
instance isLocalRing_ΓSpec_top : IsLocalRing Γ(Spec (.of A), ⊤) :=
  haveI : Nontrivial Γ(Spec (.of A), ⊤) :=
    (Scheme.ΓSpecIso (.of A)).symm.commRingCatIsoToRingEquiv.injective.nontrivial
  IsLocalRing.of_surjective' ((Scheme.ΓSpecIso (.of A)).symm.commRingCatIsoToRingEquiv :
    A →+* Γ(Spec (.of A), ⊤)) (RingEquiv.surjective _)

/-- The affine open `⊤` of `Spec(A)`. -/
abbrev topAffineOpen : (Spec (.of A)).affineOpens := ⟨⊤, isAffineOpen_top _⟩

/-- The sections of the maximal ideal sheaf over all of `Spec(A)` are the maximal ideal of the
global sections. -/
theorem maximalIdealSheaf_ideal_top :
    (maximalIdealSheaf A).ideal (topAffineOpen A) = maximalIdeal Γ(Spec (.of A), ⊤) := by
  simp only [topAffineOpen, maximalIdealSheaf, Scheme.IdealSheafData.ofIdealTop_ideal,
    homOfLE_refl, CategoryTheory.op_id, CategoryTheory.Functor.map_id, CommRingCat.hom_id,
    Ideal.map_id]
  exact IsLocalRing.map_ringEquiv_maximalIdeal
    (Scheme.ΓSpecIso (.of A)).symm.commRingCatIsoToRingEquiv

/-- **A closed point of the blowup over the closed point, in a standard chart.** -/
theorem exists_chart_of_isClosed (x : Fin 3 → Γ(Spec (.of A), ⊤))
    (hspan : Ideal.span (Set.range x) = maximalIdeal Γ(Spec (.of A), ⊤))
    (w : blowUp (maximalIdealSheaf A)) (hw : IsClosed ({w} : Set (blowUp (maximalIdealSheaf A))))
    (hwo : blowUpToBase (maximalIdealSheaf A) w = closedPoint A) :
    ∃ (j : Fin 3) (hj : x j ∈ (maximalIdealSheaf A).ideal (topAffineOpen A))
      (y : Spec (.of (blowupChartRing (maximalIdealSheaf A) (topAffineOpen A) ⟨x j, hj⟩))),
      y.asIdeal.IsMaximal ∧
      algebraMap Γ(Spec (.of A), ⊤)
        (blowupChartRing (maximalIdealSheaf A) (topAffineOpen A) ⟨x j, hj⟩) (x j) ∈ y.asIdeal ∧
      Nonempty ((blowUp (maximalIdealSheaf A)).presheaf.stalk w ≃+*
        (Spec (.of (blowupChartRing (maximalIdealSheaf A) (topAffineOpen A)
          ⟨x j, hj⟩))).presheaf.stalk y) := by
  have hIU := maximalIdealSheaf_ideal_top A
  have hg : ∀ i, x i ∈ (maximalIdealSheaf A).ideal (topAffineOpen A) := fun i => by
    rw [hIU, ← hspan]
    exact Ideal.subset_span ⟨i, rfl⟩
  obtain ⟨j, y, rfl⟩ := exists_mem_range_blowupChartι (maximalIdealSheaf A) (topAffineOpen A) x
    hg (by rw [hIU, hspan]) w (by trivial)
  refine ⟨j, hg j, y, ?_, ?_, ?_⟩
  · refine (PrimeSpectrum.isClosed_singleton_iff_isMaximal y).mp ?_
    have hset : ({y} : Set _) =
        (blowupChartι (maximalIdealSheaf A) (topAffineOpen A) ⟨x j, hg j⟩).base ⁻¹'
        {blowupChartι (maximalIdealSheaf A) (topAffineOpen A) ⟨x j, hg j⟩ y} := by
      ext t
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      exact ⟨fun h => h ▸ rfl, fun h =>
        (blowupChartι (maximalIdealSheaf A) (topAffineOpen A)
          ⟨x j, hg j⟩).isOpenEmbedding.injective h⟩
    have := hw.preimage
      (blowupChartι (maximalIdealSheaf A) (topAffineOpen A) ⟨x j, hg j⟩).continuous
    rwa [← hset] at this
  · have hb := blowUpToBase_blowupChartι (I := maximalIdealSheaf A) (U := topAffineOpen A)
      (a := ⟨x j, hg j⟩) y
    rw [hwo] at hb
    have hc := congrArg PrimeSpectrum.asIdeal hb
    simp only [topAffineOpen, IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv] at hc
    let ε : Γ(Spec (.of A), ⊤) ≃+* A := (Scheme.ΓSpecIso (.of A)).commRingCatIsoToRingEquiv
    have : IsLocalHom (ε : Γ(Spec (.of A), ⊤) →+* A) := IsLocalHom.of_surjective _ ε.surjective
    have hxj : ε (x j) ∈ (closedPoint A).asIdeal :=
      map_nonunit (ε : Γ(Spec (.of A), ⊤) →+* A) (x j) (hspan ▸ Ideal.subset_span ⟨j, rfl⟩)
    rw [hc] at hxj
    have hinv : (Scheme.ΓSpecIso (.of A)).inv.hom (ε (x j)) = x j := by
      show ((Scheme.ΓSpecIso (.of A)).hom ≫ (Scheme.ΓSpecIso (.of A)).inv).hom (x j) = x j
      rw [Iso.hom_inv_id]
      rfl
    have h2 : (Scheme.ΓSpecIso (.of A)).inv.hom (ε (x j)) ∈ Ideal.comap _ y.asIdeal := hxj
    rwa [hinv] at h2
  · exact ⟨(asIso ((blowupChartι (maximalIdealSheaf A) (topAffineOpen A)
      ⟨x j, hg j⟩).stalkMap y)).commRingCatIsoToRingEquiv⟩

end AlgebraicGeometry

end
