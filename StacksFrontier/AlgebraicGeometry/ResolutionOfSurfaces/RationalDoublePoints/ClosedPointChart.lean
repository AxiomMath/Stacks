module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.BlowUpCompletedLocalRings
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ChartPoint
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ChartPointGenerators
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ChartRingSpec

/-!
# Closed points of the blowup of a local ring in its maximal ideal, read on a chart

Let `(A, 𝔪)` be a Noetherian local ring with `𝔪 = (x₁, x₂, x₃)`, and let `X` be the blowup of
`Spec A` in `𝔪`. Every closed point `q` of `X` lies on one of the three standard charts: after
reordering the generators, there is a maximal ideal `𝔪'` of `A' = A[𝔪/x₁]` containing `𝔪A'`
whose local ring is the local ring of `X` at `q`. Consequently the maximal ideal of `𝒪_{X, q}`
is generated by three elements.

## Main results

* `AlgebraicGeometry.blowUpToBase_eq_closedPoint_of_isClosed`: a closed point of `X` lies over
  the closed point of `Spec A`.
* `AlgebraicGeometry.exists_isMaximal_ringEquiv_stalk_blowUp_maximalIdealSheaf`: the closed
  point read on a chart.
* `AlgebraicGeometry.spanFinrank_maximalIdeal_stalk_blowUp_le_three`: the maximal ideal of the
  local ring at a closed point is generated by three elements.

## References

* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
* [Stacks Project, Tag 0804](https://stacks.math.columbia.edu/tag/0804)
-/

@[expose] public noncomputable section

open CategoryTheory IsLocalRing

universe u

namespace AlgebraicGeometry

variable (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]

/-- A closed point of the blowup of `Spec A` in the maximal ideal lies over the closed point of
`Spec A`. -/
theorem blowUpToBase_eq_closedPoint_of_isClosed (q : blowUp (maximalIdealSheaf A))
    (hq : IsClosed ({q} : Set (blowUp (maximalIdealSheaf A)))) :
    (blowUpToBase (maximalIdealSheaf A)).base q = closedPoint A := by
  have himage : IsClosed ((blowUpToBase (maximalIdealSheaf A)).base ''
      ({q} : Set (blowUp (maximalIdealSheaf A)))) :=
    Scheme.Hom.isClosedMap (blowUpToBase (maximalIdealSheaf A)) _ hq
  have hsingleton : IsClosed
      ({(blowUpToBase (maximalIdealSheaf A)).base q} : Set (Spec (.of A))) := by
    simpa using himage
  exact PrimeSpectrum.ext (eq_maximalIdeal
    ((PrimeSpectrum.isClosed_singleton_iff_isMaximal _).mp hsingleton))

/-- A point of an affine open subscheme `Spec C ⟶ X` whose image is a closed point of `X` is a
maximal ideal of `C`, and the local ring of `X` there is the localization of `C`. -/
theorem isMaximal_and_nonempty_ringEquiv_of_isOpenImmersion {X : Scheme.{u}} {C : CommRingCat.{u}}
    (ι : Spec C ⟶ X) [IsOpenImmersion ι] (z : Spec C) (hz : IsClosed ({ι z} : Set X)) :
    z.asIdeal.IsMaximal ∧ ∃ _ : z.asIdeal.IsPrime,
      Nonempty (X.presheaf.stalk (ι z) ≃+* Localization.AtPrime z.asIdeal) := by
  refine ⟨(PrimeSpectrum.isClosed_singleton_iff_isMaximal z).mp ?_, z.2, ?_⟩
  · have hpre : ({z} : Set (Spec C)) = ι.base ⁻¹' {ι z} := by
      ext w
      simp only [Set.mem_singleton_iff, Set.mem_preimage]
      exact ⟨fun h => h ▸ rfl, fun h => ι.isOpenEmbedding.injective h⟩
    exact (hpre ▸ hz.preimage ι.continuous : IsClosed ({z} : Set (Spec C)))
  · exact ⟨(asIso (ι.stalkMap z)).commRingCatIsoToRingEquiv.trans
      (Spec.stalkIso C z).commRingCatIsoToRingEquiv⟩

/-- Let `ι : Spec C ⟶ X` be an affine open subscheme of the blowup lying over the whole of
`Spec A`, given with an isomorphism of `C` with the affine blowup algebra `A[𝔪/b]` compatible with
the maps from `A`. The local ring of the blowup at a closed point of `Spec C` is the localization
of `A[𝔪/b]` at a maximal ideal containing `𝔪A[𝔪/b]`. -/
theorem exists_isMaximal_ringEquiv_stalk_of_chart {C : CommRingCat.{u}}
    (ι : Spec C ⟶ blowUp (maximalIdealSheaf A)) [IsOpenImmersion ι]
    (φ : Γ(Spec (.of A), ⊤) ⟶ C)
    (hι : ι ≫ blowUpToBase (maximalIdealSheaf A) =
      Spec.map φ ≫ (isAffineOpen_top (Spec (.of A))).fromSpec)
    (b : A) (E : affineBlowupAlgebra (maximalIdeal A) b (Localization.Away b) ≃+* C)
    (hE : ∀ r : A, E (algebraMap A _ r) = φ ((Scheme.ΓSpecIso (.of A)).inv.hom r))
    (z : Spec C) (hq : IsClosed ({ι z} : Set (blowUp (maximalIdealSheaf A)))) :
    ∃ M : Ideal (affineBlowupAlgebra (maximalIdeal A) b (Localization.Away b)),
      M.IsMaximal ∧
      Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) b (Localization.Away b)))
        (maximalIdeal A) ≤ M ∧
      ∃ _ : M.IsPrime,
        Nonempty ((blowUp (maximalIdealSheaf A)).presheaf.stalk (ι z) ≃+*
          Localization.AtPrime M) := by
  have hbase := blowUpToBase_eq_closedPoint_of_isClosed A _ hq
  obtain ⟨hzmax, hzprime, ⟨e⟩⟩ := isMaximal_and_nonempty_ringEquiv_of_isOpenImmersion ι z hq
  refine ⟨z.asIdeal.comap E.toRingHom, Ideal.comap_isMaximal_of_surjective _ E.surjective, ?_,
    (Ideal.comap_isMaximal_of_surjective _ E.surjective).isPrime,
    ⟨e.trans (Localization.localRingEquiv _ z.asIdeal E rfl).symm⟩⟩
  have hz : (blowUpToBase (maximalIdealSheaf A)).base (ι z) =
      (isAffineOpen_top (Spec (.of A))).fromSpec (Spec.map φ z) := by
    have h := congrArg (fun f => f z) hι
    rwa [Scheme.Hom.comp_apply, Scheme.Hom.comp_apply] at h
  rw [hz, IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv] at hbase
  have hcomap := congrArg PrimeSpectrum.asIdeal hbase
  rw [Ideal.map_le_iff_le_comap]
  intro r hr
  have hr' : r ∈ (closedPoint A).asIdeal := hr
  rw [← hcomap] at hr'
  show E (algebraMap A _ r) ∈ z.asIdeal
  rw [hE r]
  exact hr'

/-- A closed point of the blowup of `Spec A` in `𝔪 = (x₁, x₂, x₃)`, read on a chart: after
reordering the generators, the local ring at a closed point is the localization of the affine
blowup algebra `A[𝔪/x₁]` at a maximal ideal containing `𝔪A[𝔪/x₁]`. -/
theorem exists_isMaximal_ringEquiv_stalk_blowUp_maximalIdealSheaf (x : Fin 3 → A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A) (q : blowUp (maximalIdealSheaf A))
    (hq : IsClosed ({q} : Set (blowUp (maximalIdealSheaf A)))) :
    ∃ x' : Fin 3 → A, (∃ σ : Equiv.Perm (Fin 3), x' = x ∘ σ) ∧
      ∃ M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x' 0) (Localization.Away (x' 0))),
      M.IsMaximal ∧
      Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x' 0)
        (Localization.Away (x' 0)))) (maximalIdeal A) ≤ M ∧
      ∃ _ : M.IsPrime,
        Nonempty ((blowUp (maximalIdealSheaf A)).presheaf.stalk q ≃+*
          Localization.AtPrime M) := by
  classical
  let U : (Spec (.of A)).affineOpens := ⟨⊤, isAffineOpen_top _⟩
  let ψ : A →+* Γ(Spec (.of A), ⊤) := (Scheme.ΓSpecIso (.of A)).inv.hom
  have hx : ∀ i, x i ∈ maximalIdeal A := fun i => hspan ▸ Ideal.subset_span ⟨i, rfl⟩
  have hg : ∀ j, ψ (x j) ∈ (maximalIdealSheaf A).ideal U := fun j =>
    mem_ideal_ofIdealTop_isAffineOpen_top A (maximalIdeal A) (hx j)
  have hIU : (maximalIdealSheaf A).ideal U = (maximalIdeal A).map ψ := by
    simp [U, ψ, maximalIdealSheaf]
  have hspanI : ((maximalIdealSheaf A).ideal U : Ideal Γ(Spec (.of A), U.1)) ≤
      Ideal.span (Set.range fun j => ψ (x j)) := by
    rw [hIU, ← hspan, Ideal.map_span, ← Set.range_comp]
    rfl
  obtain ⟨j, z, hz⟩ := exists_mem_range_blowupChartι (maximalIdealSheaf A) U
    (fun j => ψ (x j)) hg hspanI q trivial
  have hσ : x (Equiv.swap 0 j 0) = x j := by rw [Equiv.swap_apply_left]
  obtain ⟨E, hE⟩ := exists_ringEquiv_blowupChartRing_ofIdealTop A (maximalIdeal A)
    (x (Equiv.swap 0 j 0)) ⟨ψ (x j), hg j⟩ (by rw [hσ])
  subst hz
  exact ⟨x ∘ Equiv.swap 0 j, ⟨_, rfl⟩, exists_isMaximal_ringEquiv_stalk_of_chart A _ _
    (blowupChartι_comp_blowUpToBase (maximalIdealSheaf A) U ⟨ψ (x j), hg j⟩) _ E hE z hq⟩

/-- The maximal ideal of the local ring at a closed point of the blowup of `Spec A` in
`𝔪 = (x₁, x₂, x₃)` is generated by three elements. -/
theorem spanFinrank_maximalIdeal_stalk_blowUp_le_three (x : Fin 3 → A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A) (q : blowUp (maximalIdealSheaf A))
    (hq : IsClosed ({q} : Set (blowUp (maximalIdealSheaf A)))) :
    (maximalIdeal ((blowUp (maximalIdealSheaf A)).presheaf.stalk q)).spanFinrank ≤ 3 := by
  classical
  obtain ⟨x', ⟨σ, rfl⟩, M, hM, hle, hprime, ⟨e⟩⟩ :=
    exists_isMaximal_ringEquiv_stalk_blowUp_maximalIdealSheaf A x hspan q hq
  have hspanσ : Ideal.span (Set.range (x ∘ σ)) = maximalIdeal A := by
    rw [Set.range_comp, Equiv.range_eq_univ, Set.image_univ, hspan]
  obtain ⟨g, hg⟩ := exists_span_eq_of_isMaximal_affineBlowupAlgebra (x := x ∘ σ)
    (Localization.Away ((x ∘ σ) 0)) (fun i => hspanσ ▸ Ideal.subset_span ⟨i, rfl⟩) hspanσ M hle
  have hloc : maximalIdeal (Localization.AtPrime M) =
      Ideal.span (Set.range (algebraMap _ (Localization.AtPrime M) ∘ g)) := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal,
      congrArg (Ideal.map (algebraMap _ (Localization.AtPrime M))) hg.symm, Ideal.map_span,
      Set.range_comp]
  have hfg : (maximalIdeal (Localization.AtPrime M)).FG :=
    hloc ▸ Submodule.fg_span (Set.finite_range _)
  have hmap : maximalIdeal ((blowUp (maximalIdealSheaf A)).presheaf.stalk q) =
      (maximalIdeal (Localization.AtPrime M)).map e.symm.toRingHom :=
    (map_ringEquiv_maximalIdeal e.symm).symm
  rw [hmap]
  refine (Ideal.spanFinrank_map_le_of_fg _ hfg).trans ?_
  rw [hloc]
  refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_range _)).trans ?_
  rw [← Set.image_univ, ← Finset.coe_univ, ← Finset.coe_image, Set.ncard_coe_finset]
  exact Finset.card_image_le.trans (by simp)

end AlgebraicGeometry

end
