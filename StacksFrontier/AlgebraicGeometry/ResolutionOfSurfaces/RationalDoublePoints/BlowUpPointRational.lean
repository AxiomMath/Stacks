/-!
# The local information on the blowup of a rational double point

Let `A` be the ring of a Situation [Stacks, Tag 0BGC] and `X` the blowup of `Spec(A)` in its
maximal ideal. At a closed point `x` of `X` the local ring `𝒪_{X, x}` defines a rational
singularity by [Stacks, Tag 0BG0]
(`AlgebraicGeometry.RationalDoublePointSituation.definesRationalSingularity_stalk_blowUp`). This
file assembles from it, and from the embedding dimension at the singular points, the local
information `AlgebraicGeometry.RationalDoublePointBlowUpProperties` on the blowup.

## Main results

* `AlgebraicGeometry.rationalDoublePointBlowUpProperties_of_spanFinrank`: the local information
  on the blowup, if the maximal ideal at each of its singular points is generated by three
  elements.
* `AlgebraicGeometry.rationalDoublePointBlowUpProperties_of_exists_span`: the local information on
  the blowup, if the maximal ideal of every rational double point is generated by three elements.
-/

@[expose] public noncomputable section

open CategoryTheory IsLocalRing

universe u

namespace AlgebraicGeometry

/-- **The local information on the blowup of a rational double point, from the embedding
dimension at its singular points.** If at every singular point of the blowup of a rational double
point in its maximal ideal the maximal ideal is generated by three elements, then the blowup is
normal with finitely many singular points, each closed, over the closed point, and a rational
double point again. -/
theorem rationalDoublePointBlowUpProperties_of_spanFinrank
    (hgen : ∀ (S : RationalDoublePointSituation.{u}) (x : blowUp (maximalIdealSheaf S.A)),
      x ∈ singularLocus (blowUp (maximalIdealSheaf S.A)) →
        (maximalIdeal ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk x)).spanFinrank ≤ 3) :
    RationalDoublePointBlowUpProperties.{u} := by
  intro S
  refine ⟨S.isNormal_blowUp, S.finite_singularLocus_blowUp, fun x hx => ?_⟩
  have hxc := S.isClosed_singleton_of_mem_singularLocus_blowUp x hx
  exact ⟨hxc, S.blowUpToBase_eq_closedPoint_of_mem_singularLocus x hx,
    S.blowUpSituationOfSpanFinrank x hxc
    (S.definesRationalSingularity_stalk_blowUp x hxc) (hgen S x hx) hx,
    ⟨RingEquiv.refl _⟩⟩

/-- **The local information on the blowup of a rational double point, from the embedding
dimension of rational double points.** If the maximal ideal of every rational double point is
generated by three elements, then the blowup of every rational double point in its maximal ideal
is normal with finitely many singular points, each closed, over the closed point, and a rational
double point again. -/
theorem rationalDoublePointBlowUpProperties_of_exists_span
    (h3 : ∀ S : RationalDoublePointSituation.{u}, ∃ x : Fin 3 → S.A,
      Ideal.span (Set.range x) = maximalIdeal S.A) :
    RationalDoublePointBlowUpProperties.{u} :=
  rationalDoublePointBlowUpProperties_of_spanFinrank fun S w hw => by
    obtain ⟨x, hx⟩ := h3 S
    exact spanFinrank_maximalIdeal_stalk_blowUp_le_three S.A x hx w
      (S.isClosed_singleton_of_mem_singularLocus_blowUp w hw)

end AlgebraicGeometry

end
