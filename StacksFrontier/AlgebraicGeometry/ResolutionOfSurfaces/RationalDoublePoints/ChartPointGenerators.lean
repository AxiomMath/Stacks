module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ChartPresentation
public import StacksFrontier.RingTheory.MvPolynomial.MaximalIdeal

/-!
# Generators of the maximal ideal at a point of a blowup chart

Let `(A, 𝔪, κ)` be a local ring whose maximal ideal is generated by `x₁, x₂, x₃`, and let
`A' = A[𝔪/x₁]` be the affine blowup algebra. A maximal ideal `𝔪'` of `A'` lying over `𝔪` is
generated by three elements: `x₁` and two lifts of generators of the corresponding maximal ideal
of `κ[y₂, y₃]`, through the surjection `κ[y₂, y₃] ↠ A'/x₁A'`. This is the equality
`𝔪' = (x₁, z₂, z₃)` of Section 54.12 of the Stacks project; it uses that a maximal ideal of a
polynomial ring in two variables over a field is generated by two elements ([Stacks, Tag 00OP]).

## Main results

* `AlgebraicGeometry.exists_span_eq_of_isMaximal_affineBlowupAlgebra`: a maximal ideal of the
  chart containing `𝔪A'` is generated by three elements.

## References

* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
* [Stacks Project, Tag 00OP](https://stacks.math.columbia.edu/tag/00OP)
-/

@[expose] public noncomputable section

open IsLocalRing

universe u

namespace AlgebraicGeometry

variable {A : Type u} [CommRing A] [IsLocalRing A] {x : Fin 3 → A}
  (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away (x 0) S]

/-- If `x₁, x₂, x₃` generate the maximal ideal of `A` and `𝔪'` is a maximal ideal of
`A' = A[𝔪/x₁]` containing `𝔪A'`, then `𝔪' = (x₁, z₂, z₃)` for two elements `z₂, z₃` of `A'`
lifting generators of the maximal ideal of `κ[y₂, y₃]` which `𝔪'` defines. -/
theorem exists_span_eq_of_isMaximal_affineBlowupAlgebra (hx : ∀ i, x i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S)) [hM : M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S))
      (maximalIdeal A) ≤ M) :
    ∃ g : Fin 3 → affineBlowupAlgebra (maximalIdeal A) (x 0) S,
      Ideal.span (Set.range g) = M := by
  classical
  let B := affineBlowupAlgebra (maximalIdeal A) (x 0) S
  let K : Ideal B := Ideal.span {algebraMap A B (x 0)}
  let πQ : B →+* chartExceptionalQuotient (maximalIdeal A) (x 0) S := Ideal.Quotient.mk K
  have hπQ : Function.Surjective πQ := Ideal.Quotient.mk_surjective
  have hx0 : algebraMap A B (x 0) ∈ M := hle (Ideal.mem_map_of_mem _ (hx 0))
  have hker : RingHom.ker πQ ≤ M := by
    rw [Ideal.mk_ker]
    exact (Ideal.span_singleton_le_iff_mem M).mpr hx0
  let φ := chartPresentation S hx
  have hφ : Function.Surjective φ := chartPresentation_surjective S hx hspan
  have hcomap : (M.map πQ).comap πQ = M := by
    rw [Ideal.comap_map_of_surjective _ hπQ,
      sup_eq_left.mpr (by rw [← RingHom.ker_eq_comap_bot]; exact hker)]
  have hMbar : (M.map πQ).IsMaximal := by
    refine (Ideal.map_eq_top_or_isMaximal_of_surjective πQ hπQ hM).resolve_left fun htop => ?_
    rw [htop, Ideal.comap_top] at hcomap
    exact hM.ne_top hcomap.symm
  have hN : ((M.map πQ).comap φ).IsMaximal := Ideal.comap_isMaximal_of_surjective φ hφ
  obtain ⟨h, hh⟩ := maximal_ideal_generated_by_n 2 _ hN
  choose z hz using fun i => hπQ (φ (h i))
  refine ⟨![algebraMap A B (x 0), z 0, z 1], le_antisymm ?_ ?_⟩
  · rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    have hzM : ∀ i, z i ∈ M := by
      intro i
      have hmem : πQ (z i) ∈ M.map πQ := by
        rw [hz i]
        exact (hh ▸ Ideal.subset_span ⟨i, rfl⟩ : h i ∈ (M.map πQ).comap φ)
      rwa [← Ideal.mem_comap, hcomap] at hmem
    fin_cases i
    exacts [hx0, hzM 0, hzM 1]
  · intro m hm
    have hmbar : πQ m ∈ Ideal.map πQ (Ideal.span (Set.range z)) := by
      have h1 : πQ m ∈ M.map πQ := Ideal.mem_map_of_mem _ hm
      rw [← Ideal.map_comap_of_surjective φ hφ (M.map πQ), ← hh, Ideal.map_span] at h1
      rw [Ideal.map_span, ← Set.range_comp]
      convert h1 using 2
      rw [← Set.range_comp]
      exact congrArg Set.range (funext hz)
    rw [← Ideal.mem_comap, Ideal.comap_map_of_surjective _ hπQ, ← RingHom.ker_eq_comap_bot,
      Ideal.mk_ker, Submodule.mem_sup] at hmbar
    obtain ⟨u, hu, v, hv, rfl⟩ := hmbar
    refine Ideal.add_mem _ ?_ ?_
    · refine Ideal.span_mono ?_ hu
      rintro _ ⟨i, rfl⟩
      fin_cases i
      exacts [⟨1, rfl⟩, ⟨2, rfl⟩]
    · obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp hv
      exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨0, rfl⟩)

end AlgebraicGeometry

end
