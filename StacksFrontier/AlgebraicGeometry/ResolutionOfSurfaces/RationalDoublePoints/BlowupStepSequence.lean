module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.FormalArcs.Termination
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.FormalArcs.PointBlowupsExtra

/-!
# A sequence of point blowups built from a rule for choosing the next centre

The termination result
`AlgebraicGeometry.exists_isRegularLocalRing_stalk_point_of_pointBlowupSequence` consumes an
infinite `AlgebraicGeometry.PointBlowupSequence` together with the hypothesis that the
exceptional divisor of every stage is cut out by the successive images of one element of the
local ring at the initial centre. This file builds such a sequence, with that hypothesis, out of
a rule which chooses the next centre one stage at a time, and reads the termination result back
as a statement about the rule. For a rule, the exceptional-divisor hypothesis is a condition on a
single blowup: the extension of the maximal ideal of the centre to the local ring at the chosen
point above it is generated by the image of the chosen element.

## Main definitions

* `AlgebraicGeometry.PointBlowupStage` is one stage: a scheme, the closed point to be blown up,
  an element of the local ring there, and a property carried along the sequence.
* `AlgebraicGeometry.PointBlowupStep` is a rule which chooses, for every stage, a closed point
  of the blowup lying over the centre, with unchanged residue field, cutting the exceptional
  divisor out by the image of the chosen element, and again satisfying the property.
* `AlgebraicGeometry.PointBlowupStep.ofForallExists` builds a rule from the existence, at an
  arbitrary stage, of a point satisfying its five conditions.
* `AlgebraicGeometry.PointBlowupStep.sequence` is the `PointBlowupSequence` the rule produces.
* `AlgebraicGeometry.RationalDoublePointSituation.initialStage` is the stage a Situation 0BGC
  supplies to start from: the spectrum of its ring, its closed point, and a chosen element of
  the maximal ideal of the local ring there.

## Main results

* `AlgebraicGeometry.PointBlowupStep.exceptionalIdealAt_eq_span_stalkImage`: the sequence a rule
  produces satisfies the exceptional-divisor hypothesis of the termination result.
* `AlgebraicGeometry.exists_isRegularLocalRing_of_pointBlowupStep`: over the spectrum of a
  two-dimensional complete normal local Noetherian domain, a rule reaches a stage whose local
  ring is regular, the property still holding there.
* `AlgebraicGeometry.not_pointBlowupStep_rationalDoublePoint`: consequently no rule can keep the
  local ring at the centre a rational double point, the standing situation of Tag 0BGC.
* `AlgebraicGeometry.RationalDoublePointSituation.not_pointBlowupStep` is that statement at
  Situation 0BGC itself, for a situation whose ring is complete.
* `AlgebraicGeometry.RationalDoublePointSituation.not_forall_exists_next` is the same statement
  with the rule replaced by the per-stage existence statement it is built from.

## Implementation notes

The stages are produced by `Nat.rec`, so that the scheme of stage `n + 1` is definitionally the
blowup of stage `n` in its centre and the identification `PointBlowupSequence.stepIso` is the
identity isomorphism. Transporting the maximal ideal and the chosen element along
`PointBlowupSequence.point_step` is unavoidable: the stalk map of a morphism `f` at `x` has the
stalk at `f x` as its source, not the stalk at the centre.

## References

* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
* [Stacks Project, Tag 0BGC](https://stacks.math.columbia.edu/tag/0BGC)
-/

@[expose] public noncomputable section

open CategoryTheory IsLocalRing TopologicalSpace

universe u

namespace AlgebraicGeometry

/-- One stage of a sequence of blowups at closed points: a scheme, the closed point to be blown
up, an element of the local ring at that point, and a property `P` carried along the sequence. -/
structure PointBlowupStage (P : (Y : Scheme.{u}) → (q : Y) → Y.presheaf.stalk q → Prop) where
  /-- The scheme of the stage. -/
  scheme : Scheme.{u}
  /-- The centre of the blowup performed at this stage. -/
  point : scheme
  /-- The centre is a closed point. -/
  point_closed : IsClosed ({point} : Set scheme)
  /-- The element of the local ring at the centre which cuts out the exceptional divisor. -/
  elem : scheme.presheaf.stalk point
  /-- The property carried along the sequence. -/
  prop : P scheme point elem

namespace PointBlowupStage

variable {P : (Y : Scheme.{u}) → (q : Y) → Y.presheaf.stalk q → Prop}

/-- The ideal sheaf blown up at a stage: the vanishing ideal of its centre. -/
def centre (d : PointBlowupStage P) : d.scheme.IdealSheafData :=
  Scheme.IdealSheafData.vanishingIdeal (⟨{d.point}, d.point_closed⟩ : Closeds d.scheme)

end PointBlowupStage

/-- A rule for choosing the centre of the next blowup. At every stage it names a closed point of
the blowup lying over the centre, at which the residue field is unchanged, at which the
extension of the maximal ideal of the centre is generated by the image of the chosen element, and
at which the carried property again holds of that image. -/
structure PointBlowupStep (P : (Y : Scheme.{u}) → (q : Y) → Y.presheaf.stalk q → Prop) where
  /-- The centre of the next blowup. -/
  next : (d : PointBlowupStage P) → blowUp d.centre
  /-- The chosen centre is a closed point. -/
  next_closed : ∀ d : PointBlowupStage P, IsClosed ({next d} : Set (blowUp d.centre))
  /-- The chosen centre lies over the centre of the stage. -/
  next_over : ∀ d : PointBlowupStage P, blowUpToBase d.centre (next d) = d.point
  /-- The residue field at the chosen centre is the residue field of the stage. -/
  next_residue : ∀ d : PointBlowupStage P,
    IsIso ((blowUpToBase d.centre).residueFieldMap (next d))
  /-- At the chosen centre the extension of the maximal ideal of the stage is generated by the
  image of the chosen element: the exceptional divisor is cut out there by that element. -/
  next_exceptional : ∀ d : PointBlowupStage P,
    Ideal.map ((blowUpToBase d.centre).stalkMap (next d)).hom
        ((next_over d).symm ▸ maximalIdeal (d.scheme.presheaf.stalk d.point)) =
      Ideal.span {((blowUpToBase d.centre).stalkMap (next d)).hom
        ((next_over d).symm ▸ d.elem)}
  /-- The carried property holds at the chosen centre, of the image of the chosen element. -/
  next_prop : ∀ d : PointBlowupStage P, P (blowUp d.centre) (next d)
    (((blowUpToBase d.centre).stalkMap (next d)).hom ((next_over d).symm ▸ d.elem))

namespace PointBlowupStep

variable {P : (Y : Scheme.{u}) → (q : Y) → Y.presheaf.stalk q → Prop}

/-- **A rule is no more than the existence, at every stage, of a point satisfying its five
conditions.** A stage-by-stage existence statement of a point satisfying the five conditions of
a `AlgebraicGeometry.PointBlowupStep` produces a rule by choosing. -/
public def ofForallExists
    (h : ∀ d : PointBlowupStage P, ∃ q : blowUp d.centre,
      ∃ hq : blowUpToBase d.centre q = d.point,
        IsClosed ({q} : Set (blowUp d.centre)) ∧
        IsIso ((blowUpToBase d.centre).residueFieldMap q) ∧
        Ideal.map ((blowUpToBase d.centre).stalkMap q).hom
            (hq.symm ▸ maximalIdeal (d.scheme.presheaf.stalk d.point)) =
          Ideal.span {((blowUpToBase d.centre).stalkMap q).hom (hq.symm ▸ d.elem)} ∧
        P (blowUp d.centre) q
          (((blowUpToBase d.centre).stalkMap q).hom (hq.symm ▸ d.elem))) :
    PointBlowupStep P where
  next d := (h d).choose
  next_over d := (h d).choose_spec.choose
  next_closed d := (h d).choose_spec.choose_spec.1
  next_residue d := (h d).choose_spec.choose_spec.2.1
  next_exceptional d := (h d).choose_spec.choose_spec.2.2.1
  next_prop d := (h d).choose_spec.choose_spec.2.2.2

/-- The stage obtained by one application of the rule. -/
@[reducible]
def stepStage (t : PointBlowupStep P) (d : PointBlowupStage P) : PointBlowupStage P where
  scheme := blowUp d.centre
  point := t.next d
  point_closed := t.next_closed d
  elem := ((blowUpToBase d.centre).stalkMap (t.next d)).hom ((t.next_over d).symm ▸ d.elem)
  prop := t.next_prop d

/-- The stages of the sequence a rule produces from an initial stage. -/
@[reducible]
def stage (t : PointBlowupStep P) (d₀ : PointBlowupStage P) (n : ℕ) : PointBlowupStage P :=
  Nat.rec d₀ (fun _ d => t.stepStage d) n

/-- The initial stage of the sequence is the given one. -/
@[simp]
theorem stage_zero (t : PointBlowupStep P) (d₀ : PointBlowupStage P) : t.stage d₀ 0 = d₀ := rfl

/-- Each stage of the sequence is obtained from the previous one by one application of the
rule. -/
@[simp]
theorem stage_succ (t : PointBlowupStep P) (d₀ : PointBlowupStage P) (n : ℕ) :
    t.stage d₀ (n + 1) = t.stepStage (t.stage d₀ n) := rfl

/-- The sequence of blowups at closed points a rule produces from an initial stage. -/
@[reducible]
def sequence (t : PointBlowupStep P) (d₀ : PointBlowupStage P) : PointBlowupSequence.{u} where
  scheme n := (t.stage d₀ n).scheme
  point n := (t.stage d₀ n).point
  point_closed n := (t.stage d₀ n).point_closed
  stepMap n := blowUpToBase (t.stage d₀ n).centre
  stepIso n := Iso.refl _
  stepMap_eq _ := (Category.id_comp _).symm
  point_step n := t.next_over (t.stage d₀ n)
  residueFieldIso n := t.next_residue (t.stage d₀ n)

/-- The scheme at stage `n` of the sequence is the scheme of the `n`-th stage. -/
@[simp]
theorem sequence_scheme (t : PointBlowupStep P) (d₀ : PointBlowupStage P) (n : ℕ) :
    (t.sequence d₀).scheme n = (t.stage d₀ n).scheme := rfl

/-- The centre at stage `n` of the sequence is the centre of the `n`-th stage. -/
@[simp]
theorem sequence_point (t : PointBlowupStep P) (d₀ : PointBlowupStage P) (n : ℕ) :
    (t.sequence d₀).point n = (t.stage d₀ n).point := rfl

/-- The image at stage `n` of the element chosen at the initial stage is the element of stage
`n`: the rule transports the element exactly as the sequence does. -/
theorem stalkImage_sequence (t : PointBlowupStep P) (d₀ : PointBlowupStage P) (n : ℕ) :
    (t.sequence d₀).stalkImage n d₀.elem = (t.stage d₀ n).elem := by
  induction n with
  | zero => exact (t.sequence d₀).stalkImage_zero d₀.elem
  | succ n ih =>
      rw [PointBlowupSequence.stalkImage_succ, ih]

/-- **The exceptional-divisor hypothesis of the termination result holds for the sequence a rule
produces.** At every stage the extension of the maximal ideal of the preceding centre is
generated by the image of the element chosen at the initial stage. -/
theorem exceptionalIdealAt_eq_span_stalkImage (t : PointBlowupStep P)
    (d₀ : PointBlowupStage P) (n : ℕ) :
    (t.sequence d₀).exceptionalIdealAt n =
      Ideal.span {(t.sequence d₀).stalkImage (n + 1) d₀.elem} := by
  rw [PointBlowupSequence.stalkImage_succ, stalkImage_sequence]
  exact t.next_exceptional (t.stage d₀ n)

end PointBlowupStep

/-- **A rule for choosing the centres reaches a regular local ring.** Over the spectrum of a
two-dimensional normal Noetherian local domain which is complete for its maximal-ideal-adic
topology, the sequence of blowups at closed points produced by a rule has a stage whose local
ring is regular; the carried property holds there, of the element the rule transported to it. -/
public theorem exists_isRegularLocalRing_of_pointBlowupStep
    {P : (Y : Scheme.{u}) → (q : Y) → Y.presheaf.stalk q → Prop} (A : Type u) [CommRing A]
    [IsLocalRing A] [IsNormalDomain A] [IsNoetherianRing A] [IsAdicComplete (maximalIdeal A) A]
    (hdim : ringKrullDim A = 2) (t : PointBlowupStep P) (d₀ : PointBlowupStage P)
    (e : Spec (.of A) ≅ d₀.scheme) (he : e.hom (closedPoint A) = d₀.point)
    (hx : d₀.elem ∈ maximalIdeal (d₀.scheme.presheaf.stalk d₀.point)) :
    ∃ (Y : Scheme.{u}) (q : Y) (y : Y.presheaf.stalk q),
      P Y q y ∧ IsRegularLocalRing (Y.presheaf.stalk q) := by
  obtain ⟨n, hn⟩ := exists_isRegularLocalRing_stalk_point_of_pointBlowupSequence A hdim
    (t.sequence d₀) e.symm he d₀.elem hx (t.exceptionalIdealAt_eq_span_stalkImage d₀)
  exact ⟨(t.stage d₀ n).scheme, (t.stage d₀ n).point, (t.stage d₀ n).elem,
    (t.stage d₀ n).prop, hn⟩

/-- The property carried along the sequence of blowups of a rational double point: the local ring
at the centre is again the ring of a Situation 0BGC. -/
abbrev IsRationalDoublePointAt (Y : Scheme.{u}) (q : Y) (_ : Y.presheaf.stalk q) : Prop :=
  ∃ S : RationalDoublePointSituation.{u}, Nonempty (S.A ≃+* Y.presheaf.stalk q)

/-- **No rule for choosing the centres keeps a rational double point.** Over the spectrum of a
two-dimensional normal Noetherian local domain which is complete for its maximal-ideal-adic
topology, there is no rule choosing at every stage a closed point whose local ring is the ring of
a Situation 0BGC — in particular no rule choosing a singular closed point, a rational double
point being by definition not regular. -/
public theorem not_pointBlowupStep_rationalDoublePoint (A : Type u) [CommRing A] [IsLocalRing A]
    [IsNormalDomain A] [IsNoetherianRing A] [IsAdicComplete (maximalIdeal A) A]
    (hdim : ringKrullDim A = 2)
    (t : PointBlowupStep.{u} IsRationalDoublePointAt)
    (d₀ : PointBlowupStage.{u} IsRationalDoublePointAt)
    (e : Spec (.of A) ≅ d₀.scheme) (he : e.hom (closedPoint A) = d₀.point)
    (hx : d₀.elem ∈ maximalIdeal (d₀.scheme.presheaf.stalk d₀.point)) : False := by
  obtain ⟨Y, q, y, ⟨S, ⟨f⟩⟩, hreg⟩ :=
    exists_isRegularLocalRing_of_pointBlowupStep A hdim t d₀ e he hx
  have : IsRegularLocalRing (Y.presheaf.stalk q) := hreg
  exact S.not_isRegularLocalRing (IsRegularLocalRing.of_ringEquiv f.symm)

namespace RationalDoublePointSituation

/-- **The initial stage of the sequence of blowups of a rational double point.** Situation 0BGC
supplies the scheme `Spec(A)`, its closed point, and — once an element of the maximal ideal of
the local ring there is chosen — everything a `AlgebraicGeometry.PointBlowupStep` is iterated
from. -/
def initialStage (S : RationalDoublePointSituation.{u})
    (x : S.base.presheaf.stalk S.closedPoint) :
    PointBlowupStage.{u} IsRationalDoublePointAt where
  scheme := S.base
  point := S.closedPoint
  point_closed := IsLocalRing.isClosed_singleton_closedPoint S.A
  elem := x
  prop := ⟨S, ⟨(stalkClosedPointIso (.of S.A)).commRingCatIsoToRingEquiv.symm⟩⟩

/-- **Situation 0BGC admits no rule for choosing the centres of an infinite sequence of blowups
in singular closed points**, provided its ring is complete for the maximal-ideal-adic topology.
-/
public theorem not_pointBlowupStep (S : RationalDoublePointSituation.{u})
    [IsAdicComplete (IsLocalRing.maximalIdeal S.A) S.A]
    (t : PointBlowupStep.{u} IsRationalDoublePointAt)
    (x : S.base.presheaf.stalk S.closedPoint)
    (hx : x ∈ IsLocalRing.maximalIdeal (S.base.presheaf.stalk S.closedPoint)) : False :=
  not_pointBlowupStep_rationalDoublePoint S.A S.dimension_two t (S.initialStage x)
    (Iso.refl _) rfl hx

/-- **Situation 0BGC: a singular closed point above the centre cannot be found at every stage.**
The same statement as `AlgebraicGeometry.RationalDoublePointSituation.not_pointBlowupStep` with
the rule replaced by the existence, at an arbitrary stage, of a point satisfying the five
conditions a rule imposes. -/
public theorem not_forall_exists_next (S : RationalDoublePointSituation.{u})
    [IsAdicComplete (IsLocalRing.maximalIdeal S.A) S.A]
    (h : ∀ d : PointBlowupStage.{u} IsRationalDoublePointAt, ∃ q : blowUp d.centre,
      ∃ hq : blowUpToBase d.centre q = d.point,
        IsClosed ({q} : Set (blowUp d.centre)) ∧
        IsIso ((blowUpToBase d.centre).residueFieldMap q) ∧
        Ideal.map ((blowUpToBase d.centre).stalkMap q).hom
            (hq.symm ▸ IsLocalRing.maximalIdeal (d.scheme.presheaf.stalk d.point)) =
          Ideal.span {((blowUpToBase d.centre).stalkMap q).hom (hq.symm ▸ d.elem)} ∧
        IsRationalDoublePointAt (blowUp d.centre) q
          (((blowUpToBase d.centre).stalkMap q).hom (hq.symm ▸ d.elem)))
    (x : S.base.presheaf.stalk S.closedPoint)
    (hx : x ∈ IsLocalRing.maximalIdeal (S.base.presheaf.stalk S.closedPoint)) : False :=
  S.not_pointBlowupStep (PointBlowupStep.ofForallExists h) x hx

end RationalDoublePointSituation

end AlgebraicGeometry

end
