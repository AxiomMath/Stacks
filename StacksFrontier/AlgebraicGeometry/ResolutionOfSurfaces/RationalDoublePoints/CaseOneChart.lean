module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ChartNormalization
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ChartSingularPoint

/-!
# Case I of Section 54.12 on a chart: the singular point and the good coordinate

Let `(A, 𝔪, κ)` be a Noetherian local ring with `𝔪 = (x₁, x₂, x₃)` and a quadratic relation
`Σ aₚᵩ xₚxᵩ ∈ 𝔪³` whose form `q` is in case I, let `A' = A[𝔪/x₁]` and let `𝔪'` be a maximal ideal
of `A'` containing `𝔪A'` at which the local ring `B = A'_{𝔪'}` is of dimension two and singular.
This file carries out, on the chart, the part of the source's "Resolution in case I" that follows
the Claim:

* if `𝔪'` lies on the line `yⱼ = 0` of the chart (`j = 2, 3`), then the binary form obtained by
  setting `tⱼ = 0` in `q` is a scalar times a square
  (`AlgebraicGeometry.isScalarSqLinear_restrict_of_chartFraction_mem`). Consequently, if `xⱼ` is
  a good coordinate the point does not lie on that line, and `xⱼ` generates `𝔪B`
  (`AlgebraicGeometry.map_maximalIdeal_eq_span_of_isGoodCoordinateForm_restrict`). This is the
  source's "If `x₁` is a good coordinate, then the singular point `p ∈ E` of `X` does not lie on
  the hypersurface `t₁ = 0` ... equivalent to the statement that the image of `x₁` in `𝒪_{X,p}`
  cuts out the exceptional divisor."
* if `x₁` itself is a good coordinate, then `𝔪'` is `κ`-rational, the maximal ideal of `B` is
  generated by `x₁, y₂ - u, y₃ - v`, and these satisfy a quadratic relation in `B` whose form has
  `x₁` again as a good coordinate (`AlgebraicGeometry.isGoodCoordinate_localization_of_chart`).
  This is the source's "the computations above show that if `x₁` is a good coordinate for `A`,
  then `x₁ ∈ 𝔪'𝒪_{X,p}` is a good coordinate for `p`."

## Main definitions

* `AlgebraicGeometry.IsCaseOne B`: the local ring `B` has generators of its maximal ideal and a
  quadratic relation among them whose form is not a scalar times a square (case I).
* `AlgebraicGeometry.IsGoodCoordinate B g`: moreover the first generator can be taken to be `g`
  and is a good coordinate.

## References

* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
-/

@[expose] public section

open IsLocalRing MvPolynomial

universe u

namespace AlgebraicGeometry

/-! ### Case I and good coordinates as properties of a local ring -/

/-- **Case I of Section 54.12, as a property of a local ring.** There are three generators of the
maximal ideal satisfying a quadratic relation `Σ aₚᵩ xₚxᵩ ∈ 𝔪³` with upper triangular coefficient
matrix, one entry on or above the diagonal a unit, whose quadratic form is not a scalar times the
square of a linear form. -/
def IsCaseOne (B : Type*) [CommRing B] [IsLocalRing B] : Prop :=
  ∃ (w : Fin 3 → B) (a : Fin 3 → Fin 3 → B), Ideal.span (Set.range w) = maximalIdeal B ∧
    (∀ p q, q < p → a p q = 0) ∧ (∃ p q, p ≤ q ∧ a p q ∉ maximalIdeal B) ∧
    ∑ p, ∑ q, a p q * (w p * w q) ∈ maximalIdeal B ^ 3 ∧
    ¬ IsScalarSqLinear fun p q => residue B (a p q)

/-- **A good coordinate of a local ring**, in the sense of Section 54.12: `g` is the first of three
generators of the maximal ideal satisfying a quadratic relation as in
`AlgebraicGeometry.IsCaseOne` for which the first generator is a good coordinate
(`AlgebraicGeometry.IsGoodCoordinateForm`). -/
def IsGoodCoordinate (B : Type*) [CommRing B] [IsLocalRing B] (g : B) : Prop :=
  ∃ (w : Fin 3 → B) (a : Fin 3 → Fin 3 → B), w 0 = g ∧
    Ideal.span (Set.range w) = maximalIdeal B ∧
    (∀ p q, q < p → a p q = 0) ∧ (∃ p q, p ≤ q ∧ a p q ∉ maximalIdeal B) ∧
    ∑ p, ∑ q, a p q * (w p * w q) ∈ maximalIdeal B ^ 3 ∧
    IsGoodCoordinateForm fun p q => residue B (a p q)

/-- A local ring with a good coordinate is in case I. -/
theorem IsGoodCoordinate.isCaseOne {B : Type*} [CommRing B] [IsLocalRing B] {g : B}
    (h : IsGoodCoordinate B g) : IsCaseOne B := by
  obtain ⟨w, a, -, hspan, hupper, hunit, hrel, hgood⟩ := h
  exact ⟨w, a, hspan, hupper, hunit, hrel, hgood.not_isScalarSqLinear⟩

/-! ### Quadratic forms: restrictions, maps and reindexings -/

/-- The condition of being a scalar times a square is preserved by ring maps. -/
theorem IsScalarSqLinear.map {k k' : Type*} [CommRing k] [CommRing k'] {n : ℕ}
    {a : Fin n → Fin n → k} (f : k →+* k') (h : IsScalarSqLinear a) :
    IsScalarSqLinear fun p q => f (a p q) := by
  obtain ⟨c, l, hdiag, hoff⟩ := h
  refine ⟨f c, fun p => f (l p), fun p => ?_, fun p q hpq => ?_⟩
  · show f (a p p) = f c * f (l p) * f (l p)
    rw [hdiag p, map_mul, map_mul]
  · show f (a p q) + f (a q p) = 2 * (f c * f (l p) * f (l q))
    rw [← map_add, hoff p q hpq]; simp only [map_mul, map_ofNat]

/-- Along a ring isomorphism the condition of being a scalar times a square is reflected. -/
theorem isScalarSqLinear_map_iff {k k' : Type*} [CommRing k] [CommRing k'] {n : ℕ}
    (a : Fin n → Fin n → k) (f : k ≃+* k') :
    (IsScalarSqLinear fun p q => f (a p q)) ↔ IsScalarSqLinear a := by
  refine ⟨fun h => ?_, fun h => h.map f.toRingHom⟩
  simpa using h.map f.symm.toRingHom

/-- Reindexing a quadratic form along an injection which preserves the order, of a matrix which
is upper triangular up to symmetrization: the condition of being a scalar times a square only
sees the diagonal and the sums `aₚᵩ + aᵩₚ`, so it can be checked on any matrix with the same
diagonal and the same such sums. -/
theorem isScalarSqLinear_comp_congr {k : Type*} [CommRing k] {m n : ℕ}
    (a a' : Fin n → Fin n → k) (e : Fin m → Fin n) (he : StrictMono e)
    (hdiag : ∀ p, a p p = a' p p) (hoff : ∀ p q, p < q → a p q + a q p = a' p q + a' q p) :
    (IsScalarSqLinear fun p q => a (e p) (e q)) ↔ IsScalarSqLinear fun p q => a' (e p) (e q) :=
  isScalarSqLinear_congr (fun p => hdiag (e p)) fun p q hpq => hoff (e p) (e q) (he hpq)

/-- **Restricting a reindexed form.** Setting the variable `j` to zero in the form reindexed by a
permutation `σ` gives, up to a permutation of the remaining variables, the form obtained by
setting the variable `σ j` to zero; so one is a scalar times a square exactly when the other is. -/
theorem isScalarSqLinear_restrict_comp_perm_iff {k : Type*} [CommRing k] {n : ℕ}
    (a : Fin (n + 1) → Fin (n + 1) → k) (σ : Equiv.Perm (Fin (n + 1))) (j : Fin (n + 1)) :
    (IsScalarSqLinear fun p q : Fin n => a (σ (j.succAbove p)) (σ (j.succAbove q))) ↔
      IsScalarSqLinear fun p q : Fin n => a ((σ j).succAbove p) ((σ j).succAbove q) := by
  classical
  -- `σ ∘ j.succAbove` and `(σ j).succAbove` are injections with the same range
  have hrange : ∀ p, ∃ r, σ (j.succAbove p) = (σ j).succAbove r := fun p => by
    obtain ⟨z, hz⟩ := Fin.exists_succAbove_eq fun h => Fin.succAbove_ne j p (σ.injective h)
    exact ⟨z, hz.symm⟩
  choose τ hτ using hrange
  have hτinj : Function.Injective τ := fun p p' h => by
    have := hτ p
    rw [h, ← hτ p'] at this
    exact Fin.succAbove_right_injective (σ.injective this)
  let τe : Equiv.Perm (Fin n) := Equiv.ofBijective τ (Finite.injective_iff_bijective.mp hτinj)
  have hfun : (fun p q : Fin n => a (σ (j.succAbove p)) (σ (j.succAbove q))) =
      fun p q => (fun p q : Fin n => a ((σ j).succAbove p) ((σ j).succAbove q)) (τe p) (τe q) := by
    funext p q
    simp only [τe, Equiv.ofBijective_apply, ← hτ]
  rw [hfun]
  exact isScalarSqLinear_comp_perm_iff (fun p q => a ((σ j).succAbove p) ((σ j).succAbove q)) τe

/-- **A form all of whose relevant entries vanish is a scalar times a square** (the scalar being
zero). In particular a good coordinate forces a nonzero entry of the restricted form. -/
theorem isScalarSqLinear_of_forall_eq_zero {k : Type*} [CommRing k] {n : ℕ}
    {a : Fin n → Fin n → k} (hdiag : ∀ p, a p p = 0) (hoff : ∀ p q, p < q → a p q + a q p = 0) :
    IsScalarSqLinear a :=
  ⟨0, 0, fun p => by simp [hdiag p], fun p q hpq => by simp [hoff p q hpq]⟩

/-- **A good coordinate gives a unit entry.** If the first generator is a good coordinate for an
upper triangular coefficient matrix over a local ring, then some entry on or above the diagonal is
a unit, already among the entries not involving the first variable. -/
theorem exists_notMem_maximalIdeal_of_isGoodCoordinateForm {B : Type*} [CommRing B]
    [IsLocalRing B] {n : ℕ} {a : Fin (n + 1) → Fin (n + 1) → B}
    (hupper : ∀ p q, q < p → a p q = 0)
    (hgood : IsGoodCoordinateForm fun p q => residue B (a p q)) :
    ∃ p q, p ≤ q ∧ a p q ∉ maximalIdeal B := by
  by_contra hcon
  simp only [not_exists, not_and, not_not] at hcon
  have hall : ∀ p q, residue B (a p q) = 0 := fun p q => by
    rcases le_or_gt p q with hpq | hpq
    · exact (residue_eq_zero_iff _).mpr (hcon p q hpq)
    · rw [hupper p q hpq, map_zero]
  exact hgood (isScalarSqLinear_of_forall_eq_zero (fun p => hall _ _)
    fun p q _ => by simp only [restrictFirstVar_apply, hall, add_zero])


/-! ### The upper triangular symmetrization of a coefficient matrix -/

/-- The upper triangular matrix with the same diagonal and the same sums `aₚᵩ + aᵩₚ` as `a`: it
presents the same quadratic expression (`AlgebraicGeometry.sum_quadratic_congr_of_symm`). -/
def upperSymm {R : Type*} [Add R] [Zero R] {n : ℕ} (a : Fin n → Fin n → R) :
    Fin n → Fin n → R :=
  fun p q => if p = q then a p p else if p < q then a p q + a q p else 0

/-- The upper triangular symmetrization vanishes below the diagonal. -/
theorem upperSymm_upper {R : Type*} [Add R] [Zero R] {n : ℕ} (a : Fin n → Fin n → R)
    (p q : Fin n) (h : q < p) : upperSymm a p q = 0 := by
  simp [upperSymm, ne_of_gt h, asymm h]

/-- The upper triangular symmetrization has the same diagonal as `a`. -/
theorem upperSymm_diag {R : Type*} [Add R] [Zero R] {n : ℕ} (a : Fin n → Fin n → R)
    (p : Fin n) : upperSymm a p p = a p p := by
  simp [upperSymm]

/-- The upper triangular symmetrization has the same sums `aₚᵩ + aᵩₚ` off the diagonal as `a`. -/
theorem upperSymm_add {R : Type*} [AddCommMonoid R] {n : ℕ} (a : Fin n → Fin n → R)
    (p q : Fin n) (h : p < q) : upperSymm a p q + upperSymm a q p = a p q + a q p := by
  simp [upperSymm, ne_of_lt h, h, ne_of_gt h, asymm h]

/-- The upper triangular symmetrization commutes with ring maps. -/
theorem upperSymm_map {R R' : Type*} [CommRing R] [CommRing R'] {n : ℕ} (f : R →+* R')
    (a : Fin n → Fin n → R) (p q : Fin n) : f (upperSymm a p q) = upperSymm (fun p q => f (a p q))
        p q := by
  simp only [upperSymm]
  split_ifs <;> simp

/-- The upper triangular symmetrization presents the same ternary quadratic form. -/
theorem quadraticFormPoly_upperSymm {R : Type*} [CommRing R] (a : Fin 3 → Fin 3 → R) :
    quadraticFormPoly (upperSymm a) = quadraticFormPoly a := by
  rw [quadraticFormPoly_def, quadraticFormPoly_def]
  refine sum_quadratic_congr_of_symm MvPolynomial.X (fun p q => MvPolynomial.C (upperSymm a p q))
    (fun p q => MvPolynomial.C (a p q)) (fun p => by simp [upperSymm_diag]) fun p q hpq => ?_
  simp only [← map_add, upperSymm_add a p q hpq]

/-- The upper triangular symmetrization presents the same ternary quadratic expression. -/
theorem sum_upperSymm {R : Type*} [CommRing R] (a : Fin 3 → Fin 3 → R) (w : Fin 3 → R) :
    ∑ p, ∑ q, upperSymm a p q * (w p * w q) = ∑ p, ∑ q, a p q * (w p * w q) :=
  sum_quadratic_congr_of_symm w _ _ (fun p => upperSymm_diag a p) fun p q hpq =>
    upperSymm_add a p q hpq

/-! ### Local rings -/

/-- A Noetherian local ring of dimension two whose maximal ideal is generated by two elements is
regular. -/
theorem isRegularLocalRing_of_maximalIdeal_eq_span_pair {B : Type*} [CommRing B] [IsLocalRing B]
    [IsNoetherianRing B] (hdim : ringKrullDim B = 2) {u v : B}
    (h : maximalIdeal B = Ideal.span {u, v}) : IsRegularLocalRing B := by
  refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ ?_
  rw [hdim, h]
  have : (Ideal.span {u, v} : Ideal B).spanFinrank ≤ 2 :=
    (Submodule.spanFinrank_span_le_ncard_of_finite (Set.toFinite _)).trans
      ((Set.ncard_insert_le _ _).trans (by rw [Set.ncard_singleton]))
  exact_mod_cast this

/-- **The residue field of a `κ`-rational point of an `A`-algebra.** If `𝔪'` is a maximal ideal
of an `A`-algebra `R` containing `𝔪R` such that `A → R/𝔪'` is surjective, then the residue field
of `R_{𝔪'}` is the residue field of `A`, compatibly with the maps from `A`. -/
theorem exists_residueField_ringEquiv_of_surjective {A R : Type*} [CommRing A] [IsLocalRing A]
    [CommRing R] [Algebra A R] (M : Ideal R) [M.IsMaximal]
    (hle : Ideal.map (algebraMap A R) (maximalIdeal A) ≤ M)
    (hsurj : Function.Surjective ((Ideal.Quotient.mk M).comp (algebraMap A R))) :
    ∃ ι : ResidueField A ≃+* ResidueField (Localization.AtPrime M),
      ∀ r, ι (residue A r) = residue _ (algebraMap R (Localization.AtPrime M) (algebraMap A R r))
          := by
  let g : A →+* Localization.AtPrime M := (algebraMap R _).comp (algebraMap A R)
  have hg : ∀ r ∈ maximalIdeal A, (residue (Localization.AtPrime M)).comp g r = 0 := by
    intro r hr
    rw [RingHom.comp_apply, residue_eq_zero_iff, ← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.mem_map_of_mem _ (hle (Ideal.mem_map_of_mem _ hr))
  let ι : ResidueField A →+* ResidueField (Localization.AtPrime M) :=
    Ideal.Quotient.lift (maximalIdeal A) ((residue _).comp g) hg
  have hι : ∀ r, ι (residue A r) = residue _ (g r) := fun r => rfl
  have hιsurj : Function.Surjective ι := by
    intro β
    let e := IsLocalization.AtPrime.equivQuotMaximalIdeal M (Localization.AtPrime M)
    obtain ⟨r, hr⟩ := hsurj (e.symm β)
    refine ⟨residue A r, ?_⟩
    rw [hι, ← e.apply_symm_apply β, ← hr]
    rfl
  exact ⟨RingEquiv.ofBijective ι ⟨ι.injective, hιsurj⟩, hι⟩

/-! ### A singular point of the exceptional conic on a coordinate line -/

/-- **A double point of the dehomogenized conic on a coordinate line.** Let
`q(1, y₂, y₃)` vanish with both its partial derivatives at a point `c` of the chart (the identities
`hconst`, `hlin₂`, `hlin₃`, for an upper triangular `a`). If the point lies on the line `yⱼ = 0`,
then the binary form `q|_{tⱼ = 0}` is a scalar times a square: it is `a₃₃(t₃ - c₃t₁)²` or
`a₂₂(t₂ - c₂t₁)²`. -/
theorem isScalarSqLinear_restrict_of_chartPoint {k : Type*} [Field k]
    (a : Fin 3 → Fin 3 → k) (hupper : ∀ p q, q < p → a p q = 0) (c : Fin 2 → k)
    (hconst : a 0 0 + a 0 1 * c 0 + a 0 2 * c 1 + a 1 1 * (c 0 * c 0) + a 1 2 * (c 0 * c 1)
      + a 2 2 * (c 1 * c 1) = 0)
    (hlin₂ : a 0 1 + 2 * (a 1 1 * c 0) + a 1 2 * c 1 = 0)
    (hlin₃ : a 0 2 + a 1 2 * c 0 + 2 * (a 2 2 * c 1) = 0) (j : Fin 2) (hj : c j = 0) :
    IsScalarSqLinear fun p q : Fin 2 => a (j.succ.succAbove p) (j.succ.succAbove q) := by
  have h10 := hupper 1 0 (by decide)
  have h20 := hupper 2 0 (by decide)
  have h21 := hupper 2 1 (by decide)
  fin_cases j
  · -- the line `y₂ = 0`: the form in `t₁, t₃` is `a₃₃(t₃ - c₃t₁)²`
    simp only [Fin.zero_eta, Fin.isValue] at hj
    rw [hj] at hconst hlin₃
    refine ⟨a 2 2, ![-c 1, 1], fun p => ?_, fun p q hpq => ?_⟩
    · fin_cases p
      · simp [Fin.succAbove]
        linear_combination hconst - c 1 * hlin₃
      · simp [Fin.succAbove]
    · fin_cases p <;> fin_cases q <;> simp [Fin.succAbove] at hpq ⊢
      rw [h20]
      linear_combination hlin₃
  · -- the line `y₃ = 0`: the form in `t₁, t₂` is `a₂₂(t₂ - c₂t₁)²`
    simp only [Fin.mk_one, Fin.isValue] at hj
    rw [hj] at hconst hlin₂
    refine ⟨a 1 1, ![-c 0, 1], fun p => ?_, fun p q hpq => ?_⟩
    · fin_cases p
      · simp [Fin.succAbove]
        linear_combination hconst - c 0 * hlin₂
      · simp [Fin.succAbove]
    · fin_cases p <;> fin_cases q <;> simp [Fin.succAbove] at hpq ⊢
      rw [h10]
      linear_combination hlin₂

/-- **A singular point of the exceptional conic, as a point of the chart.** In case I, a proper
ideal `I` of `κ[y₂, y₃]` whose square contains `q(1, y₂, y₃)` is contained in the ideal of a
`κ`-point `c` of the chart, at which `q(1, y₂, y₃)` vanishes together with its two partial
derivatives. -/
theorem exists_eval_eq_zero_and_chartPoint {k : Type*} [Field k]
    (a : Fin 3 → Fin 3 → k) (hupper : ∀ p q, q < p → a p q = 0)
    (hunit : ∃ p q, p ≤ q ∧ a p q ≠ 0) (hcase : ¬ IsScalarSqLinear a)
    (I : Ideal (MvPolynomial (Fin 2) k)) (hI : I ≠ ⊤)
    (hmem : (C (a 0 0) + C (a 0 1) * X 0 + C (a 0 2) * X 1 + C (a 1 1) * X 0 ^ 2 +
      C (a 1 2) * X 0 * X 1 + C (a 2 2) * X 1 ^ 2 : MvPolynomial (Fin 2) k) ∈ I ^ 2) :
    ∃ c : Fin 2 → k, (∀ f ∈ I, eval c f = 0) ∧
      a 0 0 + a 0 1 * c 0 + a 0 2 * c 1 + a 1 1 * (c 0 * c 0) + a 1 2 * (c 0 * c 1)
          + a 2 2 * (c 1 * c 1) = 0 ∧
        a 0 1 + 2 * (a 1 1 * c 0) + a 1 2 * c 1 = 0 ∧
        a 0 2 + a 1 2 * c 0 + 2 * (a 2 2 * c 1) = 0 := by
  obtain ⟨c, hc⟩ := exists_eval_eq_zero_of_bijective_algebraMap_quotient I
    (bijective_algebraMap_quotient_of_not_isScalarSqLinear a hupper hunit hcase I hI hmem)
  refine ⟨c, hc, ?_, ?_, ?_⟩
  · have h := hc _ (Ideal.pow_le_self (by norm_num) hmem)
    simp only [map_add, map_mul, map_pow, eval_C, eval_X] at h
    linear_combination h
  · have h := hc _ ((MvPolynomial.pderiv (0 : Fin 2)).map_mem_of_mem_ideal_sq I hmem)
    simp [mul_comm, mul_left_comm, mul_assoc] at h
    linear_combination h
  · have h := hc _ ((MvPolynomial.pderiv (1 : Fin 2)).map_mem_of_mem_ideal_sq I hmem)
    simp [mul_comm, mul_left_comm, mul_assoc] at h
    linear_combination h

/-! ### Products of elements congruent to constants -/

/-- **The linear part of a cubic expression.** If `y₁ = 1` and `y₂, y₃ ∈ I`, then
`Σ bₚᵩᵣ yₚyᵩyᵣ` agrees modulo `I²` with its constant and linear terms
`b₁₁₁ + (b₁₁₂ + b₁₂₁ + b₂₁₁) y₂ + (b₁₁₃ + b₁₃₁ + b₃₁₁) y₃`. -/
theorem sum_cubic_sub_linear_mem_sq {R : Type*} [CommRing R] (I : Ideal R) (y : Fin 3 → R)
    (hy0 : y 0 = 1) (hy1 : y 1 ∈ I) (hy2 : y 2 ∈ I) (b : Fin 3 → Fin 3 → Fin 3 → R) :
    ∑ p, ∑ q, ∑ r, b p q r * (y p * y q * y r) -
      (b 0 0 0 + (b 0 0 1 + b 0 1 0 + b 1 0 0) * y 1 + (b 0 0 2 + b 0 2 0 + b 2 0 0) * y 2) ∈
      I ^ 2 := by
  classical
  let δ : Fin 3 → R := fun p => if p = 0 then 1 else 0
  let ε : Fin 3 → R := fun p => if p = 0 then 0 else y p
  have hy : ∀ p, y p = δ p + ε p := fun p => by
    by_cases hp : p = 0
    · simp [δ, ε, hp, hy0]
    · simp [δ, ε, hp]
  have hε : ∀ p, ε p ∈ I := fun p => by
    fin_cases p <;> simp [ε, hy1, hy2]
  have hterm : ∀ p q r, y p * y q * y r -
      (δ p * δ q * δ r + δ p * δ q * ε r + δ p * ε q * δ r + ε p * δ q * δ r) ∈ I ^ 2 := by
    intro p q r
    have heq : y p * y q * y r -
        (δ p * δ q * δ r + δ p * δ q * ε r + δ p * ε q * δ r + ε p * δ q * δ r) =
        ε p * ε q * y r + ε p * ε r * δ q + ε q * ε r * δ p := by
      rw [hy p, hy q, hy r]; ring
    rw [heq, pow_two]
    refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) ?_ <;>
      exact Ideal.mul_mem_right _ _ (Ideal.mul_mem_mul (hε _) (hε _))
  have hlin : ∑ p, ∑ q, ∑ r, b p q r *
      (δ p * δ q * δ r + δ p * δ q * ε r + δ p * ε q * δ r + ε p * δ q * δ r) =
      b 0 0 0 + (b 0 0 1 + b 0 1 0 + b 1 0 0) * y 1 + (b 0 0 2 + b 0 2 0 + b 2 0 0) * y 2 := by
    simp [Fin.sum_univ_three, δ, ε]
    ring
  rw [← hlin, ← Finset.sum_sub_distrib]
  refine Ideal.sum_mem _ fun p _ => ?_
  rw [← Finset.sum_sub_distrib]
  refine Ideal.sum_mem _ fun q _ => ?_
  rw [← Finset.sum_sub_distrib]
  refine Ideal.sum_mem _ fun r _ => ?_
  rw [← mul_sub]
  exact Ideal.mul_mem_left _ _ (hterm p q r)

/-! ### The relation at the origin of the chart -/

/-- **The quadratic relation at the origin of the chart of a good coordinate.** Let `x₁, x₂, x₃`
generate the maximal ideal of `A`, with a relation `Σ aₚᵩ xₚxᵩ = Σ bₚᵩᵣ xₚxᵩxᵣ` whose first row
vanishes and whose form has `x₁` as a good coordinate. Let `B` be a singular two-dimensional
Noetherian local ring with a map `g : A → B` inducing an isomorphism of residue fields, and
elements `y₂, y₃` with `g(xᵢ) = g(x₁) yᵢ`, `𝔪_B = (g x₁, y₂, y₃)`, and the chart relation
`Σ aₚᵩ yₚyᵩ = x₁ Σ bₚᵩᵣ yₚyᵩyᵣ` (`y₁ = 1`). Then `g x₁` is a good coordinate of `B`.

The constant term `b₁₁₁` of the cubic part lies in `𝔪`, for otherwise `x₁ ∈ (y₂, y₃)` and `B`
would be regular; writing `b₁₁₁ = Σ eᵢxᵢ`, the quadratic form of `B` for `x₁, y₂, y₃` is
`-ē₁t₁² - β̄₂t₁t₂ - β̄₃t₁t₃ + ā₂₂t₂² + ā₂₃t₂t₃ + ā₃₃t₃²`, whose restriction to `t₁ = 0` is the
old one. This is the source's `q' = b̄₁₁₁t₁² + ā₁₁₂t₁t₂ + … + ā₃₃t₃²`. -/
theorem isGoodCoordinate_of_chartRelation {A B : Type*} [CommRing A] [IsLocalRing A]
    [CommRing B] [IsLocalRing B] [IsNoetherianRing B] (hdim : ringKrullDim B = 2)
    (hsing : ¬ IsRegularLocalRing B) (x' : Fin 3 → A)
    (hspan' : Ideal.span (Set.range x') = maximalIdeal A) (a' : Fin 3 → Fin 3 → A)
    (b' : Fin 3 → Fin 3 → Fin 3 → A) (hupper' : ∀ p q, q < p → a' p q = 0)
    (h00 : a' 0 0 = 0) (h01 : a' 0 1 = 0) (h02 : a' 0 2 = 0)
    (hgood' : IsGoodCoordinateForm fun p q => residue A (a' p q)) (g : A →+* B)
    (Y : Fin 3 → B) (hY0 : Y 0 = 1)
    (hmB : maximalIdeal B = Ideal.span {g (x' 0), Y 1, Y 2})
    (hgx : ∀ i, g (x' i) = g (x' 0) * Y i)
    (hchB : ∑ p, ∑ q, g (a' p q) * (Y p * Y q) =
      g (x' 0) * ∑ p, ∑ q, ∑ r, g (b' p q r) * (Y p * Y q * Y r))
    (ι : ResidueField A ≃+* ResidueField B) (hι : ∀ r, ι (residue A r) = residue B (g r)) :
    IsGoodCoordinate B (g (x' 0)) := by
  classical
  set X0 := g (x' 0) with hX0
  have hX0m : X0 ∈ maximalIdeal B := hmB ▸ Ideal.subset_span (by simp)
  have hY1m : Y 1 ∈ maximalIdeal B := hmB ▸ Ideal.subset_span (by simp)
  have hY2m : Y 2 ∈ maximalIdeal B := hmB ▸ Ideal.subset_span (by simp)
  -- the quadratic part of the relation does not involve `x₁`
  have hQ : ∑ p, ∑ q, g (a' p q) * (Y p * Y q) =
      g (a' 1 1) * (Y 1 * Y 1) + g (a' 1 2) * (Y 1 * Y 2) + g (a' 2 2) * (Y 2 * Y 2) := by
    simp only [Fin.sum_univ_three, h00, h01, h02, hupper' 1 0 (by decide),
      hupper' 2 0 (by decide), hupper' 2 1 (by decide), map_zero, zero_mul, zero_add, add_zero]
  set T := ∑ p, ∑ q, ∑ r, g (b' p q r) * (Y p * Y q * Y r) with hT
  set β₁ := g (b' 0 0 1) + g (b' 0 1 0) + g (b' 1 0 0) with hβ₁
  set β₂ := g (b' 0 0 2) + g (b' 0 2 0) + g (b' 2 0 0) with hβ₂
  set I : Ideal B := Ideal.span {Y 1, Y 2} with hI
  have hY1I : Y 1 ∈ I := Ideal.subset_span (by simp)
  have hY2I : Y 2 ∈ I := Ideal.subset_span (by simp)
  have hIm : I ≤ maximalIdeal B := by
    simp [hI, Ideal.span_le, Set.insert_subset_iff, hY1m, hY2m]
  have hTL : T - (g (b' 0 0 0) + β₁ * Y 1 + β₂ * Y 2) ∈ I ^ 2 :=
    sum_cubic_sub_linear_mem_sq I Y hY0 hY1I hY2I fun p q r => g (b' p q r)
  -- the constant term of the cubic part lies in `𝔪`, as `B` is singular
  have hb0 : b' 0 0 0 ∈ maximalIdeal A := by
    by_contra hb0
    have hunitb : IsUnit (g (b' 0 0 0)) := (notMem_maximalIdeal.mp hb0).map g
    have hkey : X0 * g (b' 0 0 0) =
        (g (a' 1 1) * (Y 1 * Y 1) + g (a' 1 2) * (Y 1 * Y 2) + g (a' 2 2) * (Y 2 * Y 2)) -
          X0 * (T - (g (b' 0 0 0) + β₁ * Y 1 + β₂ * Y 2)) - X0 * (β₁ * Y 1 + β₂ * Y 2) := by
      rw [← hQ, hchB]; ring
    have hmemI : X0 * g (b' 0 0 0) ∈ I := by
      rw [hkey]
      refine Ideal.sub_mem _ (Ideal.sub_mem _ ?_ ?_) ?_
      · refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) ?_
        · exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ hY1I)
        · exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ hY2I)
        · exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ hY2I)
      · exact Ideal.mul_mem_left _ _ (Ideal.pow_le_self (by norm_num) hTL)
      · exact Ideal.mul_mem_left _ _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hY1I)
          (Ideal.mul_mem_left _ _ hY2I))
    have hX0I : X0 ∈ I := by
      obtain ⟨w, hw⟩ := hunitb.exists_right_inv
      have h := Ideal.mul_mem_right w _ hmemI
      rwa [mul_assoc, hw, mul_one] at h
    refine hsing (isRegularLocalRing_of_maximalIdeal_eq_span_pair hdim (le_antisymm ?_ hIm))
    rw [hmB, Ideal.span_le]
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff, SetLike.mem_coe]
    exact ⟨hX0I, hY1I, hY2I⟩
  rw [← hspan', Submodule.mem_span_range_iff_exists_fun] at hb0
  obtain ⟨e, he⟩ := hb0
  have hgb : g (b' 0 0 0) = X0 * (g (e 0) + g (e 1) * Y 1 + g (e 2) * Y 2) := by
    rw [← he]
    simp only [Fin.sum_univ_three, smul_eq_mul, map_add, map_mul, hgx, hY0]
    ring
  -- the new relation
  let a'' : Fin 3 → Fin 3 → B := ![![-g (e 0), -β₁, -β₂], ![0, g (a' 1 1), g (a' 1 2)],
    ![0, 0, g (a' 2 2)]]
  have hupperB : ∀ p q, q < p → a'' p q = 0 := by
    intro p q hpq
    fin_cases p <;> fin_cases q <;> simp [a''] at hpq ⊢
  have hgoodB : IsGoodCoordinateForm fun p q => residue B (a'' p q) := by
    have hres : (restrictFirstVar fun p q => residue B (a'' p q)) =
        fun p q => ι (restrictFirstVar (fun p q => residue A (a' p q)) p q) := by
      funext p q
      simp only [restrictFirstVar_apply, hι]
      fin_cases p <;> fin_cases q <;> simp [a'', hupper' 2 1 (by decide)]
    unfold IsGoodCoordinateForm
    rw [hres, isScalarSqLinear_map_iff]
    exact hgood'
  refine ⟨![X0, Y 1, Y 2], a'', rfl, ?_, hupperB,
    exists_notMem_maximalIdeal_of_isGoodCoordinateForm hupperB hgoodB, ?_, hgoodB⟩
  · rw [hmB, Matrix.range_cons, Matrix.range_cons_cons_empty, Set.singleton_union]
  · have hid : ∑ p, ∑ q, a'' p q * (![X0, Y 1, Y 2] p * ![X0, Y 1, Y 2] q) =
        X0 * (T - (g (b' 0 0 0) + β₁ * Y 1 + β₂ * Y 2)) +
          X0 * X0 * (g (e 1) * Y 1 + g (e 2) * Y 2) := by
      have hQT := hQ.symm.trans hchB
      simp only [Fin.sum_univ_three, a'', Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
      linear_combination hQT + X0 * hgb
    rw [hid]
    refine Ideal.add_mem _ ?_ ?_
    · rw [pow_succ']
      exact Ideal.mul_mem_mul hX0m (Ideal.pow_right_mono hIm 2 hTL)
    · rw [pow_succ]
      refine Ideal.mul_mem_mul (by rw [pow_two]; exact Ideal.mul_mem_mul hX0m hX0m) ?_
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hY1m) (Ideal.mul_mem_left _ _ hY2m)

/-- Reindexing a quadratic expression and its variables by the same permutation does not change
its value. -/
private theorem sum_mul_mul_comp_perm {R : Type*} [CommRing R] {n : ℕ} (x : Fin n → R)
    (a : Fin n → Fin n → R) (σ : Equiv.Perm (Fin n)) :
    ∑ p, ∑ r, a (σ p) (σ r) * ((x ∘ σ) p * (x ∘ σ) r) = ∑ p, ∑ r, a p r * (x p * x r) := by
  rw [← Equiv.sum_comp σ (fun p => ∑ r, a p r * (x p * x r))]
  exact Finset.sum_congr rfl fun p _ => Equiv.sum_comp σ (fun r => a (σ p) r * (x (σ p) * x r))

/-- A form over a local ring which is upper triangular and not a scalar times a square modulo `𝔪`
has a unit entry on or above the diagonal. -/
private theorem exists_notMem_maximalIdeal_of_not_isScalarSqLinear_aux {B : Type*} [CommRing B]
    [IsLocalRing B] {n : ℕ} {a : Fin n → Fin n → B} (hupper : ∀ p q, q < p → a p q = 0)
    (hcase : ¬ IsScalarSqLinear fun p q => residue B (a p q)) :
    ∃ p q, p ≤ q ∧ a p q ∉ maximalIdeal B := by
  by_contra hcon
  simp only [not_exists, not_and, not_not] at hcon
  refine hcase (isScalarSqLinear_of_forall_eq_zero (fun p => ?_) fun p q hpq => ?_)
  · exact (residue_eq_zero_iff _).mpr (hcon p p le_rfl)
  · rw [(residue_eq_zero_iff _).mpr (hcon p q hpq.le), hupper q p hpq, map_zero, add_zero]

/-- If the form `a` is not a scalar times a square modulo `𝔪`, neither is the upper triangular
symmetrization of its reindexing by a permutation `σ`. -/
private theorem not_isScalarSqLinear_residue_upperSymm_comp_perm {A : Type*} [CommRing A]
    [IsLocalRing A] {a : Fin 3 → Fin 3 → A} {σ : Equiv.Perm (Fin 3)}
    (hcase : ¬ IsScalarSqLinear fun p r => residue A (a p r)) :
    ¬ IsScalarSqLinear fun p r => residue A (upperSymm (fun p r => a (σ p) (σ r)) p r) := by
  have hres : ∀ p r, residue A (upperSymm (fun p r => a (σ p) (σ r)) p r) =
      upperSymm (fun p r => residue A (a (σ p) (σ r))) p r :=
    fun p r => upperSymm_map (residue A) _ p r
  intro h
  refine hcase ?_
  rw [← isScalarSqLinear_comp_perm_iff _ σ]
  refine (isScalarSqLinear_congr (fun p => ?_) fun p r hpr => ?_).mp h
  · rw [hres, upperSymm_diag]
  · rw [hres, hres, upperSymm_add _ p r hpr]

/-! ### Points of the first chart -/

section Chart

variable {A : Type u} [CommRing A] [IsLocalRing A] {x : Fin 3 → A}
  (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away (x 0) S]

/-- The chart presentation sends the variable `yⱼ₊₁` to the class of the fraction `xⱼ₊₁/x₁`. -/
theorem chartPresentation_X (hx : ∀ i, x i ∈ maximalIdeal A) (j : Fin 2) :
    chartPresentation S hx (X j) = Ideal.Quotient.mk _ (chartFraction S hx j.succ) := by
  simp [chartPresentation]

/-- **Every element of the chart is a constant modulo `(y₂ - t₂, y₃ - t₃)`**, the chart being
generated over `A` by the fractions `y₂ = x₂/x₁`, `y₃ = x₃/x₁`. -/
theorem exists_sub_algebraMap_mem_span_chartFraction_sub (hx : ∀ i, x i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A) (t₁ t₂ : A)
    (z : affineBlowupAlgebra (maximalIdeal A) (x 0) S) :
    ∃ r : A, z - algebraMap A _ r ∈
      Ideal.span {chartFraction S hx 1 - algebraMap A _ t₁,
        chartFraction S hx 2 - algebraMap A _ t₂} := by
  have hz : z ∈ Algebra.adjoin A (Set.range (chartFraction S hx)) := by
    rw [adjoin_range_chartFraction_eq_top S hx hspan]; trivial
  induction hz using Algebra.adjoin_induction with
  | mem w hw =>
    obtain ⟨i, rfl⟩ := hw
    have hidx : ∀ r : Fin 3, r = 0 ∨ r = 1 ∨ r = 2 := by decide
    rcases hidx i with rfl | rfl | rfl
    · exact ⟨1, by simp [chartFraction_zero]⟩
    · exact ⟨t₁, Ideal.subset_span (by simp)⟩
    · exact ⟨t₂, Ideal.subset_span (by simp)⟩
  | algebraMap r => exact ⟨r, by simp⟩
  | add u v _ _ hu hv =>
    obtain ⟨r, hr⟩ := hu
    obtain ⟨s, hs⟩ := hv
    exact ⟨r + s, by rw [map_add, add_sub_add_comm]; exact Ideal.add_mem _ hr hs⟩
  | mul u v _ _ hu hv =>
    obtain ⟨r, hr⟩ := hu
    obtain ⟨s, hs⟩ := hv
    refine ⟨r * s, ?_⟩
    have heq : u * v - algebraMap A _ (r * s) =
        (u - algebraMap A _ r) * v + algebraMap A _ r * (v - algebraMap A _ s) := by
      rw [map_mul]; ring
    rw [heq]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hr) (Ideal.mul_mem_left _ _ hs)

/-- **A maximal ideal of the chart through the point `(t₂, t₃)` is that point.** A maximal ideal
of `A[𝔪/x₁]` containing `x₁, y₂ - t₂, y₃ - t₃` is generated by them. -/
theorem eq_span_chartFraction_sub_of_le (hx : ∀ i, x i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S)) [hM : M.IsMaximal] (t₁ t₂ : A)
    (hle : Ideal.span {algebraMap A _ (x 0), chartFraction S hx 1 - algebraMap A _ t₁,
      chartFraction S hx 2 - algebraMap A _ t₂} ≤ M) :
    M = Ideal.span {algebraMap A _ (x 0), chartFraction S hx 1 - algebraMap A _ t₁,
      chartFraction S hx 2 - algebraMap A _ t₂} := by
  refine le_antisymm (fun z hz => ?_) hle
  obtain ⟨r, hr⟩ := exists_sub_algebraMap_mem_span_chartFraction_sub S hx hspan t₁ t₂ z
  have hr' : z - algebraMap A _ r ∈ Ideal.span {algebraMap A _ (x 0),
      chartFraction S hx 1 - algebraMap A _ t₁, chartFraction S hx 2 - algebraMap A _ t₂} :=
    Ideal.span_mono (Set.insert_subset_insert le_rfl) (Ideal.span_mono (Set.subset_insert _ _) hr)
  have hrM : algebraMap A _ r ∈ M := by
    have h := M.sub_mem hz (hle hr')
    rwa [sub_sub_cancel] at h
  have hrm : r ∈ maximalIdeal A := by
    by_contra h
    exact hM.ne_top (Ideal.eq_top_of_isUnit_mem _ hrM ((notMem_maximalIdeal.mp h).map _))
  have h1 : algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) r ∈
      Ideal.span {algebraMap A _ (x 0), chartFraction S hx 1 - algebraMap A _ t₁,
        chartFraction S hx 2 - algebraMap A _ t₂} := by
    have h : algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) r ∈
        Ideal.span {algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)} := by
      rw [← affineBlowupAlgebra.map_ideal_eq_span_singleton (maximalIdeal A) (x 0) (hx 0)]
      exact Ideal.mem_map_of_mem _ hrm
    exact Ideal.span_mono (Set.singleton_subset_iff.mpr (Set.mem_insert _ _)) h
  have h := Ideal.add_mem _ hr' h1
  rwa [sub_add_cancel] at h

/-- The maximal ideal of `κ[y₂, y₃]` defined by a maximal ideal `𝔪'` of the chart containing
`𝔪A'`, through the presentation `κ[y₂, y₃] ↠ A'/x₁A'`, is a maximal ideal. -/
theorem isMaximal_comap_chartPresentation (hx : ∀ i, x i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S)) [hM : M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S))
      (maximalIdeal A) ≤ M) :
    ((M.map (Ideal.Quotient.mk (Ideal.span {algebraMap A
      (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)}))).comap
        (chartPresentation S hx)).IsMaximal := by
  let B := affineBlowupAlgebra (maximalIdeal A) (x 0) S
  let πQ : B →+* chartExceptionalQuotient (maximalIdeal A) (x 0) S :=
    Ideal.Quotient.mk (Ideal.span {algebraMap A B (x 0)})
  have hπQ : Function.Surjective πQ := Ideal.Quotient.mk_surjective
  have hx0 : algebraMap A B (x 0) ∈ M := hle (Ideal.mem_map_of_mem _ (hx 0))
  have hcomap : (M.map πQ).comap πQ = M :=
    Ideal.comap_map_mk ((Ideal.span_singleton_le_iff_mem M).mpr hx0)
  have hMbar : (M.map πQ).IsMaximal := by
    refine (Ideal.map_eq_top_or_isMaximal_of_surjective πQ hπQ hM).resolve_left fun htop => ?_
    rw [htop, Ideal.comap_top] at hcomap
    exact hM.ne_top hcomap.symm
  exact Ideal.comap_isMaximal_of_surjective _ (chartPresentation_surjective S hx hspan)

/-- An element of the chart whose class is the image of an element of the ideal of `κ[y₂, y₃]`
defined by `𝔪'` lies in `𝔪'`. -/
theorem mem_of_chartPresentation_mem (hx : ∀ i, x i ∈ maximalIdeal A)
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S))
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S))
      (maximalIdeal A) ≤ M) {f : MvPolynomial (Fin 2) (ResidueField A)}
    (hf : f ∈ (M.map (Ideal.Quotient.mk (Ideal.span {algebraMap A
      (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)}))).comap
        (chartPresentation S hx))
    {z : affineBlowupAlgebra (maximalIdeal A) (x 0) S}
    (hz : chartPresentation S hx f = Ideal.Quotient.mk _ z) : z ∈ M := by
  let B := affineBlowupAlgebra (maximalIdeal A) (x 0) S
  let πQ : B →+* chartExceptionalQuotient (maximalIdeal A) (x 0) S :=
    Ideal.Quotient.mk (Ideal.span {algebraMap A B (x 0)})
  have hx0 : algebraMap A B (x 0) ∈ M := hle (Ideal.mem_map_of_mem _ (hx 0))
  have hcomap : (M.map πQ).comap πQ = M :=
    Ideal.comap_map_mk ((Ideal.span_singleton_le_iff_mem M).mpr hx0)
  rw [← hcomap, Ideal.mem_comap]
  have hf' : chartPresentation S hx f ∈ M.map πQ := hf
  rw [hz] at hf'
  exact hf'

/-- **On the line `yⱼ = 0` of the chart the restricted conic is a double line.** In case I, if
the dehomogenized form lies in the square of the ideal of `κ[y₂, y₃]` defined by a maximal ideal
`𝔪'` of `A[𝔪/x₁]` containing `𝔪A'`, and the fraction `yⱼ = xⱼ/x₁` lies in `𝔪'` (`j = 2, 3`), then
the binary form obtained by setting `tⱼ = 0` is a scalar times a square. -/
theorem isScalarSqLinear_restrict_of_chartFraction_mem (hx : ∀ i, x i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (a : Fin 3 → Fin 3 → A) (hupper : ∀ p r, r < p → a p r = 0)
    (hunit : ∃ p r, p ≤ r ∧ a p r ∉ maximalIdeal A)
    (hcase : ¬ IsScalarSqLinear fun p r => residue A (a p r))
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S)) [hM : M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S))
      (maximalIdeal A) ≤ M)
    (hmem : dehomogenizeFirst (ResidueField A) 2 (quadraticFormPoly fun p r => residue A (a p r)) ∈
      ((M.map (Ideal.Quotient.mk (Ideal.span {algebraMap A
        (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)}))).comap
          (chartPresentation S hx)) ^ 2)
    (j : Fin 2) (hj : chartFraction S hx j.succ ∈ M) :
    IsScalarSqLinear fun p r : Fin 2 =>
      residue A (a (j.succ.succAbove p) (j.succ.succAbove r)) := by
  have hNmax := isMaximal_comap_chartPresentation S hx hspan M hle
  have hupper' : ∀ p r, r < p → residue A (a p r) = 0 := fun p r hrp => by
    rw [hupper p r hrp, map_zero]
  rw [dehomogenizeFirst_quadraticFormPoly_fin_three _ hupper'] at hmem
  obtain ⟨c, hc, hconst, hlin₂, hlin₃⟩ := exists_eval_eq_zero_and_chartPoint _ hupper'
    (by
      obtain ⟨p, r, hpr, hne⟩ := hunit
      exact ⟨p, r, hpr, fun h => hne ((residue_eq_zero_iff _).mp h)⟩)
    hcase _ hNmax.ne_top hmem
  have hXj : (X j : MvPolynomial (Fin 2) (ResidueField A)) ∈
      (M.map (Ideal.Quotient.mk (Ideal.span {algebraMap A
        (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)}))).comap
          (chartPresentation S hx) := by
    rw [Ideal.mem_comap, chartPresentation_X]
    exact Ideal.mem_map_of_mem _ hj
  have hcj : c j = 0 := by simpa using hc _ hXj
  exact isScalarSqLinear_restrict_of_chartPoint _ hupper' c hconst hlin₂ hlin₃ j hcj

/-- **A fraction which is a unit at `𝔪'` generates the exceptional ideal there.** On the chart
`A[𝔪/x₁]` the extension of `𝔪` is generated by `x₁`; if `yⱼ = xⱼ/x₁ ∉ 𝔪'`, then at `𝔪'` it is
generated by `xⱼ = x₁yⱼ` as well. -/
theorem map_maximalIdeal_localization_eq_span (hx : ∀ i, x i ∈ maximalIdeal A)
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S)) [M.IsPrime] (j : Fin 3)
    (hj : chartFraction S hx j ∉ M) :
    Ideal.map ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (x 0) S)
        (Localization.AtPrime M)).comp
        (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S))) (maximalIdeal A) =
      Ideal.span {algebraMap (affineBlowupAlgebra (maximalIdeal A) (x 0) S)
        (Localization.AtPrime M)
        (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x j))} := by
  rw [← Ideal.map_map, affineBlowupAlgebra.map_ideal_eq_span_singleton (maximalIdeal A) (x 0)
    (hx 0), Ideal.map_span, Set.image_singleton, ← algebraMap_mul_chartFraction S hx j,
    map_mul]
  have hu : IsUnit (algebraMap (affineBlowupAlgebra (maximalIdeal A) (x 0) S)
      (Localization.AtPrime M) (chartFraction S hx j)) :=
    IsLocalization.map_units (Localization.AtPrime M) (⟨_, hj⟩ : M.primeCompl)
  exact (Ideal.span_singleton_mul_right_unit hu _).symm

/-- **Stacks 0BGE, case I: a good coordinate cuts out the exceptional divisor at a singular
point.** Let `x₁, x₂, x₃` generate the maximal ideal of `A`, with a quadratic relation whose form
`q` has `x₁` as a good coordinate. Let `𝔪'` be a maximal ideal containing `𝔪A'` of a chart
`A' = A[𝔪/x_{σ 1}]` (generators reordered by `σ`), at which the dehomogenized reordered form lies
in the square of the point — which by
`AlgebraicGeometry.exists_chart_of_not_isRegularLocalRing_stalk_blowUp` holds at every singular
closed point of the blowup. Then the extension of `𝔪` to the local ring `A'_{𝔪'}` is generated by
`x₁`.

This is the source's "if `x₁` is a good coordinate, then the singular point `p ∈ E` of `X` does
not lie on the hypersurface `t₁ = 0` because either this does not have a rational point or if it
does, then it is not singular on `X`. Observe that this is equivalent to the statement that the
image of `x₁` in `𝒪_{X,p}` cuts out the exceptional divisor `E`." -/
theorem map_maximalIdeal_eq_span_of_isGoodCoordinateForm (x : Fin 3 → A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A) (a : Fin 3 → Fin 3 → A)
    (hupper : ∀ p r, r < p → a p r = 0) (hunit : ∃ p r, p ≤ r ∧ a p r ∉ maximalIdeal A)
    (hgood : IsGoodCoordinateForm fun p r => residue A (a p r)) (σ : Equiv.Perm (Fin 3))
    (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away ((x ∘ σ) 0) S]
    (hxσ : ∀ i, (x ∘ σ) i ∈ maximalIdeal A)
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) ((x ∘ σ) 0) S)) [hM : M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) ((x ∘ σ) 0) S))
      (maximalIdeal A) ≤ M)
    (hmem : dehomogenizeFirst (ResidueField A) 2
        (quadraticFormPoly fun p r => residue A (a (σ p) (σ r))) ∈
      ((M.map (Ideal.Quotient.mk (Ideal.span {algebraMap A
        (affineBlowupAlgebra (maximalIdeal A) ((x ∘ σ) 0) S) ((x ∘ σ) 0)}))).comap
          (chartPresentation S hxσ)) ^ 2) :
    Ideal.map ((algebraMap (affineBlowupAlgebra (maximalIdeal A) ((x ∘ σ) 0) S)
        (Localization.AtPrime M)).comp
        (algebraMap A (affineBlowupAlgebra (maximalIdeal A) ((x ∘ σ) 0) S))) (maximalIdeal A) =
      Ideal.span {algebraMap (affineBlowupAlgebra (maximalIdeal A) ((x ∘ σ) 0) S)
        (Localization.AtPrime M)
        (algebraMap A (affineBlowupAlgebra (maximalIdeal A) ((x ∘ σ) 0) S) (x 0))} := by
  have hspanσ : Ideal.span (Set.range (x ∘ σ)) = maximalIdeal A := by
    rw [Set.range_comp, Equiv.range_eq_univ, Set.image_univ, hspan]
  -- the position of the good coordinate among the reordered generators
  set i := σ.symm 0 with hi
  have hσi : (x ∘ σ) i = x 0 := by simp [hi]
  rw [← hσi]
  refine map_maximalIdeal_localization_eq_span S hxσ M i fun hmemi => ?_
  -- `i ≠ 0`: the fraction `x₁/x₁ = 1` is not in `𝔪'`
  obtain ⟨j, hj⟩ : ∃ j : Fin 2, j.succ = i := by
    refine Fin.cases (fun h => ?_) (fun j _ => ⟨j, rfl⟩) i hmemi
    rw [chartFraction_zero] at h
    exact absurd ((Ideal.eq_top_iff_one M).mpr h) hM.ne_top
  -- the upper triangular symmetrization of the reordered form
  set a' : Fin 3 → Fin 3 → A := upperSymm fun p r => a (σ p) (σ r) with ha'
  have hres : ∀ p r, residue A (a' p r) = upperSymm (fun p r => residue A (a (σ p) (σ r))) p r :=
    fun p r => upperSymm_map (residue A) _ p r
  have hcaseσ : ¬ IsScalarSqLinear fun p r => residue A (a' p r) :=
    not_isScalarSqLinear_residue_upperSymm_comp_perm hgood.not_isScalarSqLinear
  have hunit' := exists_notMem_maximalIdeal_of_not_isScalarSqLinear_aux
    (fun p r hrp => upperSymm_upper _ p r hrp) hcaseσ
  have hmem' : dehomogenizeFirst (ResidueField A) 2
      (quadraticFormPoly fun p r => residue A (a' p r)) ∈
      ((M.map (Ideal.Quotient.mk (Ideal.span {algebraMap A
        (affineBlowupAlgebra (maximalIdeal A) ((x ∘ σ) 0) S) ((x ∘ σ) 0)}))).comap
          (chartPresentation S hxσ)) ^ 2 := by
    have : (fun p r => residue A (a' p r)) = upperSymm fun p r => residue A (a (σ p) (σ r)) :=
      funext fun p => funext fun r => hres p r
    rw [this, quadraticFormPoly_upperSymm]
    exact hmem
  have hsq := isScalarSqLinear_restrict_of_chartFraction_mem S hxσ hspanσ a'
    (fun p r hrp => upperSymm_upper _ p r hrp) hunit' hcaseσ M hle hmem' j (hj ▸ hmemi)
  -- the restricted symmetrized form is the restricted reordered form, which is `q(0, t₂, t₃)`
  refine hgood ?_
  have h1 : IsScalarSqLinear fun p r : Fin 2 =>
      residue A (a (σ (j.succ.succAbove p)) (σ (j.succ.succAbove r))) := by
    refine (isScalarSqLinear_comp_congr (fun p r => residue A (a' p r))
      (fun p r => residue A (a (σ p) (σ r))) _ (Fin.strictMono_succAbove _)
      (fun p => by rw [hres, upperSymm_diag]) fun p r hpr => ?_).mp hsq
    rw [hres, hres, upperSymm_add _ p r hpr]
  rw [isScalarSqLinear_restrict_comp_perm_iff (fun p r => residue A (a p r)) σ j.succ, hj, hi,
    Equiv.apply_symm_apply] at h1
  have h2 : IsScalarSqLinear fun p r : Fin 2 => residue A (a p.succ r.succ) := by
    simpa [Fin.succAbove_zero] using h1
  exact h2

/-- The chart form of `AlgebraicGeometry.isGoodCoordinate_of_chartRelation`: the generators
`x₁, x₂ - ux₁, x₃ - vx₁` of `𝔪` give, at a maximal ideal `𝔪' = (x₁, y₂ - u, y₃ - v)` of
`A[𝔪/x₁]`, the chart fractions `y₂ - u, y₃ - v`. -/
theorem isGoodCoordinate_chart_aux (hx : ∀ i, x i ∈ maximalIdeal A)
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S)) [M.IsMaximal] (u v : A)
    (hMeq : M = Ideal.span {algebraMap A _ (x 0), chartFraction S hx 1 - algebraMap A _ u,
      chartFraction S hx 2 - algebraMap A _ v})
    (x' : Fin 3 → A) (a' : Fin 3 → Fin 3 → A) (b' : Fin 3 → Fin 3 → Fin 3 → A)
    (hspan' : Ideal.span (Set.range x') = maximalIdeal A) (hupper' : ∀ p q, q < p → a' p q = 0)
    (h00 : a' 0 0 = 0) (h01 : a' 0 1 = 0) (h02 : a' 0 2 = 0)
    (hgood' : IsGoodCoordinateForm fun p q => residue A (a' p q))
    (hrel' : ∑ p, ∑ q, a' p q * (x' p * x' q) = ∑ p, ∑ q, ∑ r, b' p q r * (x' p * x' q * x' r))
    (hx'0 : x' 0 = x 0) (hx'1 : x' 1 = x 1 - u * x 0) (hx'2 : x' 2 = x 2 - v * x 0)
    [IsNoetherianRing (Localization.AtPrime M)]
    (hdim : ringKrullDim (Localization.AtPrime M) = 2)
    (hsing : ¬ IsRegularLocalRing (Localization.AtPrime M))
    (ι : ResidueField A ≃+* ResidueField (Localization.AtPrime M))
    (hι : ∀ r, ι (residue A r) = residue _ (algebraMap (affineBlowupAlgebra (maximalIdeal A)
      (x 0) S) (Localization.AtPrime M) (algebraMap A _ r))) :
    IsGoodCoordinate (Localization.AtPrime M)
      (algebraMap (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (Localization.AtPrime M)
        (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0))) := by
  have hy : ∀ i, algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x' 0) *
      ![1, chartFraction S hx 1 - algebraMap A _ u, chartFraction S hx 2 - algebraMap A _ v] i =
      algebraMap A _ (x' i) := by
    have hidx : ∀ r : Fin 3, r = 0 ∨ r = 1 ∨ r = 2 := by decide
    intro i
    rcases hidx i with rfl | rfl | rfl
    · simp
    · rw [hx'0, hx'1, Matrix.cons_val_one, Matrix.cons_val_zero, mul_sub,
        algebraMap_mul_chartFraction S hx 1, map_sub, map_mul, mul_comm (algebraMap A _ u)]
    · simp only [hx'0, hx'2, Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
      rw [mul_sub, algebraMap_mul_chartFraction S hx 2, map_sub, map_mul,
        mul_comm (algebraMap A _ v)]
  have hreg : IsLeftRegular (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S)
      (x' 0)) := by
    rw [hx'0]
    exact (Stacks.Blowup.isRegular_algebraMap_affineBlowupAlgebra (maximalIdeal A) (x 0) S).left
  have hch := chart_relation (algebraMap A _) x' a' b' _ hy hreg hrel'
  have hchB := congrArg (algebraMap (affineBlowupAlgebra (maximalIdeal A) (x 0) S)
    (Localization.AtPrime M)) hch
  simp only [map_sum, map_mul] at hchB
  have key := isGoodCoordinate_of_chartRelation hdim hsing x' hspan' a' b' hupper' h00 h01 h02
    hgood' ((algebraMap _ (Localization.AtPrime M)).comp (algebraMap A _))
    (fun i => algebraMap _ (Localization.AtPrime M)
      (![1, chartFraction S hx 1 - algebraMap A _ u, chartFraction S hx 2 - algebraMap A _ v] i))
    (by simp) ?_ (fun i => ?_) hchB ι hι
  · simpa only [RingHom.comp_apply, hx'0] using key
  · rw [← Localization.AtPrime.map_eq_maximalIdeal,
      congrArg (Ideal.map (algebraMap _ (Localization.AtPrime M))) hMeq, Ideal.map_span, hx'0]
    simp [Set.image_insert_eq, Set.image_singleton]
  · simp only [RingHom.comp_apply]
    rw [← map_mul, hy i]

/-- The chart presentation sends `yⱼ₊₁ - t̄` to the class of `xⱼ₊₁/x₁ - t`. -/
theorem chartPresentation_X_sub_C (hx : ∀ i, x i ∈ maximalIdeal A) (j : Fin 2) (t : A) :
    chartPresentation S hx (X j - C (residue A t)) =
      Ideal.Quotient.mk _ (chartFraction S hx j.succ - algebraMap A _ t) := by
  simp [chartPresentation]

/-- **Stacks 0BGE, case I: at a singular point of the chart of a good coordinate, the good
coordinate is again a good coordinate.** Let `x₁, x₂, x₃` generate the maximal ideal of `A`, with
a quadratic relation `Σ aₚᵩ xₚxᵩ ∈ 𝔪³` (upper triangular `a`) whose form has `x₁` as a good
coordinate. Let `𝔪'` be a maximal ideal of `A' = A[𝔪/x₁]` containing `𝔪A'` at which
`B = A'_{𝔪'}` is Noetherian of dimension two and singular. Then

* the point is `κ`-rational: `A → A'/𝔪'` is surjective;
* `x₁` is a good coordinate of `B`: the maximal ideal of `B` is generated by `x₁, y₂ - u, y₃ - v`
  (the point moved to the origin), which satisfy a quadratic relation in `B` whose form `q'` has
  `q'(0, t₂, t₃) = q(0, t₂, t₃)` (`AlgebraicGeometry.isGoodCoordinate_of_chartRelation`).

This is the computation of the source's "Resolution in case I" after it chooses the generators so
that the singular point is `y₂ = y₃ = 0`. -/
theorem isGoodCoordinate_localization_of_chart (hx : ∀ i, x i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A) (a : Fin 3 → Fin 3 → A)
    (hupper : ∀ p r, r < p → a p r = 0)
    (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3)
    (hgood : IsGoodCoordinateForm fun p r => residue A (a p r))
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S)) [hM : M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S))
      (maximalIdeal A) ≤ M)
    [IsNoetherianRing (Localization.AtPrime M)]
    (hdim : ringKrullDim (Localization.AtPrime M) = 2)
    (hsing : ¬ IsRegularLocalRing (Localization.AtPrime M)) :
    Function.Surjective ((Ideal.Quotient.mk M).comp
        (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S))) ∧
      IsGoodCoordinate (Localization.AtPrime M)
        (algebraMap (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (Localization.AtPrime M)
          (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0))) := by
  classical
  have hunit := exists_notMem_maximalIdeal_of_isGoodCoordinateForm hupper hgood
  have hcase := hgood.not_isScalarSqLinear
  have hmem := dehomogenizeFirst_quadraticFormPoly_mem_sq_of_not_isRegularLocalRing S hx hspan a
    hrel M hle hdim hsing
  have hsurj := surjective_algebraMap_quotient_of_not_isScalarSqLinear_of_mem_sq S hx hspan a
    hupper hunit hcase M hle hmem
  refine ⟨hsurj, ?_⟩
  -- the relation with its cubic terms written out
  have hrel3 := hrel
  rw [← hspan, span_pow_three_eq_span_triples] at hrel3
  obtain ⟨b, hb⟩ := exists_triple_expansion x hrel3
  -- the point of the chart and the generators moving it to the origin
  have hNmax := isMaximal_comap_chartPresentation S hx hspan M hle
  have hupperk : ∀ p r, r < p → residue A (a p r) = 0 := fun p r hrp => by
    rw [hupper p r hrp, map_zero]
  rw [dehomogenizeFirst_quadraticFormPoly_fin_three _ hupperk] at hmem
  obtain ⟨c, hc, hconst, hlin₂, hlin₃⟩ := exists_eval_eq_zero_and_chartPoint _ hupperk
    (by
      obtain ⟨p, r, hpr, hne⟩ := hunit
      exact ⟨p, r, hpr, fun h => hne ((residue_eq_zero_iff _).mp h)⟩)
    hcase _ hNmax.ne_top hmem
  obtain ⟨x', a', b', hspan', hupper', h00, h01, h02, -, -, hrel', hgood', hx'0, u, v, hu, hv,
    hx'1, hx'2⟩ := exists_quadraticRelation_vanishing_first_row x hspan a b hupper hb hcase c
      hconst hlin₂ hlin₃
  have hNeq := hNmax.eq_of_le (RingHom.ker_ne_top (MvPolynomial.eval c)) fun f hf => hc f hf
  have hz : ∀ (j : Fin 2) (t : A), residue A t = c j →
      chartFraction S hx j.succ - algebraMap A _ t ∈ M := by
    intro j t ht
    refine mem_of_chartPresentation_mem S hx M hle (f := X j - C (residue A t)) ?_
      (chartPresentation_X_sub_C S hx j t)
    rw [hNeq, RingHom.mem_ker, map_sub, eval_X, eval_C, ht, sub_self]
  have hMeq := eq_span_chartFraction_sub_of_le S hx hspan M u v <| Ideal.span_le.mpr <| by
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff, SetLike.mem_coe]
    exact ⟨hle (Ideal.mem_map_of_mem _ (hx 0)), hz 0 u hu, hz 1 v hv⟩
  obtain ⟨ι, hι⟩ := exists_residueField_ringEquiv_of_surjective M hle hsurj
  exact isGoodCoordinate_chart_aux S hx M u v hMeq x' a' b' hspan' hupper' h00 h01 h02
    hgood' hrel' hx'0 hx'1 hx'2 hdim hsing ι hι

/-- **Stacks 0BGE, case I: a good coordinate cuts out the exceptional divisor at every singular
point of the blowup**, in the form with a good coordinate of the local ring. If `g = x₁` is a
good coordinate of `A` and `𝔪'` is a maximal ideal containing `𝔪A'` of a chart `A' = A[𝔪/x_{σ 1}]`
at which `A'_{𝔪'}` is Noetherian of dimension two and singular, then `𝔪A'_{𝔪'} = gA'_{𝔪'}`. -/
theorem map_maximalIdeal_eq_span_of_isGoodCoordinate [IsNoetherianRing A] (x : Fin 3 → A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A) (a : Fin 3 → Fin 3 → A)
    (hupper : ∀ p r, r < p → a p r = 0)
    (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3)
    (hgood : IsGoodCoordinateForm fun p r => residue A (a p r)) (σ : Equiv.Perm (Fin 3))
    (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away ((x ∘ σ) 0) S]
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) ((x ∘ σ) 0) S)) [hM : M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) ((x ∘ σ) 0) S))
      (maximalIdeal A) ≤ M)
    [IsNoetherianRing (Localization.AtPrime M)]
    (hdim : ringKrullDim (Localization.AtPrime M) = 2)
    (hsing : ¬ IsRegularLocalRing (Localization.AtPrime M)) :
    Ideal.map ((algebraMap (affineBlowupAlgebra (maximalIdeal A) ((x ∘ σ) 0) S)
        (Localization.AtPrime M)).comp
        (algebraMap A (affineBlowupAlgebra (maximalIdeal A) ((x ∘ σ) 0) S))) (maximalIdeal A) =
      Ideal.span {algebraMap (affineBlowupAlgebra (maximalIdeal A) ((x ∘ σ) 0) S)
        (Localization.AtPrime M)
        (algebraMap A (affineBlowupAlgebra (maximalIdeal A) ((x ∘ σ) 0) S) (x 0))} := by
  have hspanσ : Ideal.span (Set.range (x ∘ σ)) = maximalIdeal A := by
    rw [Set.range_comp, Equiv.range_eq_univ, Set.image_univ, hspan]
  have hxσ : ∀ i, (x ∘ σ) i ∈ maximalIdeal A := fun i => hspanσ ▸ Ideal.subset_span ⟨i, rfl⟩
  have hrelσ : ∑ p, ∑ r, a (σ p) (σ r) * ((x ∘ σ) p * (x ∘ σ) r) ∈ maximalIdeal A ^ 3 := by
    rwa [sum_mul_mul_comp_perm]
  exact map_maximalIdeal_eq_span_of_isGoodCoordinateForm x hspan a hupper
    (exists_notMem_maximalIdeal_of_isGoodCoordinateForm hupper hgood) hgood σ S hxσ M hle
    (dehomogenizeFirst_quadraticFormPoly_mem_sq_of_not_isRegularLocalRing S hxσ hspanσ _ hrelσ M
      hle hdim hsing)

/-! ### Reordering the generators -/

/-- **Reordering the generators of a relation.** If `Σ aₚᵩ xₚxᵩ ∈ 𝔪³` with `a` upper triangular,
then for every permutation `σ` the upper triangular symmetrization `a'` of `a(σ·, σ·)` gives a
relation `Σ a'ₚᵩ x_{σp}x_{σq} ∈ 𝔪³`; a unit entry, case I and a good coordinate at the generator
`x_{σ 0}` are inherited. -/
theorem relation_comp_perm (x : Fin 3 → A) (a : Fin 3 → Fin 3 → A)
    (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3) (σ : Equiv.Perm (Fin 3)) :
    (∀ p r, r < p → upperSymm (fun p r => a (σ p) (σ r)) p r = 0) ∧
      ∑ p, ∑ r, upperSymm (fun p r => a (σ p) (σ r)) p r * ((x ∘ σ) p * (x ∘ σ) r) ∈
        maximalIdeal A ^ 3 ∧
      ((¬ IsScalarSqLinear fun p r => residue A (a p r)) →
        ¬ IsScalarSqLinear fun p r => residue A (upperSymm (fun p r => a (σ p) (σ r)) p r)) := by
  refine ⟨fun p r hrp => upperSymm_upper _ p r hrp, ?_,
    not_isScalarSqLinear_residue_upperSymm_comp_perm⟩
  rwa [sum_upperSymm, sum_mul_mul_comp_perm]

/-- In case I a quadratic form has a unit entry on or above the diagonal. -/
theorem exists_notMem_maximalIdeal_of_not_isScalarSqLinear {a : Fin 3 → Fin 3 → A}
    (hupper : ∀ p r, r < p → a p r = 0)
    (hcase : ¬ IsScalarSqLinear fun p r => residue A (a p r)) :
    ∃ p r, p ≤ r ∧ a p r ∉ maximalIdeal A :=
  exists_notMem_maximalIdeal_of_not_isScalarSqLinear_aux hupper hcase

/-- **The good coordinate cuts out the exceptional divisor on every chart** (the chart attached to
the generator `xⱼ`, for any `j`): `AlgebraicGeometry.map_maximalIdeal_eq_span_of_isGoodCoordinate`
with the chart `A[𝔪/xⱼ]` written with its own generator. -/
theorem map_maximalIdeal_eq_span_of_isGoodCoordinate_chart [IsNoetherianRing A] (x : Fin 3 → A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A) (a : Fin 3 → Fin 3 → A)
    (hupper : ∀ p r, r < p → a p r = 0)
    (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3)
    (hgood : IsGoodCoordinateForm fun p r => residue A (a p r)) (j : Fin 3)
    (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away (x j) S]
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x j) S)) [M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x j) S))
      (maximalIdeal A) ≤ M)
    [IsNoetherianRing (Localization.AtPrime M)]
    (hdim : ringKrullDim (Localization.AtPrime M) = 2)
    (hsing : ¬ IsRegularLocalRing (Localization.AtPrime M)) :
    Ideal.map ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (x j) S)
        (Localization.AtPrime M)).comp
        (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x j) S))) (maximalIdeal A) =
      Ideal.span {algebraMap (affineBlowupAlgebra (maximalIdeal A) (x j) S)
        (Localization.AtPrime M)
        (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x j) S) (x 0))} := by
  have key : ∀ (b : A) (hb : b = (x ∘ Equiv.swap 0 j) 0) [IsLocalization.Away b S]
      (M : Ideal (affineBlowupAlgebra (maximalIdeal A) b S)) [M.IsMaximal]
      (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) b S))
        (maximalIdeal A) ≤ M) [IsNoetherianRing (Localization.AtPrime M)]
      (hdim : ringKrullDim (Localization.AtPrime M) = 2)
      (hsing : ¬ IsRegularLocalRing (Localization.AtPrime M)),
      Ideal.map ((algebraMap (affineBlowupAlgebra (maximalIdeal A) b S)
          (Localization.AtPrime M)).comp
          (algebraMap A (affineBlowupAlgebra (maximalIdeal A) b S))) (maximalIdeal A) =
        Ideal.span {algebraMap (affineBlowupAlgebra (maximalIdeal A) b S)
          (Localization.AtPrime M)
          (algebraMap A (affineBlowupAlgebra (maximalIdeal A) b S) (x 0))} := by
    intro b hb _ M _ hle _ hdim hsing
    subst hb
    exact map_maximalIdeal_eq_span_of_isGoodCoordinate x hspan a hupper hrel hgood _ S M hle
      hdim hsing
  exact key (x j) (by simp) M hle hdim hsing

/-- **A good coordinate exists in case I** (the source's "We have seen above that a good
coordinate exists"): if the quadratic form of `x₁, x₂, x₃` is in case I and the chart
`A[𝔪/xⱼ]` has a maximal ideal `𝔪' ⊇ 𝔪A'` at which the local ring is Noetherian of dimension two
and singular, then `A` has a good coordinate. -/
theorem exists_isGoodCoordinate_of_chart [IsNoetherianRing A] (x : Fin 3 → A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A) (a : Fin 3 → Fin 3 → A)
    (hupper : ∀ p r, r < p → a p r = 0)
    (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3)
    (hcase : ¬ IsScalarSqLinear fun p r => residue A (a p r)) (j : Fin 3)
    (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away (x j) S]
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x j) S)) [M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x j) S))
      (maximalIdeal A) ≤ M)
    [IsNoetherianRing (Localization.AtPrime M)]
    (hdim : ringKrullDim (Localization.AtPrime M) = 2)
    (hsing : ¬ IsRegularLocalRing (Localization.AtPrime M)) :
    ∃ g, IsGoodCoordinate A g := by
  classical
  set σ := Equiv.swap (0 : Fin 3) j
  have hspanσ : Ideal.span (Set.range (x ∘ σ)) = maximalIdeal A := by
    rw [Set.range_comp, Equiv.range_eq_univ, Set.image_univ, hspan]
  have hxσ : ∀ i, (x ∘ σ) i ∈ maximalIdeal A := fun i => hspanσ ▸ Ideal.subset_span ⟨i, rfl⟩
  obtain ⟨hupper', hrel', hcase'⟩ := relation_comp_perm x a hrel σ
  have hcase'' := hcase' hcase
  set a' := upperSymm fun p r => a (σ p) (σ r)
  have hunit' := exists_notMem_maximalIdeal_of_not_isScalarSqLinear hupper' hcase''
  have key : ∀ (b : A) (hb : b = (x ∘ σ) 0) [IsLocalization.Away b S]
      (M : Ideal (affineBlowupAlgebra (maximalIdeal A) b S)) [M.IsMaximal]
      (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) b S))
        (maximalIdeal A) ≤ M) [IsNoetherianRing (Localization.AtPrime M)]
      (hdim : ringKrullDim (Localization.AtPrime M) = 2)
      (hsing : ¬ IsRegularLocalRing (Localization.AtPrime M)), ∃ g, IsGoodCoordinate A g := by
    intro b hb _ M _ hle _ hdim hsing
    subst hb
    have hmem := dehomogenizeFirst_quadraticFormPoly_mem_sq_of_not_isRegularLocalRing S hxσ
      hspanσ a' hrel' M hle hdim hsing
    have hNmax := isMaximal_comap_chartPresentation S hxσ hspanσ M hle
    rw [dehomogenizeFirst_quadraticFormPoly_fin_three _
      (fun p r hrp => by rw [hupper' p r hrp, map_zero])] at hmem
    have hrel3 := hrel'
    rw [← hspanσ, span_pow_three_eq_span_triples] at hrel3
    obtain ⟨b, hb⟩ := exists_triple_expansion (x ∘ σ) hrel3
    obtain ⟨x'', a'', b'', hspan'', hupper'', -, -, -, -, hunit'', hrel'', hgood''⟩ :=
      exists_isGoodCoordinateForm_of_dehomogenized_mem_sq (x ∘ σ) hspanσ a' b hupper' hunit' hb
        hcase'' _ hNmax.ne_top hmem
    refine ⟨x'' 0, x'', a'', rfl, hspan'', hupper'', hunit'', ?_, hgood''⟩
    rw [hrel'', ← hspan'', span_pow_three_eq_span_triples]
    exact Ideal.sum_mem _ fun p _ => Ideal.sum_mem _ fun q _ => Ideal.sum_mem _ fun r _ =>
      Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨(p, q, r), rfl⟩)
  exact key (x j) (by simp [σ]) M hle hdim hsing

end Chart

