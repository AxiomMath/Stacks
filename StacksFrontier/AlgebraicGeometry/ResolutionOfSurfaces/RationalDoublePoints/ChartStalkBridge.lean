module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.BlowUpPointTransport
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ClosedPointChart
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ExceptionalFromChart
public import StacksFrontier.AlgebraicGeometry.Divisors.FittingIdeals.Basic

/-!
# The local ring at a point of a chart of the blowup, compatibly with the base

Let `A` be a local ring whose maximal ideal is generated by `x₁, x₂, x₃`, and let `z` be a closed
point of the blowup of `Spec A` in the maximal ideal lying in the standard affine chart attached
to `xⱼ`, with coordinate ring `A' = A[𝔪/xⱼ]`. The local ring at `z` is the localization of `A'` at
a maximal ideal `M` containing `𝔪A'`
(`AlgebraicGeometry.exists_isMaximal_ringEquiv_stalk_of_chart`). This file records that this
identification is *compatible with the maps from `A`*: under it,
`AlgebraicGeometry.maximalIdealBlowUpStalkHom` becomes the structure map `A → A' → A'_M`. Thus the
chart computations of Section 54.12 of the Stacks Project, which are statements about `A'_M`,
become statements about the local rings of the blowup.

The file also gives the converse of the chart criterion [Stacks, Tag 0BFL] in this setting: a
point at which `xⱼ` cuts out the exceptional divisor lies in the chart attached to `xⱼ`.

## Main results

* `AlgebraicGeometry.exists_isMaximal_ringEquiv_stalk_compat_of_mem_chart`: the compatible
  identification at a point of the chart attached to `xⱼ`.
* `AlgebraicGeometry.exists_mem_chart_of_isClosed`: every point lies in one of the charts.
* `AlgebraicGeometry.mem_chart_of_map_maximalIdeal_eq_span`: a point at which `xⱼ` generates the
  extension of the maximal ideal lies in the chart attached to `xⱼ`.

## References

* [Stacks Project, Tag 0BFL](https://stacks.math.columbia.edu/tag/0BFL)
* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
-/

@[expose] public noncomputable section

open CategoryTheory IsLocalRing TopologicalSpace

universe u

namespace AlgebraicGeometry

variable (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]

/-- The affine open `Spec A` of itself. -/
abbrev specTopAffineOpen : (Spec (.of A)).affineOpens := ⟨⊤, isAffineOpen_top _⟩

variable {A} in
/-- The section of the maximal ideal sheaf over `Spec A` given by an element of the maximal ideal.
-/
abbrev maximalIdealSheafSection {b : A} (hb : b ∈ maximalIdeal A) :
    (maximalIdealSheaf A).ideal (specTopAffineOpen A) :=
  ⟨(Scheme.ΓSpecIso (.of A)).inv.hom b,
    mem_ideal_ofIdealTop_isAffineOpen_top A (maximalIdeal A) hb⟩

omit [IsNoetherianRing A] in
/-- The ideal of the maximal ideal sheaf over `Spec A` is the image of the maximal ideal. -/
theorem ideal_maximalIdealSheaf_specTopAffineOpen :
    (maximalIdealSheaf A).ideal (specTopAffineOpen A) =
      (maximalIdeal A).map (Scheme.ΓSpecIso (.of A)).inv.hom := by
  simp [maximalIdealSheaf]

variable {A} in
/-- A point of the blowup of `Spec A` in the maximal ideal lies in the standard affine chart
attached to an element `b` of the maximal ideal. -/
def MemChart {b : A} (hb : b ∈ maximalIdeal A) (z : blowUp (maximalIdealSheaf A)) : Prop :=
  z ∈ Set.range (blowupChartι (maximalIdealSheaf A) (specTopAffineOpen A)
    (maximalIdealSheafSection hb))

/-- The stalk maps along an abstract chart `j : Spec B ⟶ blowUp I` over an affine open `U`, read
through `B`: the germ of a section of `U`, pushed to the stalk of the blowup and then to the stalk
of `Spec B`, is the germ in `Spec B` of its image in `B`. -/
theorem germ_stalkMap_stalkMap_of_chart {X : Scheme.{u}} (I : X.IdealSheafData)
    (U : X.affineOpens) (B : CommRingCat.{u}) (j : Spec B ⟶ blowUp I) (q : Γ(X, U.1) ⟶ B)
    (hj : j ≫ blowUpToBase I = Spec.map q ≫ U.2.fromSpec) (w : Spec B)
    (hw : blowUpToBase I (j w) ∈ U.1) :
    X.presheaf.germ U.1 (blowUpToBase I (j w)) hw ≫
        (blowUpToBase I).stalkMap (j w) ≫ j.stalkMap w =
      q ≫ StructureSheaf.toStalk B w := by
  have : IsOpenImmersion U.2.fromSpec := IsAffineOpen.isOpenImmersion_fromSpec U.2
  apply Spec.map_injective
  apply (cancel_mono U.2.fromSpec).mp
  simp only [Spec.map_comp, Category.assoc]
  rw [show Spec.map (X.presheaf.germ U.1 (blowUpToBase I (j w)) hw) ≫ U.2.fromSpec =
    X.fromSpecStalk (blowUpToBase I (j w)) from U.2.fromSpecStalk_eq_fromSpecStalk hw,
    Scheme.SpecMap_stalkMap_fromSpecStalk, ← Category.assoc,
    Scheme.SpecMap_stalkMap_fromSpecStalk, Category.assoc, hj, Spec.fromSpecStalk_eq']
  exact (Category.assoc _ _ _).symm.trans
    (congrArg (fun v => v ≫ U.2.fromSpec) (Spec.map_comp q (StructureSheaf.toStalk B w)).symm)

/-- The stalk isomorphism of `Spec C` sends the germ of `c` to its image in the localization. -/
theorem Spec.stalkIso_hom_toStalk (C : CommRingCat.{u}) (w : Spec C) (c : C) :
    (Spec.stalkIso C w).hom (StructureSheaf.toStalk C w c) =
      algebraMap C (Localization.AtPrime w.asIdeal) c := by
  have h := congrArg (fun f => f.hom ((Scheme.ΓSpecIso C).inv.hom c))
    (Spec.germ_stalkMapIso_hom (R := C) (x := w))
  rw [show StructureSheaf.toStalk C w c =
    (Spec C).presheaf.germ ⊤ w trivial ((Scheme.ΓSpecIso C).inv.hom c) from rfl]
  simpa using h

/-- **The local ring at a closed point of an abstract chart, compatibly with the base.** For an
abstract affine chart `ι : Spec C ⟶ blowUp (maximalIdealSheaf A)` over the whole of `Spec A`,
given with an isomorphism of `C` with `A[𝔪/b]` compatible with the maps from `A`, the local ring
at a closed point `ι w` is the localization of `A[𝔪/b]` at a maximal ideal containing
`𝔪A[𝔪/b]`, through an isomorphism under which `AlgebraicGeometry.maximalIdealBlowUpStalkHom` is
the structure map. It is stated for an abstract chart so that the coordinate ring of a concrete
chart is never unfolded. -/
theorem exists_isMaximal_ringEquiv_stalk_compat_of_chart {C : CommRingCat.{u}}
    (ι : Spec C ⟶ blowUp (maximalIdealSheaf A)) [IsOpenImmersion ι]
    (φ : Γ(Spec (.of A), ⊤) ⟶ C)
    (hι : ι ≫ blowUpToBase (maximalIdealSheaf A) =
      Spec.map φ ≫ (isAffineOpen_top (Spec (.of A))).fromSpec)
    (b : A) (E : affineBlowupAlgebra (maximalIdeal A) b (Localization.Away b) ≃+* C)
    (hE : ∀ r : A, E (algebraMap A _ r) = φ ((Scheme.ΓSpecIso (.of A)).inv.hom r))
    (w : Spec C) (hq : IsClosed ({ι w} : Set (blowUp (maximalIdealSheaf A)))) :
    ∃ M : Ideal (affineBlowupAlgebra (maximalIdeal A) b (Localization.Away b)),
      M.IsMaximal ∧
      Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) b (Localization.Away b)))
        (maximalIdeal A) ≤ M ∧
      ∃ (_ : M.IsPrime)
        (ε : (blowUp (maximalIdealSheaf A)).presheaf.stalk (ι w) ≃+* Localization.AtPrime M),
        ∀ a : A, ε (maximalIdealBlowUpStalkHom A (ι w) a) =
          algebraMap _ (Localization.AtPrime M)
            (algebraMap A (affineBlowupAlgebra (maximalIdeal A) b (Localization.Away b)) a) := by
  have hbase := blowUpToBase_eq_closedPoint_of_isClosed A _ hq
  obtain ⟨hzmax, -, -⟩ := isMaximal_and_nonempty_ringEquiv_of_isOpenImmersion ι w hq
  have hMmax : (w.asIdeal.comap E.toRingHom).IsMaximal :=
    Ideal.comap_isMaximal_of_surjective _ E.surjective
  -- the chart point lies over the closed point
  have hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) b
      (Localization.Away b))) (maximalIdeal A) ≤ w.asIdeal.comap E.toRingHom := by
    have hz : (blowUpToBase (maximalIdealSheaf A)).base (ι w) =
        (isAffineOpen_top (Spec (.of A))).fromSpec (Spec.map φ w) := by
      simpa only [Scheme.Hom.comp_apply] using congrArg (fun f => f w) hι
    rw [hz, IsAffineOpen.fromSpec_top, Scheme.isoSpec_Spec_inv] at hbase
    have hcomap := congrArg PrimeSpectrum.asIdeal hbase
    rw [Ideal.map_le_iff_le_comap]
    intro r hr
    have hr' : r ∈ (closedPoint A).asIdeal := hr
    rw [← hcomap] at hr'
    show E (algebraMap A _ r) ∈ w.asIdeal
    rwa [hE r]
  let ε : (blowUp (maximalIdealSheaf A)).presheaf.stalk (ι w) ≃+*
      Localization.AtPrime (w.asIdeal.comap E.toRingHom) :=
    (asIso (ι.stalkMap w)).commRingCatIsoToRingEquiv.trans
      ((Spec.stalkIso C w).commRingCatIsoToRingEquiv.trans
        (Localization.localRingEquiv _ w.asIdeal E rfl).symm)
  refine ⟨_, hMmax, hle, hMmax.isPrime, ε, fun a => ?_⟩
  -- the stalk map of the chart, read through the chart ring
  have h3 : (ι.stalkMap w).hom (maximalIdealBlowUpStalkHom A (ι w) a) =
      StructureSheaf.toStalk C w (φ ((Scheme.ΓSpecIso (.of A)).inv.hom a)) :=
    congrArg (fun f => f.hom ((Scheme.ΓSpecIso (.of A)).inv.hom a))
      (germ_stalkMap_stalkMap_of_chart (maximalIdealSheaf A) (specTopAffineOpen A) C ι φ hι w
        (show _ ∈ (⊤ : (Spec (.of A)).Opens) from trivial))
  show (Localization.localRingEquiv _ w.asIdeal E rfl).symm
    ((Spec.stalkIso C w).hom ((ι.stalkMap w).hom (maximalIdealBlowUpStalkHom A (ι w) a))) = _
  rw [h3, Spec.stalkIso_hom_toStalk, ← hE a]
  exact (RingEquiv.symm_apply_eq _).2
    (Localization.localRingHom_to_map _ w.asIdeal E.toRingHom rfl _).symm

/-- **The local ring at a closed point of a chart, compatibly with the base.** -/
theorem exists_isMaximal_ringEquiv_stalk_compat_of_memChart {b : A}
    (hb : b ∈ maximalIdeal A) (z : blowUp (maximalIdealSheaf A))
    (hzc : IsClosed ({z} : Set (blowUp (maximalIdealSheaf A)))) (hz : MemChart hb z) :
    ∃ M : Ideal (affineBlowupAlgebra (maximalIdeal A) b (Localization.Away b)),
      M.IsMaximal ∧
      Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) b (Localization.Away b)))
        (maximalIdeal A) ≤ M ∧
      ∃ (_ : M.IsPrime)
        (ε : (blowUp (maximalIdealSheaf A)).presheaf.stalk z ≃+* Localization.AtPrime M),
        ∀ a : A, ε (maximalIdealBlowUpStalkHom A z a) =
          algebraMap _ (Localization.AtPrime M)
            (algebraMap A (affineBlowupAlgebra (maximalIdeal A) b (Localization.Away b)) a) := by
  obtain ⟨E, hE⟩ := exists_ringEquiv_blowupChartRing_ofIdealTop A (maximalIdeal A) b
    (maximalIdealSheafSection hb) rfl
  obtain ⟨y, rfl⟩ := hz
  exact exists_isMaximal_ringEquiv_stalk_compat_of_chart A _ _
    (blowupChartι_comp_blowUpToBase (maximalIdealSheaf A) (specTopAffineOpen A)
      (maximalIdealSheafSection hb)) b E hE y hzc

omit [IsNoetherianRing A] in
/-- **Every point of the blowup of `Spec A` in `𝔪 = (x₁, x₂, x₃)` lies in one of the three
standard charts.** -/
theorem exists_memChart (x : Fin 3 → A) (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (z : blowUp (maximalIdealSheaf A)) :
    ∃ j : Fin 3, MemChart (hspan ▸ Ideal.subset_span ⟨j, rfl⟩ : x j ∈ maximalIdeal A) z := by
  let ψ : A →+* Γ(Spec (.of A), ⊤) := (Scheme.ΓSpecIso (.of A)).inv.hom
  have hspanI : ((maximalIdealSheaf A).ideal (specTopAffineOpen A) :
      Ideal Γ(Spec (.of A), ⊤)) ≤ Ideal.span (Set.range fun j => ψ (x j)) := by
    rw [ideal_maximalIdealSheaf_specTopAffineOpen, ← hspan, Ideal.map_span, ← Set.range_comp]
    rfl
  exact exists_mem_range_blowupChartι (maximalIdealSheaf A) (specTopAffineOpen A)
    (fun j => ψ (x j))
    (fun j => mem_ideal_ofIdealTop_isAffineOpen_top A (maximalIdeal A)
      (hspan ▸ Ideal.subset_span ⟨j, rfl⟩))
    hspanI z trivial

omit [IsNoetherianRing A] in
/-- **A point at which `b` cuts out the exceptional divisor lies in the chart attached to `b`.**
This is the converse direction of [Stacks, Tag 0BFL] for the blowup of `Spec A` in the maximal
ideal, with the exceptional condition read through
`AlgebraicGeometry.maximalIdealBlowUpStalkHom`. -/
theorem memChart_of_map_maximalIdeal_eq_span {b : A} (hb : b ∈ maximalIdeal A)
    (z : blowUp (maximalIdealSheaf A))
    (h : Ideal.map (maximalIdealBlowUpStalkHom A z) (maximalIdeal A) =
      Ideal.span {maximalIdealBlowUpStalkHom A z b}) :
    MemChart hb z := by
  have hzU : blowUpToBase (maximalIdealSheaf A) z ∈ (specTopAffineOpen A).1 := trivial
  have hexc : AlgebraicGeometry.IdealSheafData.stalk (exceptionalIdeal (maximalIdealSheaf A)) z =
      Ideal.span {((blowUpToBase (maximalIdealSheaf A)).stalkMap z)
        ((Spec (.of A)).presheaf.germ (specTopAffineOpen A).1
          (blowUpToBase (maximalIdealSheaf A) z) hzU
          ((maximalIdealSheafSection hb : (maximalIdealSheaf A).ideal (specTopAffineOpen A)) :
            Γ(Spec (.of A), (specTopAffineOpen A).1)))} := by
    have key : Ideal.map (((blowUpToBase (maximalIdealSheaf A)).stalkMap z).hom.comp
        ((Spec (.of A)).presheaf.germ (specTopAffineOpen A).1
          (blowUpToBase (maximalIdealSheaf A) z) hzU).hom)
        ((maximalIdealSheaf A).ideal (specTopAffineOpen A)) =
        Ideal.map (maximalIdealBlowUpStalkHom A z) (maximalIdeal A) := by
      rw [ideal_maximalIdealSheaf_specTopAffineOpen, Ideal.map_map]
      rfl
    rw [show exceptionalIdeal (maximalIdealSheaf A) =
        (maximalIdealSheaf A).comap (blowUpToBase (maximalIdealSheaf A)) from rfl,
      idealStalk_comap_eq_map, IdealSheafData.stalk_eq_map_germ _ _ (specTopAffineOpen A) hzU,
      Ideal.map_map, key, h]
    rfl
  obtain ⟨v, hv⟩ := (mem_affineBlowupStandardOpen_iff_exceptionalIdeal_stalk_eq_span
    (maximalIdealSheaf A) (specTopAffineOpen A) (maximalIdealSheafSection hb) z hzU).mpr hexc
  refine ⟨(affineBlowupStandardOpenIso (maximalIdealSheaf A) (specTopAffineOpen A)
    (maximalIdealSheafSection hb)).inv v, ?_⟩
  have hinv : (affineBlowupStandardOpenIso (maximalIdealSheaf A) (specTopAffineOpen A)
      (maximalIdealSheafSection hb)).hom ((affineBlowupStandardOpenIso (maximalIdealSheaf A)
        (specTopAffineOpen A) (maximalIdealSheafSection hb)).inv v) = v := by
    rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]
    rfl
  rw [← hv, blowupChartι, Scheme.Hom.comp_apply, hinv]

end AlgebraicGeometry

end
