module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ChartPresentation
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ChartClaim
public import StacksFrontier.AlgebraicGeometry.Blowup.ExceptionalCartier

/-!
# The quadratic relation at the origin of the first chart

Let `y₁, y₂, y₃` generate the maximal ideal of a Noetherian local ring `A` and satisfy a quadratic
relation `Σ aᵢⱼ yᵢyⱼ = Σ bᵢⱼₖ yᵢyⱼyₖ` whose first row vanishes. In the chart `A' = A[𝔪/y₁]`, with
`fᵢ = yᵢ/y₁`, consider the origin `z = (y₁, f₂, f₃)`. If the local ring `O = A'_z` has dimension
at least two and is not regular, then `y₁, f₂, f₃` generate the maximal ideal of `O` and satisfy a
quadratic relation whose coefficients not carrying the first variable are the `aᵢⱼ`, `i, j ≥ 2`;
and the residue field of `O` is that of `A`.

This is the computation of the source's case I paragraph: dividing the relation by `y₁²` gives
`Σᵢⱼ≥₂ aᵢⱼ fᵢfⱼ = y₁ B` with `B ≡ b₁₁₁` modulo `(f₂, f₃)`, and `b₁₁₁ ∈ 𝔪` because the point is
singular ("`ā₁₁₁ = 0` because `p` is singular").

## Main results

* `AlgebraicGeometry.exists_relation_at_chart_origin`
-/

@[expose] public noncomputable section

open IsLocalRing

universe u

namespace AlgebraicGeometry

variable {A : Type u} [CommRing A] [IsLocalRing A] {y : Fin 3 → A}
  (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away (y 0) S]

/-- Every element of the chart is congruent to an element of `A` modulo the fractions `f₂, f₃`. -/
theorem exists_algebraMap_sub_mem_span_chartFraction (hy : ∀ i, y i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range y) = maximalIdeal A)
    (w : affineBlowupAlgebra (maximalIdeal A) (y 0) S) :
    ∃ r : A, w - algebraMap A _ r ∈
      Ideal.span {chartFraction S hy 1, chartFraction S hy 2} := by
  have hw : w ∈ Algebra.adjoin A (Set.range (chartFraction S hy)) := by
    rw [adjoin_range_chartFraction_eq_top S hy hspan]
    trivial
  induction hw using Algebra.adjoin_induction with
  | mem v hv =>
    obtain ⟨i, rfl⟩ := hv
    obtain rfl | rfl | rfl : i = 0 ∨ i = 1 ∨ i = 2 := by fin_cases i <;> simp
    · exact ⟨1, by simp [chartFraction_zero]⟩
    all_goals exact ⟨0, by rw [map_zero, sub_zero]; exact Ideal.subset_span (by simp)⟩
  | algebraMap r => exact ⟨r, by simp⟩
  | add u v _ _ hu hv =>
    obtain ⟨r, hr⟩ := hu
    obtain ⟨s, hs⟩ := hv
    exact ⟨r + s, by rw [map_add, add_sub_add_comm]; exact Ideal.add_mem _ hr hs⟩
  | mul u v _ _ hu hv =>
    obtain ⟨r, hr⟩ := hu
    obtain ⟨s, hs⟩ := hv
    refine ⟨r * s, ?_⟩
    rw [show u * v - algebraMap A _ (r * s) =
        (u - algebraMap A _ r) * v + algebraMap A _ r * (v - algebraMap A _ s) by
      rw [map_mul]; ring]
    exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ hr) (Ideal.mul_mem_left _ _ hs)

/-- An ideal of the chart containing `y₁` contains the image of the maximal ideal of `A`. -/
theorem algebraMap_mem_of_mem_maximalIdeal (hy0 : y 0 ∈ maximalIdeal A)
    {z : Ideal (affineBlowupAlgebra (maximalIdeal A) (y 0) S)}
    (h0 : algebraMap A (affineBlowupAlgebra (maximalIdeal A) (y 0) S) (y 0) ∈ z) {r : A}
    (hr : r ∈ maximalIdeal A) :
    algebraMap A (affineBlowupAlgebra (maximalIdeal A) (y 0) S) r ∈ z := by
  refine (Ideal.span_singleton_le_iff_mem _).mpr h0 ?_
  rw [← affineBlowupAlgebra.map_ideal_eq_span_singleton (maximalIdeal A) (y 0) hy0]
  exact Ideal.mem_map_of_mem _ hr

/-- **The origin of the chart.** A maximal ideal of the chart containing `y₁` and the fractions
`f₂, f₃` is generated by them, and the residue field there is that of `A`. -/
theorem eq_span_and_surjective_of_isMaximal_chart_origin (hy : ∀ i, y i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range y) = maximalIdeal A)
    (z : Ideal (affineBlowupAlgebra (maximalIdeal A) (y 0) S)) [hz : z.IsMaximal]
    (h0 : algebraMap A (affineBlowupAlgebra (maximalIdeal A) (y 0) S) (y 0) ∈ z)
    (h1 : chartFraction S hy 1 ∈ z) (h2 : chartFraction S hy 2 ∈ z) :
    z = Ideal.span {algebraMap A (affineBlowupAlgebra (maximalIdeal A) (y 0) S) (y 0),
      chartFraction S hy 1, chartFraction S hy 2} ∧
    Function.Surjective ((Ideal.Quotient.mk z).comp
      (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (y 0) S))) := by
  have hJ : Ideal.span {chartFraction S hy 1, chartFraction S hy 2} ≤ z :=
    Ideal.span_le.mpr (by rintro _ (rfl | rfl) <;> assumption)
  refine ⟨le_antisymm (fun w hw => ?_) ?_, fun t => ?_⟩
  · obtain ⟨r, hwr⟩ := exists_algebraMap_sub_mem_span_chartFraction S hy hspan w
    have hrm : r ∈ maximalIdeal A :=
      le_maximalIdeal (Ideal.comap_ne_top (algebraMap A _) hz.ne_top)
        (Ideal.mem_comap.mpr (by simpa only [sub_sub_cancel] using z.sub_mem hw (hJ hwr)))
    rw [← sub_add_cancel w (algebraMap A _ r)]
    exact Ideal.add_mem _ (Ideal.span_mono (Set.subset_insert _ _) hwr)
      (Ideal.span_mono (by simp)
        (algebraMap_mem_of_mem_maximalIdeal S (hy 0) (Ideal.mem_span_singleton_self _) hrm))
  · exact Ideal.span_le.mpr (by rintro _ (rfl | rfl | rfl) <;> assumption)
  · obtain ⟨w, rfl⟩ := Ideal.Quotient.mk_surjective t
    obtain ⟨r, hwr⟩ := exists_algebraMap_sub_mem_span_chartFraction S hy hspan w
    refine ⟨r, ?_⟩
    rw [RingHom.comp_apply, Ideal.Quotient.eq]
    simpa only [neg_sub] using z.neg_mem (hJ hwr)

/-- A cubic expression in `1, t₂, t₃` whose last two entries have vanishing products is affine
linear in `t₂, t₃`. -/
theorem sum_cubic_of_mul_eq_zero {R : Type*} [CommRing R] (b : Fin 3 → Fin 3 → Fin 3 → R)
    (t : Fin 3 → R) (h0 : t 0 = 1) (h11 : t 1 * t 1 = 0) (h12 : t 1 * t 2 = 0)
    (h22 : t 2 * t 2 = 0) :
    ∑ p, ∑ q, ∑ r, b p q r * (t p * t q * t r) =
      b 0 0 0 + (b 1 0 0 + b 0 1 0 + b 0 0 1) * t 1 + (b 2 0 0 + b 0 2 0 + b 0 0 2) * t 2 := by
  have h21 : t 2 * t 1 = 0 := (mul_comm _ _).trans h12
  simp only [Fin.sum_univ_three, h0, one_mul, mul_one, h11, h12, h21, h22, mul_zero, add_zero,
    mul_assoc]
  ring

/-- The range of a family indexed by `Fin 3` is the set of its three values. -/
private theorem range_eq_insert_of_fin_three {α : Type*} (X : Fin 3 → α) :
    Set.range X = {X 0, X 1, X 2} := by
  ext; simp [Fin.exists_fin_succ, eq_comm]

/-- The images of `y₁, f₂, f₃` generate the maximal ideal of the local ring at the origin of the
chart. -/
theorem span_range_chartOrigin_eq_maximalIdeal (hy : ∀ i, y i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range y) = maximalIdeal A)
    (z : Ideal (affineBlowupAlgebra (maximalIdeal A) (y 0) S)) [z.IsMaximal]
    (h0 : algebraMap A (affineBlowupAlgebra (maximalIdeal A) (y 0) S) (y 0) ∈ z)
    (h1 : chartFraction S hy 1 ∈ z) (h2 : chartFraction S hy 2 ∈ z) :
    Ideal.span (Set.range ![
      algebraMap (affineBlowupAlgebra (maximalIdeal A) (y 0) S) (Localization.AtPrime z)
        (algebraMap A _ (y 0)),
      algebraMap (affineBlowupAlgebra (maximalIdeal A) (y 0) S) (Localization.AtPrime z)
        (chartFraction S hy 1),
      algebraMap (affineBlowupAlgebra (maximalIdeal A) (y 0) S) (Localization.AtPrime z)
        (chartFraction S hy 2)]) = maximalIdeal (Localization.AtPrime z) := by
  let A' := affineBlowupAlgebra (maximalIdeal A) (y 0) S
  let B := Localization.AtPrime z
  rw [← Localization.AtPrime.map_eq_maximalIdeal]
  conv_rhs => rw [show Ideal.map (algebraMap A' B) z = Ideal.map (algebraMap A' B)
    (Ideal.span {algebraMap A A' (y 0), chartFraction S hy 1, chartFraction S hy 2}) from
      congrArg _ (eq_span_and_surjective_of_isMaximal_chart_origin S hy hspan z h0 h1 h2).1]
  rw [Ideal.map_span]
  congr 1
  rw [Set.image_insert_eq, Set.image_insert_eq, Set.image_singleton,
    range_eq_insert_of_fin_three]
  rfl

/-- The residue field of the local ring at the origin of the chart is that of `A`. -/
theorem surjective_residue_comp_algebraMap_chartOrigin (hy : ∀ i, y i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range y) = maximalIdeal A)
    (z : Ideal (affineBlowupAlgebra (maximalIdeal A) (y 0) S)) [z.IsMaximal]
    (h0 : algebraMap A (affineBlowupAlgebra (maximalIdeal A) (y 0) S) (y 0) ∈ z)
    (h1 : chartFraction S hy 1 ∈ z) (h2 : chartFraction S hy 2 ∈ z) :
    Function.Surjective ((residue (Localization.AtPrime z)).comp
      ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (y 0) S) (Localization.AtPrime z)).comp
        (algebraMap A _))) := by
  let A' := affineBlowupAlgebra (maximalIdeal A) (y 0) S
  let B := Localization.AtPrime z
  let ι := algebraMap A' B
  have hzsurj := (eq_span_and_surjective_of_isMaximal_chart_origin S hy hspan z h0 h1 h2).2
  intro t
  obtain ⟨t', rfl⟩ := residue_surjective t
  obtain ⟨⟨w, s⟩, rfl⟩ := IsLocalization.mk'_surjective z.primeCompl t'
  obtain ⟨r, hr⟩ := hzsurj (Ideal.Quotient.mk z w)
  obtain ⟨r', hr'⟩ := hzsurj (Ideal.Quotient.mk z (s : A'))
  have hres_eq : ∀ (w : A') (r : A), Ideal.Quotient.mk z (algebraMap A A' r) =
      Ideal.Quotient.mk z w → residue B (ι (algebraMap A A' r)) = residue B (ι w) := by
    intro w r h
    rw [Ideal.Quotient.eq] at h
    show Ideal.Quotient.mk _ _ = Ideal.Quotient.mk _ _
    rw [Ideal.Quotient.eq, ← map_sub, ← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.mem_map_of_mem _ h
  have hr'u : IsUnit r' := by
    rw [← notMem_maximalIdeal]
    intro hm
    apply s.2
    rw [RingHom.comp_apply, Ideal.Quotient.eq] at hr'
    have := z.sub_mem (algebraMap_mem_of_mem_maximalIdeal S (hy 0) h0 hm) hr'
    rwa [sub_sub_cancel] at this
  obtain ⟨v, hv⟩ := hr'u
  refine ⟨r * ↑v⁻¹, ?_⟩
  have hs0 : residue B (ι (s : A')) ≠ 0 := by
    rw [ne_eq, residue_eq_zero_iff]
    exact fun h => (mem_maximalIdeal _).mp h (IsLocalization.map_units B s)
  apply mul_right_cancel₀ hs0
  simp only [RingHom.comp_apply]
  calc residue B (ι (algebraMap A A' (r * ↑v⁻¹))) * residue B (ι (s : A'))
      = residue B (ι (algebraMap A A' (r * ↑v⁻¹))) * residue B (ι (algebraMap A A' r')) := by
        rw [hres_eq _ _ hr']
    _ = residue B (ι (algebraMap A A' (r * ↑v⁻¹ * r'))) := by simp only [map_mul]
    _ = residue B (ι (algebraMap A A' r)) := by rw [← hv, mul_assoc, Units.inv_mul, mul_one]
    _ = residue B (ι w) := hres_eq w r hr
    _ = residue B (IsLocalization.mk' B w s * ι (s : A')) := by
        rw [IsLocalization.mk'_spec]
    _ = residue B (IsLocalization.mk' B w s) * residue B (ι (s : A')) := map_mul _ _ _

/-- Dividing the relation by `y₁²`: its quadratic part in the fractions `fᵢ` is `y₁` times its
cubic part. -/
theorem sum_chartFraction_quadratic_eq_mul (hy : ∀ i, y i ∈ maximalIdeal A)
    (a : Fin 3 → Fin 3 → A) (b : Fin 3 → Fin 3 → Fin 3 → A)
    (hrel : ∑ p, ∑ q, a p q * (y p * y q) = ∑ p, ∑ q, ∑ r, b p q r * (y p * y q * y r)) :
    ∑ p, ∑ q, algebraMap A (affineBlowupAlgebra (maximalIdeal A) (y 0) S) (a p q) *
        (chartFraction S hy p * chartFraction S hy q) =
      algebraMap A _ (y 0) * ∑ p, ∑ q, ∑ r, algebraMap A _ (b p q r) *
        (chartFraction S hy p * chartFraction S hy q * chartFraction S hy r) := by
  let A' := affineBlowupAlgebra (maximalIdeal A) (y 0) S
  have hyF : ∀ i, algebraMap A A' (y i) = algebraMap A A' (y 0) * chartFraction S hy i :=
    fun i => (algebraMap_mul_chartFraction S hy i).symm
  set C : A' := ∑ p, ∑ q, ∑ r, algebraMap A A' (b p q r) *
    (chartFraction S hy p * chartFraction S hy q * chartFraction S hy r) with hCdef
  set Q : A' := ∑ p, ∑ q, algebraMap A A' (a p q) *
    (chartFraction S hy p * chartFraction S hy q) with hQdef
  have h := congrArg (algebraMap A A') hrel
  simp only [map_sum, map_mul] at h
  have hl : ∑ p, ∑ q, algebraMap A A' (a p q) *
      (algebraMap A A' (y p) * algebraMap A A' (y q)) = algebraMap A A' (y 0) ^ 2 * Q := by
    rw [hQdef]
    simp_rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => ?_
    rw [hyF p, hyF q]
    ring
  have hr : ∑ p, ∑ q, ∑ r, algebraMap A A' (b p q r) *
      (algebraMap A A' (y p) * algebraMap A A' (y q) * algebraMap A A' (y r)) =
      algebraMap A A' (y 0) ^ 2 * (algebraMap A A' (y 0) * C) := by
    rw [hCdef]
    simp_rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ =>
      Finset.sum_congr rfl fun r _ => ?_
    rw [hyF p, hyF q, hyF r]
    ring
  rw [hl, hr] at h
  exact ((Stacks.Blowup.isRegular_algebraMap_affineBlowupAlgebra (maximalIdeal A) (y 0) S).pow
    2).left h

/-- The cubic part of the relation in the fractions `fᵢ` is `b₁₁₁` modulo `f₂, f₃`. -/
theorem sum_chartFraction_cubic_sub_mem_span (hy : ∀ i, y i ∈ maximalIdeal A)
    (b : Fin 3 → Fin 3 → Fin 3 → A) :
    ∑ p, ∑ q, ∑ r, algebraMap A (affineBlowupAlgebra (maximalIdeal A) (y 0) S) (b p q r) *
        (chartFraction S hy p * chartFraction S hy q * chartFraction S hy r) -
      algebraMap A _ (b 0 0 0) ∈ Ideal.span {chartFraction S hy 1, chartFraction S hy 2} := by
  set K : Ideal (affineBlowupAlgebra (maximalIdeal A) (y 0) S) :=
    Ideal.span {chartFraction S hy 1, chartFraction S hy 2}
  rw [← Ideal.Quotient.eq_zero_iff_mem, map_sub, sub_eq_zero]
  simp only [map_sum, map_mul]
  have hF1 : Ideal.Quotient.mk K (chartFraction S hy 1) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
  have hF2 : Ideal.Quotient.mk K (chartFraction S hy 2) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (by simp))
  rw [sum_cubic_of_mul_eq_zero _ (fun i => Ideal.Quotient.mk K (chartFraction S hy i))
    (by simp [chartFraction_zero]) (by simp [hF1]) (by simp [hF1]) (by simp [hF2])]
  simp [hF1, hF2]

/-- A Noetherian local ring of dimension at least two whose maximal ideal is generated by two
elements is regular. -/
theorem isRegularLocalRing_of_maximalIdeal_eq_span_pair_of_two_le_ringKrullDim {B : Type*}
    [CommRing B] [IsLocalRing B] [IsNoetherianRing B] {x₁ x₂ : B}
    (hm : maximalIdeal B = Ideal.span {x₁, x₂}) (hdim : 2 ≤ ringKrullDim B) :
    IsRegularLocalRing B := by
  refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le B (le_trans ?_ hdim)
  rw [hm]
  have h₁ := Submodule.spanFinrank_span_le_ncard_of_finite
    (R := B) (s := ({x₁, x₂} : Set B)) (Set.toFinite _)
  have h₂ : ({x₁, x₂} : Set B).ncard ≤ 2 :=
    (Set.ncard_insert_le _ _).trans (by rw [Set.ncard_singleton])
  exact_mod_cast h₁.trans h₂

/-- A Noetherian local ring of dimension at least two whose maximal ideal is generated by
`X₀, X₁, X₂`, with `X₀ u ∈ (X₁, X₂)` for a unit `u`, is regular. -/
theorem isRegularLocalRing_of_mul_isUnit_mem_span {B : Type*} [CommRing B] [IsLocalRing B]
    [IsNoetherianRing B] {X : Fin 3 → B} (hX : Ideal.span (Set.range X) = maximalIdeal B)
    (hdim : 2 ≤ ringKrullDim B) {u : B} (hu : IsUnit u)
    (h : X 0 * u ∈ Ideal.span {X 1, X 2}) : IsRegularLocalRing B := by
  obtain ⟨v, rfl⟩ := hu
  have hX0 : X 0 ∈ Ideal.span {X 1, X 2} := by
    simpa only [mul_assoc, Units.mul_inv, mul_one] using Ideal.mul_mem_right (↑v⁻¹ : B) _ h
  refine isRegularLocalRing_of_maximalIdeal_eq_span_pair_of_two_le_ringKrullDim
    (x₁ := X 1) (x₂ := X 2) ?_ hdim
  rw [← hX, range_eq_insert_of_fin_three, Ideal.span_insert, sup_eq_right,
    Ideal.span_singleton_le_iff_mem]
  exact hX0

/-- If `X₀ C` is a quadratic form in `X₁, X₂` and `C ∈ (X₀, X₁, X₂)`, then moving `X₀ C` into the
`X₀`-row gives an upper triangular quadratic relation in `X₀, X₁, X₂`. -/
theorem exists_sum_upper_eq_zero_of_mul_eq {B : Type*} [CommRing B] {X : Fin 3 → B}
    {C d₁₁ d₁₂ d₂₂ : B} (hC : C ∈ Ideal.span (Set.range X))
    (hXC : X 0 * C = d₁₁ * (X 1 * X 1) + d₁₂ * (X 1 * X 2) + d₂₂ * (X 2 * X 2)) :
    ∃ γ : Fin 3 → B, ∑ p, ∑ q, (![![-γ 0, -γ 1, -γ 2], ![0, d₁₁, d₁₂], ![0, 0, d₂₂]] :
      Fin 3 → Fin 3 → B) p q * (X p * X q) = 0 := by
  rw [Ideal.span, Submodule.mem_span_range_iff_exists_fun] at hC
  obtain ⟨γ, hγ⟩ := hC
  refine ⟨γ, ?_⟩
  simp only [Fin.sum_univ_three, smul_eq_mul] at hγ ⊢
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
    Matrix.tail_cons, zero_mul, add_zero, zero_add]
  linear_combination -(X 0) * hγ - hXC

/-- **The relation at the origin of the chart.** -/
theorem exists_relation_at_chart_origin [IsNoetherianRing A] (hy : ∀ i, y i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range y) = maximalIdeal A)
    (a : Fin 3 → Fin 3 → A) (b : Fin 3 → Fin 3 → Fin 3 → A)
    (hupper : ∀ p q, q < p → a p q = 0) (ha00 : a 0 0 = 0) (ha01 : a 0 1 = 0) (ha02 : a 0 2 = 0)
    (hrel : ∑ p, ∑ q, a p q * (y p * y q) = ∑ p, ∑ q, ∑ r, b p q r * (y p * y q * y r))
    (z : Ideal (affineBlowupAlgebra (maximalIdeal A) (y 0) S)) [z.IsMaximal]
    (h0 : algebraMap A (affineBlowupAlgebra (maximalIdeal A) (y 0) S) (y 0) ∈ z)
    (h1 : chartFraction S hy 1 ∈ z) (h2 : chartFraction S hy 2 ∈ z)
    [IsNoetherianRing (Localization.AtPrime z)]
    (hdim : 2 ≤ ringKrullDim (Localization.AtPrime z))
    (hsing : ¬ IsRegularLocalRing (Localization.AtPrime z)) :
    let ι := algebraMap (affineBlowupAlgebra (maximalIdeal A) (y 0) S) (Localization.AtPrime z)
    let X : Fin 3 → Localization.AtPrime z := ![ι (algebraMap A _ (y 0)),
      ι (chartFraction S hy 1), ι (chartFraction S hy 2)]
    Ideal.span (Set.range X) = maximalIdeal (Localization.AtPrime z) ∧
      Function.Surjective ((residue (Localization.AtPrime z)).comp (ι.comp (algebraMap A _))) ∧
      ∃ c : Fin 3 → Fin 3 → Localization.AtPrime z, (∀ p q, q < p → c p q = 0) ∧
        (∀ p q : Fin 2, c p.succ q.succ = ι (algebraMap A _ (a p.succ q.succ))) ∧
        ∑ p, ∑ q, c p q * (X p * X q) ∈ maximalIdeal (Localization.AtPrime z) ^ 3 := by
  intro ι X
  let A' := affineBlowupAlgebra (maximalIdeal A) (y 0) S
  let B := Localization.AtPrime z
  have hXspan : Ideal.span (Set.range X) = maximalIdeal B :=
    span_range_chartOrigin_eq_maximalIdeal S hy hspan z h0 h1 h2
  refine ⟨hXspan, surjective_residue_comp_algebraMap_chartOrigin S hy hspan z h0 h1 h2, ?_⟩
  set C : A' := ∑ p, ∑ q, ∑ r, algebraMap A A' (b p q r) *
    (chartFraction S hy p * chartFraction S hy q * chartFraction S hy r)
  set Q : A' := ∑ p, ∑ q, algebraMap A A' (a p q) *
    (chartFraction S hy p * chartFraction S hy q) with hQdef
  have hQC : Q = algebraMap A A' (y 0) * C := sum_chartFraction_quadratic_eq_mul S hy a b hrel
  have hXC : X 0 * ι C = ι Q := by
    rw [hQC, map_mul]
    rfl
  have ha21 : a 2 1 = 0 := hupper 2 1 (by decide)
  have hQX : ι Q = ι (algebraMap A A' (a 1 1)) * (X 1 * X 1) +
      ι (algebraMap A A' (a 1 2)) * (X 1 * X 2) + ι (algebraMap A A' (a 2 2)) * (X 2 * X 2) := by
    rw [hQdef]
    simp only [Fin.sum_univ_three, ha00, ha01, ha02, hupper 1 0 (by decide),
      hupper 2 0 (by decide), ha21, map_zero, zero_mul, zero_add, add_zero, map_add, map_mul]
    rfl
  have hιC : ι C ∈ Ideal.span (Set.range X) := by
    rw [hXspan]
    by_contra hn
    refine hsing (isRegularLocalRing_of_mul_isUnit_mem_span hXspan hdim
      (notMem_maximalIdeal.mp hn) ?_)
    rw [hXC, hQX]
    refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) ?_ <;>
      exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
  obtain ⟨γ, hγ⟩ := exists_sum_upper_eq_zero_of_mul_eq hιC (hXC.trans hQX)
  refine ⟨![![-γ 0, -γ 1, -γ 2], ![0, ι (algebraMap A A' (a 1 1)), ι (algebraMap A A' (a 1 2))],
    ![0, 0, ι (algebraMap A A' (a 2 2))]], ?_, ?_, ?_⟩
  · intro p q hpq
    fin_cases p <;> fin_cases q <;> first | rfl | exact absurd hpq (by decide)
  · intro p q
    fin_cases p <;> fin_cases q <;> first | rfl | simp [ha21]
  · rw [hγ]
    exact Ideal.zero_mem _

/-- `AlgebraicGeometry.exists_relation_at_chart_origin` for the chart at an element `a₀ = y₁`, with
the fractions `fᵢ = yᵢ/y₁` given by their defining equations. -/
theorem exists_relation_at_chart_origin' [IsNoetherianRing A] {y : Fin 3 → A} (a₀ : A)
    (ha₀ : y 0 = a₀) (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away a₀ S]
    (hspan : Ideal.span (Set.range y) = maximalIdeal A)
    (a : Fin 3 → Fin 3 → A) (b : Fin 3 → Fin 3 → Fin 3 → A)
    (hupper : ∀ p q, q < p → a p q = 0) (ha00 : a 0 0 = 0) (ha01 : a 0 1 = 0) (ha02 : a 0 2 = 0)
    (hrel : ∑ p, ∑ q, a p q * (y p * y q) = ∑ p, ∑ q, ∑ r, b p q r * (y p * y q * y r))
    (z : Ideal (affineBlowupAlgebra (maximalIdeal A) a₀ S)) [z.IsMaximal]
    (h0 : algebraMap A (affineBlowupAlgebra (maximalIdeal A) a₀ S) a₀ ∈ z)
    (f : Fin 3 → affineBlowupAlgebra (maximalIdeal A) a₀ S)
    (hf : ∀ i, algebraMap A _ a₀ * f i = algebraMap A _ (y i))
    (h1 : f 1 ∈ z) (h2 : f 2 ∈ z)
    [IsNoetherianRing (Localization.AtPrime z)]
    (hdim : 2 ≤ ringKrullDim (Localization.AtPrime z))
    (hsing : ¬ IsRegularLocalRing (Localization.AtPrime z)) :
    let ι := algebraMap (affineBlowupAlgebra (maximalIdeal A) a₀ S) (Localization.AtPrime z)
    let X : Fin 3 → Localization.AtPrime z := ![ι (algebraMap A _ a₀), ι (f 1), ι (f 2)]
    Ideal.span (Set.range X) = maximalIdeal (Localization.AtPrime z) ∧
      Function.Surjective ((residue (Localization.AtPrime z)).comp (ι.comp (algebraMap A _))) ∧
      ∃ c : Fin 3 → Fin 3 → Localization.AtPrime z, (∀ p q, q < p → c p q = 0) ∧
        (∀ p q : Fin 2, c p.succ q.succ = ι (algebraMap A _ (a p.succ q.succ))) ∧
        ∑ p, ∑ q, c p q * (X p * X q) ∈ maximalIdeal (Localization.AtPrime z) ^ 3 := by
  subst ha₀
  have hy : ∀ i, y i ∈ maximalIdeal A := fun i => hspan ▸ Ideal.subset_span ⟨i, rfl⟩
  obtain rfl : f = chartFraction S hy := funext fun i =>
    (Stacks.Blowup.isRegular_algebraMap_affineBlowupAlgebra (maximalIdeal A) (y 0) S).left
      ((hf i).trans (algebraMap_mul_chartFraction S hy i).symm)
  exact exists_relation_at_chart_origin S hy hspan a b hupper ha00 ha01 ha02 hrel z h0 h1 h2
    hdim hsing

end AlgebraicGeometry

