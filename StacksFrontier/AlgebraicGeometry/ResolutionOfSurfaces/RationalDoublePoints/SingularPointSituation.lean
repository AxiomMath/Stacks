module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.BlowUpPropagation
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ClosedPointChart
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalSingularities.RationalStalk
public import StacksFrontier.AlgebraicGeometry.Surfaces.BlowUpNormality

/-!
# A singular closed point of the blowup of a rational double point is a rational double point

Let `S` be a Situation [Stacks, Tag 0BGC] whose maximal ideal is generated by three elements,
and let `q` be a closed point of the blowup of `Spec(A)` in the maximal ideal at which the blowup
is singular. Then the local ring at `q` is again the ring of a Situation 0BGC: the blowup is
normal, and its local ring at `q` defines a rational singularity, is Gorenstein, and has a normal
completion.

## Main definitions

* `AlgebraicGeometry.RationalDoublePointSituation.singularPointSituation`: the Situation 0BGC at
  a singular closed point of the blowup.

## References

* [Stacks Project, Tag 0BGC](https://stacks.math.columbia.edu/tag/0BGC)
* [Stacks Project, Tag 0BG0](https://stacks.math.columbia.edu/tag/0BG0)
* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
-/

@[expose] public noncomputable section

open CategoryTheory IsLocalRing

universe u

namespace AlgebraicGeometry

namespace RationalDoublePointSituation

/-- The blowup of `Spec(A)` in the maximal ideal is a modification of `Spec(A)`. -/
theorem isModification_blowUpToBase (S : RationalDoublePointSituation.{u}) :
    IsModification (blowUpToBase (maximalIdealSheaf S.A)) :=
  isModification_blowUpToBase_maximalIdeal S.A S.dimension_two

/-- A closed point of the blowup of `Spec(A)` in the maximal ideal is not its generic point. -/
theorem ne_genericPoint_of_isClosed (S : RationalDoublePointSituation.{u})
    (q : blowUp (maximalIdealSheaf S.A))
    (hq : IsClosed ({q} : Set (blowUp (maximalIdealSheaf S.A)))) :
    letI := S.isModification_blowUpToBase.source_isIntegral
    q ≠ genericPoint (blowUp (maximalIdealSheaf S.A)) := by
  let := S.isModification_blowUpToBase.source_isIntegral
  rintro rfl
  exact absurd ((S.ringKrullDim_stalk_blowUp_eq_two _ hq).symm.trans
    (ringKrullDim_eq_zero_of_field (blowUp (maximalIdealSheaf S.A)).functionField)) (by decide)

/-- The local ring of the blowup of `Spec(A)` in the maximal ideal at a closed point defines a
rational singularity. -/
theorem definesRationalSingularity_stalk_blowUp (S : RationalDoublePointSituation.{u})
    (q : blowUp (maximalIdealSheaf S.A))
    (hq : IsClosed ({q} : Set (blowUp (maximalIdealSheaf S.A)))) :
    letI : IsNormalDomain ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk q) :=
      S.isNormalDomain_stalk_blowUp q
    DefinesRationalSingularity ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk q) :=
  let := S.isNormal_blowUp
  definesRationalSingularity_stalk_of_isModification S.A S.dimension_two
    S.definesRationalSingularity _ S.isModification_blowUpToBase q hq
    (S.ne_genericPoint_of_isClosed q hq)

/-- **The Situation 0BGC at a singular closed point of the blowup.** Let `S` be a Situation 0BGC
whose maximal ideal is generated by three elements `x`, and `q` a closed point of the blowup of
`Spec(A)` in the maximal ideal at which the local ring is not regular. Then the local ring at `q`
is the ring of a Situation 0BGC. -/
def singularPointSituation (S : RationalDoublePointSituation.{u}) (x : Fin 3 → S.A)
    (hspan : Ideal.span (Set.range x) = IsLocalRing.maximalIdeal S.A)
    (q : blowUp (maximalIdealSheaf S.A))
    (hq : IsClosed ({q} : Set (blowUp (maximalIdealSheaf S.A))))
    (hsing : ¬ IsRegularLocalRing ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk q)) :
    RationalDoublePointSituation.{u} :=
  S.blowUpSituationOfSpanFinrank q hq (S.definesRationalSingularity_stalk_blowUp q hq)
    (spanFinrank_maximalIdeal_stalk_blowUp_le_three S.A x hspan q hq) hsing

/-- The ring of `S.singularPointSituation x hspan q hq hsing` is the local ring of the blowup at
`q`. -/
@[simp]
theorem singularPointSituation_A (S : RationalDoublePointSituation.{u}) {x hspan q hq hsing} :
    (S.singularPointSituation x hspan q hq hsing).A =
      (blowUp (maximalIdealSheaf S.A)).presheaf.stalk q :=
  rfl

end RationalDoublePointSituation

end AlgebraicGeometry

end
