module

public import StacksFrontier.RingTheory.LocalRing.StrictLocalHom
public import StacksFrontier.AlgebraicGeometry.Pullback.StalkTensor
public import
  StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.PointBlowupLocalization

/-!
# Base change of a blowup along a strict local homomorphism

Let `φ : R → B` be a strict local homomorphism of local rings (`IsStrictLocalHom`: flat, the
maximal ideal of `R` generates that of `B`, surjective on residue fields). The blowup of `Spec(B)`
in its maximal ideal is the base change of the blowup of `Spec(R)` in its maximal ideal
([Stacks, Tag 0805]). This file proves the local statement behind the transfer of closed points
of the blowup: for any scheme `X` over `Spec(R)`, the map of local rings of the base change
`X ×_{Spec(R)} Spec(B) → X`, at a point over the closed point of `Spec(B)`, is again strict.

## Main results

* `AlgebraicGeometry.isStrictLocalHom_stalkMap_pullback_fst`: the map of local rings of a base
  change along a strict local homomorphism, at a point over the closed point, is strict.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing TopologicalSpace

open scoped TensorProduct

universe u

namespace AlgebraicGeometry

/-- The structure map from a local ring `R` to the local ring of a scheme over `Spec(R)` at a
point lying over the closed point is a local homomorphism. -/
theorem isLocalHom_germ_appTop {R : CommRingCat.{u}} [IsLocalRing R] {X : Scheme.{u}}
    (f : X ⟶ Spec R) (x : X) (hx : f x = closedPoint R) :
    IsLocalHom ((Scheme.ΓSpecIso R).inv ≫ f.appTop ≫ X.presheaf.germ ⊤ x trivial).hom := by
  have h1 : (Scheme.ΓSpecIso R).inv ≫ f.appTop ≫ X.presheaf.germ ⊤ x trivial =
      ((Scheme.ΓSpecIso R).inv ≫ (Spec R).presheaf.germ ⊤ (f x) trivial) ≫ f.stalkMap x := by
    rw [Category.assoc]
    exact (congrArg ((Scheme.ΓSpecIso R).inv ≫ ·) (Scheme.Hom.germ_stalkMap f ⊤ x trivial)).symm
  have key : ∀ p : Spec R, p = closedPoint R →
      IsLocalHom ((Scheme.ΓSpecIso R).inv ≫ (Spec R).presheaf.germ ⊤ p trivial).hom := by
    rintro p rfl
    rw [← ΓSpecIso_hom_stalkClosedPointIso_inv, Iso.inv_hom_id_assoc]
    exact isLocalHom_of_isIso _
  have := key (f x) hx
  rw [h1, CommRingCat.hom_comp]
  infer_instance

/-- **The local rings of a base change along a strict local homomorphism.** Let `R → B` be a
strict local homomorphism, `f : X ⟶ Spec R`, and `w` a point of `X ×_{Spec R} Spec B` over the
closed point of `Spec B`. Then the map of local rings `𝒪_{X, pr w} → 𝒪_w` is strict: it is flat,
the maximal ideal of `𝒪_w` is generated by that of `𝒪_{X, pr w}`, and the residue fields agree.

The local ring at `w` is a localization of `𝒪_{X, pr w} ⊗[R] B`
(`AlgebraicGeometry.exists_isLocalization_atPrime_stalk_tensorProduct`), and
`IsStrictLocalHom.map_maximalIdeal_and_surjective_of_isLocalization` computes it. -/
theorem isStrictLocalHom_stalkMap_pullback_fst (R B : Type u) [CommRing R] [CommRing B]
    [IsLocalRing R] [IsLocalRing B] [Algebra R B] (hφ : IsStrictLocalHom (algebraMap R B))
    (X : Scheme.{u}) (f : X ⟶ Spec (.of R))
    (w : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap R B))) : Scheme.{u}))
    (hw : pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap R B))) w = closedPoint B) :
    IsStrictLocalHom
      ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap R B)))).stalkMap w).hom := by
  have := hφ.isLocalHom
  have : Flat (Spec.map (CommRingCat.ofHom (algebraMap R B))) :=
    Flat.SpecMap_iff.mpr hφ.flat
  obtain ⟨ψ, hψl, -, hloc⟩ := exists_isLocalization_atPrime_stalk_tensorProduct R B X f w
  have hfw : f (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap R B))) w) =
      closedPoint R := by
    have h := congrArg (fun t => t.base w)
      (pullback.condition (f := f) (g := Spec.map (CommRingCat.ofHom (algebraMap R B))))
    simp only [Scheme.Hom.comp_apply] at h
    rw [h, hw]
    exact Spec_closedPoint
  let : Algebra R (X.presheaf.stalk
      (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap R B))) w)) :=
    ((Scheme.ΓSpecIso (.of R)).inv ≫ f.appTop ≫
      X.presheaf.germ ⊤ (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap R B))) w)
        trivial).hom.toAlgebra
  have : IsLocalHom (algebraMap R (X.presheaf.stalk
      (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap R B))) w))) :=
    isLocalHom_germ_appTop f _ hfw
  have hloc' : IsLocalHom (ψ.comp Algebra.TensorProduct.includeLeftRingHom) := by
    rw [hψl]; infer_instance
  obtain ⟨hmax, hres⟩ := hφ.map_maximalIdeal_and_surjective_of_isLocalization ψ hloc' hloc
  rw [hψl] at hmax hres
  exact ⟨Flat.stalkMap _ w, inferInstance, hmax, hres⟩

end AlgebraicGeometry

end
