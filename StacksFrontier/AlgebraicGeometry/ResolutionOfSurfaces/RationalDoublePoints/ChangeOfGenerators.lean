module

public import Mathlib.LinearAlgebra.Matrix.NonsingularInverse
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.QuadraticForm

/-!
# Changing the generators in the quadratic relation of a rational double point

The discussion of rational double points uses the quadratic relation

`a₁₁x₁² + a₁₂x₁x₂ + a₁₃x₁x₃ + a₂₂x₂² + a₂₃x₂x₃ + a₃₃x₃² = Σ aᵢⱼₖ xᵢxⱼxₖ`

among three generators `x₁, x₂, x₃` of the maximal ideal of a local ring together with two
liberties it takes with that relation.

The first is that a coefficient `aᵢⱼ` whose residue in `κ` vanishes may be dropped: in the words
of the source, "we can subsume the term `aᵢⱼ xᵢ xⱼ` in the right hand side and assume
`aᵢⱼ = 0`; this operation changes the `aᵢⱼₖ` but not the other `aᵢ'ⱼ'`". The reason is that a
coefficient lying in `𝔪` is a combination of the generators, so the quadratic term it carries is
a cubic one.

The second is that the generators themselves may be changed. If `xᵢ = Σ Nᵢₚ x'ₚ` for another
family `x'`, then the relation becomes a relation for `x'` whose quadratic coefficients are
`a'ₚᵩ = Σᵢⱼ aᵢⱼ Nᵢₚ Nⱼᵩ`, and the new family generates the maximal ideal as soon as `N` is
invertible — which, over a local ring, is detected by the residue of its determinant.

Combining the two gives the normal form the source reaches in case II. There the quadratic form
is an element of `κ*` times the square of a linear form, so the residues of the quadratic
coefficients form the rank one matrix `c · lᵢlⱼ` of a nonzero scalar `c` and a nonzero linear
form `l`. A nonzero linear form on a three dimensional space can be moved onto the last
coordinate by an invertible matrix, and the change of generators it gives makes `a₃₃` a unit and
every other coefficient lie in `𝔪`; dividing by that unit, the relation reads
`x₃² = Σ aᵢⱼₖ xᵢxⱼxₖ`.

## Main results

* `AlgebraicGeometry.exists_cubicExpansion_of_coeffs_mem`: a quadratic expression in a family
  generating the maximal ideal whose coefficients all lie in the maximal ideal is a cubic
  expression in that family.
* `AlgebraicGeometry.exists_quadraticRelation_sub`: changing the quadratic coefficients of a
  relation by elements of the maximal ideal leaves a relation.
* `AlgebraicGeometry.exists_quadraticRelation_changeOfGenerators`: the relation transported
  along `xᵢ = Σ Nᵢₚ x'ₚ`.
* `AlgebraicGeometry.isUnit_det_of_residue_det_ne_zero`: a square matrix over a local ring whose
  reduction modulo the maximal ideal has nonzero determinant is invertible.
* `AlgebraicGeometry.span_range_eq_of_isUnit_det`: an invertible matrix carries a family to one
  spanning the same ideal, and `AlgebraicGeometry.eq_sum_nonsingInv_mul` expresses the old family
  in terms of the new one, which is the shape the transport of a relation consumes.
* `AlgebraicGeometry.exists_sq_eq_cubicExpansion`: the case II normal form `x₃² = Σ aᵢⱼₖ
  xᵢxⱼxₖ`, from a relation whose coefficient at `(3, 3)` is a unit and whose other coefficients
  lie in the maximal ideal.
* `AlgebraicGeometry.exists_det_ne_zero_annihilating`: a nonzero linear form on a three
  dimensional space is moved onto the last coordinate by an invertible matrix.
* `AlgebraicGeometry.exists_span_eq_and_sq_eq_cubicExpansion`: the case II normal form from the
  source's own hypothesis on the quadratic form.

## Implementation notes

The cubic side of a transported relation is not computed: the common value of the two sides of a
relation lies in `𝔪³`, which is the ideal generated by the triple products of any family
generating `𝔪`, so `AlgebraicGeometry.exists_triple_expansion` produces the new cubic
coefficients. Only the quadratic coefficients, which carry the quadratic form, are given
explicitly.

The hypothesis that the quadratic form is an element of `κ*` times the square of a linear form
is spelled as rank one-ness of the full matrix of residues, `residue (aᵢⱼ) = c · lᵢ · lⱼ`. That
is the same condition in every characteristic: the polynomial `Σᵢⱼ c lᵢlⱼ tᵢtⱼ` is `c · (Σ lᵢtᵢ)²`
whether or not `2` is invertible, and conversely a quadratic form in the source's upper
triangular presentation has such a full matrix because its off-diagonal coefficients are
`2c lᵢlⱼ`.

## References

* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
* [Stacks Project, Tag 0BGC](https://stacks.math.columbia.edu/tag/0BGC)
-/

@[expose] public section

open IsLocalRing

universe u

namespace AlgebraicGeometry

variable {A : Type u} [CommRing A] [IsLocalRing A]

/-- A quadruple sum may be reordered so that the last two indices come first. -/
public theorem sum_comm_four {M : Type*} [AddCommMonoid M] {n : ℕ}
    (F : Fin n → Fin n → Fin n → Fin n → M) :
    ∑ i, ∑ j, ∑ p, ∑ q, F i j p q = ∑ p, ∑ q, ∑ i, ∑ j, F i j p q :=
  calc ∑ i, ∑ j, ∑ p, ∑ q, F i j p q
      = ∑ i, ∑ p, ∑ j, ∑ q, F i j p q := Finset.sum_congr rfl fun _ _ => Finset.sum_comm
    _ = ∑ p, ∑ i, ∑ j, ∑ q, F i j p q := Finset.sum_comm
    _ = ∑ p, ∑ i, ∑ q, ∑ j, F i j p q :=
        Finset.sum_congr rfl fun _ _ => Finset.sum_congr rfl fun _ _ => Finset.sum_comm
    _ = ∑ p, ∑ q, ∑ i, ∑ j, F i j p q := Finset.sum_congr rfl fun _ _ => Finset.sum_comm

/-! ### Subsuming a quadratic term with coefficient in the maximal ideal -/

/-- A quadratic expression in a family generating the maximal ideal whose coefficients all lie
in the maximal ideal is a cubic expression in that family: each coefficient is itself a
combination of the generators. -/
public theorem exists_cubicExpansion_of_coeffs_mem {n : ℕ} (x : Fin n → A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (a : Fin n → Fin n → A) (ha : ∀ i j, a i j ∈ maximalIdeal A) :
    ∃ b : Fin n → Fin n → Fin n → A,
      ∑ i, ∑ j, a i j * (x i * x j) = ∑ i, ∑ j, ∑ k, b i j k * (x i * x j * x k) := by
  have hmem : ∀ i j, ∃ c : Fin n → A, ∑ k, c k * x k = a i j := by
    intro i j
    have hx : a i j ∈ Ideal.span (Set.range x) := by rw [hspan]; exact ha i j
    rw [Ideal.span, Submodule.mem_span_range_iff_exists_fun] at hx
    obtain ⟨c, hc⟩ := hx
    exact ⟨c, by simpa [smul_eq_mul] using hc⟩
  choose c hc using hmem
  refine ⟨c, Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_⟩
  rw [← hc i j, Finset.sum_mul]
  exact Finset.sum_congr rfl fun k _ => by ring

/-- Changing the quadratic coefficients of a relation by elements of the maximal ideal leaves a
relation: this is the source's remark that a term whose coefficient has vanishing residue can be
subsumed into the cubic right hand side. -/
public theorem exists_quadraticRelation_sub {n : ℕ} (x : Fin n → A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (a a' : Fin n → Fin n → A) (b : Fin n → Fin n → Fin n → A)
    (hdiff : ∀ i j, a i j - a' i j ∈ maximalIdeal A)
    (hrel : ∑ i, ∑ j, a i j * (x i * x j) = ∑ i, ∑ j, ∑ k, b i j k * (x i * x j * x k)) :
    ∃ b' : Fin n → Fin n → Fin n → A,
      ∑ i, ∑ j, a' i j * (x i * x j) = ∑ i, ∑ j, ∑ k, b' i j k * (x i * x j * x k) := by
  obtain ⟨d, hd⟩ := exists_cubicExpansion_of_coeffs_mem x hspan
    (fun i j => a i j - a' i j) hdiff
  refine ⟨fun i j k => b i j k - d i j k, ?_⟩
  have h1 : ∑ i, ∑ j, a' i j * (x i * x j)
      = (∑ i, ∑ j, a i j * (x i * x j)) - ∑ i, ∑ j, (a i j - a' i j) * (x i * x j) := by
    simp [sub_mul, Finset.sum_sub_distrib]
  rw [h1, hrel, hd]
  simp [sub_mul, Finset.sum_sub_distrib]

/-! ### Changing the generators -/

/-- A square matrix over a local ring whose reduction modulo the maximal ideal has nonzero
determinant is invertible. -/
public theorem isUnit_det_of_residue_det_ne_zero {n : ℕ} (N : Matrix (Fin n) (Fin n) A)
    (h : (N.map (residue A)).det ≠ 0) : IsUnit N.det := by
  rw [← IsLocalRing.notMem_maximalIdeal]
  intro hmem
  have hdet : residue A N.det = (N.map (residue A)).det := RingHom.map_det (residue A) N
  exact h (hdet ▸ (IsLocalRing.residue_eq_zero_iff _).mpr hmem)

/-- Multiplying a family by a matrix and then by a left inverse of it returns the family. -/
public theorem sum_mul_sum_of_mul_eq_one {n : ℕ} (M M' : Matrix (Fin n) (Fin n) A)
    (h : M * M' = 1) (v : Fin n → A) (i : Fin n) : ∑ p, M i p * ∑ q, M' p q * v q = v i :=
  calc ∑ p, M i p * ∑ q, M' p q * v q
      = ∑ p, ∑ q, M i p * M' p q * v q := Finset.sum_congr rfl fun p _ => by
        rw [Finset.mul_sum]
        exact Finset.sum_congr rfl fun q _ => by ring
    _ = ∑ q, ∑ p, M i p * M' p q * v q := Finset.sum_comm
    _ = ∑ q, (M * M') i q * v q := Finset.sum_congr rfl fun q _ => by
        rw [Matrix.mul_apply, Finset.sum_mul]
    _ = ∑ q, (1 : Matrix (Fin n) (Fin n) A) i q * v q := by rw [h]
    _ = v i := by simp [Matrix.one_apply]

/-- The inverse change of generators: if `x'ᵢ = Σ Mᵢₚ xₚ` for an invertible matrix `M`, then
`xᵢ = Σ (M⁻¹)ᵢₚ x'ₚ`. -/
public theorem eq_sum_nonsingInv_mul {n : ℕ} (x x' : Fin n → A)
    (M : Matrix (Fin n) (Fin n) A) (hM : IsUnit M.det)
    (hx' : ∀ i, x' i = ∑ p, M i p * x p) (i : Fin n) : x i = ∑ p, M⁻¹ i p * x' p := by
  rw [← sum_mul_sum_of_mul_eq_one M⁻¹ M (Matrix.nonsing_inv_mul M hM) x i]
  exact Finset.sum_congr rfl fun p _ => by rw [hx' p]

/-- A family expressed through a matrix in terms of `x` spans an ideal contained in the span of
`x`. -/
private theorem span_range_le_of_eq_sum_mul {B : Type*} [CommRing B] {n : ℕ} (x x' : Fin n → B)
    (M : Matrix (Fin n) (Fin n) B) (hx' : ∀ i, x' i = ∑ p, M i p * x p) :
    Ideal.span (Set.range x') ≤ Ideal.span (Set.range x) := by
  rw [Ideal.span_le]
  rintro z ⟨i, rfl⟩
  rw [SetLike.mem_coe, hx' i]
  exact Ideal.sum_mem _ fun p _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨p, rfl⟩)

/-- An invertible matrix carries a family of ring elements to a family spanning the same ideal. -/
public theorem span_range_eq_of_isUnit_det {n : ℕ} (x x' : Fin n → A)
    (M : Matrix (Fin n) (Fin n) A) (hM : IsUnit M.det)
    (hx' : ∀ i, x' i = ∑ p, M i p * x p) :
    Ideal.span (Set.range x') = Ideal.span (Set.range x) :=
  le_antisymm (span_range_le_of_eq_sum_mul x x' M hx')
    (span_range_le_of_eq_sum_mul x' x M⁻¹ (eq_sum_nonsingInv_mul x x' M hM hx'))

/-- **A quadratic relation under a change of generators.** If `xᵢ = Σ Nᵢₚ x'ₚ` for a family `x'`
generating the maximal ideal, then a relation `Σ aᵢⱼ xᵢxⱼ = Σ aᵢⱼₖ xᵢxⱼxₖ` becomes a relation
for `x'` whose quadratic coefficients are `a'ₚᵩ = Σᵢⱼ aᵢⱼ Nᵢₚ Nⱼᵩ`. -/
public theorem exists_quadraticRelation_changeOfGenerators {n : ℕ} (x x' : Fin n → A)
    (hspan' : Ideal.span (Set.range x') = maximalIdeal A)
    (N : Matrix (Fin n) (Fin n) A) (hx : ∀ i, x i = ∑ p, N i p * x' p)
    (a : Fin n → Fin n → A) (b : Fin n → Fin n → Fin n → A)
    (hrel : ∑ i, ∑ j, a i j * (x i * x j) = ∑ i, ∑ j, ∑ k, b i j k * (x i * x j * x k)) :
    ∃ b' : Fin n → Fin n → Fin n → A,
      ∑ p, ∑ q, (∑ i, ∑ j, a i j * (N i p * N j q)) * (x' p * x' q)
        = ∑ p, ∑ q, ∑ r, b' p q r * (x' p * x' q * x' r) := by
  have hxmem : ∀ i, x i ∈ maximalIdeal A := fun i => by
    rw [← hspan']
    exact span_range_le_of_eq_sum_mul x' x N hx (Ideal.subset_span ⟨i, rfl⟩)
  have hquad : ∑ i, ∑ j, a i j * (x i * x j)
      = ∑ p, ∑ q, (∑ i, ∑ j, a i j * (N i p * N j q)) * (x' p * x' q) := by
    have expand : ∀ i j : Fin n, a i j * (x i * x j)
        = ∑ p, ∑ q, a i j * (N i p * N j q) * (x' p * x' q) := by
      intro i j
      rw [hx i, hx j, Finset.sum_mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun p _ => ?_
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun q _ => by ring
    calc ∑ i, ∑ j, a i j * (x i * x j)
        = ∑ i, ∑ j, ∑ p, ∑ q, a i j * (N i p * N j q) * (x' p * x' q) :=
          Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => expand i j
      _ = ∑ p, ∑ q, ∑ i, ∑ j, a i j * (N i p * N j q) * (x' p * x' q) := sum_comm_four _
      _ = ∑ p, ∑ q, (∑ i, ∑ j, a i j * (N i p * N j q)) * (x' p * x' q) :=
          Finset.sum_congr rfl fun p _ => Finset.sum_congr rfl fun q _ => by
            simp only [Finset.sum_mul]
  have hmem : ∑ i, ∑ j, ∑ k, b i j k * (x i * x j * x k) ∈ maximalIdeal A ^ 3 := by
    refine Ideal.sum_mem _ fun i _ => Ideal.sum_mem _ fun j _ => Ideal.sum_mem _ fun k _ => ?_
    refine Ideal.mul_mem_left _ _ ?_
    rw [pow_succ, pow_succ, pow_one]
    exact Ideal.mul_mem_mul (Ideal.mul_mem_mul (hxmem i) (hxmem j)) (hxmem k)
  rw [← hspan', span_pow_three_eq_span_triples] at hmem
  obtain ⟨b', hb'⟩ := exists_triple_expansion x' hmem
  exact ⟨b', by rw [← hquad, hrel]; exact hb'⟩

/-! ### The normal form of case II -/

/-- **The normal form of case II.** A quadratic relation among three generators of the maximal
ideal whose coefficient at `(3, 3)` is a unit and whose other coefficients lie in the maximal
ideal reads `x₃² = Σ aᵢⱼₖ xᵢxⱼxₖ` after dividing by that unit. This is the shape the source
reaches in case II, where the quadratic form is `t₃²` after a change of generators. -/
public theorem exists_sq_eq_cubicExpansion (x : Fin 3 → A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (a : Fin 3 → Fin 3 → A) (b : Fin 3 → Fin 3 → Fin 3 → A)
    (hunit : a 2 2 ∉ maximalIdeal A)
    (hother : ∀ i j, ¬(i = 2 ∧ j = 2) → a i j ∈ maximalIdeal A)
    (hrel : ∑ i, ∑ j, a i j * (x i * x j) = ∑ i, ∑ j, ∑ k, b i j k * (x i * x j * x k)) :
    ∃ b' : Fin 3 → Fin 3 → Fin 3 → A,
      x 2 * x 2 = ∑ i, ∑ j, ∑ k, b' i j k * (x i * x j * x k) := by
  classical
  have hdiff : ∀ i j, a i j - (if i = 2 ∧ j = 2 then a 2 2 else 0) ∈ maximalIdeal A := by
    intro i j
    by_cases h : i = 2 ∧ j = 2
    · obtain ⟨rfl, rfl⟩ := h
      simp
    · simpa [h] using hother i j h
  obtain ⟨b'', hb''⟩ := exists_quadraticRelation_sub x hspan a
    (fun i j => if i = 2 ∧ j = 2 then a 2 2 else 0) b hdiff hrel
  have hsum : ∑ i, ∑ j, (if i = 2 ∧ j = 2 then a 2 2 else 0) * (x i * x j)
      = a 2 2 * (x 2 * x 2) := by
    simp [Fin.sum_univ_three]
  rw [hsum] at hb''
  obtain ⟨u, hu⟩ := IsLocalRing.notMem_maximalIdeal.mp hunit
  have hinv : (↑u⁻¹ : A) * a 2 2 = 1 := by rw [← hu]; exact u.inv_mul
  refine ⟨fun i j k => (↑u⁻¹ : A) * b'' i j k, ?_⟩
  calc x 2 * x 2 = (↑u⁻¹ : A) * (a 2 2 * (x 2 * x 2)) := by rw [← mul_assoc, hinv, one_mul]
    _ = ∑ i, ∑ j, ∑ k, (↑u⁻¹ : A) * b'' i j k * (x i * x j * x k) := by
        rw [hb'']
        simp only [Finset.mul_sum, mul_assoc]

/-! ### Reaching the normal form of case II from a rank one quadratic form -/

/-- Every square matrix over the residue field of a local ring lifts to one over the ring. -/
public theorem exists_map_residue_eq {n : ℕ} (P : Matrix (Fin n) (Fin n) (ResidueField A)) :
    ∃ N : Matrix (Fin n) (Fin n) A, N.map (residue A) = P := by
  choose c hc using fun i p => IsLocalRing.residue_surjective (R := A) (P i p)
  exact ⟨Matrix.of fun i p => c i p, by ext i p; exact hc i p⟩

/-- A nonzero linear form on a three dimensional space can be moved onto the last coordinate:
there is an invertible matrix over the field whose last column the form does not annihilate and
whose other columns it does. -/
public theorem exists_det_ne_zero_annihilating {k : Type*} [Field k] (l : Fin 3 → k)
    (hl : l ≠ 0) :
    ∃ P : Matrix (Fin 3) (Fin 3) k, P.det ≠ 0 ∧ (∑ i, l i * P i 2) ≠ 0 ∧
      ∀ p, p ≠ 2 → ∑ i, l i * P i p = 0 := by
  obtain ⟨m, hm⟩ : ∃ m, l m ≠ 0 := Function.ne_iff.mp hl
  have hcases : ∀ r : Fin 3, r = 0 ∨ r = 1 ∨ r = 2 := by decide
  have hne : ∀ r : Fin 3, r ≠ 2 → r = 0 ∨ r = 1 := by decide
  rcases hcases m with rfl | rfl | rfl <;>
    [refine ⟨!![-l 1, -l 2, 1; l 0, 0, 0; 0, l 0, 0], ?_, ?_, ?_⟩;
     refine ⟨!![l 1, 0, 0; -l 0, -l 2, 1; 0, l 1, 0], ?_, ?_, ?_⟩;
     refine ⟨!![l 2, 0, 0; 0, l 2, 0; -l 0, -l 1, 1], ?_, ?_, ?_⟩]
  all_goals first
    | simpa [Matrix.det_fin_three] using pow_ne_zero 2 hm
    | simpa [Fin.sum_univ_three] using hm
    | (intro p hp
       rcases hne p hp with rfl | rfl <;> simp [Fin.sum_univ_three, mul_comm])

/-- **Case II of the rational double point discussion.** Suppose the quadratic relation among
three generators of the maximal ideal has a coefficient matrix whose residues form the rank one
matrix `c · lᵢlⱼ` of a nonzero linear form `l` and a nonzero scalar `c` — that is, suppose the
quadratic form of the singularity is an element of `κ*` times the square of a linear form. Then
after a change of the generators the relation reads `x₃² = Σ aᵢⱼₖ xᵢxⱼxₖ`. -/
public theorem exists_span_eq_and_sq_eq_cubicExpansion (x : Fin 3 → A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (a : Fin 3 → Fin 3 → A) (b : Fin 3 → Fin 3 → Fin 3 → A)
    (c : ResidueField A) (hc : c ≠ 0) (l : Fin 3 → ResidueField A) (hl : l ≠ 0)
    (ha : ∀ i j, residue A (a i j) = c * l i * l j)
    (hrel : ∑ i, ∑ j, a i j * (x i * x j) = ∑ i, ∑ j, ∑ k, b i j k * (x i * x j * x k)) :
    ∃ (x' : Fin 3 → A) (b' : Fin 3 → Fin 3 → Fin 3 → A),
      Ideal.span (Set.range x') = maximalIdeal A ∧
        x' 2 * x' 2 = ∑ i, ∑ j, ∑ k, b' i j k * (x' i * x' j * x' k) := by
  obtain ⟨P, hPdet, hPlast, hPother⟩ := exists_det_ne_zero_annihilating l hl
  obtain ⟨N, hN⟩ := exists_map_residue_eq P
  have hNP : ∀ i p, residue A (N i p) = P i p := fun i p => by rw [← hN]; rfl
  have hNdet : IsUnit N.det := isUnit_det_of_residue_det_ne_zero N (by rw [hN]; exact hPdet)
  -- the new generators and the matrix expressing the old ones in terms of them
  have hspan' : Ideal.span (Set.range fun p => ∑ q, N⁻¹ p q * x q) = maximalIdeal A := by
    rw [span_range_eq_of_isUnit_det x _ N⁻¹ (Matrix.isUnit_nonsing_inv_det N hNdet)
      fun i => rfl]
    exact hspan
  have hx : ∀ i, x i = ∑ p, N i p * ∑ q, N⁻¹ p q * x q := fun i =>
    (sum_mul_sum_of_mul_eq_one N N⁻¹ (Matrix.mul_nonsing_inv N hNdet) x i).symm
  obtain ⟨b', hb'⟩ := exists_quadraticRelation_changeOfGenerators x _ hspan' N hx a b hrel
  -- the residues of the transported coefficients
  have hrank : ∀ p q : Fin 3, residue A (∑ i, ∑ j, a i j * (N i p * N j q))
      = c * (∑ i, l i * P i p) * ∑ j, l j * P j q := by
    intro p q
    have hexpand : c * (∑ i, l i * P i p) * (∑ j, l j * P j q)
        = ∑ i, ∑ j, c * l i * l j * (P i p * P j q) := by
      rw [mul_assoc, Finset.sum_mul_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl fun j _ => by ring
    rw [hexpand, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_sum]
    exact Finset.sum_congr rfl fun j _ => by rw [map_mul, ha i j, map_mul, hNP i p, hNP j q]
  have hunit : (∑ i, ∑ j, a i j * (N i 2 * N j 2)) ∉ maximalIdeal A := by
    intro hmem
    have hzero : residue A (∑ i, ∑ j, a i j * (N i 2 * N j 2)) = 0 :=
      (IsLocalRing.residue_eq_zero_iff _).mpr hmem
    rw [hrank 2 2] at hzero
    exact mul_ne_zero (mul_ne_zero hc hPlast) hPlast hzero
  have hother : ∀ p q : Fin 3, ¬(p = 2 ∧ q = 2) →
      (∑ i, ∑ j, a i j * (N i p * N j q)) ∈ maximalIdeal A := by
    intro p q hpq
    rw [← IsLocalRing.residue_eq_zero_iff, hrank p q]
    rcases not_and_or.mp hpq with hp | hq
    · rw [hPother p hp]; ring
    · rw [hPother q hq]; ring
  obtain ⟨b'', hb''⟩ := exists_sq_eq_cubicExpansion _ hspan'
    (fun p q => ∑ i, ∑ j, a i j * (N i p * N j q)) b' hunit hother hb'
  exact ⟨_, b'', hspan', hb''⟩

end AlgebraicGeometry

