module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.BlowUpSituation
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.BlowupStillGood
public import StacksFrontier.RingTheory.Dualizing.EmbeddingCodimensionOne

/-!
# The rational double point situation propagates to the blowup

Let `S` be a Situation [Stacks, Tag 0BGC] with ring `A`, and let `x` be a closed point of the
blowup `X` of `Spec(A)` in the maximal ideal. If `𝒪_{X, x}` defines a rational singularity, is not
regular, and has a maximal ideal generated by three elements, then `𝒪_{X, x}` is again the ring
of a Situation 0BGC.

## Main definitions

* `RationalDoublePointSituation.blowUpSituationOfSpanFinrank`: the Situation 0BGC at such a
  point.

## Main results

* `RationalDoublePointSituation.isNormalDomain_adicCompletion_stalk_blowUp_of_isClosed`: the
  completion of the local ring at a closed point of the blowup is a normal domain.
* `RationalDoublePointSituation.isGorensteinLocalRing_stalk_blowUp_of_spanFinrank`: the local
  ring at a closed point of the blowup whose maximal ideal has three generators is Gorenstein.
* `RationalDoublePointSituation.isRationalDoublePointAt_blowUp_of_spanFinrank`: such a point is
  again a rational double point.

## References

* [Stacks Project, Tag 0BGC](https://stacks.math.columbia.edu/tag/0BGC)
* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
* [Stacks Project, Tag 0BG7](https://stacks.math.columbia.edu/tag/0BG7)
-/

@[expose] public noncomputable section

open CategoryTheory IsLocalRing

universe u

namespace AlgebraicGeometry

namespace RationalDoublePointSituation

/-- **Clause (2) of Tag 0BG7 at a rational double point.** The completion of the local ring at a
closed point of the blowup of `Spec(A)` in the maximal ideal is a normal domain. -/
theorem isNormalDomain_adicCompletion_stalk_blowUp_of_isClosed
    (S : RationalDoublePointSituation.{u})
    (x : blowUp (maximalIdealSheaf S.A))
    (hx : IsClosed ({x} : Set (blowUp (maximalIdealSheaf S.A)))) :
    IsNormalDomain (AdicCompletion
      (IsLocalRing.maximalIdeal ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk x))
      ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk x)) :=
  let := S.completion_normalDomain
  (definesRationalSingularity_adicCompletion_and_isNormalDomain_stalk_blowUp S.A S.nagata
    S.dimension_two S.definesRationalSingularity).2 x hx

/-- **Gorenstein propagation.** The local ring at a closed point of the blowup of `Spec(A)` in the
maximal ideal, whose maximal ideal is generated by three elements, is Gorenstein. -/
theorem isGorensteinLocalRing_stalk_blowUp_of_spanFinrank (S : RationalDoublePointSituation.{u})
    (x : blowUp (maximalIdealSheaf S.A))
    (hx : IsClosed ({x} : Set (blowUp (maximalIdealSheaf S.A))))
    (hgen : (IsLocalRing.maximalIdeal
      ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk x)).spanFinrank ≤ 3) :
    letI : IsNoetherianRing ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk x) :=
      (S.isNagataRing_stalk_blowUp x).isNoetherianRing
    Dualizing.IsGorensteinLocalRing ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk x) := by
  have : IsNoetherianRing ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk x) :=
    (S.isNagataRing_stalk_blowUp x).isNoetherianRing
  have := S.isNormalDomain_adicCompletion_stalk_blowUp_of_isClosed x hx
  exact Dualizing.isGorensteinLocalRing_of_spanFinrank_maximalIdeal_le_succ _ (d := 2)
    (by simpa using S.ringKrullDim_stalk_blowUp_eq_two x hx) hgen inferInstance

/-- **The Situation 0BGC at a closed point of the blowup.** A closed point of the blowup of
`Spec(A)` in the maximal ideal whose local ring defines a rational singularity, is not regular,
and has embedding dimension at most three carries a Situation 0BGC with that local ring. -/
def blowUpSituationOfSpanFinrank (S : RationalDoublePointSituation.{u})
    (x : blowUp (maximalIdealSheaf S.A))
    (hx : IsClosed ({x} : Set (blowUp (maximalIdealSheaf S.A))))
    (hrat :
      letI : IsNormalDomain ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk x) :=
        S.isNormalDomain_stalk_blowUp x
      DefinesRationalSingularity ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk x))
    (hgen : (IsLocalRing.maximalIdeal
      ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk x)).spanFinrank ≤ 3)
    (hsing : ¬ IsRegularLocalRing ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk x)) :
    RationalDoublePointSituation.{u} where
  A := (blowUp (maximalIdealSheaf S.A)).presheaf.stalk x
  normalDomain := S.isNormalDomain_stalk_blowUp x
  nagata := S.isNagataRing_stalk_blowUp x
  dimension_two := S.ringKrullDim_stalk_blowUp_eq_two x hx
  definesRationalSingularity := hrat
  completion_normalDomain := S.isNormalDomain_adicCompletion_stalk_blowUp_of_isClosed x hx
  gorenstein := S.isGorensteinLocalRing_stalk_blowUp_of_spanFinrank x hx hgen
  not_isRegularLocalRing := hsing

/-- The ring of `blowUpSituationOfSpanFinrank` is the local ring at the point. -/
@[simp]
theorem blowUpSituationOfSpanFinrank_A (S : RationalDoublePointSituation.{u})
    {x hx hrat hgen hsing} :
    (S.blowUpSituationOfSpanFinrank x hx hrat hgen hsing).A =
      (blowUp (maximalIdealSheaf S.A)).presheaf.stalk x :=
  rfl

/-- The property carried by a rule for choosing centres, at a closed point of the blowup of
`Spec(A)` which defines a rational singularity, is singular and has embedding dimension at most
three. -/
theorem isRationalDoublePointAt_blowUp_of_spanFinrank (S : RationalDoublePointSituation.{u})
    (x : blowUp (maximalIdealSheaf S.A))
    (hx : IsClosed ({x} : Set (blowUp (maximalIdealSheaf S.A))))
    (hrat :
      letI : IsNormalDomain ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk x) :=
        S.isNormalDomain_stalk_blowUp x
      DefinesRationalSingularity ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk x))
    (hgen : (IsLocalRing.maximalIdeal
      ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk x)).spanFinrank ≤ 3)
    (hsing : ¬ IsRegularLocalRing ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk x))
    (z : (blowUp (maximalIdealSheaf S.A)).presheaf.stalk x) :
    IsRationalDoublePointAt (blowUp (maximalIdealSheaf S.A)) x z :=
  ⟨S.blowUpSituationOfSpanFinrank x hx hrat hgen hsing, ⟨RingEquiv.refl _⟩⟩

end RationalDoublePointSituation

end AlgebraicGeometry

end
