module

public import StacksFrontier.RingTheory.MvPolynomial.MaximalIdeal
public import StacksFrontier.RingTheory.RegularLocalRing.Colimit
public import StacksFrontier.RingTheory.Serre.FlatAscent

/-!
# The Claim of Section 54.12: a point where the exceptional curve is smooth is a regular point

Let `R` be a two-dimensional Noetherian local ring and `x₀ ∈ 𝔪_R`. Suppose that `R/x₀R` is a
quotient of the localization of `κ[y₂, y₃]` at a maximal ideal `M`, by an ideal containing an
element `f ∈ M` with `f ∉ M²`. Then `R` is regular: `κ[y₂, y₃]_M/(f)` is regular of dimension one
([Stacks, Tag 00OP] and [Stacks, Tag 00NQ]), so the maximal ideal of `R/x₀R` is principal and the
maximal ideal of `R` is generated by two elements.

This is the contrapositive of the source's Claim: at a singular point `p` of the blowup of a
rational double point, lying in the chart `A[𝔪/x₁]`, the dehomogenized quadratic form
`q(1, y₂, y₃)` lies in `M²`, where `M` cuts out `p` on the exceptional curve.

## Main results

* `AlgebraicGeometry.isRegularLocalRing_of_surjective_localization_quotient`
-/

@[expose] public section

open IsLocalRing

universe u v

namespace AlgebraicGeometry

/-- An element of a ring outside the square of a maximal ideal stays outside the square of the
maximal ideal of the localization there. -/
theorem algebraMap_notMem_maximalIdeal_sq {P : Type u} [CommRing P] (M : Ideal P) [hM : M.IsMaximal]
    {f : P} (hf : f ∉ M ^ 2) :
    algebraMap P (Localization.AtPrime M) f ∉ maximalIdeal (Localization.AtPrime M) ^ 2 := by
  intro h
  rw [← Localization.AtPrime.map_eq_maximalIdeal, ← Ideal.map_pow] at h
  have hprim : (M ^ 2).IsPrimary := Ideal.isPrimary_of_isMaximal_radical (by
    rwa [Ideal.radical_pow M two_ne_zero, hM.isPrime.radical])
  have hdisj : Disjoint (M.primeCompl : Set P) (M ^ 2 : Ideal P) :=
    Set.disjoint_left.mpr fun _ ha ha2 => ha (Ideal.pow_le_self two_ne_zero ha2)
  refine hf ?_
  rw [← IsLocalization.under_map_of_isPrimary_disjoint M.primeCompl
    (Localization.AtPrime M) hprim hdisj]
  exact h

/-- **The Claim of Section 54.12, contrapositive form.** Let `R` be a Noetherian local ring of
dimension at least two and `x₀ ∈ 𝔪_R`. If `R/x₀R` is the image of a surjection from the local
ring of `κ[y₂, y₃]` at a maximal ideal `M`, killing an element `f ∈ M` with `f ∉ M²`, then `R`
is regular. -/
theorem isRegularLocalRing_of_surjective_localization_quotient {R : Type u} [CommRing R]
    [IsLocalRing R] [IsNoetherianRing R] (hdim : 2 ≤ ringKrullDim R) {x₀ : R}
    (hx₀ : x₀ ∈ maximalIdeal R) {k : Type v} [Field k] (M : Ideal (MvPolynomial (Fin 2) k))
    [hM : M.IsMaximal] (ρ : Localization.AtPrime M →+* R ⧸ Ideal.span {x₀})
    (hρ : Function.Surjective ρ) {f : MvPolynomial (Fin 2) k} (hfM : f ∈ M) (hf : f ∉ M ^ 2)
    (hρf : ρ (algebraMap _ _ f) = 0) : IsRegularLocalRing R := by
  have hnt : Nontrivial (R ⧸ Ideal.span {x₀}) := Ideal.Quotient.nontrivial_iff.mpr (by
    rw [Ne, Ideal.span_singleton_eq_top]
    exact (mem_maximalIdeal _).mp hx₀)
  have : IsLocalRing (R ⧸ Ideal.span {x₀}) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective
  have : IsLocalHom ρ := IsLocalHom.of_surjective ρ hρ
  have hreg : IsRegularLocalRing (Localization.AtPrime M) :=
    isRegularLocalRing_localization_atPrime 2 M hM
  have hdimL : ringKrullDim (Localization.AtPrime M) = 2 := by
    simpa using ringKrullDim_localization_atPrime_eq 2 M hM
  have hL : (maximalIdeal (Localization.AtPrime M)).spanFinrank = 2 := by
    have h := (isRegularLocalRing_iff (Localization.AtPrime M)).mp hreg
    rw [hdimL] at h
    exact_mod_cast h
  have hfm : algebraMap _ (Localization.AtPrime M) f ∈ maximalIdeal (Localization.AtPrime M) := by
    rw [← Localization.AtPrime.map_eq_maximalIdeal]
    exact Ideal.mem_map_of_mem _ hfM
  have hQ := Stacks.RegularLocalRing.SpanFinrank.spanFinrank_maximalIdeal_succ_le_of_surjective
    ρ hρ hfm (algebraMap_notMem_maximalIdeal_sq M hf) hρf
  rw [hL] at hQ
  have hle := spanFinrank_le_add_spanFinrank_map_quotient
    ((Ideal.span_singleton_le_iff_mem _).mpr hx₀)
  rw [IsLocalRing.map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective] at hle
  have hspan1 : (Ideal.span {x₀} : Ideal R).spanFinrank ≤ 1 := by
    refine le_trans (Submodule.spanFinrank_span_le_ncard_of_finite (Set.finite_singleton _)) ?_
    simp
  refine IsRegularLocalRing.of_spanFinrank_maximalIdeal_le R (le_trans ?_ hdim)
  have : (maximalIdeal R).spanFinrank ≤ 2 := by omega
  exact_mod_cast this

end AlgebraicGeometry

end
