module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.CaseTwoChart

/-!
# Case II of Section 54.12: the three charts

The singular case II points of the blowup of a local ring in case II, chart by chart, for the
three levels of the case II analysis:

* the normal form `x₃² = Σ bₚᵩᵣ xₚxᵩxᵣ` (`AlgebraicGeometry.IsCaseTwo`): on the charts `x₁, x₂` a
  singular case II point satisfies the exact invariant `AlgebraicGeometry.HasDoubleLineRelation`
  (`AlgebraicGeometry.hasDoubleLineRelation_of_isCaseTwo_chart_zero`, `_chart_one`); the chart
  `x₃` has no point over `𝔪` (`AlgebraicGeometry.false_of_chart_two`);
* the invariant `w₃² = w₁F`, `F ∈ 𝔪²`: on the chart `w₁` a singular case II point satisfies the
  nondegenerate invariant `AlgebraicGeometry.HasDoubleLineRelationUnit` with the same first
  generator `w₁`, which also generates `𝔪B` (`…_chart_zero`); on the chart `w₂` either `𝔪B = w₁B`
  (the point lies on the chart `w₁`) or the point is `P*`, where the invariant holds again with
  `w₂` in the middle position and `𝔪B = w₂B` (`…_chart_one`);
* the nondegenerate invariant: on the chart `w₂` always `𝔪B = w₁B`
  (`AlgebraicGeometry.map_maximalIdeal_eq_span_of_hasDoubleLineRelationUnit_chart_one`).

These are the transitions that the termination argument for Tag 0BGE uses: along a chain of
singular case II points the distinguished element (`w₁` for the nondegenerate invariant, `w₂`
for the invariant) keeps generating the exceptional ideal, so Tag 0BG2 applies.

## References

* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
-/

@[expose] public section

open IsLocalRing Polynomial

universe u

namespace AlgebraicGeometry

variable {A : Type u} [CommRing A] [IsLocalRing A]

/-- The relation of `AlgebraicGeometry.IsCaseTwo` puts `w₃²` in `𝔪³`. -/
theorem mul_self_mem_pow_three_of_sq_eq_cubic {w : Fin 3 → A}
    (hspan : Ideal.span (Set.range w) = maximalIdeal A) (b : Fin 3 → Fin 3 → Fin 3 → A)
    (hrel : w 2 * w 2 = ∑ p, ∑ q, ∑ r, b p q r * (w p * w q * w r)) :
    w 2 * w 2 ∈ maximalIdeal A ^ 3 := by
  rw [hrel, ← hspan, span_pow_three_eq_span_triples]
  exact Ideal.sum_mem _ fun p _ => Ideal.sum_mem _ fun q _ => Ideal.sum_mem _ fun r _ =>
    Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨(p, q, r), rfl⟩)

/-- The case II invariant puts `w₃²` in `𝔪³`. -/
theorem HasDoubleLineRelation.mul_self_mem_pow_three {w : Fin 3 → A}
    (h : HasDoubleLineRelation A w) : w 2 * w 2 ∈ maximalIdeal A ^ 3 := by
  obtain ⟨hspan, F, hF, hsq⟩ := h
  rw [hsq, pow_succ']
  exact Ideal.mul_mem_mul (hspan ▸ Ideal.subset_span ⟨0, rfl⟩) hF

/-- **The third chart has no point over `𝔪`** in case II. -/
theorem false_of_chart_two {w : Fin 3 → A} (hspan : Ideal.span (Set.range w) = maximalIdeal A)
    (hsq : w 2 * w 2 ∈ maximalIdeal A ^ 3) (S : Type u) [CommRing S] [Algebra A S]
    [IsLocalization.Away (w 2) S] (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (w 2) S))
        [M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 2) S)) (maximalIdeal A)
        ≤ M) : False :=
  false_of_mul_self_mem_pow_three (hspan ▸ Ideal.subset_span ⟨2, rfl⟩) hsq S M hle

omit [IsLocalRing A] in
/-- Exchanging the first two of three generators does not change the ideal they span. -/
theorem span_range_comp_swap_zero_one (w : Fin 3 → A) :
    Ideal.span (Set.range (w ∘ Equiv.swap 0 1)) = Ideal.span (Set.range w) := by
  rw [Set.range_comp, Equiv.range_eq_univ, Set.image_univ]

omit [IsLocalRing A] in
/-- Reindexing a quadratic expression and its variables by the same permutation does not change
its value. -/
theorem sum_quadratic_comp_perm (w : Fin 3 → A) (f : Fin 3 → Fin 3 → A)
    (σ : Equiv.Perm (Fin 3)) :
    ∑ p, ∑ q, f (σ p) (σ q) * ((w ∘ σ) p * (w ∘ σ) q) = ∑ p, ∑ q, f p q * (w p * w q) := by
  rw [← Equiv.sum_comp σ (fun p => ∑ q, f p q * (w p * w q))]
  exact Finset.sum_congr rfl fun p _ => Equiv.sum_comp σ (fun q => f (σ p) q * (w (σ p) * w q))

omit [IsLocalRing A] in
/-- Reindexing a cubic expression and its variables by the same permutation does not change its
value. -/
theorem sum_cubic_comp_perm (w : Fin 3 → A) (b : Fin 3 → Fin 3 → Fin 3 → A)
    (σ : Equiv.Perm (Fin 3)) :
    ∑ p, ∑ q, ∑ r, b (σ p) (σ q) (σ r) * ((w ∘ σ) p * (w ∘ σ) q * (w ∘ σ) r) =
      ∑ p, ∑ q, ∑ r, b p q r * (w p * w q * w r) := by
  rw [← Equiv.sum_comp σ (fun p => ∑ q, ∑ r, b p q r * (w p * w q * w r))]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [← Equiv.sum_comp σ (fun q => ∑ r, b (σ p) q r * (w (σ p) * w q * w r))]
  exact Finset.sum_congr rfl fun q _ =>
    Equiv.sum_comp σ (fun r => b (σ p) (σ q) r * (w (σ p) * w (σ q) * w r))

/-- On the chart `x₁`, at a maximal ideal `M`, the extension of `𝔪` is generated by `x₁`. -/
private theorem map_maximalIdeal_localization_eq_span_zero {x : Fin 3 → A}
    (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away (x 0) S]
    (hx : ∀ i, x i ∈ maximalIdeal A) (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S))
    [M.IsMaximal] :
    Ideal.map ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (x 0) S)
        (Localization.AtPrime M)).comp
        (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S))) (maximalIdeal A) =
      Ideal.span {
          algebraMap (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (Localization.AtPrime M)
            (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0))} := by
  refine map_maximalIdeal_localization_eq_span S hx M 0 ?_
  rw [chartFraction_zero]
  exact fun h1 => (inferInstance : M.IsMaximal).ne_top ((Ideal.eq_top_iff_one M).mpr h1)

/-- **Stacks 0BGE, case II normal form, first chart.** A singular case II point of the chart
`x₁` of a ring with `x₃² = Σ bₚᵩᵣ xₚxᵩxᵣ` is `κ`-rational and satisfies the exact case II
invariant. -/
theorem hasDoubleLineRelation_of_isCaseTwo_chart_zero (w : Fin 3 → A)
    (hspan : Ideal.span (Set.range w) = maximalIdeal A) (b : Fin 3 → Fin 3 → Fin 3 → A)
    (hrel : w 2 * w 2 = ∑ p, ∑ q, ∑ r, b p q r * (w p * w q * w r))
    (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away (w 0) S]
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (w 0) S)) [M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 0) S)) (maximalIdeal A)
        ≤ M)
    [IsNoetherianRing (Localization.AtPrime M)] [IsDomain (Localization.AtPrime M)]
        [IsIntegrallyClosed (Localization.AtPrime M)]
    (hdim : ringKrullDim (Localization.AtPrime M) = 2) (hsing : ¬ IsRegularLocalRing
        (Localization.AtPrime M))
    (hII : ¬ IsCaseOne (Localization.AtPrime M)) :
    Function.Surjective ((Ideal.Quotient.mk M).comp (algebraMap A (affineBlowupAlgebra
        (maximalIdeal A) (w 0) S))) ∧
      Ideal.map ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (w 0) S) (Localization.AtPrime
          M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 0) S))) (maximalIdeal A)
          = Ideal.span {
              ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (w 0) S) (Localization.AtPrime
                M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 0) S))) (w 0)} ∧
      ∃ w' : Fin 3 → (Localization.AtPrime M), HasDoubleLineRelation (Localization.AtPrime M) w' :=
          by
  have hx : ∀ i, w i ∈ maximalIdeal A := fun i => hspan ▸ Ideal.subset_span ⟨i, rfl⟩
  obtain ⟨hsurj, c, μ, h⟩ := hasDoubleLineRelation_of_sq_eq_cubic_chart S hx hspan M hle hdim
    hsing hII b hrel
  exact ⟨hsurj, map_maximalIdeal_localization_eq_span_zero S hx M, _, h⟩

/-- **Stacks 0BGE, case II normal form, second chart.** A singular case II point of the chart
`x₂` of a ring with `x₃² = Σ bₚᵩᵣ xₚxᵩxᵣ` is `κ`-rational and satisfies the exact case II
invariant: the first chart with `x₁, x₂` exchanged. -/
theorem hasDoubleLineRelation_of_isCaseTwo_chart_one (w : Fin 3 → A)
    (hspan : Ideal.span (Set.range w) = maximalIdeal A) (b : Fin 3 → Fin 3 → Fin 3 → A)
    (hrel : w 2 * w 2 = ∑ p, ∑ q, ∑ r, b p q r * (w p * w q * w r))
    (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away (w 1) S]
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (w 1) S)) [M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 1) S)) (maximalIdeal A)
        ≤ M)
    [IsNoetherianRing (Localization.AtPrime M)] [IsDomain (Localization.AtPrime M)]
        [IsIntegrallyClosed (Localization.AtPrime M)]
    (hdim : ringKrullDim (Localization.AtPrime M) = 2) (hsing : ¬ IsRegularLocalRing
        (Localization.AtPrime M))
    (hII : ¬ IsCaseOne (Localization.AtPrime M)) :
    Function.Surjective ((Ideal.Quotient.mk M).comp (algebraMap A (affineBlowupAlgebra
        (maximalIdeal A) (w 1) S))) ∧
      Ideal.map ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (w 1) S) (Localization.AtPrime
          M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 1) S))) (maximalIdeal A)
          = Ideal.span {
              ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (w 1) S) (Localization.AtPrime
                M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 1) S))) (w 1)} ∧
      ∃ w' : Fin 3 → (Localization.AtPrime M), HasDoubleLineRelation (Localization.AtPrime M) w' :=
          by
  set σ := Equiv.swap (0 : Fin 3) 1
  have hspanσ : Ideal.span (Set.range (w ∘ σ)) = maximalIdeal A := by
    rw [span_range_comp_swap_zero_one, hspan]
  have hrelσ : (w ∘ σ) 2 * (w ∘ σ) 2 = ∑ p, ∑ q, ∑ r, b (σ p) (σ q) (σ r) *
      ((w ∘ σ) p * (w ∘ σ) q * (w ∘ σ) r) := by
    rw [sum_cubic_comp_perm]
    simpa [σ, Equiv.swap_apply_of_ne_of_ne] using hrel
  have key : ∀ (e : A) (he : e = (w ∘ σ) 0) [IsLocalization.Away e S]
      (M : Ideal (affineBlowupAlgebra (maximalIdeal A) e S)) [M.IsMaximal]
      (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) e S))
        (maximalIdeal A) ≤ M) [IsNoetherianRing (Localization.AtPrime M)] [IsDomain
            (Localization.AtPrime M)]
      [IsIntegrallyClosed (Localization.AtPrime M)] (hdim : ringKrullDim (Localization.AtPrime M) =
          2)
      (hsing : ¬ IsRegularLocalRing (Localization.AtPrime M)) (hII : ¬ IsCaseOne
          (Localization.AtPrime M)),
      Function.Surjective ((Ideal.Quotient.mk M).comp (algebraMap A (affineBlowupAlgebra
          (maximalIdeal A) (e) S))) ∧
        Ideal.map ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (e) S) (Localization.AtPrime
            M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (e) S))) (maximalIdeal A)
            = Ideal.span {
                ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (e) S) (Localization.AtPrime
                  M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (e) S))) (e)} ∧
        ∃ w' : Fin 3 → (Localization.AtPrime M), HasDoubleLineRelation (Localization.AtPrime M) w'
            := by
    intro e he _ M _ hle _ _ _ hdim hsing hII
    subst he
    exact hasDoubleLineRelation_of_isCaseTwo_chart_zero (w ∘ σ) hspanσ _ hrelσ S M hle hdim
      hsing hII
  exact key (w 1) (by simp [σ]) M hle hdim hsing hII

/-- **Stacks 0BGE, case II invariant, first chart.** If `w₃² = w₁F` with `F ∈ 𝔪²`, a singular
case II point of the chart `w₁` is `κ`-rational, `w₁` generates `𝔪B`, and `B` satisfies the
nondegenerate invariant with first generator `w₁`. -/
theorem hasDoubleLineRelationUnit_of_hasDoubleLineRelation_chart_zero (w : Fin 3 → A)
    (h : HasDoubleLineRelation A w)
    (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away (w 0) S]
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (w 0) S)) [M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 0) S)) (maximalIdeal A)
        ≤ M)
    [IsNoetherianRing (Localization.AtPrime M)] [IsDomain (Localization.AtPrime M)]
        [IsIntegrallyClosed (Localization.AtPrime M)]
    (hdim : ringKrullDim (Localization.AtPrime M) = 2) (hsing : ¬ IsRegularLocalRing
        (Localization.AtPrime M))
    (hII : ¬ IsCaseOne (Localization.AtPrime M)) :
    Function.Surjective ((Ideal.Quotient.mk M).comp (algebraMap A (affineBlowupAlgebra
        (maximalIdeal A) (w 0) S))) ∧
      Ideal.map ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (w 0) S) (Localization.AtPrime
          M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 0) S))) (maximalIdeal A)
          = Ideal.span {
              ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (w 0) S) (Localization.AtPrime
                M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 0) S))) (w 0)} ∧
      ∃ w' : Fin 3 → (Localization.AtPrime M), w' 0 = ((algebraMap (affineBlowupAlgebra
          (maximalIdeal A) (w 0) S) (Localization.AtPrime M)).comp (algebraMap A
          (affineBlowupAlgebra (maximalIdeal A) (w 0) S))) (w 0) ∧
        HasDoubleLineRelationUnit (Localization.AtPrime M) w' := by
  have hx : ∀ i, w i ∈ maximalIdeal A := fun i => h.1 ▸ Ideal.subset_span ⟨i, rfl⟩
  obtain ⟨f, hf⟩ := h.exists_sum
  obtain ⟨hsurj, c, μ, hu⟩ := hasDoubleLineRelation_of_sq_eq_mul_chart S hx h.1 M hle hdim
    hsing hII f hf
  exact ⟨hsurj, map_maximalIdeal_localization_eq_span_zero S hx M, _, rfl, hu⟩

/-- **Stacks 0BGE, case II invariant, second chart.** If `w₃² = w₁ Σ fₚᵩ wₚwᵩ`, then at a
maximal ideal `𝔪' ⊇ 𝔪A'` of the chart `w₂` where the local ring is in case II, either `w₁`
generates `𝔪B` (the point lies on the chart `w₁`), or the point is `P*`: it is `κ`-rational,
`f₂₂ ∈ 𝔪`, `w₂` generates `𝔪B`, and `B` satisfies the case II invariant with `w₂` in the middle
position. -/
theorem hasDoubleLineRelation_chart_one (w : Fin 3 → A)
    (hspan : Ideal.span (Set.range w) = maximalIdeal A) (f : Fin 3 → Fin 3 → A)
    (hrel : w 2 * w 2 = w 0 * ∑ p, ∑ q, f p q * (w p * w q))
    (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away (w 1) S]
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (w 1) S)) [M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 1) S)) (maximalIdeal A)
        ≤ M)
    (hII : ¬ IsCaseOne (Localization.AtPrime M)) :
    Ideal.map ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (w 1) S) (Localization.AtPrime
        M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 1) S))) (maximalIdeal A) =
        Ideal.span {
            ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (w 1) S) (Localization.AtPrime
              M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 1) S))) (w 0)} ∨
      (f 1 1 ∈ maximalIdeal A ∧
        Function.Surjective ((Ideal.Quotient.mk M).comp (algebraMap A (affineBlowupAlgebra
            (maximalIdeal A) (w 1) S))) ∧
        Ideal.map ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (w 1) S) (Localization.AtPrime
            M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 1) S))) (maximalIdeal
            A) = Ideal.span {
                ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (w 1) S) (Localization.AtPrime
                  M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 1) S))) (w 1)} ∧
        ∃ w' : Fin 3 → (Localization.AtPrime M), w' 1 = ((algebraMap (affineBlowupAlgebra
            (maximalIdeal A) (w 1) S) (Localization.AtPrime M)).comp (algebraMap A
            (affineBlowupAlgebra (maximalIdeal A) (w 1) S))) (w 1) ∧
          HasDoubleLineRelation (Localization.AtPrime M) w') := by
  set σ := Equiv.swap (0 : Fin 3) 1
  have hspanσ : Ideal.span (Set.range (w ∘ σ)) = maximalIdeal A := by
    rw [span_range_comp_swap_zero_one, hspan]
  have hxσ : ∀ i, (w ∘ σ) i ∈ maximalIdeal A := fun i => hspanσ ▸ Ideal.subset_span ⟨i, rfl⟩
  have hrelσ : (w ∘ σ) 2 * (w ∘ σ) 2 = (w ∘ σ) 1 * ∑ p, ∑ q, f (σ p) (σ q) *
      ((w ∘ σ) p * (w ∘ σ) q) := by
    rw [sum_quadratic_comp_perm]
    simpa [σ, Equiv.swap_apply_of_ne_of_ne] using hrel
  have key : ∀ (e : A) (he : e = (w ∘ σ) 0) [IsLocalization.Away e S]
      (M : Ideal (affineBlowupAlgebra (maximalIdeal A) e S)) [M.IsMaximal]
      (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) e S))
        (maximalIdeal A) ≤ M) (hII : ¬ IsCaseOne (Localization.AtPrime M)),
      Ideal.map ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (e) S) (Localization.AtPrime
          M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (e) S))) (maximalIdeal A) =
          Ideal.span {
              ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (e) S) (Localization.AtPrime
                M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (e) S))) (w 0)} ∨
        (f 1 1 ∈ maximalIdeal A ∧
          Function.Surjective ((Ideal.Quotient.mk M).comp (algebraMap A (affineBlowupAlgebra
              (maximalIdeal A) (e) S))) ∧
          Ideal.map ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (e) S) (Localization.AtPrime
              M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (e) S))) (maximalIdeal
              A) = Ideal.span {
                  ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (e) S) (Localization.AtPrime
                    M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (e) S))) (e)} ∧
          ∃ w' : Fin 3 → (Localization.AtPrime M), w' 1 = ((algebraMap (affineBlowupAlgebra
              (maximalIdeal A) (e) S) (Localization.AtPrime M)).comp (algebraMap A
              (affineBlowupAlgebra (maximalIdeal A) (e) S))) e ∧
            HasDoubleLineRelation (Localization.AtPrime M) w') := by
    intro e he _ M hM hle hII
    subst he
    by_cases hz : chartFraction S hxσ 1 ∈ M
    · obtain ⟨hf, hsurj, h⟩ := hasDoubleLineRelation_of_sq_eq_mul_secondChart S hxσ hspanσ _
        hrelσ M hle hII hz
      exact Or.inr ⟨by simpa [σ] using hf, hsurj,
        map_maximalIdeal_localization_eq_span_zero S hxσ M, _, rfl, h⟩
    · exact Or.inl (by simpa [σ] using map_maximalIdeal_localization_eq_span S hxσ M 1 hz)
  exact key (w 1) (by simp [σ]) M hle hII

/-- **Stacks 0BGE, nondegenerate case II invariant, second chart.** If `B` is in case II, a point
of the chart `w₂` lying over `𝔪` lies on the chart `w₁`: `w₁` generates `𝔪B`. (At `P*` the
quadratic form would be `t₃² - f̄₂₂t₁t₂` with `f̄₂₂ ≠ 0`, which is case I.) -/
theorem map_maximalIdeal_eq_span_of_hasDoubleLineRelationUnit_chart_one (w : Fin 3 → A)
    (h : HasDoubleLineRelationUnit A w)
    (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away (w 1) S]
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (w 1) S)) [M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 1) S)) (maximalIdeal A)
        ≤ M)
    (hII : ¬ IsCaseOne (Localization.AtPrime M)) :
    Ideal.map ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (w 1) S) (Localization.AtPrime
        M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 1) S))) (maximalIdeal A) =
        Ideal.span {
            ((algebraMap (affineBlowupAlgebra (maximalIdeal A) (w 1) S) (Localization.AtPrime
              M)).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (w 1) S))) (w 0)} := by
  obtain ⟨f, hfu, hf⟩ := h.exists_sum
  exact (hasDoubleLineRelation_chart_one w h.1 f hf S M hle hII).resolve_right
    fun h1 => notMem_maximalIdeal.mpr hfu h1.1

end AlgebraicGeometry

end
