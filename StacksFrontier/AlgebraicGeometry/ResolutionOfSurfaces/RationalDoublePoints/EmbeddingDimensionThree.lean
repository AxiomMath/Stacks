/-!
# A rational double point has embedding dimension three

Let `(A, 𝔪, κ)` be as in Situation [Stacks, Tag 0BGC]: a Nagata local normal domain of dimension
two which defines a rational singularity, whose completion is normal, which is Gorenstein and not
regular. Then

`dim_κ(𝔪ⁿ/𝔪ⁿ⁺¹) = 2n + 1` for all `n`, in particular `dim_κ(𝔪/𝔪²) = 3`.

## Main results

* `IsLocalRing.length_quotient_pow_succ_eq_add_finrank_gradedPiece`:
  `ℓ(A/𝔪ⁿ⁺¹) = ℓ(A/𝔪ⁿ) + dim_κ(𝔪ⁿ/𝔪ⁿ⁺¹)` for a Noetherian local ring.
* `AlgebraicGeometry.BlowUpDualizing.finrank_cotangentSpace_eq_three_of_isGorensteinLocalRing`:
  **`dim_κ(𝔪/𝔪²) = 3`** for a Gorenstein rational surface singularity which is not regular.
* `AlgebraicGeometry.RationalDoublePointSituation.finrank_cotangentSpace_eq_three`: the same in
  Situation [Stacks, Tag 0BGC].
* `AlgebraicGeometry.RationalDoublePointSituation.spanFinrank_maximalIdeal_eq_three` and
  `.exists_span_range_eq_maximalIdeal`: the maximal ideal is minimally generated by three
  elements.
* `AlgebraicGeometry.RationalDoublePointSituation.finrank_gradedPiece_eq_two_mul_add_one`:
  **`dim_κ(𝔪ⁿ/𝔪ⁿ⁺¹) = 2n + 1`**.

## Implementation notes

With `e = dim_κ(𝔪/𝔪²)`, the Hilbert function is `dim_κ(𝔪ⁿ/𝔪ⁿ⁺¹) = n(e − 1) + 1`
(`AlgebraicGeometry.BlowUpDualizing.finrank_gradedPiece_eq`, Riemann–Roch on the exceptional
curve of the blowup of `𝔪`). A two-dimensional Gorenstein local ring with this Hilbert function
has `e − 1 ≤ 2` (`Dualizing.IsGorensteinLocalRing.le_two_of_length_quotient_pow_succ`), and
non-regularity gives `e ≥ 3`. The Hilbert function is computed in the rational singularity
situation of [Stacks, Tag 0B4W] attached to the identity modification of `Spec(A)`.

## References

* [Stacks Project, Tag 0BGC](https://stacks.math.columbia.edu/tag/0BGC)
* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
-/

@[expose] public section

open CategoryTheory IsLocalRing

universe u

namespace IsLocalRing

variable {A : Type u} [CommRing A] [IsLocalRing A]

/-- **`ℓ(A/𝔪ⁿ⁺¹) = ℓ(A/𝔪ⁿ) + dim_κ(𝔪ⁿ/𝔪ⁿ⁺¹)`**, from the exact sequence
`0 → 𝔪ⁿ/𝔪ⁿ⁺¹ → A/𝔪ⁿ⁺¹ → A/𝔪ⁿ → 0`. -/
theorem length_quotient_pow_succ_eq_add_finrank_gradedPiece [IsNoetherianRing A] (n : ℕ) :
    Module.length A (A ⧸ maximalIdeal A ^ (n + 1)) =
      Module.length A (A ⧸ maximalIdeal A ^ n) +
        Module.finrank (ResidueField A) (gradedPiece A n) := by
  let f : gradedPiece A n →ₗ[A] A ⧸ maximalIdeal A ^ (n + 1) :=
    Submodule.mapQ _ _ (maximalIdeal A ^ n).subtype fun z hz =>
      (gradedPieceMk_eq_zero_iff z).mp ((Submodule.Quotient.mk_eq_zero _).mpr hz)
  let g : A ⧸ maximalIdeal A ^ (n + 1) →ₗ[A] A ⧸ maximalIdeal A ^ n :=
    Submodule.factor (Ideal.pow_le_pow_right (Nat.le_succ n))
  have hf : Function.Injective f := by
    rw [← LinearMap.ker_eq_bot, eq_bot_iff]
    intro x hx
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    exact (Submodule.mem_bot _).mpr
      ((gradedPieceMk_eq_zero_iff y).mpr ((Submodule.Quotient.mk_eq_zero _).mp hx))
  have hfg : Function.Exact f g := by
    intro z
    obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ z
    refine ⟨fun hz => ⟨Submodule.Quotient.mk ⟨z, (Submodule.Quotient.mk_eq_zero _).mp hz⟩, rfl⟩,
      ?_⟩
    rintro ⟨x, hx⟩
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    rw [← hx]
    exact (Submodule.Quotient.mk_eq_zero _).mpr y.2
  rw [Module.length_eq_add_of_exact f g hf (Submodule.factor_surjective _) hfg, add_comm,
    Module.length_eq_of_surjective (S := A) (R := ResidueField A) (M := gradedPiece A n)
      residue_surjective,
    Module.length_eq_finrank]

end IsLocalRing

namespace AlgebraicGeometry

namespace BlowUpDualizing

/-- **A Gorenstein rational surface singularity which is not regular has embedding dimension
three**: for `A` as in [Stacks, Tag 0B4W], Gorenstein and not regular, `dim_κ(𝔪/𝔪²) = 3`. -/
theorem finrank_cotangentSpace_eq_three_of_isGorensteinLocalRing
    (T : RationalSingularitySituation.{u}) (hG : Dualizing.IsGorensteinLocalRing T.A)
    (hreg : ¬ IsRegularLocalRing T.A) :
    Module.finrank (ResidueField T.A) (CotangentSpace T.A) = 3 := by
  have : IsProper (exceptionalDivisorToCentre (Stacks.Blowup.residuePoint T.A)) :=
    isProper_exceptionalDivisorToCentre_residuePoint T.A
  have hH : ∀ n : ℕ, (Module.finrank (ResidueField T.A) (gradedPiece T.A n) : ℤ) =
      (n : ℤ) * ((Module.finrank (ResidueField T.A) (CotangentSpace T.A) : ℤ) - 1) + 1 :=
    BlowUpDualizing.finrank_gradedPiece_eq T
  have hlow : 3 ≤ Module.finrank (ResidueField T.A) (CotangentSpace T.A) := by
    have h := BlowUpDualizing.two_mul_add_one_le_finrank_gradedPiece T hreg 1
    rwa [finrank_gradedPiece_one] at h
  set d := Module.finrank (ResidueField T.A) (CotangentSpace T.A) with hd
  have hle := hG.le_two_of_length_quotient_pow_succ T.dimension_two (d - 1) fun n => by
    rw [length_quotient_pow_succ_eq_add_finrank_gradedPiece]
    congr 1
    have h1 : ((d - 1 : ℕ) : ℤ) = (d : ℤ) - 1 := by lia
    have : (Module.finrank (ResidueField T.A) (gradedPiece T.A n) : ℤ) =
        ((n * (d - 1) + 1 : ℕ) : ℤ) := by
      rw [hH n]; push_cast [h1]; ring
    exact_mod_cast this
  lia

end BlowUpDualizing

namespace RationalDoublePointSituation

/-- The special fibre of the identity of `Spec(A)` has finitely many irreducible components. -/
private theorem finite_irreducibleComponents_fiber_id (S : RationalDoublePointSituation.{u}) :
    (irreducibleComponents (Scheme.Hom.fiber (𝟙 S.base) S.closedPoint)).Finite := by
  have : Finite (Scheme.Hom.fiber (𝟙 S.base) S.closedPoint) := by
    have hfin : Finite ↥((𝟙 S.base : S.base ⟶ S.base) ⁻¹' {S.closedPoint}) := by
      refine Set.Finite.to_subtype ((Set.finite_singleton S.closedPoint).subset ?_)
      intro x hx
      simpa using hx
    exact Finite.of_equiv _ (Scheme.Hom.fiberHomeo (𝟙 S.base) S.closedPoint).toEquiv.symm
  exact TopologicalSpace.NoetherianSpace.finite_irreducibleComponents

/-- The rational singularity situation of [Stacks, Tag 0B4W] attached to `A` and the identity
modification of `Spec(A)`. -/
private noncomputable def idSituation (S : RationalDoublePointSituation.{u}) :
    RationalSingularitySituation.{u} :=
  letI : IsNormal S.base := isNormal_spec_of_isNormalRing (IsNormalRing.of_isIntegrallyClosed S.A)
  letI := S.finite_irreducibleComponents_fiber_id.to_subtype
  S.toRationalSingularitySituation S.base (𝟙 _) (isModification_id _) _
    (Finite.equivFin _).symm

/-- **A rational double point has embedding dimension three**: in Situation [Stacks, Tag 0BGC],
`dim_κ(𝔪/𝔪²) = 3`. -/
theorem finrank_cotangentSpace_eq_three (S : RationalDoublePointSituation.{u}) :
    Module.finrank (ResidueField S.A) (CotangentSpace S.A) = 3 :=
  BlowUpDualizing.finrank_cotangentSpace_eq_three_of_isGorensteinLocalRing S.idSituation
    S.gorenstein S.not_isRegularLocalRing

/-- **The maximal ideal of a rational double point is minimally generated by three elements**:
in Situation [Stacks, Tag 0BGC] the embedding dimension is three. -/
theorem spanFinrank_maximalIdeal_eq_three (S : RationalDoublePointSituation.{u}) :
    (IsLocalRing.maximalIdeal S.A).spanFinrank = 3 := by
  rw [spanFinrank_maximalIdeal_eq_finrank_cotangentSpace_of_fg (IsNoetherian.noetherian _),
    S.finrank_cotangentSpace_eq_three]

/-- **Three generators of the maximal ideal of a rational double point**: in Situation
[Stacks, Tag 0BGC] the maximal ideal is generated by three elements. -/
theorem exists_span_range_eq_maximalIdeal (S : RationalDoublePointSituation.{u}) :
    ∃ x : Fin 3 → S.A, Ideal.span (Set.range x) = IsLocalRing.maximalIdeal S.A :=
  exists_span_eq_maximalIdeal_of_finrank_cotangentSpace (IsNoetherian.noetherian _)
    S.finrank_cotangentSpace_eq_three

/-- **The Hilbert function of a rational double point**: in Situation [Stacks, Tag 0BGC],
`dim_κ(𝔪ⁿ/𝔪ⁿ⁺¹) = 2n + 1` for all `n`. -/
theorem finrank_gradedPiece_eq_two_mul_add_one (S : RationalDoublePointSituation.{u}) (n : ℕ) :
    Module.finrank (ResidueField S.A) (gradedPiece S.A n) = 2 * n + 1 := by
  let T := S.idSituation
  have : IsProper (exceptionalDivisorToCentre (Stacks.Blowup.residuePoint T.A)) :=
    isProper_exceptionalDivisorToCentre_residuePoint T.A
  exact BlowUpDualizing.finrank_gradedPiece_eq_two_mul_add_one T n
    S.finrank_cotangentSpace_eq_three

end RationalDoublePointSituation

end AlgebraicGeometry
