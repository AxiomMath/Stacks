module

public import StacksFrontier.AlgebraicGeometry.Blowup.ReesAlgebra.ChartMembership
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierStalk.VanishingIdealStalk
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.BlowupStepSequence
public import StacksCore.Tactic.StacksAttribute

/-!
# The exceptional condition of a point blowup from membership of an affine chart

A rule for choosing the centres of a sequence of point blowups,
`AlgebraicGeometry.PointBlowupStep`, has to produce at every stage a point of the blowup at which
the extension of the maximal ideal of the centre is generated by the image of the chosen element
of that maximal ideal. This file derives that condition from [Stacks, Tag 0BFL]: the chosen point
lies in the standard affine chart of the blowup attached to a section of the blown-up ideal whose
germ at the centre is the chosen element.

The two steps are the identification of the exceptional ideal with the extended maximal ideal —
the exceptional ideal sheaf is the inverse image of the blown-up ideal, whose stalk at the centre
is the maximal ideal when the blown-up ideal is the vanishing ideal of that closed point — and
the transport of both the ideal and the generator along the equation saying that the chosen point
lies over the centre, which is forced on any statement about `Scheme.Hom.stalkMap`.

## Main results

* `AlgebraicGeometry.map_maximalIdeal_eq_span_germ_of_mem_blowupChart`: membership of the chart
  gives the exceptional condition, for any quasi-coherent ideal whose stalk at the point is the
  maximal ideal.
* `AlgebraicGeometry.PointBlowupStage.map_maximalIdeal_eq_span_of_mem_blowupChart`: the same
  statement in exactly the shape `AlgebraicGeometry.PointBlowupStep.next_exceptional` is stated
  with, so that supplying a rule is reduced to finding the next centre inside a chart.

## Implementation notes

The membership hypothesis is the left-hand side of Tag 0BFL verbatim, two graded-ring instances
on the section ring of the Rees algebra included; it is not restated in another form, so that the
only step between it and the conclusion is the registered equivalence itself.

No `@[stacks]` attribute is attached: Tag 0BFL is registered on the equivalence in
`Blowup/ReesAlgebra/ChartMembership.lean`, and what is here is its composition with the
identification of the exceptional ideal, which formalizes no tag of its own.

## References

* [Stacks Project, Tag 0BFL](https://stacks.math.columbia.edu/tag/0BFL)
* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing TopologicalSpace

universe u

namespace AlgebraicGeometry

/-- The stalk of an ideal sheaf at a point equal to another one, transported to that point. -/
private theorem stalk_cast {X : Scheme.{u}} (J : X.IdealSheafData) {z p : X} (h : z = p) :
    AlgebraicGeometry.IdealSheafData.stalk J z =
      h.symm ▸ AlgebraicGeometry.IdealSheafData.stalk J p := by
  subst h
  rfl

/-- The germ of a section at a point equal to another one, transported to that point. -/
private theorem germ_cast {X : Scheme.{u}} {U : X.Opens} {z p : X} (h : z = p)
    (hz : z ∈ U) (hp : p ∈ U) (b : Γ(X, U)) :
    X.presheaf.germ U z hz b = h.symm ▸ X.presheaf.germ U p hp b := by
  subst h
  rfl

/-- **The exceptional divisor is cut out at a point of a blowup chart by the generating section.**
Let `I` be a quasi-coherent ideal of `X` whose induced ideal in the local ring at a point `p` is
the maximal ideal there, let `a` be a section of `I` on an affine open containing `p`, and let `q`
be a point of the blowup of `X` in `I` lying over `p` and belonging to the standard affine chart
attached to `a`. Then the extension of the maximal ideal at `p` to the local ring at `q` is
generated by the image of the germ of `a` at `p`.

The membership hypothesis is the left-hand side of [Stacks, Tag 0BFL], whose right-hand side is
the corresponding statement about the exceptional ideal sheaf. -/
public theorem map_maximalIdeal_eq_span_germ_of_mem_blowupChart {X : Scheme.{u}}
    (I : X.IdealSheafData) {p : X}
    (hI : AlgebraicGeometry.IdealSheafData.stalk I p =
      IsLocalRing.maximalIdeal (X.presheaf.stalk p))
    (U : X.affineOpens) (hpU : p ∈ U.1) (a : I.ideal U) {q : blowUp I}
    (hq : blowUpToBase I q = p)
    (hmem :
      letI := (reesSituation I).sectionRingGradedRing U.1
      letI := (reesSituation I).sectionRingGradingGradedRing U.1
      q ∈ Set.range
        ((Proj.basicOpen ((reesSituation I).sectionRingGrading U.1)
          (reesDegreeOne I U a).1).ι ≫
          Stacks.RelativeProj.Situation.relativeProjChart (reesSituation I) U)) :
    Ideal.map ((blowUpToBase I).stalkMap q).hom
        (hq.symm ▸ IsLocalRing.maximalIdeal (X.presheaf.stalk p)) =
      Ideal.span {((blowUpToBase I).stalkMap q).hom
                    (hq.symm ▸ X.presheaf.germ U.1 p hpU (a : Γ(X, U.1)))} := by
  have hqU : blowUpToBase I q ∈ U.1 := by rw [hq]; exact hpU
  have h0 := (mem_affineBlowupStandardOpen_iff_exceptionalIdeal_stalk_eq_span I U a q hqU).mp hmem
  rw [AlgebraicGeometry.IdealSheafData.stalk_comap, stalk_cast I hq, hI,
    germ_cast hq hqU hpU (a : Γ(X, U.1))] at h0
  exact h0

namespace PointBlowupStage

variable {P : (Y : Scheme.{u}) → (q : Y) → Y.presheaf.stalk q → Prop}

/-- **The condition `AlgebraicGeometry.PointBlowupStep.next_exceptional` asks for, from
membership of a blowup chart.** If the element chosen at a stage is the germ of a section `a` of
the vanishing ideal of the centre, and the next centre lies in the standard affine chart of the
blowup attached to `a`, then the extension of the maximal ideal of the stage to the local ring at
the next centre is generated by the image of the chosen element.

This is what reduces the construction of a rule for choosing the centres to finding the next
centre inside a chart; for a rational double point that chart is the one cut out by a good
coordinate of the maximal ideal. -/
public theorem map_maximalIdeal_eq_span_of_mem_blowupChart (d : PointBlowupStage P)
    (U : d.scheme.affineOpens) (hpU : d.point ∈ U.1) (a : d.centre.ideal U)
    (hgerm : d.scheme.presheaf.germ U.1 d.point hpU (a : Γ(d.scheme, U.1)) = d.elem)
    {q : blowUp d.centre} (hq : blowUpToBase d.centre q = d.point)
    (hmem :
      letI := (reesSituation d.centre).sectionRingGradedRing U.1
      letI := (reesSituation d.centre).sectionRingGradingGradedRing U.1
      q ∈ Set.range
        ((Proj.basicOpen ((reesSituation d.centre).sectionRingGrading U.1)
          (reesDegreeOne d.centre U a).1).ι ≫
          Stacks.RelativeProj.Situation.relativeProjChart (reesSituation d.centre) U)) :
    Ideal.map ((blowUpToBase d.centre).stalkMap q).hom
        (hq.symm ▸ IsLocalRing.maximalIdeal (d.scheme.presheaf.stalk d.point)) =
      Ideal.span {((blowUpToBase d.centre).stalkMap q).hom (hq.symm ▸ d.elem)} := by
  rw [← hgerm]
  exact map_maximalIdeal_eq_span_germ_of_mem_blowupChart d.centre
    (Stacks.Divisors.stalk_vanishingIdeal_singleton_of_isClosed d.point d.point_closed)
    U hpU a hq hmem

end PointBlowupStage

end AlgebraicGeometry

end
