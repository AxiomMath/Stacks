module

public import StacksFrontier.AlgebraicGeometry.RelativeProjChain.PolynomialSurjection
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.QuadricHilbert
import StacksCore.Tactic.EgaSgaAttribute

/-!
# A graded ring with the Hilbert function of a plane conic is `κ[t₁, t₂, t₃]/(q)`

Section 54.12 of the source identifies the exceptional curve `E` of the blowup of a rational
double point with the zero scheme of a quadratic form in `ℙ²_κ`. The graded ring behind that is
`⨁ₙ 𝔪ⁿ/𝔪ⁿ⁺¹`, generated in degree one by three elements because the embedding dimension is
three, with `dim_κ` of the degree-`n` part equal to `2n + 1`.

This file proves the identification at the level of graded rings, for an arbitrary graded
`κ`-algebra with those two properties: **if `𝒮` is a graded `κ`-algebra generated in degree one
by `x₁, x₂, x₃` with `dim_κ(𝒮ₙ) = 2n + 1` for every `n`, then the kernel of the evaluation
`κ[t₁, t₂, t₃] → 𝒮`, `tᵢ ↦ xᵢ`, is generated by a single nonzero quadratic form `q`.** In other
words `𝒮 ≅ κ[t₁, t₂, t₃]/(q)` as graded `κ`-algebras, which is `Proj 𝒮 = V(q) ⊂ ℙ²_κ` at the
level of homogeneous coordinate rings.

## Main results

* `AlgebraicGeometry.isHomogeneous_ker_aeval`: the kernel of the evaluation map at degree-one
  elements of a graded algebra is a homogeneous ideal.
* `AlgebraicGeometry.hilbertFunction_ker_aeval`: the Hilbert function of that kernel computes the
  dimensions of the graded pieces of `𝒮`, when the evaluation is surjective in each degree.
* `AlgebraicGeometry.adjoin_eq_top_of_surjective_gradedPieces`: degreewise surjectivity of the
  evaluation map makes the `xᵢ` generate `𝒮` as a `κ`-algebra, which is the hypothesis the
  projective embedding of [Stacks, Tag 01N0] asks for.
* `AlgebraicGeometry.exists_isHomogeneous_two_ker_aeval_eq_span_singleton`: **the kernel is
  `(q)` for a nonzero quadratic form `q`**, for a graded `κ`-algebra generated in degree one by
  three elements with `dim_κ(𝒮ₙ) = 2n + 1`.
* `AlgebraicGeometry.isClosedImmersion_projToProjectiveSpace_of_surjective_gradedPieces`:
  **`Proj 𝒮 ⟶ ℙ²_κ = Proj κ[t₁, t₂, t₃]` is a closed immersion**, the scheme-theoretic half of
  `E ⊂ ℙ²_κ` for such a graded ring.

## Implementation notes

The grading is taken to be `Submodule κ`-valued, which is what makes each graded piece a
`κ`-vector space without further plumbing and is the shape `MvPolynomial.homogeneousSubmodule`
already has. The evaluation map is `MvPolynomial.aeval x`; that it carries the degree-`d` part
into `𝒮 d` and that it is surjective in each degree when the `xᵢ` generate are
`Stacks.AlgebraicGeometry.RelativeProjChain.aeval_mem_of_mem_homogeneousSubmodule` and
`…surjective_gradedAddHom_polyGradedHom`, and the closed immersion into `Proj κ[t₁, t₂, t₃]` is
`…isClosedImmersion_projToProjectiveSpace`, all of [Stacks, Tag 01N0].

The results below are about graded rings; they do not identify the exceptional curve `E` of the
blowup with `Proj(⨁ₙ 𝔪ⁿ/𝔪ⁿ⁺¹)`, which is clause (6) of [Stacks, Tag 0FBG],
`X' ∩ E = Proj_Z(𝒞_{Z/X,*})`. Over an affine base,
`Stacks.Blowup.isPullback_projectivizedNormalConeToBlowUpSpec` identifies `Proj(Gr_I R)` with the
exceptional divisor of `blowUpSpec I` for an arbitrary ideal `I` of an arbitrary ring, and
`Stacks.Blowup.blowUpSpecIsoRees` matches `blowUpSpec` with `AlgebraicGeometry.blowUp`. That
square is stated for `AssociatedGraded.piece`, the dimension counts of `RationalDoublePoints/` for
`IsLocalRing.gradedPiece`; the two presentations of `𝔪ⁿ/𝔪ⁿ⁺¹` are related by
`IsLocalRing.gradedPieceEquivPiece`.

## References

* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
* [Stacks Project, Tag 01N0](https://stacks.math.columbia.edu/tag/01N0)
-/

@[expose] public noncomputable section

open Stacks.HilbertFunction.PolynomialQuotient

universe u

namespace AlgebraicGeometry

variable {k S : Type u} [Field k] [CommRing S] [Algebra k S]
  (𝒮 : ℕ → Submodule k S) [GradedAlgebra 𝒮]

/-- The structure map of a graded algebra lands in degree zero. -/
public theorem algebraMap_mem_gradeZero (r : k) : algebraMap k S r ∈ 𝒮 0 :=
  SetLike.algebraMap_mem_graded 𝒮 r

section General

variable {n : ℕ} (x : Fin (n + 1) → S) (hx : ∀ i, x i ∈ 𝒮 1)

include hx

/-- Evaluating a homogeneous polynomial of degree `d` at degree-one elements lands in `𝒮 d`. -/
public theorem aeval_mem_of_mem_homogeneousSubmodule {d : ℕ} {p : MvPolynomial (Fin (n + 1)) k}
    (hp : p ∈ MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k d) :
    MvPolynomial.aeval x p ∈ 𝒮 d :=
  Stacks.AlgebraicGeometry.RelativeProjChain.aeval_mem_of_mem_homogeneousSubmodule 𝒮
    (algebraMap_mem_gradeZero 𝒮) x hx hp

/-- The degree-`d` part of the evaluation map, as a `κ`-linear map from the homogeneous
polynomials of degree `d` to the degree-`d` part of the graded algebra. -/
public def gradedPieceAeval (d : ℕ) : gradedPieceS k (n + 1) d →ₗ[k] 𝒮 d where
  toFun p := ⟨MvPolynomial.aeval x (p : MvPolynomial (Fin (n + 1)) k),
    aeval_mem_of_mem_homogeneousSubmodule 𝒮 x hx p.2⟩
  map_add' a b := Subtype.ext (by simp)
  map_smul' c a := Subtype.ext (by simp)

/-- **The kernel of the evaluation map is a homogeneous ideal.** Each homogeneous component of a
relation is itself a relation, because the images of the components are homogeneous of distinct
degrees and so are the components of the image. -/
public theorem isHomogeneous_ker_aeval :
    Ideal.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k)
      (RingHom.ker (MvPolynomial.aeval (R := k) x).toRingHom) := by
  classical
  have hcomp : ∀ (i : ℕ) (p : MvPolynomial (Fin (n + 1)) k),
      (DirectSum.decompose (MvPolynomial.homogeneousSubmodule (Fin (n + 1)) k) p i :
        MvPolynomial (Fin (n + 1)) k) = MvPolynomial.homogeneousComponent i p :=
    fun i p => MvPolynomial.decomposition.decompose'_apply p i
  intro i p hp
  have hp0 : MvPolynomial.aeval x p = 0 := hp
  have hymem : ∀ e : ℕ, MvPolynomial.aeval x (MvPolynomial.homogeneousComponent e p) ∈ 𝒮 e :=
    fun e => aeval_mem_of_mem_homogeneousSubmodule 𝒮 x hx
      ((MvPolynomial.mem_homogeneousSubmodule _ _).mpr
        (MvPolynomial.homogeneousComponent_isHomogeneous e p))
  have hsum : (0 : S) = ∑ e ∈ Finset.range (p.totalDegree + 1),
      MvPolynomial.aeval x (MvPolynomial.homogeneousComponent e p) := by
    rw [← map_sum, MvPolynomial.sum_homogeneousComponent, hp0]
  have hprojy : ∀ e : ℕ, GradedRing.proj 𝒮 i
      (MvPolynomial.aeval x (MvPolynomial.homogeneousComponent e p)) =
        if e = i then MvPolynomial.aeval x (MvPolynomial.homogeneousComponent e p) else 0 := by
    intro e
    by_cases he : e = i
    · subst he
      rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_same 𝒮 (hymem e)]
      simp
    · rw [GradedRing.proj_apply, DirectSum.decompose_of_mem_ne 𝒮 (hymem e) he]
      simp [he]
  have hzero : MvPolynomial.aeval x (MvPolynomial.homogeneousComponent i p) = 0 := by
    have h := congrArg (GradedRing.proj 𝒮 i) hsum
    rw [map_zero, map_sum] at h
    simp only [hprojy] at h
    rw [Finset.sum_ite_eq' (Finset.range (p.totalDegree + 1)) i] at h
    split_ifs at h with hi
    · exact h.symm
    · exact (MvPolynomial.homogeneousComponent_eq_zero i p (by
        simp only [Finset.mem_range] at hi
        omega)) ▸ map_zero (MvPolynomial.aeval (R := k) x)
  rw [hcomp i p]
  exact hzero

/-- **The Hilbert function of the kernel of the evaluation map is the dimension sequence of the
graded algebra.** Rank–nullity for the degree-`d` part of the evaluation map, which is surjective
onto `𝒮 d` by hypothesis and whose kernel is the degree-`d` part of the kernel ideal. -/
public theorem hilbertFunction_ker_aeval
    (hsurj : ∀ d, Function.Surjective (gradedPieceAeval 𝒮 x hx d)) (d : ℕ) :
    hilbertFunction (RingHom.ker (MvPolynomial.aeval (R := k) x).toRingHom) d =
      Module.finrank k (𝒮 d) := by
  have := finiteDimensional_gradedPieceS k (n + 1) d
  have hker : LinearMap.ker (gradedPieceAeval 𝒮 x hx d) =
      Submodule.comap (gradedPieceS k (n + 1) d).subtype
        (gradedPieceI (RingHom.ker (MvPolynomial.aeval (R := k) x).toRingHom) d) := by
    refine le_antisymm (fun p hp => ?_) (fun p hp => ?_)
    · have h0 : MvPolynomial.aeval x (p : MvPolynomial (Fin (n + 1)) k) = 0 :=
        congrArg Subtype.val hp
      exact Submodule.mem_inf.mpr ⟨h0, p.2⟩
    · have h0 : MvPolynomial.aeval x (p : MvPolynomial (Fin (n + 1)) k) = 0 :=
        (Submodule.mem_inf.mp hp).1
      exact Subtype.ext h0
  have hrn := LinearMap.finrank_range_add_finrank_ker (gradedPieceAeval 𝒮 x hx d)
  rw [LinearMap.range_eq_top.mpr (hsurj d), finrank_top, hker,
    (Submodule.comapSubtypeEquivOfLe
      (show gradedPieceI (RingHom.ker (MvPolynomial.aeval (R := k) x).toRingHom) d
        ≤ gradedPieceS k (n + 1) d from inf_le_right)).finrank_eq] at hrn
  unfold hilbertFunction
  omega

/-- **Degreewise surjectivity of the evaluation map makes the `xᵢ` generate.** Every element of
`𝒮` is the sum of its homogeneous components, and each of those is a value of the evaluation
map. -/
public theorem adjoin_eq_top_of_surjective_gradedPieces
    (hsurj : ∀ d, Function.Surjective (gradedPieceAeval 𝒮 x hx d)) :
    Algebra.adjoin k (Set.range x) = ⊤ := by
  classical
  have hrange : (MvPolynomial.aeval (R := k) x).range = ⊤ := by
    refine eq_top_iff.mpr fun s _ => ?_
    have hdecomp := DirectSum.sum_support_decompose 𝒮 s
    rw [← hdecomp]
    refine Subalgebra.sum_mem _ fun e _ => ?_
    obtain ⟨p, hp⟩ := hsurj e ⟨(DirectSum.decompose 𝒮 s e : S), (DirectSum.decompose 𝒮 s e).2⟩
    exact ⟨(p : MvPolynomial (Fin (n + 1)) k), congrArg Subtype.val hp⟩
  rwa [← Algebra.adjoin_range_eq_range_aeval] at hrange

/-- **`Proj 𝒮 ⟶ ℙⁿ_κ = Proj κ[t₀, …, tₙ]` is a closed immersion** for a graded `κ`-algebra whose
evaluation map at `n + 1` degree-one elements is surjective in every degree. This is part (2) of
[Stacks, Tag 01N0] with its generation hypothesis discharged from degreewise surjectivity. -/
@[ega "II 2.9.5" "special case", ega "II 3.6.2" "(i), special case"]
public theorem isClosedImmersion_projToProjectiveSpace_of_surjective_gradedPieces
    (hsurj : ∀ d, Function.Surjective (gradedPieceAeval 𝒮 x hx d)) :
    IsClosedImmersion (Stacks.AlgebraicGeometry.RelativeProjChain.projToProjectiveSpace 𝒮
      (algebraMap_mem_gradeZero 𝒮) x hx
      (adjoin_eq_top_of_surjective_gradedPieces 𝒮 x hx hsurj)) :=
  Stacks.AlgebraicGeometry.RelativeProjChain.isClosedImmersion_projToProjectiveSpace 𝒮
    (algebraMap_mem_gradeZero 𝒮) x hx _

end General

section Conic

variable (y : Fin 3 → S) (hy : ∀ i, y i ∈ 𝒮 1)

include hy

/-- **A graded `κ`-algebra generated in degree one by three elements, whose graded pieces have
dimensions `dim_κ(𝒮ₙ) = 2n + 1`, is `κ[t₁, t₂, t₃]/(q)` for a nonzero quadratic form `q`.**

Precisely: the kernel of the evaluation `κ[t₁, t₂, t₃] → 𝒮`, `tᵢ ↦ yᵢ`, is the principal ideal
generated by a nonzero quadratic form. Together with
`AlgebraicGeometry.isClosedImmersion_projToProjectiveSpace_of_surjective_gradedPieces` this is
the statement `Proj 𝒮 = V(q) ⊂ ℙ²_κ` at the level of homogeneous coordinate rings.

In Section 54.12 of the source `𝒮` is the associated graded ring `⨁ₙ 𝔪ⁿ/𝔪ⁿ⁺¹` of a rational
double point, whose dimensions are `2n + 1` by
`AlgebraicGeometry.BlowUpDualizing.finrank_gradedPiece_eq_two_mul_add_one` and which is generated
in degree one by three generators of `𝔪`; the quadratic form is the one relation among the six
products `yₚyᵩ`. -/
public theorem exists_isHomogeneous_two_ker_aeval_eq_span_singleton
    (hsurj : ∀ d, Function.Surjective (gradedPieceAeval 𝒮 (n := 2) y hy d))
    (hdim : ∀ d, Module.finrank k (𝒮 d) = 2 * d + 1) :
    ∃ q : MvPolynomial (Fin 3) k, q.IsHomogeneous 2 ∧ q ≠ 0 ∧
      RingHom.ker (MvPolynomial.aeval (R := k) y).toRingHom = Ideal.span {q} :=
  exists_isHomogeneous_eq_span_singleton_of_hilbertFunction
    (isHomogeneous_ker_aeval 𝒮 y hy)
    fun d => by rw [hilbertFunction_ker_aeval 𝒮 y hy hsurj d, hdim d]

end Conic

end AlgebraicGeometry

end
