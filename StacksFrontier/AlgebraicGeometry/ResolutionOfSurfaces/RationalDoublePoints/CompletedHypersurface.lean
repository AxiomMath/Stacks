-/

@[expose] public noncomputable section

open IsLocalRing

universe u v

namespace AlgebraicGeometry

variable {R : Type u} [CommRing R] [IsLocalRing R] [IsNoetherianRing R] [IsDomain R]
  [IsAdicComplete (maximalIdeal R) R] {d : ℕ} (K : Type v) [Field K] (f : K →+* R)
  (x : Fin (d + 1) → R)

/-- The power series ring in `n` variables over a field is a regular local ring. -/
private instance isRegularLocalRing_mvPowerSeries {n : ℕ} :
    IsRegularLocalRing (MvPowerSeries (Fin n) K) :=
  MvPowerSeries.isRegularLocalRing K n

private instance isDomain_mvPowerSeries {n : ℕ} : IsDomain (MvPowerSeries (Fin n) K) :=
  IsRegularLocalRing.isDomain _

omit [IsLocalRing R] [IsNoetherianRing R] [IsAdicComplete (maximalIdeal R) R] in
/-- The kernel of a surjection from a power series ring in `d + 1` variables over a field onto a
local domain of Krull dimension `d` is a prime ideal of height one: it is prime because the
quotient is a domain, and the dimension formula in the Cohen–Macaulay ring
`κ[[x₁, …, x_{d+1}]]` reads `d + 1 = ht(J) + d`. -/
public theorem height_ker_eq_one_of_surjective_mvPowerSeries
    (hdim : ringKrullDim R = (d : WithBot ℕ∞))
    (F : MvPowerSeries (Fin (d + 1)) K →+* R) (hF : Function.Surjective F) :
    letI : IsRegularLocalRing (MvPowerSeries (Fin (d + 1)) K) :=
      MvPowerSeries.isRegularLocalRing K (d + 1)
    (RingHom.ker F).height = 1 := by
  let : (RingHom.ker F).IsPrime := RingHom.ker_isPrime F
  have hCM : Module.IsMaximalCohenMacaulay (MvPowerSeries (Fin (d + 1)) K)
      (MvPowerSeries (Fin (d + 1)) K) :=
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      (MvPowerSeries (Fin (d + 1)) K)).2
  have key := hCM.ringKrullDim_eq_height_add_ringKrullDim_quotient (RingHom.ker F)
  rw [MvPowerSeries.ringKrullDim_eq K (d + 1),
    ringKrullDim_eq_of_ringEquiv (RingHom.quotientKerEquivOfSurjective hF), hdim] at key
  obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp (Ideal.height_ne_top_of_isPrime
    (I := RingHom.ker F))
  rw [← hm] at key
  have hnat : d + 1 = m + d := by exact_mod_cast key
  rw [← hm, show m = 1 from by omega]
  rfl

omit [IsNoetherianRing R] in
/-- **The hypersurface presentation.** Let `(R, 𝔪)` be a complete local Noetherian domain of Krull
dimension `d` whose maximal ideal is generated by `d + 1` elements, and let `κ → R` be a
homomorphism from a field which is surjective onto the residue field. Then `R` is a quotient of the
power series ring `κ[[x₁, …, x_{d+1}]]` by a principal ideal, the variables going to the chosen
generators.

For `d = 2` and three generators this is the shape `κ[[x, y, z]]/(g)` of a rational double point.
See the module docstring for why there is no `@[stacks]` attribute. -/
@[sga "7 XVI 2.5" "more general"]
public theorem exists_eq_span_singleton_ker_surjective_mvPowerSeries
    (hf : Function.Surjective ((Ideal.Quotient.mk (maximalIdeal R)).comp f))
    (hx : Ideal.span (Set.range x) = maximalIdeal R)
    (hdim : ringKrullDim R = (d : WithBot ℕ∞)) :
    ∃ (F : MvPowerSeries (Fin (d + 1)) K →+* R) (g : MvPowerSeries (Fin (d + 1)) K),
      Function.Surjective F ∧ (∀ i, F (MvPowerSeries.X i) = x i) ∧
        (∀ c : K, F (MvPowerSeries.C c) = f c) ∧ RingHom.ker F = Ideal.span {g} := by
  let : UniqueFactorizationMonoid (MvPowerSeries (Fin (d + 1)) K) :=
    IsRegularLocalRing.uniqueFactorizationMonoid (MvPowerSeries (Fin (d + 1)) K)
  obtain ⟨F, hFsurj, hFX, hFC⟩ :=
    Stacks.CompleteLocalRing.CohenStructure.exists_surjective_eval₂Hom
      (maximalIdeal R) x hx f hf
  let : (RingHom.ker F).IsPrime := RingHom.ker_isPrime F
  obtain ⟨g, hg⟩ := UniqueFactorizationMonoid.isPrincipal_of_height_eq_one
    (p := RingHom.ker F) (height_ker_eq_one_of_surjective_mvPowerSeries K hdim F hFsurj)
  exact ⟨F, g, hFsurj, hFX, hFC, hg⟩

omit [IsNoetherianRing R] in
/-- **The hypersurface presentation as an isomorphism.** Under the hypotheses of
`AlgebraicGeometry.exists_eq_span_singleton_ker_surjective_mvPowerSeries`, the ring `R` is
isomorphic to `κ[[x₁, …, x_{d+1}]]/(g)`. -/
public theorem nonempty_ringEquiv_mvPowerSeries_quotient_span_singleton
    (hf : Function.Surjective ((Ideal.Quotient.mk (maximalIdeal R)).comp f))
    (hx : Ideal.span (Set.range x) = maximalIdeal R)
    (hdim : ringKrullDim R = (d : WithBot ℕ∞)) :
    ∃ g : MvPowerSeries (Fin (d + 1)) K,
      Nonempty ((MvPowerSeries (Fin (d + 1)) K ⧸ Ideal.span {g}) ≃+* R) := by
  obtain ⟨F, g, hFsurj, -, -, hker⟩ :=
    exists_eq_span_singleton_ker_surjective_mvPowerSeries K f x hf hx hdim
  exact ⟨g, ⟨(Ideal.quotEquivOfEq hker.symm).trans
    (RingHom.quotientKerEquivOfSurjective hFsurj)⟩⟩

omit [IsLocalRing R] [IsNoetherianRing R] [IsAdicComplete (maximalIdeal R) R] in
/-- The generator of the kernel is a nonzero element of the maximal ideal of the power series
ring: the kernel is a nonzero proper ideal because the quotient has strictly smaller dimension. -/
public theorem ne_zero_and_mem_maximalIdeal_of_ker_eq_span_singleton
    (hdim : ringKrullDim R = (d : WithBot ℕ∞))
    (F : MvPowerSeries (Fin (d + 1)) K →+* R) (hF : Function.Surjective F)
    {g : MvPowerSeries (Fin (d + 1)) K} (hker : RingHom.ker F = Ideal.span {g}) :
    letI : IsRegularLocalRing (MvPowerSeries (Fin (d + 1)) K) :=
      MvPowerSeries.isRegularLocalRing K (d + 1)
    g ≠ 0 ∧ g ∈ maximalIdeal (MvPowerSeries (Fin (d + 1)) K) := by
  let : (RingHom.ker F).IsPrime := RingHom.ker_isPrime F
  have hheight := height_ker_eq_one_of_surjective_mvPowerSeries K hdim F hF
  refine ⟨?_, ?_⟩
  · intro hzero
    refine Ideal.ne_bot_of_height_eq_one hheight ?_
    rw [hker, hzero, Ideal.span_singleton_eq_bot.mpr rfl]
  · refine IsLocalRing.le_maximalIdeal_of_isPrime (RingHom.ker F) ?_
    rw [hker]
    exact Ideal.mem_span_singleton_self g

/-- **A complete local domain whose maximal ideal needs one generator more than its dimension is
Gorenstein**, when it contains a field mapping onto its residue field. It is
`κ[[x₁, …, x_{d+1}]]/(g)` for a nonzero `g` in the maximal ideal, the power series ring is regular
hence Gorenstein, and quotienting a Noetherian local ring by a nonzerodivisor in its maximal ideal
preserves the Gorenstein property.

This is the shorter route to the Gorenstein property of a rational double point and of the
singularities of its blowups: no dualizing sheaf is constructed, only the shape of the completed
local ring. The embedding dimension is a hypothesis; see the module docstring. -/
public theorem isGorensteinLocalRing_of_span_eq_maximalIdeal_of_ringKrullDim
    (hf : Function.Surjective ((Ideal.Quotient.mk (maximalIdeal R)).comp f))
    (hx : Ideal.span (Set.range x) = maximalIdeal R)
    (hdim : ringKrullDim R = (d : WithBot ℕ∞)) :
    Dualizing.IsGorensteinLocalRing R := by
  obtain ⟨F, g, hFsurj, -, -, hker⟩ :=
    exists_eq_span_singleton_ker_surjective_mvPowerSeries K f x hf hx hdim
  obtain ⟨hg0, hgmem⟩ :=
    ne_zero_and_mem_maximalIdeal_of_ker_eq_span_singleton K hdim F hFsurj hker
  have hgreg : g ∈ nonZeroDivisors (MvPowerSeries (Fin (d + 1)) K) :=
    mem_nonZeroDivisors_of_ne_zero hg0
  let : Nontrivial (MvPowerSeries (Fin (d + 1)) K ⧸ Ideal.span {g}) :=
    Ideal.Quotient.nontrivial_iff.mpr
      (lt_of_le_of_lt (Ideal.span_le.2 (Set.singleton_subset_iff.mpr hgmem))
        (inferInstance :
          (maximalIdeal (MvPowerSeries (Fin (d + 1)) K)).IsMaximal).lt_top).ne
  let : IsLocalRing (MvPowerSeries (Fin (d + 1)) K ⧸ Ideal.span {g}) :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk (Ideal.span {g}))
      Ideal.Quotient.mk_surjective
  have hquot : Dualizing.IsGorensteinLocalRing
      (MvPowerSeries (Fin (d + 1)) K ⧸ Ideal.span {g}) :=
    (Dualizing.isGorensteinLocalRing_quotient_span_singleton_iff
      (MvPowerSeries (Fin (d + 1)) K) g hgmem hgreg).mp
      (Dualizing.IsRegularLocalRing.isGorensteinLocalRing (MvPowerSeries (Fin (d + 1)) K))
  exact Dualizing.isGorensteinLocalRing_of_ringEquiv
    ((RingHom.quotientKerEquivOfSurjective hFsurj).symm.trans
      (Ideal.quotEquivOfEq hker)) hquot

end AlgebraicGeometry

end
