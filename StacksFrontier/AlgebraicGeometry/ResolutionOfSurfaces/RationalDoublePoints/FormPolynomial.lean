module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.GoodCoordinate
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.GradedRelations

/-!
# The quadratic form of a rational double point as a polynomial

Section 54.12 of the source carries the quadratic form `q = Σ āₚᵩ tₚtᵩ` of a rational double
point both as a polynomial in `κ[t₁, t₂, t₃]` — the form cutting out the exceptional curve — and
as its coefficient matrix, which is where the case I / case II dichotomy and the good coordinate
condition of `RationalDoublePoints/GoodCoordinate.lean` live. This file matches the two.

The two facts the matrix side has to supply about the polynomial are that it is nonzero, and that
the first variable does not divide it. Both are read off from two coefficients: for `p ≠ r` the
coefficient of `tₚtᵩ` is `aₚᵩ + aᵩₚ`, and the coefficient of `tₚ²` is `aₚₚ`. Upper triangularity
turns the first into `aₚᵩ`, so a nonzero entry on or above the diagonal makes the form nonzero;
and if `t₁` divides the form then every coefficient of a monomial not involving `t₁` vanishes,
which is exactly the condition that `q(0, t₂, t₃)` is the zero form — a scalar times the square of
a linear form, so not a good coordinate.

## Main definitions

* `AlgebraicGeometry.quadraticFormPoly`: the polynomial `Σₚᵩ aₚᵩ tₚtᵩ` of a coefficient matrix.
* `AlgebraicGeometry.dehomogenizeFirst`: dehomogenization at the first variable, `t₁ ↦ 1`.

## Main results

* `AlgebraicGeometry.coeff_quadraticFormPoly_of_ne` and
  `AlgebraicGeometry.coeff_quadraticFormPoly_self`: the coefficients of the form.
* `AlgebraicGeometry.quadraticFormPoly_ne_zero`: an upper triangular matrix with a nonzero entry
  on or above the diagonal presents a nonzero form.
* `AlgebraicGeometry.not_X_zero_dvd_quadraticFormPoly`: **a good coordinate's variable does not
  divide the form.** This is the input `AlgebraicGeometry.mem_pow_succ_of_mul_mem_pow` needs.
* `AlgebraicGeometry.evalGradedPieceFun_quadraticFormPoly_eq_zero`: the quadratic relation of the
  source makes the form a relation in the sense of
  `RationalDoublePoints/GradedRelations.lean`.
* `AlgebraicGeometry.gradedRelationIdeal_eq_span_quadraticFormPoly`: **the relation ideal of a
  rational double point is generated by its quadratic form**, stated with the form's coefficient
  matrix as the source produces it.
* `AlgebraicGeometry.mem_pow_succ_of_mul_mem_pow_of_isGoodCoordinateForm`: **a good coordinate of
  a rational double point is a superficial element of the maximal ideal.**
* `AlgebraicGeometry.dehomogenizeFirst_quadraticFormPoly_fin_three`: the dehomogenization
  `q(1, y₂, y₃) = ā₁₁ + ā₁₂y₂ + ā₁₃y₃ + ā₂₂y₂² + ā₂₃y₂y₃ + ā₃₃y₃²`, the polynomial the Claim of
  Section 54.12 is stated with.
* `AlgebraicGeometry.map_dehomogenizeFirst_gradedRelationIdeal_eq_span`: **the dehomogenized
  identification**, the image of the relation ideal in `κ[y₂, y₃]` is `(q(1, y₂, y₃))`. This is
  the right hand side of the source's `A[𝔪/x₁]/x₁ ≅ κ[y₂, y₃]/(q(1, y₂, y₃))`.

## Implementation notes

The coefficient computation is over an arbitrary commutative ring, and the two coefficients are
computed from the characterization of when `tₚtᵩ` and `tₚ'tᵩ'` are the same monomial, which is
`AlgebraicGeometry.single_one_add_single_one_inj`. Nothing is divided by two, so everything is
valid in characteristic two, as the source's argument has to be.

No `@[stacks]` attribute is attached: the statements are steps in the unnumbered discussion of
Section 54.12, whose three numbered items (Tags 0BGC, 0BGD, 0BGE) are registered elsewhere.

## References

* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
* [Stacks Project, Tag 0BGC](https://stacks.math.columbia.edu/tag/0BGC)
-/

@[expose] public noncomputable section

open IsLocalRing MvPolynomial

universe u

namespace AlgebraicGeometry

/-! ### Monomials of degree two -/

/-- **Two degree-two monomials in distinct variables agree exactly when their variables do, up to
order.** -/
public theorem single_one_add_single_one_inj {ι : Type*} [DecidableEq ι] (p r p₀ r₀ : ι) :
    (Finsupp.single p 1 + Finsupp.single r 1 : ι →₀ ℕ)
        = Finsupp.single p₀ 1 + Finsupp.single r₀ 1 ↔
      (p = p₀ ∧ r = r₀) ∨ (p = r₀ ∧ r = p₀) := by
  refine ⟨fun h => ?_, ?_⟩
  · have hp : (Finsupp.single p₀ 1 + Finsupp.single r₀ 1 : ι →₀ ℕ) p ≠ 0 := by
      rw [← h, Finsupp.add_apply, Finsupp.single_eq_same]
      omega
    have hcase : p = p₀ ∨ p = r₀ := by
      by_contra hc
      push Not at hc
      rw [Finsupp.add_apply, Finsupp.single_apply, Finsupp.single_apply,
        if_neg (Ne.symm hc.1), if_neg (Ne.symm hc.2)] at hp
      exact hp rfl
    rcases hcase with rfl | rfl
    · exact Or.inl ⟨rfl, Finsupp.single_left_injective one_ne_zero (add_left_cancel h)⟩
    · refine Or.inr ⟨rfl, ?_⟩
      rw [add_comm (Finsupp.single p₀ (1 : ℕ))] at h
      exact Finsupp.single_left_injective one_ne_zero (add_left_cancel h)
  · rintro (⟨rfl, rfl⟩ | ⟨rfl, rfl⟩)
    · rfl
    · exact add_comm _ _

/-! ### The quadratic form of a coefficient matrix -/

variable {R : Type*} [CommRing R] {m : ℕ}

/-- The quadratic form `Σₚᵩ aₚᵩ tₚtᵩ` presented by a coefficient matrix. -/
public def quadraticFormPoly (a : Fin m → Fin m → R) : MvPolynomial (Fin m) R :=
  ∑ p, ∑ r, MvPolynomial.C (a p r) * (MvPolynomial.X p * MvPolynomial.X r)

public theorem quadraticFormPoly_def (a : Fin m → Fin m → R) :
    quadraticFormPoly a
      = ∑ p, ∑ r, MvPolynomial.C (a p r) * (MvPolynomial.X p * MvPolynomial.X r) := rfl

public theorem quadraticFormPoly_eq_sum_monomial (a : Fin m → Fin m → R) :
    quadraticFormPoly a
      = ∑ p, ∑ r, MvPolynomial.monomial (Finsupp.single p 1 + Finsupp.single r 1) (a p r) := by
  simp only [quadraticFormPoly_def, MvPolynomial.X, MvPolynomial.monomial_mul_monomial,
    MvPolynomial.C_mul_monomial, one_mul, mul_one]

/-- The quadratic form of a coefficient matrix is homogeneous of degree two. -/
public theorem isHomogeneous_quadraticFormPoly (a : Fin m → Fin m → R) :
    (quadraticFormPoly a).IsHomogeneous 2 := by
  rw [quadraticFormPoly_eq_sum_monomial, ← MvPolynomial.mem_homogeneousSubmodule]
  refine Submodule.sum_mem _ fun p _ => Submodule.sum_mem _ fun r _ => ?_
  exact MvPolynomial.isHomogeneous_monomial _ (by simp)

/-- The quadratic form of a coefficient matrix is transported along a ring map by applying the
map to the coefficients. -/
public theorem map_quadraticFormPoly {S : Type*} [CommRing S] (φ : R →+* S)
    (a : Fin m → Fin m → R) :
    MvPolynomial.map φ (quadraticFormPoly a) = quadraticFormPoly fun p r => φ (a p r) := by
  simp [quadraticFormPoly_def]

/-- Evaluating the quadratic form of a coefficient matrix gives the quadratic expression. -/
public theorem aeval_quadraticFormPoly (a : Fin m → Fin m → R) (x : Fin m → R) :
    MvPolynomial.aeval x (quadraticFormPoly a) = ∑ p, ∑ r, a p r * (x p * x r) := by
  simp [quadraticFormPoly_def]

/-! ### The coefficients of the quadratic form -/

public theorem coeff_quadraticFormPoly_eq_sum (a : Fin m → Fin m → R) (c : Fin m →₀ ℕ) :
    MvPolynomial.coeff c (quadraticFormPoly a)
      = ∑ p, ∑ r, if Finsupp.single p 1 + Finsupp.single r 1 = c then a p r else 0 := by
  classical
  rw [quadraticFormPoly_eq_sum_monomial]
  simp only [MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]

/-- **The coefficient of `tₚtᵩ` in the quadratic form, for `p ≠ q`:** it is `aₚᵩ + aᵩₚ`. -/
public theorem coeff_quadraticFormPoly_of_ne (a : Fin m → Fin m → R) {p₀ r₀ : Fin m}
    (hne : p₀ ≠ r₀) :
    MvPolynomial.coeff (Finsupp.single p₀ 1 + Finsupp.single r₀ 1) (quadraticFormPoly a)
      = a p₀ r₀ + a r₀ p₀ := by
  classical
  rw [coeff_quadraticFormPoly_eq_sum]
  simp only [single_one_add_single_one_inj]
  have hout : ∀ p ∈ (Finset.univ : Finset (Fin m)), p ∉ ({p₀, r₀} : Finset (Fin m)) →
      (∑ r, if (p = p₀ ∧ r = r₀) ∨ (p = r₀ ∧ r = p₀) then a p r else 0) = 0 := by
    intro p _ hp
    simp only [Finset.mem_insert, Finset.mem_singleton, not_or] at hp
    simp [hp.1, hp.2]
  rw [← Finset.sum_subset (Finset.subset_univ ({p₀, r₀} : Finset (Fin m))) hout,
    Finset.sum_pair hne]
  simp [hne, hne.symm]

/-- **The coefficient of `tₚ²` in the quadratic form:** it is `aₚₚ`. -/
public theorem coeff_quadraticFormPoly_self (a : Fin m → Fin m → R) (p₀ : Fin m) :
    MvPolynomial.coeff (Finsupp.single p₀ 1 + Finsupp.single p₀ 1) (quadraticFormPoly a)
      = a p₀ p₀ := by
  classical
  rw [coeff_quadraticFormPoly_eq_sum]
  simp only [single_one_add_single_one_inj, or_self]
  rw [Finset.sum_eq_single_of_mem p₀ (Finset.mem_univ p₀) ?_]
  · rw [Finset.sum_eq_single_of_mem p₀ (Finset.mem_univ p₀) ?_]
    · exact if_pos ⟨rfl, rfl⟩
    · intro r _ hr
      exact if_neg fun h => hr h.2
  · intro p _ hp
    refine Finset.sum_eq_zero fun r _ => ?_
    exact if_neg fun h => hp h.1

/-- **An upper triangular coefficient matrix with a nonzero entry on or above the diagonal
presents a nonzero quadratic form.** -/
public theorem quadraticFormPoly_ne_zero {a : Fin m → Fin m → R}
    (hupper : ∀ p r, r < p → a p r = 0) (hne : ∃ p r, p ≤ r ∧ a p r ≠ 0) :
    quadraticFormPoly a ≠ 0 := by
  obtain ⟨p, r, hpr, hane⟩ := hne
  intro h0
  rcases eq_or_lt_of_le hpr with rfl | hlt
  · have hc := coeff_quadraticFormPoly_self a p
    rw [h0, MvPolynomial.coeff_zero] at hc
    exact hane hc.symm
  · have hc := coeff_quadraticFormPoly_of_ne a (ne_of_lt hlt)
    rw [h0, MvPolynomial.coeff_zero, hupper r p hlt, add_zero] at hc
    exact hane hc.symm

/-! ### A good coordinate's variable does not divide the form -/

/-- **The first variable does not divide the quadratic form of a good coordinate.**

If `t₁` divided the form then every coefficient of a monomial in `t₂, …, t_{m+1}` alone would
vanish, that is `q(0, t₂, …, t_{m+1})` would be the zero form — and the zero form is a scalar
times the square of a linear form, with scalar zero, so the first coordinate would not be good.

This is the input `AlgebraicGeometry.mem_pow_succ_of_mul_mem_pow` needs: geometrically it says
that no component of the exceptional divisor `E = V(q)` lies in the hyperplane `t₁ = 0`. -/
public theorem not_X_zero_dvd_quadraticFormPoly {a : Fin (m + 1) → Fin (m + 1) → R}
    (ha : IsGoodCoordinateForm a) :
    ¬ (MvPolynomial.X (0 : Fin (m + 1)) ∣ quadraticFormPoly a) := by
  classical
  rintro ⟨h, hh⟩
  have hsupp : ∀ p r : Fin m, (0 : Fin (m + 1)) ∉
      (Finsupp.single p.succ 1 + Finsupp.single r.succ 1 : Fin (m + 1) →₀ ℕ).support := by
    intro p r
    rw [Finsupp.mem_support_iff, not_not, Finsupp.add_apply, Finsupp.single_apply,
      Finsupp.single_apply, if_neg (Fin.succ_ne_zero p), if_neg (Fin.succ_ne_zero r), add_zero]
  have hzero : ∀ p r : Fin m,
      MvPolynomial.coeff (Finsupp.single p.succ 1 + Finsupp.single r.succ 1)
        (quadraticFormPoly a) = 0 := by
    intro p r
    rw [hh, MvPolynomial.coeff_X_mul', if_neg (hsupp p r)]
  refine ha ⟨0, 0, fun p => ?_, fun p r hpr => ?_⟩
  · rw [restrictFirstVar_apply, ← coeff_quadraticFormPoly_self a p.succ, hzero p p]
    ring
  · rw [restrictFirstVar_apply, restrictFirstVar_apply,
      ← coeff_quadraticFormPoly_of_ne a (Fin.succ_injective m |>.ne (ne_of_lt hpr)),
      hzero p r]
    ring

/-! ### The relation ideal of a rational double point -/

section Local

variable {A : Type u} [CommRing A] [IsLocalRing A]

/-- **The quadratic relation of Section 54.12 makes the quadratic form a relation** in the sense
of `AlgebraicGeometry.gradedRelationIdeal`: the residues of its coefficients present a
homogeneous polynomial of degree two whose value in `𝔪²/𝔪³` vanishes. -/
public theorem evalGradedPieceFun_quadraticFormPoly_eq_zero {m : ℕ} {x : Fin m → A}
    (hx : ∀ i, x i ∈ maximalIdeal A) (a : Fin m → Fin m → A)
    (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3) :
    evalGradedPieceFun hx 2
      (quadraticFormPoly fun p r => IsLocalRing.residue A (a p r)) = 0 := by
  refine (evalGradedPieceFun_eq_zero_iff hx (isHomogeneous_quadraticFormPoly a) ?_).mpr ?_
  · rw [map_quadraticFormPoly,
      homogeneousComponent_eq_self (isHomogeneous_quadraticFormPoly _)]
  · rwa [aeval_quadraticFormPoly]

/-- **The relation ideal of a rational double point is generated by its quadratic form.**

Let `x₁, x₂, x₃` generate the maximal ideal of a Noetherian local ring whose graded pieces have
dimensions `dim_κ(𝔪ⁿ/𝔪ⁿ⁺¹) = 2n + 1`, and let `Σ aₚᵩ xₚxᵩ = Σ aₚᵩᵣ xₚxᵩxᵣ` be the quadratic
relation of Section 54.12, with `a` upper triangular and one entry on or above the diagonal a
unit. Then the homogeneous ideal of all relations among `x₁, x₂, x₃` is generated by the single
quadratic form the residues of `a` present.

This is the algebraic content of `E = V(q) ⊆ ℙ²_κ`. The dimension formula is a hypothesis, not a
conclusion; see `AlgebraicGeometry.BlowUpDualizing.finrank_gradedPiece_eq_two_mul_add_one`. -/
public theorem gradedRelationIdeal_eq_span_quadraticFormPoly [IsNoetherianRing A] {x : Fin 3 → A}
    (hx : ∀ i, x i ∈ maximalIdeal A) (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (hdim : ∀ n, Module.finrank (ResidueField A) (IsLocalRing.gradedPiece A n) = 2 * n + 1)
    (a : Fin 3 → Fin 3 → A) (hupper : ∀ p r, r < p → a p r = 0)
    (hunit : ∃ p r, p ≤ r ∧ a p r ∉ maximalIdeal A)
    (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3) :
    gradedRelationIdeal hx
      = Ideal.span {quadraticFormPoly fun p r => IsLocalRing.residue A (a p r)} :=
  gradedRelationIdeal_eq_span_singleton hx hspan hdim
    (isHomogeneous_quadraticFormPoly _)
    (quadraticFormPoly_ne_zero
      (fun p r hrp => by rw [hupper p r hrp, map_zero])
      (by
        obtain ⟨p, r, hpr, hmem⟩ := hunit
        exact ⟨p, r, hpr, fun h => hmem ((IsLocalRing.residue_eq_zero_iff (a p r)).mp h)⟩))
    (evalGradedPieceFun_quadraticFormPoly_eq_zero hx a hrel)

/-- **A good coordinate of a rational double point is a superficial element of the maximal
ideal:** if `x₁` is a good coordinate then `x₁v ∈ 𝔪ⁿ⁺²` and `v ∈ 𝔪ⁿ` force `v ∈ 𝔪ⁿ⁺¹`.

This composes `AlgebraicGeometry.gradedRelationIdeal_eq_span_quadraticFormPoly`, which identifies
the relation ideal with `(q)`, and
`AlgebraicGeometry.not_X_zero_dvd_quadraticFormPoly`, which says `t₁ ∤ q`, through
`AlgebraicGeometry.mem_pow_succ_of_mul_mem_pow`. It is the algebraic form of the source's
assertion that a good coordinate cuts the exceptional divisor out: no component of `E = V(q)`
lies in `t₁ = 0`. -/
public theorem mem_pow_succ_of_mul_mem_pow_of_isGoodCoordinateForm [IsNoetherianRing A]
    {x : Fin 3 → A} (hx : ∀ i, x i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (hdim : ∀ n, Module.finrank (ResidueField A) (IsLocalRing.gradedPiece A n) = 2 * n + 1)
    (a : Fin 3 → Fin 3 → A) (hupper : ∀ p r, r < p → a p r = 0)
    (hunit : ∃ p r, p ≤ r ∧ a p r ∉ maximalIdeal A)
    (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3)
    (hgood : IsGoodCoordinateForm fun p r => IsLocalRing.residue A (a p r))
    {n : ℕ} {v : A} (hv : v ∈ maximalIdeal A ^ n)
    (hmul : x 0 * v ∈ maximalIdeal A ^ (n + 2)) :
    v ∈ maximalIdeal A ^ (n + 1) :=
  mem_pow_succ_of_mul_mem_pow hx hspan
    (gradedRelationIdeal_eq_span_quadraticFormPoly hx hspan hdim a hupper hunit hrel)
    (not_X_zero_dvd_quadraticFormPoly hgood) hv hmul

/-! ### Dehomogenizing at the first variable -/

/-- **Dehomogenization at the first variable:** the `k`-algebra map `tₚ ↦ 1`, `tₚ₊₁ ↦ yₚ₊₁`. On a
homogeneous polynomial of degree `n` it computes `q(1, y₂, …, y_{m+1})`, the equation of the
affine chart `t₁ ≠ 0` of the projective hypersurface the form cuts out. -/
public def dehomogenizeFirst (k : Type*) [CommRing k] (m : ℕ) :
    MvPolynomial (Fin (m + 1)) k →ₐ[k] MvPolynomial (Fin m) k :=
  MvPolynomial.aeval (Fin.cons 1 MvPolynomial.X)

@[simp]
public theorem dehomogenizeFirst_X_zero (k : Type*) [CommRing k] (m : ℕ) :
    dehomogenizeFirst k m (MvPolynomial.X 0) = 1 := by
  rw [dehomogenizeFirst, MvPolynomial.aeval_X, Fin.cons_zero]

@[simp]
public theorem dehomogenizeFirst_X_succ (k : Type*) [CommRing k] {m : ℕ} (p : Fin m) :
    dehomogenizeFirst k m (MvPolynomial.X p.succ) = MvPolynomial.X p := by
  rw [dehomogenizeFirst, MvPolynomial.aeval_X, Fin.cons_succ]

/-- **The dehomogenized form of the identification `E = V(q)`:** the image of the relation ideal
under dehomogenization at the first variable is generated by `q(1, y₂, …, y_{m+1})`.

This is `AlgebraicGeometry.eq_span_singleton_of_hilbertFunction_two_mul_add_one` read on the
affine chart `t₁ ≠ 0`, which is the chart the source works in: `κ[y₂, …]/(q(1, y₂, …))` is the
right hand side of the source's `A[𝔪/x₁]/x₁ ≅ κ[y₂, y₃]/(q(1, y₂, y₃))`. -/
public theorem map_dehomogenizeFirst_eq_span_singleton {k : Type*} [CommRing k] {m : ℕ}
    {I : Ideal (MvPolynomial (Fin (m + 1)) k)} {q : MvPolynomial (Fin (m + 1)) k}
    (hI : I = Ideal.span {q}) :
    Ideal.map (dehomogenizeFirst k m) I = Ideal.span {dehomogenizeFirst k m q} := by
  rw [hI, Ideal.map_span, Set.image_singleton]

/-- **The dehomogenization of a ternary quadratic form with upper triangular coefficient
matrix:** `q(1, y₂, y₃) = ā₁₁ + ā₁₂y₂ + ā₁₃y₃ + ā₂₂y₂² + ā₂₃y₂y₃ + ā₃₃y₃²`.

This is the expression the Claim of Section 54.12 is stated with:
`AlgebraicGeometry.rank_le_one_of_not_isScalarSqLinear` asks that it lie in the square of the
ideal cutting out a closed point of the exceptional curve. -/
public theorem dehomogenizeFirst_quadraticFormPoly_fin_three {k : Type*} [CommRing k]
    (a : Fin 3 → Fin 3 → k) (hupper : ∀ p r, r < p → a p r = 0) :
    dehomogenizeFirst k 2 (quadraticFormPoly a)
      = MvPolynomial.C (a 0 0) + MvPolynomial.C (a 0 1) * MvPolynomial.X 0 +
        MvPolynomial.C (a 0 2) * MvPolynomial.X 1 +
        MvPolynomial.C (a 1 1) * MvPolynomial.X 0 ^ 2 +
        MvPolynomial.C (a 1 2) * MvPolynomial.X 0 * MvPolynomial.X 1 +
        MvPolynomial.C (a 2 2) * MvPolynomial.X 1 ^ 2 := by
  have hc0 : dehomogenizeFirst k 2 (MvPolynomial.X 0) = 1 := dehomogenizeFirst_X_zero k 2
  have hc1 : dehomogenizeFirst k 2 (MvPolynomial.X 1) = MvPolynomial.X 0 :=
    dehomogenizeFirst_X_succ k (0 : Fin 2)
  have hc2 : dehomogenizeFirst k 2 (MvPolynomial.X 2) = MvPolynomial.X 1 :=
    dehomogenizeFirst_X_succ k (1 : Fin 2)
  have hexp : quadraticFormPoly a
      = MvPolynomial.C (a 0 0) * (MvPolynomial.X 0 * MvPolynomial.X 0)
        + MvPolynomial.C (a 0 1) * (MvPolynomial.X 0 * MvPolynomial.X 1)
        + MvPolynomial.C (a 0 2) * (MvPolynomial.X 0 * MvPolynomial.X 2)
        + (MvPolynomial.C (a 1 0) * (MvPolynomial.X 1 * MvPolynomial.X 0)
          + MvPolynomial.C (a 1 1) * (MvPolynomial.X 1 * MvPolynomial.X 1)
          + MvPolynomial.C (a 1 2) * (MvPolynomial.X 1 * MvPolynomial.X 2))
        + (MvPolynomial.C (a 2 0) * (MvPolynomial.X 2 * MvPolynomial.X 0)
          + MvPolynomial.C (a 2 1) * (MvPolynomial.X 2 * MvPolynomial.X 1)
          + MvPolynomial.C (a 2 2) * (MvPolynomial.X 2 * MvPolynomial.X 2)) := by
    rw [quadraticFormPoly_def, Fin.sum_univ_three, Fin.sum_univ_three, Fin.sum_univ_three,
      Fin.sum_univ_three]
  rw [hexp, hupper 1 0 (by decide), hupper 2 0 (by decide), hupper 2 1 (by decide)]
  simp only [map_add, map_mul, MvPolynomial.algHom_C, MvPolynomial.algebraMap_eq,
    hc0, hc1, hc2, MvPolynomial.C_0, map_zero, zero_mul]
  ring

/-- **The dehomogenized identification for a rational double point:** the image of the relation
ideal under dehomogenization at the first variable is generated by

`q(1, y₂, y₃) = ā₁₁ + ā₁₂y₂ + ā₁₃y₃ + ā₂₂y₂² + ā₂₃y₂y₃ + ā₃₃y₃²`.

This is the right hand side of the source's `A[𝔪/x₁]/x₁ ≅ κ[y₂, y₃]/(q(1, y₂, y₃))`, and the
polynomial is the one the Claim of Section 54.12 is stated with, so
`AlgebraicGeometry.rank_le_one_of_not_isScalarSqLinear` applies to it verbatim.

What is not proved is that the left hand side is the ring of the affine blowup chart. What that
needs beyond the statements here is the surjection `κ[y₂, y₃] → A[𝔪/x₁]/x₁A[𝔪/x₁]` and the
identification of its kernel with the image of the relation ideal; the second of those is
`AlgebraicGeometry.mem_pow_succ_of_mul_mem_pow_of_isGoodCoordinateForm` applied to the
filtration of the chart by the images of `𝔪ⁿ/x₁ⁿ`. -/
public theorem map_dehomogenizeFirst_gradedRelationIdeal_eq_span [IsNoetherianRing A]
    {x : Fin 3 → A} (hx : ∀ i, x i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (hdim : ∀ n, Module.finrank (ResidueField A) (IsLocalRing.gradedPiece A n) = 2 * n + 1)
    (a : Fin 3 → Fin 3 → A) (hupper : ∀ p r, r < p → a p r = 0)
    (hunit : ∃ p r, p ≤ r ∧ a p r ∉ maximalIdeal A)
    (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3) :
    Ideal.map (dehomogenizeFirst (ResidueField A) 2) (gradedRelationIdeal hx)
      = Ideal.span {MvPolynomial.C (IsLocalRing.residue A (a 0 0)) +
          MvPolynomial.C (IsLocalRing.residue A (a 0 1)) * MvPolynomial.X 0 +
          MvPolynomial.C (IsLocalRing.residue A (a 0 2)) * MvPolynomial.X 1 +
          MvPolynomial.C (IsLocalRing.residue A (a 1 1)) * MvPolynomial.X 0 ^ 2 +
          MvPolynomial.C (IsLocalRing.residue A (a 1 2)) * MvPolynomial.X 0 * MvPolynomial.X 1 +
          MvPolynomial.C (IsLocalRing.residue A (a 2 2)) * MvPolynomial.X 1 ^ 2} := by
  rw [map_dehomogenizeFirst_eq_span_singleton
      (gradedRelationIdeal_eq_span_quadraticFormPoly hx hspan hdim a hupper hunit hrel),
    dehomogenizeFirst_quadraticFormPoly_fin_three _
      (fun p r hrp => by rw [hupper p r hrp, map_zero])]

end Local

