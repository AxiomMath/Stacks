module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.CaseOneChart

/-!
# Case II of Section 54.12: the exact invariant `w₃² = w₁F`

The source treats case II through the "subclass" of local rings with generators satisfying
`x₃² + x₁(a x₂² + b x₂x₃ + c x₃²) ∈ 𝔪⁴`, and asserts that the singular point of the blowup is the
origin of the chart `x₁` with a new equation "of the same shape". As written this step has a gap:
blowing up such an equation at the origin of the chart `x₁` gives

`y₃² + x₁(a y₂² + b y₂y₃ + c y₃²) = x₁²(a₁₁₁₁ + a₁₁₁₂y₂ + a₁₁₁₃y₃ + …)`,

and the terms `x₁²(a₁₁₁₁ + a₁₁₁₂y₂ + a₁₁₁₃y₃)` are of degree three in the new maximal ideal
(`a₁₁₁₁ ∈ 𝔪'` once the point is in case II), not of degree four; they move the double root of the
restricted cubic, so neither "the same shape" nor "the point `y₂ = y₃ = 0`" holds verbatim.

The repair used here keeps the statement of Tag 0BGE unchanged and replaces the subclass by an
exact invariant which the blowup does preserve:

* `AlgebraicGeometry.HasDoubleLineRelation B w`: `𝔪 = (w₁, w₂, w₃)` and `w₃² = w₁F` with
  `F ∈ 𝔪²` (an exact equation, no remainder);
* `AlgebraicGeometry.HasDoubleLineRelationUnit B w`: moreover `F ≡ f w₂²` modulo `(w₁, w₃)𝔪` with
  `f` a unit — the source's `ā ≠ 0`, which it derives from normality.

The basic step is `AlgebraicGeometry.exists_add_mul_sq_mem_of_not_isCaseOne`: if a singular
local ring of dimension two in case II satisfies `w₃² = w₁Φ` with `Φ = c₁w₁ + c₂w₂ + c₃w₃`, then
`c₂ ∈ 𝔪` and, completing the square, `(w₃ + λw₁)² = w₁(Φ + 2λw₃ + λ²w₁)` with
`Φ + 2λw₃ + λ²w₁ ∈ 𝔪²`. This is the source's observation that "it still has to be the case that
`ā₁₁₃ = 0` for the quadratic form `q'` to have the right shape", done exactly.

## References

* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
-/

@[expose] public section

open IsLocalRing

namespace AlgebraicGeometry

variable {B : Type*} [CommRing B] [IsLocalRing B]

/-- **The exact case II invariant.** The maximal ideal is generated by `w₁, w₂, w₃` and
`w₃² = w₁F` for some `F ∈ 𝔪²`. -/
def HasDoubleLineRelation (B : Type*) [CommRing B] [IsLocalRing B] (w : Fin 3 → B) : Prop :=
  Ideal.span (Set.range w) = maximalIdeal B ∧ ∃ F ∈ maximalIdeal B ^ 2, w 2 * w 2 = w 0 * F

/-- **The exact case II invariant with nondegenerate `w₂²`-coefficient.** The maximal ideal is
generated by `w₁, w₂, w₃` and `w₃² = w₁F` with `F ≡ f w₂²` modulo `(w₁, w₃)𝔪` for a unit `f`. -/
def HasDoubleLineRelationUnit (B : Type*) [CommRing B] [IsLocalRing B] (w : Fin 3 → B) : Prop :=
  Ideal.span (Set.range w) = maximalIdeal B ∧ ∃ F f : B, IsUnit f ∧
    F - f * (w 1 * w 1) ∈ Ideal.span {w 0, w 2} * maximalIdeal B ∧ w 2 * w 2 = w 0 * F

/-- The span of a family of three elements. -/
theorem span_range_fin_three (w : Fin 3 → B) :
    Ideal.span (Set.range w) = Ideal.span {w 0, w 1, w 2} := by
  congr 1
  ext t
  simp [Fin.exists_fin_succ, eq_comm]

/-- **The equation `w₃² = w₁Φ` at a singular point forces `Φ ∈ 𝔪`.** Otherwise
`w₁ = w₃²Φ⁻¹ ∈ (w₃)`, the maximal ideal is generated by `w₂, w₃`, and a two-dimensional Noetherian
local ring would be regular. -/
theorem mem_maximalIdeal_of_sq_eq_mul [IsNoetherianRing B] (hdim : ringKrullDim B = 2)
    (hsing : ¬ IsRegularLocalRing B) (w : Fin 3 → B)
    (hspan : Ideal.span (Set.range w) = maximalIdeal B) {Φ : B} (hrel : w 2 * w 2 = w 0 * Φ) :
    Φ ∈ maximalIdeal B := by
  by_contra hΦ
  obtain ⟨ψ, hψ⟩ := (notMem_maximalIdeal.mp hΦ).exists_right_inv
  have hw0 : w 0 = w 2 * (w 2 * ψ) := by
    rw [← mul_assoc, hrel, mul_assoc, hψ, mul_one]
  have hmem : ∀ i, w i ∈ maximalIdeal B := fun i => hspan ▸ Ideal.subset_span ⟨i, rfl⟩
  refine hsing (isRegularLocalRing_of_maximalIdeal_eq_span_pair hdim (u := w 1) (v := w 2)
    (le_antisymm ?_ ?_))
  · rw [← hspan, span_range_fin_three, Ideal.span_le]
    intro z hz
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
    rcases hz with rfl | rfl | rfl
    · rw [hw0]; exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))
    · exact Ideal.subset_span (by simp)
    · exact Ideal.subset_span (by simp)
  · rw [Ideal.span_le]
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff, SetLike.mem_coe]
    exact ⟨hmem 1, hmem 2⟩

/-- **Completing the square in case II.** Let `B` be a local ring in case II (not
`AlgebraicGeometry.IsCaseOne`) with `𝔪 = (w₁, w₂, w₃)` and `w₃² = w₁(c₁w₁ + c₂w₂ + c₃w₃)`. Then
`c₂ ∈ 𝔪`, and there is `λ` with `c₁ + λ² ∈ 𝔪` and `c₃ + 2λ ∈ 𝔪`.

The quadratic form of the relation `c₁w₁² + c₂w₁w₂ + c₃w₁w₃ - w₃² = 0` is
`c̄₁t₁² + c̄₂t₁t₂ + c̄₃t₁t₃ - t₃²`; in case II it is a scalar times a square, which forces
`c̄₂ = 0` and `c̄₁t₁² + c̄₃t₁t₃ - t₃² = -(t₃ + λ̄t₁)²`. -/
theorem exists_add_mul_sq_mem_of_not_isCaseOne (hII : ¬ IsCaseOne B) (w : Fin 3 → B)
    (hspan : Ideal.span (Set.range w) = maximalIdeal B) (c : Fin 3 → B)
    (hrel : w 2 * w 2 = w 0 * (c 0 * w 0 + c 1 * w 1 + c 2 * w 2)) :
    c 1 ∈ maximalIdeal B ∧ ∃ μ : B, c 0 + μ * μ ∈ maximalIdeal B ∧
      c 2 + 2 * μ ∈ maximalIdeal B := by
  classical
  let a : Fin 3 → Fin 3 → B := ![![c 0, c 1, c 2], ![0, 0, 0], ![0, 0, -1]]
  have hupper : ∀ p q, q < p → a p q = 0 := by
    intro p q hpq
    fin_cases p <;> fin_cases q <;> simp [a] at hpq ⊢
  have hsum : ∑ p, ∑ q, a p q * (w p * w q) = 0 := by
    simp only [Fin.sum_univ_three, a, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
    linear_combination -hrel
  have hsq : IsScalarSqLinear fun p q => residue B (a p q) := by
    by_contra hns
    refine hII ⟨w, a, hspan, hupper, ⟨2, 2, le_rfl, ?_⟩, by rw [hsum]; exact zero_mem _, hns⟩
    simp only [a, Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
    rw [notMem_maximalIdeal]
    exact isUnit_one.neg
  obtain ⟨k, l, hdiag, hoff⟩ := hsq
  have h11 := hdiag 1
  have h22 := hdiag 2
  have h00 := hdiag 0
  have h01 := hoff 0 1 (by decide)
  have h02 := hoff 0 2 (by decide)
  simp only [a, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.tail_cons, Matrix.head_cons, map_zero, map_neg, map_one] at h11 h22 h00 h01 h02
  have hl2 : l 2 ≠ 0 := fun h => by rw [h, mul_zero] at h22; exact one_ne_zero (neg_eq_zero.mp h22)
  have hk : k ≠ 0 := fun h => by
    rw [h, zero_mul, zero_mul] at h22; exact one_ne_zero (neg_eq_zero.mp h22)
  have hl1 : l 1 = 0 := by
    have : k * (l 1 * l 1) = 0 := by rw [← mul_assoc]; exact h11.symm
    exact mul_self_eq_zero.mp ((mul_eq_zero.mp this).resolve_left hk)
  refine ⟨?_, ?_⟩
  · rw [← residue_eq_zero_iff, ← add_zero (residue B (c 1)), h01, hl1]
    ring
  · obtain ⟨μ, hμ⟩ := residue_surjective (l 0 / l 2)
    have hinv : l 2 * (l 2)⁻¹ = 1 := mul_inv_cancel₀ hl2
    refine ⟨μ, ?_, ?_⟩
    · rw [← residue_eq_zero_iff, map_add, map_mul, hμ, h00]
      linear_combination (-(l 0 * l 0 * (l 2)⁻¹ * (l 2)⁻¹)) * h22 +
        (-(k * l 0 * l 0) * (l 2 * (l 2)⁻¹ + 1)) * hinv
    · rw [← residue_eq_zero_iff, map_add, map_mul, hμ, map_ofNat]
      linear_combination h02 + (-(2 * l 0 * (l 2)⁻¹)) * h22 + (-(2 * k * l 0 * l 2)) * hinv

/-- Replacing `w₃` by `w₃ + μw₁` does not change the span. -/
private theorem span_range_add_mul_eq (w : Fin 3 → B) (μ : B) :
    Ideal.span (Set.range ![w 0, w 1, w 2 + μ * w 0]) = Ideal.span (Set.range w) := by
  rw [span_range_fin_three, span_range_fin_three]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.tail_cons, Matrix.head_cons]
  apply le_antisymm <;> rw [Ideal.span_le] <;>
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff, SetLike.mem_coe]
  · exact ⟨Ideal.subset_span (by simp), Ideal.subset_span (by simp),
      Ideal.add_mem _ (Ideal.subset_span (by simp))
        (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))⟩
  · refine ⟨Ideal.subset_span (by simp), Ideal.subset_span (by simp), ?_⟩
    rw [show w 2 = (w 2 + μ * w 0) - μ * w 0 by ring]
    exact Ideal.sub_mem _ (Ideal.subset_span (by simp))
      (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))

/-- **The case II invariant at a singular point.** Let `B` be a singular two-dimensional
Noetherian local ring in case II with `𝔪 = (w₁, w₂, w₃)` and `w₃² = w₁Φ`. Then, after replacing
`w₃` by `w₃ + λw₁`, the relation reads `(w₃ + λw₁)² = w₁F` with `F = Φ + 2λw₃ + λ²w₁ ∈ 𝔪²`:
`B` satisfies `AlgebraicGeometry.HasDoubleLineRelation`. -/
theorem exists_hasDoubleLineRelation_of_sq_eq_mul [IsNoetherianRing B] (hdim : ringKrullDim B = 2)
    (hsing : ¬ IsRegularLocalRing B) (hII : ¬ IsCaseOne B) (w : Fin 3 → B)
    (hspan : Ideal.span (Set.range w) = maximalIdeal B) {Φ : B} (hrel : w 2 * w 2 = w 0 * Φ) :
    ∃ μ : B, Φ + 2 * μ * w 2 + μ * μ * w 0 ∈ maximalIdeal B ^ 2 ∧
      HasDoubleLineRelation B ![w 0, w 1, w 2 + μ * w 0] := by
  have hΦ := mem_maximalIdeal_of_sq_eq_mul hdim hsing w hspan hrel
  rw [← hspan, Submodule.mem_span_range_iff_exists_fun] at hΦ
  obtain ⟨c, hc⟩ := hΦ
  simp only [Fin.sum_univ_three, smul_eq_mul] at hc
  have hrel' : w 2 * w 2 = w 0 * (c 0 * w 0 + c 1 * w 1 + c 2 * w 2) := by rwa [hc]
  obtain ⟨hc1, μ, hc0, hc2⟩ := exists_add_mul_sq_mem_of_not_isCaseOne hII w hspan c hrel'
  have hmem : ∀ i, w i ∈ maximalIdeal B := fun i => hspan ▸ Ideal.subset_span ⟨i, rfl⟩
  have hF : Φ + 2 * μ * w 2 + μ * μ * w 0 ∈ maximalIdeal B ^ 2 := by
    have heq : Φ + 2 * μ * w 2 + μ * μ * w 0 =
        (c 0 + μ * μ) * w 0 + c 1 * w 1 + (c 2 + 2 * μ) * w 2 := by
      rw [← hc]; ring
    rw [heq, pow_two]
    exact Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_mul hc0 (hmem 0))
      (Ideal.mul_mem_mul hc1 (hmem 1))) (Ideal.mul_mem_mul hc2 (hmem 2))
  refine ⟨μ, hF, ?_, _, hF, ?_⟩
  · exact (span_range_add_mul_eq w μ).trans hspan
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
    linear_combination hrel

/-- **Nakayama at a singular point.** If `𝔪 = (w, z₁, z₂)` and `w ∈ 𝔪²`, a two-dimensional
Noetherian local ring is regular. -/
theorem isRegularLocalRing_of_span_triple_of_mem_sq [IsNoetherianRing B]
    (hdim : ringKrullDim B = 2) {w z₁ z₂ : B} (hspan : maximalIdeal B = Ideal.span {w, z₁, z₂})
    (hw : w ∈ maximalIdeal B ^ 2) : IsRegularLocalRing B := by
  have hz₁ : z₁ ∈ maximalIdeal B := hspan ▸ Ideal.subset_span (by simp)
  have hz₂ : z₂ ∈ maximalIdeal B := hspan ▸ Ideal.subset_span (by simp)
  refine isRegularLocalRing_of_maximalIdeal_eq_span_pair hdim (u := z₁) (v := z₂)
    (le_antisymm ?_ ?_)
  · refine Submodule.le_of_le_smul_of_le_jacobson_bot (IsNoetherian.noetherian _)
      (maximalIdeal_le_jacobson ⊥) ?_
    rw [smul_eq_mul, ← pow_two]
    conv_lhs => rw [hspan]
    rw [Ideal.span_le]
    intro t ht
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at ht
    rcases ht with rfl | rfl | rfl
    · exact Ideal.mem_sup_right hw
    · exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
    · exact Ideal.mem_sup_left (Ideal.subset_span (by simp))
  · rw [Ideal.span_le]
    simp only [Set.insert_subset_iff, Set.singleton_subset_iff, SetLike.mem_coe]
    exact ⟨hz₁, hz₂⟩

/-- An element of `(a, b)·I` is `aα + bβ` with `α, β ∈ I`. -/
theorem exists_eq_of_mem_span_pair_mul {I : Ideal B} {a b z : B}
    (hz : z ∈ Ideal.span {a, b} * I) : ∃ α ∈ I, ∃ β ∈ I, z = a * α + b * β := by
  rw [Ideal.span_insert, Ideal.sup_mul, Submodule.mem_sup] at hz
  obtain ⟨u, hu, v, hv, rfl⟩ := hz
  obtain ⟨α, hα, rfl⟩ := Ideal.mem_span_singleton_mul.mp hu
  obtain ⟨β, hβ, rfl⟩ := Ideal.mem_span_singleton_mul.mp hv
  exact ⟨α, hα, β, hβ, rfl⟩

/-- **The case II step at a `κ`-rational point, in the local ring.** Let `g : A → B` be a map to
a singular two-dimensional Noetherian local ring in case II, with `g⁻¹𝔪_B ⊆ 𝔪_A` and `g(𝔪_A)`
contained in `(W)`, `W = g(w₁)`. Suppose `𝔪_B = (W, Y₂ - gπ, Y₃)` and
`Y₃² = W(f Y₂² + α₁ + α₂Y₂ + α₃Y₃ + Y₃(β₁ + β₂Y₂ + β₃Y₃))` with `f` a unit (coefficients
pushed along `g`). Then, for some `μ`, `(W, Y₂ - gπ, Y₃ + μW)` satisfies the case II invariant
with nondegenerate `w₂²`-coefficient `f`.

This is the source's step "after changing our choice of `x₁, x₂, x₃` we may assume this is the
point `y₂ = y₃ = 0` ... the new equation looks like ... which has the same shape as before",
carried out with the exact invariant `AlgebraicGeometry.HasDoubleLineRelationUnit`. -/
theorem hasDoubleLineRelationUnit_of_rationalPoint {A : Type*} [CommRing A] [IsLocalRing A]
    [IsNoetherianRing B] (hdim : ringKrullDim B = 2) (hsing : ¬ IsRegularLocalRing B)
    (hII : ¬ IsCaseOne B) (g : A →+* B) (W : B)
    (hloc : ∀ r, g r ∈ maximalIdeal B → r ∈ maximalIdeal A)
    (hdiv : ∀ r ∈ maximalIdeal A, g r ∈ Ideal.span {W})
    (Y₂ Y₃ : B) (π f : A) (α β : Fin 3 → A) (hf : IsUnit f)
    (hspan : maximalIdeal B = Ideal.span {W, Y₂ - g π, Y₃})
    (hrel : Y₃ * Y₃ = W * (g f * Y₂ * Y₂ + (g (α 0) + g (α 1) * Y₂ + g (α 2) * Y₃) +
      Y₃ * (g (β 0) + g (β 1) * Y₂ + g (β 2) * Y₃))) :
    ∃ μ : B, HasDoubleLineRelationUnit B ![W, Y₂ - g π, Y₃ + μ * W] := by
  set T := Y₂ - g π with hT
  set w : Fin 3 → B := ![W, T, Y₃] with hw
  have hwspan : Ideal.span (Set.range w) = maximalIdeal B := by
    rw [span_range_fin_three, hspan]; rfl
  have hmem : ∀ i, w i ∈ maximalIdeal B := fun i => hwspan ▸ Ideal.subset_span ⟨i, rfl⟩
  have hW : W ∈ maximalIdeal B := hmem 0
  have hTm : T ∈ maximalIdeal B := hmem 1
  have hY₃ : Y₃ ∈ maximalIdeal B := hmem 2
  set s := g (α 2) + g (β 0) + g (β 1) * Y₂ + g (β 2) * Y₃ with hs
  set c := f * π * π + α 1 * π + α 0 with hc
  set d := 2 * f * π + α 1 with hd
  set Φ := g f * Y₂ * Y₂ + (g (α 0) + g (α 1) * Y₂ + g (α 2) * Y₃) +
    Y₃ * (g (β 0) + g (β 1) * Y₂ + g (β 2) * Y₃) with hΦ
  have hΦexp : Φ = g c + g d * T + g f * T * T + s * Y₃ := by
    simp only [hΦ, hc, hd, hs, hT, map_add, map_mul, map_ofNat]; ring
  have hΦm : Φ ∈ maximalIdeal B := mem_maximalIdeal_of_sq_eq_mul hdim hsing w hwspan hrel
  have hcm : c ∈ maximalIdeal A := by
    refine hloc c ?_
    have : g c = Φ - (g d * T + g f * T * T + s * Y₃) := by rw [hΦexp]; ring
    rw [this]
    exact Ideal.sub_mem _ hΦm (Ideal.add_mem _ (Ideal.add_mem _ (Ideal.mul_mem_left _ _ hTm)
      (Ideal.mul_mem_left _ _ hTm)) (Ideal.mul_mem_left _ _ hY₃))
  obtain ⟨e₀, he₀⟩ := Ideal.mem_span_singleton'.mp (hdiv c hcm)
  have hrel₁ : w 2 * w 2 = w 0 * (e₀ * w 0 + (g d + g f * T) * w 1 + s * w 2) := by
    simp only [hw, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.tail_cons, Matrix.head_cons]
    rw [hrel, hΦexp, ← he₀]; ring
  obtain ⟨hc₁, -⟩ := exists_add_mul_sq_mem_of_not_isCaseOne hII w hwspan ![e₀, g d + g f * T, s]
    (by simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
        Matrix.tail_cons, Matrix.head_cons]; exact hrel₁)
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at hc₁
  have hdm : d ∈ maximalIdeal A := by
    refine hloc d ?_
    have : g d = (g d + g f * T) - g f * T := by ring
    rw [this]
    exact Ideal.sub_mem _ hc₁ (Ideal.mul_mem_left _ _ hTm)
  obtain ⟨e₁, he₁⟩ := Ideal.mem_span_singleton'.mp (hdiv d hdm)
  have hrel₂ : w 2 * w 2 = w 0 * ((e₀ + e₁ * T) * w 0 + (g f * T) * w 1 + s * w 2) := by
    rw [hrel₁, ← he₁]
    simp only [hw, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.tail_cons, Matrix.head_cons]
    ring
  obtain ⟨-, μ, hμ₀, hμ₂⟩ := exists_add_mul_sq_mem_of_not_isCaseOne hII w hwspan
    ![e₀ + e₁ * T, g f * T, s] (by simp only [Matrix.cons_val_zero, Matrix.cons_val_one,
        Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]; exact hrel₂)
  simp only [hw, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
    Matrix.tail_cons, Matrix.head_cons] at hμ₀ hμ₂ hrel₂
  refine ⟨μ, ?_, (e₀ + e₁ * T + μ * μ) * W + g f * T * T + (s + 2 * μ) * Y₃, g f, hf.map g,
    ?_, ?_⟩
  · exact (span_range_add_mul_eq w μ).trans hwspan
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.tail_cons, Matrix.head_cons]
    have heq : (e₀ + e₁ * T + μ * μ) * W + g f * T * T + (s + 2 * μ) * Y₃ - g f * (T * T) =
        W * ((e₀ + e₁ * T + μ * μ) - μ * (s + 2 * μ)) + (Y₃ + μ * W) * (s + 2 * μ) := by ring
    rw [heq, Ideal.span_insert, Ideal.sup_mul]
    refine Ideal.add_mem _ (Ideal.mem_sup_left ?_) (Ideal.mem_sup_right ?_)
    · exact Ideal.mul_mem_mul (Ideal.subset_span rfl)
        (Ideal.sub_mem _ hμ₀ (Ideal.mul_mem_left _ _ hμ₂))
    · exact Ideal.mul_mem_mul (Ideal.subset_span rfl) hμ₂
  · simp only [Matrix.cons_val_zero, Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
    linear_combination hrel₂

/-- **No case II singular point at a non-rational point, in the local ring.** With the notation of
`AlgebraicGeometry.hasDoubleLineRelationUnit_of_rationalPoint`, if instead
`𝔪_B = (W, Φ₀, Y₃)` with `Φ₀ = f Y₂² + α₂Y₂ + α₁` (the point of the exceptional line where the
binary form `f t₂² + α₂ t₁t₂ + α₁ t₁²` vanishes, when that point is not `κ`-rational), then `B` is
not singular in case II: the coefficient of `t₁t₂` in the quadratic form at the point is `1`. -/
theorem false_of_irrationalPoint {A : Type*} [CommRing A] [IsLocalRing A]
    (hII : ¬ IsCaseOne B) (g : A →+* B) (W Y₂ Y₃ : B) (f : A) (α β : Fin 3 → A)
    (hspan : maximalIdeal B = Ideal.span {W, g f * Y₂ * Y₂ + g (α 1) * Y₂ + g (α 0), Y₃})
    (hrel : Y₃ * Y₃ = W * (g f * Y₂ * Y₂ + (g (α 0) + g (α 1) * Y₂ + g (α 2) * Y₃) +
      Y₃ * (g (β 0) + g (β 1) * Y₂ + g (β 2) * Y₃))) : False := by
  set w : Fin 3 → B := ![W, g f * Y₂ * Y₂ + g (α 1) * Y₂ + g (α 0), Y₃] with hw
  have hwspan : Ideal.span (Set.range w) = maximalIdeal B := by
    rw [span_range_fin_three, hspan]; rfl
  have hrel' : w 2 * w 2 = w 0 * (0 * w 0 + 1 * w 1 +
      (g (α 2) + g (β 0) + g (β 1) * Y₂ + g (β 2) * Y₃) * w 2) := by
    simp only [hw, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.tail_cons, Matrix.head_cons]
    rw [hrel]; ring
  obtain ⟨h1, -⟩ := exists_add_mul_sq_mem_of_not_isCaseOne hII w hwspan
    ![0, 1, g (α 2) + g (β 0) + g (β 1) * Y₂ + g (β 2) * Y₃] (by simp only [Matrix.cons_val_zero,
        Matrix.cons_val_one, Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]; exact hrel')
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one] at h1
  exact (maximalIdeal.isMaximal B).ne_top ((Ideal.eq_top_iff_one _).mpr h1)

/-- An element of `𝔪²`, with `𝔪 = (w₁, w₂, w₃)`, is a quadratic expression `Σ fₚᵩ wₚwᵩ`. -/
theorem exists_eq_sum_of_mem_sq (w : Fin 3 → B) (hspan : Ideal.span (Set.range w) = maximalIdeal B)
    {F : B} (hF : F ∈ maximalIdeal B ^ 2) :
    ∃ f : Fin 3 → Fin 3 → B, F = ∑ p, ∑ q, f p q * (w p * w q) := by
  have hsq : maximalIdeal B ^ 2 =
      Ideal.span (Set.range fun t : Fin 3 × Fin 3 => w t.1 * w t.2) := by
    rw [← hspan, pow_two, Ideal.span_mul_span]
    congr 1
    ext z
    constructor
    · rintro ⟨u, ⟨p, rfl⟩, v, ⟨q, rfl⟩, rfl⟩
      exact ⟨(p, q), rfl⟩
    · rintro ⟨t, rfl⟩
      exact ⟨w t.1, ⟨t.1, rfl⟩, w t.2, ⟨t.2, rfl⟩, rfl⟩
  rw [hsq, Submodule.mem_span_range_iff_exists_fun] at hF
  obtain ⟨c, hc⟩ := hF
  refine ⟨fun p q => c (p, q), ?_⟩
  rw [← hc, Fintype.sum_prod_type]
  simp [smul_eq_mul]

/-- **The case II invariant as a quadratic expression**: `w₃² = w₁ Σ fₚᵩ wₚwᵩ`. -/
theorem HasDoubleLineRelation.exists_sum {w : Fin 3 → B} (h : HasDoubleLineRelation B w) :
    ∃ f : Fin 3 → Fin 3 → B, w 2 * w 2 = w 0 * ∑ p, ∑ q, f p q * (w p * w q) := by
  obtain ⟨hspan, F, hF, hsq⟩ := h
  obtain ⟨f, rfl⟩ := exists_eq_sum_of_mem_sq w hspan hF
  exact ⟨f, hsq⟩

/-- **The nondegenerate case II invariant as a quadratic expression**: `w₃² = w₁ Σ fₚᵩ wₚwᵩ`
with `f₂₂` a unit. -/
theorem HasDoubleLineRelationUnit.exists_sum {w : Fin 3 → B} (h : HasDoubleLineRelationUnit B w) :
    ∃ f : Fin 3 → Fin 3 → B, IsUnit (f 1 1) ∧ w 2 * w 2 = w 0 * ∑ p, ∑ q, f p q * (w p * w q) := by
  obtain ⟨hspan, F, f, hf, hFf, hsq⟩ := h
  obtain ⟨α, hα, β, hβ, hαβ⟩ := exists_eq_of_mem_span_pair_mul hFf
  rw [← hspan, Submodule.mem_span_range_iff_exists_fun] at hα hβ
  obtain ⟨a, rfl⟩ := hα
  obtain ⟨b, rfl⟩ := hβ
  refine ⟨![![a 0, a 1, a 2], ![0, f, 0], ![b 0, b 1, b 2]], by simpa using hf, ?_⟩
  rw [hsq]
  congr 1
  have hF : F = f * (w 1 * w 1) + (w 0 * ∑ i, a i • w i + w 2 * ∑ i, b i • w i) := by
    rw [← hαβ]; ring
  rw [hF]
  simp only [Fin.sum_univ_three, smul_eq_mul, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two, Matrix.tail_cons, Matrix.head_cons]
  ring

/-- The nondegenerate invariant implies the invariant. -/
theorem HasDoubleLineRelationUnit.hasDoubleLineRelation {w : Fin 3 → B}
    (h : HasDoubleLineRelationUnit B w) : HasDoubleLineRelation B w := by
  obtain ⟨f, -, hsq⟩ := h.exists_sum
  refine ⟨h.1, _, ?_, hsq⟩
  have hmem : ∀ i, w i ∈ maximalIdeal B := fun i => h.1 ▸ Ideal.subset_span ⟨i, rfl⟩
  rw [pow_two]
  exact Ideal.sum_mem _ fun p _ => Ideal.sum_mem _ fun q _ =>
    Ideal.mul_mem_left _ _ (Ideal.mul_mem_mul (hmem p) (hmem q))

end AlgebraicGeometry

