module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ChartPointGenerators
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.BlowUpResidueField
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.FormPolynomial

/-!
# A singular point of a blowup chart: the dehomogenized form lies in the square of the point

Let `(A, 𝔪, κ)` be a local ring with `𝔪 = (x₁, x₂, x₃)` and a quadratic relation
`Σ aₚᵩ xₚxᵩ ∈ 𝔪³`, let `A' = A[𝔪/x₁]` and let `𝔪'` be a maximal ideal of `A'` containing `𝔪A'`,
cut out in `κ[y₂, y₃]` by the maximal ideal `I` (through the presentation
`κ[y₂, y₃] ↠ A'/x₁A'`). The Claim of Section 54.12 of the source turns singularity of the local
ring `A'_{𝔪'}` into the membership

`q(1, y₂, y₃) = ā₁₁ + ā₁₂y₂ + ā₁₃y₃ + ā₂₂y₂² + ā₂₃y₂y₃ + ā₃₃y₃² ∈ I²`.

The argument: `q(1, y₂, y₃)` maps to zero in `A'/x₁A'`, and if it did not lie in `I²` it would be
part of a minimal system of generators `q(1, y₂, y₃), g` of `I`; then `𝔪' ⊆ (x₁, g̃) + 𝔪'²` for a
lift `g̃` of `g`, and by Nakayama's lemma the maximal ideal of `A'_{𝔪'}` would be generated by two
elements, so that `A'_{𝔪'}`, of dimension two, would be regular.

## Main results

* `AlgebraicGeometry.chartPresentation_dehomogenizeFirst_quadraticFormPoly_eq_zero`: the
  dehomogenized form maps to zero in `A'/x₁A'`.
* `AlgebraicGeometry.exists_le_span_pair_sup_sq_of_notMem_sq`: in a ring, an element of a
  maximal ideal generated by two elements but not of its square is part of a system of two
  generators modulo the square.
* `AlgebraicGeometry.dehomogenized_mem_sq_of_not_isRegularLocalRing`: **the Claim's input**.

## References

* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
-/

@[expose] public noncomputable section

open IsLocalRing

universe u

namespace AlgebraicGeometry

/-- An element `f = a p + b q` of a maximal ideal `I = (p, q)` with `a ∉ I` generates `I` together
with `q`, modulo `I²`. -/
theorem le_span_pair_sup_sq_of_eq_add {R : Type*} [CommRing R] {I : Ideal R} (hI : I.IsMaximal)
    {p q f a b : R} (hp : p ∈ I) (hspan : Ideal.span {p, q} = I) (hf : f = a * p + b * q)
    (ha : a ∉ I) : I ≤ Ideal.span {f, q} ⊔ I ^ 2 := by
  obtain ⟨u, t, ht, hut⟩ := hI.exists_inv ha
  refine hspan.symm.le.trans (Ideal.span_le.mpr ?_)
  rintro v (hv | hv)
  · rw [show v = p from hv,
      show p = u * f - u * b * q + t * p by linear_combination (-p) * hut - u * hf]
    refine Ideal.add_mem _ (Ideal.sub_mem _ ?_ ?_)
      (Ideal.mem_sup_right (by simpa only [pow_two] using Ideal.mul_mem_mul ht hp)) <;>
    exact Ideal.mem_sup_left (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
  · rw [show v = q from hv]
    exact Ideal.mem_sup_left (Ideal.subset_span (by simp))

/-- **An element of a maximal ideal generated by two elements, not in its square, is part of a
system of two generators modulo the square.** -/
theorem exists_le_span_pair_sup_sq_of_notMem_sq {R : Type*} [CommRing R] {I : Ideal R}
    (hI : I.IsMaximal) (h : Fin 2 → R) (hh : Ideal.span (Set.range h) = I) {f : R}
    (hf : f ∈ I) (hf2 : f ∉ I ^ 2) :
    ∃ g ∈ I, I ≤ Ideal.span {f, g} ⊔ I ^ 2 := by
  have hhI : ∀ i, h i ∈ I := fun i => hh ▸ Ideal.subset_span ⟨i, rfl⟩
  have hrange : Set.range h = {h 0, h 1} := by
    ext v
    simp [Fin.exists_fin_two, eq_comm]
  rw [hrange] at hh
  rw [← hh, Ideal.mem_span_pair] at hf
  obtain ⟨c0, c1, hc⟩ := hf
  by_cases h0 : c0 ∈ I
  · by_cases h1 : c1 ∈ I
    · refine absurd ?_ hf2
      rw [← hc, pow_two]
      exact Ideal.add_mem _ (Ideal.mul_mem_mul h0 (hhI 0)) (Ideal.mul_mem_mul h1 (hhI 1))
    · exact ⟨h 0, hhI 0, le_span_pair_sup_sq_of_eq_add hI (b := c0) (hhI 1)
        (by rw [Set.pair_comm, hh]) (by linear_combination -hc) h1⟩
  · exact ⟨h 1, hhI 1, le_span_pair_sup_sq_of_eq_add hI (hhI 0) hh hc.symm h0⟩

/-- **Nakayama's lemma at a maximal ideal.** If a finitely generated maximal ideal `M` satisfies
`M ⊆ (a, b) + M²` with `a, b ∈ M`, then the maximal ideal of `B_M` is generated by two elements. -/
theorem spanFinrank_maximalIdeal_localization_le_two_of_le_span_pair_sup_sq {B : Type*}
    [CommRing B] (M : Ideal B) [M.IsMaximal] (hfg : M.FG) {a b : B} (ha : a ∈ M) (hb : b ∈ M)
    (h : M ≤ Ideal.span {a, b} ⊔ M ^ 2) :
    (maximalIdeal (Localization.AtPrime M)).spanFinrank ≤ 2 := by
  set L := Localization.AtPrime M
  have hmL : maximalIdeal L = M.map (algebraMap B L) :=
    Localization.AtPrime.map_eq_maximalIdeal.symm
  have hfgL : (maximalIdeal L).FG := hmL ▸ hfg.map _
  have hle2 : maximalIdeal L ≤ Ideal.span {algebraMap B L a, algebraMap B L b} ⊔
      maximalIdeal L • maximalIdeal L := by
    rw [smul_eq_mul, ← pow_two, hmL, ← Ideal.map_pow]
    refine (Ideal.map_mono h).trans ?_
    rw [Ideal.map_sup, Ideal.map_span, Set.image_pair]
  have heq : maximalIdeal L = Ideal.span {algebraMap B L a, algebraMap B L b} := by
    refine le_antisymm (Submodule.le_of_le_smul_of_le_jacobson_bot hfgL
      (maximalIdeal_le_jacobson ⊥) hle2) ?_
    rw [Ideal.span_le, hmL]
    rintro _ (rfl | rfl)
    · exact Ideal.mem_map_of_mem _ ha
    · exact Ideal.mem_map_of_mem _ hb
  rw [heq]
  refine (Submodule.spanFinrank_span_le_ncard_of_finite (Set.toFinite _)).trans ?_
  exact (Set.ncard_insert_le _ _).trans (by rw [Set.ncard_singleton])

section Chart

variable {A : Type u} [CommRing A] [IsLocalRing A] {x : Fin 3 → A}
  (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away (x 0) S]

/-- **The dehomogenized quadratic form vanishes on the exceptional curve.** For a quadratic
relation `Σ aₚᵩ xₚxᵩ ∈ 𝔪³` among the generators, `q(1, y₂, y₃)` maps to zero in
`A[𝔪/x₁]/x₁A[𝔪/x₁]`. -/
theorem dehomogenizeFirst_quadraticFormPoly_mem_ker_chartPresentation
    (hx : ∀ i, x i ∈ maximalIdeal A) (a : Fin 3 → Fin 3 → A)
    (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3) :
    dehomogenizeFirst (ResidueField A) 2 (quadraticFormPoly fun p r => residue A (a p r)) ∈
      RingHom.ker (chartPresentation S hx) := by
  rw [RingHom.mem_ker, chartPresentation_dehomogenizeFirst_eq_mk_fraction S hx
    (isHomogeneous_quadraticFormPoly a) (map_quadraticFormPoly _ a),
    Ideal.Quotient.eq_zero_iff_mem]
  exact fraction_mem_span_singleton_of_mem_pow_succ S hx _ (by rwa [aeval_quadraticFormPoly])

/-- A maximal ideal `M` of `A[𝔪/x₁]` containing `𝔪A[𝔪/x₁]` is the preimage of its image in
`A[𝔪/x₁]/x₁A[𝔪/x₁]`. -/
private theorem comap_map_mk_span_singleton_eq
    (hx : ∀ i, x i ∈ maximalIdeal A) (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S))
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S))
      (maximalIdeal A) ≤ M) :
    (M.map (Ideal.Quotient.mk (Ideal.span
      {algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)}))).comap
        (Ideal.Quotient.mk (Ideal.span
          {algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)})) = M :=
  Ideal.comap_map_mk ((Ideal.span_singleton_le_iff_mem M).mpr (hle (Ideal.mem_map_of_mem _ (hx 0))))

/-- **A non-singular point of the exceptional curve gives a regular point of the chart.** Let
`𝔪'` be a maximal ideal of `A' = A[𝔪/x₁]` containing `𝔪A'`, cut out in `κ[y₂, y₃]` by the maximal
ideal `I` through the presentation `φ : κ[y₂, y₃] ↠ A'/x₁A'`. If some `f` in the kernel of `φ`
does not lie in `I²`, then the maximal ideal of `A'_{𝔪'}` is generated by two elements. -/
theorem spanFinrank_maximalIdeal_localization_le_two_of_notMem_sq
    (hx : ∀ i, x i ∈ maximalIdeal A) (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S)) [hM : M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S))
      (maximalIdeal A) ≤ M)
    {f : MvPolynomial (Fin 2) (ResidueField A)} (hf : f ∈ RingHom.ker (chartPresentation S hx))
    (hf2 : f ∉ ((M.map (Ideal.Quotient.mk (Ideal.span
      {algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)}))).comap
        (chartPresentation S hx)) ^ 2) :
    (maximalIdeal (Localization.AtPrime M)).spanFinrank ≤ 2 := by
  classical
  let B := affineBlowupAlgebra (maximalIdeal A) (x 0) S
  let K : Ideal B := Ideal.span {algebraMap A B (x 0)}
  let πQ : B →+* chartExceptionalQuotient (maximalIdeal A) (x 0) S := Ideal.Quotient.mk K
  have hπQ : Function.Surjective πQ := Ideal.Quotient.mk_surjective
  have hx0 : algebraMap A B (x 0) ∈ M := hle (Ideal.mem_map_of_mem _ (hx 0))
  have hcomap : (M.map πQ).comap πQ = M := comap_map_mk_span_singleton_eq S hx M hle
  let φ := chartPresentation S hx
  have hφ : Function.Surjective φ := chartPresentation_surjective S hx hspan
  have hMbar : (M.map πQ).IsMaximal := by
    refine (Ideal.map_eq_top_or_isMaximal_of_surjective πQ hπQ hM).resolve_left fun htop => ?_
    rw [htop, Ideal.comap_top] at hcomap
    exact hM.ne_top hcomap.symm
  set N := (M.map πQ).comap φ
  have hN : N.IsMaximal := Ideal.comap_isMaximal_of_surjective φ hφ
  obtain ⟨h, hh⟩ := maximal_ideal_generated_by_n 2 N hN
  have hfN : f ∈ N :=
    show φ f ∈ M.map πQ from (RingHom.mem_ker.mp hf).symm ▸ Ideal.zero_mem _
  obtain ⟨g, hgN, hgle⟩ := exists_le_span_pair_sup_sq_of_notMem_sq hN h hh hfN hf2
  obtain ⟨ζ, hζ⟩ := hπQ (φ g)
  have hMle : M ≤ Ideal.span {algebraMap A B (x 0), ζ} ⊔ M ^ 2 := by
    intro m hm
    have hmbar : πQ m ∈ M.map πQ := Ideal.mem_map_of_mem _ hm
    rw [← Ideal.map_comap_of_surjective φ hφ (M.map πQ)] at hmbar
    obtain ⟨n, hn, hnm⟩ := (Ideal.mem_map_iff_of_surjective φ hφ).mp hmbar
    obtain ⟨y, hy, s, hs, rfl⟩ := Submodule.mem_sup.mp (hgle hn)
    obtain ⟨α, β, rfl⟩ := Ideal.mem_span_pair.mp hy
    have hφs : φ s ∈ (M ^ 2).map πQ := by
      rw [Ideal.map_pow, ← Ideal.map_comap_of_surjective φ hφ (M.map πQ), ← Ideal.map_pow]
      exact Ideal.mem_map_of_mem φ hs
    obtain ⟨s', hs', hs's⟩ := (Ideal.mem_map_iff_of_surjective πQ hπQ).mp hφs
    obtain ⟨β', hβ'⟩ := hπQ (φ β)
    have hdiff : m - (β' * ζ + s') ∈ RingHom.ker πQ := by
      rw [RingHom.mem_ker, map_sub, map_add, map_mul, hβ', hζ, hs's, ← hnm, map_add, map_add,
        map_mul, map_mul, RingHom.mem_ker.mp hf]
      ring
    rw [Ideal.mk_ker] at hdiff
    rw [show m = (m - (β' * ζ + s')) + β' * ζ + s' by ring]
    refine Ideal.add_mem _ (Ideal.add_mem _ ?_ ?_) (Ideal.mem_sup_right hs')
    · exact Ideal.mem_sup_left (Ideal.span_mono (by simp) hdiff)
    · exact Ideal.mem_sup_left (Ideal.mul_mem_left _ _ (Ideal.subset_span (by simp)))
  obtain ⟨g3, hg3⟩ := exists_span_eq_of_isMaximal_affineBlowupAlgebra S hx hspan M hle
  exact spanFinrank_maximalIdeal_localization_le_two_of_le_span_pair_sup_sq M
    (hg3 ▸ Submodule.fg_span (Set.finite_range _)) hx0
    (by rwa [← hcomap, Ideal.mem_comap, hζ]) hMle

/-- **The Claim's input: at a singular point of the chart the dehomogenized form lies in the
square of the point.** Let `𝔪'` be a maximal ideal of `A[𝔪/x₁]` containing `𝔪A[𝔪/x₁]` at which
the local ring is Noetherian of dimension two and not regular. Then
`q(1, y₂, y₃) ∈ I²`, where `I ⊆ κ[y₂, y₃]` is the maximal ideal `𝔪'` defines. -/
theorem dehomogenizeFirst_quadraticFormPoly_mem_sq_of_not_isRegularLocalRing
    (hx : ∀ i, x i ∈ maximalIdeal A) (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (a : Fin 3 → Fin 3 → A) (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3)
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S)) [hM : M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S))
      (maximalIdeal A) ≤ M)
    [IsNoetherianRing (Localization.AtPrime M)]
    (hdim : ringKrullDim (Localization.AtPrime M) = 2)
    (hsing : ¬ IsRegularLocalRing (Localization.AtPrime M)) :
    dehomogenizeFirst (ResidueField A) 2 (quadraticFormPoly fun p r => residue A (a p r)) ∈
      ((M.map (Ideal.Quotient.mk (Ideal.span
        {algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)}))).comap
          (chartPresentation S hx)) ^ 2 := by
  by_contra h
  refine hsing (IsRegularLocalRing.of_spanFinrank_maximalIdeal_le _ ?_)
  rw [hdim]
  exact_mod_cast spanFinrank_maximalIdeal_localization_le_two_of_notMem_sq S hx hspan M hle
    (dehomogenizeFirst_quadraticFormPoly_mem_ker_chartPresentation S hx a hrel) h

/-- **A point of the chart whose ideal in `κ[y₂, y₃]` has residue field `κ` has residue field
`κ`.** If `κ → κ[y₂, y₃]/I` is surjective, where `I` is the maximal ideal of `κ[y₂, y₃]` defined
by a maximal ideal `𝔪'` of `A[𝔪/x₁]` containing `𝔪A[𝔪/x₁]`, then `A → A[𝔪/x₁]/𝔪'` is
surjective. -/
theorem surjective_algebraMap_quotient_of_surjective_chartPoint
    (hx : ∀ i, x i ∈ maximalIdeal A) (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S))
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S))
      (maximalIdeal A) ≤ M)
    (hsurj : Function.Surjective (algebraMap (ResidueField A)
      (MvPolynomial (Fin 2) (ResidueField A) ⧸
        ((M.map (Ideal.Quotient.mk (Ideal.span
          {algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)}))).comap
            (chartPresentation S hx))))) :
    Function.Surjective ((Ideal.Quotient.mk M).comp
      (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S))) := by
  let B := affineBlowupAlgebra (maximalIdeal A) (x 0) S
  let πQ : B →+* chartExceptionalQuotient (maximalIdeal A) (x 0) S :=
    Ideal.Quotient.mk (Ideal.span {algebraMap A B (x 0)})
  have hcomap : (M.map πQ).comap πQ = M := comap_map_mk_span_singleton_eq S hx M hle
  intro b
  obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective b
  obtain ⟨P, hP⟩ := chartPresentation_surjective S hx hspan (πQ b)
  obtain ⟨c, hc⟩ := hsurj (Ideal.Quotient.mk _ P)
  obtain ⟨r, rfl⟩ := residue_surjective c
  refine ⟨r, ?_⟩
  simp only [RingHom.coe_comp, Function.comp_apply]
  rw [Ideal.Quotient.eq, ← hcomap, Ideal.mem_comap, map_sub]
  show πQ _ - πQ b ∈ _
  rw [← hP]
  have h1 : MvPolynomial.C (residue A r) - P ∈
      (M.map πQ).comap (chartPresentation S hx) := by
    rw [← Ideal.Quotient.eq, ← hc]
    rfl
  rw [Ideal.mem_comap, map_sub] at h1
  have hC : chartPresentation S hx (MvPolynomial.C (residue A r)) = πQ (algebraMap A B r) := by
    rw [chartPresentation, MvPolynomial.eval₂Hom_C, chartResidue_residue]
  rwa [← hC]

/-- **The Claim of Section 54.12 on a chart: in case I a singular point of the exceptional
curve has residue field `κ`.** If the quadratic form is not a scalar times the square of a linear
form and `q(1, y₂, y₃)` lies in the square of the maximal ideal of `κ[y₂, y₃]` defined by a
maximal ideal `𝔪'` of `A[𝔪/x₁]` containing `𝔪A[𝔪/x₁]`, then `A → A[𝔪/x₁]/𝔪'` is surjective. -/
theorem surjective_algebraMap_quotient_of_not_isScalarSqLinear_of_mem_sq
    (hx : ∀ i, x i ∈ maximalIdeal A) (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (a : Fin 3 → Fin 3 → A) (hupper : ∀ p r, r < p → a p r = 0)
    (hunit : ∃ p r, p ≤ r ∧ a p r ∉ maximalIdeal A)
    (hcase : ¬ IsScalarSqLinear fun p r => residue A (a p r))
    (M : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S)) [hM : M.IsMaximal]
    (hle : Ideal.map (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S))
      (maximalIdeal A) ≤ M)
    (hmem : dehomogenizeFirst (ResidueField A) 2 (quadraticFormPoly fun p r => residue A (a p r)) ∈
      ((M.map (Ideal.Quotient.mk (Ideal.span
        {algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)}))).comap
          (chartPresentation S hx)) ^ 2) :
    Function.Surjective ((Ideal.Quotient.mk M).comp
      (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S))) := by
  let B := affineBlowupAlgebra (maximalIdeal A) (x 0) S
  let πQ : B →+* chartExceptionalQuotient (maximalIdeal A) (x 0) S :=
    Ideal.Quotient.mk (Ideal.span {algebraMap A B (x 0)})
  have hcomap : (M.map πQ).comap πQ = M := comap_map_mk_span_singleton_eq S hx M hle
  have hNtop : (M.map πQ).comap (chartPresentation S hx) ≠ ⊤ :=
    Ideal.comap_ne_top _ fun h => hM.ne_top (by rw [← hcomap, h, Ideal.comap_top])
  have hup : ∀ p r, r < p → residue A (a p r) = 0 := fun p r hrp => by
    simp [hupper p r hrp]
  rw [dehomogenizeFirst_quadraticFormPoly_fin_three _ hup] at hmem
  refine surjective_algebraMap_quotient_of_surjective_chartPoint S hx hspan M hle
    (bijective_algebraMap_quotient_of_not_isScalarSqLinear (fun p r => residue A (a p r))
      hup ?_ hcase _ hNtop hmem).2
  obtain ⟨p, r, hpr, hne⟩ := hunit
  exact ⟨p, r, hpr, mt (residue_eq_zero_iff _).mp hne⟩

end Chart

end AlgebraicGeometry

end
