-/

@[expose] public noncomputable section

open IsLocalRing MvPolynomial

universe u

namespace AlgebraicGeometry

/-! ### Elements of an affine blowup chart -/

section General

variable {R : Type*} [CommRing R] {S : Type*} [CommRing S] [Algebra R S]

/-- Every element of the subalgebra `R[I/a]` of a localization `S` becomes the image of an
element of `Iᵏ` after multiplication by `aᵏ`, for some `k`. The generators `y/a`, `y ∈ I`, have
`k = 1`, and a sum and a product of two such elements are handled by adding the exponents. -/
public theorem exists_pow_mul_eq_algebraMap_of_mem_affineBlowupAlgebra (I : Ideal R) (a : R)
    [IsLocalization.Away a S] (ha : a ∈ I) {z : S} (hz : z ∈ affineBlowupAlgebra I a S) :
    ∃ (k : ℕ) (u : R), u ∈ I ^ k ∧ algebraMap R S a ^ k * z = algebraMap R S u := by
  induction hz using Algebra.adjoin_induction with
  | mem w hw =>
      obtain ⟨y, hy, rfl⟩ := hw
      refine ⟨1, y, by simpa using hy, ?_⟩
      rw [pow_one, mul_comm]
      exact IsLocalization.mk'_spec S y ⟨a, Submonoid.mem_powers a⟩
  | algebraMap r => exact ⟨0, r, by simp, by simp⟩
  | add u v hu hv Hu Hv =>
      obtain ⟨k₁, u₁, h₁, e₁⟩ := Hu
      obtain ⟨k₂, u₂, h₂, e₂⟩ := Hv
      refine ⟨k₁ + k₂, a ^ k₂ * u₁ + a ^ k₁ * u₂, add_mem ?_ ?_, ?_⟩
      · rw [pow_add, mul_comm (I ^ k₁)]
        exact Ideal.mul_mem_mul (Ideal.pow_mem_pow ha k₂) h₁
      · rw [pow_add]
        exact Ideal.mul_mem_mul (Ideal.pow_mem_pow ha k₁) h₂
      · rw [map_add, map_mul, map_mul, map_pow, map_pow, pow_add]
        rw [show algebraMap R S a ^ k₁ * algebraMap R S a ^ k₂ * (u + v)
            = algebraMap R S a ^ k₂ * (algebraMap R S a ^ k₁ * u)
              + algebraMap R S a ^ k₁ * (algebraMap R S a ^ k₂ * v) from by ring,
          e₁, e₂]
  | mul u v hu hv Hu Hv =>
      obtain ⟨k₁, u₁, h₁, e₁⟩ := Hu
      obtain ⟨k₂, u₂, h₂, e₂⟩ := Hv
      refine ⟨k₁ + k₂, u₁ * u₂, ?_, ?_⟩
      · rw [pow_add]
        exact Ideal.mul_mem_mul h₁ h₂
      · rw [map_mul, pow_add]
        rw [show algebraMap R S a ^ k₁ * algebraMap R S a ^ k₂ * (u * v)
            = (algebraMap R S a ^ k₁ * u) * (algebraMap R S a ^ k₂ * v) from by ring, e₁, e₂]

/-- The same statement inside the subalgebra `R[I/a]` itself. -/
public theorem exists_pow_mul_eq_algebraMap (I : Ideal R) (a : R) [IsLocalization.Away a S]
    (ha : a ∈ I) (z : affineBlowupAlgebra I a S) :
    ∃ (k : ℕ) (u : R), u ∈ I ^ k ∧
      algebraMap R (affineBlowupAlgebra I a S) a ^ k * z =
        algebraMap R (affineBlowupAlgebra I a S) u := by
  obtain ⟨k, u, hu, he⟩ :=
    exists_pow_mul_eq_algebraMap_of_mem_affineBlowupAlgebra (S := S) I a ha z.2
  exact ⟨k, u, hu, Subtype.ext (by simpa using he)⟩

/-- The coordinate ring of the exceptional divisor on the affine blowup chart `R[I/a]`: the
quotient of `R[I/a]` by the ideal generated by the image of `a`, which for `a ∈ I` is the
extension of `I` by `affineBlowupAlgebra.map_ideal_eq_span_singleton`. -/
public abbrev chartExceptionalQuotient (I : Ideal R) (a : R) (S : Type*) [CommRing S]
    [Algebra R S] [IsLocalization.Away a S] : Type _ :=
  affineBlowupAlgebra I a S ⧸ Ideal.span {algebraMap R (affineBlowupAlgebra I a S) a}

end General

/-! ### Superficial elements and powers -/

section Superficial

variable {A : Type u} [CommRing A] [IsLocalRing A]

/-- **A superficial element divides down powers of itself.** If multiplication by `a` is
injective on the associated graded module of the maximal-ideal filtration, then `aᴹv ∈ 𝔪ⁿ⁺ᴹ⁺¹`
and `v ∈ 𝔪ⁿ` force `v ∈ 𝔪ⁿ⁺¹`. -/
public theorem mem_pow_succ_of_pow_mul_mem_pow {a : A} (ha : a ∈ maximalIdeal A)
    (hsup : ∀ (m : ℕ) (w : A), w ∈ maximalIdeal A ^ m →
      a * w ∈ maximalIdeal A ^ (m + 2) → w ∈ maximalIdeal A ^ (m + 1))
    (n : ℕ) : ∀ (M : ℕ) (v : A), v ∈ maximalIdeal A ^ n →
      a ^ M * v ∈ maximalIdeal A ^ (n + M + 1) → v ∈ maximalIdeal A ^ (n + 1) := by
  intro M
  induction M with
  | zero => intro v _ h; simpa using h
  | succ M ih =>
      intro v hv hmul
      refine ih v hv (hsup (n + M) (a ^ M * v) ?_ ?_)
      · have h := Ideal.mul_mem_mul (Ideal.pow_mem_pow ha M) hv
        rw [← pow_add] at h
        rwa [Nat.add_comm n M]
      · rw [← mul_assoc, ← pow_succ', show n + M + 2 = n + (M + 1) + 1 from by omega]
        exact hmul

end Superficial

/-! ### The chart of a blowup at a generator of the maximal ideal -/

section Chart

variable {A : Type u} [CommRing A] [IsLocalRing A] {x : Fin 3 → A}
  (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away (x 0) S]

/-- **The affine blowup chart is generated by the fractions `xᵢ/x₁`.** The chart is generated by
all the fractions `y/x₁` with `y ∈ 𝔪`, and writing `y = ∑ cᵢxᵢ` in the generators of `𝔪`
expresses `y/x₁ = ∑ cᵢ(xᵢ/x₁)`. -/
public theorem adjoin_range_chartFraction_eq (hx : ∀ i, x i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A) :
    Algebra.adjoin A (Set.range fun i => (chartFraction S hx i : S))
      = affineBlowupAlgebra (maximalIdeal A) (x 0) S := by
  refine le_antisymm (Algebra.adjoin_le ?_) (Algebra.adjoin_le ?_)
  · rintro _ ⟨i, rfl⟩
    exact (chartFraction S hx i).2
  · rintro z ⟨y, hy, rfl⟩
    have hcf : ∀ i, algebraMap A S (x 0) * (chartFraction S hx i : S) = algebraMap A S (x i) :=
      fun i => congrArg Subtype.val (algebraMap_mul_chartFraction S hx i)
    rw [← hspan, Ideal.span, Submodule.mem_span_range_iff_exists_fun] at hy
    obtain ⟨c, hc⟩ := hy
    have hkey : IsLocalization.mk' S y ⟨x 0, Submonoid.mem_powers (x 0)⟩
        = ∑ i, algebraMap A S (c i) * (chartFraction S hx i : S) := by
      refine (IsLocalization.Away.algebraMap_isUnit (S := S) (x 0)).mul_left_cancel ?_
      rw [IsLocalization.mk'_spec' S y ⟨x 0, Submonoid.mem_powers (x 0)⟩, ← hc,
        map_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [smul_eq_mul, map_mul, ← hcf i]
      ring
    rw [hkey]
    exact sum_mem fun i _ => mul_mem (Subalgebra.algebraMap_mem _ _)
      (Algebra.subset_adjoin ⟨i, rfl⟩)

/-- **The affine blowup chart is generated by the fractions `xᵢ/x₁`**, as a statement about
subalgebras of the chart itself. -/
public theorem adjoin_range_chartFraction_eq_top (hx : ∀ i, x i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A) :
    Algebra.adjoin A (Set.range (chartFraction S hx)) = ⊤ := by
  refine Subalgebra.map_injective
    (f := (affineBlowupAlgebra (maximalIdeal A) (x 0) S).val) Subtype.val_injective ?_
  rw [← Algebra.adjoin_image, Algebra.map_top, Subalgebra.range_val, ← Set.range_comp]
  exact adjoin_range_chartFraction_eq S hx hspan

/-- An element of the chart which becomes the image of `v ∈ 𝔪ⁿ` after multiplication by `x₁ⁿ` is
the fraction `v/x₁ⁿ`, since `x₁ⁿ` is a nonzerodivisor on the chart. -/
private theorem eq_fraction_of_algebraMap_pow_mul_eq {n : ℕ} {v : ↥(maximalIdeal A ^ n)}
    {z : affineBlowupAlgebra (maximalIdeal A) (x 0) S}
    (h : algebraMap A _ (x 0) ^ n * z = algebraMap A _ (v : A)) :
    z = affineBlowupAlgebra.fraction (S := S) (maximalIdeal A) (x 0) n v :=
  ((Stacks.Blowup.isRegular_algebraMap_affineBlowupAlgebra (maximalIdeal A) (x 0) S).left.pow n)
    (h.trans (affineBlowupAlgebra.algebraMap_pow_mul_fraction _ _ n v).symm)

/-- **A homogeneous polynomial of degree `n` evaluated at the fractions `xᵢ/x₁` is the fraction
`Q(x₁, x₂, x₃)/x₁ⁿ`.** Both sides are compared after multiplication by `x₁ⁿ`, which is a
nonzerodivisor on the chart. -/
public theorem aeval_chartFraction_eq_fraction (hx : ∀ i, x i ∈ maximalIdeal A) {n : ℕ}
    {Q : MvPolynomial (Fin 3) A} (hQ : Q.IsHomogeneous n) :
    MvPolynomial.aeval (chartFraction S hx) Q
      = affineBlowupAlgebra.fraction (S := S) (maximalIdeal A) (x 0) n
          ⟨MvPolynomial.aeval x Q, aeval_mem_pow (maximalIdeal A) hx hQ⟩ := by
  refine eq_fraction_of_algebraMap_pow_mul_eq S ?_
  rw [← aeval_mul_of_isHomogeneous hQ,
    show (fun i => algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0) *
          chartFraction S hx i)
        = fun i => algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x i) from
      funext fun i => algebraMap_mul_chartFraction S hx i]
  exact (MvPolynomial.comp_aeval_apply (f := x)
    (φ := Algebra.ofId A (affineBlowupAlgebra (maximalIdeal A) (x 0) S)) Q).symm

/-- For `v ∈ 𝔪ⁿ⁺¹` the fraction `v/x₁ⁿ` lies in `x₁·A[𝔪/x₁]`: it is `x₁` times `v/x₁ⁿ⁺¹`. -/
public theorem fraction_mem_span_singleton_of_mem_pow_succ (_hx : ∀ i, x i ∈ maximalIdeal A)
    {n : ℕ} {v : A} (hv : v ∈ maximalIdeal A ^ n) (hv' : v ∈ maximalIdeal A ^ (n + 1)) :
    affineBlowupAlgebra.fraction (S := S) (maximalIdeal A) (x 0) n ⟨v, hv⟩ ∈
      Ideal.span {algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)} := by
  refine Ideal.mem_span_singleton.mpr
    ⟨affineBlowupAlgebra.fraction (S := S) (maximalIdeal A) (x 0) (n + 1) ⟨v, hv'⟩, ?_⟩
  refine (eq_fraction_of_algebraMap_pow_mul_eq S ?_).symm
  rw [← mul_assoc, ← pow_succ, affineBlowupAlgebra.algebraMap_pow_mul_fraction]

/-- **The converse for a superficial `x₁`:** the fraction `v/x₁ⁿ` of `v ∈ 𝔪ⁿ` lies in
`x₁·A[𝔪/x₁]` only if `v ∈ 𝔪ⁿ⁺¹`.

Membership gives `v/x₁ⁿ = x₁z` for some `z` in the chart, and `x₁ᵏz` is the image of an element
of `𝔪ᵏ` for some `k`; comparing the two in the ambient localization produces `N` with
`x₁^(N+k)v ∈ 𝔪ⁿ⁺ᴺ⁺ᵏ⁺¹`, which `AlgebraicGeometry.mem_pow_succ_of_pow_mul_mem_pow` reduces to
the assertion. -/
public theorem mem_pow_succ_of_fraction_mem_span_singleton (hx : ∀ i, x i ∈ maximalIdeal A)
    (hsup : ∀ (m : ℕ) (w : A), w ∈ maximalIdeal A ^ m →
      x 0 * w ∈ maximalIdeal A ^ (m + 2) → w ∈ maximalIdeal A ^ (m + 1))
    {n : ℕ} {v : A} (hv : v ∈ maximalIdeal A ^ n)
    (hmem : affineBlowupAlgebra.fraction (S := S) (maximalIdeal A) (x 0) n ⟨v, hv⟩ ∈
      Ideal.span {algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)}) :
    v ∈ maximalIdeal A ^ (n + 1) := by
  obtain ⟨z, hz⟩ := Ideal.mem_span_singleton.mp hmem
  obtain ⟨k, u, hu, he⟩ :=
    exists_pow_mul_eq_algebraMap (S := S) (maximalIdeal A) (x 0) (hx 0) z
  have h0 : algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) v
      = algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0) ^ n *
        affineBlowupAlgebra.fraction (S := S) (maximalIdeal A) (x 0) n ⟨v, hv⟩ :=
    (affineBlowupAlgebra.algebraMap_pow_mul_fraction (maximalIdeal A) (x 0) n ⟨v, hv⟩).symm
  have hA : algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0 ^ k * v)
      = algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0 ^ (n + 1) * u) := by
    rw [map_mul, map_mul, map_pow, map_pow, ← he, h0, hz]
    ring
  have hS : algebraMap A S (x 0 ^ k * v) = algebraMap A S (x 0 ^ (n + 1) * u) := by
    simpa using
      congrArg (fun w : affineBlowupAlgebra (maximalIdeal A) (x 0) S => (w : S)) hA
  obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers (x 0)) S).mp hS
  obtain ⟨N, hN⟩ := c.2
  rw [← hN] at hc
  have h1 : x 0 ^ (N + k) * v = x 0 ^ (N + n + 1) * u :=
    calc x 0 ^ (N + k) * v = x 0 ^ N * (x 0 ^ k * v) := by rw [pow_add, mul_assoc]
      _ = x 0 ^ N * (x 0 ^ (n + 1) * u) := hc
      _ = x 0 ^ (N + n + 1) * u := by rw [← mul_assoc, ← pow_add, ← Nat.add_assoc]
  refine mem_pow_succ_of_pow_mul_mem_pow (hx 0) hsup n (N + k) v hv ?_
  rw [show n + (N + k) + 1 = N + n + 1 + k from by omega, h1, pow_add]
  exact Ideal.mul_mem_mul (Ideal.pow_mem_pow (hx 0) _) hu

/-! ### The presentation of the chart quotient -/

/-- **The residue field acts on the chart quotient.** The composite `A → A[𝔪/x₁] → A[𝔪/x₁]/x₁`
kills `𝔪`, because `𝔪·A[𝔪/x₁] = x₁·A[𝔪/x₁]`. -/
public def chartResidue (hx : ∀ i, x i ∈ maximalIdeal A) :
    ResidueField A →+* chartExceptionalQuotient (maximalIdeal A) (x 0) S :=
  Ideal.Quotient.lift (maximalIdeal A)
    ((Ideal.Quotient.mk _).comp (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S)))
    fun y hy => Ideal.Quotient.eq_zero_iff_mem.mpr (by
      rw [← affineBlowupAlgebra.map_ideal_eq_span_singleton (maximalIdeal A) (x 0) (hx 0)]
      exact Ideal.mem_map_of_mem _ hy)

@[simp]
public theorem chartResidue_residue (hx : ∀ i, x i ∈ maximalIdeal A) (r : A) :
    chartResidue S hx (IsLocalRing.residue A r)
      = Ideal.Quotient.mk _ (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) r) :=
  rfl

public theorem chartResidue_comp_residue (hx : ∀ i, x i ∈ maximalIdeal A) :
    (chartResidue S hx).comp (IsLocalRing.residue A)
      = (Ideal.Quotient.mk (Ideal.span
            {algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)})).comp
          (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S)) :=
  RingHom.ext fun _ => rfl

/-- **The presentation of the chart quotient.** The ring map
`κ[y₂, y₃] → A[𝔪/x₁]/x₁·A[𝔪/x₁]` over the residue field which sends `yₚ` to the class of the
fraction `xₚ/x₁`. -/
public def chartPresentation (hx : ∀ i, x i ∈ maximalIdeal A) :
    MvPolynomial (Fin 2) (ResidueField A) →+*
      chartExceptionalQuotient (maximalIdeal A) (x 0) S :=
  MvPolynomial.eval₂Hom (chartResidue S hx)
    fun p => Ideal.Quotient.mk _ (chartFraction S hx p.succ)

/-- **Dehomogenizing and then evaluating on the chart is evaluating at the fractions.** The
point `(1, y₂, y₃)` of the chart is the point `(x₁/x₁, x₂/x₁, x₃/x₁)`. -/
public theorem chartPresentation_dehomogenizeFirst (hx : ∀ i, x i ∈ maximalIdeal A)
    (P : MvPolynomial (Fin 3) (ResidueField A)) :
    chartPresentation S hx (dehomogenizeFirst (ResidueField A) 2 P)
      = MvPolynomial.eval₂Hom (chartResidue S hx)
          (fun i => Ideal.Quotient.mk _ (chartFraction S hx i)) P := by
  have h : (chartPresentation S hx).comp
        (dehomogenizeFirst (ResidueField A) 2).toRingHom
      = MvPolynomial.eval₂Hom (chartResidue S hx)
          (fun i => Ideal.Quotient.mk _ (chartFraction S hx i)) := by
    refine MvPolynomial.ringHom_ext (fun c => ?_) (fun i => ?_)
    · simp [chartPresentation]
    · refine Fin.cases ?_ (fun p => ?_) i
      · simp [chartPresentation, chartFraction_zero]
      · simp [chartPresentation]
  exact RingHom.congr_fun h P

/-- **The chart presentation on a homogeneous polynomial.** If `Q` is a homogeneous lift of
degree `n` of `P`, the presentation sends the dehomogenization of `P` to the class of the
fraction `Q(x₁, x₂, x₃)/x₁ⁿ`. -/
public theorem chartPresentation_dehomogenizeFirst_eq_mk_fraction
    (hx : ∀ i, x i ∈ maximalIdeal A) {n : ℕ} {P : MvPolynomial (Fin 3) (ResidueField A)}
    {Q : MvPolynomial (Fin 3) A} (hQ : Q.IsHomogeneous n)
    (hmap : MvPolynomial.map (IsLocalRing.residue A) Q = P) :
    chartPresentation S hx (dehomogenizeFirst (ResidueField A) 2 P)
      = Ideal.Quotient.mk _ (affineBlowupAlgebra.fraction (S := S) (maximalIdeal A) (x 0) n
          ⟨MvPolynomial.aeval x Q, aeval_mem_pow (maximalIdeal A) hx hQ⟩) := by
  subst hmap
  rw [chartPresentation_dehomogenizeFirst, MvPolynomial.eval₂Hom_map_hom,
    chartResidue_comp_residue, ← aeval_chartFraction_eq_fraction S hx hQ]
  exact (MvPolynomial.map_aeval (chartFraction S hx)
    (Ideal.Quotient.mk (Ideal.span
      {algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)})) Q).symm

/-- **The chart quotient is generated by `ȳ₂` and `ȳ₃` over the residue field:** the
presentation is surjective. -/
public theorem chartPresentation_surjective (hx : ∀ i, x i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A) :
    Function.Surjective (chartPresentation S hx) := by
  intro b
  obtain ⟨z, rfl⟩ := Ideal.Quotient.mk_surjective b
  have hz : z ∈ Algebra.adjoin A (Set.range (chartFraction S hx)) := by
    rw [adjoin_range_chartFraction_eq_top S hx hspan]; trivial
  induction hz using Algebra.adjoin_induction with
  | mem w hw =>
      obtain ⟨i, rfl⟩ := hw
      refine Fin.cases ?_ (fun p => ⟨MvPolynomial.X p, by simp [chartPresentation]⟩) i
      exact ⟨1, by rw [map_one, chartFraction_zero, map_one]⟩
  | algebraMap r =>
      exact ⟨MvPolynomial.C (IsLocalRing.residue A r), by simp [chartPresentation]⟩
  | add u v hu hv Hu Hv =>
      obtain ⟨p, hp⟩ := Hu
      obtain ⟨q, hq⟩ := Hv
      exact ⟨p + q, by simp [hp, hq]⟩
  | mul u v hu hv Hu Hv =>
      obtain ⟨p, hp⟩ := Hu
      obtain ⟨q, hq⟩ := Hv
      exact ⟨p * q, by simp [hp, hq]⟩

/-- **The kernel of the chart presentation is the dehomogenized relation ideal.**

The inclusion `⊇` is formal: a homogeneous relation of degree `n` lifts to `Q` with
`Q(x₁, x₂, x₃) ∈ 𝔪ⁿ⁺¹`, whose fraction over `x₁ⁿ` lies in `x₁·A[𝔪/x₁]`. The inclusion `⊆` is
superficiality of `x₁`, which is the hypothesis `hsup`: an element of the kernel is the
dehomogenization of a homogeneous `P`, and superficiality turns the vanishing of the fraction in
the chart quotient into `Q(x₁, x₂, x₃) ∈ 𝔪ⁿ⁺¹`, so that `P` is a relation. -/
public theorem ker_chartPresentation (hx : ∀ i, x i ∈ maximalIdeal A)
    (hsup : ∀ (m : ℕ) (w : A), w ∈ maximalIdeal A ^ m →
      x 0 * w ∈ maximalIdeal A ^ (m + 2) → w ∈ maximalIdeal A ^ (m + 1)) :
    RingHom.ker (chartPresentation S hx)
      = Ideal.map (dehomogenizeFirst (ResidueField A) 2) (gradedRelationIdeal hx) := by
  have hmapQ : ∀ (n : ℕ) {P : MvPolynomial (Fin 3) (ResidueField A)}, P.IsHomogeneous n →
      MvPolynomial.map (IsLocalRing.residue A) (homogeneousResidueLift n P) = P := fun n P hP =>
    (map_homogeneousResidueLift n P).trans (MvPolynomial.homogeneousComponent_eq_self hP)
  refine le_antisymm (fun f hf => ?_) ?_
  · obtain ⟨n, P, hP, hPf⟩ := exists_isHomogeneous_dehomogenizeFirst_eq (ResidueField A) f
    have hQ := isHomogeneous_homogeneousResidueLift (A := A) n P
    have hzero : chartPresentation S hx (dehomogenizeFirst (ResidueField A) 2 P) = 0 := by
      rw [hPf]; exact RingHom.mem_ker.mp hf
    rw [chartPresentation_dehomogenizeFirst_eq_mk_fraction S hx hQ (hmapQ n hP),
      Ideal.Quotient.eq_zero_iff_mem] at hzero
    have hv := mem_pow_succ_of_fraction_mem_span_singleton S hx hsup _ hzero
    rw [← hPf]
    exact Ideal.mem_map_of_mem _ (mem_gradedRelationIdeal_of_isHomogeneous hx hP
      ((evalGradedPieceFun_eq_zero_iff hx hQ
        (by rw [hmapQ n hP, MvPolynomial.homogeneousComponent_eq_self hP])).mpr hv))
  · rw [Ideal.map_le_iff_le_comap, gradedRelationIdeal, Ideal.span_le]
    rintro P ⟨n, hP, hPzero⟩
    simp only [SetLike.mem_coe, Ideal.mem_comap, RingHom.mem_ker]
    have hQ := isHomogeneous_homogeneousResidueLift (A := A) n P
    rw [chartPresentation_dehomogenizeFirst_eq_mk_fraction S hx hQ (hmapQ n hP),
      Ideal.Quotient.eq_zero_iff_mem]
    exact fraction_mem_span_singleton_of_mem_pow_succ S hx _
      ((evalGradedPieceFun_eq_zero_iff hx hQ (map_homogeneousResidueLift n P)).mp hPzero)

/-- **The chart identification of Section 54.12.** The chart quotient
`A[𝔪/x₁]/x₁·A[𝔪/x₁]` is `κ[y₂, y₃]` modulo the dehomogenized relation ideal. -/
public def chartQuotientEquiv (hx : ∀ i, x i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (hsup : ∀ (m : ℕ) (w : A), w ∈ maximalIdeal A ^ m →
      x 0 * w ∈ maximalIdeal A ^ (m + 2) → w ∈ maximalIdeal A ^ (m + 1)) :
    MvPolynomial (Fin 2) (ResidueField A) ⧸
        Ideal.map (dehomogenizeFirst (ResidueField A) 2) (gradedRelationIdeal hx)
      ≃+* chartExceptionalQuotient (maximalIdeal A) (x 0) S :=
  (Ideal.quotEquivOfEq (ker_chartPresentation S hx hsup).symm).trans
    (RingHom.quotientKerEquivOfSurjective (chartPresentation_surjective S hx hspan))

/-! ### The chart of a rational double point at a good coordinate -/

/-- **The kernel of the chart presentation of a rational double point is generated by the
dehomogenized quadratic form.** -/
public theorem ker_chartPresentation_eq_span_singleton [IsNoetherianRing A]
    (hx : ∀ i, x i ∈ maximalIdeal A) (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (hdim : ∀ n, Module.finrank (ResidueField A) (IsLocalRing.gradedPiece A n) = 2 * n + 1)
    (a : Fin 3 → Fin 3 → A) (hupper : ∀ p r, r < p → a p r = 0)
    (hunit : ∃ p r, p ≤ r ∧ a p r ∉ maximalIdeal A)
    (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3)
    (hgood : IsGoodCoordinateForm fun p r => IsLocalRing.residue A (a p r)) :
    RingHom.ker (chartPresentation S hx)
      = Ideal.span {dehomogenizeFirst (ResidueField A) 2
          (quadraticFormPoly fun p r => IsLocalRing.residue A (a p r))} := by
  rw [ker_chartPresentation S hx (fun m w hw hmul =>
      mem_pow_succ_of_mul_mem_pow_of_isGoodCoordinateForm hx hspan hdim a hupper hunit hrel
        hgood hw hmul),
    map_dehomogenizeFirst_eq_span_singleton
      (gradedRelationIdeal_eq_span_quadraticFormPoly hx hspan hdim a hupper hunit hrel)]

/-- **The left hand side of the chart identification of Section 54.12.** The kernel of the
surjection `κ[y₂, y₃] → A[𝔪/x₁]/x₁·A[𝔪/x₁]` is generated by

`q(1, y₂, y₃) = ā₁₁ + ā₁₂y₂ + ā₁₃y₃ + ā₂₂y₂² + ā₂₃y₂y₃ + ā₃₃y₃²`,

the polynomial the Claim of Section 54.12 is stated with, so that
`AlgebraicGeometry.rank_le_one_of_not_isScalarSqLinear` applies to it verbatim. Together with
`AlgebraicGeometry.chartPresentation_surjective` this is the source's
`A[𝔪/x₁]/x₁·A[𝔪/x₁] ≅ κ[y₂, y₃]/(q(1, y₂, y₃))`, which is
`AlgebraicGeometry.chartQuotientEquivQuadric`. -/
public theorem ker_chartPresentation_eq_span [IsNoetherianRing A]
    (hx : ∀ i, x i ∈ maximalIdeal A) (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (hdim : ∀ n, Module.finrank (ResidueField A) (IsLocalRing.gradedPiece A n) = 2 * n + 1)
    (a : Fin 3 → Fin 3 → A) (hupper : ∀ p r, r < p → a p r = 0)
    (hunit : ∃ p r, p ≤ r ∧ a p r ∉ maximalIdeal A)
    (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3)
    (hgood : IsGoodCoordinateForm fun p r => IsLocalRing.residue A (a p r)) :
    RingHom.ker (chartPresentation S hx)
      = Ideal.span {MvPolynomial.C (IsLocalRing.residue A (a 0 0)) +
          MvPolynomial.C (IsLocalRing.residue A (a 0 1)) * MvPolynomial.X 0 +
          MvPolynomial.C (IsLocalRing.residue A (a 0 2)) * MvPolynomial.X 1 +
          MvPolynomial.C (IsLocalRing.residue A (a 1 1)) * MvPolynomial.X 0 ^ 2 +
          MvPolynomial.C (IsLocalRing.residue A (a 1 2)) * MvPolynomial.X 0 * MvPolynomial.X 1 +
          MvPolynomial.C (IsLocalRing.residue A (a 2 2)) * MvPolynomial.X 1 ^ 2} := by
  rw [ker_chartPresentation_eq_span_singleton S hx hspan hdim a hupper hunit hrel hgood,
    dehomogenizeFirst_quadraticFormPoly_fin_three _
      fun p r hrp => by rw [hupper p r hrp, map_zero]]

/-- **`A[𝔪/x₁]/x₁·A[𝔪/x₁] ≅ κ[y₂, y₃]/(q(1, y₂, y₃))`**, the chart identification of
Section 54.12 for a rational double point at a good coordinate. The generator of the ideal is
the dehomogenized quadratic form, whose coefficients are written out in
`AlgebraicGeometry.dehomogenizeFirst_quadraticFormPoly_fin_three`. -/
public def chartQuotientEquivQuadric [IsNoetherianRing A]
    (hx : ∀ i, x i ∈ maximalIdeal A) (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (hdim : ∀ n, Module.finrank (ResidueField A) (IsLocalRing.gradedPiece A n) = 2 * n + 1)
    (a : Fin 3 → Fin 3 → A) (hupper : ∀ p r, r < p → a p r = 0)
    (hunit : ∃ p r, p ≤ r ∧ a p r ∉ maximalIdeal A)
    (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3)
    (hgood : IsGoodCoordinateForm fun p r => IsLocalRing.residue A (a p r)) :
    MvPolynomial (Fin 2) (ResidueField A) ⧸
        Ideal.span {dehomogenizeFirst (ResidueField A) 2
          (quadraticFormPoly fun p r => IsLocalRing.residue A (a p r))}
      ≃+* chartExceptionalQuotient (maximalIdeal A) (x 0) S :=
  (Ideal.quotEquivOfEq (ker_chartPresentation_eq_span_singleton
        S hx hspan hdim a hupper hunit hrel hgood).symm).trans
    (RingHom.quotientKerEquivOfSurjective (chartPresentation_surjective S hx hspan))

