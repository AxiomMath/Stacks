-/

@[expose] public noncomputable section

open CategoryTheory MvPolynomial

universe u v

namespace AlgebraicGeometry

/-! ### Residue field maps which are isomorphisms -/

/-- **A residue field map is an isomorphism exactly when it is surjective.** It is a homomorphism
of fields, hence injective. -/
public theorem isIso_residueFieldMap_iff_surjective {X Y : Scheme.{u}} (f : X ⟶ Y) (x : X) :
    IsIso (f.residueFieldMap x) ↔ Function.Surjective (f.residueFieldMap x).hom :=
  ⟨fun _ => ((ConcreteCategory.isIso_iff_bijective (f.residueFieldMap x)).mp ‹_›).2,
    fun hsurj => (ConcreteCategory.isIso_iff_bijective _).mpr
      ⟨(f.residueFieldMap x).hom.injective, hsurj⟩⟩

/-- **Surjectivity of a residue field map, tested on the stalk map.** The residue map of the
target of the stalk map is surjective, and the square relating it to the residue field map
commutes, so the residue field map is an isomorphism as soon as the composite of the stalk map
with the residue map is surjective. -/
public theorem isIso_residueFieldMap_of_surjective_stalkMap_residue {X Y : Scheme.{u}}
    (f : X ⟶ Y) (x : X)
    (h : Function.Surjective (f.stalkMap x ≫ X.residue x).hom) :
    IsIso (f.residueFieldMap x) := by
  refine (isIso_residueFieldMap_iff_surjective f x).mpr fun z => ?_
  rw [← Scheme.residue_residueFieldMap] at h
  obtain ⟨b, hb⟩ := h z
  exact ⟨Y.residue (f.base x) b, hb⟩

/-- **Surjectivity of a residue field map, tested on sections over an open containing the image
point.** The germ map factors the stalk map of the target, so this is
`AlgebraicGeometry.isIso_residueFieldMap_of_surjective_stalkMap_residue` with the test made on a
ring of sections over `U` instead of on the local ring at the image point. -/
public theorem isIso_residueFieldMap_of_surjective_germ_residue {X Y : Scheme.{u}}
    (f : X ⟶ Y) (x : X) (U : Y.Opens) (hU : f.base x ∈ U)
    (h : Function.Surjective
      (Y.presheaf.germ U (f.base x) hU ≫ f.stalkMap x ≫ X.residue x).hom) :
    IsIso (f.residueFieldMap x) :=
  isIso_residueFieldMap_of_surjective_stalkMap_residue f x fun z => by
    obtain ⟨b, hb⟩ := h z
    exact ⟨Y.presheaf.germ U (f.base x) hU b, hb⟩

/-! ### Rationality from colength at most one -/

/-- **A nontrivial algebra of rank at most one over a field is that field.** The structure
homomorphism of an algebra over a field is injective as soon as the target is nontrivial, and a
vector space of dimension at most one in which `1` is nonzero is spanned by `1`. -/
public theorem bijective_algebraMap_of_rank_le_one (k : Type u) [Field k] (B : Type v)
    [CommRing B] [Nontrivial B] [Algebra k B] (h : Module.rank k B ≤ 1) :
    Function.Bijective (algebraMap k B) := by
  refine ⟨(algebraMap k B).injective, fun b => ?_⟩
  obtain ⟨v, hv⟩ := rank_le_one_iff.mp h
  obtain ⟨c₁, hc₁⟩ := hv 1
  have hc₁0 : c₁ ≠ 0 := fun h0 => one_ne_zero (α := B) (by rw [← hc₁, h0, zero_smul])
  obtain ⟨c, hc⟩ := hv b
  refine ⟨c * c₁⁻¹, ?_⟩
  rw [Algebra.algebraMap_eq_smul_one, ← hc₁, smul_smul, mul_assoc, inv_mul_cancel₀ hc₁0,
    mul_one, hc]

/-- **The residue field at a singular point of the exceptional curve in case I is `κ`.** Suppose
the quadratic form of the singularity is in case I: its upper triangular coefficient matrix has a
nonzero entry on or above the diagonal and is not a scalar times the square of a linear form. Let
`I` be a proper ideal of `κ[y₂, y₃]` whose square contains the dehomogenization
`q(1, y₂, y₃)` — which is what the source derives from singularity of the blowup at the point of
the exceptional curve cut out by `I`. Then `κ[y₂, y₃]/I` is `κ`.

This is the Claim of Section 54.12, `AlgebraicGeometry.rank_le_one_of_not_isScalarSqLinear`, read
as a statement about the residue field: the singular points of the exceptional curve are
`κ`-rational. With `AlgebraicGeometry.isIso_residueFieldMap_of_surjective_germ_residue` it is the
content of `AlgebraicGeometry.PointBlowupStep.next_residue`; see the module docstring for the two
steps still separating the two. -/
public theorem bijective_algebraMap_quotient_of_not_isScalarSqLinear {k : Type u} [Field k]
    (a : Fin 3 → Fin 3 → k) (hupper : ∀ p q, q < p → a p q = 0)
    (hunit : ∃ p q, p ≤ q ∧ a p q ≠ 0) (hcase : ¬ IsScalarSqLinear a)
    (I : Ideal (MvPolynomial (Fin 2) k)) (hI : I ≠ ⊤)
    (hmem : (C (a 0 0) + C (a 0 1) * X 0 + C (a 0 2) * X 1 + C (a 1 1) * X 0 ^ 2 +
      C (a 1 2) * X 0 * X 1 + C (a 2 2) * X 1 ^ 2 : MvPolynomial (Fin 2) k) ∈ I ^ 2) :
    Function.Bijective (algebraMap k (MvPolynomial (Fin 2) k ⧸ I)) :=
  let : Nontrivial (MvPolynomial (Fin 2) k ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI
  bijective_algebraMap_of_rank_le_one k _
    (rank_le_one_of_not_isScalarSqLinear a hupper hunit hcase I hmem)

end AlgebraicGeometry

end
