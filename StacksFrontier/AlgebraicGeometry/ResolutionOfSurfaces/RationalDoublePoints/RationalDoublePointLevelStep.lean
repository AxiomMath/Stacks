module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.RationalDoublePointLevels

/-!
# The descent through the levels at the singular points of the blowup

Let `S` be a Situation [Stacks, Tag 0BGC] and `z` a singular point of the blowup `X` of
`Spec(A)` in the maximal ideal. If `A` carries an element `x` at one of the four levels of
`AlgebraicGeometry.rationalDoublePointLevel`, then the local ring `𝒪_{X,z}`:

* either is again the ring of a Situation 0BGC whose blowup is regular or which carries an
  element at a lower level;
* or has residue field `κ`, has its exceptional ideal `𝔪𝒪_{X,z}` generated by the image of `x`
  (so `z` lies on the chart attached to `x`, by
  `AlgebraicGeometry.memChart_of_map_maximalIdeal_eq_span`), and carries the image of `x` at the
  same level.

This turns the chart computations of `CaseOneChart` and `CaseTwoStep`, which are statements about
the localization `A[𝔪/b]_{𝔪'}` of a chart ring at a maximal ideal over `𝔪`, into statements about
the local rings of the blowup, through the identification
`AlgebraicGeometry.RationalDoublePointSituation.exists_chartData` of `𝒪_{X,z}` with
`A[𝔪/b]_{𝔪'}` compatible with the maps from `A`. Level by level:

* level `0` (a good coordinate `x = x₁`): at every singular point the exceptional ideal is
  generated by `x₁`, whichever chart contains the point; so the point lies on the chart `x₁`,
  where it is `κ`-rational and `x₁` is again a good coordinate;
* level `1` (`w₃² = w₁F`, nondegenerate, `x = w₁`): a case I point descends to level `0`; a case II
  point lies on the chart `w₁` (on the chart `w₂` the exceptional ideal is `w₁𝒪`, and the chart
  `w₃` has no point over `𝔪`), where the nondegenerate invariant holds again with first generator
  the image of `w₁`;
* level `2` (`w₃² = w₁F`, `x = w₂`): a case II point on the chart `w₁` has level `1`; on the chart
  `w₂` it either lies on the chart `w₁` as well, or is the point `P*`, where the invariant holds
  again with middle generator the image of `w₂`;
* level `3` (case II): a case II point on the chart `x₁` or `x₂` has level `2`, and the chart `x₃`
  has no point over `𝔪`.

## Main results

* `AlgebraicGeometry.RationalDoublePointSituation.step_rationalDoublePointLevel`: the descent, in
  the form of the hypothesis `hstep` of
  `AlgebraicGeometry.exists_singularPointBlowupChain_isRegular_of_levels`.

## References

* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
-/

@[expose] public noncomputable section

open CategoryTheory IsLocalRing

universe u

namespace AlgebraicGeometry

/-- Case I is carried along ring isomorphisms. -/
theorem IsCaseOne.of_ringEquiv {R R' : Type*} [CommRing R] [IsLocalRing R] [CommRing R']
    [IsLocalRing R'] (e : R ≃+* R') (h : IsCaseOne R) : IsCaseOne R' := by
  have : IsLocalHom (e : R →+* R') := IsLocalHom.of_surjective _ e.surjective
  refine IsCaseOne.map (e : R →+* R') (fun t => ?_) (map_ringEquiv_maximalIdeal e) h
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective t
  exact ⟨e.symm y, by simp⟩

namespace RationalDoublePointSituation

/-- **The conclusion of the descent** at a singular point `z` of the blowup of a Situation 0BGC,
for an element `x` at level `n`: the local ring at `z` is a Situation 0BGC with a regular blowup or
an element at a lower level, or it has residue field `κ`, exceptional ideal generated by `x` and
carries the image of `x` at level `n`. This is the conclusion of the hypothesis `hstep` of
`AlgebraicGeometry.exists_singularPointBlowupChain_isRegular_of_levels` for
`AlgebraicGeometry.rationalDoublePointLevel`. -/
abbrev LevelDescent (n : ℕ) (S : RationalDoublePointSituation.{u}) (x : S.A)
    (z : blowUp (maximalIdealSheaf S.A)) : Prop :=
  (∃ S' : RationalDoublePointSituation.{u},
      Nonempty (S'.A ≃+* (blowUp (maximalIdealSheaf S.A)).presheaf.stalk z) ∧
      (singularLocus (blowUp (maximalIdealSheaf S'.A)) = ∅ ∨
        ∃ i < n, ∃ y : S'.A, rationalDoublePointLevel i S'.A y)) ∨
    (Function.Surjective ((Ideal.Quotient.mk (IsLocalRing.maximalIdeal
        ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk z))).comp
          (maximalIdealBlowUpStalkHom S.A z)) ∧
      Ideal.map (maximalIdealBlowUpStalkHom S.A z) (IsLocalRing.maximalIdeal S.A) =
        Ideal.span {maximalIdealBlowUpStalkHom S.A z x} ∧
      rationalDoublePointLevel n ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk z)
        (maximalIdealBlowUpStalkHom S.A z x))

/-- A local ring of the blowup isomorphic to a ring at a lower level gives the first alternative of
the descent. -/
theorem levelDescent_of_lt (S : RationalDoublePointSituation.{u}) {n i : ℕ} (hi : i < n) (x : S.A)
    (z : blowUp (maximalIdealSheaf S.A))
    (hz : z ∈ singularLocus (blowUp (maximalIdealSheaf S.A)))
    {B : Type u} [CommRing B] [IsLocalRing B]
    (ε : (blowUp (maximalIdealSheaf S.A)).presheaf.stalk z ≃+* B) (y : B)
    (h : rationalDoublePointLevel i B y) : LevelDescent n S x z := by
  obtain ⟨S', he, y', hy'⟩ := S.exists_situation_level z hz i ε y h
  exact Or.inl ⟨S', he, Or.inr ⟨i, hi, y', hy'⟩⟩

/-- A local ring of the blowup in case I gives the first alternative of the descent from a positive
level. -/
theorem levelDescent_of_isCaseOne (S : RationalDoublePointSituation.{u}) {n : ℕ} (hn : 0 < n)
    (x : S.A) (z : blowUp (maximalIdealSheaf S.A))
    (hz : z ∈ singularLocus (blowUp (maximalIdealSheaf S.A)))
    (h : IsCaseOne ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk z)) :
    LevelDescent n S x z :=
  Or.inl (S.descent_of_isCaseOne z hz h n hn)

/-- **The continuation alternative of the descent, from a chart.** If the localization of the chart
`A[𝔪/b]` at a maximal ideal `𝔪' ⊇ 𝔪A[𝔪/b]`, identified with the local ring at `z` compatibly with
the maps from `A`, has residue field `κ`, exceptional ideal generated by `x` and carries the image
of `x` at level `n`, then so does the local ring at `z`. -/
theorem levelDescent_of_chart (S : RationalDoublePointSituation.{u}) (n : ℕ) {b : S.A}
    {z : blowUp (maximalIdealSheaf S.A)}
    {M : Ideal (affineBlowupAlgebra (IsLocalRing.maximalIdeal S.A) b (Localization.Away b))}
    [M.IsMaximal]
    (ε : (blowUp (maximalIdealSheaf S.A)).presheaf.stalk z ≃+* Localization.AtPrime M)
    (hε : ∀ a : S.A, ε (maximalIdealBlowUpStalkHom S.A z a) =
      algebraMap _ (Localization.AtPrime M)
        (algebraMap S.A (affineBlowupAlgebra (IsLocalRing.maximalIdeal S.A) b
          (Localization.Away b)) a))
    (hle : Ideal.map (algebraMap S.A (affineBlowupAlgebra (IsLocalRing.maximalIdeal S.A) b
      (Localization.Away b))) (IsLocalRing.maximalIdeal S.A) ≤ M) (x : S.A)
    (hsurj : Function.Surjective ((Ideal.Quotient.mk M).comp
      (algebraMap S.A (affineBlowupAlgebra (IsLocalRing.maximalIdeal S.A) b
          (Localization.Away b)))))
    (hexc : Ideal.map ((algebraMap (affineBlowupAlgebra (IsLocalRing.maximalIdeal S.A) b
        (Localization.Away b)) (Localization.AtPrime M)).comp
        (algebraMap S.A (affineBlowupAlgebra (IsLocalRing.maximalIdeal S.A) b
          (Localization.Away b))))
        (IsLocalRing.maximalIdeal S.A) =
      Ideal.span {((algebraMap (affineBlowupAlgebra (IsLocalRing.maximalIdeal S.A) b
        (Localization.Away b)) (Localization.AtPrime M)).comp
        (algebraMap S.A (affineBlowupAlgebra (IsLocalRing.maximalIdeal S.A) b
          (Localization.Away b)))) x})
    (hlev : rationalDoublePointLevel n (Localization.AtPrime M)
      (((algebraMap (affineBlowupAlgebra (IsLocalRing.maximalIdeal S.A) b
        (Localization.Away b)) (Localization.AtPrime M)).comp
        (algebraMap S.A (affineBlowupAlgebra (IsLocalRing.maximalIdeal S.A) b
          (Localization.Away b)))) x)) :
    LevelDescent n S x z := by
  refine Or.inr ⟨S.surjective_residue_of_chart ε hε hle hsurj,
    S.map_maximalIdeal_eq_span_of_chart ε hε x hexc, ?_⟩
  have heq : ε.symm (((algebraMap (affineBlowupAlgebra (IsLocalRing.maximalIdeal S.A) b
      (Localization.Away b)) (Localization.AtPrime M)).comp
      (algebraMap S.A (affineBlowupAlgebra (IsLocalRing.maximalIdeal S.A) b
          (Localization.Away b)))) x) =
      maximalIdealBlowUpStalkHom S.A z x :=
    ε.symm_apply_eq.mpr (hε x).symm
  rw [← heq]
  exact rationalDoublePointLevel_ringEquiv n ε.symm _ hlev

/-- An element of `Fin 3` is `0`, `1` or `2`. -/
private theorem fin_three_cases (j : Fin 3) : j = 0 ∨ j = 1 ∨ j = 2 := by
  fin_cases j <;> simp

/-- The generators of the maximal ideal lie in it. -/
private theorem mem_maximalIdeal_of_span_eq {A : Type*} [CommRing A] [IsLocalRing A]
    {w : Fin 3 → A} (hspan : Ideal.span (Set.range w) = IsLocalRing.maximalIdeal A) (i : Fin 3) :
    w i ∈ IsLocalRing.maximalIdeal A := hspan ▸ Ideal.subset_span ⟨i, rfl⟩

/-- **Level `0`: a good coordinate.** If `x` is a good coordinate of `A`, then at every singular
point `z` of the blowup the exceptional ideal is generated by `x` (whichever standard chart
contains `z`), so `z` lies on the chart attached to `x`; there `z` is `κ`-rational and the image of
`x` is again a good coordinate. -/
theorem levelDescent_zero (S : RationalDoublePointSituation.{u}) (x : S.A)
    (hx : IsGoodCoordinate S.A x) (z : blowUp (maximalIdealSheaf S.A))
    (hz : z ∈ singularLocus (blowUp (maximalIdealSheaf S.A))) : LevelDescent 0 S x z := by
  obtain ⟨w, a, rfl, hspan, hupper, -, hrel, hgood⟩ := hx
  have hw := mem_maximalIdeal_of_span_eq hspan
  have hexc : Ideal.map (maximalIdealBlowUpStalkHom S.A z) (IsLocalRing.maximalIdeal S.A) =
      Ideal.span {maximalIdealBlowUpStalkHom S.A z (w 0)} := by
    obtain ⟨j, hj⟩ := exists_memChart S.A w hspan z
    obtain ⟨M, hM, hle, hprime, ε, hε, hnoeth, -, -, hdim, hsing⟩ := S.exists_chartData _ z hz hj
    exact S.map_maximalIdeal_eq_span_of_chart ε hε (w 0)
      (map_maximalIdeal_eq_span_of_isGoodCoordinate_chart w hspan a hrel hgood j _ M hle
        hdim hsing)
  obtain ⟨M, hM, hle, hprime, ε, hε, hnoeth, -, -, hdim, hsing⟩ :=
    S.exists_chartData (hw 0) z hz (memChart_of_map_maximalIdeal_eq_span S.A (hw 0) z hexc)
  obtain ⟨hsurj, hgc⟩ := isGoodCoordinate_localization_of_chart (Localization.Away (w 0)) hw
    hspan a hupper hrel hgood M hle hdim hsing
  exact levelDescent_of_chart S 0 ε hε hle (w 0) hsurj
    (map_maximalIdeal_eq_span_of_isGoodCoordinate_chart w hspan a hrel hgood 0 _ M hle hdim
      hsing) hgc

/-- At a singular point of the blowup whose local ring is not in case I, the localization of a
chart ring identified with the local ring is not in case I. -/
private theorem not_isCaseOne_of_ringEquiv {R R' : Type u} [CommRing R] [IsLocalRing R]
    [CommRing R'] [IsLocalRing R'] (ε : R ≃+* R') (h : ¬ IsCaseOne R) : ¬ IsCaseOne R' :=
  fun h' => h (h'.of_ringEquiv ε.symm)

/-- **Level `1`: the nondegenerate case II invariant `w₃² = w₁F`, `F ≡ f w₂²`, `f` a unit, with
`x = w₁`.** A singular point of the blowup in case I descends to level `0`. A singular point in
case II lies on the chart `w₁` (on the chart `w₂` the exceptional ideal is generated by `w₁`, and
the chart `w₃` has no point over `𝔪`); there it is `κ`-rational, `w₁` generates the exceptional
ideal, and the nondegenerate invariant holds again with first generator the image of `w₁`. -/
theorem levelDescent_one (S : RationalDoublePointSituation.{u}) (x : S.A)
    (hx : ∃ w : Fin 3 → S.A, w 0 = x ∧ HasDoubleLineRelationUnit S.A w)
    (z : blowUp (maximalIdealSheaf S.A))
    (hz : z ∈ singularLocus (blowUp (maximalIdealSheaf S.A))) : LevelDescent 1 S x z := by
  obtain ⟨w, rfl, h⟩ := hx
  by_cases hI : IsCaseOne ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk z)
  · exact S.levelDescent_of_isCaseOne one_pos _ z hz hI
  have hspan := h.1
  have hw := mem_maximalIdeal_of_span_eq hspan
  have chart0 : MemChart (hw 0) z → LevelDescent 1 S (w 0) z := by
    intro hc
    obtain ⟨M, hM, hle, hprime, ε, hε, hnoeth, hdom, hic, hdim, hsing⟩ :=
      S.exists_chartData (hw 0) z hz hc
    obtain ⟨hsurj, hexc, w', hw'0, hu⟩ :=
      hasDoubleLineRelationUnit_of_hasDoubleLineRelation_chart_zero w h.hasDoubleLineRelation _ M
        hle hdim hsing (not_isCaseOne_of_ringEquiv ε hI)
    exact levelDescent_of_chart S 1 ε hε hle (w 0) hsurj hexc ⟨w', hw'0, hu⟩
  obtain ⟨j, hj⟩ := exists_memChart S.A w hspan z
  rcases fin_three_cases j with rfl | rfl | rfl
  · exact chart0 hj
  · obtain ⟨M, hM, hle, hprime, ε, hε, -, -, -, -, -⟩ := S.exists_chartData _ z hz hj
    exact chart0 (memChart_of_map_maximalIdeal_eq_span S.A (hw 0) z
      (S.map_maximalIdeal_eq_span_of_chart ε hε (w 0)
        (map_maximalIdeal_eq_span_of_hasDoubleLineRelationUnit_chart_one w h _ M hle
          (not_isCaseOne_of_ringEquiv ε hI))))
  · obtain ⟨M, hM, hle, -⟩ := S.exists_chartData _ z hz hj
    exact (false_of_chart_two hspan h.hasDoubleLineRelation.mul_self_mem_pow_three _ M hle).elim

/-- **Level `2`: the case II invariant `w₃² = w₁F`, `F ∈ 𝔪²`, with `x = w₂`.** A singular point of
the blowup in case I descends to level `0`. A singular point in case II on the chart `w₁` has
level `1`; on the chart `w₂` it lies on the chart `w₁` as well, or it is the point `P*`: it is
`κ`-rational, `w₂` generates the exceptional ideal, and the invariant holds again with middle
generator the image of `w₂`. The chart `w₃` has no point over `𝔪`. -/
theorem levelDescent_two (S : RationalDoublePointSituation.{u}) (x : S.A)
    (hx : ∃ w : Fin 3 → S.A, w 1 = x ∧ HasDoubleLineRelation S.A w)
    (z : blowUp (maximalIdealSheaf S.A))
    (hz : z ∈ singularLocus (blowUp (maximalIdealSheaf S.A))) : LevelDescent 2 S x z := by
  obtain ⟨w, rfl, h⟩ := hx
  by_cases hI : IsCaseOne ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk z)
  · exact S.levelDescent_of_isCaseOne two_pos _ z hz hI
  have hspan := h.1
  have hw := mem_maximalIdeal_of_span_eq hspan
  have chart0 : MemChart (hw 0) z → LevelDescent 2 S (w 1) z := by
    intro hc
    obtain ⟨M, hM, hle, hprime, ε, hε, hnoeth, hdom, hic, hdim, hsing⟩ :=
      S.exists_chartData (hw 0) z hz hc
    obtain ⟨-, -, w', -, hu⟩ := hasDoubleLineRelationUnit_of_hasDoubleLineRelation_chart_zero
      w h _ M hle hdim hsing (not_isCaseOne_of_ringEquiv ε hI)
    exact S.levelDescent_of_lt one_lt_two _ z hz ε (w' 0) ⟨w', rfl, hu⟩
  obtain ⟨j, hj⟩ := exists_memChart S.A w hspan z
  rcases fin_three_cases j with rfl | rfl | rfl
  · exact chart0 hj
  · obtain ⟨M, hM, hle, hprime, ε, hε, -, -, -, -, -⟩ := S.exists_chartData _ z hz hj
    obtain ⟨f, hf⟩ := h.exists_sum
    rcases hasDoubleLineRelation_chart_one w hspan f hf _ M hle
        (not_isCaseOne_of_ringEquiv ε hI) with hexc | ⟨-, hsurj, hexc, w', hw'1, hD⟩
    · exact chart0 (memChart_of_map_maximalIdeal_eq_span S.A (hw 0) z
        (S.map_maximalIdeal_eq_span_of_chart ε hε (w 0) hexc))
    · exact levelDescent_of_chart S 2 ε hε hle (w 1) hsurj hexc ⟨w', hw'1, hD⟩
  · obtain ⟨M, hM, hle, -⟩ := S.exists_chartData _ z hz hj
    exact (false_of_chart_two hspan h.mul_self_mem_pow_three _ M hle).elim

/-- **Level `3`: case II.** A singular point of the blowup in case I descends to level `0`; a
singular point in case II lies on the chart `x₁` or `x₂` and has level `2` there. The chart `x₃`
has no point over `𝔪`. -/
theorem levelDescent_three (S : RationalDoublePointSituation.{u}) (x : S.A)
    (hx : IsCaseTwo S.A) (z : blowUp (maximalIdealSheaf S.A))
    (hz : z ∈ singularLocus (blowUp (maximalIdealSheaf S.A))) : LevelDescent 3 S x z := by
  obtain ⟨w, b, hspan, hrel⟩ := hx
  by_cases hI : IsCaseOne ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk z)
  · exact S.levelDescent_of_isCaseOne three_pos _ z hz hI
  obtain ⟨j, hj⟩ := exists_memChart S.A w hspan z
  obtain ⟨M, hM, hle, hprime, ε, hε, hnoeth, hdom, hic, hdim, hsing⟩ :=
    S.exists_chartData _ z hz hj
  rcases fin_three_cases j with rfl | rfl | rfl
  · obtain ⟨-, -, w', hD⟩ := hasDoubleLineRelation_of_isCaseTwo_chart_zero w hspan b hrel _ M
      hle hdim hsing (not_isCaseOne_of_ringEquiv ε hI)
    exact S.levelDescent_of_lt (i := 2) (by norm_num) _ z hz ε (w' 1) ⟨w', rfl, hD⟩
  · obtain ⟨-, -, w', hD⟩ := hasDoubleLineRelation_of_isCaseTwo_chart_one w hspan b hrel _ M
      hle hdim hsing (not_isCaseOne_of_ringEquiv ε hI)
    exact S.levelDescent_of_lt (i := 2) (by norm_num) _ z hz ε (w' 1) ⟨w', rfl, hD⟩
  · exact (false_of_chart_two hspan (mul_self_mem_pow_three_of_sq_eq_cubic hspan b hrel) _ M
      hle).elim

/-- **The descent through the levels** ([Stacks, Tag 0BGE], termination of the resolution of a
rational double point). Let `x` be an element of the ring of a Situation 0BGC at level `n` of
`AlgebraicGeometry.rationalDoublePointLevel`, and `z` a singular point of the blowup of
`Spec(A)` in the maximal ideal. Then either the local ring at `z` is the ring of a Situation 0BGC
whose blowup is regular or which carries an element at a lower level, or it has residue field `κ`
(`A → 𝒪_z/𝔪_z` surjective), its exceptional ideal is generated by `x`, and it carries the image of
`x` at level `n`. This is the hypothesis `hstep` of
`AlgebraicGeometry.exists_singularPointBlowupChain_isRegular_of_levels` for
`Inv := AlgebraicGeometry.rationalDoublePointLevel`. -/
theorem step_rationalDoublePointLevel (n : ℕ) (S : RationalDoublePointSituation.{u}) (x : S.A)
    (hx : rationalDoublePointLevel n S.A x) (z : blowUp (maximalIdealSheaf S.A))
    (hz : z ∈ singularLocus (blowUp (maximalIdealSheaf S.A))) :
    (∃ S' : RationalDoublePointSituation.{u},
        Nonempty (S'.A ≃+* (blowUp (maximalIdealSheaf S.A)).presheaf.stalk z) ∧
        (singularLocus (blowUp (maximalIdealSheaf S'.A)) = ∅ ∨
          ∃ i < n, ∃ y : S'.A, rationalDoublePointLevel i S'.A y)) ∨
      (Function.Surjective ((Ideal.Quotient.mk (IsLocalRing.maximalIdeal
          ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk z))).comp
            (maximalIdealBlowUpStalkHom S.A z)) ∧
        Ideal.map (maximalIdealBlowUpStalkHom S.A z) (IsLocalRing.maximalIdeal S.A) =
          Ideal.span {maximalIdealBlowUpStalkHom S.A z x} ∧
        rationalDoublePointLevel n ((blowUp (maximalIdealSheaf S.A)).presheaf.stalk z)
          (maximalIdealBlowUpStalkHom S.A z x)) := by
  match n, hx with
  | 0, hx => exact S.levelDescent_zero x hx z hz
  | 1, hx => exact S.levelDescent_one x hx z hz
  | 2, hx => exact S.levelDescent_two x hx z hz
  | 3, hx => exact S.levelDescent_three x hx.1 z hz
  | _ + 4, hx => exact hx.elim

end RationalDoublePointSituation

end AlgebraicGeometry

end
