module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.QuadraticForm
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.QuadricHilbert

/-!
# The homogeneous ideal of relations among the generators of a maximal ideal

Let `(A, 𝔪, κ)` be a local ring and `x₁, …, x_d` a system of generators of `𝔪`. Evaluating at
`x` turns a homogeneous polynomial of degree `n` over `κ` into an element of `𝔪ⁿ/𝔪ⁿ⁺¹`, and the
polynomials which die there assemble into a homogeneous ideal `I ⊆ κ[t₁, …, t_d]` with
`κ[t]_n / I_n = 𝔪ⁿ/𝔪ⁿ⁺¹` in every degree. This file constructs that ideal and computes its
Hilbert function.

For a rational double point the quotient has Hilbert function `2n + 1`, and
`AlgebraicGeometry.eq_span_singleton_of_hilbertFunction_two_mul_add_one` then pins `I` down to
the principal ideal generated by the quadratic form of the singularity. That identification is
the algebraic content of `E = V(q) ⊆ ℙ²_κ` in Section 54.12 of the source, and it is what makes
a good coordinate cut the exceptional divisor out: `t₁` does not divide `q`, hence is a
nonzerodivisor on `κ[t]/(q) = ⨁ₙ 𝔪ⁿ/𝔪ⁿ⁺¹`, which says exactly that `x₁` is a superficial
element of `𝔪`.

## Main definitions

* `AlgebraicGeometry.evalGradedPiece`: the `κ`-linear map `κ[t₁, …, t_d] → 𝔪ⁿ/𝔪ⁿ⁺¹` which lifts a
  polynomial to `A`, takes its degree-`n` homogeneous component and evaluates it at `x`.
* `AlgebraicGeometry.gradedRelationIdeal`: the homogeneous ideal of `κ[t₁, …, t_d]` generated by
  the homogeneous polynomials which die in the corresponding graded piece.

## Main results

* `AlgebraicGeometry.evalGradedPiece_surjective`: every element of `𝔪ⁿ/𝔪ⁿ⁺¹` is the value of a
  homogeneous polynomial of degree `n`.
* `AlgebraicGeometry.gradedPieceI_gradedRelationIdeal`: the degree-`n` piece of the relation ideal
  is exactly the kernel in degree `n`. This is the step which needs that a homogeneous element of
  a span of homogeneous elements is a combination of them with homogeneous coefficients.
* `AlgebraicGeometry.hilbertFunction_gradedRelationIdeal`: the Hilbert function of the quotient
  by the relation ideal is `dim_κ(𝔪ⁿ/𝔪ⁿ⁺¹)`.
* `AlgebraicGeometry.gradedRelationIdeal_eq_span_singleton`: **the relation ideal of a rational
  double point is generated by its quadratic form.** When the graded dimensions are `2n + 1` and
  the ideal contains a nonzero quadratic form `q`, it is `(q)`.
* `AlgebraicGeometry.mem_pow_succ_of_mul_mem_pow`: **a good coordinate is a superficial element.**
  If the relation ideal is `(q)` and `t₁` does not divide `q`, then `x₁ v ∈ 𝔪ⁿ⁺²` and `v ∈ 𝔪ⁿ`
  force `v ∈ 𝔪ⁿ⁺¹`.

## Implementation notes

The graded piece is `IsLocalRing.gradedPiece`, the construction of
`RationalDoublePoints/QuadraticForm.lean`, not `AssociatedGraded.piece`; the two are parallel and
there is no bridge between them, so everything here stays on the former, which is the one the
dimension computations of `RationalDoublePoints/GradedDimensions.lean` speak about.

No associated graded *ring* is used. The relation ideal is defined as the ideal generated by the
homogeneous polynomials which evaluate into the next power of `𝔪`, and the only thing needed of
the multiplicative structure is that a homogeneous polynomial of degree `n` lying in that span is
a combination of generators with homogeneous coefficients. That is
`AlgebraicGeometry.homogeneousComponent_mul_right`, proved here, and it replaces both the graded
ring and the external-to-internal grading bridge an approach through `Proj` would need.

Lifting from `κ` to `A` uses a set-theoretic section of the residue map; nothing depends on the
choice, because two homogeneous lifts of the same degree have values at `x` differing by an
element of `𝔪ⁿ⁺¹`, which is
`AlgebraicGeometry.aeval_sub_mem_of_map_eq`.

## References

* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
* [Stacks Project, Tag 0BGC](https://stacks.math.columbia.edu/tag/0BGC)
-/

@[expose] public noncomputable section

open IsLocalRing MvPolynomial
open Stacks.HilbertFunction.PolynomialQuotient

universe u

namespace AlgebraicGeometry

/-! ### Homogeneous components of a product -/

section Homogeneous

variable {σ : Type*} {R : Type*} [CommRing R]

/-- **Multiplying by a homogeneous element of degree `m` shifts homogeneous components by `m`.**
This is what makes a homogeneous element of a span of homogeneous elements a combination of them
with homogeneous coefficients. -/
public theorem homogeneousComponent_mul_right {G : MvPolynomial σ R} {m : ℕ}
    (hG : G.IsHomogeneous m) (f : MvPolynomial σ R) (n : ℕ) :
    homogeneousComponent (n + m) (f * G) = homogeneousComponent n f * G := by
  induction f using MvPolynomial.induction_on' with
  | monomial c a =>
      rw [homogeneousComponent_of_mem ((isHomogeneous_monomial (d := c) a rfl).mul hG),
        homogeneousComponent_of_mem (isHomogeneous_monomial (d := c) a rfl)]
      by_cases h : n = c.degree
      · subst h
        rw [ite_eq_left rfl, ite_eq_left rfl]
      · rw [ite_eq_right h, ite_eq_right (by omega : ¬ (n + m = c.degree + m)), zero_mul]
  | add p q hp hq => rw [add_mul, map_add, map_add, hp, hq, add_mul]

/-- Below the degree of a homogeneous factor, the homogeneous components of a product vanish. -/
public theorem homogeneousComponent_mul_eq_zero_of_lt {G : MvPolynomial σ R} {m : ℕ}
    (hG : G.IsHomogeneous m) (f : MvPolynomial σ R) {n : ℕ} (hn : n < m) :
    homogeneousComponent n (f * G) = 0 := by
  induction f using MvPolynomial.induction_on' with
  | monomial c a =>
      rw [homogeneousComponent_of_mem ((isHomogeneous_monomial (d := c) a rfl).mul hG),
        ite_eq_right (by omega : ¬ (n = c.degree + m))]
  | add p q hp hq => rw [add_mul, map_add, hp, hq, add_zero]

/-- A coefficient ring map commutes with taking homogeneous components. -/
public theorem map_homogeneousComponent {S : Type*} [CommRing S] (φ : R →+* S) (n : ℕ)
    (f : MvPolynomial σ R) :
    MvPolynomial.map φ (homogeneousComponent n f)
      = homogeneousComponent n (MvPolynomial.map φ f) := by
  ext c
  rw [coeff_map, coeff_homogeneousComponent, coeff_homogeneousComponent, coeff_map]
  split_ifs with h
  · rfl
  · exact map_zero φ

end Homogeneous

/-! ### Evaluating a homogeneous polynomial at generators of an ideal -/

section Eval

variable {A : Type*} [CommRing A] {ι : Type*}

/-- A product of powers of elements of an ideal lies in the corresponding power of the ideal. -/
public theorem prod_pow_mem_pow (J : Ideal A) {x : ι → A} (hx : ∀ i, x i ∈ J)
    (c : ι → ℕ) (s : Finset ι) : ∏ i ∈ s, x i ^ c i ∈ J ^ (∑ i ∈ s, c i) := by
  classical
  refine Finset.induction_on s (by simp) ?_
  intro a s ha ih
  rw [Finset.prod_insert ha, Finset.sum_insert ha, pow_add]
  exact Ideal.mul_mem_mul (Ideal.pow_mem_pow (hx a) _) ih

/-- **The value at generators of a homogeneous polynomial of degree `n` whose coefficients lie in
`Jʳ` lies in `J^(r + n)`.** -/
public theorem aeval_mem_pow_add (J : Ideal A) {x : ι → A} (hx : ∀ i, x i ∈ J) {r n : ℕ}
    {P : MvPolynomial ι A} (hP : P.IsHomogeneous n) (hcoeff : ∀ c, P.coeff c ∈ J ^ r) :
    MvPolynomial.aeval x P ∈ J ^ (r + n) := by
  classical
  rw [MvPolynomial.aeval_def, MvPolynomial.eval₂_eq, pow_add]
  refine Ideal.sum_mem _ fun c hc => ?_
  have hdeg : c.degree = n := by
    by_contra hne
    exact (MvPolynomial.mem_support_iff.mp hc) (hP.coeff_eq_zero hne)
  refine Ideal.mul_mem_mul ?_ ?_
  · simpa using hcoeff c
  · have h := prod_pow_mem_pow J hx (fun i => c i) c.support
    rwa [show ∑ i ∈ c.support, c i = n from (Finsupp.degree_apply c).symm.trans hdeg] at h

/-- The value at generators of a homogeneous polynomial of degree `n` lies in `Jⁿ`. -/
public theorem aeval_mem_pow (J : Ideal A) {x : ι → A} (hx : ∀ i, x i ∈ J) {n : ℕ}
    {P : MvPolynomial ι A} (hP : P.IsHomogeneous n) :
    MvPolynomial.aeval x P ∈ J ^ n := by
  have h := aeval_mem_pow_add (x := x) (r := 0) J hx hP (fun c => by simp)
  rwa [zero_add] at h

/-- An element of the ideal generated by a family is the value at that family of a homogeneous
polynomial of degree one. -/
public theorem exists_isHomogeneous_one_aeval_eq {x : ι → A} {a : A}
    (ha : a ∈ Ideal.span (Set.range x)) :
    ∃ L : MvPolynomial ι A, L.IsHomogeneous 1 ∧ MvPolynomial.aeval x L = a := by
  refine Submodule.span_induction ?_ ?_ ?_ ?_ ha
  · rintro z ⟨i, rfl⟩
    exact ⟨MvPolynomial.X i, MvPolynomial.isHomogeneous_X _ _, by simp⟩
  · exact ⟨0, Submodule.zero_mem (MvPolynomial.homogeneousSubmodule ι A 1), by simp⟩
  · rintro u v - - ⟨L, hL, hLu⟩ ⟨M, hM, hMv⟩
    exact ⟨L + M, hL.add hM, by rw [map_add, hLu, hMv]⟩
  · rintro c u - ⟨L, hL, hLu⟩
    refine ⟨MvPolynomial.C c * L, ?_, ?_⟩
    · simpa using (MvPolynomial.isHomogeneous_C ι c).mul hL
    · rw [map_mul, hLu, MvPolynomial.aeval_C]
      simp

/-- **Every element of the `n`-th power of an ideal generated by a family is the value at that
family of a homogeneous polynomial of degree `n`.** -/
public theorem exists_isHomogeneous_aeval_eq {x : ι → A} (n : ℕ) {v : A}
    (hv : v ∈ Ideal.span (Set.range x) ^ n) :
    ∃ Q : MvPolynomial ι A, Q.IsHomogeneous n ∧ MvPolynomial.aeval x Q = v := by
  induction n generalizing v with
  | zero => exact ⟨MvPolynomial.C v, MvPolynomial.isHomogeneous_C _ _, by simp⟩
  | succ n ih =>
      rw [pow_succ'] at hv
      refine Submodule.mul_induction_on hv ?_ ?_
      · intro a ha b hb
        obtain ⟨L, hL, hLa⟩ := exists_isHomogeneous_one_aeval_eq ha
        obtain ⟨Q, hQ, hQb⟩ := ih hb
        refine ⟨L * Q, ?_, by rw [map_mul, hLa, hQb]⟩
        simpa [Nat.add_comm] using hL.mul hQ
      · rintro u v ⟨P, hP, hPu⟩ ⟨Q, hQ, hQv⟩
        exact ⟨P + Q, hP.add hQ, by rw [map_add, hPu, hQv]⟩

end Eval

/-! ### Lifting a polynomial from the residue field -/

section Lift

variable {A : Type u} [CommRing A] [IsLocalRing A] {d : ℕ}

/-- A preimage in `A` of a polynomial over the residue field, chosen once and for all. Nothing
depends on the choice: see `AlgebraicGeometry.aeval_sub_mem_of_map_eq`. -/
public def residueLift (P : MvPolynomial (Fin d) (ResidueField A)) : MvPolynomial (Fin d) A :=
  Function.surjInv (MvPolynomial.map_surjective (IsLocalRing.residue A)
    IsLocalRing.residue_surjective) P

@[simp]
public theorem map_residueLift (P : MvPolynomial (Fin d) (ResidueField A)) :
    MvPolynomial.map (IsLocalRing.residue A) (residueLift P) = P :=
  Function.surjInv_eq _ P

/-- The degree-`n` homogeneous lift to `A` of a polynomial over the residue field: the
degree-`n` homogeneous component of a chosen lift. -/
public def homogeneousResidueLift (n : ℕ) (P : MvPolynomial (Fin d) (ResidueField A)) :
    MvPolynomial (Fin d) A :=
  homogeneousComponent n (residueLift P)

public theorem isHomogeneous_homogeneousResidueLift (n : ℕ)
    (P : MvPolynomial (Fin d) (ResidueField A)) :
    (homogeneousResidueLift (A := A) n P).IsHomogeneous n :=
  homogeneousComponent_isHomogeneous n _

@[simp]
public theorem map_homogeneousResidueLift (n : ℕ) (P : MvPolynomial (Fin d) (ResidueField A)) :
    MvPolynomial.map (IsLocalRing.residue A) (homogeneousResidueLift n P)
      = homogeneousComponent n P := by
  rw [homogeneousResidueLift, map_homogeneousComponent, map_residueLift]

/-- Two elements of `𝔪ⁿ` have the same class in `𝔪ⁿ/𝔪ⁿ⁺¹` exactly when they differ by an element
of `𝔪ⁿ⁺¹`. -/
public theorem gradedPieceMk_eq_iff {n : ℕ} (u v : ↥(maximalIdeal A ^ n)) :
    gradedPieceMk A n u = gradedPieceMk A n v ↔
      (u : A) - (v : A) ∈ maximalIdeal A ^ (n + 1) := by
  rw [← sub_eq_zero, ← map_sub, gradedPieceMk_eq_zero_iff, Submodule.coe_sub]

variable {x : Fin d → A}

/-- **Two homogeneous lifts of the same degree have the same class in `𝔪ⁿ/𝔪ⁿ⁺¹`.** Their
difference is homogeneous of degree `n` with all coefficients in `𝔪`, hence evaluates into
`𝔪ⁿ⁺¹`. -/
public theorem aeval_sub_mem_of_map_eq (hx : ∀ i, x i ∈ maximalIdeal A) {n : ℕ}
    {P Q : MvPolynomial (Fin d) A} (hP : P.IsHomogeneous n) (hQ : Q.IsHomogeneous n)
    (h : MvPolynomial.map (IsLocalRing.residue A) P
      = MvPolynomial.map (IsLocalRing.residue A) Q) :
    MvPolynomial.aeval x P - MvPolynomial.aeval x Q ∈ maximalIdeal A ^ (n + 1) := by
  have hsub : (P - Q).IsHomogeneous n :=
    Submodule.sub_mem (MvPolynomial.homogeneousSubmodule (Fin d) A n) hP hQ
  have hc : ∀ c, (P - Q).coeff c ∈ maximalIdeal A ^ 1 := by
    intro c
    rw [pow_one, ← IsLocalRing.residue_eq_zero_iff]
    have hcc := congrArg (fun z : MvPolynomial (Fin d) _ => z.coeff c) h
    simp only [MvPolynomial.coeff_map] at hcc
    rw [MvPolynomial.coeff_sub, map_sub, hcc, sub_self]
  have hmem := aeval_mem_pow_add (x := x) (maximalIdeal A) hx hsub hc
  rwa [map_sub, show 1 + n = n + 1 from by omega] at hmem

/-- The class in `𝔪ⁿ/𝔪ⁿ⁺¹` of the value at `x` of the degree-`n` homogeneous lift of a
polynomial over the residue field. -/
public def evalGradedPieceFun (hx : ∀ i, x i ∈ maximalIdeal A) (n : ℕ)
    (P : MvPolynomial (Fin d) (ResidueField A)) : IsLocalRing.gradedPiece A n :=
  gradedPieceMk A n ⟨MvPolynomial.aeval x (homogeneousResidueLift n P),
    aeval_mem_pow (maximalIdeal A) hx (isHomogeneous_homogeneousResidueLift n P)⟩

/-- **The value is computed by any homogeneous lift of the degree-`n` component.** -/
public theorem evalGradedPieceFun_eq (hx : ∀ i, x i ∈ maximalIdeal A) {n : ℕ}
    {P : MvPolynomial (Fin d) (ResidueField A)} {Q : MvPolynomial (Fin d) A}
    (hQ : Q.IsHomogeneous n)
    (hmap : MvPolynomial.map (IsLocalRing.residue A) Q = homogeneousComponent n P) :
    evalGradedPieceFun hx n P
      = gradedPieceMk A n ⟨MvPolynomial.aeval x Q,
          aeval_mem_pow (maximalIdeal A) hx hQ⟩ :=
  (gradedPieceMk_eq_iff _ _).mpr
    (aeval_sub_mem_of_map_eq hx (isHomogeneous_homogeneousResidueLift n P) hQ
      (by rw [map_homogeneousResidueLift, hmap]))

/-- The value dies exactly when a homogeneous lift evaluates into `𝔪ⁿ⁺¹`. -/
public theorem evalGradedPieceFun_eq_zero_iff (hx : ∀ i, x i ∈ maximalIdeal A) {n : ℕ}
    {P : MvPolynomial (Fin d) (ResidueField A)} {Q : MvPolynomial (Fin d) A}
    (hQ : Q.IsHomogeneous n)
    (hmap : MvPolynomial.map (IsLocalRing.residue A) Q = homogeneousComponent n P) :
    evalGradedPieceFun hx n P = 0 ↔
      MvPolynomial.aeval x Q ∈ maximalIdeal A ^ (n + 1) := by
  rw [evalGradedPieceFun_eq hx hQ hmap, gradedPieceMk_eq_zero_iff]

public theorem evalGradedPieceFun_add (hx : ∀ i, x i ∈ maximalIdeal A) (n : ℕ)
    (P Q : MvPolynomial (Fin d) (ResidueField A)) :
    evalGradedPieceFun hx n (P + Q)
      = evalGradedPieceFun hx n P + evalGradedPieceFun hx n Q := by
  rw [evalGradedPieceFun, evalGradedPieceFun, evalGradedPieceFun, ← map_add]
  refine (gradedPieceMk_eq_iff _ _).mpr ?_
  rw [Submodule.coe_add]
  rw [show MvPolynomial.aeval x (homogeneousResidueLift n P)
        + MvPolynomial.aeval x (homogeneousResidueLift n Q)
      = MvPolynomial.aeval x (homogeneousResidueLift n P + homogeneousResidueLift n Q) from
        (map_add _ _ _).symm]
  exact aeval_sub_mem_of_map_eq hx (isHomogeneous_homogeneousResidueLift n (P + Q))
    ((isHomogeneous_homogeneousResidueLift n P).add
      (isHomogeneous_homogeneousResidueLift n Q))
    (by rw [map_add, map_homogeneousResidueLift, map_homogeneousResidueLift,
      map_homogeneousResidueLift, map_add])

public theorem evalGradedPieceFun_residue_smul (hx : ∀ i, x i ∈ maximalIdeal A) (n : ℕ) (a : A)
    (P : MvPolynomial (Fin d) (ResidueField A)) :
    evalGradedPieceFun hx n (IsLocalRing.residue A a • P)
      = IsLocalRing.residue A a • evalGradedPieceFun hx n P := by
  have hQ : (MvPolynomial.C a * homogeneousResidueLift n P).IsHomogeneous n := by
    simpa using (MvPolynomial.isHomogeneous_C (Fin d) a).mul
      (isHomogeneous_homogeneousResidueLift n P)
  have hmap : MvPolynomial.map (IsLocalRing.residue A)
        (MvPolynomial.C a * homogeneousResidueLift n P)
      = homogeneousComponent n (IsLocalRing.residue A a • P) := by
    rw [map_mul, MvPolynomial.map_C, map_homogeneousResidueLift,
      MvPolynomial.smul_eq_C_mul, homogeneousComponent_C_mul]
  rw [evalGradedPieceFun_eq hx hQ hmap, evalGradedPieceFun,
    residue_smul_gradedPieceMk a (⟨MvPolynomial.aeval x (homogeneousResidueLift n P),
      aeval_mem_pow (maximalIdeal A) hx (isHomogeneous_homogeneousResidueLift n P)⟩ :
      ↥(maximalIdeal A ^ n))]
  congr 1
  exact Subtype.ext (by simp)

/-- **The `κ`-linear map `κ[t₁, …, t_d] → 𝔪ⁿ/𝔪ⁿ⁺¹`** given by lifting to `A`, taking the
degree-`n` homogeneous component and evaluating at the generators `x`. -/
public def evalGradedPiece (hx : ∀ i, x i ∈ maximalIdeal A) (n : ℕ) :
    MvPolynomial (Fin d) (ResidueField A) →ₗ[ResidueField A] IsLocalRing.gradedPiece A n where
  toFun := evalGradedPieceFun hx n
  map_add' := evalGradedPieceFun_add hx n
  map_smul' c P := by
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective (R := A) c
    exact evalGradedPieceFun_residue_smul hx n a P

@[simp]
public theorem evalGradedPiece_apply (hx : ∀ i, x i ∈ maximalIdeal A) (n : ℕ)
    (P : MvPolynomial (Fin d) (ResidueField A)) :
    evalGradedPiece hx n P = evalGradedPieceFun hx n P := rfl

end Lift

/-! ### The relation ideal -/

section RelationIdeal

variable {A : Type u} [CommRing A] [IsLocalRing A] {d : ℕ} {x : Fin d → A}

/-- The image of a homogeneous polynomial under a coefficient ring map is homogeneous. -/
public theorem isHomogeneous_map {R S : Type*} [CommRing R] [CommRing S] {σ : Type*}
    (φ : R →+* S) {n : ℕ} {P : MvPolynomial σ R} (hP : P.IsHomogeneous n) :
    (MvPolynomial.map φ P).IsHomogeneous n :=
  hP.map φ

/-- **Every class in `𝔪ⁿ/𝔪ⁿ⁺¹` is the value of a homogeneous polynomial of degree `n`**, for any
system of generators of the maximal ideal. -/
public theorem exists_isHomogeneous_evalGradedPieceFun_eq (hx : ∀ i, x i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A) (n : ℕ)
    (w : IsLocalRing.gradedPiece A n) :
    ∃ P : MvPolynomial (Fin d) (ResidueField A), P.IsHomogeneous n ∧
      evalGradedPieceFun hx n P = w := by
  obtain ⟨v, rfl⟩ := Submodule.mkQ_surjective
    (maximalIdeal A • ⊤ : Submodule A ↥(maximalIdeal A ^ n)) w
  obtain ⟨Q, hQ, hQv⟩ := exists_isHomogeneous_aeval_eq (x := x) n
    (show (v : A) ∈ Ideal.span (Set.range x) ^ n from by rw [hspan]; exact v.2)
  refine ⟨MvPolynomial.map (IsLocalRing.residue A) Q, isHomogeneous_map _ hQ, ?_⟩
  rw [evalGradedPieceFun_eq hx hQ
    (homogeneousComponent_eq_self (isHomogeneous_map (IsLocalRing.residue A) hQ)).symm]
  exact congrArg (gradedPieceMk A n) (Subtype.ext hQv)

/-- **The homogeneous ideal of relations among the generators `x` of the maximal ideal:** the
ideal of `κ[t₁, …, t_d]` generated by the homogeneous polynomials whose value in the corresponding
graded piece `𝔪ⁿ/𝔪ⁿ⁺¹` vanishes. -/
public def gradedRelationIdeal (hx : ∀ i, x i ∈ maximalIdeal A) :
    Ideal (MvPolynomial (Fin d) (ResidueField A)) :=
  Ideal.span {P | ∃ n, P.IsHomogeneous n ∧ evalGradedPieceFun hx n P = 0}

public theorem mem_gradedRelationIdeal_of_isHomogeneous (hx : ∀ i, x i ∈ maximalIdeal A) {n : ℕ}
    {P : MvPolynomial (Fin d) (ResidueField A)} (hP : P.IsHomogeneous n)
    (h : evalGradedPieceFun hx n P = 0) : P ∈ gradedRelationIdeal hx :=
  Ideal.subset_span ⟨n, hP, h⟩

/-- The relation ideal is homogeneous: it is generated by homogeneous elements. -/
public theorem isHomogeneous_gradedRelationIdeal (hx : ∀ i, x i ∈ maximalIdeal A) :
    Ideal.IsHomogeneous (MvPolynomial.homogeneousSubmodule (Fin d) (ResidueField A))
      (gradedRelationIdeal hx) :=
  Ideal.homogeneous_span _ _ (by rintro P ⟨n, hP, -⟩; exact ⟨n, hP⟩)

/-- The value of a polynomial dies exactly when the value at `x` of any homogeneous lift of it
lies in `𝔪ⁿ⁺¹`. -/
private theorem evalGradedPieceFun_eq_zero_iff_of_map_eq (hx : ∀ i, x i ∈ maximalIdeal A) {n : ℕ}
    {P : MvPolynomial (Fin d) (ResidueField A)} {Q : MvPolynomial (Fin d) A}
    (hQ : Q.IsHomogeneous n) (hmap : MvPolynomial.map (IsLocalRing.residue A) Q = P) :
    evalGradedPieceFun hx n P = 0 ↔ MvPolynomial.aeval x Q ∈ maximalIdeal A ^ (n + 1) := by
  subst hmap
  exact evalGradedPieceFun_eq_zero_iff hx hQ (homogeneousComponent_eq_self (hQ.map _)).symm

/-- Multiplying a homogeneous polynomial of degree `n` by a variable gives degree `n + 1`. -/
private theorem isHomogeneous_X_mul {R σ : Type*} [CommRing R] (i : σ) {n : ℕ}
    {P : MvPolynomial σ R} (hP : P.IsHomogeneous n) :
    (MvPolynomial.X i * P).IsHomogeneous (n + 1) := by
  simpa [Nat.add_comm] using (MvPolynomial.isHomogeneous_X R i).mul hP

/-- A homogeneous polynomial times a relation is a relation. This is all that is used of the
multiplicative structure of the associated graded ring. -/
public theorem evalGradedPiece_mul_eq_zero (hx : ∀ i, x i ∈ maximalIdeal A) {r m : ℕ}
    {R G : MvPolynomial (Fin d) (ResidueField A)} (hR : R.IsHomogeneous r)
    (hG : G.IsHomogeneous m) (hzero : evalGradedPieceFun hx m G = 0) :
    evalGradedPieceFun hx (r + m) (R * G) = 0 := by
  have hmapR : MvPolynomial.map (IsLocalRing.residue A) (homogeneousResidueLift r R) = R := by
    rw [map_homogeneousResidueLift, homogeneousComponent_eq_self hR]
  have hmapG : MvPolynomial.map (IsLocalRing.residue A) (homogeneousResidueLift m G) = G := by
    rw [map_homogeneousResidueLift, homogeneousComponent_eq_self hG]
  have hGmem : MvPolynomial.aeval x (homogeneousResidueLift m G) ∈ maximalIdeal A ^ (m + 1) :=
    (evalGradedPieceFun_eq_zero_iff_of_map_eq hx (isHomogeneous_homogeneousResidueLift m G)
      hmapG).mp hzero
  have hprod : (homogeneousResidueLift r R * homogeneousResidueLift m G).IsHomogeneous (r + m) :=
    (isHomogeneous_homogeneousResidueLift r R).mul (isHomogeneous_homogeneousResidueLift m G)
  rw [evalGradedPieceFun_eq_zero_iff_of_map_eq hx hprod (by rw [map_mul, hmapR, hmapG]), map_mul]
  have hmul := Ideal.mul_mem_mul
    (aeval_mem_pow (maximalIdeal A) hx (isHomogeneous_homogeneousResidueLift r R)) hGmem
  rwa [← pow_add, show r + (m + 1) = r + m + 1 from by omega] at hmul

/-- **A homogeneous element of the relation ideal is a relation.** The degree-`n` part of the
relation ideal is no larger than the kernel in degree `n`: a homogeneous polynomial in the span is
a combination of the generators with homogeneous coefficients, by
`AlgebraicGeometry.homogeneousComponent_mul_right`. -/
public theorem evalGradedPiece_eq_zero_of_mem (hx : ∀ i, x i ∈ maximalIdeal A) {n : ℕ}
    {P : MvPolynomial (Fin d) (ResidueField A)} (hP : P.IsHomogeneous n)
    (hmem : P ∈ gradedRelationIdeal hx) : evalGradedPiece hx n P = 0 := by
  classical
  obtain ⟨N, f, g, hsum⟩ := Submodule.mem_span_set'.mp hmem
  have hP' : P = ∑ i, homogeneousComponent n
      (f i * (g i : MvPolynomial (Fin d) (ResidueField A))) := by
    rw [← homogeneousComponent_eq_self hP, ← hsum, map_sum]
    exact Finset.sum_congr rfl fun i _ => by rw [smul_eq_mul]
  rw [hP', map_sum]
  refine Finset.sum_eq_zero fun i _ => ?_
  obtain ⟨e, hge, hgzero⟩ := (g i).2
  rcases le_or_gt e n with hle | hgt
  · obtain ⟨r, hr⟩ : ∃ r, n = r + e := ⟨n - e, by omega⟩
    subst hr
    rw [evalGradedPiece_apply, homogeneousComponent_mul_right hge]
    exact evalGradedPiece_mul_eq_zero hx (homogeneousComponent_isHomogeneous _ _) hge hgzero
  · rw [homogeneousComponent_mul_eq_zero_of_lt hge _ hgt, map_zero]

/-- **The degree-`n` piece of the relation ideal is the kernel in degree `n`.** -/
public theorem gradedPieceI_gradedRelationIdeal (hx : ∀ i, x i ∈ maximalIdeal A) (n : ℕ) :
    gradedPieceI (gradedRelationIdeal hx) n
      = LinearMap.ker (evalGradedPiece hx n) ⊓ gradedPieceS (ResidueField A) d n := by
  refine le_antisymm (fun P hP => ?_) (fun P hP => ?_)
  · obtain ⟨hP1, hP2⟩ := Submodule.mem_inf.mp hP
    exact Submodule.mem_inf.mpr
      ⟨LinearMap.mem_ker.mpr (evalGradedPiece_eq_zero_of_mem hx hP2 hP1), hP2⟩
  · obtain ⟨hP1, hP2⟩ := Submodule.mem_inf.mp hP
    exact Submodule.mem_inf.mpr
      ⟨mem_gradedRelationIdeal_of_isHomogeneous hx hP2 (LinearMap.mem_ker.mp hP1), hP2⟩

/-- **The Hilbert function of the quotient by the relation ideal is `dim_κ(𝔪ⁿ/𝔪ⁿ⁺¹)`.** -/
public theorem hilbertFunction_gradedRelationIdeal [IsNoetherianRing A]
    (hx : ∀ i, x i ∈ maximalIdeal A) (hspan : Ideal.span (Set.range x) = maximalIdeal A) (n : ℕ) :
    hilbertFunction (gradedRelationIdeal hx) n
      = Module.finrank (ResidueField A) (IsLocalRing.gradedPiece A n) := by
  classical
  have hfd := finiteDimensional_gradedPieceS (ResidueField A) d n
  have hle : gradedPieceI (gradedRelationIdeal hx) n ≤ gradedPieceS (ResidueField A) d n := by
    rw [gradedPieceI_gradedRelationIdeal hx n]
    exact inf_le_right
  have hkereq : Submodule.comap (gradedPieceS (ResidueField A) d n).subtype
        (gradedPieceI (gradedRelationIdeal hx) n)
      = LinearMap.ker ((evalGradedPiece hx n).comp
        (gradedPieceS (ResidueField A) d n).subtype) := by
    rw [gradedPieceI_gradedRelationIdeal hx n, Submodule.comap_inf,
      Submodule.comap_subtype_self, inf_top_eq, LinearMap.ker_comp]
  have hrange : LinearMap.range ((evalGradedPiece hx n).comp
      (gradedPieceS (ResidueField A) d n).subtype) = ⊤ := by
    rw [LinearMap.range_eq_top]
    intro w
    obtain ⟨P, hPhom, hPw⟩ := exists_isHomogeneous_evalGradedPieceFun_eq hx hspan n w
    exact ⟨⟨P, hPhom⟩, hPw⟩
  have hadd := LinearMap.finrank_range_add_finrank_ker
    ((evalGradedPiece hx n).comp (gradedPieceS (ResidueField A) d n).subtype)
  rw [hrange, finrank_top, ← hkereq,
    (Submodule.comapSubtypeEquivOfLe hle).finrank_eq] at hadd
  unfold hilbertFunction
  omega

/-- **The relation ideal of a rational double point is generated by its quadratic form.**

Let `x₁, x₂, x₃` generate the maximal ideal of a Noetherian local ring whose graded pieces have
dimensions `dim_κ(𝔪ⁿ/𝔪ⁿ⁺¹) = 2n + 1`, and let `q` be a nonzero quadratic form which is a relation
among them. Then the relation ideal is `(q)`: there are no further relations.

This is the algebraic content of the identification `E = V(q) ⊆ ℙ²_κ` in Section 54.12 of the
source. The dimension count is
`AlgebraicGeometry.eq_span_singleton_of_hilbertFunction_two_mul_add_one`, and the Hilbert function
of the quotient by the relation ideal is the sequence of graded dimensions by
`AlgebraicGeometry.hilbertFunction_gradedRelationIdeal`.

The dimension formula is a hypothesis, not a conclusion: the source proves it by Riemann–Roch on
the exceptional curve, which needs the embedding dimension of the singularity. See
`AlgebraicGeometry.BlowUpDualizing.finrank_gradedPiece_eq_two_mul_add_one`. -/
public theorem gradedRelationIdeal_eq_span_singleton [IsNoetherianRing A] {y : Fin 3 → A}
    (hy : ∀ i, y i ∈ maximalIdeal A) (hspan : Ideal.span (Set.range y) = maximalIdeal A)
    (hdim : ∀ n, Module.finrank (ResidueField A) (IsLocalRing.gradedPiece A n) = 2 * n + 1)
    {q : MvPolynomial (Fin 3) (ResidueField A)} (hq : q.IsHomogeneous 2) (hq0 : q ≠ 0)
    (hqrel : evalGradedPieceFun hy 2 q = 0) :
    gradedRelationIdeal hy = Ideal.span {q} :=
  eq_span_singleton_of_hilbertFunction_two_mul_add_one hq hq0
    (isHomogeneous_gradedRelationIdeal hy)
    (mem_gradedRelationIdeal_of_isHomogeneous hy hq hqrel)
    (fun n => by
      rw [hilbertFunction_gradedRelationIdeal hy hspan n, hdim n])

end RelationIdeal

/-! ### A good coordinate is a superficial element -/

section Superficial

variable {A : Type u} [CommRing A] [IsLocalRing A] {d : ℕ} {x : Fin (d + 1) → A}

/-- **A good coordinate is a superficial element of the maximal ideal.**

Suppose the relation ideal among the generators `x₁, …, x_{d+1}` of `𝔪` is the principal ideal
generated by `q`, and that `t₁` does not divide `q`. Then multiplication by `x₁` is injective on
the associated graded module: if `v ∈ 𝔪ⁿ` and `x₁v ∈ 𝔪ⁿ⁺²` then already `v ∈ 𝔪ⁿ⁺¹`.

For the quadratic form of a rational double point `t₁ ∤ q` is exactly the condition that `x₁` is
a good coordinate in the sense of Section 54.12: `q(0, t₂, t₃) ≠ 0`, which is implied by
`AlgebraicGeometry.IsGoodCoordinateForm` since the zero form is a scalar times the square of a
linear form. Geometrically it says that no component of the exceptional divisor `E = V(q)` lies in
the hyperplane `t₁ = 0`, so `x₁` cuts `E` out on the chart it determines. -/
public theorem mem_pow_succ_of_mul_mem_pow (hx : ∀ i, x i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    {q : MvPolynomial (Fin (d + 1)) (ResidueField A)}
    (hI : gradedRelationIdeal hx = Ideal.span {q})
    (hdvd : ¬ (MvPolynomial.X (0 : Fin (d + 1)) ∣ q))
    {n : ℕ} {v : A} (hv : v ∈ maximalIdeal A ^ n)
    (hmul : x 0 * v ∈ maximalIdeal A ^ (n + 2)) :
    v ∈ maximalIdeal A ^ (n + 1) := by
  obtain ⟨Q, hQ, hQv⟩ := exists_isHomogeneous_aeval_eq (x := x) n (by rw [hspan]; exact hv)
  set P := MvPolynomial.map (IsLocalRing.residue A) Q with hP
  have hPhom : P.IsHomogeneous n := isHomogeneous_map _ hQ
  -- `t₁ P` is a relation of degree `n + 1`
  have hXQ := isHomogeneous_X_mul (0 : Fin (d + 1)) hQ
  have hXP := isHomogeneous_X_mul (0 : Fin (d + 1)) hPhom
  have hzero : evalGradedPieceFun hx (n + 1) (MvPolynomial.X (0 : Fin (d + 1)) * P) = 0 := by
    rw [evalGradedPieceFun_eq_zero_iff_of_map_eq hx hXQ (by rw [map_mul, MvPolynomial.map_X]),
      map_mul, MvPolynomial.aeval_X, hQv]
    exact hmul
  -- hence `q` divides `t₁ P`, and `t₁` being prime and not dividing `q` makes `q` divide `P`
  have hdvdXP : q ∣ MvPolynomial.X (0 : Fin (d + 1)) * P := by
    rw [← Ideal.mem_span_singleton, ← hI]
    exact mem_gradedRelationIdeal_of_isHomogeneous hx hXP hzero
  obtain ⟨R, hR⟩ := hdvdXP
  have hXprime : Prime (MvPolynomial.X (0 : Fin (d + 1)) : MvPolynomial (Fin (d + 1))
      (ResidueField A)) := MvPolynomial.X_prime
  have hXdvdR : MvPolynomial.X (0 : Fin (d + 1)) ∣ R := by
    rcases hXprime.dvd_mul.mp ⟨P, hR.symm⟩ with h | h
    · exact absurd h hdvd
    · exact h
  obtain ⟨R', hR'⟩ := hXdvdR
  have hqP : q ∣ P := by
    refine ⟨R', mul_left_cancel₀ (MvPolynomial.X_ne_zero (0 : Fin (d + 1))) ?_⟩
    rw [hR, hR']
    ring
  -- so `P` is a relation of degree `n`, which is the assertion
  have hPrel : evalGradedPieceFun hx n P = 0 :=
    evalGradedPiece_eq_zero_of_mem hx hPhom
      (by rw [hI, Ideal.mem_span_singleton]; exact hqP)
  rw [← hQv]
  exact (evalGradedPieceFun_eq_zero_iff_of_map_eq hx hQ rfl).mp hPrel

end Superficial

end AlgebraicGeometry

