module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ChartClaim
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ChartEmbeddingDimension
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.FormPolynomial

/-!
# A singular point of the chart lies on the singular locus of the quadric

Let `A` be a Noetherian local ring with maximal ideal generated by `x₁, x₂, x₃`, satisfying a
quadratic relation `Σ aᵢⱼ xᵢxⱼ ∈ 𝔪³`, and let `𝔪'` be a maximal ideal of the chart
`A' = A[𝔪/x₁]` containing `x₁`, corresponding to the maximal ideal `M` of `κ[y₂, y₃]` under
the surjection `κ[y₂, y₃] → A'/x₁A'`. If `A'_{𝔪'}` has dimension two and is not regular, then

`q(1, y₂, y₃) = ā₁₁ + ā₁₂y₂ + ā₁₃y₃ + ā₂₂y₂² + ā₂₃y₂y₃ + ā₃₃y₃² ∈ M²`.

This is the first step of the Claim in Section 54.12 of the Stacks project. No hypothesis on `x₁`
is needed beyond `q(1, y₂, y₃)` mapping to zero in `A'/x₁A'`.

## Main results

* `AlgebraicGeometry.dehomogenized_mem_sq_of_not_isRegularLocalRing`: `M` is a maximal ideal and
  `q(1, y₂, y₃) ∈ M²`.
* `AlgebraicGeometry.exists_ne_top_dehomogenized_mem_sq_of_not_isRegularLocalRing`: the same for
  the chart at an arbitrary spelling of `x₁` and of the maximal ideal.
-/

@[expose] public noncomputable section

open IsLocalRing MvPolynomial

universe u

namespace AlgebraicGeometry

variable {A : Type u} [CommRing A] [IsLocalRing A] {x : Fin 3 → A}
  (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away (x 0) S]

/-- The dehomogenized quadratic form of a relation modulo `𝔪³` maps to zero in the chart
quotient. -/
theorem chartPresentation_dehomogenized_eq_zero (hx : ∀ i, x i ∈ maximalIdeal A)
    (a : Fin 3 → Fin 3 → A) (hupper : ∀ p r, r < p → a p r = 0)
    (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3) :
    chartPresentation S hx (C (residue A (a 0 0)) + C (residue A (a 0 1)) * X 0 +
      C (residue A (a 0 2)) * X 1 + C (residue A (a 1 1)) * X 0 ^ 2 +
      C (residue A (a 1 2)) * X 0 * X 1 + C (residue A (a 2 2)) * X 1 ^ 2) = 0 := by
  rw [← dehomogenizeFirst_quadraticFormPoly_fin_three (fun p r => residue A (a p r))
    (fun p r h => by simp [hupper p r h]),
    chartPresentation_dehomogenizeFirst_eq_mk_fraction S hx
      (isHomogeneous_quadraticFormPoly a) (map_quadraticFormPoly _ a),
    Ideal.Quotient.eq_zero_iff_mem]
  exact fraction_mem_span_singleton_of_mem_pow_succ S hx _
    (by rw [aeval_quadraticFormPoly]; exact hrel)

/-- At a maximal ideal `𝔪'` of the chart containing `x₁`, if the local ring has dimension at least
two and is not regular, then the ideal `M` of `κ[y₂, y₃]` cutting out the point is maximal and
the dehomogenized quadratic form lies in `M ^ 2`. -/
theorem dehomogenized_mem_sq_of_not_isRegularLocalRing [IsNoetherianRing A]
    (hx : ∀ i, x i ∈ maximalIdeal A) (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (a : Fin 3 → Fin 3 → A) (hupper : ∀ p r, r < p → a p r = 0)
    (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3)
    (z : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S)) [hz : z.IsMaximal]
    (hx0 : algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0) ∈ z)
    [IsNoetherianRing (Localization.AtPrime z)]
    (hdim : 2 ≤ ringKrullDim (Localization.AtPrime z))
    (hsing : ¬ IsRegularLocalRing (Localization.AtPrime z)) :
    let M := Ideal.comap (chartPresentation S hx)
      (Ideal.map (Ideal.Quotient.mk (Ideal.span
        {algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)})) z)
    M.IsMaximal ∧
      (C (residue A (a 0 0)) + C (residue A (a 0 1)) * X 0 +
        C (residue A (a 0 2)) * X 1 + C (residue A (a 1 1)) * X 0 ^ 2 +
        C (residue A (a 1 2)) * X 0 * X 1 + C (residue A (a 2 2)) * X 1 ^ 2 :
          MvPolynomial (Fin 2) (ResidueField A)) ∈ M ^ 2 := by
  intro M
  let A' := affineBlowupAlgebra (maximalIdeal A) (x 0) S
  let J : Ideal A' := Ideal.span {algebraMap A A' (x 0)}
  have hJz : J ≤ z := (Ideal.span_singleton_le_iff_mem _).mpr hx0
  have hπ : Function.Surjective (chartPresentation S hx) := chartPresentation_surjective S hx hspan
  let zbar : Ideal (A' ⧸ J) := Ideal.map (Ideal.Quotient.mk J) z
  have hmem : ∀ w, Ideal.Quotient.mk J w ∈ zbar ↔ w ∈ z := fun w =>
    Ideal.mem_quotient_iff_mem hJz
  have : zbar.IsMaximal := by
    refine (Ideal.map_eq_top_or_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective
      hz).resolve_left fun htop => hz.ne_top <| (Ideal.eq_top_iff_one _).2 <| (hmem 1).1 ?_
    rw [map_one, show zbar = ⊤ from htop]
    exact Submodule.mem_top
  have hM : M.IsMaximal := Ideal.comap_isMaximal_of_surjective _ hπ
  refine ⟨hM, ?_⟩
  set f : MvPolynomial (Fin 2) (ResidueField A) := C (residue A (a 0 0)) +
    C (residue A (a 0 1)) * X 0 + C (residue A (a 0 2)) * X 1 + C (residue A (a 1 1)) * X 0 ^ 2 +
    C (residue A (a 1 2)) * X 0 * X 1 + C (residue A (a 2 2)) * X 1 ^ 2 with hfdef
  have hf0 : chartPresentation S hx f = 0 :=
    chartPresentation_dehomogenized_eq_zero S hx a hupper hrel
  have hfM : f ∈ M := by
    change chartPresentation S hx f ∈ zbar
    exact hf0 ▸ zbar.zero_mem
  by_contra hf2
  apply hsing
  let B := Localization.AtPrime z
  let JB : Ideal B := Ideal.span {algebraMap A' B (algebraMap A A' (x 0))}
  let θ : A' ⧸ J →+* B ⧸ JB := Ideal.Quotient.lift J
    ((Ideal.Quotient.mk JB).comp (algebraMap A' B)) (fun w hw => by
      rw [RingHom.comp_apply, Ideal.Quotient.eq_zero_iff_mem]
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hw
      rw [map_mul]
      exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
  let ρ₀ : MvPolynomial (Fin 2) (ResidueField A) →+* B ⧸ JB := θ.comp (chartPresentation S hx)
  have hunit : ∀ t : M.primeCompl, IsUnit (ρ₀ t) := by
    rintro ⟨t, ht⟩
    obtain ⟨w, hw⟩ := Ideal.Quotient.mk_surjective (I := J) (chartPresentation S hx t)
    have hwz : w ∉ z := fun hwz' => ht <|
      show chartPresentation S hx t ∈ zbar from hw ▸ (hmem w).2 hwz'
    change IsUnit (θ (chartPresentation S hx t))
    rw [← hw]
    exact (IsLocalization.map_units B (⟨w, hwz⟩ : z.primeCompl)).map (Ideal.Quotient.mk JB)
  let ρ : Localization.AtPrime M →+* B ⧸ JB := IsLocalization.lift hunit
  have hρsurj : Function.Surjective ρ := by
    intro b
    obtain ⟨b', rfl⟩ := Ideal.Quotient.mk_surjective b
    obtain ⟨⟨w, s⟩, rfl⟩ := IsLocalization.mk'_surjective z.primeCompl b'
    obtain ⟨p, hp⟩ := hπ (Ideal.Quotient.mk J w)
    obtain ⟨t, ht⟩ := hπ (Ideal.Quotient.mk J (s : A'))
    have htM : t ∈ M.primeCompl := fun htm =>
      s.2 <| (hmem s).1 (ht ▸ (show chartPresentation S hx t ∈ zbar from htm))
    refine ⟨IsLocalization.mk' (Localization.AtPrime M) p ⟨t, htM⟩, ?_⟩
    rw [IsLocalization.lift_mk'_spec]
    change θ (chartPresentation S hx p) = θ (chartPresentation S hx t) *
      Ideal.Quotient.mk JB (IsLocalization.mk' B w s)
    rw [hp, ht]
    change Ideal.Quotient.mk JB (algebraMap A' B w) =
      Ideal.Quotient.mk JB (algebraMap A' B s) * Ideal.Quotient.mk JB (IsLocalization.mk' B w s)
    rw [← map_mul, mul_comm, IsLocalization.mk'_spec]
  have hρf : ρ (algebraMap _ (Localization.AtPrime M) f) = 0 := by
    rw [IsLocalization.lift_eq]
    change θ (chartPresentation S hx f) = 0
    rw [hf0, map_zero]
  exact isRegularLocalRing_of_surjective_localization_quotient hdim
    (x₀ := algebraMap A' B (algebraMap A A' (x 0)))
    (by
      rw [← Localization.AtPrime.map_eq_maximalIdeal]
      exact Ideal.mem_map_of_mem _ hx0) M ρ hρsurj hfM hf2 hρf

/-- For the chart at an element `a₀ = x₁` and an ideal `Mx` equal to the maximal ideal: if the
local ring at a maximal ideal containing `a₀` has dimension at least two and is not regular, then
the dehomogenized quadratic form lies in the square of a proper ideal of `κ[y₂, y₃]`. -/
theorem exists_ne_top_dehomogenized_mem_sq_of_not_isRegularLocalRing [IsNoetherianRing A]
    {x : Fin 3 → A}
    (Mx : Ideal A) (hM : maximalIdeal A = Mx) (a₀ : A) (ha₀ : x 0 = a₀) (S : Type u) [CommRing S]
    [Algebra A S] [IsLocalization.Away a₀ S]
    (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (a : Fin 3 → Fin 3 → A) (hupper : ∀ p r, r < p → a p r = 0)
    (hrel : ∑ p, ∑ r, a p r * (x p * x r) ∈ maximalIdeal A ^ 3)
    (z : Ideal (affineBlowupAlgebra Mx a₀ S)) [z.IsMaximal]
    (hx0 : algebraMap A (affineBlowupAlgebra Mx a₀ S) a₀ ∈ z)
    [IsNoetherianRing (Localization.AtPrime z)]
    (hdim : 2 ≤ ringKrullDim (Localization.AtPrime z))
    (hsing : ¬ IsRegularLocalRing (Localization.AtPrime z)) :
    ∃ I : Ideal (MvPolynomial (Fin 2) (ResidueField A)), I ≠ ⊤ ∧
      (C (residue A (a 0 0)) + C (residue A (a 0 1)) * X 0 +
        C (residue A (a 0 2)) * X 1 + C (residue A (a 1 1)) * X 0 ^ 2 +
        C (residue A (a 1 2)) * X 0 * X 1 + C (residue A (a 2 2)) * X 1 ^ 2 :
          MvPolynomial (Fin 2) (ResidueField A)) ∈ I ^ 2 := by
  subst hM ha₀
  have hx : ∀ i, x i ∈ maximalIdeal A := fun i => hspan ▸ Ideal.subset_span ⟨i, rfl⟩
  obtain ⟨hmax, hmem⟩ := dehomogenized_mem_sq_of_not_isRegularLocalRing S hx hspan a hupper hrel
    z hx0 hdim hsing
  exact ⟨_, hmax.ne_top, hmem⟩

end AlgebraicGeometry

end
