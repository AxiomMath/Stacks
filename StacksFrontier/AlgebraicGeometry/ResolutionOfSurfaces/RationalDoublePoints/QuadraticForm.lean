/-!
# The quadratic form of a rational double point

A two-dimensional Gorenstein rational surface singularity has embedding dimension three and its
graded pieces have dimensions `dim_κ(𝔪ⁿ/𝔪ⁿ⁺¹) = 2n + 1`. In particular `𝔪` needs exactly three
generators `x₁, x₂, x₃`, while `dim_κ(𝔪²/𝔪³) = 5` is smaller than the number `6` of products
`xᵢxⱼ` with `i ≤ j`, so those products satisfy a relation

`a₁₁x₁² + a₁₂x₁x₂ + a₁₃x₁x₃ + a₂₂x₂² + a₂₃x₂x₃ + a₃₃x₃² = Σ aᵢⱼₖ xᵢxⱼxₖ`

with coefficients `aᵢⱼ` not all in `𝔪`. The residues of the `aᵢⱼ` are the coefficients of the
quadratic form `q` which classifies the singularity, and on the affine blowup chart
`A[𝔪/x₁]`, where `yᵢ = xᵢ/x₁`, the relation becomes

`Σ aᵢⱼ yᵢyⱼ = x₁ · Σ aᵢⱼₖ yᵢyⱼyₖ`.

This file provides those steps: the graded pieces of the maximal-ideal filtration as vector
spaces over the residue field, the three generators, the quadratic relation, and its image on an
affine blowup chart.

## Main definitions

* `IsLocalRing.gradedPiece`: the graded piece `𝔪ⁿ/𝔪ⁿ⁺¹` of the maximal-ideal filtration of a
  local ring, as a vector space over the residue field. Its value at `n = 1` is Mathlib's
  `IsLocalRing.CotangentSpace`.
* `IsLocalRing.gradedPieceMk`: the quotient map `𝔪ⁿ → 𝔪ⁿ/𝔪ⁿ⁺¹`.

## Main results

* `AlgebraicGeometry.exists_span_eq_maximalIdeal_of_finrank_cotangentSpace`: a local ring whose
  cotangent space has dimension `n` has a maximal ideal generated by `n` elements.
* `AlgebraicGeometry.exists_quadraticRelation`: three elements of the maximal ideal whose six
  products `xᵢxⱼ`, `i ≤ j`, outnumber the dimension of `𝔪²/𝔪³` satisfy a relation modulo `𝔪³`
  with coefficients not all in `𝔪`.
* `AlgebraicGeometry.exists_quadraticRelation_cubicExpansion`: the same relation with its right
  hand side written out as a combination of the triple products `xᵢxⱼxₖ`.
* `AlgebraicGeometry.chart_relation`: the image of such a relation under a ring map which divides
  `x₁, x₂, x₃` by `x₁`.
* `AlgebraicGeometry.affineBlowupAlgebra_chart_relation`: that image inside the affine blowup
  algebra `A[𝔪/x₁]`, where the quotients `xᵢ/x₁` are the canonical fractions.

## Implementation notes

`𝔪ⁿ/𝔪ⁿ⁺¹` is realized as the quotient of `𝔪ⁿ`, viewed as an `A`-module, by `𝔪 • ⊤`; the
identification `𝔪 · 𝔪ⁿ = 𝔪ⁿ⁺¹` is `IsLocalRing.gradedPieceMk_eq_zero_iff`. The residue field acts
because the quotient is killed by `𝔪`.

The six products `xᵢxⱼ` with `i ≤ j` are indexed by the subtype of ordered pairs in
`Fin 3 × Fin 3`, and the resulting coefficients are packaged as an upper triangular matrix. The
triple products are indexed by all of `Fin 3 × Fin 3 × Fin 3`, which spans the same ideal as the
ordered triples do.

The chart relation is stated for an arbitrary ring map `f` and an arbitrary family `yᵢ` with
`f(x₁)yᵢ = f(xᵢ)`, with `f(x₁)` a nonzerodivisor; that covers both the localization
`A[1/x₁]` and the affine blowup algebra `A[𝔪/x₁]`.

## References

* [Stacks Project, Tag 0BGE](https://stacks.math.columbia.edu/tag/0BGE)
* [Stacks Project, Tag 0BGC](https://stacks.math.columbia.edu/tag/0BGC)
* [Stacks Project, Tag 052Q](https://stacks.math.columbia.edu/tag/052Q)
-/

@[expose] public section

open IsLocalRing

open scoped Pointwise

universe u v

namespace IsLocalRing

variable (A : Type u) [CommRing A] [IsLocalRing A]

/-- The graded piece `𝔪ⁿ/𝔪ⁿ⁺¹` of the maximal-ideal filtration of a local ring, as the quotient
of the `A`-module `𝔪ⁿ` by the action of the maximal ideal. -/
@[ega "III 4.3.13" "partial"]
public abbrev gradedPiece (n : ℕ) : Type u :=
  ↥(maximalIdeal A ^ n) ⧸ (maximalIdeal A • ⊤ : Submodule A ↥(maximalIdeal A ^ n))

/-- The graded piece `𝔪ⁿ/𝔪ⁿ⁺¹` is a vector space over the residue field. -/
public noncomputable instance (n : ℕ) : Module (ResidueField A) (gradedPiece A n) :=
  inferInstanceAs <| Module (A ⧸ maximalIdeal A) _

public instance (n : ℕ) : IsScalarTower A (ResidueField A) (gradedPiece A n) :=
  inferInstanceAs <| IsScalarTower A (A ⧸ maximalIdeal A) _

public instance [IsNoetherianRing A] (n : ℕ) :
    FiniteDimensional (ResidueField A) (gradedPiece A n) :=
  Module.Finite.of_restrictScalars_finite A _ _

/-- The quotient map `𝔪ⁿ → 𝔪ⁿ/𝔪ⁿ⁺¹`. -/
public noncomputable def gradedPieceMk (n : ℕ) :
    ↥(maximalIdeal A ^ n) →ₗ[A] gradedPiece A n :=
  Submodule.mkQ _

variable {A}

/-- An element of `𝔪ⁿ` dies in `𝔪ⁿ/𝔪ⁿ⁺¹` exactly when it lies in `𝔪ⁿ⁺¹`. -/
public theorem gradedPieceMk_eq_zero_iff {n : ℕ} (y : ↥(maximalIdeal A ^ n)) :
    gradedPieceMk A n y = 0 ↔ (y : A) ∈ maximalIdeal A ^ (n + 1) := by
  rw [gradedPieceMk, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero,
    Submodule.mem_smul_top_iff]
  simp [smul_eq_mul, ← pow_succ']

/-- Scaling in `𝔪ⁿ/𝔪ⁿ⁺¹` by a residue class is scaling the representative by a lift. -/
public theorem residue_smul_gradedPieceMk {n : ℕ} (c : A) (y : ↥(maximalIdeal A ^ n)) :
    residue A c • gradedPieceMk A n y = gradedPieceMk A n (c • y) := rfl

/-- The first graded piece is the cotangent space. -/
public theorem finrank_gradedPiece_one :
    Module.finrank (ResidueField A) (gradedPiece A 1) =
      Module.finrank (ResidueField A) (CotangentSpace A) := by
  have key : ∀ I J : Ideal A, I = J →
      Module.finrank (A ⧸ maximalIdeal A) (↥I ⧸ (maximalIdeal A • ⊤ : Submodule A ↥I)) =
        Module.finrank (A ⧸ maximalIdeal A) (↥J ⧸ (maximalIdeal A • ⊤ : Submodule A ↥J)) := by
    rintro I J rfl
    rfl
  exact key _ _ (pow_one _)

end IsLocalRing

namespace AlgebraicGeometry

variable {A : Type u} [CommRing A] [IsLocalRing A]

/-! ### Embedding dimension: generators of the maximal ideal -/

/-- A local ring with finitely generated maximal ideal whose cotangent space has dimension `n`
has a maximal ideal generated by `n` elements. -/
public theorem exists_span_eq_maximalIdeal_of_finrank_cotangentSpace {n : ℕ}
    (hfg : (maximalIdeal A).FG)
    (h : Module.finrank (ResidueField A) (CotangentSpace A) = n) :
    ∃ x : Fin n → A, Ideal.span (Set.range x) = maximalIdeal A := by
  classical
  have hsf : (maximalIdeal A).spanFinrank = n := by
    rw [IsLocalRing.spanFinrank_maximalIdeal_eq_finrank_cotangentSpace_of_fg hfg, h]
  obtain ⟨s, hcard, hspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank hfg
  rw [hsf] at hcard
  let e := s.equivFinOfCardEq hcard
  refine ⟨fun i => (e.symm i : A), ?_⟩
  have hr : Set.range (fun i => ((e.symm i : { z // z ∈ s }) : A)) = (s : Set A) := by
    ext z
    simp only [Set.mem_range]
    exact ⟨fun ⟨i, hi⟩ => hi ▸ (e.symm i).2, fun hz => ⟨e ⟨z, hz⟩, by simp⟩⟩
  rwa [hr]

/-! ### The quadratic relation -/

omit [IsLocalRing A] in
/-- A double sum over `Fin n` whose coefficients are supported on the pairs `i ≤ j` is a sum over
those pairs. -/
public theorem sum_sum_dite_le_eq_sum {n : ℕ} (c : {p : Fin n × Fin n // p.1 ≤ p.2} → A)
    (g : Fin n → Fin n → A) :
    ∑ i, ∑ j, (if h : i ≤ j then c ⟨(i, j), h⟩ else 0) * g i j =
      ∑ p : {p : Fin n × Fin n // p.1 ≤ p.2}, c p * g p.1.1 p.1.2 := by
  set f : Fin n × Fin n → A := fun q =>
    (if h : q.1 ≤ q.2 then c ⟨(q.1, q.2), h⟩ else 0) * g q.1 q.2 with hf
  calc ∑ i, ∑ j, (if h : i ≤ j then c ⟨(i, j), h⟩ else 0) * g i j
      = ∑ q : Fin n × Fin n, f q := (Fintype.sum_prod_type f).symm
    _ = ∑ q ∈ Finset.univ.filter (fun q : Fin n × Fin n => q.1 ≤ q.2), f q := by
        refine (Finset.sum_subset (Finset.filter_subset _ _) fun q _ hq => ?_).symm
        simp only [Finset.mem_filter, Finset.mem_univ, true_and] at hq
        simp [hf, hq]
    _ = ∑ p : {p : Fin n × Fin n // p.1 ≤ p.2}, f ↑p := Finset.sum_subtype _ (fun q => by simp) f
    _ = ∑ p : {p : Fin n × Fin n // p.1 ≤ p.2}, c p * g p.1.1 p.1.2 :=
        Finset.sum_congr rfl fun p _ => by
          rw [hf]
          simp only [dite_eq_left p.2]

/-- Three elements of the maximal ideal of a Noetherian local ring whose six products `xᵢxⱼ`,
`i ≤ j`, outnumber the dimension of `𝔪²/𝔪³` satisfy a relation modulo `𝔪³` whose coefficients,
arranged as an upper triangular matrix, include one that is a unit. -/
public theorem exists_quadraticRelation [IsNoetherianRing A]
    (hrank : Module.finrank (ResidueField A) (gradedPiece A 2) < 6)
    (x : Fin 3 → A) (hx : ∀ i, x i ∈ maximalIdeal A) :
    ∃ a : Fin 3 → Fin 3 → A, (∀ i j, j < i → a i j = 0) ∧
      (∃ i j, i ≤ j ∧ a i j ∉ maximalIdeal A) ∧
      ∑ i, ∑ j, a i j * (x i * x j) ∈ maximalIdeal A ^ 3 := by
  classical
  have hmem : ∀ p : Fin 3 × Fin 3, x p.1 * x p.2 ∈ maximalIdeal A ^ 2 := by
    intro p
    rw [pow_two]
    exact Ideal.mul_mem_mul (hx p.1) (hx p.2)
  set v : {p : Fin 3 × Fin 3 // p.1 ≤ p.2} → gradedPiece A 2 :=
    fun p => gradedPieceMk A 2 ⟨x p.1.1 * x p.1.2, hmem p.1⟩ with hv
  have hdep : ¬ LinearIndependent (ResidueField A) v := by
    intro hind
    have h6 := hind.fintype_card_le_finrank
    rw [show Fintype.card {p : Fin 3 × Fin 3 // p.1 ≤ p.2} = 6 from by decide] at h6
    omega
  obtain ⟨g, hsum, k, hk⟩ := Fintype.not_linearIndependent_iff.mp hdep
  choose c hc using fun p => IsLocalRing.residue_surjective (R := A) (g p)
  refine ⟨fun i j => if h : i ≤ j then c ⟨(i, j), h⟩ else 0, ?_, ?_, ?_⟩
  · intro i j hij
    simp [not_le.mpr hij]
  · refine ⟨k.1.1, k.1.2, k.2, ?_⟩
    have hce : (if h : k.1.1 ≤ k.1.2 then c ⟨(k.1.1, k.1.2), h⟩ else 0) = c k :=
      dite_eq_left k.2
    simp only [hce]
    exact fun hm => hk (by rwa [← hc k, IsLocalRing.residue_eq_zero_iff])
  · have hz : gradedPieceMk A 2
        (∑ p, c p • (⟨x p.1.1 * x p.1.2, hmem p.1⟩ : ↥(maximalIdeal A ^ 2))) = 0 := by
      rw [map_sum, ← hsum]
      refine Finset.sum_congr rfl fun p _ => ?_
      rw [← residue_smul_gradedPieceMk, hc p, hv]
    rw [gradedPieceMk_eq_zero_iff, AddSubmonoidClass.coe_finsetSum] at hz
    simp only [SetLike.val_smul, smul_eq_mul] at hz
    rwa [sum_sum_dite_le_eq_sum]

/-! ### The cube of the maximal ideal -/

omit [IsLocalRing A] in
/-- The cube of an ideal generated by a finite family is generated by the triple products of that
family. -/
public theorem span_pow_three_eq_span_triples {n : ℕ} (x : Fin n → A) :
    Ideal.span (Set.range x) ^ 3 =
      Ideal.span (Set.range fun t : Fin n × Fin n × Fin n => x t.1 * x t.2.1 * x t.2.2) := by
  have hset : (Set.range x) * (Set.range x) * (Set.range x) =
      Set.range fun t : Fin n × Fin n × Fin n => x t.1 * x t.2.1 * x t.2.2 := by
    ext z
    constructor
    · rintro ⟨_, ⟨_, ⟨i, rfl⟩, _, ⟨j, rfl⟩, rfl⟩, _, ⟨k, rfl⟩, rfl⟩
      exact ⟨(i, j, k), rfl⟩
    · rintro ⟨t, rfl⟩
      exact Set.mul_mem_mul (Set.mul_mem_mul ⟨_, rfl⟩ ⟨_, rfl⟩) ⟨_, rfl⟩
  rw [pow_three', Ideal.span_mul_span, Ideal.span_mul_span, hset]

omit [IsLocalRing A] in
/-- An element of the ideal generated by the triple products of a finite family is a combination
of those triple products. -/
public theorem exists_triple_expansion {n : ℕ} (x : Fin n → A) {z : A}
    (hz : z ∈ Ideal.span
      (Set.range fun t : Fin n × Fin n × Fin n => x t.1 * x t.2.1 * x t.2.2)) :
    ∃ b : Fin n → Fin n → Fin n → A, z = ∑ i, ∑ j, ∑ k, b i j k * (x i * x j * x k) := by
  rw [Ideal.span, Submodule.mem_span_range_iff_exists_fun] at hz
  obtain ⟨c, hc⟩ := hz
  refine ⟨fun i j k => c (i, j, k), ?_⟩
  rw [← hc, Fintype.sum_prod_type]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Fintype.sum_prod_type]
  exact Finset.sum_congr rfl fun j _ => Finset.sum_congr rfl fun k _ => by simp [smul_eq_mul]

/-- The quadratic relation of `AlgebraicGeometry.exists_quadraticRelation` with its right hand
side written out as a combination of the triple products, for a family generating the maximal
ideal. This is the displayed relation of the source's discussion of rational double points. -/
public theorem exists_quadraticRelation_cubicExpansion [IsNoetherianRing A]
    (hrank : Module.finrank (ResidueField A) (gradedPiece A 2) < 6)
    (x : Fin 3 → A) (hspan : Ideal.span (Set.range x) = maximalIdeal A) :
    ∃ (a : Fin 3 → Fin 3 → A) (b : Fin 3 → Fin 3 → Fin 3 → A),
      (∀ i j, j < i → a i j = 0) ∧ (∃ i j, i ≤ j ∧ a i j ∉ maximalIdeal A) ∧
      ∑ i, ∑ j, a i j * (x i * x j) = ∑ i, ∑ j, ∑ k, b i j k * (x i * x j * x k) := by
  have hx : ∀ i, x i ∈ maximalIdeal A := fun i => hspan.le (Ideal.subset_span ⟨i, rfl⟩)
  obtain ⟨a, hupper, hunit, hcube⟩ := exists_quadraticRelation hrank x hx
  rw [← hspan, span_pow_three_eq_span_triples] at hcube
  obtain ⟨b, hb⟩ := exists_triple_expansion x hcube
  exact ⟨a, b, hupper, hunit, hb⟩

/-! ### The relation on an affine blowup chart -/

omit [IsLocalRing A] in
/-- The image of a quadratic relation `Σ aᵢⱼxᵢxⱼ = Σ aᵢⱼₖxᵢxⱼxₖ` under a ring map `f` together
with a family `yᵢ` dividing `xᵢ` by `x₁`: the relation becomes
`Σ aᵢⱼyᵢyⱼ = x₁ · Σ aᵢⱼₖyᵢyⱼyₖ`. -/
public theorem chart_relation {S : Type v} [CommRing S] (f : A →+* S)
    (x : Fin 3 → A) (a : Fin 3 → Fin 3 → A) (b : Fin 3 → Fin 3 → Fin 3 → A)
    (y : Fin 3 → S) (hy : ∀ i, f (x 0) * y i = f (x i))
    (hreg : IsLeftRegular (f (x 0)))
    (hrel : ∑ i, ∑ j, a i j * (x i * x j) = ∑ i, ∑ j, ∑ k, b i j k * (x i * x j * x k)) :
    ∑ i, ∑ j, f (a i j) * (y i * y j)
      = f (x 0) * ∑ i, ∑ j, ∑ k, f (b i j k) * (y i * y j * y k) := by
  refine hreg (hreg ?_)
  show f (x 0) * (f (x 0) * ∑ i, ∑ j, f (a i j) * (y i * y j))
    = f (x 0) * (f (x 0) * (f (x 0) * ∑ i, ∑ j, ∑ k, f (b i j k) * (y i * y j * y k)))
  calc f (x 0) * (f (x 0) * ∑ i, ∑ j, f (a i j) * (y i * y j))
      = f (∑ i, ∑ j, a i j * (x i * x j)) := by
        simp only [map_sum, map_mul, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
        rw [← hy i, ← hy j]
        ring
    _ = f (∑ i, ∑ j, ∑ k, b i j k * (x i * x j * x k)) := by rw [hrel]
    _ = f (x 0) * (f (x 0) * (f (x 0) * ∑ i, ∑ j, ∑ k, f (b i j k) * (y i * y j * y k))) := by
        simp only [map_sum, map_mul, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ =>
          Finset.sum_congr rfl fun k _ => ?_
        rw [← hy i, ← hy j, ← hy k]
        ring

/-- The fractions `xᵢ/x₁` in the affine blowup algebra `A[𝔪/x₁]`, for `x₁, x₂, x₃` in the
maximal ideal. -/
public noncomputable def chartFraction {x : Fin 3 → A} (S : Type u) [CommRing S] [Algebra A S]
    [IsLocalization.Away (x 0) S] (hx : ∀ i, x i ∈ maximalIdeal A) (i : Fin 3) :
    affineBlowupAlgebra (maximalIdeal A) (x 0) S :=
  affineBlowupFraction (maximalIdeal A) (x 0) S (hx i)

/-- The fraction `x₁/x₁` is `1`. -/
public theorem chartFraction_zero {x : Fin 3 → A} (S : Type u) [CommRing S] [Algebra A S]
    [IsLocalization.Away (x 0) S] (hx : ∀ i, x i ∈ maximalIdeal A) :
    chartFraction S hx 0 = 1 := by
  apply Subtype.ext
  show IsLocalization.mk' S (x 0) ⟨x 0, Submonoid.mem_powers (x 0)⟩ = 1
  exact IsLocalization.mk'_self' (M := Submonoid.powers (x 0)) S
    (x := ⟨x 0, Submonoid.mem_powers (x 0)⟩)

/-- `x₁` times the fraction `xᵢ/x₁` is `xᵢ`, in the affine blowup algebra `A[𝔪/x₁]`. -/
public theorem algebraMap_mul_chartFraction {x : Fin 3 → A} (S : Type u) [CommRing S]
    [Algebra A S] [IsLocalization.Away (x 0) S] (hx : ∀ i, x i ∈ maximalIdeal A) (i : Fin 3) :
    algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0) * chartFraction S hx i =
      algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x i) :=
  algebraMap_mul_affineBlowupFraction (maximalIdeal A) (x 0) S (hx i)

/-- **The relation on the affine blowup chart.** Inside `A' = A[𝔪/x₁]`, with `yᵢ = xᵢ/x₁` and
`y₁ = 1`, a quadratic relation `Σ aᵢⱼxᵢxⱼ = Σ aᵢⱼₖxᵢxⱼxₖ` on the maximal ideal becomes
`Σ aᵢⱼyᵢyⱼ = x₁ · Σ aᵢⱼₖyᵢyⱼyₖ`. -/
public theorem affineBlowupAlgebra_chart_relation {x : Fin 3 → A} (S : Type u) [CommRing S]
    [Algebra A S] [IsLocalization.Away (x 0) S] (hx : ∀ i, x i ∈ maximalIdeal A)
    (a : Fin 3 → Fin 3 → A) (b : Fin 3 → Fin 3 → Fin 3 → A)
    (hrel : ∑ i, ∑ j, a i j * (x i * x j) = ∑ i, ∑ j, ∑ k, b i j k * (x i * x j * x k)) :
    ∑ i, ∑ j, algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (a i j) *
        (chartFraction S hx i * chartFraction S hx j)
      = algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0) *
          ∑ i, ∑ j, ∑ k, algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (b i j k) *
            (chartFraction S hx i * chartFraction S hx j * chartFraction S hx k) :=
  chart_relation (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S)) x a b
    (chartFraction S hx) (algebraMap_mul_chartFraction S hx)
    (Stacks.Blowup.isRegular_algebraMap_affineBlowupAlgebra
      (maximalIdeal A) (x 0) S).left hrel

end AlgebraicGeometry

end
