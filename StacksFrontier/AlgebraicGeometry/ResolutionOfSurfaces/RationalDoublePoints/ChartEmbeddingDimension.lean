module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ChartPresentation
public import StacksFrontier.RingTheory.MvPolynomial.MaximalIdeal
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ChartPoint
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.ChartRingSpec
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.BlowUpCompletedLocalRings

/-!
# The embedding dimension at a point of the exceptional divisor

Let `A` be a local ring whose maximal ideal is generated by `x₁, x₂, x₃`, and let
`A' = A[𝔪/x₁]` be the affine blowup chart. A maximal ideal `𝔪'` of `A'` containing `x₁` is
generated by three elements: `x₁` and two lifts `z₂, z₃` of generators of the corresponding
maximal ideal of `κ[y₂, y₃]`, which surjects onto `A'/x₁A'` ([Stacks, Tag 00OP] for the two
generators). This is the equality `𝔪' = (x₁, z₂, z₃)` of Section 54.12 of the Stacks project.

## Main results

* `AlgebraicGeometry.exists_span_eq_of_isMaximal_chart`: `𝔪' = (x₁, z₂, z₃)`.
* `AlgebraicGeometry.spanFinrank_maximalIdeal_localization_chart_le_three`: the local ring of
  `A'` at `𝔪'` has embedding dimension at most three.
-/

@[expose] public noncomputable section

open CategoryTheory IsLocalRing

universe u

namespace AlgebraicGeometry

variable {A : Type u} [CommRing A] [IsLocalRing A] {x : Fin 3 → A}
  (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away (x 0) S]

/-- A maximal ideal `𝔪'` of the chart `A[𝔪/x₁]` containing `x₁` is generated by `x₁` and two
further elements: `𝔪' = (x₁, z₂, z₃)`. -/
theorem exists_span_eq_of_isMaximal_chart (hx : ∀ i, x i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (z : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S)) [hz : z.IsMaximal]
    (hx0 : algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0) ∈ z) :
    ∃ g : Fin 2 → affineBlowupAlgebra (maximalIdeal A) (x 0) S,
      z = Ideal.span (insert (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0))
        (Set.range g)) := by
  let J : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S) :=
    Ideal.span {algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0)}
  have hJz : J ≤ z := (Ideal.span_singleton_le_iff_mem _).mpr hx0
  have hπ : Function.Surjective (chartPresentation S hx) := chartPresentation_surjective S hx hspan
  let zbar : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S ⧸ J) :=
    Ideal.map (Ideal.Quotient.mk J) z
  have hcomapz : Ideal.comap (Ideal.Quotient.mk J) zbar = z := Ideal.comap_map_mk hJz
  have : zbar.IsMaximal := by
    refine (Ideal.map_eq_top_or_isMaximal_of_surjective _ Ideal.Quotient.mk_surjective
      hz).resolve_left fun htop => hz.ne_top ?_
    rw [← hcomapz, show zbar = ⊤ from htop, Ideal.comap_top]
  let 𝔫 := Ideal.comap (chartPresentation S hx) zbar
  have h𝔫 : 𝔫.IsMaximal := Ideal.comap_isMaximal_of_surjective _ hπ
  obtain ⟨f, hf, -⟩ := jacobsonConstruction 2 𝔫 h𝔫
  choose g hg using fun i => Ideal.Quotient.mk_surjective (I := J) (chartPresentation S hx (f i))
  have hzbar : zbar = Ideal.map (Ideal.Quotient.mk J) (Ideal.span (Set.range g)) := by
    rw [← Ideal.map_comap_of_surjective _ hπ zbar]
    change Ideal.map (chartPresentation S hx) 𝔫 = _
    rw [← hf, Ideal.map_span, Ideal.map_span, ← Set.range_comp, ← Set.range_comp]
    congr 2
    exact funext fun i => (hg i).symm
  refine ⟨g, le_antisymm ?_ ?_⟩
  · intro w hw
    have hmk : w ∈ Ideal.comap (Ideal.Quotient.mk J) zbar := hcomapz ▸ hw
    rw [hzbar, Ideal.comap_map_quotientMk] at hmk
    exact (sup_le (Ideal.span_mono (by simp)) (Ideal.span_mono (Set.subset_insert _ _)) :
      J ⊔ Ideal.span (Set.range g) ≤ _) hmk
  · rw [Ideal.span_le]
    rintro _ (rfl | ⟨i, rfl⟩)
    · exact hx0
    · rw [← hcomapz]
      change Ideal.Quotient.mk J (g i) ∈ zbar
      rw [hzbar]
      exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩)

/-- The maximal ideal of the localization of the chart `A[𝔪/x₁]` at a maximal ideal containing
`x₁` is generated by at most three elements. -/
theorem spanFinrank_maximalIdeal_localization_chart_le_three (hx : ∀ i, x i ∈ maximalIdeal A)
    (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (z : Ideal (affineBlowupAlgebra (maximalIdeal A) (x 0) S)) [z.IsMaximal]
    (hx0 : algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0) ∈ z) :
    (maximalIdeal (Localization.AtPrime z)).spanFinrank ≤ 3 := by
  obtain ⟨g, hg⟩ := exists_span_eq_of_isMaximal_chart S hx hspan z hx0
  rw [← Localization.AtPrime.map_eq_maximalIdeal]
  conv_lhs => rw [show Ideal.map (algebraMap _ (Localization.AtPrime z)) z = Ideal.map
    (algebraMap _ (Localization.AtPrime z)) (Ideal.span
      (insert (algebraMap A (affineBlowupAlgebra (maximalIdeal A) (x 0) S) (x 0))
        (Set.range g))) from congrArg _ hg]
  rw [Ideal.map_span]
  refine le_trans (Submodule.spanFinrank_span_le_ncard_of_finite (Set.toFinite _)) ?_
  refine le_trans (Set.ncard_image_le (Set.toFinite _)) ?_
  refine le_trans (Set.ncard_insert_le _ _) ?_
  have : (Set.range g).ncard ≤ 2 := by
    rw [← Set.image_univ]
    refine le_trans (Set.ncard_image_le Set.finite_univ) ?_
    simp
  lia

/-- The maximal ideal of the localization of the chart `A[M/a]` at a maximal ideal containing `a`
is generated by at most three elements, where `M` is the maximal ideal and `a = x₁`. -/
theorem spanFinrank_maximalIdeal_localization_chart_le_three' {A : Type u} [CommRing A]
    [IsLocalRing A] {x : Fin 3 → A} (M : Ideal A) (hM : maximalIdeal A = M) (a : A)
    (ha : x 0 = a) (S : Type u) [CommRing S] [Algebra A S] [IsLocalization.Away a S]
    (hx : ∀ i, x i ∈ maximalIdeal A) (hspan : Ideal.span (Set.range x) = maximalIdeal A)
    (z : Ideal (affineBlowupAlgebra M a S)) [z.IsMaximal]
    (hx0 : algebraMap A (affineBlowupAlgebra M a S) a ∈ z) :
    (maximalIdeal (Localization.AtPrime z)).spanFinrank ≤ 3 := by
  subst hM ha
  exact spanFinrank_maximalIdeal_localization_chart_le_three S hx hspan z hx0

/-- A ring isomorphism of local rings preserves the minimal number of generators of the maximal
ideal. -/
theorem spanFinrank_maximalIdeal_eq_of_ringEquiv {R R' : Type*} [CommRing R] [CommRing R']
    [IsLocalRing R] [IsLocalRing R'] (e : R ≃+* R') :
    (maximalIdeal R).spanFinrank = (maximalIdeal R').spanFinrank := by
  rw [← IsLocalRing.map_ringEquiv_maximalIdeal e, Ideal.spanFinrank_map_eq_of_ringEquiv]

end AlgebraicGeometry

end
