module

public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.Basic.AffineFormsAndDerivations
import all StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalDoublePoints.Basic.AffineFormsAndDerivations
public import Mathlib.LinearAlgebra.Dimension.Constructions
public import Mathlib.LinearAlgebra.Dimension.FreeAndStrongRankCondition
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import Mathlib.RingTheory.Derivation.Lie

/-!
# Coefficients modulo the squares of the variables, and colength

Auxiliary lemmas on an ideal `I` of `κ[x, y]` and its square: the reduction of a polynomial
modulo `(x ^ 2, y ^ 2)` and the low-degree coefficients of products, the ideal generated by the
two variables, the relation between the `x ^ 2` and `y ^ 2` coefficients of an element of `I ^ 2`,
the characteristic-two derivation argument forcing coefficients to be squares, the partial
derivatives of a general quadratic, and the consequences of `I` having colength greater than
one.

## Main results

* `MvPolynomial.pderiv_zero_quadratic` and `MvPolynomial.pderiv_one_quadratic`: the two partial
  derivatives of a general quadratic in two variables.

## Implementation notes

The polynomial ring `κ[x, y]` is represented by `MvPolynomial (Fin 2) κ`, with variables `X 0`
and `X 1`. Colength greater than one is expressed using `Module.rank`, so the statements also
cover ideals whose quotient has infinite dimension.

## References

* [Stacks Project, Tag 0BGD](https://stacks.math.columbia.edu/tag/0BGD)
-/

@[expose] public section

open MvPolynomial

namespace MvPolynomial

/-- Modulo the ideal generated by `x ^ 2` and `y ^ 2`, every polynomial is congruent to one of
the form `a + b x + c y + d x y`. -/
private theorem reduce_mod_var_squares {k : Type*} [Field k]
    (p : MvPolynomial (Fin 2) k) :
    ∃ a b c d : k,
      p - (MvPolynomial.C a + MvPolynomial.C b * MvPolynomial.X (0 : Fin 2) +
        MvPolynomial.C c * MvPolynomial.X (1 : Fin 2) +
        MvPolynomial.C d * MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)) ∈
        Ideal.span {MvPolynomial.X (0 : Fin 2) ^ 2, MvPolynomial.X (1 : Fin 2) ^ 2} := by
  classical
  induction p using MvPolynomial.induction_on with
  | C a => exact ⟨a, 0, 0, 0, by simp⟩
  | add p q hp hq =>
      obtain ⟨a, b, c, d, hp⟩ := hp
      obtain ⟨a', b', c', d', hq⟩ := hq
      refine ⟨a + a', b + b', c + c', d + d', ?_⟩
      have hadd := (Ideal.span {MvPolynomial.X (0 : Fin 2) ^ 2,
        MvPolynomial.X (1 : Fin 2) ^ 2}).add_mem hp hq
      convert hadd using 1
      simp only [map_add]
      ring
  | mul_X p i hp =>
      obtain ⟨a, b, c, d, hp⟩ := hp
      let J : Ideal (MvPolynomial (Fin 2) k) :=
        Ideal.span {MvPolynomial.X (0 : Fin 2) ^ 2, MvPolynomial.X (1 : Fin 2) ^ 2}
      have hx : MvPolynomial.X (0 : Fin 2) ^ 2 ∈ J := by
        apply Ideal.subset_span
        simp
      have hy : MvPolynomial.X (1 : Fin 2) ^ 2 ∈ J := by
        apply Ideal.subset_span
        simp
      fin_cases i
      · refine ⟨0, a, 0, c, ?_⟩
        have hm := J.mul_mem_right (MvPolynomial.X (0 : Fin 2)) hp
        have heq : p * MvPolynomial.X (0 : Fin 2) -
            (MvPolynomial.C a * MvPolynomial.X (0 : Fin 2) +
              MvPolynomial.C c * MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)) =
            (p -
              (MvPolynomial.C a + MvPolynomial.C b * MvPolynomial.X (0 : Fin 2) +
                MvPolynomial.C c * MvPolynomial.X (1 : Fin 2) +
                MvPolynomial.C d * MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2))) *
              MvPolynomial.X (0 : Fin 2) +
              MvPolynomial.C b * MvPolynomial.X (0 : Fin 2) ^ 2 +
              MvPolynomial.C d * MvPolynomial.X (0 : Fin 2) ^ 2 * MvPolynomial.X (1 : Fin 2) := by
          ring
        have hmem : p * MvPolynomial.X (0 : Fin 2) -
            (MvPolynomial.C a * MvPolynomial.X (0 : Fin 2) +
              MvPolynomial.C c * MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)) ∈ J := by
          rw [heq]
          have hterms := J.add_mem (J.mul_mem_left (MvPolynomial.C b) hx)
            (J.mul_mem_left (MvPolynomial.C d * MvPolynomial.X (1 : Fin 2)) hx)
          convert J.add_mem hm hterms using 1
          ring
        simpa using hmem
      · refine ⟨0, 0, a, b, ?_⟩
        have hm := J.mul_mem_right (MvPolynomial.X (1 : Fin 2)) hp
        have heq : p * MvPolynomial.X (1 : Fin 2) -
            (MvPolynomial.C a * MvPolynomial.X (1 : Fin 2) +
              MvPolynomial.C b * MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)) =
            (p -
              (MvPolynomial.C a + MvPolynomial.C b * MvPolynomial.X (0 : Fin 2) +
                MvPolynomial.C c * MvPolynomial.X (1 : Fin 2) +
                MvPolynomial.C d * MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2))) *
              MvPolynomial.X (1 : Fin 2) +
              MvPolynomial.C c * MvPolynomial.X (1 : Fin 2) ^ 2 +
              MvPolynomial.C d * MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2) ^ 2 := by
          ring
        have hmem : p * MvPolynomial.X (1 : Fin 2) -
            (MvPolynomial.C a * MvPolynomial.X (1 : Fin 2) +
              MvPolynomial.C b * MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2)) ∈ J := by
          rw [heq]
          have hterms := J.add_mem (J.mul_mem_left (MvPolynomial.C c) hy)
            (J.mul_mem_left (MvPolynomial.C d * MvPolynomial.X (0 : Fin 2)) hy)
          convert J.add_mem hm hterms using 1
          ring
        simpa using hmem

/-- The coefficient of `x_i ^ n` in a product is a convolution of the coefficients of `x_i ^ j`. -/
private theorem coeff_single_mul {k : Type*} [Field k] (i : Fin 2) (n : ℕ)
    (p q : MvPolynomial (Fin 2) k) :
    (p * q).coeff (Finsupp.single i n) =
      ∑ j ∈ Finset.range (n + 1),
        p.coeff (Finsupp.single i j) * q.coeff (Finsupp.single i (n - j)) := by
  classical
  rw [coeff_mul, Finsupp.antidiagonal_single, Finset.sum_map,
    Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]
  simp

/-- The coefficients of `1`, `x` and `y` in `x_i ^ 2` vanish. -/
private theorem coeff_low_X_sq {k : Type*} [Field k] (i : Fin 2) :
    (X i ^ 2 : MvPolynomial (Fin 2) k).coeff 0 = 0 ∧
    (X i ^ 2 : MvPolynomial (Fin 2) k).coeff (Finsupp.single 0 1) = 0 ∧
    (X i ^ 2 : MvPolynomial (Fin 2) k).coeff (Finsupp.single 1 1) = 0 := by
  classical
  fin_cases i <;>
    simp [coeff_X_pow, Finsupp.single_apply, Finsupp.ext_iff, Fin.forall_fin_two]

/-- For polynomials with vanishing constant term, the `x_i ^ 2` coefficient of a product is the
product of the `x_i` coefficients. -/
private theorem coeff_single_two_mul {k : Type*} [Field k] (i : Fin 2)
    (p q : MvPolynomial (Fin 2) k) (hp0 : p.coeff 0 = 0) (hq0 : q.coeff 0 = 0) :
    (p * q).coeff (Finsupp.single i 2) =
      p.coeff (Finsupp.single i 1) * q.coeff (Finsupp.single i 1) := by
  simp only [coeff_single_mul, Finset.sum_range_succ, Finset.range_zero, Finset.sum_empty,
    zero_add]
  simp [hp0, hq0]

/-- A product `p * q` has vanishing coefficients in degrees `0`, `x` and `y` whenever `q`
does. -/
private theorem coeff_low_mul {k : Type*} [Field k]
    (p q : MvPolynomial (Fin 2) k) (hq0 : q.coeff 0 = 0)
    (hqx : q.coeff (Finsupp.single (0 : Fin 2) 1) = 0)
    (hqy : q.coeff (Finsupp.single (1 : Fin 2) 1) = 0)
    (n : Fin 2 →₀ ℕ) (hn : n = 0 ∨ n = Finsupp.single (0 : Fin 2) 1 ∨
      n = Finsupp.single (1 : Fin 2) 1) : (p * q).coeff n = 0 := by
  classical
  rcases hn with rfl | rfl | rfl
  · rw [MvPolynomial.coeff_mul]
    simp [hq0]
  · simp [coeff_single_mul, Finset.sum_range_succ, hq0, hqx]
  · simp [coeff_single_mul, Finset.sum_range_succ, hq0, hqy]

/-- An element of the ideal generated by `x ^ 2` and `y ^ 2` has vanishing coefficients in
degrees `0`, `x` and `y`. -/
private theorem coeff_low_of_mem_var_squares {k : Type*} [Field k]
    {p : MvPolynomial (Fin 2) k}
    (hp : p ∈ Ideal.span {MvPolynomial.X (0 : Fin 2) ^ 2,
      MvPolynomial.X (1 : Fin 2) ^ 2})
    : p.coeff 0 = 0 ∧ p.coeff (Finsupp.single (0 : Fin 2) 1) = 0 ∧
      p.coeff (Finsupp.single (1 : Fin 2) 1) = 0 := by
  classical
  induction hp using Submodule.span_induction with
  | mem q hq =>
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq
      rcases hq with rfl | rfl
      exacts [(coeff_low_X_sq 0), (coeff_low_X_sq 1)]
  | zero => simp
  | add q r hq hr ihq ihr => simp [ihq, ihr]
  | smul a q hq ih =>
      obtain ⟨ih0, ihx, ihy⟩ := ih
      refine ⟨?_, ?_, ?_⟩
      · simpa using coeff_low_mul a q ih0 ihx ihy 0 (Or.inl rfl)
      · simpa using coeff_low_mul a q ih0 ihx ihy _ (Or.inr (Or.inl rfl))
      · simpa using coeff_low_mul a q ih0 ihx ihy _ (Or.inr (Or.inr rfl))

/-- The coefficient of `x` in a polynomial in two variables. -/
private noncomputable def linCoeffX {k : Type*} [Field k] (p : MvPolynomial (Fin 2) k) : k :=
  p.coeff (Finsupp.single (0 : Fin 2) 1)

/-- The coefficient of `y` in a polynomial in two variables. -/
private noncomputable def linCoeffY {k : Type*} [Field k] (p : MvPolynomial (Fin 2) k) : k :=
  p.coeff (Finsupp.single (1 : Fin 2) 1)

/-- For polynomials with vanishing constant term, the `x ^ 2` coefficient of a product is the
product of the `x` coefficients. -/
private theorem coeff_x_sq_mul {k : Type*} [Field k]
    (p q : MvPolynomial (Fin 2) k) (hp0 : p.coeff 0 = 0) (hq0 : q.coeff 0 = 0) :
    (p * q).coeff (Finsupp.single (0 : Fin 2) 2) = linCoeffX p * linCoeffX q :=
  coeff_single_two_mul 0 p q hp0 hq0

/-- For polynomials with vanishing constant term, the `y ^ 2` coefficient of a product is the
product of the `y` coefficients. -/
private theorem coeff_y_sq_mul {k : Type*} [Field k]
    (p q : MvPolynomial (Fin 2) k) (hp0 : p.coeff 0 = 0) (hq0 : q.coeff 0 = 0) :
    (p * q).coeff (Finsupp.single (1 : Fin 2) 2) = linCoeffY p * linCoeffY q :=
  coeff_single_two_mul 1 p q hp0 hq0


/-- The ideal of `k[x, y]` generated by the two variables. -/
private noncomputable def variableIdeal {k : Type*} [Field k] : Ideal (MvPolynomial (Fin 2) k) :=
  Ideal.span {MvPolynomial.X (0 : Fin 2), MvPolynomial.X (1 : Fin 2)}

/-- Every polynomial differs from a constant by an element of the variable ideal. -/
private theorem exists_constant_remainder {k : Type*} [Field k]
    (p : MvPolynomial (Fin 2) k) :
    ∃ a : k, p - MvPolynomial.C a ∈ variableIdeal (k := k) := by
  classical
  induction p using MvPolynomial.induction_on with
  | C a => exact ⟨a, by simp [variableIdeal]⟩
  | add p q hp hq =>
      obtain ⟨a, hp⟩ := hp
      obtain ⟨b, hq⟩ := hq
      refine ⟨a + b, ?_⟩
      have h := (variableIdeal (k := k)).add_mem hp hq
      convert h using 1
      simp only [map_add]
      ring
  | mul_X p i hp =>
      refine ⟨0, ?_⟩
      have hx : MvPolynomial.X i ∈ variableIdeal (k := k) := by
        apply Ideal.subset_span
        fin_cases i <;> simp
      simpa [variableIdeal] using (variableIdeal (k := k)).mul_mem_left p hx

/-- The variable ideal is the kernel of taking the constant coefficient. -/
private theorem variableIdeal_eq_ker_constantCoeff {k : Type*} [Field k] :
    variableIdeal (k := k) = RingHom.ker (MvPolynomial.constantCoeff :
      MvPolynomial (Fin 2) k →+* k) := by
  have hmk : variableIdeal (k := k) ≤ RingHom.ker (MvPolynomial.constantCoeff :
      MvPolynomial (Fin 2) k →+* k) := by
    apply Ideal.span_le.mpr
    intro p hp
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp
    rcases hp with rfl | rfl <;> simp
  refine le_antisymm hmk fun p hp => ?_
  obtain ⟨a, ha⟩ := exists_constant_remainder p
  have hz : (MvPolynomial.constantCoeff : MvPolynomial (Fin 2) k →+* k)
      (p - MvPolynomial.C a) = 0 :=
    RingHom.mem_ker.mp (hmk ha)
  have hconst : MvPolynomial.constantCoeff p - a = 0 := by simpa using hz
  have hp0 : MvPolynomial.constantCoeff p = 0 := RingHom.mem_ker.mp hp
  have ha0 : a = 0 := by rw [hp0] at hconst; simpa using hconst
  rw [ha0] at ha
  simpa using ha

/-- The variable ideal is maximal. -/
private theorem variableIdeal_isMaximal {k : Type*} [Field k] :
    (variableIdeal (k := k)).IsMaximal := by
  rw [variableIdeal_eq_ker_constantCoeff]
  apply RingHom.ker_isMaximal_of_surjective
  intro a
  exact ⟨MvPolynomial.C a, by simp⟩

/-- A proper ideal containing both `x ^ 2` and `y ^ 2` is contained in the variable ideal. -/
private theorem ideal_le_variableIdeal_of_var_squares {k : Type*} [Field k]
    (I : Ideal (MvPolynomial (Fin 2) k)) (hproper : I ≠ ⊤)
    (hx : MvPolynomial.X (0 : Fin 2) ^ 2 ∈ I)
    (hy : MvPolynomial.X (1 : Fin 2) ^ 2 ∈ I) : I ≤ variableIdeal (k := k) := by
  have hrad : variableIdeal (k := k) ≤ I.radical := by
    apply Ideal.span_le.mpr
    intro p hp
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hp
    rcases hp with rfl | rfl
    · exact Ideal.mem_radical_iff.mpr ⟨2, hx⟩
    · exact Ideal.mem_radical_iff.mpr ⟨2, hy⟩
  have hrad_ne : I.radical ≠ ⊤ := by
    intro htop
    have h1 : (1 : MvPolynomial (Fin 2) k) ∈ I.radical := by rw [htop]; simp
    obtain ⟨n, hn⟩ := Ideal.mem_radical_iff.mp h1
    have h1I : (1 : MvPolynomial (Fin 2) k) ∈ I := by simpa using hn
    exact hproper (I.eq_top_of_isUnit_mem h1I (by simp))
  have heq := (variableIdeal_isMaximal (k := k)).eq_of_le hrad_ne hrad
  exact le_trans (Ideal.le_radical : I ≤ I.radical) (le_of_eq heq.symm)

/-- For an ideal whose elements have vanishing constant term and proportional linear parts, the
`x ^ 2` and `y ^ 2` coefficients of an element of `I ^ 2` satisfy the corresponding relation. -/
private theorem diagonal_coeff_relation_of_mem_sq {k : Type*} [Field k]
    (I : Ideal (MvPolynomial (Fin 2) k)) (p : MvPolynomial (Fin 2) k)
    (hp : p ∈ I ^ 2) (hconst : ∀ q ∈ I, q.coeff 0 = 0)
    (u v : k) (hline : ∀ q ∈ I, v * linCoeffX q = u * linCoeffY q) :
    p.coeff (Finsupp.single (0 : Fin 2) 2) * v ^ 2 =
      p.coeff (Finsupp.single (1 : Fin 2) 2) * u ^ 2 := by
  rw [pow_two] at hp
  induction hp using Submodule.mul_induction_on' with
  | mem_mul_mem q hq r hr =>
      have hq0 := hconst q hq
      have hr0 := hconst r hr
      rw [coeff_x_sq_mul q r hq0 hr0, coeff_y_sq_mul q r hq0 hr0]
      calc
        (linCoeffX q * linCoeffX r) * v ^ 2 =
            (v * linCoeffX q) * (v * linCoeffX r) := by ring
        _ = (u * linCoeffY q) * (u * linCoeffY r) := by rw [hline q hq, hline r hr]
        _ = (linCoeffY q * linCoeffY r) * u ^ 2 := by ring
  | add q hq r hr ihq ihr =>
      simp only [AddMonoidAlgebra.coeff_add]
      calc
        (q.coeff (Finsupp.single (0 : Fin 2) 2) +
            r.coeff (Finsupp.single (0 : Fin 2) 2)) * v ^ 2 =
            q.coeff (Finsupp.single (0 : Fin 2) 2) * v ^ 2 +
              r.coeff (Finsupp.single (0 : Fin 2) 2) * v ^ 2 := by ring
        _ = q.coeff (Finsupp.single (1 : Fin 2) 2) * u ^ 2 +
              r.coeff (Finsupp.single (1 : Fin 2) 2) * u ^ 2 := by rw [ihq, ihr]
        _ = (q.coeff (Finsupp.single (1 : Fin 2) 2) +
              r.coeff (Finsupp.single (1 : Fin 2) 2)) * u ^ 2 := by ring

/-- A constant lying in a proper ideal is zero. -/
private theorem constant_eq_zero_of_mem_of_ne_top {k : Type*} [Field k]
    (I : Ideal (MvPolynomial (Fin 2) k)) {z : k}
    (hz : MvPolynomial.C z ∈ I) (hI : I ≠ ⊤) : z = 0 := by
  by_contra hz0
  have hunit : IsUnit (MvPolynomial.C z) :=
    IsUnit.map (MvPolynomial.C : k →+* MvPolynomial (Fin 2) k)
      (isUnit_iff_ne_zero.mpr hz0)
  exact hI (I.eq_top_of_isUnit_mem hz hunit)

/-- In characteristic two, the derivation argument forces both `α` and `a + α d` to be squares. -/
private theorem char_two_derivation_bridge_squares {k : Type*} [Field k] [CharP k 2]
    [Algebra (ZMod 2) k] (I : Ideal (MvPolynomial (Fin 2) k))
    (a d α : k) (D : Derivation (ZMod 2) k k) (hDd : D d ≠ 0)
    (_hα : α = D a / D d) (hproper : I ≠ ⊤)
    (hnorm : MvPolynomial.C a + MvPolynomial.C d * MvPolynomial.X (0 : Fin 2) ^ 2 +
      MvPolynomial.X (1 : Fin 2) ^ 2 ∈ I ^ 2)
    (hq1 : MvPolynomial.C α + MvPolynomial.X (0 : Fin 2) ^ 2 ∈ I) :
    (∃ r : k, r ^ 2 = α) ∧ (∃ s : k, s ^ 2 = a + α * d) := by
  let htwo : (2 : k) = 0 := CharP.cast_eq_zero k 2
  have hrelation (E : Derivation (ZMod 2) k k) : E a + α * E d = 0 := by
    have hE := derivation_mem_of_mem_sq I (mvPolynomialCoeffDerivation E) hnorm
    have hnorm' : MvPolynomial.C a + MvPolynomial.C d * MvPolynomial.X (0 : Fin 2) ^ 2 +
        MvPolynomial.C 1 * MvPolynomial.X (1 : Fin 2) ^ 2 =
        MvPolynomial.C a + MvPolynomial.C d * MvPolynomial.X (0 : Fin 2) ^ 2 +
        MvPolynomial.X (1 : Fin 2) ^ 2 := by simp
    rw [hnorm'.symm, mvPolynomialCoeffDerivation_quad] at hE
    have hlin : MvPolynomial.C (E a) + MvPolynomial.C (E d) *
        MvPolynomial.X (0 : Fin 2) ^ 2 ∈ I := by
      simpa using hE
    have hsum := I.add_mem hlin (I.mul_mem_left (MvPolynomial.C (E d)) hq1)
    have hconst : MvPolynomial.C (E a + α * E d) ∈ I := by
      have hpoly : MvPolynomial.C (E a + α * E d) =
          (MvPolynomial.C (E a) + MvPolynomial.C (E d) * MvPolynomial.X (0 : Fin 2) ^ 2) +
            MvPolynomial.C (E d) * (MvPolynomial.C α + MvPolynomial.X (0 : Fin 2) ^ 2) := by
        simp only [map_add, map_mul]
        ring_nf
        rw [show (2 : MvPolynomial (Fin 2) k) = 0 by
          change MvPolynomial.C (2 : k) = 0
          rw [htwo]
          simp]
        ring
      rw [hpoly]
      exact hsum
    exact constant_eq_zero_of_mem_of_ne_top I hconst hproper
  have hDrel := hrelation D
  let D2 := derivationSquare D htwo
  have hD2rel := hrelation D2
  have hdifferentiate (E E' : Derivation (ZMod 2) k k) :
      E (E' a) + E α * E' d + α * E (E' d) = 0 := by
    have h := congrArg E (hrelation E')
    simp only [map_add, map_zero, E.leibniz, smul_eq_mul] at h
    linear_combination h
  have hDalpha : D α = 0 := by
    have hD2 : D (D a) + α * D (D d) = 0 := by
      simpa [D2, derivationSquare] using hD2rel
    have hz : D α * D d = 0 := by linear_combination hdifferentiate D D - hD2
    exact (mul_eq_zero.mp hz).resolve_right hDd
  have hkill : ∀ E : Derivation (ZMod 2) k k, E α = 0 := by
    intro E
    have hcomm := hrelation ⁅E, D⁆
    have hcomm' : E (D a) - D (E a) + α * (E (D d) - D (E d)) = 0 := by
      simpa [Derivation.commutator_apply] using hcomm
    have hz : E α * D d - D α * E d = 0 := by
      linear_combination hdifferentiate E D - hdifferentiate D E - hcomm'
    have hz' : E α * D d = 0 := by simpa [hDalpha] using hz
    exact (mul_eq_zero.mp hz').resolve_right hDd
  have hαsq : ∃ r : k, r ^ 2 = α := by
    by_contra h
    obtain ⟨E, hE⟩ := exists_derivation_detecting_nonsquare α h
    exact hE (hkill E)
  have hβkill : ∀ E : Derivation (ZMod 2) k k, E (a + α * d) = 0 := by
    intro E
    rw [map_add, Derivation.leibniz]
    simp only [smul_eq_mul]
    linear_combination hrelation E + (hkill E) * d
  have hβsq : ∃ s : k, s ^ 2 = a + α * d := by
    by_contra h
    obtain ⟨E, hE⟩ := exists_derivation_detecting_nonsquare (a + α * d) h
    exact hE (hβkill E)
  exact ⟨hαsq, hβsq⟩

/-- The partial derivative of a general quadratic with respect to the first variable. -/
private theorem pderiv_quad_x {k : Type*} [Field k] (a b c d e f : k) :
    MvPolynomial.pderiv (0 : Fin 2)
      (MvPolynomial.C a + MvPolynomial.C b * MvPolynomial.X (0 : Fin 2) +
        MvPolynomial.C c * MvPolynomial.X (1 : Fin 2) +
        MvPolynomial.C d * MvPolynomial.X (0 : Fin 2) ^ 2 +
        MvPolynomial.C e * MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2) +
        MvPolynomial.C f * MvPolynomial.X (1 : Fin 2) ^ 2) =
      MvPolynomial.C b + 2 * MvPolynomial.C d * MvPolynomial.X (0 : Fin 2) +
        MvPolynomial.C e * MvPolynomial.X (1 : Fin 2) := by
  simp [mul_comm, mul_left_comm, mul_assoc]

/-- The partial derivative of a general quadratic with respect to the first variable. -/
public alias pderiv_zero_quadratic := pderiv_quad_x

/-- The partial derivative of a general quadratic with respect to the second variable. -/
private theorem pderiv_quad_y {k : Type*} [Field k] (a b c d e f : k) :
    MvPolynomial.pderiv (1 : Fin 2)
      (MvPolynomial.C a + MvPolynomial.C b * MvPolynomial.X (0 : Fin 2) +
        MvPolynomial.C c * MvPolynomial.X (1 : Fin 2) +
        MvPolynomial.C d * MvPolynomial.X (0 : Fin 2) ^ 2 +
        MvPolynomial.C e * MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2) +
        MvPolynomial.C f * MvPolynomial.X (1 : Fin 2) ^ 2) =
      MvPolynomial.C c + MvPolynomial.C e * MvPolynomial.X (0 : Fin 2) +
      2 * MvPolynomial.C f * MvPolynomial.X (1 : Fin 2) := by
  simp [mul_comm, mul_left_comm, mul_assoc]

/-- The partial derivative of a general quadratic with respect to the second variable. -/
public alias pderiv_one_quadratic := pderiv_quad_y

/-- The first partial derivative of a general quadratic, as an affine form. -/
private theorem pderiv_quad_x_affine {k : Type*} [Field k] (a b c d e f : k) :
    MvPolynomial.pderiv (0 : Fin 2)
      (MvPolynomial.C a + MvPolynomial.C b * MvPolynomial.X (0 : Fin 2) +
        MvPolynomial.C c * MvPolynomial.X (1 : Fin 2) +
        MvPolynomial.C d * MvPolynomial.X (0 : Fin 2) ^ 2 +
        MvPolynomial.C e * MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2) +
        MvPolynomial.C f * MvPolynomial.X (1 : Fin 2) ^ 2) = affineForm b (2 * d) e := by
  calc
    _ = MvPolynomial.C b + 2 * MvPolynomial.C d * MvPolynomial.X 0 +
        MvPolynomial.C e * MvPolynomial.X 1 := pderiv_quad_x a b c d e f
    _ = affineForm b (2 * d) e := by
      rw [affineForm]
      rw [map_mul, map_ofNat]

/-- The second partial derivative of a general quadratic, as an affine form. -/
private theorem pderiv_quad_y_affine {k : Type*} [Field k] (a b c d e f : k) :
    MvPolynomial.pderiv (1 : Fin 2)
      (MvPolynomial.C a + MvPolynomial.C b * MvPolynomial.X (0 : Fin 2) +
        MvPolynomial.C c * MvPolynomial.X (1 : Fin 2) +
        MvPolynomial.C d * MvPolynomial.X (0 : Fin 2) ^ 2 +
        MvPolynomial.C e * MvPolynomial.X (0 : Fin 2) * MvPolynomial.X (1 : Fin 2) +
        MvPolynomial.C f * MvPolynomial.X (1 : Fin 2) ^ 2) = affineForm c e (2 * f) := by
  calc
    _ = MvPolynomial.C c + MvPolynomial.C e * MvPolynomial.X 0 +
        2 * MvPolynomial.C f * MvPolynomial.X 1 := pderiv_quad_y a b c d e f
    _ = affineForm c e (2 * f) := by
      rw [affineForm]
      rw [map_mul, map_ofNat]

/-- An ideal whose quotient has rank more than one is proper. -/
private theorem ideal_ne_top_of_rank_gt_one {k : Type*} [Field k]
    (I : Ideal (MvPolynomial (Fin 2) k))
    (hI : 1 < Module.rank k (MvPolynomial (Fin 2) k ⧸ I)) : I ≠ ⊤ := by
  intro htop
  have hsub : Subsingleton (MvPolynomial (Fin 2) k ⧸ I) := by
    rw [htop]
    infer_instance
  have hrank : Module.rank k (MvPolynomial (Fin 2) k ⧸ I) = 0 :=
    rank_subsingleton' k _
  rw [hrank] at hI
  simp at hI

/-- In characteristic two, a diagonal quadratic in `I ^ 2` whose constant coefficient is not
killed by a derivation that kills the other two gives a contradiction. -/
private theorem char_two_derivation_constant_contradiction {k : Type*} [Field k]
    [CharP k 2] [Algebra (ZMod 2) k]
    (I : Ideal (MvPolynomial (Fin 2) k)) (a d f : k)
    (D : Derivation (ZMod 2) k k) (hDa : D a ≠ 0) (hDd : D d = 0) (hDf : D f = 0)
    (hproper : I ≠ ⊤)
    (hmem : MvPolynomial.C a + MvPolynomial.C d * MvPolynomial.X (0 : Fin 2) ^ 2 +
      MvPolynomial.C f * MvPolynomial.X (1 : Fin 2) ^ 2 ∈ I ^ 2) : False := by
  have hDmem := derivation_mem_of_mem_sq I (mvPolynomialCoeffDerivation D) hmem
  rw [mvPolynomialCoeffDerivation_quad] at hDmem
  have hconst : MvPolynomial.C (D a) ∈ I := by
    simpa [hDd, hDf] using hDmem
  have hzero := constant_eq_zero_of_mem_of_ne_top I hconst hproper
  exact hDa hzero

/-- If both variables become scalars in the quotient, the quotient has rank at most one. -/
private theorem quotient_rank_le_one_of_vars_scalar {k : Type*} [Field k]
    (I : Ideal (MvPolynomial (Fin 2) k)) (u v : k)
    (hx : Ideal.Quotient.mk I (MvPolynomial.X 0) =
      algebraMap k (MvPolynomial (Fin 2) k ⧸ I) u)
    (hy : Ideal.Quotient.mk I (MvPolynomial.X 1) =
      algebraMap k (MvPolynomial (Fin 2) k ⧸ I) v) :
    Module.rank k (MvPolynomial (Fin 2) k ⧸ I) ≤ 1 := by
  let Q := MvPolynomial (Fin 2) k ⧸ I
  have hclass : ∀ p : MvPolynomial (Fin 2) k,
      ∃ a : k, Ideal.Quotient.mk I p = algebraMap k (MvPolynomial (Fin 2) k ⧸ I) a := by
    intro p
    induction p using MvPolynomial.induction_on with
    | C a =>
        exact ⟨a, by
          rw [← MvPolynomial.algebraMap_eq]
          exact Ideal.Quotient.mk_algebraMap k I a⟩
    | add p q hp hq =>
        obtain ⟨a, ha⟩ := hp
        obtain ⟨b, hb⟩ := hq
        exact ⟨a + b, by simp [ha, hb]⟩
    | mul_X p i hp =>
        obtain ⟨a, ha⟩ := hp
        obtain ⟨c, hc⟩ : ∃ c : k, Ideal.Quotient.mk I (MvPolynomial.X i) =
            algebraMap k (MvPolynomial (Fin 2) k ⧸ I) c := by
          fin_cases i
          exacts [⟨u, hx⟩, ⟨v, hy⟩]
        exact ⟨a * c, by rw [map_mul, ha, hc, ← map_mul]⟩
  let : Module.Free k Q := Module.Free.of_basis (Module.Basis.ofVectorSpace k Q)
  rw [rank_le_one_iff]
  refine ⟨1, fun z => ?_⟩
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective z
  obtain ⟨a, ha⟩ := hclass p
  refine ⟨a, ?_⟩
  simpa [Algebra.algebraMap_eq_smul_one] using ha.symm

/-- An affine relation `r + s x_i ∈ I` with `s ≠ 0` makes `x_i` a scalar in the quotient. -/
private theorem quotient_X_eq_of_affine_mem {k : Type*} [Field k]
    (I : Ideal (MvPolynomial (Fin 2) k)) (i : Fin 2) (r s : k)
    (hs : s ≠ 0)
    (h : MvPolynomial.C r + MvPolynomial.C s * MvPolynomial.X i ∈ I) :
    Ideal.Quotient.mk I (MvPolynomial.X i) =
      algebraMap k (MvPolynomial (Fin 2) k ⧸ I) (-r / s) := by
  let Q := MvPolynomial (Fin 2) k ⧸ I
  let : CommRing Q := by dsimp [Q]; infer_instance
  have hz : Ideal.Quotient.mk I (MvPolynomial.C r + MvPolynomial.C s * MvPolynomial.X i) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr h
  have hz' : algebraMap k Q r + algebraMap k Q s *
      Ideal.Quotient.mk I (MvPolynomial.X i) = 0 := by
    rw [← MvPolynomial.algebraMap_eq] at hz
    simpa only [map_add, map_mul, Ideal.Quotient.mk_algebraMap k I] using hz
  have hscaled := congrArg (fun z : Q => algebraMap k Q (s⁻¹) * z) hz'
  rw [mul_add, ← mul_assoc, ← map_mul (algebraMap k Q) (s⁻¹) s, inv_mul_cancel₀ hs] at hscaled
  simp only [map_one, one_mul, mul_zero] at hscaled
  calc
    Ideal.Quotient.mk I (MvPolynomial.X i) = - algebraMap k Q (s⁻¹ * r) := by
      rw [map_mul]
      linear_combination hscaled
    _ = algebraMap k Q (-r / s) := by rw [neg_div, div_eq_inv_mul, map_neg]

/-- Two affine forms in an ideal whose quotient has rank more than one have proportional linear
parts. -/
private theorem affine_forms_det_eq_zero {k : Type*} [Field k]
    (I : Ideal (MvPolynomial (Fin 2) k)) (a b c d e f : k)
    (hp : affineForm a b c ∈ I) (hq : affineForm d e f ∈ I)
    (hcolength : 1 < Module.rank k (MvPolynomial (Fin 2) k ⧸ I)) :
    b * f - c * e = 0 := by
  by_contra hdet
  have hxmem : MvPolynomial.C (f * a - c * d) +
      MvPolynomial.C (b * f - c * e) * MvPolynomial.X 0 ∈ I := by
    have hm := I.sub_mem (I.mul_mem_left (MvPolynomial.C f) hp)
      (I.mul_mem_left (MvPolynomial.C c) hq)
    have heq : MvPolynomial.C (f * a - c * d) +
        MvPolynomial.C (b * f - c * e) * MvPolynomial.X 0 =
        MvPolynomial.C f * affineForm a b c - MvPolynomial.C c * affineForm d e f := by
      rw [affineForm, affineForm]
      simp only [map_sub, map_mul]
      ring
    exact heq ▸ hm
  have hymem : MvPolynomial.C (b * d - e * a) +
      MvPolynomial.C (b * f - c * e) * MvPolynomial.X 1 ∈ I := by
    have hm := I.sub_mem (I.mul_mem_left (MvPolynomial.C b) hq)
      (I.mul_mem_left (MvPolynomial.C e) hp)
    have heq : MvPolynomial.C (b * d - e * a) +
        MvPolynomial.C (b * f - c * e) * MvPolynomial.X 1 =
        MvPolynomial.C b * affineForm d e f - MvPolynomial.C e * affineForm a b c := by
      rw [affineForm, affineForm]
      simp only [map_sub, map_mul]
      ring
    exact heq ▸ hm
  have hx := quotient_X_eq_of_affine_mem I 0 (f * a - c * d) (b * f - c * e)
    hdet hxmem
  have hy := quotient_X_eq_of_affine_mem I 1 (b * d - e * a) (b * f - c * e)
    hdet hymem
  have hle := quotient_rank_le_one_of_vars_scalar I
    (-(f * a - c * d) / (b * f - c * e))
    (-(b * d - e * a) / (b * f - c * e)) hx hy
  exact not_lt_of_ge hle hcolength

end MvPolynomial
