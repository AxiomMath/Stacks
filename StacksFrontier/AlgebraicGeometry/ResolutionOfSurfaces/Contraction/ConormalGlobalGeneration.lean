module

public import StacksFrontier.AlgebraicGeometry.Surfaces.FormalNeighborhoodGradedPieceComparison
public import StacksFrontier.AlgebraicGeometry.CommonDegreeTwist.AffineSectionBasis
public import StacksFrontier.AlgebraicGeometry.GoodOpenClose.Reverse
public import StacksFrontier.AlgebraicGeometry.ProjTwistDegreeOneCover.Basic
public import StacksFrontier.AlgebraicGeometry.PicardUFD.ProjectiveSpace

/-!
# The conormal sheaf of an exceptional curve is globally generated

Let `E ⊆ X` be an exceptional curve of the first kind, presented as the projective line by
`e : 𝐏¹_k ≅ E`. Its conormal sheaf `𝒪_X(-E)|_E` pulls back along `e` to `𝒪_{𝐏¹}(1)`, which is
generated by the global sections `T₀, T₁`: the section `Tᵢ` does not vanish on `D₊(Tᵢ)`
([Stacks, Tag 01MV]). Hence every point of `E` lies in the nonvanishing locus of some global
section of `𝒪_X(-E)|_E`.

## Main results

* `AlgebraicGeometry.projectiveLineProj_exists_mem_nonvanishingLocus` — every point of `𝐏¹_k`
  lies in the nonvanishing locus of a global section of `𝒪(1)`.
* `IsExceptionalCurveOfFirstKind.nonvanishingLocus_curveSections`
  — the identification of global sections with `H⁰(𝐏¹_k, 𝒪(1))` carries nonvanishing loci to
  their inverse images along `e`.
* `IsExceptionalCurveOfFirstKind.exists_mem_nonvanishingLocus`
  — every point of `E` lies in the nonvanishing locus of a global section of `𝒪_X(-E)|_E`.

## References

* [Stacks Project, Tag 0C2L](https://stacks.math.columbia.edu/tag/0C2L)
* [Stacks Project, Tag 01MV](https://stacks.math.columbia.edu/tag/01MV)
* [Stacks Project, Tag 0H78](https://stacks.math.columbia.edu/tag/0H78)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite
open Stacks.Divisors

universe u

namespace AlgebraicGeometry

attribute [local instance] MvPolynomial.gradedAlgebra

/-- **`𝒪(1)` on the projective line is generated by its global sections.** -/
public theorem projectiveLineProj_exists_mem_nonvanishingLocus (k : Type u) [Field k]
    (p : projectiveLineProj k) :
    ∃ w, p ∈ Stacks.Ample.nonvanishingLocus (X := projectiveLineProj k)
        (ProjectiveSpectrum.Proj.twistingSheaf
          (MvPolynomial.homogeneousSubmodule (Fin 2) k) ((1 * 1 : ℕ) : ℤ)) w := by
  have hcov := Stacks.PicardUFD.degreeOneCover k 1
  obtain ⟨f, hf⟩ := Opens.mem_iSup.mp (hcov.ge (Opens.mem_top p))
  have hinv : p ∈ Stacks.AlgebraicGeometry.ProjInvertibleLocus.whereInvertible
      (MvPolynomial.homogeneousSubmodule (Fin 2) k) 1 := by
    rw [Stacks.AlgebraicGeometry.GoodOpenClose.whereInvertible_eq_ratioLocus,
      Stacks.AlgebraicGeometry.ProjTwistDegreeOneCover.ratioLocus_one_eq_top _ hcov]
    exact Opens.mem_top p
  exact ⟨_, (Stacks.AlgebraicGeometry.CommonDegreeTwist.mem_nonvanishingLocus_degreeSection_iff'
    (MvPolynomial.homogeneousSubmodule (Fin 2) k) 1 1 ⟨f.1, f.2⟩ hinv).mpr hf⟩

namespace Scheme.IdealSheafData.IsExceptionalCurveOfFirstKind

variable {X : Scheme.{u}} {D : X.IdealSheafData} {k : Type u} [Field k]
  {e : projectiveLineProj k ≅ D.subscheme} [IsEffectiveCartierDivisor D]
  (hE : IsExceptionalCurveOfFirstKind D k e)

/-- The nonvanishing locus of the image of a section under `curveSections` is the inverse
image along `e` of the nonvanishing locus of the section. -/
public theorem nonvanishingLocus_curveSections
    (σ : Γ((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (0 + 1))),
      (⊤ : D.subscheme.Opens))) :
    Stacks.Ample.nonvanishingLocus (X := projectiveLineProj k)
        (ProjectiveSpectrum.Proj.twistingSheaf
          (MvPolynomial.homogeneousSubmodule (Fin 2) k) ((0 + 1 : ℕ) : ℤ))
        (hE.curveSections 0 σ) =
      e.hom.base ⁻¹' Stacks.Ample.nonvanishingLocus
        ((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (0 + 1)))) σ := by
  exact (Stacks.Ample.nonvanishingLocus_congr (hE.curveTwistIso (0 + 1))
    (((Scheme.Modules.pullbackPushforwardAdjunction e.hom).unit.app
      ((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (0 + 1))))).app ⊤ σ)).trans
    (Stacks.NonvanishingPullback.preimage_nonvanishingLocus e.hom _ σ).symm

include hE in
/-- **Every point of the curve lies in the nonvanishing locus of a global section of the
conormal sheaf `𝒪_X(-E)|_E`.** -/
public theorem exists_mem_nonvanishingLocus (z : D.subscheme) :
    ∃ σ : Γ((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (0 + 1))),
      (⊤ : D.subscheme.Opens)),
      z ∈ Stacks.Ample.nonvanishingLocus
        ((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (0 + 1)))) σ := by
  obtain ⟨w, hw⟩ := projectiveLineProj_exists_mem_nonvanishingLocus k (e.inv.base z)
  obtain ⟨σ, hσ⟩ := (hE.curveSections_bijective 0).2 w
  refine ⟨σ, ?_⟩
  have h : e.inv.base z ∈ Stacks.Ample.nonvanishingLocus (X := projectiveLineProj k)
      (ProjectiveSpectrum.Proj.twistingSheaf
        (MvPolynomial.homogeneousSubmodule (Fin 2) k) ((0 + 1 : ℕ) : ℤ))
      (hE.curveSections 0 σ) := hσ ▸ hw
  rw [nonvanishingLocus_curveSections hE σ] at h
  simpa using h

end Scheme.IdealSheafData.IsExceptionalCurveOfFirstKind

end AlgebraicGeometry

end
