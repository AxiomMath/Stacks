/-!
# The classifying morphism to the blowup is an isomorphism

This is the last step of the proof of [Stacks, Tag 0C2L]: in the Stein case, with `𝒪_{Y,y}`
regular of dimension two and the scheme-theoretic fibre over `y` equal to the curve `E`, the
morphism `g : X ⟶ Bl_y Y` over `f` is an isomorphism. Against
`AlgebraicGeometry.isIso_blowUpClassifying_of_steinSetup_of_isReduced` neither reducedness of `X`
nor quasi-finiteness of `g` over the exceptional curve `E'` is assumed: the latter is
`AlgebraicGeometry.exists_quasiFiniteAt_blowUpClassifying_of_steinSetup`, and the former is
replaced by the observation that `X` is reduced on a neighbourhood of `E`, which is all the
isomorphism criterion [Stacks, Tag 0BFP] needs.

* At a point `x` of `E` the local ring `𝒪_{X,x}` is a domain: it is Noetherian, the ideal of `E`
  there is generated by a nonzerodivisor `t` of the maximal ideal, and `𝒪_{X,x}/t` is the local
  ring of `E ≅ 𝐏¹_k`, a domain. By Krull's intersection theorem every nonzero element is
  `t^m a'` with `a' ∉ (t)`, and a product of two such is nonzero.
* On a locally Noetherian scheme the points with reduced local ring form an open set: on an
  affine open `Spec A` the nilradical of `A` is finitely generated, so if it dies in `A_𝔭` it is
  killed by one `s ∉ 𝔭`, and then it dies in `A_𝔮` for all `𝔮 ∈ D(s)`.
* Let `N` be the open where `X` has reduced local rings and `W = Bl ∖ g(X ∖ N)`, open because
  `g` is proper. Then `E' ⊆ W` (as `g⁻¹(E') ⊆ E ⊆ N`) and `g⁻¹(W) ⊆ N` is reduced, so item (4) of
  [Stacks, Tag 0BFP] applies to `g|_W`: every point of `E'` lies in the maximal open over which
  `g|_W`, hence `g`, is an isomorphism. Off `E'`, `g` is an isomorphism already
  (`AlgebraicGeometry.exists_isIso_morphismRestrict_blowUpClassifying`).

## Main results

* `IsLocalRing.isDomain_of_isDomain_quotient_span_singleton` — a Noetherian local ring with a
  nonzerodivisor `t` in its maximal ideal such that `R/(t)` is a domain is a domain.
* `AlgebraicGeometry.exists_notMem_forall_isReduced_localization` — the reduced locus of a
  Noetherian ring is open.
* `AlgebraicGeometry.exists_mem_forall_isReduced_stalk` — the same for a locally Noetherian scheme.
* `AlgebraicGeometry.isDomain_stalk_of_iso_projectiveLineProj` — the local rings of `X` along an
  effective Cartier divisor isomorphic to `𝐏¹_k` are domains.
* `AlgebraicGeometry.isIso_blowUpClassifying_of_steinSetup_of_isNoetherian` — the classifying
  morphism is an isomorphism.

## References

* [Stacks Project, Tag 0C2L](https://stacks.math.columbia.edu/tag/0C2L)
* [Stacks Project, Tag 0BFP](https://stacks.math.columbia.edu/tag/0BFP)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace

universe u

/-- **A Noetherian local ring which is a domain modulo a nonzerodivisor of its maximal ideal is a
domain.** By Krull's intersection theorem a nonzero `a` lies in some `(t^m)` but not in
`(t^{m+1})`, so `a = t^m a'` with `a' ∉ (t)`; if also `b = t^n b'`, then `ab = 0` forces
`a'b' = 0 ∈ (t)`, since `t` is a nonzerodivisor, against `R/(t)` being a domain. -/
public theorem IsLocalRing.isDomain_of_isDomain_quotient_span_singleton {R : Type*}
    [CommRing R] [IsNoetherianRing R] [IsLocalRing R] {t : R} (ht : IsRegular t)
    (htm : t ∈ IsLocalRing.maximalIdeal R) (hdom : IsDomain (R ⧸ Ideal.span {t})) :
    IsDomain R := by
  have hne : Ideal.span {t} ≠ ⊤ := fun h ↦ by
    rw [Ideal.span_singleton_eq_top] at h
    exact (IsLocalRing.mem_maximalIdeal t).mp htm h
  have hfac : ∀ a : R, a ≠ 0 → ∃ (m : ℕ) (a' : R), a = t ^ m * a' ∧ a' ∉ Ideal.span {t} := by
    intro a ha
    have hex : ∃ n : ℕ, a ∉ Ideal.span {t ^ n} := by
      by_contra hall
      push Not at hall
      apply ha
      have hmem : a ∈ ⨅ n : ℕ, Ideal.span {t} ^ n := Ideal.mem_iInf.mpr fun n ↦ by
        rw [Ideal.span_singleton_pow]
        exact hall n
      rw [Ideal.iInf_pow_eq_bot_of_isLocalRing _ hne] at hmem
      exact hmem
    classical
    let n := Nat.find hex
    have hn : a ∉ Ideal.span {t ^ n} := Nat.find_spec hex
    obtain ⟨m, hm⟩ : ∃ m, n = m + 1 := by
      refine Nat.exists_eq_succ_of_ne_zero fun h0 ↦ hn ?_
      rw [h0, pow_zero, Ideal.span_singleton_one]
      trivial
    have hmem : a ∈ Ideal.span {t ^ m} := not_not.mp (Nat.find_min hex (show m < n by omega))
    obtain ⟨a', rfl⟩ := Ideal.mem_span_singleton'.mp hmem
    refine ⟨m, a', mul_comm _ _, fun ha' ↦ hn ?_⟩
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp ha'
    rw [hm, Ideal.mem_span_singleton']
    exact ⟨c, by ring⟩
  have : NoZeroDivisors R := by
    refine ⟨fun {a b} hab ↦ ?_⟩
    by_contra hcon
    push Not at hcon
    obtain ⟨m, a', rfl, ha'⟩ := hfac a hcon.1
    obtain ⟨n, b', rfl, hb'⟩ := hfac b hcon.2
    have h0 : t ^ (m + n) * (a' * b') = t ^ (m + n) * 0 := by
      rw [mul_zero, ← hab]
      ring
    have hab' : a' * b' = 0 := (ht.pow (m + n)).left h0
    have hq : Ideal.Quotient.mk (Ideal.span {t}) a' * Ideal.Quotient.mk (Ideal.span {t}) b' =
        0 := by
      rw [← map_mul, hab', map_zero]
    rcases mul_eq_zero.mp hq with h | h
    · exact ha' (Ideal.Quotient.eq_zero_iff_mem.mp h)
    · exact hb' (Ideal.Quotient.eq_zero_iff_mem.mp h)
  exact NoZeroDivisors.to_isDomain R

namespace AlgebraicGeometry

/-- **The reduced locus of a Noetherian ring is open.** If the localization of a Noetherian ring
`A` at a prime `𝔭` is reduced, there is `s ∉ 𝔭` such that the localization at every prime not
containing `s` is reduced: the nilradical of `A` is finitely generated and dies in `A_𝔭`, so a
single `s ∉ 𝔭` kills it. -/
@[ega "IV 7.3.19" "(vi), special case"]
public theorem exists_notMem_forall_isReduced_localization {A : Type u} [CommRing A]
    [IsNoetherianRing A] (𝔭 : Ideal A) [𝔭.IsPrime] (S : Type u) [CommRing S] [Algebra A S]
    [IsLocalization.AtPrime S 𝔭] [_root_.IsReduced S] :
    ∃ s : A, s ∉ 𝔭 ∧ ∀ (𝔮 : Ideal A) [𝔮.IsPrime], s ∉ 𝔮 → ∀ (T : Type u) [CommRing T]
      [Algebra A T] [IsLocalization.AtPrime T 𝔮], _root_.IsReduced T := by
  classical
  obtain ⟨G, hG⟩ : (nilradical A).FG := IsNoetherian.noetherian _
  have hkill : ∀ n : G, ∃ c : 𝔭.primeCompl, (c : A) * n = 0 := fun n ↦ by
    have hnil : IsNilpotent (n : A) := mem_nilradical.mp (hG ▸ Ideal.subset_span n.2)
    exact (IsLocalization.map_eq_zero_iff 𝔭.primeCompl S _).mp
      ((hnil.map (algebraMap A S)).eq_zero)
  choose c hc using hkill
  let s : 𝔭.primeCompl := ∏ n : G, c n
  have hsG : ∀ n ∈ (G : Set A), (s : A) * n = 0 := fun n hn ↦ by
    obtain ⟨r, hr⟩ : (c ⟨n, hn⟩ : A) ∣ (s : A) := by
      rw [Submonoid.coe_finset_prod]
      exact Finset.dvd_prod_of_mem (fun i : G ↦ (c i : A)) (Finset.mem_univ _)
    rw [hr, mul_comm (c ⟨n, hn⟩ : A) r, mul_assoc, hc, mul_zero]
  have hsN : ∀ a ∈ nilradical A, (s : A) * a = 0 := fun a ha ↦ by
    rw [← hG] at ha
    induction ha using Submodule.span_induction with
    | mem x hx => exact hsG x hx
    | zero => exact mul_zero _
    | add x y _ _ hx hy => rw [mul_add, hx, hy, add_zero]
    | smul r x _ hx => rw [smul_eq_mul, mul_left_comm, hx, mul_zero]
  refine ⟨s, s.2, fun 𝔮 _ hs𝔮 T _ _ _ ↦ ⟨fun z hz ↦ ?_⟩⟩
  obtain ⟨k, hk⟩ := hz
  obtain ⟨⟨a, u⟩, rfl⟩ := IsLocalization.mk'_surjective 𝔮.primeCompl z
  rw [← IsLocalization.mk'_pow, IsLocalization.mk'_eq_zero_iff] at hk
  obtain ⟨v, hv⟩ := hk
  have hva : (v : A) * a ∈ nilradical A := mem_nilradical.mpr ⟨k + 1, by
    linear_combination ((v : A) ^ k * a) * hv⟩
  rw [IsLocalization.mk'_eq_zero_iff]
  refine ⟨⟨(s : A) * v, 𝔮.primeCompl.mul_mem hs𝔮 v.2⟩, ?_⟩
  show (s : A) * v * a = 0
  rw [mul_assoc]
  exact hsN _ hva

/-- **The points of a locally Noetherian scheme with reduced local ring form an open set.** -/
@[ega "I 6.1.13"]
public theorem exists_mem_forall_isReduced_stalk {X : Scheme.{u}} [IsLocallyNoetherian X] (x : X)
    (hx : _root_.IsReduced (X.presheaf.stalk x)) :
    ∃ U : X.Opens, x ∈ U ∧ ∀ z ∈ U, _root_.IsReduced (X.presheaf.stalk z) := by
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  have : IsNoetherianRing Γ(X, V) := IsLocallyNoetherian.component_noetherian ⟨V, hV⟩
  let := X.presheaf.algebra_section_stalk ⟨x, hxV⟩
  have := hV.isLocalization_stalk ⟨x, hxV⟩
  obtain ⟨s, hs, hred⟩ := exists_notMem_forall_isReduced_localization
    (hV.primeIdealOf ⟨x, hxV⟩).asIdeal (X.presheaf.stalk x)
  refine ⟨X.basicOpen s, (hV.mem_basicOpen_iff_notMem_primeIdealOf s hxV).mpr hs,
    fun z hz ↦ ?_⟩
  have hzV : z ∈ V := X.basicOpen_le s hz
  let := X.presheaf.algebra_section_stalk ⟨z, hzV⟩
  have := hV.isLocalization_stalk ⟨z, hzV⟩
  exact hred _ ((hV.mem_basicOpen_iff_notMem_primeIdealOf s hzV).mp hz) _

/-- **The local rings of `X` along a curve presented as `𝐏¹_k` are domains**, as soon as the
curve is an effective Cartier divisor and `X` is locally Noetherian. The ideal of the curve is
generated at `x` by a nonzerodivisor `t` of the maximal ideal, and `𝒪_{X,x}/t` is the local ring
of the integral scheme `𝐏¹_k`. -/
public theorem isDomain_stalk_of_iso_projectiveLineProj {X : Scheme.{u}} [IsLocallyNoetherian X]
    (D : X.IdealSheafData) (k : Type u) [Field k] (e : projectiveLineProj k ≅ D.subscheme)
    (hD : Stacks.Divisors.IsEffectiveCartierDivisor D) (x : X) (hx : x ∈ (D.support : Set X)) :
    IsDomain (X.presheaf.stalk x) := by
  have : IsIntegral D.subscheme := isIntegral_subscheme_of_iso_projectiveLineProj D k e
  obtain ⟨t, ht, hspan⟩ :=
    Stacks.Divisors.exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor D hD x
  have htm : t ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
    rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    exact (IdealSheafData.stalk_eq_top_iff_not_mem_support D x).mp
      (hspan.trans (Ideal.span_singleton_eq_top.mpr hu)) hx
  let z := IdealSheafData.subschemePoint D x hx
  let eq := IdealSheafData.subschemeStalkQuotEquiv D z
  have hq : IsDomain (X.presheaf.stalk (D.subschemeι z) ⧸ IdealSheafData.stalk D
      (D.subschemeι z)) :=
    Function.Injective.isDomain eq.toRingHom eq.injective
  have hq' : IsDomain (X.presheaf.stalk x ⧸ Ideal.span {t}) := by
    rw [← hspan]
    exact hq
  exact IsLocalRing.isDomain_of_isDomain_quotient_span_singleton ht htm hq'

/-- The open subscheme on which all local rings of `X` are reduced is a reduced scheme, as is
any open contained in it. -/
public theorem isReduced_of_forall_isReduced_stalk {X : Scheme.{u}} (U : X.Opens)
    (h : ∀ z ∈ U, _root_.IsReduced (X.presheaf.stalk z)) : IsReduced U.toScheme := by
  have : ∀ z : U.toScheme, _root_.IsReduced (U.toScheme.presheaf.stalk z) := fun z ↦ by
    have : _root_.IsReduced (X.presheaf.stalk (U.ι z)) := h z.1 z.2
    let φ := (asIso (U.ι.stalkMap z)).commRingCatIsoToRingEquiv.symm
    exact isReduced_of_injective φ.toRingHom φ.injective
  exact isReduced_of_isReduced_stalk _

/-- **The classifying morphism to the blowup is an isomorphism** (the last step of
[Stacks, Tag 0C2L]). In the Stein case, with `X` Noetherian, `𝒪_{Y,y}` regular of dimension two
and the scheme-theoretic fibre over `y` equal to the curve, the morphism `g : X ⟶ Bl_y Y` over
`f` is an isomorphism.

Against `AlgebraicGeometry.isIso_blowUpClassifying_of_steinSetup_of_isReduced`, reducedness of
`X` and quasi-finiteness of `g` over the exceptional curve are no longer assumed; see the module
docstring. -/
public theorem isIso_blowUpClassifying_of_steinSetup_of_isNoetherian {X Y : Scheme.{u}}
    [IsNoetherian X] {D : X.IdealSheafData} {k : Type u} [Field k]
    {e : projectiveLineProj k ≅ D.subscheme} (hE : D.IsExceptionalCurveOfFirstKind k e)
    (f : X ⟶ Y) (y : Y) (hsetup : D.IsSteinContractionSetup f y)
    (hy : IsClosed ({y} : Set Y))
    (hreg : IsRegularLocalRing (Y.presheaf.stalk y))
    (hdim : ringKrullDim (Y.presheaf.stalk y) = 2)
    (hfibre : D = (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : Closeds Y)).comap f)
    (g : X ⟶ AlgebraicGeometry.blowUp
      (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : Closeds Y)))
    (hg : g ≫ AlgebraicGeometry.blowUpToBase
      (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : Closeds Y)) = f) :
    IsIso g := by
  have := hsetup.isNoetherian
  have := hsetup.isProper
  have := hsetup.isIso_c
  have hsupp : ∀ x ∈ (D.support : Set X), f.base x = y :=
    (D.forall_subschemeι_base_eq_iff_forall_mem_support f y).1 hsetup.base_eq
  have hbir : IsBirational g := isBirational_blowUpClassifying_of_isIso_c hE f y hy hsupp
    hsetup.quasiFinite_of_notMem hfibre g hg
  have hqfE := exists_quasiFiniteAt_blowUpClassifying_of_steinSetup e f y hsetup hy hdim g hg
  have : IsNoetherian (AlgebraicGeometry.blowUp
      (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : Closeds Y))) :=
    Stacks.ResolutionOfSurfaces.isNoetherian_blowUp _
  have : IsSeparated (AlgebraicGeometry.blowUpToBase
      (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : Closeds Y))) :=
    Stacks.RelativeProj.Situation.isSeparated_relativeProjToBase _
  have : IsProper g := isProper_of_isProper_of_isSeparated g _ f hg
  have hbg : ∀ x : X, AlgebraicGeometry.blowUpToBase
      (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : Closeds Y)) (g x) = f x :=
    fun x ↦ by
      rw [← hg]
      rfl
  -- the open of `X` on which the local rings are reduced contains the curve
  let N : X.Opens := sSup {U : X.Opens | ∀ z ∈ U, _root_.IsReduced (X.presheaf.stalk z)}
  have hN : ∀ z ∈ N, _root_.IsReduced (X.presheaf.stalk z) := fun z hz ↦ by
    obtain ⟨U, hU, hzU⟩ := TopologicalSpace.Opens.mem_sSup.mp hz
    exact hU z hzU
  have hEN : ∀ x ∈ (D.support : Set X), x ∈ N := fun x hx ↦ by
    have := isDomain_stalk_of_iso_projectiveLineProj D k e hE.isEffectiveCartierDivisor x hx
    obtain ⟨U, hxU, hU⟩ := exists_mem_forall_isReduced_stalk x inferInstance
    exact TopologicalSpace.Opens.mem_sSup.mpr ⟨U, hU, hxU⟩
  -- its complement has closed image, missing the exceptional curve
  let W : (AlgebraicGeometry.blowUp
      (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : Closeds Y))).Opens :=
    ⟨(g.base '' (N : Set X)ᶜ)ᶜ, (g.isClosedMap _ N.isOpen.isClosed_compl).isOpen_compl⟩
  have hWN : ∀ x : X, g x ∈ W → x ∈ N := fun x hx ↦ by
    by_contra hxN
    exact hx ⟨x, hxN, rfl⟩
  have hEW : ∀ w, AlgebraicGeometry.blowUpToBase
      (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : Closeds Y)) w = y → w ∈ W := by
    rintro w hw ⟨x, hxN, rfl⟩
    exact hxN (hEN x (preimage_singleton_subset_support_of_steinSetup e f y hsetup
      (show f x = y from (hbg x).symm.trans hw)))
  -- [Stacks, Tag 0BFP] for `g` over `W`
  have : IsReduced (g ⁻¹ᵁ W).toScheme :=
    isReduced_of_forall_isReduced_stalk _ fun z hz ↦ hN z (hWN z hz)
  obtain ⟨UW, hUW⟩ := Stacks.ResolutionOfSurfaces.exists_maximal_isomorphism_open (g ∣_ W)
  have hisoW : IsIso (g ∣_ (W.ι ''ᵁ UW)) :=
    ((MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
      (morphismRestrictRestrict g W UW)).mp hUW.1
  have hmemW : ∀ w, AlgebraicGeometry.blowUpToBase
      (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : Closeds Y)) w = y →
      w ∈ W.ι ''ᵁ UW := by
    intro w hw
    have hwW := hEW w hw
    obtain ⟨x, hx, hqf⟩ := hqfE w hw
    have hxW : x ∈ g ⁻¹ᵁ W := by
      show g x ∈ W
      rw [hx]
      exact hwW
    let x' : (g ⁻¹ᵁ W).toScheme := ⟨x, hxW⟩
    let w' : W.toScheme := ⟨w, hwW⟩
    have hx' : (g ∣_ W) x' = w' :=
      Subtype.ext ((morphismRestrict_base_coe g W x').trans hx)
    have hreg' : IsRegularLocalRing (W.toScheme.presheaf.stalk w') := by
      have : IsRegularLocalRing ((AlgebraicGeometry.blowUp (Scheme.IdealSheafData.vanishingIdeal
          (⟨{y}, hy⟩ : Closeds Y))).presheaf.stalk (W.ι w')) :=
        isRegularLocalRing_stalk_blowUp_of_mapsTo _ y hy rfl hreg hdim w hw
      exact IsRegularLocalRing.of_ringEquiv
        (asIso (W.ι.stalkMap w')).commRingCatIsoToRingEquiv
    have := IsRegularLocalRing.isDomain (W.toScheme.presheaf.stalk w')
    have := isIntegrallyClosed_of_isRegularLocalRing (W.toScheme.presheaf.stalk w')
    have hnormal : IsNormalRing (W.toScheme.presheaf.stalk w') :=
      IsNormalRing.of_isIntegrallyClosed _
    have hqf' : quasiFiniteAt (g ∣_ W) x' :=
      ⟨finiteTypeAt_of_locallyOfFiniteType _ x',
        (RingHom.QuasiFinite.respectsIso.arrow_mk_iso_iff
          (morphismRestrictStalkMap g W x')).mpr hqf⟩
    have hmem := mem_maximal_isomorphism_open_of_quasiFiniteAt_of_isNormal (g ∣_ W)
      (birational_morphismRestrict g hbir W) UW hUW w' hnormal x' hx' hqf'
    exact ⟨w', hmem, rfl⟩
  -- assemble
  obtain ⟨U, hU⟩ := Stacks.ResolutionOfSurfaces.exists_maximal_isomorphism_open g
  have hmem : ∀ w, w ∈ U := by
    intro w
    refine mem_maximal_isomorphism_open_of_exists_isIso_restrict g U hU w ?_
    by_cases hw : AlgebraicGeometry.blowUpToBase
      (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : Closeds Y)) w = y
    · exact ⟨_, hmemW w hw, hisoW⟩
    · exact exists_isIso_morphismRestrict_blowUpClassifying (D := D) f y hy hsupp
        hsetup.quasiFinite_of_notMem g hg w hw
  have hUtop : U = ⊤ := TopologicalSpace.Opens.ext (Set.eq_univ_iff_forall.mpr hmem)
  have : IsIso (g ∣_ (⊤ : (AlgebraicGeometry.blowUp
      (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : Closeds Y))).Opens)) := hUtop ▸ hU.1
  exact Stacks.AlgebraicGeometry.InvertibleFiniteDescent.isIso_of_isIso_morphismRestrict_top g

end AlgebraicGeometry

end
