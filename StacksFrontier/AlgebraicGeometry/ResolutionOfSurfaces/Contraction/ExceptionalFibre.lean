/-!
# The scheme-theoretic fibre over the image point is the curve

Let `E ⊆ X` be an exceptional curve of the first kind with ideal sheaf `D`, and let `f : X ⟶ Y`
carry `E` to a closed point `y` whose set-theoretic fibre is `E`. Write `A = lim H⁰(Eₙ, 𝒪)` and
`I₁` for the kernel of `A ⟶ H⁰(E, 𝒪)`. If `I₁` is generated by the image of `𝔪_y`, then the
scheme-theoretic fibre `X_y` is `E`: in ideal-sheaf terms `ℐ_y · 𝒪_X = D`. This is the step
"`X_y = E` scheme theoretically" of the proof of [Stacks, Tag 0C2L].

## Main results

* `AlgebraicGeometry.eq_comap_vanishingIdeal_singleton_of_le_map_maximalIdeal` — the equality
  `D = ℐ_y · 𝒪_X`.
* `AlgebraicGeometry.stalk_le_stalk_comap_vanishingIdeal_of_mem_support` — its stalkwise content
  along the curve.
* `Stacks.Divisors.exists_germ_subschemeι_app_eq_mul` — near a point where a section `τ` of the
  conormal sheaf does not vanish, the image of `D` on the second thickening is generated by the
  image of `τ`.
* `AlgebraicGeometry.exists_smul_Γgerm_pushforward` — a germ generating a stalk still generates
  it after direct image along a closed immersion.

## Proof

The inclusion `ℐ_y · 𝒪_X ≤ D` holds because `E` is reduced and maps to `y`. Conversely, at
`x ∈ E` the conormal sheaf `𝒪_X(-E)|_E ≅ 𝒪_{𝐏¹}(1)` has a global section `τ` not vanishing at `x`
(`IsExceptionalCurveOfFirstKind.exists_mem_nonvanishingLocus`).
Its image on `E₂` lifts to an element of `I₁ ≤ 𝔪_y A`, whose germ at `x` therefore lies in the
image of `(ℐ_y · 𝒪_X)_x`; since that germ generates `D_x / D_x²`, `D_x ≤ (ℐ_y · 𝒪_X)_x + D_x²`,
and Nakayama's lemma gives `D_x ≤ (ℐ_y · 𝒪_X)_x`. Off `E` both stalks are the unit ideal because
`D^N ≤ ℐ_y · 𝒪_X` for some `N`.
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite AlgebraicGeometry
open RingedSpaceModuleAdjunction (modulePullbackPushforwardAdjunction)
open scoped Stacks.ModuleStalk

universe u

namespace AlgebraicGeometry

/-- Two successive restrictions of a section of an `𝒪_X`-module are one restriction. -/
public theorem Scheme.Modules.presheaf_map_map_apply {Y : Scheme.{u}} (M : Y.Modules)
    {A B C : Y.Opens} (f₁ : op A ⟶ op B) (f₂ : op B ⟶ op C) (f₃ : op A ⟶ op C)
    (x : Γ(M, A)) : M.presheaf.map f₂ (M.presheaf.map f₁ x) = M.presheaf.map f₃ x := by
  rw [Subsingleton.elim f₃ (f₁ ≫ f₂), Functor.map_comp, ConcreteCategory.comp_apply]

/-- A scalar section times the germ of a global section is the germ of the scalar multiple of
its restriction. -/
private theorem germ_smul_Γgerm_eq_germ_smul_res {Y : Scheme.{u}} (M : Y.Modules) (y : Y)
    {W : Y.Opens} (hW : y ∈ W) (g : Γ(Y, W)) (b : Γ(M, ⊤)) :
    Y.presheaf.germ W y hW g • (M.presheaf.Γgerm y).hom b =
      (M.presheaf.germ W y hW).hom (g • M.presheaf.map (homOfLE le_top).op b) := by
  rw [Stacks.ModuleStalk.germ_smul]
  exact congrArg (fun m => Y.presheaf.germ W y hW g • m)
    (TopCat.Presheaf.Γgerm_res_apply M.presheaf y hW b).symm

/-- Germs of functions read in the direct image of the structure sheaf: an equation between
germs at `ι t` of sections of `ι_* 𝒪_T` becomes an equation between germs at `t`. -/
public theorem germ_eq_stalkMap_mul_of_germ_pushforward_unit {T X : Scheme.{u}} (ι : T ⟶ X)
    (t : T) {x : X} (hx : ι.base t = x) {U : X.Opens} (hU : x ∈ U) (a : Γ(T, ι ⁻¹ᵁ U))
    (b : Γ(T, ⊤)) (r : X.presheaf.stalk x)
    (h : (((Scheme.Modules.pushforward ι).obj
        (SheafOfModules.unit T.ringCatSheaf)).presheaf.germ U x hU).hom a =
      r • (((Scheme.Modules.pushforward ι).obj
        (SheafOfModules.unit T.ringCatSheaf)).presheaf.Γgerm x).hom b) :
    ∃ r' : T.presheaf.stalk t,
      T.presheaf.germ (ι ⁻¹ᵁ U) t (show ι.base t ∈ U from hx ▸ hU) a =
        r' * T.presheaf.Γgerm t b := by
  subst hx
  obtain ⟨W, hW, g, rfl⟩ := X.presheaf.exists_germ_eq r
  set O := (Scheme.Modules.pushforward ι).obj (SheafOfModules.unit T.ringCatSheaf)
  have h' : (O.presheaf.germ U (ι.base t) hU).hom a =
      (O.presheaf.germ W (ι.base t) hW).hom (g • O.presheaf.map (homOfLE le_top).op b) := by
    exact h.trans (germ_smul_Γgerm_eq_germ_smul_res O _ hW g b)
  obtain ⟨V, hV, iU, iW, he⟩ := TopCat.Presheaf.germ_eq _ _ _ _ _ _ h'
  refine ⟨ι.stalkMap t (X.presheaf.germ W (ι.base t) hW g), ?_⟩
  have he' : T.presheaf.germ (ι ⁻¹ᵁ V) t hV
        (T.presheaf.map ((TopologicalSpace.Opens.map ι.base).map iU).op a) =
      T.presheaf.germ (ι ⁻¹ᵁ V) t hV
        (T.presheaf.map ((TopologicalSpace.Opens.map ι.base).map iW).op
          (ι.app W g * T.presheaf.map ((TopologicalSpace.Opens.map ι.base).map
            (homOfLE le_top)).op b)) :=
    congrArg (T.presheaf.germ (ι ⁻¹ᵁ V) t hV) he
  have e1 := TopCat.Presheaf.germ_res_apply T.presheaf
    ((TopologicalSpace.Opens.map ι.base).map iU) t hV a
  have e2 := TopCat.Presheaf.germ_res_apply T.presheaf
    ((TopologicalSpace.Opens.map ι.base).map iW) t hV
    (ι.app W g * T.presheaf.map ((TopologicalSpace.Opens.map ι.base).map
            (homOfLE le_top)).op b)
  have e3 := TopCat.Presheaf.Γgerm_res_apply T.presheaf
    (i := (TopologicalSpace.Opens.map ι.base).map (homOfLE le_top)) t
    (show t ∈ ι ⁻¹ᵁ W from hW) b
  have e4 := Scheme.Hom.germ_stalkMap_apply ι W t hW g
  refine e1.symm.trans (he'.trans (e2.trans ?_))
  rw [map_mul]
  exact congrArg₂ (· * ·) e4.symm e3

/-- **Generation of a stalk survives the direct image along a closed immersion.** -/
public theorem exists_smul_Γgerm_pushforward {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    (L : Z.Modules) (τ : Γ(L, ⊤)) (z : Z)
    (hz : ∀ m : TopCat.Presheaf.stalk (C := Ab.{u}) L.presheaf z,
      ∃ r : Z.presheaf.stalk z, m = r • (L.presheaf.Γgerm z).hom τ)
    (m : TopCat.Presheaf.stalk (C := Ab.{u}) ((Scheme.Modules.pushforward i).obj L).presheaf
      (i.base z)) :
    ∃ r : X.presheaf.stalk (i.base z),
      m = r • (((Scheme.Modules.pushforward i).obj L).presheaf.Γgerm (i.base z)).hom τ := by
  let P := (Scheme.Modules.pushforward i).obj L
  obtain ⟨U, hU, s, rfl⟩ := P.presheaf.exists_germ_eq m
  obtain ⟨r', hr'⟩ := hz ((L.presheaf.germ (i ⁻¹ᵁ U) z hU).hom s)
  obtain ⟨r, rfl⟩ := i.stalkMap_surjective z r'
  obtain ⟨W, hW, g, rfl⟩ := X.presheaf.exists_germ_eq r
  have hW' : z ∈ i ⁻¹ᵁ W := hW
  have hr'' : (L.presheaf.germ (i ⁻¹ᵁ U) z hU).hom s =
      (L.presheaf.germ (i ⁻¹ᵁ W) z hW').hom
        (i.app W g • L.presheaf.map (homOfLE le_top).op τ) := by
    rw [hr', Scheme.Hom.germ_stalkMap_apply]
    exact germ_smul_Γgerm_eq_germ_smul_res L z hW' (i.app W g) τ
  obtain ⟨W', hW'', iU, iW, he⟩ := TopCat.Presheaf.germ_eq _ _ _ _ _ _ hr''
  obtain ⟨V, hVo, hVeq⟩ := i.isClosedEmbedding.isInducing.isOpen_iff.mp W'.isOpen
  let V' : X.Opens := (⟨V, hVo⟩ ⊓ U) ⊓ W
  have hzV : i.base z ∈ V' := by
    refine ⟨⟨?_, hU⟩, hW⟩
    show z ∈ i.base ⁻¹' V
    rw [hVeq]
    exact hW''
  have hle : i ⁻¹ᵁ V' ≤ W' := fun w hw => by
    rw [← SetLike.mem_coe, ← hVeq]
    exact hw.1.1
  have hV'U : V' ≤ U := fun w hw => hw.1.2
  have hV'W : V' ≤ W := fun w hw => hw.2
  have hVU' : i ⁻¹ᵁ V' ≤ i ⁻¹ᵁ U := fun w hw => hV'U hw
  have hVW' : i ⁻¹ᵁ V' ≤ i ⁻¹ᵁ W := fun w hw => hV'W hw
  have hnat : Z.presheaf.map (homOfLE hVW').op (i.app W g) =
      i.app V' (X.presheaf.map (homOfLE hV'W).op g) := by
    have h2 := congrArg (fun φ => φ g) (i.naturality (homOfLE hV'W).op)
    simp only [ConcreteCategory.comp_apply] at h2
    exact h2.symm
  have keyL : L.presheaf.map (homOfLE hVU').op s =
      i.app V' (X.presheaf.map (homOfLE hV'W).op g) •
        L.presheaf.map (homOfLE (le_top : i ⁻¹ᵁ V' ≤ ⊤)).op τ := by
    calc L.presheaf.map (homOfLE hVU').op s
        = L.presheaf.map (homOfLE hle).op (L.presheaf.map iU.op s) :=
          (Scheme.Modules.presheaf_map_map_apply L iU.op (homOfLE hle).op _ s).symm
      _ = L.presheaf.map (homOfLE hle).op (L.presheaf.map iW.op
            (i.app W g • L.presheaf.map (homOfLE le_top).op τ)) := by rw [he]
      _ = L.presheaf.map (homOfLE hVW').op
            (i.app W g • L.presheaf.map (homOfLE le_top).op τ) :=
          Scheme.Modules.presheaf_map_map_apply L iW.op (homOfLE hle).op _ _
      _ = Z.presheaf.map (homOfLE hVW').op (i.app W g) •
            L.presheaf.map (homOfLE hVW').op (L.presheaf.map (homOfLE le_top).op τ) :=
          Scheme.Modules.map_smul L (homOfLE hVW') _ _
      _ = i.app V' (X.presheaf.map (homOfLE hV'W).op g) •
            L.presheaf.map (homOfLE (le_top : i ⁻¹ᵁ V' ≤ ⊤)).op τ := by
          rw [hnat, Scheme.Modules.presheaf_map_map_apply]
  have key : P.presheaf.map (homOfLE hV'U).op s =
      X.presheaf.map (homOfLE hV'W).op g • P.presheaf.map (homOfLE le_top).op τ := keyL
  refine ⟨X.presheaf.germ W (i.base z) hW g, ?_⟩
  let τ' : Γ(P, ⊤) := τ
  calc P.presheaf.germ U (i.base z) hU s
      = P.presheaf.germ V' (i.base z) hzV (P.presheaf.map (homOfLE hV'U).op s) :=
        (TopCat.Presheaf.germ_res_apply P.presheaf (homOfLE hV'U) (i.base z) hzV s).symm
    _ = P.presheaf.germ V' (i.base z) hzV
          (X.presheaf.map (homOfLE hV'W).op g • P.presheaf.map (homOfLE le_top).op τ') := by
        rw [key]
    _ = X.presheaf.germ V' (i.base z) hzV (X.presheaf.map (homOfLE hV'W).op g) •
          P.presheaf.Γgerm (i.base z) τ' :=
        (germ_smul_Γgerm_eq_germ_smul_res P _ hzV _ τ').symm
    _ = X.presheaf.germ W (i.base z) hW g • P.presheaf.Γgerm (i.base z) τ' := by
        rw [TopCat.Presheaf.germ_res_apply]

end AlgebraicGeometry

namespace Stacks.Divisors

variable {X : Scheme.{u}}

/-- **The image of `D^{n+1}` on the next thickening is generated near a point by a nonvanishing
conormal section.** Let `τ` be a global section of `𝒪_X(-(n+1)E)|_E` not vanishing at a point
`z` of `E`, and let `x ∈ Γ(E_{n+2}, 𝒪)` be its image under the kernel inclusion of
[Stacks, Tag 0C4T]. Then at a point `z'` of `E_{n+2}` over the same point of `X`, the germ of
the image of every local section of `D^{n+1}` is a multiple of the germ of `x`. -/
public theorem exists_germ_subschemeι_app_eq_mul (D : X.IdealSheafData)
    [IsEffectiveCartierDivisor D] (n : ℕ)
    (τ : Γ((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (n + 1))), ⊤))
    (z : D.subscheme)
    (hz : z ∈ Stacks.Ample.nonvanishingLocus
      ((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (n + 1)))) τ)
    (z' : (D ^ (n + 2)).subscheme)
    (hz' : (D ^ (n + 2)).subschemeι.base z' = D.subschemeι.base z)
    (U : X.Opens) (hU : D.subschemeι.base z ∈ U)
    (y : (idealSheafOfModules (D ^ (n + 1))).val.obj (op U)) :
    ∃ r : (D ^ (n + 2)).subscheme.presheaf.stalk z',
      (D ^ (n + 2)).subscheme.presheaf.germ ((D ^ (n + 2)).subschemeι ⁻¹ᵁ U) z'
          (show (D ^ (n + 2)).subschemeι.base z' ∈ U from hz' ▸ hU)
          ((D ^ (n + 2)).subschemeι.app U (idealSheafSection (D ^ (n + 1)) y)) =
        r * (D ^ (n + 2)).subscheme.presheaf.Γgerm z'
          ((thickeningKernelMap D n).app ⊤ τ) := by
  have : Stacks.Ample.IsInvertibleModule X (negativeTwist (D ^ (n + 1))) :=
    (inferInstance : IsEffectiveCartierDivisor (D ^ (n + 1)))
  have : Stacks.Ample.IsInvertibleModule D.subscheme
      ((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (n + 1)))) :=
    Stacks.InvertiblePullback.isInvertibleModule_pullback D.subschemeι _
  let u : (negativeTwist (D ^ (n + 1)) : X.Modules) ⟶
      (Scheme.Modules.pushforward D.subschemeι).obj
        ((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (n + 1)))) :=
    (modulePullbackPushforwardAdjunction D.subschemeι.toLRSHom.toShHom).unit.app
      (negativeTwist (D ^ (n + 1)))
  let ψ : (negativeTwist (D ^ (n + 1)) : X.Modules) ⟶
      Scheme.IdealSheafData.closedSubschemeStructureSheaf (D ^ (n + 2)) :=
    idealInclusion (D ^ (n + 1)) ≫ Stacks.IdealSheafSequence.divisorQuotientMap (D ^ (n + 2))
  have hφ : u ≫ thickeningKernelMap D n = ψ := unit_comp_thickeningKernelMap D n
  obtain ⟨c, hc⟩ := exists_smul_Γgerm_pushforward D.subschemeι _ τ z
    (Stacks.SectionProduct.exists_smul_Γgerm _ τ hz)
    ((((Scheme.Modules.pushforward D.subschemeι).obj
      ((Scheme.Modules.pullback D.subschemeι).obj (negativeTwist (D ^ (n + 1))))).presheaf.germ
        U _ hU).hom (Scheme.Modules.Hom.app u U y))
  have h1 := Stacks.ModuleStalk.mapFun_comp u (thickeningKernelMap D n) (D.subschemeι.base z)
    ((Scheme.Modules.presheaf (X := X) (negativeTwist (D ^ (n + 1)))).germ U _ hU y)
  have h3 := (Stacks.ModuleStalk.mapFun_germ ψ _ U hU y).symm.trans
    ((congrArg (fun φ => Stacks.ModuleStalk.mapFun φ (D.subschemeι.base z)
        ((Scheme.Modules.presheaf (X := X) (negativeTwist (D ^ (n + 1)))).germ U _ hU y))
          hφ).symm.trans
      (h1.trans ((congrArg (Stacks.ModuleStalk.mapFun (thickeningKernelMap D n) _)
        ((Stacks.ModuleStalk.mapFun_germ u _ U hU y).trans hc)).trans
        ((Stacks.ModuleStalk.mapFun_smul (thickeningKernelMap D n) _ c _).trans
          (congrArg (c • ·) (Stacks.ModuleStalk.mapFun_Γgerm (thickeningKernelMap D n) _ τ))))))
  exact germ_eq_stalkMap_mul_of_germ_pushforward_unit _ z' hz' hU _ _ c h3

end Stacks.Divisors

namespace AlgebraicGeometry

/-- The germ at a point `t` of the pullback of a germ at `h t`, for a morphism `h` all of whose
points go to `h t`, is the image of the germ under the map of local rings. -/
public theorem Scheme.Hom.Γgerm_stalkToΓ {T Y : Scheme.{u}} (h : T ⟶ Y) (t : T)
    (hy : ∀ t' : T, h.base t' = h.base t) (s : Y.presheaf.stalk (h.base t)) :
    T.presheaf.Γgerm t ((Scheme.Hom.stalkToΓ h (h.base t) hy).hom s) = h.stalkMap t s := by
  obtain ⟨U, hU, s, rfl⟩ := Y.presheaf.exists_germ_eq s
  rw [Scheme.Hom.stalkToΓ_germ, Scheme.Hom.germ_stalkMap_apply, Scheme.Hom.appLE,
    ConcreteCategory.comp_apply]
  exact TopCat.Presheaf.germ_res_apply T.presheaf _ t (TopologicalSpace.Opens.mem_top t) _

open Scheme.IdealSheafData Stacks.Divisors in
/-- **At a point of the curve, the stalk of `D` lies in that of `ℐ_y · 𝒪_X`.** A conormal
section not vanishing at the point lies in `I₁`, hence in `𝔪_y A`, so the stalk of `D` lies in
the stalk of `ℐ_y · 𝒪_X` plus the square of itself, and Nakayama's lemma concludes. -/
public theorem stalk_le_stalk_comap_vanishingIdeal_of_mem_support {X Y : Scheme.{u}}
    [IsNoetherian X] {D : X.IdealSheafData} {k : Type u} [Field k]
    {e : projectiveLineProj k ≅ D.subscheme} (hE : D.IsExceptionalCurveOfFirstKind k e)
    (f : X ⟶ Y) (y : Y) (hy : IsClosed ({y} : Set Y))
    (hmaps : ∀ x ∈ (D.support : Set X), f.base x = y)
    (hgen : D.formalNeighborhoodFiltration 1 ≤
      Ideal.map (D.stalkToFormalNeighborhood f y hmaps)
        (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)))
    {x : X} (hx : x ∈ D.support) :
    IdealSheafData.stalk D x ≤ IdealSheafData.stalk
      ((Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : TopologicalSpace.Closeds Y)).comap f)
        x := by
  have : IsEffectiveCartierDivisor D := hE.isEffectiveCartierDivisor
  obtain ⟨z', rfl⟩ : x ∈ Set.range (D ^ (0 + 2)).subschemeι.base := by
    rw [range_subschemeι]
    exact hx
  obtain ⟨z, hz⟩ : (D ^ (0 + 2)).subschemeι.base z' ∈ Set.range D.subschemeι.base := by
    rw [range_subschemeι]
    exact hx
  obtain rfl := hmaps _ hx
  obtain ⟨J, hJ⟩ : ∃ J, (Scheme.IdealSheafData.vanishingIdeal
      (⟨{f.base ((D ^ (0 + 2)).subschemeι.base z')}, hy⟩ : TopologicalSpace.Closeds Y)).comap f =
        J :=
    ⟨_, rfl⟩
  rw [hJ]
  -- the image of `J` in the local ring of the second thickening contains the germ of every
  -- compatible function in `I₁`
  have hΦ : ∀ a ∈ D.formalNeighborhoodFiltration 1,
      (D ^ (0 + 2)).subscheme.presheaf.Γgerm z' (formalNeighborhoodProjection D 1 a) ∈
        Ideal.map ((D ^ (0 + 2)).subschemeι.stalkMap z').hom
          (IdealSheafData.stalk J ((D ^ (0 + 2)).subschemeι.base z')) := by
    let Φ : formalNeighborhoodRing D →+* (D ^ (0 + 2)).subscheme.presheaf.stalk z' :=
      ((D ^ (0 + 2)).subscheme.presheaf.Γgerm z').hom.comp (formalNeighborhoodProjection D 1)
    have hle : Ideal.map
        (D.stalkToFormalNeighborhood f (f.base ((D ^ (0 + 2)).subschemeι.base z')) hmaps)
        (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f.base ((D ^ (0 + 2)).subschemeι.base z')))) ≤
        Ideal.comap Φ (Ideal.map ((D ^ (0 + 2)).subschemeι.stalkMap z').hom
          (IdealSheafData.stalk J ((D ^ (0 + 2)).subschemeι.base z'))) := by
      rw [Ideal.map_le_iff_le_comap]
      intro s hs
      have hΦs :
          Φ (D.stalkToFormalNeighborhood f (f.base ((D ^ (0 + 2)).subschemeι.base z')) hmaps s) =
            (D ^ (0 + 2)).subschemeι.stalkMap z'
              (f.stalkMap ((D ^ (0 + 2)).subschemeι.base z') s) := by
        refine (Scheme.Hom.Γgerm_stalkToΓ ((D ^ (0 + 2)).subschemeι ≫ f) z' _ s).trans ?_
        rw [Scheme.Hom.stalkMap_comp]
        rfl
      have hmem : (D ^ (0 + 2)).subschemeι.stalkMap z'
          (f.stalkMap ((D ^ (0 + 2)).subschemeι.base z') s) ∈
          Ideal.map ((D ^ (0 + 2)).subschemeι.stalkMap z').hom
            (IdealSheafData.stalk J ((D ^ (0 + 2)).subschemeι.base z')) := by
        refine Ideal.mem_map_of_mem _ ?_
        rw [← hJ, IdealSheafData.stalk_comap, IdealSheafData.stalk_vanishingIdeal_singleton]
        exact Ideal.mem_map_of_mem _ hs
      exact Ideal.mem_comap.mpr ((congrArg (fun w => w ∈ Ideal.map
        ((D ^ (0 + 2)).subschemeι.stalkMap z').hom
            (IdealSheafData.stalk J ((D ^ (0 + 2)).subschemeι.base z'))) hΦs).mpr
        hmem)
    exact fun a ha => Ideal.mem_comap.mp (hle (hgen ha))
  -- the germ at `z'` of the image of `D` on the second thickening lies in the image of `J`
  have hloc : IdealSheafData.stalk D ((D ^ (0 + 2)).subschemeι.base z') ≤
      Ideal.comap ((D ^ (0 + 2)).subschemeι.stalkMap z').hom
        (Ideal.map ((D ^ (0 + 2)).subschemeι.stalkMap z').hom
          (IdealSheafData.stalk J ((D ^ (0 + 2)).subschemeι.base z'))) := by
    obtain ⟨_, ⟨U₀, hU₀, rfl⟩, hxU, -⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
      (Set.mem_univ ((D ^ (0 + 2)).subschemeι.base z')) isOpen_univ
    let U : X.affineOpens := ⟨U₀, hU₀⟩
    rw [IdealSheafData.stalk_eq_map_germ D _ U hxU, Ideal.map_le_iff_le_comap]
    intro r hr
    have hr' : r ∈ (D ^ (0 + 1)).ideal U := by
      rwa [zero_add, pow_one]
    obtain ⟨y', rfl⟩ := (mem_ideal_iff_exists_idealSheafSection _ U r).mp hr'
    obtain ⟨σ, hσ⟩ := hE.exists_mem_nonvanishingLocus z
    obtain ⟨c, hc⟩ := exists_germ_subschemeι_app_eq_mul D 0 σ z hσ z' hz.symm U.1
      (hz ▸ hxU) y'
    obtain ⟨a, ha⟩ := hE.surjective_formalNeighborhoodProjection 1
      ((thickeningKernelMap D 0).app ⊤ σ)
    have ha1 : a ∈ D.formalNeighborhoodFiltration 1 := by
      refine (mem_formalNeighborhoodFiltration_succ_iff D 0 a).mpr ?_
      refine (thickeningRestriction_formalNeighborhoodProjection D 0 a).symm.trans ?_
      rw [ha]
      exact thickeningRestriction_curveAppTop_thickeningKernelMap D 0 σ
    refine Ideal.mem_comap.mpr (Ideal.mem_comap.mpr ?_)
    rw [Scheme.Hom.germ_stalkMap_apply, hc]
    refine Ideal.mul_mem_left _ c ?_
    have := hΦ a ha1
    rwa [ha] at this
  have hsurj := (D ^ (0 + 2)).subschemeι.stalkMap_surjective z'
  have hker : RingHom.ker ((D ^ (0 + 2)).subschemeι.stalkMap z').hom =
      IdealSheafData.stalk D ((D ^ (0 + 2)).subschemeι.base z') •
        IdealSheafData.stalk D ((D ^ (0 + 2)).subschemeι.base z') := by
    rw [← IdealSheafData.stalk_ker_of_isClosedImmersion, Scheme.IdealSheafData.ker_subschemeι,
      Ideal.smul_eq_mul, ← IdealSheafData.stalk_mul]
    exact congrArg (fun I => IdealSheafData.stalk I ((D ^ (0 + 2)).subschemeι.base z')) (sq D)
  have hfg : (IdealSheafData.stalk D ((D ^ (0 + 2)).subschemeι.base z')).FG :=
    IsNoetherian.noetherian _
  have hjac : IdealSheafData.stalk D ((D ^ (0 + 2)).subschemeι.base z') ≤ Ideal.jacobson ⊥ :=
    (IsLocalRing.le_maximalIdeal fun h =>
      ((IdealSheafData.stalk_eq_top_iff_not_mem_support D _).mp h) hx).trans
      (IsLocalRing.maximalIdeal_le_jacobson _)
  refine Submodule.le_of_le_smul_of_le_jacobson_bot hfg hjac ?_
  rw [← hker]
  refine hloc.trans (le_of_eq ?_)
  rw [Ideal.comap_map_of_surjective _ hsurj]
  rfl

/-- **The scheme-theoretic fibre over `y` is the curve** (the step "`X_y = E`" of the proof of
[Stacks, Tag 0C2L]). Let `E ⊆ X` be an exceptional curve of the first kind with ideal sheaf `D`,
and let `f : X ⟶ Y` carry `E` to a closed point `y` with `f⁻¹(y) = E` set-theoretically. If the
maximal ideal `I₁` of `A = lim H⁰(Eₙ, 𝒪)` is generated by the image of `𝔪_y`, then
`ℐ_y · 𝒪_X = D`.

The inclusion `ℐ_y · 𝒪_X ≤ D` holds since `E` is reduced and carried to `y`. For the other, at a
point `x ∈ E` choose a global section of the conormal sheaf `𝒪_X(-E)|_E ≅ 𝒪(1)` not vanishing at
`x`; its image on the second thickening lies in `I₁`, hence in `𝔪_y A`, so near `x` the ideal
`D` lies in `ℐ_y · 𝒪_X + D²`, and Nakayama's lemma gives `D ≤ ℐ_y · 𝒪_X` there. Away from `E`
both stalks are the unit ideal, since `D^N ≤ ℐ_y · 𝒪_X` for some `N`. -/
public theorem eq_comap_vanishingIdeal_singleton_of_le_map_maximalIdeal {X Y : Scheme.{u}}
    [IsNoetherian X] {D : X.IdealSheafData} {k : Type u} [Field k]
    {e : projectiveLineProj k ≅ D.subscheme} (hE : D.IsExceptionalCurveOfFirstKind k e)
    (f : X ⟶ Y) (y : Y) (hy : IsClosed ({y} : Set Y))
    (hmaps : ∀ x ∈ (D.support : Set X), f.base x = y)
    (hfib : f.base ⁻¹' {y} ⊆ (D.support : Set X))
    (hgen : D.formalNeighborhoodFiltration 1 ≤
      Ideal.map (D.stalkToFormalNeighborhood f y hmaps)
        (IsLocalRing.maximalIdeal (Y.presheaf.stalk y))) :
    D = (Scheme.IdealSheafData.vanishingIdeal
      (⟨{y}, hy⟩ : TopologicalSpace.Closeds Y)).comap f := by
  have : IsReduced D.subscheme := isReduced_subscheme_of_projectiveLineProj_iso k e
  obtain ⟨N, hN⟩ := exists_pow_le_comap_vanishingIdeal_singleton D f y hy hfib
  refine le_antisymm ?_ (comap_vanishingIdeal_singleton_le_of_isReduced_subscheme D f y hy
    ((D.forall_subschemeι_base_eq_iff_forall_mem_support f y).2 hmaps))
  refine IdealSheafData.le_of_stalk_le _ _ fun x => ?_
  by_cases hx : x ∈ D.support
  · exact stalk_le_stalk_comap_vanishingIdeal_of_mem_support hE f y hy hmaps hgen hx
  · have h1 : IdealSheafData.stalk D x = ⊤ :=
      (IdealSheafData.stalk_eq_top_iff_not_mem_support D x).2 hx
    have h2 := IdealSheafData.stalk_mono hN x
    rw [IdealSheafData.stalk_pow, h1, Ideal.top_pow] at h2
    rwa [h1]

end AlgebraicGeometry

