module

public import StacksFrontier.AlgebraicGeometry.AffineSubsheaf.Basic
public import StacksFrontier.AlgebraicGeometry.Cohomology.Coherent.NoetherianCoherent
public import StacksFrontier.AlgebraicGeometry.ProjectiveFromSections.Ratio

/-!
# The subsheaf generated by a family of global sections generates its own stalks

Let `F` be a quasi-coherent `𝒪_X`-module and `s : ι → Γ(F, ⊤)` a family of global sections. The
subsheaf `Stacks.AlgebraicGeometry.Tag01PFAffineSubsheaf.spanRestrictSubsheaf F (Set.range s)`
cut out by the spans of the restrictions of the `s i` contains each `s i` as a global section,
and those global sections generate every one of its stalks. On a locally Noetherian scheme the
subsheaf is moreover coherent, for a finite family.

Both statements are what a construction out of a *non-generating* family of sections of `F`
needs: they say that, after `F` is replaced by the subsheaf the family does generate, the
hypothesis of [Stacks, Tag 01NE] — in the stalkwise form
`Stacks.ProjectiveFromSections.GeneratesStalks` — is satisfied.

## Main definitions

* `Stacks.AlgebraicGeometry.Tag01PFAffineSubsheaf.spanRestrictModule`: the subsheaf cut out by a
  set of global sections, read as an `𝒪_X`-module rather than as a submodule.
* `Stacks.AlgebraicGeometry.Tag01PFAffineSubsheaf.spanRestrictSubsheafι`: its inclusion into `F`.
* `Stacks.AlgebraicGeometry.Tag01PFAffineSubsheaf.spanRangeSection`: the member `s i` of the
  family, read as a global section of the subsheaf it helps generate.

## Main results

* `Stacks.AlgebraicGeometry.Tag01PFAffineSubsheaf.generatesStalks_of_affineSpan`: a family of
  global sections of an `𝒪_X`-module whose restrictions span the sections over every affine open
  generates every stalk.
* `Stacks.AlgebraicGeometry.Tag01PFAffineSubsheaf.app_spanRestrictSubsheafι_spanRangeSection`: the
  inclusion of the subsheaf carries `spanRangeSection F s i` to `s i`.
* `Stacks.AlgebraicGeometry.Tag01PFAffineSubsheaf.generatesStalks_spanRangeSection`: **the family
  generates every stalk of the subsheaf it cuts out.**
* `Stacks.AlgebraicGeometry.Tag01PFAffineSubsheaf.isCoherent_spanRestrictModule`: on a locally
  Noetherian scheme the subsheaf cut out by a finite set of global sections is coherent.

## Implementation notes

**No invertibility hypothesis, and no stalk-of-a-submodule theory.**
`Stacks.ProjectiveFromSections.GeneratesStalks` is a bare statement about the stalks of the
module itself, so generation is proved here directly rather than through the nonvanishing-cover
criterion `Stacks.AmpleImmersionReduction.generatesStalks_iff_forall_exists_mem`, which needs the
module to be invertible. The argument is the affine-open description of the sections,
`obj_spanRestrictSubsheaf`: a germ at `x` is represented over some open, that open is shrunk to
an affine one by `AlgebraicGeometry.Scheme.isBasis_affineOpens`, and there the representing
section is by construction a *finite* `Γ(X, U)`-combination of the restrictions of the `s i`.
Taking germs of that one equation is the whole proof, and it is isolated as
`generatesStalks_of_affineSpan`, which mentions neither `F` nor the subsheaf.

The combination is lifted from `F` back into the subsheaf by injectivity of the inclusion on
sections — the sections of the subsheaf over an open are a submodule of those of `F` — so no
identification of the stalk of the subsheaf with a submodule of the stalk of `F` is needed.

The index type is arbitrary, so the decomposition is taken as a `Finsupp` through
`Finsupp.mem_span_range_iff_exists_finsupp`; its support is the `Finset` that
`GeneratesStalks` asks for, and `Finsupp.sum` is its sum over that support by definition.

`AlgebraicGeometry.Scheme.Modules` is a `def` over `SheafOfModules`, so the sheaf of modules
attached to a `SheafOfModules.Submodule` has to be ascribed to `X.Modules` to be read in that
category; `spanRestrictModule` is that ascription, named once.

## References

* [Stacks Project, Tag 01PF](https://stacks.math.columbia.edu/tag/01PF)
* [Stacks Project, Tag 01NE](https://stacks.math.columbia.edu/tag/01NE)
* [Stacks Project, Tag 01XZ](https://stacks.math.columbia.edu/tag/01XZ)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace Opposite AlgebraicGeometry
open Stacks.ModuleStalk

universe u

namespace Stacks.AlgebraicGeometry.Tag01PFAffineSubsheaf

variable {X : Scheme.{u}}

/-- A member of a span over a range is a sum over the support of a finitely supported family of
coefficients. -/
private theorem exists_sum_support_smul_eq {R M ι : Type*} [Semiring R] [AddCommMonoid M]
    [Module R M] {v : ι → M} {x : M} (h : x ∈ Submodule.span R (Set.range v)) :
    ∃ c : ι →₀ R, ∑ i ∈ c.support, c i • v i = x :=
  Finsupp.mem_span_range_iff_exists_finsupp.mp h

/-- **A family of global sections whose restrictions span the sections over every affine open
generates every stalk.** A germ at `x` is represented by a section over some open; the affine
opens form a basis, so the open may be shrunk to an affine one, where the representing section
is a finite combination of the restrictions of the family. Taking germs of that equation
exhibits the germ as a combination of the germs of the family. -/
theorem generatesStalks_of_affineSpan {L : X.Modules} {ι : Type*} (t : ι → Γ(L, ⊤))
    (hspan : ∀ (U : X.affineOpens) (z : Γ(L, U.1)),
      z ∈ Submodule.span Γ(X, U.1)
        (Set.range fun i => L.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op (t i))) :
    Stacks.ProjectiveFromSections.GeneratesStalks t := by
  classical
  intro x w
  obtain ⟨V, hxV, z, hz⟩ := L.presheaf.exists_germ_eq w
  obtain ⟨-, ⟨U, hUaff, rfl⟩, hxU, hUV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (show x ∈ (V : Set X) from hxV) V.isOpen
  have hUle : U ≤ V := hUV
  have hgerm : w = L.presheaf.germ U x hxU (L.presheaf.map (homOfLE hUle).op z) := by
    rw [L.presheaf.germ_res_apply (homOfLE hUle) x hxU z]
    exact hz.symm
  obtain ⟨c, hc'⟩ :=
    exists_sum_support_smul_eq (hspan ⟨U, hUaff⟩ (L.presheaf.map (homOfLE hUle).op z))
  refine ⟨c.support, fun i => X.presheaf.germ U x hxU (c i), ?_⟩
  rw [hgerm, ← hc', map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Stacks.ModuleStalk.germ_smul L x U hxU, L.presheaf.Γgerm_res_apply x hxU]

section Generation

variable (F : X.Modules) [F.IsQuasicoherent]

/-- The subsheaf of `F` cut out by the spans of the restrictions of a set `A` of global sections,
read as an `𝒪_X`-module. -/
def spanRestrictModule (A : Set Γ(F, ⊤)) : X.Modules :=
  (spanRestrictSubsheaf F A).toSheafOfModules

/-- The inclusion of `spanRestrictModule F A` into `F`. -/
def spanRestrictSubsheafι (A : Set Γ(F, ⊤)) : spanRestrictModule F A ⟶ F :=
  (spanRestrictSubsheaf F A).ι

/-- The inclusion of `spanRestrictModule F A` is injective on sections over every open: the
sections of the subsheaf over an open are a submodule of the sections of `F`. -/
theorem injective_app_spanRestrictSubsheafι (A : Set Γ(F, ⊤)) (U : X.Opens) :
    Function.Injective (Scheme.Modules.Hom.app (spanRestrictSubsheafι F A) U) :=
  fun _ _ h => Subtype.val_injective h

/-- `spanRestrictModule F A` is quasi-coherent. -/
theorem isQuasicoherent_spanRestrictModule (A : Set Γ(F, ⊤)) :
    (spanRestrictModule F A).IsQuasicoherent :=
  isQuasicoherent_spanRestrictSubsheaf F A

/-- `spanRestrictModule F A` is of finite type when `A` is finite. -/
theorem isFiniteType_spanRestrictModule {A : Set Γ(F, ⊤)} (hA : A.Finite) :
    (spanRestrictModule F A).IsFiniteType :=
  isFiniteType_spanRestrictSubsheaf F hA

variable {ι : Type*}

/-- **A member of the family, read as a global section of the subsheaf it helps generate.** Its
restriction to an affine open is one of the generators of the span, so it lies in the subsheaf. -/
def spanRangeSection (s : ι → Γ(F, ⊤)) (i : ι) : Γ(spanRestrictModule F (Set.range s), ⊤) :=
  GabberColimit.mkSection F (spanRestrictFamily F (Set.range s))
    (isCompatible_spanRestrictFamily F (Set.range s)) (s i)
    fun _ _ => Submodule.subset_span ⟨s i, ⟨i, rfl⟩, rfl⟩

/-- **The inclusion carries `spanRangeSection F s i` to `s i`.** -/
theorem app_spanRestrictSubsheafι_spanRangeSection (s : ι → Γ(F, ⊤)) (i : ι) :
    Scheme.Modules.Hom.app (spanRestrictSubsheafι F (Set.range s)) ⊤
      (spanRangeSection F s i) = s i :=
  rfl

/-- The sections of `spanRestrictModule F (Set.range s)` over an affine open are the span of the
restrictions of the family, written as a span over a *range* rather than over an image. -/
theorem obj_spanRestrictSubsheaf_range (s : ι → Γ(F, ⊤)) (U : X.affineOpens) :
    (spanRestrictSubsheaf F (Set.range s)).toSubmodule.obj (op U.1) =
      Submodule.span Γ(X, U.1)
        (Set.range fun i => F.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op (s i)) := by
  rw [obj_spanRestrictSubsheaf F (Set.range s) U]
  exact congrArg _ (Set.range_comp _ s).symm

/-- **The restrictions of the family span the sections of the subsheaf over every affine open.**
Over an affine open the sections of the subsheaf are by construction the span of the restrictions
of the family *inside `F`*; the combination is carried back into the subsheaf by injectivity of
the inclusion on sections. -/
theorem mem_span_range_spanRangeSection (s : ι → Γ(F, ⊤)) (U : X.affineOpens)
    (z : Γ(spanRestrictModule F (Set.range s), U.1)) :
    z ∈ Submodule.span Γ(X, U.1) (Set.range fun i =>
      (spanRestrictModule F (Set.range s)).presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op
        (spanRangeSection F s i)) := by
  classical
  have hmem : Scheme.Modules.Hom.app (spanRestrictSubsheafι F (Set.range s)) U.1 z ∈
      Submodule.span Γ(X, U.1)
        (Set.range fun i => F.presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op (s i)) := by
    rw [← obj_spanRestrictSubsheaf_range F s U]
    exact z.2
  obtain ⟨c, hc'⟩ := exists_sum_support_smul_eq hmem
  have hlift : z = ∑ i ∈ c.support, c i •
      (spanRestrictModule F (Set.range s)).presheaf.map (homOfLE (le_top : U.1 ≤ ⊤)).op
        (spanRangeSection F s i) := by
    refine injective_app_spanRestrictSubsheafι F (Set.range s) U.1 ?_
    rw [map_sum, ← hc']
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [Scheme.Modules.Hom.app_smul]
    exact congrArg (c i • ·)
      (PresheafOfModules.naturality_apply (spanRestrictSubsheafι F (Set.range s)).val
        (homOfLE (le_top : U.1 ≤ ⊤)).op (spanRangeSection F s i)).symm
  rw [hlift]
  exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)

/-- **The family generates every stalk of the subsheaf it cuts out.** -/
theorem generatesStalks_spanRangeSection (s : ι → Γ(F, ⊤)) :
    Stacks.ProjectiveFromSections.GeneratesStalks (spanRangeSection F s) :=
  generatesStalks_of_affineSpan _ (mem_span_range_spanRangeSection F s)

end Generation

/-- **On a locally Noetherian scheme the subsheaf cut out by a finite set of global sections is
coherent.** It is quasi-coherent and of finite type, which on a locally Noetherian scheme is
coherence, [Stacks, Tag 01XZ]. -/
theorem isCoherent_spanRestrictModule [IsLocallyNoetherian X] (F : X.Modules)
    [F.IsQuasicoherent] {A : Set Γ(F, ⊤)} (hA : A.Finite) :
    _root_.SheafOfModules.IsCoherent (spanRestrictModule F A) :=
  have := isQuasicoherent_spanRestrictModule F A
  have := isFiniteType_spanRestrictModule F hA
  Stacks.AlgebraicGeometry.CoherentTFAE.isCoherent'_of_isQuasicoherent_of_isFiniteType _

end Stacks.AlgebraicGeometry.Tag01PFAffineSubsheaf

end
