/-- The isomorphism of quotients by `I` survives base change along an `R`-algebra `B`: the
quotients of `B` and of `B ⊗[R] S` by the image of `I` agree. -/
private theorem quotientMap_tensorProduct_bijective
    {R S B : Type u} [CommRing R] [CommRing S] [CommRing B]
    [Algebra R S] [Algebra R B]
    (I : Ideal R) (hflat : Module.Flat R S)
    (hq : Function.Bijective (Ideal.quotientMap (I.map (algebraMap R S))
      (algebraMap R S) Ideal.le_comap_map)) :
    Function.Bijective
      (Ideal.quotientMap ((I.map (algebraMap R B)).map (algebraMap B (B ⊗[R] S)))
        (algebraMap B (B ⊗[R] S)) Ideal.le_comap_map) := by
  let J := I.map (algebraMap R B)
  have hI : I.map (algebraMap R (B ⧸ J)) = ⊥ := by
    rw [IsScalarTower.algebraMap_eq R B (B ⧸ J), ← Ideal.map_map]
    exact Ideal.map_quotient_self J
  have hinc := tensorProduct_includeLeft_bijective_of_isNilpotent_ideal_map
    I hflat hq (B ⧸ J) (by rw [hI]; exact ⟨1, by simp⟩)
  let e := Algebra.TensorProduct.quotientTensorEquiv (R := R) B S B J
  have he :
      (Ideal.quotientMap (J.map (algebraMap B (B ⊗[R] S)))
        (algebraMap B (B ⊗[R] S)) Ideal.le_comap_map) =
      e.toRingEquiv.toRingHom.comp
        (Algebra.TensorProduct.includeLeft : B ⧸ J →ₐ[R] (B ⧸ J) ⊗[R] S).toRingHom := by
    ext b
    simp [e, Algebra.TensorProduct.quotientTensorEquiv_apply_tmul]
  rw [he]
  exact e.bijective.comp hinc

