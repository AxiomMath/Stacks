/-- For a glueing datum over a flat `S` inducing an isomorphism on the quotients by the ideal
generated by `f`, the base change to `S` of the compatible sections is the generic piece, and
the identification sends `s ⊗ x` to `s` times the generic component of `x`. -/
private theorem isLocalizedModule_sectionsLocal
    {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
    {r : ℕ} (f : Fin r → R) (hflat : Module.Flat R S)
    (hq : Function.Bijective
      (Ideal.quotientMap ((Ideal.span (Set.range f)).map (algebraMap R S))
        (algebraMap R S) Ideal.le_comap_map))
    (X : ModuleGlueingDatum.{u, v, w} S f (localizationComparisons f)) (i : Fin r) :
    IsLocalizedModule (Submonoid.powers (f i))
      ((LinearMap.proj i).comp ((LinearMap.snd R (restrictFromTarget S X.generic)
        (∀ j, restrictFromAway f j (X.localPiece j))).comp
          (compatibleSections S f (localizationComparisons f) X).subtype)) := by
  let c := moduleGlueingConstruction.{u, v, w} S f
  let := c.category
  let X : ModuleGlueingDatum.{u, v, w} S f c.comparison := X
  obtain ⟨e, hf, hi⟩ := FormalGlueing.canonicalFunctor_sections_areQuasiInverse R S f hflat hq
  let Y : c.canonical.obj (c.sections.obj X) ≅ X := by
    rw [← hf, ← hi]
    exact e.counitIso.app X
  have : IsIso c.canonicalSectionsUnit :=
    FormalGlueing.canonicalSectionsUnit_isIso R S f hflat hq
  let a : c.sections.obj X ≅ c.sections.obj X :=
    asIso (c.canonicalSectionsUnit.app (c.sections.obj X)) ≪≫ c.sections.mapIso Y
  let γ := ((ModuleCat.restrictScalars (algebraMap R (Localization.Away (f i)))).mapIso
    ((FormalGlueing.localProjection S f c i).mapIso Y)).toLinearEquiv
  let l := canonicalLocalMk f (c.sections.obj X) i
  let : IsLocalizedModule (Submonoid.powers (f i)) l :=
    canonicalLocalMk_isLocalized f (c.sections.obj X) i
  have hp : ((LinearMap.proj i).comp ((LinearMap.snd R (restrictFromTarget S X.generic)
        (∀ j, restrictFromAway f j (X.localPiece j))).comp
          (compatibleSections S f (localizationComparisons f) X).subtype)) =
      γ.toLinearMap.comp (l.comp a.toLinearEquiv.symm.toLinearMap) := by
    ext x
    exact (congrArg (fun y : compatibleSections S f (localizationComparisons f) X =>
      y.1.2 i) (a.toLinearEquiv.apply_symm_apply x)).symm
  rw [hp]
  exact IsLocalizedModule.of_linearEquiv (S := Submonoid.powers (f i))
    (f := l.comp a.toLinearEquiv.symm.toLinearMap) γ
    (hf := IsLocalizedModule.of_linearEquiv_right _ l a.toLinearEquiv.symm)

