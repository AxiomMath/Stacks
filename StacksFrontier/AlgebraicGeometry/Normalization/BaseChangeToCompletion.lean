variable {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
    {r : ℕ} (f : Fin r → R) (B T : Type (max u v w)) [CommRing B] [CommRing T]
    [Algebra R B] [Algebra S T] (q : S ⊗[R] B →ₐ[S] T)
    (hq : ∀ i, Function.Bijective
      (LocalizedModule.map (Submonoid.powers (algebraMap R S (f i))) q.toLinearMap))

/-- The element of the product determined by `b ∈ B`, namely the image of `1 ⊗ b` in `T` together
with the images of `b` in the local pieces, is a compatible section. -/
private theorem baseAlgebraMap_mem_sections [Algebra R T] [IsScalarTower R S T] (b : B) :
    (q (1 ⊗ₜ[R] b), fun i => canonicalLocalAlgHom f B i b) ∈
      compatibleSections S f (localizationComparisons f) (glueX f B T q hq) := by
  apply (mem_sections_iff f B T q hq _).2
  refine ⟨fun i => ?_, fun i j => ?_⟩
  · change replaceGenericAlphaAlgEquiv f B T q hq i
        (numeratorAlgHom (Submonoid.powers (algebraMap R S (f i))) T
          (q (1 ⊗ₜ[R] b))) =
      (1 : S) ⊗ₜ[R] canonicalLocalMk f (ModuleCat.of R B) i b
    rw [← replaceGenericAlpha_canonical_eq f B T q hq i _]
    let E : LocalizedModule.Away (algebraMap R S (f i)) (S ⊗[R] B) ≃ₗ[S]
        LocalizedModule.Away (algebraMap R S (f i)) T :=
      LinearEquiv.ofBijective
        ((LocalizedModule.map (Submonoid.powers (algebraMap R S (f i))) q.toLinearMap)
          |>.restrictScalars S) (hq i)
    change canonicalAlpha S f (ModuleCat.of R B) i
      (E.symm (numeratorAlgHom (Submonoid.powers (algebraMap R S (f i))) T
        (q (1 ⊗ₜ[R] b)))) = _
    have hinv : E.symm (numeratorAlgHom
        (Submonoid.powers (algebraMap R S (f i))) T (q (1 ⊗ₜ[R] b))) =
        LocalizedModule.mkLinearMap (Submonoid.powers (algebraMap R S (f i)))
          (S ⊗[R] B) (1 ⊗ₜ[R] b) := by
      apply E.injective
      rw [LinearEquiv.apply_symm_apply]
      change LocalizedModule.mkLinearMap _ _ (q (1 ⊗ₜ[R] b)) =
        LocalizedModule.map _ q.toLinearMap
          (LocalizedModule.mkLinearMap _ (S ⊗[R] B) (1 ⊗ₜ[R] b))
      exact (LocalizedModule.map_mk _ q.toLinearMap (1 ⊗ₜ[R] b) 1).symm
    rw [hinv]
    exact canonicalAlpha_mk S f (ModuleCat.of R B) i 1 b
  · change canonicalAlphaIJ f (ModuleCat.of R B) i j
        (LocalizedModule.mkLinearMap (Cech.cechSub f {j}) _
          (canonicalLocalMk f (ModuleCat.of R B) i b)) =
      LocalizedModule.mkLinearMap (Cech.cechSub f {i}) _
        (canonicalLocalMk f (ModuleCat.of R B) j b)
    exact canonicalAlphaIJ_mk f (ModuleCat.of R B) i j b


variable [Algebra R T] [IsScalarTower R S T]

/-- The algebra map from `B` to the algebra of compatible sections, given in the generic coordinate
by `b ↦ q (1 ⊗ b)` and in the `i`-th local coordinate by the localization map. -/
private noncomputable def sectionsSubalgebraAlgHom :
    B →ₐ[R] sectionsSubalgebra f B T q hq := by
  let g₁ : B →ₐ[R] T := (q.restrictScalars R).comp Algebra.TensorProduct.includeRight
  let g₂ : B →ₐ[R] ∀ i, awayLocalPiece f B i :=
    AlgHom.pi (fun i => canonicalLocalAlgHom f B i)
  let g : B →ₐ[R] T × ∀ i, awayLocalPiece f B i := AlgHom.prod g₁ g₂
  exact AlgHom.codRestrict g (sectionsSubalgebra f B T q hq)
    (baseAlgebraMap_mem_sections f B T q hq)

/-- The projection of the algebra of compatible sections onto its `i`-th local piece. -/
private noncomputable def sectionsLocalAlgHom (i : Fin r) :
    sectionsSubalgebra f B T q hq →ₐ[R] awayLocalPiece f B i where
  toFun x := x.1.2 i
  map_one' := rfl
  map_mul' _ _ := rfl
  map_zero' := rfl
  map_add' _ _ := rfl
  commutes' _ := rfl

/-- The `i`-th projection exhibits the `i`-th local piece as the localization of the algebra of
compatible sections away from `f i`. -/
private theorem isLocalizedModule_sectionsLocalAlgHom
    (hflat : Module.Flat R S)
    (hquot : Function.Bijective
      (Ideal.quotientMap ((Ideal.span (Set.range f)).map (algebraMap R S))
        (algebraMap R S) Ideal.le_comap_map)) (i : Fin r) :
    IsLocalizedModule (Submonoid.powers (f i))
      (sectionsLocalAlgHom f B T q hq i).toLinearMap :=
  IsLocalizedModule.of_linearEquiv_right (Submonoid.powers (f i))
    ((LinearMap.proj i).comp ((LinearMap.snd R (restrictFromTarget S (ModuleCat.of S T))
      (∀ j, awayLocalPiece f B j)).comp
        (compatibleSections S f (localizationComparisons f) (glueX f B T q hq)).subtype))
    (sectionsSubalgebraLinearEquiv f B T q hq)
    (hf := isLocalizedModule_sectionsLocal f hflat hquot (glueX f B T q hq) i)

/-- The algebra map from `B` to the compatible sections becomes bijective after localizing away
from `f i`, both sides being the same localization of `B`. -/
private theorem localizedMap_sectionsSubalgebraAlgHom_bijective
    (hflat : Module.Flat R S)
    (hquot : Function.Bijective
      (Ideal.quotientMap ((Ideal.span (Set.range f)).map (algebraMap R S))
        (algebraMap R S) Ideal.le_comap_map)) (i : Fin r) :
    Function.Bijective (LocalizedModule.map (Submonoid.powers (f i))
      (sectionsSubalgebraAlgHom f B T q hq).toLinearMap) := by
  let l := (canonicalLocalAlgHom f B i).toLinearMap
  let p := (sectionsLocalAlgHom f B T q hq i).toLinearMap
  let g := (sectionsSubalgebraAlgHom f B T q hq).toLinearMap
  have : IsLocalizedModule (Submonoid.powers (f i)) p :=
    isLocalizedModule_sectionsLocalAlgHom f B T q hq hflat hquot i
  have : IsLocalizedModule (Submonoid.powers (f i)) l :=
    canonicalLocalMk_isLocalized f (ModuleCat.of R B) i
  apply (IsLocalizedModule.map_bijective_iff_localizedModuleMap_bijective l p).mp
  have heq : IsLocalizedModule.map (Submonoid.powers (f i)) l p g = LinearMap.id := by
    apply IsLocalizedModule.ext (Submonoid.powers (f i)) l
      (IsLocalizedModule.map_units p)
    rw [IsLocalizedModule.map_comp]
    rfl
  rw [heq]
  exact Function.bijective_id

end

/-- Normality passes to the source of an open immersion, the stalks being unchanged. -/
private theorem isNormal_of_isOpenImmersion
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsOpenImmersion f]
    (hY : IsNormal Y) : IsNormal X := by
  refine (isNormal_iff_stalk_normal X).2 fun x => ?_
  let e := (asIso (f.stalkMap x)).commRingCatIsoToRingEquiv
  have := hY.stalk_isDomain (f x)
  have := hY.stalk_normal (f x)
  have : IsDomain (X.presheaf.stalk x) :=
    Function.Injective.isDomain e.symm.toRingHom e.symm.injective
  exact ⟨inferInstance, IsIntegrallyClosed.of_equiv e⟩

/-- A point that specializes to the generic point of an irreducible component equals that point. -/
private theorem eq_of_specializes_genericPoint
    {T : Type*} [TopologicalSpace T] [T0Space T] {x y : T}
    (hx : x ∈ genericPoints T) (h : y ⤳ x) : y = x :=
  (h.antisymm (specializes_iff_closure_subset.mpr
    (hx.2 isIrreducible_singleton.closure h.closure_subset))).eq

/-- Every point of a quasi-sober space is a specialization of the generic point of an irreducible
component. -/
private theorem exists_mem_genericPoints_specializes
    {T : Type*} [TopologicalSpace T] [QuasiSober T] (x : T) :
    ∃ η ∈ genericPoints T, η ⤳ x :=
  ⟨_, (genericPoints.ofComponent
      ⟨irreducibleComponent x, irreducibleComponent_mem_irreducibleComponents x⟩).2,
    (genericPoints.isGenericPoint_ofComponent
      ⟨irreducibleComponent x, irreducibleComponent_mem_irreducibleComponents x⟩).specializes
      mem_irreducibleComponent⟩

/-- A point of a sober space admitting no proper generalization is the generic point of an
irreducible component. -/
private theorem mem_genericPoints_of_no_strict_generalization
    {T : Type*} [TopologicalSpace T] [QuasiSober T] {x : T}
    (hx : ∀ y : T, y ⤳ x → y = x) : x ∈ genericPoints T := by
  obtain ⟨η, hη, hηx⟩ := exists_mem_genericPoints_specializes x
  exact hx η hηx ▸ hη

/-- A map along which generalizations lift carries generic points of irreducible components to
generic points of irreducible components. -/
private theorem mapsTo_genericPoints_of_generalizing
    {T V : Type*} [TopologicalSpace T] [T0Space T]
    [TopologicalSpace V] [QuasiSober V] {f : T → V}
    (hf : GeneralizingMap f) : Set.MapsTo f (genericPoints T) (genericPoints V) := by
  intro x hx
  refine mem_genericPoints_of_no_strict_generalization fun y hy => ?_
  obtain ⟨z, hz, hzy⟩ := hf hy
  exact hzy.symm.trans (congrArg f (eq_of_specializes_genericPoint hx hz))

/-- A continuous surjection from a sober space already attains every generic point of an
irreducible component of the target at a generic point of the source. -/
private theorem surjOn_genericPoints_of_surjective
    {T V : Type*} [TopologicalSpace T] [QuasiSober T]
    [TopologicalSpace V] [T0Space V] {f : T → V}
    (hf : Continuous f) (hsurj : Function.Surjective f) :
    Set.SurjOn f (genericPoints T) (genericPoints V) := by
  intro y hy
  obtain ⟨x, rfl⟩ := hsurj y
  obtain ⟨η, hη, hηx⟩ := exists_mem_genericPoints_specializes x
  exact ⟨η, hη, eq_of_specializes_genericPoint hy (hηx.map hf)⟩

/-- The normalization morphism carries generic points of irreducible components to generic points
of irreducible components. -/
private theorem mapsTo_genericPoints_normalization
    (X : Scheme.{u})
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite) :
    Set.MapsTo (Scheme.normalization X hX)
      (genericPoints (Scheme.normalizationScheme X hX)) (genericPoints X) :=
  fun _ hη ↦ Scheme.normalization_mem_genericPoints X hX hη

/-- If the base change of `f` along a flat surjection `p` is the normalization of the source of
`p`, then `f` carries generic points of irreducible components to generic points. -/
private theorem mapsTo_genericPoints_of_pullback_normalization
    {X Y Z : Scheme.{u}} (f : Z ⟶ X) (p : Y ⟶ X) [Flat p] [Surjective p]
    (hY : ∀ U : Y.Opens, IsCompact (U : Set Y) → (irreducibleComponents U).Finite)
    (e : pullback f p ≅ Scheme.normalizationScheme Y hY)
    (he : e.hom ≫ Scheme.normalization Y hY = pullback.snd f p) :
    Set.MapsTo f (genericPoints Z) (genericPoints X) := by
  intro z hz
  obtain ⟨t, ht, htz⟩ := surjOn_genericPoints_of_surjective
    (pullback.fst f p).continuous (pullback.fst f p).surjective hz
  have hpoints : p (Scheme.normalization Y hY (e.hom t)) = f z := by
    simpa only [Scheme.Hom.comp_apply, htz] using (congrArg p (congrArg (fun k => k t) he)).trans
      (congrArg (fun k => k t) (pullback.condition (f := f) (g := p))).symm
  exact hpoints ▸ mapsTo_genericPoints_of_generalizing (Flat.generalizingMap p)
    (mapsTo_genericPoints_normalization Y hY
      (mapsTo_genericPoints_of_generalizing e.hom.isOpenEmbedding.generalizingMap ht))

/-- Normality of a ring descends along a faithfully flat algebra. -/
private theorem isNormalRing_of_faithfullyFlat
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    [Module.FaithfullyFlat R S] (hS : IsNormalRing S) : IsNormalRing R :=
  isDomain_and_isIntegrallyClosed_atPrime_of_faithfullyFlat hS

/-- If `S` is faithfully flat over `R` and `S ⊗[R] D` is isomorphic to a normal ring, then `D` is a
normal ring, being faithfully flat in `S ⊗[R] D`. -/
private theorem isNormalRing_of_tensorProduct
    {R S D T : Type*} [CommRing R] [CommRing S] [CommRing D] [CommRing T]
    [Algebra R S] [Algebra R D] [Algebra S T]
    [Module.FaithfullyFlat R S]
    (E : S ⊗[R] D ≃ₐ[S] T) (hT : IsNormalRing T) : IsNormalRing D := by
  let : Algebra D (S ⊗[R] D) := Algebra.TensorProduct.rightAlgebra
  let φ : D →+* T := E.toRingEquiv.toRingHom.comp (algebraMap D (S ⊗[R] D))
  let : Algebra D T := φ.toAlgebra
  let ED : S ⊗[R] D ≃ₐ[D] T :=
    AlgEquiv.ofBijective
      { toRingHom := E.toRingEquiv.toRingHom
        commutes' := fun _ => rfl }
      E.toEquiv.bijective
  let Ecomm : (S ⊗[R] D) ≃ₐ[D] D ⊗[R] S :=
    { __ := Algebra.TensorProduct.comm R S D
      commutes' := fun _ => rfl }
  have : Module.FaithfullyFlat D (S ⊗[R] D) :=
    Module.FaithfullyFlat.of_linearEquiv D (D ⊗[R] S) Ecomm.toLinearEquiv
  have : Module.FaithfullyFlat D T :=
    Module.FaithfullyFlat.of_linearEquiv D (S ⊗[R] D) ED.toLinearEquiv.symm
  exact isNormalRing_of_faithfullyFlat hT

/-- The algebra of compatible sections glued from a normal `T` is a normal ring: its base change to
`S` is `T`, and `S` is faithfully flat over `R`. -/
private theorem isNormal_formalGlueing_algebra_sections
    {R : Type u} {S : Type v} [CommRing R] [CommRing S] [Algebra R S]
    {r : ℕ} (f : Fin r → R) (B T : Type (max u v w)) [CommRing B] [CommRing T]
    [Algebra R B] [Algebra S T] (q : S ⊗[R] B →ₐ[S] T)
    (hq : ∀ i, Function.Bijective
      (LocalizedModule.map (Submonoid.powers (algebraMap R S (f i))) q.toLinearMap))
    [Algebra R T] [IsScalarTower R S T]
    (hflat : Module.Flat R S)
    (hquot : Function.Bijective
      (Ideal.quotientMap ((Ideal.span (Set.range f)).map (algebraMap R S))
        (algebraMap R S) Ideal.le_comap_map))
    [Module.FaithfullyFlat R S]
    (hT : IsNormalRing T) :
    IsNormalRing (sectionsSubalgebra f B T q hq) := by
  obtain ⟨E, -⟩ := exists_algEquiv_tensor_sectionsSubalgebra f B T q hq hflat hquot
  exact isNormalRing_of_tensorProduct E hT

/-- The structure morphism of an `S`-algebra `T`, read as a morphism out of the trivial base
change `S ⊗_R R` of the base ring. -/
private noncomputable def baseChangeUnit (R S T : Type u) [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra S T] : S ⊗[R] R →ₐ[S] T :=
  (Algebra.ofId S T).comp (Algebra.TensorProduct.rid R S S).toAlgHom

/-- If the structure map `S → T` becomes bijective after localizing at the image of each `a i`,
then so does the morphism `S ⊗_R R → T`, the two differing by the canonical isomorphism
`S ⊗_R R ≅ S`. -/
private theorem localizedMap_baseChangeUnit_bijective
    {R S T : Type u} [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra S T] {r : ℕ} (a : Fin r → R)
    (hloc : ∀ i, Function.Bijective
      (LocalizedModule.map (Submonoid.powers (algebraMap R S (a i)))
        (Algebra.linearMap S T))) (i : Fin r) :
    Function.Bijective (LocalizedModule.map (Submonoid.powers (algebraMap R S (a i)))
      (baseChangeUnit R S T).toLinearMap) := by
  let e : S ⊗[R] R ≃ₐ[S] S := Algebra.TensorProduct.rid R S S
  exact localizedModuleMap_bijective_comp _ e.toLinearEquiv.toLinearMap (Algebra.linearMap S T)
    ⟨LocalizedModule.map_injective _ _ e.injective,
      LocalizedModule.map_surjective _ _ e.surjective⟩ (hloc i)

/-- The structure map of the glued algebra becomes bijective after localizing at each `a i`,
since the glued algebra is by construction the localization of its `i`-th local piece. -/
private theorem localizedMap_algebraMap_sectionsSubalgebra_bijective
    {R S T : Type u} [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra S T] [Algebra R T] [IsScalarTower R S T]
    {r : ℕ} (a : Fin r → R) (hflat : Module.Flat R S)
    (hquot : Function.Bijective
      (Ideal.quotientMap ((Ideal.span (Set.range a)).map (algebraMap R S))
        (algebraMap R S) Ideal.le_comap_map))
    (hq : ∀ i, Function.Bijective
      (LocalizedModule.map (Submonoid.powers (algebraMap R S (a i)))
        (baseChangeUnit R S T).toLinearMap)) (i : Fin r) :
    Function.Bijective (LocalizedModule.map (Submonoid.powers (a i))
      (Algebra.linearMap R (sectionsSubalgebra a R T (baseChangeUnit R S T) hq))) := by
  have hg : (sectionsSubalgebraAlgHom a R T (baseChangeUnit R S T) hq).toLinearMap =
      Algebra.linearMap R (sectionsSubalgebra a R T (baseChangeUnit R S T) hq) :=
    LinearMap.ext fun x =>
      (sectionsSubalgebraAlgHom a R T (baseChangeUnit R S T) hq).commutes x
  simpa only [← hg] using
    localizedMap_sectionsSubalgebraAlgHom_bijective a R T (baseChangeUnit R S T) hq hflat hquot i

/-- The algebra of compatible sections built from a finite normal `S`-algebra `T` is a finite
normal `R`-algebra whose base change to `S` recovers `T`. -/
private theorem finite_isNormalRing_nonempty_algEquiv_sectionsSubalgebra
    {R S T : Type u} [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra S T] [Algebra R T] [IsScalarTower R S T]
    [Module.FaithfullyFlat R S] [Module.Finite S T]
    {r : ℕ} (a : Fin r → R) (hflat : Module.Flat R S)
    (hquot : Function.Bijective
      (Ideal.quotientMap ((Ideal.span (Set.range a)).map (algebraMap R S))
        (algebraMap R S) Ideal.le_comap_map))
    (hq : ∀ i, Function.Bijective
      (LocalizedModule.map (Submonoid.powers (algebraMap R S (a i)))
        (baseChangeUnit R S T).toLinearMap))
    (hT : IsNormalRing T) :
    Module.Finite R (sectionsSubalgebra a R T (baseChangeUnit R S T) hq) ∧
      IsNormalRing (sectionsSubalgebra a R T (baseChangeUnit R S T) hq) ∧
      Nonempty (S ⊗[R] sectionsSubalgebra a R T (baseChangeUnit R S T) hq ≃ₐ[S] T) :=
  ⟨finite_sectionsSubalgebra a R T (baseChangeUnit R S T) hq hflat hquot,
    isNormal_formalGlueing_algebra_sections a R T (baseChangeUnit R S T) hq hflat hquot hT,
    ⟨(exists_algEquiv_tensor_sectionsSubalgebra a R T (baseChangeUnit R S T) hq hflat
      hquot).choose⟩⟩

/-- **Formal glueing of a finite normal algebra.** Let `S` be a faithfully flat `R`-algebra
inducing an isomorphism on the quotients by the ideal generated by `a`, and let `T` be a finite
normal `S`-algebra whose structure map is an isomorphism after localizing at each `a i`. Then `T`
descends to a finite normal `R`-algebra `D` with `S ⊗_R D ≅ T`, again an isomorphism after
localizing at each `a i`. -/
private theorem exists_finite_normal_algebra_of_flat_quotient_iso
    {R S T : Type u} [CommRing R] [CommRing S] [CommRing T]
    [Algebra R S] [Algebra S T] [Algebra R T] [IsScalarTower R S T]
    [Module.FaithfullyFlat R S] [Module.Finite S T]
    {r : ℕ} (a : Fin r → R)
    (hquot : Function.Bijective
      (Ideal.quotientMap ((Ideal.span (Set.range a)).map (algebraMap R S))
        (algebraMap R S) Ideal.le_comap_map))
    (hloc : ∀ i, Function.Bijective
      (LocalizedModule.map (Submonoid.powers (algebraMap R S (a i)))
        (Algebra.linearMap S T)))
    (hT : IsNormalRing T) :
    ∃ (D : Type u) (_ : CommRing D) (_ : Algebra R D),
      Module.Finite R D ∧ IsNormalRing D ∧
      (∀ i, Function.Bijective (LocalizedModule.map (Submonoid.powers (a i))
        (Algebra.linearMap R D))) ∧
      Nonempty (S ⊗[R] D ≃ₐ[S] T) :=
  let hq := localizedMap_baseChangeUnit_bijective (T := T) a hloc
  let hflat : Module.Flat R S := inferInstance
  let h := finite_isNormalRing_nonempty_algEquiv_sectionsSubalgebra a hflat hquot hq hT
  ⟨sectionsSubalgebra a R T (baseChangeUnit R S T) hq, inferInstance, inferInstance,
    h.1, h.2.1, localizedMap_algebraMap_sectionsSubalgebra_bijective a hflat hquot hq, h.2.2⟩

/-- The normalization morphism of a normal scheme is an isomorphism. -/
private theorem normalization_isIso_of_isNormal (X : Scheme.{u})
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    (hN : IsNormal X) : IsIso (Scheme.normalization X hX) :=
  (Scheme.isIso_normalization_iff_isNormal X hX).2 hN

/-- For an étale morphism `φ : X ⟶ Y` the normalization of `X` is the base change along `φ` of
the normalization of `Y`, compatibly with the normalization morphism of `X`.  This is the
isomorphism `X^ν = X ×_Y Y^ν` of Tag 07TD, read off from the cartesian square. -/
private theorem exists_iso_normalizationScheme_pullback_of_etale
    {X Y : Scheme.{u}} (φ : X ⟶ Y) [Etale φ]
    (hY : ∀ U : Y.Opens, IsCompact (U : Set Y) → (irreducibleComponents U).Finite) :
    ∃ e : Scheme.normalizationScheme X (finite_irreducibleComponents_of_smooth φ hY) ≅
        pullback (Scheme.normalization Y hY) φ,
      e.hom ≫ pullback.snd (Scheme.normalization Y hY) φ =
        Scheme.normalization X (finite_irreducibleComponents_of_smooth φ hY) :=
  ⟨(isPullback_normalizationSchemeMap_of_etale φ hY).isoPullback,
    (isPullback_normalizationSchemeMap_of_etale φ hY).isoPullback_hom_snd⟩

/-- Over an open subscheme on which `X` is normal, the normalization morphism of `X` restricts to
an isomorphism. -/
private theorem isIso_normalization_restrict_of_isNormal
    {X : Scheme.{u}}
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    (U : X.Opens) (hU : IsNormal U.toScheme) :
    IsIso (Scheme.normalization X hX ∣_ U) := by
  let hfin := finite_irreducibleComponents_of_smooth U.ι hX
  have : IsIso (Scheme.normalization U.toScheme hfin) :=
    normalization_isIso_of_isNormal U.toScheme hfin hU
  obtain ⟨e, he⟩ := exists_iso_normalizationScheme_pullback_of_etale U.ι hX
  have : IsIso (pullback.snd (Scheme.normalization X hX) U.ι) :=
    IsIso.of_isIso_fac_left (f := e.hom) he
  change IsIso ((pullbackRestrictIsoRestrict (Scheme.normalization X hX) U).inv ≫
    pullback.snd (Scheme.normalization X hX) U.ι)
  infer_instance

/-- A finite morphism from a normal scheme `Z` to `X` whose generic points lie over generic points,
and through which the generic-point residue fields factor with dense image, is the
normalization of `X`. -/
private theorem exists_iso_normalization_of_finite_of_generic_lift
    {X Z : Scheme.{u}}
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    (f : Z ⟶ X) [IsFinite f] (hZ : IsNormal Z)
    (hgeneric : ∀ η : genericPoints Z, f η.1 ∈ genericPoints X)
    (g : Scheme.genericPointResidueSpectrum X ⟶ Z)
    (hgf : g ≫ f = Scheme.fromGenericPointResidueFields X)
    (hg : DenseRange g) :
    ∃ e : Scheme.normalizationScheme X hX ≅ Z,
      e.hom ≫ f = Scheme.normalization X hX := by
  let k := Scheme.fromGenericPointResidueFields X
  have : QuasiCompact k := Scheme.quasiCompactFromGenericPointResidueFields X hX
  have : QuasiSeparated k := Scheme.quasiSeparatedFromGenericPointResidueFields X
  let ν := Scheme.normalization X hX
  let a : Scheme.normalizationScheme X hX ⟶ Z :=
    k.normalizationDesc g f hgf.symm
  have ha : a ≫ f = ν := k.normalizationDesc_comp g f hgf.symm
  obtain ⟨s, hs, -⟩ := Scheme.existsUnique_lift_normalization hX f hgeneric
  have : IsNormal (Scheme.normalizationScheme X hX) := Scheme.isNormal_normalizationScheme X hX
  obtain ⟨l, hl, huniq⟩ := Scheme.existsUnique_lift_normalization hX ν
    fun η ↦ Scheme.normalization_mem_genericPoints X hX η.2
  have has : a ≫ s = 𝟙 _ :=
    (huniq _ (by
      change (a ≫ s) ≫ Scheme.normalization X hX = ν
      rw [Category.assoc, hs, ha])).trans
      (huniq _ (Category.id_comp ν)).symm
  have : IsFinite (s ≫ ν) := hs.symm ▸ inferInstance
  have : IsFinite s := IsFinite.of_comp s ν
  have : IsClosedImmersion (a ≫ s) := has.symm ▸ inferInstance
  have : IsClosedImmersion a := IsClosedImmersion.of_comp a s
  have hdense : DenseRange a := by
    apply hg.mono
    rintro _ ⟨x, rfl⟩
    exact ⟨k.toNormalization x,
      congrArg (fun h => h x) (k.toNormalization_normalizationDesc g f hgf.symm)⟩
  have : Surjective a := ⟨Set.range_eq_univ.mp
    (a.isClosedEmbedding.isClosed_range.closure_eq.symm.trans hdense.closure_range)⟩
  have (z : Z) : IsDomain (Z.presheaf.stalk z) := hZ.stalk_isDomain z
  have : IsReduced Z := isReduced_of_isReduced_stalk Z
  have : IsIso a := isIso_of_isClosedImmersion_of_surjective a
  exact ⟨asIso a, ha⟩

/-- Under the hypotheses of the preceding lemma the normalization of `X` is finite, and its base
change along a flat surjection `p` is the normalization of the source of `p`. -/
private theorem finite_normalization_and_baseChange_of_generic_lift
    {X Y Z : Scheme.{u}}
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    (hY : ∀ U : Y.Opens, IsCompact (U : Set Y) → (irreducibleComponents U).Finite)
    (f : Z ⟶ X) [IsFinite f] (hZ : IsNormal Z)
    (p : Y ⟶ X) [Flat p] [Surjective p]
    (e : pullback f p ≅ Scheme.normalizationScheme Y hY)
    (he : e.hom ≫ Scheme.normalization Y hY = pullback.snd f p)
    (g : Scheme.genericPointResidueSpectrum X ⟶ Z)
    (hgf : g ≫ f = Scheme.fromGenericPointResidueFields X)
    (hg : DenseRange g) :
    IsFinite (Scheme.normalization X hX) ∧
      ∃ e' : pullback (Scheme.normalization X hX) p ≅
          Scheme.normalizationScheme Y hY,
        e'.hom ≫ Scheme.normalization Y hY =
          pullback.snd (Scheme.normalization X hX) p := by
  obtain ⟨d, hd⟩ := exists_iso_normalization_of_finite_of_generic_lift hX f hZ
    (fun η => mapsTo_genericPoints_of_pullback_normalization f p hY e he η.2) g hgf hg
  constructor
  · rw [← hd]
    infer_instance
  · let m := pullback.map (Scheme.normalization X hX) p f p
      d.hom (𝟙 Y) (𝟙 X) (by simpa using hd.symm) (by simp)
    refine ⟨asIso m ≪≫ e, ?_⟩
    simp only [Iso.trans_hom, asIso_hom, Category.assoc, he, m,
      pullback.lift_snd, Category.comp_id]

/-- A ring whose spectrum is a normal scheme is a normal ring, the local rings of the spectrum
being the localizations at the primes. -/
@[ega "IV 5.13.5" "partial"]
private theorem isNormalRing_of_isNormal_spec (R : Type u) [CommRing R]
    (hR : IsNormal (Spec (.of R))) : IsNormalRing R := by
  intro p hp
  let x : PrimeSpectrum R := ⟨p, hp⟩
  let e := (Spec.stalkIso (.of R) x).commRingCatIsoToRingEquiv
  obtain ⟨_, _⟩ := (isNormal_iff_stalk_normal (Spec (.of R))).1 hR x
  have : IsDomain (Localization.AtPrime x.asIdeal) :=
    Function.Injective.isDomain e.symm.toRingHom e.symm.injective
  have : IsIntegrallyClosed (Localization.AtPrime x.asIdeal) :=
    IsIntegrallyClosed.of_equiv e
  exact ⟨‹_›, ‹_›⟩

/-- `Spec S → Spec R` restricts to an isomorphism over the basic open of `a` exactly when the map
of localizations away from `a` is bijective. -/
private theorem isIso_restrict_specMap_iff
    {R S : Type u} [CommRing R] [CommRing S] [Algebra R S] (a : R) :
    IsIso (Spec.map (CommRingCat.ofHom (algebraMap R S)) ∣_ PrimeSpectrum.basicOpen a) ↔
      Function.Bijective (Localization.awayMap (algebraMap R S) a) :=
  ((MorphismProperty.isomorphisms Scheme).arrow_mk_iso_iff
    (SpecMapRestrictBasicOpenIso (CommRingCat.ofHom (algebraMap R S)) a)).trans
    (isIso_SpecMap_iff (f := CommRingCat.ofHom (Localization.awayMap (algebraMap R S) a)))

/-- If `Spec S → Spec R` restricts to an isomorphism over the basic open of `a`, then `R → S`
becomes bijective after localizing at the powers of `a`. -/
private theorem localizedModuleMap_bijective_of_isIso_restrict
    {R S : Type u} [CommRing R] [CommRing S] [Algebra R S] (a : R)
    (h : IsIso (Spec.map (CommRingCat.ofHom (algebraMap R S)) ∣_
      PrimeSpectrum.basicOpen a)) :
    Function.Bijective (LocalizedModule.map (Submonoid.powers a)
      (Algebra.linearMap R S)) :=
  localizedModuleMap_bijective_of_awayMap_bijective a ((isIso_restrict_specMap_iff a).mp h)

/-- The normalization of an affine scheme with finite normalization is the spectrum of a finite
normal algebra `T`, and `S → T` is bijective after localizing at every `a i` whose basic open is
already normal. -/
private theorem exists_finite_normal_normalization_algebra
    (S : Type u) [CommRing S]
    (hS : ∀ U : (Spec (.of S)).Opens, IsCompact (U : Set (Spec (.of S))) →
      (irreducibleComponents U).Finite)
    [IsFinite (Scheme.normalization (Spec (.of S)) hS)]
    {ι : Type*} (a : ι → S)
    (hnormal : ∀ i, IsNormal
      (Scheme.Opens.toScheme (X := Spec (.of S)) (PrimeSpectrum.basicOpen (a i)))) :
    ∃ (T : Type u) (_ : CommRing T) (_ : Algebra S T),
      Module.Finite S T ∧ IsNormalRing T ∧
      (∀ i, Function.Bijective (LocalizedModule.map (Submonoid.powers (a i))
        (Algebra.linearMap S T))) ∧
      ∃ e : Spec (.of T) ≅ Scheme.normalizationScheme (Spec (.of S)) hS,
        e.hom ≫ Scheme.normalization (Spec (.of S)) hS =
          Spec.map (CommRingCat.ofHom (algebraMap S T)) := by
  let N := Scheme.normalizationScheme (Spec (.of S)) hS
  let ν := Scheme.normalization (Spec (.of S)) hS
  have : IsAffine N := isAffine_of_isAffineHom ν
  let T := Γ(N, ⊤)
  let e : Spec (.of T) ≅ N := N.isoSpec.symm
  obtain ⟨g, hg⟩ := Spec.map_surjective (e.hom ≫ ν)
  let : Algebra S T := g.hom.toAlgebra
  have hmap : Spec.map (CommRingCat.ofHom (algebraMap S T)) = e.hom ≫ ν := hg
  have : IsFinite (Spec.map (CommRingCat.ofHom (algebraMap S T))) := by
    rw [hmap]
    infer_instance
  have hfinite : Module.Finite S T :=
    RingHom.finite_algebraMap.mp
      ((IsFinite.SpecMap_iff (CommRingCat.ofHom (algebraMap S T))).mp inferInstance)
  have hT : IsNormalRing T := isNormalRing_of_isNormal_spec T
    (isNormal_of_isOpenImmersion e.hom (Scheme.isNormal_normalizationScheme _ hS))
  have hrestrict : ∀ i, IsIso (e.hom ∣_ ν ⁻¹ᵁ PrimeSpectrum.basicOpen (a i)) :=
    fun _ ↦ inferInstance
  refine ⟨T, inferInstance, inferInstance, hfinite, hT, fun i => ?_, e, hmap.symm⟩
  apply localizedModuleMap_bijective_of_isIso_restrict
  rw [hmap, morphismRestrict_comp e.hom ν (PrimeSpectrum.basicOpen (a i))]
  exact IsIso.comp_isIso' (hrestrict i)
    (isIso_normalization_restrict_of_isNormal hS _ (hnormal i))

/-- Affine descent of the normalization: if `S` is faithfully flat over `R` with the same quotient
by the ideal generated by `a`, and `Spec S` has finite normalization which is normal over each
basic open of `a i`, then there is a finite normal `R`-algebra `D` whose base change to `S` is
the normalization of `Spec S`. -/
private theorem exists_finite_normal_model_of_flat_quotient_iso
    {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
    [Module.FaithfullyFlat R S]
    (hS : ∀ U : (Spec (.of S)).Opens, IsCompact (U : Set (Spec (.of S))) →
      (irreducibleComponents U).Finite)
    [IsFinite (Scheme.normalization (Spec (.of S)) hS)]
    {r : ℕ} (a : Fin r → R)
    (hquot : Function.Bijective
      (Ideal.quotientMap ((Ideal.span (Set.range a)).map (algebraMap R S))
        (algebraMap R S) Ideal.le_comap_map))
    (hnormal : ∀ i, IsNormal
      (Scheme.Opens.toScheme (X := Spec (.of S))
        (PrimeSpectrum.basicOpen (algebraMap R S (a i))))) :
    ∃ (D : Type u) (_ : CommRing D) (_ : Algebra R D),
      Module.Finite R D ∧ IsNormalRing D ∧
      (∀ i, Function.Bijective (LocalizedModule.map (Submonoid.powers (a i))
        (Algebra.linearMap R D))) ∧
      ∃ e : pullback (Spec.map (CommRingCat.ofHom (algebraMap R D)))
          (Spec.map (CommRingCat.ofHom (algebraMap R S))) ≅
          Scheme.normalizationScheme (Spec (.of S)) hS,
        e.hom ≫ Scheme.normalization (Spec (.of S)) hS = pullback.snd _ _ := by
  obtain ⟨T, hTcomm, hTalg, hTfinite, hTnormal, hTloc, e, he⟩ :=
    exists_finite_normal_normalization_algebra S hS (fun i => algebraMap R S (a i)) hnormal
  let : Algebra R T := ((algebraMap S T).comp (algebraMap R S)).toAlgebra
  let : IsScalarTower R S T := IsScalarTower.of_algebraMap_eq fun _ => rfl
  obtain ⟨D, hDcomm, hDalg, hDfinite, hDnormal, hDloc, ⟨E⟩⟩ :=
    exists_finite_normal_algebra_of_flat_quotient_iso a hquot hTloc hTnormal
  let j := Spec.map (CommRingCat.ofHom (algebraMap R D))
  let i := Spec.map (CommRingCat.ofHom (algebraMap R S))
  let eT : Spec (.of (S ⊗[R] D)) ≅ Spec (.of T) :=
    Scheme.Spec.mapIso E.toRingEquiv.toCommRingCatIso.symm.op
  have hE : eT.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap S T)) =
      Spec.map (CommRingCat.ofHom (algebraMap S (S ⊗[R] D))) := by
    change Spec.map (CommRingCat.ofHom E.symm.toRingEquiv.toRingHom) ≫ _ = _
    rw [← Spec.map_comp]
    congr 1
    ext s
    exact E.symm.commutes s
  refine ⟨D, hDcomm, hDalg, hDfinite, hDnormal, hDloc,
    (pullbackSymmetry j i) ≪≫ pullbackSpecIso R S D ≪≫ eT ≪≫ e, ?_⟩
  simp only [Iso.trans_hom, Category.assoc, he, hE, j, i,
    pullbackSpecIso_hom_fst', pullbackSymmetry_hom_comp_fst]

/-- Two points of `Y` lying over the same point `x` coincide when the fibre of `p` over `x` is the
spectrum of the residue field at `x`. -/
private theorem eq_of_isIso_fiber
    {X Y : Scheme.{u}} (p : Y ⟶ X) (x : X)
    [IsIso (p.fiberToSpecResidueField x)] {y z : Y}
    (hy : p y = x) (hz : p z = x) : y = z := by
  let y' := (p.fiberHomeo x).symm ⟨y, hy⟩
  let z' := (p.fiberHomeo x).symm ⟨z, hz⟩
  have h : y' = z' := (p.fiberToSpecResidueField x).isOpenEmbedding.injective
    (Subsingleton.elim _ _)
  exact congrArg Subtype.val ((p.fiberHomeo x).symm.injective h)

/-- A point lying over the generic point of an irreducible component is itself such a generic point
when the fibre there is the spectrum of the residue field. -/
private theorem genericPoint_of_isIso_fiber
    {X Y : Scheme.{u}} (p : Y ⟶ X) (x : genericPoints X)
    [IsIso (p.fiberToSpecResidueField x.1)] {y : Y} (hy : p y = x.1) :
    y ∈ genericPoints Y :=
  mem_genericPoints_of_no_strict_generalization fun _ hz =>
    eq_of_isIso_fiber p x.1 (eq_of_specializes_genericPoint x.2 (hy ▸ hz.map p.continuous)) hy

/-- At a generic point `x` whose fibre under `p` is the spectrum of the residue field, the morphism
from `Spec` of the residue field at `x` lifts through `f`, and the lift meets every point of `Z`
above `x`. -/
private theorem exists_residueField_lift_of_isIso_fiber
    {X Y Z : Scheme.{u}} (f : Z ⟶ X) (p : Y ⟶ X)
    (hY : ∀ U : Y.Opens, IsCompact (U : Set Y) → (irreducibleComponents U).Finite)
    (e : pullback f p ≅ Scheme.normalizationScheme Y hY)
    (he : e.hom ≫ Scheme.normalization Y hY = pullback.snd f p)
    (x : genericPoints X) [IsIso (p.fiberToSpecResidueField x.1)] :
    ∃ g : Spec (X.residueField x.1) ⟶ Z,
      g ≫ f = X.fromSpecResidueField x.1 ∧
      ∀ z : Z, f z = x.1 → z ∈ Set.range g := by
  let K := Spec (X.residueField x.1)
  let s : K ⟶ Y := inv (p.fiberToSpecResidueField x.1) ≫ p.fiberι x.1
  have hs : s ≫ p = X.fromSpecResidueField x.1 := by
    simp [s, Category.assoc, Scheme.Hom.fiber_fac]
  have hsgen (k : K) : s k ∈ genericPoints Y := genericPoint_of_isIso_fiber p x
    ((congrArg (fun a => a k) hs).trans (Scheme.fromSpecResidueField_apply _ _))
  have : IsNormal K := isNormal_spec_of_isNormalRing (IsNormalRing.of_isIntegrallyClosed _)
  obtain ⟨t, ht, -⟩ := Scheme.existsUnique_lift_normalization hY s fun η => hsgen η.1
  let g := t ≫ e.inv ≫ pullback.fst f p
  have hinv : e.inv ≫ pullback.snd f p = Scheme.normalization Y hY :=
    e.inv_comp_eq.mpr he.symm
  have hg : g ≫ f = X.fromSpecResidueField x.1 := by
    simp only [g, Category.assoc, pullback.condition, reassoc_of% hinv,
      reassoc_of% ht, hs]
  refine ⟨g, hg, fun z hz => ?_⟩
  let L := Spec (Z.residueField z)
  let c : L ⟶ K := Spec.map (f.residueFieldMap z) ≫ Spec.map (X.residueFieldCongr hz).inv
  have hc : c ≫ X.fromSpecResidueField x.1 = Z.fromSpecResidueField z ≫ f := by
    calc
      c ≫ X.fromSpecResidueField x.1 =
          Spec.map (f.residueFieldMap z) ≫ X.fromSpecResidueField (f z) :=
        congrArg (fun a => Spec.map (f.residueFieldMap z) ≫ a)
          (Scheme.residueFieldCongr_fromSpecResidueField hz.symm)
      _ = _ := Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField f z
  let l : L ⟶ pullback f p := pullback.lift (Z.fromSpecResidueField z) (c ≫ s)
    (by rw [Category.assoc, hs, hc])
  have : IsNormal L := isNormal_spec_of_isNormalRing (IsNormalRing.of_isIntegrallyClosed _)
  have hl : l ≫ e.hom = c ≫ t :=
    (Scheme.existsUnique_lift_normalization hY (c ≫ s) fun η => hsgen (c η.1)).unique
      (by rw [Category.assoc, he]; exact pullback.lift_snd _ _ _)
      (by simp [Category.assoc, ht])
  have hcg : c ≫ g = Z.fromSpecResidueField z := by
    dsimp [g]
    rw [← Category.assoc c t, ← hl]
    simp only [Category.assoc, Iso.hom_inv_id_assoc]
    exact pullback.lift_fst _ _ _
  exact ⟨c (IsLocalRing.closedPoint (Z.residueField z)),
    (congrArg (fun a => a (IsLocalRing.closedPoint (Z.residueField z))) hcg).trans
    (Scheme.fromSpecResidueField_apply _ _)⟩

/-- At a point of an open subscheme over which `f` restricts to an isomorphism, the morphism from
`Spec` of the residue field lifts through `f`, and the lift meets every point of `Z` above it. -/
private theorem exists_residueField_lift_of_isIso_restrict
    {X Z : Scheme.{u}} (f : Z ⟶ X) (U : X.Opens) [IsIso (f ∣_ U)]
    (x : X) (hx : x ∈ U) :
    ∃ g : Spec (X.residueField x) ⟶ Z,
      g ≫ f = X.fromSpecResidueField x ∧
      ∀ z : Z, f z = x → z ∈ Set.range g := by
  have hr : Set.range (X.fromSpecResidueField x) ⊆ Set.range U.ι := by
    rw [Scheme.range_fromSpecResidueField, Set.singleton_subset_iff]
    exact ⟨⟨x, hx⟩, rfl⟩
  let a := IsOpenImmersion.lift U.ι (X.fromSpecResidueField x) hr
  let g := a ≫ inv (f ∣_ U) ≫ (f ⁻¹ᵁ U).ι
  have hg : g ≫ f = X.fromSpecResidueField x := by
    simp only [g, Category.assoc, ← morphismRestrict_ι, IsIso.inv_hom_id_assoc]
    exact IsOpenImmersion.lift_fac _ _ hr
  refine ⟨g, hg, fun z hz => ?_⟩
  let k := IsLocalRing.closedPoint (X.residueField x)
  have hw : f (g k) = x :=
    (congrArg (fun a => a k) hg).trans (Scheme.fromSpecResidueField_apply _ _)
  refine ⟨k, ?_⟩
  have hwU : g k ∈ f ⁻¹ᵁ U := by
    change f (g k) ∈ U
    rwa [hw]
  have hzU : z ∈ f ⁻¹ᵁ U := by
    change f z ∈ U
    rwa [hz]
  have h : (⟨g k, hwU⟩ : (f ⁻¹ᵁ U).toScheme) = ⟨z, hzU⟩ :=
    (f ∣_ U).isOpenEmbedding.injective
      (Subtype.ext ((morphismRestrict_base_coe f U ⟨g k, hwU⟩).trans
        ((hw.trans hz.symm).trans (morphismRestrict_base_coe f U ⟨z, hzU⟩).symm)))
  exact congrArg Subtype.val h

/-- Residue-field lifts at all generic points assemble into a morphism from the coproduct of the
generic-point residue spectra which factors the canonical morphism and has dense image. -/
private theorem exists_dense_generic_lift
    {X Z : Scheme.{u}} (f : Z ⟶ X)
    (hgen : Set.MapsTo f (genericPoints Z) (genericPoints X))
    (hlift : ∀ x : genericPoints X, ∃ g : Spec (X.residueField x.1) ⟶ Z,
      g ≫ f = X.fromSpecResidueField x.1 ∧
      ∀ z : Z, f z = x.1 → z ∈ Set.range g) :
    ∃ g : Scheme.genericPointResidueSpectrum X ⟶ Z,
      g ≫ f = Scheme.fromGenericPointResidueFields X ∧ DenseRange g := by
  classical
  choose g hg hsurj using hlift
  let g' : ∀ η : genericPoints X, Spec (.of (X.residueField η.1)) ⟶ Z := fun η ↦ g η
  refine ⟨Sigma.desc g',
    (Scheme.eq_fromGenericPointResidueFields_iff X _).2 fun η ↦ ?_, ?_⟩
  · exact ((Category.assoc _ _ _).symm.trans
      (congrArg (fun k ↦ k ≫ f) (Sigma.ι_comp_desc g' η))).trans (hg η)
  · apply (dense_iff_closure_eq.mpr (genericPoints.closure (α := Z))).mono
    intro z hz
    obtain ⟨k, hk⟩ := hsurj ⟨f z, hgen hz⟩ z rfl
    refine ⟨Sigma.ι (fun η : genericPoints X ↦ Spec (.of (X.residueField η.1)))
      ⟨f z, hgen hz⟩ k, ?_⟩
    change (Sigma.ι _ _ ≫ Sigma.desc g') k = z
    rw [Sigma.ι_comp_desc]
    exact hk

/-- If `R → S` becomes bijective after localizing at the powers of `a`, then the induced map of
localizations away from `a` is bijective. -/
private theorem awayMap_bijective_of_localizedModuleMap_bijective
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S] (a : R)
    (h : Function.Bijective (LocalizedModule.map (Submonoid.powers a)
      (Algebra.linearMap R S))) :
    Function.Bijective (Localization.awayMap (algebraMap R S) a) := by
  let l := (IsScalarTower.toAlgHom R S (Localization.Away (algebraMap R S a))).toLinearMap
  have : IsLocalizedModule (Submonoid.powers a) l := by
    apply isLocalizedModule_iff_isLocalization.mpr
    simpa only [Algebra.algebraMapSubmonoid_powers] using
      (inferInstance : IsLocalization.Away (algebraMap R S a)
        (Localization.Away (algebraMap R S a)))
  let g : Localization.Away a →ₐ[R] Localization.Away (algebraMap R S a) :=
    { __ := Localization.awayMap (algebraMap R S) a
      commutes' r := by
        change IsLocalization.Away.map (Localization.Away a)
          (Localization.Away (algebraMap R S a)) (algebraMap R S) a
          (algebraMap R (Localization.Away a) r) = _
        rw [IsLocalization.Away.map, IsLocalization.map_eq]
        exact (IsScalarTower.algebraMap_apply R S _ r).symm }
  have hg : IsLocalizedModule.map (Submonoid.powers a)
      (Algebra.linearMap R (Localization.Away a)) l (Algebra.linearMap R S) =
      g.toLinearMap := by
    apply IsLocalizedModule.ext (Submonoid.powers a)
      (Algebra.linearMap R (Localization.Away a)) (IsLocalizedModule.map_units l)
    rw [IsLocalizedModule.map_comp]
    exact LinearMap.ext fun r => (g.commutes r).symm
  have := (IsLocalizedModule.map_bijective_iff_localizedModuleMap_bijective
    (Algebra.linearMap R (Localization.Away a)) l).mpr h
  rwa [hg] at this


/-- The spectrum map of a flat algebra is flat. -/
private theorem flat_specMap_algebraMap {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
    [Module.Flat R S] : Flat (Spec.map (CommRingCat.ofHom (algebraMap R S))) :=
  Flat.SpecMap_iff.mpr (RingHom.flat_algebraMap_iff.mpr inferInstance)

/-- The completion of a Noetherian local ring at its maximal ideal is faithfully flat. -/
private theorem faithfullyFlat_adicCompletion_maximalIdeal (A : Type u) [CommRing A]
    [IsNoetherianRing A] [IsLocalRing A] :
    Module.FaithfullyFlat A (AdicCompletion (maximalIdeal A) A) :=
  AdicCompletion.faithfullyFlat_of_le_ringJacobson _
    ((IsLocalRing.maximalIdeal_le_jacobson ⊥).trans_eq Ideal.jacobson_bot)

/-- Affine form of the main result: if `S` is faithfully flat over `R` with the same quotient by
the ideal generated by `a`, and the normalization of `Spec S` is finite and normal over each basic
open of `a i`, then the normalization of `Spec R` is finite and its base change to `Spec S` is the
normalization of `Spec S`. -/
private theorem finite_normalization_and_baseChange_of_flat_quotient_iso
    {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
    [Module.FaithfullyFlat R S]
    (hR : ∀ U : (Spec (.of R)).Opens, IsCompact (U : Set (Spec (.of R))) →
      (irreducibleComponents U).Finite)
    (hS : ∀ U : (Spec (.of S)).Opens, IsCompact (U : Set (Spec (.of S))) →
      (irreducibleComponents U).Finite)
    [IsFinite (Scheme.normalization (Spec (.of S)) hS)]
    {r : ℕ} (a : Fin r → R)
    (hquot : Function.Bijective
      (Ideal.quotientMap ((Ideal.span (Set.range a)).map (algebraMap R S))
        (algebraMap R S) Ideal.le_comap_map))
    (hnormal : ∀ i, IsNormal
      (Scheme.Opens.toScheme (X := Spec (.of S))
        (PrimeSpectrum.basicOpen (algebraMap R S (a i))))) :
    IsFinite (Scheme.normalization (Spec (.of R)) hR) ∧
      ∃ e : pullback (Scheme.normalization (Spec (.of R)) hR)
          (Spec.map (CommRingCat.ofHom (algebraMap R S))) ≅
          Scheme.normalizationScheme (Spec (.of S)) hS,
        e.hom ≫ Scheme.normalization (Spec (.of S)) hS = pullback.snd _ _ := by
  classical
  obtain ⟨D, _, _, hDfinite, hDnormal, hDloc, e, he⟩ :=
    exists_finite_normal_model_of_flat_quotient_iso hS a hquot hnormal
  let f := Spec.map (CommRingCat.ofHom (algebraMap R D))
  let p := Spec.map (CommRingCat.ofHom (algebraMap R S))
  have : IsFinite f := (IsFinite.SpecMap_iff _).mpr
    (RingHom.finite_algebraMap.mpr hDfinite)
  have : Flat p := flat_specMap_algebraMap
  have : Surjective p := ⟨PrimeSpectrum.comap_surjective_of_faithfullyFlat⟩
  obtain ⟨g, hg, hdense⟩ := exists_dense_generic_lift f
    (mapsTo_genericPoints_of_pullback_normalization f p hS e he) (fun x => by
      by_cases hx : Ideal.span (Set.range a) ≤ x.1.asIdeal
      · let := isIso_fiber_of_flat_quotient_iso _ (inferInstance : Module.Flat R S) hquot x.1 hx
        exact exists_residueField_lift_of_isIso_fiber f p hS e he x
      · obtain ⟨i, hi⟩ : ∃ i, a i ∉ x.1.asIdeal := by
          simpa only [Ideal.span_le, Set.range_subset_iff, not_forall, SetLike.mem_coe] using hx
        have : IsIso (f ∣_ PrimeSpectrum.basicOpen (a i)) :=
          (isIso_restrict_specMap_iff (S := D) (a i)).mpr
            (awayMap_bijective_of_localizedModuleMap_bijective (a i) (hDloc i))
        exact exists_residueField_lift_of_isIso_restrict f (PrimeSpectrum.basicOpen (a i))
          x.1 ((PrimeSpectrum.mem_basicOpen _ _).mpr hi))
  exact finite_normalization_and_baseChange_of_generic_lift hR hS f
    (isNormal_spec_of_isNormalRing hDnormal) p e he g hg hdense

/-- Normality of the complement of the special fibre passes to an open subscheme, the complement
there being an open subscheme of the complement upstairs. -/
private theorem isNormal_complementSpecialFiber_of_isOpenImmersion
    {A : Type u} [CommRing A] [IsLocalRing A] {X Y : Scheme.{u}}
    (f : X ⟶ Spec (.of A)) (g : Y ⟶ X) [IsOpenImmersion g]
    (h : IsNormal (complementSpecialFiber f)) :
    IsNormal (complementSpecialFiber (g ≫ f)) := by
  change IsNormal ((g ≫ f) ⁻¹ᵁ Stacks.Divisors.puncturedSpectrum A).toScheme
  rw [Scheme.Hom.comp_preimage]
  exact isNormal_of_isOpenImmersion (g ∣_ f ⁻¹ᵁ Stacks.Divisors.puncturedSpectrum A) h

/-- A locally Noetherian scheme has finitely many irreducible components on every quasi-compact
open, such an open being a Noetherian space. -/
@[ega "0 2.2.5" "special case",
  ega "I 7.1.6" "special case",
  ega "I 7.3.3" "special case",
  ega "IV 2.3.6" "special case"]
public theorem finite_irreducibleComponents_of_locallyNoetherian
    (X : Scheme.{u}) [IsLocallyNoetherian X] :
    ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite := by
  intro U hU
  have : CompactSpace U := isCompact_iff_compactSpace.mp hU
  have : NoetherianSpace U := noetherianSpace_of_isLocallyNoetherianSpace U
    ((isLocallyNoetherianSpace_of_isLocallyNoetherian X).subtype U)
  exact NoetherianSpace.finite_irreducibleComponents


/-- Over a local ring `A`, the basic open of `B ⊗[A] C` cut out by an element of the maximal
ideal of `A` lies over the punctured spectrum of the local `A`-algebra `C`. -/
private theorem basicOpen_le_preimage_puncturedSpectrum {A B C : Type u} [CommRing A]
    [IsLocalRing A] [CommRing B] [Algebra A B] [CommRing C] [IsLocalRing C] [Algebra A C]
    [IsLocalHom (algebraMap A C)] {a : A} (ha : a ∈ maximalIdeal A)
    (q : Spec (.of (B ⊗[A] C)) ⟶ Spec (.of C))
    (hq : q = Spec.map (CommRingCat.ofHom
      (Algebra.TensorProduct.includeRight : C →ₐ[A] B ⊗[A] C).toRingHom)) :
    (PrimeSpectrum.basicOpen (algebraMap B (B ⊗[A] C) (algebraMap A B a)) :
      (Spec (.of (B ⊗[A] C))).Opens) ≤ q ⁻¹ᵁ Stacks.Divisors.puncturedSpectrum C := by
  intro z hz
  change q z ≠ IsLocalRing.closedPoint C
  intro heq
  have hac : algebraMap A C a ∈ maximalIdeal C := by
    change a ∈ (maximalIdeal C).comap (algebraMap A C)
    rwa [IsLocalRing.maximalIdeal_comap]
  have hzmem : (Algebra.TensorProduct.includeRight : C →ₐ[A] B ⊗[A] C)
      (algebraMap A C a) ∈ z.asIdeal := by
    change algebraMap A C a ∈ (PrimeSpectrum.comap
      (Algebra.TensorProduct.includeRight : C →ₐ[A] B ⊗[A] C).toRingHom z).asIdeal
    rw [← show (q z).asIdeal = (PrimeSpectrum.comap
        (Algebra.TensorProduct.includeRight : C →ₐ[A] B ⊗[A] C).toRingHom z).asIdeal by
      rw [hq]; rfl, heq]
    exact hac
  change algebraMap B (B ⊗[A] C) (algebraMap A B a) ∉ z.asIdeal at hz
  apply hz
  have hab : algebraMap B (B ⊗[A] C) (algebraMap A B a) =
      (Algebra.TensorProduct.includeRight : C →ₐ[A] B ⊗[A] C) (algebraMap A C a) :=
    (IsScalarTower.algebraMap_apply A B (B ⊗[A] C) _).trans
      ((Algebra.TensorProduct.includeRight : C →ₐ[A] B ⊗[A] C).commutes _).symm
  rwa [hab]

/-- The affine case of the main result, for an algebra `B` of finite type over a Noetherian local
ring `A`: the normalization of `Spec B` is finite, and its base change to the completion is
normal. -/
private theorem finite_normalization_and_isNormal_pullback_completion_spec
    (A B : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    [CommRing B] [Algebra A B]
    [LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap A B)))]
    (hB : ∀ U : (Spec (.of B)).Opens, IsCompact (U : Set (Spec (.of B))) →
      (irreducibleComponents U).Finite)
    (hnormal : IsNormal (complementSpecialFiber
      (pullback.snd (Spec.map (CommRingCat.ofHom (algebraMap A B)))
        (Spec.map (CommRingCat.ofHom (algebraMap A (AdicCompletion (maximalIdeal A) A))))))) :
    IsFinite (Scheme.normalization (Spec (.of B)) hB) ∧
      IsNormal (pullback (Scheme.normalization (Spec (.of B)) hB)
        (pullback.fst (Spec.map (CommRingCat.ofHom (algebraMap A B)))
          (Spec.map (CommRingCat.ofHom (algebraMap A (AdicCompletion (maximalIdeal A) A)))))) := by
  classical
  let C := AdicCompletion (maximalIdeal A) A
  let S := B ⊗[A] C
  let f := Spec.map (CommRingCat.ofHom (algebraMap A B))
  let i := Spec.map (CommRingCat.ofHom (algebraMap A C))
  let Y := pullback f i
  let E : Y ≅ Spec (.of S) := pullbackSpecIso A B C
  let q : Spec (.of S) ⟶ Spec (.of C) := E.inv ≫ pullback.snd f i
  have : Module.FaithfullyFlat A C := faithfullyFlat_adicCompletion_maximalIdeal A
  have : Module.FaithfullyFlat B S := inferInstance
  have : LocallyOfFiniteType q := inferInstance
  have : IsLocallyNoetherian (Spec (.of S)) := LocallyOfFiniteType.isLocallyNoetherian q
  let hS := finite_irreducibleComponents_of_locallyNoetherian (Spec (.of S))
  have : IsFinite (Scheme.normalization (Spec (.of S)) hS) :=
    Scheme.isFinite_normalization
      (isNagataScheme_of_locallyOfFiniteType q
        (isNagataScheme_spec_of_isNagataRing C isNagataRing_adicCompletion_maximalIdeal)) hS
  have hn : IsNormal (complementSpecialFiber q) :=
    isNormal_complementSpecialFiber_of_isOpenImmersion (pullback.snd f i) E.inv hnormal
  obtain ⟨r, a, ha⟩ := Submodule.fg_iff_exists_fin_generating_family.mp
    (IsNoetherian.noetherian (maximalIdeal A))
  let b : Fin r → B := fun j => algebraMap A B (a j)
  have hb : Ideal.span (Set.range b) = (maximalIdeal A).map (algebraMap A B) := by
    rw [← ha, Ideal.map_span, ← Set.range_comp]
    rfl
  have hquot := quotientMap_tensorProduct_bijective (B := B) (S := C)
    (maximalIdeal A) (inferInstance : Module.Flat A C)
    (AdicCompletion.quotientMap_bijective _ (IsNoetherian.noetherian _))
  rw [← hb] at hquot
  have hnopen (j : Fin r) : IsNormal
      (Scheme.Opens.toScheme (X := Spec (.of S))
        (PrimeSpectrum.basicOpen (algebraMap B S (b j)))) := by
    have hUV := basicOpen_le_preimage_puncturedSpectrum (a := a j)
      (by rw [← ha]; exact Ideal.subset_span ⟨j, rfl⟩) q (pullbackSpecIso_inv_snd A B C)
    have := instIsOpenImmersionHomOfLE (Spec (.of S)) hUV
    exact isNormal_of_isOpenImmersion (Scheme.homOfLE (Spec (.of S)) hUV) hn
  obtain ⟨hfin, d, hd⟩ :=
    finite_normalization_and_baseChange_of_flat_quotient_iso hB hS b hquot hnopen
  refine ⟨hfin, ?_⟩
  let ν := Scheme.normalization (Spec (.of B)) hB
  let p := pullback.fst f i
  let pS := Spec.map (CommRingCat.ofHom (algebraMap B S))
  have hEp : E.inv ≫ p = pS := pullbackSpecIso_inv_fst' A B C
  let m := pullback.map ν pS ν p (𝟙 _) E.inv (𝟙 _) (by simp) (by simpa using hEp.symm)
  exact isNormal_of_isOpenImmersion (asIso m).inv
    (isNormal_of_isOpenImmersion d.hom (Scheme.isNormal_normalizationScheme _ hS))

/-- The affine case of the main result, stated for a morphism of affine schemes rather than for an
algebra map. -/
private theorem finite_normalization_and_isNormal_pullback_completion_specMap
    (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    (B : CommRingCat.{u}) (f : Spec B ⟶ Spec (.of A)) [LocallyOfFiniteType f]
    (hB : ∀ U : (Spec B).Opens, IsCompact (U : Set (Spec B)) →
      (irreducibleComponents U).Finite)
    (hnormal : IsNormal (complementSpecialFiber
      (pullback.snd f
        (Spec.map (CommRingCat.ofHom (algebraMap A (AdicCompletion (maximalIdeal A) A))))))) :
    IsFinite (Scheme.normalization (Spec B) hB) ∧
      IsNormal (pullback (Scheme.normalization (Spec B) hB)
        (pullback.fst f
          (Spec.map (CommRingCat.ofHom (algebraMap A (AdicCompletion (maximalIdeal A) A)))))) := by
  obtain ⟨g, rfl⟩ := Spec.map_surjective f
  let : Algebra A B := g.hom.toAlgebra
  exact finite_normalization_and_isNormal_pullback_completion_spec A B hB hnormal

/-- The affine case of the main result restricts along an open immersion `Spec R → X`: the
normalization of `Spec R` is finite and its base change to the completion is normal. -/
private theorem finite_normalization_and_isNormal_pullback_completion_of_isOpenImmersion
    (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) [LocallyOfFiniteType f]
    {R : CommRingCat.{u}} (g : Spec R ⟶ X) [IsOpenImmersion g]
    (hU : ∀ U : (Spec R).Opens, IsCompact (U : Set (Spec R)) → (irreducibleComponents U).Finite)
    (hnormal : IsNormal (complementSpecialFiber
      (pullback.snd f
        (Spec.map (CommRingCat.ofHom (algebraMap A (AdicCompletion (maximalIdeal A) A))))))) :
    IsFinite (Scheme.normalization (Spec R) hU) ∧
      IsNormal (pullback (Scheme.normalization (Spec R) hU)
        (pullback.fst (g ≫ f)
          (Spec.map (CommRingCat.ofHom (algebraMap A (AdicCompletion (maximalIdeal A) A)))))) := by
  let i := Spec.map (CommRingCat.ofHom (algebraMap A (AdicCompletion (maximalIdeal A) A)))
  apply finite_normalization_and_isNormal_pullback_completion_specMap A R (g ≫ f) hU
  let E := pullbackRightPullbackFstIso f i g
  let g' := E.inv ≫ pullback.snd g (pullback.fst f i)
  have hq : g' ≫ pullback.snd f i = pullback.snd (g ≫ f) i := by
    simpa only [g', Category.assoc] using pullbackRightPullbackFstIso_inv_snd_snd f i g
  rw [← hq]
  exact isNormal_complementSpecialFiber_of_isOpenImmersion (pullback.snd f i) g' hnormal

/-- The main local statement: for `X` locally of finite type over a Noetherian local ring `A` whose
completed complement of the special fibre is normal, the normalization of `X` is finite and its
base change to the completion is normal.  Both assertions are Zariski local on `X`. -/
private theorem finite_normalization_and_isNormal_pullback_completion
    (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) [LocallyOfFiniteType f]
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    (hnormal : IsNormal (complementSpecialFiber
      (pullback.snd f
        (Spec.map (CommRingCat.ofHom (algebraMap A (AdicCompletion (maximalIdeal A) A))))))) :
    IsFinite (Scheme.normalization X hX) ∧
      IsNormal (pullback (Scheme.normalization X hX)
        (pullback.fst f
          (Spec.map (CommRingCat.ofHom (algebraMap A (AdicCompletion (maximalIdeal A) A)))))) := by
  let C := AdicCompletion (maximalIdeal A) A
  let i := Spec.map (CommRingCat.ofHom (algebraMap A C))
  let ν := Scheme.normalization X hX
  let 𝒰 := X.affineOpenCover
  let hU (j : 𝒰.I₀) := finite_irreducibleComponents_of_smooth (𝒰.f j) hX
  let νU (j : 𝒰.I₀) := Scheme.normalization (Spec (𝒰.X j)) (hU j)
  have H (j : 𝒰.I₀) : IsFinite (νU j) ∧
      IsNormal (pullback (νU j) (pullback.fst (𝒰.f j ≫ f) i)) :=
    finite_normalization_and_isNormal_pullback_completion_of_isOpenImmersion A f (𝒰.f j)
      (hU j) hnormal
  have hEtale : ∀ j : 𝒰.I₀, Etale (𝒰.f j) :=
    fun j ↦ inferInstanceAs (Etale (X.affineOpenCover.f j))
  have hiso (j : 𝒰.I₀) : ∃ e : Scheme.normalizationScheme (Spec (𝒰.X j)) (hU j) ≅
      pullback ν (𝒰.f j), e.hom ≫ pullback.snd ν (𝒰.f j) = νU j :=
    @exists_iso_normalizationScheme_pullback_of_etale _ _ (𝒰.f j) (hEtale j) hX
  have : IsZariskiLocalAtTarget @IsFinite := Stacks.Morphisms.isFinite_isZariskiLocalAtTarget
  constructor
  · apply IsZariskiLocalAtTarget.of_openCover (P := @IsFinite) 𝒰.openCover
    intro j
    obtain ⟨e, he'⟩ := hiso j
    have : IsFinite (νU j) := (H j).1
    change IsFinite (pullback.snd ν (𝒰.f j))
    rw [e.eq_inv_comp.mpr he']
    infer_instance
  · apply isNormal_of_isOpenImmersion (pullbackRightPullbackFstIso f i ν).hom
    let 𝒱 := 𝒰.openCover.pullback₁ ν
    apply isNormal_of_openCover (𝒱.pullback₁ (pullback.fst (ν ≫ f) i))
    intro j
    obtain ⟨e, he'⟩ := hiso j
    let k := pullback.fst ν (𝒰.f j)
    have hcomp : νU j ≫ (𝒰.f j ≫ f) = e.hom ≫ (k ≫ (ν ≫ f)) := by
      rw [← he']
      simp only [Category.assoc, k,
        ← reassoc_of% (pullback.condition (f := ν) (g := 𝒰.f j))]
    let m := pullback.map (νU j ≫ (𝒰.f j ≫ f)) i (k ≫ (ν ≫ f)) i
      e.hom (𝟙 _) (𝟙 _) (by simpa using hcomp) (by simp)
    let E := (pullbackSymmetry (pullback.fst (ν ≫ f) i) k) ≪≫
      (pullbackRightPullbackFstIso (ν ≫ f) i k) ≪≫ (asIso m).symm ≪≫
      (pullbackRightPullbackFstIso (𝒰.f j ≫ f) i (νU j)).symm
    exact @isNormal_of_isOpenImmersion _ _ E.hom (IsOpenImmersion.of_isIso E.hom) (H j).2

/-- A generic point of an irreducible component of `X` is a generic point of an irreducible
component of the fibre of `f` through it. -/
@[ega "0 2.1.8" "partial, special case"]
private theorem mem_genericPoints_fiber_of_mem_genericPoints
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) (hx : x ∈ genericPoints X)
    (η : S) (hη : f x = η) :
    (f.fiberHomeo η).symm ⟨x, by simp [hη]⟩ ∈ genericPoints (f.fiber η) := by
  refine mem_genericPoints_of_no_strict_generalization fun y hy => ?_
  have hxy : f.fiberι η y ⤳ x := by
    simpa [Scheme.Hom.fiberι_fiberHomeo_symm] using hy.map (f.fiberι η).continuous
  apply (f.fiberι η).isEmbedding.injective
  simpa [Scheme.Hom.fiberι_fiberHomeo_symm] using eq_of_specializes_genericPoint hx hxy

/-- A point whose image is a generic point of an irreducible component of `S` and which is a
generic point of its fibre is a generic point of an irreducible component of `X`. -/
private theorem mem_genericPoints_of_mem_genericPoints_fiber
    {X S : Scheme.{u}} (f : X ⟶ S) {x : X} {η : S}
    (hη : η ∈ genericPoints S) (hfx : f x = η)
    (hx : (f.fiberHomeo η).symm ⟨x, by simp [hfx]⟩ ∈ genericPoints (f.fiber η)) :
    x ∈ genericPoints X := by
  refine mem_genericPoints_of_no_strict_generalization fun x' hx'x => ?_
  have hη' : f x' = η :=
    eq_of_specializes_genericPoint hη (by simpa [hfx] using hx'x.map f.continuous)
  let xη : f.fiber η := (f.fiberHomeo η).symm ⟨x, by simp [hfx]⟩
  let x'η : f.fiber η := (f.fiberHomeo η).symm ⟨x', by simp [hη']⟩
  have hxsub : (⟨x', by simp [hη']⟩ : {z : X // f z = η}) ⤳
      (⟨x, by simp [hfx]⟩ : {z : X // f z = η}) := by
    rw [subtype_specializes_iff]
    simpa [hfx] using hx'x
  have hfiber : x'η ⤳ xη := hxsub.map (f.fiberHomeo η).symm.continuous
  have heq : x'η = xη := eq_of_specializes_genericPoint hx hfiber
  simpa [xη, x'η, Scheme.Hom.fiberι_fiberHomeo_symm] using congrArg (f.fiberι η) heq

/-- For a pullback square of `f` along `ν` with `f` flat, the induced morphism from the fibre of
the first projection over `η` to the fibre of `f` over `ν η` is flat. -/
private theorem flat_pullbackMap_fiber_of_isPullback
    {B Z X Y : Scheme.{u}} {p₁ : B ⟶ Z} {p₂ : B ⟶ X} {f : X ⟶ Y} [Flat f] {ν : Z ⟶ Y}
    (hpb : IsPullback p₂ p₁ f ν) (η : Z)
    (hνres : Z.fromSpecResidueField η ≫ ν =
      Spec.map (ν.residueFieldMap η) ≫ Y.fromSpecResidueField (ν η)) :
    Flat (pullback.map _ _ _ _ p₂ (Spec.map (ν.residueFieldMap η)) ν hpb.w.symm hνres) :=
  MorphismProperty.of_isPullback (isPullback_fiberToSpecResidueField_of_isPullback hpb η).flip
    (by infer_instance)

/-- For a flat `f` and a morphism `ν` carrying generic points to generic points, the second
projection of `pullback ν f` carries generic points of irreducible components to generic points:
the induced morphism of fibres is again flat. -/
private theorem mapsTo_genericPoints_pullback_snd_of_flat
    {X Y Z : Scheme.{u}} (f : X ⟶ Y) [Flat f] (ν : Z ⟶ Y)
    (hν : Set.MapsTo ν (genericPoints Z) (genericPoints Y)) :
    Set.MapsTo (pullback.snd ν f) (genericPoints (pullback ν f : Scheme))
      (genericPoints X) := by
  let B := pullback ν f
  let p₁ : B ⟶ Z := pullback.fst ν f
  let p₂ : B ⟶ X := pullback.snd ν f
  intro b hb
  let η : Z := p₁ b
  have hη : η ∈ genericPoints Z :=
    mapsTo_genericPoints_of_generalizing (Flat.generalizingMap p₁) hb
  let y : Y := ν η
  have hy : y ∈ genericPoints Y := hν hη
  have hfy : f (p₂ b) = y := by
    dsimp [y, η, p₁, p₂]
    exact congrArg (fun q : B ⟶ Y => q b) (pullback.condition (f := ν) (g := f)).symm
  let bη : p₁.fiber η := (p₁.fiberHomeo η).symm ⟨b, by simp [η, p₁]⟩
  have hbη : bη ∈ genericPoints (p₁.fiber η) :=
    mem_genericPoints_fiber_of_mem_genericPoints p₁ b hb η rfl
  let hpb : IsPullback p₂ p₁ f ν := (IsPullback.of_hasPullback ν f).flip
  have hνres : Z.fromSpecResidueField η ≫ ν =
      Spec.map (ν.residueFieldMap η) ≫ Y.fromSpecResidueField y :=
    (Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField (f := ν) η).symm
  let q := pullback.map _ _ _ _ p₂ (Spec.map (ν.residueFieldMap η)) ν hpb.w.symm hνres
  let r : p₁.fiber η ⟶ f.fiber y := q
  have hrflat : Flat r := flat_pullbackMap_fiber_of_isPullback hpb η hνres
  have hgenericFiber : r bη ∈ genericPoints (f.fiber y) :=
    mapsTo_genericPoints_of_generalizing (Flat.generalizingMap r) hbη
  apply mem_genericPoints_of_mem_genericPoints_fiber f hy hfy
  have hrfst : r ≫ f.fiberι y = p₁.fiberι η ≫ p₂ := by
    change q ≫ pullback.fst f (Y.fromSpecResidueField y) =
      pullback.fst p₁ (Z.fromSpecResidueField η) ≫ p₂
    dsimp [q, pullback.map]
    rw [pullback.lift_fst]
  have hpoint : f.fiberι y (r bη) = p₂ b := by
    rw [← Scheme.Hom.comp_apply, hrfst]
    simp [bη, p₁]
  have : (f.fiberHomeo y).symm ⟨p₂ b, by simp [hfy]⟩ = r bη :=
    (f.fiberHomeo y).symm_apply_eq.mpr (Subtype.ext hpoint.symm)
  simpa [this] using hgenericFiber

/-- If the base change along a flat `p : Y ⟶ X` of the normalization of `X` is normal, then it is
the normalization of `Y`, compatibly with the normalization morphism of `Y`.  The two morphisms
between them come from the universal property of the normalization. -/
private theorem exists_iso_pullback_normalization_of_flat_of_isNormal
    {X Y : Scheme.{u}} (p : Y ⟶ X) [Flat p]
    (hX : ∀ U : X.Opens, IsCompact (U : Set X) → (irreducibleComponents U).Finite)
    (hY : ∀ U : Y.Opens, IsCompact (U : Set Y) → (irreducibleComponents U).Finite)
    (hN : IsNormal (pullback (Scheme.normalization X hX) p)) :
    ∃ e : pullback (Scheme.normalization X hX) p ≅
        Scheme.normalizationScheme Y hY,
      e.hom ≫ Scheme.normalization Y hY =
        pullback.snd (Scheme.normalization X hX) p := by
  let νX := Scheme.normalization X hX
  let νY := Scheme.normalization Y hY
  let N := pullback νX p
  let p₁ : N ⟶ Scheme.normalizationScheme X hX := pullback.fst νX p
  let p₂ : N ⟶ Y := pullback.snd νX p
  have : IsNormal N := hN
  have : IsNormal (Scheme.normalizationScheme Y hY) :=
    Scheme.isNormal_normalizationScheme Y hY
  have hνX := mapsTo_genericPoints_normalization X hX
  have hνY := mapsTo_genericPoints_normalization Y hY
  have hggen : ∀ η : genericPoints (Scheme.normalizationScheme Y hY),
      (νY ≫ p) η.1 ∈ genericPoints X :=
    fun η => mapsTo_genericPoints_of_generalizing (Flat.generalizingMap p) (hνY η.2)
  obtain ⟨g, hg, -⟩ :=
    Scheme.existsUnique_lift_normalization hX (νY ≫ p) hggen
  let a : Scheme.normalizationScheme Y hY ⟶ N := pullback.lift g νY hg
  have ha₁ : a ≫ p₁ = g := pullback.lift_fst ..
  have ha₂ : a ≫ p₂ = νY := pullback.lift_snd ..
  have hp₂gen : ∀ η : genericPoints N, p₂ η.1 ∈ genericPoints Y :=
    fun η => mapsTo_genericPoints_pullback_snd_of_flat p νX hνX η.2
  obtain ⟨b, hb, -⟩ :=
    Scheme.existsUnique_lift_normalization hY p₂ hp₂gen
  have hNX := Scheme.existsUnique_lift_normalization
    hX (p₁ ≫ νX) (fun η => hνX
      (mapsTo_genericPoints_of_generalizing (Flat.generalizingMap p₁) η.2))
  have hbg : b ≫ g = p₁ := hNX.unique (by
    rw [Category.assoc, hg, ← Category.assoc, hb]
    exact (pullback.condition (f := νX) (g := p)).symm) rfl
  have hNY := Scheme.existsUnique_lift_normalization
    hY νY (fun η => hνY η.2)
  have hab : a ≫ b = 𝟙 _ := hNY.unique
    (by rw [Category.assoc, hb, ha₂]) (Category.id_comp _)
  have hba : b ≫ a = 𝟙 _ := by
    apply pullback.hom_ext
    · change (b ≫ a) ≫ p₁ = (𝟙 N) ≫ p₁
      simpa only [Category.assoc, ha₁, Category.id_comp] using hbg
    · change (b ≫ a) ≫ p₂ = (𝟙 N) ≫ p₂
      simpa only [Category.assoc, ha₂, Category.id_comp] using hb
  exact ⟨⟨b, a, hba, hab⟩, hb⟩

/-- **Stacks Project, Tag 0BG9 (finiteness).** If the complement of the special fibre after
completion is normal, then the normalization is finite. -/
@[stacks 0BG9 "finiteness"]
public theorem isFinite_normalization_of_isNormal_complementSpecialFiber_completion
    (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) [LocallyOfFiniteType f]
    (hnormal :
      let Ahat := AdicCompletion (maximalIdeal A) A
      let i : Spec (.of Ahat) ⟶ Spec (.of A) :=
        Spec.map (CommRingCat.ofHom (algebraMap A Ahat))
      let Y : Scheme.{u} := pullback f i
      let q : Y ⟶ Spec (.of Ahat) := pullback.snd f i
      IsNormal (complementSpecialFiber q)) :
    letI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
    let hX : ∀ U : X.Opens, IsCompact (U : Set X) →
        (irreducibleComponents U).Finite := fun U hU ↦ by
      have : CompactSpace U := isCompact_iff_compactSpace.mp hU
      have : NoetherianSpace U :=
        noetherianSpace_of_isLocallyNoetherianSpace U
          ((isLocallyNoetherianSpace_of_isLocallyNoetherian X).subtype U)
      exact NoetherianSpace.finite_irreducibleComponents
    IsFinite (Scheme.normalization X hX) := by
  let : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  exact (finite_normalization_and_isNormal_pullback_completion A f
    (finite_irreducibleComponents_of_locallyNoetherian X) hnormal).1

/-- **Stacks Project, Tag 0BG9 (compatibility with completion).** If the complement of the
special fibre after completion is normal, base change to the completion carries the
normalization of `X` to the normalization of the completed base change, compatibly with the
maps to that base change. -/
@[stacks 0BG9 "compatibility with completion"]
public theorem exists_iso_pullback_normalization_completion_of_isNormal_complementSpecialFiber
    (A : Type u) [CommRing A] [IsNoetherianRing A] [IsLocalRing A]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) [LocallyOfFiniteType f]
    (hnormal :
      let Ahat := AdicCompletion (maximalIdeal A) A
      let i : Spec (.of Ahat) ⟶ Spec (.of A) :=
        Spec.map (CommRingCat.ofHom (algebraMap A Ahat))
      let Y : Scheme.{u} := pullback f i
      let q : Y ⟶ Spec (.of Ahat) := pullback.snd f i
      IsNormal (complementSpecialFiber q)) :
    letI : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
    let Ahat := AdicCompletion (maximalIdeal A) A
    let i : Spec (.of Ahat) ⟶ Spec (.of A) :=
      Spec.map (CommRingCat.ofHom (algebraMap A Ahat))
    let Y : Scheme.{u} := pullback f i
    let p : Y ⟶ X := pullback.fst f i
    let hX : ∀ U : X.Opens, IsCompact (U : Set X) →
        (irreducibleComponents U).Finite := fun U hU ↦ by
      have : CompactSpace U := isCompact_iff_compactSpace.mp hU
      have : NoetherianSpace U :=
        noetherianSpace_of_isLocallyNoetherianSpace U
          ((isLocallyNoetherianSpace_of_isLocallyNoetherian X).subtype U)
      exact NoetherianSpace.finite_irreducibleComponents
    let νX := Scheme.normalization X hX
    letI : IsLocallyNoetherian Y := inferInstance
    let hY : ∀ V : Y.Opens, IsCompact (V : Set Y) →
        (irreducibleComponents V).Finite := fun V hV ↦ by
      have : CompactSpace V := isCompact_iff_compactSpace.mp hV
      have : NoetherianSpace V :=
        noetherianSpace_of_isLocallyNoetherianSpace V
          ((isLocallyNoetherianSpace_of_isLocallyNoetherian Y).subtype V)
      exact NoetherianSpace.finite_irreducibleComponents
    let νY := Scheme.normalization Y hY
    ∃ e : pullback νX p ≅ Scheme.normalizationScheme Y hY,
      e.hom ≫ νY = pullback.snd νX p := by
  let : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  let C := AdicCompletion (maximalIdeal A) A
  let i := Spec.map (CommRingCat.ofHom (algebraMap A C))
  have : Module.FaithfullyFlat A C := faithfullyFlat_adicCompletion_maximalIdeal A
  have : Flat i := flat_specMap_algebraMap
  exact exists_iso_pullback_normalization_of_flat_of_isNormal (pullback.fst f i)
    (finite_irreducibleComponents_of_locallyNoetherian X)
    (finite_irreducibleComponents_of_locallyNoetherian (pullback f i))
    (finite_normalization_and_isNormal_pullback_completion A f
      (finite_irreducibleComponents_of_locallyNoetherian X) hnormal).2

end AlgebraicGeometry.SemistableReduction

