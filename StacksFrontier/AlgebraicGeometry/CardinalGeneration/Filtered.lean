module

public import Mathlib.CategoryTheory.Limits.Preserves.Shapes.BinaryProducts
public import StacksFrontier.AlgebraicGeometry.CardinalGeneration.Basic
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.TensorExactnessSheafify
public import StacksFrontier.AlgebraicGeometry.AffineQcohPushforward.Basic
public import StacksFrontier.AlgebraicGeometry.ResolutionsAndBounds.BiproductQuasicoherent
public import StacksFrontier.AlgebraicGeometry.ResolutionsAndBounds.FiniteTypeSubobjects
import all StacksFrontier.AlgebraicGeometry.ResolutionsAndBounds.FiniteTypeSubobjects

/-!
# Directedness in Gabber's theorem: the bounded quasi-coherent subobjects are filtered

Gabber's theorem (Stacks 077N) has two assertions beyond the choice of the cardinal: that the
quasi-coherent `κ`-generated subobjects of a quasi-coherent `𝒪_X`-module form a directed system,
and that the canonical cocone over that system is colimiting. This file proves the **first** of
them, for every infinite `κ`, and therefore in particular at `cardinalBound X`.

The proof is the source's: the join of two subobjects is the image in `F` of their coproduct, so
the only thing to check is that being quasi-coherent and `κ`-generated survives a binary
coproduct and an epimorphic image. Quasi-coherence does, and is already available. For
`κ`-generation the epimorphic image is immediate, and the coproduct is the one place where
infinitude of `κ` is used, through `κ + κ = κ`.

## Main results

* `isCardinalGenerated_of_epi`: a quotient of a `κ`-generated sheaf of modules is `κ`-generated.
  The covering and the index types are unchanged, so no hypothesis on `κ` is needed.
* `isCardinalGenerated_coprod`: a binary coproduct of two `κ`-generated sheaves of modules is
  `κ`-generated, for `κ` infinite. The two sheaves are generated over the members of two
  unrelated covering families, and the proof intersects the two covering sieves: over a member of
  the intersection both carry their generators globally, and the coproduct is then generated by
  the `κ + κ = κ` sections obtained from both.
* `isCardinalGenerated_biprod`, the same statement for the biproduct, which is what the join of
  two subobjects is built from in the additive setting.
* `isFiltered_cardinalGeneratedQuasicoherentSubobject`: **the directedness assertion of
  Stacks 077N**, for an arbitrary infinite cardinal, and
  which is the form the tag asserts.

No stacks attribute is placed here. Tag 077N labels three assertions — the cardinal, the
directedness and the colimit — and the audit scanner promotes a tag as soon as it sees one
instance of it, so the attribute for the directedness clause belongs here only together with the
colimit clause, which is still open. What remains of 077N after this file is exactly the
hypothesis `hgen` of
`Stacks.AlgebraicGeometry.CardinalGeneration.isColimit_cocone_of_exists_mem`
(`StacksFrontier/AlgebraicGeometry/Properties/GabberResult/Colimit.lean`): that every section of `F`
over an affine open is a section of one of these subobjects. The closure construction that
produces the candidate submodule is
`Stacks.AlgebraicGeometry.GabberColimit.exists_bounded_compatible_family`, and what is missing
is the quasi-coherence of the resulting `sheafSubmodule` together with the bound on its local
generators.

## Implementation notes

Filteredness rather than directedness is what the subobject formulation gives: `Subobject F` is a
partial order, so between two objects of the full subcategory there is at most one morphism and
the `cocone_maps` condition is automatic. The `nonempty` field is witnessed by the image of the
zero morphism out of the structure sheaf, which is quasi-coherent and generated by a single
global section.

The coproduct is used rather than the biproduct wherever a colimit is wanted, because
`SheafOfModules.free` is a coproduct and the comparison
`SheafOfModules.freeSumIso : free I ⨿ free J ≅ free (I ⊕ J)` is stated for `⨿`; the passage to
the biproduct is `coprodIsoBiprod`, which holds in any preadditive category with binary
biproducts. Restriction of a family of generating sections along a morphism of the site is
`Stacks.SheafOfModules.LocalKernel.generatingSectionsOver`, and the cover intersection is the one
`Stacks.SheafOfModules.LocalKernel.kernel_isFiniteType_of_epi_from_finiteType` performs for the
finite-type analogue of this situation.

## References

* [Stacks Project, Tag 077N](https://stacks.math.columbia.edu/tag/077N)
* [Stacks Project, Tag 077L](https://stacks.math.columbia.edu/tag/077L)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits TopologicalSpace AlgebraicGeometry
open Stacks.SheafOfModules.LocalKernel

universe u v u'

namespace Stacks.AlgebraicGeometry.CardinalGeneration

/-! ### Closure properties of cardinal generation -/

section Site

variable {C : Type u'} [Category.{v} C] [HasBinaryProducts C] [HasPullbacks C]
  {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
  [HasSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ Z : C, HasSheafify (J.over Z) AddCommGrpCat.{u}]
  [∀ Z : C, (J.over Z).WEqualsLocallyBijective AddCommGrpCat.{u}]

omit [HasBinaryProducts C] [HasPullbacks C] [HasSheafify J AddCommGrpCat.{u}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- A sheaf of modules which, over each member of a covering family of the site, is generated by
at most `κ` sections, is `κ`-generated. This is the definition of
`IsCardinalGenerated` with the covering family supplied. -/
public theorem isCardinalGenerated_of_coversTop (M : SheafOfModules.{u} R) (κ : Cardinal.{u})
    {I : Type u'} (Xc : I → C) (hX : J.CoversTop Xc)
    (h : ∀ i, ∃ g : (M.over (Xc i)).GeneratingSections, Cardinal.mk g.I ≤ κ) :
    IsCardinalGenerated M κ := by
  classical
  exact ⟨{ I := I, X := Xc, coversTop := hX, generators := fun i ↦ (h i).choose },
    fun i ↦ (h i).choose_spec⟩

omit [HasBinaryProducts C] [HasPullbacks C] [∀ Z : C, HasSheafify (J.over Z) AddCommGrpCat.{u}]
  [∀ Z : C, (J.over Z).WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- The index type of a family of generating sections of a binary coproduct, assembled from
families of generating sections of the two summands: it is the sum of their index types, and the
epimorphism is the coproduct of the two, read through
`SheafOfModules.freeSumIso`. -/
public def generatingSectionsCoprod {M N : SheafOfModules.{u} R}
    (gM : M.GeneratingSections) (gN : N.GeneratingSections) : (M ⨿ N).GeneratingSections where
  I := gM.I ⊕ gN.I
  s := SheafOfModules.freeHomEquiv (M ⨿ N)
    ((SheafOfModules.freeSumIso gM.I gN.I).inv ≫ coprod.map gM.π gN.π)
  epi := by
    rw [Equiv.symm_apply_apply]
    infer_instance

omit [HasBinaryProducts C] [HasPullbacks C] [∀ Z : C, HasSheafify (J.over Z) AddCommGrpCat.{u}]
  [∀ Z : C, (J.over Z).WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- The index type of `generatingSectionsCoprod gM gN` is the sum of the index types of `gM` and
`gN`. -/
@[simp]
public theorem generatingSectionsCoprod_I {M N : SheafOfModules.{u} R}
    (gM : M.GeneratingSections) (gN : N.GeneratingSections) :
    (generatingSectionsCoprod gM gN).I = (gM.I ⊕ gN.I) :=
  rfl

omit [HasPullbacks C] in
/-- Generating sections of the restriction of a binary coproduct to an object of the site, from
generating sections of the two restricted summands. Restriction to an object is
`SheafOfModules.pushforward` along an identity, hence a left adjoint, so it carries the
coproduct of the restrictions to the restriction of the coproduct. -/
public def generatingSectionsOverCoprod (Z : C) {M N : SheafOfModules.{u} R}
    (gM : (M.over Z).GeneratingSections) (gN : (N.over Z).GeneratingSections) :
    ((M ⨿ N).over Z).GeneratingSections :=
  SheafOfModules.GeneratingSections.equivOfIso
    (PreservesColimitPair.iso (SheafOfModules.pushforward.{u} (𝟙 (R.over Z))) M N)
    (generatingSectionsCoprod gM gN)

omit [HasPullbacks C] in
/-- The index type of `generatingSectionsOverCoprod Z gM gN` is the sum of the index types of `gM`
and `gN`. -/
@[simp]
public theorem generatingSectionsOverCoprod_I (Z : C) {M N : SheafOfModules.{u} R}
    (gM : (M.over Z).GeneratingSections) (gN : (N.over Z).GeneratingSections) :
    (generatingSectionsOverCoprod Z gM gN).I = (gM.I ⊕ gN.I) :=
  rfl

omit [HasBinaryProducts C] [HasSheafify J AddCommGrpCat.{u}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- Restricting a family of generating sections along a morphism of the site does not change its
index type. -/
public theorem generatingSectionsOver_I {M : SheafOfModules.{u} R} {V W : C} (f : W ⟶ V)
    (gs : (M.over V).GeneratingSections) : (generatingSectionsOver f gs).I = gs.I :=
  rfl

omit [HasPullbacks C] [HasSheafify J AddCommGrpCat.{u}]
  [J.WEqualsLocallyBijective AddCommGrpCat.{u}] in
/-- **A quotient of a `κ`-generated sheaf of modules is `κ`-generated.** The covering family and
all the index types are unchanged — only the sections are replaced by their images — so this needs
no hypothesis on `κ`. -/
public theorem isCardinalGenerated_of_epi {M N : SheafOfModules.{u} R} (p : M ⟶ N) [Epi p]
    {κ : Cardinal.{u}} (h : IsCardinalGenerated M κ) : IsCardinalGenerated N κ := by
  obtain ⟨σ, hσ⟩ := h
  exact ⟨Stacks.SheafOfModules.localGeneratorsDataOfEpi σ p, fun i ↦ hσ i⟩

/-- **A binary coproduct of two `κ`-generated sheaves of modules is `κ`-generated**, for `κ`
infinite.

The two summands are generated over the members of two covering families which need not agree, so
the proof intersects the two covering sieves. Over a member `V` of the intersection both summands
carry their generators globally, by restriction along the two inclusions, and the coproduct is
generated there by the `κ + κ = κ` sections `generatingSectionsOverCoprod` assembles from them.
This is the only place in Gabber's directedness argument where infinitude of `κ` is used. -/
public theorem isCardinalGenerated_coprod {κ : Cardinal.{u}} (hκ : Cardinal.aleph0 ≤ κ)
    {M N : SheafOfModules.{u} R} (hM : IsCardinalGenerated M κ)
    (hN : IsCardinalGenerated N κ) : IsCardinalGenerated (M ⨿ N) κ := by
  classical
  obtain ⟨σ, hσ⟩ := hM
  obtain ⟨τ, hτ⟩ := hN
  refine isCardinalGenerated_of_coversTop _ κ
    (Subtype.val : { V : C // ∃ g : ((M ⨿ N).over V).GeneratingSections,
      Cardinal.mk g.I ≤ κ } → C) ?_ (fun i ↦ i.2)
  intro Y
  refine J.superset_covering ?_ (J.intersection_covering (σ.coversTop Y) (τ.coversTop Y))
  rintro V g ⟨hg₁, hg₂⟩
  obtain ⟨i, ⟨a⟩⟩ := (Sieve.mem_ofObjects_iff _ g).1 hg₁
  obtain ⟨j, ⟨b⟩⟩ := (Sieve.mem_ofObjects_iff _ g).1 hg₂
  refine (Sieve.mem_ofObjects_iff _ g).2 ⟨⟨V, ?_⟩, ⟨𝟙 V⟩⟩
  refine ⟨generatingSectionsOverCoprod V (generatingSectionsOver a (σ.generators i))
    (generatingSectionsOver b (τ.generators j)), ?_⟩
  rw [generatingSectionsOverCoprod_I, Cardinal.mk_sum, Cardinal.lift_id, Cardinal.lift_id]
  exact Cardinal.add_le_of_le hκ
    ((le_of_eq (congrArg Cardinal.mk (generatingSectionsOver_I a (σ.generators i)))).trans (hσ i))
    ((le_of_eq (congrArg Cardinal.mk (generatingSectionsOver_I b (τ.generators j)))).trans (hτ j))

omit [HasPullbacks C] in
/-- A sheaf of modules generated by at most `κ` *global* sections is `κ`-generated: the covering
family can be taken to consist of all the objects of the site, each of which carries the
restrictions of those sections. -/
public theorem isCardinalGenerated_of_generatingSections {M : SheafOfModules.{u} R}
    (G : M.GeneratingSections) {κ : Cardinal.{u}} (h : Cardinal.mk G.I ≤ κ) :
    IsCardinalGenerated M κ :=
  ⟨G.localGeneratorsData, fun _ ↦ h⟩

end Site

/-! ### Binary coproducts and biproducts -/

section Biprod

variable {D : Type u} [Category.{v} D] [Preadditive D] [HasBinaryBiproducts D]

/-- In a preadditive category with binary biproducts, the binary coproduct of two objects is
their biproduct. -/
public def coprodIsoBiprod (A B : D) : A ⨿ B ≅ A ⊞ B where
  hom := coprod.desc biprod.inl biprod.inr
  inv := biprod.desc coprod.inl coprod.inr
  hom_inv_id := by
    apply coprod.hom_ext
    · rw [← Category.assoc, coprod.inl_desc, biprod.inl_desc, Category.comp_id]
    · rw [← Category.assoc, coprod.inr_desc, biprod.inr_desc, Category.comp_id]
  inv_hom_id := by
    apply biprod.hom_ext'
    · rw [← Category.assoc, biprod.inl_desc, coprod.inl_desc, Category.comp_id]
    · rw [← Category.assoc, biprod.inr_desc, coprod.inr_desc, Category.comp_id]

end Biprod

/-! ### Directedness of the system of bounded quasi-coherent subobjects -/

section Scheme

variable {X : Scheme.{u}}

/-- A biproduct of two `κ`-generated `𝒪_X`-modules is `κ`-generated, for `κ` infinite: the
biproduct is the coproduct. -/
public theorem isCardinalGenerated_biprod (X : Scheme.{u})
    (M N : SheafOfModules.{u} X.ringCatSheaf) {κ : Cardinal.{u}} (hκ : Cardinal.aleph0 ≤ κ)
    (hM : IsCardinalGenerated.{u, u, u} M κ) (hN : IsCardinalGenerated.{u, u, u} N κ) :
    IsCardinalGenerated.{u, u, u} (M ⊞ N) κ :=
  @isCardinalGenerated_of_epi _ _ _ _ _ _ _ _ _ (coprodIsoBiprod M N).hom
    (CategoryTheory.IsIso.epi_of_iso _) κ (isCardinalGenerated_coprod hκ hM hN)

/-- The structure sheaf, as a module over itself, is `κ`-generated for every `κ ≥ 1`: it is the
free module on a one-element index type. -/
public theorem isCardinalGenerated_unit (X : Scheme.{u}) {κ : Cardinal.{u}} (hκ : 1 ≤ κ) :
    IsCardinalGenerated.{u, u, u} (SheafOfModules.unit X.ringCatSheaf) κ := by
  let e : SheafOfModules.free (R := X.ringCatSheaf) PUnit.{u + 1} ≅
      SheafOfModules.unit X.ringCatSheaf := coproductUniqueIso _
  refine isCardinalGenerated_of_generatingSections
    ((SheafOfModules.free.generatingSections (R := X.ringCatSheaf) PUnit.{u + 1}).ofEpi e.hom) ?_
  simpa using hκ

/-- The image of a morphism into `F` out of a quasi-coherent `κ`-generated `𝒪_X`-module is a
quasi-coherent `κ`-generated subobject of `F`. -/
private theorem property_imageSubobject {F S : X.Modules} [F.IsQuasicoherent]
    [S.IsQuasicoherent] {κ : Cardinal.{u}}
    (f : S ⟶ F) (hS : IsCardinalGenerated.{u, u, u} S κ) :
    cardinalGeneratedQuasicoherentSubobjectProperty F κ (imageSubobject f) := by
  have : Epi (factorThruImageSubobject f) := by
    dsimp only [factorThruImageSubobject]
    apply epi_comp
  exact ⟨imageSubobject_isQuasicoherent f,
    @isCardinalGenerated_of_epi _ _ _ _ _ _ _ _ _ (factorThruImageSubobject f) this κ hS⟩

/-- **The directedness assertion of Stacks 077N**, for an arbitrary infinite cardinal. The
quasi-coherent `κ`-generated subobjects of a quasi-coherent `𝒪_X`-module form a filtered system:
the join of two of them is the image in `F` of their biproduct, which is again quasi-coherent and,
because `κ` is infinite, again `κ`-generated. -/
public theorem isFiltered_cardinalGeneratedQuasicoherentSubobject (F : X.Modules)
    [F.IsQuasicoherent] {κ : Cardinal.{u}} (hκ : Cardinal.aleph0 ≤ κ) :
    IsFiltered (CardinalGeneratedQuasicoherentSubobject F κ) := by
  classical
  let P := cardinalGeneratedQuasicoherentSubobjectProperty F κ
  have hone : (1 : Cardinal.{u}) ≤ κ := Cardinal.one_le_aleph0.trans hκ
  refine { cocone_objs := ?_, cocone_maps := ?_, nonempty := ?_ }
  · intro A B
    let : (A.1 : X.Modules).IsQuasicoherent := A.2.1
    let : (B.1 : X.Modules).IsQuasicoherent := B.2.1
    let : Preadditive X.Modules := inferInstance
    let : HasBinaryProducts X.Modules := inferInstance
    let : HasBinaryBiproducts X.Modules := HasBinaryBiproducts.of_hasBinaryProducts
    let : HasBinaryProduct (A.1 : X.Modules) (B.1 : X.Modules) := inferInstance
    let : HasBinaryBiproduct (A.1 : X.Modules) (B.1 : X.Modules) :=
      HasBinaryBiproduct.of_hasBinaryProduct _ _
    have hsumqc : ((A.1 : X.Modules) ⊞ (B.1 : X.Modules)).IsQuasicoherent :=
      directSum_isQuasicoherent X.ringCatSheaf (A.1 : X.Modules) (B.1 : X.Modules)
    let : ((A.1 : X.Modules) ⊞ (B.1 : X.Modules)).IsQuasicoherent := hsumqc
    let S : X.Modules := (A.1 : X.Modules) ⊞ (B.1 : X.Modules)
    have hsumgen : IsCardinalGenerated.{u, u, u} S κ :=
      isCardinalGenerated_biprod X (A.1 : X.Modules) (B.1 : X.Modules) hκ A.2.2 B.2.2
    let f : S ⟶ F := biprod.desc A.1.arrow B.1.arrow
    let I : Subobject F := imageSubobject f
    have hI : P I := property_imageSubobject f hsumgen
    have hA : A.1 ≤ I := by
      apply Subobject.le_of_comm (biprod.inl ≫ factorThruImageSubobject f)
      change (biprod.inl ≫ factorThruImageSubobject f) ≫ I.arrow = A.1.arrow
      rw [Category.assoc, imageSubobject_arrow_comp]
      simp [f]
    have hB : B.1 ≤ I := by
      apply Subobject.le_of_comm (biprod.inr ≫ factorThruImageSubobject f)
      change (biprod.inr ≫ factorThruImageSubobject f) ≫ I.arrow = B.1.arrow
      rw [Category.assoc, imageSubobject_arrow_comp]
      simp [f]
    exact ⟨⟨I, hI⟩, P.homMk (homOfLE hA), P.homMk (homOfLE hB), trivial⟩
  · intro A B f g
    refine ⟨B, 𝟙 B, ?_⟩
    simp only [Category.comp_id]
    apply P.hom_ext
    exact Subsingleton.elim _ _
  · let O : X.Modules := SheafOfModules.unit X.ringCatSheaf
    let : O.IsQuasicoherent := inferInstance
    let f : O ⟶ F := Zero.zero
    exact ⟨⟨_, property_imageSubobject f (isCardinalGenerated_unit X hone)⟩⟩


end Scheme

end Stacks.AlgebraicGeometry.CardinalGeneration

end
