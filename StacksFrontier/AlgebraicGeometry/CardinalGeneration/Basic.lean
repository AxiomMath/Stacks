/-!
# Cardinally generated quasi-coherent subobjects of a module on a scheme

Gabber's theorem states that on every scheme `X` there is a cardinal, depending only on `X`,
such that every quasi-coherent `𝒪_X`-module is the directed colimit of its quasi-coherent
submodules generated by at most that cardinal many local sections. This file defines that
cardinal, the category of such submodules of a module `F` and its canonical cocone with vertex
`F`, and proves the bounds on the cardinal and the facts about `𝒪_X`-modules the theorem uses.

## Main definitions

* `IsCardinalGenerated M κ`: the sheaf of modules `M` has local generating families indexed by
  types of cardinality at most `κ`.
* `cardinalBound X`: the cardinal attached to the scheme `X`, namely `X.size`.
* `cardinalGeneratedQuasicoherentSubobjectProperty F κ`: the property of a subobject of `F` of
  being quasi-coherent and `κ`-generated.
* `CardinalGeneratedQuasicoherentSubobject F κ`,
  `cardinalGeneratedQuasicoherentSubobjectFunctor F κ` and
  `cardinalGeneratedQuasicoherentSubobjectCocone F κ`: the category of such subobjects, the
  diagram they form inside `X.Modules`, and its canonical cocone with vertex `F`.
* `asSheaf M`: the underlying sheaf of abelian groups of an `𝒪_X`-module, as a `TopCat.Sheaf`.

## Main results

* `aleph0_le_cardinalBound`, `mk_affineOpens_le_cardinalBound` and
  `mk_sections_le_cardinalBound`: the bound `cardinalBound X` is infinite, it dominates the
  number of affine opens of `X`, and it dominates the cardinality of the ring of sections over
  each affine open.
* `injective_app_of_mono`: a monomorphism of `𝒪_X`-modules is injective on sections.
* `isIso_of_mono_of_locallySurjective`: a monomorphism of `𝒪_X`-modules which, around every
  point, is surjective on sections over some smaller open, is an isomorphism.
* `flat_presheaf_map_of_isAffineOpen`: restriction of sections of the structure sheaf between
  two affine opens is a flat ring map.
* `hasColimitsOfShape_cardinalGeneratedQuasicoherentSubobject`: the diagram of cardinally
  generated quasi-coherent subobjects has a colimit in `X.Modules`.

## References

* [Stacks Project, Tag 077N](https://stacks.math.columbia.edu/tag/077N)
* [Stacks Project, Tag 077L](https://stacks.math.columbia.edu/tag/077L)
* [Stacks Project, Tag 000I](https://stacks.math.columbia.edu/tag/000I)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite AlgebraicGeometry

universe u v u'

namespace Stacks.AlgebraicGeometry.CardinalGeneration

export SheafOfModules (IsCardinalGenerated)

/-- The cardinal attached to a scheme `X` in Gabber's theorem: the size `X.size` of `X`. -/
@[stacks 077N "cardinal"]
public def cardinalBound (X : Scheme.{u}) : Cardinal.{u} := X.size

/-- The cardinal bound of a scheme is infinite. -/
public theorem aleph0_le_cardinalBound (X : Scheme.{u}) :
    Cardinal.aleph0 ≤ cardinalBound X :=
  X.aleph0_le_size

/-- The cardinal bound of a scheme dominates the number of its affine opens. -/
public theorem mk_affineOpens_le_cardinalBound (X : Scheme.{u}) :
    Cardinal.mk X.affineOpens ≤ cardinalBound X :=
  X.mk_affineOpens_le_size

/-- The cardinal bound of a scheme dominates the cardinality of the ring of sections over any
of its affine opens. -/
public theorem mk_sections_le_cardinalBound (X : Scheme.{u}) (U : X.affineOpens) :
    Cardinal.mk Γ(X, U.1) ≤ cardinalBound X :=
  X.mk_sections_le_size U

/-- The property that a subobject of an `𝒪_X`-module is quasi-coherent and generated by at most
`κ` local generators. -/
public def cardinalGeneratedQuasicoherentSubobjectProperty {X : Scheme.{u}} (F : X.Modules)
    (κ : Cardinal.{u}) : ObjectProperty (Subobject F) :=
  fun G => (G : X.Modules).IsQuasicoherent ∧ IsCardinalGenerated (G : X.Modules) κ

/-- The category of quasi-coherent, `κ`-generated subobjects of `F`. -/
public abbrev CardinalGeneratedQuasicoherentSubobject {X : Scheme.{u}} (F : X.Modules)
    (κ : Cardinal.{u}) :=
  (cardinalGeneratedQuasicoherentSubobjectProperty F κ).FullSubcategory

/-- The diagram of all quasi-coherent, `κ`-generated subobjects of `F`. -/
public def cardinalGeneratedQuasicoherentSubobjectFunctor {X : Scheme.{u}} (F : X.Modules)
    (κ : Cardinal.{u}) : CardinalGeneratedQuasicoherentSubobject F κ ⥤ X.Modules :=
  (cardinalGeneratedQuasicoherentSubobjectProperty F κ).ι ⋙ Subobject.underlying

/-- The canonical cocone from all quasi-coherent, `κ`-generated subobjects of `F` to `F`. -/
public def cardinalGeneratedQuasicoherentSubobjectCocone {X : Scheme.{u}} (F : X.Modules)
    (κ : Cardinal.{u}) : Cocone (cardinalGeneratedQuasicoherentSubobjectFunctor F κ) :=
  Cocone.mk F
    { app := fun G => G.obj.arrow
      naturality := fun {G H} f => by
        exact Subobject.underlying_arrow f.hom }

variable {X : Scheme.{u}}

/-- The diagram of cardinally generated quasi-coherent subobjects is essentially small. -/
public instance essentiallySmall_cardinalGeneratedQuasicoherentSubobject (F : X.Modules)
    (κ : Cardinal.{u}) : EssentiallySmall.{u} (CardinalGeneratedQuasicoherentSubobject F κ) :=
  inferInstance

/-- The diagram of cardinally generated quasi-coherent subobjects of `F` has a colimit in
`X.Modules`. -/
public theorem hasColimitsOfShape_cardinalGeneratedQuasicoherentSubobject (F : X.Modules)
    (κ : Cardinal.{u}) :
    HasColimitsOfShape (CardinalGeneratedQuasicoherentSubobject F κ) X.Modules :=
  hasColimitsOfShape_of_essentiallySmall _ _

/-- The underlying sheaf of abelian groups of an `𝒪_X`-module, packaged as a `TopCat.Sheaf` so
that the unique-gluing API applies to it. -/
public abbrev asSheaf (M : X.Modules) : TopCat.Sheaf Ab X := ⟨M.presheaf, M.isSheaf⟩

/-- A monomorphism of `𝒪_X`-modules is injective on sections over every open. -/
public theorem injective_app_of_mono {M N : X.Modules} (f : M ⟶ N) [Mono f] (U : X.Opens) :
    Function.Injective (f.app U) := by
  have := Functor.map_mono (Scheme.Modules.toPresheaf X) f
  exact (AddCommGrpCat.mono_iff_injective _).mp
    (inferInstanceAs (Mono (((Scheme.Modules.toPresheaf X).map f).app (op U))))

/-- A morphism of `𝒪_X`-modules commutes with restriction of sections. -/
public theorem app_map {M N : X.Modules} (f : M ⟶ N) {U V : X.Opens} (i : V ⟶ U) (t : Γ(M, U)) :
    f.app V (M.presheaf.map i.op t) = N.presheaf.map i.op (f.app U t) :=
  congr($(f.mapPresheaf.naturality i.op) t)

/-- A monomorphism `f : M ⟶ N` of `𝒪_X`-modules is an isomorphism if every section of `N` over
an open `U` is, in a neighbourhood of each point of `U`, the image of a section of `M`. -/
public theorem isIso_of_mono_of_locallySurjective {M N : X.Modules} (f : M ⟶ N) [Mono f]
    (h : ∀ (U : X.Opens) (s : Γ(N, U)) (x : X), x ∈ U →
      ∃ V : X.Opens, ∃ hVU : V ≤ U, x ∈ V ∧
        N.presheaf.map (homOfLE hVU).op s ∈ Set.range (f.app V)) :
    IsIso f := by
  rw [Scheme.Modules.Hom.isIso_iff_isIso_app]
  intro U
  refine (ConcreteCategory.isIso_iff_bijective _).mpr ⟨injective_app_of_mono f U, ?_⟩
  intro s
  choose V hVU hxV hmem using fun (x : {x : X // x ∈ U}) => h U s x.1 x.2
  choose t hts using hmem
  have hcover : U ≤ iSup V := fun x hx => Opens.mem_iSup.mpr ⟨⟨x, hx⟩, hxV ⟨x, hx⟩⟩
  have hc : TopCat.Presheaf.IsCompatible M.presheaf V t := by
    intro i j
    apply injective_app_of_mono f (V i ⊓ V j)
    rw [app_map, app_map, hts i, hts j, ← ConcreteCategory.comp_apply,
      ← ConcreteCategory.comp_apply, ← N.presheaf.map_comp, ← N.presheaf.map_comp]
    rfl
  obtain ⟨w, hw, -⟩ :=
    (asSheaf M).existsUnique_gluing' V U (fun i => homOfLE (hVU i)) hcover t hc
  have hw' : ∀ i, M.presheaf.map (homOfLE (hVU i)).op w = t i := hw
  refine ⟨w, ?_⟩
  apply (asSheaf N).eq_of_locally_eq' V U (fun i => homOfLE (hVU i)) hcover
  intro i
  show N.presheaf.map (homOfLE (hVU i)).op (f.app U w) =
    N.presheaf.map (homOfLE (hVU i)).op s
  rw [← app_map, hw' i, hts i]

/-- Restriction of sections of the structure sheaf between two affine opens is a flat ring
map. -/
public theorem flat_presheaf_map_of_isAffineOpen {U V : X.Opens} (hU : IsAffineOpen U)
    (hV : IsAffineOpen V) (h : V ≤ U) : (X.presheaf.map (homOfLE h).op).hom.Flat := by
  exact AlgebraicGeometry.Flat.flat_appLE (f := 𝟙 X) hU hV (by simpa using h)

end Stacks.AlgebraicGeometry.CardinalGeneration

end
