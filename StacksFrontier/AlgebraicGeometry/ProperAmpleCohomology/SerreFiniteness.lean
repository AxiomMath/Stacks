/-! ### Degree zero acting on the section ring -/

/-- **A global function scales a homogeneous element of the section ring by multiplication.**
The degree-zero inclusion of `Stacks.SectionRingZero.sectionRingZeroHom` lands on the right of
the product because `Stacks.GradedSections.mul s t` is `t ≫ mulMap s m`: in degrees `q` and `0`
that composite is exactly precomposition with the scalar endomorphism of the monoidal unit, with
`q + 0 = q` on the nose. -/
theorem of_smul_powSections {X : Scheme.{u}} (L : X.Modules)
    [Stacks.Ample.IsInvertibleModule X L] (q : ℕ) (x : Γ(X, ⊤)) (u : powSections L q) :
    DirectSum.of (powSections L) q (x • u) =
      DirectSum.of (powSections L) q u * sectionRingZeroHom X L x :=
  (show DirectSum.of (powSections L) q u * sectionRingZeroHom X L x =
    DirectSum.of (powSections L) q (x • u) from DirectSum.of_mul_of _ _).symm

/-! ### The graded module engine -/

/-- **The graded module engine.** Let `ℒ` be invertible and let `𝒢` be any `𝒪_X`-module. If every
degree-`p` piece of `Γ_*(X, 𝒢, ℒ)` is spanned over the global functions by a finite set, and if
there are `m₀`, `r`, `N` and sections `s₁, …, s_r` of `𝒢 ⊗ ℒ ^⊗ m₀` with every section of
`𝒢 ⊗ ℒ ^⊗ (m₀ + n)` for `n ≥ N` a combination `∑ⱼ aⱼ · sⱼ` with `aⱼ` a section of `ℒ ^⊗ n`, then
`Γ_*(X, 𝒢, ℒ)` is a finite module over the section ring `Γ_*(X, ℒ)`.

The generating set is the union of the images of the given finite sets in the finitely many
degrees below `m₀ + N` together with the `sⱼ`. No induction on the degree is needed: a span over
the section ring already absorbs the coefficients `aⱼ`. -/
theorem moduleFinite_twistModule_of_gen {X : Scheme.{u}} (G L : X.Modules)
    [Stacks.Ample.IsInvertibleModule X L]
    (hfin : ∀ p : ℕ, ∃ t : Finset (twistSections G L p),
      Submodule.span Γ(X, ⊤) (t : Set (twistSections G L p)) = ⊤)
    (m₀ r N : ℕ) (s : Fin r → twistSections G L m₀)
    (hgen : ∀ n : ℕ, N ≤ n → ∀ u : twistSections G L (m₀ + n),
      ∃ a : Fin r → powSections L n, u = ∑ j, (a j ≫ actMap (s j) n)) :
    Module.Finite (sectionRing L) (twistModule G L) := by
  classical
  choose gen hgenspan using hfin
  let T : Finset (twistModule G L) :=
    (Finset.univ.image fun j : Fin r => DirectSum.of (twistSections G L) m₀ (s j)) ∪
      (Finset.range (m₀ + N)).biUnion fun p =>
        (gen p).image (DirectSum.of (twistSections G L) p)
  have hsT : ∀ j : Fin r, DirectSum.of (twistSections G L) m₀ (s j) ∈ T := fun j =>
    Finset.mem_union_left _ (Finset.mem_image_of_mem _ (Finset.mem_univ j))
  have hgT : ∀ p, p < m₀ + N → ∀ y ∈ gen p,
      DirectSum.of (twistSections G L) p y ∈ T := fun p hp y hy =>
    Finset.mem_union_right _
      (Finset.mem_biUnion.mpr ⟨p, Finset.mem_range.mpr hp, Finset.mem_image_of_mem _ hy⟩)
  have key : ∀ p : ℕ, ∀ u : twistSections G L p, DirectSum.of (twistSections G L) p u ∈
      Submodule.span (sectionRing L) (T : Set (twistModule G L)) := by
    intro p
    rcases lt_or_ge p (m₀ + N) with hp | hp
    · intro u
      refine Submodule.span_mono ?_ (of_mem_span L (gen p : Set (twistSections G L p))
        (by rw [hgenspan p]; trivial))
      rintro _ ⟨y, hy, rfl⟩
      exact hgT p hp y hy
    · obtain ⟨n, rfl⟩ := Nat.le.dest (Nat.le_trans (Nat.le_add_right m₀ N) hp)
      have hn : N ≤ n := by omega
      intro u
      obtain ⟨a, ha⟩ := hgen n hn u
      rw [ha, map_sum]
      refine Submodule.sum_mem _ fun j _ => ?_
      have h1 : DirectSum.of (twistSections G L) (m₀ + n) (a j ≫ actMap (s j) n) =
          DirectSum.of (powSections L) n (a j) • DirectSum.of (twistSections G L) m₀ (s j) := by
        rw [of_smul_of]
        exact DirectSum.of_eq_of_gradedMonoid_eq (mk_eq (Nat.add_comm m₀ n) _)
      rw [h1]
      exact Submodule.smul_mem _ _ (Submodule.subset_span (hsT j))
  have main : ∀ z : twistModule G L,
      z ∈ Submodule.span (sectionRing L) (T : Set (twistModule G L)) := by
    intro z
    induction z using DirectSum.induction_on with
    | zero => exact Submodule.zero_mem _
    | of p u => exact key p u
    | add x y hx hy => exact Submodule.add_mem _ hx hy
  exact Module.finite_def.mpr ⟨T, eq_top_iff.mpr fun z _ => main z⟩

/-! ### The graded algebra engine -/

/-- **The graded algebra engine.** Let `ℒ` be invertible and let `φ : R →+* Γ(X, ⊤)` present the
global functions as an `R`-algebra. If every degree-`q` piece of the section ring is spanned over
`R` by a finite set `gen q`, and if there are `m ≥ 1`, `r`, `N` and sections `s₁, …, s_r` of
`ℒ ^⊗ m` with every section of `ℒ ^⊗ (m + n)` for `n ≥ N` a combination `∑ⱼ sⱼ · aⱼ` with `aⱼ` a
section of `ℒ ^⊗ n`, then `Γ_*(X, ℒ)` is a finitely generated `R`-algebra.

The generating set is the union of the images of the `gen q` for `q < m + N` with the `sⱼ`.
Unlike the module engine this needs a strong induction on the degree, because a subalgebra is not
an ideal: the coefficients `aⱼ`, of degree `n = q - m`, must be exhibited as polynomials in the
generators, and `1 ≤ m` is exactly what makes `n < q`. -/
theorem ringHomFiniteType_of_gen {X : Scheme.{u}} {R : Type u} [CommRing R] (L : X.Modules)
    [Stacks.Ample.IsInvertibleModule X L] (φ : R →+* Γ(X, ⊤))
    (gen : (q : ℕ) → Finset (powSections L q))
    (hgen0 : ∀ (q : ℕ) (u : powSections L q),
      ∃ c : powSections L q → R, u = ∑ y ∈ gen q, φ (c y) • y)
    (m r N : ℕ) (hm : 1 ≤ m) (s : Fin r → powSections L m)
    (hgen : ∀ n : ℕ, N ≤ n → ∀ u : powSections L (m + n),
      ∃ a : Fin r → powSections L n, u = ∑ j, mul (s j) (a j)) :
    letI := Stacks.SectionRingGeometric.schemeSectionCommRing X L
    RingHom.FiniteType ((sectionRingZeroHom X L).comp φ) := by
  show RingHom.FiniteType ((sectionRingZeroHom X L).comp φ)
  classical
  let : Algebra R (sectionRing L) := ((sectionRingZeroHom X L).comp φ).toAlgebra
  have halg : ∀ a : R, algebraMap R (sectionRing L) a = sectionRingZeroHom X L (φ a) :=
    fun _ => rfl
  let T : Finset (sectionRing L) :=
    (Finset.univ.image fun j : Fin r => DirectSum.of (powSections L) m (s j)) ∪
      (Finset.range (m + N)).biUnion fun q => (gen q).image (DirectSum.of (powSections L) q)
  have hsT : ∀ j : Fin r, DirectSum.of (powSections L) m (s j) ∈ T := fun j =>
    Finset.mem_union_left _ (Finset.mem_image_of_mem _ (Finset.mem_univ j))
  have hgT : ∀ q, q < m + N → ∀ y ∈ gen q, DirectSum.of (powSections L) q y ∈ T :=
    fun q hq y hy => Finset.mem_union_right _
      (Finset.mem_biUnion.mpr ⟨q, Finset.mem_range.mpr hq, Finset.mem_image_of_mem _ hy⟩)
  have key : ∀ q : ℕ, ∀ u : powSections L q,
      DirectSum.of (powSections L) q u ∈ Algebra.adjoin R (T : Set (sectionRing L)) := by
    intro q
    induction q using Nat.strong_induction_on with
    | _ q ih =>
      rcases lt_or_ge q (m + N) with hq | hq
      · intro u
        obtain ⟨c, hc⟩ := hgen0 q u
        rw [hc, map_sum]
        refine Subalgebra.sum_mem _ fun y hy => ?_
        rw [of_smul_powSections L q (φ (c y)) y, ← halg]
        exact mul_mem (Algebra.subset_adjoin (hgT q hq y hy))
          (Subalgebra.algebraMap_mem _ (c y))
      · obtain ⟨n, rfl⟩ := Nat.le.dest (Nat.le_trans (Nat.le_add_right m N) hq)
        intro u
        obtain ⟨a, ha⟩ := hgen n (by omega) u
        rw [ha, map_sum]
        refine Subalgebra.sum_mem _ fun j _ => ?_
        rw [show DirectSum.of (powSections L) (m + n) (mul (s j) (a j)) =
            DirectSum.of (powSections L) m (s j) * DirectSum.of (powSections L) n (a j) from
          (DirectSum.of_mul_of _ _).symm]
        exact mul_mem (Algebra.subset_adjoin (hsT j)) (ih n (by omega) (a j))
  refine ⟨⟨T, Algebra.eq_top_iff.mpr fun z => ?_⟩⟩
  induction z using DirectSum.induction_on with
  | zero => exact zero_mem _
  | of q u => exact key q u
  | add x y hx hy => exact add_mem hx hy

/-! ### Finiteness of the global sections over the base ring -/

/-- **The global sections of a coherent module are spanned over the base ring by a finite set.**
This is [Stacks, Tag 02O6] — clause (3) of [Stacks, Tag 0B5T] — transported along the comparison
of `H⁰(X, 𝒩)` with the morphisms out of the monoidal unit, and then read as an explicit finite
`R`-combination; unlike `Stacks.SectionRingZero.moduleFinite_unitHom`, the coefficients lie in
`R` rather than in the global functions `Γ(X, ⊤)`. -/
theorem exists_finset_eq_sum_base {X : Scheme.{u}} {R : Type u} [CommRing R]
    [IsNoetherianRing R] (f : X ⟶ Spec (CommRingCat.of R)) [IsProper f] (N : X.Modules)
    [_root_.SheafOfModules.IsCoherent N] :
    ∃ t : Finset (𝟙_ X.Modules ⟶ N), ∀ u : 𝟙_ X.Modules ⟶ N,
      ∃ c : (𝟙_ X.Modules ⟶ N) → R, u = ∑ y ∈ t, specAlgebraRingHom R f (c y) • y := by
  classical
  let : Module R (cohomologyOf X 0 N) := Module.compHom _ (specAlgebraRingHom R f)
  have : Module.Finite R (cohomologyOf X 0 N) :=
    moduleFinite_cohomology_of_isProper f N 0
  let : Module R (𝟙_ X.Modules ⟶ N) := Module.compHom _ (specAlgebraRingHom R f)
  have e : ↥(cohomologyOf X 0 N) ≃ₗ[R] (𝟙_ X.Modules ⟶ N) :=
    let eΓ : ↥(cohomologyOf X 0 N) ≃ₗ[Γ(X, ⊤)] (𝟙_ X.Modules ⟶ N) :=
      (((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerivedZeroIsoSelf.app
        N).toLinearEquiv).trans (schemeGlobalSectionsLinearEquiv X N).symm
    { toFun := eΓ
      map_add' := eΓ.map_add
      map_smul' := fun a x => eΓ.map_smul (specAlgebraRingHom R f a) x
      invFun := eΓ.symm
      left_inv := eΓ.left_inv
      right_inv := eΓ.right_inv }
  have : Module.Finite R (𝟙_ X.Modules ⟶ N) := Module.Finite.equiv e
  obtain ⟨t, ht⟩ :=
    Module.finite_def.mp (inferInstance : Module.Finite R (𝟙_ X.Modules ⟶ N))
  refine ⟨t, fun u => ?_⟩
  obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.mp
    (show u ∈ Submodule.span R (t : Set (𝟙_ X.Modules ⟶ N)) by rw [ht]; trivial)
  exact ⟨c, hc.symm⟩

/-- **A scheme proper over a Noetherian ring is locally Noetherian.** -/
private theorem isLocallyNoetherian_of_isProper {X : Scheme.{u}} {R : Type u} [CommRing R]
    [IsNoetherianRing R] (f : X ⟶ Spec (CommRingCat.of R)) [IsProper f] :
    IsLocallyNoetherian X :=
  have : IsLocallyNoetherian (Spec (CommRingCat.of R)) :=
    AlgebraicGeometry.isLocallyNoetherian_Spec.mpr inferInstance
  AlgebraicGeometry.LocallyOfFiniteType.isLocallyNoetherian f

/-! ### Clause (5) -/

/-- **Clause (5) of [Stacks, Tag 0B5T] in the untwisted case `k = 0`.** For `R` Noetherian,
`f : X ⟶ Spec R` proper, `ℒ` ample invertible and `𝒢` coherent, the graded module
`Γ_*(X, 𝒢, ℒ) = ⨁_{d ≥ 0} H⁰(X, 𝒢 ⊗ ℒ ^⊗ d)` is a finite module over the section ring
`Γ_*(X, ℒ)`.

This is the graded module engine fed with the Serre bootstrap
`exists_forall_twistSections_eq_sum` and, in each degree, with clause (3) in degree zero
(`Stacks.SectionRingZero.exists_finset_span_eq_top` at the coherent module `𝒢 ⊗ ℒ ^⊗ p`). -/
theorem moduleFinite_twistModule_of_isCoherent {X : Scheme.{u}} {R : Type u} [CommRing R]
    [IsNoetherianRing R] (f : X ⟶ Spec (CommRingCat.of R)) [IsProper f] (G L : X.Modules)
    [_root_.SheafOfModules.IsCoherent G] [Stacks.Ample.IsInvertibleModule X L]
    (hL : Stacks.Ample.IsAmple X L) :
    letI := Stacks.SectionRingGeometric.schemeSectionCommRing X L
    Module.Finite (sectionRing L) (twistModule G L) := by
  show Module.Finite (sectionRing L) (twistModule G L)
  have := isLocallyNoetherian_of_isProper f
  obtain ⟨m₀, r, N, s, hs⟩ := exists_forall_twistSections_eq_sum f G L hL
  refine moduleFinite_twistModule_of_gen G L (fun p => ?_) m₀ r N s hs
  have := isCoherent_twistPow G L inferInstance p
  exact exists_finset_span_eq_top f (twistPow G L p)

/-- **Clause (5) of [Stacks, Tag 0B5T].** For `R` Noetherian, `f : X ⟶ Spec R` proper, `ℒ` ample
invertible, `ℱ` coherent and `k` an arbitrary integer, the graded module
`⨁_{d ≥ k} H⁰(X, ℱ ⊗ ℒ ^⊗ d)` is a finite module over `A = Γ_*(X, ℒ)`.

The source's module is spelled here as `Γ_*(X, ℱ ⊗ ℒ ^⊗ k, ℒ)`: its degree-`m` piece is
`H⁰(X, (ℱ ⊗ ℒ ^⊗ k) ⊗ ℒ ^⊗ m) = H⁰(X, ℱ ⊗ ℒ ^⊗ d)` at `d = k + m`, so as `m` runs over the
nonnegative integers `d` runs over the integers `≥ k`, which is the source's index set. -/
theorem moduleFinite_twistModule {X : Scheme.{u}} {R : Type u} [CommRing R] [IsNoetherianRing R]
    (f : X ⟶ Spec (CommRingCat.of R)) [IsProper f] (F L : X.Modules)
    [_root_.SheafOfModules.IsCoherent F] [Stacks.Ample.IsInvertibleModule X L]
    (hL : Stacks.Ample.IsAmple X L) (k : ℤ) :
    letI := Stacks.SectionRingGeometric.schemeSectionCommRing X L
    Module.Finite (sectionRing L)
      (twistModule (F ⊗ Stacks.Ample.tensorPowModule X L k) L) := by
  show Module.Finite (sectionRing L) (twistModule (F ⊗ Stacks.Ample.tensorPowModule X L k) L)
  have := isLocallyNoetherian_of_isProper f
  have : (F ⊗ Stacks.Ample.tensorPowModule X L k).IsCoherent :=
    isCoherent_tensorObj F (Stacks.Ample.tensorPowModule X L k) inferInstance
  exact moduleFinite_twistModule_of_isCoherent f _ L hL

/-! ### Clause (1) -/

/-- **Clause (1) of [Stacks, Tag 0B5T].** For `R` Noetherian, `f : X ⟶ Spec R` proper and `ℒ` an
ample invertible `𝒪_X`-module, the graded ring `A = Γ_*(X, ℒ) = ⨁_{d ≥ 0} H⁰(X, ℒ ^⊗ d)` is a
finitely generated `R`-algebra, the structure map being the degree-zero inclusion
`Stacks.SectionRingZero.sectionRingZeroHom` precomposed with the ring map
`R →+* Γ(X, ⊤)` that `f` induces on global functions.

The Serre bootstrap is applied at `𝒢 = ℒ`, not at `𝒢 = 𝒪_X`: it produces sections of
`𝒢 ⊗ ℒ ^⊗ m₀`, and the strong induction of the algebra engine terminates only in a degree
`≥ 1`, which `1 + m₀` is and `m₀` need not be. The bootstrap's `actMap` is converted into the
product of the section ring by `actMap_eq_mulMap`. -/
theorem ringHomFiniteType_sectionRing {X : Scheme.{u}} {R : Type u} [CommRing R]
    [IsNoetherianRing R] (f : X ⟶ Spec (CommRingCat.of R)) [IsProper f] (L : X.Modules)
    [Stacks.Ample.IsInvertibleModule X L] (hL : Stacks.Ample.IsAmple X L) :
    letI := Stacks.SectionRingGeometric.schemeSectionCommRing X L
    RingHom.FiniteType
      ((sectionRingZeroHom X L).comp
        (Stacks.AlgebraicGeometry.GradedProperCohomology.specAlgebraRingHom R f)) := by
  show RingHom.FiniteType ((sectionRingZeroHom X L).comp (specAlgebraRingHom R f))
  classical
  have := isLocallyNoetherian_of_isProper f
  have hcoh : ∀ q : ℕ, (natTensorPow L q).IsCoherent := by
    intro q
    rw [← Stacks.SectionRingProjTheta.twistPow_unit L q]
    exact isCoherent_twistPow (𝟙_ X.Modules) L (isCoherent_tensorUnit X) q
  have hfin : ∀ q : ℕ, ∃ t : Finset (powSections L q), ∀ u : powSections L q,
      ∃ c : powSections L q → R, u = ∑ y ∈ t, specAlgebraRingHom R f (c y) • y := by
    intro q
    have := hcoh q
    exact exists_finset_eq_sum_base f (natTensorPow L q)
  choose gen hgen0 using hfin
  have := hcoh 1
  obtain ⟨m₀, r, N, s, hs⟩ := exists_forall_twistSections_eq_sum f (natTensorPow L 1) L hL
  refine ringHomFiniteType_of_gen L (specAlgebraRingHom R f) gen hgen0 (1 + m₀) r N
    (Nat.le_add_right 1 m₀) (fun j => s j ≫ eqToHom (twistPow_natTensorPow L 1 m₀)) ?_
  intro n hn u
  have he : natTensorPow L (1 + m₀ + n) = twistPow (natTensorPow L 1) L (m₀ + n) :=
    (congrArg (natTensorPow L) (Nat.add_assoc 1 m₀ n)).trans
      (twistPow_natTensorPow L 1 (m₀ + n)).symm
  obtain ⟨a, ha⟩ := hs n hn (u ≫ eqToHom he)
  refine ⟨a, ?_⟩
  have hu : u = (u ≫ eqToHom he) ≫ eqToHom he.symm := by simp
  rw [hu, ha, Preadditive.sum_comp]
  refine Finset.sum_congr rfl fun j _ => ?_
  rw [mul_def, Category.assoc, actMap_eq_mulMap]
  simp

end Scheme

end Stacks.AlgebraicGeometry.ProperAmpleCohomology

