/-! ### The bridge between twisting a tensor power and multiplying in the section ring -/

section Monoidal

variable {C : Type u} [Category.{v} C] [MonoidalCategory C]

/-- **Twisting a tensor power is a tensor power.** `(L ^⊗ k) ⊙ m = L ^⊗ (k + m)`, by the same
recursion on `m` on both sides. -/
theorem twistPow_natTensorPow (L : C) (k m : ℕ) :
    twistPow (natTensorPow L k) L m = natTensorPow L (k + m) := by
  induction m with
  | zero => rfl
  | succ m ih => exact congrArg (· ⊗ L) ih

/-- **Acting by a twisted section of a tensor power is multiplying by a section of a tensor
power.** `Stacks.TwistedSections.actMap` and `Stacks.GradedSections.mulMap` are the same
right-whiskering recursion; this identifies them once the twisted module is recognised as a
tensor power by `twistPow_natTensorPow`. The transport is the reassociation
`(k + m) + n = k + (m + n)` composed with that recognition. -/
theorem actMap_eq_mulMap {L : C} {k m : ℕ} (t : twistSections (natTensorPow L k) L m) (n : ℕ) :
    actMap t n = mulMap (t ≫ eqToHom (twistPow_natTensorPow L k m)) n ≫
      eqToHom ((congrArg (natTensorPow L) (Nat.add_assoc k m n)).trans
        (twistPow_natTensorPow L k (m + n)).symm) := by
  induction n with
  | zero =>
      show t = (t ≫ eqToHom (twistPow_natTensorPow L k m)) ≫
        eqToHom (twistPow_natTensorPow L k m).symm
      simp
  | succ n ih =>
      rw [actMap_succ, ih, mulMap_succ, comp_whiskerRight, eqToHom_whiskerRight]
      rfl

end Monoidal

