/-! ### The global functions as endomorphisms of the monoidal unit -/

section UnitScalar

variable (X : Scheme.{u})

/-- **The scalar of the endomorphism named by a global function is that function.** This is
`Stacks.SectionRingGeometric.unitScalarAddEquiv` undone in one direction, written at
`Stacks.SectionRingGeometric.unitScalar` so that `Stacks.SectionRingGeometric.unitScalar_comp`
and `Stacks.SectionRingGeometric.globalSection_unitComp` can be rewritten with it. -/
theorem unitScalar_unitScalarAddEquiv_symm (x : Γ(X, ⊤)) :
    unitScalar X ((unitScalarAddEquiv X).symm x) = x :=
  (unitScalarAddEquiv X).apply_symm_apply x

/-- **The endomorphism named by a product is the composite of the endomorphisms.** The
multiplicative half of the unit-scalar comparison, read on the inverse bijection. -/
theorem unitScalarAddEquiv_symm_mul (x y : Γ(X, ⊤)) :
    (unitScalarAddEquiv X).symm (x * y) =
      (unitScalarAddEquiv X).symm x ≫ (unitScalarAddEquiv X).symm y := by
  refine (unitScalarAddEquiv X).symm_apply_eq.mpr ?_
  change x * y = unitScalar X (_ ≫ _)
  rw [unitScalar_comp, unitScalar_unitScalarAddEquiv_symm, unitScalar_unitScalarAddEquiv_symm]

/-- **The endomorphism named by `1` is the identity.** -/
theorem unitScalarAddEquiv_symm_one :
    (unitScalarAddEquiv X).symm 1 = 𝟙 (𝟙_ X.Modules) := by
  refine (unitScalarAddEquiv X).symm_apply_eq.mpr ?_
  change (1 : Γ(X, ⊤)) = unitScalar X (𝟙 (𝟙_ X.Modules))
  rw [unitScalar_id]

end UnitScalar

/-! ### Global functions acting on morphisms out of the monoidal unit -/

section UnitHom

variable (X : Scheme.{u}) (N : X.Modules)

/-- **A global function scales a morphism out of the monoidal unit** by precomposition with the
endomorphism of the unit that it names. -/
noncomputable instance unitHomSMul : SMul Γ(X, ⊤) (𝟙_ X.Modules ⟶ N) :=
  ⟨fun x t => (unitScalarAddEquiv X).symm x ≫ t⟩

variable {X N}

/-- Unfolding of the action of a global function on a morphism out of the monoidal unit. -/
theorem unitHom_smul_def (x : Γ(X, ⊤)) (t : 𝟙_ X.Modules ⟶ N) :
    x • t = (unitScalarAddEquiv X).symm x ≫ t :=
  rfl

variable (X N)

/-- **Morphisms out of the monoidal unit form a `Γ(X, ⊤)`-module.** The axioms are the
multiplicativity and additivity of the unit-scalar comparison together with preadditivity of
`X.Modules`. -/
noncomputable instance unitHomModule : Module Γ(X, ⊤) (𝟙_ X.Modules ⟶ N) where
  one_smul t := by
    rw [unitHom_smul_def, unitScalarAddEquiv_symm_one, Category.id_comp]
  mul_smul x y t := by
    rw [unitHom_smul_def, unitHom_smul_def, unitHom_smul_def, unitScalarAddEquiv_symm_mul,
      Category.assoc]
  smul_zero x := by
    rw [unitHom_smul_def, Limits.comp_zero]
  smul_add x t t' := by
    rw [unitHom_smul_def, unitHom_smul_def, unitHom_smul_def, Preadditive.comp_add]
  add_smul x y t := by
    rw [unitHom_smul_def, unitHom_smul_def, unitHom_smul_def, map_add, Preadditive.add_comp]
  zero_smul t := by
    rw [unitHom_smul_def, map_zero, Limits.zero_comp]

/-- **The carrier comparison is `Γ(X, ⊤)`-linear.** `Γ(N, ⊤)` is the group of morphisms out of
the monoidal unit by `Stacks.SectionRingGeometric.schemeGlobalSectionsAddEquiv`, and the
identification carries the action above to the module structure that `N` has over the global
functions, by `Stacks.SectionRingGeometric.globalSection_unitComp`. -/
noncomputable def schemeGlobalSectionsLinearEquiv :
    (𝟙_ X.Modules ⟶ N) ≃ₗ[Γ(X, ⊤)] Γ(N, ⊤) where
  toFun := schemeGlobalSectionsAddEquiv X N
  map_add' := (schemeGlobalSectionsAddEquiv X N).map_add
  map_smul' x t := by
    change schemeGlobalSectionsAddEquiv X N ((unitScalarAddEquiv X).symm x ≫ t) =
      x • schemeGlobalSectionsAddEquiv X N t
    rw [globalSection_unitComp, unitScalar_unitScalarAddEquiv_symm]
  invFun := (schemeGlobalSectionsAddEquiv X N).symm
  left_inv := (schemeGlobalSectionsAddEquiv X N).left_inv
  right_inv := (schemeGlobalSectionsAddEquiv X N).right_inv

/-- The linear equivalence `schemeGlobalSectionsLinearEquiv X N` sends a morphism
`t : 𝟙_ X.Modules ⟶ N` to its image under `schemeGlobalSectionsAddEquiv X N`. -/
@[simp] theorem schemeGlobalSectionsLinearEquiv_apply (t : 𝟙_ X.Modules ⟶ N) :
    schemeGlobalSectionsLinearEquiv X N t = schemeGlobalSectionsAddEquiv X N t :=
  rfl

end UnitHom

/-! ### The degree-zero inclusion into the section ring -/

section SectionRingZeroHom

variable (X : Scheme.{u}) (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]

/-- **The degree-zero inclusion `Γ(X, ⊤) →+* Γ_*(X, L)`.** The degree-zero piece of the section
ring is the endomorphism group of the monoidal unit, which is the ring of global functions;
this is that identification followed by `DirectSum.of` in degree `0`. -/
noncomputable def sectionRingZeroHom : Γ(X, ⊤) →+* sectionRing L where
  toFun x := DirectSum.of (powSections L) 0 ((unitScalarAddEquiv X).symm x)
  map_one' := by rw [unitScalarAddEquiv_symm_one]; rfl
  map_mul' x y := by
    have h : (DirectSum.of (powSections L) 0 ((unitScalarAddEquiv X).symm x)) *
        (DirectSum.of (powSections L) 0 ((unitScalarAddEquiv X).symm y)) =
        DirectSum.of (powSections L) 0
          ((unitScalarAddEquiv X).symm y ≫ (unitScalarAddEquiv X).symm x) :=
      DirectSum.of_mul_of _ _
    rw [h, mul_comm x y, unitScalarAddEquiv_symm_mul]
  map_zero' := by rw [map_zero, map_zero]
  map_add' x y := by rw [map_add, map_add]

omit [Stacks.Ample.IsInvertibleModule X L] in
/-- The degree-zero inclusion sends a global function `x` to the degree-`0` element of the
section ring given by the endomorphism of the monoidal unit corresponding to `x`. -/
@[simp] theorem sectionRingZeroHom_apply (x : Γ(X, ⊤)) :
    sectionRingZeroHom X L x = DirectSum.of (powSections L) 0 ((unitScalarAddEquiv X).symm x) :=
  rfl

end SectionRingZeroHom

/-! ### The degree-zero action on twisted sections -/

section TwistedSections

open Stacks.TwistedSections

variable {X : Scheme.{u}} (L : X.Modules) [Stacks.Ample.IsInvertibleModule X L]
  {F : X.Modules} {p : ℕ}

/-- **The degree-zero compatibility.** The image of a global function under the degree-zero
inclusion acts on a homogeneous twisted section by the ordinary action of that function on
sections: no degree shift, and the result is the ordinary `Γ(X, ⊤)`-scalar multiple read through
the carrier comparison. -/
theorem of_zero_smul_of (x : Γ(X, ⊤)) (t : twistSections F L p) :
    sectionRingZeroHom X L x • DirectSum.of (twistSections F L) p t =
      DirectSum.of (twistSections F L) p (x • t) := by
  have h : DirectSum.of (twistSections F L) (0 + p)
      (gsmul ((unitScalarAddEquiv X).symm x) t) =
      DirectSum.of (twistSections F L) p ((unitScalarAddEquiv X).symm x ≫ t) :=
    DirectSum.of_eq_of_gradedMonoid_eq (mk_eq (Nat.add_comm p 0) _).symm
  rw [sectionRingZeroHom_apply, of_smul_of, h, unitHom_smul_def]

/-- **The degree-zero compatibility, read on global sections.** Writing both sides through the
carrier comparison, the scalar acting is the honest `Γ(X, ⊤)`-module structure on
`Γ(ℱ ⊗ L ^⊗ p, ⊤)`. -/
theorem of_zero_smul_of_globalSections (x : Γ(X, ⊤)) (s : Γ(twistPow F L p, ⊤)) :
    sectionRingZeroHom X L x •
        DirectSum.of (twistSections F L) p
          ((schemeGlobalSectionsLinearEquiv X (twistPow F L p)).symm s) =
      DirectSum.of (twistSections F L) p
        ((schemeGlobalSectionsLinearEquiv X (twistPow F L p)).symm (x • s)) := by
  rw [of_zero_smul_of]
  exact congrArg (DirectSum.of (twistSections F L) p)
    ((schemeGlobalSectionsLinearEquiv X (twistPow F L p)).symm.map_smul x s).symm

/-- **Spans in degree `p` go to spans in the graded module.** The `Γ(X, ⊤)`-submodule of the
degree-`p` twisted sections generated by a set `S` is carried by `DirectSum.of _ p` into the
`Γ_*(X, L)`-submodule of the graded module of twisted sections generated by the image of `S`. -/
theorem of_mem_span (S : Set (twistSections F L p)) {t : twistSections F L p}
    (ht : t ∈ Submodule.span Γ(X, ⊤) S) :
    DirectSum.of (twistSections F L) p t ∈
      Submodule.span (sectionRing L)
        (DirectSum.of (twistSections F L) p '' S) := by
  induction ht using Submodule.span_induction with
  | mem y hy => exact Submodule.subset_span ⟨y, hy, rfl⟩
  | zero => simp
  | add y z _ _ hy hz => rw [map_add]; exact Submodule.add_mem _ hy hz
  | smul a y _ hy =>
      rw [← of_zero_smul_of]
      exact Submodule.smul_mem _ _ hy

end TwistedSections

/-! ### Finiteness of the degree-`p` piece over the global functions -/

section Finiteness

variable {X : Scheme.{u}} {R : Type u} [CommRing R] [IsNoetherianRing R]

/-- **Each hom group out of the monoidal unit is a finite `Γ(X, ⊤)`-module**, for a coherent
module on a scheme proper over a Noetherian ring. This is clause (3) of [Stacks, Tag 0B5T] in
degree zero — `H⁰(X, N)` is a finite `R`-module, hence a finite `Γ(X, ⊤)`-module since the
`R`-action factors through `Γ(X, ⊤)` — transported along the carrier comparison
`schemeGlobalSectionsLinearEquiv`. -/
theorem moduleFinite_unitHom (f : X ⟶ Spec (CommRingCat.of R)) [IsProper f] (N : X.Modules)
    [_root_.SheafOfModules.IsCoherent N] :
    Module.Finite Γ(X, ⊤) (𝟙_ X.Modules ⟶ N) := by
  let : Module R (cohomologyOf X 0 N) := Module.compHom _ (specAlgebraRingHom R f)
  have : Module.Finite R (cohomologyOf X 0 N) :=
    Stacks.AlgebraicGeometry.ProperAmpleCohomology.moduleFinite_cohomology_of_isProper f N 0
  let : SMul R Γ(X, ⊤) := ⟨fun r a => specAlgebraRingHom R f r * a⟩
  have : IsScalarTower R Γ(X, ⊤) (cohomologyOf X 0 N) :=
    ⟨fun r a m => by
      change (specAlgebraRingHom R f r * a) • m = specAlgebraRingHom R f r • a • m
      rw [mul_smul]⟩
  have : Module.Finite Γ(X, ⊤) (cohomologyOf X 0 N) :=
    Module.Finite.of_restrictScalars_finite R Γ(X, ⊤) _
  exact Module.Finite.equiv
    ((((Stacks.Cohomology.AffineBase.moduleGlobalSections X).rightDerivedZeroIsoSelf.app
      N).toLinearEquiv).trans (schemeGlobalSectionsLinearEquiv X N).symm)

/-- **A finite spanning set**: under the hypotheses of `moduleFinite_unitHom`, there is a finite
set of morphisms out of the monoidal unit whose `Γ(X, ⊤)`-span is everything. -/
theorem exists_finset_span_eq_top (f : X ⟶ Spec (CommRingCat.of R)) [IsProper f]
    (N : X.Modules) [_root_.SheafOfModules.IsCoherent N] :
    ∃ s : Finset (𝟙_ X.Modules ⟶ N),
      Submodule.span Γ(X, ⊤) (s : Set (𝟙_ X.Modules ⟶ N)) = ⊤ :=
  have := moduleFinite_unitHom f N
  Module.finite_def.mp inferInstance

end Finiteness

end Stacks.SectionRingZero

