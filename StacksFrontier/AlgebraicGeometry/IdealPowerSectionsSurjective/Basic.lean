module

public import Mathlib.Algebra.Module.Torsion.Basic
public import StacksFrontier.AlgebraicGeometry.IdealPowerSectionsSurjective.Cross

/-!
# Surjectivity of the canonical map of Tag 01PM

Let `A` be a commutative ring, `I ⊆ A` a finitely generated ideal and `M` an `A`-module no
nonzero element of which is annihilated by `I`.  This file proves that
`Stacks.AlgebraicGeometry.IdealPowerSections.canonicalMapToSections`, the canonical map
`colim_n Hom_A(I ^ n, M) → Γ(Spec(A) \ V(I), M̃)`, is **surjective**, hence — with the injectivity
of `Stacks.AlgebraicGeometry.IdealPowerSections.canonicalMapToSections_injective` — bijective.
This is the third assertion of [Stacks, Tag 01PM] and the affine core of the surjectivity half
of [Stacks, Tag 01PQ], which is in turn the affine input to [Stacks, Tag 01YB].

## Main results

* `exists_sectionOfHom_eq`: every section of `M̃` away from `V(I)` is `sectionOfHom` of some
  representative, i.e. surjectivity in representative form.
* `canonicalMapToSections_surjective`, `canonicalMapToSections_bijective`.
* `sectionsLinearEquiv`: the resulting `A`-linear isomorphism
  `colim_n Hom_A(I ^ n, M) ≅ Γ(Spec(A) \ V(I), M̃)`.
* `isIso_canonicalMapToSections`: the same statement as an isomorphism in `ModuleCat A`, with the
  hypothesis phrased as the vanishing of `Submodule.torsionBySet A M I`.

## Implementation notes

The source's proof builds the representative on the ideal `I ^ (t(n-1)+1)` by a pigeonhole
argument on monomials in a generating set `f₁, …, f_t`, and verifies well-definedness by hand.
Neither step is needed here.  `exists_uniform_fractions` supplies one exponent `n` and numerators
`y f` with the **exact** cross relations `f' ^ n • y f = f ^ n • y f'`, and the representative is
then obtained on the ideal `J = (f₁ ^ n, …, f_t ^ n)` from the characterisation
`f ^ n • ψ b = b • y f`: existence of a value is `Submodule.span_induction` over `J`, and
uniqueness is the hypothesis on `M`, so additivity and `A`-linearity of `ψ` follow from
uniqueness rather than from a computation.  A power of `I` lands in `J` by
`Ideal.exists_pow_le_of_le_radical_of_fg`, so no explicit exponent appears.

The equality of sections is checked pointwise: `sectionOfHom` is by construction the dependent
function `fractionSectionFun`, whose value at a prime `p` may be computed with *any* element of
the ideal lying outside `p` (`fractionSectionFun_apply`), and a generator may always be chosen
there.  So the sheaf axiom is never invoked.

As in the files this builds on, `A : Type u` and `M : Type v` are independent universes and the
tilde sheaf is formed after lifting both to `Type (max u v)`; statements in `ULift M` are reduced
to statements in `M` by `ULift.ext`.

## References

* [Stacks Project, Tag 01PM](https://stacks.math.columbia.edu/tag/01PM)
* [Stacks Project, Tag 01PQ](https://stacks.math.columbia.edu/tag/01PQ)
* [Stacks Project, Tag 01YB](https://stacks.math.columbia.edu/tag/01YB)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open AlgebraicGeometry AlgebraicGeometry.StructureSheaf
open PrimeSpectrum (basicOpen)

universe u v

namespace Stacks.AlgebraicGeometry.IdealPowerSections

section Algebra

variable (A : Type u) [CommRing A] (M : Type v) [AddCommGroup M] [Module A M]

/-- If every generator of `I` has a power in `J`, then some power of `I` lies in `J`. -/
private lemma exists_pow_le_of_forall_generator_pow_mem {I J : Ideal A} {s : Finset A}
    (hs : Ideal.span (s : Set A) = I) (h : ∀ f ∈ s, ∃ n, f ^ n ∈ J) : ∃ N, I ^ N ≤ J := by
  exact Ideal.exists_pow_le_of_le_radical_of_fg (hs.ge.trans (Ideal.span_le.mpr h)) ⟨s, hs⟩

/-- If no nonzero element of `M` is annihilated by `I`, then none is annihilated by the `n`-th
powers of all the elements of a generating set of `I`. -/
public lemma eq_zero_of_forall_generator_pow_smul_eq_zero {I : Ideal A} {s : Finset A}
    (hs : Ideal.span (s : Set A) = I)
    (htors : ∀ y : M, (∀ a ∈ I, a • y = 0) → y = 0) (n : ℕ) (z : M)
    (h : ∀ f ∈ s, f ^ n • z = 0) : z = 0 := by
  obtain ⟨N, hN⟩ := exists_pow_le_of_forall_generator_pow_mem A (J :=
    LinearMap.ker (LinearMap.toSpanSingleton A M z)) hs fun f hf =>
      ⟨n, by simpa [LinearMap.toSpanSingleton_apply] using h f hf⟩
  refine eq_zero_of_forall_mem_pow_smul_eq_zero A I M htors N z fun a ha => ?_
  simpa [LinearMap.toSpanSingleton_apply] using hN ha

/-- **The representative, from the cross relations.** Given numerators `y` satisfying the exact
cross relations `f' ^ n • y f = f ^ n • y f'` on a generating set `s` of `I`, and assuming no
nonzero element of `M` is annihilated by `I`, there is an `A`-linear map `ψ` on the ideal
generated by the `n`-th powers of `s` with `f ^ n • ψ b = b • y f` for every generator `f`.

Uniqueness of such a value is the hypothesis on `M`, which is what makes `ψ` additive and
`A`-linear without any computation on representations of `b`. -/
public lemma exists_hom_of_crossRelations {I : Ideal A} {s : Finset A}
    (hs : Ideal.span (s : Set A) = I)
    (htors : ∀ y : M, (∀ a ∈ I, a • y = 0) → y = 0) (n : ℕ) (y : A → M)
    (hcross : ∀ f ∈ s, ∀ f' ∈ s, f' ^ n • y f = f ^ n • y f') :
    ∃ ψ : ↥(Ideal.span ((· ^ n) '' (s : Set A))) →ₗ[A] M,
      ∀ (b : ↥(Ideal.span ((· ^ n) '' (s : Set A)))) (f : A), f ∈ s →
        f ^ n • ψ b = (b : A) • y f := by
  classical
  have hex : ∀ b : ↥(Ideal.span ((· ^ n) '' (s : Set A))),
      ∃ z : M, ∀ f ∈ s, f ^ n • z = (b : A) • y f := by
    rintro ⟨b, hb⟩
    induction hb using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨f, hf, rfl⟩ := hx
      exact ⟨y f, fun f' hf' => hcross f hf f' hf'⟩
    | zero => exact ⟨0, fun f _ => by simp⟩
    | add x₁ x₂ _ _ ih₁ ih₂ =>
      obtain ⟨z₁, hz₁⟩ := ih₁
      obtain ⟨z₂, hz₂⟩ := ih₂
      exact ⟨z₁ + z₂, fun f hf => by
        rw [smul_add, hz₁ f hf, hz₂ f hf, ← add_smul]⟩
    | smul c x hx ih =>
      obtain ⟨z, hz⟩ := ih
      refine ⟨c • z, fun f hf => ?_⟩
      have h1 : f ^ n • (c • z) = c • (f ^ n • z) := smul_comm _ _ _
      rw [h1, hz f hf]
      exact smul_smul c x (y f)
  have huniq : ∀ z z' : M, (∀ f ∈ s, f ^ n • z = f ^ n • z') → z = z' := by
    intro z z' h
    refine sub_eq_zero.mp (eq_zero_of_forall_generator_pow_smul_eq_zero A M hs htors n _
      fun f hf => ?_)
    rw [smul_sub, h f hf, sub_self]
  refine ⟨{ toFun := fun b => (hex b).choose, map_add' := ?_, map_smul' := ?_ },
    fun b f hf => (hex b).choose_spec f hf⟩
  · intro b₁ b₂
    refine huniq _ _ fun f hf => ?_
    rw [(hex (b₁ + b₂)).choose_spec f hf, smul_add, (hex b₁).choose_spec f hf,
      (hex b₂).choose_spec f hf, ← add_smul]
    rfl
  · intro c b
    refine huniq _ _ fun f hf => ?_
    rw [(hex (c • b)).choose_spec f hf, smul_comm, (hex b).choose_spec f hf, smul_smul]
    rfl

end Algebra

section Surjective

variable (A : Type u) [CommRing A] (I : Ideal A) (M : Type v) [AddCommGroup M] [Module A M]

/-- The canonical map of [Stacks, Tag 01PM] on a colimit representative is `sectionOfHom`. -/
public lemma canonicalMapToSections_colimit_ι (n : ℕ) (φ : (I ^ n : Ideal A) →ₗ[A] M) :
    canonicalMapToSections A I M (colimit.ι (idealPowersHom A I M) n φ) =
      sectionOfHom A I M n φ :=
  (CategoryTheory.comp_apply (colimit.ι (idealPowersHom A I M) n)
      (colimit.desc (idealPowersHom A I M) (sectionsCocone A I M)) φ).symm.trans
    (ConcreteCategory.congr_hom (colimit.ι_desc (sectionsCocone A I M) n) φ)

/-- A point of the complement of `V(I)` avoids some element of any generating set of `I`. -/
public lemma exists_generator_notMem {s : Finset A} (hs : Ideal.span (s : Set A) = I)
    (x : PrimeSpectrum (ULift.{v} A))
    (hx : x ∈ complementVanishing (ULift.{v} A) (liftedIdeal.{u, v} A I)) :
    ∃ a ∈ s, (ULift.up a : ULift.{v} A) ∉ x.asIdeal := by
  by_contra hcon
  simp only [not_exists, not_and, not_not] at hcon
  obtain ⟨g, hgJ, hgx⟩ := exists_mem_liftedIdeal_notMem A I x hx
  refine hgx ?_
  have key : ∀ b : A, b ∈ I → (ULift.up b : ULift.{v} A) ∈ x.asIdeal := by
    intro b hb
    rw [← hs] at hb
    induction hb using Submodule.span_induction with
    | mem c hc => exact hcon c hc
    | zero => exact x.asIdeal.zero_mem
    | add b₁ b₂ _ _ ih₁ ih₂ => exact x.asIdeal.add_mem ih₁ ih₂
    | smul c b _ ih => exact Ideal.mul_mem_left _ (ULift.up c) ih
  exact key g.down ((mem_liftedIdeal A I).mp hgJ)

/-- **Stacks Project, Tag 01PM, surjectivity, representative form.** If `I` is finitely generated
and no nonzero element of `M` is annihilated by `I`, then every section of `M̃` on
`Spec(A) \ V(I)` is the section attached to some `φ : I ^ n → M`. -/
public theorem exists_sectionOfHom_eq (hI : I.FG)
    (htors : ∀ y : M, (∀ a ∈ I, a • y = 0) → y = 0) (t : sectionsOnComplement A I M) :
    ∃ (n : ℕ) (φ : (I ^ n : Ideal A) →ₗ[A] M), sectionOfHom A I M n φ = t := by
  classical
  obtain ⟨s, hs⟩ := hI
  -- the lifted generating set, and its basic opens inside the complement
  have hmemJ : ∀ a ∈ s, (ULift.up a : ULift.{v} A) ∈ liftedIdeal.{u, v} A I := fun a ha =>
    (mem_liftedIdeal A I).mpr (hs ▸ Ideal.subset_span ha)
  have hGW : ∀ f ∈ s.image (ULift.up : A → ULift.{v} A),
      basicOpen f ≤ complementVanishing (ULift.{v} A) (liftedIdeal.{u, v} A I) := by
    intro f hf
    obtain ⟨a, ha, rfl⟩ := Finset.mem_image.mp hf
    exact basicOpen_le_liftedComplement A I _ (hmemJ a ha)
  -- one exponent and exact cross relations
  obtain ⟨n, Y, hY, hYcross⟩ := exists_uniform_fractions t.1 t.2
    (s.image (ULift.up : A → ULift.{v} A)) hGW
  have hYmem : ∀ a ∈ s, (ULift.up a : ULift.{v} A) ∈
      s.image (ULift.up : A → ULift.{v} A) := fun a ha =>
    Finset.mem_image.mpr ⟨a, ha, rfl⟩
  -- the cross relations, read in `M`
  have hcross : ∀ a ∈ s, ∀ b ∈ s,
      b ^ n • (Y (ULift.up a)).down = a ^ n • (Y (ULift.up b)).down := fun a ha b hb =>
    congrArg ULift.down (hYcross _ (hYmem a ha) _ (hYmem b hb))
  -- the representative on the ideal generated by the `n`-th powers of the generators
  obtain ⟨ψ, hψ⟩ := exists_hom_of_crossRelations A M hs htors n
    (fun a => (Y (ULift.up a)).down) hcross
  -- a power of `I` lands in that ideal
  obtain ⟨N₀, hN₀⟩ := exists_pow_le_of_forall_generator_pow_mem A
    (J := Ideal.span ((· ^ n) '' (s : Set A))) hs fun a ha =>
    ⟨n, Ideal.subset_span ⟨a, ha, rfl⟩⟩
  have hIN : I ^ (N₀ + n) ≤ Ideal.span ((· ^ n) '' (s : Set A)) :=
    le_trans (Ideal.pow_le_pow_right (Nat.le_add_right N₀ n)) hN₀
  refine ⟨N₀ + n, ψ ∘ₗ Submodule.inclusion hIN, Subtype.ext (funext fun x => ?_)⟩
  -- pointwise comparison, at a generator avoiding the prime
  obtain ⟨a, ha, hax⟩ := exists_generator_notMem A I hs x.1 x.2
  refine Eq.trans (fractionSectionFun_apply
    (liftedNumerator_cross A I M (N₀ + n) (ψ ∘ₗ Submodule.inclusion hIN)) x
    ⟨ULift.up a, hmemJ a ha⟩ hax) ?_
  refine Eq.trans (LocalizedModule.mk_eq.mpr ⟨1, ?_⟩)
    (hY _ (hYmem a ha) x.1 hax x.2).symm
  refine congrArg (fun z => (1 : (x.1 : PrimeSpectrum (ULift.{v} A)).asIdeal.primeCompl) • z)
    (ULift.ext ?_)
  exact hψ ⟨a ^ (N₀ + n), hIN (Ideal.pow_mem_pow (hs ▸ Ideal.subset_span ha) (N₀ + n))⟩ a ha

/-- **Stacks Project, Tag 01PM, surjectivity.** For a finitely generated ideal `I` and a module
`M` no nonzero element of which is annihilated by `I`, the canonical map
`colim_n Hom_A(I ^ n, M) → Γ(Spec(A) \ V(I), M̃)` is surjective. -/
public theorem canonicalMapToSections_surjective (hI : I.FG)
    (htors : ∀ y : M, (∀ a ∈ I, a • y = 0) → y = 0) :
    Function.Surjective (canonicalMapToSections A I M) := by
  intro t
  obtain ⟨n, φ, hφ⟩ := exists_sectionOfHom_eq A I M hI htors t
  exact ⟨colimit.ι (idealPowersHom A I M) n φ,
    (canonicalMapToSections_colimit_ι A I M n φ).trans hφ⟩

/-- **Stacks Project, Tag 01PM, the isomorphism.** For a finitely generated ideal `I` and a
module `M` no nonzero element of which is annihilated by `I`, the canonical map
`colim_n Hom_A(I ^ n, M) → Γ(Spec(A) \ V(I), M̃)` is bijective. -/
public theorem canonicalMapToSections_bijective (hI : I.FG)
    (htors : ∀ y : M, (∀ a ∈ I, a • y = 0) → y = 0) :
    Function.Bijective (canonicalMapToSections A I M) :=
  ⟨canonicalMapToSections_injective A I M hI, canonicalMapToSections_surjective A I M hI htors⟩

/-- The canonical map of [Stacks, Tag 01PM] as an `A`-linear isomorphism
`colim_n Hom_A(I ^ n, M) ≅ Γ(Spec(A) \ V(I), M̃)`. -/
public noncomputable def sectionsLinearEquiv (hI : I.FG)
    (htors : ∀ y : M, (∀ a ∈ I, a • y = 0) → y = 0) :
    ToType (colimit (idealPowersHom A I M)) ≃ₗ[A] ↥(sectionsOnComplement A I M) :=
  LinearEquiv.ofBijective (canonicalMapToSections A I M).hom
    (canonicalMapToSections_bijective A I M hI htors)

/-- Let `I` be a finitely generated
ideal of `A`. If no nonzero element of `M` is annihilated by all of `I`, then the canonical map
`colim_n Hom_A(I ^ n, M) → Γ(Spec(A) \ V(I), M̃)` is an isomorphism.

The hypothesis is the vanishing of `Submodule.torsionBySet A M I`, the submodule of elements
annihilated by every element of `I`; in the source it is used exactly to see that all of the
submodules `Mₙ` vanish, so that the general isomorphism of [Stacks, Tag 01PM] reduces to the
canonical map itself. -/
public theorem isIso_canonicalMapToSections (hI : I.FG)
    (hM : Submodule.torsionBySet A M (I : Ideal A) = ⊥) :
    IsIso (canonicalMapToSections A I M) := by
  have htors : ∀ y : M, (∀ a ∈ I, a • y = 0) → y = 0 := fun y hy =>
    (Submodule.eq_bot_iff _).mp hM y
      ((Submodule.mem_torsionBySet_iff ..).mpr fun a => hy a.1 a.2)
  rw [ConcreteCategory.isIso_iff_bijective]
  exact canonicalMapToSections_bijective A I M hI htors

end Surjective

end Stacks.AlgebraicGeometry.IdealPowerSections

end
