module

public import StacksFrontier.AlgebraicGeometry.Divisors.Modification.InvertibleFiltration
public import StacksFrontier.AlgebraicGeometry.ProjectiveBundleSplitting.Properness
public import StacksFrontier.AlgebraicGeometry.ProjectiveBundleSplitting.KernelRank
public import StacksFrontier.AlgebraicGeometry.ProjectiveBundleSplitting.PullbackStable
public import StacksFrontier.AlgebraicGeometry.ProjectiveBundleSplitting.TautologicalMap
public import StacksFrontier.AlgebraicGeometry.ProjectiveBundleSplitting.TrivialOpen

/-!
# The splitting datum of `𝐏(ℰ)` on the graded-algebra presentation

`Stacks.Divisors.BundleSplittingDatum` is the record Tag 0AYP reads off the projective bundle of
a module of rank `r + 1`. On the presentation `Stacks.SymGraded.schemeProjectiveBundle` of
`𝐏(ℰ)`, built from the sheaf-level graded algebra `Sym(ℰ)`, ten of its fifteen fields are
constructions rather than arguments:

* `bundle`, `proj` are `Stacks.SymGraded.schemeProjectiveBundle` and its projection;
* `isProper_proj` is `Stacks.ProjectiveBundleSplitting.isProper_schemeProjectiveBundleToBase`,
  Tag 0800 carried onto this presentation;
* `twist` is the degree-one twist of the canonical twist datum of Tag 01NR, and
  `twist_isInvertible` is `Stacks.SymGraded.isInvertible_projectiveBundleTwist`, Tag 01O4's
  invertibility with its generation hypothesis discharged at `Sym(ℰ)`;
* `quot` is `Stacks.ProjectiveBundleSplitting.tautologicalMap`, the transpose of the
  homogeneous-section map;
* `sub`, `incl`, `incl_comp_quot` are the categorical kernel of that map, its inclusion, and the
  kernel condition;
* `shortExact_pullback` is
  `Stacks.ProjectiveBundleSplitting.shortExact_map_pullback_of_epi_isInvertible`, the kernel
  sequence of an invertible quotient staying short exact under every pullback.

## Main definitions

* `Stacks.ProjectiveBundleSplitting.bundleSplittingDatumOfSym`: the record, from the pullback
  stability of the tautological sequence, the rank of its kernel, and a section over a nonempty
  open.

## Main results

* `Stacks.ProjectiveBundleSplitting.nonempty_bundleSplittingDatumOfSym`: the existence of the
  record, with the section over a nonempty open taken existentially.
* `Stacks.ProjectiveBundleSplitting.nonempty_bundleSplittingDatumOfSym_of_sectionOnFreeOpen`:
  the same with the trivialising open produced rather than supplied, so that only a section over
  a trivialising open is assumed.
* `Stacks.ProjectiveBundleSplitting.nonempty_bundleSplittingDatumOfSym_of_rank`: the same again
  with the rank of the tautological kernel read off instead of assumed, so that the kernel is
  only assumed finite locally free of some constant rank.

## Implementation notes

**Which presentation.** Properness of the projection, Tag 0800, is proved for the presentation
built from a `Stacks.RelativeProj.Situation`; the twists live on the one built from a
`SheafGradedAlgebra`. `Stacks.ProjectiveBundleSplitting.isProper_schemeProjectiveBundleToBase`
already carries properness across the isomorphism of the two, so this file works entirely on the
graded-algebra side, where the twist and the tautological map onto it are available.

**The hypotheses.** Three things: epimorphy of the tautological map, which is the statement
that the degree-one twist is generated by the degree-one sections; `sub_rank`, that the kernel of
that map is finite locally free of rank `r`; and a section of the projection over a nonempty
open. A nonempty open on which `ℰ` is free is produced by
`Stacks.ProjectiveBundleSplitting.exists_nonempty_free_open`, so the third hypothesis is the
section over it. Epimorphy also gives the short exactness of the tautological sequence, through
`Stacks.ProjectiveBundleSplitting.shortExact_map_pullback_of_epi_isInvertible`. The rank of the
kernel is `Stacks.ProjectiveBundleSplitting.isFiniteLocallyFreeOfRank_kernel_of_epi_isInvertible`,
and the section is `Stacks.ProjectiveBundleSplitting.exists_nonempty_open_section`, Tag 01OE.

## References

* [Stacks Project, Tag 0AYP](https://stacks.math.columbia.edu/tag/0AYP)
* [Stacks Project, Tag 0800](https://stacks.math.columbia.edu/tag/0800)
* [Stacks Project, Tag 01NR](https://stacks.math.columbia.edu/tag/01NR)
* [Stacks Project, Tag 01O4](https://stacks.math.columbia.edu/tag/01O4)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open Stacks.AlgebraicGeometry.RelativeProjBridge
open Stacks.AlgebraicGeometry.RelativeProj
open Stacks.SymGraded

universe u

namespace Stacks.ProjectiveBundleSplitting

open Stacks.Divisors

attribute [local implicit_reducible] TopCat.Sheaf sheafCompose

variable {X : Scheme.{u}} (E : X.Modules) [E.IsQuasicoherent]
  [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree.{u, u, u} E]
  (hqc : IsQuasicoherentPieces E)

/-- **The splitting datum of `𝐏(ℰ)` on the graded-algebra presentation.** The bundle, its
projection, properness of that projection, the degree-one twist, the invertibility of the twist,
the tautological map onto it, the kernel of that map and the pullback stability of the
tautological sequence are constructed; the arguments are epimorphy of the tautological map, the
rank of its kernel, and a section of the projection over a nonempty open. -/
def bundleSplittingDatumOfSym (r : ℕ)
    (hepi : Epi (tautologicalMap E hqc))
    (hrank : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (kernel (tautologicalMap E hqc)) r)
    (U : X.Opens) (hU : Nonempty U)
    (σ : U.toScheme ⟶ (relativeProj (schemeSheafGradedAlgebra E hqc)).scheme)
    (hσ : σ ≫ (relativeProj (schemeSheafGradedAlgebra E hqc)).toBase = U.ι) :
    BundleSplittingDatum X E r where
  bundle := (relativeProj (schemeSheafGradedAlgebra E hqc)).scheme
  proj := (relativeProj (schemeSheafGradedAlgebra E hqc)).toBase
  isProper_proj := isProper_schemeProjectiveBundleToBase E hqc
  sub := kernel (tautologicalMap E hqc)
  twist := tautologicalTwist E hqc
  incl := kernel.ι (tautologicalMap E hqc)
  quot := tautologicalMap E hqc
  incl_comp_quot := kernel.condition (tautologicalMap E hqc)
  shortExact_pullback := fun h =>
    shortExact_map_pullback_of_epi_isInvertible h (tautologicalMap E hqc) hepi
      (isInvertible_tautologicalTwist E hqc)
  twist_isInvertible := isInvertible_tautologicalTwist E hqc
  sub_rank := hrank
  trivialOpen := U
  nonempty_trivialOpen := hU
  sect := σ
  sect_comp_proj := hσ

/-- **The splitting datum of `𝐏(ℰ)` exists**, given epimorphy of the tautological map, the rank
of its kernel, and some section of the projection over a nonempty open. -/
theorem nonempty_bundleSplittingDatumOfSym (r : ℕ)
    (hepi : Epi (tautologicalMap E hqc))
    (hrank : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (kernel (tautologicalMap E hqc)) r)
    (hsect : ∃ (U : X.Opens) (_ : Nonempty U)
      (σ : U.toScheme ⟶ (relativeProj (schemeSheafGradedAlgebra E hqc)).scheme),
        σ ≫ (relativeProj (schemeSheafGradedAlgebra E hqc)).toBase = U.ι) :
    Nonempty (BundleSplittingDatum X E r) := by
  obtain ⟨U, hU, σ, hσ⟩ := hsect
  exact ⟨bundleSplittingDatumOfSym E hqc r hepi hrank U hU σ hσ⟩

/-- **The splitting datum of `𝐏(ℰ)` with the trivialising open produced.** On an irreducible —
in particular an integral — base, `Stacks.ProjectiveBundleSplitting.exists_nonempty_isFreeOfRankOn`
supplies a nonempty open on which `ℰ` is free of its rank, which is the pair of fields
`trivialOpen` and `nonempty_trivialOpen`; only a section of the projection over such an open is
assumed. -/
theorem nonempty_bundleSplittingDatumOfSym_of_sectionOnFreeOpen [IrreducibleSpace X] (n r : ℕ)
    (hE : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E n)
    (hepi : Epi (tautologicalMap E hqc))
    (hrank : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (kernel (tautologicalMap E hqc)) r)
    (hsect : ∀ U : X.Opens, Nonempty U → IsFreeOfRankOn E n U →
      ∃ σ : U.toScheme ⟶ (relativeProj (schemeSheafGradedAlgebra E hqc)).scheme,
        σ ≫ (relativeProj (schemeSheafGradedAlgebra E hqc)).toBase = U.ι) :
    Nonempty (BundleSplittingDatum X E r) := by
  obtain ⟨U, hU, hfree⟩ := exists_nonempty_isFreeOfRankOn E n hE
  exact nonempty_bundleSplittingDatumOfSym E hqc r hepi hrank ⟨U, hU, hsect U hU hfree⟩

/-- **The splitting datum of `𝐏(ℰ)` with the rank of the tautological kernel read off.** The
kernel of an epimorphism onto an invertible module, out of a module of rank `m + 2`, has rank
`m + 1` as soon as it is finite locally free of some constant rank, by
`Stacks.ProjectiveBundleSplitting.isFiniteLocallyFreeOfRank_kernel_succ`; so the hypothesis on
the kernel names no rank. Rank additivity is read at the point `x` of the bundle. -/
theorem nonempty_bundleSplittingDatumOfSym_of_rank [IrreducibleSpace X] (m r : ℕ)
    (hE : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} E (m + 2))
    (hepi : Epi (tautologicalMap E hqc))
    (hker : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (kernel (tautologicalMap E hqc)) r)
    (x : (relativeProj (schemeSheafGradedAlgebra E hqc)).scheme)
    (hsect : ∀ U : X.Opens, Nonempty U → IsFreeOfRankOn E (m + 2) U →
      ∃ σ : U.toScheme ⟶ (relativeProj (schemeSheafGradedAlgebra E hqc)).scheme,
        σ ≫ (relativeProj (schemeSheafGradedAlgebra E hqc)).toBase = U.ι) :
    Nonempty (BundleSplittingDatum X E (m + 1)) := by
  have hpull : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback
        (relativeProj (schemeSheafGradedAlgebra E hqc)).toBase).obj E) (m + 2) :=
    have := hE
    AlgebraicGeometry.isFiniteLocallyFreeOfRank_pullback _ E (m + 2)
  exact nonempty_bundleSplittingDatumOfSym_of_sectionOnFreeOpen E hqc (m + 2) (m + 1) hE hepi
    (isFiniteLocallyFreeOfRank_kernel_succ (tautologicalMap E hqc) hepi
      (isInvertible_tautologicalTwist E hqc) m r hpull hker x) hsect

end Stacks.ProjectiveBundleSplitting

end
