module

public import StacksFrontier.AlgebraicGeometry.PullbackSections.Affine

/-!
# A morphism out of a pullback, read on the pullback of a section

Let `f : Y ⟶ X` be a morphism of schemes, `A` a module on `X` and `B` a module on `Y`.  A
morphism `g : f^* A ⟶ B` and its adjoint transpose `g̃ : A ⟶ f_* B` under the adjunction
`f^* ⊣ f_*` of [Stacks, Tag 01BH] carry the same information, and this file records what that
says on sections: for opens `U` of `X` and `V` of `Y` with `V ⊆ f⁻¹(U)`, the value of `g` over
`V` on the pullback `AlgebraicGeometry.Scheme.Modules.pullbackSection f A U V h a` of a
section `a` of `A` over `U` is the restriction to `V` of the value of `g̃` over `U` on `a`.

This is the step that turns a statement about a morphism out of a pullback -- where the module of
sections over `V` is a base change and is generated by the pullbacks of sections over `U` -- into
a statement about an ordinary morphism of modules on `X`.

## Main results

* `AlgebraicGeometry.Scheme.Modules.pullbackSection_homEquiv`: the displayed identity.

## References

* [Stacks Project, Tag 01BH](https://stacks.math.columbia.edu/tag/01BH)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

namespace AlgebraicGeometry

universe u

namespace Scheme.Modules

/-- **A morphism out of a pullback, evaluated on the pullback of a section, is its transpose.**
For `g : f^* A ⟶ B` and `a` a section of `A` over an open `U` of `X`, the value of `g` over an
open `V ⊆ f⁻¹(U)` of `Y` on the pullback of `a` is the restriction to `V` of the value on `a` of
the adjoint transpose `A ⟶ f_* B` of `g`. -/
theorem pullbackSection_homEquiv {X Y : Scheme.{u}} (f : Y ⟶ X) (A : X.Modules) (B : Y.Modules)
    (g : (Scheme.Modules.pullback f).obj A ⟶ B) (U : X.Opens) (V : Y.Opens)
    (hV : V ≤ f ⁻¹ᵁ U) (a : A.val.obj (op U)) :
    g.val.app (op V) (pullbackSection f A U V hV a) =
      B.val.map (homOfLE hV).op
        (((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv A B g).val.app (op U) a) :=
  Eq.trans (PresheafOfModules.naturality_apply g.val (homOfLE hV).op
      (((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app A).val.app (op U) a))
    (congrArg (ConcreteCategory.hom (B.val.map (homOfLE hV).op))
      (by rw [Adjunction.homEquiv_unit]; rfl))

end Scheme.Modules

end AlgebraicGeometry

end
