module

public import StacksFrontier.AlgebraicGeometry.InvertibleRankOneIff.Basic
public import StacksFrontier.AlgebraicGeometry.Bridge.Consumers
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.Abelian

/-!
# Stacks Tag 0C6K: the zero scheme annihilates the cokernel of its section

`Stacks.RegularSectionSequence.exists_cokernelIso_restrictionUnit` and
`Stacks.RegularSectionSequence.shortExact_restrictionUnit` are the two assertions of Stacks Tag
0C6K's label `regular_section_sequence` on two named hypotheses, `hz` and `hiso`.
`Stacks.Tag08KS.exists_cokernelIso_restrictionUnit_of_annihilated` already replaces `hiso` by the
annihilation condition of Stacks Tag 08KS. **This file discharges that annihilation condition at
the zero scheme of a section of an invertible module**, so each assertion is left with the single
hypothesis `hz`.

## Main results

* `Stacks.Tag0C6KZeroSchemeAnnihilation.ker_annihilates`: for `L` invertible, `s` a global
  section of `L` and `p : L ⟶ M` an epimorphism killing `s`, the kernel ideal of
  `𝒪_X ⟶ i_* 𝒪_{Z(s)}` annihilates `M`. This is the content: the zero scheme's ideal is, on a
  trivialising affine open, contained in the ideal generated by the function representing `s`,
  so a section of that kernel ideal moves any local section of `L` into the span of `s`, which
  `p` kills.
* `Stacks.Tag0C6KZeroSchemeAnnihilation.exists_cokernelIso_zeroScheme` and
  `Stacks.Tag0C6KZeroSchemeAnnihilation.shortExact_zeroScheme`: the two assertions of Tag 0C6K's
  `regular_section_sequence` at the zero scheme, with `hiso` and the annihilation condition both
  discharged and only `hz` remaining.

## What is still owed, and no Stacks attribute is attached

`hz` says that `s` restricts to zero on its own zero scheme. At the zero scheme that is the
**other** direction of the ideal computation: `Stacks.RegularSectionSequence.zeroScheme` is
`Scheme.IdealSheafData.ofIdeals` of the family `U ↦ span {φ (s|U) | φ}`, and `ofIdeals` returns
the *largest quasi-coherent* ideal sheaf contained in that family, so
`Scheme.IdealSheafData.ideal_ofIdeals_le` gives only the inclusion `≤` — which is exactly what
the annihilation condition below needs, and exactly the wrong direction for `hz`. The reverse
inclusion is the assertion that the family is already quasi-coherent, which is Stacks Tag 02OQ's
second assertion; it is not available here, so the covering set for
`0C6K "regular_section_sequence"` is incomplete and no attribute is attached here.

## Implementation notes

**The statement of `ker_annihilates` takes `Epi p` as an explicit hypothesis with its category
pinned to `SheafOfModules.{u} X.ringCatSheaf`.** `AlgebraicGeometry.Scheme.Modules` is a `def`
for that category, and the objects here must be `X.Modules` — `Γ(L, V)` carries its
`Module Γ(X, V)` instance only at that spelling, and the local trivialisation and the ideal
computation are both stated with it — while `Epi` of a morphism, the zero morphism of a hom
group, and `Epi (cokernel.π f)` are all only found at the unwrapped spelling. Pinning the one
instance that crosses the boundary is cheaper than transporting everything.

No raised `maxHeartbeats` is needed. The one expensive elaboration would be
`(M.val.map_comp_apply _ _ _).symm`, whose three implicit arguments send `whnf` past the budget.
Composing the two restriction maps explicitly — the morphisms of `(Opens X)ᵒᵖ` are unique, so
`Subsingleton.elim` identifies the composite — avoids it, and the file compiles at the default
budget.

## References

* [Stacks Project, Tag 0C6K](https://stacks.math.columbia.edu/tag/0C6K)
* [Stacks Project, Tag 02OQ](https://stacks.math.columbia.edu/tag/02OQ)
* [Stacks Project, Tag 08KS](https://stacks.math.columbia.edu/tag/08KS)
* [Stacks Project, Tag 0B8M](https://stacks.math.columbia.edu/tag/0B8M)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace

universe u

namespace Stacks.Tag0C6KZeroSchemeAnnihilation

private lemma smul_eq_of_coordinate {R N : Type*} [CommRing R] [AddCommGroup N]
    [Module R N] (e : N ≃ₗ[R] R) (v n : N) (a : R)
    (ha : a ∈ Ideal.span ({e v} : Set R)) :
    ∃ b : R, a • n = b • v := by
  obtain ⟨b, hb⟩ := Ideal.mem_span_singleton.mp ha
  refine ⟨b * e n, e.injective ?_⟩
  simp only [map_smul, smul_eq_mul]
  rw [hb]
  ring

private lemma map_app_eq_zero {X : Scheme.{u}} (I : X.IdealSheafData) {U V : X.Opens} (h : V ≤ U)
    (a : Γ(X, U)) (ha : I.subschemeι.app U a = 0) :
    I.subschemeι.app V (X.presheaf.map (homOfLE h).op a) = 0 := by
  have hnat := I.subschemeι.naturality (U' := U) (U := V) (homOfLE h).op
  rw [← CommRingCat.comp_apply, hnat, CommRingCat.comp_apply, ha, map_zero]

private lemma zeroScheme_ideal_le_span_restrict (X : Scheme.{u}) (L : X.Modules) (t : Γ(L, ⊤))
    (V : X.affineOpens) (e : Γ(L, V.1) ≃ₗ[Γ(X, V.1)] Γ(X, V.1)) :
    (Stacks.RegularSectionSequence.zeroScheme X L t).ideal V ≤
      Ideal.span ({e (L.presheaf.map (homOfLE le_top).op t)} : Set Γ(X, V.1)) := by
  refine (Scheme.IdealSheafData.ideal_ofIdeals_le _ V).trans ?_
  refine Ideal.span_le.mpr ?_
  rintro x ⟨φ, rfl⟩
  have hx : φ (L.presheaf.map (homOfLE le_top).op t) =
      e (L.presheaf.map (homOfLE le_top).op t) * φ (e.symm 1) := by
    calc
      φ (L.presheaf.map (homOfLE le_top).op t)
          = φ (e.symm (e (L.presheaf.map (homOfLE le_top).op t))) := by
            congr 1
            exact (e.symm_apply_apply _).symm
      _ = φ (e.symm (e (L.presheaf.map (homOfLE le_top).op t) • (1 : Γ(X, V.1)))) := by
            congr 2
            simp
      _ = φ (e (L.presheaf.map (homOfLE le_top).op t) • e.symm 1) := by rw [map_smul]
      _ = e (L.presheaf.map (homOfLE le_top).op t) • φ (e.symm 1) := by rw [map_smul]
      _ = e (L.presheaf.map (homOfLE le_top).op t) * φ (e.symm 1) := by rw [smul_eq_mul]
  rw [hx]
  exact Ideal.mul_mem_right _ _ (Ideal.subset_span (by simp))

private lemma zeroScheme_ideal_le_span (X : Scheme.{u}) (L : X.Modules) (s : L.sections)
    (V : X.affineOpens) (e : Γ(L, V.1) ≃ₗ[Γ(X, V.1)] Γ(X, V.1)) :
    (Stacks.RegularSectionSequence.zeroScheme X L (s.eval (op ⊤))).ideal V ≤
      Ideal.span ({e (s.eval (op V.1))} : Set Γ(X, V.1)) := by
  have hres : s.eval (op V.1) = L.presheaf.map (homOfLE le_top).op (s.eval (op ⊤)) :=
    (PresheafOfModules.sections_property s (homOfLE le_top).op).symm
  rw [hres]
  exact zeroScheme_ideal_le_span_restrict X L (s.eval (op ⊤)) V e

/-- An invertible module is trivialised by a linear equivalence on a neighbourhood of every point,
and hence on every open contained in it. This is Stacks Tag 0B8M, in the form
`Stacks.InvertibleRankOneIff.isInvertible_iff_isFiniteLocallyFreeOfRank_one`. -/
theorem exists_local_section_linearEquiv (X : Scheme.{u}) (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L] (x : X) :
    ∃ W : X.Opens, x ∈ W ∧ ∀ V : X.Opens, V ≤ W →
      Nonempty (Γ(L, V) ≃ₗ[Γ(X, V)] Γ(X, V)) := by
  have hf := (Stacks.InvertibleRankOneIff.isInvertible_iff_isFiniteLocallyFreeOfRank_one
    X.toRingedSpace L).mp inferInstance
  obtain ⟨q, hq, hr⟩ := hf.exists_isFiniteLocallyFreeOfRankData
  have hx : x ∈ ⨆ i, q.X i := by
    rw [(Opens.coversTop_iff X q.X).mp q.coversTop]
    trivial
  obtain ⟨i, hi⟩ := Opens.mem_iSup.mp hx
  let : Unique (q.generators i).I := (hr i).some.unique
  have := hq.isIso i
  let e : L.over (q.X i) ≅ SheafOfModules.unit (X.ringCatSheaf.over (q.X i)) :=
    (asIso (q.generators i).π).symm ≪≫ coproductUniqueIso _
  refine ⟨q.X i, hi, fun V hV => ?_⟩
  exact ⟨((SheafOfModules.evaluation _ (op (Over.mk (homOfLE hV)))).mapIso e).toLinearEquiv⟩

private lemma smul_image_eq_zero {R A B : Type*} [Ring R] [AddCommGroup A]
    [AddCommGroup B] [Module R A] [Module R B] (q : A →ₗ[R] B) (v l : A) (a b : R)
    (hv : q v = 0) (hab : a • l = b • v) : a • q l = 0 := by
  rw [← map_smul, hab, map_smul, hv, smul_zero]

/-- Let `L` be an invertible module on `X` with global section `s`, and let `p : L ⟶ M` be an
epimorphism of modules killing `s` on every open. Then every section `a` over `U` of the ideal
sheaf of the zero scheme `Z(s)` annihilates every section of `M` over `U`. -/
theorem ker_annihilates (X : Scheme.{u}) (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (s : L.sections) (M : X.Modules) (p : L ⟶ M)
    (hp : Epi (C := SheafOfModules.{u} X.ringCatSheaf) p)
    (hzs : ∀ V : X.Opens, p.val.app (op V) (s.eval (op V)) = 0)
    (U : Opens X) (a : X.ringCatSheaf.obj.obj (op U))
    (ha : a ∈ RingHom.ker ((Stacks.RegularSectionSequence.zeroScheme X L
      (s.eval (op ⊤))).subschemeι.toLRSHom.c.app (op U)).hom)
    (m : M.val.obj (op U)) : a • m = 0 := by
  let I := Stacks.RegularSectionSequence.zeroScheme X L (s.eval (op ⊤))
  have ha' : I.subschemeι.app U a = 0 := ha
  let : PreservesFiniteColimits (SheafOfModules.toSheaf.{u} X.ringCatSheaf) :=
    Stacks.SheafOfModules.instPreservesFiniteColimitsToSheaf _
  have hpres : (SheafOfModules.toSheaf X.ringCatSheaf).PreservesEpimorphisms :=
    NormalMonoCategory.preservesEpimorphisms_of_preservesCokernels _
  have hepip := hp
  have hepi : Epi ((SheafOfModules.toSheaf X.ringCatSheaf).map p) := hpres.preserves p
  have hsurj : TopCat.Presheaf.IsLocallySurjective
      ((SheafOfModules.toSheaf X.ringCatSheaf).map p).hom :=
    (TopCat.Sheaf.isLocallySurjective_iff_epi _).mpr hepi
  apply TopCat.Presheaf.IsSheaf.section_ext (X := X.toTopCat)
    (A := AddCommGrpCat.{u}) (F := M.val.presheaf) (U := op U)
    (s := a • m) (t := 0) M.isSheaf
  intro x hx
  obtain ⟨V₀, hV₀, ⟨l, hl⟩, hxV₀⟩ :=
    (TopCat.Presheaf.isLocallySurjective_iff _).mp hsurj U m x hx
  obtain ⟨W, hxW, hW⟩ := exists_local_section_linearEquiv X L x
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hsub⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open
      (show x ∈ V₀ ⊓ W from ⟨hxV₀, hxW⟩) (V₀ ⊓ W).isOpen
  have hVV₀ : V ≤ V₀ := le_trans hsub inf_le_left
  have hVW : V ≤ W := le_trans hsub inf_le_right
  have hVU : V ≤ U := hVV₀.trans hV₀
  obtain ⟨e⟩ := hW V hVW
  refine ⟨V, hVU, hxV, ?_⟩
  have hπ : p.val.app (op V) (L.val.map (homOfLE hVV₀).op l) =
      M.val.map (homOfLE hVU).op m := by
    have h1 : p.val.app (op V) (L.val.map (homOfLE hVV₀).op l) =
        M.val.map (homOfLE hVV₀).op (p.val.app (op V₀) l) :=
      PresheafOfModules.naturality_apply p.val _ _
    have h2 : M.val.map (homOfLE hVV₀).op (p.val.app (op V₀) l) =
        M.val.map (homOfLE hVV₀).op (M.val.map (homOfLE hV₀).op m) :=
      congrArg (fun z => M.val.map (homOfLE hVV₀).op z) hl
    have hcomp : (homOfLE hV₀).op ≫ (homOfLE hVV₀).op = (homOfLE hVU).op :=
      Subsingleton.elim _ _
    have h3 : M.val.map (homOfLE hVV₀).op (M.val.map (homOfLE hV₀).op m) =
        M.val.map (homOfLE hVU).op m := by
      rw [← hcomp, M.val.map_comp_apply]
    exact (h1.trans h2).trans h3
  have hmem : X.presheaf.map (homOfLE hVU).op a ∈ I.ideal ⟨V, hV⟩ := by
    have h := map_app_eq_zero I hVU a ha'
    rw [← RingHom.mem_ker, I.ker_subschemeι_app ⟨V, hV⟩] at h
    exact h
  have hspan : X.presheaf.map (homOfLE hVU).op a ∈
      Ideal.span ({e (s.eval (op V))} : Set Γ(X, V)) :=
    zeroScheme_ideal_le_span X L s ⟨V, hV⟩ e hmem
  obtain ⟨b, hb⟩ := smul_eq_of_coordinate e (s.eval (op V))
    (L.val.map (homOfLE hVV₀).op l) (X.presheaf.map (homOfLE hVU).op a) hspan
  have hfin : (X.ringCatSheaf.obj.map (homOfLE hVU).op a) •
      p.val.app (op V) (L.val.map (homOfLE hVV₀).op l) = 0 :=
    smul_image_eq_zero ((p.val.app (op V)).hom) (s.eval (op V))
      (L.val.map (homOfLE hVV₀).op l) (X.ringCatSheaf.obj.map (homOfLE hVU).op a) b (hzs V) hb
  have step1 : M.val.map (homOfLE hVU).op (a • m) =
      (X.ringCatSheaf.obj.map (homOfLE hVU).op a) • M.val.map (homOfLE hVU).op m :=
    M.val.map_smul _ _ _
  have step2 :=
    congrArg (fun z => (X.ringCatSheaf.obj.map (homOfLE hVU).op a) • z) hπ
  simp only [map_zero]
  exact (step1.trans step2.symm).trans hfin


/-- A morphism out of the structure sheaf vanishing after `p` has its section killed by `p` over
every open. Stated over `SheafOfModules.{u} X.ringCatSheaf` because the hypothesis mentions the
zero morphism of a hom group, which has no `OfNat` instance at the `Scheme.Modules` spelling. -/
theorem app_eval_eq_zero_of_comp_eq_zero {X : Scheme.{u}}
    {L M : SheafOfModules.{u} X.ringCatSheaf} (s : L.sections) (p : L ⟶ M)
    (hp : L.unitHomEquiv.symm s ≫ p = 0) (V : X.Opens) :
    p.val.app (op V) (s.eval (op V)) = 0 := by
  have h : SheafOfModules.sectionsMap p (L.unitHomEquiv (L.unitHomEquiv.symm s)) =
      M.unitHomEquiv (0 : SheafOfModules.unit X.ringCatSheaf ⟶ M) :=
    congrArg M.unitHomEquiv hp
  rw [L.unitHomEquiv.apply_symm_apply] at h
  have hzero : (M.unitHomEquiv (0 : SheafOfModules.unit X.ringCatSheaf ⟶ M)).val (op V) = 0 := by
    show ((0 : SheafOfModules.unit X.ringCatSheaf ⟶ M).val.app (op V))
      (1 : X.ringCatSheaf.obj.obj (op V)) = 0
    rw [show (0 : SheafOfModules.unit X.ringCatSheaf ⟶ M).val = 0 from rfl,
      PresheafOfModules.zero_app]
    rfl
  exact (congrArg (fun t : M.sections => t.val (op V)) h).trans hzero

/-- The kernel ideal of `𝒪_X ⟶ i_* 𝒪_{Z(s)}` annihilates the cokernel of `s`. -/
private theorem ker_annihilates_cokernel (X : Scheme.{u}) (L : SheafOfModules.{u} X.ringCatSheaf)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L] (s : L.sections)
    (U : Opens X) (a : X.ringCatSheaf.obj.obj (op U))
    (ha : a ∈ RingHom.ker ((Stacks.RegularSectionSequence.zeroScheme X L
      (s.eval (op ⊤))).subschemeι.toLRSHom.c.app (op U)).hom)
    (m : (cokernel (L.unitHomEquiv.symm s)).val.obj (op U)) : a • m = 0 :=
  ker_annihilates X L s (cokernel (L.unitHomEquiv.symm s))
    (cokernel.π (L.unitHomEquiv.symm s))
    (by exact inferInstanceAs (Epi (C := SheafOfModules.{u} X.ringCatSheaf)
      (cokernel.π (L.unitHomEquiv.symm s))))
    (fun V => app_eval_eq_zero_of_comp_eq_zero s (cokernel.π (L.unitHomEquiv.symm s))
      (cokernel.condition _) V) U a ha m

/-- **The first assertion of Stacks Tag 0C6K's label `regular_section_sequence`, at the zero
scheme, with only `hz` remaining.** For `L` invertible and `s` a global section, the restriction
map `L ⟶ i_*(L|_{Z(s)})` is the cokernel of multiplication by `s`, given only that `s` restricts
to zero on `Z(s)`. -/
theorem exists_cokernelIso_zeroScheme (X : Scheme.{u}) (L : SheafOfModules.{u} X.ringCatSheaf)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L] (s : L.sections)
    (hz : L.unitHomEquiv.symm s ≫ Stacks.RegularSectionSequence.restrictionUnit
      (Stacks.RegularSectionSequence.zeroScheme X L (s.eval (op ⊤))) L = 0) :
    ∃ e : cokernel (L.unitHomEquiv.symm s) ≅
        (SheafOfModules.pushforward.{u} (Stacks.RegularSectionSequence.zeroScheme X L
            (s.eval (op ⊤))).subschemeι.toRingCatSheafHom).obj
          ((SheafOfModules.pullback.{u} (Stacks.RegularSectionSequence.zeroScheme X L
            (s.eval (op ⊤))).subschemeι.toRingCatSheafHom).obj L),
      cokernel.π (L.unitHomEquiv.symm s) ≫ e.hom =
        Stacks.RegularSectionSequence.restrictionUnit
          (Stacks.RegularSectionSequence.zeroScheme X L (s.eval (op ⊤))) L :=
  Stacks.Tag08KS.exists_cokernelIso_restrictionUnit_of_annihilated _ L _ hz
    (ker_annihilates_cokernel X L s)

/-- **The second assertion of Stacks Tag 0C6K's label `regular_section_sequence`, at the zero
scheme, with only `hz` remaining.** For `s` a *regular* section — regularity being monicity of
multiplication by `s`, Stacks Tag 01WY — the sequence `0 ⟶ 𝒪_X ⟶ L ⟶ i_*(L|_{Z(s)}) ⟶ 0` is
short exact, given only that `s` restricts to zero on `Z(s)`. -/
theorem shortExact_zeroScheme (X : Scheme.{u}) (L : SheafOfModules.{u} X.ringCatSheaf)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L] (s : L.sections)
    [Mono (L.unitHomEquiv.symm s)]
    (hz : L.unitHomEquiv.symm s ≫ Stacks.RegularSectionSequence.restrictionUnit
      (Stacks.RegularSectionSequence.zeroScheme X L (s.eval (op ⊤))) L = 0) :
    ∃ h : L.unitHomEquiv.symm s ≫ Stacks.RegularSectionSequence.restrictionUnit
        (Stacks.RegularSectionSequence.zeroScheme X L (s.eval (op ⊤))) L = 0,
      (ShortComplex.mk (L.unitHomEquiv.symm s)
        (Stacks.RegularSectionSequence.restrictionUnit
          (Stacks.RegularSectionSequence.zeroScheme X L (s.eval (op ⊤))) L) h).ShortExact :=
  Stacks.Tag08KS.shortExact_restrictionUnit_of_annihilated _ L _ hz
    (ker_annihilates_cokernel X L s)

end Stacks.Tag0C6KZeroSchemeAnnihilation

end
