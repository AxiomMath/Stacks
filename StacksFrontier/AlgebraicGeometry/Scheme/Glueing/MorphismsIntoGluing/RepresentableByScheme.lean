/-!
# Representability on locally ringed spaces

A sheaf for the Zariski topology on locally ringed spaces is represented by a scheme as soon as
it has a covering family of subfunctors, each represented by a scheme and each included by an
open immersion.

## Main definitions

* `AlgebraicGeometry.lrsIsOpenImmersion`: open immersions of locally ringed spaces, packaged as
  a morphism property.
* `AlgebraicGeometry.lrsZariskiTopology`: the topology of jointly surjective families of open
  immersions of locally ringed spaces.

## Main results

* `AlgebraicGeometry.lrsRepresentableByScheme`: such a functor is represented by a scheme.

## Implementation notes

The Zariski topology is induced by covers whose underlying spaces form an open cover and whose
maps are open immersions of locally ringed spaces. The conclusion specifies a representing
scheme, which also implies representability in the category of locally ringed spaces. The chart
index is small relative to the universe of schemes, as required to glue the representing charts
into a scheme in that universe.

The proof glues the representing schemes of the covering subfunctors along the relative
pullbacks supplied by `CategoryTheory.Functor.relativelyRepresentable`, recognises the glued
locally ringed space as a scheme, and identifies the functor with its functor of points by
checking that the comparison natural transformation is locally surjective and locally injective.
Both `CategoryTheory.Functor.relativelyRepresentable.pullback₃` and the gluing datum built here
are declared reducible at `implicit` transparency for the file, so that the relative pullback
objects and the gluing datum's index type reduce where the elaborator checks implicit arguments.

## References

* [Stacks Project, Tag 01JK](https://stacks.math.columbia.edu/tag/01JK)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

universe u v

attribute [local implicit_reducible]
  CategoryTheory.Functor.relativelyRepresentable.pullback₃

namespace AlgebraicGeometry

/-- Open immersions of locally ringed spaces, as a morphism property. -/
public abbrev lrsIsOpenImmersion : MorphismProperty LocallyRingedSpace.{u} :=
  @LocallyRingedSpace.IsOpenImmersion.{u}

/-- The Zariski topology on locally ringed spaces, generated by jointly
surjective families of open immersions. -/
public abbrev lrsZariskiTopology : GrothendieckTopology LocallyRingedSpace.{u} :=
  ((TopCat.precoverage.{u}).comap LocallyRingedSpace.forgetToTop ⊓
    lrsIsOpenImmersion.{u}.precoverage).toGrothendieck

private theorem range_pullback_fst_base_of_isOpenImmersion {X Y Z P : LocallyRingedSpace.{u}}
    (f : X ⟶ Z) [LocallyRingedSpace.IsOpenImmersion f] (g : Y ⟶ Z) {p₁ : P ⟶ Y} {p₂ : P ⟶ X}
    (h : IsPullback p₁ p₂ g f) : Set.range p₁.base = g.base ⁻¹' Set.range f.base := by
  let : CategoryTheory.Limits.PreservesLimit (CategoryTheory.Limits.cospan f g)
      LocallyRingedSpace.forgetToTop := by
    change CategoryTheory.Limits.PreservesLimit _
      (LocallyRingedSpace.forgetToSheafedSpace ⋙ SheafedSpace.forget CommRingCat)
    exact LocallyRingedSpace.IsOpenImmersion.forgetToTop_preservesPullback_of_left f g
  let : CategoryTheory.Limits.PreservesLimit (CategoryTheory.Limits.cospan g f)
      LocallyRingedSpace.forgetToTop :=
    CategoryTheory.Limits.preservesPullback_symmetry LocallyRingedSpace.forgetToTop f g
  have hTop : IsPullback p₁.base p₂.base g.base f.base := h.map LocallyRingedSpace.forgetToTop
  have he : Function.Surjective (hTop.isoPullback.hom.hom) :=
    (TopCat.epi_iff_surjective _).mp inferInstance
  rw [← hTop.isoPullback_hom_fst, TopCat.coe_comp, Function.Surjective.range_comp he,
    TopCat.pullback_fst_range]
  ext y
  simp only [Set.mem_preimage, Set.mem_range]
  exact ⟨fun ⟨x, hx⟩ => ⟨x, hx.symm⟩, fun ⟨x, hx⟩ => ⟨x, hx.symm⟩⟩

private theorem lrsZariskiPrecoverage_hasPullbacks :
    (TopCat.precoverage.{u}.comap LocallyRingedSpace.forgetToTop ⊓
      lrsIsOpenImmersion.{u}.precoverage).HasPullbacks := by
  constructor
  intro X Y R f hR
  refine ⟨fun {Z} g hg ↦ ?_⟩
  have : LocallyRingedSpace.IsOpenImmersion g := hR.2 hg
  infer_instance

private theorem lrsZariskiPrecoverage_isStableUnderBaseChange :
    (TopCat.precoverage.{u}.comap LocallyRingedSpace.forgetToTop ⊓
      lrsIsOpenImmersion.{u}.precoverage).IsStableUnderBaseChange := by
  constructor
  intro ι S X f hf Y g P p₁ p₂ h
  change (Presieve.ofArrows P p₁ ∈
      TopCat.precoverage.{u}.comap LocallyRingedSpace.forgetToTop Y) ∧
    Presieve.ofArrows P p₁ ∈ lrsIsOpenImmersion.{u}.precoverage Y
  rw [TopCat.precoverage, Precoverage.comap_inf, ← Precoverage.comap_comp] at hf
  have hp₁ (i : ι) : LocallyRingedSpace.IsOpenImmersion (p₁ i) := by
    have : LocallyRingedSpace.IsOpenImmersion (f i) := hf.2 ⟨i⟩
    rw [← (h i).isoPullback_hom_fst]
    infer_instance
  refine ⟨?_, ?_⟩
  · rw [TopCat.precoverage, Precoverage.comap_inf, ← Precoverage.comap_comp]
    refine ⟨?_, ?_⟩
    · apply (Presieve.ofArrows_mem_comap_jointlySurjectivePrecoverage_iff
        (LocallyRingedSpace.forgetToTop ⋙ forget TopCat)).2
      intro y
      obtain ⟨i, x, hx⟩ := (Presieve.ofArrows_mem_comap_jointlySurjectivePrecoverage_iff
        (LocallyRingedSpace.forgetToTop ⋙ forget TopCat)).1 hf.1.1 (g.base y)
      have : LocallyRingedSpace.IsOpenImmersion (f i) := hf.2 ⟨i⟩
      obtain ⟨z, hz⟩ : y ∈ Set.range (p₁ i).base := by
        rw [range_pullback_fst_base_of_isOpenImmersion (f i) g (h i)]
        exact ⟨x, hx⟩
      exact ⟨i, z, hz⟩
    · change Presieve.map LocallyRingedSpace.forgetToTop
        (Presieve.ofArrows P p₁) ∈ TopCat.isOpenEmbedding.precoverage _
      rw [Presieve.map_ofArrows, MorphismProperty.ofArrows_mem_precoverage]
      exact fun i ↦ (hp₁ i).base_open
  · rw [MorphismProperty.ofArrows_mem_precoverage]
    exact hp₁

private instance schemeForgetContinuous :
    Functor.IsContinuous (Scheme.forgetToLocallyRingedSpace.{u})
      (Scheme.zariskiTopology.{u}) (lrsZariskiTopology.{u}) := by
  have : Precoverage.PullbacksPreservedBy
      (Scheme.precoverage IsOpenImmersion)
      Scheme.forgetToLocallyRingedSpace := by
    refine ⟨fun _ _ hR ↦ ⟨fun _ _ f _ hf _ ↦ ?_⟩⟩
    have : IsOpenImmersion f := hR.2 hf
    infer_instance
  have := lrsZariskiPrecoverage_hasPullbacks.{u}
  have := lrsZariskiPrecoverage_isStableUnderBaseChange.{u}
  change Functor.IsContinuous (Scheme.forgetToLocallyRingedSpace.{u})
    (Scheme.precoverage.{u} IsOpenImmersion).toGrothendieck
    (TopCat.precoverage.{u}.comap LocallyRingedSpace.forgetToTop ⊓
      lrsIsOpenImmersion.{u}.precoverage).toGrothendieck
  apply Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy
    (F := Scheme.forgetToLocallyRingedSpace)
    (J := Scheme.precoverage IsOpenImmersion)
    (K := TopCat.precoverage.{u}.comap LocallyRingedSpace.forgetToTop ⊓
      lrsIsOpenImmersion.{u}.precoverage)
  change (Types.jointlySurjectivePrecoverage.comap
        (Scheme.forgetToTop ⋙ forget TopCat) ⊓
      (show MorphismProperty Scheme from @IsOpenImmersion).precoverage) ≤
    (TopCat.precoverage.{u}.comap LocallyRingedSpace.forgetToTop).comap
        Scheme.forgetToLocallyRingedSpace ⊓
      (lrsIsOpenImmersion.{u}.precoverage).comap
        Scheme.forgetToLocallyRingedSpace
  intro X R hR
  refine ⟨?_, ?_⟩
  · rw [← Precoverage.comap_comp]
    change R ∈ TopCat.precoverage.comap Scheme.forgetToTop X
    rw [TopCat.precoverage]
    refine ⟨?_, ?_⟩
    · have hR1 := hR.1
      change R ∈ (Types.jointlySurjectivePrecoverage.comap
        (Scheme.forgetToTop ⋙ forget TopCat)) X at hR1
      rw [Precoverage.comap_comp] at hR1
      exact hR1
    · intro Y f hf
      obtain ⟨Z, rfl, f₀, hf₀, heq⟩ := Presieve.map_iff.mp hf
      rw [eqToHom_refl, Category.id_comp] at heq
      have hfi : IsOpenImmersion f₀ := hR.2 hf₀
      rw [← heq]
      exact f₀.isOpenEmbedding
  · rw [MorphismProperty.comap_precoverage]
    exact fun _ _ hf => hR.2 hf


/-- An open subspace of a scheme, presented as a locally ringed space, inherits a scheme
structure from the ambient scheme. -/
private noncomputable def schemeOfOpenImmersion
    {U : LocallyRingedSpace.{u}} {X : Scheme.{u}}
    (f : U ⟶ X.toLocallyRingedSpace)
    [LocallyRingedSpace.IsOpenImmersion f] : Scheme.{u} :=
  PresheafedSpace.IsOpenImmersion.toScheme X f.toHom

private theorem schemeOfOpenImmersion_toLocallyRingedSpace
    {U : LocallyRingedSpace.{u}} {X : Scheme.{u}}
    (f : U ⟶ X.toLocallyRingedSpace)
    [LocallyRingedSpace.IsOpenImmersion f] :
    (schemeOfOpenImmersion f).toLocallyRingedSpace = U := by
  rw [schemeOfOpenImmersion,
    PresheafedSpace.IsOpenImmersion.toScheme_toLocallyRingedSpace]
  exact PresheafedSpace.IsOpenImmersion.locallyRingedSpace_toLocallyRingedSpace f

private noncomputable def schemeOfOpenImmersion_map
    {U : LocallyRingedSpace.{u}} {X : Scheme.{u}}
    (f : U ⟶ X.toLocallyRingedSpace)
    [LocallyRingedSpace.IsOpenImmersion f] :
    schemeOfOpenImmersion f ⟶ X :=
  Scheme.fullyFaithfulForgetToLocallyRingedSpace.preimage
    (X := schemeOfOpenImmersion f) (Y := X)
    (eqToHom (schemeOfOpenImmersion_toLocallyRingedSpace f) ≫ f)

private theorem schemeOfOpenImmersion_map_toLRSHom
    {U : LocallyRingedSpace.{u}} {X : Scheme.{u}}
    (f : U ⟶ X.toLocallyRingedSpace)
    [LocallyRingedSpace.IsOpenImmersion f] :
    (schemeOfOpenImmersion_map f).toLRSHom = f :=
  rfl

private theorem schemeOfOpenImmersion_map_open
    {U : LocallyRingedSpace.{u}} {X : Scheme.{u}}
    (f : U ⟶ X.toLocallyRingedSpace)
    [LocallyRingedSpace.IsOpenImmersion f] :
    IsOpenImmersion (schemeOfOpenImmersion_map f) :=
  (inferInstance : LocallyRingedSpace.IsOpenImmersion f)

private theorem schemeOfOpenImmersion_cover_mem {T : Scheme.{u}} {ι : Type u}
    {V : ι → LocallyRingedSpace.{u}} (g : (i : ι) → V i ⟶ T.toLocallyRingedSpace)
    [hopen : ∀ i, LocallyRingedSpace.IsOpenImmersion (g i)]
    (hg : ∀ x : T, ∃ i y, (g i).base y = x) :
    Sieve.ofArrows (fun i ↦ schemeOfOpenImmersion (g i))
      (fun i ↦ schemeOfOpenImmersion_map (g i)) ∈ Scheme.zariskiTopology T := by
  refine (Scheme.Cover.mkOfCovers ι (fun i ↦ schemeOfOpenImmersion (g i))
    (fun i ↦ schemeOfOpenImmersion_map (g i)) (fun x ↦ ?_)
    fun i ↦ schemeOfOpenImmersion_map_open (g i)).mem_grothendieckTopology
  obtain ⟨i, y, hy⟩ := hg x
  refine ⟨i, (eqToHom (schemeOfOpenImmersion_toLocallyRingedSpace (g i)).symm).base y, ?_⟩
  have hb := congrArg (fun φ : V i ⟶ T.toLocallyRingedSpace => φ.base)
    (schemeOfOpenImmersion_map_toLRSHom (g i))
  change (schemeOfOpenImmersion_map (g i)).base
    ((eqToHom (schemeOfOpenImmersion_toLocallyRingedSpace (g i)).symm).base y) = x
  rw [hb]
  exact hy

private abbrev lrsZariskiPrecoverage : Precoverage LocallyRingedSpace.{u} :=
  TopCat.precoverage.comap LocallyRingedSpace.forgetToTop ⊓
    lrsIsOpenImmersion.{u}.precoverage

private theorem lrsPresieveCover_schemeCover {T : Scheme.{u}}
    (R : Presieve T.toLocallyRingedSpace)
    (hR : R ∈ lrsZariskiPrecoverage.{u} T.toLocallyRingedSpace) :
    ∃ (ι : Type u) (U : ι → Scheme.{u}) (f : (i : ι) → U i ⟶ T),
      Sieve.ofArrows U f ∈ Scheme.zariskiTopology T ∧
      ∀ i, R (f i).toLRSHom := by
  have htop := hR.1
  rw [TopCat.precoverage, Precoverage.comap_inf,
    ← Precoverage.comap_comp] at htop
  choose V g hRg hpt using (Presieve.mem_comap_jointlySurjectivePrecoverage_iff
    (LocallyRingedSpace.forgetToTop ⋙ forget TopCat)).1 htop.1
  have hg (x : T) : LocallyRingedSpace.IsOpenImmersion (g x) := hR.2 (hRg x)
  refine ⟨T, _, _, schemeOfOpenImmersion_cover_mem g (hopen := hg)
    fun x ↦ ⟨x, Set.mem_range.mp (hpt x)⟩, hRg⟩

private theorem lrsZariski_sieve_has_open_refinement
    {X : LocallyRingedSpace.{u}} {S : Sieve X}
    (hS : S ∈ lrsZariskiTopology X) (x : X) :
    ∃ (Y : LocallyRingedSpace.{u}) (f : Y ⟶ X),
      LocallyRingedSpace.IsOpenImmersion f ∧
      x ∈ Set.range f.base ∧ S f := by
  change lrsZariskiPrecoverage.Saturate X S at hS
  induction hS with
  | of X R hR =>
      have htop := hR.1
      rw [TopCat.precoverage, Precoverage.comap_inf,
        ← Precoverage.comap_comp] at htop
      obtain ⟨Y, f, hf, ⟨y, hy⟩⟩ := (Presieve.mem_comap_jointlySurjectivePrecoverage_iff
        (LocallyRingedSpace.forgetToTop ⋙ forget TopCat)).1 htop.1 x
      exact ⟨Y, f, hR.2 hf, ⟨y, hy⟩, Sieve.le_generate R Y f hf⟩
  | top X =>
      exact ⟨X, 𝟙 X, inferInstance, ⟨x, rfl⟩, by simp⟩
  | pullback X S hS Y g ih =>
      obtain ⟨V, f, hf, ⟨v, hv⟩, hmem⟩ := ih (g.base x)
      have : LocallyRingedSpace.IsOpenImmersion f := hf
      obtain ⟨z, hz⟩ : x ∈ Set.range (Limits.pullback.fst g f).base := by
        rw [range_pullback_fst_base_of_isOpenImmersion f g (IsPullback.of_hasPullback g f)]
        exact ⟨v, hv⟩
      refine ⟨_, Limits.pullback.fst g f, inferInstance, ⟨z, hz⟩, ?_⟩
      change S (Limits.pullback.fst g f ≫ g)
      rw [Limits.pullback.condition]
      exact S.downward_closed hmem _
  | transitive X S R hS hR ihS ihR =>
      obtain ⟨Y, f, hf, ⟨y, hy⟩, hmem⟩ := ihS x
      obtain ⟨Z, g, hg, ⟨z, hz⟩, hlocal⟩ := ihR hmem y
      exact ⟨Z, g ≫ f, LocallyRingedSpace.IsOpenImmersion.comp g f,
        ⟨z, (congrArg f.base hz).trans hy⟩, by simpa [Sieve.pullback_apply] using hlocal⟩

private theorem schemeForget_cocontinuous :
    Scheme.forgetToLocallyRingedSpace.{u}.IsCocontinuous
      Scheme.zariskiTopology.{u} lrsZariskiTopology.{u} := by
  constructor
  intro T S hS
  choose V g hg hpt hmem using lrsZariski_sieve_has_open_refinement hS
  refine Scheme.zariskiTopology.superset_covering ?_
    (schemeOfOpenImmersion_cover_mem g (hopen := hg) fun x ↦ ⟨x, Set.mem_range.mp (hpt x)⟩)
  rw [Sieve.ofArrows, Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
  exact hmem

private noncomputable def chartMap
    {F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u} (H : Subfunctor F)
    {S : Scheme.{u}} (e : (H.toFunctor).RepresentableBy S.toLocallyRingedSpace) :
    yoneda.obj S ⟶ Scheme.forgetToLocallyRingedSpace.op ⋙ F :=
  yonedaEquiv.symm
    (H.ι.app (op S.toLocallyRingedSpace) (e.homEquiv (𝟙 S.toLocallyRingedSpace)))

private def lrsChartMap
    {F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u} (H : Subfunctor F)
    {S : Scheme.{u}} (e : (H.toFunctor).RepresentableBy S.toLocallyRingedSpace) :
    yoneda.obj S.toLocallyRingedSpace ⟶ F :=
  yonedaEquiv.symm
    (H.ι.app (op S.toLocallyRingedSpace)
      (e.homEquiv (𝟙 S.toLocallyRingedSpace)))

private theorem lrsChartMap_app
    {F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u} (H : Subfunctor F)
    {S : Scheme.{u}} (e : (H.toFunctor).RepresentableBy S.toLocallyRingedSpace)
    {T : LocallyRingedSpace.{u}} (f : T ⟶ S.toLocallyRingedSpace) :
    (lrsChartMap H e).app (op T) f =
      H.ι.app (op T) (e.homEquiv f) := by
  change F.map f.op
      (H.ι.app (op S.toLocallyRingedSpace)
        (e.homEquiv (𝟙 S.toLocallyRingedSpace))) = _
  rw [← H.ι.naturality_apply]
  congr 1
  rw [← e.homEquiv_comp]
  simp

private theorem lrsChartMap_app_injective
    {F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u} (H : Subfunctor F)
    {S T : Scheme.{u}} (e : (H.toFunctor).RepresentableBy S.toLocallyRingedSpace)
    {f g : T.toLocallyRingedSpace ⟶ S.toLocallyRingedSpace}
    (h : (lrsChartMap H e).app (op T.toLocallyRingedSpace) f =
      (lrsChartMap H e).app (op T.toLocallyRingedSpace) g) : f = g :=
  e.homEquiv.injective <| Subtype.val_injective <| by
    rwa [lrsChartMap_app, lrsChartMap_app] at h

private theorem lrsChartMap_eq_iso_hom
    {F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u} (H : Subfunctor F)
    {S : Scheme.{u}} (e : (H.toFunctor).RepresentableBy S.toLocallyRingedSpace) :
    lrsChartMap H e = e.toIso.hom ≫ H.ι := by
  ext T f
  exact lrsChartMap_app H e f

private theorem lrsChartMap_isOpenImmersion
    {F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u} (H : Subfunctor F)
    {S : Scheme.{u}} (e : (H.toFunctor).RepresentableBy S.toLocallyRingedSpace)
    (hopen : (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) H.ι) :
    (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (lrsChartMap H e) := by
  have hIso : Arrow.mk H.ι ≅ Arrow.mk (lrsChartMap H e) :=
    Arrow.isoMk e.toIso.symm (Iso.refl _) (by
      rw [lrsChartMap_eq_iso_hom]
      simp)
  exact (lrsIsOpenImmersion.{u}.presheaf.arrow_mk_iso_iff hIso).1 hopen

private abbrev restrictToSchemes
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u) : Scheme.{u}ᵒᵖ ⥤ Type u :=
  Scheme.forgetToLocallyRingedSpace.op ⋙ F

private def restrictSubfunctor
    {F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u} (H : Subfunctor F) :
  Subfunctor (restrictToSchemes F) where
  obj X := H.obj ((Scheme.forgetToLocallyRingedSpace.op).obj X)
  map f := H.map (Scheme.forgetToLocallyRingedSpace.op.map f)

private noncomputable def restrictRepresentableBy
    {F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u} (H : Subfunctor F)
    {S : Scheme.{u}} (e : H.toFunctor.RepresentableBy S.toLocallyRingedSpace) :
    (restrictSubfunctor H).toFunctor.RepresentableBy S where
  homEquiv := Scheme.fullyFaithfulForgetToLocallyRingedSpace.homEquiv.trans e.homEquiv
  homEquiv_comp f g := by
    apply Subtype.ext
    change (e.homEquiv (Scheme.forgetToLocallyRingedSpace.map (f ≫ g))).val =
      (H.toFunctor.map (Scheme.forgetToLocallyRingedSpace.map f).op
        (e.homEquiv (Scheme.forgetToLocallyRingedSpace.map g))).val
    rw [Scheme.forgetToLocallyRingedSpace.map_comp]
    exact congrArg Subtype.val
      (e.homEquiv_comp (Scheme.forgetToLocallyRingedSpace.map f)
        (Scheme.forgetToLocallyRingedSpace.map g))

private noncomputable def schemeChartMap
    {F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u} (H : Subfunctor F)
    {S : Scheme.{u}} (e : H.toFunctor.RepresentableBy S.toLocallyRingedSpace) :
    yoneda.obj S ⟶ restrictToSchemes F :=
  yonedaEquiv.symm
    ((restrictSubfunctor H).ι.app (op S)
      ((restrictRepresentableBy H e).homEquiv (𝟙 S)))

private theorem schemeChartMap_eq_chartMap
    {F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u} (H : Subfunctor F)
    {S : Scheme.{u}} (e : H.toFunctor.RepresentableBy S.toLocallyRingedSpace) :
    schemeChartMap H e = chartMap H e :=
  yonedaEquiv.injective rfl

private theorem restrictSheaf
    {F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u}
    (hF : Presheaf.IsSheaf lrsZariskiTopology F) :
    Presheaf.IsSheaf Scheme.zariskiTopology (restrictToSchemes F) :=
  Scheme.forgetToLocallyRingedSpace.op_comp_isSheaf_of_isSheaf
    Scheme.zariskiTopology lrsZariskiTopology F hF

private theorem chartMap_app_eq_lrsChartMap_app
    {F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u} (H : Subfunctor F)
    {S T : Scheme.{u}} (e : H.toFunctor.RepresentableBy S.toLocallyRingedSpace)
    (f : T ⟶ S) :
    (chartMap H e).app (op T) f =
      (lrsChartMap H e).app (op T.toLocallyRingedSpace)
        f.toLRSHom :=
  rfl

private theorem chartMap_app
    {F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u} (H : Subfunctor F)
    {S T : Scheme.{u}} (e : H.toFunctor.RepresentableBy S.toLocallyRingedSpace)
    (f : T ⟶ S) :
    (chartMap H e).app (op T) f =
      H.ι.app (op T.toLocallyRingedSpace)
        (e.homEquiv (Scheme.forgetToLocallyRingedSpace.map f)) :=
  (chartMap_app_eq_lrsChartMap_app H e f).trans (lrsChartMap_app H e f.toLRSHom)

@[ega "I 2.2.3" "more general"]
private theorem lrsOpenImmersion_le_monomorphisms :
    lrsIsOpenImmersion.{u} ≤
      MorphismProperty.monomorphisms LocallyRingedSpace.{u} := by
  intro X Y f hf
  let : LocallyRingedSpace.IsOpenImmersion f := hf
  exact MorphismProperty.monomorphisms.infer_property f

private theorem lrsGlueData_f_open
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    {ι : Type u} {X : ι → LocallyRingedSpace.{u}}
    (f : (i : ι) → yoneda.obj (X i) ⟶ F)
    (hf : ∀ i, (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (f i)) (i j : ι) :
    LocallyRingedSpace.IsOpenImmersion ((hf i).rep.fst' (f j)) :=
  (hf j).property (f i) (yoneda.map ((hf i).rep.snd (f j)))
    ((hf i).rep.fst' (f j)) ((hf i).1.isPullback' (f j)).flip

private noncomputable def lrsGlueData
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    {ι : Type u} {X : ι → LocallyRingedSpace.{u}}
    (f : (i : ι) → yoneda.obj (X i) ⟶ F)
    (hf : ∀ i, (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (f i)) :
    LocallyRingedSpace.GlueData where
  J := ι
  U := X
  V := fun (i, j) ↦ (hf i).rep.pullback (f j)
  f i j := (hf i).rep.fst' (f j)
  f_mono i j := by
    let := lrsGlueData_f_open F f hf i j
    infer_instance
  f_hasPullback i j k := by
    let := lrsGlueData_f_open F f hf i j
    infer_instance
  f_id i := MorphismProperty.isIso_fst'_self lrsOpenImmersion_le_monomorphisms (hf i)
  t i j := (hf i).rep.symmetry (hf j).rep
  t_id i := by
    apply (hf i).rep.hom_ext' <;>
      simp [MorphismProperty.fst'_self_eq_snd
        lrsOpenImmersion_le_monomorphisms (hf i)]
  t' i j k := by
    letI := lrsGlueData_f_open F f hf i j
    letI := lrsGlueData_f_open F f hf i k
    letI := lrsGlueData_f_open F f hf j k
    letI := lrsGlueData_f_open F f hf j i
    exact Functor.relativelyRepresentable.lift₃ _ _ _
      (Functor.relativelyRepresentable.pullback₃.p₂ _ _ _)
      (Functor.relativelyRepresentable.pullback₃.p₃ _ _ _)
      (Functor.relativelyRepresentable.pullback₃.p₁ _ _ _)
      ((Functor.relativelyRepresentable.pullback₃.map_p₂_comp
        ((hf i).rep) (f j) (f k)).trans
        (Functor.relativelyRepresentable.pullback₃.map_p₃_comp
          ((hf i).rep) (f j) (f k)).symm)
      ((Functor.relativelyRepresentable.pullback₃.map_p₂_comp
        ((hf i).rep) (f j) (f k)).trans
        (Functor.relativelyRepresentable.pullback₃.map_p₁_comp
          ((hf i).rep) (f j) (f k)).symm)
  t_fac i j k := by
    let := lrsGlueData_f_open F f hf i j
    let := lrsGlueData_f_open F f hf i k
    let := lrsGlueData_f_open F f hf j k
    let := lrsGlueData_f_open F f hf j i
    exact (hf j).rep.hom_ext'
      (by
        rw [Category.assoc,
          Functor.relativelyRepresentable.pullback₃.snd_fst'_eq_p₁,
          Functor.relativelyRepresentable.lift₃_p₁]
        simp only [Category.assoc, Functor.relativelyRepresentable.symmetry_fst,
          ← Functor.relativelyRepresentable.pullback₃.fst_snd_eq_p₂])
      (by
        rw [Category.assoc,
          Functor.relativelyRepresentable.pullback₃.snd_snd_eq_p₃,
          Functor.relativelyRepresentable.lift₃_p₃]
        simp only [Category.assoc, Functor.relativelyRepresentable.symmetry_snd,
          ← Functor.relativelyRepresentable.pullback₃.fst_fst'_eq_p₁])
  cocycle i j k := by
    let := lrsGlueData_f_open F f hf i j
    let := lrsGlueData_f_open F f hf i k
    let := lrsGlueData_f_open F f hf j k
    let := lrsGlueData_f_open F f hf j i
    let := lrsGlueData_f_open F f hf k i
    let := lrsGlueData_f_open F f hf k j
    exact Functor.relativelyRepresentable.pullback₃.hom_ext
      (by
        rw [Category.assoc, Category.assoc,
          Functor.relativelyRepresentable.lift₃_p₁,
          Functor.relativelyRepresentable.lift₃_p₂,
          Functor.relativelyRepresentable.lift₃_p₃, Category.id_comp])
      (by
        rw [Category.assoc, Category.assoc,
          Functor.relativelyRepresentable.lift₃_p₂,
          Functor.relativelyRepresentable.lift₃_p₃,
          Functor.relativelyRepresentable.lift₃_p₁, Category.id_comp])
      (by
        rw [Category.assoc, Category.assoc,
          Functor.relativelyRepresentable.lift₃_p₃,
          Functor.relativelyRepresentable.lift₃_p₁,
          Functor.relativelyRepresentable.lift₃_p₂, Category.id_comp])
  f_open i j := lrsGlueData_f_open F f hf i j

attribute [local implicit_reducible] lrsGlueData

private theorem lrsGlueData_charts_compatible
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    {ι : Type u} {X : ι → LocallyRingedSpace.{u}}
    (f : (i : ι) → yoneda.obj (X i) ⟶ F)
    (hf : ∀ i, (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (f i)) (i j : ι) :
    F.map ((lrsGlueData F f hf).f i j).op (yonedaEquiv (f i)) =
      F.map ((lrsGlueData F f hf).t i j ≫ (lrsGlueData F f hf).f j i).op
        (yonedaEquiv (f j)) := by
  apply yonedaEquiv.symm.injective
  dsimp [lrsGlueData]
  rw [yonedaEquiv_naturality, Equiv.symm_apply_apply,
    Functor.map_comp_apply, yonedaEquiv_naturality, yonedaEquiv_naturality,
    Equiv.symm_apply_apply, ← Functor.map_comp_assoc,
    Functor.relativelyRepresentable.symmetry_fst,
    ((hf i).rep.isPullback' (f j)).w]

private theorem lrsGlueData_charts_arrowCompatible
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    {ι : Type u} {X : ι → LocallyRingedSpace.{u}}
    (f : (i : ι) → yoneda.obj (X i) ⟶ F)
    (hf : ∀ i, (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (f i)) :
    Presieve.Arrows.Compatible F (lrsGlueData F f hf).toGlueData.ι
      (fun i ↦ yonedaEquiv (f i)) := by
  let D := lrsGlueData F f hf
  intro i j T a b hab
  change ι at i j
  let hc := D.vPullbackConeIsLimit i j
  obtain ⟨w, hw₁, hw₂⟩ := CategoryTheory.Limits.PullbackCone.IsLimit.lift' hc a b hab
  change w ≫ D.toGlueData.f i j = a at hw₁
  change w ≫ (D.toGlueData.t i j ≫ D.toGlueData.f j i) = b at hw₂
  calc
    F.map a.op (yonedaEquiv (f i)) =
        F.map (w ≫ D.toGlueData.f i j).op (yonedaEquiv (f i)) := by rw [hw₁]
    _ = F.map w.op (F.map (D.toGlueData.f i j).op (yonedaEquiv (f i))) :=
      F.map_comp_apply _ _ _
    _ = F.map w.op
        (F.map (D.toGlueData.t i j ≫ D.toGlueData.f j i).op (yonedaEquiv (f j))) := by
      rw [lrsGlueData_charts_compatible F f hf i j]
    _ = F.map (w ≫ (D.toGlueData.t i j ≫ D.toGlueData.f j i)).op
        (yonedaEquiv (f j)) := (F.map_comp_apply _ _ _).symm
    _ = F.map b.op (yonedaEquiv (f j)) := by rw [hw₂]

private theorem lrsOpenCover_sieve_mem {T : LocallyRingedSpace.{u}}
    {ι : Type u} (U : ι → LocallyRingedSpace.{u}) (f : (i : ι) → U i ⟶ T)
    (hopen : ∀ i, LocallyRingedSpace.IsOpenImmersion (f i))
    (hsurj : ∀ x : T, ∃ i y, (f i).base y = x) :
    Sieve.ofArrows U f ∈ lrsZariskiTopology T := by
  apply lrsZariskiPrecoverage.generate_mem_toGrothendieck
  refine ⟨?_, ?_⟩
  · rw [TopCat.precoverage, Precoverage.comap_inf, ← Precoverage.comap_comp]
    refine ⟨?_, ?_⟩
    · exact (Presieve.ofArrows_mem_comap_jointlySurjectivePrecoverage_iff
        (LocallyRingedSpace.forgetToTop ⋙ forget TopCat)).2 hsurj
    · rw [MorphismProperty.comap_precoverage,
        MorphismProperty.ofArrows_mem_precoverage]
      exact fun i ↦ (hopen i).base_open
  · rw [MorphismProperty.ofArrows_mem_precoverage]
    exact hopen

private theorem lrsGlueData_cover (D : LocallyRingedSpace.GlueData.{u}) :
    Sieve.ofArrows D.U D.toGlueData.ι ∈
      lrsZariskiTopology (D.toGlueData.glued) :=
  lrsOpenCover_sieve_mem D.U D.toGlueData.ι D.ι_isOpenImmersion D.ι_jointly_surjective

private theorem isSheafFor_ofArrows_of_openCover {F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u}
    (hF : Presheaf.IsSheaf lrsZariskiTopology F) {T : LocallyRingedSpace.{u}} {ι : Type u}
    (U : ι → LocallyRingedSpace.{u}) (f : (i : ι) → U i ⟶ T)
    (hopen : ∀ i, LocallyRingedSpace.IsOpenImmersion (f i))
    (hsurj : ∀ x : T, ∃ i y, (f i).base y = x) :
    (Presieve.ofArrows U f).IsSheafFor F := by
  rw [Presieve.isSheafFor_iff_generate]
  exact hF.isSheafFor _ (lrsOpenCover_sieve_mem U f hopen hsurj)

private theorem lrsGlueData_existsUnique_amalgamation
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    (hF : Presheaf.IsSheaf lrsZariskiTopology F)
    {ι : Type u} {X : ι → LocallyRingedSpace.{u}}
    (f : (i : ι) → yoneda.obj (X i) ⟶ F)
    (hf : ∀ i, (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (f i)) :
    ∃! t : F.obj (op (lrsGlueData F f hf).toGlueData.glued),
      ∀ i : ι, F.map ((lrsGlueData F f hf).toGlueData.ι i).op t = yonedaEquiv (f i) :=
  (Presieve.isSheafFor_arrows_iff F (lrsGlueData F f hf).toGlueData.ι).mp
    (isSheafFor_ofArrows_of_openCover hF _ _ (lrsGlueData F f hf).ι_isOpenImmersion
      (lrsGlueData F f hf).ι_jointly_surjective)
    (fun i ↦ yonedaEquiv (f i)) (lrsGlueData_charts_arrowCompatible F f hf)

private noncomputable def lrsGlueData_sheafValGluedMk
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    (hF : Presheaf.IsSheaf lrsZariskiTopology F)
    {ι : Type u} {X : ι → LocallyRingedSpace.{u}}
    (f : (i : ι) → yoneda.obj (X i) ⟶ F)
    (hf : ∀ i, (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (f i)) :
    F.obj (op (lrsGlueData F f hf).toGlueData.glued) := by
  exact (lrsGlueData_existsUnique_amalgamation F hF f hf).exists.choose

private theorem lrsGlueData_sheafValGluedMk_restrict
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    (hF : Presheaf.IsSheaf lrsZariskiTopology F)
    {ι : Type u} {X : ι → LocallyRingedSpace.{u}}
    (f : (i : ι) → yoneda.obj (X i) ⟶ F)
    (hf : ∀ i, (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (f i)) (i : ι) :
    F.map ((lrsGlueData F f hf).toGlueData.ι i).op
      (lrsGlueData_sheafValGluedMk F hF f hf) = yonedaEquiv (f i) :=
  (lrsGlueData_existsUnique_amalgamation F hF f hf).exists.choose_spec i

private noncomputable def lrsGlueData_vPullbackConeIsLimit
    (D : LocallyRingedSpace.GlueData.{u}) (i j : D.J) :
    CategoryTheory.Limits.IsLimit (D.toGlueData.vPullbackCone i j) :=
  D.toGlueData.vPullbackConeIsLimitOfMap LocallyRingedSpace.forgetToSheafedSpace i j
    (D.toSheafedSpaceGlueData.vPullbackConeIsLimit i j)

private noncomputable def lrsGlueData_gluedScheme
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    {ι : Type u} {X : ι → Scheme.{u}}
    (f : (i : ι) → yoneda.obj (X i).toLocallyRingedSpace ⟶ F)
    (hf : ∀ i, (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (f i)) : Scheme.{u} := by
  let D := lrsGlueData F (fun i ↦ f i) hf
  letI (i : D.J) : LocallyRingedSpace.IsOpenImmersion (D.ι i) :=
    D.ι_isOpenImmersion i
  exact LocallyRingedSpace.IsOpenImmersion.scheme D.toGlueData.glued (fun x ↦ by
    obtain ⟨i, y, hy⟩ := D.ι_jointly_surjective x
    obtain ⟨j, z, hz⟩ := (X i).affineCover.exists_eq y
    refine ⟨_, ((X i).affineCover.f j).toLRSHom ≫ D.toGlueData.ι i,
      ⟨z, (congrArg (D.toGlueData.ι i).base hz).trans hy⟩, ?_⟩
    let : IsOpenImmersion ((X i).affineCover.f j) := (X i).affineCover.map_prop j
    let : LocallyRingedSpace.IsOpenImmersion ((X i).affineCover.f j).toLRSHom := inferInstance
    exact @LocallyRingedSpace.IsOpenImmersion.comp _ _ _
      ((X i).affineCover.f j).toLRSHom inferInstance (D.ι i) (D.ι_isOpenImmersion i))

private noncomputable def lrsGlueData_yonedaGluedToF
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    (hF : Presheaf.IsSheaf lrsZariskiTopology F)
    {ι : Type u} {X : ι → Scheme.{u}}
    (f : (i : ι) → yoneda.obj (X i).toLocallyRingedSpace ⟶ F)
    (hf : ∀ i, (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (f i)) :
    yoneda.obj (lrsGlueData_gluedScheme F f hf).toLocallyRingedSpace ⟶ F :=
  yonedaEquiv.symm (lrsGlueData_sheafValGluedMk F hF f hf)

private theorem lrsGlueData_yoneda_toGlued_yonedaGluedToF
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    (hF : Presheaf.IsSheaf lrsZariskiTopology F)
    {ι : Type u} {X : ι → Scheme.{u}}
    (f : (i : ι) → yoneda.obj (X i).toLocallyRingedSpace ⟶ F)
    (hf : ∀ i, (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (f i)) (i : ι) :
    yoneda.map ((lrsGlueData F f hf).toGlueData.ι i) ≫
      lrsGlueData_yonedaGluedToF F hF f hf = f i :=
  yonedaEquiv.injective (lrsGlueData_sheafValGluedMk_restrict F hF f hf i)

private theorem lrsGlueData_comp_toGlued_eq
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    {ι : Type u} {X : ι → LocallyRingedSpace.{u}}
    (f : (i : ι) → yoneda.obj (X i) ⟶ F)
    (hf : ∀ i, (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (f i))
    {T : LocallyRingedSpace.{u}} {i j : ι}
    (a : T ⟶ X i) (b : T ⟶ X j)
    (h : yoneda.map a ≫ f i = yoneda.map b ≫ f j) :
    a ≫ (lrsGlueData F f hf).toGlueData.ι i =
      b ≫ (lrsGlueData F f hf).toGlueData.ι j := by
  let D := lrsGlueData F f hf
  rw [← (hf i).rep.lift'_fst a b h, Category.assoc]
  conv_rhs => rw [← (hf i).rep.lift'_snd a b h, Category.assoc]
  congr 1
  simpa [D, lrsGlueData] using (D.toGlueData.glue_condition i j).symm

private theorem lrsGlueData_yonedaGluedToF_app_comp_ι
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    (hF : Presheaf.IsSheaf lrsZariskiTopology F)
    {ι : Type u} {X : ι → Scheme.{u}}
    (f : (i : ι) → yoneda.obj (X i).toLocallyRingedSpace ⟶ F)
    (hf : ∀ i, (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (f i)) {V : LocallyRingedSpace.{u}} (i : ι)
    (c : V ⟶ (X i).toLocallyRingedSpace) :
    (lrsGlueData_yonedaGluedToF F hF f hf).app (op V)
      (c ≫ (lrsGlueData F f hf).toGlueData.ι i) = (f i).app (op V) c :=
  (congrArg (fun q ↦ q.app (op V) c) (lrsGlueData_yoneda_toGlued_yonedaGluedToF F hF f hf i) :)

private theorem lrsGlueData_yonedaGluedToF_isLocallyInjective
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    (hF : Presheaf.IsSheaf lrsZariskiTopology F)
    {ι : Type u} {X : ι → Scheme.{u}}
    (f : (i : ι) → yoneda.obj (X i).toLocallyRingedSpace ⟶ F)
    (hf : ∀ i, (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (f i)) :
    Presheaf.IsLocallyInjective lrsZariskiTopology (lrsGlueData_yonedaGluedToF F hF f hf) := by
  let η := lrsGlueData_yonedaGluedToF F hF f hf
  constructor
  rintro ⟨T⟩ (α β : T ⟶ (lrsGlueData_gluedScheme F f hf).toLocallyRingedSpace) h
  have mem := lrsGlueData_cover (lrsGlueData F f hf)
  refine GrothendieckTopology.superset_covering _ ?_
    (lrsZariskiTopology.intersection_covering
      (lrsZariskiTopology.pullback_stable α mem) (lrsZariskiTopology.pullback_stable β mem))
  rintro V (γ : V ⟶ T) ⟨⟨W₁, a, _, ⟨i⟩, fac₁⟩, ⟨W₂, b, _, ⟨j⟩, fac₂⟩⟩
  change γ ≫ α = γ ≫ β
  have hh : η.app (op V) (γ ≫ α) = η.app (op V) (γ ≫ β) :=
    (η.naturality_apply γ.op α).trans
      ((congrArg (F.map γ.op) h).trans (η.naturality_apply γ.op β).symm)
  rw [← fac₁, ← fac₂] at hh ⊢
  change V ⟶ (X i).toLocallyRingedSpace at a
  change V ⟶ (X j).toLocallyRingedSpace at b
  refine lrsGlueData_comp_toGlued_eq F f hf a b (yonedaEquiv.injective ?_)
  rw [yonedaEquiv_comp, yonedaEquiv_comp, yonedaEquiv_yoneda_map, yonedaEquiv_yoneda_map]
  exact (lrsGlueData_yonedaGluedToF_app_comp_ι F hF f hf i a).symm.trans
    (hh.trans (lrsGlueData_yonedaGluedToF_app_comp_ι F hF f hf j b))

private theorem lrsGlueData_yonedaGluedToF_app_injective
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    (hF : Presheaf.IsSheaf lrsZariskiTopology F)
    {ι : Type u} {X : ι → Scheme.{u}}
    (f : (i : ι) → yoneda.obj (X i).toLocallyRingedSpace ⟶ F)
    (hf : ∀ i, (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (f i)) (T : LocallyRingedSpace.{u}) :
    Function.Injective ((lrsGlueData_yonedaGluedToF F hF f hf).app (op T)) := by
  intro a b hab
  have := lrsGlueData_yonedaGluedToF_isLocallyInjective F hF f hf
  choose V v hv hpt heq using lrsZariski_sieve_has_open_refinement
    (Presheaf.equalizerSieve_mem lrsZariskiTopology (lrsGlueData_yonedaGluedToF F hF f hf)
      a b hab)
  exact LocallyRingedSpace.GlueData.hom_ext_of_openCover v hv
    (fun x ↦ ⟨x, Set.mem_range.mp (hpt x)⟩) a b heq

private theorem arrows_compatible_map_op (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    {T : LocallyRingedSpace.{u}} {ι : Type u} {U : ι → LocallyRingedSpace.{u}}
    (v : (i : ι) → U i ⟶ T) (s : F.obj (op T)) :
    Presieve.Arrows.Compatible F v (fun i ↦ F.map (v i).op s) := by
  intro i j V a b hab
  rw [← Functor.map_comp_apply, ← Functor.map_comp_apply, ← op_comp, ← op_comp, hab]

private theorem yoneda_map_pullback_comp_eq (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    {T : LocallyRingedSpace.{u}} {ι : Type u} {U X : ι → LocallyRingedSpace.{u}}
    (ι' : (i : ι) → U i ⟶ T) [∀ i, LocallyRingedSpace.IsOpenImmersion (ι' i)]
    (s : F.obj (op T)) (f : (i : ι) → yoneda.obj (X i) ⟶ F) (mi : (i : ι) → U i ⟶ X i)
    (hmi : ∀ i, (f i).app (op (U i)) (mi i) = F.map (ι' i).op s) (i j : ι) :
    yoneda.map (pullback.fst (ι' i) (ι' j) ≫ mi i) ≫ f i =
      yoneda.map (pullback.snd (ι' i) (ι' j) ≫ mi j) ≫ f j := by
  have hmi' (i : ι) : F.map (mi i).op (yonedaEquiv (f i)) = F.map (ι' i).op s := by
    rw [yonedaEquiv_naturality, yonedaEquiv_comp, yonedaEquiv_yoneda_map, hmi]
  apply yonedaEquiv.injective
  rw [← yonedaEquiv_naturality (f i) (pullback.fst (ι' i) (ι' j) ≫ mi i),
    ← yonedaEquiv_naturality (f j) (pullback.snd (ι' i) (ι' j) ≫ mi j),
    op_comp, Functor.map_comp_apply, op_comp, Functor.map_comp_apply, hmi', hmi',
    ← Functor.map_comp_apply, ← op_comp, ← Functor.map_comp_apply, ← op_comp,
    pullback.condition]

private theorem lrsGlueData_yonedaGluedToF_app_surjective
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    (hF : Presheaf.IsSheaf lrsZariskiTopology F)
    {ι : Type u} {X : ι → Scheme.{u}} (H : ι → Subfunctor F)
    (rep : ∀ i, (H i).toFunctor.RepresentableBy (X i).toLocallyRingedSpace)
    (f : (i : ι) → yoneda.obj (X i).toLocallyRingedSpace ⟶ F)
    (hf : ∀ i, (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (f i))
    (hfH : ∀ i, f i = lrsChartMap (H i) (rep i))
    (hcover : Covers LocallyRingedSpace.forgetToTop lrsIsOpenImmersion.{u} F H)
    (T : LocallyRingedSpace.{u}) :
    Function.Surjective ((lrsGlueData_yonedaGluedToF F hF f hf).app (op T)) := by
  intro s
  obtain ⟨U, ι', hopen', hsurj', hmem⟩ := hcover T s
  let D := lrsGlueData F f hf
  let η := lrsGlueData_yonedaGluedToF F hF f hf
  let si (i : ι) : (H i).toFunctor.obj (op (U i)) := ⟨F.map (ι' i).op s, hmem i⟩
  let mi (i : ι) : U i ⟶ (X i).toLocallyRingedSpace := (rep i).homEquiv.symm (si i)
  have hmi (i : ι) : (f i).app (op (U i)) (mi i) = F.map (ι' i).op s := by
    rw [hfH, lrsChartMap_app]
    exact congrArg Subtype.val ((rep i).homEquiv.apply_symm_apply (si i))
  have hcompat := yoneda_map_pullback_comp_eq F ι' s f mi hmi
  let transitionLift (i j : ι) : pullback (ι' i) (ι' j) ⟶ D.V (i, j) :=
    (hf i).rep.lift' (pullback.fst (ι' i) (ι' j) ≫ mi i)
      (pullback.snd (ι' i) (ι' j) ≫ mi j) (hcompat i j)
  have htransF (i j : ι) :
      transitionLift i j ≫ D.f i j = pullback.fst (ι' i) (ι' j) ≫ mi i := by
    change (hf i).rep.lift' _ _ (hcompat i j) ≫ (hf i).rep.fst' (f j) = _
    rw [Functor.relativelyRepresentable.lift'_fst]
  have htransS (i j : ι) :
      transitionLift i j ≫ D.t i j ≫ D.f j i = pullback.snd (ι' i) (ι' j) ≫ mi j := by
    change (hf i).rep.lift' _ _ (hcompat i j) ≫
      (hf i).rep.symmetry (hf j).rep ≫ (hf j).rep.fst' (f i) = _
    rw [Functor.relativelyRepresentable.symmetry_fst,
      Functor.relativelyRepresentable.lift'_snd]
  obtain ⟨φ, hφ⟩ :=
    LocallyRingedSpace.GlueData.existsUnique_hom_to_glued_of_compatibleCharts
      D T U ι' hopen' hsurj' mi transitionLift htransF htransS
  have hUnique := (Presieve.isSheafFor_arrows_iff F ι').mp
    (isSheafFor_ofArrows_of_openCover hF U ι' hopen' hsurj')
    (fun i ↦ F.map (ι' i).op s) (arrows_compatible_map_op F ι' s)
  have hφAmalgamation (i : ι) : η.app (op (U i)) (ι' i ≫ φ) = F.map (ι' i).op s :=
    (congrArg (η.app (op (U i))) (hφ.1 i)).trans
      ((lrsGlueData_yonedaGluedToF_app_comp_ι F hF f hf i (mi i)).trans (hmi i))
  exact ⟨φ, hUnique.unique
    (fun i ↦ (η.naturality_apply (ι' i).op φ).symm.trans (hφAmalgamation i)) fun _ ↦ rfl⟩

/-- A Zariski sheaf on locally ringed spaces, covered by subfunctors represented
by schemes and relatively represented by open immersions, is itself represented
by a scheme. -/
@[stacks 01JK]
public theorem lrsRepresentableByScheme
    (F : LocallyRingedSpace.{u}ᵒᵖ ⥤ Type u)
    (hF : Presheaf.IsSheaf lrsZariskiTopology F)
    {I : Type v} [Small.{u} I] (H : I → Subfunctor F)
    (hrep : ∀ i, ∃ S : Scheme.{u}, Nonempty ((H i).toFunctor.RepresentableBy
      S.toLocallyRingedSpace))
    (hopen : ∀ i, (MorphismProperty.presheaf
      lrsIsOpenImmersion.{u}) (H i).ι)
    (hcover : Covers LocallyRingedSpace.forgetToTop
      lrsIsOpenImmersion.{u} F H) :
    ∃ S : Scheme.{u}, Nonempty (F.RepresentableBy S.toLocallyRingedSpace) := by
  let eI : I ≃ Shrink.{u} I := equivShrink I
  let S : Shrink.{u} I → Scheme.{u} := fun i ↦ Classical.choose (hrep (eI.symm i))
  let rep : ∀ i, (H (eI.symm i)).toFunctor.RepresentableBy (S i).toLocallyRingedSpace :=
    fun i ↦ Classical.choice (Classical.choose_spec (hrep (eI.symm i)))
  have hf (i : Shrink.{u} I) :=
    lrsChartMap_isOpenImmersion (H (eI.symm i)) (rep i) (hopen (eI.symm i))
  have hcover' : Covers LocallyRingedSpace.forgetToTop lrsIsOpenImmersion.{u} F
      fun i ↦ H (eI.symm i) := by
    intro T s
    obtain ⟨U, ι, hU, hsurj, hmem⟩ := hcover T s
    refine ⟨fun i ↦ U (eI.symm i), fun i ↦ ι (eI.symm i), fun i ↦ hU _, fun x ↦ ?_,
      fun i ↦ hmem _⟩
    obtain ⟨i, y, hy⟩ := hsurj x
    obtain ⟨j, rfl⟩ := eI.symm.surjective i
    exact ⟨j, y, hy⟩
  let η := lrsGlueData_yonedaGluedToF F hF (fun i ↦ lrsChartMap (H (eI.symm i)) (rep i)) hf
  have : IsIso η := by
    rw [NatTrans.isIso_iff_isIso_app]
    intro X
    rw [isIso_iff_bijective]
    exact ⟨lrsGlueData_yonedaGluedToF_app_injective F hF _ hf X.unop,
      lrsGlueData_yonedaGluedToF_app_surjective F hF _ rep _ hf (fun _ ↦ rfl) hcover' X.unop⟩
  exact ⟨_, ⟨Functor.representableByEquiv.symm (asIso η)⟩⟩

end AlgebraicGeometry

