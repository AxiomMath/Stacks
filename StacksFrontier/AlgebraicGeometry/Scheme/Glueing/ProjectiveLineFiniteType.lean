module

public import Mathlib.AlgebraicGeometry.Morphisms.Proper
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Scheme.Glueing.ProjectiveLineSeparated
public import StacksFrontier.AlgebraicGeometry.Scheme.Glueing.ProjectiveLineUniversallyClosed

/-!
# The projective line is proper over its base

The structure morphism of the projective line over a commutative ring `k` is locally of finite
type, and therefore proper: separatedness is `AlgebraicGeometry.projectiveLine_isSeparated` and
universal closedness is `AlgebraicGeometry.projectiveLine_universallyClosed`, so the only
missing constituent of `AlgebraicGeometry.IsProper` is finite type.

Finite type is immediate from the construction. The property is Zariski local at the source, the
two standard charts cover the projective line, and on either chart the structure morphism is
`Spec` of `k ⟶ k[X]`, which is of finite type because `k[X]` is generated by one element.

## Main results

* `AlgebraicGeometry.projectiveLine_locallyOfFiniteType`: the structure morphism of the
  projective line is locally of finite type.
* `AlgebraicGeometry.projectiveLine_isProper`, registered as the instance
  `AlgebraicGeometry.projectiveLine_isProper_inst`: the structure morphism of the projective
  line is proper.

## Implementation notes

`AlgebraicGeometry.LocallyOfFiniteType` is Zariski local at the source through its
`AlgebraicGeometry.HasRingHomProperty` instance, but the resulting
`AlgebraicGeometry.IsZariskiLocalAtSource` instance is not found by unification at a
universe-polymorphic morphism property, so it is supplied by hand.

## References

* [Stacks Project, Tag 01JE](https://stacks.math.columbia.edu/tag/01JE)
* [Stacks Project, Tag 01KG](https://stacks.math.columbia.edu/tag/01KG)
* [Stacks Project, Tag 01KQ](https://stacks.math.columbia.edu/tag/01KQ)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry

variable (k : Type u) [CommRing k]

/-- The structure morphism of either affine chart of the projective line is locally of finite
type: it is `Spec` of `k ⟶ k[X]`, and `k[X]` is a finitely generated `k`-algebra. -/
theorem projectiveLineAffineStructureMorphism_locallyOfFiniteType :
    LocallyOfFiniteType (projectiveLineAffineStructureMorphism k) :=
  (HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mpr
    (RingHom.finiteType_algebraMap.mpr inferInstance)

/-- The structure morphism of the projective line is locally of finite type: finite type is
Zariski local at the source, and on either of the two standard charts the structure morphism is
the structure morphism of the affine line. -/
theorem projectiveLine_locallyOfFiniteType :
    LocallyOfFiniteType (projectiveLine k ↘ Spec (.of k)) := by
  have hloc : IsZariskiLocalAtSource (@LocallyOfFiniteType.{u}) :=
    HasRingHomProperty.instIsZariskiLocalAtSource (Q := RingHom.FiniteType)
  refine IsZariskiLocalAtSource.of_openCover (projectiveLineGluingData k).openCover fun i ↦ ?_
  have h : (projectiveLineGluingData k).openCover.f i ≫ (projectiveLine k ↘ Spec (.of k)) =
      projectiveLineAffineStructureMorphism k := (projectiveLineStructureMorphism k).2 i
  rw [h]
  exact projectiveLineAffineStructureMorphism_locallyOfFiniteType k

/-- The structure morphism of the projective line is proper: it is separated by Stacks 01KQ,
universally closed by Stacks 01KG and locally of finite type by
`AlgebraicGeometry.projectiveLine_locallyOfFiniteType`. -/
theorem projectiveLine_isProper : IsProper (projectiveLine k ↘ Spec (.of k)) :=
  { __ := projectiveLine_isSeparated k
    __ := projectiveLine_universallyClosed k
    __ := projectiveLine_locallyOfFiniteType k }

/-- The structure morphism of the projective line over `k` is proper. -/
instance projectiveLine_isProper_inst : IsProper (projectiveLine k ↘ Spec (.of k)) :=
  projectiveLine_isProper k

/-- The structure morphism of the projective line over `k` is locally of finite type. -/
instance projectiveLine_locallyOfFiniteType_inst :
    LocallyOfFiniteType (projectiveLine k ↘ Spec (.of k)) :=
  projectiveLine_locallyOfFiniteType k

/-- The structure morphism of the projective line over `k` is quasi-compact. -/
instance projectiveLine_quasiCompact_inst : QuasiCompact (projectiveLine k ↘ Spec (.of k)) :=
  projectiveLine_quasiCompact k

/-- The structure morphism of the projective line over `k` is separated. -/
instance projectiveLine_isSeparated_inst : IsSeparated (projectiveLine k ↘ Spec (.of k)) :=
  projectiveLine_isSeparated k

end AlgebraicGeometry

end
