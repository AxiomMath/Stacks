module

public import Mathlib.Algebra.Module.LocalizedModule.Submodule
public import Mathlib.RingTheory.Finiteness.Basic
public import Mathlib.RingTheory.Localization.Away.Basic

/-!
# A finitely generated submodule with prescribed localizations

Let `M` be a module over a commutative ring `R` and let `g : ι → R` be a finite family such that
each localization `M_{g i}` is a finite `R_{g i}`-module. Then there is a *finitely generated*
submodule `M' ⊆ M` whose localization at each `g i` is already the whole of `M_{g i}`.

The submodule is the one the construction suggests: choose finitely many generators of each
`M_{g i}` over `R_{g i}`, write each as a fraction `x / s`, and let `M'` be the submodule of `M`
generated by the *numerators* `x`. Localizing `M'` at `g i` makes every denominator invertible, so
the chosen generators reappear in `M'.localized`, and they generate.

This is the algebraic step of the affine case of [Stacks, Tag 01PF]: there `M` is the module of a
quasi-coherent sheaf, the `g i` cut out a finite cover of a quasi-compact open `U` by standard
opens on which the sheaf is of finite type, and `M'` is the module of the finite type subsheaf
extending it.

## Main results

* `Submodule.exists_fg_localized_eq_top` — the finitely generated submodule with full
  localizations.

## References

* [Stacks Project, Tag 01PF](https://stacks.math.columbia.edu/tag/01PF)
-/

@[expose] public section

universe u v

namespace Submodule

/-- **A finitely generated submodule whose localizations are everything.** If each localization
`M_{g i}` of `M` at a member of a finite family `g : ι → R` is a finite `R_{g i}`-module, then some
finitely generated submodule `M' ⊆ M` has `M'.localized (powers (g i)) = ⊤` for every `i`.

Take for `M'` the submodule generated by the numerators of finitely many generators of each
`M_{g i}`; the denominators are invertible after localizing, so those generators lie in the
localization of `M'`. -/
theorem exists_fg_localized_eq_top {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M]
    [Module R M] {ι : Type*} [Finite ι] (g : ι → R)
    (h : ∀ i, Module.Finite (Localization.Away (g i))
      (LocalizedModule (Submonoid.powers (g i)) M)) :
    ∃ M' : Submodule R M, M'.FG ∧
      ∀ i, M'.localized (Submonoid.powers (g i)) = ⊤ := by
  classical
  -- finitely many generators of each `M_{g i}` over `R_{g i}`
  have hfin : ∀ i, ∃ (n : ℕ) (y : Fin n → LocalizedModule (Submonoid.powers (g i)) M),
      Submodule.span (Localization.Away (g i)) (Set.range y) = ⊤ := fun i =>
    have := h i
    Module.Finite.exists_fin
  choose n y hy using hfin
  -- write each generator as a fraction, and keep its numerator
  have hfrac : ∀ (i : ι) (j : Fin (n i)), ∃ (x : M) (s : Submonoid.powers (g i)),
      IsLocalizedModule.mk' (LocalizedModule.mkLinearMap (Submonoid.powers (g i)) M) x s
        = y i j := fun i j => by
    obtain ⟨⟨x, s⟩, hxs⟩ := IsLocalizedModule.mk'_surjective (Submonoid.powers (g i))
      (LocalizedModule.mkLinearMap (Submonoid.powers (g i)) M) (y i j)
    exact ⟨x, s, hxs⟩
  choose num den hnum using hfrac
  have : Fintype ι := Fintype.ofFinite ι
  refine ⟨Submodule.span R (Set.range fun p : (i : ι) × Fin (n i) => num p.1 p.2),
    Submodule.fg_span (Set.finite_range _), fun i => ?_⟩
  rw [eq_top_iff, ← hy i, Submodule.span_le]
  rintro _ ⟨j, rfl⟩
  rw [SetLike.mem_coe, ← hnum i j]
  exact ⟨num i j, Submodule.subset_span ⟨⟨i, j⟩, rfl⟩, den i j, rfl⟩

/-- The localization of a submodule read as an `R`-submodule rather than over the localized
ring: it is everything as soon as it is everything over the localized ring. -/
theorem localized₀_eq_top_of_localized_eq_top {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] (M' : Submodule R M) (p : Submonoid R)
    (h : M'.localized p = ⊤) :
    M'.localized₀ p (LocalizedModule.mkLinearMap p M) = ⊤ :=
  calc M'.localized₀ p (LocalizedModule.mkLinearMap p M)
      = (M'.localized p).restrictScalars R :=
        (Submodule.restrictScalars_localized' (Localization p) p
          (LocalizedModule.mkLinearMap p M) M').symm
    _ = ⊤ := by rw [h, Submodule.restrictScalars_top]

/-- **A submodule which becomes everything at `p` becomes everything at any larger submonoid.**
If the localization of `M' ⊆ M` at `p` is the whole of `M_p`, the same holds at every submonoid
`q ⊇ p`, for an arbitrary localization map `b` at `q`.

An element of `M_q` is `x / t`; the hypothesis writes `a x` as `m / s` with `m ∈ M'` and `s ∈ p`,
so `u • m = (u * s) • x` in `M` for some `u ∈ p`, and then `x / t = (u • m) / (u * s * t)` exhibits
it in the localization of `M'`. -/
theorem localized₀_eq_top_of_le {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M]
    [Module R M] (M' : Submodule R M) {p q : Submonoid R} (hpq : p ≤ q)
    {A B : Type*} [AddCommGroup A] [Module R A] [AddCommGroup B] [Module R B]
    (a : M →ₗ[R] A) (b : M →ₗ[R] B) [IsLocalizedModule p a] [IsLocalizedModule q b]
    (h : M'.localized₀ p a = ⊤) : M'.localized₀ q b = ⊤ := by
  refine eq_top_iff.mpr fun y _ => ?_
  obtain ⟨⟨x, t⟩, rfl⟩ := IsLocalizedModule.mk'_surjective q b y
  obtain ⟨m, hm, s, hms⟩ := (h.ge (mem_top (x := a x)) :)
  -- `a m = a (s • x)`, so `(u * s) • x = u • m` in `M` for some `u ∈ p`
  have ham : a m = a ((s : R) • x) := by
    rw [map_smul]
    exact IsLocalizedModule.mk'_eq_iff.mp hms
  obtain ⟨u, hu⟩ := (IsLocalizedModule.eq_iff_exists p a).mp ham
  have hu' : ((u : R) * (s : R)) • x = (u : R) • m := by
    rw [mul_smul]
    exact hu.symm
  have hcancel : (t : R) • IsLocalizedModule.mk' b x t = b x :=
    IsLocalizedModule.mk'_cancel' (S := q) (f := b) x t
  have hqmem : (u : R) * (s : R) * (t : R) ∈ q :=
    mul_mem (mul_mem (hpq u.2) (hpq s.2)) t.2
  refine ⟨(u : R) • m, M'.smul_mem _ hm, ⟨_, hqmem⟩, ?_⟩
  change IsLocalizedModule.mk' b ((u : R) • m) (⟨_, hqmem⟩ : q)
      = IsLocalizedModule.mk' b x t
  rw [IsLocalizedModule.mk'_eq_iff]
  change b ((u : R) • m)
      = ((u : R) * (s : R) * (t : R)) • IsLocalizedModule.mk' b x t
  rw [← hu', map_smul, mul_smul _ (t : R), hcancel]

end Submodule

end
