module

public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import StacksFrontier.AlgebraicGeometry.Scheme.CarrierPrimeSpectrum
public import StacksFrontier.RingTheory.Henselian.Pair.EtaleSplitting

/-!
# The range of a section of a morphism of affine schemes

Let `f : Y ⟶ X` be a morphism of affine schemes and `σ : X ⟶ Y` a section of it. Then `σ^♯` is a
**retraction** of `f^♯` on global functions, in particular surjective, so `σ` is `Spec` of a
surjective ring map and its range is the zero locus of the kernel of `σ^♯`. For `f` étale that
kernel is generated by an idempotent, so the range of *any* section of an étale morphism of affine
schemes is the zero locus of a single idempotent.

The point of recording it in this generality is that it applies to a section obtained in some
other way — for instance to the section produced over a strictly henselian base in the proof of
[Stacks Project, Tag 0DT9], whose idempotent is then available for the descent even though the
section was not constructed from it.

## Main results

* `AlgebraicGeometry.surjective_appTop_of_section`: a section is surjective on global functions.
* `AlgebraicGeometry.mem_range_base_iff_ker_appTop_le`: **the range of a section is the zero locus
  of the kernel of the induced map on global functions.**
* `AlgebraicGeometry.exists_isIdempotentElem_ker_of_retraction_of_etale`: the kernel of a
  retraction of the map on global functions of an étale morphism is generated by an idempotent.
* `AlgebraicGeometry.exists_isIdempotentElem_ker_appTop_of_section`: **for an étale morphism of
  affine schemes the range of a section is the zero locus of an idempotent.**

## Implementation notes

The identification of points with primes is `AlgebraicGeometry.Scheme.carrierEquivPrimeSpectrum`,
and that a morphism of affine schemes acts on them by contraction is its naturality; no explicit
`Spec` of the retraction is formed, so the statements apply to a section given abstractly.

## References

* [Stacks Project, Tag 0DT9](https://stacks.math.columbia.edu/tag/0DT9)

## Tags

affine scheme, section, retraction, zero locus, idempotent
-/

@[expose] public section

open CategoryTheory

noncomputable section

universe u

namespace AlgebraicGeometry

variable {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y] {f : Y ⟶ X} {σ : X ⟶ Y}

/-- A section induces a retraction of the map on global functions. -/
private theorem appTop_comp_appTop_of_section {X Y : Scheme.{u}} {f : Y ⟶ X} {σ : X ⟶ Y}
    (hσ : σ ≫ f = 𝟙 X) : f.appTop ≫ σ.appTop = 𝟙 Γ(X, ⊤) := by
  rw [← Scheme.Hom.comp_appTop, hσ, Scheme.Hom.id_appTop]

omit [IsAffine X] [IsAffine Y] in
/-- **A section of a morphism is surjective on global functions**, being a retraction of the map
on global functions induced by the morphism. -/
theorem surjective_appTop_of_section (hσ : σ ≫ f = 𝟙 X) :
    Function.Surjective σ.appTop.hom := by
  intro a
  refine ⟨f.appTop.hom a, ?_⟩
  exact congr($(appTop_comp_appTop_of_section hσ).hom a)

/-- **The range of a section of a morphism of affine schemes is the zero locus of the kernel of
the induced map on global functions**: the section is `Spec` of that map, which is surjective, and
the image of `Spec` of a surjective ring map is the zero locus of its kernel. -/
theorem mem_range_base_iff_ker_appTop_le (hσ : σ ≫ f = 𝟙 X) (y : Y) :
    y ∈ Set.range σ.base ↔
      RingHom.ker σ.appTop.hom ≤ (Y.carrierEquivPrimeSpectrum y).asIdeal := by
  have hsurj := surjective_appTop_of_section hσ
  have hrange : Set.range (PrimeSpectrum.comap σ.appTop.hom) =
      PrimeSpectrum.zeroLocus (RingHom.ker σ.appTop.hom : Set Γ(Y, ⊤)) :=
    _root_.range_comap_of_surjective _ σ.appTop.hom hsurj
  have hmem : Y.carrierEquivPrimeSpectrum y ∈
      PrimeSpectrum.zeroLocus (RingHom.ker σ.appTop.hom : Set Γ(Y, ⊤)) ↔
      RingHom.ker σ.appTop.hom ≤ (Y.carrierEquivPrimeSpectrum y).asIdeal := Iff.rfl
  rw [← hmem, ← hrange]
  refine ⟨fun hy => ?_, fun hy => ?_⟩
  · obtain ⟨x, rfl⟩ := hy
    exact ⟨X.carrierEquivPrimeSpectrum x, (Scheme.carrierEquivPrimeSpectrum_naturality σ x).symm⟩
  · obtain ⟨p, hp⟩ := hy
    refine ⟨X.carrierEquivPrimeSpectrum.symm p, Y.carrierEquivPrimeSpectrum.injective ?_⟩
    rw [Scheme.carrierEquivPrimeSpectrum_naturality σ,
      X.carrierEquivPrimeSpectrum.apply_symm_apply, hp]

/-- **The kernel of a retraction of the map on global functions of an étale morphism of affine
schemes is generated by an idempotent.** This is
`Algebra.Etale.exists_isIdempotentElem_span_eq_ker` read for the algebra structure the morphism
puts on the global functions of its source.

It is stated for a retraction rather than for a section because the two situations it serves in
the proof of [Stacks Project, Tag 0DT9] present the datum differently: over the strictly henselian
base a section of schemes is produced and its retraction is read off, while at an étale stage a
retraction of rings is produced and the section is read off. -/
theorem exists_isIdempotentElem_ker_of_retraction_of_etale [Etale f] (τ : Γ(Y, ⊤) ⟶ Γ(X, ⊤))
    (hτ : f.appTop ≫ τ = 𝟙 Γ(X, ⊤)) :
    ∃ ε : Γ(Y, ⊤), IsIdempotentElem ε ∧ RingHom.ker τ.hom = Ideal.span {ε} := by
  let : Algebra Γ(X, ⊤) Γ(Y, ⊤) := f.appTop.hom.toAlgebra
  have : Algebra.Etale Γ(X, ⊤) Γ(Y, ⊤) :=
    RingHom.etale_algebraMap.mp (HasRingHomProperty.appTop (P := @Etale) f inferInstance)
  let τₐ : Γ(Y, ⊤) →ₐ[Γ(X, ⊤)] Γ(X, ⊤) :=
    { __ := τ.hom, commutes' := fun a => congr($(hτ).hom a) }
  obtain ⟨ε, hε, hspan⟩ := Algebra.Etale.exists_isIdempotentElem_span_eq_ker τₐ
  exact ⟨ε, hε, hspan.symm⟩

/-- **For an étale morphism of affine schemes the range of a section is the zero locus of an
idempotent.** The map on global functions induced by the section is a retraction, so its kernel is
generated by an idempotent, and the range is the zero locus of that kernel. -/
theorem exists_isIdempotentElem_ker_appTop_of_section [Etale f] (hσ : σ ≫ f = 𝟙 X) :
    ∃ ε : Γ(Y, ⊤), IsIdempotentElem ε ∧ RingHom.ker σ.appTop.hom = Ideal.span {ε} ∧
      ∀ y : Y, y ∈ Set.range σ.base ↔
        ε ∈ (Y.carrierEquivPrimeSpectrum y).asIdeal := by
  obtain ⟨ε, hε, hspan⟩ :=
    exists_isIdempotentElem_ker_of_retraction_of_etale σ.appTop (appTop_comp_appTop_of_section hσ)
  refine ⟨ε, hε, hspan, fun y => ?_⟩
  rw [mem_range_base_iff_ker_appTop_le hσ y, hspan, Ideal.span_le,
    Set.singleton_subset_iff]
  exact Iff.rfl

end AlgebraicGeometry

end

end
