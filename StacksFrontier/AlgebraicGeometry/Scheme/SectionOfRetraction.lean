module

public import Mathlib.AlgebraicGeometry.Morphisms.Etale
public import Mathlib.AlgebraicGeometry.Morphisms.OpenImmersion
public import StacksFrontier.AlgebraicGeometry.Scheme.CarrierPrimeSpectrum
public import StacksFrontier.RingTheory.Henselian.Pair.EtaleSplitting

/-!
# Sections of a morphism of affine schemes from a retraction on global functions

A morphism `f : Y ⟶ X` of affine schemes is `Spec` of the map `f^♯ : Γ(X, ⊤) → Γ(Y, ⊤)` on global
functions, so a **retraction** `τ` of `f^♯` — a ring map back with `τ ∘ f^♯ = id` — is the same
thing as a **section** of `f`. This file records the geometry of that section: it is an open
immersion as soon as the kernel of `τ` is generated by an idempotent, and its range is the closed
set of points whose prime contains that kernel. For `f` étale the idempotent exists
automatically, which is the form in which the section is used.

Nothing here is local, henselian or strictly henselian: both statements are about an arbitrary
morphism of affine schemes with a retraction on global functions. The strictly henselian
situation of [Stacks Project, Tag 0DT9] enters only in *producing* the retraction, and the same
two statements serve the étale stages that the descent of Tag 0DT9 passes through, where no base
ring is henselian.

## Main results

* `AlgebraicGeometry.exists_section_of_ker_eq_span_isIdempotentElem`: **a retraction of the map on
  global functions whose kernel is generated by an idempotent gives a section which is an open
  immersion with closed image**, that image being the set of points whose prime contains the
  kernel.
* `AlgebraicGeometry.exists_section_of_retraction_of_etale`: the same for an **étale** `f`, where
  the idempotent is automatic because the kernel of a retraction of an étale algebra is generated
  by one.

## Implementation notes

Openness of the image is Mathlib's `AlgebraicGeometry.isOpenImmersion_SpecMap_iff_of_surjective`,
which says that `Spec (A' ⧸ I) ⟶ Spec A'` is an open immersion exactly when `I` is generated by
an idempotent, together with the repository's
`Algebra.Etale.exists_isIdempotentElem_span_eq_ker`, which produces that idempotent for the kernel
of an `A`-algebra map out of an étale `A`-algebra. No new idempotent-to-clopen machinery is
needed.

The section is `Spec` of `τ` read through the canonical isomorphisms of the two affine schemes
with the spectra of their global functions, so that the identity `σ ≫ f = 𝟙` is the naturality of
those isomorphisms applied to the ring identity `τ ∘ f^♯ = id`, which in turn is just `τ` being a
map of `Γ(X, ⊤)`-algebras.

The description of the range is an *equivalence*, not just the implication from containment of
the kernel to membership that a consumer locating one point needs: the zero locus of the kernel
is what the range is, and the closedness of the range is read off the same computation.

## References

* [Stacks Project, Tag 0DT9](https://stacks.math.columbia.edu/tag/0DT9)
-/

@[expose] public section

open CategoryTheory

noncomputable section

universe u

namespace AlgebraicGeometry

/-- **A retraction of the map on global functions, with kernel generated by an idempotent, gives a
section with open image.** If `f : Y ⟶ X` is a morphism of affine schemes and `τ` is a retraction
of `f^♯ : Γ(X, ⊤) → Γ(Y, ⊤)` whose kernel is generated by an idempotent, then `Spec τ`, read
through the canonical isomorphisms with the spectra of the rings of global functions, is a section
of `f` which is an open immersion, its range is closed — it is the zero locus of the kernel of
`τ` — and that range consists exactly of the points of `Y` whose prime ideal contains the kernel
of `τ`. -/
theorem exists_section_of_ker_eq_span_isIdempotentElem {X Y : Scheme.{u}} [IsAffine X]
    [IsAffine Y] (f : Y ⟶ X) (τ : Γ(Y, ⊤) →+* Γ(X, ⊤))
    (hτ : τ.comp f.appTop.hom = RingHom.id Γ(X, ⊤))
    (hker : ∃ g, IsIdempotentElem g ∧ RingHom.ker τ = Ideal.span {g}) :
    ∃ σ : X ⟶ Y, IsOpenImmersion σ ∧ σ ≫ f = 𝟙 X ∧ IsClosed (Set.range σ.base) ∧
      ∀ y : Y, y ∈ Set.range σ.base ↔
        RingHom.ker τ ≤ (Y.carrierEquivPrimeSpectrum y).asIdeal := by
  have hsurj : Function.Surjective τ := fun a => ⟨f.appTop.hom a, RingHom.congr_fun hτ a⟩
  have hoi : IsOpenImmersion (Spec.map (CommRingCat.ofHom τ)) :=
    (isOpenImmersion_SpecMap_iff_of_surjective (CommRingCat.ofHom τ) hsurj).mpr hker
  set σ := X.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom τ) ≫ Y.isoSpec.inv with hσdef
  have hpt : ∀ x : X, Y.carrierEquivPrimeSpectrum (σ.base x) =
      PrimeSpectrum.comap τ (X.carrierEquivPrimeSpectrum x) := by
    intro x
    change Y.isoSpec.hom.base (Y.isoSpec.inv.base ((Spec.map (CommRingCat.ofHom τ)).base
      (X.isoSpec.hom.base x))) = PrimeSpectrum.comap τ (X.isoSpec.hom.base x)
    exact Y.carrierEquivPrimeSpectrum.apply_symm_apply _
  have hmem : ∀ y : Y, y ∈ Set.range σ.base ↔
      Y.carrierEquivPrimeSpectrum y ∈
        PrimeSpectrum.zeroLocus (RingHom.ker τ : Set Γ(Y, ⊤)) := by
    intro y
    rw [← _root_.range_comap_of_surjective _ τ hsurj]
    refine ⟨fun hy => ?_, fun hy => ?_⟩
    · obtain ⟨x, rfl⟩ := hy
      exact ⟨X.carrierEquivPrimeSpectrum x, (hpt x).symm⟩
    · obtain ⟨x, hx⟩ := hy
      refine ⟨X.carrierEquivPrimeSpectrum.symm x, ?_⟩
      have := hpt (X.carrierEquivPrimeSpectrum.symm x)
      rw [X.carrierEquivPrimeSpectrum.apply_symm_apply, hx] at this
      exact Y.carrierEquivPrimeSpectrum.injective this
  refine ⟨σ, inferInstance, ?_, ?_, hmem⟩
  · have hid : f.appTop ≫ CommRingCat.ofHom τ = 𝟙 Γ(X, ⊤) := by
      ext a
      exact RingHom.congr_fun hτ a
    rw [hσdef]
    simp only [Category.assoc]
    rw [← Scheme.isoSpec_inv_naturality f, ← Spec.map_comp_assoc, hid, Spec.map_id,
      Category.id_comp, Iso.hom_inv_id]
  · have hpre : Set.range σ.base =
        ⇑Y.isoSpec.hom.base ⁻¹' PrimeSpectrum.zeroLocus (RingHom.ker τ : Set Γ(Y, ⊤)) :=
      Set.ext hmem
    rw [hpre]
    exact (PrimeSpectrum.isClosed_zeroLocus _).preimage Y.isoSpec.hom.base.hom.continuous

/-- **A retraction of the map on global functions of an étale morphism of affine schemes gives a
section which is an open immersion with closed image.** For `f` étale no hypothesis on the kernel
of the retraction is needed: `Γ(Y, ⊤)` is an étale `Γ(X, ⊤)`-algebra and `τ` is a map of
`Γ(X, ⊤)`-algebras, so its kernel is generated by an idempotent
(`Algebra.Etale.exists_isIdempotentElem_span_eq_ker`). -/
theorem exists_section_of_retraction_of_etale {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y]
    (f : Y ⟶ X) [Etale f] (τ : Γ(Y, ⊤) →+* Γ(X, ⊤))
    (hτ : τ.comp f.appTop.hom = RingHom.id Γ(X, ⊤)) :
    ∃ σ : X ⟶ Y, IsOpenImmersion σ ∧ σ ≫ f = 𝟙 X ∧ IsClosed (Set.range σ.base) ∧
      ∀ y : Y, y ∈ Set.range σ.base ↔
        RingHom.ker τ ≤ (Y.carrierEquivPrimeSpectrum y).asIdeal := by
  let : Algebra Γ(X, ⊤) Γ(Y, ⊤) := f.appTop.hom.toAlgebra
  have : Algebra.Etale Γ(X, ⊤) Γ(Y, ⊤) :=
    RingHom.etale_algebraMap.mp (HasRingHomProperty.appTop (P := @Etale) f inferInstance)
  let τₐ : Γ(Y, ⊤) →ₐ[Γ(X, ⊤)] Γ(X, ⊤) :=
    { __ := τ, commutes' := fun a => RingHom.congr_fun hτ a }
  obtain ⟨g, hg, hgspan⟩ := Algebra.Etale.exists_isIdempotentElem_span_eq_ker τₐ
  exact exists_section_of_ker_eq_span_isIdempotentElem f τ hτ ⟨g, hg, hgspan.symm⟩

end AlgebraicGeometry

end

end
