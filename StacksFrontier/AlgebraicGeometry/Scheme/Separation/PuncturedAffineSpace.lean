module

public import Mathlib.RingTheory.MvPolynomial.Basic
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Spectrum.Prime.Topology
public import StacksCore.Tactic.StacksAttribute

/-!
# The punctured infinite-dimensional affine space is not quasi-compact

Let `k` be a field and let `A = k[X₀, X₁, …]` be the polynomial ring in countably many variables.
The origin of `Spec A` is the maximal ideal `m = (X₀, X₁, …)`, and the complement of that point
is not quasi-compact: it is covered by the basic opens `D(Xᵢ)`, and no finite subfamily covers
it, because for each `n` the evaluation sending `Xₙ` to `1` and every other variable to `0`
defines a prime of the complement lying in no `D(Xᵢ)` with `i < n`.

This is the ingredient that makes infinite-dimensional affine space with a doubled origin fail
to be quasi-separated.

## Main results

* `AlgebraicGeometry.puncturedSpectrum_not_isCompact`: the complement of the prime generated by
  all the variables is not compact.

## Implementation notes

The origin is represented by the ideal generated by the range of `MvPolynomial.X`. Rather than
making a proof that this ideal is prime part of the statement's data, its complement is written
as the set of prime ideals unequal to it; that the ideal is in fact maximal, being the kernel of
`MvPolynomial.constantCoeff`, is established inside the proof. Quasi-compactness of this subset
of the prime spectrum is expressed by `IsCompact`.

## References

* [Stacks Project, Tag 01KL](https://stacks.math.columbia.edu/tag/01KL)
-/

public section

namespace AlgebraicGeometry

/-- A polynomial lies in the ideal generated by all the variables exactly when its constant
coefficient vanishes. -/
public theorem mem_span_range_X_iff_constantCoeff_eq_zero {k : Type*} [Field k]
    (f : MvPolynomial ℕ k) :
    f ∈ Ideal.span (Set.range (MvPolynomial.X : ℕ → MvPolynomial ℕ k)) ↔
      MvPolynomial.constantCoeff f = 0 := by
  rw [show Ideal.span (Set.range (MvPolynomial.X : ℕ → MvPolynomial ℕ k)) =
      MvPolynomial.idealOfVars ℕ k from rfl,
    ← pow_one (MvPolynomial.idealOfVars ℕ k), MvPolynomial.mem_pow_idealOfVars_iff']
  constructor
  · intro h
    simpa [MvPolynomial.constantCoeff] using h 0 (by simp)
  · intro h x hx
    have hx0 : Finsupp.degree x = 0 := by omega
    rw [Finsupp.degree_eq_zero_iff] at hx0
    simpa [hx0, MvPolynomial.constantCoeff] using h

/-- The origin of countably infinite-dimensional affine space over a field is a closed point:
the ideal generated by all the variables is the kernel of `MvPolynomial.constantCoeff`, hence
maximal. -/
public theorem isMaximal_span_range_X (k : Type*) [Field k] :
    (Ideal.span (Set.range (MvPolynomial.X : ℕ → MvPolynomial ℕ k))).IsMaximal := by
  rw [show Ideal.span (Set.range (MvPolynomial.X : ℕ → MvPolynomial ℕ k)) =
      RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial ℕ k →+* k) from
    Ideal.ext fun f ↦ mem_span_range_X_iff_constantCoeff_eq_zero f]
  exact RingHom.ker_isMaximal_of_surjective _ (fun y ↦ ⟨MvPolynomial.C y, by simp⟩)

/-- The complement of the origin in countably infinite-dimensional affine space over a field is
not quasi-compact. -/
@[stacks 01KL "punctured_spectrum_not_quasi_compact"]
public theorem puncturedSpectrum_not_isCompact (k : Type*) [Field k] :
    ¬ IsCompact {p : PrimeSpectrum (MvPolynomial ℕ k) |
      p.asIdeal ≠ Ideal.span (Set.range (MvPolynomial.X : ℕ → MvPolynomial ℕ k))} := by
  classical
  let m := Ideal.span (Set.range (MvPolynomial.X : ℕ → MvPolynomial ℕ k))
  intro hcompact
  have hcover : {p : PrimeSpectrum (MvPolynomial ℕ k) | p.asIdeal ≠ m} ⊆
      ⋃ i : ℕ, (PrimeSpectrum.basicOpen (MvPolynomial.X i : MvPolynomial ℕ k) : Set _) := by
    intro p hp
    by_contra hp'
    simp only [Set.mem_iUnion, not_exists] at hp'
    exact hp ((isMaximal_span_range_X k).eq_of_le p.isPrime.ne_top
      (Ideal.span_le.2 (Set.range_subset_iff.mpr fun i ↦
        not_not.mp ((PrimeSpectrum.mem_basicOpen _ _).not.mp (hp' i))))).symm
  obtain ⟨t, ht⟩ := hcompact.elim_finite_subcover
    (fun i : ℕ ↦ (PrimeSpectrum.basicOpen (MvPolynomial.X i : MvPolynomial ℕ k) : Set _))
    (fun _ ↦ PrimeSpectrum.isOpen_basicOpen) hcover
  obtain ⟨n, hn⟩ := Finset.exists_nat_subset_range t
  let e : MvPolynomial ℕ k →+* k :=
    MvPolynomial.eval₂Hom (RingHom.id k) (fun i ↦ if i = n then 1 else 0)
  let p : PrimeSpectrum (MvPolynomial ℕ k) := ⟨RingHom.ker e, RingHom.ker_isPrime e⟩
  have hp : p ∈ {p : PrimeSpectrum (MvPolynomial ℕ k) | p.asIdeal ≠ m} := by
    intro heq
    change RingHom.ker e = m at heq
    have hXker : MvPolynomial.X n ∈ RingHom.ker e :=
      heq.symm ▸ Ideal.subset_span (Set.mem_range_self n)
    simp [e, RingHom.mem_ker] at hXker
  obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (ht hp)
  obtain ⟨hi, hXi⟩ := Set.mem_iUnion.mp hi
  exact (PrimeSpectrum.mem_basicOpen _ _).mp hXi
    (by simp [p, e, RingHom.mem_ker, ne_of_lt (Finset.mem_range.mp (hn hi))])

end AlgebraicGeometry

end
