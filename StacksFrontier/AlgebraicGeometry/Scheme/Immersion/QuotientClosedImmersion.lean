module

public import StacksFrontier.AlgebraicGeometry.ClosedImmersion.ClosedSubspaceExistence
public import StacksFrontier.AlgebraicGeometry.ClosedImmersion.IdealSheafAffine
public import StacksFrontier.AlgebraicGeometry.ClosedImmersion.IdealSheafUniqueness
public import StacksFrontier.AlgebraicGeometry.ClosedImmersionTFAE.Basic
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The closed immersion cut out by an ideal of a ring

Let `R` be a ring and `I ⊆ R` an ideal. The morphism of affine schemes
`i : Spec (R ⧸ I) ⟶ Spec R` is a closed immersion of locally ringed spaces in the sense of
Definition 01HK, its underlying continuous map is a closed embedding, and it is, over `Spec R`,
the closed subspace cut out by the quasi-coherent sheaf of ideals `I^~`.

## Main definitions

* `Stacks.ClosedImmersion.tildeIdealInclusion` is the inclusion `I^~ ⟶ 𝒪_{Spec R}`.
* `Stacks.ClosedImmersion.tildeClosedSubspace` is the closed subspace of `Spec R` cut out by it,
  the one Tag 01HN produces; `tildeSubspace` and `tildeSubspaceInclusion` are its space and its
  inclusion.

## Main results

* `Stacks.ClosedImmersion.isClosedImmersion_specMap_quotientMk`: `i` is a closed immersion of
  locally ringed spaces.
* `Stacks.ClosedImmersion.isClosedEmbedding_specMap_quotientMk`: `i` is a homeomorphism onto a
  closed subset of `Spec R`.
* `Stacks.ClosedImmersion.existsUnique_iso_tildeSubspace`: `Spec (R ⧸ I)` is, uniquely and over
  `Spec R`, isomorphic to the closed subspace cut out by `I^~`.

## Implementation notes

The closed immersion is the project's `Stacks.ClosedImmersion.IsClosedImmersion`, the three
conditions of Definition 01HK for a morphism of locally ringed spaces, and *not* Mathlib's
`AlgebraicGeometry.IsClosedImmersion`, which omits the requirement that the kernel of
`𝒪_X ⟶ i_* 𝒪_Z` be locally generated by sections. Mathlib's class holds here as an instance,
and the passage to Definition 01HK is the equivalence
`Stacks.AlgebraicGeometry.ClosedImmersionTFAE.closedImmersion_tfae`.

That `I^~` is locally generated by sections is not assumed: `I^~` is quasi-coherent, which is a
Mathlib instance for `tilde`, and a quasi-coherent sheaf of modules carries local generators.
This is what lets Tag 01HN produce the closed subspace from `I` alone.

The identification over `Spec R` comes from
`Stacks.ClosedImmersion.existsUnique_iso_of_idealSheaf_iso`: both `i` and the inclusion of the
closed subspace are closed immersions into `Spec R`, and both have ideal sheaf `I^~` — the first
by `Stacks.ClosedImmersion.IdealSheafAffine.exists_tilde_iso_kernel_quotUnitHom`, the second by
the `idealIso` field of the closed-subspace data — compatibly with the inclusions into
`𝒪_{Spec R}`. Uniqueness of the isomorphism is then free, the inclusions being monomorphisms.

Two spellings of the structure sheaf of `Spec R` as a sheaf of rings are in play,
`(Spec R).ringCatSheaf` and `structureSheafRing (Spec R).toLocallyRingedSpace.toRingedSpace`.
They are definitionally equal but not syntactically so, and instance resolution does not
unfold between them, so the `Mono` hypothesis of
`Stacks.ClosedImmersion.ClosedSubspaceData` is supplied explicitly rather than by synthesis.
The five wrappers around the fields of the data exist to confine that to one place.

## References

* [Stacks Project, Tag 01HK](https://stacks.math.columbia.edu/tag/01HK)
* [Stacks Project, Tag 01HM](https://stacks.math.columbia.edu/tag/01HM)
* [Stacks Project, Tag 01IG](https://stacks.math.columbia.edu/tag/01IG)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open RingedSpaceModuleAdjunction

universe u

namespace Stacks.ClosedImmersion

variable {R : CommRingCat.{u}} (I : Ideal ↑R)

/-! ### The closed immersion -/

/-- For an ideal `I` of a ring `R` the morphism `Spec (R ⧸ I) ⟶ Spec R` is a closed immersion
of locally ringed spaces, in the sense of Definition 01HK: a closed embedding on spaces whose
structure-sheaf map is surjective with kernel locally generated by sections. -/
@[stacks 01IG "closed_immersion_of_locally_ringed_spaces"]
theorem isClosedImmersion_specMap_quotientMk :
    IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).toLRSHom.toShHom :=
  have hci : AlgebraicGeometry.IsClosedImmersion
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) := inferInstance
  ((Stacks.AlgebraicGeometry.ClosedImmersionTFAE.closedImmersion_tfae
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))).out 1 6).mp hci

/-- The map `Spec (R ⧸ I) → Spec R` is a homeomorphism of `Spec (R ⧸ I)` onto a closed subset
of `Spec R`. -/
@[stacks 01IG "closed_embedding_onto_closed_subset"]
theorem isClosedEmbedding_specMap_quotientMk :
    Topology.IsClosedEmbedding ⇑(Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).base :=
  (isClosedImmersion_specMap_quotientMk I).isClosedEmbedding

/-! ### The closed subspace cut out by the ideal sheaf -/

/-- The inclusion of the sheaf of ideals `I^~` into the structure sheaf of `Spec R`. -/
def tildeIdealInclusion :
    tilde (ModuleCat.of ↑R I) ⟶
      SheafOfModules.unit (structureSheafRing (Spec R).toLocallyRingedSpace.toRingedSpace) :=
  tilde.map (ModuleCat.ofHom (Submodule.subtype I)) ≫ (tildeSelf (R := R)).hom

/-- `I^~` is a sheaf of ideals: its inclusion into the structure sheaf is a monomorphism, the
inclusion of `I` into `R` being injective. -/
instance mono_tildeIdealInclusion : Mono (tildeIdealInclusion I) := by
  have : Mono (tilde.map (ModuleCat.ofHom (Submodule.subtype I))) :=
    IdealSheafAffine.mono_tilde_map (M := ModuleCat.of ↑R I)
      (ModuleCat.ofHom (Submodule.subtype I)) Subtype.val_injective
  have : Mono (tildeSelf (R := R)).hom := (Iso.isIso_hom _).mono_of_iso
  exact mono_comp (tilde.map (ModuleCat.ofHom (Submodule.subtype I))) (tildeSelf (R := R)).hom

/-- `I^~` is locally generated by sections: it is quasi-coherent, and a quasi-coherent sheaf of
modules carries local generators. -/
theorem nonempty_localGeneratorsData_tilde :
    Nonempty (SheafOfModules.LocalGeneratorsData.{u} (tilde (ModuleCat.of ↑R I))) :=
  ⟨(SheafOfModules.IsQuasicoherent.nonempty_quasicoherentData
    (M := tilde (ModuleCat.of ↑R I))).some.localGeneratorsData⟩

/-- The closed subspace of `Spec R` cut out by `I^~`, the one Tag 01HN produces from the local
generators of `I^~`. This is the subspace of Example 01HM. -/
def tildeClosedSubspace :
    @ClosedSubspaceData (Spec R).toLocallyRingedSpace (tilde (ModuleCat.of ↑R I))
      (tildeIdealInclusion I) (mono_tildeIdealInclusion I) :=
  @closedSubspace (Spec R).toLocallyRingedSpace (tilde (ModuleCat.of ↑R I))
    (tildeIdealInclusion I) (mono_tildeIdealInclusion I) (nonempty_localGeneratorsData_tilde I)

/-- The underlying locally ringed space of the closed subspace cut out by `I^~`. -/
@[ega "IV 16.1.3" "16.1.3(ii), special case", ega "IV 19.1.7" "special case"]
abbrev tildeSubspace : LocallyRingedSpace.{u} :=
  @ClosedSubspaceData.space (Spec R).toLocallyRingedSpace (tilde (ModuleCat.of ↑R I))
    (tildeIdealInclusion I) (mono_tildeIdealInclusion I) (tildeClosedSubspace I)

/-- The inclusion of the closed subspace cut out by `I^~` into `Spec R`. -/
abbrev tildeSubspaceInclusion : tildeSubspace I ⟶ (Spec R).toLocallyRingedSpace :=
  @ClosedSubspaceData.inclusion (Spec R).toLocallyRingedSpace (tilde (ModuleCat.of ↑R I))
    (tildeIdealInclusion I) (mono_tildeIdealInclusion I) (tildeClosedSubspace I)

/-- The inclusion of the closed subspace cut out by `I^~` is a closed immersion. -/
instance isClosedImmersion_tildeSubspaceInclusion :
    IsClosedImmersion (tildeSubspaceInclusion I).toShHom :=
  @ClosedSubspaceData.isClosedImmersion (Spec R).toLocallyRingedSpace
    (tilde (ModuleCat.of ↑R I)) (tildeIdealInclusion I) (mono_tildeIdealInclusion I)
    (tildeClosedSubspace I)

/-- The ideal sheaf of the inclusion of the closed subspace cut out by `I^~` is `I^~`. -/
abbrev tildeSubspaceIdealIso :
    tilde (ModuleCat.of ↑R I) ≅ idealSheaf (tildeSubspaceInclusion I).toShHom :=
  @ClosedSubspaceData.idealIso (Spec R).toLocallyRingedSpace (tilde (ModuleCat.of ↑R I))
    (tildeIdealInclusion I) (mono_tildeIdealInclusion I) (tildeClosedSubspace I)

/-- That identification commutes with the two inclusions into the structure sheaf. -/
theorem tildeSubspaceIdealIso_compat :
    (tildeSubspaceIdealIso I).hom ≫ kernel.ι (SheafOfModules.unitToPushforwardObjUnit
        (structureSheafHom (tildeSubspaceInclusion I).toShHom)) =
      tildeIdealInclusion I :=
  @ClosedSubspaceData.idealIso_compat (Spec R).toLocallyRingedSpace
    (tilde (ModuleCat.of ↑R I)) (tildeIdealInclusion I) (mono_tildeIdealInclusion I)
    (tildeClosedSubspace I)

/-! ### Identification of the two closed subspaces -/

/-- The ideal sheaf of `Spec (R ⧸ I) ⟶ Spec R` is `I^~`, compatibly with the two inclusions into
`𝒪_{Spec R}`. This is the geometric affine case of Tag 01IN, restated with the inclusion named. -/
theorem exists_tildeIdealInclusion_iso_idealSheaf :
    ∃ e : tilde (ModuleCat.of ↑R I) ≅
        idealSheaf (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).toLRSHom.toShHom,
      e.hom ≫ kernel.ι (SheafOfModules.unitToPushforwardObjUnit (structureSheafHom
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).toLRSHom.toShHom)) =
        tildeIdealInclusion I :=
  IdealSheafAffine.exists_tilde_iso_kernel_quotUnitHom I

/-- `Spec (R ⧸ I)` is the closed subspace of `Spec R` cut out by the quasi-coherent sheaf of
ideals `I^~`: there is a unique isomorphism of locally ringed spaces from `Spec (R ⧸ I)` to that
closed subspace commuting with the two morphisms to `Spec R`. -/
@[stacks 01IG "iso_closed_subspace_of_tilde"]
theorem existsUnique_iso_tildeSubspace :
    ∃! t : (Spec (CommRingCat.of (↑R ⧸ I))).toLocallyRingedSpace ≅ tildeSubspace I,
      t.hom ≫ tildeSubspaceInclusion I =
        (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).toLRSHom := by
  obtain ⟨et, het⟩ := exists_tildeIdealInclusion_iso_idealSheaf I
  have hq : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).toLRSHom.toShHom :=
    isClosedImmersion_specMap_quotientMk I
  exact existsUnique_iso_of_idealSheaf_iso
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).toLRSHom (tildeSubspaceInclusion I)
    (et.symm ≪≫ tildeSubspaceIdealIso I)
    ((Category.assoc _ _ _).trans
      ((congrArg (fun z ↦ et.inv ≫ z)
        ((tildeSubspaceIdealIso_compat I).trans het.symm)).trans (et.inv_hom_id_assoc _)))

end Stacks.ClosedImmersion

end
