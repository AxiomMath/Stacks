module

public import Mathlib.Algebra.MvPolynomial.Variables
public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
public import Mathlib.AlgebraicGeometry.Limits
public import Mathlib.AlgebraicGeometry.Morphisms.Immersion
public import Mathlib.RingTheory.MvPolynomial.Basic
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.Topology.LocallyFinite
public import StacksCore.Tactic.StacksAttribute

/-!
# An immersion that does not extend to a closed immersion

Over a field `k`, let `X = Spec k[x₀, x₁, x₂, …]` be the spectrum of a polynomial ring in
countably many variables, and let `U ⊆ X` be the union of the standard opens `D(xₙ)`, that is,
the complement of the point at which every variable vanishes. On `D(xₙ)` take the ideal
generated by `xₙ - 1`, by the `(n + 1)`-st powers of the earlier variables, and by all later
variables. Two distinct charts have the unit ideal on their overlap, so these ideals define a
quasi-coherent sheaf of ideals on `U`, and hence a closed subscheme `Z ⊆ U`. The composite
`Z → U → X` is an immersion, but it is not an open immersion followed by a closed immersion:
such a factorization would have to come from an ideal of `k[x₀, x₁, x₂, …]` whose extension to
each `k[x₀, x₁, x₂, …][1/xₙ]` is the `n`-th chart ideal, and the only polynomial lying in every
chart ideal is `0`.

## Main definitions

* `polynomialRing` is the polynomial ring in countably many variables over the base field.
* `chartIdeal` is the ideal defining the closed subscheme on a standard chart.
* `ambientSpectrum` is the spectrum of that polynomial ring.
* `coordinateOpen` is the standard open where a given variable is invertible.
* `puncturedSpectrum` is the union of the standard opens.
* `nonextendableIdealSheaf` is the glued ideal sheaf on that union.
* `counterexampleImmersion` is the resulting immersion in the affine scheme.

## Main results

* `chartIdeal_overlap_top` says that distinct charts have unit ideal on their overlap.
* `iInf_chartIdeal_eq_bot` says no nonzero polynomial belongs to all chart ideals.
* `counterexampleImmersion_isImmersion` says the constructed map is an immersion.
* `counterexampleImmersion_no_open_closed_factorization` excludes the reverse
  factorization.

## Implementation notes

Variables are indexed by `ℕ`, so the indexing starts at zero, one step below the classical
indexing by positive integers. Under the shift `xₘ ↦ xₘ₊₁` the chart `n` here is the classical
chart `n + 1`, which has exactly `n` earlier variables and raises each of them to the power equal
to its own index; this is why the exponents and the number of variables raised to a power read
`n + 1` and `n`.

The chart ideals are first defined in the polynomial ring itself: since the `n`-th variable is
congruent to one modulo the `n`-th ideal, extension of that ideal to the localization inverting
the `n`-th variable gives exactly the ideal of the classical construction.

The global ideal sheaf on the punctured spectrum is not obtained from a gluing lemma for ideal
sheaves. Instead the closed subschemes of the charts are assembled into a single morphism from
their coproduct by `Sigma.desc`, that morphism is shown to be a closed immersion, and the
ideal sheaf is its kernel. The closed-embedding half of that argument is where the geometry
enters: the ranges of the chart inclusions are pairwise disjoint, and each point of the punctured
spectrum has a neighbourhood — a single standard open — meeting only one of them, so the family
of ranges is locally finite and an arbitrary union of closed pieces taken from it is closed.
The specification of the ideal sheaf is then phrased by base-changing it along each standard
open: on each chart the base change is a closed immersion whose kernel is the chart ideal, which
records the scheme structure of the subscheme and not only its underlying closed set.

Four of the auxiliary private results are general facts about schemes: the three
kernel-and-pullback lemmas `ker_pullback_snd`, `ker_of_isPullback` and `pullback_snd_comp_mono`,
which compute the kernel ideal sheaf of a base change of a closed immersion, and
`not_isOpenImmersion_spec_quotient`, which says that over a domain the spectrum of a proper
nonzero quotient is not an open subscheme, because the generic point specializes into any
nonempty open set.

## References

* [Stacks Project, Tag 01QW](https://stacks.math.columbia.edu/tag/01QW)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

namespace Stacks.Immersion.NotOpenThenClosed

/-- The polynomial ring in countably many variables over the base field. -/
public abbrev polynomialRing (k : Type u) [Field k] := MvPolynomial ℕ k

/-- The ideal cutting out the closed subscheme on the `n`-th standard chart: it is generated by
the `n`-th variable minus one, the `(n + 1)`-st powers of the earlier variables, and all later
variables. -/
@[stacks 01QW "chart ideals"]
public def chartIdeal (k : Type u) [Field k] (n : ℕ) : Ideal (polynomialRing k) :=
  Ideal.span (Set.range fun m : ℕ =>
    if m < n then (MvPolynomial.X m : polynomialRing k) ^ (n + 1)
    else if m = n then MvPolynomial.X m - 1 else MvPolynomial.X m)

private lemma chartIdeal_X_sub_one_mem (k : Type u) [Field k] (n : ℕ) :
    (MvPolynomial.X n : polynomialRing k) - 1 ∈ chartIdeal k n :=
  Ideal.subset_span ⟨n, by simp⟩

private lemma chartIdeal_X_pow_mem (k : Type u) [Field k] (n m : ℕ) (hmn : m < n) :
    (MvPolynomial.X m : polynomialRing k) ^ (n + 1) ∈ chartIdeal k n :=
  Ideal.subset_span ⟨m, by simp [hmn]⟩

private lemma chartIdeal_X_mem (k : Type u) [Field k] (n m : ℕ) (hmn : n < m) :
    (MvPolynomial.X m : polynomialRing k) ∈ chartIdeal k n :=
  Ideal.subset_span ⟨m, by simp [not_lt_of_gt hmn, ne_of_gt hmn]⟩

private lemma chartQuotient_X_eq_one (k : Type u) [Field k] (n : ℕ) :
    Ideal.Quotient.mk (chartIdeal k n) (MvPolynomial.X n : polynomialRing k) = 1 :=
  (Ideal.Quotient.eq).2 (chartIdeal_X_sub_one_mem k n)

/-- The affine scheme in which the immersion lands: the spectrum of the polynomial ring in
countably many variables. -/
public abbrev ambientSpectrum (k : Type u) [Field k] : Scheme.{u} :=
  Spec (.of (polynomialRing k))

/-- The `n`-th standard open of the ambient spectrum, where the `n`-th variable is invertible. -/
public abbrev coordinateOpen (k : Type u) [Field k] (n : ℕ) :
    (ambientSpectrum k).Opens :=
  PrimeSpectrum.basicOpen (MvPolynomial.X n : polynomialRing k)

/-- The union of the standard opens: the complement of the point at which every variable
vanishes. -/
@[stacks 01QW "union of standard opens"]
public abbrev puncturedSpectrum (k : Type u) [Field k] :
    (ambientSpectrum k).Opens :=
  ⨆ n : ℕ, coordinateOpen k n

private noncomputable def chartQuotientMap (k : Type u) [Field k] (n : ℕ) :
    Spec (.of (polynomialRing k ⧸ chartIdeal k n)) ⟶ ambientSpectrum k :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (chartIdeal k n)))

private lemma chartQuotientMap_mem_coordinateOpen (k : Type u) [Field k] (n : ℕ)
    (z : Spec (.of (polynomialRing k ⧸ chartIdeal k n))) :
    chartQuotientMap k n z ∈ coordinateOpen k n := by
  change (Ideal.Quotient.mk (chartIdeal k n) (MvPolynomial.X n : polynomialRing k)) ∉ z.1
  rw [chartQuotient_X_eq_one]
  exact (Ideal.ne_top_iff_one _).mp z.isPrime.ne_top

private lemma chartQuotientMap_range_subset (k : Type u) [Field k] (n : ℕ) :
    Set.range (chartQuotientMap k n) ⊆ (puncturedSpectrum k : Set (ambientSpectrum k)) := by
  rintro y ⟨z, rfl⟩
  change chartQuotientMap k n z ∈ puncturedSpectrum k
  rw [puncturedSpectrum, TopologicalSpace.Opens.mem_iSup]
  exact ⟨n, chartQuotientMap_mem_coordinateOpen k n z⟩

private noncomputable def chartQuotientToPunctured (k : Type u) [Field k] (n : ℕ) :
    Spec (.of (polynomialRing k ⧸ chartIdeal k n)) ⟶ (puncturedSpectrum k).toScheme :=
  IsOpenImmersion.lift (puncturedSpectrum k).ι (chartQuotientMap k n)
    (by simpa only [Scheme.Opens.range_ι] using chartQuotientMap_range_subset k n)

private lemma chartQuotientToPunctured_comp (k : Type u) [Field k] (n : ℕ) :
    chartQuotientToPunctured k n ≫ (puncturedSpectrum k).ι = chartQuotientMap k n :=
  IsOpenImmersion.lift_fac _ _ _

private lemma chartQuotientToPunctured_isClosedImmersion (k : Type u) [Field k] (n : ℕ) :
    IsClosedImmersion (chartQuotientToPunctured k n) := by
  have : IsClosedImmersion
      (chartQuotientToPunctured k n ≫ (puncturedSpectrum k).ι) := by
    rw [chartQuotientToPunctured_comp]
    exact IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  exact IsClosedImmersion.of_comp (chartQuotientToPunctured k n) (puncturedSpectrum k).ι

attribute [local instance] chartQuotientToPunctured_isClosedImmersion

private lemma chartQuotientMap_X_mem_comap (k : Type u) [Field k] (n m : ℕ) (hnm : n ≠ m)
    (z : PrimeSpectrum (polynomialRing k ⧸ chartIdeal k n)) :
    MvPolynomial.X m ∈ Ideal.comap (Ideal.Quotient.mk (chartIdeal k n)) z.asIdeal := by
  change Ideal.Quotient.mk (chartIdeal k n) (MvPolynomial.X m) ∈ z.asIdeal
  by_cases hmn : m < n
  · refine z.isPrime.mem_of_pow_mem (n + 1) ?_
    rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem.mpr (chartIdeal_X_pow_mem k n m hmn)]
    exact z.asIdeal.zero_mem
  · rw [Ideal.Quotient.eq_zero_iff_mem.mpr (chartIdeal_X_mem k n m (by omega))]
    exact z.asIdeal.zero_mem

private lemma chartQuotientMap_not_mem_coordinateOpen (k : Type u) [Field k]
    (n m : ℕ) (hnm : n ≠ m)
    (z : PrimeSpectrum (polynomialRing k ⧸ chartIdeal k n)) :
    chartQuotientMap k n z ∉ coordinateOpen k m := by
  change PrimeSpectrum.comap (Ideal.Quotient.mk (chartIdeal k n)) z ∉
    PrimeSpectrum.basicOpen (MvPolynomial.X m : polynomialRing k)
  rw [PrimeSpectrum.mem_basicOpen, PrimeSpectrum.comap_asIdeal]
  exact fun hx => hx (chartQuotientMap_X_mem_comap k n m hnm z)

private noncomputable def chartQuotientCoproductMap (k : Type u) [Field k] :
    (∐ fun n : ℕ => Spec (.of (polynomialRing k ⧸ chartIdeal k n))) ⟶
      (puncturedSpectrum k).toScheme :=
  Sigma.desc (fun n => chartQuotientToPunctured k n)

private lemma chartQuotientCoproductMap_ι (k : Type u) [Field k] (n : ℕ) :
    Sigma.ι (fun n : ℕ => Spec (.of (polynomialRing k ⧸ chartIdeal k n))) n ≫
      chartQuotientCoproductMap k = chartQuotientToPunctured k n :=
  Sigma.ι_desc _ _

private lemma sigmaOpenCover_f_comp_chartQuotientCoproductMap (k : Type u) [Field k] (n : ℕ) :
    (AlgebraicGeometry.sigmaOpenCover
        fun m : ℕ => Spec (.of (polynomialRing k ⧸ chartIdeal k m))).f n ≫
      chartQuotientCoproductMap k = chartQuotientToPunctured k n := by
  dsimp [AlgebraicGeometry.sigmaOpenCover]
  exact chartQuotientCoproductMap_ι k n

private noncomputable def coordinateOpenToPunctured (k : Type u) [Field k] (n : ℕ) :
    (coordinateOpen k n).toScheme ⟶ (puncturedSpectrum k).toScheme :=
  IsOpenImmersion.lift (puncturedSpectrum k).ι (coordinateOpen k n).ι (by
    have h : (coordinateOpen k n : Set (ambientSpectrum k)) ⊆
        (puncturedSpectrum k : Set (ambientSpectrum k)) := by
      intro x hx
      exact (le_iSup (coordinateOpen k) n) hx
    simpa only [Scheme.Opens.range_ι] using h)

private lemma coordinateOpenToPunctured_comp (k : Type u) [Field k] (n : ℕ) :
    coordinateOpenToPunctured k n ≫ (puncturedSpectrum k).ι = (coordinateOpen k n).ι :=
  IsOpenImmersion.lift_fac _ _ _

private lemma coordinateOpenToPunctured_isOpenImmersion (k : Type u) [Field k] (n : ℕ) :
    IsOpenImmersion (coordinateOpenToPunctured k n) := by
  have : IsOpenImmersion
      (coordinateOpenToPunctured k n ≫ (puncturedSpectrum k).ι) := by
    rw [coordinateOpenToPunctured_comp]
    infer_instance
  exact IsOpenImmersion.of_comp (coordinateOpenToPunctured k n) (puncturedSpectrum k).ι

attribute [local instance] coordinateOpenToPunctured_isOpenImmersion

private lemma ι_coordinateOpenToPunctured (k : Type u) [Field k] (n : ℕ)
    (w : (coordinateOpen k n).toScheme) :
    (puncturedSpectrum k).ι (coordinateOpenToPunctured k n w) = (coordinateOpen k n).ι w := by
  rw [← Scheme.Hom.comp_apply, coordinateOpenToPunctured_comp]

private lemma ι_chartQuotientToPunctured (k : Type u) [Field k] (n : ℕ)
    (z : Spec (.of (polynomialRing k ⧸ chartIdeal k n))) :
    (puncturedSpectrum k).ι (chartQuotientToPunctured k n z) = chartQuotientMap k n z := by
  rw [← Scheme.Hom.comp_apply, chartQuotientToPunctured_comp]

private lemma mem_opensRange_coordinateOpenToPunctured_iff (k : Type u) [Field k] (n : ℕ)
    (x : (puncturedSpectrum k).toScheme) :
    x ∈ (coordinateOpenToPunctured k n).opensRange ↔
      (puncturedSpectrum k).ι x ∈ coordinateOpen k n := by
  constructor
  · intro h
    obtain ⟨w, rfl⟩ := Scheme.Hom.mem_opensRange.mp h
    rw [ι_coordinateOpenToPunctured]
    exact w.property
  · intro h
    refine Scheme.Hom.mem_opensRange.mpr ⟨⟨(puncturedSpectrum k).ι x, h⟩, ?_⟩
    apply (puncturedSpectrum k).ι.isOpenEmbedding.injective
    exact ι_coordinateOpenToPunctured k n ⟨_, h⟩

private lemma chartQuotientToPunctured_mem_coordinateOpenRange (k : Type u) [Field k]
    (n m : ℕ) (z : Spec (.of (polynomialRing k ⧸ chartIdeal k m))) :
    chartQuotientToPunctured k m z ∈ (coordinateOpenToPunctured k n).opensRange ↔ m = n := by
  rw [mem_opensRange_coordinateOpenToPunctured_iff, ι_chartQuotientToPunctured]
  constructor
  · intro h
    by_contra hmn
    exact chartQuotientMap_not_mem_coordinateOpen k m n hmn z h
  · rintro rfl
    exact chartQuotientMap_mem_coordinateOpen k m z

private lemma chartQuotientCoproductMap_range_locallyFinite (k : Type u) [Field k] :
    LocallyFinite (fun n => Set.range (chartQuotientToPunctured k n)) := by
  intro x
  obtain ⟨m, hm⟩ := (TopologicalSpace.Opens.mem_iSup.mp x.2)
  have : IsOpenImmersion (coordinateOpenToPunctured k m) :=
    coordinateOpenToPunctured_isOpenImmersion k m
  refine ⟨((coordinateOpenToPunctured k m).opensRange : Set _),
    (coordinateOpenToPunctured k m).opensRange.2.mem_nhds
      ((mem_opensRange_coordinateOpenToPunctured_iff k m x).mpr hm), ?_⟩
  refine Set.Finite.subset (Set.finite_singleton m) ?_
  rintro n ⟨y, ⟨z, rfl⟩, hy⟩
  exact (chartQuotientToPunctured_mem_coordinateOpenRange k m n z).mp hy

private lemma chartQuotientCoproductMap_closedEmbedding (k : Type u) [Field k] :
    Topology.IsClosedEmbedding (chartQuotientCoproductMap k) := by
  classical
  let f := chartQuotientCoproductMap k
  let Xs := fun n : ℕ => Spec (.of (polynomialRing k ⧸ chartIdeal k n))
  let 𝒰 := AlgebraicGeometry.sigmaOpenCover Xs
  have hcomp (n : ℕ) : 𝒰.f n ≫ f = chartQuotientToPunctured k n :=
    sigmaOpenCover_f_comp_chartQuotientCoproductMap k n
  refine Topology.IsClosedEmbedding.of_continuous_injective_isClosedMap f.continuous ?_ ?_
  · intro x y hxy
    obtain ⟨n, z, hx⟩ := 𝒰.exists_eq x
    obtain ⟨m, w, hy⟩ := 𝒰.exists_eq y
    change ℕ at n m
    rw [← hx, ← hy, ← Scheme.Hom.comp_apply (𝒰.f n) f,
      ← Scheme.Hom.comp_apply (𝒰.f m) f, hcomp n, hcomp m] at hxy
    by_cases hnm : n = m
    · subst m
      rw [← hx, ← hy]
      exact congrArg (𝒰.f n) ((chartQuotientToPunctured k n).isClosedEmbedding.injective hxy)
    · refine (hnm ((chartQuotientToPunctured_mem_coordinateOpenRange k n m w).mp ?_).symm).elim
      exact hxy ▸ (chartQuotientToPunctured_mem_coordinateOpenRange k n n z).mpr rfl
  · intro s hs
    let sn : (n : ℕ) → Set (Xs n) := fun n z => 𝒰.f n z ∈ s
    have hsn (n : ℕ) : IsClosed (sn n) := hs.preimage (𝒰.f n).continuous
    have hclosed (n : ℕ) : IsClosed (chartQuotientToPunctured k n '' sn n) :=
      (chartQuotientToPunctured k n).isClosedEmbedding.isClosedMap _ (hsn n)
    have hloc : LocallyFinite (fun n => chartQuotientToPunctured k n '' sn n) :=
      (chartQuotientCoproductMap_range_locallyFinite k).subset fun n =>
        Set.image_subset_range (chartQuotientToPunctured k n) (sn n)
    have hEq : f '' s = ⋃ n, chartQuotientToPunctured k n '' sn n := by
      ext x
      constructor
      · rintro ⟨y, hy, rfl⟩
        obtain ⟨n, z, hyz⟩ := 𝒰.exists_eq y
        refine Set.mem_iUnion.mpr ⟨n, ?_⟩
        refine ⟨z, ?_, ?_⟩
        · change 𝒰.f n z ∈ s
          rw [hyz]
          exact hy
        · calc
            chartQuotientToPunctured k n z = (𝒰.f n ≫ f) z :=
              (congrArg (fun g => g z) (hcomp n)).symm
            _ = f y := by rw [Scheme.Hom.comp_apply, hyz]
      · intro hx
        obtain ⟨n, hx⟩ := Set.mem_iUnion.mp hx
        obtain ⟨z, hz, rfl⟩ := hx
        refine ⟨𝒰.f n z, hz, ?_⟩
        calc
          f (𝒰.f n z) = (𝒰.f n ≫ f) z :=
            (Scheme.Hom.comp_apply (𝒰.f n) f z).symm
          _ = chartQuotientToPunctured k n z := congrArg (fun g => g z) (hcomp n)
    rw [hEq]
    exact hloc.isClosed_iUnion hclosed

private lemma chartQuotientCoproductMap_isClosedImmersion (k : Type u) [Field k] :
    IsClosedImmersion (chartQuotientCoproductMap k) := by
  let Xs := fun n : ℕ => Spec (.of (polynomialRing k ⧸ chartIdeal k n))
  let 𝒰 := AlgebraicGeometry.sigmaOpenCover Xs
  have hs : SurjectiveOnStalks (chartQuotientCoproductMap k) := by
    rw [IsZariskiLocalAtSource.iff_of_openCover (P := @SurjectiveOnStalks) 𝒰]
    intro n
    have hcomp : 𝒰.f n ≫ chartQuotientCoproductMap k = chartQuotientToPunctured k n :=
      sigmaOpenCover_f_comp_chartQuotientCoproductMap k n
    rw [hcomp]
    exact ⟨(chartQuotientToPunctured_isClosedImmersion k n).stalkMap_surjective⟩
  have hp : IsPreimmersion (chartQuotientCoproductMap k) := {
    isEmbedding := (chartQuotientCoproductMap_closedEmbedding k).toIsEmbedding
    toSurjectiveOnStalks := hs }
  exact IsClosedImmersion.of_isPreimmersion _
    (chartQuotientCoproductMap_closedEmbedding k).isClosed_range

private lemma chartQuotientCoproductMap_preimage_coordinateOpen (k : Type u) [Field k]
    (n : ℕ) :
    chartQuotientCoproductMap k ⁻¹ᵁ (coordinateOpenToPunctured k n).opensRange =
      (Sigma.ι (fun m : ℕ => Spec (.of (polynomialRing k ⧸ chartIdeal k m))) n).opensRange := by
  ext x
  constructor
  · intro hx
    let Xs := fun m : ℕ => Spec (.of (polynomialRing k ⧸ chartIdeal k m))
    let 𝒰 := AlgebraicGeometry.sigmaOpenCover Xs
    obtain ⟨m, z, hzx⟩ := 𝒰.exists_eq x
    change ℕ at m
    have hm : m = n := by
      apply (chartQuotientToPunctured_mem_coordinateOpenRange k n m z).mp
      have hcomp : 𝒰.f m ≫ chartQuotientCoproductMap k =
          chartQuotientToPunctured k m :=
        sigmaOpenCover_f_comp_chartQuotientCoproductMap k m
      have hx' : (𝒰.f m ≫ chartQuotientCoproductMap k) z ∈
          (coordinateOpenToPunctured k n).opensRange := by
        change chartQuotientCoproductMap k x ∈
          (coordinateOpenToPunctured k n).opensRange at hx
        rw [← hzx] at hx
        exact hx
      rw [hcomp] at hx'
      exact hx'
    subst m
    exact ⟨z, hzx⟩
  · rintro ⟨z, rfl⟩
    change (Sigma.ι (fun m : ℕ => Spec (.of (polynomialRing k ⧸ chartIdeal k m))) n ≫
      chartQuotientCoproductMap k) z ∈ (coordinateOpenToPunctured k n).opensRange
    rw [chartQuotientCoproductMap_ι]
    exact (chartQuotientToPunctured_mem_coordinateOpenRange k n n z).mpr rfl

private noncomputable def chartQuotientToCoordinateOpen (k : Type u) [Field k] (n : ℕ) :
    Spec (.of (polynomialRing k ⧸ chartIdeal k n)) ⟶ (coordinateOpen k n).toScheme :=
  IsOpenImmersion.lift (coordinateOpenToPunctured k n) (chartQuotientToPunctured k n) (by
    rintro y ⟨z, rfl⟩
    exact (chartQuotientToPunctured_mem_coordinateOpenRange k n n z).mpr rfl)

private lemma chartQuotientToCoordinateOpen_comp (k : Type u) [Field k] (n : ℕ) :
    chartQuotientToCoordinateOpen k n ≫ coordinateOpenToPunctured k n =
      chartQuotientToPunctured k n :=
  IsOpenImmersion.lift_fac _ _ _

private lemma chartQuotientToCoordinateOpen_comp_ambient
    (k : Type u) [Field k] (n : ℕ) :
    chartQuotientToCoordinateOpen k n ≫ (coordinateOpen k n).ι =
      chartQuotientMap k n := by
  rw [← coordinateOpenToPunctured_comp, ← Category.assoc,
    chartQuotientToCoordinateOpen_comp, chartQuotientToPunctured_comp]

private noncomputable def chartQuotientToCoproductPullback (k : Type u) [Field k] (n : ℕ) :
    Spec (.of (polynomialRing k ⧸ chartIdeal k n)) ⟶
      pullback (chartQuotientCoproductMap k) (coordinateOpenToPunctured k n) :=
  pullback.lift
    (Sigma.ι (fun m : ℕ => Spec (.of (polynomialRing k ⧸ chartIdeal k m))) n)
    (chartQuotientToCoordinateOpen k n) (by
      rw [chartQuotientCoproductMap_ι, chartQuotientToCoordinateOpen_comp])

private lemma chartQuotientToCoproductPullback_isIso (k : Type u) [Field k]
    (n : ℕ) :
    IsIso (chartQuotientToCoproductPullback k n) := by
  let l := chartQuotientToCoproductPullback k n
  have hl : IsOpenImmersion l := by
    have hcomp : IsOpenImmersion (chartQuotientToCoproductPullback k n ≫ pullback.fst
        (chartQuotientCoproductMap k) (coordinateOpenToPunctured k n)) := by
      rw [chartQuotientToCoproductPullback, pullback.lift_fst]
      infer_instance
    exact IsOpenImmersion.of_comp l (pullback.fst
      (chartQuotientCoproductMap k) (coordinateOpenToPunctured k n))
  have hsurj : Function.Surjective l := by
    intro y
    have hx' : pullback.fst (chartQuotientCoproductMap k)
        (coordinateOpenToPunctured k n) y ∈
        (chartQuotientCoproductMap k) ⁻¹ᵁ
          (coordinateOpenToPunctured k n).opensRange := by
      refine ⟨pullback.snd (chartQuotientCoproductMap k)
        (coordinateOpenToPunctured k n) y, ?_⟩
      have h := congrArg (fun f => f y) (pullback.condition
        (f := chartQuotientCoproductMap k) (g := coordinateOpenToPunctured k n))
      simpa using h.symm
    rw [chartQuotientCoproductMap_preimage_coordinateOpen] at hx'
    obtain ⟨z, hz⟩ := Scheme.Hom.mem_opensRange.mp hx'
    refine ⟨z, ?_⟩
    apply (pullback.fst (chartQuotientCoproductMap k)
      (coordinateOpenToPunctured k n)).isOpenEmbedding.injective
    change (chartQuotientToCoproductPullback k n ≫
      pullback.fst (chartQuotientCoproductMap k) (coordinateOpenToPunctured k n)) z = _
    simpa only [chartQuotientToCoproductPullback, pullback.lift_fst] using hz
  have : Epi l.base := (TopCat.epi_iff_surjective _).mpr hsurj
  exact IsOpenImmersion.isIso l

private lemma ker_pullback_snd {X Y Z : Scheme.{u}} (f : X ⟶ Z) (g : Y ⟶ Z)
    [IsClosedImmersion f] : (pullback.snd f g).ker = f.ker.comap g := by
  rw [← Scheme.Hom.ker_comp_of_isIso (pullbackSymmetry g f).hom,
    pullbackSymmetry_hom_comp_snd, Scheme.IdealSheafData.ker_fst_of_isClosedImmersion]

private lemma ker_of_isPullback {X Y V W : Scheme.{u}}
    {f : X ⟶ Y} {f' : V ⟶ W} {i : V ⟶ X} {j : W ⟶ Y}
    [IsClosedImmersion f] (h : IsPullback f' i j f) : f'.ker = f.ker.comap j := by
  rw [← Scheme.IdealSheafData.ker_fst_of_isClosedImmersion f j,
    ← Scheme.Hom.ker_comp_of_isIso h.isoPullback.hom, h.isoPullback_hom_fst]

private lemma pullback_snd_comp_mono {X Y V W : Scheme.{u}}
    (f : X ⟶ Y) (i : V ⟶ Y) (j : Y ⟶ W) [Mono j] [IsClosedImmersion f] :
    IsClosedImmersion (pullback.snd (f ≫ j) (i ≫ j)) ∧
      (pullback.snd (f ≫ j) (i ≫ j)).ker = f.ker.comap i := by
  have hp : IsPullback (pullback.fst f i) (pullback.snd f i) (f ≫ j) (i ≫ j) :=
    IsPullback.of_isLimit (pullbackIsPullbackOfCompMono f i j)
  constructor
  · rw [← hp.isoPullback_inv_snd]
    infer_instance
  · rw [← hp.isoPullback_inv_snd, Scheme.Hom.ker_comp_of_isIso]
    exact ker_pullback_snd f i

private lemma chartQuotientToCoordinateOpen_ker (k : Type u) [Field k] (n : ℕ) :
    (chartQuotientToCoordinateOpen k n).ker =
      (chartQuotientMap k n).ker.comap (coordinateOpen k n).ι := by
  have : IsClosedImmersion (chartQuotientMap k n) :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  exact ker_of_isPullback (IsPullback.of_vert_isIso_mono
    (show CommSq (chartQuotientToCoordinateOpen k n) (𝟙 _) (coordinateOpen k n).ι
      (chartQuotientMap k n) from
      ⟨by simpa using chartQuotientToCoordinateOpen_comp_ambient k n⟩))

private lemma chartQuotientCoproductMap_ker_comap (k : Type u) [Field k] (n : ℕ) :
    (chartQuotientCoproductMap k).ker.comap (coordinateOpenToPunctured k n) =
      (chartQuotientMap k n).ker.comap (coordinateOpen k n).ι := by
  have := chartQuotientCoproductMap_isClosedImmersion k
  have := chartQuotientToCoproductPullback_isIso k n
  have hp : IsPullback
      (Sigma.ι (fun m : ℕ => Spec (.of (polynomialRing k ⧸ chartIdeal k m))) n)
      (chartQuotientToCoordinateOpen k n)
      (chartQuotientCoproductMap k) (coordinateOpenToPunctured k n) :=
    IsPullback.of_iso_pullback
      ⟨by rw [chartQuotientCoproductMap_ι, chartQuotientToCoordinateOpen_comp]⟩
      (asIso (chartQuotientToCoproductPullback k n))
      (by exact pullback.lift_fst _ _ _)
      (by exact pullback.lift_snd _ _ _)
  rw [← ker_of_isPullback hp.flip]
  exact chartQuotientToCoordinateOpen_ker k n

private lemma nonempty_nonextendableIdealSheaf (k : Type u) [Field k] :
    Nonempty { J : (puncturedSpectrum k).toScheme.IdealSheafData //
      ∀ n : ℕ,
        IsClosedImmersion
          (pullback.snd (J.subschemeι ≫ (puncturedSpectrum k).ι)
            (coordinateOpen k n).ι) ∧
        (pullback.snd (J.subschemeι ≫ (puncturedSpectrum k).ι)
          (coordinateOpen k n).ι).ker =
          ((Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (chartIdeal k n)))).ker).comap
            (coordinateOpen k n).ι } := by
  refine ⟨⟨(chartQuotientCoproductMap k).ker, fun n => ?_⟩⟩
  have h := pullback_snd_comp_mono (chartQuotientCoproductMap k).ker.subschemeι
    (coordinateOpenToPunctured k n) (puncturedSpectrum k).ι
  rw [coordinateOpenToPunctured_comp, Scheme.IdealSheafData.ker_subschemeι] at h
  exact ⟨h.1, h.2.trans (chartQuotientCoproductMap_ker_comap k n)⟩

/-- The ideal sheaf glued from the specified ideals on the standard-open cover. -/
@[stacks 01QW "glued quasi-coherent ideal sheaf"]
public noncomputable def nonextendableIdealSheaf (k : Type u) [Field k] :
    { J : (puncturedSpectrum k).toScheme.IdealSheafData //
      ∀ n : ℕ,
        IsClosedImmersion
          (pullback.snd (J.subschemeι ≫ (puncturedSpectrum k).ι)
            (coordinateOpen k n).ι) ∧
        (pullback.snd (J.subschemeι ≫ (puncturedSpectrum k).ι)
          (coordinateOpen k n).ι).ker =
          ((Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (chartIdeal k n)))).ker).comap
            (coordinateOpen k n).ι } :=
  -- The witness is the kernel ideal sheaf of the morphism from the coproduct of the chart
  -- subschemes; the construction itself is not part of the interface.
  Classical.choice (private_decl% (nonempty_nonextendableIdealSheaf k))

/-- The immersion of the closed subscheme of the punctured spectrum into the ambient affine
scheme. -/
@[stacks 01QW "associated morphism"]
public noncomputable def counterexampleImmersion (k : Type u) [Field k] :
    (nonextendableIdealSheaf k).1.subscheme ⟶ ambientSpectrum k :=
  (nonextendableIdealSheaf k).1.subschemeι ≫ (puncturedSpectrum k).ι

/-- Away from two distinct variables, the indicated chart ideal is the unit ideal. -/
@[stacks 01QW "unit ideal on distinct chart overlaps"]
public theorem chartIdeal_overlap_top (k : Type u) [Field k] (n m : ℕ) (hnm : n ≠ m) :
    (chartIdeal k n).map
      (algebraMap (polynomialRing k)
        (Localization.Away ((MvPolynomial.X n : polynomialRing k) *
          MvPolynomial.X m))) = ⊤ := by
  classical
  let R := polynomialRing k
  let S := Localization.Away ((MvPolynomial.X n : R) * MvPolynomial.X m)
  let x : R := MvPolynomial.X m
  have hx : IsUnit (algebraMap R S x) := by
    have hp : IsUnit (algebraMap R S ((MvPolynomial.X n : R) * MvPolynomial.X m)) :=
      IsLocalization.Away.algebraMap_isUnit _
    exact isUnit_of_mul_isUnit_right (by simpa only [map_mul] using hp)
  by_cases hmn : m < n
  · exact Ideal.eq_top_of_isUnit_mem (I := (chartIdeal k n).map (algebraMap R S))
      (by simpa only [map_pow] using
        (Ideal.mem_map_of_mem (algebraMap R S) (chartIdeal_X_pow_mem k n m hmn)))
      (hx.pow (n + 1))
  · have hnm' : n < m := by omega
    exact Ideal.eq_top_of_isUnit_mem (I := (chartIdeal k n).map (algebraMap R S))
      (Ideal.mem_map_of_mem (algebraMap R S) (chartIdeal_X_mem k n m hnm')) hx

/-- Specializing every variable of index at least `N` maps the `N`-th chart ideal into the
`(N + 1)`-st power of the ideal of variables, and fixes polynomials in the earlier variables. -/
private theorem mem_pow_idealOfVars_of_mem_chartIdeal (k : Type u) [Field k]
    {p : polynomialRing k} {N : ℕ} (hN : ∀ i ∈ p.vars, i < N) (hp : p ∈ chartIdeal k N) :
    p ∈ MvPolynomial.idealOfVars ℕ k ^ (N + 1) := by
  classical
  let φ : polynomialRing k →+* polynomialRing k :=
    MvPolynomial.eval₂Hom (MvPolynomial.C : k →+* polynomialRing k) (fun i =>
      if i < N then MvPolynomial.X i
      else if i = N then 1 else 0)
  have hfix : φ p = p := by
    change φ p = RingHom.id _ p
    apply MvPolynomial.hom_congr_vars
    · ext a
      simp [φ]
    · intro i hi _
      simp [φ, hN i hi]
    · rfl
  have hgen : ∀ m : ℕ,
      φ (if m < N then (MvPolynomial.X m : polynomialRing k) ^ (N + 1)
        else if m = N then MvPolynomial.X m - 1 else MvPolynomial.X m) ∈
        MvPolynomial.idealOfVars ℕ k ^ (N + 1) := by
    intro m
    by_cases hm : m < N
    · have hx : (MvPolynomial.X m : polynomialRing k) ∈ MvPolynomial.idealOfVars ℕ k := by
        change (MvPolynomial.X m : polynomialRing k) ∈
          Ideal.span (Set.range (fun i : ℕ => (MvPolynomial.X i : polynomialRing k)))
        exact Ideal.subset_span ⟨m, rfl⟩
      simpa [hm, φ] using Ideal.pow_mem_pow hx (N + 1)
    · by_cases hmeq : m = N
      · subst m
        simp [φ]
      · simp [hm, hmeq, φ]
  have hmap : Ideal.map φ (chartIdeal k N) ≤
      MvPolynomial.idealOfVars ℕ k ^ (N + 1) := by
    rw [Ideal.map_le_iff_le_comap]
    exact Ideal.span_le.mpr (Set.range_subset_iff.mpr hgen)
  rw [← hfix]
  exact hmap (Ideal.mem_map_of_mem φ hp)

/-- The chart ideals have zero intersection in the original polynomial ring. -/
@[stacks 01QW "intersection of chart ideals"]
public theorem iInf_chartIdeal_eq_bot (k : Type u) [Field k] :
    (⨅ n : ℕ, chartIdeal k n) = ⊥ := by
  classical
  rw [eq_bot_iff]
  intro p hp
  rw [Ideal.mem_iInf] at hp
  rw [Ideal.mem_bot]
  let N : ℕ := max (p.vars.sup id) (p.support.sup Finsupp.degree) + 1
  have hvars : ∀ i ∈ p.vars, i < N := by
    intro i hi
    dsimp [N]
    have hle : i ≤ p.vars.sup id := Finset.le_sup (f := id) hi
    omega
  have hpow := mem_pow_idealOfVars_of_mem_chartIdeal k hvars (hp N)
  rw [MvPolynomial.mem_pow_idealOfVars_iff] at hpow
  apply MvPolynomial.ext
  intro d
  by_cases hd : d ∈ p.support
  · have hdeg : d.degree < N := by
      dsimp [N]
      have hle : d.degree ≤ p.support.sup Finsupp.degree :=
        Finset.le_sup (f := Finsupp.degree) hd
      omega
    have hlarge := hpow d hd
    omega
  · simpa using hd

/-- The closed subscheme of the punctured spectrum is an immersion in the ambient spectrum. -/
@[stacks 01QW "immersion"]
public theorem counterexampleImmersion_isImmersion (k : Type u) [Field k] :
    IsImmersion (counterexampleImmersion k) := by
  rw [AlgebraicGeometry.IsImmersion.isImmersion_iff_exists]
  exact ⟨_, (nonextendableIdealSheaf k).1.subschemeι,
    (puncturedSpectrum k).ι, inferInstance, inferInstance, rfl⟩

private lemma exists_chart_lift (k : Type u) [Field k] (n : ℕ) :
    ∃ d : Spec (.of (polynomialRing k ⧸ chartIdeal k n)) ⟶
        (nonextendableIdealSheaf k).1.subscheme,
      IsOpenImmersion d ∧ d ≫ counterexampleImmersion k = chartQuotientMap k n := by
  let f := counterexampleImmersion k
  let p := pullback.snd f (coordinateOpen k n).ι
  have hp : IsClosedImmersion p := (nonextendableIdealSheaf k).2 n |>.1
  have hker : p.ker = (chartQuotientToCoordinateOpen k n).ker :=
    ((nonextendableIdealSheaf k).2 n).2.trans
      (chartQuotientToCoordinateOpen_ker k n).symm
  have : IsClosedImmersion (chartQuotientMap k n) :=
    IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective
  have : IsClosedImmersion (chartQuotientToCoordinateOpen k n ≫ (coordinateOpen k n).ι) := by
    rw [chartQuotientToCoordinateOpen_comp_ambient]
    infer_instance
  have : IsClosedImmersion (chartQuotientToCoordinateOpen k n) :=
    IsClosedImmersion.of_comp _ (coordinateOpen k n).ι
  let a := IsClosedImmersion.lift p (chartQuotientToCoordinateOpen k n) hker.le
  have : IsIso a := IsClosedImmersion.isIso_lift _ _ hker
  refine ⟨a ≫ pullback.fst f (coordinateOpen k n).ι, inferInstance, ?_⟩
  change (a ≫ pullback.fst f (coordinateOpen k n).ι) ≫ f = _
  rw [Category.assoc, pullback.condition, ← Category.assoc]
  exact (congrArg (fun e => e ≫ (coordinateOpen k n).ι)
    (IsClosedImmersion.lift_fac p (chartQuotientToCoordinateOpen k n) hker.le)).trans
    (chartQuotientToCoordinateOpen_comp_ambient k n)

private lemma idealSheaf_eq_bot_of_le_chart_ker (k : Type u) [Field k]
    (I : (ambientSpectrum k).IdealSheafData)
    (hI : ∀ n : ℕ, I ≤ (chartQuotientMap k n).ker) : I = ⊥ := by
  apply le_antisymm _ bot_le
  apply Scheme.IdealSheafData.le_of_isAffine
  intro s hs
  change s = 0
  let e := Scheme.ΓSpecIso (.of (polynomialRing k))
  have hzero : e.hom s = 0 := by
    have hmem : e.hom s ∈ ⨅ n : ℕ, chartIdeal k n := by
      rw [Ideal.mem_iInf]
      intro n
      have hs' := (chartQuotientMap k n).ideal_ker_le _ (hI n _ hs)
      change (chartQuotientMap k n).appTop s = 0 at hs'
      rw [← Ideal.Quotient.eq_zero_iff_mem]
      have hn := ConcreteCategory.congr_hom
        (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom (Ideal.Quotient.mk (chartIdeal k n)))) s
      change (Scheme.ΓSpecIso (.of (polynomialRing k ⧸ chartIdeal k n))).hom
          ((chartQuotientMap k n).appTop s) =
        Ideal.Quotient.mk (chartIdeal k n) (e.hom s) at hn
      rw [hs', map_zero] at hn
      exact hn.symm
    simpa only [iInf_chartIdeal_eq_bot, Ideal.mem_bot] using hmem
  exact (ConcreteCategory.bijective_of_isIso e.hom).1 (by simpa using hzero)

private lemma chartIdeal_ne_top (k : Type u) [Field k] (n : ℕ) :
    chartIdeal k n ≠ ⊤ := by
  let φ : polynomialRing k →+* k := MvPolynomial.eval (fun m => if m = n then 1 else 0)
  have hle : chartIdeal k n ≤ RingHom.ker φ := by
    apply Ideal.span_le.mpr
    rintro _ ⟨m, rfl⟩
    by_cases hmn : m < n
    · simp [φ, hmn, ne_of_lt hmn]
    · by_cases heq : m = n
      · subst m
        simp [φ]
      · simp [φ, hmn, heq]
  exact ne_top_of_le_ne_top (RingHom.ker_ne_top φ) hle

private lemma chartIdeal_ne_bot (k : Type u) [Field k] (n : ℕ) :
    chartIdeal k n ≠ ⊥ := by
  intro h
  have hx := chartIdeal_X_sub_one_mem k n
  rw [h, Ideal.mem_bot] at hx
  have he := congrArg (MvPolynomial.eval (fun _ : ℕ => (0 : k))) hx
  simp at he

private lemma not_isOpenImmersion_spec_quotient {R : Type u} [CommRing R] [IsDomain R]
    (I : Ideal R) (hI : I ≠ ⊥) (hI' : I ≠ ⊤) :
    ¬ IsOpenImmersion (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) := by
  intro hf
  have : Nontrivial (R ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr hI'
  let z : PrimeSpectrum (R ⧸ I) := Classical.choice inferInstance
  let x : PrimeSpectrum R := ⟨⊥, inferInstance⟩
  let f := Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))
  have hspec : x ⤳ f z := (PrimeSpectrum.le_iff_specializes _ _).mp bot_le
  obtain ⟨y, hy⟩ := hspec.mem_open f.isOpenEmbedding.isOpen_range ⟨z, rfl⟩
  refine hI (eq_bot_iff.mpr fun r hr => ?_)
  have hr' : r ∈ (f y).asIdeal := by
    change Ideal.Quotient.mk I r ∈ y.asIdeal
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr hr]
    exact y.asIdeal.zero_mem
  simpa only [hy] using hr'

/-- This immersion cannot factor as an open immersion followed by a closed immersion. -/
@[stacks 01QW "failure of open-then-closed factorization"]
public theorem counterexampleImmersion_no_open_closed_factorization
    (k : Type u) [Field k] :
    ¬ ∃ (T : Scheme.{u})
        (g : (nonextendableIdealSheaf k).1.subscheme ⟶ T)
        (h : T ⟶ ambientSpectrum k),
        IsOpenImmersion g ∧ IsClosedImmersion h ∧
          g ≫ h = counterexampleImmersion k := by
  rintro ⟨T, g, h, hg, hh, hcomp⟩
  have hker : h.ker = ⊥ := by
    apply idealSheaf_eq_bot_of_le_chart_ker k
    intro n
    obtain ⟨d, -, hdf⟩ := exists_chart_lift k n
    rw [← hdf, ← hcomp, ← Category.assoc]
    exact Scheme.Hom.le_ker_comp (d ≫ g) h
  have : IsIso h := IsClosedImmersion.isIso_iff_ker_eq_bot.mpr hker
  obtain ⟨d, hd, hdf⟩ := exists_chart_lift k 0
  have : IsOpenImmersion (chartQuotientMap k 0) := by
    rw [← hdf, ← hcomp]
    infer_instance
  exact not_isOpenImmersion_spec_quotient (chartIdeal k 0)
    (chartIdeal_ne_bot k 0) (chartIdeal_ne_top k 0) this

end Stacks.Immersion.NotOpenThenClosed

end
