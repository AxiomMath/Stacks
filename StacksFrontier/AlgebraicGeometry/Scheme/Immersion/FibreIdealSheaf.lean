module

public import Mathlib.AlgebraicGeometry.Fiber
public import Mathlib.RingTheory.LocalRing.ResidueField.Ideal
public import StacksFrontier.AlgebraicGeometry.Divisors.IdealSheafGlobalSectionGenerators
public import StacksFrontier.AlgebraicGeometry.Perfect.SupportClosedSubset.EquationsBaseChange
public import StacksFrontier.RingTheory.LocalCohomology.UniformCohomologyBound

/-!
# The ideal sheaf of a fibre over a point of an affine base

Let `f : X ⟶ Spec R` be a morphism of schemes and let `x ∈ Spec R` be a point whose singleton
is closed, so that the fibre `f.fiber x` is a closed subscheme of `X`.  Its sheaf of ideals is
the inverse image of the prime `x`:  on every affine open `U` of `X` it is the extension
`p · Γ(X, U)` of the prime `p ⊆ R` corresponding to `x`.

This is the ideal assertion of [Stacks, Tag 01JU] part (1), read through
`AlgebraicGeometry.Scheme.IdealSheafData`.  The general tag is already registered, on
`Stacks.ClosedImmersion.existsUnique_idealSheaf_pullbackSnd_iso_pullbackIdeal`; what is proved
here is the affine-base case in the `IdealSheafData` presentation, which is the form in which
the ideal can be read off on charts and compared with an ideal of `R`.

Specialising to the closed point of the spectrum of a local ring `A` gives `𝓘 = 𝔪 𝒪_X`, the
identification the proof of [Stacks, Tag 0B4Y] opens with; combined with
`Stacks.Divisors.nonempty_generatingSections_ofIdealTop` it shows that the ideal sheaf of the
special fibre is generated by global sections.

## Main results

* `Stacks.IdealSheaf.ker_appTop_specMap`: the kernel of `Γ(Spec R, 𝒪) ⟶ Γ(Spec S, 𝒪)` is the
  image of the kernel of `R ⟶ S`.
* `Stacks.IdealSheaf.ker_fromSpecResidueField_spec`: the kernel of `Spec κ(x) ⟶ Spec R` is
  the ideal sheaf generated by the prime of `x`.
* `Stacks.IdealSheaf.ker_fiberι`: **the ideal sheaf of the fibre of `f : X ⟶ Spec R` over a
  closed point `x`** is the one generated by the image of the prime of `x` in `Γ(X, 𝒪_X)`.
* `Stacks.IdealSheaf.ker_fiberι_closedPoint`: over a local ring `A`, the ideal sheaf of the
  fibre over the closed point is `𝔪 𝒪_X`, i.e.
  `Stacks.Cohomology.FormalFunctions.baseIdealSheaf A (IsLocalRing.maximalIdeal A) f`.
* `Stacks.IdealSheaf.nonempty_generatingSections_ker_fiberι_closedPoint`: **the ideal sheaf of
  the fibre over the closed point of a local affine base is generated by global sections.**

## Implementation notes

`AlgebraicGeometry.Scheme.Hom.fiberι` is by definition the first projection of the pullback of
`f` along `AlgebraicGeometry.Scheme.fromSpecResidueField`, so
`AlgebraicGeometry.Scheme.IdealSheafData.ker_fst_of_isClosedImmersion` turns its kernel into the
inverse image of the kernel of `Spec κ(x) ⟶ Spec R`; that morphism is a closed immersion exactly
because `{x}` is closed (`AlgebraicGeometry.isClosed_singleton_iff_isClosedImmersion`).  The
inverse image is computed by `Stacks.IdealSheaf.comap_ofIdealTop`, and the kernel of
`Spec κ(x) ⟶ Spec R` is identified using
`AlgebraicGeometry.Scheme.Spec.map_residueFieldIso_inv_eq_fromSpecResidueField`, which factors
it through `Spec` of the structure map `R ⟶ κ(x)`, whose kernel is `x` by
`Ideal.ker_algebraMap_residueField`.

The same kernel is described in radical form by `AlgebraicGeometry.ker_fromSpecResidueField`,
as the vanishing ideal of the closed point; `Stacks.IdealSheaf.ker_fromSpecResidueField_spec`
gives instead the `AlgebraicGeometry.Scheme.IdealSheafData.ofIdealTop` presentation, which is
the one `Stacks.IdealSheaf.comap_ofIdealTop` consumes.

## References

* [Stacks Project, Tag 01JU](https://stacks.math.columbia.edu/tag/01JU)
* [Stacks Project, Tag 0B4Y](https://stacks.math.columbia.edu/tag/0B4Y)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace Stacks.IdealSheaf

/-- **The kernel of the map of global sections of a morphism of affine schemes.**  It is the
image of the kernel of the ring map under the identification `R ≅ Γ(Spec R, 𝒪)`. -/
theorem ker_appTop_specMap {R S : CommRingCat.{u}} (φ : R ⟶ S) :
    RingHom.ker ((Spec.map φ).appTop).hom =
      Ideal.map (Scheme.ΓSpecIso R).inv.hom (RingHom.ker φ.hom) := by
  have hinj : Function.Injective (Scheme.ΓSpecIso S).inv.hom :=
    (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso S).inv).1
  have hsurj : Function.Surjective (Scheme.ΓSpecIso R).inv.hom :=
    (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso R).inv).2
  have h1 : RingHom.ker φ.hom =
      Ideal.comap (Scheme.ΓSpecIso R).inv.hom
        (RingHom.ker ((Spec.map φ).appTop).hom) := by
    rw [RingHom.comap_ker, ← CommRingCat.hom_comp, ← Scheme.ΓSpecIso_inv_naturality,
      CommRingCat.hom_comp]
    refine Ideal.ext fun a => ?_
    simp only [RingHom.mem_ker, RingHom.coe_comp, Function.comp_apply]
    exact ⟨fun h => by rw [h, map_zero], fun h => hinj (h.trans (map_zero _).symm)⟩
  rw [h1, Ideal.map_comap_of_surjective _ hsurj]

/-- **The ideal sheaf cut out by `Spec κ(x) ⟶ Spec R`** is the one generated by the prime ideal
of `x`, read inside `Γ(Spec R, 𝒪)`. -/
theorem ker_fromSpecResidueField_spec (R : CommRingCat.{u}) (x : Spec R) :
    ((Spec R).fromSpecResidueField x).ker =
      Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso R).inv.hom x.asIdeal) := by
  rw [← Scheme.Spec.map_residueFieldIso_inv_eq_fromSpecResidueField,
    Scheme.Hom.ker_comp_of_isIso, Scheme.ker_of_isAffine, ker_appTop_specMap]
  have : (x.asIdeal).IsPrime := (x : PrimeSpectrum ↑R).isPrime
  congr 2
  exact Ideal.ker_algebraMap_residueField x.asIdeal

/-- **The ideal sheaf of the fibre of `f : X ⟶ Spec R` over a closed point `x`.**  It is the
quasi-coherent sheaf of ideals generated by the image in `Γ(X, 𝒪_X)` of the prime ideal of `x`;
affine-locally on `X` it is the extension of that prime.  This is the ideal assertion of
[Stacks, Tag 01JU] part (1) over an affine base, in the `IdealSheafData` presentation. -/
theorem ker_fiberι {R : CommRingCat.{u}} {X : Scheme.{u}} (f : X ⟶ Spec R) (x : Spec R)
    (hx : IsClosed ({x} : Set (Spec R))) :
    (f.fiberι x).ker =
      Scheme.IdealSheafData.ofIdealTop
        (Ideal.map ((Scheme.ΓSpecIso R).inv ≫ f.appTop).hom x.asIdeal) := by
  have : IsClosedImmersion ((Spec R).fromSpecResidueField x) :=
    isClosed_singleton_iff_isClosedImmersion.1 hx
  show (pullback.fst f ((Spec R).fromSpecResidueField x)).ker = _
  rw [Scheme.IdealSheafData.ker_fst_of_isClosedImmersion, ker_fromSpecResidueField_spec,
    comap_ofIdealTop, Ideal.map_map, CommRingCat.hom_comp]

/-- **In the situation of [Stacks, Tag 0B4Y], `𝓘 = 𝔪 𝒪_X`.**  For `f : X ⟶ Spec A` with `A`
local, the ideal sheaf of the fibre over the closed point is the extension `𝔪 𝒪_X` of the
maximal ideal. -/
theorem ker_fiberι_closedPoint {A : Type u} [CommRing A] [IsLocalRing A] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of A)) :
    (f.fiberι (IsLocalRing.closedPoint A)).ker =
      Stacks.Cohomology.FormalFunctions.baseIdealSheaf A (IsLocalRing.maximalIdeal A) f :=
  ker_fiberι f (IsLocalRing.closedPoint A) (IsLocalRing.isClosed_singleton_closedPoint A)

/-- **The ideal sheaf of the fibre over the closed point of a local affine base is generated by
global sections.**  It is `𝔪 𝒪_X` by `Stacks.IdealSheaf.ker_fiberι_closedPoint`, hence generated
by the global functions it contains, by
`Stacks.Divisors.nonempty_generatingSections_ofIdealTop`.  This is the global generation of `𝓘`
that the proof of [Stacks, Tag 0B4Y] uses. -/
theorem nonempty_generatingSections_ker_fiberι_closedPoint {A : Type u} [CommRing A]
    [IsLocalRing A] {X : Scheme.{u}} (f : X ⟶ Spec (.of A)) :
    Nonempty (Stacks.Divisors.idealSheafOfModules
      (f.fiberι (IsLocalRing.closedPoint A)).ker).GeneratingSections := by
  rw [ker_fiberι_closedPoint]
  exact Stacks.Divisors.nonempty_generatingSections_ofIdealTop _

end Stacks.IdealSheaf

end
