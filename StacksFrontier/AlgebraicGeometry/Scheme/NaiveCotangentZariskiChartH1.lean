module

public import StacksFrontier.AlgebraicGeometry.Scheme.NaiveCotangentAffineIso
public import StacksFrontier.AlgebraicGeometry.Scheme.NaiveCotangentAffineStalk
public import StacksFrontier.AlgebraicGeometry.Scheme.NaiveCotangentToposModel
public import StacksFrontier.AlgebraicGeometry.Spaces.NaiveCotangentChartStalk
public import StacksFrontier.CategoryTheory.Sites.Point.NaiveCotangentH1Tensor
public import StacksFrontier.CategoryTheory.Sites.Point.OpensPointFiberStalk
public import StacksFrontier.Cotangent.SheavesOfRings.AffineCotangentComparison
public import StacksFrontier.RingTheory.Henselian.StrictHenselization.QuasiFinite

/-!
# `H₁` of an affine chart of a morphism of schemes, spread over the Zariski site

Let `f : X ⟶ Y` be a morphism of schemes, let `W = Spec R ⊆ Y` and `Z = Spec A ⊆ X` be affine
opens with `f(Z) ⊆ W`, and write `H = H₁(L_{A/R})`.  On the Zariski site of `X` localized at
`Z`, with `f⁻¹𝒪_Y` the inverse image of sheaves of commutative rings along the morphism of
Zariski topoi of `f` and `f^♯ : f⁻¹𝒪_Y ⟶ 𝒪_X` its structure map, the squares

```
R ──▸ (f⁻¹𝒪_Y)(U)
│          │
▼          ▼
A ──▸   𝒪_X(U)
```

for opens `U ⊆ Z` give maps `τ_U : 𝒪_X(U) ⊗_A H ⟶ H₁(L_{𝒪_X(U)/(f⁻¹𝒪_Y)(U)})`.  This file
proves that `τ` is *locally surjective*: every class of `H₁(L_{𝒪_X(U)/(f⁻¹𝒪_Y)(U)})` lies, on an
open covering of `U`, in the image of `τ`.  At a point `x ∈ U` the stalks of `𝒪_X` and of
`f⁻¹𝒪_Y` are the localizations `A_𝔭` and `R_𝔮`, which are filtered colimits of étale algebras,
so this is `Stacks.NaiveCotangent.H1Tensor.exists_h1Tensor_eq_h1Restrict` (Stacks 0D08 at the
point).

This is the Zariski half of the comparison of Stacks 0D0X on charts: the degree `-1`
cohomology sheaf of `NL_{X/Y}` on the Zariski site is locally generated by the classes coming
from `H₁(L_{A/R})`.

## Main definitions

* `Stacks.NaiveCotangentZariskiChart.baseMap`: the ring maps `R ⟶ (f⁻¹𝒪_Y)(U)`, built from the
  unit of the inverse image of sheaves of commutative rings
  (`AlgebraicGeometry.Scheme.Hom.inverseImageSections`).
* `Stacks.NaiveCotangentZariskiChart.point`: the point of the localized Zariski site at `x ∈ Z`.

## Main results

* `Stacks.NaiveCotangentZariskiChart.inverseImageSheafIso_inverseImageSections`: the canonical
  sections of the topos inverse image and of the inverse image on spaces correspond.
* `Stacks.NaiveCotangentZariskiChart.structureStalk_ind_etale` and
  `Stacks.NaiveCotangentZariskiChart.baseStalk_ind_etale`: the stalks are `A_𝔭` and `R_𝔮`,
  ind-étale over `A` and `R`.
* `Stacks.NaiveCotangentZariskiChart.liftSieve_mem`: local surjectivity of `τ`.

## References

* [Stacks Project, Tag 0D0X](https://stacks.math.columbia.edu/tag/0D0X)
* [Stacks Project, Tag 0D08](https://stacks.math.columbia.edu/tag/0D08)
* [Stacks Project, Tag 0D0I](https://stacks.math.columbia.edu/tag/0D0I)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.GrothendieckTopology Opposite Algebra
  TensorProduct AlgebraicGeometry TopologicalSpace Stacks.Sheaves.ToposPushforward
  Stacks.Sheaves.ToposPullback

universe u

namespace Stacks.NaiveCotangentZariskiChart

variable {X Y : Scheme.{u}} (f : X ⟶ Y) {W : Y.Opens} {Z : X.Opens} (hZW : Z ≤ f ⁻¹ᵁ W)

/-- `f⁻¹𝒪_Y`, restricted to the Zariski site of `X` localized at `Z`. -/
abbrev baseRestrict : (Over Z)ᵒᵖ ⥤ CommRingCat.{u} :=
  (Over.forget Z).op ⋙ (Scheme.Hom.zariskiInverseImageStructureSheaf f).obj

/-- `𝒪_X`, restricted to the Zariski site of `X` localized at `Z`. -/
abbrev structureRestrict : (Over Z)ᵒᵖ ⥤ CommRingCat.{u} :=
  (Over.forget Z).op ⋙ X.sheaf.obj

/-- The structure map `f^♯ : f⁻¹𝒪_Y ⟶ 𝒪_X`, restricted to the localized site. -/
abbrev sharpRestrict : baseRestrict f (Z := Z) ⟶ structureRestrict (Z := Z) :=
  Functor.whiskerLeft (Over.forget Z).op
    (RingedToposHom.fSharpInverseImage f.zariskiRingedToposHom).hom

/-- `A = Γ(X, Z)` as an algebra over `R = Γ(Y, W)` through `f`. -/
abbrev chartAlgebra : Algebra Γ(Y, W) Γ(X, Z) := (f.appLE W Z hZW).hom.toAlgebra

/-- The ring maps `R ⟶ (f⁻¹𝒪_Y)(U)` for `U ⊆ Z`. -/
abbrev baseMap (U : Over Z) : Γ(Y, W) →+* ToType ((baseRestrict f).obj (op U)) :=
  ((Scheme.Hom.zariskiInverseImageStructureSheaf f).obj.map U.hom.op).hom.comp
    (Scheme.Hom.inverseImageSections f hZW).hom

/-- The restriction maps `A ⟶ 𝒪_X(U)` for `U ⊆ Z`. -/
abbrev structureMap (U : Over Z) : Γ(X, Z) →+* ToType ((structureRestrict (Z := Z)).obj (op U)) :=
  (X.sheaf.obj.map U.hom.op).hom

/-- Restricting a section over `Z` along `U ⟶ Z` and then along `V ⟶ U` restricts it along
`V ⟶ Z`. -/
private theorem map_map_over_hom {F : (Opens X)ᵒᵖ ⥤ CommRingCat.{u}} {U V : Over Z} (g : V ⟶ U)
    (a : F.obj (op Z)) : F.map g.left.op (F.map U.hom.op a) = F.map V.hom.op a := by
  rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp]
  exact congrArg (fun k : V.left ⟶ Z => F.map k.op a) (Subsingleton.elim _ _)

/-- The maps `baseMap` are compatible with the restriction maps of `f⁻¹𝒪_Y` along `V ⟶ U`. -/
theorem baseMap_restrict {U V : Over Z} (g : V ⟶ U) (r : Γ(Y, W)) :
    (baseRestrict f).map g.op (baseMap f hZW U r) = baseMap f hZW V r :=
  map_map_over_hom (F := (Scheme.Hom.zariskiInverseImageStructureSheaf f).obj) g _

/-- The maps `structureMap` are compatible with the restriction maps of `𝒪_X` along `V ⟶ U`. -/
theorem structureMap_restrict {U V : Over Z} (g : V ⟶ U) (a : Γ(X, Z)) :
    (structureRestrict (Z := Z)).map g.op (structureMap U a) = structureMap V a :=
  map_map_over_hom g _

/-- The square from `R` to `𝒪_X(U)` commutes: the image of `r ∈ R` in `𝒪_X(U)` through `A` is
`f^♯` applied to its image in `(f⁻¹𝒪_Y)(U)`. -/
theorem chartSquare (U : Over Z) (r : Γ(Y, W)) :
    structureMap U (@algebraMap _ _ _ _ (chartAlgebra f hZW) r) =
      (sharpRestrict f).app (op U) (baseMap f hZW U r) := by
  refine (congrArg (fun t => X.sheaf.obj.map U.hom.op t)
    (ConcreteCategory.congr_hom (Scheme.Hom.inverseImageSections_comp f hZW) r).symm).trans ?_
  exact (NatTrans.naturality_apply
    (RingedToposHom.fSharpInverseImage f.zariskiRingedToposHom).hom U.hom.op _).symm


/-! ### The canonical sections of the two inverse images -/

/-- **The unit of the inverse image of sheaves of commutative rings along the morphism of Zariski
topoi of `f` is the unit of the inverse image of sheaves on spaces**, under the identification
`AlgebraicGeometry.Scheme.Hom.inverseImageSheafIso` of the two inverse images of `𝒪_Y`. -/
theorem inverseImageUnit_comp_inverseImageSheafIso :
    Scheme.Hom.inverseImageUnit f ≫
        (Scheme.Hom.zariskiRestriction f).map (Scheme.Hom.inverseImageSheafIso f).hom =
      (TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{u} f.base).unit.app Y.sheaf := by
  have h1 := Adjunction.unit_leftAdjointUniq_hom_app
    (commRingImageAdjunction f.zariskiRingedToposHom.toToposHom)
    (Scheme.Hom.inverseImageSheafAdjunction f) Y.sheaf
  have h2 : (Scheme.Hom.inverseImageSheafAdjunction f).unit.app Y.sheaf =
      (TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{u} f.base).unit.app Y.sheaf ≫
        (Scheme.Hom.zariskiPushforwardCommRingIso f).inv.app _ := by
    have e := Adjunction.homEquiv_ofNatIsoRight_apply
      (TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{u} f.base)
      (Scheme.Hom.zariskiPushforwardCommRingIso f).symm
      (𝟙 ((TopCat.Sheaf.pullback CommRingCat.{u} f.base).obj Y.sheaf))
    exact ((Scheme.Hom.inverseImageSheafAdjunction f).homEquiv_id Y.sheaf).symm.trans
      (e.trans (congrArg (· ≫ (Scheme.Hom.zariskiPushforwardCommRingIso f).inv.app _)
        ((TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{u} f.base).homEquiv_id
          Y.sheaf)))
  have h3 := restrictionCommRingIso_naturality (Opens.grothendieckTopology ↥Y)
    (Opens.grothendieckTopology ↥X) (Opens.map f.base) (Scheme.Hom.inverseImageSheafIso f).hom
  refine (Category.assoc _ _ _).trans ?_
  refine (congrArg (fun k =>
    (commRingImageAdjunction f.zariskiRingedToposHom.toToposHom).unit.app
      Y.zariskiRingedTopos.O ≫ k) h3.symm).trans ?_
  refine (Category.assoc _ _ _).symm.trans ?_
  refine (congrArg (fun k => k ≫ (restrictionCommRingIso (Opens.grothendieckTopology ↥Y)
    (Opens.grothendieckTopology ↥X) (Opens.map f.base)
    (Stacks.Sheaves.RingedSpaceDifferentials.inverseImageSheaf f.toLRSHom.toShHom)).hom)
    h1).trans ?_
  refine (congrArg (fun k => k ≫ (restrictionCommRingIso (Opens.grothendieckTopology ↥Y)
    (Opens.grothendieckTopology ↥X) (Opens.map f.base)
    (Stacks.Sheaves.RingedSpaceDifferentials.inverseImageSheaf f.toLRSHom.toShHom)).hom)
    h2).trans ?_
  refine (Category.assoc _ _ _).trans ?_
  exact (congrArg (fun k => _ ≫ k)
    ((Scheme.Hom.zariskiPushforwardCommRingIso f).app _).inv_hom_id).trans (Category.comp_id _)


/-- **On sections, the identification of the two inverse images carries the canonical section
of `f⁻¹𝒪_Y` attached to `r ∈ Γ(Y, W)` to the canonical section of the inverse image on
spaces**, `Stacks.NaiveCotangentAffineComparison.baseSectionHom`. -/
theorem inverseImageSheafIso_inverseImageSections {U : X.Opens} (e : U ≤ f ⁻¹ᵁ W)
    (r : Γ(Y, W)) :
    (Scheme.Hom.inverseImageSheafIso f).hom.hom.app (op U)
        ((Scheme.Hom.inverseImageSections f e) r) =
      NaiveCotangentAffineComparison.baseSectionHom f e r := by
  have key := congrArg (fun k => (k.hom.app (op W)).hom r)
    (inverseImageUnit_comp_inverseImageSheafIso f)
  change (Scheme.Hom.inverseImageSheafIso f).hom.hom.app (op U)
      ((Scheme.Hom.zariskiInverseImageStructureSheaf f).obj.map (homOfLE e).op
        ((Scheme.Hom.inverseImageUnit f).hom.app (op W) r)) =
    ((TopCat.Sheaf.pullback CommRingCat.{u} f.base).obj Y.sheaf).obj.map (homOfLE e).op
      (((TopCat.Sheaf.pullbackPushforwardAdjunction CommRingCat.{u} f.base).unit.app
        Y.sheaf).hom.app (op W) r)
  refine (NatTrans.naturality_apply (Scheme.Hom.inverseImageSheafIso f).hom.hom
    (homOfLE e).op _).trans ?_
  exact congrArg (fun t => ((TopCat.Sheaf.pullback CommRingCat.{u} f.base).obj Y.sheaf).obj.map
    (homOfLE e).op t) key

/-! ### The point at `x ∈ Z` -/

variable {x : X} (hx : x ∈ Z)

/-- **The point of the Zariski site of `X` localized at `Z`** attached to `x ∈ Z`. -/
abbrev point : Point.{u} ((Opens.grothendieckTopology X).over Z) :=
  (Opens.pointGrothendieckTopology x).over ⟨⟨hx⟩⟩

/-- The lift of the point to the final object `Z` of the localized site. -/
abbrev pointTop : (point hx).fiber.obj (Over.mk (𝟙 Z)) :=
  ⟨⟨⟨hx⟩⟩, (FunctorToTypes.mem_fromOverSubfunctor_iff _ _ _).2
    (Subsingleton.elim (α := (Opens.pointGrothendieckTopology x).fiber.obj Z) _ _)⟩

/-- The germ `R ⟶ (f⁻¹𝒪_Y)_x`. -/
abbrev baseGerm : Γ(Y, W) →+*
    ToType (((point hx).presheafFiber (A := CommRingCat.{u})).obj (baseRestrict f)) :=
  ((point hx).toPresheafFiber (Over.mk (𝟙 Z)) (pointTop hx) (baseRestrict f)).hom.comp
    (baseMap f hZW (Over.mk (𝟙 Z)))

/-- The germ `A ⟶ 𝒪_{X,x}`. -/
abbrev structureGerm : Γ(X, Z) →+*
    ToType (((point hx).presheafFiber (A := CommRingCat.{u})).obj (structureRestrict (Z := Z))) :=
  ((point hx).toPresheafFiber (Over.mk (𝟙 Z)) (pointTop hx) (structureRestrict (Z := Z))).hom.comp
    (structureMap (Over.mk (𝟙 Z)))

/-- Every element of the fiber of `point hx` at `U` maps to `pointTop hx` along `U ⟶ Z`. -/
theorem point_fiber_map_eq {U : Over Z} (y : (point hx).fiber.obj U) :
    (point hx).fiber.map (Over.homMk U.hom : U ⟶ Over.mk (𝟙 Z)) y = pointTop hx :=
  Subtype.ext (Subsingleton.elim (α := (Opens.pointGrothendieckTopology x).fiber.obj Z) _ _)

/-- The germ at the point of the section `baseMap f hZW U r` of `f⁻¹𝒪_Y` is
`baseGerm f hZW hx r`. -/
theorem baseGerm_eq (U : Over Z) (y : (point hx).fiber.obj U) (r : Γ(Y, W)) :
    (point hx).toPresheafFiber U y (baseRestrict f) (baseMap f hZW U r) = baseGerm f hZW hx r := by
  rw [← baseMap_restrict f hZW (Over.homMk U.hom : U ⟶ Over.mk (𝟙 Z)),
    Point.toPresheafFiber_w_apply, point_fiber_map_eq]
  rfl

/-- The germ at the point of the section `structureMap U a` of `𝒪_X` is `structureGerm hx a`. -/
theorem structureGerm_eq (U : Over Z) (y : (point hx).fiber.obj U) (a : Γ(X, Z)) :
    (point hx).toPresheafFiber U y (structureRestrict (Z := Z)) (structureMap U a) =
      structureGerm hx a := by
  rw [← structureMap_restrict (Over.homMk U.hom : U ⟶ Over.mk (𝟙 Z)),
    Point.toPresheafFiber_w_apply, point_fiber_map_eq]
  rfl


/-- The comparison of the stalk of `𝒪_X` on the localized site with the stalk at `x`. -/
def structureStalkIso :
    ((point hx).presheafFiber (A := CommRingCat.{u})).obj (structureRestrict (Z := Z)) ≅
      X.presheaf.stalk x :=
  (Point.presheafFiberOverIso (Opens.pointGrothendieckTopology x) ⟨⟨hx⟩⟩ CommRingCat.{u}).app
      X.sheaf.obj ≪≫ Opens.pointFiberStalkIso x X.presheaf

/-- The comparison of the fibre at `point hx` with the stalk at `x` carries the canonical map out
of the sections over `Z` to the germ map. -/
private theorem pointFiberStalkIso_presheafFiberOverIso_toPresheafFiber
    (F : TopCat.Presheaf CommRingCat.{u} X) (s : F.obj (op Z)) :
    (Opens.pointFiberStalkIso x F).hom
      ((Point.presheafFiberOverIso (Opens.pointGrothendieckTopology x) ⟨⟨hx⟩⟩
        CommRingCat.{u}).hom.app F
        ((point hx).toPresheafFiber (Over.mk (𝟙 Z)) (pointTop hx) ((Over.forget Z).op ⋙ F)
          (F.map (𝟙 Z).op s))) = F.germ Z x hx s := by
  have h1 := ConcreteCategory.congr_hom (Point.toPresheafFiber_presheafFiberOverIso_hom
    (Opens.pointGrothendieckTopology x) ⟨⟨hx⟩⟩ CommRingCat.{u} F (Over.mk (𝟙 Z))
    (pointTop hx)) (F.map (𝟙 Z).op s)
  have h2 := ConcreteCategory.congr_hom (Opens.toPresheafFiber_pointFiberStalkHom x F Z
    ⟨⟨hx⟩⟩) (F.map (𝟙 Z).op s)
  rw [op_id, CategoryTheory.Functor.map_id] at h1 h2 ⊢
  exact (congrArg (Opens.pointFiberStalkHom x F) h1).trans h2

/-- `structureStalkIso hx` carries `structureGerm hx a` to the germ of `a` at `x`. -/
theorem structureStalkIso_structureGerm (a : Γ(X, Z)) :
    (structureStalkIso hx).hom (structureGerm hx a) = X.presheaf.germ Z x hx a :=
  pointFiberStalkIso_presheafFiberOverIso_toPresheafFiber hx X.sheaf.obj a

/-- **The stalk of `𝒪_X` is ind-étale over `A`**: it is the localization `A_𝔭`. -/
theorem structureStalk_ind_etale (hZ : IsAffineOpen Z) :
    letI := (structureGerm hx).toAlgebra
    (CommAlgCat.etale.{u} Γ(X, Z)).ind.{u}
      (CommAlgCat.of Γ(X, Z) (ToType (((point hx).presheafFiber (A := CommRingCat.{u})).obj
        (structureRestrict (Z := Z))))) := by
  let := X.presheaf.algebra_section_stalk (⟨x, hx⟩ : Z)
  have := NaiveCotangentAffineStalk.isLocalization_stalk hx hZ
  refine AlgebraicGeometry.Space.ind_etale_of_ringEquiv (X.presheaf.germ Z x hx).hom
    (structureGerm hx) (structureStalkIso hx).symm.commRingCatIsoToRingEquiv (fun a => ?_)
    (CommAlgCat.ind_etale_atPrime _ _ (hZ.primeIdealOf ⟨x, hx⟩).asIdeal)
  change (structureStalkIso hx).inv (X.presheaf.germ Z x hx a) = structureGerm hx a
  rw [← structureStalkIso_structureGerm]
  exact ConcreteCategory.congr_hom (structureStalkIso hx).hom_inv_id _

/-- The comparison of the stalk of `f⁻¹𝒪_Y` on the localized site with the stalk at `x` of the
inverse image on spaces. -/
def baseStalkIso :
    ((point hx).presheafFiber (A := CommRingCat.{u})).obj (baseRestrict f) ≅
      ((TopCat.Sheaf.pullback CommRingCat.{u} f.base).obj Y.sheaf).presheaf.stalk x :=
  (Point.presheafFiberOverIso (Opens.pointGrothendieckTopology x) ⟨⟨hx⟩⟩ CommRingCat.{u}).app
      (Scheme.Hom.zariskiInverseImageStructureSheaf f).obj ≪≫
    Opens.pointFiberStalkIso x (Scheme.Hom.zariskiInverseImageStructureSheaf f).obj ≪≫
    (TopCat.Presheaf.stalkFunctor CommRingCat.{u} x).mapIso
      ((sheafToPresheaf _ _).mapIso (Scheme.Hom.inverseImageSheafIso f))

/-- `baseStalkIso f hx` carries `baseGerm f hZW hx r` to the image of the germ of `r` at `f x`
under the inverse of `SheafifyStalk.stalkInverseImageStructureSheafIso f x`. -/
theorem baseStalkIso_baseGerm (r : Γ(Y, W)) :
    (baseStalkIso f hx).hom (baseGerm f hZW hx r) =
      (SheafifyStalk.stalkInverseImageStructureSheafIso f x).inv
        (Y.presheaf.germ W (f x) (hZW hx) r) := by
  refine (congrArg ((TopCat.Presheaf.stalkFunctor CommRingCat.{u} x).mapIso
    ((sheafToPresheaf _ _).mapIso (Scheme.Hom.inverseImageSheafIso f))).hom
    (pointFiberStalkIso_presheafFiberOverIso_toPresheafFiber hx
      (Scheme.Hom.zariskiInverseImageStructureSheaf f).obj
      (Scheme.Hom.inverseImageSections f hZW r))).trans ?_
  refine (TopCat.Presheaf.stalkFunctor_map_germ_apply Z x hx _ _).trans ?_
  refine Eq.trans ?_ (NaiveCotangentAffineIso.germ_baseSectionHom f hZW hx (hZW hx) r)
  exact congrArg _ (inverseImageSheafIso_inverseImageSections f hZW r)

include hZW in
/-- **The stalk of `f⁻¹𝒪_Y` is ind-étale over `R`**: it is the localization `R_𝔮`. -/
theorem baseStalk_ind_etale (hW : IsAffineOpen W) :
    letI := (baseGerm f hZW hx).toAlgebra
    (CommAlgCat.etale.{u} Γ(Y, W)).ind.{u}
      (CommAlgCat.of Γ(Y, W) (ToType (((point hx).presheafFiber (A := CommRingCat.{u})).obj
        (baseRestrict f)))) := by
  let := NaiveCotangentAffineStalk.algebraStalkInverseImage f (hZW hx)
  have := NaiveCotangentAffineStalk.isLocalization_stalkInverseImage f (hZW hx) hW
  refine AlgebraicGeometry.Space.ind_etale_of_ringEquiv
    (algebraMap Γ(Y, W)
      ↑(((TopCat.Sheaf.pullback CommRingCat.{u} f.base).obj Y.sheaf).presheaf.stalk x))
    (baseGerm f hZW hx) (baseStalkIso f hx).symm.commRingCatIsoToRingEquiv (fun r => ?_)
    (CommAlgCat.ind_etale_atPrime _ _ (hW.primeIdealOf ⟨f x, hZW hx⟩).asIdeal)
  change (baseStalkIso f hx).inv ((SheafifyStalk.stalkInverseImageStructureSheafIso f x).inv
    (Y.presheaf.germ W (f x) (hZW hx) r)) = baseGerm f hZW hx r
  rw [← baseStalkIso_baseGerm]
  exact ConcreteCategory.congr_hom (baseStalkIso f hx).hom_inv_id _


/-! ### Local surjectivity of `τ` -/

include hZW in
/-- **Local surjectivity of `τ` on the Zariski site**: on the Zariski site of `X` localized at
an affine open `Z` mapping into an affine open `W` of `Y`, every class of
`H₁(L_{𝒪_X(U)/(f⁻¹𝒪_Y)(U)})` lies, on an open covering of `U`, in the image of
`τ_U : 𝒪_X(U) ⊗_A H₁(L_{A/R}) ⟶ H₁(L_{𝒪_X(U)/(f⁻¹𝒪_Y)(U)})`. -/
theorem liftSieve_mem (hW : IsAffineOpen W) (hZ : IsAffineOpen Z) (U : Over Z)
    (z : NaiveCotangent.H1Tensor.H1X (baseRestrict f) (structureRestrict (Z := Z))
      (sharpRestrict f) U) :
    letI := chartAlgebra f hZW
    NaiveCotangent.H1Tensor.liftSieve (baseRestrict f) (structureRestrict (Z := Z))
        (sharpRestrict f) Γ(Y, W) Γ(X, Z) (baseMap f hZW) (baseMap_restrict f hZW)
        structureMap structureMap_restrict (chartSquare f hZW) U z ∈
      (Opens.grothendieckTopology X).over Z U := by
  let := chartAlgebra f hZW
  rw [GrothendieckTopology.mem_over_iff]
  intro x hxU
  have hx : x ∈ Z := leOfHom U.hom hxU
  let y : (point hx).fiber.obj U :=
    ⟨⟨⟨hxU⟩⟩, (FunctorToTypes.mem_fromOverSubfunctor_iff _ _ _).2
      (Subsingleton.elim (α := (Opens.pointGrothendieckTopology x).fiber.obj Z) _ _)⟩
  obtain ⟨Y₂, g, y₂, -, t, ht⟩ := NaiveCotangent.H1Tensor.exists_h1Tensor_eq_h1Restrict
    (baseRestrict f) (structureRestrict (Z := Z)) (sharpRestrict f) Γ(Y, W) Γ(X, Z)
    (baseMap f hZW) (baseMap_restrict f hZW) structureMap structureMap_restrict
    (chartSquare f hZW) (point hx) (baseGerm f hZW hx) (baseGerm_eq f hZW hx)
    (structureGerm hx) (structureGerm_eq hx) U y z (baseStalk_ind_etale f hZW hx hW)
    (structureStalk_ind_etale hx hZ)
  refine ⟨Y₂.left, g.left, ?_, y₂.1.down.down⟩
  rw [Sieve.overEquiv_iff]
  have e : (Over.homMk g.left : Over.mk (g.left ≫ U.hom) ⟶ U) =
      (Over.homMk (𝟙 _) (Subsingleton.elim _ _) : Over.mk (g.left ≫ U.hom) ⟶ Y₂) ≫ g := by
    ext
    simp
  rw [e]
  have hg : NaiveCotangent.H1Tensor.liftSieve (baseRestrict f) (structureRestrict (Z := Z))
      (sharpRestrict f) Γ(Y, W) Γ(X, Z) (baseMap f hZW) (baseMap_restrict f hZW)
      structureMap structureMap_restrict (chartSquare f hZW) U z g := ⟨t, ht⟩
  exact Sieve.downward_closed _ hg _

end Stacks.NaiveCotangentZariskiChart

