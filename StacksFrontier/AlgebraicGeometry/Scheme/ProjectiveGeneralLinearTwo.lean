module

public import Mathlib.AlgebraicGeometry.Over
public import Mathlib.RingTheory.Adjoin.FG
import Mathlib.RingTheory.Localization.Away.Lemmas
public import StacksFrontier.AlgebraicGeometry.Scheme.Separation.GeneralLinearGroup

/-!
# The projective general linear scheme `PGL₂`

Let `k` be a commutative ring and `k[a, b, c, d, 1/Δ]` the coordinate ring of `GL₂`, where
`Δ = a d - b c` and the entries of the generic matrix are written `x_p` for
`p ∈ {(0,0), (0,1), (1,0), (1,1)}`. The group `G_m` acts on `GL₂` by scalars, and the coordinate
ring of the quotient `PGL₂ = GL₂ / G_m` is the ring of invariants, generated by the ten elements

`e_{p q} = x_p x_q / Δ`.

Over a `k`-algebra `A`, an invertible matrix `M` gives the ring map `ev_M` sending `e_{p q}` to
`M_p M_q / det M`; scalar multiples of `M` give the same map. The elements `g_p = e_{p p}`
generate the unit ideal, and over the basic open `D(g_p)` the matrix `N^p` with entries
`e_{p q} / g_p` (which has `N^p_p = 1` and determinant `1 / g_p`) satisfies `ev_{N^p} = id`:
every ring map out of the coordinate ring of `PGL₂` is locally of the form `ev_M`.

Over a field the chart `D(g_{(0,0)})` is the spectrum of `k[β, γ, δ, 1/(δ - β γ)]`, the matrices
with upper left entry `1`, so `PGL₂` has dimension three
(`AlgebraicGeometry.topologicalKrullDim_projectiveGeneralLinearTwoScheme`).

## Main definitions

* `AlgebraicGeometry.projectiveGeneralLinearTwoRing`: the subring generated by the `e_{p q}`.
* `AlgebraicGeometry.projectiveGeneralLinearTwoEval`: the ring map `ev_M`.
* `AlgebraicGeometry.projectiveGeneralLinearTwoChartMatrix`: the matrix `N^p` over `D(g_p)`.
* `AlgebraicGeometry.projectiveGeneralLinearTwoScheme`: `PGL₂` as a scheme over `k`, with the
  quotient morphism `AlgebraicGeometry.generalLinearTwoToProjective` from `GL₂`.
* `AlgebraicGeometry.generalLinearTwoUniversalMatrix`: the universal invertible matrix over `GL₂`.

## Main results

* `AlgebraicGeometry.projectiveGeneralLinearTwoEval_smul`: scalar multiples give the same map.
* `AlgebraicGeometry.span_projectiveGeneralLinearTwoChartElement_eq_top`: the `g_p` generate the
  unit ideal.
* `AlgebraicGeometry.projectiveGeneralLinearTwoEval_chartMatrix`: `ev_{N^p}` is the localization
  map.
* `AlgebraicGeometry.exists_eq_projectiveGeneralLinearTwoEval_of_isUnit`: a ring map inverting
  some `g_p` is `ev_M` for an invertible matrix `M`.
* `AlgebraicGeometry.eq_smul_of_projectiveGeneralLinearTwoEval_eq`: if `ev_M = ev_N` and an entry
  of `M` is a unit, then `N` is a scalar multiple of `M`.
* `AlgebraicGeometry.projectiveGeneralLinearTwoEval_universalMatrix`: `ev` of the universal matrix
  is the inclusion of the coordinate ring of `PGL₂` into that of `GL₂`.

## Implementation notes

The coordinate ring is defined as the `k`-subalgebra of `k[a, b, c, d, 1/Δ]` generated by the
`e_{p q}` rather than as the degree-zero part of a graded localization: ring maps out of it are
then determined by their values on the generators, which is the form in which every statement
about `ev_M` is proved. A ring map `σ : k ⟶ A` is used instead of an algebra structure, so that
the construction applies to the global sections of an arbitrary `k`-scheme without choosing an
instance.

## References

* [Stacks Project, Tag 0DSV](https://stacks.math.columbia.edu/tag/0DSV)
-/

@[expose] public noncomputable section

open CategoryTheory

universe u

namespace AlgebraicGeometry

variable (k : Type u) [CommRing k]

/-! ### The ring -/

/-- The entry `x_p` of the generic matrix in the coordinate ring of `GL₂`. -/
abbrev generalLinearTwoEntry (p : Fin 2 × Fin 2) : generalLinearTwoCoordinateRing k :=
  generalLinearTwoCoordinate k p.1 p.2

/-- The inverse `1 / Δ` of the generic determinant. -/
abbrev generalLinearTwoDeterminantInv : generalLinearTwoCoordinateRing k :=
  IsLocalization.Away.invSelf (generalLinearTwoDeterminant k)

/-- The generator `e_{p q} = x_p x_q / Δ`. -/
abbrev projectiveGeneralLinearTwoGenerator (p q : Fin 2 × Fin 2) :
    generalLinearTwoCoordinateRing k :=
  generalLinearTwoEntry k p * generalLinearTwoEntry k q * generalLinearTwoDeterminantInv k

/-- **The coordinate ring of `PGL₂`**: the subring of `k[a, b, c, d, 1/Δ]` generated by the
`G_m`-invariants `e_{p q} = x_p x_q / Δ`. -/
def projectiveGeneralLinearTwoRing : Subalgebra k (generalLinearTwoCoordinateRing k) :=
  Algebra.adjoin k (Set.range fun pq : (Fin 2 × Fin 2) × (Fin 2 × Fin 2) ↦
    projectiveGeneralLinearTwoGenerator k pq.1 pq.2)

/-- The generator `e_{p q}` as an element of the coordinate ring of `PGL₂`. -/
def projectiveGeneralLinearTwoElement (p q : Fin 2 × Fin 2) : projectiveGeneralLinearTwoRing k :=
  ⟨projectiveGeneralLinearTwoGenerator k p q, Algebra.subset_adjoin ⟨(p, q), rfl⟩⟩

/-- The generator `e_{p q}`, read in the coordinate ring of `GL₂`, is `x_p x_q / Δ`. -/
@[simp]
theorem coe_projectiveGeneralLinearTwoElement (p q : Fin 2 × Fin 2) :
    (projectiveGeneralLinearTwoElement k p q : generalLinearTwoCoordinateRing k) =
      projectiveGeneralLinearTwoGenerator k p q :=
  rfl

/-- `x_{(0,0)} x_{(1,1)} - x_{(0,1)} x_{(1,0)} = Δ` in the coordinate ring of `GL₂`. -/
theorem generalLinearTwoEntry_det :
    generalLinearTwoEntry k (0, 0) * generalLinearTwoEntry k (1, 1) -
        generalLinearTwoEntry k (0, 1) * generalLinearTwoEntry k (1, 0) =
      algebraMap _ (generalLinearTwoCoordinateRing k) (generalLinearTwoDeterminant k) := by
  simp only [generalLinearTwoEntry, generalLinearTwoCoordinate, generalLinearTwoDeterminant,
    Matrix.det_fin_two, Matrix.mvPolynomialX_apply, map_sub, map_mul]

/-- `Δ · (1 / Δ) = 1` in the coordinate ring of `GL₂`. -/
theorem generalLinearTwoDeterminant_mul_inv :
    algebraMap _ (generalLinearTwoCoordinateRing k) (generalLinearTwoDeterminant k) *
      generalLinearTwoDeterminantInv k = 1 :=
  IsLocalization.Away.mul_invSelf _

/-- **The relations `e_{p q} e_{r s} = e_{p r} e_{q s}`.** -/
theorem projectiveGeneralLinearTwoElement_mul (p q r s : Fin 2 × Fin 2) :
    projectiveGeneralLinearTwoElement k p q * projectiveGeneralLinearTwoElement k r s =
      projectiveGeneralLinearTwoElement k p r * projectiveGeneralLinearTwoElement k q s := by
  ext1
  simp only [Subalgebra.coe_mul, coe_projectiveGeneralLinearTwoElement]
  ring

/-- The relation `e_{p,(0,0)} e_{q,(1,1)} - e_{p,(0,1)} e_{q,(1,0)} = e_{p q}`. -/
theorem projectiveGeneralLinearTwoElement_det (p q : Fin 2 × Fin 2) :
    projectiveGeneralLinearTwoElement k p (0, 0) * projectiveGeneralLinearTwoElement k q (1, 1) -
        projectiveGeneralLinearTwoElement k p (0, 1) *
          projectiveGeneralLinearTwoElement k q (1, 0) =
      projectiveGeneralLinearTwoElement k p q := by
  ext1
  simp only [Subalgebra.coe_sub, Subalgebra.coe_mul, coe_projectiveGeneralLinearTwoElement]
  linear_combination (generalLinearTwoEntry k p * generalLinearTwoEntry k q *
      generalLinearTwoDeterminantInv k ^ 2) * generalLinearTwoEntry_det k +
    (generalLinearTwoEntry k p * generalLinearTwoEntry k q * generalLinearTwoDeterminantInv k) *
      generalLinearTwoDeterminant_mul_inv k

/-- The chart element `g_p = e_{p p}`. -/
abbrev projectiveGeneralLinearTwoChartElement (p : Fin 2 × Fin 2) :
    projectiveGeneralLinearTwoRing k :=
  projectiveGeneralLinearTwoElement k p p

/-- **The chart elements `g_p` generate the unit ideal.** -/
theorem span_projectiveGeneralLinearTwoChartElement_eq_top :
    Ideal.span (Set.range (projectiveGeneralLinearTwoChartElement k)) = ⊤ := by
  set A := projectiveGeneralLinearTwoElement k (0, 0) (1, 1)
  set B := projectiveGeneralLinearTwoElement k (0, 1) (1, 0)
  have h1 : A - B = 1 := by
    ext1
    simp only [A, B, Subalgebra.coe_sub, coe_projectiveGeneralLinearTwoElement,
      OneMemClass.coe_one]
    linear_combination generalLinearTwoDeterminantInv k * generalLinearTwoEntry_det k +
      generalLinearTwoDeterminant_mul_inv k
  have hA : A * A = projectiveGeneralLinearTwoChartElement k (0, 0) *
      projectiveGeneralLinearTwoChartElement k
          (1, 1) := projectiveGeneralLinearTwoElement_mul k _ _ _ _
  have hB : B * B = projectiveGeneralLinearTwoChartElement k (0, 1) *
      projectiveGeneralLinearTwoChartElement k
          (1, 0) := projectiveGeneralLinearTwoElement_mul k _ _ _ _
  have mem : ∀ p, projectiveGeneralLinearTwoChartElement k p ∈
      Ideal.span (Set.range (projectiveGeneralLinearTwoChartElement k)) := fun p ↦
    Ideal.subset_span ⟨p, rfl⟩
  rw [Ideal.eq_top_iff_one]
  have : (1 : projectiveGeneralLinearTwoRing k) =
      projectiveGeneralLinearTwoChartElement k (0, 0) *
          (projectiveGeneralLinearTwoChartElement k (1, 1) * (A - 3 * B)) +
        projectiveGeneralLinearTwoChartElement k (0, 1) *
          (projectiveGeneralLinearTwoChartElement k (1, 0) * (3 * A - B)) := by
    linear_combination (-(1 + (A - B) + (A - B) ^ 2)) * h1 + (A - 3 * B) * hA + (3 * A - B) * hB
  rw [this]
  exact Ideal.add_mem _ (Ideal.mul_mem_right _ _ (mem _)) (Ideal.mul_mem_right _ _ (mem _))

/-- **Ring maps out of the coordinate ring of `PGL₂` are determined by their values on `k` and on
the generators `e_{p q}`.** -/
theorem projectiveGeneralLinearTwoRing_ringHom_ext {B : Type*} [CommRing B]
    {f g : projectiveGeneralLinearTwoRing k →+* B}
    (hk : f.comp (algebraMap k _) = g.comp (algebraMap k _))
    (hgen : ∀ p q, f (projectiveGeneralLinearTwoElement k p q) =
      g (projectiveGeneralLinearTwoElement k p q)) : f = g := by
  ext ⟨x, hx⟩
  induction hx using Algebra.adjoin_induction with
  | mem x hx =>
    obtain ⟨⟨p, q⟩, rfl⟩ := hx
    exact hgen p q
  | algebraMap r => exact congrArg (fun φ : k →+* B ↦ φ r) hk
  | add x y hx hy ihx ihy =>
    change f (⟨x, hx⟩ + ⟨y, hy⟩) = g (⟨x, hx⟩ + ⟨y, hy⟩)
    rw [map_add, map_add, ihx, ihy]
  | mul x y hx hy ihx ihy =>
    change f (⟨x, hx⟩ * ⟨y, hy⟩) = g (⟨x, hx⟩ * ⟨y, hy⟩)
    rw [map_mul, map_mul, ihx, ihy]

/-! ### Evaluation at an invertible matrix -/

variable {k} {A : Type u} [CommRing A] (σ : k →+* A) (M : Matrix (Fin 2) (Fin 2) A)
  (hM : IsUnit M.det)

/-- Evaluation of the generic determinant at a matrix is its determinant. -/
theorem eval₂Hom_generalLinearTwoDeterminant :
    MvPolynomial.eval₂Hom σ (fun p : Fin 2 × Fin 2 ↦ M p.1 p.2) (generalLinearTwoDeterminant k) =
      M.det := by
  simp [generalLinearTwoDeterminant, Matrix.det_fin_two]

/-- Evaluation at an invertible matrix, `k[a, b, c, d, 1/Δ] ⟶ A`. -/
def generalLinearTwoEval : generalLinearTwoCoordinateRing k →+* A :=
  IsLocalization.Away.lift (generalLinearTwoDeterminant k)
    (g := MvPolynomial.eval₂Hom σ (fun p : Fin 2 × Fin 2 ↦ M p.1 p.2))
    (by rw [eval₂Hom_generalLinearTwoDeterminant]; exact hM)

/-- `ev_M` sends the entry `x_p` of the generic matrix to the entry `M_p`. -/
@[simp]
theorem generalLinearTwoEval_entry (p : Fin 2 × Fin 2) :
    generalLinearTwoEval σ M hM (generalLinearTwoEntry k p) = M p.1 p.2 := by
  simp [generalLinearTwoEval, generalLinearTwoEntry, generalLinearTwoCoordinate]

/-- Evaluation at `M` restricts to `σ` on `k`. -/
@[simp]
theorem generalLinearTwoEval_algebraMap (r : k) :
    generalLinearTwoEval σ M hM (algebraMap k _ r) = σ r := by
  rw [IsScalarTower.algebraMap_apply k (MvPolynomial (Fin 2 × Fin 2) k), generalLinearTwoEval,
    IsLocalization.Away.lift_eq]
  simp

/-- `det M · ev_M(1 / Δ) = 1`. -/
theorem generalLinearTwoEval_det_mul_inv :
    M.det * generalLinearTwoEval σ M hM (generalLinearTwoDeterminantInv k) = 1 := by
  have e : generalLinearTwoEval σ M hM
      (algebraMap _ _ (generalLinearTwoDeterminant k)) = M.det := by
    rw [generalLinearTwoEval, IsLocalization.Away.lift_eq, eval₂Hom_generalLinearTwoDeterminant]
  rw [← e, ← map_mul, generalLinearTwoDeterminant_mul_inv, map_one]

/-- **The ring map `ev_M` out of the coordinate ring of `PGL₂`**, `e_{p q} ↦ M_p M_q / det M`. -/
def projectiveGeneralLinearTwoEval : projectiveGeneralLinearTwoRing k →+* A :=
  (generalLinearTwoEval σ M hM).comp (projectiveGeneralLinearTwoRing k).val.toRingHom

/-- **The defining property of `ev_M`**: `ev_M(e_{p q}) · det M = M_p M_q`. -/
theorem projectiveGeneralLinearTwoEval_element_mul_det (p q : Fin 2 × Fin 2) :
    projectiveGeneralLinearTwoEval σ M hM (projectiveGeneralLinearTwoElement k p q) * M.det =
      M p.1 p.2 * M q.1 q.2 := by
  have h := generalLinearTwoEval_det_mul_inv σ M hM
  simp only [projectiveGeneralLinearTwoEval, RingHom.coe_comp, Function.comp_apply,
    AlgHom.toRingHom_eq_coe, RingHom.coe_coe, Subalgebra.coe_val,
    coe_projectiveGeneralLinearTwoElement, map_mul, generalLinearTwoEval_entry]
  linear_combination (M p.1 p.2 * M q.1 q.2) * h

/-- `ev_M` restricts to `σ` on `k`. -/
@[simp]
theorem projectiveGeneralLinearTwoEval_comp_algebraMap :
    (projectiveGeneralLinearTwoEval σ M hM).comp (algebraMap k _) = σ :=
  RingHom.ext fun r ↦ generalLinearTwoEval_algebraMap σ M hM r

/-- A ring map out of the coordinate ring of `PGL₂` is `ev_M` as soon as it agrees with `σ` on
`k` and satisfies the defining property of `ev_M`. -/
theorem eq_projectiveGeneralLinearTwoEval {f : projectiveGeneralLinearTwoRing k →+* A}
    (hk : f.comp (algebraMap k _) = σ)
    (hgen : ∀ p q, f (projectiveGeneralLinearTwoElement k p q) * M.det = M p.1 p.2 * M q.1 q.2) :
    f = projectiveGeneralLinearTwoEval σ M hM := by
  refine projectiveGeneralLinearTwoRing_ringHom_ext k (by simp [hk]) fun p q ↦ ?_
  obtain ⟨w, hw⟩ : ∃ w, M.det * w = 1 := ⟨_, hM.mul_val_inv⟩
  calc f (projectiveGeneralLinearTwoElement k p q)
      = f (projectiveGeneralLinearTwoElement k p q) * M.det * w := by
        rw [mul_assoc, hw, mul_one]
    _ = projectiveGeneralLinearTwoEval σ M hM (projectiveGeneralLinearTwoElement k p q) *
          M.det * w := by
        rw [hgen, projectiveGeneralLinearTwoEval_element_mul_det]
    _ = _ := by rw [mul_assoc, hw, mul_one]

/-- **Naturality of `ev_M`** in `A`. -/
theorem projectiveGeneralLinearTwoEval_naturality {B : Type u} [CommRing B] (φ : A →+* B)
    (hφM : IsUnit (M.map φ).det) :
    φ.comp (projectiveGeneralLinearTwoEval σ M hM) =
      projectiveGeneralLinearTwoEval (φ.comp σ) (M.map φ) hφM := by
  refine eq_projectiveGeneralLinearTwoEval _ _ _ (by
    rw [RingHom.comp_assoc, projectiveGeneralLinearTwoEval_comp_algebraMap]) fun p q ↦ ?_
  have hdet : (M.map φ).det = φ M.det := (RingHom.map_det φ M).symm
  rw [hdet, RingHom.comp_apply, ← map_mul, projectiveGeneralLinearTwoEval_element_mul_det, map_mul]
  rfl

/-- **Scalar multiples of a matrix give the same map.** -/
theorem projectiveGeneralLinearTwoEval_smul {w : A} (hw : IsUnit w) (hwM : IsUnit (w • M).det) :
    projectiveGeneralLinearTwoEval σ (w • M) hwM = projectiveGeneralLinearTwoEval σ M hM := by
  refine eq_projectiveGeneralLinearTwoEval σ M hM
      (f := projectiveGeneralLinearTwoEval σ (w • M) hwM)
    (projectiveGeneralLinearTwoEval_comp_algebraMap σ (w • M) hwM) fun p q ↦ ?_
  obtain ⟨v, hv⟩ : ∃ v, w * v = 1 := ⟨_, hw.mul_val_inv⟩
  have h := projectiveGeneralLinearTwoEval_element_mul_det σ (w • M) hwM p q
  rw [Matrix.det_smul, Fintype.card_fin] at h
  simp only [Matrix.smul_apply, smul_eq_mul] at h
  linear_combination v ^ 2 * h - (projectiveGeneralLinearTwoEval σ (w • M) hwM
    (projectiveGeneralLinearTwoElement k p q) * M.det - M p.1 p.2 * M q.1 q.2) * (1 + w * v) * hv

/-- **Uniqueness up to scalars**: if `ev_M = ev_N` and the entry `M_x` is a unit, then `N` is a
scalar multiple of `M` by a unit. -/
theorem eq_smul_of_projectiveGeneralLinearTwoEval_eq {N : Matrix (Fin 2) (Fin 2) A}
    (hN : IsUnit N.det) (h : projectiveGeneralLinearTwoEval σ M hM =
      projectiveGeneralLinearTwoEval σ N hN) (x : Fin 2 × Fin 2) (hx : IsUnit (M x.1 x.2)) :
    ∃ w : A, IsUnit w ∧ N = w • M := by
  set E := projectiveGeneralLinearTwoEval σ M hM (projectiveGeneralLinearTwoElement k x x)
  have h1 : E * M.det = M x.1 x.2 * M x.1 x.2 :=
    projectiveGeneralLinearTwoEval_element_mul_det σ M hM x x
  have hN' : ∀ y, projectiveGeneralLinearTwoEval σ M hM (projectiveGeneralLinearTwoElement k x y) *
      N.det = N x.1 x.2 * N y.1 y.2 := fun y ↦ by
    rw [h]
    exact projectiveGeneralLinearTwoEval_element_mul_det σ N hN x y
  have h2 : E * N.det = N x.1 x.2 * N x.1 x.2 := hN' x
  have hE : IsUnit E := isUnit_of_mul_isUnit_left (h1 ▸ hx.mul hx)
  have hb : IsUnit (N x.1 x.2) := isUnit_of_mul_isUnit_left (h2 ▸ hE.mul hN)
  obtain ⟨a', ha'⟩ : ∃ a', M x.1 x.2 * a' = 1 := ⟨_, hx.mul_val_inv⟩
  refine ⟨N x.1 x.2 * a', hb.mul (IsUnit.of_mul_eq_one (M x.1 x.2) (by rw [mul_comm]; exact ha')),
      ?_⟩
  ext i j
  set F := projectiveGeneralLinearTwoEval σ M hM (projectiveGeneralLinearTwoElement k x (i, j))
  have h3 : F * M.det = M x.1 x.2 * M i j :=
    projectiveGeneralLinearTwoEval_element_mul_det σ M hM x (i, j)
  have h4 : F * N.det = N x.1 x.2 * N i j := hN' (i, j)
  have hF : F = E * a' * M i j := by
    refine hM.mul_left_cancel ?_
    linear_combination h3 - (a' * M i j) * h1 - (M x.1 x.2 * M i j) * ha'
  simp only [Matrix.smul_apply, smul_eq_mul]
  refine hb.mul_left_cancel ?_
  linear_combination -h4 + N.det * hF + (a' * M i j) * h2

/-! ### The charts -/

variable (k) in
/-- The localization `D(g_p)` of the coordinate ring of `PGL₂`. -/
abbrev projectiveGeneralLinearTwoChartRing (p : Fin 2 × Fin 2) :=
  Localization.Away (projectiveGeneralLinearTwoChartElement k p)

variable (k) in
/-- The structure map `k ⟶ D(g_p)`. -/
abbrev projectiveGeneralLinearTwoChartStructure (p : Fin 2 × Fin 2) :
    k →+* projectiveGeneralLinearTwoChartRing k p :=
  (algebraMap (projectiveGeneralLinearTwoRing k) _).comp (algebraMap k _)

variable (k) in
/-- **The chart matrix** `N^p` over `D(g_p)`, with entries `e_{p q} / g_p`. Its `p`-th entry is
`1`. -/
def projectiveGeneralLinearTwoChartMatrix (p : Fin 2 × Fin 2) :
    Matrix (Fin 2) (Fin 2) (projectiveGeneralLinearTwoChartRing k p) :=
  fun i j ↦ algebraMap _ _ (projectiveGeneralLinearTwoElement k p (i, j)) *
    IsLocalization.Away.invSelf (projectiveGeneralLinearTwoChartElement k p)

variable (k) in
/-- The `p`-th entry of the chart matrix `N^p` is `1`. -/
theorem projectiveGeneralLinearTwoChartMatrix_self (p : Fin 2 × Fin 2) :
    projectiveGeneralLinearTwoChartMatrix k p p.1 p.2 = 1 :=
  IsLocalization.Away.mul_invSelf _

variable (k) in
/-- The determinant of the chart matrix `N^p` is `1 / g_p`. -/
theorem projectiveGeneralLinearTwoChartMatrix_det (p : Fin 2 × Fin 2) :
    (projectiveGeneralLinearTwoChartMatrix k p).det =
      IsLocalization.Away.invSelf (projectiveGeneralLinearTwoChartElement k p) := by
  have hrel := congrArg (algebraMap (projectiveGeneralLinearTwoRing k)
    (projectiveGeneralLinearTwoChartRing k p)) (projectiveGeneralLinearTwoElement_det k p p)
  have hinv := IsLocalization.Away.mul_invSelf (S := projectiveGeneralLinearTwoChartRing k p)
    (projectiveGeneralLinearTwoChartElement k p)
  rw [map_sub, map_mul, map_mul] at hrel
  rw [Matrix.det_fin_two]
  simp only [projectiveGeneralLinearTwoChartMatrix]
  linear_combination
      (IsLocalization.Away.invSelf (projectiveGeneralLinearTwoChartElement k p)) ^ 2 *
    hrel + IsLocalization.Away.invSelf (projectiveGeneralLinearTwoChartElement k p) * hinv

variable (k) in
/-- The determinant of the chart matrix `N^p` is a unit. -/
theorem isUnit_projectiveGeneralLinearTwoChartMatrix_det (p : Fin 2 × Fin 2) :
    IsUnit (projectiveGeneralLinearTwoChartMatrix k p).det := by
  rw [projectiveGeneralLinearTwoChartMatrix_det]
  exact IsUnit.of_mul_eq_one _ (by rw [mul_comm]; exact IsLocalization.Away.mul_invSelf _)

variable (k) in
/-- **On the chart `D(g_p)`, the localization map is `ev_{N^p}`.** -/
theorem projectiveGeneralLinearTwoEval_chartMatrix (p : Fin 2 × Fin 2) :
    projectiveGeneralLinearTwoEval (projectiveGeneralLinearTwoChartStructure k p)
        (projectiveGeneralLinearTwoChartMatrix k p)
        (isUnit_projectiveGeneralLinearTwoChartMatrix_det k p) =
      algebraMap _ _ := by
  refine (eq_projectiveGeneralLinearTwoEval _ _ _ rfl fun q r ↦ ?_).symm
  have hrel := congrArg (algebraMap (projectiveGeneralLinearTwoRing k)
    (projectiveGeneralLinearTwoChartRing k p)) (projectiveGeneralLinearTwoElement_mul k p q p r)
  have hinv := IsLocalization.Away.mul_invSelf (S := projectiveGeneralLinearTwoChartRing k p)
    (projectiveGeneralLinearTwoChartElement k p)
  rw [map_mul, map_mul] at hrel
  rw [projectiveGeneralLinearTwoChartMatrix_det]
  simp only [projectiveGeneralLinearTwoChartMatrix]
  linear_combination (-(IsLocalization.Away.invSelf
    (projectiveGeneralLinearTwoChartElement k p)) ^ 2) * hrel -
    (algebraMap _ _ (projectiveGeneralLinearTwoElement k q r) *
      IsLocalization.Away.invSelf (projectiveGeneralLinearTwoChartElement k p)) * hinv

/-- A ring map out of `D(g_p)` restricting to `σ` on `k` is `ev` of the image of the chart matrix
`N^p`, which has `p`-th entry `1`. -/
private theorem exists_chartMatrix_map_eq (p : Fin 2 × Fin 2)
    (ψ : projectiveGeneralLinearTwoChartRing k p →+* A)
    (hψ : ψ.comp (projectiveGeneralLinearTwoChartStructure k p) = σ) :
    ∃ (N : Matrix (Fin 2) (Fin 2) A) (hN : IsUnit N.det),
      N p.1 p.2 = 1 ∧ ψ.comp (algebraMap _ _) = projectiveGeneralLinearTwoEval σ N hN := by
  have hdet : IsUnit ((projectiveGeneralLinearTwoChartMatrix k p).map ψ).det := by
    simpa only [RingHom.map_det, RingHom.mapMatrix_apply] using
      (isUnit_projectiveGeneralLinearTwoChartMatrix_det k p).map ψ
  refine ⟨_, hdet, ?_, ?_⟩
  · simp only [Matrix.map_apply, projectiveGeneralLinearTwoChartMatrix_self, map_one]
  · have := projectiveGeneralLinearTwoEval_naturality (projectiveGeneralLinearTwoChartStructure k p)
      _ (isUnit_projectiveGeneralLinearTwoChartMatrix_det k p) ψ hdet
    rwa [projectiveGeneralLinearTwoEval_chartMatrix k p, hψ] at this

/-- **Every ring map out of the coordinate ring of `PGL₂` is locally of the form `ev_M`**: after
inverting the image of `g_p` it is `ev` of the image of the chart matrix `N^p`. -/
theorem algebraMap_comp_eq_projectiveGeneralLinearTwoEval
    (φ : projectiveGeneralLinearTwoRing k →+* A) (hφ : φ.comp (algebraMap k _) = σ)
    (p : Fin 2 × Fin 2) :
    ∃ (N : Matrix (Fin 2) (Fin 2)
        (Localization.Away (φ (projectiveGeneralLinearTwoChartElement k p))))
      (hN : IsUnit N.det),
      N p.1 p.2 = 1 ∧
      (algebraMap A _).comp φ =
        projectiveGeneralLinearTwoEval ((algebraMap A _).comp σ) N hN := by
  let ψ : projectiveGeneralLinearTwoChartRing k p →+*
      Localization.Away (φ (projectiveGeneralLinearTwoChartElement k p)) :=
    IsLocalization.Away.map _ _ φ (projectiveGeneralLinearTwoChartElement k p)
  have hψ : ψ.comp (algebraMap _ _) = (algebraMap A _).comp φ :=
    IsLocalization.map_comp _
  obtain ⟨N, hN, h1, h2⟩ := exists_chartMatrix_map_eq ((algebraMap A _).comp σ) p ψ (by
    rw [← hφ, ← RingHom.comp_assoc _ φ, ← hψ]; rfl)
  exact ⟨N, hN, h1, hψ.symm.trans h2⟩

/-- **A ring map out of the coordinate ring of `PGL₂` inverting some `g_p` is of the form
`ev_M`.** -/
theorem exists_eq_projectiveGeneralLinearTwoEval_of_isUnit
    (φ : projectiveGeneralLinearTwoRing k →+* A) (hφ : φ.comp (algebraMap k _) = σ)
    (p : Fin 2 × Fin 2) (hp : IsUnit (φ (projectiveGeneralLinearTwoChartElement k p))) :
    ∃ (N : Matrix (Fin 2) (Fin 2) A) (hN : IsUnit N.det),
      N p.1 p.2 = 1 ∧ φ = projectiveGeneralLinearTwoEval σ N hN := by
  let ψ : projectiveGeneralLinearTwoChartRing k p →+* A :=
    IsLocalization.Away.lift (projectiveGeneralLinearTwoChartElement k p) hp
  have hψ : ψ.comp (algebraMap _ _) = φ := IsLocalization.Away.lift_comp _ _
  obtain ⟨N, hN, h1, h2⟩ := exists_chartMatrix_map_eq σ p ψ (by
    rw [← hφ, ← hψ]; rfl)
  exact ⟨N, hN, h1, hψ.symm.trans h2⟩

/-! ### The universal matrix -/

variable (k) in
/-- The universal invertible matrix over the coordinate ring of `GL₂`. -/
def generalLinearTwoUniversalMatrix : Matrix (Fin 2) (Fin 2) (generalLinearTwoCoordinateRing k) :=
  fun i j ↦ generalLinearTwoCoordinate k i j

variable (k) in
/-- The determinant of the universal matrix is the generic determinant `Δ`. -/
theorem generalLinearTwoUniversalMatrix_det :
    (generalLinearTwoUniversalMatrix k).det =
      algebraMap _ (generalLinearTwoCoordinateRing k) (generalLinearTwoDeterminant k) := by
  rw [Matrix.det_fin_two, ← generalLinearTwoEntry_det]
  rfl

variable (k) in
/-- The determinant of the universal matrix is a unit. -/
theorem isUnit_generalLinearTwoUniversalMatrix_det :
    IsUnit (generalLinearTwoUniversalMatrix k).det := by
  rw [generalLinearTwoUniversalMatrix_det]
  exact IsLocalization.Away.algebraMap_isUnit _

variable (k) in
/-- **`ev` of the universal matrix is the inclusion** of the coordinate ring of `PGL₂` into that of
`GL₂`. -/
theorem projectiveGeneralLinearTwoEval_universalMatrix :
    projectiveGeneralLinearTwoEval (algebraMap k _) (generalLinearTwoUniversalMatrix k)
        (isUnit_generalLinearTwoUniversalMatrix_det k) =
      (projectiveGeneralLinearTwoRing k).val.toRingHom := by
  refine (eq_projectiveGeneralLinearTwoEval _ _ _
    (AlgHom.comp_algebraMap (projectiveGeneralLinearTwoRing k).val) fun p q ↦ ?_).symm
  rw [generalLinearTwoUniversalMatrix_det]
  change projectiveGeneralLinearTwoGenerator k p q * _ =
    generalLinearTwoEntry k p * generalLinearTwoEntry k q
  linear_combination (generalLinearTwoEntry k p * generalLinearTwoEntry k q) *
    generalLinearTwoDeterminant_mul_inv k

variable (k) in
/-- `ev` of the universal matrix, along a ring map `σ` equal to the structure map, is the inclusion
of the coordinate ring of `PGL₂` into that of `GL₂`. -/
theorem projectiveGeneralLinearTwoEval_universalMatrix_of_eq {σ : k →+*
    generalLinearTwoCoordinateRing k}
    (hσ : σ = algebraMap k _) :
    projectiveGeneralLinearTwoEval σ (generalLinearTwoUniversalMatrix k)
        (isUnit_generalLinearTwoUniversalMatrix_det k) =
      (projectiveGeneralLinearTwoRing k).val.toRingHom := by
  subst hσ
  exact projectiveGeneralLinearTwoEval_universalMatrix k

/-! ### The scheme -/

variable (k) in
/-- **The projective general linear scheme `PGL₂` over `k`**, the spectrum of the ring of
`G_m`-invariants of the coordinate ring of `GL₂`. -/
abbrev projectiveGeneralLinearTwoScheme : Over (Spec (.of k)) :=
  Over.mk (Spec.map (CommRingCat.ofHom (algebraMap k (projectiveGeneralLinearTwoRing k))))

variable (k) in
/-- The quotient morphism `GL₂ ⟶ PGL₂`. -/
abbrev generalLinearTwoToProjective :
    generalLinearTwoScheme k ⟶ (projectiveGeneralLinearTwoScheme k).left :=
  Spec.map (CommRingCat.ofHom (projectiveGeneralLinearTwoRing k).val.toRingHom)

end AlgebraicGeometry
