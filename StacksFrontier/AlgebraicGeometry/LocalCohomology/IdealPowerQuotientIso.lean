module

public import Mathlib.Algebra.Module.Torsion.Basic
public import StacksFrontier.AlgebraicGeometry.IdealPowerSections.Basic
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Sections away from an ideal and the quotients by the power torsion

Let `I` be a finitely generated ideal of a commutative ring `A` and let `M` be an `A`-module.
Write `Mₙ` for the submodule of `M` annihilated by `I ^ n`. This file constructs the canonical
map from the direct limit of the modules `Hom_A(I ^ n, M / Mₙ)` to the sections of `M̃` on
`Spec(A) \ V(I)` and proves that it is bijective, which is the `general_isomorphism` part of
Tag 01PM.

## Main definitions

All names are in the namespace `Stacks.AlgebraicGeometry.IdealPowerSections`.

* `idealPowersHomModuloAnnihilator`: the direct system `n ↦ Hom_A(I ^ n, M / Mₙ)`.
* `canonicalMapModuloAnnihilator`: the canonical map from its colimit to the sections of `M̃`
  away from `V(I)`.
* `idealPowersHomModuloAnnihilatorColimitIsoSections`: the resulting isomorphism, for `I` finitely
  generated.

## Main results

* `span_pow_le_span_image_pow`: if `I` is generated by a finite set `s`, then
  `I ^ (s.card * (d - 1) + 1)` is contained in the ideal generated by the `d`-th powers of the
  elements of `s`.
* `canonicalMapModuloAnnihilator_injective`, `canonicalMapModuloAnnihilator_surjective`,
  `canonicalMapModuloAnnihilator_bijective`: for `I` finitely generated the canonical map is
  injective, surjective and bijective.

## References

* [Stacks Project, Tag 01PM](https://stacks.math.columbia.edu/tag/01PM)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace
open AlgebraicGeometry AlgebraicGeometry.StructureSheaf

universe u v w

namespace Stacks.AlgebraicGeometry.IdealPowerSections

/-!
### Powers of an ideal and the ideal generated by the powers of its generators
-/

section IdealPowers

variable {A : Type u} [CommRing A]

/-- A power of a sum of two ideals is contained in the sum of the products of their powers:
the ideal-theoretic form of the binomial expansion. -/
@[ega "IV 19.7.1.15" "partial"]
public lemma sup_pow_le_iSup_pow_mul_pow (X Y : Ideal A) (n : ℕ) :
    (X ⊔ Y) ^ n ≤ ⨆ i : ℕ, X ^ i * Y ^ (n - i) := by
  induction n with
  | zero =>
    refine le_trans (le_of_eq (pow_zero _)) ?_
    refine le_trans (le_of_eq ?_) (le_iSup (fun i : ℕ => X ^ i * Y ^ (0 - i)) 0)
    simp
  | succ n ih =>
    rw [pow_succ]
    refine le_trans (Ideal.mul_mono_left ih) ?_
    rw [Submodule.iSup_mul]
    refine iSup_le fun i => ?_
    rw [Submodule.mul_sup]
    refine sup_le ?_ ?_
    · refine le_trans (le_of_eq ?_) (le_iSup (fun j : ℕ => X ^ j * Y ^ (n + 1 - j)) (i + 1))
      rw [Nat.add_sub_add_right, pow_succ]
      ring_nf
    · rcases le_or_gt i n with h | h
      · refine le_trans (le_of_eq ?_) (le_iSup (fun j : ℕ => X ^ j * Y ^ (n + 1 - j)) i)
        rw [mul_assoc, ← pow_succ]
        congr 2
        omega
      · refine le_trans ?_ (le_iSup (fun j : ℕ => X ^ j * Y ^ (n + 1 - j)) i)
        have h1 : n - i = 0 := by omega
        have h2 : n + 1 - i = 0 := by omega
        rw [h1, h2]
        simp only [pow_zero, mul_one]
        exact Ideal.mul_le_left

/-- If an ideal is generated by the elements of a finite set `s`, then its
`(s.card * (d - 1) + 1)`-th power is contained in the ideal generated by the `d`-th powers of
those elements. -/
public lemma span_pow_le_span_image_pow (d : ℕ) (hd : 1 ≤ d) (s : Finset A) :
    (Ideal.span (s : Set A)) ^ (s.card * (d - 1) + 1) ≤
      Ideal.span ((fun a : A => a ^ d) '' (s : Set A)) := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | @insert f s' hf ih =>
    have hmono : Ideal.span ((fun a : A => a ^ d) '' (s' : Set A)) ≤
        Ideal.span ((fun a : A => a ^ d) '' ((insert f s' : Finset A) : Set A)) := by
      refine Ideal.span_mono (Set.image_mono ?_)
      simp only [Finset.coe_insert]
      exact Set.subset_insert _ _
    set D := Ideal.span ((fun a : A => a ^ d) '' ((insert f s' : Finset A) : Set A)) with hD
    have hfD : Ideal.span {f ^ d} ≤ D := by
      rw [Ideal.span_le, Set.singleton_subset_iff]
      exact Ideal.subset_span ⟨f, by simp, rfl⟩
    have hcard : (insert f s' : Finset A).card * (d - 1) + 1 =
        (s'.card * (d - 1) + 1) + (d - 1) := by
      rw [Finset.card_insert_of_notMem hf]; ring
    have hspan : Ideal.span ((insert f s' : Finset A) : Set A) =
        Ideal.span {f} ⊔ Ideal.span (s' : Set A) := by
      rw [Finset.coe_insert, Ideal.span_insert]
    rw [hspan, hcard]
    refine le_trans (sup_pow_le_iSup_pow_mul_pow _ _ _) (iSup_le fun i => ?_)
    rcases le_or_gt d i with h | h
    · refine le_trans Ideal.mul_le_left ?_
      refine le_trans (Ideal.pow_le_pow_right h) ?_
      rw [Ideal.span_singleton_pow]
      exact hfD
    · refine le_trans Ideal.mul_le_right ?_
      have hle : s'.card * (d - 1) + 1 ≤ s'.card * (d - 1) + 1 + (d - 1) - i := by omega
      exact le_trans (Ideal.pow_le_pow_right hle) (le_trans ih hmono)

/-- A finitely generated ideal is generated by a nonempty finite set. -/
private theorem exists_finset_span_eq_of_fg {I : Ideal A} (hI : I.FG) :
    ∃ s : Finset A, Ideal.span (s : Set A) = I ∧ 0 < s.card := by
  classical
  obtain ⟨s0, hs0⟩ := hI
  exact ⟨insert 0 s0, by rw [Finset.coe_insert, Ideal.span_insert_zero, hs0],
    Finset.card_pos.mpr ⟨0, Finset.mem_insert_self 0 s0⟩⟩

/-- The exponent `s.card * (d - 1) + 1` is at least `d`, and the corresponding power of an ideal
generated by `s` lies in the ideal generated by the `d`-th powers of the elements of `s`. -/
private theorem le_card_mul_pred_add_one_and_pow_le {I : Ideal A} {s : Finset A}
    (hs : Ideal.span (s : Set A) = I) (hcard : 0 < s.card) {d : ℕ} (hd : 1 ≤ d) :
    d ≤ s.card * (d - 1) + 1 ∧ (I ^ (s.card * (d - 1) + 1) : Ideal A) ≤
      Ideal.span ((fun b : A => b ^ d) '' (s : Set A)) := by
  refine ⟨?_, hs ▸ span_pow_le_span_image_pow d hd s⟩
  have : d - 1 ≤ s.card * (d - 1) := Nat.le_mul_of_pos_left _ hcard
  omega

/-- A power of `a ∈ I` times the generator `aᵐ` of `I ^ m` is the element `aⁿ` of `I ^ m`. -/
private theorem pow_smul_mk_pow_eq {I : Ideal A} {a : A} (ha : a ∈ I) {m n k : ℕ}
    (h : m + k = n) :
    a ^ k • (⟨a ^ m, Ideal.pow_mem_pow ha m⟩ : ↥(I ^ m : Ideal A)) =
      ⟨a ^ n, Ideal.pow_le_pow_right (show m ≤ n by omega) (Ideal.pow_mem_pow ha n)⟩ :=
  by subst h; exact Subtype.ext (mul_comm (a ^ k) (a ^ m) ▸ pow_add a m k).symm

end IdealPowers

/-!
### The direct system of the quotients by the power torsion
-/

section Diagram

variable (A : Type u) [CommRing A] (I : Ideal A) (M : Type v) [AddCommGroup M] [Module A M]

/-- The quotient map `M / Mₘ → M / Mₙ` for `m ≤ n`, induced by the identity of `M`. -/
public def quotientByIdealPowerAnnihilatorMap {m n : ℕ} (h : m ≤ n) :
    (M ⧸ Submodule.torsionBySet A M (I ^ m : Ideal A)) →ₗ[A]
      (M ⧸ Submodule.torsionBySet A M (I ^ n : Ideal A)) :=
  Submodule.mapQ _ _ LinearMap.id (by
    simpa using Submodule.torsionBySet_le_torsionBySet_pow (M := M) m n h I)

/-- The quotient map from `M / Mₙ` to itself is the identity. -/
public lemma quotientByIdealPowerAnnihilatorMap_id (n : ℕ)
    (x : M ⧸ Submodule.torsionBySet A M (I ^ n : Ideal A)) :
    quotientByIdealPowerAnnihilatorMap A I M (le_refl n) x = x :=
  Submodule.Quotient.induction_on _ x (fun _ ↦ rfl)

/-- The quotient maps between the `M / Mₙ` compose. -/
public lemma quotientByIdealPowerAnnihilatorMap_comp {m n k : ℕ} (h : m ≤ n) (h' : n ≤ k)
    (x : M ⧸ Submodule.torsionBySet A M (I ^ m : Ideal A)) :
    quotientByIdealPowerAnnihilatorMap A I M (h.trans h') x =
      quotientByIdealPowerAnnihilatorMap A I M h'
        (quotientByIdealPowerAnnihilatorMap A I M h x) :=
  Submodule.Quotient.induction_on _ x (fun _ ↦ rfl)

/-- The direct system `n ↦ Hom_A(I ^ n, M / Mₙ)`, with transition maps given by restricting
along `I ^ n ⊆ I ^ m` and then projecting further. -/
public def idealPowersHomModuloAnnihilator : ℕ ⥤ ModuleCat.{max u v} A where
  obj n := ModuleCat.of A
    ((I ^ n : Ideal A) →ₗ[A] (M ⧸ Submodule.torsionBySet A M (I ^ n : Ideal A)))
  map {m n} f := ModuleCat.ofHom <| {
    toFun := fun φ ↦
      (quotientByIdealPowerAnnihilatorMap A I M (leOfHom f)).comp
        (φ.comp (Submodule.inclusion (Ideal.pow_le_pow_right (leOfHom f))))
    map_add' := by
      intros
      ext
      simp
    map_smul' := by
      intros
      ext
      simp }
  map_id n := by
    ext φ x
    exact quotientByIdealPowerAnnihilatorMap_id A I M n (φ x)
  map_comp {m n k} f g := by
    ext φ x
    exact quotientByIdealPowerAnnihilatorMap_comp A I M (leOfHom f) (leOfHom g)
      (φ ⟨x, Ideal.pow_le_pow_right (leOfHom (f ≫ g)) x.property⟩)

end Diagram

/-!
### The section attached to a homomorphism into a quotient
-/

section Construction

variable {A : Type u} [CommRing A] {M : Type v} [AddCommGroup M] [Module A M]

/-- A set-theoretic lift of an element of a quotient module. -/
public noncomputable def quotOut {N : Submodule A M} (x : M ⧸ N) : M := Quotient.out x

/-- The lift `quotOut` is a lift. -/
public lemma mkQ_quotOut {N : Submodule A M} (x : M ⧸ N) : N.mkQ (quotOut x) = x :=
  Quotient.out_eq x

/-- If `a ∈ I ^ n` and `x`, `y` have the same class modulo `Mₙ`, then `a • x = a • y`. -/
public lemma smul_eq_smul_of_mkQ_eq (I : Ideal A) {n : ℕ} {a : A} (ha : a ∈ (I ^ n : Ideal A))
    {x y : M}
    (h : (Submodule.torsionBySet A M (I ^ n : Ideal A)).mkQ x =
      (Submodule.torsionBySet A M (I ^ n : Ideal A)).mkQ y) :
    a • x = a • y := by
  have hxy : x - y ∈ Submodule.torsionBySet A M (I ^ n : Ideal A) :=
    (Submodule.Quotient.eq _).mp h
  have hz : a • (x - y) = 0 :=
    (Submodule.mem_torsionBySet_iff _ _).mp hxy ⟨a, by simpa using ha⟩
  rw [smul_sub, sub_eq_zero] at hz
  exact hz

end Construction

section Section

variable (A : Type u) [CommRing A] (I : Ideal A) (M : Type v) [AddCommGroup M] [Module A M]

/-- The numerators of the local fractions attached to `φ : Hom_A(I ^ n, M / Mₙ)`: an element `a`
of the lifted ideal is sent to `aⁿ` times a lift of `φ(aⁿ)`. -/
public noncomputable def quotNumerator (n : ℕ)
    (φ : (I ^ n : Ideal A) →ₗ[A] M ⧸ Submodule.torsionBySet A M (I ^ n : Ideal A)) :
    ↥(liftedIdeal.{u, v} A I) → ULift.{u} M := fun a =>
  ULift.up ((a : ULift.{v} A).down ^ n •
    quotOut (φ ⟨(a : ULift.{v} A).down ^ n,
      Ideal.pow_mem_pow ((mem_liftedIdeal A I).mp a.2) n⟩))

/-- The numerator at `a` is `aⁿ` times any lift of `φ(aⁿ)`. -/
public lemma quotNumerator_eq (n : ℕ)
    (φ : (I ^ n : Ideal A) →ₗ[A] M ⧸ Submodule.torsionBySet A M (I ^ n : Ideal A))
    (a : ↥(liftedIdeal.{u, v} A I)) {x : M}
    (hx : (Submodule.torsionBySet A M (I ^ n : Ideal A)).mkQ x =
      φ ⟨(a : ULift.{v} A).down ^ n,
        Ideal.pow_mem_pow ((mem_liftedIdeal A I).mp a.2) n⟩) :
    quotNumerator A I M n φ a = ULift.up ((a : ULift.{v} A).down ^ n • x) := by
  refine congrArg ULift.up ?_
  refine (smul_eq_smul_of_mkQ_eq I
    (Ideal.pow_mem_pow ((mem_liftedIdeal A I).mp a.2) n) ?_).symm
  rw [hx, mkQ_quotOut]

/-- The numerators attached to `φ` satisfy, exactly and not merely modulo `Mₙ`, the cross
relation of the fractions with denominators `a ^ (2 * n)`. -/
public lemma quotNumerator_cross (n : ℕ)
    (φ : (I ^ n : Ideal A) →ₗ[A] M ⧸ Submodule.torsionBySet A M (I ^ n : Ideal A))
    (a b : ↥(liftedIdeal.{u, v} A I)) :
    ((b : ULift.{v} A) ^ (2 * n)) • quotNumerator A I M n φ a =
      ((a : ULift.{v} A) ^ (2 * n)) • quotNumerator A I M n φ b := by
  have ha : (a : ULift.{v} A).down ∈ I := (mem_liftedIdeal A I).mp a.2
  have hb : (b : ULift.{v} A).down ∈ I := (mem_liftedIdeal A I).mp b.2
  set α := (a : ULift.{v} A).down with hα
  set β := (b : ULift.{v} A).down with hβ
  set X := quotOut (φ ⟨α ^ n, Ideal.pow_mem_pow ha n⟩) with hX
  set Y := quotOut (φ ⟨β ^ n, Ideal.pow_mem_pow hb n⟩) with hY
  have key : α ^ n • (β ^ n • X) = α ^ n • (α ^ n • Y) := by
    refine smul_eq_smul_of_mkQ_eq I (Ideal.pow_mem_pow ha n) ?_
    rw [map_smul, map_smul, hX, hY, mkQ_quotOut, mkQ_quotOut]
    exact smul_apply_comm (S := I ^ n) φ (Ideal.pow_mem_pow ha n) (Ideal.pow_mem_pow hb n)
  refine ULift.ext _ _ ?_
  simp only [quotNumerator, ULift.smul_def, ULift.pow_down, ULift.smul_down]
  have e1 : β ^ (2 * n) • (α ^ n • X) = β ^ n • (α ^ n • (β ^ n • X)) := by
    rw [smul_smul, smul_smul, smul_smul]
    congr 1
    ring
  have e2 : α ^ (2 * n) • (β ^ n • Y) = β ^ n • (α ^ n • (α ^ n • Y)) := by
    rw [smul_smul, smul_smul, smul_smul]
    congr 1
    ring
  rw [e1, e2, key]

/-- The section of `M̃` on `Spec(A) \ V(I)` attached to `φ : Hom_A(I ^ n, M / Mₙ)`: over a prime
`p` its value is `φ(gⁿ) / gⁿ` for any `g ∈ I` outside `p`. -/
public noncomputable def sectionOfQuotHom (n : ℕ)
    (φ : (I ^ n : Ideal A) →ₗ[A] M ⧸ Submodule.torsionBySet A M (I ^ n : Ideal A)) :
    sectionsOnComplement A I M :=
  ⟨fractionSectionFun (exists_mem_liftedIdeal_notMem A I) (2 * n) (quotNumerator A I M n φ),
    fractionSectionFun_mem (basicOpen_le_liftedComplement A I)
      (quotNumerator_cross A I M n φ)⟩

/-- The quotient maps between the `M / Mₙ` are compatible with the projections from `M`. -/
public lemma quotientByIdealPowerAnnihilatorMap_mkQ {m n : ℕ} (h : m ≤ n) (x : M) :
    quotientByIdealPowerAnnihilatorMap A I M h
        ((Submodule.torsionBySet A M (I ^ m : Ideal A)).mkQ x) =
      (Submodule.torsionBySet A M (I ^ n : Ideal A)).mkQ x := rfl

/-- The value of the section attached to `φ` at a prime `p` is `y / gⁿ` for every `g ∈ I`
outside `p` and every lift `y` of `φ(gⁿ)`. -/
public lemma sectionOfQuotHom_val (n : ℕ)
    (φ : (I ^ n : Ideal A) →ₗ[A] M ⧸ Submodule.torsionBySet A M (I ^ n : Ideal A))
    (x : ↥(complementVanishing (ULift.{v} A) (liftedIdeal.{u, v} A I)))
    (g : A) (hgI : g ∈ I) (hg : (ULift.up.{v} g) ∉ (x.1 : PrimeSpectrum (ULift.{v} A)).asIdeal)
    (y : M)
    (hy : (Submodule.torsionBySet A M (I ^ n : Ideal A)).mkQ y =
      φ ⟨g ^ n, Ideal.pow_mem_pow hgI n⟩) :
    (sectionOfQuotHom A I M n φ).1 x =
      (LocalizedModule.mk (ULift.up.{u} y)
        ⟨(ULift.up.{v} g) ^ n, Submonoid.pow_mem _ hg n⟩ :
          Localizations (ULift.{u} M) x.1) := by
  have hgJ : (ULift.up.{v} g) ∈ liftedIdeal.{u, v} A I := (mem_liftedIdeal A I).mpr hgI
  have h1 := fractionSectionFun_apply (hU := exists_mem_liftedIdeal_notMem A I)
    (quotNumerator_cross A I M n φ) x ⟨ULift.up.{v} g, hgJ⟩ hg
  have h2 : quotNumerator A I M n φ ⟨ULift.up.{v} g, hgJ⟩ = ULift.up.{u} (g ^ n • y) :=
    quotNumerator_eq A I M n φ ⟨ULift.up.{v} g, hgJ⟩ hy
  change fractionSectionFun (exists_mem_liftedIdeal_notMem A I) (2 * n)
      (quotNumerator A I M n φ) x = _
  have h3 : (ULift.up.{u} (g ^ n • y) : ULift.{u} M) =
      ((ULift.up.{v} g) ^ n : ULift.{v} A) • ULift.up.{u} y := rfl
  rw [h1, h2, h3]
  refine LocalizedModule.mk_eq.mpr ⟨1, ?_⟩
  simp only [one_smul, Submonoid.smul_def, smul_smul, two_mul, pow_add]

/-- The numerators are additive in `φ`. -/
public lemma quotNumerator_add (n : ℕ)
    (φ ψ : (I ^ n : Ideal A) →ₗ[A] M ⧸ Submodule.torsionBySet A M (I ^ n : Ideal A)) :
    quotNumerator A I M n (φ + ψ) =
      fun a => quotNumerator A I M n φ a + quotNumerator A I M n ψ a := by
  funext a
  have ha : (a : ULift.{v} A).down ∈ I := (mem_liftedIdeal A I).mp a.2
  rw [quotNumerator_eq A I M n (φ + ψ) a
    (x := quotOut (φ ⟨(a : ULift.{v} A).down ^ n, Ideal.pow_mem_pow ha n⟩) +
      quotOut (ψ ⟨(a : ULift.{v} A).down ^ n, Ideal.pow_mem_pow ha n⟩))
    (by rw [map_add, mkQ_quotOut, mkQ_quotOut]; rfl)]
  simp only [quotNumerator, smul_add]
  rfl

/-- The numerators are compatible with the `A`-action on `φ`. -/
public lemma quotNumerator_smul (n : ℕ) (c : A)
    (φ : (I ^ n : Ideal A) →ₗ[A] M ⧸ Submodule.torsionBySet A M (I ^ n : Ideal A)) :
    quotNumerator A I M n (c • φ) =
      fun a => (ULift.up.{v} c) • quotNumerator A I M n φ a := by
  funext a
  have ha : (a : ULift.{v} A).down ∈ I := (mem_liftedIdeal A I).mp a.2
  rw [quotNumerator_eq A I M n (c • φ) a
    (x := c • quotOut (φ ⟨(a : ULift.{v} A).down ^ n, Ideal.pow_mem_pow ha n⟩))
    (by rw [map_smul, mkQ_quotOut]; rfl)]
  simp only [quotNumerator]
  refine ULift.ext _ _ ?_
  simp only [ULift.smul_def, ULift.smul_down]
  rw [smul_comm]

/-- The section attached to `φ` is additive in `φ`. -/
public lemma sectionOfQuotHom_add (n : ℕ)
    (φ ψ : (I ^ n : Ideal A) →ₗ[A] M ⧸ Submodule.torsionBySet A M (I ^ n : Ideal A)) :
    sectionOfQuotHom A I M n (φ + ψ) =
      sectionOfQuotHom A I M n φ + sectionOfQuotHom A I M n ψ := by
  refine Subtype.ext (funext fun x => ?_)
  change fractionSectionFun (exists_mem_liftedIdeal_notMem A I) (2 * n)
      (quotNumerator A I M n (φ + ψ)) x = _
  rw [quotNumerator_add]
  exact fractionSectionFun_add (quotNumerator A I M n φ) (quotNumerator A I M n ψ) x

/-- The section attached to `φ` commutes with the `A`-action on `φ`. -/
public lemma sectionOfQuotHom_smul (n : ℕ) (c : A)
    (φ : (I ^ n : Ideal A) →ₗ[A] M ⧸ Submodule.torsionBySet A M (I ^ n : Ideal A)) :
    sectionOfQuotHom A I M n (c • φ) = c • sectionOfQuotHom A I M n φ := by
  refine Subtype.ext (funext fun x => ?_)
  change fractionSectionFun (exists_mem_liftedIdeal_notMem A I) (2 * n)
      (quotNumerator A I M n (c • φ)) x = _
  rw [quotNumerator_smul]
  refine (fractionSectionFun_smul (ULift.up c) (quotNumerator A I M n φ) x).trans ?_
  exact (tilde_smul_val_apply (R := .of (ULift.{v} A))
    (ModuleCat.of (ULift.{v} A) (ULift.{u} M))
    (complementVanishing (ULift.{v} A) (liftedIdeal.{u, v} A I)) (ULift.up c)
    (sectionOfQuotHom A I M n φ) x).symm

/-- Enlarging the exponent does not change the section. -/
public lemma sectionOfQuotHom_map {m n : ℕ} (hmn : m ≤ n)
    (φ : (I ^ m : Ideal A) →ₗ[A] M ⧸ Submodule.torsionBySet A M (I ^ m : Ideal A)) :
    sectionOfQuotHom A I M n
        ((quotientByIdealPowerAnnihilatorMap A I M hmn).comp
          (φ.comp (Submodule.inclusion (Ideal.pow_le_pow_right hmn)))) =
      sectionOfQuotHom A I M m φ := by
  obtain ⟨k, rfl⟩ : ∃ k, n = m + k := ⟨n - m, by omega⟩
  refine Subtype.ext (funext fun x => ?_)
  refine fractionSectionFun_congr (fun a => ?_) x
  have ha : (a : ULift.{v} A).down ∈ I := (mem_liftedIdeal A I).mp a.2
  set α := (a : ULift.{v} A).down with hα
  set W := quotOut (φ ⟨α ^ m, Ideal.pow_mem_pow ha m⟩) with hW
  have hmk : (Submodule.torsionBySet A M (I ^ (m + k) : Ideal A)).mkQ (α ^ k • W) =
      (quotientByIdealPowerAnnihilatorMap A I M hmn).comp
        (φ.comp (Submodule.inclusion (Ideal.pow_le_pow_right hmn)))
        ⟨α ^ (m + k), Ideal.pow_mem_pow ha (m + k)⟩ := by
    rw [map_smul, ← quotientByIdealPowerAnnihilatorMap_mkQ A I M hmn, hW, mkQ_quotOut,
      ← map_smul, ← map_smul, pow_smul_mk_pow_eq ha rfl]
    rfl
  rw [quotNumerator_eq A I M (m + k) _ a hmk]
  refine ULift.ext _ _ ?_
  simp only [quotNumerator, ULift.smul_def, ULift.pow_down, ULift.smul_down]
  change α ^ (2 * m) • α ^ (m + k) • α ^ k • W = α ^ (2 * (m + k)) • α ^ m • W
  simp only [smul_smul, ← pow_add]
  congr 1
  ring

/-- The cocone on the direct system `n ↦ Hom_A(I ^ n, M / Mₙ)` formed by these sections. -/
public noncomputable def sectionsCoconeModuloAnnihilator :
    Cocone (idealPowersHomModuloAnnihilator A I M) where
  pt := sectionsOnComplement A I M
  ι :=
    { app n := ModuleCat.ofHom
        (X := ↥((idealPowersHomModuloAnnihilator A I M).obj n))
        (Y := ↥(sectionsOnComplement A I M))
        { toFun := sectionOfQuotHom A I M n
          map_add' := sectionOfQuotHom_add A I M n
          map_smul' := sectionOfQuotHom_smul A I M n }
      naturality {m n} g := by
        refine ModuleCat.hom_ext (LinearMap.ext fun φ => ?_)
        exact sectionOfQuotHom_map A I M (leOfHom g) φ }

/-- The canonical map `colim_n Hom_A(I ^ n, M / Mₙ) → Γ(Spec(A) \ V(I), M̃)` of
[Stacks, Tag 01PM]. -/
public noncomputable def canonicalMapModuloAnnihilator :
    colimit (idealPowersHomModuloAnnihilator A I M) ⟶ sectionsOnComplement A I M :=
  colimit.desc _ (sectionsCoconeModuloAnnihilator A I M)

/-- The canonical map evaluated on a colimit representative. -/
public lemma canonicalMapModuloAnnihilator_ι (n : ℕ)
    (φ : ↥((idealPowersHomModuloAnnihilator A I M).obj n)) :
    canonicalMapModuloAnnihilator A I M
        (colimit.ι (idealPowersHomModuloAnnihilator A I M) n φ) =
      sectionOfQuotHom A I M n φ := by
  have hdesc : colimit.ι (idealPowersHomModuloAnnihilator A I M) n ≫
      canonicalMapModuloAnnihilator A I M =
      (sectionsCoconeModuloAnnihilator A I M).ι.app n := colimit.ι_desc _ _
  rw [← ModuleCat.comp_apply, hdesc]
  rfl

end Section

/-!
### Local fractions
-/

section LocalFractions

/-- The fraction `X / gⁿ` in the localization at a prime where `g` does not vanish. -/
public noncomputable def fractionAt {R : CommRingCat.{w}} (N : ModuleCat.{w} R) (g : R) (n : ℕ)
    (X : N) (p : PrimeSpectrum.Top R) (hp : g ∉ p.asIdeal) : Localizations N p :=
  LocalizedModule.mk X ⟨g ^ n, Submonoid.pow_mem _ hp n⟩

/-- The value of `toOpen` at a point is the fraction with denominator `1`. -/
public lemma tilde_toOpen_val {R : CommRingCat.{w}} (N : ModuleCat.{w} R)
    (V : Opens (PrimeSpectrum.Top R))
    (m : N) (z : ↥V) :
    (AlgebraicGeometry.tilde.toOpen N V m).1 z = LocalizedModule.mk m 1 := rfl

/-- Restriction of sections of a tilde sheaf is restriction of functions. -/
public lemma tilde_map_val {R : CommRingCat.{w}} (N : ModuleCat.{w} R)
    {V W : Opens (PrimeSpectrum.Top R)}
    (h : W ≤ V) (t : (modulesSpecToSheaf.obj (tilde N)).presheaf.obj (Opposite.op V))
    (z : ↥W) :
    (((modulesSpecToSheaf.obj (tilde N)).presheaf.map (homOfLE h).op) t).1 z =
      t.1 ⟨z.1, h z.2⟩ := rfl

end LocalFractions

/-!
### Fractions on basic opens
-/

section BasicOpenFractions

variable {R : CommRingCat.{w}} (N : ModuleCat.{w} R)

/-- A section of `Ñ` on a basic open `D(g)` is a fraction: some power of `g` carries it into the
image of `N`. -/
public lemma exists_pow_smul_eq_toOpen (g : R)
    (τ : (modulesSpecToSheaf.obj (tilde N)).presheaf.obj
      (Opposite.op (PrimeSpectrum.basicOpen g))) :
    ∃ (k : ℕ) (X : N), (tilde.toOpen N (PrimeSpectrum.basicOpen g)).hom X = (g ^ k) • τ := by
  obtain ⟨⟨X, d⟩, hX⟩ := IsLocalizedModule.mk'_surjective (Submonoid.powers g)
    (tilde.toOpen N (PrimeSpectrum.basicOpen g)).hom τ
  obtain ⟨k, hk⟩ := d.2
  have hk' : (d : R) = g ^ k := hk.symm
  refine ⟨k, X, ?_⟩
  rw [← hk']
  simpa [Submonoid.smul_def] using (IsLocalizedModule.mk'_eq_iff).mp hX

/-- An element of `N` whose image in the sections on `D(g)` vanishes is killed by a power
of `g`. -/
public lemma exists_pow_smul_eq_zero_of_toOpen_eq_zero (g : R) (X : N)
    (h : (tilde.toOpen N (PrimeSpectrum.basicOpen g)).hom X = 0) :
    ∃ k : ℕ, (g ^ k) • X = 0 := by
  obtain ⟨d, hd⟩ := (IsLocalizedModule.eq_zero_iff (Submonoid.powers g)
    (tilde.toOpen N (PrimeSpectrum.basicOpen g)).hom).mp h
  obtain ⟨k, hk⟩ := d.2
  have hk' : (d : R) = g ^ k := hk.symm
  exact ⟨k, by rw [← hk']; simpa [Submonoid.smul_def] using hd⟩

/-- Restriction commutes with the map from `N` to the sections. -/
public lemma toOpen_restrict (V W : Opens (PrimeSpectrum.Top R)) (hWV : W ≤ V) (X : N) :
    ((modulesSpecToSheaf.obj (tilde N)).presheaf.map (homOfLE hWV).op)
        ((tilde.toOpen N V).hom X) =
      (tilde.toOpen N W).hom X :=
  ConcreteCategory.congr_hom (tilde.toOpen_res N V W (homOfLE hWV)) X

/-- Two fractions with the same restriction to the intersection of their basic opens have
numerators satisfying a cross relation after multiplying by a power of the product of the
denominators. -/
public lemma exists_pow_smul_cross (g h : R) (n : ℕ) (Xg Xh : N)
    (ρ : (modulesSpecToSheaf.obj (tilde N)).presheaf.obj
      (Opposite.op (PrimeSpectrum.basicOpen (g * h))))
    (hgX : (tilde.toOpen N (PrimeSpectrum.basicOpen (g * h))).hom Xg = (g ^ n) • ρ)
    (hhX : (tilde.toOpen N (PrimeSpectrum.basicOpen (g * h))).hom Xh = (h ^ n) • ρ) :
    ∃ k : ℕ, ((g * h) ^ k) • ((h ^ n) • Xg - (g ^ n) • Xh) = 0 := by
  refine exists_pow_smul_eq_zero_of_toOpen_eq_zero N (g * h) _ ?_
  rw [map_sub, map_smul, map_smul, hgX, hhX, smul_smul, smul_smul,
    mul_comm (h ^ n) (g ^ n), sub_self]

/-- The value of a section on `D(g)` at a point, read off from a fraction representing it. -/
public lemma val_eq_mk_of_pow_smul_eq_toOpen (g : R) (n : ℕ) (X : N)
    (τ : (modulesSpecToSheaf.obj (tilde N)).presheaf.obj
      (Opposite.op (PrimeSpectrum.basicOpen g)))
    (h : (tilde.toOpen N (PrimeSpectrum.basicOpen g)).hom X = (g ^ n) • τ)
    (z : ↥(PrimeSpectrum.basicOpen g)) (hz : g ∉ (z.1 : PrimeSpectrum.Top R).asIdeal) :
    τ.1 z = fractionAt N g n X z.1 hz := by
  have hval : LocalizedModule.mk X (1 : ↥(z.1 : PrimeSpectrum.Top R).asIdeal.primeCompl) =
      (g ^ n) • τ.1 z := by
    rw [← tilde_smul_val_apply N (PrimeSpectrum.basicOpen g) (g ^ n) τ z, ← h]
    exact tilde_toOpen_val N (PrimeSpectrum.basicOpen g) X z
  rw [fractionAt, IsLocalizedModule.mk_eq_mk']
  refine ((IsLocalizedModule.mk'_eq_iff (f := LocalizedModule.mkLinearMap _ N)).mpr ?_).symm
  simpa using hval

/-- A section of `Ñ` on `D(g)` all of whose values are the fraction `X / gⁿ` is that
fraction. -/
public lemma toOpen_eq_pow_smul_of_val (g : R) (n : ℕ) (X : N)
    (τ : (modulesSpecToSheaf.obj (tilde N)).presheaf.obj
      (Opposite.op (PrimeSpectrum.basicOpen g)))
    (hval : ∀ z : ↥(PrimeSpectrum.basicOpen g),
      τ.1 z = fractionAt N g n X z.1 ((PrimeSpectrum.mem_basicOpen g _).mp z.2)) :
    (tilde.toOpen N (PrimeSpectrum.basicOpen g)).hom X = (g ^ n) • τ := by
  refine Subtype.ext (funext fun z => ?_)
  rw [tilde_smul_val_apply N (PrimeSpectrum.basicOpen g) (g ^ n) τ z, hval z,
    tilde_toOpen_val N (PrimeSpectrum.basicOpen g) X z, fractionAt, LocalizedModule.smul'_mk]
  exact (LocalizedModule.mk_cancel
    (⟨g ^ n, Submonoid.pow_mem _ ((PrimeSpectrum.mem_basicOpen g _).mp z.2) n⟩ :
      (z.1 : PrimeSpectrum.Top R).asIdeal.primeCompl) X).symm

/-- Restriction of sections of a tilde sheaf along two inclusions is restriction along their
composite. -/
public lemma tilde_map_map {R : CommRingCat.{w}} (N : ModuleCat.{w} R)
    (V W Y : Opens (PrimeSpectrum.Top R)) (h1 : W ≤ V) (h2 : Y ≤ W)
    (t : (modulesSpecToSheaf.obj (tilde N)).presheaf.obj (Opposite.op V)) :
    ((modulesSpecToSheaf.obj (tilde N)).presheaf.map (homOfLE h2).op)
        (((modulesSpecToSheaf.obj (tilde N)).presheaf.map (homOfLE h1).op) t) =
      ((modulesSpecToSheaf.obj (tilde N)).presheaf.map (homOfLE (h2.trans h1)).op) t := rfl

end BasicOpenFractions

/-!
### The family of local fractions attached to a section
-/

section Surjectivity

variable (A : Type u) [CommRing A] (M : Type v) [AddCommGroup M] [Module A M]

/-- `ULift M` as a module over `ULift A`. -/
public abbrev liftedModuleCat : ModuleCat.{max u v} (CommRingCat.of (ULift.{v} A)) :=
  ModuleCat.of (ULift.{v} A) (ULift.{u} M)

variable (I : Ideal A)

/-- The restriction of a section away from `V(I)` to the basic open of an element of `I`. -/
public noncomputable def restrictBasicOpen (g : A) (hg : g ∈ I)
    (σ : sectionsOnComplement A I M) :
    (modulesSpecToSheaf.obj (tilde (liftedModuleCat A M))).presheaf.obj
      (Opposite.op (PrimeSpectrum.basicOpen (ULift.up.{v} g))) :=
  (modulesSpecToSheaf.obj (tilde (liftedModuleCat A M))).presheaf.map
    (homOfLE (basicOpen_le_complementVanishing (ULift.{v} A)
      (liftedIdeal.{u, v} A I) (ULift.up.{v} g) ((mem_liftedIdeal A I).mpr hg))).op σ

/-- The value of a restricted section is the value of the section. -/
public lemma restrictBasicOpen_val (g : A) (hg : g ∈ I) (σ : sectionsOnComplement A I M)
    (x : ↥(complementVanishing (ULift.{v} A) (liftedIdeal.{u, v} A I)))
    (hx : (ULift.up.{v} g) ∉ (x.1 : PrimeSpectrum.Top (CommRingCat.of (ULift.{v} A))).asIdeal) :
    (restrictBasicOpen A M I g hg σ).1 ⟨x.1, hx⟩ = σ.1 x := rfl

/-- A section of `M̃` away from `V(I)`, with `I` generated by a
finite set `s`, is on the basic open of each generator the fraction with denominator the `N`-th
power of that generator for a single exponent `N ≥ 1`, and the numerators satisfy the cross
relations exactly. -/
public lemma exists_fraction_family (s : Finset A) (hs : Ideal.span (s : Set A) = I)
    (σ : sectionsOnComplement A I M) :
    ∃ (N : ℕ) (y : ↥s → M), 1 ≤ N ∧
      (∀ i j : ↥s, ((j : A) ^ N) • y i = ((i : A) ^ N) • y j) ∧
      ∀ (i : ↥s) (x : ↥(complementVanishing (ULift.{v} A) (liftedIdeal.{u, v} A I)))
        (hx : (ULift.up.{v} (i : A)) ∉
          (x.1 : PrimeSpectrum.Top (CommRingCat.of (ULift.{v} A))).asIdeal),
        σ.1 x = fractionAt (liftedModuleCat A M)
          (ULift.up.{v} (i : A)) N (ULift.up.{u} (y i)) x.1 hx := by
  classical
  have hmemI : ∀ i : ↥s, (i : A) ∈ I := fun i => hs ▸ Ideal.subset_span i.2
  have step1 : ∀ i : ↥s, ∃ (k : ℕ) (X : ULift.{u} M),
      (tilde.toOpen (liftedModuleCat A M)
          (PrimeSpectrum.basicOpen (ULift.up.{v} (i : A)))).hom X =
        ((ULift.up.{v} (i : A)) ^ k) • restrictBasicOpen A M I (i : A) (hmemI i) σ :=
    fun i => exists_pow_smul_eq_toOpen (liftedModuleCat A M) (ULift.up.{v} (i : A))
      (restrictBasicOpen A M I (i : A) (hmemI i) σ)
  choose k X hX using step1
  set n := Finset.univ.sup k + 1 with hn
  have hn1 : 1 ≤ n := by omega
  have hkn : ∀ i, k i ≤ n := fun i =>
    le_trans (Finset.le_sup (f := k) (Finset.mem_univ i)) (Nat.le_succ _)
  set X' : ↥s → ULift.{u} M :=
    fun i => ((ULift.up.{v} (i : A)) ^ (n - k i)) • X i with hX'
  have hX2 : ∀ i : ↥s,
      (tilde.toOpen (liftedModuleCat A M)
          (PrimeSpectrum.basicOpen (ULift.up.{v} (i : A)))).hom (X' i) =
        ((ULift.up.{v} (i : A)) ^ n) • restrictBasicOpen A M I (i : A) (hmemI i) σ := by
    intro i
    rw [hX', map_smul, hX i, smul_smul, ← pow_add, Nat.sub_add_cancel (hkn i)]
  have hres : ∀ (i : ↥s) (W : Opens (PrimeSpectrum.Top (CommRingCat.of (ULift.{v} A))))
      (hW : W ≤ PrimeSpectrum.basicOpen (ULift.up.{v} (i : A))),
      (tilde.toOpen (liftedModuleCat A M) W).hom (X' i) =
        ((ULift.up.{v} (i : A)) ^ n) •
          ((modulesSpecToSheaf.obj (tilde (liftedModuleCat A M))).presheaf.map (homOfLE hW).op)
            (restrictBasicOpen A M I (i : A) (hmemI i) σ) := by
    intro i W hW
    rw [← toOpen_restrict (liftedModuleCat A M) _ W hW (X' i), hX2 i]
    exact ((modulesSpecToSheaf.obj (tilde (liftedModuleCat A M))).presheaf.map
      (homOfLE hW).op).hom.map_smul _ _
  have hcross : ∀ i j : ↥s, ∃ m : ℕ,
      (((ULift.up.{v} (i : A)) * (ULift.up.{v} (j : A))) ^ m) •
        (((ULift.up.{v} (j : A)) ^ n) • X' i - ((ULift.up.{v} (i : A)) ^ n) • X' j) = 0 := by
    intro i j
    exact exists_pow_smul_cross (liftedModuleCat A M)
      (ULift.up.{v} (i : A)) (ULift.up.{v} (j : A)) n (X' i) (X' j) _
      (hres i _ (PrimeSpectrum.basicOpen_mul_le_left _ _))
      (hres j _ (PrimeSpectrum.basicOpen_mul_le_right _ _))
  choose m hm using hcross
  set q := Finset.univ.sup (fun p : ↥s × ↥s => m p.1 p.2) with hq
  have hmq : ∀ i j, m i j ≤ q := fun i j =>
    Finset.le_sup (f := fun p : ↥s × ↥s => m p.1 p.2) (Finset.mem_univ (i, j))
  have hmq' : ∀ i j : ↥s,
      (((ULift.up.{v} (i : A)) * (ULift.up.{v} (j : A))) ^ q) •
        (((ULift.up.{v} (j : A)) ^ n) • X' i - ((ULift.up.{v} (i : A)) ^ n) • X' j) = 0 := by
    intro i j
    have := hm i j
    rw [← Nat.sub_add_cancel (hmq i j), pow_add, mul_smul, this, smul_zero]
  refine ⟨n + q, fun i => (((ULift.up.{v} (i : A)) ^ q) • X' i).down,
    le_trans hn1 (Nat.le_add_right _ _), ?_, ?_⟩
  · intro i j
    have h0 := hmq' i j
    rw [smul_sub, sub_eq_zero] at h0
    simp only [mul_pow, smul_smul] at h0
    have h1 : (((ULift.up.{v} (j : A)) ^ (n + q)) • (((ULift.up.{v} (i : A)) ^ q) • X' i)) =
        (((ULift.up.{v} (i : A)) ^ (n + q)) • (((ULift.up.{v} (j : A)) ^ q) • X' j)) := by
      simp only [smul_smul]
      rw [show (ULift.up.{v} (j : A)) ^ (n + q) * (ULift.up.{v} (i : A)) ^ q =
          (ULift.up.{v} (i : A)) ^ q * (ULift.up.{v} (j : A)) ^ q *
            (ULift.up.{v} (j : A)) ^ n from by ring,
        show (ULift.up.{v} (i : A)) ^ (n + q) * (ULift.up.{v} (j : A)) ^ q =
          (ULift.up.{v} (i : A)) ^ q * (ULift.up.{v} (j : A)) ^ q *
            (ULift.up.{v} (i : A)) ^ n from by ring]
      exact h0
    simpa using congrArg ULift.down h1
  · intro i x hx
    have hX3 : (tilde.toOpen (liftedModuleCat A M)
        (PrimeSpectrum.basicOpen (ULift.up.{v} (i : A)))).hom
          (((ULift.up.{v} (i : A)) ^ q) • X' i) =
        ((ULift.up.{v} (i : A)) ^ (n + q)) • restrictBasicOpen A M I (i : A) (hmemI i) σ := by
      rw [map_smul, hX2 i, smul_smul, ← pow_add]
      congr 2
      omega
    have hval := val_eq_mk_of_pow_smul_eq_toOpen (liftedModuleCat A M)
      (ULift.up.{v} (i : A)) (n + q) (((ULift.up.{v} (i : A)) ^ q) • X' i)
      (restrictBasicOpen A M I (i : A) (hmemI i) σ) hX3 ⟨x.1, hx⟩ hx
    rw [restrictBasicOpen_val A M I (i : A) (hmemI i) σ x hx] at hval
    rw [hval]

/-- Every point of `Spec(A) \ V(I)` lies outside one of the generators of `I`. -/
private lemma exists_generator_notMem (s : Finset A) (hs : Ideal.span (s : Set A) = I)
    (x : ↥(complementVanishing (ULift.{v} A) (liftedIdeal.{u, v} A I))) :
    ∃ i : ↥s, (ULift.up.{v} (i : A)) ∉
      (x.1 : PrimeSpectrum.Top (CommRingCat.of (ULift.{v} A))).asIdeal := by
  by_contra hcon
  simp only [not_exists, not_not] at hcon
  refine x.2 ?_
  intro a ha
  have hdown : (a : ULift.{v} A).down ∈ Ideal.span (s : Set A) := by
    rw [hs]
    exact (mem_liftedIdeal A I).mp ha
  have hsub : (s : Set A) ⊆
      ((x.1 : PrimeSpectrum.Top (CommRingCat.of (ULift.{v} A))).asIdeal.comap
        (ULift.ringEquiv (R := A)).symm.toRingHom : Ideal A) := by
    intro b hb
    exact hcon ⟨b, hb⟩
  have h2 : ((ULift.ringEquiv (R := A)).symm.toRingHom (a : ULift.{v} A).down) ∈
      (x.1 : PrimeSpectrum.Top (CommRingCat.of (ULift.{v} A))).asIdeal :=
    Ideal.mem_comap.mp (Ideal.span_le.mpr hsub hdown)
  exact h2

/-- For a finitely generated ideal every section of `M̃` on
`Spec(A) \ V(I)` is in the image of the canonical map. -/
public lemma canonicalMapModuloAnnihilator_surjective (hI : I.FG) :
    Function.Surjective (canonicalMapModuloAnnihilator A I M) := by
  classical
  intro σ
  obtain ⟨s, hs, hcard⟩ := exists_finset_span_eq_of_fg hI
  have hmemI : ∀ i : ↥s, (i : A) ∈ I := fun i => hs ▸ Ideal.subset_span i.2
  obtain ⟨N, y, hN1, hy, hyval⟩ := exists_fraction_family A M I s hs σ
  set K := s.card * (N - 1) + 1 with hK
  obtain ⟨hKN, hIK⟩ : N ≤ K ∧
      (I ^ K : Ideal A) ≤ Ideal.span ((fun b : A => b ^ N) '' (s : Set A)) :=
    le_card_mul_pred_add_one_and_pow_le hs hcard hN1
  set L : (↥s → A) →ₗ[A] A := ∑ i : ↥s, (LinearMap.proj i).smulRight ((i : A) ^ N) with hLdef
  set Q := Submodule.torsionBySet A M (I ^ K : Ideal A) with hQ
  set V : (↥s → A) →ₗ[A] M ⧸ Q :=
    ∑ i : ↥s, (LinearMap.proj i).smulRight (Q.mkQ (y i)) with hVdef
  have hL : ∀ c : ↥s → A, L c = ∑ i : ↥s, c i * (i : A) ^ N := by
    intro c
    rw [hLdef, LinearMap.sum_apply]
    rfl
  have hV : ∀ c : ↥s → A, V c = Q.mkQ (∑ i : ↥s, c i • y i) := by
    intro c
    rw [hVdef, LinearMap.sum_apply, map_sum]
    rfl
  have hrange : (I ^ K : Ideal A) ≤ LinearMap.range L := by
    refine le_trans hIK (Ideal.span_le.mpr ?_)
    rintro a ⟨b, hb, rfl⟩
    exact ⟨Pi.single ⟨b, hb⟩ 1, by simp [hL, Pi.single_apply]⟩
  have hker : LinearMap.ker L ≤ LinearMap.ker V := by
    intro c hc
    have hc' : (∑ i : ↥s, c i * (i : A) ^ N) = 0 := by rw [← hL]; exact hc
    have hz : ∀ j : ↥s, ((j : A) ^ N) • (∑ i : ↥s, c i • y i) = 0 := by
      intro j
      calc ((j : A) ^ N) • (∑ i : ↥s, c i • y i)
          = ∑ i : ↥s, c i • (((j : A) ^ N) • y i) := by
            rw [Finset.smul_sum]
            exact Finset.sum_congr rfl fun i _ => smul_comm _ _ _
        _ = ∑ i : ↥s, c i • (((i : A) ^ N) • y j) :=
            Finset.sum_congr rfl fun i _ => by rw [hy i j]
        _ = (∑ i : ↥s, c i * (i : A) ^ N) • y j := by
            rw [Finset.sum_smul]
            exact Finset.sum_congr rfl fun i _ => smul_smul _ _ _
        _ = 0 := by rw [hc', zero_smul]
    have hmem : (∑ i : ↥s, c i • y i) ∈ Q := by
      rw [hQ, Submodule.mem_torsionBySet_iff]
      intro a
      have ha : (a : A) ∈ Ideal.span ((fun b : A => b ^ N) '' (s : Set A)) :=
        hIK (SetLike.mem_coe.mp a.2)
      have hann : Ideal.span ((fun b : A => b ^ N) '' (s : Set A)) ≤
          (Submodule.span A {∑ i : ↥s, c i • y i}).annihilator := by
        rw [Ideal.span_le]
        rintro b ⟨j, hj, rfl⟩
        exact (Submodule.mem_annihilator_span_singleton _ _).mpr (hz ⟨j, hj⟩)
      exact (Submodule.mem_annihilator_span_singleton _ _).mp (hann ha)
    rw [LinearMap.mem_ker, hV]
    exact (Submodule.Quotient.mk_eq_zero _).mpr hmem
  set φ : (I ^ K : Ideal A) →ₗ[A] M ⧸ Q :=
    ((LinearMap.ker L).liftQ V hker).comp
      ((L.quotKerEquivRange.symm.toLinearMap).comp (Submodule.inclusion hrange)) with hφdef
  have hφ : ∀ (c : ↥s → A) (h : L c ∈ (I ^ K : Ideal A)), φ ⟨L c, h⟩ = V c := by
    intro c h
    rw [hφdef]
    change ((LinearMap.ker L).liftQ V hker) (L.quotKerEquivRange.symm ⟨L c, hrange h⟩) = V c
    rw [LinearMap.quotKerEquivRange_symm_apply_image, Submodule.mkQ_apply,
      Submodule.liftQ_apply]
  refine ⟨colimit.ι (idealPowersHomModuloAnnihilator A I M) K φ, ?_⟩
  refine Eq.trans (canonicalMapModuloAnnihilator_ι A I M K φ) ?_
  refine Subtype.ext (funext fun x => ?_)
  obtain ⟨i, hi⟩ := exists_generator_notMem A I s hs x
  have hc : L (Pi.single i ((i : A) ^ (K - N))) = (i : A) ^ K := by
    rw [hL]
    simp only [Pi.single_apply, ite_mul, zero_mul, Finset.sum_ite_eq', Finset.mem_univ, ite_true,
      ← pow_add, Nat.sub_add_cancel hKN]
  have hsum : (∑ j : ↥s, (Pi.single i ((i : A) ^ (K - N)) : ↥s → A) j • y j) =
      ((i : A) ^ (K - N)) • y i := by
    simp [Pi.single_apply]
  have hmem2 : L (Pi.single i ((i : A) ^ (K - N))) ∈ (I ^ K : Ideal A) := by
    rw [hc]
    exact Ideal.pow_mem_pow (hmemI i) K
  have hlift : Q.mkQ (((i : A) ^ (K - N)) • y i) =
      φ ⟨(i : A) ^ K, Ideal.pow_mem_pow (hmemI i) K⟩ := by
    calc Q.mkQ (((i : A) ^ (K - N)) • y i)
        = V (Pi.single i ((i : A) ^ (K - N))) := by rw [hV, hsum]
      _ = φ ⟨L (Pi.single i ((i : A) ^ (K - N))), hmem2⟩ := (hφ _ hmem2).symm
      _ = φ ⟨(i : A) ^ K, Ideal.pow_mem_pow (hmemI i) K⟩ := congrArg φ (Subtype.ext hc)
  rw [sectionOfQuotHom_val A I M K φ x (i : A) (hmemI i) hi (((i : A) ^ (K - N)) • y i) hlift,
    hyval i x hi, fractionAt]
  refine LocalizedModule.mk_eq.mpr ⟨1, ?_⟩
  refine ULift.ext _ _ ?_
  simp only [Submonoid.smul_def, one_smul, ULift.smul_def, ULift.pow_down, ULift.smul_down,
    smul_smul, ← pow_add]
  rw [Nat.add_sub_cancel' hKN]

end Surjectivity

/-!
### Injectivity
-/

section Injectivity

variable (A : Type u) [CommRing A] (M : Type v) [AddCommGroup M] [Module A M] (I : Ideal A)

/-- Every element of the colimit of `idealPowersHomModuloAnnihilator A I M` is the image of an
element of one of its terms. -/
public lemma exists_colimit_ι_eq
    (e : ↥(colimit (idealPowersHomModuloAnnihilator A I M))) :
    ∃ (n : ℕ) (φ : (I ^ n : Ideal A) →ₗ[A]
        M ⧸ Submodule.torsionBySet A M (I ^ n : Ideal A)),
      colimit.ι (idealPowersHomModuloAnnihilator A I M) n φ = e := by
  classical
  have hmono : Monotone (fun n : ℕ =>
      LinearMap.range (colimit.ι (idealPowersHomModuloAnnihilator A I M) n).hom) := by
    intro n k hnk
    rintro x ⟨φ, rfl⟩
    refine ⟨(idealPowersHomModuloAnnihilator A I M).map (homOfLE hnk) φ, ?_⟩
    rw [← ModuleCat.comp_apply, colimit.w]
  have hleg : ∀ (n : ℕ) (φ : ↥((idealPowersHomModuloAnnihilator A I M).obj n)),
      (colimit.ι (idealPowersHomModuloAnnihilator A I M) n) φ ∈
        (⨆ n : ℕ, LinearMap.range
          (colimit.ι (idealPowersHomModuloAnnihilator A I M) n).hom) :=
    fun n φ => le_iSup (fun n : ℕ => LinearMap.range
      (colimit.ι (idealPowersHomModuloAnnihilator A I M) n).hom) n ⟨φ, rfl⟩
  let c : Cocone (idealPowersHomModuloAnnihilator A I M) :=
    { pt := ModuleCat.of A ↥(⨆ n : ℕ, LinearMap.range
        (colimit.ι (idealPowersHomModuloAnnihilator A I M) n).hom)
      ι :=
        { app := fun n => ModuleCat.ofHom
            ((colimit.ι (idealPowersHomModuloAnnihilator A I M) n).hom.codRestrict _ (hleg n))
          naturality := fun {n k} f => by
            refine ModuleCat.hom_ext (LinearMap.ext fun φ => ?_)
            refine Subtype.ext ?_
            change (colimit.ι (idealPowersHomModuloAnnihilator A I M) k)
              ((idealPowersHomModuloAnnihilator A I M).map f φ) =
              (colimit.ι (idealPowersHomModuloAnnihilator A I M) n) φ
            rw [← ModuleCat.comp_apply, colimit.w] } }
  have hid : (colimit.desc (idealPowersHomModuloAnnihilator A I M) c) ≫
      ModuleCat.ofHom (Submodule.subtype (⨆ n : ℕ, LinearMap.range
        (colimit.ι (idealPowersHomModuloAnnihilator A I M) n).hom)) =
      𝟙 (colimit (idealPowersHomModuloAnnihilator A I M)) := by
    refine colimit.hom_ext fun n => ?_
    rw [← Category.assoc, colimit.ι_desc, Category.comp_id]
    rfl
  have hmem : e ∈ (⨆ n : ℕ, LinearMap.range
      (colimit.ι (idealPowersHomModuloAnnihilator A I M) n).hom) := by
    have h1 := ConcreteCategory.congr_hom hid e
    rw [ModuleCat.id_apply] at h1
    rw [← h1]
    exact ((colimit.desc (idealPowersHomModuloAnnihilator A I M) c) e).2
  obtain ⟨n, φ, hφ⟩ :=
    (Submodule.mem_iSup_of_directed _ (Monotone.directed_le hmono)).mp hmem
  exact ⟨n, φ, hφ⟩

/-- For a finitely generated ideal the canonical map out of the direct limit is
injective. -/
public lemma canonicalMapModuloAnnihilator_injective (hI : I.FG) :
    Function.Injective (canonicalMapModuloAnnihilator A I M) := by
  classical
  refine (injective_iff_map_eq_zero (canonicalMapModuloAnnihilator A I M).hom).mpr ?_
  intro e he
  obtain ⟨n, φ, rfl⟩ := exists_colimit_ι_eq A M I e
  rw [canonicalMapModuloAnnihilator_ι A I M n φ] at he
  obtain ⟨s, hs, hcard⟩ := exists_finset_span_eq_of_fg hI
  have hmemI : ∀ i : ↥s, (i : A) ∈ I := fun i => hs ▸ Ideal.subset_span i.2
  have hvan : ∀ i : ↥s, ∃ k : ℕ,
      ((i : A) ^ k) • quotOut (φ ⟨(i : A) ^ n, Ideal.pow_mem_pow (hmemI i) n⟩) = 0 := by
    intro i
    have hvalz : ∀ z : ↥(PrimeSpectrum.basicOpen (ULift.up.{v} (i : A))),
        (restrictBasicOpen A M I (i : A) (hmemI i) (sectionOfQuotHom A I M n φ)).1 z =
          fractionAt (liftedModuleCat A M) (ULift.up.{v} (i : A)) n
            (ULift.up.{u} (quotOut (φ ⟨(i : A) ^ n, Ideal.pow_mem_pow (hmemI i) n⟩))) z.1
            ((PrimeSpectrum.mem_basicOpen _ _).mp z.2) := by
      intro z
      have hz : (ULift.up.{v} (i : A)) ∉
          (z.1 : PrimeSpectrum.Top (CommRingCat.of (ULift.{v} A))).asIdeal :=
        (PrimeSpectrum.mem_basicOpen _ _).mp z.2
      have hzU : z.1 ∈ complementVanishing (ULift.{v} A) (liftedIdeal.{u, v} A I) :=
        basicOpen_le_complementVanishing (ULift.{v} A) (liftedIdeal.{u, v} A I)
          (ULift.up.{v} (i : A)) ((mem_liftedIdeal A I).mpr (hmemI i)) z.2
      exact (restrictBasicOpen_val A M I (i : A) (hmemI i) (sectionOfQuotHom A I M n φ)
          ⟨z.1, hzU⟩ hz).symm.trans
        (sectionOfQuotHom_val A I M n φ ⟨z.1, hzU⟩ (i : A) (hmemI i) hz _
          (mkQ_quotOut _))
    have hzero : (tilde.toOpen (liftedModuleCat A M)
        (PrimeSpectrum.basicOpen (ULift.up.{v} (i : A)))).hom
          (ULift.up.{u} (quotOut (φ ⟨(i : A) ^ n, Ideal.pow_mem_pow (hmemI i) n⟩))) = 0 := by
      rw [toOpen_eq_pow_smul_of_val (liftedModuleCat A M) (ULift.up.{v} (i : A)) n
        (ULift.up.{u} (quotOut (φ ⟨(i : A) ^ n, Ideal.pow_mem_pow (hmemI i) n⟩)))
        (restrictBasicOpen A M I (i : A) (hmemI i) (sectionOfQuotHom A I M n φ)) hvalz]
      have hr0 : restrictBasicOpen A M I (i : A) (hmemI i)
          (sectionOfQuotHom A I M n φ) = 0 := by
        rw [restrictBasicOpen, he]
        exact map_zero _
      rw [hr0, smul_zero]
    obtain ⟨k, hk⟩ := exists_pow_smul_eq_zero_of_toOpen_eq_zero (liftedModuleCat A M)
      (ULift.up.{v} (i : A)) _ hzero
    refine ⟨k, ?_⟩
    have := congrArg ULift.down hk
    simpa using this
  choose k hk using hvan
  set d := Finset.univ.sup k + n + 1 with hd
  have hd1 : 1 ≤ d := by omega
  have hdn : ∀ i : ↥s, k i + n ≤ d := by
    intro i
    have := Finset.le_sup (f := k) (Finset.mem_univ i)
    omega
  have hφvan : ∀ i : ↥s, φ ⟨(i : A) ^ d, Ideal.pow_le_pow_right (by omega)
      (Ideal.pow_mem_pow (hmemI i) d)⟩ = 0 := by
    intro i
    rw [← pow_smul_mk_pow_eq (hmemI i) (show n + (d - n) = d by omega), map_smul,
      ← mkQ_quotOut (φ ⟨(i : A) ^ n, Ideal.pow_mem_pow (hmemI i) n⟩),
      ← map_smul]
    have : ((i : A) ^ (d - n)) •
        quotOut (φ ⟨(i : A) ^ n, Ideal.pow_mem_pow (hmemI i) n⟩) = 0 := by
      have hge : k i ≤ d - n := by have := hdn i; omega
      rw [← Nat.sub_add_cancel hge, pow_add, mul_smul, hk i, smul_zero]
    rw [this, map_zero]
  set K := s.card * (d - 1) + 1 with hK
  obtain ⟨hKd, hIK⟩ : d ≤ K ∧
      (I ^ K : Ideal A) ≤ Ideal.span ((fun b : A => b ^ d) '' (s : Set A)) :=
    le_card_mul_pred_add_one_and_pow_le hs hcard hd1
  have hnK : n ≤ K := by omega
  have hZ : ∀ a ∈ (I ^ K : Ideal A), ∀ h : a ∈ (I ^ n : Ideal A), φ ⟨a, h⟩ = 0 := by
    have hsub : Ideal.span ((fun b : A => b ^ d) '' (s : Set A)) ≤
        Submodule.map ((I ^ n : Ideal A).subtype) (LinearMap.ker φ) := by
      rw [Ideal.span_le]
      rintro _ ⟨j, hj, rfl⟩
      exact ⟨⟨j ^ d, Ideal.pow_le_pow_right (show n ≤ d by omega)
        (Ideal.pow_mem_pow (hmemI ⟨j, hj⟩) d)⟩, hφvan ⟨j, hj⟩, rfl⟩
    intro a ha h
    obtain ⟨c, hc, hca⟩ := hsub (hIK ha)
    have : (⟨a, h⟩ : ↥(I ^ n : Ideal A)) = c := (Subtype.ext hca.symm)
    rw [this]
    exact hc
  have hmapzero : (idealPowersHomModuloAnnihilator A I M).map (homOfLE hnK) φ = 0 := by
    refine LinearMap.ext fun x => ?_
    change quotientByIdealPowerAnnihilatorMap A I M hnK
      (φ ⟨(x : A), Ideal.pow_le_pow_right hnK x.2⟩) = 0
    rw [hZ (x : A) (SetLike.mem_coe.mp x.2) (Ideal.pow_le_pow_right hnK x.2)]
    exact map_zero _
  have hstep : colimit.ι (idealPowersHomModuloAnnihilator A I M) n φ =
      colimit.ι (idealPowersHomModuloAnnihilator A I M) K
        ((idealPowersHomModuloAnnihilator A I M).map (homOfLE hnK) φ) := by
    refine Eq.trans (ConcreteCategory.congr_hom
      (colimit.w (idealPowersHomModuloAnnihilator A I M) (homOfLE hnK)) φ).symm ?_
    exact ModuleCat.comp_apply ((idealPowersHomModuloAnnihilator A I M).map (homOfLE hnK))
      (colimit.ι (idealPowersHomModuloAnnihilator A I M) K) φ
  rw [hstep, hmapzero]
  exact map_zero _

end Injectivity

/-!
### The isomorphism
-/

section Isomorphism

variable (A : Type u) [CommRing A] (M : Type v) [AddCommGroup M] [Module A M] (I : Ideal A)

/-- **Stacks Project, Tag 01PM (`general_isomorphism`).** For a finitely generated ideal `I`
the canonical map from the direct limit of `Hom_A(I ^ n, M / Mₙ)` to the sections of `M̃` on
`Spec(A) \ V(I)` is bijective. -/
@[stacks 01PM "general_isomorphism"]
public lemma canonicalMapModuloAnnihilator_bijective (hI : I.FG) :
    Function.Bijective (canonicalMapModuloAnnihilator A I M) :=
  ⟨canonicalMapModuloAnnihilator_injective A M I hI,
    canonicalMapModuloAnnihilator_surjective A M I hI⟩

/-- **Stacks Project, Tag 01PM (`general_isomorphism`).** For a finitely generated ideal `I`,
the direct limit of `Hom_A(I ^ n, M / Mₙ)` is canonically isomorphic to the sections of `M̃`
on `Spec(A) \ V(I)`. -/
@[stacks 01PM "general_isomorphism"]
public noncomputable def idealPowersHomModuloAnnihilatorColimitIsoSections (hI : I.FG) :
    colimit (idealPowersHomModuloAnnihilator A I M) ≅ sectionsOnComplement A I M :=
  have h : IsIso (canonicalMapModuloAnnihilator A I M) :=
    (ConcreteCategory.isIso_iff_bijective _).mpr
      (canonicalMapModuloAnnihilator_bijective A M I hI)
  @asIso _ _ _ _ (canonicalMapModuloAnnihilator A I M) h

end Isomorphism

