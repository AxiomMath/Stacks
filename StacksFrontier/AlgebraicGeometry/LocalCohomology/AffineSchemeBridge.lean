module

public import StacksFrontier.AlgebraicGeometry.LocalCohomology.CanonicalSectionsSurjective
public import StacksFrontier.AlgebraicGeometry.LocalCohomology.IdealPowerQuotientIso

/-!
# Cross-related families on an affine chart

Let `X` be a scheme, let `I` be a quasi-coherent sheaf of ideals and let `F` be a quasi-coherent
`𝒪_X`-module. On an affine chart `U` on which the ideal is generated by a finite family `a`, a
family `m : ι → Γ(F, U)` satisfying the cross relations `(a j) ^ k • m i = (a i) ^ k • m j`
defines a homomorphism out of a power of the ideal into the quotient of `Γ(F, U)` by the sections
annihilated by that power, and it is the family of numerators of a unique section of `F` over
`U ∖ V(I)`, the image under `fromSpec` of the complement of the vanishing locus of `I(U)`.

## Main definitions

* `Stacks.LocalCohomology.powerSpan`: the ideal generated by the `k`-th powers of a family.

## Main results

* `Stacks.LocalCohomology.exists_linearMap_of_cross_relations`: a family satisfying the cross
  relations defines an `A`-linear map from the ideal generated by the `k`-th powers of the
  generators to the quotient of `M` by the submodule annihilated by that ideal, characterised by
  `(a i) ^ k • φ x = x • m i`.
* `Stacks.LocalCohomology.exists_idealPow_linearMap_of_cross_relations`: the same map, restricted
  to a power of the ideal generated by the family and pushed into the quotient by the sections
  annihilated by that power.
* `Stacks.LocalCohomology.exists_linearMap_of_cross_relations_of_torsionFree`: if no nonzero
  element of `M` is annihilated by the ideal generated by the `k`-th powers, the map lands in `M`
  itself.
* `Stacks.LocalCohomology.smul_eq_zero_of_pow_smul_eq_zero` and
  `Stacks.LocalCohomology.eq_zero_of_idealPow_smul_eq_zero`: an element annihilated by every
  `(a i) ^ k` is annihilated by the ideal they generate, and if no nonzero element is annihilated
  by an ideal, none is annihilated by a power of it.
* `Stacks.LocalCohomology.fromSpec_preimage_idealComplement` and
  `Stacks.LocalCohomology.fromSpec_image_compl_zeroLocus`: the open `U ∖ V(I)` of an affine chart
  is the image under `fromSpec` of the complement of the vanishing locus of `I(U)`.
* `Stacks.LocalCohomology.exists_section_of_compatible_family` and
  `Stacks.LocalCohomology.eq_of_pow_smul_restrict_eq`: on an affine chart, a family satisfying
  the cross relations determines one and only one section of `F` over `U ∖ V(I)` whose multiples
  by `(a i) ^ k` are the `m i`.

## References

* [Stacks Project, Tag 01PM](https://stacks.math.columbia.edu/tag/01PM)
* [Stacks Project, Tag 01YB](https://stacks.math.columbia.edu/tag/01YB)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.AlgebraicGeometry
open Stacks.AlgebraicGeometry.IdealPower
open Stacks.AlgebraicGeometry.IdealPowerSections
open Stacks.AlgebraicGeometry.QuasicoherentBaseChange

universe u v w

namespace Stacks.LocalCohomology

noncomputable section

/-! ### The ideal generated by the powers of a family -/

section Algebra

variable {A : Type u} [CommRing A] {M : Type v} [AddCommGroup M] [Module A M]

/-- The ideal generated by the `k`-th powers of the members of a family. -/
public def powerSpan {ι : Type w} (a : ι → A) (k : ℕ) : Ideal A :=
  Ideal.span ((fun x : A => x ^ k) '' Set.range a)

/-- Each `k`-th power of a member of the family lies in the ideal they generate. -/
public lemma pow_mem_powerSpan {ι : Type w} (a : ι → A) (k : ℕ) (i : ι) :
    a i ^ k ∈ powerSpan a k :=
  Ideal.subset_span ⟨a i, ⟨i, rfl⟩, rfl⟩

/-- The ideal generated by the `k`-th powers of a family is the span of the range of
`fun i => a i ^ k`. -/
public lemma powerSpan_eq_span_range {ι : Type w} (a : ι → A) (k : ℕ) :
    powerSpan a k = Ideal.span (Set.range fun i => a i ^ k) := by
  rw [powerSpan, ← Set.range_comp]
  rfl

/-- A high enough power of the ideal generated by a family lies in the ideal generated by the
`k`-th powers of its members: if `s` is a finite set with the same members as the family and
`1 ≤ k`, the power with exponent `s.card * (k - 1) + 1` does. -/
public lemma idealPow_le_powerSpan {ι : Type w} (a : ι → A) (k : ℕ) (hk : 1 ≤ k)
    (s : Finset A) (hs : (s : Set A) = Set.range a) :
    (Ideal.span (Set.range a)) ^ (s.card * (k - 1) + 1) ≤ powerSpan a k := by
  have h := span_pow_le_span_image_pow (A := A) k hk s
  rwa [hs] at h

/-- If every `(a i) ^ k` annihilates `y`, so does every element of the ideal they generate. -/
public lemma smul_eq_zero_of_pow_smul_eq_zero {ι : Type w} (a : ι → A) (k : ℕ) (y : M)
    (hy : ∀ i, a i ^ k • y = 0) : ∀ b ∈ powerSpan a k, b • y = 0 := by
  have hmem : y ∈ Submodule.torsionBySet A M (powerSpan a k : Set A) := by
    rw [powerSpan, ← Submodule.torsionBySet_eq_torsionBySet_span,
      Submodule.mem_torsionBySet_iff]
    rintro ⟨z, hz⟩
    obtain ⟨w, ⟨i, rfl⟩, rfl⟩ := hz
    exact hy i
  intro b hb
  exact (Submodule.mem_torsionBySet_iff _ _).mp hmem ⟨b, hb⟩

/-- If no nonzero element of `M` is annihilated by an ideal, none is annihilated by a power of
that ideal. -/
public lemma eq_zero_of_idealPow_smul_eq_zero (J : Ideal A)
    (htf : ∀ y : M, (∀ b ∈ J, b • y = 0) → y = 0) (N : ℕ) (y : M)
    (hy : ∀ b ∈ (J ^ N : Ideal A), b • y = 0) : y = 0 := by
  induction N generalizing y with
  | zero =>
    simpa using hy 1 (by simp)
  | succ n ih =>
    refine ih y fun b hb => ?_
    refine htf (b • y) fun c hc => ?_
    rw [smul_smul]
    refine hy (c * b) ?_
    rw [pow_succ, mul_comm c b]
    exact Ideal.mul_mem_mul hb hc

/-- A family `m : ι → M` satisfying the cross relations `(a j) ^ k • m i = (a i) ^ k • m j`
defines an `A`-linear map from the ideal generated by the `k`-th powers of the `a i` to the
quotient of `M` by the submodule annihilated by that ideal, characterised by
`(a i) ^ k • φ x = x • m i`. -/
public lemma exists_linearMap_of_cross_relations {ι : Type w} [Finite ι] (a : ι → A) (k : ℕ)
    (m : ι → M) (hrel : ∀ i j, a j ^ k • m i = a i ^ k • m j) :
    ∃ φ : ↥(powerSpan a k) →ₗ[A]
        (M ⧸ Submodule.torsionBySet A M (powerSpan a k : Set A)),
      ∀ (i : ι) (x : ↥(powerSpan a k)),
        a i ^ k • φ x =
          (x : A) • (Submodule.torsionBySet A M (powerSpan a k : Set A)).mkQ (m i) := by
  classical
  have : Fintype ι := Fintype.ofFinite ι
  set T := Submodule.torsionBySet A M (powerSpan a k : Set A) with hT
  set f : (ι → A) →ₗ[A] A := Fintype.linearCombination A (fun i => a i ^ k) with hf
  set g : (ι → A) →ₗ[A] (M ⧸ T) := Fintype.linearCombination A (fun i => T.mkQ (m i)) with hg
  have hfapply : ∀ c : ι → A, f c = ∑ i, c i * a i ^ k := by
    intro c
    rw [hf, Fintype.linearCombination_apply]
    exact Finset.sum_congr rfl fun i _ => by rw [smul_eq_mul]
  have hgapply : ∀ c : ι → A, g c = T.mkQ (∑ i, c i • m i) := by
    intro c
    rw [hg, Fintype.linearCombination_apply, map_sum]
    exact Finset.sum_congr rfl fun i _ => (T.mkQ.map_smul (c i) (m i)).symm
  have hrange : LinearMap.range f = powerSpan a k := by
    rw [hf, Fintype.range_linearCombination, powerSpan_eq_span_range]
  have hmemT : ∀ (y : M), (∀ i, a i ^ k • y = 0) → y ∈ T := by
    intro y hy
    rw [hT, Submodule.mem_torsionBySet_iff]
    exact fun b => smul_eq_zero_of_pow_smul_eq_zero a k y hy b b.2
  have hkey : ∀ (c : ι → A) i, a i ^ k • ∑ j, c j • m j = (∑ j, c j * a j ^ k) • m i := by
    intro c i
    rw [Finset.smul_sum, Finset.sum_smul]
    exact Finset.sum_congr rfl fun j _ => by rw [smul_comm, hrel j i, smul_smul]
  have hker : LinearMap.ker f ≤ LinearMap.ker g := by
    intro c hc
    have hc' : ∑ i, c i * a i ^ k = 0 := by
      rw [← hfapply c]
      exact LinearMap.mem_ker.1 hc
    refine LinearMap.mem_ker.2 ?_
    rw [hgapply c, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
    exact hmemT _ fun i => by rw [hkey c i, hc', zero_smul]
  refine ⟨((LinearMap.ker f).liftQ g hker).comp
    (f.quotKerEquivRange.symm.toLinearMap.comp
      (LinearEquiv.ofEq _ _ hrange.symm).toLinearMap), ?_⟩
  intro i x
  obtain ⟨c, hc⟩ : ∃ c : ι → A, f c = (x : A) := hrange.symm.le x.2
  have hstep : ((LinearMap.ker f).liftQ g hker).comp
      (f.quotKerEquivRange.symm.toLinearMap.comp
        (LinearEquiv.ofEq _ _ hrange.symm).toLinearMap) x = g c := by
    have h1 : (LinearEquiv.ofEq (powerSpan a k) (LinearMap.range f) hrange.symm) x =
        ⟨f c, LinearMap.mem_range_self f c⟩ := Subtype.ext hc.symm
    show ((LinearMap.ker f).liftQ g hker)
      (f.quotKerEquivRange.symm
        ((LinearEquiv.ofEq (powerSpan a k) (LinearMap.range f) hrange.symm) x)) = g c
    rw [h1, LinearMap.quotKerEquivRange_symm_apply_image]
    rfl
  rw [hstep, hgapply c, ← T.mkQ.map_smul, hkey c i, T.mkQ.map_smul, ← hfapply c, hc]

/-- For `1 ≤ k`, a family `m : ι → M` satisfying the cross relations
`(a j) ^ k • m i = (a i) ^ k • m j` defines, for some `N`, an `A`-linear map from the `N`-th power
of the ideal generated by the family to the quotient of `M` by the submodule annihilated by that
power, characterised by `(a i) ^ k • φ x = x • m i`. -/
public lemma exists_idealPow_linearMap_of_cross_relations {ι : Type w} [Finite ι] (a : ι → A)
    (k : ℕ) (hk : 1 ≤ k) (m : ι → M) (hrel : ∀ i j, a j ^ k • m i = a i ^ k • m j) :
    ∃ (N : ℕ) (φ : ↥((Ideal.span (Set.range a)) ^ N) →ₗ[A]
        (M ⧸ Submodule.torsionBySet A M
          (((Ideal.span (Set.range a)) ^ N : Ideal A) : Set A))),
      ∀ (i : ι) (x : ↥((Ideal.span (Set.range a)) ^ N)),
        a i ^ k • φ x =
          (x : A) • (Submodule.torsionBySet A M
            (((Ideal.span (Set.range a)) ^ N : Ideal A) : Set A)).mkQ (m i) := by
  classical
  have : Fintype ι := Fintype.ofFinite ι
  have hcoe : ((Finset.image a Finset.univ : Finset A) : Set A) = Set.range a := by
    rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
  have hle : ((Ideal.span (Set.range a)) ^
      ((Finset.image a Finset.univ).card * (k - 1) + 1) : Ideal A) ≤ powerSpan a k :=
    idealPow_le_powerSpan a k hk (Finset.image a Finset.univ) hcoe
  have hTle : Submodule.torsionBySet A M (powerSpan a k : Set A) ≤
      Submodule.torsionBySet A M (((Ideal.span (Set.range a)) ^
        ((Finset.image a Finset.univ).card * (k - 1) + 1) : Ideal A) : Set A) :=
    Submodule.torsionBySet_le_torsionBySet_of_subset hle
  obtain ⟨φ, hφ⟩ := exists_linearMap_of_cross_relations a k m hrel
  refine ⟨(Finset.image a Finset.univ).card * (k - 1) + 1,
    (Submodule.mapQ _ _ LinearMap.id hTle).comp (φ.comp (Submodule.inclusion hle)),
    fun i x => ?_⟩
  have hq : ∀ y : M, (Submodule.mapQ _ _ LinearMap.id hTle)
      ((Submodule.torsionBySet A M (powerSpan a k : Set A)).mkQ y) =
      (Submodule.torsionBySet A M (((Ideal.span (Set.range a)) ^
        ((Finset.image a Finset.univ).card * (k - 1) + 1) : Ideal A) : Set A)).mkQ y :=
    fun _ => rfl
  have hcoe' : ((Submodule.inclusion hle x : ↥(powerSpan a k)) : A) = (x : A) := rfl
  show a i ^ k •
    (Submodule.mapQ _ _ LinearMap.id hTle) (φ (Submodule.inclusion hle x)) = _
  rw [← map_smul, hφ i (Submodule.inclusion hle x), hcoe', map_smul, hq]

/-- If no nonzero element of `M` is annihilated by the ideal generated by the `k`-th powers of
the family, the map of `exists_linearMap_of_cross_relations` lands in `M` itself. -/
public lemma exists_linearMap_of_cross_relations_of_torsionFree {ι : Type w} [Finite ι]
    (a : ι → A) (k : ℕ) (m : ι → M) (hrel : ∀ i j, a j ^ k • m i = a i ^ k • m j)
    (htf : ∀ y : M, (∀ i, a i ^ k • y = 0) → y = 0) :
    ∃ φ : ↥(powerSpan a k) →ₗ[A] M,
      ∀ (i : ι) (x : ↥(powerSpan a k)), a i ^ k • φ x = (x : A) • m i := by
  classical
  have hbot : Submodule.torsionBySet A M (powerSpan a k : Set A) = ⊥ := by
    refine le_antisymm (fun y hy => ?_) bot_le
    refine (Submodule.mem_bot A).2 (htf y fun i => ?_)
    rw [Submodule.mem_torsionBySet_iff] at hy
    exact hy ⟨a i ^ k, pow_mem_powerSpan a k i⟩
  obtain ⟨φ, hφ⟩ := exists_linearMap_of_cross_relations a k m hrel
  have he : ∀ y : M,
      (Submodule.quotEquivOfEqBot (Submodule.torsionBySet A M (powerSpan a k : Set A)) hbot)
        ((Submodule.torsionBySet A M (powerSpan a k : Set A)).mkQ y) = y := fun _ => rfl
  refine ⟨(Submodule.quotEquivOfEqBot (Submodule.torsionBySet A M
    (powerSpan a k : Set A)) hbot).toLinearMap.comp φ, fun i x => ?_⟩
  show a i ^ k • (Submodule.quotEquivOfEqBot (Submodule.torsionBySet A M
    (powerSpan a k : Set A)) hbot) (φ x) = (x : A) • m i
  rw [← LinearEquiv.map_smul, hφ i x, LinearEquiv.map_smul, he]

end Algebra

/-! ### The open complement on an affine chart -/

section Opens

variable {X : Scheme.{u}}

/-- On an affine chart, the preimage under `fromSpec` of the support of an ideal sheaf is the
vanishing locus of the ideal on that chart. -/
public lemma fromSpec_preimage_support (I : X.IdealSheafData) (U : X.affineOpens)
    (hU : IsAffineOpen (U : X.Opens)) :
    hU.fromSpec ⁻¹' (I.support : Set X) =
      PrimeSpectrum.zeroLocus (I.ideal U : Set Γ(X, (U : X.Opens))) := by
  ext p
  have hmem : hU.fromSpec p ∈ (U : X.Opens) := by
    have hrange : hU.fromSpec p ∈ Set.range hU.fromSpec := ⟨p, rfl⟩
    rwa [hU.range_fromSpec] at hrange
  have h2 : p ∈ PrimeSpectrum.zeroLocus (I.ideal U : Set Γ(X, (U : X.Opens))) ↔
      hU.fromSpec p ∈ X.zeroLocus (U := (U : X.Opens)) (I.ideal U) :=
    Iff.of_eq (congrArg (fun S => p ∈ S)
      (hU.fromSpec_preimage_zeroLocus (I.ideal U : Set Γ(X, (U : X.Opens)))).symm)
  exact (Scheme.IdealSheafData.mem_support_iff_of_mem hmem).trans h2.symm

/-- On an affine chart, the preimage under `fromSpec` of the complement of `V(I)` is the
complement of the vanishing locus of the ideal on that chart. -/
public lemma fromSpec_preimage_idealComplement (I : X.IdealSheafData) (U : X.affineOpens)
    (hU : IsAffineOpen (U : X.Opens)) :
    hU.fromSpec ⁻¹' ((idealComplement I : X.Opens) : Set X) =
      (PrimeSpectrum.zeroLocus (I.ideal U : Set Γ(X, (U : X.Opens))))ᶜ :=
  (Set.preimage_compl (f := (hU.fromSpec : _ → X)) (s := (I.support : Set X))).trans
    (congrArg (fun S => Sᶜ) (fromSpec_preimage_support I U hU))

/-- The image under `fromSpec` of the complement of the vanishing locus of `I(U)` in
`Spec Γ(X, U)` is `U ∖ V(I)`. -/
public lemma fromSpec_image_compl_zeroLocus (I : X.IdealSheafData) (U : X.affineOpens)
    (hU : IsAffineOpen (U : X.Opens)) :
    hU.fromSpec '' (PrimeSpectrum.zeroLocus (I.ideal U : Set Γ(X, (U : X.Opens))))ᶜ =
      (((U : X.Opens) ⊓ idealComplement I : X.Opens) : Set X) :=
  calc hU.fromSpec '' (PrimeSpectrum.zeroLocus (I.ideal U : Set Γ(X, (U : X.Opens))))ᶜ
      = hU.fromSpec '' (hU.fromSpec ⁻¹' ((idealComplement I : X.Opens) : Set X)) :=
        congrArg (fun S => hU.fromSpec '' S) (fromSpec_preimage_idealComplement I U hU).symm
    _ = ((idealComplement I : X.Opens) : Set X) ∩ Set.range hU.fromSpec :=
        Set.image_preimage_eq_inter_range
    _ = ((idealComplement I : X.Opens) : Set X) ∩ ((U : X.Opens) : Set X) :=
        congrArg (fun S => ((idealComplement I : X.Opens) : Set X) ∩ S) hU.range_fromSpec
    _ = (((U : X.Opens) ⊓ idealComplement I : X.Opens) : Set X) := Set.inter_comm _ _

/-- The basic open of an element of the ideal on an affine chart is contained in the part of
`X ∖ V(I)` seen by the chart. -/
public lemma basicOpen_le_inf_idealComplement (I : X.IdealSheafData) (U : X.affineOpens)
    {a : Γ(X, (U : X.Opens))} (ha : a ∈ I.ideal U) :
    X.basicOpen a ≤ (U : X.Opens) ⊓ idealComplement I :=
  le_inf (X.basicOpen_le a) (basicOpen_le_idealComplement I U ha)

end Opens

/-! ### Dividing a section by a power on a basic open -/

section Division

variable {X : Scheme.{u}}

/-- On the basic open of `a`, a section of a quasi-coherent module over an affine open can be
divided by any power of `a`. -/
public lemma exists_pow_smul_eq_restrict_of_basicOpen (F : X.Modules) [F.IsQuasicoherent]
    {U : X.Opens} (hU : IsAffineOpen U) (a : Γ(X, U)) (k : ℕ) (y : Γ(F, U)) :
    ∃ t : Γ(F, X.basicOpen a),
      (X.presheaf.map (homOfLE (X.basicOpen_le a)).op a) ^ k • t =
        F.presheaf.map (homOfLE (X.basicOpen_le a)).op y := by
  let := moduleOfLE F (X.basicOpen_le a)
  have hloc : IsLocalizedModule.Away a (restrictₗ F (X.basicOpen_le a)) :=
    isLocalizedModule_restrictₗ F hU a rfl (X.basicOpen_le a)
  refine ⟨IsLocalizedModule.mk' (restrictₗ F (X.basicOpen_le a)) y
    (⟨a ^ k, (Submonoid.mem_powers_iff _ _).mpr ⟨k, rfl⟩⟩ : Submonoid.powers a), ?_⟩
  have h := IsLocalizedModule.mk'_cancel' (restrictₗ F (X.basicOpen_le a)) y
    (⟨a ^ k, (Submonoid.mem_powers_iff _ _).mpr ⟨k, rfl⟩⟩ : Submonoid.powers a)
  change (X.presheaf.map (homOfLE (X.basicOpen_le a)).op (a ^ k)) •
    IsLocalizedModule.mk' (restrictₗ F (X.basicOpen_le a)) y
      (⟨a ^ k, (Submonoid.mem_powers_iff _ _).mpr ⟨k, rfl⟩⟩ : Submonoid.powers a) = _ at h
  rwa [map_pow] at h

/-- Multiplication by a power of `a` is injective on the sections of a quasi-coherent module over
the basic open of `a` inside an affine open. -/
public lemma eq_of_pow_smul_eq_of_basicOpen (F : X.Modules) [F.IsQuasicoherent]
    {U : X.Opens} (hU : IsAffineOpen U) (a : Γ(X, U)) (k : ℕ) {V : X.Opens}
    (hV : V = X.basicOpen a) (hVU : V ≤ U) (x y : Γ(F, V))
    (h : (X.presheaf.map (homOfLE hVU).op a) ^ k • x =
      (X.presheaf.map (homOfLE hVU).op a) ^ k • y) : x = y := by
  let := moduleOfLE F hVU
  have hloc : IsLocalizedModule.Away a (restrictₗ F hVU) :=
    isLocalizedModule_restrictₗ F hU a hV hVU
  refine (IsLocalizedModule.smul_inj (restrictₗ F hVU)
    (⟨a ^ k, (Submonoid.mem_powers_iff _ _).mpr ⟨k, rfl⟩⟩ : Submonoid.powers a) x y).mp ?_
  show (X.presheaf.map (homOfLE hVU).op (a ^ k)) • x =
    (X.presheaf.map (homOfLE hVU).op (a ^ k)) • y
  rwa [map_pow]

end Division

/-! ### Sections over the chart complement and cross-related families -/

section ChartSections

variable {X : Scheme.{u}}

/-- On an affine chart `U` on which the ideal is generated by a family `a`, a family
`m : ι → Γ(F, U)` satisfying the cross relations `(a j) ^ k • m i = (a i) ^ k • m j` is the family
of numerators of a single section of `F` over `U ∖ V(I)`: there is an `s` with
`(a i) ^ k • s = m i` on the basic open of each `a i`. -/
public lemma exists_section_of_compatible_family (I : X.IdealSheafData)
    (F : X.Modules) [F.IsQuasicoherent] (U : X.affineOpens)
    {ι : Type*} (a : ι → Γ(X, (U : X.Opens))) (ha : ∀ i, a i ∈ I.ideal U)
    (hspan : I.ideal U = Ideal.span (Set.range a)) (k : ℕ)
    (m : ι → Γ(F, (U : X.Opens))) (hrel : ∀ i j, a j ^ k • m i = a i ^ k • m j) :
    ∃ s : Γ(F, (U : X.Opens) ⊓ idealComplement I), ∀ i,
      (X.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (a i)) ^ k •
          F.presheaf.map (homOfLE (basicOpen_le_inf_idealComplement I U (ha i))).op s =
        F.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (m i) := by
  classical
  choose t ht using fun i =>
    exists_pow_smul_eq_restrict_of_basicOpen F U.2 (a i) k (m i)
  have hcpt : TopCat.Presheaf.IsCompatible F.presheaf (fun i => X.basicOpen (a i)) t := by
    intro i j
    have hWU : X.basicOpen (a i) ⊓ X.basicOpen (a j) ≤ (U : X.Opens) :=
      le_trans inf_le_left (X.basicOpen_le _)
    have hri : X.basicOpen (a i) ⊓ X.basicOpen (a j) ≤ X.basicOpen (a i) := inf_le_left
    have hrj : X.basicOpen (a i) ⊓ X.basicOpen (a j) ≤ X.basicOpen (a j) := inf_le_right
    show F.presheaf.map (homOfLE hri).op (t i) = F.presheaf.map (homOfLE hrj).op (t j)
    have hres : ∀ (l : ι) {W : X.Opens} (hr : W ≤ X.basicOpen (a l)) (hW : W ≤ (U : X.Opens)),
        (X.presheaf.map (homOfLE hW).op (a l)) ^ k • F.presheaf.map (homOfLE hr).op (t l) =
          F.presheaf.map (homOfLE hW).op (m l) := by
      intro l W hr hW
      have h := congrArg (F.presheaf.map (homOfLE hr).op) (ht l)
      rwa [F.map_smul, map_pow, structureSheaf_map_homOfLE_map_homOfLE,
        map_homOfLE_map_homOfLE] at h
    have hi := hres i hri hWU
    have hj := hres j hrj hWU
    have key : (X.presheaf.map (homOfLE hWU).op (a j)) ^ k •
          F.presheaf.map (homOfLE hWU).op (m i) =
        (X.presheaf.map (homOfLE hWU).op (a i)) ^ k •
          F.presheaf.map (homOfLE hWU).op (m j) := by
      rw [← map_pow, ← F.map_smul, ← map_pow, ← F.map_smul, hrel i j]
    refine eq_of_pow_smul_eq_of_basicOpen F U.2 (a i * a j) k
      (X.basicOpen_mul (a i) (a j)).symm hWU _ _ ?_
    rw [map_mul, mul_pow]
    calc ((X.presheaf.map (homOfLE hWU).op (a i)) ^ k *
            (X.presheaf.map (homOfLE hWU).op (a j)) ^ k) •
          F.presheaf.map (homOfLE hri).op (t i)
        = (X.presheaf.map (homOfLE hWU).op (a j)) ^ k •
            ((X.presheaf.map (homOfLE hWU).op (a i)) ^ k •
              F.presheaf.map (homOfLE hri).op (t i)) := by
          rw [← mul_smul, mul_comm]
      _ = (X.presheaf.map (homOfLE hWU).op (a i)) ^ k •
            ((X.presheaf.map (homOfLE hWU).op (a j)) ^ k •
              F.presheaf.map (homOfLE hrj).op (t j)) := by rw [hi, hj, key]
      _ = ((X.presheaf.map (homOfLE hWU).op (a i)) ^ k *
            (X.presheaf.map (homOfLE hWU).op (a j)) ^ k) •
          F.presheaf.map (homOfLE hrj).op (t j) := by rw [← mul_smul]
  have hcover : (U : X.Opens) ⊓ idealComplement I ≤ ⨆ i, X.basicOpen (a i) :=
    le_of_eq (affine_inf_idealComplement_eq_iSup_basicOpen_of_span I U a hspan)
  obtain ⟨s₀, hs₀, -⟩ := TopCat.Presheaf.IsSheaf.isSheafUniqueGluing F.isSheaf
    (fun i => X.basicOpen (a i)) t hcpt
  refine ⟨F.presheaf.map (homOfLE hcover).op s₀, fun i => ?_⟩
  have hres : F.presheaf.map
      (homOfLE (basicOpen_le_inf_idealComplement I U (ha i))).op
      (F.presheaf.map (homOfLE hcover).op s₀) = t i := by
    rw [map_homOfLE_map_homOfLE]
    exact hs₀ i
  rw [hres]
  exact ht i

/-- Two sections of `F` over `U ∖ V(I)` whose multiples by `(a i) ^ k` agree on the basic open
of each `a i` are equal. -/
public lemma eq_of_pow_smul_restrict_eq (I : X.IdealSheafData)
    (F : X.Modules) [F.IsQuasicoherent] (U : X.affineOpens)
    {ι : Type*} (a : ι → Γ(X, (U : X.Opens))) (ha : ∀ i, a i ∈ I.ideal U)
    (hspan : I.ideal U = Ideal.span (Set.range a)) (k : ℕ)
    (s s' : Γ(F, (U : X.Opens) ⊓ idealComplement I))
    (h : ∀ i, (X.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (a i)) ^ k •
          F.presheaf.map (homOfLE (basicOpen_le_inf_idealComplement I U (ha i))).op s =
        (X.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (a i)) ^ k •
          F.presheaf.map (homOfLE (basicOpen_le_inf_idealComplement I U (ha i))).op s') :
    s = s' := by
  apply TopCat.Presheaf.IsSheaf.section_ext F.isSheaf
  intro y hy
  obtain ⟨i, hyi⟩ := exists_mem_basicOpen_of_span I U a hspan hy.1 hy.2
  refine ⟨X.basicOpen (a i), basicOpen_le_inf_idealComplement I U (ha i), hyi, ?_⟩
  exact eq_of_pow_smul_eq_of_basicOpen F U.2 (a i) k rfl (X.basicOpen_le (a i)) _ _ (h i)

end ChartSections

