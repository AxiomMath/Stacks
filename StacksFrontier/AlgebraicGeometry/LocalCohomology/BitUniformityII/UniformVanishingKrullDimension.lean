module

public import
  StacksFrontier.AlgebraicGeometry.LocalCohomology.BitUniformityII.UniformVanishingConditions
public import StacksFrontier.RingTheory.ReesAlgebra.PowerReduction
public import StacksFrontier.RingTheory.Tor.AlmostFlatResolution
public import StacksCore.Tactic.StacksAttribute

/-!
# Uniform vanishing at the level of the dimension of a local ring

Let `A` be a Noetherian local ring of Krull dimension `d` and let `I ⊆ A` be any ideal. There are
`N` and `c` such that for every `n ≥ N` the surjection `A / I ^ n ↠ A / I ^ (n - c)` satisfies
the equivalent conditions of [Stacks, Tag 0G9V] with `e = d`: this is [Stacks, Tag 0GA3] with
`e = t` replaced by `e = dim A`, the statement of [Stacks, Tag 0GA4], which the source attributes
to the paper [AHS]. With it comes the uniform annihilation of `Tor` at level `dim A`: a single
power of `I` annihilates `Tor _ i ^ A (M, A / I ^ q)` for every module `M`, every `i > dim A` and
every `q`.

## Main results

All of the following live in the namespace `Stacks.LocalCohomology.UniformityII`.

* `exists_uniform_torMapVanishesAtSucc_quotientFactor_of_ringKrullDim`: the transition induces
  the zero map on `Tor _ (d + 1)` against every module, condition (7) of [Stacks, Tag 0G9V].
* `exists_uniform_vanishingConditions_quotientFactor_of_ringKrullDim`: **[Stacks, Tag 0GA4]**,
  all seven conditions of [Stacks, Tag 0G9V] at `e = dim A`, for any chosen pair of projective
  resolutions.
* `exists_pow_le_annihilator_tor_quotient_pow_of_ringKrullDim`: the uniform annihilation of
  `Tor _ i ^ A (M, A / I ^ q)` for `i > dim A`, the conclusion of [Stacks, Tag 0GA1] at level
  `dim A`.

## How the statements are proved

The source gives no proof; it cites [AHS], which proves a much stronger statement, uniform over
all ideals of `A` at once. For a single ideal the following argument suffices.

If `I = A` every quotient `A / I ^ n` is zero and there is nothing to prove. Otherwise `I` lies
in the maximal ideal, and `Stacks.ReesAlgebra.exists_pow_le_span_pow` provides `s ≥ 1` and
`x₁, …, x_d ∈ I ^ s` such that `J = (x₁, …, x_d)` is a reduction of `I ^ s`; concretely
`J ^ q ⊆ I ^ (s * q)`, and `I ^ n ⊆ J ^ q` as soon as `n ≥ N₀ + q * s`. Since `J` is generated by
`d` elements, [Stacks, Tag 0GA3] (`exists_uniform_torMapVanishesAtSucc_quotientFactor`) applies to
`J` with `t = d`. For large `n` the transition `A / I ^ n → A / I ^ (n - c)` then factors as
`A / I ^ n → A / J ^ q → A / J ^ (q - c_J) → A / I ^ (n - c)` with `q ≈ (n - N₀) / s`, and the
middle map is zero on `Tor _ (d + 1)`. The other six conditions follow from condition (7) by
`tfae_of_isNoetherianRing_of_finite`, as in [Stacks, Tag 0GA3].

For the annihilation, multiplication by `r ∈ I ^ c` on `A / I ^ q` factors through the transition
`A / I ^ q → A / I ^ (q - c)`, which is zero on `Tor _ i` for `i > d` (condition (6)); since
`Tor` carries multiplication by `r` to multiplication by `r` (`tor_map_smul_id`), `r` kills
`Tor _ i (A / I ^ q, M)`. For the finitely many small `q` the power `I ^ q` already kills
`A / I ^ q`.

## References

* [Stacks Project, Tag 0GA4](https://stacks.math.columbia.edu/tag/0GA4)
* [Stacks Project, Tag 0GA3](https://stacks.math.columbia.edu/tag/0GA3)
* [Stacks Project, Tag 0G9V](https://stacks.math.columbia.edu/tag/0G9V)
* [AHS]: I. Aberbach, A. Hosry, J. Striuli, *Uniform Artin-Rees bounds for syzygies*,
  Adv. Math. **285** (2015), 478-496.
-/

@[expose] public section

open CategoryTheory Limits

universe u

attribute [local instance] HasDerivedCategory.standard

namespace Stacks.LocalCohomology.UniformityII

noncomputable section

variable {A : Type u} [CommRing A]

/-- **Stacks Project, Tag 0GA4, condition (7) of Tag 0G9V.** Let `A` be a Noetherian local ring
of Krull dimension `d` and let `I` be an ideal of `A`. There are `N` and `c` such that for every
`n ≥ N` the transition `A / I ^ n ↠ A / I ^ (n - c)` induces the zero map on `Tor _ (d + 1)`
against every module. -/
theorem exists_uniform_torMapVanishesAtSucc_quotientFactor_of_ringKrullDim
    [IsNoetherianRing A] [IsLocalRing A] (I : Ideal A) (d : ℕ) (hdim : ringKrullDim A = d) :
    ∃ N c : ℕ, ∀ n : ℕ, N ≤ n →
      TorMapVanishesAtSucc
        (ModuleCat.ofHom (Submodule.factor (p := I ^ n) (p' := I ^ (n - c))
          (Ideal.pow_le_pow_right (Nat.sub_le n c)))) d := by
  by_cases hI : I ≤ IsLocalRing.maximalIdeal A
  swap
  · -- `I = A`: all the quotients vanish
    have hItop : I = ⊤ := not_not.mp fun hne ↦ hI (IsLocalRing.le_maximalIdeal hne)
    refine ⟨0, 0, fun n _ N ↦ ?_⟩
    have hz : IsZero (ModuleCat.of A (A ⧸ I ^ n)) := by
      rw [hItop, Ideal.top_pow]
      exact ModuleCat.isZero_of_subsingleton _
    rw [Tor'_map_app, hz.eq_of_src (ModuleCat.ofHom _) 0, Functor.map_zero]
    rfl
  obtain ⟨s, hs, x, hx, N₀, hN₀⟩ := Stacks.ReesAlgebra.exists_pow_le_span_pow hI hdim.le
  obtain ⟨NJ, cJ, hJ⟩ := exists_uniform_torMapVanishesAtSucc_quotientFactor
    (I := Ideal.span (Set.range x)) x rfl
  refine ⟨N₀ + s * (NJ + cJ), N₀ + s + s * cJ, fun n hn ↦ ?_⟩
  set q := (n - N₀) / s with hq_def
  have hqs : q * s ≤ n - N₀ := Nat.div_mul_le_self _ _
  have hqs' : n - N₀ < q * s + s := Nat.lt_div_mul_add hs
  have hq : NJ + cJ ≤ q := (Nat.le_div_iff_mul_le hs).mpr (by rw [mul_comm]; omega)
  have h1 : I ^ n ≤ Ideal.span (Set.range x) ^ q := hN₀ q n (by omega)
  have h2 : Ideal.span (Set.range x) ^ (q - cJ) ≤ I ^ (n - (N₀ + s + s * cJ)) := by
    calc Ideal.span (Set.range x) ^ (q - cJ) ≤ (I ^ s) ^ (q - cJ) :=
          Ideal.pow_right_mono (Ideal.span_le.mpr (Set.range_subset_iff.mpr hx)) _
      _ = I ^ (s * (q - cJ)) := (pow_mul _ _ _).symm
      _ ≤ I ^ (n - (N₀ + s + s * cJ)) := by
        apply Ideal.pow_le_pow_right
        have hb : s * cJ ≤ q * s := by rw [mul_comm q s]; exact Nat.mul_le_mul_left _ (by omega)
        rw [Nat.mul_sub, mul_comm s q]
        omega
  have hfac : ModuleCat.ofHom (Submodule.factor (p := I ^ n) (p' := I ^ (n - (N₀ + s + s * cJ)))
        (Ideal.pow_le_pow_right (Nat.sub_le n (N₀ + s + s * cJ)))) =
      ModuleCat.ofHom (Submodule.factor h1) ≫
        ModuleCat.ofHom (Submodule.factor (p := Ideal.span (Set.range x) ^ q)
          (p' := Ideal.span (Set.range x) ^ (q - cJ)) (Ideal.pow_le_pow_right (Nat.sub_le q cJ))) ≫
        ModuleCat.ofHom (Submodule.factor h2) := by
    rw [← ModuleCat.ofHom_comp, ← ModuleCat.ofHom_comp, Submodule.factor_comp,
      Submodule.factor_comp]
  intro N
  rw [hfac, Functor.map_comp, Functor.map_comp, NatTrans.comp_app, NatTrans.comp_app,
    hJ q (by omega) N, zero_comp, comp_zero]

/-- **Stacks Project, Tag 0GA4.** Let `A` be a Noetherian local ring of Krull dimension `d` and
let `I` be an ideal of `A`. There are `N` and `c` such that for every `n ≥ N` and every choice of
projective resolutions of `A / I ^ n` and of `A / I ^ (n - c)`, the transition
`A / I ^ n ↠ A / I ^ (n - c)` satisfies all seven conditions of [Stacks, Tag 0G9V] with `e = d`,
in the order of the source: (1) a lift vanishing in all degrees above `d`, (2) a lift vanishing in
degree `d + 1`, (3) the zero map on `Ext ^ i` for all `i > d`, (4) the zero map on
`Ext ^ (d + 1)`, (5) the canonical class of degree `d + 1` pulls back to zero, (6) the zero map on
`Tor _ i` for all `i > d`, (7) the zero map on `Tor _ (d + 1)`.

This is the conclusion of [Stacks, Tag 0GA3] with `e = t` replaced by `e = dim A`; no bound on
the number of generators of `I` enters the statement. All seven conditions follow from condition
(7), `exists_uniform_torMapVanishesAtSucc_quotientFactor_of_ringKrullDim`, by
`tfae_of_isNoetherianRing_of_finite`. -/
@[stacks 0GA4 "Tag 0GA3 with e = dim A for a local ring: all seven conditions of Tag 0G9V; the
cd(A, I) question the remark raises is open in the source and is not stated"]
theorem exists_uniform_vanishingConditions_quotientFactor_of_ringKrullDim
    [IsNoetherianRing A] [IsLocalRing A] (I : Ideal A) (d : ℕ) (hdim : ringKrullDim A = d) :
    ∃ N c : ℕ, ∀ n : ℕ, N ≤ n →
      ∀ {P P' : CochainComplex (ModuleCat.{u} A) ℤ}
        (p : P ⟶ singleComplex (ModuleCat.of A (A ⧸ I ^ n)))
        (p' : P' ⟶ singleComplex (ModuleCat.of A (A ⧸ I ^ (n - c))))
        [CochainComplex.IsProjectiveResolution p]
        [CochainComplex.IsProjectiveResolution p'],
        let α := ModuleCat.ofHom (Submodule.factor (p := I ^ n) (p' := I ^ (n - c))
          (Ideal.pow_le_pow_right (Nat.sub_le n c)))
        HasLiftVanishingAbove p p' α d ∧ HasLiftVanishingAtSucc p p' α d ∧
          ExtMapVanishesAbove α d ∧ ExtMapVanishesAtSucc α d ∧
          CanonicalExtClassPullbackVanishes p p' α d ∧ TorMapVanishesAbove α d ∧
          TorMapVanishesAtSucc α d := by
  obtain ⟨N, c, h⟩ := exists_uniform_torMapVanishesAtSucc_quotientFactor_of_ringKrullDim I d hdim
  refine ⟨N, c, fun n hn _ _ p p' _ _ ↦ ?_⟩
  intro α
  have hT := tfae_of_isNoetherianRing_of_finite p p' α d
  have h7 : TorMapVanishesAtSucc α d := h n hn
  exact ⟨(hT.out 7 1).1 h7, (hT.out 7 2).1 h7, (hT.out 7 3).1 h7, (hT.out 7 4).1 h7,
    (hT.out 7 5).1 h7, (hT.out 7 6).1 h7, h7⟩

/-- **The uniform annihilation of `Tor` at level `dim A`.** Let `A` be a Noetherian local ring of
Krull dimension `d` and let `I` be an ideal of `A`. A single power `I ^ m`, depending on `A` and
`I` alone, annihilates `Tor _ i ^ A (M, A / I ^ q)` for every `A`-module `M`, every `i > d` and
every `q ≥ 0`: the conclusion of [Stacks, Tag 0GA1] with the number of generators of `I`
replaced by `dim A`, in the form of the uniform annihilation level of
`exists_uniform_extMapVanishesAbove_quotientFactor_of_annihilator_level`. -/
theorem exists_pow_le_annihilator_tor_quotient_pow_of_ringKrullDim
    [IsNoetherianRing A] [IsLocalRing A] (I : Ideal A) (d : ℕ) (hdim : ringKrullDim A = d) :
    ∃ m : ℕ, ∀ (M : ModuleCat.{u} A) (i q : ℕ), d < i →
      I ^ m ≤ Module.annihilator A
        (((Tor' (ModuleCat.{u} A) i).obj M).obj (ModuleCat.of A (A ⧸ I ^ q))) := by
  obtain ⟨N, c, h⟩ := exists_uniform_torMapVanishesAtSucc_quotientFactor_of_ringKrullDim I d hdim
  refine ⟨max N c, fun M i q hi r hr ↦ ?_⟩
  refine mem_annihilator_of_moduleCat_iso (((torFlip_iso_Tor' A i).app M).app _) ?_
  by_cases hq : q < max N c
  · refine mem_annihilator_tor_of_mem_annihilator _ M i ?_
    refine Module.mem_annihilator.mpr fun y ↦ ?_
    obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ y
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero, smul_eq_mul]
    exact Ideal.mul_mem_right _ _ (Ideal.pow_le_pow_right hq.le hr)
  push Not at hq
  have hrc : r ∈ I ^ c := Ideal.pow_le_pow_right (le_max_right N c) hr
  set α := ModuleCat.ofHom (Submodule.factor (p := I ^ q) (p' := I ^ (q - c))
    (Ideal.pow_le_pow_right (Nat.sub_le q c)))
  -- condition (6) of Tag 0G9V for the transition out of `A / I ^ q`
  have (X : ModuleCat.{u} A) :
      CochainComplex.IsProjectiveResolution (ProjectiveResolution.of X).π' :=
    ⟨⟨0, inferInstance⟩, fun _ ↦ inferInstance⟩
  have h6 : TorMapVanishesAbove α d :=
    ((tfae_of_isNoetherianRing_of_finite
      (ProjectiveResolution.of (ModuleCat.of A (A ⧸ I ^ q))).π'
      (ProjectiveResolution.of (ModuleCat.of A (A ⧸ I ^ (q - c)))).π' α d).out 7 6).1
      (h q (le_of_max_le_left hq))
  have h0 : ((Tor (ModuleCat.{u} A) i).map α).app M = 0 := by
    have hnat := NatTrans.congr_app ((Tor_iso_Tor' A i).hom.naturality α) M
    simp only [NatTrans.comp_app, h6 M i hi, comp_zero] at hnat
    exact ((((Tor_iso_Tor' A i).app _).app M).cancel_iso_hom_right _ _).1 (by simpa using hnat)
  -- multiplication by `r` on `A / I ^ q` factors through the transition
  have hker : I ^ (q - c) ≤ LinearMap.ker ((I ^ q).mkQ ∘ₗ (r • LinearMap.id)) := by
    intro a ha
    rw [LinearMap.mem_ker, LinearMap.comp_apply, Submodule.mkQ_apply,
      Submodule.Quotient.mk_eq_zero]
    have : r * a ∈ I ^ c * I ^ (q - c) := Ideal.mul_mem_mul hrc ha
    rw [← pow_add, Nat.add_sub_cancel' (le_of_max_le_right hq)] at this
    simpa using this
  set μ := ModuleCat.ofHom ((I ^ (q - c)).liftQ ((I ^ q).mkQ ∘ₗ (r • LinearMap.id)) hker)
  have hfac : r • 𝟙 (ModuleCat.of A (A ⧸ I ^ q)) = α ≫ μ := by
    refine ModuleCat.hom_ext (LinearMap.ext fun y ↦ ?_)
    obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ y
    rfl
  have hsmul := tor_map_smul_id (ModuleCat.of A (A ⧸ I ^ q)) M i r
  rw [hfac, Functor.map_comp, NatTrans.comp_app, h0, zero_comp] at hsmul
  refine Module.mem_annihilator.mpr fun y ↦ ?_
  have := congrArg (fun f ↦ f.hom y) hsmul
  simp only [ModuleCat.hom_zero, ModuleCat.hom_smul, ModuleCat.hom_id, LinearMap.zero_apply,
    LinearMap.smul_apply, LinearMap.id_apply] at this
  exact this.symm

end

end Stacks.LocalCohomology.UniformityII
