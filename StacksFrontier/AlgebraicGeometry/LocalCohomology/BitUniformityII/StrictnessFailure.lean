* [Stacks Project, Tag 0GA5](https://stacks.math.columbia.edu/tag/0GA5)
* [Stacks Project, Tag 0921](https://stacks.math.columbia.edu/tag/0921)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite MvPolynomial Stacks.LocalCohomology

universe u

namespace Stacks.LocalCohomology.UniformityII

/-! ### Surjections between cyclic quotients -/

/-- A surjection `A/I ↠ A/J` of `A`-modules forces `I ≤ J`. -/
public theorem le_of_surjective_quotientMap {A : Type u} [CommRing A] {I J : Ideal A}
    (g : (A ⧸ I) →ₗ[A] (A ⧸ J)) (hg : Function.Surjective g) : I ≤ J := by
  intro x hx
  obtain ⟨w, hw⟩ := hg (Submodule.Quotient.mk (p := J) 1)
  obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ w
  have h0 : x • Submodule.Quotient.mk (p := J) (1 : A) = 0 := by
    rw [← hw, ← map_smul, ← Submodule.Quotient.mk_smul,
      (Submodule.Quotient.mk_eq_zero I (x := x • a)).2 (I.mul_mem_right a hx), map_zero]
  rwa [← Submodule.Quotient.mk_smul, smul_eq_mul, mul_one, Submodule.Quotient.mk_eq_zero] at h0

/-! ### The obstruction carried by a strict pro-isomorphism -/

/-- Every transition map of the Koszul system of quotients is surjective. -/
public theorem surjective_powQuotientSystem_map {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin r → A) {m n : ℕᵒᵖ} (g : m ⟶ n) :
    Function.Surjective ((Koszul.powQuotientSystem f).map g).hom := by
  intro z
  obtain ⟨a, rfl⟩ := Submodule.Quotient.mk_surjective _ z
  exact ⟨Submodule.Quotient.mk a, rfl⟩

/-! ### The two systems are pro-isomorphic -/

/-- The canonical surjection `A/(f₀^(n+1), …, f_{r-1}^(n+1)) ↠ A/I^(n+1)`, as a map of inverse
systems from the Koszul system of quotients to the adic system. -/
public def koszulToAdic {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) :
    NatTrans (Koszul.powQuotientSystem f)
      (AdicCompletionTor.idealPowerQuotientModuleSystem (Ideal.span (Set.range f))) where
  app n := (show (Koszul.powQuotientSystem f).obj n ⟶
      (AdicCompletionTor.idealPowerQuotientModuleSystem (Ideal.span (Set.range f))).obj n from
    ModuleCat.ofHom (Submodule.factor (Koszul.powIdeal_le_pow f (n.unop + 1))))
  naturality m n g := by
    have hg : (AdicCompletionTor.idealPowerQuotientModuleSystem
          (Ideal.span (Set.range f))).map g
        = (AdicCompletionTor.idealPowerQuotientModuleSystem
          (Ideal.span (Set.range f))).map (homOfLE (leOfHom g.unop)).op :=
      congrArg _ (Subsingleton.elim _ _)
    rw [hg, AdicCompletionTor.idealPowerQuotientModuleSystem_map]
    refine ModuleCat.hom_ext (LinearMap.ext fun x => ?_)
    obtain ⟨y, rfl⟩ := Submodule.Quotient.mk_surjective _ x
    rfl

/-- **The two systems are isomorphic as pro-objects.** The comparison `koszulToAdic` admits, at
every level `n`, a two-sided inverse defined on a later level `m`: both triangles it forms with
the transition maps commute. -/
@[stacks 0GA5 "the pro-isomorphism, in the category of modules, between the system \
`H⁰(Kₙ) = A/(f₀ⁿ, …, f_{r-1}ⁿ)` and the system `A/Iⁿ`, which is the comparison the remark \
makes by comparing with Koszul complexes and whose strictness the remark then denies"]
public theorem proIso_koszulToAdic {A : Type u} [CommRing A] {r : ℕ} (f : Fin r → A) (n : ℕ) :
    ∃ (m : ℕ) (h : n ≤ m)
      (s : (AdicCompletionTor.idealPowerQuotientModuleSystem
              (Ideal.span (Set.range f))).obj (op m) ⟶
        (Koszul.powQuotientSystem f).obj (op n)),
      (koszulToAdic f).app (op m) ≫ s = (Koszul.powQuotientSystem f).map (homOfLE h).op ∧
        s ≫ (koszulToAdic f).app (op n)
          = (AdicCompletionTor.idealPowerQuotientModuleSystem
              (Ideal.span (Set.range f))).map (homOfLE h).op := by
  obtain ⟨k, hk⟩ := Koszul.exists_pow_le_powIdeal f (n + 1)
  refine ⟨max k (n + 1), le_trans (Nat.le_succ n) (le_max_right _ _), ?_⟩
  have hle : Ideal.span (Set.range f) ^ (max k (n + 1) + 1) ≤ Koszul.powIdeal f (n + 1) :=
    le_trans (Ideal.pow_le_pow_right (le_trans (le_max_left _ _) (Nat.le_succ _))) hk
  refine ⟨(show (AdicCompletionTor.idealPowerQuotientModuleSystem
      (Ideal.span (Set.range f))).obj (op (max k (n + 1))) ⟶
      (Koszul.powQuotientSystem f).obj (op n) from
    ModuleCat.ofHom (Submodule.factor hle)), ?_, ?_⟩
  · exact ModuleCat.hom_ext (Submodule.linearMap_qext _ rfl)
  · rw [AdicCompletionTor.idealPowerQuotientModuleSystem_map]
    exact ModuleCat.hom_ext (Submodule.linearMap_qext _ rfl)

/-- **The obstruction to strictness.** Suppose the adic system `A/I^•` and the Koszul system
`A/(f^•)` of quotients are related by strict pro-morphisms `φ` and `ψ` whose composite
`ψ ∘ φ` is eventually the identity of the Koszul system. Then the shift of `φ` is a constant
`c` with `I^(n+c+1) ≤ (f₀^(n+1), …, f_{r-1}^(n+1))` at every sufficiently late level. -/
public theorem exists_uniform_pow_le_powIdeal_of_strictProSection {A : Type u} [CommRing A]
    {r : ℕ} (f : Fin r → A)
    (φ : StrictProHomRep
      (AdicCompletionTor.idealPowerQuotientModuleSystem (Ideal.span (Set.range f)))
      (Koszul.powQuotientSystem f))
    (ψ : StrictProHomRep (Koszul.powQuotientSystem f)
      (AdicCompletionTor.idealPowerQuotientModuleSystem (Ideal.span (Set.range f))))
    (h : (ψ.comp φ).Equivalent (StrictProHomRep.id (Koszul.powQuotientSystem f))) :
    ∃ N : ℕ, ∀ n ≥ N,
      Ideal.span (Set.range f) ^ (n + φ.shift + 1) ≤ Koszul.powIdeal f (n + 1) := by
  obtain ⟨d, N, hf, hg, heq⟩ := h
  refine ⟨N, fun n hn => ?_⟩
  have hcomp := heq n hn
  have htr : Function.Surjective
      (((shiftedInverseSequenceTransition (Koszul.powQuotientSystem f) hg).app (op n)).hom) :=
    surjective_powQuotientSystem_map f (opHomOfLE (Nat.add_le_add_left hg n))
  have hidsurj : Function.Surjective
      (((StrictProHomRep.id (Koszul.powQuotientSystem f)).hom.app (op n)).hom) :=
    fun z => ⟨z, rfl⟩
  have hrhs : Function.Surjective
      (((shiftedInverseSequenceTransition (Koszul.powQuotientSystem f) hg).app (op n) ≫
        (StrictProHomRep.id (Koszul.powQuotientSystem f)).hom.app (op n)).hom) := by
    simpa only [ModuleCat.hom_comp, LinearMap.coe_comp] using hidsurj.comp htr
  rw [← hcomp] at hrhs
  have hfac : (shiftedInverseSequenceTransition (Koszul.powQuotientSystem f) hf).app (op n) ≫
        (ψ.comp φ).hom.app (op n) =
      ((shiftedInverseSequenceTransition (Koszul.powQuotientSystem f) hf).app (op n) ≫
        (Koszul.powQuotientSystem f).map
          (eqToHom (congrArg Opposite.op (Nat.add_assoc n φ.shift ψ.shift).symm)) ≫
        ψ.hom.app (Opposite.op (n + φ.shift))) ≫ φ.hom.app (op n) := by
    simp only [StrictProHomRep.comp, Category.assoc]
  rw [hfac] at hrhs
  refine le_of_surjective_quotientMap (φ.hom.app (op n)).hom ?_
  exact Function.Surjective.of_comp hrhs

/-! ### The polynomial example -/

variable {r : ℕ}

/-- The exponent vector on `r` variables all of whose entries equal `k`. -/
public def monomialExponent (r k : ℕ) : Fin r →₀ ℕ := ∑ i : Fin r, Finsupp.single i k

/-- Every entry of `monomialExponent r k` is `k`. -/
@[simp]
public theorem monomialExponent_apply (r k : ℕ) (j : Fin r) : monomialExponent r k j = k := by
  simp [monomialExponent, Finsupp.single_apply]

/-- A product of equal powers of the variables is the corresponding monomial. -/
public theorem prod_X_pow_eq_monomial (s : Finset (Fin r)) (k : ℕ) :
    (∏ i ∈ s, (X i ^ k : MvPolynomial (Fin r) ℤ)) =
      monomial (∑ i ∈ s, Finsupp.single i k) 1 := by
  classical
  induction s using Finset.induction with
  | empty => simp
  | insert a s ha ih =>
      rw [Finset.prod_insert ha, Finset.sum_insert ha, ih, X_pow_eq_monomial,
        monomial_mul_monomial, one_mul]

/-- An element of `(x₀ⁿ, …, x_{r-1}ⁿ)` has vanishing coefficient at every exponent vector all
of whose entries are smaller than `n`. -/
public theorem coeff_eq_zero_of_mem_span_X_pow (n : ℕ) (g : MvPolynomial (Fin r) ℤ)
    (hg : g ∈ Ideal.span (Set.range fun i : Fin r => (X i : MvPolynomial (Fin r) ℤ) ^ n))
    (d : Fin r →₀ ℕ) (hd : ∀ i, d i < n) : g.coeff d = 0 := by
  obtain ⟨c, hc⟩ := Ideal.mem_span_range_iff_exists_fun.1 hg
  rw [← hc, coeff_sum]
  refine Finset.sum_eq_zero fun i _ => ?_
  have hnot : ¬ (Finsupp.single i n ≤ d) := fun hle =>
    absurd (Finsupp.single_le_iff.1 hle) (hd i).not_ge
  rw [X_pow_eq_monomial, coeff_mul_monomial', ite_eq_right hnot]

/-- The ideal `I = (x₀, …, x_{r-1})` of `ℤ[x₀, …, x_{r-1}]`. -/
public def monomialIdeal (r : ℕ) : Ideal (MvPolynomial (Fin r) ℤ) :=
  Ideal.span (Set.range fun i : Fin r => X i)

/-- The monomial `x₀^(n-1) ⋯ x_{r-1}^(n-1)`, of total degree `r(n-1)`. -/
public def diagonalMonomial (r n : ℕ) : MvPolynomial (Fin r) ℤ :=
  monomial (monomialExponent r (n - 1)) 1

/-- The diagonal monomial is not in `(x₀ⁿ, …, x_{r-1}ⁿ)`: each of its exponents is `n - 1`. -/
public theorem diagonalMonomial_notMem_span_X_pow (r n : ℕ) (hn : 1 ≤ n) :
    diagonalMonomial r n ∉
      Ideal.span (Set.range fun i : Fin r => (X i : MvPolynomial (Fin r) ℤ) ^ n) := by
  intro hmem
  have h0 := coeff_eq_zero_of_mem_span_X_pow n _ hmem (monomialExponent r (n - 1))
    (fun i => by rw [monomialExponent_apply]; omega)
  rw [diagonalMonomial, coeff_monomial, ite_eq_left rfl] at h0
  exact one_ne_zero h0

/-- The diagonal monomial lies in `I^{r(n-1)}`: it is the `(n-1)`-st power of a product of `r`
variables. -/
public theorem diagonalMonomial_mem_pow (r n : ℕ) :
    diagonalMonomial r n ∈ monomialIdeal r ^ (r * (n - 1)) := by
  have hprod : (∏ i : Fin r, (X i : MvPolynomial (Fin r) ℤ)) ∈ monomialIdeal r ^ r := by
    have hmem := Ideal.prod_mem_prod (s := (Finset.univ : Finset (Fin r)))
      (I := fun _ : Fin r => monomialIdeal r)
      (x := fun i : Fin r => (X i : MvPolynomial (Fin r) ℤ))
      (fun i _ => Ideal.subset_span (Set.mem_range_self i))
    simpa [Finset.prod_const] using hmem
  have hw : diagonalMonomial r n
      = (∏ i : Fin r, (X i : MvPolynomial (Fin r) ℤ)) ^ (n - 1) := by
    rw [diagonalMonomial, monomialExponent, ← prod_X_pow_eq_monomial Finset.univ (n - 1),
      Finset.prod_pow]
  rw [hw, pow_mul]
  exact Ideal.pow_mem_pow hprod (n - 1)

/-- In `ℤ[x₀, …, x_{r-1}]` the module
`H⁰(Kₙ) = ℤ[x]/(x₀ⁿ, …, x_{r-1}ⁿ)` is not annihilated by `I^{r(n-1)}`. -/
@[stacks 0GA5 "the computation the remark performs on its example: for `A = ℤ[x₀, …, x_{r-1}]` \
and `f i = x i`, the module `H⁰(Kₙ) = A/(x₀ⁿ, …, x_{r-1}ⁿ)` is not annihilated by `I^{r(n-1)}`, \
witnessed by the monomial `x₀^(n-1) ⋯ x_{r-1}^(n-1)`"]
public theorem not_annihilator_pow_mul_pred (r n : ℕ) (hn : 1 ≤ n) :
    ¬ (monomialIdeal r ^ (r * (n - 1)) ≤
        Module.annihilator (MvPolynomial (Fin r) ℤ)
          (MvPolynomial (Fin r) ℤ ⧸
            Ideal.span (Set.range fun i : Fin r => (X i : MvPolynomial (Fin r) ℤ) ^ n))) := by
  rw [Ideal.annihilator_quotient]
  intro hle
  exact diagonalMonomial_notMem_span_X_pow r n hn (hle (diagonalMonomial_mem_pow r n))

/-- For `r ≥ 2` no constant shift `c` has `I^(n+c) ⊆ (x₀ⁿ, …, x_{r-1}ⁿ)` at all late levels:
the exponent `r(n-1)` of the diagonal monomial outgrows `n + c`. -/
public theorem not_exists_uniform_pow_le_monomialPow (r : ℕ) (hr : 2 ≤ r) :
    ¬ ∃ c N : ℕ, ∀ n ≥ N,
        monomialIdeal r ^ (n + c) ≤
          Ideal.span (Set.range fun i : Fin r => (X i : MvPolynomial (Fin r) ℤ) ^ n) := by
  rintro ⟨c, N, hcN⟩
  set n := N + r + c + 1 with hn
  have hn1 : 1 ≤ n := by omega
  have hle : n + c ≤ r * (n - 1) := by
    have hstep : 2 * (n - 1) ≤ r * (n - 1) := Nat.mul_le_mul_right _ hr
    omega
  exact diagonalMonomial_notMem_span_X_pow r n hn1
    (hcN n (by omega) (Ideal.pow_le_pow_right hle (diagonalMonomial_mem_pow r n)))

/-- **Failure of strictness.** For `r ≥ 2` the inverse system
`H⁰(Kₙ) = ℤ[x]/(x₀ⁿ, …, x_{r-1}ⁿ)` of the Koszul complexes on the powers of the variables and
the adic system `ℤ[x]/Iⁿ` of the ideal `I = (x₀, …, x_{r-1})` they generate are *not* strictly
pro-isomorphic: there is no pair of strict pro-morphisms between them, in either direction,
whose composite is eventually the identity of the Koszul system. -/
@[stacks 0GA5 "the failure of strictness the remark asserts for systems (1) and (3) at \
`M = A[0]`: the system `H⁰(Kₙ) = A/(x₀ⁿ, …, x_{r-1}ⁿ)` over `A = ℤ[x₀, …, x_{r-1}]` admits no \
strict pro-isomorphism with the system `A/Iⁿ`, proved as the negation it is"]
public theorem not_strictProIso_monomial (r : ℕ) (hr : 2 ≤ r) :
    ¬ ∃ (φ : StrictProHomRep
          (AdicCompletionTor.idealPowerQuotientModuleSystem
            (Ideal.span (Set.range fun i : Fin r => (X i : MvPolynomial (Fin r) ℤ))))
          (Koszul.powQuotientSystem fun i : Fin r => (X i : MvPolynomial (Fin r) ℤ)))
        (ψ : StrictProHomRep
          (Koszul.powQuotientSystem fun i : Fin r => (X i : MvPolynomial (Fin r) ℤ))
          (AdicCompletionTor.idealPowerQuotientModuleSystem
            (Ideal.span (Set.range fun i : Fin r => (X i : MvPolynomial (Fin r) ℤ))))),
      (ψ.comp φ).Equivalent
        (StrictProHomRep.id (Koszul.powQuotientSystem fun i : Fin r =>
          (X i : MvPolynomial (Fin r) ℤ))) := by
  rintro ⟨φ, ψ, h⟩
  obtain ⟨N, hN⟩ := exists_uniform_pow_le_powIdeal_of_strictProSection _ φ ψ h
  refine not_exists_uniform_pow_le_monomialPow r hr ⟨φ.shift, N + 1, fun n hn => ?_⟩
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  rw [monomialIdeal, show m + 1 + φ.shift = m + φ.shift + 1 by omega]
  exact hN m (by omega)

/-- **Failure of strictness, in the strict pro-category.**  For `r ≥ 2` the inverse sequence
`A/Iⁿ` and the inverse sequence `H⁰(Kₙ) = A/(x₀ⁿ, …, x_{r-1}ⁿ)` over `A = ℤ[x₀, …, x_{r-1}]`
are not isomorphic as objects of the strict pro-category. -/
@[stacks 0GA5 "the failure of strictness for systems (1) and (3) at `M = A[0]`, stated as \
non-isomorphism of the two inverse sequences in the strict pro-category itself"]
public theorem not_nonempty_iso_proObj_monomial (r : ℕ) (hr : 2 ≤ r) :
    ¬ Nonempty
      (proObj (AdicCompletionTor.idealPowerQuotientModuleSystem
          (Ideal.span (Set.range fun i : Fin r => (X i : MvPolynomial (Fin r) ℤ)))) ≅
        proObj (Koszul.powQuotientSystem fun i : Fin r =>
          (X i : MvPolynomial (Fin r) ℤ))) := by
  rw [nonempty_iso_iff_exists_rep]
  rintro ⟨φ, ψ, -, hψφ⟩
  exact not_strictProIso_monomial r hr ⟨φ, ψ, hψφ⟩

end Stacks.LocalCohomology.UniformityII

end
