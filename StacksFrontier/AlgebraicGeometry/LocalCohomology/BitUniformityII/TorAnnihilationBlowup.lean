-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open RingedSpaceModuleAdjunction
open Stacks.Cohomology.FilteredComplex

universe u

namespace Stacks.Blowup

attribute [local instance 10000] HasDerivedCategory.standard

-- The commutativity of the rings of sections, carried by
-- `Stacks.Blowup.ringSheaf_isMulCommutative` in `DerivedPullbackCenterAnnihilation`: its
-- declaration travels with the import but its registration as an instance does not.
attribute [local instance] ringSheaf_isMulCommutative

variable {A : Type u} [CommRing A] (I : Ideal A)

/-- **The geometric input of [Stacks, Tag 0GA1], on the blowup.** Let `A` be a Noetherian ring
and `I = (g 0, …, g (t-1))` an ideal generated by at most `t` elements. There are `q₀`, `N` and
`c`, depending only on `A` and `I`, such that for every `A`-module `M`, every `i ≥ t` and every
`q ≥ q₀` there is a cohomological spectral sequence of `Γ(X, 𝒪_X)`-modules, `X` the blowup of
`Spec A` in `I`, which

* abuts to a graded family `H`,
* vanishes along the antidiagonal of degree `-i` outside the band of columns `0 ≤ p < N`,
* has every term of that antidiagonal annihilated by the ideal generated by the image of `Iᶜ`,
* and has `H(-i)`, read as an `A`-module, isomorphic to `Tor_i^A(M, Iᑫ)`.

It is the hypercohomology spectral sequence [Stacks, Tag 0G9Q] of `Lp^*M̃(q)`; the four clauses
are the four statements listed in the module documentation. This is exactly the hypothesis `hSS`
of `Stacks.LocalCohomology.UniformityII`
`.exists_pow_le_annihilator_tor_quotient_pow_of_abutsTo_restrictScalars`, with `ρ` the map
`Stacks.Blowup.blowUpCoeffScalar I` from `A` to the global functions of the blowup. -/
theorem exists_hypercohomologySpectralSequence_abutsTo_tor_idealPow [IsNoetherianRing A] {t : ℕ}
    (g : Fin t → A) (hg : I = Ideal.span (Set.range g)) :
    ∃ q₀ N c : ℕ,
      ∀ (M : ModuleCat.{u} A) (i q : ℕ), t ≤ i → q₀ ≤ q →
      ∃ (r₀ : ℤ) (E : CohomologicalSpectralSequence
            (ModuleCat.{u} Γ(blowUpSpec I, ⊤)) r₀)
        (H : ℤ → ModuleCat.{u} Γ(blowUpSpec I, ⊤)) (s : ℤ) (hs : r₀ ≤ s),
        SpectralSequence.AbutsTo E H ∧
        (∀ p : ℤ, p < 0 ∨ (N : ℤ) ≤ p → IsZero ((E.page s hs).X (p, -(i : ℤ) - p))) ∧
        (∀ p : ℤ, (I ^ c).map (blowUpCoeffScalar I : A →+* Γ(blowUpSpec I, ⊤)) ≤
          Module.annihilator Γ(blowUpSpec I, ⊤) ((E.page s hs).X (p, -(i : ℤ) - p))) ∧
        Nonempty ((ModuleCat.restrictScalars (blowUpCoeffScalar I)).obj (H (-(i : ℤ))) ≅
          ((Tor' (ModuleCat.{u} A) i).obj M).obj (ModuleCat.of A ↥(I ^ q))) := by
  obtain ⟨N, hN⟩ := exists_isZero_rightDerivedPlus_groupSections (blowUpSpec I)
  obtain ⟨q₀, hq₀⟩ :=
    exists_threshold_nonempty_derivedGlobalSectionsTwistedPullback_iso_derivedTensorIdealPow I
  obtain ⟨c, hc⟩ : ∃ c : ℕ, ∀ (M : ModuleCat.{u} A) (q p j : ℤ), j ≤ -(t : ℤ) → ∀ r ∈ I ^ c,
      blowUpCoeffScalar I r ∈ Module.annihilator Γ(blowUpSpec I, ⊤)
        (((hypercohomologySpectralSequence (blowUpSpec I).toRingedSpace
          (twistedDerivedPullbackQcoh I M q).obj).spectralSequence.page 2).X (p, j)) := by
    match t, g with
    | 0, _ =>
      -- No generators at all: `I = 0`, and `I¹ = 0` is mapped to the zero ideal.
      refine ⟨1, fun M q p j _ r hr => ?_⟩
      rw [hg, Set.range_eq_empty, Ideal.span_empty, pow_one, Submodule.mem_bot] at hr
      rw [hr, map_zero]
      exact zero_mem _
    | (n + 1), g =>
      obtain ⟨c, -, hann⟩ :=
        exists_pow_le_center_app_homology_twistedDerivedPullback_eq_zero I g hg
      refine ⟨c, fun M q p j hj r hr => ?_⟩
      obtain ⟨P, gres, hP, -, hgres, -⟩ := CochainComplex.KFlat.exists_kFlat_resolution.{u, u}
        ((CochainComplex.singleFunctor (ModuleCat.{u} (CommRingCat.of A)) 0).obj M)
      refine mem_annihilator_hypercohomologySpectralSequence_page_two
        (blowUpSpec I).toRingedSpace (twistedDerivedPullbackQcoh I M q).obj _
        (blowUpCoeffScalar I r) (fun F x => ?_) p j
        (hann M P hP gres hgres q j (by push_cast at hj ⊢; omega) r hr)
      rw [Stacks.SheafOfModules.terminalSectionToEnd_apply,
        show (blowUpCoeffScalar I r : Γ(blowUpSpec I, ⊤))
          = (toSpec I).appTop ((Scheme.ΓSpecIso (CommRingCat.of A)).inv r) from rfl,
        show (isTerminalTop (α := Opens (blowUpSpec I).toRingedSpace.carrier)).from
          (op (⊤ : Opens (blowUpSpec I).toRingedSpace.carrier)).unop = 𝟙 _ from
          isTerminalTop.hom_ext _ _]
      simp
  refine ⟨q₀, N, c, fun M i q hi hq => ?_⟩
  have hz := isZero_hypercohomologySpectralSequence_page_two (blowUpSpec I)
    (twistedDerivedPullbackQcoh I M (q : ℤ)) N hN
  refine ⟨2, (hypercohomologySpectralSequence (blowUpSpec I).toRingedSpace
      (twistedDerivedPullbackQcoh I M (q : ℤ)).obj).spectralSequence,
    fun n => (DerivedCategory.homologyFunctor (ModuleCat.{u} Γ(blowUpSpec I, ⊤)) n).obj
      ((hypercohomologySpectralSequence (blowUpSpec I).toRingedSpace
        (twistedDerivedPullbackQcoh I M (q : ℤ)).obj).truncation.RΓ.obj
          (twistedDerivedPullbackQcoh I M (q : ℤ)).obj),
    2, le_refl 2, hypercohomologySpectralSequence_abutsTo (blowUpSpec I)
      (twistedDerivedPullbackQcoh I M (q : ℤ)), fun p hp => hz p _ hp, ?_, ?_⟩
  · intro p
    rcases lt_or_ge p 0 with hp | hp
    · exact fun r _ => Stacks.LocalCohomology.UniformityII.mem_annihilator_of_isZero
        (A := Γ(blowUpSpec I, ⊤)) (hz p _ (Or.inl hp)) r
    · exact Ideal.map_le_iff_le_comap.mpr fun r hr =>
        Ideal.mem_comap.mpr (hc M (q : ℤ) p (-(i : ℤ) - p) (by omega) r hr)
  · obtain ⟨e⟩ := hq₀ q hq M
    obtain ⟨eTor⟩ :=
      AdicCompletionTor.nonempty_derivedTensorSingleHomology_iso_Tor' _ M
        (ModuleCat.of A (I ^ q : Ideal A)) i
    exact ⟨baseHypercohomologyIso (toSpec I)
        (hypercohomologySpectralSequence (blowUpSpec I).toRingedSpace
          (twistedDerivedPullbackQcoh I M (q : ℤ)).obj).representative
        (hypercohomologySpectralSequence (blowUpSpec I).toRingedSpace
          (twistedDerivedPullbackQcoh I M (q : ℤ)).obj).truncation
        (twistedDerivedPullbackQcoh I M (q : ℤ)).obj (-(i : ℤ)) ≪≫
      (DerivedCategory.homologyFunctor (ModuleCat.{u} A) (-(i : ℤ))).mapIso e ≪≫ eTor⟩

end Stacks.Blowup

namespace Stacks.LocalCohomology.UniformityII

variable {A : Type u} [CommRing A]

/-- **Stacks Project, Tag 0GA1.** Let `A` be a Noetherian ring and let `I = (g 0, …, g (t-1))` be
an ideal of `A` generated by at most `t` elements, as in the Situation of [Stacks, Tag 0G9W].
There is an integer `m`, depending only on `A` and `I`, such that for *every* `A`-module `M` the
modules `Tor_i^A(M, A/I^q)` are annihilated by `I^m` for all `i > t` and all `q ≥ 0`.

Nothing is assumed. The spectral sequence the source's proof runs on is produced by
`Stacks.Blowup.exists_hypercohomologySpectralSequence_abutsTo_tor_idealPow` on the blowup of
`Spec A` in `I`, and the step from it to the filtration of `Tor_i^A(M, Iᑫ)` that
`Stacks.LocalCohomology.UniformityII.exists_pow_le_annihilator_tor_quotient_pow` asks for is
`Stacks.LocalCohomology.UniformityII`
`.exists_pow_le_annihilator_tor_quotient_pow_of_abutsTo_restrictScalars`. -/
@[stacks 0GA1]
theorem exists_pow_le_annihilator_tor_quotient_pow_blowup [IsNoetherianRing A] {I : Ideal A}
    {t : ℕ} (g : Fin t → A) (hg : I = Ideal.span (Set.range g)) :
    ∃ m : ℕ, ∀ (M : ModuleCat.{u} A) (i q : ℕ), t < i →
      I ^ m ≤ Module.annihilator A
        (((Tor' (ModuleCat.{u} A) i).obj M).obj (ModuleCat.of A (A ⧸ I ^ q))) := by
  obtain ⟨q₀, N, c, hSS⟩ :=
    Stacks.Blowup.exists_hypercohomologySpectralSequence_abutsTo_tor_idealPow I g hg
  exact exists_pow_le_annihilator_tor_quotient_pow_of_abutsTo_restrictScalars
    (R := Γ(Stacks.Blowup.blowUpSpec I, ⊤)) g hg (Stacks.Blowup.blowUpCoeffScalar I) q₀ N c hSS

end Stacks.LocalCohomology.UniformityII

end
