module

public import Mathlib.AlgebraicGeometry.FunctionField
public import Mathlib.RingTheory.RingHom.Flat
public import StacksFrontier.AlgebraicGeometry.LocalCohomology.CodimensionOneObstruction.PuncturedSpectrumObstruction
public import
  StacksFrontier.AlgebraicGeometry.LocalCohomology.CodimensionOneObstruction.SectionsEnlargement
public import
  StacksFrontier.AlgebraicGeometry.LocalCohomology.CodimensionOneObstruction.SectionsFlatBaseChange
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Non-coherence of `j_* 𝒪_U` from an associated prime of the completed local ring

Let `X` be an integral locally Noetherian scheme, let `j : U → X` be the inclusion of a nonempty
open subscheme and let `z` be a point outside `U`. If the completion `𝒪^∧_{X, z}` has an associated
prime `𝔭` with `dim(𝒪^∧_{X, z} ⧸ 𝔭) = 1`, then `j_* 𝒪_U` is not coherent. This file also proves
that finiteness of the sections over an open, and over a punctured spectrum, is preserved by
suitable flat base changes, and places the preimage of `U` in `Spec 𝒪_{X, z}` inside the punctured
spectrum.

## Main results

* `preimage_puncturedSpectrum`: for a homomorphism of local rings whose target's maximal ideal
  is generated by the image of the source's, the punctured spectrum of the target is the
  preimage of the punctured spectrum of the source.
* `preimage_le_puncturedSpectrum`: the preimage in `Spec 𝒪_{X, z}` of an open missing `z` lies
  in the punctured spectrum.
* `nonempty_preimage_fromSpecStalk_of_specializes`: the preimage in `Spec 𝒪_{X, z}` of an open
  containing a point specializing to `z` is nonempty.
* `moduleFinite_sections_preimage_fromSpecStalk`: finiteness of the sections over an open passes to
  the sections over its preimage in `Spec 𝒪_{S, z}`.
* `moduleFinite_sections_puncturedSpectrum_of_maximalIdeal_eq_map`: finiteness of the sections over
  the punctured spectrum passes along a flat homomorphism of local rings whose target's maximal
  ideal is generated by the image of the source's.
* `moduleFinite_sections_inf_of_isCoherent`: a coherent direct image of the structure sheaf has
  finite sections over an affine open.
* `not_moduleFinite_sections_of_isAssociatedPrime_of_flat`: on an affine integral Noetherian
  scheme, `Γ(X, U)` is not finite over `Γ(X, ⊤)` when some Noetherian local ring receiving a flat
  homomorphism from `𝒪_{X, z}` which generates its maximal ideal has a one-dimensional associated
  prime.
* `not_moduleFinite_sections_of_isAssociatedPrime_completedStalk`: the same conclusion when the
  completion `𝒪^∧_{X, z}` has a one-dimensional associated prime.
* `not_isCoherent_pushforward_structureSheaf_of_isAssociatedPrime_completedStalk`: `j_* 𝒪_U` is
  not coherent when `𝒪^∧_{X, z}` has a one-dimensional associated prime; this is the converse of
  [Stacks, Tag 0BK1].

## References

* [Stacks Project, Tag 0AWC](https://stacks.math.columbia.edu/tag/0AWC)
* [Stacks Project, Tag 02KH](https://stacks.math.columbia.edu/tag/02KH)
* [Stacks Project, Tag 0BK1](https://stacks.math.columbia.edu/tag/0BK1)
-/

@[expose] public noncomputable section

universe u

open CategoryTheory TopologicalSpace AlgebraicGeometry IsLocalRing
open Stacks.LocalCohomology (puncturedSpectrum)

namespace Stacks.AlgebraicGeometry.CodimensionOneObstruction

/-! ### Placing an open inside the punctured spectrum of a local ring -/

/-- **The punctured spectrum of the target is the preimage of the punctured spectrum of the
source**, for a homomorphism of local rings whose target's maximal ideal is generated by the
image of the source's. -/
theorem preimage_puncturedSpectrum {R S : CommRingCat.{u}} [IsLocalRing R] [IsLocalRing S]
    (f : R ⟶ S) (hf : maximalIdeal S = (maximalIdeal R).map f.hom) :
    Spec.map f ⁻¹ᵁ puncturedSpectrum R = puncturedSpectrum S :=
  TopologicalSpace.Opens.ext (Set.ext fun q =>
    not_congr (comap_eq_closedPoint_iff_of_maximalIdeal_eq_map f.hom hf q))

/-- **The preimage of an open missing `z` lies in the punctured spectrum of `𝒪_{X, z}`.** -/
theorem preimage_le_puncturedSpectrum {X : Scheme.{u}} {z : X} {U : X.Opens} (hz : z ∉ U) :
    X.fromSpecStalk z ⁻¹ᵁ U ≤ puncturedSpectrum (X.presheaf.stalk z) := by
  intro s hs hcon
  subst hcon
  exact hz (X.fromSpecStalk_closedPoint (x := z) ▸ hs)

/-- **The preimage in `Spec 𝒪_{X, z}` of an open containing a point specializing to `z` is
nonempty.** -/
theorem nonempty_preimage_fromSpecStalk_of_specializes {X : Scheme.{u}} {x z : X} (h : x ⤳ z)
    {U : X.Opens} (hx : x ∈ U) : Nonempty (X.fromSpecStalk z ⁻¹ᵁ U).toScheme := by
  obtain ⟨s, hs⟩ : x ∈ Set.range (X.fromSpecStalk z) := by rwa [Scheme.range_fromSpecStalk]
  exact ⟨⟨s, show X.fromSpecStalk z s ∈ U from hs ▸ hx⟩⟩

/-! ### Finiteness of sections under flat base change -/

/-- Let `S` be an affine scheme whose underlying space is Noetherian, let `z` be a point of it and
let `W` be an open. If `Γ(S, W)` is a finite `Γ(S, ⊤)`-module, then the sections over the preimage
of `W` in `Spec 𝒪_{S, z}` are a finite module over the global sections of `Spec 𝒪_{S, z}`. -/
theorem moduleFinite_sections_preimage_fromSpecStalk {S : Scheme.{u}} [IsAffine S]
    [NoetherianSpace S] (z : S) (W : S.Opens)
    (h : letI := resAlgebra (le_top (a := W)); Module.Finite Γ(S, ⊤) Γ(S, W)) :
    letI := resAlgebra (le_top (a := S.fromSpecStalk z ⁻¹ᵁ W))
    Module.Finite Γ(Spec (S.presheaf.stalk z), ⊤)
      Γ(Spec (S.presheaf.stalk z), S.fromSpecStalk z ⁻¹ᵁ W) :=
  have := noetherianSpace_toScheme W
  have : Flat (S.fromSpecStalk z) := flat_fromSpecStalk S z
  moduleFinite_sections_preimage_of_flat (S.fromSpecStalk z) W h

/-- Let `f : R ⟶ S` be a flat homomorphism of local rings with `R` Noetherian and with the maximal
ideal of `S` generated by the image of the maximal ideal of `R`. If the sections over the punctured
spectrum of `Spec R` are a finite `R`-module, then so are the sections over the punctured spectrum
of `Spec S`. -/
theorem moduleFinite_sections_puncturedSpectrum_of_maximalIdeal_eq_map {R S : CommRingCat.{u}}
    [IsLocalRing R] [IsNoetherianRing R] [IsLocalRing S] (f : R ⟶ S) (hflat : f.hom.Flat)
    (hf : maximalIdeal S = (maximalIdeal R).map f.hom)
    (h : letI := resAlgebra (le_top (a := puncturedSpectrum R));
      Module.Finite Γ(Spec R, ⊤) Γ(Spec R, puncturedSpectrum R)) :
    letI := resAlgebra (le_top (a := puncturedSpectrum S))
    Module.Finite Γ(Spec S, ⊤) Γ(Spec S, puncturedSpectrum S) := by
  have : Flat (Spec.map f) := Flat.SpecMap_iff.mpr hflat
  have := noetherianSpace_toScheme (puncturedSpectrum R)
  have hres := moduleFinite_sections_preimage_of_flat (Spec.map f) (puncturedSpectrum R) h
  rwa [preimage_puncturedSpectrum f hf] at hres

/-! ### Coherence of the direct image, read on an affine open -/

/-- **A coherent direct image of the structure sheaf has finite sections over an affine open.**
If `(S → X)_* 𝒪_S` is coherent and `V₀` is an affine open of a locally Noetherian scheme `X`,
then `Γ(X, S ⊓ V₀)` is a finite `Γ(X, V₀)`-module. -/
@[ega "IV 7.2.4" "(e)"]
theorem moduleFinite_sections_inf_of_isCoherent {X : Scheme.{u}} [IsLocallyNoetherian X]
    {V₀ : X.Opens} (hV₀ : IsAffineOpen V₀) (S : X.Opens)
    (hcoh : ((Scheme.Modules.pushforward S.ι).obj (SheafOfModules.unit _)).IsCoherent) :
    letI := resAlgebra (inf_le_right : S ⊓ V₀ ≤ V₀); Module.Finite Γ(X, V₀) Γ(X, S ⊓ V₀) := by
  let _ := resAlgebra (inf_le_right : S ⊓ V₀ ≤ V₀)
  have : Module.Finite Γ(X, V₀)
      Γ((Scheme.Modules.pushforward S.ι).obj (SheafOfModules.unit _), V₀) :=
    AlgebraicGeometry.moduleFinite_sections _ ⟨V₀, hV₀⟩
  exact Module.Finite.of_surjective (pushforwardSectionsHom S V₀)
    (pushforwardSectionsHom_surjective S V₀)

/-! ### Infinite sections on an affine scheme -/

/-- Let `X` be an affine integral Noetherian scheme, let `U` be an open, let `z` be a point outside
`U` and let `x` be a point of `U` specializing to `z`. Let `Λ` be a Noetherian local ring receiving
a flat homomorphism from `𝒪_{X, z}` which generates its maximal ideal, and suppose `Λ` has a prime
`𝔭` which is the annihilator of one of its elements and satisfies `dim(Λ ⧸ 𝔭) = 1`. Then `Γ(X, U)`
is not a finite `Γ(X, ⊤)`-module.

The scalar action is restriction of sections. -/
theorem not_moduleFinite_sections_of_isAssociatedPrime_of_flat {X : Scheme.{u}} [IsAffine X]
    [IsIntegral X] [IsLocallyNoetherian X] [NoetherianSpace X] {U : X.Opens} {x z : X}
    (hxz : x ⤳ z) (hxU : x ∈ U) (hzU : z ∉ U) (Λ : CommRingCat.{u}) [IsLocalRing Λ]
    [IsNoetherianRing Λ] (f : X.presheaf.stalk z ⟶ Λ) (hflat : f.hom.Flat)
    (hmax : maximalIdeal Λ = (maximalIdeal (X.presheaf.stalk z)).map f.hom)
    {p : PrimeSpectrum Λ} (hp : IsAssociatedPrimeStacks Λ Λ p.asIdeal)
    (hdim : ringKrullDim (Λ ⧸ p.asIdeal) = 1) :
    ¬ (letI := resAlgebra (le_top (a := U)); Module.Finite Γ(X, ⊤) Γ(X, U)) := by
  intro hfin
  have h₁ := moduleFinite_sections_preimage_fromSpecStalk z U hfin
  have : Nonempty (X.fromSpecStalk z ⁻¹ᵁ U).toScheme :=
    nonempty_preimage_fromSpecStalk_of_specializes hxz hxU
  have h₂ := moduleFinite_sections_puncturedSpectrum_of_le (X.presheaf.stalk z)
    (preimage_le_puncturedSpectrum hzU) h₁
  have h₃ := moduleFinite_sections_puncturedSpectrum_of_maximalIdeal_eq_map f hflat hmax h₂
  exact not_moduleFinite_sections_puncturedSpectrum_of_isAssociatedPrime Λ hp hdim h₃

/-- Let `X` be an affine integral Noetherian scheme, let `U` be an open, let `z` be a point outside
`U` and let `x` be a point of `U` specializing to `z`. If the completion `𝒪^∧_{X, z}` has a prime
`𝔭` which is the annihilator of one of its elements and satisfies `dim(𝒪^∧_{X, z} ⧸ 𝔭) = 1`, then
`Γ(X, U)` is not a finite `Γ(X, ⊤)`-module. -/
theorem not_moduleFinite_sections_of_isAssociatedPrime_completedStalk {X : Scheme.{u}}
    [IsAffine X] [IsIntegral X] [IsLocallyNoetherian X] [NoetherianSpace X] {U : X.Opens}
    {x z : X} (hxz : x ⤳ z) (hxU : x ∈ U) (hzU : z ∉ U)
    {p : PrimeSpectrum (X.completedLocalRingCat z)}
    (hp : IsAssociatedPrimeStacks (X.completedLocalRingCat z) (X.completedLocalRingCat z)
      p.asIdeal)
    (hdim : ringKrullDim (X.completedLocalRingCat z ⧸ p.asIdeal) = 1) :
    ¬ (letI := resAlgebra (le_top (a := U)); Module.Finite Γ(X, ⊤) Γ(X, U)) :=
  not_moduleFinite_sections_of_isAssociatedPrime_of_flat hxz hxU hzU
    (X.completedLocalRingCat z) (X.toCompletedLocalRing z)
    (AdicCompletion.flat_of_isNoetherian _) AdicCompletion.maximalIdeal_eq_map hp hdim

/-! ### Non-coherence of the direct image -/

/-- **A one-dimensional associated prime of the completed local ring obstructs coherence of the
direct image of the structure sheaf.** Let `j : U → X` be an open immersion of integral locally
Noetherian schemes and let `z` be a point of `X` outside `U`. If the completion `𝒪^∧_{X, z}` has an
associated prime `𝔭` — a prime which is the annihilator of one of its elements — with
`dim(𝒪^∧_{X, z} ⧸ 𝔭) = 1`, then `j_* 𝒪_U` is not coherent. -/
@[stacks 0AWC "second paragraph", ega "IV 7.2.4" "(e) ⇒ (f)"]
theorem not_isCoherent_pushforward_structureSheaf_of_isAssociatedPrime_completedStalk
    {X : Scheme.{u}} [IsIntegral X] [IsLocallyNoetherian X] {U : X.Opens}
    [Nonempty U.toScheme] {z : X} (hzU : z ∉ U)
    {p : PrimeSpectrum (X.completedLocalRingCat z)}
    (hp : IsAssociatedPrimeStacks (X.completedLocalRingCat z) (X.completedLocalRingCat z)
      p.asIdeal)
    (hdim : ringKrullDim (X.completedLocalRingCat z ⧸ p.asIdeal) = 1) :
    ¬ ((Scheme.Modules.pushforward U.ι).obj (SheafOfModules.unit _)).IsCoherent := by
  intro hcoh
  have hxU : genericPoint X ∈ U :=
    ((genericPoint_spec X).mem_open_set_iff U.isOpen).mpr (by simpa using ‹Nonempty U.toScheme›)
  have hxz : genericPoint X ⤳ z := genericPoint_specializes z
  obtain ⟨V₀, hV₀, hzV₀, -⟩ := AlgebraicGeometry.exists_isAffineOpen_mem_and_subset
    (U := (⊤ : X.Opens)) (x := z) trivial
  have hxV₀ : genericPoint X ∈ V₀ := hxz.mem_open V₀.isOpen hzV₀
  have h₁ := (moduleFinite_sections_restrict_iff V₀ U).mpr
    (moduleFinite_sections_inf_of_isCoherent hV₀ U hcoh)
  have : IsAffine V₀.toScheme := hV₀
  have : Nonempty V₀.toScheme := ⟨⟨z, hzV₀⟩⟩
  have : IsNoetherian V₀.toScheme := ⟨⟩
  set z' : V₀.toScheme := ⟨z, hzV₀⟩
  have hbij : Function.Bijective (V₀.stalkIso z').hom.hom :=
    (V₀.stalkIso z').commRingCatIsoToRingEquiv.bijective
  have hiso : (maximalIdeal (V₀.toScheme.presheaf.stalk z')).map (V₀.stalkIso z').hom.hom
      = maximalIdeal (X.presheaf.stalk z) :=
    eq_maximalIdeal ((maximalIdeal.isMaximal _).map_bijective _ hbij)
  refine not_moduleFinite_sections_of_isAssociatedPrime_of_flat
    (X := V₀.toScheme) (x := ⟨genericPoint X, hxV₀⟩) (z := z') (U := V₀.ι ⁻¹ᵁ U)
    (Topology.IsEmbedding.subtypeVal.specializes_iff.mp hxz) hxU hzU
    (X.completedLocalRingCat z) ((V₀.stalkIso z').hom ≫ X.toCompletedLocalRing z) ?_ ?_ hp hdim h₁
  · rw [CommRingCat.hom_comp]
    exact (RingHom.Flat.of_bijective (f := (V₀.stalkIso z').hom.hom) hbij).comp
      (AdicCompletion.flat_of_isNoetherian _ : (X.toCompletedLocalRing z).hom.Flat)
  · rw [CommRingCat.hom_comp, ← Ideal.map_map, hiso]
    exact AdicCompletion.maximalIdeal_eq_map

end Stacks.AlgebraicGeometry.CodimensionOneObstruction

end
