module

public import Mathlib.RingTheory.LocalRing.RingHom.Basic
public import Mathlib.RingTheory.Localization.AtPrime.Basic
public import StacksFrontier.RingTheory.Ideal.AssociatedPrime.Defs
public import
  StacksFrontier.AlgebraicGeometry.LocalCohomology.CodimensionOneObstruction.CompletedLocalSpectrum
public import StacksFrontier.AlgebraicGeometry.LocalCohomology.PuncturedSpectrum

/-!
# The punctured spectrum of a completed local ring, and associated primes after localization

Let `R` be a Noetherian local ring and `R^∧` its completion. A prime `𝔭 ∈ Ass(R)` gives the
maximal ideal of `R_𝔭` as an associated prime of `R_𝔭`, and the punctured spectrum of `Spec R^∧`
is the preimage of the punctured spectrum of `Spec R`. Associated primes are taken in the sense
of [Stacks, Tag 00LA], `IsAssociatedPrimeStacks`: the annihilator of an element is equal to the
prime.

## Main results

All three live in the namespace `Stacks.AlgebraicGeometry.CodimensionOneObstruction`.

* `isAssociatedPrimeStacks_maximalIdeal_of_isLocalization`: if a prime `𝔭` is the annihilator of
  an element of `R`, then the maximal ideal of `R_𝔭` is the annihilator of an element of `R_𝔭`.
* `comap_eq_closedPoint_iff_of_maximalIdeal_eq_map`: for a homomorphism of local rings carrying
  the maximal ideal onto a generating set of the target's maximal ideal, the only prime
  contracting to the closed point is the closed point.
* `preimage_puncturedSpectrum_completedLocalRing`: the punctured spectrum of `Spec 𝒪^∧_{X, x}` is
  the preimage of the punctured spectrum of `Spec 𝒪_{X, x}`.

## References

* [Stacks Project, Tag 0AWC](https://stacks.math.columbia.edu/tag/0AWC)
* [Stacks Project, Tag 00LA](https://stacks.math.columbia.edu/tag/00LA)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory IsLocalRing
open Stacks.LocalCohomology (puncturedSpectrum)

universe u

namespace Stacks.AlgebraicGeometry.CodimensionOneObstruction

/-! ### Associated primes and localization -/

/-- **An associated prime of a ring localizes to the maximal ideal of the local ring there.** If
the prime `𝔭` of `R` is the annihilator of an element `m` of `R`, then the maximal ideal of a
localization `S` of `R` at `𝔭` is the annihilator of the image of `m`. -/
theorem isAssociatedPrimeStacks_maximalIdeal_of_isLocalization {R : Type*} [CommRing R]
    {p : Ideal R} (S : Type*) [CommRing S] [Algebra R S] [IsLocalRing S] [hp : p.IsPrime]
    [IsLocalization.AtPrime S p] (h : IsAssociatedPrimeStacks R R p) :
    IsAssociatedPrimeStacks S S (maximalIdeal S) := by
  obtain ⟨-, m, hm⟩ := h
  have hann : ∀ a : R, a * m = 0 ↔ a ∈ p := fun a ↦ by
    rw [← hm, Submodule.mem_colon_span_singleton, Submodule.mem_bot, smul_eq_mul]
  refine ⟨(maximalIdeal.isMaximal S).isPrime, algebraMap R S m, ?_⟩
  ext b
  rw [Submodule.mem_colon_span_singleton, Submodule.mem_bot]
  obtain ⟨⟨a, s⟩, rfl⟩ := IsLocalization.mk'_surjective p.primeCompl b
  dsimp only
  rw [smul_eq_mul, ← IsLocalization.mk'_one (M := p.primeCompl) S m,
    ← IsLocalization.mk'_mul, IsLocalization.mk'_eq_zero_iff,
    IsLocalization.AtPrime.mk'_mem_maximal_iff (S := S) (I := p) a s ‹IsLocalRing S›]
  refine ⟨fun ⟨t, ht⟩ ↦ ?_, fun ha ↦ ⟨1, by simpa using (hann a).mpr ha⟩⟩
  have ht' : (↑t * a) * m = 0 := by rw [← ht]; ring
  exact (hp.mem_or_mem ((hann _).mp ht')).resolve_left t.2

/-! ### The punctured spectrum -/

/-- **Only the closed point contracts to the closed point**, for a homomorphism of local rings
whose target's maximal ideal is generated by the image of the source's. -/
theorem comap_eq_closedPoint_iff_of_maximalIdeal_eq_map {R S : Type*} [CommRing R] [CommRing S]
    [IsLocalRing R] [IsLocalRing S] (f : R →+* S)
    (hf : maximalIdeal S = (maximalIdeal R).map f) (q : PrimeSpectrum S) :
    PrimeSpectrum.comap f q = closedPoint R ↔ q = closedPoint S := by
  have : IsLocalHom f := ((local_hom_TFAE f).out 4 1).mp (hf ▸ Ideal.le_comap_map)
  refine ⟨fun h ↦ PrimeSpectrum.ext ((maximalIdeal.isMaximal S).eq_of_le q.isPrime.ne_top ?_).symm,
    fun h ↦ by rw [h]; exact comap_closedPoint f⟩
  rw [hf, Ideal.map_le_iff_le_comap]
  exact (congrArg PrimeSpectrum.asIdeal h).ge

/-- **The punctured spectrum of `Spec 𝒪^∧_{X, x}` is the preimage of the punctured spectrum of
`Spec 𝒪_{X, x}`.** -/
theorem preimage_puncturedSpectrum_completedLocalRing {X : Scheme.{u}} [IsLocallyNoetherian X]
    (x : X) :
    Spec.map (X.toCompletedLocalRing x) ⁻¹ᵁ puncturedSpectrum (X.presheaf.stalk x)
      = puncturedSpectrum (X.completedLocalRingCat x) :=
  TopologicalSpace.Opens.ext (Set.ext fun q =>
    not_congr (comap_eq_closedPoint_iff_of_maximalIdeal_eq_map (X.toCompletedLocalRing x).hom
      AdicCompletion.maximalIdeal_eq_map q))

end Stacks.AlgebraicGeometry.CodimensionOneObstruction

end
