/-!
# The threshold `q(S)` of Tag 0GA6 depends only on `S = Gr_I(A)`

Let `A` be a Noetherian ring and `I ⊆ A` an ideal, `X` the blowup of `Spec(A)` in `I` and
`Y ⊆ X` the exceptional divisor. [Stacks, Tag 0GA6] defines `q(S)`, `S = Gr_I(A)`, through the
cohomology of `𝒪_Y(q)` on `Y = Proj(S)` — "since taking `Proj` commutes with base change" — and
notes that it only depends on `S`. This library states the defining property on the blowup, as
`IsBaseThreshold` (the cohomology of `𝒪_Y(q) = 𝒪_{Y₁}(q)` on `X` and the canonical map
`I^q/I^{q+1} → H⁰(X, 𝒪_Y(q))`). This file proves the source's two remarks:

* `isBaseThreshold_iff_isGrThreshold`: for any surjection of graded rings `π` from the Rees
  algebra onto a graded ring `𝒢` whose kernel in degree `n` is `I^{n+1}` (`IsGrQuotient`, i.e.
  `𝒢 = Gr_I(A)`), `IsBaseThreshold I q₀` holds exactly when `IsGrThreshold 𝒢 q₀` does: for
  `q ≥ q₀`, `Hⁱ(Proj 𝒢, 𝒪(q)) = 0` for `i ≥ 1` and `𝒢_q → H⁰(Proj 𝒢, 𝒪(q))` is bijective.
* `isBaseThreshold_iff_of_sameInitialForms`: two quotients `R ⧸ J`, `R ⧸ J'` of a Noetherian ring
  whose ideals have the same initial forms for `𝔞` (`SameInitialForms`, which is how
  `Gr_𝔞(R ⧸ J) = Gr_𝔞(R ⧸ J')` comes out of Stacks 07VF) have the same thresholds. This is the
  input of step (C) of the proof of Stacks 0GAR.

## The route

* `Proj(Gr) ⟶ X` is a closed immersion with the ideal sheaf of `Y` (`ker_grImmersion`): on the
  chart `D₊(b⁽¹⁾)` both are generated by the image of `I` (`ker_awayMap_eq_map_chartAwayMap`,
  `ideal_comap_toSpec_basicOpen`, the latter from the chart computation of
  `Stacks.Blowup.ideal_comap_toSpec_eq_span_chartGenerator`).
* Hence `𝒪_Y(q) ≅ j_*𝒪_{Proj(Gr)}(q)` (`grTwistIso`), by the projection formula at a closed
  immersion and the identification of the pulled-back twist of Tag 01N1 (3); it carries the
  canonical section of `x ∈ I^q` to the canonical section of its class in `Gr_q`
  (`grTwistIso_thickeningSections`), and [Stacks, Tag 089W] transports the cohomology.
* For the comparison of two quotients both `Gr`'s are written as quotients of `R[T₀, …, T_d]` by
  the forms vanishing in them (`initialFormIdeal`), `Tⱼ ↦ x̄ⱼ` for a generating family of `𝔞`,
  and these homogeneous ideals are equal when the initial forms agree (`initialFormIdeal_eq`).
  No isomorphism of graded rings has to be transported: the two thresholds are the same
  proposition about the same graded ring.

## References

* [Stacks Project, Tag 0GA6](https://stacks.math.columbia.edu/tag/0GA6)
* [Stacks Project, Tag 0GAR](https://stacks.math.columbia.edu/tag/0GAR)
* [Stacks Project, Tag 07VF](https://stacks.math.columbia.edu/tag/07VF)
* [Stacks Project, Tag 089W](https://stacks.math.columbia.edu/tag/089W)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open AlgebraicGeometry
open AlgebraicGeometry.ProjectiveSpectrum.Proj (twistingSheaf degreeSection)
open Stacks.AlgebraicGeometry.PullbackUnit (pullbackSection)

universe u

namespace Stacks.LocalCohomology.UniformityIII

attribute [local instance] MvPolynomial.gradedAlgebra

section Presentation

variable {R : Type u} [CommRing R] (𝔞 : Ideal R) {d : ℕ} (x : Fin (d + 1) → R)
  (hx : ∀ j, x j ∈ 𝔞) (J : Ideal R)

/-- The images of `x₀, …, x_d` lie in `𝔞 · (R ⧸ J)`. -/
theorem mk_mem_map (hx : ∀ j, x j ∈ 𝔞) (J : Ideal R) (j : Fin (d + 1)) :
    Ideal.Quotient.mk J (x j) ∈ 𝔞.map (Ideal.Quotient.mk J) :=
  Ideal.mem_map_of_mem _ (hx j)

/-- Reduction of the coefficients of `R[T₀, …, T_d]` modulo `J`, as a map of graded rings. -/
def mvPolynomialMapGraded :
    MvPolynomial.homogeneousSubmodule (Fin (d + 1)) R →+*ᵍ
      MvPolynomial.homogeneousSubmodule (Fin (d + 1)) (R ⧸ J) where
  toRingHom := MvPolynomial.map (Ideal.Quotient.mk J)
  map_mem {_ _} hp := (MvPolynomial.mem_homogeneousSubmodule _ _).2
    (((MvPolynomial.mem_homogeneousSubmodule _ _).1 hp).map _)

/-- **The presentation of the Rees algebra of `𝔞 · (R ⧸ J)` by `R[T₀, …, T_d]`**, `Tⱼ ↦ x̄ⱼ` in
degree one: the polynomial presentation `Stacks.Blowup.reesPresentation` of `R ⧸ J` composed
with reduction of the coefficients modulo `J`. -/
def reesPresentationQuot :
    MvPolynomial.homogeneousSubmodule (Fin (d + 1)) R →+*ᵍ
      Stacks.Blowup.reesGrading (𝔞.map (Ideal.Quotient.mk J)) :=
  (Stacks.Blowup.reesPresentation (𝔞.map (Ideal.Quotient.mk J))
    (fun j ↦ Ideal.Quotient.mk J (x j)) (mk_mem_map 𝔞 x hx J)).comp (mvPolynomialMapGraded J)

/-- `reesPresentationQuot` sends `p` to the image under `reesPresentation` of its reduction
modulo `J`. -/
theorem reesPresentationQuot_apply (p : MvPolynomial (Fin (d + 1)) R) :
    reesPresentationQuot 𝔞 x hx J p =
      Stacks.Blowup.reesPresentation (𝔞.map (Ideal.Quotient.mk J))
        (fun j ↦ Ideal.Quotient.mk J (x j)) (mk_mem_map 𝔞 x hx J)
        (MvPolynomial.map (Ideal.Quotient.mk J) p) :=
  rfl

/-- **The presentation is surjective** when `x` generates `𝔞`. -/
theorem surjective_reesPresentationQuot (hspan : 𝔞 = Ideal.span (Set.range x)) :
    Function.Surjective (reesPresentationQuot 𝔞 x hx J) := by
  intro y
  obtain ⟨q, rfl⟩ := Stacks.Blowup.surjective_reesPresentation (𝔞.map (Ideal.Quotient.mk J))
    (fun j ↦ Ideal.Quotient.mk J (x j)) (mk_mem_map 𝔞 x hx J)
    (by rw [hspan, Ideal.map_span, ← Set.range_comp]; rfl) y
  obtain ⟨p, rfl⟩ := MvPolynomial.map_surjective _ Ideal.Quotient.mk_surjective q
  exact ⟨p, reesPresentationQuot_apply 𝔞 x hx J p⟩

/-- On a homogeneous polynomial of degree `n` the presentation is the monomial `p(x̄) Tⁿ`. -/
theorem coe_reesPresentationQuot_apply {p : MvPolynomial (Fin (d + 1)) R} {n : ℕ}
    (hp : p.IsHomogeneous n) :
    ((reesPresentationQuot 𝔞 x hx J p : reesAlgebra (𝔞.map (Ideal.Quotient.mk J))) :
        Polynomial (R ⧸ J)) =
      Polynomial.monomial n (Ideal.Quotient.mk J (MvPolynomial.eval x p)) := by
  rw [reesPresentationQuot_apply, Stacks.Blowup.coe_reesPresentation_apply _ _ _
    (hp.map _), MvPolynomial.eval_map]
  congr 1
  exact (MvPolynomial.eval₂_comp_left (Ideal.Quotient.mk J) (RingHom.id R) x p).symm

end Presentation

/-! ### The ideal generated by `𝔠` on a chart of the blowup -/

section Chart

open Polynomial HomogeneousLocalization Stacks.Blowup

variable {C : Type u} [CommRing C] {𝔠 : Ideal C} {b : C} (hb : b ∈ 𝔠)

/-- The image of `c ∈ C` on the chart `D₊(b⁽¹⁾)` is the fraction `c / (b⁽¹⁾)⁰`. -/
theorem chartAwayMap_eq_awayMk' (c : C) :
    chartAwayMap 𝔠 hb c = Away.mk (reesGrading 𝔠) (reesDegOne_mem_reesGrading 𝔠 hb) 0
      ((reesGradingZeroEquiv 𝔠 c : reesGrading 𝔠 0) : reesAlgebra 𝔠)
      (by simpa using (reesGradingZeroEquiv 𝔠 c).2) := by
  apply HomogeneousLocalization.val_injective
  rw [chartAwayMap_val, Away.val_mk]
  congr 1

/-- A homogeneous element of degree `n • 1` of the Rees algebra is a monomial. -/
theorem coe_eq_monomial_smul {n : ℕ} {y : reesAlgebra 𝔠} (hy : y ∈ reesGrading 𝔠 (n • 1)) :
    ((y : C[X])) = monomial n ((y : C[X]).coeff n) :=
  coe_eq_monomial 𝔠 (by simpa using hy)

/-- The coefficients of an element of the Rees algebra lie in the powers of the ideal. -/
theorem coeff_mem_pow (y : reesAlgebra 𝔠) (n : ℕ) : ((y : C[X])).coeff n ∈ 𝔠 ^ n :=
  (mem_reesAlgebra_iff 𝔠 _).1 y.2 n

/-- **Two fractions on the chart `D₊(b⁽¹⁾)` that agree have proportional numerators**: if
`y / (b⁽¹⁾)ⁿ = y' / (b⁽¹⁾)ⁿ'` then `bᴹ⁺ⁿ' c = bᴹ⁺ⁿ c'` for some `M`, `c` and `c'` being the
coefficients of `y` and `y'`. -/
theorem exists_pow_mul_coeff_eq {n n' : ℕ} {y y' : reesAlgebra 𝔠}
    (hy : y ∈ reesGrading 𝔠 (n • 1)) (hy' : y' ∈ reesGrading 𝔠 (n' • 1))
    (h : Away.mk (reesGrading 𝔠) (reesDegOne_mem_reesGrading 𝔠 hb) n y hy =
      Away.mk (reesGrading 𝔠) (reesDegOne_mem_reesGrading 𝔠 hb) n' y' hy') :
    ∃ M : ℕ, b ^ (M + n') * ((y : C[X])).coeff n = b ^ (M + n) * ((y' : C[X])).coeff n' := by
  have hv := congrArg HomogeneousLocalization.val h
  rw [Away.val_mk, Away.val_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists] at hv
  obtain ⟨⟨c, M, rfl⟩, hc⟩ := hv
  refine ⟨M, ?_⟩
  have hc' := congrArg (fun z : reesAlgebra 𝔠 => ((z : C[X])).coeff (M + n' + n)) hc
  simp only [Subalgebra.coe_mul, Subalgebra.coe_pow, coe_reesDegOne] at hc'
  rw [coe_eq_monomial_smul hy, coe_eq_monomial_smul hy', monomial_pow, monomial_pow,
    monomial_pow, monomial_mul_monomial, monomial_mul_monomial, monomial_mul_monomial,
    monomial_mul_monomial, coeff_monomial, coeff_monomial, if_pos (by ring),
    if_pos (by ring)] at hc'
  rwa [pow_add, pow_add, mul_assoc, mul_assoc]

/-- The coefficient of `(b⁽¹⁾)ᵏ y` in degree `n + k`. -/
theorem coeff_reesDegOne_pow_mul {n k : ℕ} {y : reesAlgebra 𝔠} (hy : y ∈ reesGrading 𝔠 (n • 1)) :
    (((reesDegOne 𝔠 hb ^ k * y : reesAlgebra 𝔠) : C[X])).coeff (n + k) =
      b ^ k * ((y : C[X])).coeff n := by
  conv_lhs => rw [Subalgebra.coe_mul, Subalgebra.coe_pow, coe_reesDegOne,
    coe_eq_monomial_smul hy, monomial_pow, monomial_mul_monomial, coeff_monomial,
    if_pos (by ring)]

/-- Multiplying an element of degree `n` by `(b⁽¹⁾)ᵏ` gives an element of degree `n + k`. -/
theorem reesDegOne_pow_mul_mem {n k : ℕ} {y : reesAlgebra 𝔠} (hy : y ∈ reesGrading 𝔠 (n • 1)) :
    reesDegOne 𝔠 hb ^ k * y ∈ reesGrading 𝔠 ((n + k) • 1) := by
  simpa [add_comm] using
    SetLike.mul_mem_graded (SetLike.pow_mem_graded k (reesDegOne_mem_reesGrading 𝔠 hb)) hy

/-- `y / (b⁽¹⁾)ⁿ = (b⁽¹⁾)ᵏ y / (b⁽¹⁾)ⁿ⁺ᵏ`. -/
theorem awayMk_eq_awayMk_reesDegOne_pow_mul {n k : ℕ} {y : reesAlgebra 𝔠}
    (hy : y ∈ reesGrading 𝔠 (n • 1)) :
    Away.mk (reesGrading 𝔠) (reesDegOne_mem_reesGrading 𝔠 hb) n y hy =
      Away.mk (reesGrading 𝔠) (reesDegOne_mem_reesGrading 𝔠 hb) (n + k)
        (reesDegOne 𝔠 hb ^ k * y) (reesDegOne_pow_mul_mem hb hy) := by
  apply HomogeneousLocalization.val_injective
  rw [Away.val_mk, Away.val_mk, Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  exact ⟨1, by simp only [OneMemClass.coe_one, one_mul, pow_add]; ring⟩

/-- Multiplying elements of `𝔠ᵏ` and `𝔠ᵐ` gives an element of `𝔠ᵏ⁺ᵐ`. -/
private theorem mul_mem_pow_add {x z : C} {k m : ℕ} (hx : x ∈ 𝔠 ^ k) (hz : z ∈ 𝔠 ^ m) :
    x * z ∈ 𝔠 ^ (k + m) :=
  pow_add 𝔠 k m ▸ Ideal.mul_mem_mul hx hz

/-- The membership condition is independent of the representation of the fraction. -/
theorem exists_pow_mul_coeff_mem_of_eq {n n' : ℕ} {y y' : reesAlgebra 𝔠}
    (hy : y ∈ reesGrading 𝔠 (n • 1)) (hy' : y' ∈ reesGrading 𝔠 (n' • 1))
    (h : Away.mk (reesGrading 𝔠) (reesDegOne_mem_reesGrading 𝔠 hb) n y hy =
      Away.mk (reesGrading 𝔠) (reesDegOne_mem_reesGrading 𝔠 hb) n' y' hy')
    (H : ∃ N : ℕ, b ^ N * ((y : C[X])).coeff n ∈ 𝔠 ^ (n + N + 1)) :
    ∃ N : ℕ, b ^ N * ((y' : C[X])).coeff n' ∈ 𝔠 ^ (n' + N + 1) := by
  obtain ⟨M, hM⟩ := exists_pow_mul_coeff_eq hb hy hy' h
  obtain ⟨N, hN⟩ := H
  refine ⟨N + M + n, ?_⟩
  have h1 : b ^ (N + M + n) * ((y' : C[X])).coeff n' =
      b ^ (M + n') * (b ^ N * ((y : C[X])).coeff n) := by
    linear_combination (-b ^ N) * hM
  rw [h1, show n' + (N + M + n) + 1 = (M + n') + (n + N + 1) by ring]
  exact mul_mem_pow_add (Ideal.pow_mem_pow hb _) hN

/-- A monomial fraction whose coefficient lies in `𝔠 · 𝔠ᴺ` lies in the ideal generated by `𝔠` on
the chart `D₊(b⁽¹⁾)`. -/
theorem awayMk_reesMonomial_mem_map {N : ℕ} {c : C} (hc : c ∈ 𝔠 * 𝔠 ^ N) (h : c ∈ 𝔠 ^ N) :
    Away.mk (reesGrading 𝔠) (reesDegOne_mem_reesGrading 𝔠 hb) N
      (reesMonomial 𝔠 N ⟨c, h⟩ : reesAlgebra 𝔠)
      (by simpa using (reesMonomial 𝔠 N ⟨c, h⟩).2) ∈ Ideal.map (chartAwayMap 𝔠 hb) 𝔠 := by
  induction hc using Submodule.mul_induction_on' with
  | mem_mul_mem i hi w hw =>
    have heq : Away.mk (reesGrading 𝔠) (reesDegOne_mem_reesGrading 𝔠 hb) N
        (reesMonomial 𝔠 N ⟨i * w, h⟩ : reesAlgebra 𝔠)
        (by simpa using (reesMonomial 𝔠 N ⟨i * w, h⟩).2) =
        chartAwayMap 𝔠 hb i * Away.mk (reesGrading 𝔠) (reesDegOne_mem_reesGrading 𝔠 hb) N
          (reesMonomial 𝔠 N ⟨w, hw⟩ : reesAlgebra 𝔠)
          (by simpa using (reesMonomial 𝔠 N ⟨w, hw⟩).2) := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_mul, chartAwayMap_val, Away.val_mk, Away.val_mk,
        Localization.mk_mul, one_mul]
      congr 1
      apply Subtype.ext
      simp only [Subalgebra.coe_mul, coe_reesMonomial, coe_coe_reesGradingZeroEquiv]
      rw [C_mul_monomial]
    rw [heq]
    exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ hi)
  | add c₁ hc₁ c₂ hc₂ ih₁ ih₂ =>
    have h₁ : c₁ ∈ 𝔠 ^ N := (Ideal.mul_le_right : 𝔠 * 𝔠 ^ N ≤ 𝔠 ^ N) hc₁
    have h₂ : c₂ ∈ 𝔠 ^ N := (Ideal.mul_le_right : 𝔠 * 𝔠 ^ N ≤ 𝔠 ^ N) hc₂
    have heq : Away.mk (reesGrading 𝔠) (reesDegOne_mem_reesGrading 𝔠 hb) N
        (reesMonomial 𝔠 N ⟨c₁ + c₂, h⟩ : reesAlgebra 𝔠)
        (by simpa using (reesMonomial 𝔠 N ⟨c₁ + c₂, h⟩).2) =
        Away.mk (reesGrading 𝔠) (reesDegOne_mem_reesGrading 𝔠 hb) N
          (reesMonomial 𝔠 N ⟨c₁, h₁⟩ : reesAlgebra 𝔠)
          (by simpa using (reesMonomial 𝔠 N ⟨c₁, h₁⟩).2) +
        Away.mk (reesGrading 𝔠) (reesDegOne_mem_reesGrading 𝔠 hb) N
          (reesMonomial 𝔠 N ⟨c₂, h₂⟩ : reesAlgebra 𝔠)
          (by simpa using (reesMonomial 𝔠 N ⟨c₂, h₂⟩).2) := by
      apply HomogeneousLocalization.val_injective
      rw [HomogeneousLocalization.val_add, Away.val_mk, Away.val_mk, Away.val_mk,
        Localization.add_mk_self]
      congr 1
      apply Subtype.ext
      simp only [Subalgebra.coe_add, coe_reesMonomial, map_add]
    rw [heq]
    exact Ideal.add_mem _ (ih₁ h₁) (ih₂ h₂)

/-- **The ideal generated by `𝔠` on the chart `D₊(b⁽¹⁾)` of the blowup.** The fraction
`y / (b⁽¹⁾)ⁿ`, `y` homogeneous of degree `n` with coefficient `c ∈ 𝔠ⁿ`, lies in it exactly when
`bᴺ c ∈ 𝔠ⁿ⁺ᴺ⁺¹` for some `N`. -/
theorem awayMk_mem_map_chartAwayMap_iff {n : ℕ} {y : reesAlgebra 𝔠}
    (hy : y ∈ reesGrading 𝔠 (n • 1)) :
    Away.mk (reesGrading 𝔠) (reesDegOne_mem_reesGrading 𝔠 hb) n y hy ∈
        Ideal.map (chartAwayMap 𝔠 hb) 𝔠 ↔
      ∃ N : ℕ, b ^ N * ((y : C[X])).coeff n ∈ 𝔠 ^ (n + N + 1) := by
  constructor
  · intro hz
    -- the property, for every representation of an element of the chart ring
    let Good : Away (reesGrading 𝔠) (reesDegOne 𝔠 hb) → Prop := fun z =>
      ∀ (m : ℕ) (w : reesAlgebra 𝔠) (hw : w ∈ reesGrading 𝔠 (m • 1)),
        Away.mk (reesGrading 𝔠) (reesDegOne_mem_reesGrading 𝔠 hb) m w hw = z →
          ∃ N : ℕ, b ^ N * ((w : C[X])).coeff m ∈ 𝔠 ^ (m + N + 1)
    -- it suffices to exhibit one good representation
    have hone : ∀ z (m : ℕ) (w : reesAlgebra 𝔠) (hw : w ∈ reesGrading 𝔠 (m • 1)),
        Away.mk (reesGrading 𝔠) (reesDegOne_mem_reesGrading 𝔠 hb) m w hw = z →
        (∃ N : ℕ, b ^ N * ((w : C[X])).coeff m ∈ 𝔠 ^ (m + N + 1)) → Good z := by
      rintro z m w hw rfl H m' w' hw' h'
      exact exists_pow_mul_coeff_mem_of_eq hb hw hw' h'.symm H
    have hgood : ∀ z ∈ Ideal.map (chartAwayMap 𝔠 hb) 𝔠, Good z := by
      intro z hz
      induction hz using Submodule.span_induction with
      | mem z hz =>
        obtain ⟨c, hc, rfl⟩ := hz
        refine hone _ 0 _ _ (chartAwayMap_eq_awayMk' hb c).symm ⟨0, ?_⟩
        simpa [coe_coe_reesGradingZeroEquiv] using hc
      | zero =>
        refine hone _ 0 0 (zero_mem _) ?_ ⟨0, by simp⟩
        apply HomogeneousLocalization.val_injective
        simp [Localization.mk_zero]
      | add z₁ z₂ _ _ ih₁ ih₂ =>
        obtain ⟨m₁, w₁, hw₁, rfl⟩ := Away.mk_surjective _ (reesDegOne_mem_reesGrading 𝔠 hb) z₁
        obtain ⟨m₂, w₂, hw₂, rfl⟩ := Away.mk_surjective _ (reesDegOne_mem_reesGrading 𝔠 hb) z₂
        obtain ⟨N₁, hN₁⟩ := ih₁ m₁ w₁ hw₁ rfl
        obtain ⟨N₂, hN₂⟩ := ih₂ m₂ w₂ hw₂ rfl
        have hw₁' := reesDegOne_pow_mul_mem (k := m₂) hb hw₁
        have hw₂' := reesDegOne_pow_mul_mem (k := m₁) hb hw₂
        have hsum : reesDegOne 𝔠 hb ^ m₂ * w₁ + reesDegOne 𝔠 hb ^ m₁ * w₂ ∈
            reesGrading 𝔠 ((m₁ + m₂) • 1) :=
          add_mem hw₁' (by rwa [add_comm m₁ m₂])
        refine hone _ (m₁ + m₂) _ hsum ?_ ⟨N₁ + N₂, ?_⟩
        · rw [awayMk_eq_awayMk_reesDegOne_pow_mul hb hw₁ (k := m₂),
            awayMk_eq_awayMk_reesDegOne_pow_mul hb hw₂ (k := m₁)]
          apply HomogeneousLocalization.val_injective
          rw [HomogeneousLocalization.val_add, Away.val_mk, Away.val_mk, Away.val_mk,
            show m₂ + m₁ = m₁ + m₂ from add_comm _ _, Localization.add_mk_self]
        · rw [Subalgebra.coe_add, coeff_add, coeff_reesDegOne_pow_mul hb hw₁,
            show m₁ + m₂ = m₂ + m₁ from add_comm _ _, coeff_reesDegOne_pow_mul hb hw₂, mul_add]
          refine Ideal.add_mem _ ?_ ?_
          · rw [show b ^ (N₁ + N₂) * (b ^ m₂ * ((w₁ : C[X])).coeff m₁) =
                b ^ (N₂ + m₂) * (b ^ N₁ * ((w₁ : C[X])).coeff m₁) by ring,
              show m₂ + m₁ + (N₁ + N₂) + 1 = (N₂ + m₂) + (m₁ + N₁ + 1) by ring]
            exact mul_mem_pow_add (Ideal.pow_mem_pow hb _) hN₁
          · rw [show b ^ (N₁ + N₂) * (b ^ m₁ * ((w₂ : C[X])).coeff m₂) =
                b ^ (N₁ + m₁) * (b ^ N₂ * ((w₂ : C[X])).coeff m₂) by ring,
              show m₂ + m₁ + (N₁ + N₂) + 1 = (N₁ + m₁) + (m₂ + N₂ + 1) by ring]
            exact mul_mem_pow_add (Ideal.pow_mem_pow hb _) hN₂
      | smul a z _ ih =>
        obtain ⟨m, w, hw, rfl⟩ := Away.mk_surjective _ (reesDegOne_mem_reesGrading 𝔠 hb) z
        obtain ⟨m', w', hw', rfl⟩ := Away.mk_surjective _ (reesDegOne_mem_reesGrading 𝔠 hb) a
        obtain ⟨N, hN⟩ := ih m w hw rfl
        have hprod : w' * w ∈ reesGrading 𝔠 ((m' + m) • 1) := by
          simpa [add_smul] using SetLike.mul_mem_graded hw' hw
        refine hone _ (m' + m) _ hprod ?_ ⟨N, ?_⟩
        · apply HomogeneousLocalization.val_injective
          rw [smul_eq_mul, HomogeneousLocalization.val_mul, Away.val_mk, Away.val_mk,
            Away.val_mk, Localization.mk_mul]
          congr 1
          ext1
          simp [pow_add]
        · rw [Subalgebra.coe_mul, coe_eq_monomial_smul hw', coe_eq_monomial_smul hw,
            monomial_mul_monomial, coeff_monomial, if_pos rfl,
            show b ^ N * (((w' : C[X])).coeff m' * ((w : C[X])).coeff m) =
              ((w' : C[X])).coeff m' * (b ^ N * ((w : C[X])).coeff m) by ring,
            show m' + m + N + 1 = m' + (m + N + 1) by ring]
          exact mul_mem_pow_add (coeff_mem_pow w' m') hN
    exact hgood _ hz n y hy rfl
  · rintro ⟨N, hN⟩
    rw [awayMk_eq_awayMk_reesDegOne_pow_mul hb hy (k := N)]
    have hc : b ^ N * ((y : C[X])).coeff n ∈ 𝔠 ^ (n + N) :=
      Ideal.pow_le_pow_right (Nat.le_succ _) hN
    have hmono : reesDegOne 𝔠 hb ^ N * y =
        (reesMonomial 𝔠 (n + N) ⟨b ^ N * ((y : C[X])).coeff n, hc⟩ : reesAlgebra 𝔠) := by
      have hmem : reesDegOne 𝔠 hb ^ N * y ∈ reesGrading 𝔠 (n + N) := by
        simpa using reesDegOne_pow_mul_mem hb hy (k := N)
      apply Subtype.ext
      rw [coe_reesMonomial, coe_eq_monomial 𝔠 hmem, coeff_reesDegOne_pow_mul hb hy]
    simp only [hmono]
    exact awayMk_reesMonomial_mem_map hb (by rwa [← pow_succ']) hc

end Chart

/-! ### The exceptional divisor on a chart of the blowup -/

section ExceptionalChart

open HomogeneousLocalization Stacks.Blowup

variable {C : Type u} [CommRing C] (𝔠 : Ideal C)

/-- The ideal of an ideal sheaf on an affine open is transported along an equality of opens by the
restriction map. -/
theorem ideal_eq_map_of_eq {X : Scheme.{u}} (𝓘 : X.IdealSheafData) {U V : X.Opens} (h : U = V)
    (hU : IsAffineOpen U) (hV : IsAffineOpen V) :
    𝓘.ideal ⟨U, hU⟩ = Ideal.map (X.presheaf.map (eqToHom h).op).hom (𝓘.ideal ⟨V, hV⟩) := by
  subst h
  simp

/-- Three successive images of an ideal are its image under the composite. -/
theorem ideal_map_map_map_of_comp {A B D E : Type*} [CommRing A] [CommRing B] [CommRing D]
    [CommRing E] (g : A →+* B) (s : B →+* D) (p : D →+* E) (t : A →+* E)
    (h : (p.comp s).comp g = t) (K : Ideal A) :
    Ideal.map p (Ideal.map s (Ideal.map g K)) = Ideal.map t K := by
  rw [Ideal.map_map, Ideal.map_map, ← h]

/-- The centre of the blowup, as an ideal sheaf on `Spec C`, has `𝔠` as its ideal of global
sections. -/
theorem map_ideal_ofIdealTop_map_eq :
    Ideal.map (Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom
        ((Scheme.IdealSheafData.ofIdealTop
          (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of C)).inv.hom 𝔠)).ideal
            ⟨⊤, isAffineOpen_top _⟩) = 𝔠 := by
  rw [Scheme.IdealSheafData.ofIdealTop_ideal,
    show (homOfLE (le_top (a := (⊤ : (Spec (CommRingCat.of C)).Opens)))) = 𝟙 _ from rfl]
  simp only [op_id, CategoryTheory.Functor.map_id, CommRingCat.hom_id, Ideal.map_id]
  rw [Ideal.map_map, ← CommRingCat.hom_comp, Iso.inv_hom_id, CommRingCat.hom_id, Ideal.map_id]

variable {𝔠} {b : C} (hb : b ∈ 𝔠)

set_option maxHeartbeats 400000 in
/-- **The exceptional divisor on the chart `D₊(b⁽¹⁾)`**: the ideal of `Y = V(𝔠 𝒪_X)` on the
standard open `D₊(b⁽¹⁾)` of the blowup is the image of `𝔠` in the chart ring
`C[𝔠/b] = (⨁ₙ 𝔠ⁿ)₍b⁽¹⁾₎`, read in `Γ(X, D₊(b⁽¹⁾))` through Mathlib's `awayToSection`. -/
theorem ideal_comap_toSpec_basicOpen (J : (Spec (CommRingCat.of C)).IdealSheafData)
    (hJ : Ideal.map (Scheme.ΓSpecIso (CommRingCat.of C)).hom.hom
        (J.ideal ⟨⊤, isAffineOpen_top _⟩) = 𝔠) :
    (J.comap (toSpec 𝔠)).ideal ⟨Proj.basicOpen (reesGrading 𝔠) (reesDegOne 𝔠 hb),
        Proj.isAffineOpen_basicOpen _ _ (reesDegOne_mem_reesGrading 𝔠 hb) one_pos⟩ =
      Ideal.map (Proj.awayToSection (reesGrading 𝔠) (reesDegOne 𝔠 hb)).hom
        (Ideal.map (chartAwayMap 𝔠 hb) 𝔠) := by
  have : IsOpenImmersion (awayChartι 𝔠 hb) :=
    inferInstanceAs (IsOpenImmersion (Proj.awayι (reesGrading 𝔠) (reesDegOne 𝔠 hb)
      (reesDegOne_mem_reesGrading 𝔠 hb) one_pos))
  -- the computation on the chart `Spec C[𝔠/b]`
  have hcomap : (J.comap (toSpec 𝔠)).comap (awayChartι 𝔠 hb) =
      J.comap (Spec.map (CommRingCat.ofHom (chartAwayMap 𝔠 hb))) := by
    rw [← Scheme.IdealSheafData.comap_comp]
    exact congrArg (J.comap ·) (awayι_comp_toSpec 𝔠 hb)
  have hstep : ((J.comap (toSpec 𝔠)).comap (awayChartι 𝔠 hb)).ideal ⟨⊤, isAffineOpen_top _⟩ =
      Ideal.map (Spec.map (CommRingCat.ofHom (chartAwayMap 𝔠 hb))).appTop.hom
        (J.ideal ⟨⊤, isAffineOpen_top _⟩) := by
    rw [hcomap]
    exact Stacks.IdealSheaf.ideal_comap_top_of_isAffine _ _
  have happ : (Spec.map (CommRingCat.ofHom (chartAwayMap 𝔠 hb))).appTop =
      ((Scheme.ΓSpecIso (CommRingCat.of C)).hom ≫
        CommRingCat.ofHom (chartAwayMap 𝔠 hb)) ≫ (chartGamma 𝔠 hb).inv := by
    rw [Iso.eq_comp_inv]
    exact Scheme.ΓSpecIso_naturality _
  have hK : Ideal.map (Spec.map (CommRingCat.ofHom (chartAwayMap 𝔠 hb))).appTop.hom
        (J.ideal ⟨⊤, isAffineOpen_top _⟩) =
      Ideal.map (chartGamma 𝔠 hb).inv.hom (Ideal.map (chartAwayMap 𝔠 hb) 𝔠) := by
    rw [happ, CommRingCat.hom_comp, ← Ideal.map_map, CommRingCat.hom_comp, ← Ideal.map_map,
      CommRingCat.hom_ofHom, hJ]
  -- back to the open `D₊(b⁽¹⁾)` of the blowup; term mode, as in
  -- `Stacks.Blowup.ideal_comap_toSpec_eq_span_chartGenerator`
  have hfinal : Ideal.map (chartSections 𝔠 hb).hom.hom
      ((J.comap (toSpec 𝔠)).ideal ⟨chartImage 𝔠 hb, isAffineOpen_chartImage 𝔠 hb⟩) =
      Ideal.map (chartGamma 𝔠 hb).inv.hom (Ideal.map (chartAwayMap 𝔠 hb) 𝔠) :=
    (Stacks.IdealSheaf.ideal_map_hom_eq_comap_inv (chartSections 𝔠 hb) _).trans
      ((Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion (J.comap (toSpec 𝔠))
        (awayChartι 𝔠 hb) ⟨⊤, isAffineOpen_top _⟩).symm.trans (hstep.trans hK))
  have himage : (J.comap (toSpec 𝔠)).ideal ⟨chartImage 𝔠 hb, isAffineOpen_chartImage 𝔠 hb⟩ =
      Ideal.map (chartSections 𝔠 hb).inv.hom
        (Ideal.map (chartGamma 𝔠 hb).inv.hom (Ideal.map (chartAwayMap 𝔠 hb) 𝔠)) := by
    rw [← hfinal, Ideal.map_map, ← CommRingCat.hom_comp, Iso.hom_inv_id, CommRingCat.hom_id,
      Ideal.map_id]
  have h : Proj.basicOpen (reesGrading 𝔠) (reesDegOne 𝔠 hb) = chartImage 𝔠 hb :=
    (chartImage_eq_basicOpen 𝔠 hb).symm
  have hc : (chartGamma 𝔠 hb).inv ≫ (chartSections 𝔠 hb).inv ≫
      (AlgebraicGeometry.Proj (reesGrading 𝔠)).presheaf.map (eqToHom h).op =
      Proj.awayToSection (reesGrading 𝔠) (reesDegOne 𝔠 hb) :=
    AlgebraicGeometry.ProjectiveSpectrum.Proj.awayι_appIso_top_inv (reesGrading 𝔠)
      (reesDegOne_mem_reesGrading 𝔠 hb) one_pos
  refine (ideal_eq_map_of_eq _ h _ (isAffineOpen_chartImage 𝔠 hb)).trans ?_
  refine (congrArg (Ideal.map _) himage).trans ?_
  exact ideal_map_map_map_of_comp _ _ _ _ (congrArg CommRingCat.Hom.hom hc) _

end ExceptionalChart

/-! ### A graded quotient of the Rees algebra onto `Gr_𝔠(C)`, and its `Proj` -/

section GrQuotient

open Polynomial HomogeneousLocalization Stacks.Blowup

variable {C : Type u} [CommRing C] (𝔠 : Ideal C)
  {G σ : Type u} [CommRing G] [SetLike σ G] [AddSubgroupClass σ G] {𝒢 : ℕ → σ} [GradedRing 𝒢]
  (π : reesGrading 𝔠 →+*ᵍ 𝒢)

/-- **A graded map out of the Rees algebra is the quotient onto `Gr_𝔠(C)`**: a homogeneous element
of degree `n` dies exactly when its coefficient lies in `𝔠ⁿ⁺¹`. For a surjective `π` this
identifies the target with `⨁ 𝔠ⁿ/𝔠ⁿ⁺¹`, the graded ring `S` of [Stacks, Tag 0GA6]. -/
def IsGrQuotient : Prop :=
  ∀ (n : ℕ) (y : reesAlgebra 𝔠), y ∈ reesGrading 𝔠 n →
    (π y = 0 ↔ ((y : C[X])).coeff n ∈ 𝔠 ^ (n + 1))

variable {𝔠 π}

/-- **On the chart `D₊(b⁽¹⁾)`, the quotient onto `Gr_𝔠(C)` has kernel `𝔠`.** -/
theorem ker_awayMap_eq_map_chartAwayMap (hπ : IsGrQuotient 𝔠 π) {b : C} (hb : b ∈ 𝔠) :
    RingHom.ker (Away.map π (reesDegOne 𝔠 hb)) = Ideal.map (chartAwayMap 𝔠 hb) 𝔠 := by
  ext z
  obtain ⟨n, a, ha, rfl⟩ := Away.mk_surjective _ (reesDegOne_mem_reesGrading 𝔠 hb) z
  rw [Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff,
    awayMk_mem_map_chartAwayMap_iff]
  refine exists_congr fun k => ?_
  have hmem : reesDegOne 𝔠 hb ^ k * a ∈ reesGrading 𝔠 (n + k) := by
    simpa using reesDegOne_pow_mul_mem hb ha (k := k)
  rw [RingHom.mem_ker]
  exact (hπ (n + k) _ hmem).trans (by rw [coeff_reesDegOne_pow_mul hb ha])

variable (π) (hπs : Function.Surjective π)

/-- **The closed immersion `Proj(Gr_𝔠(C)) ⟶ X`** of the exceptional divisor into the blowup,
induced by a surjection of graded rings out of the Rees algebra. -/
abbrev grImmersion : AlgebraicGeometry.Proj 𝒢 ⟶ blowupScheme 𝔠 :=
  Proj.map π (Proj.irrelevant_le_map_of_surjective π hπs)

/-- `grImmersion π hπs` is a closed immersion. -/
instance isClosedImmersion_grImmersion : IsClosedImmersion (grImmersion π hπs) :=
  Proj.isClosedImmersion_map_of_surjective' π hπs

variable {π}

/-- The degree-one elements `b⁽¹⁾`, `b ∈ 𝔠`, generate the Rees algebra over its degree-zero part,
so their standard opens cover the blowup. -/
theorem iSup_basicOpen_reesDegOne_eq_top :
    ⨆ b : 𝔠, Proj.basicOpen (reesGrading 𝔠) (reesDegOne 𝔠 b.2) = ⊤ := by
  refine Proj.iSup_basicOpen_eq_top' _ _ (fun b => ⟨1, reesDegOne_mem_reesGrading 𝔠 b.2⟩) ?_
  have hrange : Set.range (fun b : 𝔠 => reesDegOne 𝔠 b.2) =
      ((reesGrading 𝔠 1 : Submodule C (reesAlgebra 𝔠)) : Set (reesAlgebra 𝔠)) := by
    ext y
    refine ⟨?_, fun hy => ⟨⟨((y : reesAlgebra 𝔠) : C[X]).coeff 1, by simpa [pow_one] using y.2 1⟩,
      Subtype.ext (coe_eq_monomial 𝔠 hy).symm⟩⟩
    rintro ⟨b, rfl⟩
    exact reesDegOne_mem_reesGrading 𝔠 b.2
  rw [hrange]
  exact adjoin_reesGradingZero_reesGrading_one_eq_top 𝔠

/-- **The ideal sheaf of `Proj(Gr_𝔠(C)) ⟶ X` is the ideal sheaf of the exceptional divisor**
`Y = V(𝔠 𝒪_X)`: both are generated on the chart `D₊(b⁽¹⁾)` by the image of `𝔠`. -/
theorem ker_grImmersion (hπ : IsGrQuotient 𝔠 π) :
    (grImmersion π hπs).ker = thickeningIdeal 𝔠 1 := by
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top
    (fun b : 𝔠 => ⟨Proj.basicOpen (reesGrading 𝔠) (reesDegOne 𝔠 b.2),
      Proj.isAffineOpen_basicOpen _ _ (reesDegOne_mem_reesGrading 𝔠 b.2) one_pos⟩)
    iSup_basicOpen_reesDegOne_eq_top fun b => ?_
  have hthick : thickeningIdeal 𝔠 1 = (Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of C)).inv.hom 𝔠)).comap (toSpec 𝔠) :=
    pow_one _
  rw [hthick, ideal_comap_toSpec_basicOpen b.2 _ (map_ideal_ofIdealTop_map_eq 𝔠),
    Scheme.Hom.ker_apply]
  have := Stacks.ProjQuotientChartIdeal.isIso_awayToSection
    (reesDegOne_mem_reesGrading 𝔠 b.2) one_pos
  have hbij := ConcreteCategory.bijective_of_isIso
    (Proj.awayToSection (reesGrading 𝔠) (reesDegOne 𝔠 b.2))
  ext x
  obtain ⟨z, rfl⟩ := hbij.2 x
  refine (Stacks.ProjQuotientChartIdeal.awayToSection_mem_ker_app_projMap_iff π _
    (reesDegOne_mem_reesGrading 𝔠 b.2) one_pos z).trans ?_
  rw [ker_awayMap_eq_map_chartAwayMap hπ b.2]
  refine Iff.trans ?_ (Ideal.mem_map_iff_of_surjective _ hbij.2).symm
  refine ⟨fun h => ⟨z, h, rfl⟩, ?_⟩
  rintro ⟨w, hw, hwz⟩
  rwa [hbij.1 hwz] at hw

end GrQuotient

/-! ### `Gr_𝔠(C)` as a graded quotient of the Rees algebra -/

section GrIdeal

open Polynomial Stacks.Blowup

variable {C : Type u} [CommRing C] (𝔠 : Ideal C)

/-- The ideal `𝔠 · ⨁ 𝔠ⁿ` of the Rees algebra: the elements whose `n`-th coefficient lies in
`𝔠ⁿ⁺¹` for every `n`. -/
def grIdealCarrier : Ideal (reesAlgebra 𝔠) where
  carrier := {y | ∀ n, ((y : C[X])).coeff n ∈ 𝔠 ^ (n + 1)}
  add_mem' {y z} hy hz n := by
    rw [Subalgebra.coe_add, coeff_add]
    exact Ideal.add_mem _ (hy n) (hz n)
  zero_mem' n := by simp
  smul_mem' r y hy n := by
    rw [smul_eq_mul, Subalgebra.coe_mul, coeff_mul]
    refine Ideal.sum_mem _ fun ij hij => ?_
    rw [Finset.HasAntidiagonal.mem_antidiagonal] at hij
    rw [← hij, show ij.1 + ij.2 + 1 = ij.1 + (ij.2 + 1) by ring, pow_add]
    exact Ideal.mul_mem_mul (coeff_mem_pow r ij.1) (hy ij.2)

/-- `y` lies in `grIdealCarrier 𝔠` iff its `n`-th coefficient lies in `𝔠ⁿ⁺¹` for every `n`. -/
theorem mem_grIdealCarrier_iff (y : reesAlgebra 𝔠) :
    y ∈ grIdealCarrier 𝔠 ↔ ∀ n, ((y : C[X])).coeff n ∈ 𝔠 ^ (n + 1) :=
  Iff.rfl

/-- `𝔠 · ⨁ 𝔠ⁿ` is a homogeneous ideal. -/
def grIdeal : HomogeneousIdeal (reesGrading 𝔠) where
  toSubmodule := grIdealCarrier 𝔠
  is_homogeneous' i y hy n := by
    change (((DirectSum.decompose (reesGrading 𝔠) y i : reesGrading 𝔠 i) : reesAlgebra 𝔠) :
      C[X]).coeff n ∈ 𝔠 ^ (n + 1)
    have hdec : DirectSum.decompose (reesGrading 𝔠) y = reesDecompose 𝔠 y := rfl
    rw [hdec, reesDecompose_apply, coe_reesComponent, coeff_monomial]
    split_ifs with h
    · subst h
      exact hy i
    · exact zero_mem _

/-- **The quotient of the Rees algebra onto `Gr_𝔠(C) = ⨁ 𝔠ⁿ/𝔠ⁿ⁺¹`**, as a map of graded rings. -/
abbrev grQuotient : reesGrading 𝔠 →+*ᵍ Stacks.HomogeneousIdeal.quotientGrading (grIdeal 𝔠) :=
  Stacks.HomogeneousIdeal.quotientMk (grIdeal 𝔠)

/-- `grQuotient 𝔠` is surjective. -/
theorem surjective_grQuotient : Function.Surjective (grQuotient 𝔠) :=
  Stacks.HomogeneousIdeal.surjective_quotientMk _

/-- `grQuotient 𝔠` is the quotient of the Rees algebra onto `Gr_𝔠(C)`. -/
theorem isGrQuotient_grQuotient : IsGrQuotient 𝔠 (grQuotient 𝔠) := by
  intro n y hy
  rw [Stacks.HomogeneousIdeal.quotientMk_apply, Ideal.Quotient.eq_zero_iff_mem]
  show (∀ m, ((y : C[X])).coeff m ∈ 𝔠 ^ (m + 1)) ↔ _
  refine ⟨fun h => h n, fun h m => ?_⟩
  obtain rfl | hm := eq_or_ne m n
  · exact h
  · rw [hy m hm]
    exact zero_mem _

end GrIdeal

/-! ### Closed immersions with the same ideal sheaf -/

section SameKernel

/-- **A closed immersion is the closed subscheme cut out by its kernel**: for `ker f = 𝓚` there is
an isomorphism from the source of `f` to `V(𝓚)` over `X`. -/
theorem exists_iso_subscheme_of_ker_eq {Z X : Scheme.{u}} (f : Z ⟶ X) [IsClosedImmersion f]
    (𝓚 : X.IdealSheafData) (h : f.ker = 𝓚) :
    ∃ e : Z ≅ 𝓚.subscheme, e.hom ≫ 𝓚.subschemeι = f := by
  subst h
  exact ⟨asIso f.toImage, f.toImage_imageι⟩

/-- **Two closed immersions with the same ideal sheaf differ by an isomorphism of their sources
over the target.** -/
theorem exists_iso_of_ker_eq {Z Z' X : Scheme.{u}} (f : Z ⟶ X) (f' : Z' ⟶ X)
    [IsClosedImmersion f] [IsClosedImmersion f'] (h : f.ker = f'.ker) :
    ∃ e : Z ≅ Z', e.hom ≫ f' = f := by
  obtain ⟨e, he⟩ := exists_iso_subscheme_of_ker_eq f f'.ker h
  obtain ⟨e', he'⟩ := exists_iso_subscheme_of_ker_eq f' f'.ker rfl
  refine ⟨e ≪≫ e'.symm, ?_⟩
  calc (e ≪≫ e'.symm).hom ≫ f' = e.hom ≫ e'.inv ≫ e'.hom ≫ (f'.ker).subschemeι := by
        rw [he']; rfl
    _ = f := by rw [Iso.inv_hom_id_assoc, he]

end SameKernel

/-! ### The structure sheaf of the exceptional divisor, as a direct image -/

section PushforwardUnit

/-- `pushforwardUnitRestrict` along an isomorphism is an isomorphism. -/
instance isIso_pushforwardUnitRestrict {Y Z W : Scheme.{u}} (e : Y ⟶ Z) [IsIso e] (g : Z ⟶ W)
    (g' : Y ⟶ W) (hg : e ≫ g = g') : IsIso (pushforwardUnitRestrict e g g' hg) := by
  subst hg
  have h1 : IsIso (SheafOfModules.unitToPushforwardObjUnit e.toRingCatSheafHom) :=
    AlgebraicGeometry.RingedSpace.PseudoCoherence.isIso_unitToPushforwardObjUnit _
      inferInstance
  change IsIso ((Scheme.Modules.pushforward g).map
      (SheafOfModules.unitToPushforwardObjUnit e.toRingCatSheafHom) ≫
    (Scheme.Modules.pushforwardComp e g).hom.app _)
  have h2 : IsIso ((Scheme.Modules.pushforward g).map
      (SheafOfModules.unitToPushforwardObjUnit e.toRingCatSheafHom)) :=
    @Functor.map_isIso _ _ _ _ _ _ (Scheme.Modules.pushforward g) _ h1
  exact @IsIso.comp_isIso _ _ _ _ _ _ _ h2
    (Iso.isIso_hom ((Scheme.Modules.pushforwardComp e g).app _))

/-- **The direct image of the structure sheaf along a closed immersion `f` is the structure
sheaf of `V(𝓚)` for any ideal sheaf `𝓚` with `ker f = 𝓚`.** -/
def pushforwardUnitIsoOfKerEq {Z X : Scheme.{u}} (f : Z ⟶ X) [IsClosedImmersion f]
    (𝓚 : X.IdealSheafData) (h𝓚 : f.ker = 𝓚) :
    (Scheme.Modules.pushforward 𝓚.subschemeι).obj (SheafOfModules.unit _) ≅
      (Scheme.Modules.pushforward f).obj (SheafOfModules.unit _) := by
  subst h𝓚
  exact asIso (pushforwardUnitRestrict f.toImage f.imageι f (Scheme.Hom.toImage_imageι f))

/-- The comparison carries the canonical surjection onto `𝒪_{V(𝓚)}` to the one onto `f_*𝒪_Z`. -/
theorem unitToPushforwardObjUnit_comp_pushforwardUnitIsoOfKerEq {Z X : Scheme.{u}} (f : Z ⟶ X)
    [IsClosedImmersion f] (𝓚 : X.IdealSheafData) (h𝓚 : f.ker = 𝓚) :
    SheafOfModules.unitToPushforwardObjUnit 𝓚.subschemeι.toRingCatSheafHom ≫
        (pushforwardUnitIsoOfKerEq f 𝓚 h𝓚).hom =
      SheafOfModules.unitToPushforwardObjUnit f.toRingCatSheafHom := by
  subst h𝓚
  exact unitToPushforwardObjUnit_comp_pushforwardUnitRestrict _ _ _ _

end PushforwardUnit

/-! ### `𝒪_Y(q)` as the direct image of the twist of `Proj(Gr_𝔠(C))` -/

section Twist

open Stacks.Blowup MonoidalCategory

attribute [local instance] modulesMonoidal modulesMonoidal'

variable {C : Type u} [CommRing C] {𝔠 : Ideal C}
  {G σ : Type u} [CommRing G] [SetLike σ G] [AddSubgroupClass σ G] {𝒢 : ℕ → σ} [GradedRing 𝒢]
  {π : reesGrading 𝔠 →+*ᵍ 𝒢} (hπs : Function.Surjective π) (hπ : IsGrQuotient 𝔠 π)

/-- Sections of a composite of morphisms of sheaves of modules. -/
theorem comp_val_app_apply {X : Scheme.{u}} {F F' F'' : X.Modules} (f : F ⟶ F') (g : F' ⟶ F'')
    (U : X.Opens) (t : F.val.obj (op U)) :
    (((f ≫ g).val.app (op U)).hom t) = (g.val.app (op U)).hom ((f.val.app (op U)).hom t) :=
  rfl

/-- **`𝒪_{V(𝓚)} ⊗ E ≅ f_*G'`** for a closed immersion `f` with `ker f = 𝓚` and an identification
`e : f^*E ≅ G'`: `𝒪_{V(𝓚)} = f_*𝒪` and the projection formula at a closed immersion. -/
def kerTensorIso {Z X : Scheme.{u}} (f : Z ⟶ X) [IsClosedImmersion f] (𝓚 : X.IdealSheafData)
    (h𝓚 : f.ker = 𝓚) (E : X.Modules) (G' : Z.Modules)
    (e : (Scheme.Modules.pullback f).obj E ≅ G') :
    (Scheme.Modules.pushforward 𝓚.subschemeι).obj (SheafOfModules.unit _) ⊗ E ≅
      (Scheme.Modules.pushforward f).obj G' :=
  whiskerRightIso (pushforwardUnitIsoOfKerEq f 𝓚 h𝓚) E ≪≫
    Stacks.Blowup.pushforwardUnitTensorIso f E G' e

/-- **The comparison `𝒪_{V(𝓚)} ⊗ E ≅ f_*G'` on the section `1 ⊗ s`**, for a closed immersion `f`
with `ker f = 𝓚` and an identification `e : f^*E ≅ G'`: it is the pulled-back section `f^*s`. -/
theorem pushforwardUnitIsoOfKerEq_tensor_app_top_one_tmul {Z X : Scheme.{u}} (f : Z ⟶ X)
    [IsClosedImmersion f] (𝓚 : X.IdealSheafData) (h𝓚 : f.ker = 𝓚) (E : X.Modules)
    (G' : Z.Modules) (e : (Scheme.Modules.pullback f).obj E ≅ G') (s : E.val.obj (op ⊤)) :
    (((kerTensorIso f 𝓚 h𝓚 E G' e).hom.val.app (op ⊤)).hom
      (Stacks.SheafOfModules.OnSpace.tensorObjTmul X.toRingedSpace
        ((Scheme.Modules.pushforward 𝓚.subschemeι).obj (SheafOfModules.unit _)) E (op ⊤)
        (((SheafOfModules.unitToPushforwardObjUnit 𝓚.subschemeι.toRingCatSheafHom).val.app
          (op ⊤)).hom (Stacks.SheafOfModules.OnSpace.unitSection X.toRingedSpace (op ⊤) 1)) s)) =
      (e.hom.val.app (op ⊤)).hom (pullbackSection f E s) := by
  rw [kerTensorIso, Iso.trans_hom, comp_val_app_apply, whiskerRightIso_hom]
  have h1 : ((pushforwardUnitIsoOfKerEq f 𝓚 h𝓚).hom.val.app (op ⊤)).hom
      (((SheafOfModules.unitToPushforwardObjUnit 𝓚.subschemeι.toRingCatSheafHom).val.app
        (op ⊤)).hom (Stacks.SheafOfModules.OnSpace.unitSection X.toRingedSpace (op ⊤) 1)) =
      (1 : Z.toRingedSpace.presheaf.obj (op ⊤)) := by
    refine (congrArg (fun φ => (φ.val.app (op ⊤)).hom
      (Stacks.SheafOfModules.OnSpace.unitSection X.toRingedSpace (op ⊤) 1))
      (unitToPushforwardObjUnit_comp_pushforwardUnitIsoOfKerEq f 𝓚 h𝓚)).trans ?_
    exact map_one (f.app ⊤).hom
  refine (congrArg (fun t => ((Stacks.Blowup.pushforwardUnitTensorIso f E G' e).hom.val.app
    (op ⊤)).hom t) ((Stacks.SheafOfModules.OnSpace.whiskerRight_tmul X.toRingedSpace
      (pushforwardUnitIsoOfKerEq f 𝓚 h𝓚).hom E (op ⊤) _ s).trans
      (congrArg (fun t => Stacks.SheafOfModules.OnSpace.tensorObjTmul X.toRingedSpace
        ((Scheme.Modules.pushforward f).obj (SheafOfModules.unit _)) E (op ⊤) t s) h1))).trans ?_
  exact Stacks.Blowup.pushforwardUnitTensorIso_app_top_one_tmul f E G' e s

/-- **`𝒪_Y(q) = j_*𝒪_{Proj(Gr)}(q)`**, for the closed immersion `j : Proj(Gr_𝔠(C)) ⟶ X` of the
exceptional divisor: `𝒪_Y = j_*𝒪` because `ker j` is the ideal sheaf of `Y`
(`ker_grImmersion`), and `j_*𝒪 ⊗ 𝒪_X(q) = j_*(j^*𝒪_X(q)) = j_*𝒪(q)` by the projection formula
at a closed immersion and the identification of the pulled-back twist (Tag 01N1 (3)). -/
def grTwistIso (q : ℕ) :
    thickeningTwist 𝔠 1 q ≅
      (Scheme.Modules.pushforward (grImmersion π hπs)).obj (twistingSheaf 𝒢 (q : ℤ)) :=
  kerTensorIso (grImmersion π hπs) (thickeningIdeal 𝔠 1) (ker_grImmersion hπs hπ)
    (blowupTwist 𝔠 q) (twistingSheaf 𝒢 (q : ℤ))
      (Stacks.AlgebraicGeometry.ProjMapTwistDegreeSection.pullbackTwistIso π
        (Proj.irrelevant_le_map_of_surjective π hπs) hπs
        (adjoin_reesGradingZero_reesGrading_one_eq_top 𝔠) (q : ℤ))

/-- The canonical section of `𝒪_Y(q)` attached to `x ∈ 𝔠^q` is `1 ⊗ s`, `s` the canonical
section of `𝒪_X(q)`. -/
theorem thickeningSections_eq_tensorObjTmul (q : ℕ) (x : (𝔠 ^ q : Ideal C)) :
    thickeningSections 𝔠 1 q x =
      Stacks.SheafOfModules.OnSpace.tensorObjTmul (blowupScheme 𝔠).toRingedSpace
        (thickeningSheaf 𝔠 1) (blowupTwist 𝔠 q) (op ⊤)
        (((thickeningProj 𝔠 1).val.app (op ⊤)).hom
          (Stacks.SheafOfModules.OnSpace.unitSection (blowupScheme 𝔠).toRingedSpace (op ⊤) 1))
        (degreeSection (reesGrading 𝔠) q (reesGradingEquivPow 𝔠 q x)) :=
  (congrArg (fun t => (((thickeningProj 𝔠 1 ▷ blowupTwist 𝔠 q).val.app (op ⊤)).hom t))
    (Stacks.SheafOfModules.OnSpace.leftUnitor_inv_apply (blowupScheme 𝔠).toRingedSpace
      (blowupTwist 𝔠 q) (op ⊤) _)).trans
    (Stacks.SheafOfModules.OnSpace.whiskerRight_tmul (blowupScheme 𝔠).toRingedSpace
      (thickeningProj 𝔠 1) (blowupTwist 𝔠 q) (op ⊤) _ _)

/-- `grTwistIso hπs hπ q` is `kerTensorIso` for `grImmersion π hπs`, applied to the
identification `pullbackTwistIso` of the pulled-back twist. -/
theorem grTwistIso_eq (q : ℕ) : grTwistIso hπs hπ q = kerTensorIso (grImmersion π hπs)
    (thickeningIdeal 𝔠 1) (ker_grImmersion hπs hπ) (blowupTwist 𝔠 q) (twistingSheaf 𝒢 (q : ℤ))
      (Stacks.AlgebraicGeometry.ProjMapTwistDegreeSection.pullbackTwistIso π
        (Proj.irrelevant_le_map_of_surjective π hπs) hπs
        (adjoin_reesGradingZero_reesGrading_one_eq_top 𝔠) (q : ℤ)) := rfl

/-- **The canonical section of `𝒪_Y(q)` attached to `x ∈ 𝔠^q` is the canonical section of
`𝒪_{Proj(Gr)}(q)` attached to the class of `x` in `Gr_𝔠(C)_q`**, under `grTwistIso`. -/
theorem grTwistIso_thickeningSections (q : ℕ) (x : (𝔠 ^ q : Ideal C)) :
    ((grTwistIso hπs hπ q).hom.val.app (op ⊤)).hom (thickeningSections 𝔠 1 q x) =
      degreeSection 𝒢 q ⟨π (reesGradingEquivPow 𝔠 q x : reesAlgebra 𝔠),
        π.map_mem (reesGradingEquivPow 𝔠 q x).2⟩ := by
  rw [grTwistIso_eq]
  exact (congrArg (fun t => ((kerTensorIso (grImmersion π hπs)
    (thickeningIdeal 𝔠 1) (ker_grImmersion hπs hπ) (blowupTwist 𝔠 q) (twistingSheaf 𝒢 (q : ℤ))
      (Stacks.AlgebraicGeometry.ProjMapTwistDegreeSection.pullbackTwistIso π
        (Proj.irrelevant_le_map_of_surjective π hπs) hπs
        (adjoin_reesGradingZero_reesGrading_one_eq_top 𝔠) (q : ℤ))).hom.val.app (op ⊤)).hom t)
    (thickeningSections_eq_tensorObjTmul q x)).trans
    ((pushforwardUnitIsoOfKerEq_tensor_app_top_one_tmul (grImmersion π hπs)
      (thickeningIdeal 𝔠 1) (ker_grImmersion hπs hπ) (blowupTwist 𝔠 q)
      (twistingSheaf 𝒢 (q : ℤ)) _ _).trans
    (Stacks.AlgebraicGeometry.ProjMapTwistDegreeSection.pullbackTwistIso_degreeSection π
      (Proj.irrelevant_le_map_of_surjective π hπs) hπs
      (adjoin_reesGradingZero_reesGrading_one_eq_top 𝔠) q _))

end Twist

/-! ### `q(S)` read on `S = Gr_𝔠(C)` -/

section GrThreshold

attribute [local instance] modulesEnoughInjectives

variable {S τ : Type u} [CommRing S] [SetLike τ S] [AddSubgroupClass τ S] (𝒮 : ℕ → τ)
  [GradedRing 𝒮]

/-- **The defining property of `q(S)` of [Stacks, Tag 0GA6], read on the graded ring `S`
itself**: for every `q ≥ q₀`, `Hⁱ(Proj S, 𝒪(q)) = 0` for `i ≥ 1` and the canonical map
`S_q → H⁰(Proj S, 𝒪(q))` is bijective. For `S = Gr_I(A)` and `Y = Proj(S)` the exceptional
divisor this is the source's definition; `isBaseThreshold_iff_isGrThreshold` identifies it with
`IsBaseThreshold`, which is stated on the blowup. -/
def IsGrThreshold (q₀ : ℕ) : Prop :=
  (∀ i q : ℕ, 1 ≤ i → q₀ ≤ q →
      IsZero (Hgroup (AlgebraicGeometry.Proj 𝒮).ringCatSheaf ⊤ i (twistingSheaf 𝒮 (q : ℤ)))) ∧
    ∀ q : ℕ, q₀ ≤ q → Function.Bijective (degreeSection 𝒮 q)

end GrThreshold

section ThresholdComparison

attribute [local instance] modulesMonoidal modulesMonoidal' modulesEnoughInjectives

open Stacks.Blowup

variable {C : Type u} [CommRing C] [IsNoetherianRing C] {𝔠 : Ideal C}
  {G σ : Type u} [CommRing G] [SetLike σ G] [AddSubgroupClass σ G] {𝒢 : ℕ → σ} [GradedRing 𝒢]
  {π : reesGrading 𝔠 →+*ᵍ 𝒢} (hπs : Function.Surjective π) (hπ : IsGrQuotient 𝔠 π)

/-- The `A`-linear and the abelian-group cohomology of the blowup vanish together. -/
theorem subsingleton_blowupHmod_iff (i : ℕ) (F : (blowupScheme 𝔠).Modules) :
    Subsingleton (blowupHmod 𝔠 i F) ↔ IsZero (blowupH 𝔠 i F) := by
  obtain ⟨e⟩ := Stacks.Cohomology.rightDerived_comp_iso_of_preservesHomology
    (blowupΓmod 𝔠) (forget₂ (ModuleCat.{u} C) AddCommGrpCat.{u}) i F
  refine ⟨fun h => ?_, fun h => subsingleton_blowupHmod 𝔠 i F
    (AddCommGrpCat.isZero_iff_subsingleton.mp h)⟩
  have : IsZero ((forget₂ (ModuleCat.{u} C) AddCommGrpCat.{u}).obj (blowupHmod 𝔠 i F)) :=
    AddCommGrpCat.isZero_iff_subsingleton.mpr h
  exact this.of_iso e.symm

include hπs hπ in
/-- **`Hⁱ(X, 𝒪_Y(q)) = Hⁱ(Proj(Gr), 𝒪(q))`**, as a statement of vanishing. -/
theorem subsingleton_blowupHmod_thickeningTwist_iff (i q : ℕ) :
    Subsingleton (blowupHmod 𝔠 i (thickeningTwist 𝔠 1 q)) ↔
      IsZero (Hgroup (AlgebraicGeometry.Proj 𝒢).ringCatSheaf ⊤ i (twistingSheaf 𝒢 (q : ℤ))) := by
  rw [subsingleton_blowupHmod_iff]
  exact (Iso.isZero_iff ((Hfunctor (blowupScheme 𝔠).ringCatSheaf ⊤ i).mapIso
    (grTwistIso hπs hπ q))).trans (Iso.isZero_iff
      (@Stacks.AffineCohomologyPushforward.cohomologyIsoPushforwardOfAffine _ _
        (grImmersion π hπs) inferInstance (twistingSheaf 𝒢 (q : ℤ))
        (Stacks.AlgebraicGeometry.Tag0B5QUniformTwistBound.isQuasicoherent_twistingSheaf 𝒢 (q : ℤ))
        i).symm)

/-- The canonical section map of [Stacks, Tag 0AG2] in degree `q`, as an additive map. -/
def degreeSectionAddHom' (q : ℕ) :
    𝒢 q →+ ProjectiveSpectrum.Proj.twistGlobalSections 𝒢 q where
  toFun := degreeSection _ q
  map_zero' := by unfold degreeSection; exact map_zero _
  map_add' a b := by
    unfold degreeSection
    rw [← map_add]
    congr 1

include hπs hπ in
/-- **The canonical map `𝔠^q/𝔠^{q+1} → H⁰(X, 𝒪_Y(q))` is bijective exactly when
`Gr_𝔠(C)_q → H⁰(Proj(Gr), 𝒪(q))` is.** -/
theorem bijective_cdivMod_iff (q : ℕ) :
    Function.Bijective (cdivMod 𝔠 0 q) ↔ Function.Bijective (degreeSection 𝒢 q) := by
  -- the class in `Gr_𝔠(C)_q`
  let ρ : (𝔠 ^ q : Ideal C) → 𝒢 q := fun x => ⟨π (reesGradingEquivPow 𝔠 q x : reesAlgebra 𝔠),
    π.map_mem (reesGradingEquivPow 𝔠 q x).2⟩
  have hρs : Function.Surjective ρ := by
    intro y
    obtain ⟨a, ha⟩ := Proj.gradedAddHom_surjective_of_surjective π hπs q y
    obtain ⟨x, rfl⟩ := (reesGradingEquivPow 𝔠 q).surjective a
    exact ⟨x, ha⟩
  have hρ0 : ∀ x, ρ x = 0 ↔ (x : C) ∈ 𝔠 ^ (q + 1) := by
    intro x
    have h := hπ q _ (reesGradingEquivPow 𝔠 q x).2
    rw [coe_reesGradingEquivPow, Polynomial.coeff_monomial, if_pos rfl] at h
    rw [← h, Subtype.ext_iff]
    rfl
  -- the comparison of sections
  let τ := ((grTwistIso hπs hπ q).hom.val.app (op ⊤)).hom
  have hτ : Function.Bijective τ := by
    refine ⟨fun a b hab => ?_, fun b => ?_⟩
    · have := congrArg ((grTwistIso hπs hπ q).inv.val.app (op ⊤)).hom hab
      rwa [← comp_val_app_apply, ← comp_val_app_apply, Iso.hom_inv_id] at this
    · refine ⟨((grTwistIso hπs hπ q).inv.val.app (op ⊤)).hom b, ?_⟩
      show ((grTwistIso hπs hπ q).hom.val.app (op ⊤)).hom
        (((grTwistIso hπs hπ q).inv.val.app (op ⊤)).hom b) = b
      rw [← comp_val_app_apply, Iso.inv_hom_id]
      rfl
  have hτT : ∀ x, τ (thickeningSections 𝔠 1 q x) = degreeSection 𝒢 q (ρ x) :=
    grTwistIso_thickeningSections hπs hπ q
  have hT0 : ∀ x, thickeningSections 𝔠 1 q x = 0 ↔ degreeSection 𝒢 q (ρ x) = 0 := by
    intro x
    rw [← hτT]
    exact ⟨fun h => by rw [h, map_zero]; rfl, fun h => hτ.1 (h.trans (map_zero τ).symm)⟩
  constructor
  · rintro ⟨hinj, hsurj⟩
    refine ⟨(injective_iff_map_eq_zero (degreeSectionAddHom' (𝒢 := 𝒢) q)).2 fun y hy => ?_, fun t => ?_⟩
    · obtain ⟨x, rfl⟩ := hρs y
      rw [hρ0]
      have h1 : cdivMod 𝔠 0 q (Submodule.Quotient.mk x) = 0 := by
        rwa [cdivMod_mk', thickeningSectionsMod_eq_zero_iff, hT0]
      have h2 := hinj (h1.trans (map_zero _).symm)
      rw [Submodule.Quotient.mk_eq_zero] at h2
      simpa [powSub] using h2
    · obtain ⟨u, hu⟩ := hτ.2 t
      obtain ⟨z, hz⟩ := hsurj (blowupΓmodToH0 𝔠 (thickeningTwist 𝔠 1 q) u)
      induction z using Submodule.Quotient.induction_on with
      | H x =>
        rw [cdivMod_mk] at hz
        have := injective_blowupΓmodToH0 𝔠 _ hz
        exact ⟨ρ x, by rw [← hτT, this, hu]⟩
  · rintro ⟨hinj, hsurj⟩
    refine ⟨(injective_iff_map_eq_zero (cdivMod 𝔠 0 q)).2 fun z hz => ?_, fun w => ?_⟩
    · induction z using Submodule.Quotient.induction_on with
      | H x =>
        rw [cdivMod_mk', thickeningSectionsMod_eq_zero_iff, hT0] at hz
        have h1 : ρ x = 0 := (injective_iff_map_eq_zero (degreeSectionAddHom' (𝒢 := 𝒢) q)).1 hinj _ hz
        rw [Submodule.Quotient.mk_eq_zero]
        simpa [powSub] using (hρ0 x).1 h1
    · obtain ⟨u, rfl⟩ := surjective_blowupΓmodToH0 𝔠 (thickeningTwist 𝔠 1 q) w
      obtain ⟨y, hy⟩ := hsurj (τ u)
      obtain ⟨x, rfl⟩ := hρs y
      refine ⟨Submodule.Quotient.mk x, ?_⟩
      rw [cdivMod_mk, hτ.1 ((hτT x).trans hy)]

include hπs hπ in
/-- **The defining property of `q(S)` is a property of `S = Gr_𝔠(C)`** ([Stacks, Tag 0GA6]): for
any graded surjection of the Rees algebra onto `Gr_𝔠(C)`, `q₀` has the defining property of
`q(S)` on the blowup exactly when it has it on `Proj(Gr_𝔠(C))`. -/
theorem isBaseThreshold_iff_isGrThreshold (q₀ : ℕ) :
    IsBaseThreshold 𝔠 q₀ ↔ IsGrThreshold 𝒢 q₀ :=
  and_congr (forall₄_congr fun i q _ _ => subsingleton_blowupHmod_thickeningTwist_iff hπs hπ i q)
    (forall₂_congr fun q _ => bijective_cdivMod_iff hπs hπ q)

end ThresholdComparison

/-! ### Two quotients with the same initial forms have the same `q(S)` -/

section InitialForms

open Stacks.Blowup

/-- **The initial forms of two ideals agree**: for every `k`, the elements of `𝔞ᵏ` lying in
`𝔞ᵏ⁺¹ + J` are those lying in `𝔞ᵏ⁺¹ + J'`. Equivalently `Gr_𝔞(R ⧸ J) = Gr_𝔞(R ⧸ J')` as
quotients of `Gr_𝔞(R)`: this is the form in which Stacks 07VF produces
`Gr_I(B) ≅ Gr_I(B')` in step (B) of the proof of Stacks 0GAR, see
`presentation_denominator_eq`. -/
def SameInitialForms {R : Type*} [CommRing R] (𝔞 J J' : Ideal R) : Prop :=
  ∀ k : ℕ, (AssociatedGraded.power (M := R) 𝔞 (k + 1) ⊔ J).comap
      (AssociatedGraded.power (M := R) 𝔞 k).subtype =
    (AssociatedGraded.power (M := R) 𝔞 (k + 1) ⊔ J').comap
      (AssociatedGraded.power (M := R) 𝔞 k).subtype

/-- A Noetherian ideal has a generating family indexed by some `Fin (d + 1)`: pad a finite
generating family with a zero. -/
theorem exists_fin_succ_span_eq {R : Type*} [CommRing R] [IsNoetherianRing R] (J : Ideal R) :
    ∃ (d : ℕ) (x : Fin (d + 1) → R), (∀ j, x j ∈ J) ∧ J = Ideal.span (Set.range x) := by
  classical
  obtain ⟨m, y, hy⟩ := Submodule.fg_iff_exists_fin_generating_family.1 (IsNoetherian.noetherian J)
  have hspan : Ideal.span (Set.range (Fin.snoc y (0 : R))) = J := by
    refine le_antisymm (Ideal.span_le.2 ?_) (hy ▸ Ideal.span_mono ?_)
    · rintro a ⟨j, rfl⟩
      refine Fin.lastCases ?_ ?_ j
      · simpa using Submodule.zero_mem J
      · intro j
        simpa using hy ▸ Ideal.subset_span (Set.mem_range_self (f := y) j)
    · rintro a ⟨j, rfl⟩
      exact ⟨j.castSucc, by simp⟩
  exact ⟨m, Fin.snoc y 0,
    fun j => hspan ▸ Ideal.subset_span (Set.mem_range_self (f := Fin.snoc y (0 : R)) j),
    hspan.symm⟩

variable {R : Type u} [CommRing R] [IsNoetherianRing R] (𝔞 : Ideal R) {d : ℕ}
  (x : Fin (d + 1) → R) (hx : ∀ j, x j ∈ 𝔞) (hspan : 𝔞 = Ideal.span (Set.range x))
  (J : Ideal R)

include hx in
/-- A homogeneous polynomial of degree `m` takes values in `𝔞ᵐ` at a point of `𝔞^{d+1}`. -/
theorem eval_mem_pow_of_isHomogeneous {p : MvPolynomial (Fin (d + 1)) R} {m : ℕ}
    (hp : p.IsHomogeneous m) : MvPolynomial.eval x p ∈ 𝔞 ^ m := by
  have h := coe_reesPresentation_apply 𝔞 x hx hp
  have hc := (mem_reesAlgebra_iff 𝔞 _).1 (reesPresentation 𝔞 x hx p).2 m
  rwa [h, Polynomial.coeff_monomial, if_pos rfl] at hc

/-- The map `R[T₀, …, T_d] ⟶ Gr_𝔞(R ⧸ J)`, `Tⱼ ↦ x̄ⱼ` in degree one. -/
abbrev grPresentation :
    MvPolynomial.homogeneousSubmodule (Fin (d + 1)) R →+*ᵍ
      Stacks.HomogeneousIdeal.quotientGrading (grIdeal (𝔞.map (Ideal.Quotient.mk J))) :=
  (grQuotient (𝔞.map (Ideal.Quotient.mk J))).comp (reesPresentationQuot 𝔞 x hx J)

include hspan in
/-- `grPresentation 𝔞 x hx J` is surjective. -/
theorem surjective_grPresentation : Function.Surjective (grPresentation 𝔞 x hx J) :=
  (surjective_grQuotient _).comp (surjective_reesPresentationQuot 𝔞 x hx J hspan)

/-- **The kernel of `R[T] ⟶ Gr_𝔞(R ⧸ J)` in degree `m`**: `p` dies exactly when
`p(x) ∈ 𝔞ᵐ⁺¹ + J`. -/
theorem grPresentation_eq_zero_iff {m : ℕ} {p : MvPolynomial (Fin (d + 1)) R}
    (hp : p.IsHomogeneous m) :
    grPresentation 𝔞 x hx J p = 0 ↔ MvPolynomial.eval x p ∈ 𝔞 ^ (m + 1) ⊔ J := by
  have hmem : reesPresentationQuot 𝔞 x hx J p ∈ reesGrading (𝔞.map (Ideal.Quotient.mk J)) m :=
    (reesPresentationQuot 𝔞 x hx J).map_mem ((MvPolynomial.mem_homogeneousSubmodule _ _).2 hp)
  refine (isGrQuotient_grQuotient _ m _ hmem).trans ?_
  rw [coe_reesPresentationQuot_apply 𝔞 x hx J hp, Polynomial.coeff_monomial, if_pos rfl,
    ← Ideal.map_pow, Ideal.mem_quotient_iff_mem_sup]

/-- The homogeneous ideal of `R[T]` of the forms that vanish in `Gr_𝔞(R ⧸ J)`. -/
abbrev initialFormIdeal : HomogeneousIdeal (MvPolynomial.homogeneousSubmodule (Fin (d + 1)) R) :=
  Stacks.GradedKerQuotient.homogeneousKer _ _ (grPresentation 𝔞 x hx J)

include hx in
/-- **Two ideals with the same initial forms give the same homogeneous ideal of `R[T]`.** -/
theorem initialFormIdeal_eq {J J' : Ideal R} (h : SameInitialForms 𝔞 J J') :
    initialFormIdeal 𝔞 x hx J = initialFormIdeal 𝔞 x hx J' := by
  refine HomogeneousIdeal.ext' fun m p hp => ?_
  have hp' : p.IsHomogeneous m := (MvPolynomial.mem_homogeneousSubmodule _ _).1 hp
  refine ((Stacks.GradedKerQuotient.mem_homogeneousKer_iff _ _ _ p).trans ?_).trans
    (Stacks.GradedKerQuotient.mem_homogeneousKer_iff _ _ _ p).symm
  rw [grPresentation_eq_zero_iff 𝔞 x hx J hp', grPresentation_eq_zero_iff 𝔞 x hx J' hp']
  have hpow : ∀ k : ℕ, AssociatedGraded.power (M := R) 𝔞 k = 𝔞 ^ k := fun k => by
    simp [AssociatedGraded.power]
  have hk := congrArg (fun S => (⟨MvPolynomial.eval x p, by
    rw [hpow]; exact eval_mem_pow_of_isHomogeneous 𝔞 x hx hp'⟩ :
      (AssociatedGraded.power (M := R) 𝔞 m)) ∈ S) (h m)
  simp only [Submodule.mem_comap, Submodule.coe_subtype, hpow] at hk
  exact hk.to_iff

/-- The quotient of the Rees algebra of `𝔞 · (R ⧸ J)` onto `Gr_𝔞(R ⧸ J)`, read as the quotient of
`R[T]` by the forms vanishing in it. -/
abbrev grQuotientOfPresentation :
    reesGrading (𝔞.map (Ideal.Quotient.mk J)) →+*ᵍ
      Stacks.HomogeneousIdeal.quotientGrading (initialFormIdeal 𝔞 x hx J) :=
  (Stacks.GradedKerQuotient.inv _ _ (grPresentation 𝔞 x hx J)
    (surjective_grPresentation 𝔞 x hx hspan J)).comp (grQuotient _)

/-- `grQuotientOfPresentation 𝔞 x hx hspan J` is surjective. -/
theorem surjective_grQuotientOfPresentation :
    Function.Surjective (grQuotientOfPresentation 𝔞 x hx hspan J) := by
  intro y
  obtain ⟨z, hz⟩ := (Stacks.GradedKerQuotient.descRingEquiv _ _ (grPresentation 𝔞 x hx J)
    (surjective_grPresentation 𝔞 x hx hspan J)).symm.surjective y
  obtain ⟨w, rfl⟩ := surjective_grQuotient _ z
  exact ⟨w, hz⟩

/-- `grQuotientOfPresentation 𝔞 x hx hspan J` is the quotient of the Rees algebra onto
`Gr_𝔞(R ⧸ J)`. -/
theorem isGrQuotient_grQuotientOfPresentation :
    IsGrQuotient _ (grQuotientOfPresentation 𝔞 x hx hspan J) := by
  intro n y hy
  refine Iff.trans ?_ (isGrQuotient_grQuotient _ n y hy)
  show (Stacks.GradedKerQuotient.descRingEquiv _ _ (grPresentation 𝔞 x hx J)
    (surjective_grPresentation 𝔞 x hx hspan J)).symm (grQuotient _ y) = 0 ↔ _
  exact map_eq_zero_iff _ (RingEquiv.injective _)

omit [IsNoetherianRing R] in
/-- **Two quotients of `R` with the same initial forms have the same threshold `q(S)`**
([Stacks, Tag 0GA6]: `q` only depends on `S = Gr`), which is what step (C) of the proof of
Stacks 0GAR uses: `q₀ = q(Gr_I(B)) = q(Gr_I(B'))` since `Gr_I(B) ≅ Gr_I(B')`. -/
theorem isBaseThreshold_iff_of_sameInitialForms [IsNoetherianRing R] {J J' : Ideal R}
    (h : SameInitialForms 𝔞 J J') (q₀ : ℕ) :
    IsBaseThreshold (𝔞.map (Ideal.Quotient.mk J)) q₀ ↔
      IsBaseThreshold (𝔞.map (Ideal.Quotient.mk J')) q₀ := by
  obtain ⟨d, x, hx, hspan⟩ := exists_fin_succ_span_eq 𝔞
  rw [isBaseThreshold_iff_isGrThreshold (surjective_grQuotientOfPresentation 𝔞 x hx hspan J)
      (isGrQuotient_grQuotientOfPresentation 𝔞 x hx hspan J),
    isBaseThreshold_iff_isGrThreshold (surjective_grQuotientOfPresentation 𝔞 x hx hspan J')
      (isGrQuotient_grQuotientOfPresentation 𝔞 x hx hspan J'),
    initialFormIdeal_eq 𝔞 x hx h]

end InitialForms

end Stacks.LocalCohomology.UniformityIII

end
