module

public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Functor
public import StacksFrontier.AlgebraicGeometry.Constructions.ProjToSpecZero
public import StacksFrontier.AlgebraicGeometry.LocalCohomology.AssociatedGradedInvariants
public import StacksFrontier.AlgebraicGeometry.LocalCohomology.BitUniformityIII.FibreDimensionBound

/-!
# The two descriptions of `d(S)` in Tag 0GA6 agree

Let `A` be a Noetherian ring and `I ⊆ A` an ideal, let `p : X = Proj(⨁ₙ Iⁿ) → Spec(A)` be the
blowing up of `Spec(A)` in `I` (`Stacks.Blowup.toSpec I`), and let `S = Gr_I(A) = ⨁ₙ Iⁿ/Iⁿ⁺¹`.
[Stacks, Tag 0GA6] defines `d = d(S)` as the maximal dimension of the fibres of `p`, and notes
that it is also the maximal dimension of the fibres of `Y = Proj(S) → Spec(S₀)` when `Y ≠ ∅`,
and `0` when `Y = ∅`. In this repository the first description is
`Stacks.LocalCohomology.UniformityIII.fibreDim` and the second is `AssociatedGraded.dInvariant`;
this file proves they agree.

The proof works with the underlying topological spaces of the fibres.

* The graded surjection `π : ⨁ Iⁿ → ⨁ Iⁿ/Iⁿ⁺¹` (`reesToGraded`) has kernel generated by `I` in
  degree `0` (`ker_reesToGraded_le`). Pulling homogeneous primes back along `π` is therefore a
  homeomorphism of `Proj(S)` onto the closed subset of `X` lying over `V(I)`, compatible with the
  structure maps; so for `y ∈ Spec(S₀) = V(I)` the fibre of `p` over `y` is homeomorphic to the
  fibre of `Y → Spec(S₀)` over `y` (`topologicalKrullDim_fiber_toSpec_eq`).
* Over a point `s ∉ V(I)` the fibre of `p` has at most one point (`subsingleton_fiber_toSpec`):
  for `b ∈ I \ s`, a homogeneous prime over `s` does not contain `b t`, and contains `x tⁿ` iff
  `x ∈ s`, because `bⁿ · x tⁿ = x · (b t)ⁿ`. Such a fibre has dimension `≤ 0`.

## Main definitions

* `Stacks.LocalCohomology.UniformityIII.reesToGraded`: the graded surjection `⨁ Iⁿ → Gr_I(A)`.
* `Stacks.LocalCohomology.UniformityIII.grToBlowup`: the induced map `Proj(Gr_I(A)) → X`.

## Main results

* `Stacks.LocalCohomology.UniformityIII.topologicalKrullDim_fiber_toSpec_eq`: the fibres of `p`
  over `V(I)` have the dimensions of the fibres of `Proj(Gr_I(A)) → Spec(Gr_I(A)₀)`.
* `Stacks.LocalCohomology.UniformityIII.subsingleton_fiber_toSpec`: the fibres of `p` off `V(I)`
  have at most one point.
* `Stacks.LocalCohomology.UniformityIII.dInvariant_eq_fibreDim`: `AssociatedGraded.dInvariant I =
  fibreDim I`.

## References

* [Stacks Project, Tag 0GA6](https://stacks.math.columbia.edu/tag/0GA6)
-/

@[expose] public noncomputable section

open AlgebraicGeometry AssociatedGraded Polynomial Topology

universe u

namespace Stacks.LocalCohomology.UniformityIII

variable {A : Type u} [CommRing A] (I : Ideal A)

/-! ### The graded surjection `⨁ Iⁿ → ⨁ Iⁿ/Iⁿ⁺¹` -/

/-- The degree-`n` part of the surjection from the Rees algebra onto the associated graded ring:
a homogeneous element `x tⁿ` with `x ∈ Iⁿ` goes to the class of `x` in `Iⁿ/Iⁿ⁺¹`. -/
def reesToGradedPiece (n : ℕ) : Stacks.Blowup.reesGrading I n →+ piece (M := A) I n where
  toFun f := mk I n ⟨((f : reesAlgebra I) : A[X]).coeff n, by
    simpa only [ring_power_eq] using (f : reesAlgebra I).2 n⟩
  map_zero' := (Submodule.Quotient.mk_eq_zero _).2 (by simp)
  map_add' f g := by
    simp only [mk]
    rw [← Submodule.Quotient.mk_add]
    congr 1
    exact Subtype.ext (by simp)

/-- The leading coefficient of a product of homogeneous elements of the Rees algebra is the
product of the leading coefficients. -/
theorem coeff_mul_of_mem {i j : ℕ} {a b : reesAlgebra I} (ha : a ∈ Stacks.Blowup.reesGrading I i)
    (hb : b ∈ Stacks.Blowup.reesGrading I j) :
    ((a * b : reesAlgebra I) : A[X]).coeff (i + j) =
      (a : A[X]).coeff i * (b : A[X]).coeff j := by
  rw [Subalgebra.coe_mul]
  conv_lhs => rw [Stacks.Blowup.coe_eq_monomial I ha, Stacks.Blowup.coe_eq_monomial I hb]
  rw [monomial_mul_monomial, coeff_monomial_same]

/-- The ring map from the direct sum of the homogeneous pieces of the Rees algebra onto the
associated graded ring, assembled from `reesToGradedPiece`. -/
def reesToGradedSum : (DirectSum ℕ fun n => Stacks.Blowup.reesGrading I n) →+* gradedRing I :=
  DirectSum.toSemiring
    (fun n => (DirectSum.of (fun k => piece (M := A) I k) n).comp (reesToGradedPiece I n))
    (by
      rw [AddMonoidHom.comp_apply, DirectSum.one_def]
      congr 1
      change mk I 0 _ = mk I 0 _
      congr 1
      exact Subtype.ext (by simp))
    (by
      intro i j a b
      simp only [AddMonoidHom.comp_apply]
      rw [of_mul_of]
      congr 1
      change mk I (i + j) _ = homogeneousSMul I (mk I i _) (mk I j _)
      rw [homogeneousSMul_mk]
      congr 1
      exact Subtype.ext (coeff_mul_of_mem I a.2 b.2))

/-- The ring map from the Rees algebra `⨁ Iⁿ` onto the associated graded ring `⨁ Iⁿ/Iⁿ⁺¹`,
`reesToGradedSum` on the homogeneous decomposition. -/
def reesToGradedRingHom : reesAlgebra I →+* gradedRing I :=
  (reesToGradedSum I).comp
    (DirectSum.decomposeRingEquiv (Stacks.Blowup.reesGrading I)).toRingHom

/-- `reesToGradedRingHom` on a homogeneous element of degree `n` is `reesToGradedPiece` in
degree `n`. -/
theorem reesToGradedRingHom_of_mem {n : ℕ} {x : reesAlgebra I}
    (hx : x ∈ Stacks.Blowup.reesGrading I n) :
    reesToGradedRingHom I x =
      DirectSum.of (fun k => piece (M := A) I k) n (reesToGradedPiece I n ⟨x, hx⟩) := by
  change reesToGradedSum I (DirectSum.decompose (Stacks.Blowup.reesGrading I) x) = _
  rw [DirectSum.decompose_of_mem _ hx, reesToGradedSum, DirectSum.toSemiring_of]
  rfl

/-- **The graded surjection `π : ⨁ Iⁿ → ⨁ Iⁿ/Iⁿ⁺¹`** from the Rees algebra onto the associated
graded ring, as a graded ring homomorphism. -/
def reesToGraded : Stacks.Blowup.reesGrading I →+*ᵍ grading I where
  toRingHom := reesToGradedRingHom I
  map_mem hx := by
    rw [reesToGradedRingHom_of_mem I hx]
    exact of_mem_grading I _

/-- `π` on a homogeneous element `x tⁿ` is the class of `x` in `Iⁿ/Iⁿ⁺¹`, placed in degree `n`. -/
theorem reesToGraded_of_mem {n : ℕ} {x : reesAlgebra I}
    (hx : x ∈ Stacks.Blowup.reesGrading I n) :
    reesToGraded I x =
      DirectSum.of (fun k => piece (M := A) I k) n (reesToGradedPiece I n ⟨x, hx⟩) :=
  reesToGradedRingHom_of_mem I hx

/-- Each degree-`n` piece `Iⁿ → Iⁿ/Iⁿ⁺¹` of `π` is surjective. -/
theorem reesToGradedPiece_surjective (n : ℕ) : Function.Surjective (reesToGradedPiece I n) := by
  intro c
  obtain ⟨z, rfl⟩ := Submodule.Quotient.mk_surjective _ c
  have hz : (z : A) ∈ I ^ n := by simpa only [ring_power_eq] using z.2
  refine ⟨Stacks.Blowup.reesMonomial I n ⟨z, hz⟩, ?_⟩
  change mk I n _ = Submodule.Quotient.mk z
  congr 1
  exact Subtype.ext (by simp)

/-- **`π : ⨁ Iⁿ → ⨁ Iⁿ/Iⁿ⁺¹` is surjective.** -/
theorem reesToGraded_surjective : Function.Surjective (reesToGraded I) := by
  intro y
  induction y using DirectSum.induction_on with
  | zero => exact ⟨0, map_zero _⟩
  | of n c =>
    obtain ⟨x, rfl⟩ := reesToGradedPiece_surjective I n c
    exact ⟨x, reesToGraded_of_mem I x.2⟩
  | add y z hy hz =>
    obtain ⟨a, rfl⟩ := hy
    obtain ⟨b, rfl⟩ := hz
    exact ⟨a + b, map_add _ _ _⟩

/-- In degree `0`, `π` is the quotient map `A → A/I = Gr_I(A)₀`. -/
theorem reesToGraded_algebraMap (a : A) :
    reesToGraded I (algebraMap A (reesAlgebra I) a) = (gradeZeroHom I a : gradedRing I) := by
  rw [reesToGraded_of_mem I (SetLike.algebraMap_mem_graded (Stacks.Blowup.reesGrading I) a),
    coe_gradeZeroHom]
  congr 1
  change mk I 0 _ = mk I 0 _
  congr 1
  exact Subtype.ext (by simp)

/-- `π` commutes with taking homogeneous components. -/
theorem reesToGraded_proj (w : reesAlgebra I) (n : ℕ) :
    reesToGraded I (GradedRing.proj (Stacks.Blowup.reesGrading I) n w) =
      GradedRing.proj (grading I) n (reesToGraded I w) := by
  simp only [GradedRing.proj_apply]
  exact (reesToGraded I).map_directSumDecompose

/-- `π` maps the irrelevant ideal of `⨁ Iⁿ` into the irrelevant ideal of `Gr_I(A)`. -/
theorem irrelevant_le_comap_reesToGraded :
    (HomogeneousIdeal.irrelevant (Stacks.Blowup.reesGrading I)).toIdeal ≤
      (HomogeneousIdeal.irrelevant (grading I)).toIdeal.comap (reesToGraded I) := by
  intro f hf
  rw [Ideal.mem_comap, HomogeneousIdeal.mem_iff, HomogeneousIdeal.mem_irrelevant_iff,
    ← reesToGraded_proj, (HomogeneousIdeal.mem_irrelevant_iff _ f).1 hf, map_zero]

/-- The irrelevant ideal of `Gr_I(A)` is the image of the irrelevant ideal of `⨁ Iⁿ`; this is the
hypothesis under which `π` induces a map `Proj(Gr_I(A)) → Proj(⨁ Iⁿ)`. -/
theorem irrelevant_le_map_reesToGraded :
    HomogeneousIdeal.irrelevant (grading I) ≤
      (HomogeneousIdeal.irrelevant (Stacks.Blowup.reesGrading I)).map (reesToGraded I) := by
  intro z hz
  obtain ⟨w, rfl⟩ := reesToGraded_surjective I z
  have h0 : reesToGraded I (GradedRing.proj (Stacks.Blowup.reesGrading I) 0 w) = 0 := by
    rw [reesToGraded_proj]
    exact hz
  have hmem : w - GradedRing.proj (Stacks.Blowup.reesGrading I) 0 w ∈
      HomogeneousIdeal.irrelevant (Stacks.Blowup.reesGrading I) := by
    have hw0 : GradedRing.proj (Stacks.Blowup.reesGrading I) 0 w ∈
        Stacks.Blowup.reesGrading I 0 := by
      rw [GradedRing.proj_apply]
      exact SetLike.coe_mem _
    rw [HomogeneousIdeal.mem_irrelevant_iff, map_sub, GradedRing.proj_apply _ 0
      (GradedRing.proj (Stacks.Blowup.reesGrading I) 0 w),
      DirectSum.decompose_of_mem_same _ hw0, sub_self]
  have := Ideal.mem_map_of_mem (reesToGraded I) hmem
  rwa [map_sub, h0, sub_zero] at this

/-- An element of the Rees algebra of the form `x tⁿ` with `x ∈ I · Iⁿ` lies in every ideal
containing the image of `I` in degree `0`. -/
theorem monomial_mem_of_mem_mul (J : Ideal (reesAlgebra I))
    (hJ : ∀ a ∈ I, algebraMap A (reesAlgebra I) a ∈ J) {n : ℕ} {c : A} (hc : c ∈ I * I ^ n) :
    (⟨monomial n c, reesAlgebra.monomial_mem.2 (Ideal.mul_le_right hc)⟩ : reesAlgebra I) ∈ J := by
  induction hc using Submodule.mul_induction_on' with
  | mem_mul_mem a ha b hb =>
    have : (⟨monomial n (a * b), reesAlgebra.monomial_mem.2 (Ideal.mul_le_right
        (Ideal.mul_mem_mul ha hb))⟩ : reesAlgebra I) =
        algebraMap A (reesAlgebra I) a * ⟨monomial n b, reesAlgebra.monomial_mem.2 hb⟩ :=
      Subtype.ext (by simp [C_mul_monomial])
    rw [this]
    exact J.mul_mem_right _ (hJ a ha)
  | add x hx y hy ihx ihy =>
    have : (⟨monomial n (x + y), reesAlgebra.monomial_mem.2 (Ideal.mul_le_right
        (Submodule.add_mem _ hx hy))⟩ : reesAlgebra I) =
        ⟨monomial n x, reesAlgebra.monomial_mem.2 (Ideal.mul_le_right hx)⟩ +
          ⟨monomial n y, reesAlgebra.monomial_mem.2 (Ideal.mul_le_right hy)⟩ :=
      Subtype.ext (by simp)
    rw [this]
    exact J.add_mem ihx ihy

/-- **The kernel of `π` is generated by `I` in degree `0`**, in the form used here: it lies in
every homogeneous ideal containing the image of `I` in degree `0`. -/
theorem ker_reesToGraded_le (P : HomogeneousIdeal (Stacks.Blowup.reesGrading I))
    (hP : ∀ a ∈ I, algebraMap A (reesAlgebra I) a ∈ P) :
    RingHom.ker (reesToGraded I) ≤ P.toIdeal := by
  intro f hf
  rw [P.isHomogeneous.mem_iff]
  intro n
  set h := DirectSum.decompose (Stacks.Blowup.reesGrading I) f n
  have h0 : reesToGraded I (h : reesAlgebra I) = 0 := by
    rw [(reesToGraded I).map_directSumDecompose, RingHom.mem_ker.1 hf]
    simp
  rw [reesToGraded_of_mem I h.2] at h0
  have h1 := DirectSum.of_injective n (h0.trans (map_zero _).symm)
  have hc : ((h : reesAlgebra I) : A[X]).coeff n ∈ I * I ^ n := by
    have := (Submodule.Quotient.mk_eq_zero _).1 h1
    simpa [ring_power_eq, pow_succ'] using this
  have he : (h : reesAlgebra I) =
      ⟨monomial n (((h : reesAlgebra I) : A[X]).coeff n),
        reesAlgebra.monomial_mem.2 (Ideal.mul_le_right hc)⟩ :=
    Subtype.ext (Stacks.Blowup.coe_eq_monomial I h.2)
  rw [he]
  exact monomial_mem_of_mem_mul I P.toIdeal hP hc

/-- For a homogeneous ideal `P` containing `I` in degree `0`, the preimage of `π(P)` is `P`. -/
theorem mem_of_reesToGraded_mem_map {P : HomogeneousIdeal (Stacks.Blowup.reesGrading I)}
    (hP : ∀ a ∈ I, algebraMap A (reesAlgebra I) a ∈ P) {f : reesAlgebra I}
    (hf : reesToGraded I f ∈ P.toIdeal.map (reesToGraded I)) : f ∈ P := by
  obtain ⟨x, hx, hxf⟩ := (Ideal.mem_map_iff_of_surjective _ (reesToGraded_surjective I)).1 hf
  have hk : f - x ∈ RingHom.ker (reesToGraded I) := by
    rw [RingHom.mem_ker, map_sub, hxf, sub_self]
  have := P.toIdeal.add_mem hx (ker_reesToGraded_le I P hP hk)
  rwa [add_sub_cancel] at this

/-! ### The structure maps on points -/

/-- The map `Spec(Gr_I(A)₀) → Spec A` induced by `A → A/I ≅ Gr_I(A)₀`; it identifies
`Spec(Gr_I(A)₀)` with `V(I)`. -/
abbrev gradeZeroToSpec : Spec (.of (grading I 0)) ⟶ Spec (CommRingCat.of A) :=
  Spec.map (CommRingCat.ofHom (gradeZeroHom I))

/-- `Spec(Gr_I(A)₀) → Spec A` on points is the pullback along `A → Gr_I(A)₀`. -/
theorem mem_gradeZeroToSpec_iff (y : Spec (.of (grading I 0))) (a : A) :
    a ∈ PrimeSpectrum.asIdeal (gradeZeroToSpec I y) ↔ gradeZeroHom I a ∈ y.asIdeal :=
  Iff.rfl

/-- The blowup `p : Proj(⨁ Iⁿ) → Spec A` on points: `a ∈ p(𝔭)` iff `a`, placed in degree `0`,
lies in `𝔭`. -/
theorem mem_toSpec_iff (x : AlgebraicGeometry.Proj (Stacks.Blowup.reesGrading I)) (a : A) :
    a ∈ PrimeSpectrum.asIdeal (Stacks.Blowup.toSpec I x) ↔
      algebraMap A (reesAlgebra I) a ∈ x.asHomogeneousIdeal := by
  have h := Stacks.AlgebraicGeometry.ProjToSpecZero.toSpecZero_apply
    (Stacks.Blowup.reesGrading I) x
  have h1 : Stacks.Blowup.toSpec I x =
      Spec.map (CommRingCat.ofHom (Stacks.Blowup.reesGradingZeroEquiv I).toRingHom)
        (Proj.toSpecZero (Stacks.Blowup.reesGrading I) x) := rfl
  rw [h1, Spec.map_apply, h]
  change ((algebraMap A (Stacks.Blowup.reesGrading I 0) a : Stacks.Blowup.reesGrading I 0) :
    reesAlgebra I) ∈ x.asHomogeneousIdeal ↔ _
  rw [SetLike.GradeZero.coe_algebraMap]

/-- The structure map `Proj(Gr_I(A)) → Spec(Gr_I(A)₀)` on points: `c ∈ g(𝔮)` iff `c ∈ 𝔮`. -/
theorem mem_toSpecGradeZero_iff (y : projGr I) (c : grading I 0) :
    c ∈ PrimeSpectrum.asIdeal (toSpecGradeZero I y) ↔
      (c : gradedRing I) ∈ y.asHomogeneousIdeal := by
  have h := Stacks.AlgebraicGeometry.ProjToSpecZero.toSpecZero_apply (grading I) y
  rw [toSpecGradeZero, h]
  rfl

/-! ### `Proj(Gr_I(A))` as the closed subset of the blowup over `V(I)` -/

/-- The map `Proj(Gr_I(A)) → Proj(⨁ Iⁿ)` on homogeneous primes, pulling back along the graded
surjection `π`, as a continuous map of homogeneous spectra. -/
def grToBlowupCont :
    C(ProjectiveSpectrum (grading I), ProjectiveSpectrum (Stacks.Blowup.reesGrading I)) :=
  ProjectiveSpectrum.comap (reesToGraded I) (irrelevant_le_map_reesToGraded I)

/-- Pulling back along the surjection `π` is injective on homogeneous primes. -/
theorem grToBlowupCont_injective : Function.Injective (grToBlowupCont I) := by
  intro x x' h
  refine ProjectiveSpectrum.ext (HomogeneousIdeal.ext ?_)
  rw [← Ideal.map_comap_of_surjective _ (reesToGraded_surjective I) x.asHomogeneousIdeal.toIdeal,
    ← Ideal.map_comap_of_surjective _ (reesToGraded_surjective I) x'.asHomogeneousIdeal.toIdeal]
  exact congrArg (fun z => (z.asHomogeneousIdeal.toIdeal).map (reesToGraded I)) h

/-- Pulling back along the surjection `π` is a topological embedding of homogeneous spectra: the
closed set `V₊(T)` of `Proj(Gr_I(A))` is the preimage of `V₊(π⁻¹ T)`. -/
theorem isInducing_grToBlowupCont : IsInducing (grToBlowupCont I) := by
  refine ⟨TopologicalSpace.ext_iff_isClosed.mpr fun U => ?_⟩
  rw [isClosed_induced_iff]
  refine ⟨fun hU => ?_, ?_⟩
  · obtain ⟨t, rfl⟩ := (ProjectiveSpectrum.isClosed_iff_zeroLocus (grading I) U).1 hU
    refine ⟨ProjectiveSpectrum.zeroLocus _ (reesToGraded I ⁻¹' t),
      ProjectiveSpectrum.isClosed_zeroLocus _ _, ?_⟩
    ext x
    simp only [Set.mem_preimage, ProjectiveSpectrum.mem_zeroLocus]
    change ⇑(reesToGraded I) ⁻¹' t ⊆ ⇑(reesToGraded I) ⁻¹' (x.asHomogeneousIdeal : Set _) ↔ _
    exact Set.preimage_subset_preimage_iff
      (by rw [(reesToGraded_surjective I).range_eq]; exact Set.subset_univ _)
  · rintro ⟨W, hW, rfl⟩
    exact hW.preimage (grToBlowupCont I).continuous

/-- The map `Proj(Gr_I(A)) → Proj(⨁ Iⁿ)` on points of the schemes, pulling a homogeneous prime
back along the graded surjection `π`. It identifies `Proj(Gr_I(A))` with the part of the blowup
lying over `V(I)`. -/
def grToBlowup : projGr I → AlgebraicGeometry.Proj (Stacks.Blowup.reesGrading I) :=
  fun x => grToBlowupCont I x

/-- `f ∈ grToBlowup I x` iff `π f ∈ x`. -/
theorem mem_grToBlowup_iff (x : projGr I) (f : reesAlgebra I) :
    f ∈ (grToBlowup I x).asHomogeneousIdeal ↔ reesToGraded I f ∈ x.asHomogeneousIdeal :=
  Iff.rfl

/-- `grToBlowup` is injective. -/
theorem grToBlowup_injective : Function.Injective (grToBlowup I) :=
  fun _ _ h => grToBlowupCont_injective I h

/-- `grToBlowup` is inducing. -/
theorem isInducing_grToBlowup : IsInducing (grToBlowup I) :=
  isInducing_grToBlowupCont I

/-- `grToBlowup` is compatible with the structure maps: the blowup sends the image of `x` to the
image in `Spec A` of the point of `Spec(Gr_I(A)₀)` under `x`. -/
theorem toSpec_grToBlowup (x : projGr I) :
    Stacks.Blowup.toSpec I (grToBlowup I x) = gradeZeroToSpec I (toSpecGradeZero I x) := by
  refine PrimeSpectrum.ext (Ideal.ext fun a => ?_)
  rw [mem_toSpec_iff, mem_grToBlowup_iff, reesToGraded_algebraMap, mem_gradeZeroToSpec_iff,
    mem_toSpecGradeZero_iff]

/-- The inverse of `grToBlowup` over `V(I)`, on homogeneous primes: a homogeneous prime of
`⨁ Iⁿ` containing `I` in degree `0` contains the kernel of `π`, so its image under `π` is a
homogeneous prime of `Gr_I(A)`. -/
def blowupToGrPt (w : ProjectiveSpectrum (Stacks.Blowup.reesGrading I))
    (hw : ∀ a ∈ I, algebraMap A (reesAlgebra I) a ∈ w.asHomogeneousIdeal) :
    ProjectiveSpectrum (grading I) where
  asHomogeneousIdeal := w.asHomogeneousIdeal.map (reesToGraded I)
  isPrime := by
    have := w.isPrime
    exact Ideal.map_isPrime_of_surjective (reesToGraded_surjective I)
      (ker_reesToGraded_le I _ hw)
  not_irrelevant_le h := w.not_irrelevant_le fun f hf =>
    mem_of_reesToGraded_mem_map I hw (h (irrelevant_le_comap_reesToGraded I hf))

/-- The inverse of `grToBlowup` over `V(I)`, on points of the schemes. -/
def blowupToGr (w : AlgebraicGeometry.Proj (Stacks.Blowup.reesGrading I))
    (hw : ∀ a ∈ I, algebraMap A (reesAlgebra I) a ∈ w.asHomogeneousIdeal) : projGr I :=
  blowupToGrPt I w hw

/-- Membership in `blowupToGr I w hw` is membership in the image of `w` under `π`. -/
theorem mem_blowupToGr_iff (w : AlgebraicGeometry.Proj (Stacks.Blowup.reesGrading I))
    (hw : ∀ a ∈ I, algebraMap A (reesAlgebra I) a ∈ w.asHomogeneousIdeal) (z : gradedRing I) :
    z ∈ (blowupToGr I w hw).asHomogeneousIdeal ↔
      z ∈ w.asHomogeneousIdeal.toIdeal.map (reesToGraded I) :=
  Iff.rfl

/-- `blowupToGr` is a right inverse of `grToBlowup`. -/
theorem grToBlowup_blowupToGr (w : AlgebraicGeometry.Proj (Stacks.Blowup.reesGrading I))
    (hw : ∀ a ∈ I, algebraMap A (reesAlgebra I) a ∈ w.asHomogeneousIdeal) :
    grToBlowup I (blowupToGr I w hw) = w :=
  ProjectiveSpectrum.ext (HomogeneousIdeal.ext (Ideal.ext fun _ =>
    ⟨fun hf => mem_of_reesToGraded_mem_map I hw hf, fun hf => Ideal.mem_map_of_mem _ hf⟩))

/-- A point of the blowup lying over `V(I)` contains `I` in degree `0`. -/
theorem algebraMap_mem_of_toSpec_eq (w : AlgebraicGeometry.Proj (Stacks.Blowup.reesGrading I))
    (y : Spec (.of (grading I 0))) (hwy : Stacks.Blowup.toSpec I w = gradeZeroToSpec I y) :
    ∀ a ∈ I, algebraMap A (reesAlgebra I) a ∈ w.asHomogeneousIdeal := by
  intro a ha
  rw [← mem_toSpec_iff, hwy, mem_gradeZeroToSpec_iff, (gradeZeroHom_eq_zero_iff I a).2 ha]
  exact zero_mem _

/-- `blowupToGr` sends the fibre of the blowup over the image of `y` into the fibre of
`Proj(Gr_I(A)) → Spec(Gr_I(A)₀)` over `y`. -/
theorem toSpecGradeZero_blowupToGr (w : AlgebraicGeometry.Proj (Stacks.Blowup.reesGrading I))
    (hw : ∀ a ∈ I, algebraMap A (reesAlgebra I) a ∈ w.asHomogeneousIdeal)
    (y : Spec (.of (grading I 0))) (hwy : Stacks.Blowup.toSpec I w = gradeZeroToSpec I y) :
    toSpecGradeZero I (blowupToGr I w hw) = y := by
  refine PrimeSpectrum.ext (Ideal.ext fun c => ?_)
  obtain ⟨a, rfl⟩ := gradeZeroHom_surjective I c
  rw [mem_toSpecGradeZero_iff, mem_blowupToGr_iff, ← reesToGraded_algebraMap,
    ← mem_gradeZeroToSpec_iff, ← hwy, mem_toSpec_iff]
  exact ⟨mem_of_reesToGraded_mem_map I hw, Ideal.mem_map_of_mem _⟩

/-- `grToBlowup` restricted to the fibre of `Proj(Gr_I(A)) → Spec(Gr_I(A)₀)` over `y`, landing in
the fibre of the blowup over the image of `y` in `Spec A`. -/
def fiberGrToBlowup (y : Spec (.of (grading I 0))) :
    (toSpecGradeZero I) ⁻¹' {y} → (Stacks.Blowup.toSpec I) ⁻¹' {gradeZeroToSpec I y} :=
  fun z => ⟨grToBlowup I z.1,
    (toSpec_grToBlowup I z.1).trans (congrArg _ (Set.mem_singleton_iff.1 z.2))⟩

/-- `fiberGrToBlowup` is a homeomorphism: it is an injective inducing map, and surjective by
`blowupToGr`. -/
theorem isHomeomorph_fiberGrToBlowup (y : Spec (.of (grading I 0))) :
    IsHomeomorph (fiberGrToBlowup I y) := by
  rw [isHomeomorph_iff_isEmbedding_surjective]
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · have hc : Subtype.val ∘ fiberGrToBlowup I y = grToBlowup I ∘ Subtype.val := rfl
    have h : IsInducing (grToBlowup I ∘ (Subtype.val : (toSpecGradeZero I) ⁻¹' {y} → projGr I)) :=
      (isInducing_grToBlowup I).comp IsInducing.subtypeVal
    rw [← hc] at h
    exact (IsInducing.subtypeVal.of_comp_iff).1 h
  · intro z z' h
    exact Subtype.ext (grToBlowup_injective I (congrArg Subtype.val h))
  · rintro ⟨w, hw⟩
    have hwy := Set.mem_singleton_iff.1 hw
    have hI := algebraMap_mem_of_toSpec_eq I w y hwy
    exact ⟨⟨blowupToGr I w hI, toSpecGradeZero_blowupToGr I w hI y hwy⟩,
      Subtype.ext (grToBlowup_blowupToGr I w hI)⟩

/-- The dimension of a scheme-theoretic fibre is that of the preimage of the point. -/
private theorem topologicalKrullDim_fiber_eq {X Y : Scheme} (f : X ⟶ Y) (y : Y) :
    topologicalKrullDim (f.fiber y) = topologicalKrullDim (f ⁻¹' {y}) :=
  IsHomeomorph.topologicalKrullDim_eq _ (f.fiberHomeo y).isHomeomorph

/-- **The fibres over `V(I)`**: the fibre of the blowup over the image in `Spec A` of a point
`y ∈ Spec(A/I)` has the same dimension as the fibre of `Proj(Gr_I(A)) → Spec(Gr_I(A)₀)` over
`y`; the two are homeomorphic. -/
theorem topologicalKrullDim_fiber_toSpec_eq (y : Spec (.of (grading I 0))) :
    topologicalKrullDim ((Stacks.Blowup.toSpec I).fiber (gradeZeroToSpec I y)) =
      topologicalKrullDim ((toSpecGradeZero I).fiber y) := by
  rw [topologicalKrullDim_fiber_eq, topologicalKrullDim_fiber_eq]
  exact (IsHomeomorph.topologicalKrullDim_eq _ (isHomeomorph_fiberGrToBlowup I y)).symm

/-! ### The fibres off `V(I)` -/

/-- The identity `bⁿ · x tⁿ = x · (b t)ⁿ` in the Rees algebra, for `b ∈ I` and a homogeneous
element `x tⁿ`. -/
theorem algebraMap_pow_mul_eq {b : A} (hb : b ∈ I) {n : ℕ} {h : reesAlgebra I}
    (hh : h ∈ Stacks.Blowup.reesGrading I n) :
    algebraMap A (reesAlgebra I) (b ^ n) * h =
      algebraMap A (reesAlgebra I) ((h : A[X]).coeff n) *
        ⟨monomial 1 b, reesAlgebra.monomial_mem.2 (by simpa using hb)⟩ ^ n := by
  apply Subtype.ext
  rw [Subalgebra.coe_mul, Subalgebra.coe_mul, SubmonoidClass.coe_pow]
  conv_lhs => rw [Stacks.Blowup.coe_eq_monomial I hh]
  simp only [Subalgebra.coe_algebraMap, Polynomial.algebraMap_apply, Algebra.algebraMap_self,
    RingHom.id_apply, C_mul_monomial, monomial_pow, one_mul]
  rw [mul_comm]

/-- **Over a point `s ∉ V(I)` the blowup has at most one point.** If `b ∈ I \ s` then a
homogeneous prime `𝔭` over `s` does not contain `b t`, and `x tⁿ ∈ 𝔭` iff `x ∈ s`, because
`bⁿ · x tⁿ = x · (b t)ⁿ`. -/
theorem eq_of_toSpec_eq_of_not_le {s : Spec (CommRingCat.of A)}
    (hs : ¬ I ≤ PrimeSpectrum.asIdeal s)
    {w w' : AlgebraicGeometry.Proj (Stacks.Blowup.reesGrading I)}
    (hw : Stacks.Blowup.toSpec I w = s) (hw' : Stacks.Blowup.toSpec I w' = s) : w = w' := by
  obtain ⟨b, hbI, hbs⟩ := Set.not_subset.1 hs
  suffices key : ∀ w : AlgebraicGeometry.Proj (Stacks.Blowup.reesGrading I),
      Stacks.Blowup.toSpec I w = s → ∀ n, ∀ h ∈ Stacks.Blowup.reesGrading I n,
        h ∈ w.asHomogeneousIdeal ↔ (h : A[X]).coeff n ∈ s.asIdeal by
    exact ProjectiveSpectrum.ext (𝒜 := Stacks.Blowup.reesGrading I)
      (HomogeneousIdeal.ext' fun n h hh => by rw [key w hw n h hh, key w' hw' n h hh])
  intro w hw n h hh
  have hP := w.isPrime
  have hmem : ∀ a, algebraMap A (reesAlgebra I) a ∈ w.asHomogeneousIdeal.toIdeal ↔
      a ∈ s.asIdeal := fun a => by
    rw [← hw]
    exact (mem_toSpec_iff I w a).symm
  have hbn : ∀ m, algebraMap A (reesAlgebra I) (b ^ m) ∉ w.asHomogeneousIdeal.toIdeal :=
    fun m hm => hbs (s.isPrime.mem_of_pow_mem m ((hmem _).1 hm))
  set bt : reesAlgebra I := ⟨monomial 1 b, reesAlgebra.monomial_mem.2 (by simpa using hbI)⟩
  have hbt : bt ∉ w.asHomogeneousIdeal.toIdeal := by
    intro hbt
    apply w.not_irrelevant_le
    rw [HomogeneousIdeal.irrelevant_le]
    intro i hi g hg
    have : algebraMap A (reesAlgebra I) (b ^ i) * g ∈ w.asHomogeneousIdeal.toIdeal := by
      rw [algebraMap_pow_mul_eq I hbI hg]
      exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _ hbt i hi)
    exact (hP.mem_or_mem this).resolve_left (hbn i)
  have he := algebraMap_pow_mul_eq I hbI hh
  refine ⟨fun hhw => ?_, fun hc => ?_⟩
  · have : algebraMap A (reesAlgebra I) ((h : A[X]).coeff n) * bt ^ n ∈
        w.asHomogeneousIdeal.toIdeal := by
      rw [← he]
      exact Ideal.mul_mem_left _ _ hhw
    exact (hmem _).1 ((hP.mem_or_mem this).resolve_right fun h1 => hbt (hP.mem_of_pow_mem n h1))
  · have : algebraMap A (reesAlgebra I) (b ^ n) * h ∈ w.asHomogeneousIdeal.toIdeal := by
      rw [he]
      exact Ideal.mul_mem_right _ _ ((hmem _).2 hc)
    exact (hP.mem_or_mem this).resolve_left (hbn n)

/-- The fibre of the blowup over a point `s ∉ V(I)` has at most one point. -/
theorem subsingleton_fiber_toSpec {s : Spec (CommRingCat.of A)}
    (hs : ¬ I ≤ PrimeSpectrum.asIdeal s) : Subsingleton ((Stacks.Blowup.toSpec I) ⁻¹' {s}) :=
  ⟨fun z z' => Subtype.ext (eq_of_toSpec_eq_of_not_le I hs (Set.mem_singleton_iff.1 z.2)
    (Set.mem_singleton_iff.1 z'.2))⟩

/-! ### The two descriptions of `d(S)` -/

/-- A bound `w ≤ n` in `WithBot ℕ∞` gives `w.unbotD 0 ≤ n` in `ℕ∞`. -/
theorem unbotD_le_of_le {w : WithBot ℕ∞} {n : ℕ} (h : w ≤ n) : w.unbotD 0 ≤ (n : ℕ∞) := by
  induction w using WithBot.recBotCoe with
  | bot => simp
  | coe e =>
    rw [← WithBot.coe_natCast] at h
    simpa using WithBot.coe_le_coe.1 h

/-- Every `w : WithBot ℕ∞` is at most `w.unbotD 0`. -/
theorem le_coe_unbotD (w : WithBot ℕ∞) : w ≤ ((w.unbotD 0 : ℕ∞) : WithBot ℕ∞) := by
  induction w using WithBot.recBotCoe with
  | bot => exact bot_le
  | coe e => simp

/-- **The two descriptions of `d(S)` in [Stacks, Tag 0GA6] agree**: for `A` Noetherian, the
maximal dimension of the fibres of `Proj(Gr_I(A)) → Spec(Gr_I(A)₀)` (a fibre with no points
counting as `0`) is the maximal dimension of the fibres of the blowup `p : X → Spec(A)` of
`Spec(A)` in `I`. This is the source's claim (2) in the paragraph introducing `d`: `d` is also
the maximal dimension of the fibres of `Proj(S) → Spec(S₀)` if `Y ≠ ∅`, and `d = 0` if `Y = ∅`. -/
theorem dInvariant_eq_fibreDim [IsNoetherianRing A] :
    AssociatedGraded.dInvariant I = (fibreDim I : ℕ∞) := by
  apply le_antisymm
  · refine iSup_le fun y => unbotD_le_of_le ?_
    rw [← topologicalKrullDim_fiber_toSpec_eq]
    exact topologicalKrullDim_fiber_le_fibreDim I _
  · cases hD : dInvariant I using ENat.recTopCoe with
    | top => exact le_top
    | coe D =>
      rw [Nat.cast_le]
      refine fibreDim_le I fun s => ?_
      by_cases hs : I ≤ PrimeSpectrum.asIdeal s
      · obtain ⟨y, rfl⟩ : ∃ y : Spec (.of (grading I 0)), gradeZeroToSpec I y = s := by
          have : (s : PrimeSpectrum A) ∈ Set.range (PrimeSpectrum.comap (gradeZeroHom I)) := by
            rw [range_comap_of_surjective _ (gradeZeroHom I) (gradeZeroHom_surjective I),
              ker_gradeZeroHom]
            exact hs
          exact this
        rw [topologicalKrullDim_fiber_toSpec_eq]
        refine (le_coe_unbotD _).trans ?_
        rw [← WithBot.coe_natCast, WithBot.coe_le_coe, ← hD]
        exact le_iSup (fun y => (topologicalKrullDim ((toSpecGradeZero I).fiber y)).unbotD 0) y
      · rw [topologicalKrullDim_fiber_eq]
        have := subsingleton_fiber_toSpec I hs
        refine (topologicalKrullDim_zero_of_discreteTopology _).trans ?_
        exact_mod_cast Nat.zero_le D

end Stacks.LocalCohomology.UniformityIII

