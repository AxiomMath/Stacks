-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits MonoidalCategory Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.RegularSequence (globalSmulCenter)
open Stacks.SheafOfModules.OnSpace (tensorObjTmul whiskerRight_tmul leftUnitor_tmul)

universe u

namespace Stacks.LocalCohomology.UniformityIII

attribute [local instance] modulesMonoidal modulesMonoidal'

section Generic

variable {C : Type*} [Category C] [Abelian C]

/-- **Exactness of a short complex depends only on its two maps.** The proof that they compose
to zero is a `Prop` field, so two short complexes with the same maps are the same object; the
lemma exists only to let that proof be supplied by whichever route is convenient. -/
theorem exact_mk_of_eq {X Y Z : C} {f f' : X ⟶ Y} {g g' : Y ⟶ Z} (hf : f = f') (hg : g = g')
    {h : f ≫ g = 0} {h' : f' ≫ g' = 0} (hex : (ShortComplex.mk f g h).Exact) :
    (ShortComplex.mk f' g' h').Exact := by
  subst hf; subst hg; exact hex

end Generic

variable {A : Type u} [CommRing A] (I : Ideal A)

/-! ### The twisted ideal sequence is the kernel sequence -/

/-- The whiskered ideal sequence of the exceptional divisor is a complex. -/
theorem whiskerRight_thickeningIdealι_comp_eq_zero (n q : ℕ) :
    (thickeningIdealι I n ▷ blowupTwist I q) ≫ (thickeningProj I n ▷ blowupTwist I q) =
      (0 : (thickeningIdealSheaf I n ⊗ blowupTwist I q : (blowupScheme I).Modules) ⟶
        thickeningTwist I n q) :=
  (MonoidalCategory.comp_whiskerRight _ _ _).symm.trans
    ((congrArg (fun φ : thickeningIdealSheaf I n ⟶ thickeningSheaf I n =>
          φ ▷ blowupTwist I q)
        (kernel.condition (thickeningProj I n))).trans
      (zero_whiskerRight_eq_zero I (blowupTwist I q)))

/-- **The ideal sequence of the exceptional divisor stays exact after whiskering by a twist.**
This is [Stacks, Tag 01CC], exactness at the middle term, applied to the short exact sequence
`0 → ℐ_{Yₙ} → 𝒪_X → 𝒪_{Yₙ} → 0` of `CategoryTheory.ShortComplex.shortExact_mk_kernel_ι`. -/
theorem exact_whiskerRight_thickeningIdealι (n q : ℕ) :
    (ShortComplex.mk (thickeningIdealι I n ▷ blowupTwist I q)
      (thickeningProj I n ▷ blowupTwist I q)
      (whiskerRight_thickeningIdealι_comp_eq_zero I n q)).Exact := by
  obtain ⟨h0, hex⟩ := @AlgebraicGeometry.SheafOfModules.tensorSheafMap_exact
    (blowupScheme I).toRingedSpace
    (ShortComplex.mk (thickeningIdealι I n) (thickeningProj I n)
      (kernel.condition (thickeningProj I n))) (blowupTwist I q)
    (ShortComplex.shortExact_mk_kernel_ι (thickeningProj I n)).exact
    (epi_thickeningProj I n)
  exact exact_mk_of_eq (whiskerRight_eq_tensorSheafMap I _ _).symm
    (whiskerRight_eq_tensorSheafMap I _ _).symm hex

/-- **`ℐ_{Yₙ} ⊗ 𝒪_X(q)` is the kernel of the whiskered restriction.** The first map is a
monomorphism because the twist is flat, the sequence is exact, and an abelian category is
balanced. -/
theorem isIso_kernelLift_whiskerRight_thickeningIdealι (n q : ℕ) :
    IsIso (kernel.lift (thickeningProj I n ▷ blowupTwist I q)
      (thickeningIdealι I n ▷ blowupTwist I q)
      (whiskerRight_thickeningIdealι_comp_eq_zero I n q)) :=
  @Stacks.Cohomology.CechSpectral.isIso_kernelLift_of_mono_of_exact _ _ _ _ _ _ _ _ _
    (mono_whiskerRight_blowupTwist I (thickeningIdealι I n)
      (ShortComplex.shortExact_mk_kernel_ι (thickeningProj I n)).mono_f q)
    (exact_whiskerRight_thickeningIdealι I n q)

/-- **`ℐ_{Yₙ} ⊗ 𝒪_X(q)` is the kernel of `𝒪_X(q) ⟶ 𝒪_{Yₙ}(q)`.** The whiskered sequence read
through the left unitor; the transport is
`Stacks.Cohomology.CechSpectral.isIso_kernelLift_of_iso` rather than an isomorphism of short
complexes, for the reason the implementation notes give. -/
theorem isIso_kernelLift_twistedThickeningIdealMap (n q : ℕ) :
    IsIso (kernel.lift (thickeningTwistProj I n q) (twistedThickeningIdealMap I n q)
      (twistedThickeningIdealMap_comp_thickeningTwistProj_eq_zero I n q)) :=
  Stacks.Cohomology.CechSpectral.isIso_kernelLift_of_iso
    (whiskerRight_thickeningIdealι_comp_eq_zero I n q)
    (twistedThickeningIdealMap_comp_thickeningTwistProj_eq_zero I n q)
    (Iso.refl _) (λ_ (blowupTwist I q)) (Iso.refl _)
    (Category.id_comp (twistedThickeningIdealMap I n q)).symm
    ((Category.comp_id _).trans (Iso.hom_inv_id_assoc _ _).symm)
    (isIso_kernelLift_whiskerRight_thickeningIdealι I n q)

/-- **`ℐ_Y ⊗ 𝒪_X(q)` is invertible**, as a tensor product of invertible sheaves ([Stacks,
Tag 01CT] part (1)). -/
theorem isInvertible_thickeningIdealSheaf_tensor_blowupTwist (q : ℕ) :
    Stacks.SheafOfModules.IsInvertible (blowupScheme I).toRingedSpace.presheaf
      (structureSheafRing (blowupScheme I).toRingedSpace).property
      (thickeningIdealSheaf I 1 ⊗ blowupTwist I q : (blowupScheme I).Modules) := by
  let : Stacks.SheafOfModules.IsInvertible (blowupScheme I).toRingedSpace.presheaf
      (structureSheafRing (blowupScheme I).toRingedSpace).property (thickeningIdealSheaf I 1) :=
    isInvertible_kernel_thickeningProj_one I
  let : Stacks.SheafOfModules.IsInvertible (blowupScheme I).toRingedSpace.presheaf
      (structureSheafRing (blowupScheme I).toRingedSpace).property (blowupTwist I q) :=
    Stacks.Blowup.isInvertible_blowUpTwist I (q : ℤ)
  change Stacks.SheafOfModules.IsInvertible _ _
    ((((Stacks.SheafOfModules.Tensor.sheafTensor
      ⟨(((blowupScheme I).toRingedSpace)).presheaf,
        (((blowupScheme I).toRingedSpace)).IsSheaf⟩).obj
      ((thickeningIdealSheaf I 1))).obj ((blowupTwist I q))))
  exact Stacks.SheafOfModules.isInvertible_tensorSheaf _ _ _ _

/-! ### The image of the twist on sections -/

/-- **The first map of the ambient sequence on sections over an open**, as an additive map
between the section groups at the spelling `Γ(M, V)`.

The spelling is the point: `AlgebraicGeometry.Scheme.Modules.presheaf` is where Mathlib puts the
`Module Γ(X, V) Γ(M, V)` instance, and `M.val.obj (op V)` — the spelling a morphism of sheaves
of modules has on sections — is a different term carrying no such instance that search can find.
Summing scalar multiples therefore has to happen at this spelling. -/
def ambientTwistMapSections (q : ℕ) (V : (blowupScheme I).Opens) :
    Γ(blowupTwist I (q + 1), V) →+ Γ(blowupTwist I q, V) :=
  ((ambientTwistMap I q).val.app (op V)).hom.toAddMonoidHom

/-- The action of `Stacks.RegularSequence.globalSmulCenter` on a twist is multiplication by the
restricted global function. -/
theorem app_globalSmulCenter_blowupTwist (q : ℕ) (V : (blowupScheme I).Opens)
    (r : Γ(blowupScheme I, ⊤)) (c : Γ(blowupTwist I q, V)) :
    ((globalSmulCenter (blowupScheme I) r).app (blowupTwist I q)).val.app (op V) c =
      (blowupScheme I).presheaf.map V.leTop.op r • c := rfl

/-- **A section of `𝒪_X(q)` scaled by an element of the pullback of `I` is in the image of
`𝒪_X(q+1) ⟶ 𝒪_X(q)`.** The generators are
`Stacks.LocalCohomology.UniformityIII.exists_app_ambientTwistMap_eq_globalSmul`, and the image on
sections is closed under finite sums. -/
theorem exists_app_ambientTwistMap_eq_smul_of_mem_map (q : ℕ) (V : (blowupScheme I).Opens)
    (r : Γ(blowupScheme I, V)) (hr : r ∈ Ideal.map (pullbackCoeffLE I V).hom I)
    (c : Γ(blowupTwist I q, V)) :
    ∃ s : (blowupTwist I (q + 1)).val.obj (op V),
      (ambientTwistMap I q).val.app (op V) s = r • c := by
  classical
  rw [Ideal.map, Submodule.mem_span_set'] at hr
  obtain ⟨n, f, g, hfg⟩ := hr
  obtain ⟨s, hs⟩ := exists_eq_sum_of_forall_mem_range (ambientTwistMapSections I q V)
    (Finset.univ : Finset (Fin n))
    (fun i => (f i • (g i : Γ(blowupScheme I, V))) • c)
    (fun i _ => by
      obtain ⟨b, hbI, hb⟩ := (g i).2
      obtain ⟨s, hs⟩ := exists_app_ambientTwistMap_eq_globalSmul I q hbI V (f i • c)
      refine ⟨s, hs.trans ?_⟩
      rw [app_globalSmulCenter_blowupTwist, map_leTop_pullbackCoeff, ← hb, smul_eq_mul,
        ← mul_smul, mul_comm])
  refine ⟨s, hs.trans ?_⟩
  rw [← hfg]
  exact Finset.sum_smul.symm

/-! ### The twisted ideal map on a pure tensor -/

/-- **The first map of the twisted ideal sequence on a local pure tensor**: `a ⊗ c ↦ a·c`. -/
theorem app_twistedThickeningIdealMap_tmul (n q : ℕ) (V : (blowupScheme I).Opens)
    (a : (thickeningIdealSheaf I n).val.obj (op V)) (c : Γ(blowupTwist I q, V)) :
    (twistedThickeningIdealMap I n q).val.app (op V)
        (tensorObjTmul (blowupScheme I).toRingedSpace (thickeningIdealSheaf I n)
          (blowupTwist I q) (op V) a c) =
      sectionOfUnit I V ((thickeningIdealι I n).val.app (op V) a) • c := by
  change ((λ_ (blowupTwist I q)).hom).val.app (op V)
      (((thickeningIdealι I n ▷ blowupTwist I q)).val.app (op V) _) = _
  refine Eq.trans (congrArg (fun z => ((λ_ (blowupTwist I q)).hom).val.app (op V) z)
    (whiskerRight_tmul (blowupScheme I).toRingedSpace (thickeningIdealι I n)
      (blowupTwist I q) (op V) a c)) ?_
  exact leftUnitor_tmul (blowupScheme I).toRingedSpace (blowupTwist I q) (op V)
    (sectionOfUnit I V ((thickeningIdealι I n).val.app (op V) a)) c

/-- Equal morphisms of sheaves of modules on the blowup agree on sections over an open. -/
private theorem app_eq_of_eq {M N : (blowupScheme I).Modules} {f g : M ⟶ N} (h : f = g)
    (U : (blowupScheme I).Opens) (x : M.val.obj (op U)) : f.val.app (op U) x = g.val.app (op U) x :=
  by rw [h]

/-- **A section of the ideal sheaf of the exceptional divisor over an affine open lies in
`Ideal.map ψ_V I`.** This is
`Stacks.LocalCohomology.UniformityIII.mem_map_pullbackCoeffLE_of_app_thickeningProj_one_eq_zero`
read on a section of the kernel, which the kernel inclusion kills by `kernel.condition`. -/
theorem mem_map_pullbackCoeffLE_sectionOfUnit_thickeningIdealι
    (V : (blowupScheme I).affineOpens) (a : (thickeningIdealSheaf I 1).val.obj (op V.1)) :
    sectionOfUnit I V.1 ((thickeningIdealι I 1).val.app (op V.1) a) ∈
      Ideal.map (pullbackCoeffLE I V.1).hom I :=
  mem_map_pullbackCoeffLE_of_app_thickeningProj_one_eq_zero I V _
    (app_eq_of_eq I (kernel.condition (thickeningProj I 1)) V.1 a)

/-! ### Surjectivity of the canonical lift, for every twist -/

/-- **Every section of the kernel of `𝒪_X(q) ⟶ 𝒪_Y(q)` is locally in the image of
`𝒪_X(q+1) ⟶ 𝒪_X(q)`.**

The section is, near any point, the image of a section `z` of `ℐ_Y ⊗ 𝒪_X(q)`
(`isIso_kernelLift_twistedThickeningIdealMap`), that `z` is on a smaller open a finite sum of
pure tensors `a ⊗ c` (`exists_sieve_sum_toTensorSheafSection`), and the open may be shrunk to an
affine one because the covering sieve is closed under restriction. On an affine open each `a`
lies in `Ideal.map ψ_V I`, so each `a·c` — and so the sum — is in the image. -/
theorem exists_restrict_eq_app_ambientTwistMap (q : ℕ) (U : (blowupScheme I).Opens)
    (t : (kernel (thickeningTwistProj I 1 q)).val.obj (op U))
    (x : blowupScheme I) (hxU : x ∈ U) :
    ∃ (V : (blowupScheme I).Opens) (hVU : V ≤ U), x ∈ V ∧
      ∃ s : (blowupTwist I (q + 1)).val.obj (op V),
        (ambientTwistMap I q).val.app (op V) s =
          (blowupTwist I q).val.map (homOfLE hVU).op
            ((kernel.ι (thickeningTwistProj I 1 q)).val.app (op U) t) := by
  classical
  set L := kernel.lift (thickeningTwistProj I 1 q) (twistedThickeningIdealMap I 1 q)
    (twistedThickeningIdealMap_comp_thickeningTwistProj_eq_zero I 1 q) with hL
  have : IsIso L := isIso_kernelLift_twistedThickeningIdealMap I 1 q
  set z := (inv L).val.app (op U) t with hzdef
  have hz : L.val.app (op U) z = t := app_eq_of_eq I (IsIso.inv_hom_id L) U t
  obtain ⟨S, hSmem, hS⟩ := Stacks.SheafOfModules.TensorUnit.exists_sieve_sum_toTensorSheafSection
    (X := (blowupScheme I).toRingedSpace) (F := thickeningIdealSheaf I 1) (blowupTwist I q) U z
  obtain ⟨W, k, hSk, hxW⟩ := (Opens.mem_grothendieckTopology _).mp hSmem x hxU
  obtain ⟨V, hVaff, hxV, hVW⟩ :=
    TopologicalSpace.Opens.isBasis_iff_nbhd.mp (blowupScheme I).isBasis_affineOpens hxW
  have hVU : V ≤ U := hVW.trans (leOfHom k)
  obtain ⟨m, a, b, hab⟩ := hS (homOfLE hVW ≫ k) (S.downward_closed hSk _)
  rw [show (homOfLE hVW ≫ k) = homOfLE hVU from by rw [← homOfLE_leOfHom k, homOfLE_comp]]
    at hab
  -- the kernel section is the image of `z`
  have hU' : (kernel.ι (thickeningTwistProj I 1 q)).val.app (op U) t =
      (twistedThickeningIdealMap I 1 q).val.app (op U) z := by
    rw [← hz]
    exact app_eq_of_eq I (kernel.lift_ι _ _ _) U z
  -- restrict to `V` and expand the pure tensors
  have hVsum : (blowupTwist I q).val.map (homOfLE hVU).op
      ((kernel.ι (thickeningTwistProj I 1 q)).val.app (op U) t) =
      ∑ j : Fin m, sectionOfUnit I V ((thickeningIdealι I 1).val.app (op V) (a j)) • b j := by
    have hab' : (thickeningIdealSheaf I 1 ⊗ blowupTwist I q :
          (blowupScheme I).Modules).val.map (homOfLE hVU).op z =
        ∑ j : Fin m, tensorObjTmul (blowupScheme I).toRingedSpace (thickeningIdealSheaf I 1)
          (blowupTwist I q) (op V) (a j) (b j) := hab
    rw [hU', ← PresheafOfModules.naturality_apply, hab', map_sum]
    exact Finset.sum_congr rfl fun j _ =>
      app_twistedThickeningIdealMap_tmul I 1 q V (a j) (b j)
  refine ⟨V, hVU, hxV, ?_⟩
  obtain ⟨s, hs⟩ := exists_eq_sum_of_forall_mem_range (ambientTwistMapSections I q V)
    (Finset.univ : Finset (Fin m))
    (fun j => sectionOfUnit I V ((thickeningIdealι I 1).val.app (op V) (a j)) • b j)
    (fun j _ => exists_app_ambientTwistMap_eq_smul_of_mem_map I q V _
      (mem_map_pullbackCoeffLE_sectionOfUnit_thickeningIdealι I ⟨V, hVaff⟩ (a j)) (b j))
  exact ⟨s, hs.trans hVsum.symm⟩

/-- **The canonical lift `𝒪_X(q+1) ⟶ ker(𝒪_X(q) ⟶ 𝒪_Y(q))` is an epimorphism**, for every
`q`. -/
theorem epi_kernelLift_ambientTwistMap (q : ℕ) :
    Epi (kernel.lift (thickeningTwistProj I 1 q) (ambientTwistMap I q)
      (ambientTwistMap_comp_thickeningTwistProj_eq_zero I q)) := by
  refine Stacks.SheafOfModules.StalkEpiMono.epi_of_exists_sections _ fun U t x hxU => ?_
  obtain ⟨V, hVU, hxV, s, hs⟩ := exists_restrict_eq_app_ambientTwistMap I q U t x hxU
  refine ⟨V, hVU, hxV, s, Stacks.SheafOfModules.injective_app_kernel_ι
    (thickeningTwistProj I 1 q) (op V) ?_⟩
  refine Eq.trans ?_ (PresheafOfModules.naturality_apply
    (kernel.ι (thickeningTwistProj I 1 q)).val (homOfLE hVU).op t).symm
  refine Eq.trans ?_ hs
  exact app_eq_of_eq I (kernel.lift_ι _ _ _) V s

/-- **The canonical lift `𝒪_X(q+1) ⟶ ker(𝒪_X(q) ⟶ 𝒪_Y(q))` is an isomorphism**, for every `q`.

The epimorphism is transported to one between the two *invertible* sheaves `𝒪_X(q+1)` and
`ℐ_Y ⊗ 𝒪_X(q)` along the isomorphism `isIso_kernelLift_twistedThickeningIdealMap`, where
`Stacks.SheafOfModules.isIso_of_epi_of_isInvertible` applies. -/
theorem isIso_kernelLift_ambientTwistMap (q : ℕ) :
    IsIso (kernel.lift (thickeningTwistProj I 1 q) (ambientTwistMap I q)
      (ambientTwistMap_comp_thickeningTwistProj_eq_zero I q)) := by
  set L := kernel.lift (thickeningTwistProj I 1 q) (twistedThickeningIdealMap I 1 q)
    (twistedThickeningIdealMap_comp_thickeningTwistProj_eq_zero I 1 q) with hL
  set K := kernel.lift (thickeningTwistProj I 1 q) (ambientTwistMap I q)
    (ambientTwistMap_comp_thickeningTwistProj_eq_zero I q) with hK
  have : IsIso L := isIso_kernelLift_twistedThickeningIdealMap I 1 q
  have hepi : Epi (K ≫ inv L) := by
    have := epi_kernelLift_ambientTwistMap I q
    infer_instance
  have : IsIso (K ≫ inv L) :=
    @Stacks.SheafOfModules.isIso_of_epi_of_isInvertible (blowupScheme I).toRingedSpace
      (blowupTwist I (q + 1))
      (thickeningIdealSheaf I 1 ⊗ blowupTwist I q : (blowupScheme I).Modules) _ hepi
      (Stacks.Blowup.isInvertible_blowUpTwist I ((q + 1 : ℕ) : ℤ))
      (isInvertible_thickeningIdealSheaf_tensor_blowupTwist I q)
  exact IsIso.of_isIso_comp_right _ (inv L)

/-- **The field `amb_shortExact` of `Stacks.LocalCohomology.UniformityIII.GeometricInput`**: the
second sequence of the proof of [Stacks, Tag 0GA7],
`0 → 𝒪_X(q+1) → 𝒪_X(q) → 𝒪_Y(q) → 0`, is short exact for every `q`. -/
theorem shortExact_ambientTwistMap (q : ℕ) :
    (ShortComplex.mk (ambientTwistMap I q) (thickeningTwistProj I 1 q)
      (ambientTwistMap_comp_thickeningTwistProj_eq_zero I q)).ShortExact :=
  shortExact_ambientTwistMap_of_isIso_kernelLift I q (isIso_kernelLift_ambientTwistMap I q)

end Stacks.LocalCohomology.UniformityIII

