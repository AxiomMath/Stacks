module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.RelationsKernel
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.StalkEpiMono
public import StacksFrontier.AlgebraicGeometry.DivisorFlatPullback.Basic
public import StacksFrontier.AlgebraicGeometry.LocalCohomology.BitUniformityIII.AmbientKernelLift

/-!
# [Stacks, Tag 02OS] part (3): `𝒪_X(1)` is the ideal sheaf of the exceptional divisor

Let `A` be a commutative ring, `I ⊆ A` an ideal and `X = Proj(⨁ₙ Iⁿ)` the blowup of `Spec(A)`
in `I`, with exceptional divisor `Y` cut out by the inverse image of `I`. This file proves that
the canonical map `𝒪_X(1) ⟶ 𝒪_X` is an isomorphism onto `ℐ_Y = ker(𝒪_X ⟶ 𝒪_Y)`, and reads off
the `q = 0` case of the exactness field `amb_shortExact` of
`Stacks.LocalCohomology.UniformityIII.GeometricInput`.

## Main results

* `Stacks.LocalCohomology.UniformityIII.ideal_thickeningIdeal_one_affineOpens`: on an affine open
  `V`, the ideal cutting out the exceptional divisor is `Ideal.map ψ_V I`, where
  `ψ_V : A ⟶ Γ(X, V)` is the pullback of coefficients.
* `Stacks.LocalCohomology.UniformityIII.exists_app_ambientTwistMapZero_eq_mul_unitSection`: every
  multiple `ψ_V b · c` with `b ∈ I` is in the image of `𝒪_X(1) ⟶ 𝒪_X` on sections over `V`.
* `Stacks.LocalCohomology.UniformityIII.isIso_kernelLift_ambientTwistMapZero`: **[Stacks,
  Tag 02OS] part (3)** — it is an isomorphism, i.e. `𝒪_X(1) = 𝒪_X(-Y)`.
* `Stacks.LocalCohomology.UniformityIII.shortExact_ambientTwistMap_zero`: the `q = 0` case of
  the field `amb_shortExact`, the short exactness of
  `0 → 𝒪_X(1) → 𝒪_X → 𝒪_Y → 0`.

## References

* [Stacks Project, Tag 02OS](https://stacks.math.columbia.edu/tag/02OS)
* [Stacks Project, Tag 0GA7](https://stacks.math.columbia.edu/tag/0GA7)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits MonoidalCategory Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.RegularSequence (globalSmulCenter)

universe u

namespace Stacks.LocalCohomology.UniformityIII

attribute [local instance] modulesMonoidal modulesMonoidal'

section Sum

/-- **The image of an additive map is closed under finite sums.** -/
theorem exists_eq_sum_of_forall_mem_range {M N : Type*} [AddCommGroup M] [AddCommGroup N]
    (φ : M →+ N) {ι : Type*} (s : Finset ι) (y : ι → N)
    (h : ∀ i ∈ s, ∃ x : M, φ x = y i) :
    ∃ x : M, φ x = ∑ i ∈ s, y i :=
  AddSubmonoid.sum_mem (AddMonoidHom.mrange φ) (t := s) (f := y) h

end Sum

variable {A : Type u} [CommRing A] (I : Ideal A)

/-- **The pullback of coefficients to an open of the blowup**, `A ⟶ Γ(X, V)`: the structure
morphism `X ⟶ Spec(A)` on sections, read through the identification of `A` with the global
functions of `Spec(A)`. On `V = ⊤` it is
`Stacks.LocalCohomology.UniformityIII.pullbackCoeff`. -/
abbrev pullbackCoeffLE (V : (blowupScheme I).Opens) : CommRingCat.of A ⟶ Γ(blowupScheme I, V) :=
  (Scheme.ΓSpecIso (CommRingCat.of A)).inv ≫ (Stacks.Blowup.toSpec I).appLE ⊤ V le_top

/-- The restriction to `V` of the global function `b ∈ A` pulls back to is the pullback of `b`
to `V`. -/
theorem map_leTop_pullbackCoeff (V : (blowupScheme I).Opens) (b : A) :
    (blowupScheme I).presheaf.map V.leTop.op (pullbackCoeff I b) =
      (pullbackCoeffLE I V).hom b := rfl

/-- **The ideal cutting out the exceptional divisor on an affine open**: it is the ideal
generated by the pullback of `I`. -/
theorem ideal_thickeningIdeal_one_affineOpens (V : (blowupScheme I).affineOpens) :
    (thickeningIdeal I 1).ideal V = Ideal.map (pullbackCoeffLE I V.1).hom I := by
  change ((Scheme.IdealSheafData.ofIdealTop
    (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom I)).comap
      (Stacks.Blowup.toSpec I) ^ 1).ideal V = _
  rw [pow_one, Stacks.IdealSheaf.ideal_comap_appLE _ (Stacks.Blowup.toSpec I)
    ⟨⊤, isAffineOpen_top _⟩ V le_top, Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_map,
    Ideal.map_map]
  rfl

/-- **A section of `𝒪_X` read as a section of the unit sheaf of modules**: the identity function
between the two carriers, which are the same type. -/
def unitSection (V : (blowupScheme I).Opens) (c : Γ(blowupScheme I, V)) :
    (SheafOfModules.unit (blowupScheme I).ringCatSheaf).val.obj (op V) := c

/-- A section of the unit sheaf of modules read as a section of `𝒪_X`, the inverse of
`unitSection`. -/
def sectionOfUnit (V : (blowupScheme I).Opens)
    (c : (SheafOfModules.unit (blowupScheme I).ringCatSheaf).val.obj (op V)) :
    Γ(blowupScheme I, V) := c

/-- `unitSection` undoes `sectionOfUnit`. -/
@[simp]
theorem unitSection_sectionOfUnit (V : (blowupScheme I).Opens)
    (c : (SheafOfModules.unit (blowupScheme I).ringCatSheaf).val.obj (op V)) :
    unitSection I V (sectionOfUnit I V c) = c := rfl

/-- `unitSection` is additive. -/
theorem unitSection_add (V : (blowupScheme I).Opens) (c d : Γ(blowupScheme I, V)) :
    unitSection I V (c + d) = unitSection I V c + unitSection I V d := rfl

/-- `unitSection` preserves zero. -/
theorem unitSection_zero (V : (blowupScheme I).Opens) :
    unitSection I V 0 = 0 := rfl

/-- `unitSection` preserves finite sums. -/
theorem unitSection_sum (V : (blowupScheme I).Opens) {ι : Type*} (s : Finset ι)
    (c : ι → Γ(blowupScheme I, V)) :
    unitSection I V (∑ i ∈ s, c i) = ∑ i ∈ s, unitSection I V (c i) := by
  classical
  induction s using Finset.induction with
  | empty => rw [Finset.sum_empty, Finset.sum_empty, unitSection_zero]
  | insert i t hi ih =>
      rw [Finset.sum_insert hi, Finset.sum_insert hi, unitSection_add, ih]

/-- **Restriction commutes with `unitSection`**: the unit sheaf of modules has the restriction
maps of `𝒪_X`. -/
theorem map_unitSection {U V : (blowupScheme I).Opens} (h : V ≤ U) (c : Γ(blowupScheme I, U)) :
    (SheafOfModules.unit (blowupScheme I).ringCatSheaf).val.map (homOfLE h).op
        (unitSection I U c) =
      unitSection I V ((blowupScheme I).presheaf.map (homOfLE h).op c) := rfl

/-- **The action of `globalSmulCenter` on the unit sheaf is multiplication.** -/
theorem app_globalSmulCenter_unitSection (V : (blowupScheme I).Opens)
    (r : Γ(blowupScheme I, ⊤)) (c : Γ(blowupScheme I, V)) :
    ((globalSmulCenter (blowupScheme I) r).app
        (SheafOfModules.unit (blowupScheme I).ringCatSheaf)).val.app (op V) (unitSection I V c) =
      unitSection I V ((blowupScheme I).presheaf.map V.leTop.op r * c) := rfl

/-! ### Every generator of the ideal is in the image of the twist -/

/-- **Every multiple of a pulled-back element of `I` is in the image of `𝒪_X(1) ⟶ 𝒪_X` on
sections over `V`**, with no shrinking of `V`. -/
theorem exists_app_ambientTwistMapZero_eq_mul_unitSection (V : (blowupScheme I).Opens) {b : A}
    (hb : b ∈ I) (c : Γ(blowupScheme I, V)) :
    ∃ s : (blowupTwist I 1).val.obj (op V),
      (ambientTwistMapZero I).val.app (op V) s =
        unitSection I V ((pullbackCoeffLE I V).hom b * c) := by
  obtain ⟨s, hs⟩ := exists_app_ambientTwistMap_eq_globalSmul I 0 hb V
    ((blowupTwistZeroIsoUnit I).inv.val.app (op V) (unitSection I V c))
  refine ⟨s, ?_⟩
  have hnat := congrArg
    (fun ψ : blowupTwist I 0 ⟶ SheafOfModules.unit (blowupScheme I).ringCatSheaf ↦
      ψ.val.app (op V) ((blowupTwistZeroIsoUnit I).inv.val.app (op V) (unitSection I V c)))
    (((globalSmulCenter (blowupScheme I) (pullbackCoeff I b)).naturality
      (blowupTwistZeroIsoUnit I).hom).symm)
  have hinv : (blowupTwistZeroIsoUnit I).hom.val.app (op V)
      ((blowupTwistZeroIsoUnit I).inv.val.app (op V) (unitSection I V c)) =
        unitSection I V c :=
    congrArg
      (fun ψ : SheafOfModules.unit (blowupScheme I).ringCatSheaf ⟶
          SheafOfModules.unit (blowupScheme I).ringCatSheaf ↦
        ψ.val.app (op V) (unitSection I V c))
      (blowupTwistZeroIsoUnit I).inv_hom_id
  have hsplit : ((blowupTwistZeroIsoUnit I).hom ≫
        (globalSmulCenter (blowupScheme I) (pullbackCoeff I b)).app
          (SheafOfModules.unit (blowupScheme I).ringCatSheaf)).val.app (op V)
        ((blowupTwistZeroIsoUnit I).inv.val.app (op V) (unitSection I V c)) =
      ((globalSmulCenter (blowupScheme I) (pullbackCoeff I b)).app
          (SheafOfModules.unit (blowupScheme I).ringCatSheaf)).val.app (op V)
        ((blowupTwistZeroIsoUnit I).hom.val.app (op V)
          ((blowupTwistZeroIsoUnit I).inv.val.app (op V) (unitSection I V c))) := rfl
  change (blowupTwistZeroIsoUnit I).hom.val.app (op V)
      ((ambientTwistMap I 0).val.app (op V) s) = _
  rw [hs]
  refine hnat.trans (hsplit.trans ?_)
  rw [hinv, app_globalSmulCenter_unitSection, map_leTop_pullbackCoeff]

/-- **Every element of `Ideal.map ψ_V I` is in the image of `𝒪_X(1) ⟶ 𝒪_X` on sections over
`V`.** -/
theorem exists_app_ambientTwistMapZero_eq_of_mem_map (V : (blowupScheme I).Opens)
    (c : Γ(blowupScheme I, V)) (hc : c ∈ Ideal.map (pullbackCoeffLE I V).hom I) :
    ∃ s : (blowupTwist I 1).val.obj (op V),
      (ambientTwistMapZero I).val.app (op V) s = unitSection I V c := by
  classical
  obtain ⟨n, f, g, hfg⟩ := Submodule.mem_span_set'.mp hc
  obtain ⟨s, hs⟩ := exists_eq_sum_of_forall_mem_range
    ((ambientTwistMapZero I).val.app (op V)).hom.toAddMonoidHom
    (Finset.univ : Finset (Fin n))
    (fun i ↦ unitSection I V (f i • (g i : Γ(blowupScheme I, V))))
    (fun i _ ↦ by
      obtain ⟨b, hbI, hb⟩ := (g i).2
      obtain ⟨s, hs⟩ := exists_app_ambientTwistMapZero_eq_mul_unitSection I V hbI (f i)
      exact ⟨s, hs.trans (by rw [← hb, smul_eq_mul, mul_comm])⟩)
  exact ⟨s, hs.trans (((unitSection_sum I V Finset.univ
    fun i ↦ f i • (g i : Γ(blowupScheme I, V))).symm).trans
      (congrArg (unitSection I V) hfg))⟩

/-! ### The kernel on an affine open -/

/-- **A section of `𝒪_X` over an affine open that dies on the exceptional divisor is in the
ideal generated by the pullback of `I`.** -/
theorem mem_map_pullbackCoeffLE_of_app_thickeningProj_one_eq_zero
    (V : (blowupScheme I).affineOpens) (c : Γ(blowupScheme I, V.1))
    (hc : (thickeningProj I 1).val.app (op V.1) (unitSection I V.1 c) = 0) :
    c ∈ Ideal.map (pullbackCoeffLE I V.1).hom I := by
  rwa [← ideal_thickeningIdeal_one_affineOpens I V, ← Scheme.IdealSheafData.ker_subschemeι_app]

/-! ### [Stacks, Tag 02OS] part (3) -/

/-- **[Stacks, Tag 02OS] part (3)**: the canonical map `𝒪_X(1) ⟶ 𝒪_X` is an isomorphism onto
the ideal sheaf of the exceptional divisor, `𝒪_X(1) = 𝒪_X(-Y)`. -/
theorem isIso_kernelLift_ambientTwistMapZero :
    IsIso (kernel.lift (thickeningProj I 1) (ambientTwistMapZero I)
      (ambientTwistMapZero_comp_thickeningProj_eq_zero I)) :=
  isIso_kernelLift_ambientTwistMapZero_of_epi I (epi_kernelLift_ambientTwistMapZero I)

/-- **The `q = 0` case of the exactness field `amb_shortExact`.** -/
theorem shortExact_ambientTwistMap_zero :
    (ShortComplex.mk (ambientTwistMap I 0) (thickeningTwistProj I 1 0)
      (ambientTwistMap_comp_thickeningTwistProj_eq_zero I 0)).ShortExact :=
  shortExact_ambientTwistMap_of_isIso_kernelLift I 0
    (isIso_kernelLift_ambientTwistMap_zero_of_epi I (epi_kernelLift_ambientTwistMapZero I))

end Stacks.LocalCohomology.UniformityIII

end
