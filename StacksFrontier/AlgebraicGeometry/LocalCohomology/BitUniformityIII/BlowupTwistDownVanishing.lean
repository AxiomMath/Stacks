      (blowupHGtr I i q (q - (c : ℤ)) hle
        (S := (blowupANCPres I n c M).resShortComplex)).hom x :=
  congrArg
    (fun z : blowupHmod I i
          (twistedPullbackImage I q (S := (blowupANCPres I n c M).resShortComplex)) ⟶
        blowupHmod I i
          (twistedPullbackImage I (q - (c : ℤ)) (S := (blowupANCPres I n c M).resShortComplex)) =>
      (ModuleCat.Hom.hom z) x)
    (blowupHmodMap_dottedOfPresentation_comp_toCycles I (blowupANCPres I n c M) i q
      (q - (c : ℤ)) (by ring) hle)

