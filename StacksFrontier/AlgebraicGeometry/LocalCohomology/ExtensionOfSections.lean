module

public import StacksFrontier.AlgebraicGeometry.LocalCohomology.AffineSchemeBridge
public import StacksFrontier.AlgebraicGeometry.AmpleWire.UnitStalk

/-!
# Extending a section away from `V(I)` over an affine chart

Let `X` be a scheme, let `I` be a quasi-coherent sheaf of ideals of finite type and let `F` be a
quasi-coherent `𝒪_X`-module. A section `s` of `F` over `X ∖ V(I)` has, on every affine chart `U`
on which the ideal is generated by a finite family `a`, a normal form: one exponent `k` and
sections `m i` of `F` over `U` with `m i = (a i) ^ k · s` on the basic open of `a i` and with the
cross relations `(a j) ^ k • m i = (a i) ^ k • m j`. This file turns that normal form into a
homomorphism out of a power of the ideal of the chart.

## Main results

* `Stacks.LocalCohomology.exists_finite_generating_family`: a finite-type ideal sheaf has a finite
  generating family on every affine chart.
* `Stacks.LocalCohomology.pow_smul_family_mono`: the normal form of a section can be renormalised
  to any larger exponent.
* `Stacks.LocalCohomology.exists_cross_related_family`: the normal form with an exponent at
  least `1`.
* `Stacks.LocalCohomology.exists_idealPow_hom_of_section_on_affine`: the normal form of a section
  over `X ∖ V(I)` on an affine chart defines a homomorphism from a power of the ideal of the
  chart to the quotient of `Γ(F, U)` by the sections annihilated by that power, matching the
  normal form on each generator. This is the affine case of Tag 01PM in scheme language.
* `Stacks.LocalCohomology.exists_idealPow_hom_of_section_on_affine_of_torsionFree`: if no nonzero
  section of `F` over the chart is annihilated by the ideal of the chart, the homomorphism lands
  in `Γ(F, U)` itself and is multiplication by `s` on the basic open of each generator. This is
  the affine case of the first clause of Tag 01PM in scheme language.
* `Stacks.LocalCohomology.exists_uniform_exponent`: on a finite family of charts the exponents of
  the normal forms can be taken to be one and the same.

## Implementation notes

The homomorphism out of a power of the ideal of the chart takes values in a quotient of `Γ(F, U)`:
a relation between the `(a i) ^ k` only forces the corresponding combination of the `m i` to be
annihilated by the ideal, not to vanish.

## References

* [Stacks Project, Tag 01PM](https://stacks.math.columbia.edu/tag/01PM)
* [Stacks Project, Tag 01PQ](https://stacks.math.columbia.edu/tag/01PQ)
* [Stacks Project, Tag 01YB](https://stacks.math.columbia.edu/tag/01YB)
-/


@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open Stacks.AlgebraicGeometry
open Stacks.AlgebraicGeometry.IdealPower
open Stacks.AlgebraicGeometry.IdealPowerSections
open Stacks.AlgebraicGeometry.QuasicoherentBaseChange

universe u

namespace Stacks.LocalCohomology

open Stacks.Ample (unitModule)

noncomputable section

variable {X : Scheme.{u}}

/-! ### Generating families on a chart -/

/-- A finite-type ideal sheaf has a finite generating family on every affine chart. -/
public lemma exists_finite_generating_family (I : X.IdealSheafData) (U : X.affineOpens)
    [((idealPowerMultiple I 1 (unitModule X)).toModules).IsFiniteType] :
    ∃ (ι : Type u) (_ : Finite ι) (a : ι → Γ(X, (U : X.Opens))),
      I.ideal U = Ideal.span (Set.range a) := by
  obtain ⟨t, ht⟩ := affineIdeal_fg I U
  refine ⟨↥(t : Set Γ(X, (U : X.Opens))), inferInstance, Subtype.val, ?_⟩
  rw [← ht, Subtype.range_coe]

/-! ### Renormalising the normal form of a section -/

/-- The normal form of a section over `X ∖ V(I)` on an affine chart can be renormalised to any
larger exponent, by multiplying the local extension at `i` by the missing power of `a i`. -/
public lemma pow_smul_family_mono (I : X.IdealSheafData) (F : X.Modules) (U : X.affineOpens)
    {ι : Type*} (a : ι → Γ(X, (U : X.Opens))) (ha : ∀ i, a i ∈ I.ideal U)
    (s : Γ(F, idealComplement I)) {k k' : ℕ} (hkk : k ≤ k')
    (m : ι → Γ(F, (U : X.Opens)))
    (hrep : ∀ i, F.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (m i) =
      (X.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (a i)) ^ k •
        F.presheaf.map (homOfLE (basicOpen_le_idealComplement I U (ha i))).op s)
    (hrel : ∀ i j, a j ^ k • m i = a i ^ k • m j) :
    (∀ i, F.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (a i ^ (k' - k) • m i) =
        (X.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (a i)) ^ k' •
          F.presheaf.map (homOfLE (basicOpen_le_idealComplement I U (ha i))).op s) ∧
      ∀ i j, a j ^ k' • (a i ^ (k' - k) • m i) = a i ^ k' • (a j ^ (k' - k) • m j) := by
  obtain ⟨d, rfl⟩ : ∃ d, k' = k + d := ⟨k' - k, by omega⟩
  simp only [Nat.add_sub_cancel_left]
  refine ⟨fun i => ?_, fun i j => ?_⟩
  · rw [F.map_smul, map_pow, hrep i, smul_smul, ← pow_add, Nat.add_comm d k]
  · calc a j ^ (k + d) • (a i ^ d • m i)
        = (a j ^ d * a i ^ d) • (a j ^ k • m i) := by
          rw [smul_smul, smul_smul]
          congr 1
          ring
      _ = (a j ^ d * a i ^ d) • (a i ^ k • m j) := by rw [hrel i j]
      _ = a i ^ (k + d) • (a j ^ d • m j) := by
          rw [smul_smul, smul_smul]
          congr 1
          ring

/-- The normal form of a section over `X ∖ V(I)` on an affine chart, with an exponent at least
`1`: one exponent `k ≥ 1`, sections `m i` of `F` over the chart equal to `(a i) ^ k · s` on the
basic open of `a i`, and the exact cross relations. -/
public lemma exists_cross_related_family (I : X.IdealSheafData) (F : X.Modules)
    [F.IsQuasicoherent] (U : X.affineOpens) {ι : Type*} [Finite ι]
    (a : ι → Γ(X, (U : X.Opens))) (ha : ∀ i, a i ∈ I.ideal U)
    (s : Γ(F, idealComplement I)) :
    ∃ (k : ℕ) (_ : 1 ≤ k) (m : ι → Γ(F, (U : X.Opens))),
      (∀ i, F.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (m i) =
          (X.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (a i)) ^ k •
            F.presheaf.map (homOfLE (basicOpen_le_idealComplement I U (ha i))).op s) ∧
        ∀ i j, a j ^ k • m i = a i ^ k • m j := by
  obtain ⟨k, m, hrep, hrel⟩ := exists_compatible_family I F U a ha s
  obtain ⟨hrep', hrel'⟩ :=
    pow_smul_family_mono I F U a ha s (le_max_left k 1) m hrep hrel
  exact ⟨max k 1, le_max_right k 1, fun i => a i ^ (max k 1 - k) • m i, hrep', hrel'⟩

/-! ### The homomorphism out of a power of the ideal of the chart -/

/-- Some power of the ideal of the chart lies in the span of the `k`-th powers of a finite
generating family, for `k ≥ 1`. -/
private theorem exists_idealPow_le_powerSpan (I : X.IdealSheafData) (U : X.affineOpens)
    {ι : Type*} [Finite ι] (a : ι → Γ(X, (U : X.Opens)))
    (hspan : I.ideal U = Ideal.span (Set.range a)) {k : ℕ} (hk : 1 ≤ k) :
    ∃ N : ℕ, (I.ideal U) ^ N ≤ powerSpan a k := by
  classical
  have hfin : Fintype ι := Fintype.ofFinite ι
  refine ⟨(Finset.image a Finset.univ).card * (k - 1) + 1, ?_⟩
  rw [hspan]
  exact idealPow_le_powerSpan a k hk (Finset.image a Finset.univ)
    (by rw [Finset.coe_image, Finset.coe_univ, Set.image_univ])

/-- **The affine case of Tag 01PM in scheme language.** On an affine chart `U` on which the ideal
is generated by a finite family `a`, a section `s` of a quasi-coherent `F` over `X ∖ V(I)` gives
an exponent `N`, a homomorphism `φ` from `I(U) ^ N` to the quotient of `Γ(F, U)` by the sections
annihilated by `I(U) ^ N`, and the normal form `(k, m)` of `s` on the chart, with
`(a i) ^ k • φ x = x · m i`. -/
public theorem exists_idealPow_hom_of_section_on_affine (I : X.IdealSheafData) (F : X.Modules)
    [F.IsQuasicoherent] (U : X.affineOpens) {ι : Type*} [Finite ι]
    (a : ι → Γ(X, (U : X.Opens))) (ha : ∀ i, a i ∈ I.ideal U)
    (hspan : I.ideal U = Ideal.span (Set.range a)) (s : Γ(F, idealComplement I)) :
    ∃ (k : ℕ) (m : ι → Γ(F, (U : X.Opens))) (N : ℕ)
      (φ : ↥((I.ideal U) ^ N) →ₗ[Γ(X, (U : X.Opens))]
        (Γ(F, (U : X.Opens)) ⧸ Submodule.torsionBySet Γ(X, (U : X.Opens))
          Γ(F, (U : X.Opens))
          (((I.ideal U) ^ N : Ideal Γ(X, (U : X.Opens))) : Set Γ(X, (U : X.Opens))))),
      (∀ i, F.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (m i) =
          (X.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (a i)) ^ k •
            F.presheaf.map (homOfLE (basicOpen_le_idealComplement I U (ha i))).op s) ∧
        ∀ (i : ι) (x : ↥((I.ideal U) ^ N)),
          a i ^ k • φ x = (x : Γ(X, (U : X.Opens))) •
            (Submodule.torsionBySet Γ(X, (U : X.Opens)) Γ(F, (U : X.Opens))
              (((I.ideal U) ^ N : Ideal Γ(X, (U : X.Opens))) :
                Set Γ(X, (U : X.Opens)))).mkQ (m i) := by
  classical
  obtain ⟨k, hk, m, hrep, hrel⟩ := exists_cross_related_family I F U a ha s
  obtain ⟨N, hle⟩ := exists_idealPow_le_powerSpan I U a hspan hk
  have hTle : Submodule.torsionBySet Γ(X, (U : X.Opens)) Γ(F, (U : X.Opens))
        (powerSpan a k : Set Γ(X, (U : X.Opens))) ≤
      Submodule.torsionBySet Γ(X, (U : X.Opens)) Γ(F, (U : X.Opens))
        (((I.ideal U) ^ N : Ideal Γ(X, (U : X.Opens))) : Set Γ(X, (U : X.Opens))) :=
    Submodule.torsionBySet_le_torsionBySet_of_subset hle
  obtain ⟨φ₀, hφ₀⟩ := exists_linearMap_of_cross_relations a k m hrel
  refine ⟨k, m, N,
    (Submodule.mapQ _ _ LinearMap.id hTle).comp (φ₀.comp (Submodule.inclusion hle)),
    hrep, fun i x => ?_⟩
  have hq : ∀ y : Γ(F, (U : X.Opens)), (Submodule.mapQ _ _ LinearMap.id hTle)
      ((Submodule.torsionBySet Γ(X, (U : X.Opens)) Γ(F, (U : X.Opens))
        (powerSpan a k : Set Γ(X, (U : X.Opens)))).mkQ y) =
      (Submodule.torsionBySet Γ(X, (U : X.Opens)) Γ(F, (U : X.Opens))
        (((I.ideal U) ^ N : Ideal Γ(X, (U : X.Opens))) : Set Γ(X, (U : X.Opens)))).mkQ y :=
    fun _ => rfl
  have hcoe' : ((Submodule.inclusion hle x : ↥(powerSpan a k)) :
      Γ(X, (U : X.Opens))) = (x : Γ(X, (U : X.Opens))) := rfl
  change a i ^ k •
    (Submodule.mapQ _ _ LinearMap.id hTle) (φ₀ (Submodule.inclusion hle x)) = _
  rw [← map_smul, hφ₀ i (Submodule.inclusion hle x), hcoe', map_smul, hq]

/-- **The affine case of the first clause of Tag 01PM in scheme language.** If no nonzero section
of `F` over the affine chart `U` is annihilated by `I(U)`, then the homomorphism of
`exists_idealPow_hom_of_section_on_affine` lands in `Γ(F, U)` itself, and on the basic open of
each generator it is multiplication by `s`. -/
public theorem exists_idealPow_hom_of_section_on_affine_of_torsionFree
    (I : X.IdealSheafData) (F : X.Modules) [F.IsQuasicoherent] (U : X.affineOpens)
    {ι : Type*} [Finite ι] (a : ι → Γ(X, (U : X.Opens))) (ha : ∀ i, a i ∈ I.ideal U)
    (hspan : I.ideal U = Ideal.span (Set.range a)) (s : Γ(F, idealComplement I))
    (htf : ∀ y : Γ(F, (U : X.Opens)), (∀ b ∈ I.ideal U, b • y = 0) → y = 0) :
    ∃ (N : ℕ) (φ : ↥((I.ideal U) ^ N) →ₗ[Γ(X, (U : X.Opens))] Γ(F, (U : X.Opens))),
      ∀ (i : ι) (x : ↥((I.ideal U) ^ N)),
        F.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (φ x) =
          (X.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (x : Γ(X, (U : X.Opens)))) •
            F.presheaf.map (homOfLE (basicOpen_le_idealComplement I U (ha i))).op s := by
  classical
  obtain ⟨k, hk, m, hrep, hrel⟩ := exists_cross_related_family I F U a ha s
  obtain ⟨N, hle⟩ := exists_idealPow_le_powerSpan I U a hspan hk
  have htf' : ∀ y : Γ(F, (U : X.Opens)), (∀ i, a i ^ k • y = 0) → y = 0 := by
    intro y hy
    refine eq_zero_of_idealPow_smul_eq_zero (I.ideal U) htf
      N y fun b hb => ?_
    exact smul_eq_zero_of_pow_smul_eq_zero a k y hy b (hle hb)
  obtain ⟨φ, hφ⟩ := exists_linearMap_of_cross_relations_of_torsionFree a k m hrel htf'
  refine ⟨N, φ.comp (Submodule.inclusion hle), fun i x => ?_⟩
  refine eq_of_pow_smul_eq_of_basicOpen F U.2 (a i) k rfl (X.basicOpen_le (a i)) _ _ ?_
  have h1 : (X.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (a i)) ^ k •
      F.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (φ (Submodule.inclusion hle x)) =
      F.presheaf.map (homOfLE (X.basicOpen_le (a i))).op
        (a i ^ k • φ (Submodule.inclusion hle x)) := by
    rw [F.map_smul, map_pow]
  change (X.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (a i)) ^ k •
    F.presheaf.map (homOfLE (X.basicOpen_le (a i))).op (φ (Submodule.inclusion hle x)) = _
  rw [h1, hφ i (Submodule.inclusion hle x), F.map_smul, hrep i, smul_comm]
  rfl

/-! ### A uniform exponent on a finite family of charts -/

/-- **One exponent for every chart.** On a finite family of affine charts the exponents of the
normal forms of one and the same section can be taken equal, and at least `1`. -/
public lemma exists_uniform_exponent (I : X.IdealSheafData) (F : X.Modules)
    {t : ℕ} (U : Fin t → X.affineOpens) {ι : Fin t → Type*}
    (a : ∀ l, ι l → Γ(X, ((U l : X.affineOpens) : X.Opens)))
    (ha : ∀ l i, a l i ∈ I.ideal (U l)) (s : Γ(F, idealComplement I))
    (k : Fin t → ℕ) (m : ∀ l, ι l → Γ(F, ((U l : X.affineOpens) : X.Opens)))
    (hrep : ∀ l i, F.presheaf.map (homOfLE (X.basicOpen_le (a l i))).op (m l i) =
      (X.presheaf.map (homOfLE (X.basicOpen_le (a l i))).op (a l i)) ^ (k l) •
        F.presheaf.map (homOfLE (basicOpen_le_idealComplement I (U l) (ha l i))).op s)
    (hrel : ∀ l i j, a l j ^ (k l) • m l i = a l i ^ (k l) • m l j) :
    ∃ (K : ℕ) (_ : 1 ≤ K) (m' : ∀ l, ι l → Γ(F, ((U l : X.affineOpens) : X.Opens))),
      (∀ l i, F.presheaf.map (homOfLE (X.basicOpen_le (a l i))).op (m' l i) =
          (X.presheaf.map (homOfLE (X.basicOpen_le (a l i))).op (a l i)) ^ K •
            F.presheaf.map (homOfLE (basicOpen_le_idealComplement I (U l) (ha l i))).op s) ∧
        ∀ l i j, a l j ^ K • m' l i = a l i ^ K • m' l j := by
  classical
  have h := fun l => pow_smul_family_mono I F (U l) (a l) (ha l) s
    (le_trans (Finset.le_sup (Finset.mem_univ l)) (le_max_left _ 1)) (m l) (hrep l) (hrel l)
  exact ⟨max (Finset.univ.sup k) 1, le_max_right _ 1,
    fun l i => a l i ^ (max (Finset.univ.sup k) 1 - k l) • m l i, fun l => (h l).1,
    fun l => (h l).2⟩

end

end Stacks.LocalCohomology

