/-!
# Finite modules isomorphic to their Frobenius pullback

Let `(A, 𝔪, κ)` be a Noetherian local ring in which a prime `p` vanishes. A finite `A`-module `M`
with `M ⊗_{A,F} A ≅ M`, where `F` is the Frobenius endomorphism and `A` acts on the target factor,
is finite free.

## Main definitions

* `FrobeniusTwist A p` is a copy of `A`, viewed as an `A`-algebra through the Frobenius map.
* `FrobeniusPullback A p M` is the Frobenius pullback `F^* M = FrobeniusTwist A p ⊗[A] M`, as an
  `A`-module through the target factor.

## Main results

* `FrobeniusPullback.smul_tmul`: `a • (b ⊗ m) = (a * b) ⊗ m` in `F^* M`.
* `FrobeniusPullback.nonempty_linearEquiv_self`: `F^* A ≅ A` for every ring `A` of
  characteristic `p`.
* `Module.free_of_forall_free_quotient_pow`: a finite module over a Noetherian local ring is free
  once all its reductions modulo powers of the maximal ideal are free.
* `free_of_frobeniusPullback_equiv`: a finite module isomorphic to its Frobenius pullback is free.

## Implementation notes

The type synonym `FrobeniusTwist A p` keeps the two `A`-actions on `F^* M` apart: the source action
through Frobenius, used to form the tensor product, and the target action by multiplication. The
proof shows inductively that `M / I_e M` is free over `A / I_e`, where `I_0 = 𝔪` and `I_{e+1}` is
generated by the `p`-th powers of elements of `I_e`. As `I_e ⊆ 𝔪 ^ (e + 1)`, every `M / 𝔪 ^ k M`
is free over `A / 𝔪 ^ k`, which forces a minimal presentation of `M` to have kernel inside
`⋂ₖ 𝔪 ^ k A ^ n = 0` by Krull's intersection theorem. This replaces the Fitting ideals of the
Stacks proof by the same Krull argument.

## References

* [Stacks Project, Tag 0EBV](https://stacks.math.columbia.edu/tag/0EBV)
-/

@[expose] public section

open scoped TensorProduct

open IsLocalRing

universe u v

/-- A copy of the ring `A`, viewed as an `A`-algebra through the Frobenius map `a ↦ a ^ p`. -/
def FrobeniusTwist (A : Type u) (_p : ℕ) : Type u := A

namespace FrobeniusTwist

variable (A : Type u) (p : ℕ) [CommRing A]

instance : CommRing (FrobeniusTwist A p) := inferInstanceAs (CommRing A)

/-- The identification of `A` with its Frobenius twist, as rings. -/
def ringEquiv : A ≃+* FrobeniusTwist A p := RingEquiv.refl A

variable [ExpChar A p]

/-- The `A`-algebra structure on the Frobenius twist, through the Frobenius map. -/
instance : Algebra A (FrobeniusTwist A p) :=
  ((ringEquiv A p).toRingHom.comp (frobenius A p)).toAlgebra

theorem algebraMap_apply (a : A) :
    algebraMap A (FrobeniusTwist A p) a = ringEquiv A p (a ^ p) := rfl

end FrobeniusTwist

section Pullback

variable (A : Type u) (p : ℕ) (M : Type v) [CommRing A] [ExpChar A p]
  [AddCommGroup M] [Module A M]

/-- The Frobenius pullback `F^* M = M ⊗_{A,F} A` of an `A`-module `M`, written with the twisted
copy of `A` on the left. Its `A`-module structure is multiplication on the target factor. -/
def FrobeniusPullback : Type (max u v) := FrobeniusTwist A p ⊗[A] M

instance FrobeniusPullback.instAddCommGroup : AddCommGroup (FrobeniusPullback A p M) :=
  inferInstanceAs (AddCommGroup (FrobeniusTwist A p ⊗[A] M))

/-- The `A`-module structure on `F^* M`, by multiplication on the target factor. -/
instance FrobeniusPullback.instModule : Module A (FrobeniusPullback A p M) :=
  Module.compHom (FrobeniusTwist A p ⊗[A] M) (FrobeniusTwist.ringEquiv A p).toRingHom

variable {A p M}

/-- The pure tensor `b ⊗ m` in the Frobenius pullback. -/
def FrobeniusPullback.tmul (b : FrobeniusTwist A p) (m : M) : FrobeniusPullback A p M :=
  b ⊗ₜ[A] m

/-- `A` acts on the Frobenius pullback through the target factor. -/
theorem FrobeniusPullback.smul_tmul (a : A) (b : FrobeniusTwist A p) (m : M) :
    a • FrobeniusPullback.tmul b m =
      FrobeniusPullback.tmul (FrobeniusTwist.ringEquiv A p a * b) m := rfl

/-- The source action through Frobenius moves across the tensor sign:
`b ⊗ a m = (a ^ p * b) ⊗ m`. -/
theorem FrobeniusPullback.tmul_smul (a : A) (b : FrobeniusTwist A p) (m : M) :
    FrobeniusPullback.tmul b (a • m) =
      FrobeniusPullback.tmul (FrobeniusTwist.ringEquiv A p (a ^ p) * b) m :=
  (TensorProduct.smul_tmul a b m).symm

variable (A p) in
/-- The Frobenius pullback of `A` is `A`: the hypothesis `F^* M ≅ M` holds for `M = A` over every
ring of characteristic `p`, reduced or not. -/
theorem FrobeniusPullback.nonempty_linearEquiv_self :
    Nonempty (FrobeniusPullback A p A ≃ₗ[A] A) :=
  ⟨{ toAddEquiv :=
        (TensorProduct.AlgebraTensorModule.rid A (FrobeniusTwist A p)
          (FrobeniusTwist A p)).toAddEquiv
     map_smul' := fun a x =>
        (TensorProduct.AlgebraTensorModule.rid A (FrobeniusTwist A p)
          (FrobeniusTwist A p)).map_smul (FrobeniusTwist.ringEquiv A p a) x }⟩

end Pullback

namespace Module

variable {A : Type u} {M : Type v} [CommRing A] [AddCommGroup M] [Module A M]

/-- Freeness of `M / I M` over `A / I` passes to `T ⊗[A] M` for every `A`-algebra `T` killing
`I`. -/
theorem free_baseChange_of_free_quotient {I : Ideal A} {T : Type*} [CommRing T] [Algebra A T]
    (hI : ∀ a ∈ I, algebraMap A T a = 0) [Module.Free (A ⧸ I) ((A ⧸ I) ⊗[A] M)] :
    Module.Free T (T ⊗[A] M) := by
  let : Algebra (A ⧸ I) T := (Ideal.Quotient.lift I (algebraMap A T) hI).toAlgebra
  have : IsScalarTower A (A ⧸ I) T := IsScalarTower.of_algebraMap_eq fun _ => rfl
  exact Module.Free.of_equiv
    (TensorProduct.AlgebraTensorModule.cancelBaseChange A (A ⧸ I) T T M)

/-- If `M / I M` is free over `A / I` and `S ⊗[A] M ≅ N` for an `A`-algebra `S`, then
`N / I N` is free over `S / I S`. -/
theorem free_quotient_map_of_free_quotient {S : Type*} [CommRing S] [Algebra A S]
    {N : Type*} [AddCommGroup N] [Module S N] (e : S ⊗[A] M ≃ₗ[S] N) (I : Ideal A)
    [Module.Free (A ⧸ I) ((A ⧸ I) ⊗[A] M)] :
    Module.Free (S ⧸ I.map (algebraMap A S)) ((S ⧸ I.map (algebraMap A S)) ⊗[S] N) := by
  have : Module.Free (S ⧸ I.map (algebraMap A S)) ((S ⧸ I.map (algebraMap A S)) ⊗[A] M) :=
    free_baseChange_of_free_quotient fun a ha => by
      rw [IsScalarTower.algebraMap_apply A S, Ideal.Quotient.algebraMap_eq,
        Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.mem_map_of_mem _ ha
  exact Module.Free.of_equiv
    ((TensorProduct.AlgebraTensorModule.cancelBaseChange A S _ _ M).symm ≪≫ₗ
      e.baseChange S _ _ _)

/-- A finite module over a Noetherian local ring is free once `M / 𝔪 ^ k M` is free over
`A / 𝔪 ^ k` for every `k`. -/
theorem free_of_forall_free_quotient_pow [IsLocalRing A] [IsNoetherianRing A] [Module.Finite A M]
    (h : ∀ k : ℕ, Module.Free (A ⧸ maximalIdeal A ^ k) ((A ⧸ maximalIdeal A ^ k) ⊗[A] M)) :
    Module.Free A M := by
  let κ := ResidueField A
  let n := Module.finrank κ (κ ⊗[A] M)
  let bk := Module.finBasis κ (κ ⊗[A] M)
  obtain ⟨v, hv⟩ := (TensorProduct.mk_surjective A M κ Ideal.Quotient.mk_surjective).comp_left bk
  let i := Finsupp.linearCombination A v
  have hi : Function.Surjective i := by
    rw [← LinearMap.range_eq_top, Finsupp.range_linearCombination]
    exact IsLocalRing.span_eq_top_of_tmul_eq_basis (R := A) v bk fun j => congr_fun hv j
  have hker : ∀ x, i x = 0 → ∀ k : ℕ, x ∈ maximalIdeal A ^ k • (⊤ : Submodule A (Fin n →₀ A)) := by
    intro x hx k
    rcases k with _ | k
    · simp
    have hle : maximalIdeal A ^ (k + 1) ≤ maximalIdeal A := Ideal.pow_le_self k.succ_ne_zero
    let T := A ⧸ maximalIdeal A ^ (k + 1)
    have : Nontrivial T := Ideal.Quotient.nontrivial_iff.mpr
      (ne_top_of_le_ne_top (maximalIdeal.isMaximal A).ne_top hle)
    let : Algebra T κ := (Ideal.Quotient.factor hle).toAlgebra
    have : IsScalarTower A T κ := IsScalarTower.of_algebraMap_eq fun _ => rfl
    have := h (k + 1)
    have hrank : Module.finrank T (T ⊗[A] M) = n := by
      rw [← Module.finrank_baseChange (R := κ),
        (TensorProduct.AlgebraTensorModule.cancelBaseChange A T κ κ M).finrank_eq]
    let bX := Module.Free.chooseBasis T (T ⊗[A] M)
    let bD : Module.Basis (Fin n) T (T ⊗[A] (Fin n →₀ A)) :=
      (Finsupp.basisSingleOne).baseChange T
    let eqv : T ⊗[A] (Fin n →₀ A) ≃ₗ[T] T ⊗[A] M :=
      bD.equiv bX (Fintype.equivOfCardEq (by
        rw [Fintype.card_fin, ← Module.finrank_eq_card_chooseBasisIndex, hrank]))
    let iT := i.baseChange T
    have hiT : Function.Surjective iT := i.lTensor_surjective _ hi
    have hinj : Function.Injective iT := by
      have := OrzechProperty.injective_of_surjective_endomorphism (eqv.symm.toLinearMap ∘ₗ iT)
        (eqv.symm.surjective.comp hiT)
      exact fun a b hab => this (by rw [LinearMap.comp_apply, LinearMap.comp_apply, hab])
    have h1 : (1 : T) ⊗ₜ[A] x = 0 := hinj (by simp [iT, hx])
    have h2 := congr_arg (TensorProduct.quotTensorEquivQuotSMul (Fin n →₀ A)
      (maximalIdeal A ^ (k + 1))) h1
    rw [← map_one (Ideal.Quotient.mk _), TensorProduct.quotTensorEquivQuotSMul_mk_tmul,
      one_smul, map_zero] at h2
    exact (Submodule.Quotient.mk_eq_zero _).mp h2
  have hinj : Function.Injective i := by
    rw [← LinearMap.ker_eq_bot, eq_bot_iff]
    intro x hx
    rw [← Ideal.iInf_pow_smul_eq_bot_of_isLocalRing (maximalIdeal A)
      (maximalIdeal.isMaximal A).ne_top]
    exact Submodule.mem_iInf _ |>.mpr (hker x hx)
  exact Module.Free.of_equiv (LinearEquiv.ofBijective i ⟨hinj, hi⟩)

end Module

/-- **Stacks 0EBV.** Let `(A, 𝔪, κ)` be a Noetherian local ring in which a prime `p` vanishes,
and let `M` be a finite `A`-module with `F^* M = M ⊗_{A,F} A ≅ M`, where `A` acts on `F^* M`
through the target factor. Then `M` is finite free. Finiteness of `M` is a hypothesis, so the
conclusion `Module.Free A M` expresses finite freeness. -/
@[stacks 0EBV "The hypothesis is an `A`-linear isomorphism `F^* M ≅ M` for the Frobenius pullback
`FrobeniusPullback A p M = FrobeniusTwist A p ⊗[A] M`, with `A` acting on the target factor
(`FrobeniusPullback.smul_tmul`). The proof replaces the Fitting ideals of the Stacks proof by
freeness of `M / 𝔪 ^ k M` over `A / 𝔪 ^ k` for all `k`, followed by the same Krull intersection
argument."]
theorem free_of_frobeniusPullback_equiv
    {A : Type u} {M : Type v} [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    [AddCommGroup M] [Module A M] [Module.Finite A M]
    (p : ℕ) [Fact p.Prime] [CharP A p]
    (h : Nonempty (FrobeniusPullback A p M ≃ₗ[A] M)) :
    Module.Free A M := by
  obtain ⟨e⟩ := h
  let : Module (FrobeniusTwist A p) M := (inferInstance : Module A M)
  let e' : FrobeniusTwist A p ⊗[A] M ≃ₗ[FrobeniusTwist A p] M := e
  have hstep : ∀ I : Ideal A, Module.Free (A ⧸ I) ((A ⧸ I) ⊗[A] M) →
      Module.Free (A ⧸ (I.map (algebraMap A (FrobeniusTwist A p)) : Ideal A))
        ((A ⧸ (I.map (algebraMap A (FrobeniusTwist A p)) : Ideal A)) ⊗[A] M) :=
    fun I _ => Module.free_quotient_map_of_free_quotient e' I
  have hp : 2 ≤ p := (Fact.out : p.Prime).two_le
  have hle : ∀ (k : ℕ) (I : Ideal A), I ≤ maximalIdeal A ^ (k + 1) →
      ∀ x ∈ (I.map (algebraMap A (FrobeniusTwist A p)) : Ideal A),
        x ∈ maximalIdeal A ^ (k + 1 + 1) := by
    intro k I hI x hx
    have h : I.map (algebraMap A (FrobeniusTwist A p)) ≤
        (maximalIdeal A ^ (k + 1 + 1)).comap (FrobeniusTwist.ringEquiv A p).symm := by
      rw [Ideal.map_le_iff_le_comap]
      intro y hy
      rw [Ideal.mem_comap, Ideal.mem_comap, FrobeniusTwist.algebraMap_apply,
        RingEquiv.symm_apply_apply]
      refine Ideal.pow_le_pow_right ?_ (pow_mul (maximalIdeal A) (k + 1) p ▸
        Ideal.pow_mem_pow (hI hy) p)
      nlinarith
    exact h hx
  have hres : Module.Free (A ⧸ maximalIdeal A) ((A ⧸ maximalIdeal A) ⊗[A] M) :=
    (inferInstance : Module.Free (ResidueField A) (ResidueField A ⊗[A] M))
  have key : ∀ k : ℕ, ∃ I : Ideal A, I ≤ maximalIdeal A ^ (k + 1) ∧
      Module.Free (A ⧸ I) ((A ⧸ I) ⊗[A] M) := by
    intro k
    induction k with
    | zero => exact ⟨maximalIdeal A, by simp, hres⟩
    | succ k ih =>
      obtain ⟨I, hI, hfree⟩ := ih
      exact ⟨_, hle k I hI, hstep I hfree⟩
  refine Module.free_of_forall_free_quotient_pow fun k => ?_
  obtain ⟨I, hI, hfree⟩ := key k
  exact Module.free_baseChange_of_free_quotient (I := I) fun a ha =>
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.pow_le_pow_right k.le_succ (hI ha))
