module

public import Mathlib.RingTheory.Length
public import Mathlib.RingTheory.Regular.RegularSequence
public import StacksFrontier.AlgebraicGeometry.LocalCohomology.FrobeniusAction.IdealIndependent
public import StacksCore.Tactic.StacksAttribute

/-!
# Length after replacing the last independent element by a product

For an independent list of elements of a commutative ring, replacing its last element by a
product splits the length of the resulting quotient as the sum of the lengths obtained by using
the two factors separately.

## Main results

* `length_quotient_eq_add_of_isIndependent_mul` is the length formula for a product
  in the last position of an independent list.

## Implementation notes

The finite list in the source is represented by the family indexed by its positions, using
`IsIdealIndependent`. The source assumes that the quotient by the product list has finite
length. Mathlib's `Module.length` takes values in `ℕ∞`, and additivity is valid without this
finiteness assumption, so the result is stated in the stronger form.

## References

* [Lech, *Inequalities related to certain couples of local rings*][Lech-inequalities]
* [Matsumura, *Commutative Algebra*, Lemma 2, p. 300][MatCA]
* [Stacks Project, Tag 0EBX](https://stacks.math.columbia.edu/tag/0EBX)
-/

@[expose] public section

variable {A : Type*} [CommRing A]

/-- The last element of a list lies in the ideal generated by that list. -/
private lemma mem_ofList_append_singleton (init : List A) (a : A) :
    a ∈ Ideal.ofList (init ++ [a]) := by
  rw [Ideal.ofList_append, Ideal.ofList_singleton]
  exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self a)

/-- Replacing the last element of a list by a multiple shrinks the ideal it generates. -/
private lemma ofList_append_singleton_le_of_dvd (init : List A) {a b : A} (h : a ∣ b) :
    Ideal.ofList (init ++ [b]) ≤ Ideal.ofList (init ++ [a]) := by
  rw [Ideal.ofList_append, Ideal.ofList_append, Ideal.ofList_singleton, Ideal.ofList_singleton]
  exact sup_le_sup_left (Ideal.span_singleton_le_span_singleton.mpr h) _

/-- For an independent list ending in `f * g`, an element `x` with `f * x` in the ideal of that
list already lies in the ideal of the list ending in `g`. -/
private lemma mem_ofList_right_of_mul_mem
    (init : List A) (f g x : A)
    (h : IsIdealIndependent (fun i : Fin (init ++ [f * g]).length ↦
      (init ++ [f * g])[i]))
    (hx : f * x ∈ Ideal.ofList (init ++ [f * g])) :
    x ∈ Ideal.ofList (init ++ [g]) := by
  let l := init ++ [f * g]
  let v : Fin l.length → A := fun i ↦ l.get i
  have hv : Ideal.ofList l = Ideal.span (Set.range v) := by
    rw [Ideal.ofList]
    congr 1
    ext z
    simpa [v] using (List.mem_iff_get (l := l) (a := z))
  obtain ⟨c, hc⟩ := Finsupp.mem_span_range_iff_exists_finsupp.mp (hv ▸ hx)
  let last : Fin l.length := ⟨init.length, by simp [l]⟩
  let d : Fin l.length →₀ A := (-g) • c + Finsupp.single last x
  have hInd : IsIdealIndependent v := by
    simpa [v, l, List.get_eq_getElem] using h
  have hd : Finsupp.linearCombination A v d = 0 := by
    simp only [d, map_add, map_smul, Finsupp.linearCombination_single]
    change (-g) * (c.sum fun i a ↦ a • v i) + x * v last = 0
    rw [hc]
    simp [v, l, last]
    ring
  have hcoeff : d last = x - c last * g := by
    simp [d, last, mul_comm, sub_eq_add_neg]
    ring
  have hlast : x - c last * g ∈ Ideal.ofList l := by
    rw [hv]
    simpa [hcoeff] using hInd d hd last
  have hsub := ofList_append_singleton_le_of_dvd init (dvd_mul_left g f)
  have hg := mem_ofList_append_singleton init g
  rw [← sub_add_cancel x (c last * g)]
  exact Ideal.add_mem _ (hsub hlast) (Ideal.mul_mem_left _ (c last) hg)

/-- **Stacks Project, Tag 0EBX.** If appending `f * g` to a list gives an independent list,
then the length of the quotient by that list is the sum of the lengths of the quotients obtained
by appending `f` and `g` separately. -/
@[stacks 0EBX]
lemma length_quotient_eq_add_of_isIndependent_mul (init : List A) (f g : A)
    (h : IsIdealIndependent (fun i : Fin (init ++ [f * g]).length ↦
      (init ++ [f * g])[i])) :
    Module.length A (A ⧸ Ideal.ofList (init ++ [f * g])) =
      Module.length A (A ⧸ Ideal.ofList (init ++ [f])) +
        Module.length A (A ⧸ Ideal.ofList (init ++ [g])) := by
  let J : Ideal A := Ideal.ofList (init ++ [g])
  let K : Ideal A := Ideal.ofList (init ++ [f * g])
  let L : Ideal A := Ideal.ofList (init ++ [f])
  have hIK : Ideal.ofList init ≤ K := le_sup_left.trans_eq (Ideal.ofList_append init _).symm
  have hJK : J ≤ Submodule.comap (LinearMap.mulRight A f) K := by
    change Ideal.ofList (init ++ [g]) ≤
      Submodule.comap (LinearMap.mulRight A f) (Ideal.ofList (init ++ [f * g]))
    rw [Ideal.ofList_append, Ideal.ofList_singleton, Ideal.ofList_append, Ideal.ofList_singleton]
    refine sup_le (fun x hx ↦ Submodule.mem_comap.mpr
      (Ideal.mem_sup_left (Ideal.mul_mem_right f _ hx))) ?_
    rw [Ideal.span_le, Set.singleton_subset_iff, SetLike.mem_coe, Submodule.mem_comap,
      LinearMap.mulRight_apply, mul_comm]
    exact Ideal.mem_sup_right (Ideal.mem_span_singleton_self _)
  have hKL : K ≤ L := ofList_append_singleton_le_of_dvd init (dvd_mul_right f g)
  let φ : A ⧸ J →ₗ[A] A ⧸ K := J.mapQ K (LinearMap.mulRight A f) hJK
  let ψ : A ⧸ K →ₗ[A] A ⧸ L := K.factor hKL
  have hker : Submodule.comap (LinearMap.mulRight A f) K = J :=
    le_antisymm (fun x hx ↦ mem_ofList_right_of_mul_mem init f g x h
      (by rwa [mul_comm f x])) hJK
  have hφinj : Function.Injective φ := by
    apply LinearMap.ker_eq_bot.mp
    change LinearMap.ker (J.mapQ K (LinearMap.mulRight A f) hJK) = ⊥
    rw [Submodule.ker_mapQ, hker, Submodule.mkQ_map_self]
  have hExact : Function.Exact φ ψ := by
    rw [LinearMap.exact_iff]
    refine Submodule.ext fun z ↦ ⟨fun hz ↦ ?_, ?_⟩
    · change ψ z = 0 at hz
      obtain ⟨a, rfl⟩ := K.mkQ_surjective z
      rw [show ψ (K.mkQ a) = L.mkQ a from Submodule.factor_mk hKL a] at hz
      have haL : a ∈ Ideal.ofList init ⊔ Ideal.span {f} := by
        simpa only [L, Ideal.ofList_append, Ideal.ofList_singleton] using
          Ideal.Quotient.eq_zero_iff_mem.mp hz
      obtain ⟨u, hu, v, hv, hav⟩ := Submodule.mem_sup.mp haL
      obtain ⟨b, hb⟩ := Ideal.mem_span_singleton.mp hv
      refine ⟨J.mkQ b, ?_⟩
      change K.mkQ (b * f) = K.mkQ a
      apply (Submodule.Quotient.eq K).mpr
      rw [← hav, hb]
      convert K.neg_mem (hIK hu) using 1
      ring
    · rintro ⟨y, rfl⟩
      obtain ⟨a, rfl⟩ := J.mkQ_surjective y
      simp only [φ, ψ]
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      have hfL : f ∈ L := mem_ofList_append_singleton init f
      simpa using L.mul_mem_left a hfL
  simpa only [add_comm] using Module.length_eq_add_of_exact φ ψ hφinj
    (Submodule.factor_surjective hKL) hExact
