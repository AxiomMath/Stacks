module

public import Mathlib.RingTheory.Length
public import Mathlib.RingTheory.LocalRing.MaximalIdeal.Basic
public import StacksFrontier.AlgebraicGeometry.LocalCohomology.FrobeniusAction.IdealIndependent
public import StacksFrontier.AlgebraicGeometry.LocalCohomology.FrobeniusAction.LengthQuotient
public import StacksFrontier.RingTheory.Sequence.Regular.Basic
public import StacksCore.Tactic.StacksAttribute

/-!
# Length of a quotient by independent powers

Let a finite family generate the maximal ideal of a local ring. If positive powers of the
generators are independent, then the quotient by those powers has length equal to the product
of their exponents.

## Main results

* `length_quotient_span_powers_eq_prod` computes the length of the quotient by
  independent positive powers of generators of the maximal ideal.

## Implementation notes

The source defines independence in the surrounding text: a family `f` is independent when
every relation `∑ i, a i * f i = 0` has every coefficient in the ideal generated by `f`.
That condition is stated explicitly here. Finite families are indexed by `Fin r`, and lengths
take values in `ℕ∞`.

## References

* [Stacks Project, Tag 0EBY](https://stacks.math.columbia.edu/tag/0EBY)
* [Lech, *Note on multiplicities of ideals*][Lech-inequalities]
* [Matsumura, *Commutative Algebra*, Lemma 3, p. 300][MatCA]
-/

@[expose] public section

open scoped BigOperators

/-- Independence stated with plain coefficient functions on a finite index type implies
`IsIdealIndependent`. -/
private lemma isIdealIndependent_of_forall_sum {A : Type*} [CommRing A] {ι : Type*}
    [Fintype ι] (f : ι → A)
    (h : ∀ a : ι → A, (∑ i, a i * f i) = 0 →
      ∀ i, a i ∈ Ideal.span (Set.range f)) :
    IsIdealIndependent f := fun a ha i ↦
  h (Finsupp.equivFunOnFinite a)
    (by simpa [Finsupp.linearCombination_apply, Finsupp.sum_fintype] using ha) i

/-- `IsIdealIndependent` implies independence stated with plain coefficient functions on a
finite index type. -/
private lemma forall_sum_of_isIdealIndependent {A : Type*} [CommRing A] {ι : Type*}
    [Fintype ι] (f : ι → A) (h : IsIdealIndependent f) :
    ∀ a : ι → A, (∑ i, a i * f i) = 0 →
      ∀ i, a i ∈ Ideal.span (Set.range f) := fun a ha i ↦
  h (Finsupp.equivFunOnFinite.symm a)
    (by simpa [Finsupp.linearCombination_apply, Finsupp.sum_fintype] using ha) i

/-- Independence of a finite family is invariant under reindexing by an equivalence. -/
private lemma forall_sum_comp_equiv {A : Type*} [CommRing A] {ι κ : Type*}
    [Fintype ι] [Fintype κ] (f : κ → A)
    (h : ∀ a : κ → A, (∑ i, a i * f i) = 0 →
      ∀ i, a i ∈ Ideal.span (Set.range f)) (σ : ι ≃ κ) :
    ∀ a : ι → A, (∑ j, a j * f (σ j)) = 0 →
      ∀ j, a j ∈ Ideal.span (Set.range fun k ↦ f (σ k)) := by
  intro a ha j
  have hr : Set.range (fun k ↦ f (σ k)) = Set.range f := σ.surjective.range_comp f
  have hz : (∑ i, a (σ.symm i) * f i) = 0 := by
    rw [← Equiv.sum_comp σ (fun i ↦ a (σ.symm i) * f i)]
    simpa using ha
  simpa [hr] using h (fun i ↦ a (σ.symm i)) hz (σ j)

/-- If a family ending in a power `z ^ m` is independent, so is the family ending in any
positive lower power `z ^ c`. -/
private lemma isIdealIndependent_snoc_pow_of_le {A : Type*} [CommRing A] {n : ℕ}
    (f : Fin n → A) (z : A) (m : ℕ)
    (h : IsIdealIndependent (Fin.snoc f (z ^ m))) :
    ∀ c, 1 ≤ c → c ≤ m → IsIdealIndependent (Fin.snoc f (z ^ c)) := by
  induction m with
  | zero => intro c h1 h2; omega
  | succ m ih =>
      intro c h1 h2
      rcases h2.eq_or_lt with rfl | h2
      · exact h
      · exact ih (isIdealIndependent_snoc_left_of_mul f _ z (by rwa [← pow_succ])) c h1
          (by omega)

/-- The length formula, proved by strong induction on the sum of the exponents. -/
private theorem length_quotient_span_powers_eq_prod_aux {A : Type*} [CommRing A] [IsLocalRing A]
    {r : ℕ} : ∀ n (x : Fin r → A) (e : Fin r → ℕ),
      (∑ i, e i) = n →
      Ideal.span (Set.range x) = IsLocalRing.maximalIdeal A →
      (∀ i, 0 < e i) →
      IsIdealIndependent (fun i ↦ x i ^ e i) →
      Module.length A (A ⧸ Ideal.span (Set.range fun i ↦ x i ^ e i)) =
        ((∏ i, e i : ℕ) : ℕ∞) := by
  intro n
  induction n using Nat.strong_induction_on with
  | h n ih =>
      intro x e hsum hx he hind
      by_cases hone : ∀ i, e i = 1
      · have hlen : Module.length A (A ⧸ IsLocalRing.maximalIdeal A) = 1 :=
          Module.length_eq_one_iff.mpr
            (isSimpleModule_iff_isCoatom.mpr (Ideal.isMaximal_def.mp inferInstance))
        have hfun : (fun i : Fin r ↦ x i ^ e i) = x := funext fun i ↦ by simp [hone i]
        rw [hfun, hx, hlen]
        simp [hone]
      · have hr : 0 < r := by
          by_contra hzero
          have : r = 0 := Nat.eq_zero_of_not_pos hzero
          subst r
          exact hone (by intro i; exact Fin.elim0 i)
        obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hr)
        have hex : ∃ i : Fin (k + 1), e i ≠ 1 := by
          by_contra h
          push Not at h
          exact hone (fun i ↦ by simpa using h i)
        obtain ⟨i, hi⟩ := hex
        have hgt : 1 < e i := by
          have := he i
          omega
        let σ : Fin (k + 1) ≃ Fin (k + 1) := Equiv.swap i (Fin.last k)
        let y : Fin (k + 1) → A := fun j ↦ x (σ j)
        let d : Fin (k + 1) → ℕ := fun j ↦ e (σ j)
        have hlast : σ (Fin.last k) = i := by simp [σ]
        have hsum' : (∑ j, d j) = n := (Equiv.sum_comp σ e).trans hsum
        have hx' : Ideal.span (Set.range y) = IsLocalRing.maximalIdeal A := by
          have hrange : Set.range y = Set.range x := σ.surjective.range_comp x
          simpa [y, hrange] using hx
        let σ : Fin (k + 1) ≃ Fin (k + 1) := Equiv.swap i (Fin.last k)
        let y : Fin (k + 1) → A := fun j ↦ x (σ j)
        let d : Fin (k + 1) → ℕ := fun j ↦ e (σ j)
        have hlast : σ (Fin.last k) = i := by simp [σ]
        have hsum' : (∑ j, d j) = n := (Equiv.sum_comp σ e).trans hsum
        have hx' : Ideal.span (Set.range y) = IsLocalRing.maximalIdeal A := by
          have hrange : Set.range y = Set.range x := σ.surjective.range_comp x
          simpa [y, hrange] using hx
        have hpow : IsIdealIndependent (fun j ↦ y j ^ d j) := by
          apply isIdealIndependent_of_forall_sum
          apply forall_sum_comp_equiv (fun j ↦ x j ^ e j)
              (forall_sum_of_isIdealIndependent _ hind) σ
        have hlastgt : 1 < d (Fin.last k) := by simpa [d, hlast] using hgt
        obtain ⟨q, hlast_eq⟩ : ∃ q, d (Fin.last k) = q + 1 := ⟨d (Fin.last k) - 1, by omega⟩
        let pref : Fin k → A := fun j ↦ y j.castSucc ^ d j.castSucc
        let z : A := y (Fin.last k)
        let init : List A := List.ofFn pref
        -- the exponents `d` with the last one replaced by `c`
        let E : ℕ → Fin (k + 1) → ℕ := fun c ↦ Fin.snoc (fun j ↦ d j.castSucc) c
        have hd_eq : d = E (q + 1) := by
          funext j
          refine Fin.lastCases ?_ (fun j ↦ ?_) j
          · simp [E, hlast_eq]
          · simp [E]
        have hE : ∀ c, (fun j ↦ y j ^ E c j) = Fin.snoc pref (z ^ c) := by
          intro c
          funext j
          refine Fin.lastCases ?_ (fun j ↦ ?_) j
          · simp [E, z]
          · simp [E, pref]
        have hofn : ∀ c, List.ofFn (Fin.snoc pref (z ^ c) : Fin (k + 1) → A) = init ++ [z ^ c] := by
          intro c
          rw [List.ofFn_succ_last]
          simp [init]
        have hI : ∀ c, Ideal.ofList (init ++ [z ^ c]) =
            Ideal.span (Set.range fun j ↦ y j ^ E c j) := by
          intro c
          rw [← hofn, Ideal.ofList_ofFn, hE]
        have hpos : ∀ c, 0 < c → ∀ j, 0 < E c j := by
          intro c hc j
          refine Fin.lastCases ?_ (fun j ↦ ?_) j
          · simpa [E] using hc
          · simpa [E] using he (σ j.castSucc)
        have hpow_snoc : IsIdealIndependent (Fin.snoc pref (z ^ (q + 1))) := by
          rw [← hE, ← hd_eq]
          exact hpow
        have hsumE : ∀ c, c ≤ q → (∑ j, E c j) < n := by
          intro c hc
          rw [Fin.sum_univ_castSucc]
          simp only [E, Fin.snoc_castSucc, Fin.snoc_last]
          have hs : (∑ j : Fin k, d j.castSucc) + d (Fin.last k) = n := by
            simpa [Fin.sum_univ_castSucc] using hsum'
          omega
        have hlenE : ∀ c, 1 ≤ c → c ≤ q → Module.length A
            (A ⧸ Ideal.span (Set.range fun j ↦ y j ^ E c j)) = ((∏ j, E c j : ℕ) : ℕ∞) := by
          intro c h1 h2
          refine ih (∑ j, E c j) (hsumE c h2) y (E c) rfl hx' (hpos c h1) ?_
          rw [hE]
          exact isIdealIndependent_snoc_pow_of_le pref z (q + 1) hpow_snoc c h1 (by omega)
        have hlist : IsIdealIndependent
            (fun t : Fin (init ++ [z ^ q * z]).length ↦ (init ++ [z ^ q * z])[t]) := by
          have key : ∀ L : List A, L = List.ofFn (Fin.snoc pref (z ^ (q + 1)) : Fin (k + 1) → A) →
              IsIdealIndependent (fun t : Fin L.length ↦ L[t]) := by
            rintro L rfl
            apply isIdealIndependent_of_forall_sum
            intro a ha j
            simp only [Fin.getElem_fin, List.getElem_ofFn] at ha ⊢
            exact forall_sum_comp_equiv _ (forall_sum_of_isIdealIndependent _ hpow_snoc)
              (finCongr List.length_ofFn) a ha j
          exact key _ (by rw [← pow_succ, hofn])
        have hsplit := length_quotient_eq_add_of_isIndependent_mul init (z ^ q) z hlist
        have hI1 : Ideal.ofList (init ++ [z]) = Ideal.span (Set.range fun j ↦ y j ^ E 1 j) := by
          simpa using hI 1
        rw [← pow_succ, hI, hI, hI1, hlenE q (by omega) le_rfl, hlenE 1 le_rfl (by omega)] at hsplit
        have hfinalNat : (∏ j, E (q + 1) j) = (∏ j, E q j) + (∏ j, E 1 j) := by
          rw [Fin.prod_univ_castSucc, Fin.prod_univ_castSucc, Fin.prod_univ_castSucc]
          simp only [E, Fin.snoc_castSucc, Fin.snoc_last]
          ring
        have hrpow : Set.range (fun j ↦ y j ^ d j) =
            Set.range (fun j ↦ x j ^ e j) := σ.surjective.range_comp fun j ↦ x j ^ e j
        rw [← hrpow, ← Equiv.prod_comp σ e]
        change _ = ((∏ j, d j : ℕ) : ℕ∞)
        rw [hd_eq, hsplit, hfinalNat]
        push_cast
        rfl

/-- **Stacks Project, Tag 0EBY.** If `x` generates the maximal ideal of a local ring and
the positive powers `x i ^ e i` are independent, then the quotient by those powers has length
equal to the product of the exponents. -/
@[stacks 0EBY]
lemma length_quotient_span_powers_eq_prod {A : Type*} [CommRing A] [IsLocalRing A]
    {r : ℕ} (x : Fin r → A) (e : Fin r → ℕ)
    (hx : Ideal.span (Set.range x) = IsLocalRing.maximalIdeal A)
    (he : ∀ i, 0 < e i)
    (hind : ∀ (a : Fin r → A), (∑ i, a i * x i ^ e i) = 0 →
      ∀ i, a i ∈ Ideal.span (Set.range fun j ↦ x j ^ e j)) :
    Module.length A (A ⧸ Ideal.span (Set.range fun i ↦ x i ^ e i)) =
      ((∏ i, e i : ℕ) : ℕ∞) :=
  length_quotient_span_powers_eq_prod_aux _ x e rfl hx he (isIdealIndependent_of_forall_sum _ hind)
