module

public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.Algebra.BigOperators.Fin
public import Mathlib.RingTheory.Ideal.Operations
public import Mathlib.Tactic.LinearCombination
public import StacksCore.Tactic.StacksAttribute

/-!
# Independent generators of an ideal

A family of elements of a commutative ring is independent if every linear relation among
the elements has all its coefficients in the ideal generated by the family. If a family
ending in a product `x * y` is independent, then replacing that product by `x` preserves
independence.

## Main definitions

* `IsIdealIndependent` says that the coefficients of every relation among a family
  belong to the ideal generated by that family.

## Main results

* `isIdealIndependent_snoc_left_of_mul` replaces the last generator `x * y` of an
  independent finite family by `x`.

## Implementation notes

The source states the definition for a finite list. We define it for an arbitrarily indexed
family using finitely supported coefficient families; the theorem specializes it to a family
indexed by `Fin (n + 1)`, with its final entry formed using `Fin.snoc`.

## References

* [Stacks Project, Tag 0EBW](https://stacks.math.columbia.edu/tag/0EBW)
* [Lech, *Inequalities related to certain couples of local rings*][Lech-inequalities]
* [Matsumura, *Commutative Algebra*, Lemma 1, p. 299][MatCA]
-/

@[expose] public section

/-- A family of ring elements is ideal-independent if every coefficient in every finite
linear relation among the elements belongs to the ideal generated by the family. -/
def IsIdealIndependent {A : Type*} [CommRing A] {ι : Type*} (f : ι → A) : Prop :=
  ∀ a : ι →₀ A, Finsupp.linearCombination A f a = 0 →
    ∀ i, a i ∈ Ideal.span (Set.range f)

/-- If an ideal-independent finite family ends in `x * y`, replacing its last member by
`x` gives another ideal-independent family. -/
@[stacks 0EBW]
theorem isIdealIndependent_snoc_left_of_mul {A : Type*} [CommRing A] {n : ℕ}
    (f : Fin n → A) (x y : A)
    (h : IsIdealIndependent (Fin.snoc f (x * y))) :
    IsIdealIndependent (Fin.snoc f x) := by
  intro a ha
  let c : Fin (n + 1) →₀ A := Finsupp.equivFunOnFinite.symm
    (Fin.snoc (fun i ↦ a i.castSucc * y) (a (Fin.last n)))
  have hc : Finsupp.linearCombination A (Fin.snoc f (x * y)) c = 0 := by
    rw [Finsupp.linearCombination_apply, Finsupp.sum_fintype _ _ (by simp),
      Fin.sum_univ_castSucc]
    simp only [c, Finsupp.coe_equivFunOnFinite_symm, Fin.snoc_castSucc, Fin.snoc_last,
      smul_eq_mul]
    rw [Finsupp.linearCombination_apply, Finsupp.sum_fintype _ _ (by simp),
      Fin.sum_univ_castSucc] at ha
    simp only [Fin.snoc_castSucc, Fin.snoc_last, smul_eq_mul] at ha
    have hay := congrArg (fun z ↦ y * z) ha
    rw [mul_zero, mul_add, Finset.mul_sum] at hay
    simpa [mul_assoc, mul_comm, mul_left_comm] using hay
  have hlast := h c hc (Fin.last n)
  have hx : x ∈ Ideal.span (Set.range (Fin.snoc f x)) :=
    Ideal.subset_span ⟨Fin.last n, by simp⟩
  have hspan : Ideal.span (Set.range (Fin.snoc f (x * y))) ≤
      Ideal.span (Set.range (Fin.snoc f x)) := by
    refine Ideal.span_le.2 ?_
    rintro z ⟨i, rfl⟩
    refine Fin.lastCases (by simpa using Ideal.mul_mem_right y _ hx) (fun j ↦ ?_) i
    simpa using Ideal.subset_span
      (show f j ∈ Set.range (Fin.snoc f x) from ⟨j.castSucc, by simp⟩)
  have hlast' : a (Fin.last n) ∈ Ideal.span (Set.range (Fin.snoc f x)) := by
    apply hspan
    simpa [c] using hlast
  obtain ⟨b, hb⟩ := Finsupp.mem_ideal_span_range_iff_exists_finsupp.mp hlast
  let d : Fin (n + 1) →₀ A := Finsupp.equivFunOnFinite.symm
    (Fin.snoc (fun i ↦ a i.castSucc + b i.castSucc * x) (b (Fin.last n) * x))
  have hd : Finsupp.linearCombination A (Fin.snoc f (x * y)) d = 0 := by
    rw [Finsupp.linearCombination_apply, Finsupp.sum_fintype _ _ (by simp),
      Fin.sum_univ_castSucc]
    simp only [d, Finsupp.coe_equivFunOnFinite_symm, Fin.snoc_castSucc, Fin.snoc_last,
      smul_eq_mul, add_mul, Finset.sum_add_distrib]
    rw [Finsupp.sum_fintype _ _ (by simp), Fin.sum_univ_castSucc] at hb
    simp only [Fin.snoc_castSucc, Fin.snoc_last] at hb
    simp only [c, Finsupp.coe_equivFunOnFinite_symm, Fin.snoc_last] at hb
    rw [Finsupp.linearCombination_apply, Finsupp.sum_fintype _ _ (by simp),
      Fin.sum_univ_castSucc] at ha
    simp only [Fin.snoc_castSucc, Fin.snoc_last, smul_eq_mul] at ha
    have hbmul : (∑ i : Fin n, b i.castSucc * x * f i) +
        b (Fin.last n) * x * (x * y) = a (Fin.last n) * x := by
      have hbx := congrArg (fun z ↦ x * z) hb
      rw [mul_add, Finset.mul_sum] at hbx
      simpa [mul_assoc, mul_comm, mul_left_comm] using hbx
    linear_combination ha + hbmul
  intro i
  refine Fin.lastCases hlast' (fun j ↦ ?_) i
  simpa [d] using Ideal.sub_mem _ (hspan (h d hd j.castSucc))
    (Ideal.mul_mem_left _ (b j.castSucc) hx)
