module

public import Mathlib.RingTheory.RingHom.Flat
public import Mathlib.RingTheory.Flat.Equalizer
public import Mathlib.LinearAlgebra.DirectSum.Finsupp
public import Mathlib.LinearAlgebra.TensorProduct.Tower
public import StacksFrontier.AlgebraicGeometry.LocalCohomology.FrobeniusAction.IdealIndependent
public import StacksCore.Tactic.StacksAttribute

/-!
# Independent elements and flat ring maps

A family of elements of a commutative ring is ideal-independent if every finite linear relation
among the elements has all its coefficients in the ideal generated by the family. Such
independence is preserved by a flat ring map.

## Main results

* `isIdealIndependent_map_of_flat` says that the image of an ideal-independent family
  under a flat ring map is ideal-independent.

## Implementation notes

The source writes a finite list `f₁, …, fᵣ`. We use the `Finsupp`-based notion
`IsIdealIndependent`, which makes the result valid for a family indexed by an arbitrary type
and specializes to the source's finite family.

## References

* [Stacks Project, Tag 0EBZ](https://stacks.math.columbia.edu/tag/0EBZ)
-/

@[expose] public section

universe u v w

/-- The image of an element of the span of a family under a ring map lies in the span of the
image family. -/
private lemma map_mem_span_range
    {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    (φ : A →+* B) {ι : Type w} (f : ι → A) {x : A}
    (hx : x ∈ Ideal.span (Set.range f)) :
    φ x ∈ Ideal.span (Set.range (fun i ↦ φ (f i))) := by
  have hx' : φ x ∈ (Ideal.span (Set.range f)).map φ :=
    Ideal.mem_map_of_mem φ hx
  rw [Ideal.map_span, ← Set.range_comp] at hx'
  exact hx'

/-- The image of an ideal-independent family under a flat ring map is ideal-independent. -/
@[stacks 0EBZ]
lemma isIdealIndependent_map_of_flat
    {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    {ι : Type w} (φ : A →+* B) (hφ : RingHom.Flat φ)
    {f : ι → A} (hf : IsIdealIndependent f) :
    IsIdealIndependent (fun i ↦ φ (f i)) := by
  classical
  let : Algebra A B := φ.toAlgebra
  let : Module.Flat A B := hφ
  let L : (ι →₀ A) →ₗ[A] A := Finsupp.linearCombination A f
  let LB : (ι →₀ B) →ₗ[B] B := Finsupp.linearCombination B (fun i ↦ φ (f i))
  let E := TensorProduct.finsuppScalarRight A B B ι
  let T := TensorProduct.AlgebraTensorModule.lTensor B B L
  have hcombine (b : B) (a : ι →₀ A) : L a • b = LB (E (b ⊗ₜ[A] a)) := by
    induction a using Finsupp.induction_linear with
    | zero => simp [L, LB, E]
    | add a a' ha ha' =>
        simp only [map_add, add_smul, TensorProduct.tmul_add, ha, ha']
    | single i r =>
        have hE : E (b ⊗ₜ[A] Finsupp.single i r) = Finsupp.single i (r • b) := by
          ext j
          simp [E, Finsupp.single_apply]
        rw [hE]
        simp only [L, LB, Finsupp.linearCombination_single, Algebra.smul_def, map_mul,
          Algebra.algebraMap_self_apply, ← φ.algebraMap_toAlgebra]
        ring
  have hcompat : (TensorProduct.AlgebraTensorModule.rid A B B).toLinearMap.comp T =
      LB.comp E.toLinearMap := by
    apply LinearMap.ext
    intro x
    induction x with
    | zero => simp
    | add x y hx hy => simpa only [map_add] using congrArg₂ (· + ·) hx hy
    | tmul b a =>
        change L a • b = LB (E (b ⊗ₜ[A] a))
        exact hcombine b a
  intro c hc i
  change LB c = 0 at hc
  let t := E.symm c
  have ht : t ∈ LinearMap.ker T := by
    apply LinearMap.mem_ker.mpr
    apply (TensorProduct.AlgebraTensorModule.rid A B B).injective
    calc
      (TensorProduct.AlgebraTensorModule.rid A B B) (T t) = LB (E t) :=
        congrArg (fun g ↦ g t) hcompat
      _ = 0 := by simpa [t] using hc
  rw [Module.Flat.ker_lTensor_eq B B L] at ht
  obtain ⟨u, hu⟩ := ht
  have hu_mem : ∀ u,
      E (TensorProduct.AlgebraTensorModule.lTensor B B (LinearMap.ker L).subtype u) i ∈
        Ideal.span (Set.range (fun j ↦ φ (f j))) := by
    intro u
    induction u with
    | zero => simp
    | tmul b x =>
        simpa [E, Algebra.smul_def, ← φ.algebraMap_toAlgebra, mul_comm] using
          Ideal.mul_mem_left _ b
            (map_mem_span_range φ f (hf x.1 (LinearMap.mem_ker.mp x.property) i))
    | add u v hu hv =>
        simpa only [map_add, Finsupp.add_apply] using Ideal.add_mem _ hu hv
  simpa [hu, t] using hu_mem u
