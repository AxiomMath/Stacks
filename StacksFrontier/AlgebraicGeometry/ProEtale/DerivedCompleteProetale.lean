module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FreeSheafSections
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FreeSheafSectionsSupplement
public import StacksFrontier.AlgebraicGeometry.ProEtale.AdicCompletionCriterionSliceTesting
public import StacksFrontier.AlgebraicGeometry.ProEtale.AdicQuotientSystemOfSize
public import StacksFrontier.AlgebraicGeometry.ProEtale.ConstructibleComplexes
public import StacksFrontier.AlgebraicGeometry.ProEtale.DerivedCompleteCohomologySliceTesting
public import StacksFrontier.AlgebraicGeometry.ProEtale.DerivedCompleteWeakSerreSliceTesting
public import StacksFrontier.AlgebraicGeometry.ProEtale.WeaklyContractible.ProetaleTestingFamily

/-!
# Derived completeness on the pro-étale site

Let `X` be a scheme and `Λ` a ring. The small pro-étale site `X_proét` has enough weakly
contractible objects in every universe of sections, namely the affine objects whose ring of
global sections is w-contractible (`AlgebraicGeometry.Scheme.ProEt.testingFamily`). The results
of Stacks 099Q and 09BY for sites with enough weakly contractible objects therefore hold for
sheaves of modules over the constant coefficient ring sheaf `\underline{Λ}` on `X_proét`, for
any sheaf of ideals of `\underline{Λ}`:

* an object of `D(X_proét, Λ)` is derived complete exactly when each of its cohomology
  sheaves is (Stacks 099Q (5));
* the derived complete sheaves of modules form a weak Serre subcategory (Stacks 099Q (1));
* a derived complete sheaf of modules `F` with `IF = F` vanishes, if the ideal sheaf is finitely
  generated on sections over the w-contractible affines (Stacks 09BY).

This applies to the ideal sheaf `I·\underline{Λ}` cut out by a finitely generated ideal `I` of
`Λ`: over a w-contractible affine `W` its sections are the ideal generated by `I` in
`Γ(W, \underline{Λ})`. Indeed `I·\underline{Λ}` is locally generated by the global sections given
by generators of `I` (a section is locally a constant `l`, and locally again `l mod I = 0`), and
on `W` locally surjective maps of sheaves are surjective on sections.

## Main definitions

* `AlgebraicGeometry.ProEtale.coefficientSectionsMap`: the ring map `Λ → Γ(V, \underline{Λ})`.
* `AlgebraicGeometry.ProEtale.idealSheafSection`: the global section of `I·\underline{Λ}` given
  by an element of `I`.

## Main results

* `AlgebraicGeometry.ProEtale.isDerivedComplete_iff_homology`: the cohomology criterion.
* `AlgebraicGeometry.ProEtale.derivedCompleteSheaves_isWeakSerreClass`: the weak Serre
  property.
* `AlgebraicGeometry.ProEtale.isZero_of_isDerivedComplete_of_idealPowerProduct_eq_top`: the
  derived Nakayama lemma for sheaves.
* `AlgebraicGeometry.ProEtale.constantCoefficientIdealSheaf_obj_eq_map` and
  `AlgebraicGeometry.ProEtale.fg_constantCoefficientIdealSheaf_obj_of_isAffineWContractible`: the
  sections of `I·\underline{Λ}` over a w-contractible affine.
* `AlgebraicGeometry.ProEtale.isZero_of_isDerivedComplete_of_constantCoefficientIdealSheaf`: the
  derived Nakayama lemma for `I·\underline{Λ}`.

## Implementation notes

The universe of the module sections is `max (u + 1) r w`, that of
`AlgebraicGeometry.ProEtale.constantCoefficientRingedSite`; the general results are stated for
ringed sites `RingedSite.{u, v, max u v w}` and are applied here with the site universes
`u + 1`, `u` and the extra universe `max r w`, which Lean cannot infer from the sections
universe, so they are given explicitly. For a constructible object `K` of `D(X_proét, Λ)` the
first component of `AlgebraicGeometry.ProEtale.IsConstructibleViaDerivedReduction` is the derived
completeness `isDerivedComplete_iff_homology` applies to.

## References

* [Stacks Project, Tag 099Q](https://stacks.math.columbia.edu/tag/099Q)
* [Stacks Project, Tag 09BY](https://stacks.math.columbia.edu/tag/09BY)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u r w

namespace AlgebraicGeometry.ProEtale

attribute [local instance] HasDerivedCategory.standard

-- The universe-polymorphic instance `hasSheafify_proetale_addCommGrpCat` asks instance search to
-- solve `max (u + 1) ?v` against the value universe `max (u + 1) r w` of the modules here, which
-- the universe unifier cannot do; the sheafification it would supply is found without it.
attribute [-instance] AlgebraicGeometry.ProEtale.hasSheafify_proetale_addCommGrpCat

variable (X : Scheme.{u}) (Λ : Type r) [CommRing Λ]
  (J : SheafOfModules.Submodule (SheafOfModules.unit
    ((Stacks.SheafOfModules.Tensor.ringSheaf (constantCoefficientRingedSite.{u, r, w} X Λ).O))))

/-- **Stacks 099Q (5) on `X_proét`.** An object of `D(X_proét, Λ)` is derived complete along a
sheaf of ideals of `\underline{Λ}` exactly when each of its cohomology sheaves is. -/
theorem isDerivedComplete_iff_homology (K : DerivedSheaves.{u, r, w} X Λ) :
    RingedSite.IsDerivedComplete.{u + 1, u, max (u + 1) r w, max r w}
        (constantCoefficientRingedSite.{u, r, w} X Λ) J K ↔
      ∀ p : ℤ, RingedSite.IsDerivedComplete.{u + 1, u, max (u + 1) r w, max r w}
        (constantCoefficientRingedSite.{u, r, w} X Λ) J
        ((DerivedCategory.singleFunctor _ 0).obj
          ((DerivedCategory.homologyFunctor _ p).obj K)) :=
  RingedSite.isDerivedComplete_iff_homology_of_sliceTestingFamily.{u + 1, u, max r w} _ J
    (Scheme.ProEt.testingFamily.{max (u + 1) r w} X) K

/-- **Stacks 099Q (1) on `X_proét`.** The derived complete sheaves of modules over
`\underline{Λ}` form a weak Serre subcategory. -/
theorem derivedCompleteSheaves_isWeakSerreClass :
    ObjectProperty.IsWeakSerreClass
      (fun F : RingedSite.Modules.{u + 1, u, max (u + 1) r w}
          (constantCoefficientRingedSite.{u, r, w} X Λ) =>
        RingedSite.IsDerivedComplete.{u + 1, u, max (u + 1) r w, max r w}
          (constantCoefficientRingedSite.{u, r, w} X Λ) J
          ((DerivedCategory.singleFunctor _ 0).obj F)) :=
  RingedSite.derivedCompleteSheaves_isWeakSerreClass_of_sliceTestingFamily.{u + 1, u, max r w} _
    (Scheme.ProEt.testingFamily.{max (u + 1) r w} X) J

/-- **Stacks 09BY on `X_proét`.** A derived complete sheaf of modules `F` over `\underline{Λ}`
with `IF = F` vanishes, for a sheaf of ideals `I` finitely generated on sections over the affine
objects with w-contractible ring of global sections. -/
theorem isZero_of_isDerivedComplete_of_idealPowerProduct_eq_top
    (hJ : ∀ U : X.ProEt, Scheme.ProEt.IsAffineWContractible U →
      (J.toSubmodule.obj (op U)).FG)
    (F : RingedSite.Modules.{u + 1, u, max (u + 1) r w}
      (constantCoefficientRingedSite.{u, r, w} X Λ))
    (hF : RingedSite.IsDerivedComplete.{u + 1, u, max (u + 1) r w, max r w}
      (constantCoefficientRingedSite.{u, r, w} X Λ) J
      ((DerivedCategory.singleFunctor _ 0).obj F))
    (hJF : RingedSite.idealPowerProductOfSize.{u + 1, u, max r w} _ J F 1 = ⊤) :
    IsZero F :=
  RingedSite.isZero_of_isDerivedComplete_of_idealProduct_eq_top_of_sliceTestingFamily.{u + 1, u,
    max r w} _ (Scheme.ProEt.testingFamily.{max (u + 1) r w} X) J hJ F hF hJF

section IdealSheaf

attribute [local instance] SheafOfModules.hasSheafify_commRingCat
  Stacks.hasSheafCompose_forget₂_commRingCat
  GrothendieckTopology.hasSheafify_addCommGrpCat
  SheafOfModules.wEqualsLocallyBijective_addCommGrpCat

variable (I : Ideal Λ)

/-- The ring map from the coefficients to the sections of `\underline{Λ}` over an object. -/
def coefficientSectionsMap (V : X.ProEt) :
    Λ →+* ((Stacks.SheafOfModules.Tensor.ringSheaf
      (constantCoefficientRingedSite.{u, r, w} X Λ).O)).obj.obj (op V) :=
  ((constantCoefficientRingMap.{u, r, w} X Λ).app (op V)).hom.comp
    (ULift.ringEquiv.{r, max (u + 1) w} (R := Λ)).symm.toRingHom

/-- The sections of `\underline{Λ}` given by the coefficients are compatible with restriction. -/
theorem coefficientSectionsMap_restrict {V V' : X.ProEt} (f : V' ⟶ V) (l : Λ) :
    ((Stacks.SheafOfModules.Tensor.ringSheaf
      (constantCoefficientRingedSite.{u, r, w} X Λ).O)).obj.map f.op
      (coefficientSectionsMap.{u, r, w} X Λ V l) = coefficientSectionsMap.{u, r, w} X Λ V' l :=
  (ConcreteCategory.congr_hom
    ((constantCoefficientRingMap.{u, r, w} X Λ).naturality f.op) (ULift.up l)).symm

/-- Reduction modulo `I` carries the section given by `l` to the section given by `l mod I`. -/
theorem constantCoefficientRingReduction_coefficientSectionsMap (V : X.ProEt) (l : Λ) :
    ((constantCoefficientRingReduction.{u, r, w} X Λ I).hom.app (op V))
      (coefficientSectionsMap.{u, r, w} X Λ V l) =
      coefficientSectionsMap.{u, r, w} X (Λ ⧸ I) V (Ideal.Quotient.mk I l) := by
  have := NatTrans.congr_app (toSheafify_naturality (Scheme.ProEt.topology X)
    ((Functor.const X.ProEtᵒᵖ).map (CommRingCat.ofHom
      ((ULift.ringEquiv.{r, max (u + 1) w} (R := Λ ⧸ I)).symm.toRingHom.comp
        ((Ideal.Quotient.mk I).comp
          (ULift.ringEquiv.{r, max (u + 1) w} (R := Λ)).toRingHom))))) (op V)
  exact (ConcreteCategory.congr_hom this (ULift.up l)).symm

/-- A section of `\underline{Λ}` lies in `I·\underline{Λ}` exactly when its reduction modulo `I`
vanishes. -/
theorem mem_constantCoefficientIdealSheaf_iff (V : X.ProEt)
    (a : ((Stacks.SheafOfModules.Tensor.ringSheaf
      (constantCoefficientRingedSite.{u, r, w} X Λ).O)).obj.obj (op V)) :
    a ∈ (constantCoefficientIdealSheaf.{u, r, w} X Λ I).obj (op V) ↔
      (constantCoefficientRingReduction.{u, r, w} X Λ I).hom.app (op V) a = 0 :=
  SheafOfModules.mem_kerIdeal _ _ a

/-- The section of `\underline{Λ}` given by an element of `I` lies in `I·\underline{Λ}`. -/
theorem coefficientSectionsMap_mem_constantCoefficientIdealSheaf (V : X.ProEt) {l : Λ}
    (hl : l ∈ I) :
    coefficientSectionsMap.{u, r, w} X Λ V l ∈
      (constantCoefficientIdealSheaf.{u, r, w} X Λ I).obj (op V) := by
  rw [mem_constantCoefficientIdealSheaf_iff,
    constantCoefficientRingReduction_coefficientSectionsMap, Ideal.Quotient.eq_zero_iff_mem.mpr hl,
    map_zero]

/-- The global section of the ideal sheaf `I·\underline{Λ}` given by an element of `I`. -/
def idealSheafSection {l : Λ} (hl : l ∈ I) :
    (constantCoefficientIdealSheaf.{u, r, w} X Λ I).toSheafOfModules.sections :=
  PresheafOfModules.sectionsMk
    (fun V => ⟨coefficientSectionsMap.{u, r, w} X Λ V.unop l,
      coefficientSectionsMap_mem_constantCoefficientIdealSheaf X Λ I V.unop hl⟩)
    (fun _ _ f => Subtype.ext (coefficientSectionsMap_restrict X Λ f.unop l))

/-- The value of `idealSheafSection` over `V` is the section of `\underline{Λ}` given by `l`. -/
@[simp]
theorem idealSheafSection_eval {l : Λ} (hl : l ∈ I) (V : X.ProEt) :
    ((idealSheafSection.{u, r, w} X Λ I hl).eval (op V)).1 =
      coefficientSectionsMap.{u, r, w} X Λ V l := rfl

/-- **`I·\underline{Λ}` is locally generated by the generators of `I`.** If `g` generates `I`,
every section of `I·\underline{Λ}` over an object is, on a covering sieve, a linear combination of
the restrictions of the global sections `idealSheafSection` given by the `g k`. Locally the
section comes from a constant `l ∈ Λ`, and locally again `l mod I = 0`, so `l ∈ I`. -/
theorem exists_covering_restrict_mem_span (n : ℕ) (g : Fin n → Λ)
    (hg : Submodule.span Λ (Set.range g) = I) (V : X.ProEt)
    (m : (constantCoefficientIdealSheaf.{u, r, w} X Λ I).toSheafOfModules.val.obj (op V)) :
    ∃ S ∈ Scheme.ProEt.topology X V, ∀ ⦃W : X.ProEt⦄ (f : W ⟶ V), S f →
      (constantCoefficientIdealSheaf.{u, r, w} X Λ I).toSheafOfModules.val.restrictₛₗ f.op m ∈
        Submodule.span (((Stacks.SheafOfModules.Tensor.ringSheaf
            (constantCoefficientRingedSite.{u, r, w} X Λ).O)).obj.obj (op W))
          (Set.range fun k : ULift.{max (u + 1) r w} (Fin n) =>
          (idealSheafSection.{u, r, w} X Λ I
            (hg ▸ Submodule.subset_span ⟨k.down, rfl⟩ : g k.down ∈ I)).eval (op W)) := by
  classical
  obtain ⟨a, ha⟩ := m
  change ((Stacks.SheafOfModules.Tensor.ringSheaf
    (constantCoefficientRingedSite.{u, r, w} X Λ).O)).obj.obj (op V) at a
  have hS1 := Presheaf.imageSieve_mem (Scheme.ProEt.topology X)
    (constantCoefficientRingMap.{u, r, w} X Λ) (U := op V) a
  refine ⟨_, (Scheme.ProEt.topology X).bind_covering hS1 (R := fun V' f
      (hf : (Presheaf.imageSieve (constantCoefficientRingMap.{u, r, w} X Λ) (U := V) a).arrows f) =>
    Presheaf.equalizerSieve (F := (Functor.const X.ProEtᵒᵖ).obj
        (RingCat.of (ULift.{max (u + 1) w} (Λ ⧸ I)))) (X := op V')
      (ULift.up (Ideal.Quotient.mk I (Exists.choose hf).down)) 0) (fun V' f hf => ?_), ?_⟩
  · refine Presheaf.equalizerSieve_mem (Scheme.ProEt.topology X)
      (constantCoefficientRingMap.{u, r, w} X (Λ ⧸ I)) _ _ ?_
    have hl := Exists.choose_spec hf
    rw [map_zero]
    change coefficientSectionsMap.{u, r, w} X (Λ ⧸ I) V'
      (Ideal.Quotient.mk I (Exists.choose hf).down) = 0
    rw [← constantCoefficientRingReduction_coefficientSectionsMap]
    change ((constantCoefficientRingReduction.{u, r, w} X Λ I).hom.app (op V'))
      ((constantCoefficientRingMap.{u, r, w} X Λ).app (op V') (Exists.choose hf)) = 0
    rw [hl]
    refine (ConcreteCategory.congr_hom
      ((constantCoefficientRingReduction.{u, r, w} X Λ I).hom.naturality f.op) _).trans ?_
    rw [ConcreteCategory.comp_apply, (mem_constantCoefficientIdealSheaf_iff X Λ I V a).mp ha,
      map_zero]
  · intro W f hf
    obtain ⟨V', h, f', hf', hh, rfl⟩ := hf
    have hlI : (Exists.choose hf').down ∈ I :=
      Ideal.Quotient.eq_zero_iff_mem.mp (congrArg ULift.down hh)
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun Λ).mp
      (show (Exists.choose hf').down ∈ Submodule.span Λ (Set.range g) by rw [hg]; exact hlI)
    have key : (constantCoefficientIdealSheaf.{u, r, w} X Λ I).toSheafOfModules.val.restrictₛₗ
        (h ≫ f').op ⟨a, ha⟩ = ∑ k : Fin n, coefficientSectionsMap.{u, r, w} X Λ W (c k) •
          (idealSheafSection.{u, r, w} X Λ I
            (hg ▸ Submodule.subset_span ⟨k, rfl⟩ : g k ∈ I)).eval (op W) := by
      refine Subtype.ext ?_
      have h1 : ((Stacks.SheafOfModules.Tensor.ringSheaf
          (constantCoefficientRingedSite.{u, r, w} X Λ).O)).obj.map
          (h ≫ f').op a = coefficientSectionsMap.{u, r, w} X Λ W (Exists.choose hf').down := by
        rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
        exact (congrArg _ (Exists.choose_spec hf').symm).trans
          (coefficientSectionsMap_restrict X Λ h _)
      refine h1.trans ?_
      rw [← hc, map_sum]
      refine (Finset.sum_congr rfl fun k _ => ?_).trans
        (map_sum ((constantCoefficientIdealSheaf.{u, r, w} X Λ I).obj (op W)).subtype _ _).symm
      rw [smul_eq_mul, map_mul]
      rfl
    rw [key]
    exact Submodule.sum_mem _ fun k _ => Submodule.smul_mem _ _
      (Submodule.subset_span ⟨ULift.up k, rfl⟩)

/-- **The sections of `I·\underline{Λ}` over a w-contractible affine.** For a finitely generated
ideal `I` and an affine object `W` of `X_proét` with w-contractible ring of global sections, the
sections of the ideal sheaf `I·\underline{Λ}` over `W` form the ideal generated by `I` in
`Γ(W, \underline{Λ})`. -/
theorem constantCoefficientIdealSheaf_obj_eq_map (W : X.ProEt)
    (hW : Scheme.ProEt.IsAffineWContractible W) (hI : I.FG) :
    (constantCoefficientIdealSheaf.{u, r, w} X Λ I).obj (op W) =
      I.map (coefficientSectionsMap.{u, r, w} X Λ W) := by
  obtain ⟨n, g, hg⟩ := Submodule.fg_iff_exists_fin_generating_family.mp hI
  have := hW.1
  have hgI : ∀ k, g k ∈ I := fun k => hg ▸ Submodule.subset_span ⟨k, rfl⟩
  have hU : ∀ {F G : Sheaf (Scheme.ProEt.topology X) AddCommGrpCat.{max (u + 1) r w}}
      (φ : F ⟶ G), Sheaf.IsLocallySurjective φ → Function.Surjective (φ.hom.app (op W)) :=
    fun φ hφ => Scheme.ProEt.surjective_app_of_isWContractible_of_concrete W hW.2 φ hφ
  have htop := @Stacks.SheafOfModules.span_range_eval_eq_top _ _ (Scheme.ProEt.topology X)
    ((Stacks.SheafOfModules.Tensor.ringSheaf (constantCoefficientRingedSite.{u, r, w} X Λ).O)) _ _
    ((constantCoefficientIdealSheaf.{u, r, w} X Λ I).toSheafOfModules)
    (ULift.{max (u + 1) r w} (Fin n)) _
    (fun k => idealSheafSection.{u, r, w} X Λ I (hgI k.down))
    (exists_covering_restrict_mem_span.{u, r, w} X Λ I n g hg) W hU
  refine le_antisymm (fun a ha => ?_) ((Ideal.map_le_iff_le_comap).mpr fun l hl =>
    coefficientSectionsMap_mem_constantCoefficientIdealSheaf X Λ I W hl)
  have hmem : (⟨a, ha⟩ : (constantCoefficientIdealSheaf.{u, r, w} X Λ I).toSheafOfModules.val.obj
      (op W)) ∈ Submodule.span (((Stacks.SheafOfModules.Tensor.ringSheaf
        (constantCoefficientRingedSite.{u, r, w} X Λ).O)).obj.obj (op W))
        (Set.range fun k : ULift.{max (u + 1) r w} (Fin n) =>
          (idealSheafSection.{u, r, w} X Λ I (hgI k.down)).eval (op W)) := by
    rw [htop]; trivial
  refine Submodule.span_induction (p := fun (x : ↥((constantCoefficientIdealSheaf.{u, r, w}
      X Λ I).obj (op W))) _ => (show ((Stacks.SheafOfModules.Tensor.ringSheaf
        (constantCoefficientRingedSite.{u, r, w} X Λ).O)).obj.obj (op W) from x.1) ∈
          I.map (coefficientSectionsMap.{u, r, w} X Λ W)) ?_ ?_ ?_ ?_ hmem
  · rintro _ ⟨k, rfl⟩
    exact Ideal.mem_map_of_mem _ (hgI k.down)
  · exact zero_mem _
  · intro x y _ _ hx hy
    exact add_mem hx hy
  · intro c x _ hx
    exact Ideal.mul_mem_left _ c hx

/-- **The ideal sheaf `I·\underline{Λ}` is finitely generated on sections over w-contractible
affines**, for a finitely generated ideal `I` of the coefficients. -/
theorem fg_constantCoefficientIdealSheaf_obj_of_isAffineWContractible (hI : I.FG) (W : X.ProEt)
    (hW : Scheme.ProEt.IsAffineWContractible W) :
    ((constantCoefficientIdealSheaf.{u, r, w} X Λ I).toSubmodule.obj (op W)).FG := by
  have h := constantCoefficientIdealSheaf_obj_eq_map X Λ I W hW hI
  exact h ▸ hI.map (coefficientSectionsMap.{u, r, w} X Λ W)

/-- **Stacks 09BY on `X_proét` for the ideal sheaf of an ideal of the coefficients.** A derived
complete sheaf of `\underline{Λ}`-modules `F` with `IF = F`, for a finitely generated ideal `I`
of `Λ`, vanishes. -/
theorem isZero_of_isDerivedComplete_of_constantCoefficientIdealSheaf (hI : I.FG)
    (F : RingedSite.Modules.{u + 1, u, max (u + 1) r w}
      (constantCoefficientRingedSite.{u, r, w} X Λ))
    (hF : RingedSite.IsDerivedComplete.{u + 1, u, max (u + 1) r w, max r w}
      (constantCoefficientRingedSite.{u, r, w} X Λ) (constantCoefficientIdealSheaf.{u, r, w} X Λ I)
      ((DerivedCategory.singleFunctor _ 0).obj F))
    (hIF : RingedSite.idealPowerProductOfSize.{u + 1, u, max r w} _
      (constantCoefficientIdealSheaf.{u, r, w} X Λ I) F 1 = ⊤) :
    IsZero F :=
  isZero_of_isDerivedComplete_of_idealPowerProduct_eq_top X Λ _
    (fun W hW => fg_constantCoefficientIdealSheaf_obj_of_isAffineWContractible X Λ I hI W hW)
    F hF hIF

end IdealSheaf

end AlgebraicGeometry.ProEtale

end
