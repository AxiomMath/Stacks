/-!
# Retractions of étale covers after localization along a closed subscheme

If every faithfully flat étale algebra over a ring admits a retraction, the same is true
after the canonical localization along a closed subscheme of its spectrum.

The ideal generated by the closed subscheme becomes contained in the Jacobson radical of the
localization, so an idempotent cutting out the given étale algebra inside a faithfully flat
étale cover is sent to a unit, hence to `1`. Descending along a finitely generated
subalgebra and the localization that trivializes its generators then turns a retraction over
the quotient ring into one over the localization.

## Main results

* `AlgebraicGeometry.ProEtale.etale_faithfullyFlat_retracts_localizationRing` gives the
  retraction property for the canonical localization along a closed subscheme.

## Implementation notes

The closed subscheme is represented by an arbitrary ideal `I`. Its canonical localization is
`AlgebraicGeometry.ProEtale.localizationRing I 1`, because `D(1) ∩ V(I) = V(I)`. A retraction
is an algebra homomorphism back to the base ring. The common ambient universe of the
quantified étale algebras contains both the original ring and its localization.

## References

* [Stacks Project, Tag 097W](https://stacks.math.columbia.edu/tag/097W)
-/

@[expose] public section

universe u v

namespace AlgebraicGeometry.ProEtale

open scoped TensorProduct

/-- In the localization of `A` at the elements invertible on `V(I)`, the ideal generated by `I`
is contained in the Jacobson radical. -/
@[ega "IV 10.7.3" "partial"]
private theorem localization_ideal_le_jacobson
    (A : Type u) [CommRing A] (I : Ideal A)
    (R : Type u) [CommRing R]
    (M : Submonoid A) [Algebra A R] [IsLocalization M R]
    (hM : ∀ s : A, s ∈ M ↔
      IsUnit (locallyClosedCoordinateMap I 1 s)) :
    Ideal.map (algebraMap A R) I ≤ Ideal.jacobson (⊥ : Ideal R) := by
  rw [Ideal.map_le_iff_le_comap]
  intro i hi
  show algebraMap A R i ∈ Ideal.jacobson (⊥ : Ideal R)
  rw [Ideal.mem_jacobson_bot]
  intro y
  obtain ⟨a, s, rfl⟩ := IsLocalization.exists_mk'_eq M y
  have hi0 : locallyClosedCoordinateMap I 1 i = 0 := by
    simp [locallyClosedCoordinateMap,
      Ideal.Quotient.eq_zero_iff_mem.mpr hi]
  have hn : (s : A) + a * i ∈ M := (hM _).2 (by
    rw [map_add, map_mul, hi0, mul_zero, add_zero]
    exact (hM _).1 s.2)
  have hprod : IsUnit
      ((algebraMap A R i * IsLocalization.mk' R a s + 1) *
        algebraMap A R (s : A)) := by
    have heq : (algebraMap A R i * IsLocalization.mk' R a s + 1) *
        algebraMap A R (s : A) = algebraMap A R ((s : A) + a * i) := by
      rw [add_mul, one_mul, mul_assoc, IsLocalization.mk'_spec]
      simp only [map_add, map_mul]
      ring
    rw [heq]
    exact IsLocalization.map_units R ⟨_, hn⟩
  exact (IsUnit.mul_iff.mp hprod).1

/-- The retraction property for faithfully flat étale algebras in a larger universe gives the
same property for faithfully flat étale algebras in the ring's own universe. -/
private theorem nonempty_algHom_of_ulift
    (A : Type u) [CommRing A]
    (h : ∀ (B : Type max u v) [CommRing B] [Algebra A B] [Algebra.Etale A B]
      [Module.FaithfullyFlat A B], Nonempty (B →ₐ[A] A))
    (B : Type u) [CommRing B] [Algebra A B] [Algebra.Etale A B]
    [Module.FaithfullyFlat A B] :
    Nonempty (B →ₐ[A] A) := by
  let E := ULift.{max u v} B
  let : Algebra A E := ULift.algebra
  let e : B ≃ₐ[A] E :=
    AlgEquiv.ofRingEquiv (R := A) (A₁ := B) (A₂ := E)
      (f := ULift.ringEquiv.symm) (fun _ => rfl)
  let : Algebra.Etale A E := Algebra.Etale.of_equiv e
  let : Module.FaithfullyFlat A E :=
    Module.FaithfullyFlat.of_linearEquiv A B e.toLinearEquiv.symm
  obtain ⟨r⟩ := h E
  exact ⟨r.comp e⟩

/-- A localization of `A` at `M` is a localization of a quotient `A'` of `A`, through which
`A → R` factors, at the image of `M`. -/
private theorem isLocalization_map_of_surjective {A A' R : Type*} [CommRing A] [CommRing A']
    [CommRing R] [Algebra A R] [Algebra A' R] (M : Submonoid A) [IsLocalization M R]
    (π : A →+* A') (hπ : Function.Surjective π)
    (h : ∀ a, algebraMap A' R (π a) = algebraMap A R a) :
    IsLocalization (M.map π) R := by
  rw [isLocalization_iff]
  refine ⟨?_, ?_, ?_⟩
  · rintro ⟨_, a, ha, rfl⟩
    show IsUnit (algebraMap A' R (π a))
    rw [h]
    exact IsLocalization.map_units R ⟨a, ha⟩
  · intro z
    obtain ⟨⟨a, s⟩, hs⟩ := IsLocalization.surj M z
    refine ⟨⟨π a, ⟨π s, s, s.2, rfl⟩⟩, ?_⟩
    show z * algebraMap A' R (π s) = algebraMap A' R (π a)
    rw [h, h]
    exact hs
  · intro x y hxy
    obtain ⟨a, rfl⟩ := hπ x
    obtain ⟨b, rfl⟩ := hπ y
    rw [h, h] at hxy
    obtain ⟨s, hs⟩ := (IsLocalization.eq_iff_exists M R).mp hxy
    refine ⟨⟨π s, s, s.2, rfl⟩, ?_⟩
    show π s * π a = π s * π b
    rw [← map_mul, ← map_mul, hs]

/-- A finitely generated subalgebra of a localization `R` of `A'` at `M'`, with `A' → R`
injective, lifts along the localization `A'[1/d] → R` for some `d ∈ M'`. -/
private theorem exists_away_algHom_of_fg {A' R : Type*} [CommRing A'] [CommRing R] [Algebra A' R]
    (M' : Submonoid A') [IsLocalization M' R] (hinj : Function.Injective (algebraMap A' R))
    {A₀ : Subalgebra A' R} (hA₀ : A₀.FG) :
    ∃ (d : M') (ι : A₀ →ₐ[A'] Localization.Away (d : A')), ∀ x,
      IsLocalization.Away.liftAlgHom (d : A') (f := Algebra.ofId A' R)
        (IsLocalization.map_units R d) (ι x) = x := by
  classical
  obtain ⟨gens, rfl⟩ := hA₀
  obtain ⟨d, hd⟩ := IsLocalization.exist_integer_multiples_of_finset M' gens
  let gT : Localization.Away (d : A') →ₐ[A'] R := IsLocalization.Away.liftAlgHom (d : A')
    (f := Algebra.ofId A' R) (IsLocalization.map_units R d)
  have ud : IsUnit (algebraMap A' (Localization.Away (d : A')) (d : A')) :=
    IsLocalization.Away.algebraMap_isUnit (d : A')
  have hle : Algebra.adjoin A' (gens : Set R) ≤ gT.range := by
    refine Algebra.adjoin_le fun x hx => ?_
    obtain ⟨b, hb⟩ := hd x hx
    have hb' : algebraMap A' R b = gT (algebraMap A' _ (d : A')) * x := by
      rw [gT.commutes]
      simpa [Algebra.smul_def] using hb
    refine ⟨algebraMap A' _ b * ↑ud.unit⁻¹, ?_⟩
    show gT (algebraMap A' _ b * ↑ud.unit⁻¹) = x
    rw [map_mul, gT.commutes, ← IsUnit.unit_inv_map gT ud, hb', mul_right_comm,
      IsUnit.mul_val_inv, one_mul]
  have hinjT : Function.Injective gT :=
    IsLocalization.injective_of_map_algebraMap_zero (M := Submonoid.powers (d : A'))
      (S := Localization.Away (d : A')) (f := gT.toRingHom) fun a ha => by
        have : a = 0 := hinj (by simpa using (gT.commutes a).symm.trans ha)
        simp [this]
  refine ⟨d, (AlgEquiv.ofInjective gT hinjT).symm.toAlgHom.comp (Subalgebra.inclusion hle),
    fun x => ?_⟩
  have := congrArg Subtype.val
    ((AlgEquiv.ofInjective gT hinjT).apply_symm_apply (Subalgebra.inclusion hle x))
  rwa [AlgEquiv.ofInjective_apply] at this

/-- The primes of `A'` coming from `R` also come from `B` when some faithfully flat
`R`-algebra is isomorphic to `R ⊗[T] B`. -/
private theorem range_comap_subset_of_algEquiv {A' T R B C : Type*} [CommRing A'] [CommRing T]
    [CommRing R] [CommRing B] [CommRing C] [Algebra A' T] [Algebra A' R] [Algebra T R]
    [IsScalarTower A' T R] [Algebra T B] [Algebra A' B] [IsScalarTower A' T B]
    [Algebra R C] [Module.FaithfullyFlat R C] (e : C ≃ₐ[R] R ⊗[T] B) :
    Set.range (PrimeSpectrum.comap (algebraMap A' R)) ⊆
      Set.range (PrimeSpectrum.comap (algebraMap A' B)) := by
  rintro _ ⟨qR, rfl⟩
  have hffC : (algebraMap R C).FaithfullyFlat :=
    RingHom.faithfullyFlat_algebraMap_iff.mpr inferInstance
  obtain ⟨qC, hqC⟩ := (RingHom.FaithfullyFlat.iff_flat_and_comap_surjective.mp hffC).2 qR
  let inclL : R →+* R ⊗[T] B := Algebra.TensorProduct.includeLeftRingHom
  let inclR : B →+* R ⊗[T] B := Algebra.TensorProduct.includeRight.toRingHom
  have hTB : inclL.comp (algebraMap T R) = inclR.comp (algebraMap T B) :=
    Algebra.TensorProduct.includeLeftRingHom_comp_algebraMap
  have hmaps : inclR.comp (algebraMap A' B) = inclL.comp (algebraMap A' R) := by
    rw [IsScalarTower.algebraMap_eq A' T B, IsScalarTower.algebraMap_eq A' T R,
      ← RingHom.comp_assoc, ← RingHom.comp_assoc, hTB]
  obtain ⟨qT, hqT⟩ : ∃ qT, PrimeSpectrum.comap inclL qT = qR := by
    refine ⟨PrimeSpectrum.comap e.symm.toRingHom qC, ?_⟩
    rw [← PrimeSpectrum.comap_comp_apply,
      show e.symm.toRingHom.comp inclL = algebraMap R C from RingHom.ext e.symm.commutes, hqC]
  refine ⟨PrimeSpectrum.comap inclR qT, ?_⟩
  rw [← PrimeSpectrum.comap_comp_apply, hmaps, PrimeSpectrum.comap_comp_apply, hqT]

/-- A prime of a quotient `A'` of `A` containing the image of `I` comes from the canonical
localization of `A` along `V(I)`, when `A → localizationRing I 1` factors through `A'`. -/
private theorem mem_range_comap_localizationRing_of_le {A A' : Type u} [CommRing A] [CommRing A']
    (I : Ideal A) [Algebra A' (localizationRing I (1 : A))] (π : A →+* A')
    (hπ : Function.Surjective π)
    (h : (algebraMap A' (localizationRing I (1 : A))).comp π = algebraMap A _)
    (p : PrimeSpectrum A') (hp : I.map π ≤ p.asIdeal) :
    p ∈ Set.range (PrimeSpectrum.comap (algebraMap A' (localizationRing I (1 : A)))) := by
  let pA : PrimeSpectrum A := PrimeSpectrum.comap π p
  have hpA : (I : Set A) ⊆ pA.asIdeal := fun a ha => hp (Ideal.mem_map_of_mem π ha)
  have hloc : pA ∈ Set.range (PrimeSpectrum.comap (algebraMap A (localizationRing I 1))) := by
    rw [localization_comap_range I (1 : A)]
    exact ⟨pA, ⟨hpA, fun h =>
      pA.2.ne_top (Ideal.eq_top_of_isUnit_mem (I := pA.asIdeal) h isUnit_one)⟩,
      specializes_refl pA⟩
  obtain ⟨q, hq⟩ := hloc
  rw [← h, PrimeSpectrum.comap_comp_apply] at hq
  refine ⟨q, PrimeSpectrum.ext (Ideal.comap_injective_of_surjective π hπ ?_)⟩
  simpa [pA] using congrArg PrimeSpectrum.asIdeal hq

/-- If every prime of `A'` containing `J` comes from an étale `A'`-algebra `B`, then finitely
many basic opens `D(f)` with `f ∈ J` cover the primes not coming from `B`. -/
private theorem exists_finset_basicOpen_cover {A' B : Type*} [CommRing A'] [CommRing B]
    [Algebra A' B] [Algebra.Etale A' B] (J : Ideal A')
    (hV : ∀ p : PrimeSpectrum A', J ≤ p.asIdeal →
      p ∈ Set.range (PrimeSpectrum.comap (algebraMap A' B))) :
    ∃ s : Finset J, ∀ p : PrimeSpectrum A',
      p ∉ Set.range (PrimeSpectrum.comap (algebraMap A' B)) →
        ∃ f ∈ s, p ∈ PrimeSpectrum.basicOpen (f : A') := by
  have : Algebra.HasGoingDown A' B := Algebra.HasGoingDown.of_flat
  have hU : IsOpen (Set.range (PrimeSpectrum.comap (algebraMap A' B))) := by
    simpa using (PrimeSpectrum.isOpenMap_comap_of_hasGoingDown_of_finitePresentation
      (R := A') (S := B) (Set.univ : Set (PrimeSpectrum B)) isOpen_univ)
  have hcover : (Set.range (PrimeSpectrum.comap (algebraMap A' B)))ᶜ ⊆
      ⋃ f : J, (PrimeSpectrum.basicOpen (f : A') : Set (PrimeSpectrum A')) := by
    intro p hp
    obtain ⟨f, hfJ, hfp⟩ := Set.not_subset.mp fun hJ => hp (hV p hJ)
    exact Set.mem_iUnion.mpr ⟨⟨f, hfJ⟩, (PrimeSpectrum.mem_basicOpen f p).mpr hfp⟩
  obtain ⟨s, hs⟩ := hU.isClosed_compl.isCompact.elim_finite_subcover
    (fun f : J => (PrimeSpectrum.basicOpen (f : A') : Set (PrimeSpectrum A')))
    (fun _ => PrimeSpectrum.isOpen_basicOpen) hcover
  refine ⟨s, fun p hp => ?_⟩
  obtain ⟨f, hf, hpf⟩ := Set.mem_iUnion₂.mp (hs hp)
  exact ⟨f, hf, hpf⟩

/-- If every prime of `A'` comes from some factor `E j`, then every prime comes from
`Π j, E j`. -/
private theorem comap_surjective_pi {A' ι : Type*} [CommRing A'] (E : ι → Type*)
    [∀ j, CommRing (E j)] [∀ j, Algebra A' (E j)]
    (h : ∀ p : PrimeSpectrum A', ∃ j, p ∈ Set.range (PrimeSpectrum.comap (algebraMap A' (E j)))) :
    Function.Surjective (PrimeSpectrum.comap (algebraMap A' (∀ j, E j))) := by
  intro p
  obtain ⟨j, q, hq⟩ := h p
  refine ⟨PrimeSpectrum.comap (Pi.evalRingHom E j) q, ?_⟩
  rw [← PrimeSpectrum.comap_comp_apply,
    show (Pi.evalRingHom E j).comp (algebraMap A' (∀ j, E j)) = algebraMap A' (E j) from
      RingHom.ext fun _ => rfl, hq]

/-- If `J` generates the unit ideal of every factor `E (some i)`, then `1 - Pi.single none 1`
lies in the extension of `J` to `Π j, E j`. -/
private theorem one_sub_single_mem_map_pi {A' ι : Type*} [CommRing A'] [Finite ι] [DecidableEq ι]
    {J : Ideal A'} (E : Option ι → Type*) [∀ j, CommRing (E j)] [∀ j, Algebra A' (E j)]
    (hE : ∀ i, J.map (algebraMap A' (E (some i))) = ⊤) :
    1 - Pi.single none 1 ∈ J.map (algebraMap A' (∀ j, E j)) := by
  have hJ (j : Option ι) : (J.map (algebraMap A' (∀ j, E j))).map (Pi.evalRingHom E j) =
      J.map (algebraMap A' (E j)) := by
    rw [Ideal.map_map]
    congr 1
  have hpi : J.map (algebraMap A' (∀ j, E j)) =
      Ideal.pi fun j => J.map (algebraMap A' (E j)) := by
    apply (Ideal.piOrderIso (R := E)).injective
    funext j
    show (J.map _).map (Pi.evalRingHom E j) = (Ideal.pi _).map (Pi.evalRingHom E j)
    rw [Ideal.map_evalRingHom_pi, hJ]
  rw [hpi, Ideal.mem_pi]
  rintro (_ | i)
  · simp
  · simp [hE]

/-- A retraction `r` of `D` over `A'` sends an idempotent `e` with `1 - e ∈ J D` to `1` in `R`,
when `J R` lies in the Jacobson radical of `R`. -/
private theorem algebraMap_apply_eq_one_of_idempotent {A' R D : Type*} [CommRing A'] [CommRing R]
    [CommRing D] [Algebra A' R] [Algebra A' D] {J : Ideal A'}
    (hJ : J.map (algebraMap A' R) ≤ Ideal.jacobson ⊥) (r : D →ₐ[A'] A') {e : D}
    (he : e * e = e) (h1e : 1 - e ∈ J.map (algebraMap A' D)) :
    algebraMap A' R (r e) = 1 := by
  have hrJ : r (1 - e) ∈ J := by
    have hm := Ideal.mem_map_of_mem (r : D →+* A') h1e
    rwa [Ideal.map_map, show (r : D →+* A').comp (algebraMap A' D) = RingHom.id A' from
      RingHom.ext r.commutes, Ideal.map_id] at hm
  have hu : IsUnit (algebraMap A' R (r e)) := by
    refine Ideal.isUnit_of_sub_one_mem_jacobson_bot _ ?_
    convert neg_mem (hJ (Ideal.mem_map_of_mem (algebraMap A' R) hrJ)) using 1
    simp
  refine hu.mul_left_cancel ?_
  rw [← map_mul, ← map_mul, he, mul_one]

/-- A retraction of `Π j, E j` over `A'`, where `J` generates the unit ideal of every factor
other than `E none`, gives an `A'`-algebra map `E none → R` when `J R` lies in the Jacobson
radical of `R`. -/
private theorem nonempty_algHom_of_retraction_pi {A' R ι : Type*} [CommRing A'] [CommRing R]
    [Algebra A' R] [Finite ι] [DecidableEq ι] {J : Ideal A'}
    (hJ : J.map (algebraMap A' R) ≤ Ideal.jacobson ⊥)
    (E : Option ι → Type*) [∀ j, CommRing (E j)] [∀ j, Algebra A' (E j)]
    (hE : ∀ i, J.map (algebraMap A' (E (some i))) = ⊤) (r : (∀ j, E j) →ₐ[A'] A') :
    Nonempty (E none →ₐ[A'] R) := by
  have hu := algebraMap_apply_eq_one_of_idempotent hJ r (e := Pi.single none 1)
    (by rw [← Pi.single_mul, mul_one]) (one_sub_single_mem_map_pi E hE)
  have hsc (a : A') : Pi.single none (algebraMap A' (E none) a) =
      Pi.single none 1 * algebraMap A' (∀ j, E j) a := by
    ext j
    cases j <;> simp
  let g : E none →+* R :=
    { toFun b := algebraMap A' R (r (Pi.single none b))
      map_one' := hu
      map_zero' := by simp
      map_add' b c := by simp only [Pi.single_add, map_add]
      map_mul' b c := by simp only [Pi.single_mul, map_mul] }
  have hg (a : A') : g (algebraMap A' (E none) a) = algebraMap A' R a := by
    show algebraMap A' R (r (Pi.single none (algebraMap A' (E none) a))) = _
    rw [hsc, map_mul, map_mul, hu, one_mul, AlgHom.commutes]
    rfl
  exact ⟨{ toRingHom := g, commutes' := hg }⟩

/-- Let `C` be a faithfully flat `R`-algebra isomorphic to `R ⊗[T] B` with `B` étale over `A'`.
If every faithfully flat étale `A'`-algebra has a retraction and `J ⊆ A'` is an ideal whose
primes come from `R` and with `J R` in the Jacobson radical, then `B` maps to `R` over `A'`. -/
private theorem nonempty_algHom_of_tensorProduct {A' : Type u} {T R C : Type*} (B : Type u)
    [CommRing A'] [CommRing T] [CommRing R] [CommRing B] [CommRing C]
    [Algebra A' T] [Algebra A' R] [Algebra T R] [IsScalarTower A' T R]
    [Algebra T B] [Algebra A' B] [IsScalarTower A' T B] [Algebra.Etale A' B]
    [Algebra R C] [Module.FaithfullyFlat R C] (e : C ≃ₐ[R] R ⊗[T] B)
    (hquot : ∀ (D : Type u) [CommRing D] [Algebra A' D] [Algebra.Etale A' D]
      [Module.FaithfullyFlat A' D], Nonempty (D →ₐ[A'] A'))
    {J : Ideal A'} (hJ : J.map (algebraMap A' R) ≤ Ideal.jacobson ⊥)
    (hJR : ∀ p : PrimeSpectrum A', J ≤ p.asIdeal →
      p ∈ Set.range (PrimeSpectrum.comap (algebraMap A' R))) :
    Nonempty (B →ₐ[A'] R) := by
  classical
  obtain ⟨s, hs⟩ := exists_finset_basicOpen_cover J fun p hp =>
    range_comap_subset_of_algEquiv e (hJR p hp)
  let f : s → J := fun i => i.1
  let E : Option s → Type u := fun j =>
    match j with
    | none => B
    | some i => Localization.Away (f i : A')
  let : ∀ j, CommRing (E j) := fun j => by cases j <;> exact inferInstance
  let : ∀ j, Algebra A' (E j) := fun j => by cases j <;> exact inferInstance
  let D := ∀ j : Option s, E j
  let : Algebra.Etale A' D := by
    let : ∀ j, Algebra.Etale A' (E j) := fun j => by
      cases j with
      | none => exact inferInstance
      | some i => exact Algebra.Etale.of_isLocalizationAway (f i : A')
    infer_instance
  have hDspec : Function.Surjective (PrimeSpectrum.comap (algebraMap A' D)) := by
    refine comap_surjective_pi E fun p => ?_
    by_cases hpB : p ∈ Set.range (PrimeSpectrum.comap (algebraMap A' B))
    · exact ⟨none, hpB⟩
    obtain ⟨j, hj, hpj⟩ := hs p hpB
    have hpj' : p ∈ (PrimeSpectrum.basicOpen (j : A') : Set (PrimeSpectrum A')) := hpj
    rw [← PrimeSpectrum.localization_away_comap_range (Localization.Away (j : A'))
      (j : A')] at hpj'
    exact ⟨some ⟨j, hj⟩, hpj'⟩
  have : Module.FaithfullyFlat A' D := RingHom.faithfullyFlat_algebraMap_iff.mp <|
    RingHom.FaithfullyFlat.iff_flat_and_comap_surjective.mpr
      ⟨RingHom.flat_algebraMap_iff.mpr inferInstance, hDspec⟩
  obtain ⟨r⟩ := hquot D
  refine nonempty_algHom_of_retraction_pi hJ E (fun i => ?_) r
  show J.map (algebraMap A' (Localization.Away (f i : A'))) = ⊤
  exact Ideal.eq_top_of_isUnit_mem _
    (Ideal.mem_map_of_mem (algebraMap A' (Localization.Away (f i : A'))) (f i).property)
    (IsLocalization.Away.algebraMap_isUnit (f i : A'))

/-- Let `R` be a localization of `A'` with `A' → R` injective, and `J ⊆ A'` an ideal whose
primes come from `R` and with `J R` in the Jacobson radical. If every faithfully flat étale
`A'`-algebra has a retraction, then so does every faithfully flat étale `R`-algebra. -/
private theorem nonempty_algHom_of_isLocalization {A' R : Type u} [CommRing A'] [CommRing R]
    [Algebra A' R] (M' : Submonoid A') [IsLocalization M' R]
    (hinj : Function.Injective (algebraMap A' R))
    (hquot : ∀ (D : Type u) [CommRing D] [Algebra A' D] [Algebra.Etale A' D]
      [Module.FaithfullyFlat A' D], Nonempty (D →ₐ[A'] A'))
    {J : Ideal A'} (hJ : J.map (algebraMap A' R) ≤ Ideal.jacobson ⊥)
    (hJR : ∀ p : PrimeSpectrum A', J ≤ p.asIdeal →
      p ∈ Set.range (PrimeSpectrum.comap (algebraMap A' R)))
    (C : Type v) [CommRing C] [Algebra R C] [Algebra.Etale R C] [Module.FaithfullyFlat R C] :
    Nonempty (C →ₐ[R] R) := by
  classical
  let : Algebra A' C := ((algebraMap R C).comp (algebraMap A' R)).toAlgebra
  let : IsScalarTower A' R C := IsScalarTower.of_algebraMap_eq' rfl
  obtain ⟨A₀, B₀, hB₀ring, hA₀B₀, hA₀fg, hB₀etale, ⟨eC⟩⟩ :=
    Algebra.Etale.exists_subalgebra_fg (R := A') (A := R) (B := C)
  let : CommRing B₀ := hB₀ring
  let : Algebra A₀ B₀ := hA₀B₀
  let : Algebra.Etale A₀ B₀ := hB₀etale
  obtain ⟨d, iA₀, hiA₀⟩ := exists_away_algHom_of_fg M' hinj hA₀fg
  let T := Localization.Away (d : A')
  let : CommRing T := inferInstance
  let : Algebra A' T := inferInstance
  let : IsLocalization.Away (d : A') T := inferInstance
  let : Algebra.Etale A' T := Algebra.Etale.of_isLocalizationAway (d : A')
  let gT : T →ₐ[A'] R := IsLocalization.Away.liftAlgHom (d : A')
    (f := Algebra.ofId A' R) (IsLocalization.map_units R d)
  let : Algebra A₀ T := iA₀.toRingHom.toAlgebra
  let : Algebra T R := gT.toRingHom.toAlgebra
  let : IsScalarTower A₀ T R := IsScalarTower.of_algebraMap_eq' <|
    RingHom.ext fun x => (hiA₀ x).symm
  let B₁ := TensorProduct A₀ T B₀
  let : CommRing B₁ := inferInstance
  let : Algebra T B₁ := inferInstance
  let : Algebra.Etale T B₁ := inferInstance
  let : Algebra A' B₁ := Algebra.TensorProduct.leftAlgebra
  let : IsScalarTower A' T B₁ := IsScalarTower.of_algebraMap_eq'
    (R := A') (S := T) (A := B₁) (RingHom.ext fun a => rfl)
  let : Algebra.Etale A' B₁ := Algebra.Etale.comp A' T B₁
  let eC' : C ≃ₐ[R] R ⊗[T] B₁ :=
    eC.trans (Algebra.TensorProduct.cancelBaseChange A₀ T R R B₀).symm
  obtain ⟨g⟩ := nonempty_algHom_of_tensorProduct B₁ eC' hquot hJ hJR
  let ψ : R ⊗[T] B₁ →ₐ[R] R := Algebra.TensorProduct.lift (Algebra.ofId R R)
    (AlgHom.extendScalarsOfIsLocalization T (Submonoid.powers (d : A')) g)
    (fun _ _ => .all _ _)
  exact ⟨ψ.comp eC'.toAlgHom⟩

/-- The property that every faithfully flat étale algebra admits a retraction
passes to the canonical localization along any closed subscheme. -/
@[stacks 097W]
theorem etale_faithfullyFlat_retracts_localizationRing
    (A : Type u) [CommRing A]
    (h : ∀ (B : Type max u v) [CommRing B] [Algebra A B] [Algebra.Etale A B]
      [Module.FaithfullyFlat A B], Nonempty (B →ₐ[A] A))
    (I : Ideal A) :
    ∀ (C : Type v) [CommRing C]
      [Algebra (localizationRing I (1 : A)) C]
      [Algebra.Etale (localizationRing I (1 : A)) C]
      [Module.FaithfullyFlat (localizationRing I (1 : A)) C],
      Nonempty (C →ₐ[localizationRing I (1 : A)]
        localizationRing I (1 : A)) := by
  intro C _ _ _ _
  let R := localizationRing I (1 : A)
  let f : A →+* R := algebraMap A R
  let K : Ideal A := RingHom.ker f
  let π : A →+* A ⧸ K := Ideal.Quotient.mk K
  let : Algebra (A ⧸ K) R := (RingHom.kerLift f).toAlgebra
  have hcomp : (algebraMap (A ⧸ K) R).comp π = algebraMap A R := RingHom.ext fun _ => rfl
  let M' : Submonoid (A ⧸ K) := (localizationSubmonoid I (1 : A)).map π
  let : IsLocalization M' R := isLocalization_map_of_surjective
    (localizationSubmonoid I (1 : A)) π Ideal.Quotient.mk_surjective fun _ => rfl
  refine nonempty_algHom_of_isLocalization M' (RingHom.kerLift_injective f)
    (etale_faithfullyFlat_retracts_quotient A
      (fun B _ _ _ _ => nonempty_algHom_of_ulift.{u, v} A h B) K) (J := I.map π) ?_
    (mem_range_comap_localizationRing_of_le I π Ideal.Quotient.mk_surjective hcomp) C
  rw [Ideal.map_map, hcomp]
  exact localization_ideal_le_jacobson A I R (localizationSubmonoid I (1 : A)) fun _ => Iff.rfl

end AlgebraicGeometry.ProEtale

