module

public import Mathlib.AlgebraicGeometry.Sites.Fpqc
public import StacksFrontier.AlgebraicGeometry.ProEtale.BigSmall.Sections
public import StacksFrontier.AlgebraicGeometry.ProEtale.IndEtale.WeaklyEtaleImageCover
public import StacksFrontier.CategoryTheory.Sites.LanSections
public import StacksFrontier.CategoryTheory.Sites.LocalAmalgamation

/-!
# The pullback of a small pro-étale sheaf to the big site is an fpqc sheaf

Let `S` be a scheme of a chosen big pro-étale site and let
`π_S : Sh((Sch/S)_proetale) → Sh(S_proetale)` be the projection of topoi. For a sheaf `F` on the
small pro-étale site of `S`, the value of `π_S⁻¹ F` at `f : T ⟶ S` is `Γ(T_proetale, f_small⁻¹ F)`,
and `π_S⁻¹ F` satisfies the sheaf condition for every fpqc covering of the big pro-étale site
over `S`.

The sheaf `π_S⁻¹ F` is the sheafification of the presheaf `u_p F : T ↦ colim_{T → U} F(U)`, the
colimit running over the arrows from `T` to objects `U` of the small site; the index categories
are cofiltered (Stacks 00X5). So a section of `π_S⁻¹ F` is, locally for the pro-étale topology,
the pullback along an arrow `T → U` of a section of `F` over `U`, and two such pullbacks along the
same arrow agree locally exactly when the sections of `F` agree after restriction along some
factorization `T → U' → U`.

## Main definitions

* `AlgebraicGeometry.ProEtale.BigProetaleOver.fpqcTopology`: the fpqc topology of the big
  pro-étale site over `S`.
* `AlgebraicGeometry.ProEtale.BigProetaleOver.lanToInverseImage`: the canonical map
  `u_p F ⟶ π_S⁻¹ F`, which is locally injective and locally surjective.

## Main results

* `AlgebraicGeometry.ProEtale.BigProetaleOver.eq_of_mem_fpqcTopology` and
  `AlgebraicGeometry.ProEtale.BigProetaleOver.isSheafFor_of_mem_fpqcTopology`: separation and
  gluing for the fpqc topology, for any pro-étale sheaf receiving a locally bijective map from a
  presheaf of the form `u_p F`.
* `AlgebraicGeometry.ProEtale.BigProetaleOver.isSheaf_fpqcTopology_inverseImage_obj`: `π_S⁻¹ F`
  is a sheaf for the fpqc topology.
* `AlgebraicGeometry.ProEtale.bigProetaleInverseImage_sections_and_isSheafFor_fpqc`: the
  description of the sections of `π_S⁻¹ F` together with its sheaf condition for fpqc coverings.

## References

* [Stacks Project, Tag 0F65](https://stacks.math.columbia.edu/tag/0F65)
* [Stacks Project, Tag 00X5](https://stacks.math.columbia.edu/tag/00X5)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.ProEtale

variable (B : BigProetaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

namespace BigProetaleOver

/-- The fpqc topology on the big pro-étale site over `S`: the topology generated by the families
of the site whose underlying families of schemes are fpqc coverings. -/
abbrev fpqcTopology : GrothendieckTopology (BigProetaleOver B S hS) :=
  (Scheme.fpqcPrecoverage.comap (toScheme B S hS)).toGrothendieck

/-- The topology of the big pro-étale site over `S` is generated by the families of the site
whose underlying families of schemes are pro-étale coverings. -/
theorem topology_eq_toGrothendieck :
    topology B S hS = (Scheme.proetalePrecoverage.comap (toScheme B S hS)).toGrothendieck := by
  rw [topology, BigProetaleSite.topology, over_toGrothendieck_eq_toGrothendieck_comap_forget,
    B.precoverage_eq_comap, ← Precoverage.comap_comp]

/-- The pro-étale topology of the big site over `S` is coarser than its fpqc topology. -/
theorem topology_le_fpqcTopology : topology B S hS ≤ fpqcTopology B S hS := by
  rw [topology_eq_toGrothendieck]
  exact Precoverage.toGrothendieck_mono
    (Precoverage.comap_monotone (F := toScheme B S hS)
      Scheme.proetalePrecoverage_le_fpqcPrecoverage)

/-- **An fpqc covering sieve generated by weakly étale morphisms is a pro-étale covering sieve.**
If every arrow of a sieve `D` covering for the fpqc topology factors through an arrow of `D`
whose underlying morphism of schemes is weakly étale, then `D` covers for the pro-étale
topology. -/
theorem mem_topology_of_mem_fpqcTopology {X : BigProetaleOver B S hS} (D : Sieve X)
    (hD : D ∈ fpqcTopology B S hS X)
    (hwe : ∀ ⦃Y : BigProetaleOver B S hS⦄ (f : Y ⟶ X), D f →
      ∃ (Z : BigProetaleOver B S hS) (g : Z ⟶ X) (e : Y ⟶ Z),
        D g ∧ WeaklyEtale ((toScheme B S hS).map g) ∧ e ≫ g = f) :
    D ∈ topology B S hS X := by
  rw [topology_eq_toGrothendieck, Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition]
  rw [Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition] at hD
  obtain ⟨R₀, hR₀, hle⟩ := hD
  refine ⟨fun Y g ↦ D g ∧ WeaklyEtale ((toScheme B S hS).map g), ?_, fun Y g h ↦ h.1⟩
  rw [Precoverage.mem_comap_iff]
  refine Scheme.mem_propQCPrecoverage_of_refinement (Q := @Flat) (R' := R₀.map (toScheme B S hS))
    hR₀ ?_ ?_
  · rintro _ _ ⟨hg⟩
    exact hg.2
  · rintro _ _ ⟨hf⟩
    obtain ⟨Z, g, e, hg, hgwe, rfl⟩ := hwe _ (hle _ _ hf)
    exact ⟨_, _, (toScheme B S hS).map e, Presieve.map.of ⟨hg, hgwe⟩, by simp⟩

/-- For an object `Y` of the big pro-étale site over `S`, the category of arrows from `Y` to
objects of the small pro-étale site of `S` is cofiltered. -/
instance isFiltered_costructuredArrow_smallProetaleInclusion (Y : BigProetaleOver B S hS) :
    IsFiltered (CostructuredArrow (SmallProetale.inclusion B S hS).op (op Y)) := by
  let i := SmallProetale.inclusion B S hS
  have hpb : PreservesLimitsOfShape WalkingCospan i :=
    smallProetaleInclusion_preservesPullbacks B S hS
  have hterm : IsTerminal (i.obj (smallIdentity B S hS)) := by
    simpa [i, SmallProetale.inclusion, smallIdentity] using
      (Over.mkIdTerminal : IsTerminal (Over.mk (𝟙 (⟨S, hS⟩ : B.Scheme))))
  have : HasTerminal (SmallProetale B S hS) := (smallIdentity_isTerminal B S hS).hasTerminal
  have : HasFiniteLimits (SmallProetale B S hS) := hasFiniteLimits_of_hasTerminal_and_pullbacks
  have : PreservesLimitsOfShape (Discrete PEmpty.{1}) i :=
    Functor.preservesLimitsOfShape_pempty_of_isTerminal i (smallIdentity_isTerminal B S hS) hterm
  have : PreservesFiniteLimits i := preservesFiniteLimits_of_preservesTerminal_and_pullbacks i
  have : RepresentablyFlat i := flat_of_preservesFiniteLimits i
  exact IsFiltered.of_equivalence (structuredArrowOpEquivalence i Y)

/-- The underlying morphism of schemes of a morphism of the small pro-étale site is weakly étale:
both its source and its target are weakly étale over `S`. -/
theorem weaklyEtale_toScheme_map_inclusion_map {U' U : SmallProetale B S hS} (a : U' ⟶ U) :
    WeaklyEtale ((toScheme B S hS).map ((SmallProetale.inclusion B S hS).map a)) := by
  have h : (toScheme B S hS).map ((SmallProetale.inclusion B S hS).map a) ≫
      B.inclusion.map U.obj.hom = B.inclusion.map U'.obj.hom := by
    rw [← Over.w a.hom]
    rfl
  have : WeaklyEtale ((toScheme B S hS).map ((SmallProetale.inclusion B S hS).map a) ≫
      B.inclusion.map U.obj.hom) := by
    rw [h]
    exact U'.property
  exact WeaklyEtale.of_comp _ (B.inclusion.map U.obj.hom)

section Sheaf

variable {B S hS} (F : (SmallProetale B S hS)ᵒᵖ ⥤ Type (u + 1))
  {P : (BigProetaleOver B S hS)ᵒᵖ ⥤ Type (u + 1)}
  (η : (SmallProetale.inclusion B S hS).op.lan.obj F ⟶ P)
  [Presheaf.IsLocallyInjective (topology B S hS) η]
  [Presheaf.IsLocallySurjective (topology B S hS) η]

omit [Presheaf.IsLocallySurjective (topology B S hS) η] in
include η in
/-- Two sections of `P` represented by the same arrow `φ`, which agree on an fpqc covering sieve,
agree on a pro-étale covering sieve. -/
private theorem equalizerSieve_lanSection_mem_topology {Z : BigProetaleOver B S hS}
    {U : SmallProetale B S hS} (φ : Z ⟶ (SmallProetale.inclusion B S hS).obj U)
    (t₁ t₂ : F.obj (op U))
    (hE : Presheaf.equalizerSieve (F := P) (X := op Z)
      (η.app _ ((SmallProetale.inclusion B S hS).lanSection F φ t₁))
      (η.app _ ((SmallProetale.inclusion B S hS).lanSection F φ t₂)) ∈ fpqcTopology B S hS Z) :
    Presheaf.equalizerSieve (F := P) (X := op Z)
      (η.app _ ((SmallProetale.inclusion B S hS).lanSection F φ t₁))
      (η.app _ ((SmallProetale.inclusion B S hS).lanSection F φ t₂)) ∈ topology B S hS Z := by
  let u := SmallProetale.inclusion B S hS
  let D : Sieve Z :=
    { arrows := fun Y h ↦ ∃ (U' : SmallProetale B S hS) (χ : Y ⟶ u.obj U') (a : U' ⟶ U),
        χ ≫ u.map a = h ≫ φ ∧ F.map a.op t₁ = F.map a.op t₂
      downward_closed := by
        rintro Y W h ⟨U', χ, a, hχ, ht⟩ k
        exact ⟨U', k ≫ χ, a, by rw [Category.assoc, hχ, Category.assoc], ht⟩ }
  have hDE : D ≤ Presheaf.equalizerSieve (F := P) (X := op Z)
      (η.app _ (u.lanSection F φ t₁)) (η.app _ (u.lanSection F φ t₂)) := by
    rintro Y h ⟨U', χ, a, hχ, ht⟩
    simp only [Presheaf.equalizerSieve_apply]
    rw [← NatTrans.naturality_apply η, ← NatTrans.naturality_apply η, Functor.lanSection_map,
      Functor.lanSection_map, ← hχ, Functor.lanSection_comp_map, Functor.lanSection_comp_map, ht]
  refine (topology B S hS).superset_covering hDE (mem_topology_of_mem_fpqcTopology B S hS D ?_ ?_)
  · refine (fpqcTopology B S hS).transitive hE D fun Y h hh ↦ ?_
    simp only [Presheaf.equalizerSieve_apply] at hh
    rw [← NatTrans.naturality_apply η, ← NatTrans.naturality_apply η, Functor.lanSection_map,
      Functor.lanSection_map] at hh
    obtain ⟨R, hR, hRD⟩ := u.exists_covering_of_lanSection_eq F (topology B S hS) η _ _ _ hh
    refine topology_le_fpqcTopology B S hS Y ((topology B S hS).superset_covering ?_ hR)
    intro W g hg
    obtain ⟨U', ψ, a, hψ, ht⟩ := hRD g hg
    exact ⟨U', ψ, a, by rw [hψ, Category.assoc], ht⟩
  · rintro Y h ⟨U', χ, a, hχ, ht⟩
    refine ⟨pullback φ (u.map a), pullback.fst _ _, pullback.lift h χ hχ.symm,
      ⟨U', pullback.snd _ _, a, pullback.condition.symm, ht⟩, ?_, pullback.lift_fst _ _ _⟩
    have := weaklyEtale_toScheme_map_inclusion_map B S hS a
    exact MorphismProperty.of_isPullback
      ((toScheme B S hS).map_isPullback (IsPullback.of_hasPullback φ (u.map a))).flip this

include η in
/-- **Separation.** A presheaf with a locally bijective map from the pullback presheaf of a
presheaf on the small site, which is a sheaf for the pro-étale topology, is separated for the
fpqc topology: two sections agreeing on an fpqc covering sieve are equal. -/
theorem eq_of_mem_fpqcTopology (hP : Presheaf.IsSheaf (topology B S hS) P)
    {X : BigProetaleOver B S hS} (D : Sieve X) (hD : D ∈ fpqcTopology B S hS X)
    (s₁ s₂ : P.obj (op X)) (h : ∀ ⦃Y : BigProetaleOver B S hS⦄ (f : Y ⟶ X), D f →
      P.map f.op s₁ = P.map f.op s₂) : s₁ = s₂ := by
  let u := SmallProetale.inclusion B S hS
  let E := Presheaf.equalizerSieve (F := P) (X := op X) s₁ s₂
  have hEf : E ∈ fpqcTopology B S hS X := (fpqcTopology B S hS).superset_covering h hD
  have hE : E ∈ topology B S hS X := by
    obtain ⟨L, hL, hLrep⟩ := u.exists_covering_lanSection₂ F (topology B S hS) η s₁ s₂
    refine (topology B S hS).transitive hL E fun Y g hg ↦ ?_
    obtain ⟨U, φ, t₁, t₂, h₁, h₂⟩ := hLrep g hg
    have hpull : E.pullback g = Presheaf.equalizerSieve (F := P) (X := op Y)
        (η.app _ (u.lanSection F φ t₁)) (η.app _ (u.lanSection F φ t₂)) := by
      ext W k
      simp only [Sieve.pullback_apply, Presheaf.equalizerSieve_apply, E,
        op_comp, Functor.map_comp_apply, ← h₁, ← h₂]
    rw [hpull]
    refine equalizerSieve_lanSection_mem_topology F η φ t₁ t₂ ?_
    rw [← hpull]
    exact (fpqcTopology B S hS).pullback_stable g hEf
  rw [isSheaf_iff_isSheaf_of_type] at hP
  exact (hP E hE).isSeparatedFor.ext fun Y f hf ↦ hf

include η in
/-- Let `x` be a compatible family on a sieve `D` of `X`, let
`q : W ⟶ X` be an arrow of `D` with flat underlying morphism of schemes, and suppose that `x q` is
the image of a section represented by an arrow `φ : W ⟶ U` to an object of the small site. Then
the arrows over which `x` has an amalgamation, and whose underlying morphisms of schemes are
weakly étale, generate a sieve whose pullback along `q` is a pro-étale covering sieve. -/
private theorem pullback_generate_mem_topology (hP : Presheaf.IsSheaf (topology B S hS) P)
    {X : BigProetaleOver B S hS} (D : Sieve X) (x : Presieve.FamilyOfElements P D.arrows)
    (hx : x.Compatible) {W : BigProetaleOver B S hS} (q : W ⟶ X) (hq : D q)
    (hqflat : Flat ((toScheme B S hS).map q)) {U : SmallProetale B S hS}
    (φ : W ⟶ (SmallProetale.inclusion B S hS).obj U) (t : F.obj (op U))
    (hxq : x q hq = η.app _ ((SmallProetale.inclusion B S hS).lanSection F φ t)) :
    (Sieve.generate (fun Y (g : Y ⟶ X) ↦ x.amalgamationSieve g ∧
      WeaklyEtale ((toScheme B S hS).map g))).pullback q ∈ topology B S hS W := by
  classical
  let u := SmallProetale.inclusion B S hS
  let K := toScheme B S hS
  let s₀ : P.obj (op (u.obj U)) := η.app _ (u.lanSection F (𝟙 _) t)
  have hφs₀ : x q hq = P.map φ.op s₀ := by
    rw [hxq]
    change _ = P.map φ.op (η.app _ (u.lanSection F (𝟙 _) t))
    rw [← NatTrans.naturality_apply η, Functor.lanSection_map, Category.comp_id]
  let T : BigProetaleOver B S hS := Over.mk (𝟙 (⟨S, hS⟩ : B.Scheme))
  let hT : IsTerminal T := Over.mkIdTerminal
  let Γ := pullback (hT.from (u.obj U)) (hT.from X)
  let prU : Γ ⟶ u.obj U := pullback.fst _ _
  let prX : Γ ⟶ X := pullback.snd _ _
  let φΓ : W ⟶ Γ := pullback.lift φ q (hT.hom_ext _ _)
  have hφΓU : φΓ ≫ prU = φ := pullback.lift_fst _ _ _
  have hφΓX : φΓ ≫ prX = q := pullback.lift_snd _ _ _
  have hΓ := K.map_isPullback (IsPullback.of_hasPullback (hT.from (u.obj U)) (hT.from X))
  have hUwe : WeaklyEtale (K.map (hT.from (u.obj U))) := by
    rw [hT.hom_ext (hT.from _) (u.map ((smallIdentity_isTerminal B S hS).from U))]
    exact weaklyEtale_toScheme_map_inclusion_map B S hS _
  have ha : WeaklyEtale (K.map prX) := MorphismProperty.of_isPullback hΓ hUwe
  have hφ' : K.map φΓ ≫ K.map prX = K.map q := by rw [← K.map_comp, hφΓX]
  obtain ⟨ι, O, U', h, hO, hU', hwe, hsize, hpaff, hfst, hsnd, hbasis⟩ :=
    exists_weaklyEtale_affine_cover_of_flat (K.map prX) (K.map q) (K.map φΓ) hφ'
  have hφflat : Flat (K.map φΓ) := by
    have := flat_hasOfPostcompProperty_weaklyEtale.{u}
    have : Flat (K.map φΓ ≫ K.map prX) := by rwa [hφ']
    exact MorphismProperty.of_postcomp (W' := @WeaklyEtale) _ _ (K.map prX) ha this
  have hU'B : ∀ i, B.Contains (U' i) := fun i ↦
    B.closed_under_proetaleBound Γ.left.property ((hsize i).trans
      (le_max_of_le_right (le_max_of_le_right (Order.le_succ _))))
  let U'C : ι → BigProetaleOver B S hS := fun i ↦
    Over.mk (Y := (⟨U' i, hU'B i⟩ : B.Scheme))
      (ObjectProperty.homMk (h i ≫ B.inclusion.map Γ.hom))
  let hC : ∀ i, U'C i ⟶ Γ := fun i ↦ Over.homMk (ObjectProperty.homMk (h i)) rfl
  have hOB : ∀ i, B.Contains (O i) := fun i ↦
    Scheme.size_lt_of_isOpenImmersion (O i).ι W.left.property
  let OC : ι → BigProetaleOver B S hS := fun i ↦
    Over.mk (Y := (⟨O i, hOB i⟩ : B.Scheme))
      (ObjectProperty.homMk ((O i).ι ≫ B.inclusion.map W.hom))
  let oC : ∀ i, OC i ⟶ W := fun i ↦ Over.homMk (ObjectProperty.homMk (O i).ι) rfl
  let W'C : ι → BigProetaleOver B S hS := fun i ↦ pullback (oC i ≫ φΓ) (hC i)
  let fst : ∀ i, W'C i ⟶ OC i := fun i ↦ pullback.fst _ _
  let snd : ∀ i, W'C i ⟶ U'C i := fun i ↦ pullback.snd _ _
  have hsq : ∀ i, IsPullback (K.map (fst i)) (K.map (snd i)) ((O i).ι ≫ K.map φΓ) (h i) :=
    fun i ↦ K.map_isPullback (IsPullback.of_hasPullback (oC i ≫ φΓ) (hC i))
  have hW'aff : ∀ i, IsAffine (K.obj (W'C i)) := fun i ↦ by
    have := hpaff i
    exact IsAffine.of_isIso (hsq i).isoPullback.hom
  have hfstK : ∀ i, K.map (fst i) = (hsq i).isoPullback.hom ≫ pullback.fst _ _ :=
    fun i ↦ ((hsq i).isoPullback_hom_fst).symm
  have hsndK : ∀ i, K.map (snd i) = (hsq i).isoPullback.hom ≫ pullback.snd _ _ :=
    fun i ↦ ((hsq i).isoPullback_hom_snd).symm
  have hfstwe : ∀ i, WeaklyEtale (K.map (fst i)) := fun i ↦ by
    have := hwe i
    exact MorphismProperty.of_isPullback (hsq i).flip this
  have hsndflat : ∀ i, Flat (K.map (snd i)) := fun i ↦
    MorphismProperty.of_isPullback (hsq i) (by infer_instance)
  have hfstsurj : ∀ i, Surjective (K.map (fst i)) := fun i ↦ by
    have := hfst i
    rw [hfstK]
    infer_instance
  have hsndsurj : ∀ i, Surjective (K.map (snd i)) := fun i ↦ by
    have := hsnd i
    rw [hsndK]
    infer_instance
  let g : ∀ i, U'C i ⟶ X := fun i ↦ hC i ≫ prX
  have hcond : ∀ i, fst i ≫ oC i ≫ φΓ = snd i ≫ hC i := fun i ↦ by
    have := pullback.condition (f := oC i ≫ φΓ) (g := hC i)
    simpa only [fst, snd, Category.assoc] using this
  have hgA : ∀ i, x.amalgamationSieve (g i) := by
    intro i
    refine ⟨P.map (hC i ≫ prU).op s₀, fun Z k hk ↦ ?_⟩
    let E : Sieve Z := (Sieve.generate (Presieve.singleton (snd i))).pullback k
    have hE : E ∈ fpqcTopology B S hS Z := by
      refine (fpqcTopology B S hS).pullback_stable k
        (Precoverage.generate_mem_toGrothendieck ?_)
      rw [Precoverage.mem_comap_iff, Presieve.map_singleton]
      have := hsndsurj i
      have := hW'aff i
      have : IsAffine (K.obj (U'C i)) := hU' i
      exact Scheme.Hom.singleton_mem_propQCPrecoverage (hsndflat i)
    refine eq_of_mem_fpqcTopology F η hP E hE _ _ fun Z' k' hk' ↦ ?_
    obtain ⟨Z'', e, _, ⟨⟩, he⟩ := hk'
    have harr : (e ≫ fst i ≫ oC i) ≫ q = k' ≫ k ≫ g i := by
      simp only [g, Category.assoc, ← hφΓX]
      rw [reassoc_of% (hcond i), ← reassoc_of% he]
    rw [← Functor.map_comp_apply, ← op_comp, ← Functor.map_comp_apply, ← op_comp,
      ← hx.to_sieveCompatible _ _ hk]
    calc P.map ((k' ≫ k) ≫ hC i ≫ prU).op s₀
        = P.map (e ≫ fst i ≫ oC i).op (P.map φ.op s₀) := by
          rw [← Functor.map_comp_apply, ← op_comp, ← he, ← hφΓU]
          simp only [Category.assoc, reassoc_of% (hcond i)]
      _ = P.map (e ≫ fst i ≫ oC i).op (x q hq) := by rw [hφs₀]
      _ = x ((e ≫ fst i ≫ oC i) ≫ q) (D.downward_closed hq _) :=
          (hx.to_sieveCompatible _ _ hq).symm
      _ = x (k' ≫ k ≫ g i) _ := Presieve.FamilyOfElements.congr_arrow x harr _ _
  have hgwe : ∀ i, WeaklyEtale (K.map (g i)) := fun i ↦ by
    have := hwe i
    change WeaklyEtale (h i ≫ K.map prX)
    infer_instance
  have hrange : ∀ i, Set.range (K.map (fst i ≫ oC i)) = (O i : Set (K.obj W)) := fun i ↦ by
    have hcomp : ⇑(K.map (fst i ≫ oC i)) = (O i).ι ∘ K.map (fst i) := by
      funext z
      rw [K.map_comp]
      exact Scheme.Hom.comp_apply _ _ z
    rw [hcomp, Set.range_comp, (hfstsurj i).surj.range_eq, Set.image_univ,
      Scheme.Opens.range_ι]
  have hcov : Sieve.generate (Presieve.ofArrows W'C fun i ↦ fst i ≫ oC i) ∈
      topology B S hS W := by
    rw [topology_eq_toGrothendieck]
    refine Precoverage.generate_mem_toGrothendieck ?_
    rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
    refine Scheme.ofArrows_mem_propQCPrecoverage_of_isBasis _ (fun i ↦ ?_) (fun i ↦ ?_)
      (fun i ↦ ?_) (fun V y hy ↦ ?_)
    · have := hfstwe i
      rw [K.map_comp]
      change WeaklyEtale (K.map (fst i) ≫ (O i).ι)
      infer_instance
    · have := hW'aff i
      infer_instance
    · rw [hrange]
      exact (O i).isOpen
    · obtain ⟨i, hyi, hiV⟩ := hbasis V y hy
      exact ⟨i, by rwa [hrange], by rwa [hrange]⟩
  refine (topology B S hS).superset_covering ?_ hcov
  rw [Sieve.generate_le_iff]
  rintro _ _ ⟨i⟩
  refine ⟨U'C i, snd i, g i, ⟨hgA i, hgwe i⟩, ?_⟩
  simp only [g, Category.assoc, ← hφΓX]
  rw [reassoc_of% (hcond i)]

include η in
/-- **Gluing.** A presheaf with a locally bijective map from the pullback presheaf of a presheaf
on the small site, which is a sheaf for the pro-étale topology, satisfies the sheaf condition for
every fpqc covering sieve. -/
theorem isSheafFor_of_mem_fpqcTopology (hP : Presheaf.IsSheaf (topology B S hS) P)
    {X : BigProetaleOver B S hS} (D : Sieve X) (hD : D ∈ fpqcTopology B S hS X) :
    Presieve.IsSheafFor P D.arrows := by
  classical
  let u := SmallProetale.inclusion B S hS
  let K := toScheme B S hS
  have hsep : ∀ ⦃Y : BigProetaleOver B S hS⦄ (f : Y ⟶ X),
      Presieve.IsSeparatedFor P (D.pullback f).arrows := fun Y f y t₁ t₂ h₁ h₂ ↦
    eq_of_mem_fpqcTopology F η hP _ ((fpqcTopology B S hS).pullback_stable f hD) t₁ t₂
      fun Z g hg ↦ (h₁ g hg).trans (h₂ g hg).symm
  refine Presieve.isSeparatedFor_and_exists_isAmalgamation_iff_isSheafFor.1
    ⟨by simpa using hsep (𝟙 X), fun x hx ↦ ?_⟩
  have hP' : Presieve.IsSheaf (topology B S hS) P := (isSheaf_iff_isSheaf_of_type _ _).1 hP
  refine x.exists_isAmalgamation_of_amalgamationSieve_mem _ hP' hsep hx ?_
  let Rwe : Presieve X := fun Y g ↦ x.amalgamationSieve g ∧ WeaklyEtale (K.map g)
  let Rgood : Presieve X := fun W q ↦ ∃ hq : D q, Flat (K.map q) ∧
    ∃ (U : SmallProetale B S hS) (φ : W ⟶ u.obj U) (t : F.obj (op U)),
      x q hq = η.app _ (u.lanSection F φ t)
  have hgood : Sieve.generate Rgood ∈ fpqcTopology B S hS X := by
    obtain ⟨R₀, hR₀, hle⟩ :=
      (Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition).1 hD
    refine (fpqcTopology B S hS).mem_of_pullback_mem_of_generate
      (Precoverage.generate_mem_toGrothendieck hR₀) _ fun Y f hf ↦ ?_
    have hfflat : Flat (K.map f) := hR₀.2.2 (Presieve.map.of hf)
    obtain ⟨L, hL, hLrep⟩ := u.exists_covering_lanSection F (topology B S hS) η
      (x f (hle _ _ hf))
    rw [topology_eq_toGrothendieck,
      Precoverage.mem_toGrothendieck_iff_of_isStableUnderComposition] at hL
    obtain ⟨L₀, hL₀, hL₀le⟩ := hL
    refine topology_le_fpqcTopology B S hS Y ?_
    rw [topology_eq_toGrothendieck]
    refine (Precoverage.toGrothendieck _).superset_covering ?_
      (Precoverage.generate_mem_toGrothendieck hL₀)
    rw [Sieve.generate_le_iff]
    intro Z k hk
    have hkwe : WeaklyEtale (K.map k) := hL₀.2.2 (Presieve.map.of hk)
    obtain ⟨U, φ, t, hrep⟩ := hLrep k (hL₀le _ _ hk)
    refine Sieve.le_generate Rgood _ (k ≫ f) ⟨D.downward_closed (hle _ _ hf) k, ?_, U, φ, t, ?_⟩
    · rw [K.map_comp]
      infer_instance
    · rw [hx.to_sieveCompatible _ _ (hle _ _ hf), hrep]
  have hwe : Sieve.generate Rwe ∈ topology B S hS X := by
    refine mem_topology_of_mem_fpqcTopology B S hS _ ?_ ?_
    · refine (fpqcTopology B S hS).mem_of_pullback_mem_of_generate hgood _
        fun W q ⟨hq, hqflat, U, φ, t, hxq⟩ ↦ ?_
      exact topology_le_fpqcTopology B S hS W
        (pullback_generate_mem_topology F η hP D x hx q hq hqflat φ t hxq)
    · rintro Y f ⟨Z, e, g, hg, rfl⟩
      exact ⟨Z, g, e, Sieve.le_generate _ _ _ hg, hg.2, rfl⟩
  refine (topology B S hS).superset_covering ?_ hwe
  rw [Sieve.generate_le_iff]
  exact fun Y g hg ↦ hg.1

end Sheaf

section InverseImage

variable {B S hS} (F : Sheaf (SmallProetale.topology B S hS) (Type (u + 1)))

attribute [local instance] IsMorphismOfSites.toIsContinuous in
/-- The inverse image `π_S⁻¹ F` along the projection from the big pro-étale topos is the
sheafification of the pullback presheaf of `F`, the left Kan extension of `F` along the inclusion
of the small pro-étale site. -/
def inverseImageObjIsoSheafify :
    sheafify (topology B S hS) ((SmallProetale.inclusion B S hS).op.lan.obj F.obj) ≅
      ((bigProetaleToSmallProetaleMorphism B S hS).inverseImage.obj F).obj :=
  (sheafToPresheaf _ _).mapIso ((Adjunction.leftAdjointUniq
    (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous
      (SmallProetale.inclusion B S hS) (Type (u + 1))
      (SmallProetale.topology B S hS) (topology B S hS))
    (bigProetaleToSmallProetaleMorphism B S hS).adj).app F)

/-- The canonical map from the pullback presheaf of a sheaf `F` on the small pro-étale site of
`S` to its inverse image `π_S⁻¹ F` along the projection from the big pro-étale topos: the unit of
sheafification. -/
def lanToInverseImage :
    (SmallProetale.inclusion B S hS).op.lan.obj F.obj ⟶
      ((bigProetaleToSmallProetaleMorphism B S hS).inverseImage.obj F).obj :=
  toSheafify (topology B S hS) _ ≫ (inverseImageObjIsoSheafify F).hom

/-- The canonical map `lanToInverseImage F` is locally injective. -/
instance : Presheaf.IsLocallyInjective (topology B S hS) (lanToInverseImage F) := by
  unfold lanToInverseImage
  infer_instance

/-- The canonical map `lanToInverseImage F` is locally surjective. -/
instance : Presheaf.IsLocallySurjective (topology B S hS) (lanToInverseImage F) := by
  unfold lanToInverseImage
  infer_instance

/-- **The inverse image of a small pro-étale sheaf is an fpqc sheaf.** For a sheaf `F` on the
small pro-étale site of `S`, the inverse image `π_S⁻¹ F` along the projection from the big
pro-étale topos is a sheaf for the fpqc topology of the big pro-étale site over `S`. -/
theorem isSheaf_fpqcTopology_inverseImage_obj
    (F : Sheaf (SmallProetale.topology B S hS) (Type (u + 1))) :
    Presheaf.IsSheaf (fpqcTopology B S hS)
      ((bigProetaleToSmallProetaleMorphism B S hS).inverseImage.obj F).obj := by
  rw [isSheaf_iff_isSheaf_of_type]
  intro X D hD
  exact isSheafFor_of_mem_fpqcTopology F.obj (lanToInverseImage F)
    ((bigProetaleToSmallProetaleMorphism B S hS).inverseImage.obj F).property D hD

end InverseImage

end BigProetaleOver

/-- Let `S` be a scheme of a chosen big pro-étale site and let
`π_S : Sh((Sch/S)_proetale) → Sh(S_proetale)` be the projection of topoi. For a sheaf `F` on the
small pro-étale site of `S`:

* the value of `π_S⁻¹ F` at `f : T ⟶ S` is `Γ(T_proetale, f_small⁻¹ F)`, naturally in `F`;
* `π_S⁻¹ F` satisfies the sheaf condition with respect to every fpqc covering of the big
  pro-étale site over `S`. -/
@[stacks 0F65]
theorem bigProetaleInverseImage_sections_and_isSheafFor_fpqc (S : B.Scheme) :
    (∀ (T : B.Scheme) (f : T ⟶ S),
      Nonempty ((bigProetaleToSmallProetaleMorphism B S.obj S.property).inverseImage ⋙
          (sheafSections (BigProetaleOver.topology B S.obj S.property)
            (Type (u + 1))).obj (op (Over.mk f)) ≅
        (smallProetaleMorphism B T S f).inverseImage ⋙
          Sheaf.Γ (SmallProetale.topology B T.obj T.property) (Type (u + 1)))) ∧
    ∀ (F : Sheaf (SmallProetale.topology B S.obj S.property) (Type (u + 1)))
      ⦃X : BigProetaleOver B S.obj S.property⦄ (R : Presieve X),
      R ∈ Scheme.fpqcPrecoverage.comap (BigProetaleOver.toScheme B S.obj S.property) X →
        Presieve.IsSheafFor
          ((bigProetaleToSmallProetaleMorphism B S.obj S.property).inverseImage.obj F).obj R := by
  refine ⟨fun T f ↦ ⟨bigProetaleInverseImageSectionsIso B T S f⟩, fun F X R hR ↦ ?_⟩
  have h := BigProetaleOver.isSheaf_fpqcTopology_inverseImage_obj F
  rw [isSheaf_iff_isSheaf_of_type,
    Precoverage.isSheaf_toGrothendieck_iff_of_isStableUnderBaseChange] at h
  exact h R hR

end AlgebraicGeometry.ProEtale

