module

public import Mathlib.CategoryTheory.ObjectProperty.Ind
public import StacksFrontier.AlgebraicGeometry.ProEtale.Site.Slices
public import StacksFrontier.RingTheory.Etale.FilteredColimit.Basic
public import StacksCore.Tactic.StacksAttribute

/-!
# The affine ind-étale pro-étale site

For an affine scheme `S` in a chosen big pro-étale site, the small pro-étale site of `S` has a
full subcategory on the objects that are affine and whose ring of global sections is ind-étale
over that of `S`. Its coverings are the *finite* small-site coverings by such objects.

This file contains the definitions, together with the one permanence property of ind-étaleness
they need. The substance of Stacks 098X — that restriction of sheaves along the inclusion is an
equivalence — rests on the bounded w-contractible covers of Stacks 0984 and so on the
characterisation of w-contractible rings of Stacks 0982, neither of which is available here;
accordingly no `stacks` attribute is attached.

## Main definitions

* `AlgebraicGeometry.ProEtale.IsAffineIndEtale`: the object property cutting out the affine
  ind-étale objects of the small pro-étale site.
* `AlgebraicGeometry.ProEtale.AffineIndEtaleProetale`: the resulting full subcategory, with its
  inclusion into the small pro-étale site and the functor
  `AlgebraicGeometry.ProEtale.AffineIndEtaleProetale.toScheme` to underlying schemes.
* `AlgebraicGeometry.ProEtale.AffineIndEtaleProetale.topology`: its topology, generated by the
  finite small-site coverings.

## Main results

* `AlgebraicGeometry.ProEtale.indEtale_of_isSplitEpiFactorization`: ind-étaleness of a ring map
  descends along a retraction. This is what makes the property invariant under isomorphism of
  the underlying scheme, and so is what the essential smallness of the site is deduced from.

## Implementation notes

Ind-étaleness of the structure map is expressed on global sections, as the ind-completion of
étaleness in the under category of `Γ(S, ⊤)` in `CommRingCat`; this is the form in which the
lifting results on ind-étale algebras are stated. Finiteness of the index type is imposed on
the covering families rather than on the generated topology.

## References

* [Stacks Project, Tag 098X](https://stacks.math.columbia.edu/tag/098X)
-/

@[expose] public section

open CategoryTheory
open scoped AlgebraicGeometry

universe u

namespace AlgebraicGeometry.ProEtale

/-- An étale ring map is of finite presentation. -/
lemma etale_under_le_finitePresentation {A : CommRingCat.{u}} :
    (fun C : Under A ↦ C.hom.hom.Etale) ≤
      fun C : Under A ↦ C.hom.hom.FinitePresentation := fun _ hC ↦
  (RingHom.Etale.iff_flat_and_formallyUnramified.mp hC).2.2

/-- Ind-étaleness descends along a retraction: if `f : A ⟶ D` becomes ind-étale after
composing with a split monomorphism `s : D ⟶ D'` of `A`-algebras, then `f` is itself
ind-étale. -/
theorem indEtale_of_isSplitEpiFactorization {A D D' : CommRingCat.{u}} (f : A ⟶ D)
    (g : A ⟶ D') (s : D ⟶ D') (r : D' ⟶ D)
    (hgs : g = f ≫ s) (hsr : s ≫ r = 𝟙 D)
    (hg : MorphismProperty.ind.{u} CommRingCat.etale g) :
    MorphismProperty.ind.{u} CommRingCat.etale f := by
  have h₁ : ObjectProperty.ind.{u} (fun C : Under A ↦ C.hom.hom.Etale) (Under.mk g) :=
    (MorphismProperty.ind_iff_ind_underMk g).mp hg
  rw [CommRingCat.ind_under_iff_exists_factorization _ etale_under_le_finitePresentation] at h₁
  apply (MorphismProperty.ind_iff_ind_underMk f).2
  show ObjectProperty.ind.{u} (fun C : Under A ↦ C.hom.hom.Etale) (Under.mk f)
  rw [CommRingCat.ind_under_iff_exists_factorization _ etale_under_le_finitePresentation]
  intro X hX φ
  have hgr : g ≫ r = f := by rw [hgs, Category.assoc, hsr, Category.comp_id]
  let sr : Under.mk f ⟶ Under.mk g := Under.homMk s hgs.symm
  let rr : Under.mk g ⟶ Under.mk f := Under.homMk r hgr
  obtain ⟨E, a, b, hab, hE⟩ := h₁ X hX (φ ≫ sr)
  refine ⟨E, a, b ≫ rr, ?_, hE⟩
  have hsr' : sr ≫ rr = 𝟙 (Under.mk f) := by
    ext x
    simpa [sr, rr] using congrArg (fun q : D ⟶ D => q x) hsr
  calc
    (a ≫ b) ≫ rr = (φ ≫ sr) ≫ rr := by rw [hab]
    _ = φ := by rw [Category.assoc, hsr', Category.comp_id]

variable (B : BigProetaleSite.{u}) (S : B.Scheme)

/-- An object of the small pro-étale site of `S` is *affine ind-étale* when its underlying
scheme is affine and its ring of global sections is ind-étale over that of `S`. -/
abbrev IsAffineIndEtale : ObjectProperty (SmallProetale B S.obj S.property) :=
  fun U ↦ IsAffine U.obj.left.obj ∧
    ObjectProperty.ind.{u} (fun C : Under Γ(S.obj, ⊤) ↦ C.hom.hom.Etale)
      (Under.mk (B.inclusion.map U.obj.hom).appTop)

/-- The affine ind-étale full subcategory of the small pro-étale site of `S`. -/
abbrev AffineIndEtaleProetale := (IsAffineIndEtale B S).FullSubcategory

namespace AffineIndEtaleProetale

/-- The canonical full inclusion into the small pro-étale site. -/
abbrev inclusion : AffineIndEtaleProetale B S ⥤ SmallProetale B S.obj S.property :=
  (IsAffineIndEtale B S).ι

/-- The underlying scheme of an affine ind-étale object. -/
abbrev toScheme : AffineIndEtaleProetale B S ⥤ Scheme.{u} :=
  inclusion B S ⋙ SmallProetale.toScheme B S.obj S.property

/-- Every object of the affine ind-étale site has affine underlying scheme. -/
instance isAffine_left (U : AffineIndEtaleProetale B S) : IsAffine U.obj.obj.left.obj :=
  U.property.1

/-- The map on global sections of an object of the affine ind-étale site is ind-étale. -/
theorem indEtale_appTop (U : AffineIndEtaleProetale B S) :
    ObjectProperty.ind.{u} (fun C : Under Γ(S.obj, ⊤) ↦ C.hom.hom.Etale)
      (Under.mk (B.inclusion.map U.obj.obj.hom).appTop) :=
  U.property.2

/-- A covering of the affine ind-étale site is a finite small-site covering family. -/
abbrev IsCovering (E : Covering (AffineIndEtaleProetale B S)) : Prop :=
  SmallProetale.IsCovering B S.obj S.property
      ⟨(inclusion B S).obj E.1, E.2.map (inclusion B S)⟩ ∧
    Finite E.2.I₀

/-- The precoverage presented by the finite small-site covering families. -/
def precoverage : Precoverage (AffineIndEtaleProetale B S) where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 1} X,
    R = E.presieve₀ ∧ IsCovering B S ⟨X, E⟩}

/-- A presieve on the affine ind-étale site is covering precisely when a finite small-site
covering family presents it. -/
theorem mem_precoverage_iff {X : AffineIndEtaleProetale B S} {R : Presieve X} :
    R ∈ precoverage B S X ↔ ∃ E : PreZeroHypercover.{u + 1} X,
      R = E.presieve₀ ∧ IsCovering B S ⟨X, E⟩ := Iff.rfl

/-- The topology of the affine ind-étale pro-étale site. -/
abbrev topology : GrothendieckTopology (AffineIndEtaleProetale B S) :=
  (precoverage B S).toGrothendieck

end AffineIndEtaleProetale

/-- A fibre product of two affine ind-étale objects over a third is ind-étale over the base
`X`: on global sections the fibre product square is a pushout, so ind-étaleness of one factor
base-changes along the other and composes with it. -/
lemma indEtale_pullback_small {X : B.Scheme} [IsAffine X.obj]
    {U V W : SmallProetale B X.obj X.property}
    (hU : IsAffineIndEtale B X U) (hV : IsAffineIndEtale B X V)
    (hW : IsAffineIndEtale B X W) (f : U ⟶ W) (g : V ⟶ W)
    {P : B.Scheme} [IsAffine P.obj] (pU : P ⟶ U.obj.left) (pV : P ⟶ V.obj.left)
    (hpb : IsPullback pU pV ((SmallProetale.inclusion B X.obj X.property).map f).left
      ((SmallProetale.inclusion B X.obj X.property).map g).left) :
    ObjectProperty.ind.{u} (fun C : Under Γ(X.obj, ⊤) ↦ C.hom.hom.Etale)
      (Under.mk (B.inclusion.map (pV ≫ V.obj.hom)).appTop) := by
  let A := Γ(W.obj.left.obj, ⊤)
  let S := Γ(U.obj.left.obj, ⊤)
  let R := Γ(V.obj.left.obj, ⊤)
  let T := Γ(P.obj, ⊤)
  let f0 := ((SmallProetale.inclusion B X.obj X.property).map f).left
  let g0 := ((SmallProetale.inclusion B X.obj X.property).map g).left
  let fR := (B.inclusion.map f0).appTop
  let gR := (B.inclusion.map g0).appTop
  let f'R := (B.inclusion.map pU).appTop
  let g'R := (B.inclusion.map pV).appTop
  let xW := (B.inclusion.map W.obj.hom).appTop
  let xU := (B.inclusion.map U.obj.hom).appTop
  let xV := (B.inclusion.map V.obj.hom).appTop
  let xP := (B.inclusion.map (pV ≫ V.obj.hom)).appTop
  have _ : IsAffine (B.inclusion.obj X) := ‹IsAffine X.obj›
  have _ : IsAffine (B.inclusion.obj
      ((SmallProetale.inclusion B X.obj X.property).obj W).left) := hW.1
  have _ : IsAffine (B.inclusion.obj
      ((SmallProetale.inclusion B X.obj X.property).obj U).left) := hU.1
  have _ : IsAffine (B.inclusion.obj
      ((SmallProetale.inclusion B X.obj X.property).obj V).left) := hV.1
  have _ : IsAffine (B.inclusion.obj P) := ‹IsAffine P.obj›
  have hpush0 : IsPushout fR gR f'R g'R :=
    isPushout_appTop_of_isPullback (hpb.map B.inclusion)
  have hwf : xW ≫ fR = xU := (congrArg (fun q => (B.inclusion.map q).appTop)
    (Over.w ((SmallProetale.inclusion B X.obj X.property).map f)) :)
  have hUoverW : ObjectProperty.ind.{u}
      (fun C : Under (CommRingCat.of A) ↦ C.hom.hom.Etale) (Under.mk fR) :=
    CommRingCat.ind_etale_of_comp xW fR hW.2 (by rw [hwf]; exact hU.2)
  let _ : Algebra A S := fR.hom.toAlgebra
  let _ : Algebra A R := gR.hom.toAlgebra
  let _ : Algebra S T := f'R.hom.toAlgebra
  let _ : Algebra R T := g'R.hom.toAlgebra
  let _ : Algebra A T := (fR ≫ f'R).hom.toAlgebra
  have hfg : fR ≫ f'R = gR ≫ g'R := by
    simpa [fR, gR, f'R, g'R, f0, g0, Scheme.Hom.comp_appTop] using
      congrArg (fun q => (B.inclusion.map q).appTop) hpb.w
  have _ : IsScalarTower A S T := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun _ => rfl)
  have _ : IsScalarTower A R T := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x =>
    congrArg (fun k : CommRingCat.of A ⟶ CommRingCat.of T => k.hom x) hfg)
  have hofHom : ∀ {M N : CommRingCat.{u}} (k : M ⟶ N),
      letI := k.hom.toAlgebra
      CommRingCat.ofHom (algebraMap M N) = k := fun _ => by ext; rfl
  have _ : Algebra.IsPushout A R S T := CommRingCat.isPushout_iff_isPushout.mp (by
    rw [hofHom, hofHom, hofHom, hofHom]
    exact hpush0.flip)
  have hUalg : (CommAlgCat.etale A).ind (CommAlgCat.of A S) := by
    rwa [CommAlgCat.ind_etale_iff_ind_algebraMap, MorphismProperty.ind_iff_ind_underMk]
  let _ : Algebra Γ(X.obj, ⊤) R := xV.hom.toAlgebra
  let _ : Algebra Γ(X.obj, ⊤) T := xP.hom.toAlgebra
  have hx : xV ≫ g'R = xP := by
    simp only [xV, g'R, xP, Scheme.Hom.comp_appTop, Functor.map_comp]
  have _ : IsScalarTower Γ(X.obj, ⊤) R T := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun x =>
    congrArg (fun k : CommRingCat.of Γ(X.obj, ⊤) ⟶ CommRingCat.of T => k.hom x) hx)
  have hValg : (CommAlgCat.etale Γ(X.obj, ⊤)).ind (CommAlgCat.of Γ(X.obj, ⊤) R) :=
    CommAlgCat.ind_etale_iff_ind_algebraMap.mpr ((MorphismProperty.ind_iff_ind_underMk _).mpr hV.2)
  have hP : CommRingCat.etale.ind (CommRingCat.ofHom (algebraMap Γ(X.obj, ⊤) T)) :=
    CommAlgCat.ind_etale_iff_ind_algebraMap.mp (CommAlgCat.ind_etale_comp hValg
      (CommAlgCat.ind_etale_of_isPushout A R S T hUalg))
  exact (MorphismProperty.ind_iff_ind_underMk (P := CommRingCat.etale) (f := xP)).mp
    (hofHom xP ▸ hP)

end AlgebraicGeometry.ProEtale

end
