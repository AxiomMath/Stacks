/-!
# Specialization to the closed subscheme cut out by an ideal

Let `C` be a commutative ring and `J ⊆ C` an ideal such that every element of `C` whose class
in `C ⧸ J` is a unit is already a unit. Then every point of `Spec C` specializes to a point of
the closed subscheme `Spec (C ⧸ J)`, because an ideal of `C` together with `J` can never
generate the unit ideal.

The lift of an ind-étale algebra across a quotient satisfies that hypothesis for the ideal
generated by the image of the ideal one quotients by, so every point of the spectrum of such a
lift specializes to a point of the closed subscheme it cuts out.

## Main results

* `PrimeSpectrum.exists_specializes_ideal_le` — the specialization statement for an ideal whose
  quotient map reflects units.
* `AlgebraicGeometry.ProEtale.indEtaleQuotientLift_exists_specializes` — every point of the
  spectrum of a lifted ind-étale algebra specializes to a point of the closed subscheme cut out
  by the extended ideal.

## References

* [Stacks Project, Tag 097P](https://stacks.math.columbia.edu/tag/097P)
* [Stacks Project, Tag 09BK](https://stacks.math.columbia.edu/tag/09BK)
-/

@[expose] public section

universe u

namespace PrimeSpectrum

/-- **Specialization into the zero locus of an ideal reflecting units.** If every element of a
commutative ring whose class modulo an ideal `J` is a unit is itself a unit, then every point of
the prime spectrum specializes to a prime containing `J`, that is, to a point of the closed
subscheme cut out by `J`.

Indeed an ideal `p` with `p ⊔ J = ⊤` would write `1 = x + y` with `x ∈ p` and `y ∈ J`, and then
`x` is a unit modulo `J`, hence a unit, contradicting `p ≠ ⊤`. -/
public theorem exists_specializes_ideal_le {C : Type u} [CommRing C] (J : Ideal C)
    (h : ∀ g : C, IsUnit (Ideal.Quotient.mk J g) → IsUnit g) (p : PrimeSpectrum C) :
    ∃ q : PrimeSpectrum C, p ⤳ q ∧ J ≤ q.asIdeal := by
  have hne : p.asIdeal ⊔ J ≠ ⊤ := by
    intro htop
    have h1 : (1 : C) ∈ p.asIdeal ⊔ J := htop ▸ Submodule.mem_top
    obtain ⟨x, hx, y, hy, hxy⟩ := Submodule.mem_sup.mp h1
    have hux : IsUnit x := h x <| by
      rw [show x = 1 - y by linear_combination hxy, map_sub,
        Ideal.Quotient.eq_zero_iff_mem.mpr hy, sub_zero, map_one]
      exact isUnit_one
    exact p.isPrime.ne_top (p.asIdeal.eq_top_of_isUnit_mem hx hux)
  obtain ⟨M, hM, hle⟩ := Ideal.exists_le_maximal _ hne
  refine ⟨⟨M, hM.isPrime⟩, ?_, le_trans le_sup_right hle⟩
  exact (le_iff_specializes p ⟨M, hM.isPrime⟩).mp
    ((asIdeal_le_asIdeal _ _).mp (le_trans le_sup_left hle))

end PrimeSpectrum

namespace AlgebraicGeometry.ProEtale

/-- **Stacks 09BK, specialization to a point of `V`.** Let `A` be a ring, `I ⊆ A` an ideal and
`V` an ind-étale `A ⧸ I`-algebra. Writing `C` for the lift of `V` to an ind-étale `A`-algebra,
so that `v(V) = Spec C` and `V = Spec (C ⧸ I C)` is the closed subscheme of `v(V)` cut out by
the ideal generated by the image of `I`, every point of `v(V)` specializes to a point of `V`. -/
@[stacks 09BK "every point of v(V) specialises to a point of V"]
public theorem indEtaleQuotientLift_exists_specializes (A : Type u) [CommRing A] (I : Ideal A)
    (V : IndEtaleAlgebra (A ⧸ I))
    (p : PrimeSpectrum ((indEtaleQuotientLift A I).obj V).obj.right) :
    ∃ q : PrimeSpectrum ((indEtaleQuotientLift A I).obj V).obj.right, p ⤳ q ∧
      I.map ((indEtaleQuotientLift A I).obj V).obj.hom.hom ≤ q.asIdeal :=
  PrimeSpectrum.exists_specializes_ideal_le _
    (indEtaleQuotientLift_isUnit_of_quotient_isUnit A I V) p

end AlgebraicGeometry.ProEtale

end
