module

public import StacksFrontier.AlgebraicGeometry.ProEtale.Site.AppSitePullback
public import StacksFrontier.AlgebraicGeometry.Topologies.ChangeOfSites.CoverPreserving
public import StacksCore.Tactic.StacksAttribute

/-!
# Continuity of base change on the site of ind-étale affines

For a morphism `i : Z ⟶ X` of affine schemes, the base change functor `u : X_app ⥤ Z_app`,
`U ↦ U ×_X Z`, carries a standard pro-étale covering family of an object of `X_app` to one of
its image, because a base change of a pro-étale covering family is a pro-étale covering family
and the index set does not change. Together with the preservation of fibre products recorded in
`StacksFrontier.AlgebraicGeometry.ProEtale.Site.AppSitePullback` this is continuity of `u` in the
sense of the Stacks Project, and it gives cover preservation for the topologies generated by the
standard covering families. For a closed immersion the left adjoint of base change is therefore
cocontinuous.

## Main results

* `AlgebraicGeometry.ProEtale.appProetaleBaseChange_isCovering` — base change carries a standard
  pro-étale covering family to a standard pro-étale covering family.
* `AlgebraicGeometry.ProEtale.coverPreserving_appProetaleBaseChange` — base change is cover
  preserving for the standard pro-étale topologies.
* `AlgebraicGeometry.ProEtale.appProetaleLift_isCocontinuous` — for a closed immersion of
  affine schemes the left adjoint of base change is cocontinuous.

## Implementation notes

The covering statement is reduced to the corresponding statement for slice pullback on schemes
over an affine scheme, where the base change of each member of the family is a fibre product by
the base-change square of slice objects; the ambient pro-étale precoverage of schemes is stable
under base change, which is what turns the family of squares into a covering family.

Cover preservation is then the general reduction to the generating families, which needs the
fibre products of `X_app` and their preservation by base change. Cocontinuity of the left
adjoint is cover preservation of the right adjoint, by
`CategoryTheory.Adjunction.isCocontinuous_iff_coverPreserving`.

## References

* [Stacks Project, Tag 098X](https://stacks.math.columbia.edu/tag/098X)
* [Stacks Project, Tag 09BK](https://stacks.math.columbia.edu/tag/09BK)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.ProEtale

/-- Slice pullback along `f : T ⟶ S` carries a family of morphisms of schemes over `S` which is
a pro-étale covering family to a pro-étale covering family of schemes over `T`. -/
private lemma mem_proetalePrecoverage_overPullback {S T : Scheme.{u}} (f : T ⟶ S) {Y : Over S}
    (E : PreZeroHypercover.{u + 1} Y)
    (hE : (E.map (Over.forget S)).presieve₀ ∈ Scheme.proetalePrecoverage.coverings Y.left) :
    ((E.map (Over.pullback f)).map (Over.forget T)).presieve₀ ∈
      Scheme.proetalePrecoverage.coverings ((Over.pullback f).obj Y).left := by
  change Presieve.ofArrows (fun j ↦ (E.X j).left) (fun j ↦ (E.f j).left) ∈ _ at hE
  change Presieve.ofArrows (fun j ↦ pullback (E.X j).hom f)
    (fun j ↦ ((Over.pullback f).map (E.f j)).left) ∈
    Scheme.proetalePrecoverage.coverings (pullback Y.hom f)
  refine Precoverage.mem_coverings_of_isPullback (fun j ↦ (E.f j).left) hE
    (pullback.fst Y.hom f) _ (fun j ↦ pullback.fst (E.X j).hom f) (fun j ↦ ?_)
  exact baseChange_square (E.f j).left Y.hom (E.X j).hom f (Over.w (E.f j))

/-- **Stacks 09BK, continuity of the base change functor: coverings.** For a morphism
`i : Z ⟶ X` of affine schemes, the base change functor `U ↦ U ×_X Z` from `X_app` to `Z_app`
carries a standard pro-étale covering family to a standard pro-étale covering family. -/
@[stacks 09BK "the base change functor is continuous"]
public theorem appProetaleBaseChange_isCovering {X Z : Scheme.{u}} [IsAffine X] [IsAffine Z]
    (i : Z ⟶ X) {U : AppSmallProetale X} (E : PreZeroHypercover.{u + 1} U)
    (hE : AppSmallProetale.IsCovering X ⟨U, E⟩) :
    AppSmallProetale.IsCovering Z
      ⟨(appProetaleBaseChange i).obj U, E.map (appProetaleBaseChange i)⟩ := by
  refine ⟨?_, hE.2⟩
  have h1 := hE.1
  rw [Scheme.ProEt.precoverage, Precoverage.mem_comap_iff,
    ← PreZeroHypercover.presieve₀_map] at h1 ⊢
  exact mem_proetalePrecoverage_overPullback i
    (E.map (AppSmallProetale.inclusion X ⋙ Scheme.ProEt.forget X)) h1

/-- **Base change is cover preserving.** For a morphism `i : Z ⟶ X` of affine schemes the base
change functor `U ↦ U ×_X Z` carries a covering sieve of the standard pro-étale topology on
`X_app` to a covering sieve of the standard pro-étale topology on `Z_app`. -/
public theorem coverPreserving_appProetaleBaseChange {X Z : Scheme.{u}} [IsAffine X]
    [IsAffine Z] (i : Z ⟶ X) :
    CoverPreserving (AppSmallProetale.topology X) (AppSmallProetale.topology Z)
      (appProetaleBaseChange i) := by
  apply coverPreserving_of_generators (appProetaleBaseChange i) (AppSmallProetale.precoverage X)
    (AppSmallProetale.topology Z)
  rintro U _ ⟨E, rfl, hE⟩
  rw [← PreZeroHypercover.sieve₀_map]
  exact Precoverage.generate_mem_toGrothendieck
    ⟨E.map (appProetaleBaseChange i), rfl, appProetaleBaseChange_isCovering i E hE⟩

/-- **Stacks 09BK, cocontinuity of the left adjoint.** For a closed immersion `i : Z ⟶ X` of
affine schemes the left adjoint `v : Z_app ⥤ X_app` of the base change functor is cocontinuous:
it pulls covering sieves back to covering sieves. -/
@[stacks 09BK "the functor v is cocontinuous"]
public theorem appProetaleLift_isCocontinuous {X Z : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] [IsAffine X] [IsAffine Z] :
    (appProetaleLift i).IsCocontinuous (AppSmallProetale.topology Z)
      (AppSmallProetale.topology X) := by
  obtain ⟨adj⟩ := appProetaleBaseChange_hasLeftAdjoint i
  exact (adj.isCocontinuous_iff_coverPreserving _ _).mpr
    (coverPreserving_appProetaleBaseChange i)

end AlgebraicGeometry.ProEtale

end
