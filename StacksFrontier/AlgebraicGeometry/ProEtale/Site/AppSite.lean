module

public import Mathlib.AlgebraicGeometry.Sites.Proetale
public import Mathlib.CategoryTheory.Sites.DenseSubsite.Basic
public import StacksFrontier.AlgebraicGeometry.ProEtale.Site.AffineCoversTop
public import StacksFrontier.AlgebraicGeometry.ProEtale.SiteFunctoriality.AffineDenseSubsite
public import StacksFrontier.RingTheory.Etale.IndEtaleUniverse
public import StacksCore.Tactic.StacksAttribute

/-!
# The site of ind-étale affine objects over an affine base

For an affine scheme `S`, the objects `U` of the small pro-étale site of `S` which are affine
and whose ring of global sections is ind-étale over that of `S` form a full subcategory, the
site `S_app` of the Stacks Project. It carries the topology generated by the standard finite
pro-étale covering families, exactly as the larger site of all affine objects does.

## Main definitions

* `AlgebraicGeometry.ProEtale.IsAppSmall` — the object property cutting out `S_app`.
* `AlgebraicGeometry.ProEtale.AppSmallProetale` — the full subcategory it defines.
* `AlgebraicGeometry.ProEtale.AppSmallProetale.inclusion` and
  `AlgebraicGeometry.ProEtale.AppSmallProetale.toAffine` — the inclusions into the small pro-étale
  site and into the site of all affine objects.
* `AlgebraicGeometry.ProEtale.AppSmallProetale.precoverage` and
  `AlgebraicGeometry.ProEtale.AppSmallProetale.topology` — the standard finite pro-étale covering
  families of such objects, and the topology they generate.

* `AlgebraicGeometry.ProEtale.AppSmallProetale.HasAppCover` — the property that every affine object
  of the small pro-étale site of `S` is covered by a single object of `S_app`.

## Main results

* `AlgebraicGeometry.ProEtale.AppSmallProetale.topology_le_restrictedTopology` — the standard
  pro-étale topology on `S_app` is contained in the topology restricted along the inclusion
  into the small pro-étale site.
* `AlgebraicGeometry.ProEtale.AppSmallProetale.equalizerSieve_mem` and
  `AlgebraicGeometry.ProEtale.AppSmallProetale.imageSieve_mem` — the two full-faithfulness
  conditions of `CategoryTheory.Functor.isDenseSubsite_of_isCocontinuous` for that inclusion.
* `AlgebraicGeometry.ProEtale.AppSmallProetale.isCoverDense_of_hasAppCover` — granted
  `HasAppCover`, the inclusion of `S_app` is cover dense.
* `AlgebraicGeometry.ProEtale.AppSmallProetale.isDenseSubsite_of_isCoverDense_of_isCocontinuous` —
  granted cover density and cocontinuity, the inclusion of `S_app` exhibits it as a dense
  subsite; `CategoryTheory.Functor.IsDenseSubsite.sheafEquiv` turns this into the equivalence
  of topoi with restriction of sheaves as its inverse.

## Implementation notes

Ind-étaleness of `𝒪(S) → 𝒪(U)` is `StacksDraft.IndEtale` taken for the algebra structure
`Scheme.Hom.appTop` of the structure morphism of `U`; the instance is supplied explicitly
rather than by `letI`, so that the object property is a bare `Prop` with no local data. The
base `S` is not assumed affine; `Γ(S, ⊤)` makes sense regardless, and affineness of `S` enters
only through `HasAppCover`.

The ambient site is `AlgebraicGeometry.Scheme.ProEt`, the small pro-étale site of `S` with no
size restriction, matching the site of all affine objects in
`StacksFrontier.AlgebraicGeometry.ProEtale.SiteFunctoriality.AffineDenseSubsite`.

Cover density is reduced to `HasAppCover` by covering an arbitrary object with its affine
opens, which are affine objects of the small pro-étale site because a Zariski covering is a
pro-étale covering.

## References

* [Stacks Project, Tag 098X](https://stacks.math.columbia.edu/tag/098X)
* [Stacks Project, Tag 097Z](https://stacks.math.columbia.edu/tag/097Z)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.ProEtale

variable (S : Scheme.{u})

/-- The objects of the small pro-étale site of `S` which are affine and whose ring of global
sections is ind-étale over that of `S`. For `S` affine these are the objects of the site
`S_app` of the Stacks Project. -/
public def IsAppSmall : ObjectProperty S.ProEt := fun X ↦
  IsAffine X.left ∧
    @StacksDraft.IndEtale Γ(S, ⊤) Γ(X.left, ⊤) _ _ X.hom.appTop.hom.toAlgebra

/-- An object of `S_app` is an affine object of the small pro-étale site. -/
public theorem isAppSmall_le_isAffineSmall : IsAppSmall S ≤ IsAffineSmall S :=
  fun _ h ↦ h.1

/-- The full subcategory `S_app` of affine objects of the small pro-étale site of `S` with
ind-étale ring of global sections. -/
public abbrev AppSmallProetale := (IsAppSmall S).FullSubcategory

namespace AppSmallProetale

/-- The full inclusion of `S_app` into the small pro-étale site of `S`. -/
public abbrev inclusion : AppSmallProetale S ⥤ S.ProEt :=
  (IsAppSmall S).ι

/-- The full inclusion of `S_app` into the site of all affine objects of the small pro-étale
site of `S`. -/
public abbrev toAffine : AppSmallProetale S ⥤ AffineProetale S :=
  ObjectProperty.ιOfLE (isAppSmall_le_isAffineSmall S)

/-- The inclusion of `S_app` into the small pro-étale site factors through the site of all
affine objects. -/
public theorem toAffine_comp_ι :
    toAffine S ⋙ AffineProetale.inclusion S = inclusion S :=
  rfl

/-- Standard finite pro-étale covering families of objects of `S_app`. -/
public abbrev IsCovering (E : Covering (AppSmallProetale S)) : Prop :=
  (E.2.map (inclusion S)).presieve₀ ∈ Scheme.ProEt.precoverage S E.1.obj ∧
    Finite E.2.I₀

/-- Precoverage of `S_app` by standard finite pro-étale covering families. -/
public def precoverage : Precoverage (AppSmallProetale S) where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 1} X,
    R = E.presieve₀ ∧ IsCovering S ⟨X, E⟩}

/-- The standard pro-étale topology on `S_app`. -/
public abbrev topology : GrothendieckTopology (AppSmallProetale S) :=
  (precoverage S).toGrothendieck

/-- A standard pro-étale covering family of an object of `S_app` generates a covering sieve of
the small pro-étale site of `S`. -/
public theorem precoverage_le_comap :
    precoverage S ≤ ((Scheme.ProEt.topology S).toPrecoverage).comap (inclusion S) := by
  intro X R hR
  obtain ⟨E, hEq, hE⟩ := hR
  rw [Precoverage.mem_comap_iff, hEq, ← PreZeroHypercover.presieve₀_map,
    GrothendieckTopology.mem_toPrecoverage_iff]
  exact Precoverage.generate_mem_toGrothendieck hE.1

/-- The standard pro-étale topology on `S_app` is contained in the topology restricted from the
small pro-étale site of `S` along the inclusion. -/
public theorem topology_le_restrictedTopology :
    topology S ≤ (inclusion S).restrictedTopology (Scheme.ProEt.topology S) :=
  Precoverage.toGrothendieck_mono (precoverage_le_comap S)

/-- The faithfulness condition of `CategoryTheory.Functor.isDenseSubsite_of_isCocontinuous`
for the inclusion of `S_app`: two morphisms with equal images already agree, so their
equalizer sieve is the whole sieve. -/
public theorem equalizerSieve_mem {U' U : AppSmallProetale S} (a b : U' ⟶ U)
    (h : (inclusion S).map a = (inclusion S).map b) :
    Sieve.equalizer a b ∈ topology S U' := by
  have : a = b := (inclusion S).map_injective h
  subst this
  simp

/-- The fullness condition of `CategoryTheory.Functor.isDenseSubsite_of_isCocontinuous` for the
inclusion of `S_app`: every morphism between images comes from a morphism of `S_app`, so its
image sieve is the whole sieve. -/
public theorem imageSieve_mem {U' U : AppSmallProetale S}
    (f : (inclusion S).obj U' ⟶ (inclusion S).obj U) :
    (inclusion S).imageSieve f ∈ topology S U' := by
  rw [← (inclusion S).map_preimage f, Functor.imageSieve_map]
  exact (topology S).top_mem U'

/-- Every affine object of the small pro-étale site of `S` admits a pro-étale covering by a
single object of `S_app`.

For `S` affine this is the geometric form of the structure theorem for weakly étale ring maps
(Stacks 097Z): if `𝒪(S) → 𝒪(X)` is weakly étale there is a faithfully flat ind-étale
`𝒪(X) → B` with `𝒪(S) → B` ind-étale, and `Spec B → X` is such a covering. -/
public def HasAppCover : Prop :=
  ∀ X : S.ProEt, IsAffineSmall S X →
    ∃ (Y : AppSmallProetale S) (f : (inclusion S).obj Y ⟶ X),
      Presieve.ofArrows (fun _ : Unit ↦ (inclusion S).obj Y) (fun _ ↦ f) ∈
        Scheme.ProEt.precoverage S X

variable {S}

/-- **Cover density of `S_app`.** Granted that every affine object of the small pro-étale site
of `S` is covered by an object of `S_app`, the inclusion of `S_app` is cover dense: every object
of the small pro-étale site of `S` is covered by objects of `S_app`.

Every object is covered by its affine opens, which are affine objects of the small pro-étale
site, and each of those is covered by an object of `S_app` by hypothesis. -/
public theorem isCoverDense_of_hasAppCover (h : HasAppCover S) :
    (inclusion S).IsCoverDense (Scheme.ProEt.topology S) := by
  refine ⟨fun X ↦ ?_⟩
  let G := inclusion S
  let K := Scheme.ProEt.topology S
  let E : PreZeroHypercover X := {
    I₀ := X.left.affineCover.I₀
    X i := Scheme.ProEt.mk (X.left.affineCover.f i ≫ X.hom)
    f i := MorphismProperty.Over.homMk (X.left.affineCover.f i) (by
      rw [Scheme.ProEt.mk_hom]; rfl)
  }
  have hmap : E.map (Scheme.ProEt.forget S ⋙ Over.forget S) =
      X.left.affineCover.toPreZeroHypercover := by
    apply PreZeroHypercover.ext rfl
    all_goals simp [E, Scheme.ProEt.forget, MorphismProperty.Over.forget,
      MorphismProperty.Comma.forget, Over.forget, Scheme.ProEt.mk]
  have hE : E.presieve₀ ∈ Scheme.ProEt.precoverage S X := by
    rw [Scheme.ProEt.precoverage, Precoverage.mem_comap_iff,
      ← PreZeroHypercover.presieve₀_map]
    show (E.map (Scheme.ProEt.forget S ⋙ Over.forget S)).presieve₀ ∈
      Scheme.proetalePrecoverage X.left
    rw [hmap]
    exact zariskiPrecoverage_le_proetalePrecoverage X.left X.left.affineCover.mem₀
  refine K.transitive (Precoverage.generate_mem_toGrothendieck hE) _ ?_
  intro Z g hg
  obtain ⟨W, i, p, hp, rfl⟩ := hg
  obtain ⟨j⟩ := hp
  obtain ⟨Y, q, hq⟩ := h (E.X j)
    (show IsAffine (X.left.affineCover.X j) from inferInstance)
  have hY : Sieve.generate (Presieve.ofArrows (fun _ : Unit ↦ G.obj Y) (fun _ ↦ q)) ∈
      K (E.X j) := Precoverage.generate_mem_toGrothendieck hq
  have hle : Sieve.generate (Presieve.ofArrows (fun _ : Unit ↦ G.obj Y) (fun _ ↦ q)) ≤
      (Sieve.coverByImage G X).pullback (E.f j) := by
    rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
    intro _
    exact Presieve.in_coverByImage G (q ≫ E.f j)
  have hpb := K.pullback_stable i (K.superset_covering hle hY)
  rwa [← Sieve.pullback_comp] at hpb

variable (S)

/-- **The reduction of Stacks 098X to cover density and cocontinuity.** Granted that the
inclusion of `S_app` into the small pro-étale site of `S` is cover dense and cocontinuous, it
exhibits `S_app` as a dense subsite; `CategoryTheory.Functor.IsDenseSubsite.sheafEquiv` turns
this into an equivalence of topoi with restriction of sheaves as its inverse.

The two remaining hypotheses are the only content of Stacks 098X beyond the definitions: the
other three conditions of Stacks 03A0 hold because the inclusion is fully faithful and because
a standard pro-étale covering family is a pro-étale covering family. -/
public theorem isDenseSubsite_of_isCoverDense_of_isCocontinuous
    (hd : (inclusion S).IsCoverDense (Scheme.ProEt.topology S))
    (hc : (inclusion S).IsCocontinuous (topology S) (Scheme.ProEt.topology S)) :
    (inclusion S).IsDenseSubsite (topology S) (Scheme.ProEt.topology S) := by
  let : (inclusion S).IsCoverDense (Scheme.ProEt.topology S) := hd
  let : (inclusion S).IsCocontinuous (topology S) (Scheme.ProEt.topology S) := hc
  have hpres : CoverPreserving (topology S) (Scheme.ProEt.topology S) (inclusion S) := by
    constructor
    intro U T hT
    rw [← Functor.mem_restrictedTopology_iff]
    exact topology_le_restrictedTopology S U hT
  exact Functor.isDenseSubsite_of_isCocontinuous (inclusion S) _ _ hpres
    (fun _ _ a b hab ↦ equalizerSieve_mem S a b hab) (fun _ _ f ↦ imageSieve_mem S f)

end AppSmallProetale

end AlgebraicGeometry.ProEtale

end
