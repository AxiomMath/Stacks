module

public import Mathlib.AlgebraicGeometry.Sites.Proetale
public import Mathlib.CategoryTheory.Sites.Over
public import StacksFrontier.AlgebraicGeometry.ProEtale.Site.Big
public import StacksCore.Tactic.StacksAttribute

/-!
# Pro-étale sites of a scheme

For a chosen big pro-étale site containing a scheme, its slice is the big pro-étale site over
that scheme. The small and affine sites are full subcategories of this slice, carrying the
induced covering families.

## Main definitions

* `AlgebraicGeometry.ProEtale.BigProetaleOver` is the slice of a chosen big site over a scheme.
* `AlgebraicGeometry.ProEtale.SmallProetale` restricts that slice to weakly étale structure
  morphisms.
* `AlgebraicGeometry.ProEtale.BigAffineProetale` restricts it to affine source schemes.
* `AlgebraicGeometry.Scheme.ProEt` is the unrestricted small pro-étale category.

## Main results

The covering predicates and the precoverages below specify the respective covering families.

## Implementation notes

The unrestricted small category and its precoverage are adopted from Mathlib. The
chosen big site need not contain every weakly étale scheme over its base, so its
small site is also represented as a full subcategory of its slice. The localized
big topology is Mathlib's canonical `CategoryTheory.GrothendieckTopology.over`. A covering in
the affine subcategory is a chosen big covering with a finite index type;
affineness of all its schemes follows from membership in that subcategory, and
weak étaleness and joint surjectivity follow from the ambient pro-étale covering.

## References

* [Stacks Project, Tag 098K](https://stacks.math.columbia.edu/tag/098K)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry.ProEtale

add_to_stacks 098K "small-site coverings" AlgebraicGeometry.Scheme.ProEt.precoverage

variable (B : BigProetaleSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- The big pro-étale category over `S` in the chosen big site. -/
@[stacks 098K "part (1), category"]
abbrev BigProetaleOver := Over (⟨S, hS⟩ : B.Scheme)

namespace BigProetaleOver

/-- Forget the morphism to `S`. -/
abbrev forget : BigProetaleOver B S hS ⥤ B.Scheme := Over.forget (⟨S, hS⟩ : B.Scheme)

/-- The underlying scheme of an object over `S`. -/
abbrev toScheme : BigProetaleOver B S hS ⥤ Scheme.{u} := forget B S hS ⋙ B.inclusion

/-- A covering in the slice is a covering of the chosen big site. -/
@[stacks 098K "part (1), coverings"]
abbrev IsCovering (E : Covering (BigProetaleOver B S hS)) : Prop :=
  B.covering ⟨(forget B S hS).obj E.1, E.2.map (forget B S hS)⟩

/-- The localized topology of the chosen big site. -/
abbrev topology : GrothendieckTopology (BigProetaleOver B S hS) :=
  B.topology.over (⟨S, hS⟩ : B.Scheme)

end BigProetaleOver

/-- Objects of the chosen big site over `S` with weakly étale structure morphism. -/
abbrev IsWeaklyEtaleOver : ObjectProperty (BigProetaleOver B S hS) :=
  fun X ↦ WeaklyEtale (B.inclusion.map X.hom)

/-- The small pro-étale category in the chosen big site. -/
@[stacks 098K "part (2), category in a chosen big site"]
abbrev SmallProetale := (IsWeaklyEtaleOver B S hS).FullSubcategory

namespace SmallProetale

/-- The canonical full inclusion into the big category over `S`. -/
abbrev inclusion : SmallProetale B S hS ⥤ BigProetaleOver B S hS :=
  (IsWeaklyEtaleOver B S hS).ι

/-- The underlying scheme of a small pro-étale object. -/
abbrev toScheme : SmallProetale B S hS ⥤ Scheme.{u} :=
  inclusion B S hS ⋙ BigProetaleOver.toScheme B S hS

/-- The structure map of every small pro-étale object is weakly étale. -/
instance weaklyEtale_structureMorphism (X : SmallProetale B S hS) :
    WeaklyEtale (B.inclusion.map X.obj.hom) := X.property

/-- Small-site coverings are those induced from the chosen big site. -/
@[stacks 098K "part (2), coverings in a chosen big site"]
abbrev IsCovering (E : Covering (SmallProetale B S hS)) : Prop :=
  BigProetaleOver.IsCovering B S hS
    ⟨(inclusion B S hS).obj E.1, E.2.map (inclusion B S hS)⟩

/-- The precoverage presented by the induced small-site covering families. -/
def precoverage : Precoverage (SmallProetale B S hS) where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 1} X,
    R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩}

/-- A small-site presieve is covering precisely when a chosen big covering presents it. -/
theorem mem_precoverage_iff {X : SmallProetale B S hS} {R : Presieve X} :
    R ∈ precoverage B S hS X ↔ ∃ E : PreZeroHypercover.{u + 1} X,
      R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩ := Iff.rfl

/-- The topology generated by the induced small-site coverings. -/
abbrev topology : GrothendieckTopology (SmallProetale B S hS) :=
  (precoverage B S hS).toGrothendieck

end SmallProetale

/-- Objects of the chosen big site over `S` whose source scheme is affine. -/
abbrev IsAffineOver : ObjectProperty (BigProetaleOver B S hS) :=
  fun X ↦ IsAffine ((BigProetaleOver.toScheme B S hS).obj X)

/-- The big affine pro-étale category over `S`. -/
@[stacks 098K "part (3), category"]
abbrev BigAffineProetale := (IsAffineOver B S hS).FullSubcategory

namespace BigAffineProetale

/-- The canonical full inclusion into the big category over `S`. -/
abbrev inclusion : BigAffineProetale B S hS ⥤ BigProetaleOver B S hS :=
  (IsAffineOver B S hS).ι

/-- The underlying scheme of an affine pro-étale object. -/
abbrev toScheme : BigAffineProetale B S hS ⥤ Scheme.{u} :=
  inclusion B S hS ⋙ BigProetaleOver.toScheme B S hS

/-- Every object of the affine subcategory has affine underlying scheme. -/
instance isAffine_toScheme_obj (X : BigAffineProetale B S hS) :
    IsAffine ((toScheme B S hS).obj X) := X.property

/-- Standard affine pro-étale coverings are finite chosen big coverings. -/
@[stacks 098K "part (3), coverings"]
abbrev IsCovering (E : Covering (BigAffineProetale B S hS)) : Prop :=
  BigProetaleOver.IsCovering B S hS
      ⟨(inclusion B S hS).obj E.1, E.2.map (inclusion B S hS)⟩ ∧
    Finite E.2.I₀

/-- The precoverage presented by standard affine pro-étale covering families. -/
def precoverage : Precoverage (BigAffineProetale B S hS) where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 1} X,
    R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩}

/-- A presieve is in the affine precoverage exactly when a standard covering presents it. -/
theorem mem_precoverage_iff {X : BigAffineProetale B S hS} {R : Presieve X} :
    R ∈ precoverage B S hS X ↔ ∃ E : PreZeroHypercover.{u + 1} X,
      R = E.presieve₀ ∧ IsCovering B S hS ⟨X, E⟩ := Iff.rfl

/-- The topology generated by standard affine pro-étale covering families. -/
abbrev topology : GrothendieckTopology (BigAffineProetale B S hS) :=
  (precoverage B S hS).toGrothendieck

end BigAffineProetale

end AlgebraicGeometry.ProEtale
