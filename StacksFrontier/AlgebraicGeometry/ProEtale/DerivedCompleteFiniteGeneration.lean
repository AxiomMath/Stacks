namespace DerivedCompleteRecurrence

attribute [local instance] HasDerivedCategory.standard KoszulCompletion.derivedCountableProducts

/-- A finite product of copies of a derived complete module is derived complete. -/
theorem isDerivedCompleteModule_pi {A : Type v} [CommRing A] (I : Ideal A) (ι : Type)
    {M : Type v} [AddCommGroup M] [Module A M] (hM : IsDerivedCompleteModule I (ModuleCat.of A M)) :
    IsDerivedCompleteModule I (ModuleCat.of A (ι → M)) := by
  rw [isDerivedCompleteModule_iff_forall_bijective_recurrence] at hM ⊢
  intro f hf
  obtain ⟨hinj, hsurj⟩ := hM f hf
  have hcomp : ∀ (a : ℕ → ι → M) (i : ι),
      (fun n => recurrence (M := ModuleCat.of A (ι → M)) f a n i) =
        recurrence (M := ModuleCat.of A M) f (fun n => a n i) := by
    intro a i
    funext n
    rfl
  refine ⟨fun a b hab => ?_, fun b => ?_⟩
  · funext n i
    exact congrFun (hinj ((hcomp a i).symm.trans ((congrArg (fun z => fun n => z n i) hab).trans
      (hcomp b i)))) n
  · choose a ha using fun i => hsurj (fun n => b n i)
    refine ⟨fun n i => a i n, ?_⟩
    funext n i
    exact (congrFun ((hcomp (fun n i => a i n) i).trans (ha i)) n)

end DerivedCompleteRecurrence


namespace AlgebraicGeometry.Scheme.ProEt

variable {X : Scheme.{u}}

/-- **Gluing along a disjoint clopen decomposition.** Over a finite family of objects of
`X_proétale` which generates a covering sieve and whose underlying schemes form a disjoint clopen
decomposition of the target, every family of sections of a sheaf of sets is the family of
restrictions of a unique section. -/
theorem existsUnique_glue_of_isClopenDecompositionCover {W : X.ProEt} {n : ℕ}
    (V : Fin n → X.ProEt) (f : (i : Fin n) → V i ⟶ W)
    (hdec : IsClopenDecompositionCover (fun i ↦ (ProEtale.proetaleToScheme X).obj (V i))
      (fun i ↦ (ProEtale.proetaleToScheme X).map (f i)))
    (hcover : Sieve.ofArrows V f ∈ ProEt.topology X W)
    (F : Sheaf (ProEt.topology X) (Type t)) (s : ∀ i, F.obj.obj (op (V i))) :
    ∃! x : F.obj.obj (op W), ∀ i, F.obj.map (f i).op x = s i := by
  classical
  let Q := ProEtale.proetaleToScheme X
  have hcompat : Presieve.Arrows.Compatible F.obj f s := by
    intro i j Z gi gj hcomp
    by_cases hij : i = j
    · subst hij
      have : Mono (f i) := Q.mono_of_mono_map (hdec.openImmersion i).mono
      rw [(cancel_mono (f i)).1 hcomp]
    · have hZ : IsEmpty (Q.obj Z).carrier := by
        refine ⟨fun z ↦ ?_⟩
        have heq : (Q.map (f i)).base ((Q.map gi).base z) =
            (Q.map (f j)).base ((Q.map gj).base z) := by
          have hh := congrArg (fun q ↦ (Q.map q).base z) hcomp
          rw [Functor.map_comp, Functor.map_comp] at hh
          simpa only [AlgebraicGeometry.Scheme.Hom.comp_base,
            ConcreteCategory.comp_apply] using hh
        have hmemj : (Q.map (f i)).base ((Q.map gi).base z) ∈
          Set.range (Q.map (f j)).base := heq ▸ ⟨_, rfl⟩
        exact (hdec.disjoint i j hij).le_bot ⟨⟨_, rfl⟩, hmemj⟩
      have _ : IsEmpty Z.left := hZ
      let _ : Unique (F.obj.obj (op Z)) :=
        Types.isTerminalEquivUnique _ (Sheaf.isTerminalOfBotCover F Z (ProEt.bot_mem_topology Z))
      exact Subsingleton.elim _ _
  have hFsh : Presieve.IsSheafFor F.obj (Presieve.ofArrows V f) := by
    rw [Presieve.isSheafFor_iff_generate]; exact F.property.isSheafFor _ hcover
  rw [Presieve.isSheafFor_arrows_iff] at hFsh
  exact hFsh s hcompat

end AlgebraicGeometry.Scheme.ProEt

