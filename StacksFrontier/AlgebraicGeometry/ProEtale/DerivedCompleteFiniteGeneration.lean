variable (X : Scheme.{u}) (Λ : Type (u + 1)) [CommRing Λ] (I : Ideal Λ)

/-- Scalars restrict to scalars. -/
theorem constantCoefficientScalar_map {U V : X.ProEt} (h : V ⟶ U) (l : Λ) :
    ((Stacks.SheafOfModules.Tensor.ringSheaf
      (constantCoefficientRingedSite.{u, u + 1, u} X Λ).O).obj.map h.op).hom
        (constantCoefficientScalar X Λ U l) = constantCoefficientScalar X Λ V l :=
  (congrArg (fun φ => RingCat.Hom.hom φ (ULift.up l))
    ((constantCoefficientRingMap.{u, u + 1, u} X Λ).naturality h.op)).symm

/-- The scalars form a ring homomorphism. -/
def constantCoefficientScalarHom (U : X.ProEt) :
    Λ →+* (Stacks.SheafOfModules.Tensor.ringSheaf
      (constantCoefficientRingedSite.{u, u + 1, u} X Λ).O).obj.obj (op U) :=
  ((constantCoefficientRingMap.{u, u + 1, u} X Λ).app (op U)).hom.comp
    (ULift.ringEquiv.{u + 1, u + 1} (R := Λ)).symm.toRingHom

/-- `constantCoefficientScalarHom` is `constantCoefficientScalar`. -/
theorem constantCoefficientScalarHom_apply (U : X.ProEt) (l : Λ) :
    constantCoefficientScalarHom X Λ U l = constantCoefficientScalar X Λ U l := rfl

/-- Reduction modulo `I` of the constant coefficient ring sheaf carries the image of a constant
`c` to the image of its reduction. -/
theorem constantCoefficientRingReduction_app_ringMap (U : X.ProEt) (c : ULift.{u + 1} Λ) :
    ((constantCoefficientRingReduction.{u, u + 1, u} X Λ I).hom.app (op U)).hom
        (((constantCoefficientRingMap.{u, u + 1, u} X Λ).app (op U)).hom c) =
      ((constantCoefficientRingMap.{u, u + 1, u} X (Λ ⧸ I)).app (op U)).hom
        (ULift.up (Ideal.Quotient.mk I c.down)) := by
  let π : ULift.{u + 1} Λ →+* ULift.{u + 1} (Λ ⧸ I) :=
    (ULift.ringEquiv.{u + 1, u + 1} (R := Λ ⧸ I)).symm.toRingHom.comp
      ((Ideal.Quotient.mk I).comp (ULift.ringEquiv.{u + 1, u + 1} (R := Λ)).toRingHom)
  have h₀ := NatTrans.congr_app (toSheafify_naturality (Scheme.ProEt.topology X)
    ((Functor.const X.ProEtᵒᵖ).map (CommRingCat.ofHom π))) (op U)
  have h := congrArg (fun φ => CommRingCat.Hom.hom φ c) h₀
  simp only [NatTrans.comp_app, CommRingCat.hom_comp, RingHom.coe_comp,
    Function.comp_apply] at h
  exact h.symm

variable [IsNoetherianRing Λ]

/-- **The sections of `IΛ̲` over an affine weakly contractible object are generated by `I`.** A
section of `Λ̲` over such an object which vanishes modulo `I` lies in the ideal generated by the
scalars of the elements of `I`. -/
theorem mem_span_constantCoefficientScalar_of_reduction_eq_zero (W : X.ProEt) [IsAffine W.left]
    (hW : IsWContractible.{u, u} Γ(W.left, ⊤))
    (f : (Stacks.SheafOfModules.Tensor.ringSheaf
      (constantCoefficientRingedSite.{u, u + 1, u} X Λ).O).obj.obj (op W))
    (hf : ((constantCoefficientRingReduction.{u, u + 1, u} X Λ I).hom.app (op W)).hom f = 0) :
    f ∈ Ideal.span (constantCoefficientScalar X Λ W '' I) := by
  classical
  let J := Scheme.ProEt.topology X
  let O :=
    Stacks.SheafOfModules.Tensor.ringSheaf (constantCoefficientRingedSite.{u, u + 1, u} X Λ).O
  let a := constantCoefficientRingMap.{u, u + 1, u} X Λ
  let a' := constantCoefficientRingMap.{u, u + 1, u} X (Λ ⧸ I)
  obtain ⟨n, V, g, hdec, hcov, hmem⟩ := Scheme.ProEt.exists_clopenRefinement_of_isWContractible W hW
    (Presheaf.imageSieve a f) (Presheaf.imageSieve_mem J a f)
  -- on each piece, `f` is the scalar of an element of `I`
  have hloc : ∀ j, ∃ l ∈ I, O.obj.map (g j).op f = constantCoefficientScalar X Λ (V j) l := by
    intro j
    obtain ⟨c, hc⟩ := hmem j
    by_cases hc0 : Ideal.Quotient.mk I c.down = 0
    · exact ⟨c.down, Ideal.Quotient.eq_zero_iff_mem.mp hc0, hc.symm⟩
    · have hred : (a'.app (op (V j))).hom (ULift.up (Ideal.Quotient.mk I c.down)) =
          (a'.app (op (V j))).hom 0 := by
        rw [← constantCoefficientRingReduction_app_ringMap, map_zero, hc]
        have hn := congrArg (fun φ => RingCat.Hom.hom φ f)
          ((constantCoefficientRingReduction.{u, u + 1, u} X Λ I).hom.naturality (g j).op)
        simp only [RingCat.hom_comp, RingHom.coe_comp, Function.comp_apply] at hn
        rw [hn, hf, map_zero]
      have hbot : (⊥ : Sieve (V j)) ∈ J (V j) := by
        refine J.superset_covering ?_ (Presheaf.equalizerSieve_mem J a' _ _ hred)
        intro Y h hh
        exact hc0 (congrArg ULift.down hh)
      let hU : Unique (((sheafCompose J (forget RingCat.{u + 1})).obj O).obj.obj (op (V j))) :=
        Types.isTerminalEquivUnique _ (Sheaf.isTerminalOfBotCover _ (V j) hbot)
      exact ⟨0, I.zero_mem, @Subsingleton.elim _ hU.instSubsingleton _ _⟩
  choose l hlI hl using hloc
  -- write each `l j` in terms of generators of `I`
  obtain ⟨r, gen, hgen⟩ := Submodule.fg_iff_exists_fin_generating_family.1
    (IsNoetherian.noetherian I)
  have hspan : ∀ j, ∃ μ : Fin r → Λ, ∑ i, μ i • gen i = l j := fun j =>
    (Submodule.mem_span_range_iff_exists_fun Λ).mp (hgen ▸ hlI j)
  choose μ hμ using hspan
  -- glue the coefficients
  have hglue : ∀ i, ∃ c : O.obj.obj (op W), ∀ j,
      O.obj.map (g j).op c = constantCoefficientScalar X Λ (V j) (μ j i) := fun i =>
    (Scheme.ProEt.existsUnique_glue_of_isClopenDecompositionCover V g hdec hcov
      ((sheafCompose J (forget RingCat.{u + 1})).obj O)
      (fun j => constantCoefficientScalar X Λ (V j) (μ j i))).exists
  choose c hc using hglue
  have hfeq : f = ∑ i, c i * constantCoefficientScalar X Λ W (gen i) := by
    refine (Scheme.ProEt.existsUnique_glue_of_isClopenDecompositionCover V g hdec hcov
      ((sheafCompose J (forget RingCat.{u + 1})).obj O)
      (fun j => O.obj.map (g j).op f)).unique (fun j => rfl) (fun j => ?_)
    show (O.obj.map (g j).op).hom (∑ i, c i * constantCoefficientScalar X Λ W (gen i)) =
      (O.obj.map (g j).op).hom f
    calc (O.obj.map (g j).op).hom (∑ i, c i * constantCoefficientScalar X Λ W (gen i))
        = ∑ i, constantCoefficientScalar X Λ (V j) (μ j i) *
            constantCoefficientScalar X Λ (V j) (gen i) := by
          rw [map_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [map_mul, hc i j]
          exact congrArg _ (constantCoefficientScalar_map X Λ (g j) (gen i))
      _ = constantCoefficientScalar X Λ (V j) (l j) := by
          rw [← hμ j]
          simp only [← constantCoefficientScalarHom_apply, map_sum, map_mul, smul_eq_mul]
      _ = (O.obj.map (g j).op).hom f := (hl j).symm
  rw [hfeq]
  refine Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨gen i, ?_, rfl⟩)
  rw [← hgen]
  exact Submodule.subset_span (Set.mem_range_self i)

omit [IsNoetherianRing Λ] in
/-- A morphism of sheaves of `Λ̲`-modules on `X_proétale` which is surjective on the sections over
the members of a family of objects covering the site is an epimorphism. -/
theorem epi_of_surjective_sections
    {A F : RingedSite.Modules.{u + 1, u, u + 1} (constantCoefficientRingedSite.{u, u + 1, u} X Λ)}
    (α : A ⟶ F) (P : ObjectProperty X.ProEt)
    (hP : (Scheme.ProEt.topology X).HasEnoughObjects P)
    (h : ∀ W, P W → Function.Surjective (α.val.app (op W))) : Epi α := by
  let R :=
    Stacks.SheafOfModules.Tensor.ringSheaf (constantCoefficientRingedSite.{u, u + 1, u} X Λ).O
  have hls : Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf R).map α) := by
    refine ⟨fun {U} x => ?_⟩
    obtain ⟨ι, V, f, hf, hV⟩ := hP U
    refine (Scheme.ProEt.topology X).superset_covering (fun Z g hg => ?_) hf
    obtain ⟨i, a, rfl⟩ := (Sieve.mem_ofArrows_iff V f g).mp hg
    obtain ⟨t, ht⟩ := h (V i) (hV i) (F.val.map (f i).op x)
    refine ⟨A.val.map a.op t, ?_⟩
    show α.val.app (op Z) (A.val.map a.op t) = F.val.map (a ≫ f i).op x
    rw [PresheafOfModules.naturality_apply, ht]
    exact (PresheafOfModules.map_comp_apply F.val (f i).op a.op x).symm
  have : Epi ((SheafOfModules.toSheaf R).map α) := Sheaf.epi_of_isLocallySurjective _
  refine ⟨fun {Z} g₁ g₂ hg => (SheafOfModules.toSheaf R).map_injective ?_⟩
  rw [← cancel_epi ((SheafOfModules.toSheaf R).map α), ← Functor.map_comp, ← Functor.map_comp, hg]

/-- Restriction of sections of a sheaf of `Λ̲`-modules along a morphism of `X_proétale`, as an
additive map between the modules of sections. -/
def sectionRestriction
    (M : RingedSite.Modules.{u + 1, u, u + 1} (constantCoefficientRingedSite.{u, u + 1, u} X Λ))
    {U V : X.ProEt} (f : V ⟶ U) : M.val.obj (op U) →+ M.val.obj (op V) where
  toFun x := M.val.map f.op x
  map_zero' := map_zero (M.val.map f.op).hom
  map_add' := map_add (M.val.map f.op).hom

omit [IsNoetherianRing Λ] in
/-- `sectionRestriction` is the restriction map of the sheaf. -/
theorem sectionRestriction_apply
    (M : RingedSite.Modules.{u + 1, u, u + 1} (constantCoefficientRingedSite.{u, u + 1, u} X Λ))
    {U V : X.ProEt} (f : V ⟶ U) (x : M.val.obj (op U)) :
    sectionRestriction X Λ M f x = M.val.map f.op x := rfl

omit [IsNoetherianRing Λ] in
/-- `sectionRestriction` is semilinear along the restriction of scalars. -/
theorem sectionRestriction_smul
    (M : RingedSite.Modules.{u + 1, u, u + 1} (constantCoefficientRingedSite.{u, u + 1, u} X Λ))
    {U V : X.ProEt} (f : V ⟶ U)
    (r : (Stacks.SheafOfModules.Tensor.ringSheaf
      (constantCoefficientRingedSite.{u, u + 1, u} X Λ).O).obj.obj (op U))
    (x : M.val.obj (op U)) :
    sectionRestriction X Λ M f (r • x) =
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (constantCoefficientRingedSite.{u, u + 1, u} X Λ).O).obj.map f.op).hom r •
        sectionRestriction X Λ M f x :=
  PresheafOfModules.map_smul _ _ _ _

omit [IsNoetherianRing Λ] in
/-- `sectionRestriction` is compatible with composition. -/
theorem sectionRestriction_comp
    (M : RingedSite.Modules.{u + 1, u, u + 1} (constantCoefficientRingedSite.{u, u + 1, u} X Λ))
    {U V V' : X.ProEt} (f : V ⟶ U) (f' : V' ⟶ V) (x : M.val.obj (op U)) :
    sectionRestriction X Λ M f' (sectionRestriction X Λ M f x) =
      sectionRestriction X Λ M (f' ≫ f) x := by
  show M.val.map f'.op (M.val.map f.op x) = M.val.map (f' ≫ f).op x
  rw [op_comp, PresheafOfModules.map_comp_apply]

omit [IsNoetherianRing Λ] in
/-- **A sheaf of `Λ̲`-modules with locally constant finite type reduction is generated by finitely
many global sections over every affine weakly contractible object.** Let `X` be affine with
w-contractible ring of global sections, and let `M` be a sheaf of `Λ̲`-modules on `X_proétale`
whose underlying sheaf of `Λ`-modules is a locally constant sheaf of `Λ/I`-modules of finite type.
There are finitely many global sections of `M` whose restrictions generate the sections of `M`
over every affine object with w-contractible ring of global sections. -/
theorem exists_finite_globalSections_span (hX : IsWContractible.{u, u} Γ(X, ⊤)) [IsAffine X]
    (M : RingedSite.Modules.{u + 1, u, u + 1} (constantCoefficientRingedSite.{u, u + 1, u} X Λ))
    (G : Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} (Λ ⧸ I)))
    (hG : Stacks.ConstantSheaf.IsFiniteTypeLocallyConstant (Λ ⧸ I) (Scheme.ProEt.topology X) G)
    (e : (toCoefficientModuleSheaf.{u, u + 1, u} X Λ).obj M ≅
      (restrictQuotientScalars.{u + 1, u + 1, u} X Λ I).obj G) :
    ∃ (ι : Type) (_ : Fintype ι) (σ : ι → M.val.obj (op (Scheme.ProEt.mk (𝟙 X)))),
      ∀ (W : X.ProEt) [IsAffine W.left], IsWContractible.{u, u} Γ(W.left, ⊤) →
        ∀ q : M.val.obj (op W), q ∈ Submodule.span
          ((Stacks.SheafOfModules.Tensor.ringSheaf
            (constantCoefficientRingedSite.{u, u + 1, u} X Λ).O).obj.obj (op W))
          (Set.range fun k => sectionRestriction X Λ M ((isTerminalProEtId X).from W) (σ k)) := by
  classical
  let J := Scheme.ProEt.topology X
  let O :=
    Stacks.SheafOfModules.Tensor.ringSheaf (constantCoefficientRingedSite.{u, u + 1, u} X Λ).O
  let tr : ∀ V : X.ProEt, V ⟶ Scheme.ProEt.mk (𝟙 X) := fun V => (isTerminalProEtId X).from V
  obtain ⟨ι, _, σ', hσ'⟩ := exists_finite_globalSections_locallyGenerating X hX G hG
  let ψ : ∀ V : X.ProEt, ((restrictQuotientScalars.{u + 1, u + 1, u} X Λ I).obj G).obj.obj (op V)
      →ₗ[Λ] ((toCoefficientModuleSheaf.{u, u + 1, u} X Λ).obj M).obj.obj (op V) :=
    fun V => (e.inv.hom.app (op V)).hom
  let σ : ι → M.val.obj (op (Scheme.ProEt.mk (𝟙 X))) := fun k => ψ _ (σ' k)
  refine ⟨ι, inferInstance, σ, fun W _ hW q => ?_⟩
  let x : G.obj.obj (op W) := e.hom.hom.app (op W) q
  obtain ⟨n, V, g, hdec, hcov, hmem⟩ :=
    Scheme.ProEt.exists_clopenRefinement_of_isWContractible W hW _ (hσ' W x)
  -- on each piece, `q` is a `Λ`-linear combination of the restrictions of the `σ k`
  have hloc : ∀ l, ∃ d : ι → Λ, sectionRestriction X Λ M (g l) q =
      ∑ k, constantCoefficientScalar X Λ (V l) (d k) •
        sectionRestriction X Λ M (tr (V l)) (σ k) := by
    intro l
    obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun (Λ ⧸ I)).mp
      ((mem_globalSectionsSpanSieve_iff X G σ' x (g l)).mp (hmem l))
    choose d hd using fun k => Ideal.Quotient.mk_surjective (I := I) (c k)
    refine ⟨d, ?_⟩
    let y : ι → ((restrictQuotientScalars.{u + 1, u + 1, u} X Λ I).obj G).obj.obj (op (V l)) :=
      fun k => G.obj.map (tr (V l)).op (σ' k)
    have h1 : sectionRestriction X Λ M (g l) q =
        ψ (V l) (e.hom.hom.app (op (V l)) (sectionRestriction X Λ M (g l) q)) :=
      (ConcreteCategory.congr_hom
        (NatTrans.congr_app (congrArg (fun φ => φ.hom) e.hom_inv_id) (op (V l)))
        (sectionRestriction X Λ M (g l) q)).symm
    have h2 : e.hom.hom.app (op (V l)) (sectionRestriction X Λ M (g l) q) =
        G.obj.map (g l).op x :=
      NatTrans.naturality_apply e.hom.hom (g l).op q
    have h3 : ∀ k, (ψ (V l) (y k) : M.val.obj (op (V l))) =
        sectionRestriction X Λ M (tr (V l)) (σ k) := fun k =>
      NatTrans.naturality_apply e.inv.hom (tr (V l)).op (σ' k)
    have hx : (G.obj.map (g l).op x :
        ((restrictQuotientScalars.{u + 1, u + 1, u} X Λ I).obj G).obj.obj (op (V l))) =
        ∑ k, d k • y k := by
      rw [← hc]
      exact Finset.sum_congr rfl fun k _ => by rw [← hd k]; rfl
    have e4 : ψ (V l) (∑ k, d k • y k) = ∑ k, d k • ψ (V l) (y k) := by
      simp only [map_sum, map_smul]
    have e5 : ((∑ k, d k • ψ (V l) (y k) :
        ((toCoefficientModuleSheaf.{u, u + 1, u} X Λ).obj M).obj.obj (op (V l))) :
          M.val.obj (op (V l))) =
        ∑ k, constantCoefficientScalar X Λ (V l) (d k) •
          sectionRestriction X Λ M (tr (V l)) (σ k) :=
      Finset.sum_congr rfl fun k _ =>
        (toCoefficientModuleSheaf_smul X Λ M (V l) (d k) (ψ (V l) (y k))).trans
          (congrArg _ (h3 k))
    refine h1.trans ?_
    rw [h2, hx, e4]
    exact e5
  choose d hd using hloc
  -- glue the coefficients
  have hglue : ∀ k, ∃ c : O.obj.obj (op W), ∀ l,
      (O.obj.map (g l).op).hom c = constantCoefficientScalar X Λ (V l) (d l k) := fun k =>
    (Scheme.ProEt.existsUnique_glue_of_isClopenDecompositionCover V g hdec hcov
      ((sheafCompose J (forget RingCat.{u + 1})).obj O)
      (fun l => constantCoefficientScalar X Λ (V l) (d l k))).exists
  choose c hc using hglue
  have hq : q = ∑ k, c k • sectionRestriction X Λ M (tr W) (σ k) := by
    refine (Scheme.ProEt.existsUnique_glue_of_isClopenDecompositionCover V g hdec hcov
      ((sheafCompose J (forget AddCommGrpCat.{u + 1})).obj ((SheafOfModules.toSheaf _).obj M))
      (fun l => sectionRestriction X Λ M (g l) q)).unique (fun l => rfl) (fun l => ?_)
    show sectionRestriction X Λ M (g l) (∑ k, c k • sectionRestriction X Λ M (tr W) (σ k)) =
      sectionRestriction X Λ M (g l) q
    rw [hd l, map_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [sectionRestriction_smul, hc k l, sectionRestriction_comp,
      (isTerminalProEtId X).hom_ext (g l ≫ tr W) (tr (V l))]
  rw [hq]
  exact (Submodule.mem_span_range_iff_exists_fun _).2 ⟨c, rfl⟩

attribute [local instance] KoszulCompletion.derivedCountableProducts

/-- Over an affine weakly contractible object, the sections of the ideal sheaf `IΛ̲` form the
ideal generated by the scalars of `I`. -/
theorem idealSections_constantCoefficientIdealSheaf_eq (W : X.ProEt) [IsAffine W.left]
    (hW : IsWContractible.{u, u} Γ(W.left, ⊤)) :
    RingedSite.idealSections (constantCoefficientRingedSite.{u, u + 1, u} X Λ)
      (constantCoefficientIdealSheaf.{u, u + 1, u} X Λ I) (op W) =
      I.map (constantCoefficientScalarHom X Λ W) := by
  refine le_antisymm (fun f hf => ?_) ?_
  · exact mem_span_constantCoefficientScalar_of_reduction_eq_zero X Λ I W hW f
      (RingHom.mem_ker.mp ((SheafOfModules.mem_kerIdeal _ (op W) f).mp hf))
  · rw [Ideal.map_le_iff_le_comap]
    intro l hl
    exact constantCoefficientScalar_mem X Λ I W hl

/-- Over an affine weakly contractible object, the sections of the ideal sheaf `IΛ̲` are
finitely generated. -/
theorem fg_constantCoefficientIdealSheaf_obj_of_isWContractible (W : X.ProEt) [IsAffine W.left]
    (hW : IsWContractible.{u, u} Γ(W.left, ⊤)) :
    ((constantCoefficientIdealSheaf.{u, u + 1, u} X Λ I).toSubmodule.obj (op W)).FG := by
  show (RingedSite.idealSections (constantCoefficientRingedSite.{u, u + 1, u} X Λ)
    (constantCoefficientIdealSheaf.{u, u + 1, u} X Λ I) (op W)).FG
  rw [idealSections_constantCoefficientIdealSheaf_eq X Λ I W hW]
  exact Ideal.FG.map (IsNoetherian.noetherian I) _

/-- Over an affine weakly contractible object, an `IΛ̲`-multiple of a section of a sheaf of
`Λ̲`-modules is an `I`-multiple of it. -/
theorem mem_ideal_smul_of_mem_idealSections_smul
    (M : RingedSite.Modules.{u + 1, u, u + 1} (constantCoefficientRingedSite.{u, u + 1, u} X Λ))
    (W : X.ProEt) [IsAffine W.left] (hW : IsWContractible.{u, u} Γ(W.left, ⊤))
    (m : M.val.obj (op W))
    (hm : m ∈ RingedSite.idealSections (constantCoefficientRingedSite.{u, u + 1, u} X Λ)
      (constantCoefficientIdealSheaf.{u, u + 1, u} X Λ I) (op W) •
        (⊤ : Submodule ((Stacks.SheafOfModules.Tensor.ringSheaf
          (constantCoefficientRingedSite.{u, u + 1, u} X Λ).O).obj.obj (op W))
          (M.val.obj (op W)))) :
    (show ((toCoefficientModuleSheaf.{u, u + 1, u} X Λ).obj M).obj.obj (op W) from m) ∈
      I • (⊤ : Submodule Λ (((toCoefficientModuleSheaf.{u, u + 1, u} X Λ).obj M).obj.obj
        (op W))) := by
  let RW := (Stacks.SheafOfModules.Tensor.ringSheaf
    (constantCoefficientRingedSite.{u, u + 1, u} X Λ).O).obj.obj (op W)
  let CM := ((toCoefficientModuleSheaf.{u, u + 1, u} X Λ).obj M).obj.obj (op W)
  let c : M.val.obj (op W) → CM := fun x => x
  let d : CM → M.val.obj (op W) := fun y => y
  have hsm : ∀ (l : Λ) (y : CM), d (l • y) = constantCoefficientScalar X Λ W l • d y :=
    fun l y => toCoefficientModuleSheaf_smul X Λ M W l y
  have hsm' : ∀ (l : Λ) (x : M.val.obj (op W)),
      c (constantCoefficientScalar X Λ W l • x) = l • c x :=
    fun l x => (toCoefficientModuleSheaf_smul X Λ M W l x).symm
  let P : Submodule RW (M.val.obj (op W)) :=
    { carrier := {x | c x ∈ I • (⊤ : Submodule Λ CM)}
      add_mem' := fun {a b} ha hb => Submodule.add_mem (I • (⊤ : Submodule Λ CM)) ha hb
      zero_mem' := Submodule.zero_mem (I • (⊤ : Submodule Λ CM))
      smul_mem' := fun r x hx => by
        show c (r • d (c x)) ∈ I • (⊤ : Submodule Λ CM)
        refine Submodule.smul_induction_on (p := fun y => c (r • d y) ∈ I • (⊤ : Submodule Λ CM))
          hx (fun l hl y _ => ?_) (fun y z hy hz => ?_)
        · have : c (r • d (l • y)) = l • c (r • d y) := by
            rw [hsm, smul_smul, mul_comm, ← smul_smul, hsm']
          rw [this]
          exact Submodule.smul_mem_smul hl Submodule.mem_top
        · have : c (r • d (y + z)) = c (r • d y) + c (r • d z) := smul_add r (d y) (d z)
          rw [this]
          exact Submodule.add_mem _ hy hz }
  have hle : RingedSite.idealSections (constantCoefficientRingedSite.{u, u + 1, u} X Λ)
      (constantCoefficientIdealSheaf.{u, u + 1, u} X Λ I) (op W) ≤ P.colon Set.univ := by
    rw [idealSections_constantCoefficientIdealSheaf_eq X Λ I W hW, Ideal.map_le_iff_le_comap]
    intro l hl
    rw [Ideal.mem_comap, Submodule.mem_colon]
    intro x _
    show c (constantCoefficientScalarHom X Λ W l • x) ∈ I • (⊤ : Submodule Λ CM)
    rw [constantCoefficientScalarHom_apply, hsm']
    exact Submodule.smul_mem_smul hl Submodule.mem_top
  have hP : RingedSite.idealSections (constantCoefficientRingedSite.{u, u + 1, u} X Λ)
      (constantCoefficientIdealSheaf.{u, u + 1, u} X Λ I) (op W) •
        (⊤ : Submodule RW (M.val.obj (op W))) ≤ P :=
    Submodule.smul_le.mpr fun r hr x _ => Submodule.mem_colon.mp (hle hr) x trivial
  exact hP hm

/-- **[Stacks, Tag 09BZ].** Let `X` be a weakly contractible affine scheme, let `Λ` be a
Noetherian ring and let `I ⊂ Λ` be an ideal. Let `ℱ` be a sheaf of `Λ`-modules on `X_proétale`
which is derived complete, and such that `ℱ/Iℱ` is a locally constant sheaf of `Λ/I`-modules of
finite type. Then there is an integer `t` and a surjection `(Λ̲^∧)^{⊕t} ⟶ ℱ`. -/
@[stacks 09BZ]
theorem exists_epi_sigma_completedConstantSheaf_of_isDerivedComplete
    [IsAffine X] (hX : ProetaleWContractible.IsWeaklyContractibleObj X)
    (F : RingedSite.Modules.{u + 1, u, u + 1} (constantCoefficientRingedSite.{u, u + 1, u} X Λ))
    (hF : RingedSite.IsDerivedComplete.{u + 1, u, u + 1, u + 1}
      (constantCoefficientRingedSite.{u, u + 1, u} X Λ)
      (constantCoefficientIdealSheaf.{u, u + 1, u} X Λ I)
      ((DerivedCategory.singleFunctor _ 0).obj F))
    (hFI : ∃ G : Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} (Λ ⧸ I)),
      Stacks.ConstantSheaf.IsFiniteTypeLocallyConstant (Λ ⧸ I) (Scheme.ProEt.topology X) G ∧
      Nonempty ((toCoefficientModuleSheaf.{u, u + 1, u} X Λ).obj
          (cokernel (RingedSite.idealPowerProduct (constantCoefficientRingedSite.{u, u + 1, u} X Λ)
            (constantCoefficientIdealSheaf.{u, u + 1, u} X Λ I) F 1).ι) ≅
        (restrictQuotientScalars.{u + 1, u + 1, u} X Λ I).obj G)) :
    ∃ t : ℕ, ∃ α : (∐ fun _ : Fin t =>
        (moduleSheafOverConstantCoefficientsFunctor.{u, u + 1, u} X Λ).obj
          (Stacks.ConstantSheaf.completedConstantSheaf (Scheme.ProEt.topology X) I)) ⟶ F,
      Epi α := by
  classical
  obtain ⟨G, hG, ⟨e⟩⟩ := hFI
  let J := Scheme.ProEt.topology X
  let 𝒪 := constantCoefficientRingedSite.{u, u + 1, u} X Λ
  let R := Stacks.SheafOfModules.Tensor.ringSheaf 𝒪.O
  let T := Scheme.ProEt.mk (𝟙 X)
  let tr : ∀ V : X.ProEt, V ⟶ T := fun V => (isTerminalProEtId X).from V
  have hXw : IsWContractible.{u, u} Γ(X, ⊤) := isWContractible_of_isWeaklyContractible X hX
  let hS := Scheme.ProEt.slicedObjectsSituation X R
  let N := RingedSite.idealPowerProduct 𝒪 (constantCoefficientIdealSheaf.{u, u + 1, u} X Λ I) F 1
  let Q := cokernel N.ι
  let q := cokernel.π N.ι
  -- the quotient map on the sections over a testing object
  have hq : ∀ W : X.ProEt, hS.B W → Function.Surjective (q.val.app (op W)) ∧
      ∀ x, q.val.app (op W) x = 0 → x ∈ N.toSubmodule.obj (op W) := by
    intro W hW
    obtain ⟨e', he'⟩ :=
      RingedSite.exists_evaluation_cokernel_iso_of_weaklyContractibleObjectsSituation
        𝒪 hS.toWeaklyContractibleObjectsSituation W hW F N
    have hfac : ∀ x, q.val.app (op W) x = e'.hom (Submodule.Quotient.mk x) := fun x =>
      (congrArg (fun φ => ModuleCat.Hom.hom φ x) he').symm
    have hbij := (ConcreteCategory.isIso_iff_bijective e'.hom).mp inferInstance
    refine ⟨fun y => ?_, fun x hx => ?_⟩
    · obtain ⟨z, rfl⟩ := hbij.2 y
      obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ z
      exact ⟨x, hfac x⟩
    · rw [hfac] at hx
      exact (Submodule.Quotient.mk_eq_zero _).mp (hbij.1 (hx.trans (map_zero _).symm))
  have hTa : IsAffine T.left := ‹IsAffine X›
  have hTB : hS.B T := ⟨hTa, isWeaklyContractible_of_isWContractible T hXw⟩
  -- finitely many global sections generating the reduction
  obtain ⟨ι, _, σ, hσ⟩ := exists_finite_globalSections_span X Λ I hXw Q G hG e
  choose s hs using fun k => (hq T hTB).1 (σ k)
  -- the maps out of `Λ̲^∧` hitting them
  choose φ' φ hφT hφrange using fun k =>
    exists_completedConstantSheaf_hom_of_isDerivedComplete X Λ I F hF (s k)
  let eι : Fin (Fintype.card ι) ≃ ι := (Fintype.equivFin ι).symm
  let α := Sigma.desc (fun j : Fin (Fintype.card ι) => φ (eι j))
  refine ⟨Fintype.card ι, α, ?_⟩
  refine epi_of_surjective_sections X Λ α hS.B hS.hasEnoughObjects fun W hW => ?_
  obtain ⟨hWa, hWw⟩ := hW
  have hWc : IsWContractible.{u, u} Γ(W.left, ⊤) :=
    Scheme.ProEt.isWContractible_globalSections_of_isWeaklyContractible W hWw
  let RW := R.obj.obj (op W)
  let CM := ((toCoefficientModuleSheaf.{u, u + 1, u} X Λ).obj F).obj.obj (op W)
  let c : F.val.obj (op W) → CM := fun x => x
  let C := Stacks.ConstantSheaf.completedConstantSheaf J I
  let L : (ι → C.obj.obj (op W)) →ₗ[Λ] CM :=
    ∑ k, ((φ' k).hom.app (op W)).hom ∘ₗ LinearMap.proj k
  have hL : ∀ y, L y = ∑ k, (φ' k).hom.app (op W) (y k) := fun y => by
    rw [LinearMap.sum_apply]
    rfl
  -- the image of `φ' k` on `W` is the image of `φ k`
  have hφ'φ : ∀ k z, ∃ w, (φ k).val.app (op W) w = c ((φ' k).hom.app (op W) z) := fun k z =>
    (hφrange k W).symm.subset ⟨z, rfl⟩
  have hφφ' : ∀ k w, ∃ z, c ((φ' k).hom.app (op W) z) = (φ k).val.app (op W) w := fun k w =>
    (hφrange k W).subset ⟨w, rfl⟩
  -- the image of `L` is in the image of `α`
  have hφα : ∀ k, φ k = Sigma.ι _ (eι.symm k) ≫ α := fun k => by
    rw [Sigma.ι_desc, Equiv.apply_symm_apply]
  have hLα : ∀ y, c (L y) ∈ LinearMap.range (α.val.app (op W)).hom := by
    intro y
    rw [hL]
    show ∑ k, c ((φ' k).hom.app (op W) (y k)) ∈ _
    refine Submodule.sum_mem _ fun k _ => ?_
    obtain ⟨w, hw⟩ := hφ'φ k (y k)
    refine ⟨((Sigma.ι _ (eι.symm k) : _ ⟶ ∐ fun _ : Fin (Fintype.card ι) =>
        (moduleSheafOverConstantCoefficientsFunctor.{u, u + 1, u} X Λ).obj C).val.app (op W)) w,
      ?_⟩
    rw [← hw, hφα k]
    rfl
  -- `L` is surjective, by derived Nakayama
  have hsurjL : LinearMap.range L = ⊤ := by
    have hM : IsDerivedCompleteModule I (ModuleCat.of Λ (CM ⧸ LinearMap.range L)) :=
      DerivedCompleteRecurrence.completeModules_rangeQuotient I (ModuleCat.ofHom L)
        (DerivedCompleteRecurrence.isDerivedCompleteModule_pi I ι
          (Stacks.ConstantSheaf.isDerivedCompleteModule_completedConstantSheaf_sections J I W))
        (isDerivedCompleteModule_toCoefficientModuleSheaf_obj X Λ I F hF W ⟨hWa, hWw⟩)
    have hmem : ∀ x : CM, x ∈ LinearMap.range L ⊔ I • (⊤ : Submodule Λ CM) := by
      intro x
      let x' : F.val.obj (op W) := x
      obtain ⟨cf, hcf⟩ := (Submodule.mem_span_range_iff_exists_fun RW).mp
        (hσ W hWc (q.val.app (op W) x'))
      let z : F.val.obj (op W) := ∑ k, cf k • sectionRestriction X Λ F (tr W) (s k)
      have hσres : ∀ k, sectionRestriction X Λ Q (tr W) (σ k) =
          q.val.app (op W) (sectionRestriction X Λ F (tr W) (s k)) := fun k => by
        rw [← hs k]
        exact (PresheafOfModules.naturality_apply q.val (tr W).op (s k)).symm
      have hqz : q.val.app (op W) (x' - z) = 0 := by
        rw [map_sub, sub_eq_zero, ← hcf, map_sum]
        refine Finset.sum_congr rfl fun k _ => ?_
        rw [map_smul, hσres]
      have hN := (hq W ⟨hWa, hWw⟩).2 _ hqz
      rw [RingedSite.idealPowerProduct_obj_eq_pow_smul_top_of_sections_surjective 𝒪 _ F W
        (fun A B φ₀ hφ₀ => hS.isWeaklyContractible ⟨hWa, hWw⟩ A B φ₀ hφ₀)
        (fg_constantCoefficientIdealSheaf_obj_of_isWContractible X Λ I W hWc) 1, pow_one] at hN
      have hI' := mem_ideal_smul_of_mem_idealSections_smul X Λ I F W hWc _ hN
      have hz : c z ∈ LinearMap.range L := by
        show c (∑ k, cf k • sectionRestriction X Λ F (tr W) (s k)) ∈ _
        refine Submodule.sum_mem _ fun k _ => ?_
        obtain ⟨y0, hy0⟩ := hφT k
        have hres : cf k • sectionRestriction X Λ F (tr W) (s k) = (φ k).val.app (op W)
            (cf k • sectionRestriction X Λ
              ((moduleSheafOverConstantCoefficientsFunctor.{u, u + 1, u} X Λ).obj C)
              (tr W) y0) := by
          rw [map_smul, ← hy0]
          congr 1
          exact (PresheafOfModules.naturality_apply (φ k).val (tr W).op y0).symm
        obtain ⟨z0, hz0⟩ := hφφ' k _
        refine ⟨Pi.single k z0, ?_⟩
        rw [hL, Finset.sum_eq_single k (fun k' _ hk' => by rw [Pi.single_eq_of_ne hk', map_zero])
          (fun h => absurd (Finset.mem_univ k) h), Pi.single_eq_same]
        exact hz0.trans hres.symm
      rw [← add_sub_cancel (c z) x]
      exact Submodule.add_mem_sup hz hI'
    have hMI : Subsingleton ((CM ⧸ LinearMap.range L) ⧸
        (I • ⊤ : Submodule Λ (CM ⧸ LinearMap.range L))) := by
      rw [Submodule.Quotient.subsingleton_iff, eq_top_iff]
      intro w _
      obtain ⟨x, rfl⟩ := Submodule.Quotient.mk_surjective _ w
      obtain ⟨a, ha, b, hb, rfl⟩ := Submodule.mem_sup.mp (hmem x)
      rw [Submodule.Quotient.mk_add, (Submodule.Quotient.mk_eq_zero _).mpr ha, zero_add]
      have := Submodule.mem_map_of_mem (f := (LinearMap.range L).mkQ) hb
      rw [Submodule.map_smul''] at this
      exact Submodule.smul_mono le_rfl le_top this
    exact Submodule.Quotient.subsingleton_iff.mp
      (subsingleton_of_isDerivedCompleteModule_of_quotient_smul Λ I _
        (IsNoetherian.noetherian I) hM hMI)
  intro x
  obtain ⟨y, hy⟩ := LinearMap.range_eq_top.mp hsurjL (c x)
  obtain ⟨w, hw⟩ := hLα y
  exact ⟨w, hw.trans (congrArg c hy)⟩



end AlgebraicGeometry.ProEtale

