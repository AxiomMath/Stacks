/-- The sieve of arrows `Z ⟶ V` along which a section `y` of a sheaf of `R`-modules on
`X_proétale` restricts into the span of the restrictions of a family of global sections. -/
def globalSectionsSpanSieve (X : Scheme.{u}) {R : Type (u + 1)} [CommRing R]
    (G : Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} R)) {ι : Type}
    (σ : ι → G.obj.obj (op (Scheme.ProEt.mk (𝟙 X)))) {V : X.ProEt} (y : G.obj.obj (op V)) :
    Sieve V where
  arrows Z g := G.obj.map g.op y ∈ Submodule.span R (Set.range fun i =>
    G.obj.map ((isTerminalProEtId X).from Z).op (σ i))
  downward_closed := by
    intro Z Z' g hg g'
    have h1 := Submodule.apply_mem_span_image_of_mem_span (G.obj.map g'.op).hom hg
    rw [← Set.range_comp] at h1
    have h2 : ((G.obj.map g'.op).hom ∘ fun i =>
        (G.obj.map ((isTerminalProEtId X).from Z).op).hom (σ i)) =
        fun i => (G.obj.map ((isTerminalProEtId X).from Z').op).hom (σ i) := by
      funext i
      simp only [Function.comp_apply]
      rw [← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp,
        (isTerminalProEtId X).hom_ext (g' ≫ (isTerminalProEtId X).from Z)
          ((isTerminalProEtId X).from Z')]
    rw [h2] at h1
    rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply]
    exact h1

/-- Membership in `globalSectionsSpanSieve`. -/
theorem mem_globalSectionsSpanSieve_iff (X : Scheme.{u}) {R : Type (u + 1)} [CommRing R]
    (G : Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} R)) {ι : Type}
    (σ : ι → G.obj.obj (op (Scheme.ProEt.mk (𝟙 X)))) {V : X.ProEt} (y : G.obj.obj (op V))
    {Z : X.ProEt} (g : Z ⟶ V) :
    globalSectionsSpanSieve X G σ y g ↔ G.obj.map g.op y ∈ Submodule.span R (Set.range fun i =>
      G.obj.map ((isTerminalProEtId X).from Z).op (σ i)) := Iff.rfl

/-- **A locally constant sheaf of finite type on a weakly contractible affine scheme is locally
generated by finitely many global sections.** Let `G` be a locally constant sheaf of
`R`-modules of finite type on `X_proétale`, with `X` affine and `Γ(X, 𝒪_X)` w-contractible. There
are finitely many global sections of `G` such that every section of `G`, over any object, is
locally an `R`-linear combination of their restrictions.

The covering trivializing `G` is refined by a finite disjoint clopen decomposition of `X`
([Stacks, Tag 098F]); on each piece `G` is the constant sheaf of a finite module, whose
generators give sections over the piece; these are extended by zero to the other pieces. -/
theorem exists_finite_globalSections_locallyGenerating (X : Scheme.{u}) [IsAffine X]
    (hX : IsWContractible.{u, u} Γ(X, ⊤)) {R : Type (u + 1)} [CommRing R]
    (G : Sheaf (Scheme.ProEt.topology X) (ModuleCat.{u + 1} R))
    (hG : Stacks.ConstantSheaf.IsFiniteTypeLocallyConstant R (Scheme.ProEt.topology X) G) :
    ∃ (ι : Type) (_ : Fintype ι) (σ : ι → G.obj.obj (op (Scheme.ProEt.mk (𝟙 X)))),
      ∀ (V : X.ProEt) (y : G.obj.obj (op V)),
        globalSectionsSpanSieve X G σ y ∈ Scheme.ProEt.topology X V := by
  classical
  let J := Scheme.ProEt.topology X
  let T := Scheme.ProEt.mk (𝟙 X)
  have hT : IsAffine T.left := ‹IsAffine X›
  obtain ⟨K, Vf, v, hv, hV⟩ := hG T
  obtain ⟨n, U, f, hdec, hcov, hmem⟩ :=
    Scheme.ProEt.exists_clopenRefinement_of_isWContractible T hX (Sieve.ofArrows Vf v) hv
  choose i h hh using fun j => (Sieve.mem_ofArrows_iff Vf v (f j)).mp (hmem j)
  choose E hEfg ε using fun j => hV (i j)
  choose m gen hgen using fun j => @Module.Finite.exists_fin R (E j) _ _ _ (hEfg j)
  let M := Finset.univ.sup m
  let gen' : ∀ j, Fin M → E j := fun j k =>
    if hk : k.val < m j then gen j ⟨k.val, hk⟩ else 0
  have hgen' : ∀ j, Submodule.span R (Set.range (gen' j)) = ⊤ := by
    intro j
    rw [eq_top_iff, ← hgen j, Submodule.span_le]
    rintro _ ⟨k, rfl⟩
    have hk : k.val < M := lt_of_lt_of_le k.isLt (Finset.le_sup (Finset.mem_univ j))
    refine Submodule.subset_span ⟨⟨k.val, hk⟩, ?_⟩
    simp only [gen', dif_pos k.isLt]
  -- the constant sections over the pieces
  let t : ∀ j, Fin M → G.obj.obj (op (U j)) := fun j k =>
    (show ((J.overPullback (ModuleCat.{u + 1} R) (Vf (i j))).obj G).obj.obj
        (op (Over.mk (h j))) from
      ((ε j).some.hom.hom.app (op (Over.mk (h j))))
        (((toSheafify (J.over (Vf (i j))) ((Functor.const _).obj (E j))).app
          (op (Over.mk (h j)))) (gen' j k)))
  have hglue : ∀ k, ∃ x : G.obj.obj (op T), ∀ j, G.obj.map (f j).op x = t j k := fun k =>
    (Scheme.ProEt.existsUnique_glue_of_isClopenDecompositionCover U f hdec hcov
      ((sheafCompose J (forget (ModuleCat.{u + 1} R))).obj G) (fun j => t j k)).exists
  choose σ hσ using hglue
  refine ⟨Fin M, inferInstance, σ, fun V y => ?_⟩
  have hR0 : (Sieve.ofArrows U f).pullback ((isTerminalProEtId X).from V) ∈ J V :=
    J.pullback_stable _ hcov
  refine J.transitive hR0 _ fun Z r hr => ?_
  obtain ⟨j, a, ha⟩ := (Sieve.mem_ofArrows_iff U f (r ≫ (isTerminalProEtId X).from V)).mp hr
  let Z' : Over (Vf (i j)) := Over.mk (a ≫ h j)
  let εj := (ε j).some
  let P := (Functor.const (Over (Vf (i j)))ᵒᵖ).obj (E j)
  let w : ((constantSheaf (J.over (Vf (i j))) (ModuleCat.{u + 1} R)).obj (E j)).obj.obj (op Z') :=
    (εj.inv.hom.app (op Z')) (show ((J.overPullback (ModuleCat.{u + 1} R) (Vf (i j))).obj G).obj.obj
      (op Z') from G.obj.map r.op y)
  have hloc := Presheaf.imageSieve_mem (J.over (Vf (i j))) (toSheafify (J.over (Vf (i j))) P) w
  rw [GrothendieckTopology.mem_over_iff] at hloc
  refine J.superset_covering (fun Z'' b hb => ?_) hloc
  rw [Sieve.overEquiv_iff] at hb
  obtain ⟨e0, he0⟩ := hb
  obtain ⟨c, hc⟩ := (Submodule.mem_span_range_iff_exists_fun R).mp
    ((hgen' j).symm ▸ Submodule.mem_top : e0 ∈ Submodule.span R (Set.range (gen' j)))
  let Zo : Over (Vf (i j)) := Over.mk (b ≫ Z'.hom)
  let bo : Zo ⟶ Z' := Over.homMk b
  let dO : Zo ⟶ Over.mk (h j) := Over.homMk (b ≫ a) (by simp [Zo, Z'])
  have hgen_res : ∀ k, (εj.hom.hom.app (op Zo)) ((toSheafify (J.over (Vf (i j))) P).app (op Zo)
      (gen' j k)) = G.obj.map ((isTerminalProEtId X).from Z'').op (σ k) := by
    intro k
    have hn1 := NatTrans.naturality_apply (toSheafify (J.over (Vf (i j))) P) dO.op (gen' j k)
    have hn2 := NatTrans.naturality_apply εj.hom.hom dO.op
      (((toSheafify (J.over (Vf (i j))) P).app (op (Over.mk (h j)))) (gen' j k))
    refine (congrArg (εj.hom.hom.app (op Zo)) hn1).trans (hn2.trans ?_)
    show G.obj.map (b ≫ a).op (t j k) = _
    rw [← hσ k j, ← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp,
      (isTerminalProEtId X).hom_ext ((b ≫ a) ≫ f j) ((isTerminalProEtId X).from Z'')]
  have hw : εj.hom.hom.app (op Z') w = G.obj.map r.op y :=
    congrArg (fun φ => ModuleCat.Hom.hom (φ.hom.app (op Z'))
      (show ((J.overPullback (ModuleCat.{u + 1} R) (Vf (i j))).obj G).obj.obj (op Z') from
        G.obj.map r.op y)) εj.inv_hom_id
  have hn := NatTrans.naturality_apply εj.hom.hom bo.op w
  have h7 : ((constantSheaf (J.over (Vf (i j))) (ModuleCat.{u + 1} R)).obj (E j)).obj.map bo.op w =
      (toSheafify (J.over (Vf (i j))) P).app (op Zo) e0 := he0.symm
  have key : G.obj.map (b ≫ r).op y = ∑ k, c k • G.obj.map ((isTerminalProEtId X).from Z'').op
      (σ k) := by
    have e1 : G.obj.map (b ≫ r).op y = G.obj.map b.op (εj.hom.hom.app (op Z') w) := by
      rw [op_comp, Functor.map_comp, ConcreteCategory.comp_apply, hw]
    have e3 : εj.hom.hom.app (op Zo)
        (((constantSheaf (J.over (Vf (i j))) (ModuleCat.{u + 1} R)).obj (E j)).obj.map bo.op w) =
        (show ((J.overPullback (ModuleCat.{u + 1} R) (Vf (i j))).obj G).obj.obj (op Zo) from
          ∑ k, c k • G.obj.map ((isTerminalProEtId X).from Z'').op (σ k)) := by
      let φ : E j →ₗ[R] ((J.overPullback (ModuleCat.{u + 1} R) (Vf (i j))).obj G).obj.obj (op Zo) :=
        (εj.hom.hom.app (op Zo)).hom.comp
          (show E j →ₗ[R] (((constantSheaf (J.over (Vf (i j))) (ModuleCat.{u + 1} R)).obj
            (E j)).obj.obj (op Zo)) from ((toSheafify (J.over (Vf (i j))) P).app (op Zo)).hom)
      have hφ : φ e0 = ∑ k, c k • φ (gen' j k) := by
        rw [← hc, map_sum]
        simp only [map_smul]
      rw [h7]
      exact hφ.trans (Finset.sum_congr rfl fun k _ => congrArg (c k • ·) (hgen_res k))
    exact e1.trans (hn.symm.trans e3)
  show G.obj.map (b ≫ r).op y ∈ _
  rw [key]
  exact (Submodule.mem_span_range_iff_exists_fun R).2 ⟨c, rfl⟩


attribute [local instance] HasDerivedCategory.standard
  SheafOfModules.hasSheafify_commRingCat
