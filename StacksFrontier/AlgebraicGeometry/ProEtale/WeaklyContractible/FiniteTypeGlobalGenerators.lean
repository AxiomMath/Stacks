module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FreeSheafSections
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.FreeSheafSectionsSupplement
public import StacksFrontier.AlgebraicGeometry.ProEtale.WeaklyContractible.LocallyConstantTrivialization

/-!
# Global generators of a sheaf of modules of finite type on a weakly contractible affine

Let `X` be an affine scheme which is weakly contractible (Stacks 090L) and `R` a sheaf of rings
on the small pro-étale site `X_proét`. A sheaf of `R`-modules `M` of finite type is generated by
finitely many global sections: there is a finite family of global sections of `M` such that
every section of `M` over any object is, on a covering sieve, an `R`-linear combination of their
restrictions. Consequently the morphism `R^{⊕ n} ⟶ M` they define is surjective on sections over
every affine object with w-contractible ring of global sections.

This is the first step of the proof of Stacks 09BZ: there the sheaf is `F/IF`, locally constant of
finite type, and its finitely many global generators are lifted to sections of `F`.

## Main definitions

* `AlgebraicGeometry.Scheme.ProEt.sectionsOfMkId`: the global section of a presheaf of modules
  determined by a section over the final object `X` of `X_proét`.

## Main results

* `AlgebraicGeometry.Scheme.ProEt.exists_sections_forall_exists_mem_span_of_isFiniteTypeSections`:
  a presheaf of modules on `X_proét`, over any presheaf of rings, whose underlying presheaf of
  sets is a sheaf and which is of finite type in the sense of sections, is locally generated by
  finitely many global sections.
* `AlgebraicGeometry.Scheme.ProEt.exists_sections_forall_exists_mem_span_of_isFiniteType`: a sheaf
  of modules of finite type on `X_proét` is locally generated by finitely many global sections.
* `AlgebraicGeometry.Scheme.ProEt.exists_sections_span_eq_top_of_isFiniteType`: such sections
  generate the module of sections over every w-contractible affine object.
* `AlgebraicGeometry.Scheme.ProEt.exists_epi_comp_of_isFiniteType`: for an epimorphism `F ⟶ G`
  with `G` of finite type, a finite free sheaf of modules maps to `F` with epimorphic composite.

## Implementation notes

The proof is the source's. A covering of the final object `X` of `X_proét` on whose members `M`
has finitely many local generators is refined by a decomposition `X = ∐ X_i` into disjoint
clopen subschemes (Stacks 098H, since the ring of global sections of `X` is w-contractible); the
generators restricted to the `X_i` extend to global sections because the sections over `X` are
the families of sections over the `X_i`.

## References

* [Stacks Project, Tag 09BZ](https://stacks.math.columbia.edu/tag/09BZ)
* [Stacks Project, Tag 098H](https://stacks.math.columbia.edu/tag/098H)
* [Stacks Project, Tag 03DL](https://stacks.math.columbia.edu/tag/03DL)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite ProetaleWContractible SheafOfModules

universe t t' u

namespace AlgebraicGeometry.Scheme.ProEt

variable {X : Scheme.{u}} {R : Sheaf (ProEt.topology X) RingCat.{t}}

/-- The morphism from an object of `X_proét` to its final object `X`. -/
def toMkId (V : X.ProEt) : V ⟶ ProEt.mk (𝟙 X) :=
  MorphismProperty.Over.homMk V.hom (Category.comp_id _) trivial

/-- Morphisms to the final object `X` of `X_proét` are unique. -/
theorem hom_ext_mkId {V : X.ProEt} (f g : V ⟶ ProEt.mk (𝟙 X)) : f = g := by
  apply (MorphismProperty.Comma.forgetFullyFaithful
    (Functor.id Scheme.{u}) (Functor.fromPUnit X) _).map_injective
  refine CommaMorphism.ext ?_ (Subsingleton.elim _ _)
  exact ((Category.comp_id f.left).symm.trans f.w).trans
    ((Category.comp_id g.left).symm.trans g.w).symm

/-- The global section of a presheaf of modules on `X_proét` determined by a section over the
final object `X`. -/
noncomputable def sectionsOfMkId {A : (X.ProEt)ᵒᵖ ⥤ RingCat.{t}}
    (M : _root_.PresheafOfModules.{t'} A)
    (x : M.obj (op (ProEt.mk (𝟙 X)))) : M.sections :=
  PresheafOfModules.sectionsMk (fun V => M.map (toMkId V.unop).op x)
    (fun V V' f => by
      rw [← PresheafOfModules.map_comp_apply]
      exact M.congr_map_apply (Quiver.Hom.unop_inj (hom_ext_mkId _ _)) x)

/-- The value of `sectionsOfMkId M x` over an object is the restriction of `x` to it. -/
theorem sectionsOfMkId_eval {A : (X.ProEt)ᵒᵖ ⥤ RingCat.{t}}
    (M : _root_.PresheafOfModules.{t'} A)
    (x : M.obj (op (ProEt.mk (𝟙 X)))) {V : X.ProEt} (g : V ⟶ ProEt.mk (𝟙 X)) :
    (sectionsOfMkId M x).eval (op V) = M.map g.op x :=
  M.congr_map_apply (congrArg Quiver.Hom.op (hom_ext_mkId _ _)) x

/-- **A presheaf of modules of finite type on a weakly contractible affine is locally generated by
finitely many global sections.** Let `X` be an affine scheme which is weakly contractible and
`M` a presheaf of modules over a presheaf of rings `A` on `X_proét` whose underlying presheaf of
sets is a sheaf, and which is of finite type in the sense of sections
(`Stacks.SheafOfModules.IsFiniteTypeSections`). There are finitely many global sections of `M`
such that every section over any object is, on a covering sieve, an `A`-linear combination of
their restrictions. The ring `A` need not be a sheaf: for the constant presheaf of rings this
is the statement for sheaves of modules over a fixed ring. -/
theorem exists_sections_forall_exists_mem_span_of_isFiniteTypeSections [IsAffine X]
    (hX : IsWeaklyContractibleObj X) {A : (X.ProEt)ᵒᵖ ⥤ RingCat.{t}}
    (M : _root_.PresheafOfModules.{t'} A)
    (hM : Presheaf.IsSheaf (ProEt.topology X)
      (M.presheaf ⋙ CategoryTheory.forget AddCommGrpCat.{t'}))
    [Stacks.SheafOfModules.IsFiniteTypeSections (ProEt.topology X) M] :
    ∃ (n : ℕ) (s : Fin n → M.sections), ∀ (V : X.ProEt) (m : M.obj (op V)),
      ∃ S ∈ ProEt.topology X V, ∀ ⦃W : X.ProEt⦄ (g : W ⟶ V), S g →
        M.restrictₛₗ g.op m ∈ Submodule.span (A.obj (op W))
          (Set.range fun i => (s i).eval (op W)) := by
  classical
  obtain ⟨I, U, hU, hgen⟩ :=
    Stacks.SheafOfModules.IsFiniteTypeSections.exists_generators (J := ProEt.topology X) (M := M)
  choose k σ hσ using hgen
  have : IsAffine (ProEt.mk (𝟙 X)).left := inferInstanceAs (IsAffine X)
  obtain ⟨n, V, f, hdec, hf, hR⟩ := exists_clopenDecomposition_of_isWContractible
    (ProEt.mk (𝟙 X)) (isWContractible_of_isWeaklyContractible X hX) _ (hU _)
  have hR' : ∀ i, ∃ j, Nonempty (clopenDecompositionObj (ProEt.mk (𝟙 X)) f hf i ⟶ U j) := hR
  choose j a using hR'
  let ι := Σ i : Fin n, Fin (k (j i))
  let t : (p : ι) → M.obj (op (clopenDecompositionObj (ProEt.mk (𝟙 X)) f hf p.1)) :=
    fun p => M.map (a p.1).some.op (σ (j p.1) p.2)
  let G : Sheaf (ProEt.topology X) (Type t') :=
    ⟨M.presheaf ⋙ CategoryTheory.forget AddCommGrpCat.{t'}, hM⟩
  have hext : ∀ p : ι, ∃ x : M.obj (op (ProEt.mk (𝟙 X))),
      M.map (clopenDecompositionHom (ProEt.mk (𝟙 X)) f hf p.1).op x = t p := by
    intro p
    let y : (i : Fin n) → M.obj (op (clopenDecompositionObj (ProEt.mk (𝟙 X)) f hf i)) :=
      Function.update (fun _ => 0) p.1 (t p)
    obtain ⟨x, hx⟩ := (bijective_restrict_clopenDecomposition G (ProEt.mk (𝟙 X)) f hdec hf).2 y
    exact ⟨x, (congrFun hx p.1).trans (Function.update_self _ _ _)⟩
  choose x hx using hext
  let e := Fintype.equivFin ι
  refine ⟨Fintype.card ι, fun q => sectionsOfMkId M (x (e.symm q)), fun V₀ m => ?_⟩
  have key : ∀ (Y : X.ProEt) (g : Y ⟶ V₀),
      ((Sieve.ofArrows _ (clopenDecompositionHom (ProEt.mk (𝟙 X)) f hf)).pullback
        (toMkId V₀)).arrows g →
      ∃ S ∈ ProEt.topology X Y, ∀ ⦃W : X.ProEt⦄ (h : W ⟶ Y), S h →
        M.restrictₛₗ (h ≫ g).op m ∈ Submodule.span (A.obj (op W))
          (Set.range fun q => (sectionsOfMkId M (x (e.symm q))).eval (op W)) := by
    intro Y g hg
    obtain ⟨i, b, hb⟩ := (Sieve.mem_ofArrows_iff _ _ _).mp hg
    obtain ⟨S', hS', H⟩ := hσ (j i) Y (b ≫ (a i).some) (M.restrictₛₗ g.op m)
    refine ⟨S', hS', fun W h hh => ?_⟩
    obtain ⟨c, hc⟩ := H W h hh
    have e1 : M.restrictₛₗ (h ≫ g).op m =
        M.restrictₛₗ h.op (M.restrictₛₗ g.op m) := by
      rw [op_comp]
      exact PresheafOfModules.map_comp_apply _ _ _ _
    rw [e1, ← hc]
    refine Submodule.sum_mem _ fun l _ => Submodule.smul_mem _ _
      (Submodule.subset_span ⟨e ⟨i, l⟩, ?_⟩)
    show (sectionsOfMkId M (x (e.symm (e ⟨i, l⟩)))).eval (op W) = _
    rw [Equiv.symm_apply_apply, sectionsOfMkId_eval M _ (h ≫ b ≫
      clopenDecompositionHom (ProEt.mk (𝟙 X)) f hf i)]
    have e2 := PresheafOfModules.map_comp_apply M
      (clopenDecompositionHom (ProEt.mk (𝟙 X)) f hf i).op (h ≫ b).op (x ⟨i, l⟩)
    have e3 := PresheafOfModules.map_comp_apply M (a i).some.op (h ≫ b).op (σ (j i) l)
    rw [← op_comp, Category.assoc] at e2 e3
    exact e2.trans ((congrArg (M.map (h ≫ b).op) (hx ⟨i, l⟩)).trans e3.symm)
  choose S hS hSm using key
  exact ⟨_, (ProEt.topology X).bind_covering
    ((ProEt.topology X).pullback_stable _
      (sieve_ofArrows_clopenDecomposition_mem_topology _ f hdec hf)) hS,
    fun W g ⟨Y, h, g', hg', hh, hcomp⟩ => hcomp ▸ hSm Y g' hg' h hh⟩

/-- **A sheaf of modules of finite type on a weakly contractible affine is locally generated by
finitely many global sections.** Let `X` be an affine scheme which is weakly contractible and
`M` a sheaf of modules of finite type over a sheaf of rings `R` on `X_proét`. There are finitely
many global sections of `M` such that every section over any object is, on a covering sieve, an
`R`-linear combination of their restrictions. This is
`AlgebraicGeometry.Scheme.ProEt.exists_sections_forall_exists_mem_span_of_isFiniteTypeSections`
for the underlying presheaf of modules. -/
theorem exists_sections_forall_exists_mem_span_of_isFiniteType [IsAffine X]
    (hX : IsWeaklyContractibleObj X)
    [∀ V : X.ProEt, HasSheafify ((ProEt.topology X).over V) AddCommGrpCat.{t}]
    [∀ V : X.ProEt, ((ProEt.topology X).over V).WEqualsLocallyBijective AddCommGrpCat.{t}]
    (M : SheafOfModules.{t} R) [M.IsFiniteType] :
    ∃ (n : ℕ) (s : Fin n → M.sections), ∀ (V : X.ProEt) (m : M.val.obj (op V)),
      ∃ S ∈ ProEt.topology X V, ∀ ⦃W : X.ProEt⦄ (g : W ⟶ V), S g →
        M.val.restrictₛₗ g.op m ∈ Submodule.span (R.obj.obj (op W))
          (Set.range fun i => (s i).eval (op W)) :=
  have := Stacks.SheafOfModules.isFiniteTypeSections_of_isFiniteType (J := ProEt.topology X) M
  exists_sections_forall_exists_mem_span_of_isFiniteTypeSections hX M.val
    ((SheafOfModules.toSheaf R ⋙
      sheafCompose _ (CategoryTheory.forget AddCommGrpCat.{t})).obj M).cond

/-- Reindexing a family of global sections by `ULift (Fin n)` does not change the range of its
values. -/
private theorem range_eval_ulift {M : SheafOfModules.{t} R} {n : ℕ} (s : Fin n → M.sections)
    (W : X.ProEt) : (Set.range fun i : ULift.{t} (Fin n) => (s i.down).eval (op W)) =
      Set.range fun i => (s i).eval (op W) :=
  Equiv.ulift.surjective.range_comp (fun i => (s i).eval (op W))

/-- Local generation by `s` implies local generation by `s` reindexed by `ULift (Fin n)`. -/
private theorem span_range_eval_ulift_of_forall_exists_mem_span
    {M : SheafOfModules.{t} R} {n : ℕ} (s : Fin n → M.sections)
    (hs : ∀ (V : X.ProEt) (m : M.val.obj (op V)),
      ∃ S ∈ ProEt.topology X V, ∀ ⦃W : X.ProEt⦄ (g : W ⟶ V), S g →
        M.val.restrictₛₗ g.op m ∈ Submodule.span (R.obj.obj (op W))
          (Set.range fun i => (s i).eval (op W))) :
    ∀ (V : X.ProEt) (m : M.val.obj (op V)),
      ∃ S ∈ ProEt.topology X V, ∀ ⦃W : X.ProEt⦄ (g : W ⟶ V), S g →
        M.val.restrictₛₗ g.op m ∈ Submodule.span (R.obj.obj (op W))
          (Set.range fun i : ULift.{t} (Fin n) => (s i.down).eval (op W)) := by
  intro V m
  obtain ⟨S, hS, h⟩ := hs V m
  refine ⟨S, hS, fun W g hg => ?_⟩
  rw [range_eval_ulift]
  exact h g hg

/-- **A sheaf of modules of finite type on a weakly contractible affine is generated by
finitely many global sections on every w-contractible affine.** Let `X` be an affine scheme which
is weakly contractible and `M` a sheaf of modules of finite type on `X_proét`. There are finitely
many global sections of `M` which generate it locally, and whose values generate the module of
sections of `M` over every affine object of `X_proét` with w-contractible ring of global
sections. -/
theorem exists_sections_span_eq_top_of_isFiniteType [IsAffine X]
    (hX : IsWeaklyContractibleObj X)
    [HasWeakSheafify (ProEt.topology X) AddCommGrpCat.{t}]
    [(ProEt.topology X).WEqualsLocallyBijective AddCommGrpCat.{t}]
    [(ProEt.topology X).HasSheafCompose (CategoryTheory.forget AddCommGrpCat.{t})]
    [∀ V : X.ProEt, HasSheafify ((ProEt.topology X).over V) AddCommGrpCat.{t}]
    [∀ V : X.ProEt, ((ProEt.topology X).over V).WEqualsLocallyBijective AddCommGrpCat.{t}]
    (M : SheafOfModules.{t} R) [M.IsFiniteType] :
    ∃ (n : ℕ) (s : Fin n → M.sections), (∀ (V : X.ProEt) (m : M.val.obj (op V)),
      ∃ S ∈ ProEt.topology X V, ∀ ⦃W : X.ProEt⦄ (g : W ⟶ V), S g →
        M.val.restrictₛₗ g.op m ∈ Submodule.span (R.obj.obj (op W))
          (Set.range fun i => (s i).eval (op W))) ∧
      ∀ (W : X.ProEt) [IsAffine W.left], IsWContractible.{u, u} Γ(W.left, ⊤) →
        Submodule.span (R.obj.obj (op W)) (Set.range fun i => (s i).eval (op W)) = ⊤ := by
  obtain ⟨n, s, hs⟩ := exists_sections_forall_exists_mem_span_of_isFiniteType hX M
  refine ⟨n, s, hs, fun W _ hW => ?_⟩
  have hs' := span_range_eval_ulift_of_forall_exists_mem_span s hs
  have h := Stacks.SheafOfModules.span_range_eval_eq_top (fun i : ULift.{t} (Fin n) => s i.down)
    hs' W (fun φ hφ => surjective_app_of_isWContractible_of_concrete W hW φ hφ)
  rwa [range_eval_ulift] at h

/-- **Lifting global generators along an epimorphism.** Let `X` be an affine scheme which is
weakly contractible and `π : F ⟶ G` an epimorphism of sheaves of modules on `X_proét` with `G`
of finite type. There is a morphism `α : R^{⊕ n} ⟶ F` from a finite free sheaf of modules whose
composite with `π` is an epimorphism: the finitely many global generators of `G` lift to global
sections of `F`, global sections being exact on `X_proét`. -/
theorem exists_epi_comp_of_isFiniteType [IsAffine X] (hX : IsWeaklyContractibleObj X)
    [HasSheafify (ProEt.topology X) AddCommGrpCat.{t}]
    [(ProEt.topology X).WEqualsLocallyBijective AddCommGrpCat.{t}]
    [(ProEt.topology X).HasSheafCompose (CategoryTheory.forget AddCommGrpCat.{t})]
    [∀ V : X.ProEt, HasSheafify ((ProEt.topology X).over V) AddCommGrpCat.{t}]
    [∀ V : X.ProEt, ((ProEt.topology X).over V).WEqualsLocallyBijective AddCommGrpCat.{t}]
    {F G : SheafOfModules.{t} R} (π : F ⟶ G) [Epi π] [G.IsFiniteType] :
    ∃ (n : ℕ) (α : SheafOfModules.free (R := R) (ULift.{t} (Fin n)) ⟶ F), Epi (α ≫ π) := by
  obtain ⟨n, s, hs⟩ := exists_sections_forall_exists_mem_span_of_isFiniteType hX G
  have hπ : Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf R).map π) :=
    ⟨fun {V} m => by
      obtain ⟨S, hS, h⟩ := Stacks.SheafOfModules.EpiMono.exists_covering_of_epi π m
      exact (ProEt.topology X).superset_covering (fun W g hg => h g hg) hS⟩
  have hlift : ∀ i, ∃ y : F.val.obj (op (ProEt.mk (𝟙 X))),
      π.val.app (op (ProEt.mk (𝟙 X))) y = (s i).eval (op (ProEt.mk (𝟙 X))) := fun i =>
    surjective_app_mk_id_of_isWeaklyContractibleObj hX ((SheafOfModules.toSheaf R).map π) hπ _
  choose y hy using hlift
  have hsec : ∀ i, SheafOfModules.sectionsMap π (sectionsOfMkId F.val (y i)) = s i := fun i => by
    ext V
    show π.val.app V (F.val.map (toMkId V.unop).op (y i)) = (s i).eval V
    rw [PresheafOfModules.naturality_apply, hy]
    exact (s i).property _
  refine ⟨n, F.freeHomEquiv.symm fun i => sectionsOfMkId F.val (y i.down), ?_⟩
  have key :
      (F.freeHomEquiv.symm fun i : ULift.{t} (Fin n) => sectionsOfMkId F.val (y i.down)) ≫ π =
      G.freeHomEquiv.symm fun i : ULift.{t} (Fin n) => s i.down := by
    apply G.freeHomEquiv.injective
    rw [Equiv.apply_symm_apply]
    funext i
    exact (congrArg (SheafOfModules.sectionsMap π)
      (congrFun (F.freeHomEquiv.apply_symm_apply _) i)).trans (hsec i.down)
  rw [key]
  refine Stacks.SheafOfModules.epi_freeHomEquiv_symm (fun i : ULift.{t} (Fin n) => s i.down)
    fun V m => ?_
  exact span_range_eval_ulift_of_forall_exists_mem_span s hs V m

end AlgebraicGeometry.Scheme.ProEt
