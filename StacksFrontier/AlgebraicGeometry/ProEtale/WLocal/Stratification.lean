module

public import Mathlib.AlgebraicGeometry.Limits
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.ProEtale.WLocal.Localization

/-!
# The ring and the closed subscheme of a finite vanishing-pattern stratification

For a finite set `E` of elements of a commutative ring `A`, each decomposition of `E` into
nonvanishing and vanishing elements determines a locally closed stratum of `Spec A`. The ring
`A_E` is the product of the localizations associated to these strata, and the disjoint union
of the coordinate schemes of the strata maps as a closed subscheme into `Spec A_E`.

## Main definitions

* `AlgebraicGeometry.ProEtale.stratumIdeal` is the ideal generated by the vanishing elements.
* `AlgebraicGeometry.ProEtale.stratumOpenElement` is the product of the nonvanishing elements.
* `AlgebraicGeometry.ProEtale.stratificationRing` is the product of the rings attached to all
  strata.
* `AlgebraicGeometry.ProEtale.closedStrata` is the coproduct of the locally closed strata.
* `AlgebraicGeometry.ProEtale.closedStrataMap` is its canonical map to the spectrum of the
  stratification ring.

## Main results

* `AlgebraicGeometry.ProEtale.closedStrataMap_isClosedImmersion` says this map realizes the
  coproduct as a closed subscheme.
* `AlgebraicGeometry.ProEtale.closedPoints_mem_closedStrataMap_range` says every closed point
  of the ambient affine scheme belongs to this subscheme.

## Implementation notes

A disjoint decomposition `E = E' ⊔ E''` is indexed by the subset `E' ⊆ E`; its complement in
`E` is `E''`. The corresponding factor is the localization along `D(∏ E') ∩ V(E'')`. Thus the
displayed equation defines the ring, rather than asserting an equality between two separately
chosen rings. The coproduct map is assembled componentwise from the closed immersions of the
strata and the evaluation maps out of the product ring.

## References

* [Stacks Project, Tag 096Z](https://stacks.math.columbia.edu/tag/096Z)
* [Stacks Project, Tag 0971](https://stacks.math.columbia.edu/tag/0971)
-/

@[expose] public noncomputable section

open CategoryTheory Limits

namespace AlgebraicGeometry.ProEtale

universe u

variable {A : Type u} [CommRing A]

/-- The ideal of the elements required to vanish on a stratum. -/
def stratumIdeal (E : Finset A) (E' : {E' : Finset A // E' ⊆ E}) : Ideal A :=
  by classical exact Ideal.span (↑(E \ E'.val) : Set A)

/-- The distinguished open element for a stratum, namely the product of the elements required
not to vanish. -/
def stratumOpenElement (E' : Finset A) : A := E'.prod id

/-- The ring `A_E`, formed as the product of the localizations attached to all
vanishing-pattern strata of `Spec A`. -/
@[stacks 096Z] abbrev stratificationRing (E : Finset A) : Type u :=
  ∀ E' : {E' : Finset A // E' ⊆ E},
    localizationRing (stratumIdeal E E') (stratumOpenElement E'.val)

/-- The subsets of a finite set form a finite type. -/
private instance (E : Finset A) : Finite {E' : Finset A // E' ⊆ E} :=
  Finite.of_injective
    (fun i => (⟨i.val, Finset.mem_powerset.mpr i.property⟩ : {s // s ∈ E.powerset}))
    (by
      intro i j h
      apply Subtype.ext
      exact congrArg (fun k : {s // s ∈ E.powerset} => k.val) h)

/-- The coordinate ring of the locally closed stratum indexed by `E' ⊆ E`. -/
abbrev stratumCoordinateRing (E : Finset A)
    (E' : {E' : Finset A // E' ⊆ E}) : Type u :=
  locallyClosedCoordinateRing (stratumIdeal E E') (stratumOpenElement E'.val)

/-- The coproduct `Z_E` of the coordinate schemes of all vanishing patterns. -/
@[stacks 0971 "the coproduct"]
def closedStrata (E : Finset A) : Scheme.{u} :=
  ∐ fun E' : {E' : Finset A // E' ⊆ E} => Spec (.of (stratumCoordinateRing E E'))

/-- The canonical map from the coproduct of strata to `X_E`. -/
@[stacks 0971 "the map"]
def closedStrataMap (E : Finset A) :
    closedStrata E ⟶ Spec (.of (stratificationRing E)) :=
  Sigma.desc (fun E' =>
    Spec.map (CommRingCat.ofHom
      (localizationToCoordinateRing (stratumIdeal E E')
        (stratumOpenElement E'.val))) ≫
    Spec.map (CommRingCat.ofHom
      (Pi.evalRingHom
        (fun E' : {E' : Finset A // E' ⊆ E} =>
          localizationRing (stratumIdeal E E')
            (stratumOpenElement E'.val)) E')))

/-- `Z_E` is a closed subscheme of `X_E`. -/
@[stacks 0971 "closed immersion"]
theorem closedStrataMap_isClosedImmersion (E : Finset A) :
    IsClosedImmersion (closedStrataMap E) := by
  classical
  let C : {E' : Finset A // E' ⊆ E} → Type u := fun E' =>
    stratumCoordinateRing E E'
  let R : {E' : Finset A // E' ⊆ E} → Type u := fun E' =>
    localizationRing (stratumIdeal E E') (stratumOpenElement E'.val)
  let g : (∀ i, R i) →+* (∀ i, C i) :=
    RingHom.pi fun i => (localizationToCoordinateRing
      (stratumIdeal E i) (stratumOpenElement i.val)).comp
        (Pi.evalRingHom R i)
  have hcoord (i : {E' : Finset A // E' ⊆ E}) :
      Function.Surjective (localizationToCoordinateRing
        (stratumIdeal E i) (stratumOpenElement i.val)) := by
    let f := localizationToCoordinateRing (stratumIdeal E i) (stratumOpenElement i.val)
    have : IsClosedImmersion (Spec.map (CommRingCat.ofHom f)) :=
      localizationToCoordinateRing_isClosedImmersion
        (stratumIdeal E i) (stratumOpenElement i.val)
    intro y
    obtain ⟨x, hx⟩ := (IsClosedImmersion.isAffine_surjective_of_isAffine
      (Spec.map (CommRingCat.ofHom f))).2 ((Scheme.ΓSpecIso (.of (C i))).inv y)
    refine ⟨(Scheme.ΓSpecIso (.of (R i))).hom x, ?_⟩
    have hn' : f ((Scheme.ΓSpecIso (.of (R i))).hom x) =
        (Scheme.ΓSpecIso (.of (C i))).hom ((Spec.map (CommRingCat.ofHom f)).appTop x) :=
      (congrArg (fun k : CommRingCat.Hom _ _ => k.hom x)
        (Scheme.ΓSpecIso_naturality (CommRingCat.ofHom f))).symm
    rw [hx] at hn'
    simpa using hn'
  have hg : Function.Surjective g := by
    intro y
    choose x hx using fun i => hcoord i (y i)
    exact ⟨x, funext fun i => by simp [g, RingHom.pi_apply, hx i]⟩
  have hmap : closedStrataMap E =
      sigmaSpec (fun i => CommRingCat.of (C i)) ≫
        Spec.map (CommRingCat.ofHom g) := by
    refine Sigma.hom_ext _ _ fun i => ?_
    rw [closedStrataMap, Sigma.ι_desc, ← Category.assoc, sigmaSpec, Sigma.ι_desc,
      ← Spec.map_comp, ← Spec.map_comp]
    congr 1
  rw [hmap]
  have : IsClosedImmersion (sigmaSpec (fun i => CommRingCat.of (C i))) := by
    infer_instance
  have : IsClosedImmersion (Spec.map (CommRingCat.ofHom g)) :=
    IsClosedImmersion.spec_of_surjective _ hg
  show IsClosedImmersion
    (sigmaSpec (fun i => CommRingCat.of (C i)) ≫ Spec.map (CommRingCat.ofHom g))
  infer_instance

/-- Every closed point of `X_E` belongs to `Z_E`. -/
@[stacks 0971 "closed points"]
theorem closedPoints_mem_closedStrataMap_range (E : Finset A)
    (x : Spec (.of (stratificationRing E))) (hx : IsClosed {x}) :
    x ∈ Set.range (closedStrataMap E) := by
  classical
  let R : {E' : Finset A // E' ⊆ E} → Type u := fun E' =>
    localizationRing (stratumIdeal E E') (stratumOpenElement E'.val)
  obtain ⟨i, q, hxq⟩ := PrimeSpectrum.exists_comap_evalRingHom_eq (R := R) x
  let I := stratumIdeal E i
  let f := stratumOpenElement i.val
  have hqClosed : IsClosed ({q} : Set (PrimeSpectrum (R i))) := by
    have hinj : Function.Injective (PrimeSpectrum.comap (Pi.evalRingHom R i)) :=
      PrimeSpectrum.comap_injective_of_surjective _ (Function.surjective_eval i)
    have heq : PrimeSpectrum.comap (Pi.evalRingHom R i) ⁻¹' {x} = {q} := by
      ext y
      simp only [Set.mem_preimage, Set.mem_singleton_iff]
      exact ⟨fun h => hinj (h.trans hxq.symm), by rintro rfl; exact hxq⟩
    rw [← heq]
    exact hx.preimage (PrimeSpectrum.continuous_comap _)
  have hp : PrimeSpectrum.comap (algebraMap A (localizationRing I f)) q ∈
      locallyClosedPoints I f := by
    have hpRange : PrimeSpectrum.comap (algebraMap A (localizationRing I f)) q ∈
        Set.range (PrimeSpectrum.comap (algebraMap A (localizationRing I f))) := ⟨q, rfl⟩
    rw [localization_comap_range I f] at hpRange
    rcases hpRange with ⟨q₀, hq₀, hspec⟩
    have hq₀Range :
        q₀ ∈ Set.range (PrimeSpectrum.comap (algebraMap A (localizationRing I f))) := by
      rw [localization_comap_range I f]
      exact ⟨q₀, hq₀, specializes_rfl⟩
    obtain ⟨q₁, hq₁⟩ := hq₀Range
    have hspecLoc : q ⤳ q₁ := by
      apply (PrimeSpectrum.localization_comap_isEmbedding (localizationRing I f)
        (localizationSubmonoid I f)).isInducing.specializes_iff.mp
      simpa [hq₁] using hspec
    have hq₁eq : q₁ = q := Set.mem_singleton_iff.mp (hspecLoc.mem_closed hqClosed (by simp))
    rwa [← hq₁eq, hq₁]
  rw [← locallyClosedCoordinateMap_range] at hp
  obtain ⟨z, hz⟩ := hp
  let zL := PrimeSpectrum.comap (localizationToCoordinateRing I f) z
  have hzL : zL = q := by
    apply PrimeSpectrum.localization_comap_injective (localizationRing I f)
      (localizationSubmonoid I f)
    rw [← PrimeSpectrum.comap_comp_apply,
      show (localizationToCoordinateRing I f).comp (algebraMap A (localizationRing I f)) =
        locallyClosedCoordinateMap I f from IsLocalization.lift_comp _, hz]
  let family : {E' : Finset A // E' ⊆ E} → Scheme :=
    fun E' => Spec (.of (stratumCoordinateRing E E'))
  change PrimeSpectrum (∀ j, R j) at x
  change PrimeSpectrum (stratumCoordinateRing E i) at z
  refine ⟨(Limits.Sigma.ι family i).base z, ?_⟩
  have hfac : (Limits.Sigma.ι family i ≫ closedStrataMap E) z =
      (Spec.map (CommRingCat.ofHom (localizationToCoordinateRing I f)) ≫
        Spec.map (CommRingCat.ofHom (Pi.evalRingHom R i))) z := by
    rw [closedStrataMap, Sigma.ι_desc]
  show ((Limits.Sigma.ι family i ≫ closedStrataMap E) z) = x
  rw [hfac]
  show PrimeSpectrum.comap (Pi.evalRingHom R i) zL = x
  rw [hzL, hxq]

end AlgebraicGeometry.ProEtale

end
