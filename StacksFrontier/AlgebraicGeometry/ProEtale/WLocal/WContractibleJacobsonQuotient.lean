module

public import StacksFrontier.AlgebraicGeometry.ProEtale.IndEtale.JacobsonQuotientRetraction
public import StacksFrontier.AlgebraicGeometry.ProEtale.WLocal.WContractibleFinite
public import StacksFrontier.RingTheory.Spectrum.Prime.Constructible.Defs

/-!
# Quotients of a w-contractible ring

W-contractibility passes to a quotient `A ⧸ I` whenever the ideal `I` is contained in the
Jacobson radical of `A`, and more generally whenever the open complement of the zero locus of
`I` in `Spec A` is quasi-compact.

## Main results

* `AlgebraicGeometry.ProEtale.isWContractible_of_surjective_of_fg_ker` and
  `AlgebraicGeometry.ProEtale.isWContractible_of_ringEquiv`: w-contractibility passes along a
  surjective ring map with finitely generated kernel, in particular along an isomorphism.
* `AlgebraicGeometry.ProEtale.isWContractible_quotient_of_le_ringJacobson`: w-contractibility
  passes to the quotient by an ideal inside the Jacobson radical.
* `AlgebraicGeometry.ProEtale.isWContractible_quotient_of_isCompact_compl_zeroLocus`:
  w-contractibility passes to a quotient whose zero locus has quasi-compact open complement.

## Implementation notes

The first result is Stacks 0986 applied to a surjection: a surjective ring map makes the target a
finite module over the source, and a finitely generated kernel makes it a finitely presented
algebra. In particular it transports w-contractibility along a ring isomorphism, whose kernel is
the zero ideal.

For an ideal `I` inside the Jacobson radical the quotient is handled by Stacks 0982 and the
lifting theory of Stacks 097P: a faithfully flat ind-étale `A ⧸ I`-algebra `V` lifts to an
ind-étale `A`-algebra `L` with `L ⧸ IL = V`, the lift is flat, and every maximal ideal of `A`
contains `I`, so a prime of `V` over the corresponding prime of `A ⧸ I` contracts to a prime of
`L` over that maximal ideal; hence `L` is faithfully flat and w-contractibility of `A` retracts
it. Because the lift is fully faithful and the lift of the trivial algebra `A ⧸ I` is `A` itself
(Stacks 09AC), such a retraction of `L` is the same datum as a retraction of `V`.

The general case reduces to the Jacobson one by Stacks 00F6: a quasi-compact open complement of
the zero locus of `I` exhibits a finitely generated subideal `J ≤ I` with the same zero locus, so
`A ⧸ J` is w-contractible by Stacks 0986, the image of `I` in `A ⧸ J` consists of nilpotents and
hence lies in the Jacobson radical, and `(A ⧸ J) ⧸ I(A ⧸ J)` is `A ⧸ I`.

## References

* [Stacks Project, Tag 00F6](https://stacks.math.columbia.edu/tag/00F6)
* [Stacks Project, Tag 0982](https://stacks.math.columbia.edu/tag/0982)
* [Stacks Project, Tag 0986](https://stacks.math.columbia.edu/tag/0986)
* [Stacks Project, Tag 097P](https://stacks.math.columbia.edu/tag/097P)
* [Stacks Project, Tag 09AC](https://stacks.math.columbia.edu/tag/09AC)
-/

@[expose] public section

open CategoryTheory

namespace AlgebraicGeometry.ProEtale

universe u

/-- **W-contractibility passes along a surjective ring map with finitely generated kernel.**
The target is then a finite module over the source, being generated by the image of `1`, and a
finitely presented algebra over it, the kernel of the presentation being finitely generated; so
Stacks 0986 applies. -/
theorem isWContractible_of_surjective_of_fg_ker {A C : Type u} [CommRing A] [CommRing C]
    (f : A →+* C) (hf : Function.Surjective f) (hker : (RingHom.ker f).FG)
    (hA : ProetaleWContractible.IsWContractible.{u, u} A) :
    ProetaleWContractible.IsWContractible.{u, u} C := by
  let : Algebra A C := f.toAlgebra
  have : Module.Finite A C := Module.Finite.of_surjective (Algebra.linearMap A C) hf
  have : Algebra.FinitePresentation A C := RingHom.FinitePresentation.of_surjective f hf hker
  exact isWContractible_of_finite_of_finitePresentation A C hA

/-- An ideal contained in the Jacobson radical is contained in every maximal ideal. -/
private theorem le_of_le_ringJacobson_of_isMaximal {A : Type u} [CommRing A] {I : Ideal A}
    (hI : I ≤ Ring.jacobson A) {m : Ideal A} (hm : m.IsMaximal) : I ≤ m := by
  rw [Ring.jacobson_eq_sInf_isMaximal] at hI
  exact hI.trans (sInf_le hm)

/-- **W-contractibility passes to the quotient by an ideal inside the Jacobson radical.**

A faithfully flat ind-étale `A ⧸ I`-algebra `V` is lifted across the quotient to an ind-étale
`A`-algebra `L` by Stacks 097P. The transposed counit of that lifting adjunction is a ring map
`L → V` over the quotient map of `A`, so a prime of `V` above a prime of `A ⧸ I` contracts to a
prime of `L` above the prime of `A` the latter comes from; `I` lies in every maximal ideal of
`A`, so every maximal ideal of `A` arises this way and `L` is faithfully flat. W-contractibility
of `A` therefore retracts `L`, and since the lift is fully faithful and carries the trivial
`A ⧸ I`-algebra to `A` (Stacks 09AC), that retraction is a retraction of `V`. -/
theorem isWContractible_quotient_of_le_ringJacobson (A : Type u) [CommRing A]
    (hA : ProetaleWContractible.IsWContractible.{u, u} A) (I : Ideal A)
    (hI : I ≤ Ring.jacobson A) :
    ProetaleWContractible.IsWContractible.{u, u} (A ⧸ I) := by
  classical
  refine (wContractible_tfae.{u} (A ⧸ I) |>.out 2 1).mp ?_
  intro V₀ _ _ hff hie
  obtain ⟨adj⟩ := indEtaleBaseChange_hasFullyFaithfulRightAdjoint A I
  obtain ⟨ff⟩ := indEtaleQuotientLift_fullyFaithful A I
  obtain ⟨j⟩ := indEtaleQuotientLift_self_iso A hA I hI
  set V : IndEtaleAlgebra (A ⧸ I) :=
    ⟨Under.mk (CommRingCat.ofHom (algebraMap (A ⧸ I) V₀)),
      indEtaleUnder_of_indEtale (A ⧸ I) V₀ hie⟩
  set L : IndEtaleAlgebra A := (indEtaleQuotientLift A I).obj V
  let : Algebra A L.obj.right := L.obj.hom.hom.toAlgebra
  have hmap : algebraMap A L.obj.right = L.obj.hom.hom := RingHom.algebraMap_toAlgebra _
  have hieL : StacksDraft.IndEtale A L.obj.right := by
    refine indEtale_of_indEtaleUnder A L.obj.right ?_
    rw [hmap]
    exact L.property
  have hweL : Algebra.WeaklyEtale A L.obj.right := Algebra.weaklyEtale_of_ind_etale hieL
  have : Module.Flat A L.obj.right := inferInstance
  -- The transposed counit is a ring map `L → V₀` over the quotient map of `A`.
  let Q : L.obj ⟶ (Under.map (quotientMkHom A I)).obj V.obj :=
    (Under.mapPushoutAdj (quotientMkHom A I)).homEquiv L.obj V.obj (adj.counit.app V).hom
  let ψ : L.obj.right →+* V₀ := Q.right.hom
  have hQ : ψ.comp (algebraMap A L.obj.right) =
      (algebraMap (A ⧸ I) V₀).comp (Ideal.Quotient.mk I) := by
    rw [hmap]
    exact RingHom.ext fun a ↦
      RingHom.congr_fun (congrArg CommRingCat.Hom.hom (Under.w Q)) a
  -- Hence `L` is faithfully flat over `A`.
  have hffL : Module.FaithfullyFlat A L.obj.right := by
    refine faithfullyFlat_of_forall_isMaximal_exists_comap_eq A L.obj.right fun m hm ↦ ?_
    obtain ⟨p, hp⟩ : (⟨m, hm.isPrime⟩ : PrimeSpectrum A) ∈
        Set.range (PrimeSpectrum.comap (Ideal.Quotient.mk I)) := by
      rw [_root_.range_comap_of_surjective _ _ Ideal.Quotient.mk_surjective, Ideal.mk_ker]
      exact (PrimeSpectrum.mem_zeroLocus _ _).mpr (le_of_le_ringJacobson_of_isMaximal hI hm)
    obtain ⟨q, hq⟩ := (RingHom.FaithfullyFlat.iff_flat_and_comap_surjective.mp
      (RingHom.faithfullyFlat_algebraMap_iff.mpr hff)).2 p
    refine ⟨(PrimeSpectrum.comap ψ q).asIdeal, (PrimeSpectrum.comap ψ q).isPrime, ?_⟩
    have hcomap : PrimeSpectrum.comap (algebraMap A L.obj.right) (PrimeSpectrum.comap ψ q) =
        (⟨m, hm.isPrime⟩ : PrimeSpectrum A) := by
      rw [← PrimeSpectrum.comap_comp_apply, hQ, PrimeSpectrum.comap_comp_apply, hq, hp]
    exact congrArg PrimeSpectrum.asIdeal hcomap
  -- W-contractibility of `A` retracts `L`, and the lift is fully faithful.
  obtain ⟨ρ⟩ := indEtale_faithfullyFlat_retracts_of_isWContractible A hA L.obj.right hffL hieL
  let r : L ⟶ indEtaleAlgebraSelf A :=
    ObjectProperty.homMk (Under.homMk (CommRingCat.ofHom ρ.toRingHom) (by
      refine CommRingCat.hom_ext (RingHom.ext fun a ↦ ?_)
      have h := ρ.commutes a
      rw [hmap] at h
      exact h))
  let g : V ⟶ indEtaleAlgebraSelf (A ⧸ I) := ff.homEquiv.symm (r ≫ j.hom)
  refine ⟨{ toRingHom := g.hom.right.hom, commutes' := fun a ↦ ?_ }⟩
  exact RingHom.congr_fun (congrArg CommRingCat.Hom.hom (Under.w g.hom)) a

/-- **Stacks 00F6 in the form used here.** If the open complement of the zero locus of an ideal
`I` of `A` is quasi-compact, then `I` contains a finitely generated ideal with the same zero
locus: the complement is covered by the standard opens `D(f)` attached to the elements of `I`, so
finitely many of them already cover it, and the ideal they span works. -/
private theorem exists_fg_le_zeroLocus_eq {A : Type u} [CommRing A] (I : Ideal A)
    (hcpt : IsCompact ((PrimeSpectrum.zeroLocus (I : Set A))ᶜ)) :
    ∃ J : Ideal A, J.FG ∧ J ≤ I ∧
      PrimeSpectrum.zeroLocus (J : Set A) = PrimeSpectrum.zeroLocus (I : Set A) := by
  classical
  have hcov : ((PrimeSpectrum.zeroLocus (I : Set A))ᶜ) ⊆
      ⋃ f : (I : Set A), (PrimeSpectrum.basicOpen (f : A) : Set (PrimeSpectrum A)) := by
    intro x hx
    rw [Set.mem_compl_iff, PrimeSpectrum.mem_zeroLocus, Set.not_subset] at hx
    obtain ⟨f, hfI, hfx⟩ := hx
    exact Set.mem_iUnion.mpr ⟨⟨f, hfI⟩, hfx⟩
  obtain ⟨t, ht⟩ := hcpt.elim_finite_subcover
    (fun f : (I : Set A) ↦ (PrimeSpectrum.basicOpen (f : A) : Set (PrimeSpectrum A)))
    (fun f ↦ (PrimeSpectrum.basicOpen (f : A)).isOpen) hcov
  set s : Finset A := t.image (fun f : (I : Set A) ↦ (f : A)) with hs
  have hsI : (s : Set A) ⊆ (I : Set A) := by
    intro a ha
    simp only [hs, Finset.coe_image, Set.mem_image, Finset.mem_coe] at ha
    obtain ⟨f, -, rfl⟩ := ha
    exact f.2
  refine ⟨Ideal.span (s : Set A), ⟨s, rfl⟩, Ideal.span_le.mpr hsI, ?_⟩
  refine Set.Subset.antisymm (Set.compl_subset_compl.mp fun x hx ↦ ?_)
    (PrimeSpectrum.zeroLocus_anti_mono fun a ha ↦ Ideal.span_le.mpr hsI ha)
  obtain ⟨f, hft, hxf⟩ := Set.mem_iUnion₂.mp (ht hx)
  rw [Set.mem_compl_iff, PrimeSpectrum.mem_zeroLocus, Set.not_subset]
  exact ⟨(f : A), Ideal.subset_span (Finset.mem_image_of_mem _ hft), hxf⟩

/-- **W-contractibility passes to a quotient with quasi-compact open complement.** If the open
complement of the zero locus of `I` in `Spec A` is quasi-compact, then `A ⧸ I` is w-contractible.

Stacks 00F6 provides a finitely generated `J ≤ I` with the same zero locus, so `A ⧸ J` is
w-contractible by Stacks 0986. Equality of the zero loci says `I` and `J` have the same radical,
so the image of `I` in `A ⧸ J` consists of nilpotents and in particular lies in every maximal
ideal; the quotient of `A ⧸ J` by that image is `A ⧸ I`. -/
theorem isWContractible_quotient_of_isCompact_compl_zeroLocus (A : Type u) [CommRing A]
    (hA : ProetaleWContractible.IsWContractible.{u, u} A) (I : Ideal A)
    (hcpt : IsCompact ((PrimeSpectrum.zeroLocus (I : Set A))ᶜ)) :
    ProetaleWContractible.IsWContractible.{u, u} (A ⧸ I) := by
  obtain ⟨J, hJfg, hJI, hzero⟩ := exists_fg_le_zeroLocus_eq I hcpt
  have hAJ : ProetaleWContractible.IsWContractible.{u, u} (A ⧸ J) :=
    isWContractible_of_surjective_of_fg_ker (Ideal.Quotient.mk J)
      Ideal.Quotient.mk_surjective (by simpa only [Ideal.mk_ker] using hJfg) hA
  have hradeq : J.radical = I.radical := by
    rw [← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical,
      ← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical, hzero]
  have hjac : Ideal.map (Ideal.Quotient.mk J) I ≤ Ring.jacobson (A ⧸ J) := by
    rw [Ring.jacobson_eq_sInf_isMaximal, le_sInf_iff]
    intro m hm
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    obtain ⟨n, hn⟩ : x ∈ J.radical := hradeq ▸ Ideal.le_radical hx
    have hpow : (Ideal.Quotient.mk J x) ^ n = 0 := by
      simpa only [map_pow] using (Ideal.Quotient.eq_zero_iff_mem).mpr hn
    exact Ideal.IsPrime.mem_of_pow_mem hm.isPrime n (hpow ▸ m.zero_mem)
  exact isWContractible_of_ringEquiv (DoubleQuot.quotQuotEquivQuotOfLE hJI).symm
    (isWContractible_quotient_of_le_ringJacobson (A ⧸ J) hAJ _ hjac)

end AlgebraicGeometry.ProEtale

end
