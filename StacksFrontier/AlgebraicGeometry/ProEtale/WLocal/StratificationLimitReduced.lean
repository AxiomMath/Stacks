module

public import StacksFrontier.AlgebraicGeometry.ProEtale.WLocal.StratificationLimit
public import Mathlib.AlgebraicGeometry.Properties
public import StacksCore.Tactic.StacksAttribute

/-!
# Reducedness of the limiting closed subscheme

Let `A` be a commutative ring, let `X_w = Spec A_w` be the inverse limit of the finite vanishing
stratifications of `Spec A`, and let `Z` be the inverse limit of the finite closed strata `Z_E`.
Then `Z` is a reduced scheme, although no `Z_E` need be reduced.

## Main definitions

* `AlgebraicGeometry.ProEtale.closedStrataι`: the inclusion of a single vanishing stratum into
  the finite closed stratification `Z_E`.
* `AlgebraicGeometry.ProEtale.closedStrataToSpecPi`: the identification of `Z_E` with the
  spectrum of the product of the coordinate rings of its vanishing patterns.
* `AlgebraicGeometry.ProEtale.closedStrataSection`: the component of a global section of `Z_E` at
  one vanishing pattern.

## Main results

* `AlgebraicGeometry.ProEtale.exists_closedStrataTransition_appTop_eq_zero`: a nilpotent global
  section of a finite closed stratum `Z_E` pulls back to zero at some later stage.
* `AlgebraicGeometry.ProEtale.stratificationLimit_closedScheme_isReduced`: `Z` is reduced.
* `AlgebraicGeometry.ProEtale.stratificationLimitClosedScheme_isReduced`: the same statement for
  the canonical limiting data, with no bundle to supply.

## Implementation notes

The last result holds for an arbitrary bundle of limiting data `L : StratificationLimit A`; the
canonical bundle `stratificationLimit` is one, so reducedness of `Z = lim Z_E` itself is the
special case recorded afterwards.

A finite closed stratum is the disjoint union, over the vanishing patterns `E' ⊆ E`, of the
spectra of the rings `(A / I)_f` with `I` generated by `E \ E'` and `f` the product of `E'`, so a
global section of `Z_E` is a family of elements of those rings; this is recorded by
`closedStrataSection`, which detects zero and is compatible with the transition maps. A nilpotent
element of `(A / I)_f` is the class of `g / f ^ m` for some `g ∈ A`; enlarging `E` by the finitely
many numerators so obtained kills the section, because in each vanishing pattern of the enlarged
set such a `g` is either among the inverted elements, which forces the stratum ring to vanish, or
among the elements required to vanish, which forces the numerator to vanish.

Reducedness of `Z` is then reducedness of the direct limit of the rings of sections, which is the
ring whose spectrum is the canonical limit; an arbitrary `L.closedScheme` is isomorphic to it
because the stage identifications of `L` make its closed diagram isomorphic to the canonical one.

## References

* [Stacks Project, Tag 0975](https://stacks.math.columbia.edu/tag/0975)
-/

@[expose] public noncomputable section

namespace AlgebraicGeometry.ProEtale

open CategoryTheory CategoryTheory.Limits

universe u

variable {A : Type u} [CommRing A]


/-! ### Global sections of a finite closed stratum -/

/-- The inclusion of the stratum indexed by the vanishing pattern `E' ⊆ E` into `Z_E`. -/
def closedStrataι (E : Finset A) (i : {E' : Finset A // E' ⊆ E}) :
    Spec (CommRingCat.of (stratumCoordinateRing E i)) ⟶ closedStrata E :=
  Sigma.ι (fun j : {E' : Finset A // E' ⊆ E} =>
    Spec (CommRingCat.of (stratumCoordinateRing E j))) i

/-- The identification of the closed stratum `Z_E` with the spectrum of the product of the
coordinate rings of its vanishing patterns. -/
def closedStrataToSpecPi (E : Finset A) :
    closedStrata E ⟶
      Spec (CommRingCat.of (∀ i : {E' : Finset A // E' ⊆ E}, stratumCoordinateRing E i)) :=
  sigmaSpec fun i : {E' : Finset A // E' ⊆ E} => CommRingCat.of (stratumCoordinateRing E i)

/-- The identification of `Z_E` with an affine spectrum is an isomorphism, the index set of
vanishing patterns being finite. -/
private instance isIso_closedStrataToSpecPi (E : Finset A) : IsIso (closedStrataToSpecPi E) :=
  inferInstanceAs (IsIso (sigmaSpec fun i : {E' : Finset A // E' ⊆ E} =>
    CommRingCat.of (stratumCoordinateRing E i)))

/-- The identification of `Z_E` with an affine spectrum restricts on each stratum to the
projection onto the corresponding factor. -/
theorem closedStrataι_comp_closedStrataToSpecPi (E : Finset A)
    (i : {E' : Finset A // E' ⊆ E}) :
    closedStrataι E i ≫ closedStrataToSpecPi E =
      Spec.map (CommRingCat.ofHom (Pi.evalRingHom
        (fun j : {E' : Finset A // E' ⊆ E} => stratumCoordinateRing E j) i)) :=
  ι_sigmaSpec _ i

/-- The component at the vanishing pattern `E' ⊆ E` of a global section of the closed stratum
`Z_E`, an element of the coordinate ring of that stratum. -/
def closedStrataSection (E : Finset A) (i : {E' : Finset A // E' ⊆ E}) :
    Γ(closedStrata E, ⊤) →+* stratumCoordinateRing E i :=
  (Scheme.ΓSpecIso (CommRingCat.of (stratumCoordinateRing E i))).hom.hom.comp
    (closedStrataι E i).appTop.hom

/-- The component of a section, unfolded to the restriction along the stratum inclusion followed
by the identification of the sections of an affine spectrum with its ring. -/
private theorem closedStrataSection_apply (E : Finset A) (i : {E' : Finset A // E' ⊆ E})
    (t : Γ(closedStrata E, ⊤)) :
    closedStrataSection E i t =
      (Scheme.ΓSpecIso (CommRingCat.of (stratumCoordinateRing E i))).hom
        ((closedStrataι E i).appTop t) :=
  rfl

/-- Naturality of the identification of sections of an affine spectrum with its ring, for a
square `ι ≫ q = Spec.map φ ≫ ι'`. -/
private theorem appTop_naturality_apply {X Y : Scheme.{u}} {R S : CommRingCat.{u}}
    (q : X ⟶ Y) (ι : Spec R ⟶ X) (ι' : Spec S ⟶ Y) (φ : S ⟶ R)
    (hq : ι ≫ q = Spec.map φ ≫ ι') (s : Γ(Y, ⊤)) :
    (Scheme.ΓSpecIso R).hom (ι.appTop (q.appTop s)) =
      φ.hom ((Scheme.ΓSpecIso S).hom (ι'.appTop s)) := by
  have h2 : q.appTop ≫ ι.appTop = ι'.appTop ≫ (Spec.map φ).appTop :=
    congrArg Scheme.Hom.appTop hq
  have h3 := ConcreteCategory.congr_hom h2 s
  have h4 := ConcreteCategory.congr_hom (Scheme.ΓSpecIso_naturality φ) (ι'.appTop s)
  simp only [CategoryTheory.comp_apply] at h3 h4
  rw [h3, h4]

/-- A global section of a closed stratum all of whose components vanish is zero. -/
theorem eq_zero_of_closedStrataSection_eq_zero (E : Finset A) (t : Γ(closedStrata E, ⊤))
    (ht : ∀ i, closedStrataSection E i t = 0) : t = 0 := by
  classical
  have hcomp (s : Γ(Spec (CommRingCat.of
        (∀ i : {E' : Finset A // E' ⊆ E}, stratumCoordinateRing E i)), ⊤))
      (i : {E' : Finset A // E' ⊆ E}) :
      closedStrataSection E i ((closedStrataToSpecPi E).appTop s) =
        (Scheme.ΓSpecIso (CommRingCat.of
          (∀ j : {E' : Finset A // E' ⊆ E}, stratumCoordinateRing E j))).hom s i := by
    rw [closedStrataSection_apply]
    exact (appTop_naturality_apply (closedStrataToSpecPi E) (closedStrataι E i) (𝟙 _)
      (CommRingCat.ofHom (Pi.evalRingHom
        (fun j : {E' : Finset A // E' ⊆ E} => stratumCoordinateRing E j) i))
      (by simpa using closedStrataι_comp_closedStrataToSpecPi E i) s).trans (by simp)
  obtain ⟨s, rfl⟩ : ∃ s, (closedStrataToSpecPi E).appTop s = t := by
    refine ⟨(inv (closedStrataToSpecPi E)).appTop t, ?_⟩
    have h0 : (inv (closedStrataToSpecPi E)).appTop ≫ (closedStrataToSpecPi E).appTop =
        Scheme.Hom.appTop (𝟙 (closedStrata E)) :=
      congrArg Scheme.Hom.appTop (IsIso.hom_inv_id (f := closedStrataToSpecPi E))
    have h1 := ConcreteCategory.congr_hom h0 t
    simpa only [CategoryTheory.comp_apply, Scheme.Hom.id_appTop, CategoryTheory.id_apply]
      using h1
  have hzero : (Scheme.ΓSpecIso (CommRingCat.of
      (∀ j : {E' : Finset A // E' ⊆ E}, stratumCoordinateRing E j))).hom s = 0 :=
    funext fun i => (hcomp s i).symm.trans (ht i)
  have hs0 : s = 0 := by
    have := congrArg (Scheme.ΓSpecIso (CommRingCat.of
      (∀ j : {E' : Finset A // E' ⊆ E}, stratumCoordinateRing E j))).inv hzero
    simpa using this
  rw [hs0, map_zero]

/-- The transition morphism of closed strata, read on the stratum indexed by a vanishing
pattern of the larger finite set. -/
theorem closedStrataι_comp_closedStrataTransition (E₁ E₂ : Finset A) (h : E₁ ⊆ E₂)
    (i : {E' : Finset A // E' ⊆ E₂}) :
    closedStrataι E₂ i ≫ (closedStrataTransition E₁ E₂ h).val =
      Spec.map (CommRingCat.ofHom (closedStratumCoordinateMap E₁ E₂ h i)) ≫
        closedStrataι E₁ (restrictStratum E₁ E₂ h i) := by
  simp [closedStrataι, closedStrataTransition, closedStrata]

/-- Components of sections are compatible with the transition maps of the closed strata. -/
theorem closedStrataSection_transition (E₁ E₂ : Finset A) (h : E₁ ⊆ E₂)
    (i : {E' : Finset A // E' ⊆ E₂}) (t : Γ(closedStrata E₁, ⊤)) :
    closedStrataSection E₂ i ((closedStrataTransition E₁ E₂ h).val.appTop t) =
      closedStratumCoordinateMap E₁ E₂ h i
        (closedStrataSection E₁ (restrictStratum E₁ E₂ h i) t) := by
  rw [closedStrataSection_apply, closedStrataSection_apply]
  exact appTop_naturality_apply _ _ _ _ (closedStrataι_comp_closedStrataTransition E₁ E₂ h i) t

/-! ### Nilpotent sections die at a later stage -/

/-- On classes of elements of `A`, the transition map of coordinate rings is induced by the
quotient map. -/
private theorem closedStratumCoordinateMap_mk (E₁ E₂ : Finset A) (h : E₁ ⊆ E₂)
    (i : {E' : Finset A // E' ⊆ E₂}) (g : A) :
    closedStratumCoordinateMap E₁ E₂ h i
        (algebraMap (A ⧸ stratumIdeal E₁ (restrictStratum E₁ E₂ h i))
          (stratumCoordinateRing E₁ (restrictStratum E₁ E₂ h i)) (Ideal.Quotient.mk _ g)) =
      algebraMap (A ⧸ stratumIdeal E₂ i) (stratumCoordinateRing E₂ i) (Ideal.Quotient.mk _ g) := by
  have hcomp : (closedStratumCoordinateMap E₁ E₂ h i).comp
      (algebraMap (A ⧸ stratumIdeal E₁ (restrictStratum E₁ E₂ h i))
        (stratumCoordinateRing E₁ (restrictStratum E₁ E₂ h i))) =
      (algebraMap (A ⧸ stratumIdeal E₂ i) (stratumCoordinateRing E₂ i)).comp
        (Ideal.Quotient.factor (stratumIdeal_le E₁ E₂ h i)) := by
    simp [closedStratumCoordinateMap, Localization.awayLift, IsLocalization.Away.lift_comp]
  have := congrArg (fun k : (A ⧸ stratumIdeal E₁ (restrictStratum E₁ E₂ h i)) →+*
      stratumCoordinateRing E₂ i => k (Ideal.Quotient.mk _ g)) hcomp
  simpa only [RingHom.comp_apply, Ideal.Quotient.factor_mk] using this

/-- A nilpotent element of a stratum coordinate ring, written as `g / f ^ m`, is killed by the
transition map to any enlarged finite set containing the numerator `g`. -/
private theorem closedStratumCoordinateMap_eq_zero_of_isNilpotent
    (E₁ E₂ : Finset A) (h : E₁ ⊆ E₂) (i : {E' : Finset A // E' ⊆ E₂})
    (x : stratumCoordinateRing E₁ (restrictStratum E₁ E₂ h i))
    (n : ℕ) (hx : x ^ n = 0) (g : A) (hgE : g ∈ E₂) (m : ℕ)
    (hgx : x * algebraMap (A ⧸ stratumIdeal E₁ (restrictStratum E₁ E₂ h i))
          (stratumCoordinateRing E₁ (restrictStratum E₁ E₂ h i))
          (Ideal.Quotient.mk _ (stratumOpenElement (restrictStratum E₁ E₂ h i).val)) ^ m =
        algebraMap (A ⧸ stratumIdeal E₁ (restrictStratum E₁ E₂ h i))
          (stratumCoordinateRing E₁ (restrictStratum E₁ E₂ h i)) (Ideal.Quotient.mk _ g)) :
    closedStratumCoordinateMap E₁ E₂ h i x = 0 := by
  classical
  have hd : IsUnit (algebraMap (A ⧸ stratumIdeal E₂ i) (stratumCoordinateRing E₂ i)
      (Ideal.Quotient.mk _ (stratumOpenElement (restrictStratum E₁ E₂ h i).val))) := by
    rw [← closedStratumCoordinateMap_mk E₁ E₂ h i]
    exact (IsLocalization.Away.algebraMap_isUnit _).map (closedStratumCoordinateMap E₁ E₂ h i)
  have hTx : closedStratumCoordinateMap E₁ E₂ h i x *
      algebraMap (A ⧸ stratumIdeal E₂ i) (stratumCoordinateRing E₂ i)
        (Ideal.Quotient.mk _ (stratumOpenElement (restrictStratum E₁ E₂ h i).val)) ^ m =
      algebraMap (A ⧸ stratumIdeal E₂ i) (stratumCoordinateRing E₂ i)
        (Ideal.Quotient.mk _ g) := by
    have h1 := congrArg (closedStratumCoordinateMap E₁ E₂ h i) hgx
    rwa [map_mul, map_pow, closedStratumCoordinateMap_mk, closedStratumCoordinateMap_mk] at h1
  have hzn : (algebraMap (A ⧸ stratumIdeal E₂ i) (stratumCoordinateRing E₂ i)
      (Ideal.Quotient.mk _ g)) ^ n = 0 := by
    rw [← hTx, mul_pow, ← map_pow, hx, map_zero, zero_mul]
  by_cases hgi : g ∈ i.val
  · have hdvd : Ideal.Quotient.mk (stratumIdeal E₂ i) g ∣
        Ideal.Quotient.mk (stratumIdeal E₂ i) (stratumOpenElement i.val) := by
      refine ⟨Ideal.Quotient.mk _ (∏ a ∈ i.val.erase g, a), ?_⟩
      rw [← map_mul]
      simpa [stratumOpenElement, mul_comm] using
        (congrArg (Ideal.Quotient.mk (stratumIdeal E₂ i))
          (Finset.prod_erase_mul i.val id hgi)).symm
    have hunitz : IsUnit (algebraMap (A ⧸ stratumIdeal E₂ i) (stratumCoordinateRing E₂ i)
        (Ideal.Quotient.mk _ g)) :=
      (IsLocalization.Away.algebraMap_isUnit_iff
        (x := Ideal.Quotient.mk (stratumIdeal E₂ i) (stratumOpenElement i.val))).2
        ⟨1, by simpa using hdvd⟩
    have h01 : (0 : stratumCoordinateRing E₂ i) = 1 := by
      refine isUnit_zero_iff.mp ?_
      rw [← hzn]
      exact hunitz.pow n
    exact eq_zero_of_zero_eq_one h01 _
  · have hgzero : Ideal.Quotient.mk (stratumIdeal E₂ i) g = 0 := by
      rw [Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.subset_span (by simpa using Finset.mem_sdiff.mpr ⟨hgE, hgi⟩)
    exact (hd.pow m).mul_right_cancel (by rw [hTx, hgzero, map_zero, zero_mul])

/-- **Stacks 0975**, the key step for part (4): a nilpotent global section of a finite closed
stratum `Z_E` pulls back to zero under the transition map from a larger stage `Z_F`. -/
theorem exists_closedStrataTransition_appTop_eq_zero (E : Finset A)
    (t : Γ(closedStrata E, ⊤)) (n : ℕ) (ht : t ^ n = 0) :
    ∃ (F : Finset A) (h : E ⊆ F), (closedStrataTransition E F h).val.appTop t = 0 := by
  classical
  let _ : Fintype {E' : Finset A // E' ⊆ E} := Fintype.ofFinite _
  have hsurj (i : {E' : Finset A // E' ⊆ E}) :
      ∃ (m : ℕ) (g : A), closedStrataSection E i t *
          algebraMap (A ⧸ stratumIdeal E i) (stratumCoordinateRing E i)
            (Ideal.Quotient.mk _ (stratumOpenElement i.val)) ^ m =
        algebraMap (A ⧸ stratumIdeal E i) (stratumCoordinateRing E i)
          (Ideal.Quotient.mk _ g) := by
    obtain ⟨m, a, ha⟩ := IsLocalization.Away.surj
      (x := Ideal.Quotient.mk (stratumIdeal E i) (stratumOpenElement i.val))
      (S := stratumCoordinateRing E i) (closedStrataSection E i t)
    obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective a
    exact ⟨m, g, ha⟩
  choose m g hmg using hsurj
  have hnil (i : {E' : Finset A // E' ⊆ E}) : closedStrataSection E i t ^ n = 0 := by
    rw [← map_pow, ht, map_zero]
  refine ⟨E ∪ Finset.univ.image g, Finset.subset_union_left, ?_⟩
  refine eq_zero_of_closedStrataSection_eq_zero _ _ fun i => ?_
  rw [closedStrataSection_transition]
  refine closedStratumCoordinateMap_eq_zero_of_isNilpotent _ _ _ _ _ n
    (hnil _) (g _) ?_ (m _) (hmg _)
  exact Finset.mem_union_right _ (Finset.mem_image_of_mem g (Finset.mem_univ _))

/-! ### Reducedness of the limit -/

/-- The sections of the finite closed strata form a directed system of rings. -/
instance closedSectionDiagram_directedSystem :
    DirectedSystem (fun E : Finset A => ((closedSectionDiagram (A := A)).obj E : Type u))
      (fun _ _ h => ((closedSectionDiagram (A := A)).map (homOfLE h)).hom) where
  map_self := by
    intro E x
    have h1 : (closedSectionDiagram (A := A)).map (homOfLE (le_refl E)) =
        𝟙 ((closedSectionDiagram (A := A)).obj E) :=
      (closedSectionDiagram (A := A)).map_id E
    exact (ConcreteCategory.congr_hom h1 x).trans rfl
  map_map := by
    intro E₃ E₂ E₁ h₁₂ h₂₃ x
    have h1 : (closedSectionDiagram (A := A)).map (homOfLE (le_trans h₁₂ h₂₃)) =
        (closedSectionDiagram (A := A)).map (homOfLE h₁₂) ≫
          (closedSectionDiagram (A := A)).map (homOfLE h₂₃) :=
      (closedSectionDiagram (A := A)).map_comp _ _
    exact (ConcreteCategory.congr_hom h1 x).symm

/-- The direct limit of the rings of sections of the finite closed strata is reduced: a nilpotent
element is nilpotent at a finite stage, and is killed by a transition map.

This is stated as a plain result rather than an instance: computing an instance key for the
direct-limit type forces the coproduct underlying each closed stratum to be unfolded. -/
theorem isReduced_ringDirectLimit_closedSectionDiagram :
    _root_.IsReduced (ringDirectLimit (closedSectionDiagram (A := A))) where
  eq_zero := by
    rintro z ⟨n, hn⟩
    obtain ⟨E, t, rfl⟩ := Ring.DirectLimit.exists_of z
    have hn' : Ring.DirectLimit.of (fun E => (closedSectionDiagram (A := A)).obj E)
        (fun _ _ h => ((closedSectionDiagram (A := A)).map (homOfLE h)).hom) E (t ^ n) = 0 := by
      rw [map_pow]
      exact hn
    obtain ⟨F, hEF, hF⟩ := Ring.DirectLimit.of.zero_exact hn'
    have hFn : ((closedStrataTransition E F hEF).val.appTop t) ^ n = 0 := by
      rw [← map_pow]
      exact hF
    obtain ⟨F', hFF', hkill⟩ := exists_closedStrataTransition_appTop_eq_zero F _ n hFn
    have key : ((closedSectionDiagram (A := A)).map (homOfLE (hEF.trans hFF'))).hom t = 0 := by
      rw [← DirectedSystem.map_map
        (f := fun _ _ h => ((closedSectionDiagram (A := A)).map (homOfLE h)).hom) hEF hFF' t]
      exact hkill
    rw [← Ring.DirectLimit.of_f (G := fun E => (closedSectionDiagram (A := A)).obj E)
      (f := fun _ _ h => ((closedSectionDiagram (A := A)).map (homOfLE h)).hom)
      (hEF.trans hFF') t, key, map_zero]

/-- The closed diagram of a bundle of limiting data is isomorphic to the canonical one. -/
private def closedDiagramIso (L : StratificationLimit A) :
    L.closedDiagram ≅ closedSchemeDiagram (A := A) :=
  NatIso.ofComponents
    (fun i =>
      have := closedStrata_isAffine i.unop
      (L.closedStage i.unop).trans (Scheme.isoSpec (closedStrata i.unop)))
    (by
      intro i i' f
      have := closedStrata_isAffine i.unop
      have := closedStrata_isAffine i'.unop
      obtain ⟨hle, rfl⟩ : ∃ hle : i'.unop ⊆ i.unop, f = (homOfLE hle).op :=
        ⟨leOfHom f.unop, Subsingleton.elim _ _⟩
      change L.closedDiagram.map (homOfLE hle).op ≫ (L.closedStage i'.unop).hom ≫
          (Scheme.isoSpec (closedStrata i'.unop)).hom =
        ((L.closedStage i.unop).hom ≫ (Scheme.isoSpec (closedStrata i.unop)).hom) ≫
          Spec.map ((closedStrataTransition i'.unop i.unop hle).val.appTop)
      rw [← Category.assoc, L.closedTransition, Category.assoc, Category.assoc,
        Scheme.isoSpec_hom_naturality])

/-- **Stacks 0975**, part (4): the limiting closed subscheme `Z` of `X_w` is a reduced scheme. -/
@[stacks 0975 "reduced_z"]
theorem stratificationLimit_closedScheme_isReduced (L : StratificationLimit A) :
    IsReduced L.closedScheme := by
  have hc : IsLimit ((Cone.postcompose (closedDiagramIso L).hom).obj
      (Cone.mk L.closedScheme L.closedProjection)) :=
    (IsLimit.postcomposeHomEquiv (closedDiagramIso L) _).symm L.closedIsLimit
  have : IsReduced (closedLimitCone (A := A)).pt :=
    (affine_isReduced_iff (CommRingCat.of
      (ringDirectLimit (closedSectionDiagram (A := A))))).mpr
      isReduced_ringDirectLimit_closedSectionDiagram
  exact isReduced_of_isOpenImmersion
    (hc.conePointUniqueUpToIso (closedLimitCone_isLimit (A := A))).hom

/-- **Stacks 0975**, part (4): the limiting closed subscheme `Z` of `X_w` is a reduced
scheme. -/
@[stacks 0975 "reduced_z"]
instance stratificationLimitClosedScheme_isReduced :
    IsReduced (stratificationLimitClosedScheme (A := A)) :=
  stratificationLimit_closedScheme_isReduced (stratificationLimit (A := A))

