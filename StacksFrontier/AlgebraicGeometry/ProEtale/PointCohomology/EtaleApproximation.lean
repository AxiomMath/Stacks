module

public import StacksFrontier.AlgebraicGeometry.ProEtale.PointCohomology.ContinuousSheaf

/-!
# Geometric points of étale objects over a field

Let `K` be a field. This file collects the facts about geometric points of objects of the
small pro-étale site of `Spec K` which relate them to the small étale site.

* The geometric points of an affine object of finite type over `K` form a discrete space: its
  ring of global sections is generated by finitely many elements, and a geometric point is
  determined by its values on them.
* For an object `W` locally of finite type over `K`, for instance an étale one, every function
  on the geometric points of `W` becomes continuous after composition with the map induced by a
  morphism from an affine object: the affine object is covered by finitely many affine objects
  mapping into affine opens of `W`, whose geometric points are discrete.

## Main results

* `AlgebraicGeometry.GaloisSheaf.GeomPt.discreteTopology_of_locallyOfFiniteType`: the
  geometric points of an affine object of finite type are discrete.
* `AlgebraicGeometry.GaloisSheaf.GeomPt.continuous_comp_map_of_locallyOfFiniteType`: functions
  on the geometric points of an object of finite type are continuous on affine objects.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite Topology

universe u

namespace AlgebraicGeometry.GaloisSheaf

variable {K : Type u} [Field K]

namespace GeomPt

/-- Evaluation at a geometric point, as a homomorphism of `K`-algebras out of the global
sections, for the `K`-algebra structure given by `structureMap`. -/
def evalAlgHom {V : (base K).ProEt} (φ : GeomPt K V) :
    letI := (structureMap V).hom.toAlgebra
    Γ(V.left, ⊤) →ₐ[K] SeparableClosure K :=
  letI := (structureMap V).hom.toAlgebra
  { evalRingHom φ with
    commutes' := fun k ↦ RingHom.congr_fun (evalRingHom_comp_structureMap φ) k }

/-- `evalAlgHom φ` sends a global section `s` to its value `eval s φ` at the geometric point
`φ`. -/
lemma evalAlgHom_apply {V : (base K).ProEt} (φ : GeomPt K V) (s : Γ(V.left, ⊤)) :
    evalAlgHom φ s = eval s φ := rfl

/-- The global sections of an affine object locally of finite type over `K` form a finitely
generated `K`-algebra. -/
lemma finiteType_structureMap (V : (base K).ProEt) [IsAffine V.left]
    [LocallyOfFiniteType (strHom V)] : (structureMap V).hom.FiniteType := by
  have h : (strHom V).appTop.hom.FiniteType :=
    HasRingHomProperty.appTop @LocallyOfFiniteType (strHom V) ‹_›
  exact h.comp (RingHom.FiniteType.of_surjective _
    (Scheme.ΓSpecIso (CommRingCat.of K)).commRingCatIsoToRingEquiv.symm.surjective)

/-- The geometric points agreeing with `ψ` on finitely many global sections form an open set. -/
private lemma isOpen_setOf_eval_eq {V : (base K).ProEt} (T : Finset Γ(V.left, ⊤))
    (ψ : GeomPt K V) : IsOpen {φ : GeomPt K V | ∀ s ∈ T, eval s φ = eval s ψ} := by
  simp only [Set.ofPred_forall]
  exact isOpen_biInter_finset fun s _ ↦ (isLocallyConstant_eval s).isOpen_fiber _

/-- **The geometric points of an affine object of finite type over `K` are discrete.** -/
lemma discreteTopology_of_locallyOfFiniteType (V : (base K).ProEt) [IsAffine V.left]
    [LocallyOfFiniteType (strHom V)] : DiscreteTopology (GeomPt K V) := by
  let := (structureMap V).hom.toAlgebra
  have hft : Algebra.FiniteType K Γ(V.left, ⊤) := finiteType_structureMap V
  obtain ⟨s, hs⟩ := hft.out
  rw [discreteTopology_iff_isOpen_singleton]
  intro ψ
  have : ({ψ} : Set (GeomPt K V)) = {φ | ∀ c ∈ s, eval c φ = eval c ψ} := by
    ext φ
    simp only [Set.mem_singleton_iff, Set.mem_ofPred_eq]
    refine ⟨fun h c _ ↦ h ▸ rfl, fun h ↦ ?_⟩
    exact evalRingHom_injective <| RingHom.ext fun x ↦ AlgHom.congr_fun
      (AlgHom.ext_of_adjoin_eq_top hs (φ₁ := evalAlgHom φ) (φ₂ := evalAlgHom ψ)
        fun c hc ↦ h c hc) x
  rw [this]
  exact isOpen_setOf_eval_eq s ψ

end GeomPt

open GeomPt

/-! ### Open subschemes as objects of the site -/

/-- The source of a member of an affine open cover of an object, as an object of the site. -/
def affineCoverObj (W : (base K).ProEt) (i : W.left.affineCover.I₀) : (base K).ProEt :=
  haveI : WeaklyEtale (strHom W) := W.prop
  Scheme.ProEt.mk (W.left.affineCover.f i ≫ strHom W)

/-- The source of a member of the affine open cover of an object of the site is affine. -/
instance (W : (base K).ProEt) (i : W.left.affineCover.I₀) :
    IsAffine (affineCoverObj W i).left :=
  inferInstanceAs (IsAffine (W.left.affineCover.X i))

/-- The inclusion of a member of the affine open cover. -/
def affineCoverInc (W : (base K).ProEt) (i : W.left.affineCover.I₀) :
    affineCoverObj W i ⟶ W :=
  MorphismProperty.Over.homMk
    (show (affineCoverObj W i).left ⟶ W.left from W.left.affineCover.f i) rfl

/-- A member of the affine open cover of an object locally of finite type over `K` is again locally
of finite type over `K`. -/
instance (W : (base K).ProEt) [LocallyOfFiniteType (strHom W)]
    (i : W.left.affineCover.I₀) : LocallyOfFiniteType (strHom (affineCoverObj W i)) :=
  inferInstanceAs (LocallyOfFiniteType (W.left.affineCover.f i ≫ strHom W))

/-- The affine open cover of an object generates a covering sieve of the site. -/
lemma affineCover_mem_topology (W : (base K).ProEt) :
    Sieve.generate (Presieve.ofArrows (affineCoverObj W) (affineCoverInc W)) ∈
      Scheme.ProEt.topology (base K) W := by
  apply Precoverage.generate_mem_toGrothendieck
  show Presieve.map (Scheme.ProEt.forget (base K) ⋙ Over.forget (base K))
    (Presieve.ofArrows (affineCoverObj W) (affineCoverInc W)) ∈ Scheme.proetalePrecoverage W.left
  rw [Presieve.map_ofArrows]
  have hle : Scheme.zariskiPrecoverage ≤ Scheme.proetalePrecoverage :=
    le_inf Scheme.zariskiPrecoverage_le_qcPrecoverage
      (Scheme.precoverage_mono fun _ _ _ _ ↦ inferInstance)
  exact hle _ W.left.affineCover.mem₀

namespace GeomPt

/-- **Functions on geometric points of objects of finite type are continuous on affine
objects.** For an object `W` locally of finite type over `K` and a morphism `a : A ⟶ W` from
an affine object, every function `f` on the geometric points of `W` gives a continuous function
`f ∘ map a`. -/
lemma continuous_comp_map_of_locallyOfFiniteType {W A : (base K).ProEt}
    [LocallyOfFiniteType (strHom W)] [IsAffine A.left] (a : A ⟶ W) {Z : Type*}
    [TopologicalSpace Z] (f : GeomPt K W → Z) : Continuous (f ∘ map a) := by
  obtain ⟨E, hfin, haff, hle, hsurj⟩ := exists_finite_affine_cover
    ((Sieve.generate (Presieve.ofArrows (affineCoverObj W) (affineCoverInc W))).pullback a)
    (GrothendieckTopology.pullback_stable _ a (affineCover_mem_topology W))
  refine continuous_of_finite_cover E.X E.f hsurj _ fun k ↦ ?_
  obtain ⟨Y, g, h, ⟨i⟩, hcomp⟩ := hle _ ⟨_, 𝟙 _, E.f k, ⟨k⟩, Category.id_comp _⟩
  have hdisc := discreteTopology_of_locallyOfFiniteType (affineCoverObj W i)
  have hY : (f ∘ map a) ∘ map (E.f k) = (f ∘ map (affineCoverInc W i)) ∘ map g := by
    funext ψ
    simp only [Function.comp_apply, ← map_comp, hcomp]
  rw [hY]
  exact continuous_of_discreteTopology.comp (continuous_map g)

end GeomPt

/-! ### Approximation by étale subalgebras -/

/-- The global sections of an object of the site, as a `K`-algebra through `structureMap`. -/
instance algebraSections (V : (base K).ProEt) : Algebra K Γ(V.left, ⊤) :=
  (structureMap V).hom.toAlgebra

/-- The algebra map from `K` to the global sections of an object of the site is `structureMap`. -/
lemma algebraMap_sections (V : (base K).ProEt) :
    algebraMap K Γ(V.left, ⊤) = (structureMap V).hom := rfl

/-- A finitely generated subalgebra of the global sections of an affine object of the site is
étale over `K` (Stacks 092Q). -/
lemma etale_of_fg (V : (base K).ProEt) [IsAffine V.left] (B : Subalgebra K Γ(V.left, ⊤))
    (hB : B.FG) : Algebra.Etale K B :=
  (flat_lmul_weaklyEtale_filteredColimitEtale_tfae K Γ(V.left, ⊤)).2
    (weaklyEtale_structureMap V).flat_lmul' B hB

/-- An étale `K`-algebra as an object of the small étale site of `Spec K`. -/
def specEtObj (R : Type u) [CommRing R] [Algebra K R] [Algebra.Etale K R] : (base K).Etale :=
  haveI : Etale (Spec.map (CommRingCat.ofHom (algebraMap K R))) :=
    (HasRingHomProperty.Spec_iff (P := @Etale)).2 (RingHom.etale_algebraMap.2 ‹_›)
  Scheme.Etale.mk (Spec.map (CommRingCat.ofHom (algebraMap K R)))

/-- An étale `K`-algebra as an object of the small pro-étale site of `Spec K`. -/
abbrev specProObj (R : Type u) [CommRing R] [Algebra K R] [Algebra.Etale K R] :
    (base K).ProEt :=
  (base K).etaleToProetale.obj (specEtObj R)

/-- The spectrum of an étale `K`-algebra, as an object of the pro-étale site, is affine. -/
instance (R : Type u) [CommRing R] [Algebra K R] [Algebra.Etale K R] :
    IsAffine (specProObj (K := K) R).left :=
  inferInstanceAs (IsAffine (Spec (CommRingCat.of R)))

/-- The structure map of the spectrum of an étale `K`-algebra `R` is `algebraMap K R` followed by
the identification of `R` with the global sections of `Spec R`. -/
lemma structureMap_specProObj (R : Type u) [CommRing R] [Algebra K R] [Algebra.Etale K R] :
    structureMap (specProObj (K := K) R) =
      CommRingCat.ofHom (algebraMap K R) ≫ (Scheme.ΓSpecIso (CommRingCat.of R)).inv := by
  show (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
    (Spec.map (CommRingCat.ofHom (algebraMap K R))).appTop = _
  rw [Scheme.ΓSpecIso_inv_naturality]

/-- For an affine object `V`, the structure morphism of `V` over `Spec K` is the isomorphism
`V ≅ Spec Γ(V, ⊤)` followed by `Spec` of `structureMap V`. -/
lemma isoSpec_hom_comp_spec_structureMap (V : (base K).ProEt) [IsAffine V.left] :
    V.left.isoSpec.hom ≫ Spec.map (structureMap V) = strHom V := by
  rw [structureMap, Spec.map_comp, ← Category.assoc, Scheme.isoSpec_hom_naturality,
    Scheme.isoSpec_Spec_hom, Category.assoc, ← Spec.map_comp, Iso.inv_hom_id, Spec.map_id,
    Category.comp_id]

variable (V : (base K).ProEt) [IsAffine V.left]

/-- The morphism from an affine object to the spectrum of an étale subalgebra of its global
sections. -/
def toSpecSub (B : Subalgebra K Γ(V.left, ⊤)) [Algebra.Etale K B] : V ⟶ specProObj B :=
  MorphismProperty.Over.homMk
    (show V.left ⟶ Spec (CommRingCat.of B) from
      V.left.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom B.val.toRingHom)) (by
      change (V.left.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom B.val.toRingHom)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap K B)) = strHom V
      rw [Category.assoc, ← Spec.map_comp, ← isoSpec_hom_comp_spec_structureMap V]
      rfl)

namespace GeomPt

/-- A geometric point of the spectrum of an étale algebra, as a `K`-algebra map. -/
def ptAlgHom {R : Type u} [CommRing R] [Algebra K R] [Algebra.Etale K R]
    (ψ : GeomPt K (specProObj R)) : R →ₐ[K] SeparableClosure K where
  toRingHom := (evalRingHom ψ).comp (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom
  commutes' k := by
    have := RingHom.congr_fun (evalRingHom_comp_structureMap ψ) k
    rwa [structureMap_specProObj] at this

/-- A geometric point of the spectrum of an étale `K`-algebra is determined by its `K`-algebra map
`ptAlgHom`. -/
lemma ptAlgHom_injective {R : Type u} [CommRing R] [Algebra K R] [Algebra.Etale K R] :
    Function.Injective (ptAlgHom (K := K) (R := R)) := by
  intro ψ ψ' h
  apply evalRingHom_injective
  refine RingHom.ext fun (s : Γ(Spec (CommRingCat.of R), ⊤)) ↦ ?_
  have := AlgHom.congr_fun h ((Scheme.ΓSpecIso (CommRingCat.of R)).hom s)
  change evalRingHom ψ ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom
      ((Scheme.ΓSpecIso (CommRingCat.of R)).hom s)) = evalRingHom ψ'
      ((Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom ((Scheme.ΓSpecIso (CommRingCat.of R)).hom s))
    at this
  rwa [← CommRingCat.comp_apply, Iso.hom_inv_id, CommRingCat.id_apply] at this

variable {V}

/-- Restricting a geometric point to an étale subalgebra. -/
lemma ptAlgHom_map_toSpecSub (B : Subalgebra K Γ(V.left, ⊤)) [Algebra.Etale K B]
    (φ : GeomPt K V) : ptAlgHom (map (toSpecSub V B) φ) = (evalAlgHom φ).comp B.val := by
  refine AlgHom.ext fun b ↦ ?_
  show eval _ (map (toSpecSub V B) φ) = eval (b : Γ(V.left, ⊤)) φ
  rw [eval_map]
  congr 1
  show ((Spec.map (CommRingCat.ofHom B.val.toRingHom)).appTop ≫
    V.left.isoSpec.hom.appTop) ((Scheme.ΓSpecIso (CommRingCat.of B)).inv b) = _
  rw [show V.left.isoSpec.hom.appTop = (Scheme.ΓSpecIso Γ(V.left, ⊤)).hom from
    Scheme.toSpecΓ_appTop _, ← CommRingCat.comp_apply, ← Category.assoc,
    ← Scheme.ΓSpecIso_inv_naturality]
  simp

/-- Every geometric point of the spectrum of an étale subalgebra comes from a geometric point
of the affine object: the global sections are integral over the subalgebra, so the map on
spectra is surjective, and geometric points lift along weakly étale morphisms. -/
lemma map_toSpecSub_surjective (B : Subalgebra K Γ(V.left, ⊤)) [Algebra.Etale K B] :
    Function.Surjective (map (K := K) (toSpecSub V B)) := by
  intro ψ
  have hint : B.val.toRingHom.IsIntegral := fun s ↦
    IsIntegral.tower_top (A := B) ((isIntegral_structureMap V).isIntegral s)
  have hsurj : Function.Surjective (Spec.map (CommRingCat.ofHom B.val.toRingHom)) :=
    hint.comap_surjective Subtype.val_injective
  obtain ⟨y, hy⟩ := hsurj ((ptLeft ψ) (IsLocalRing.closedPoint (SeparableClosure K)))
  obtain ⟨v, rfl⟩ : ∃ v, V.left.isoSpec.hom v = y :=
    ⟨V.left.isoSpec.inv y, by rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]; rfl⟩
  exact exists_map_eq_of_mem_range (toSpecSub V B) ψ v hy

/-- A locally constant function on the geometric points of an affine object only depends on
the values of finitely many global sections. -/
lemma exists_finset_of_isLocallyConstant {Z : Type*} (f : GeomPt K V → Z)
    (hf : IsLocallyConstant f) : ∃ T : Finset Γ(V.left, ⊤), ∀ φ φ' : GeomPt K V,
      (∀ s ∈ T, eval s φ = eval s φ') → f φ = f φ' := by
  classical
  have hloc : ∀ φ : GeomPt K V, ∃ I : Finset Γ(V.left, ⊤), ∀ φ',
      (∀ s ∈ I, eval s φ' = eval s φ) → f φ' = f φ := by
    intro φ
    let : TopologicalSpace (SeparableClosure K) := ⊥
    have : DiscreteTopology (SeparableClosure K) := ⟨rfl⟩
    have hU : f ⁻¹' {f φ} ∈ 𝓝 φ := (hf.isOpen_fiber _).mem_nhds rfl
    rw [show (𝓝 φ) = ⨅ s : Γ(V.left, ⊤), @nhds _ (TopologicalSpace.induced (eval s) ⊥) φ from
      nhds_iInf] at hU
    obtain ⟨I, hI, W, hW, hUW⟩ := Filter.mem_iInf.1 hU
    refine ⟨hI.toFinset, fun φ' hφ' ↦ ?_⟩
    have : φ' ∈ ⋂ i : I, W i := by
      refine Set.mem_iInter.2 fun i ↦ ?_
      have hWi := hW i
      rw [nhds_induced, nhds_discrete, Filter.mem_comap] at hWi
      obtain ⟨t, ht, hts⟩ := hWi
      apply hts
      show eval _ φ' ∈ t
      rw [hφ' i.1 (hI.mem_toFinset.2 i.2)]
      exact Filter.mem_pure.1 ht
    rwa [← hUW] at this
  choose I hI using hloc
  let O : GeomPt K V → Set (GeomPt K V) := fun φ ↦ {φ' | ∀ s ∈ I φ, eval s φ' = eval s φ}
  obtain ⟨F, hF⟩ := isCompact_univ.elim_finite_subcover O (fun φ ↦ isOpen_setOf_eval_eq (I φ) φ)
    (fun φ _ ↦ Set.mem_iUnion.2 ⟨φ, fun s _ ↦ rfl⟩)
  refine ⟨F.biUnion I, fun φ φ' h ↦ ?_⟩
  obtain ⟨φ₀, hφ₀, hφφ₀⟩ := Set.mem_iUnion₂.1 (hF (Set.mem_univ φ))
  have h' : φ' ∈ O φ₀ := fun s hs ↦
    (h s (Finset.mem_biUnion.2 ⟨φ₀, hφ₀, hs⟩)).symm.trans (hφφ₀ s hs)
  exact (hI φ₀ φ hφφ₀).trans (hI φ₀ φ' h').symm

/-- **Locally constant functions come from étale subalgebras.** A locally constant function on
the geometric points of an affine object factors through the geometric points of the spectrum
of a finitely generated, hence étale, subalgebra of its global sections. -/
lemma exists_fg_factor {Z : Type*} (f : GeomPt K V → Z) (hf : IsLocallyConstant f) :
    ∃ (B : Subalgebra K Γ(V.left, ⊤)) (hB : B.FG),
      letI := etale_of_fg V B hB
      ∀ φ φ', map (toSpecSub V B) φ = map (toSpecSub V B) φ' → f φ = f φ' := by
  obtain ⟨T, hT⟩ := exists_finset_of_isLocallyConstant f hf
  refine ⟨Algebra.adjoin K (T : Set Γ(V.left, ⊤)), Subalgebra.fg_adjoin_finset T, ?_⟩
  let := etale_of_fg V _ (Subalgebra.fg_adjoin_finset T)
  refine fun φ φ' h ↦ hT φ φ' fun s hs ↦ ?_
  have h' := congrArg ptAlgHom h
  rw [ptAlgHom_map_toSpecSub, ptAlgHom_map_toSpecSub] at h'
  exact AlgHom.congr_fun h' ⟨s, Algebra.subset_adjoin hs⟩

end GeomPt

/-! ### Factorizations of morphisms to affine étale objects -/

/-- The structure maps are compatible with morphisms: for `k : V ⟶ U`, the structure map of `U`
followed by the map on global sections induced by `k` is the structure map of `V`. -/
lemma structureMap_comp_appTop {V U : (base K).ProEt} (k : V ⟶ U) :
    structureMap U ≫ k.left.appTop = structureMap V := by
  have hw : k.left ≫ strHom U = strHom V := MorphismProperty.Over.w k
  rw [structureMap, structureMap, Category.assoc, ← Scheme.Hom.comp_appTop, hw]

/-- The `K`-algebra map on global sections induced by a morphism of the site. -/
def appTopAlgHom {V U : (base K).ProEt} (k : V ⟶ U) : Γ(U.left, ⊤) →ₐ[K] Γ(V.left, ⊤) where
  toRingHom := k.left.appTop.hom
  commutes' x := by
    change (structureMap U ≫ k.left.appTop).hom x = (structureMap V).hom x
    rw [structureMap_comp_appTop]

/-- **A morphism from an affine object to an affine étale object factors through the spectrum
of a finitely generated subalgebra**, namely the image of the global sections. -/
lemma exists_factor_toSpecSub (V : (base K).ProEt) [IsAffine V.left] (U : (base K).Etale)
    [IsAffine U.left] (k : V ⟶ (base K).etaleToProetale.obj U) :
    ∃ (B : Subalgebra K Γ(V.left, ⊤)) (hB : B.FG),
      letI := etale_of_fg V B hB
      ∃ m : specEtObj B ⟶ U, toSpecSub V B ≫ (base K).etaleToProetale.map m = k := by
  let U' := (base K).etaleToProetale.obj U
  have : IsAffine U'.left := ‹IsAffine U.left›
  have : Etale (strHom U') := U.prop
  let φ := appTopAlgHom k
  have hB : φ.range.FG := by
    rw [← Algebra.map_top]
    exact (show Algebra.FiniteType K Γ(U'.left, ⊤) from finiteType_structureMap U').out.map φ
  let := etale_of_fg V φ.range hB
  refine ⟨φ.range, hB, ?_⟩
  let ml : Spec (CommRingCat.of φ.range) ⟶ U.left :=
    Spec.map (CommRingCat.ofHom φ.rangeRestrict.toRingHom) ≫ U'.left.isoSpec.inv
  have hiso : U'.left.isoSpec.inv ≫ strHom U' = Spec.map (structureMap U') := by
    rw [← isoSpec_hom_comp_spec_structureMap U', Iso.inv_hom_id_assoc]
  have hw : ml ≫ U.hom = Spec.map (CommRingCat.ofHom (algebraMap K φ.range)) := by
    show (Spec.map (CommRingCat.ofHom φ.rangeRestrict.toRingHom) ≫ U'.left.isoSpec.inv) ≫
      strHom U' = _
    rw [Category.assoc, hiso, ← Spec.map_comp]
    congr 1
    ext x
    exact congrArg Subtype.val (φ.rangeRestrict.commutes x)
  refine ⟨MorphismProperty.Over.homMk ml hw, ?_⟩
  apply MorphismProperty.Over.Hom.ext
  show (V.left.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom (φ.range.val.toRingHom))) ≫
    (Spec.map (CommRingCat.ofHom φ.rangeRestrict.toRingHom) ≫ U'.left.isoSpec.inv) = k.left
  rw [Category.assoc, ← Category.assoc (Spec.map _), ← Spec.map_comp]
  have : CommRingCat.ofHom φ.rangeRestrict.toRingHom ≫ CommRingCat.ofHom φ.range.val.toRingHom =
      k.left.appTop := by
    ext x
    rfl
  rw [this, ← Category.assoc, Scheme.isoSpec_hom_naturality, Category.assoc, Iso.hom_inv_id,
    Category.comp_id]

/-- The source of a member of an affine open cover of an étale object, as an étale object. -/
def affineCoverEtObj (W : (base K).Etale) (i : W.left.affineCover.I₀) : (base K).Etale :=
  haveI : Etale W.hom := W.prop
  Scheme.Etale.mk (W.left.affineCover.f i ≫ W.hom)

/-- The source of a member of the affine open cover of an étale object is affine. -/
instance (W : (base K).Etale) (i : W.left.affineCover.I₀) :
    IsAffine (affineCoverEtObj W i).left :=
  inferInstanceAs (IsAffine (W.left.affineCover.X i))

/-- The inclusion of a member of the affine open cover of an étale object. -/
def affineCoverEtInc (W : (base K).Etale) (i : W.left.affineCover.I₀) :
    affineCoverEtObj W i ⟶ W :=
  MorphismProperty.Over.homMk
    (show (affineCoverEtObj W i).left ⟶ W.left from W.left.affineCover.f i) rfl

/-- The pro-étale object of a member of the affine open cover of an étale object `W` is the
corresponding member of the affine open cover of the pro-étale object of `W`. -/
lemma etaleToProetale_obj_affineCoverEtObj (W : (base K).Etale) (i : W.left.affineCover.I₀) :
    (base K).etaleToProetale.obj (affineCoverEtObj W i) =
      affineCoverObj ((base K).etaleToProetale.obj W) i := rfl

/-- The inclusion of a member of the affine open cover of an étale object `W` is sent to the
inclusion of the corresponding member of the affine open cover of the pro-étale object of `W`. -/
lemma etaleToProetale_map_affineCoverEtInc (W : (base K).Etale) (i : W.left.affineCover.I₀) :
    (base K).etaleToProetale.map (affineCoverEtInc W i) =
      affineCoverInc ((base K).etaleToProetale.obj W) i := rfl

end AlgebraicGeometry.GaloisSheaf
