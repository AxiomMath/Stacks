module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Abelian
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Submodule
public import StacksFrontier.AlgebraicGeometry.Modules.IdealPowerMultiple
public import StacksFrontier.CategoryTheory.Sites.Modules.RingedSite

/-!
# The adic quotient system of a sheaf of modules, in an arbitrary universe of sections

Let `X` be a ringed site, let `I` be a sheaf of ideals in its structure sheaf, presented as a
submodule of the unit sheaf of modules, and let `F` be a sheaf of modules on `X` whose sections
live in an arbitrary universe `max u v w` containing the site. This file builds the subsheaf
`IⁿF` of `F` for each `n`, the inverse system `n ↦ F/IⁿF` of its quotients, and the cone of
canonical quotient maps out of `F`.

These are the constructions of `StacksFrontier/AlgebraicGeometry/ProEtale/AdicQuotientSystem.lean`,
which are stated for sheaves of modules in the universe `max u v` of the site, restated for an
arbitrary universe of sections. The extra generality is what the small pro-étale site of a
scheme needs: its objects live in a larger universe than its morphisms, and its sheaves of
coefficient modules in a larger universe still. Abelianness of sheaves of modules in such a
universe is not automatic, so the quotient constructions assume the sheafification of abelian
presheaves (`HasSheafify X.J AddCommGrpCat.{max u v w}` and
`X.J.WEqualsLocallyBijective AddCommGrpCat.{max u v w}`) as instance arguments.

## Main definitions

* `AlgebraicGeometry.RingedSite.idealSectionsOfSize`: the sections of `I` over an object, as an
  ideal.
* `AlgebraicGeometry.RingedSite.idealPowerProductOfSize`: the subsheaf `IⁿF` of `F`.
* `AlgebraicGeometry.RingedSite.idealPowerQuotientMapOfSize`: the transition map
  `F/IᵐF ⟶ F/IⁿF` for `n ≤ m`.
* `AlgebraicGeometry.RingedSite.idealPowerQuotientSystemOfSize`: the inverse system
  `n ↦ F/IⁿF`.
* `AlgebraicGeometry.RingedSite.AdicQuotientSystemOfSize`: the specification of an inverse
  system of quotients of `F` by the subsheaves `IⁿF`, together with its quotient maps out of `F`.
* `AlgebraicGeometry.RingedSite.adicQuotientSystemOfSize`: the canonical such system.

## Main results

* `AlgebraicGeometry.RingedSite.idealPowerProductOfSize_mono`: the filtration `IⁿF` decreases
  in `n`.
* `AlgebraicGeometry.RingedSite.cokernel_π_idealPowerQuotientMapOfSize`: the quotient maps out
  of `F` are compatible with the transition maps of the system.

## Implementation notes

`AdicQuotientSystemOfSize` is a specification rather than a construction: its field
`isQuotient` asks for an isomorphism identifying each term with the cokernel of `IⁿF ⟶ F` under
which the given map out of `F` becomes the cokernel projection. This pins the system down up to
unique isomorphism, while `adicQuotientSystemOfSize` exhibits one.

## References

* [Stacks Project, Tag 099Q](https://stacks.math.columbia.edu/tag/099Q)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v w

namespace AlgebraicGeometry.RingedSite

/-- The sections of a sheaf of ideals over an object of the site, read as an ideal of the ring
of sections there.

`I` is given as a submodule of the unit sheaf of modules, so its sections form a submodule of
the sections of the unit sheaf; the carrier of the latter is the ring of sections itself, which
is what makes this an ideal. Naming that identification here is what lets the definitions below
raise `I` to a power without relying on the elaborator to unfold `SheafOfModules.unit`. -/
def idealSectionsOfSize
    (X : RingedSite.{u, v, max u v w})
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (U : X.Cᵒᵖ) : Ideal (((Stacks.SheafOfModules.Tensor.ringSheaf X.O)).obj.obj U) :=
  I.toSubmodule.obj U

/-- The subsheaf of `F` locally generated by products of sections of `Iⁿ`
with sections of `F`. -/
def idealPowerProductOfSize
    (X : RingedSite.{u, v, max u v w})
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (F : SheafOfModules.{max u v w} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (n : ℕ) : F.Submodule := by
  letI : CompleteLattice F.Submodule := SheafOfModules.Submodule.instCompleteLattice
  exact sInf { N : F.Submodule |
    ∀ U : X.Cᵒᵖ,
      let R := ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)).obj.obj U
      letI : CommRing R := by
        change CommRing (X.O.obj.obj U)
        infer_instance
      letI : Module R (F.val.obj U) := (F.val.obj U).isModule
      let J : Ideal R := idealSectionsOfSize X I U
      ∀ (a : R), a ∈ J ^ n →
        ∀ m : F.val.obj U, a • m ∈ N.toSubmodule.obj U }

/-- The adic filtration decreases: `IᵐF ≤ IⁿF` whenever `n ≤ m`. -/
lemma idealPowerProductOfSize_mono
    (X : RingedSite.{u, v, max u v w})
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (F : SheafOfModules.{max u v w} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    {n m : ℕ} (hnm : n ≤ m) :
    idealPowerProductOfSize X I F m ≤ idealPowerProductOfSize X I F n := by
  unfold idealPowerProductOfSize
  exact sInf_le_sInf fun N hN U a ha m => hN U a (Ideal.pow_le_pow_right hnm ha) m

/-- The transition map `F/IᵐF ⟶ F/IⁿF` of the adic quotient system, for `n ≤ m`. It is induced
on cokernels by the inclusion `IᵐF ⟶ IⁿF`. -/
def idealPowerQuotientMapOfSize
    (X : RingedSite.{u, v, max u v w})
    [HasSheafify X.J AddCommGrpCat.{max u v w}]
    [X.J.WEqualsLocallyBijective AddCommGrpCat.{max u v w}]
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (F : SheafOfModules.{max u v w} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    {n m : ℕ} (hnm : n ≤ m) :
    cokernel (idealPowerProductOfSize X I F m).ι ⟶
      cokernel (idealPowerProductOfSize X I F n).ι :=
  cokernel.desc _ (cokernel.π _) (by
    rw [← SheafOfModules.Submodule.homOfLE_ι (idealPowerProductOfSize_mono X I F hnm),
      Category.assoc, cokernel.condition, comp_zero])

/-- The quotient projection `F ⟶ F/IᵐF` followed by the transition map to `F/IⁿF` is the
quotient projection `F ⟶ F/IⁿF`. -/
lemma cokernel_π_idealPowerQuotientMapOfSize
    (X : RingedSite.{u, v, max u v w})
    [HasSheafify X.J AddCommGrpCat.{max u v w}]
    [X.J.WEqualsLocallyBijective AddCommGrpCat.{max u v w}]
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (F : SheafOfModules.{max u v w} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    {n m : ℕ} (hnm : n ≤ m) :
    cokernel.π (idealPowerProductOfSize X I F m).ι ≫
        idealPowerQuotientMapOfSize X I F hnm =
      cokernel.π (idealPowerProductOfSize X I F n).ι := by
  simp [idealPowerQuotientMapOfSize]

/-- The inverse system `n ↦ F/IⁿF` of adic quotients of `F`, with the transition maps induced by
the inclusions of the adic filtration. -/
def idealPowerQuotientSystemOfSize
    (X : RingedSite.{u, v, max u v w})
    [HasSheafify X.J AddCommGrpCat.{max u v w}]
    [X.J.WEqualsLocallyBijective AddCommGrpCat.{max u v w}]
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (F : SheafOfModules.{max u v w} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    ℕᵒᵖ ⥤ SheafOfModules.{max u v w} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)) where
  obj i := cokernel (idealPowerProductOfSize X I F i.unop).ι
  map hij := idealPowerQuotientMapOfSize X I F (leOfHom hij.unop)
  map_id i := by
    apply (cancel_epi (cokernel.π (idealPowerProductOfSize X I F i.unop).ι)).1
    simp only [cokernel_π_idealPowerQuotientMapOfSize, Category.comp_id]
  map_comp {i j k} f g := by
    apply (cancel_epi (cokernel.π (idealPowerProductOfSize X I F i.unop).ι)).1
    symm
    simp only [← Category.assoc, cokernel_π_idealPowerQuotientMapOfSize]

/-- An inverse system of the quotient sheaves `F/IⁿF`, with the canonical
quotient maps from `F`. The componentwise cokernel specifications ensure that
the chosen system is the canonical one, up to unique isomorphism. -/
structure AdicQuotientSystemOfSize
    (X : RingedSite.{u, v, max u v w})
    [HasSheafify X.J AddCommGrpCat.{max u v w}]
    [X.J.WEqualsLocallyBijective AddCommGrpCat.{max u v w}]
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (F : SheafOfModules.{max u v w} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) where
  /-- The inverse system of quotients. -/
  Q : ℕᵒᵖ ⥤ SheafOfModules.{max u v w} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
  /-- The quotient maps out of `F`, as a cone over the system. -/
  quotientMap : (Functor.const ℕᵒᵖ).obj F ⟶ Q
  /-- Each term of the system is the quotient `F/IⁿF`, compatibly with the quotient map. -/
  isQuotient (n : ℕ) :
    ∃ e : cokernel (idealPowerProductOfSize X I F n).ι ≅ Q.obj (op n),
      cokernel.π (idealPowerProductOfSize X I F n).ι ≫ e.hom = quotientMap.app (op n)

/-- The canonical inverse system of the quotient sheaves `F/IⁿF`, together
with its cone of quotient maps. The cokernel specification determines the
system up to unique isomorphism. -/
def adicQuotientSystemOfSize
    (X : RingedSite.{u, v, max u v w})
    [HasSheafify X.J AddCommGrpCat.{max u v w}]
    [X.J.WEqualsLocallyBijective AddCommGrpCat.{max u v w}]
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (F : SheafOfModules.{max u v w} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    AdicQuotientSystemOfSize X I F where
  Q := idealPowerQuotientSystemOfSize X I F
  quotientMap :=
  { app := fun n => cokernel.π (idealPowerProductOfSize X I F n.unop).ι
    naturality := by
      intro i j f
      change cokernel.π (idealPowerProductOfSize X I F j.unop).ι =
        cokernel.π (idealPowerProductOfSize X I F i.unop).ι ≫
          idealPowerQuotientMapOfSize X I F (leOfHom f.unop)
      exact (cokernel_π_idealPowerQuotientMapOfSize X I F (leOfHom f.unop)).symm }
  isQuotient := fun n =>
    ⟨Iso.refl (cokernel (idealPowerProductOfSize X I F n).ι), Category.comp_id _⟩

end AlgebraicGeometry.RingedSite

end
