/-!
# Finite projective lifts along the adic completion of the coefficients

Let `Λ` be a ring, `I ⊆ Λ` a finitely generated ideal and `Λ^∧ = AdicCompletion I Λ`. This file
shows that every finite projective `Λ/I`-module is the reduction modulo `I` of a finite projective
`Λ^∧`-module. This is the footnote of the source's proof of Stacks 09C3 and the module-theoretic
input of that statement: it produces the finite projective `Λ^∧`-modules `M^a, …, M^b` whose
completed constant sheaves `\underline{M^a}^∧ → ⋯ → \underline{M^b}^∧` represent a constructible
complex on the members of a finite disjoint open covering of a weakly contractible affine scheme.
Stacks 09C3 itself is
`AlgebraicGeometry.ProEtale.hasFiniteDisjointCompletedConstantModel_of_isLocallyConstant` in
`StacksFrontier/AlgebraicGeometry/ProEtale/LocallyConstantCompletedModel.lean`.

## Main definitions

* `AlgebraicGeometry.ProEtale.completedCoefficientIdeal`: the ideal `I·Λ^∧` of the adic
  completion `Λ^∧ = AdicCompletion I Λ`.
* `AlgebraicGeometry.ProEtale.completedCoefficientQuotEquiv`: the ring isomorphism
  `Λ^∧/IΛ^∧ ≅ Λ/I`.
* `AlgebraicGeometry.ProEtale.IsCompletedCoefficientLift`: `M` is a finite projective
  `Λ^∧`-module whose reduction modulo `I` is a prescribed `Λ/I`-module `Mbar`, the reduction
  being compared along `Λ^∧ → Λ/I`.

## Main results

* `AlgebraicGeometry.ProEtale.henselianPair_completedCoefficients`: `(Λ^∧, IΛ^∧)` is a
  henselian pair, for `I` finitely generated.
* `AlgebraicGeometry.ProEtale.exists_isCompletedCoefficientLift`: every finite projective
  `Λ/I`-module is the reduction of a finite projective `Λ^∧`-module.

## Implementation notes

The source lifts a projector `p̄` over `Λ/I` to a compatible system of projectors over the
`Λ/Iⁿ` (Algebra, Lemma 10.32.7, Stacks 05BU) and takes `p = lim pₙ`, using `Λ^∧ = lim Λ/Iⁿ`.
The lift is obtained here instead from Stacks 0D4A (reduction along a henselian pair is a
bijection on isomorphism classes of finite projective modules), Stacks 0G3H (a ring derived
complete with respect to an ideal forms a henselian pair with it) and Stacks 091R (an adically
complete module is derived complete), applied to `(Λ^∧, IΛ^∧)`.

The reduction of a `Λ^∧`-module `M` is `M/IΛ^∧·M`, a module over `Λ^∧/IΛ^∧`. Rather than
transport module structures along `completedCoefficientQuotEquiv`, the predicate
`IsCompletedCoefficientLift` compares it with a `Λ/I`-module through an additive equivalence
whose compatibility with scalars is spelled out along `AdicCompletion.evalOneₐ`, which keeps the
statement free of auxiliary instances.

## References

* [Stacks Project, Tag 09C3](https://stacks.math.columbia.edu/tag/09C3)
* [Stacks Project, Tag 0D4A](https://stacks.math.columbia.edu/tag/0D4A)
* [Stacks Project, Tag 0G3H](https://stacks.math.columbia.edu/tag/0G3H)
* [Stacks Project, Tag 091R](https://stacks.math.columbia.edu/tag/091R)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u r w z

namespace AlgebraicGeometry.ProEtale

attribute [local instance] HasDerivedCategory.standard
  SheafOfModules.hasSheafify_commRingCat
  Stacks.hasSheafCompose_forget₂_commRingCat

section Coefficients

variable (Λ : Type r) [CommRing Λ] (I : Ideal Λ)

/-- The ideal `I·Λ^∧` generated by `I` in the adic completion `Λ^∧ = AdicCompletion I Λ`. -/
abbrev completedCoefficientIdeal : Ideal (AdicCompletion I Λ) :=
  I.map (algebraMap Λ (AdicCompletion I Λ))

/-- **`(Λ^∧, IΛ^∧)` is a henselian pair.** For a finitely generated ideal `I` the adic
completion `Λ^∧` is `IΛ^∧`-adically complete, hence derived complete with respect to `IΛ^∧`
(Stacks 091R), hence forms a henselian pair with it (Stacks 0G3H). -/
theorem henselianPair_completedCoefficients (hI : I.FG) :
    HenselianPair (AdicCompletion I Λ) (completedCoefficientIdeal Λ I) := by
  let _ : HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{r} (AdicCompletion I Λ))) :=
    Stacks.DerivedProducts.hasProductsOfShape_nat
  refine PrincipalHenselianPair.henselianPair_of_isDerivedCompleteModule
    (AdicCompletion I Λ) (completedCoefficientIdeal Λ I) ?_
  exact (isDerivedCompleteModule_of_isAdicComplete_and_adicCompletion_surjective
    (AdicCompletion I Λ) (completedCoefficientIdeal Λ I) (AdicCompletion I Λ)).1
      (AdicCompletion.isAdicComplete_self I hI)

/-- The canonical isomorphism `Λ^∧/IΛ^∧ ≅ Λ/I`: the evaluation `Λ^∧ → Λ/I` of
`AdicCompletion.evalOneₐ` is surjective with kernel `IΛ^∧`. -/
def completedCoefficientQuotEquiv (hI : I.FG) :
    (AdicCompletion I Λ ⧸ completedCoefficientIdeal Λ I) ≃+* (Λ ⧸ I) :=
  (Ideal.quotEquivOfEq (AdicCompletion.ker_evalOneₐ_eq_map I hI).symm).trans
    (RingHom.quotientKerEquivOfSurjective
      (f := (AdicCompletion.evalOneₐ I).toRingHom) (AdicCompletion.evalOneₐ_surjective I))

@[simp]
theorem completedCoefficientQuotEquiv_mk (hI : I.FG) (c : AdicCompletion I Λ) :
    completedCoefficientQuotEquiv Λ I hI
        (Ideal.Quotient.mk (completedCoefficientIdeal Λ I) c) =
      AdicCompletion.evalOneₐ I c :=
  rfl

/-- `M` is a **finite projective `Λ^∧`-lift of `Mbar`**: a finite projective module over the
adic completion whose reduction `M/IΛ^∧·M` is additively identified with the `Λ/I`-module
`Mbar`, compatibly with the scalars along `AdicCompletion.evalOneₐ : Λ^∧ → Λ/I`. -/
def IsCompletedCoefficientLift (M : ModuleCat.{z} (AdicCompletion I Λ))
    (Mbar : ModuleCat.{z} (Λ ⧸ I)) : Prop :=
  Module.Finite (AdicCompletion I Λ) M ∧ Module.Projective (AdicCompletion I Λ) M ∧
    ∃ ψ : (M ⧸ (completedCoefficientIdeal Λ I •
        (⊤ : Submodule (AdicCompletion I Λ) M))) ≃+ Mbar,
      ∀ (c : AdicCompletion I Λ)
        (x : M ⧸ (completedCoefficientIdeal Λ I • (⊤ : Submodule (AdicCompletion I Λ) M))),
        ψ (Ideal.Quotient.mk (completedCoefficientIdeal Λ I) c • x) =
          AdicCompletion.evalOneₐ I c • ψ x

end Coefficients

section Lifting

variable (Λ : Type r) [CommRing Λ] (I : Ideal Λ)

/-- **Lifting a finite projective module along `Λ^∧ → Λ/I`.** Every finite projective
`Λ/I`-module is the reduction modulo `I` of a finite projective `Λ^∧`-module.

This is the footnote of the source's proof of Stacks 09C3: there a projector
`p̄ : (Λ/I)^{⊕t} → (Λ/I)^{⊕t}` with image the given module is lifted, by Algebra, Lemma 10.32.7
(Stacks 05BU), to a compatible system of projectors over the `Λ/Iⁿ`, and `p = lim pₙ` is formed
using `Λ^∧ = lim Λ/Iⁿ`. Here it is deduced instead from Stacks 0D4A for the henselian pair
`(Λ^∧, IΛ^∧)` of `AlgebraicGeometry.ProEtale.henselianPair_completedCoefficients`. -/
theorem exists_isCompletedCoefficientLift (hI : I.FG)
    (Mbar : ModuleCat.{max r z} (Λ ⧸ I))
    [Module.Finite (Λ ⧸ I) Mbar] [Module.Projective (Λ ⧸ I) Mbar] :
    ∃ M : ModuleCat.{max r z} (AdicCompletion I Λ),
      IsCompletedCoefficientLift.{r, max r z} Λ I M Mbar := by
  set A := AdicCompletion I Λ with hA
  set J := completedCoefficientIdeal Λ I with hJ
  set e := completedCoefficientQuotEquiv Λ I hI with he
  let _ : Module (A ⧸ J) Mbar := Module.compHom Mbar (e : (A ⧸ J) →+* (Λ ⧸ I))
  have hsm : ∀ (c : A ⧸ J) (m : Mbar), c • m = (e c) • m := fun _ _ => rfl
  let _ : RingHomInvPair (e : (A ⧸ J) →+* (Λ ⧸ I)) (e.symm : (Λ ⧸ I) →+* (A ⧸ J)) :=
    RingHomInvPair.of_ringEquiv e
  let _ : RingHomInvPair (e.symm : (Λ ⧸ I) →+* (A ⧸ J)) (e : (A ⧸ J) →+* (Λ ⧸ I)) :=
    RingHomInvPair.of_ringEquiv_symm e
  let eq : Mbar ≃ₛₗ[(e.symm : (Λ ⧸ I) →+* (A ⧸ J))] Mbar :=
    { toFun := id
      map_add' := fun _ _ => rfl
      map_smul' := fun c m => by rw [hsm]; simp
      invFun := id
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  have : Module.Finite (A ⧸ J) Mbar :=
    Module.Finite.of_surjective eq.toLinearMap (fun x => ⟨x, rfl⟩)
  have : Module.Projective (A ⧸ J) Mbar := Module.Projective.of_equiv eq
  obtain ⟨P, _, _, hPfin, hPproj, ⟨φ⟩⟩ :=
    (henselianPair_finiteProjective_quotient_bijective.{r, max r z, max r z} J
      (henselianPair_completedCoefficients Λ I hI)).1 Mbar
  refine ⟨ModuleCat.of A P, hPfin, hPproj, φ.toAddEquiv, fun c x => ?_⟩
  rw [show (φ.toAddEquiv : _ → _) = φ from rfl, φ.map_smul, hsm,
    completedCoefficientQuotEquiv_mk]

end Lifting

end AlgebraicGeometry.ProEtale

