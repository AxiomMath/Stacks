module

public import Mathlib.CategoryTheory.Sites.DenseSubsite.SheafEquiv
public import StacksFrontier.AlgebraicGeometry.ProEtale.IndEtale.QuotientLift
public import StacksFrontier.AlgebraicGeometry.ProEtale.SiteFunctoriality.AffineDenseSubsite
public import StacksFrontier.AlgebraicGeometry.ProEtale.SiteFunctoriality.InverseImageLowerShriek
public import StacksCore.Tactic.StacksAttribute

/-!
# The affine ind-étale pro-étale site, and pro-étale base change on it

For a scheme `S`, the category `S_app` is the full subcategory of the small pro-étale site
`S_{pro-étale}` on the objects `U` which are affine and for which the ring map on global sections
`O(S) → O(U)` is ind-étale; it carries the topology generated by the finite families which are
pro-étale coverings of the ambient site. For a morphism of affine schemes `i : Z ⟶ X`, pro-étale
base change restricts to a functor `u : X_app ⥤ Z_app`.

## Main definitions

* `AlgebraicGeometry.ProEtale.IsAffineIndEtaleAlgebra`: being affine with ind-étale coordinate
  ring extension, as an object property of the small pro-étale site.
* `AlgebraicGeometry.ProEtale.AppProetale`: the category `S_app`.
* `AlgebraicGeometry.ProEtale.AppProetale.precoverage` and
  `AlgebraicGeometry.ProEtale.AppProetale.topology`: the finite standard pro-étale covering
  families of affine ind-étale objects, and the topology they generate.
* `AlgebraicGeometry.ProEtale.HasAppCover`: every affine object of the small pro-étale site is
  covered by a single affine ind-étale one.
* `AlgebraicGeometry.ProEtale.appBaseChange`: the functor `u`, pro-étale base change along a
  morphism of affine schemes, restricted to the affine ind-étale subcategories.
* `AlgebraicGeometry.ProEtale.proetaleBaseChangeAppTopPushoutIso`: the coordinate ring of a
  pro-étale base change, as a pushout of rings under `Γ(Z, ⊤)`.

## Main results

* `AlgebraicGeometry.ProEtale.isPushout_appTop_pullback_proEt`: for an affine object of the
  small pro-étale site of an affine scheme, the global sections of its pullback square along a
  morphism of affine schemes form a pushout square of rings.
* `AlgebraicGeometry.ProEtale.appInclusion_isCoverDense` and
  `AlgebraicGeometry.ProEtale.appInclusion_isDenseSubsite`: given `HasAppCover`, the affine
  ind-étale objects are a dense subsite of the small pro-étale site for the topology they
  induce, so restriction of sheaves along the inclusion is an equivalence of topoi.
* `AlgebraicGeometry.ProEtale.AppProetale.topology_le_inducedTopology`: the topology generated
  by the finite standard pro-étale coverings is contained in that induced topology.
* `AlgebraicGeometry.ProEtale.isAffineIndEtale_proetaleBaseChange`: pro-étale base change along
  a morphism of affine schemes preserves affine ind-étale objects.
* `AlgebraicGeometry.ProEtale.appBaseChange_isContinuous`: the functor `u` is continuous when
  both affine ind-étale subcategories are dense subsites.
* `AlgebraicGeometry.ProEtale.isRightAdjoint_proetaleInverseImage_of_appAdjunction` and
  `AlgebraicGeometry.ProEtale.isRightAdjoint_proetaleInverseImage_of_hasAppCover`: if `u` has a
  continuous left adjoint, then the pro-étale inverse image along `i` has a left adjoint
  (Stacks 09BL (3)).

## Implementation notes

* Ind-étaleness of `O(S) → O(U)` is the ind-completion `ObjectProperty.ind` of
  `CommRingCat.etale.underObj` at `Γ(S, ⊤)`, evaluated on `Under.mk U.hom.appTop`, as in
  `AlgebraicGeometry.ProEtale.IndEtaleAlgebra`.
* `IsAffineIndEtaleAlgebra`, `AppProetale` and the covering families are stated for an arbitrary
  scheme `S`; they give the category of Stacks 098X when `S` is affine. `HasAppCover` and the
  results using it assume `[IsAffine S]`.
* The ambient site is `AlgebraicGeometry.Scheme.ProEt`, the small pro-étale site of `S` with no
  size restriction, rather than a subcategory of a chosen big pro-étale site containing `S`.
* `appBaseChange` is defined for an arbitrary morphism of affine schemes, not only for a closed
  immersion.
* The dense subsite is exhibited for the topology induced by the inclusion rather than for
  `AppProetale.topology`; of the comparison of the two, only
  `AppProetale.topology_le_inducedTopology` is proved. The results on base change take the
  topologies as parameters.

## References

* [Stacks Project, Tag 097Z](https://stacks.math.columbia.edu/tag/097Z)
* [Stacks Project, Tag 098X](https://stacks.math.columbia.edu/tag/098X)
* [Stacks Project, Tag 09BK](https://stacks.math.columbia.edu/tag/09BK)
* [Stacks Project, Tag 09BL](https://stacks.math.columbia.edu/tag/09BL)
* [Stacks Project, Tag 08NH](https://stacks.math.columbia.edu/tag/08NH)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u w

namespace AlgebraicGeometry.ProEtale

variable (S : Scheme.{u})

/-- An object of the small pro-étale site of `S` is *affine ind-étale* if its underlying scheme
is affine and the induced ring map on global sections `Γ(S, ⊤) → Γ(V.left, ⊤)` is ind-étale. -/
public abbrev IsAffineIndEtaleAlgebra : ObjectProperty S.ProEt :=
  fun V ↦ IsAffine V.left ∧
    ObjectProperty.ind.{u} (CommRingCat.etale.underObj (X := Γ(S, ⊤))) (Under.mk V.hom.appTop)

/-- The category `S_app`: the full subcategory of the small pro-étale site of `S` on the affine
objects whose coordinate ring extension is ind-étale. -/
@[stacks 098X "the category"]
public abbrev AppProetale := (IsAffineIndEtaleAlgebra S).FullSubcategory

namespace AppProetale

/-- The full inclusion of the affine ind-étale objects into the small pro-étale site. -/
public abbrev inclusion : AppProetale S ⥤ S.ProEt := (IsAffineIndEtaleAlgebra S).ι

/-- Standard finite pro-étale covering families of affine ind-étale objects: families whose
image in the small pro-étale site is a pro-étale covering, and which are finite. -/
public abbrev IsCovering (E : Covering (AppProetale S)) : Prop :=
  (E.2.map (inclusion S)).presieve₀ ∈ Scheme.ProEt.precoverage S E.1.obj ∧ Finite E.2.I₀

/-- Precoverage of the affine ind-étale site by finite standard pro-étale covering families. -/
@[stacks 098X "the coverings"]
public def precoverage : Precoverage (AppProetale S) where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 1} X,
    R = E.presieve₀ ∧ IsCovering S ⟨X, E⟩}

/-- The pro-étale topology on the affine ind-étale site. -/
public abbrev topology : GrothendieckTopology (AppProetale S) :=
  (precoverage S).toGrothendieck

end AppProetale

/-- The coordinate ring of an affine ind-étale object, as an object of the category of ind-étale
`Γ(S, ⊤)`-algebras. -/
public def appToIndEtaleAlgebra (V : AppProetale S) : IndEtaleAlgebra ↥Γ(S, ⊤) :=
  ⟨Under.mk V.obj.hom.appTop, V.property.2⟩

/-- Every affine object `V` of the small pro-étale site of `S` is covered, in the pro-étale
topology, by a single affine ind-étale object (a consequence of Stacks 097Z). -/
public abbrev HasAppCover [IsAffine S] : Prop :=
  ∀ V : S.ProEt, IsAffine V.left →
    ∃ (A : AppProetale S) (p : (AppProetale.inclusion S).obj A ⟶ V),
      Sieve.generate (Presieve.singleton p) ∈ Scheme.ProEt.topology S V

/-- If `HasAppCover S` holds, the affine ind-étale objects are cover-dense in the small pro-étale
site of `S`. -/
public theorem appInclusion_isCoverDense [IsAffine S] (h : HasAppCover S) :
    (AppProetale.inclusion S).IsCoverDense (Scheme.ProEt.topology S) := by
  have hden := affineInclusion_isDenseSubsite S
  have hcd : (AffineProetale.inclusion S).IsCoverDense (Scheme.ProEt.topology S) :=
    Functor.IsDenseSubsite.isCoverDense (AffineProetale.topology S) _ _
  refine ⟨fun V ↦ ?_⟩
  refine (Scheme.ProEt.topology S).transitive
    ((AffineProetale.inclusion S).is_cover_of_isCoverDense _ V) _ ?_
  rintro Y g ⟨W, lift, map, fac⟩
  obtain ⟨A, p, hp⟩ := h ((AffineProetale.inclusion S).obj W) W.property
  refine (Scheme.ProEt.topology S).superset_covering ?_
    ((Scheme.ProEt.topology S).pullback_stable lift hp)
  rintro Y' h' ⟨T, e, q, ⟨⟩, hcomp⟩
  refine ⟨⟨A, e, p ≫ map, ?_⟩⟩
  rw [← fac, ← Category.assoc, hcomp, Category.assoc]

/-- If `HasAppCover S` holds, the inclusion exhibits the affine ind-étale objects, with the induced
topology, as a dense subsite of the small pro-étale site of `S` (Stacks 098X); so
`CategoryTheory.Functor.IsDenseSubsite.sheafEquiv` gives an equivalence of topoi, with
restriction of sheaves as its inverse. -/
public theorem appInclusion_isDenseSubsite [IsAffine S] (h : HasAppCover S) :
    (AppProetale.inclusion S).IsDenseSubsite
      ((AppProetale.inclusion S).inducedTopology (Scheme.ProEt.topology S))
      (Scheme.ProEt.topology S) := by
  have := appInclusion_isCoverDense S h
  infer_instance

/-- If `HasAppCover S` holds, the topology generated by the finite standard pro-étale covering
families of affine ind-étale objects is contained in the topology induced by the inclusion. -/
public theorem AppProetale.topology_le_inducedTopology [IsAffine S] (h : HasAppCover S) :
    AppProetale.topology S ≤
      (AppProetale.inclusion S).inducedTopology (Scheme.ProEt.topology S) := by
  have := appInclusion_isCoverDense S h
  rw [Functor.le_inducedTopology_iff]
  have hpre : AppProetale.precoverage S ≤
      ((Scheme.ProEt.topology S).toPrecoverage).comap (AppProetale.inclusion S) := by
    rintro U R ⟨E, hEq, hE⟩
    rw [Precoverage.mem_comap_iff, hEq, ← PreZeroHypercover.presieve₀_map,
      GrothendieckTopology.mem_toPrecoverage_iff]
    exact Precoverage.generate_mem_toGrothendieck hE.1
  have hcoverPres : CoverPreserving (AppProetale.topology S) (Scheme.ProEt.topology S)
      (AppProetale.inclusion S) := by
    refine ⟨fun {U T} hT ↦ ?_⟩
    rw [← Functor.mem_restrictedTopology_iff]
    exact (Precoverage.toGrothendieck_mono hpre) U hT
  exact Functor.IsCoverDense.isContinuous _ _ _ hcoverPres

variable {S}

/-- For an affine object `U` of the small pro-étale site of an affine scheme `X` and a morphism
of affine schemes `i : Z ⟶ X`, the global sections of the pullback square of `U.left` along `i`
form a pushout square of rings. -/
public theorem isPushout_appTop_pullback_proEt {Z X : Scheme.{u}} [IsAffine X] [IsAffine Z]
    (i : Z ⟶ X) (U : X.ProEt) (hU : IsAffine U.left) :
    IsPushout U.hom.appTop i.appTop (pullback.fst U.hom i).appTop
      (pullback.snd U.hom i).appTop := by
  have : IsAffine ((𝟭 Scheme.{u}).obj U.left) := hU
  have : IsAffine ((Functor.fromPUnit X).obj U.right) := ‹IsAffine X›
  exact isPushout_appTop_of_isPullback (IsPullback.of_hasPullback U.hom i)

/-- The coordinate ring of the pro-étale base change of an affine object `U` along a morphism of
affine schemes `i : Z ⟶ X` is the pushout of that of `U` along `Γ(X, ⊤) ⟶ Γ(Z, ⊤)`, as an object
under `Γ(Z, ⊤)`. -/
public noncomputable def proetaleBaseChangeAppTopPushoutIso {Z X : Scheme.{u}} [IsAffine X]
    [IsAffine Z] (i : Z ⟶ X) (U : X.ProEt) (hU : IsAffine U.left) :
    (Under.pushout i.appTop).obj (Under.mk U.hom.appTop) ≅
      Under.mk ((Scheme.proetaleBaseChange i).obj U).hom.appTop :=
  (Under.isoMk (isPushout_appTop_pullback_proEt i U hU).isoPushout
    (by exact (isPushout_appTop_pullback_proEt i U hU).inr_isoPushout_hom)).symm

/-- Pro-étale base change along a morphism of affine schemes `i : Z ⟶ X` takes affine ind-étale
objects of `X` to affine ind-étale objects of `Z`. -/
public theorem isAffineIndEtale_proetaleBaseChange {Z X : Scheme.{u}} [IsAffine X] [IsAffine Z]
    (i : Z ⟶ X) (U : X.ProEt) (hU : IsAffineIndEtaleAlgebra X U) :
    IsAffineIndEtaleAlgebra Z ((Scheme.proetaleBaseChange i).obj U) := by
  obtain ⟨haff, hind⟩ := hU
  have : IsAffine ((𝟭 Scheme.{u}).obj U.left) := haff
  have : IsAffineHom i := isAffineHom_of_isAffine i
  exact ⟨IsAffine.of_isPullback (IsPullback.of_hasPullback U.hom i),
    (ObjectProperty.ind.{u} (CommRingCat.etale.underObj (X := Γ(Z, ⊤)))).prop_of_iso
      (proetaleBaseChangeAppTopPushoutIso i U haff)
      (MorphismProperty.ind_underObj_pushout (P := CommRingCat.etale.{u}) (g := i.appTop) hind)⟩

/-- The functor `u`: pro-étale base change along a morphism of affine schemes `i : Z ⟶ X`, as a
functor `X_app ⥤ Z_app` between the affine ind-étale sites. On underlying schemes it is
`U ↦ U ×_X Z`. -/
@[stacks 09BK "the base-change functor"]
public noncomputable def appBaseChange {Z X : Scheme.{u}} [IsAffine X] [IsAffine Z]
    (i : Z ⟶ X) : AppProetale X ⥤ AppProetale Z :=
  (IsAffineIndEtaleAlgebra Z).lift (AppProetale.inclusion X ⋙ Scheme.proetaleBaseChange i)
    (fun U ↦ isAffineIndEtale_proetaleBaseChange i U.obj U.property)

/-- Base change on the affine ind-étale sites is the restriction of base change on the small
pro-étale sites. -/
public theorem appBaseChange_comp_inclusion {Z X : Scheme.{u}} [IsAffine X] [IsAffine Z]
    (i : Z ⟶ X) : appBaseChange i ⋙ AppProetale.inclusion Z =
      AppProetale.inclusion X ⋙ Scheme.proetaleBaseChange i := rfl

section Transport

variable {Z X : Scheme.{u}} [IsAffine X] [IsAffine Z] (i : Z ⟶ X)
  (JX : GrothendieckTopology (AppProetale X)) (JZ : GrothendieckTopology (AppProetale Z))

/-- If the affine ind-étale sites of `X` and `Z`, with topologies `JX` and `JZ`, are dense
subsites of the small pro-étale sites, then the base-change functor `u` is continuous. -/
public theorem appBaseChange_isContinuous
    (hdenseX : (AppProetale.inclusion X).IsDenseSubsite JX (Scheme.ProEt.topology X))
    (hdenseZ : (AppProetale.inclusion Z).IsDenseSubsite JZ (Scheme.ProEt.topology Z)) :
    (appBaseChange i).IsContinuous JX JZ := by
  have := hdenseX
  have := hdenseZ
  refine ⟨fun G ↦ ?_⟩
  let RZ := (AppProetale.inclusion Z).sheafPushforwardContinuous
    (Type (max (u + 1) u u (u + 1))) JZ (Scheme.ProEt.topology Z)
  have hRZ : RZ.IsEquivalence := inferInstance
  let G' := RZ.objPreimage G
  have e : G.obj ≅ (AppProetale.inclusion Z).op ⋙ G'.obj :=
    (sheafToPresheaf _ _).mapIso (RZ.objObjPreimageIso G).symm
  have hc : (AppProetale.inclusion X ⋙ Scheme.proetaleBaseChange i).IsContinuous
      JX (Scheme.ProEt.topology Z) :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology X) _
  have hsh : Presieve.IsSheaf JX
      ((AppProetale.inclusion X ⋙ Scheme.proetaleBaseChange i).op ⋙ G'.obj) :=
    Functor.op_comp_isSheaf_of_types _ JX (Scheme.ProEt.topology Z) G'
  exact Presieve.isSheaf_iso JX (Functor.associator (appBaseChange i).op
    (AppProetale.inclusion Z).op G'.obj ≪≫ Functor.isoWhiskerLeft (appBaseChange i).op e.symm) hsh

/-- Let `i : Z ⟶ X` be a morphism of affine schemes, and suppose the affine ind-étale sites of `X`
and `Z`, with topologies `JX` and `JZ`, are dense subsites of the small pro-étale sites. If the
base-change functor `u` has a continuous left adjoint `W`, then the pro-étale inverse image
`i^{-1}`, the left adjoint of restriction of sheaves along
`AlgebraicGeometry.Scheme.proetaleBaseChange i`, has a left adjoint (Stacks 09BL (3)). -/
public theorem isRightAdjoint_proetaleInverseImage_of_appAdjunction
    (hdenseX : (AppProetale.inclusion X).IsDenseSubsite JX (Scheme.ProEt.topology X))
    (hdenseZ : (AppProetale.inclusion Z).IsDenseSubsite JZ (Scheme.ProEt.topology Z))
    (W : AppProetale Z ⥤ AppProetale X) (hW : W.IsContinuous JZ JX)
    (adj : W ⊣ appBaseChange i) :
    (Functor.sheafPullbackConstruction.sheafPullback (Scheme.proetaleBaseChange i)
      (Type (max (u + 1) w)) (Scheme.ProEt.topology X)
      (Scheme.ProEt.topology Z)).IsRightAdjoint := by
  have := hdenseX
  have := hdenseZ
  have := hW
  have hbc := appBaseChange_isContinuous i JX JZ hdenseX hdenseZ
  let A := Type (max (u + 1) w)
  let RX := (AppProetale.inclusion X).sheafPushforwardContinuous A JX
    (Scheme.ProEt.topology X)
  let RZ := (AppProetale.inclusion Z).sheafPushforwardContinuous A JZ
    (Scheme.ProEt.topology Z)
  have hRX : RX.IsEquivalence := inferInstance
  have hRZ : RZ.IsEquivalence := inferInstance
  let eX := RX.asEquivalence
  let eZ := RZ.asEquivalence
  let Pu := Functor.sheafPullbackConstruction.sheafPullback (appBaseChange i) A JX JZ
  let Su := (appBaseChange i).sheafPushforwardContinuous A JX JZ
  let SG := (Scheme.proetaleBaseChange i).sheafPushforwardContinuous A
    (Scheme.ProEt.topology X) (Scheme.ProEt.topology Z)
  have hPu : Pu.IsRightAdjoint :=
    Adjunction.isRightAdjoint_sheafPullbackConstruction (A := A) adj
  have hc : (AppProetale.inclusion X ⋙ Scheme.proetaleBaseChange i).IsContinuous
      JX (Scheme.ProEt.topology Z) :=
    Functor.isContinuous_comp _ _ _ (Scheme.ProEt.topology X) _
  let PFG := (AppProetale.inclusion X ⋙ Scheme.proetaleBaseChange i).sheafPushforwardContinuous
    A JX (Scheme.ProEt.topology Z)
  have c1 : SG ⋙ RX ≅ PFG :=
    Functor.sheafPushforwardContinuousComp' (eFG := Iso.refl _) (A := A) (J := JX)
      (K := Scheme.ProEt.topology X) (L := Scheme.ProEt.topology Z)
  have c2 : RZ ⋙ Su ≅ PFG :=
    Functor.sheafPushforwardContinuousComp' (eFG := eqToIso (appBaseChange_comp_inclusion i))
      (A := A) (J := JX) (K := JZ) (L := Scheme.ProEt.topology Z)
  have key : RZ ⋙ Su ≅ SG ⋙ RX := c2 ≪≫ c1.symm
  have iso : eZ.functor ⋙ (Su ⋙ eX.inverse) ≅ SG :=
    (Functor.associator eZ.functor Su eX.inverse).symm ≪≫
      Functor.isoWhiskerRight key eX.inverse ≪≫
      Functor.associator SG RX eX.inverse ≪≫
      Functor.isoWhiskerLeft SG eX.unitIso.symm ≪≫ SG.rightUnitor
  let adjCand := (eX.toAdjunction.comp
    (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (appBaseChange i) A
      JX JZ)).comp eZ.symm.toAdjunction
  let adjT := Functor.sheafPullbackConstruction.sheafAdjunctionContinuous
    (Scheme.proetaleBaseChange i) A (Scheme.ProEt.topology X) (Scheme.ProEt.topology Z)
  have eT : Functor.sheafPullbackConstruction.sheafPullback (Scheme.proetaleBaseChange i) A
      (Scheme.ProEt.topology X) (Scheme.ProEt.topology Z) ≅
      (eX.functor ⋙ Pu) ⋙ eZ.inverse :=
    Adjunction.leftAdjointUniq adjT (adjCand.ofNatIsoRight iso)
  exact ((eZ.toAdjunction.comp
    ((Adjunction.ofIsRightAdjoint Pu).comp eX.symm.toAdjunction)).ofNatIsoRight
      eT.symm).isRightAdjoint

/-- Let `i : Z ⟶ X` be a morphism of affine schemes with `HasAppCover X` and `HasAppCover Z`. If
the base-change functor `u` has a left adjoint `W` which is continuous for the induced
topologies, then the pro-étale inverse image `i^{-1}` has a left adjoint (Stacks 09BL (3)). -/
public theorem isRightAdjoint_proetaleInverseImage_of_hasAppCover
    (hX : HasAppCover X) (hZ : HasAppCover Z)
    (W : AppProetale Z ⥤ AppProetale X)
    (hW : W.IsContinuous ((AppProetale.inclusion Z).inducedTopology (Scheme.ProEt.topology Z))
      ((AppProetale.inclusion X).inducedTopology (Scheme.ProEt.topology X)))
    (adj : W ⊣ appBaseChange i) :
    (Functor.sheafPullbackConstruction.sheafPullback (Scheme.proetaleBaseChange i)
      (Type (max (u + 1) w)) (Scheme.ProEt.topology X)
      (Scheme.ProEt.topology Z)).IsRightAdjoint :=
  isRightAdjoint_proetaleInverseImage_of_appAdjunction i _ _
    (appInclusion_isDenseSubsite X hX) (appInclusion_isDenseSubsite Z hZ) W hW adj

end Transport

end AlgebraicGeometry.ProEtale

end
