module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Abelian
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Submodule
public import StacksFrontier.AlgebraicGeometry.Modules.IdealPowerMultiple
public import StacksFrontier.CategoryTheory.Sites.Modules.RingedSite

/-!
# The adic quotient system of a sheaf of modules on a ringed site

Let `X` be a ringed site, let `I` be a sheaf of ideals in its structure sheaf, presented as a
submodule of the unit sheaf of modules, and let `F` be a sheaf of modules on `X`. This file
builds the subsheaf `IⁿF` of `F` for each `n`, the inverse system `n ↦ F/IⁿF` of its quotients,
and the cone of canonical quotient maps out of `F`. These are the data whose limit expresses
adic completeness of `F`.

The subsheaf `IⁿF` is defined as the least subsheaf of `F` which, on every object of the site,
is stable under multiplication by the sections of `Iⁿ`. Taking an infimum rather than a
sectionwise image keeps the construction available with no finiteness hypothesis on `I`, and
an infimum of subsheaves is a subsheaf with no sheafification step.

## Main definitions

* `AlgebraicGeometry.RingedSite.idealSections`: the sections of `I` over an object, as an ideal.
* `AlgebraicGeometry.RingedSite.idealPowerProduct`: the subsheaf `IⁿF` of `F`.
* `AlgebraicGeometry.RingedSite.idealPowerQuotientMap`: the transition map
  `F/IᵐF ⟶ F/IⁿF` for `n ≤ m`.
* `AlgebraicGeometry.RingedSite.idealPowerQuotientSystem`: the inverse system `n ↦ F/IⁿF`.
* `AlgebraicGeometry.RingedSite.AdicQuotientSystem`: the specification of an inverse system of
  quotients of `F` by the subsheaves `IⁿF`, together with its quotient maps out of `F`.
* `AlgebraicGeometry.RingedSite.adicQuotientSystem`: the canonical such system.

## Main results

* `AlgebraicGeometry.RingedSite.idealPowerProduct_mono`: the filtration `IⁿF` decreases in `n`.
* `AlgebraicGeometry.RingedSite.cokernel_π_idealPowerQuotientMap`: the quotient maps out of `F`
  are compatible with the transition maps of the system.

## Implementation notes

`AdicQuotientSystem` is a specification rather than a construction: its field `isQuotient`
asks for an isomorphism identifying each term with the cokernel of `IⁿF ⟶ F` under which the
given map out of `F` becomes the cokernel projection. This pins the system down up to unique
isomorphism, so a statement quantified over `AdicQuotientSystem X I F` says the same thing
about every presentation of `F/IⁿF`, while `adicQuotientSystem` exhibits one.

## References

* [Stacks Project, Tag 099Q](https://stacks.math.columbia.edu/tag/099Q)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u v

namespace AlgebraicGeometry.RingedSite

/-- The sections of a sheaf of ideals over an object of the site, read as an ideal of the ring
of sections there.

`I` is given as a submodule of the unit sheaf of modules, so its sections form a submodule of
the sections of the unit sheaf; the carrier of the latter is the ring of sections itself, which
is what makes this an ideal. Naming that identification here is what lets the definitions below
raise `I` to a power without relying on the elaborator to unfold `SheafOfModules.unit`. -/
def idealSections
    (X : RingedSite.{u, v, max u v})
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (U : X.Cᵒᵖ) : Ideal (((Stacks.SheafOfModules.Tensor.ringSheaf X.O)).obj.obj U) :=
  I.toSubmodule.obj U

/-- The subsheaf of `F` locally generated by products of sections of `Iⁿ`
with sections of `F`. -/
def idealPowerProduct
    (X : RingedSite.{u, v, max u v})
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (F : SheafOfModules.{max u v} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    (n : ℕ) : F.Submodule := by
  letI : CompleteLattice F.Submodule := SheafOfModules.Submodule.instCompleteLattice
  exact sInf { N : F.Submodule |
    ∀ U : X.Cᵒᵖ,
      let R := ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)).obj.obj U
      letI : CommRing R := by
        change CommRing (X.O.obj.obj U)
        infer_instance
      letI : Module R (F.val.obj U) := (F.val.obj U).isModule
      let J : Ideal R := idealSections X I U
      ∀ (a : R), a ∈ J ^ n →
        ∀ m : F.val.obj U, a • m ∈ N.toSubmodule.obj U }

/-- The adic filtration decreases: `IᵐF ≤ IⁿF` whenever `n ≤ m`. -/
lemma idealPowerProduct_mono
    (X : RingedSite.{u, v, max u v})
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (F : SheafOfModules.{max u v} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    {n m : ℕ} (hnm : n ≤ m) :
    idealPowerProduct X I F m ≤ idealPowerProduct X I F n := by
  unfold idealPowerProduct
  exact sInf_le_sInf fun N hN U a ha m => hN U a (Ideal.pow_le_pow_right hnm ha) m

/-- The transition map `F/IᵐF ⟶ F/IⁿF` of the adic quotient system, for `n ≤ m`. It is induced
on cokernels by the inclusion `IᵐF ⟶ IⁿF`. -/
def idealPowerQuotientMap
    (X : RingedSite.{u, v, max u v})
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (F : SheafOfModules.{max u v} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    {n m : ℕ} (hnm : n ≤ m) :
    cokernel (idealPowerProduct X I F m).ι ⟶
      cokernel (idealPowerProduct X I F n).ι :=
  cokernel.desc _ (cokernel.π (idealPowerProduct X I F n).ι) <| by
    rw [← SheafOfModules.Submodule.homOfLE_ι (idealPowerProduct_mono X I F hnm), Category.assoc,
      cokernel.condition, comp_zero]

/-- The quotient projection `F ⟶ F/IᵐF` followed by the transition map to `F/IⁿF` is the
quotient projection `F ⟶ F/IⁿF`. -/
lemma cokernel_π_idealPowerQuotientMap
    (X : RingedSite.{u, v, max u v})
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (F : SheafOfModules.{max u v} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)))
    {n m : ℕ} (hnm : n ≤ m) :
    cokernel.π (idealPowerProduct X I F m).ι ≫
        idealPowerQuotientMap X I F hnm =
      cokernel.π (idealPowerProduct X I F n).ι := by
  simp [idealPowerQuotientMap]

/-- The inverse system `n ↦ F/IⁿF` of adic quotients of `F`, with the transition maps induced by
the inclusions of the adic filtration. -/
def idealPowerQuotientSystem
    (X : RingedSite.{u, v, max u v})
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (F : SheafOfModules.{max u v} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    ℕᵒᵖ ⥤ SheafOfModules.{max u v} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O)) where
  obj i := cokernel (idealPowerProduct X I F i.unop).ι
  map hij := idealPowerQuotientMap X I F (leOfHom hij.unop)
  map_id i := by
    apply (cancel_epi (cokernel.π (idealPowerProduct X I F i.unop).ι)).1
    simp only [cokernel_π_idealPowerQuotientMap, Category.comp_id]
  map_comp {i j k} f g := by
    apply (cancel_epi (cokernel.π (idealPowerProduct X I F i.unop).ι)).1
    symm
    simp only [← Category.assoc, cokernel_π_idealPowerQuotientMap]

/-- An inverse system of the quotient sheaves `F/IⁿF`, with the canonical
quotient maps from `F`. The componentwise cokernel specifications ensure that
the chosen system is the canonical one, up to unique isomorphism. -/
structure AdicQuotientSystem
    (X : RingedSite.{u, v, max u v})
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (F : SheafOfModules.{max u v} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) where
  /-- The inverse system of quotients. -/
  Q : ℕᵒᵖ ⥤ SheafOfModules.{max u v} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))
  /-- The quotient maps out of `F`, as a cone over the system. -/
  quotientMap : (Functor.const ℕᵒᵖ).obj F ⟶ Q
  /-- Each term of the system is the quotient `F/IⁿF`, compatibly with the quotient map. -/
  isQuotient (n : ℕ) :
    ∃ e : cokernel (idealPowerProduct X I F n).ι ≅ Q.obj (op n),
      cokernel.π (idealPowerProduct X I F n).ι ≫ e.hom = quotientMap.app (op n)

/-- The canonical inverse system of the quotient sheaves `F/IⁿF`, together
with its cone of quotient maps. The cokernel specification determines the
system up to unique isomorphism. -/
def adicQuotientSystem
    (X : RingedSite.{u, v, max u v})
    (I : SheafOfModules.Submodule
      (SheafOfModules.unit ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))))
    (F : SheafOfModules.{max u v} ((Stacks.SheafOfModules.Tensor.ringSheaf X.O))) :
    AdicQuotientSystem X I F where
  Q := idealPowerQuotientSystem X I F
  quotientMap :=
  { app := fun n => cokernel.π (idealPowerProduct X I F n.unop).ι
    naturality := by
      intro i j f
      change cokernel.π (idealPowerProduct X I F j.unop).ι =
        cokernel.π (idealPowerProduct X I F i.unop).ι ≫
          idealPowerQuotientMap X I F (leOfHom f.unop)
      exact (cokernel_π_idealPowerQuotientMap X I F (leOfHom f.unop)).symm }
  isQuotient := fun n =>
    ⟨Iso.refl (cokernel (idealPowerProduct X I F n).ι), Category.comp_id _⟩

end AlgebraicGeometry.RingedSite

end
