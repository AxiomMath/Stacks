module

public import Mathlib.Algebra.MvPolynomial.Cardinal
public import StacksFrontier.AlgebraicGeometry.ProEtale.IndEtale.QuotientLift
public import StacksFrontier.AlgebraicGeometry.ProEtale.Site.Big
public import StacksFrontier.AlgebraicGeometry.Size.FiniteType

/-!
# Size of the ind-étale lift across a quotient

Let `A` be a commutative ring, `I ⊆ A` an ideal and `V` an ind-étale `A ⧸ I`-algebra. The
right-adjoint lift `AlgebraicGeometry.ProEtale.indEtaleQuotientLift` produces an ind-étale
`A`-algebra, and the construction gives no a priori bound on its cardinality. This module
bounds it by `2 ^ max (max #A #V) ℵ₀`, which is enough to place the spectrum of the lift back
inside a big pro-étale site containing the spectra of `A` and of `V`.

## Main results

* `AlgebraicGeometry.ProEtale.liftedSpec_size_lt_cutoff`: for affine `X` and `Z` inside a big
  pro-étale site, the spectrum of the lift of an ind-étale `Γ(X, ⊤) ⧸ I`-algebra of size at
  most that of `Z` is again inside that site.
* `AlgebraicGeometry.ProEtale.exists_specialization_indEtaleQuotientLift`: every point of the
  spectrum of the lift specializes to a point of the closed subscheme cut out by `I`.

## Implementation notes

The bound comes from a surjection onto the lift from a type of *codes*: a code is a finitely
presented étale `A`-algebra `E`, given by a skeletal presentation `FGAlgCatSkeleton A`, an
`A`-algebra map `E → V`, and an element of `E`. Such a code names the element of the lift
obtained by transporting the element along the unit of the adjunction, and surjectivity is the
statement that the lift is the filtered colimit of its finitely presented étale stages.

The specialization statement rests on
`AlgebraicGeometry.ProEtale.indEtaleQuotientLift_isUnit_of_quotient_isUnit`: an element of the
lift that becomes a unit modulo `I` is already a unit, so the ideal generated by the image of
`I` meets every prime, and a prime containing both it and a given prime exists.

## References

* [Stacks Project, Tag 09BK](https://stacks.math.columbia.edu/tag/09BK)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open scoped AlgebraicGeometry

universe u

namespace AlgebraicGeometry.ProEtale

/-! ### Specialization into the closed subscheme -/

/-- If every element of `R` that becomes a unit modulo `I` is already a unit, then every prime
of `R` is contained in a prime containing `I`. -/
private lemma exists_specialization_over_ideal {R : Type u} [CommRing R] (I : Ideal R)
    (hunit : ∀ g : R, IsUnit (Ideal.Quotient.mk I g) → IsUnit g) (x : PrimeSpectrum R) :
    ∃ y : PrimeSpectrum R, x.asIdeal ≤ y.asIdeal ∧ I ≤ y.asIdeal := by
  have hproper : x.asIdeal ⊔ I ≠ ⊤ := by
    intro htop
    have hone : (1 : R) ∈ x.asIdeal ⊔ I := by simp [htop]
    rw [Submodule.mem_sup] at hone
    obtain ⟨a, ha, b, hb, hab⟩ := hone
    have hm := congrArg (Ideal.Quotient.mk I) hab
    rw [map_add, Ideal.Quotient.eq_zero_iff_mem.mpr hb, add_zero] at hm
    have haunit : IsUnit (Ideal.Quotient.mk I a) := by simp [hm]
    exact x.isPrime.ne_top (Ideal.eq_top_of_isUnit_mem (I := x.asIdeal) ha (hunit a haunit))
  obtain ⟨q, hqmax, hq⟩ := Ideal.exists_le_maximal (x.asIdeal ⊔ I) hproper
  exact ⟨⟨q, hqmax.isPrime⟩, le_sup_left.trans hq, le_sup_right.trans hq⟩

/-- Every point of the spectrum of the ind-étale lift of `V` across `A ⧸ I` specializes to a
point of the closed subscheme cut out by the image of `I`. -/
theorem exists_specialization_indEtaleQuotientLift (A : Type u) [CommRing A] (I : Ideal A)
    (V : IndEtaleAlgebra (A ⧸ I))
    (x : PrimeSpectrum ((indEtaleQuotientLift A I).obj V).obj.right) :
    ∃ y : PrimeSpectrum ((indEtaleQuotientLift A I).obj V).obj.right,
      x.asIdeal ≤ y.asIdeal ∧
        I.map ((indEtaleQuotientLift A I).obj V).obj.hom.hom ≤ y.asIdeal :=
  exists_specialization_over_ideal
    (I.map ((indEtaleQuotientLift A I).obj V).obj.hom.hom)
    (indEtaleQuotientLift_isUnit_of_quotient_isUnit A I V) x

/-! ### Counting the finitely presented étale stages -/

/-- A skeletal presentation of a finitely generated `A`-algebra is a number of variables
together with an ideal of that polynomial ring, so there are at most `2 ^ max ℵ₀ #A` of
them. -/
private lemma cardinal_mk_fgAlgCatSkeleton_le (A : Type u) [CommRing A] :
    Cardinal.mk (FGAlgCatSkeleton A) ≤
      (2 : Cardinal.{u}) ^ max Cardinal.aleph0 (Cardinal.mk A) := by
  classical
  let κ := max Cardinal.aleph0 (Cardinal.mk A)
  let e : FGAlgCatSkeleton A ≃ Σ n : ℕ, Ideal (MvPolynomial (Fin n) A) :=
    { toFun := fun P => ⟨P.n, P.I⟩
      invFun := fun P => ⟨P.1, P.2⟩
      left_inv _ := rfl
      right_inv _ := rfl }
  have hpoly (n : ℕ) : Cardinal.mk (MvPolynomial (Fin n) A) ≤ κ := by
    calc
      Cardinal.mk (MvPolynomial (Fin n) A) ≤
          max (max (Cardinal.lift.{u} (Cardinal.mk A))
            (Cardinal.lift.{u} (Cardinal.mk (Fin n)))) Cardinal.aleph0 := by
        have h := MvPolynomial.cardinalMk_le_max_lift.{0, u} (σ := Fin n) (R := A)
        rw [Cardinal.lift_id'.{0, u}] at h
        simpa only [Cardinal.lift_id] using h
      _ ≤ κ := by
        have hA : Cardinal.lift.{u} (Cardinal.mk A) ≤ κ := by
          rw [Cardinal.lift_id]
          exact le_max_right _ _
        have hFin : Cardinal.lift.{u} (Cardinal.mk (Fin n)) ≤ κ := by
          have hFin' : Cardinal.lift.{u} (Cardinal.mk (Fin n)) ≤
              Cardinal.lift.{u} Cardinal.aleph0 := Cardinal.lift_le.2 Cardinal.mk_le_aleph0
          simpa only [Cardinal.lift_aleph0] using hFin'.trans (le_max_left _ _)
        exact max_le (max_le hA hFin) (le_max_left _ _)
  have hideal (n : ℕ) :
      Cardinal.mk (Ideal (MvPolynomial (Fin n) A)) ≤ (2 : Cardinal.{u}) ^ κ := by
    calc
      Cardinal.mk (Ideal (MvPolynomial (Fin n) A)) ≤
          Cardinal.mk (Set (MvPolynomial (Fin n) A)) :=
        Cardinal.mk_le_of_injective
          (f := fun I : Ideal (MvPolynomial (Fin n) A) => (I : Set (MvPolynomial (Fin n) A)))
          (fun I J h => Ideal.ext (Set.ext_iff.mp h))
      _ = (2 : Cardinal.{u}) ^ Cardinal.mk (MvPolynomial (Fin n) A) := Cardinal.mk_set
      _ ≤ (2 : Cardinal.{u}) ^ κ := Cardinal.power_le_power_left (by norm_num) (hpoly n)
  have hpow : Cardinal.aleph0 ≤ (2 : Cardinal.{u}) ^ κ :=
    (le_max_left _ _).trans (Cardinal.cantor κ).le
  calc
    Cardinal.mk (FGAlgCatSkeleton A) =
        Cardinal.sum (fun n : ℕ => Cardinal.mk (Ideal (MvPolynomial (Fin n) A))) := by
      rw [Cardinal.mk_congr e, Cardinal.mk_sigma]
    _ ≤ Cardinal.sum (fun _ : ℕ => (2 : Cardinal.{u}) ^ κ) :=
      Cardinal.sum_le_sum _ _ hideal
    _ = Cardinal.aleph0 * ((2 : Cardinal.{u}) ^ κ) := by simp
    _ ≤ (2 : Cardinal.{u}) ^ κ := Cardinal.mul_le_of_le hpow hpow le_rfl

/-- A skeletal presentation of a finitely presented étale `A`-algebra. -/
private abbrev FiniteEtaleSkeleton (A : Type u) [CommRing A] :=
  {P : FGAlgCatSkeleton A // Algebra.Etale A P.eval.obj}

/-- A code for an element of the ind-étale lift: a finitely presented étale `A`-algebra `E`, an
`A`-algebra map `E → V`, and an element of `E`. -/
private abbrev etaleStageCode (A V : Type u) [CommRing A] [CommRing V] [Algebra A V] :=
  Σ P : FiniteEtaleSkeleton A, (P.val.eval.obj →ₐ[A] V) × P.val.eval.obj

/-- There are at most `2 ^ max (max #A #V) ℵ₀` codes. -/
private lemma cardinal_mk_etaleStageCode_le (A V : Type u) [CommRing A] [CommRing V]
    [Algebra A V] :
    Cardinal.mk (etaleStageCode A V) ≤
      (2 : Cardinal.{u}) ^ max (max (Cardinal.mk A) (Cardinal.mk V)) Cardinal.aleph0 := by
  classical
  let κ := max (max (Cardinal.mk A) (Cardinal.mk V)) Cardinal.aleph0
  have hA : Cardinal.mk A ≤ κ := (le_max_left _ _).trans (le_max_left _ _)
  have h0 : Cardinal.aleph0 ≤ κ := le_max_right _ _
  have hκle : κ ≤ (2 : Cardinal.{u}) ^ κ := (Cardinal.cantor κ).le
  have hE (P : FGAlgCatSkeleton A) : Cardinal.mk P.eval.obj ≤ κ :=
    let : Algebra.FiniteType A P.eval.obj := P.eval.property
    (Cardinal.mk_le_of_algebra_finiteType A P.eval.obj).trans (max_le h0 hA)
  have hhom (P : FGAlgCatSkeleton A) : Cardinal.mk (P.eval.obj →ₐ[A] V) ≤ κ ^ κ := by
    calc
      Cardinal.mk (P.eval.obj →ₐ[A] V) ≤ Cardinal.mk (P.eval.obj → V) :=
        Cardinal.mk_le_of_injective (f := fun f : P.eval.obj →ₐ[A] V => f.toFun)
          (fun f g h => AlgHom.ext (fun x => congrFun h x))
      _ = Cardinal.mk V ^ Cardinal.mk P.eval.obj := by
        simpa only [Cardinal.lift_id] using Cardinal.mk_arrow (P.eval.obj) V
      _ ≤ κ ^ Cardinal.mk P.eval.obj :=
        Cardinal.power_le_power_right ((le_max_right _ _).trans (le_max_left _ _))
      _ ≤ κ ^ κ := Cardinal.power_le_power_left (Cardinal.aleph0_pos.trans_le h0).ne' (hE P)
  have hpair (P : FGAlgCatSkeleton A) :
      Cardinal.mk ((P.eval.obj →ₐ[A] V) × P.eval.obj) ≤ (2 : Cardinal.{u}) ^ κ := by
    calc
      Cardinal.mk ((P.eval.obj →ₐ[A] V) × P.eval.obj) =
          Cardinal.mk (P.eval.obj →ₐ[A] V) * Cardinal.mk P.eval.obj := by
        simpa only [Cardinal.lift_id] using Cardinal.mk_prod (P.eval.obj →ₐ[A] V) P.eval.obj
      _ ≤ (2 : Cardinal.{u}) ^ κ :=
        Cardinal.mul_le_of_le (h0.trans hκle) ((hhom P).trans (Cardinal.power_self_eq h0).le)
          ((hE P).trans hκle)
  have hskel : Cardinal.mk (FiniteEtaleSkeleton A) ≤ (2 : Cardinal.{u}) ^ κ :=
    (Cardinal.mk_le_of_injective Subtype.val_injective).trans
      ((cardinal_mk_fgAlgCatSkeleton_le A).trans
        (Cardinal.power_le_power_left (by norm_num) (max_le h0 hA)))
  calc
    Cardinal.mk (etaleStageCode A V) =
        Cardinal.sum (fun P : FiniteEtaleSkeleton A =>
          Cardinal.mk ((P.val.eval.obj →ₐ[A] V) × P.val.eval.obj)) := by
      rw [etaleStageCode, Cardinal.mk_sigma]
    _ ≤ Cardinal.sum (fun _ : FiniteEtaleSkeleton A => (2 : Cardinal.{u}) ^ κ) :=
      Cardinal.sum_le_sum _ _ (fun P => hpair P.val)
    _ = Cardinal.mk (FiniteEtaleSkeleton A) * ((2 : Cardinal.{u}) ^ κ) := by simp
    _ ≤ (2 : Cardinal.{u}) ^ κ := Cardinal.mul_le_of_le (h0.trans hκle) hskel le_rfl

/-! ### Codes surject onto the lift -/

/-- The ind-étale `A`-algebra given by a finitely presented étale stage. -/
private noncomputable abbrev FiniteEtaleSkeleton.toIndEtale {A : Type u} [CommRing A]
    (P : FiniteEtaleSkeleton A) : IndEtaleAlgebra A :=
  ⟨Under.mk (CommRingCat.ofHom (algebraMap A P.1.eval.obj)), by
    have hE : (CommAlgCat.etale A).ind.{u} (CommAlgCat.of A P.1.eval.obj) :=
      ObjectProperty.le_ind _ _ P.2
    rwa [CommAlgCat.ind_etale_iff_ind_algebraMap, MorphismProperty.ind_iff_ind_underMk] at hE⟩

/-- The morphism of `A ⧸ I`-structured rings induced by an `A`-algebra map from a stage into `V`. -/
private noncomputable def stageUnderHom {A : Type u} [CommRing A] (I : Ideal A)
    (V : IndEtaleAlgebra (A ⧸ I)) [Algebra A V.obj.right]
    (hVA : algebraMap A V.obj.right = V.obj.hom.hom.comp (Ideal.Quotient.mk I))
    (P : FiniteEtaleSkeleton A) (α : P.1.eval.obj →ₐ[A] V.obj.right) :
    (FiniteEtaleSkeleton.toIndEtale P).obj ⟶
      (Under.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).obj V.obj :=
  Under.homMk (CommRingCat.ofHom α.toRingHom) (by
    ext a
    change α (algebraMap A P.1.eval.obj a) = (V.obj.hom.hom.comp (Ideal.Quotient.mk I)) a
    rw [α.commutes, hVA])

/-- The morphism out of the base change of a stage induced by an `A`-algebra map into `V`. -/
private noncomputable def stageBaseChangeHom {A : Type u} [CommRing A] (I : Ideal A)
    (V : IndEtaleAlgebra (A ⧸ I)) [Algebra A V.obj.right]
    (hVA : algebraMap A V.obj.right = V.obj.hom.hom.comp (Ideal.Quotient.mk I))
    (P : FiniteEtaleSkeleton A) (α : P.1.eval.obj →ₐ[A] V.obj.right) :
    (indEtaleQuotientBaseChange A I).obj (FiniteEtaleSkeleton.toIndEtale P) ⟶ V :=
  ObjectProperty.homMk (((Under.mapPushoutAdj (CommRingCat.ofHom (Ideal.Quotient.mk I))).homEquiv
    _ V.obj).symm (stageUnderHom I V hVA P α))

/-- The element of the ind-étale lift of `V` named by a code. -/
private noncomputable def etaleStageCode_lift (A : Type u) [CommRing A] (I : Ideal A)
    (V : IndEtaleAlgebra (A ⧸ I)) [Algebra A V.obj.right]
    (hVA : algebraMap A V.obj.right = V.obj.hom.hom.comp (Ideal.Quotient.mk I))
    (c : etaleStageCode A V.obj.right) : ((indEtaleQuotientLift A I).obj V).obj.right :=
  have adj := Classical.choice (indEtaleBaseChange_hasFullyFaithfulRightAdjoint A I)
  (adj.homEquiv _ V (stageBaseChangeHom I V hVA c.1 c.2.1)).hom.right.hom c.2.2

/-- Every morphism from a finitely presented étale stage `P` into the ind-étale lift of `V` is
realized by codes: each element of `P` maps to the element named by a code on `P`. -/
private lemma exists_etaleStageCode_lift_eq (A : Type u) [CommRing A] (I : Ideal A)
    (V : IndEtaleAlgebra (A ⧸ I)) [Algebra A V.obj.right]
    (hVA : algebraMap A V.obj.right = V.obj.hom.hom.comp (Ideal.Quotient.mk I))
    (P : FiniteEtaleSkeleton A)
    (f : FiniteEtaleSkeleton.toIndEtale P ⟶ (indEtaleQuotientLift A I).obj V)
    (z : P.1.eval.obj) :
    ∃ α : P.1.eval.obj →ₐ[A] V.obj.right,
      etaleStageCode_lift A I V hVA ⟨P, (α, z)⟩ = f.hom.right.hom z := by
  classical
  let Eobj : IndEtaleAlgebra A := FiniteEtaleSkeleton.toIndEtale P
  let adj := Classical.choice (indEtaleBaseChange_hasFullyFaithfulRightAdjoint A I)
  let b := CommRingCat.ofHom (Ideal.Quotient.mk I)
  let k : (indEtaleQuotientBaseChange A I).obj Eobj ⟶ V := (adj.homEquiv Eobj V).symm f
  let sCode : Eobj.obj ⟶ (Under.map b).obj V.obj :=
    (Under.mapPushoutAdj b).homEquiv Eobj.obj V.obj k.hom
  let α : P.1.eval.obj →ₐ[A] V.obj.right :=
    { toRingHom := sCode.right.hom
      commutes' a := by
        rw [hVA]
        exact congrArg (fun q : CommRingCat.of A ⟶ CommRingCat.of V.obj.right => q.hom a)
          (Under.w sCode) }
  have hs : stageUnderHom I V hVA P α = sCode := by
    apply Under.UnderMorphism.ext
    ext z
    rfl
  have hk : stageBaseChangeHom I V hVA P α = k := by
    apply ObjectProperty.hom_ext
    exact (congrArg _ hs).trans (Equiv.symm_apply_apply _ _)
  refine ⟨α, ?_⟩
  change (adj.homEquiv Eobj V (stageBaseChangeHom I V hVA P α)).hom.right.hom z =
    f.hom.right.hom z
  rw [hk, Equiv.apply_symm_apply]

/-- Every element of the ind-étale lift of `V` is named by a code: the lift is the filtered
colimit of its finitely presented étale stages, and each such stage is the evaluation of a
skeletal presentation. -/
private lemma etaleStageCode_lift_surjective (A : Type u) [CommRing A] (I : Ideal A)
    (V : IndEtaleAlgebra (A ⧸ I)) :
    letI : Algebra A V.obj.right := (V.obj.hom.hom.comp (Ideal.Quotient.mk I)).toAlgebra
    Function.Surjective (etaleStageCode_lift A I V rfl) := by
  classical
  let _ : Algebra A V.obj.right := (V.obj.hom.hom.comp (Ideal.Quotient.mk I)).toAlgebra
  let C : IndEtaleAlgebra A := (indEtaleQuotientLift A I).obj V
  intro x
  obtain ⟨J, _, _, pres, hpres⟩ := C.property
  let F := pres.diag ⋙ Under.forget (CommRingCat.of A) ⋙ forget CommRingCat
  obtain ⟨j, y, hy⟩ := Limits.Types.jointly_surjective F
    (isColimitOfPreserves (Under.forget (CommRingCat.of A) ⋙ forget CommRingCat)
      pres.isColimit) x
  let U : IndEtaleAlgebra A := ⟨pres.diag.obj j, ObjectProperty.le_ind _ _ (hpres j)⟩
  let m : U ⟶ C := ObjectProperty.homMk (pres.ι.app j)
  let S := U.obj.right
  let _ : Algebra A S := U.obj.hom.hom.toAlgebra
  have : Algebra.Etale A S := RingHom.etale_algebraMap.mp (hpres j)
  obtain ⟨P, ⟨eS⟩⟩ := Algebra.FiniteType.exists_fgAlgCatSkeleton A S
  have hEtaleP : Algebra.Etale A P.eval.obj := Algebra.Etale.of_equiv eS
  let t : FiniteEtaleSkeleton.toIndEtale ⟨P, hEtaleP⟩ ⟶ U := ObjectProperty.homMk <| Under.homMk
    (CommRingCat.ofHom eS.symm.toRingHom) (by
      ext a
      exact eS.symm.commutes a)
  let yS : S := y
  obtain ⟨α, hα⟩ := exists_etaleStageCode_lift_eq A I V rfl ⟨P, hEtaleP⟩ (t ≫ m) (eS yS)
  refine ⟨⟨⟨P, hEtaleP⟩, (α, eS yS)⟩, hα.trans ?_⟩
  show m.hom.right.hom (t.hom.right.hom (eS yS)) = x
  rw [show t.hom.right.hom (eS yS) = y from eS.symm_apply_apply y]
  show (ConcreteCategory.hom (Under.Hom.right (pres.ι.app j))) y = x
  exact hy

/-- The ind-étale lift of `V` across `A ⧸ I` has cardinality at most
`2 ^ max (max #A #V) ℵ₀`. -/
private lemma cardinal_mk_indEtaleQuotientLift_le (A : Type u) [CommRing A] (I : Ideal A)
    (V : IndEtaleAlgebra (A ⧸ I)) :
    Cardinal.mk ((indEtaleQuotientLift A I).obj V).obj.right ≤
      (2 : Cardinal.{u}) ^ max (max (Cardinal.mk A) (Cardinal.mk V.obj.right))
        Cardinal.aleph0 := by
  let _ : Algebra A V.obj.right := (V.obj.hom.hom.comp (Ideal.Quotient.mk I)).toAlgebra
  exact (Cardinal.mk_le_of_surjective (etaleStageCode_lift_surjective A I V)).trans
    (cardinal_mk_etaleStageCode_le A V.obj.right)

/-- The spectrum of the ind-étale lift of `V` across `A ⧸ I` has size at most
`Cardinal.proetaleBound κ` whenever `κ` is infinite and bounds both `A` and `V`. -/
private lemma spec_size_lift_le_proetaleBound (A : Type u) [CommRing A] (I : Ideal A)
    (V : IndEtaleAlgebra (A ⧸ I))
    {κ : Cardinal.{u}} (hκ : Cardinal.aleph0 ≤ κ) (hA : Cardinal.mk A ≤ κ)
    (hV : Cardinal.mk V.obj.right ≤ κ) :
    (Spec (CommRingCat.of ((indEtaleQuotientLift A I).obj V).obj.right)).size ≤
      Cardinal.proetaleBound κ := by
  have hring : Cardinal.mk ((indEtaleQuotientLift A I).obj V).obj.right ≤
      (2 : Cardinal.{u}) ^ κ :=
    (cardinal_mk_indEtaleQuotientLift_le A I V).trans
      (Cardinal.power_le_power_left (by norm_num) (max_le (max_le hA hV) hκ))
  have hκle : κ ≤ (2 : Cardinal.{u}) ^ κ := (Cardinal.cantor κ).le
  have hκle₂ : (2 : Cardinal.{u}) ^ κ ≤ (2 : Cardinal.{u}) ^ ((2 : Cardinal.{u}) ^ κ) :=
    Cardinal.power_le_power_left (by norm_num) hκle
  have hpow : (2 : Cardinal.{u}) ^ κ ≤ Cardinal.proetaleBound κ := by
    calc
      (2 : Cardinal.{u}) ^ κ = κ ^ κ := (Cardinal.power_self_eq hκ).symm
      _ ≤ κ ^ ((2 : Cardinal.{u}) ^ ((2 : Cardinal.{u}) ^ ((2 : Cardinal.{u}) ^ κ))) :=
        Cardinal.power_le_power_left (Cardinal.aleph0_pos.trans_le hκ).ne'
          (hκle.trans (hκle₂.trans (Cardinal.power_le_power_left (by norm_num) hκle₂)))
      _ ≤ Cardinal.proetaleBound κ := le_max_left _ _
  rw [Scheme.size_Spec]
  exact max_le (hκ.trans (hκle.trans hpow)) (hring.trans hpow)

/-- The ring of global sections of an affine scheme is no larger than its size. -/
theorem section_ring_le_size_of_affine (S : Scheme.{u}) [IsAffine S] :
    Cardinal.mk Γ(S, ⊤) ≤ S.size :=
  Scheme.mk_sections_le_size S ⟨⊤, isAffineOpen_top S⟩

/-- The spectrum of the ind-étale lift of an ind-étale `Γ(X, ⊤) ⧸ I`-algebra `V` lies in a big
pro-étale site containing the affine schemes `X` and `Z`, provided `V` is no larger than `Z`.
-/
theorem liftedSpec_size_lt_cutoff (B : BigProetaleSite.{u}) {X Z : Scheme.{u}}
    [IsAffine X] [IsAffine Z] (I : Ideal Γ(X, ⊤)) (V : IndEtaleAlgebra (Γ(X, ⊤) ⧸ I))
    (hX : X.size < B.cutoff) (hZ : Z.size < B.cutoff) (hA : Cardinal.mk Γ(X, ⊤) ≤ X.size)
    (hV : Cardinal.mk V.obj.right ≤ Z.size) :
    (Spec (CommRingCat.of
      ((indEtaleQuotientLift Γ(X, ⊤) I).obj V).obj.right)).size < B.cutoff := by
  let T := Spec (CommRingCat.of (Γ(X, ⊤) × V.obj.right))
  have hμ0 : Cardinal.aleph0 ≤ max X.size Z.size :=
    (Scheme.aleph0_le_size X).trans (le_max_left _ _)
  have hprod : Cardinal.mk (Γ(X, ⊤) × V.obj.right) ≤ max X.size Z.size := by
    calc
      Cardinal.mk (Γ(X, ⊤) × V.obj.right) =
          Cardinal.mk Γ(X, ⊤) * Cardinal.mk V.obj.right := by
        simp
      _ ≤ max X.size Z.size * max X.size Z.size :=
        mul_le_mul' (hA.trans (le_max_left _ _)) (hV.trans (le_max_right _ _))
      _ = max X.size Z.size := Cardinal.mul_eq_self hμ0
  have hT : T.size ≤ max X.size Z.size := by
    rw [Scheme.size_Spec]
    exact max_le hμ0 hprod
  have hAκ : Cardinal.mk Γ(X, ⊤) ≤ T.size := by
    rw [Scheme.size_Spec]
    exact le_max_of_le_right <| Cardinal.mk_le_of_injective
      (f := fun a : Γ(X, ⊤) => (a, (0 : V.obj.right))) (fun _ _ h => congrArg Prod.fst h)
  have hVκ : Cardinal.mk V.obj.right ≤ T.size := by
    rw [Scheme.size_Spec]
    exact le_max_of_le_right <| Cardinal.mk_le_of_injective
      (f := fun v : V.obj.right => ((0 : Γ(X, ⊤)), v)) (fun _ _ h => congrArg Prod.snd h)
  exact B.closed_under_proetaleBound (lt_of_le_of_lt hT (max_lt hX hZ))
    (spec_size_lift_le_proetaleBound (A := Γ(X, ⊤)) I V (Scheme.aleph0_le_size T) hAκ hVκ)

end AlgebraicGeometry.ProEtale
