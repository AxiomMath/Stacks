/-!
# Subcanonical pro-étale sites

Every representable presheaf is a sheaf for the pro-étale topology. This holds for a chosen big
pro-étale site, for the small pro-étale site of a scheme — both the unrestricted one and the
one living inside a chosen big site — for the big slice over a scheme, and for the affine
variants of the small and the big slice.

## Main results

* `AlgebraicGeometry.ProEtale.bigProetale_subcanonical` — the topology of a chosen big
  pro-étale site is subcanonical.
* `AlgebraicGeometry.Scheme.ProEt.instSubcanonicalTopology` — the unrestricted small pro-étale
  topology is subcanonical.
* `AlgebraicGeometry.ProEtale.smallProetale_subcanonical` — the small site inside a chosen big
  site is subcanonical.
* `CategoryTheory.GrothendieckTopology.subcanonical_over` — subcanonicality passes to a slice
  site, in particular to the big pro-étale site over a scheme.
* `AlgebraicGeometry.ProEtale.smallAffineProetale_subcanonical` and
  `AlgebraicGeometry.ProEtale.bigAffineProetale_subcanonical` — the affine variants.

## Implementation notes

For a chosen big pro-étale site the statement is transported from Mathlib's unrestricted
pro-étale topology on schemes along the fully faithful inclusion. For the subcategories of a
big slice the transport goes through the precoverage generated by the slice topology, which
must be interposed because the comparison lemma for a fully faithful functor takes a
precoverage on the source; the two applications of
`CategoryTheory.GrothendieckTopology.toGrothendieck_toPrecoverage_le` arrange that the
intermediate topologies sit between the slice topology and itself and so are subcanonical too.
For the affine small site the dense-subsite property does the work directly.

## References

* [Stacks Project, Tag 098Z](https://stacks.math.columbia.edu/tag/098Z)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.ProEtale

add_to_stacks 098Z "small pro-étale site"
  AlgebraicGeometry.Scheme.ProEt.instSubcanonicalTopology
add_to_stacks 098Z "big pro-étale site over a scheme"
  CategoryTheory.GrothendieckTopology.subcanonical_over
add_to_sga "3 IV 4.5.3" CategoryTheory.GrothendieckTopology.subcanonical_over

/-- The topology of a chosen big pro-étale site is subcanonical. -/
@[stacks 098Z "big pro-étale site"]
public instance bigProetale_subcanonical (B : BigProetaleSite.{u}) :
    B.topology.Subcanonical := by
  let Q := Scheme.proetalePrecoverage.comap B.inclusion
  let : Q.PullbacksPreservedBy B.inclusion := by
    dsimp [Q]; infer_instance
  let : B.inclusion.IsContinuous B.topology Scheme.proetaleTopology := by
    have htop : B.topology = Q.toGrothendieck := by
      change B.precoverage.toGrothendieck = _
      rw [B.precoverage_eq_comap]
    rw [htop]
    exact Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy
      (F := B.inclusion) (J := Q) (K := Scheme.proetalePrecoverage)
      (by intro X R hR; exact hR)
  exact GrothendieckTopology.subcanonical_of_full_of_faithful B.inclusion
    B.topology Scheme.proetaleTopology

/-- A covering family of a subcategory of the slice generates a covering sieve of the slice:
the family's image under the forgetful functor to schemes is a covering of the chosen big site,
and covering sieves of the slice are exactly those whose image is one. -/
private theorem sieve_generate_map_mem_topology {B : BigProetaleSite.{u}} {S : Scheme.{u}}
    {hS : B.Contains S} {A : Type*} [Category A] (F : A ⥤ BigProetaleOver B S hS) {U : A}
    (E : PreZeroHypercover.{u + 1} U)
    (hC : B.covering ⟨(F.obj U).left, (E.map F).map (BigProetaleOver.forget B S hS)⟩) :
    Sieve.generate (E.presieve₀.map F) ∈ BigProetaleOver.topology B S hS (F.obj U) := by
  rw [GrothendieckTopology.mem_over_iff, Sieve.overEquiv_generate]
  show Sieve.generate
      (Presieve.functorPushforward (BigProetaleOver.forget B S hS)
        (E.presieve₀.map F)) ∈ B.topology (F.obj U).left
  rw [← Sieve.arrows_generate_map_eq_functorPushforward]
  simp only [Sieve.generate_sieve]
  have hmem : Sieve.generate
      ((E.map (F ⋙ BigProetaleOver.forget B S hS)).presieve₀) ∈
        B.topology (F.obj U).left := by
    apply Precoverage.le_toPrecoverage_toGrothendieck B.precoverage
    exact ⟨E.map (F ⋙ BigProetaleOver.forget B S hS), rfl, hC⟩
  simpa [PreZeroHypercover.presieve₀, PreZeroHypercover.map,
    Presieve.map_ofArrows, Functor.comp_map] using hmem

/-- A fully faithful inclusion into the slice over a scheme, preserving cospan limits and
carrying its coverings to covering sieves of the slice, has subcanonical generated topology:
the slice is subcanonical, the two generation steps preserve that, and the comparison with the
comapped topology is an inequality in the one direction that `Subcanonical.of_le` needs. -/
private theorem subcanonical_of_fullyFaithful_over {B : BigProetaleSite.{u}} {S : Scheme.{u}}
    {hS : B.Contains S} {A : Type*} [Category A] [HasPullbacks A]
    (F : A ⥤ BigProetaleOver B S hS) [F.Full] [F.Faithful]
    [PreservesLimitsOfShape WalkingCospan (F ⋙ BigProetaleOver.toScheme B S hS)]
    (P : Precoverage A)
    (hP : ∀ (U : A) (R : Presieve U), R ∈ P U →
      Sieve.generate (R.map F) ∈ BigProetaleOver.topology B S hS (F.obj U)) :
    P.toGrothendieck.Subcanonical := by
  let J := BigProetaleOver.topology B S hS
  let K := J.toPrecoverage.toGrothendieck
  let L := K.toPrecoverage.toGrothendieck
  let Q := L.toPrecoverage.comap F
  have hKJ : K ≤ J := GrothendieckTopology.toGrothendieck_toPrecoverage_le J
  have htop : P.toGrothendieck ≤ Q.toGrothendieck := by
    apply Precoverage.toGrothendieck_mono
    intro U R hR
    rw [Precoverage.mem_comap_iff, GrothendieckTopology.mem_toPrecoverage_iff]
    exact Stacks.Sites.le_toGrothendieck_toPrecoverage K _
      (Stacks.Sites.le_toGrothendieck_toPrecoverage J _ (hP U R hR))
  let : HasPullbacks (BigProetaleOver B S hS) := Over.instHasPullbacks
  let G := BigProetaleOver.toScheme B S hS
  let : PreservesLimitsOfShape WalkingCospan F :=
    preservesLimitsOfShape_of_reflects_of_preserves F G
  let : K.Subcanonical := GrothendieckTopology.Subcanonical.of_le hKJ
  let : L.Subcanonical := GrothendieckTopology.Subcanonical.of_le
    ((GrothendieckTopology.toGrothendieck_toPrecoverage_le K).trans hKJ)
  have hLL : L.toPrecoverage.toGrothendieck = L := le_antisymm
    (GrothendieckTopology.toGrothendieck_toPrecoverage_le L)
    (Stacks.Sites.le_toGrothendieck_toPrecoverage L)
  let : F.IsContinuous Q.toGrothendieck L := by
    simpa [hLL] using
      (Functor.isContinuous_toGrothendieck_of_pullbacksPreservedBy
        (F := F) (J := Q) (K := L.toPrecoverage) fun _ _ hR ↦ hR)
  let : Q.toGrothendieck.Subcanonical :=
    GrothendieckTopology.subcanonical_of_full_of_faithful F Q.toGrothendieck L
  exact GrothendieckTopology.Subcanonical.of_le htop

/-- The small pro-étale site inside a chosen big site is subcanonical. -/
@[stacks 098Z "small pro-étale site in a chosen big site"]
public instance smallProetale_subcanonical (B : BigProetaleSite.{u})
    (S : Scheme.{u}) (hS : B.Contains S) :
    (SmallProetale.topology B S hS).Subcanonical := by
  let : HasPullbacks (SmallProetale B S hS) := smallProetale_hasPullbacks B S hS
  let : PreservesLimitsOfShape WalkingCospan
      (SmallProetale.inclusion B S hS ⋙ BigProetaleOver.toScheme B S hS) := by
    change PreservesLimitsOfShape WalkingCospan (SmallProetale.toScheme B S hS)
    infer_instance
  refine subcanonical_of_fullyFaithful_over (SmallProetale.inclusion B S hS) _ ?_
  intro U R hR
  obtain ⟨E, rfl, hE⟩ :=
    (SmallProetale.mem_precoverage_iff (B := B) (S := S) (hS := hS)).mp hR
  exact sieve_generate_map_mem_topology _ E hE

/-- The affine small pro-étale site is subcanonical. -/
@[stacks 098Z "affine small pro-étale site"]
public instance smallAffineProetale_subcanonical (S : Scheme.{u}) :
    (AffineProetale.topology S).Subcanonical := by
  let F := AffineProetale.inclusion S
  let J := AffineProetale.topology S
  let K := Scheme.ProEt.topology S
  let : F.IsDenseSubsite J K := affineInclusion_isDenseSubsite S
  exact GrothendieckTopology.subcanonical_of_full_of_faithful F J K

/-- The affine objects of a chosen big pro-étale site over a scheme form a
subcanonical site. -/
@[stacks 098Z "affine big pro-étale site over a scheme"]
public instance bigAffineProetale_subcanonical (B : BigProetaleSite.{u})
    (S : Scheme.{u}) (hS : B.Contains S) :
    (BigAffineProetale.topology B S hS).Subcanonical := by
  let : HasPullbacks (BigAffineProetale B S hS) := bigAffineProetale_hasPullbacks B S hS
  let : PreservesLimitsOfShape WalkingCospan
      (BigAffineProetale.inclusion B S hS ⋙ BigProetaleOver.toScheme B S hS) := by
    change PreservesLimitsOfShape WalkingCospan (BigAffineProetale.toScheme B S hS)
    infer_instance
  refine subcanonical_of_fullyFaithful_over (BigAffineProetale.inclusion B S hS) _ ?_
  intro U R hR
  obtain ⟨E, rfl, hE⟩ :=
    (BigAffineProetale.mem_precoverage_iff (B := B) (S := S) (hS := hS)).mp hR
  exact sieve_generate_map_mem_topology _ E hE.1

end AlgebraicGeometry.ProEtale

end
