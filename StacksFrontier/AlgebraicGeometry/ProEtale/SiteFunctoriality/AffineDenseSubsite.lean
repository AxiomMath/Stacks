module

public import Mathlib.AlgebraicGeometry.Cover.MorphismProperty
public import Mathlib.AlgebraicGeometry.Cover.QuasiCompact
public import Mathlib.AlgebraicGeometry.Sites.Proetale
public import Mathlib.CategoryTheory.Sites.DenseSubsite.Basic
public import Mathlib.CategoryTheory.Sites.DenseSubsite.InducedTopology
public import StacksFrontier.CategoryTheory.Sites.Pretopology.SmallSubsite
public import StacksFrontier.CategoryTheory.Sites.Topos.ToposMorphismDefs
public import StacksCore.Tactic.StacksAttribute

/-!
# Affine objects of the small pro-étale site

The affine objects of the small pro-étale site of a scheme `S` form a full subcategory, which
carries the topology generated by the standard finite pro-étale covering families. Every
pro-étale `S`-scheme is covered by affine ones, and a pro-étale covering of an affine
pro-étale `S`-scheme can be refined to a finite one by affines, so the inclusion exhibits the
affine objects as a dense subsite. Restriction of sheaves of sets along the inclusion is
therefore an equivalence of topoi.

## Main definitions

* `AlgebraicGeometry.ProEtale.IsAffineSmall` — affineness of a small pro-étale object.
* `AlgebraicGeometry.ProEtale.AffineProetale` — the full subcategory of affine objects.
* `AlgebraicGeometry.ProEtale.AffineProetale.precoverage` and
  `AlgebraicGeometry.ProEtale.AffineProetale.topology` — the standard finite pro-étale
  covering families of affine objects, and the topology they generate.

## Main results

* `AlgebraicGeometry.ProEtale.affineInclusion_isDenseSubsite` — the affine objects are a dense
  subsite of the small pro-étale site; `CategoryTheory.Functor.IsDenseSubsite.sheafEquiv`
  turns this into the equivalence of topoi, with restriction of sheaves as its inverse.

## Implementation notes

The ambient site is `AlgebraicGeometry.Scheme.ProEt`, the small pro-étale site of `S` with no
size restriction, so no choice of big site and no containment witness enters the statement.
The affine objects here are those whose structure morphism to `S` is weakly étale; they are not
the affine objects of a big pro-étale category over `S`.

Cover density is witnessed by the affine open cover of the underlying scheme, which is Zariski
and hence pro-étale. Cocontinuity is proved by induction over the saturation of the pro-étale
precoverage: a pro-étale covering of an affine object is first pulled back, then refined to a
finite family of affines by `AlgebraicGeometry.QuasiCompactCover.exists_hom`.

## References

* [Stacks Project, Tag 098W](https://stacks.math.columbia.edu/tag/098W)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.ProEtale

variable (S : Scheme.{u})

/-- Affineness of a small pro-étale object. -/
public abbrev IsAffineSmall : ObjectProperty S.ProEt :=
  fun X ↦ IsAffine X.left

/-- The affine objects in the small pro-étale site of `S`. -/
public abbrev AffineProetale := (IsAffineSmall S).FullSubcategory

namespace AffineProetale

/-- The full inclusion into the small pro-étale site. -/
public abbrev inclusion : AffineProetale S ⥤ S.ProEt :=
  (IsAffineSmall S).ι

/-- Standard finite pro-étale covering families of affine small objects. -/
public abbrev IsCovering (E : Covering (AffineProetale S)) : Prop :=
  (E.2.map (inclusion S)).presieve₀ ∈ Scheme.ProEt.precoverage S E.1.obj ∧
    Finite E.2.I₀

/-- Precoverage by standard finite pro-étale covering families. -/
public def precoverage : Precoverage (AffineProetale S) where
  coverings X := {R | ∃ E : PreZeroHypercover.{u + 1} X,
    R = E.presieve₀ ∧ IsCovering S ⟨X, E⟩}

/-- The standard pro-étale topology on affine small objects. -/
public abbrev topology : GrothendieckTopology (AffineProetale S) :=
  (precoverage S).toGrothendieck

end AffineProetale

/-- A zero-hypercover of a small pro-étale object is a covering iff its underlying family of
schemes is a pro-étale covering. -/
private theorem presieve₀_mem_precoverage_iff.{w} {X : S.ProEt} (E : PreZeroHypercover.{w} X) :
    E.presieve₀ ∈ Scheme.ProEt.precoverage S X ↔
      (E.map (Scheme.ProEt.forget S ⋙ Over.forget S)).presieve₀ ∈
        Scheme.proetalePrecoverage X.left := by
  rw [Scheme.ProEt.precoverage, Precoverage.mem_comap_iff, ← PreZeroHypercover.presieve₀_map]
  rfl

/-- The affine small objects are cover-dense in the small pro-étale site. -/
private theorem affineInclusion_isCoverDense :
    (AffineProetale.inclusion S).IsCoverDense (Scheme.ProEt.topology S) := by
  refine ⟨fun X => ?_⟩
  let E : PreZeroHypercover X := {
    I₀ := X.left.affineCover.I₀
    X i := Scheme.ProEt.mk (X.left.affineCover.f i ≫ X.hom)
    f i := MorphismProperty.Over.homMk (X.left.affineCover.f i) (by
      rw [Scheme.ProEt.mk_hom]
      rfl)
  }
  have hmap : E.map (Scheme.ProEt.forget S ⋙ Over.forget S) =
      X.left.affineCover.toPreZeroHypercover := by
    apply PreZeroHypercover.ext rfl
    all_goals simp [E, Scheme.ProEt.forget, MorphismProperty.Over.forget,
      MorphismProperty.Comma.forget, Over.forget, Scheme.ProEt.mk]
  have hle : Scheme.zariskiPrecoverage ≤ Scheme.proetalePrecoverage := by
    rw [Scheme.proetalePrecoverage]
    show Scheme.zariskiPrecoverage ≤
      (Scheme.qcPrecoverage ⊓ Scheme.precoverage @WeaklyEtale)
    refine le_inf Scheme.zariskiPrecoverage_le_qcPrecoverage ?_
    exact Scheme.precoverage_mono fun Y Z f hf => by infer_instance
  have hE : E.presieve₀ ∈ Scheme.ProEt.precoverage S X := by
    rw [presieve₀_mem_precoverage_iff, hmap]
    exact hle X.left X.left.affineCover.mem₀
  refine (Scheme.ProEt.topology S).superset_covering ?_
    (Precoverage.generate_mem_toGrothendieck hE)
  apply (Sieve.generate_le_iff _ _).2
  show Presieve.ofArrows E.X E.f ≤
    (Sieve.coverByImage (AffineProetale.inclusion S) X).arrows
  rw [Presieve.ofArrows_le_iff]
  intro i
  exact Presieve.in_coverByImage (G := AffineProetale.inclusion S)
    (Y := ⟨E.X i, by
      show IsAffine (X.left.affineCover.X i)
      infer_instance⟩) (E.f i)

/-- A finite affine cover of an affine scheme is quasi-compact. -/
private theorem quasiCompactCover_affineCover {P : MorphismProperty Scheme.{u}}
    {T : Scheme.{u}} [IsAffine T] (V : Scheme.AffineCover P T) [Finite V.I₀] :
    QuasiCompactCover V.cover.toPreZeroHypercover := by
  have hmapqc (i : V.I₀) : AlgebraicGeometry.QuasiCompact (V.cover.f i) := by
    have : IsAffine (V.cover.X i) := by
      show IsAffine (Spec (V.X i))
      infer_instance
    have : IsAffineHom (V.cover.f i) := isAffineHom_of_isAffine (V.cover.f i)
    infer_instance
  have : ∀ i, AlgebraicGeometry.QuasiCompact (V.cover.f i) := hmapqc
  have : Finite V.cover.I₀ := ‹Finite V.I₀›
  exact ⟨fun {U} hU => IsCompactOpenCovered.of_finite_of_isSpectralMap
    (fun i => (V.cover.f i).isSpectralMap) (fun x _ => ⟨V.idx x, V.covers x⟩)
    U.2 hU.isCompact⟩

/-- A pro-étale covering of an affine small object is refined by a standard finite pro-étale
covering by affine small objects. -/
private theorem AffineProetale.exists_isCovering_refines (X : AffineProetale S)
    (Q : PreZeroHypercover.{u + 1} ((AffineProetale.inclusion S).obj X).left)
    (hQ : Q.presieve₀ ∈ Scheme.proetalePrecoverage ((AffineProetale.inclusion S).obj X).left) :
    ∃ F : PreZeroHypercover.{u + 1} X, AffineProetale.IsCovering S ⟨X, F⟩ ∧ ∀ i, ∃ j,
      ∃ h : ((AffineProetale.inclusion S).obj (F.X i)).left ⟶ Q.X j,
        h ≫ Q.f j = ((AffineProetale.inclusion S).map (F.f i)).left := by
  let G := AffineProetale.inclusion S
  let q := Scheme.ProEt.forget S ⋙ Over.forget S
  have : IsAffine (G.obj X).left := X.property
  have hprop : Q.presieve₀ ∈ Scheme.propQCPrecoverage @WeaklyEtale (G.obj X).left := hQ
  let U : Scheme.Cover (Scheme.precoverage @WeaklyEtale) (G.obj X).left :=
    { __ := Q
      mem₀ := Scheme.propQCPrecoverage_le_precoverage _ hprop }
  have hqc : QuasiCompactCover Q := Scheme.presieve₀_mem_qcPrecoverage_iff.mp hprop.1
  have : QuasiCompactCover U.toPreZeroHypercover := hqc
  have : MorphismProperty.RespectsLeft @WeaklyEtale @IsOpenImmersion := ⟨by
    intro A B C i hi f hf
    have : Etale i := inferInstance
    have : WeaklyEtale i := inferInstance
    exact inferInstance⟩
  obtain ⟨V, f, hfin, -⟩ := QuasiCompactCover.exists_hom U
  let Y (i : V.I₀) : AffineProetale S :=
    ⟨(by
      let : WeaklyEtale (V.cover.f i) := V.cover.map_prop i
      exact Scheme.ProEt.mk (V.cover.f i ≫ (G.obj X).hom)), by
      show IsAffine (Spec (V.X i))
      infer_instance⟩
  let F : PreZeroHypercover X := {
    I₀ := V.I₀
    X := Y
    f i := ObjectProperty.homMk (MorphismProperty.Over.homMk (V.cover.f i) rfl)
  }
  have hMap : (F.map G).map q = V.cover.toPreZeroHypercover := by
    apply PreZeroHypercover.ext rfl
    all_goals simp [F, Y, G, q, Scheme.ProEt.forget,
      MorphismProperty.Over.forget, MorphismProperty.Comma.forget,
      Over.forget, Scheme.ProEt.mk]
  have := quasiCompactCover_affineCover V
  have hV : V.cover.toPreZeroHypercover.presieve₀ ∈
      Scheme.propQCPrecoverage @WeaklyEtale (G.obj X).left :=
    ⟨Scheme.presieve₀_mem_qcPrecoverage_iff.mpr this, V.cover.mem₀⟩
  refine ⟨F, ⟨?_, hfin⟩, fun i => ⟨f.s₀ i, f.h₀ i, f.w₀ i⟩⟩
  exact (presieve₀_mem_precoverage_iff S (F.map G)).2 (by rw [hMap]; exact hV)

/-- The pullback to an affine small object of the sieve generated by a pro-étale covering
restricts to a covering sieve of the affine site. -/
private theorem affineInclusion_functorPullback_generate_mem {Y : S.ProEt} {R : Presieve Y}
    (hR : R ∈ Scheme.ProEt.precoverage S Y) (X : AffineProetale S)
    (a : (AffineProetale.inclusion S).obj X ⟶ Y) :
    ((Sieve.generate R).pullback a).functorPullback (AffineProetale.inclusion S) ∈
      AffineProetale.topology S X := by
  let G := AffineProetale.inclusion S
  let q := Scheme.ProEt.forget S ⋙ Over.forget S
  obtain ⟨E, hEq⟩ := (Scheme.ProEt.precoverage S).mem_iff_exists_zeroHypercover.mp hR
  have hE : E.presieve₀ ∈ Scheme.ProEt.precoverage S Y := by simpa [hEq] using hR
  let E0 := E.toPreZeroHypercover.map q
  have hE0 : E0.presieve₀ ∈ Scheme.proetalePrecoverage Y.left :=
    (presieve₀_mem_precoverage_iff S E.toPreZeroHypercover).1 hE
  have hQ : (E0.pullback₂ (q.map a)).presieve₀ ∈
      Scheme.proetalePrecoverage (G.obj X).left := by
    rw [PreZeroHypercover.presieve₀_pullback₁]
    exact Precoverage.pullbackArrows_mem (q.map a) hE0
  obtain ⟨F, hF, hFQ⟩ := AffineProetale.exists_isCovering_refines S X _ hQ
  have ha : q.map a ≫ Y.hom = (G.obj X).hom := by
    show a.left ≫ Y.hom = (G.obj X).hom
    simpa [G] using a.w
  have hfactor : F.presieve₀ ≤ ((Sieve.generate R).pullback a).functorPullback G := by
    rw [Presieve.ofArrows_le_iff]
    intro i
    obtain ⟨j, hj⟩ := hFQ i
    obtain ⟨h, hh'⟩ : ∃ h : (G.obj (F.X i)).left ⟶ pullback (E0.f j) (q.map a),
        h ≫ pullback.snd (E0.f j) (q.map a) = (G.map (F.f i)).left := hj
    have hEhom : E0.f j ≫ Y.hom = (E.X j).hom := (E.f j).w
    let k : G.obj (F.X i) ⟶ E.X j :=
      MorphismProperty.Over.homMk (h ≫ pullback.fst (E0.f j) (q.map a)) (by
        show (h ≫ pullback.fst (E0.f j) (q.map a)) ≫ (E.X j).hom = (G.obj (F.X i)).hom
        calc (h ≫ pullback.fst (E0.f j) (q.map a)) ≫ (E.X j).hom
            = h ≫ (pullback.fst (E0.f j) (q.map a) ≫ E0.f j ≫ Y.hom) := by
              simpa only [hEhom] using
                Category.assoc h (pullback.fst (E0.f j) (q.map a)) (E.X j).hom
          _ = h ≫ (pullback.snd (E0.f j) (q.map a) ≫ q.map a ≫ Y.hom) :=
              congrArg (fun g => h ≫ g ≫ Y.hom) pullback.condition
          _ = h ≫ (pullback.snd (E0.f j) (q.map a) ≫ (G.obj X).hom) := by rw [ha]
          _ = (h ≫ pullback.snd (E0.f j) (q.map a)) ≫ (G.obj X).hom :=
              (Category.assoc _ _ _).symm
          _ = (G.map (F.f i)).left ≫ (G.obj X).hom := congrArg (· ≫ (G.obj X).hom) hh'
          _ = (G.obj (F.X i)).hom := by simpa [G] using (G.map (F.f i)).w)
    have hcomp : k ≫ E.f j = G.map (F.f i) ≫ a := by
      apply q.map_injective
      simp only [Functor.map_comp]
      show (h ≫ pullback.fst (E0.f j) (q.map a)) ≫ E0.f j = (G.map (F.f i)).left ≫ q.map a
      rw [Category.assoc, pullback.condition, ← Category.assoc, hh']
      rfl
    show Sieve.generate R (G.map (F.f i) ≫ a)
    rw [← hcomp]
    simpa [hEq] using
      (Sieve.generate E.presieve₀).downward_closed (Sieve.le_generate E.presieve₀ _ _ ⟨j⟩) k
  exact (AffineProetale.topology S).superset_covering ((Sieve.generate_le_iff _ _).2 hfactor)
    (Precoverage.generate_mem_toGrothendieck ⟨F, rfl, hF⟩)

/-- The inclusion of affine small objects is cocontinuous. -/
private theorem affineInclusion_isCocontinuous :
    (AffineProetale.inclusion S).IsCocontinuous (AffineProetale.topology S)
      (Scheme.ProEt.topology S) := by
  let G := AffineProetale.inclusion S
  let J := AffineProetale.topology S
  have hlift : ∀ {Y : S.ProEt} (T : Sieve Y),
      (Scheme.ProEt.precoverage S).Saturate Y T →
      ∀ (X : AffineProetale S) (a : G.obj X ⟶ Y),
        (T.pullback a).functorPullback G ∈ J X := by
    intro Y T hsat
    refine Precoverage.Saturate.rec
      (motive := fun Y T _ => ∀ (X : AffineProetale S) (a : G.obj X ⟶ Y),
        (T.pullback a).functorPullback G ∈ J X)
      ?_ ?_ ?_ ?_ hsat
    · exact fun _ _ hR X a => affineInclusion_functorPullback_generate_mem S hR X a
    · simp
    · intro Y T hT Z f ih X a
      simpa [Sieve.pullback_comp, Category.assoc] using ih X (a ≫ f)
    · intro Y Base Result hBase hlocal ih ihlocal X a
      refine J.transitive (ih X a) ((Result.pullback a).functorPullback G) ?_
      intro Z k hk
      have hsat := ihlocal (show Base (G.map k ≫ a) from hk) Z (𝟙 _)
      rw [← Sieve.functorPullback_pullback]
      simpa [Sieve.pullback_comp, Category.assoc] using hsat
  constructor
  intro U T hT
  change (Scheme.ProEt.precoverage S).Saturate (G.obj U) T at hT
  simpa only [Sieve.pullback_id, Sieve.functorPullback_id, G, J] using hlift T hT U (𝟙 _)

/-- The affine objects of the small pro-étale site, with the topology of standard finite pro-étale
coverings, form a dense subsite of it; restriction of sheaves along the inclusion is therefore an
equivalence of topoi. -/
@[stacks 098W]
public theorem affineInclusion_isDenseSubsite :
    (AffineProetale.inclusion S).IsDenseSubsite
      (AffineProetale.topology S) (Scheme.ProEt.topology S) := by
  let G := AffineProetale.inclusion S
  let J := AffineProetale.topology S
  let K := Scheme.ProEt.topology S
  have : G.IsCoverDense K := affineInclusion_isCoverDense S
  have : G.IsCocontinuous J K := affineInclusion_isCocontinuous S
  have hpre : AffineProetale.precoverage S ≤ (K.toPrecoverage).comap G := by
    intro X R hR
    obtain ⟨E, hEq, hE⟩ := hR
    rw [Precoverage.mem_comap_iff, hEq, ← PreZeroHypercover.presieve₀_map,
      GrothendieckTopology.mem_toPrecoverage_iff]
    exact Precoverage.generate_mem_toGrothendieck hE.1
  have hcoverPres : CoverPreserving J K G := by
    constructor
    intro U T hT
    rw [← Functor.mem_restrictedTopology_iff]
    exact (Precoverage.toGrothendieck_mono hpre) U hT
  exact Functor.isDenseSubsite_of_isCocontinuous G J K hcoverPres
    (by
      intro U' U f g hfg
      obtain rfl := G.map_injective hfg
      simp)
    (by
      intro U' U f
      rw [← G.map_preimage f, Functor.imageSieve_map]
      exact J.top_mem U')

end AlgebraicGeometry.ProEtale

end
