module

public import Mathlib.RingTheory.LocalIso
public import Mathlib.RingTheory.Unramified.Basic
public import Mathlib.RingTheory.Unramified.LocalStructure
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.ProEtale.IndZariski

/-!
# Local isomorphisms over a common base

A local isomorphism is a ring map that is, locally on the source, a localization away from one
element of the base. This file records that a map between two local isomorphisms over a common
base is again a local isomorphism.

## Main results

* `Algebra.IsLocalIso.quasiFinite`: a local isomorphism is quasi-finite.
* `Algebra.IsLocalIso.of_restrictScalars_of_formallyUnramified`: if `A → B` is formally unramified
  and essentially of finite type and `A → C` is a local isomorphism, then `B → C` is a local
  isomorphism.

## Implementation notes

That a local isomorphism is étale is `Algebra.IsLocalIso.etale`, an instance proved from the
defining cover; it is a statement about ring maps between rings in one universe, so the two
results about a tower are stated for rings in a common universe, unlike the results of
`Mathlib/RingTheory/LocalIso.lean`, whose proofs are purely formal.

Quasi-finiteness of a ring map means, in the source, two conditions at once: the map is of finite
type, and it is quasi-finite at every prime of the target. Mathlib's `Algebra.QuasiFinite` carries
only the second one, in the equivalent form — equivalent for a map of finite type, by Lemma 00PM —
that every fibre ring `κ(p) ⊗[A] B` is a finite `κ(p)`-module; its docstring says so. So
`Algebra.IsLocalIso.quasiFinite` states the conjunction, and adds the pointwise form
`Algebra.QuasiFiniteAt A q`, which for a map of finite type is the source's condition at `q`.

For a tower `A → B → C` the map `B → C` is factored as `B → B ⊗[A] C → C`, with the first map the
base change of `A → C` and the second the multiplication `b ⊗ c ↦ b · c`. The kernel of the
multiplication map is the image of the diagonal ideal of `B` over `A`, which is generated by an
idempotent when `A → B` is formally unramified and essentially of finite type; so the second map
is a localization away from the complementary idempotent, hence a standard open immersion.

## References

* [Stacks Project, Tag 096H](https://stacks.math.columbia.edu/tag/096H)
* [Stacks Project, Tag 096I](https://stacks.math.columbia.edu/tag/096I)
-/

@[expose] public section

add_to_stacks 096I "(1)" Algebra.IsLocalIso.etale

open TensorProduct

universe u

namespace Algebra.IsLocalIso

variable (A B C : Type u) [CommRing A] [CommRing B] [CommRing C] [Algebra A B] [Algebra A C]

variable [Algebra B C] [IsScalarTower A B C]

/-- **A local isomorphism is quasi-finite**: it is of finite type, every fibre ring
`κ(p) ⊗[A] B` is a finite `κ(p)`-module, and it is quasi-finite at every prime of `B`. All three
come from `Algebra.IsLocalIso.etale`, an étale algebra being of finite presentation and formally
unramified. -/
@[stacks 096I "(3)"]
public theorem quasiFinite [Algebra.IsLocalIso A B] :
    Algebra.FiniteType A B ∧ Algebra.QuasiFinite A B ∧
      ∀ (q : Ideal B) [q.IsPrime], Algebra.QuasiFiniteAt A q :=
  ⟨inferInstance, inferInstance, fun _ _ ↦ inferInstance⟩

/-- The multiplication map `B ⊗[A] C → C`, `b ⊗ c ↦ b · c`, of a tower `A → B → C`. -/
private noncomputable def mulAlgHom : B ⊗[A] C →ₐ[A] C :=
  Algebra.TensorProduct.lift (IsScalarTower.toAlgHom A B C) (AlgHom.id A C)
    fun _ _ ↦ Commute.all _ _

/-- The map `B ⊗[A] B → B ⊗[A] C` induced by `B → C` on the right factor. -/
private noncomputable def diagMap : B ⊗[A] B →ₐ[A] B ⊗[A] C :=
  Algebra.TensorProduct.map (AlgHom.id A B) (IsScalarTower.toAlgHom A B C)

private theorem mulAlgHom_surjective : Function.Surjective (mulAlgHom A B C) :=
  fun c ↦ ⟨1 ⊗ₜ c, by simp [mulAlgHom]⟩

private theorem mulAlgHom_diagMap (x : B ⊗[A] B) :
    mulAlgHom A B C (diagMap A B C x) = algebraMap B C (Algebra.TensorProduct.lmul' A x) := by
  induction x with
  | zero => simp
  | tmul b b' => simp [mulAlgHom, diagMap]
  | add x y hx hy => simp [map_add, hx, hy]

private theorem sub_one_tmul_mem (x : B ⊗[A] C) :
    x - (1 : B) ⊗ₜ[A] (mulAlgHom A B C x) ∈
      Ideal.map (diagMap A B C) (KaehlerDifferential.ideal A B) := by
  induction x with
  | zero => simp
  | tmul b c =>
      have h : (b ⊗ₜ[A] c : B ⊗[A] C) - (1 : B) ⊗ₜ[A] (mulAlgHom A B C (b ⊗ₜ c))
          = diagMap A B C (b ⊗ₜ 1 - 1 ⊗ₜ b) * ((1 : B) ⊗ₜ[A] c) := by
        simp [diagMap, mulAlgHom, Algebra.TensorProduct.tmul_mul_tmul, sub_mul]
      rw [h]
      refine Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ ?_)
      simp [KaehlerDifferential.ideal, RingHom.mem_ker]
  | add x y hx hy =>
      rw [map_add, TensorProduct.tmul_add, add_sub_add_comm]
      exact add_mem hx hy

private theorem ker_mulAlgHom : RingHom.ker (mulAlgHom A B C) =
    Ideal.map (diagMap A B C) (KaehlerDifferential.ideal A B) := by
  refine le_antisymm (fun x hx ↦ ?_) ?_
  · have h := sub_one_tmul_mem A B C x
    rwa [RingHom.mem_ker.mp hx, TensorProduct.tmul_zero, sub_zero] at h
  · rw [Ideal.map_le_iff_le_comap]
    intro x hx
    simp only [Ideal.mem_comap, RingHom.mem_ker, mulAlgHom_diagMap]
    rw [show Algebra.TensorProduct.lmul' A x = 0 from hx, map_zero]

/-- If `A → B` is formally unramified and essentially of finite type and `A → C` is a local
isomorphism, then `B → C` is a local isomorphism. -/
public theorem of_restrictScalars_of_formallyUnramified [Algebra.FormallyUnramified A B]
    [Algebra.EssFiniteType A B] [Algebra.IsLocalIso A C] : Algebra.IsLocalIso B C := by
  obtain ⟨e, he, hsp⟩ : ∃ e, IsIdempotentElem e ∧
      KaehlerDifferential.ideal A B = Ideal.span {e} :=
    (Ideal.isIdempotentElem_iff_of_fg _ (KaehlerDifferential.ideal_fg A B)).mp <|
      (Ideal.cotangent_subsingleton_iff _).mp <| inferInstanceAs <| Subsingleton Ω[B⁄A]
  let _ : Algebra (B ⊗[A] C) C := (mulAlgHom A B C).toRingHom.toAlgebra
  have : IsScalarTower B (B ⊗[A] C) C := by
    apply IsScalarTower.of_algebraMap_eq'
    ext b
    simp [RingHom.algebraMap_toAlgebra, mulAlgHom, Algebra.TensorProduct.algebraMap_apply]
  have hker : RingHom.ker (algebraMap (B ⊗[A] C) C) =
      Ideal.span {1 - (1 - diagMap A B C e)} := by
    rw [sub_sub_cancel, RingHom.algebraMap_toAlgebra,
      show RingHom.ker (mulAlgHom A B C).toRingHom = RingHom.ker (mulAlgHom A B C) from rfl,
      ker_mulAlgHom, hsp, Ideal.map_span]
    simp
  have : IsLocalization.Away (1 - diagMap A B C e) C :=
    IsLocalization.away_of_isIdempotentElem (he.map (diagMap A B C)).one_sub hker
      (mulAlgHom_surjective A B C)
  have : Algebra.IsStandardOpenImmersion (B ⊗[A] C) C := ⟨_, ‹_›⟩
  exact Algebra.IsLocalIso.trans B (B ⊗[A] C) C

end Algebra.IsLocalIso

end
