/-!
# Sheaves of `Λ`-modules on `X_proét` and the ideal sheaf `I·\underline{Λ}`

Let `X` be a scheme, `Λ` a ring and `I ⊆ Λ` an ideal. A sheaf `P` of `Λ`-modules on `X_proét`
defines a sheaf of modules over the constant ring sheaf `\underline{Λ}`, through
`AlgebraicGeometry.ProEtale.constantCoefficientModuleEquiv`. This file compares two properties of
`P`, read over `Λ`, with the corresponding properties along the ideal sheaf `I·\underline{Λ}`.

## Main results

* `AlgebraicGeometry.ProEtale.idealPowerProduct_eq_top_of_isZero_extendScalars`: for `Λ`
  Noetherian, if `P ⊗_Λ Λ/I = 0`, then `I·P = P` for the sheaf of `\underline{Λ}`-modules
  defined by `P`.
* `AlgebraicGeometry.ProEtale.isDerivedComplete_single_of_isDerivedCompleteModule`: for `Λ`
  Noetherian, if the sections of `P` over every affine w-contractible object of `X_proét` are
  derived complete `Λ`-modules, then the sheaf of `\underline{Λ}`-modules defined by `P`, placed
  in degree zero, is derived complete along `I·\underline{Λ}`. This is the converse of
  `AlgebraicGeometry.ProEtale.isDerivedCompleteModule_obj_of_isDerivedComplete`.

## Implementation notes

For the first statement, a subsheaf `N` containing every product `a • m` of a local section `a` of
`I·\underline{Λ}` with a local section `m` gives a cokernel `Q` on which every `l ∈ I` acts by
zero. Read back as a sheaf of `Λ`-modules, `Q` is then a sheaf of `Λ/I`-modules
(`Stacks.ModuleSheaf.essImage_restrictScalars_of_smul_id_eq_zero`), so the projection `P ⟶ Q`
corresponds to a map out of `P ⊗_Λ Λ/I = 0`, and vanishes.

For the second statement, derived completeness of sections is tested on the testing family of
affine w-contractible objects
(`AlgebraicGeometry.RingedSite.isDerivedComplete_sheaf_single_iff_sections_of_sliceTestingFamily`).
Over such an object `W` the ideal of sections of `I·\underline{Λ}` is generated by the image of
`I` (`AlgebraicGeometry.ProEtale.constantCoefficientIdealSheaf_obj_eq_map`), and the elements at
which a complex is derived complete form an ideal (Stacks 091Q), so it suffices to treat the
images of the elements of `I`, which act on the sections as the elements themselves do.

## References

* [Stacks Project, Tag 091Q](https://stacks.math.columbia.edu/tag/091Q)
* [Stacks Project, Tag 0999](https://stacks.math.columbia.edu/tag/0999)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite DerivedCompleteRecurrence
open scoped IsMulCommutative

universe u w

namespace AlgebraicGeometry.ProEtale

attribute [local instance] HasDerivedCategory.standard
  SheafOfModules.hasSheafify_commRingCat
  Stacks.hasSheafCompose_forget₂_commRingCat
  SheafOfModules.wEqualsLocallyBijective_commRingCat
  GrothendieckTopology.hasSheafify_addCommGrpCat
  SheafOfModules.wEqualsLocallyBijective_addCommGrpCat

variable {X : Scheme.{u}} {Λ : Type (max (u + 1) w)} [CommRing Λ] {I : Ideal Λ}

/-- The ring of sections of the constant coefficient ring sheaf over `V` is commutative. -/
private theorem isMulCommutative_ringSheaf_obj (X : Scheme.{u}) (Λ : Type (max (u + 1) w))
    [CommRing Λ] (V : X.ProEtᵒᵖ) :
    IsMulCommutative ((Stacks.SheafOfModules.Tensor.ringSheaf
      (constantCoefficientRingedSite.{u, max (u + 1) w, w} X Λ).O).obj.obj V) := by
  change IsMulCommutative ((constantCoefficientRingedSite.{u, max (u + 1) w, w} X Λ).O.obj.obj V)
  infer_instance

/-- **A sheaf of `Λ`-modules with vanishing reduction modulo `I`.** If `P ⊗_Λ Λ/I = 0`, then
`I·P = P` for the sheaf of `\underline{Λ}`-modules defined by `P`. -/
theorem idealPowerProduct_eq_top_of_isZero_extendScalars [IsNoetherianRing Λ]
    (P : Sheaf (Scheme.ProEt.topology X) (ModuleCat.{max (u + 1) w} Λ))
    (hP : IsZero ((Stacks.ModuleSheaf.extendScalars (Scheme.ProEt.topology X)
      (Ideal.Quotient.mk I)).obj P)) :
    RingedSite.idealPowerProductOfSize.{u + 1, u, w} _
        (constantCoefficientIdealSheaf.{u, max (u + 1) w, w} X Λ I)
      ((constantCoefficientModuleEquiv.{u, max (u + 1) w, w} X Λ).functor.obj P) 1 = ⊤ := by
  let E := constantCoefficientModuleEquiv.{u, max (u + 1) w, w} X Λ
  let R := Stacks.SheafOfModules.Tensor.ringSheaf
    (constantCoefficientRingedSite.{u, max (u + 1) w, w} X Λ).O
  let : E.functor.Additive := Functor.additive_of_preserves_binary_products _
  let : E.inverse.Additive := Functor.additive_of_preserves_binary_products _
  have : ∀ V : X.ProEtᵒᵖ, IsMulCommutative (R.obj.obj V) :=
    isMulCommutative_ringSheaf_obj X Λ
  let s : Λ → (R.obj ⋙ forget RingCat).sections := fun l =>
    ⟨fun V => coefficientSectionsMap.{u, max (u + 1) w, w} X Λ V.unop l,
      fun f => coefficientSectionsMap_restrict X Λ f.unop l⟩
  have hE : ∀ (l : Λ) (P' : Sheaf (Scheme.ProEt.topology X) (ModuleCat.{max (u + 1) w} Λ)),
      E.functor.map (l • 𝟙 P') =
        (Stacks.SheafOfModules.globalSectionToEnd R (s l)).app (E.functor.obj P') := fun l P' => by
    ext W z
    exact constantCoefficientModuleEquiv_functor_map_smul_id_val_app X P' l W.unop z
  let : CompleteLattice (E.functor.obj P).Submodule :=
    SheafOfModules.Submodule.instCompleteLattice
  unfold RingedSite.idealPowerProductOfSize
  refine sInf_eq_top.mpr fun N hN => ?_
  let p := cokernel.π N.ι
  -- every `l ∈ I` acts by zero on the cokernel of `N ⟶ P`
  have hs : ∀ l ∈ I,
      (Stacks.SheafOfModules.globalSectionToEnd R (s l)).app (cokernel N.ι) = 0 := by
    intro l hl
    have h₁ :
        (Stacks.SheafOfModules.globalSectionToEnd R (s l)).app (E.functor.obj P) ≫ p = 0 := by
      ext W z
      have hz := hN W ((s l).val W)
        ((pow_one
          (RingedSite.idealSectionsOfSize _ (constantCoefficientIdealSheaf X Λ I) W)).symm.le
          (coefficientSectionsMap_mem_constantCoefficientIdealSheaf X Λ I W.unop hl)) z
      exact (show (N.ι ≫ p).val.app W ⟨_, hz⟩ = 0 by rw [cokernel.condition]; rfl)
    rw [← cancel_epi p, comp_zero, ← h₁]
    exact (Stacks.SheafOfModules.globalSectionToEnd R (s l)).naturality p
  -- read over `Λ`, the cokernel is killed by `I`
  let G := E.inverse.obj (cokernel N.ι)
  have hG : ∀ l ∈ I, l • 𝟙 G = 0 := fun l hl => E.functor.map_injective <| by
    let ε := E.counitIso.app (cokernel N.ι)
    rw [hE, Functor.map_zero, ← cancel_mono ε.hom, zero_comp]
    exact ((Stacks.SheafOfModules.globalSectionToEnd R (s l)).naturality ε.hom).symm.trans
      ((congrArg (ε.hom ≫ ·) (hs l hl)).trans comp_zero)
  obtain ⟨G', ⟨eG⟩⟩ := Stacks.ModuleSheaf.essImage_restrictScalars_of_smul_id_eq_zero I G hG
  let adj := Stacks.ModuleSheaf.extendRestrictScalarsAdj (Scheme.ProEt.topology X)
    (Ideal.Quotient.mk I)
  have hφ : ∀ φ : P ⟶ G, φ = 0 := fun φ => by
    rw [← cancel_mono eG.inv, zero_comp, ← (adj.homEquiv P G').apply_symm_apply (φ ≫ eG.inv),
      hP.eq_of_src ((adj.homEquiv P G').symm (φ ≫ eG.inv)) 0, Adjunction.homEquiv_unit,
      Functor.map_zero, comp_zero]
  have hp : p = 0 := by
    rw [← (E.toAdjunction.homEquiv P (cokernel N.ι)).symm_apply_apply p,
      hφ (E.toAdjunction.homEquiv P (cokernel N.ι) p), Adjunction.homEquiv_counit,
      Functor.map_zero, zero_comp]
  have : Epi N.ι := Abelian.epi_of_cokernel_π_eq_zero _ hp
  have : IsIso N.ι := isIso_of_mono_of_epi _
  refine eq_top_iff.mpr (SheafOfModules.Submodule.le_iff.mpr
    (PresheafOfModules.Submodule.le_iff.mpr fun U x _ => ?_))
  have e : (N.ι.val.app U) ((inv N.ι).val.app U x) = x :=
    congrArg (fun g => (PresheafOfModules.Hom.app g.val U) x) (IsIso.inv_hom_id N.ι)
  rw [← e]
  exact ((inv N.ι).val.app U x).2

/-- **Derived completeness of a sheaf of `Λ`-modules from its sections.** Let `Λ` be Noetherian.
If the sections of a sheaf `P` of `Λ`-modules on `X_proét` over every affine w-contractible
object are derived complete `Λ`-modules, then the sheaf of `\underline{Λ}`-modules defined by
`P`, placed in degree zero, is derived complete along `I·\underline{Λ}`. -/
theorem isDerivedComplete_single_of_isDerivedCompleteModule [IsNoetherianRing Λ]
    (P : Sheaf (Scheme.ProEt.topology X) (ModuleCat.{max (u + 1) w} Λ))
    (hP : ∀ W : X.ProEt, Scheme.ProEt.IsAffineWContractible W →
      IsDerivedCompleteModule I (P.obj.obj (op W))) :
    RingedSite.IsDerivedComplete.{u + 1, u, max (u + 1) w, w}
      (constantCoefficientRingedSite.{u, max (u + 1) w, w} X Λ)
      (constantCoefficientIdealSheaf.{u, max (u + 1) w, w} X Λ I)
      ((DerivedCategory.singleFunctor _ 0).obj
        ((constantCoefficientModuleEquiv.{u, max (u + 1) w, w} X Λ).functor.obj P)) := by
  refine
    (RingedSite.isDerivedComplete_sheaf_single_iff_sections_of_sliceTestingFamily.{u + 1, u, w}
      _ (Scheme.ProEt.testingFamily.{max (u + 1) w} X) _ _).mpr fun W hW => ?_
  have := isMulCommutative_ringSheaf_obj X Λ (op W)
  let : CommRing ((Stacks.SheafOfModules.Tensor.ringSheaf
      (constantCoefficientRingedSite.{u, max (u + 1) w, w} X Λ).O).obj.obj (op W)) := inferInstance
  let : HasProductsOfShape ℕ (DerivedCategory (ModuleCat.{max (u + 1) w}
      ((Stacks.SheafOfModules.Tensor.ringSheaf
        (constantCoefficientRingedSite.{u, max (u + 1) w, w} X Λ).O).obj.obj (op W)))) :=
    Stacks.DerivedProducts.hasProductsOfShape_derivedCategory
  let G := (constantCoefficientModuleEquiv.{u, max (u + 1) w, w} X Λ).functor.obj P
  let M := (SheafOfModules.evaluation _ (op W)).obj G
  obtain ⟨K, -, hK⟩ := exists_isRadical_ideal_isDerivedCompleteAt _
    ((DerivedCategory.singleFunctor _ 0).obj M)
  let e := moduleSheafOverConstantCoefficientsSectionsEquiv X P W
  -- the image of `I` consists of elements at which the sections are derived complete
  have hle : I.map (coefficientSectionsMap.{u, max (u + 1) w, w} X Λ W) ≤ K := by
    refine Ideal.map_le_iff_le_comap.mpr fun f hf => ?_
    refine (hK _).mpr ((isDerivedCompleteAt_single_iff_bijective_recurrence M _).mpr ?_)
    refine bijective_recurrence_of_addEquiv e.symm _ f (fun z => ?_)
      ((isDerivedCompleteModule_iff_forall_bijective_recurrence I _).mp (hP W hW) f hf)
    apply e.injective
    rw [moduleSheafOverConstantCoefficientsSectionsEquiv_smul, AddEquiv.apply_symm_apply,
      AddEquiv.apply_symm_apply]
    rfl
  dsimp only
  rw [isDerivedCompleteModule_iff_forall_bijective_recurrence]
  intro g hg
  have hg' : g ∈ I.map (coefficientSectionsMap.{u, max (u + 1) w, w} X Λ W) := by
    rwa [← constantCoefficientIdealSheaf_obj_eq_map X Λ I W hW (IsNoetherian.noetherian I)]
  exact (isDerivedCompleteAt_single_iff_bijective_recurrence M g).mp ((hK g).mp (hle hg'))

end AlgebraicGeometry.ProEtale
