module

public import StacksFrontier.AlgebraicGeometry.Blowup.RelativeProj
public import StacksFrontier.AlgebraicGeometry.ProjPolyChart.MapDomain
public import StacksFrontier.AlgebraicGeometry.ProjShared.MapDomain
public import StacksFrontier.AlgebraicGeometry.ProjModelStructureMap.Basic
public import StacksFrontier.AlgebraicGeometry.RelativeProjSituation.MapBaseChange
import StacksCore.Tactic.EgaSgaAttribute

/-!
# `Proj R[T₀, …, Tₙ]` as a functor of the coefficient ring, and the cartesian square it sits in

A change of coefficient ring `f : R →+* S` induces a morphism
`Proj S[T₀, …, Tₙ] ⟶ Proj R[T₀, …, Tₙ]` over `Spec S ⟶ Spec R`, and that square is cartesian as
soon as the chart hypothesis `Stacks.Proj.IsBaseChangeOnCharts` holds. This file builds the
morphism, proves the square commutes, and reduces cartesianness to that one hypothesis.

The graded ring homomorphism is defined for an arbitrary ring homomorphism of coefficients, not
only for a ring equivalence.

## Main definitions

* `Stacks.ProjectiveCohomology.polyGradedMap`: the graded ring homomorphism
  `R[T₀, …, Tₙ] →+*ᵍ S[T₀, …, Tₙ]` induced by `f : R →+* S`, for an arbitrary index type.
* `Stacks.ProjectiveCohomology.projModelMap`: the induced morphism
  `Proj S[T₀, …, Tₙ] ⟶ Proj R[T₀, …, Tₙ]`.

## Main results

* `Stacks.ProjectiveCohomology.polyGradedMap_id`: the construction is the identity at the
  identity.
* `Stacks.ProjectiveCohomology.irrelevant_le_map_polyGradedMap`: **the containment of irrelevant
  ideals that `AlgebraicGeometry.Proj.map` requires, for an arbitrary coefficient ring map.**
* `Stacks.ProjectiveCohomology.polyDegreeZeroHom_comp_gradedZeroRingHom`: **the degree-zero
  identification is natural in the coefficient ring.**
* `Stacks.ProjectiveCohomology.projModelMap_comp_projModelToSpec`: **the induced morphism is a
  morphism over `Spec S ⟶ Spec R`**: with the structure morphisms
  `Stacks.ProjectiveCohomology.projModelToSpec` it forms a commuting square.
* `Stacks.ProjectiveCohomology.isPullback_projModelToSpec_of_isBaseChangeOnCharts`: **that square
  is cartesian, given the chart hypothesis and nothing else.**

## Implementation notes

The proof of the irrelevant containment is split into declarations with declared types: written
as one `refine` into `Stacks.AlgebraicGeometry.ProjShared.irrelevant_le_map_of_mem_span` with its
three leading arguments left as `_`, it is a deterministic `whnf` timeout at the default budget.

The two coefficient rings live in one universe, because both
`Stacks.AlgebraicGeometry.ProjShared.irrelevant_le_map_of_mem_span` and
`AlgebraicGeometry.Proj.isPullback_toSpecZero_map` quantify their two carrier rings at the same
universe.

No tag attribute is attached: the cartesian square of the base-change clause of the
projective-space tag is proved here only under the chart hypothesis.

## References

* [Stacks Project, Tag 01N2](https://stacks.math.columbia.edu/tag/01N2)
* [Stacks Project, Tag 01NF](https://stacks.math.columbia.edu/tag/01NF)
* [Stacks Project, Tag 01MY](https://stacks.math.columbia.edu/tag/01MY)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u w

attribute [local instance] MvPolynomial.gradedAlgebra

namespace Stacks.ProjectiveCohomology

variable {R S : Type u} [CommRing R] [CommRing S] (σ : Type w)

/-! ### The graded ring homomorphism -/

/-- **A ring homomorphism of coefficients is a graded homomorphism of polynomial rings**:
`MvPolynomial.map f`, which preserves total degree. -/
def polyGradedMap (f : R →+* S) :
    MvPolynomial.homogeneousSubmodule σ R →+*ᵍ MvPolynomial.homogeneousSubmodule σ S where
  toRingHom := MvPolynomial.map f
  map_mem {_i x} hx := ((MvPolynomial.mem_homogeneousSubmodule _ x).1 hx).map f

/-- The construction is the identity at the identity. -/
theorem polyGradedMap_id : polyGradedMap (R := R) σ (RingHom.id R) = GradedRingHom.id _ :=
  GradedRingHom.ext fun x => MvPolynomial.map_id x

/-! ### The containment of irrelevant ideals -/

/-- The degree-one part of a polynomial ring is contained in the ideal generated by the coordinate
variables: it is their span over the coefficient ring, which is smaller. -/
theorem homogeneousSubmodule_one_le_restrictScalars_span_X :
    MvPolynomial.homogeneousSubmodule σ S 1 ≤
      (Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ S))).restrictScalars S := by
  rw [MvPolynomial.homogeneousSubmodule_one_eq_span_X]
  exact Submodule.span_le.2 fun x hx => Ideal.subset_span hx

/-- Each coordinate variable of `S[T₀, …, Tₙ]` is the image of the corresponding coordinate
variable of `R[T₀, …, Tₙ]`, which is homogeneous of degree one. -/
theorem range_X_subset_image_polyGradedMap (f : R →+* S) :
    (Set.range (MvPolynomial.X : σ → MvPolynomial σ S)) ⊆
      (polyGradedMap σ f) '' (⋃ n > 0, (MvPolynomial.homogeneousSubmodule σ R n : Set _)) := by
  rintro x ⟨i, rfl⟩
  exact ⟨MvPolynomial.X i,
    Set.mem_iUnion.2 ⟨1, Set.mem_iUnion.2 ⟨one_pos,
      (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X R i)⟩⟩,
    MvPolynomial.map_X f i⟩

/-- Every homogeneous polynomial of positive degree over `S` lies in the ideal generated by the
images under `polyGradedMap σ f` of the homogeneous polynomials of positive degree over `R`. -/
theorem mem_span_image_polyGradedMap (f : R →+* S) (d : ℕ) (hd : 0 < d) (g : MvPolynomial σ S)
    (hg : g ∈ MvPolynomial.homogeneousSubmodule σ S d) :
    g ∈ Ideal.span ((polyGradedMap σ f) ''
      (⋃ n > 0, (MvPolynomial.homogeneousSubmodule σ R n : Set _))) :=
  Ideal.span_mono (range_X_subset_image_polyGradedMap σ f)
    (Stacks.AlgebraicGeometry.ProjPolyChart.mem_span_X_of_mem_homogeneousSubmodule hd hg)

/-- **The containment of irrelevant ideals that `AlgebraicGeometry.Proj.map` requires, for an
arbitrary ring homomorphism of coefficients.** -/
theorem irrelevant_le_map_polyGradedMap (f : R →+* S) :
    HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule σ S) ≤
      (HomogeneousIdeal.irrelevant (MvPolynomial.homogeneousSubmodule σ R)).map
        (polyGradedMap σ f) :=
  Stacks.AlgebraicGeometry.ProjShared.irrelevant_le_map_of_mem_span
    (MvPolynomial.homogeneousSubmodule σ R) (MvPolynomial.homogeneousSubmodule σ S)
    (polyGradedMap σ f) (mem_span_image_polyGradedMap σ f)

/-! ### The induced morphism of projective spaces, over `Spec S ⟶ Spec R` -/

/-- **A change of coefficient ring induces a morphism of projective spaces.** -/
def projModelMap (n : ℕ) (f : R →+* S) :
    AlgebraicGeometry.Proj (polyGrading S n) ⟶ AlgebraicGeometry.Proj (polyGrading R n) :=
  Proj.map (polyGradedMap (Fin (n + 1)) f) (irrelevant_le_map_polyGradedMap (Fin (n + 1)) f)

/-- **The degree-zero identification is natural in the coefficient ring.** The degree-zero part of
`Stacks.ProjectiveCohomology.polyGradedMap` corresponds, under the identification of the
degree-zero part of a polynomial ring with its coefficient ring, to the coefficient ring map
itself: both send a constant to the corresponding constant. -/
theorem polyDegreeZeroHom_comp_gradedZeroRingHom (n : ℕ) (f : R →+* S) :
    polyDegreeZeroHom R n ≫
        CommRingCat.ofHom (polyGradedMap (Fin (n + 1)) f).gradedZeroRingHom =
      CommRingCat.ofHom f ≫ polyDegreeZeroHom S n := by
  refine CommRingCat.hom_ext (RingHom.ext fun r => Subtype.ext ?_)
  show MvPolynomial.map f (MvPolynomial.C r) = MvPolynomial.C (f r)
  exact MvPolynomial.map_C f r

/-- **The induced morphism is a morphism over `Spec S ⟶ Spec R`**: it commutes with the structure
morphisms `projModelToSpec`. -/
@[ega "II 2.8.5" "special case"]
theorem projModelMap_comp_projModelToSpec (n : ℕ) (f : R →+* S) :
    projModelMap n f ≫ projModelToSpec R n =
      projModelToSpec S n ≫ Spec.map (CommRingCat.ofHom f) := by
  rw [projModelMap, projModelToSpec_eq, projModelToSpec_eq, ← Category.assoc,
    AlgebraicGeometry.Proj.map_toSpecZero, Category.assoc, Category.assoc,
    ← Spec.map_comp, ← Spec.map_comp, polyDegreeZeroHom_comp_gradedZeroRingHom]

/-- **Projective `n`-space over `S` is the base change of projective `n`-space over `R`, given the
chart hypothesis `Stacks.Proj.IsBaseChangeOnCharts`.** -/
theorem isPullback_projModelToSpec_of_isBaseChangeOnCharts (n : ℕ) (f : R →+* S)
    (H : Stacks.Proj.IsBaseChangeOnCharts (polyGradedMap (Fin (n + 1)) f)) :
    IsPullback (projModelToSpec S n) (projModelMap n f)
      (Spec.map (CommRingCat.ofHom f)) (projModelToSpec R n) := by
  have hsq : CommSq (Spec.map (polyDegreeZeroHom S n))
      (Spec.map (CommRingCat.ofHom
        (polyGradedMap (Fin (n + 1)) f).gradedZeroRingHom))
      (Spec.map (CommRingCat.ofHom f)) (Spec.map (polyDegreeZeroHom R n)) :=
    ⟨by rw [← Spec.map_comp, ← Spec.map_comp, polyDegreeZeroHom_comp_gradedZeroRingHom]⟩
  exact (AlgebraicGeometry.Proj.isPullback_toSpecZero_map
    (irrelevant_le_map_polyGradedMap (Fin (n + 1)) f) H).paste_horiz
      (IsPullback.of_horiz_isIso hsq)

end Stacks.ProjectiveCohomology

end
