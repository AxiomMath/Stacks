module

public import StacksFrontier.AlgebraicGeometry.ProjBaseChange.Chart
public import StacksFrontier.AlgebraicGeometry.ProjBaseChange.Generic
public import StacksFrontier.AlgebraicGeometry.ProjPolyChart.Comparison
public import StacksFrontier.AlgebraicGeometry.ProjPolyChart.Cover

/-!
# `Proj R[T₀, …, Tₙ]` is the base change of the integral model

This file closes the comparison of the two models of projective `n`-space over a commutative ring
`R`: the canonical morphism `Stacks.AlgebraicGeometry.ProjPolyChart.projCompare` from the
polynomial model `Proj R[T₀, …, Tₙ]` to the base-change model `ℙⁿ_R` is an isomorphism. Together
with `Stacks.AlgebraicGeometry.ProjPolyChart.polynomialComparisonOfIsIso` this gives the
coordinate-pinned comparison of the two models.

## Main results

* `Stacks.AlgebraicGeometry.ProjBaseChange.isIso_projCompare`: the comparison is an isomorphism,
  i.e. `Proj` of a polynomial ring is the base change of `Proj` of the integral polynomial ring.
* `Stacks.AlgebraicGeometry.ProjBaseChange.polynomialComparison`: consequently the
  coordinate-pinned comparison of the two models exists.

## Implementation notes

The proof is Zariski-local on the base-change model, over the cover by the base changes of the
standard affine charts `D₊(Tᵢ)` of the integral model. Three facts are combined.

* The chart square of `AlgebraicGeometry.Proj.map` is a pullback square
  (`Stacks.AlgebraicGeometry.ProjBaseChange.isPullback_awayι_projMap`), applied with the map of
  degree-zero localizations spelled as `Stacks.AlgebraicGeometry.ProjPolyChart.chartBaseChange`
  rather than as `HomogeneousLocalization.Away.map`.
* That spelling of the chart square is a pushout of rings
  (`Stacks.AlgebraicGeometry.ProjBaseChange.isPushout_chartBaseChange`), so the standard chart of
  the polynomial model is the fibre product of `Spec R` with the standard chart of the integral
  model over `Spec (ULift ℤ)`. That ring spectrum is terminal, so the cospan may be replaced by
  the one over the terminal scheme that the base-change model is built from.
* Both descriptions exhibit the chart of the polynomial model as a fibre product over the same
  cospan, so the comparison between them is an isomorphism; and `D₊(Tᵢ)` covers because a
  homogeneous polynomial of positive degree lies in the ideal generated by the variables
  (`Stacks.AlgebraicGeometry.ProjPolyChart.homogeneous_mem_span_X`).

`Stacks.AlgebraicGeometry.ProjPolyChart.coordinateProjMap` is built from this repository's Tag
01MY morphism on its domain of definition, not from `AlgebraicGeometry.Proj.map`; the two are
identified by `Stacks.AlgebraicGeometry.ProjBaseChange.mapHom_eq_projMap`, which is what lets
Mathlib's chart square be used at all.

`AlgebraicGeometry.projectiveSpaceAtUniverse` is a plain definition, so a term that mixes it with
`AlgebraicGeometry.Proj` of the integral polynomial ring is type-correct only at default
transparency; `rw` and instance search both work at a lower transparency and fail on such a term.
Every statement below therefore goes through
`Stacks.AlgebraicGeometry.ProjBaseChange.integralChart`, which is `AlgebraicGeometry.Proj.awayι`
retyped as a morphism into `AlgebraicGeometry.projectiveSpaceAtUniverse`, with its open immersion
instance and its range supplied by hand.

## References

* [Stacks Project, Tag 01NF](https://stacks.math.columbia.edu/tag/01NF)
* [Stacks Project, Tag 03GL](https://stacks.math.columbia.edu/tag/03GL)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open HomogeneousIdeal HomogeneousLocalization
open Stacks.AlgebraicGeometry.ProjPolyChart

namespace Stacks.AlgebraicGeometry.ProjBaseChange

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

variable (R : Type u) [CommRing R] (n : ℕ)

/-! ### Identification with Mathlib's morphism -/

/-- The canonical coefficient homomorphism satisfies Mathlib's hypothesis for
`AlgebraicGeometry.Proj.map`. -/
public theorem irrelevant_le_map_integralGradedHom :
    HomogeneousIdeal.irrelevant (polyGrading R n) ≤
      (HomogeneousIdeal.irrelevant (polyGrading (ULift.{u} ℤ) n)).map (integralGradedHom R n) :=
  irrelevant_le_map_coeffGradedHom (ULift.{u} ℤ) n (integralCoeffHom R)

/-- **The comparison's projection to the integral model is Mathlib's
`AlgebraicGeometry.Proj.map`.** The Tag 01MY morphism of the canonical coefficient homomorphism,
which is everywhere defined, agrees with the morphism Mathlib builds from the inclusion of
irrelevant ideals. -/
public theorem coordinateProjMap_eq_projMap :
    coordinateProjMap R n (integralGradedHom R n) (mapDomain_integralGradedHom_eq_top R n) =
      AlgebraicGeometry.Proj.map (integralGradedHom R n)
        (irrelevant_le_map_integralGradedHom R n) :=
  mapHom_eq_projMap (polyGrading (ULift.{u} ℤ) n) (polyGrading R n) (integralGradedHom R n)
    (irrelevant_le_map_integralGradedHom R n) (mapDomain_integralGradedHom_eq_top R n)

/-! ### The standard chart of the integral model -/

/-- The standard affine chart `D₊(Tᵢ)` of the integral model of projective `n`-space, typed as a
morphism into `AlgebraicGeometry.projectiveSpaceAtUniverse`. -/
public def integralChart (i : Fin (n + 1)) :
    Spec (CommRingCat.of (Away (polyGrading (ULift.{u} ℤ) n) (MvPolynomial.X i))) ⟶
      AlgebraicGeometry.projectiveSpaceAtUniverse.{u} n :=
  AlgebraicGeometry.Proj.awayι (polyGrading (ULift.{u} ℤ) n) (MvPolynomial.X i)
    (X_mem_one (ULift.{u} ℤ) n i) Nat.one_pos

/-- The standard chart of the integral model is an open immersion. The instance Mathlib supplies
for `AlgebraicGeometry.Proj.awayι` is not found through `integralChart`, whose codomain is spelled
`AlgebraicGeometry.projectiveSpaceAtUniverse`. -/
public instance isOpenImmersion_integralChart (i : Fin (n + 1)) :
    IsOpenImmersion (integralChart.{u} n i) := by
  change IsOpenImmersion (AlgebraicGeometry.Proj.awayι (polyGrading (ULift.{u} ℤ) n)
    (MvPolynomial.X i) (X_mem_one (ULift.{u} ℤ) n i) Nat.one_pos)
  infer_instance

/-- The standard chart of the integral model has image the standard open `D₊(Tᵢ)`. -/
public theorem opensRange_integralChart (i : Fin (n + 1)) :
    (integralChart.{u} n i).opensRange =
      AlgebraicGeometry.Proj.basicOpen (polyGrading (ULift.{u} ℤ) n) (MvPolynomial.X i) :=
  AlgebraicGeometry.Proj.opensRange_awayι (polyGrading (ULift.{u} ℤ) n) (MvPolynomial.X i)
    (X_mem_one (ULift.{u} ℤ) n i) Nat.one_pos

/-! ### The structure morphism on a standard chart -/

/-- **The structure morphism of `Proj R[T]` on the standard chart `D₊(Tᵢ)`.** It is `Spec` of the
coefficient inclusion `R → R[T]_{(Tᵢ)}`. -/
public theorem awayι_comp_projToSpecCoeff (i : Fin (n + 1)) :
    AlgebraicGeometry.Proj.awayι (polyGrading R n) (MvPolynomial.X i)
        (X_mem_one R n i) Nat.one_pos ≫ projToSpecCoeff R n =
      Spec.map (CommRingCat.ofHom (coeffToAway R n i)) := by
  have hz : ∀ r : R, (GradedRing.projZeroRingHom' (polyGrading R n))
      (algebraMap R (MvPolynomial (Fin (n + 1)) R) r) = algebraMap R (polyGrading R n 0) r :=
    fun r => by
      have h := GradedRing.projZeroRingHom'_apply_coe (polyGrading R n)
        (algebraMap R (polyGrading R n 0) r)
      rwa [SetLike.GradeZero.coe_algebraMap] at h
  have key : (HomogeneousLocalization.fromZeroRingHom (polyGrading R n)
        (Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) R))).comp
        ((GradedRing.projZeroRingHom' (polyGrading R n)).comp
          (algebraMap R (MvPolynomial (Fin (n + 1)) R))) = coeffToAway R n i := by
    refine RingHom.ext fun r => ?_
    rw [RingHom.comp_apply, RingHom.comp_apply, hz r, coeffToAway, RingHom.comp_apply]
    rfl
  rw [projToSpecCoeff, ← Category.assoc, AlgebraicGeometry.Proj.awayι_toSpecZero,
    ← Spec.map_comp, ← CommRingCat.ofHom_comp, key]

/-! ### The cover of the base-change model -/

/-- The opens of the base-change model covered by the base changes of the standard charts. -/
public def baseChangeOpen (i : Fin (n + 1)) :
    (AlgebraicGeometry.projectiveSpaceOverRing.{u} n (CommRingCat.of R)).Opens :=
  pullback.snd (terminal.from (Spec (CommRingCat.of R)))
      (terminal.from (AlgebraicGeometry.projectiveSpaceAtUniverse.{u} n)) ⁻¹ᵁ
    AlgebraicGeometry.Proj.basicOpen (polyGrading (ULift.{u} ℤ) n) (MvPolynomial.X i)

/-- **The base changes of the standard charts cover the base-change model.** -/
public theorem iSup_baseChangeOpen_eq_top :
    (⨆ i : Fin (n + 1), baseChangeOpen R n i) = ⊤ :=
  Scheme.Hom.iSup_preimage_eq_top _
    (Stacks.AlgebraicGeometry.ProjPolyChart.iSup_basicOpen_X_eq_top (ULift.{u} ℤ) n)

/-! ### The chart of the polynomial model is the fibre product -/

/-- **The standard chart of the polynomial model is the fibre product of the comparison with the
base change of the standard chart of the integral model.** The projection to the base-changed
chart is an isomorphism; this is the local statement from which
`Stacks.AlgebraicGeometry.ProjBaseChange.isIso_projCompare` follows by gluing. -/
public theorem exists_isIso_chartCompare (i : Fin (n + 1)) :
    ∃ q : Spec (CommRingCat.of (Away (polyGrading R n) (MvPolynomial.X i))) ⟶
        pullback (integralChart n i)
          (pullback.snd (terminal.from (Spec (CommRingCat.of R)))
            (terminal.from (AlgebraicGeometry.projectiveSpaceAtUniverse.{u} n))),
      IsIso q ∧
        IsPullback (AlgebraicGeometry.Proj.awayι (polyGrading R n) (MvPolynomial.X i)
            (X_mem_one R n i) Nat.one_pos) q (projCompare R n)
          (pullback.snd (integralChart n i)
            (pullback.snd (terminal.from (Spec (CommRingCat.of R)))
              (terminal.from (AlgebraicGeometry.projectiveSpaceAtUniverse.{u} n)))) := by
  -- the base-changed chart is a fibre product of `Spec R` with the integral chart
  have hZ : IsPullback
      (pullback.snd (integralChart n i)
          (pullback.snd (terminal.from (Spec (CommRingCat.of R)))
            (terminal.from (AlgebraicGeometry.projectiveSpaceAtUniverse.{u} n))) ≫
        pullback.fst (terminal.from (Spec (CommRingCat.of R)))
          (terminal.from (AlgebraicGeometry.projectiveSpaceAtUniverse.{u} n)))
      (pullback.fst (integralChart n i)
        (pullback.snd (terminal.from (Spec (CommRingCat.of R)))
          (terminal.from (AlgebraicGeometry.projectiveSpaceAtUniverse.{u} n))))
      (terminal.from (Spec (CommRingCat.of R)))
      (terminal.from (Spec (CommRingCat.of
        (Away (polyGrading (ULift.{u} ℤ) n) (MvPolynomial.X i))))) := by
    have h := (IsPullback.of_hasPullback (integralChart n i)
        (pullback.snd (terminal.from (Spec (CommRingCat.of R)))
          (terminal.from (AlgebraicGeometry.projectiveSpaceAtUniverse.{u} n)))).flip.paste_horiz
      (IsPullback.of_hasPullback (terminal.from (Spec (CommRingCat.of R)))
        (terminal.from (AlgebraicGeometry.projectiveSpaceAtUniverse.{u} n)))
    rwa [terminal.comp_from] at h
  -- the chart of the polynomial model is that same fibre product
  have hW : IsPullback (Spec.map (CommRingCat.ofHom (coeffToAway R n i)))
      (Spec.map (CommRingCat.ofHom
        (chartBaseChange (ULift.{u} ℤ) n (integralCoeffHom R) i)))
      (terminal.from (Spec (CommRingCat.of R)))
      (terminal.from (Spec (CommRingCat.of
        (Away (polyGrading (ULift.{u} ℤ) n) (MvPolynomial.X i))))) := by
    have _ : IsIso (terminal.from (Spec (CommRingCat.of (ULift.{u} ℤ)))) :=
      isIso_of_isTerminal AlgebraicGeometry.specULiftZIsTerminal terminalIsTerminal _
    have h := (AlgebraicGeometry.isPullback_SpecMap_of_isPushout
        (CommRingCat.ofHom (integralCoeffHom R))
        (CommRingCat.ofHom (coeffToAway (ULift.{u} ℤ) n i))
        (CommRingCat.ofHom (coeffToAway R n i))
        (CommRingCat.ofHom (chartBaseChange (ULift.{u} ℤ) n (integralCoeffHom R) i))
        (isPushout_chartBaseChange (integralCoeffHom R) n i)).paste_horiz
      (IsPullback.of_horiz_isIso (show CommSq (𝟙 (Spec (CommRingCat.of R)))
        (Spec.map (CommRingCat.ofHom (integralCoeffHom R)))
        (terminal.from (Spec (CommRingCat.of R)))
        (terminal.from (Spec (CommRingCat.of (ULift.{u} ℤ)))) from ⟨terminal.hom_ext _ _⟩))
    rw [Category.comp_id, terminal.hom_ext (Spec.map (CommRingCat.ofHom
      (coeffToAway (ULift.{u} ℤ) n i)) ≫ terminal.from (Spec (CommRingCat.of (ULift.{u} ℤ))))
      (terminal.from _)] at h
    exact h
  refine ⟨(hW.isoIsPullback _ _ hZ).hom, inferInstance, ?_⟩
  -- the two legs of the comparison isomorphism
  have hfst := IsPullback.isoIsPullback_hom_fst _ _ hW hZ
  have hsnd := IsPullback.isoIsPullback_hom_snd _ _ hW hZ
  -- the chart square of the comparison
  have hA0 : IsPullback (AlgebraicGeometry.Proj.awayι (polyGrading R n) (MvPolynomial.X i)
        (X_mem_one R n i) Nat.one_pos)
      (Spec.map (CommRingCat.ofHom
        (chartBaseChange (ULift.{u} ℤ) n (integralCoeffHom R) i)))
      (coordinateProjMap R n (integralGradedHom R n)
        (mapDomain_integralGradedHom_eq_top R n))
      (integralChart n i) := by
    rw [coordinateProjMap_eq_projMap]
    exact isPullback_awayι_projMap (polyGrading (ULift.{u} ℤ) n) (polyGrading R n)
      (integralGradedHom R n) (irrelevant_le_map_integralGradedHom R n) Nat.one_pos
      (X_mem_one (ULift.{u} ℤ) n i) (X_mem_one R n i) (by simp)
      (chartBaseChange (ULift.{u} ℤ) n (integralCoeffHom R) i)
      fun k a ha ha' => chartBaseChange_mk (ULift.{u} ℤ) n (integralCoeffHom R) i k a ha ha'
  have hA : IsPullback (AlgebraicGeometry.Proj.awayι (polyGrading R n) (MvPolynomial.X i)
        (X_mem_one R n i) Nat.one_pos)
      ((hW.isoIsPullback _ _ hZ).hom ≫
        pullback.fst (integralChart n i)
          (pullback.snd (terminal.from (Spec (CommRingCat.of R)))
            (terminal.from (AlgebraicGeometry.projectiveSpaceAtUniverse.{u} n))))
      (projCompare R n ≫ pullback.snd (terminal.from (Spec (CommRingCat.of R)))
        (terminal.from (AlgebraicGeometry.projectiveSpaceAtUniverse.{u} n)))
      (integralChart n i) := by
    rw [hsnd, projCompare_snd]
    exact hA0
  refine IsPullback.of_bot hA ?_ (IsPullback.of_hasPullback _ _).flip
  refine pullback.hom_ext ?_ ?_
  · simp only [Category.assoc]
    rw [projCompare_fst, awayι_comp_projToSpecCoeff]
    exact hfst.symm
  · have hw := hA.w
    simp only [Category.assoc] at hw ⊢
    rw [← pullback.condition]
    exact hw

/-! ### The comparison is an isomorphism -/

/-- **`Proj R[T₀, …, Tₙ]` is the base change of `Proj (ULift ℤ)[T₀, …, Tₙ]` along
`Spec R ⟶ Spec ℤ`.** The canonical comparison from the polynomial model of projective `n`-space to
the base-change model is an isomorphism. -/
public instance isIso_projCompare : IsIso (projCompare R n) := by
  choose q hq hpb using exists_isIso_chartCompare R n
  refine isIso_of_isPullback_cover (projCompare R n) (baseChangeOpen R n)
    (iSup_baseChangeOpen_eq_top R n) _
    (fun i : Fin (n + 1) => pullback.snd (integralChart n i)
      (pullback.snd (terminal.from (Spec (CommRingCat.of R)))
        (terminal.from (AlgebraicGeometry.projectiveSpaceAtUniverse.{u} n))))
    (fun i => inferInstance) (fun i => ?_) _ _ q hpb hq
  rw [IsOpenImmersion.range_pullbackSnd, opensRange_integralChart]
  rfl

/-- **The coordinate-pinned comparison of the two models of projective `n`-space.** -/
public def polynomialComparison : PolynomialComparison R n :=
  polynomialComparisonOfIsIso R n

end Stacks.AlgebraicGeometry.ProjBaseChange

end
