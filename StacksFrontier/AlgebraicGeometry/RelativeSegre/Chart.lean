/-!
# The relative Segre morphism over an affine chart

Let `X` be a scheme and `H`, `G` quasi-coherent `𝒪_X`-modules, with projective bundles
`𝐏(H) = Proj_X(Sym H)` and `𝐏(G)`. Over an affine open `U` of `X`, with `R = Γ(X, U)`, the graded
ring of sections `Γ(U, Sym H)` is the symmetric algebra of `Γ(H, U)` over `R`, and for a section
`a ∈ Γ(H, U)` the standard open `D₊(a)` of the chart `Proj Γ(U, Sym H)` of `𝐏(H)` is the spectrum
of the degree-zero localization `Γ(U, Sym H)_{(a)}`, generated by the ratios `h / a`.

For sections `a ∈ Γ(H, U)` and `b ∈ Γ(G, U)` this file builds the affine piece
`V = Spec (Γ(U, Sym H)_{(a)} ⊗_R Γ(U, Sym G)_{(b)})` of `𝐏(H) ×_X 𝐏(G)`, its morphism to the fibre
product, and the morphism `V ⟶ 𝐏(H ⊗ G)` sending `h ⊗ g` to `(h / a) ⊗ (g / b)`: it is the
morphism `Proj.fromOfGlobalSections` of the ring map
`Γ(U, Sym(H ⊗ G)) = Sym_R(Γ(H, U) ⊗_R Γ(G, U)) ⟶ Γ(U, Sym H)_{(a)} ⊗_R Γ(U, Sym G)_{(b)}`
followed by the chart of `𝐏(H ⊗ G)` over `U`. These pieces glue to the relative Segre morphism.

## Main definitions

* `Stacks.RelativeSegre.deg1`: the degree-one element of `Γ(U, Sym E)` attached to a section of
  `E` over `U`.
* `Stacks.RelativeSegre.ratio`: the ratio `h / a` in `Γ(U, Sym E)_{(a)}`.
* `Stacks.RelativeSegre.pieceRing`: the ring `Γ(U, Sym H)_{(a)} ⊗_R Γ(U, Sym G)_{(b)}`.
* `Stacks.RelativeSegre.pieceMap`: the morphism of its spectrum to `𝐏(H) ×_X 𝐏(G)`.
* `Stacks.RelativeSegre.segreRingHom`: the ring map out of `Γ(U, Sym(H ⊗ G))`.
* `Stacks.RelativeSegre.pieceSegre`: the morphism of the piece to `𝐏(H ⊗ G)`.

## References

* [Stacks Project, Tag 01WD](https://stacks.math.columbia.edu/tag/01WD)
* [Stacks Project, Tag 01O4](https://stacks.math.columbia.edu/tag/01O4)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry HomogeneousLocalization
open Stacks.AlgebraicGeometry.RelativeProjBridge
open scoped TensorProduct

universe u

namespace Stacks.RelativeSegre

variable {X : Scheme.{u}}

/-! ### Degree-one elements and ratios -/

section Ratio

variable (E : X.Modules) [E.IsQuasicoherent]

/-- The symmetric algebra of a quasi-coherent module, as the graded algebra data from which its
projective bundle is built. -/
abbrev alg : SheafGradedAlgebra X :=
  Stacks.SymGraded.schemeSheafGradedAlgebra E
    (Stacks.SymGraded.isQuasicoherentPieces_of_isQuasicoherent E)

/-- The projective bundle `𝐏(E) = Proj_X(Sym E)` of a quasi-coherent module. -/
abbrev bun :=
  Stacks.SymGraded.schemeProjectiveBundle E
    (Stacks.SymGraded.isQuasicoherentPieces_of_isQuasicoherent E)

variable {U : X.Opens} (hU : IsAffineOpen U)

/-- The degree-one element of `Γ(U, Sym E)` attached to a section `h` of `E` over an affine open:
the generator `ι h` of the symmetric algebra of `Γ(E, U)`, read in the graded ring of sections. -/
def deg1 (h : Γ(E, U)) : (alg E).sectionRing U :=
  (Stacks.SymGraded.AffinePieces.symSectionRingEquiv E hU
    (Stacks.SymGraded.isQuasicoherentPieces_of_isQuasicoherent E)).symm
      (SymmetricAlgebra.ι Γ(X, U) Γ(E, U) h)

/-- The degree-one symmetric power is the range of the canonical map `ι`. -/
private theorem symmetricPower_one_eq_range (R M : Type*) [CommRing R] [AddCommGroup M]
    [Module R M] : SymPow.symmetricPower 1 R M = LinearMap.range (SymmetricAlgebra.ι R M) :=
  pow_one _

/-- The element `deg1 E hU h` is homogeneous of degree one. -/
theorem deg1_mem (h : Γ(E, U)) : deg1 E hU h ∈ (alg E).grading U 1 := by
  refine (Stacks.SymGraded.AffinePieces.mem_symmetricPower_symSectionRingEquiv E hU _ 1
    (deg1 E hU h)).mp ?_
  rw [deg1, RingEquiv.apply_symm_apply, symmetricPower_one_eq_range]
  exact LinearMap.mem_range_self _ h

/-- The degree-one element attached to a section, as an element of the degree-one part. -/
def deg1' (h : Γ(E, U)) : (alg E).grading U 1 := ⟨deg1 E hU h, deg1_mem E hU h⟩

/-- The ratio `x / a` of two degree-one elements, in the degree-zero localization
`Γ(U, Sym E)_{(a)}`. -/
def ratio (a x : (alg E).grading U 1) : Away ((alg E).grading U) (a : (alg E).sectionRing U) :=
  Away.mk ((alg E).grading U) a.2 1 x (by simpa only [smul_eq_mul, mul_one] using x.2)

/-- The standard affine open `D₊(a)` of the chart of `𝐏(E)` over `U`, mapped into `𝐏(E)`. -/
def chartι (a : (alg E).grading U 1) :
    Spec (CommRingCat.of (Away ((alg E).grading U) (a : (alg E).sectionRing U))) ⟶
      (bun E).scheme :=
  Proj.awayι ((alg E).grading U) (a : (alg E).sectionRing U) a.2 Nat.one_pos ≫
    (bun E).chart U hU

/-- The chart `Proj Γ(U, Sym E) ⟶ 𝐏(E)` over an affine open `U` is an open immersion. -/
theorem isOpenImmersion_chart : IsOpenImmersion ((bun E).chart U hU) :=
  MorphismProperty.of_isPullback (P := @IsOpenImmersion)
    ((bun E).chart_isPullback U hU).flip inferInstance

/-- The standard open `D₊(a) ⟶ 𝐏(E)` is an open immersion. -/
instance (a : (alg E).grading U 1) : IsOpenImmersion (chartι E hU a) := by
  have := isOpenImmersion_chart E hU
  unfold chartι
  infer_instance

/-- The structure map `Γ(X, U) ⟶ Γ(U, Sym E)_{(a)}`: a function is sent to its multiple of the
unit, of degree zero. -/
def awayAlgHom (a : (alg E).grading U 1) :
    Γ(X, U) →+* Away ((alg E).grading U) (a : (alg E).sectionRing U) :=
  (fromZeroRingHom ((alg E).grading U) _).comp
    (Stacks.AlgebraicGeometry.ProjBundleSurjection.strZeroSheaf (alg E) U).hom

/-- `Γ(U, Sym E)_{(a)}` as an algebra over `Γ(X, U)`. -/
scoped instance awayAlgebra (a : (alg E).grading U 1) :
    Algebra Γ(X, U) (Away ((alg E).grading U) (a : (alg E).sectionRing U)) :=
  (awayAlgHom E a).toAlgebra

/-- The algebra map `Γ(X, U) ⟶ Γ(U, Sym E)_{(a)}` is `awayAlgHom E a`. -/
theorem algebraMap_away (a : (alg E).grading U 1) :
    algebraMap Γ(X, U) (Away ((alg E).grading U) (a : (alg E).sectionRing U)) =
      awayAlgHom E a := rfl

/-- The chart `Spec Γ(U, Sym E)_{(a)} ⟶ 𝐏(E)` lies over `Spec Γ(X, U) ⟶ X`. -/
theorem chartι_toBase (a : (alg E).grading U 1) :
    chartι E hU a ≫ (bun E).toBase =
      Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U)
        (Away ((alg E).grading U) (a : (alg E).sectionRing U)))) ≫ hU.fromSpec := by
  rw [chartι, Category.assoc, ((bun E).chart_isPullback U hU).w]
  show Proj.awayι _ _ _ _ ≫ (Proj.toSpecZero _ ≫
    Spec.map (Stacks.AlgebraicGeometry.ProjBundleSurjection.strZeroSheaf (alg E) U) ≫
      hU.isoSpec.inv) ≫ U.ι = _
  rw [Category.assoc, Category.assoc, IsAffineOpen.isoSpec_inv_ι, Proj.awayι_toSpecZero_assoc,
    ← Spec.map_comp_assoc]
  rfl

end Ratio

/-! ### The affine pieces of the fibre product -/

section Piece

variable (H G : X.Modules) [H.IsQuasicoherent] [G.IsQuasicoherent] {U : X.Opens}
  (hU : IsAffineOpen U) (a : (alg H).grading U 1) (b : (alg G).grading U 1)

/-- The ring `Γ(U, Sym H)_{(a)} ⊗_{Γ(X, U)} Γ(U, Sym G)_{(b)}` of the affine piece
`D₊(a) ×_U D₊(b)` of `𝐏(H) ×_X 𝐏(G)`. -/
abbrev pieceRing : Type u :=
  Away ((alg H).grading U) (a : (alg H).sectionRing U) ⊗[Γ(X, U)]
    Away ((alg G).grading U) (b : (alg G).sectionRing U)

/-- **The affine piece `D₊(a) ×_U D₊(b)` of the fibre product `𝐏(H) ×_X 𝐏(G)`**, as a morphism
from the spectrum of its ring: the fibre product over `Spec Γ(X, U)` of the two standard charts,
mapped into the fibre product over `X`. -/
def pieceMap : Spec (CommRingCat.of (pieceRing H G a b)) ⟶
    pullback (bun H).toBase (bun G).toBase :=
  (pullbackSpecIso Γ(X, U) (Away ((alg H).grading U) (a : (alg H).sectionRing U))
      (Away ((alg G).grading U) (b : (alg G).sectionRing U))).inv ≫
    pullback.map _ _ (bun H).toBase (bun G).toBase (chartι H hU a) (chartι G hU b) hU.fromSpec
      (chartι_toBase H hU a).symm (chartι_toBase G hU b).symm

/-- The affine piece `D₊(a) ×_U D₊(b) ⟶ 𝐏(H) ×_X 𝐏(G)` is an open immersion. -/
instance isOpenImmersion_pieceMap : IsOpenImmersion (pieceMap H G hU a b) := by
  unfold pieceMap
  infer_instance

/-- The first projection of `pieceMap` is the chart `D₊(a) ⟶ 𝐏(H)` precomposed with the left
inclusion of the tensor product. -/
@[reassoc (attr := simp)]
theorem pieceMap_fst : pieceMap H G hU a b ≫ pullback.fst _ _ =
    Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeLeftRingHom) ≫ chartι H hU a := by
  rw [pieceMap, Category.assoc, pullback.lift_fst, pullbackSpecIso_inv_fst_assoc]

/-- The second projection of `pieceMap` is the chart `D₊(b) ⟶ 𝐏(G)` precomposed with the right
inclusion of the tensor product. -/
@[reassoc (attr := simp)]
theorem pieceMap_snd : pieceMap H G hU a b ≫ pullback.snd _ _ =
    Spec.map (CommRingCat.ofHom (RingHomClass.toRingHom (Algebra.TensorProduct.includeRight
      (R := Γ(X, U)) (A := Away ((alg H).grading U) (a : (alg H).sectionRing U))
      (B := Away ((alg G).grading U) (b : (alg G).sectionRing U))))) ≫ chartι G hU b := by
  rw [pieceMap, Category.assoc, pullback.lift_snd, pullbackSpecIso_inv_snd_assoc]

end Piece

/-! ### The tensor product -/

section Tensor

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso Stacks.SheafInternalHom.isLocalization_sheafify
  Stacks.SheafInternalHom.monoidalCategory Stacks.SheafInternalHom.sheafifyMonoidal
  Stacks.SheafInternalHom.braidedCategory Stacks.SheafInternalHom.schemeMonoidalCategory

/-- **The tensor product of two quasi-coherent modules is quasi-coherent** (Stacks 01CE), for the
monoidal product of `X.Modules`. -/
theorem isQuasicoherent_tensor (F G : X.Modules) [hF : F.IsQuasicoherent]
    [hG : G.IsQuasicoherent] : (MonoidalCategoryStruct.tensorObj F G).IsQuasicoherent :=
  (SheafOfModules.isQuasicoherent X.ringCatSheaf).prop_of_iso
    (Stacks.AmpleCharacterization.tensorIsoTensorSheaf F G).symm
    (@AlgebraicGeometry.tensorSheaf_isQuasicoherent X.toRingedSpace F G hF hG)

/-- The tensor product `H ⊗ G` of two `𝒪_X`-modules, for the monoidal product of `X.Modules`
whose sections over an affine open are computed by `Stacks.SectionTensorFormula`. -/
abbrev tens (F G : X.Modules) : X.Modules := MonoidalCategoryStruct.tensorObj F G

/-- The tensor product `tens F G` of two quasi-coherent modules is quasi-coherent. -/
instance isQuasicoherent_tens (F G : X.Modules) [F.IsQuasicoherent] [G.IsQuasicoherent] :
    (tens F G).IsQuasicoherent :=
  isQuasicoherent_tensor F G

end Tensor

/-! ### Ratios are linear -/

section RatioLinear

variable (E : X.Modules) [E.IsQuasicoherent] {U : X.Opens} (hU : IsAffineOpen U)

/-- The degree-one element of a sum of sections is the sum of their degree-one elements. -/
theorem deg1_add (h h' : Γ(E, U)) : deg1 E hU (h + h') = deg1 E hU h + deg1 E hU h' := by
  simp only [deg1, map_add]

/-- The degree-one element of `r • h` is the product of `r`, viewed in `Γ(U, Sym E)`, with that
of `h`. -/
theorem deg1_smul (r : Γ(X, U)) (h : Γ(E, U)) :
    deg1 E hU (r • h) = (alg E).strHom U r * deg1 E hU h := by
  rw [deg1, map_smul, Algebra.smul_def, map_mul,
    Stacks.SymTwistChart.symSectionRingEquiv_symm_algebraMap E _ hU r]
  rfl

/-- The ratio `h / a` of a section `h` of `E` over `U` by a degree-one element `a`. -/
def ratioOf (a : (alg E).grading U 1) (h : Γ(E, U)) :
    Away ((alg E).grading U) (a : (alg E).sectionRing U) :=
  ratio E a (deg1' E hU h)

/-- The ratio `(h + h') / a` is `h / a + h' / a`. -/
theorem ratioOf_add (a : (alg E).grading U 1) (h h' : Γ(E, U)) :
    ratioOf E hU a (h + h') = ratioOf E hU a h + ratioOf E hU a h' := by
  apply HomogeneousLocalization.val_injective
  simp only [ratioOf, ratio, deg1', HomogeneousLocalization.val_add, Away.val_mk, deg1_add,
    Localization.add_mk_self]

/-- The value of the structure map `Γ(X, U) ⟶ Γ(U, Sym E)_{(a)}`, in the localization. -/
theorem val_awayAlgHom (a : (alg E).grading U 1) (r : Γ(X, U)) :
    (awayAlgHom E a r).val = Localization.mk ((alg E).strHom U r) 1 := by
  show (HomogeneousLocalization.mk _).val = _
  rw [HomogeneousLocalization.val_mk]
  refine congrArg₂ Localization.mk ?_ (Subtype.ext rfl)
  exact Stacks.AlgebraicGeometry.ProjBundleSurjection.coe_strZeroSheaf_apply (alg E) U r

/-- The ratio `(r • h) / a` is the product of the image of `r` with `h / a`. -/
theorem ratioOf_smul (a : (alg E).grading U 1) (r : Γ(X, U)) (h : Γ(E, U)) :
    ratioOf E hU a (r • h) = algebraMap Γ(X, U) _ r * ratioOf E hU a h := by
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mul, algebraMap_away, val_awayAlgHom]
  simp only [ratioOf, ratio, deg1', Away.val_mk, deg1_smul, Localization.mk_mul, one_mul]

/-- The ratio `a / a` is `1`. -/
theorem ratio_self (a : (alg E).grading U 1) : ratio E a a = 1 := by
  apply HomogeneousLocalization.val_injective
  simp only [ratio, Away.val_mk, HomogeneousLocalization.val_one, pow_one]
  exact Localization.mk_self (⟨(a : (alg E).sectionRing U), 1, pow_one _⟩ :
    Submonoid.powers (a : (alg E).sectionRing U))

end RatioLinear

/-! ### The Segre ring map on a piece -/

section Segre

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso Stacks.SheafInternalHom.isLocalization_sheafify
  Stacks.SheafInternalHom.monoidalCategory Stacks.SheafInternalHom.sheafifyMonoidal
  Stacks.SheafInternalHom.braidedCategory Stacks.SheafInternalHom.schemeMonoidalCategory

variable (H G : X.Modules) [H.IsQuasicoherent] [G.IsQuasicoherent] {U : X.Opens}
  (hU : IsAffineOpen U) (a : (alg H).grading U 1) (b : (alg G).grading U 1)

/-- `(h, g) ↦ (h / a) ⊗ (g / b)`, bilinear over `Γ(X, U)`. -/
def segreBilin : Γ(H, U) →ₗ[Γ(X, U)] Γ(G, U) →ₗ[Γ(X, U)] pieceRing H G a b :=
  LinearMap.mk₂ Γ(X, U) (fun x y => ratioOf H hU a x ⊗ₜ ratioOf G hU b y)
    (fun x x' y => by rw [ratioOf_add, TensorProduct.add_tmul])
    (fun r x y => by
      rw [ratioOf_smul, ← Algebra.smul_def, TensorProduct.smul_tmul'])
    (fun x y y' => by rw [ratioOf_add, TensorProduct.tmul_add])
    (fun r x y => by
      rw [ratioOf_smul, ← Algebra.smul_def, TensorProduct.tmul_smul])

/-- The linear map `Γ(tens H G, U) ⟶ Γ(U, Sym H)_{(a)} ⊗ Γ(U, Sym G)_{(b)}`,
`h ⊗ g ↦ (h / a) ⊗ (g / b)`. -/
def segreLin : Γ(tens H G, U) →ₗ[Γ(X, U)] pieceRing H G a b :=
  TensorProduct.lift (segreBilin H G hU a b) ∘ₗ
    (Stacks.SectionTensorFormula.tensorSectionEquiv H G hU).symm.toLinearMap

/-- The map `segreLin` sends `h ⊗ g` to `(h / a) ⊗ (g / b)`. -/
theorem segreLin_tensorSection (x : Γ(H, U)) (y : Γ(G, U)) :
    segreLin H G hU a b (Stacks.SectionTensorFormula.tensorSection H G x y) =
      ratioOf H hU a x ⊗ₜ ratioOf G hU b y := by
  rw [segreLin, LinearMap.comp_apply, LinearEquiv.coe_toLinearMap,
    ← Stacks.SectionTensorFormula.tensorSectionEquiv_tmul H G hU x y,
    LinearEquiv.symm_apply_apply, TensorProduct.lift.tmul]
  rfl

/-- **The Segre ring map of a piece**: the ring map
`Γ(U, Sym(tens H G)) = Sym_{Γ(X, U)} Γ(tens H G, U) ⟶ Γ(U, Sym H)_{(a)} ⊗ Γ(U, Sym G)_{(b)}`
extending `h ⊗ g ↦ (h / a) ⊗ (g / b)`. -/
def segreRingHom : (alg (tens H G)).sectionRing U →+* pieceRing H G a b :=
  (SymmetricAlgebra.lift (segreLin H G hU a b)).toRingHom.comp
    (Stacks.SymGraded.AffinePieces.symSectionRingEquiv (tens H G) hU
      (Stacks.SymGraded.isQuasicoherentPieces_of_isQuasicoherent (tens H G))).toRingHom

/-- The Segre ring map agrees with `segreLin` on degree-one elements. -/
theorem segreRingHom_deg1 (q : Γ(tens H G, U)) :
    segreRingHom H G hU a b (deg1 (tens H G) hU q) = segreLin H G hU a b q := by
  simp only [segreRingHom, deg1, RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
    RingEquiv.coe_toRingHom, RingEquiv.apply_symm_apply, AlgHom.toRingHom_eq_coe,
    AlgHom.coe_toRingHom, SymmetricAlgebra.lift_ι_apply]

/-- The Segre ring map is compatible with the structure maps from `Γ(X, U)`. -/
theorem segreRingHom_strHom (r : Γ(X, U)) :
    segreRingHom H G hU a b ((alg (tens H G)).strHom U r) = algebraMap Γ(X, U) _ r := by
  have h := Stacks.SymTwistChart.symSectionRingEquiv_symm_algebraMap (tens H G)
    (Stacks.SymGraded.isQuasicoherentPieces_of_isQuasicoherent (tens H G)) hU r
  rw [← h]
  simp only [segreRingHom, RingHom.coe_comp, Function.comp_apply, RingEquiv.toRingHom_eq_coe,
    RingEquiv.coe_toRingHom, RingEquiv.apply_symm_apply, AlgHom.toRingHom_eq_coe,
    AlgHom.coe_toRingHom, AlgHom.commutes]

/-- The degree-one element `h ⊗ g` of `Γ(U, Sym(H ⊗ G))`. -/
def deg1Tensor (h : Γ(H, U)) (g : Γ(G, U)) : (alg (tens H G)).sectionRing U :=
  deg1 (tens H G) hU (Stacks.SectionTensorFormula.tensorSection H G h g)

/-- The element `deg1Tensor H G hU h g` is homogeneous of degree one. -/
theorem deg1Tensor_mem (h : Γ(H, U)) (g : Γ(G, U)) :
    deg1Tensor H G hU h g ∈ (alg (tens H G)).grading U 1 := deg1_mem _ hU _

/-- The Segre ring map sends `h ⊗ g` to `(h / a) ⊗ (g / b)`. -/
theorem segreRingHom_deg1Tensor (h : Γ(H, U)) (g : Γ(G, U)) :
    segreRingHom H G hU a b (deg1Tensor H G hU h g) = ratioOf H hU a h ⊗ₜ ratioOf G hU b g := by
  rw [deg1Tensor, segreRingHom_deg1, segreLin_tensorSection]

omit [H.IsQuasicoherent] [G.IsQuasicoherent] in
/-- A degree-one element of `Γ(U, Sym E)` is the degree-one element of a section of `E`. -/
theorem exists_deg1_eq (E : X.Modules) [E.IsQuasicoherent] (x : (alg E).grading U 1) :
    ∃ h : Γ(E, U), deg1 E hU h = x := by
  have hx := (Stacks.SymGraded.AffinePieces.mem_symmetricPower_symSectionRingEquiv E hU _ 1
    (x : (alg E).sectionRing U)).mpr x.2
  rw [symmetricPower_one_eq_range] at hx
  obtain ⟨h, hh⟩ := hx
  refine ⟨h, ?_⟩
  rw [deg1, hh, RingEquiv.symm_apply_apply]

omit [H.IsQuasicoherent] [G.IsQuasicoherent] in
/-- A section of `E` over `U` whose degree-one element is a given degree-one element. -/
def secOf (E : X.Modules) [E.IsQuasicoherent] (x : (alg E).grading U 1) : Γ(E, U) :=
  (exists_deg1_eq hU E x).choose

omit [H.IsQuasicoherent] [G.IsQuasicoherent] in
/-- The degree-one element of `secOf hU E x` is `x`. -/
theorem deg1_secOf (E : X.Modules) [E.IsQuasicoherent] (x : (alg E).grading U 1) :
    deg1 E hU (secOf hU E x) = x :=
  (exists_deg1_eq hU E x).choose_spec

omit [H.IsQuasicoherent] [G.IsQuasicoherent] in
/-- The ratio of `secOf hU E x` by `x` is `1`. -/
theorem ratioOf_secOf (E : X.Modules) [E.IsQuasicoherent] (x : (alg E).grading U 1) :
    ratioOf E hU x (secOf hU E x) = 1 := by
  have : deg1' E hU (secOf hU E x) = x := Subtype.ext (deg1_secOf hU E x)
  rw [ratioOf, this, ratio_self]

/-- The degree-one element `a ⊗ b` of `Γ(U, Sym(H ⊗ G))`, at which the Segre ring map takes the
value `1`. -/
def unitElt : (alg (tens H G)).sectionRing U :=
  deg1Tensor H G hU (secOf hU H a) (secOf hU G b)

/-- The element `unitElt H G hU a b` is homogeneous of degree one. -/
theorem unitElt_mem : unitElt H G hU a b ∈ (alg (tens H G)).grading U 1 :=
  deg1Tensor_mem _ _ _ _ _

/-- The Segre ring map sends `a ⊗ b` to `1`. -/
theorem segreRingHom_unitElt : segreRingHom H G hU a b (unitElt H G hU a b) = 1 := by
  rw [unitElt, segreRingHom_deg1Tensor, ratioOf_secOf, ratioOf_secOf]
  rfl

/-- The Segre ring map, into the global sections of the spectrum of the piece. -/
def segreΓ : (alg (tens H G)).sectionRing U →+*
    Γ(Spec (CommRingCat.of (pieceRing H G a b)), ⊤) :=
  (Scheme.ΓSpecIso (CommRingCat.of (pieceRing H G a b))).inv.hom.comp (segreRingHom H G hU a b)

/-- The map `segreΓ` sends `a ⊗ b` to `1`. -/
theorem segreΓ_unitElt : segreΓ H G hU a b (unitElt H G hU a b) = 1 := by
  rw [segreΓ, RingHom.comp_apply, segreRingHom_unitElt, map_one]

/-- The image under `segreΓ` of the irrelevant ideal of `Γ(U, Sym(H ⊗ G))` generates the unit
ideal. -/
theorem map_irrelevant_segreΓ :
    (HomogeneousIdeal.irrelevant ((alg (tens H G)).grading U)).toIdeal.map
      (segreΓ H G hU a b) = ⊤ := by
  refine Ideal.eq_top_of_isUnit_mem _ ?_ (isUnit_one)
  rw [← segreΓ_unitElt H G hU a b]
  exact Ideal.mem_map_of_mem _ (HomogeneousIdeal.mem_irrelevant_of_mem _ Nat.one_pos
    (unitElt_mem H G hU a b))

/-- **The Segre morphism on a piece**: `D₊(a) ×_U D₊(b) ⟶ 𝐏(tens H G)`, the morphism of the Segre
ring map followed by the chart of `𝐏(tens H G)` over `U`. -/
def pieceSegre : Spec (CommRingCat.of (pieceRing H G a b)) ⟶ (bun (tens H G)).scheme :=
  Proj.fromOfGlobalSections ((alg (tens H G)).grading U) (segreΓ H G hU a b)
      (map_irrelevant_segreΓ H G hU a b) ≫
    (bun (tens H G)).chart U hU

end Segre

end Stacks.RelativeSegre

end
