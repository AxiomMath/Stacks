module

public import StacksFrontier.AlgebraicGeometry.Flatness.SubschemeFinitePresentation
public import StacksFrontier.AlgebraicGeometry.TwoGeneratorSquare
public import StacksFrontier.AlgebraicGeometry.Blowup.ProjRegrading

/-!
# The exceptional fibre of the two-generator almost blowup square

For `f₁, f₂` in a commutative ring `A`, the upper-right corner of the two-generator square of
`StacksFrontier/AlgebraicGeometry/TwoGeneratorSquare.lean` is
`Proj (A[T₀,T₁]/(f₂T₀-f₁T₁))` over `Spec A` and its upper-left corner is
`Proj ((A/(f₁,f₂))[T₀,T₁])` over `Spec (A/(f₁,f₂))`. This file proves that the square is
cartesian, and that its center is a closed subscheme of finite presentation.

## Main results

* `Stacks.AlmostBlowUp.twoGenerator_isPullback`: the square is cartesian. It is the base-change
  square of `Proj` along `A → A/(f₁,f₂)`, because the relation `f₂T₀-f₁T₁` dies in
  `(A/(f₁,f₂))[T₀,T₁]`.
* `Stacks.AlmostBlowUp.finitePresentation_centerIdealSheaf_subschemeι`: the center is a closed
  subscheme of finite presentation, being cut out by an ideal generated by two elements.

## Implementation notes

`Stacks.ProjBaseChange.isPullback_map_of_baseChange` states that `Proj` commutes with base change
for a grading of a commutative ring by a family of *submodules*, while
`Stacks.AlmostBlowUp.modificationGrading` is a family of *additive subgroups*. The two spellings
are compared by `StacksFrontier/AlgebraicGeometry/Blowup/ProjRegrading.lean`, and the cartesian
square is transported along the resulting isomorphism of projective spectra.

The comparison of the base change `(A/(f₁,f₂)) ⊗_A A[T₀,T₁]/(f₂T₀-f₁T₁)` with
`(A/(f₁,f₂))[T₀,T₁]` is built from `AlgHom.liftEquiv` in one direction and `MvPolynomial.aeval`
in the other, so that both inverse identities are checked on algebra generators.

## References

* [Stacks Project, Tag 0EVH](https://stacks.math.columbia.edu/tag/0EVH)
-/

@[expose] public noncomputable section

open CategoryTheory Limits AlgebraicGeometry TensorProduct HomogeneousIdeal CommRingCat

universe u

namespace Stacks.AlmostBlowUp

attribute [local instance] MvPolynomial.gradedAlgebra

variable (A : Type u) [CommRing A] (f₁ f₂ : A)

/-! ### The modification grading as a family of submodules -/

/-- The grading of `A[T₀,T₁]/(f₂T₀-f₁T₁)` by the degreewise images of the polynomial grading,
written as a family of `A`-submodules rather than of additive subgroups. -/
abbrev modificationSubmoduleGrading : ℕ → Submodule A (modificationRing A f₁ f₂) := fun d ↦
  Submodule.map (Ideal.Quotient.mkₐ A (relationIdeal A f₁ f₂)).toLinearMap
    (MvPolynomial.homogeneousSubmodule (Fin 2) A d)

/-- The submodule grading and the additive-subgroup grading of `A[T₀,T₁]/(f₂T₀-f₁T₁)` have the
same carriers. -/
theorem coe_modificationSubmoduleGrading (d : ℕ) :
    ((modificationGrading A f₁ f₂ d : AddSubgroup (modificationRing A f₁ f₂)) :
        Set (modificationRing A f₁ f₂)) = modificationSubmoduleGrading A f₁ f₂ d := by
  rw [AddSubgroup.coe_map, Submodule.map_coe]
  rfl

/-- The grading of `A[T₀,T₁]/(f₂T₀-f₁T₁)` by submodules, which is the form in which the base
change of `Proj` is stated. -/
@[instance_reducible]
def modificationSubmoduleGraded : GradedAlgebra (modificationSubmoduleGrading A f₁ f₂) :=
  letI := modificationGradedRing A f₁ f₂
  Stacks.GradedRegrading.gradedRing (coe_modificationSubmoduleGrading A f₁ f₂)

attribute [local instance] modificationSubmoduleGraded

/-! ### The base change of the modification ring -/

/-- The reduction map `A[T₀,T₁]/(f₂T₀-f₁T₁) → (A/(f₁,f₂))[T₀,T₁]`, as a homomorphism of
`A`-algebras. -/
def exceptionalAlgHom :
    modificationRing A f₁ f₂ →ₐ[A] MvPolynomial (Fin 2) (centerRing A f₁ f₂) where
  __ := exceptionalRingHom A f₁ f₂
  commutes' a := by
    change exceptionalRingHom A f₁ f₂
      (Ideal.Quotient.mk (relationIdeal A f₁ f₂) (MvPolynomial.C a)) = _
    rw [exceptionalRingHom_mk, MvPolynomial.map_C]
    simp

/-- The reduction map as an `A`-algebra homomorphism agrees with the underlying ring
homomorphism. -/
@[simp]
theorem exceptionalAlgHom_apply (x : modificationRing A f₁ f₂) :
    exceptionalAlgHom A f₁ f₂ x = exceptionalRingHom A f₁ f₂ x := rfl

/-- The comparison `(A/(f₁,f₂)) ⊗_A A[T₀,T₁]/(f₂T₀-f₁T₁) → (A/(f₁,f₂))[T₀,T₁]`, which is the
reduction map extended to the base change by scalars. -/
def exceptionalTensorHom :
    centerRing A f₁ f₂ ⊗[A] modificationRing A f₁ f₂ →ₐ[centerRing A f₁ f₂]
      MvPolynomial (Fin 2) (centerRing A f₁ f₂) :=
  AlgHom.liftEquiv A (centerRing A f₁ f₂) (modificationRing A f₁ f₂)
    (MvPolynomial (Fin 2) (centerRing A f₁ f₂)) (exceptionalAlgHom A f₁ f₂)

/-- The comparison sends `1 ⊗ [p]`, for a polynomial `p` over `A`, to the reduction of `p` modulo
`(f₁,f₂)`. -/
@[simp]
theorem exceptionalTensorHom_tmul_one (p : MvPolynomial (Fin 2) A) :
    exceptionalTensorHom A f₁ f₂ (1 ⊗ₜ[A] Ideal.Quotient.mk (relationIdeal A f₁ f₂) p) =
      MvPolynomial.map (Ideal.Quotient.mk (centerIdeal A f₁ f₂)) p := by
  rw [exceptionalTensorHom, AlgHom.liftEquiv_tmul, one_smul, exceptionalAlgHom_apply,
    exceptionalRingHom_mk]

/-- The comparison in the other direction, sending the coordinate `Tᵢ` of `(A/(f₁,f₂))[T₀,T₁]`
to `1 ⊗ Tᵢ`. -/
def tensorExceptionalHom :
    MvPolynomial (Fin 2) (centerRing A f₁ f₂) →ₐ[centerRing A f₁ f₂]
      centerRing A f₁ f₂ ⊗[A] modificationRing A f₁ f₂ :=
  MvPolynomial.aeval fun i ↦ (1 : centerRing A f₁ f₂) ⊗ₜ[A]
    Ideal.Quotient.mk (relationIdeal A f₁ f₂) (MvPolynomial.X i)

/-- The backward comparison undoes the reduction of coefficients: a polynomial over `A` read in
`(A/(f₁,f₂))[T₀,T₁]` goes back to its own class tensored with the unit. -/
theorem tensorExceptionalHom_map (p : MvPolynomial (Fin 2) A) :
    tensorExceptionalHom A f₁ f₂
        (MvPolynomial.map (Ideal.Quotient.mk (centerIdeal A f₁ f₂)) p) =
      1 ⊗ₜ[A] Ideal.Quotient.mk (relationIdeal A f₁ f₂) p := by
  induction p using MvPolynomial.induction_on with
  | C a =>
      rw [MvPolynomial.map_C, tensorExceptionalHom, MvPolynomial.aeval_C,
        show Ideal.Quotient.mk (centerIdeal A f₁ f₂) a = algebraMap A (centerRing A f₁ f₂) a from
          rfl, ← IsScalarTower.algebraMap_apply A (centerRing A f₁ f₂) _,
        Algebra.TensorProduct.algebraMap_apply']
      rfl
  | add p q hp hq => rw [map_add, map_add, hp, hq, ← TensorProduct.tmul_add, ← map_add]
  | mul_X p n hp =>
      rw [map_mul, map_mul, hp, MvPolynomial.map_X, tensorExceptionalHom,
        MvPolynomial.aeval_X, Algebra.TensorProduct.tmul_mul_tmul, one_mul, ← map_mul]

/-- The backward comparison sends a monomial to the tensor of its coefficient with the class of
the same monomial over `A`. -/
theorem tensorExceptionalHom_monomial (m : Fin 2 →₀ ℕ) (c : centerRing A f₁ f₂) :
    tensorExceptionalHom A f₁ f₂ (MvPolynomial.monomial m c) =
      c ⊗ₜ[A] Ideal.Quotient.mk (relationIdeal A f₁ f₂) (MvPolynomial.monomial m 1) := by
  have hC : tensorExceptionalHom A f₁ f₂ (MvPolynomial.C c) = c ⊗ₜ[A] 1 := by
    rw [tensorExceptionalHom, MvPolynomial.aeval_C, Algebra.TensorProduct.algebraMap_apply]
    simp
  have hmon : (MvPolynomial.monomial m c : MvPolynomial (Fin 2) (centerRing A f₁ f₂)) =
      MvPolynomial.C c * MvPolynomial.monomial m 1 := by
    rw [MvPolynomial.C_mul_monomial, mul_one]
  have hmap : (MvPolynomial.monomial m (1 : centerRing A f₁ f₂)) =
      MvPolynomial.map (Ideal.Quotient.mk (centerIdeal A f₁ f₂)) (MvPolynomial.monomial m 1) := by
    rw [MvPolynomial.map_monomial]
    simp
  rw [hmon, map_mul, hC, hmap, tensorExceptionalHom_map,
    Algebra.TensorProduct.tmul_mul_tmul, mul_one, one_mul]

/-! ### The graded comparison -/

/-- The reduction map `A[T₀,T₁]/(f₂T₀-f₁T₁) → (A/(f₁,f₂))[T₀,T₁]`, read as a homomorphism out of
the submodule grading of the modification ring. -/
def exceptionalSubmoduleGradedHom :
    modificationSubmoduleGrading A f₁ f₂ →+*ᵍ exceptionalGrading A f₁ f₂ where
  __ := exceptionalRingHom A f₁ f₂
  map_mem := by
    intro d x hx
    obtain ⟨p, hp, rfl⟩ := Submodule.mem_map.mp hx
    exact map_mem_homogeneousSubmodule (Ideal.Quotient.mk (centerIdeal A f₁ f₂)) hp

/-- The comparison of the base change with `(A/(f₁,f₂))[T₀,T₁]` preserves degrees. -/
theorem exceptionalTensorHom_mem (d : ℕ)
    {x : centerRing A f₁ f₂ ⊗[A] modificationRing A f₁ f₂}
    (hx : x ∈ Stacks.ProjBaseChange.grading (modificationSubmoduleGrading A f₁ f₂)
      (centerRing A f₁ f₂) d) :
    exceptionalTensorHom A f₁ f₂ x ∈ exceptionalGrading A f₁ f₂ d := by
  replace hx : x ∈ (modificationSubmoduleGrading A f₁ f₂ d).baseChange (centerRing A f₁ f₂) := hx
  rw [Submodule.baseChange_eq_span] at hx
  induction hx using Submodule.span_induction with
  | mem y hy =>
      obtain ⟨z, hz, rfl⟩ := hy
      simp only [mk_apply, exceptionalTensorHom, AlgHom.liftEquiv_tmul, one_smul,
        exceptionalAlgHom_apply]
      exact (exceptionalSubmoduleGradedHom A f₁ f₂).map_mem hz
  | zero => rw [map_zero]; exact zero_mem _
  | add y z _ _ ihy ihz => rw [map_add]; exact add_mem ihy ihz
  | smul s y _ ih => rw [map_smul]; exact Submodule.smul_mem _ s ih

/-- The backward comparison preserves degrees. -/
theorem tensorExceptionalHom_mem (d : ℕ) {q : MvPolynomial (Fin 2) (centerRing A f₁ f₂)}
    (hq : q ∈ exceptionalGrading A f₁ f₂ d) :
    tensorExceptionalHom A f₁ f₂ q ∈
      Stacks.ProjBaseChange.grading (modificationSubmoduleGrading A f₁ f₂)
        (centerRing A f₁ f₂) d := by
  have hsum : tensorExceptionalHom A f₁ f₂ q = ∑ m ∈ q.support,
      tensorExceptionalHom A f₁ f₂ (MvPolynomial.monomial m (q.coeff m)) := by
    rw [← map_sum, ← MvPolynomial.as_sum]
  rw [hsum]
  refine Submodule.sum_mem _ fun m hm ↦ ?_
  have hdeg : m.degree = d := by
    rw [Finsupp.degree_eq_weight_one]
    exact hq (MvPolynomial.mem_support_iff.mp hm)
  rw [tensorExceptionalHom_monomial]
  exact Submodule.tmul_mem_baseChange_of_mem _
    (Submodule.mem_map_of_mem (MvPolynomial.isHomogeneous_monomial 1 hdeg))

/-- The backward comparison is a left inverse of the comparison. -/
theorem tensorExceptionalHom_exceptionalTensorHom
    (x : centerRing A f₁ f₂ ⊗[A] modificationRing A f₁ f₂) :
    tensorExceptionalHom A f₁ f₂ (exceptionalTensorHom A f₁ f₂ x) = x := by
  have key : (tensorExceptionalHom A f₁ f₂).comp (exceptionalTensorHom A f₁ f₂) =
      AlgHom.id (centerRing A f₁ f₂) _ := by
    refine Algebra.TensorProduct.ext_ring (AlgHom.ext fun b ↦ ?_)
    obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective b
    change tensorExceptionalHom A f₁ f₂ (exceptionalTensorHom A f₁ f₂ (1 ⊗ₜ[A] _)) = _
    rw [exceptionalTensorHom_tmul_one, tensorExceptionalHom_map]
    rfl
  exact congr($key x)

/-- The comparison is a left inverse of the backward comparison. -/
theorem exceptionalTensorHom_tensorExceptionalHom
    (q : MvPolynomial (Fin 2) (centerRing A f₁ f₂)) :
    exceptionalTensorHom A f₁ f₂ (tensorExceptionalHom A f₁ f₂ q) = q := by
  have key : (exceptionalTensorHom A f₁ f₂).comp (tensorExceptionalHom A f₁ f₂) =
      AlgHom.id (centerRing A f₁ f₂) _ := by
    refine MvPolynomial.algHom_ext fun i ↦ ?_
    change exceptionalTensorHom A f₁ f₂ (tensorExceptionalHom A f₁ f₂ (MvPolynomial.X i)) = _
    rw [tensorExceptionalHom, MvPolynomial.aeval_X, exceptionalTensorHom_tmul_one,
      MvPolynomial.map_X]
    rfl
  exact congr($key q)

/-- The comparison of the base change with `(A/(f₁,f₂))[T₀,T₁]`, as a homomorphism of graded
rings. -/
def exceptionalTensorGradedHom :
    Stacks.ProjBaseChange.grading (modificationSubmoduleGrading A f₁ f₂) (centerRing A f₁ f₂)
      →+*ᵍ exceptionalGrading A f₁ f₂ where
  __ := (exceptionalTensorHom A f₁ f₂).toRingHom
  map_mem := exceptionalTensorHom_mem A f₁ f₂ _

/-- The backward comparison, as a homomorphism of graded rings. -/
def tensorExceptionalGradedHom :
    exceptionalGrading A f₁ f₂ →+*ᵍ
      Stacks.ProjBaseChange.grading (modificationSubmoduleGrading A f₁ f₂)
        (centerRing A f₁ f₂) where
  __ := (tensorExceptionalHom A f₁ f₂).toRingHom
  map_mem := tensorExceptionalHom_mem A f₁ f₂ _

/-- The backward graded comparison is a left inverse of the graded comparison. -/
theorem tensorExceptionalGradedHom_comp :
    (tensorExceptionalGradedHom A f₁ f₂).comp (exceptionalTensorGradedHom A f₁ f₂) =
      GradedRingHom.id _ :=
  GradedRingHom.ext (tensorExceptionalHom_exceptionalTensorHom A f₁ f₂)

/-- The graded comparison is a left inverse of the backward graded comparison. -/
theorem exceptionalTensorGradedHom_comp :
    (exceptionalTensorGradedHom A f₁ f₂).comp (tensorExceptionalGradedHom A f₁ f₂) =
      GradedRingHom.id _ :=
  GradedRingHom.ext (exceptionalTensorHom_tensorExceptionalHom A f₁ f₂)

/-- The reduction map factors as the base change along `A → A/(f₁,f₂)` followed by the comparison
isomorphism. -/
theorem exceptionalSubmoduleGradedHom_eq :
    exceptionalSubmoduleGradedHom A f₁ f₂ = (exceptionalTensorGradedHom A f₁ f₂).comp
      (Stacks.ProjBaseChange.includeRight (modificationSubmoduleGrading A f₁ f₂)
        (centerRing A f₁ f₂)) := by
  refine GradedRingHom.ext fun b ↦ ?_
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective b
  exact (exceptionalTensorHom_tmul_one A f₁ f₂ p).symm

/-- The reduction map is surjective in every degree, so it satisfies the irrelevant-ideal
hypothesis of `AlgebraicGeometry.Proj.map` out of the submodule grading. -/
theorem irrelevant_le_map_exceptionalSubmoduleGradedHom :
    (exceptionalGrading A f₁ f₂)₊ ≤ (modificationSubmoduleGrading A f₁ f₂)₊.map
      (exceptionalSubmoduleGradedHom A f₁ f₂) := by
  rw [HomogeneousIdeal.irrelevant_le]
  intro i hi x hx
  obtain ⟨a, ha⟩ := exceptionalGradedHom_gradedAddHom_surjective A f₁ f₂ i ⟨x, hx⟩
  have hax : exceptionalSubmoduleGradedHom A f₁ f₂ (a : modificationRing A f₁ f₂) = x :=
    congrArg Subtype.val ha
  have ha' : (a : modificationRing A f₁ f₂) ∈ modificationSubmoduleGrading A f₁ f₂ i :=
    (Stacks.GradedRegrading.mem_congr (coe_modificationSubmoduleGrading A f₁ f₂)).mp a.2
  exact hax ▸ Ideal.mem_map_of_mem _ (mem_irrelevant_of_mem _ hi ha')

/-- On degree-zero parts, the comparison isomorphism carries the structure map of the base change
to the coefficient map `A/(f₁,f₂) → (A/(f₁,f₂))[T₀,T₁]`. -/
theorem gradedZeroRingHom_exceptionalTensorGradedHom_comp :
    (exceptionalTensorGradedHom A f₁ f₂).gradedZeroRingHom.comp
        (algebraMap (centerRing A f₁ f₂)
          ↥(Stacks.ProjBaseChange.grading (modificationSubmoduleGrading A f₁ f₂)
            (centerRing A f₁ f₂) 0)) =
      centerRingHom A f₁ f₂ := by
  refine RingHom.ext fun s ↦ Subtype.ext ?_
  change exceptionalTensorHom A f₁ f₂
    (algebraMap (centerRing A f₁ f₂) (centerRing A f₁ f₂ ⊗[A] modificationRing A f₁ f₂) s) =
      MvPolynomial.C s
  rw [AlgHom.commutes]
  rfl

/-- The left edge of the base-change square is the canonical morphism of the exceptional
projective line to the center. -/
theorem exceptionalToCenter_eq (he : _) :
    Proj.map (exceptionalTensorGradedHom A f₁ f₂) he ≫
        Proj.toSpecZero (Stacks.ProjBaseChange.grading (modificationSubmoduleGrading A f₁ f₂)
            (centerRing A f₁ f₂)) ≫
          Spec.map (ofHom (algebraMap (centerRing A f₁ f₂)
            ↥(Stacks.ProjBaseChange.grading (modificationSubmoduleGrading A f₁ f₂)
              (centerRing A f₁ f₂) 0))) =
      Proj.toSpecZero (exceptionalGrading A f₁ f₂) ≫
        Spec.map (ofHom (centerRingHom A f₁ f₂)) := by
  rw [← Category.assoc, Proj.map_toSpecZero, Category.assoc, ← Spec.map_comp, ← ofHom_comp,
    gradedZeroRingHom_exceptionalTensorGradedHom_comp]

/-! ### The square is cartesian -/

section Graded

variable [GradedRing (modificationGrading A f₁ f₂)]

/-- On degree-zero parts, the comparison of the two spellings of the modification grading carries
the coefficient map `A → A[T₀,T₁]/(f₂T₀-f₁T₁)` to the structure map of the submodule grading. -/
theorem gradedZeroRingHom_regrade_comp_baseRingHom :
    (Stacks.GradedRegrading.regrade
          (coe_modificationSubmoduleGrading A f₁ f₂)).gradedZeroRingHom.comp
        (baseRingHom A f₁ f₂) =
      algebraMap A ↥(modificationSubmoduleGrading A f₁ f₂ 0) :=
  RingHom.ext fun _ ↦ Subtype.ext rfl

/-- The top edge of the base-change square, followed by the comparison of the two spellings of
the modification grading, is the canonical morphism of the exceptional projective line into the
projective hypersurface. -/
theorem projMap_comp_projIso_hom :
    Proj.map (exceptionalSubmoduleGradedHom A f₁ f₂)
          (irrelevant_le_map_exceptionalSubmoduleGradedHom A f₁ f₂) ≫
        (Stacks.GradedRegrading.projIso (coe_modificationSubmoduleGrading A f₁ f₂)).hom =
      Proj.map (exceptionalGradedHom A f₁ f₂) (irrelevant_le_map A f₁ f₂) := by
  rw [Stacks.GradedRegrading.projIso_hom,
    ← Proj.map_comp (Stacks.GradedRegrading.regrade (coe_modificationSubmoduleGrading A f₁ f₂))
      (exceptionalSubmoduleGradedHom A f₁ f₂) _ _]
  exact Proj.map_congr (GradedRingHom.ext fun _ ↦ rfl) _ _

/-- The right edge of the base-change square, read through the comparison of the two spellings of
the modification grading, is the morphism of the projective hypersurface to `Spec A`. -/
theorem projIso_hom_comp_modificationToBase :
    Proj.toSpecZero (modificationSubmoduleGrading A f₁ f₂) ≫
        Spec.map (ofHom (algebraMap A ↥(modificationSubmoduleGrading A f₁ f₂ 0))) =
      (Stacks.GradedRegrading.projIso (coe_modificationSubmoduleGrading A f₁ f₂)).hom ≫
        (Proj.toSpecZero (modificationGrading A f₁ f₂) ≫
          Spec.map (ofHom (baseRingHom A f₁ f₂))) := by
  rw [← Category.assoc, Stacks.GradedRegrading.projIso_hom_comp_toSpecZero, Category.assoc,
    ← Spec.map_comp, ← ofHom_comp, gradedZeroRingHom_regrade_comp_baseRingHom]

end Graded

/-- **The displayed square has the stated exceptional fibre.** The upper-left corner
`Proj ((A/(f₁,f₂))[T₀,T₁])` is the fibre product of `Proj (A[T₀,T₁]/(f₂T₀-f₁T₁))` with the center
`Spec (A/(f₁,f₂))` over `Spec A`: the relation `f₂T₀-f₁T₁` is annihilated by the reduction, so the
base change of the modification ring along `A → A/(f₁,f₂)` is the polynomial ring
`(A/(f₁,f₂))[T₀,T₁]`, and `Proj` commutes with base change. -/
theorem twoGenerator_isPullback :
    letI := (twoGeneratorSquare A f₁ f₂).modificationGraded
    IsPullback (exceptionalToModification A f₁ f₂)
      (exceptionalToCenter A f₁ f₂)
      (modificationToBase A f₁ f₂) (centerToBase A f₁ f₂) := by
  let := (twoGeneratorSquare A f₁ f₂).modificationGraded
  have he := Stacks.GradedRegrading.irrelevant_le_map_of_comp_eq_id
    (exceptionalTensorGradedHom_comp A f₁ f₂)
  have he' := Stacks.GradedRegrading.irrelevant_le_map_of_comp_eq_id
    (tensorExceptionalGradedHom_comp A f₁ f₂)
  refine (Stacks.ProjBaseChange.isPullback_map_of_baseChange
    (modificationSubmoduleGrading A f₁ f₂) (centerRing A f₁ f₂)
    (irrelevant_le_map_exceptionalSubmoduleGradedHom A f₁ f₂) he he'
    (tensorExceptionalGradedHom_comp A f₁ f₂) (exceptionalTensorGradedHom_comp A f₁ f₂)
    (exceptionalSubmoduleGradedHom_eq A f₁ f₂)).of_iso (Iso.refl _)
      (Stacks.GradedRegrading.projIso (coe_modificationSubmoduleGrading A f₁ f₂))
      (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
  · simp only [Iso.refl_hom, Category.id_comp]
    exact projMap_comp_projIso_hom A f₁ f₂
  · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
    exact exceptionalToCenter_eq A f₁ f₂ he
  · simp only [Iso.refl_hom, Category.comp_id]
    exact projIso_hom_comp_modificationToBase A f₁ f₂
  · simp only [Iso.refl_hom, Category.comp_id, Category.id_comp]
    rfl

/-! ### The center is of finite presentation -/

/-- **The center of the two-generator square is a closed subscheme of finite presentation.** It
is cut out by the ideal generated by `f₁` and `f₂`, which is finitely generated, and so is its
image in the sections over any affine open. This is the first of the five conditions of
`AlgebraicGeometry.IsAlmostBlowUpSquare` for the square. -/
theorem finitePresentation_centerIdealSheaf_subschemeι :
    FinitePresentation (centerIdealSheaf A f₁ f₂).subschemeι := by
  have hfg : (centerIdeal A f₁ f₂).FG := Submodule.fg_span (Set.toFinite ({f₁, f₂} : Set A))
  refine (Stacks.Flatness.finitePresentation_subschemeι_iff _).mpr fun U ↦ ?_
  rw [centerIdealSheaf, Scheme.IdealSheafData.ofIdealTop_ideal]
  exact (hfg.map _).map _

end Stacks.AlmostBlowUp

end
