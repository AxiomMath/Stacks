-/

@[expose] public noncomputable section

open CategoryTheory Limits AlgebraicGeometry Opposite DirectSum

universe u

namespace AlgebraicGeometry

/-- The map to the base inverts the canonical map from the sections of the structure sheaf: a
function `r` becomes the degree-zero section `r · 1`, whose affine identification is `r`. -/
theorem reesToBase_sectionRingBaseMap {X : Scheme.{u}} (I : X.IdealSheafData)
    (U : X.affineOpens) (r : X.ringCatSheaf.obj.obj (op U.1)) :
    reesToBase I U ((reesSituation I).sectionRingBaseMap U.1 r) =
      (show X.presheaf.obj (op U.1) from r) := by
  let P := (reesAlgebraData I).algebra.piece 0
  let M := P.val.obj (op U.1)
  let : Module (X.ringCatSheaf.obj.obj (op U.1)) M := M.isModule
  rw [show (reesSituation I).sectionRingBaseMap U.1 r =
      DirectSum.of ((reesSituation I).sectionPieces U.1) 0
        (r • (reesSituation I).algebra.one.eval (op U.1)) from
    (Stacks.RelativeProj.Situation.sectionRingStructure (reesSituation I)).baseMap_apply U.1 r,
    reesToBase_of]
  change ((reesAlgebraData I).pieceEquiv (0 : ℤ) (by omega) U
    (r • (reesAlgebraData I).algebra.one.eval (op U.1)) : X.presheaf.obj (.op U.1)) = _
  rw [(reesAlgebraData I).pieceEquiv_smul, (reesAlgebraData I).pieceEquiv_one, mul_one]

/-- **Scheme-theoretic density is inherited by the inverse image along an open immersion.** An
open subscheme of the source is, up to the canonical isomorphism with its image, an open
subscheme of the target, and scheme-theoretic dominance is stable under composition with
isomorphisms.

This is the ingredient that turns Stacks tag 07ZU — the complement of an effective Cartier
divisor is scheme-theoretically dense — into the form
`Stacks.Blowup.exists_hom_of_isOpenCover` consumes, where the density is needed on every
member of an open cover of the source rather than on the source itself. -/
theorem Scheme.Opens.isSchemeTheoreticallyDense_preimage_of_isOpenImmersion
    {Y Z : Scheme.{u}} (U : Y.Opens) (hU : Scheme.Opens.IsSchemeTheoreticallyDense U)
    (q : Z ⟶ Y) [IsOpenImmersion q] :
    Scheme.Opens.IsSchemeTheoreticallyDense (q ⁻¹ᵁ U) := by
  intro V
  have hdom : IsSchemeTheoreticallyDominant ((q ''ᵁ V).ι ⁻¹ᵁ U).ι := hU (q ''ᵁ V)
  have hpre : V.ι ⁻¹ᵁ (q ⁻¹ᵁ U) = (q.isoImage V).hom ⁻¹ᵁ ((q ''ᵁ V).ι ⁻¹ᵁ U) := by
    change (V.ι ≫ q) ⁻¹ᵁ U = ((q.isoImage V).hom ≫ (q ''ᵁ V).ι) ⁻¹ᵁ U
    rw [Scheme.Hom.isoImage_hom_ι]
  rw [hpre]
  have hrestr : ((q.isoImage V).hom ⁻¹ᵁ ((q ''ᵁ V).ι ⁻¹ᵁ U)).ι =
      ((q.isoImage V).hom ∣_ ((q ''ᵁ V).ι ⁻¹ᵁ U)) ≫ ((q ''ᵁ V).ι ⁻¹ᵁ U).ι ≫
        (q.isoImage V).inv := by
    rw [← Category.assoc, morphismRestrict_ι, Category.assoc, Iso.hom_inv_id, Category.comp_id]
  rw [hrestr]
  infer_instance

end AlgebraicGeometry

namespace Stacks.RelativeProj.Situation

variable (s : Situation.{u}) (U : s.base.affineOpens) {W : Scheme.{u}}

/-- The degree-zero part of a ring map out of the graded ring of local sections is the ring map
`Γ(S, U) ⟶ Γ(W, ⊤)` obtained by precomposing with
`Stacks.RelativeProj.Situation.sectionRingBaseMap`. -/
theorem sectionRingZeroMap_comp_ofHom (w : W ⟶ U.1.toScheme)
    (ψ : s.sectionRing U.1 →+* Γ(W, ⊤))
    (hzero : ∀ r, ψ (s.sectionRingBaseMap U.1 r) =
      Stacks.Blowup.specHomRingHom (w ≫ U.2.isoSpec.hom) r) :
    s.sectionRingZeroMap U.1 ≫
        CommRingCat.ofHom
          (ψ.comp (algebraMap (↥(s.sectionRingGrading U.1 0)) (s.sectionRing U.1))) =
      CommRingCat.ofHom (Stacks.Blowup.specHomRingHom (w ≫ U.2.isoSpec.hom)) := by
  apply CommRingCat.hom_ext
  apply RingHom.ext
  intro r
  change ψ (algebraMap (↥(s.sectionRingGrading U.1 0)) (s.sectionRing U.1)
    (GradedRing.projZeroRingHom' (s.sectionRingGrading U.1) (s.sectionRingBaseMap U.1 r))) = _
  rw [show GradedRing.projZeroRingHom' (s.sectionRingGrading U.1) (s.sectionRingBaseMap U.1 r) =
      ⟨s.sectionRingBaseMap U.1 r, sectionRingBaseMap_mem_zero s U.1 r⟩ from
    GradedRing.projZeroRingHom'_apply_coe _ ⟨_, sectionRingBaseMap_mem_zero s U.1 r⟩]
  exact hzero r

/-- The morphism into the chart built from a ring map is a morphism over the affine open: the
composite with the chart's structure morphism is the morphism the ring map came from. -/
theorem fromOfGlobalSections_comp_projInclusionToOpen (w : W ⟶ U.1.toScheme)
    (ψ : s.sectionRing U.1 →+* Γ(W, ⊤))
    (hψ : (HomogeneousIdeal.irrelevant (s.sectionRingGrading U.1)).toIdeal.map ψ = ⊤)
    (hzero : ∀ r, ψ (s.sectionRingBaseMap U.1 r) =
      Stacks.Blowup.specHomRingHom (w ≫ U.2.isoSpec.hom) r) :
    AlgebraicGeometry.Proj.fromOfGlobalSections (s.sectionRingGrading U.1) ψ hψ ≫
        projInclusionToOpen s U.1 U.2 = w := by
  have h1 : AlgebraicGeometry.Proj.fromOfGlobalSections (s.sectionRingGrading U.1) ψ hψ ≫
      AlgebraicGeometry.Proj.toSpecZero (s.sectionRingGrading U.1) ≫
        Spec.map (s.sectionRingZeroMap U.1) =
      W.toSpecΓ ≫
        Spec.map (CommRingCat.ofHom
          (Stacks.Blowup.specHomRingHom (w ≫ U.2.isoSpec.hom))) := by
    rw [← Category.assoc, AlgebraicGeometry.Proj.fromOfGlobalSections_toSpecZero,
      Category.assoc, ← Spec.map_comp, sectionRingZeroMap_comp_ofHom s U w ψ hzero]
  calc AlgebraicGeometry.Proj.fromOfGlobalSections (s.sectionRingGrading U.1) ψ hψ ≫
        projInclusionToOpen s U.1 U.2
      = (AlgebraicGeometry.Proj.fromOfGlobalSections (s.sectionRingGrading U.1) ψ hψ ≫
          AlgebraicGeometry.Proj.toSpecZero (s.sectionRingGrading U.1) ≫
            Spec.map (s.sectionRingZeroMap U.1)) ≫ U.2.isoSpec.inv := by
        simp only [projInclusionToOpen, Category.assoc]
    _ = (W.toSpecΓ ≫ Spec.map (CommRingCat.ofHom
          (Stacks.Blowup.specHomRingHom (w ≫ U.2.isoSpec.hom)))) ≫ U.2.isoSpec.inv := by
        rw [h1]
    _ = (w ≫ U.2.isoSpec.hom) ≫ U.2.isoSpec.inv := by
        rw [Stacks.Blowup.toSpecΓ_comp_specMap_specHomRingHom]
    _ = w := by simp

/-- **The mapping-in property of a relative `Proj` over an affine open of the base.** Let `s` be
a quasi-coherent nonnegatively graded algebra on a scheme and let `U` be an affine open of the
base. A morphism `w : W ⟶ U` and a ring map `ψ` from the graded ring of homogeneous sections
over `U` to the global sections of `W` which restricts in degree zero to the ring map of `w`,
and whose image of the irrelevant ideal is the unit ideal, define a morphism
`W ⟶ relativeProj s` over the base.

This is the piece of the universal property of relative `Proj` (Constructions, Section 01NS)
that the universal property of blowing up uses, with the twist of the source's triple
`(1, f, ψ)` taken to be trivial. -/
theorem exists_hom_relativeProj_of_sectionRingHom (w : W ⟶ U.1.toScheme)
    (ψ : s.sectionRing U.1 →+* Γ(W, ⊤))
    (hψ : (HomogeneousIdeal.irrelevant (s.sectionRingGrading U.1)).toIdeal.map ψ = ⊤)
    (hzero : ∀ r, ψ (s.sectionRingBaseMap U.1 r) =
      Stacks.Blowup.specHomRingHom (w ≫ U.2.isoSpec.hom) r) :
    ∃ g : W ⟶ relativeProj s, g ≫ relativeProjToBase s = w ≫ U.1.ι := by
  refine ⟨AlgebraicGeometry.Proj.fromOfGlobalSections (s.sectionRingGrading U.1) ψ hψ ≫
    relativeProjChart s U, ?_⟩
  rw [Category.assoc, (relativeProjChart_isPullback s U).w, ← Category.assoc,
    fromOfGlobalSections_comp_projInclusionToOpen s U w ψ hψ hzero]

end Stacks.RelativeProj.Situation

namespace Stacks.Blowup

/-- The ring map of a morphism into an affine open, in terms of `Scheme.Opens.topIso` and
`Scheme.Hom.appTop`. -/
theorem specHomRingHom_comp_isoSpec_hom {X : Scheme.{u}} {U : X.Opens} (hU : IsAffineOpen U)
    {W : Scheme.{u}} (w : W ⟶ U.toScheme) :
    specHomRingHom (w ≫ hU.isoSpec.hom) = (U.topIso.inv ≫ w.appTop).hom := by
  change (CommRingCat.Hom.hom ((Scheme.ΓSpecIso Γ(X, U)).inv ≫ (w ≫ hU.isoSpec.hom).appTop)) = _
  rw [Scheme.Hom.comp_appTop, hU.isoSpec_hom_appTop, ← Category.assoc, ← Category.assoc,
    Iso.inv_hom_id, Category.id_comp]

/-- **The inverse image of an ideal sheaf on a pair of affine charts**, in the spelling the
chart construction uses: if the affine open `V` of the source lies in the preimage of the affine
open `U` of the target, the ideal of `I` on `U` pushes along the ring map of
`Scheme.Hom.resLE` to the ideal of `I.comap f` on `V`, both read on the charts' global
sections. -/
theorem ideal_map_specHomRingHom_resLE {X Y : Scheme.{u}} (I : X.IdealSheafData) (f : Y ⟶ X)
    (U : X.affineOpens) (V : Y.affineOpens) (hVU : (V : Y.Opens) ≤ f ⁻¹ᵁ (U : X.Opens)) :
    (I.ideal U).map
        (specHomRingHom (f.resLE (U : X.Opens) (V : Y.Opens) hVU ≫ U.2.isoSpec.hom)) =
      ((I.comap f).ideal V).map (V : Y.Opens).topIso.inv.hom := by
  have hUaff : IsAffine (U : X.Opens).toScheme := U.2
  have hVaff : IsAffine (V : Y.Opens).toScheme := V.2
  have hbridge : specHomRingHom (f.resLE (U : X.Opens) (V : Y.Opens) hVU ≫ U.2.isoSpec.hom) =
      ((U : X.Opens).topIso.inv ≫ (f.resLE (U : X.Opens) (V : Y.Opens) hVU).appTop).hom :=
    specHomRingHom_comp_isoSpec_hom U.2 _
  rw [hbridge]
  set w := f.resLE (U : X.Opens) (V : Y.Opens) hVU with hw
  have hcomap : (I.comap (U : X.Opens).ι).comap w = (I.comap f).comap (V : Y.Opens).ι := by
    rw [← Scheme.IdealSheafData.comap_comp, ← Scheme.IdealSheafData.comap_comp, hw,
      Scheme.Hom.resLE_comp_ι]
  have h1 := Stacks.IdealSheaf.ideal_comap_top_of_isAffine (I.comap (U : X.Opens).ι) w
  have h2 := Stacks.IdealSheaf.ideal_comap_ι_top I U.2 (isAffineOpen_top (U : X.Opens).toScheme)
  have h3 := Stacks.IdealSheaf.ideal_comap_ι_top (I.comap f) V.2
    (isAffineOpen_top (V : Y.Opens).toScheme)
  rw [CommRingCat.hom_comp, ← Ideal.map_map, ← h2, ← h1,
    congrArg (fun K : (V : Y.Opens).toScheme.IdealSheafData =>
      K.ideal ⟨⊤, isAffineOpen_top (V : Y.Opens).toScheme⟩) hcomap, h3]

/-- An isomorphism of commutative rings carries nonzerodivisors to nonzerodivisors. -/
private theorem mem_nonZeroDivisors_map_of_iso {A B : CommRingCat.{u}} (e : A ≅ B) {a : A}
    (ha : a ∈ nonZeroDivisors A) : e.hom.hom a ∈ nonZeroDivisors B := by
  have h := MulEquivClass.map_nonZeroDivisors e.commRingCatIsoToRingEquiv
  have hmem : e.commRingCatIsoToRingEquiv a ∈ nonZeroDivisors B := by
    rw [← h]; exact ⟨a, ha, rfl⟩
  exact hmem

/-- **Tag 01WS with the neighbourhood shrunk.** An effective Cartier divisor is cut out by a
nonzerodivisor on an affine open contained in any prescribed open neighbourhood of a given
point: shrink the affine open produced by Tag 01WS, using that the generator restricts to a
generator (`AlgebraicGeometry.Scheme.IdealSheafData.map_ideal`) and stays a nonzerodivisor
(`Stacks.Divisors.injective_mul_res`). -/
theorem exists_affineOpens_ideal_eq_span_le {Y : Scheme.{u}} (J : Y.IdealSheafData)
    (hJ : Stacks.Divisors.IsEffectiveCartierDivisor J) (y : Y) (O : Y.Opens) (hyO : y ∈ O) :
    ∃ V : Y.affineOpens, y ∈ (V : Y.Opens) ∧ (V : Y.Opens) ≤ O ∧
      ∃ g : Γ(Y, (V : Y.Opens)), IsRegular g ∧ J.ideal V = Ideal.span {g} := by
  obtain ⟨V₀, hV₀, hyV₀, g₀, hg₀, hgen₀⟩ :=
    Stacks.Divisors.exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor J hJ y
  obtain ⟨-, ⟨V, hV, rfl⟩, hyV, hVsub⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open
      (show y ∈ (V₀ : Set Y) ∩ (O : Set Y) from ⟨hyV₀, hyO⟩)
      (V₀.isOpen.inter O.isOpen)
  have hVV₀ : (⟨V, hV⟩ : Y.affineOpens).1 ≤ V₀ := fun z hz => (hVsub hz).1
  have hinj := Stacks.Divisors.injective_mul_res hV₀ hg₀ V hVV₀
  refine ⟨⟨V, hV⟩, hyV, fun z hz => (hVsub hz).2,
    (Y.presheaf.map (homOfLE hVV₀).op).hom g₀, ?_, ?_⟩
  · refine isRegular_iff_mem_nonZeroDivisors.mpr (mem_nonZeroDivisors_iff.mpr ⟨?_, ?_⟩)
    · intro x hx
      exact hinj (show x * _ = 0 * _ by rw [zero_mul, ← hx, mul_comm])
    · intro x hx
      exact hinj (show x * _ = 0 * _ by rw [zero_mul, ← hx])
  · rw [← J.map_ideal (U := ⟨V, hV⟩) (V := ⟨V₀, hV₀⟩) hVV₀, hgen₀, Ideal.map_span,
      Set.image_singleton]
    rfl

/-- **An effective Cartier divisor pulls back to an effective Cartier divisor along an open
immersion.** The inverse image of a closed subscheme under an open immersion is its intersection
with the open, so the local nonzerodivisor generator transports: on the preimage of an affine open
`V` on which the ideal is `(g)`, both comparison maps `Γ(T, V) ⟶ Γ(T, q ''ᵁ q ⁻¹ᵁ V)` and
`Γ(T, q ''ᵁ q ⁻¹ᵁ V) ⟶ Γ(W, q ⁻¹ᵁ V)` are isomorphisms.

The affine open has to be chosen *inside the range of `q`*, so that its preimage is affine and
maps onto it; that is what `Stacks.Blowup.exists_affineOpens_ideal_eq_span_le` is for. -/
theorem isEffectiveCartierDivisor_comap_of_isOpenImmersion {T W : Scheme.{u}}
    (J : T.IdealSheafData) (hJ : Stacks.Divisors.IsEffectiveCartierDivisor J)
    (q : W ⟶ T) [IsOpenImmersion q] :
    Stacks.Divisors.IsEffectiveCartierDivisor (J.comap q) := by
  refine Stacks.Divisors.isEffectiveCartierDivisor_of_forall_exists_affineOpen _ fun z => ?_
  obtain ⟨V, hzV, hVle, g, hg, hgen⟩ :=
    exists_affineOpens_ideal_eq_span_le J hJ (q z) q.opensRange ⟨z, rfl⟩
  have himg : q ''ᵁ (q ⁻¹ᵁ (V : T.Opens)) = (V : T.Opens) := by
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf]
    exact inf_eq_right.mpr hVle
  have haff : IsAffineOpen (q ⁻¹ᵁ (V : T.Opens)) := by
    refine q.isAffineOpen_iff_of_isOpenImmersion.mp ?_
    rw [himg]
    exact V.2
  have hres : IsIso (T.presheaf.map (homOfLE himg.le).op) := by
    have he : (homOfLE himg.le).op = eqToHom (by rw [himg]) := Subsingleton.elim _ _
    rw [he, eqToHom_map]
    infer_instance
  refine ⟨q ⁻¹ᵁ (V : T.Opens), haff, hzV,
    (q.appIso (q ⁻¹ᵁ (V : T.Opens))).hom.hom
      ((T.presheaf.map (homOfLE himg.le).op).hom g), ?_, ?_⟩
  · exact isRegular_iff_mem_nonZeroDivisors.mpr
      (mem_nonZeroDivisors_map_of_iso _
        (mem_nonZeroDivisors_map_of_iso (asIso _)
          (isRegular_iff_mem_nonZeroDivisors.mp hg)))
  · rw [Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion,
      ← Stacks.IdealSheaf.ideal_map_hom_eq_comap_inv,
      ← J.map_ideal (U := ⟨q ''ᵁ (q ⁻¹ᵁ (V : T.Opens)), haff.image_of_isOpenImmersion q⟩)
        (V := V) himg.le,
      hgen, Ideal.map_span, Set.image_singleton, Ideal.map_span, Set.image_singleton]
    rfl

/-- **The classifying morphism into a blowup, locally over an affine open of the base.** Let
`ℐ` be a quasi-coherent ideal sheaf on a scheme `X`, let `U` be an affine open of `X` and let
`w : W ⟶ U` be a morphism along which the ideal of `ℐ` on `U` becomes the principal ideal
generated by a nonzerodivisor `t` of `Γ(W, ⊤)`. Then `W` admits a morphism to the blowup of `X`
in `ℐ` over `X`.

This is the existence half of Stacks tag 0806 for the global blowup, locally on the source and
over an affine open of the base, and it is unconditional. The ring map classifying the morphism
is the division map `Stacks.GradedRing.divide`: a homogeneous section of degree `n` of the Rees
algebra is a section of `ℐⁿ`, whose image is therefore divisible by `tⁿ`
(`AlgebraicGeometry.reesToBase_mem_pow`), and the degree-one sections already generate `t`
(`AlgebraicGeometry.reesToBase_degreeOne`), which is why the irrelevant ideal maps onto the
unit ideal. -/
theorem exists_hom_blowUp_of_ideal_eq_span {X : Scheme.{u}} (I : X.IdealSheafData)
    (U : X.affineOpens) {W : Scheme.{u}} (w : W ⟶ U.1.toScheme) (t : Γ(W, ⊤))
    (ht : t ∈ nonZeroDivisors Γ(W, ⊤))
    (hIt : (I.ideal U).map (specHomRingHom (w ≫ U.2.isoSpec.hom)) = Ideal.span {t}) :
    ∃ g : W ⟶ AlgebraicGeometry.blowUp I,
      g ≫ AlgebraicGeometry.blowUpToBase I = w ≫ U.1.ι := by
  set θ := specHomRingHom (w ≫ U.2.isoSpec.hom) with hθ
  set χ := θ.comp (AlgebraicGeometry.reesToBase I U) with hχ
  have hdiv : ∀ (n : ℕ) (x : (AlgebraicGeometry.reesSituation I).sectionRing U.1),
      x ∈ (AlgebraicGeometry.reesSituation I).sectionRingGrading U.1 n →
      ∃ c : Γ(W, ⊤), χ x = t ^ n * c := by
    intro n x hx
    have h1 : AlgebraicGeometry.reesToBase I U x ∈ (I.ideal U) ^ n :=
      AlgebraicGeometry.reesToBase_mem_pow I U n x hx
    have h2 : χ x ∈ ((I.ideal U) ^ n).map θ := Ideal.mem_map_of_mem _ h1
    rw [Ideal.map_pow, hIt, Ideal.span_singleton_pow] at h2
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h2
    exact ⟨c, by rw [← hc, mul_comm]⟩
  have hgen : t ∈ Ideal.span {b : Γ(W, ⊤) | ∃ n : ℕ, 0 < n ∧
      ∃ x ∈ (AlgebraicGeometry.reesSituation I).sectionRingGrading U.1 n, χ x = b} := by
    have hle : (I.ideal U).map θ ≤ Ideal.span {b : Γ(W, ⊤) | ∃ n : ℕ, 0 < n ∧
        ∃ x ∈ (AlgebraicGeometry.reesSituation I).sectionRingGrading U.1 n, χ x = b} := by
      refine Ideal.map_le_iff_le_comap.mpr fun a ha => Ideal.subset_span ?_
      refine ⟨1, one_pos, (AlgebraicGeometry.reesDegreeOne I U ⟨a, ha⟩).1,
        (AlgebraicGeometry.reesDegreeOne I U ⟨a, ha⟩).2, ?_⟩
      change θ (AlgebraicGeometry.reesToBase I U _) = θ a
      rw [AlgebraicGeometry.reesToBase_degreeOne]
    exact hle (hIt ▸ Ideal.mem_span_singleton_self t)
  refine Stacks.RelativeProj.Situation.exists_hom_relativeProj_of_sectionRingHom
    (AlgebraicGeometry.reesSituation I) U w
    (Stacks.GradedRing.divide _ χ t hdiv ht)
    (Stacks.GradedRing.map_divide_irrelevant_eq_top _ χ t hdiv ht hgen) ?_
  intro r
  rw [Stacks.GradedRing.divide_of_mem_zero _ χ t hdiv ht
    (Stacks.RelativeProj.Situation.sectionRingBaseMap_mem_zero
      (AlgebraicGeometry.reesSituation I) U.1 r)]
  change θ (AlgebraicGeometry.reesToBase I U _) = θ r
  rw [AlgebraicGeometry.reesToBase_sectionRingBaseMap]

/-- **The existence half of Stacks tag 0806 for the blowup of an arbitrary scheme in a
quasi-coherent ideal sheaf.** Let `ℐ` be a quasi-coherent ideal sheaf on `X` and let
`f : Y ⟶ X` be an object of the category `C` of tag 0806, i.e. the inverse image of the centre
is an effective Cartier divisor on `Y`. Then `Y` admits a morphism to the blowup of `X` in `ℐ`
over `X`, provided the blowup is an isomorphism over the complement of the centre — **tag 02OS
part (1)**, taken as an instance argument.

The construction is local on the source: by tag 01WS every point of `Y` has an affine
neighbourhood on which the inverse image of the centre is cut out by a nonzerodivisor and which
lies over an affine open of `X` (`Stacks.Blowup.exists_affineOpens_ideal_eq_span_le`), there
`Stacks.Blowup.exists_hom_blowUp_of_ideal_eq_span` supplies the morphism, and the morphisms glue
by the uniqueness half. The density input of the gluing is tag 07ZU on each member of the cover,
which is `Stacks.Divisors.isSchemeTheoreticallyDense_compl_of_isEffectiveCartierDivisor`
transported by
`AlgebraicGeometry.Scheme.Opens.isSchemeTheoreticallyDense_preimage_of_isOpenImmersion`. -/
theorem exists_hom_blowUp_of_isEffectiveCartierDivisor {X : Scheme.{u}} (I : X.IdealSheafData)
    [IsIso (AlgebraicGeometry.blowUpToBase I ∣_ I.support.compl)]
    {Y : Scheme.{u}} (f : Y ⟶ X)
    (hcartier : Stacks.Divisors.IsEffectiveCartierDivisor (I.comap f)) :
    ∃ g : Y ⟶ AlgebraicGeometry.blowUp I, g ≫ AlgebraicGeometry.blowUpToBase I = f := by
  classical
  have hsep : IsSeparated (AlgebraicGeometry.blowUpToBase I) :=
    Stacks.RelativeProj.Situation.isSeparated_relativeProjToBase _
  have hdense : ∀ (Z : Scheme.{u}) (p : Z ⟶ Y), IsOpenImmersion p →
      Scheme.Opens.IsSchemeTheoreticallyDense ((p ≫ f) ⁻¹ᵁ I.support.compl) := by
    intro Z p hp
    have hpre : (p ≫ f) ⁻¹ᵁ I.support.compl = p ⁻¹ᵁ (I.comap f).support.compl := by
      rw [preimage_compl_support I (p ≫ f), Scheme.IdealSheafData.comap_comp,
        ← preimage_compl_support (I.comap f) p]
    rw [hpre]
    exact Scheme.Opens.isSchemeTheoreticallyDense_preimage_of_isOpenImmersion _
      (Stacks.Divisors.isSchemeTheoreticallyDense_compl_of_isEffectiveCartierDivisor _ hcartier) p
  choose U hU using fun y : Y => Stacks.Divisors.exists_affineOpens_mem (f y)
  choose V hyV hVU g hg hgen using fun y : Y =>
    exists_affineOpens_ideal_eq_span_le (I.comap f) hcartier y (f ⁻¹ᵁ (U y : X.Opens))
      (hU y)
  refine exists_hom_of_isOpenCover (AlgebraicGeometry.blowUpToBase I) f hdense
    (fun y => (V y : Y.Opens)) (TopologicalSpace.IsOpenCover.mk (eq_top_iff.2 fun z _ =>
      TopologicalSpace.Opens.mem_iSup.2 ⟨z, hyV z⟩)) (fun y => ?_)
  obtain ⟨h, hh⟩ := exists_hom_blowUp_of_ideal_eq_span I (U y)
    (f.resLE (U y : X.Opens) (V y : Y.Opens) (hVU y))
    ((V y : Y.Opens).topIso.inv.hom (g y))
    (mem_nonZeroDivisors_map_of_iso (V y : Y.Opens).topIso.symm
      (isRegular_iff_mem_nonZeroDivisors.mp (hg y)))
    (by
      rw [ideal_map_specHomRingHom_resLE I f (U y) (V y) (hVU y), hgen y, Ideal.map_span,
        Set.image_singleton])
  exact ⟨h, by rw [hh, Scheme.Hom.resLE_comp_ι]⟩

/-- **Stacks Project, Tag 0806. The universal property of blowing up.** The blowup of a scheme
`X` in a quasi-coherent ideal sheaf `ℐ` is a final object of the category `C` of schemes over
`X` on which the inverse image of the centre is an effective Cartier divisor.

Unconditional. The five geometric inputs of
`Stacks.Blowup.exists_nonempty_isTerminal`, which is the uniqueness half of the tag reduced to
them, are now all theorems:

* separatedness of the blowup morphism is tag 01O2,
  `Stacks.RelativeProj.Situation.isSeparated_relativeProjToBase`;
* membership of the blowup in `C` is tag 02OS part (2),
  `Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal`;
* the blowup is an isomorphism over the complement of the centre by tag 02OS part (1),
  `AlgebraicGeometry.isIso_blowUpToBase_restrict_compl_support`;
* scheme-theoretic density of the complement of an effective Cartier divisor is tag 07ZU,
  `Stacks.Divisors.isSchemeTheoreticallyDense_compl_of_isEffectiveCartierDivisor`, transported
  along the open immersions of the gluing cover by
  `AlgebraicGeometry.Scheme.Opens.isSchemeTheoreticallyDense_preimage_of_isOpenImmersion`;
* the existence of the classifying morphism, which the source deduces from the universal
  property of relative `Proj` (Constructions, Section 01NS), is
  `Stacks.Blowup.exists_hom_blowUp_of_isEffectiveCartierDivisor`.

This supersedes `Stacks.Blowup.exists_nonempty_isTerminal_blowUp`, which is the same statement
with the last two of those as hypotheses. -/
@[stacks 0806, ega "IV 19.4.1", sga "6 XIII 7.1.4" "more general"]
theorem isTerminal_blowUp {X : Scheme.{u}} (I : X.IdealSheafData) :
    ∃ h : IsCartierOver I (Over.mk (AlgebraicGeometry.blowUpToBase I)),
      Nonempty (IsTerminal
        (⟨Over.mk (AlgebraicGeometry.blowUpToBase I), h⟩ : CartierOver I)) :=
  exists_nonempty_isTerminal_blowUp I inferInstance
    fun Y hY => exists_hom_blowUp_of_isEffectiveCartierDivisor I Y.hom hY

end Stacks.Blowup

end
