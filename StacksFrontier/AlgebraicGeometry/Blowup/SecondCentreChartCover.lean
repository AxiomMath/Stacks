module

public import StacksFrontier.AlgebraicGeometry.Blowup.SecondCentreChart
public import StacksFrontier.AlgebraicGeometry.RelativeProjSituation.QuasiCompact

/-!
# Recognizing the charts of a blowup, and covering by finitely many of them

Let `X` be a scheme, `I` a quasi-coherent ideal sheaf and `b : X' = Bl_I(X) ⟶ X` the blowup. A
point of `X'` lying over an affine open `U` of `X` belongs to the chart attached to a section
`a` of `I` over `U` exactly when the pullback of `a` generates the exceptional ideal in the
local ring there ([Stacks, Tag 0BFL]). This file reads that criterion on the affine open
underlying the chart and draws the two consequences the second-centre factorization needs:

* if the pullback of a second section `a'` to the chart at `a` is `h` times the pullback of `a`,
  then the basic open of `h` lies inside the chart at `a'` — this is what identifies the overlap
  of two charts as a basic open of either of them;
* the charts attached to a *finite generating family* of `I(U)` already cover `b⁻¹(U)`.

It also proves the criterion by which a section of the base belongs to the pushforward of an
ideal sheaf of `X'`: it is enough that its pullback lie in that ideal sheaf on every chart of a
covering family.

## Main results

* `AlgebraicGeometry.mem_blowUpChartOpen_iff`: [Stacks, Tag 0BFL] on the affine open underlying
  the chart.
* `AlgebraicGeometry.basicOpen_le_blowUpChartOpen`: a basic open on which one denominator
  divides another with unit quotient lies on the chart of the second.
* `AlgebraicGeometry.iSup_blowUpChartOpen`: the charts of a generating family cover the part of
  the blowup lying over the affine open.
* `AlgebraicGeometry.mem_ideal_map_of_forall_chart`: a section of the base whose pullback lies
  in `K` on every chart of a covering family lies in `K.map b`.

## Implementation notes

The covering statement is a local-ring argument: the stalk of the exceptional ideal at a point
of `b⁻¹(U)` is generated by the pullbacks of the members of a generating family of `I(U)`, and
is principal because the point lies on some chart; in a local ring a principal ideal generated
by a nonempty finite set is generated by one of its members
(`exists_span_singleton_eq_of_span_finset_eq`, proved by Nakayama). That member's chart contains
the point, again by [Stacks, Tag 0BFL]. Adding the zero section to the family makes it nonempty
without changing the span, and the chart at the zero section is empty.

The pushforward criterion is the sheaf condition on the closed subscheme cut out by `K`: the
section of the structure sheaf of that subscheme obtained from a section of the base vanishes
because it vanishes on each member of a cover, and on an affine open the kernel of the map of
sections of the closed immersion is the ideal of `K` there.

## References

* [Stacks Project, Tag 0BFL](https://stacks.math.columbia.edu/tag/0BFL)
* [Stacks Project, Tag 0804](https://stacks.math.columbia.edu/tag/0804)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace

universe u

namespace AlgebraicGeometry

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- The germ of a section pulled back to a chart is the image of its germ downstairs. -/
theorem germ_blowUpChartMap (U : X.affineOpens) (a : I.ideal U) (x : blowUp I)
    (hx : x ∈ (blowUpChartOpen I U a).1) (r : Γ(X, U.1)) :
    (blowUp I).presheaf.germ (blowUpChartOpen I U a).1 x hx ((blowUpChartMap I U a).hom r)
      = ((blowUpToBase I).stalkMap x).hom
          (X.presheaf.germ U.1 (blowUpToBase I x) (blowUpChartOpen_le I U a hx) r) := by
  rw [show (blowUpChartMap I U a).hom r
      = ((blowUp I).presheaf.map (homOfLE (blowUpChartOpen_le I U a)).op).hom
        (((blowUpToBase I).app U.1).hom r) from rfl,
    TopCat.Presheaf.germ_res_apply _ (homOfLE (blowUpChartOpen_le I U a)) x hx]
  exact ((blowUpToBase I).germ_stalkMap_apply U.1 x (blowUpChartOpen_le I U a hx) r).symm

/-- A point lies on the chart at `a` exactly when it lies in the range of the affine chart. -/
theorem mem_blowUpChartOpen_iff_mem_range (U : X.affineOpens) (a : I.ideal U) (x : blowUp I) :
    x ∈ (blowUpChartOpen I U a).1 ↔ x ∈ Set.range (blowUpAffineChart I U a).base := by
  rw [show (blowUpChartOpen I U a).1 = (blowUpAffineChart I U a).opensRange from
    Scheme.Hom.image_top_eq_opensRange _]
  exact Iff.rfl

/-- **A point lies on the chart at `a` exactly when `a` generates the exceptional ideal there.**
This is [Stacks, Tag 0BFL], read on the affine open underlying the chart. -/
theorem mem_blowUpChartOpen_iff (U : X.affineOpens) (a : I.ideal U) (x : blowUp I)
    (hx : blowUpToBase I x ∈ U.1) :
    x ∈ (blowUpChartOpen I U a).1 ↔
      IdealSheafData.stalk (exceptionalIdeal I) x =
        Ideal.span {((blowUpToBase I).stalkMap x).hom
                      (X.presheaf.germ U.1 (blowUpToBase I x) hx (a : Γ(X, U.1)))} := by
  let := (reesSituation I).sectionRingGradedRing U.1
  let := (reesSituation I).sectionRingGradingGradedRing U.1
  rw [← mem_affineBlowupStandardOpen_iff_exceptionalIdeal_stalk_eq_span I U a x hx,
    mem_blowUpChartOpen_iff_mem_range]
  have hid : ∀ z, (affineBlowupStandardOpenIso I U a).hom
      ((affineBlowupStandardOpenIso I U a).inv z) = z := fun z => by
    rw [← Scheme.Hom.comp_apply, (affineBlowupStandardOpenIso I U a).inv_hom_id]
    rfl
  constructor
  · rintro ⟨y, rfl⟩
    exact ⟨(affineBlowupStandardOpenIso I U a).hom y, rfl⟩
  · rintro ⟨z, rfl⟩
    refine ⟨(affineBlowupStandardOpenIso I U a).inv z, ?_⟩
    change ((Proj.basicOpen ((reesSituation I).sectionRingGrading U.1)
        (reesDegreeOne I U a).1).ι ≫
        Stacks.RelativeProj.Situation.relativeProjChart (reesSituation I) U)
      ((affineBlowupStandardOpenIso I U a).hom
        ((affineBlowupStandardOpenIso I U a).inv z)) = _
    rw [hid]

/-- **A basic open on which one denominator divides another, with unit quotient, lies on the
chart of the second.** -/
theorem basicOpen_le_blowUpChartOpen (U : X.affineOpens) (a a' : I.ideal U)
    (h : Γ(blowUp I, (blowUpChartOpen I U a).1))
    (hh : (blowUpChartMap I U a).hom (a' : Γ(X, U.1))
      = h * (blowUpChartMap I U a).hom (a : Γ(X, U.1))) :
    (blowUp I).basicOpen h ≤ (blowUpChartOpen I U a').1 := by
  intro x hx
  have hxa : x ∈ (blowUpChartOpen I U a).1 := (blowUp I).basicOpen_le h hx
  have hxU : blowUpToBase I x ∈ U.1 := blowUpChartOpen_le I U a hxa
  rw [mem_blowUpChartOpen_iff I U a' x hxU, ← germ_blowUpChartMap I U a x hxa, hh, map_mul,
    Ideal.span_singleton_mul_left_unit (((blowUp I).mem_basicOpen h x hxa).mp hx),
    germ_blowUpChartMap I U a x hxa]
  exact (mem_blowUpChartOpen_iff I U a x hxU).mp hxa

/-- **In a local ring, a principal ideal generated by a nonempty finite set is generated by one
of its members.** -/
private theorem exists_span_singleton_eq_of_span_finset_eq {R : Type*} [CommRing R]
    [IsLocalRing R] {S : Finset R} (hS : S.Nonempty) {g : R}
    (h : Ideal.span (S : Set R) = Ideal.span {g}) :
    ∃ s ∈ S, Ideal.span ({s} : Set R) = Ideal.span {g} := by
  classical
  by_contra hcon
  push Not at hcon
  have hle : Ideal.span (S : Set R) ≤ IsLocalRing.maximalIdeal R • Ideal.span {g} := by
    rw [Ideal.span_le]
    intro s hs
    obtain ⟨u, hu⟩ := Ideal.mem_span_singleton'.mp (h ▸ Ideal.subset_span hs)
    have hnu : u ∈ IsLocalRing.maximalIdeal R := by
      by_contra hu'
      exact hcon s hs (by
        rw [← hu, Ideal.span_singleton_mul_left_unit (IsLocalRing.notMem_maximalIdeal.mp hu')])
    exact hu ▸ Submodule.mul_mem_mul hnu (Ideal.subset_span rfl)
  have hbot : Ideal.span ({g} : Set R) = ⊥ :=
    Submodule.eq_bot_of_le_smul_of_le_jacobson_bot _ _ ⟨{g}, by simp⟩ (h ▸ hle)
      (IsLocalRing.jacobson_eq_maximalIdeal ⊥ bot_ne_top).ge
  obtain ⟨s, hs⟩ := hS
  obtain rfl : s = 0 := by
    have hmem : s ∈ Ideal.span ({g} : Set R) := h ▸ Ideal.subset_span hs
    rwa [hbot, Submodule.mem_bot] at hmem
  exact hcon 0 hs (by rw [hbot, Ideal.span_singleton_eq_bot])

/-- **The charts attached to a generating family of the centre over an affine open cover the
part of the blowup lying over that open.** -/
theorem iSup_blowUpChartOpen (U : X.affineOpens) (A : Finset (I.ideal U)) (hA : A.Nonempty)
    (hspan : Ideal.span ((fun a : I.ideal U => (a : Γ(X, U.1))) '' (A : Set (I.ideal U)))
      = I.ideal U) :
    ⨆ a ∈ A, (blowUpChartOpen I U a).1 = blowUpToBase I ⁻¹ᵁ U.1 := by
  classical
  refine le_antisymm (iSup₂_le fun a _ => blowUpChartOpen_le I U a) fun x hx => ?_
  have hxU : blowUpToBase I x ∈ U.1 := hx
  obtain ⟨a, ha⟩ := exists_mem_range_blowUpAffineChart_of_mem I U x hx
  set φ : Γ(X, U.1) → (blowUp I).presheaf.stalk x := fun r =>
    ((blowUpToBase I).stalkMap x).hom (X.presheaf.germ U.1 (blowUpToBase I x) hxU r)
  have hstalk : IdealSheafData.stalk (exceptionalIdeal I) x = Ideal.span {φ (a : Γ(X, U.1))} :=
    (mem_blowUpChartOpen_iff I U a x hxU).mp ((mem_blowUpChartOpen_iff_mem_range I U a x).mpr ha)
  have hstalk2 : IdealSheafData.stalk (exceptionalIdeal I) x
      = Ideal.span ((A.image fun s : I.ideal U => φ (s : Γ(X, U.1))) : Set _) := by
    rw [show exceptionalIdeal I = I.comap (blowUpToBase I) from rfl,
      idealStalk_comap_eq_map (blowUpToBase I) I x,
      IdealSheafData.stalk_eq_map_germ I (blowUpToBase I x) U hxU,
      congrArg (Ideal.map (X.presheaf.germ U.1 (blowUpToBase I x) hxU).hom) hspan.symm,
      Ideal.map_span, Ideal.map_span, Finset.coe_image, ← Set.image_comp, ← Set.image_comp]
    rfl
  obtain ⟨t, htmem, hts⟩ := exists_span_singleton_eq_of_span_finset_eq
    (S := A.image fun s : I.ideal U => φ (s : Γ(X, U.1)))
    (hA.image _) (hstalk2 ▸ hstalk)
  obtain ⟨a', ha'A, rfl⟩ := Finset.mem_image.mp htmem
  exact Opens.mem_iSup.mpr ⟨a', Opens.mem_iSup.mpr
    ⟨ha'A, (mem_blowUpChartOpen_iff I U a' x hxU).mpr (by rw [hstalk, ← hts])⟩⟩

/-- **A section of the base whose pullback to every chart of a covering family lies in `K` is a
section of the pushforward of `K`.** -/
theorem mem_ideal_map_of_forall_chart (hI : I.IsFiniteType) (K : (blowUp I).IdealSheafData)
    (U : X.affineOpens) (A : Finset (I.ideal U))
    (hcov : ⨆ a ∈ A, (blowUpChartOpen I U a).1 = blowUpToBase I ⁻¹ᵁ U.1)
    (t : Γ(X, U.1))
    (ht : ∀ a ∈ A, (blowUpChartMap I U a).hom t ∈ K.ideal (blowUpChartOpen I U a)) :
    t ∈ (K.map (blowUpToBase I)).ideal U := by
  have : QuasiCompact (blowUpToBase I) := Stacks.Blowup.quasiCompact_blowUpToBase hI
  rw [show K.map (blowUpToBase I) = (K.subschemeι ≫ blowUpToBase I).ker from rfl,
    Scheme.Hom.ker_apply, RingHom.mem_ker]
  have hcover : K.subschemeι ⁻¹ᵁ (blowUpToBase I ⁻¹ᵁ U.1) ≤
      ⨆ a : {x : I.ideal U // x ∈ A}, K.subschemeι ⁻¹ᵁ (blowUpChartOpen I U a.1).1 := by
    rw [← hcov]
    intro z hz
    obtain ⟨a, ha⟩ := Opens.mem_iSup.mp hz
    obtain ⟨haA, ha'⟩ := Opens.mem_iSup.mp ha
    exact Opens.mem_iSup.mpr ⟨⟨a, haA⟩, ha'⟩
  have key : ∀ a : {x : I.ideal U // x ∈ A},
      (K.subscheme.presheaf.map (homOfLE ((Opens.map K.subschemeι.base).map
          (homOfLE (blowUpChartOpen_le I U a.1))).le).op).hom
        (((K.subschemeι ≫ blowUpToBase I).app U.1).hom t) = 0 := by
    intro a
    have hle : (blowUpChartOpen I U a.1).1 ≤ blowUpToBase I ⁻¹ᵁ U.1 := blowUpChartOpen_le I U a.1
    have hres : K.subscheme.presheaf.map
          (homOfLE ((Opens.map K.subschemeι.base).map (homOfLE hle)).le).op
          (((K.subschemeι ≫ blowUpToBase I).app U.1).hom t)
        = ((K.subschemeι ≫ blowUpToBase I).appLE U.1
            (K.subschemeι ⁻¹ᵁ (blowUpChartOpen I U a.1).1) _).hom t := rfl
    rw [hres, ← Scheme.Hom.appLE_comp_appLE K.subschemeι (blowUpToBase I) U.1
      (blowUpChartOpen I U a.1).1 (K.subschemeι ⁻¹ᵁ (blowUpChartOpen I U a.1).1) hle le_rfl]
    change (K.subschemeι.appLE (blowUpChartOpen I U a.1).1
        (K.subschemeι ⁻¹ᵁ (blowUpChartOpen I U a.1).1) le_rfl).hom
        ((blowUpChartMap I U a.1).hom t) = 0
    rw [Scheme.Hom.appLE_eq_app, ← RingHom.mem_ker, K.ker_subschemeι_app (blowUpChartOpen I U a.1)]
    exact ht a.1 a.2
  exact TopCat.Sheaf.eq_of_locally_eq' K.subscheme.sheaf
    (fun a : {x : I.ideal U // x ∈ A} => K.subschemeι ⁻¹ᵁ (blowUpChartOpen I U a.1).1)
    (K.subschemeι ⁻¹ᵁ (blowUpToBase I ⁻¹ᵁ U.1))
    (fun a => homOfLE ((Opens.map K.subschemeι.base).map
      (homOfLE (blowUpChartOpen_le I U a.1))).le) hcover _ 0
    fun a => (key a).trans (map_zero _).symm

end AlgebraicGeometry

end
