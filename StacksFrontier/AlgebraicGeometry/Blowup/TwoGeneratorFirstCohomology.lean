module

public import StacksFrontier.AlgebraicGeometry.Cohomology.Cech.TwoAffineCoverFirstVanishing
public import StacksFrontier.AlgebraicGeometry.Blowup.DerivedPullbackAnnihilation
public import Mathlib.RingTheory.GradedAlgebra.HomogeneousLocalization

/-!
# The structure sheaf of the blowup in a two-generated ideal has no first cohomology

Let `R` be a commutative ring and `I = (x, y)` an ideal generated by two elements. The blowup
`X = Proj(⨁ Iⁿ)` of `Spec R` in `I` is covered by the two affine charts `D₊(x⁽¹⁾)` and
`D₊(y⁽¹⁾)`, whose intersection `D₊(x⁽¹⁾y⁽¹⁾)` is affine. On the intersection every function is
a sum of a function on the first chart and a function on the second: the degree-zero part of the
localization at `x⁽¹⁾y⁽¹⁾` is spanned by the monomials `(x⁽¹⁾/y⁽¹⁾)ᵏ` and `(y⁽¹⁾/x⁽¹⁾)ᵏ`. So
`H¹(X, 𝒪_X) = 0`. This is the part of [Stacks, Tag 0AGS] (2) at `n = 0` which uses only the
two generators.

## Main results

* `Stacks.Blowup.exists_awayMap_add_awayMap_eq`: in a graded ring generated in degree one by
  `f, g` over its degree-zero part, every element of `A_{(fg)}` is the sum of an element of
  `A_{(f)}` and one of `A_{(g)}`.
* `Stacks.Blowup.isZero_Hgroup_one_blowUpSpec_of_two_generators`: `H¹(Proj(⨁ Iⁿ), 𝒪) = 0` for an
  ideal `I` generated by two elements.

## References

* [Stacks Project, Tag 0AGS](https://stacks.math.columbia.edu/tag/0AGS)
* [Stacks Project, Tag 01XD](https://stacks.math.columbia.edu/tag/01XD)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace AlgebraicGeometry
open HomogeneousLocalization

universe u

namespace Stacks.Blowup

section Algebra

variable {R A : Type u} [CommRing R] [CommRing A] [Algebra R A] (𝒜 : ℕ → Submodule R A)
  [GradedAlgebra 𝒜] {f g : A} (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1)

/-- The monomial `u ^ p * v ^ q / (v * u) ^ a` with `p + q = 2 * a` and `a ≤ p` is the image of
`(u / v) ^ (p - a)` under `A_{(v)} → A_{(vu)}`. -/
private theorem exists_awayMap_eq_mk_pow_mul_pow {u v x : A} (hu : u ∈ 𝒜 1) (hv : v ∈ 𝒜 1)
    (hx : x = v * u) (hxm : x ∈ 𝒜 2) {a p q : ℕ} (hpq : p + q = 2 * a) (h : a ≤ p) {y : A}
    (hy : y = u ^ p * v ^ q) :
    ∃ w : Away 𝒜 v, ∀ ha, awayMap 𝒜 hu hx w = Away.mk 𝒜 hxm a y ha := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le h
  obtain rfl : a = q + k := by omega
  subst hx hy
  refine ⟨Away.mk 𝒜 hv k (u ^ k) (by simpa using SetLike.pow_mem_graded k hu), fun ha => ?_⟩
  rw [awayMap_mk]
  ext
  simp only [Away.val_mk]
  rw [Localization.mk_eq_mk_iff, Localization.r_iff_exists]
  exact ⟨1, by simp only [OneMemClass.coe_one, one_mul]; ring⟩

/-- **`A_{(fg)} = A_{(f)} + A_{(g)}` for degree-one generators.** In a graded ring generated over
its degree-zero part by two elements `f, g` of degree one, every element of the degree-zero part
of the localization at `fg` is the image of an element of `A_{(f)}` plus the image of an element
of `A_{(g)}`. -/
theorem exists_awayMap_add_awayMap_eq
    (hgen : Algebra.adjoin (𝒜 0) (Set.range ![f, g]) = ⊤) (z : Away 𝒜 (f * g)) :
    ∃ (z₀ : Away 𝒜 f) (z₁ : Away 𝒜 g),
      z = awayMap 𝒜 hg rfl z₀ + awayMap 𝒜 hf (mul_comm f g) z₁ := by
  have hfg : f * g ∈ 𝒜 2 := by simpa using SetLike.mul_mem_graded hf hg
  let φ₀ : Away 𝒜 f →ₗ[𝒜 0] Away 𝒜 (f * g) := (awayMapₐ 𝒜 hg rfl).toLinearMap
  let φ₁ : Away 𝒜 g →ₗ[𝒜 0] Away 𝒜 (f * g) := (awayMapₐ 𝒜 hf (mul_comm f g)).toLinearMap
  suffices hz : z ∈ LinearMap.range (φ₀.coprod φ₁) by
    obtain ⟨⟨z₀, z₁⟩, h⟩ := hz
    exact ⟨z₀, z₁, h.symm⟩
  have hspan := Away.span_mk_prod_pow_eq_top hfg ![f, g] hgen (fun _ => 1)
    (fun i => by fin_cases i <;> simpa)
  refine (Submodule.span_le.mpr ?_ (hspan.ge (Submodule.mem_top (x := z))))
  rintro _ ⟨a, ai, hai, rfl⟩
  have hsum : ai 0 + ai 1 = 2 * a := by
    simpa [Fin.sum_univ_two, mul_comm] using hai
  have hprod : (∏ i, ![f, g] i ^ ai i) = f ^ ai 0 * g ^ ai 1 := by
    simp [Fin.prod_univ_two]
  rcases le_total a (ai 0) with h | h
  · -- the monomial is `(f/g)ᵏ`, an element of `A_{(g)}`
    obtain ⟨w, hw⟩ := exists_awayMap_eq_mk_pow_mul_pow 𝒜 hf hg (mul_comm f g) hfg hsum h hprod
    exact ⟨(0, w), by rw [LinearMap.coprod_apply, map_zero, zero_add]; exact hw _⟩
  · -- the monomial is `(g/f)ᵏ`, an element of `A_{(f)}`
    obtain ⟨w, hw⟩ := exists_awayMap_eq_mk_pow_mul_pow 𝒜 hg hf rfl hfg (a := a)
      (p := ai 1) (q := ai 0) (by omega) (by omega) (hprod.trans (mul_comm _ _))
    exact ⟨(w, 0), by rw [LinearMap.coprod_apply, map_zero, add_zero]; exact hw _⟩

end Algebra


section Geometry

open Stacks.Cohomology.CechSheaf Stacks.Cohomology.Basis in
/-- A section of the abelian presheaf underlying the structure sheaf, read as a function. -/
def secToΓ {X : Scheme.{u}} {W : X.Opens}
    (c : ToType ((abSections (SheafOfModules.unit X.ringCatSheaf)).obj (op W))) : Γ(X, W) := c

open Stacks.Cohomology.CechSheaf Stacks.Cohomology.Basis in
/-- A function, read as a section of the abelian presheaf underlying the structure sheaf. -/
def Γtosec {X : Scheme.{u}} {W : X.Opens} (s : Γ(X, W)) :
    ToType ((abSections (SheafOfModules.unit X.ringCatSheaf)).obj (op W)) := s

open Stacks.Cohomology.CechSheaf Stacks.Cohomology.Basis in
/-- The map `secToΓ` from sections of the abelian presheaf to functions is injective. -/
theorem secToΓ_injective {X : Scheme.{u}} {W : X.Opens} :
    Function.Injective (secToΓ (X := X) (W := W)) := fun _ _ h => h

open Stacks.Cohomology.CechSheaf Stacks.Cohomology.Basis in
/-- `secToΓ` is a left inverse of `Γtosec`. -/
theorem secToΓ_Γtosec {X : Scheme.{u}} {W : X.Opens} (s : Γ(X, W)) : secToΓ (Γtosec s) = s := rfl

open Stacks.Cohomology.CechSheaf Stacks.Cohomology.Basis in
/-- `secToΓ` sends a difference of sections to the difference of the functions. -/
theorem secToΓ_sub {X : Scheme.{u}} {W : X.Opens}
    (c d : ToType ((abSections (SheafOfModules.unit X.ringCatSheaf)).obj (op W))) :
    secToΓ (c - d) = secToΓ c - secToΓ d := rfl

open Stacks.Cohomology.CechSheaf Stacks.Cohomology.Basis in
/-- `secToΓ` commutes with restriction along an inclusion `W ≤ W'`. -/
theorem secToΓ_res {X : Scheme.{u}} {W W' : X.Opens} (h : W ≤ W')
    (c : ToType ((abSections (SheafOfModules.unit X.ringCatSheaf)).obj (op W'))) :
    secToΓ (res (abSections (SheafOfModules.unit X.ringCatSheaf)) h c) =
      X.presheaf.map (homOfLE h).op (secToΓ c) := rfl

variable {R : Type u} [CommRing R] (I : Ideal R)

/-- Restricting a function from `W` to `V` and then to `U` is restricting it from `W` to `U`. -/
theorem presheaf_map_map {X : Scheme.{u}} {U V W : X.Opens} (h₁ : U ≤ V) (h₂ : V ≤ W)
    (s : Γ(X, W)) :
    X.presheaf.map (homOfLE h₁).op (X.presheaf.map (homOfLE h₂).op s) =
      X.presheaf.map (homOfLE (h₁.trans h₂)).op s := by
  rw [← ConcreteCategory.comp_apply, ← Functor.map_comp]
  rfl

/-- For `W ≤ T ≤ U₀ ∩ U₁`, the restriction to `W` of `a|_T + b|_T` equals `b|_W - (-a)|_W`. -/
theorem presheaf_map_add_eq_sub_neg {X : Scheme.{u}} {U₀ U₁ T W : X.Opens} (hT0 : T ≤ U₀)
    (hT1 : T ≤ U₁) (hWT : W ≤ T) (hW0 : W ≤ U₀) (hW1 : W ≤ U₁) (a : Γ(X, U₀)) (b : Γ(X, U₁)) :
    X.presheaf.map (homOfLE hWT).op
        (X.presheaf.map (homOfLE hT0).op a + X.presheaf.map (homOfLE hT1).op b) =
      X.presheaf.map (homOfLE hW1).op b - X.presheaf.map (homOfLE hW0).op (-a) := by
  rw [map_add, map_neg, presheaf_map_map, presheaf_map_map, sub_neg_eq_add, add_comm]

set_option maxHeartbeats 800000 in
open Stacks.Cohomology.CechSheaf Stacks.Cohomology.Basis in
/-- **`H¹(Proj(⨁ Iⁿ), 𝒪) = 0` for an ideal generated by two elements.** The two charts
`D₊(x⁽¹⁾)`, `D₊(y⁽¹⁾)` cover the blowup, their intersection is affine, and every function on the
intersection is a sum of functions on the two charts
(`Stacks.Blowup.exists_awayMap_add_awayMap_eq`). -/
theorem isZero_Hgroup_one_proj_reesGrading_of_two_generators (x : Fin 2 → R)
    (hI : I = Ideal.span (Set.range x)) :
    IsZero (Hgroup (AlgebraicGeometry.Proj (reesGrading I)).ringCatSheaf ⊤ 1
      (SheafOfModules.unit (AlgebraicGeometry.Proj (reesGrading I)).ringCatSheaf)) := by
  have hx : ∀ i, x i ∈ I := fun i => by rw [hI]; exact Ideal.subset_span ⟨i, rfl⟩
  let f : reesAlgebra I := reesDegOne I (hx 0)
  let g : reesAlgebra I := reesDegOne I (hx 1)
  have hf : f ∈ (reesGrading I) 1 := reesDegOne_mem_reesGrading I (hx 0)
  have hg : g ∈ (reesGrading I) 1 := reesDegOne_mem_reesGrading I (hx 1)
  have hfg : f * g ∈ (reesGrading I) 2 := by simpa using SetLike.mul_mem_graded hf hg
  have hgen : Algebra.adjoin ((reesGrading I) 0) (Set.range ![f, g]) = ⊤ := by
    have e : ![f, g] = fun i => (reesDegOne I (hx i) : reesAlgebra I) := by
      funext i; fin_cases i <;> rfl
    rw [e]
    exact adjoin_range_reesDegOne_eq_top I hx hI
  let U₀ : (AlgebraicGeometry.Proj (reesGrading I)).Opens := Proj.basicOpen (reesGrading I) f
  let U₁ : (AlgebraicGeometry.Proj (reesGrading I)).Opens := Proj.basicOpen (reesGrading I) g
  have htop : U₀ ⊔ U₁ = ⊤ := by
    have h := Proj.iSup_basicOpen_eq_top' (reesGrading I) ![f, g]
      (fun i => ⟨1, by fin_cases i <;> assumption⟩) hgen
    refine Eq.trans ?_ h
    refine le_antisymm (sup_le (le_iSup_of_le 0 le_rfl) (le_iSup_of_le 1 le_rfl)) ?_
    refine iSup_le fun i => ?_
    fin_cases i
    · exact le_sup_left
    · exact le_sup_right
  have h₀ : IsAffineOpen U₀ := Proj.isAffineOpen_basicOpen (reesGrading I) f hf one_pos
  have h₁ : IsAffineOpen U₁ := Proj.isAffineOpen_basicOpen (reesGrading I) g hg one_pos
  have hint : U₀ ⊓ U₁ = Proj.basicOpen (reesGrading I) (f * g) :=
    (Proj.basicOpen_mul (reesGrading I) f g).symm
  have h₀₁ : IsAffineOpen (U₀ ⊓ U₁) := by
    rw [hint]
    exact Proj.isAffineOpen_basicOpen (reesGrading I) (f * g) hfg two_pos
  rw [← htop]
  refine Stacks.Cohomology.TwoCover.isZero_Hgroup_one_of_surjective _ h₀ h₁ h₀₁ ?_
  intro c
  let d : Γ(AlgebraicGeometry.Proj (reesGrading I), Proj.basicOpen (reesGrading I) (f * g)) :=
    (AlgebraicGeometry.Proj (reesGrading I)).presheaf.map (homOfLE hint.ge).op (secToΓ c)
  obtain ⟨z₀, z₁, hz⟩ := exists_awayMap_add_awayMap_eq (reesGrading I) hf hg hgen
    ((Proj.basicOpenIsoAway (reesGrading I) (f * g) hfg two_pos).inv d)
  refine ⟨Γtosec (-(Proj.awayToSection (reesGrading I) f z₀)),
    Γtosec (Proj.awayToSection (reesGrading I) g z₁), ?_⟩
  apply secToΓ_injective
  rw [secToΓ_sub, secToΓ_res, secToΓ_res, secToΓ_Γtosec, secToΓ_Γtosec]
  have hd : d = Proj.awayToSection (reesGrading I) (f * g)
      ((Proj.basicOpenIsoAway (reesGrading I) (f * g) hfg two_pos).inv d) :=
    (ConcreteCategory.congr_hom
      (Proj.basicOpenIsoAway (reesGrading I) (f * g) hfg two_pos).inv_hom_id d).symm
  have e0 := ConcreteCategory.congr_hom
    (Proj.awayMap_awayToSection (reesGrading I) hg (rfl : f * g = f * g)) z₀
  have e1 := ConcreteCategory.congr_hom
    (Proj.awayMap_awayToSection (reesGrading I) hf (mul_comm f g : f * g = g * f)) z₁
  rw [ConcreteCategory.comp_apply, ConcreteCategory.comp_apply] at e0 e1
  rw [hz, map_add] at hd
  change Proj.awayToSection (reesGrading I) (f * g) (awayMap (reesGrading I) hg rfl z₀) = _ at e0
  change Proj.awayToSection (reesGrading I) (f * g)
    (awayMap (reesGrading I) hf (mul_comm f g) z₁) = _ at e1
  rw [e0, e1] at hd
  have hc : secToΓ c =
      (AlgebraicGeometry.Proj (reesGrading I)).presheaf.map (homOfLE hint.le).op d := by
    show secToΓ c = ((AlgebraicGeometry.Proj (reesGrading I)).presheaf.map (homOfLE hint.ge).op ≫
      (AlgebraicGeometry.Proj (reesGrading I)).presheaf.map (homOfLE hint.le).op) (secToΓ c)
    rw [← Functor.map_comp]
    exact (ConcreteCategory.congr_hom
      ((AlgebraicGeometry.Proj (reesGrading I)).presheaf.map_id _) (secToΓ c)).symm
  rw [hc, hd]
  exact presheaf_map_add_eq_sub_neg _ _ _ _ _ _ _

end Geometry

end Stacks.Blowup

end
