module

public import Mathlib.AlgebraicGeometry.Stalk
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Blowup.ReesAlgebra.AffineCharts
public import StacksFrontier.AlgebraicGeometry.Divisors.FittingIdeals.Basic
public import StacksFrontier.AlgebraicGeometry.KerDetected.RingColimit

/-!
# Recognizing an affine chart of a blowup

A point of the blowup of `X` in a quasi-coherent ideal `I`, lying over an affine open `U` of the
base, belongs to the standard chart attached to a section `a` of `I` on `U` exactly when the
image of `a` generates the ideal of the exceptional divisor in the local ring of the blowup at
that point.

## Main results

* `AlgebraicGeometry.mem_affineBlowupStandardOpen_iff_exceptionalIdeal_stalk_eq_span`
  characterizes membership in the canonical affine blowup chart.

## Implementation notes

The chart is the image of the standard open immersion of the local Rees projective spectrum,
through the affine chart isomorphism `AlgebraicGeometry.affineBlowupStandardOpenIso`. The
exceptional divisor is the inverse-image ideal sheaf `AlgebraicGeometry.exceptionalIdeal`, and
its local ideal is `AlgebraicGeometry.IdealSheafData.stalk`; equality with the principal ideal
generated by the image of `a` says that `a` cuts out the exceptional divisor locally.

Both sides of the equivalence are transported to the coordinate ring of a chart: the left-hand
side becomes non-membership of the fraction `a / b` in the prime of the point
(`mem_basicOpen_iff_fraction_not_mem`), and the right-hand side becomes the statement that the
image of the ideal in the local ring of the affine blowup algebra is generated by the image of
`a` (`localIdeal_eq_span_iff_on_affine_chart`); those two are identified by
`affineBlowup_stalk_span_iff`, which says each is equivalent to `a / b` being a unit.

## References

* [Stacks Project, Tag 0BFL](https://stacks.math.columbia.edu/tag/0BFL)
-/

@[expose] public noncomputable section

namespace AlgebraicGeometry

open CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

/-- The ideal induced by an ideal sheaf in the local ring at a point of an affine open is generated
by the germs of the sections of the ideal there. -/
private theorem idealStalk_eq_map_germ
    {X : Scheme.{u}} (J : X.IdealSheafData) (x : X)
    (U : X.affineOpens) (hx : x ∈ U.1) :
    AlgebraicGeometry.IdealSheafData.stalk J x =
      (J.ideal U).map (X.presheaf.germ U.1 x hx).hom := by
  rw [AlgebraicGeometry.IdealSheafData.stalk]
  apply le_antisymm
  · refine iSup_le fun V ↦ iSup_le fun hxV ↦ ?_
    obtain ⟨f, g, hfg, hxf⟩ :=
      exists_basicOpen_le_affine_inter U.2 V.2 x ⟨hx, hxV⟩
    let W := X.affineBasicOpen f
    have hWU : W ≤ U := X.basicOpen_le f
    have hWV : W ≤ V := hfg.trans_le (X.basicOpen_le g)
    have hxW : x ∈ W.1 := hxf
    have key : ∀ (T : X.affineOpens) (hxT : x ∈ T.1), W ≤ T →
        (J.ideal T).map (X.presheaf.germ T.1 x hxT).hom =
          (J.ideal W).map (X.presheaf.germ W.1 x hxW).hom := fun T hxT hWT ↦ by
      rw [← J.map_ideal hWT, Ideal.map_map]
      congr 1
      exact (CommRingCat.hom_ext_iff.mp (X.presheaf.germ_res (homOfLE hWT) x hxW)).symm
    exact le_of_eq ((key V hxV hWV).trans (key U hx hWU).symm)
  · exact le_iSup_of_le U (le_iSup_of_le hx le_rfl)

/-- The ideal of global sections of the inverse image of an ideal sheaf along a morphism of affine
schemes is generated by the image of the ideal of global sections. -/
private theorem idealComap_top {X Y : Scheme.{u}} [IsAffine X] [IsAffine Y]
    (f : Y ⟶ X) (J : X.IdealSheafData) :
    (J.comap f).ideal ⟨⊤, isAffineOpen_top Y⟩ =
      Ideal.map (f.appTop).hom (J.ideal ⟨⊤, isAffineOpen_top X⟩) := by
  let : IsAffine J.subscheme :=
    (IsClosedImmersion.isAffine_surjective_of_isAffine J.subschemeι).1
  have hsq := isPushout_appTop_of_isPullback
    (IsPullback.of_hasPullback f J.subschemeι)
  have hk := AlgebraicGeometry.GoodDiagramKer.ker_eq_map_of_isPushout_of_surjective
    (J.subschemeι.appTop).hom (f.appTop).hom
    ((pullback.snd f J.subschemeι).appTop).hom
    ((pullback.fst f J.subschemeι).appTop).hom (by simpa using hsq.flip)
    (IsClosedImmersion.isAffine_surjective_of_isAffine J.subschemeι).2
  show (pullback.fst f J.subschemeι).ker.ideal _ = _
  rw [Scheme.Hom.ker_apply, ← J.ker_subschemeι_app]
  exact hk

/-- Transporting the sections map of a morphism along equalities of the two opens conjugates it
by the corresponding restriction isomorphisms. -/
private lemma appLE_eqToHom_conj {X Y : Scheme.{u}} (f : Y ⟶ X)
    {U U' : X.Opens} {V V' : Y.Opens} (hU : U' = U) (hV : V' = V)
    (e : V ≤ f ⁻¹ᵁ U) (e' : V' ≤ f ⁻¹ᵁ U') :
    f.appLE U V e =
      X.presheaf.map (eqToHom hU).op ≫ f.appLE U' V' e' ≫
        Y.presheaf.map (eqToHom hV.symm).op := by
  subst hU hV
  simp

/-- The ideal of the inverse image of an ideal sheaf on an affine open `V` of the source contained
in the preimage of an affine open `U` of the target is generated by the image of the ideal
on `U`. -/
private theorem idealComap_of_le {X Y : Scheme.{u}} (J : X.IdealSheafData)
    (f : Y ⟶ X) (U : X.affineOpens) (V : Y.affineOpens)
    (hVU : (V : Y.Opens) ≤ f ⁻¹ᵁ (U : X.Opens)) :
    (J.comap f).ideal V = (J.ideal U).map (f.appLE U V hVU).hom := by
  suffices key : ∀ (U' : X.affineOpens) (V' : Y.affineOpens),
      U' = ⟨(U : X.Opens).ι ''ᵁ ⊤,
        by simpa only [Scheme.Opens.ι_image_top] using U.2⟩ →
      V' = ⟨(V : Y.Opens).ι ''ᵁ ⊤,
        by simpa only [Scheme.Opens.ι_image_top] using V.2⟩ →
      ∀ (e : (V' : Y.Opens) ≤ f ⁻¹ᵁ (U' : X.Opens)),
        (J.comap f).ideal V' = (J.ideal U').map (f.appLE U' V' e).hom from
    key U V (Subtype.ext (U : X.Opens).ι_image_top.symm)
      (Subtype.ext (V : Y.Opens).ι_image_top.symm) hVU
  rintro _ _ rfl rfl e
  have h := idealComap_top (f.resLE U V hVU) (J.comap (U : X.Opens).ι)
  rw [← Scheme.IdealSheafData.comap_comp, Scheme.Hom.resLE_comp_ι,
    Scheme.IdealSheafData.comap_comp,
    Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion (J.comap f) (V : Y.Opens).ι,
    Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion J (U : X.Opens).ι] at h
  simp only [Scheme.Opens.ι_appIso, Iso.refl_inv, Scheme.Hom.appTop,
    Scheme.Hom.resLE_app_top] at h
  convert h using 2 <;> try rfl
  congr 1
  simp only [Scheme.Opens.topIso_hom, Scheme.Opens.topIso_inv]
  exact appLE_eqToHom_conj f ((↑U : X.Opens).ι_image_top).symm
    ((↑V : Y.Opens).ι_image_top).symm e hVU

/-- The ideal induced in a local ring by the inverse image of an ideal sheaf is the image of the
ideal induced by the ideal sheaf in the local ring of the image point. -/
public theorem idealStalk_comap_eq_map {X Y : Scheme.{u}} (f : X ⟶ Y)
    (J : Y.IdealSheafData) (x : X) :
    AlgebraicGeometry.IdealSheafData.stalk (J.comap f) x =
      (AlgebraicGeometry.IdealSheafData.stalk J (f x)).map (f.stalkMap x).hom := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    Y.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (f x)) isOpen_univ
  let Ua : Y.affineOpens := ⟨U, hU⟩
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVU⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxU (f ⁻¹ᵁ U).isOpen
  let Va : X.affineOpens := ⟨V, hV⟩
  have hVUo : (V : X.Opens) ≤ (f ⁻¹ᵁ U : X.Opens) := hVU
  have hxPre : x ∈ f ⁻¹ᵁ U := hxU
  let rVUcat := X.presheaf.map
    (homOfLE (X := X.Opens) (show (V : X.Opens) ≤ (f ⁻¹ᵁ U : X.Opens) from hVU)).op
  have hres : rVUcat ≫ X.presheaf.germ V x hxV =
      X.presheaf.germ (f ⁻¹ᵁ U) x hxPre :=
    X.presheaf.germ_res
      (homOfLE (X := X.Opens) (show (V : X.Opens) ≤ (f ⁻¹ᵁ U : X.Opens) from hVU)) x hxV
  rw [idealStalk_eq_map_germ (J.comap f) x Va hxV, idealComap_of_le J f Ua Va hVUo,
    idealStalk_eq_map_germ J (f x) Ua hxU, Ideal.map_map, Ideal.map_map]
  congr 1
  apply CommRingCat.hom_ext_iff.mp
  calc
    f.appLE U V hVUo ≫ X.presheaf.germ V x hxV =
        f.app U ≫ X.presheaf.germ (f ⁻¹ᵁ U) x hxU := by
          show (f.app U ≫ X.presheaf.map (homOfLE hVUo).op) ≫
            X.presheaf.germ V x hxV =
              f.app U ≫ X.presheaf.germ (f ⁻¹ᵁ U) x hxPre
          show (f.app U ≫ rVUcat) ≫ X.presheaf.germ V x hxV = _
          rw [Category.assoc, hres]
    _ = Y.presheaf.germ U (f x) hxU ≫ f.stalkMap x :=
        (f.germ_stalkMap U x hxU).symm

/-- The exceptional ideal is locally generated by the image of `a` exactly when the image of the
ideal on the affine open is, in the local ring at the point. -/
private theorem exceptionalStalk_eq_span_iff_localIdeal_eq_span
    {X : Scheme.{u}} (I : X.IdealSheafData) (U : X.affineOpens)
    (a : I.ideal U) (x : (blowUp I))
    (hx : (blowUpToBase I) x ∈ U.1) :
    AlgebraicGeometry.IdealSheafData.stalk (exceptionalIdeal I) x =
        Ideal.span {((blowUpToBase I).stalkMap x)
          (X.presheaf.germ U.1 ((blowUpToBase I) x) hx
            (a : X.presheaf.obj (.op U.1)))} ↔
    (I.ideal U).map (((blowUpToBase I).stalkMap x).hom.comp
        (X.presheaf.germ U.1 ((blowUpToBase I) x) hx).hom) =
        Ideal.span {((blowUpToBase I).stalkMap x)
          (X.presheaf.germ U.1 ((blowUpToBase I) x) hx
            (a : X.presheaf.obj (.op U.1)))} := by
  dsimp only [exceptionalIdeal]
  rw [idealStalk_comap_eq_map]
  change
    (Ideal.map ((blowUpToBase I).stalkMap x).hom
      (AlgebraicGeometry.IdealSheafData.stalk I ((blowUpToBase I) x)) =
        Ideal.span {((blowUpToBase I).stalkMap x)
          (X.presheaf.germ U.1 ((blowUpToBase I) x) hx
            (a : X.presheaf.obj (.op U.1)))}) ↔
      (Ideal.map (((blowUpToBase I).stalkMap x).hom.comp
        (X.presheaf.germ U.1 ((blowUpToBase I) x) hx).hom)
        (I.ideal U) =
        Ideal.span {((blowUpToBase I).stalkMap x)
          (X.presheaf.germ U.1 ((blowUpToBase I) x) hx
            (a : X.presheaf.obj (.op U.1)))})
  rw [idealStalk_eq_map_germ I ((blowUpToBase I) x) U hx, Ideal.map_map]

/-- If a morphism factors over an affine open of its target as `Spec` of a ring map, the composite
of the germ map with the two stalk maps is that ring map followed by the canonical map to the
stalk. -/
private theorem germ_stalkMap_of_affine_factorization
    {X Y : Scheme.{u}} (f : Y ⟶ X) (U : X.affineOpens)
    {B : CommRingCat.{u}} (j : Spec B ⟶ Y) (q : Γ(X, U.1) ⟶ B)
    (hj : j ≫ f = Spec.map q ≫ U.2.fromSpec)
    (z : Spec B) (hz : f (j z) ∈ U.1) :
    X.presheaf.germ U.1 (f (j z)) hz ≫ f.stalkMap (j z) ≫ j.stalkMap z =
      q ≫ StructureSheaf.toStalk B z := by
  let : IsOpenImmersion U.2.fromSpec := IsAffineOpen.isOpenImmersion_fromSpec U.2
  apply Spec.map_injective
  apply (cancel_mono U.2.fromSpec).mp
  simp only [Spec.map_comp, Category.assoc]
  rw [show Spec.map (X.presheaf.germ U.1 (f (j z)) hz) ≫ U.2.fromSpec =
    X.fromSpecStalk (f (j z)) from U.2.fromSpecStalk_eq_fromSpecStalk hz]
  rw [Scheme.SpecMap_stalkMap_fromSpecStalk, ← Category.assoc,
    Scheme.SpecMap_stalkMap_fromSpecStalk, Category.assoc, hj,
    Spec.fromSpecStalk_eq']
  exact (Category.assoc _ _ _).symm.trans
    (congrArg (fun w => w ≫ U.2.fromSpec)
      (Spec.map_comp q (StructureSheaf.toStalk B z)).symm)

/-- The generating fraction `a / b` of the affine blowup algebra of `J` at `b`, for `a` in `J`. -/
private def affineBlowupFraction {R : Type*} [CommRing R]
    (J : Ideal R) (b : R) (a : J) :
    affineBlowupAlgebra J b (Localization.Away b) :=
  ⟨IsLocalization.mk' (Localization.Away b) (a : R) ⟨b, Submonoid.mem_powers b⟩,
    Algebra.subset_adjoin ⟨(a : R), a.2, rfl⟩⟩

/-- Multiplying the fraction `a / b` by `b` gives `a`. -/
private theorem affineBlowupFraction_mul {R : Type*} [CommRing R]
    (J : Ideal R) (b : R) (a : J) :
    algebraMap R (affineBlowupAlgebra J b (Localization.Away b)) b *
      affineBlowupFraction J b a =
      algebraMap R (affineBlowupAlgebra J b (Localization.Away b)) a :=
  Subtype.ext <| (mul_comm _ _).trans (IsLocalization.mk'_spec _ _ _)

/-- The image of `b` in the affine blowup algebra at `b` is a nonzerodivisor. -/
theorem affineBlowup_isRegular {R : Type*} [CommRing R]
    (J : Ideal R) (b : R) :
    IsRegular (algebraMap R (affineBlowupAlgebra J b (Localization.Away b)) b) := by
  rw [isRegular_iff_mem_nonZeroDivisors, mem_nonZeroDivisors_iff_right]
  intro c hc
  apply Subtype.ext
  have hb := (IsLocalization.Away.algebraMap_isUnit (S := Localization.Away b) b).isRegular
  apply hb.left
  show algebraMap R (Localization.Away b) b * c.1 =
    algebraMap R (Localization.Away b) b * 0
  simpa [mul_comm] using congrArg Subtype.val hc

/-- For a regular element `b` of a ring, the ideal generated by `b` equals the ideal generated by
`b * q` exactly when `q` is a unit. -/
private theorem span_mul_eq_span_iff {R : Type*} [CommRing R]
    (b q : R) (hb : IsRegular b) :
    Ideal.span {b} = Ideal.span {b * q} ↔ IsUnit q := by
  refine ⟨fun h ↦ ?_, fun hq ↦ (Ideal.span_singleton_mul_right_unit hq b).symm⟩
  have hm : b ∈ Ideal.span {b * q} := h ▸ Ideal.subset_span (Set.mem_singleton b)
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp hm
  exact isUnit_iff_exists_inv.mpr ⟨c, hb.left (by simpa [mul_assoc] using hc.symm)⟩

/-- Transported to an affine chart of the source, the statement that the image of an ideal in a
local ring is generated by the image of one of its elements becomes the same statement about
the coordinate ring of the chart. -/
private theorem localIdeal_eq_span_iff_on_affine_chart
    {X Y : Scheme.{u}} (f : Y ⟶ X) (U : X.affineOpens)
    {B : CommRingCat.{u}} (j : Spec B ⟶ Y) [IsOpenImmersion j]
    (q : Γ(X, U.1) ⟶ B) (hj : j ≫ f = Spec.map q ≫ U.2.fromSpec)
    (z : Spec B) (hz : f (j z) ∈ U.1) (J : Ideal Γ(X, U.1)) (a : Γ(X, U.1)) :
    J.map ((f.stalkMap (j z)).hom.comp (X.presheaf.germ U.1 (f (j z)) hz).hom) =
      Ideal.span {(f.stalkMap (j z)) (X.presheaf.germ U.1 (f (j z)) hz a)} ↔
    (J.map q.hom).map (StructureSheaf.toStalk B z).hom =
      Ideal.span {(StructureSheaf.toStalk B z) (q a)} := by
  have hi : Function.Bijective (j.stalkMap z).hom :=
    (asIso (j.stalkMap z)).commRingCatIsoToRingEquiv.bijective
  have hinj : Function.Injective (Ideal.map (j.stalkMap z).hom) := fun K L h ↦ by
    simpa only [Ideal.comap_map_of_bijective _ hi] using
      congrArg (Ideal.comap (j.stalkMap z).hom) h
  rw [← hinj.eq_iff, Ideal.map_map, Ideal.map_span, Set.image_singleton,
    Ideal.map_map]
  have he := congrArg CommRingCat.Hom.hom
    (germ_stalkMap_of_affine_factorization f U j q hj z hz)
  change (j.stalkMap z).hom.comp
    ((f.stalkMap (j z)).hom.comp (X.presheaf.germ U.1 (f (j z)) hz).hom) =
    (StructureSheaf.toStalk B z).hom.comp q.hom at he
  rw [he]
  have hea := DFunLike.congr_fun he a
  exact (congrArg (fun c => Ideal.map ((StructureSheaf.toStalk B z).hom.comp q.hom) J =
    Ideal.span {c}) hea).to_iff

/-- A point of an affine chart of a standard open `D₊(f)` of a projective spectrum lies in
`D₊(g)` exactly when the fraction `g / f` is not in its prime. -/
private theorem mem_basicOpen_iff_fraction_not_mem
    {A : Type u} {σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
    (𝒜 : ℕ → σ) [GradedRing 𝒜] {f g : A} (hf : f ∈ 𝒜 1) (hg : g ∈ 𝒜 1)
    {B : CommRingCat.{u}} (e : Spec B ≅ (Proj.basicOpen 𝒜 f).toScheme)
    (z : Spec B) :
    (e.hom z).1 ∈ Proj.basicOpen 𝒜 g ↔
      (Spec.preimage (e.hom ≫ (Proj.basicOpenIsoSpec 𝒜 f hf (by omega)).hom)).hom
        (HomogeneousLocalization.Away.mk 𝒜 hf 1 g (by simpa using hg)) ∉ z.asIdeal := by
  let q := Spec.preimage (e.hom ≫ (Proj.basicOpenIsoSpec 𝒜 f hf (by omega)).hom)
  have he : Spec.map q ≫ Proj.awayι 𝒜 f hf (by omega) =
      e.hom ≫ (Proj.basicOpen 𝒜 f).ι := by
    simp [q, Proj.awayι]
  have hpre : (e.hom ≫ (Proj.basicOpen 𝒜 f).ι) ⁻¹ᵁ Proj.basicOpen 𝒜 g =
      PrimeSpectrum.basicOpen (q.hom
        (HomogeneousLocalization.Away.mk 𝒜 hf 1 g (by simpa using hg))) := by
    rw [← he, Scheme.Hom.comp_preimage, Proj.awayι_preimage_basicOpen 𝒜 hf (by omega) hg
      (by omega), SpecMap_preimage_basicOpen]
    simp only [HomogeneousLocalization.Away.isLocalizationElem, pow_one]
    rfl
  exact (congrArg (fun V => z ∈ V) hpre).to_iff

/-- The image of `J` in the affine blowup algebra at `b` is generated by the image of `b`. -/
theorem affineBlowup_ideal_map {R : Type*} [CommRing R]
    (J : Ideal R) (b : R) (hb : b ∈ J) :
    J.map (algebraMap R (affineBlowupAlgebra J b (Localization.Away b))) =
      Ideal.span {algebraMap R (affineBlowupAlgebra J b (Localization.Away b)) b} := by
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap]
    intro a ha
    exact Ideal.mem_span_singleton.mpr
      ⟨affineBlowupFraction J b ⟨a, ha⟩, (affineBlowupFraction_mul J b ⟨a, ha⟩).symm⟩
  · exact (Ideal.span_singleton_le_iff_mem _).mpr (Ideal.mem_map_of_mem _ hb)

/-- In the local ring of the affine blowup algebra at `b`, the image of `J` is generated by the
image of `a` exactly when the fraction `a / b` is a unit there. -/
private theorem affineBlowup_stalk_span_iff {R : Type u} [CommRing R]
    (J : Ideal R) (b : R) (hb : b ∈ J) (a : J)
    (z : Spec (.of (affineBlowupAlgebra J b (Localization.Away b)))) :
    (J.map (algebraMap R (affineBlowupAlgebra J b (Localization.Away b)))).map
      (StructureSheaf.toStalk _ z).hom =
      Ideal.span {(StructureSheaf.toStalk _ z)
        (algebraMap R (affineBlowupAlgebra J b (Localization.Away b)) a)} ↔
      affineBlowupFraction J b a ∉ z.asIdeal := by
  let B := affineBlowupAlgebra J b (Localization.Away b)
  let p : PrimeSpectrum B := z
  let : p.asIdeal.IsPrime := p.2
  let : Algebra B ((Spec (.of B)).presheaf.stalk z) := StructureSheaf.stalkAlgebra B p
  let : IsLocalization p.asIdeal.primeCompl ((Spec (.of B)).presheaf.stalk z) :=
    StructureSheaf.IsLocalization.to_stalk B p
  have hreg : IsRegular ((StructureSheaf.toStalk B z) (algebraMap R B b)) := by
    rw [isRegular_iff_mem_nonZeroDivisors]
    exact IsLocalization.map_nonZeroDivisors_le (M := p.asIdeal.primeCompl)
      (R := B) (S := (Spec (.of B)).presheaf.stalk z)
      ⟨_, isRegular_iff_mem_nonZeroDivisors.mp (affineBlowup_isRegular J b), rfl⟩
  rw [affineBlowup_ideal_map J b hb, Ideal.map_span, Set.image_singleton,
    ← affineBlowupFraction_mul J b a, map_mul, span_mul_eq_span_iff _ _ hreg]
  exact IsLocalization.AtPrime.isUnit_to_map_iff
    ((Spec (.of B)).presheaf.stalk z) p.asIdeal _

/-- A point of a blowup lies in the standard affine chart at `a` if and only if
the image of `a` generates the exceptional ideal in its local ring. -/
@[stacks 0BFL]
public theorem mem_affineBlowupStandardOpen_iff_exceptionalIdeal_stalk_eq_span
    {X : Scheme.{u}} (I : X.IdealSheafData) (U : X.affineOpens)
    (a : I.ideal U) (x : (blowUp I))
    (hx : (blowUpToBase I) x ∈ U.1) :
    letI := (reesSituation I).sectionRingGradedRing U.1
    letI := (reesSituation I).sectionRingGradingGradedRing U.1
    x ∈ Set.range
      ((Proj.basicOpen ((reesSituation I).sectionRingGrading U.1)
        (reesDegreeOne I U a).1).ι ≫
        (Stacks.RelativeProj.Situation.relativeProjChart (reesSituation I) U)) ↔
      AlgebraicGeometry.IdealSheafData.stalk (exceptionalIdeal I) x =
        Ideal.span {((blowUpToBase I).stalkMap x)
          (X.presheaf.germ U.1 ((blowUpToBase I) x) hx
            (a : X.presheaf.obj (.op U.1)))} := by
  classical
  let := (reesSituation I).sectionRingGradedRing U.1
  let := (reesSituation I).sectionRingGradingGradedRing U.1
