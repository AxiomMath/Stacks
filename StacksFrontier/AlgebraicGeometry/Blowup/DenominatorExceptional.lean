@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace Stacks.DenominatorBlowup

section Denominators

variable (X : Scheme.{u}) (L : SheafOfModules.{u} (Stacks.DenominatorIdeal.O X))
  (s : MeromorphicSection.{u, u} X.sheaf L)

/-- **The denominators of `s` over an open set**, as an ideal of the ring of sections there: the
image of the inclusion of the denominator ideal in the structure sheaf. -/
def denominators (W : Opens X) : Ideal Γ(X, W) :=
  ((DenominatorIdeal.denominatorIdealι X L s).val.app (op W)).hom.range

/-- Membership in `Stacks.DenominatorBlowup.denominators` is the denominator condition of Stacks
Tag 02P0: being the image of a section of the denominator ideal. -/
theorem mem_denominators_iff (W : Opens X) (g : Γ(X, W)) :
    g ∈ denominators X L s W ↔
      ∃ d : (DenominatorIdeal.denominatorIdeal X L s).val.obj (op W),
        (DenominatorIdeal.denominatorIdealι X L s).val.app (op W) d = g :=
  Iff.rfl

/-- **Denominators restrict.** -/
theorem res_mem_denominators {W W' : Opens X} (h : W' ≤ W) {g : Γ(X, W)}
    (hg : g ∈ denominators X L s W) :
    X.presheaf.map (homOfLE h).op g ∈ denominators X L s W' := by
  obtain ⟨d, hd⟩ := hg
  refine ⟨(DenominatorIdeal.denominatorIdeal X L s).val.map (homOfLE h).op d, ?_⟩
  rw [← hd]
  exact PresheafOfModules.naturality_apply
    (DenominatorIdeal.denominatorIdealι X L s).val (homOfLE h).op d

variable (hL : AlgebraicGeometry.SheafOfModules.IsInvertible X.presheaf
  (Stacks.DenominatorIdeal.O X).property L)

/-- Gluing along an injective map of sheaves of modules: if `g` restricts on each member of a cover
to the image of a section `d k`, then `g` is itself the image of a section. -/
private theorem exists_eq_app_of_locally {Y : Scheme.{u}}
    {M N : SheafOfModules.{u} (Stacks.DenominatorIdeal.O Y)} (φ : M ⟶ N)
    (hφ : ∀ U : Opens Y, Function.Injective (φ.val.app (op U)).hom) {ι : Type u} {W : Opens Y}
    (V : ι → Opens Y) (hVW : ∀ k, V k ≤ W) (hcov : W ≤ ⨆ k, V k) (g : N.val.obj (op W))
    (d : ∀ k, M.val.obj (op (V k)))
    (hd : ∀ k, φ.val.app (op (V k)) (d k) = N.val.resLE (hVW k) g) :
    ∃ e : M.val.obj (op W), φ.val.app (op W) e = g := by
  classical
  have key : ∀ (k : ι) (Z : Opens Y) (hZ : Z ≤ V k),
      φ.val.app (op Z) (M.val.resLE hZ (d k)) = N.val.resLE (hZ.trans (hVW k)) g := fun k Z hZ => by
    rw [PresheafOfModules.app_resLE, hd k, N.val.resLE_resLE]
  obtain ⟨e, he, -⟩ := TopCat.Sheaf.existsUnique_gluing_of_isSheafPresheaf M.isSheaf V hVW hcov d
    fun k l => hφ _ ((key k _ inf_le_left).trans (key l _ inf_le_right).symm)
  refine ⟨e, TopCat.Sheaf.eq_of_locally_eq_of_isSheafPresheaf N.isSheaf V hVW hcov fun k => ?_⟩
  rw [← PresheafOfModules.app_resLE, he k, hd k]

include hL in
/-- **Being a denominator is a local condition.**  The denominator ideal embeds in the structure
sheaf, so a compatible family of local preimages is automatically compatible and glues. -/
theorem mem_denominators_of_cover {ι : Type u} {W : Opens X} (V : ι → Opens X)
    (hVW : ∀ k, V k ≤ W) (hcov : W ≤ ⨆ k, V k) {g : Γ(X, W)}
    (h : ∀ k, X.presheaf.map (homOfLE (hVW k)).op g ∈ denominators X L s (V k)) :
    g ∈ denominators X L s W := by
  choose d hd using h
  exact exists_eq_app_of_locally (DenominatorIdeal.denominatorIdealι X L s)
    (fun U => CategoryTheory.SheafOfModules.app_injective_of_mono
      (Stacks.DenominatorIdealInvertible.denominatorIdeal_inclusion_mono X L s hL) (op U))
    V hVW hcov g d hd

include hL in
/-- **`s` really is a section of `L` over the maximal open `U` of Stacks Tag 0ESL: the supremum
is a maximum.**  Over each member of a cover of `U` by opens on which `s` is a section there is a
witness in `L`; the witnesses agree on the overlaps because `L ⟶ K_X(L)` is injective on sections
for an invertible `L`, so they glue to a section of `L` over `U`, whose image in `K_X(L)` agrees
with `s` locally and hence everywhere. -/
theorem isSectionOver_sectionOpens : IsSectionOver L s (sectionOpens L s) := by
  have hcover : ∀ x : {x : X // x ∈ sectionOpens L s}, ∃ V : Opens X,
      x.1 ∈ V ∧ V ≤ sectionOpens L s ∧ IsSectionOver L s V := by
    rintro ⟨x, hx⟩
    rw [sectionOpens_eq_compl_support L s hL] at hx
    obtain ⟨V, hxV, hV⟩ := exists_isSectionOver_of_notMem_support L s hL hx
    exact ⟨V, hxV, le_sectionOpens L s hV, hV⟩
  choose V hxV hVU hV using hcover
  choose t ht using hV
  exact exists_eq_app_of_locally (DenominatorIdeal.toK X L)
    (fun W => CategoryTheory.SheafOfModules.app_injective_of_mono
      (Stacks.DenominatorIdealInvertible.mono_toK X L hL) (op W))
    V hVU (fun y hy => TopologicalSpace.Opens.mem_iSup.2 ⟨⟨y, hy⟩, hxV ⟨y, hy⟩⟩) _ t
    fun k => (ht k).trans (s.2 (homOfLE (hVU k)).op).symm

end Denominators

section Pullback

variable {X Y : Scheme.{u}} (f : X ⟶ Y)
  (hf : AlgebraicGeometry.PullbacksMeromorphicSections f.toLRSHom)
  (N : SheafOfModules.{u} (Stacks.DenominatorIdeal.O Y))
  (t : MeromorphicSection.{u, u} Y.sheaf N)

/-- **The pullback of a denominator is a denominator.**  If `c · t` is a section of `N` over `V`,
then `f^♯ c · f^* t` is a section of `f^* N` over `f⁻¹(V)`, namely the pullback of that
section. -/
theorem app_mem_denominators (V : Opens Y) {c : Γ(Y, V)} (hc : c ∈ denominators Y N t V) :
    f.app V c ∈ denominators X
      ((RingedSpaceModuleAdjunction.modulePullback f.toLRSHom.toShHom).obj N)
      (AlgebraicGeometry.pullbackMeromorphicSection f.toLRSHom hf N t) (f ⁻¹ᵁ V) := by
  obtain ⟨a, ha⟩ :=
    (DenominatorIdeal.denominatorIdeal_sections Y N t V c).mp hc
  have hba : (show Y.sheaf.presheaf.obj (op V) from c) •
        (t : MeromorphicSection Y.toLocallyRingedSpace.sheaf N).valOver V =
      ((Stacks.Divisors.toMeromorphicSectionSheaf Y.sheaf N).app (op V)).hom a := ha
  have key := AlgebraicGeometry.smul_pullbackMeromorphicSection_valOver f.toLRSHom hf N t V
    (show Y.sheaf.presheaf.obj (op V) from c) a hba
  refine (DenominatorIdeal.denominatorIdeal_sections X _ _ (f ⁻¹ᵁ V) (f.app V c)).mpr
    ⟨AlgebraicGeometry.modulePullbackUnitApp f.toLRSHom N V a, ?_⟩
  have hpb : AlgebraicGeometry.pullbackSectionOver f.toLRSHom
      ((Opens.map f.base).obj V) V le_rfl c = f.app V c := by
    change X.presheaf.map (homOfLE le_rfl).op (f.app V c) = _
    rw [show (homOfLE (le_rfl : (Opens.map f.base).obj V ≤ (Opens.map f.base).obj V)) = 𝟙 _ from
      Subsingleton.elim _ _, op_id, X.presheaf.map_id]
    rfl
  rw [hpb] at key
  exact key

end Pullback

section Blowup

variable {X : Scheme.{u}} (L : SheafOfModules.{u} (Stacks.DenominatorIdeal.O X))
  (s : MeromorphicSection.{u, u} X.sheaf L)

/-- The centre of the blowup: the ideal of denominators of `s`, as ideal-sheaf data. -/
abbrev centre : X.IdealSheafData :=
  Stacks.DenominatorIdealQcoh.denominatorIdealData X L s

/-- The blowup of `X` in the ideal of denominators of `s`. -/
abbrev blow : Scheme.{u} := AlgebraicGeometry.blowUp (centre L s)

/-- The blowup morphism `b : X' ⟶ X`. -/
abbrev blowHom : blow L s ⟶ X := AlgebraicGeometry.blowUpToBase (centre L s)

/-- The pullback `b^* L`. -/
abbrev pullL : SheafOfModules.{u} (Stacks.DenominatorIdeal.O (blow L s)) :=
  (RingedSpaceModuleAdjunction.modulePullback (blowHom L s).toLRSHom.toShHom).obj L

/-- The pullback `b^* s`, a meromorphic section of `b^* L`. -/
abbrev pullS : MeromorphicSection.{u, u} (blow L s).sheaf (pullL L s) :=
  AlgebraicGeometry.pullbackMeromorphicSection (blowHom L s).toLRSHom
    (AlgebraicGeometry.pullbacksMeromorphicSections_blowUpToBase (centre L s)) L s

/-- The ideal sheaf of the exceptional divisor `E`. -/
abbrev exceptional : (blow L s).IdealSheafData :=
  AlgebraicGeometry.exceptionalIdeal (centre L s)

variable (hL : AlgebraicGeometry.SheafOfModules.IsInvertible X.presheaf
  (Stacks.DenominatorIdeal.O X).property L)

include hL in
/-- **The pullback `b^* L` is invertible**, Stacks Tag 0B8L for the blowup morphism. -/
theorem isInvertible_pullL : AlgebraicGeometry.SheafOfModules.IsInvertible (blow L s).presheaf
    (Stacks.DenominatorIdeal.O (blow L s)).property (pullL L s) :=
  @Stacks.InvertiblePullback.isInvertible_pullback' _ _ (blowHom L s).toLRSHom.toShHom L hL

include hL in
/-- **On an affine chart the exceptional ideal consists of denominators of `b^* s`.**  The
exceptional ideal on an affine open `U` of the blowup lying over an affine open `V` of `X` is
generated by the pullbacks of the denominators of `s` on `V`, and each of those is a denominator
of `b^* s`. -/
theorem ideal_exceptional_le_denominators (V : X.affineOpens) (U : (blow L s).affineOpens)
    (hUV : (U : Opens (blow L s)) ≤ blowHom L s ⁻¹ᵁ (V : Opens X)) :
    (exceptional L s).ideal U ≤ denominators (blow L s) (pullL L s) (pullS L s) U := by
  rw [Stacks.IdealSheaf.ideal_comap_appLE (centre L s) (blowHom L s) V U hUV,
    Ideal.map_le_iff_le_comap]
  intro c hc
  have hcden : c ∈ denominators X L s (V : X.Opens) := by
    rw [denominators, ← Stacks.DenominatorIdealQcoh.denominatorIdealData_ideal X L s hL V]
    exact hc
  have hres := res_mem_denominators (blow L s) (pullL L s) (pullS L s) hUV
    (app_mem_denominators (blowHom L s)
      (AlgebraicGeometry.pullbacksMeromorphicSections_blowUpToBase (centre L s)) L s
      (V : X.Opens) hcden)
  exact hres

include hL in
/-- **Every section of the ideal sheaf of the exceptional divisor is a denominator of `b^* s`.**
Over an affine open of the blowup lying over an affine open of `X` this is
`Stacks.DenominatorBlowup.ideal_exceptional_le_denominators`, and being a denominator is a local
condition. -/
theorem mem_denominators_of_subschemeι_app_eq_zero {W : Opens (blow L s)}
    {r : Γ(blow L s, W)} (hr : (exceptional L s).subschemeι.app W r = 0) :
    r ∈ denominators (blow L s) (pullL L s) (pullS L s) W := by
  classical
  have hchart : ∀ x : W, ∃ U : Opens (blow L s), ∃ hU : IsAffineOpen U, x.1 ∈ U ∧ U ≤ W ∧
      ∃ V : X.affineOpens, U ≤ blowHom L s ⁻¹ᵁ (V : X.Opens) := by
    rintro ⟨x, hx⟩
    obtain ⟨_, ⟨V, hV, rfl⟩, hxV, -⟩ := X.isBasis_affineOpens.exists_subset_of_mem_open
      (Set.mem_univ (blowHom L s x)) isOpen_univ
    obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUle⟩ := (blow L s).isBasis_affineOpens.exists_subset_of_mem_open
      (show x ∈ W ⊓ blowHom L s ⁻¹ᵁ V from ⟨hx, hxV⟩) (W ⊓ blowHom L s ⁻¹ᵁ V).isOpen
    exact ⟨U, hU, hxU, fun y hy => (hUle hy).1, ⟨V, hV⟩, fun y hy => (hUle hy).2⟩
  choose U hU hxU hUW V hUV using hchart
  refine mem_denominators_of_cover (blow L s) (pullL L s) (pullS L s)
    (isInvertible_pullL L s hL) U hUW
    (fun y hy => Opens.mem_iSup.2 ⟨⟨y, hy⟩, hxU ⟨y, hy⟩⟩) fun k => ?_
  refine ideal_exceptional_le_denominators L s hL (V k) ⟨U k, hU k⟩ (hUV k) ?_
  rw [← (exceptional L s).ker_subschemeι_app ⟨U k, hU k⟩]
  exact Stacks.Divisors.subschemeι_app_eq_zero_of_le (exceptional L s) (hUW k) hr

/-! ### The morphism `ℐ_E ⟶ b^* L` -/

/-- The ideal sheaf of the exceptional divisor, read as a sheaf of `𝒪_{X'}`-modules in the
spelling the denominator ideal uses.  The two spellings of the structure sheaf of rings,
`Stacks.DenominatorIdeal.O` and `RingedSpaceModuleAdjunction.structureSheafRing`, are equal by
`rfl`; crossing them once here keeps every statement below in a single category. -/
abbrev exceptionalSheaf : SheafOfModules.{u} (Stacks.DenominatorIdeal.O (blow L s)) :=
  Stacks.Divisors.idealSheafOfModules (exceptional L s)

/-- The inclusion `ℐ_E ⟶ 𝒪_{X'}` of the ideal sheaf of the exceptional divisor in the structure
sheaf: the kernel inclusion of `𝒪_{X'} ⟶ i_* 𝒪_E`. -/
abbrev exceptionalι :
    exceptionalSheaf L s ⟶ SheafOfModules.unit (Stacks.DenominatorIdeal.O (blow L s)) :=
  kernel.ι (Stacks.Divisors.subschemeStructureHom (exceptional L s))

include hL in
/-- Every section of `ℐ_E` is, as a section of the structure sheaf, a denominator of `b^* s`.
This is `Stacks.DenominatorBlowup.mem_denominators_of_subschemeι_app_eq_zero` read through the
inclusion `ℐ_E ⟶ 𝒪_{X'}`. -/
theorem exceptionalι_app_mem_denominators {W : Opens (blow L s)}
    (y : (exceptionalSheaf L s).val.obj (op W)) :
    (exceptionalι L s).val.app (op W) y ∈
      denominators (blow L s) (pullL L s) (pullS L s) W :=
  mem_denominators_of_subschemeι_app_eq_zero L s hL
    (Stacks.Divisors.subschemeι_app_idealSheafSection (exceptional L s) y)

include hL in
/-- The inclusion of the denominator ideal of `b^* s` in the structure sheaf of the blowup is
injective on the sections over every open set. -/
theorem denominatorIdealι_app_injective_pullS (W : Opens (blow L s)) :
    Function.Injective
      (((DenominatorIdeal.denominatorIdealι (blow L s) (pullL L s) (pullS L s)).val.app
        (op W)).hom) :=
  CategoryTheory.SheafOfModules.app_injective_of_mono
    (Stacks.DenominatorIdealInvertible.denominatorIdeal_inclusion_mono (blow L s) (pullL L s)
      (pullS L s) (isInvertible_pullL L s hL)) (op W)

/-- **The denominator of `b^* s` above a section of `ℐ_E`.**  The inclusion of the denominator
ideal is injective, so this is the unique section of the denominator ideal lying over the given
section of `ℐ_E`; see
`Stacks.DenominatorBlowup.denominatorIdealι_app_exceptionalDenominator`. -/
noncomputable def exceptionalDenominator {W : Opens (blow L s)}
    (y : (exceptionalSheaf L s).val.obj (op W)) :
    (DenominatorIdeal.denominatorIdeal (blow L s) (pullL L s) (pullS L s)).val.obj (op W) :=
  (exceptionalι_app_mem_denominators L s hL y).choose

/-- The defining property of `Stacks.DenominatorBlowup.exceptionalDenominator`. -/
theorem denominatorIdealι_app_exceptionalDenominator {W : Opens (blow L s)}
    (y : (exceptionalSheaf L s).val.obj (op W)) :
    ((DenominatorIdeal.denominatorIdealι (blow L s) (pullL L s) (pullS L s)).val.app
        (op W)).hom (exceptionalDenominator L s hL y) =
      ((exceptionalι L s).val.app (op W)).hom y :=
  (exceptionalι_app_mem_denominators L s hL y).choose_spec

/-- The assignment of denominators to sections of `ℐ_E` commutes with the restriction maps:
both sides have the same image under the injective inclusion of the denominator ideal. -/
theorem exceptionalDenominator_naturality {V W : (Opens (blow L s))ᵒᵖ} (f : V ⟶ W)
    (y : (exceptionalSheaf L s).val.obj V) :
    exceptionalDenominator L s hL (W := W.unop) ((exceptionalSheaf L s).val.map f y) =
      (DenominatorIdeal.denominatorIdeal (blow L s) (pullL L s) (pullS L s)).val.map f
        (exceptionalDenominator L s hL (W := V.unop) y) := by
  refine denominatorIdealι_app_injective_pullS L s hL W.unop ?_
  refine (denominatorIdealι_app_exceptionalDenominator L s hL (W := W.unop)
    ((exceptionalSheaf L s).val.map f y)).trans ?_
  refine (PresheafOfModules.naturality_apply (exceptionalι L s).val f y).trans ?_
  refine Eq.trans ?_ (PresheafOfModules.naturality_apply
    (DenominatorIdeal.denominatorIdealι (blow L s) (pullL L s) (pullS L s)).val f
    (exceptionalDenominator L s hL (W := V.unop) y)).symm
  exact congrArg _
    (denominatorIdealι_app_exceptionalDenominator L s hL (W := V.unop) y).symm

/-- **The ideal sheaf of the exceptional divisor, as a subsheaf of the denominator ideal of
`b^* s`.**  Every section of `ℐ_E` is a denominator of `b^* s`, and the inclusion of the
denominator ideal in the structure sheaf is injective, so the preimage is unique; uniqueness
makes the assignment additive, linear and natural. -/
noncomputable def exceptionalToDenominatorIdeal :
    exceptionalSheaf L s ⟶
      DenominatorIdeal.denominatorIdeal (blow L s) (pullL L s) (pullS L s) :=
  ⟨{ app := fun W => ModuleCat.ofHom
      { toFun := fun y => exceptionalDenominator L s hL (W := W.unop) y
        map_add' := fun y z => by
          refine denominatorIdealι_app_injective_pullS L s hL W.unop ?_
          rw [map_add, denominatorIdealι_app_exceptionalDenominator,
            denominatorIdealι_app_exceptionalDenominator,
            denominatorIdealι_app_exceptionalDenominator, map_add]
        map_smul' := fun c y => by
          refine denominatorIdealι_app_injective_pullS L s hL W.unop ?_
          rw [map_smul, denominatorIdealι_app_exceptionalDenominator,
            denominatorIdealι_app_exceptionalDenominator, map_smul]
          rfl }
     naturality := fun {_V _W} f => by
       ext y
       exact exceptionalDenominator_naturality L s hL f y }⟩

/-- The inclusion of `ℐ_E` in the denominator ideal of `b^* s` lies over the inclusion of `ℐ_E`
in the structure sheaf. -/
@[reassoc]
theorem exceptionalToDenominatorIdeal_comp_denominatorIdealι :
    exceptionalToDenominatorIdeal L s hL ≫
        DenominatorIdeal.denominatorIdealι (blow L s) (pullL L s) (pullS L s) =
      exceptionalι L s := by
  ext W y
  exact denominatorIdealι_app_exceptionalDenominator L s hL (W := W.unop) y

/-- **The morphism `ℐ_E ⟶ b^* L`**: multiplication by the meromorphic section `b^* s`, which
carries a section of the ideal sheaf of the exceptional divisor to a section of `b^* L` because
that section is a denominator of `b^* s`.  This is the sheaf-of-modules form of the inclusion
`ℐ_E · b^* s ⊆ b^* L`. -/
noncomputable def exceptionalToPullL : exceptionalSheaf L s ⟶ pullL L s :=
  exceptionalToDenominatorIdeal L s hL ≫
    DenominatorIdeal.denominatorIdealMul (blow L s) (pullL L s) (pullS L s)

/-- **The morphism `ℐ_E ⟶ b^* L` really is multiplication by `b^* s`.**  Composed with the
canonical map `b^* L ⟶ K_{X'}(b^* L)` it is the inclusion `ℐ_E ⟶ 𝒪_{X'}` followed by
multiplication by `b^* s`.

This is the *multiplied-out* form of the final assertion of [Stacks, Tag 0ESL], that `b^* s`
corresponds to `1_D ⊗ 1_E^{-1}`; see the implementation notes for why the literal form is not
yet expressible here. -/
theorem exceptionalToPullL_comp_toK :
    exceptionalToPullL L s hL ≫ DenominatorIdeal.toK (blow L s) (pullL L s) =
      exceptionalι L s ≫
        DenominatorIdeal.sectionMap (blow L s) (pullL L s) (pullS L s) := by
  have hcond : DenominatorIdeal.denominatorIdealι (blow L s) (pullL L s) (pullS L s) ≫
        DenominatorIdeal.sectionMap (blow L s) (pullL L s) (pullS L s) =
      DenominatorIdeal.denominatorIdealMul (blow L s) (pullL L s) (pullS L s) ≫
        DenominatorIdeal.toK (blow L s) (pullL L s) := pullback.condition
  rw [exceptionalToPullL, Category.assoc, ← hcond, ← Category.assoc,
    exceptionalToDenominatorIdeal_comp_denominatorIdealι]

/-- The inclusion `ℐ_E ⟶ 𝒪_{X'}` is a monomorphism, being a kernel inclusion. -/
theorem mono_exceptionalι : Mono (exceptionalι L s) :=
  have h : Mono (kernel.ι (Stacks.Divisors.subschemeStructureHom (exceptional L s))) :=
    inferInstance
  h

include hL in
/-- The inclusion of `ℐ_E` in the denominator ideal of `b^* s` is a monomorphism: it lies over
the inclusion of `ℐ_E` in the structure sheaf, which is one. -/
theorem mono_exceptionalToDenominatorIdeal : Mono (exceptionalToDenominatorIdeal L s hL) :=
  have := mono_exceptionalι L s
  mono_of_mono_fac (exceptionalToDenominatorIdeal_comp_denominatorIdealι L s hL)

include hL in
/-- **The morphism `ℐ_E ⟶ b^* L` is a monomorphism**, for a regular meromorphic section `s`.
Regularity passes to `b^* s` ([Stacks, Tag 02OY] part (2)), and multiplication by a regular
meromorphic section embeds its denominator ideal in the module ([Stacks, Tag 02P0]); the
inclusion of `ℐ_E` in that denominator ideal is itself a monomorphism. -/
theorem mono_exceptionalToPullL (hs : IsRegularMeromorphicSection X.sheaf L s) :
    Mono (exceptionalToPullL L s hL) :=
  have := mono_exceptionalToDenominatorIdeal L s hL
  have := DenominatorIdeal.denominatorIdeal_section_mono (blow L s) (pullL L s) (pullS L s)
    (AlgebraicGeometry.isRegularMeromorphicSection_pullbackMeromorphicSection_of_isInvertible
      (blowHom L s).toLRSHom
      (AlgebraicGeometry.pullbacksMeromorphicSections_blowUpToBase (centre L s)) L hL s hs)
  mono_comp _ _

/-! ### `Hom(ℐ_E, b^* L) ≅ b^* L ⊗ 𝒪_{X'}(E)` -/

/-- `𝒪_{X'}(E)`, the invertible sheaf of the exceptional divisor: the dual of `ℐ_E`.  This is
[Stacks, Tag 01WX] (1) for `E`, in the spelling `Stacks.Divisors.invertibleSheaf` uses. -/
abbrev exceptionalTwist : SheafOfModules.{u} (Stacks.DenominatorIdeal.O (blow L s)) :=
  Stacks.SheafOfModules.dualSheaf (blow L s).presheaf
    (structureSheafRing (blow L s).toRingedSpace).property (exceptionalSheaf L s)

/-- A rank-one dual basis, read as a finite dual basis on a one-element index type. -/
noncomputable def finiteDualBasisOfDualBasisOne {Y : Scheme.{u}}
    {M : SheafOfModules.{u} (Stacks.DenominatorIdeal.O Y)} {V : Opens Y}
    (b : Stacks.SheafOfModules.DualBasisOne Y.presheaf
      (structureSheafRing Y.toRingedSpace).property M V) :
    Stacks.SheafOfModules.FiniteDualBasis Y.presheaf
      (structureSheafRing Y.toRingedSpace).property M V Unit where
  e _ := b.e
  lam _ := b.lam
  span Z g := by simpa using b.span Z g

/-- **`ℐ_E` has a rank-one dual basis on each member of a covering of the blowup.**  The
exceptional divisor is an effective Cartier divisor ([Stacks, Tag 02OS] (2)), so `ℐ_E` is
invertible, hence locally trivial ([Stacks, Tag 0B8M]), and a trivialization is a rank-one dual
basis. -/
theorem exists_coversTop_dualBasisOne_exceptionalSheaf :
    ∃ (ι : Type u) (V : ι → Opens (blow L s))
      (_ : (Opens.grothendieckTopology (blow L s)).CoversTop V),
      Nonempty (∀ k, Stacks.SheafOfModules.DualBasisOne (blow L s).presheaf
        (structureSheafRing (blow L s).toRingedSpace).property
        (exceptionalSheaf L s) (V k)) := by
  have hinv : Stacks.Ample.IsInvertibleModule (blow L s) (exceptionalSheaf L s) :=
    Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal (centre L s)
  obtain ⟨ι, V, hV, ε⟩ :=
    (Stacks.InvertibleRankOneScheme.isLocallyTrivial_of_isInvertibleModule
      (blow L s) (exceptionalSheaf L s)).exists_trivializing_cover
  exact ⟨ι, V, hV, ⟨fun k => Stacks.SheafOfModules.DualBasisOne.ofIsoUnit (ε k).some⟩⟩

/-- **`ℐ_E` has a finite dual basis on each member of a covering of the blowup**, namely the
rank-one basis of `Stacks.DenominatorBlowup.exists_coversTop_dualBasisOne_exceptionalSheaf` read
on the one-element index type. -/
theorem exists_coversTop_finiteDualBasis_exceptionalSheaf :
    ∃ (ι : Type u) (V : ι → Opens (blow L s))
      (_ : (Opens.grothendieckTopology (blow L s)).CoversTop V),
      Nonempty (∀ k, Stacks.SheafOfModules.FiniteDualBasis (blow L s).presheaf
        (structureSheafRing (blow L s).toRingedSpace).property
        (exceptionalSheaf L s) (V k) Unit) := by
  obtain ⟨ι, V, hV, ⟨b⟩⟩ := exists_coversTop_dualBasisOne_exceptionalSheaf L s
  exact ⟨ι, V, hV, ⟨fun k => finiteDualBasisOfDualBasisOne (b k)⟩⟩

/-- **The canonical morphism `b^* L ⊗ 𝒪_{X'}(E) ⟶ Hom(ℐ_E, b^* L)` is an isomorphism.**  It is
the rank-one map of [Stacks, Tag 08JJ] step (5), which is invertible as soon as the first
argument has finite dual bases on a covering family; for `ℐ_E` those are the rank-one bases
coming from the effective Cartier divisor `E`. -/
instance isIso_tensorDualToSheafHom_exceptional :
    IsIso (Stacks.SheafOfModules.tensorDualToSheafHom (blow L s).presheaf
      (structureSheafRing (blow L s).toRingedSpace).property
      (exceptionalSheaf L s) (pullL L s)) := by
  obtain ⟨ι, V, hV, ⟨b⟩⟩ := exists_coversTop_finiteDualBasis_exceptionalSheaf L s
  exact Stacks.SheafOfModules.isIso_tensorDualToSheafHom (blow L s).presheaf
    (structureSheafRing (blow L s).toRingedSpace).property hV b (pullL L s)

/-- **`b^* L ⊗ 𝒪_{X'}(E) ≅ Hom(ℐ_E, b^* L)`.**  This is the identification that lets the
morphism `ℐ_E ⟶ b^* L` of
`Stacks.DenominatorBlowup.exceptionalToPullL` be read as a global section of
`b^* L ⊗ 𝒪_{X'}(E)`, which is the form the proof of [Stacks, Tag 0ESL] uses. -/
noncomputable def pullLTensorExceptionalTwistIso :
    (((Stacks.SheafOfModules.Tensor.sheafTensor ⟨(blow L s).presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ ((blow L s).presheaf) (forget₂ CommRingCat RingCat)
          ((structureSheafRing (blow L s).toRingedSpace).property)⟩).obj
        ((pullL L s))).obj ((exceptionalTwist L s))) ≅
      Stacks.SheafOfModules.sheafHom (blow L s).presheaf
        (structureSheafRing (blow L s).toRingedSpace).property
        (exceptionalSheaf L s) (pullL L s) :=
  asIso (Stacks.SheafOfModules.tensorDualToSheafHom (blow L s).presheaf
    (structureSheafRing (blow L s).toRingedSpace).property
    (exceptionalSheaf L s) (pullL L s))

/-- `ℐ_E` is invertible in the spelling the tensor and dual development uses: `E` is an
effective Cartier divisor. -/
theorem stacksIsInvertible_exceptionalSheaf :
    Stacks.SheafOfModules.IsInvertible (blow L s).presheaf
      (structureSheafRing (blow L s).toRingedSpace).property (exceptionalSheaf L s) :=
  have _ : AlgebraicGeometry.SheafOfModules.IsInvertible (blow L s).presheaf
      (structureSheafRing (blow L s).toRingedSpace).property (exceptionalSheaf L s) :=
    Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal (centre L s)
  Stacks.InvertibleBridge.stacksIsInvertible_of_algebraicGeometryIsInvertible

include hL in
/-- **`b^* L ⊗ 𝒪_{X'}(E)` is invertible.**  `b^* L` is invertible by [Stacks, Tag 0B8L] and
`𝒪_{X'}(E)` is the dual of the invertible `ℐ_E`, hence invertible by [Stacks, Tag 01CT]; the
tensor product of two invertible sheaves is invertible. -/
theorem stacksIsInvertible_pullLTensorExceptionalTwist :
    Stacks.SheafOfModules.IsInvertible (blow L s).presheaf
      (structureSheafRing (blow L s).toRingedSpace).property
      ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨(blow L s).presheaf,
          Presheaf.isSheaf_of_isSheaf_comp _ ((blow L s).presheaf) (forget₂ CommRingCat RingCat)
            ((structureSheafRing (blow L s).toRingedSpace).property)⟩).obj
          ((pullL L s))).obj ((exceptionalTwist L s)))) :=
  have _ : AlgebraicGeometry.SheafOfModules.IsInvertible (blow L s).presheaf
      (structureSheafRing (blow L s).toRingedSpace).property (pullL L s) :=
    isInvertible_pullL L s hL
  have _ : Stacks.SheafOfModules.IsInvertible (blow L s).presheaf
      (structureSheafRing (blow L s).toRingedSpace).property (pullL L s) :=
    Stacks.InvertibleBridge.stacksIsInvertible_of_algebraicGeometryIsInvertible
  have _ := stacksIsInvertible_exceptionalSheaf L s
  have _ : Stacks.SheafOfModules.IsInvertible (blow L s).presheaf
      (structureSheafRing (blow L s).toRingedSpace).property (exceptionalTwist L s) :=
    Stacks.SheafOfModules.Invertible.isInvertible_dualSheaf (blow L s).presheaf
      (structureSheafRing (blow L s).toRingedSpace).property (exceptionalSheaf L s)
  Stacks.SheafOfModules.isInvertible_tensorSheaf (blow L s).presheaf
    (structureSheafRing (blow L s).toRingedSpace).property (pullL L s) (exceptionalTwist L s)

/-- The global section of `Hom(ℐ_E, b^* L)` given by the morphism `ℐ_E ⟶ b^* L`: a section of
the sheaf-hom over an open `U` *is* a morphism of the restrictions to the slice site over `U`
([Stacks, Tag 03EM]), so the global section is the restriction of that morphism to the slice
site over `⊤`. -/
noncomputable def exceptionalHomSection :
    (Stacks.SheafOfModules.sheafHom (blow L s).presheaf
      (structureSheafRing (blow L s).toRingedSpace).property
      (exceptionalSheaf L s) (pullL L s)).val.obj (op (⊤ : Opens (blow L s))) :=
  (restrFun (blow L s).presheaf ⊤).map (exceptionalToPullL L s hL).val

/-- **The global section `t` of `b^* L ⊗ 𝒪_{X'}(E)`** attached to the morphism `ℐ_E ⟶ b^* L`,
through the identification `b^* L ⊗ 𝒪_{X'}(E) ≅ Hom(ℐ_E, b^* L)`.  This is the section that
[Stacks, Tag 0ESL] calls `b^* s` read as a global regular section of `b^* L(E)`, and whose zero
scheme is the effective Cartier divisor `D`. -/
noncomputable def exceptionalTensorSection :
    ((((Stacks.SheafOfModules.Tensor.sheafTensor ⟨(blow L s).presheaf,
        Presheaf.isSheaf_of_isSheaf_comp _ ((blow L s).presheaf) (forget₂ CommRingCat RingCat)
          ((structureSheafRing (blow L s).toRingedSpace).property)⟩).obj
        ((pullL L s))).obj ((exceptionalTwist L s)))).val.obj
      (op (⊤ : Opens (blow L s))) :=
  ((pullLTensorExceptionalTwistIso L s).inv.val.app (op ⊤)) (exceptionalHomSection L s hL)

/-- The section `t` of `b^* L ⊗ 𝒪_{X'}(E)` really does correspond to the morphism
`ℐ_E ⟶ b^* L`. -/
theorem pullLTensorExceptionalTwistIso_hom_exceptionalTensorSection :
    ((pullLTensorExceptionalTwistIso L s).hom.val.app (op ⊤))
        (exceptionalTensorSection L s hL) = exceptionalHomSection L s hL := by
  have h : (pullLTensorExceptionalTwistIso L s).inv.val ≫
      (pullLTensorExceptionalTwistIso L s).hom.val = 𝟙 _ :=
    congrArg _root_.SheafOfModules.Hom.val
      (pullLTensorExceptionalTwistIso L s).inv_hom_id
  exact ConcreteCategory.congr_hom
    (congrArg (fun φ => PresheafOfModules.Hom.app φ (op (⊤ : Opens (blow L s)))) h)
    (exceptionalHomSection L s hL)

end Blowup

end Stacks.DenominatorBlowup

end
