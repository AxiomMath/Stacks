module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.SiteFiniteTypeBridge
public import StacksFrontier.AlgebraicGeometry.Blowup.ReesAlgebraFiniteType
public import StacksFrontier.AlgebraicGeometry.FormalFunctions.CohomologyIdealPowerSystem
public import StacksFrontier.AlgebraicGeometry.IdealPowerMultipleComparison.Basic

/-!
# The two models of `ℐⁿF`, and finite type of the Rees module

For an ideal sheaf `ℐ` on a scheme `X` and an `𝒪_X`-module `F`, there are two constructions of
the `n`-th member `ℐⁿF` of the ideal-power filtration of `F`:

* `Stacks.Blowup.reesMultiple`, the subsheaf generated by the products of sections of `ℐⁿ` with
  sections of `F`, the degree-`n` piece of the graded `⨁ₙ ℐⁿ`-module `⨁ₙ ℐⁿF`; and
* `Stacks.AlgebraicGeometry.IdealPower.idealPowerMultiple`, the least subsheaf dominating the
  affine-local products `ℐ(U)ⁿ·Γ(F, U)`.

This file proves that they agree, with no Noetherian and no finiteness hypothesis, and that
`⨁ₙ ℐⁿF` is a graded module of finite type over the Rees algebra when `F` is coherent.

## Main results

* `Stacks.Blowup.idealPowerMultiple_le_reesMultiple` and
  `Stacks.Blowup.reesMultiple_le_idealPowerMultiple`: the two inclusions.
* `Stacks.Blowup.reesMultiple_eq_idealPowerMultiple`: the two constructions agree, as subsheaves.
* `Stacks.Blowup.piece_reesGradedModule_natCast`: the degree-`n` piece of `⨁ₙ ℐⁿF` is the
  filtration member `idealPowerMultiple I n F`, as a sheaf of modules.
* `Stacks.Blowup.isFiniteType_reesGradedModule_of_isCoherent`: `⨁ₙ ℐⁿF` is of finite type over
  `⨁ₙ ℐⁿ` when `F` is coherent.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u

namespace Stacks.Blowup

attribute [local instance] Stacks.Algebraization.sectionsModuleΓ
  Stacks.Algebraization.sectionsModuleΓSheaf

open Stacks.AlgebraicGeometry.IdealPower

variable {X : Scheme.{u}} (I : X.IdealSheafData) (F : X.Modules)

/-- The least subsheaf of `F` dominating the affine-local products `ℐ(U)ⁿΓ(F, U)` is contained
in the subsheaf generated by the products of sections of `ℐⁿ` with sections of `F`. -/
theorem idealPowerMultiple_le_reesMultiple (n : ℕ) :
    idealPowerMultiple I n F ≤ reesMultiple I (n : ℤ) F := by
  refine (idealPowerMultiple_le_iff I n F _).2 fun U => Submodule.smul_le.2 fun a ha y _ => ?_
  have ha' : a ∈ I.ideal U ^ ((n : ℤ)).toNat := by rwa [Int.toNat_natCast]
  set c := (reesPieceAffineEquiv I (n : ℤ) (Int.natCast_nonneg n) U).symm ⟨a, ha'⟩ with hc
  have hamb : reesPieceAmbient I (n : ℤ) U.1 c = a := by
    rw [← reesPieceAffineEquiv_coe I (n : ℤ) (Int.natCast_nonneg n) U c, hc,
      AddEquiv.apply_symm_apply]
  have h := smul_mem_reesMultiple I (n : ℤ) F U.1 c y
  rwa [hamb] at h

/-- The subsheaf of `F` generated by the products of sections of `ℐⁿ` with sections of `F` is
contained in the least subsheaf dominating the affine-local products `ℐ(U)ⁿΓ(F, U)`. -/
theorem reesMultiple_le_idealPowerMultiple (n : ℕ) :
    reesMultiple I (n : ℤ) F ≤ idealPowerMultiple I n F := by
  refine (reesMultiple_le_iff I (n : ℤ) F _).2 fun U r s => ?_
  refine mem_submodule_of_cover _ U _ fun x hx => ?_
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVU⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hx U.2
  refine ⟨V, hVU, hxV, ?_⟩
  have hres : Stacks.restr F.val (homOfLE hVU).op (reesPieceAmbient I (n : ℤ) U r • s) =
      reesPieceAmbient I (n : ℤ) V (Stacks.restr (reesPiece I (n : ℤ)).val (homOfLE hVU).op r) •
        Stacks.restr F.val (homOfLE hVU).op s :=
    (restr_smul_gamma (F := F) hVU (reesPieceAmbient I (n : ℤ) U r) s).trans
      (congrArg (fun b : Γ(X, V) => b • Stacks.restr F.val (homOfLE hVU).op s)
        (reesPieceAmbient_restr I (n : ℤ) hVU r).symm)
  have hmem : reesPieceAmbient I (n : ℤ) V
      (Stacks.restr (reesPiece I (n : ℤ)).val (homOfLE hVU).op r) ∈ I.ideal ⟨V, hV⟩ ^ n := by
    have := reesPieceAmbient_mem_affine I (n : ℤ) (Int.natCast_nonneg n) ⟨V, hV⟩
      (Stacks.restr (reesPiece I (n : ℤ)).val (homOfLE hVU).op r)
    rwa [Int.toNat_natCast] at this
  have hgoal : reesPieceAmbient I (n : ℤ) V
        (Stacks.restr (reesPiece I (n : ℤ)).val (homOfLE hVU).op r) •
          Stacks.restr F.val (homOfLE hVU).op s ∈
        (idealPowerMultiple I n F).toSubmodule.obj (op V) :=
    le_idealPowerMultiple_obj I n F ⟨V, hV⟩
      (Submodule.smul_mem_smul hmem
        (Submodule.mem_top (x := Stacks.restr F.val (homOfLE hVU).op s)))
  exact Eq.mpr (congrArg (· ∈ (idealPowerMultiple I n F).toSubmodule.obj (op V)) hres) hgoal

/-- The subsheaf of `F` generated by the products of sections of `ℐⁿ` with sections of `F` is the
least subsheaf of `F` dominating the affine-local products `ℐ(U)ⁿΓ(F, U)`. -/
theorem reesMultiple_eq_idealPowerMultiple (n : ℕ) :
    reesMultiple I (n : ℤ) F = idealPowerMultiple I n F :=
  le_antisymm (reesMultiple_le_idealPowerMultiple I F n)
    (idealPowerMultiple_le_reesMultiple I F n)

/-- The degree-`n` piece of the graded module `⨁ₙ ℐⁿF`, for `n ≥ 0`, is the `n`-th member of
the ideal-power filtration of `F`, as a sheaf of modules. -/
theorem piece_reesGradedModule_natCast (n : ℕ) :
    (reesGradedModule I F).piece (n : ℤ) = (idealPowerMultiple I n F).toSheafOfModules :=
  congrArg (fun N : F.Submodule => N.toSheafOfModules)
    (reesMultiple_eq_idealPowerMultiple I F n)

/-- If `F` is coherent, then `⨁ₙ ℐⁿF` is a graded module of finite type over the Rees algebra
`⨁ₙ ℐⁿ`. -/
theorem isFiniteType_reesGradedModule_of_isCoherent (hF : F.IsCoherent) :
    (reesGradedModule I F).IsFiniteType := by
  have hsheafify : ∀ U : X.Opens,
      HasSheafify ((Opens.grothendieckTopology X).over U) AddCommGrpCat.{u} := fun _ =>
    AlgebraicGeometry.SheafOfModules.hasSheafify_of_locallyBijective
  have hft : PresheafOfModules.IsFiniteType (Opens.grothendieckTopology X) F.val :=
    Stacks.SheafOfModules.presheaf_isFiniteType_of_isFiniteType F hF.isFiniteType
  exact isFiniteType_reesGradedModule I F

end Stacks.Blowup

end
