namespace AlgebraicGeometry

/-- **The blowup in the zero ideal sheaf is empty.** Every point of a blowup lies on a standard
affine chart, attached to a section of the centre; here that section is zero, and the chart at a
zero section is empty. -/
public theorem isEmpty_blowUp_bot (X : Scheme.{u}) :
    IsEmpty (blowUp (⊥ : X.IdealSheafData)) := by
  refine ⟨fun x ↦ ?_⟩
  obtain ⟨U, a, z, -⟩ := exists_mem_range_blowUpAffineChart (⊥ : X.IdealSheafData) x
  refine (isEmpty_spec_blowUpAffineChartRing_of_eq_zero (⊥ : X.IdealSheafData) U a ?_).false z
  have h2 := a.2
  simp only [Scheme.IdealSheafData.ideal_bot, Pi.bot_apply, Submodule.mem_bot] at h2
  exact h2

/-- Over a field the centre of the blowup at the closed point is the zero ideal sheaf, so that
blowup is empty. -/
public theorem isEmpty_blowUp_maximalIdeal_of_isField (A : Type u) [CommRing A] [IsLocalRing A]
    (hA : IsField A) :
    IsEmpty (blowUp (Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
        (IsLocalRing.maximalIdeal A)))) := by
  have hm : IsLocalRing.maximalIdeal A = ⊥ := IsLocalRing.isField_iff_maximalIdeal_eq.mp hA
  have hbot : Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (IsLocalRing.maximalIdeal A)) =
      (⊥ : (Spec (CommRingCat.of A)).IdealSheafData) := by
    rw [hm, Ideal.map_bot]
    exact Scheme.IdealSheafData.ext_of_isAffine (by simp)
  rw [hbot]
  exact isEmpty_blowUp_bot _

/-- The ring of global sections of the spectrum of a domain is a domain. -/
private lemma isDomain_sections_spec (A : Type u) [CommRing A] [IsDomain A] :
    IsDomain Γ(Spec (CommRingCat.of A), ⊤) :=
  Function.Injective.isDomain
    ((Scheme.ΓSpecIso (CommRingCat.of A)).commRingCatIsoToRingEquiv : _ →+* A)
    (Scheme.ΓSpecIso (CommRingCat.of A)).commRingCatIsoToRingEquiv.injective

/-- **If the maximal ideal of a local domain is generated by a single nonzero element then the
blowup at the closed point is an isomorphism.** The centre is then generated by one
nonzerodivisor, hence is an effective Cartier divisor, and blowing up an effective Cartier
divisor changes nothing ([Stacks, Tag 0807]). -/
public theorem isIso_blowUpToBase_maximalIdeal_of_span_singleton (A : Type u) [CommRing A]
    [IsLocalRing A] [IsDomain A] {t : A} (ht : t ≠ 0)
    (hm : IsLocalRing.maximalIdeal A = Ideal.span {t}) :
    IsIso (blowUpToBase (Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
        (IsLocalRing.maximalIdeal A)))) := by
  have : IsDomain Γ(Spec (CommRingCat.of A), ⊤) := isDomain_sections_spec A
  have hinj : Function.Injective (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom := by
    intro r r' h
    have h' := congrArg (fun w ↦ (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom w) h
    simpa using h'
  have hts : (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom t ≠ 0 := fun h ↦ ht (hinj (by simpa))
  have hmap : Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
      (IsLocalRing.maximalIdeal A) =
      Ideal.span {(Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom t} := by
    rw [hm, Ideal.map_span, Set.image_singleton]
  have hcart : Stacks.Divisors.IsEffectiveCartierDivisor
      (Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
          (IsLocalRing.maximalIdeal A))) := by
    rw [hmap]
    exact Stacks.Divisors.isEffectiveCartierDivisor_ofIdealTop_span _
      (_root_.IsRegular.of_ne_zero hts)
  exact isIso_blowUpToBase_of_isEffectiveCartierDivisor _ hcart

/-- Local rings at a point have the same Krull dimension when the stalk map is an isomorphism. -/
private theorem ringKrullDim_stalk_eq_of_isIso_stalkMap {X Y : Scheme.{u}} (f : X ⟶ Y) (x : X)
    [IsIso (f.stalkMap x)] :
    ringKrullDim (Y.presheaf.stalk (f x)) = ringKrullDim (X.presheaf.stalk x) :=
  ringKrullDim_eq_of_ringEquiv (asIso (f.stalkMap x)).commRingCatIsoToRingEquiv

/-- **The blowup of the spectrum of a regular local ring of Krull dimension at most two at its
closed point is a regular scheme of dimension at most two.** In dimension two this is the
regularity half of [Stacks, Tag 0AGR] together with the dimension inequality for a birational
morphism of finite type; in dimension one the blowup morphism is an isomorphism; in dimension
zero the blowup is empty. -/
public theorem isRegular_and_topologicalKrullDim_le_two_blowUp_maximalIdeal (A : Type u)
    [CommRing A] [IsRegularLocalRing A] (hdim : ringKrullDim A ≤ 2) :
    IsRegular (blowUp (Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
          (IsLocalRing.maximalIdeal A)))) ∧
      topologicalKrullDim (blowUp (Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
          (IsLocalRing.maximalIdeal A)))) ≤ 2 := by
  classical
  have hdom : IsDomain A := IsRegularLocalRing.isDomain A
  obtain ⟨s, hscard, hsspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank
    (IsLocalRing.maximalIdeal A).fg_of_isNoetherianRing
  have hsf : (((IsLocalRing.maximalIdeal A).spanFinrank : ℕ) : WithBot ℕ∞) = ringKrullDim A :=
    IsRegularLocalRing.spanFinrank_maximalIdeal
  have hle : (IsLocalRing.maximalIdeal A).spanFinrank ≤ 2 := by
    exact_mod_cast hsf.le.trans hdim
  have h3 : (IsLocalRing.maximalIdeal A).spanFinrank = 0 ∨
      (IsLocalRing.maximalIdeal A).spanFinrank = 1 ∨
      (IsLocalRing.maximalIdeal A).spanFinrank = 2 := by omega
  rcases h3 with h0 | h1 | h2
  · -- `A` is a field: the centre is zero and the blowup is empty.
    have hsempty : s = ∅ := Finset.card_eq_zero.mp (by rw [hscard, h0])
    have hm : IsLocalRing.maximalIdeal A = ⊥ := by
      rw [← hsspan, hsempty]
      simp
    have hfield : IsField A := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hm
    have hempty := isEmpty_blowUp_maximalIdeal_of_isField A hfield
    refine ⟨fun x ↦ (hempty.false x).elim, ?_⟩
    rw [(topologicalKrullDim_eq_bot_iff_isEmpty _).mpr hempty]
    exact bot_le
  · -- `A` is a discrete valuation ring: the blowup morphism is an isomorphism.
    obtain ⟨t, hts⟩ := Finset.card_eq_one.mp (by rw [hscard, h1])
    have hm : IsLocalRing.maximalIdeal A = Ideal.span {t} := by
      rw [← hsspan, hts]
      simp
    have hdimA : ringKrullDim A = 1 := by rw [← hsf, h1]; rfl
    have ht : t ≠ 0 := by
      intro h
      have hm' : IsLocalRing.maximalIdeal A = ⊥ := by rw [hm, h]; simp
      have hfield : IsField A := IsLocalRing.isField_iff_maximalIdeal_eq.mpr hm'
      rw [ringKrullDim_eq_zero_of_isField hfield] at hdimA
      exact (by norm_num : (0 : WithBot ℕ∞) ≠ 1) hdimA
    have hiso := isIso_blowUpToBase_maximalIdeal_of_span_singleton A ht hm
    have hregring : IsRegularRing A :=
      ((IsLocalRing.isRegularRing_tfae (R := A)).out 1 3).1 (inferInstance : IsRegularLocalRing A)
    have hregspec : IsRegular (Spec (CommRingCat.of A)) :=
      (isRegular_spec_iff A).mpr hregring
    have hnoethSpec : IsNoetherian (Spec (CommRingCat.of A)) :=
      isNoetherian_Spec.mpr inferInstance
    have hnoethBl : IsNoetherian (blowUp (Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
          (IsLocalRing.maximalIdeal A)))) :=
      Stacks.ResolutionOfSurfaces.isNoetherian_blowUp _
    have hlocnoethBl : IsLocallyNoetherian (blowUp (Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
          (IsLocalRing.maximalIdeal A)))) := IsNoetherian.toIsLocallyNoetherian
    refine ⟨isRegular_of_iso (asIso (blowUpToBase _)) hregspec, ?_⟩
    rw [topologicalKrullDim_eq_iSup_krullDimOfRing_stalk]
    refine iSup_le fun w ↦ ?_
    have hst : IsIso ((blowUpToBase (Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
          (IsLocalRing.maximalIdeal A)))).stalkMap w) :=
      ((isIso_iff_isIso_stalkMap _).mp hiso).2 w
    have heq : ringKrullDim ((Spec (CommRingCat.of A)).presheaf.stalk
          (blowUpToBase (Scheme.IdealSheafData.ofIdealTop
            (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
              (IsLocalRing.maximalIdeal A))) w)) =
        ringKrullDim ((blowUp (Scheme.IdealSheafData.ofIdealTop
          (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
            (IsLocalRing.maximalIdeal A)))).presheaf.stalk w) :=
      ringKrullDim_stalk_eq_of_isIso_stalkMap (blowUpToBase _) w
    rw [← heq]
    calc ringKrullDim ((Spec (CommRingCat.of A)).presheaf.stalk (blowUpToBase _ w))
        ≤ topologicalKrullDim (Spec (CommRingCat.of A)) :=
          ringKrullDim_stalk_le_topologicalKrullDim _
      _ = ringKrullDim A := PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim A
      _ ≤ 2 := hdim
  · -- The source's case.
    have hdimA : ringKrullDim A = 2 := by rw [← hsf, h2]; rfl
    have hne := Stacks.Blowup.center_ne_bot A hdimA
    have hint : IsIntegral (blowUp (Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
          (IsLocalRing.maximalIdeal A)))) := isIntegral_blowUp _ hne
    refine ⟨isRegular_blowUp_maximalIdeal A hdimA, ?_⟩
    calc topologicalKrullDim (blowUp (Scheme.IdealSheafData.ofIdealTop
            (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
              (IsLocalRing.maximalIdeal A))))
        ≤ topologicalKrullDim (Spec (CommRingCat.of A)) :=
          Stacks.ResolutionOfSurfaces.topologicalKrullDim_le_of_isBirational _
            (isBirational_blowUpToBase _ hne)
      _ = ringKrullDim A := PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim A
      _ ≤ 2 := hdim

/-- **The blowup of the spectrum of a regular local ring of dimension two at its closed point has
dimension at least two.** The blowup morphism is proper, hence closed, and surjective because the
centre is a nonzero ideal sheaf on an integral scheme; a closed surjection does not lower the
dimension ([Stacks, Tag 02JF]). -/
public theorem two_le_topologicalKrullDim_blowUp_maximalIdeal (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) :
    2 ≤ topologicalKrullDim (blowUp (Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
        (IsLocalRing.maximalIdeal A)))) := by
  have hdom : IsDomain A := IsRegularLocalRing.isDomain A
  have hne := Stacks.Blowup.center_ne_bot A hdim
  have hsupp : ((Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
        (IsLocalRing.maximalIdeal A))).support : Set (Spec (CommRingCat.of A))) ≠
      Set.univ := by
    intro hcontra
    refine hne (Scheme.IdealSheafData.support_eq_top_iff.mp ?_)
    exact TopologicalSpace.Closeds.ext (by simpa using hcontra)
  have hsurj := surjective_blowUpToBase_of_support_ne_univ _ hsupp
  have hmain := Topology.topologicalKrullDim_le_of_surjective_of_specializingMap_or_generalizingMap
    (blowUpToBase (Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
        (IsLocalRing.maximalIdeal A)))).base
    (blowUpToBase _).continuous hsurj
    (Or.inl (blowUpToBase _).isClosedMap.specializingMap)
  calc (2 : WithBot ℕ∞) = ringKrullDim A := hdim.symm
    _ = topologicalKrullDim (Spec (CommRingCat.of A)) :=
      (PrimeSpectrum.topologicalKrullDim_eq_ringKrullDim A).symm
    _ ≤ topologicalKrullDim (blowUp (Scheme.IdealSheafData.ofIdealTop
          (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
            (IsLocalRing.maximalIdeal A)))) := hmain

/-- Flat base change along `Spec 𝒪_{X,z} ⟶ X` ([Stacks, Tag 0805]) compares the blowup of `X` in
an ideal sheaf `I` with the blowup of `Spec 𝒪_{X,z}` in the inverse image of `I`: the comparison
morphism is a flat preimmersion, hence an isomorphism on local rings, and every point of the
blowup of `X` over `z` is in its image.

This is the comparison behind `AlgebraicGeometry.isRegularLocalRing_stalk_blowUp_of_mapsTo`,
recorded so that it can also carry Krull dimensions. -/
private theorem exists_comparison_blowUp_comap_fromSpecStalk {X : Scheme.{u}}
    (I : X.IdealSheafData) (z : X) :
    ∃ h : blowUp (I.comap (X.fromSpecStalk z)) ⟶ blowUp I,
      (∀ w' : blowUp (I.comap (X.fromSpecStalk z)), IsIso (h.stalkMap w')) ∧
        ∀ w : blowUp I, blowUpToBase I w = z → ∃ w', h w' = w := by
  have hflat : Flat (X.fromSpecStalk z) := flat_fromSpecStalk X z
  obtain ⟨h, hpb⟩ := exists_isPullback_blowUpToBase_comap (X.fromSpecStalk z) I
  have : Flat h := MorphismProperty.of_isPullback (P := @Flat) hpb hflat
  have : IsPreimmersion h :=
    MorphismProperty.of_isPullback (P := @IsPreimmersion) hpb inferInstance
  refine ⟨h, fun w' ↦ isIso_stalkMap_of_flat_preimmersion h w', fun w hw ↦ ?_⟩
  obtain ⟨w', -, hw'⟩ := Scheme.exists_preimage_of_isPullback hpb
    (IsLocalRing.closedPoint (X.presheaf.stalk z)) w
    (Scheme.fromSpecStalk_closedPoint.trans hw.symm)
  exact ⟨w', hw'⟩

/-- **Stacks Project, Tag 0AGR, globally.** The blowup of a regular Noetherian scheme of
dimension two in a reduced closed point is again regular of dimension two.

The source states this for the spectrum of a regular local ring of dimension two blown up at its
closed point, which is `AlgebraicGeometry.isRegular_blowUp_maximalIdeal`. Passing to a closed
point of a scheme needs a case distinction on `ringKrullDim 𝒪_{Y,y}`, which may be `0`, `1` or
`2`; see the module docstring. -/
@[stacks 0AGR "the globalization of the source's statement: the blowup of a regular Noetherian
  scheme of dimension two in a reduced closed point is regular of dimension two. The source's own
  statement, for the spectrum of a regular local ring of dimension two blown up at its closed
  point, is `AlgebraicGeometry.isRegular_blowUp_maximalIdeal`. The local ring at a closed point of
  such a scheme may have dimension `0`, `1` or `2`, and all three cases are treated; see the
  module docstring", ega "IV 19.4.11" "(iii), special case"]
public theorem isRegular_and_topologicalKrullDim_blowUp_vanishingIdeal_singleton
    (Y : Scheme.{u}) [IsNoetherian Y] (hreg : IsRegular Y)
    (hdim : topologicalKrullDim Y = 2) (y : Y) (hy : IsClosed ({y} : Set Y)) :
    IsRegular (blowUp (Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : Closeds Y))) ∧
      topologicalKrullDim (blowUp (Scheme.IdealSheafData.vanishingIdeal
        (⟨{y}, hy⟩ : Closeds Y))) = 2 := by
  classical
  set I : Y.IdealSheafData :=
    Scheme.IdealSheafData.vanishingIdeal (⟨{y}, hy⟩ : Closeds Y) with hIdef
  have hnoethW : IsNoetherian (blowUp I) := Stacks.ResolutionOfSurfaces.isNoetherian_blowUp I
  have hlocnoethW : IsLocallyNoetherian (blowUp I) := IsNoetherian.toIsLocallyNoetherian
  have hsupp : (I.support : Set Y) = {y} := by
    rw [hIdef, Scheme.IdealSheafData.coe_support_vanishingIdeal]
    rfl
  have hisoU : IsIso (blowUpToBase I ∣_ (I.support.compl : Y.Opens)) :=
    isIso_blowUp_restrict_compl_support I
  have hAreg : IsRegularLocalRing (Y.presheaf.stalk y) := hreg.isRegularLocalRing_stalk y
  have hAdim : ringKrullDim (Y.presheaf.stalk y) ≤ 2 := by
    rw [← hdim]
    exact ringKrullDim_stalk_le_topologicalKrullDim y
  have hcomap : I.comap (Y.fromSpecStalk y) = Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of (Y.presheaf.stalk y))).inv.hom
        (IsLocalRing.maximalIdeal (Y.presheaf.stalk y))) :=
    vanishingIdeal_singleton_comap_fromSpecStalk_eq y hy
  obtain ⟨hlocreg, hlocdim⟩ :=
    isRegular_and_topologicalKrullDim_le_two_blowUp_maximalIdeal (Y.presheaf.stalk y) hAdim
  have hlocreg' : IsRegular (blowUp (I.comap (Y.fromSpecStalk y))) := by rwa [hcomap]
  have hlocdim' : topologicalKrullDim (blowUp (I.comap (Y.fromSpecStalk y))) ≤ 2 := by
    rwa [hcomap]
  obtain ⟨h, hstalkiso, hfib⟩ := exists_comparison_blowUp_comap_fromSpecStalk I y
  -- Off the centre the blowup morphism is an isomorphism on local rings.
  have hoff : ∀ w : blowUp I, blowUpToBase I w ≠ y →
      IsIso ((blowUpToBase I).stalkMap w) := by
    intro w hw
    refine isIso_stalkMap_of_isIso_morphismRestrict (blowUpToBase I) hisoU
      (x := w) ?_
    show blowUpToBase I w ∈ (I.support.compl : Y.Opens)
    have hnot : blowUpToBase I w ∉ (I.support : Set Y) := by
      rw [hsupp]; simpa using hw
    exact hnot
  -- Every local ring of the blowup is regular of dimension at most two.
  have key : ∀ w : blowUp I, IsRegularLocalRing ((blowUp I).presheaf.stalk w) ∧
      ringKrullDim ((blowUp I).presheaf.stalk w) ≤ 2 := by
    intro w
    by_cases hwy : blowUpToBase I w = y
    · obtain ⟨w', hw'⟩ := hfib w hwy
      have hiso' := hstalkiso w'
      have he := (asIso (h.stalkMap w')).commRingCatIsoToRingEquiv
      have hdimw := ringKrullDim_stalk_eq_of_isIso_stalkMap h w'
      have hbound : ringKrullDim ((blowUp I).presheaf.stalk w) ≤ 2 := by
        rw [← hw', hdimw]
        exact le_trans (ringKrullDim_stalk_le_topologicalKrullDim w') hlocdim'
      refine ⟨?_, hbound⟩
      by_cases hd2 : ringKrullDim (Y.presheaf.stalk y) = 2
      · exact isRegularLocalRing_stalk_blowUp_of_mapsTo I y hy hIdef hAreg hd2 w hwy
      · have hregw' := hlocreg'.isRegularLocalRing_stalk w'
        exact hw' ▸ IsRegularLocalRing.of_ringEquiv he.symm
    · have hiso' := hoff w hwy
      have he := (asIso ((blowUpToBase I).stalkMap w)).commRingCatIsoToRingEquiv
      have hregy : IsRegularLocalRing (Y.presheaf.stalk (blowUpToBase I w)) :=
        hreg.isRegularLocalRing_stalk _
      refine ⟨IsRegularLocalRing.of_ringEquiv he, ?_⟩
      rw [← ringKrullDim_stalk_eq_of_isIso_stalkMap (blowUpToBase I) w, ← hdim]
      exact ringKrullDim_stalk_le_topologicalKrullDim _
  refine ⟨isRegular_of_stalks fun w ↦ (key w).1, le_antisymm ?_ ?_⟩
  · rw [topologicalKrullDim_eq_iSup_krullDimOfRing_stalk]
    exact iSup_le fun w ↦ (key w).2
  · -- A point of `Y` whose local ring has dimension two, and a point above it.
    have hnotle : ¬ (⨆ x : Y, ringKrullDim (Y.presheaf.stalk x)) ≤ 1 := by
      rw [← topologicalKrullDim_eq_iSup_krullDimOfRing_stalk, hdim]
      norm_num
    obtain ⟨y', hy'⟩ : ∃ x : Y, ¬ ringKrullDim (Y.presheaf.stalk x) ≤ 1 := by
      by_contra hcon
      exact hnotle (iSup_le fun x ↦ not_not.mp fun hx ↦ hcon ⟨x, hx⟩)
    have hregy' : IsRegularLocalRing (Y.presheaf.stalk y') := hreg.isRegularLocalRing_stalk y'
    have hcast : (((IsLocalRing.maximalIdeal (Y.presheaf.stalk y')).spanFinrank : ℕ) :
        WithBot ℕ∞) = ringKrullDim (Y.presheaf.stalk y') :=
      IsRegularLocalRing.spanFinrank_maximalIdeal
    have hy'two : 2 ≤ ringKrullDim (Y.presheaf.stalk y') := by
      rw [← hcast] at hy' ⊢
      have hnn : ¬ ((IsLocalRing.maximalIdeal (Y.presheaf.stalk y')).spanFinrank ≤ 1) := by
        intro hcon
        exact hy' (by exact_mod_cast hcon)
      have h2 : 2 ≤ (IsLocalRing.maximalIdeal (Y.presheaf.stalk y')).spanFinrank := by omega
      exact_mod_cast h2
    by_cases hy'y : y' = y
    · -- The centre itself carries the dimension.
      have hd2 : ringKrullDim (Y.presheaf.stalk y) = 2 :=
        le_antisymm hAdim (hy'y ▸ hy'two)
      have hloc2 : (2 : WithBot ℕ∞) ≤
          topologicalKrullDim (blowUp (I.comap (Y.fromSpecStalk y))) := by
        rw [hcomap]
        exact two_le_topologicalKrullDim_blowUp_maximalIdeal _ hd2
      refine le_trans hloc2 ?_
      rw [topologicalKrullDim_eq_iSup_krullDimOfRing_stalk,
        topologicalKrullDim_eq_iSup_krullDimOfRing_stalk]
      refine iSup_le fun w' ↦ ?_
      refine le_trans (le_of_eq ?_) (le_iSup
        (fun w : blowUp I ↦ ringKrullDim ((blowUp I).presheaf.stalk w)) (h w'))
      have hiso' := hstalkiso w'
      exact (ringKrullDim_stalk_eq_of_isIso_stalkMap h w').symm
    · -- A point away from the centre.
      have hy'U : y' ∈ (I.support.compl : Y.Opens) := by
        have hnot : y' ∉ (I.support : Set Y) := by rw [hsupp]; simpa using hy'y
        exact hnot
      obtain ⟨zz, hzz⟩ := (asIso (blowUpToBase I ∣_
        (I.support.compl : Y.Opens))).hom.surjective
        (⟨y', hy'U⟩ : (I.support.compl : Y.Opens))
      have hwy' : blowUpToBase I ((blowUpToBase I ⁻¹ᵁ (I.support.compl : Y.Opens)).ι zz) = y' := by
        have heq := congrArg (fun f ↦ f zz) (morphismRestrict_ι (blowUpToBase I)
          (I.support.compl : Y.Opens))
        change (blowUpToBase I ∣_ (I.support.compl : Y.Opens)) zz =
          (⟨y', hy'U⟩ : (I.support.compl : Y.Opens)) at hzz
        simpa only [Scheme.Hom.comp_apply, hzz, Scheme.Opens.ι_apply] using heq.symm
      have hwne : blowUpToBase I ((blowUpToBase I ⁻¹ᵁ (I.support.compl : Y.Opens)).ι zz) ≠ y := by
        rwa [hwy']
      have hiso' := hoff _ hwne
      calc (2 : WithBot ℕ∞) ≤ ringKrullDim (Y.presheaf.stalk y') := hy'two
        _ = ringKrullDim ((blowUp I).presheaf.stalk
              ((blowUpToBase I ⁻¹ᵁ (I.support.compl : Y.Opens)).ι zz)) := by
            rw [← hwy']
            exact ringKrullDim_stalk_eq_of_isIso_stalkMap (blowUpToBase I) _
        _ ≤ topologicalKrullDim (blowUp I) := ringKrullDim_stalk_le_topologicalKrullDim _

end AlgebraicGeometry

