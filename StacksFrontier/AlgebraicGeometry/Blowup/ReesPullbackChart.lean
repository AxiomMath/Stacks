module

public import StacksFrontier.AlgebraicGeometry.Blowup.ReesGradedPullback
public import StacksFrontier.AlgebraicGeometry.DivisorFlatPullback.Basic
public import StacksFrontier.AlgebraicGeometry.PullbackSections.Affine

/-!
# The comparison `g^*(ℐⁿ) ⟶ (ℐ𝒪_Z)ⁿ` on an affine chart

Let `g : Z ⟶ X` be a morphism of schemes and `ℐ` a quasi-coherent sheaf of ideals on `X`. This
file reads the comparison `Φ : g^*(ℐⁿ) ⟶ (ℐ𝒪_Z)ⁿ` of `Stacks.Blowup.reesGradedPullbackHom` over
a pair of affine opens.

Over an affine open `V` of `Z` lying in the preimage of an affine open `U` of `X`, write
`φ : Γ(X, U) → Γ(Z, V)` for the induced map on functions. The ambient sections of `ℐⁿ` over `U`
are exactly `ℐ(U)ⁿ`, those of `(ℐ𝒪_Z)ⁿ` over `V` are exactly the extension `ℐ(U)ⁿ Γ(Z, V)`, and
`Φ` carries the pullback of a section with ambient section `a` to one with ambient section
`φ(a)`. Since the extension is generated by the `φ(a)`, `Φ` is surjective over such a chart, for
every `g`.

## Main results

* `Stacks.Blowup.range_reesAmbientLinearMap`: over an affine open the ambient sections of the
  degree-`n` piece of the Rees algebra are exactly `ℐ(U)ⁿ`.
* `Stacks.Blowup.reesPieceAmbient_reesPullbackComparison_pullbackSection`: on ambient sections
  the comparison is the map on functions, over any pair of opens.
* `Stacks.Blowup.surjective_reesPullbackComparisonLinear`: **the comparison is surjective on an
  affine chart.**

## Implementation notes

Every homogeneous section of nonnegative degree is determined by its ambient section
(`Stacks.Blowup.reesPieceAmbient_injective`), so the whole argument is carried out on ambient
sections in `Γ(Z, V)`, and no section of a Rees algebra is ever constructed by hand.

## References

* [Stacks Project, Tag 01OG](https://stacks.math.columbia.edu/tag/01OG)
* [Stacks Project, Tag 0805](https://stacks.math.columbia.edu/tag/0805)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite
open SheafOfModules.GradedAlgebra

universe u

namespace Stacks.Blowup

/-! ### The ambient section of a homogeneous section, as a linear map -/

section Ambient

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- The ambient section of a homogeneous section of the Rees algebra, as a `Γ(X, U)`-linear
map `ℐⁿ(U) → Γ(X, U)`. -/
noncomputable def reesAmbientLinearMap (n : ℤ) (U : X.Opens) :
    Γ(Stacks.Conormal.reesModule I n, U) →ₗ[Γ(X, U)] Γ(X, U) where
  toFun x := reesPieceAmbient I n U x
  map_add' x y := reesPieceAmbient_add I n U x y
  map_smul' r x := reesPieceAmbient_smul I n U r x

/-- `reesAmbientLinearMap` sends a homogeneous section to its ambient section. -/
@[simp] lemma reesAmbientLinearMap_apply (n : ℤ) (U : X.Opens)
    (x : Γ(Stacks.Conormal.reesModule I n, U)) :
    reesAmbientLinearMap I n U x = reesPieceAmbient I n U x := rfl

/-- In nonnegative degrees the ambient section determines the homogeneous section. -/
lemma injective_reesAmbientLinearMap (n : ℤ) (hn : 0 ≤ n) (U : X.Opens) :
    Function.Injective (reesAmbientLinearMap I n U) :=
  reesPieceAmbient_injective I n hn U

/-- **Over an affine open the ambient sections of the degree-`n` piece are exactly the elements
of the `n`-th power of the ideal.** -/
lemma range_reesAmbientLinearMap (n : ℤ) (hn : 0 ≤ n) (U : X.affineOpens) :
    LinearMap.range (reesAmbientLinearMap I n U.1) = I.ideal U ^ n.toNat := by
  refine le_antisymm ?_ ?_
  · rintro x ⟨y, rfl⟩
    exact reesPieceAmbient_mem_affine I n hn U y
  · intro x hx
    refine ⟨(reesPieceAffineEquiv I n hn U).symm ⟨x, hx⟩, ?_⟩
    exact (reesPieceAffineEquiv_coe I n hn U _).symm.trans
      (congrArg (fun b : ↥(I.ideal U ^ n.toNat) => (b : Γ(X, U.1)))
        ((reesPieceAffineEquiv I n hn U).apply_symm_apply ⟨x, hx⟩))

end Ambient

/-! ### The comparison on ambient sections -/

section Comparison

variable {Z X : Scheme.{u}} (g : Z ⟶ X) (I : X.IdealSheafData)

/-- The pullback of a section to an open `V ≤ g⁻¹U` is the restriction to `V` of its pullback to
`g⁻¹U`. -/
lemma pullbackSection_eq_restrict (M : X.Modules) (U : X.Opens) (V : Z.Opens)
    (hVU : V ≤ g ⁻¹ᵁ U) (a : M.val.obj (op U)) :
    Scheme.Modules.pullbackSection g M U V hVU a =
      ((Scheme.Modules.pullback g).obj M).val.map (homOfLE hVU).op
        (Scheme.Modules.pullbackSection g M U (g ⁻¹ᵁ U) le_rfl a) := by
  rw [Stacks.Conormal.pullbackSection_self g M U a]
  rfl

/-- The comparison `Φ` in degree `n`, written with `Scheme.Modules.pullback` as the source
rather than the degree-`n` piece of the pulled-back graded algebra. The two are definitionally
equal, but only one of them is the spelling in which the pullback-section API is stated, and a
goal mixing them is not type-correct at the transparency `rw` checks its motive at. -/
noncomputable def reesPullbackComparison (n : ℤ) :
    (Scheme.Modules.pullback g).obj (Stacks.Conormal.reesModule I n) ⟶
      Stacks.Conormal.reesModule (I.comap g) n :=
  (reesGradedPullbackHom g I).app n

/-- `reesPullbackComparison` is the degree-`n` component of `reesGradedPullbackHom`. -/
lemma reesPullbackComparison_eq (n : ℤ) :
    reesPullbackComparison g I n = (reesGradedPullbackHom g I).app n := rfl

/-- **On ambient sections the comparison `Φ` is the map on functions**, over the full preimage
of an open. -/
lemma reesPieceAmbient_reesPullbackComparison (n : ℤ) (U : X.Opens)
    (a : (reesPiece I n).val.obj (op U)) :
    reesPieceAmbient (I.comap g) n (g ⁻¹ᵁ U)
        ((reesPullbackComparison g I n).val.app (op (g ⁻¹ᵁ U))
          (Scheme.Modules.pullbackSection g (reesPiece I n) U (g ⁻¹ᵁ U) le_rfl a)) =
      (g.app U) (reesPieceAmbient I n U a) :=
  reesPieceAmbient_reesGradedPullbackHom_pullbackSection g I n U a

/-- **On ambient sections the comparison `Φ` is the map on functions.** The ambient section of
the value of `Φ` on the pullback of `a` is the image of the ambient section of `a` under
`g.appLE`. -/
lemma reesPieceAmbient_reesPullbackComparison_pullbackSection (n : ℤ) (U : X.Opens)
    (V : Z.Opens) (hVU : V ≤ g ⁻¹ᵁ U) (a : (reesPiece I n).val.obj (op U)) :
    reesPieceAmbient (I.comap g) n V
        ((reesPullbackComparison g I n).val.app (op V)
          (Scheme.Modules.pullbackSection g (reesPiece I n) U V hVU a)) =
      (g.appLE U V hVU) (reesPieceAmbient I n U a) := by
  rw [pullbackSection_eq_restrict g (reesPiece I n) U V hVU a,
    PresheafOfModules.naturality_apply (reesPullbackComparison g I n).val (homOfLE hVU).op _,
    reesPieceAmbient_restrict (I.comap g) n V (g ⁻¹ᵁ U) hVU _,
    reesPieceAmbient_reesPullbackComparison g I n U a, Scheme.Hom.appLE]
  rfl

/-- The comparison `Φ` in degree `n`, on sections over an open `V` of `Z`, as a
`Γ(Z, V)`-linear map. -/
noncomputable def reesPullbackComparisonLinear (n : ℤ) (V : Z.Opens) :
    Γ((Scheme.Modules.pullback g).obj (Stacks.Conormal.reesModule I n), V) →ₗ[Γ(Z, V)]
      Γ(Stacks.Conormal.reesModule (I.comap g) n, V) where
  toFun x := (reesPullbackComparison g I n).app V x
  map_add' x y := map_add (ConcreteCategory.hom ((reesPullbackComparison g I n).app V)) x y
  map_smul' r x := Scheme.Modules.Hom.app_smul (reesPullbackComparison g I n) r x

/-- `reesPullbackComparisonLinear` is the comparison `Φ` on sections over `V`. -/
@[simp] lemma reesPullbackComparisonLinear_apply (n : ℤ) (V : Z.Opens)
    (x : Γ((Scheme.Modules.pullback g).obj (Stacks.Conormal.reesModule I n), V)) :
    reesPullbackComparisonLinear g I n V x = (reesPullbackComparison g I n).app V x := rfl

/-- `AlgebraicGeometry.Scheme.Modules.pullbackSection`, with its value declared as a section of
the pullback module rather than as an element of the underlying presheaf: the module instances
over `Γ(Z, V)` are stated for the former spelling only. -/
noncomputable def pullbackSectionΓ (M : X.Modules) (U : X.Opens) (V : Z.Opens)
    (h : V ≤ g ⁻¹ᵁ U) (a : Γ(M, U)) : Γ((Scheme.Modules.pullback g).obj M, V) :=
  Scheme.Modules.pullbackSection g M U V h a

/-- The ambient section of the value of `Φ` on a pullback section, in the linear-map
spelling. -/
lemma reesAmbientLinearMap_reesPullbackComparisonLinear (n : ℤ) (U : X.Opens) (V : Z.Opens)
    (hVU : V ≤ g ⁻¹ᵁ U) (a : Γ(Stacks.Conormal.reesModule I n, U)) :
    reesAmbientLinearMap (I.comap g) n V (reesPullbackComparisonLinear g I n V
        (pullbackSectionΓ g (Stacks.Conormal.reesModule I n) U V hVU a)) =
      (g.appLE U V hVU) (reesAmbientLinearMap I n U a) :=
  reesPieceAmbient_reesPullbackComparison_pullbackSection g I n U V hVU a

end Comparison

/-! ### Surjectivity on an affine chart -/

section Surjective

variable {Z X : Scheme.{u}} (g : Z ⟶ X) (I : X.IdealSheafData)

/-- **`Φ` is surjective on an affine chart**, for an arbitrary morphism `g`. Over an affine open
`V` of `Z` inside the preimage of an affine open `U` of `X`, the ambient sections of the target
are the extension of `ℐ(U)ⁿ` along the map on functions, and the ambient section of the value of
`Φ` on the pullback of a section with ambient section `a` is the image of `a`; so every generator
of the extension is hit, and the target is spanned by them. -/
lemma surjective_reesPullbackComparisonLinear (n : ℤ) (hn : 0 ≤ n) (U : X.affineOpens)
    (V : Z.affineOpens) (hVU : V.1 ≤ g ⁻¹ᵁ U.1) :
    Function.Surjective (reesPullbackComparisonLinear g I n V.1) := by
  intro t
  have hmem : reesPieceAmbient (I.comap g) n V.1 t ∈
      Ideal.map (g.appLE U.1 V.1 hVU).hom (I.ideal U ^ n.toNat) := by
    have h := reesPieceAmbient_mem_affine (I.comap g) n hn V t
    rwa [Stacks.IdealSheaf.ideal_comap_appLE I g U V hVU, ← Ideal.map_pow] at h
  rw [Ideal.map, Ideal.span, Submodule.mem_span_set'] at hmem
  obtain ⟨k, c, y, hsum⟩ := hmem
  have hlift : ∀ i : Fin k, ∃ x : Γ(Stacks.Conormal.reesModule I n, U.1),
      (g.appLE U.1 V.1 hVU) (reesAmbientLinearMap I n U.1 x) = (y i : Γ(Z, V.1)) := by
    intro i
    obtain ⟨a, ha, hya⟩ := (y i).2
    obtain ⟨x, hx⟩ := (range_reesAmbientLinearMap I n hn U).ge ha
    exact ⟨x, by rw [hx]; exact hya⟩
  choose x hx using hlift
  refine ⟨∑ i : Fin k, c i •
    pullbackSectionΓ g (Stacks.Conormal.reesModule I n) U.1 V.1 hVU (x i), ?_⟩
  refine injective_reesAmbientLinearMap (I.comap g) n hn V.1 ?_
  have hgoal : reesAmbientLinearMap (I.comap g) n V.1 t = ∑ i : Fin k, c i • (y i : Γ(Z, V.1)) :=
    hsum.symm
  rw [map_sum (reesPullbackComparisonLinear g I n V.1),
    map_sum (reesAmbientLinearMap (I.comap g) n V.1), hgoal]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_smul, map_smul, reesAmbientLinearMap_reesPullbackComparisonLinear g I n U.1 V.1 hVU,
    hx i]

end Surjective

end Stacks.Blowup

end
