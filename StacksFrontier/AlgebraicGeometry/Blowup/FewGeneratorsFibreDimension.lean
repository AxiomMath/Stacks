/-!
# Fibres of the blowup in an ideal with few generators

Let `R` be a commutative ring and `K = (g₁, …, g_d) ⊆ R` an ideal generated by `d` elements. The
blowup `b : X' ⟶ Spec R` of `Spec R` in `K` is covered by the `d` affine charts
`Spec R[K/gᵢ]`, and the affine blowup algebra `R[K/gᵢ]` is generated as an `R`-algebra by the
`d - 1` fractions `gⱼ/gᵢ`, `j ≠ i`. The fibre of a chart over a point `y` of `Spec R` is therefore
the spectrum of `κ(y) ⊗_R R[K/gᵢ]`, a quotient of a polynomial ring in `d - 1` variables over the
field `κ(y)`, and has dimension at most `d - 1`. Since the fibre of `b` over `y` is covered by the
`d` open pieces cut out by the charts, it too has dimension at most `d - 1`: every fibre of the
blowup has dimension strictly less than `d`.

When `d = 0` the ideal is zero, the blowup is empty and every fibre has dimension `⊥ < 0`, so the
bound needs no hypothesis on `d`.

## Main results

* `Stacks.Blowup.topologicalKrullDim_fiber_blowUpToBase_lt_of_eq_span`: every fibre of the
  blowup `Stacks.Blowup.blowUpToBase` of `Spec R` in an ideal generated by `d` elements has
  dimension `< d`.
* `Stacks.Blowup.topologicalKrullDim_fiber_algebraicGeometry_blowUpToBase_lt_of_eq_span`: the
  same bound for the other construction `AlgebraicGeometry.blowUpToBase`.

## Implementation notes

The cover of the blowup by the charts attached to a generating family is
`Stacks.Blowup.iSup_opensRange_blowUpAffineChart_of_span`, applied over the affine open
`⊤ ⊆ Spec R`, and the chart's structure morphism to the base is computed by
`Stacks.Blowup.blowUpAffineChart_blowUpToBase`. The fibre of `Spec B ⟶ Spec A` is then read as
`Spec (κ(𝔭) ⊗_A B)` by `AlgebraicGeometry.topologicalKrullDim_fiber_specMap_eq`. The passage from
the charts to the whole fibre is made pointwise, through the local Krull dimension
`TopologicalSpace.localKrullDim`: each point of the fibre has an open neighbourhood, the part of
the fibre lying in one chart, which embeds in the fibre of that chart.

## References

* [Stacks Project, Tag 0EJN](https://stacks.math.columbia.edu/tag/0EJN)
* [Stacks Project, Tag 0804](https://stacks.math.columbia.edu/tag/0804)
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry TopologicalSpace Topology

universe u

namespace Stacks.Blowup

/-- The fibres of an `A`-algebra generated by `n` elements have Krull dimension at most `n`: the
fibre `κ(𝔭) ⊗_A B` is a quotient of the polynomial ring over the field `κ(𝔭)` in those
generators. -/
@[sga "4½ Arcata 3.4.1" "more general"]
private theorem ringKrullDim_fiber_le_natCard_of_adjoin {A B σ : Type*} [CommRing A]
    [CommRing B] [Algebra A B] [Finite σ] (x : σ → B)
    (hx : Algebra.adjoin A (Set.range x) = ⊤) (p : Ideal A) [p.IsPrime] :
    ringKrullDim (p.Fiber B) ≤ (Nat.card σ : WithBot ℕ∞) := by
  have hadj : Algebra.adjoin p.ResidueField
      (Set.range fun i => (1 : p.ResidueField) ⊗ₜ[A] x i) = ⊤ := by
    have h := Algebra.TensorProduct.adjoin_one_tmul_image_eq_top (A := p.ResidueField) _ hx
    rwa [← Set.range_comp] at h
  have hsurj : Function.Surjective
      (MvPolynomial.aeval (R := p.ResidueField) fun i => (1 : p.ResidueField) ⊗ₜ[A] x i) := by
    rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval, hadj]
  calc ringKrullDim (p.Fiber B)
      ≤ ringKrullDim (MvPolynomial σ p.ResidueField) :=
        ringKrullDim_le_of_surjective _ hsurj
    _ = (Nat.card σ : WithBot ℕ∞) := by
        rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
          zero_add, ENat.card_eq_coe_natCard σ]
        rfl

/-- The fraction `aⱼ / aᵢ` as an element of the affine blowup algebra `R[K/aᵢ]`, for
`K = (a₀, …, a_n)`. -/
private def spanFraction {R : Type*} [CommRing R] {n : ℕ} (a : Fin (n + 1) → R)
    (i k : Fin (n + 1)) : affineBlowup (Ideal.span (Set.range a)) (a i) :=
  ⟨Localization.mk (a k) ⟨a i, Submonoid.mem_powers _⟩,
    Algebra.subset_adjoin ⟨a k, Ideal.subset_span ⟨k, rfl⟩, rfl⟩⟩

/-- For `K = (a₀, …, a_n)` the affine blowup algebra `R[K/aᵢ]` is generated as an `R`-algebra by
the `n` fractions `aⱼ / aᵢ`, `j ≠ i`. -/
private theorem adjoin_range_spanFraction_succAbove {R : Type*} [CommRing R] {n : ℕ}
    (a : Fin (n + 1) → R) (i : Fin (n + 1)) :
    Algebra.adjoin R (Set.range fun j : Fin n => spanFraction a i (i.succAbove j)) = ⊤ := by
  refine Subalgebra.map_injective
    (f := (affineBlowup (Ideal.span (Set.range a)) (a i)).val) Subtype.val_injective ?_
  rw [AlgHom.map_adjoin, Algebra.map_top, Subalgebra.range_val, ← Set.range_comp]
  refine le_antisymm (Algebra.adjoin_le ?_) (Algebra.adjoin_le ?_)
  · rintro _ ⟨j, rfl⟩
    exact (spanFraction a i (i.succAbove j)).2
  · rintro _ ⟨x, hx, rfl⟩
    induction hx using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨k, rfl⟩ := hx
      rcases Fin.eq_self_or_eq_succAbove i k with rfl | ⟨j, rfl⟩
      · have h1 : (Localization.mk (a k) ⟨a k, Submonoid.mem_powers _⟩ : Localization.Away (a k))
            = 1 := Localization.mk_self ⟨a k, Submonoid.mem_powers _⟩
        dsimp only
        rw [h1]
        exact Subalgebra.one_mem _
      · exact Algebra.subset_adjoin ⟨j, rfl⟩
    | zero =>
      show Localization.mk 0 _ ∈ _
      rw [Localization.mk_zero]
      exact Subalgebra.zero_mem _
    | add x y _ _ hx hy =>
      show Localization.mk (x + y) _ ∈ _
      rw [← Localization.add_mk_self]
      exact Subalgebra.add_mem _ hx hy
    | smul r x _ hx =>
      show Localization.mk (r • x) _ ∈ _
      rw [← Localization.smul_mk]
      exact Subalgebra.smul_mem _ hx r

/-- **The dimension of a fibre is read on an open cover.** If the images of open immersions
`cᵢ : Yᵢ ⟶ X` cover `X`, the fibre of `f : X ⟶ S` over `y` has dimension at most any bound on the
fibres of the composites `cᵢ ≫ f` over `y`. -/
private theorem topologicalKrullDim_fiber_le_of_iSup_opensRange {X S : Scheme.{u}} (f : X ⟶ S)
    {ι : Type*} {Y : ι → Scheme.{u}} (c : ∀ i, Y i ⟶ X) [∀ i, IsOpenImmersion (c i)]
    (hc : ⨆ i, (c i).opensRange = ⊤) (y : S) {n : WithBot ℕ∞}
    (h : ∀ i, topologicalKrullDim ((c i ≫ f).fiber y) ≤ n) :
    topologicalKrullDim (f.fiber y) ≤ n := by
  rw [IsHomeomorph.topologicalKrullDim_eq _ (f.fiberHomeo y).isHomeomorph,
    topologicalKrullDim_eq_iSup_localKrullDim]
  refine iSup_le fun x => ?_
  obtain ⟨i, hi⟩ : ∃ i, x.1 ∈ (c i).opensRange := by
    have hx : x.1 ∈ (⨆ i, (c i).opensRange) := by rw [hc]; trivial
    simpa only [TopologicalSpace.Opens.mem_iSup] using hx
  rw [← SetLike.mem_coe, Scheme.Hom.coe_opensRange] at hi
  let W : Set (f ⁻¹' {y}) := Subtype.val ⁻¹' Set.range (c i)
  have hW : IsOpen W := (c i).isOpenEmbedding.isOpen_range.preimage continuous_subtype_val
  let Q : Set (Y i) := (c i ≫ f) ⁻¹' {y}
  let r : W → (c i '' Q) := fun w => ⟨w.1.1, by
    obtain ⟨q, hq⟩ := w.2
    refine ⟨q, ?_, hq⟩
    show (c i ≫ f) q ∈ ({y} : Set S)
    rw [Scheme.Hom.comp_apply, hq]
    exact w.1.2⟩
  have hval : IsInducing (fun w : W => (w.1.1 : X)) :=
    IsInducing.subtypeVal.comp IsInducing.subtypeVal
  calc localKrullDim (f ⁻¹' {y}) x
      ≤ topologicalKrullDim W := iInf_le_of_le W (iInf_le_of_le hW (iInf_le _ hi))
    _ ≤ topologicalKrullDim (c i '' Q) :=
        (IsInducing.subtypeVal.of_comp_iff.mp hval : IsInducing r).topologicalKrullDim_le
    _ = topologicalKrullDim Q := (IsHomeomorph.topologicalKrullDim_eq _
        ((c i).isOpenEmbedding.isEmbedding.homeomorphImage Q).isHomeomorph).symm
    _ = topologicalKrullDim ((c i ≫ f).fiber y) := (IsHomeomorph.topologicalKrullDim_eq _
        ((c i ≫ f).fiberHomeo y).isHomeomorph).symm
    _ ≤ n := h i

/-- **The fibres of the blowup in an ideal with `d` generators have dimension `< d`.** Let `R`
be a commutative ring, `g₁, …, g_d ∈ R` and `b : X' ⟶ Spec R` the blowup of `Spec R` in the ideal
`(g₁, …, g_d)`. Then every fibre of `b` has dimension at most `d - 1`; for `d = 0` the blowup is
empty and every fibre has dimension `⊥`.

This is the dimension estimate in the proof of [Stacks, Tag 0EJN]. -/
theorem topologicalKrullDim_fiber_blowUpToBase_lt_of_eq_span (R : Type u) [CommRing R] (d : ℕ)
    (g : Fin d → R) :
    ∀ y : Spec (CommRingCat.of R),
      topologicalKrullDim ((Stacks.Blowup.blowUpToBase
        (Stacks.LocalCohomology.specIdealSheaf R (Ideal.span (Set.range g)))).fiber y)
        < (d : WithBot ℕ∞) := by
  intro y
  set J := Stacks.LocalCohomology.specIdealSheaf R (Ideal.span (Set.range g))
  let U : (Spec (CommRingCat.of R)).affineOpens := ⟨⊤, isAffineOpen_top _⟩
  let φ := (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom
  let a : Fin d → Γ(Spec (CommRingCat.of R), U.1) := fun i => φ (g i)
  have hJ : J.ideal U = Ideal.span (Set.range a) := by
    have h1 : J.ideal U = (Ideal.span (Set.range g)).map φ :=
      Scheme.IdealSheafData.equivOfIsAffine.apply_symm_apply _
    rw [h1, Ideal.map_span, ← Set.range_comp]
    rfl
  have ha : ∀ i, a i ∈ J.ideal U := fun i => hJ ▸ Ideal.subset_span ⟨i, rfl⟩
  have hcov : ⨆ i, (blowUpAffineChart J U (ha i)).opensRange = ⊤ := by
    rw [iSup_opensRange_blowUpAffineChart_of_span J U a ha hJ.symm]
    exact Scheme.Hom.preimage_top _
  cases d with
  | zero =>
    exact (topologicalKrullDim_fiber_le_of_iSup_opensRange (blowUpToBase J) _ hcov y
      (n := ⊥) fun i => i.elim0).trans_lt (WithBot.bot_lt_coe _)
  | succ n =>
    refine (topologicalKrullDim_fiber_le_of_iSup_opensRange (blowUpToBase J) _ hcov y
      (n := (n : WithBot ℕ∞)) fun i => ?_).trans_lt (by exact_mod_cast Nat.lt_succ_self n)
    rw [blowUpAffineChart_blowUpToBase]
    set e := (Stacks.RelativeProj.isAffineOpen U).fromSpec
    obtain ⟨y', rfl⟩ : y ∈ Set.range e := by
      rw [IsAffineOpen.range_fromSpec]
      trivial
    rw [← topologicalKrullDim_fiber_eq_of_square _ _ (Homeomorph.refl _) e
      e.isOpenEmbedding.injective (fun x => Scheme.Hom.comp_apply _ _ x) y']
    refine (topologicalKrullDim_fiber_specMap_eq Γ(Spec (CommRingCat.of R), U.1)
      (affineBlowup (J.ideal U) (a i)) y').trans_le ?_
    have : y'.asIdeal.IsPrime := y'.isPrime
    have key : ∀ K : Ideal Γ(Spec (CommRingCat.of R), U.1), K = Ideal.span (Set.range a) →
        ringKrullDim (y'.asIdeal.Fiber (affineBlowup K (a i))) ≤ (n : WithBot ℕ∞) := by
      rintro K rfl
      simpa only [Nat.card_eq_fintype_card, Fintype.card_fin] using
        ringKrullDim_fiber_le_natCard_of_adjoin _
          (adjoin_range_spanFraction_succAbove a i) y'.asIdeal
    exact key _ hJ

/-- **The fibres of the blowup in an ideal with `d` generators have dimension `< d`**, for the
construction `AlgebraicGeometry.blowUpToBase` of the blowup: it is isomorphic over the base to
`Stacks.Blowup.blowUpToBase` by `Stacks.Blowup.blowUpIso`, so the fibres are homeomorphic and
`Stacks.Blowup.topologicalKrullDim_fiber_blowUpToBase_lt_of_eq_span` applies. -/
theorem topologicalKrullDim_fiber_algebraicGeometry_blowUpToBase_lt_of_eq_span (R : Type u)
    [CommRing R] (d : ℕ) (g : Fin d → R) :
    ∀ y : Spec (CommRingCat.of R),
      topologicalKrullDim ((AlgebraicGeometry.blowUpToBase
        (Stacks.LocalCohomology.specIdealSheaf R (Ideal.span (Set.range g)))).fiber y)
        < (d : WithBot ℕ∞) := by
  intro y
  set J := Stacks.LocalCohomology.specIdealSheaf R (Ideal.span (Set.range g))
  have h := topologicalKrullDim_fiber_eq_of_square (AlgebraicGeometry.blowUpToBase J)
    (Stacks.Blowup.blowUpToBase J) (Scheme.homeoOfIso (blowUpIso J)) (𝟙 _)
    Function.injective_id (fun x => by
      rw [Scheme.homeoOfIso_apply, ← Scheme.Hom.comp_apply, blowUpIso_hom_comp]
      rfl) y
  exact h ▸ topologicalKrullDim_fiber_blowUpToBase_lt_of_eq_span R d g y

end Stacks.Blowup

end
