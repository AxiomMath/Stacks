/-!
# Strict transforms of flat schemes and modules

Let `S'` be the blowup of a scheme `S` in a closed subscheme `Z`, let `f : X ⟶ S` be an
`S`-scheme and let `F` be a quasi-coherent `𝒪_X`-module. If `X`, respectively `F`, is flat over
`S` at every point lying over `Z`, then its strict transform along the blowup is nothing but its
base change, respectively its pullback, along `pr_X : X ×_S S' ⟶ X`.

The reason is local: the exceptional ideal is an effective Cartier divisor, so near a point of
the exceptional locus it is generated by a single nonzerodivisor `a`; a section of `pr_X^* F`
supported on the exceptional preimage is killed by a power of the pullback of `a`, and flatness
makes that pullback act injectively on the stalk. So there are no nonzero sections supported on
the exceptional preimage at all, and the quotient defining the strict transform is the identity.

## Main results

* `AlgebraicGeometry.strictTransformIdeal_eq_bot_of_flat_at_exceptional`: part (1), the ideal
  cutting out the strict transform of `X` inside `X ×_S S'` is zero, so the strict transform is
  the whole base change.
* `AlgebraicGeometry.isIso_strictTransformSheaf_quotient_of_flat_at_exceptional`: part (2), the
  canonical quotient map from `pr_X^* F` onto the strict transform of `F` is an isomorphism.

## Implementation notes

Both statements are recorded as properties of the canonical comparison maps rather than as the
existence of some isomorphism: part (1) says the defining ideal is `⊥`, part (2) says that
`Stacks.StrictTransform.π` is invertible. That is strictly more information than an unspecified
identification.

The strict transform of this repository, `Stacks.StrictTransform`, is formed for an arbitrary
morphism `b : S' ⟶ S` and an arbitrary quasi-coherent ideal `E` on `S'`; the two theorems below
instantiate it at `b = AlgebraicGeometry.blowUpToBase I` and
`E = AlgebraicGeometry.exceptionalIdeal I`, which is the situation of tag 080D. The vanishing
lemma that does the work is stated for an arbitrary morphism and an arbitrary *effective
Cartier* ideal on its target, since that is all the argument uses.

## References

* [Stacks Project, Tag 080F](https://stacks.math.columbia.edu/tag/080F)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry.Scheme.Modules

universe u

namespace AlgebraicGeometry

/-- In a commutative ring, an element acting injectively by scalar multiplication on the ring is
a nonzerodivisor. -/
private alias mem_nonZeroDivisors_of_isSMulRegular :=
  Stacks.PuncturedSpectrumPicard.mem_nonZeroDivisors_of_isSMulRegular

/-- **A section supported on the zero locus of a principal ideal is killed by a power of its
generator.** Let `g : Y ⟶ T`, let `D` be a quasi-coherent ideal on `T` generated on an affine
open `W` by a single function `a`, and let `V` be an affine open of `Y` lying over `W`. A section
of a quasi-coherent module `F` over `V` all of whose germs outside `g⁻¹(Supp D)` vanish is
annihilated by a power of the pullback of `a` to `V`. -/
@[ega "I 1.4.1" "c), special case"]
private lemma exists_pow_smul_eq_zero_of_mem_supportedSectionsSubmodule
    {Y T : Scheme.{u}} (g : Y ⟶ T) (D : T.IdealSheafData) (F : Y.Modules) [F.IsQuasicoherent]
    {W : T.Opens} (hW : IsAffineOpen W) (a : Γ(T, W))
    (hchart : D.ideal ⟨W, hW⟩ = Ideal.span {a})
    {V : Y.Opens} (hV : IsAffineOpen V) (hVW : V ≤ g ⁻¹ᵁ W) (s : Γ(F, V))
    (hs : s ∈ (supportedSectionsSubmodule (g.base ⁻¹' D.support) F).toSubmodule.obj (op V)) :
    ∃ n : ℕ, g.appLE W V hVW a ^ n • s = 0 := by
  set b : Γ(Y, V) := g.appLE W V hVW a
  have hcompl : s ∈ (supportedSectionsSubmodule
      ((g ⁻¹ᵁ T.basicOpen a : Y.Opens) : Set Y)ᶜ F).toSubmodule.obj (op V) := by
    refine (mem_supportedSectionsSubmodule_iff _ F V s).mpr fun y hyV hy ↦ ?_
    refine (mem_supportedSectionsSubmodule_iff _ F V s).mp hs y hyV fun hmem ↦ ?_
    rw [Set.mem_preimage] at hmem
    have hz : g.base y ∈ T.zeroLocus (U := W) (D.ideal ⟨W, hW⟩) :=
      (Scheme.IdealSheafData.mem_support_iff_of_mem (I := D) (U := ⟨W, hW⟩) (hVW hyV)).mp hmem
    rw [hchart, Scheme.zeroLocus_span, Scheme.mem_zeroLocus_iff] at hz
    exact hz a (Set.mem_singleton a) (not_not.mp hy)
  have hmove (W' : Y.Opens) (i : W' ≤ V) (hW' : W' = V ⊓ g ⁻¹ᵁ T.basicOpen a) :
      (F.presheaf.map (homOfLE (show V ⊓ g ⁻¹ᵁ T.basicOpen a ≤ V from inf_le_left)).op s = 0) ↔
        F.presheaf.map (homOfLE i).op s = 0 := by
    subst hW'
    rfl
  exact Stacks.ModuleSectionExtension.exists_pow_smul_eq_zero F hV b s
    ((hmove (Y.basicOpen b) (Y.basicOpen_le b) (Scheme.basicOpen_appLE g V W hVW a)).mp
      ((mem_supportedSectionsSubmodule_compl_iff_restrict_eq_zero
        (g ⁻¹ᵁ T.basicOpen a) F V s).mp hcompl))

/-- **The germ of a supported section vanishes at a flat point.** In the situation of
`AlgebraicGeometry.exists_pow_smul_eq_zero_of_mem_supportedSectionsSubmodule`, if moreover `a` is
a nonzerodivisor and `F` is flat over `T` at a point `x` of `V`, then the germ of the section at
`x` is zero: the germ of `a` is a nonzerodivisor on the stalk of `T` at `g x`, hence acts
injectively on the stalk of `F` at `x`, which the power annihilating the section forbids. -/
private lemma germ_eq_zero_of_mem_supportedSectionsSubmodule_of_isFlatOverAt
    {Y T : Scheme.{u}} (g : Y ⟶ T) (D : T.IdealSheafData) (F : Y.Modules) [F.IsQuasicoherent]
    {W : T.Opens} (hW : IsAffineOpen W) (a : Γ(T, W)) (ha : IsRegular a)
    (hchart : D.ideal ⟨W, hW⟩ = Ideal.span {a})
    {V : Y.Opens} (hV : IsAffineOpen V) (hVW : V ≤ g ⁻¹ᵁ W) {x : Y} (hxV : x ∈ V)
    (hflat : IsFlatOverAt g.toLRSHom.toShHom F x) (s : Γ(F, V))
    (hs : s ∈ (supportedSectionsSubmodule (g.base ⁻¹' D.support) F).toSubmodule.obj (op V)) :
    TopCat.Presheaf.germ (modulePresheaf F).presheaf V x hxV s = 0 := by
  obtain ⟨n, hn⟩ := exists_pow_smul_eq_zero_of_mem_supportedSectionsSubmodule g D F hW a hchart
    hV hVW s hs
  have hxW : g.base x ∈ W := hVW hxV
  -- The repository carries a second `𝒪_{Y,x}`-module structure on the stalk, namely
  -- `Stacks.SheafOfModules.TensorStalkRingedSpace.stalkModule`, which instance search prefers
  -- in this import closure; `AlgebraicGeometry.IsFlatOverAt` and `PresheafOfModules.germ_smul`
  -- are stated for Mathlib's, so it is pinned here as a local instance.
  let _ : Module (Y.presheaf.stalk x)
      (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u}) (modulePresheaf F).presheaf x) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (modulePresheaf F) x
  let _ : Module (T.presheaf.stalk (g.base x))
      (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u}) (modulePresheaf F).presheaf x) :=
    Module.compHom _ (g.stalkMap x).hom
  have : Module.Flat (T.presheaf.stalk (g.base x))
      (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u}) (modulePresheaf F).presheaf x) := hflat
  set aR : T.presheaf.stalk (g.base x) := T.presheaf.germ W (g.base x) hxW a with haR
  have hmem : aR ^ n ∈ nonZeroDivisors (T.presheaf.stalk (g.base x)) :=
    pow_mem (mem_nonZeroDivisors_of_isSMulRegular
      (isSMulRegular_germ_of_isAffineOpen T hW ha.left.isSMulRegular ⟨g.base x, hxW⟩)) n
  have hscalar : Y.presheaf.germ V x hxV (g.appLE W V hVW a ^ n) =
      (g.stalkMap x).hom (aR ^ n) := by
    rw [map_pow, map_pow, haR, Scheme.Hom.appLE, CommRingCat.comp_apply,
      TopCat.Presheaf.germ_res_apply Y.presheaf (homOfLE hVW) x hxV]
    exact congrArg (· ^ n) (Scheme.Hom.germ_stalkMap_apply g W x hxW a).symm
  have hzero : TopCat.Presheaf.germ (modulePresheaf F).presheaf V x hxV
      (g.appLE W V hVW a ^ n • s) = 0 :=
    (congrArg (fun t : Γ(F, V) ↦
      TopCat.Presheaf.germ (modulePresheaf F).presheaf V x hxV t) hn).trans (map_zero _)
  have hsmul := PresheafOfModules.germ_smul (modulePresheaf F) x V hxV
    (g.appLE W V hVW a ^ n) s
  rw [hscalar] at hsmul
  exact Module.Flat.isSMulRegular_of_nonZeroDivisors hmem
    ((hsmul.symm.trans hzero).trans (smul_zero _).symm)

/-- **No nonzero sections supported on the inverse image of an effective Cartier divisor.** Let
`g : Y ⟶ T` be a morphism of schemes, let `D` be an effective Cartier divisor on `T` and let `F`
be a quasi-coherent `𝒪_Y`-module which is flat over `T` at every point of `g⁻¹(Supp D)`. Then
every local section of `F` whose germs vanish outside `g⁻¹(Supp D)` is zero. -/
private lemma eq_zero_of_mem_supportedSectionsSubmodule_of_flat
    {Y T : Scheme.{u}} (g : Y ⟶ T) (D : T.IdealSheafData)
    (hD : Stacks.Divisors.IsEffectiveCartierDivisor D) (F : Y.Modules) [F.IsQuasicoherent]
    (hflat : ∀ y : Y, g.base y ∈ D.support → IsFlatOverAt g.toLRSHom.toShHom F y)
    (U : Y.Opens) (s : Γ(F, U))
    (hs : s ∈ (supportedSectionsSubmodule (g.base ⁻¹' D.support) F).toSubmodule.obj (op U)) :
    s = 0 := by
  refine TopCat.Presheaf.section_ext ⟨F.val.presheaf, F.isSheaf⟩ U s 0 fun x hxU ↦ ?_
  rw [map_zero]
  by_cases hxD : g.base x ∈ D.support
  · obtain ⟨W, hW, hxW, a, ha, e, he⟩ :=
      (Stacks.Divisors.isEffectiveCartierDivisor_iff_affineLocal D).mp hD (g.base x) hxD
    obtain ⟨-, ⟨V, hV, rfl⟩, hxV, hVsub⟩ :=
      Y.isBasis_affineOpens.exists_subset_of_mem_open
        (show x ∈ U ⊓ g ⁻¹ᵁ W from ⟨hxU, hxW⟩) (U ⊓ g ⁻¹ᵁ W).2
    have hVU : V ≤ U := hVsub.trans inf_le_left
    set t : Γ(F, V) := F.presheaf.map (homOfLE hVU).op s
    have hres (y : Y) (hy : y ∈ V) :
        TopCat.Presheaf.germ F.val.presheaf V y hy t =
          TopCat.Presheaf.germ F.val.presheaf U y (hVU hy) s :=
      TopCat.Presheaf.germ_res_apply F.val.presheaf (homOfLE hVU) y hy s
    have hts : t ∈ (supportedSectionsSubmodule (g.base ⁻¹' D.support) F).toSubmodule.obj (op V) :=
      (mem_supportedSectionsSubmodule_iff _ F V t).mpr fun y hy hyD ↦
        (hres y hy).trans ((mem_supportedSectionsSubmodule_iff _ F U s).mp hs y (hVU hy) hyD)
    exact (hres x hxV).symm.trans (germ_eq_zero_of_mem_supportedSectionsSubmodule_of_isFlatOverAt
      g D F hW a ha (Stacks.Divisors.ideal_eq_quotient_of_chart D W hW (Ideal.span {a}) e he) hV
      (hVsub.trans inf_le_right) hxV (hflat x hxD) t hts)
  · exact (mem_supportedSectionsSubmodule_iff _ F U s).mp hs x hxU hxD

/-- The inclusion of the sections supported on the inverse image of an effective Cartier divisor
is the zero morphism, when the module is quasi-coherent and flat over the target along that
inverse image. -/
private lemma supportedSectionsι_eq_zero_of_flat
    {Y T : Scheme.{u}} (g : Y ⟶ T) (D : T.IdealSheafData)
    (hD : Stacks.Divisors.IsEffectiveCartierDivisor D) (F : Y.Modules) [F.IsQuasicoherent]
    (hflat : ∀ y : Y, g.base y ∈ D.support → IsFlatOverAt g.toLRSHom.toShHom F y) :
    supportedSectionsι (g.base ⁻¹' D.support) F = 0 := by
  apply Scheme.Modules.hom_ext
  intro U
  ext s
  exact eq_zero_of_mem_supportedSectionsSubmodule_of_flat g D hD F hflat U s.1 s.2

/-- The pullback of a quasi-coherent module which is flat over `S` above the centre of a blowup
is flat over the blowup above the exceptional preimage. -/
private lemma isFlatOverAt_pullback_of_mem_exceptionalPreimage
    {X S : Scheme.{u}} (f : X ⟶ S) (I : S.IdealSheafData) (F : X.Modules) [F.IsQuasicoherent]
    (hflat : ∀ x : X, f x ∈ I.support → IsFlatOverAt f.toLRSHom.toShHom F x)
    (y : Stacks.StrictTransform.baseChange f (blowUpToBase I))
    (hy : (pullback.snd f (blowUpToBase I)).base y ∈ (exceptionalIdeal I).support) :
    IsFlatOverAt (pullback.snd f (blowUpToBase I)).toLRSHom.toShHom
      ((Scheme.Modules.pullback (pullback.fst f (blowUpToBase I))).obj F) y := by
  let G : SheafOfModules.{u} (structureSheafRing X.toRingedSpace) := F
  have : G.IsQuasicoherent := inferInstanceAs F.IsQuasicoherent
  refine modulePullback_isFlatOverAt (IsPullback.of_hasPullback f (blowUpToBase I)) G y
    (hflat _ ?_)
  rw [Scheme.IdealSheafData.support_comap I (blowUpToBase I)] at hy
  have hcond : f ((pullback.fst f (blowUpToBase I)).base y) =
      blowUpToBase I ((pullback.snd f (blowUpToBase I)).base y) :=
    congrArg (fun k : Stacks.StrictTransform.baseChange f (blowUpToBase I) ⟶ S ↦ k y)
      pullback.condition
  rwa [hcond]

/-- **Stacks Project, Tag 080F (1).** If `X` is flat over `S` at every point lying over the
centre of the blowup, then the strict transform of `X` is the whole base change `X ×_S S'`: the
ideal cutting it out is zero. -/
@[stacks 080F "part (1)"]
public theorem strictTransformIdeal_eq_bot_of_flat_at_exceptional
    {X S : Scheme.{u}} (f : X ⟶ S) (I : S.IdealSheafData)
    (hflat : ∀ x : X, f x ∈ I.support → IsFlatAt f.toLRSHom.toShHom x) :
    Stacks.StrictTransform.ideal f (blowUpToBase I) (exceptionalIdeal I) = ⊥ := by
  have hbase : ∀ y : Stacks.StrictTransform.baseChange f (blowUpToBase I),
      (pullback.snd f (blowUpToBase I)).base y ∈ (exceptionalIdeal I).support →
      IsFlatOverAt (pullback.snd f (blowUpToBase I)).toLRSHom.toShHom
        (Scheme.unitModule (Stacks.StrictTransform.baseChange f (blowUpToBase I))) y :=
    fun y hy ↦ isFlatOverAt_of_moduleIso _
      (Scheme.Modules.pullbackUnitIso (pullback.fst f (blowUpToBase I))) y
        (isFlatOverAt_pullback_of_mem_exceptionalPreimage f I (Scheme.unitModule X)
          (fun x hx ↦ (isFlatOverAt_unit_iff_isFlatAt f x).mpr (hflat x hx)) y hy)
  have hzero := eq_zero_of_mem_supportedSectionsSubmodule_of_flat
    (pullback.snd f (blowUpToBase I)) (exceptionalIdeal I) inferInstance
    (Scheme.unitModule (Stacks.StrictTransform.baseChange f (blowUpToBase I))) hbase
  exact eq_bot_iff.mpr (Scheme.IdealSheafData.le_def.mpr fun V s hs ↦
    Ideal.mem_bot.mpr (hzero V.1 s (Scheme.IdealSheafData.ideal_ofIdeals_le _ V hs)))

/-- **Stacks Project, Tag 080F (2).** If a quasi-coherent `𝒪_X`-module `F` is flat over `S` at
every point lying over the centre of the blowup, then the canonical quotient map from `pr_X^* F`
onto the strict transform of `F` is an isomorphism. -/
@[stacks 080F "part (2)"]
public theorem isIso_strictTransformSheaf_quotient_of_flat_at_exceptional
    {X S : Scheme.{u}} (f : X ⟶ S) (I : S.IdealSheafData) (F : X.Modules) [F.IsQuasicoherent]
    (hflat : ∀ x : X, f x ∈ I.support → IsFlatOverAt f.toLRSHom.toShHom F x) :
    IsIso (Stacks.StrictTransform.π f (blowUpToBase I) (exceptionalIdeal I) F) :=
  cokernel.π_of_zero (supportedSectionsι_eq_zero_of_flat (pullback.snd f (blowUpToBase I))
    (exceptionalIdeal I) inferInstance _
    (isFlatOverAt_pullback_of_mem_exceptionalPreimage f I F hflat))

end AlgebraicGeometry

