* [Stacks Project, Tag 0C3E](https://stacks.math.columbia.edu/tag/0C3E)
-/


@[expose] public noncomputable section

open CategoryTheory

universe u v

/-! ### The Fitting ideals of a finite module in high index -/

/-- The Fitting ideals of a module generated by `n` elements are the unit ideal in every index
`k ≥ n`: the `n`-th one is the unit ideal by tag 07ZA, and the Fitting ideals increase by tag
07Z7. -/
theorem fittingIdeal_eq_top_of_le {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] [Module.Finite R M] {n k : ℕ} (hnk : n ≤ k)
    (s : Fin n → M) (hs : Submodule.span R (Set.range s) = ⊤) :
    _root_.fittingIdeal (R := R) (M := M) (k : ℤ) = ⊤ := by
  refine eq_top_iff.mpr ?_
  rw [← (fittingIdeal_basic_properties.{u, v, 0, 0} (R := R) (M := M)).1 n ⟨s, hs⟩]
  exact Stacks.Fitting.fittingIdeal_monotone (by exact_mod_cast hnk)

/-- The Fitting ideals of a finite module are the unit ideal from some index on, a finite module
being generated by finitely many elements. -/
theorem exists_forall_fittingIdeal_eq_top {R : Type u} [CommRing R] {M : Type v}
    [AddCommGroup M] [Module R M] [Module.Finite R M] :
    ∃ N : ℕ, ∀ k : ℕ, N ≤ k → _root_.fittingIdeal (R := R) (M := M) (k : ℤ) = ⊤ := by
  obtain ⟨n, s, hs⟩ := Module.Finite.exists_fin (R := R) (M := M)
  exact ⟨n, fun k hk => fittingIdeal_eq_top_of_le hk s hs⟩

namespace AlgebraicGeometry

variable {X : Scheme.{u}} (F : X.Modules)

/-- **The local finiteness of the family of Fitting ideals.** On an affine open the Fitting ideal
sheaves of a finite type quasi-coherent module are the unit ideal from some index on, the sections
forming a finite module over the ring of functions. -/
theorem exists_forall_fittingIdeal_ideal_eq_top [F.IsFiniteType] [F.IsQuasicoherent]
    (U : X.affineOpens) :
    ∃ N : ℕ, ∀ k : ℕ, N ≤ k → (fittingIdeal F (k : ℤ)).ideal U = ⊤ := by
  have hfin : Module.Finite Γ(X, U.1) Γ(F, U.1) :=
    moduleFinite_sections_on_affine F U.1 U.2
  obtain ⟨N, hN⟩ := exists_forall_fittingIdeal_eq_top (R := Γ(X, U.1)) (M := Γ(F, U.1))
  refine ⟨N, fun k hk => ?_⟩
  rw [fittingIdeal_ideal F (k : ℤ) U]
  exact hN k hk

/-! ### The truncated products -/

/-- The product of the Fitting ideal sheaves of `ℱ` of index at most `N`, omitting the indices in
the finite set `e`. For `e = ∅` this is `AlgebraicGeometry.fittingIdealProd`. -/
abbrev fittingIdealProdDiff (e : Finset ℕ) (N : ℕ) : X.IdealSheafData :=
  ∏ k ∈ Finset.range (N + 1) \ e, fittingIdeal F (k : ℤ)

/-- Omitting no index gives back the truncated product of
`StacksFrontier.AlgebraicGeometry.Blowup.Transform.FittingProduct`. -/
theorem fittingIdealProdDiff_empty (N : ℕ) :
    fittingIdealProdDiff F ∅ N = fittingIdealProd F N := by
  rw [fittingIdealProdDiff, Finset.sdiff_empty]

/-- Raising the bound enlarges the set of indices of the truncated product. -/
private theorem range_succ_sdiff_subset (e : Finset ℕ) {M N : ℕ} (h : M ≤ N) :
    Finset.range (M + 1) \ e ⊆ Finset.range (N + 1) \ e :=
  Finset.sdiff_subset_sdiff (Finset.range_mono (by omega)) le_rfl

/-- The truncated products decrease as the bound grows: a product of more ideals is smaller. -/
theorem fittingIdealProdDiff_ideal_le (e : Finset ℕ) (U : X.affineOpens) {M N : ℕ} (h : M ≤ N) :
    (fittingIdealProdDiff F e N).ideal U ≤ (fittingIdealProdDiff F e M).ideal U := by
  classical
  rw [Scheme.IdealSheafData.ideal_finsetProd_eq_prod,
    Scheme.IdealSheafData.ideal_finsetProd_eq_prod,
    ← Finset.prod_sdiff (range_succ_sdiff_subset e h)]
  exact Ideal.mul_le_right

/-- Past the index from which the Fitting ideals are the unit ideal on an affine open, the
truncated products all have the same sections there, the new factors being the unit ideal. -/
theorem fittingIdealProdDiff_ideal_eq_of_le (e : Finset ℕ) (U : X.affineOpens) {N : ℕ}
    (hN : ∀ k : ℕ, N ≤ k → (fittingIdeal F (k : ℤ)).ideal U = ⊤) {M : ℕ} (hM : N ≤ M) :
    (fittingIdealProdDiff F e M).ideal U = (fittingIdealProdDiff F e N).ideal U := by
  classical
  rw [Scheme.IdealSheafData.ideal_finsetProd_eq_prod,
    Scheme.IdealSheafData.ideal_finsetProd_eq_prod]
  refine (Finset.prod_subset (range_succ_sdiff_subset e hM) ?_).symm
  · intro j hj hj'
    simp only [Finset.mem_sdiff, Finset.mem_range] at hj hj'
    have hjN : N ≤ j := by
      by_contra hc
      exact hj' ⟨by omega, hj.2⟩
    rw [hN j hjN, Ideal.one_eq_top]

/-- The intersection of the truncated products on an affine open is the truncation at any index
past which the Fitting ideals are the unit ideal there. -/
theorem iInf_fittingIdealProdDiff_ideal (e : Finset ℕ) (U : X.affineOpens) {N : ℕ}
    (hN : ∀ k : ℕ, N ≤ k → (fittingIdeal F (k : ℤ)).ideal U = ⊤) :
    (⨅ M : ℕ, (fittingIdealProdDiff F e M).ideal U) = (fittingIdealProdDiff F e N).ideal U := by
  refine le_antisymm (iInf_le _ N) (le_iInf fun M => ?_)
  rcases le_total M N with h | h
  · exact fittingIdealProdDiff_ideal_le F e U h
  · exact (fittingIdealProdDiff_ideal_eq_of_le F e U hN h).ge

/-- The intersection of the truncated products is compatible with restriction to a basic open:
the same truncation computes it on both opens, and that truncation is a quasi-coherent ideal
sheaf. -/
theorem map_iInf_fittingIdealProdDiff_ideal [F.IsFiniteType] [F.IsQuasicoherent]
    (e : Finset ℕ) (U : X.affineOpens) (s : Γ(X, U.1)) :
    (⨅ M : ℕ, (fittingIdealProdDiff F e M).ideal U).map
        (X.presheaf.map (homOfLE (X.basicOpen_le s)).op).hom =
      ⨅ M : ℕ, (fittingIdealProdDiff F e M).ideal (X.affineBasicOpen s) := by
  obtain ⟨N, hN⟩ := exists_forall_fittingIdeal_ideal_eq_top F U
  have hNs : ∀ k : ℕ, N ≤ k → (fittingIdeal F (k : ℤ)).ideal (X.affineBasicOpen s) = ⊤ := by
    intro k hk
    rw [← (fittingIdeal F (k : ℤ)).map_ideal_basicOpen U s, hN k hk]
    exact Ideal.map_top _
  rw [iInf_fittingIdealProdDiff_ideal F e U hN,
    iInf_fittingIdealProdDiff_ideal F e (X.affineBasicOpen s) hNs]
  exact (fittingIdealProdDiff F e N).map_ideal_basicOpen U s

/-! ### The product over all the indices -/

/-- The product of *all* the Fitting ideal sheaves of `ℱ` whose index is not in the finite set
`e`, realized as the intersection of the truncated products. On an affine open the truncations
are eventually constant, so this is the product of the whole family; see
`AlgebraicGeometry.fittingIdealProdAllDiff_ideal_eq_of_forall_eq_top`. -/
def fittingIdealProdAllDiff (e : Finset ℕ) : X.IdealSheafData :=
  Scheme.IdealSheafData.ofIdeals fun U => ⨅ M : ℕ, (fittingIdealProdDiff F e M).ideal U

/-- The sections of `AlgebraicGeometry.fittingIdealProdAllDiff` are the intersection of the
sections of the truncated products: that family is already a quasi-coherent ideal sheaf, so
passing to the largest ideal sheaf below it changes nothing. -/
theorem fittingIdealProdAllDiff_ideal [F.IsFiniteType] [F.IsQuasicoherent] (e : Finset ℕ)
    (U : X.affineOpens) :
    (fittingIdealProdAllDiff F e).ideal U =
      ⨅ M : ℕ, (fittingIdealProdDiff F e M).ideal U := by
  let J : X.IdealSheafData :=
    { ideal := fun V => ⨅ M : ℕ, (fittingIdealProdDiff F e M).ideal V
      map_ideal_basicOpen := fun V s => map_iInf_fittingIdealProdDiff_ideal F e V s }
  have hJ : fittingIdealProdAllDiff F e = J :=
    Scheme.IdealSheafData.ofIdeals_ideal J
  exact congrFun (congrArg Scheme.IdealSheafData.ideal hJ) U

/-- On an affine open the product over all the indices is the truncation at any index past which
the Fitting ideals are the unit ideal there. -/
theorem fittingIdealProdAllDiff_ideal_eq_of_forall_eq_top [F.IsFiniteType] [F.IsQuasicoherent]
    (e : Finset ℕ) (U : X.affineOpens) {N : ℕ}
    (hN : ∀ k : ℕ, N ≤ k → (fittingIdeal F (k : ℤ)).ideal U = ⊤) :
    (fittingIdealProdAllDiff F e).ideal U = (fittingIdealProdDiff F e N).ideal U := by
  rw [fittingIdealProdAllDiff_ideal F e U, iInf_fittingIdealProdDiff_ideal F e U hN]

/-- The product of all the Fitting ideal sheaves of `ℱ`, the centre of the blowup of tag
0ESU. -/
abbrev fittingIdealProdAll : X.IdealSheafData := fittingIdealProdAllDiff F ∅

/-- The product of all the Fitting ideals is of finite type: on an affine open it is a finite
product of Fitting ideals, each of finite type by tag 0C3E. -/
theorem isFiniteType_fittingIdealProdAllDiff [F.IsFinitePresentation] (e : Finset ℕ) :
    (fittingIdealProdAllDiff F e).IsFiniteType := by
  have : F.IsFiniteType := SheafOfModules.instIsFiniteTypeOfIsFinitePresentation F
  have : F.IsQuasicoherent := SheafOfModules.instIsQuasicoherentOfIsFinitePresentation F
  intro U
  obtain ⟨N, hN⟩ := exists_forall_fittingIdeal_ideal_eq_top F U
  rw [fittingIdealProdAllDiff_ideal_eq_of_forall_eq_top F e U hN]
  exact Stacks.Blowup.isFiniteType_prod (Finset.range (N + 1) \ e)
    (fun k : ℕ => fittingIdeal F (k : ℤ)) (fun k => fittingIdeal_isFiniteType F k) U

/-- The product of all the Fitting ideals is supported away from an open on which the module
vanishes: near a point of that open it agrees with a finite product of Fitting ideals, each of
which is supported away from the open. -/
theorem disjoint_support_fittingIdealProdAllDiff [F.IsFiniteType] [F.IsQuasicoherent]
    (U : X.Opens)
    (hrank : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback U.ι).obj F) 0) (e : Finset ℕ) :
    Disjoint (U : Set X) ((fittingIdealProdAllDiff F e).support : Set X) := by
  rw [Set.disjoint_left]
  intro x hxU hx
  have hmem : x ∈ (⨆ V : X.affineOpens, (V : X.Opens)) := by
    rw [iSup_affineOpens_eq_top]; trivial
  obtain ⟨V, hxV⟩ := TopologicalSpace.Opens.mem_iSup.mp hmem
  obtain ⟨N, hN⟩ := exists_forall_fittingIdeal_ideal_eq_top F V
  have hx' : x ∈ (fittingIdealProdAllDiff F e).support := hx
  rw [Scheme.IdealSheafData.mem_support_iff_of_mem (U := V) hxV,
    fittingIdealProdAllDiff_ideal_eq_of_forall_eq_top F e V hN,
    ← Scheme.IdealSheafData.mem_support_iff_of_mem
      (I := fittingIdealProdDiff F e N) (U := V) hxV] at hx'
  exact Set.disjoint_left.mp
    (Stacks.Blowup.disjoint_support_prod U (Finset.range (N + 1) \ e)
      (fun k : ℕ => fittingIdeal F (k : ℤ)) fun k _ =>
        disjoint_support_fittingIdeal_of_rank_zero F U hrank k) hxU hx'

/-- For a finitely presented `𝒪_X`-module vanishing on an open `U`, the blowup of `X` in the
product of **all** the Fitting ideals is a `U`-admissible blowup: that product is of finite type
and supported away from `U`. -/
@[stacks 0ESU "the U-admissible blowup, in the product of all the Fitting ideals"]
theorem isAdmissibleBlowup_blowUpToBase_fittingIdealProdAll [F.IsFinitePresentation]
    (U : X.Opens)
    (hrank : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback U.ι).obj F) 0) :
    Stacks.Blowup.IsAdmissibleBlowup U (blowUpToBase (fittingIdealProdAll F)) := by
  have : F.IsFiniteType := SheafOfModules.instIsFiniteTypeOfIsFinitePresentation F
  have : F.IsQuasicoherent := SheafOfModules.instIsQuasicoherentOfIsFinitePresentation F
  refine (Stacks.Blowup.isAdmissibleBlowup_iff U _).mpr
    ⟨fittingIdealProdAll F, ?_,
      disjoint_support_fittingIdealProdAllDiff F U hrank ∅, Iso.refl _, Category.id_comp _⟩
  rw [finitePresentation_subschemeι_iff_isFiniteType]
  exact isFiniteType_fittingIdealProdAllDiff F ∅

/-- The product of all the Fitting ideals splits off any single one of them, the complementary
factor being the product of all the others — the same construction with that index removed. -/
theorem fittingIdealProdAll_eq_mul [F.IsFiniteType] [F.IsQuasicoherent] (k : ℕ) :
    fittingIdealProdAll F = fittingIdeal F (k : ℤ) * fittingIdealProdAllDiff F {k} := by
  classical
  refine Scheme.IdealSheafData.ext (funext fun U => ?_)
  obtain ⟨N₀, hN₀⟩ := exists_forall_fittingIdeal_ideal_eq_top F U
  have hN : ∀ j : ℕ, max N₀ k ≤ j → (fittingIdeal F (j : ℤ)).ideal U = ⊤ := fun j hj =>
    hN₀ j (le_trans (le_max_left N₀ k) hj)
  have hkN : k ∈ Finset.range (max N₀ k + 1) :=
    Finset.mem_range.mpr (Nat.lt_succ_of_le (le_max_right N₀ k))
  have hmul : (fittingIdeal F (k : ℤ) * fittingIdealProdAllDiff F {k}).ideal U =
      (fittingIdeal F (k : ℤ)).ideal U * (fittingIdealProdAllDiff F {k}).ideal U := by
    simp only [Scheme.IdealSheafData.ideal_mul, Pi.mul_apply]
  rw [hmul, fittingIdealProdAllDiff_ideal_eq_of_forall_eq_top F ∅ U hN,
    fittingIdealProdAllDiff_ideal_eq_of_forall_eq_top F {k} U hN,
    Scheme.IdealSheafData.ideal_finsetProd_eq_prod, Scheme.IdealSheafData.ideal_finsetProd_eq_prod,
    Finset.sdiff_empty, Finset.sdiff_singleton_eq_erase]
  exact (Finset.mul_prod_erase (Finset.range (max N₀ k + 1))
    (fun i : ℕ => (fittingIdeal F (i : ℤ)).ideal U) hkN).symm

/-- A factor of a product of quasi-coherent ideal sheaves whose inverse image along a morphism is
an effective Cartier divisor has itself an effective Cartier inverse image: the inverse image of
a product is the product of the inverse images, and a summand of an effective Cartier divisor is
one by tag 07ZV. -/
theorem isEffectiveCartierDivisor_comap_of_mul_eq {Y : Scheme.{u}} (f : Y ⟶ X)
    (I J K : X.IdealSheafData) (hK : K = I * J)
    (h : Stacks.Divisors.IsEffectiveCartierDivisor (K.comap f)) :
    Stacks.Divisors.IsEffectiveCartierDivisor (I.comap f) := by
  subst hK
  rw [comap_mul] at h
  exact isEffectiveCartierDivisor_left_of_mul _ _ h

/-- On the blowup of `X` in the product of all the Fitting ideals, the `k`-th Fitting ideal of
the pulled back module is an effective Cartier divisor for **every** `k ≥ 0`. -/
@[stacks 0ESU "every Fitting ideal becomes an effective Cartier divisor on the blowup"]
theorem isEffectiveCartierDivisor_fittingIdeal_pullback_fittingIdealProdAll
    [F.IsFinitePresentation] (k : ℕ) :
    Stacks.Divisors.IsEffectiveCartierDivisor
      (fittingIdeal ((Scheme.Modules.pullback (blowUpToBase (fittingIdealProdAll F))).obj F)
        (k : ℤ)) := by
  have : F.IsFiniteType := SheafOfModules.instIsFiniteTypeOfIsFinitePresentation F
  have : F.IsQuasicoherent := SheafOfModules.instIsQuasicoherentOfIsFinitePresentation F
  rw [← fittingIdeal_comap (blowUpToBase (fittingIdealProdAll F)) F (k : ℤ)]
  refine isEffectiveCartierDivisor_comap_of_mul_eq _ _ (fittingIdealProdAllDiff F {k})
    (fittingIdealProdAll F) (fittingIdealProdAll_eq_mul F k) ?_
  exact Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal (fittingIdealProdAll F)

/-- For a finitely presented `𝒪_X`-module `ℱ` with `ℱ|_U = 0` there is a `U`-admissible blowup
`b : X' → X` on which every Fitting ideal of `b^*ℱ` is an effective Cartier divisor. -/
@[stacks 0ESU "the U-admissible blowup making every Fitting ideal effective Cartier, for ℱ|_U = 0"]
theorem exists_isAdmissibleBlowup_isEffectiveCartierDivisor_fittingIdeal_pullback
    [F.IsFinitePresentation] (U : X.Opens)
    (hzero : CategoryTheory.Limits.IsZero ((Scheme.Modules.pullback U.ι).obj F)) :
    ∃ (X' : Scheme.{u}) (b : X' ⟶ X), Stacks.Blowup.IsAdmissibleBlowup U b ∧
      ∀ k : ℕ, Stacks.Divisors.IsEffectiveCartierDivisor
        (fittingIdeal ((Scheme.Modules.pullback b).obj F) (k : ℤ)) :=
  ⟨blowUp (fittingIdealProdAll F), blowUpToBase (fittingIdealProdAll F),
    isAdmissibleBlowup_blowUpToBase_fittingIdealProdAll F U
      (isFiniteLocallyFreeOfRank_zero_of_isZero hzero),
    fun k => isEffectiveCartierDivisor_fittingIdeal_pullback_fittingIdealProdAll F k⟩

end AlgebraicGeometry

end
