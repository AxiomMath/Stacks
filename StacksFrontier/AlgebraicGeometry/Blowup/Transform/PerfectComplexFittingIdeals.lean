module

public import StacksFrontier.AlgebraicGeometry.Blowup.Transform.PerfectComplexCharts
public import StacksFrontier.AlgebraicGeometry.IdealSheafFromAffineFamily

/-!
# The Fitting ideal sheaves of a perfect complex

For a perfect object `E` of `D(𝒪_X)` and integers `i, k`, the Fitting ideal sheaf `Fit_{i,k}(E)`
of Stacks 0ESP is the quasi-coherent ideal sheaf which on an affine chart is generated by the
minors of the matrix of `d^i` of size `n_{i+1} - n_{i+2} + ⋯ - k` of the chart complex.

## Main definitions

* `AlgebraicGeometry.ComplexAndDivisorSituation.chartFittingIdeal`: the Fitting ideal sheaf.

## Main results

* `AlgebraicGeometry.ComplexAndDivisorSituation.ideal_chartFittingIdeal`: its local description
  on an affine open inside an affine chart.
* `AlgebraicGeometry.ComplexAndDivisorSituation.ideal_chartFittingIdeal_self`: its local
  description on the domain of a chart.

## Implementation notes

The ideal sheaf is glued from the affine opens contained in the domain of some chart with
`AlgebraicGeometry.Scheme.IdealSheafData.ofAffineFamily`; the compatibility needed is
`AlgebraicGeometry.ComplexAndDivisorSituation.AffineChart.map_fittingMinorIdeal_eq_map`, which
rests on the independence of the ideal of minors from the representing complex.

## References

* [Stacks Project, Tag 0ESP](https://stacks.math.columbia.edu/tag/0ESP)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits StrictlyPerfect

universe u

attribute [local instance 10000] HasDerivedCategory.standard

namespace AlgebraicGeometry.ComplexAndDivisorSituation

variable {S : ComplexAndDivisorSituation.{u, u + 1}}

/-- Restriction along `U ≤ U` is the identity. -/
theorem _root_.AlgebraicGeometry.Scheme.presheaf_map_homOfLE_refl_hom {X : Scheme.{u}}
    (U : X.Opens) : (X.presheaf.map (homOfLE (le_refl U)).op).hom = RingHom.id _ := by
  have : X.presheaf.map (homOfLE (le_refl U)).op = 𝟙 _ := by
    rw [show (homOfLE (le_refl U)) = 𝟙 U from rfl, op_id]
    exact X.presheaf.map_id _
  rw [this]
  rfl

/-- Extending an ideal along the restriction `Γ(X, U) → Γ(X, U)` does nothing. -/
private theorem map_presheaf_map_homOfLE_refl {X : Scheme.{u}} (U : X.Opens) (I : Ideal Γ(X, U)) :
    Ideal.map (X.presheaf.map (homOfLE (le_refl U)).op).hom I = I := by
  rw [Scheme.presheaf_map_homOfLE_refl_hom, Ideal.map_id]

/-- **Fitting minor ideals of charts restrict compatibly to any common affine open.** For two
affine charts and an affine open `W` inside both domains, the ideals `Fit_{i,k}` of the two
chart complexes extend to the same ideal of `Γ(X, W)`. -/
theorem AffineChart.map_fittingMinorIdeal_eq_map (C C' : AffineChart S) (W : S.X.affineOpens)
    (h : (W : S.X.Opens) ≤ (C.U : S.X.Opens)) (h' : (W : S.X.Opens) ≤ (C'.U : S.X.Opens))
    (i k : ℤ) :
    Ideal.map (S.X.presheaf.map (homOfLE h).op).hom (C.complex.fittingMinorIdeal i k) =
      Ideal.map (S.X.presheaf.map (homOfLE h').op).hom (C'.complex.fittingMinorIdeal i k) := by
  refine (AffineChart.map_fittingMinorIdeal_eq C (C.restrict W h) h i k).trans ?_
  refine Eq.trans ?_ (AffineChart.map_fittingMinorIdeal_eq C' (C'.restrict W h') h' i k).symm
  have := AffineChart.map_fittingMinorIdeal_eq (C.restrict W h) (C'.restrict W h') le_rfl i k
  exact (map_presheaf_map_homOfLE_refl _ _).symm.trans this

variable (S)

/-- The affine opens contained in the domain of some affine chart. -/
def IsChartAffine (V : S.X.affineOpens) : Prop :=
  ∃ C : AffineChart S, (V : S.X.Opens) ≤ (C.U : S.X.Opens)

/-- The ideal `Fit_{i,k}` on an affine open contained in a chart: the extension of the ideal of
minors of the chart complex. Off such affine opens it is the unit ideal; that value is never
used. -/
def chartFittingFamily (i k : ℤ) (V : S.X.affineOpens) : Ideal Γ(S.X, V) := by
  classical
  exact if h : IsChartAffine S V then
    Ideal.map (S.X.presheaf.map (homOfLE h.choose_spec).op).hom
      (h.choose.complex.fittingMinorIdeal i k)
  else ⊤

variable {S}

/-- On an affine open inside the domain of a chart, the family is the extension of the ideal of
minors of that chart, whichever chart is used. -/
theorem chartFittingFamily_eq (i k : ℤ) (C : AffineChart S) (V : S.X.affineOpens)
    (hV : (V : S.X.Opens) ≤ (C.U : S.X.Opens)) :
    chartFittingFamily S i k V =
      Ideal.map (S.X.presheaf.map (homOfLE hV).op).hom (C.complex.fittingMinorIdeal i k) := by
  have h : IsChartAffine S V := ⟨C, hV⟩
  rw [chartFittingFamily, dite_eq_left h]
  exact AffineChart.map_fittingMinorIdeal_eq_map _ _ V _ _ i k

variable (S)

/-- **The Fitting ideal sheaf `Fit_{i,k}(E)` of the perfect object of a situation**, Stacks 0ESP:
the quasi-coherent ideal sheaf whose ideal on an affine open inside an affine chart is the ideal
of minors of the matrix of `d^i` of size `n_{i+1} - n_{i+2} + ⋯ - k` of the chart complex. That
these ideals glue is the independence of the ideal of minors from the representing complex,
`BoundedComplex.fittingMinorIdeal_eq_of_derivedIso`. -/
def chartFittingIdeal (hS : ∀ x : S.X, ∃ C : AffineChart S, x ∈ (C.U : S.X.Opens)) (i k : ℤ) :
    S.X.IdealSheafData :=
  Scheme.IdealSheafData.ofAffineFamily (IsChartAffine S) (chartFittingFamily S i k)
    (fun x => by
      obtain ⟨C, hx⟩ := hS x
      exact ⟨C.U, ⟨C, le_rfl⟩, hx⟩)
    (fun U f ⟨C, hC⟩ => ⟨C, (S.X.basicOpen_le f).trans hC⟩)
    (fun U V h ⟨C, hC⟩ _ => by
      rw [chartFittingFamily_eq i k C U hC, chartFittingFamily_eq i k C V (h.trans hC),
        Ideal.map_map, ← CommRingCat.hom_comp, ← Functor.map_comp]
      rfl)

variable {S} (hS : ∀ x : S.X, ∃ C : AffineChart S, x ∈ (C.U : S.X.Opens))

/-- **The local description of `Fit_{i,k}(E)`, Stacks 0ESP.** On an affine open inside the domain
of an affine chart, the Fitting ideal sheaf is the extension of the ideal of minors of the chart
complex. -/
theorem ideal_chartFittingIdeal (i k : ℤ) (C : AffineChart S) (V : S.X.affineOpens)
    (hV : (V : S.X.Opens) ≤ (C.U : S.X.Opens)) :
    (chartFittingIdeal S hS i k).ideal V =
      Ideal.map (S.X.presheaf.map (homOfLE hV).op).hom (C.complex.fittingMinorIdeal i k) :=
  (Scheme.IdealSheafData.ideal_ofAffineFamily _ _ _ _ _ ⟨C, hV⟩).trans
    (chartFittingFamily_eq i k C V hV)

/-- **The local description of `Fit_{i,k}(E)` on the domain of a chart.** -/
theorem ideal_chartFittingIdeal_self (i k : ℤ) (C : AffineChart S) :
    (chartFittingIdeal S hS i k).ideal C.U = C.complex.fittingMinorIdeal i k := by
  rw [ideal_chartFittingIdeal hS i k C C.U le_rfl, map_presheaf_map_homOfLE_refl]

end AlgebraicGeometry.ComplexAndDivisorSituation
