-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry TopologicalSpace
open Stacks.AlgebraicGeometry.FlatBaseChange
open Stacks.AlgebraicGeometry.IdealPowerColimit
open Stacks.AlgebraicGeometry.IdealPower

universe u

namespace AlgebraicGeometry

variable {X : Scheme.{u}}

/-! ### Generation by global sections from an affine-local hypothesis -/

/-- **The germs of a family of global sections which affine-locally spans span every stalk.**
An element of the stalk at `x` is the germ of a section over some open; restricting that section
to an affine open around `x` makes the hypothesis applicable, and germs of restrictions are
germs. -/
public theorem span_germTop_eq_top_of_affineLocal (M : X.Modules) {ι : Type u}
    (s : ι → Γ(M, (⊤ : X.Opens)))
    (hs : ∀ (V : X.Opens), IsAffineOpen V → ∀ g : Γ(M, V),
      g ∈ Submodule.span Γ(X, V)
        (Set.range fun i => M.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (s i)))
    (x : X) :
    Submodule.span (R := ToType (X.presheaf.stalk x))
      (Set.range fun i => germTop M x (s i)) = ⊤ := by
  refine eq_top_iff.2 fun z _ => ?_
  obtain ⟨V, hxV, g, rfl⟩ := TopCat.Presheaf.exists_germ_eq M.val.presheaf z
  obtain ⟨-, ⟨W, hWaff, rfl⟩, hxW, hWV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxV V.isOpen
  have h2 : TopCat.Presheaf.germ M.val.presheaf W x hxW
        (M.presheaf.map (homOfLE hWV).op g)
      = TopCat.Presheaf.germ M.val.presheaf V x hxV g :=
    TopCat.Presheaf.germ_res_apply M.val.presheaf (homOfLE hWV) x hxW g
  rw [← h2]
  have key : ∀ y : Γ(M, W), y ∈ Submodule.span Γ(X, W)
        (Set.range fun i => M.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op (s i)) →
      TopCat.Presheaf.germ M.val.presheaf W x hxW y ∈
        Submodule.span (R := ToType (X.presheaf.stalk x))
          (Set.range fun i => germTop M x (s i)) := by
    have hadd : ∀ a b : Γ(M, W),
        TopCat.Presheaf.germ M.val.presheaf W x hxW (a + b)
          = TopCat.Presheaf.germ M.val.presheaf W x hxW a
            + TopCat.Presheaf.germ M.val.presheaf W x hxW b := fun a b => map_add _ a b
    have hzero : TopCat.Presheaf.germ M.val.presheaf W x hxW (0 : Γ(M, W)) = 0 := map_zero _
    have hsmul : ∀ (r : Γ(X, W)) (a : Γ(M, W)),
        TopCat.Presheaf.germ M.val.presheaf W x hxW (r • a)
          = TopCat.Presheaf.germ X.presheaf W x hxW r
            • TopCat.Presheaf.germ M.val.presheaf W x hxW a :=
      fun r a => PresheafOfModules.germ_smul (R := X.presheaf) M.val x W hxW r a
    intro y hy
    induction hy using Submodule.span_induction with
    | mem y hy =>
        obtain ⟨i, rfl⟩ := hy
        show TopCat.Presheaf.germ M.val.presheaf W x hxW
          (M.val.presheaf.map (homOfLE (le_top : W ≤ ⊤)).op (s i)) ∈ _
        rw [TopCat.Presheaf.germ_res_apply M.val.presheaf (homOfLE (le_top : W ≤ ⊤)) x hxW (s i)]
        exact Submodule.subset_span ⟨i, rfl⟩
    | zero => rw [hzero]; exact Submodule.zero_mem _
    | add a b _ _ ha hb => rw [hadd]; exact Submodule.add_mem _ ha hb
    | smul r a _ ha => rw [hsmul]; exact Submodule.smul_mem _ _ ha
  exact key _ (hs W hWaff _)

/-- **A family of global sections which affine-locally spans generates**, [Stacks, Tag 01AN].
A global section of a module on a scheme is the value at `⊤` of a restriction-compatible family
because `⊤` is terminal in the site of opens, and the epimorphism is the stalkwise criterion
applied to `span_germTop_eq_top_of_affineLocal`. -/
public def generatingSectionsOfAffineLocal (M : X.Modules) {ι : Type u}
    (s : ι → Γ(M, (⊤ : X.Opens)))
    (hs : ∀ (V : X.Opens), IsAffineOpen V → ∀ g : Γ(M, V),
      g ∈ Submodule.span Γ(X, V)
        (Set.range fun i => M.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (s i))) :
    M.GeneratingSections := by
  choose t ht using fun i => exists_sections_eval_top M (s i)
  refine { I := ι, s := t, epi := (generates_iff_span_germTop_eq_top M t).2 fun x => ?_ }
  simpa only [ht] using span_germTop_eq_top_of_affineLocal M s hs x

end AlgebraicGeometry

namespace Stacks.IdealSheaf

variable {X Y : Scheme.{u}} [IsAffine Y] (b : X ⟶ Y) (J : Y.IdealSheafData)

/-! ### The inverse image of a globally generated sheaf of ideals of an affine scheme -/

variable {ι : Type u} (v : ι → Γ(Y, (⊤ : Y.Opens)))

/-- **The inverse image of a sheaf of ideals of an affine scheme, on an affine open.** It is
generated there by the restrictions of the pullbacks of a generating family of the ideal of
global sections: this is `Stacks.IdealSheaf.ideal_comap_appLE` at the top open of the target,
which every open of the source is carried into. -/
public theorem ideal_comap_isAffineOpen_eq_span
    (hv : J.ideal ⟨⊤, isAffineOpen_top Y⟩ = Ideal.span (Set.range v))
    (V : X.Opens) (hV : IsAffineOpen V) :
    (J.comap b).ideal ⟨V, hV⟩ = Ideal.span (Set.range fun i =>
      X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (b.appTop.hom (v i))) := by
  have hle : V ≤ b ⁻¹ᵁ (⊤ : Y.Opens) := by simp
  rw [ideal_comap_appLE J b ⟨⊤, isAffineOpen_top Y⟩ ⟨V, hV⟩ hle, hv,
    Ideal.map_span, ← Set.range_comp]
  rfl

/-- The pullback of a generator is a global section of the inverse image ideal sheaf: membership
in a subsheaf of a module on a scheme is affine-local, and on an affine open the sections of the
first power of `J.comap b` are the ideal of `J.comap b` there. -/
public theorem mem_idealPowOne_comap_top
    (hv : J.ideal ⟨⊤, isAffineOpen_top Y⟩ = Ideal.span (Set.range v)) (i : ι) :
    (b.appTop.hom (v i) : Γ(structureModule X, (⊤ : X.Opens))) ∈
      (idealPowerMultiple (J.comap b) 1 (structureModule X)).toSubmodule.obj
        (op (⊤ : X.Opens)) := by
  refine mem_of_forall_affineOpens _ _ fun V hV => ?_
  have hy : X.presheaf.map (homOfLE hV).op (b.appTop.hom (v i))
      ∈ ((J.comap b).ideal V ^ 1 : Ideal Γ(X, V.1)) := by
    rw [pow_one, ideal_comap_isAffineOpen_eq_span b J v hv V.1 V.2]
    exact Ideal.subset_span ⟨i, rfl⟩
  exact (obj_idealPow_affineOpen (J.comap b) 1 V).ge hy

/-- **Over an affine open the sections of the inverse image ideal sheaf are spanned by the
restrictions of the pullbacks of the generators.** The ambient statement is
`ideal_comap_isAffineOpen_eq_span`; lifting it to the subsheaf is the induction over the span,
which produces for each element of the ideal a section of the subsheaf with that value. -/
public theorem span_restrict_idealPowOne_comap_eq_top
    (hv : J.ideal ⟨⊤, isAffineOpen_top Y⟩ = Ideal.span (Set.range v))
    (V : X.Opens) (hV : IsAffineOpen V) :
    Submodule.span Γ(X, V) (Set.range fun i =>
      (idealPow (J.comap b) 1).presheaf.map (homOfLE (le_top : V ≤ ⊤)).op
        (⟨b.appTop.hom (v i), mem_idealPowOne_comap_top b J v hv i⟩ :
          Γ(idealPow (J.comap b) 1, (⊤ : X.Opens)))) = ⊤ := by
  refine Submodule.eq_top_iff'.2 fun g => ?_
  set S := Submodule.span Γ(X, V) (Set.range fun i =>
      (idealPow (J.comap b) 1).presheaf.map (homOfLE (le_top : V ≤ ⊤)).op
        (⟨b.appTop.hom (v i), mem_idealPowOne_comap_top b J v hv i⟩ :
          Γ(idealPow (J.comap b) 1, (⊤ : X.Opens)))) with hSd
  have key : ∀ y ∈ Ideal.span (Set.range fun i =>
        X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (b.appTop.hom (v i))),
      ∃ z : Γ(idealPow (J.comap b) 1, V), z ∈ S ∧ z.1 = y := by
    intro y hy
    induction hy using Submodule.span_induction with
    | mem y hy =>
        obtain ⟨i, rfl⟩ := hy
        exact ⟨_, Submodule.subset_span ⟨i, rfl⟩, rfl⟩
    | zero => exact ⟨0, Submodule.zero_mem _, rfl⟩
    | add y₁ y₂ _ _ ha hb =>
        obtain ⟨za, hza, hzav⟩ := ha
        obtain ⟨zb, hzb, hzbv⟩ := hb
        exact ⟨za + zb, Submodule.add_mem _ hza hzb, by rw [← hzav, ← hzbv]; rfl⟩
    | smul r y₁ _ ha =>
        obtain ⟨za, hza, hzav⟩ := ha
        exact ⟨r • za, Submodule.smul_mem _ _ hza, by rw [← hzav]; rfl⟩
  have hgval : (g.1 : Γ(X, V)) ∈ Ideal.span (Set.range fun i =>
      X.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (b.appTop.hom (v i))) := by
    rw [← ideal_comap_isAffineOpen_eq_span b J v hv V hV,
      ← pow_one ((J.comap b).ideal ⟨V, hV⟩)]
    exact (obj_idealPow_affineOpen (J.comap b) 1 ⟨V, hV⟩).le g.2
  obtain ⟨z, hz, hzv⟩ := key _ hgval
  exact (show z = g from Subtype.ext hzv) ▸ hz

/-- **The inverse image of a sheaf of ideals of an affine scheme is generated by the pullbacks
of generators of its ideal of global sections.** -/
public def comapGeneratingSections
    (hv : J.ideal ⟨⊤, isAffineOpen_top Y⟩ = Ideal.span (Set.range v)) :
    (idealPow (J.comap b) 1).GeneratingSections :=
  generatingSectionsOfAffineLocal (idealPow (J.comap b) 1)
    (fun i => ⟨b.appTop.hom (v i), mem_idealPowOne_comap_top b J v hv i⟩)
    fun V hV _ => (span_restrict_idealPowOne_comap_eq_top b J v hv V hV).ge Submodule.mem_top

end Stacks.IdealSheaf

namespace Stacks.AlmostBlowUp

/-- **The ideal sheaf of the exceptional divisor of the two-generator square is generated by two
global sections, namely `f₁` and `f₂`.**

The centre is cut out of `Spec A` by `(f₁,f₂)`, so its ideal sheaf is generated by the two
global sections of `𝒪_{Spec A}` corresponding to `f₁` and `f₂` under the counit
`Γ(Spec A, ⊤) ≅ A`; the inverse image along the modification is then generated by their
pullbacks, by `Stacks.IdealSheaf.comapGeneratingSections`. This is the global generation of the
ideal sheaf of the exceptional divisor used in step (b) of [Stacks, Tag 0EXD]. -/
public noncomputable def generatingSections_comap_centerIdealSheaf
    (A : Type u) [CommRing A] (f₁ f₂ : A) :
    (idealPow ((Stacks.AlmostBlowUp.centerIdealSheaf A f₁ f₂).comap
      (Stacks.AlmostBlowUp.modificationToBase A f₁ f₂)) 1).GeneratingSections := by
  refine Stacks.IdealSheaf.comapGeneratingSections _ _
    (fun i : ULift.{u} (Fin 2) =>
      ![(Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom f₁,
        (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom f₂] i.down) ?_
  have h1 : (Stacks.AlmostBlowUp.centerIdealSheaf A f₁ f₂).ideal
        ⟨⊤, isAffineOpen_top (Spec (CommRingCat.of A))⟩ =
      Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
        (Stacks.AlmostBlowUp.centerIdeal A f₁ f₂) := by
    rw [Stacks.AlmostBlowUp.centerIdealSheaf, Scheme.IdealSheafData.ofIdealTop_ideal,
      show (homOfLE (le_top (a := (⊤ : (Spec (CommRingCat.of A)).Opens)))) = 𝟙 _ from rfl]
    simp
  have hrange : Set.range (fun i : ULift.{u} (Fin 2) =>
        ![(Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom f₁,
          (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom f₂] i.down)
      = {(Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom f₁,
          (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom f₂} := by
    ext y
    simp only [Set.mem_range, ULift.exists, Fin.exists_fin_two, Matrix.cons_val_zero,
      Matrix.cons_val_one, Set.mem_insert_iff, Set.mem_singleton_iff]
    tauto
  rw [h1, Stacks.AlmostBlowUp.centerIdeal, Ideal.map_span, Set.image_pair, hrange]

end Stacks.AlmostBlowUp

end
