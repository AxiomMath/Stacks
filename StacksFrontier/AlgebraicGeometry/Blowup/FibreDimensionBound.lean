module

public import StacksFrontier.AlgebraicGeometry.Blowup.AffineChart
public import StacksFrontier.AlgebraicGeometry.Blowup.Basic
public import StacksFrontier.AlgebraicGeometry.FibreDimension.AffineFibre
public import StacksFrontier.AlgebraicGeometry.InvertiblePullbackFlat.GenericFibreChartGenerator
public import StacksFrontier.Topology.Dimension.LocalKrullDim
public import Mathlib.RingTheory.KrullDimension.Polynomial

/-!
# The fibres of the blowup of a Noetherian affine scheme have bounded dimension

Let `R` be a ring and `I = (g₁, …, g_t)` an ideal. Every fibre of the blowup
`p : Proj(R[It]) ⟶ Spec(R)` has dimension at most `t`: each point of a fibre lies in a chart
`Spec R[I/a]`, `a ∈ I` (`Stacks.Blowup.iSup_opensRange_specAffineBlowupι`), whose fibre is an
open neighbourhood of it in the fibre of `p` (`AlgebraicGeometry.range_fiberCompι`); the chart lies
over `Spec(R)` by the structure map (`specAffineBlowupι_comp_toSpec`), and `R[I/a]` is generated by
the `t` fractions `gₖ/a`, so its fibres are quotients of polynomial rings in `t` variables over
fields. This is the bound `d ≤ t` of [Stacks, Tag 0GA6] (there `t - 1`, by the projective
embedding), an explicit bound for the integer `d(S)`, the maximal fibre dimension of `p`
(`Stacks.LocalCohomology.UniformityIII.fibreDim`, whose existence is [Stacks, Tag 0A3V]).

## References

* [Stacks Project, Tag 0GA6](https://stacks.math.columbia.edu/tag/0GA6)
* [Stacks Project, Tag 0804](https://stacks.math.columbia.edu/tag/0804)
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry

universe u

namespace Stacks.Blowup

variable {R : Type u} [CommRing R] (I : Ideal R)

/-- **The chart `Spec R[I/a]` lies over `Spec R` by the structure map.** -/
theorem specAffineBlowupι_comp_toSpec {a : R} (ha : a ∈ I) :
    specAffineBlowupι I a ha ≫ toSpec I =
      Spec.map (CommRingCat.ofHom (algebraMap R (affineBlowup I a))) := by
  have h1 := Proj.awayι_toSpecZero (reesGrading I) (reesDegOne I ha)
    (reesDegOne_mem_reesGrading I ha) Nat.one_pos
  show (Spec.map (reesAwayEquivAffineBlowup I a ha).toCommRingCatIso.hom ≫
      Proj.awayι (reesGrading I) (reesDegOne I ha) (reesDegOne_mem_reesGrading I ha)
        Nat.one_pos) ≫ (Proj.toSpecZero (reesGrading I) ≫
      Spec.map (CommRingCat.ofHom (reesGradingZeroEquiv I).toRingHom)) = _
  rw [Category.assoc, ← Category.assoc (Proj.awayι _ _ _ _), h1, ← Spec.map_comp,
    ← Spec.map_comp]
  congr 1
  ext r
  have h2 := reesAwayEquivAffineBlowup_fromZeroRingHom I a ha ((reesGradingZeroEquiv I) r)
  rw [RingEquiv.symm_apply_apply] at h2
  exact congrArg Subtype.val h2

/-- **`R[I/a]` is generated by the fractions `gₖ/a` of a generating family of `I`.** -/
theorem adjoin_range_mk_eq_affineBlowup {t : ℕ} (g : Fin t → R)
    (hg : I = Ideal.span (Set.range g)) (a : R) :
    Algebra.adjoin R (Set.range fun k => Localization.mk (g k) ⟨a, Submonoid.mem_powers a⟩ :
      Set (Localization.Away a)) = affineBlowup I a := by
  refine le_antisymm (Algebra.adjoin_mono ?_) (Algebra.adjoin_le ?_)
  · rintro _ ⟨k, rfl⟩
    exact ⟨g k, by rw [hg]; exact Ideal.subset_span ⟨k, rfl⟩, rfl⟩
  · rintro _ ⟨x, hx, rfl⟩
    rw [SetLike.mem_coe, hg] at hx
    induction hx using Submodule.span_induction with
    | mem y hy =>
      obtain ⟨k, rfl⟩ := hy
      exact Algebra.subset_adjoin ⟨k, rfl⟩
    | zero =>
      simp only [Localization.mk_zero]
      exact Subalgebra.zero_mem _
    | add y z _ _ hy hz =>
      simp only [← Localization.add_mk_self] at hy hz ⊢
      exact Subalgebra.add_mem _ hy hz
    | smul r y _ hy =>
      simp only [smul_eq_mul] at hy ⊢
      rw [← smul_eq_mul, ← Localization.smul_mk, Algebra.smul_def]
      exact Subalgebra.mul_mem _ (Subalgebra.algebraMap_mem _ r) hy

end Stacks.Blowup

namespace Stacks.FibreDimensionBound

/-- **The fibres of a ring map generated by `t` elements have dimension at most `t`.** -/
theorem ringKrullDim_fiber_le {R B : Type u} [CommRing R] [CommRing B] [Algebra R B] {t : ℕ}
    (x : Fin t → B) (hx : Algebra.adjoin R (Set.range x) = ⊤) (p : Ideal R) [p.IsPrime] :
    ringKrullDim (p.Fiber B) ≤ t := by
  have hsurj : Function.Surjective (MvPolynomial.aeval (R := R) x) := by
    rw [← AlgHom.range_eq_top, ← Algebra.adjoin_range_eq_range_aeval, hx]
  let κ := p.ResidueField
  let φ : MvPolynomial (Fin t) κ →ₐ[κ] p.Fiber B :=
    (Algebra.TensorProduct.map (AlgHom.id κ κ) (MvPolynomial.aeval (R := R) x)).comp
      (MvPolynomial.algebraTensorAlgEquiv R κ).symm.toAlgHom
  have hφ : Function.Surjective φ :=
    (Algebra.TensorProduct.map_surjective _ _ Function.surjective_id hsurj).comp
      (MvPolynomial.algebraTensorAlgEquiv R κ).symm.surjective
  calc ringKrullDim (p.Fiber B) ≤ ringKrullDim (MvPolynomial (Fin t) κ) :=
        ringKrullDim_le_of_surjective φ.toRingHom hφ
    _ = t := by
        rw [MvPolynomial.ringKrullDim_of_isNoetherianRing, ringKrullDim_eq_zero_of_field,
          ENat.card_eq_coe_fintype_card, Fintype.card_fin, zero_add]
        rfl

end Stacks.FibreDimensionBound

namespace Stacks.Blowup

variable {R : Type u} [CommRing R] (I : Ideal R)

/-- **The fibres of the blowup of `Spec R` in an ideal generated by `t` elements have dimension
at most `t`.** Each point of a fibre lies in a chart `Spec R[I/a]`, whose fibre is an open
neighbourhood of it in the fibre of the blowup, and `R[I/a]` is generated by `t` elements over
`R` (`adjoin_range_mk_eq_affineBlowup`), so its fibres have dimension at most `t`. -/
theorem topologicalKrullDim_fiber_toSpec_le {t : ℕ} (g : Fin t → R)
    (hg : I = Ideal.span (Set.range g)) (s : Spec (CommRingCat.of R)) :
    topologicalKrullDim ((toSpec I).fiber s) ≤ (t : WithBot ℕ∞) := by
  rw [TopologicalSpace.topologicalKrullDim_eq_iSup_localKrullDim]
  refine iSup_le fun x => ?_
  rw [← TopologicalSpace.topologicalKrullDimAt_eq_localKrullDim]
  have hy : (toSpec I).fiberι s x ∈ (⨆ r : I, (specAffineBlowupι I (r : R) r.2).opensRange) := by
    rw [iSup_opensRange_specAffineBlowupι I]
    trivial
  obtain ⟨r, hr⟩ := TopologicalSpace.Opens.mem_iSup.mp hy
  let j : Spec (CommRingCat.of (affineBlowup I (r : R))) ⟶ blowUpSpec I :=
    specAffineBlowupι I (r : R) r.2
  have : IsOpenImmersion j := inferInstanceAs (IsOpenImmersion (specAffineBlowupι I (r : R) r.2))
  have hx : x ∈ Set.range (fiberCompι j (toSpec I) s).base := by
    rwa [range_fiberCompι]
  obtain ⟨x', rfl⟩ := hx
  have := isOpenImmersion_fiberCompι j (toSpec I) s
  refine ((fiberCompι j (toSpec I) s).isOpenEmbedding.topologicalKrullDimAt_eq x').le.trans ?_
  refine (topologicalKrullDimAt_le_topologicalKrullDim _).trans ?_
  have hj : j ≫ toSpec I =
      Spec.map (CommRingCat.ofHom (algebraMap R (affineBlowup I (r : R)))) :=
    specAffineBlowupι_comp_toSpec I r.2
  rw [hj, AlgebraicGeometry.topologicalKrullDim_fiber_specMap_eq R (affineBlowup I (r : R)) s]
  -- `R[I/a]` is generated by `t` elements
  let xs : Fin t → affineBlowup I (r : R) := fun k =>
    ⟨Localization.mk (g k) ⟨(r : R), Submonoid.mem_powers _⟩, by
      rw [← adjoin_range_mk_eq_affineBlowup I g hg]
      exact Algebra.subset_adjoin ⟨k, rfl⟩⟩
  have hgen : Algebra.adjoin R (Set.range xs) = ⊤ := by
    apply Subalgebra.map_injective (f := (affineBlowup I (r : R)).val) Subtype.val_injective
    rw [AlgHom.map_adjoin, Algebra.map_top, Subalgebra.range_val, ← Set.range_comp]
    exact adjoin_range_mk_eq_affineBlowup I g hg _
  have : (s : PrimeSpectrum R).asIdeal.IsPrime := (s : PrimeSpectrum R).isPrime
  exact Stacks.FibreDimensionBound.ringKrullDim_fiber_le xs hgen (s : PrimeSpectrum R).asIdeal

end Stacks.Blowup

end
