module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Divisors.IdealSheafGlobalSectionGenerators
public import StacksFrontier.AlgebraicGeometry.Perfect.SupportClosedSubset.EquationsBaseChange
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.RationalSingularities.ExceptionalIdealPowers
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.Vanishing.RegularLocalBlowup
public import StacksFrontier.AlgebraicGeometry.Blowup.AffineBlowUpIso
public import StacksFrontier.AlgebraicGeometry.ResolutionOfSurfaces.Vanishing.RegularLocalBlowupTwistVanishing

/-!
# `H¹(X, I·𝒪_X) = 0` on the blowup of a regular local surface

Let `(A, 𝔪)` be a regular local ring of dimension two, let `X = Proj(⨁ₙ 𝔪ⁿ)` be the blowup of
`Spec(A)` in `𝔪`, and let `I ⊆ A` be an ideal. Then the inverse-image ideal sheaf `I·𝒪_X` has
vanishing first cohomology.

This is the cohomological input to the strict first inequality of [Stacks, Tag 0AGT], which the
source obtains by applying [Stacks, Tag 0AGS] part (3) to `I·𝒪_X`: the latter is generated by
global sections, namely by the images of the elements of `I`.

## Main results

* `Stacks.Divisors.nonempty_generatingSections_comap_ofIdealTop`: **the inverse image of an
  ideal sheaf generated by global functions is generated by global sections.** For an arbitrary
  morphism of schemes and with no affineness hypothesis anywhere.
* `AlgebraicGeometry.isZero_cohomology_one_comap_ofIdealTop_blowUpSpec`: **`H¹(X, I·𝒪_X) = 0`**
  on the blowup of a two-dimensional regular local ring in its maximal ideal.

## Implementation notes

Both statements are unconditional. The first is the composite of two facts already in the
library: the inverse image of `ofIdealTop I` is `ofIdealTop` of the image ideal, for an
arbitrary morphism (`Stacks.IdealSheaf.comap_ofIdealTop`), and the ideal sheaf generated by an
ideal of global functions is generated by global sections
(`Stacks.Divisors.nonempty_generatingSections_ofIdealTop`). An earlier note in
`StacksFrontier/AlgebraicGeometry/Blowup/Colength/PositiveOrder.lean` recorded this as the one
remaining gap of Tag 0AGT's strict inequality, on the grounds that only the one-generator
affine case was available; that was wrong, and the two general statements above had been in the
library all along.

The second is `AlgebraicGeometry.isZero_cohomology_one_of_generatingSections` — Tag 0AGS part
(3) — applied to the ideal sheaf as a sheaf of modules, which is quasi-coherent by
`AlgebraicGeometry.isQuasicoherent_idealSheafOfModules`.

**Which model the vanishing is stated on.** Tag 0AGS part (3) is stated on
`Stacks.Blowup.blowUpSpec 𝔪 = Proj(⨁ₙ 𝔪ⁿ)`, so the vanishing is too, and the inverse image is
taken along `Stacks.Blowup.toSpec`. The rest of the Tag 0AGT development is written on
`AlgebraicGeometry.blowUp`, the relative-`Proj` model; the two models are identified by
`Stacks.Blowup.affineBlowUpIso`
(`StacksFrontier/AlgebraicGeometry/Blowup/AffineBlowUpComparison.lean`), compatibly with their
maps to `Spec(A)` by `Stacks.Blowup.affineBlowUpIso_hom_comp`, and cohomology transports along
an isomorphism of schemes by `Stacks.Cohomology.ModuleComparison.hgroupPullbackIso`. Moving the
statement across that identification is **not** done here: it needs the pullback of an ideal
sheaf of modules along the isomorphism to be identified with the ideal sheaf of the inverse
image, and `Stacks.Divisors.pullbackIdealSheafComapIso` supplies that only for an effective
Cartier divisor whose pullback is defined, which `I·𝒪_X` is not in general. See the module
documentation of `StacksFrontier/AlgebraicGeometry/Blowup/Colength/PositiveOrder.lean` for the
other inputs the strict inequality still waits on.

## References

* [Stacks Project, Tag 0AGT](https://stacks.math.columbia.edu/tag/0AGT)
* [Stacks Project, Tag 0AGS](https://stacks.math.columbia.edu/tag/0AGS)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

namespace Stacks.Divisors

/-- **The inverse image of an ideal sheaf generated by global functions is generated by global
sections.** For `g : X ⟶ Y` an arbitrary morphism of schemes and `I` an ideal of `Γ(Y, 𝒪_Y)`,
the sheaf of modules underlying `(I·𝒪_Y)·𝒪_X` admits a family of generating global sections.
There is no affineness hypothesis on either scheme. -/
public theorem nonempty_generatingSections_comap_ofIdealTop {X Y : Scheme.{u}} (g : X ⟶ Y)
    (I : Ideal Γ(Y, ⊤)) :
    Nonempty (idealSheafOfModules
      ((Scheme.IdealSheafData.ofIdealTop I).comap g)).GeneratingSections := by
  rw [Stacks.IdealSheaf.comap_ofIdealTop]
  exact nonempty_generatingSections_ofIdealTop _

end Stacks.Divisors

namespace AlgebraicGeometry

/-- **`H¹(X, I·𝒪_X) = 0` on the blowup of a regular local surface.** For `(A, 𝔪)` a regular
local ring of dimension two, `X = Proj(⨁ₙ 𝔪ⁿ)` the blowup of `Spec(A)` in `𝔪` and `I` an ideal
of `Γ(Spec A, 𝒪)`, the inverse-image ideal sheaf `I·𝒪_X` has vanishing first cohomology.

This is the cohomological input to the strict first inequality of [Stacks, Tag 0AGT]. The proof
is the source's: `I·𝒪_X` is generated by global sections
(`Stacks.Divisors.nonempty_generatingSections_comap_ofIdealTop`) and is quasi-coherent, so
[Stacks, Tag 0AGS] part (3) applies.

The statement is on `Stacks.Blowup.blowUpSpec`, the model Tag 0AGS part (3) is stated on; see
the module documentation for why it is not moved to `AlgebraicGeometry.blowUp`. -/
public theorem isZero_cohomology_one_comap_ofIdealTop_blowUpSpec
    (A : Type u) [CommRing A] [IsRegularLocalRing A] (hdim : ringKrullDim A = 2)
    (I : Ideal Γ(Spec (CommRingCat.of A), ⊤)) :
    IsZero (_root_.Hgroup
      (Stacks.Blowup.blowUpSpec (IsLocalRing.maximalIdeal A)).ringCatSheaf ⊤ 1
      (Stacks.Divisors.idealSheafOfModules
        ((Scheme.IdealSheafData.ofIdealTop I).comap
          (Stacks.Blowup.toSpec (IsLocalRing.maximalIdeal A))))) :=
  isZero_cohomology_one_of_generatingSections A hdim _
    (isQuasicoherent_idealSheafOfModules _)
    (Stacks.Divisors.nonempty_generatingSections_comap_ofIdealTop _ I).some

end AlgebraicGeometry

end
