module

public import StacksFrontier.AlgebraicGeometry.Blowup.Colength.ExceptionalCurve
public import StacksFrontier.AlgebraicGeometry.Blowup.Colength.LocalBound
public import StacksFrontier.AlgebraicGeometry.Blowup.Colength.PositiveOrder
public import StacksFrontier.AlgebraicGeometry.Blowup.Colength.RegularStrictBound
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierAffineLocal
public import StacksFrontier.AlgebraicGeometry.Picard.HilbertPointAddition

/-!
# The residual ideal of an ideal of finite colength on the blowup of a regular local surface

Let `(A, 𝔪)` be a regular local ring of dimension two, let `f : X ⟶ Spec A` be the blowing up
of `A` in `𝔪`, with exceptional divisor `E`, let `𝔪ⁿ ⊆ I ⊆ 𝔪` be an ideal and let `d` be the
largest integer with `I𝒪_X ⊆ 𝒪_X(-dE)`. The residual ideal `ℐ' = I𝒪_X(dE)` is the sheaf of
ideals with `𝒪_X(-dE) · ℐ' = I𝒪_X`. This file proves the assertions of [Stacks, Tag 0AGT]
about it.

## Main results

* `AlgebraicGeometry.support_comap_ofIdealTop_subset_exceptionalIdeal`: for `𝔪ⁿ ⊆ I`, the
  support of `I𝒪_X` lies in the exceptional divisor.
* `Stacks.Divisors.not_pow_le_pow_succ_of_isEffectiveCartierDivisor`: the powers of a nonempty
  effective Cartier divisor strictly decrease.
* `AlgebraicGeometry.exists_maximal_order_comap_ofIdealTop`: the largest `d` exists, and
  `d ≤ n`.
* `AlgebraicGeometry.exists_residualIdeal_of_maximal_order`: all assertions of
  [Stacks, Tag 0AGT].

## References

* [Stacks Project, Tag 0AGT](https://stacks.math.columbia.edu/tag/0AGT)
* [Stacks Project, Tag 0AGQ](https://stacks.math.columbia.edu/tag/0AGQ)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace Stacks.Divisors

/-- **The powers of a nonempty effective Cartier divisor strictly decrease.** If `D` is an
effective Cartier divisor whose support contains a point `x`, then `D ^ n` is not contained in
`D ^ (n + 1)`. -/
public theorem not_pow_le_pow_succ_of_isEffectiveCartierDivisor {X : Scheme.{u}}
    (D : X.IdealSheafData) (hD : IsEffectiveCartierDivisor D) {x : X}
    (hx : x ∈ (D.support : Set X)) (n : ℕ) :
    ¬ D ^ n ≤ D ^ (n + 1) := by
  intro hle
  obtain ⟨U, hU, hxU, g, hg, hDg⟩ :=
    exists_affineOpen_ideal_eq_span_of_isEffectiveCartierDivisor D hD x
  have hpow : ∀ k : ℕ, (D ^ k).ideal ⟨U, hU⟩ = Ideal.span {g ^ k} := fun k => by
    rw [Scheme.IdealSheafData.ideal_pow, Pi.pow_apply, hDg, Ideal.span_singleton_pow]
  have hmem : g ^ n ∈ Ideal.span {g ^ (n + 1)} := by
    rw [← hpow (n + 1)]
    exact hle ⟨U, hU⟩ (by rw [hpow n]; exact Ideal.mem_span_singleton_self _)
  obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.1 hmem
  have hgc : g * c = 1 := by
    refine (hg.pow n).1 ?_
    show g ^ n * (g * c) = g ^ n * 1
    rw [mul_one]
    nth_rewrite 2 [← hc]
    ring
  have hunit : IsUnit g := isUnit_iff_exists_inv.2 ⟨c, hgc⟩
  have htop : D.ideal ⟨U, hU⟩ = ⊤ := by rw [hDg, Ideal.span_singleton_eq_top.2 hunit]
  have hx' : x ∈ D.support := hx
  rw [Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨U, hU⟩) hxU, htop,
    Submodule.top_coe, Scheme.zeroLocus_univ] at hx'
  exact hx' hxU

end Stacks.Divisors

namespace AlgebraicGeometry

variable (A : Type u) [CommRing A] [IsRegularLocalRing A]

/-- **For `𝔪ⁿ ⊆ I`, the support of `I𝒪_X` lies in the exceptional divisor.** Here `I𝒪_X` is the
inverse image along the blowup of the ideal sheaf generated by `I` on `Spec A`. -/
public theorem support_comap_ofIdealTop_subset_exceptionalIdeal
    (ℐ : (Spec (CommRingCat.of A)).IdealSheafData)
    (hℐ : ℐ = (Stacks.Blowup.residuePoint A).ker) (I : Ideal A) (n : ℕ)
    (hnI : IsLocalRing.maximalIdeal A ^ n ≤ I) :
    (((Scheme.IdealSheafData.ofIdealTop
        (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ)).support :
        Set (blowUp ℐ)) ⊆ ((exceptionalIdeal ℐ).support : Set (blowUp ℐ)) := by
  intro x hx
  show x ∈ ((ℐ.comap (blowUpToBase ℐ)).support : Set (blowUp ℐ))
  rw [Scheme.IdealSheafData.support_comap, TopologicalSpace.Closeds.coe_preimage] at hx ⊢
  set y := (blowUpToBase ℐ).base x
  show y ∈ (ℐ.support : Set (Spec (.of A)))
  rw [hℐ]
  show y ∈ (Stacks.Blowup.residuePoint A).ker.supportSet
  rw [supportSet_ker_residuePoint]
  let g : A ≃+* ↥Γ(Spec (.of A), ⊤) :=
    (Scheme.ΓSpecIso (.of A)).symm.commRingCatIsoToRingEquiv
  have hpre : g ⁻¹' (Ideal.map g I : Set ↥Γ(Spec (.of A), ⊤)) = (I : Set A) := by
    ext a
    show g a ∈ Ideal.map g I ↔ a ∈ I
    rw [Ideal.mem_map_iff_of_surjective g g.surjective]
    exact ⟨fun ⟨b, hb, hba⟩ => g.injective hba ▸ hb, fun ha => ⟨a, ha, rfl⟩⟩
  change y ∈ ((Scheme.IdealSheafData.ofIdealTop
    (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).support : Set (Spec (.of A))) at hx
  rw [Scheme.IdealSheafData.coe_support_ofIdealTop, Spec_zeroLocus] at hx
  change (y : PrimeSpectrum A) ∈ PrimeSpectrum.zeroLocus
      (g ⁻¹' (Ideal.map g I : Set ↥Γ(Spec (.of A), ⊤))) at hx
  rw [hpre] at hx
  have hx' : I ≤ (y : PrimeSpectrum A).asIdeal := (PrimeSpectrum.mem_zeroLocus _ _).1 hx
  have hm : IsLocalRing.maximalIdeal A ≤ (y : PrimeSpectrum A).asIdeal :=
    (y : PrimeSpectrum A).isPrime.le_of_pow_le (hnI.trans hx')
  show (y : PrimeSpectrum A) = IsLocalRing.closedPoint A
  exact PrimeSpectrum.ext
    ((IsLocalRing.maximalIdeal.isMaximal A).eq_of_le (y : PrimeSpectrum A).isPrime.ne_top hm).symm


/-- **The largest order of `I𝒪_X` along the exceptional divisor exists.** For `𝔪ⁿ ⊆ I` there is
a largest `d` with `I𝒪_X ⊆ 𝒪_X(-dE)`, and `d ≤ n`. -/
public theorem exists_maximal_order_comap_ofIdealTop
    (hdim : ringKrullDim A = 2) (ℐ : (Spec (CommRingCat.of A)).IdealSheafData)
    (hℐ : ℐ = (Stacks.Blowup.residuePoint A).ker) (I : Ideal A) (n : ℕ)
    (hnI : IsLocalRing.maximalIdeal A ^ n ≤ I) :
    ∃ d : ℕ, d ≤ n ∧
      (Scheme.IdealSheafData.ofIdealTop
          (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ) ≤
        exceptionalIdeal ℐ ^ d ∧
      ∀ e : ℕ, (Scheme.IdealSheafData.ofIdealTop
          (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ) ≤
        exceptionalIdeal ℐ ^ e → e ≤ d := by
  classical
  set J := (Scheme.IdealSheafData.ofIdealTop
    (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ) with hJ
  have hpowle : ℐ ^ n ≤ Scheme.IdealSheafData.ofIdealTop
      (I.map (Scheme.ΓSpecIso (.of A)).inv.hom) := by
    rw [hℐ, ker_residuePoint_eq_ofIdealTop_map]
    refine Scheme.IdealSheafData.le_def.2 fun U => ?_
    rw [Scheme.IdealSheafData.ideal_pow, Pi.pow_apply, Scheme.IdealSheafData.ofIdealTop_ideal,
      Scheme.IdealSheafData.ofIdealTop_ideal, ← Ideal.map_pow, ← Ideal.map_pow]
    exact Ideal.map_mono (Ideal.map_mono hnI)
  have hEn : exceptionalIdeal ℐ ^ n ≤ J := by
    show (ℐ.comap (blowUpToBase ℐ)) ^ n ≤ J
    rw [← Stacks.IdealSheaf.comap_pow]
    exact Scheme.IdealSheafData.comap_mono _ hpowle
  obtain ⟨x, hx⟩ := (isIrreducible_support_exceptionalIdeal A ℐ hdim hℐ).nonempty
  have hbound : ∀ e : ℕ, J ≤ exceptionalIdeal ℐ ^ e → e ≤ n := by
    intro e he
    by_contra hnot
    have hlt : n + 1 ≤ e := Nat.lt_of_not_le hnot
    exact Stacks.Divisors.not_pow_le_pow_succ_of_isEffectiveCartierDivisor _
      (Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal ℐ) hx n
      ((hEn.trans he).trans (Scheme.IdealSheafData.pow_le_pow_right_of_le _ hlt))
  refine ⟨Nat.findGreatest (fun e => J ≤ exceptionalIdeal ℐ ^ e) n, Nat.findGreatest_le n, ?_,
    fun e he => Nat.le_findGreatest (hbound e he) he⟩
  exact Nat.findGreatest_spec (P := fun e => J ≤ exceptionalIdeal ℐ ^ e) (Nat.zero_le n)
    (by simp [Scheme.IdealSheafData.one_eq_top])

/-- **The assertions of [Stacks, Tag 0AGT], given the strict inequality.** For the largest `d`
with `I𝒪_X ⊆ 𝒪_X(-dE)`: `d > 0`, the residual ideal `ℐ'` with `𝒪_X(-dE) · ℐ' = I𝒪_X` exists and
is unique, it is supported at finitely many closed points, and the two length inequalities hold,
the strict one `length_A Γ(X, 𝒪_X/ℐ') < length_A (A/I)` being the hypothesis `hstrict`. -/
public theorem exists_residualIdeal_of_maximal_order_of_strict
    (hdim : ringKrullDim A = 2) (ℐ : (Spec (CommRingCat.of A)).IdealSheafData)
    (hℐ : ℐ = (Stacks.Blowup.residuePoint A).ker) (I : Ideal A) (n : ℕ)
    (hnI : IsLocalRing.maximalIdeal A ^ n ≤ I) (hIm : I ≤ IsLocalRing.maximalIdeal A) (d : ℕ)
    (hd : (Scheme.IdealSheafData.ofIdealTop
          (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ) ≤
      exceptionalIdeal ℐ ^ d)
    (hmax : ∀ e : ℕ, (Scheme.IdealSheafData.ofIdealTop
          (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ) ≤
      exceptionalIdeal ℐ ^ e → e ≤ d)
    (hstrict : ∀ I' : (blowUp ℐ).IdealSheafData, exceptionalIdeal ℐ ^ d * I' =
        (Scheme.IdealSheafData.ofIdealTop
          (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ) →
      letI : Algebra A Γ(I'.subscheme, ⊤) :=
        ((Scheme.ΓSpecIso (.of A)).inv ≫ (I'.subschemeι ≫ blowUpToBase ℐ).appTop).hom.toAlgebra
      Module.length A Γ(I'.subscheme, ⊤) < Module.length A (A ⧸ I)) :
    0 < d ∧
      ∃ (I' : (blowUp ℐ).IdealSheafData) (T : Finset (blowUp ℐ)),
        exceptionalIdeal ℐ ^ d * I' = (Scheme.IdealSheafData.ofIdealTop
          (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ) ∧
        (∀ K : (blowUp ℐ).IdealSheafData, exceptionalIdeal ℐ ^ d * K =
          (Scheme.IdealSheafData.ofIdealTop
          (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ) → K = I') ∧
        (I'.support : Set (blowUp ℐ)) = (T : Set (blowUp ℐ)) ∧
        (∀ x ∈ T, IsClosed ({x} : Set (blowUp ℐ))) ∧
        letI : Algebra A Γ(I'.subscheme, ⊤) :=
          ((Scheme.ΓSpecIso (.of A)).inv ≫ (I'.subschemeι ≫ blowUpToBase ℐ).appTop).hom.toAlgebra
        Module.length A Γ(I'.subscheme, ⊤) < Module.length A (A ⧸ I) ∧
        (∑ x ∈ T, Module.length ((blowUp ℐ).presheaf.stalk x)
            ((blowUp ℐ).presheaf.stalk x ⧸ IdealSheafData.stalk I' x)) ≤
          Module.length A Γ(I'.subscheme, ⊤) := by
  have hIℐ : Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom I) ≤ ℐ := by
    rw [hℐ, ker_residuePoint_eq_ofIdealTop_map]
    exact Scheme.IdealSheafData.le_def.2 fun U => Ideal.map_mono (Ideal.map_mono hIm)
  have hpos : 0 < d := Stacks.Blowup.Colength.pos_order_of_le_center ℐ _ d hIℐ ⟨hd, hmax⟩
  obtain ⟨I', T, hmul, hT, hclosed⟩ :=
    exists_finite_isClosed_support_of_maximal_order_blowUp A ℐ hdim hℐ _
      (support_comap_ofIdealTop_subset_exceptionalIdeal A ℐ hℐ I n hnI) d hd hmax
  have huniq : ∀ K : (blowUp ℐ).IdealSheafData, exceptionalIdeal ℐ ^ d * K =
      (Scheme.IdealSheafData.ofIdealTop
          (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ) → K = I' := fun K hK =>
    Stacks.Divisors.eq_of_mul_eq_mul_of_isEffectiveCartierDivisor
      (Stacks.Divisors.isEffectiveCartierDivisor_pow
        (Stacks.Blowup.isEffectiveCartierDivisor_exceptionalIdeal ℐ) d) (hK.trans hmul.symm)
  exact ⟨hpos, I', T, hmul, huniq, hT, hclosed, hstrict I' hmul,
    Stacks.Blowup.Colength.length_globalSections_ge_sum_length_stalkQuotient (blowUpToBase ℐ) I'
      T hT hclosed⟩

/-- Let `(A, 𝔪)` be a regular local ring of dimension two, let `f : X ⟶ Spec A` be the blowing
up of `A` in `𝔪` (the blowup of the ideal sheaf `ℐ` generated by `𝔪`), with exceptional divisor
`E` (the ideal sheaf `𝔪𝒪_X = 𝒪_X(-E)`), and let `𝔪ⁿ ⊆ I ⊆ 𝔪` be an ideal. Then there is a
largest `d ≥ 0` with `I𝒪_X ⊆ 𝒪_X(-dE)`, and for it:

* `d > 0`;
* the ideal sheaf `ℐ' = I𝒪_X(dE)`, i.e. the unique `ℐ'` with `𝒪_X(-dE) · ℐ' = I𝒪_X`, exists;
* `𝒪_X/ℐ'` is supported in a finite set `T` of closed points of `X`;
* `length_A(A/I) > length_A Γ(X, 𝒪_X/ℐ') ≥ ∑_{x ∈ T} length_{𝒪_{X,x}}(𝒪_{X,x}/ℐ'_x)`.

Here `I𝒪_X` is the inverse image of the ideal sheaf generated by `I` on `Spec A`, `Γ(X, 𝒪_X/ℐ')`
is the ring of global functions of the closed subscheme `V(ℐ')`, with the `A`-module structure
induced by `f`, and `ℐ'_x` is the stalk of `ℐ'` at `x`. -/
@[stacks 0AGT "for the blowup X of a two-dimensional regular local ring (A, m) in m, with \
exceptional divisor E, and an ideal I with m^n contained in I contained in m: the largest d with \
I O_X contained in O_X(-dE) exists and is positive, the ideal I' with O_X(-dE) I' = I O_X exists \
and is unique, O_X/I' is supported in a finite set of closed points x_i, and \
length_A(A/I) > length_A Gamma(X, O_X/I') >= sum_i length_{O_{X,x_i}}(O_{X,x_i}/I'_{x_i})"]
public theorem exists_residualIdeal_of_maximal_order
    (hdim : ringKrullDim A = 2) (ℐ : (Spec (CommRingCat.of A)).IdealSheafData)
    (hℐ : ℐ = Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (.of A)).inv.hom (IsLocalRing.maximalIdeal A)))
    (I : Ideal A) (n : ℕ)
    (hnI : IsLocalRing.maximalIdeal A ^ n ≤ I) (hIm : I ≤ IsLocalRing.maximalIdeal A) :
    (∃ d : ℕ, (Scheme.IdealSheafData.ofIdealTop
          (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ) ≤
        exceptionalIdeal ℐ ^ d ∧
      ∀ e : ℕ, (Scheme.IdealSheafData.ofIdealTop
          (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ) ≤
        exceptionalIdeal ℐ ^ e → e ≤ d) ∧
    ∀ d : ℕ, (Scheme.IdealSheafData.ofIdealTop
          (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ) ≤
        exceptionalIdeal ℐ ^ d →
      (∀ e : ℕ, (Scheme.IdealSheafData.ofIdealTop
          (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ) ≤
        exceptionalIdeal ℐ ^ e → e ≤ d) →
    0 < d ∧
      ∃ (I' : (blowUp ℐ).IdealSheafData) (T : Finset (blowUp ℐ)),
        exceptionalIdeal ℐ ^ d * I' = (Scheme.IdealSheafData.ofIdealTop
          (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ) ∧
        (∀ K : (blowUp ℐ).IdealSheafData, exceptionalIdeal ℐ ^ d * K =
          (Scheme.IdealSheafData.ofIdealTop
            (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)).comap (blowUpToBase ℐ) → K = I') ∧
        (I'.support : Set (blowUp ℐ)) = (T : Set (blowUp ℐ)) ∧
        (∀ x ∈ T, IsClosed ({x} : Set (blowUp ℐ))) ∧
        letI : Algebra A Γ(I'.subscheme, ⊤) :=
          ((Scheme.ΓSpecIso (.of A)).inv ≫ (I'.subschemeι ≫ blowUpToBase ℐ).appTop).hom.toAlgebra
        Module.length A Γ(I'.subscheme, ⊤) < Module.length A (A ⧸ I) ∧
        (∑ x ∈ T, Module.length ((blowUp ℐ).presheaf.stalk x)
            ((blowUp ℐ).presheaf.stalk x ⧸ IdealSheafData.stalk I' x)) ≤
          Module.length A Γ(I'.subscheme, ⊤) := by
  have hℐ' : ℐ = (Stacks.Blowup.residuePoint A).ker :=
    hℐ.trans (ker_residuePoint_eq_ofIdealTop_map A).symm
  refine ⟨(exists_maximal_order_comap_ofIdealTop A hdim ℐ hℐ' I n hnI).imp fun _ h => h.2,
    fun d hd hmax => exists_residualIdeal_of_maximal_order_of_strict A hdim ℐ hℐ' I n hnI hIm d hd
      hmax fun I' hI' => length_globalSections_lt_length_quotient_blowUp A hdim ℐ hℐ I n hnI hIm
        d hd hmax I' hI'⟩

end AlgebraicGeometry

end
