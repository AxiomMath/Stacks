module

public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartier.UFDExtension
public import StacksFrontier.AlgebraicGeometry.ResolutionsAndBounds.IdealSheafStalk
public import StacksFrontier.RingTheory.Dualizing.TrivialDualityInvertibleKernel

/-!
# An effective Cartier divisor is trivial on a quotient, at a stalk

In the last step of [Stacks, Tag 0AGT] clause (3) the two sheaves `𝒪_X(-dE)/I·𝒪_X` and
`𝒪_X/ℐ'`, where `ℐ' = I·𝒪_X(dE)`, differ by the invertible sheaf `𝒪_X(dE)`, which is trivial on
each local ring. This file proves the corresponding statement about stalks.

Write `W = Z · D` for `D` an effective Cartier divisor and `Z` an arbitrary quasi-coherent ideal
sheaf — the factorisation `I·𝒪_X = E^d · ℐ'` of clause (2), with `D = E^d` and `Z = ℐ'`. At a
point `x` the stalk of `D` is a principal ideal `(t)` generated by a regular element, and the
assertion is that the two local modules

`D_x/W_x`   and   `𝒪_{X,x}/Z_x`

have the same length.

## Main results

* `Stacks.Length.length_quotient_comap_subtype_mul_eq`: for `t` a regular element of a
  commutative ring `R`, `I = (t)` and `J` an arbitrary ideal, the quotient of `I` by `J · I` has
  the same length over `R` as `R/J`.
* `Stacks.Divisors.length_quotient_stalk_mul_isEffectiveCartierDivisor_eq`: for `D` an effective
  Cartier divisor on a scheme `X` and `Z` any ideal sheaf, the quotient of `D`'s stalk at `x` by
  the stalk of `Z · D` has the same length over `𝒪_{X,x}` as `𝒪_{X,x}/Z_x`.

## Implementation notes

Both statements take the submodule being quotiented by as an argument `Q`, pinned by an equation
`hQ`, rather than writing `Submodule.comap (Submodule.subtype I) (J * I)` inside the quotient: the
`⧸` notation does not elaborate on that term, and at a stalk the generator of `D_x` would otherwise
have to be rewritten in a dependent position.

## References

* [Stacks Project, Tag 0AGT](https://stacks.math.columbia.edu/tag/0AGT)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory

universe u

namespace Stacks.Length

/-- **The image of an ideal under multiplication by a regular element.** The isomorphism
`Dualizing.InvertibleKernel.spanSingletonEquiv` from `R` to `(t)` carries the ideal `J` onto
`J · (t)`, read inside `(t)`. -/
public theorem map_spanSingletonEquiv {R : Type*} [CommRing R] (t : R)
    (ht : ∀ r : R, r * t = 0 → r = 0) (J : Ideal R) :
    Submodule.map (Dualizing.InvertibleKernel.spanSingletonEquiv t ht).toLinearMap J =
      Submodule.comap (Submodule.subtype (Ideal.span {t} : Ideal R))
        (J * Ideal.span {t}) := by
  ext y
  simp only [Submodule.mem_map, Submodule.mem_comap, Submodule.subtype_apply]
  constructor
  · rintro ⟨j, hj, rfl⟩
    exact Ideal.mul_mem_mul hj (Ideal.mem_span_singleton_self t)
  · intro hy
    rw [mul_comm] at hy
    obtain ⟨z, hz, hzy⟩ := Ideal.mem_span_singleton_mul.1 hy
    exact ⟨z, hz, Subtype.ext ((mul_comm z t).trans hzy)⟩

/-- **A principal ideal generated by a regular element is trivial as a twist.** Let `R` be a
commutative ring, `t` a regular element, `I = (t)` and `J` any ideal. Then

`length_R (I / J·I) = length_R (R / J)`,

where the submodule `J·I` of `I` is the argument `Q`, pinned by `hQ`. -/
public theorem length_quotient_comap_subtype_mul_eq {R : Type*} [CommRing R] {I : Ideal R}
    {t : R} (ht : IsRegular t) (hI : I = Ideal.span {t}) (J : Ideal R) (Q : Submodule R ↥I)
    (hQ : Q = Submodule.comap (Submodule.subtype I) (J * I)) :
    Module.length R (↥I ⧸ Q) = Module.length R (R ⧸ J) := by
  subst hI
  subst hQ
  have hx : ∀ r : R, r * t = 0 → r = 0 := fun r hr =>
    ht.right (show r * t = 0 * t by simpa using hr)
  exact ((Submodule.Quotient.equiv J _
    (Dualizing.InvertibleKernel.spanSingletonEquiv t hx)
    (map_spanSingletonEquiv t hx J)).length_eq).symm

end Stacks.Length

namespace Stacks.Divisors

/-- **An effective Cartier divisor is trivial on a quotient, at every stalk.** Let `D` be an
effective Cartier divisor on a scheme `X` and let `Z` be an arbitrary quasi-coherent ideal
sheaf. At every point `x` of `X`,

`length_{𝒪_{X,x}} (D_x / (Z·D)_x) = length_{𝒪_{X,x}} (𝒪_{X,x} / Z_x)`,

where the submodule `(Z·D)_x` of `D_x` is the argument `Q`, pinned by `hQ`. -/
public theorem length_quotient_stalk_mul_isEffectiveCartierDivisor_eq {X : Scheme.{u}}
    (D Z : X.IdealSheafData) (hD : IsEffectiveCartierDivisor D) (x : X)
    (Q : Submodule ↑(X.presheaf.stalk x) ↥(IdealSheafData.stalk D x))
    (hQ : Q = Submodule.comap (Submodule.subtype (IdealSheafData.stalk D x))
      (IdealSheafData.stalk (Z * D) x)) :
    Module.length ↑(X.presheaf.stalk x) (↥(IdealSheafData.stalk D x) ⧸ Q) =
      Module.length ↑(X.presheaf.stalk x)
        (↑(X.presheaf.stalk x) ⧸ IdealSheafData.stalk Z x) := by
  obtain ⟨t, ht, hspan⟩ :=
    AlgebraicGeometry.exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor D hD x
  refine Stacks.Length.length_quotient_comap_subtype_mul_eq ht hspan _ Q ?_
  rw [hQ, AlgebraicGeometry.IdealSheafData.stalk_mul]

end Stacks.Divisors

end
