/-!
# `H¹ = 0` on the relative-`Proj` blowup, and the sections it lifts

Let `(A, 𝔪)` be a regular local ring of dimension two and `X ⟶ Spec A` the blowup of `Spec A` in
`𝔪` in the relative-`Proj` model `AlgebraicGeometry.blowUp`. This file proves part (3) of
[Stacks, Tag 0AGS] on that model, `H¹(X, ℱ) = 0` for `ℱ` a quasi-coherent module generated by
global sections, and deduces `H¹(X, I·𝒪_X) = 0` and the surjectivity of `Γ(X, 𝒪_X) ⟶ Γ(Z, 𝒪_Z)`
for `Z` the closed subscheme cut out by `I·𝒪_X`.

## Main results

* `AlgebraicGeometry.Scheme.Modules.nonempty_generatingSections_pullback`: the inverse image of a
  module generated by global sections along an arbitrary morphism of schemes is generated by
  global sections.
* `AlgebraicGeometry.isZero_cohomology_one_of_generatingSections_blowUp`: [Stacks, Tag 0AGS]
  part (3) on `AlgebraicGeometry.blowUp`.
* `AlgebraicGeometry.isZero_cohomology_one_comap_ofIdealTop_blowUp`: `H¹(X, I·𝒪_X) = 0` on
  `AlgebraicGeometry.blowUp`.
* `Stacks.Blowup.Colength.surjective_appTop_comap_ofIdealTop_blowUp`: global functions on `X`
  surject onto the global functions of the closed subscheme cut out by `I·𝒪_X`.

## Implementation notes

`AlgebraicGeometry.Scheme.Modules` is a `def` for `SheafOfModules _`, and instance search does not
cross it to find the `PreservesColimitsOfSize` instance that
`SheafOfModules.GeneratingSections.map` asks for; it is passed positionally, read off the
adjunction `Scheme.Modules.pullbackPushforwardAdjunction`.

The blowup, its structure morphism and `Spec` are written with their `AlgebraicGeometry.`
prefixes throughout: the namespace `Stacks.Blowup` carries a second blowup
`Stacks.Blowup.blowUp` with its own `blowUpToBase` and `exceptionalIdeal`, and inside
`Stacks.Blowup.Colength` the bare names resolve to those.

## References

* [Stacks Project, Tag 0AGS](https://stacks.math.columbia.edu/tag/0AGS)
* [Stacks Project, Tag 0AGT](https://stacks.math.columbia.edu/tag/0AGT)
* [Stacks Project, Tag 0C6K](https://stacks.math.columbia.edu/tag/0C6K)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace AlgebraicGeometry.Scheme.Modules

/-- **The inverse image of a module generated by global sections is generated by global
sections.** For `f : X ⟶ Y` an arbitrary morphism of schemes and `F` an `𝒪_Y`-module generated
by global sections, `f^* F` is generated by global sections. -/
public theorem nonempty_generatingSections_pullback {X Y : Scheme.{u}} (f : X ⟶ Y)
    (F : Y.Modules) (σ : F.GeneratingSections) :
    Nonempty ((Scheme.Modules.pullback f).obj F).GeneratingSections :=
  ⟨@SheafOfModules.GeneratingSections.map _ _ _ _ _ _ _ _ _ _ _ _ _ σ
    (Scheme.Modules.pullback f)
    (Scheme.Modules.pullbackPushforwardAdjunction f).leftAdjoint_preservesColimits
    (asIso (Stacks.ProjectionFormula.pullbackUnitToUnit f.toLRSHom.toShHom)).symm⟩

end AlgebraicGeometry.Scheme.Modules

namespace AlgebraicGeometry

/-- **[Stacks, Tag 0AGS] part (3) on the relative-`Proj` blowup.** For `(A, 𝔪)` a regular local
ring of dimension two, `X ⟶ Spec A` the blowup of `Spec A` in `𝔪` in the relative-`Proj` model
`AlgebraicGeometry.blowUp`, and `ℱ` a quasi-coherent `𝒪_X`-module generated by global sections,
`H¹(X, ℱ) = 0`. -/
public theorem isZero_cohomology_one_of_generatingSections_blowUp
    (A : Type u) [CommRing A] [IsRegularLocalRing A] (hdim : ringKrullDim A = 2)
    (F : (AlgebraicGeometry.blowUp (Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
        (IsLocalRing.maximalIdeal A)))).Modules)
    (hF : F.IsQuasicoherent) (σ : F.GeneratingSections) :
    IsZero (_root_.Hgroup (AlgebraicGeometry.blowUp (Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
        (IsLocalRing.maximalIdeal A)))).ringCatSheaf ⊤ 1 F) :=
  (isZero_cohomology_one_of_generatingSections A hdim
      ((Scheme.Modules.pullback
        (Stacks.Blowup.affineBlowUpIso A (IsLocalRing.maximalIdeal A)).hom).obj F)
      (@isQuasicoherent_pullback_obj' _ _
        (Stacks.Blowup.affineBlowUpIso A (IsLocalRing.maximalIdeal A)).hom F hF)
      (Scheme.Modules.nonempty_generatingSections_pullback _ F σ).some).of_iso
    (Stacks.Cohomology.ModuleComparison.hgroupPullbackIso
      (Stacks.Blowup.affineBlowUpIso A (IsLocalRing.maximalIdeal A)) 1 F).symm

/-- **`H¹(X, I·𝒪_X) = 0` on the relative-`Proj` blowup of a regular local surface.** For
`(A, 𝔪)` a regular local ring of dimension two, `X` the blowup of `Spec A` in `𝔪` in the model
`AlgebraicGeometry.blowUp`, and `I` an ideal of `Γ(Spec A, 𝒪)`, the inverse-image ideal sheaf
`I·𝒪_X` has vanishing first cohomology. -/
public theorem isZero_cohomology_one_comap_ofIdealTop_blowUp
    (A : Type u) [CommRing A] [IsRegularLocalRing A] (hdim : ringKrullDim A = 2)
    (I : Ideal Γ(Spec (CommRingCat.of A), ⊤)) :
    IsZero (_root_.Hgroup (AlgebraicGeometry.blowUp (Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
          (IsLocalRing.maximalIdeal A)))).ringCatSheaf ⊤ 1
      (Stacks.Divisors.idealSheafOfModules
        ((Scheme.IdealSheafData.ofIdealTop I).comap
          (AlgebraicGeometry.blowUpToBase (Scheme.IdealSheafData.ofIdealTop
            (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
              (IsLocalRing.maximalIdeal A))))))) :=
  isZero_cohomology_one_of_generatingSections_blowUp A hdim _
    (isQuasicoherent_idealSheafOfModules _)
    (Stacks.Divisors.nonempty_generatingSections_comap_ofIdealTop _ I).some

end AlgebraicGeometry

namespace Stacks.IdealSheafSequence

/-- **The short exact sequence of [Stacks, Tag 0C6K] in `SheafOfModules X.ringCatSheaf`.** This is
`Stacks.IdealSheafSequence.divisorIdeal_shortExact`, stated there over the sheaf of rings
`RingedSpaceModuleAdjunction.structureSheafRing X.toRingedSpace`, which is `X.ringCatSheaf` by
`rfl`. -/
public theorem divisorIdeal_shortExact_sheafOfModules {X : Scheme.{u}} (D : X.IdealSheafData) :
    ∃ hz : divisorIdealMap D ≫ divisorQuotientMap D = 0,
      (ShortComplex.mk (C := SheafOfModules.{u} X.ringCatSheaf) (divisorIdealMap D)
        (divisorQuotientMap D) hz).ShortExact :=
  divisorIdeal_shortExact D

/-- **Global functions surject onto the global functions of a closed subscheme whose ideal sheaf
has vanishing `H¹`.** For `D` a quasi-coherent ideal sheaf on a scheme `X` cutting out `Z ⊆ X`,
if `H¹(X, ℐ_D) = 0` then `Γ(X, 𝒪_X) ⟶ Γ(Z, 𝒪_Z)` is surjective. -/
public theorem surjective_divisorQuotientMap_app_top {X : Scheme.{u}} (D : X.IdealSheafData)
    (h : IsZero (_root_.Hgroup X.ringCatSheaf ⊤ 1 (Stacks.Divisors.idealSheafOfModules D))) :
    Function.Surjective
      ((divisorQuotientMap D).val.app (op (⊤ : X.Opens))) := by
  obtain ⟨hz, hSE⟩ := divisorIdeal_shortExact_sheafOfModules D
  exact Stacks.SerreAffinenessCriterion.surjective_app_of_isZero_hgroup_one X ⊤ hSE h

end Stacks.IdealSheafSequence

namespace Stacks.Blowup.Colength

/-- **Global functions on the relative-`Proj` blowup surject onto the global functions of the
closed subscheme cut out by `I·𝒪_X`.** For `(A, 𝔪)` a regular local ring of dimension two, `X`
the blowup of `Spec A` in `𝔪` in the model `AlgebraicGeometry.blowUp`, `I` an ideal of
`Γ(Spec A, 𝒪)` and `Z ⊆ X` the closed subscheme cut out by `I·𝒪_X`, every global function on `Z`
is the restriction of a global function on `X`. -/
public theorem surjective_appTop_comap_ofIdealTop_blowUp
    (A : Type u) [CommRing A] [IsRegularLocalRing A] (hdim : ringKrullDim A = 2)
    (I : Ideal Γ(Spec (CommRingCat.of A), ⊤)) :
    Function.Surjective ((Stacks.IdealSheafSequence.divisorQuotientMap
        ((Scheme.IdealSheafData.ofIdealTop I).comap
          (AlgebraicGeometry.blowUpToBase (Scheme.IdealSheafData.ofIdealTop
            (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
              (IsLocalRing.maximalIdeal A)))))).val.app
      (op (⊤ : (AlgebraicGeometry.blowUp (Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
          (IsLocalRing.maximalIdeal A)))).Opens))) :=
  Stacks.IdealSheafSequence.surjective_divisorQuotientMap_app_top _
    (AlgebraicGeometry.isZero_cohomology_one_comap_ofIdealTop_blowUp A hdim I)

end Stacks.Blowup.Colength

end
