module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.GradedModuleAbelian
public import StacksFrontier.AlgebraicGeometry.Blowup.ReesAlgebraSheaf
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.Completion.IdealPowerQuasicoherent

/-!
# The graded module of ideal-power multiples over the Rees algebra

Let `X` be a scheme, `ℐ ⊆ 𝒪_X` a quasi-coherent sheaf of ideals and `F` an `𝒪_X`-module. For
`n ≥ 0` write `ℐⁿF ⊆ F` for the subsheaf generated by the products of local sections of `ℐⁿ`
with local sections of `F`. Multiplication of sections turns the family `(ℐⁿF)_n` into a graded
module over the Rees algebra `⨁_{n ≥ 0} ℐⁿ` of `ℐ`, as in [Stacks, Tag 02O7]; this file
constructs `ℐⁿF` and the action.

## Main definitions

* `Stacks.Blowup.reesMultiple`: the subsheaf `ℐⁿF` of `F`, indexed by `n : ℤ`.
* `Stacks.Blowup.reesMultipleSmul`: the action `ℐⁿF × ℐⁱ → ℐⁿ⁺ⁱF` on sections.
* `Stacks.Blowup.reesGradedModule`: the family `(ℐⁿF)_{n : ℤ}` as a graded module over the
  Rees algebra `Stacks.Blowup.reesGradedAlgebra ℐ`.
* `Stacks.Blowup.reesMultipleSmulHom`: the morphism of sheaves `ℐⁿF ⟶ ℐⁿ⁺ⁱF` given by
  multiplication by a *global* section of `ℐⁱ`.

## Main results

* `Stacks.Blowup.smul_mem_reesMultiple`: a product of a local section of `ℐⁿ` with a local
  section of `F` lies in `ℐⁿF`.
* `Stacks.Blowup.reesMultiple_le_iff`: the universal property of `ℐⁿF` — it is the least
  subsheaf of `F` containing all those products. Together with the previous result this says
  that `ℐⁿF` is the subsheaf *generated* by them.
* `Stacks.Blowup.reesPiece_smul_mem_reesMultiple`: a local section of `ℐⁱ` carries `ℐⁿF` into
  `ℐⁿ⁺ⁱF`.
* `Stacks.Blowup.reesMultiple_eq_bot_of_neg`: `ℐⁿF` vanishes in negative degrees.
* `Stacks.Blowup.reesMultiple_zero`: the degree-zero piece is the whole of `F`.
* `Stacks.Blowup.reesMultiple_le_reesMultiple_of_le`: `ℐᵐF ⊆ ℐⁿF` for `0 ≤ n ≤ m`.

## Implementation notes

`ℐⁿF` is defined pointwise: a section `s` of `F` over `U` lies in `ℐⁿF` exactly when every point
of `U` has a neighbourhood `V ⊆ U` on which `s` restricts into the `Γ(X, V)`-submodule
`reesMultipleSpan` spanned by the products over `V`. Degrees are integers, as
`SheafOfModules.GradedModule` requires.

## References

* [Stacks Project, Tag 02O7](https://stacks.math.columbia.edu/tag/02O7)
* [Stacks Project, Tag 02O8](https://stacks.math.columbia.edu/tag/02O8)
* [Stacks Project, Tag 01OG](https://stacks.math.columbia.edu/tag/01OG)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

namespace Stacks.Blowup

universe u

attribute [local instance] Stacks.Algebraization.sectionsModuleΓSheaf

/-! ### Restriction of sections, and the two spellings of the scalars -/

/-- Restricting a section of `F` along `V ≤ U` and then along `W ≤ V` is restricting it along
`W ≤ U`. -/
public lemma restr_restr_opens {X : Scheme.{u}} (F : SheafOfModules.{u} X.ringCatSheaf)
    {U V W : X.Opens} (h : V ≤ U) (h' : W ≤ V) (s : F.val.obj (op U)) :
    Stacks.restr F.val (homOfLE h').op (Stacks.restr F.val (homOfLE h).op s) =
      Stacks.restr F.val (homOfLE (h'.trans h)).op s :=
  (SheafOfModules.restr_comp F.val (homOfLE h).op (homOfLE h').op s).symm.trans
    (congrArg (fun g => Stacks.restr F.val g s) (Subsingleton.elim _ _))

/-- Restricting a section along the identity inclusion does nothing. -/
public lemma restr_opens_self {X : Scheme.{u}} (F : SheafOfModules.{u} X.ringCatSheaf)
    {U : X.Opens} (s : F.val.obj (op U)) :
    Stacks.restr F.val (homOfLE (le_refl U)).op s = s :=
  (congrArg (fun g => Stacks.restr F.val g s) (Subsingleton.elim _ (𝟙 (op U)))).trans
    (SheafOfModules.restr_id F.val (op U) s)

/-- Restricting the zero section gives the zero section. -/
public lemma restr_zero_opens {X : Scheme.{u}} (F : SheafOfModules.{u} X.ringCatSheaf)
    {U V : X.Opens} (h : V ≤ U) :
    Stacks.restr F.val (homOfLE h).op (0 : F.val.obj (op U)) = 0 :=
  map_zero (ConcreteCategory.hom (F.val.map (homOfLE h).op))

/-- Restriction is semilinear for a scalar written as a section of the structure sheaf. -/
public lemma restr_smul_gamma {X : Scheme.{u}} (F : SheafOfModules.{u} X.ringCatSheaf)
    {U V : X.Opens} (h : V ≤ U) (a : Γ(X, U)) (s : F.val.obj (op U)) :
    Stacks.restr F.val (homOfLE h).op (a • s) =
      X.presheaf.map (homOfLE h).op a • Stacks.restr F.val (homOfLE h).op s :=
  F.val.map_smul (homOfLE h).op a s

/-- Taking the image in `Γ(X, U)` of a homogeneous section of the Rees algebra commutes with
restriction, in the `Stacks.restr` spelling. -/
public lemma reesPieceAmbient_restr {X : Scheme.{u}} (I : X.IdealSheafData) (n : ℤ)
    {U V : X.Opens} (h : V ≤ U) (r : (reesPiece I n).val.obj (op U)) :
    reesPieceAmbient I n V (Stacks.restr (reesPiece I n).val (homOfLE h).op r) =
      X.presheaf.map (homOfLE h).op (reesPieceAmbient I n U r) :=
  reesPieceAmbient_restrict I n V U h r

/-- The action of a section of the structure sheaf commutes with the action of a section of the
sheaf of rings. -/
public lemma smul_comm_reesPieceAmbient {X : Scheme.{u}} (F : SheafOfModules.{u} X.ringCatSheaf)
    {U : (Opens X)ᵒᵖ} (a : X.ringCatSheaf.obj.obj U) (b : Γ(X, U.unop))
    (s : F.val.obj U) : b • a • s = a • b • s := by
  have h₁ : b • a • s = (b * (show Γ(X, U.unop) from a)) • s := smul_smul _ _ _
  have h₂ : a • b • s = ((show Γ(X, U.unop) from a) * b) • s := smul_smul _ _ _
  rw [h₁, h₂, mul_comm]

/-- In negative degrees every section of the Rees algebra has zero image in `Γ(X, U)`. -/
public lemma reesPieceAmbient_eq_zero_of_neg {X : Scheme.{u}} (I : X.IdealSheafData) (n : ℤ)
    (hn : n < 0) (U : X.Opens) (r : (reesPiece I n).val.obj (op U)) :
    reesPieceAmbient I n U r = 0 := by
  cases n with
  | ofNat k =>
      exact absurd hn (by simp)
  | negSucc k => rfl

/-! ### The span of the generators over a single open -/

/-- The local generators of `ℐⁿF` over an open `U`: the products of a section of the degree-`n`
piece of the Rees algebra of `ℐ` with a section of `F`. -/
public def reesMultipleGen {X : Scheme.{u}} (I : X.IdealSheafData) (n : ℤ)
    (F : SheafOfModules.{u} X.ringCatSheaf) (U : X.Opens) : Set (F.val.obj (op U)) :=
  { s | ∃ (r : (reesPiece I n).val.obj (op U)) (m : F.val.obj (op U)),
      s = reesPieceAmbient I n U r • m }

/-- The submodule of `Γ(F, U)` spanned by the degree-`n` generators. -/
public def reesMultipleSpan {X : Scheme.{u}} (I : X.IdealSheafData) (n : ℤ)
    (F : SheafOfModules.{u} X.ringCatSheaf) (U : X.Opens) :
    Submodule (X.ringCatSheaf.obj.obj (op U)) (F.val.obj (op U)) :=
  Submodule.span (X.ringCatSheaf.obj.obj (op U)) (reesMultipleGen I n F U)

/-- A product of a section of `ℐⁿ` with a section of `F` lies in the span of the generators. -/
public lemma smul_mem_reesMultipleSpan {X : Scheme.{u}} (I : X.IdealSheafData) (n : ℤ)
    (F : SheafOfModules.{u} X.ringCatSheaf) (U : X.Opens)
    (r : (reesPiece I n).val.obj (op U)) (m : F.val.obj (op U)) :
    reesPieceAmbient I n U r • m ∈ reesMultipleSpan I n F U :=
  Submodule.subset_span ⟨r, m, rfl⟩

/-- Restriction of a product of a section of `ℐⁿ` with a section of `F` is the product of the
restrictions. -/
private lemma restr_reesPieceAmbient_smul {X : Scheme.{u}} (I : X.IdealSheafData) (n : ℤ)
    (F : SheafOfModules.{u} X.ringCatSheaf) {U V : X.Opens} (h : V ≤ U)
    (r : (reesPiece I n).val.obj (op U)) (m : F.val.obj (op U)) :
    Stacks.restr F.val (homOfLE h).op (reesPieceAmbient I n U r • m) =
      reesPieceAmbient I n V (Stacks.restr (reesPiece I n).val (homOfLE h).op r) •
        Stacks.restr F.val (homOfLE h).op m := by
  rw [restr_smul_gamma, reesPieceAmbient_restr]

/-- Restriction carries the span of the degree-`n` generators over `U` into the span of the
degree-`n` generators over a smaller open `V`. -/
public lemma restr_mem_reesMultipleSpan {X : Scheme.{u}} (I : X.IdealSheafData) (n : ℤ)
    (F : SheafOfModules.{u} X.ringCatSheaf) {U V : X.Opens} (h : V ≤ U)
    {s : F.val.obj (op U)} (hs : s ∈ reesMultipleSpan I n F U) :
    Stacks.restr F.val (homOfLE h).op s ∈ reesMultipleSpan I n F V := by
  induction hs using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨r, m, rfl⟩ := hx
      rw [restr_reesPieceAmbient_smul]
      exact smul_mem_reesMultipleSpan I n F V _ _
  | zero =>
      rw [restr_zero_opens]
      exact Submodule.zero_mem _
  | add x y _ _ hx hy =>
      rw [SheafOfModules.restr_add]
      exact Submodule.add_mem _ hx hy
  | smul a x _ hx =>
      rw [SheafOfModules.restr_smul]
      exact Submodule.smul_mem _ _ hx

/-- Multiplying by a section of `ℐⁱ` carries the span of the degree-`n` generators into the span
of the degree-`n + i` generators. -/
public lemma reesPiece_smul_mem_reesMultipleSpan {X : Scheme.{u}} (I : X.IdealSheafData)
    (n i : ℤ) (F : SheafOfModules.{u} X.ringCatSheaf) (U : X.Opens)
    (r : (reesPiece I i).val.obj (op U)) {s : F.val.obj (op U)}
    (hs : s ∈ reesMultipleSpan I n F U) :
    reesPieceAmbient I i U r • s ∈ reesMultipleSpan I (n + i) F U := by
  induction hs using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨q, m, rfl⟩ := hx
      have hprod := reesMultiplication_ambient I n i U q r
      have hcalc : reesPieceAmbient I i U r • reesPieceAmbient I n U q • m =
          reesPieceAmbient I (n + i) U ((reesMultiplication I n i).app (op U) q r) • m := by
        rw [hprod, smul_smul, mul_comm]
      rw [hcalc]
      exact smul_mem_reesMultipleSpan I (n + i) F U _ _
  | zero =>
      rw [smul_zero]
      exact Submodule.zero_mem _
  | add x y _ _ hx hy =>
      rw [smul_add]
      exact Submodule.add_mem _ hx hy
  | smul a x _ hx =>
      rw [smul_comm_reesPieceAmbient F a (reesPieceAmbient I i U r) x]
      exact Submodule.smul_mem _ _ hx

/-! ### The subsheaf `ℐⁿF` -/

/-- The subsheaf `ℐⁿF` of `F`: a section of `F` over `U` lies in it exactly when every point of
`U` has a neighbourhood in `U` on which the section restricts into the span of the products of
sections of `ℐⁿ` with sections of `F`. -/
public def reesMultiple {X : Scheme.{u}} (I : X.IdealSheafData) (n : ℤ)
    (F : SheafOfModules.{u} X.ringCatSheaf) : F.Submodule where
  toSubmodule :=
    { obj U :=
        { carrier := { s | ∀ x ∈ U.unop, ∃ (V : X.Opens) (hV : V ≤ U.unop), x ∈ V ∧
            Stacks.restr F.val (homOfLE hV).op s ∈ reesMultipleSpan I n F V }
          add_mem' := by
            intro s t hs ht x hx
            obtain ⟨V, hV, hxV, hsV⟩ := hs x hx
            obtain ⟨W, hW, hxW, htW⟩ := ht x hx
            refine ⟨V ⊓ W, inf_le_left.trans hV, ⟨hxV, hxW⟩, ?_⟩
            have h₁ := restr_mem_reesMultipleSpan I n F (inf_le_left : V ⊓ W ≤ V) hsV
            have h₂ := restr_mem_reesMultipleSpan I n F (inf_le_right : V ⊓ W ≤ W) htW
            rw [restr_restr_opens] at h₁ h₂
            rw [SheafOfModules.restr_add]
            exact Submodule.add_mem _ h₁ h₂
          zero_mem' := by
            intro x hx
            refine ⟨U.unop, le_rfl, hx, ?_⟩
            rw [restr_zero_opens]
            exact Submodule.zero_mem _
          smul_mem' := by
            intro a s hs x hx
            obtain ⟨V, hV, hxV, hsV⟩ := hs x hx
            refine ⟨V, hV, hxV, ?_⟩
            rw [SheafOfModules.restr_smul]
            exact Submodule.smul_mem _ _ hsV }
      map := by
        intro U V f s hs x hx
        obtain ⟨V₀, hV₀, hxV₀, hsV₀⟩ := hs x (leOfHom f.unop hx)
        refine ⟨V₀ ⊓ V.unop, inf_le_right, ⟨hxV₀, hx⟩, ?_⟩
        have h₁ := restr_mem_reesMultipleSpan I n F (inf_le_left : V₀ ⊓ V.unop ≤ V₀) hsV₀
        rw [restr_restr_opens] at h₁
        have hfe : f = (homOfLE (leOfHom f.unop)).op := Subsingleton.elim _ _
        change Stacks.restr F.val (homOfLE (inf_le_right : V₀ ⊓ V.unop ≤ V.unop)).op
          (Stacks.restr F.val f s) ∈ reesMultipleSpan I n F (V₀ ⊓ V.unop)
        rw [hfe, restr_restr_opens]
        exact h₁ }
  isSheaf := by
    intro U s hs x hx
    rw [Opens.mem_grothendieckTopology] at hs
    obtain ⟨V, f, hf, hxV⟩ := hs x hx
    obtain ⟨W, hW, hxW, hsW⟩ := hf x hxV
    refine ⟨W, hW.trans (leOfHom f), hxW, ?_⟩
    have h : Stacks.restr F.val (homOfLE hW).op
        (Stacks.restr F.val (homOfLE (leOfHom f)).op s) ∈ reesMultipleSpan I n F W := hsW
    rwa [restr_restr_opens] at h

/-- Membership in a submodule of a sheaf of modules is local: it is enough that every point of
`U` have a neighbourhood in `U` on which the section restricts into the submodule. -/
public lemma mem_submodule_of_cover {X : Scheme.{u}} {F : SheafOfModules.{u} X.ringCatSheaf}
    (N : F.Submodule) (U : X.Opens) (s : F.val.obj (op U))
    (h : ∀ x ∈ U, ∃ (V : X.Opens) (hV : V ≤ U), x ∈ V ∧
      Stacks.restr F.val (homOfLE hV).op s ∈ N.toSubmodule.obj (op V)) :
    s ∈ N.toSubmodule.obj (op U) := by
  apply N.isSheaf
  rw [Opens.mem_grothendieckTopology]
  intro x hx
  obtain ⟨V, hV, hxV, hsV⟩ := h x hx
  exact ⟨V, homOfLE hV, hsV, hxV⟩

/-- Every product of a local section of `ℐⁿ` with a local section of `F` lies in `ℐⁿF`. -/
public lemma smul_mem_reesMultiple {X : Scheme.{u}} (I : X.IdealSheafData) (n : ℤ)
    (F : SheafOfModules.{u} X.ringCatSheaf) (U : X.Opens)
    (r : (reesPiece I n).val.obj (op U)) (m : F.val.obj (op U)) :
    reesPieceAmbient I n U r • m ∈ (reesMultiple I n F).toSubmodule.obj (op U) := by
  intro x hx
  refine ⟨U, le_rfl, hx, ?_⟩
  rw [restr_opens_self]
  exact smul_mem_reesMultipleSpan I n F U r m

/-- The universal property of `ℐⁿF`: it is the least subsheaf of `F` containing every product of
a local section of `ℐⁿ` with a local section of `F`. -/
public lemma reesMultiple_le_iff {X : Scheme.{u}} (I : X.IdealSheafData) (n : ℤ)
    (F : SheafOfModules.{u} X.ringCatSheaf) (N : F.Submodule) :
    reesMultiple I n F ≤ N ↔
      ∀ (U : X.Opens) (r : (reesPiece I n).val.obj (op U)) (m : F.val.obj (op U)),
        reesPieceAmbient I n U r • m ∈ N.toSubmodule.obj (op U) := by
  refine ⟨fun h U r m => h (op U) (smul_mem_reesMultiple I n F U r m), fun h U s hs => ?_⟩
  refine mem_submodule_of_cover N U.unop s fun x hx => ?_
  obtain ⟨V, hV, hxV, hsV⟩ := hs x hx
  refine ⟨V, hV, hxV, Submodule.span_le.2 ?_ hsV⟩
  rintro y ⟨r, m, rfl⟩
  exact h V r m

/-- A local section of `ℐⁱ` carries `ℐⁿF` into `ℐⁿ⁺ⁱF`. -/
public lemma reesPiece_smul_mem_reesMultiple {X : Scheme.{u}} (I : X.IdealSheafData) (n i : ℤ)
    (F : SheafOfModules.{u} X.ringCatSheaf) (U : X.Opens)
    (r : (reesPiece I i).val.obj (op U)) (s : F.val.obj (op U))
    (hs : s ∈ (reesMultiple I n F).toSubmodule.obj (op U)) :
    reesPieceAmbient I i U r • s ∈ (reesMultiple I (n + i) F).toSubmodule.obj (op U) := by
  intro x hx
  obtain ⟨V, hV, hxV, hsV⟩ := hs x hx
  refine ⟨V, hV, hxV, ?_⟩
  rw [restr_reesPieceAmbient_smul]
  exact reesPiece_smul_mem_reesMultipleSpan I n i F V _ hsV

/-- In negative degrees `ℐⁿF` is the zero subsheaf. -/
public lemma reesMultiple_eq_bot_of_neg {X : Scheme.{u}} (I : X.IdealSheafData) (n : ℤ)
    (F : SheafOfModules.{u} X.ringCatSheaf) (hn : n < 0) :
    reesMultiple I n F = ⊥ := by
  refine le_antisymm ((reesMultiple_le_iff I n F ⊥).2 fun U r m => ?_) bot_le
  rw [reesPieceAmbient_eq_zero_of_neg I n hn U r, zero_smul,
    SheafOfModules.Submodule.bot_obj]
  exact Submodule.zero_mem _

/-! ### The graded module `⨁ₙ ℐⁿF` over the Rees algebra -/

/-- Two sections of ideal-power multiples of the same `F`, in propositionally equal degrees and
over the same open, are heterogeneously equal as soon as their images in `F` agree. -/
public lemma heq_reesMultiple_section {X : Scheme.{u}} (I : X.IdealSheafData)
    (F : SheafOfModules.{u} X.ringCatSheaf) {m k : ℤ} (hmk : m = k) {U : (Opens X)ᵒᵖ}
    (x : ((reesMultiple I m F).toSheafOfModules).val.obj U)
    (y : ((reesMultiple I k F).toSheafOfModules).val.obj U)
    (hxy : x.1 = y.1) : HEq x y := by
  subst hmk
  exact heq_of_eq (Subtype.ext hxy)

/-- The action of the Rees algebra on the ideal-power multiples, on sections over an open:
a section of `ℐⁿF` and a section of `ℐⁱ` multiply to a section of `ℐⁿ⁺ⁱF`, biadditively. -/
public def reesMultipleSmul {X : Scheme.{u}} (I : X.IdealSheafData)
    (F : SheafOfModules.{u} X.ringCatSheaf) (n i : ℤ) (U : (Opens X)ᵒᵖ) :
    ((reesMultiple I n F).toSheafOfModules).val.obj U →+
      (reesPiece I i).val.obj U →+
        ((reesMultiple I (n + i) F).toSheafOfModules).val.obj U where
  toFun x :=
    { toFun r := ⟨reesPieceAmbient I i U.unop r • x.1,
        reesPiece_smul_mem_reesMultiple I n i F U.unop r x.1 x.2⟩
      map_zero' := by
        apply Subtype.ext
        change reesPieceAmbient I i U.unop 0 • x.1 = 0
        rw [reesPieceAmbient_zero, zero_smul]
      map_add' := by
        intro r r'
        apply Subtype.ext
        change reesPieceAmbient I i U.unop (r + r') • x.1 =
          reesPieceAmbient I i U.unop r • x.1 + reesPieceAmbient I i U.unop r' • x.1
        rw [reesPieceAmbient_add, add_smul] }
  map_zero' := by
    apply AddMonoidHom.ext
    intro r
    apply Subtype.ext
    change reesPieceAmbient I i U.unop r • (0 : F.val.obj U) = 0
    rw [smul_zero]
  map_add' := by
    intro x y
    apply AddMonoidHom.ext
    intro r
    apply Subtype.ext
    change reesPieceAmbient I i U.unop r • (x.1 + y.1) =
      reesPieceAmbient I i U.unop r • x.1 + reesPieceAmbient I i U.unop r • y.1
    rw [smul_add]

/-- The action of the Rees algebra on the ideal-power multiples commutes with restriction. -/
public lemma reesMultipleSmul_restr {X : Scheme.{u}} (I : X.IdealSheafData)
    (F : SheafOfModules.{u} X.ringCatSheaf) (n i : ℤ) {U V : X.Opens} (h : V ≤ U)
    (x : ((reesMultiple I n F).toSheafOfModules).val.obj (op U))
    (y : (reesPiece I i).val.obj (op U)) :
    Stacks.restr ((reesMultiple I (n + i) F).toSheafOfModules).val (homOfLE h).op
        (reesMultipleSmul I F n i (op U) x y) =
      reesMultipleSmul I F n i (op V)
        (Stacks.restr ((reesMultiple I n F).toSheafOfModules).val (homOfLE h).op x)
        (Stacks.restr (reesPiece I i).val (homOfLE h).op y) := by
  apply Subtype.ext
  exact restr_reesPieceAmbient_smul I i F h y x.1

/-- **The graded module `⨁_{n ≥ 0} ℐⁿF` over the Rees algebra `⨁_{n ≥ 0} ℐⁿ`.** -/
public def reesGradedModule {X : Scheme.{u}} (I : X.IdealSheafData)
    (F : SheafOfModules.{u} X.ringCatSheaf) :
    SheafOfModules.GradedModule (reesGradedAlgebra I) where
  piece n := (reesMultiple I n F).toSheafOfModules
  smul n i U := reesMultipleSmul I F n i U
  smul_smul_left n i U r x y := by
    apply Subtype.ext
    change reesPieceAmbient I i U.unop y • (r • x.1) =
      r • (reesPieceAmbient I i U.unop y • x.1)
    exact smul_comm_reesPieceAmbient F r _ x.1
  smul_smul_right n i U r x y := by
    apply Subtype.ext
    have hy := reesPieceAmbient_smul I i U.unop r y
    change reesPieceAmbient I i U.unop (r • y) • x.1 =
      r • (reesPieceAmbient I i U.unop y • x.1)
    refine (congrArg (fun a : Γ(X, U.unop) => a • x.1) hy).trans ?_
    exact (smul_smul (show Γ(X, U.unop) from r) (reesPieceAmbient I i U.unop y) x.1).symm
  smul_naturality n i {U V} f x y :=
    reesMultipleSmul_restr I F n i (U := U.unop) (V := V.unop) (leOfHom f.unop) x y
  smul_mul n i j U x y z := by
    refine heq_reesMultiple_section I F (add_assoc n i j) _ _ ?_
    have hyz := reesMultiplication_ambient I i j U.unop y z
    change reesPieceAmbient I j U.unop z • (reesPieceAmbient I i U.unop y • x.1) =
      reesPieceAmbient I (i + j) U.unop ((reesMultiplication I i j).app U y z) • x.1
    refine (smul_smul _ _ x.1).trans ?_
    refine (congrArg (fun a : Γ(X, U.unop) => a • x.1) (mul_comm _ _)).trans ?_
    exact congrArg (fun a : Γ(X, U.unop) => a • x.1) hyz.symm
  smul_one n U x := by
    refine heq_reesMultiple_section I F (add_zero n) _ _ ?_
    have h1 := reesUnit_ambient I U
    change reesPieceAmbient I 0 U.unop ((reesUnit I).eval U) • x.1 = x.1
    exact (congrArg (fun a : Γ(X, U.unop) => a • x.1) h1).trans (one_smul _ x.1)

/-- Multiplication by a global section of `ℐⁱ`, as a morphism of sheaves `ℐⁿF ⟶ ℐⁿ⁺ⁱF`. -/
public def reesMultipleSmulHom {X : Scheme.{u}} (I : X.IdealSheafData)
    (F : SheafOfModules.{u} X.ringCatSheaf) (n i : ℤ) (r : (reesPiece I i).val.sections) :
    (reesMultiple I n F).toSheafOfModules ⟶ (reesMultiple I (n + i) F).toSheafOfModules :=
  ⟨PresheafOfModules.homMk
    { app U := AddCommGrpCat.ofHom ((reesMultipleSmul I F n i U).flip (r.eval U))
      naturality := by
        intro U V f
        apply AddCommGrpCat.hom_ext
        ext x
        exact (congrArg (fun z => reesMultipleSmul I F n i V
              (Stacks.restr ((reesMultiple I n F).toSheafOfModules).val f x) z)
            (Stacks.restr_sections (reesPiece I i).val r f).symm).trans
          (reesMultipleSmul_restr I F n i (U := U.unop) (V := V.unop)
            (leOfHom f.unop) x (r.eval U)).symm }
    (by
      intro U a x
      apply Subtype.ext
      change reesPieceAmbient I i U.unop (r.eval U) • (a • x.1) =
        a • (reesPieceAmbient I i U.unop (r.eval U) • x.1)
      exact smul_comm_reesPieceAmbient F a _ x.1)⟩

/-- Multiplication by a global section of `ℐⁱ` is, on sections, multiplication by its image in
`Γ(X, U)`. -/
public lemma reesMultipleSmulHom_apply {X : Scheme.{u}} (I : X.IdealSheafData)
    (F : SheafOfModules.{u} X.ringCatSheaf) (n i : ℤ) (r : (reesPiece I i).val.sections)
    (U : (Opens X)ᵒᵖ) (x : ((reesMultiple I n F).toSheafOfModules).val.obj U) :
    (((reesMultipleSmulHom I F n i r).val.app U) x).1 =
      reesPieceAmbient I i U.unop (r.eval U) • x.1 :=
  rfl

/-- `ℐᵐF ⊆ ℐⁿF` whenever `0 ≤ n ≤ m`. -/
public lemma reesMultiple_le_reesMultiple_of_le {X : Scheme.{u}} (I : X.IdealSheafData)
    (F : SheafOfModules.{u} X.ringCatSheaf) {n m : ℤ} (hn : 0 ≤ n) (hnm : n ≤ m) :
    reesMultiple I m F ≤ reesMultiple I n F := by
  have hm : (0 : ℤ) ≤ m := hn.trans hnm
  refine (reesMultiple_le_iff I m F _).2 fun U r s x hx => ?_
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVU⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hx U.2
  refine ⟨V, hVU, hxV, ?_⟩
  have hmemm : reesPieceAmbient I m V (Stacks.restr (reesPiece I m).val (homOfLE hVU).op r) ∈
      I.ideal ⟨V, hV⟩ ^ n.toNat :=
    Ideal.pow_le_pow_right (by omega) (reesPieceAmbient_mem_affine I m hm ⟨V, hV⟩ _)
  set q := (reesPieceAffineEquiv I n hn ⟨V, hV⟩).symm
    ⟨reesPieceAmbient I m V (Stacks.restr (reesPiece I m).val (homOfLE hVU).op r), hmemm⟩
    with hq
  have hqamb : reesPieceAmbient I n V q =
      reesPieceAmbient I m V (Stacks.restr (reesPiece I m).val (homOfLE hVU).op r) := by
    rw [← reesPieceAffineEquiv_coe I n hn ⟨V, hV⟩ q, hq, AddEquiv.apply_symm_apply]
  have hgen := smul_mem_reesMultipleSpan I n F V q (Stacks.restr F.val (homOfLE hVU).op s)
  rw [hqamb] at hgen
  rw [restr_reesPieceAmbient_smul I m F hVU]
  exact hgen

/-- The degree-zero piece of `⨁ₙ ℐⁿF` is the whole of `F`. -/
public lemma reesMultiple_zero {X : Scheme.{u}} (I : X.IdealSheafData)
    (F : SheafOfModules.{u} X.ringCatSheaf) : reesMultiple I 0 F = ⊤ := by
  refine le_antisymm le_top ?_
  intro U s _
  have h := smul_mem_reesMultiple I 0 F U.unop ((reesUnit I).eval U) s
  have he : reesPieceAmbient I 0 U.unop ((reesUnit I).eval U) • s = s :=
    (congrArg (fun a : Γ(X, U.unop) => a • s) (reesUnit_ambient I U)).trans (one_smul _ s)
  exact Eq.mpr (congrArg (· ∈ (reesMultiple I 0 F).toSubmodule.obj U) he.symm) h

end Stacks.Blowup

