/-!
# The exceptional divisor of the blowup of a regular surface is irreducible and regular

Let `(A, 𝔪, κ)` be a regular local ring of dimension two and let `X → Spec A` be the blowup of
`Spec A` in its closed point. Its exceptional divisor `E` is irreducible, and is a regular
scheme.

## Main results

* `Stacks.BlowUpChartCover.isIrreducible_supportSet_inter_affineOpen`: the support of an ideal
  sheaf is irreducible over an affine open on which the quotient of the sections is a domain.
* `Stacks.BlowUpChartCover.mem_supportSet_exceptionalIdeal_chart`: a point of the standard chart
  at `a` whose prime contains the image of `a` lies in the support of the exceptional ideal.
* `Stacks.BlowUpChartCover.mem_chartOpen_chart_of_notMem`: a point of the chart at `a` lies on
  the chart at `b` as soon as the fraction `b / a` avoids its prime.
* `AlgebraicGeometry.isIrreducible_supportSet_exceptionalIdeal_of_two_charts`: two sections of
  the centre over an affine open covering the base, each cutting out a prime on its own chart and
  avoiding the other's, give an irreducible exceptional divisor.
* `AlgebraicGeometry.isIrreducible_supportSet_exceptionalIdeal_maximalIdeal` and
  `AlgebraicGeometry.irreducibleSpace_exceptionalDivisor_maximalIdeal`: the exceptional divisor
  of the blowup of a two-dimensional regular local ring at its closed point is irreducible.
* `AlgebraicGeometry.isRegular_exceptionalDivisor_of_charts`,
  `AlgebraicGeometry.isRegular_exceptionalDivisor_of_span_pair` and
  `AlgebraicGeometry.isRegular_exceptionalDivisor_maximalIdeal`: that exceptional divisor is a
  regular scheme.

## Implementation notes

`AlgebraicGeometry.blowupChartι` and `Stacks.BlowUpChartCover.chart` are two syntactically
distinct definitions of the same morphism: the range and ideal lemmas are stated for the second,
the covering statement `AlgebraicGeometry.exists_mem_range_blowupChartι` for the first.
`Stacks.BlowUpChartCover.chart_eq_blowupChartι` identifies them, by `rfl`.

The ring-level results on the chart are stated for `affineBlowupAlgebraAway`, the subalgebra of
the away-localization generated by the fractions written with `IsLocalization.Away.invSelf`,
while the charts of the blowup are built from `affineBlowupAlgebra`, which writes them with
`IsLocalization.mk'`. The two are the same subalgebra
(`affineBlowupAlgebraAway_eq_affineBlowupAlgebra`).

## References

* [Stacks Project, Tag 0AGR](https://stacks.math.columbia.edu/tag/0AGR)
* [Stacks Project, Tag 0AGQ](https://stacks.math.columbia.edu/tag/0AGQ)
* [Stacks Project, Tag 0804](https://stacks.math.columbia.edu/tag/0804)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite IsLocalRing TopologicalSpace

universe u

namespace Stacks.BlowUpChartCover

/-! ### The two presentations of the standard chart -/

variable {X : Scheme.{u}} (I : X.IdealSheafData) (V : X.affineOpens) (a : I.ideal V)

/-- The two presentations of the standard affine chart of a blowup agree:
`AlgebraicGeometry.blowupChartι` and `Stacks.BlowUpChartCover.chart` are the same composite of
the identification of [Stacks, Tag 0804], the inclusion of the standard open of the local Rees
projective spectrum, and the relative-`Proj` chart over `V`. -/
theorem chart_eq_blowupChartι : chart I V a = blowupChartι I V a := rfl

/-! ### The support of an ideal sheaf over an affine open -/

/-- The support of an ideal sheaf is irreducible over an affine open whose quotient of sections is
a domain. -/
theorem isIrreducible_supportSet_inter_affineOpen {Y : Scheme.{u}} (J : Y.IdealSheafData)
    (W : Y.affineOpens) (hdom : IsDomain (Γ(Y, W.1) ⧸ J.ideal W)) :
    IsIrreducible (J.supportSet ∩ (W.1 : Set Y)) := by
  have : IsDomain (J.subschemeCover.X W) :=
    inferInstanceAs (IsDomain (Γ(Y, W.1) ⧸ J.ideal W))
  have hA : Set.range (J.subschemeCover.f W).base = (J.subschemeι ⁻¹ᵁ W.1 : Set J.subscheme) :=
    congrArg (fun O : J.subscheme.Opens => (O : Set J.subscheme))
      (J.opensRange_subschemeCover_map W)
  have hrange : Set.range (J.subschemeCover.f W ≫ J.subschemeι).base =
      J.supportSet ∩ (W.1 : Set Y) := by
    have hcomp : Set.range (J.subschemeCover.f W ≫ J.subschemeι).base =
        J.subschemeι.base '' Set.range (J.subschemeCover.f W).base := by
      rw [← Set.range_comp]
      rfl
    rw [hcomp, hA, Scheme.Hom.coe_preimage, Set.image_preimage_eq_inter_range, Set.inter_comm]
    congr 1
    exact J.range_subschemeι
  rw [← hrange, ← Set.image_univ]
  exact (IrreducibleSpace.isIrreducible_univ _).image _
    (Continuous.continuousOn (J.subschemeCover.f W ≫ J.subschemeι).base.hom.continuous)

/-- The ideal generated by the image of `a` in the chart ring corresponds to the exceptional ideal
under the identification of the sections over the chart. -/
private theorem span_algebraMap_eq_map_ideal_exceptionalIdeal :
    Ideal.span ({algebraMap Γ(X, V.1) (chartRing I V a) (a : Γ(X, V.1))} :
        Set (chartRing I V a)) =
      Ideal.map (chartΓIso I V a).commRingCatIsoToRingEquiv
        ((exceptionalIdeal I).ideal (chartOpen I V a)) := by
  rw [ideal_exceptionalIdeal_eq_span_chartGenerator, Ideal.map_span, Set.image_singleton]
  exact congrArg (fun z => Ideal.span {z}) (chartΓIso_hom_chartGenerator I V a).symm

/-- If the quotient of the affine blowup algebra `Γ(X, V)[I/a]` by the ideal generated by the image
of `a` is a domain, so is the quotient of the sections of the blowup over the chart by the
exceptional ideal there. -/
theorem isDomain_quotient_ideal_exceptionalIdeal_chartOpen
    (h : IsDomain (chartRing I V a ⧸
      Ideal.span ({algebraMap Γ(X, V.1) (chartRing I V a) (a : Γ(X, V.1))} :
        Set (chartRing I V a)))) :
    IsDomain (Γ(blowUp I, (chartOpen I V a).1) ⧸
      (exceptionalIdeal I).ideal (chartOpen I V a)) := by
  have := h
  exact (Ideal.quotientEquiv _ _ (chartΓIso I V a).commRingCatIsoToRingEquiv
    (span_algebraMap_eq_map_ideal_exceptionalIdeal I V a)).toMulEquiv.isDomain _

/-- The exceptional ideal is prime on the standard chart at `a` if the quotient of the affine
blowup algebra `Γ(X, V)[I/a]` by the ideal generated by the image of `a` is a domain. -/
theorem isPrime_ideal_exceptionalIdeal_chartOpen
    (h : IsDomain (chartRing I V a ⧸
      Ideal.span ({algebraMap Γ(X, V.1) (chartRing I V a) (a : Γ(X, V.1))} :
        Set (chartRing I V a)))) :
    ((exceptionalIdeal I).ideal (chartOpen I V a)).IsPrime :=
  (Ideal.Quotient.isDomain_iff_prime _).mp
    (isDomain_quotient_ideal_exceptionalIdeal_chartOpen I V a h)

/-- If the quotient of the affine blowup algebra `Γ(X, V)[I/a]` by the ideal generated by the image
of `a` is a regular ring, so is the quotient of the sections of the blowup over the chart by the
exceptional ideal there. -/
theorem isRegularRing_quotient_ideal_exceptionalIdeal_chartOpen
    (h : IsRegularRing (chartRing I V a ⧸
      Ideal.span ({algebraMap Γ(X, V.1) (chartRing I V a) (a : Γ(X, V.1))} :
        Set (chartRing I V a)))) :
    IsRegularRing (Γ(blowUp I, (chartOpen I V a).1) ⧸
      (exceptionalIdeal I).ideal (chartOpen I V a)) := by
  have := h
  exact IsRegularRing.of_ringEquiv (Ideal.quotientEquiv _ _
    (chartΓIso I V a).commRingCatIsoToRingEquiv
    (span_algebraMap_eq_map_ideal_exceptionalIdeal I V a)).symm

/-! ### A point of the chart in the support of the exceptional ideal -/

/-- A point of the standard chart at `a` whose prime contains the image of `a` lies in the support
of the exceptional ideal. -/
theorem mem_supportSet_exceptionalIdeal_chart (q : PrimeSpectrum (chartRing I V a))
    (hq : algebraMap Γ(X, V.1) (chartRing I V a) (a : Γ(X, V.1)) ∈ q.asIdeal) :
    chart I V a q ∈ (exceptionalIdeal I).supportSet := by
  have hmem : chart I V a q ∈ (chartOpen I V a).1 := ⟨q, rfl⟩
  rw [Scheme.IdealSheafData.mem_supportSet_iff_of_mem hmem]
  have hpt : chart I V a q =
      (chartOpen I V a).2.fromSpec (Spec.map (chartΓIso I V a).hom q) := by
    conv_lhs => rw [← specMap_chartΓIso_hom_fromSpec I V a]
    rfl
  rw [hpt]
  have hle : (exceptionalIdeal I).ideal (chartOpen I V a) ≤
      Ideal.comap (chartΓIso I V a).hom.hom q.asIdeal := by
    rw [← Ideal.map_le_iff_le_comap, ideal_exceptionalIdeal_eq_span_chartGenerator,
      Ideal.map_span, Set.image_singleton, chartΓIso_hom_chartGenerator I V a,
      Ideal.span_le, Set.singleton_subset_iff]
    exact hq
  have hzl : Spec.map (chartΓIso I V a).hom q ∈
      PrimeSpectrum.zeroLocus
        ((exceptionalIdeal I).ideal (chartOpen I V a) : Set (Γ(blowUp I, (chartOpen I V a).1))) :=
    hle
  exact (IsAffineOpen.fromSpec_preimage_zeroLocus (chartOpen I V a).2 _).ge hzl

/-! ### A point of the chart at `a` on the chart at `b` -/

/-- A point of the standard chart at `a` lies on the standard chart at `b` as soon as the fraction
`b / a` of the affine blowup algebra avoids its prime. -/
theorem mem_chartOpen_chart_of_notMem (b : I.ideal V) (q : PrimeSpectrum (chartRing I V a))
    (hq : affineBlowupAlgebra.fraction (S := Localization.Away (a : Γ(X, V.1)))
        (I.ideal V) (a : Γ(X, V.1)) 1
        ⟨(b : Γ(X, V.1)), by simp⟩ ∉ q.asIdeal) :
    chart I V a q ∈ (chartOpen I V b).1 := by
  let := (reesSituation I).sectionRingGradedRing V.1
  let := (reesSituation I).sectionRingGradingGradedRing V.1
  set z : Spec (.of (HomogeneousLocalization.Away
      ((reesSituation I).sectionRingGrading V.1) (reesDegreeOne I V a).1)) :=
    Spec.map (CommRingCat.ofHom (reesToAffineBlowupEquiv I V a).toRingHom) q with hzdef
  have hpt : chart I V a q =
      Stacks.RelativeProj.Situation.relativeProjChart (reesSituation I) V
        (Proj.awayι ((reesSituation I).sectionRingGrading V.1) (reesDegreeOne I V a).1
          (reesDegreeOne I V a).2 Nat.one_pos z) := by
    conv_lhs => rw [Stacks.Blowup.chart_eq_specMap_awayι I V a]
    rfl
  rw [hpt]
  change Proj.awayι ((reesSituation I).sectionRingGrading V.1) (reesDegreeOne I V a).1
      (reesDegreeOne I V a).2 Nat.one_pos z ∈
    (Stacks.RelativeProj.Situation.relativeProjChart (reesSituation I) V ⁻¹ᵁ
      (chartOpen I V b).1)
  rw [preimage_relativeProjChart_chartOpen I V b]
  change z ∈ (Proj.awayι ((reesSituation I).sectionRingGrading V.1) (reesDegreeOne I V a).1
      (reesDegreeOne I V a).2 Nat.one_pos ⁻¹ᵁ
    Proj.basicOpen ((reesSituation I).sectionRingGrading V.1) (reesDegreeOne I V b).1)
  rw [Proj.awayι_preimage_basicOpen ((reesSituation I).sectionRingGrading V.1)
    (reesDegreeOne I V a).2 Nat.one_pos (reesDegreeOne I V b).2 Nat.one_pos]
  have hlog : HomogeneousLocalization.Away.isLocalizationElem
        (𝒜 := (reesSituation I).sectionRingGrading V.1)
        (reesDegreeOne I V a).2 (reesDegreeOne I V b).2 =
      HomogeneousLocalization.Away.mk ((reesSituation I).sectionRingGrading V.1)
        (reesDegreeOne I V a).2 1 (reesDegreeOne I V b).1
          (by simp) := by
    apply HomogeneousLocalization.val_injective
    rw [HomogeneousLocalization.Away.isLocalizationElem, HomogeneousLocalization.Away.val_mk,
      HomogeneousLocalization.Away.val_mk, pow_one]
  have heval : reesToAffineBlowupEquiv I V a
      (HomogeneousLocalization.Away.isLocalizationElem
        (𝒜 := (reesSituation I).sectionRingGrading V.1)
        (reesDegreeOne I V a).2 (reesDegreeOne I V b).2) =
      affineBlowupAlgebra.fraction (S := Localization.Away (a : Γ(X, V.1)))
        (I.ideal V) (a : Γ(X, V.1)) 1 ⟨(b : Γ(X, V.1)), by simp⟩ := by
    rw [hlog, Stacks.Blowup.reesToAffineBlowupEquiv_awayMk I V a 1 (reesDegreeOne I V b).1
      (reesDegreeOne I V b).2]
    exact congrArg (affineBlowupAlgebra.fraction (S := Localization.Away (a : Γ(X, V.1)))
      (I.ideal V) (a : Γ(X, V.1)) 1) (Subtype.ext (reesToBase_degreeOne I V b))
  intro hmem
  exact hq (heval ▸ hmem)

end Stacks.BlowUpChartCover

namespace Stacks.Blowup

/-! ### The ring-level inputs in the model the charts use -/

/-- The image of the ideal generated by the structure image of `r` under an isomorphism of
`R`-algebras is the ideal generated by the structure image of `r`. -/
private lemma map_span_algebraMap {R : Type u} [CommRing R] {B B' : Type u} [CommRing B]
    [CommRing B'] [Algebra R B] [Algebra R B'] (e : B ≃ₐ[R] B') (r : R) :
    Ideal.map e (Ideal.span ({algebraMap R B r} : Set B)) =
      Ideal.span ({algebraMap R B' r} : Set B') := by
  rw [Ideal.map_span, Set.image_singleton]
  exact congrArg (fun z => Ideal.span {z}) (e.commutes r)

section Model

variable {R : Type u} [CommRing R] [IsRegularLocalRing R]

/-- The two models of the affine blowup algebra inside the localization away from the
denominator, as an isomorphism of `R`-algebras. -/
private def awayChartEquiv (J : Ideal R) (a : R) :
    affineBlowupAlgebraAway J a ≃ₐ[R] affineBlowupAlgebra J a (Localization.Away a) :=
  Subalgebra.equivOfEq _ _ (affineBlowupAlgebraAway_eq_affineBlowupAlgebra J a)

variable (x y : R)

/-- The denominator generates a prime ideal of the affine blowup chart, in the model
`Stacks.BlowUpChartCover.chartRing` uses, for the blowup in any ideal equal to the maximal one. -/
private lemma isPrime_span_algebraMap_chartModel (J : Ideal R) (hdim : ringKrullDim R = 2)
    (hxy : Ideal.span ({x, y} : Set R) = maximalIdeal R) (hJ : J = maximalIdeal R) :
    (Ideal.span ({algebraMap R (affineBlowupAlgebra J x (Localization.Away x)) x} :
      Set (affineBlowupAlgebra J x (Localization.Away x)))).IsPrime := by
  subst hJ
  have hp := isPrime_span_algebraMap_affineBlowupAlgebraAway x y hdim hxy
  rw [← map_span_algebraMap (awayChartEquiv (maximalIdeal R) x) x]
  exact Ideal.map_isPrime_of_equiv _

/-- Modulo its denominator the affine blowup chart is a regular ring, in the model
`Stacks.BlowUpChartCover.chartRing` uses. -/
private lemma isRegularRing_quotient_chartModel (J : Ideal R) (hdim : ringKrullDim R = 2)
    (hxy : Ideal.span ({x, y} : Set R) = maximalIdeal R) (hJ : J = maximalIdeal R) :
    IsRegularRing (affineBlowupAlgebra J x (Localization.Away x) ⧸
      Ideal.span ({algebraMap R (affineBlowupAlgebra J x (Localization.Away x)) x} :
        Set (affineBlowupAlgebra J x (Localization.Away x)))) := by
  subst hJ
  have := isRegularRing_quotient_affineBlowupAlgebraAway x y hdim hxy
  exact IsRegularRing.of_ringEquiv (Ideal.quotientEquiv _ _
    (awayChartEquiv (maximalIdeal R) x).toRingEquiv
    (map_span_algebraMap (awayChartEquiv (maximalIdeal R) x) x).symm)

/-- The fraction `y / x` is not in the exceptional ideal of the chart at `x`, in the model
`Stacks.BlowUpChartCover.chartRing` uses. -/
private lemma notMem_span_algebraMap_chartModel (J : Ideal R) (hdim : ringKrullDim R = 2)
    (hxy : Ideal.span ({x, y} : Set R) = maximalIdeal R) (hJ : J = maximalIdeal R)
    (u : affineBlowupAlgebra J x (Localization.Away x))
    (hu : algebraMap R (affineBlowupAlgebra J x (Localization.Away x)) x * u =
      algebraMap R (affineBlowupAlgebra J x (Localization.Away x)) y) :
    u ∉ Ideal.span ({algebraMap R (affineBlowupAlgebra J x (Localization.Away x)) x} :
      Set (affineBlowupAlgebra J x (Localization.Away x))) := by
  subst hJ
  set e := awayChartEquiv (maximalIdeal R) x with hedef
  have hu' : algebraMap R (affineBlowupAlgebraAway (maximalIdeal R) x) x * e.symm u =
      algebraMap R (affineBlowupAlgebraAway (maximalIdeal R) x) y := by
    rw [← e.symm.commutes x, ← map_mul, hu, e.symm.commutes y]
  have h0 := notMem_span_algebraMap_of_algebraMap_mul_eq x y hdim hxy (e.symm u) hu'
  intro hmem
  refine h0 ?_
  have himg : e.symm u ∈ Ideal.map e.symm
      (Ideal.span ({algebraMap R (affineBlowupAlgebra (maximalIdeal R) x
        (Localization.Away x)) x} : Set _)) :=
    Ideal.mem_map_of_mem _ hmem
  rwa [map_span_algebraMap e.symm x] at himg

end Model

end Stacks.Blowup

namespace AlgebraicGeometry

open Stacks.BlowUpChartCover

/-! ### Gluing the two charts of the exceptional divisor -/

/-- Two sections of the centre whose span contains it give two charts covering the blowup, as an
equality of opens. -/
public theorem iSup_chartOpen_pair_eq_top {X : Scheme.{u}} (I : X.IdealSheafData)
    (V : X.affineOpens) (hVtop : ∀ z : X, z ∈ V.1) (a b : I.ideal V)
    (hspan : (I.ideal V : Ideal Γ(X, V.1)) ≤
      Ideal.span ({(a : Γ(X, V.1)), (b : Γ(X, V.1))} : Set Γ(X, V.1))) :
    ⨆ t : Bool, (chartOpen I V (bif t then b else a)).1 = ⊤ := by
  have hrange : Set.range (fun t : Bool => ((bif t then b else a : I.ideal V) : Γ(X, V.1))) =
      ({(a : Γ(X, V.1)), (b : Γ(X, V.1))} : Set Γ(X, V.1)) := by
    refine Set.ext fun w => ?_
    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
    refine ⟨?_, ?_⟩
    · rintro ⟨t, rfl⟩
      cases t
      · exact Or.inl rfl
      · exact Or.inr rfl
    · rintro (rfl | rfl)
      · exact ⟨false, rfl⟩
      · exact ⟨true, rfl⟩
  have hspan' : (I.ideal V : Ideal Γ(X, V.1)) ≤
      Ideal.span (Set.range
        (fun t : Bool => ((bif t then b else a : I.ideal V) : Γ(X, V.1)))) := by
    rw [hrange]
    exact hspan
  refine eq_top_iff.mpr fun z _ => TopologicalSpace.Opens.mem_iSup.mpr ?_
  obtain ⟨t, w, hw⟩ := exists_mem_range_blowupChartι I V
    (fun t : Bool => ((bif t then b else a : I.ideal V) : Γ(X, V.1)))
    (fun t => (bif t then b else a : I.ideal V).2) hspan' z (hVtop _)
  exact ⟨t, w, hw⟩

/-- Let `V` be an affine open of `X` containing every point, and `a, b` two sections of the centre
on `V` that generate an ideal containing `I(V)`. If on the chart at each of them the image of that
section generates a prime, and the fraction of the other by it avoids that prime, then the
exceptional ideal of the blowup has irreducible support. -/
public theorem isIrreducible_supportSet_exceptionalIdeal_of_two_charts {X : Scheme.{u}}
    (I : X.IdealSheafData) (V : X.affineOpens) (hVtop : ∀ z : X, z ∈ V.1) (a b : I.ideal V)
    (hspan : (I.ideal V : Ideal Γ(X, V.1)) ≤
      Ideal.span ({(a : Γ(X, V.1)), (b : Γ(X, V.1))} : Set Γ(X, V.1)))
    (hprimea : (Ideal.span ({algebraMap Γ(X, V.1) (chartRing I V a) (a : Γ(X, V.1))} :
      Set (chartRing I V a))).IsPrime)
    (hprimeb : (Ideal.span ({algebraMap Γ(X, V.1) (chartRing I V b) (b : Γ(X, V.1))} :
      Set (chartRing I V b))).IsPrime)
    (hfraca : affineBlowupAlgebra.fraction (S := Localization.Away (a : Γ(X, V.1)))
        (I.ideal V) (a : Γ(X, V.1)) 1 ⟨(b : Γ(X, V.1)), by simp⟩ ∉
      Ideal.span ({algebraMap Γ(X, V.1) (chartRing I V a) (a : Γ(X, V.1))} :
        Set (chartRing I V a)))
    (hfracb : affineBlowupAlgebra.fraction (S := Localization.Away (b : Γ(X, V.1)))
        (I.ideal V) (b : Γ(X, V.1)) 1 ⟨(a : Γ(X, V.1)), by simp⟩ ∉
      Ideal.span ({algebraMap Γ(X, V.1) (chartRing I V b) (b : Γ(X, V.1))} :
        Set (chartRing I V b))) :
    IsIrreducible ((exceptionalIdeal I).supportSet) := by
  classical
  have hpoint : ∀ (c d : I.ideal V)
      (hp : (Ideal.span ({algebraMap Γ(X, V.1) (chartRing I V c) (c : Γ(X, V.1))} :
        Set (chartRing I V c))).IsPrime),
      affineBlowupAlgebra.fraction (S := Localization.Away (c : Γ(X, V.1)))
          (I.ideal V) (c : Γ(X, V.1)) 1 ⟨(d : Γ(X, V.1)), by simp⟩ ∉
        Ideal.span ({algebraMap Γ(X, V.1) (chartRing I V c) (c : Γ(X, V.1))} :
          Set (chartRing I V c)) →
      ∃ z : blowUp I, z ∈ (exceptionalIdeal I).supportSet ∧
        z ∈ (chartOpen I V c).1 ∧ z ∈ (chartOpen I V d).1 := by
    intro c d hp hfrac
    exact ⟨chart I V c ⟨_, hp⟩,
      mem_supportSet_exceptionalIdeal_chart I V c ⟨_, hp⟩ (Ideal.mem_span_singleton_self _),
      ⟨_, rfl⟩, mem_chartOpen_chart_of_notMem I V c d ⟨_, hp⟩ hfrac⟩
  refine isIrreducible_of_isOpen_cover ?_
    (fun t : Bool => ((chartOpen I V (bif t then b else a)).1 : Set (blowUp I)))
    (fun t => (chartOpen I V (bif t then b else a)).1.2) ?_ ?_ ?_
  · obtain ⟨z, hz, -, -⟩ := hpoint a b hprimea hfraca
    exact ⟨z, hz⟩
  · intro z _
    exact Set.mem_iUnion.mpr (TopologicalSpace.Opens.mem_iSup.mp
      ((iSup_chartOpen_pair_eq_top I V hVtop a b hspan).ge
        (show z ∈ (⊤ : (blowUp I).Opens) from trivial)))
  · intro t _
    cases t
    · exact isIrreducible_supportSet_inter_affineOpen (exceptionalIdeal I) (chartOpen I V a)
        (isDomain_quotient_ideal_exceptionalIdeal_chartOpen I V a
          ((Ideal.Quotient.isDomain_iff_prime _).mpr hprimea))
    · exact isIrreducible_supportSet_inter_affineOpen (exceptionalIdeal I) (chartOpen I V b)
        (isDomain_quotient_ideal_exceptionalIdeal_chartOpen I V b
          ((Ideal.Quotient.isDomain_iff_prime _).mpr hprimeb))
  · intro s t hs _
    cases s <;> cases t
    · obtain ⟨z, hz⟩ := hs
      exact ⟨z, hz, hz.2⟩
    · obtain ⟨z, hz, h1, h2⟩ := hpoint a b hprimea hfraca
      exact ⟨z, ⟨hz, h1⟩, h2⟩
    · obtain ⟨z, hz, h1, h2⟩ := hpoint b a hprimeb hfracb
      exact ⟨z, ⟨hz, h1⟩, h2⟩
    · obtain ⟨z, hz⟩ := hs
      exact ⟨z, hz, hz.2⟩

/-! ### The exceptional ideal is radical -/

/-- The exceptional ideal is radical when it is prime on two covering charts. -/
public theorem radical_exceptionalIdeal_eq_self_of_two_charts {X : Scheme.{u}}
    (I : X.IdealSheafData) (V : X.affineOpens) (hVtop : ∀ z : X, z ∈ V.1) (a b : I.ideal V)
    (hspan : (I.ideal V : Ideal Γ(X, V.1)) ≤
      Ideal.span ({(a : Γ(X, V.1)), (b : Γ(X, V.1))} : Set Γ(X, V.1)))
    (hpa : ((exceptionalIdeal I).ideal (chartOpen I V a)).IsPrime)
    (hpb : ((exceptionalIdeal I).ideal (chartOpen I V b)).IsPrime) :
    (exceptionalIdeal I).radical = exceptionalIdeal I := by
  refine le_antisymm (Scheme.IdealSheafData.le_of_iSup_eq_top
    (fun t : Bool => chartOpen I V (bif t then b else a))
    (iSup_chartOpen_pair_eq_top I V hVtop a b hspan) ?_)
    (Scheme.IdealSheafData.le_radical _)
  intro t
  simp only [Scheme.IdealSheafData.radical_ideal]
  cases t
  · exact le_of_eq hpa.radical
  · exact le_of_eq hpb.radical

/-! ### The blowup of a regular local surface at its closed point -/

/-- The two generators of the maximal ideal, read as sections of the centre, together with the
inclusion of the centre in the ideal they span. -/
private lemma span_pair_mem {X : Scheme.{u}} (I : X.IdealSheafData) (V : X.affineOpens)
    [IsRegularLocalRing Γ(X, V.1)] (x y : Γ(X, V.1))
    (hIV : I.ideal V = maximalIdeal Γ(X, V.1))
    (hxy : Ideal.span ({x, y} : Set Γ(X, V.1)) = maximalIdeal Γ(X, V.1)) :
    ∃ (_ : x ∈ I.ideal V) (_ : y ∈ I.ideal V),
      (I.ideal V : Ideal Γ(X, V.1)) ≤ Ideal.span ({x, y} : Set Γ(X, V.1)) :=
  ⟨by rw [hIV, ← hxy]; exact Ideal.subset_span (Set.mem_insert _ _),
    by rw [hIV, ← hxy]; exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl),
    le_of_eq (by rw [hIV, ← hxy])⟩

/-- The exceptional ideal of the blowup of an affine regular surface at its closed point is
radical. -/
public theorem radical_exceptionalIdeal_eq_self_of_span_pair {X : Scheme.{u}}
    (I : X.IdealSheafData) (V : X.affineOpens) (hVtop : ∀ z : X, z ∈ V.1)
    [IsRegularLocalRing Γ(X, V.1)] (hdim : ringKrullDim Γ(X, V.1) = 2) (x y : Γ(X, V.1))
    (hIV : I.ideal V = maximalIdeal Γ(X, V.1))
    (hxy : Ideal.span ({x, y} : Set Γ(X, V.1)) = maximalIdeal Γ(X, V.1)) :
    (exceptionalIdeal I).radical = exceptionalIdeal I := by
  have hyx : Ideal.span ({y, x} : Set Γ(X, V.1)) = maximalIdeal Γ(X, V.1) := by
    rwa [Set.pair_comm]
  obtain ⟨hx, hy, hspan⟩ := span_pair_mem I V x y hIV hxy
  refine radical_exceptionalIdeal_eq_self_of_two_charts I V hVtop ⟨x, hx⟩ ⟨y, hy⟩ hspan ?_ ?_
  · exact isPrime_ideal_exceptionalIdeal_chartOpen I V ⟨x, hx⟩
      ((Ideal.Quotient.isDomain_iff_prime _).mpr
        (Stacks.Blowup.isPrime_span_algebraMap_chartModel x y (I.ideal V) hdim hxy hIV))
  · exact isPrime_ideal_exceptionalIdeal_chartOpen I V ⟨y, hy⟩
      ((Ideal.Quotient.isDomain_iff_prime _).mpr
        (Stacks.Blowup.isPrime_span_algebraMap_chartModel y x (I.ideal V) hdim hyx hIV))

/-- The exceptional divisor of the blowup of an affine regular surface at its closed point has
irreducible support. The data is a scheme `X` whose sections over an affine open `V` covering
it form a two-dimensional regular local ring, an ideal sheaf `I` whose ideal on `V` is the
maximal ideal, and two generators `x, y` of that maximal ideal. -/
public theorem isIrreducible_supportSet_exceptionalIdeal_of_span_pair {X : Scheme.{u}}
    (I : X.IdealSheafData) (V : X.affineOpens) (hVtop : ∀ z : X, z ∈ V.1)
    [IsRegularLocalRing Γ(X, V.1)] (hdim : ringKrullDim Γ(X, V.1) = 2) (x y : Γ(X, V.1))
    (hIV : I.ideal V = maximalIdeal Γ(X, V.1))
    (hxy : Ideal.span ({x, y} : Set Γ(X, V.1)) = maximalIdeal Γ(X, V.1)) :
    IsIrreducible ((exceptionalIdeal I).supportSet) := by
  have hyx : Ideal.span ({y, x} : Set Γ(X, V.1)) = maximalIdeal Γ(X, V.1) := by
    rwa [Set.pair_comm]
  obtain ⟨hx, hy, hspan⟩ := span_pair_mem I V x y hIV hxy
  have hfrac : ∀ (c d : Γ(X, V.1)) (hc : c ∈ I.ideal V) (hd : d ∈ I.ideal V),
      Ideal.span ({c, d} : Set Γ(X, V.1)) = maximalIdeal Γ(X, V.1) →
      affineBlowupAlgebra.fraction (S := Localization.Away c) (I.ideal V) c 1
          ⟨d, by simpa using hd⟩ ∉
        Ideal.span ({algebraMap Γ(X, V.1) (chartRing I V ⟨c, hc⟩) c} :
          Set (chartRing I V ⟨c, hc⟩)) := by
    intro c d hc hd hcd
    refine Stacks.Blowup.notMem_span_algebraMap_chartModel c d (I.ideal V) hdim hcd hIV _ ?_
    simpa using affineBlowupAlgebra.algebraMap_pow_mul_fraction
      (S := Localization.Away c) (I.ideal V) c 1 ⟨d, by simpa using hd⟩
  exact isIrreducible_supportSet_exceptionalIdeal_of_two_charts I V hVtop ⟨x, hx⟩ ⟨y, hy⟩ hspan
    (Stacks.Blowup.isPrime_span_algebraMap_chartModel x y (I.ideal V) hdim hxy hIV)
    (Stacks.Blowup.isPrime_span_algebraMap_chartModel y x (I.ideal V) hdim hyx hIV)
    (hfrac x y hx hy hxy) (hfrac y x hy hx hyx)

/-- A statement about the blowup of a two-dimensional regular local ring `A` at its closed point
holds once it holds for every affine open `V` of `Spec A` covering it whose sections form a
two-dimensional regular local ring on which the centre is the maximal ideal, and for every two
generators of that maximal ideal. -/
private lemma reduce_to_span_pair {A : Type u} [CommRing A] [IsRegularLocalRing A]
    (hdim : ringKrullDim A = 2) {P : Prop}
    (H : ∀ (V : (Spec (CommRingCat.of A)).affineOpens),
      (∀ z : Spec (CommRingCat.of A), z ∈ V.1) →
      ∀ _ : IsRegularLocalRing Γ(Spec (CommRingCat.of A), V.1),
      ringKrullDim Γ(Spec (CommRingCat.of A), V.1) = 2 →
      ∀ x y : Γ(Spec (CommRingCat.of A), V.1),
      (Scheme.IdealSheafData.ofIdealTop
          (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (maximalIdeal A))).ideal V =
        maximalIdeal Γ(Spec (CommRingCat.of A), V.1) →
      Ideal.span ({x, y} : Set Γ(Spec (CommRingCat.of A), V.1)) =
        maximalIdeal Γ(Spec (CommRingCat.of A), V.1) → P) :
    P := by
  classical
  let V : (Spec (CommRingCat.of A)).affineOpens :=
    ⟨⊤, isAffineOpen_top (Spec (CommRingCat.of A))⟩
  let R := Γ(Spec (CommRingCat.of A), V.1)
  let I : (Spec (CommRingCat.of A)).IdealSheafData := Scheme.IdealSheafData.ofIdealTop
    (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (maximalIdeal A))
  let φ : A ≃+* R := (Scheme.ΓSpecIso (CommRingCat.of A)).symm.commRingCatIsoToRingEquiv
  have hφ : (φ : A →+* R) = (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom := by
    ext a
    rfl
  have hR : IsRegularLocalRing R := IsRegularLocalRing.of_ringEquiv φ
  have hdimR : ringKrullDim R = 2 := (ringKrullDim_eq_of_ringEquiv φ).symm.trans hdim
  have hIV : I.ideal V = maximalIdeal R := by
    have h1 : I.ideal V =
        Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (maximalIdeal A) := by
      simp [I, V]
    rw [h1, ← hφ]
    exact map_ringEquiv_maximalIdeal φ
  obtain ⟨s, hscard, hsspan⟩ := Submodule.FG.exists_span_finset_card_eq_spanFinrank
    (maximalIdeal R).fg_of_isNoetherianRing
  have hsf : (maximalIdeal R).spanFinrank = 2 := by
    have h := IsRegularLocalRing.spanFinrank_maximalIdeal (R := R)
    rw [hdimR] at h
    exact_mod_cast h
  rw [hsf] at hscard
  obtain ⟨x, y, -, rfl⟩ := Finset.card_eq_two.mp hscard
  have hxy : Ideal.span ({x, y} : Set R) = maximalIdeal R := by simpa using hsspan
  exact H V (fun _ => trivial) hR hdimR x y hIV hxy

/-- The exceptional divisor of the blowup of a two-dimensional regular local ring at its closed
point has irreducible support. -/
public theorem isIrreducible_supportSet_exceptionalIdeal_maximalIdeal (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) :
    IsIrreducible ((exceptionalIdeal (Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
        (maximalIdeal A)))).supportSet) :=
  reduce_to_span_pair hdim fun V hVtop _ hdimR x y hIV hxy =>
    isIrreducible_supportSet_exceptionalIdeal_of_span_pair _ V hVtop hdimR x y hIV hxy

/-- The exceptional ideal of the blowup of a two-dimensional regular local ring at its closed
point is radical. -/
public theorem radical_exceptionalIdeal_maximalIdeal (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) :
    (exceptionalIdeal (Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (maximalIdeal A)))).radical =
      exceptionalIdeal (Scheme.IdealSheafData.ofIdealTop
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (maximalIdeal A))) :=
  reduce_to_span_pair hdim fun V hVtop _ hdimR x y hIV hxy =>
    radical_exceptionalIdeal_eq_self_of_span_pair _ V hVtop hdimR x y hIV hxy

/-! ### Regularity of the exceptional divisor -/

/-- The exceptional divisor is a regular scheme as soon as it is a regular ring on the charts
attached to a generating family of the centre over one affine open covering the base. -/
public theorem isRegular_exceptionalDivisor_of_charts {X : Scheme.{u}} (I : X.IdealSheafData)
    (V : X.affineOpens) (hVtop : ∀ z : X, z ∈ V.1) {ι : Type*} (g : ι → Γ(X, V.1))
    (hg : ∀ j, g j ∈ I.ideal V)
    (hspan : (I.ideal V : Ideal Γ(X, V.1)) ≤ Ideal.span (Set.range g))
    (hchart : ∀ j, IsRegularRing (Γ(blowUp I, (chartOpen I V ⟨g j, hg j⟩).1) ⧸
      (exceptionalIdeal I).ideal (chartOpen I V ⟨g j, hg j⟩))) :
    IsRegular (exceptionalDivisor I) := by
  intro ξ
  obtain ⟨j, w, hw⟩ := exists_mem_range_blowupChartι I V g hg hspan
    ((exceptionalIdeal I).subschemeι ξ) (hVtop _)
  have haff : IsAffineOpen
      ((exceptionalIdeal I).subschemeι ⁻¹ᵁ (chartOpen I V ⟨g j, hg j⟩).1) :=
    (chartOpen I V ⟨g j, hg j⟩).2.preimage (exceptionalIdeal I).subschemeι
  have := hchart j
  exact ⟨⟨_, haff⟩, ⟨w, hw⟩, IsRegularRing.of_ringEquiv
    ((exceptionalIdeal I).subschemeObjIso
      (chartOpen I V ⟨g j, hg j⟩)).commRingCatIsoToRingEquiv.symm⟩

/-- The exceptional divisor of the blowup of an affine regular surface at its closed point is
a regular scheme. The data is a scheme `X` whose sections over an affine open `V` covering it
form a two-dimensional regular local ring, an ideal sheaf `I` whose ideal on `V` is the maximal
ideal, and two generators `x, y` of that maximal ideal. -/
public theorem isRegular_exceptionalDivisor_of_span_pair {X : Scheme.{u}}
    (I : X.IdealSheafData) (V : X.affineOpens) (hVtop : ∀ z : X, z ∈ V.1)
    [IsRegularLocalRing Γ(X, V.1)] (hdim : ringKrullDim Γ(X, V.1) = 2) (x y : Γ(X, V.1))
    (hIV : I.ideal V = maximalIdeal Γ(X, V.1))
    (hxy : Ideal.span ({x, y} : Set Γ(X, V.1)) = maximalIdeal Γ(X, V.1)) :
    IsRegular (exceptionalDivisor I) := by
  classical
  have hyx : Ideal.span ({y, x} : Set Γ(X, V.1)) = maximalIdeal Γ(X, V.1) := by
    rwa [Set.pair_comm]
  obtain ⟨hx, hy, hspan⟩ := span_pair_mem I V x y hIV hxy
  have hrange : Set.range (fun t : Bool => if t then y else x) =
      ({x, y} : Set Γ(X, V.1)) := by
    refine Set.ext fun w => ?_
    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
    exact ⟨fun ⟨t, ht⟩ => by cases t <;> simp_all,
      fun h => h.elim (fun h => ⟨false, by simp [h]⟩) fun h => ⟨true, by simp [h]⟩⟩
  refine isRegular_exceptionalDivisor_of_charts I V hVtop
    (fun t : Bool => if t then y else x)
    (fun t => by cases t <;> simpa using ‹_›) (by rw [hrange]; exact hspan) fun t => ?_
  cases t
  · exact Stacks.BlowUpChartCover.isRegularRing_quotient_ideal_exceptionalIdeal_chartOpen
      I V ⟨x, by simpa using hx⟩
      (Stacks.Blowup.isRegularRing_quotient_chartModel x y (I.ideal V) hdim hxy hIV)
  · exact Stacks.BlowUpChartCover.isRegularRing_quotient_ideal_exceptionalIdeal_chartOpen
      I V ⟨y, by simpa using hy⟩
      (Stacks.Blowup.isRegularRing_quotient_chartModel y x (I.ideal V) hdim hyx hIV)

/-- The exceptional divisor of the blowup of a two-dimensional regular local ring at its closed
point is an irreducible scheme. -/
public theorem irreducibleSpace_exceptionalDivisor_maximalIdeal (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) :
    IrreducibleSpace (exceptionalDivisor (Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (maximalIdeal A)))) := by
  refine Scheme.IdealSheafData.irreducibleSpace_subscheme _ _ ?_
  rw [Scheme.IdealSheafData.range_subschemeι]
  exact isIrreducible_supportSet_exceptionalIdeal_maximalIdeal A hdim

/-- The exceptional divisor of the blowup of a two-dimensional regular local ring `(A, 𝔪, κ)` at
its closed point is a regular scheme. -/
public theorem isRegular_exceptionalDivisor_maximalIdeal (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (hdim : ringKrullDim A = 2) :
    IsRegular (exceptionalDivisor (Scheme.IdealSheafData.ofIdealTop
      (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (maximalIdeal A)))) :=
  reduce_to_span_pair hdim fun V hVtop _ hdimR x y hIV hxy =>
    isRegular_exceptionalDivisor_of_span_pair _ V hVtop hdimR x y hIV hxy

