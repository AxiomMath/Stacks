module

public import StacksFrontier.AlgebraicGeometry.Blowup.ReesProjBridge
public import StacksFrontier.AlgebraicGeometry.Blowup.ReesAlgebra.Proper
public import StacksFrontier.AlgebraicGeometry.Morphisms.Projective.RelativeProj
public import StacksFrontier.AlgebraicGeometry.ProjectiveBundleProperFiniteType.Basic
public import StacksFrontier.AlgebraicGeometry.RelativeProjBridge.GeneratedInDegreeOne
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The blowup in a quasi-coherent ideal of finite type is projective

Let `X` be a scheme and `I ⊆ 𝒪_X` a quasi-coherent ideal sheaf of finite type. The blowup
`Bl_I(X) ⟶ X` is the relative `Proj` of the Rees algebra `⨁_{n ≥ 0} Iⁿ`
(`Stacks.Blowup.exists_iso_relativeProj_reesSheafGradedAlgebra_blowUp`), which is generated in
degree one by its degree-one piece `I`, a module of finite type. By [Stacks, Example 07ZS]
(`AlgebraicGeometry.isProjective_relativeProj_toBase_and_isClosedImmersion`) the blowup is
therefore projective in the sense of [Stacks, Tag 01W8]: it is a closed subscheme of the
projective bundle `𝐏(I)` over `X`. This is the projectivity half of [Stacks, Tag 02NS]; with
[Stacks, Tag 07RL] it makes the blowup quasi-projective, which is the statement
`AlgebraicGeometry.BlowUpIsQuasiProjective` asks for.

## Main results

* `Stacks.Blowup.isGeneratedInDegreeOne_reesSheafGradedAlgebra`
* `Stacks.Blowup.isProjective_blowUpToBase`
* `Stacks.Blowup.isQuasiProjective_blowUpToBase`
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Opposite
open Stacks.AlgebraicGeometry.RelativeProjBridge

universe u

namespace Stacks.Blowup

variable {X : Scheme.{u}} (I : X.IdealSheafData)

/-- **The Rees algebra is generated in degree one over an affine open.** Through
`Stacks.Blowup.ReesAlgebraData.pieceEquiv` this is `Iⁿ⁺¹ = I · Iⁿ`, so every element of degree
`n + 1` is a sum of products of a degree-one section with a degree-`n` one. (The same argument as
`AlgebraicGeometry.reesSituation_isGeneratedInDegreeOne`, for the Rees algebra of
`StacksFrontier/AlgebraicGeometry/Blowup/ReesAlgebraSheaf.lean` on which the comparison with the
relative `Proj` of [Stacks, Example 07ZS] is built.) -/
theorem reesGradedAlgebra_isGeneratedInDegreeOne (U : X.affineOpens) :
    (reesAlgebraData I).algebra.IsGeneratedInDegreeOne (op U.1) := by
  intro n P hP
  have hn1 : ((1 : ℤ) + (n : ℤ)).toNat = n + 1 := by omega
  set e1 := (reesAlgebraData I).pieceEquiv 1 (by norm_num) U with he1
  set en := (reesAlgebraData I).pieceEquiv (n : ℤ) (by positivity) U with hen
  set e := (reesAlgebraData I).pieceEquiv ((1 : ℤ) + (n : ℤ)) (by positivity) U with he
  have hcover : ∀ v ∈ I.ideal U ^ (n + 1),
      ∃ p ∈ P, ((e p : ↥(I.ideal U ^ ((1 : ℤ) + (n : ℤ)).toNat)) :
        X.presheaf.obj (op U.1)) = v := by
    intro v hv
    rw [pow_succ', ← pow_one (I.ideal U)] at hv
    refine Submodule.mul_induction_on hv ?_ ?_
    · intro a ha b hb
      refine ⟨((reesAlgebraData I).algebra.mul 1 (n : ℤ)).app (op U.1)
        (e1.symm ⟨a, ha⟩) (en.symm ⟨b, by simpa using hb⟩), hP _ _, ?_⟩
      rw [he, (reesAlgebraData I).pieceEquiv_mul 1 (n : ℤ) (by norm_num) (by positivity) U]
      rw [he1, hen]
      simp
    · rintro x y ⟨p, hp, hpx⟩ ⟨q, hq, hqy⟩
      exact ⟨p + q, AddSubgroup.add_mem _ hp hq, by rw [map_add]; push_cast [hpx, hqy]; ring⟩
  refine (AddSubgroup.eq_top_iff' _).mpr fun z => ?_
  obtain ⟨p, hp, hpz⟩ := hcover ((e z : ↥(I.ideal U ^ ((1 : ℤ) + (n : ℤ)).toNat)) :
      X.presheaf.obj (op U.1)) (by rw [← hn1]; exact (e z).2)
  have : e p = e z := Subtype.ext hpz
  exact (e.injective this) ▸ hp

/-- **The Rees algebra is generated in degree one**, on the `SheafGradedAlgebra` substrate: over
every affine open the ring of homogeneous sections is generated by its degree-one part over its
degree-zero part. This is `AlgebraicGeometry.reesSituation_isGeneratedInDegreeOne`, read through
`SheafGradedAlgebra.adjoin_grading_one_eq_top`. -/
theorem isGeneratedInDegreeOne_reesSheafGradedAlgebra :
    Stacks.AlgebraicGeometry.ProjRepresentsF1.IsGeneratedInDegreeOne
      (reesSheafGradedAlgebra I) := fun U hU =>
  SheafGradedAlgebra.adjoin_grading_one_eq_top _ U fun n P hP =>
    reesGradedAlgebra_isGeneratedInDegreeOne I ⟨U, hU⟩ n P hP

/-- Projectivity in the sense of [Stacks, Tag 01W8] is invariant under isomorphism of the source
over the target. -/
theorem _root_.AlgebraicGeometry.IsProjective.of_iso_hom_comp {X' Y S : Scheme.{u}}
    (e : X' ≅ Y) {f : Y ⟶ S} {f' : X' ⟶ S} (h : e.hom ≫ f = f') (hf' : IsProjective f') :
    IsProjective f := by
  obtain ⟨E, hqc, hft, hpieces, i, hi, hif⟩ := hf'
  refine ⟨E, hqc, hft, hpieces, e.inv ≫ i, inferInstance, ?_⟩
  rw [Category.assoc, hif, ← h, Iso.inv_hom_id_assoc]

/-- **Stacks Project, Tag 02NS, projectivity.** The blowup of a scheme in a quasi-coherent ideal
sheaf of finite type is projective in the sense of [Stacks, Tag 01W8]: it is the relative `Proj`
of the Rees algebra, which is generated in degree one by the finite-type module `I`, so
[Stacks, Example 07ZS] applies. -/
@[ega "IV 19.4.1"]
theorem isProjective_blowUpToBase (hI : I.IsFiniteType) :
    IsProjective (AlgebraicGeometry.blowUpToBase I) := by
  obtain ⟨e, he⟩ := exists_iso_relativeProj_reesSheafGradedAlgebra_blowUp I
  exact IsProjective.of_iso_hom_comp e he
    (isProjective_relativeProj_toBase_and_isClosedImmersion (reesSheafGradedAlgebra I)
      (isGeneratedInDegreeOne_reesSheafGradedAlgebra I)
      (isFiniteType_reesSheafGradedAlgebra_piece I hI 1)).1

/-- The blowup of a scheme in a quasi-coherent ideal sheaf of finite type is quasi-projective
([Stacks, Tags 02NS and 07RL]). -/
theorem isQuasiProjective_blowUpToBase (hI : I.IsFiniteType) :
    IsQuasiProjective (AlgebraicGeometry.blowUpToBase I) :=
  (isProjective_blowUpToBase I hI).isQuasiProjective

end Stacks.Blowup

end
