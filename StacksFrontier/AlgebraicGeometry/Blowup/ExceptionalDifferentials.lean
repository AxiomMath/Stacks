theorem ker_le_ker_exceptional :
    p.ker ≤ ((exceptionalIdeal p.ker).subschemeι ≫ blowUpToBase p.ker).ker := by
  rw [Scheme.Hom.ker_comp, Scheme.IdealSheafData.ker_subschemeι, exceptionalIdeal]
  exact Scheme.IdealSheafData.le_map_comap _ _

/-- **The structure morphism of the exceptional divisor over the centre of the blowup.** The
composite `E ⟶ X ⟶ S` kills the ideal of the centre, so it factors uniquely through the closed
immersion `p : Z ⟶ S`. -/
def exceptionalToCentre : exceptionalDivisor p.ker ⟶ Z :=
  IsClosedImmersion.lift p ((exceptionalIdeal p.ker).subschemeι ≫ blowUpToBase p.ker)
    (ker_le_ker_exceptional p)

/-- The structure morphism of the exceptional divisor over the centre is compatible with the
blowup morphism. -/
theorem exceptionalToCentre_comp :
    (exceptionalIdeal p.ker).subschemeι ≫ blowUpToBase p.ker = exceptionalToCentre p ≫ p :=
  (IsClosedImmersion.lift_fac p _ (ker_le_ker_exceptional p)).symm

/-- **The exceptional divisor of a blowup is the fibre product of the blowup with the centre.**
Both vertical maps are closed immersions and the inverse image of the ideal of the centre is the
exceptional ideal, which is the criterion
`AlgebraicGeometry.isPullback_of_isClosedImmersion`. -/
theorem isPullback_exceptionalToCentre :
    IsPullback (exceptionalIdeal p.ker).subschemeι (exceptionalToCentre p)
      (blowUpToBase p.ker) p :=
  isPullback_of_isClosedImmersion _ p _ _ (exceptionalToCentre_comp p)
    (Scheme.IdealSheafData.ker_subschemeι _).symm

/-! ### The differentials of a blowup -/

/-- **The canonical map `Ω_{X/S} ⟶ i_* Ω_{E/Z}`.** It is the adjoint transpose of the functorial
map `i^* Ω_{X/S} ⟶ Ω_{E/Z}` of Stacks tag 01UV for the square cut out by the exceptional
divisor. -/
def relativeDifferentialsToPushforward :
    Scheme.Hom.relativeDifferentials (blowUpToBase p.ker) ⟶
      (Scheme.Modules.pushforward (exceptionalIdeal p.ker).subschemeι).obj
        (Scheme.Hom.relativeDifferentials (exceptionalToCentre p)) :=
  (Scheme.Modules.pullbackPushforwardAdjunction (exceptionalIdeal p.ker).subschemeι).homEquiv _ _
    (Scheme.Hom.relativeDifferentialsMap (exceptionalIdeal p.ker).subschemeι
      (blowUpToBase p.ker) (exceptionalToCentre p) p (exceptionalToCentre_comp p))

/-- **The relative differentials of a blowup are the direct image of the relative differentials
of its exceptional divisor over the centre.** The exceptional divisor is the fibre product
`X ×_S Z`, so the functorial map `i^*Ω_{X/S} ⟶ Ω_{E/Z}` is an isomorphism by Stacks tag 01V0, and
the unit `Ω_{X/S} ⟶ i_* i^* Ω_{X/S}` is an isomorphism because the exceptional ideal annihilates
`Ω_{X/S}`; the canonical map is the composite of the two. -/
theorem isIso_relativeDifferentialsToPushforward :
    IsIso (relativeDifferentialsToPushforward p) := by
  have hmap : IsIso (Scheme.Hom.relativeDifferentialsMap
      (exceptionalIdeal p.ker).subschemeι (blowUpToBase p.ker) (exceptionalToCentre p) p
      (exceptionalToCentre_comp p)) :=
    Scheme.Hom.isIso_relativeDifferentialsMap_of_isPullback _ _ _ _
      (isPullback_exceptionalToCentre p)
  have hunit := isIso_unit_relativeDifferentials p.ker
  rw [relativeDifferentialsToPushforward, Adjunction.homEquiv_unit]
  infer_instance

/-! ### The blowup of a regular local surface -/

/-- The closed point of the spectrum of a local ring, as a closed immersion. -/
def residuePoint (A : Type u) [CommRing A] [IsLocalRing A] :
    Spec (.of (IsLocalRing.ResidueField A)) ⟶ Spec (.of A) :=
  Spec.map (CommRingCat.ofHom (IsLocalRing.residue A))

/-- The inclusion of the closed point of the spectrum of a local ring is a closed immersion. -/
instance isClosedImmersion_residuePoint (A : Type u) [CommRing A] [IsLocalRing A] :
    IsClosedImmersion (residuePoint A) :=
  IsClosedImmersion.spec_of_surjective _ Ideal.Quotient.mk_surjective

/-- **The ideal sheaf of the closed point is the maximal ideal.** This identifies the centre of
the blowup below with `𝔪`. -/
theorem ker_residuePoint (A : Type u) [CommRing A] [IsLocalRing A] :
    (residuePoint A).ker = Scheme.IdealSheafData.ofIdealTop
      ((IsLocalRing.maximalIdeal A).comap (Scheme.ΓSpecIso (.of A)).hom.hom) := by
  rw [Scheme.ker_of_isAffine]
  congr 1
  rw [residuePoint, ← RingHom.ker_equiv_comp _
    (Scheme.ΓSpecIso (.of (IsLocalRing.ResidueField A))).commRingCatIsoToRingEquiv,
    RingEquiv.toRingHom_eq_coe, Iso.commRingCatIsoToRingEquiv_toRingHom, ← CommRingCat.hom_comp,
    Scheme.ΓSpecIso_naturality, CommRingCat.hom_comp]
  ext x
  change IsLocalRing.residue A ((Scheme.ΓSpecIso (.of A)).hom.hom x) = 0 ↔ _
  rw [IsLocalRing.residue_eq_zero_iff]
  exact Iff.rfl

/-- **Stacks Project, Tag 0B4L.** Let `(A, 𝔪, κ)` be a regular local ring of dimension two and
let `f : X ⟶ S = Spec(A)` be the blowing up of `A` in `𝔪`, with `i : E ⟶ X` the immersion of the
exceptional divisor. Then `Ω_{X/S} = i_* Ω_{E/κ}`: the canonical map
`Stacks.Blowup.relativeDifferentialsToPushforward` is an isomorphism.

The centre of the blowup is the closed point `Spec(κ) ⟶ Spec(A)`, whose ideal sheaf is `𝔪` by
`Stacks.Blowup.ker_residuePoint`. The statement is the case of
`Stacks.Blowup.isIso_relativeDifferentialsToPushforward` in which the centre is that point; the
regularity and the dimension are the source's hypotheses and are not used by the proof, which
runs on the affine charts `A[𝔪/a]` of the blowup directly. -/
@[stacks 0B4L]
theorem isIso_relativeDifferentialsToPushforward_residuePoint (A : Type u) [CommRing A]
    [IsRegularLocalRing A] (_hdim : ringKrullDim A = 2) :
    IsIso (relativeDifferentialsToPushforward (residuePoint A)) :=
  isIso_relativeDifferentialsToPushforward (residuePoint A)

end Stacks.Blowup

end
