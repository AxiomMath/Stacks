/-! ### Powers of the maximal ideal inside the centre -/

/-- An ideal of a Noetherian local ring whose zero locus is contained in the closed point
contains a power of the maximal ideal. -/
private theorem exists_pow_le_ideal_of_zeroLocus_subset_closedPoint
    (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] (I : Ideal A)
    (hV : PrimeSpectrum.zeroLocus (I : Set A) ⊆ {IsLocalRing.closedPoint A}) :
    ∃ n : ℕ, (maximalIdeal A) ^ n ≤ I := by
  by_cases hI : I = ⊤
  · exact ⟨0, by simp [hI]⟩
  have hVeq : PrimeSpectrum.zeroLocus (I : Set A) = {IsLocalRing.closedPoint A} := by
    refine Set.Subset.antisymm hV ?_
    rintro x rfl
    exact (PrimeSpectrum.mem_zeroLocus _ _).2 (IsLocalRing.le_maximalIdeal hI)
  have hrad : I.radical = maximalIdeal A := by
    rw [← PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical, hVeq,
      PrimeSpectrum.vanishingIdeal_singleton]
    rfl
  exact Ideal.exists_pow_le_of_le_radical_of_fg hrad.ge
    (Ideal.fg_of_isNoetherianRing _)

/-- An ideal of the completion of a Noetherian local ring containing a power of the maximal
ideal is generated by its contraction to the ring. -/
private theorem ideal_map_comap_completion
    (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (J : Ideal (AdicCompletion (maximalIdeal A) A)) (n : ℕ)
    (hJ : (maximalIdeal (AdicCompletion (maximalIdeal A) A)) ^ n ≤ J) :
    J = (J.comap (algebraMap A (AdicCompletion (maximalIdeal A) A))).map
      (algebraMap A (AdicCompletion (maximalIdeal A) A)) := by
  let m := maximalIdeal A
  let R := AdicCompletion m A
  let q := AdicCompletion.quotPowSMulTopEquiv m.fg_of_isNoetherianRing A n
  have hsmall : (m ^ n).map (algebraMap A R) ≤ J := by
    rwa [AdicCompletion.maximalIdeal_eq_map (R := A), ← Ideal.map_pow] at hJ
  refine le_antisymm (fun x hx ↦ ?_) Ideal.map_comap_le
  obtain ⟨a, ha⟩ := Submodule.Quotient.mk_surjective (m ^ n • (⊤ : Submodule A A))
    (q (Submodule.Quotient.mk x))
  have hq' : q (Submodule.Quotient.mk (algebraMap A R a)) = Submodule.Quotient.mk a := by
    rw [AdicCompletion.quotPowSMulTopEquiv_mk, AdicCompletion.algebraMap_apply]
    simp [AdicCompletion.of]
    rfl
  have hdiff : x - algebraMap A R a ∈ (m ^ n).map (algebraMap A R) := by
    rw [← Submodule.restrictScalars_mem A, ← Ideal.smul_top_eq_map]
    exact (Submodule.Quotient.eq (m ^ n • (⊤ : Submodule A R))).mp
      (q.injective (ha.symm.trans hq'.symm))
  have haJ : algebraMap A R a ∈ J := by simpa using J.sub_mem hx (hsmall hdiff)
  rw [← sub_add_cancel x (algebraMap A R a)]
  exact add_mem (Ideal.map_mono (Ideal.map_le_iff_le_comap.mp hsmall) hdiff)
    (Ideal.mem_map_of_mem _ (Ideal.mem_comap.mpr haJ))

/-- An ideal sheaf on the spectrum of a ring is determined by its ideal of global sections. -/
private theorem eq_ofIdealTop_ideal {R : Type u} [CommRing R]
    (J : (Spec (.of R)).IdealSheafData) :
    J = Scheme.IdealSheafData.ofIdealTop (J.ideal ⟨⊤, isAffineOpen_top _⟩) :=
  Scheme.IdealSheafData.ext_of_isAffine (by simp)

/-- Contracting along the inverse of `ΓSpecIso` the extension of an ideal gives back the ideal. -/
private theorem comap_map_ΓSpecIso_inv {R : Type u} [CommRing R] (I : Ideal R) :
    (I.map (Scheme.ΓSpecIso (.of R)).inv.hom).comap (Scheme.ΓSpecIso (.of R)).inv.hom = I :=
  Ideal.comap_map_of_bijective _ (ConcreteCategory.bijective_of_isIso _)

/-- The support of an ideal sheaf on `Spec R` is the zero locus of its ideal of global sections. -/
private theorem coe_support_eq_zeroLocus {R : Type u} [CommRing R]
    (J : (Spec (.of R)).IdealSheafData) :
    (J.support : Set (Spec (.of R))) = PrimeSpectrum.zeroLocus
      (((J.ideal ⟨⊤, isAffineOpen_top _⟩).comap (Scheme.ΓSpecIso (.of R)).inv.hom : Ideal R) :
        Set R) := by
  conv_lhs => rw [eq_ofIdealTop_ideal J]
  rw [Scheme.IdealSheafData.coe_support_ofIdealTop, AlgebraicGeometry.Spec_zeroLocus]
  rfl

/-- An ideal sheaf on the spectrum of the completion whose support misses the punctured spectrum
has an ideal of global sections containing a power of the maximal ideal. -/
private theorem exists_pow_le_idealSheaf_of_disjoint_puncturedSpectrum
    (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (J : (Spec (.of (AdicCompletion (maximalIdeal A) A))).IdealSheafData)
    (hJ : Disjoint
      (Stacks.Divisors.puncturedSpectrum (AdicCompletion (maximalIdeal A) A) : Set _)
      (J.support : Set (Spec (.of (AdicCompletion (maximalIdeal A) A))))) :
    ∃ n : ℕ,
      (maximalIdeal (AdicCompletion (maximalIdeal A) A)) ^ n ≤
        ((J.ideal ⟨⊤, isAffineOpen_top _⟩).comap
          (Scheme.ΓSpecIso (.of (AdicCompletion (maximalIdeal A) A))).inv.hom) := by
  let B := AdicCompletion (maximalIdeal A) A
  let X := Spec (.of B)
  let U : X.affineOpens := ⟨⊤, isAffineOpen_top X⟩
  let γ := Scheme.ΓSpecIso (.of B)
  let K : Ideal B := (J.ideal U).comap γ.inv.hom
  have : IsNoetherianRing B := AdicCompletion.isNoetherianRing (maximalIdeal A)
  have hsupp : (J.support : Set X) = PrimeSpectrum.zeroLocus (K : Set B) :=
    coe_support_eq_zeroLocus J
  have hV : PrimeSpectrum.zeroLocus (K : Set B) ⊆ {IsLocalRing.closedPoint B} := by
    intro p hp
    by_contra hne
    have hpU : (p : X) ∈ Stacks.Divisors.puncturedSpectrum B := by
      show p ∈ ({IsLocalRing.closedPoint B}ᶜ : Set (PrimeSpectrum B))
      simpa using hne
    exact Set.disjoint_left.mp hJ hpU (by rwa [hsupp])
  obtain ⟨n, hn⟩ := exists_pow_le_ideal_of_zeroLocus_subset_closedPoint B K hV
  exact ⟨n, by simpa [B, K, U, γ] using hn⟩

/-- Transport of the blowup along an equality of centres is a morphism over the base. -/
private theorem eqToIso_hom_blowUpToBase {Z : Scheme.{u}} {D D' : Z.IdealSheafData} (h : D = D') :
    (eqToIso (congrArg (fun E : Z.IdealSheafData ↦ AlgebraicGeometry.blowUp E) h)).hom ≫
        AlgebraicGeometry.blowUpToBase D' = AlgebraicGeometry.blowUpToBase D := by
  cases h
  simp

/-- An ideal of a local ring containing a power of the maximal ideal has zero locus contained in
the closed point. -/
private theorem zeroLocus_subset_closedPoint_of_pow_le {A : Type u} [CommRing A] [IsLocalRing A]
    {I : Ideal A} {n : ℕ} (hI : maximalIdeal A ^ n ≤ I) :
    PrimeSpectrum.zeroLocus (I : Set A) ⊆ {IsLocalRing.closedPoint A} := fun p hp ↦
  Set.mem_singleton_iff.mpr <| PrimeSpectrum.ext <|
    le_antisymm (IsLocalRing.le_maximalIdeal_of_isPrime p.asIdeal)
      (Ideal.IsPrime.le_of_pow_le (n := n) (hI.trans ((PrimeSpectrum.mem_zeroLocus _ _).1 hp)))

/-- The blowup of the spectrum of a Noetherian local ring in an ideal containing a power of the
maximal ideal is an admissible blowup relative to the punctured spectrum. -/
private theorem isAdmissibleBlowup_blowUpToBase_ofIdealTop
    (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A] {I : Ideal A} {n : ℕ}
    (hI : maximalIdeal A ^ n ≤ I) :
    IsAdmissibleBlowup (Stacks.Divisors.puncturedSpectrum A)
      (AlgebraicGeometry.blowUpToBase
        (Scheme.IdealSheafData.ofIdealTop (I.map (Scheme.ΓSpecIso (.of A)).inv.hom))) := by
  let X₀ : Scheme := Spec (.of A)
  let γ₀ := Scheme.ΓSpecIso (.of A)
  let U₀ : X₀.affineOpens := ⟨⊤, isAffineOpen_top X₀⟩
  let C : X₀.IdealSheafData := Scheme.IdealSheafData.ofIdealTop (I.map γ₀.inv.hom)
  have hCtop : C.ideal U₀ = I.map γ₀.inv.hom := by
    simp [C, U₀]
  have hCsup : (C.support : Set X₀) = PrimeSpectrum.zeroLocus (I : Set A) := by
    rw [coe_support_eq_zeroLocus C, hCtop, comap_map_ΓSpecIso_inv]
  have hCdisj : Disjoint
      (Stacks.Divisors.puncturedSpectrum A : Set X₀) (C.support : Set X₀) := by
    apply Set.disjoint_left.mpr
    intro x hxU hxC
    have hxmax : x = IsLocalRing.closedPoint A := Set.mem_singleton_iff.mp
      (zeroLocus_subset_closedPoint_of_pow_le hI (by rwa [← hCsup]))
    subst x
    change IsLocalRing.closedPoint A ∈
      ({IsLocalRing.closedPoint A}ᶜ : Set (PrimeSpectrum A)) at hxU
    exact hxU (Set.mem_singleton _)
  have hCfp : FinitePresentation C.subschemeι :=
    (Stacks.Flatness.finitePresentation_subschemeι_iff C).mpr fun U ↦ by
      have : IsNoetherianRing Γ(X₀, U.1) := IsLocallyNoetherian.component_noetherian U
      exact Ideal.fg_of_isNoetherianRing (C.ideal U)
  exact ⟨C, hCfp, hCdisj, AlgebraicGeometry.blowUpIso C,
    AlgebraicGeometry.blowUpIso_hom_blowUpToBase C⟩

/-- The inverse image along `Spec S ⟶ Spec R` of the ideal sheaf of an ideal `I` of `R` is the
ideal sheaf on `Spec S` whose ideal of global sections is generated by the image of `I`. -/
private theorem comap_ofIdealTop_eq_of_ideal_top {R S : Type u} [CommRing R] [CommRing S]
    (φ : R →+* S) (I : Ideal R) (J : (Spec (.of S)).IdealSheafData)
    (hJ : (J.ideal ⟨⊤, isAffineOpen_top _⟩).comap (Scheme.ΓSpecIso (.of S)).inv.hom = I.map φ) :
    (Scheme.IdealSheafData.ofIdealTop (I.map (Scheme.ΓSpecIso (.of R)).inv.hom)).comap
      (Spec.map (CommRingCat.ofHom φ)) = J := by
  let X₀ : Scheme := Spec (.of R)
  let X₁ : Scheme := Spec (.of S)
  let c : X₁ ⟶ X₀ := Spec.map (CommRingCat.ofHom φ)
  let γ₀ := Scheme.ΓSpecIso (.of R)
  let γ₁ := Scheme.ΓSpecIso (.of S)
  let U₀ : X₀.affineOpens := ⟨⊤, isAffineOpen_top X₀⟩
  let U₁ : X₁.affineOpens := ⟨⊤, isAffineOpen_top X₁⟩
  let C : X₀.IdealSheafData := Scheme.IdealSheafData.ofIdealTop (I.map γ₀.inv.hom)
  have hCtop : C.ideal U₀ = I.map γ₀.inv.hom := by
    simp [C, U₀]
  have happ : c.appTop.hom.comp γ₀.inv.hom = γ₁.inv.hom.comp φ := by
    show CommRingCat.Hom.hom (γ₀.inv ≫ c.appTop) =
      CommRingCat.Hom.hom (CommRingCat.ofHom φ ≫ γ₁.inv)
    exact congrArg CommRingCat.Hom.hom
      (Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom φ)).symm
  have hLtop : (C.comap c).ideal U₁ = J.ideal U₁ := by
    apply Ideal.comap_injective_of_surjective γ₁.inv.hom
      (ConcreteCategory.bijective_of_isIso γ₁.inv).2
    show Ideal.comap γ₁.inv.hom ((C.comap c).ideal U₁) =
      Ideal.comap γ₁.inv.hom (J.ideal U₁)
    rw [Stacks.IdealSheaf.ideal_comap_top_of_isAffine, hCtop, Ideal.map_map, happ,
      ← Ideal.map_map, comap_map_ΓSpecIso_inv]
    exact hJ.symm
  show C.comap c = J
  rw [eq_ofIdealTop_ideal (C.comap c), eq_ofIdealTop_ideal J, hLtop]

/-! ### The descent -/

/-- **Stacks Project, Tag 0AFK.** An admissible blowup of the spectrum of the maximal-ideal
completion of a Noetherian local ring `A`, relative to the punctured spectrum, is the base change
of an admissible blowup of `Spec A` relative to its punctured spectrum. -/
@[stacks 0AFK]
theorem exists_isAdmissibleBlowup_isPullback_completion
    (A : Type u) [CommRing A] [IsLocalRing A] [IsNoetherianRing A]
    (Y : Scheme.{u})
    (g : Y ⟶ Spec (.of (AdicCompletion (maximalIdeal A) A)))
    (hg : IsAdmissibleBlowup
      (Stacks.Divisors.puncturedSpectrum (AdicCompletion (maximalIdeal A) A)) g) :
    ∃ (X : Scheme.{u}) (f : X ⟶ Spec (.of A)),
      IsAdmissibleBlowup (Stacks.Divisors.puncturedSpectrum A) f ∧
        ∃ h : Y ⟶ X,
          IsPullback h g f
            (Spec.map (CommRingCat.ofHom
              (algebraMap A (AdicCompletion (maximalIdeal A) A)))) := by
  let B := AdicCompletion (maximalIdeal A) A
  let X₀ : Scheme := Spec (.of A)
  let X₁ : Scheme := Spec (.of B)
  let c : X₁ ⟶ X₀ := Spec.map (CommRingCat.ofHom (algebraMap A B))
  obtain ⟨J, -, hJdisj, eY, heY⟩ := hg
  let U₁ : X₁.affineOpens := ⟨⊤, isAffineOpen_top X₁⟩
  let γ₁ := Scheme.ΓSpecIso (.of B)
  let K : Ideal B := (J.ideal U₁).comap γ₁.inv.hom
  let φ := algebraMap A B
  let I : Ideal A := K.comap φ
  obtain ⟨n, hn⟩ := exists_pow_le_idealSheaf_of_disjoint_puncturedSpectrum A J hJdisj
  have hnK : maximalIdeal B ^ n ≤ K := by simpa [K, U₁, γ₁] using hn
  have hKmap : K = I.map φ := ideal_map_comap_completion A K n hnK
  have hmapPow : (maximalIdeal A ^ n).map φ = (maximalIdeal B) ^ n := by
    rw [AdicCompletion.maximalIdeal_eq_map (R := A), ← Ideal.map_pow]
  have hmI : maximalIdeal A ^ n ≤ I := Ideal.map_le_iff_le_comap.mp (hmapPow.trans_le hnK)
  let C : X₀.IdealSheafData :=
    Scheme.IdealSheafData.ofIdealTop (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)
  have hLJ : C.comap c = J := comap_ofIdealTop_eq_of_ideal_top φ I J hKmap
  have : Module.Flat A B := AdicCompletion.flat_of_isNoetherian (maximalIdeal A)
  have : Flat c := Flat.SpecMap_iff.mpr (RingHom.flat_algebraMap_iff.mpr ‹_›)
  obtain ⟨h₀, hpb⟩ := AlgebraicGeometry.exists_isPullback_blowUpToBase_comap c C
  let e : AlgebraicGeometry.blowUp (C.comap c) ≅ Y :=
    eqToIso (congrArg (fun E : X₁.IdealSheafData ↦ AlgebraicGeometry.blowUp E) hLJ) ≪≫
      AlgebraicGeometry.blowUpIso J ≪≫ eY.symm
  have hebase : e.hom ≫ g = AlgebraicGeometry.blowUpToBase (C.comap c) := by
    have h1 : eY.inv ≫ g = blowUpToBase J := by rw [← heY, Iso.inv_hom_id_assoc]
    simp only [e, Iso.trans_hom, Iso.symm_hom, Category.assoc]
    rw [h1, AlgebraicGeometry.blowUpIso_hom_blowUpToBase, eqToIso_hom_blowUpToBase hLJ]
  refine ⟨AlgebraicGeometry.blowUp C, AlgebraicGeometry.blowUpToBase C,
    isAdmissibleBlowup_blowUpToBase_ofIdealTop A hmI,
    e.inv ≫ h₀, ?_⟩
  refine hpb.flip.of_iso e (Iso.refl _) (Iso.refl X₁) (Iso.refl X₀) ?_ ?_ ?_ ?_
  · simp
  · rw [Iso.refl_hom, Category.comp_id]
    exact hebase.symm
  · simp
  · simp [c]

end Stacks.Blowup

