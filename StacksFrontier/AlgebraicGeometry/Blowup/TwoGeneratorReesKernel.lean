module

public import StacksFrontier.AlgebraicGeometry.Blowup.TwoGeneratorReesPresentation
public import Mathlib.Algebra.MvPolynomial.Division
public import Mathlib.RingTheory.Regular.RegularSequence

/-!
# The Rees algebra of an ideal generated by a regular sequence of length two

For `f₁, f₂` a regular sequence in `A` the kernel of the presentation
`A[T₀, T₁] ⟶ ⨁ₙ (f₁, f₂)ⁿ` is generated by `f₂T₀ - f₁T₁`: the Rees algebra is
`A[T₀,T₁]/(f₂T₀-f₁T₁)`, with no relation beyond the obvious one.

## Main results

* `Stacks.AlmostBlowUp.mem_relationIdeal_of_isHomogeneous_of_eval_eq_zero`: a homogeneous relation
  between `f₁` and `f₂` is a multiple of `f₂T₀ - f₁T₁`.
* `Stacks.AlmostBlowUp.ker_centerReesPresentation_eq_relationIdeal`: the relation of the square is
  the whole kernel.
* `Stacks.AlmostBlowUp.injective_reesQuotPresentation` and
  `Stacks.AlmostBlowUp.bijective_reesQuotPresentation`: the modification ring is the Rees algebra
  of the centre.

## Implementation notes

The inclusion of the relation ideal in the kernel is
`Stacks.AlmostBlowUp.relationIdeal_le_ker_centerReesPresentation`. The reverse inclusion is an
induction on the degree, described at
`Stacks.AlmostBlowUp.mem_relationIdeal_of_isHomogeneous_of_eval_eq_zero`; it is where the regular
sequence enters, as `RingTheory.Sequence.IsWeaklyRegular A [f₁, f₂]`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Stacks.Blowup

universe u

namespace Stacks.AlmostBlowUp

attribute [local instance] MvPolynomial.gradedAlgebra

variable (A : Type u) [CommRing A] (f₁ f₂ : A)

/-! ### The relation ideal is the whole kernel of a regular sequence -/

open MvPolynomial in
/-- **A homogeneous polynomial of degree `n+1` in two variables splits off its pure `T₁` term.**
What is left has `T₀` in each of its monomials, so it is `T₀` times a homogeneous polynomial of
degree `n`. -/
private theorem exists_isHomogeneous_eq_C_mul_X_pow_add_X_mul {n : ℕ}
    {p : MvPolynomial (Fin 2) A} (hp : p.IsHomogeneous (n + 1)) :
    ∃ q : MvPolynomial (Fin 2) A, q.IsHomogeneous n ∧
      p = C (coeff (Finsupp.single 1 (n + 1)) p) * X 1 ^ (n + 1) + X 0 * q := by
  classical
  set r := p - C (coeff (Finsupp.single (1 : Fin 2) (n + 1)) p) * X 1 ^ (n + 1) with hr
  have hp' : r.IsHomogeneous (n + 1) := hp.sub (isHomogeneous_C_mul_X_pow _ _ _)
  have hcoeff : coeff (Finsupp.single (1 : Fin 2) (n + 1)) r = 0 := by
    rw [hr, coeff_sub, C_mul_X_pow_eq_monomial, coeff_monomial, if_pos rfl, sub_self]
  have hmod : r.modMonomial (Finsupp.single 0 1) = 0 := by
    ext d
    by_cases hle : Finsupp.single (0 : Fin 2) 1 ≤ d
    · rw [coeff_modMonomial_of_le _ hle, coeff_zero]
    · rw [coeff_modMonomial_of_not_le _ hle, coeff_zero]
      have hd0 : d 0 = 0 := by
        by_contra hne
        exact hle (Finsupp.single_le_iff.mpr (Nat.one_le_iff_ne_zero.mpr hne))
      by_cases hdeg : d.degree = n + 1
      · have hd1 : d 1 = n + 1 := by
          rw [Finsupp.degree_eq_sum, Fin.sum_univ_two, hd0, zero_add] at hdeg
          exact hdeg
        have hdeq : d = Finsupp.single 1 (n + 1) := by
          ext i
          fin_cases i
          · simp [hd0]
          · simp [hd1]
        rw [hdeq]
        exact hcoeff
      · exact hp'.coeff_eq_zero hdeg
  refine ⟨r.divMonomial (Finsupp.single 0 1), ?_, ?_⟩
  · intro d hd
    rw [coeff_divMonomial] at hd
    have h2 : (Finsupp.single (0 : Fin 2) 1 + d).degree = n + 1 := by
      rw [Finsupp.degree_eq_weight_one]
      exact hp' hd
    rw [map_add, Finsupp.degree_single] at h2
    have h3 : d.degree = n := by omega
    rw [Finsupp.degree_eq_weight_one] at h3
    exact h3
  · have hsplit := divMonomial_add_modMonomial_single r (0 : Fin 2)
    rw [hmod, add_zero] at hsplit
    rw [hr] at hsplit
    rw [hsplit]
    ring

/-- An element that is a nonzerodivisor modulo `(f₁)` stays one after being raised to a power:
if `cf₂ⁿ ∈ (f₁)` then already `c ∈ (f₁)`. -/
private theorem mem_span_singleton_of_mul_pow_mem
    (hf₂ : ∀ a : A, f₂ * a ∈ Ideal.span ({f₁} : Set A) → a ∈ Ideal.span ({f₁} : Set A)) :
    ∀ (n : ℕ) (c : A), c * f₂ ^ n ∈ Ideal.span ({f₁} : Set A) →
      c ∈ Ideal.span ({f₁} : Set A) := by
  intro n
  induction n with
  | zero => intro c h; simpa using h
  | succ n ih =>
      intro c h
      refine ih c (hf₂ _ ?_)
      rw [show f₂ * (c * f₂ ^ n) = c * f₂ ^ (n + 1) by ring]
      exact h

open MvPolynomial in
/-- **Every homogeneous relation between `f₁` and `f₂` is a multiple of `f₂T₀-f₁T₁`**, as soon as
`f₁` is a nonzerodivisor and `f₂` is a nonzerodivisor modulo `f₁` — that is, as soon as `f₁, f₂`
is a regular sequence; see `Stacks.AlmostBlowUp.ker_centerReesPresentation_eq_relationIdeal` for
that hypothesis in its named form.

The proof is an induction on the degree. Writing a homogeneous `p` of degree `n+1` as
`cT₁ⁿ⁺¹ + T₀q`, the vanishing `p(f₁,f₂) = 0` reads `cf₂ⁿ⁺¹ = -f₁q(f₁,f₂)`, so `cf₂ⁿ⁺¹ ∈ (f₁)`
and therefore `c = f₁d`; then `p + (f₂T₀-f₁T₁)dT₁ⁿ` is `T₀r` for an `r` homogeneous of degree
`n` which again vanishes at `(f₁,f₂)`, because `f₁` is a nonzerodivisor. -/
theorem mem_relationIdeal_of_isHomogeneous_of_eval_eq_zero
    (hf₁ : ∀ a : A, f₁ * a = 0 → a = 0)
    (hf₂ : ∀ a : A, f₂ * a ∈ Ideal.span ({f₁} : Set A) → a ∈ Ideal.span ({f₁} : Set A))
    {n : ℕ} {p : MvPolynomial (Fin 2) A} (hp : p.IsHomogeneous n)
    (heval : eval (centerGens A f₁ f₂) p = 0) : p ∈ relationIdeal A f₁ f₂ := by
  rw [relationIdeal]
  induction n generalizing p with
  | zero =>
      have h0 : p = C (coeff 0 p) := by
        rw [← homogeneousComponent_zero p, homogeneousComponent_eq_self hp]
      rw [h0] at heval ⊢
      rw [eval_C] at heval
      rw [heval, map_zero]
      exact Submodule.zero_mem _
  | succ n ih =>
      obtain ⟨q, hq, hpq⟩ := exists_isHomogeneous_eq_C_mul_X_pow_add_X_mul A hp
      have hev : coeff (Finsupp.single (1 : Fin 2) (n + 1)) p * f₂ ^ (n + 1) +
          f₁ * eval (centerGens A f₁ f₂) q = 0 := by
        rw [hpq] at heval
        simpa using heval
      have hmem : coeff (Finsupp.single (1 : Fin 2) (n + 1)) p * f₂ ^ (n + 1) ∈
          Ideal.span ({f₁} : Set A) :=
        Ideal.mem_span_singleton.mpr
          ⟨-(eval (centerGens A f₁ f₂) q), by linear_combination hev⟩
      obtain ⟨d, hd⟩ := Ideal.mem_span_singleton.mp
        (mem_span_singleton_of_mul_pow_mem A f₁ f₂ hf₂ (n + 1) _ hmem)
      have hr : (q + C (f₂ * d) * X 1 ^ n).IsHomogeneous n :=
        hq.add (isHomogeneous_C_mul_X_pow _ _ _)
      have key : p + (C f₂ * X 0 - C f₁ * X 1) * (C d * X 1 ^ n) =
          X 0 * (q + C (f₂ * d) * X 1 ^ n) := by
        rw [hpq, hd, map_mul, map_mul]
        ring
      have hevr : eval (centerGens A f₁ f₂) (q + C (f₂ * d) * X 1 ^ n) = 0 := by
        refine hf₁ _ ?_
        have h3 := congrArg (eval (centerGens A f₁ f₂)) key
        simp only [map_add, map_sub, map_mul, map_pow, eval_C, eval_X, centerGens_zero,
          centerGens_one] at h3 ⊢
        linear_combination heval - h3
      have hfinal : p = X 0 * (q + C (f₂ * d) * X 1 ^ n) -
          (C f₂ * X 0 - C f₁ * X 1) * (C d * X 1 ^ n) := by
        rw [← key]; ring
      rw [hfinal]
      exact sub_mem (Ideal.mul_mem_left _ _ (ih hr hevr))
        (Ideal.mul_mem_right _ _ (Ideal.subset_span rfl))

open MvPolynomial in
/-- The polynomial presentation of the Rees algebra reads off, in degree `k`, the value at
`(f₁,f₂)` of the degree-`k` homogeneous component. So a polynomial in its kernel has every
homogeneous component vanishing at `(f₁,f₂)`. -/
private theorem eval_homogeneousComponent_eq_zero_of_mem_ker {p : MvPolynomial (Fin 2) A}
    (hp : (centerReesPresentation A f₁ f₂).toRingHom p = 0) (k : ℕ) :
    eval (centerGens A f₁ f₂) (homogeneousComponent k p) = 0 := by
  by_cases hk : p.totalDegree < k
  · rw [homogeneousComponent_eq_zero _ _ hk, map_zero]
  · have hcoe : (((centerReesPresentation A f₁ f₂).toRingHom p :
        reesAlgebra (centerIdeal A f₁ f₂)) : Polynomial A) =
        ∑ m ∈ Finset.range (p.totalDegree + 1),
          Polynomial.monomial m (eval (centerGens A f₁ f₂) (homogeneousComponent m p)) := by
      conv_lhs => rw [← sum_homogeneousComponent p]
      rw [map_sum, AddSubmonoidClass.coe_finset_sum]
      refine Finset.sum_congr rfl fun m _ => ?_
      exact coe_reesPresentation_apply (centerIdeal A f₁ f₂) (centerGens A f₁ f₂)
        (centerGens_mem A f₁ f₂) (homogeneousComponent_isHomogeneous m p)
    rw [hp] at hcoe
    have h0 := congrArg (fun r : Polynomial A => r.coeff k) hcoe
    simp only [ZeroMemClass.coe_zero, Polynomial.coeff_zero, Polynomial.finset_sum_coeff,
      Polynomial.coeff_monomial] at h0
    rw [Finset.sum_ite_eq' (Finset.range (p.totalDegree + 1)) k
      (fun m => eval (centerGens A f₁ f₂) (homogeneousComponent m p))] at h0
    rw [if_pos (Finset.mem_range.mpr (by omega))] at h0
    exact h0.symm

open Pointwise in
/-- **For a regular sequence of length two the relation of the square is the whole kernel.** This
upgrades `Stacks.AlmostBlowUp.relationIdeal_le_ker_centerReesPresentation` from `≤` to `=`: the
Rees algebra of an ideal generated by a regular sequence `f₁, f₂` is exactly
`A[T₀,T₁]/(f₂T₀-f₁T₁)`, with no relation beyond the obvious one.

A polynomial is reduced to its homogeneous components, which the presentation keeps apart
because they land in different degrees of the Rees algebra, and each component is handled by
`Stacks.AlmostBlowUp.mem_relationIdeal_of_isHomogeneous_of_eval_eq_zero`. -/
theorem ker_centerReesPresentation_eq_relationIdeal
    (hreg : RingTheory.Sequence.IsWeaklyRegular A [f₁, f₂]) :
    RingHom.ker (centerReesPresentation A f₁ f₂).toRingHom = relationIdeal A f₁ f₂ := by
  rw [RingTheory.Sequence.isWeaklyRegular_cons_iff,
    RingTheory.Sequence.isWeaklyRegular_singleton_iff] at hreg
  obtain ⟨h1, h2⟩ := hreg
  have hspan : f₁ • (⊤ : Submodule A A) = Ideal.span ({f₁} : Set A) := by
    ext c
    simp only [Submodule.mem_smul_pointwise_iff_exists, Submodule.mem_top, true_and,
      smul_eq_mul, Ideal.mem_span_singleton]
    exact ⟨fun ⟨b, hb⟩ => ⟨b, hb.symm⟩, fun ⟨b, hb⟩ => ⟨b, hb.symm⟩⟩
  have hf₁ : ∀ a : A, f₁ * a = 0 → a = 0 :=
    fun a ha => h1 (show f₁ • a = f₁ • 0 by simpa using ha)
  have hf₂ : ∀ a : A, f₂ * a ∈ Ideal.span ({f₁} : Set A) → a ∈ Ideal.span ({f₁} : Set A) := by
    intro a ha
    have h2' : IsSMulRegular (A ⧸ (f₁ • ⊤ : Submodule A A)) f₂ := h2
    rw [isSMulRegular_quotient_iff_mem_of_smul_mem] at h2'
    have h3 := h2' a (by rw [hspan]; simpa using ha)
    rwa [hspan] at h3
  refine le_antisymm (fun p hp => ?_) (relationIdeal_le_ker_centerReesPresentation A f₁ f₂)
  rw [MvPolynomial.mem_iff_homogeneousComponent_mem (relationIdeal_isHomogeneous A f₁ f₂)]
  intro n
  exact mem_relationIdeal_of_isHomogeneous_of_eval_eq_zero A f₁ f₂ hf₁ hf₂
    (MvPolynomial.homogeneousComponent_isHomogeneous n p)
    (eval_homogeneousComponent_eq_zero_of_mem_ker A f₁ f₂ (RingHom.mem_ker.mp hp) n)

/-- **The presentation of the Rees algebra by the modification ring is injective** when `f₁, f₂`
is a regular sequence: by `Stacks.AlmostBlowUp.ker_centerReesPresentation_eq_relationIdeal` the
relation `f₂T₀-f₁T₁` already cuts out the whole kernel of the polynomial presentation. -/
theorem injective_reesQuotPresentation
    (hreg : RingTheory.Sequence.IsWeaklyRegular A [f₁, f₂]) :
    Function.Injective (reesQuotPresentation A f₁ f₂) := by
  intro a b hab
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective a
  obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective b
  rw [reesQuotPresentation_mk, reesQuotPresentation_mk] at hab
  rw [Ideal.Quotient.eq, ← ker_centerReesPresentation_eq_relationIdeal A f₁ f₂ hreg,
    RingHom.mem_ker, map_sub, hab, sub_self]

/-- **For a regular sequence of length two the modification ring is the Rees algebra of the
centre.** The presentation is surjective in general and injective here, so it is a graded
isomorphism `A[T₀,T₁]/(f₂T₀-f₁T₁) ≅ ⨁ₙ (f₁,f₂)ⁿ`. -/
theorem bijective_reesQuotPresentation
    (hreg : RingTheory.Sequence.IsWeaklyRegular A [f₁, f₂]) :
    Function.Bijective (reesQuotPresentation A f₁ f₂) :=
  ⟨injective_reesQuotPresentation A f₁ f₂ hreg, surjective_reesQuotPresentation A f₁ f₂⟩

end Stacks.AlmostBlowUp

end
