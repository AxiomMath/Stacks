module

public import StacksFrontier.AlgebraicGeometry.Blowup.ExceptionalChart
public import StacksFrontier.AlgebraicGeometry.Blowup.StrictTransformChartTorsion
public import StacksFrontier.AlgebraicGeometry.Divisors.LocallyPrincipalComplementAffine
public import StacksFrontier.AlgebraicGeometry.DivisorFlatPullback.Basic
public import StacksFrontier.AlgebraicGeometry.StrictTransform.Quasicoherent

/-!
# The torsion description of the strict transform, on a chart of a blowup

`Stacks.StrictTransform.sectionsSheafEquivQuotientTorsion` computes the sections of the
sheaf-level strict transform over an affine open `V` of the base change `X ×_S S'` as the
sections of `pr_X^* F` modulo `a`-power torsion, under the hypothesis that the inverse image of
the ideal sheaf `E` is generated on `V` by a single section `a`. This file discharges that
hypothesis in the case the construction is meant for: `b` the blowup of `S` in a quasi-coherent
ideal sheaf `ℐ`, `E` its exceptional ideal, and `V` an affine open of the base change lying over
an affine chart of the blowup.

The generator on the chart itself is `Stacks.Blowup.exceptionalChartSection`
([Stacks, Tag 02OS], second assertion, affine-local form). What is supplied here is its passage
across `pr_{S'}`: the inverse image of a principal ideal sheaf on an affine open is generated by
the image of the generator, so on `V` the inverse image of the exceptional ideal is generated by
the restriction of `Stacks.Blowup.exceptionalChartSection` along `pr_{S'}`.

## Main results

* `Stacks.IdealSheaf.ideal_comap_eq_span`: the inverse image of an ideal sheaf generated on an
  affine open by one section is generated on any affine open of the source above it by the image
  of that section.
* `Stacks.StrictTransform.quasiCompact_ι_compl_support_exceptionalIdeal_blowUp`: the complement
  of the exceptional divisor of `Stacks.Blowup.blowUp` has quasi-compact inclusion.
* `Stacks.StrictTransform.ideal_comap_exceptionalIdeal_blowUpAffineChart`: on an affine open of
  the base change lying over an affine chart of the blowup, the inverse image of the exceptional
  ideal is generated by one section, named explicitly.
* `Stacks.StrictTransform.sectionsSheafEquivQuotientTorsionBlowUpChart`: **the chart comparison
  for a blowup, with no hypothesis.** The sections of the strict transform over such an affine
  open are the sections of `pr_X^* F` modulo the torsion for the powers of that section.

## References

* [Stacks Project, Tag 02OS](https://stacks.math.columbia.edu/tag/02OS)
* [Stacks Project, Tag 053H](https://stacks.math.columbia.edu/tag/053H)
* [Stacks Project, Tag 080D](https://stacks.math.columbia.edu/tag/080D)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

universe u

namespace Stacks.IdealSheaf

/-- **The inverse image of a principal ideal sheaf is principal.** If the ideal of `I` on an
affine open `W` of the target is generated by a section `t`, then the ideal of `I.comap g` on any
affine open `V` of the source lying in `g⁻¹W` is generated by the image of `t` under
`g.appLE W V`. -/
theorem ideal_comap_eq_span {X Y : Scheme.{u}} (I : Y.IdealSheafData) (g : X ⟶ Y)
    (W : Y.affineOpens) (V : X.affineOpens) (hVW : (V : X.Opens) ≤ g ⁻¹ᵁ (W : Y.Opens))
    {t : Γ(Y, W.1)} (ht : I.ideal W = Ideal.span {t}) :
    (I.comap g).ideal V = Ideal.span {(g.appLE W.1 V.1 hVW).hom t} := by
  rw [ideal_comap_appLE I g W V hVW, ht, Ideal.map_span, Set.image_singleton]

end Stacks.IdealSheaf

namespace Stacks.StrictTransform

variable {X S : Scheme.{u}} (f : X ⟶ S) (ℐ : S.IdealSheafData)

/-- The complement of the support of the exceptional ideal of `Stacks.Blowup.blowUp` has
quasi-compact inclusion: the exceptional ideal is locally principal
(`Stacks.Blowup.isLocallyPrincipal_exceptionalIdeal`, [Stacks, Tag 02OS]), so that inclusion is
an affine morphism, and an affine morphism is quasi-compact.

This is `Stacks.StrictTransform.quasiCompact_ι_compl_support_exceptionalIdeal` for the other
model of the blowup; it is what makes the comparisons below hypothesis-free. -/
instance quasiCompact_ι_compl_support_exceptionalIdeal_blowUp :
    QuasiCompact (Scheme.Opens.ι (Stacks.Blowup.exceptionalIdeal ℐ).support.compl) := by
  have := Stacks.Divisors.isAffineHom_compl_of_isLocallyPrincipal
    (Stacks.Blowup.exceptionalIdeal ℐ) (Stacks.Blowup.isLocallyPrincipal_exceptionalIdeal ℐ)
  infer_instance

/-- **On an affine open of the base change lying over an affine chart of the blowup, the inverse
image of the exceptional ideal is generated by one section.** The generator is the image under
`pr_{S'}` of `Stacks.Blowup.exceptionalChartSection`, the generator on the chart itself.

This discharges the hypothesis `ha` of
`Stacks.StrictTransform.sectionsSheafEquivQuotientTorsion` for a blowup. -/
theorem ideal_comap_exceptionalIdeal_blowUpAffineChart (U : S.affineOpens) {a : Γ(S, U.1)}
    (ha : a ∈ ℐ.ideal U)
    (V : (baseChange f (Stacks.Blowup.blowUpToBase ℐ)).affineOpens)
    (hV : (V.1 : (baseChange f (Stacks.Blowup.blowUpToBase ℐ)).Opens) ≤
      pullback.snd f (Stacks.Blowup.blowUpToBase ℐ) ⁻¹ᵁ
        (Stacks.Blowup.blowUpAffineChart ℐ U ha ''ᵁ ⊤)) :
    ((Stacks.Blowup.exceptionalIdeal ℐ).comap
          (pullback.snd f (Stacks.Blowup.blowUpToBase ℐ))).ideal V =
      Ideal.span {((pullback.snd f (Stacks.Blowup.blowUpToBase ℐ)).appLE
        (Stacks.Blowup.blowUpAffineChart ℐ U ha ''ᵁ ⊤) V.1 hV).hom
          (Stacks.Blowup.exceptionalChartSection ℐ U ha)} :=
  Stacks.IdealSheaf.ideal_comap_eq_span _ _
    ⟨_, (isAffineOpen_top _).image_of_isOpenImmersion _⟩ V hV
    (Stacks.Blowup.ideal_exceptionalIdeal_blowUpAffineChart ℐ U ha)

/-- **The sheaf-level strict transform on a chart of a blowup, with no hypothesis.** For `b` the
blowup of `S` in a quasi-coherent ideal sheaf `ℐ` and `E` its exceptional ideal, the sections of
the strict transform of a quasi-coherent module `F` over an affine open `V` of `X ×_S S'` lying
over an affine chart of the blowup are the sections of `pr_X^* F` over `V` modulo their torsion
for the powers of the image of `Stacks.Blowup.exceptionalChartSection`.

This is `Stacks.StrictTransform.sectionsSheafEquivQuotientTorsion` with both of its hypotheses
discharged: the generator by
`Stacks.StrictTransform.ideal_comap_exceptionalIdeal_blowUpAffineChart`, and the quasi-compactness
of the complement of the exceptional preimage by
`Stacks.StrictTransform.quasiCompact_ι_compl_support_exceptionalIdeal_blowUp` together with
`Stacks.StrictTransform.quasiCompact_exceptionalComplement_ι`. -/
def sectionsSheafEquivQuotientTorsionBlowUpChart (F : X.Modules) [F.IsQuasicoherent]
    (U : S.affineOpens) {a : Γ(S, U.1)} (ha : a ∈ ℐ.ideal U)
    (V : (baseChange f (Stacks.Blowup.blowUpToBase ℐ)).affineOpens)
    (hV : (V.1 : (baseChange f (Stacks.Blowup.blowUpToBase ℐ)).Opens) ≤
      pullback.snd f (Stacks.Blowup.blowUpToBase ℐ) ⁻¹ᵁ
        (Stacks.Blowup.blowUpAffineChart ℐ U ha ''ᵁ ⊤)) :
    (Γ((Scheme.Modules.pullback
            (pullback.fst f (Stacks.Blowup.blowUpToBase ℐ))).obj F, V.1) ⧸
          Submodule.torsion' Γ(baseChange f (Stacks.Blowup.blowUpToBase ℐ), V.1)
            Γ((Scheme.Modules.pullback
              (pullback.fst f (Stacks.Blowup.blowUpToBase ℐ))).obj F, V.1)
            (Submonoid.powers
              (((pullback.snd f (Stacks.Blowup.blowUpToBase ℐ)).appLE
                (Stacks.Blowup.blowUpAffineChart ℐ U ha ''ᵁ ⊤) V.1 hV).hom
                  (Stacks.Blowup.exceptionalChartSection ℐ U ha))))
        ≃ₗ[Γ(baseChange f (Stacks.Blowup.blowUpToBase ℐ), V.1)]
      Γ(sheaf f (Stacks.Blowup.blowUpToBase ℐ) (Stacks.Blowup.exceptionalIdeal ℐ) F, V.1) :=
  sectionsSheafEquivQuotientTorsion f (Stacks.Blowup.blowUpToBase ℐ)
    (Stacks.Blowup.exceptionalIdeal ℐ) F V _
    (ideal_comap_exceptionalIdeal_blowUpAffineChart f ℐ U ha V hV)

end Stacks.StrictTransform

end
