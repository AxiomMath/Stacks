/-!
# The remaining almost blowup square conditions for the two-generator square

For `f₁, f₂` in a commutative ring `A`, the two-generator square of
`StacksFrontier/AlgebraicGeometry/TwoGeneratorSquare.lean` has modification
`b : X' = Proj (A[T₀,T₁]/(f₂T₀-f₁T₁)) ⟶ X = Spec A` and centre `Z = Spec (A/(f₁,f₂))`. This file
proves two of the four conditions in the definition of an almost blowup square for it:

* `b` is of finite presentation;
* the inverse image `E = b^{-1}(Z)` is a locally principal closed subscheme of `X'`.

Together with `Stacks.AlmostBlowUp.finitePresentation_centerIdealSheaf_subschemeι` (the centre is
a closed immersion of finite presentation) and
`Stacks.AlmostBlowUp.isProper_modificationToBase` (the modification is proper), this leaves only
the identification of the sections supported on `E` with the blowup.

## Main definitions

* `Stacks.AlmostBlowUp.modificationCoord`: the class of a homogeneous coordinate `Tᵢ` in
  `A[T₀,T₁]/(f₂T₀-f₁T₁)`.
* `Stacks.AlmostBlowUp.chartAwayMap`: the structure map `A ⟶ (A[T₀,T₁]/(f₂T₀-f₁T₁))_{(Tᵢ)}` of
  the affine chart `D₊(Tᵢ)` of the modification.
* `Stacks.AlmostBlowUp.chartDiv`: the degree-zero fraction `Tⱼ/Tᵢ` on that chart.
* `Stacks.AlmostBlowUp.chartImage`: the affine open of the modification underlying the chart.

## Main results

* `Stacks.AlmostBlowUp.finitePresentation_modificationToBase`: **the modification is of finite
  presentation**, the fourth of the five conditions of
  `AlgebraicGeometry.IsAlmostBlowUpSquare` for the two-generator square.
* `Stacks.AlmostBlowUp.map_centerIdeal_chartAwayMap`: on the chart `D₊(T₀)` the ideal generated
  by the image of `(f₁,f₂)` is generated by the image of `f₁` alone, and symmetrically on
  `D₊(T₁)` by the image of `f₂`.
* `Stacks.AlmostBlowUp.isLocallyPrincipal_comap_centerIdealSheaf`: **the inverse image of the
  centre is locally principal**, the second of the five conditions of
  `AlgebraicGeometry.IsAlmostBlowUpSquare` for the two-generator square.

## Implementation notes

Finite presentation is assembled from the affine case of Tag 0D4D,
`Stacks.AlgebraicGeometry.Proj.locallyOfFinitePresentation_projToSpec`, which is stated for a
grading by *submodules*; the submodule spelling of the modification grading and the comparison of
the two structure morphisms are already in
`StacksFrontier/AlgebraicGeometry/Blowup/TwoGeneratorPullback.lean`, so all that is needed here is
that `A[T₀,T₁]/(f₂T₀-f₁T₁)` is a finitely presented `A`-algebra — a quotient of a polynomial ring
in two variables by a principal ideal — and the transport along the comparison isomorphism.
Quasi-compactness and quasi-separatedness come from properness.

Local principality is proved on the two standard affine charts, following the pattern of
`Stacks.Blowup.exists_isRegular_ideal_comap_toSpec_eq_span`: the affine open around a point is
the *image of the top open* under `AlgebraicGeometry.Proj.awayι`, which is the spelling for which
`AlgebraicGeometry.Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion` applies with no
transport. The chart computation itself is the relation of the square read as a fraction
identity: on `D₊(T₀)` one has `f₂ = f₁ · (T₁/T₀)`, because `f₂T₀ = f₁T₁` in the modification
ring, so the two generators of the centre collapse to one. The two charts cover because a
homogeneous element of positive degree of a polynomial ring lies in the ideal generated by the
variables (`Stacks.AlgebraicGeometry.SegreChartProduct.mem_span_X_of_isHomogeneous`), and the
modification grading is the degreewise image of the polynomial grading.

## References

* [Stacks Project, Tag 0EVH](https://stacks.math.columbia.edu/tag/0EVH)
* [Stacks Project, Tag 0EV6](https://stacks.math.columbia.edu/tag/0EV6)
* [Stacks Project, Tag 0D4D](https://stacks.math.columbia.edu/tag/0D4D)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CommRingCat HomogeneousLocalization

universe u

namespace Stacks.AlmostBlowUp

attribute [local instance] MvPolynomial.gradedAlgebra modificationSubmoduleGraded

variable (A : Type u) [CommRing A] (f₁ f₂ : A)

/-! ### The modification is of finite presentation -/

/-- `A[T₀,T₁]/(f₂T₀-f₁T₁)` is a finitely presented `A`-algebra: it is a polynomial ring in two
variables modulo a principal, hence finitely generated, ideal. -/
instance finitePresentation_modificationRing :
    Algebra.FinitePresentation A (modificationRing A f₁ f₂) :=
  Algebra.FinitePresentation.quotient (Submodule.fg_span (Set.finite_singleton _))

/-- **The two-generator modification is locally of finite presentation over `Spec A`.** The
modification ring is a finitely presented `A`-algebra, so this is the affine case of Tag 0D4D
read through the comparison of the submodule and additive-subgroup spellings of the modification
grading. -/
theorem locallyOfFinitePresentation_modificationToBase :
    LocallyOfFinitePresentation (modificationToBase A f₁ f₂) := by
  let : GradedRing (modificationGrading A f₁ f₂) := modificationGradedRing A f₁ f₂
  have h := Stacks.AlgebraicGeometry.Proj.locallyOfFinitePresentation_projToSpec
    (modificationSubmoduleGrading A f₁ f₂)
  rw [projIso_hom_comp_modificationToBase A f₁ f₂] at h
  have hiso : LocallyOfFinitePresentation
      (Stacks.GradedRegrading.projIso (coe_modificationSubmoduleGrading A f₁ f₂)).inv :=
    inferInstance
  have hcomp := MorphismProperty.comp_mem (@LocallyOfFinitePresentation) _ _ hiso h
  rw [← Category.assoc, Iso.inv_hom_id, Category.id_comp] at hcomp
  exact hcomp

/-- **The two-generator modification is of finite presentation over `Spec A`.** It is locally of
finite presentation, and quasi-compact and quasi-separated because it is proper. This is the
fourth of the five conditions of `AlgebraicGeometry.IsAlmostBlowUpSquare` for the square. -/
theorem finitePresentation_modificationToBase :
    FinitePresentation (modificationToBase A f₁ f₂) := by
  have : IsProper (modificationToBase A f₁ f₂) := isProper_modificationToBase A f₁ f₂
  exact ⟨locallyOfFinitePresentation_modificationToBase A f₁ f₂, inferInstance, inferInstance⟩

/-! ### The homogeneous coordinates of the modification -/

/-- The class of the homogeneous coordinate `Tᵢ` in `A[T₀,T₁]/(f₂T₀-f₁T₁)`. -/
def modificationCoord (i : Fin 2) : modificationRing A f₁ f₂ :=
  Ideal.Quotient.mk (relationIdeal A f₁ f₂) (MvPolynomial.X i)

/-- The class of a homogeneous coordinate is homogeneous of degree one. -/
theorem modificationCoord_mem (i : Fin 2) :
    modificationCoord A f₁ f₂ i ∈ modificationGrading A f₁ f₂ 1 := by
  show Ideal.Quotient.mk (relationIdeal A f₁ f₂) (MvPolynomial.X i) ∈
    (MvPolynomial.homogeneousSubmodule (Fin 2) A 1).toAddSubgroup.map
      (Ideal.Quotient.mk (relationIdeal A f₁ f₂)).toAddMonoidHom
  exact AddSubgroup.mem_map.mpr ⟨MvPolynomial.X i,
    (MvPolynomial.mem_homogeneousSubmodule 1 _).2 (MvPolynomial.isHomogeneous_X A i), rfl⟩

/-- The relation of the square, read in the modification ring: `f₂T₀ = f₁T₁`. -/
theorem C_mul_coord_eq :
    Ideal.Quotient.mk (relationIdeal A f₁ f₂) (MvPolynomial.C f₂) *
        modificationCoord A f₁ f₂ 0 =
      Ideal.Quotient.mk (relationIdeal A f₁ f₂) (MvPolynomial.C f₁) *
        modificationCoord A f₁ f₂ 1 := by
  rw [modificationCoord, modificationCoord, ← map_mul, ← map_mul, ← sub_eq_zero, ← map_sub]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)

/-! ### The affine charts of the modification -/

section Graded

variable [GradedRing (modificationGrading A f₁ f₂)]

/-- The structure map of the affine chart `D₊(Tᵢ)` of the modification: the identification of `A`
with the degree-zero part of `A[T₀,T₁]/(f₂T₀-f₁T₁)` followed by the inclusion of that degree-zero
part into the degree-zero part of the localization at `Tᵢ`. -/
def chartAwayMap (i : Fin 2) :
    A →+* Away (modificationGrading A f₁ f₂) (modificationCoord A f₁ f₂ i) :=
  (fromZeroRingHom (modificationGrading A f₁ f₂)
    (Submonoid.powers (modificationCoord A f₁ f₂ i))).comp (baseRingHom A f₁ f₂)

/-- The value of `chartAwayMap A f₁ f₂ i a` in the localization is the fraction `a / 1`. -/
theorem chartAwayMap_val (i : Fin 2) (a : A) :
    (chartAwayMap A f₁ f₂ i a).val =
      Localization.mk (Ideal.Quotient.mk (relationIdeal A f₁ f₂) (MvPolynomial.C a)) 1 := by
  show (HomogeneousLocalization.mk ⟨0, _, 1, _⟩).val = _
  rw [HomogeneousLocalization.val_mk]
  rfl

/-- The degree-zero fraction `Tⱼ/Tᵢ` on the chart `D₊(Tᵢ)`. -/
def chartDiv (i j : Fin 2) :
    Away (modificationGrading A f₁ f₂) (modificationCoord A f₁ f₂ i) :=
  HomogeneousLocalization.mk
    ⟨1, ⟨modificationCoord A f₁ f₂ j, modificationCoord_mem A f₁ f₂ j⟩,
      ⟨modificationCoord A f₁ f₂ i, modificationCoord_mem A f₁ f₂ i⟩, ⟨1, pow_one _⟩⟩

/-- On the chart `D₊(Tᵢ)`, a relation `x·Tᵢ = y·Tⱼ` makes `x` equal to `y` times `Tⱼ/Tᵢ`. -/
private theorem chartAwayMap_eq_mul_chartDiv (i j : Fin 2) {x y : A}
    (h : Ideal.Quotient.mk (relationIdeal A f₁ f₂) (MvPolynomial.C x) *
        modificationCoord A f₁ f₂ i =
      Ideal.Quotient.mk (relationIdeal A f₁ f₂) (MvPolynomial.C y) *
        modificationCoord A f₁ f₂ j) :
    chartAwayMap A f₁ f₂ i x = chartAwayMap A f₁ f₂ i y * chartDiv A f₁ f₂ i j := by
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mul, chartAwayMap_val, chartAwayMap_val, chartDiv,
    HomogeneousLocalization.val_mk, Localization.mk_mul, Localization.mk_eq_mk_iff,
    Localization.r_iff_exists]
  refine ⟨1, ?_⟩
  simpa [mul_comm] using h

/-- **On the chart `D₊(T₀)` the element `f₂` is `f₁` times the fraction `T₁/T₀`.** This is the
relation `f₂T₀ = f₁T₁` of the square, read as an identity of degree-zero fractions. -/
theorem chartAwayMap_zero_f₂ :
    chartAwayMap A f₁ f₂ 0 f₂ = chartAwayMap A f₁ f₂ 0 f₁ * chartDiv A f₁ f₂ 0 1 :=
  chartAwayMap_eq_mul_chartDiv A f₁ f₂ 0 1 (C_mul_coord_eq A f₁ f₂)

/-- **On the chart `D₊(T₁)` the element `f₁` is `f₂` times the fraction `T₀/T₁`.** -/
theorem chartAwayMap_one_f₁ :
    chartAwayMap A f₁ f₂ 1 f₁ = chartAwayMap A f₁ f₂ 1 f₂ * chartDiv A f₁ f₂ 1 0 :=
  chartAwayMap_eq_mul_chartDiv A f₁ f₂ 1 0 (C_mul_coord_eq A f₁ f₂).symm

/-- Two elements, one of which is a multiple of the other, span the principal ideal generated by
the other. -/
private theorem span_pair_eq_span_singleton {R : Type*} [CommRing R] {a b : R}
    (h : b ∈ Ideal.span {a}) : Ideal.span {a, b} = Ideal.span {a} :=
  le_antisymm (Ideal.span_le.mpr fun x hx => by
      rcases hx with rfl | hx
      · exact Ideal.subset_span rfl
      · rw [Set.mem_singleton_iff] at hx
        exact hx ▸ h)
    (Ideal.span_mono (Set.singleton_subset_iff.mpr (by simp)))

/-- **On the chart `D₊(Tᵢ)` the centre becomes a principal ideal.** For a pair `(c, d)` of
elements of `A` in which `d` is divisible by `c` on the chart — which by
`Stacks.AlmostBlowUp.chartAwayMap_zero_f₂` and `Stacks.AlmostBlowUp.chartAwayMap_one_f₁` is the
case for `(f₁, f₂)` on `D₊(T₀)` and for `(f₂, f₁)` on `D₊(T₁)` — the ideal generated by the image
of `(f₁,f₂)` is generated by the image of `c`. -/
theorem map_centerIdeal_chartAwayMap (i : Fin 2) {c d : A}
    (hcd : Ideal.span ({f₁, f₂} : Set A) = Ideal.span {c, d})
    (hdvd : chartAwayMap A f₁ f₂ i d ∈ Ideal.span {chartAwayMap A f₁ f₂ i c}) :
    Ideal.map (chartAwayMap A f₁ f₂ i) (centerIdeal A f₁ f₂) =
      Ideal.span {chartAwayMap A f₁ f₂ i c} := by
  rw [centerIdeal, hcd, Ideal.map_span, Set.image_insert_eq, Set.image_singleton]
  exact span_pair_eq_span_singleton hdvd

/-- The chart inclusion `Spec (A[T₀,T₁]/(f₂T₀-f₁T₁))_{(Tᵢ)} ⟶ Proj (A[T₀,T₁]/(f₂T₀-f₁T₁))`. -/
abbrev awayChartι (i : Fin 2) :
    Spec (CommRingCat.of (Away (modificationGrading A f₁ f₂)
        (modificationCoord A f₁ f₂ i))) ⟶
      AlgebraicGeometry.Proj (modificationGrading A f₁ f₂) :=
  Proj.awayι (modificationGrading A f₁ f₂) (modificationCoord A f₁ f₂ i)
    (modificationCoord_mem A f₁ f₂ i) Nat.one_pos

/-- The affine open of the modification underlying the chart `D₊(Tᵢ)`: the image of the top open
under the chart inclusion. It is the standard open `D₊(Tᵢ)`, by
`Stacks.AlmostBlowUp.chartImage_eq_basicOpen`. -/
def chartImage (i : Fin 2) :
    (AlgebraicGeometry.Proj (modificationGrading A f₁ f₂)).Opens :=
  awayChartι A f₁ f₂ i ''ᵁ ⊤

/-- The image of the chart `D₊(Tᵢ)` is the standard open `D₊(Tᵢ)` of the modification. -/
theorem chartImage_eq_basicOpen (i : Fin 2) :
    chartImage A f₁ f₂ i =
      Proj.basicOpen (modificationGrading A f₁ f₂) (modificationCoord A f₁ f₂ i) := by
  rw [chartImage, Scheme.Hom.image_top_eq_opensRange]
  exact Proj.opensRange_awayι _ _ _ _

/-- The image of the chart `D₊(Tᵢ)` is an affine open of the modification. -/
theorem isAffineOpen_chartImage (i : Fin 2) : IsAffineOpen (chartImage A f₁ f₂ i) :=
  (isAffineOpen_top _).image_of_isOpenImmersion _

end Graded

/-! ### The two charts cover the modification -/

/-- The irrelevant ideal of the modification grading is generated by the classes of the two
homogeneous coordinates: a homogeneous element of positive degree is the class of a homogeneous
polynomial of that degree, which lies in the ideal generated by the variables. -/
theorem irrelevant_le_span_modificationCoord :
    letI := (twoGeneratorSquare A f₁ f₂).modificationGraded
    (HomogeneousIdeal.irrelevant (modificationGrading A f₁ f₂)).toIdeal ≤
      Ideal.span (Set.range (modificationCoord A f₁ f₂)) := by
  let := (twoGeneratorSquare A f₁ f₂).modificationGraded
  refine (HomogeneousIdeal.toIdeal_irrelevant_le _).mpr fun d hd x hx => ?_
  obtain ⟨p, hp, rfl⟩ := AddSubgroup.mem_map.mp hx
  have hpspan : p ∈ Ideal.span (Set.range (MvPolynomial.X : Fin 2 → MvPolynomial (Fin 2) A)) :=
    Stacks.AlgebraicGeometry.SegreChartProduct.mem_span_X_of_isHomogeneous A (Fin 2) hd
      ((MvPolynomial.mem_homogeneousSubmodule d p).mp (Submodule.mem_toAddSubgroup _ |>.mp hp))
  have hmap := Ideal.mem_map_of_mem (Ideal.Quotient.mk (relationIdeal A f₁ f₂)) hpspan
  rwa [Ideal.map_span, ← Set.range_comp] at hmap

/-- **The two standard opens `D₊(T₀)` and `D₊(T₁)` cover the modification.** -/
theorem iSup_basicOpen_modificationCoord_eq_top :
    letI := (twoGeneratorSquare A f₁ f₂).modificationGraded
    (⨆ i : Fin 2, Proj.basicOpen (modificationGrading A f₁ f₂)
      (modificationCoord A f₁ f₂ i)) = ⊤ :=
  let := (twoGeneratorSquare A f₁ f₂).modificationGraded
  Proj.iSup_basicOpen_eq_top _ _ (irrelevant_le_span_modificationCoord A f₁ f₂)

/-! ### The inverse image of the centre is locally principal -/

section Graded

variable [GradedRing (modificationGrading A f₁ f₂)]

/-- The sections of the modification over the chart `D₊(Tᵢ)`, identified with the degree-zero
part of the localization at `Tᵢ`. -/
abbrev chartSections (i : Fin 2) :
    Γ(AlgebraicGeometry.Proj (modificationGrading A f₁ f₂), chartImage A f₁ f₂ i) ≅
      Γ(Spec (CommRingCat.of (Away (modificationGrading A f₁ f₂)
        (modificationCoord A f₁ f₂ i))), ⊤) :=
  (awayChartι A f₁ f₂ i).appIso ⊤

/-- The global sections of the spectrum of a chart ring, identified with that ring. -/
abbrev chartGamma (i : Fin 2) :
    Γ(Spec (CommRingCat.of (Away (modificationGrading A f₁ f₂)
        (modificationCoord A f₁ f₂ i))), ⊤) ≅
      CommRingCat.of (Away (modificationGrading A f₁ f₂) (modificationCoord A f₁ f₂ i)) :=
  Scheme.ΓSpecIso _

end Graded

/-- The chart inclusion followed by the modification is `Spec` of the chart structure map. -/
theorem awayι_comp_modificationToBase (i : Fin 2) :
    letI := (twoGeneratorSquare A f₁ f₂).modificationGraded
    awayChartι A f₁ f₂ i ≫ modificationToBase A f₁ f₂ =
      Spec.map (CommRingCat.ofHom (chartAwayMap A f₁ f₂ i)) := by
  let := (twoGeneratorSquare A f₁ f₂).modificationGraded
  rw [modificationToBase, ← Category.assoc, Proj.awayι_toSpecZero, ← Spec.map_comp]
  rfl

/-- The ideal of global sections cut out by the ideal sheaf of the centre is the ideal `(f₁,f₂)`,
read through the counit `Γ(Spec A, ⊤) ≅ A`. -/
theorem map_ideal_centerIdealSheaf_top :
    Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom
        ((centerIdealSheaf A f₁ f₂).ideal ⟨⊤, isAffineOpen_top _⟩) =
      centerIdeal A f₁ f₂ := by
  have h1 : (centerIdealSheaf A f₁ f₂).ideal ⟨⊤, isAffineOpen_top _⟩ =
      Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom (centerIdeal A f₁ f₂) := by
    rw [centerIdealSheaf, Scheme.IdealSheafData.ofIdealTop_ideal,
      show (homOfLE (le_top (a := (⊤ : (Spec (CommRingCat.of A)).Opens)))) = 𝟙 _ from rfl]
    simp
  rw [h1, Ideal.map_map, ← CommRingCat.hom_comp,
    (Scheme.ΓSpecIso (CommRingCat.of A)).inv_hom_id, CommRingCat.hom_id, Ideal.map_id]

/-- Stated at abstract rings and applied rather than rewritten in place: the carriers are
sections of the modification, whose `whnf` is large. -/
private theorem map_span_singleton {R S : CommRingCat.{u}} (φ : R ⟶ S) (x : R) :
    Ideal.map φ.hom (Ideal.span {x}) = Ideal.span {φ.hom x} := by
  rw [Ideal.map_span, Set.image_singleton]

private theorem map_span_singleton_iso {R S : CommRingCat.{u}} (e : R ≅ S) (x : S) :
    Ideal.map e.hom.hom (Ideal.span {e.inv.hom x}) = Ideal.span {x} := by
  rw [map_span_singleton, ← CommRingCat.comp_apply, e.inv_hom_id, CommRingCat.id_apply]

/-- **The inverse image of the centre is principal on the chart `D₊(Tᵢ)`.** -/
theorem ideal_comap_modificationToBase_chartImage (i : Fin 2) {c d : A}
    (hcd : Ideal.span ({f₁, f₂} : Set A) = Ideal.span {c, d})
    (hdvd : letI := (twoGeneratorSquare A f₁ f₂).modificationGraded
      chartAwayMap A f₁ f₂ i d ∈ Ideal.span {chartAwayMap A f₁ f₂ i c}) :
    letI := (twoGeneratorSquare A f₁ f₂).modificationGraded
    ((centerIdealSheaf A f₁ f₂).comap (modificationToBase A f₁ f₂)).ideal
        ⟨chartImage A f₁ f₂ i, isAffineOpen_chartImage A f₁ f₂ i⟩ =
      Ideal.span {(chartSections A f₁ f₂ i).inv.hom
                    ((chartGamma A f₁ f₂ i).inv.hom (chartAwayMap A f₁ f₂ i c))} := by
  let := (twoGeneratorSquare A f₁ f₂).modificationGraded
  set J := centerIdealSheaf A f₁ f₂ with hJdef
  have hcomap : (J.comap (modificationToBase A f₁ f₂)).comap (awayChartι A f₁ f₂ i) =
      J.comap (Spec.map (CommRingCat.ofHom (chartAwayMap A f₁ f₂ i))) := by
    rw [← Scheme.IdealSheafData.comap_comp]
    exact congrArg (J.comap ·) (awayι_comp_modificationToBase A f₁ f₂ i)
  have hstep : ((J.comap (modificationToBase A f₁ f₂)).comap
        (awayChartι A f₁ f₂ i)).ideal ⟨⊤, isAffineOpen_top _⟩ =
      Ideal.map (Spec.map (CommRingCat.ofHom (chartAwayMap A f₁ f₂ i))).appTop.hom
        (J.ideal ⟨⊤, isAffineOpen_top _⟩) := by
    rw [hcomap]
    exact Stacks.IdealSheaf.ideal_comap_top_of_isAffine _ _
  have happ : (Spec.map (CommRingCat.ofHom (chartAwayMap A f₁ f₂ i))).appTop =
      ((Scheme.ΓSpecIso (CommRingCat.of A)).hom ≫
        CommRingCat.ofHom (chartAwayMap A f₁ f₂ i)) ≫ (chartGamma A f₁ f₂ i).inv := by
    rw [Iso.eq_comp_inv]
    exact Scheme.ΓSpecIso_naturality _
  have h1 : Ideal.map (Spec.map (CommRingCat.ofHom (chartAwayMap A f₁ f₂ i))).appTop.hom
        (J.ideal ⟨⊤, isAffineOpen_top _⟩) =
      Ideal.map (chartGamma A f₁ f₂ i).inv.hom (Ideal.map (chartAwayMap A f₁ f₂ i)
        (Ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom
          (J.ideal ⟨⊤, isAffineOpen_top _⟩))) := by
    rw [happ, CommRingCat.hom_comp, ← Ideal.map_map, CommRingCat.hom_comp, ← Ideal.map_map,
      CommRingCat.hom_ofHom]
  have hmap : Ideal.map (Spec.map (CommRingCat.ofHom (chartAwayMap A f₁ f₂ i))).appTop.hom
        (J.ideal ⟨⊤, isAffineOpen_top _⟩) =
      Ideal.span {(chartGamma A f₁ f₂ i).inv.hom (chartAwayMap A f₁ f₂ i c)} :=
    calc Ideal.map (Spec.map (CommRingCat.ofHom (chartAwayMap A f₁ f₂ i))).appTop.hom
          (J.ideal ⟨⊤, isAffineOpen_top _⟩)
        = Ideal.map (chartGamma A f₁ f₂ i).inv.hom
            (Ideal.map (chartAwayMap A f₁ f₂ i) (centerIdeal A f₁ f₂)) := by
          rw [h1, map_ideal_centerIdealSheaf_top A f₁ f₂]
      _ = Ideal.map (chartGamma A f₁ f₂ i).inv.hom
            (Ideal.span {chartAwayMap A f₁ f₂ i c}) :=
          congrArg _ (map_centerIdeal_chartAwayMap A f₁ f₂ i hcd hdvd)
      _ = Ideal.span {(chartGamma A f₁ f₂ i).inv.hom (chartAwayMap A f₁ f₂ i c)} :=
          map_span_singleton (chartGamma A f₁ f₂ i).inv _
  have hfinal : Ideal.map (chartSections A f₁ f₂ i).hom.hom
      ((J.comap (modificationToBase A f₁ f₂)).ideal
        ⟨chartImage A f₁ f₂ i, isAffineOpen_chartImage A f₁ f₂ i⟩) =
      Ideal.span {(chartGamma A f₁ f₂ i).inv.hom (chartAwayMap A f₁ f₂ i c)} :=
    (Stacks.IdealSheaf.ideal_map_hom_eq_comap_inv (chartSections A f₁ f₂ i) _).trans
      ((Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion
        (J.comap (modificationToBase A f₁ f₂)) (awayChartι A f₁ f₂ i)
          ⟨⊤, isAffineOpen_top _⟩).symm.trans (hstep.trans hmap))
  exact Stacks.IdealSheaf.ideal_map_hom_injective (chartSections A f₁ f₂ i)
    (hfinal.trans (map_span_singleton_iso (chartSections A f₁ f₂ i) _).symm)

/-- **The inverse image of the centre of the two-generator square is a locally principal closed
subscheme of the modification.**

The modification is covered by the two standard opens `D₊(T₀)` and `D₊(T₁)`. On `D₊(T₀)` the
relation `f₂T₀ = f₁T₁` of the square makes `f₂` a multiple of `f₁`, so the ideal of the centre
becomes the principal ideal generated by `f₁`; on `D₊(T₁)` it becomes the principal ideal
generated by `f₂`. This is the second of the five conditions of
`AlgebraicGeometry.IsAlmostBlowUpSquare` for the square. -/
theorem isLocallyPrincipal_comap_centerIdealSheaf :
    letI := (twoGeneratorSquare A f₁ f₂).modificationGraded
    Stacks.Divisors.IsLocallyPrincipal
      ((centerIdealSheaf A f₁ f₂).comap (modificationToBase A f₁ f₂)) := by
  let := (twoGeneratorSquare A f₁ f₂).modificationGraded
  intro x
  obtain ⟨i, hi⟩ : ∃ i : Fin 2, x ∈ Proj.basicOpen (modificationGrading A f₁ f₂)
      (modificationCoord A f₁ f₂ i) := by
    have hx : x ∈ (⊤ : (AlgebraicGeometry.Proj (modificationGrading A f₁ f₂)).Opens) := trivial
    rw [← iSup_basicOpen_modificationCoord_eq_top A f₁ f₂] at hx
    exact TopologicalSpace.Opens.mem_iSup.mp hx
  refine ⟨⟨chartImage A f₁ f₂ i, isAffineOpen_chartImage A f₁ f₂ i⟩, ?_, ?_⟩
  · change x ∈ (chartImage A f₁ f₂ i : Set _)
    rw [chartImage_eq_basicOpen]
    exact hi
  · fin_cases i
    · exact ⟨_, ideal_comap_modificationToBase_chartImage A f₁ f₂ 0 rfl
        (Ideal.mem_span_singleton.mpr ⟨chartDiv A f₁ f₂ 0 1, chartAwayMap_zero_f₂ A f₁ f₂⟩)⟩
    · exact ⟨_, ideal_comap_modificationToBase_chartImage A f₁ f₂ 1
        (by rw [Set.pair_comm])
        (Ideal.mem_span_singleton.mpr ⟨chartDiv A f₁ f₂ 1 0, chartAwayMap_one_f₁ A f₁ f₂⟩)⟩

end Stacks.AlmostBlowUp

