module

public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
public import Mathlib.RingTheory.Localization.Away.Basic

/-!
# Dividing a map out of a graded ring by powers of a nonzerodivisor

Let `𝒜 : ℕ → σ` be an internal grading of a commutative ring `A`, let `χ : A →+* B` be a ring
map and let `t ∈ B` be a nonzerodivisor such that `χ x` is divisible by `tⁿ` for every
homogeneous `x` of degree `n`. Then there is a unique ring map `ψ : A →+* B` with
`tⁿ ψ x = χ x` for every such `x`, and the image of the irrelevant ideal under `ψ` is the unit
ideal as soon as `t` itself lies in the ideal generated by the values of `χ` on homogeneous
elements of positive degree.

This is the algebraic engine of the mapping-in half of the universal property of a relative
`Proj` (Constructions, Section 01NS), and through it of the universal property of blowing up
(Divisors, Tag 0806): there `A` is the graded ring of homogeneous local sections of a
quasi-coherent graded algebra over an affine open of the base, `B` is the ring of global
sections of a scheme in the category `C` of Tag 0806, and `t` is the local generator of the
inverse-image effective Cartier divisor. The hypothesis on the irrelevant ideal is exactly the
hypothesis of `AlgebraicGeometry.Proj.fromOfGlobalSections`.

## Main definitions

* `Stacks.GradedRing.awayTwist`: the ring map `⨁ₙ 𝒜 n ⟶ B[1/t]` which on the degree-`n`
  summand is `x ↦ χ x · t⁻ⁿ`.
* `Stacks.GradedRing.awayDivide`: the same map read on `A` itself, through the internal
  decomposition.
* `Stacks.GradedRing.divide`: the corestriction of `Stacks.GradedRing.awayDivide` to `B`, which
  exists because `t` is a nonzerodivisor and because every homogeneous value is divisible.

## Main results

* `Stacks.GradedRing.awayDivide_of_mem`: the value on a homogeneous element.
* `Stacks.GradedRing.awayDivide_mem_range`: every value lies in `B`, because a general element
  is a finite sum of homogeneous ones.
* `Stacks.GradedRing.pow_mul_divide`: the characterizing property `tⁿ ψ x = χ x`.
* `Stacks.GradedRing.divide_of_mem_zero`: in degree zero the division map is `χ`.
* `Stacks.GradedRing.map_divide_irrelevant_eq_top`: the image of the irrelevant ideal is the
  unit ideal.

## Implementation notes

The division is performed inside the localization `B[1/t]` rather than by a formula on
representatives: there the twist `x ↦ χ x · t⁻ⁿ` is multiplicative on homogeneous elements by
inspection, so `DirectSum.liftRingHom` produces a ring map with no computation, and the ring
axioms for the division map are then inherited from it along the injection of `B` into the
localization. This is the same device as `Stacks.Blowup.reesDivide` in
`StacksFrontier/AlgebraicGeometry/Blowup/Existence.lean`, which is the special case where `A`
is the Rees algebra of an ideal; the present statement replaces that concrete Rees algebra by an
arbitrary internally graded ring, which is what the relative `Proj` of a situation needs,
because its graded ring of local sections is a direct sum of modules of sections and not a
subalgebra of a polynomial ring.

## References

* [Stacks Project, Tag 01NS](https://stacks.math.columbia.edu/tag/01NS)
* [Stacks Project, Tag 0806](https://stacks.math.columbia.edu/tag/0806)
-/

@[expose] public noncomputable section

open DirectSum

namespace Stacks.GradedRing

variable {A B : Type*} [CommRing A] [CommRing B] {σ : Type*} [SetLike σ A]
  [AddSubgroupClass σ A] (𝒜 : ℕ → σ) [GradedRing 𝒜] (χ : A →+* B) (t : B)

/-- The localization map at a nonzerodivisor is injective. -/
theorem algebraMap_away_injective_of_mem_nonZeroDivisors (ht : t ∈ nonZeroDivisors B) :
    Function.Injective (algebraMap B (Localization.Away t)) :=
  IsLocalization.injective _ (Submonoid.powers_le.mpr ht)

/-- The ring map `⨁ₙ 𝒜 n ⟶ B[1/t]` which sends a homogeneous element `x` of degree `n` to
`χ x · t⁻ⁿ`. It is multiplicative because the degrees add. -/
def awayTwist : (⨁ n, ↥(𝒜 n)) →+* Localization.Away t :=
  DirectSum.liftRingHom
    ⟨fun {n} =>
      { toFun := fun x => algebraMap B (Localization.Away t) (χ (x : A)) *
          IsLocalization.Away.invSelf t ^ n
        map_zero' := by simp
        map_add' := by intro a b; push_cast; rw [map_add, map_add, add_mul] },
     by
       change algebraMap B (Localization.Away t) (χ ((1 : 𝒜 0) : A)) *
         IsLocalization.Away.invSelf t ^ 0 = 1
       simp,
     by
       intro i j ai aj
       simp only [AddMonoidHom.coe_mk, ZeroHom.coe_mk, SetLike.coe_gMul, map_mul, pow_add]
       ring⟩

/-- `Stacks.GradedRing.awayTwist` read on `A` itself, through the internal decomposition. -/
def awayDivide : A →+* Localization.Away t :=
  (awayTwist 𝒜 χ t).comp (DirectSum.decomposeRingEquiv 𝒜 : A →+* _)

/-- On a homogeneous element `x` of degree `n`, `Stacks.GradedRing.awayDivide` takes the value
`χ x · t⁻ⁿ`. -/
theorem awayDivide_of_mem {n : ℕ} {x : A} (hx : x ∈ 𝒜 n) :
    awayDivide 𝒜 χ t x =
      algebraMap B (Localization.Away t) (χ x) * IsLocalization.Away.invSelf t ^ n := by
  show awayTwist 𝒜 χ t (DirectSum.decomposeRingEquiv 𝒜 x) = _
  rw [show (DirectSum.decomposeRingEquiv 𝒜 x) = DirectSum.of _ n ⟨x, hx⟩ from
    DirectSum.decompose_of_mem 𝒜 hx]
  rw [awayTwist, DirectSum.liftRingHom_apply, DirectSum.toSemiring_of]
  rfl

/-- Multiplying `a · t⁻ⁿ` by `tⁿ` in `B[1/t]` returns `a`. -/
private theorem algebraMap_pow_mul_mul_invSelf_pow (a : Localization.Away t) (n : ℕ) :
    algebraMap B (Localization.Away t) t ^ n * (a * IsLocalization.Away.invSelf t ^ n) = a := by
  rw [mul_left_comm, ← mul_pow, IsLocalization.Away.mul_invSelf, one_pow, mul_one]

/-- **Every value of the twisted map already lies in `B`.** A general element of `A` is a finite
sum of homogeneous ones, on each of which the twist is the quotient supplied by the divisibility
hypothesis. -/
theorem awayDivide_mem_range
    (hdiv : ∀ (n : ℕ) (x : A), x ∈ 𝒜 n → ∃ c : B, χ x = t ^ n * c) (x : A) :
    awayDivide 𝒜 χ t x ∈ (algebraMap B (Localization.Away t)).range := by
  classical
  rw [← DirectSum.sum_support_decompose 𝒜 x, map_sum]
  refine Subring.sum_mem _ fun n _ => ?_
  obtain ⟨c, hc⟩ := hdiv n _ (DirectSum.decompose 𝒜 x n).2
  rw [awayDivide_of_mem 𝒜 χ t (DirectSum.decompose 𝒜 x n).2, hc]
  refine ⟨c, ?_⟩
  rw [map_mul, map_pow, mul_assoc, algebraMap_pow_mul_mul_invSelf_pow]

/-- If `χ x` is divisible by `tⁿ` for every homogeneous `x` of degree `n`, then every value of
`Stacks.GradedRing.awayDivide` is the image of an element of `B`. -/
theorem exists_algebraMap_eq_awayDivide
    (hdiv : ∀ (n : ℕ) (x : A), x ∈ 𝒜 n → ∃ c : B, χ x = t ^ n * c) (x : A) :
    ∃ c : B, algebraMap B (Localization.Away t) c = awayDivide 𝒜 χ t x :=
  RingHom.mem_range.mp (awayDivide_mem_range 𝒜 χ t hdiv x)

/-- **Division of a graded ring map by powers of a nonzerodivisor.** If `χ x` is divisible by
`tⁿ` for every homogeneous `x` of degree `n` and `t` is a nonzerodivisor, then `x ↦ χ x / tⁿ` is
a ring map `A →+* B`. -/
def divide
    (hdiv : ∀ (n : ℕ) (x : A), x ∈ 𝒜 n → ∃ c : B, χ x = t ^ n * c)
    (ht : t ∈ nonZeroDivisors B) : A →+* B where
  toFun x := (exists_algebraMap_eq_awayDivide 𝒜 χ t hdiv x).choose
  map_one' := by
    apply algebraMap_away_injective_of_mem_nonZeroDivisors t ht
    rw [(exists_algebraMap_eq_awayDivide 𝒜 χ t hdiv 1).choose_spec, map_one, map_one]
  map_mul' x y := by
    apply algebraMap_away_injective_of_mem_nonZeroDivisors t ht
    rw [(exists_algebraMap_eq_awayDivide 𝒜 χ t hdiv (x * y)).choose_spec, map_mul, map_mul,
      (exists_algebraMap_eq_awayDivide 𝒜 χ t hdiv x).choose_spec,
      (exists_algebraMap_eq_awayDivide 𝒜 χ t hdiv y).choose_spec]
  map_zero' := by
    apply algebraMap_away_injective_of_mem_nonZeroDivisors t ht
    rw [(exists_algebraMap_eq_awayDivide 𝒜 χ t hdiv 0).choose_spec, map_zero, map_zero]
  map_add' x y := by
    apply algebraMap_away_injective_of_mem_nonZeroDivisors t ht
    rw [(exists_algebraMap_eq_awayDivide 𝒜 χ t hdiv (x + y)).choose_spec, map_add, map_add,
      (exists_algebraMap_eq_awayDivide 𝒜 χ t hdiv x).choose_spec,
      (exists_algebraMap_eq_awayDivide 𝒜 χ t hdiv y).choose_spec]

/-- The image of `Stacks.GradedRing.divide` in `B[1/t]` is `Stacks.GradedRing.awayDivide`. -/
@[simp]
theorem algebraMap_divide
    (hdiv : ∀ (n : ℕ) (x : A), x ∈ 𝒜 n → ∃ c : B, χ x = t ^ n * c)
    (ht : t ∈ nonZeroDivisors B) (x : A) :
    algebraMap B (Localization.Away t) (divide 𝒜 χ t hdiv ht x) = awayDivide 𝒜 χ t x :=
  (exists_algebraMap_eq_awayDivide 𝒜 χ t hdiv x).choose_spec

/-- **The characterizing property of `Stacks.GradedRing.divide`.** On a homogeneous element of
degree `n`, multiplying the quotient back by `tⁿ` returns the original value. -/
theorem pow_mul_divide
    (hdiv : ∀ (n : ℕ) (x : A), x ∈ 𝒜 n → ∃ c : B, χ x = t ^ n * c)
    (ht : t ∈ nonZeroDivisors B) {n : ℕ} {x : A} (hx : x ∈ 𝒜 n) :
    t ^ n * divide 𝒜 χ t hdiv ht x = χ x := by
  apply algebraMap_away_injective_of_mem_nonZeroDivisors t ht
  rw [map_mul, map_pow, algebraMap_divide, awayDivide_of_mem 𝒜 χ t hx,
    algebraMap_pow_mul_mul_invSelf_pow]

/-- In degree zero the division map is the original map. -/
theorem divide_of_mem_zero
    (hdiv : ∀ (n : ℕ) (x : A), x ∈ 𝒜 n → ∃ c : B, χ x = t ^ n * c)
    (ht : t ∈ nonZeroDivisors B) {x : A} (hx : x ∈ 𝒜 0) :
    divide 𝒜 χ t hdiv ht x = χ x := by
  simpa using pow_mul_divide 𝒜 χ t hdiv ht hx

/-- **The image of the irrelevant ideal under the division map is the unit ideal**, as soon as
`t` lies in the ideal generated by the values of `χ` on homogeneous elements of positive degree.

This is the hypothesis under which `AlgebraicGeometry.Proj.fromOfGlobalSections` turns the
division map into a morphism into `Proj 𝒜`: writing `t` as a combination of such values
`χ x = tⁿ ψ x` with `n ≥ 1` and cancelling one factor of `t` exhibits `1` in the image. -/
theorem map_divide_irrelevant_eq_top
    (hdiv : ∀ (n : ℕ) (x : A), x ∈ 𝒜 n → ∃ c : B, χ x = t ^ n * c)
    (ht : t ∈ nonZeroDivisors B)
    (hgen : t ∈ Ideal.span {b : B | ∃ n : ℕ, 0 < n ∧ ∃ x ∈ 𝒜 n, χ x = b}) :
    (HomogeneousIdeal.irrelevant 𝒜).toIdeal.map (divide 𝒜 χ t hdiv ht) = ⊤ := by
  set J := (HomogeneousIdeal.irrelevant 𝒜).toIdeal.map (divide 𝒜 χ t hdiv ht) with hJ
  have hspan : Ideal.span {b : B | ∃ n : ℕ, 0 < n ∧ ∃ x ∈ 𝒜 n, χ x = b} ≤
      Ideal.span {t} * J := by
    rw [Ideal.span_le]
    rintro b ⟨n, hn, x, hx, rfl⟩
    refine Submodule.mem_span_singleton_mul.mpr
      ⟨t ^ (n - 1) * divide 𝒜 χ t hdiv ht x, ?_, ?_⟩
    · exact Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _
        (HomogeneousIdeal.mem_irrelevant_of_mem 𝒜 hn hx))
    · rw [← mul_assoc, ← pow_succ', Nat.sub_add_cancel hn]
      exact pow_mul_divide 𝒜 χ t hdiv ht hx
  obtain ⟨y, hyJ, hy⟩ := Submodule.mem_span_singleton_mul.mp (hspan hgen)
  have hy1 : y = 1 := by
    refine sub_eq_zero.mp ((mem_nonZeroDivisors_iff.mp ht).2 (y - 1) ?_)
    rw [sub_mul, one_mul, mul_comm y t, hy, sub_self]
  exact Ideal.eq_top_of_isUnit_mem _ (hy1 ▸ hyJ) isUnit_one

end Stacks.GradedRing

end
