module

public import StacksFrontier.AlgebraicGeometry.Blowup.ExceptionalCartier
public import StacksFrontier.AlgebraicGeometry.Divisors.DivisorInvertibleSheaf
public import StacksFrontier.AlgebraicGeometry.LocalCohomology.BitUniformityIII.BlowupTwists
public import StacksCore.Tactic.StacksAttribute

/-!
# The ideal sheaf of the exceptional divisor, on a chart, is the first twist

Let `R` be a commutative ring, `I ⊆ R` an ideal, and `J` the ideal sheaf on `Spec R` cut out by
`I`. On the affine chart `D₊(b⁽¹⁾)` of the blowup `Stacks.Blowup.blowUpSpec I`, attached to
`b ∈ I`, both the ideal sheaf of the pulled-back centre `J.comap (toSpec I)` and the degree-one
twisting sheaf `Stacks.LocalCohomology.UniformityIII.blowupTwist I 1` are trivial: the first by
`Stacks.Divisors.idealSheafOverIsoUnit`, generated by the nonzerodivisor of
`Stacks.Blowup.exists_isRegular_ideal_comap_toSpec_eq_span`, and the second by
`Stacks.AlgebraicGeometry.ProjDegreeOne.twistingSheafOverBasicOpenDegreeOneIsoUnit` at the
degree-one generator `Stacks.Blowup.reesDegOne I hb`. Composing the two trivializations gives an
isomorphism over the chart.

## Main results

* `Stacks.Blowup.negativeTwist'OverChartIsoOfGen`: the chartwise comparison at a named generator
  of the centre on the chart.
* `Stacks.Blowup.negativeTwist'OverChartIso`: the same at the generator
  `Stacks.Blowup.exists_isRegular_ideal_comap_toSpec_eq_span` provides.

## References

* [Stacks Project, Tag 0GA7](https://stacks.math.columbia.edu/tag/0GA7)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open AlgebraicGeometry.ProjectiveSpectrum.Proj (twistingSheaf)
open Stacks.AlgebraicGeometry.ProjDegreeOne (twistingSheafOverBasicOpenDegreeOneIsoUnit)

universe u

namespace Stacks.Blowup

variable {R : Type u} [CommRing R] (I : Ideal R)

/-- `Stacks.LocalCohomology.UniformityIII.blowupTwist` at `q = 1` unwinds to the general
degree-one twisting sheaf of the Rees grading, once the `ℕ → ℤ` cast of `1` is simplified. -/
theorem blowupTwist_one_eq :
    Stacks.LocalCohomology.UniformityIII.blowupTwist I 1 = twistingSheaf (reesGrading I) (1 : ℤ) :=
  congrArg (twistingSheaf (reesGrading I)) Nat.cast_one

/-- **The ideal sheaf of the pulled-back centre and the first twist of the blowup are
isomorphic on the chart `D₊(b⁽¹⁾)`, at a named generator `g` of the centre on that chart.**
Both sheaves are trivial there: the ideal sheaf by `Stacks.Divisors.idealSheafOverIsoUnit` at
`g`, and the twist by
`Stacks.AlgebraicGeometry.ProjDegreeOne.twistingSheafOverBasicOpenDegreeOneIsoUnit` at the
degree-one generator `reesDegOne I hb`; the composite carries `g` to `b⁽¹⁾`.

The generator is a parameter rather than being extracted from
`Stacks.Blowup.exists_isRegular_ideal_comap_toSpec_eq_span`, because the isomorphism *depends*
on it: two generators of one principal ideal differ by a unit, and the composite differs by
multiplication by that unit. Anything comparing these isomorphisms on an overlap of two charts
— which is what gluing them into a global comparison would require — must therefore fix the
generator first, and the only choice for which the overlaps have a chance of agreeing is the
canonical one, the image of `b` itself under the chart identifications. That is the witness
`exists_isRegular_ideal_comap_toSpec_eq_span` is proved with, but its conclusion is an `Exists`,
so the witness is not recoverable from the statement. -/
def negativeTwist'OverChartIsoOfGen (J : (Spec (CommRingCat.of R)).IdealSheafData)
    {b : R} (hb : b ∈ I) (g : Γ(blowUpSpec I, chartImage I hb)) (hgreg : IsRegular g)
    (hgspan : (J.comap (toSpec I)).ideal ⟨chartImage I hb, isAffineOpen_chartImage I hb⟩ =
      Ideal.span {g}) :
    (Stacks.Divisors.negativeTwist' (J.comap (toSpec I))).over (chartImage I hb) ≅
      (Stacks.LocalCohomology.UniformityIII.blowupTwist I 1).over (chartImage I hb) := by
  have hfU := Stacks.Divisors.mem_ker_app_of_ideal_eq_span (J.comap (toSpec I))
    (isAffineOpen_chartImage I hb) hgspan
  refine Stacks.Divisors.idealSheafOverIsoUnit (J.comap (toSpec I)) (isAffineOpen_chartImage I hb)
    hgreg hgspan hfU ≪≫ ?_
  rw [blowupTwist_one_eq, chartImage_eq_basicOpen]
  exact (twistingSheafOverBasicOpenDegreeOneIsoUnit (reesGrading I) (reesDegOne I hb)
    (reesDegOne_mem_reesGrading I hb) 1).symm

/-- **The ideal sheaf of the pulled-back centre and the first twist of the blowup are
isomorphic on the chart `D₊(b⁽¹⁾)`.** This is `negativeTwist'OverChartIsoOfGen` at the generator
supplied by `Stacks.Blowup.exists_isRegular_ideal_comap_toSpec_eq_span`.

`Exists` only eliminates into `Prop`, so the generator is extracted with `Classical.choose`
rather than `obtain`, which would ask to build the (data-valued) isomorphism by cases on a
proof. The isomorphism is consequently opaque — see `negativeTwist'OverChartIsoOfGen` for why
that blocks the overlap comparison. -/
def negativeTwist'OverChartIso (J : (Spec (CommRingCat.of R)).IdealSheafData)
    (hJ : Ideal.map (Scheme.ΓSpecIso (CommRingCat.of R)).hom.hom
        (J.ideal ⟨⊤, isAffineOpen_top _⟩) = I) {b : R} (hb : b ∈ I) :
    (Stacks.Divisors.negativeTwist' (J.comap (toSpec I))).over (chartImage I hb) ≅
      (Stacks.LocalCohomology.UniformityIII.blowupTwist I 1).over (chartImage I hb) :=
  negativeTwist'OverChartIsoOfGen I J hb
    (exists_isRegular_ideal_comap_toSpec_eq_span I J hJ hb).choose
    (exists_isRegular_ideal_comap_toSpec_eq_span I J hJ hb).choose_spec.1
    (exists_isRegular_ideal_comap_toSpec_eq_span I J hJ hb).choose_spec.2

end Stacks.Blowup

end
