module

public import Mathlib.AlgebraicGeometry.Morphisms.Flat
public import StacksFrontier.AlgebraicGeometry.Blowup.ChartSectionRing
public import StacksFrontier.AlgebraicGeometry.Blowup.StrictTransformChartBlowUp
public import StacksFrontier.AlgebraicGeometry.Blowup.StrictTransformChartRing
public import StacksFrontier.AlgebraicGeometry.Size.Pullback
public import StacksFrontier.RingTheory.Blowup.StrictTransformBaseChange

/-!
# The section ring of a blowup chart after base change

Let `f : X ⟶ S` be a morphism, `ℐ` a quasi-coherent sheaf of ideals on `S`, `U` an affine open
of `S` and `a ∈ ℐ(U)`. The chart `Stacks.Blowup.blowUpAffineChart` identifies an affine open
`C ⊆ Bl_ℐ(S)` with `Spec Γ(S, U)[ℐ(U)/a]`, and `Stacks.Blowup.chartSectionRingIsoBlowup` reads
that on sections. This file does the same one step further out, on the base change
`X ×_S Bl_ℐ(S)`: for an affine open `U_X ⊆ X` lying over `U`, the open

`V = pr_X⁻¹(U_X) ∩ pr_{S'}⁻¹(C)`

of `X ×_S Bl_ℐ(S)` is affine and its section ring is the tensor product

`Γ(X, U_X) ⊗_{Γ(S, U)} Blowup ℐ(U) a`,

as a `Γ(X, U_X)`-algebra.

That is the comparison the ring-level [Stacks, Tag 0810]
(`exists_fg_ideal_forall_blowup_chart_exists_away_basis`) needs in order to be read on a blowup
chart: its conclusion is about `S ⊗_R R[I/a]` and the quotient of `(S ⊗_R R[I/a]) ⊗_S M` by its
`a`-power torsion, and the last result of this file identifies that quotient with the sections
of the strict transform of a quasi-coherent module over `V`.

## Main results

* `Stacks.Blowup.isAffineOpen_chartBaseChangeOpen`: the open `V` is affine.
* `Stacks.Blowup.isPushout_appLE_chartBaseChangeOpen`: the square of section rings
  `Γ(S, U) → Γ(X, U_X)`, `Γ(S, U) → Γ(Bl_ℐ(S), C)`, `Γ(X, U_X) → Γ(X ×_S Bl_ℐ(S), V)`,
  `Γ(Bl_ℐ(S), C) → Γ(X ×_S Bl_ℐ(S), V)` is cocartesian.
* `Stacks.Blowup.chartBaseChangeSectionAlgEquiv`: **`Γ(X ×_S Bl_ℐ(S), V)` is
  `Γ(X, U_X) ⊗_{Γ(S, U)} Blowup ℐ(U) a`**, as a `Γ(X, U_X)`-algebra.
* `Stacks.Blowup.ideal_comap_exceptionalIdeal_chartBaseChangeOpen`: over `V` the exceptional
  ideal is generated by the image of `a`.
* `Stacks.Blowup.sectionsSheafEquivQuotientTorsionChartBaseChange`: **the sections over `V` of
  the strict transform of a quasi-coherent module `F` are
  `(Γ(X, U_X) ⊗_{Γ(S, U)} Blowup ℐ(U) a) ⊗_{Γ(X, U_X)} Γ(F, U_X)` modulo its `a`-power
  torsion** — the module `M'` of the conclusion of [Stacks, Tag 0810].

## Implementation notes

The cocartesian square is Mathlib's `AlgebraicGeometry.isIso_pushoutSection_of_isAffineOpen`,
read through `AlgebraicGeometry.isIso_pushoutSection_iff` and
`CommRingCat.isPushout_iff_isPushout`; affineness of `V` is
`AlgebraicGeometry.isAffineOpen_inf_preimage`. The three algebra structures on the section rings
are the ones induced by `AlgebraicGeometry.Scheme.Hom.appLE`, and the scalar towers come from
commutativity of the square, exactly as in
`AlgebraicGeometry.differentIdealSheaf_ideal_pullback_chart`. `Mathlib`'s `pullbackSpecIso` is
not usable here: it needs both legs of the fibre product to be literally `Spec` of an
`algebraMap`, which the projection of `X ×_S Bl_ℐ(S)` onto a chart is not.

The identification of the torsion generator is the one place where the chart enters twice: the
generator of the comap of the exceptional ideal over `V` is the image of
`Stacks.Blowup.exceptionalChartSection`, which by
`Stacks.Blowup.exceptionalChartSection_eq_appLE` is the image of `a` itself, so it is
`algebraMap Γ(S, U) Γ(X ×_S Bl_ℐ(S), V) a` and matches the generator used by the ring-level
strict transform.

## References

* [Stacks Project, Tag 0804](https://stacks.math.columbia.edu/tag/0804)
* [Stacks Project, Tag 053H](https://stacks.math.columbia.edu/tag/053H)
* [Stacks Project, Tag 080D](https://stacks.math.columbia.edu/tag/080D)
* [Stacks Project, Tag 0810](https://stacks.math.columbia.edu/tag/0810)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open scoped TensorProduct

universe u

namespace Stacks.Blowup

variable {X S : Scheme.{u}} (f : X ⟶ S) (ℐ : S.IdealSheafData) (U : S.affineOpens)
  {a : Γ(S, U.1)} [ha : Fact (a ∈ ℐ.ideal U)]

/-! ### The affine open of the base change over a chart -/

/-- The affine open of the blowup underlying the chart at `a ∈ ℐ(U)`. -/
abbrev blowUpChartImage : (blowUp ℐ).Opens :=
  blowUpAffineChart ℐ U ha.out ''ᵁ ⊤

/-- The image of the affine chart of the blowup at `a ∈ ℐ(U)` is an affine open. -/
theorem isAffineOpen_blowUpChartImage : IsAffineOpen (blowUpChartImage ℐ U (a := a)) :=
  (isAffineOpen_top _).image_of_isOpenImmersion (blowUpAffineChart ℐ U ha.out)

/-- The image of the affine chart of the blowup at `a ∈ ℐ(U)` lies in the preimage of `U` under
the structure morphism `blowUpToBase ℐ`. -/
theorem blowUpChartImage_le_preimage :
    blowUpChartImage ℐ U (a := a) ≤ blowUpToBase ℐ ⁻¹ᵁ U.1 :=
  blowUpAffineChart_image_le_preimage ℐ U ha.out

/-- The open of `X ×_S Bl_ℐ(S)` cut out by an affine open `U_X ⊆ X` and the affine chart of the
blowup at `a ∈ ℐ(U)`. -/
abbrev chartBaseChangeOpen (UX : X.Opens) :
    (Limits.pullback f (blowUpToBase ℐ)).Opens :=
  pullback.fst f (blowUpToBase ℐ) ⁻¹ᵁ UX ⊓
    pullback.snd f (blowUpToBase ℐ) ⁻¹ᵁ blowUpChartImage ℐ U (a := a)

variable {UX : X.Opens}

/-- The open `chartBaseChangeOpen f ℐ U UX` lies in the preimage of `UX` under the first
projection. -/
theorem chartBaseChangeOpen_le_preimage_fst :
    chartBaseChangeOpen f ℐ U (a := a) UX ≤ pullback.fst f (blowUpToBase ℐ) ⁻¹ᵁ UX :=
  inf_le_left

/-- The open `chartBaseChangeOpen f ℐ U UX` lies in the preimage of the chart image
`blowUpChartImage ℐ U` under the second projection. -/
theorem chartBaseChangeOpen_le_preimage_snd :
    chartBaseChangeOpen f ℐ U (a := a) UX ≤
      pullback.snd f (blowUpToBase ℐ) ⁻¹ᵁ blowUpChartImage ℐ U (a := a) :=
  inf_le_right

/-- **The base change of an affine chart of a blowup over an affine open of the source is
affine.** -/
theorem isAffineOpen_chartBaseChangeOpen (hUXaff : IsAffineOpen UX) (hUX : UX ≤ f ⁻¹ᵁ U.1) :
    IsAffineOpen (chartBaseChangeOpen f ℐ U (a := a) UX) := by
  have : IsAffine UX.toScheme := hUXaff
  have : IsAffine (blowUpChartImage ℐ U (a := a)).toScheme :=
    isAffineOpen_blowUpChartImage ℐ U (a := a)
  have : IsAffine U.1.toScheme := U.2
  exact isAffineOpen_inf_preimage f (blowUpToBase ℐ) (S₀ := U.1) hUX
    (blowUpChartImage_le_preimage ℐ U (a := a))

/-! ### The section ring of the base change of a chart -/

/-- **The square of section rings over a blowup chart and an affine open of the source is
cocartesian.** -/
theorem isPushout_appLE_chartBaseChangeOpen (hUXaff : IsAffineOpen UX)
    (hUX : UX ≤ f ⁻¹ᵁ U.1) :
    IsPushout (f.appLE U.1 UX hUX)
      ((blowUpToBase ℐ).appLE U.1 (blowUpChartImage ℐ U (a := a))
        (blowUpChartImage_le_preimage ℐ U (a := a)))
      ((pullback.fst f (blowUpToBase ℐ)).appLE UX
        (chartBaseChangeOpen f ℐ U (a := a) UX)
        (chartBaseChangeOpen_le_preimage_fst f ℐ U (a := a) (UX := UX)))
      ((pullback.snd f (blowUpToBase ℐ)).appLE (blowUpChartImage ℐ U (a := a))
        (chartBaseChangeOpen f ℐ U (a := a) UX)
        (chartBaseChangeOpen_le_preimage_snd f ℐ U (a := a) (UX := UX))) :=
  (isIso_pushoutSection_iff (IsPullback.of_hasPullback f (blowUpToBase ℐ))
      (blowUpChartImage_le_preimage ℐ U (a := a)) hUX rfl).mp
    (isIso_pushoutSection_of_isAffineOpen (IsPullback.of_hasPullback f (blowUpToBase ℐ))
      (blowUpChartImage_le_preimage ℐ U (a := a)) hUX rfl U.2
      (isAffineOpen_blowUpChartImage ℐ U (a := a)) hUXaff)

/-- The chart ring `Γ(Bl_ℐ(S), C)` is the quotient-model affine blowup algebra
`Blowup ℐ(U) a`, as a `Γ(S, U)`-algebra. This is
`Stacks.Blowup.chartSectionRingIsoBlowup` together with
`Stacks.Blowup.blowUpToBase_appLE_chartSectionRingIsoBlowup_hom`, packaged as an `AlgEquiv`. -/
def chartSectionAlgEquivBlowup :
    letI : Algebra Γ(S, U.1) Γ(blowUp ℐ, blowUpChartImage ℐ U (a := a)) :=
      ((blowUpToBase ℐ).appLE U.1 (blowUpChartImage ℐ U (a := a))
        (blowUpChartImage_le_preimage ℐ U (a := a))).hom.toAlgebra
    Γ(blowUp ℐ, blowUpChartImage ℐ U (a := a)) ≃ₐ[Γ(S, U.1)] Blowup (ℐ.ideal U) a :=
  letI : Algebra Γ(S, U.1) Γ(blowUp ℐ, blowUpChartImage ℐ U (a := a)) :=
    ((blowUpToBase ℐ).appLE U.1 (blowUpChartImage ℐ U (a := a))
      (blowUpChartImage_le_preimage ℐ U (a := a))).hom.toAlgebra
  AlgEquiv.ofRingEquiv
    (f := (chartSectionRingIsoBlowup ℐ U (a := a)).commRingCatIsoToRingEquiv)
    fun r ↦ congrArg (fun h : _ ⟶ CommRingCat.of (Blowup (ℐ.ideal U) a) ↦ h.hom r)
      (blowUpToBase_appLE_chartSectionRingIsoBlowup_hom ℐ U (a := a))

/-- **The section ring of `X ×_S Bl_ℐ(S)` over the base change of an affine blowup chart.**
For an affine open `U_X ⊆ X` lying over the affine open `U ⊆ S` and `a ∈ ℐ(U)`, the sections of
the base change over `pr_X⁻¹(U_X) ∩ pr_{S'}⁻¹(C)`, with `C` the affine chart of the blowup at
`a`, are `Γ(X, U_X) ⊗_{Γ(S, U)} Blowup ℐ(U) a`. -/
def chartBaseChangeSectionAlgEquiv (hUXaff : IsAffineOpen UX) (hUX : UX ≤ f ⁻¹ᵁ U.1) :
    letI : Algebra Γ(S, U.1) Γ(X, UX) := (f.appLE U.1 UX hUX).hom.toAlgebra
    letI : Algebra Γ(X, UX) Γ(Limits.pullback f (blowUpToBase ℐ),
        chartBaseChangeOpen f ℐ U (a := a) UX) :=
      ((pullback.fst f (blowUpToBase ℐ)).appLE UX (chartBaseChangeOpen f ℐ U (a := a) UX)
        (chartBaseChangeOpen_le_preimage_fst f ℐ U (a := a) (UX := UX))).hom.toAlgebra
    (Γ(X, UX) ⊗[Γ(S, U.1)] Blowup (ℐ.ideal U) a) ≃ₐ[Γ(X, UX)]
      Γ(Limits.pullback f (blowUpToBase ℐ), chartBaseChangeOpen f ℐ U (a := a) UX) :=
  letI : Algebra Γ(S, U.1) Γ(X, UX) := (f.appLE U.1 UX hUX).hom.toAlgebra
  letI : Algebra Γ(S, U.1) Γ(blowUp ℐ, blowUpChartImage ℐ U (a := a)) :=
    ((blowUpToBase ℐ).appLE U.1 (blowUpChartImage ℐ U (a := a))
      (blowUpChartImage_le_preimage ℐ U (a := a))).hom.toAlgebra
  letI : Algebra Γ(X, UX) Γ(Limits.pullback f (blowUpToBase ℐ),
      chartBaseChangeOpen f ℐ U (a := a) UX) :=
    ((pullback.fst f (blowUpToBase ℐ)).appLE UX (chartBaseChangeOpen f ℐ U (a := a) UX)
      (chartBaseChangeOpen_le_preimage_fst f ℐ U (a := a) (UX := UX))).hom.toAlgebra
  letI : Algebra Γ(blowUp ℐ, blowUpChartImage ℐ U (a := a))
      Γ(Limits.pullback f (blowUpToBase ℐ), chartBaseChangeOpen f ℐ U (a := a) UX) :=
    ((pullback.snd f (blowUpToBase ℐ)).appLE (blowUpChartImage ℐ U (a := a))
      (chartBaseChangeOpen f ℐ U (a := a) UX)
      (chartBaseChangeOpen_le_preimage_snd f ℐ U (a := a) (UX := UX))).hom.toAlgebra
  letI : Algebra Γ(S, U.1) Γ(Limits.pullback f (blowUpToBase ℐ),
      chartBaseChangeOpen f ℐ U (a := a) UX) :=
    ((algebraMap Γ(X, UX) Γ(Limits.pullback f (blowUpToBase ℐ),
      chartBaseChangeOpen f ℐ U (a := a) UX)).comp
      (algebraMap Γ(S, U.1) Γ(X, UX))).toAlgebra
  haveI : IsScalarTower Γ(S, U.1) Γ(X, UX) Γ(Limits.pullback f (blowUpToBase ℐ),
      chartBaseChangeOpen f ℐ U (a := a) UX) := IsScalarTower.of_algebraMap_eq' rfl
  haveI : IsScalarTower Γ(S, U.1) Γ(blowUp ℐ, blowUpChartImage ℐ U (a := a))
      Γ(Limits.pullback f (blowUpToBase ℐ), chartBaseChangeOpen f ℐ U (a := a) UX) :=
    IsScalarTower.of_algebraMap_eq'
      (congrArg CommRingCat.Hom.hom
        (isPushout_appLE_chartBaseChangeOpen f ℐ U (a := a) hUXaff hUX).w)
  haveI : Algebra.IsPushout Γ(S, U.1) Γ(X, UX)
      Γ(blowUp ℐ, blowUpChartImage ℐ U (a := a))
      Γ(Limits.pullback f (blowUpToBase ℐ), chartBaseChangeOpen f ℐ U (a := a) UX) :=
    CommRingCat.isPushout_iff_isPushout.mp
      (isPushout_appLE_chartBaseChangeOpen f ℐ U (a := a) hUXaff hUX)
  (Algebra.TensorProduct.congr (AlgEquiv.refl (R := Γ(X, UX)) (A₁ := Γ(X, UX)))
      (chartSectionAlgEquivBlowup ℐ U (a := a)).symm).trans
    (Algebra.IsPushout.equiv Γ(S, U.1) Γ(X, UX)
      Γ(blowUp ℐ, blowUpChartImage ℐ U (a := a))
      Γ(Limits.pullback f (blowUpToBase ℐ), chartBaseChangeOpen f ℐ U (a := a) UX))

/-! ### The torsion generator -/

/-- On the base change of a chart, the comap of the exceptional ideal is generated by the image
of `a` itself: by `Stacks.Blowup.exceptionalChartSection_eq_appLE` the chart generator is the
image of `a`, and the square of section rings commutes. -/
theorem ideal_comap_exceptionalIdeal_chartBaseChangeOpen (hUXaff : IsAffineOpen UX)
    (hUX : UX ≤ f ⁻¹ᵁ U.1) :
    ((exceptionalIdeal ℐ).comap (pullback.snd f (blowUpToBase ℐ))).ideal
        ⟨chartBaseChangeOpen f ℐ U (a := a) UX,
          isAffineOpen_chartBaseChangeOpen f ℐ U hUXaff hUX⟩
      = Ideal.span {
          ((pullback.fst f (blowUpToBase ℐ)).appLE UX
            (chartBaseChangeOpen f ℐ U (a := a) UX)
            (chartBaseChangeOpen_le_preimage_fst f ℐ U (a := a) (UX := UX))).hom
            ((f.appLE U.1 UX hUX).hom a)} := by
  rw [Stacks.StrictTransform.ideal_comap_exceptionalIdeal_blowUpAffineChart f ℐ U ha.out
    ⟨chartBaseChangeOpen f ℐ U (a := a) UX,
      isAffineOpen_chartBaseChangeOpen f ℐ U hUXaff hUX⟩
    (chartBaseChangeOpen_le_preimage_snd f ℐ U (a := a) (UX := UX))]
  refine congrArg (fun t ↦ Ideal.span {t}) ?_
  rw [exceptionalChartSection_eq_appLE ℐ U ha.out]
  exact congrArg (fun h : Γ(S, U.1) ⟶ _ ↦ h.hom a)
    (isPushout_appLE_chartBaseChangeOpen f ℐ U (a := a) hUXaff hUX).w.symm

/-! ### The sections of a strict transform over the base change of a chart -/

/-- **The sections of the strict transform over the base change of a blowup chart are the module
[Stacks, Tag 0810] produces.** For an affine open `U_X ⊆ X` lying over the affine open `U ⊆ S`
and `a ∈ ℐ(U)`, write `R = Γ(S, U)`, `A = Γ(X, U_X)`, `M = Γ(F, U_X)`, `R' = Blowup ℐ(U) a` and
`A' = A ⊗_R R'`. Then the sections over `pr_X⁻¹(U_X) ∩ pr_{S'}⁻¹(C)` of the strict transform of
`F` along the blowup are `(A' ⊗_A M)` modulo its `a`-power torsion — which is exactly the module
`M'` in the conclusion of `exists_fg_ideal_forall_blowup_chart_exists_away_basis`.

The equivalence is `A`-linear; `strictTransformEquivBaseChangeQuotientTorsion` turns the
right-hand side into `strictTransform ℐ(U) a M`, the constant of [Stacks, Tag 053H]. -/
def sectionsSheafEquivQuotientTorsionChartBaseChange (F : X.Modules) [F.IsQuasicoherent]
    (hUXaff : IsAffineOpen UX) (hUX : UX ≤ f ⁻¹ᵁ U.1) :
    letI : Algebra Γ(S, U.1) Γ(X, UX) := (f.appLE U.1 UX hUX).hom.toAlgebra
    letI : Algebra Γ(X, UX) Γ(Limits.pullback f (blowUpToBase ℐ),
        chartBaseChangeOpen f ℐ U (a := a) UX) :=
      ((pullback.fst f (blowUpToBase ℐ)).appLE UX (chartBaseChangeOpen f ℐ U (a := a) UX)
        (chartBaseChangeOpen_le_preimage_fst f ℐ U (a := a) (UX := UX))).hom.toAlgebra
    letI : Module Γ(X, UX) Γ(Stacks.StrictTransform.sheaf f (blowUpToBase ℐ)
        (exceptionalIdeal ℐ) F, chartBaseChangeOpen f ℐ U (a := a) UX) :=
      Module.compHom _ (algebraMap Γ(X, UX) Γ(Limits.pullback f (blowUpToBase ℐ),
        chartBaseChangeOpen f ℐ U (a := a) UX))
    Γ(Stacks.StrictTransform.sheaf f (blowUpToBase ℐ) (exceptionalIdeal ℐ) F,
        chartBaseChangeOpen f ℐ U (a := a) UX)
      ≃ₗ[Γ(X, UX)]
        (Γ(X, UX) ⊗[Γ(S, U.1)] Blowup (ℐ.ideal U) a) ⊗[Γ(X, UX)] Γ(F, UX) ⧸
          Submodule.torsion' (Γ(X, UX) ⊗[Γ(S, U.1)] Blowup (ℐ.ideal U) a)
            ((Γ(X, UX) ⊗[Γ(S, U.1)] Blowup (ℐ.ideal U) a) ⊗[Γ(X, UX)] Γ(F, UX))
            (Submonoid.powers (algebraMap Γ(X, UX)
              (Γ(X, UX) ⊗[Γ(S, U.1)] Blowup (ℐ.ideal U) a)
                (algebraMap Γ(S, U.1) Γ(X, UX) a))) := by
  letI : Algebra Γ(S, U.1) Γ(X, UX) := (f.appLE U.1 UX hUX).hom.toAlgebra
  letI : Algebra Γ(X, UX) Γ(Limits.pullback f (blowUpToBase ℐ),
      chartBaseChangeOpen f ℐ U (a := a) UX) :=
    ((pullback.fst f (blowUpToBase ℐ)).appLE UX (chartBaseChangeOpen f ℐ U (a := a) UX)
      (chartBaseChangeOpen_le_preimage_fst f ℐ U (a := a) (UX := UX))).hom.toAlgebra
  letI : Algebra Γ(S, U.1) Γ(Limits.pullback f (blowUpToBase ℐ),
      chartBaseChangeOpen f ℐ U (a := a) UX) :=
    ((algebraMap Γ(X, UX) Γ(Limits.pullback f (blowUpToBase ℐ),
      chartBaseChangeOpen f ℐ U (a := a) UX)).comp
      (algebraMap Γ(S, U.1) Γ(X, UX))).toAlgebra
  letI : Module Γ(X, UX) Γ(Stacks.StrictTransform.sheaf f (blowUpToBase ℐ)
      (exceptionalIdeal ℐ) F, chartBaseChangeOpen f ℐ U (a := a) UX) :=
    Module.compHom _ (algebraMap Γ(X, UX) Γ(Limits.pullback f (blowUpToBase ℐ),
      chartBaseChangeOpen f ℐ U (a := a) UX))
  haveI : IsScalarTower Γ(X, UX) Γ(Limits.pullback f (blowUpToBase ℐ),
      chartBaseChangeOpen f ℐ U (a := a) UX)
      Γ(Stacks.StrictTransform.sheaf f (blowUpToBase ℐ) (exceptionalIdeal ℐ) F,
        chartBaseChangeOpen f ℐ U (a := a) UX) :=
    IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  have e1 := Stacks.StrictTransform.sectionsSheafEquivQuotientTorsionBaseChange f
    (blowUpToBase ℐ) (exceptionalIdeal ℐ) F hUXaff
    ⟨chartBaseChangeOpen f ℐ U (a := a) UX,
      isAffineOpen_chartBaseChangeOpen f ℐ U hUXaff hUX⟩
    (chartBaseChangeOpen_le_preimage_fst f ℐ U (a := a) (UX := UX))
    (algebraMap Γ(X, UX) Γ(Limits.pullback f (blowUpToBase ℐ),
      chartBaseChangeOpen f ℐ U (a := a) UX) (algebraMap Γ(S, U.1) Γ(X, UX) a))
    (ideal_comap_exceptionalIdeal_chartBaseChangeOpen f ℐ U hUXaff hUX)
  refine (LinearEquiv.restrictScalars Γ(X, UX)
      (e1.symm.trans (Submodule.Quotient.equiv _ _ (LinearEquiv.refl
        Γ(Limits.pullback f (blowUpToBase ℐ), chartBaseChangeOpen f ℐ U (a := a) UX)
        (Γ(Limits.pullback f (blowUpToBase ℐ), chartBaseChangeOpen f ℐ U (a := a) UX) ⊗[Γ(X, UX)]
          Γ(F, UX))) ?_))).trans
    (quotientTorsionEquiv (algebraMap Γ(S, U.1) Γ(X, UX) a)
      (TensorProduct.congr
        (chartBaseChangeSectionAlgEquiv f ℐ U hUXaff hUX).symm.toLinearEquiv
        (LinearEquiv.refl Γ(X, UX) Γ(F, UX))))
  exact Submodule.map_torsion'_powers _ _

end Stacks.Blowup

end
