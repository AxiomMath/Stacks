attribute [local instance 10000] HasDerivedCategory.standard

universe u

namespace Stacks.Blowup

/-! ### The charts attached to a generating family -/

section Charts

variable {R : Type u} [CommRing R] (I : Ideal R)

/-- **The degree-one elements attached to a generating family of `I` generate the Rees algebra
over its degree-zero part.** The degree-one part of the Rees algebra is a copy of `I`, hence is
spanned by the `a⁽¹⁾` for `a` in a generating family, and the Rees algebra is generated in
degree one. -/
theorem adjoin_range_reesDegOne_eq_top {ι : Type*} {g : ι → R} (hg : ∀ i, g i ∈ I)
    (hI : I = Ideal.span (Set.range g)) :
    Algebra.adjoin (reesGrading I 0)
      (Set.range fun i => (reesDegOne I (hg i) : reesAlgebra I)) = ⊤ := by
  set G := reesGrading I 0
  set Adj := Algebra.adjoin G
    (Set.range fun i => (reesDegOne I (hg i) : reesAlgebra I))
  have key : ∀ x ∈ I, ∀ h : x ∈ I, (reesDegOne I h : reesAlgebra I) ∈ Adj := by
    intro x hx
    subst hI
    induction hx using Submodule.span_induction with
    | mem y hy =>
        obtain ⟨i, rfl⟩ := hy
        exact fun _ => Algebra.subset_adjoin ⟨i, rfl⟩
    | zero =>
        intro h
        rw [show (reesDegOne _ h : reesAlgebra _) = 0 from Subtype.ext (by simp [coe_reesDegOne])]
        exact zero_mem _
    | add y z hy hz ihy ihz =>
        intro h
        rw [show (reesDegOne _ h : reesAlgebra _) = reesDegOne _ hy + reesDegOne _ hz from
          Subtype.ext (by simp [coe_reesDegOne, map_add])]
        exact add_mem (ihy hy) (ihz hz)
    | smul c y hy ihy =>
        intro h
        rw [show (reesDegOne _ h : reesAlgebra _) = c • reesDegOne _ hy from
          Subtype.ext (by simp [coe_reesDegOne, Polynomial.smul_monomial]),
          ← algebraMap_smul G c]
        exact Subalgebra.smul_mem _ (ihy hy) _
  refine top_le_iff.mp ?_
  rw [← adjoin_reesGradingZero_reesGrading_one_eq_top I]
  refine Algebra.adjoin_le fun f hf => ?_
  have hf1 : f ∈ reesGrading I 1 := hf
  have hcoeff : (f : R[X]).coeff 1 ∈ I := by simpa using f.2 1
  rw [show f = reesDegOne I hcoeff from
    Subtype.ext (by simpa [coe_reesDegOne] using coe_eq_monomial I hf1)]
  exact key _ hcoeff hcoeff

/-- **The charts attached to a generating family of `I` cover the blowup of `Spec R` in `I`.**
This refines `Stacks.Blowup.iSup_opensRange_specAffineBlowupι`, where the charts range over all
of `I`, to the finite subfamily given by a set of generators. -/
theorem iSup_opensRange_specAffineBlowupι_of_eq_span {ι : Type*} {g : ι → R} (hg : ∀ i, g i ∈ I)
    (hI : I = Ideal.span (Set.range g)) :
    ⨆ i, (specAffineBlowupι I (g i) (hg i)).opensRange = ⊤ := by
  simp only [opensRange_specAffineBlowupι]
  exact Proj.iSup_basicOpen_eq_top' _ _ (fun i => ⟨1, reesDegOne_mem_reesGrading I (hg i)⟩)
    (adjoin_range_reesDegOne_eq_top I hg hI)

/-- The affine chart `Spec R[I/a] ⟶ X` of the blowup `X` of `Spec R` in `I`, for `a ∈ I`: the
open immersion `Stacks.Blowup.specAffineBlowupι`, read into the affine model
`Stacks.Blowup.blowUpSpec`. -/
def blowUpSpecChart (a : R) (ha : a ∈ I) :
    Spec (CommRingCat.of (affineBlowup I a)) ⟶ blowUpSpec I :=
  specAffineBlowupι I a ha

/-- The affine chart of the blowup attached to `a ∈ I` is an open immersion. -/
instance instIsOpenImmersionBlowUpSpecChart (a : R) (ha : a ∈ I) :
    IsOpenImmersion (blowUpSpecChart I a ha) :=
  inferInstanceAs (IsOpenImmersion (specAffineBlowupι I a ha))

/-- Every point of the blowup of `Spec R` in `I` lies in the chart of some generator. -/
theorem exists_mem_range_blowUpSpecChart {ι : Type*} {g : ι → R} (hg : ∀ i, g i ∈ I)
    (hI : I = Ideal.span (Set.range g)) (x : blowUpSpec I) :
    ∃ (i : ι) (y : Spec (CommRingCat.of (affineBlowup I (g i)))),
      (blowUpSpecChart I (g i) (hg i)) y = x := by
  have hx : x ∈ ⨆ i, (blowUpSpecChart I (g i) (hg i)).opensRange :=
    (iSup_opensRange_specAffineBlowupι_of_eq_span I hg hI) ▸ trivial
  exact TopologicalSpace.Opens.mem_iSup.mp hx

/-- **The chart `Spec R[I/a]` lies over `Spec R` by the structure map of the affine blowup
algebra.** Composing the open immersion `Stacks.Blowup.blowUpSpecChart` with the structure
morphism of the blowup gives `Spec` of `R → R[I/a]`. -/
theorem blowUpSpecChart_toSpec (a : R) (ha : a ∈ I) :
    blowUpSpecChart I a ha ≫ toSpec I =
      Spec.map (CommRingCat.ofHom (algebraMap R (affineBlowup I a))) := by
  change Spec.map (reesAwayEquivAffineBlowup I a ha).toCommRingCatIso.hom ≫
      Proj.awayι (reesGrading I) (reesDegOne I ha) (reesDegOne_mem_reesGrading I ha) Nat.one_pos ≫
      (Proj.toSpecZero (reesGrading I) ≫
        Spec.map (CommRingCat.ofHom (reesGradingZeroEquiv I).toRingHom)) = _
  rw [Proj.awayι_toSpecZero_assoc, ← Spec.map_comp, ← Spec.map_comp]
  congr 1
  ext z
  exact congrArg Subtype.val ((reesAwayEquivAffineBlowup_fromZeroRingHom I a ha
      (reesGradingZeroEquiv I z)).trans
    (congrArg (algebraMap R (affineBlowup I a)) ((reesGradingZeroEquiv I).symm_apply_apply z)))

end Charts

/-! ### `Tor` as the cohomology of a base-changed resolution -/

section Tor

variable (A : Type u) [CommRing A] (B : Type u) [CommRing B] [Algebra A B]

/-- The carrier bridge between the two descriptions of `B ⊗_A M` as an `A`-module: the extension
of scalars of `M` with its `A`-action restricted along `A → B`, and the tensor product in the
category of `A`-modules. -/
def restrictExtendScalarsLinearEquiv (M : ModuleCat.{u} A) :
    ((ModuleCat.restrictScalars (algebraMap A B)).obj
        ((ModuleCat.extendScalars (algebraMap A B)).obj M) : Type u) ≃ₗ[A]
      ((tensorLeft (ModuleCat.of A B)).obj M : Type u) :=
  let E := StacksDraft.TorAmplitude.FaithfullyFlat.extendScalarsCarrierEquiv A B M
  { toFun := E, invFun := E.symm, left_inv := E.left_inv, right_inv := E.right_inv,
    map_add' := E.map_add'
    map_smul' := fun r x =>
      (E.map_smul (algebraMap A B r) x).trans (algebraMap_smul B r (E x)) }

/-- **Extension of scalars along `A → B`, read back as `A`-modules, is tensoring with `B`.** -/
def restrictExtendScalarsIso :
    ModuleCat.extendScalars (algebraMap A B) ⋙ ModuleCat.restrictScalars (algebraMap A B) ≅
      tensorLeft (ModuleCat.of A B) :=
  NatIso.ofComponents (fun M => (restrictExtendScalarsLinearEquiv A B M).toModuleIso) (by
    intro _ _ _
    ext : 1
    exact TensorProduct.ext' fun _ _ => rfl)

/-- **The `(-i)`-th cohomology of `B ⊗_A P^•` is `Tor_i^A(B, M)`**, for `P^•` the chosen
projective resolution of `M` placed in nonpositive degrees, read as an `A`-module.

Restriction of scalars is exact, extension followed by restriction of scalars is tensoring with
`B`, and the cohomology of `B ⊗_A P^•` in degree `-i` is the `i`-th left derived functor of
`B ⊗_A -` at `M`. -/
def restrictHomologyExtendScalarsTorIso (M : ModuleCat.{u} A) (i : ℕ) :
    (ModuleCat.restrictScalars (algebraMap A B)).obj
        ((((ModuleCat.extendScalars (algebraMap A B)).mapHomologicalComplex
            (ComplexShape.up ℤ)).obj (ProjectiveResolution.of M).cochainComplex).homology
          (-(i : ℤ)))
      ≅ ((Tor (ModuleCat.{u} A) i).obj (ModuleCat.of A B)).obj M :=
  Iso.symm ((((((ModuleCat.extendScalars (algebraMap A B)).mapHomologicalComplex
          (ComplexShape.up ℤ)).obj (ProjectiveResolution.of M).cochainComplex).sc
        (-(i : ℤ))).mapHomologyIso (ModuleCat.restrictScalars (algebraMap A B)))) ≪≫
    (HomologicalComplex.homologyFunctor _ _ (-(i : ℤ))).mapIso
      ((NatIso.mapHomologicalComplex (restrictExtendScalarsIso A B)
        (ComplexShape.up ℤ)).app (ProjectiveResolution.of M).cochainComplex) ≪≫
    (HomologicalComplex.homologyFunctor _ _ (-(i : ℤ))).mapIso
      (StacksDraft.TorAmplitude.FaithfullyFlat.mapHomologicalComplexExtendIso
        (ModuleCat.of A B) (ProjectiveResolution.of M).complex) ≪≫
    HomologicalComplex.extendHomologyIso _ ComplexShape.embeddingDownNat rfl ≪≫
    (ProjectiveResolution.isoLeftDerivedObj (ProjectiveResolution.of M)
      (tensorLeft (ModuleCat.of A B)) i).symm

/-- **An element of `A` annihilating `Tor_i^A(B, M)` annihilates, through `A → B`, the
`(-i)`-th cohomology of `B ⊗_A P^•`** for `P^•` the chosen projective resolution of `M`. -/
theorem smul_homology_extendScalars_eq_zero (M : ModuleCat.{u} A) (i : ℕ) (r : A)
    (hr : r ∈ Module.annihilator A
      (((Tor (ModuleCat.{u} A) i).obj (ModuleCat.of A B)).obj M))
    (x : (((ModuleCat.extendScalars (algebraMap A B)).mapHomologicalComplex
      (ComplexShape.up ℤ)).obj (ProjectiveResolution.of M).cochainComplex).homology (-(i : ℤ))) :
    (algebraMap A B r) • x = 0 := by
  have e := restrictHomologyExtendScalarsTorIso A B M i
  apply (ConcreteCategory.bijective_of_isIso e.hom).1
  change e.hom.hom ((algebraMap A B r) • x) = e.hom.hom 0
  exact (e.hom.hom.map_smul r x).trans
    ((Module.mem_annihilator.mp hr (e.hom x)).trans (map_zero _).symm)

end Tor

/-! ### The cohomology sheaf on an affine chart -/

section Chart

variable {X : Scheme.{u}} {R S : CommRingCat.{u}} (p : X ⟶ Spec R)
    (ι : Spec S ⟶ X) [IsOpenImmersion ι] (φ : R ⟶ S) (hι : ι ≫ p = Spec.map φ)

/-- **Restricting the pullback of an associated sheaf to an affine open over the base gives the
associated sheaf of the base change.** If `ι : Spec S ⟶ X` is an open immersion with
`ι ≫ p = Spec φ`, then `ι^*p^*M̃ ≅ (S ⊗_R M)~`, naturally in the `R`-module `M`.

Restriction along an open immersion is pullback, pullback composes, and pullback along `Spec φ`
of an associated sheaf is the associated sheaf of the extension of scalars (Stacks tag 01I9). -/
def chartPullbackTildeIso :
    tilde.functor R ⋙ Scheme.Modules.pullback p ⋙ Scheme.Modules.restrictFunctor ι ≅
      ModuleCat.extendScalars φ.hom ⋙ tilde.functor S :=
  Functor.isoWhiskerLeft _ (Functor.isoWhiskerLeft _
      (Scheme.Modules.restrictFunctorIsoPullback ι)) ≪≫
    Functor.isoWhiskerLeft _ (RingedSpaceModuleAdjunction.modulePullbackComp
      ι.toLRSHom.toShHom p.toLRSHom.toShHom).symm ≪≫
    Functor.isoWhiskerLeft _ (RingedSpaceModuleAdjunction.modulePullbackCongr
      (show ι.toLRSHom.toShHom ≫ p.toLRSHom.toShHom
        = (Spec.map φ).toLRSHom.toShHom from congrArg (fun f : Spec S ⟶ Spec R =>
          f.toLRSHom.toShHom) hι)) ≪≫
    AlgebraicGeometry.pullbackTildeIso R S φ

/-- **The restriction to an affine chart of the cohomology of the pullback of a complex of
associated sheaves is the associated sheaf of the cohomology of the base change.**

Restriction along an open immersion and sheafification are both exact, so taking cohomology
commutes with them, and the complexes are identified degreewise by
`Stacks.Blowup.chartPullbackTildeIso`. -/
def chartHomologyIso (P : CochainComplex (ModuleCat.{u} R) ℤ) (j : ℤ) :
    (Scheme.Modules.restrictFunctor ι).obj
        ((((Scheme.Modules.pullback p).mapHomologicalComplex (ComplexShape.up ℤ)).obj
          (((tilde.functor R).mapHomologicalComplex (ComplexShape.up ℤ)).obj P)).homology j) ≅
      tilde ((((ModuleCat.extendScalars φ.hom).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj P).homology j) :=
  haveI := Stacks.AffineTilde.tildeFunctor_preservesHomology S
  Iso.symm (((((Scheme.Modules.pullback p).mapHomologicalComplex (ComplexShape.up ℤ)).obj
      (((tilde.functor R).mapHomologicalComplex (ComplexShape.up ℤ)).obj P)).sc j).mapHomologyIso
      (Scheme.Modules.restrictFunctor ι)) ≪≫
    (HomologicalComplex.homologyFunctor _ _ j).mapIso
      ((NatIso.mapHomologicalComplex (chartPullbackTildeIso p ι φ hι)
        (ComplexShape.up ℤ)).app P) ≪≫
    ((((ModuleCat.extendScalars φ.hom).mapHomologicalComplex
      (ComplexShape.up ℤ)).obj P).sc j).mapHomologyIso (tilde.functor S)

omit [IsOpenImmersion ι] in
/-- The global section of the base pulled back to an affine chart: it is the restriction to the
chart of the image of the element under `φ`. -/
theorem appLE_appTop_ΓSpecIso_inv (hι' : ι ≫ p = Spec.map φ) (r : R) (V : (Spec S).Opens) :
    ι.appLE ⊤ V (by simp) (p.appTop ((Scheme.ΓSpecIso R).inv r)) =
      (Spec S).presheaf.map (homOfLE (show V ≤ ⊤ from le_top)).op
        ((Scheme.ΓSpecIso S).inv (φ r)) := by
  have h2 : ι.appTop (p.appTop ((Scheme.ΓSpecIso R).inv r))
      = (Scheme.ΓSpecIso S).inv (φ r) := by
    rw [← ConcreteCategory.comp_apply, ← Scheme.Hom.comp_appTop, hι',
      ← ConcreteCategory.comp_apply, ← Scheme.ΓSpecIso_inv_naturality,
      ConcreteCategory.comp_apply]
  change (Spec S).presheaf.map _ (ι.appTop (p.appTop _)) = _
  rw [h2]
  rfl

end Chart

/-! ### From the charts to the blowup -/

section Local

/-- **A base-ring element annihilating a module annihilates every section of the associated
sheaf.** -/
theorem tilde_smul_section_eq_zero {R : CommRingCat.{u}} (M : ModuleCat.{u} R) (a : R)
    (ha : ∀ m : M, a • m = 0) (U : (Spec R).Opens) (x : Γ(tilde M, U)) : a • x = 0 := by
  apply Subtype.ext
  funext q
  change (algebraMap R (Localization.AtPrime q.val.asIdeal) a) • x.val q = 0
  rw [algebraMap_smul]
  induction x.val q using LocalizedModule.induction_on with
  | h m s => simp [LocalizedModule.smul'_mk, ha]

/-- Annihilation of a section transported along an isomorphism of sheaves of modules. -/
theorem section_smul_eq_zero_of_iso {X : Scheme.{u}} {F G : X.Modules}
    (e : F ≅ G) (U : X.Opens) (r : Γ(X, U)) (s : Γ(F, U))
    (h : r • e.hom.app U s = 0) : r • s = 0 := by
  apply (ConcreteCategory.bijective_of_isIso (e.hom.app U)).1
  simpa only [map_zero, Scheme.Modules.Hom.app_smul] using h

/-- **A global section of the base annihilating all sections over each member of an open cover
annihilates all sections.** The cover is given by open immersions whose images are jointly
surjective. -/
theorem section_smul_eq_zero_of_cover {X : Scheme.{u}} (F : X.Modules)
    {ι : Type*} (Y : ι → Scheme.{u}) (q : ∀ i, Y i ⟶ X)
    [∀ i, IsOpenImmersion (q i)] (hcover : ∀ x : X, ∃ i y, (q i) y = x)
    (r : Γ(X, ⊤))
    (h : ∀ i (V : (Y i).Opens) (s : Γ(F.restrict (q i), V)),
      (q i).appLE ⊤ V (by simp) r • s = 0)
    (U : X.Opens) (s : Γ(F, U)) :
    X.presheaf.map (homOfLE (show U ≤ ⊤ from le_top)).op r • s = 0 := by
  apply TopCat.Presheaf.IsSheaf.section_ext (Scheme.Modules.isSheaf F)
  intro x hx
  obtain ⟨i, y, rfl⟩ := hcover x
  let V := (q i) ⁻¹ᵁ U
  let W := (q i) ''ᵁ V
  have hWU : W ≤ U := (q i).image_preimage_le U
  refine ⟨W, hWU, ⟨y, hx, rfl⟩, ?_⟩
  let e := F.restrictAppIso (q i) V
  let s' := e.inv (F.presheaf.map (homOfLE hWU).op s)
  have hs := congrArg (fun z => e.hom z) (h i V s')
  rw [map_zero, Scheme.Modules.smul_restrictAppIso_hom_apply] at hs
  rw [show e.hom s' = F.presheaf.map (homOfLE hWU).op s from
    ConcreteCategory.congr_hom e.inv_hom_id _] at hs
  rw [show ((q i).appIso V).inv ((q i).appLE ⊤ V (by simp) r) =
      X.presheaf.map (homOfLE (show W ≤ ⊤ from le_top)).op r from
    ConcreteCategory.congr_hom ((q i).appLE_appIso_inv (U := ⊤) (V := V) (by simp)) r] at hs
  simpa only [map_zero, Scheme.Modules.map_smul, ← ConcreteCategory.comp_apply,
    ← Functor.map_comp, ← op_comp, homOfLE_comp] using hs

end Local

/-! ### Uniform `Tor` annihilation over the charts of a generating family -/

section Uniform

variable {A : Type u} [CommRing A] [IsNoetherianRing A]

/-- **Uniform annihilation of the high `Tor` modules on the chart of one chosen generator.**
Stacks tag 0G9Y is stated with the distinguished generator in position `0`; this is the same
statement for an arbitrary member of the family, obtained by permuting the generators. -/
theorem exists_pow_le_annihilator_tor_affineBlowup {n : ℕ} (g : Fin (n + 1) → A)
    (I : Ideal A) (hI : I = Ideal.span (Set.range g)) (k : Fin (n + 1)) :
    ∃ c : ℕ, 0 < c ∧ ∀ (M : ModuleCat.{u} A) (i : ℕ), n + 1 ≤ i →
      I ^ c ≤ Module.annihilator A
        (((Tor (ModuleCat.{u} A) i).obj (ModuleCat.of A (affineBlowup I (g k)))).obj M) := by
  classical
  set e : Equiv.Perm (Fin (n + 1)) := Equiv.swap 0 k with he
  set g' : Fin (n + 1) → A := fun j => if (j : ℕ) = 0 then g k else g (e j)
  have hrange : Set.range g' = Set.range g := by
    have hg'eq : g' = g ∘ e := by
      funext j
      change (if (j : ℕ) = 0 then g k else g (e j)) = g (e j)
      by_cases hj : (j : ℕ) = 0
      · obtain rfl : j = 0 := Fin.ext hj
        simp [he]
      · simp [hj]
    rw [hg'eq, Set.range_comp, e.range_eq_univ, Set.image_univ]
  have hI' : I = Ideal.span (Set.range g') := by rw [hI, hrange]
  have : IsLocalization.Away (g' 0) (Localization.Away (g k)) :=
    inferInstanceAs (IsLocalization.Away (g k) (Localization.Away (g k)))
  obtain ⟨c, hc, hh⟩ := exists_pow_le_annihilator_tor_affineBlowupAlgebra g' I hI'
    (Localization.Away (g k))
  refine ⟨c, hc, fun M i hi => ?_⟩
  rw [show affineBlowup I (g k) = affineBlowupAlgebra I (g' 0) (Localization.Away (g k)) from
    affineBlowup_eq_affineBlowupAlgebra I (g k)]
  exact hh M i hi

/-- **One power of `I` annihilates the high `Tor` modules on all the charts at once.** Take the
sum of the exponents supplied by `Stacks.Blowup.exists_pow_le_annihilator_tor_affineBlowup` over
the finitely many generators. -/
theorem exists_uniform_pow_le_annihilator_tor_affineBlowup {n : ℕ} (g : Fin (n + 1) → A)
    (I : Ideal A) (hI : I = Ideal.span (Set.range g)) :
    ∃ c : ℕ, 0 < c ∧ ∀ (k : Fin (n + 1)) (M : ModuleCat.{u} A) (i : ℕ), n + 1 ≤ i →
      I ^ c ≤ Module.annihilator A
        (((Tor (ModuleCat.{u} A) i).obj (ModuleCat.of A (affineBlowup I (g k)))).obj M) := by
  choose d hdpos hd using exists_pow_le_annihilator_tor_affineBlowup g I hI
  exact ⟨∑ k, d k, Finset.sum_pos (fun k _ => hdpos k) ⟨0, Finset.mem_univ _⟩,
    fun k M i hi => (Ideal.pow_le_pow_right
      (Finset.single_le_sum (fun j _ => Nat.zero_le (d j)) (Finset.mem_univ k))).trans
      (hd k M i hi)⟩

end Uniform

/-! ### Annihilation of a section on an affine chart -/

section ChartSection

variable {X : Scheme.{u}} {R S : CommRingCat.{u}} (p : X ⟶ Spec R)
    (ι : Spec S ⟶ X) [IsOpenImmersion ι] (φ : R ⟶ S)

/-- **An element of the base ring annihilating the cohomology of the base-changed complex
annihilates every section over the affine chart.** This is the chart-wise form of the
annihilation statement: the global section of `X` obtained from `r : R` through `p`, restricted
to an open of the chart `Spec S`, kills every section of the restriction to the chart of
`H^j(p^*M̃^•)`. -/
theorem chart_section_smul_eq_zero (hι : ι ≫ p = Spec.map φ)
    (P : CochainComplex (ModuleCat.{u} R) ℤ) (j : ℤ) (r : R)
    (hr : ∀ x : (((ModuleCat.extendScalars φ.hom).mapHomologicalComplex
      (ComplexShape.up ℤ)).obj P).homology j, φ r • x = 0)
    (V : (Spec S).Opens)
    (z : Γ(((((Scheme.Modules.pullback p).mapHomologicalComplex (ComplexShape.up ℤ)).obj
      (((tilde.functor R).mapHomologicalComplex (ComplexShape.up ℤ)).obj P)).homology
        j).restrict ι, V)) :
    ι.appLE ⊤ V (by simp) (p.appTop ((Scheme.ΓSpecIso R).inv r)) • z = 0 := by
  rw [appLE_appTop_ΓSpecIso_inv p ι φ hι r V]
  exact section_smul_eq_zero_of_iso (chartHomologyIso p ι φ hι P j) V _ z
    (tilde_smul_section_eq_zero _ _ hr V _)

end ChartSection

/-! ### The chart-wise annihilation for the blowup -/

section ChartAnnihilation

variable {A : Type u} [CommRing A] [IsNoetherianRing A]

omit [IsNoetherianRing A] in
/-- **The chart-wise annihilation input of Stacks tag 0GA0.** Under the uniform `Tor`
annihilation over the charts, an element of `Iᶜ` kills, through the structure map of the chart,
the degree-`j` cohomology of `A[I/a_k] ⊗_A P^•` for `P^•` the chosen projective resolution of
`M`, whenever `j ≤ -(n+1)`.

This is where the cohomological index `j ≤ -(n+1)` of the source is converted into the
homological index `i ≥ n + 1` of `Tor`; every other statement is at a general `j`. -/
theorem chart_homology_smul_eq_zero {n : ℕ} {g : Fin (n + 1) → A} {I : Ideal A} {c : ℕ}
    (hann : ∀ (k : Fin (n + 1)) (M : ModuleCat.{u} A) (i : ℕ), n + 1 ≤ i →
      I ^ c ≤ Module.annihilator A (((Tor (ModuleCat.{u} A) i).obj
        (ModuleCat.of A (affineBlowup I (g k)))).obj M))
    (M : ModuleCat.{u} (CommRingCat.of A)) (j : ℤ) (hj : j ≤ -((n : ℤ) + 1))
    (r : A) (hr : r ∈ I ^ c) (k : Fin (n + 1))
    (x : (((ModuleCat.extendScalars
        (CommRingCat.ofHom (algebraMap A (affineBlowup I (g k)))).hom).mapHomologicalComplex
        (ComplexShape.up ℤ)).obj (ProjectiveResolution.of M).cochainComplex).homology j) :
    (CommRingCat.ofHom (algebraMap A (affineBlowup I (g k)))) r • x = 0 := by
  obtain ⟨i, rfl⟩ := Int.exists_eq_neg_ofNat (hj.trans (neg_nonpos.mpr (by positivity)))
  exact smul_homology_extendScalars_eq_zero A (affineBlowup I (g k)) M i r
    (hann k M i (by omega) hr) x

end ChartAnnihilation

/-! ### Stacks tag 0GA0 -/

section Main

variable {A : Type u} [CommRing A] [IsNoetherianRing A]

/-- **Stacks Project, Tag 0GA0.** Let `A` be a Noetherian ring and `I = (a₀, …, a_n) ⊆ A` an
ideal with `t = n + 1` generators, and let `p : X ⟶ Spec A` be the blowup of `Spec A` in `I`,
that is `X = Proj(⨁_{m ≥ 0} Iᵐ)`. There is an integer `c > 0`, depending only on `A` and `I`,
such that for every `A`-module `M` the cohomology sheaves `H^j(Lp^*M̃)` are annihilated by `Iᶜ`
for all `j ≤ -t`.

Annihilation is expressed on sections: an element `r ∈ Iᶜ`, viewed as a global section of `X`
through `p` and restricted to an open `U`, kills every section of `H^j(Lp^*M̃)` over `U`. -/
@[stacks 0GA0]
theorem exists_pow_le_annihilator_homology_derivedPullback {n : ℕ} (g : Fin (n + 1) → A)
    (I : Ideal A) (hI : I = Ideal.span (Set.range g)) :
    ∃ c : ℕ, 0 < c ∧ ∀ (M : ModuleCat.{u} (CommRingCat.of A)) (j : ℤ), j ≤ -((n : ℤ) + 1) →
      ∀ (U : (blowUpSpec I).Opens) (r : A), r ∈ I ^ c →
        ∀ s : Γ((DerivedCategory.homologyFunctor (blowUpSpec I).Modules j).obj
            ((Stacks.Cohomology.DerivedAdjunctionOnRingedSpaces.derivedPullback
              (toSpecRingedSpace I)).obj (DerivedCategory.Q.obj (tildeComplex
              ((CochainComplex.singleFunctor (ModuleCat.{u} (CommRingCat.of A)) 0).obj M)))), U),
          (blowUpSpec I).presheaf.map (homOfLE (show U ≤ ⊤ from le_top)).op
            ((toSpec I).appTop ((Scheme.ΓSpecIso (CommRingCat.of A)).inv r)) • s = 0 := by
  obtain ⟨c, hc, hann⟩ := exists_uniform_pow_le_annihilator_tor_affineBlowup g I hI
  have hgI : ∀ k, g k ∈ I := fun k => hI ▸ Ideal.subset_span ⟨k, rfl⟩
  refine ⟨c, hc, fun M j hj U r hr s => ?_⟩
  have hflat : ∀ i : ℤ, Module.Flat (CommRingCat.of A)
      ((ProjectiveResolution.of M).cochainComplex.X i) := fun i =>
    have : Module.Projective (CommRingCat.of A)
        ((ProjectiveResolution.of M).cochainComplex.X i) :=
      ModuleCat.projective_of_module_projective _
    inferInstance
  have hkflat : CochainComplex.KFlat.{u, u} (ProjectiveResolution.of M).cochainComplex :=
    CochainComplex.KFlat.kFlat_of_flat _ 0
  refine section_smul_eq_zero_of_iso
    ((DerivedCategory.homologyFunctor (blowUpSpec I).Modules j).mapIso
        (derivedPullbackTildeSingleIso (toSpecRingedSpace I) M
          (ProjectiveResolution.of M).cochainComplex hkflat
          (ProjectiveResolution.of M).π' inferInstance) ≪≫
      (DerivedCategory.homologyFunctorFactors (blowUpSpec I).Modules j).app _)
    U _ s ?_
  refine section_smul_eq_zero_of_cover _
    (fun k => Spec (CommRingCat.of (affineBlowup I (g k))))
    (fun k => blowUpSpecChart I (g k) (hgI k))
    (exists_mem_range_blowUpSpecChart I hgI hI) _ (fun k V z => ?_) U _
  exact chart_section_smul_eq_zero (toSpec I) (blowUpSpecChart I (g k) (hgI k))
    (CommRingCat.ofHom (algebraMap A (affineBlowup I (g k))))
    (blowUpSpecChart_toSpec I (g k) (hgI k))
    (ProjectiveResolution.of M).cochainComplex j r
    (chart_homology_smul_eq_zero hann M j hj r hr k) V z

end Main

end Stacks.Blowup

end
