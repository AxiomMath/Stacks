public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.RegularImmersion.KoszulRegularSmoothCover

/-!
# The exceptional divisor of the blowup along a regular immersion is smooth over the centre

Let `i : Z ⟶ X` be a regular closed immersion and `b : X' ⟶ X` the blowing up of `X` with centre
`Z` (`Stacks.Blowup.blowUp`). The exceptional divisor `E = X' ×_X Z` comes with the projection
`π : E ⟶ Z`, and the proof of Stacks 0FVA uses that `π` is smooth: by Stacks 063M,
`E = P(𝒞_{Z/X})` is a projective space bundle over `Z`. This file proves the smoothness of `π`
chart by chart: over an affine open `Spec A` of `X` on which the ideal of `Z` is generated by an
`H₁`-regular sequence `f₀, …, f_r`, the part of `E` over the chart `Spec A[I/f₀]` of `X'` is
`Spec (A[I/f₀]/I·A[I/f₀]) = Spec (A/I)[X₁, …, X_r]`, an affine space over `Z ∩ Spec A`
(`Koszul.smooth_quotientMap_affineBlowup`, from Stacks 0BIQ).

## Main results

* `Stacks.Blowup.exists_isPullback_specMap_quotient_ker`: the part of a closed subscheme `Z` over
  an affine open `Spec A` of `X` is `Spec (A/I)`, `I` the ideal of `Z` on `Spec A`, as a
  cartesian square.
* `Stacks.Blowup.smooth_pullbackSnd_blowUpToBase`: the projection `X' ×_X Z ⟶ Z` from the
  exceptional divisor of the blowing up along a regular closed immersion to the centre is smooth.
* `Stacks.Blowup.isRegularImmersion_pullbackFst_blowUpToBase`: the inclusion `X' ×_X Z ⟶ X'` of
  the exceptional divisor is a regular immersion, being an effective Cartier divisor (Stacks
  02OS).

## References

* [Stacks Project, Tag 0FVA](https://stacks.math.columbia.edu/tag/0FVA)
* [Stacks Project, Tag 063M](https://stacks.math.columbia.edu/tag/063M)
* [Stacks Project, Tag 0BIQ](https://stacks.math.columbia.edu/tag/0BIQ)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace AlgebraicGeometry
open Stacks.AlgebraicGeometry.RegularIdealSheaf

universe u

namespace Stacks.Blowup

/-- **A closed subscheme over an affine open.** For a closed immersion `i : Z ⟶ X` and an affine
open `U = Spec A` of `X`, with `I` the ideal of `Z` on `U`, the square

```
Spec (A/I) ⟶ Spec A
    |           |
    j         U ⟶ X
    v           v
    Z ----i---> X
```

is cartesian, with `j` an open immersion (the inclusion of `Z ∩ U`). -/
theorem exists_isPullback_specMap_quotient_ker {Z X : Scheme.{u}} (i : Z ⟶ X)
    [IsClosedImmersion i] (U : X.affineOpens) :
    ∃ j : Spec (CommRingCat.of (Γ(X, U.1) ⧸ i.ker.ideal U)) ⟶ Z, IsOpenImmersion j ∧
      IsPullback (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk (i.ker.ideal U)))) j
        U.2.fromSpec i := by
  let qc := Stacks.CartierQuotientChart.quotientChart i.ker U
  let j : Spec (CommRingCat.of (Γ(X, U.1) ⧸ i.ker.ideal U)) ⟶ Z :=
    qc.inv ≫ pullback.fst i.ker.subschemeι U.1.ι ≫ inv i.toImage
  refine ⟨j, by dsimp only [j]; infer_instance, ?_⟩
  refine (IsPullback.of_hasPullback i.ker.subschemeι U.1.ι).flip.of_iso qc U.2.isoSpec
    (asIso i.toImage).symm (Iso.refl X) ?_ ?_ ?_ ?_
  · exact Stacks.CartierQuotientChart.quotientChart_hom_comp i.ker U
  · simp [j, qc]
  · rw [Iso.refl_hom, Category.comp_id, ← U.2.isoSpec_inv_ι, Iso.hom_inv_id_assoc]
  · simp only [Iso.refl_hom, Category.comp_id, Iso.symm_hom, asIso_inv]
    exact ((IsIso.inv_comp_eq _).2 (i.toImage_imageι).symm).symm

/-- `Koszul.smooth_quotientMap_affineBlowup` for an ideal and an element given up to equality. -/
theorem smooth_quotientMap_affineBlowup_of_eq {A : Type u} [CommRing A] {r : ℕ}
    (f : Fin (r + 1) → A) (hf : Koszul.IsH1Regular f) (I : Ideal A) (a : A)
    (hI : I = Ideal.span (Set.range f)) (ha : a = f 0) :
    (Ideal.quotientMap (I.map (algebraMap A (affineBlowup I a))) (algebraMap A (affineBlowup I a))
      Ideal.le_comap_map).Smooth := by
  subst hI ha
  exact Koszul.smooth_quotientMap_affineBlowup f hf

variable {Z X : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]

/-- The part of the exceptional divisor `X' ×_X Z` over the affine chart `Spec A[I/a]` of the
blowing up is the pullback of `Z` along `Spec A[I/a] ⟶ Spec A ⟶ X`. -/
theorem isPullback_blowUpAffineChart_pullbackSnd (U : X.affineOpens) {a : Γ(X, U.1)}
    (ha : a ∈ i.ker.ideal U) :
    IsPullback ((pullback.fst (blowUpToBase i.ker) i) ∣_ (blowUpAffineChart i.ker U ha).opensRange ≫
        (blowUpAffineChart i.ker U ha).isoOpensRange.inv)
      ((pullback.fst (blowUpToBase i.ker) i ⁻¹ᵁ (blowUpAffineChart i.ker U ha).opensRange).ι ≫
        pullback.snd (blowUpToBase i.ker) i)
      (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U.1) (affineBlowup (i.ker.ideal U) a))) ≫
        U.2.fromSpec) i := by
  set c := blowUpAffineChart i.ker U ha
  have hcb : c ≫ blowUpToBase i.ker = Spec.map (CommRingCat.ofHom
      (algebraMap Γ(X, U.1) (affineBlowup (i.ker.ideal U) a))) ≫ U.2.fromSpec :=
    blowUpAffineChart_blowUpToBase i.ker U ha
  have hι : c.isoOpensRange.inv ≫ c = c.opensRange.ι := by
    rw [Iso.inv_comp_eq, Scheme.Hom.isoOpensRange_hom_ι]
  refine ((isPullback_morphismRestrict (pullback.fst (blowUpToBase i.ker) i)
    c.opensRange).paste_vert (IsPullback.of_hasPullback (blowUpToBase i.ker) i)).of_iso (Iso.refl _)
    c.isoOpensRange.symm (Iso.refl _) (Iso.refl _) ?_ ?_ ?_ ?_
  · simp [c]
  · rfl
  · rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom, ← hcb, ← hι, Category.assoc]
  · simp

/-- Every point of the exceptional divisor `X' ×_X Z` of the blowing up along a regular closed
immersion has an open neighbourhood smooth over the centre `Z`. -/
theorem exists_mem_opens_smooth_pullbackSnd_blowUpToBase (hi : IsRegularImmersion i)
    (x : (pullback (blowUpToBase i.ker) i : Scheme.{u})) :
    ∃ W : (pullback (blowUpToBase i.ker) i : Scheme.{u}).Opens,
      x ∈ W ∧ Smooth (W.ι ≫ pullback.snd (blowUpToBase i.ker) i) := by
  set x' := (pullback.fst (blowUpToBase i.ker) i).base x
  obtain ⟨U, hsU, r, f, hker, hf⟩ :=
    exists_affineOpen_ker_eq_span_isH1Regular i hi ((blowUpToBase i.ker).base x')
  have hmem : ∀ k, f k ∈ i.ker.ideal U := fun k => hker ▸ Ideal.subset_span ⟨k, rfl⟩
  have hxU : x' ∈ blowUpToBase i.ker ⁻¹ᵁ (U : X.Opens) := hsU
  have hcover : ⨆ k, (blowUpAffineChart i.ker U (hmem k)).opensRange =
      blowUpToBase i.ker ⁻¹ᵁ (U : X.Opens) := by
    rw [blowUpToBase_preimage_coe]
    simp only [blowUpAffineChart, Scheme.Hom.opensRange_comp, ← Scheme.Hom.image_iSup,
      iSup_opensRange_specAffineBlowupι_of_eq_span (i.ker.ideal U) hmem hker,
      Scheme.Hom.image_top_eq_opensRange]
  rw [← hcover] at hxU
  obtain ⟨k, hxk⟩ := Opens.mem_iSup.mp hxU
  obtain ⟨n, rfl⟩ : ∃ n, r = n + 1 := Nat.exists_eq_succ_of_ne_zero (Fin.pos k).ne'
  let g : Fin (n + 1) → Γ(X, U.1) := f ∘ Equiv.swap 0 k
  have hspan : Ideal.span (Set.range g) = Ideal.span (Set.range f) := by
    simp only [g, Set.range_comp, Equiv.range_eq_univ, Set.image_univ]
  have hg : Koszul.IsH1Regular g :=
    (Koszul.regularity_of_generators_of_eq_span_range (Ideal.span (Set.range f)) g
      hspan).2.1 ⟨f, rfl, hf⟩
  set c := blowUpAffineChart i.ker U (hmem k)
  set W' := c.opensRange
  let φ : Γ(X, U.1) ⟶ CommRingCat.of (affineBlowup (i.ker.ideal U) (f k)) :=
    CommRingCat.ofHom (algebraMap Γ(X, U.1) (affineBlowup (i.ker.ideal U) (f k)))
  let W := (pullback.fst (blowUpToBase i.ker) i) ⁻¹ᵁ W'
  refine ⟨W, hxk, ?_⟩
  have h₁ : IsPullback ((pullback.fst (blowUpToBase i.ker) i) ∣_ W' ≫ (c.isoOpensRange).inv)
      (W.ι ≫ pullback.snd (blowUpToBase i.ker) i) (Spec.map φ ≫ U.2.fromSpec) i :=
    isPullback_blowUpAffineChart_pullbackSnd i U (hmem k)
  obtain ⟨j, hj, hsq⟩ := exists_isPullback_specMap_quotient_ker i U
  have h₂ := (Stacks.Flatness.isPullback_SpecMap_quotient φ (i.ker.ideal U)).paste_vert hsq
  rw [← IsPullback.isoIsPullback_hom_snd _ _ h₁ h₂]
  have hring : (Ideal.quotientMap ((i.ker.ideal U).map φ.hom) φ.hom
      Ideal.le_comap_map).Smooth :=
    smooth_quotientMap_affineBlowup_of_eq g hg _ _ (hker.trans hspan.symm) (by simp [g])
  have : Smooth (Spec.map (CommRingCat.ofHom
      (Ideal.quotientMap ((i.ker.ideal U).map φ.hom) φ.hom Ideal.le_comap_map))) :=
    HasRingHomProperty.Spec_iff.2 hring
  infer_instance

/-- **The exceptional divisor of the blowing up along a regular closed immersion is smooth over
the centre.** Let `i : Z ⟶ X` be a regular closed immersion and `b : X' ⟶ X` the blowing up of
`X` with centre `Z`. Then the projection `X' ×_X Z ⟶ Z` from the exceptional divisor is smooth
(Stacks 0FVA, from Stacks 063M and 0BIQ). -/
theorem smooth_pullbackSnd_blowUpToBase (hi : IsRegularImmersion i) :
    Smooth (pullback.snd (blowUpToBase i.ker) i) := by
  choose W hxW hW using exists_mem_opens_smooth_pullbackSnd_blowUpToBase i hi
  have : IsZariskiLocalAtSource @Smooth.{u} :=
    HasRingHomProperty.instIsZariskiLocalAtSource (P := @Smooth)
  exact IsZariskiLocalAtSource.of_iSup_eq_top (P := @Smooth) W
    (top_le_iff.mp fun x _ => Opens.mem_iSup.mpr ⟨x, hxW x⟩) hW

/-- **The exceptional divisor is a regular immersion.** For a closed immersion `i : Z ⟶ X` and the
blowing up `b : X' ⟶ X` of `X` along `Z`, the projection `X' ×_X Z ⟶ X'` is a regular immersion:
it is the inclusion of the exceptional divisor, an effective Cartier divisor (Stacks 02OS), and an
effective Cartier divisor is a regular immersion. -/
theorem isRegularImmersion_pullbackFst_blowUpToBase :
    IsRegularImmersion (pullback.fst (blowUpToBase i.ker) i) := by
  let e₁ : pullback (blowUpToBase i.ker) i ≅ pullback (blowUpToBase i.ker) i.imageι :=
    asIso (pullback.map (blowUpToBase i.ker) i (blowUpToBase i.ker) i.imageι (𝟙 _) i.toImage (𝟙 _)
      (by simp) (by simp))
  have he : e₁.hom ≫ (i.ker.comapIso (blowUpToBase i.ker)).inv ≫
      (i.ker.comap (blowUpToBase i.ker)).subschemeι = pullback.fst (blowUpToBase i.ker) i := by
    have h := i.ker.comapIso_hom_fst (blowUpToBase i.ker)
    rw [← Iso.eq_inv_comp] at h
    rw [← h]
    exact (pullback.lift_fst _ _ _).trans (Category.comp_id _)
  have hreg : IsRegularImmersion (i.ker.comap (blowUpToBase i.ker)).subschemeι :=
    Stacks.AlgebraicGeometry.isRegularImmersion_subschemeι_of_isEffectiveCartierDivisor
      (exceptionalIdeal i.ker) (isEffectiveCartierDivisor_exceptionalIdeal_reesData i.ker)
  have key : ∀ {A B : Scheme.{u}} {f g : A ⟶ B} [IsImmersion f] [IsImmersion g], f = g →
      IsRegularImmersion f → IsRegularImmersion g := by
    rintro A B f g _ _ rfl hf
    exact hf
  exact key ((Category.assoc _ _ _).trans he)
    (Stacks.AlgebraicGeometry.isRegularImmersion_comp_iso
      (e₁ ≪≫ (i.ker.comapIso (blowUpToBase i.ker)).symm) _ hreg)

end Stacks.Blowup

end
