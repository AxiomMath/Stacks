module

public import StacksFrontier.AlgebraicGeometry.RelativeDifferentialStalkMap.Scheme
public import StacksFrontier.AlgebraicGeometry.SmoothAtFiber.Numerical
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Condition (4) of Tag 01V9 implies condition (3)

Conditions (3) and (4) of Stacks Tag 01V9 bound the number of generators of the stalk at `x` of
the sheaf of relative differentials of `f : X ⟶ S`: condition (3) over the local ring
`𝒪_{X,x}`, condition (4) over the residue field `κ(x)`. For `f` locally of finite type,
condition (4) implies condition (3), and the two conditions are equivalent.

## Main results

* `Stacks.RelativeDifferentialStalkMap.generatedByAtMost_of_tensor_residueField`: Nakayama's
  lemma for a bound on the number of generators — if `κ ⊗ M` is generated over the residue field
  by at most `d` elements and `M` is finite over a local ring, then `M` is generated by at most
  `d` elements.
* `Stacks.RelativeDifferentialStalkMap.essFiniteType_stalkMap`: the stalk map of a morphism
  locally of finite type is essentially of finite type.
* `Stacks.RelativeDifferentialStalkMap.finite_relativeDifferentialStalk`: the stalk of the sheaf
  of relative differentials is a finite module over `𝒪_{X,x}`.  This is Tag 01V2 read at a
  point.
* `Stacks.RelativeDifferentialStalkMap.condition4_imp_condition3`: condition (4) implies
  condition (3).
* `Stacks.RelativeDifferentialStalkMap.condition3_iff_condition4`: conditions (3) and (4) are
  equivalent for a morphism locally of finite type.

## References

* [Stacks Project, Tag 01V9](https://stacks.math.columbia.edu/tag/01V9)
* [Stacks Project, Tag 01V2](https://stacks.math.columbia.edu/tag/01V2)
-/

@[expose] public section

open CategoryTheory
open AlgebraicGeometry
open Stacks.SmoothAtJacobian
open scoped TensorProduct

universe u v

namespace Stacks.RelativeDifferentialStalkMap

/-- **Nakayama's lemma for a bound on the number of generators.** If the residue-field fibre
`κ ⊗[B] M` of a finite module `M` over a local ring `B` is generated over `κ` by at most `d`
elements, then `M` is generated over `B` by at most `d` elements. -/
@[ega "0 1.7.5" "more general"]
public theorem generatedByAtMost_of_tensor_residueField {B : Type u} [CommRing B] [IsLocalRing B]
    {M : Type v} [AddCommGroup M] [Module B M] [Module.Finite B M] {d : WithBot ℕ∞}
    (h : GeneratedByAtMost (IsLocalRing.ResidueField B)
      (IsLocalRing.ResidueField B ⊗[B] M) d) :
    GeneratedByAtMost B M d := by
  classical
  obtain ⟨s, hspan, hcard⟩ := h
  choose g hg using TensorProduct.mk_surjective B M (IsLocalRing.ResidueField B)
    Ideal.Quotient.mk_surjective
  refine ⟨s.image g, ?_, le_trans ?_ hcard⟩
  · rw [← IsLocalRing.map_tensorProduct_mk_eq_top, Submodule.map_span,
      ← Submodule.restrictScalars_span B (IsLocalRing.ResidueField B)
        Ideal.Quotient.mk_surjective, Submodule.restrictScalars_eq_top_iff]
    have himg : (TensorProduct.mk B (IsLocalRing.ResidueField B) M 1) ''
        (↑(s.image g) : Set M) = (↑s : Set (IsLocalRing.ResidueField B ⊗[B] M)) := by
      rw [Finset.coe_image, Set.image_image]
      simp [hg]
    rwa [himg]
  · exact_mod_cast Finset.card_image_le

variable {X S : Scheme.{u}} (f : X ⟶ S) (x : X)

/-- **The stalk map of a morphism locally of finite type is essentially of finite type**, for
the algebra structure `Stacks.RelativeDifferentialStalkMap.algebraStalkMap`. -/
public theorem essFiniteType_stalkMap [LocallyOfFiniteType f] :
    letI := algebraStalkMap f x
    Algebra.EssFiniteType ↥(S.presheaf.stalk (f x)) ↥(X.sheaf.presheaf.stalk x) :=
  LocallyOfFiniteType.stalkMap f x

/-- **The stalk of the sheaf of relative differentials is a finite module over the local ring of
the source.** This is Stacks Tag 01V2 read at a point. -/
@[ega "IV 17.4.1.2" "partial"]
public theorem finite_relativeDifferentialStalk [LocallyOfFiniteType f] :
    letI := relativeDifferentialStalkModule f x
    Module.Finite ↥(X.presheaf.stalk x) (relativeDifferentialStalk f x) := by
  classical
  let := algebraStalkMap f x
  have := essFiniteType_stalkMap f x
  exact (Module.Finite.equiv (relativeDifferentialsStalkKaehlerEquiv f x).symm :
    Module.Finite (ToType (X.sheaf.presheaf.stalk x))
      (ToType (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u})
        (Scheme.Hom.relativeDifferentials f).val.presheaf x)))

/-- **Condition (4) of Tag 01V9 implies condition (3).** If the residue-field fibre of the stalk
of the sheaf of relative differentials is generated over `κ(x)` by at most `dim_x` elements, then
the stalk itself is generated over `𝒪_{X,x}` by at most `dim_x` elements. -/
public theorem condition4_imp_condition3 [LocallyOfFiniteType f] (h : Condition4 f x) :
    Condition3 f x := by
  let := relativeDifferentialStalkModule f x
  let : Algebra ↥(X.presheaf.stalk x) ↥(X.residueField x) := (X.residue x).hom.toAlgebra
  have := finite_relativeDifferentialStalk f x
  exact ⟨h.1, generatedByAtMost_of_tensor_residueField h.2⟩

/-- **Conditions (3) and (4) of Tag 01V9 are equivalent**, for a morphism locally of finite
type. -/
public theorem condition3_iff_condition4 [LocallyOfFiniteType f] :
    Condition3 f x ↔ Condition4 f x :=
  ⟨condition3_imp_condition4 f x, condition4_imp_condition3 f x⟩

end Stacks.RelativeDifferentialStalkMap

end
