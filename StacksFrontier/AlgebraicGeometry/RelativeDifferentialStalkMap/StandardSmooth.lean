module

public import Mathlib.RingTheory.Etale.Kaehler
public import StacksFrontier.AlgebraicGeometry.RelativeDifferentialStalkMap.Numerical
public import StacksFrontier.AlgebraicGeometry.SmoothAtJacobian.Jacobian
public import StacksFrontier.AlgebraicGeometry.SmoothAtJacobian.StalkCriterion
public import StacksFrontier.AlgebraicGeometry.Morphisms.Syntomic.FiberDimension
public import StacksFrontier.RingTheory.Smooth.StandardSmoothProperties

/-!
# Conditions (1) and (5) of Tag 01V9 imply conditions (3) and (4)

Of the six conditions of Stacks Tag 01V9, smoothness at the point, a standard smooth affine
neighbourhood and a non-vanishing Jacobian minor are equivalent, and so are the two numerical
conditions on the relative differentials. This file proves that the first group implies the
second: if `f` is smooth at `x`, the stalk at `x` of the sheaf of relative differentials is
generated by at most as many elements as the dimension at `x` of the scheme-theoretic fibre
through `x`.

## Main results

* `Stacks.RelativeDifferentialStalkMap.generatedByAtMost_of_surjective` and
  `generatedByAtMost_of_isLocalizedModule`: a bound on the number of generators of a module
  passes to a quotient and to a localization.
* `Stacks.RelativeDifferentialStalkMap.generatedByAtMost_kaehler_of_submersivePresentation`:
  `Ω[B⁄R]` for a standard smooth `B` is generated by the variables not paired with a relation.
* `Stacks.RelativeDifferentialStalkMap.generatedByAtMost_kaehler_localization`: the same bound
  for `Ω[C⁄A']`, where `C` is a localization of `B` and `A'` is any ring between `R` and `C`.
* `Stacks.RelativeDifferentialStalkMap.fiberDimensionAt_eq_of_submersivePresentation`: the fibre
  dimension of a morphism at a point, from a submersive presentation on affine neighbourhoods.
* `Stacks.RelativeDifferentialStalkMap.condition1_imp_condition3` and `condition1_imp_condition4`.

## References

* [Stacks Project, Tag 01V9](https://stacks.math.columbia.edu/tag/01V9)
* [Stacks Project, Tag 00T7](https://stacks.math.columbia.edu/tag/00T7)
-/


@[expose] public section

open CategoryTheory Opposite
open AlgebraicGeometry
open Stacks.SmoothAtJacobian

universe u v w

namespace Stacks.RelativeDifferentialStalkMap

/-- A bound on the number of generators passes along a map taking generating sets to generating
sets. -/
private theorem generatedByAtMost_of_span_image {B : Type u} [CommRing B] {C : Type v}
    [CommRing C] {M : Type*} [AddCommGroup M] [Module B M] {N : Type*} [AddCommGroup N]
    [Module C N] {d : WithBot ℕ∞} (g : M → N)
    (hg : ∀ s : Set M, Submodule.span B s = ⊤ → Submodule.span C (g '' s) = ⊤)
    (h : GeneratedByAtMost B M d) : GeneratedByAtMost C N d := by
  classical
  obtain ⟨s, hspan, hcard⟩ := h
  exact ⟨s.image g, by simpa using hg _ hspan, le_trans (by exact_mod_cast Finset.card_image_le)
    hcard⟩

/-- A bound on the number of generators passes to the image of a surjection. -/
public theorem generatedByAtMost_of_surjective {B : Type u} [CommRing B]
    {M : Type v} [AddCommGroup M] [Module B M] {N : Type w} [AddCommGroup N] [Module B N]
    {d : WithBot ℕ∞} (g : M →ₗ[B] N) (hg : Function.Surjective g)
    (h : GeneratedByAtMost B M d) : GeneratedByAtMost B N d :=
  generatedByAtMost_of_span_image ⇑g (fun s hs ↦ by
    rw [← Submodule.map_span, hs, Submodule.map_top, LinearMap.range_eq_top.2 hg]) h

/-- A bound on the number of generators passes to a localization. -/
public theorem generatedByAtMost_of_isLocalizedModule {B : Type u} [CommRing B]
    (C : Type v) [CommRing C] [Algebra B C] (p : Submonoid B) [IsLocalization p C]
    {M : Type w} [AddCommGroup M] [Module B M] {N : Type w} [AddCommGroup N] [Module B N]
    [Module C N] [IsScalarTower B C N] {d : WithBot ℕ∞}
    (g : M →ₗ[B] N) [IsLocalizedModule p g] (h : GeneratedByAtMost B M d) :
    GeneratedByAtMost C N d :=
  generatedByAtMost_of_span_image ⇑g (fun _ hs ↦ span_eq_top_of_isLocalizedModule C p g hs) h

/-- The number of variables of a submersive presentation not paired with a relation. -/
public theorem natCard_compl_range_map {R B : Type u} [CommRing R] [CommRing B] [Algebra R B]
    {ι σ : Type} [Finite ι] [Finite σ] (P : Algebra.SubmersivePresentation R B ι σ) :
    Nat.card ((Set.range P.map)ᶜ : Set ι) = Nat.card ι - Nat.card σ := by
  classical
  have h := Nat.card_congr (Equiv.Set.sumCompl (Set.range P.map))
  rw [Nat.card_sum, Nat.card_range_of_injective P.map_inj] at h
  omega

/-- **The Kähler differentials of a standard smooth algebra are generated by the number of
variables not paired with a relation.** -/
public theorem generatedByAtMost_kaehler_of_submersivePresentation {R B : Type u} [CommRing R]
    [CommRing B] [Algebra R B] {ι σ : Type} [Finite ι] [Finite σ]
    (P : Algebra.SubmersivePresentation R B ι σ) :
    GeneratedByAtMost B Ω[B⁄R] ((Nat.card ι - Nat.card σ : ℕ) : WithBot ℕ∞) := by
  classical
  let _ : Fintype ((Set.range P.map)ᶜ : Set ι) := Fintype.ofFinite _
  refine ⟨Finset.univ.image P.basisKaehler, ?_, ?_⟩
  · rw [Finset.coe_image, Finset.coe_univ, Set.image_univ]
    exact P.basisKaehler.span_eq
  · have hc : (Finset.univ.image P.basisKaehler).card ≤ Nat.card ι - Nat.card σ := by
      refine le_trans Finset.card_image_le ?_
      rw [Finset.card_univ, ← Nat.card_eq_fintype_card]
      exact (natCard_compl_range_map P).le
    exact_mod_cast hc

/-- **A generator bound for the Kähler differentials of a localization of a standard smooth
algebra, over any intermediate base ring.** -/
public theorem generatedByAtMost_kaehler_localization
    {R B : Type u} [CommRing R] [CommRing B] [Algebra R B]
    (C : Type u) [CommRing C] [Algebra B C] [Algebra R C] [IsScalarTower R B C]
    (p : Submonoid B) [IsLocalization p C]
    (A' : Type u) [CommRing A'] [Algebra R A'] [Algebra A' C] [IsScalarTower R A' C]
    {ι σ : Type} [Finite ι] [Finite σ] (P : Algebra.SubmersivePresentation R B ι σ) :
    GeneratedByAtMost C Ω[C⁄A'] ((Nat.card ι - Nat.card σ : ℕ) : WithBot ℕ∞) := by
  have h₁ : GeneratedByAtMost C Ω[C⁄R] ((Nat.card ι - Nat.card σ : ℕ) : WithBot ℕ∞) :=
    generatedByAtMost_of_isLocalizedModule C p (KaehlerDifferential.map R R B C)
      (generatedByAtMost_kaehler_of_submersivePresentation P)
  exact generatedByAtMost_of_surjective (KaehlerDifferential.map R A' C C)
    (KaehlerDifferential.map_surjective R A' C) h₁

variable {X S : Scheme.{u}} (f : X ⟶ S) (x : X)

/-- **The dimension of the fibre of `f` through `x`, read off a submersive presentation on
affine neighbourhoods.** -/
public theorem fiberDimensionAt_eq_of_submersivePresentation
    (U : X.affineOpens) (V : S.affineOpens) (hxU : x ∈ U.1) (hUV : U.1 ≤ f ⁻¹ᵁ V.1)
    [Algebra Γ(S, V.1) Γ(X, U.1)]
    (halg : algebraMap Γ(S, V.1) Γ(X, U.1) = (f.appLE V.1 U.1 hUV).hom)
    {ι σ : Type} [Finite ι] [Finite σ]
    (P : Algebra.SubmersivePresentation Γ(S, V.1) Γ(X, U.1) ι σ) :
    topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x)
      = ((Nat.card ι - Nat.card σ : ℕ) : WithBot ℕ∞) := by
  have : P.toPresentation.IsRelativeGlobalCompleteIntersection :=
    P.isRelativeGlobalCompleteIntersection
  have key := AlgebraicGeometry.fiberDimensionAt_eq_card_sub_card P.toPresentation
    (U.2.primeIdealOf ⟨x, hxU⟩)
  have hmap : CommRingCat.ofHom (algebraMap Γ(S, V.1) Γ(X, U.1)) = f.appLE V.1 U.1 hUV := by
    rw [halg, CommRingCat.ofHom_hom]
  dsimp only at key
  rw [hmap] at key
  have hsq : U.2.fromSpec ≫ f = Spec.map (f.appLE V.1 U.1 hUV) ≫ V.2.fromSpec :=
    (IsAffineOpen.SpecMap_appLE_fromSpec f V.2 U.2 hUV).symm
  have _ : IsOpenImmersion U.2.fromSpec := U.2.isOpenImmersion_fromSpec
  have _ : IsOpenImmersion V.2.fromSpec := V.2.isOpenImmersion_fromSpec
  have hopen := AlgebraicGeometry.fiberDimensionAt_eq_of_open_square
    U.2.fromSpec f (Spec.map (f.appLE V.1 U.1 hUV)) V.2.fromSpec hsq
    (U.2.primeIdealOf ⟨x, hxU⟩)
  rw [U.2.fromSpec_primeIdealOf ⟨x, hxU⟩] at hopen
  exact hopen.symm.trans key

/-- The germ at `x` of a section over an affine neighbourhood, pulled back along `f`, is the
stalk map applied to the germ of the section at `f x`. -/
public theorem appLE_germ_eq_germ_stalkMap
    (U : X.Opens) (V : S.Opens) (hxU : x ∈ U) (hUV : U ≤ f ⁻¹ᵁ V) :
    f.appLE V U hUV ≫ X.presheaf.germ U x hxU
      = S.presheaf.germ V (f x) (hUV hxU) ≫ f.stalkMap x := by
  rw [Scheme.Hom.germ_stalkMap f V x (hUV hxU), Scheme.Hom.appLE, Category.assoc,
    X.presheaf.germ_res]

/-- **Condition (1) of Tag 01V9 implies condition (3).**  If `f` is smooth at `x` then the
induced map of local rings is flat and the stalk at `x` of the sheaf of relative differentials is
generated over `𝒪_{X,x}` by at most `dim_x` elements, `dim_x` being the dimension at `x` of the
scheme-theoretic fibre through `x`. No finiteness hypothesis on `f` is assumed. -/
public theorem condition1_imp_condition3 (h : Condition1 f x) : Condition3 f x := by
  classical
  refine ⟨condition1_imp_flat_stalkMap f x h, ?_⟩
  obtain ⟨U, V, hxU, hUV, hs⟩ := (condition1_iff_condition5 f x).1 h
  let _ : Algebra Γ(S, V.1) Γ(X, U.1) := (f.appLE V.1 U.1 hUV).hom.toAlgebra
  have halg : algebraMap Γ(S, V.1) Γ(X, U.1) = (f.appLE V.1 U.1 hUV).hom :=
    RingHom.algebraMap_toAlgebra _
  have hstd : (f.appLE V.1 U.1 hUV).hom.IsStandardSmooth :=
    (RingHom.isStandardSmooth_respectsIso.arrow_mk_iso_iff
      (arrowResLEAppIso f V.1 U.1 hUV)).mp hs
  obtain ⟨ι, σ, hσ, hι, ⟨P⟩⟩ := hstd.out
  rw [fiberDimensionAt_eq_of_submersivePresentation f x U V hxU hUV halg P]
  let _ : Algebra Γ(X, U.1) ↥(X.presheaf.stalk x) :=
    X.presheaf.algebra_section_stalk (U := U.1) ⟨x, hxU⟩
  have _ : IsLocalization (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl
      ↥(X.presheaf.stalk x) := U.2.isLocalization_stalk ⟨x, hxU⟩
  let _ : Algebra Γ(S, V.1) ↥(X.presheaf.stalk x) :=
    (f.appLE V.1 U.1 hUV ≫ X.presheaf.germ U.1 x hxU).hom.toAlgebra
  let _ : Algebra Γ(S, V.1) ↥(S.presheaf.stalk (f x)) :=
    S.presheaf.algebra_section_stalk (U := V.1) ⟨f x, hUV hxU⟩
  let _ : Algebra ↥(S.presheaf.stalk (f x)) ↥(X.presheaf.stalk x) :=
    (f.stalkMap x).hom.toAlgebra
  have _ : IsScalarTower Γ(S, V.1) Γ(X, U.1) ↥(X.presheaf.stalk x) := by
    refine IsScalarTower.of_algebraMap_eq' ?_
    simp only [RingHom.algebraMap_toAlgebra]
    exact CommRingCat.hom_comp _ _
  have _ : IsScalarTower Γ(S, V.1) ↥(S.presheaf.stalk (f x)) ↥(X.presheaf.stalk x) := by
    refine IsScalarTower.of_algebraMap_eq' ?_
    simp only [RingHom.algebraMap_toAlgebra]
    rw [← CommRingCat.hom_comp]
    exact congrArg CommRingCat.Hom.hom (appLE_germ_eq_germ_stalkMap f x U.1 V.1 hxU hUV)
  have hgen := generatedByAtMost_kaehler_localization
    (R := Γ(S, V.1)) (B := Γ(X, U.1)) ↥(X.presheaf.stalk x)
    (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal.primeCompl ↥(S.presheaf.stalk (f x)) P
  let _ := relativeDifferentialStalkModule f x
  exact (generatedByAtMost_of_surjective
      (relativeDifferentialsStalkKaehlerEquiv f x).symm.toLinearMap
      (relativeDifferentialsStalkKaehlerEquiv f x).symm.surjective hgen :
    GeneratedByAtMost (ToType (X.sheaf.presheaf.stalk x))
      (ToType (TopCat.Presheaf.stalk (C := AddCommGrpCat.{u})
        (Scheme.Hom.relativeDifferentials f).val.presheaf x)) _)

/-- **Condition (1) of Tag 01V9 implies condition (4).** -/
public theorem condition1_imp_condition4 (h : Condition1 f x) : Condition4 f x :=
  condition3_imp_condition4 f x (condition1_imp_condition3 f x h)

end Stacks.RelativeDifferentialStalkMap

end
