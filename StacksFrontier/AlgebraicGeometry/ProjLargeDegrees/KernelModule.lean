module

public import StacksFrontier.AlgebraicGeometry.ProjLargeDegrees.ClearDenominators
public import StacksFrontier.AlgebraicGeometry.ProjLargeDegrees.GradedCoefficients
public import StacksFrontier.AlgebraicGeometry.ProjSaturation.Basic

/-!
# The kernel of `M_n ⟶ Γ(Proj 𝒮, M(n)~)` is `𝒮₊`-power torsion, and finitely generated

Let `S = ⨁_{d ≥ 0} 𝒮 d` be a graded ring generated in degree one over `𝒮 0`, Noetherian, and let
`M = ⨁_{n ∈ ℤ} 𝒨 n` be a finite graded `S`-module. This file discharges the *kernel* half of the
homogeneous generating data that
`Stacks.AlgebraicGeometry.ProjLargeDegreeSections.exists_bijective_degreeNToGlobalSections`
— [Stacks, Tag 0AG7] — asks for, for an arbitrary finite graded module.

The two statements are the ones
`StacksFrontier/AlgebraicGeometry/ProjLargeDegreeSections/KernelData.lean` proves for the *regular*
module `M = S`, here for an arbitrary `M`:

* a homogeneous element whose canonical global section of Equation 01MR vanishes is annihilated by
  a power of each homogeneous element of positive degree, hence by a power of the irrelevant
  ideal;
* finitely many homogeneous elements of the kernel generate all of them, because `M` is a
  Noetherian module.

## Main definitions

* `Stacks.AlgebraicGeometry.ProjLargeDegrees.homogeneousVanishing`: the homogeneous elements of
  `M` whose canonical global section vanishes.

## Main results

* `Stacks.AlgebraicGeometry.ProjLargeDegrees`
  `.exists_pow_smul_eq_zero_of_degreeNToGlobalSections_eq_zero`: a vanishing section means a power
  of each positive-degree homogeneous element kills the element.
* `Stacks.AlgebraicGeometry.ProjLargeDegrees.exists_irrelevant_pow_smul_eq_zero`: the same in the
  `𝒮₊`-power torsion form the source uses.
* `Stacks.AlgebraicGeometry.ProjLargeDegrees.exists_homogeneous_generators`: finitely many
  homogeneous elements of the kernel generate every homogeneous element of it.
* `Stacks.AlgebraicGeometry.ProjLargeDegrees.exists_kernel_data`: **the kernel half of Tag 0AG7's
  hypotheses**, in the exact shape `exists_bijective_degreeNToGlobalSections` consumes.

## Implementation notes

The vanishing criterion is the module version of
`AlgebraicGeometry.ProjectiveSpectrum.Proj.exists_pow_mul_eq_zero_of_degreeSection_eq_zero`,
deduced from
`Stacks.AlgebraicGeometry.ProjLargeDegrees.exists_pow_smul_eq_zero_of_forall_mk_eq_zero`:
the canonical section has value `m / 1` at every point, so if it is zero then `m` dies in every
localized fiber.

The passage from "finitely generated submodule" to "finitely many *homogeneous* generators" is
the one of `StacksFrontier/AlgebraicGeometry/ProjLargeDegreeSections/KernelData.lean`, and does not
go through homogeneity of the kernel submodule: the submodule generated by the homogeneous vanishing
elements is finitely generated, each of its finitely many generators lies in the span of a finite
subset of the vanishing set, and the union of those subsets is the homogeneous generating family.

## References

* [Stacks Project, Tag 0AG7](https://stacks.math.columbia.edu/tag/0AG7)
* [Stacks Project, Tag 01MR](https://stacks.math.columbia.edu/tag/01MR)
* [Stacks Project, Tag 0BXD](https://stacks.math.columbia.edu/tag/0BXD)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace DirectSum
open AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.AlgebraicGeometry.ProjShiftedSections
  (shiftedSectionsComponent degreeNToGlobalSections homogeneousScalarGlobalSections)
open Stacks.GradedModule (shiftedGrading)
open scoped Stacks.GradedLocalization

namespace Stacks.AlgebraicGeometry.ProjLargeDegrees

universe u v w t

attribute [local instance] ProjectiveSpectrum.isPrime
attribute [local instance_reducible] ProjectiveSpectrum.top
attribute [local implicit_reducible] TopCat.Sheaf sheafCompose

variable {S : Type u} {M : Type v} {σ : Type w} {τ : Type t}
  [CommRing S] [AddCommGroup M] [Module S M]
  [SetLike σ S] [AddSubgroupClass σ S] (𝒮 : ℕ → σ) [GradedRing 𝒮]
  [SetLike τ M] [AddSubgroupClass τ M] (𝒨 : ℤ → τ) [DirectSum.Decomposition 𝒨]
  [SetLike.GradedSMul 𝒮 𝒨]

/-- **A vanishing canonical section means a power of every positive-degree homogeneous element
kills the element.** The section attached to `m` has value `m / 1` at every point, so if it
vanishes then `m` dies in every localized fiber over `D₊(g)`. -/
theorem exists_pow_smul_eq_zero_of_degreeNToGlobalSections_eq_zero
    {g : S} {c : ℕ} (hg : g ∈ 𝒮 c) (hc : 0 < c) {n : ℤ} (m : 𝒨 n)
    (hm : degreeNToGlobalSections 𝒮 𝒨 n m = 0) :
    ∃ N : ℕ, g ^ N • (m : M) = 0 := by
  refine exists_pow_smul_eq_zero_of_forall_mk_eq_zero 𝒮 𝒨 hg hc (m : M) m.2 fun y _ => ?_
  rw [← sectionValue_degreeNToGlobalSections 𝒮 𝒨 n m y, hm]
  exact sectionValue_zero 𝒮 𝒨 n y

/-- **In a Noetherian graded ring generated in degree one, a vanishing canonical section means
that a power of the irrelevant ideal annihilates the element.** The degree-one elements generate
the irrelevant ideal, a power of each of them kills `m`, so the irrelevant ideal lies in the
radical of the annihilator of `m`; that annihilator is an ideal of a Noetherian ring, so a power
of the irrelevant ideal is already contained in it. -/
theorem exists_irrelevant_pow_smul_eq_zero [IsNoetherianRing S]
    (hgen : Algebra.adjoin (𝒮 0) (𝒮 1 : Set S) = ⊤)
    {n : ℤ} (m : 𝒨 n) (hm : degreeNToGlobalSections 𝒮 𝒨 n m = 0) :
    ∃ N : ℕ, ∀ a ∈ (HomogeneousIdeal.irrelevant 𝒮).toIdeal ^ N, a • (m : M) = 0 := by
  classical
  obtain ⟨t, ht1, hspan⟩ := exists_finset_degreeOne_span_irrelevant 𝒮 hgen
  have hrad : (HomogeneousIdeal.irrelevant 𝒮).toIdeal ≤
      (Submodule.span S ({(m : M)} : Set M)).annihilator.radical := by
    rw [← hspan, Ideal.span_le]
    intro f hf
    obtain ⟨N, hN⟩ := exists_pow_smul_eq_zero_of_degreeNToGlobalSections_eq_zero 𝒮 𝒨
      (ht1 f hf) Nat.one_pos m hm
    rw [SetLike.mem_coe, Ideal.mem_radical_iff]
    exact ⟨N, (Submodule.mem_annihilator_span_singleton (m : M) (f ^ N)).mpr hN⟩
  obtain ⟨N, hN⟩ :=
    Ideal.exists_pow_le_of_le_radical_of_fg hrad (Ideal.fg_of_isNoetherianRing _)
  exact ⟨N, fun a ha => (Submodule.mem_annihilator_span_singleton (m : M) a).mp (hN ha)⟩

/-- **The homogeneous part of the kernel of `M ⟶ ⨁_{n ∈ ℤ} Γ(Proj 𝒮, M(n)~)`**: the homogeneous
elements whose canonical global section of Equation 01MR vanishes. -/
def homogeneousVanishing : Set M :=
  {x | ∃ (n : ℤ) (hx : x ∈ 𝒨 n), degreeNToGlobalSections 𝒮 𝒨 n ⟨x, hx⟩ = 0}

omit [DirectSum.Decomposition 𝒨] in
/-- **Finitely many homogeneous elements of the kernel generate all of them.** The submodule they
generate is finitely generated because `M` is a Noetherian module, each of its generators lies in
the span of a finite subset of the homogeneous vanishing elements, and the union of those finite
subsets is the family. -/
theorem exists_homogeneous_generators [IsNoetherianRing S] [Module.Finite S M] :
    ∃ (r : ℕ) (x : Fin r → M) (d : Fin r → ℤ) (hx : ∀ j, x j ∈ 𝒨 (d j)),
      (∀ j, degreeNToGlobalSections 𝒮 𝒨 (d j) ⟨x j, hx j⟩ = 0) ∧
        homogeneousVanishing 𝒮 𝒨 ⊆ Submodule.span S (Set.range x) := by
  classical
  have : IsNoetherian S M := inferInstance
  obtain ⟨t, ht⟩ : (Submodule.span S (homogeneousVanishing 𝒮 𝒨)).FG :=
    IsNoetherian.noetherian _
  have key : ∀ a : M, ∃ T : Finset M, (↑T : Set M) ⊆ homogeneousVanishing 𝒮 𝒨 ∧
      (a ∈ Submodule.span S (homogeneousVanishing 𝒮 𝒨) →
        a ∈ Submodule.span S (↑T : Set M)) := by
    intro a
    by_cases ha : a ∈ Submodule.span S (homogeneousVanishing 𝒮 𝒨)
    · obtain ⟨T, hTsub, hTmem⟩ := Submodule.mem_span_finite_of_mem_span ha
      exact ⟨T, hTsub, fun _ => hTmem⟩
    · exact ⟨∅, by simp, fun h => absurd h ha⟩
  choose T hT1 hT2 using key
  set U : Finset M := t.biUnion T with hU
  have hUsub : (↑U : Set M) ⊆ homogeneousVanishing 𝒮 𝒨 := by
    intro a ha
    simp only [hU, Finset.coe_biUnion, Set.mem_iUnion] at ha
    obtain ⟨b, -, hab⟩ := ha
    exact hT1 b hab
  have hsubU : ∀ a ∈ t, (↑(T a) : Set M) ⊆ (↑U : Set M) := by
    intro a hat z hz
    simp only [hU, Finset.coe_biUnion, Set.mem_iUnion]
    exact ⟨a, hat, hz⟩
  have hspanU : Submodule.span S (homogeneousVanishing 𝒮 𝒨) ≤
      Submodule.span S (↑U : Set M) := by
    rw [← ht, Submodule.span_le]
    intro a hat
    refine Submodule.span_mono (hsubU a hat) (hT2 a ?_)
    rw [← ht]
    exact Submodule.subset_span hat
  refine ⟨Fintype.card (↥U), fun j => (((Fintype.equivFin (↥U)).symm j : ↥U) : M), ?_⟩
  have hmemU : ∀ j : Fin (Fintype.card (↥U)),
      (((Fintype.equivFin (↥U)).symm j : ↥U) : M) ∈ homogeneousVanishing 𝒮 𝒨 :=
    fun j => hUsub ((Fintype.equivFin (↥U)).symm j).2
  choose d hd hd0 using hmemU
  refine ⟨d, hd, hd0, ?_⟩
  have hrange :
      (↑U : Set M) ⊆ Set.range fun j => (((Fintype.equivFin (↥U)).symm j : ↥U) : M) := by
    intro a ha
    exact ⟨Fintype.equivFin (↥U) ⟨a, ha⟩, by simp⟩
  intro b hb
  exact Submodule.span_mono hrange (hspanU (Submodule.subset_span hb))

/-- **The kernel half of the hypotheses of [Stacks, Tag 0AG7].** For `S` Noetherian and generated
in degree one over `𝒮 0`, and `M` a finite graded `S`-module, there are finitely many homogeneous
elements `x j` of degrees `dx j`, each annihilated by a power of the irrelevant ideal, which
generate the kernel of the comparison degreewise with homogeneous coefficients of the
complementary degrees.

This is the data `hxtors`, `hxgen` of
`Stacks.AlgebraicGeometry.ProjLargeDegreeSections.exists_bijective_degreeNToGlobalSections`. -/
theorem exists_kernel_data [IsNoetherianRing S] [Module.Finite S M]
    (hgen : Algebra.adjoin (𝒮 0) (𝒮 1 : Set S) = ⊤) :
    ∃ (ck : ℕ) (x : Fin ck → M) (dx : Fin ck → ℤ) (Nx : Fin ck → ℕ),
      (∀ j, ∀ a ∈ (HomogeneousIdeal.irrelevant 𝒮).toIdeal ^ Nx j, a • x j = 0) ∧
        ∀ n : ℤ, (∀ j, dx j ≤ n) → ∀ m : 𝒨 n,
          degreeNToGlobalSections 𝒮 𝒨 n m = 0 →
            ∃ a : (j : Fin ck) → 𝒮 (n - dx j).toNat, (m : M) = ∑ j, (a j : S) • x j := by
  classical
  obtain ⟨r, x, d, hx, hx0, hspan⟩ := exists_homogeneous_generators 𝒮 𝒨
  choose Nx hNx using fun j : Fin r =>
    exists_irrelevant_pow_smul_eq_zero 𝒮 𝒨 hgen ⟨x j, hx j⟩ (hx0 j)
  refine ⟨r, x, d, Nx, fun j a ha => hNx j a ha, fun n hn m hm => ?_⟩
  refine exists_homogeneous_smul_coeffs 𝒮 𝒨 x d (fun j => (n - d j).toNat) hx
    (fun j => by have := hn j; omega) m.2 (hspan ⟨n, m.2, ?_⟩)
  exact hm

end Stacks.AlgebraicGeometry.ProjLargeDegrees

end
