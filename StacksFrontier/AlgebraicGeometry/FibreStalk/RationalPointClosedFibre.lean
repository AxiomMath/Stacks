module

public import StacksFrontier.AlgebraicGeometry.DerivedVarieties.NoDeformations.ConstantFamilyDescent
public import StacksFrontier.AlgebraicGeometry.Groupoids.More.LocalStructure.StalkConormal
public import StacksFrontier.AlgebraicGeometry.Morphisms.CohenMacaulay.FibreStalk
public import StacksFrontier.AlgebraicGeometry.Morphisms.Fibres.Basic
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The local ring of a fibre at an arbitrary fibre point, and at a rational point of the base

Let `h : W ⟶ S` be a morphism of schemes and `x` a point of `S`. The local ring of the
scheme-theoretic fibre `h.fiber x` at a point `z` of it is the quotient of the local ring of `W`
at `h.fiberι x z` by the ideal generated by the image of the maximal ideal of the local ring of
`S` at `x`.

When `x` comes from a `k`-rational point of `S`, that is from a section `s : Spec k ⟶ S` of a
structure morphism `q : S ⟶ Spec k`, the fibre `h.fiber x` is moreover the pullback of `h` along
`s` itself, so the same description computes the local rings of `CategoryTheory.Limits.pullback
h s`.

## Main results

* `AlgebraicGeometry.exists_ringEquiv_quotient_stalk_fiberι` and
  `AlgebraicGeometry.exists_ringEquiv_quotient_stalk_fiber`: the local ring of `h.fiber x` at an
  arbitrary point `z` of the fibre is the fibre quotient of the local ring of `W` at
  `h.fiberι x z`, compatibly with the stalk map of `h.fiberι x`. The two differ only in how the
  local ring of `S` is written: at `h (h.fiberι x z)` in the first, at `x` in the second.
* `AlgebraicGeometry.exists_iso_fiber_pullback_of_fac` and
  `AlgebraicGeometry.exists_iso_fiber_pullback_of_isSection`: the fibre of `h` at the point a
  `k`-rational point `s` of `S` picks out is isomorphic over `W` to the pullback of `h` along
  `s`.
* `AlgebraicGeometry.exists_ringEquiv_quotient_stalk_pullback_fst_of_isSection` and
  `AlgebraicGeometry.exists_ringEquiv_quotient_stalk_pullback_of_isSection`: the two combined,
  the local ring of `CategoryTheory.Limits.pullback h s` at a point as a fibre quotient of a
  local ring of `W`. The two differ only in how the local ring of `S` is written: at the image
  of the point in the first, at the point `s` picks out in the second.
* `AlgebraicGeometry.exists_ringEquiv_quotient_stalk_of_iso`: the transport of such a
  presentation along an isomorphism of schemes over `W`.

## Implementation notes

The ring-theoretic content is
`AlgebraicGeometry.quotientStalk_bridge`, which supplies the fibre quotient at the point
`h.asFiber w` of `h.fiber (h w)` determined by a point `w` of `W`. Every point `z` of
`h.fiber x` is such a point, for `w = h.fiberι x z`, but only after the schemes `h.fiber x` and
`h.fiber (h w)` are identified; the passage is therefore a transport along an isomorphism of
schemes over `W`, which is `exists_ringEquiv_quotient_stalk_of_iso` here. The same transport
carries the description from the fibre to the pullback along `s`, so the two statements about
arbitrary points are instances of one lemma.

The identification of `h.fiber x` with the pullback along `s` rests on
`AlgebraicGeometry.exists_isIso_residueField_hom_of_isSection`, which factors `s` as
`Spec.map ψ ≫ S.fromSpecResidueField x` with `ψ` an isomorphism. Base change along an
isomorphism is pasted onto the fibre square with
`CategoryTheory.IsPullback.paste_horiz`, the left-hand square being a pullback because both of
its horizontal maps are isomorphisms; this keeps the comparison in the form
`CategoryTheory.IsPullback.isoPullback`, whose compatibility with the first projection is
already a `simp` lemma and is exactly the assertion of being an isomorphism over `W`.

The local ring of `S` is written at `x` using
`AlgebraicGeometry.Scheme.Hom.stalkMapAt`, which is the stalk map composed with the transport
along the equality of points; the resulting extended ideal is the same as the one at the
tautological image point, which is `ideal_map_stalkMapAt`.

## References

* [Stacks Project, Tag 0G0R](https://stacks.math.columbia.edu/tag/0G0R)
* [Stacks Project, Tag 0C0X](https://stacks.math.columbia.edu/tag/0C0X)
-/

@[expose] public noncomputable section

open CategoryTheory Limits AlgebraicGeometry

universe u

namespace AlgebraicGeometry

/-- Transporting the fibre of `h` along an equality of points of the base is compatible with
the inclusions of the two fibres into `W`. -/
private lemma eqToHom_fiber_comp_fiberι {W S : Scheme.{u}} (h : W ⟶ S) {x y : S} (hxy : x = y) :
    (eqToIso (congrArg h.fiber hxy)).hom ≫ h.fiberι y = h.fiberι x := by
  subst hxy; simp

/-- The maximal ideal of the local ring of `Y` at a prescribed image point `y` of `f x` extends
to the same ideal of the local ring of `X` at `x` as the maximal ideal at `f x` itself. -/
private lemma ideal_map_stalkMapAt {X Y : Scheme.{u}} (f : X ⟶ Y) (x : X) (y : Y)
    (hy : f x = y) :
    Ideal.map (f.stalkMapAt x y hy) (IsLocalRing.maximalIdeal (Y.presheaf.stalk y)) =
      Ideal.map (f.stalkMap x).hom
        (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f x))) := by
  subst hy
  simp [Scheme.Hom.stalkMapAt]

/-- **Transport of a fibre-quotient presentation along an isomorphism over `W`.** If the local
ring of `T'` at `p'` is the quotient of the local ring of `W` at the image of `p'` by the ideal
generated by the maximal ideal of `S`, compatibly with the stalk map of `ι`, then the same holds
for a scheme `T` isomorphic to `T'` over `W` at any point carried to `p'`. -/
theorem exists_ringEquiv_quotient_stalk_of_iso {W S T T' : Scheme.{u}} (h : W ⟶ S)
    (e : T ≅ T') (ι : T' ⟶ W) (κ : T ⟶ W) (hκ : e.hom ≫ ι = κ) (p : T) (p' : T')
    (hp : e.hom p = p')
    (H : ∃ E : (W.presheaf.stalk (ι p') ⧸
          Ideal.map (h.stalkMap (ι p')).hom
            (IsLocalRing.maximalIdeal (S.presheaf.stalk (h (ι p'))))) ≃+*
          T'.presheaf.stalk p',
        ∀ b, E (Ideal.Quotient.mk _ b) = (ι.stalkMap p').hom b) :
    ∃ E : (W.presheaf.stalk (κ p) ⧸
          Ideal.map (h.stalkMap (κ p)).hom
            (IsLocalRing.maximalIdeal (S.presheaf.stalk (h (κ p))))) ≃+*
          T.presheaf.stalk p,
      ∀ b, E (Ideal.Quotient.mk _ b) = (κ.stalkMap p).hom b := by
  subst hp
  subst hκ
  obtain ⟨E, hE⟩ := H
  have : IsIso (e.hom.stalkMap p) := ((isIso_iff_isIso_stalkMap e.hom).mp inferInstance).2 p
  refine ⟨E.trans (asIso (e.hom.stalkMap p)).commRingCatIsoToRingEquiv, fun b => ?_⟩
  rw [Scheme.Hom.stalkMap_comp]
  show (e.hom.stalkMap p).hom (E (Ideal.Quotient.mk _ b)) = _
  rw [hE b]
  rfl

/-- **The local ring of a scheme-theoretic fibre at an arbitrary point of the fibre.** For
`h : W ⟶ S` and a point `z` of the fibre of `h` at `x`, the local ring of the fibre at `z` is
the quotient of the local ring of `W` at `h.fiberι x z` by the ideal generated by the image of
the maximal ideal of the local ring of `S`, compatibly with the stalk map of the inclusion of
the fibre. -/
@[ega "IV 5.5.2" "partial"]
theorem exists_ringEquiv_quotient_stalk_fiberι {W S : Scheme.{u}} (h : W ⟶ S) (x : S)
    (z : h.fiber x) :
    ∃ E : (W.presheaf.stalk (h.fiberι x z) ⧸
          Ideal.map (h.stalkMap (h.fiberι x z)).hom
            (IsLocalRing.maximalIdeal (S.presheaf.stalk (h (h.fiberι x z))))) ≃+*
          (h.fiber x).presheaf.stalk z,
      ∀ b, E (Ideal.Quotient.mk _ b) = ((h.fiberι x).stalkMap z).hom b := by
  have hw : h (h.fiberι x z) = x := h.apply_fiberι x z
  refine exists_ringEquiv_quotient_stalk_of_iso h (eqToIso (congrArg h.fiber hw.symm))
    (h.fiberι (h (h.fiberι x z))) (h.fiberι x) (eqToHom_fiber_comp_fiberι h hw.symm) z
    (h.asFiber (h.fiberι x z)) ?_ (quotientStalk_bridge h (h.fiberι x z))
  apply (h.fiberι (h (h.fiberι x z))).isEmbedding.injective
  rw [Scheme.Hom.fiberι_asFiber, ← Scheme.Hom.comp_apply, eqToHom_fiber_comp_fiberι h hw.symm]

/-- **The closed fibre of the stalk is the stalk of the fibre.** For `h : W ⟶ S`, a point `x` of
`S` and a point `z` of the fibre of `h` at `x`, the local ring of the fibre at `z` is the
quotient of the local ring of `W` at `h.fiberι x z` by the ideal generated by the image of the
maximal ideal of the local ring of `S` at `x`. -/
theorem exists_ringEquiv_quotient_stalk_fiber {W S : Scheme.{u}} (h : W ⟶ S) (x : S)
    (z : h.fiber x) :
    ∃ E : (W.presheaf.stalk (h.fiberι x z) ⧸
          Ideal.map (h.stalkMapAt (h.fiberι x z) x (h.apply_fiberι x z))
            (IsLocalRing.maximalIdeal (S.presheaf.stalk x))) ≃+*
          (h.fiber x).presheaf.stalk z,
      ∀ b, E (Ideal.Quotient.mk _ b) = ((h.fiberι x).stalkMap z).hom b := by
  rw [ideal_map_stalkMapAt]
  exact exists_ringEquiv_quotient_stalk_fiberι h x z

/-- **A point of the base presented through its residue field cuts out the fibre.** If a
morphism `s : T ⟶ S` factors through `S.fromSpecResidueField x` by an isomorphism, then the
pullback of `h` along `s` is the scheme-theoretic fibre of `h` at `x`, isomorphically over
`W`. -/
theorem exists_iso_fiber_pullback_of_fac {W S T : Scheme.{u}} (h : W ⟶ S) (x : S)
    {i : T ⟶ Spec (S.residueField x)} [IsIso i] {s : T ⟶ S}
    (hfac : i ≫ S.fromSpecResidueField x = s) :
    ∃ e : h.fiber x ≅ pullback h s, e.hom ≫ pullback.fst h s = h.fiberι x := by
  have h₁ : IsPullback (𝟙 (pullback h (S.fromSpecResidueField x)))
      (pullback.snd h (S.fromSpecResidueField x) ≫ inv i)
      (pullback.snd h (S.fromSpecResidueField x)) i := IsPullback.of_horiz_isIso ⟨by simp⟩
  have h₂ := h₁.paste_horiz (IsPullback.of_hasPullback h (S.fromSpecResidueField x))
  rw [Category.id_comp, hfac] at h₂
  exact ⟨h₂.isoPullback, h₂.isoPullback_hom_fst⟩

/-- **The fibre at a `k`-rational point is the pullback along the point.** For `h : W ⟶ S` and a
section `s` of a structure morphism `q : S ⟶ Spec k`, the pullback of `h` along `s` is the
scheme-theoretic fibre of `h` at the point `s` picks out, isomorphically over `W`. -/
theorem exists_iso_fiber_pullback_of_isSection {k : Type u} [Field k] {W S : Scheme.{u}}
    (h : W ⟶ S) {q : S ⟶ Spec (.of k)} {s : Spec (.of k) ⟶ S} (hs : s ≫ q = 𝟙 _) :
    ∃ e : h.fiber (s.base (IsLocalRing.closedPoint k)) ≅ pullback h s,
      e.hom ≫ pullback.fst h s = h.fiberι (s.base (IsLocalRing.closedPoint k)) := by
  obtain ⟨ψ, hψ, hfac⟩ := exists_isIso_residueField_hom_of_isSection hs
  have := hψ
  have : IsIso (Spec.map ψ) := inferInstance
  exact exists_iso_fiber_pullback_of_fac h _ hfac

/-- A point of the pullback of `h : W ⟶ S` along a `k`-point `s` of `S` lies over the point of
`S` that `s` picks out. -/
theorem apply_pullback_fst_of_point {k : Type u} [Field k] {W S : Scheme.{u}} (h : W ⟶ S)
    (s : Spec (.of k) ⟶ S) (p : ↥(pullback h s)) :
    h (pullback.fst h s p) = s.base (IsLocalRing.closedPoint k) := by
  have hp : pullback.snd h s p = IsLocalRing.closedPoint k :=
    Subsingleton.elim (α := PrimeSpectrum _) _ _
  rw [← Scheme.Hom.comp_apply, pullback.condition, Scheme.Hom.comp_apply, hp]

/-- **The closed fibre of the stalk at a rational point of the base.** For `h : W ⟶ S` and a
`k`-rational point `s` of `S`, that is a section of a structure morphism `q : S ⟶ Spec k`, the
local ring of the pullback of `h` along `s` at a point `p` is the quotient of the local ring of
`W` at the image of `p` by the ideal generated by the image of the maximal ideal of the local
ring of `S` at the image of that point, written tautologically. -/
theorem exists_ringEquiv_quotient_stalk_pullback_fst_of_isSection {k : Type u} [Field k]
    {W S : Scheme.{u}} (h : W ⟶ S) {q : S ⟶ Spec (.of k)} {s : Spec (.of k) ⟶ S}
    (hs : s ≫ q = 𝟙 _) (p : ↥(pullback h s)) :
    ∃ E : (W.presheaf.stalk (pullback.fst h s p) ⧸
          Ideal.map (h.stalkMap (pullback.fst h s p)).hom
            (IsLocalRing.maximalIdeal (S.presheaf.stalk (h (pullback.fst h s p))))) ≃+*
          (pullback h s).presheaf.stalk p,
      ∀ b, E (Ideal.Quotient.mk _ b) = ((pullback.fst h s).stalkMap p).hom b := by
  obtain ⟨e, he⟩ := exists_iso_fiber_pullback_of_isSection h hs
  refine exists_ringEquiv_quotient_stalk_of_iso h e.symm
    (h.fiberι (s.base (IsLocalRing.closedPoint k))) _ ?_ p _ rfl
    (exists_ringEquiv_quotient_stalk_fiberι h _ _)
  rw [Iso.symm_hom, ← he]
  simp

/-- **The closed fibre of the stalk at a rational point of the base.** For `h : W ⟶ S` and a
`k`-rational point `s` of `S`, that is a section of a structure morphism `q : S ⟶ Spec k`, the
local ring of the pullback of `h` along `s` at a point `p` is the quotient of the local ring of
`W` at the image of `p` by the ideal generated by the image of the maximal ideal of the local
ring of `S` at the point `s` picks out. -/
theorem exists_ringEquiv_quotient_stalk_pullback_of_isSection {k : Type u} [Field k]
    {W S : Scheme.{u}} (h : W ⟶ S) {q : S ⟶ Spec (.of k)} {s : Spec (.of k) ⟶ S}
    (hs : s ≫ q = 𝟙 _) (p : ↥(pullback h s)) :
    ∃ E : (W.presheaf.stalk (pullback.fst h s p) ⧸
          Ideal.map (h.stalkMapAt (pullback.fst h s p) (s.base (IsLocalRing.closedPoint k))
              (apply_pullback_fst_of_point h s p))
            (IsLocalRing.maximalIdeal
              (S.presheaf.stalk (s.base (IsLocalRing.closedPoint k))))) ≃+*
          (pullback h s).presheaf.stalk p,
      ∀ b, E (Ideal.Quotient.mk _ b) = ((pullback.fst h s).stalkMap p).hom b := by
  rw [ideal_map_stalkMapAt]
  exact exists_ringEquiv_quotient_stalk_pullback_fst_of_isSection h hs p

end AlgebraicGeometry

end
