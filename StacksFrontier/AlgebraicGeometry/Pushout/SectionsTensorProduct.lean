module

public import Mathlib.Algebra.Category.Ring.Constructions
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.HenselianRings.EtaleLocalRingBaseChange

/-!
# The sections of an affine chart of a fibre product, as a tensor product

Let
```
Y --g--→ X
|        |
iY       iX
↓        ↓
T --f--→ S
```
be a cartesian square of schemes, let `US`, `UT`, `UX` be affine opens of `S`, `T`, `X` with `UT`
and `UX` lying over `US`, and let `UY = g⁻¹UX ⊓ iY⁻¹UT` be the chart of the fibre product they cut
out. The restriction maps make the four rings of sections a pushout square of rings,
`AlgebraicGeometry.isPushout_appLE_of_isPullback_inter`, so `Γ(Y, UY)` is the tensor
product `Γ(T, UT) ⊗_{Γ(S, US)} Γ(X, UX)`.

This file records that identification as a ring isomorphism onto an *abstract* tensor product
`D ⊗_C B`: the three rings `C`, `D`, `B` are presented by ring isomorphisms from the three rings
of sections, so that a caller who knows `Γ(T, UT)` only up to isomorphism — as one does for
`T = Spec D`, where `Γ(T, ⊤)` is `D` only through `Scheme.ΓSpecIso` — can use it without
transporting a tensor product along a change of base ring.

## Main results

* `AlgebraicGeometry.sectionsTensor_hom_ext`: **two ring maps out of such a chart agree as soon
  as they agree on the sections pulled back from the two charts it is cut out by**, the chart ring
  being generated by them.
* `AlgebraicGeometry.sectionsTensorEquiv`: **the chart of a fibre product has sections
  `D ⊗_C B`**, with `AlgebraicGeometry.sectionsTensorEquiv_appLE_right` and
  `AlgebraicGeometry.sectionsTensorEquiv_appLE_left` computing it on the two legs — on a section
  pulled back from `T` it is `d ⊗ 1`, and on a section pulled back from `X` it is `1 ⊗ b`.
* `AlgebraicGeometry.sectionsTensorEquiv_naturality`: **the identification is natural in the
  chart of `X`**: shrinking `UX` to `UX'` shrinks `UY` to `UY'`, and the two identifications
  intertwine the restriction map with `D ⊗ -` applied to the restriction map of `X`. This is what
  makes a family of such identifications, one per chart, a family of *compatible* ones.

## Implementation notes

The two leg equations determine the isomorphism, because `D ⊗_C B` is generated as a ring by the
two legs: that is `sectionsTensor_hom_ext`, proved by `TensorProduct.induction_on` after
transporting along the isomorphism, the multiplicative step being `d ⊗ b = (d ⊗ 1)(1 ⊗ b)`. The
ext lemma is stated with no reference to `C`, `D`, `B`: it is the case of the three rings of
sections themselves, with the restriction maps installed as the structure maps.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits TensorProduct

universe u

namespace AlgebraicGeometry

variable {X Y S T : Scheme.{u}} {f : T ⟶ S} {g : Y ⟶ X} {iX : X ⟶ S} {iY : Y ⟶ T}
  {US : S.Opens} {UT : T.Opens} {UX : X.Opens} {UY : Y.Opens}

/-- A chart of a fibre product cut out by a chart of `T` and a chart of `X` lies over the former.
-/
theorem chart_le_preimage_right (hUY : UY = g ⁻¹ᵁ UX ⊓ iY ⁻¹ᵁ UT) : UY ≤ iY ⁻¹ᵁ UT := by
  rw [hUY]; exact inf_le_right

/-- A chart of a fibre product cut out by a chart of `T` and a chart of `X` lies over the latter.
-/
theorem chart_le_preimage_left (hUY : UY = g ⁻¹ᵁ UX ⊓ iY ⁻¹ᵁ UT) : UY ≤ g ⁻¹ᵁ UX := by
  rw [hUY]; exact inf_le_left

section Equiv

variable (H : IsPullback g iY iX f)
  (hUST : UT ≤ f ⁻¹ᵁ US) (hUSX : UX ≤ iX ⁻¹ᵁ US) (hUY : UY = g ⁻¹ᵁ UX ⊓ iY ⁻¹ᵁ UT)
  (hUS : IsAffineOpen US) (hUT : IsAffineOpen UT) (hUX : IsAffineOpen UX)
  {C D B : Type u} [CommRing C] [CommRing D] [CommRing B] [Algebra C D] [Algebra C B]
  (eC : Γ(S, US) ≃+* C) (eD : Γ(T, UT) ≃+* D) (eB : Γ(X, UX) ≃+* B)
  (hD : ∀ x : Γ(S, US), eD ((f.appLE US UT hUST).hom x) = algebraMap C D (eC x))
  (hB : ∀ x : Γ(S, US), eB ((iX.appLE US UX hUSX).hom x) = algebraMap C B (eC x))

include H hUST hUSX hUS hUT hUX eC hD hB in
/-- The pushout square of section rings of a cartesian square of schemes, read with the three
rings `C`, `D`, `B` in place of the three rings of sections they are isomorphic to. -/
theorem isPushout_sections_of_isPullback :
    IsPushout (CommRingCat.ofHom (algebraMap C D)) (CommRingCat.ofHom (algebraMap C B))
      (CommRingCat.ofHom
        ((iY.appLE UT UY (chart_le_preimage_right hUY)).hom.comp (eD.symm : D →+* Γ(T, UT))))
      (CommRingCat.ofHom
        ((g.appLE UX UY (chart_le_preimage_left hUY)).hom.comp (eB.symm : B →+* Γ(X, UX)))) := by
  refine (isPushout_appLE_of_isPullback_inter H hUS hUX hUT hUSX hUST hUY
    (chart_le_preimage_left hUY) (chart_le_preimage_right hUY)).flip.of_iso
      eC.toCommRingCatIso eD.toCommRingCatIso eB.toCommRingCatIso (Iso.refl _)
      (CommRingCat.hom_ext (RingHom.ext hD)) (CommRingCat.hom_ext (RingHom.ext hB))
      (CommRingCat.hom_ext (RingHom.ext fun y => ?_))
      (CommRingCat.hom_ext (RingHom.ext fun x => ?_))
  · exact congrArg _ (eD.symm_apply_apply y).symm
  · exact congrArg _ (eB.symm_apply_apply x).symm

include hUY eD in
/-- **The sections of a chart of a fibre product are the tensor product of the sections of the two
charts it is cut out by.** The three rings of sections are presented as `C`, `D` and `B`, with the
two restriction maps from the base becoming the structure maps of `D` and `B` over `C`; the chart
of the fibre product then has sections `D ⊗_C B`. -/
def sectionsTensorEquiv : Γ(Y, UY) ≃+* TensorProduct C D B :=
  ((isPushout_sections_of_isPullback H hUST hUSX hUY hUS hUT hUX eC eD eB hD hB).isoIsPushout _ _
      (CommRingCat.isPushout_tensorProduct C D B)).commRingCatIsoToRingEquiv

/-- **On a section pulled back from the chart of `T`, the identification is `d ⊗ 1`.** -/
theorem sectionsTensorEquiv_appLE_right (y : Γ(T, UT)) :
    sectionsTensorEquiv H hUST hUSX hUY hUS hUT hUX eC eD eB hD hB
        ((iY.appLE UT UY (chart_le_preimage_right hUY)).hom y) =
      Algebra.TensorProduct.includeLeftRingHom (eD y) := by
  have h := IsPushout.inl_isoIsPushout_hom (CommRingCat.of D) (CommRingCat.of B)
    (isPushout_sections_of_isPullback H hUST hUSX hUY hUS hUT hUX eC eD eB hD hB)
    (CommRingCat.isPushout_tensorProduct C D B)
  have h' := congrArg (fun φ : CommRingCat.of D ⟶ CommRingCat.of (TensorProduct C D B) =>
    φ.hom (eD y)) h
  have hy : (eD.symm : D →+* Γ(T, UT)) (eD y) = y := eD.symm_apply_apply y
  simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
    Function.comp_apply, hy] at h'
  exact h'

/-- **On a section pulled back from the chart of `X`, the identification is `1 ⊗ b`.** -/
theorem sectionsTensorEquiv_appLE_left (x : Γ(X, UX)) :
    sectionsTensorEquiv H hUST hUSX hUY hUS hUT hUX eC eD eB hD hB
        ((g.appLE UX UY (chart_le_preimage_left hUY)).hom x) =
      Algebra.TensorProduct.includeRight.toRingHom (eB x) := by
  have h := IsPushout.inr_isoIsPushout_hom (CommRingCat.of D) (CommRingCat.of B)
    (isPushout_sections_of_isPullback H hUST hUSX hUY hUS hUT hUX eC eD eB hD hB)
    (CommRingCat.isPushout_tensorProduct C D B)
  have h' := congrArg (fun φ : CommRingCat.of B ⟶ CommRingCat.of (TensorProduct C D B) =>
    φ.hom (eB x)) h
  have hx : (eB.symm : B →+* Γ(X, UX)) (eB x) = x := eB.symm_apply_apply x
  simp only [CommRingCat.hom_comp, CommRingCat.hom_ofHom, RingHom.coe_comp,
    Function.comp_apply, hx] at h'
  exact h'

end Equiv

/-- **Two ring maps out of a chart of a fibre product agree as soon as they agree on the sections
pulled back from the two charts it is cut out by.** The chart ring is the tensor product of the
two chart rings over the chart ring of the base, by `sectionsTensorEquiv`, and a tensor product
is generated as a ring by the two factors. -/
theorem sectionsTensor_hom_ext (H : IsPullback g iY iX f)
    (hUST : UT ≤ f ⁻¹ᵁ US) (hUSX : UX ≤ iX ⁻¹ᵁ US) (hUY : UY = g ⁻¹ᵁ UX ⊓ iY ⁻¹ᵁ UT)
    (hUS : IsAffineOpen US) (hUT : IsAffineOpen UT) (hUX : IsAffineOpen UX)
    {R : Type*} [CommRing R] (φ ψ : Γ(Y, UY) →+* R)
    (hright : ∀ y : Γ(T, UT),
      φ ((iY.appLE UT UY (chart_le_preimage_right hUY)).hom y) =
        ψ ((iY.appLE UT UY (chart_le_preimage_right hUY)).hom y))
    (hleft : ∀ x : Γ(X, UX),
      φ ((g.appLE UX UY (chart_le_preimage_left hUY)).hom x) =
        ψ ((g.appLE UX UY (chart_le_preimage_left hUY)).hom x)) :
    φ = ψ := by
  let : Algebra Γ(S, US) Γ(T, UT) := (f.appLE US UT hUST).hom.toAlgebra
  let : Algebra Γ(S, US) Γ(X, UX) := (iX.appLE US UX hUSX).hom.toAlgebra
  have hD : ∀ x : Γ(S, US), (RingEquiv.refl Γ(T, UT)) ((f.appLE US UT hUST).hom x) =
      algebraMap Γ(S, US) Γ(T, UT) ((RingEquiv.refl Γ(S, US)) x) := fun x => by
    rw [RingHom.algebraMap_toAlgebra]; rfl
  have hB : ∀ x : Γ(S, US), (RingEquiv.refl Γ(X, UX)) ((iX.appLE US UX hUSX).hom x) =
      algebraMap Γ(S, US) Γ(X, UX) ((RingEquiv.refl Γ(S, US)) x) := fun x => by
    rw [RingHom.algebraMap_toAlgebra]; rfl
  obtain ⟨e, heright, heleft⟩ :
      ∃ e : Γ(Y, UY) ≃+* TensorProduct Γ(S, US) Γ(T, UT) Γ(X, UX),
        (∀ d : Γ(T, UT), e ((iY.appLE UT UY (chart_le_preimage_right hUY)).hom d) =
            Algebra.TensorProduct.includeLeftRingHom d) ∧
          ∀ b : Γ(X, UX), e ((g.appLE UX UY (chart_le_preimage_left hUY)).hom b) =
            (Algebra.TensorProduct.includeRight.toRingHom :
              Γ(X, UX) →+* TensorProduct Γ(S, US) Γ(T, UT) Γ(X, UX)) b :=
    ⟨sectionsTensorEquiv H hUST hUSX hUY hUS hUT hUX (RingEquiv.refl Γ(S, US))
        (RingEquiv.refl Γ(T, UT)) (RingEquiv.refl Γ(X, UX)) hD hB,
      sectionsTensorEquiv_appLE_right H hUST hUSX hUY hUS hUT hUX (RingEquiv.refl Γ(S, US))
        (RingEquiv.refl Γ(T, UT)) (RingEquiv.refl Γ(X, UX)) hD hB,
      sectionsTensorEquiv_appLE_left H hUST hUSX hUY hUS hUT hUX (RingEquiv.refl Γ(S, US))
        (RingEquiv.refl Γ(T, UT)) (RingEquiv.refl Γ(X, UX)) hD hB⟩
  have key : ∀ z : TensorProduct Γ(S, US) Γ(T, UT) Γ(X, UX), φ (e.symm z) = ψ (e.symm z) := by
    intro z
    induction z using TensorProduct.induction_on with
    | zero => simp
    | add z w hz hw => simp [hz, hw]
    | tmul d b =>
        have hd : e.symm ((Algebra.TensorProduct.includeLeftRingHom :
              Γ(T, UT) →+* TensorProduct Γ(S, US) Γ(T, UT) Γ(X, UX)) d) =
            (iY.appLE UT UY (chart_le_preimage_right hUY)).hom d := by
          rw [← heright d, RingEquiv.symm_apply_apply]
        have hb : e.symm ((Algebra.TensorProduct.includeRight.toRingHom :
              Γ(X, UX) →+* TensorProduct Γ(S, US) Γ(T, UT) Γ(X, UX)) b) =
            (g.appLE UX UY (chart_le_preimage_left hUY)).hom b := by
          rw [← heleft b, RingEquiv.symm_apply_apply]
        have hmul : (d ⊗ₜ[Γ(S, US)] b : TensorProduct Γ(S, US) Γ(T, UT) Γ(X, UX)) =
            (Algebra.TensorProduct.includeLeftRingHom :
                Γ(T, UT) →+* TensorProduct Γ(S, US) Γ(T, UT) Γ(X, UX)) d *
              (Algebra.TensorProduct.includeRight.toRingHom :
                Γ(X, UX) →+* TensorProduct Γ(S, US) Γ(T, UT) Γ(X, UX)) b := by
          simp [Algebra.TensorProduct.tmul_mul_tmul]
        rw [hmul, map_mul, map_mul, hd, hb, hright, hleft, map_mul]
  refine RingHom.ext fun a => ?_
  have h := key (e a)
  rwa [RingEquiv.symm_apply_apply] at h

section Naturality

variable (H : IsPullback g iY iX f) {UX' : X.Opens} {UY' : Y.Opens}
  (hUST : UT ≤ f ⁻¹ᵁ US) (hUSX : UX ≤ iX ⁻¹ᵁ US)
  (hUY : UY = g ⁻¹ᵁ UX ⊓ iY ⁻¹ᵁ UT)
  (hUS : IsAffineOpen US) (hUT : IsAffineOpen UT) (hUX : IsAffineOpen UX)
  {C D B B' : Type u} [CommRing C] [CommRing D] [CommRing B] [CommRing B']
  [Algebra C D] [Algebra C B] [Algebra C B']
  (eC : Γ(S, US) ≃+* C) (eD : Γ(T, UT) ≃+* D) (eB : Γ(X, UX) ≃+* B)
  (hD : ∀ x : Γ(S, US), eD ((f.appLE US UT hUST).hom x) = algebraMap C D (eC x))
  (hB : ∀ x : Γ(S, US), eB ((iX.appLE US UX hUSX).hom x) = algebraMap C B (eC x))

/-- **The identification of the sections of a chart of a fibre product with a tensor product is
natural in the chart of `X`.** Shrinking the chart `UX` of `X` to `UX'` shrinks the chart `UY` of
the fibre product to `UY'`; under the two identifications the restriction map
`Γ(Y, UY) → Γ(Y, UY')` becomes `D ⊗_C -` applied to the restriction map
`Γ(X, UX) → Γ(X, UX')`, as expressed by a ring map `res : B →+* B'` over `C` matching it.

Both sides are ring maps out of the chart ring, so it suffices to compare them on the sections
pulled back from `T` and from `X`, which is `AlgebraicGeometry.sectionsTensor_hom_ext`. -/
theorem sectionsTensorEquiv_naturality
    (hUXX : UX' ≤ UX) (hUSX' : UX' ≤ iX ⁻¹ᵁ US)
    (hUX' : IsAffineOpen UX') (eB' : Γ(X, UX') ≃+* B')
    (hB' : ∀ x : Γ(S, US), eB' ((iX.appLE US UX' hUSX').hom x) = algebraMap C B' (eC x))
    (hUY' : UY' = g ⁻¹ᵁ UX' ⊓ iY ⁻¹ᵁ UT) (hUYY : UY' ≤ UY)
    (res : B →ₐ[C] B')
    (hres : ∀ x : Γ(X, UX), res (eB x) = eB' (X.presheaf.map (homOfLE hUXX).op x))
    (z : Γ(Y, UY)) :
    sectionsTensorEquiv H hUST hUSX' hUY' hUS hUT hUX' eC eD eB' hD hB'
        (Y.presheaf.map (homOfLE hUYY).op z) =
      Algebra.TensorProduct.map (AlgHom.id C D) res
        (sectionsTensorEquiv H hUST hUSX hUY hUS hUT hUX eC eD eB hD hB z) := by
  have hcomp := sectionsTensor_hom_ext H hUST hUSX hUY hUS hUT hUX
    (((sectionsTensorEquiv H hUST hUSX' hUY' hUS hUT hUX' eC eD eB' hD hB' :
        Γ(Y, UY') →+* TensorProduct C D B').comp
      (Y.presheaf.map (homOfLE hUYY).op).hom))
    (((Algebra.TensorProduct.map (AlgHom.id C D) res :
        TensorProduct C D B →+* TensorProduct C D B').comp
      (sectionsTensorEquiv H hUST hUSX hUY hUS hUT hUX eC eD eB hD hB : Γ(Y, UY) →+* _)))
    (fun y => ?_) (fun x => ?_)
  · exact congrFun (congrArg (fun φ : Γ(Y, UY) →+* TensorProduct C D B' => (φ : _ → _)) hcomp) z
  · have hrestr : (Y.presheaf.map (homOfLE hUYY).op).hom
        ((iY.appLE UT UY (chart_le_preimage_right hUY)).hom y) =
        (iY.appLE UT UY' (chart_le_preimage_right hUY')).hom y := by
      rw [← CommRingCat.comp_apply,
        Scheme.Hom.appLE_map iY (chart_le_preimage_right hUY) (homOfLE hUYY).op]
    simp only [RingHom.coe_comp, Function.comp_apply, hrestr, RingEquiv.coe_toRingHom]
    rw [sectionsTensorEquiv_appLE_right H hUST hUSX' hUY' hUS hUT hUX' eC eD eB' hD hB' y,
      sectionsTensorEquiv_appLE_right H hUST hUSX hUY hUS hUT hUX eC eD eB hD hB y]
    simp only [RingHom.coe_coe, Algebra.TensorProduct.includeLeftRingHom_apply,
      Algebra.TensorProduct.map_tmul, AlgHom.coe_id, id_eq, map_one]
  · have hrestr : (Y.presheaf.map (homOfLE hUYY).op).hom
        ((g.appLE UX UY (chart_le_preimage_left hUY)).hom x) =
        (g.appLE UX' UY' (chart_le_preimage_left hUY')).hom
          (X.presheaf.map (homOfLE hUXX).op x) := by
      rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply,
        Scheme.Hom.appLE_map g (chart_le_preimage_left hUY) (homOfLE hUYY).op,
        Scheme.Hom.map_appLE g (chart_le_preimage_left hUY') (homOfLE hUXX).op]
    simp only [RingHom.coe_comp, Function.comp_apply, hrestr, RingEquiv.coe_toRingHom]
    rw [sectionsTensorEquiv_appLE_left H hUST hUSX' hUY' hUS hUT hUX' eC eD eB' hD hB'
        (X.presheaf.map (homOfLE hUXX).op x),
      sectionsTensorEquiv_appLE_left H hUST hUSX hUY hUS hUT hUX eC eD eB hD hB x]
    simp only [RingHom.coe_coe, AlgHom.toRingHom_eq_coe,
      Algebra.TensorProduct.includeRight_apply, Algebra.TensorProduct.map_tmul,
      map_one, hres]

end Naturality

end AlgebraicGeometry

end
