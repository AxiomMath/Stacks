module

public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic
public import StacksFrontier.AlgebraicGeometry.ProjectiveLine.HomogeneousPrimes
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Closed points of the projective line

A homogeneous irreducible form `f ∈ k[T₀, T₁]` cuts out a single point of
`ℙ¹_k = Proj k[T₀, T₁]`, namely the homogeneous prime `(f)`, and that point is closed. This
realises the vanishing locus `V₊(f)` of [Stacks, Tag 0CDP] as a point of the projective line.

## Main definitions

* `Stacks.ProjectiveLine.pointOfForm`: the point `V₊(f)` of `ℙ¹_k`.
* `Stacks.ProjectiveLine.pointOfCoord`: the point `V₊(Tᵢ)` cut out by a homogeneous coordinate.

## Main results

* `Stacks.ProjectiveLine.eq_pointOfForm_of_mem`: a point of `ℙ¹_k` at which `f` vanishes is
  `V₊(f)`.
* `Stacks.ProjectiveLine.zeroLocus_singleton_eq`: **`V₊(f)` is a single point**.
* `Stacks.ProjectiveLine.isClosed_singleton_pointOfForm`: that point is closed.
* `Stacks.ProjectiveLine.zeroLocus_singleton_X_eq`: **`V₊(Tᵢ)` is a single point**.

## References

* [Stacks Project, Tag 0CDP](https://stacks.math.columbia.edu/tag/0CDP)
-/

@[expose] public section

open AlgebraicGeometry

attribute [local instance] MvPolynomial.gradedAlgebra

namespace Stacks.ProjectiveLine

universe u

variable {k : Type u} [Field k] {d : ℕ} {f : MvPolynomial (Fin 2) k}

/-- **The point `V₊(f)` of the projective line** cut out by a homogeneous irreducible form `f`:
the homogeneous prime `(f)`. -/
@[ega "II 7.4.14" "more general"]
noncomputable def pointOfForm (hf : f.IsHomogeneous d) (hirr : Irreducible f) :
    ProjectiveSpectrum (grading k) where
  asHomogeneousIdeal := ⟨Ideal.span {f}, isHomogeneous_span_singleton hf⟩
  isPrime := isPrime_span_singleton hirr
  not_irrelevant_le := not_irrelevant_le_span_singleton hf hirr

/-- The ideal of the point `V₊(f)` is `(f)`. -/
@[simp]
theorem toIdeal_asHomogeneousIdeal_pointOfForm (hf : f.IsHomogeneous d)
    (hirr : Irreducible f) :
    (pointOfForm hf hirr).asHomogeneousIdeal.toIdeal = Ideal.span {f} := rfl

/-- A polynomial vanishes at `V₊(f)` exactly when it is divisible by `f`. -/
@[simp]
theorem mem_pointOfForm_iff (hf : f.IsHomogeneous d) (hirr : Irreducible f)
    {g : MvPolynomial (Fin 2) k} :
    g ∈ (pointOfForm hf hirr).asHomogeneousIdeal ↔ f ∣ g :=
  Ideal.mem_span_singleton

/-- The form `f` vanishes at `V₊(f)`. -/
theorem mem_pointOfForm (hf : f.IsHomogeneous d) (hirr : Irreducible f) :
    f ∈ (pointOfForm hf hirr).asHomogeneousIdeal :=
  Ideal.mem_span_singleton_self f

/-- **Uniqueness of the point cut out by an irreducible form**: a point of `ℙ¹_k` at which `f`
vanishes is `V₊(f)`. -/
theorem eq_pointOfForm_of_mem (hf : f.IsHomogeneous d) (hirr : Irreducible f)
    (x : ProjectiveSpectrum (grading k)) (hx : f ∈ x.asHomogeneousIdeal) :
    x = pointOfForm hf hirr :=
  ProjectiveSpectrum.ext (HomogeneousIdeal.toIdeal_injective
    (eq_span_singleton_of_irreducible_mem x.isPrime x.asHomogeneousIdeal.isHomogeneous
      x.not_irrelevant_le hirr hx))

/-- **`V₊(f)` is a single point of `ℙ¹_k`** when `f` is a homogeneous irreducible form. -/
theorem zeroLocus_singleton_eq (hf : f.IsHomogeneous d) (hirr : Irreducible f) :
    ProjectiveSpectrum.zeroLocus (grading k) {f} = {pointOfForm hf hirr} := by
  refine Set.eq_singleton_iff_unique_mem.mpr ⟨?_, fun x hx => ?_⟩
  · exact (ProjectiveSpectrum.mem_zeroLocus _ _ _).mpr
      (Set.singleton_subset_iff.mpr (mem_pointOfForm hf hirr))
  · exact eq_pointOfForm_of_mem hf hirr x
      (Set.singleton_subset_iff.mp ((ProjectiveSpectrum.mem_zeroLocus _ _ _).mp hx))

/-- The point `V₊(f)` is a closed point of `ℙ¹_k`. -/
theorem isClosed_singleton_pointOfForm (hf : f.IsHomogeneous d) (hirr : Irreducible f) :
    IsClosed ({pointOfForm hf hirr} : Set (ProjectiveSpectrum (grading k))) :=
  zeroLocus_singleton_eq hf hirr ▸ ProjectiveSpectrum.isClosed_zeroLocus _ _

/-! ### The coordinate points `V₊(T₀)` and `V₊(T₁)` -/

/-- **The point `V₊(Tᵢ)` of `ℙ¹_k`**: the homogeneous prime generated by the `i`-th homogeneous
coordinate, which is the complement of the `i`-th standard chart. -/
noncomputable def pointOfCoord (k : Type u) [Field k] (i : Fin 2) :
    ProjectiveSpectrum (grading k) :=
  pointOfForm (MvPolynomial.isHomogeneous_X k i) MvPolynomial.X_prime.irreducible

/-- The ideal of the point `V₊(Tᵢ)` is `(Tᵢ)`. -/
@[simp]
theorem toIdeal_asHomogeneousIdeal_pointOfCoord (k : Type u) [Field k] (i : Fin 2) :
    (pointOfCoord k i).asHomogeneousIdeal.toIdeal = Ideal.span {MvPolynomial.X i} := rfl

/-- **`V₊(Tᵢ)` is a single point of `ℙ¹_k`.** -/
theorem zeroLocus_singleton_X_eq (k : Type u) [Field k] (i : Fin 2) :
    ProjectiveSpectrum.zeroLocus (grading k) {MvPolynomial.X i} = {pointOfCoord k i} :=
  zeroLocus_singleton_eq (MvPolynomial.isHomogeneous_X k i) MvPolynomial.X_prime.irreducible

/-- The point `V₊(Tᵢ)` is a closed point of `ℙ¹_k`. -/
theorem isClosed_singleton_pointOfCoord (k : Type u) [Field k] (i : Fin 2) :
    IsClosed ({pointOfCoord k i} : Set (ProjectiveSpectrum (grading k))) :=
  isClosed_singleton_pointOfForm (MvPolynomial.isHomogeneous_X k i) MvPolynomial.X_prime.irreducible

end Stacks.ProjectiveLine

end
