module

public import Mathlib.Algebra.MvPolynomial.Division
public import Mathlib.Algebra.Polynomial.Homogenize
public import Mathlib.RingTheory.GradedAlgebra.Homogeneous.Ideal
public import Mathlib.RingTheory.Polynomial.UniqueFactorization
public import Mathlib.RingTheory.PrincipalIdealDomain
import StacksCore.Tactic.EgaSgaAttribute

/-!
# Homogeneous primes of a polynomial ring in two variables

The homogeneous prime ideals of `k[T₀, T₁]` that do not contain the irrelevant ideal `(T₀, T₁)`
are the zero ideal and the principal ideals `(f)` generated by a homogeneous irreducible `f`.
This is the ideal-theoretic half of the description of the points of the projective line over a
field: the zero ideal is its generic point and each `(f)` is a closed point.

Everything is run through dehomogenization `Stacks.ProjectiveLine.dehomogenize`, the `k`-algebra
map `k[T₀, T₁] → k[X]` sending `T₀ ↦ X` and `T₁ ↦ 1`. Mathlib's `Polynomial.homogenize` is its
one-sided inverse: a form of degree `n` is the degree-`n` homogenization of its dehomogenization,
so dehomogenization is injective on each graded piece and transports factorization in `k[X]` back
to `k[T₀, T₁]`. The one step that is not formal is the passage from a Bézout identity in `k[X]`
to a power of `T₁` inside an ideal, which is
`Stacks.ProjectiveLine.exists_X_one_pow_eq_of_dehomogenize_bezout`; it replaces a resultant
computation.

## Main definitions

* `Stacks.ProjectiveLine.grading`: the total-degree grading of `k[T₀, T₁]`.
* `Stacks.ProjectiveLine.dehomogenize`: the `k`-algebra map `k[T₀, T₁] → k[X]` setting `T₁ = 1`.

## Main results

* `Stacks.ProjectiveLine.homogenize_dehomogenize`: a form of degree `n` is the degree-`n`
  homogenization of its dehomogenization.
* `Stacks.ProjectiveLine.eq_X_one_pow_mul_homogenize`: the normal form of a binary form, which
  splits off the largest power of `T₁` dividing it.
* `Stacks.ProjectiveLine.exists_X_one_pow_eq_of_dehomogenize_bezout`: a Bézout identity between
  the dehomogenizations of two forms lifts to a representation of a positive power of `T₁`.
* `Stacks.ProjectiveLine.dvd_of_isHomogeneous_mem`: inside a relevant homogeneous prime, a form
  whose dehomogenization is irreducible of the same degree divides every form of the prime.
* `Stacks.ProjectiveLine.exists_irreducible_eq_span`: **the classification** — a nonzero
  homogeneous prime not containing the irrelevant ideal is generated by one homogeneous
  irreducible form.
* `Stacks.ProjectiveLine.eq_span_singleton_of_irreducible_mem`: such a prime containing an
  irreducible element is generated by it.
* `Stacks.ProjectiveLine.dvd_X_one_iff_X_one_dvd`: for a homogeneous irreducible form, dividing
  `T₁` and being divisible by `T₁` agree.
* `Stacks.ProjectiveLine.isPrime_span_singleton`,
  `Stacks.ProjectiveLine.isHomogeneous_span_singleton` and
  `Stacks.ProjectiveLine.not_irrelevant_le_span_singleton`: the converse — the ideal generated by
  a homogeneous irreducible form is a homogeneous prime not containing the irrelevant ideal.

## References

* [Stacks Project, Tag 0CDP](https://stacks.math.columbia.edu/tag/0CDP)
-/

@[expose] public section

attribute [local instance] MvPolynomial.gradedAlgebra

namespace Stacks.ProjectiveLine

universe u

variable (k : Type u) [Field k]

/-- The total-degree grading of the polynomial ring `k[T₀, T₁]`. -/
abbrev grading : ℕ → Submodule k (MvPolynomial (Fin 2) k) :=
  MvPolynomial.homogeneousSubmodule (Fin 2) k

/-- **Dehomogenization**: the `k`-algebra map `k[T₀, T₁] → k[X]` sending `T₀` to `X` and `T₁`
to `1`. It is a one-sided inverse of `Polynomial.homogenize` on each graded piece. -/
noncomputable def dehomogenize : MvPolynomial (Fin 2) k →ₐ[k] Polynomial k :=
  MvPolynomial.aeval ![Polynomial.X, 1]

variable {k}

/-- Dehomogenization evaluates a polynomial at `T₀ = X`, `T₁ = 1`. -/
theorem dehomogenize_apply (g : MvPolynomial (Fin 2) k) :
    dehomogenize k g = MvPolynomial.aeval ![Polynomial.X, 1] g := rfl

/-- Dehomogenization sends `T₀` to `X`. -/
@[simp]
theorem dehomogenize_X_zero : dehomogenize k (MvPolynomial.X 0) = Polynomial.X := by
  simp [dehomogenize_apply]

/-- Dehomogenization sends `T₁` to `1`. -/
@[simp]
theorem dehomogenize_X_one : dehomogenize k (MvPolynomial.X 1) = 1 := by
  simp [dehomogenize_apply]

/-- Dehomogenization undoes homogenization in the degrees where the latter loses nothing. -/
theorem dehomogenize_homogenize {q : Polynomial k} {n : ℕ} (hn : q.natDegree ≤ n) :
    dehomogenize k (q.homogenize n) = q :=
  Polynomial.aeval_homogenize_X_one q hn

/-- A form of degree `n` is the degree-`n` homogenization of its dehomogenization. -/
theorem homogenize_dehomogenize {n : ℕ} {g : MvPolynomial (Fin 2) k} (hg : g.IsHomogeneous n) :
    (dehomogenize k g).homogenize n = g :=
  Polynomial.homogenize_eq_of_isHomogeneous hg rfl

/-- Dehomogenizing a form of degree `n` cannot raise the degree above `n`. -/
theorem natDegree_dehomogenize_le {n : ℕ} {g : MvPolynomial (Fin 2) k}
    (hg : g.IsHomogeneous n) : (dehomogenize k g).natDegree ≤ n := by
  classical
  rw [g.as_sum, map_sum]
  refine Polynomial.natDegree_sum_le_of_forall_le _ _ fun v hv => ?_
  have hv0 : v 0 ≤ n := by
    rw [hg.degree_eq_sum_deg_support hv]
    by_cases h : v 0 = 0
    · simp [h]
    · exact Finset.single_le_sum (f := fun i => v i) (fun _ _ => Nat.zero_le _)
        (Finsupp.mem_support_iff.mpr h)
  rw [dehomogenize_apply, MvPolynomial.aeval_monomial,
    Finsupp.prod_fintype _ _ fun i => pow_zero _, Fin.prod_univ_two]
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, one_pow, mul_one]
  exact le_trans Polynomial.natDegree_mul_le (by simpa [Polynomial.algebraMap_eq] using hv0)

/-- Dehomogenization is injective on forms of a fixed degree. -/
theorem eq_of_dehomogenize_eq {n : ℕ} {g h : MvPolynomial (Fin 2) k} (hg : g.IsHomogeneous n)
    (hh : h.IsHomogeneous n) (hgh : dehomogenize k g = dehomogenize k h) : g = h := by
  rw [← homogenize_dehomogenize hg, ← homogenize_dehomogenize hh, hgh]

/-- A form vanishes if and only if its dehomogenization vanishes. -/
theorem dehomogenize_eq_zero_iff {n : ℕ} {g : MvPolynomial (Fin 2) k} (hg : g.IsHomogeneous n) :
    dehomogenize k g = 0 ↔ g = 0 :=
  ⟨fun h => eq_of_dehomogenize_eq hg (MvPolynomial.isHomogeneous_zero _ _ _) (by simp [h]),
    fun h => by simp [h]⟩

/-- **Normal form of a binary form**: splitting off the largest power of `T₁` that divides it
leaves the homogenization of its dehomogenization at the latter's own degree. -/
theorem eq_X_one_pow_mul_homogenize {n : ℕ} {g : MvPolynomial (Fin 2) k}
    (hg : g.IsHomogeneous n) :
    g = MvPolynomial.X 1 ^ (n - (dehomogenize k g).natDegree) *
      (dehomogenize k g).homogenize (dehomogenize k g).natDegree := by
  have hmn : (dehomogenize k g).natDegree ≤ n := natDegree_dehomogenize_le hg
  have hhom : (MvPolynomial.X (1 : Fin 2) ^ (n - (dehomogenize k g).natDegree) *
      (dehomogenize k g).homogenize (dehomogenize k g).natDegree).IsHomogeneous n := by
    have := (MvPolynomial.isHomogeneous_X_pow (R := k) (1 : Fin 2)
        (n - (dehomogenize k g).natDegree)).mul
      (Polynomial.isHomogeneous_homogenize (n := (dehomogenize k g).natDegree)
        (dehomogenize k g))
    rwa [Nat.sub_add_cancel hmn] at this
  have hd : dehomogenize k (MvPolynomial.X (1 : Fin 2) ^ (n - (dehomogenize k g).natDegree) *
      (dehomogenize k g).homogenize (dehomogenize k g).natDegree) = dehomogenize k g := by
    rw [map_mul, map_pow, dehomogenize_X_one, one_pow, one_mul, dehomogenize_homogenize le_rfl]
  rw [← Polynomial.homogenize_eq_of_isHomogeneous hhom hd, homogenize_dehomogenize hg]

/-- `T₁` divides the degree-`n` homogenization of a polynomial of degree at most `n` whose
`n`-th coefficient vanishes. -/
theorem X_one_dvd_homogenize {n : ℕ} {q : Polynomial k} (hle : q.natDegree ≤ n)
    (hc : q.coeff n = 0) : MvPolynomial.X 1 ∣ q.homogenize n := by
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · have hq : q = 0 := by
      rw [Polynomial.eq_C_of_natDegree_le_zero hle]
      simpa using hc
    simp [hq]
  · have hlt : q.natDegree < n := by
      rcases eq_or_ne q 0 with rfl | hq
      · simpa using hn
      · refine lt_of_le_of_ne hle fun hEq => ?_
        exact Polynomial.leadingCoeff_ne_zero.mpr hq (by rw [Polynomial.leadingCoeff, hEq, hc])
    have hdq : dehomogenize k (q.homogenize n) = q := dehomogenize_homogenize hle
    have hnf := eq_X_one_pow_mul_homogenize
      (Polynomial.isHomogeneous_homogenize (n := n) q)
    rw [hdq] at hnf
    obtain ⟨j, hj⟩ : ∃ j, n - q.natDegree = j + 1 := ⟨n - q.natDegree - 1, by omega⟩
    rw [hnf, hj, pow_succ']
    exact ⟨MvPolynomial.X 1 ^ j * q.homogenize q.natDegree, by ring⟩

/-- `T₁` divides a form of degree `n` whose dehomogenization has degree less than `n`. -/
theorem X_one_dvd_of_natDegree_dehomogenize_lt {n : ℕ} {g : MvPolynomial (Fin 2) k}
    (hg : g.IsHomogeneous n) (h : (dehomogenize k g).natDegree < n) :
    MvPolynomial.X 1 ∣ g := by
  rw [← homogenize_dehomogenize hg]
  exact X_one_dvd_homogenize h.le (Polynomial.coeff_eq_zero_of_natDegree_lt h)

/-- **Reduction of a form modulo `T₁`**: a form of degree `n` agrees with a multiple of `T₀ ^ n`
modulo `T₁`, the constant being the `n`-th coefficient of its dehomogenization. -/
theorem X_one_dvd_sub_C_mul_X_zero_pow {n : ℕ} {g : MvPolynomial (Fin 2) k}
    (hg : g.IsHomogeneous n) :
    MvPolynomial.X 1 ∣
      g - MvPolynomial.C ((dehomogenize k g).coeff n) * MvPolynomial.X 0 ^ n := by
  have hGle : (dehomogenize k g).natDegree ≤ n := natDegree_dehomogenize_le hg
  have hmono : (Polynomial.C ((dehomogenize k g).coeff n) * Polynomial.X ^ n).natDegree ≤ n :=
    le_trans Polynomial.natDegree_mul_le (by simp)
  have hqle : (dehomogenize k g -
      Polynomial.C ((dehomogenize k g).coeff n) * Polynomial.X ^ n).natDegree ≤ n :=
    le_trans (Polynomial.natDegree_sub_le _ _) (max_le hGle hmono)
  have hqc : (dehomogenize k g -
      Polynomial.C ((dehomogenize k g).coeff n) * Polynomial.X ^ n).coeff n = 0 := by
    simp [Polynomial.coeff_C_mul]
  have hsplit : (dehomogenize k g -
        Polynomial.C ((dehomogenize k g).coeff n) * Polynomial.X ^ n).homogenize n =
      g - MvPolynomial.C ((dehomogenize k g).coeff n) * MvPolynomial.X 0 ^ n := by
    rw [Polynomial.homogenize_sub, homogenize_dehomogenize hg, Polynomial.homogenize_C_mul,
      Polynomial.homogenize_X_pow (le_refl n)]
    simp
  rw [← hsplit]
  exact X_one_dvd_homogenize hqle hqc

/-- A form of positive degree lies in the coordinate ideal `(T₀, T₁)`. -/
theorem mem_span_X_of_isHomogeneous {n : ℕ} {g : MvPolynomial (Fin 2) k}
    (hg : g.IsHomogeneous n) (hn : 0 < n) :
    g ∈ Ideal.span {MvPolynomial.X (0 : Fin 2), MvPolynomial.X (1 : Fin 2)} := by
  obtain ⟨w, hw⟩ := X_one_dvd_sub_C_mul_X_zero_pow hg
  have hg' : g = MvPolynomial.C ((dehomogenize k g).coeff n) * MvPolynomial.X 0 ^ n +
      MvPolynomial.X 1 * w := by rw [← hw]; ring
  rw [hg']
  refine Ideal.add_mem _ (Ideal.mul_mem_left _ _ ?_) (Ideal.mul_mem_right _ _ ?_)
  · exact Ideal.pow_mem_of_mem _ (Ideal.subset_span (by simp)) n hn
  · exact Ideal.subset_span (by simp)

/-- The irrelevant ideal is contained in an ideal exactly when both coordinates are. -/
theorem toIdeal_irrelevant_le_iff {I : Ideal (MvPolynomial (Fin 2) k)} :
    (HomogeneousIdeal.irrelevant (grading k)).toIdeal ≤ I ↔
      MvPolynomial.X (0 : Fin 2) ∈ I ∧ MvPolynomial.X (1 : Fin 2) ∈ I := by
  constructor
  · intro h
    refine ⟨h (HomogeneousIdeal.mem_irrelevant_of_mem _ Nat.one_pos ?_),
      h (HomogeneousIdeal.mem_irrelevant_of_mem _ Nat.one_pos ?_)⟩
    · exact (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X k 0)
    · exact (MvPolynomial.mem_homogeneousSubmodule _ _).mpr (MvPolynomial.isHomogeneous_X k 1)
  · rintro ⟨h0, h1⟩
    refine (HomogeneousIdeal.toIdeal_irrelevant_le _).mpr fun i hi g hg => ?_
    have hmem := mem_span_X_of_isHomogeneous
      ((MvPolynomial.mem_homogeneousSubmodule i g).mp hg) hi
    exact Ideal.span_le.mpr (by simp [Set.insert_subset_iff, h0, h1]) hmem

/-- A homogeneous ideal all of whose forms are divisible by `f` is contained in `(f)`. -/
theorem le_span_singleton_of_forall_isHomogeneous {p : Ideal (MvPolynomial (Fin 2) k)}
    (hp : p.IsHomogeneous (grading k)) {f : MvPolynomial (Fin 2) k}
    (H : ∀ (n : ℕ) (g : MvPolynomial (Fin 2) k), g.IsHomogeneous n → g ∈ p → f ∣ g) :
    p ≤ Ideal.span {f} := by
  classical
  intro x hx
  rw [Ideal.mem_span_singleton, ← DirectSum.sum_support_decompose (grading k) x]
  refine Finset.dvd_sum fun i _ => ?_
  exact H i _ ((MvPolynomial.mem_homogeneousSubmodule _ _).mp
    (DirectSum.decompose (grading k) x i).2) (hp i hx)

/-- **A Bézout identity lifts to a power of `T₁`**: if the dehomogenizations of two forms `f` and
`g` generate the unit ideal of `k[X]`, then some positive power of `T₁` lies in `(f, g)`. This is
the one arithmetic input of the classification, in place of a resultant computation. -/
theorem exists_X_one_pow_eq_of_dehomogenize_bezout {d e : ℕ} {f g : MvPolynomial (Fin 2) k}
    (hf : f.IsHomogeneous d) (hg : g.IsHomogeneous e) {u v : Polynomial k}
    (huv : u * dehomogenize k f + v * dehomogenize k g = 1) :
    ∃ (a b : MvPolynomial (Fin 2) k) (N : ℕ), 0 < N ∧ a * f + b * g = MvPolynomial.X 1 ^ N := by
  set N := max (d + u.natDegree + 1) (e + v.natDegree + 1) with hN
  have hdN : d + u.natDegree ≤ N := le_trans (Nat.le_succ _) (le_max_left _ _)
  have heN : e + v.natDegree ≤ N := le_trans (Nat.le_succ _) (le_max_right _ _)
  refine ⟨u.homogenize (N - d), v.homogenize (N - e), N, by omega, ?_⟩
  have h1 : (u * dehomogenize k f).homogenize N = u.homogenize (N - d) * f :=
    calc (u * dehomogenize k f).homogenize N
        = (u * dehomogenize k f).homogenize (N - d + d) := by rw [Nat.sub_add_cancel (by omega)]
      _ = u.homogenize (N - d) * (dehomogenize k f).homogenize d :=
          Polynomial.homogenize_mul u _ (by omega) (natDegree_dehomogenize_le hf)
      _ = u.homogenize (N - d) * f := by rw [homogenize_dehomogenize hf]
  have h2 : (v * dehomogenize k g).homogenize N = v.homogenize (N - e) * g :=
    calc (v * dehomogenize k g).homogenize N
        = (v * dehomogenize k g).homogenize (N - e + e) := by rw [Nat.sub_add_cancel (by omega)]
      _ = v.homogenize (N - e) * (dehomogenize k g).homogenize e :=
          Polynomial.homogenize_mul v _ (by omega) (natDegree_dehomogenize_le hg)
      _ = v.homogenize (N - e) * g := by rw [homogenize_dehomogenize hg]
  simpa [h1, h2] using congrArg (fun q => Polynomial.homogenize q N) huv

/-- An irreducible polynomial that does not divide `G` generates the unit ideal with `G`. -/
theorem exists_bezout_of_irreducible_of_not_dvd {F G : Polynomial k} (hF : Irreducible F)
    (hFG : ¬ F ∣ G) : ∃ u v : Polynomial k, u * F + v * G = 1 := by
  have hmax : (Ideal.span {F}).IsMaximal := PrincipalIdealRing.isMaximal_of_irreducible hF
  have hGn : G ∉ Ideal.span {F} := by simpa [Ideal.mem_span_singleton] using hFG
  have hle : Ideal.span {F} ≤ Ideal.span {F, G} :=
    Ideal.span_le.mpr (Set.singleton_subset_iff.mpr (Ideal.subset_span (by simp)))
  have htop : Ideal.span ({F, G} : Set (Polynomial k)) = ⊤ := by
    by_contra hne
    exact hGn (hmax.eq_of_le hne hle ▸ Ideal.subset_span (by simp))
  exact Ideal.mem_span_pair.mp (htop ▸ Submodule.mem_top)

/-- **The divisibility step of the classification**: inside a homogeneous prime that avoids `T₁`,
a form whose dehomogenization is irreducible of the same degree divides every form of the
prime. -/
theorem dvd_of_isHomogeneous_mem {p : Ideal (MvPolynomial (Fin 2) k)} (hprime : p.IsPrime)
    {d : ℕ} {f : MvPolynomial (Fin 2) k} (hf : f.IsHomogeneous d) (hfp : f ∈ p)
    (hfd : (dehomogenize k f).natDegree = d) (hF : Irreducible (dehomogenize k f))
    (h1 : MvPolynomial.X (1 : Fin 2) ∉ p) {n : ℕ} {g : MvPolynomial (Fin 2) k}
    (hg : g.IsHomogeneous n) (hgp : g ∈ p) : f ∣ g := by
  have hdvd : dehomogenize k f ∣ dehomogenize k g := by
    by_contra hnd
    obtain ⟨u, v, huv⟩ := exists_bezout_of_irreducible_of_not_dvd hF hnd
    obtain ⟨a, b, N, hN, hab⟩ := exists_X_one_pow_eq_of_dehomogenize_bezout hf hg huv
    have hmem : MvPolynomial.X (1 : Fin 2) ^ N ∈ p := by
      rw [← hab]
      exact Ideal.add_mem _ (Ideal.mul_mem_left _ _ hfp) (Ideal.mul_mem_left _ _ hgp)
    exact h1 (hprime.mem_of_pow_mem N hmem)
  have hfh : f = (dehomogenize k f).homogenize (dehomogenize k f).natDegree := by
    rw [hfd, homogenize_dehomogenize hf]
  calc f ∣ (dehomogenize k g).homogenize (dehomogenize k g).natDegree := by
        rw [hfh]; exact Polynomial.homogenize_dvd hdvd
    _ ∣ g := Dvd.intro_left _ (eq_X_one_pow_mul_homogenize hg).symm

/-- If a nonzero constant times a power of `x` lies in a prime ideal, so does `x`. -/
private theorem mem_of_C_mul_pow_mem {p : Ideal (MvPolynomial (Fin 2) k)} (hprime : p.IsPrime)
    {c : k} (hc : c ≠ 0) {x : MvPolynomial (Fin 2) k} (n : ℕ)
    (h : MvPolynomial.C c * x ^ n ∈ p) : x ∈ p :=
  hprime.mem_of_pow_mem n ((hprime.mem_or_mem h).resolve_left fun hCp =>
    hprime.ne_top (Ideal.eq_top_of_isUnit_mem _ hCp ((isUnit_iff_ne_zero.mpr hc).map _)))

/-- A homogeneous prime containing `T₁` but not `T₀` is `(T₁)`. -/
theorem eq_span_X_one {p : Ideal (MvPolynomial (Fin 2) k)} (hprime : p.IsPrime)
    (hhom : p.IsHomogeneous (grading k)) (h1 : MvPolynomial.X (1 : Fin 2) ∈ p)
    (h0 : MvPolynomial.X (0 : Fin 2) ∉ p) : p = Ideal.span {MvPolynomial.X (1 : Fin 2)} := by
  refine le_antisymm (le_span_singleton_of_forall_isHomogeneous hhom fun n g hg hgp => ?_)
    (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr h1))
  obtain ⟨w, hw⟩ := X_one_dvd_sub_C_mul_X_zero_pow hg
  have hc : MvPolynomial.C ((dehomogenize k g).coeff n) * MvPolynomial.X (0 : Fin 2) ^ n ∈ p := by
    have heq : MvPolynomial.C ((dehomogenize k g).coeff n) * MvPolynomial.X (0 : Fin 2) ^ n =
        g - MvPolynomial.X 1 * w := by rw [← hw]; ring
    rw [heq]
    exact Ideal.sub_mem _ hgp (Ideal.mul_mem_right _ _ h1)
  have hcz : (dehomogenize k g).coeff n = 0 := by
    by_contra hne
    exact h0 (mem_of_C_mul_pow_mem hprime hne n hc)
  rw [← homogenize_dehomogenize hg]
  exact X_one_dvd_homogenize (natDegree_dehomogenize_le hg) hcz

/-- A homogeneous irreducible form has positive degree. -/
theorem pos_of_irreducible {d : ℕ} {f : MvPolynomial (Fin 2) k} (hf : f.IsHomogeneous d)
    (hirr : Irreducible f) : 0 < d := by
  refine Nat.pos_of_ne_zero ?_
  rintro rfl
  refine absurd ?_ hirr.not_isUnit
  have hcf : f = MvPolynomial.C ((dehomogenize k f).coeff 0) := by
    have h := homogenize_dehomogenize hf
    rw [Polynomial.eq_C_of_natDegree_le_zero (natDegree_dehomogenize_le hf)] at h
    simpa using h.symm
  rw [hcf]
  exact (isUnit_iff_ne_zero.mpr fun hz => hirr.ne_zero (by rw [hcf, hz, map_zero])).map
    MvPolynomial.C

/-- A form of degree `n` with unit dehomogenization is a nonzero constant times `T₁ ^ n`. -/
private theorem exists_eq_X_one_pow_mul_C_of_isUnit_dehomogenize {n : ℕ}
    {g : MvPolynomial (Fin 2) k} (hg : g.IsHomogeneous n) (hu : IsUnit (dehomogenize k g)) :
    ∃ c : k, c ≠ 0 ∧ g = MvPolynomial.X 1 ^ n * MvPolynomial.C c := by
  obtain ⟨c, hc⟩ : ∃ c : k, dehomogenize k g = Polynomial.C c :=
    ⟨(dehomogenize k g).coeff 0, Polynomial.eq_C_of_natDegree_le_zero
      (le_of_eq (Polynomial.natDegree_eq_zero_of_isUnit hu))⟩
  refine ⟨c, fun hz => hu.ne_zero (by rw [hc, hz, map_zero]), ?_⟩
  have h := eq_X_one_pow_mul_homogenize hg
  rw [hc] at h
  simpa using h

/-- A homogeneous irreducible form dividing `T₁` is a multiple of `T₁`: it is a nonzero constant
multiple of `T₁` itself. -/
theorem X_one_dvd_of_dvd_X_one {d : ℕ} {f : MvPolynomial (Fin 2) k} (hf : f.IsHomogeneous d)
    (hirr : Irreducible f) (h : f ∣ MvPolynomial.X 1) : MvPolynomial.X (1 : Fin 2) ∣ f := by
  have hdu : IsUnit (dehomogenize k f) :=
    isUnit_of_dvd_one (by simpa using map_dvd (dehomogenize k) h)
  obtain ⟨c, -, hnf⟩ := exists_eq_X_one_pow_mul_C_of_isUnit_dehomogenize hf hdu
  obtain ⟨j, hj⟩ : ∃ j, d = j + 1 := ⟨d - 1, by have := pos_of_irreducible hf hirr; omega⟩
  exact ⟨MvPolynomial.X 1 ^ j * MvPolynomial.C c, by rw [hnf, hj]; ring⟩

/-- For a homogeneous irreducible form, dividing `T₁` and being divisible by `T₁` agree. -/
theorem dvd_X_one_iff_X_one_dvd {d : ℕ} {f : MvPolynomial (Fin 2) k} (hf : f.IsHomogeneous d)
    (hirr : Irreducible f) : f ∣ MvPolynomial.X 1 ↔ MvPolynomial.X (1 : Fin 2) ∣ f := by
  refine ⟨X_one_dvd_of_dvd_X_one hf hirr, fun hdvd => ?_⟩
  obtain ⟨w, hw⟩ := hdvd
  obtain ⟨u, hu⟩ := (hirr.isUnit_or_isUnit hw).resolve_left MvPolynomial.X_prime.not_isUnit
  exact ⟨(↑u⁻¹ : MvPolynomial (Fin 2) k), by rw [hw, ← hu, mul_assoc, Units.mul_inv, mul_one]⟩

/-- Dehomogenizing a form that `T₁` does not divide keeps its degree. -/
theorem natDegree_dehomogenize_eq_of_not_X_one_dvd {d : ℕ} {f : MvPolynomial (Fin 2) k}
    (hf : f.IsHomogeneous d) (h : ¬ MvPolynomial.X (1 : Fin 2) ∣ f) :
    (dehomogenize k f).natDegree = d :=
  le_antisymm (natDegree_dehomogenize_le hf)
    (le_of_not_gt fun hlt => h (X_one_dvd_of_natDegree_dehomogenize_lt hf hlt))

/-- Dehomogenization carries a homogeneous irreducible form not divisible by `T₁` to an
irreducible polynomial. -/
theorem irreducible_dehomogenize {d : ℕ} {f : MvPolynomial (Fin 2) k} (hf : f.IsHomogeneous d)
    (hirr : Irreducible f) (h : ¬ MvPolynomial.X (1 : Fin 2) ∣ f) :
    Irreducible (dehomogenize k f) := by
  have hfd : (dehomogenize k f).natDegree = d := natDegree_dehomogenize_eq_of_not_X_one_dvd hf h
  have hfh : (dehomogenize k f).homogenize (dehomogenize k f).natDegree = f := by
    rw [hfd, homogenize_dehomogenize hf]
  refine ⟨fun hu => ?_, fun a b hab => ?_⟩
  · exact (pos_of_irreducible hf hirr).ne'
      (by rw [← hfd]; exact Polynomial.natDegree_eq_zero_of_isUnit hu)
  · have hane : a ≠ 0 := by
      rintro rfl
      exact hirr.ne_zero (hfh ▸ by simp [hab])
    have hbne : b ≠ 0 := by
      rintro rfl
      exact hirr.ne_zero (hfh ▸ by simp [hab])
    have hsplit : f = a.homogenize a.natDegree * b.homogenize b.natDegree := by
      rw [← hfh, hab, Polynomial.natDegree_mul hane hbne,
        Polynomial.homogenize_mul a b le_rfl le_rfl]
    exact (hirr.isUnit_or_isUnit hsplit).imp
      (fun hA => dehomogenize_homogenize (q := a) le_rfl ▸ hA.map (dehomogenize k))
      (fun hB => dehomogenize_homogenize (q := b) le_rfl ▸ hB.map (dehomogenize k))

/-- The dehomogenization of a form in a homogeneous prime avoiding `T₁` is never a unit. -/
theorem not_isUnit_dehomogenize {p : Ideal (MvPolynomial (Fin 2) k)} (hprime : p.IsPrime)
    (h1 : MvPolynomial.X (1 : Fin 2) ∉ p) {n : ℕ} {g : MvPolynomial (Fin 2) k}
    (hg : g.IsHomogeneous n) (hgp : g ∈ p) : ¬ IsUnit (dehomogenize k g) := by
  intro hu
  obtain ⟨c, hc0, hnf⟩ := exists_eq_X_one_pow_mul_C_of_isUnit_dehomogenize hg hu
  exact h1 (mem_of_C_mul_pow_mem hprime hc0 n (by rwa [hnf, mul_comm] at hgp))

/-- Auxiliary induction for `Stacks.ProjectiveLine.exists_irreducible_homogenize_mem`, run on a
bound for the degree of the dehomogenization. -/
theorem exists_irreducible_homogenize_mem_aux {p : Ideal (MvPolynomial (Fin 2) k)}
    (hprime : p.IsPrime) (h1 : MvPolynomial.X (1 : Fin 2) ∉ p) (m : ℕ) :
    ∀ (n : ℕ) (g : MvPolynomial (Fin 2) k), g.IsHomogeneous n → g ∈ p → g ≠ 0 →
      (dehomogenize k g).natDegree ≤ m →
      ∃ F : Polynomial k, Irreducible F ∧ F.homogenize F.natDegree ∈ p := by
  induction m with
  | zero =>
    intro n g hg hgp hgz hle
    refine absurd ?_ (not_isUnit_dehomogenize hprime h1 hg hgp)
    rw [Polynomial.eq_C_of_natDegree_le_zero hle]
    refine Polynomial.isUnit_C.mpr (isUnit_iff_ne_zero.mpr fun hz => hgz ?_)
    refine (dehomogenize_eq_zero_iff hg).mp ?_
    rw [Polynomial.eq_C_of_natDegree_le_zero hle, hz, map_zero]
  | succ m ih =>
    intro n g hg hgp hgz hle
    have hGz : dehomogenize k g ≠ 0 := fun hz => hgz ((dehomogenize_eq_zero_iff hg).mp hz)
    obtain ⟨F, hFirr, w, hw⟩ :=
      WfDvdMonoid.exists_irreducible_factor (not_isUnit_dehomogenize hprime h1 hg hgp) hGz
    have hwz : w ≠ 0 := by rintro rfl; simp [hw] at hGz
    have hFz : F ≠ 0 := hFirr.ne_zero
    have hFpos : 0 < F.natDegree :=
      Polynomial.natDegree_pos_iff_degree_pos.mpr (Polynomial.degree_pos_of_irreducible hFirr)
    have hdeg : (dehomogenize k g).natDegree = F.natDegree + w.natDegree := by
      rw [hw, Polynomial.natDegree_mul hFz hwz]
    have hGsplit : (dehomogenize k g).homogenize (dehomogenize k g).natDegree =
        F.homogenize F.natDegree * w.homogenize w.natDegree := by
      rw [hw, Polynomial.natDegree_mul hFz hwz, Polynomial.homogenize_mul F w le_rfl le_rfl]
    have hnf := eq_X_one_pow_mul_homogenize hg
    rw [hGsplit] at hnf
    have hprod : F.homogenize F.natDegree * w.homogenize w.natDegree ∈ p :=
      (hprime.mem_or_mem (hnf ▸ hgp)).resolve_left fun hx => h1 (hprime.mem_of_pow_mem _ hx)
    rcases hprime.mem_or_mem hprod with hFp | hwp
    · exact ⟨F, hFirr, hFp⟩
    · refine ih w.natDegree _ (Polynomial.isHomogeneous_homogenize (n := w.natDegree) w) hwp
        (fun hz => hwz ((Polynomial.homogenize_eq_zero_iff (le_refl w.natDegree)).mp hz)) ?_
      rw [dehomogenize_homogenize (le_refl w.natDegree)]
      omega

/-- A nonzero form in a homogeneous prime avoiding `T₁` forces the prime to contain the
homogenization of an irreducible polynomial. -/
theorem exists_irreducible_homogenize_mem {p : Ideal (MvPolynomial (Fin 2) k)}
    (hprime : p.IsPrime) (h1 : MvPolynomial.X (1 : Fin 2) ∉ p) {n : ℕ}
    {g : MvPolynomial (Fin 2) k} (hg : g.IsHomogeneous n) (hgp : g ∈ p) (hgz : g ≠ 0) :
    ∃ F : Polynomial k, Irreducible F ∧ F.homogenize F.natDegree ∈ p :=
  exists_irreducible_homogenize_mem_aux hprime h1 (dehomogenize k g).natDegree n g hg hgp hgz
    le_rfl

/-- **The classification of the relevant homogeneous primes of `k[T₀, T₁]`**: a nonzero
homogeneous prime that does not contain the irrelevant ideal is generated by a single homogeneous
irreducible form. Together with the zero ideal these exhaust the points of the projective line. -/
theorem exists_irreducible_eq_span {p : Ideal (MvPolynomial (Fin 2) k)} (hprime : p.IsPrime)
    (hhom : p.IsHomogeneous (grading k))
    (hrel : ¬ (HomogeneousIdeal.irrelevant (grading k)).toIdeal ≤ p) (hne : p ≠ ⊥) :
    ∃ (d : ℕ) (f : MvPolynomial (Fin 2) k),
      f.IsHomogeneous d ∧ Irreducible f ∧ p = Ideal.span {f} := by
  classical
  have hcoord : MvPolynomial.X (0 : Fin 2) ∉ p ∨ MvPolynomial.X (1 : Fin 2) ∉ p :=
    not_and_or.mp fun h => hrel (toIdeal_irrelevant_le_iff.mpr h)
  have key : ∃ (d : ℕ) (f : MvPolynomial (Fin 2) k), f.IsHomogeneous d ∧ p = Ideal.span {f} ∧
      f ≠ 0 := by
    by_cases h1 : MvPolynomial.X (1 : Fin 2) ∈ p
    · have h0 : MvPolynomial.X (0 : Fin 2) ∉ p := hcoord.resolve_right (not_not_intro h1)
      exact ⟨1, MvPolynomial.X 1, MvPolynomial.isHomogeneous_X k 1,
        eq_span_X_one hprime hhom h1 h0, MvPolynomial.X_ne_zero 1⟩
    · obtain ⟨x, hxp, hxz⟩ : ∃ x ∈ p, x ≠ 0 := (Submodule.ne_bot_iff p).mp hne
      obtain ⟨i, hi⟩ :
          ∃ i, (DirectSum.decompose (grading k) x i : MvPolynomial (Fin 2) k) ≠ 0 := by
        by_contra hcon
        refine hxz ?_
        rw [← DirectSum.sum_support_decompose (grading k) x]
        exact Finset.sum_eq_zero fun i _ => not_not.mp fun h => hcon ⟨i, h⟩
      obtain ⟨F, hFirr, hFp⟩ := exists_irreducible_homogenize_mem hprime h1
        ((MvPolynomial.mem_homogeneousSubmodule _ _).mp
          (DirectSum.decompose (grading k) x i).2) (hhom i hxp) hi
      refine ⟨F.natDegree, F.homogenize F.natDegree,
        Polynomial.isHomogeneous_homogenize (n := F.natDegree) F, le_antisymm ?_ ?_, ?_⟩
      · refine le_span_singleton_of_forall_isHomogeneous hhom fun n g hg hgp => ?_
        refine dvd_of_isHomogeneous_mem hprime
          (Polynomial.isHomogeneous_homogenize (n := F.natDegree) F) hFp ?_ ?_ h1 hg hgp
        · rw [dehomogenize_homogenize (le_refl F.natDegree)]
        · rwa [dehomogenize_homogenize (le_refl F.natDegree)]
      · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hFp)
      · exact fun hz => hFirr.ne_zero
          ((Polynomial.homogenize_eq_zero_iff (le_refl F.natDegree)).mp hz)
  obtain ⟨d, f, hf, hps, hfz⟩ := key
  exact ⟨d, f, hf, ((Ideal.span_singleton_prime hfz).mp (hps ▸ hprime)).irreducible, hps⟩

/-- **Maximality of `(f)` among the relevant homogeneous primes**: a homogeneous prime that does
not contain the irrelevant ideal and contains an irreducible element `f` is `(f)`. -/
@[ega "II 7.4.14" "more general"]
theorem eq_span_singleton_of_irreducible_mem {p : Ideal (MvPolynomial (Fin 2) k)}
    (hprime : p.IsPrime) (hhom : p.IsHomogeneous (grading k))
    (hrel : ¬ (HomogeneousIdeal.irrelevant (grading k)).toIdeal ≤ p)
    {f : MvPolynomial (Fin 2) k} (hirr : Irreducible f) (hfp : f ∈ p) :
    p = Ideal.span {f} := by
  obtain ⟨d', f', hf', hirr', hps⟩ :=
    exists_irreducible_eq_span hprime hhom hrel fun hb => hirr.ne_zero (by simpa [hb] using hfp)
  rw [hps] at hfp ⊢
  exact Ideal.span_singleton_eq_span_singleton.mpr
    (hirr'.associated_of_dvd hirr (Ideal.mem_span_singleton.mp hfp))

/-- The ideal generated by an irreducible form is prime. -/
theorem isPrime_span_singleton {f : MvPolynomial (Fin 2) k} (hirr : Irreducible f) :
    (Ideal.span {f}).IsPrime :=
  (Ideal.span_singleton_prime hirr.ne_zero).mpr
    (UniqueFactorizationMonoid.irreducible_iff_prime.mp hirr)

/-- The ideal generated by a form is homogeneous. -/
theorem isHomogeneous_span_singleton {d : ℕ} {f : MvPolynomial (Fin 2) k}
    (hf : f.IsHomogeneous d) : (Ideal.span {f}).IsHomogeneous (grading k) :=
  Ideal.homogeneous_span _ _ <| by
    rintro _ rfl
    exact ⟨d, (MvPolynomial.mem_homogeneousSubmodule _ _).mpr hf⟩

/-- The ideal generated by a homogeneous irreducible form does not contain the irrelevant
ideal: a form dividing both coordinates would have to be associated to each of them. -/
theorem not_irrelevant_le_span_singleton {d : ℕ} {f : MvPolynomial (Fin 2) k}
    (hf : f.IsHomogeneous d) (hirr : Irreducible f) :
    ¬ (HomogeneousIdeal.irrelevant (grading k)).toIdeal ≤ Ideal.span {f} := by
  intro hle
  obtain ⟨h0, h1⟩ := toIdeal_irrelevant_le_iff.mp hle
  rw [Ideal.mem_span_singleton] at h0 h1
  have hdu : IsUnit (dehomogenize k f) :=
    isUnit_of_dvd_one (by simpa using map_dvd (dehomogenize k) h1)
  obtain ⟨c, -, hnf⟩ := exists_eq_X_one_pow_mul_C_of_isUnit_dehomogenize hf hdu
  obtain ⟨w, hw⟩ := h0
  have hdpos : 0 < d := pos_of_irreducible hf hirr
  have hev : MvPolynomial.eval (fun i : Fin 2 => if i = 0 then (1 : k) else 0) f = 0 := by
    rw [hnf]
    simp [zero_pow hdpos.ne']
  have h := congrArg (MvPolynomial.eval (fun i : Fin 2 => if i = 0 then (1 : k) else 0)) hw
  rw [MvPolynomial.eval_mul, hev, zero_mul] at h
  simp at h

end Stacks.ProjectiveLine

