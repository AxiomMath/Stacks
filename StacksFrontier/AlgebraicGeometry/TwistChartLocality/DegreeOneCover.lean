module

public import StacksFrontier.AlgebraicGeometry.ProjPolyChart.Away
public import StacksFrontier.AlgebraicGeometry.ProjPolyChart.Cover
public import StacksFrontier.AlgebraicGeometry.TwistChartLocality.BaseChange

/-!
# The twist comparison, reduced to the standard charts of degree one

`Stacks.AlgebraicGeometry.TwistChartLocality.isIso_projTwistComparison_of_forall_restrict`
reduces invertibility of Tag 01MY's comparison map to its restrictions to the standard opens
`D₊(ψ f)` with `f` homogeneous of **positive** degree. That hypothesis is stronger than it needs
to be, and stronger than the chart-level algebra can supply: the chart module `𝒜(n)₍f₎` is free of
rank one only when `deg f = 1`, as
`StacksFrontier/AlgebraicGeometry/TwistChartLocality/DegreeOneFree.lean` records with a witness. This
file gives the reduction whose cover uses only elements of `𝒜 1`.

What makes the smaller family a cover is a containment of ideals rather than a hypothesis on `ψ`:
if the irrelevant ideal of `ℬ` lies in the ideal generated by `ψ (𝒜 1)`, then a homogeneous prime
of `ℬ` omitting the irrelevant ideal must omit `ψ f` for some `f ∈ 𝒜 1`. For a change of
coefficient ring of a polynomial algebra the containment holds, and holds for the reason that the
coordinate variables are themselves images of degree-one elements.

## Main results

* `Stacks.AlgebraicGeometry.TwistChartLocality.exists_mem_degreeOne_notMem`: **the cover.** Under
  the containment, every point of `Proj ℬ` lies in `D₊(ψ f)` for some `f ∈ 𝒜 1`.
* `Stacks.AlgebraicGeometry.TwistChartLocality.isIso_projTwistComparison_of_forall_restrict_one`:
  **the reduction to the degree-one standard charts.**
* `Stacks.AlgebraicGeometry.TwistChartLocality.irrelevant_le_span_image_degreeOne_poly`: the
  containment, for a change of coefficient ring of a polynomial algebra.
* `Stacks.AlgebraicGeometry.TwistChartLocality.hasPolyTwistTransport_of_forall_restrict_one`:
  **the carried hypothesis of the twist transport, reduced to the degree-one standard charts.**
  This is the form in which the remaining obligation of
  `Stacks.ProjectiveCohomology.HasPolyTwistTransport` should be attacked, the chart algebra at a
  degree-one element being available.

## What this does not prove

Tag 01N2's twist assertion is not proved and **no project tag attribute is attached.** The
hypothesis of each reduction below is strictly stronger than its conclusion; what is gained over
`isIso_projTwistComparison_of_forall_restrict` is only that the hypothesis is quantified over a
family on which the chart-level algebra is available.

## Implementation notes

The containment is stated on `HomogeneousIdeal.toIdeal` rather than on the homogeneous ideals,
because `Ideal.span` of a set of ring elements is not homogeneous on the nose and the consumer —
`AlgebraicGeometry.ProjectiveSpectrum.not_irrelevant_le` — is a statement about homogeneous
ideals that `HomogeneousIdeal.toIdeal_le_toIdeal_iff` converts.

## References

* [Stacks Project, Tag 01MY](https://stacks.math.columbia.edu/tag/01MY)
* [Stacks Project, Tag 01N2](https://stacks.math.columbia.edu/tag/01N2)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory HomogeneousIdeal

namespace Stacks.AlgebraicGeometry.TwistChartLocality

attribute [local implicit_reducible] TopCat.Sheaf sheafCompose AlgebraicGeometry.Proj
attribute [local instance] ProjectiveSpectrum.isPrime
attribute [local instance_reducible] ProjectiveSpectrum.top
attribute [local instance] MvPolynomial.gradedAlgebra

universe u

/-! ### The degree-one cover -/

section Cover

variable {A B : Type u} {σ τ : Type u}
  [CommRing A] [CommRing B] [SetLike σ A] [AddSubgroupClass σ A]
  [SetLike τ B] [AddSubgroupClass τ B]
  (𝒜 : ℕ → σ) (ℬ : ℕ → τ) [GradedRing 𝒜] [GradedRing ℬ]

omit [AddSubgroupClass σ A] [GradedRing 𝒜] in
/-- **The standard opens of the images of degree-one elements cover `Proj ℬ`**, as soon as the
irrelevant ideal of `ℬ` lies in the ideal generated by `ψ (𝒜 1)`.

A point of `Proj ℬ` is a homogeneous prime not containing the irrelevant ideal. If it contained
`ψ f` for every `f ∈ 𝒜 1` it would contain the ideal they generate, hence the irrelevant ideal,
which is what it does not do. -/
public theorem exists_mem_degreeOne_notMem (ψ : 𝒜 →+*ᵍ ℬ)
    (hone : (HomogeneousIdeal.irrelevant ℬ).toIdeal ≤ Ideal.span (ψ '' (𝒜 1 : Set A)))
    (y : AlgebraicGeometry.Proj ℬ) :
    ∃ f : A, f ∈ 𝒜 1 ∧ ψ f ∉ y.asHomogeneousIdeal := by
  by_contra hcon
  simp only [not_exists, not_and, not_not] at hcon
  refine y.not_irrelevant_le
    (show (HomogeneousIdeal.irrelevant ℬ).toIdeal ≤ y.asHomogeneousIdeal.toIdeal from
      hone.trans (Ideal.span_le.mpr ?_))
  rintro _ ⟨f, hf, rfl⟩
  exact hcon f hf

/-- **The reduction to the degree-one standard charts.** Let `ψ : 𝒜 →+*ᵍ ℬ` be a graded ring
homomorphism whose irrelevant-ideal image generates the irrelevant ideal of `ℬ` already in degree
one. If the restriction of the comparison map
`Stacks.ProjTwistComparison.twistMap` to `D₊(ψ f)` is an isomorphism for every `f ∈ 𝒜 1`, then the
comparison map is an isomorphism.

This is `isIso_projTwistComparison_of_forall_restrict` with the cover cut down from all
homogeneous elements of positive degree to the degree-one ones, which is what the chart-level
algebra needs. -/
public theorem isIso_projTwistComparison_of_forall_restrict_one (ψ : 𝒜 →+*ᵍ ℬ)
    (hψ : ℬ₊ ≤ 𝒜₊.map ψ)
    (hone : (HomogeneousIdeal.irrelevant ℬ).toIdeal ≤ Ideal.span (ψ '' (𝒜 1 : Set A))) (n : ℤ)
    (h : ∀ f : A, f ∈ 𝒜 1 →
      IsIso ((Scheme.Modules.restrictFunctor (AlgebraicGeometry.Proj.basicOpen ℬ (ψ f)).ι).map
        (Stacks.ProjTwistComparison.twistMap ψ hψ n))) :
    IsIso (Stacks.ProjTwistComparison.twistMap ψ hψ n) := by
  refine ProjTwistMono.isIso_of_isIso_restrict_locally _ fun y => ?_
  obtain ⟨f, hf, hfy⟩ := exists_mem_degreeOne_notMem 𝒜 ℬ ψ hone y
  exact ⟨AlgebraicGeometry.Proj.basicOpen ℬ (ψ f),
    (AlgebraicGeometry.Proj.mem_basicOpen ℬ _ _).mpr hfy, h f hf⟩

end Cover

/-! ### The polynomial case -/

section Poly

open Stacks.ProjectiveCohomology

variable (R S : Type u) [CommRing R] [CommRing S] (n : ℕ)

/-- **The containment holds for a change of coefficient ring of a polynomial algebra.** The
irrelevant ideal of `S[T₀, …, Tₙ]` is generated by the coordinate variables, and each of those is
the image of the corresponding variable of `R[T₀, …, Tₙ]`, which is homogeneous of degree one. -/
public theorem irrelevant_le_span_image_degreeOne_poly (φ : R →+* S) :
    (HomogeneousIdeal.irrelevant (polyGrading S n)).toIdeal ≤
      Ideal.span (polyGradedMap (Fin (n + 1)) φ '' ((polyGrading R n 1 : Set _))) := by
  refine (ProjPolyChart.irrelevant_le_span_X S n).trans (Ideal.span_mono ?_)
  rintro _ ⟨i, rfl⟩
  exact ⟨MvPolynomial.X i, ProjPolyChart.X_mem_one R n i, MvPolynomial.map_X φ i⟩

/-- **The carried hypothesis of the twist transport, reduced to the degree-one standard charts.**

If for every degree `d` and every `f` homogeneous of degree one in `ℤ[T₀, …, Tₙ]` the restriction
of Tag 01MY's comparison map to `D₊(ψ f)` is an isomorphism, then
`Stacks.ProjectiveCohomology.HasPolyTwistTransport` holds — and with it the module half of Tag
01OE, the unkeyed six-way equivalence of Tag 01VT, and the four tags hanging off those.

The chart-level input this leaves is exactly the one for which
`Stacks.AlgebraicGeometry.TwistChartDegreeOne.isIso_of_tmul_eq_twistDegreeZeroMap` supplies the
algebra. -/
public theorem hasPolyTwistTransport_of_forall_restrict_one
    (h : ∀ (d : ℤ) (f : MvPolynomial (Fin (n + 1)) (ULift.{u} ℤ)),
      f ∈ polyGrading (ULift.{u} ℤ) n 1 →
      IsIso ((Scheme.Modules.restrictFunctor
          (AlgebraicGeometry.Proj.basicOpen (polyGrading S n)
            (polyGradedMap (Fin (n + 1)) (fromULiftInt S) f)).ι).map
        (Stacks.ProjTwistComparison.twistMap (polyGradedMap (Fin (n + 1)) (fromULiftInt S))
          (irrelevant_le_map_polyGradedMap (Fin (n + 1)) (fromULiftInt S)) d))) :
    HasPolyTwistTransport S n :=
  hasPolyTwistTransport_of_isIso_twistMap S n fun d =>
    isIso_projTwistComparison_of_forall_restrict_one (polyGrading (ULift.{u} ℤ) n)
      (polyGrading S n) (polyGradedMap (Fin (n + 1)) (fromULiftInt S))
      (irrelevant_le_map_polyGradedMap (Fin (n + 1)) (fromULiftInt S))
      (irrelevant_le_span_image_degreeOne_poly (ULift.{u} ℤ) S n (fromULiftInt S)) d (h d)

end Poly

end Stacks.AlgebraicGeometry.TwistChartLocality

end
