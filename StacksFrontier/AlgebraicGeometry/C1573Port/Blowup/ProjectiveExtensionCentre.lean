module

public import StacksFrontier.AlgebraicGeometry.C1573Port.Blowup.ProjectiveExtension
public import StacksFrontier.RingTheory.C1573Port.Flat.ColonBaseChange

namespace Stacks.ProjectiveExtension.C1573
end Stacks.ProjectiveExtension.C1573

/-!
# Resolving a rational map to projective space by an explicit blowup centre

Let `V` be an affine scheme with ring of global functions `R`, let `U ⊆ V` be the open
complement of the zero locus of an ideal `I ⊆ R`, and let `g₀, …, gₘ` be regular functions on
`U` spanning the unit ideal, so that they define a morphism `[g₀ : ⋯ : gₘ] : U ⟶ ℙᵐ`. Write
`ρ : R ⟶ Γ(V, U)` for restriction. Choose `c ≥ 1` such that `Iᶜ` kills the kernel of `ρ`, and
`n` such that every `a gₗ`, `a ∈ Iⁿ`, lies in the image of `ρ`. The *centre*

`𝒥 = span { e r : e ∈ Iᶜ, ρ r ∈ ρ(Iⁿ) gₗ }`

is an ideal of `R` with zero locus `V ∖ U`, and the main result of this file says that the
rational map `[g₀ : ⋯ : gₘ]` extends to every scheme `Q ⟶ V` along which `𝒥` pulls back to an
effective Cartier divisor. In particular it extends to the blowup of `V` in `𝒥`.

## Main definitions

* `Stacks.ProjectiveExtension.C1573.coordIdeal`: the ideal `ρ⁻¹(ρ(Iⁿ) gₗ)` of `R`.
* `Stacks.ProjectiveExtension.C1573.centre`: the centre `𝒥`.

## Main results

* `Stacks.ProjectiveExtension.C1573.exists_centreGens_of_map_eq_span`: if `𝒥` becomes principal,
  generated by a regular element `t`, then locally `t` is (up to a unit) the image of one of the
  generators `e r` of `𝒥`.
* `Stacks.ProjectiveExtension.C1573.exists_hom_projectiveSpace_of_isEffectiveCartierDivisor`: the
  extension statement.

## References

* [Stacks Project, Tag 01RH](https://stacks.math.columbia.edu/tag/01RH)
* [Stacks Project, Tag 0806](https://stacks.math.columbia.edu/tag/0806)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite TopologicalSpace

universe u

namespace Stacks.ProjectiveExtension

/-! ### The centre, as an ideal of a ring -/

section Ring

open _root_.Stacks.ProjectiveExtension.C1573
variable {R K : Type u} [CommRing R] [CommRing K] (ρ : R →+* K) (I : Ideal R)
  {m : ℕ} (g : Fin (m + 1) → K)

/-- The common denominators of the `gₗ` in `I`: the elements `a ∈ I` with `ρ a · gₗ` in the
image of `ρ` for every `l`. -/
def C1573.denomIdeal : Ideal R where
  carrier := {a | a ∈ I ∧ ∀ l, ∃ b, ρ b = ρ a * g l}
  add_mem' := by
    rintro a a' ⟨ha, hb⟩ ⟨ha', hb'⟩
    refine ⟨add_mem ha ha', fun l => ?_⟩
    obtain ⟨b, hb⟩ := hb l
    obtain ⟨b', hb'⟩ := hb' l
    exact ⟨b + b', by rw [map_add, map_add, hb, hb', add_mul]⟩
  zero_mem' := ⟨zero_mem _, fun l => ⟨0, by simp⟩⟩
  smul_mem' := by
    rintro x a ⟨ha, hb⟩
    refine ⟨Ideal.mul_mem_left _ _ ha, fun l => ?_⟩
    obtain ⟨b, hb⟩ := hb l
    exact ⟨x * b, by rw [smul_eq_mul, map_mul, map_mul, hb, mul_assoc]⟩

/-- The denominators of `gₗ`: the elements `a` with `ρ a · gₗ` in the image of `ρ`. -/
def C1573.colonIdeal (l : Fin (m + 1)) : Ideal R where
  carrier := {a | ∃ b, ρ b = ρ a * g l}
  add_mem' := by
    rintro a a' ⟨b, hb⟩ ⟨b', hb'⟩
    exact ⟨b + b', by rw [map_add, map_add, hb, hb', add_mul]⟩
  zero_mem' := ⟨0, by simp⟩
  smul_mem' := by
    rintro x a ⟨b, hb⟩
    exact ⟨x * b, by rw [smul_eq_mul, map_mul, map_mul, hb, mul_assoc]⟩

/-- The ideal of denominators used for the centre: `I · ∏ₗ (ρ R : gₗ)`. -/
def C1573.denom : Ideal R := I * ∏ l, colonIdeal ρ g l

/-- Every element of `denom ρ I g` is a common denominator in `I`. -/
theorem C1573.denom_le : denom ρ I g ≤ denomIdeal ρ I g := by
  refine Ideal.mul_le.2 fun e he p hp => ⟨Ideal.mul_mem_right _ _ he, fun l => ?_⟩
  obtain ⟨b, hb⟩ : p ∈ colonIdeal ρ g l :=
    (Ideal.prod_le_inf.trans (Finset.inf_le (Finset.mem_univ l))) hp
  exact ⟨e * b, by rw [map_mul, map_mul, hb, mul_assoc]⟩

/-- The ideal of the elements `r` with `ρ r = ρ a · gₗ` for a common denominator `a`. -/
def C1573.coordIdeal (l : Fin (m + 1)) : Ideal R where
  carrier := {r | ∃ a ∈ denom ρ I g, ρ r = ρ a * g l}
  add_mem' := by
    rintro r s ⟨a, ha, hr⟩ ⟨b, hb, hs⟩
    exact ⟨a + b, add_mem ha hb, by rw [map_add, map_add, hr, hs, add_mul]⟩
  zero_mem' := ⟨0, zero_mem _, by simp⟩
  smul_mem' := by
    rintro x r ⟨a, ha, hr⟩
    exact ⟨x * a, Ideal.mul_mem_left _ _ ha, by
      rw [smul_eq_mul, map_mul, map_mul, hr, mul_assoc]⟩

/-- The generators `e r`, `e ∈ I`, `r ∈ coordIdeal ρ I g l`, of the centre. -/
def C1573.centreGens : Set R := {y | ∃ e ∈ I, ∃ l, ∃ r ∈ coordIdeal ρ I g l, y = e * r}

/-- **The centre** `𝒥 = I · ∑ₗ coordIdeal ρ I g l`, as the ideal generated by the products. -/
def C1573.centre : Ideal R := Ideal.span (centreGens ρ I g)

/-- For `e ∈ I` and `r ∈ coordIdeal ρ I g l`, the product `e * r` lies in the centre. -/
theorem C1573.mem_centre {e r : R} (he : e ∈ I) {l : Fin (m + 1)} (hr : r ∈ coordIdeal ρ I g l) :
    e * r ∈ centre ρ I g :=
  Ideal.subset_span ⟨e, he, l, r, hr, rfl⟩

/-- The centre lies in `I`. -/
theorem C1573.centre_le : centre ρ I g ≤ I := by
  rw [centre, Ideal.span_le]
  rintro _ ⟨e, he, l, r, -, rfl⟩
  exact Ideal.mul_mem_right _ _ he

/-- **A local generator of the centre among its generators.** If the centre becomes principal
under a ring map `θ : R ⟶ A`, generated by a regular element `t`, then there are finitely many
generators `yᵢ` of the centre and elements `dᵢ ∈ A` spanning the unit ideal with
`θ yᵢ = t dᵢ`. On the locus where `dᵢ` is invertible, `θ yᵢ` generates the extended centre. -/
theorem C1573.exists_centreGens_of_map_eq_span {A : Type u} [CommRing A] (θ : R →+* A) (t : A)
    (ht : IsRegular t) (h : (centre ρ I g).map θ = Ideal.span {t}) :
    ∃ (k : ℕ) (y : Fin k → R) (d : Fin k → A), (∀ i, y i ∈ centreGens ρ I g) ∧
      (∀ i, θ (y i) = t * d i) ∧ Ideal.span (Set.range d) = ⊤ := by
  classical
  have htmem : t ∈ (centre ρ I g).map θ := h ▸ Ideal.mem_span_singleton_self t
  rw [centre, Ideal.map_span] at htmem
  obtain ⟨k, f, y', hsum⟩ := Submodule.mem_span_set'.1 htmem
  choose y hyG hy using fun i => (y' i).2
  have hdiv : ∀ i, ∃ d, θ (y i) = t * d := by
    intro i
    have hmem : θ (y i) ∈ (centre ρ I g).map θ :=
      Ideal.mem_map_of_mem _ (Ideal.subset_span (hyG i))
    rw [h, Ideal.mem_span_singleton'] at hmem
    obtain ⟨d, hd⟩ := hmem
    exact ⟨d, by rw [← hd, mul_comm]⟩
  choose d hd using hdiv
  refine ⟨k, y, d, hyG, hd, ?_⟩
  have hone : ∑ i, f i * d i = 1 := by
    apply ht.1
    change t * _ = t * 1
    rw [mul_one, Finset.mul_sum]
    conv_rhs => rw [← hsum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [smul_eq_mul, ← hy i, hd i]
    ring
  refine Ideal.eq_top_of_isUnit_mem _ ?_ isUnit_one
  rw [← hone]
  exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)

/-- **The ratios on a chart where the centre is principal.** Let `θ : R ⟶ A` and
`σ : A ⟶ B`, `τ : K ⟶ B` be ring maps with `σ ∘ θ = τ ∘ ρ`. If the centre extends to the
principal ideal `(t)` of `A`, `t` regular, and `σ t` is a unit of `B`, then there are finitely
many `dᵢ ∈ A` spanning the unit ideal such that for each `i` some index `l` has the following
property: for every `l'` there is `f ∈ A` with `σ dᵢ · τ gₗ' = σ f · τ gₗ`.

Read geometrically: `A` is the ring of an affine open `O` of a scheme over `Spec R`, `B` that of
`O ⊓ W` where `W` is the preimage of `U`, and on the basic open `D(dᵢ)` the ratios
`gₗ' / gₗ = f / dᵢ` are regular. -/
theorem C1573.exists_ratios_of_map_centre_eq_span {A B : Type u} [CommRing A] [CommRing B]
    (θ : R →+* A) (σ : A →+* B) (τ : K →+* B) (hστ : σ.comp θ = τ.comp ρ) (t : A)
    (ht : IsRegular t) (htB : IsUnit (σ t)) (h : (centre ρ I g).map θ = Ideal.span {t}) :
    ∃ (k : ℕ) (d : Fin k → A), Ideal.span (Set.range d) = ⊤ ∧
      ∀ i, ∃ l, ∀ l', ∃ f : A, σ (d i) * τ (g l') = σ f * τ (g l) := by
  obtain ⟨k, y, d, hyG, hyd, hd⟩ := exists_centreGens_of_map_eq_span ρ I g θ t ht h
  refine ⟨k, d, hd, fun i => ?_⟩
  obtain ⟨e, he, l, r, ⟨a, ha, hr⟩, hy⟩ := hyG i
  refine ⟨l, fun l' => ?_⟩
  obtain ⟨b, hb⟩ := (denom_le ρ I g ha).2 l'
  have hmem : θ (e * b) ∈ Ideal.span {t} := by
    rw [← h]
    exact Ideal.mem_map_of_mem _ (mem_centre ρ I g he ⟨a, ha, hb⟩)
  obtain ⟨f, hf⟩ := Ideal.mem_span_singleton'.1 hmem
  refine ⟨f, ?_⟩
  have hστ' : ∀ z, σ (θ z) = τ (ρ z) := fun z => RingHom.congr_fun hστ z
  -- both sides become equal after multiplying by the unit `σ t`
  apply htB.mul_left_cancel
  have h1 : σ t * σ f = τ (ρ e) * τ (ρ a) * τ (g l') := by
    rw [← map_mul, mul_comm t, hf, hστ', map_mul, map_mul, hb, map_mul, mul_assoc]
  have h2 : σ t * σ (d i) = τ (ρ e) * τ (ρ a) * τ (g l) := by
    rw [← map_mul, ← hyd i, hστ', hy, map_mul, map_mul, hr, map_mul, mul_assoc]
  linear_combination τ (g l') * h2 - τ (g l) * h1

/-- The colon ideal `(ρ R : gₗ)` as a colon ideal of submodules. -/
theorem C1573.colonIdeal_eq_colon [Algebra R K] (g : Fin (m + 1) → K) (l : Fin (m + 1)) :
    colonIdeal (algebraMap R K) g l =
      (LinearMap.range (Algebra.linearMap R K)).colon {g l} := by
  ext a
  rw [Submodule.mem_colon_singleton]
  constructor
  · rintro ⟨b, hb⟩
    exact ⟨b, by rw [Algebra.linearMap_apply, hb, Algebra.smul_def]⟩
  · rintro ⟨b, hb⟩
    exact ⟨b, by rw [← Algebra.smul_def, ← hb]; rfl⟩

/-- The kernel of `ρ` as a colon ideal of submodules. -/
theorem C1573.ker_eq_colon [Algebra R K] :
    RingHom.ker (algebraMap R K) = (⊥ : Submodule R K).colon {1} := by
  ext a
  rw [Submodule.mem_colon_singleton, Submodule.mem_bot, RingHom.mem_ker, Algebra.smul_def,
    mul_one]

end Ring

section BaseChange

open _root_.Stacks.ProjectiveExtension.C1573
variable {R K R' K' : Type u} [CommRing R] [CommRing K] [CommRing R'] [CommRing K']
  [Algebra R K] [Algebra R R'] [Algebra R' K'] [Algebra R K'] [Algebra K K']
  [IsScalarTower R R' K'] [IsScalarTower R K K'] [Module.Flat R R']
  (hbc : IsBaseChange R' (IsScalarTower.toAlgHom R K K').toLinearMap)
  (I : Ideal R) {m : ℕ} (g : Fin (m + 1) → K)

omit [Module.Flat R R'] in
/-- The `R'`-span of the image of `ρ R` is `ρ' R'`. -/
theorem C1573.span_image_range_algebraMap :
    Submodule.span R' ((IsScalarTower.toAlgHom R K K').toLinearMap ''
        (LinearMap.range (Algebra.linearMap R K) : Set K)) =
      LinearMap.range (Algebra.linearMap R' K') := by
  apply le_antisymm
  · rw [Submodule.span_le]
    rintro _ ⟨_, ⟨r, rfl⟩, rfl⟩
    refine ⟨algebraMap R R' r, ?_⟩
    simp [← IsScalarTower.algebraMap_apply]
  · rintro _ ⟨r', rfl⟩
    have h1 : (1 : K') ∈ (IsScalarTower.toAlgHom R K K').toLinearMap ''
        (LinearMap.range (Algebra.linearMap R K) : Set K) :=
      ⟨1, ⟨1, by simp⟩, by simp⟩
    simpa [Algebra.smul_def] using Submodule.smul_mem _ r' (Submodule.subset_span h1)

include hbc in
/-- **The colon ideals of the `gₗ` commute with flat base change.** -/
theorem C1573.map_colonIdeal (l : Fin (m + 1)) :
    (colonIdeal (algebraMap R K) g l).map (algebraMap R R') =
      colonIdeal (algebraMap R' K') (fun j => algebraMap K K' (g j)) l := by
  rw [colonIdeal_eq_colon, colonIdeal_eq_colon,
    Ideal.C1573.map_colon_singleton_of_isBaseChange hbc, span_image_range_algebraMap]
  rfl

include hbc in
/-- **The kernel of `ρ` commutes with flat base change.** -/
theorem C1573.map_ker_algebraMap :
    (RingHom.ker (algebraMap R K)).map (algebraMap R R') = RingHom.ker (algebraMap R' K') := by
  rw [ker_eq_colon, ker_eq_colon, Ideal.C1573.map_colon_singleton_of_isBaseChange hbc]
  simp

include hbc in
/-- **The denominator ideal commutes with flat base change.** -/
theorem C1573.map_denom :
    (denom (algebraMap R K) I g).map (algebraMap R R') =
      denom (algebraMap R' K') (I.map (algebraMap R R')) (fun j => algebraMap K K' (g j)) := by
  rw [denom, denom, Ideal.map_mul]
  congr 1
  change Ideal.mapHom (algebraMap R R') _ = _
  rw [map_prod]
  exact Finset.prod_congr rfl fun l _ => map_colonIdeal hbc g l

include hbc in
/-- **The centre of a rational map commutes with flat base change.** -/
theorem C1573.map_centre :
    (centre (algebraMap R K) I g).map (algebraMap R R') =
      centre (algebraMap R' K') (I.map (algebraMap R R')) (fun j => algebraMap K K' (g j)) := by
  set g' : Fin (m + 1) → K' := fun j => algebraMap K K' (g j)
  have hcomm : ∀ r : R, algebraMap R' K' (algebraMap R R' r) =
      algebraMap K K' (algebraMap R K r) := fun r => by
    rw [← IsScalarTower.algebraMap_apply, ← IsScalarTower.algebraMap_apply]
  -- the coordinate ideals extend into the coordinate ideals
  have hcoord_le : ∀ l, (coordIdeal (algebraMap R K) I g l).map (algebraMap R R') ≤
      coordIdeal (algebraMap R' K') (I.map (algebraMap R R')) g' l := by
    intro l
    rw [Ideal.map_le_iff_le_comap]
    rintro r ⟨a, ha, hr⟩
    refine ⟨algebraMap R R' a, ?_, ?_⟩
    · rw [← map_denom hbc]
      exact Ideal.mem_map_of_mem _ ha
    · rw [hcomm, hcomm, hr, map_mul]
  -- and conversely, by the base change of the denominators and of the kernel
  have hle_coord : ∀ l, coordIdeal (algebraMap R' K') (I.map (algebraMap R R')) g' l ≤
      (coordIdeal (algebraMap R K) I g l).map (algebraMap R R') := by
    intro l r' ⟨a', ha', hr'⟩
    rw [← map_denom hbc, Ideal.map, Submodule.mem_span_set'] at ha'
    obtain ⟨k, c, a, ha⟩ := ha'
    choose a₀ ha₀ hcoe using fun i => (a i).2
    choose b hb using fun i => (denom_le (algebraMap R K) I g (ha₀ i)).2 l
    have hbmem : ∀ i, b i ∈ coordIdeal (algebraMap R K) I g l := fun i => ⟨a₀ i, ha₀ i, hb i⟩
    have hker : r' - ∑ i, c i * algebraMap R R' (b i) ∈ RingHom.ker (algebraMap R' K') := by
      rw [RingHom.mem_ker, map_sub, hr', ← ha, map_sum, map_sum, Finset.sum_mul, sub_eq_zero]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [smul_eq_mul, map_mul, map_mul, ← hcoe i, hcomm, hcomm, hb i, map_mul, mul_assoc]
    rw [← map_ker_algebraMap hbc] at hker
    have hkle : RingHom.ker (algebraMap R K) ≤ coordIdeal (algebraMap R K) I g l :=
      fun r hr => ⟨0, zero_mem _, by rw [RingHom.mem_ker.1 hr, map_zero, zero_mul]⟩
    have h2 : ∑ i, c i * algebraMap R R' (b i) ∈
        (coordIdeal (algebraMap R K) I g l).map (algebraMap R R') :=
      Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ _ (Ideal.mem_map_of_mem _ (hbmem i))
    simpa using add_mem (Ideal.map_mono (f := algebraMap R R') hkle hker) h2
  apply le_antisymm
  · rw [Ideal.map_le_iff_le_comap, centre, Ideal.span_le]
    rintro _ ⟨e, he, l, r, hr, rfl⟩
    rw [SetLike.mem_coe, Ideal.mem_comap, map_mul]
    exact mem_centre _ _ _ (Ideal.mem_map_of_mem _ he) (hcoord_le l (Ideal.mem_map_of_mem _ hr))
  · rw [centre, Ideal.span_le]
    rintro _ ⟨e', he', l, r', hr', rfl⟩
    have hmul : e' * r' ∈ (I * coordIdeal (algebraMap R K) I g l).map (algebraMap R R') := by
      rw [Ideal.map_mul]
      exact Ideal.mul_mem_mul he' (hle_coord l hr')
    exact Ideal.map_mono (Ideal.mul_le.2 fun e he r hr => mem_centre _ _ _ he hr) hmul

end BaseChange

section Ring

open _root_.Stacks.ProjectiveExtension.C1573
variable {R K : Type u} [CommRing R] [CommRing K] (ρ : R →+* K) (I : Ideal R)
  {m : ℕ} (g : Fin (m + 1) → K)

end Ring

/-! ### Extending the rational map -/

section Scheme

open _root_.Stacks.ProjectiveExtension.C1573
variable {V Q : Scheme.{u}} [IsAffine V] (U : V.Opens) (I : Ideal Γ(V, ⊤)) {m : ℕ}
  (g : Fin (m + 1) → Γ(V, U))

/-- Restriction of global functions of `V` to the open `U`. -/
abbrev C1573.restr : Γ(V, ⊤) →+* Γ(V, U) := (V.presheaf.map (homOfLE le_top).op).hom

/-- **The centre of the rational map `[g₀ : ⋯ : gₘ]` on `V`**, as an ideal sheaf on `V`. -/
def C1573.centreSheaf : V.IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop (centre (restr U) I g)

/-- A section restricted to an open contained in its basic open is a unit. -/
theorem C1573.isUnit_map_of_le_basicOpen {X : Scheme.{u}} {O O' : X.Opens} (t : Γ(X, O))
    (h : O' ≤ X.basicOpen t) :
    IsUnit (X.presheaf.map (homOfLE (h.trans (X.basicOpen_le t))).op t) := by
  refine X.toRingedSpace.isUnit_of_isUnit_germ O' _ fun x hx => ?_
  have hxO : x ∈ O := X.basicOpen_le t (h hx)
  have hg := (X.mem_basicOpen t x hxO).1 (h hx)
  convert hg using 1
  exact X.presheaf.germ_res_apply _ _ _ _

/-- Restricting a section twice is restricting it once. -/
theorem C1573.presheaf_map_map {X : Scheme.{u}} {A B C : X.Opens} (h₁ : A ≤ B) (h₂ : B ≤ C)
    (x : Γ(X, C)) :
    X.presheaf.map (homOfLE h₁).op (X.presheaf.map (homOfLE h₂).op x) =
      X.presheaf.map (homOfLE (h₁.trans h₂)).op x := by
  rw [← CommRingCat.comp_apply, ← Functor.map_comp]
  rfl

/-- Restricting the image of a section under `appLE` is `appLE` to the smaller open. -/
theorem C1573.presheaf_map_appLE {X Y : Scheme.{u}} (π : X ⟶ Y) {U : Y.Opens} {A B : X.Opens}
    (h₁ : A ≤ B) (h₂ : B ≤ π ⁻¹ᵁ U) (x : Γ(Y, U)) :
    X.presheaf.map (homOfLE h₁).op (π.appLE U B h₂ x) = π.appLE U A (h₁.trans h₂) x := by
  rw [← CommRingCat.comp_apply, Scheme.Hom.appLE_map]

/-- A point of `O` lies in a basic open of one of the sections generating the unit ideal. -/
private theorem exists_mem_basicOpen_of_span_eq_top {X : Scheme.{u}} {O : X.Opens}
    {s : Set Γ(X, O)} (hs : Ideal.span s = ⊤) {x : X} (hx : x ∈ O) :
    ∃ e ∈ s, x ∈ X.basicOpen e := by
  have hxcov : x ∈ ⨆ e ∈ s, X.basicOpen e := by
    rw [AlgebraicGeometry.iSup_basicOpen_of_span_eq_top O s hs]; exact hx
  simpa only [Opens.mem_iSup, exists_prop] using hxcov

open Stacks.SectionsToProjectiveSpace in
/-- **The rational map extends wherever the centre becomes an effective Cartier divisor.** Let
`π : Q ⟶ V` be a morphism to an affine scheme along which the centre of `[g₀ : ⋯ : gₘ]` pulls
back to an effective Cartier divisor which does not meet the preimage `W` of `U`, and suppose
`W` is scheme-theoretically dense in `Q`. Then the morphism `W ⟶ ℙᵐ` given by the pulled back
`gₗ` extends to a morphism `Q ⟶ ℙᵐ`. -/
theorem C1573.exists_hom_projectiveSpace_of_isEffectiveCartierDivisor (π : Q ⟶ V)
    (hW : (π ⁻¹ᵁ U).IsSchemeTheoreticallyDense)
    (hCart : Stacks.Divisors.IsEffectiveCartierDivisor ((centreSheaf U I g).comap π))
    (hdisj : ∀ x ∈ π ⁻¹ᵁ U, x ∉ ((centreSheaf U I g).comap π).support)
    (hg : Ideal.span (Set.range fun j => (π ⁻¹ᵁ U).topIso.inv (π.app U (g j))) = ⊤) :
    ∃ f : Q ⟶ projectiveSpaceAtUniverse.{u} m,
      (π ⁻¹ᵁ U).ι ≫ f = toProjectiveSpaceAtUniverse _ hg := by
  set W := π ⁻¹ᵁ U
  refine exists_hom_projectiveSpace_of_local' W hW (fun j => π.app U (g j)) hg fun x => ?_
  obtain ⟨O, hxO, -, t, ht, hOt⟩ :=
    Stacks.Blowup.exists_affineOpens_ideal_eq_span_le _ hCart x ⊤ trivial
  have hmap : (centre (restr U) I g).map (π.appLE ⊤ O le_top).hom = Ideal.span {t} := by
    rw [← hOt, Stacks.IdealSheaf.ideal_comap_appLE (centreSheaf U I g) π ⟨⊤, isAffineOpen_top V⟩ O
      le_top, centreSheaf, Scheme.IdealSheafData.ofIdealTop_ideal,
      show (homOfLE (le_top (a := (⊤ : V.Opens)))) = 𝟙 _ from rfl]
    simp
  let θ := (π.appLE ⊤ O le_top).hom
  let σ := (Q.presheaf.map (homOfLE (inf_le_left : (O : Q.Opens) ⊓ W ≤ O)).op).hom
  let τ := (π.appLE U ((O : Q.Opens) ⊓ W) inf_le_right).hom
  have hστ : σ.comp θ = τ.comp (restr U) := by
    ext z
    simp only [RingHom.comp_apply, θ, σ, τ, restr]
    rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, Scheme.Hom.map_appLE]
    exact congrArg (fun φ => φ z) (congrArg CommRingCat.Hom.hom
      (Scheme.Hom.appLE_map π (U := ⊤) (V := (O : Q.Opens)) (V' := (O : Q.Opens) ⊓ W) le_top
        (homOfLE inf_le_left).op))
  -- `t` is a unit on `O ⊓ W`, the centre being the unit ideal there
  have hle : (O : Q.Opens) ⊓ W ≤ Q.basicOpen t := by
    intro y hy
    have hy' : y ∉ ((centreSheaf U I g).comap π).support := hdisj y hy.2
    rw [Scheme.IdealSheafData.mem_support_iff_of_mem hy.1, hOt, Scheme.zeroLocus_span,
      Scheme.mem_zeroLocus_iff] at hy'
    push Not at hy'
    obtain ⟨f, hf, hyf⟩ := hy'
    rw [Set.mem_singleton_iff.1 hf] at hyf
    exact hyf
  have htB : IsUnit (σ t) := isUnit_map_of_le_basicOpen t hle
  obtain ⟨k, d, hd, hratio⟩ :=
    exists_ratios_of_map_centre_eq_span (restr U) I g θ σ τ hστ t ht htB hmap
  obtain ⟨_, ⟨i, rfl⟩, hxi⟩ := exists_mem_basicOpen_of_span_eq_top (O := (O : Q.Opens)) hd hxO
  obtain ⟨l, hl⟩ := hratio i
  choose f hf using hl
  set O' : Q.Opens := Q.basicOpen (d i)
  have hO'O : O' ≤ O := Q.basicOpen_le (d i)
  have hu : IsUnit (Q.presheaf.map (homOfLE hO'O).op (d i)) :=
    isUnit_map_of_le_basicOpen (d i) le_rfl
  classical
  refine ⟨O', hxi, l, fun l' => if l' = l then 1 else
    Q.presheaf.map (homOfLE hO'O).op (f l') * ↑(hu.unit⁻¹), by simp, fun l' => ?_⟩
  by_cases hll : l' = l
  · subst hll
    simp
  · simp only [hll, ite_false, map_mul]
    have hOW : O' ⊓ W ≤ (O : Q.Opens) ⊓ W := inf_le_inf_right _ hO'O
    have key := congrArg (Q.presheaf.map (homOfLE hOW).op) (hf l')
    simp only [map_mul, σ, τ, presheaf_map_map, presheaf_map_appLE] at key
    have hA : ∀ z : Γ(V, U), π.appLE U (O' ⊓ W) (hOW.trans inf_le_right) z =
        Q.presheaf.map (homOfLE (inf_le_right : O' ⊓ W ≤ W)).op (π.app U z) := by
      intro z
      rw [Scheme.Hom.app_eq_appLE, presheaf_map_appLE]
    rw [presheaf_map_map, ← hA, ← hA]
    have hD : Q.presheaf.map (homOfLE (hOW.trans inf_le_left)).op (d i) *
        Q.presheaf.map (homOfLE (inf_le_left : O' ⊓ W ≤ O')).op ↑(hu.unit⁻¹) = 1 := by
      rw [← presheaf_map_map (inf_le_left : O' ⊓ W ≤ O') hO'O, ← map_mul, hu.mul_val_inv,
        map_one]
    calc _ = Q.presheaf.map (homOfLE (inf_le_left : O' ⊓ W ≤ O')).op ↑(hu.unit⁻¹) *
          (Q.presheaf.map (homOfLE (hOW.trans inf_le_left)).op (f l') *
            π.appLE U (O' ⊓ W) (hOW.trans inf_le_right) (g l)) := by ring
      _ = Q.presheaf.map (homOfLE (inf_le_left : O' ⊓ W ≤ O')).op ↑(hu.unit⁻¹) *
          (Q.presheaf.map (homOfLE (hOW.trans inf_le_left)).op (d i) *
            π.appLE U (O' ⊓ W) (hOW.trans inf_le_right) (g l')) := by rw [key]
      _ = _ := by rw [← mul_assoc, mul_comm _ (Q.presheaf.map _ (d i)), hD, one_mul]

/-- **Clearing denominators on a quasi-compact open.** If `U ⊆ V` is quasi-compact and
quasi-separated and the basic open `D(f)` of a global function lies in `U`, then every regular
function `x` on `U` becomes, after multiplication by a power of `f`, the restriction of a global
function. -/
theorem C1573.exists_restr_eq_pow_mul (hU : IsCompact (U : Set V))
    (hU' : IsQuasiSeparated (U : Set V)) (f : Γ(V, ⊤)) (hf : V.basicOpen f ≤ U) (x : Γ(V, U)) :
    ∃ (N : ℕ) (b : Γ(V, ⊤)), restr U b = restr U f ^ N * x := by
  -- `Γ(V, D(f))` is the localization of `Γ(V, ⊤)` at `f`
  have hloc : IsLocalization.Away f Γ(V, V.basicOpen f) :=
    (isAffineOpen_top V).isLocalization_basicOpen f
  -- and also the localization of `Γ(V, U)` at the restriction of `f`
  have hbo : V.basicOpen (restr U f) = V.basicOpen f := by
    rw [restr, Scheme.basicOpen_res]
    exact inf_eq_right.2 hf
  have hloc' : IsLocalization.Away (restr U f) Γ(V, V.basicOpen (restr U f)) :=
    isLocalization_basicOpen_of_qcqs hU hU' (restr U f)
  -- the restriction of `x` to `D(f)` is a fraction `b / fᵏ`
  let y : Γ(V, V.basicOpen f) := V.presheaf.map (homOfLE hf).op x
  obtain ⟨⟨b, ⟨_, k, rfl⟩⟩, hb⟩ := IsLocalization.surj (Submonoid.powers f) y
  -- the difference `fᵏ x - b` vanishes on `D(f)`, hence is killed by a power of `f` on `U`
  have hzero : algebraMap Γ(V, U) Γ(V, V.basicOpen (restr U f)) (restr U f ^ k * x) =
      algebraMap Γ(V, U) Γ(V, V.basicOpen (restr U f)) (restr U b) := by
    have key := congrArg (V.presheaf.map (homOfLE hbo.le).op) hb
    simp only [RingHom.algebraMap_toAlgebra, map_mul, map_pow, y, presheaf_map_map] at key
    simp only [RingHom.algebraMap_toAlgebra, map_mul, map_pow, restr, presheaf_map_map]
    rw [mul_comm, key]
  obtain ⟨⟨_, M, rfl⟩, hM⟩ := IsLocalization.exists_of_eq (M := Submonoid.powers (restr U f)) hzero
  refine ⟨M + k, f ^ M * b, ?_⟩
  rw [map_mul, map_pow, ← hM, pow_add]
  ring

/-- **The centre does not meet `U`.** Let `U ⊆ V` be quasi-compact and quasi-separated and let
`I` be an ideal of global functions whose basic opens lie in `U` and cover it. If the `gₗ` span
the unit ideal of `Γ(V, U)`, then no point of `U` lies in the support of the centre. -/
theorem C1573.not_mem_support_centreSheaf (hU : IsCompact (U : Set V))
    (hU' : IsQuasiSeparated (U : Set V)) (hIle : ∀ f ∈ I, V.basicOpen f ≤ U)
    (hIU : ∀ x ∈ U, ∃ f ∈ I, x ∈ V.basicOpen f) (hg : Ideal.span (Set.range g) = ⊤)
    (x : V) (hx : x ∈ U) : x ∉ (centreSheaf U I g).support := by
  classical
  obtain ⟨f, hfI, hxf⟩ := hIU x hx
  choose N b hb using fun l => exists_restr_eq_pow_mul U hU hU' f (hIle f hfI) (g l)
  set K : ℕ := Finset.univ.sup N with hK
  have hNK : ∀ l, N l ≤ K := fun l => Finset.le_sup (f := N) (Finset.mem_univ l)
  set M : ℕ := 1 + K * (m + 1) with hM
  have hNM : ∀ l, N l ≤ M := fun l =>
    (hNK l).trans (by rw [hM]; nlinarith [Nat.zero_le K])
  have hpow : ∀ l n, N l ≤ n → restr U (f ^ (n - N l) * b l) = restr U f ^ n * g l := by
    intro l n hn
    rw [map_mul, hb l, map_pow, ← mul_assoc, ← pow_add, Nat.sub_add_cancel hn]
  -- `fᴹ = f · ∏ₗ fᴷ` is a denominator
  have hden : f ^ M ∈ denom (restr U) I g := by
    have hcol : ∀ l, f ^ K ∈ colonIdeal (restr U) g l := fun l =>
      ⟨f ^ (K - N l) * b l, by rw [hpow l K (hNK l), map_pow]⟩
    have hprod : ∏ _l : Fin (m + 1), f ^ K ∈ ∏ l, colonIdeal (restr U) g l :=
      Ideal.prod_mem_prod fun l _ => hcol l
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin, ← pow_mul] at hprod
    rw [hM, pow_add, pow_one]
    exact Ideal.mul_mem_mul hfI hprod
  -- the generators `f · bₗ'` of the centre
  have hy : ∀ l, f * (f ^ (M - N l) * b l) ∈ centre (restr U) I g := fun l =>
    mem_centre (restr U) I g hfI ⟨f ^ M, hden, by rw [hpow l M (hNM l), map_pow]⟩
  -- some `gₗ` does not vanish at `x`
  obtain ⟨_, ⟨l, rfl⟩, hxl⟩ := exists_mem_basicOpen_of_span_eq_top hg hx
  rw [centreSheaf, ← SetLike.mem_coe, Scheme.IdealSheafData.coe_support_ofIdealTop,
    Scheme.mem_zeroLocus_iff]
  push Not
  refine ⟨_, hy l, ?_⟩
  -- `x` lies in the basic open of `f · fᴹ⁻ᴺ · bₗ`, read on `U`
  have hres : restr U (f * (f ^ (M - N l) * b l)) = restr U f * (restr U f ^ M * g l) := by
    rw [map_mul, hpow l M (hNM l)]
  have hxU : x ∈ V.basicOpen (restr U (f * (f ^ (M - N l) * b l))) := by
    rw [hres, Scheme.basicOpen_mul, Scheme.basicOpen_mul, Scheme.basicOpen_pow _ _
      (by rw [hM]; omega)]
    have hxf' : x ∈ V.basicOpen (restr U f) := by
      rw [restr, Scheme.basicOpen_res]
      exact ⟨hx, hxf⟩
    exact ⟨hxf', hxf', hxl⟩
  rw [restr, Scheme.basicOpen_res] at hxU
  exact hxU.2

/-- **The support of the centre is the complement of `U`.** Under the hypotheses of
`Stacks.ProjectiveExtension.C1573.not_mem_support_centreSheaf`, a point lies in the support of the
centre exactly when it lies outside `U`. -/
theorem C1573.mem_support_centreSheaf_iff (hU : IsCompact (U : Set V))
    (hU' : IsQuasiSeparated (U : Set V)) (hIle : ∀ f ∈ I, V.basicOpen f ≤ U)
    (hIU : ∀ x ∈ U, ∃ f ∈ I, x ∈ V.basicOpen f) (hg : Ideal.span (Set.range g) = ⊤) (x : V) :
    x ∈ (centreSheaf U I g).support ↔ x ∉ U := by
  refine ⟨fun h hx => not_mem_support_centreSheaf U I g hU hU' hIle hIU hg x hx h, fun hx => ?_⟩
  rw [centreSheaf, ← SetLike.mem_coe, Scheme.IdealSheafData.coe_support_ofIdealTop,
    Scheme.mem_zeroLocus_iff]
  intro f hf hxf
  exact hx (hIle f (centre_le (restr U) I g hf) hxf)

open Stacks.SectionsToProjectiveSpace in
/-- **The rational map extends to every scheme on which its centre is Cartier.** Let `V` be
affine, let `U ⊆ V` be a quasi-compact and quasi-separated open covered by the basic opens of
the elements of an ideal `I` of global functions, each of which lies in `U`, and let the
`gₗ ∈ Γ(V, U)` span the unit ideal. For every morphism `π : Q ⟶ V` along which the centre of
`[g₀ : ⋯ : gₘ]` pulls back to an effective Cartier divisor, the morphism `π⁻¹(U) ⟶ ℙᵐ` given by
the pulled back `gₗ` extends to `Q`, and `π⁻¹(U)` is the complement of that divisor. -/
theorem C1573.exists_hom_projectiveSpace_of_isEffectiveCartierDivisor' (π : Q ⟶ V)
    (hU : IsCompact (U : Set V)) (hU' : IsQuasiSeparated (U : Set V))
    (hIle : ∀ f ∈ I, V.basicOpen f ≤ U) (hIU : ∀ x ∈ U, ∃ f ∈ I, x ∈ V.basicOpen f)
    (hg : Ideal.span (Set.range g) = ⊤)
    (hCart : Stacks.Divisors.IsEffectiveCartierDivisor ((centreSheaf U I g).comap π)) :
    (π ⁻¹ᵁ U) = ((centreSheaf U I g).comap π).support.compl ∧
    ∃ hg' : Ideal.span (Set.range fun j => (π ⁻¹ᵁ U).topIso.inv (π.app U (g j))) = ⊤,
    ∃ f : Q ⟶ projectiveSpaceAtUniverse.{u} m,
      (π ⁻¹ᵁ U).ι ≫ f = toProjectiveSpaceAtUniverse _ hg' := by
  have hW : (π ⁻¹ᵁ U) = ((centreSheaf U I g).comap π).support.compl := by
    ext y
    change π y ∈ U ↔ y ∉ ((centreSheaf U I g).comap π).support
    rw [Scheme.IdealSheafData.support_comap]
    change π y ∈ U ↔ ¬ π y ∈ (centreSheaf U I g).support
    rw [mem_support_centreSheaf_iff U I g hU hU' hIle hIU hg, not_not]
  have hg' : Ideal.span (Set.range fun j => (π ⁻¹ᵁ U).topIso.inv (π.app U (g j))) = ⊤ := by
    have : (Set.range fun j => (π ⁻¹ᵁ U).topIso.inv (π.app U (g j))) =
        (π.app U ≫ (π ⁻¹ᵁ U).topIso.inv).hom '' Set.range g := by
      rw [← Set.range_comp]; rfl
    rw [this, ← Ideal.map_span, hg, Ideal.map_top]
  refine ⟨hW, hg', exists_hom_projectiveSpace_of_isEffectiveCartierDivisor U I g π ?_ hCart ?_ hg'⟩
  · rw [hW]
    exact Stacks.Divisors.isSchemeTheoreticallyDense_compl_of_isEffectiveCartierDivisor _ hCart
  · intro y hy
    rwa [hW] at hy

end Scheme

