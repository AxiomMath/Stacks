module

public import Mathlib.CategoryTheory.Filtered.Basic
public import StacksFrontier.AlgebraicGeometry.Seminormalization.CandidatePresentation
public import StacksFrontier.AlgebraicGeometry.Seminormalization.CandidateTensor

/-!
# The index of the seminormalization diagram is filtered

For a commutative ring `A`, `Algebra.SeminormalizationIndex A` is the category of explicit
finite presentations of `A`-algebras whose structure morphism on spectra is a universal
homeomorphism inducing isomorphisms on all residue fields.  This file proves that this category
is filtered, which is the hypothesis under which the two filtered-colimit theorems
`AlgebraicGeometry.universalHomeomorphism_specMap_of_isColimit` and
`AlgebraicGeometry.isIso_residueFieldMap_specMap_of_colimitPresentation` apply to it.

## Main results

* `AlgebraicGeometry.isNilpotent_sub_of_universalHomeomorphism`: two `A`-algebra maps out of a
  universal homeomorphism over `A` differ by a nilpotent element at every argument.
* `AlgebraicGeometry.exists_cocone_objs_seminormalizationIndex`: two objects of the index have
  a common upper bound, namely a presentation of their tensor product over `A`.
* `AlgebraicGeometry.exists_cocone_maps_seminormalizationIndex`: two parallel maps of the index
  are equalized by a further map, namely a presentation of the quotient of the target by the
  differences of the two maps on a finite generating set of the source.
* `AlgebraicGeometry.seminormalizationIndex_isFiltered`: the index is filtered.

## Implementation notes

The two halves are genuinely different arguments.  The upper bound of two objects is the tensor
product `B ⊗[A] C`, which is finitely presented and again a universal homeomorphism over `A`
inducing isomorphisms on residue fields by base change; the result is turned back into an
object of the index by `AlgebraicGeometry.exists_seminormalizationIndex_algEquiv`.

For two parallel maps `f, g : B ⟶ C` the equalizing object is `C ⧸ I`, where `I` is generated by
the finitely many differences `f bᵢ - g bᵢ` over a finite generating set of `B` as an
`A`-algebra; such an `I` is finitely generated, so the quotient is again finitely presented, and
every element of `I` is nilpotent.  Nilpotency is where the geometry enters: `f` and `g` give two
sections of the projection `Spec (C ⊗[A] B) ⟶ Spec C`, which is injective on points because it
is a base change of a universal homeomorphism, so the two sections agree on points, and a prime
of `C` therefore contains every difference.  This argument cannot be replaced by a thinness
claim about the index: there are distinct parallel maps in it, for instance the two maps
`k[x]/x² → k[x]/x²` sending `x` to `x` and to `2x`.

Everything lives in a single universe `u`, as `AlgebraicGeometry.UniversalHomeomorphism` is
available only for `Scheme.{u}`.

No hypothesis beyond those of Tag 0EUS is used: `A` is an arbitrary commutative ring, with no
Noetherian or reducedness assumption.

## What is not done

The initial object of `AlgebraicGeometry.SeminormalizationCategory X` is *not* constructed here,
and nothing here asserts that it exists.  Nothing here is about schemes other than spectra of
rings.  In particular the instance
`CategoryTheory.Limits.HasInitial (AlgebraicGeometry.SeminormalizationCategory X)` assumed by
`StacksFrontier.AlgebraicGeometry.Morphisms.WeakNormalization.Functorial` and
`StacksFrontier.AlgebraicGeometry.Morphisms.WeakNormalization.SeminormalizationFunctorial` is
still unproved after this file, and so is the characterization of when the morphism out of it is
an isomorphism.

Terminality of `Algebra.seminormalization A` among all `A`-algebras with the two candidate
properties is not proved here either: that needs, in addition, the presentation of an arbitrary
such algebra as a filtered colimit of finitely presented ones (Tag 0EUJ), for which no
declaration exists in the Lean libraries of this repository.

## References

* [Stacks Project, Tag 0EUS](https://stacks.math.columbia.edu/tag/0EUS)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open scoped TensorProduct

universe u

namespace AlgebraicGeometry

variable (A B C : Type u) [CommRing A] [CommRing B] [CommRing C] [Algebra A B] [Algebra A C]

/-- The two `C`-algebra maps `C ⊗[A] B → C` extending a given `A`-algebra map `B → C` and the
identity of `C`. -/
private noncomputable def tensorSection (f : B →ₐ[A] C) : (C ⊗[A] B) →ₐ[C] C :=
  Algebra.TensorProduct.lift (AlgHom.id C C) f (fun _c _b => Commute.all _ _)

private lemma tensorSection_comp_includeLeft (f : B →ₐ[A] C) :
    (tensorSection A B C f).comp
        (Algebra.TensorProduct.includeLeft (R := A) (S := C) (A := C) (B := B)) =
      AlgHom.id C C :=
  Algebra.TensorProduct.lift_comp_includeLeft (AlgHom.id C C) f (fun _c _b => Commute.all _ _)

/-- Composing the left inclusion `C → C ⊗[A] B` with a section is the identity of `C`, as a
morphism of commutative rings. -/
private lemma includeLeftRingHom_comp_tensorSection (f : B →ₐ[A] C) :
    CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := A) (A := C) (B := B)) ≫
        CommRingCat.ofHom (tensorSection A B C f).toRingHom = 𝟙 (CommRingCat.of C) := by
  apply CommRingCat.hom_ext
  ext c
  exact AlgHom.congr_fun (tensorSection_comp_includeLeft A B C f) c

/-- Each section of the projection `Spec (C ⊗[A] B) ⟶ Spec C` is a section on points. -/
private lemma proj_tensorSection_point (f : B →ₐ[A] C) (q : Spec (CommRingCat.of C)) :
    Spec.map (CommRingCat.ofHom
          (Algebra.TensorProduct.includeLeftRingHom (R := A) (A := C) (B := B)))
        (Spec.map (CommRingCat.ofHom (tensorSection A B C f).toRingHom) q) = q := by
  have hc : Spec.map (CommRingCat.ofHom (tensorSection A B C f).toRingHom) ≫
      Spec.map (CommRingCat.ofHom
        (Algebra.TensorProduct.includeLeftRingHom (R := A) (A := C) (B := B))) =
      𝟙 (Spec (CommRingCat.of C)) := by
    rw [← Spec.map_comp, includeLeftRingHom_comp_tensorSection A B C f, Spec.map_id]
  exact congrArg (fun k => k q) hc

/-- **The nilpotency input to filteredness.**  If `Spec B ⟶ Spec A` is a universal
homeomorphism, then any two `A`-algebra maps `f, g : B →ₐ[A] C` differ by a nilpotent element at
every argument. -/
theorem isNilpotent_sub_of_universalHomeomorphism
    (hB : UniversalHomeomorphism (Spec.map (CommRingCat.ofHom (algebraMap A B))))
    (f g : B →ₐ[A] C) (b : B) : IsNilpotent (f b - g b) := by
  classical
  let proj := Spec.map (CommRingCat.ofHom
    (Algebra.TensorProduct.includeLeftRingHom (R := A) (A := C) (B := B)))
  have hprojHome : IsHomeomorph (fun p : Spec (CommRingCat.of (C ⊗[A] B)) => proj p) :=
    (topologically @IsHomeomorph).universally_le proj
      (universalHomeomorphism_specMap_tensorProduct_includeLeft A B C hB).universally_isHomeomorph
  let φ := tensorSection A B C f
  let ψ := tensorSection A B C g
  rw [nilpotent_iff_mem_prime]
  intro J hJ
  let q : Spec (CommRingCat.of C) := ⟨J, hJ⟩
  let pf := Spec.map (CommRingCat.ofHom φ.toRingHom) q
  let pg := Spec.map (CommRingCat.ofHom ψ.toRingHom) q
  have hpgf : pf = pg :=
    hprojHome.injective
      ((proj_tensorSection_point A B C f q).trans (proj_tensorSection_point A B C g q).symm)
  let z : C ⊗[A] B := Algebra.TensorProduct.includeRight (R := A) (A := C) (B := B) b -
    Algebra.TensorProduct.includeLeft (R := A) (S := C) (A := C) (B := B) (f b)
  have heval : ∀ h : B →ₐ[A] C, tensorSection A B C h z = h b - f b := fun h => by
    simp [z, tensorSection]
  have hzφ : tensorSection A B C f z ∈ J := by
    rw [heval, sub_self]
    exact J.zero_mem
  have hzψ : tensorSection A B C g z ∈ J := (hpgf ▸ (hzφ : z ∈ pf.asIdeal) : z ∈ pg.asIdeal)
  have hdiff : g b - f b ∈ J := heval g ▸ hzψ
  simpa using J.neg_mem_iff.mpr hdiff

/-- Two objects of `Algebra.SeminormalizationIndex A` have a common upper bound: a
presentation of the tensor product of the two algebras over `A`. -/
theorem exists_cocone_objs_seminormalizationIndex
    (X Y : Algebra.SeminormalizationIndex A) :
    Nonempty ((Z : Algebra.SeminormalizationIndex A) × (X ⟶ Z) × (Y ⟶ Z)) := by
  classical
  let B := (X.obj.algebra : Type u)
  let C := (Y.obj.algebra : Type u)
  have hfpB : Algebra.FinitePresentation A B := inferInstance
  have hfpC : Algebra.FinitePresentation A C := inferInstance
  have hfp : Algebra.FinitePresentation A (B ⊗[A] C) :=
    Algebra.FinitePresentation.tensorProduct A B C
  have huh : UniversalHomeomorphism
      (Spec.map (CommRingCat.ofHom (algebraMap A (B ⊗[A] C)))) :=
    universalHomeomorphism_specMap_tensorProduct A B C X.property.1 Y.property.1
  have hres : ∀ x : Spec (CommRingCat.of (B ⊗[A] C)),
      IsIso ((Spec.map (CommRingCat.ofHom (algebraMap A (B ⊗[A] C)))).residueFieldMap x) :=
    fun x => isIso_residueFieldMap_specMap_tensorProduct A B C X.property.2 Y.property.2 x
  obtain ⟨Z, e⟩ := exists_seminormalizationIndex_algEquiv A (B ⊗[A] C) hfp huh hres
  exact ⟨⟨Z, ⟨CommAlgCat.ofHom (e.symm.toAlgHom.comp
      (Algebra.TensorProduct.includeLeft (R := A) (S := A) (A := B) (B := C)))⟩,
    ⟨CommAlgCat.ofHom (e.symm.toAlgHom.comp
      (Algebra.TensorProduct.includeRight (R := A) (A := B) (B := C)))⟩⟩⟩

/-- Two parallel maps of `Algebra.SeminormalizationIndex A` are equalized by a further map: a
presentation of the quotient of the target by the differences of the two maps on a finite
generating set of the source. -/
theorem exists_cocone_maps_seminormalizationIndex
    {X Y : Algebra.SeminormalizationIndex A} (f g : X ⟶ Y) :
    ∃ (Z : Algebra.SeminormalizationIndex A) (h : Y ⟶ Z), f ≫ h = g ≫ h := by
  classical
  let B := (X.obj.algebra : Type u)
  let C := (Y.obj.algebra : Type u)
  have hfpB : Algebra.FinitePresentation A B := inferInstance
  have hfpC : Algebra.FinitePresentation A C := inferInstance
  have hftB : Algebra.FiniteType A B := Algebra.FiniteType.of_finitePresentation
  obtain ⟨s, hs⟩ := hftB.out
  let I : Ideal C :=
    Ideal.span (Set.range fun b : {x : B // x ∈ s} => f.hom.hom b.1 - g.hom.hom b.1)
  have hI_fg : I.FG := Submodule.fg_span (Set.finite_range _)
  have hIle : I ≤ nilradical C := Ideal.span_le.mpr <| by
    rintro _ ⟨b, rfl⟩
    exact mem_nilradical.2 <|
      isNilpotent_sub_of_universalHomeomorphism A B C X.property.1 f.hom.hom g.hom.hom b.1
  have hI_nil : ∀ x ∈ I, IsNilpotent x := fun _ hx => mem_nilradical.1 (hIle hx)
  have hfpE : Algebra.FinitePresentation A (C ⧸ I) :=
    Algebra.FinitePresentation.quotient hI_fg
  let qalg : C →ₐ[A] C ⧸ I := Ideal.Quotient.mkₐ A I
  have hquot : UniversalHomeomorphism (Spec.map (CommRingCat.ofHom qalg.toRingHom)) :=
    universalHomeomorphism_specMap_quotient_of_nilpotent C I hI_nil
  have hquotRes : ∀ x : Spec (CommRingCat.of (C ⧸ I)),
      IsIso ((Spec.map (CommRingCat.ofHom qalg.toRingHom)).residueFieldMap x) :=
    fun x => isIso_residueFieldMap_specMap_quotient C I x
  have huh : UniversalHomeomorphism
      (Spec.map (CommRingCat.ofHom (algebraMap A (C ⧸ I)))) :=
    universalHomeomorphism_specMap_comp_algHom qalg Y.property.1 hquot
  have hres : ∀ x : Spec (CommRingCat.of (C ⧸ I)),
      IsIso ((Spec.map (CommRingCat.ofHom (algebraMap A (C ⧸ I)))).residueFieldMap x) :=
    fun x => isIso_residueFieldMap_specMap_comp_algHom qalg Y.property.2 hquotRes x
  obtain ⟨Z, e⟩ := exists_seminormalizationIndex_algEquiv A (C ⧸ I) hfpE huh hres
  have hfgEq : qalg.comp f.hom.hom = qalg.comp g.hom.hom := by
    refine AlgHom.ext_of_adjoin_eq_top hs fun b hb => ?_
    rw [AlgHom.comp_apply, AlgHom.comp_apply, ← sub_eq_zero, ← map_sub]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨⟨b, hb⟩, rfl⟩)
  refine ⟨Z, ⟨CommAlgCat.ofHom (e.symm.toAlgHom.comp qalg)⟩, ?_⟩
  exact InducedCategory.hom_ext <| CommAlgCat.hom_ext <|
    congrArg (fun k : B →ₐ[A] (C ⧸ I) => e.symm.toAlgHom.comp k) hfgEq

/-- The base ring is itself an object of `Algebra.SeminormalizationIndex A`, up to
isomorphism, so the index is nonempty. -/
theorem nonempty_seminormalizationIndex :
    Nonempty (Algebra.SeminormalizationIndex A) := by
  have hfp : Algebra.FinitePresentation A A := Algebra.FinitePresentation.self A
  have hspec : Spec.map (CommRingCat.ofHom (algebraMap A A)) = 𝟙 (Spec (CommRingCat.of A)) := by
    have hA : CommRingCat.ofHom (algebraMap A A) = 𝟙 (CommRingCat.of A) := by
      apply CommRingCat.hom_ext
      ext a
      simp
    rw [hA, Spec.map_id]
  have huh : UniversalHomeomorphism (Spec.map (CommRingCat.ofHom (algebraMap A A))) := by
    rw [hspec]
    exact universalHomeomorphism_of_isIso _
  have hres : ∀ x : Spec (CommRingCat.of A),
      IsIso ((Spec.map (CommRingCat.ofHom (algebraMap A A))).residueFieldMap x) := by
    intro x
    rw [hspec]
    infer_instance
  exact (exists_seminormalizationIndex_algEquiv A A hfp huh hres).map Sigma.fst

/-- **The index of the seminormalization diagram is filtered.** -/
instance seminormalizationIndex_isFiltered :
    IsFiltered (Algebra.SeminormalizationIndex A) where
  cocone_objs X Y := by
    obtain ⟨Z, u, v⟩ := exists_cocone_objs_seminormalizationIndex A X Y
    exact ⟨Z, u, v, trivial⟩
  cocone_maps _ _ f g := exists_cocone_maps_seminormalizationIndex A f g
  nonempty := nonempty_seminormalizationIndex A

end AlgebraicGeometry

end
