module

public import StacksFrontier.AlgebraicGeometry.Scheme.QuasiCoherent.FiniteTypeIdealSheaf

/-!
# Quasi-coherent ideal sheaves from ideals on a family of affine opens

Let `X` be a scheme and `S` a family of affine opens of `X` which covers `X` and is closed under
passing to standard opens `D(f)`, `f ∈ Γ(X, U)`. Suppose given, for every `U` in the family, an
ideal `J U ⊆ Γ(X, U)`, compatible with restriction: for `V ≤ U` both in the family, the ideal
`J V` is generated by the restriction of `J U`. Then there is a unique quasi-coherent sheaf of
ideals whose ideal of sections over every member `U` of the family is `J U`. This file constructs
it as an `AlgebraicGeometry.Scheme.IdealSheafData`.

## Main definitions

* `AlgebraicGeometry.Scheme.IdealSheafData.ofAffineFamilyIdeal`: the candidate ideal over an
  arbitrary affine open `W`, consisting of the sections whose restriction to every member `V ≤ W`
  of the family lies in `J V`.
* `AlgebraicGeometry.Scheme.IdealSheafData.ofAffineFamily`: the sheaf of ideals glued from the
  family of ideals.

## Main results

* `AlgebraicGeometry.Scheme.IdealSheafData.ideal_ofAffineFamily`: over a member `U` of the family
  the sheaf of ideals has ideal of sections `J U`.
* `AlgebraicGeometry.Scheme.IdealSheafData.eq_ofAffineFamily`: it is the only sheaf of ideals with
  this property.
* `AlgebraicGeometry.Scheme.IdealSheafData.isFiniteType_ofAffineFamily`: it is of finite type if
  every `J U` is finitely generated.
-/


@[expose] public noncomputable section

open CategoryTheory TopologicalSpace

universe u

namespace AlgebraicGeometry.Scheme.IdealSheafData

variable {X : Scheme.{u}}

/-- Restricting a section in two steps is restricting it along the composite inclusion. -/
private lemma presheaf_map_homOfLE_apply {U V W : X.Opens} (h₁ : V ≤ U) (h₂ : W ≤ V)
    (a : Γ(X, U)) :
    (X.presheaf.map (homOfLE h₂).op).hom ((X.presheaf.map (homOfLE h₁).op).hom a) =
      (X.presheaf.map (homOfLE (h₂.trans h₁)).op).hom a := by
  rw [← CommRingCat.comp_apply, ← Functor.map_comp]
  rfl

/-- Membership of a section restricted in two steps is membership of the section restricted
along the composite inclusion. -/
private lemma presheaf_map_homOfLE_mem_iff {U V W : X.Opens} (h₁ : V ≤ U) (h₂ : W ≤ V)
    (K : Ideal Γ(X, W)) (a : Γ(X, U)) :
    (X.presheaf.map (homOfLE h₂).op).hom ((X.presheaf.map (homOfLE h₁).op).hom a) ∈ K ↔
      (X.presheaf.map (homOfLE (h₂.trans h₁)).op).hom a ∈ K := by
  rw [presheaf_map_homOfLE_apply]

variable (S : X.affineOpens → Prop) (J : ∀ U : X.affineOpens, Ideal Γ(X, U))

/-- The ideal over an affine open `W` of the sheaf of ideals glued from a family of ideals `J`
on the affine opens satisfying `S`: the sections over `W` whose restriction to every affine open
`V ≤ W` satisfying `S` lies in `J V`. -/
def ofAffineFamilyIdeal (W : X.affineOpens) : Ideal Γ(X, W) :=
  ⨅ (V : X.affineOpens) (_ : S V) (h : V ≤ W), (J V).comap (X.presheaf.map (homOfLE h).op).hom

/-- A section lies in `ofAffineFamilyIdeal S J W` exactly when its restriction to every affine
open `V ≤ W` satisfying `S` lies in `J V`. -/
theorem mem_ofAffineFamilyIdeal {W : X.affineOpens} {a : Γ(X, W)} :
    a ∈ ofAffineFamilyIdeal S J W ↔
      ∀ (V : X.affineOpens), S V → ∀ h : V ≤ W, (X.presheaf.map (homOfLE h).op).hom a ∈ J V := by
  simp only [ofAffineFamilyIdeal, Submodule.mem_iInf, Ideal.mem_comap]

/-- If a section `b` of a member `V` of the family restricts into `J (D(g))`, then some power
of `g` carries `b` into `J V`. -/
private lemma exists_pow_mul_mem_of_restrict_mem
    (hbasic : ∀ (U : X.affineOpens) (f : Γ(X, U)), S U → S (X.affineBasicOpen f))
    (hcompat : ∀ (U V : X.affineOpens) (h : V ≤ U), S U → S V →
      (J U).map (X.presheaf.map (homOfLE h).op).hom = J V)
    {V : X.affineOpens} (hV : S V) (g b : Γ(X, V))
    (hg : (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom b ∈ J (X.affineBasicOpen g)) :
    ∃ n : ℕ, g ^ n * b ∈ J V := by
  have hloc := V.2.isLocalization_basicOpen g
  have hmem : algebraMap Γ(X, V) Γ(X, X.basicOpen g) b ∈
      (J V).map (algebraMap Γ(X, V) Γ(X, X.basicOpen g)) := by
    rw [show (J V).map (algebraMap Γ(X, V) Γ(X, X.basicOpen g)) = J (X.affineBasicOpen g) from
      hcompat V (X.affineBasicOpen g) (X.affineBasicOpen_le g) hV (hbasic V g hV)]
    exact hg
  obtain ⟨_, ⟨n, rfl⟩, hm⟩ :=
    (IsLocalization.algebraMap_mem_map_algebraMap_iff (Submonoid.powers g) _ (J V) b).mp hmem
  exact ⟨n, hm⟩

/-- **Membership in `J V` is local on `V`.** If `J` is compatible with restriction to the
standard opens of a member `V` of the family, a section of `V` whose restrictions to the members
of a cover of `V` by standard opens `D(g)` lie in `J (D(g))` lies in `J V`. -/
theorem mem_of_forall_mem_basicOpen
    (hbasic : ∀ (U : X.affineOpens) (f : Γ(X, U)), S U → S (X.affineBasicOpen f))
    (hcompat : ∀ (U V : X.affineOpens) (h : V ≤ U), S U → S V →
      (J U).map (X.presheaf.map (homOfLE h).op).hom = J V)
    {V : X.affineOpens} (hV : S V) (b : Γ(X, V))
    (H : ∀ x ∈ V.1, ∃ g : Γ(X, V), x ∈ X.basicOpen g ∧
      (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom b ∈ J (X.affineBasicOpen g)) :
    b ∈ J V := by
  let s : Set Γ(X, V) :=
    {g | (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom b ∈ J (X.affineBasicOpen g)}
  have hs : Ideal.span s = ⊤ := by
    rw [← V.2.self_le_iSup_basicOpen_iff]
    intro x hx
    obtain ⟨g, hxg, hg⟩ := H x hx
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨g, hg⟩, hxg⟩
  refine Submodule.mem_of_span_eq_top_of_smul_pow_mem (J V) s hs b fun ⟨g, hg⟩ ↦ ?_
  obtain ⟨n, hn⟩ := exists_pow_mul_mem_of_restrict_mem S J hbasic hcompat hV g b hg
  exact ⟨n, by simpa only [smul_eq_mul] using hn⟩

/-- **The uniform power.** If a section `a` of an affine open `W` restricts into the candidate
ideal over the standard open `D(f)`, then some power of `f` carries `a` into the candidate ideal
over `W`. -/
theorem exists_pow_mul_mem_ofAffineFamilyIdeal
    (hcover : ∀ x : X, ∃ U : X.affineOpens, S U ∧ x ∈ (U : X.Opens))
    (hbasic : ∀ (U : X.affineOpens) (f : Γ(X, U)), S U → S (X.affineBasicOpen f))
    (hcompat : ∀ (U V : X.affineOpens) (h : V ≤ U), S U → S V →
      (J U).map (X.presheaf.map (homOfLE h).op).hom = J V)
    (W : X.affineOpens) (f a : Γ(X, W))
    (ha : (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom a ∈
      ofAffineFamilyIdeal S J (X.affineBasicOpen f)) :
    ∃ m : ℕ, f ^ m * a ∈ ofAffineFamilyIdeal S J W := by
  classical
  replace ha := (mem_ofAffineFamilyIdeal S J).mp ha
  let s : Set Γ(X, W) := {g | S (X.affineBasicOpen g)}
  have hs : Ideal.span s = ⊤ := by
    rw [← W.2.self_le_iSup_basicOpen_iff]
    intro x hx
    obtain ⟨U, hU, hxU⟩ := hcover x
    obtain ⟨f', g', e, hx'⟩ := exists_basicOpen_le_affine_inter W.2 U.2 x ⟨hx, hxU⟩
    have he : X.affineBasicOpen f' = X.affineBasicOpen g' := Subtype.ext e
    exact TopologicalSpace.Opens.mem_iSup.mpr
      ⟨⟨f', show S (X.affineBasicOpen f') from he ▸ hbasic U g' hU⟩, hx'⟩
  obtain ⟨t, hts, ht⟩ := (Ideal.span_eq_top_iff_finite s).mp hs
  have key : ∀ g ∈ t, ∃ n : ℕ,
      (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom (f ^ n * a) ∈
        J (X.affineBasicOpen g) := by
    intro g hg
    have hSg : S (X.affineBasicOpen g) := hts hg
    set ρ := (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom with hρ
    have hSf : S (X.affineBasicOpen (U := X.affineBasicOpen g) (ρ f)) :=
      hbasic (X.affineBasicOpen g) (ρ f) hSg
    have hle : X.affineBasicOpen (U := X.affineBasicOpen g) (ρ f) ≤ X.affineBasicOpen f := by
      change X.basicOpen (ρ f) ≤ X.basicOpen f
      rw [hρ, Scheme.basicOpen_res]
      exact inf_le_right
    have h1 := ha _ hSf hle
    replace h1 := (presheaf_map_homOfLE_mem_iff _ _ _ _).mp h1
    obtain ⟨n, hn⟩ := exists_pow_mul_mem_of_restrict_mem S J hbasic hcompat hSg (ρ f) (ρ a)
      ((presheaf_map_homOfLE_mem_iff _ _ _ _).mpr h1)
    exact ⟨n, by rwa [map_mul, map_pow]⟩
  choose! n hn using key
  refine ⟨∑ g ∈ t, n g, (mem_ofAffineFamilyIdeal S J).mpr fun V hV hVW ↦ ?_⟩
  refine mem_of_forall_mem_basicOpen S J hbasic hcompat hV _ fun x hx ↦ ?_
  have hxW : x ∈ W.1 := hVW hx
  obtain ⟨⟨g, hgt⟩, hxg⟩ := TopologicalSpace.Opens.mem_iSup.mp
    ((W.2.self_le_iSup_basicOpen_iff (s := (t : Set Γ(X, W)))).mpr ht hxW)
  obtain ⟨h, hh, hxh⟩ := V.2.exists_basicOpen_le (V := X.basicOpen g) ⟨x, hxg⟩ hx
  refine ⟨h, hxh, ?_⟩
  have hSg : S (X.affineBasicOpen g) := hts hgt
  have hSh : S (X.affineBasicOpen h) := hbasic V h hV
  refine (presheaf_map_homOfLE_mem_iff hVW (X.basicOpen_le h) _ _).mpr ?_
  refine (presheaf_map_homOfLE_mem_iff (X.basicOpen_le g) hh _ _).mp ?_
  have hle : n g ≤ ∑ g ∈ t, n g := Finset.single_le_sum (fun _ _ ↦ Nat.zero_le _) hgt
  have hmem : (X.presheaf.map (homOfLE (X.affineBasicOpen_le g)).op).hom
      ((f ^ ∑ g ∈ t, n g) * a) ∈ J (X.affineBasicOpen g) := by
    rw [← Nat.sub_add_cancel hle, pow_add, mul_assoc, map_mul]
    exact Ideal.mul_mem_left _ _ (hn g hgt)
  have hh' : X.affineBasicOpen h ≤ X.affineBasicOpen g := hh
  have hmap := Ideal.mem_map_of_mem (X.presheaf.map (homOfLE hh').op).hom hmem
  exact (hcompat (X.affineBasicOpen g) (X.affineBasicOpen h) hh' hSg hSh).le hmap

/-- **The sheaf of ideals glued from ideals on a family of affine opens.** Given a family `S` of
affine opens which covers `X` and is closed under passing to standard opens, and ideals `J U` on
its members compatible with restriction, this is the quasi-coherent sheaf of ideals whose ideal
over every member `U` is `J U` (`ideal_ofAffineFamily`). -/
def ofAffineFamily
    (hcover : ∀ x : X, ∃ U : X.affineOpens, S U ∧ x ∈ (U : X.Opens))
    (hbasic : ∀ (U : X.affineOpens) (f : Γ(X, U)), S U → S (X.affineBasicOpen f))
    (hcompat : ∀ (U V : X.affineOpens) (h : V ≤ U), S U → S V →
      (J U).map (X.presheaf.map (homOfLE h).op).hom = J V) :
    X.IdealSheafData where
  ideal := ofAffineFamilyIdeal S J
  map_ideal_basicOpen W f := by
    apply le_antisymm
    · refine Ideal.map_le_iff_le_comap.mpr fun a ha ↦ ?_
      refine Ideal.mem_comap.mpr ((mem_ofAffineFamilyIdeal S J).mpr fun V hV hVf ↦ ?_)
      exact (presheaf_map_homOfLE_mem_iff _ _ _ _).mpr
        ((mem_ofAffineFamilyIdeal S J).mp ha V hV _)
    · intro b hb
      have hloc := W.2.isLocalization_basicOpen f
      obtain ⟨⟨a, _, n, rfl⟩, hab⟩ := IsLocalization.surj (Submonoid.powers f) b
      have hab' : b * (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom (f ^ n) =
          (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom a := hab
      have ha : (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom a ∈
          ofAffineFamilyIdeal S J (X.affineBasicOpen f) := by
        rw [← hab', mul_comm]
        exact Ideal.mul_mem_left _ _ hb
      obtain ⟨m, hm⟩ := exists_pow_mul_mem_ofAffineFamilyIdeal S J hcover hbasic hcompat W f a ha
      have hu : IsUnit ((X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom (f ^ (m + n))) :=
        IsLocalization.map_units Γ(X, X.basicOpen f)
          (⟨f ^ (m + n), m + n, rfl⟩ : Submonoid.powers f)
      refine (Ideal.mul_unit_mem_iff_mem _ hu).mp ?_
      have e : b * (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom (f ^ (m + n)) =
          (X.presheaf.map (homOfLE (X.basicOpen_le f)).op).hom (f ^ m * a) := by
        simp only [pow_add, map_mul]
        rw [← hab']
        ring
      rw [e]
      exact Ideal.mem_map_of_mem _ hm

variable (hcover : ∀ x : X, ∃ U : X.affineOpens, S U ∧ x ∈ (U : X.Opens))
    (hbasic : ∀ (U : X.affineOpens) (f : Γ(X, U)), S U → S (X.affineBasicOpen f))
    (hcompat : ∀ (U V : X.affineOpens) (h : V ≤ U), S U → S V →
      (J U).map (X.presheaf.map (homOfLE h).op).hom = J V)

/-- The ideal of `ofAffineFamily` over an affine open is the candidate ideal
`ofAffineFamilyIdeal`. -/
theorem ideal_ofAffineFamily_eq (W : X.affineOpens) :
    (ofAffineFamily S J hcover hbasic hcompat).ideal W = ofAffineFamilyIdeal S J W :=
  rfl

/-- **The glued sheaf of ideals restricts to `J` on the family.** Over every affine open `U`
satisfying `S`, the ideal of `ofAffineFamily` is `J U`. -/
theorem ideal_ofAffineFamily {U : X.affineOpens} (hU : S U) :
    (ofAffineFamily S J hcover hbasic hcompat).ideal U = J U := by
  rw [ideal_ofAffineFamily_eq]
  apply le_antisymm
  · intro a ha
    have h := (mem_ofAffineFamilyIdeal S J).mp ha U hU le_rfl
    have e : (X.presheaf.map (homOfLE (le_refl U.1)).op).hom a = a := by simp
    exact (congrArg (· ∈ J U) e).mp h
  · intro a ha
    refine (mem_ofAffineFamilyIdeal S J).mpr fun V hV hVU ↦ ?_
    rw [← hcompat U V hVU hU hV]
    exact Ideal.mem_map_of_mem _ ha

/-- **Uniqueness of the glued sheaf of ideals.** A sheaf of ideals whose ideal over every affine
open satisfying `S` is `J U` is `ofAffineFamily S J`. -/
theorem eq_ofAffineFamily (I : X.IdealSheafData) (hI : ∀ U, S U → I.ideal U = J U) :
    I = ofAffineFamily S J hcover hbasic hcompat := by
  refine ext_of_iSup_eq_top (ι := {U : X.affineOpens // S U}) (fun U ↦ U.1) ?_
    fun U ↦ (hI U.1 U.2).trans (ideal_ofAffineFamily S J hcover hbasic hcompat U.2).symm
  refine eq_top_iff.mpr fun x _ ↦ ?_
  obtain ⟨U, hU, hxU⟩ := hcover x
  exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨U, hU⟩, hxU⟩

/-- **The glued sheaf of ideals is of finite type when the ideals `J U` are finitely
generated.** -/
theorem isFiniteType_ofAffineFamily (hfg : ∀ U, S U → (J U).FG) :
    (ofAffineFamily S J hcover hbasic hcompat).IsFiniteType := by
  refine isFiniteType_of_forall_exists_basicOpen _ fun U x hx ↦ ?_
  obtain ⟨V, hV, hxV⟩ := hcover x
  obtain ⟨f, g, e, hxf⟩ := exists_basicOpen_le_affine_inter U.2 V.2 x ⟨hx, hxV⟩
  have he : X.affineBasicOpen f = X.affineBasicOpen g := Subtype.ext e
  refine ⟨f, hxf, ?_⟩
  rw [he, ideal_ofAffineFamily S J hcover hbasic hcompat (hbasic V g hV),
    ← hcompat V _ (X.affineBasicOpen_le g) hV (hbasic V g hV)]
  exact (hfg V hV).map _

end AlgebraicGeometry.Scheme.IdealSheafData
