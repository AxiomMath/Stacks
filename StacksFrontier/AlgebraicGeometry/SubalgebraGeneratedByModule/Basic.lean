/-! ### The sections of a quasi-coherent submodule form a compatible family -/

/-- The sections of a quasi-coherent submodule of a quasi-coherent module form a compatible
family in the sense of `Stacks.AlgebraicGeometry.GabberColimit.IsCompatible`. -/
theorem isCompatible_sections {X : Scheme.{u}} (F : X.Modules) [F.IsQuasicoherent]
    (M : F.Submodule) (hM : (M.toSheafOfModules : X.Modules).IsQuasicoherent) :
    GabberColimit.IsCompatible F fun U : X.affineOpens =>
      SubmoduleGlueOpens.sections M U.1 := by
  intro U W h
  refine le_antisymm (fun y hy ↦ ?_) (Submodule.span_le.mpr ?_)
  · let G : X.Modules := M.toSheafOfModules
    let _ : G.IsQuasicoherent := hM
    have key : ∀ z : Γ(G, W.1), (z.1 : Γ(F, W.1)) ∈ Submodule.span Γ(X, W.1)
        (F.presheaf.map (homOfLE h).op '' (SubmoduleGlueOpens.sections M U.1 : Set Γ(F, U.1))) := by
      intro z
      have hmem : z ∈ Submodule.span Γ(X, W.1)
          (Set.range (G.presheaf.map (homOfLE h).op)) := by
        rw [GabberColimit.span_range_restrict_eq_top G U.2 W.2 h]; trivial
      induction hmem using Submodule.span_induction with
      | mem x hx =>
        obtain ⟨w, rfl⟩ := hx
        exact Submodule.subset_span ⟨w.1, w.2, rfl⟩
      | zero => exact Submodule.zero_mem _
      | add a b _ _ ha hb => exact Submodule.add_mem _ ha hb
      | smul r a _ ha => exact Submodule.smul_mem _ r ha
    exact key ⟨y, hy⟩
  · rintro z ⟨m, hm, rfl⟩
    exact M.map_mem (homOfLE h).op hm


/-! ### Generated subalgebras and restricted spans -/

/-- **A generated subalgebra base-changes to a generated subalgebra.** Let `P` and `Q` be
algebras over `R` and let `Q` also be an `S`-algebra for an `R`-algebra `S`, compatibly. If a set
`t'` of elements of `Q` spans, over `S`, the same submodule as the image of a set `t` of elements
of `P`, then the `S`-subalgebra of `Q` generated by `t'` is spanned over `S` by the image of the
`R`-subalgebra of `P` generated by `t`. -/
theorem adjoin_toSubmodule_eq_span_image {R S P Q : Type*} [CommRing R] [CommRing S]
    [CommRing P] [CommRing Q] [Algebra R S] [Algebra R P] [Algebra S Q] [Algebra R Q]
    [IsScalarTower R S Q] (f : P →ₐ[R] Q) (t : Set P) (t' : Set Q)
    (ht : Submodule.span S t' = Submodule.span S (f '' t)) :
    Subalgebra.toSubmodule (Algebra.adjoin S t') =
      Submodule.span S (f '' (Algebra.adjoin R t : Set P)) := by
  have hone : (1 : Q) ∈ Submodule.span S (f '' (Algebra.adjoin R t : Set P)) :=
    Submodule.subset_span ⟨1, one_mem _, map_one f⟩
  have hspanmul : Submodule.span S (f '' (Algebra.adjoin R t : Set P)) *
      Submodule.span S (f '' (Algebra.adjoin R t : Set P)) ≤
        Submodule.span S (f '' (Algebra.adjoin R t : Set P)) := by
    rw [Submodule.span_mul_span]
    refine Submodule.span_mono ?_
    rintro z ⟨a, ⟨p, hp, rfl⟩, b, ⟨q, hq, rfl⟩, rfl⟩
    exact ⟨p * q, mul_mem hp hq, map_mul f p q⟩
  let B : Subalgebra S Q :=
    { carrier := Submodule.span S (f '' (Algebra.adjoin R t : Set P))
      mul_mem' := fun ha hb ↦ hspanmul (Submodule.mul_mem_mul ha hb)
      one_mem' := hone
      add_mem' := fun ha hb ↦ Submodule.add_mem _ ha hb
      zero_mem' := Submodule.zero_mem _
      algebraMap_mem' := fun r ↦ by
        rw [Algebra.algebraMap_eq_smul_one]
        exact Submodule.smul_mem _ r hone }
  refine le_antisymm (fun x hx ↦ ?_) (Submodule.span_le.mpr ?_)
  · refine Algebra.adjoin_le (S := B) (fun y hy ↦ ?_) hx
    exact Submodule.span_mono (Set.image_mono Algebra.subset_adjoin)
      (ht.le (Submodule.subset_span hy))
  · rintro z ⟨p, hp, rfl⟩
    change f p ∈ Algebra.adjoin S t'
    induction hp using Algebra.adjoin_induction with
    | mem x hx =>
      exact Algebra.span_le_adjoin S t' (ht.ge (Submodule.subset_span ⟨x, hx, rfl⟩))
    | algebraMap r =>
      rw [AlgHom.commutes, IsScalarTower.algebraMap_apply R S Q]
      exact Subalgebra.algebraMap_mem _ _
    | add x y _ _ hx hy => rw [map_add]; exact add_mem hx hy
    | mul x y _ _ hx hy => rw [map_mul]; exact mul_mem hx hy




/-! ### A section of a quasi-coherent module lies in a finite type quasi-coherent submodule -/

/-- **A section of a quasi-coherent module over an affine open of a quasi-compact and
quasi-separated scheme lies in a finite type quasi-coherent submodule.** -/
theorem exists_submodule_mem_of_qcqs {X : Scheme.{u}} (F : X.Modules)
    [CompactSpace X] [QuasiSeparatedSpace X] [F.IsQuasicoherent] (U : X.affineOpens)
    (s : Γ(F, U.1)) :
    ∃ M : F.Submodule, (M.toSheafOfModules : X.Modules).IsQuasicoherent ∧
      (M.toSheafOfModules : X.Modules).IsFiniteType ∧ s ∈ M.obj (op U.1) := by
  have : IsAffine U.1.toScheme := U.2
  obtain ⟨N, hNqc, hNft, hNres⟩ :=
    exists_isFiniteType_submodule_restrictTo_eq_of_qcqs U.2.isCompact
      (spanRestrictSubsheaf (F.restrict U.1.ι)
        {(F.presheaf.map (homOfLE (U.1.ι_image_le ⊤)).op s : Γ(F.restrict U.1.ι, ⊤))})
      (isQuasicoherent_spanRestrictSubsheaf _ _)
      (isFiniteType_spanRestrictSubsheaf _ (Set.finite_singleton _))
  have hres : (F.presheaf.map (homOfLE (U.1.ι_image_le ⊤)).op s : Γ(F.restrict U.1.ι, ⊤)) ∈
      (restrictTo U.1.ι N).obj (op (⊤ : U.1.toScheme.Opens)) :=
    Eq.mpr
      (congrArg (fun Q : (F.restrict U.1.ι).Submodule ↦
          (F.presheaf.map (homOfLE (U.1.ι_image_le ⊤)).op s : Γ(F.restrict U.1.ι, ⊤)) ∈
            Q.obj (op (⊤ : U.1.toScheme.Opens))) hNres)
      (Stacks.AlgebraicGeometry.Tag01PGColimitClose.mem_obj_spanRestrictSubsheaf_top
        (F.restrict U.1.ι) _)
  exact ⟨N, hNqc, hNft, N.isSheaf s fun x hx ↦ ⟨U.1.ι ''ᵁ ⊤, homOfLE (U.1.ι_image_le ⊤),
    (mem_restrictTo U.1.ι N _).1 hres, ⟨⟨x, hx⟩, trivial, rfl⟩⟩⟩

/-! ### The quasi-coherent subalgebra generated by a quasi-coherent submodule -/

variable {X : Scheme.{u}} (A : AlgebraSheaf X)

/-- Restriction of sections of an algebra sheaf along an inclusion of opens, as a morphism of
`Γ(X, U)`-algebras. -/
def resAlgHom {U W : X.Opens} (h : W ≤ U) :
    letI := AlgebraSheaf.algebraSections A U
    letI := AlgebraSheaf.algebraSectionsOfLE A h
    AlgebraSheaf.sections A U →ₐ[Γ(X, U)] AlgebraSheaf.sections A W :=
  letI := AlgebraSheaf.algebraSections A U
  letI := AlgebraSheaf.algebraSectionsOfLE A h
  { (A.right.obj.map (homOfLE h).op).hom with
    commutes' := fun r ↦ AlgebraSheaf.res_app h r }

/-- The `Γ(X, U)`-subalgebra of the sections of `A` over `U` generated by a set of sections, read
as a `Γ(X, U)`-submodule of the sections of the underlying module of `A`. -/
def adjoinSubmodule (U : X.Opens) (s : Set (AlgebraSheaf.sections A U)) :
    Submodule Γ(X, U) Γ(AlgebraSheaf.underlyingModule A, U) :=
  letI := AlgebraSheaf.algebraSections A U
  Subalgebra.toSubmodule (Algebra.adjoin Γ(X, U) s)

/-- The sections over an open of a concrete submodule of the underlying module of an algebra
sheaf, read as a set of sections of the algebra sheaf. -/
def submoduleSet (M : (AlgebraSheaf.underlyingModule A).Submodule) (U : X.Opens) :
    Set (AlgebraSheaf.sections A U) :=
  (SubmoduleGlueOpens.sections M U : Set Γ(AlgebraSheaf.underlyingModule A, U))


/-! ### Membership in the generated subalgebra -/

/-- The image of the structure sheaf lies in the generated subalgebra. -/
theorem algebraMap_mem_adjoinSubmodule (U : X.Opens) (s : Set (AlgebraSheaf.sections A U))
    (a : Γ(X, U)) : (A.hom.hom.app (op U)).hom a ∈ adjoinSubmodule A U s := by
  let _ := AlgebraSheaf.algebraSections A U
  exact (Subalgebra.algebraMap_mem (Algebra.adjoin Γ(X, U) s) a :
    (A.hom.hom.app (op U)).hom a ∈ Algebra.adjoin Γ(X, U) s)

/-- The generated subalgebra contains `1`. -/
theorem one_mem_adjoinSubmodule (U : X.Opens) (s : Set (AlgebraSheaf.sections A U)) :
    (1 : AlgebraSheaf.sections A U) ∈ adjoinSubmodule A U s := by
  let _ := AlgebraSheaf.algebraSections A U
  exact (one_mem _ : (1 : AlgebraSheaf.sections A U) ∈ Algebra.adjoin Γ(X, U) s)

/-- The generated subalgebra contains `0`. -/
theorem zero_mem_adjoinSubmodule (U : X.Opens) (s : Set (AlgebraSheaf.sections A U)) :
    (0 : AlgebraSheaf.sections A U) ∈ adjoinSubmodule A U s := by
  let _ := AlgebraSheaf.algebraSections A U
  exact (zero_mem _ : (0 : AlgebraSheaf.sections A U) ∈ Algebra.adjoin Γ(X, U) s)

/-- The generated subalgebra is closed under multiplication. -/
theorem mul_mem_adjoinSubmodule {U : X.Opens} {s : Set (AlgebraSheaf.sections A U)}
    {x y : AlgebraSheaf.sections A U} (hx : x ∈ adjoinSubmodule A U s)
    (hy : y ∈ adjoinSubmodule A U s) : x * y ∈ adjoinSubmodule A U s := by
  let _ := AlgebraSheaf.algebraSections A U
  exact (mul_mem hx hy : x * y ∈ Algebra.adjoin Γ(X, U) s)

/-- The generated subalgebra is closed under addition. -/
theorem add_mem_adjoinSubmodule {U : X.Opens} {s : Set (AlgebraSheaf.sections A U)}
    {x y : AlgebraSheaf.sections A U} (hx : x ∈ adjoinSubmodule A U s)
    (hy : y ∈ adjoinSubmodule A U s) : x + y ∈ adjoinSubmodule A U s := by
  let _ := AlgebraSheaf.algebraSections A U
  exact (add_mem hx hy : x + y ∈ Algebra.adjoin Γ(X, U) s)

/-- The generated subalgebra is closed under negation. -/
theorem neg_mem_adjoinSubmodule {U : X.Opens} {s : Set (AlgebraSheaf.sections A U)}
    {x : AlgebraSheaf.sections A U} (hx : x ∈ adjoinSubmodule A U s) :
    -x ∈ adjoinSubmodule A U s := by
  let _ := AlgebraSheaf.algebraSections A U
  exact (neg_mem hx : -x ∈ Algebra.adjoin Γ(X, U) s)

/-- A generator lies in the generated subalgebra. -/
theorem mem_adjoinSubmodule_of_mem {U : X.Opens} {s : Set (AlgebraSheaf.sections A U)}
    {x : AlgebraSheaf.sections A U} (hx : x ∈ s) : x ∈ adjoinSubmodule A U s := by
  let _ := AlgebraSheaf.algebraSections A U
  exact (Algebra.subset_adjoin hx : x ∈ Algebra.adjoin Γ(X, U) s)

/-- **The subalgebras generated by a compatible family of submodules form a compatible family.**
-/
theorem isCompatible_adjoinSubmodule (M : (AlgebraSheaf.underlyingModule A).Submodule)
    (hM : GabberColimit.IsCompatible (AlgebraSheaf.underlyingModule A)
      fun U : X.affineOpens => SubmoduleGlueOpens.sections M U.1) :
    GabberColimit.IsCompatible (AlgebraSheaf.underlyingModule A) fun U : X.affineOpens =>
      adjoinSubmodule A U.1 (submoduleSet A M U.1) := by
  intro U W h
  let _ := AlgebraSheaf.algebraSections A U.1
  let _ := AlgebraSheaf.algebraSections A W.1
  let _ := algebraOfLE X h
  let _ := AlgebraSheaf.algebraSectionsOfLE A h
  let _ := AlgebraSheaf.isScalarTower_sections A h
  have hspan : Submodule.span Γ(X, W.1)
        (SubmoduleGlueOpens.sections M W.1 : Set Γ(AlgebraSheaf.underlyingModule A, W.1)) =
      Submodule.span Γ(X, W.1)
        ((AlgebraSheaf.underlyingModule A).presheaf.map (homOfLE h).op ''
          (SubmoduleGlueOpens.sections M U.1 :
            Set Γ(AlgebraSheaf.underlyingModule A, U.1))) :=
    (Submodule.span_eq _).trans (hM U W h)
  exact adjoin_toSubmodule_eq_span_image (resAlgHom A h) (submoduleSet A M U.1)
    (submoduleSet A M W.1) hspan



/-! ### The generated concrete subalgebra -/

variable [A.IsQuasicoherent] (M : (AlgebraSheaf.underlyingModule A).Submodule)
  (hM : GabberColimit.IsCompatible (AlgebraSheaf.underlyingModule A)
    fun U : X.affineOpens => SubmoduleGlueOpens.sections M U.1)

/-- The family of subalgebras of the sections of `A` over the affine opens generated by the
sections of a concrete submodule `M` of the underlying module of `A`. -/
def genFamily (U : X.affineOpens) :
    Submodule Γ(X, U.1) Γ(AlgebraSheaf.underlyingModule A, U.1) :=
  adjoinSubmodule A U.1 (submoduleSet A M U.1)

omit [A.IsQuasicoherent] in
include hM in
/-- The family `genFamily A M` is compatible. -/
theorem isCompatible_genFamily :
    GabberColimit.IsCompatible (AlgebraSheaf.underlyingModule A) (genFamily A M) :=
  isCompatible_adjoinSubmodule A M hM

include hM in
/-- **The concrete subalgebra of `A` generated by a concrete submodule of its underlying
module.**  Over an open `U` its sections are the sections of `A` whose restriction to every
affine open inside `U` lies in the subalgebra generated there by the sections of `M`. -/
def genSubalg : AlgebraSheaf.Subalg A where
  obj U :=
    { carrier := {x : AlgebraSheaf.sections A U | ∀ (V : X.affineOpens) (hV : V.1 ≤ U),
        (A.right.obj.map (homOfLE hV).op).hom x ∈ genFamily A M V}
      one_mem' := by
        intro V hV
        rw [map_one]
        exact one_mem_adjoinSubmodule A V.1 _
      mul_mem' := by
        intro a b ha hb V hV
        rw [map_mul]
        exact mul_mem_adjoinSubmodule A (ha V hV) (hb V hV)
      zero_mem' := by
        intro V hV
        rw [map_zero]
        exact zero_mem_adjoinSubmodule A V.1 _
      add_mem' := by
        intro a b ha hb V hV
        rw [map_add]
        exact add_mem_adjoinSubmodule A (ha V hV) (hb V hV)
      neg_mem' := by
        intro a ha V hV
        rw [map_neg]
        exact neg_mem_adjoinSubmodule A (ha V hV) }
  algebraMap_mem := by
    intro U a V hV
    rw [AlgebraSheaf.res_app]
    exact algebraMap_mem_adjoinSubmodule A V.1 _ _
  map_mem := by
    intro U V h x hx W hW
    rw [AlgebraSheaf.res_res]
    exact hx W (hW.trans h)
  isSheaf := by
    intro U s hs W hWU
    refine GabberColimit.mem_of_cover (AlgebraSheaf.underlyingModule A) (genFamily A M)
      (isCompatible_genFamily A M hM) W _ fun x hxW ↦ ?_
    obtain ⟨V, hVU, hxV, hmem⟩ := hs x (hWU hxW)
    obtain ⟨-, ⟨W', hW'aff, rfl⟩, hxW', hW'le⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open
        (show x ∈ ((W.1 ⊓ V : X.Opens) : Set X) from ⟨hxW, hxV⟩) (W.1 ⊓ V).isOpen
    have hle : W' ≤ W.1 ⊓ V := hW'le
    refine ⟨⟨W', hW'aff⟩, hle.trans inf_le_left, hxW', ?_⟩
    have key := hmem ⟨W', hW'aff⟩ (hle.trans inf_le_right)
    rw [AlgebraSheaf.res_res] at key
    change (A.right.obj.map (homOfLE (hle.trans inf_le_left : W' ≤ W.1)).op).hom
        ((A.right.obj.map (homOfLE hWU).op).hom s) ∈ genFamily A M ⟨W', hW'aff⟩
    rwa [AlgebraSheaf.res_res]

/-- **Over an affine open the generated subalgebra is the subalgebra generated by the sections
of `M` there.** -/
theorem mem_genSubalg_obj_iff (U : X.affineOpens) (x : AlgebraSheaf.sections A U.1) :
    x ∈ (genSubalg A M hM).obj U.1 ↔ x ∈ genFamily A M U := by
  constructor
  · intro hx
    have h1 := hx U le_rfl
    rwa [AlgebraSheaf.res_self] at h1
  · intro hx V hV
    rw [isCompatible_genFamily A M hM U V hV]
    exact Submodule.subset_span ⟨x, hx, rfl⟩



/-! ### Quasi-coherence and finite type of the generated subalgebra -/

/-- **The algebra sheaf of the generated subalgebra is quasi-coherent.** -/
theorem isQuasicoherent_genSubalg :
    (AlgebraSheaf.Subalg.toAlgebraSheaf (genSubalg A M hM)).IsQuasicoherent :=
  Stacks.AlgebraicGeometry.TorsionQuasicoherent.isQuasicoherent_of_isLocalizedModule_restrictₗ _
    fun _ hU a ↦ Stacks.AlgebraicGeometry.Coherator.isLocalizedModule_gabber
      (AlgebraSheaf.underlyingModule A) (genFamily A M) (isCompatible_genFamily A M hM) hU a



/-- **The algebra sheaf of the subalgebra generated by a finite type quasi-coherent submodule is
of finite type.** -/
theorem isFiniteType_genSubalg
    (hMqc : (M.toSheafOfModules : X.Modules).IsQuasicoherent)
    (hMft : (M.toSheafOfModules : X.Modules).IsFiniteType) :
    (AlgebraSheaf.Subalg.toAlgebraSheaf (genSubalg A M hM)).IsFiniteType := by
  intro U hU
  let _ := AlgebraSheaf.algebraSections A U
  let _ := hMqc
  let _ := hMft
  have hfin : Module.Finite Γ(X, U) ↥(SubmoduleGlueOpens.sections M U) :=
    Stacks.AlgebraicGeometry.CoherentFinite.finite_sections
      (M.toSheafOfModules : X.Modules) hU
  obtain ⟨t, ht⟩ := Module.Finite.iff_fg.mp hfin
  let tset : Set (AlgebraSheaf.sections A U) :=
    (t : Set Γ(AlgebraSheaf.underlyingModule A, U))
  have htfin : tset.Finite := t.finite_toSet
  have hset : submoduleSet A M U =
      (Submodule.span Γ(X, U) tset : Set (AlgebraSheaf.sections A U)) :=
    congrArg (fun p : Submodule Γ(X, U) Γ(AlgebraSheaf.underlyingModule A, U) ↦
      (p : Set Γ(AlgebraSheaf.underlyingModule A, U))) ht.symm
  have hadj : Algebra.adjoin Γ(X, U) (submoduleSet A M U) = Algebra.adjoin Γ(X, U) tset := by
    rw [hset, Algebra.adjoin_span]
  have hsub : (Algebra.adjoin Γ(X, U) tset).toSubring = (genSubalg A M hM).obj U := by
    refine SetLike.ext fun x ↦ ?_
    rw [mem_genSubalg_obj_iff A M hM ⟨U, hU⟩ x]
    change x ∈ Algebra.adjoin Γ(X, U) tset ↔ x ∈ Algebra.adjoin Γ(X, U) (submoduleSet A M U)
    rw [hadj]
  let fA : Γ(X, U) →+* ↥(Algebra.adjoin Γ(X, U) tset) :=
    algebraMap Γ(X, U) ↥(Algebra.adjoin Γ(X, U) tset)
  have hfAft : fA.FiniteType :=
    RingHom.finiteType_algebraMap.mpr (Algebra.FiniteType.adjoin_of_finite htfin)
  have heq : ((AlgebraSheaf.Subalg.toAlgebraSheaf (genSubalg A M hM)).hom.hom.app (op U)).hom =
      (RingEquiv.subringCongr hsub).toRingHom.comp fA := by
    ext a
    rfl
  rw [heq]
  exact hfAft.comp_surjective (RingEquiv.subringCongr hsub).surjective



/-! ### The affine sections statement -/

/-- **Every section of a quasi-coherent sheaf of commutative `𝒪_X`-algebras over an affine open
of a quasi-compact and quasi-separated scheme comes from a finite type quasi-coherent
subalgebra.** -/
theorem exists_finiteTypeSubalgebra_section {X : Scheme.{u}} [CompactSpace X]
