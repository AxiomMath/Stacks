/-!
# Pullback of an effective Cartier divisor, and the flat case

The scheme-theoretic inverse image of an effective Cartier divisor under a flat morphism of
schemes is again an effective Cartier divisor. Thus its pullback is defined.

## Main definitions

* `Stacks.Divisors.IsPullbackDefined` expresses when the pullback of an effective Cartier
  divisor along a morphism of schemes is defined.

## Main results

* `Stacks.IdealSheaf.ideal_comap_appLE` computes the ideal of an inverse-image ideal sheaf on
  an affine open of the source contained in the preimage of an affine open of the target.
* `Stacks.Divisors.isPullbackDefined_of_flat` states that flat morphisms admit pullback of
  effective Cartier divisors.

## Implementation notes

An effective Cartier divisor is represented by its ideal sheaf data. Its scheme-theoretic
inverse image is `AlgebraicGeometry.Scheme.IdealSheafData.comap`; the canonical identification
with the fibre product is `AlgebraicGeometry.Scheme.IdealSheafData.comapIso`. When
`Stacks.Divisors.IsPullbackDefined f D` holds, the pulled-back effective Cartier divisor is the
closed subscheme `(D.comap f).subschemeι`. The predicate is an abbreviation so its effective
Cartier divisor condition is directly usable by clients.

The proof of the flat case follows the source: the question is local, so one reduces to a
morphism of affine schemes `Spec A → Spec R` given by `φ : R → A` with the divisor cut out by a
nonzerodivisor `t ∈ R`, and it suffices that `φ t` be a nonzerodivisor. That is where flatness
enters, through `IsSMulRegular.of_flat`. Both the affine-local criterion and the quotient chart
it produces are the Tag 01WS API
(`Stacks.Divisors.isEffectiveCartierDivisor_iff_affineLocal`,
`Stacks.Divisors.exists_quotient_chart_of_ideal_span`,
`Stacks.Divisors.ideal_eq_quotient_of_chart`), so no chart is rebuilt here.

`Stacks.IdealSheaf.ideal_comap_appLE` is stated here because the flat case is its first
consumer: the affine-local criterion is read on a pair of charts `V ≤ f ⁻¹ᵁ U`, and that is
exactly the shape in which the ideal of `I.comap f` has to be compared with the ideal of `I`.
Mathlib computes `(I.comap f).ideal` only for an open immersion `f`
(`AlgebraicGeometry.Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion`), and the affine case
`Stacks.IdealSheaf.ideal_comap_top_of_isAffine` needs the whole preimage to be affine; here no
hypothesis on `f` is needed at all, because `f.resLE U V` is a morphism of affine schemes.

## References

* [Stacks Project, Tag 01WV](https://stacks.math.columbia.edu/tag/01WV)
* [Stacks Project, Tag 02OO](https://stacks.math.columbia.edu/tag/02OO)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory

universe u

namespace Stacks.IdealSheaf

/-- Replacing the two opens of a map on sections by equal ones amounts to composing with the
restriction maps along those equalities. -/
private lemma appLE_eqToHom_comp {X Y : Scheme.{u}} (f : Y ⟶ X)
    {U U' : X.Opens} {V V' : Y.Opens} (hU : U = U') (hV : V = V')
    (hVU : V ≤ f ⁻¹ᵁ U) (e : V' ≤ f ⁻¹ᵁ U') :
    f.appLE U' V' e =
      X.presheaf.map (eqToHom hU).op ≫ f.appLE U V hVU ≫
        Y.presheaf.map (eqToHom hV.symm).op := by
  subst hU
  subst hV
  simp

/-- **The inverse image of an ideal sheaf on a pair of affine charts.** If the affine open `V`
of the source lies in the preimage of the affine open `U` of the target, then the ideal of
`I.comap f` on `V` is generated by the image of the ideal of `I` on `U`. -/
theorem ideal_comap_appLE {X Y : Scheme.{u}} (I : X.IdealSheafData) (f : Y ⟶ X)
    (U : X.affineOpens) (V : Y.affineOpens) (hVU : (V : Y.Opens) ≤ f ⁻¹ᵁ (U : X.Opens)) :
    (I.comap f).ideal V = (I.ideal U).map (f.appLE U V hVU).hom := by
  suffices key : ∀ (U' : X.affineOpens) (V' : Y.affineOpens),
      U' = ⟨(U : X.Opens).ι ''ᵁ ⊤, by simpa only [Scheme.Opens.ι_image_top] using U.2⟩ →
      V' = ⟨(V : Y.Opens).ι ''ᵁ ⊤, by simpa only [Scheme.Opens.ι_image_top] using V.2⟩ →
      ∀ (e : (V' : Y.Opens) ≤ f ⁻¹ᵁ (U' : X.Opens)),
        (I.comap f).ideal V' = (I.ideal U').map (f.appLE U' V' e).hom from
    key U V (Subtype.ext (U : X.Opens).ι_image_top.symm)
      (Subtype.ext (V : Y.Opens).ι_image_top.symm) hVU
  rintro _ _ rfl rfl e
  have h := ideal_comap_top_of_isAffine (I.comap (U : X.Opens).ι) (f.resLE U V hVU)
  rw [← Scheme.IdealSheafData.comap_comp, Scheme.Hom.resLE_comp_ι,
    Scheme.IdealSheafData.comap_comp,
    Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion (I.comap f) (V : Y.Opens).ι,
    Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion I (U : X.Opens).ι] at h
  simp only [Scheme.Opens.ι_appIso, Iso.refl_inv, Scheme.Hom.appTop,
    Scheme.Hom.resLE_app_top] at h
  convert h using 2 <;> try rfl
  congr 1
  simp only [Scheme.Opens.topIso_hom, Scheme.Opens.topIso_inv]
  exact appLE_eqToHom_comp f (U : X.Opens).ι_image_top.symm
    (V : Y.Opens).ι_image_top.symm hVU e

end Stacks.IdealSheaf

namespace Stacks.Divisors

/-- **Stacks Project, Tag 01WV.** The pullback of an effective Cartier divisor is defined
exactly when its scheme-theoretic inverse image is an effective Cartier divisor. -/
@[stacks 01WV, ega "IV 21.4.2" "effective Cartier div."] abbrev IsPullbackDefined
    {X Y : Scheme.{u}} (f : X ⟶ Y) (D : Y.IdealSheafData) : Prop :=
  IsEffectiveCartierDivisor (D.comap f)

/-- **Stacks Project, Tag 02OO (6).** The pullback of an effective Cartier divisor along a flat
morphism is defined. -/
@[stacks 02OO "flat_morphism",
  ega "IV 21.4.5" "(i), eff. Cartier div",
  ega "IV 21.10.6" "(D), special case",
  ega "IV 21.5.6" "(D)"]
theorem isPullbackDefined_of_flat {X Y : Scheme.{u}} (f : X ⟶ Y)
    (D : Y.IdealSheafData) [Flat f]
    (hD : IsEffectiveCartierDivisor D) :
    IsPullbackDefined f D := by
  change IsEffectiveCartierDivisor (D.comap f)
  refine (isEffectiveCartierDivisor_iff_affineLocal (D.comap f)).2 fun x hx => ?_
  have hxSupport : x ∈ (D.comap f).support :=
    Scheme.IdealSheafData.mem_supportSet_iff_mem_support.mp hx
  have hySupport : f x ∈ D.support := by
    rw [Scheme.IdealSheafData.support_comap] at hxSupport
    exact hxSupport
  have hySupportSet : f x ∈ D.supportSet :=
    Scheme.IdealSheafData.mem_supportSet_iff_mem_support.mpr hySupport
  obtain ⟨V, hV, hfxV, t, ht, e, he⟩ :=
    (isEffectiveCartierDivisor_iff_affineLocal D).mp hD (f x) hySupportSet
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUV⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open
      (show x ∈ f ⁻¹ᵁ V from hfxV) (f ⁻¹ᵁ V).isOpen
  let Va : Y.affineOpens := ⟨V, hV⟩
  let Ua : X.affineOpens := ⟨U, hU⟩
  have hDideal : D.ideal Va = Ideal.span {t} :=
    ideal_eq_quotient_of_chart D V hV (Ideal.span {t}) e he
  have hJideal : (D.comap f).ideal Ua = Ideal.span {(f.appLE Va Ua hUV).hom t} := by
    rw [Stacks.IdealSheaf.ideal_comap_appLE D f Va Ua hUV, hDideal, Ideal.map_span]
    simp
  have htU : IsRegular ((f.appLE Va Ua hUV).hom t) :=
    isRegular_map_of_flat (f.appLE Va Ua hUV).hom (f.flat_appLE hV hU hUV) ht
  obtain ⟨eJ, heJ⟩ :=
    exists_quotient_chart_of_ideal_span (D.comap f) U hU
      ((f.appLE Va Ua hUV).hom t) hJideal
  exact ⟨U, hU, hxU, (f.appLE Va Ua hUV).hom t, htU, eJ, heJ⟩

end Stacks.Divisors

end
