module

public import Mathlib.CategoryTheory.Limits.ConcreteCategory.WithAlgebraicStructures
public import Mathlib.RingTheory.Finiteness.Ideal
public import StacksFrontier.AlgebraicGeometry.IdealPowerSections.Basic

/-!
# Injectivity of the canonical map to sections on the complement of `V(I)`

Let `A` be a commutative ring, `I ⊆ A` a finitely generated ideal and `M` an `A`-module.
`Stacks.AlgebraicGeometry.IdealPowerSections.canonicalMapToSections` is the canonical map
`colim_n Hom_A(I ^ n, M) → Γ(Spec(A) \ V(I), M̃)`. This file proves that it is **injective**.

If no nonzero element of `M` is annihilated by `I`, then no nonzero element is annihilated by a
power of `I`, nor, for finitely generated `I`, by a power of each element of `I` separately.

## Main results

* `canonicalMapToSections_injective`: the canonical map is injective as soon as `I` is finitely
  generated.
* `eq_zero_of_canonicalMapToSections_eq_zero` and
  `colimit_ι_eq_zero_of_canonicalMapToSections_eq_zero`: the kernel form of that statement, for
  an arbitrary element of the colimit and for a representative at a given level.
* `exists_pow_smul_eq_zero_of_basicOpenFraction_eq_zero` and
  `exists_pow_smul_eq_zero_of_tildeBasicOpenFraction_eq_zero`: a fraction `m / fⁿ` on `D(f)`
  vanishes only if some power of `f` annihilates `m`.
* `apply_eq_zero_of_mem_span`: a representative vanishing on a generating set of an ideal
  contained in `I ^ n` vanishes on that whole ideal.
* `eq_zero_of_forall_mem_pow_smul_eq_zero` and `eq_zero_of_forall_exists_pow_smul_eq_zero`: if
  no nonzero element of `M` is annihilated by `I`, then none is annihilated by a power of `I`,
  nor — for finitely generated `I` — by a power of each element of `I` separately.

## References

* [Stacks Project, Tag 01PM](https://stacks.math.columbia.edu/tag/01PM)
* [Stacks Project, Tag 01PQ](https://stacks.math.columbia.edu/tag/01PQ)
* [Stacks Project, Tag 01YB](https://stacks.math.columbia.edu/tag/01YB)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace
open AlgebraicGeometry AlgebraicGeometry.StructureSheaf

universe u v w

namespace Stacks.AlgebraicGeometry.IdealPowerSections

/-- If the fraction `m / fⁿ` vanishes on the basic open `D(f)` of `Spec R`, then some power of
`f` annihilates `m`. -/
public lemma exists_pow_smul_eq_zero_of_tildeBasicOpenFraction_eq_zero {R : CommRingCat.{w}}
    (N : ModuleCat.{w} R) (f : R) (n : ℕ) (m : N)
    (h : tildeBasicOpenFraction N f n m = 0) : ∃ k : ℕ, f ^ k • m = 0 := by
  obtain ⟨⟨t, k, hk⟩, ht⟩ :=
    (IsLocalizedModule.mk'_eq_zero' (S := Submonoid.powers f)
      (tilde.toOpen N (PrimeSpectrum.basicOpen f)).hom _).mp h
  rw [Submonoid.smul_def] at ht
  exact ⟨k, by simpa [← hk] using ht⟩

variable (A : Type u) [CommRing A] (I : Ideal A) (M : Type v) [AddCommGroup M] [Module A M]

/-- If the fraction `m / fⁿ` vanishes on `D(f)`, then some power of `f` annihilates `m`. -/
public lemma exists_pow_smul_eq_zero_of_basicOpenFraction_eq_zero {f : A} {n : ℕ} {m : M}
    (h : basicOpenFraction A M f n m = 0) : ∃ k : ℕ, f ^ k • m = 0 := by
  obtain ⟨k, hk⟩ := exists_pow_smul_eq_zero_of_tildeBasicOpenFraction_eq_zero
    (R := .of (ULift.{v} A)) (ModuleCat.of (ULift.{v} A) (ULift.{u} M))
    (ULift.up.{v} f) n (ULift.up.{u} m) h
  exact ⟨k, by simpa using congrArg ULift.down hk⟩

/-- A representative `φ : I ^ n → M` that vanishes on a generating set of an ideal contained in
`I ^ n` vanishes on that whole ideal. -/
public lemma apply_eq_zero_of_mem_span {n : ℕ} (φ : ↥(I ^ n) →ₗ[A] M) (g : Set A)
    (hg : Ideal.span g ≤ I ^ n)
    (hφ : ∀ a ∈ g, ∀ ha : a ∈ I ^ n, φ ⟨a, ha⟩ = 0)
    {a : A} (ha : a ∈ Ideal.span g) (ha' : a ∈ I ^ n) : φ ⟨a, ha'⟩ = 0 := by
  revert ha'
  induction ha using Submodule.span_induction with
  | mem x hx => exact fun h ↦ hφ x hx h
  | zero => exact fun _ ↦ map_zero φ
  | add x y hx hy ihx ihy =>
    intro h
    rw [show (⟨x + y, h⟩ : ↥(I ^ n)) = ⟨x, hg hx⟩ + ⟨y, hg hy⟩ from rfl, map_add, ihx (hg hx),
      ihy (hg hy), add_zero]
  | smul c x hx ih =>
    intro h
    rw [show (⟨c • x, h⟩ : ↥(I ^ n)) = c • (⟨x, hg hx⟩ : ↥(I ^ n)) from rfl, map_smul,
      ih (hg hx), smul_zero]

/-- If `I` is generated by a finite set `s` and each element of `s` has a power in `J`, then some
power of `I` is contained in `J`. -/
private theorem exists_pow_le_of_forall_mem_exists_pow_mem (J : Ideal A) (s : Finset A)
    (hs : Ideal.span (s : Set A) = I) (h : ∀ f ∈ s, ∃ k : ℕ, f ^ k ∈ J) : ∃ N : ℕ, I ^ N ≤ J := by
  refine Ideal.exists_pow_le_of_le_radical_of_fg ?_ ⟨s, hs⟩
  rw [← hs]
  exact Ideal.span_le.mpr h

/-- For a finitely generated ideal `I`, a representative `φ : I ^ n → M` whose section on
`Spec(A) \ V(I)` vanishes is already zero in the colimit. -/
public lemma colimit_ι_eq_zero_of_canonicalMapToSections_eq_zero (hI : I.FG) (n : ℕ)
    (φ : (I ^ n : Ideal A) →ₗ[A] M)
    (hx : canonicalMapToSections A I M (colimit.ι (idealPowersHom A I M) n φ) = 0) :
    colimit.ι (idealPowersHom A I M) n φ = 0 := by
  classical
  obtain ⟨s, hs⟩ := hI
  have hmem : ∀ f ∈ s, f ∈ I := fun f hf ↦ hs ▸ Ideal.subset_span hf
  have hker : ∀ f : {x // x ∈ s}, ∃ k : ℕ,
      f.1 ^ k • φ ⟨f.1 ^ n, Ideal.pow_mem_pow (hmem f.1 f.2) n⟩ = 0 := by
    intro f
    refine exists_pow_smul_eq_zero_of_basicOpenFraction_eq_zero A M (n := n) ?_
    rw [← canonicalMapToSections_restrict_ι A I M n φ f.1 (hmem f.1 f.2), hx]
    exact map_zero _
  choose k hk using hker
  set K := Finset.univ.sup k
  have hpow : ∀ (f : {x // x ∈ s}) (hp : f.1 ^ (n + K) ∈ I ^ n),
      φ ⟨f.1 ^ (n + K), hp⟩ = 0 := by
    intro f hp
    have hle : k f ≤ K := Finset.le_sup (Finset.mem_univ f)
    have hval : (⟨f.1 ^ (n + K), hp⟩ : ↑(I ^ n)) =
        f.1 ^ (K - k f) • (f.1 ^ k f • ⟨f.1 ^ n, Ideal.pow_mem_pow (hmem f.1 f.2) n⟩) := by
      refine Subtype.ext ?_
      rw [SetLike.val_smul, SetLike.val_smul, smul_eq_mul, smul_eq_mul, ← mul_assoc,
        ← pow_add, ← pow_add, Nat.sub_add_cancel hle, add_comm K n]
    rw [hval, map_smul, map_smul, hk f, smul_zero]
  set J := Ideal.span ((fun x ↦ x ^ (n + K)) '' (s : Set A))
  have hJle : J ≤ I ^ n := by
    refine Ideal.span_le.mpr ?_
    rintro a ⟨f, hf, rfl⟩
    exact Ideal.pow_le_pow_right (Nat.le_add_right n K) (Ideal.pow_mem_pow (hmem f hf) (n + K))
  obtain ⟨N, hN⟩ := exists_pow_le_of_forall_mem_exists_pow_mem A I J s hs
    fun f hf ↦ ⟨n + K, Ideal.subset_span ⟨f, hf, rfl⟩⟩
  have hnN : n ≤ N + n := Nat.le_add_left n N
  have hIN : I ^ (N + n) ≤ J :=
    le_trans (Ideal.pow_le_pow_right (Nat.le_add_right N n)) hN
  have hψ : (idealPowersHom A I M).map (homOfLE hnN) φ = 0 := by
    refine LinearMap.ext fun a ↦ ?_
    show φ (Submodule.inclusion (Ideal.pow_le_pow_right hnN) a) = 0
    exact apply_eq_zero_of_mem_span A I M φ _ hJle
      (fun b hb hb' ↦ by
        obtain ⟨f, hf, rfl⟩ := hb
        exact hpow ⟨f, hf⟩ hb') (hIN a.2) _
  have hw : colimit.ι (idealPowersHom A I M) (N + n)
      ((idealPowersHom A I M).map (homOfLE hnN) φ) =
        colimit.ι (idealPowersHom A I M) n φ :=
    (CategoryTheory.comp_apply ((idealPowersHom A I M).map (homOfLE hnN))
        (colimit.ι (idealPowersHom A I M) (N + n)) φ).symm.trans
      (ConcreteCategory.congr_hom (colimit.w (idealPowersHom A I M) (homOfLE hnN)) φ)
  rw [← hw, hψ, map_zero]

/-- For a finitely generated ideal `I`, an element of the colimit whose section on
`Spec(A) \ V(I)` vanishes is zero. -/
public lemma eq_zero_of_canonicalMapToSections_eq_zero (hI : I.FG)
    (x : ToType (colimit (idealPowersHom A I M)))
    (hx : canonicalMapToSections A I M x = 0) : x = 0 := by
  have hAb : PreservesFilteredColimitsOfSize.{0, 0} (forget AddCommGrpCat.{max u v}) :=
    preservesFilteredColimitsOfSize_of_univLE.{max u v, max u v, 0, 0} _
  have : PreservesColimitsOfShape ℕ (forget (ModuleCat.{max u v} A)) :=
    Limits.comp_preservesColimitsOfShape
      (forget₂ (ModuleCat.{max u v} A) AddCommGrpCat.{max u v}) (forget AddCommGrpCat)
  obtain ⟨n, φ, rfl⟩ := Concrete.colimit_exists_rep (idealPowersHom A I M) x
  exact colimit_ι_eq_zero_of_canonicalMapToSections_eq_zero A I M hI n φ hx

/-- For a finitely generated ideal `I` the canonical map
`colim_n Hom_A(I ^ n, M) → Γ(Spec(A) \ V(I), M̃)` is injective. -/
@[stacks 01PM "injectivity"]
public theorem canonicalMapToSections_injective (hI : I.FG) :
    Function.Injective (canonicalMapToSections A I M) := by
  intro x y hxy
  have h : canonicalMapToSections A I M (x - y) = 0 := by
    rw [map_sub, hxy, sub_self]
  exact sub_eq_zero.mp (eq_zero_of_canonicalMapToSections_eq_zero A I M hI _ h)

/-! ### Modules with no section annihilated by the ideal -/

/-- If no nonzero element of `M` is annihilated by `I`, then none is annihilated by a power
of `I`. -/
public lemma eq_zero_of_forall_mem_pow_smul_eq_zero
    (htors : ∀ y : M, (∀ a ∈ I, a • y = 0) → y = 0) :
    ∀ (N : ℕ) (x : M), (∀ a ∈ I ^ N, a • x = 0) → x = 0 := by
  intro N
  induction N with
  | zero =>
    intro x hx
    have h1 := hx 1 (by rw [pow_zero, Ideal.one_eq_top]; trivial)
    rwa [one_smul] at h1
  | succ N ih =>
    intro x hx
    refine ih x fun a ha ↦ htors _ fun b hb ↦ ?_
    rw [smul_smul]
    exact hx (b * a) (by rw [pow_succ']; exact Ideal.mul_mem_mul hb ha)

/-- If `I` is finitely generated and no nonzero element of `M` is annihilated by `I`, then an
element annihilated by some power of every element of `I` is zero. -/
public lemma eq_zero_of_forall_exists_pow_smul_eq_zero (hI : I.FG)
    (htors : ∀ y : M, (∀ a ∈ I, a • y = 0) → y = 0) (x : M)
    (hx : ∀ f ∈ I, ∃ k : ℕ, f ^ k • x = 0) : x = 0 := by
  obtain ⟨s, hs⟩ := hI
  obtain ⟨N, hN⟩ := exists_pow_le_of_forall_mem_exists_pow_mem A I
    (LinearMap.ker (LinearMap.toSpanSingleton A M x)) s hs fun f hf ↦ by
      obtain ⟨k, hk⟩ := hx f (hs ▸ Ideal.subset_span hf)
      exact ⟨k, by simpa [LinearMap.toSpanSingleton_apply] using hk⟩
  refine eq_zero_of_forall_mem_pow_smul_eq_zero A I M htors N x fun a ha ↦ ?_
  simpa [LinearMap.toSpanSingleton_apply] using hN ha

end Stacks.AlgebraicGeometry.IdealPowerSections
