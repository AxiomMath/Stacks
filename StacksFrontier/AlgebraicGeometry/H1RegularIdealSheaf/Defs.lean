module

public import StacksFrontier.AlgebraicGeometry.H1RegularIdealSheaf.Algebra
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Basic

/-!
# `H₁`-regular sequences of sections and `H₁`-regular ideal sheaves

Let `X` be a ringed space, `U ⊆ X` an open set, and `f₀, …, f_{r-1}` sections of `O_X` over `U`.
Stacks tag 063D, part (3), calls the sequence `H₁`-regular when the first homology of its sheaf
Koszul complex vanishes.  That condition is written out here, as a statement about sections and
no more.

Why the two agree.  The bottom of the Koszul complex of `f` on `U` is

`⋀²(O_Uʳ) --d₂--> O_Uʳ --d₁--> O_U`,

a complex of *free* sheaves of modules, so its degree-one homology is the sheaf kernel of `d₁`
modulo the sheaf image of `d₂`.  The kernel is computed sectionwise: over `V ⊆ U` it is the
module of *relations* `a` with `∑ i, a i * f i|_V = 0`.  The image is computed sectionwise and
then sheafified, and sectionwise it is `Koszul.relSpan`, the span of the trivial relations
`fᵢ eⱼ - fⱼ eᵢ` — this is exactly `Koszul.map_range_d_one`, which identifies the range of the
degree-one differential with `Koszul.relSpan`.  Vanishing of the quotient therefore says: every
relation over every `V ⊆ U` lies, locally on `V`, in the span of the trivial relations.  That is
the definition below.

No sheaf Koszul complex, no sheaf exterior power, and no sheafification functor is needed to say
this, which is why the definition is available at all: the library has no Koszul complex of
sheaves of modules.

## Main definitions

* `resFamily X h f`: a family of sections restricted along an inclusion of opens.
* `IsH1RegularSequenceOn X U f`: **Stacks tag 063D, part (3)** for the local sequence `f`.
* `IsH1RegularIdealSheaf X J`: **Stacks tag 063D, part (3)** for the ideal sheaf `J` — locally
  generated by an `H₁`-regular sequence near every point of the support of `O_X / J`.

## Main results

* `resFamily_res`, `resFamily_mem_relSpan`: restriction of families is functorial, and the span
  of the trivial relations is stable under it.
* `isH1RegularSequenceOn_of_le`: the condition is inherited by smaller opens.

## Implementation notes

The witness open `W` of the definition is required only to contain the given point of `V`, not
to be part of a chosen cover; quantifying over the points of `V` is the same thing and avoids
naming a sieve.

## References

* [Stacks Project, Definition 31.20.1 (Tag 063D)](https://stacks.math.columbia.edu/tag/063D)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.AlgebraicGeometry.QuasiRegular
open Stacks.AlgebraicGeometry.RegularIdealSheaf
open Stacks.RingedSpace

universe u

namespace Stacks.AlgebraicGeometry.H1RegularIdealSheaf

section Restriction

variable (X : RingedSpace.{u}) {r : ℕ}

/-- A finite family of sections restricted along an inclusion of open sets. -/
noncomputable def resFamily {U V : Opens X} (h : V ≤ U)
    (f : Fin r → X.presheaf.obj (op U)) : Fin r → X.presheaf.obj (op V) :=
  fun i => X.presheaf.map (homOfLE h).op (f i)

/-- The `i`-th entry of the restricted family is the restriction of the `i`-th section. -/
@[simp]
theorem resFamily_apply {U V : Opens X} (h : V ≤ U) (f : Fin r → X.presheaf.obj (op U))
    (i : Fin r) : resFamily X h f i = X.presheaf.map (homOfLE h).op (f i) := rfl

/-- Restricting a family of sections along the identity inclusion `U ≤ U` leaves it unchanged. -/
@[simp]
theorem resFamily_self {U : Opens X} (f : Fin r → X.presheaf.obj (op U)) :
    resFamily X (le_refl U) f = f := by
  funext i
  rw [resFamily_apply]
  have h : (homOfLE (le_refl U)).op = 𝟙 (op U) := rfl
  rw [h, X.presheaf.map_id]
  rfl

/-- Restriction of a family of sections is functorial. -/
theorem resFamily_res {U V W : Opens X} (h₁ : V ≤ U) (h₂ : W ≤ V)
    (f : Fin r → X.presheaf.obj (op U)) :
    resFamily X h₂ (resFamily X h₁ f) = resFamily X (h₂.trans h₁) f := by
  funext i
  rw [resFamily_apply, resFamily_apply, resFamily_apply, ← CommRingCat.comp_apply,
    ← X.presheaf.map_comp]
  rfl

/-- **The span of the trivial relations is stable under restriction.** -/
theorem resFamily_mem_relSpan {U V : Opens X} (h : V ≤ U)
    {f a : Fin r → X.presheaf.obj (op U)} (ha : a ∈ Koszul.relSpan f) :
    resFamily X h a ∈ Koszul.relSpan (resFamily X h f) :=
  Stacks.RingTheory.H1RegularIdealSheaf.map_mem_relSpan
    (X.presheaf.map (homOfLE h).op).hom f ha

end Restriction

section Defs

variable (X : RingedSpace.{u})

/-- **The local `H₁`-regularity condition of Stacks tag 063D, part (3).** The sequence `f` of
sections over `U` is `H₁`-regular when, over every open `V ⊆ U`, every relation among the
restrictions of the `fᵢ` lies locally in the span of the trivial relations `fᵢ eⱼ - fⱼ eᵢ`.
This is the vanishing of the degree-one homology of the sheaf Koszul complex of `f`, written out
in sections; see the module docstring. -/
def IsH1RegularSequenceOn (U : Opens X) {r : ℕ} (f : Fin r → X.presheaf.obj (op U)) : Prop :=
  ∀ (V : Opens X) (hVU : V ≤ U) (a : Fin r → X.presheaf.obj (op V)),
    ∑ i, a i * resFamily X hVU f i = 0 →
      ∀ (y : X), y ∈ V → ∃ (W : Opens X) (hWV : W ≤ V) (_ : y ∈ W),
        resFamily X hWV a ∈ Koszul.relSpan (resFamily X (hWV.trans hVU) f)

/-- **Stacks tag 063D, part (3).** An ideal sheaf locally generated by an `H₁`-regular sequence
near every point of the support of its quotient. -/
def IsH1RegularIdealSheaf (J : (structureSheafModule X).Submodule) : Prop :=
  ∀ x : X, x ∈ idealQuotientSupport X J →
    ∃ (U : Opens X) (_hx : x ∈ U) (r : ℕ) (f : Fin r → X.presheaf.obj (op U)),
      IsH1RegularSequenceOn X U f ∧ IsGeneratedByOn X J U f

/-- Local-witness characterization of an `H₁`-regular ideal sheaf. -/
theorem isH1RegularIdealSheaf_iff (J : (structureSheafModule X).Submodule) :
    IsH1RegularIdealSheaf X J ↔
      ∀ x : X, x ∈ idealQuotientSupport X J →
        ∃ (U : Opens X) (_hx : x ∈ U) (r : ℕ) (f : Fin r → X.presheaf.obj (op U)),
          IsH1RegularSequenceOn X U f ∧ IsGeneratedByOn X J U f := Iff.rfl

/-- **The `H₁`-regular condition is inherited by smaller opens.** -/
theorem isH1RegularSequenceOn_of_le (U : Opens X) {r : ℕ} (f : Fin r → X.presheaf.obj (op U))
    (U' : Opens X) (hU' : U' ≤ U) (h : IsH1RegularSequenceOn X U f) :
    IsH1RegularSequenceOn X U' (resFamily X hU' f) := by
  intro V hVU' a ha y hy
  rw [resFamily_res X hU' hVU' f] at ha
  obtain ⟨W, hWV, hyW, hmem⟩ := h V (hVU'.trans hU') a ha y hy
  refine ⟨W, hWV, hyW, ?_⟩
  rw [resFamily_res X hU' (hWV.trans hVU') f]
  exact hmem

end Defs

end Stacks.AlgebraicGeometry.H1RegularIdealSheaf

end
