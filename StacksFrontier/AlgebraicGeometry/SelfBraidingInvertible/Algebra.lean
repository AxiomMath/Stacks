module

public import Mathlib.Algebra.Category.ModuleCat.Monoidal.Symmetric
public import Mathlib.LinearAlgebra.TensorProduct.Basic
public import Mathlib.RingTheory.Ideal.Operations

/-!
# The tensor square of a rank-one module is symmetric

Let `R` be a commutative ring and `M` an `R`-module. Suppose given finitely many *rank-one
witnesses*: functions `f i : M → R`, elements `z i : M` and scalars `c i : R` with

* `∑ i, c i = 1`, and
* `f i v • z i = c i • v` for every `i` and every `v : M`.

The second condition says that after multiplying by `c i` every element of `M` becomes a
multiple of the single element `z i`; the first says that these partial trivialisations cover
`M`. This file proves that such an `M` has symmetric tensor square: `v ⊗ₜ w = w ⊗ₜ v`.

This is the purely algebraic heart of the fact that an invertible sheaf of modules has trivial
self-braiding. It is *not* the statement that `M` is cyclic — which is false for an invertible
module over a ring with nontrivial class group — and that is exactly why the hypotheses are the
ones above rather than a single generator.

## Main results

* `Stacks.SelfBraidingInvertible.eq_zero_of_sq_smul_eq_zero`: if the `c i` sum to `1` and each
  `c i ^ 2` annihilates an element `D` of a module, then `D = 0`. The squares are what the
  rank-one witnesses produce, and one square per index is not enough to reach `1` by a linear
  combination: the proof passes through the radical of the annihilator ideal, where each `c i`
  lands because its square does.
* `Stacks.SelfBraidingInvertible.tmul_comm_of_rankOne`: **the tensor square of a module with
  rank-one witnesses is symmetric.**
* `Stacks.SelfBraidingInvertible.braiding_eq_id_of_tmul_comm`: a module with symmetric tensor
  square has trivial self-braiding in `ModuleCat R`.

## Implementation notes

No linearity of `f i` is used, and the two displayed hypotheses are used only at the two
elements whose tensors are being compared. So `f` is taken to be a bare function; this removes
the need to package the contraction of a pairing against a section as a linear map at the point
of use.

The proof is three lines of algebra. Writing `D = v ⊗ₜ w - w ⊗ₜ v`, the identity
`c i • v = f i v • z i` applied in both factors gives
`(c i * c i) • (v ⊗ₜ w) = (f i v * f i w) • (z i ⊗ₜ z i)`, whose right-hand side is symmetric in
`v` and `w` because `R` is commutative; hence `(c i * c i) • D = 0` for every `i`, and the
annihilator argument finishes.
-/

@[expose] public section

open scoped TensorProduct

universe u₁ u₂ u₃

namespace Stacks.SelfBraidingInvertible

/-- **A family of scalars summing to `1` whose squares all annihilate an element annihilates
it.** The scalars themselves need not annihilate it, so this is not a linear combination: each
`c i` lies in the radical of the annihilator ideal of `D`, hence so does `1`, hence `1` lies in
the annihilator itself. -/
theorem eq_zero_of_sq_smul_eq_zero {R : Type u₁} [CommRing R] {A : Type u₂} [AddCommGroup A]
    [Module R A] {ι : Type u₃} [Fintype ι] (c : ι → R) (hc : ∑ i, c i = 1) (D : A)
    (h : ∀ i, (c i * c i) • D = 0) : D = 0 := by
  classical
  let I : Ideal R :=
    { carrier := {r | r • D = 0}
      zero_mem' := zero_smul R D
      add_mem' := fun {a b} ha hb ↦ by
        change (a + b) • D = 0
        rw [add_smul, show a • D = 0 from ha, show b • D = 0 from hb, add_zero]
      smul_mem' := fun r a ha ↦ by
        change (r • a) • D = 0
        rw [smul_eq_mul, mul_smul, show a • D = 0 from ha, smul_zero] }
  have hrad : ∀ i, c i ∈ I.radical := fun i ↦ ⟨2, by
    change (c i ^ 2) • D = 0
    rw [pow_two]
    exact h i⟩
  obtain ⟨k, hk⟩ : (1 : R) ∈ I.radical := hc ▸ Submodule.sum_mem _ fun i _ ↦ hrad i
  simpa using (show ((1 : R) ^ k) • D = 0 from hk)

/-- **A module with rank-one witnesses has symmetric tensor square.** The witnesses are the
functions `f`, the elements `z` and the scalars `c`: multiplying by `c i` sends every element of
`M` into the cyclic submodule generated by `z i`, and the `c i` sum to `1`. -/
theorem tmul_comm_of_rankOne {R : Type u₁} [CommRing R] {M : Type u₂} [AddCommGroup M]
    [Module R M] {ι : Type u₃} [Fintype ι] (f : ι → M → R) (z : ι → M) (c : ι → R)
    (hc : ∑ i, c i = 1) (hz : ∀ (i : ι) (v : M), f i v • z i = c i • v) (v w : M) :
    v ⊗ₜ[R] w = w ⊗ₜ[R] v := by
  have key : ∀ i, (c i * c i) • (v ⊗ₜ[R] w - w ⊗ₜ[R] v) = 0 := by
    intro i
    have h : ∀ a b : M, (c i * c i) • (a ⊗ₜ[R] b) = (f i a * f i b) • (z i ⊗ₜ[R] z i) := by
      intro a b
      rw [← TensorProduct.smul_tmul_smul, ← TensorProduct.smul_tmul_smul, ← hz, ← hz]
    rw [smul_sub, h, h, mul_comm (f i v) (f i w), sub_self]
  exact sub_eq_zero.mp (eq_zero_of_sq_smul_eq_zero c hc _ key)

open CategoryTheory MonoidalCategory

/-- **A module with symmetric tensor square has trivial self-braiding**, the braiding of
`ModuleCat R` being the transposition of a tensor square. -/
theorem braiding_eq_id_of_tmul_comm {R : Type u₁} [CommRing R] (M : ModuleCat.{u₁} R)
    (h : ∀ a b : M, a ⊗ₜ[R] b = b ⊗ₜ[R] a) : (β_ M M).hom = 𝟙 (M ⊗ M) := by
  refine ModuleCat.hom_ext (TensorProduct.ext' fun a b ↦ ?_)
  change (β_ M M).hom (a ⊗ₜ b) = a ⊗ₜ b
  rw [ModuleCat.MonoidalCategory.braiding_hom_apply]
  exact h b a

end Stacks.SelfBraidingInvertible

end
