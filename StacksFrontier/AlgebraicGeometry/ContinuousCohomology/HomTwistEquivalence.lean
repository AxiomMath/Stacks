module

public import StacksFrontier.AlgebraicGeometry.ContinuousCohomology.HomTwist
public import StacksFrontier.AlgebraicGeometry.ContinuousCohomology.FiniteTypePermutation

/-!
# The twist `Hom(A, -)` by a cyclic group is an equivalence

Let `R` be a ring, `Γ` a topological group and `A` a finite cyclic group of order `n` with a
continuous action of `Γ`. On finite `R`-modules with a continuous action of `Γ` killed by `n`, the
twist `M ↦ Hom_ℤ(A, M)` (`Stacks.GroupCohomology.homTwistFunctor`) is an autoequivalence: its
inverse is the twist by the dual `A^* = Hom_ℤ(A, ℤ/n)` (with `Γ` acting by
`(γ · φ)(a) = φ(γ⁻¹ a)`), through the evaluation pairing `A × A^* → ℤ/n`.

More generally, for a `Γ`-invariant pairing `p : A × B → ℤ/n` of cyclic groups which is perfect
(it takes the value `1` on a pair of generators), `m ↦ (a ↦ (b ↦ p(a, b) m))` is an isomorphism
`M ≅ Hom_ℤ(A, Hom_ℤ(B, M))`, naturally in `M` (`Stacks.GroupCohomology.homTwistTwistNatIso`). For
`A = μ_n` this says `M(-1)(1) = M`.

## Main definitions

* `Stacks.GroupCohomology.zmodTrivialContinuousModule`: `ℤ/n` with the trivial action.
* `Stacks.GroupCohomology.homTwistDualCoefficient`: `A^* = Hom_ℤ(A, ℤ/n)`.
* `Stacks.GroupCohomology.homTwistTwistNatIso`: `M ≅ Hom_ℤ(A, Hom_ℤ(B, M))`.
* `Stacks.GroupCohomology.homTwistEquivalence`: `Hom_ℤ(A, -)` as an autoequivalence.
-/

@[expose] public noncomputable section

open CategoryTheory

universe u v w

namespace Stacks.GroupCohomology

open Stacks.ContinuousCohomology (continuousModuleRho_mul_apply continuousModuleRho_one_apply)

open scoped Stacks.DiscreteModuleTopology

section ZModScalar

variable {M : Type*} [AddCommGroup M] {n : ℕ} [NeZero n] (hM : ∀ m : M, n • m = 0)

include hM in
/-- On a group killed by `n`, `x.val • m` is the `ℤ/n`-module scalar multiplication. -/
lemma zmod_val_nsmul_eq_smul (x : ZMod n) (m : M) :
    x.val • m = (letI := AddCommGroup.zmodModule hM; x • m) := by
  let := AddCommGroup.zmodModule hM
  rw [← Nat.cast_smul_eq_nsmul (ZMod n), ZMod.natCast_zmod_val]

include hM in
/-- On a group killed by `n`, `x ↦ x.val • m` is additive. -/
lemma zmod_val_add_nsmul (x y : ZMod n) (m : M) :
    (x + y).val • m = x.val • m + y.val • m := by
  let := AddCommGroup.zmodModule hM
  rw [zmod_val_nsmul_eq_smul hM, zmod_val_nsmul_eq_smul hM, zmod_val_nsmul_eq_smul hM, add_smul]

end ZModScalar

variable (R : Type u) [Ring R] [Finite R] {Γ : Type v} [Group Γ] [TopologicalSpace Γ]
  [IsTopologicalGroup Γ]

/-! ### The double twist by a perfect pairing -/

section Pairing

variable (A B : Stacks.Injectives.ContinuousModule.{0, v, w} ℤ Γ) [Finite A.obj.obj.V]
  [Finite B.obj.obj.V] {n : ℕ} [NeZero n] (p : A.obj.obj.V →+ B.obj.obj.V →+ ZMod n)

/-- **`m ↦ (a ↦ (b ↦ p(a, b) m))`**, the map `M → Hom_ℤ(A, Hom_ℤ(B, M))` of a pairing
`p : A × B → ℤ/n`, for `M` killed by `n`. -/
def homTwistTwistLinear {M : Type*} [AddCommGroup M] [Module R M] (hM : ∀ m : M, n • m = 0) :
    M →ₗ[R] (A.obj.obj.V →+ B.obj.obj.V →+ M) where
  toFun m :=
    { toFun a :=
        { toFun b := (p a b).val • m
          map_zero' := by rw [map_zero, ZMod.val_zero, zero_nsmul]
          map_add' b b' := by rw [map_add, zmod_val_add_nsmul hM] }
      map_zero' := AddMonoidHom.ext fun b ↦ by
        change (p 0 b).val • m = 0
        rw [map_zero, AddMonoidHom.zero_apply, ZMod.val_zero, zero_nsmul]
      map_add' a a' := AddMonoidHom.ext fun b ↦ by
        change (p (a + a') b).val • m = (p a b).val • m + (p a' b).val • m
        rw [map_add, AddMonoidHom.add_apply, zmod_val_add_nsmul hM] }
  map_add' m m' := AddMonoidHom.ext fun a ↦ AddMonoidHom.ext fun b ↦ nsmul_add _ _ _
  map_smul' r m := AddMonoidHom.ext fun a ↦ AddMonoidHom.ext fun b ↦ (smul_comm r _ m).symm

omit [Finite R] [IsTopologicalGroup Γ] [Finite A.obj.obj.V] [Finite B.obj.obj.V] in
/-- The map of a pairing sends `m` to `a ↦ (b ↦ p(a, b) m)`. -/
lemma homTwistTwistLinear_apply {M : Type*} [AddCommGroup M] [Module R M]
    (hM : ∀ m : M, n • m = 0) (m : M) (a : A.obj.obj.V) (b : B.obj.obj.V) :
    homTwistTwistLinear R A B p hM m a b = (p a b).val • m :=
  rfl

/-- Additive maps out of a group generated by `a₀` agree if they agree on `a₀`. -/
private theorem addMonoidHom_ext_of_generator {G N : Type*} [AddGroup G] [AddCommGroup N]
    {a₀ : G} (hA : ∀ a, ∃ k : ℤ, a = k • a₀) {f g : G →+ N} (h : f a₀ = g a₀) : f = g :=
  AddMonoidHom.ext fun a ↦ by
    obtain ⟨k, rfl⟩ := hA a
    rw [map_zsmul, map_zsmul, h]

variable {A B p} in
omit [Finite R] [IsTopologicalGroup Γ] [Finite A.obj.obj.V] [Finite B.obj.obj.V] in
/-- The map of a perfect pairing is bijective: a homomorphism `A → Hom(B, M)` is determined by
the image of a pair of generators, on which the pairing is `1`. -/
theorem homTwistTwistLinear_bijective {M : Type*} [AddCommGroup M] [Module R M]
    (hM : ∀ m : M, n • m = 0) {a₀ : A.obj.obj.V} {b₀ : B.obj.obj.V} (h1 : p a₀ b₀ = 1)
    (hA : ∀ a, ∃ k : ℤ, a = k • a₀) (hB : ∀ b, ∃ l : ℤ, b = l • b₀) :
    Function.Bijective (homTwistTwistLinear R A B p hM) := by
  let := AddCommGroup.zmodModule hM
  have key : ∀ m : M, homTwistTwistLinear R A B p hM m a₀ b₀ = m := fun m ↦ by
    rw [homTwistTwistLinear_apply, h1, zmod_val_nsmul_eq_smul hM, one_smul]
  refine ⟨fun m m' h ↦ by rw [← key m, ← key m', h], fun Φ ↦ ⟨Φ a₀ b₀, ?_⟩⟩
  exact addMonoidHom_ext_of_generator hA (addMonoidHom_ext_of_generator hB (key _))

variable (hp : ∀ (γ : Γ) a b, p ((A.obj.obj.ρ γ).asHom.hom a) ((B.obj.obj.ρ γ).asHom.hom b) = p a b)
  {a₀ : A.obj.obj.V} {b₀ : B.obj.obj.V} (h1 : p a₀ b₀ = 1)
  (hA : ∀ a, ∃ k : ℤ, a = k • a₀) (hB : ∀ b, ∃ l : ℤ, b = l • b₀)
  (hM : ∀ (M : FiniteTypeContinuousModule.{u, v, w} R Γ) (m : M.obj.obj.obj.V), n • m = 0)

include hp h1 hA hB hM in
/-- **`M ≅ Hom_ℤ(A, Hom_ℤ(B, M))`** for a perfect `Γ`-invariant pairing `p : A × B → ℤ/n` and `M`
killed by `n`: `m ↦ (a ↦ (b ↦ p(a, b) m))`. -/
def homTwistTwistIso (M : FiniteTypeContinuousModule.{u, v, w} R Γ) :
    M ≅ homTwistObj R A (homTwistObj R B M) :=
  finiteTypeContinuousModuleIsoMk (M := M) (N := homTwistObj R A (homTwistObj R B M))
    (LinearEquiv.ofBijective (homTwistTwistLinear R A B p (hM M))
      (homTwistTwistLinear_bijective R (hM M) h1 hA hB))
    (fun γ m ↦ AddMonoidHom.ext fun a ↦ AddMonoidHom.ext fun b ↦ by
      change (p a b).val • (M.obj.obj.obj.ρ γ).asHom.hom m =
        (M.obj.obj.obj.ρ γ).asHom.hom
          ((p ((A.obj.obj.ρ γ⁻¹).asHom.hom a) ((B.obj.obj.ρ γ⁻¹).asHom.hom b)).val • m)
      rw [hp, map_nsmul])

include hp h1 hA hB hM in
/-- **`M ≅ Hom_ℤ(A, Hom_ℤ(B, M))` naturally in `M`**, for a perfect `Γ`-invariant pairing
`p : A × B → ℤ/n`, on finite `R`-modules with continuous action killed by `n`. -/
def homTwistTwistNatIso :
    𝟭 (FiniteTypeContinuousModule.{u, v, w} R Γ) ≅
      homTwistFunctor.{u, v, w, w} R B ⋙ homTwistFunctor.{u, v, w, w} R A :=
  NatIso.ofComponents (fun M ↦ homTwistTwistIso R A B p hp h1 hA hB hM M) fun {M M'} f ↦ by
    apply ObjectProperty.hom_ext; apply ObjectProperty.hom_ext; apply ObjectProperty.hom_ext
    apply Action.hom_ext; apply ModuleCat.hom_ext; apply LinearMap.ext
    intro m
    refine AddMonoidHom.ext fun a ↦ AddMonoidHom.ext fun b ↦ ?_
    change (p a b).val • f.hom.hom.hom.hom.hom m = f.hom.hom.hom.hom.hom ((p a b).val • m)
    rw [map_nsmul]

end Pairing

/-! ### The dual coefficient `A^* = Hom_ℤ(A, ℤ/n)` -/

section Dual

variable (Γ) in
/-- **`ℤ/n` with the trivial action of `Γ`**, as a discrete `ℤ`-`Γ`-module. -/
def zmodTrivialContinuousModule (n : ℕ) : Stacks.Injectives.ContinuousModule.{0, v, 0} ℤ Γ :=
  ofRepresentation (Representation.trivial ℤ Γ (ZMod n))
    ((isContinuous_actionOfRepresentation_iff _).mpr fun _ ↦ by
      simp only [Representation.trivial_apply, Set.ofPred_true, isOpen_univ])

variable (A : Stacks.Injectives.ContinuousModule.{0, v, w} ℤ Γ) [Finite A.obj.obj.V] (n : ℕ)
  [NeZero n]

/-- **The dual `A^* = Hom_ℤ(A, ℤ/n)`** of a finite discrete `ℤ`-`Γ`-module, with `Γ` acting by
`(γ · φ)(a) = φ(γ⁻¹ a)`. -/
def homTwistDualCoefficient : Stacks.Injectives.ContinuousModule.{0, v, w} ℤ Γ :=
  ofRepresentation (homTwistRepresentation ℤ A (zmodTrivialContinuousModule Γ n))
    (isContinuous_homTwistRepresentation ℤ A (zmodTrivialContinuousModule Γ n))

/-- The dual `A^*` of a finite group is finite. -/
instance finite_homTwistDualCoefficient :
    Finite (homTwistDualCoefficient A n).obj.obj.V :=
  haveI : Finite (A.obj.obj.V →+ ZMod n) :=
    Finite.of_injective (fun φ : A.obj.obj.V →+ ZMod n ↦ (φ : A.obj.obj.V → ZMod n))
      DFunLike.coe_injective
  inferInstanceAs (Finite (A.obj.obj.V →+ ZMod n))

/-- The evaluation pairing `A × A^* → ℤ/n`. -/
def homTwistDualCoefficientPairing :
    A.obj.obj.V →+ (homTwistDualCoefficient A n).obj.obj.V →+ ZMod n :=
  (AddMonoidHom.eval : A.obj.obj.V →+ (A.obj.obj.V →+ ZMod n) →+ ZMod n)

omit [NeZero n] in
/-- The evaluation pairing evaluates: `(a, φ) ↦ φ(a)`. -/
lemma homTwistDualCoefficientPairing_apply (a : A.obj.obj.V) (φ : A.obj.obj.V →+ ZMod n) :
    homTwistDualCoefficientPairing A n a φ = φ a :=
  rfl

omit [NeZero n] in
/-- The evaluation pairing is invariant. -/
lemma homTwistDualCoefficientPairing_ρ (γ : Γ) (a : A.obj.obj.V)
    (φ : A.obj.obj.V →+ ZMod n) :
    homTwistDualCoefficientPairing A n ((A.obj.obj.ρ γ).asHom.hom a)
      (((homTwistDualCoefficient A n).obj.obj.ρ γ).asHom.hom φ) =
      homTwistDualCoefficientPairing A n a φ := by
  change φ ((A.obj.obj.ρ γ⁻¹).asHom.hom ((A.obj.obj.ρ γ).asHom.hom a)) = φ a
  rw [← continuousModuleRho_mul_apply, inv_mul_cancel, continuousModuleRho_one_apply]

variable [IsAddCyclic A.obj.obj.V] {n} (hA : Nat.card A.obj.obj.V = n)

include hA in
/-- A pair of generators of `A` and `A^*` on which the evaluation pairing is `1`. -/
theorem exists_homTwistDualCoefficientPairing_eq_one :
    ∃ (a₀ : A.obj.obj.V) (b₀ : (homTwistDualCoefficient A n).obj.obj.V),
      homTwistDualCoefficientPairing A n a₀ b₀ = 1 ∧ (∀ a, ∃ k : ℤ, a = k • a₀) ∧
        ∀ b, ∃ l : ℤ, b = l • b₀ := by
  obtain ⟨g, hg⟩ := IsAddCyclic.exists_generator (α := A.obj.obj.V)
  let e : ZMod n ≃+ A.obj.obj.V := zmodAddEquivOfGenerator hg hA
  let b₀ : A.obj.obj.V →+ ZMod n := e.symm.toAddMonoidHom
  have hgen : ∀ a : A.obj.obj.V, a = ((e.symm a).val : ℤ) • g := fun a ↦ by
    rw [← zmodAddEquivOfGenerator_apply_intCast hg hA, Int.cast_natCast, ZMod.natCast_zmod_val,
      AddEquiv.apply_symm_apply]
  refine ⟨g, b₀, zmodAddEquivOfGenerator_symm_apply_generator hg hA, fun a ↦ ⟨_, hgen a⟩,
    fun φ ↦ ?_⟩
  let ψ : A.obj.obj.V →+ ZMod n := φ
  refine ⟨(ψ g).val, AddMonoidHom.ext fun a ↦ ?_⟩
  change ψ a = ((ψ g).val : ℤ) • e.symm a
  conv_lhs => rw [hgen a, map_zsmul]
  rw [zsmul_eq_mul, zsmul_eq_mul, Int.cast_natCast, Int.cast_natCast, ZMod.natCast_zmod_val,
    ZMod.natCast_zmod_val, mul_comm]

/-! ### The equivalence -/

variable (hM : ∀ (M : FiniteTypeContinuousModule.{u, v, w} R Γ) (m : M.obj.obj.obj.V), n • m = 0)

include hA hM in
/-- **The twist `Hom_ℤ(A, -)` is an autoequivalence** of finite `R`-modules with a continuous
action of `Γ` killed by `n`, for `A` cyclic of order `n`: its inverse is `Hom_ℤ(A^*, -)` for
`A^* = Hom_ℤ(A, ℤ/n)`, through the evaluation pairing `A × A^* → ℤ/n`. -/
def homTwistEquivalence :
    FiniteTypeContinuousModule.{u, v, w} R Γ ≌ FiniteTypeContinuousModule.{u, v, w} R Γ :=
  have h := (exists_homTwistDualCoefficientPairing_eq_one A hA).choose_spec.choose_spec
  CategoryTheory.Equivalence.mk (homTwistFunctor.{u, v, w, w} R A)
    (homTwistFunctor.{u, v, w, w} R (homTwistDualCoefficient A n))
    (homTwistTwistNatIso R (homTwistDualCoefficient A n) A
      (homTwistDualCoefficientPairing A n).flip
      (fun γ φ a ↦ homTwistDualCoefficientPairing_ρ A n γ a φ) h.1 h.2.2 h.2.1 hM)
    (homTwistTwistNatIso R A (homTwistDualCoefficient A n) (homTwistDualCoefficientPairing A n)
      (homTwistDualCoefficientPairing_ρ A n) h.1 h.2.1 h.2.2 hM).symm

/-- The functor of the equivalence is the twist `Hom_ℤ(A, -)`. -/
lemma homTwistEquivalence_functor :
    (homTwistEquivalence R A hA hM).functor = homTwistFunctor.{u, v, w, w} R A :=
  rfl

end Dual

end Stacks.GroupCohomology

end
