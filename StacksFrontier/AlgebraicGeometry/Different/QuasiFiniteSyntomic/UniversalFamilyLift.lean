module

public import StacksFrontier.AlgebraicGeometry.Different.QuasiFiniteSyntomic.UniversalFamilyBaseChange

/-!
# The universal quasi-finite family in an arbitrary universe, and Stacks 0FKA

The universal family `Y_{n,d} ⟶ X_{n,d}` of Example 0FK8 is built from the polynomial ring
`A = ℤ[a_{i,E}]` and so lives in `Scheme.{0}`. This file builds the same family over the
universe lift `ULift.{u} A` of the coefficient ring, giving a morphism of `Scheme.{u}` for every
universe `u`. Its quotient algebra `A[x₁, …, xₙ]/(f₁, …, fₙ)` is identified with the universe lift
of the quotient algebra `B` of Example 0FK8, compatibly with the structure maps. Over this
family we prove Stacks 0FKA for schemes in every universe.

## Main definitions

* `AlgebraicGeometry.universalCoefficientRingLift` is `ULift.{u} A`.
* `AlgebraicGeometry.universalPolynomialLift` is the image of the universal polynomial `f_i`.
* `AlgebraicGeometry.universalQuotientRingLift` is the quotient algebra over `ULift.{u} A`.
* `AlgebraicGeometry.universalBaseSchemeLift` and
  `AlgebraicGeometry.universalQuasiFiniteSchemeLift` are `X_{n,d}` and `Y_{n,d}` in `Scheme.{u}`.
* `AlgebraicGeometry.universalQuasiFiniteMorphismLift` is the morphism `Y_{n,d} ⟶ X_{n,d}` in
  `Scheme.{u}`.

## Main results

* `AlgebraicGeometry.universalQuotientRingLiftEquiv` and
  `AlgebraicGeometry.universalQuotientRingLiftEquiv_algebraMap`: the lifted quotient algebra is
  the universe lift of `B`, compatibly with the structure maps.
* `AlgebraicGeometry.exists_isPullback_universalQuasiFiniteMorphismLift`: **Stacks 0FKA**.
  A locally quasi-finite syntomic morphism of `Scheme.{u}` is, around every point of its source,
  a base change of `Y_{n,d} ⟶ X_{n,d}`.
* `AlgebraicGeometry.mem_universalQuasiFiniteOpenLift_iff` identifies the points of the lifted
  quasi-finite open.

## References

* [Stacks Project, Tag 0FK8](https://stacks.math.columbia.edu/tag/0FK8)
* [Stacks Project, Tag 0FKA](https://stacks.math.columbia.edu/tag/0FKA)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits
open scoped TensorProduct

universe u

namespace AlgebraicGeometry

/-- The coefficient ring `A = ℤ[a_{i,E}]` of Example 0FK8, lifted to the universe `u`. -/
abbrev universalCoefficientRingLift (n d : ℕ) : Type u :=
  ULift.{u} (universalCoefficientRing n d)

/-- The universal polynomials `f_i` of Example 0FK8, with coefficients in the lifted coefficient
ring `universalCoefficientRingLift`. -/
def universalPolynomialLift (n d : ℕ) (i : Fin n) :
    MvPolynomial (Fin n) (universalCoefficientRingLift.{u} n d) :=
  MvPolynomial.map (ULift.ringEquiv.symm.toRingHom : universalCoefficientRing n d →+* _)
    (universalPolynomial n d i)

/-- The ideal generated by the lifted universal polynomials. -/
abbrev universalRelationIdealLift (n d : ℕ) :
    Ideal (MvPolynomial (Fin n) (universalCoefficientRingLift.{u} n d)) :=
  Ideal.span (Set.range (universalPolynomialLift.{u} n d))

/-- The universal quotient algebra `B = A[x₁, …, xₙ]/(f₁, …, fₙ)` of Example 0FK8 over the lifted
coefficient ring. -/
abbrev universalQuotientRingLift (n d : ℕ) : Type u :=
  MvPolynomial (Fin n) (universalCoefficientRingLift.{u} n d) ⧸ universalRelationIdealLift.{u} n d

/-- Mapping the lifted universal polynomials back along `ULift.ringEquiv` recovers the universal
polynomials. -/
theorem map_universalPolynomialLift (n d : ℕ) (i : Fin n) :
    MvPolynomial.map (ULift.ringEquiv.toRingHom : universalCoefficientRingLift.{u} n d →+* _)
      (universalPolynomialLift.{u} n d i) = universalPolynomial n d i := by
  rw [universalPolynomialLift, MvPolynomial.map_map]
  convert MvPolynomial.map_id (universalPolynomial n d i)
  exact RingHom.ext fun _ ↦ rfl

/-- The lifted quotient algebra is the universe lift of the quotient algebra `B` of
Example 0FK8. -/
def universalQuotientRingLiftEquiv (n d : ℕ) :
    universalQuotientRingLift.{u} n d ≃+* ULift.{u} (universalQuotientRing n d) :=
  (Ideal.quotientEquiv (universalRelationIdealLift.{u} n d) (universalRelationIdeal n d)
    (MvPolynomial.mapEquiv (Fin n) ULift.ringEquiv) (by
      rw [universalRelationIdealLift, Ideal.map_span, ← Set.range_comp]
      exact congrArg (fun s ↦ Ideal.span (Set.range s))
        (funext fun i ↦ (map_universalPolynomialLift n d i).symm))).trans ULift.ringEquiv.symm

/-- The identification `universalQuotientRingLiftEquiv` is compatible with the structure maps
from the coefficient rings. -/
theorem universalQuotientRingLiftEquiv_algebraMap (n d : ℕ)
    (a : universalCoefficientRingLift.{u} n d) :
    universalQuotientRingLiftEquiv n d (algebraMap _ _ a)
      = ULift.up (algebraMap (universalCoefficientRing n d) (universalQuotientRing n d) a.down) :=
  ULift.ext (by
    simp [universalQuotientRingLiftEquiv, Ideal.quotientEquiv_apply,
      ULift.ringEquiv]
    rfl)

/-- The coefficient scheme `X_{n,d} = Spec(A)` of Example 0FK8 as an object of `Scheme.{u}`. -/
def universalBaseSchemeLift (n d : ℕ) [NeZero n] [NeZero d] : Scheme.{u} :=
  Spec (.of (universalCoefficientRingLift.{u} n d))

/-- The affine scheme `Spec(B)` of Example 0FK8 as an object of `Scheme.{u}`. -/
def universalAmbientSchemeLift (n d : ℕ) [NeZero n] [NeZero d] : Scheme.{u} :=
  Spec (.of (universalQuotientRingLift.{u} n d))

/-- The morphism `Spec(B) ⟶ Spec(A)` of Example 0FK8 in `Scheme.{u}`. -/
def universalAmbientMorphismLift (n d : ℕ) [NeZero n] [NeZero d] :
    universalAmbientSchemeLift.{u} n d ⟶ universalBaseSchemeLift.{u} n d :=
  Spec.map (CommRingCat.ofHom
    (algebraMap (universalCoefficientRingLift.{u} n d) (universalQuotientRingLift.{u} n d)))

/-- The lifted ambient family is locally of finite type. -/
instance universalAmbientMorphismLift_locallyOfFiniteType
    (n d : ℕ) [NeZero n] [NeZero d] :
    LocallyOfFiniteType (universalAmbientMorphismLift.{u} n d) := by
  unfold universalAmbientMorphismLift universalAmbientSchemeLift universalBaseSchemeLift
  rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
  exact RingHom.finiteType_algebraMap.mpr inferInstance

/-- The maximal open of `Spec(B)` on which `B` is quasi-finite over `A`, in `Scheme.{u}`. -/
def universalQuasiFiniteOpenLift (n d : ℕ) [NeZero n] [NeZero d] :
    (universalAmbientSchemeLift.{u} n d).Opens :=
  (universalAmbientMorphismLift.{u} n d).quasiFiniteLocus

/-- A point lies in the lifted universal quasi-finite open exactly when the lifted ambient
morphism is quasi-finite at that point in the sense of Tag 01TD. -/
@[simp]
theorem mem_universalQuasiFiniteOpenLift_iff
    (n d : ℕ) [NeZero n] [NeZero d] (x : universalAmbientSchemeLift.{u} n d) :
    x ∈ universalQuasiFiniteOpenLift n d ↔
      quasiFiniteAt (universalAmbientMorphismLift.{u} n d) x := by
  rw [universalQuasiFiniteOpenLift, Scheme.Hom.mem_quasiFiniteLocus]
  refine ⟨fun hx ↦ ⟨?_, hx⟩, And.right⟩
  have hbase : IsAffine (universalBaseSchemeLift.{u} n d) := by
    change IsAffine (Spec (.of (universalCoefficientRingLift.{u} n d)))
    infer_instance
  have hamb : IsAffine (universalAmbientSchemeLift.{u} n d) := by
    change IsAffine (Spec (.of (universalQuotientRingLift.{u} n d)))
    infer_instance
  exact ⟨⟨⊤, isAffineOpen_top _⟩, ⟨⊤, isAffineOpen_top _⟩, by simp, by simp,
    LocallyOfFiniteType.finiteType_appLE (universalAmbientMorphismLift.{u} n d)
      (isAffineOpen_top _) (isAffineOpen_top _) (by simp)⟩

/-- The open subscheme `Y_{n,d}` of Example 0FK8 as an object of `Scheme.{u}`. -/
def universalQuasiFiniteSchemeLift (n d : ℕ) [NeZero n] [NeZero d] : Scheme.{u} :=
  universalQuasiFiniteOpenLift.{u} n d

/-- The morphism `Y_{n,d} ⟶ X_{n,d}` of Example 0FK8 in `Scheme.{u}`. -/
def universalQuasiFiniteMorphismLift (n d : ℕ) [NeZero n] [NeZero d] :
    universalQuasiFiniteSchemeLift.{u} n d ⟶ universalBaseSchemeLift.{u} n d :=
  (universalQuasiFiniteOpenLift.{u} n d).ι ≫ universalAmbientMorphismLift.{u} n d

/-- The lifted morphism `Y_{n,d} ⟶ X_{n,d}` is locally quasi-finite. -/
instance universalQuasiFiniteMorphismLift_locallyQuasiFinite
    (n d : ℕ) [NeZero n] [NeZero d] :
    LocallyQuasiFinite (universalQuasiFiniteMorphismLift.{u} n d) := by
  change LocallyQuasiFinite
    ((universalAmbientMorphismLift.{u} n d).quasiFiniteLocus.ι ≫
      universalAmbientMorphismLift.{u} n d)
  infer_instance

/-! ### The cartesian square in an arbitrary universe -/

/-- **The base change of the lifted universal family.** If the relations of a square presentation
of `S` over `R` are the specializations of the lifted universal polynomials along `A → R`, then
`S` is the base change `R ⊗_A B` of the lifted universal quotient algebra. -/
private def universalBaseChangeEquivLift (n d : ℕ) {R S : Type u} [CommRing R] [CommRing S]
    [Algebra (universalCoefficientRingLift.{u} n d) R] [Algebra R S]
    [Algebra (universalCoefficientRingLift.{u} n d) S]
    [IsScalarTower (universalCoefficientRingLift.{u} n d) R S]
    (P : Algebra.Presentation R S (Fin n) (Fin n))
    (hrel : ∀ i, MvPolynomial.map (algebraMap (universalCoefficientRingLift.{u} n d) R)
      (universalPolynomialLift n d i) = P.relation i) :
    (R ⊗[universalCoefficientRingLift.{u} n d] universalQuotientRingLift.{u} n d) ≃ₐ[R] S :=
  let Q : Algebra.Presentation (universalCoefficientRingLift.{u} n d)
      (universalQuotientRingLift.{u} n d) (Fin n) (Fin n) :=
    Algebra.Presentation.naive (v := universalPolynomialLift n d)
  let Q' := Q.baseChange R
  have hker : Q'.ker = P.ker := by
    rw [← Q'.span_range_relation_eq_ker, ← P.span_range_relation_eq_ker]
    exact congrArg (Ideal.span ·) (congrArg Set.range (funext hrel))
  (Q'.quotientEquiv.restrictScalars R).symm.trans
    (((Ideal.quotientEquivAlgOfEq Q'.Ring hker).restrictScalars R).trans
      (P.quotientEquiv.restrictScalars R))

/-- If the relations of a square presentation of `S` over `R` are the specializations of the
lifted universal polynomials along `φ`, then `Spec S ⟶ Spec R` is a base change of the lifted
universal ambient morphism `Spec B ⟶ Spec A` of Example 0FK8. -/
theorem exists_isPullback_Spec_universalAmbientMorphismLift (n d : ℕ) [NeZero n] [NeZero d]
    {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
    (φ : universalCoefficientRingLift.{u} n d →+* R)
    (P : Algebra.Presentation R S (Fin n) (Fin n))
    (hrel : ∀ i, MvPolynomial.map φ (universalPolynomialLift n d i) = P.relation i) :
    ∃ g : Spec (CommRingCat.of S) ⟶ universalAmbientSchemeLift.{u} n d,
      IsPullback (Spec.map (CommRingCat.ofHom (algebraMap R S))) g
        (Spec.map (CommRingCat.ofHom φ) :
          Spec (CommRingCat.of R) ⟶ universalBaseSchemeLift.{u} n d)
        (universalAmbientMorphismLift.{u} n d) := by
  let _ : Algebra (universalCoefficientRingLift.{u} n d) R := φ.toAlgebra
  let _ : Algebra (universalCoefficientRingLift.{u} n d) S := ((algebraMap R S).comp φ).toAlgebra
  have : IsScalarTower (universalCoefficientRingLift.{u} n d) R S := .of_algebraMap_eq fun _ ↦ rfl
  let e := universalBaseChangeEquivLift n d P hrel
  let _ : Algebra (universalQuotientRingLift.{u} n d) S :=
    RingHom.toAlgebra (e.toAlgHom.toRingHom.comp
      (Algebra.TensorProduct.includeRight (R := universalCoefficientRingLift.{u} n d)
        (A := R) (B := universalQuotientRingLift.{u} n d)).toRingHom)
  have htower := IsScalarTower.of_algebraMap_eq (R := universalCoefficientRingLift.{u} n d)
      (S := universalQuotientRingLift.{u} n d) (A := S) fun a ↦ by
    change algebraMap (universalCoefficientRingLift.{u} n d) S a
        = e ((1 : R) ⊗ₜ[universalCoefficientRingLift.{u} n d]
            algebraMap (universalCoefficientRingLift.{u} n d) (universalQuotientRingLift.{u} n d) a)
    exact (e.commutes (algebraMap (universalCoefficientRingLift.{u} n d) R a)).symm.trans
      (congrArg e ((Algebra.TensorProduct.algebraMap_apply
        (R := universalCoefficientRingLift.{u} n d)
        (S := universalCoefficientRingLift.{u} n d) a).symm.trans
        (Algebra.TensorProduct.algebraMap_apply' a)))
  have hpo : Algebra.IsPushout (universalCoefficientRingLift.{u} n d) R
      (universalQuotientRingLift.{u} n d) S :=
    ⟨IsBaseChange.of_equiv e.toLinearEquiv fun _ ↦ rfl⟩
  refine ⟨Spec.map (CommRingCat.ofHom (algebraMap (universalQuotientRingLift.{u} n d) S)), ?_⟩
  exact (isPullback_SpecMap_of_isPushout _ _ _ _
    (CommRingCat.isPushout_of_isPushout (universalCoefficientRingLift.{u} n d) R
      (universalQuotientRingLift.{u} n d) S)).of_iso' (Iso.refl _) (Iso.refl _)
    (Iso.refl (universalAmbientSchemeLift.{u} n d)) (Iso.refl (universalBaseSchemeLift.{u} n d))
    ((Category.id_comp _).trans (Category.comp_id _).symm)
    ((Category.id_comp _).trans (Category.comp_id _).symm)
    ((Category.id_comp _).trans (Category.comp_id _).symm)
    ((Category.id_comp _).trans (Category.comp_id _).symm)

/-- **Stacks Project, Tag 0FKA.** Let `f : Y ⟶ X` be a morphism of schemes satisfying the
equivalent conditions of Stacks 0BWE (locally quasi-finite and syntomic). Then for every point
`y` of `Y` there are integers `n, d ≥ 1`, opens `U ⊆ X` and `V ⊆ Y` with `y ∈ V` and
`f(V) ⊆ U`, and a commutative diagram
```
Y ← V → Y_{n, d}
↓   ↓      ↓
X ← U → X_{n, d}
```
whose left-hand square is formed by the open immersions and the restriction `f.resLE U V hVU`,
and whose right-hand square, over the family `Y_{n, d} ⟶ X_{n, d}` of Example 0FK8, is
cartesian. The schemes may live in any universe `u`; the family `Y_{n, d} ⟶ X_{n, d}` is then
`universalQuasiFiniteMorphismLift`, the family of Example 0FK8 built over the universe lift of
the coefficient ring `ℤ[a_{i, E}]` (see `universalQuotientRingLiftEquiv`). -/
@[stacks 0FKA "The left-hand square is `Scheme.Hom.resLE` with the open immersions `U.ι`, `V.ι`;
the right-hand cartesian square is an `IsPullback` over `universalQuasiFiniteMorphismLift`, the
family `Y_{n, d} ⟶ X_{n, d}` of Example 0FK8 in the universe of `X` and `Y`."]
theorem exists_isPullback_universalQuasiFiniteMorphismLift {Y X : Scheme.{u}} {f : Y ⟶ X}
    (hqf : LocallyQuasiFinite f) (hsyn : Syntomic f) (y : Y) :
    ∃ (U : X.Opens) (V : Y.Opens) (_ : y ∈ V) (hVU : V ≤ f ⁻¹ᵁ U) (n d : ℕ)
      (_ : NeZero n) (_ : NeZero d) (p : U.toScheme ⟶ universalBaseSchemeLift.{u} n d)
      (q : V.toScheme ⟶ universalQuasiFiniteSchemeLift.{u} n d),
      IsPullback (f.resLE U V hVU) q p (universalQuasiFiniteMorphismLift.{u} n d) := by
  obtain ⟨V, U, hyV, hVU, n, d, hn, hd, φ₀, P, hrel₀⟩ :=
    exists_universalPolynomial_specialization
      ((hasLocalSquareRelativeGlobalCompleteIntersection_iff f).mpr ⟨hqf, hsyn⟩) y
  have := hn
  have := hd
  let _ : Algebra Γ(X, U.1) Γ(Y, V.1) := (f.appLE U.1 V.1 hVU).hom.toAlgebra
  let φ : universalCoefficientRingLift.{u} n d →+* Γ(X, U.1) :=
    φ₀.comp ULift.ringEquiv.toRingHom
  have hrel : ∀ i, MvPolynomial.map φ (universalPolynomialLift n d i) = P.relation i := by
    intro i
    rw [← hrel₀, ← map_universalPolynomialLift.{u} n d i, MvPolynomial.map_map]
  obtain ⟨g, hsqU⟩ := exists_isPullback_Spec_universalAmbientMorphismLift n d φ P hrel
  have hV : IsAffineOpen V.1 := V.2
  have hU : IsAffineOpen U.1 := U.2
  have hgeom := isPullback_resLE_of_isPullback_SpecMap_appLE f hU hV hVU hsqU
  refine ⟨U.1, V.1, hyV, hVU, n, d, hn, hd,
    hU.isoSpec.hom ≫ Spec.map (CommRingCat.ofHom φ), ?_⟩
  have hfp : LocallyOfFinitePresentation f := locallyOfFinitePresentation hsyn
  have hambFT : LocallyOfFiniteType (universalAmbientMorphismLift.{u} n d) := inferInstance
  have hrange : Set.range (hV.isoSpec.hom ≫ g) ⊆
      Set.range (universalQuasiFiniteOpenLift.{u} n d).ι := by
    have hlocus := @quasiFiniteLocus_eq_preimage_of_isPullback _ _ _ _ _ _ _ _ hambFT
      hsqU.flip
    rintro _ ⟨z, rfl⟩
    have hz := (mem_quasiFiniteLocus_iff
      (Spec.map (CommRingCat.ofHom (algebraMap Γ(X, U.1) Γ(Y, V.1)))) (hV.isoSpec.hom z)).mpr
      (((forall_quasiFiniteAt_iff _).mpr
        ⟨(HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)).mpr
            (HasRingHomProperty.appLE (@LocallyOfFiniteType) f inferInstance U V hVU),
          (HasRingHomProperty.Spec_iff (P := @LocallyQuasiFinite)).mpr
            (HasRingHomProperty.appLE (@LocallyQuasiFinite) f hqf U V hVU)⟩)
        (hV.isoSpec.hom z))
    rw [hlocus] at hz
    exact ⟨⟨_, (mem_universalQuasiFiniteOpenLift_iff n d _).mpr
      ((mem_quasiFiniteLocus_iff _ _).mp hz)⟩, rfl⟩
  refine ⟨(IsOpenImmersion.lift (universalQuasiFiniteOpenLift.{u} n d).ι _ hrange :
    V.1.toScheme ⟶ (universalQuasiFiniteOpenLift.{u} n d).toScheme), ?_⟩
  have hpaste := ((IsOpenImmersion.isPullback_lift_id _ (universalQuasiFiniteOpenLift.{u} n d).ι
    hrange).paste_vert hgeom.flip).flip
  rw [Category.id_comp] at hpaste
  exact hpaste

end AlgebraicGeometry
