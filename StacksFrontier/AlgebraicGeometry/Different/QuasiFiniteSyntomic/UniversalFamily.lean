module

public import Mathlib.AlgebraicGeometry.ZariskisMainTheorem
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Morphisms.QuasiFinite.Defs

/-!
# The universal quasi-finite family

For positive integers `n` and `d` we form the polynomial ring `A = ℤ[a_{i,E}]` whose variables
are the coefficients of `n` polynomials in `n` variables of total degree at most `d`. Adjoining
the variables `x₁, …, xₙ` and quotienting by the `n` universal polynomials gives an affine
family `Spec B → Spec A`. Restricting to the quasi-finite locus of that family produces the
universal open subscheme `Y_{n,d}` over the coefficient scheme `X_{n,d}`, and this restriction
is quasi-finite. Moreover `Y_{n,d}` is the largest open subscheme of `Spec B` with that
property.

## Main definitions

* `AlgebraicGeometry.MultiIndex` is the finite set of exponent vectors of total degree at most
  `d`.
* `AlgebraicGeometry.universalCoefficientRing` is the ring `A` of universal coefficients.
* `AlgebraicGeometry.universalPolynomial` is the polynomial `f_i`.
* `AlgebraicGeometry.universalQuotientRing` is the quotient algebra `B`.
* `AlgebraicGeometry.universalBaseScheme` and `AlgebraicGeometry.universalQuasiFiniteScheme` are
  `X_{n,d}` and `Y_{n,d}`.
* `AlgebraicGeometry.universalQuasiFiniteMorphism` is the restricted morphism
  `Y_{n,d} ⟶ X_{n,d}`.

## Main results

* `AlgebraicGeometry.universalQuasiFiniteMorphism_locallyOfFiniteType`,
  `AlgebraicGeometry.universalQuasiFiniteMorphism_quasiCompact`, and
  `AlgebraicGeometry.universalQuasiFiniteMorphism_locallyQuasiFinite` state that the restricted
  morphism is quasi-finite.
* `AlgebraicGeometry.mem_universalQuasiFiniteOpen_iff` identifies the points of the open.
* `AlgebraicGeometry.universalQuasiFiniteOpen_greatest` says that this is the greatest open on
  which the ambient morphism is locally quasi-finite.

## Implementation notes

An exponent vector is represented by a function `Fin n → Fin (d + 1)` satisfying the total
degree bound; the bound implies that this is exactly the set of nonnegative multi-indices in the
source. Mathlib's `Scheme.Hom.quasiFiniteLocus` is used for the open subscheme. Quasi-finiteness
of a morphism is represented by the three properties `LocallyOfFiniteType`, `QuasiCompact` and
`LocallyQuasiFinite`. The greatest-open result is stated under the weaker, pointwise condition
`LocallyQuasiFinite`; in particular it applies to every open on which the restriction is
quasi-finite.

## References

* [Stacks Project, Tag 0FK8](https://stacks.math.columbia.edu/tag/0FK8)
-/

@[expose] public noncomputable section

open scoped BigOperators
open AlgebraicGeometry CategoryTheory

namespace AlgebraicGeometry

/-- The finite set of multi-indices in `n` variables having total degree at most `d`. -/
@[stacks 0FK8 "the multi-index set"]
abbrev MultiIndex (n d : ℕ) :=
  { E : Fin n → Fin (d + 1) // ∑ i, (E i : ℕ) ≤ d }

/-- The finitely supported exponent vector associated to a bounded multi-index. -/
def multiIndexExponent (n d : ℕ) (E : MultiIndex n d) : Fin n →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm (fun i ↦ E.1 i)

/-- Distinct bounded multi-indices have distinct exponent vectors. -/
theorem multiIndexExponent_injective (n d : ℕ) :
    Function.Injective (multiIndexExponent n d) := by
  intro E F h
  refine Subtype.ext (funext fun i ↦ Fin.ext ?_)
  simpa [multiIndexExponent] using congrArg (fun m : Fin n →₀ ℕ ↦ m i) h

/-- The polynomial ring `A = ℤ[a_{i,E}]` of universal coefficients. -/
@[stacks 0FK8 "the universal coefficient ring"]
abbrev universalCoefficientRing (n d : ℕ) :=
  MvPolynomial (Fin n × MultiIndex n d) ℤ

/-- The universal coefficient `a_{i,E}` in the coefficient ring. -/
def universalCoefficient (n d : ℕ) (i : Fin n) (E : MultiIndex n d) :
    universalCoefficientRing n d :=
  MvPolynomial.X (i, E)

/-- The universal polynomial `f_i = ∑_E a_{i,E} x^E`. -/
@[stacks 0FK8 "the universal polynomials"]
def universalPolynomial (n d : ℕ) (i : Fin n) :
    MvPolynomial (Fin n) (universalCoefficientRing n d) :=
  ∑ E : MultiIndex n d,
    MvPolynomial.monomial (multiIndexExponent n d E) (universalCoefficient n d i E)

/-- The ideal generated by the `n` universal polynomials. -/
abbrev universalRelationIdeal (n d : ℕ) :
    Ideal (MvPolynomial (Fin n) (universalCoefficientRing n d)) :=
  Ideal.span (Set.range (universalPolynomial n d))

/-- The universal quotient algebra `B = A[x₁, …, xₙ]/(f₁, …, fₙ)`. -/
@[stacks 0FK8 "the universal quotient algebra"]
abbrev universalQuotientRing (n d : ℕ) :=
  (MvPolynomial (Fin n) (universalCoefficientRing n d)) ⧸ universalRelationIdeal n d

/-- The coefficient scheme `X_{n,d} = Spec(A)`. -/
@[stacks 0FK8 "the coefficient scheme X_{n,d}"]
def universalBaseScheme (n d : ℕ) [NeZero n] [NeZero d] : Scheme :=
  Spec (.of (universalCoefficientRing n d))

/-- The affine scheme `Spec(B)` before restriction to its quasi-finite locus. -/
@[stacks 0FK8 "the ambient scheme Spec(B)"]
def universalAmbientScheme (n d : ℕ) [NeZero n] [NeZero d] : Scheme :=
  Spec (.of (universalQuotientRing n d))

/-- The morphism `Spec(B) ⟶ Spec(A)` induced by the universal algebra structure. -/
@[stacks 0FK8 "the ambient morphism Spec(B) ⟶ Spec(A)"]
def universalAmbientMorphism (n d : ℕ) [NeZero n] [NeZero d] :
    universalAmbientScheme n d ⟶ universalBaseScheme n d :=
  Spec.map (CommRingCat.ofHom
    (algebraMap (universalCoefficientRing n d) (universalQuotientRing n d)))

/-- The ambient universal family is locally of finite type. -/
instance universalAmbientMorphism_locallyOfFiniteType
    (n d : ℕ) [NeZero n] [NeZero d] :
    LocallyOfFiniteType (universalAmbientMorphism n d) := by
  unfold universalAmbientMorphism universalAmbientScheme universalBaseScheme
  rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType)]
  exact RingHom.finiteType_algebraMap.mpr inferInstance

/-- The maximal open of `Spec(B)` on which the universal algebra is quasi-finite over `A`. -/
@[stacks 0FK8 "the maximal quasi-finite open"]
def universalQuasiFiniteOpen (n d : ℕ) [NeZero n] [NeZero d] :
    (universalAmbientScheme n d).Opens :=
  (universalAmbientMorphism n d).quasiFiniteLocus

/-- A point lies in the universal quasi-finite open exactly when the ambient morphism is
quasi-finite at that point in the sense of Tag 01TD. -/
@[simp, stacks 0FK8 "the points of the maximal quasi-finite open"]
theorem mem_universalQuasiFiniteOpen_iff
    (n d : ℕ) [NeZero n] [NeZero d] (x : universalAmbientScheme n d) :
    x ∈ universalQuasiFiniteOpen n d ↔
      quasiFiniteAt (universalAmbientMorphism n d) x := by
  rw [universalQuasiFiniteOpen, Scheme.Hom.mem_quasiFiniteLocus]
  refine ⟨fun hx ↦ ⟨?_, hx⟩, And.right⟩
  have hbase : IsAffine (universalBaseScheme n d) := by
    change IsAffine (Spec (.of (universalCoefficientRing n d)))
    infer_instance
  have hamb : IsAffine (universalAmbientScheme n d) := by
    change IsAffine (Spec (.of (universalQuotientRing n d)))
    infer_instance
  exact ⟨⟨⊤, isAffineOpen_top _⟩, ⟨⊤, isAffineOpen_top _⟩, by simp, by simp,
    LocallyOfFiniteType.finiteType_appLE (universalAmbientMorphism n d)
      (isAffineOpen_top _) (isAffineOpen_top _) (by simp)⟩

/-- The universal open subscheme `Y_{n,d}`. -/
@[stacks 0FK8 "the open subscheme Y_{n,d}"]
def universalQuasiFiniteScheme (n d : ℕ) [NeZero n] [NeZero d] : Scheme :=
  universalQuasiFiniteOpen n d

/-- The restriction `Y_{n,d} ⟶ X_{n,d}` of the universal affine family. -/
@[stacks 0FK8 "the morphism Y_{n,d} ⟶ X_{n,d}"]
def universalQuasiFiniteMorphism (n d : ℕ) [NeZero n] [NeZero d] :
    universalQuasiFiniteScheme n d ⟶ universalBaseScheme n d :=
  (universalQuasiFiniteOpen n d).ι ≫ universalAmbientMorphism n d

/-- The morphism `Y_{n,d} ⟶ X_{n,d}` is locally of finite type. -/
@[stacks 0FK8 "the restricted morphism is locally of finite type"]
instance universalQuasiFiniteMorphism_locallyOfFiniteType
    (n d : ℕ) [NeZero n] [NeZero d] :
    LocallyOfFiniteType (universalQuasiFiniteMorphism n d) := by
  change LocallyOfFiniteType
    ((universalQuasiFiniteOpen n d).ι ≫ universalAmbientMorphism n d)
  infer_instance

/-- The morphism `Y_{n,d} ⟶ X_{n,d}` is quasi-compact. -/
@[stacks 0FK8 "the restricted morphism is quasi-compact"]
instance universalQuasiFiniteMorphism_quasiCompact
    (n d : ℕ) [NeZero n] [NeZero d] :
    QuasiCompact (universalQuasiFiniteMorphism n d) := by
  have : IsNoetherian (universalAmbientScheme n d) := by
    change IsNoetherian (Spec (.of (universalQuotientRing n d)))
    infer_instance
  have : TopologicalSpace.NoetherianSpace (universalQuasiFiniteScheme n d) := by
    change TopologicalSpace.NoetherianSpace (universalQuasiFiniteOpen n d : Scheme)
    exact TopologicalSpace.NoetherianSpace.set
      (universalQuasiFiniteOpen n d : Set (universalAmbientScheme n d))
  change QuasiCompact
    ((universalQuasiFiniteOpen n d).ι ≫ universalAmbientMorphism n d)
  infer_instance

/-- The morphism `Y_{n,d} ⟶ X_{n,d}` is locally quasi-finite. -/
@[stacks 0FK8 "the restricted morphism is locally quasi-finite"]
instance universalQuasiFiniteMorphism_locallyQuasiFinite
    (n d : ℕ) [NeZero n] [NeZero d] :
    LocallyQuasiFinite (universalQuasiFiniteMorphism n d) := by
  change LocallyQuasiFinite
    ((universalAmbientMorphism n d).quasiFiniteLocus.ι ≫ universalAmbientMorphism n d)
  infer_instance

/-- `Y_{n,d}` is the greatest open subscheme of `Spec(B)` on which the restriction of
the ambient morphism is locally quasi-finite. -/
@[stacks 0FK8 "maximality of the quasi-finite open"]
theorem universalQuasiFiniteOpen_greatest
    (n d : ℕ) [NeZero n] [NeZero d] (U : (universalAmbientScheme n d).Opens)
    [LocallyQuasiFinite (U.ι ≫ universalAmbientMorphism n d)] :
    U ≤ universalQuasiFiniteOpen n d := by
  intro x hx
  change (universalAmbientMorphism n d).QuasiFiniteAt x
  have hq := (U.ι ≫ universalAmbientMorphism n d).quasiFiniteAt ⟨x, hx⟩
  have hq' := (Scheme.Hom.quasiFiniteAt_comp_iff_of_isOpenImmersion
    (f := U.ι) (g := universalAmbientMorphism n d)).mp hq
  change (universalAmbientMorphism n d).QuasiFiniteAt x
  exact hq'

end AlgebraicGeometry
