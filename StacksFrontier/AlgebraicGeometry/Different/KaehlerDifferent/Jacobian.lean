/-!
# The Kähler different of a complete-intersection presentation

Let `B = A[x_1, …, x_n]/(f_1, …, f_n)` be a quotient of a polynomial ring by as many equations as
there are variables. Then the Kähler different of `B` over `A` — the zeroth Fitting ideal of
`Ω[B⁄A]` — is generated by the image of the determinant of the Jacobian matrix
`(∂f_i/∂x_j)_{i,j}`.

## Main results

* `Stacks.Discriminant.fittingIdeal_kaehlerDifferential_quotient_mvPolynomial` computes the zeroth
  Fitting ideal of the relative differentials of such a quotient.

## Implementation notes

The Kähler different of an affine algebra is the zeroth Fitting ideal of its module of
differentials; `Stacks.Discriminant.kaehlerDifferent` is its sheaf-theoretic counterpart. The
computation presents `Ω[B⁄A]` by the conormal sequence of the presentation: the cotangent module
of the defining ideal is generated by the classes of the `f_i`, and the comparison with the
base-changed polynomial basis sends the class of `f_i` to the `i`-th column of the Jacobian. The
formula also holds for zero variables, so no positivity hypothesis on the number of variables is
needed.

## References

* [Stacks Project, Tag 0BVZ](https://stacks.math.columbia.edu/tag/0BVZ)
-/

@[expose] public section

universe u v w

namespace Stacks.Discriminant

/-- Scalars act on the cotangent module of the kernel of a surjection through the quotient: the
class of `r • x` is the image of `r` acting on the class of `x`. -/
theorem toCotangent_smul_of_surjective {R : Type u} {B : Type v} [CommRing R] [CommRing B]
    [Algebra R B] (h : Function.Surjective (algebraMap R B))
    (r : R) (x : RingHom.ker (algebraMap R B)) :
    letI := ConormalSeq.cotangentModule h
    (RingHom.ker (algebraMap R B)).toCotangent (r • x) =
      (algebraMap R B r) • (RingHom.ker (algebraMap R B)).toCotangent x := by
  let _ := ConormalSeq.cotangentModule h
  let e := RingHom.quotientKerEquivOfSurjective h
  calc
    _ = r • (RingHom.ker (algebraMap R B)).toCotangent x := map_smul _ _ _
    _ = (Ideal.Quotient.mk (RingHom.ker (algebraMap R B)) r) •
        (RingHom.ker (algebraMap R B)).toCotangent x :=
      (IsScalarTower.algebraMap_smul (A := R ⧸ RingHom.ker (algebraMap R B)) r _).symm
    _ = (e.symm (algebraMap R B r)) • _ := by
      rw [RingHom.quotientKerEquivOfSurjective_symm_apply]
    _ = _ := rfl

/-- If the kernel of a surjection `R → B` is generated by a finite family, the cotangent module of
that kernel is generated over `B` by the classes of the generators. -/
theorem span_toCotangent_generators_eq_top {R : Type u} {B : Type v} {ι : Type w}
    [CommRing R] [CommRing B] [Algebra R B]
    (h : Function.Surjective (algebraMap R B))
    (I : Ideal R) (hI : RingHom.ker (algebraMap R B) = I)
    (f : ι → R) (hf : I = Ideal.span (Set.range f)) :
    letI := ConormalSeq.cotangentModule h
    Submodule.span B (Set.range fun i : ι =>
      (RingHom.ker (algebraMap R B)).toCotangent
        ⟨f i, hI.symm ▸ hf ▸ Ideal.subset_span ⟨i, rfl⟩⟩) = ⊤ := by
  let J := RingHom.ker (algebraMap R B)
  let _ := ConormalSeq.cotangentModule h
  let j (x : R) (hx : x ∈ I) : J :=
    ⟨x, by change x ∈ RingHom.ker (algebraMap R B); rw [hI]; exact hx⟩
  let c (x : R) (hx : x ∈ I) : J.Cotangent := J.toCotangent (j x hx)
  let V : Submodule B J.Cotangent :=
    Submodule.span B (Set.range fun i : ι => c (f i) (by
      rw [hf]
      exact Ideal.subset_span ⟨i, rfl⟩))
  refine Submodule.eq_top_iff'.mpr fun y => ?_
  obtain ⟨x, rfl⟩ := J.toCotangent_surjective y
  have hclass : ∀ (z : R) (hz : z ∈ Submodule.span R (Set.range f)),
      c z (by simpa [hf] using hz) ∈ V := by
    intro z hz
    induction hz using Submodule.span_induction with
    | mem z hz =>
        rcases hz with ⟨i, rfl⟩
        exact Submodule.subset_span ⟨i, rfl⟩
    | zero =>
        have hzero : c 0 I.zero_mem = 0 := map_zero J.toCotangent
        rw [hzero]
        exact V.zero_mem
    | add z w hz hw ihz ihw =>
        have hzI : z ∈ I := by simpa [hf] using hz
        have hwI : w ∈ I := by simpa [hf] using hw
        have hadd : c (z + w) (I.add_mem hzI hwI) = c z hzI + c w hwI :=
          map_add J.toCotangent (j z hzI) (j w hwI)
        rw [hadd]
        exact V.add_mem ihz ihw
    | smul r z hz ihz =>
        have hzI : z ∈ I := by simpa [hf] using hz
        have hsmul : c (r • z) (I.smul_mem r hzI) = (algebraMap R B r) • c z hzI :=
          toCotangent_smul_of_surjective h r (j z hzI)
        rw [hsmul]
        exact V.smul_mem _ ihz
  have hxI : (x : R) ∈ I := by simpa [J, hI] using x.property
  have hx : (x : R) ∈ Submodule.span R (Set.range f) := by simpa [hf] using hxI
  simpa [c, V] using hclass (x : R) hx

/-- For a square matrix the ideal of its maximal minors is generated by its determinant. -/
theorem minorIdeal_eq_span_det {R : Type u} [CommRing R] (n : ℕ)
    (M : Matrix (Fin n) (Fin n) R) :
    minorIdeal M n = Ideal.span {M.det} := by
  classical
  apply le_antisymm
  · rw [minorIdeal, Ideal.span_le]
    rintro x ⟨r, c, rfl⟩
    by_cases hr : Function.Injective r
    · by_cases hc : Function.Injective c
      · let er : Equiv.Perm (Fin n) :=
          Equiv.ofBijective r ⟨hr, Finite.surjective_of_injective hr⟩
        let ec : Equiv.Perm (Fin n) :=
          Equiv.ofBijective c ⟨hc, Finite.surjective_of_injective hc⟩
        have hsub : M.submatrix r c = (M.submatrix er id).submatrix id ec := by
          rw [Matrix.submatrix_submatrix]
          rfl
        rw [hsub, Matrix.det_permute', Matrix.det_permute]
        exact Ideal.mul_mem_left _ _ (Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _))
      · obtain ⟨i, j, hij, hval⟩ := Function.not_injective_iff.mp hc
        have hzero : (M.submatrix r c).det = 0 := by
          apply Matrix.det_zero_of_column_eq hval
          intro k
          simp [Matrix.submatrix, hij]
        rw [hzero]
        exact Ideal.zero_mem _
    · obtain ⟨i, j, hij, hval⟩ := Function.not_injective_iff.mp hr
      have hzero : (M.submatrix r c).det = 0 := by
        apply Matrix.det_zero_of_row_eq hval
        funext k
        simp [Matrix.submatrix, hij]
      rw [hzero]
      exact Ideal.zero_mem _
  · rw [Ideal.span_le]
    rintro x rfl
    exact Ideal.subset_span ⟨id, id, by simp⟩

/-- The coordinates of the base-changed polynomial basis read off the partial derivatives: the
`j`-th coordinate of `1 ⊗ d g` is the class of `∂g/∂x_j`. -/
@[ega "IV 16.5.8" "special case"]
private theorem mvPolynomialBasis_baseChange_repr_one_tmul_D {A : Type u} [CommRing A]
    (n : ℕ) (I : Ideal (MvPolynomial (Fin n) A)) (g : MvPolynomial (Fin n) A)
    (j : Fin n) :
    (((KaehlerDifferential.mvPolynomialBasis A (Fin n)).baseChange
      (MvPolynomial (Fin n) A ⧸ I)).repr
      ((1 : MvPolynomial (Fin n) A ⧸ I) ⊗ₜ[MvPolynomial (Fin n) A]
        KaehlerDifferential.D A (MvPolynomial (Fin n) A) g)) j =
      Ideal.Quotient.mk I (MvPolynomial.pderiv j g) := by
  rw [Module.Basis.baseChange_repr_tmul, KaehlerDifferential.mvPolynomialBasis_repr_apply,
    Algebra.smul_def, mul_one, Ideal.Quotient.algebraMap_eq]

/-- **Stacks Project, Tag 0BVZ.** The Kähler different of an algebra presented by `n` equations
in `n` variables is generated by the determinant of its Jacobian matrix. -/
@[stacks 0BVZ, sga "1 I 7.2" "more general"]
theorem fittingIdeal_kaehlerDifferential_quotient_mvPolynomial
    (A : Type u) [CommRing A] (n : ℕ)
    (f : Fin n → MvPolynomial (Fin n) A) :
    let I : Ideal (MvPolynomial (Fin n) A) := Ideal.span (Set.range f)
    let B := MvPolynomial (Fin n) A ⧸ I
    fittingIdeal (M := Ω[B⁄A]) 0 =
      Ideal.span {Ideal.Quotient.mk I
        (Matrix.of (fun i j : Fin n => MvPolynomial.pderiv j (f i))).det} := by
  classical
  intro I B
  let P := MvPolynomial (Fin n) A
  let J := RingHom.ker (algebraMap P B)
  have hsurj : Function.Surjective (algebraMap P B) := by
    show Function.Surjective (Ideal.Quotient.mk I)
    exact Ideal.Quotient.mk_surjective
  have hJI : J = I := Ideal.mk_ker
  let _ := ConormalSeq.cotangentModule hsurj
  let basis := (KaehlerDifferential.mvPolynomialBasis A (Fin n)).baseChange B
  let coords := basis.equivFun
  let map := KaehlerDifferential.mapBaseChange A P B
  let ψ : (Fin n → B) →ₗ[B] Ω[B⁄A] := map.comp coords.symm.toLinearMap
  let cmap := ConormalSeq.conormalMap A hsurj
  let q : J.Cotangent →ₗ[B] (Fin n → B) := coords.toLinearMap.comp cmap
  have hfJ (i : Fin n) : f i ∈ J := by
    rw [hJI]
    exact Ideal.subset_span ⟨i, rfl⟩
  let cgen (i : Fin n) : J.Cotangent := J.toCotangent ⟨f i, hfJ i⟩
  let jac : Matrix (Fin n) (Fin n) B :=
    fun j i => algebraMap P B (MvPolynomial.pderiv j (f i))
  have hcot : Submodule.span B (Set.range cgen) = ⊤ := by
    simpa [cgen, J, I] using
      span_toCotangent_generators_eq_top (R := P) (B := B) hsurj I hJI f rfl
  have hqgen (i : Fin n) : q (cgen i) = fun j => jac j i := by
    funext j
    show (basis.repr (cmap (cgen i))) j = jac j i
    rw [show cmap (cgen i) = (1 : B) ⊗ₜ[P] KaehlerDifferential.D A P (f i) from
      ConormalSeq.conormalMap_toCotangent A hsurj ⟨f i, hfJ i⟩]
    exact mvPolynomialBasis_baseChange_repr_one_tmul_D n I (f i) j
  have hqjac : q.range =
      Submodule.span B (Set.range fun i : Fin n => fun j : Fin n => jac j i) := by
    rw [LinearMap.range_eq_map, ← hcot, Submodule.map_span, ← Set.range_comp]
    simp_rw [Function.comp_def, hqgen]
  have hmaprange : cmap.range = map.ker := by
    simpa [cmap, map] using
      (ConormalSeq.conormal_exact_sequence A P B hsurj).1
  have hcoordker : Submodule.map coords.toLinearMap map.ker = ψ.ker := by
    ext v
    refine ⟨?_, fun hv => Submodule.mem_map.mpr ⟨coords.symm v, hv, coords.apply_symm_apply v⟩⟩
    rintro ⟨w, hw, rfl⟩
    simpa [ψ, map] using hw
  have hqker : q.range = ψ.ker := by
    rw [show q = coords.toLinearMap.comp cmap from rfl, LinearMap.range_comp,
      hmaprange, hcoordker]
  have hrel :
      Submodule.span B (Set.range fun i : Fin n => fun j : Fin n => jac j i) = ψ.ker :=
    hqjac.symm.trans hqker
  have hψsurj : Function.Surjective ψ := by
    intro x
    obtain ⟨y, hy⟩ := KaehlerDifferential.mapBaseChange_surjective A P B hsurj x
    refine ⟨coords y, ?_⟩
    show map (coords.symm (coords y)) = x
    simpa [ψ, map] using hy
  let e : ((Fin n → B) ⧸
      Submodule.span B (Set.range fun i : Fin n => fun j : Fin n => jac j i)) ≃ₗ[B]
      Ω[B⁄A] :=
    (Submodule.quotEquivOfEq _ _ hrel).trans
      (LinearMap.quotKerEquivOfSurjective ψ hψsurj)
  have hdet : jac.det = Ideal.Quotient.mk I
      (Matrix.of (fun i j : Fin n => MvPolynomial.pderiv j (f i))).det := by
    let M := Matrix.of (fun i j : Fin n => MvPolynomial.pderiv j (f i))
    rw [show jac = (algebraMap P B).mapMatrix M.transpose by
        ext i j
        rfl,
      ← RingHom.map_det (algebraMap P B) M.transpose, Matrix.det_transpose,
      Ideal.Quotient.algebraMap_eq]
  have hfit : fittingIdeal (M := Ω[B⁄A]) 0 = minorIdeal jac n := by
    simpa using fittingIdeal_eq_minorIdeal_of_presentation jac 0 e
  rw [hfit, minorIdeal_eq_span_det, hdet]

end Stacks.Discriminant

end
