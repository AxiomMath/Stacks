module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Different.KaehlerDifferent.Jacobian
public import StacksFrontier.RingTheory.Koszul.TorComparison.Determinant

/-!
# The Kähler different of a quasi-finite map between smooth algebras

Let `R → A → B` be ring maps such that `Ω[A⁄R]` is free of rank `n` over `A` and `Ω[B⁄R]` is
free of rank `n` over `B`.  Then the Kähler different of `B` over `A` — the zeroth Fitting
ideal of `Ω[B⁄A]` — is generated by `∧ⁿ(dφ)`, the determinant of the matrix of
`B ⊗_A Ω[A⁄R] → Ω[B⁄R]` in the two bases.

## Main results

* `Stacks.Discriminant.fittingIdeal_quotient_range_eq_span_det`: the zeroth Fitting ideal of the
  cokernel of a map of free modules of equal finite rank is generated by the determinant of its
  matrix.
* `Stacks.Discriminant.fittingIdeal_kaehlerDifferential_eq_span_det_of_bases`: the Kähler
  different of `B` over `A` is generated by `∧ⁿ(dφ)`.
* `Stacks.Discriminant.exists_smul_exteriorPower_map_mapBaseChange`: the same with `∧ⁿ(dφ)` read
  as the map `⋀ⁿ(B ⊗_A Ω[A⁄R]) → ⋀ⁿΩ[B⁄R]` of rank-one modules it is, rather than as a
  determinant: the generator of the Kähler different is the multiplier by which that map carries
  one top wedge to the other.

## References

* [Stacks Project, Tag 0BWJ](https://stacks.math.columbia.edu/tag/0BWJ)
* [Stacks Project, Tag 0BVW](https://stacks.math.columbia.edu/tag/0BVW)
-/

@[expose] public section

open scoped TensorProduct Matrix

universe u v w

namespace Stacks.Discriminant

/-- The zeroth Fitting ideal of the cokernel of a map between free modules of the same finite
rank is generated by the determinant of the matrix of the map in the chosen bases. -/
theorem fittingIdeal_quotient_range_eq_span_det {R : Type u} {M : Type v} {N : Type w}
    [CommRing R] [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    {n : ℕ} (bM : Module.Basis (Fin n) R M) (bN : Module.Basis (Fin n) R N) (φ : M →ₗ[R] N) :
    letI : Module.Finite R N := Module.Finite.of_basis bN
    letI : Module.Finite R (N ⧸ LinearMap.range φ) :=
      Module.Finite.quotient R (LinearMap.range φ)
    fittingIdeal (R := R) (M := N ⧸ LinearMap.range φ) 0 =
      Ideal.span {(LinearMap.toMatrix bM bN φ).det} := by
  classical
  let : Module.Finite R N := Module.Finite.of_basis bN
  let : Module.Finite R (N ⧸ LinearMap.range φ) :=
    Module.Finite.quotient R (LinearMap.range φ)
  set A := LinearMap.toMatrix bM bN φ with hA
  set eM : (Fin n → R) ≃ₗ[R] M := bM.equivFun.symm with heM
  set eN : (Fin n → R) ≃ₗ[R] N := bN.equivFun.symm with heN
  have hF : eN.toLinearMap.comp A.mulVecLin = φ.comp eM.toLinearMap := by
    refine LinearMap.ext fun x => bN.equivFun.injective ?_
    have hM : (bM.repr (eM x) : Fin n → R) = x := bM.equivFun.apply_symm_apply x
    calc bN.equivFun (eN (A.mulVecLin x)) = A.mulVecLin x :=
          bN.equivFun.apply_symm_apply _
      _ = A *ᵥ x := Matrix.mulVecLin_apply A x
      _ = A *ᵥ (bM.repr (eM x) : Fin n → R) := by rw [hM]
      _ = (bN.repr (φ (eM x)) : Fin n → R) := by
        simpa [hA] using LinearMap.toMatrix_mulVec_repr bM bN φ (eM x)
      _ = bN.equivFun (φ (eM x)) := rfl
  have hmap : Submodule.map eN.toLinearMap
      (Submodule.span R (Set.range A.col)) = LinearMap.range φ := by
    calc Submodule.map eN.toLinearMap (Submodule.span R (Set.range A.col))
        = Submodule.map eN.toLinearMap (LinearMap.range A.mulVecLin) := by
          rw [Matrix.range_mulVecLin]
      _ = LinearMap.range (eN.toLinearMap.comp A.mulVecLin) := by rw [← LinearMap.range_comp]
      _ = LinearMap.range (φ.comp eM.toLinearMap) := by rw [hF]
      _ = LinearMap.range φ := LinearMap.range_comp_of_range_eq_top _ eM.range
  have hfit : fittingIdeal (R := R) (M := N ⧸ LinearMap.range φ) 0 = minorIdeal A n := by
    simpa [hA] using
      fittingIdeal_eq_minorIdeal_of_presentation A 0 (Submodule.Quotient.equiv _ _ eN hmap)
  rw [hfit, minorIdeal_eq_span_det n A]

section Kaehler

variable {R : Type u} {A : Type v} {B : Type w} [CommRing R] [CommRing A] [CommRing B]
  [Algebra R A] [Algebra R B] [Algebra A B] [IsScalarTower R A B]

/-- The relative differentials of `B` over `A` are the cokernel of the base-changed differentials
of `A` over `R`: the sequence `B ⊗_A Ω[A⁄R] → Ω[B⁄R] → Ω[B⁄A] → 0` is exact. -/
noncomputable def kaehlerDifferentialQuotientEquiv :
    (Ω[B⁄R] ⧸ LinearMap.range (KaehlerDifferential.mapBaseChange R A B)) ≃ₗ[B] Ω[B⁄A] :=
  (Submodule.quotEquivOfEq _ _
      (KaehlerDifferential.range_mapBaseChange R A B)).trans
    ((KaehlerDifferential.map R A B B).quotKerEquivOfSurjective
      (KaehlerDifferential.map_surjective R A B))

/-- **The Kähler different of a map between smooth algebras of the same relative dimension is
generated by `∧ⁿ(dφ)`.**  If `Ω[A⁄R]` and `Ω[B⁄R]` are free of rank `n`, the zeroth Fitting ideal
of `Ω[B⁄A]` is generated by the determinant of the matrix of
`B ⊗_A Ω[A⁄R] → Ω[B⁄R]` in the two bases. -/
theorem fittingIdeal_kaehlerDifferential_eq_span_det_of_bases {n : ℕ}
    (bA : Module.Basis (Fin n) A Ω[A⁄R]) (bB : Module.Basis (Fin n) B Ω[B⁄R]) :
    letI : Module.Finite B Ω[B⁄R] := Module.Finite.of_basis bB
    letI : Module.Finite B Ω[B⁄A] :=
      Module.Finite.of_surjective (KaehlerDifferential.map R A B B)
        (KaehlerDifferential.map_surjective R A B)
    fittingIdeal (R := B) (M := Ω[B⁄A]) 0 =
      Ideal.span {(LinearMap.toMatrix (bA.baseChange B) bB
        (KaehlerDifferential.mapBaseChange R A B)).det} := by
  let : Module.Finite B Ω[B⁄R] := Module.Finite.of_basis bB
  let : Module.Finite B Ω[B⁄A] :=
    Module.Finite.of_surjective (KaehlerDifferential.map R A B B)
      (KaehlerDifferential.map_surjective R A B)
  have h := fittingIdeal_eq_of_linearEquiv
    (kaehlerDifferentialQuotientEquiv (R := R) (A := A) (B := B)) 0
  rw [Nat.cast_zero] at h
  rw [← h]
  exact fittingIdeal_quotient_range_eq_span_det (bA.baseChange B) bB _

/-- **The Kähler different is generated by the multiplier of the top wedge of `dφ`.**  With
`Ω[A⁄R]` and `Ω[B⁄R]` free of rank `n`, both top exterior powers `⋀ⁿ(B ⊗_A Ω[A⁄R])` and
`⋀ⁿΩ[B⁄R]` are free of rank one on the wedges of the two bases, so `∧ⁿ(dφ)` carries the first
wedge to a multiple of the second; that multiplier generates the zeroth Fitting ideal of
`Ω[B⁄A]`.

This is the Kähler different read as the zero locus of a section of a rank-one module, which is
the shape [Stacks, Tag 0BWJ] states its last assertion in; it is
`Stacks.Discriminant.fittingIdeal_kaehlerDifferential_eq_span_det_of_bases` together with
`exteriorPower.map_top_ιMulti_eq_det_smul`. -/
theorem exists_smul_exteriorPower_map_mapBaseChange {n : ℕ}
    (bA : Module.Basis (Fin n) A Ω[A⁄R]) (bB : Module.Basis (Fin n) B Ω[B⁄R]) :
    letI : Module.Finite B Ω[B⁄R] := Module.Finite.of_basis bB
    letI : Module.Finite B Ω[B⁄A] :=
      Module.Finite.of_surjective (KaehlerDifferential.map R A B B)
        (KaehlerDifferential.map_surjective R A B)
    ∃ d : B,
      exteriorPower.map n (KaehlerDifferential.mapBaseChange R A B)
          (exteriorPower.ιMulti B n (bA.baseChange B)) =
        d • exteriorPower.ιMulti B n bB ∧
      fittingIdeal (R := B) (M := Ω[B⁄A]) 0 = Ideal.span {d} := by
  let : Module.Finite B Ω[B⁄R] := Module.Finite.of_basis bB
  let : Module.Finite B Ω[B⁄A] :=
    Module.Finite.of_surjective (KaehlerDifferential.map R A B B)
      (KaehlerDifferential.map_surjective R A B)
  exact ⟨_, exteriorPower.map_top_ιMulti_eq_det_smul (bA.baseChange B) bB _,
    fittingIdeal_kaehlerDifferential_eq_span_det_of_bases bA bB⟩

end Kaehler

end Stacks.Discriminant

end
