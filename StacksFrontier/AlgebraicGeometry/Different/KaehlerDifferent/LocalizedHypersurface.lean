/-!
# The Kähler different of a localized hypersurface

Let `A` be a ring and let `f, h` be polynomials in one variable over `A`, and set

`B = (A[x]/(f))_h = A[x, 1/h]/(f)`.

Then the Kähler different of `B` over `A` — the zeroth Fitting ideal of `Ω[B⁄A]` — is generated by
the image of the derivative `f'`. This is the Kähler-different half of Example 0BWI.

## Main results

* `Stacks.Discriminant.fittingIdeal_kaehlerDifferential_localization_adjoinRoot` computes the
  Kähler different of `B`.

## Implementation notes

`AdjoinRoot f` is `A[x]/(f)` and `Localization.Away (AdjoinRoot.mk f h)` is its localization at
the image of `h`. The computation is in two steps. Over `A[x]/(f)` itself the conormal sequence of
the presentation identifies `Ω` with the cokernel of multiplication by `f'` on a free module of
rank one, so the zeroth Fitting ideal is `(f')`; then both the module of differentials and the
Fitting ideal localize, the first by `Stacks.Discriminant.omega_localization_total` and the second
by the base-change clause of Tag 07ZA.

The source states the example for a Noetherian `A` with `B` quasi-finite over `A`, those being the
standing hypotheses under which the three ideals of the example agree. Neither is needed for the
Kähler-different formula, which is a direct computation, so neither is imposed.

`Stacks.Discriminant.kaehlerDifferent` is the sheaf-theoretic Kähler different of a morphism of
schemes; this ideal is the affine one whose associated ideal sheaf it is. The companion formula
for an unlocalized quotient of a polynomial ring by as many equations as variables is
`Stacks.Discriminant.fittingIdeal_kaehlerDifferential_quotient_mvPolynomial`, Tag 0BVZ.

## References

* [Stacks Project, Tag 0BWI](https://stacks.math.columbia.edu/tag/0BWI)
* [Stacks Project, Tag 0BVW](https://stacks.math.columbia.edu/tag/0BVW)
* [Stacks Project, Tag 07ZA](https://stacks.math.columbia.edu/tag/07ZA)
-/

@[expose] public section

universe u

namespace Stacks.Discriminant

/-- The Kähler different of `A[x]/(f)` is generated by the class of the derivative `f'`. The
conormal sequence of the presentation presents `Ω[(A[x]/(f))⁄A]` as the quotient of a free module
of rank one by the submodule generated by `f'`. -/
@[sga "1 I 7.2" "more general"]
private theorem fittingIdeal_kaehlerDifferential_adjoinRoot (A : Type u) [CommRing A]
    (f : Polynomial A) :
    fittingIdeal (M := KaehlerDifferential A (AdjoinRoot f)) 0 =
      Ideal.span {AdjoinRoot.mk f f.derivative} := by
  classical
  let P := Polynomial A
  let I : Ideal P := Ideal.span {f}
  let Q := P ⧸ I
  show fittingIdeal (M := KaehlerDifferential A Q) 0 =
    Ideal.span {Ideal.Quotient.mk I f.derivative}
  let : Module.Finite Q (KaehlerDifferential A Q) := KaehlerDifferential.finite A Q
  let J := RingHom.ker (algebraMap P Q)
  have hsurj : Function.Surjective (algebraMap P Q) := Ideal.Quotient.mk_surjective
  have hJI : J = I := by simp [J, Q, Ideal.mk_ker]
  let _ := ConormalSeq.cotangentModule hsurj
  let b0 : Module.Basis Unit P (KaehlerDifferential A P) :=
    (Pi.basisFun P Unit).map
      ((LinearEquiv.funUnique Unit P P).trans (KaehlerDifferential.polynomialEquiv A).symm)
  let basis := b0.baseChange Q
  let coords := basis.equivFun
  let e : Q ≃ₗ[Q] (TensorProduct P Q (KaehlerDifferential A P)) :=
    (LinearEquiv.funUnique Unit Q Q).symm.trans coords.symm
  let map := KaehlerDifferential.mapBaseChange A P Q
  let ψ : Q →ₗ[Q] KaehlerDifferential A Q := map.comp e.toLinearMap
  let cgen : J.Cotangent := J.toCotangent ⟨f, by
    show f ∈ J
    rw [hJI]
    exact Ideal.subset_span (Set.mem_singleton f)⟩
  let cmap := ConormalSeq.conormalMap A hsurj
  let q : J.Cotangent →ₗ[Q] Q := e.symm.toLinearMap.comp cmap
  have hcot : Submodule.span Q (Set.range fun _ : Unit ↦ cgen) = ⊤ := by
    have hrange : Set.range (fun _ : Unit ↦ f) = {f} := by ext y; simp
    simpa only [cgen] using
      span_toCotangent_generators_eq_top hsurj I hJI (fun _ : Unit ↦ f) (by simp [I, hrange])
  have hqgen : q cgen = Ideal.Quotient.mk I f.derivative := by
    show e.symm (cmap cgen) = _
    rw [ConormalSeq.conormalMap_toCotangent A hsurj]
    show (basis.repr ((1 : Q) ⊗ₜ[P] KaehlerDifferential.D A P f)) Unit.unit = _
    rw [Module.Basis.baseChange_repr_tmul]
    show (b0.repr (KaehlerDifferential.D A P f)) Unit.unit • (1 : Q) = _
    show (((Pi.basisFun P Unit).repr
      ((LinearEquiv.funUnique Unit P P).symm
        (KaehlerDifferential.polynomialEquiv A (KaehlerDifferential.D A P f)))) Unit.unit) •
        (1 : Q) = _
    rw [Pi.basisFun_repr, LinearEquiv.funUnique_symm_apply, KaehlerDifferential.polynomialEquiv_D]
    show algebraMap P (P ⧸ I) f.derivative * (1 : P ⧸ I) = _
    rw [mul_one]
    exact congrArg (fun g : P →+* P ⧸ I ↦ g f.derivative) (Ideal.Quotient.algebraMap_eq I)
  have hqrange : q.range = Submodule.span Q (Set.range fun _ : Unit ↦ q cgen) := by
    calc
      q.range = Submodule.map q ⊤ := (Submodule.map_top q).symm
      _ = Submodule.map q (Submodule.span Q (Set.range fun _ : Unit ↦ cgen)) := by rw [hcot]
      _ = Submodule.span Q (q '' Set.range fun _ : Unit ↦ cgen) := Submodule.map_span q _
      _ = Submodule.span Q (Set.range fun _ : Unit ↦ q cgen) := by
          congr 1
          ext z
          simp
  have hqker : q.range = ψ.ker := by
    rw [show q = e.symm.toLinearMap.comp cmap from rfl, LinearMap.range_comp,
      (ConormalSeq.conormal_exact_sequence A P Q hsurj).1]
    refine le_antisymm ?_ fun z hz ↦ ⟨e z, hz, e.symm_apply_apply z⟩
    rintro _ ⟨w, hw, rfl⟩
    show map (e (e.symm w)) = 0
    simpa using hw
  have hrel : (Ideal.span {Ideal.Quotient.mk I f.derivative} : Submodule Q Q) = ψ.ker := by
    simpa only [Set.range_const, hqgen] using hqrange.symm.trans hqker
  have hψsurj : Function.Surjective ψ := fun z ↦ by
    obtain ⟨w, hw⟩ := KaehlerDifferential.mapBaseChange_surjective A P Q hsurj z
    exact ⟨e.symm w, by simpa [ψ] using hw⟩
  let eQ : (Q ⧸ Ideal.span {Ideal.Quotient.mk I f.derivative}) ≃ₗ[Q] KaehlerDifferential A Q :=
    (Submodule.quotEquivOfEq _ _ hrel).trans (LinearMap.quotKerEquivOfSurjective ψ hψsurj)
  calc
    fittingIdeal (M := KaehlerDifferential A Q) 0 =
        fittingIdeal (M := Q ⧸ Ideal.span {Ideal.Quotient.mk I f.derivative}) 0 :=
      fittingIdeal_eq_of_linearEquiv eQ.symm 0
    _ = Ideal.span {Ideal.Quotient.mk I f.derivative} :=
      (fittingIdeal_quotient_and_prod (Ideal.span {Ideal.Quotient.mk I f.derivative}) ⊥).1

/-- **Stacks Project, Tag 0BWI.** For `B = (A[x]/(f))_h = A[x, 1/h]/(f)` the Kähler different of
`B` over `A` — the zeroth Fitting ideal of `Ω[B⁄A]` — is the ideal generated by the image of the
derivative `f'`.

The source's Noetherian hypothesis on `A` and quasi-finiteness hypothesis on `B` are not needed
for this formula and are not imposed; they are what make this ideal agree with the Noether
different and with the different of `Spec(B)` over `Spec(A)`. -/
@[stacks 0BWI "kahler_different", sga "1 I 7.2" "equality case"]
theorem fittingIdeal_kaehlerDifferential_localization_adjoinRoot
    (A : Type u) [CommRing A] (f h : Polynomial A) :
    fittingIdeal (M := KaehlerDifferential A (Localization.Away (AdjoinRoot.mk f h))) 0 =
      Ideal.span {algebraMap (AdjoinRoot f) (Localization.Away (AdjoinRoot.mk f h))
        (AdjoinRoot.mk f f.derivative)} := by
  classical
  let B := AdjoinRoot f
  let x : B := AdjoinRoot.mk f h
  let L := Localization.Away x
  let : Module.Finite B (KaehlerDifferential A B) := KaehlerDifferential.finite A B
  let : Module.Finite L (KaehlerDifferential A L) := KaehlerDifferential.finite A L
  let d : KaehlerDifferential A B →ₗ[B] KaehlerDifferential A L := KaehlerDifferential.map A A B L
  have hdloc : IsLocalizedModule (Submonoid.powers x) d := omega_localization_total A B _ L
  let e : TensorProduct B L (KaehlerDifferential A B) ≃ₗ[L] KaehlerDifferential A L :=
    ((isLocalizedModule_iff_isBaseChange (Submonoid.powers x) L d).mp hdloc).equiv
  calc
    fittingIdeal (M := KaehlerDifferential A L) 0 =
        fittingIdeal (M := TensorProduct B L (KaehlerDifferential A B)) 0 :=
      fittingIdeal_eq_of_linearEquiv e.symm 0
    _ = Ideal.map (algebraMap B L) (fittingIdeal (M := KaehlerDifferential A B) 0) :=
      (fittingIdeal_basic_properties.{u, u, u, u} (M := KaehlerDifferential A B)).2.2.1 L 0
    _ = Ideal.map (algebraMap B L) (Ideal.span {AdjoinRoot.mk f f.derivative}) :=
      congrArg (Ideal.map (algebraMap B L))
        (fittingIdeal_kaehlerDifferential_adjoinRoot A f)
    _ = Ideal.span {algebraMap B L (AdjoinRoot.mk f f.derivative)} := by
      rw [Ideal.map_span, Set.image_singleton]

end Stacks.Discriminant

end
