module

public import Mathlib.FieldTheory.PrimitiveElement
public import Mathlib.RingTheory.Nakayama
public import StacksFrontier.AlgebraicGeometry.Different.NoetherDifferent.KaehlerDifferent
public import StacksFrontier.AlgebraicGeometry.Different.NoetherDifferent.TraceElement
public import StacksFrontier.AlgebraicGeometry.Discriminant.DiscriminantIdeal
public import StacksFrontier.AlgebraicGeometry.Discriminant.TraceNonvanishing

/-!
# The Kähler different of a finite local algebra with principal maximal ideal

Let `κ` be a field and let `C` be a finite local `κ`-algebra whose maximal ideal is generated by
one element `π`, with `π ^ e = 0` and `π ^ (e - 1) ≠ 0`. Typically `C = B / m_A B` is the special
fibre of an extension `A ⊆ B` of discrete valuation rings of ramification index `e`. Then the
Kähler different `Fitt₀(Ω_{C/κ})` is killed by `π`, and it is nonzero exactly when the residue
field of `C` is separable over `κ` and `e` is nonzero in `κ`.

## Main results

* `Stacks.Discriminant.mul_eq_zero_of_mem_noetherDifferent`: the Noether different of a finite
  local algebra over a field is killed by the maximal ideal.
* `Stacks.Discriminant.trace_ne_zero_of_noetherDifferent_ne_bot`: if the Noether different is
  nonzero then so is the trace.
* `Stacks.Discriminant.span_D_eq_top_of_isSeparable`: if the residue field is separable over `κ`
  then `Ω_{C/κ}` is generated by `dπ`.
* `Stacks.Discriminant.mul_eq_zero_of_mem_fittingIdeal_kaehlerDifferential`,
  `Stacks.Discriminant.fittingIdeal_kaehlerDifferential_ne_bot_of_isSeparable` and
  `Stacks.Discriminant.isSeparable_and_length_ne_zero_of_fittingIdeal_ne_bot`: the three facts
  displayed above about the Kähler different of `C`.

## Implementation notes

The Kähler different is contained in the Noether different
(`Stacks.Discriminant.fittingIdeal_kaehlerDifferential_le_noetherDifferent`), and the Noether
different is the image of evaluation at the trace element of `ω_{C/κ} = Hom_κ(C, κ)`
([Stacks, Tag 0BVT]). The trace element is the trace functional, which is killed by every
nilpotent element of `C`; this gives the first two results, and the second feeds
[Stacks, Tag 0C13]. When the residue field `κ(C) = κ(a)` is separable, a lift `α` of `a` and `π`
generate `C`, the separable minimal polynomial `g` of `a` gives `g'(α) dα ∈ m_C Ω + C dπ` with
`g'(α)` a unit, and Nakayama's lemma shows that `dπ` generates `Ω_{C/κ}`; then
`e π ^ (e - 1) dπ = d(π ^ e) = 0` exhibits a nonzero element of the Kähler different.

## References

* [Stacks Project, Tag 0C1F](https://stacks.math.columbia.edu/tag/0C1F)
* [Stacks Project, Tag 0C13](https://stacks.math.columbia.edu/tag/0C13)
* [Stacks Project, Tag 0BVT](https://stacks.math.columbia.edu/tag/0BVT)
-/

@[expose] public section

open scoped TensorProduct
open IsLocalRing Polynomial

universe u v

namespace Stacks.Discriminant

attribute [local instance] algebraDualModule

variable {κ : Type u} [Field κ] {C : Type v} [CommRing C] [Algebra κ C]

/-- **The zeroth Fitting ideal of a cyclic module is its annihilator.** If `m` generates `M`
then `M ≅ R ⧸ Ann(m)`, whose zeroth Fitting ideal is `Ann(m)`. -/
theorem fittingIdeal_zero_eq_torsionOf {R : Type*} {M : Type*} [CommRing R] [AddCommGroup M]
    [Module R M] [Module.Finite R M] {m : M} (hm : Submodule.span R {m} = ⊤) :
    fittingIdeal (R := R) (M := M) 0 = Ideal.torsionOf R M m := by
  have h1 := fittingIdeal_eq_of_linearEquiv
    ((Ideal.quotTorsionOfEquivSpanSingleton R M m).trans (LinearEquiv.ofTop _ hm)) 0
  rw [Nat.cast_zero] at h1
  rw [← h1]
  exact (fittingIdeal_quotient_and_prod _ ⊥).1

section NoetherDifferent

variable [IsLocalRing C] [Module.Finite κ C]

/-- The trace functional of a finite local algebra over a field is killed by the maximal ideal:
`Tr_{C/κ}(c x) = 0` for `c ∈ m_C`, because `c x` is nilpotent. -/
theorem trace_mul_eq_zero_of_mem_maximalIdeal {c : C} (hc : c ∈ maximalIdeal C) (x : C) :
    Algebra.trace κ C (c * x) = 0 := by
  have : IsArtinianRing C := IsArtinianRing.of_finite κ C
  have hcx : c * x ∈ nilradical C := by
    rw [Ring.KrullDimLE.nilradical_eq_maximalIdeal]
    exact Ideal.mul_mem_right x _ hc
  exact (Algebra.isNilpotent_trace_of_isNilpotent hcx).eq_zero

/-- The ordinary trace element is killed by `c` if the trace functional is killed by `c`. -/
private theorem smul_finiteFlatTraceElement_eq_zero {c : C}
    (h : ∀ x : C, Algebra.trace κ C (c * x) = 0) :
    have : IsNoetherianRing C := IsNoetherianRing.of_finite κ C
    c • finiteFlatTraceElement κ C = 0 := by
  have : IsNoetherianRing C := IsNoetherianRing.of_finite κ C
  have : Module.FinitePresentation κ C := Module.finitePresentation_of_finite κ C
  have : Module.Projective κ C := Module.Flat.projective_of_finitePresentation
  change c • dualizingModule.tmul (selfFactorization κ C)
    ((finiteProjectiveTrace κ C).comp (Algebra.lmul κ C).toLinearMap) 1 = 0
  have hc' : c • dualizingModule.tmul (selfFactorization κ C)
      ((finiteProjectiveTrace κ C).comp (Algebra.lmul κ C).toLinearMap) 1 =
      dualizingModule.tmul (selfFactorization κ C)
        (c • (finiteProjectiveTrace κ C).comp (Algebra.lmul κ C).toLinearMap) 1 :=
    (dualizingModule.tmul_dual_smul (selfFactorization κ C) c _ 1).symm
  rw [hc', ← dualizingModule.zero_tmul (selfFactorization κ C) (1 : C)]
  congr 1
  refine LinearMap.ext fun x ↦ ?_
  rw [algebraDualModule_smul_apply, LinearMap.comp_apply, finiteProjectiveTrace_eq_trace]
  exact h x

/-- The trace element of the identity factorization of a finite local algebra over a field is
killed by the maximal ideal. -/
theorem smul_traceElement_eq_zero {c : C} (hc : c ∈ maximalIdeal C) :
    have : IsNoetherianRing C := IsNoetherianRing.of_finite κ C
    c • dualizingModule.traceElement (selfFactorization κ C) = 0 := by
  have : IsNoetherianRing C := IsNoetherianRing.of_finite κ C
  rw [← eq_traceElement_of_isTraceElement (selfFactorization κ C)
    (isTraceElement_finiteFlatTraceElement κ C)]
  exact smul_finiteFlatTraceElement_eq_zero (trace_mul_eq_zero_of_mem_maximalIdeal hc)

/-- **The Noether different of a finite local algebra over a field is killed by the maximal
ideal.** It is the image of evaluation at the trace element ([Stacks, Tag 0BVT]), and the trace
element is killed by the maximal ideal. -/
theorem mul_eq_zero_of_mem_noetherDifferent {x c : C} (hx : x ∈ noetherDifferent κ C)
    (hc : c ∈ maximalIdeal C) : c * x = 0 := by
  have : IsNoetherianRing C := IsNoetherianRing.of_finite κ C
  have hx' : x ∈ (noetherDifferent κ C : Set C) := hx
  rw [noetherDifferent_eq_range_traceElement (selfFactorization κ C)] at hx'
  obtain ⟨φ, rfl⟩ := hx'
  rw [← smul_eq_mul, ← φ.map_smul, smul_traceElement_eq_zero hc, map_zero]

/-- **A nonzero Noether different forces a nonzero trace.** If the trace of a finite local
algebra over a field vanishes then so does its trace element, hence so does every evaluation at
it, which is the Noether different. -/
theorem trace_ne_zero_of_noetherDifferent_ne_bot (h : noetherDifferent κ C ≠ ⊥) :
    Algebra.trace κ C ≠ 0 := by
  have : IsNoetherianRing C := IsNoetherianRing.of_finite κ C
  intro htr
  refine h (eq_bot_iff.mpr fun x hx ↦ ?_)
  have hx' : x ∈ (noetherDifferent κ C : Set C) := hx
  rw [noetherDifferent_eq_range_traceElement (selfFactorization κ C),
    ← eq_traceElement_of_isTraceElement (selfFactorization κ C)
      (isTraceElement_finiteFlatTraceElement κ C)] at hx'
  obtain ⟨φ, rfl⟩ := hx'
  have hτ : finiteFlatTraceElement κ C = 0 := by
    simpa using smul_finiteFlatTraceElement_eq_zero (c := (1 : C)) fun x ↦ by
      simpa using LinearMap.congr_fun htr x
  change φ (finiteFlatTraceElement κ C) ∈ (⊥ : Ideal C)
  rw [hτ, map_zero]
  exact Ideal.zero_mem ⊥

/-- **The Kähler different of a finite local algebra over a field is killed by the maximal
ideal**, being contained in the Noether different. -/
theorem mul_eq_zero_of_mem_fittingIdeal_kaehlerDifferential {x c : C}
    (hx : x ∈ fittingIdeal (R := C) (M := Ω[C⁄κ]) 0) (hc : c ∈ maximalIdeal C) : c * x = 0 :=
  mul_eq_zero_of_mem_noetherDifferent (fittingIdeal_kaehlerDifferential_le_noetherDifferent κ C hx)
    hc

/-- **A nonzero Kähler different forces tameness.** If the Kähler different of a finite local
algebra `C` over a field `κ` is nonzero, then the residue field of `C` is separable over `κ` and
the length of `C` is nonzero in `κ`: the Noether different is nonzero, hence so is the trace,
and [Stacks, Tag 0C13] applies. -/
theorem isSeparable_and_length_ne_zero_of_fittingIdeal_ne_bot
    (h : fittingIdeal (R := C) (M := Ω[C⁄κ]) 0 ≠ ⊥) :
    Algebra.IsSeparable κ (ResidueField C) ∧ ((Module.length C C).toNat : κ) ≠ 0 :=
  (trace_ne_zero_iff_isSeparable_and_length_ne_zero κ C).mp
    (trace_ne_zero_of_noetherDifferent_ne_bot
      (ne_bot_of_le_ne_bot h (fittingIdeal_kaehlerDifferential_le_noetherDifferent κ C)))

end NoetherDifferent

section Separable

variable [IsLocalRing C] [Module.Finite κ C] [Algebra.IsSeparable κ (ResidueField C)]

/-- **With separable residue field, `Ω_{C/κ}` is generated by the differential of a generator of
the maximal ideal.** Let `C` be a finite local `κ`-algebra with `m_C = (π)` and residue field
separable over `κ`. Write `κ(C) = κ(a)`, lift `a` to `α`, and let `g` be the minimal polynomial
of `a`: then `g(α) ∈ (π)` and `g'(α)` is a unit, so `dα ∈ C dπ + m_C Ω_{C/κ}`; every element of
`C` is a polynomial in `α` modulo `(π)`, so `Ω_{C/κ} = C dπ + m_C Ω_{C/κ}`, and Nakayama's lemma
concludes. -/
theorem span_D_eq_top_of_isSeparable {π : C} (hπ : maximalIdeal C = Ideal.span {π}) :
    Submodule.span C {KaehlerDifferential.D κ C π} = ⊤ := by
  classical
  let D := KaehlerDifferential.D κ C
  have : Module.Finite κ (ResidueField C) :=
    Module.Finite.of_surjective (IsScalarTower.toAlgHom κ C (ResidueField C)).toLinearMap
      IsLocalRing.residue_surjective
  obtain ⟨a, ha⟩ := Field.exists_primitive_element κ (ResidueField C)
  have hadj : Algebra.adjoin κ {a} = ⊤ := by
    rw [← IntermediateField.adjoin_simple_toSubalgebra_of_isAlgebraic
      (Algebra.IsAlgebraic.isAlgebraic a), ha, IntermediateField.top_toSubalgebra]
  obtain ⟨α, hα⟩ := IsLocalRing.residue_surjective a
  have hres (p : κ[X]) : residue C (aeval α p) = aeval a p := by
    rw [← hα, ← IsLocalRing.ResidueField.algebraMap_eq, Polynomial.aeval_algebraMap_apply]
  let N : Submodule C Ω[C⁄κ] := Submodule.span C {D π} ⊔ maximalIdeal C • ⊤
  have hπN (y : C) : π • D y ∈ N := Submodule.mem_sup_right
    (Submodule.smul_mem_smul (hπ ▸ Ideal.mem_span_singleton_self π) Submodule.mem_top)
  have hmulπ (y : C) : D (y * π) ∈ N := by
    rw [Derivation.leibniz]
    exact add_mem (Submodule.mem_sup_left (Submodule.smul_mem _ _
      (Submodule.mem_span_singleton_self _))) (hπN y)
  have hmem (z : C) (hz : residue C z = 0) : ∃ y, y * π = z := by
    rw [← Ideal.mem_span_singleton', ← hπ]
    exact (IsLocalRing.residue_eq_zero_iff z).mp hz
  -- the differential of the lift of the primitive element
  have hα' : D α ∈ N := by
    let g := minpoly κ a
    have hsep : g.Separable := Algebra.IsSeparable.isSeparable κ a
    obtain ⟨y, hy⟩ := hmem (aeval α g) (by rw [hres, minpoly.aeval])
    obtain ⟨u, hu⟩ : IsUnit (aeval α (derivative g)) := by
      rw [← IsLocalRing.residue_ne_zero_iff_isUnit, hres]
      exact hsep.aeval_derivative_ne_zero (minpoly.aeval κ a)
    have hD : aeval α (derivative g) • D α ∈ N := by
      rw [← Derivation.map_aeval, ← hy]
      exact hmulπ y
    have := N.smul_mem (↑u⁻¹ : C) hD
    rwa [← hu, smul_smul, Units.inv_mul, one_smul] at this
  have hrange (x : C) : D x ∈ N := by
    have hx : residue C x ∈ Algebra.adjoin κ {a} := hadj ▸ Algebra.mem_top
    rw [Algebra.adjoin_singleton_eq_range_aeval] at hx
    obtain ⟨p, hp⟩ := hx
    obtain ⟨y, hy⟩ := hmem (x - aeval α p) (by
      rw [map_sub, hres]
      exact sub_eq_zero.mpr hp.symm)
    rw [show x = aeval α p + y * π by rw [hy, add_sub_cancel], map_add, Derivation.map_aeval]
    exact add_mem (N.smul_mem _ hα') (hmulπ y)
  have htop : (⊤ : Submodule C Ω[C⁄κ]) ≤ N := by
    rw [← KaehlerDifferential.span_range_derivation, Submodule.span_le]
    rintro _ ⟨x, rfl⟩
    exact hrange x
  exact top_le_iff.mp (Submodule.le_of_le_smul_of_le_jacobson_bot Module.Finite.fg_top
    (IsLocalRing.maximalIdeal_le_jacobson ⊥) htop)

/-- **With tame residue data the Kähler different is nonzero.** Let `C` be a finite local
`κ`-algebra with `m_C = (π)`, `π ^ e = 0`, `π ^ (e - 1) ≠ 0`, residue field separable over `κ`
and `e ≠ 0` in `κ`. Then `Ω_{C/κ} = C dπ`, whose annihilator is its Kähler different, and
`e π ^ (e - 1) dπ = d(π ^ e) = 0` puts `π ^ (e - 1) ≠ 0` in that annihilator. -/
theorem fittingIdeal_kaehlerDifferential_ne_bot_of_isSeparable {π : C}
    (hπ : maximalIdeal C = Ideal.span {π}) {e : ℕ} (he : π ^ e = 0) (he' : π ^ (e - 1) ≠ 0)
    (hchar : (e : κ) ≠ 0) :
    fittingIdeal (R := C) (M := Ω[C⁄κ]) 0 ≠ ⊥ := by
  rw [fittingIdeal_zero_eq_torsionOf (span_D_eq_top_of_isSeparable (κ := κ) hπ)]
  intro hbot
  apply he'
  have hmem : π ^ (e - 1) ∈ Ideal.torsionOf C Ω[C⁄κ] (KaehlerDifferential.D κ C π) := by
    rw [Ideal.mem_torsionOf_iff]
    have h0 : KaehlerDifferential.D κ C (π ^ e) = 0 := by rw [he, map_zero]
    rw [Derivation.leibniz_pow, ← Nat.cast_smul_eq_nsmul C, smul_smul] at h0
    obtain ⟨u, hu⟩ : IsUnit (e : C) := by
      rw [← map_natCast (algebraMap κ C)]
      exact (isUnit_iff_ne_zero.mpr hchar).map _
    simpa only [smul_zero, smul_smul, ← hu, ← mul_assoc, Units.inv_mul, one_mul] using
      congrArg ((↑u⁻¹ : C) • ·) h0
  rwa [hbot, Ideal.mem_bot] at hmem

end Separable

end Stacks.Discriminant

end
