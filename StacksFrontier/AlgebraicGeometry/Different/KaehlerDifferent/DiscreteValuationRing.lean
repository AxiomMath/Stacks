module

public import Mathlib.Algebra.Module.PID
public import Mathlib.RingTheory.HopkinsLevitzki
public import Mathlib.RingTheory.Kaehler.TensorProduct
public import StacksFrontier.AlgebraicGeometry.Different.KaehlerDifferent.Ramification
public import StacksFrontier.RingTheory.DiscreteValuationRing.RamificationIndex
public import StacksFrontier.RingTheory.Henselian.Quotient

/-!
# The Kähler different of an extension of discrete valuation rings

Let `A → B` be an extension of discrete valuation rings, essentially of finite type, with
ramification index `e` and finite residue field extension `κ_A ⊆ κ_B`. Let
`d = length_B(B ⧸ Fitt₀(Ω_{B/A}))` be the colength of the Kähler different. Then
`d = length_B(Ω_{B/A})`, `d ≥ e - 1`, and `d = e - 1` exactly when `A ⊆ B` is tamely ramified:
`κ_B / κ_A` is separable and the characteristic of `κ_A` does not divide `e`.

## Main results

* `Stacks.Discriminant.length_quotient_fittingIdeal_zero_eq_length`: over a discrete valuation
  ring the zeroth Fitting ideal of a finite module has colength the length of the module.
* `Stacks.Discriminant.ramificationIdx_sub_one_le_length_quotient_fittingIdeal`: `e - 1 ≤ d`.
* `Stacks.Discriminant.length_quotient_fittingIdeal_eq_iff`: `d = e - 1` if and only if the
  extension is tamely ramified.

## Implementation notes

The proof is the source's: one passes to the special fibre `C = B ⧸ m_A B = B ⧸ m_B ^ e`, a
finite local algebra over `κ_A` with principal maximal ideal, whose Kähler different is the
image of that of `B` over `A` because both Fitting ideals and differentials commute with base
change. The Kähler different of `B` over `A` is `m_B ^ d`, so its image in `C` is `m_C ^ d`,
which is nonzero exactly when `d < e`. On `C` the Kähler different is killed by `m_C` (so
`d + 1 ≥ e`), and it is nonzero exactly in the tame case, by
`Stacks.Discriminant.isSeparable_and_length_ne_zero_of_fittingIdeal_ne_bot` and
`Stacks.Discriminant.fittingIdeal_kaehlerDifferential_ne_bot_of_isSeparable`. The source reads
these two facts off the trace element of `ω_{C/κ_A}` through the different of a quasi-finite
Gorenstein morphism; here the trace element enters only through the Noether different, which
contains the Kähler different.

## References

* [Stacks Project, Tag 0C1F](https://stacks.math.columbia.edu/tag/0C1F)
-/

@[expose] public section

open scoped TensorProduct
open IsLocalRing

universe u v w

namespace Stacks.Discriminant

open Stacks.DiscreteValuationRing.Ramification

variable {A B : Type u} [CommRing A] [IsDomain A] [IsDiscreteValuationRing A]
  [CommRing B] [IsDomain B] [IsDiscreteValuationRing B] [Algebra A B] [FaithfulSMul A B]
  [IsLocalHom (algebraMap A B)]

section SpecialFibre

variable (A B) in
/-- The special fibre `B ⧸ m_A B` of an extension of discrete valuation rings. -/
abbrev specialFibre : Type u := B ⧸ (maximalIdeal A).map (algebraMap A B)

omit [IsLocalHom (algebraMap A B)] in
/-- The extended maximal ideal is `ϖ ^ e` for a uniformizer `ϖ` of `B`. -/
theorem map_maximalIdeal_eq_span_pow {ϖ : B} (hϖ : Irreducible ϖ) :
    (maximalIdeal A).map (algebraMap A B) = Ideal.span {ϖ ^ ramificationIdx A B} := by
  rw [map_maximalIdeal_eq_maximalIdeal_pow_ramificationIdx,
    (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ, Ideal.span_singleton_pow]

omit [FaithfulSMul A B] in
/-- The extended maximal ideal `m_A B` is contained in the maximal ideal of `B`. -/
theorem map_maximalIdeal_le_maximalIdeal :
    (maximalIdeal A).map (algebraMap A B) ≤ maximalIdeal B :=
  IsLocalRing.map_maximalIdeal_le (algebraMap A B)

/-- The special fibre is a nontrivial ring. -/
instance : Nontrivial (specialFibre A B) :=
  Ideal.Quotient.nontrivial_iff.mpr
    (ne_top_of_le_ne_top (maximalIdeal.isMaximal B).ne_top map_maximalIdeal_le_maximalIdeal)

/-- The special fibre is a local ring. -/
instance : IsLocalRing (specialFibre A B) :=
  .of_surjective' (Ideal.Quotient.mk _) Ideal.Quotient.mk_surjective

/-- The quotient map `B → B ⧸ m_A B` is a local homomorphism. -/
instance : IsLocalHom (Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A B))) :=
  .of_surjective _ Ideal.Quotient.mk_surjective

omit [FaithfulSMul A B] in
/-- The maximal ideal of the special fibre is generated by the image of a uniformizer. -/
theorem maximalIdeal_specialFibre {ϖ : B} (hϖ : Irreducible ϖ) :
    maximalIdeal (specialFibre A B) = Ideal.span {Ideal.Quotient.mk _ ϖ} := by
  rw [← map_maximalIdeal_of_surjective _ Ideal.Quotient.mk_surjective,
    (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp hϖ, Ideal.map_span,
    Set.image_singleton]

omit [IsLocalHom (algebraMap A B)] in
/-- The image of a uniformizer in the special fibre has `e`-th power zero. -/
theorem mk_pow_ramificationIdx_eq_zero {ϖ : B} (hϖ : Irreducible ϖ) :
    (Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A B)) ϖ) ^ ramificationIdx A B = 0 := by
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, map_maximalIdeal_eq_span_pow hϖ]
  exact Ideal.mem_span_singleton_self _

/-- The image of a uniformizer in the special fibre has nonzero `(e - 1)`-st power. -/
theorem mk_pow_ramificationIdx_sub_one_ne_zero {ϖ : B} (hϖ : Irreducible ϖ) :
    (Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A B)) ϖ) ^ (ramificationIdx A B - 1)
      ≠ 0 := by
  rw [← map_pow, Ne, Ideal.Quotient.eq_zero_iff_mem, map_maximalIdeal_eq_span_pow hϖ,
    Ideal.mem_span_singleton]
  intro h
  have h1 := one_le_ramificationIdx A B
  have := (_root_.pow_dvd_pow_iff hϖ.ne_zero hϖ.not_isUnit).mp h
  omega

omit [IsLocalHom (algebraMap A B)] in
/-- The length of the special fibre is the ramification index. -/
theorem length_specialFibre :
    Module.length (specialFibre A B) (specialFibre A B) = ramificationIdx A B := by
  rw [← Module.length_eq_of_surjective (S := B) Ideal.Quotient.mk_surjective,
    (Submodule.quotEquivOfEq _ _
      (map_maximalIdeal_eq_maximalIdeal_pow_ramificationIdx A B)).length_eq]
  exact IsDiscreteValuationRing.length_quotient_pow_maximalIdeal (R := B) _

/-- The special fibre is an Artinian ring. -/
instance : IsArtinianRing (specialFibre A B) := by
  have : IsFiniteLength B (specialFibre A B) := by
    rw [← Module.length_ne_top_iff, Module.length_eq_of_surjective (S := B)
      (Ideal.Quotient.mk_surjective (I := (maximalIdeal A).map (algebraMap A B))),
      length_specialFibre]
    exact ENat.natCast_ne_top _
  exact isArtinian_of_tower B (isFiniteLength_iff_isNoetherian_isArtinian.mp this).2

/-- The `κ_A`-algebra structure on the special fibre `B ⧸ m_A B`, where `κ_A = A ⧸ m_A`. -/
instance : Algebra (ResidueField A) (specialFibre A B) :=
  Ideal.Quotient.algebraQuotientMapQuotient

/-- The scalar actions of `A` and `κ_A` on the special fibre are compatible. -/
instance : IsScalarTower A (ResidueField A) (specialFibre A B) :=
  Ideal.Quotient.tower_quotient_map_quotient

omit [IsDomain B] [IsDiscreteValuationRing B] [FaithfulSMul A B] [IsLocalHom (algebraMap A B)] in
/-- The special fibre is the base change of `B` along `A → κ_A`. -/
theorem isPushout_specialFibre : Algebra.IsPushout A (ResidueField A) B (specialFibre A B) :=
  Stacks.Henselian.isPushout_quotient_map (maximalIdeal A)

/-- The `κ_A`-algebra map from the residue field of `B` to the residue field of the special
fibre induced by the quotient map. -/
noncomputable def residueFieldSpecialFibreAlgHom :
    ResidueField B →ₐ[ResidueField A] ResidueField (specialFibre A B) where
  __ := ResidueField.map (Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A B)))
  commutes' c := by
    obtain ⟨a, rfl⟩ := IsLocalRing.residue_surjective c
    rfl

omit [FaithfulSMul A B] in
/-- The map `residueFieldSpecialFibreAlgHom` from the residue field of `B` to the residue field of
the special fibre is bijective. -/
theorem bijective_residueFieldSpecialFibreAlgHom :
    Function.Bijective (residueFieldSpecialFibreAlgHom (A := A) (B := B)) := by
  refine ⟨RingHom.injective (residueFieldSpecialFibreAlgHom (A := A) (B := B)).toRingHom,
    fun z ↦ ?_⟩
  obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective z
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective y
  exact ⟨IsLocalRing.residue B x, rfl⟩

omit [FaithfulSMul A B] in
/-- The residue field of the special fibre is separable over `κ_A` exactly when that of `B` is. -/
theorem isSeparable_residueField_specialFibre_iff :
    Algebra.IsSeparable (ResidueField A) (ResidueField (specialFibre A B)) ↔
      Algebra.IsSeparable (ResidueField A) (ResidueField B) := by
  let e := AlgEquiv.ofBijective _ (bijective_residueFieldSpecialFibreAlgHom (A := A) (B := B))
  exact ⟨fun _ ↦ Algebra.IsSeparable.of_algHom _ _ e.toAlgHom,
    fun _ ↦ Algebra.IsSeparable.of_algHom _ _ e.symm.toAlgHom⟩

variable [Module.Finite (ResidueField A) (ResidueField B)]

/-- The special fibre is a finite-dimensional `κ_A`-vector space when `κ_B` is finite over
`κ_A`. -/
instance : Module.Finite (ResidueField A) (specialFibre A B) := by
  let C := specialFibre A B
  have : Module.Finite (ResidueField A) (ResidueField C) :=
    Module.Finite.of_surjective
      (residueFieldSpecialFibreAlgHom (A := A) (B := B)).toLinearMap
      (bijective_residueFieldSpecialFibreAlgHom (A := A) (B := B)).2
  have : Module.Finite (ResidueField A) (C ⧸ Ring.jacobson C) := by
    rw [ringJacobson_eq_maximalIdeal]
    exact this
  exact IsSemiprimaryRing.finite_of_isArtinian (ResidueField A) C C

end SpecialFibre

section FittingLength

variable {R : Type u} [CommRing R] [IsDomain R] [IsDiscreteValuationRing R]

/-- A discrete valuation ring has infinite length over itself. -/
theorem length_self_eq_top : Module.length R R = ⊤ := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible R
  refine ENat.eq_top_iff_forall_ge.mpr fun n ↦ ?_
  rw [← IsDiscreteValuationRing.length_quotient_pow_maximalIdeal (R := R) n]
  exact Module.length_le_of_surjective (Ideal.Quotient.mkₐ R _).toLinearMap
    Ideal.Quotient.mk_surjective

/-- In a discrete valuation ring the colength of a product of ideals is the sum of the
colengths. -/
theorem length_quotient_mul (I J : Ideal R) :
    Module.length R (R ⧸ I * J) = Module.length R (R ⧸ I) + Module.length R (R ⧸ J) := by
  obtain ⟨a, rfl⟩ := (IsPrincipalIdealRing.principal I).principal
  obtain ⟨b, rfl⟩ := (IsPrincipalIdealRing.principal J).principal
  change Module.length R (R ⧸ Ideal.span {a} * Ideal.span {b}) =
    Ring.ord R a + Ring.ord R b
  rw [Ideal.span_singleton_mul_span_singleton]
  change Ring.ord R (a * b) = _
  by_cases hb : b = 0
  · rw [hb, mul_zero, Ring.ord_zero, length_self_eq_top, add_top]
  · exact Ring.ord_mul R (mem_nonZeroDivisors_of_ne_zero hb)

/-- The colength of the zeroth Fitting ideal of a product is the sum of those of the factors. -/
private theorem length_quotient_fittingIdeal_prod (M : Type v) (N : Type w) [AddCommGroup M]
    [Module R M]
    [Module.Finite R M] [AddCommGroup N] [Module R N] [Module.Finite R N] :
    Module.length R (R ⧸ fittingIdeal (R := R) (M := M × N) 0) =
      Module.length R (R ⧸ fittingIdeal (R := R) (M := M) 0) +
        Module.length R (R ⧸ fittingIdeal (R := R) (M := N) 0) := by
  rw [((fittingIdeal_basic_properties.{u, v, w, u} (R := R) (M := M)).2.1 N).1]
  exact length_quotient_mul _ _

/-- For a finite product of cyclic modules, the colength of the zeroth Fitting ideal is the
length. -/
private theorem length_quotient_fittingIdeal_pi :
    ∀ (ι : Type w) [Finite ι] (I : ι → Ideal R),
      Module.length R (R ⧸ fittingIdeal (R := R) (M := ∀ i, R ⧸ I i) 0) =
        Module.length R (∀ i, R ⧸ I i) := by
  intro ι _
  have := Fintype.ofFinite ι
  refine Fintype.induction_empty_option (P := fun ι _ ↦ ∀ I : ι → Ideal R,
    Module.length R (R ⧸ fittingIdeal (R := R) (M := ∀ i, R ⧸ I i) 0) =
      Module.length R (∀ i, R ⧸ I i)) ?_ ?_ ?_ ι
  · intro α β _ e h I
    let : Fintype α := Fintype.ofEquiv β e.symm
    let E : (∀ a, R ⧸ I (e a)) ≃ₗ[R] ∀ b, R ⧸ I b :=
      LinearEquiv.piCongrLeft R (fun b ↦ R ⧸ I b) e
    rw [← fittingIdeal_eq_of_linearEquiv_int E 0, ← E.length_eq]
    convert h (fun a ↦ I (e a))
  · intro I
    have hfit : fittingIdeal (R := R) (M := ∀ i : PEmpty, R ⧸ I i) 0 = ⊤ := by
      simpa using (fittingIdeal_basic_properties.{u, max u w, u, u} (R := R)
        (M := ∀ i : PEmpty, R ⧸ I i)).1 0 ⟨Fin.elim0, Subsingleton.elim _ _⟩
    rw [hfit, Module.length_eq_zero, Module.length_eq_zero]
  · intro α _ h I
    let E : (∀ i : Option α, R ⧸ I i) ≃ₗ[R] (R ⧸ I none) × ∀ i : α, R ⧸ I (some i) :=
      LinearEquiv.piOptionEquivProd R
    rw [fittingIdeal_eq_of_linearEquiv_int E 0, E.length_eq, length_quotient_fittingIdeal_prod,
      Module.length_prod, h (fun i ↦ I (some i)), (fittingIdeal_quotient_and_prod (I none) ⊥).1]

/-- **The zeroth Fitting ideal of a finite module over a discrete valuation ring has colength
the length of the module.** -/
theorem length_quotient_fittingIdeal_zero_eq_length (M : Type u) [AddCommGroup M] [Module R M]
    [Module.Finite R M] :
    Module.length R (R ⧸ fittingIdeal (R := R) (M := M) 0) = Module.length R M := by
  obtain ⟨n, ι, _, p, -, e, ⟨E⟩⟩ := Module.equiv_free_prod_directSum (R := R) (M := M)
  let F : (Fin n →₀ R) ≃ₗ[R] ∀ _ : Fin n, R ⧸ (⊥ : Ideal R) :=
    (Finsupp.linearEquivFunOnFinite R R (Fin n)).trans
      (LinearEquiv.piCongrRight fun _ ↦ (Submodule.quotEquivOfEqBot _ rfl).symm)
  let G : (DirectSum ι fun i ↦ R ⧸ R ∙ p i ^ e i) ≃ₗ[R] ∀ i, R ⧸ R ∙ p i ^ e i :=
    DirectSum.linearEquivFunOnFintype R ι _
  let E' := E.trans (F.prodCongr G)
  rw [fittingIdeal_eq_of_linearEquiv_int E' 0, E'.length_eq,
    length_quotient_fittingIdeal_prod, Module.length_prod, length_quotient_fittingIdeal_pi ι]
  congr 1
  exact length_quotient_fittingIdeal_pi (R := R) (Fin n) (fun _ ↦ ⊥)

end FittingLength

section Main

variable [Algebra.EssFiniteType A B] [Module.Finite (ResidueField A) (ResidueField B)]

/-- The Kähler different of the special fibre over `κ_A` is the image of the Kähler different of
`B` over `A`. -/
theorem fittingIdeal_kaehlerDifferential_specialFibre :
    fittingIdeal (R := specialFibre A B) (M := Ω[specialFibre A B⁄ResidueField A]) 0 =
      (fittingIdeal (R := B) (M := Ω[B⁄A]) 0).map (algebraMap B (specialFibre A B)) := by
  have := isPushout_specialFibre (A := A) (B := B)
  rw [← fittingIdeal_eq_of_linearEquiv_int
    (KaehlerDifferential.tensorKaehlerEquiv A (ResidueField A) B (specialFibre A B)) 0]
  exact_mod_cast (fittingIdeal_basic_properties.{u, u, u, u} (R := B) (M := Ω[B⁄A])).2.2.1
    (specialFibre A B) 0

/-- The length of `B` modulo an ideal is infinite when the ideal is zero, and `n` when the ideal
is generated by the `n`-th power of a uniformizer. -/
private theorem length_quotient_span_pow {ϖ : B} (hϖ : Irreducible ϖ) (n : ℕ) :
    Module.length B (B ⧸ Ideal.span {ϖ ^ n}) = n := by
  rw [(Submodule.quotEquivOfEq _ _ (by
    rw [← Ideal.span_singleton_pow, ← (IsDiscreteValuationRing.irreducible_iff_uniformizer ϖ).mp
      hϖ] : Ideal.span {ϖ ^ n} = maximalIdeal B ^ n)).length_eq]
  exact IsDiscreteValuationRing.length_quotient_pow_maximalIdeal (R := B) n

private theorem length_quotient_bot : Module.length B (B ⧸ (⊥ : Ideal B)) = ⊤ :=
  (Submodule.quotEquivOfEqBot _ rfl).length_eq.trans length_self_eq_top

omit [IsDomain A] [IsDiscreteValuationRing A] [FaithfulSMul A B] [IsLocalHom (algebraMap A B)]
  [Module.Finite (ResidueField A) (ResidueField B)] in
/-- The Kähler different of `B` over `A` is either zero or the `n`-th power of the maximal ideal,
with `n = length_B(B ⧸ Fitt₀(Ω_{B/A}))` in the second case. -/
private theorem fittingIdeal_eq_bot_or_span_pow {ϖ : B} (hϖ : Irreducible ϖ) :
    (fittingIdeal (R := B) (M := Ω[B⁄A]) 0 = ⊥ ∧
        Module.length B (B ⧸ fittingIdeal (R := B) (M := Ω[B⁄A]) 0) = ⊤) ∨
      ∃ n : ℕ, fittingIdeal (R := B) (M := Ω[B⁄A]) 0 = Ideal.span {ϖ ^ n} ∧
        Module.length B (B ⧸ fittingIdeal (R := B) (M := Ω[B⁄A]) 0) = n := by
  by_cases h : fittingIdeal (R := B) (M := Ω[B⁄A]) 0 = ⊥
  · exact .inl ⟨h, by rw [h, length_quotient_bot]⟩
  · obtain ⟨n, hn⟩ := IsDiscreteValuationRing.ideal_eq_span_pow_irreducible h hϖ
    exact .inr ⟨n, hn, by rw [hn, length_quotient_span_pow hϖ n]⟩

omit [IsLocalHom (algebraMap A B)] [Algebra.EssFiniteType A B]
  [Module.Finite (ResidueField A) (ResidueField B)] in
/-- In the special fibre the image of the `n`-th power of a uniformizer vanishes exactly when
`e ≤ n`. -/
private theorem mk_pow_eq_zero_iff {ϖ : B} (hϖ : Irreducible ϖ) (n : ℕ) :
    (Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A B)) ϖ) ^ n = 0 ↔
      ramificationIdx A B ≤ n := by
  rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem, map_maximalIdeal_eq_span_pow hϖ,
    Ideal.mem_span_singleton, _root_.pow_dvd_pow_iff hϖ.ne_zero hϖ.not_isUnit]

omit [IsDomain B] [IsDiscreteValuationRing B] [FaithfulSMul A B] [IsLocalHom (algebraMap A B)]
  [Algebra.EssFiniteType A B] [Module.Finite (ResidueField A) (ResidueField B)] in
/-- The image in the special fibre of the ideal generated by `ϖ ^ n`. -/
private theorem map_span_pow {ϖ : B} (n : ℕ) :
    (Ideal.span {ϖ ^ n}).map (algebraMap B (specialFibre A B)) =
      Ideal.span {(Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A B)) ϖ) ^ n} := by
  rw [Ideal.map_span, Set.image_singleton, map_pow]
  rfl

/-- **The multiplicity of the different is at least `e - 1`** ([Stacks, Tag 0C1F] (2), algebraic
form). For an extension `A ⊆ B` of discrete valuation rings, essentially of finite type, with
finite residue field extension and ramification index `e`, the length of `B` modulo its Kähler
different over `A` is at least `e - 1`. -/
theorem ramificationIdx_sub_one_le_length_quotient_fittingIdeal :
    ((ramificationIdx A B - 1 : ℕ) : ℕ∞) ≤
      Module.length B (B ⧸ fittingIdeal (R := B) (M := Ω[B⁄A]) 0) := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible B
  rcases fittingIdeal_eq_bot_or_span_pow (A := A) hϖ with ⟨-, hd⟩ | ⟨n, hn, hd⟩
  · simp [hd]
  rw [hd, Nat.cast_le]
  set π := Ideal.Quotient.mk ((maximalIdeal A).map (algebraMap A B)) ϖ
  have hmem : π ^ n ∈ fittingIdeal (R := specialFibre A B)
      (M := Ω[specialFibre A B⁄ResidueField A]) 0 := by
    rw [fittingIdeal_kaehlerDifferential_specialFibre, hn, map_span_pow]
    exact Ideal.mem_span_singleton_self _
  have hπ : π ∈ maximalIdeal (specialFibre A B) := by
    rw [maximalIdeal_specialFibre hϖ]
    exact Ideal.mem_span_singleton_self _
  have h0 := mul_eq_zero_of_mem_fittingIdeal_kaehlerDifferential hmem hπ
  rw [← pow_succ', mk_pow_eq_zero_iff hϖ] at h0
  omega

/-- **The multiplicity of the different is `e - 1` exactly in the tame case** ([Stacks, Tag
0C1F] (3), algebraic form). For an extension `A ⊆ B` of discrete valuation rings, essentially of
finite type, with finite residue field extension and ramification index `e`, the length of `B`
modulo its Kähler different over `A` is `e - 1` if and only if `κ_B / κ_A` is separable and the
characteristic of `κ_A` does not divide `e`. -/
theorem length_quotient_fittingIdeal_eq_iff :
    Module.length B (B ⧸ fittingIdeal (R := B) (M := Ω[B⁄A]) 0) =
        ((ramificationIdx A B - 1 : ℕ) : ℕ∞) ↔
      Algebra.IsSeparable (ResidueField A) (ResidueField B) ∧
        ¬ ringChar (ResidueField A) ∣ ramificationIdx A B := by
  obtain ⟨ϖ, hϖ⟩ := IsDiscreteValuationRing.exists_irreducible B
  have he1 := one_le_ramificationIdx A B
  have hchar : (ramificationIdx A B : ResidueField A) ≠ 0 ↔
      ¬ ringChar (ResidueField A) ∣ ramificationIdx A B :=
    (CharP.cast_eq_zero_iff (ResidueField A) (ringChar _) _).not
  have hlen : ((Module.length (specialFibre A B) (specialFibre A B)).toNat : ResidueField A) =
      (ramificationIdx A B : ResidueField A) := by
    rw [length_specialFibre, ENat.toNat_natCast]
  have hfit := fittingIdeal_kaehlerDifferential_specialFibre (A := A) (B := B)
  have hne_iff {n : ℕ} (hn : fittingIdeal (R := B) (M := Ω[B⁄A]) 0 = Ideal.span {ϖ ^ n}) :
      fittingIdeal (R := specialFibre A B) (M := Ω[specialFibre A B⁄ResidueField A]) 0 ≠ ⊥ ↔
        n < ramificationIdx A B := by
    rw [hfit, hn, map_span_pow, Ne, Ideal.span_singleton_eq_bot, mk_pow_eq_zero_iff hϖ, not_le]
  rw [← isSeparable_residueField_specialFibre_iff, ← hchar]
  constructor
  · intro hd
    rcases fittingIdeal_eq_bot_or_span_pow (A := A) hϖ with ⟨-, hd'⟩ | ⟨n, hn, hd'⟩
