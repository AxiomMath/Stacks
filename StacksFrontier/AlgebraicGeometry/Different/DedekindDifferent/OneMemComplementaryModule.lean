module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Different.DedekindDifferent.ComplementaryModule
public import StacksFrontier.AlgebraicGeometry.Different.DedekindDifferent.DifferentIdeal

/-!
# The Dedekind different when one lies in the complementary module

Let `A → B` be a map for which the Dedekind different is defined and suppose `1` lies in the
complementary module `L_{B/A}`.  Its image under the trace-pairing identification
`c : L_{B/A} ≃ ω_{B/A} = Hom_A(B, A)` is the generic-fibre trace, the Dedekind different
consists of the elements carrying `ω_{B/A}` into the `B`-line generated by that functional, and
the Dedekind different ideal is the annihilator of `ω_{B/A} / B·c(1)`.

## Main results

* `Stacks.Discriminant.smul_tmul_fractionRing_eq_algebraMap_mul`: the `B`-action on the generic
  fibre is multiplication.
* `Stacks.Discriminant.complementaryModuleEquivDualizingModule_one_mem_apply`: the image of `1`
  is the generic-fibre trace.
* `Stacks.Discriminant.mem_dedekindDifferent_iff_smul_dual_le_span_one_mem`: the membership
  criterion for the Dedekind different.
* `Stacks.Discriminant.annihilator_dual_quotient_eq_dedekindDifferentIdeal`: the Dedekind
  different ideal is the annihilator of `ω_{B/A} / B·c(1)`.

## Implementation notes

These are the statements of Tag 0BW3 with flatness of `B` over `A` replaced by the hypothesis
that `1` lies in the complementary module, which is what the flat case supplies and what Tag
0BWN needs in the non-flat case.  The relative dualizing module of a finite map is
`Module.Dual A B` with the `B`-action `Stacks.Discriminant.algebraDualModule`.

## References

* [Stacks Project, Tag 0BW3](https://stacks.math.columbia.edu/tag/0BW3)
* [Stacks Project, Tag 0BW1](https://stacks.math.columbia.edu/tag/0BW1)
* [Stacks Project, Tag 0BWN](https://stacks.math.columbia.edu/tag/0BWN)
-/

@[expose] public noncomputable section

open scoped TensorProduct

namespace Stacks.Discriminant

universe u v

attribute [local instance] algebraDualModule

variable {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]

/-- The `B`-action on the generic fibre is multiplication by the image of the scalar. -/
theorem smul_tmul_fractionRing_eq_algebraMap_mul (r : B) (x : B ⊗[A] FractionRing A) :
    r • x = algebraMap B (B ⊗[A] FractionRing A) r * x := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | tmul b k =>
      simp [TensorProduct.smul_tmul',
        Algebra.TensorProduct.algebraMap_apply, Algebra.TensorProduct.tmul_mul_tmul]
  | add x y hx hy => simp [hx, hy, left_distrib]

/-- `b • y = c • 1` in the generic fibre says that `y` times `b` is the image of `c`. -/
private theorem smul_eq_smul_one_iff_algebraMap_eq_mul (b c : B) (y : B ⊗[A] FractionRing A) :
    b • y = c • (1 : B ⊗[A] FractionRing A) ↔
      algebraMap B (B ⊗[A] FractionRing A) c = algebraMap B (B ⊗[A] FractionRing A) b * y := by
  rw [smul_tmul_fractionRing_eq_algebraMap_mul, smul_tmul_fractionRing_eq_algebraMap_mul,
    mul_one, eq_comm]

variable (setup : DedekindDifferentSetup A B)
  (h1 : (1 : B ⊗[A] FractionRing A) ∈ setup.complementaryModule)

include h1

/-- Under the canonical trace-pairing identification of the complementary module with the
relative dualizing module `Hom_A(B, A)`, the element `1` becomes the generic-fibre trace. -/
theorem complementaryModuleEquivDualizingModule_one_mem_apply (b : B) :
    letI : Algebra (FractionRing A) (B ⊗[A] FractionRing A) :=
      Algebra.TensorProduct.rightAlgebra
    algebraMap A (FractionRing A)
        (complementaryModuleEquivDualizingModule setup ⟨1, h1⟩ b) =
      setup.trace (algebraMap B (B ⊗[A] FractionRing A) b) := by
  simpa using complementaryModuleEquivDualizingModule_apply setup ⟨1, h1⟩ b

/-- An element of `B` lies in the Dedekind different exactly when multiplication by it carries
the whole relative dualizing module into the `B`-line generated by the image of `1`. -/
theorem mem_dedekindDifferent_iff_smul_dual_le_span_one_mem (b : B) :
    algebraMap B (B ⊗[A] FractionRing A) b ∈ setup.dedekindDifferent ↔
      ∀ g : Module.Dual A B,
        b • g ∈ Submodule.span B
          { complementaryModuleEquivDualizingModule setup ⟨1, h1⟩ } := by
  let e := complementaryModuleEquivDualizingModule setup
  let oneC : setup.complementaryModule := ⟨1, h1⟩
  rw [DedekindDifferentSetup.mem_dedekindDifferent]
  constructor
  · intro h g
    obtain ⟨y, rfl⟩ := e.surjective g
    obtain ⟨c, hc⟩ := h y y.2
    have hy : b • y = c • oneC := by
      apply Subtype.ext
      exact (smul_eq_smul_one_iff_algebraMap_eq_mul b c y.1).mpr hc
    have heq := congrArg e hy
    rw [map_smul, map_smul] at heq
    show b • e y ∈ Submodule.span B {e oneC}
    rw [heq]
    exact Submodule.smul_mem _ c (Submodule.subset_span (by simp [oneC]))
  · intro h y hy
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (h (e ⟨y, hy⟩))
    have hyc : b • (⟨y, hy⟩ : setup.complementaryModule) = c • oneC :=
      e.injective (by rw [map_smul, map_smul, hc])
    exact ⟨c, (smul_eq_smul_one_iff_algebraMap_eq_mul b c y).mp (congrArg Subtype.val hyc)⟩

/-- The Dedekind different ideal is the annihilator of the quotient of the relative dualizing
module `Hom_A(B, A)` by the `B`-line generated by the image of `1`. -/
theorem annihilator_dual_quotient_eq_dedekindDifferentIdeal :
    Module.annihilator B
        (Module.Dual A B ⧸ Submodule.span B
          { complementaryModuleEquivDualizingModule setup ⟨1, h1⟩ }) =
      dedekindDifferentIdeal setup := by
  let W : Submodule B (Module.Dual A B) :=
    Submodule.span B { complementaryModuleEquivDualizingModule setup ⟨1, h1⟩ }
  ext c
  rw [show (c ∈ dedekindDifferentIdeal setup) ↔ ∀ g : Module.Dual A B, c • g ∈ W from
    mem_dedekindDifferent_iff_smul_dual_le_span_one_mem setup h1 c, Module.mem_annihilator]
  show (∀ q : Module.Dual A B ⧸ W, c • q = 0) ↔ ∀ g : Module.Dual A B, c • g ∈ W
  refine ⟨fun h g => (Submodule.Quotient.mk_eq_zero (p := W) (x := c • g)).mp ?_, fun h q => ?_⟩
  · simpa only [Submodule.Quotient.mk_smul] using h (Submodule.Quotient.mk g)
  · obtain ⟨g, rfl⟩ := Submodule.Quotient.mk_surjective W q
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
    exact h g

end Stacks.Discriminant

end
