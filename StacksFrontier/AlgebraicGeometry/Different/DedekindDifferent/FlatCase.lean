module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Different.DedekindDifferent.ComplementaryModule
public import StacksFrontier.AlgebraicGeometry.Different.DedekindDifferent.FlatTrace
public import StacksFrontier.AlgebraicGeometry.Different.DedekindDifferent.OneMemComplementaryModule

/-!
# The Dedekind different of a flat finite algebra

For a finite flat algebra whose Dedekind different is defined, the trace of every element of `B`
already lies in `A`, so `1` belongs to the complementary module. Under the canonical trace-pairing
identification of the complementary module with the relative dualizing module `Hom_A(B, A)`, the
element `1` becomes the trace functional, and the Dedekind different consists of exactly those
elements carrying the whole dualizing module into the `B`-line generated by that functional.

## Main results

* `Stacks.Discriminant.one_mem_complementaryModule_of_flat` places `1` in the complementary
  module.
* `Stacks.Discriminant.complementaryModuleEquivDualizingModule_one_apply` identifies its image
  with the trace functional.
* `Stacks.Discriminant.mem_dedekindDifferent_iff_smul_dual_le_trace` characterizes the Dedekind
  different.

## Implementation notes

For a finite map the relative dualizing module is `Module.Dual A B`. The trace functional is
specified by its values after the canonical injection `A → Q(A)`, which avoids choosing an
inverse to that injection. The characterization of the different is written as a membership
criterion for elements of `B`, with the line generated by the image of `1` under the canonical
equivalence.

## References

* [Stacks Project, Tag 0BW3](https://stacks.math.columbia.edu/tag/0BW3)
-/

@[expose] public noncomputable section

open scoped TensorProduct

namespace Stacks.Discriminant

universe u v

attribute [local instance] algebraDualModule

variable {A : Type u} {B : Type v} [CommRing A] [CommRing B] [Algebra A B]

variable (setup : DedekindDifferentSetup A B) [Module.Flat A B]

/-- Flatness makes the generic trace of every element of `B` integral over the base;
equivalently, `1` lies in the complementary module. -/
theorem one_mem_complementaryModule_of_flat :
    (1 : B ⊗[A] FractionRing A) ∈ setup.complementaryModule := by
  classical
  rw [DedekindDifferentSetup.mem_complementaryModule]
  intro b
  simpa only [mul_one] using trace_algebraMap_mem_range_of_flat setup b

/-- **Stacks Project, Tag 0BW3, part (1).** Under the canonical trace-pairing identification of
the complementary module with the relative dualizing module, `1` becomes the trace
functional. -/
@[stacks 0BW3 "part (1)"]
theorem complementaryModuleEquivDualizingModule_one_apply (b : B) :
    algebraMap A (FractionRing A)
      (complementaryModuleEquivDualizingModule setup
        ⟨1, one_mem_complementaryModule_of_flat setup⟩ b) =
      setup.trace (algebraMap B (B ⊗[A] FractionRing A) b) :=
  complementaryModuleEquivDualizingModule_one_mem_apply setup
    (one_mem_complementaryModule_of_flat setup) b

/-- **Stacks Project, Tag 0BW3, part (2).** An element of `B` lies in the Dedekind different
exactly when multiplication by it carries the whole relative dualizing module into the `B`-line
generated by the trace functional. -/
@[stacks 0BW3 "part (2)"]
theorem mem_dedekindDifferent_iff_smul_dual_le_trace (b : B) :
    algebraMap B (B ⊗[A] FractionRing A) b ∈ setup.dedekindDifferent ↔
      ∀ f : Module.Dual A B,
        b • f ∈ Submodule.span B
          { complementaryModuleEquivDualizingModule setup
              ⟨1, one_mem_complementaryModule_of_flat setup⟩ } :=
  mem_dedekindDifferent_iff_smul_dual_le_span_one_mem setup
    (one_mem_complementaryModule_of_flat setup) b

end Stacks.Discriminant

end
