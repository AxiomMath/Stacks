module

public import Mathlib.RingTheory.AdjoinRoot
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.Different.Formula.NoetherDifferentFormula

/-!
# The Noether different of a localized hypersurface

Let `A` be a ring and let `f, h` be polynomials in one variable over `A`, and set

`B = (A[x]/(f))_h = A[x, 1/h]/(f)`.

If `B` is quasi-finite over `A`, the Noether different of `B` over `A` is the ideal generated by
the image of the derivative `f'`.

## Main results

* `Stacks.Discriminant.noetherDifferent_map_of_algEquiv`: an isomorphism of algebras carries the
  Noether different onto the Noether different.
* `Stacks.Discriminant.exists_algEquiv_localizedHypersurface`: `B` is the one-variable case of
  `A[x_1, …, x_n, 1/h]/(f_1, …, f_n)`.
* `Stacks.Discriminant.noetherDifferent_localization_adjoinRoot`: the Noether different of `B`
  over `A` is `(f')`.

## Implementation notes

The formula is the one-variable case of the Jacobian formula
`Stacks.Discriminant.noetherDifferent_localizedCompleteIntersection`, which is stated for
`A[x_1, …, x_n, 1/h]/(f_1, …, f_n)` with the polynomial ring spelled `MvPolynomial (Fin n) A`.
Transporting it to the spelling of the example — `AdjoinRoot f` for `A[x]/(f)` and
`Localization.Away (AdjoinRoot.mk f h)` for its localization — uses the isomorphism
`MvPolynomial (Fin 1) A ≃ₐ[A] A[x]`, under which `∂/∂x_0` becomes `Polynomial.derivative`, and
the fact that two localizations of isomorphic rings at corresponding submonoids are isomorphic.

The source's Noetherian hypothesis on `A` is not needed for this formula and is not imposed;
quasi-finiteness of `B` over `A` is, as it is what makes `f` a Koszul-regular element of
`A[x, 1/h]`.

## References

* [Stacks Project, Tag 0BWI](https://stacks.math.columbia.edu/tag/0BWI)
* [Stacks Project, Tag 0BWD](https://stacks.math.columbia.edu/tag/0BWD)
-/

@[expose] public section

open scoped TensorProduct

universe u v w

namespace Stacks.Discriminant

/-! ### The one-variable polynomial ring with a single indexed variable -/

/-- `A[x_0] = A[x]`: the polynomial ring on one `Fin 1`-indexed variable is the univariate
polynomial ring. -/
noncomputable def finOnePolyEquiv (A : Type u) [CommRing A] :
    MvPolynomial (Fin 1) A ≃ₐ[A] Polynomial A :=
  (MvPolynomial.renameEquiv A finOneEquiv).trans (MvPolynomial.pUnitAlgEquiv A)

private theorem finOnePolyEquiv_X (A : Type u) [CommRing A] :
    finOnePolyEquiv A (MvPolynomial.X 0) = Polynomial.X := by
  simp [finOnePolyEquiv]

private theorem finOnePolyEquiv_C (A : Type u) [CommRing A] (a : A) :
    finOnePolyEquiv A (MvPolynomial.C a) = Polynomial.C a := by
  simpa using (finOnePolyEquiv A).commutes a

/-- Under the identification `A[x_0] = A[x]` the partial derivative in `x_0` is the derivative. -/
private theorem finOnePolyEquiv_pderiv (A : Type u) [CommRing A] (p : MvPolynomial (Fin 1) A) :
    finOnePolyEquiv A (MvPolynomial.pderiv 0 p) =
      Polynomial.derivative (finOnePolyEquiv A p) := by
  induction p using MvPolynomial.induction_on with
  | C a => rw [MvPolynomial.pderiv_C, map_zero, finOnePolyEquiv_C, Polynomial.derivative_C]
  | add p q hp hq => rw [Derivation.map_add, map_add, hp, hq, map_add, Polynomial.derivative_add]
  | mul_X p k hp =>
      obtain rfl : k = 0 := Subsingleton.elim k 0
      rw [MvPolynomial.pderiv_mul, MvPolynomial.pderiv_X_self, mul_one, map_add, map_mul, hp,
        finOnePolyEquiv_X, map_mul, finOnePolyEquiv_X, Polynomial.derivative_mul,
        Polynomial.derivative_X, mul_one]

/-! ### Transport of the Noether different along an isomorphism -/

/-- Membership in the image of an ideal under a ring isomorphism. -/
private theorem mem_map_ringEquiv_iff {R : Type v} {S : Type w} [CommRing R] [CommRing S]
    (E : R ≃+* S) (I : Ideal R) (y : S) :
    y ∈ Ideal.map (E : R →+* S) I ↔ E.symm y ∈ I := by
  rw [Ideal.map_comap_of_equiv E]
  simp

/-- The annihilator of an ideal is carried onto the annihilator of its image by a ring
isomorphism. -/
private theorem annihilator_map_of_ringEquiv {R : Type v} {S : Type w} [CommRing R] [CommRing S]
    (E : R ≃+* S) (I : Ideal R) :
    Ideal.map (E : R →+* S) I.annihilator = (Ideal.map (E : R →+* S) I).annihilator := by
  ext y
  rw [mem_map_ringEquiv_iff, Submodule.mem_annihilator, Submodule.mem_annihilator]
  refine ⟨fun hy z hz => ?_, fun hy z hz => ?_⟩
  · rw [mem_map_ringEquiv_iff] at hz
    simpa [smul_eq_mul] using congrArg E (hy _ hz)
  · simpa [smul_eq_mul] using congrArg E.symm (hy (E z) (Ideal.mem_map_of_mem _ hz))

/-- An isomorphism of `A`-algebras carries the Noether different onto the Noether different. -/
theorem noetherDifferent_map_of_algEquiv {A : Type u} {B : Type v} {B' : Type w} [CommRing A]
    [CommRing B] [CommRing B'] [Algebra A B] [Algebra A B'] (e : B ≃ₐ[A] B') :
    Ideal.map (e : B →+* B') (noetherDifferent A B) = noetherDifferent A B' := by
  classical
  let E : (B ⊗[A] B) ≃+* (B' ⊗[A] B') := (Algebra.TensorProduct.congr e e).toRingEquiv
  have hcomm (x : B ⊗[A] B) :
      Algebra.TensorProduct.lmul' A (E x) = e (Algebra.TensorProduct.lmul' A x) := by
    induction x with
    | zero => simp
    | tmul a b => simp [E]
    | add x y hx hy => simp only [map_add, hx, hy]
  have hring : (Algebra.TensorProduct.lmul' (R := A) (S := B')).toRingHom.comp
      (E : (B ⊗[A] B) →+* (B' ⊗[A] B')) =
        (e : B →+* B').comp (Algebra.TensorProduct.lmul' (R := A) (S := B)).toRingHom :=
    RingHom.ext hcomm
  have hker : Ideal.map (E : (B ⊗[A] B) →+* (B' ⊗[A] B'))
      (RingHom.ker (Algebra.TensorProduct.lmul' (R := A) (S := B)).toRingHom) =
        RingHom.ker (Algebra.TensorProduct.lmul' (R := A) (S := B')).toRingHom := by
    ext z
    rw [mem_map_ringEquiv_iff]
    simp only [RingHom.mem_ker, AlgHom.toRingHom_eq_coe, RingHom.coe_coe]
    have hz := hcomm (E.symm z)
    rw [E.apply_symm_apply] at hz
    refine ⟨fun hzero => ?_, fun hzero => ?_⟩
    · rwa [hzero, map_zero] at hz
    · rw [hzero] at hz
      exact e.injective (by simpa using hz.symm)
  show Ideal.map (e : B →+* B')
    (Ideal.map (Algebra.TensorProduct.lmul' A).toRingHom (diagonalAnnihilator A B)) =
      Ideal.map (Algebra.TensorProduct.lmul' A).toRingHom (diagonalAnnihilator A B')
  rw [Ideal.map_map, ← hring, ← Ideal.map_map]
  refine congrArg (Ideal.map (Algebra.TensorProduct.lmul' (R := A) (S := B')).toRingHom) ?_
  show Ideal.map (E : (B ⊗[A] B) →+* (B' ⊗[A] B'))
    (RingHom.ker (Algebra.TensorProduct.lmul' (R := A) (S := B)).toRingHom).annihilator =
      (RingHom.ker (Algebra.TensorProduct.lmul' (R := A) (S := B')).toRingHom).annihilator
  rw [annihilator_map_of_ringEquiv, hker]

/-! ### `(A[x]/(f))_h` as a one-variable localized complete intersection -/

/-- The unit `h` of `B = (A[x]/(f))_h`, read in the polynomial ring on one `Fin 1`-indexed
variable. -/
noncomputable abbrev localizedHypersurfaceUnit (A : Type u) [CommRing A] (h : Polynomial A) :
    MvPolynomial (Fin 1) A := (finOnePolyEquiv A).symm h

/-- The relation `f` of `B = (A[x]/(f))_h`, read as a one-element family in the polynomial ring
on one `Fin 1`-indexed variable. -/
noncomputable abbrev localizedHypersurfaceRelations (A : Type u) [CommRing A]
    (f : Polynomial A) : Fin 1 → MvPolynomial (Fin 1) A := fun _ ↦ (finOnePolyEquiv A).symm f

/-- `(A[x]/(f))_h` is the one-variable case of `A[x_1, …, x_n, 1/h]/(f_1, …, f_n)`: there is an
isomorphism of `A`-algebras between them carrying the class of a polynomial `p` to the class of
`p` read on one `Fin 1`-indexed variable. -/
theorem exists_algEquiv_localizedHypersurface (A : Type u) [CommRing A] (f h : Polynomial A) :
    ∃ Ψ : Localization.Away (AdjoinRoot.mk f h) ≃ₐ[A]
        localizedCompleteIntersection A 1 (localizedHypersurfaceUnit A h)
          (localizedHypersurfaceRelations A f),
      ∀ p : Polynomial A,
        Ψ (algebraMap (AdjoinRoot f) (Localization.Away (AdjoinRoot.mk f h))
            (AdjoinRoot.mk f p)) =
          algebraMap (MvPolynomial (Fin 1) A)
            (localizedCompleteIntersection A 1 (localizedHypersurfaceUnit A h)
              (localizedHypersurfaceRelations A f)) ((finOnePolyEquiv A).symm p) := by
  classical
  have hJeq : Ideal.span (Set.range (localizedHypersurfaceRelations A f)) =
      Ideal.map ((finOnePolyEquiv A).symm : Polynomial A →+* MvPolynomial (Fin 1) A)
        (Ideal.span {f}) := by
    rw [Ideal.map_span, Set.image_singleton]
    exact congrArg Ideal.span Set.range_const
  let e₁ : AdjoinRoot f ≃ₐ[A]
      (MvPolynomial (Fin 1) A ⧸ Ideal.span (Set.range (localizedHypersurfaceRelations A f))) :=
    Ideal.quotientEquivAlg (Ideal.span {f}) _ (finOnePolyEquiv A).symm hJeq
  have he₁ : ∀ p : Polynomial A, e₁ (AdjoinRoot.mk f p) =
      algebraMap (MvPolynomial (Fin 1) A)
        (MvPolynomial (Fin 1) A ⧸ Ideal.span (Set.range (localizedHypersurfaceRelations A f)))
        ((finOnePolyEquiv A).symm p) := fun _ ↦ rfl
  let : IsScalarTower A
      (MvPolynomial (Fin 1) A ⧸ Ideal.span (Set.range (localizedHypersurfaceRelations A f)))
      (localizedQuotient A 1 (localizedHypersurfaceUnit A h)
        (localizedHypersurfaceRelations A f)) :=
    IsScalarTower.of_algebraMap_eq fun _ ↦ rfl
  let := isLocalization_away_localizedQuotient A 1 (localizedHypersurfaceUnit A h)
    (localizedHypersurfaceRelations A f)
  have hpow : Submonoid.map e₁ (Submonoid.powers (AdjoinRoot.mk f h)) =
      Submonoid.powers (algebraMap (MvPolynomial (Fin 1) A)
        (MvPolynomial (Fin 1) A ⧸ Ideal.span (Set.range (localizedHypersurfaceRelations A f)))
        (localizedHypersurfaceUnit A h)) := by
    rw [Submonoid.map_powers, he₁ h]
  refine ⟨(IsLocalization.algEquivOfAlgEquiv (Localization.Away (AdjoinRoot.mk f h))
      (localizedQuotient A 1 (localizedHypersurfaceUnit A h)
        (localizedHypersurfaceRelations A f)) e₁ hpow).trans
    (localizedQuotientEquiv A 1 (localizedHypersurfaceUnit A h)
      (localizedHypersurfaceRelations A f)), fun p ↦ ?_⟩
  show localizedQuotientEquiv A 1 (localizedHypersurfaceUnit A h)
      (localizedHypersurfaceRelations A f)
    (IsLocalization.algEquivOfAlgEquiv (Localization.Away (AdjoinRoot.mk f h))
      (localizedQuotient A 1 (localizedHypersurfaceUnit A h)
        (localizedHypersurfaceRelations A f)) e₁ hpow
      (algebraMap (AdjoinRoot f) (Localization.Away (AdjoinRoot.mk f h))
        (AdjoinRoot.mk f p))) = _
  rw [IsLocalization.algEquivOfAlgEquiv_eq, he₁ p]
  rfl

/-! ### The Noether different of `(A[x]/(f))_h` -/

/-- **Stacks Project, Tag 0BWI.** For `B = (A[x]/(f))_h = A[x, 1/h]/(f)` quasi-finite over `A`,
the Noether different of `B` over `A` is the ideal generated by the image of the derivative
`f'`.

The source's Noetherian hypothesis on `A` is not needed for this formula and is not imposed. -/
@[stacks 0BWI "noether_different"]
theorem noetherDifferent_localization_adjoinRoot (A : Type u) [CommRing A] (f h : Polynomial A)
    [Algebra.QuasiFinite A (Localization.Away (AdjoinRoot.mk f h))] :
    noetherDifferent A (Localization.Away (AdjoinRoot.mk f h)) =
      Ideal.span {algebraMap (AdjoinRoot f) (Localization.Away (AdjoinRoot.mk f h))
        (AdjoinRoot.mk f f.derivative)} := by
  classical
  obtain ⟨Ψ, hΨ⟩ := exists_algEquiv_localizedHypersurface A f h
  let : Algebra.QuasiFinite A (localizedCompleteIntersection A 1
      (localizedHypersurfaceUnit A h) (localizedHypersurfaceRelations A f)) :=
    (Algebra.QuasiFinite.iff_of_algEquiv Ψ).mp inferInstance
  have hderiv : MvPolynomial.pderiv 0 ((finOnePolyEquiv A).symm f) =
      (finOnePolyEquiv A).symm f.derivative := by
    apply (finOnePolyEquiv A).injective
    rw [finOnePolyEquiv_pderiv, AlgEquiv.apply_symm_apply, AlgEquiv.apply_symm_apply]
  rw [← noetherDifferent_map_of_algEquiv Ψ.symm,
    noetherDifferent_localizedCompleteIntersection A 1 (localizedHypersurfaceUnit A h)
      (localizedHypersurfaceRelations A f), Ideal.map_span, Set.image_singleton]
  refine congrArg (fun z ↦ Ideal.span ({z} : Set (Localization.Away (AdjoinRoot.mk f h)))) ?_
  have hdet : (Matrix.det fun i j : Fin 1 ↦
        algebraMap (MvPolynomial (Fin 1) A) (localizedCompleteIntersection A 1
            (localizedHypersurfaceUnit A h) (localizedHypersurfaceRelations A f))
          (MvPolynomial.pderiv j (localizedHypersurfaceRelations A f i))) =
      algebraMap (MvPolynomial (Fin 1) A) (localizedCompleteIntersection A 1
          (localizedHypersurfaceUnit A h) (localizedHypersurfaceRelations A f))
        ((finOnePolyEquiv A).symm f.derivative) :=
    (Matrix.det_fin_one _).trans (congrArg _ hderiv)
  exact (congrArg (⇑Ψ.symm) hdet).trans (Ψ.symm_apply_eq.mpr (hΨ f.derivative).symm)

end Stacks.Discriminant

end
