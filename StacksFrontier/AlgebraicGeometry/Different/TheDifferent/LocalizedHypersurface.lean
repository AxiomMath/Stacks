module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Different.NoetherDifferent.LocalizedHypersurface
public import StacksFrontier.AlgebraicGeometry.Different.TheDifferent.BaseChange
public import StacksFrontier.AlgebraicGeometry.Different.TheDifferent.NoetherComparison
public import StacksFrontier.AlgebraicGeometry.Discriminant.DualizingModuleQuasiFiniteSyntomic
public import StacksFrontier.AlgebraicGeometry.Duality.RelativeDualizing.ChartFactorization
public import StacksFrontier.AlgebraicGeometry.Morphisms.Syntomic.QuasiFinite

/-!
# The different on a chart of the form `(A[x]/(f))_h`

Let `g : Y ⟶ X` be a flat locally quasi-finite morphism of locally Noetherian schemes with
relative dualizing module `ω_{Y/X}` and trace element `τ_{Y/X}`.  On an affine chart
`V = Spec B ⊆ Y` over an affine open `U = Spec A ⊆ X` for which `B = (A[x]/(f))_h`, the different
`𝔇_g` is the ideal sheaf generated by the image of the derivative `f'`.

## Main results

* `Stacks.Discriminant.exists_squarePresentation_localization_adjoinRoot`: `(A[x]/(f))_h` has a
  square presentation over `A`.
* `Stacks.Discriminant.flat_localization_adjoinRoot`,
  `Stacks.Discriminant.isNoetherianRing_localization_adjoinRoot`,
  `Stacks.Discriminant.nonempty_finiteOpenFactorization_localization_adjoinRoot` and
  `Stacks.Discriminant.module_invertible_dualizingModule_localization_adjoinRoot`: everything the
  different of `(A[x]/(f))_h` over `A` needs, derived from quasi-finiteness alone.
* `Stacks.Discriminant.cokerSpanIdeal_traceElement_localization_adjoinRoot`: the different of
  `Spec(B)` over `Spec(A)` is `(f')`.
* `Stacks.Discriminant.different_sections_eq_span_derivative`: the same for a morphism of
  schemes that carries dualizing data, on a chart of this form.

## Implementation notes

Taking `Y = Spec(B)`, `X = Spec(A)` and `U = V = ⊤` turns the main result into the
scheme-different assertion of Example 0BWI: the quasi-coherent sheaf of ideals associated to
`(f') ⊆ B` is the different of `Spec(B)` over `Spec(A)`.  The statement is given on a general
chart because the different is a sheaf on `Y`, and on an affine chart a coherent ideal sheaf is
the tilde of its ideal of sections; this is the same affine-local reading of a tilde statement
that `Stacks.Discriminant.different_sections_eq_noetherDifferent` uses for Tag 0BW6, and the
chart form contains the `Spec(B) → Spec(A)` case.

The two inputs are Tag 0BW6, which identifies the different on a chart with the Noether
different as soon as the algebraic relative dualizing module of the chart is invertible, and Tag
0BWF, which supplies that invertibility from a square presentation.  The square presentation of
`(A[x]/(f))_h` is `A[x, y]/(f, y h - 1)`, obtained from
`Algebra.exists_square_presentation_of_away_quotient` through the identification of
`(A[x]/(f))_h` with the one-variable localized complete intersection,
`Stacks.Discriminant.exists_algEquiv_localizedHypersurface`.  The Noether different of the chart
is then `(f')` by `Stacks.Discriminant.noetherDifferent_localization_adjoinRoot`.

## References

* [Stacks Project, Tag 0BWI](https://stacks.math.columbia.edu/tag/0BWI)
* [Stacks Project, Tag 0BW6](https://stacks.math.columbia.edu/tag/0BW6)
* [Stacks Project, Tag 0BWF](https://stacks.math.columbia.edu/tag/0BWF)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open scoped AlgebraicGeometry

attribute [local implicit_reducible] SheafOfModules.unit PresheafOfModules.unit
  PresheafOfModules.presheaf TopCat.Sheaf structureSheafRing Scheme.Modules

universe u

namespace Stacks.Discriminant

/-- A quasi-finite `B = (A[x]/(f))_h` has a square presentation over `A`: the two variables
`x, y` and the two relations `f(x)`, `y h(x) - 1`. -/
theorem exists_squarePresentation_localization_adjoinRoot (A : Type u) [CommRing A]
    (f h : Polynomial A) [Algebra.QuasiFinite A (Localization.Away (AdjoinRoot.mk f h))] :
    ∃ m : ℕ, Nonempty (Algebra.Presentation A (Localization.Away (AdjoinRoot.mk f h))
      (Fin m) (Fin m)) := by
  obtain ⟨Ψ, -⟩ := exists_algEquiv_localizedHypersurface A f h
  obtain ⟨m, P, -⟩ := Algebra.exists_square_presentation_of_away_quotient
    (localizedHypersurfaceUnit A h) (localizedHypersurfaceRelations A f) Ψ
  exact ⟨m, ⟨P⟩⟩

/-- A quasi-finite `B = (A[x]/(f))_h` is a finitely presented `A`-algebra, by its square
presentation. -/
theorem finitePresentation_localization_adjoinRoot (A : Type u) [CommRing A]
    (f h : Polynomial A) [Algebra.QuasiFinite A (Localization.Away (AdjoinRoot.mk f h))] :
    Algebra.FinitePresentation A (Localization.Away (AdjoinRoot.mk f h)) := by
  obtain ⟨m, ⟨P⟩⟩ := exists_squarePresentation_localization_adjoinRoot A f h
  exact P.finitePresentation_of_isFinite

/-- A quasi-finite `B = (A[x]/(f))_h` admits a finite-open factorization of `A → B`, so the
relative dualizing module `ω_{B/A}` of Tag 0BSZ is defined for it. -/
theorem nonempty_finiteOpenFactorization_localization_adjoinRoot (A : Type u) [CommRing A]
    (f h : Polynomial A) [Algebra.QuasiFinite A (Localization.Away (AdjoinRoot.mk f h))] :
    Nonempty (FiniteOpenFactorization.{u, u, u} A (Localization.Away (AdjoinRoot.mk f h))) :=
  have : Algebra.FinitePresentation A (Localization.Away (AdjoinRoot.mk f h)) :=
    finitePresentation_localization_adjoinRoot A f h
  nonempty_finiteOpenFactorization

/-- `B = (A[x]/(f))_h` is flat over `A` as soon as it is quasi-finite over `A`; flatness is not
an extra hypothesis.  This is the one-variable case of Tag 0BWD (1),
`Stacks.Discriminant.flat_localizedCompleteIntersection`. -/
theorem flat_localization_adjoinRoot (A : Type u) [CommRing A] (f h : Polynomial A)
    [Algebra.QuasiFinite A (Localization.Away (AdjoinRoot.mk f h))] :
    Module.Flat A (Localization.Away (AdjoinRoot.mk f h)) := by
  obtain ⟨Ψ, -⟩ := exists_algEquiv_localizedHypersurface A f h
  let : Algebra.QuasiFinite A (localizedCompleteIntersection A 1
      (localizedHypersurfaceUnit A h) (localizedHypersurfaceRelations A f)) :=
    (Algebra.QuasiFinite.iff_of_algEquiv Ψ).mp inferInstance
  let : Module.Flat A (localizedCompleteIntersection A 1 (localizedHypersurfaceUnit A h)
      (localizedHypersurfaceRelations A f)) :=
    flat_localizedCompleteIntersection A 1 (localizedHypersurfaceUnit A h)
      (localizedHypersurfaceRelations A f)
  exact Module.Flat.of_linearEquiv Ψ.toLinearEquiv

/-- For a quasi-finite `B = (A[x]/(f))_h` over a Noetherian `A`, `B` is a Noetherian ring: it is
of finite presentation over `A` by its square presentation. -/
theorem isNoetherianRing_localization_adjoinRoot (A : Type u) [CommRing A] [IsNoetherianRing A]
    (f h : Polynomial A) [Algebra.QuasiFinite A (Localization.Away (AdjoinRoot.mk f h))] :
    IsNoetherianRing (Localization.Away (AdjoinRoot.mk f h)) :=
  have : Algebra.FinitePresentation A (Localization.Away (AdjoinRoot.mk f h)) :=
    finitePresentation_localization_adjoinRoot A f h
  Algebra.FiniteType.isNoetherianRing A _

/-- The relative dualizing module `ω_{B/A}` of a quasi-finite `B = (A[x]/(f))_h` over a
Noetherian `A` is an invertible `B`-module.  This is Tag 0BWF for the square presentation
`A[x, y]/(f, y h - 1)`; invertibility is derived from quasi-finiteness, not assumed. -/
theorem module_invertible_dualizingModule_localization_adjoinRoot (A : Type u) [CommRing A]
    [IsNoetherianRing A] (f h : Polynomial A)
    [Algebra.QuasiFinite A (Localization.Away (AdjoinRoot.mk f h))]
    (F : FiniteOpenFactorization.{u, u, u} A (Localization.Away (AdjoinRoot.mk f h))) :
    letI : IsNoetherianRing (Localization.Away (AdjoinRoot.mk f h)) :=
      isNoetherianRing_localization_adjoinRoot A f h
    letI : Module.Flat A (Localization.Away (AdjoinRoot.mk f h)) :=
      flat_localization_adjoinRoot A f h
    Module.Invertible (Localization.Away (AdjoinRoot.mk f h)) (dualizingModule F) := by
  let : IsNoetherianRing (Localization.Away (AdjoinRoot.mk f h)) :=
    isNoetherianRing_localization_adjoinRoot A f h
  let : Module.Flat A (Localization.Away (AdjoinRoot.mk f h)) :=
    flat_localization_adjoinRoot A f h
  obtain ⟨m, ⟨P⟩⟩ := exists_squarePresentation_localization_adjoinRoot A f h
  exact dualizingModule_invertible_of_squarePresentation P F

/-- **Stacks Project, Tag 0BWI.** Let `A` be a Noetherian ring and `f, h ∈ A[x]` with
`B = (A[x]/(f))_h` quasi-finite over `A`.  The different of `Spec(B)` over `Spec(A)` — the
annihilator of the cokernel of `B → ω_{B/A}`, `b ↦ b τ_{B/A}`, which is Definition 0BW4 read on
the affine `Spec(B)` — is the ideal generated by the image of the derivative `f'`.

So `(f') ⊆ B` is the ideal whose associated quasi-coherent sheaf of ideals is the different:
`Stacks.Discriminant.different_sections_eq_cokerSpanIdeal` identifies the ideal of sections of
the different over an affine chart with this ideal, and on an affine scheme a coherent ideal
sheaf is the tilde of its ideal of sections.

Nothing is assumed beyond the hypotheses of the example.  `B` Noetherian, `B` flat over `A` and
`ω_{B/A}` invertible are all derived from quasi-finiteness, by
`Stacks.Discriminant.isNoetherianRing_localization_adjoinRoot`,
`Stacks.Discriminant.flat_localization_adjoinRoot` and
`Stacks.Discriminant.module_invertible_dualizingModule_localization_adjoinRoot`; the `letI`
bindings below are those derivations, not hypotheses.  The statement is for every finite-open
factorization `F` of `A → B`, of which there is one by
`Stacks.Discriminant.nonempty_finiteOpenFactorization_localization_adjoinRoot`, and the ideal is
independent of the choice because `ω_{B/A}` is (Tag 0BT1). -/
@[stacks 0BWI "scheme_different"]
theorem cokerSpanIdeal_traceElement_localization_adjoinRoot (A : Type u) [CommRing A]
    [IsNoetherianRing A] (f h : Polynomial A)
    [Algebra.QuasiFinite A (Localization.Away (AdjoinRoot.mk f h))] :
    letI : IsNoetherianRing (Localization.Away (AdjoinRoot.mk f h)) :=
      isNoetherianRing_localization_adjoinRoot A f h
    letI : Module.Flat A (Localization.Away (AdjoinRoot.mk f h)) :=
      flat_localization_adjoinRoot A f h
    ∀ F : FiniteOpenFactorization.{u, u, u} A (Localization.Away (AdjoinRoot.mk f h)),
      Stacks.Annihilator.cokerSpanIdeal (Localization.Away (AdjoinRoot.mk f h))
          (dualizingModule.traceElement F) =
        Ideal.span {algebraMap (AdjoinRoot f) (Localization.Away (AdjoinRoot.mk f h))
                      (AdjoinRoot.mk f f.derivative)} := by
  let : IsNoetherianRing (Localization.Away (AdjoinRoot.mk f h)) :=
    isNoetherianRing_localization_adjoinRoot A f h
  let : Module.Flat A (Localization.Away (AdjoinRoot.mk f h)) :=
    flat_localization_adjoinRoot A f h
  intro F
  let : Module.Invertible (Localization.Away (AdjoinRoot.mk f h)) (dualizingModule F) :=
    module_invertible_dualizingModule_localization_adjoinRoot A f h F
  refine SetLike.coe_injective ?_
  rw [Stacks.Annihilator.cokerSpanIdeal_def,
    ← range_eval_eq_annihilator_quotient_span (dualizingModule.traceElement F),
    ← noetherDifferent_eq_range_traceElement F,
    noetherDifferent_localization_adjoinRoot A f h]

variable {X Y : Scheme.{u}} {g : Y ⟶ X}
  [IsLocallyNoetherian X] [IsLocallyNoetherian Y] [Flat g] [LocallyQuasiFinite g]

/-- **Stacks Project, Tag 0BWI.** Let `g : Y ⟶ X` be flat and locally quasi-finite between
locally Noetherian schemes, with relative dualizing module `ω` and trace section `τ`.  On affine
opens `V = Spec B ⊆ Y` and `U = Spec A ⊆ X` with `g(V) ⊆ U` for which `B = (A[x]/(f))_h`, the
ideal of sections of the different `𝔇_g` over `V` is generated by the image of the derivative
`f'`.

Equivalently: the quasi-coherent sheaf of ideals associated to `(f') ⊆ B` is the different.  The
case `Y = Spec(B)`, `X = Spec(A)`, `U = V = ⊤` is
`Stacks.Discriminant.cokerSpanIdeal_traceElement_localization_adjoinRoot`, which needs no
dualizing data; this is the form for a morphism that carries some. -/
theorem different_sections_eq_span_derivative (ω : RelativeDualizingModuleData g)
    (τ : RelativeTraceSection ω) (U : X.affineOpens) (V : Y.affineOpens)
    (hVU : V.1 ≤ g ⁻¹ᵁ U.1) :
    letI : Algebra Γ(X, U.1) Γ(Y, V.1) := (g.appLE U V hVU).hom.toAlgebra
    ∀ (f h : Polynomial Γ(X, U.1))
      (e : Localization.Away (AdjoinRoot.mk f h) ≃ₐ[Γ(X, U.1)] Γ(Y, V.1)),
      (show Ideal Γ(Y, V.1) from (different ω τ).toSubmodule.obj (op V.1)) =
        Ideal.span {e (algebraMap (AdjoinRoot f) (Localization.Away (AdjoinRoot.mk f h))
                        (AdjoinRoot.mk f f.derivative))} := by
  let : Algebra Γ(X, U.1) Γ(Y, V.1) := (g.appLE U V hVU).hom.toAlgebra
  let : IsNoetherianRing Γ(X, U.1) := IsLocallyNoetherian.component_noetherian U
  let : IsNoetherianRing Γ(Y, V.1) := IsLocallyNoetherian.component_noetherian V
  let : Module.Flat Γ(X, U.1) Γ(Y, V.1) :=
    RingHom.flat_algebraMap_iff.mp (g.flat_appLE U.2 V.2 hVU)
  let : Algebra.QuasiFinite Γ(X, U.1) Γ(Y, V.1) :=
    RingHom.quasiFinite_algebraMap.mp (LocallyQuasiFinite.quasiFinite_appLE U.2 V.2 hVU)
  intro f h e
  obtain ⟨F⟩ := ω.factorization U V hVU
  let : Algebra.QuasiFinite Γ(X, U.1) (Localization.Away (AdjoinRoot.mk f h)) :=
    (Algebra.QuasiFinite.iff_of_algEquiv e).mpr inferInstance
  obtain ⟨m, ⟨P⟩⟩ := exists_squarePresentation_localization_adjoinRoot Γ(X, U.1) f h
  have hinv : Module.Invertible Γ(Y, V.1) (dualizingModule F) :=
    dualizingModule_invertible_of_squarePresentation (P.ofAlgEquiv e) F
  rw [different_sections_eq_noetherDifferent ω τ U V hVU F hinv,
    ← noetherDifferent_map_of_algEquiv e,
    noetherDifferent_localization_adjoinRoot Γ(X, U.1) f h, Ideal.map_span, Set.image_singleton]
  rfl

end Stacks.Discriminant

end
