/-!
# The norm of the different and the discriminant

Let `f : Y ⟶ X` be a finite flat morphism of locally Noetherian schemes, with `Y` the source and
`X` the base, let `ω_{Y/X}` be a relative dualizing module with trace element `τ_{Y/X}` and let
`𝔇_f ⊆ 𝒪_Y` be the resulting different.  The norm `Norm_f : f_*𝒪_Y → 𝒪_X` carries `f_*𝔇_f` into
the ideal sheaf of the discriminant `D_f`, and when `ω_{Y/X}` is invertible the norm of the
closed subscheme `R` cut out by `𝔇_f` is `D_f`.

## Main results

* `Stacks.Discriminant.mem_different_obj_affine_iff`: on an affine chart `V = Spec B` lying over
  an affine open `U = Spec A` of the base, a section of the different is an element of `B`
  carrying the whole linear dual `Hom_A(B, A)` into the image of the trace pairing.
* `Stacks.Discriminant.finiteLocallyFreeNorm_app_mem_discriminantIdeal`: the norm of a section of
  the different over the preimage of an affine open `U` of the base lies in the discriminant
  ideal over `U`.
* `Stacks.Discriminant.exists_different_obj_affine_eq_span_and_discriminantIdeal_eq_span_norm`:
  on a chart `f ⁻¹ U = Spec B` free over `U = Spec A` with `Hom_A(B, A)` free of rank one over
  `B`, the different is generated by one element and the discriminant ideal over `U` is
  generated by its norm.
* `Stacks.Discriminant.discriminantIdeal_eq_normIdealSheaf_differentIdealSheaf`: Tag 0BWA (2),
  if `ω_{Y/X}` is invertible then the norm of `R` is the discriminant, as ideal sheaves on `X`.

## Implementation notes

Both sides of Tag 0BW8 are ideal sheaves on the base and affine opens of the base generate, so
the statement is made over an affine open `U` of `X`: the preimage `f ⁻¹ᵁ U` is affine because a
finite morphism is affine, and the content is the affine computation
`Stacks.Discriminant.finiteProjective_mem_algebraDiscriminantIdeal_of_smul_dual_mem_range`
applied to the algebra `Γ(X, U) → Γ(Y, f ⁻¹ᵁ U)`.

The affine computation is run in its hypothesis-free form, through the condition that
multiplication by the section carries `Hom_A(B, A)` into the image of the trace pairing: for a
general finite flat morphism the Dedekind different of `Γ(X, U) → Γ(Y, f ⁻¹ᵁ U)` need not be
defined, since that asks for an étale generic fibre, so Tag 0BW5 is not available.  What replaces
it is `Stacks.Discriminant.mem_different_obj_affine_iff`, which reads off the sections of the
different on a chart with no hypothesis beyond finiteness: the different is the annihilator of
the cokernel of `𝒪_Y → ω_{Y/X}`, the sections of an annihilator sheaf over an affine open are the
annihilator of the sections, and on the chart the trace morphism becomes `B → Hom_A(B, A)`,
`1 ↦ Tr_{B/A}`, by uniqueness of trace elements (Tag 0BT7) against Tag 0BT8.

The different is set up for a morphism `f : Y ⟶ X` with source `Y`, while the discriminant ideal
sheaf and the norm are set up for a morphism with source the *first* scheme.  The source
convention of the different is the one used here, so `Stacks.Discriminant.discriminantIdeal f`
and `Stacks.Norm.finiteLocallyFreeNorm f` live on the base `X`.  The algebra of sections carries
two spellings of the same structure map, `f.appLE U (f ⁻¹ᵁ U) le_rfl` for the different and
`f.app U` for the discriminant and the norm; they are equal but not definitionally so, whence the
transport `Stacks.Discriminant.mem_algebraDiscriminantIdeal_of_algebra_eq`.

For Tag 0BWA (2) the norm of `R` is `Stacks.Norm.normIdealSheaf f (differentIdealSheaf ω τ)`, the
ideal sheaf on `X` generated over an affine open `U` by the norms of the sections of `𝔇_f` over
`f⁻¹U`; where `𝔇_f` is generated by `b` over `f⁻¹U` this is the ideal generated by
`Norm_f(b)`.  The equality with `D_f` is reduced by
`Stacks.Norm.eq_normIdealSheaf_of_forall_exists` to the charts of the source's proof: an affine
open `U` over which `Γ(Y, f⁻¹U)` is free (`Stacks.Norm.exists_affineOpens_mem_le_free`) and
contained in an open over whose preimage `ω_{Y/X}` is trivial (Tag 0BUT,
`Stacks.Divisors.hasTrivializingTargetCover_of_isFinite`).  A generator of `Γ(ω_{Y/X}, f⁻¹U)`
transported along `ω_{Y/X}(f⁻¹U) ≅ Hom_A(B, A)` is the basis element `λ`.

## References

* [Stacks Project, Tag 0BW8](https://stacks.math.columbia.edu/tag/0BW8)
* [Stacks Project, Tag 0BW4](https://stacks.math.columbia.edu/tag/0BW4)
* [Stacks Project, Tag 0BT7](https://stacks.math.columbia.edu/tag/0BT7)
* [Stacks Project, Tag 0BT8](https://stacks.math.columbia.edu/tag/0BT8)
* [Stacks Project, Tag 02KB](https://stacks.math.columbia.edu/tag/02KB)
* [Stacks Project, Tag 0BUT](https://stacks.math.columbia.edu/tag/0BUT)
* [Stacks Project, Tag 0BWA](https://stacks.math.columbia.edu/tag/0BWA)
* [Stacks Project, Tag 0C17](https://stacks.math.columbia.edu/tag/0C17)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
  RingedSpaceModuleAdjunction TopologicalSpace
open scoped AlgebraicGeometry TensorProduct

universe u

namespace Stacks.Discriminant

attribute [local instance] algebraDualModule

/-! ### The trace element as the trace pairing -/

section Algebraic

variable {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]

/-- Under the identification of the relative dualizing module of a finite flat algebra with
`Hom_A(B, A)`, the trace element of Tag 0BT8 is the trace pairing against `1`, that is, the
ordinary trace functional `Tr_{B/A}`. -/
theorem selfFactorizationDualEquiv_finiteFlatTraceElement_eq_traceForm_one
    [IsNoetherianRing A] [Module.Finite A B] [Module.Flat A B] [Module.Projective A B] :
    selfFactorizationDualEquiv (finiteFlatTraceElement A B) =
      finiteProjectiveTraceForm A B 1 := by
  refine LinearMap.ext fun b ↦ ?_
  rw [finiteProjectiveTraceForm_one_apply]
  change ((TensorProduct.lid B (Module.Dual A B))
    ((TensorProduct.comm B (Module.Dual A B) B)
      (((finiteProjectiveTrace A B).comp
        (Algebra.lmul A B).toLinearMap) ⊗ₜ (1 : B)))) b = _
  simp only [TensorProduct.comm_tmul, TensorProduct.lid_tmul, one_smul]
  rfl

omit [Algebra A B] in
/-- Two algebra structures on the same pair of rings that are equal have the same discriminant
ideal and the same projective norm, so membership of a norm in the discriminant ideal transports
from one to the other. -/
theorem mem_algebraDiscriminantIdeal_of_algebra_eq {i j : Algebra A B} (h : i = j) {b : B}
    (H : ∀ (hf : @Module.Finite A B _ _ i.toModule)
      (hp : @Module.Projective A _ B _ i.toModule),
      (@Algebra.projectiveNorm A B _ _ i hf hp) b ∈ @algebraDiscriminantIdeal A B _ _ i)
    (hf : @Module.Finite A B _ _ j.toModule)
    (hp : @Module.Projective A _ B _ j.toModule) :
    (@Algebra.projectiveNorm A B _ _ j hf hp) b ∈ @algebraDiscriminantIdeal A B _ _ j := by
  subst h
  exact H hf hp

end Algebraic

/-! ### Sections of the different on an affine chart -/

section Chart

open Stacks.AlgebraicGeometry.QuasicoherentBaseChange

attribute [local implicit_reducible] SheafOfModules.unit PresheafOfModules.unit
  PresheafOfModules.presheaf TopCat.Sheaf Scheme.Modules

variable {X Y : Scheme.{u}} {f : Y ⟶ X}
  [IsLocallyNoetherian X] [IsLocallyNoetherian Y] [Flat f] [LocallyQuasiFinite f]

/-- Let `f : Y → X` be a flat locally quasi-finite morphism of locally Noetherian schemes and let
`V = Spec B ⊆ Y` and `U = Spec A ⊆ X` be affine opens with `f(V) ⊆ U` and `B` finite over `A`.  A
section of the different `𝔇_f` over `V` is exactly an element of `B` carrying the whole linear
dual `Hom_A(B, A)` into the image of the trace pairing of `B` over `A`. -/
theorem mem_different_obj_affine_iff (ω : RelativeDualizingModuleData f)
    (τ : RelativeTraceSection ω) (U : X.affineOpens) (V : Y.affineOpens)
    (hVU : V.1 ≤ f ⁻¹ᵁ U.1) :
    letI : Algebra Γ(X, U.1) Γ(Y, V.1) := (f.appLE U V hVU).hom.toAlgebra
    ∀ [Module.Finite Γ(X, U.1) Γ(Y, V.1)] [Module.Projective Γ(X, U.1) Γ(Y, V.1)]
      (b : Γ(Y, V.1)),
      b ∈ (show Ideal Γ(Y, V.1) from (different ω τ).toSubmodule.obj (op V.1)) ↔
        ∀ g : Module.Dual Γ(X, U.1) Γ(Y, V.1),
          b • g ∈ LinearMap.range (finiteProjectiveTraceForm Γ(X, U.1) Γ(Y, V.1)) := by
  let : Algebra Γ(X, U.1) Γ(Y, V.1) := (f.appLE U V hVU).hom.toAlgebra
  intro _ _ b
  let : IsNoetherianRing Γ(X, U.1) := IsLocallyNoetherian.component_noetherian U
  let : IsNoetherianRing Γ(Y, V.1) := IsLocallyNoetherian.component_noetherian V
  let : Module.Flat Γ(X, U.1) Γ(Y, V.1) :=
    RingHom.flat_algebraMap_iff.mp (f.flat_appLE U.2 V.2 hVU)
  let : Algebra.QuasiFinite Γ(X, U.1) Γ(Y, V.1) :=
    RingHom.quasiFinite_algebraMap.mp (LocallyQuasiFinite.quasiFinite_appLE U.2 V.2 hVU)
  let φ := traceMorphism ω τ
  have hωq : ω.sheaf.IsQuasicoherent := ω.isQuasicoherent
  have hωc : ω.sheaf.IsCoherent := ω.isCoherent
  have hunit : (SheafOfModules.unit Y.ringCatSheaf).IsCoherent :=
    Stacks.AlgebraicGeometry.CoherenceCriteria.structureSheaf_isCoherent Y
  have hunitq : (SheafOfModules.unit Y.ringCatSheaf).IsQuasicoherent :=
    (Stacks.AlgebraicGeometry.CoherentTFAE.isQuasicoherent_isFiniteType_of_isCoherent
      (SheafOfModules.unit Y.ringCatSheaf)).1
  have hcok : (cokernel φ).IsCoherent :=
    @_root_.SheafOfModules.cokernel_isCoherent _ _ _ _ _ hunit hωc φ
  have hD : (show Ideal Γ(Y, V.1) from (different ω τ).toSubmodule.obj (op V.1)) =
      Module.annihilator Γ(Y, V.1) Γ(cokernel φ, V.1) :=
    @annihilatorSheaf_obj_eq_annihilator Y _ (cokernel φ) hcok V
  let j := V.2.fromSpec
  let : IsOpenImmersion j := V.2.isOpenImmersion_fromSpec
  let R : CommRingCat := CommRingCat.of Γ(Y, V.1)
  let FΓ := moduleSpecΓFunctor (R := R)
  let fSpec := (Scheme.Modules.restrictFunctor j).map φ
  let OSpec := (Scheme.Modules.restrictFunctor j).obj (SheafOfModules.unit Y.ringCatSheaf)
  let MSpec := (Scheme.Modules.restrictFunctor j).obj ω.sheaf
  let : OSpec.IsQuasicoherent := Scheme.Modules.isQuasicoherent_restrictFunctor j _
  let : MSpec.IsQuasicoherent := Scheme.Modules.isQuasicoherent_restrictFunctor j _
  let F := selfFactorization Γ(X, U.1) Γ(Y, V.1)
  let eO : FΓ.obj OSpec ≃ₗ[Γ(Y, V.1)] Γ(Y, V.1) :=
    specGammaToOpenEquiv V.2 (SheafOfModules.unit Y.ringCatSheaf)
  let eM : FΓ.obj MSpec ≃ₗ[Γ(Y, V.1)] Module.Dual Γ(X, U.1) Γ(Y, V.1) :=
    ((specGammaToOpenEquiv V.2 ω.sheaf).trans (ω.localEquiv U V hVU F)).trans
      selfFactorizationDualEquiv
  let t : Module.Dual Γ(X, U.1) Γ(Y, V.1) := finiteProjectiveTraceForm Γ(X, U.1) Γ(Y, V.1) 1
  have hf : eM (FΓ.map fSpec (eO.symm 1)) = t := by
    change selfFactorizationDualEquiv
      (ω.localEquiv U V hVU F
        (specGammaToOpenEquiv V.2 ω.sheaf (FΓ.map fSpec (eO.symm 1)))) = t
    rw [specGammaToOpenEquiv_map V.2 φ (eO.symm 1)]
    have hOne : specGammaToOpenEquiv V.2 (SheafOfModules.unit Y.ringCatSheaf) (eO.symm 1) =
        (1 : Γ(Y, V.1)) := eO.apply_symm_apply 1
    rw [hOne]
    have htr : ((φ.val.app (op V.1)).hom) (1 : Γ(Y, V.1)) =
        (ω.sheaf.presheaf.map (homOfLE (show V.1 ≤ ⊤ from le_top)).op).hom τ.sect :=
      traceMorphism_app_one ω τ V.1
    change selfFactorizationDualEquiv
      (ω.localEquiv U V hVU F (((φ.val.app (op V.1)).hom) (1 : Γ(Y, V.1)))) = t
    rw [htr]
    have hunique : ω.localEquiv U V hVU F
        (restrictₗ ω.sheaf (show V.1 ≤ ⊤ from le_top) τ.sect) =
        finiteFlatTraceElement Γ(X, U.1) Γ(Y, V.1) :=
      isTraceElement_unique F (τ.isTraceElement_localEquiv U V hVU F)
        (isTraceElement_finiteFlatTraceElement Γ(X, U.1) Γ(Y, V.1))
    rw [show (ω.sheaf.presheaf.map (homOfLE (show V.1 ≤ ⊤ from le_top)).op).hom τ.sect =
      restrictₗ ω.sheaf (show V.1 ≤ ⊤ from le_top) τ.sect from rfl, hunique]
    exact selfFactorizationDualEquiv_finiteFlatTraceElement_eq_traceForm_one
  let fΓ := FΓ.map fSpec
  let eOi := eO.toModuleIso
  let eMi := eM.toModuleIso
  have hf' : eM (fΓ.hom (eOi.symm.hom 1)) = t := by
    change eM (FΓ.map fSpec (eO.symm 1)) = t
    exact hf
  let g : ModuleCat.of R R ⟶ ModuleCat.of R (Module.Dual Γ(X, U.1) Γ(Y, V.1)) :=
    ModuleCat.ofHom (LinearMap.toSpanSingleton R _ t)
  have hfg : fΓ ≫ eMi.hom = eOi.hom ≫ g := by
    apply (cancel_epi eOi.symm.hom).mp
    apply ModuleCat.hom_ext
    rw [ModuleCat.hom_comp, ModuleCat.hom_comp]
    refine LinearMap.ext fun r ↦ ?_
    have hr : eOi.symm.hom r = r • eOi.symm.hom 1 := by
      simpa using eOi.symm.hom.hom.map_smul r (1 : Γ(Y, V.1))
    change eM (fΓ (eOi.symm.hom r)) = LinearMap.toSpanSingleton R _ t (eOi.hom (eOi.symm.hom r))
    rw [hr]
    change eM (fΓ.hom (r • eOi.symm.hom 1)) = _
    calc
      _ = r • t := by rw [fΓ.hom.map_smul, eM.map_smul, hf']
      _ = LinearMap.toSpanSingleton R _ t (eOi.hom (r • eOi.symm.hom 1)) := by
        rw [eOi.hom.hom.map_smul, show eOi.hom (eOi.symm.hom (1 : Γ(Y, V.1))) = 1 by simp]
        simp [LinearMap.toSpanSingleton_apply]
  let cIso := cokernel.mapIso fΓ g eOi eMi hfg
  let qIso := ModuleCat.cokernelIsoRangeQuotient g
  let eC : (Scheme.Modules.restrictFunctor j).obj (cokernel φ) ≅ cokernel fSpec :=
    PreservesCokernel.iso (Scheme.Modules.restrictFunctor j) φ
  let eCSection : FΓ.obj (cokernel fSpec) ≃ₗ[Γ(Y, V.1)] Γ(cokernel φ, V.1) :=
    ((FΓ.mapIso eC.symm).toLinearEquiv).trans (specGammaToOpenEquiv V.2 (cokernel φ))
  let eQ : Γ(cokernel φ, V.1) ≃ₗ[Γ(Y, V.1)]
      (Module.Dual Γ(X, U.1) Γ(Y, V.1) ⧸ LinearMap.range (LinearMap.toSpanSingleton R _ t)) :=
    eCSection.symm.trans (specCokernelIso fSpec).toLinearEquiv |>.trans cIso.toLinearEquiv
      |>.trans qIso.toLinearEquiv
  have hann : (show Ideal Γ(Y, V.1) from (different ω τ).toSubmodule.obj (op V.1)) =
      Module.annihilator Γ(Y, V.1)
        (Module.Dual Γ(X, U.1) Γ(Y, V.1) ⧸
          LinearMap.range (LinearMap.toSpanSingleton R _ t)) :=
    hD.trans eQ.annihilator_eq
  have hrange : ∀ x : Module.Dual Γ(X, U.1) Γ(Y, V.1),
      x ∈ LinearMap.range (LinearMap.toSpanSingleton R (Module.Dual Γ(X, U.1) Γ(Y, V.1)) t) ↔
        x ∈ LinearMap.range (finiteProjectiveTraceForm Γ(X, U.1) Γ(Y, V.1)) := by
    intro x
    simp only [LinearMap.mem_range]
    refine ⟨fun ⟨c, hc⟩ ↦ ⟨c, ?_⟩, fun ⟨c, hc⟩ ↦ ⟨c, ?_⟩⟩
    · rw [← smul_finiteProjectiveTraceForm_one c]
      exact hc
    · rw [LinearMap.toSpanSingleton_apply]
      change c • finiteProjectiveTraceForm Γ(X, U.1) Γ(Y, V.1) 1 = x
      rw [smul_finiteProjectiveTraceForm_one]
      exact hc
  rw [hann, Module.mem_annihilator]
  refine ⟨fun hb g ↦ ?_, fun hb q ↦ ?_⟩
  · rw [← hrange]
    have hq := hb (Submodule.Quotient.mk g)
    rwa [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero] at hq
  · obtain ⟨g, rfl⟩ := Submodule.Quotient.mk_surjective _ q
    rw [← Submodule.Quotient.mk_smul, Submodule.Quotient.mk_eq_zero]
    exact (hrange _).mpr (hb g)

end Chart

/-! ### The norm of the different lies in the discriminant -/

section Global

attribute [local implicit_reducible] SheafOfModules.unit PresheafOfModules.unit
  PresheafOfModules.presheaf TopCat.Sheaf Scheme.Modules

variable {X Y : Scheme.{u}} {f : Y ⟶ X}
  [IsLocallyNoetherian X] [IsLocallyNoetherian Y] [IsFinite f] [Flat f]

/-- Over an affine open `U` of the base, the norm of a section is the projective norm of the
algebra of sections. -/
private theorem finiteLocallyFreeNorm_app_eq_projectiveNorm {X Y : Scheme.{u}} {f : Y ⟶ X}
    [Stacks.Morphisms.IsFiniteLocallyFree f] (U : X.affineOpens) (s : Γ(Y, f ⁻¹ᵁ U.1)) :
    letI : Algebra Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) := (f.app U.1).hom.toAlgebra
    ∀ [Module.Finite Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1)] [Module.Projective Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1)],
      (Stacks.Norm.finiteLocallyFreeNorm f).app U.1 s =
        Algebra.projectiveNorm (R := Γ(X, U.1)) (A := Γ(Y, f ⁻¹ᵁ U.1)) s := by
  intro _ _
  rw [Stacks.Norm.finiteLocallyFreeNorm_app_affine f U s, Stacks.Norm.normApp_affine f U s]
  rfl

/-- **[Stacks, Tag 0BW8].** Let `f : Y → X` be a finite flat morphism of locally Noetherian
schemes, with source `Y` and base `X`, and let `𝔇_f ⊆ 𝒪_Y` be the different attached to a
relative dualizing module `ω_{Y/X}` and a trace element `τ_{Y/X}`.  Then the norm
`Norm_f : f_*𝒪_Y → 𝒪_X` carries `f_*𝔇_f` into the ideal sheaf of the discriminant `D_f`: over
every affine open `U` of the base the norm of a section of `𝔇_f` on `f ⁻¹ᵁ U` lies in the
discriminant ideal of `U`. -/
@[stacks 0BW8]
theorem finiteLocallyFreeNorm_app_mem_discriminantIdeal (ω : RelativeDualizingModuleData f)
    (τ : RelativeTraceSection ω) (U : X.affineOpens) (s : Γ(Y, f ⁻¹ᵁ U.1))
    (hs : s ∈ (show Ideal Γ(Y, f ⁻¹ᵁ U.1) from
      (different ω τ).toSubmodule.obj (op (f ⁻¹ᵁ U.1)))) :
    letI : Stacks.Morphisms.IsFiniteLocallyFree f :=
      (Stacks.Morphisms.isFiniteLocallyFree_iff_isFinite_flat_of_isLocallyNoetherian f).mpr
        ⟨inferInstance, inferInstance⟩
    (Stacks.Norm.finiteLocallyFreeNorm f).app U.1 s ∈ (discriminantIdeal f).ideal U := by
  let : Stacks.Morphisms.IsFiniteLocallyFree f :=
    (Stacks.Morphisms.isFiniteLocallyFree_iff_isFinite_flat_of_isLocallyNoetherian f).mpr
      ⟨inferInstance, inferInstance⟩
  have halg : (f.appLE U.1 (f ⁻¹ᵁ U.1) le_rfl).hom.toAlgebra = (f.app U.1).hom.toAlgebra := by
    rw [f.appLE_eq_app]
  let : Algebra Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) := (f.app U.1).hom.toAlgebra
  have hfp := Stacks.Norm.module_finite_and_projective_sections f U
  let : Module.Finite Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) := hfp.1
  let : Module.Projective Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) := hfp.2
  rw [finiteLocallyFreeNorm_app_eq_projectiveNorm U s, discriminantIdeal_ideal f U]
  refine mem_algebraDiscriminantIdeal_of_algebra_eq halg (fun hfin hproj ↦ ?_) hfp.1 hfp.2
  let : Algebra Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) :=
    (f.appLE U.1 (f ⁻¹ᵁ U.1) le_rfl).hom.toAlgebra
  let : Module.Finite Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) := hfin
  let : Module.Projective Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) := hproj
  exact finiteProjective_mem_algebraDiscriminantIdeal_of_smul_dual_mem_range
    ((mem_different_obj_affine_iff ω τ U (Stacks.Norm.preimageAffineOpen f U) le_rfl s).mp hs)

/-! ### The norm of the local generator of the different -/

omit [IsLocallyNoetherian X] [IsLocallyNoetherian Y] [IsFinite f] [Flat f] in
/-- The two spellings of the coordinate-ring map of a finite morphism over an affine open of the
base, `f.appLE` taken on the whole preimage and `f.app`, give the same algebra structure. -/
theorem appLE_preimage_toAlgebra_eq (U : X.affineOpens) :
    (f.appLE U.1 (f ⁻¹ᵁ U.1) le_rfl).hom.toAlgebra = (f.app U.1).hom.toAlgebra := by
  rw [f.appLE_eq_app]

/-- **The local generator of the different on a chart with free dual.** Let
`f : Y ⟶ X` be a finite flat morphism of locally Noetherian schemes and `U = Spec A` an affine
open of the base with `f ⁻¹ U = Spec B`.  If the relative dualizing module `Hom_A(B, A)` of the
chart is free of rank one over `B` on a generator `λ`, and the trace functional is
`Tr_{B/A} = b · λ`, then the closed subscheme `R` cut out by the different is cut out by `b` on
that chart.

A functional is `d · λ` for a unique `d`, and the image of the trace pairing consists of the
functionals `(c b) · λ`, so an element multiplies every functional into that image exactly when
it is a multiple of `b`. -/
theorem different_obj_affine_eq_span_of_dualGenerator (ω : RelativeDualizingModuleData f)
    (τ : RelativeTraceSection ω) (U : X.affineOpens) (b : Γ(Y, f ⁻¹ᵁ U.1)) :
    letI : Algebra Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) :=
      (f.appLE U.1 (f ⁻¹ᵁ U.1) le_rfl).hom.toAlgebra
    ∀ [Module.Finite Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1)]
      [Module.Projective Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1)]
      (lam : Module.Dual Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1)),
      Function.Bijective (fun c : Γ(Y, f ⁻¹ᵁ U.1) => c • lam) →
      finiteProjectiveTraceForm Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) 1 = b • lam →
        (show Ideal Γ(Y, f ⁻¹ᵁ U.1) from
          (different ω τ).toSubmodule.obj (op (f ⁻¹ᵁ U.1))) = Ideal.span {b} := by
  let : Algebra Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) :=
    (f.appLE U.1 (f ⁻¹ᵁ U.1) le_rfl).hom.toAlgebra
  intro _ _ lam hlam hb
  let V : Y.affineOpens := ⟨f ⁻¹ᵁ U.1, IsAffineHom.isAffine_preimage U.1 U.2⟩
  have hrange : ∀ c : Γ(Y, f ⁻¹ᵁ U.1),
      finiteProjectiveTraceForm Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) c = (c * b) • lam := fun c ↦ by
    rw [← smul_finiteProjectiveTraceForm_one c, hb, smul_smul]
  ext b'
  rw [mem_different_obj_affine_iff ω τ U V le_rfl b']
  refine ⟨fun h ↦ ?_, fun h g ↦ ?_⟩
  · obtain ⟨c, hc⟩ := h lam
    rw [hrange c] at hc
    exact Ideal.mem_span_singleton'.mpr ⟨c, hlam.injective hc⟩
  · obtain ⟨c, hc⟩ := Ideal.mem_span_singleton.mp h
    obtain ⟨d, hd⟩ := hlam.surjective g
    refine ⟨c * d, ?_⟩
    rw [hrange (c * d), hc, ← hd, smul_smul]
    exact congrArg (fun z : Γ(Y, f ⁻¹ᵁ U.1) => z • lam) (by ring)

omit [IsLocallyNoetherian Y] in
/-- **The norm of the local generator of the different on a free chart.** Let `f : Y ⟶ X` be a
finite flat morphism of locally Noetherian schemes and `U = Spec A` an affine open of the base
with `f ⁻¹ U = Spec B` free over `A`.  If the relative dualizing module `Hom_A(B, A)` of the chart
is free of rank one over `B` on a generator `λ` and `Tr_{B/A} = b · λ`, then the discriminant
`D_f` is cut out over `U` by the norm of `b`; by
`Stacks.Discriminant.different_obj_affine_eq_span_of_dualGenerator` the element `b` cuts out `R`,
so this says that the norm of `R` is the discriminant of `f` over such a chart. -/
theorem discriminantIdeal_ideal_eq_span_norm_of_dualGenerator (U : X.affineOpens) {n : ℕ}
    (b : Γ(Y, f ⁻¹ᵁ U.1)) :
    letI : Stacks.Morphisms.IsFiniteLocallyFree f :=
      (Stacks.Morphisms.isFiniteLocallyFree_iff_isFinite_flat_of_isLocallyNoetherian f).mpr
        ⟨inferInstance, inferInstance⟩
    letI : Algebra Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) := (f.app U.1).hom.toAlgebra
    letI : Module.Finite Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) :=
      (Stacks.Norm.module_finite_and_projective_sections f U).1
    letI : Module.Projective Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) :=
      (Stacks.Norm.module_finite_and_projective_sections f U).2
    ∀ (_bas : Module.Basis (Fin n) Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1))
      (lam : Module.Dual Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1)),
      Function.Bijective (fun c : Γ(Y, f ⁻¹ᵁ U.1) => c • lam) →
      finiteProjectiveTraceForm Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) 1 = b • lam →
        (discriminantIdeal f).ideal U =
          Ideal.span {(Stacks.Norm.finiteLocallyFreeNorm f).app U.1 b} := by
  let : Stacks.Morphisms.IsFiniteLocallyFree f :=
    (Stacks.Morphisms.isFiniteLocallyFree_iff_isFinite_flat_of_isLocallyNoetherian f).mpr
      ⟨inferInstance, inferInstance⟩
  let : Algebra Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) := (f.app U.1).hom.toAlgebra
  have hfp := Stacks.Norm.module_finite_and_projective_sections f U
  let : Module.Finite Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) := hfp.1
  let : Module.Projective Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) := hfp.2
  intro bas lam hlam hb
  let : Module.Free Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) := Module.Free.of_basis bas
  rw [(finiteLocallyFreeNorm_app_eq_projectiveNorm U b).trans
    (Algebra.projectiveNorm_eq_norm_of_free _ b), discriminantIdeal_ideal f U]
  exact algebraDiscriminantIdeal_eq_span_norm_of_dualGenerator bas lam hlam hb

/-! ### The norm of `R` is the discriminant on a chart -/

omit [IsLocallyNoetherian Y] in
/-- The computation of the discriminant over a free chart, read through any algebra structure on
the sections that is equal to the one given by `f.app`. -/
private theorem discriminantIdeal_ideal_eq_span_norm_of_dualGenerator'
    (U : X.affineOpens) {n : ℕ} [i : Algebra Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1)]
    (hi : i = (f.app U.1).hom.toAlgebra)
    [Module.Finite Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1)]
    [Module.Projective Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1)] (b : Γ(Y, f ⁻¹ᵁ U.1))
    (bas : Module.Basis (Fin n) Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1))
    (lam : Module.Dual Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1))
    (hlam : Function.Bijective (fun c : Γ(Y, f ⁻¹ᵁ U.1) => c • lam))
    (hb : finiteProjectiveTraceForm Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) 1 = b • lam) :
    letI : Stacks.Morphisms.IsFiniteLocallyFree f :=
      (Stacks.Morphisms.isFiniteLocallyFree_iff_isFinite_flat_of_isLocallyNoetherian f).mpr
        ⟨inferInstance, inferInstance⟩
    (discriminantIdeal f).ideal U =
      Ideal.span {(Stacks.Norm.finiteLocallyFreeNorm f).app U.1 b} := by
  subst hi
  exact discriminantIdeal_ideal_eq_span_norm_of_dualGenerator U b bas lam hlam hb

/-- **The norm of `R` is the discriminant on a chart.** Let `f : Y ⟶ X` be a finite flat
morphism of locally Noetherian schemes and `U = Spec A` an affine open of the base with
`f ⁻¹ U = Spec B` free over `A`.  If the relative dualizing module `Hom_A(B, A)` of the chart is
free of rank one over `B` on a generator `λ`, then the closed subscheme `R` cut out by the
different is cut out on that chart by one element `b`, and the discriminant `D_f` is cut out
over `U` by the norm of `b`; that is, the norm of `R` is the discriminant of `f` over `U`.

The element is read off from `Tr_{B/A} = b · λ`, which is solvable for `b` because `λ` generates
`Hom_A(B, A)` freely; the two halves are then
`Stacks.Discriminant.different_obj_affine_eq_span_of_dualGenerator` and
`Stacks.Discriminant.discriminantIdeal_ideal_eq_span_norm_of_dualGenerator`. -/
theorem exists_different_obj_affine_eq_span_and_discriminantIdeal_eq_span_norm
    (ω : RelativeDualizingModuleData f) (τ : RelativeTraceSection ω) (U : X.affineOpens)
    {n : ℕ} :
    letI : Stacks.Morphisms.IsFiniteLocallyFree f :=
      (Stacks.Morphisms.isFiniteLocallyFree_iff_isFinite_flat_of_isLocallyNoetherian f).mpr
        ⟨inferInstance, inferInstance⟩
    letI : Algebra Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) :=
      (f.appLE U.1 (f ⁻¹ᵁ U.1) le_rfl).hom.toAlgebra
    ∀ [Module.Finite Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1)]
      [Module.Projective Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1)]
      (_bas : Module.Basis (Fin n) Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1))
      (lam : Module.Dual Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1)),
      Function.Bijective (fun c : Γ(Y, f ⁻¹ᵁ U.1) => c • lam) →
      ∃ b : Γ(Y, f ⁻¹ᵁ U.1),
        (show Ideal Γ(Y, f ⁻¹ᵁ U.1) from
          (different ω τ).toSubmodule.obj (op (f ⁻¹ᵁ U.1))) = Ideal.span {b} ∧
        (discriminantIdeal f).ideal U =
          Ideal.span {(Stacks.Norm.finiteLocallyFreeNorm f).app U.1 b} := by
  let : Stacks.Morphisms.IsFiniteLocallyFree f :=
    (Stacks.Morphisms.isFiniteLocallyFree_iff_isFinite_flat_of_isLocallyNoetherian f).mpr
      ⟨inferInstance, inferInstance⟩
  let : Algebra Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) :=
    (f.appLE U.1 (f ⁻¹ᵁ U.1) le_rfl).hom.toAlgebra
  intro _ _ bas lam hlam
  obtain ⟨b, hbl⟩ := hlam.surjective (finiteProjectiveTraceForm Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) 1)
  exact ⟨b, different_obj_affine_eq_span_of_dualGenerator ω τ U b lam hlam hbl.symm,
    discriminantIdeal_ideal_eq_span_norm_of_dualGenerator' U (appLE_preimage_toAlgebra_eq U) b
      bas lam hlam hbl.symm⟩

end Global

/-! ### Tag 0BWA, part (2): the norm of `R` is the discriminant -/

section NormOfDifferent

attribute [local implicit_reducible] SheafOfModules.unit PresheafOfModules.unit
  PresheafOfModules.presheaf TopCat.Sheaf Scheme.Modules

variable {X Y : Scheme.{u}} {f : Y ⟶ X}
  [IsLocallyNoetherian X] [IsLocallyNoetherian Y] [IsFinite f] [Flat f]

/-- **[Stacks, Tag 0BWA (2)].**  Let `f : Y ⟶ X` be a finite flat morphism of locally Noetherian
schemes with relative dualizing module `ω_{Y/X}` and trace element `τ_{Y/X}`, and let `R ⊆ Y`
be the closed subscheme cut out by the different `𝔇_f`.  If `ω_{Y/X}` is invertible, then the
norm of `R` is the discriminant `D_f`: as ideal sheaves on `X`, `Norm_f(𝔇_f)` is the
discriminant ideal sheaf.

Every point of `X` has an affine open neighbourhood `U = Spec A` with `f⁻¹U = Spec B` free over
`A` and `ω_{Y/X}` trivial on `f⁻¹U` (Tag 0BUT), so that `Hom_A(B, A)` is free of rank one on some
`λ`; there `R` is cut out by the `b` with `Tr_{B/A} = b λ` and `D_f` by `Norm_{B/A}(b)`, and
both sides are ideal sheaves, so they agree. -/
@[stacks 0BWA "part (2)"]
theorem discriminantIdeal_eq_normIdealSheaf_differentIdealSheaf
    (ω : RelativeDualizingModuleData f) (τ : RelativeTraceSection ω)
    [Stacks.SheafOfModules.IsInvertible Y.presheaf
      (structureSheafRing Y.toRingedSpace).property ω.sheaf] :
    letI : Stacks.Morphisms.IsFiniteLocallyFree f :=
      (Stacks.Morphisms.isFiniteLocallyFree_iff_isFinite_flat_of_isLocallyNoetherian f).mpr
        ⟨inferInstance, inferInstance⟩
    discriminantIdeal f = Stacks.Norm.normIdealSheaf f (differentIdealSheaf ω τ) := by
  let : Stacks.Morphisms.IsFiniteLocallyFree f :=
    (Stacks.Morphisms.isFiniteLocallyFree_iff_isFinite_flat_of_isLocallyNoetherian f).mpr
      ⟨inferInstance, inferInstance⟩
  refine Stacks.Norm.eq_normIdealSheaf_of_forall_exists f _ _ fun x ↦ ?_
  obtain ⟨W, hxW, hW⟩ := Stacks.Divisors.hasTrivializingTargetCover_of_isFinite f ω.sheaf x
  obtain ⟨U, hxU, hUW, hfree⟩ := Stacks.Norm.exists_affineOpens_mem_le_free f x W hxW
  have hle : f ⁻¹ᵁ U.1 ≤ f ⁻¹ᵁ W := f.preimage_mono hUW
  let s := Stacks.Divisors.normChartSourceGenerator f ω.sheaf ⟨W, hW⟩
  let m : Γ(ω.sheaf, f ⁻¹ᵁ U.1) := ω.sheaf.val.restrictₛₗ (homOfLE hle).op s.1
  have hfp := Stacks.Norm.module_finite_and_projective_sections f U
  have key : ∀ i : Algebra Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1), i = (f.app U.1).hom.toAlgebra →
      @Module.Finite Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) _ _ i.toModule ∧
        @Module.Projective Γ(X, U.1) _ Γ(Y, f ⁻¹ᵁ U.1) _ i.toModule ∧
        @Module.Free Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) _ _ i.toModule := by
    rintro i rfl
    exact ⟨hfp.1, hfp.2, hfree⟩
  let : Algebra Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) := (f.appLE U.1 (f ⁻¹ᵁ U.1) le_rfl).hom.toAlgebra
  obtain ⟨h₁, h₂, h₃⟩ := key _ (appLE_preimage_toAlgebra_eq U)
  let bas := (Module.Free.chooseBasis Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1)).reindex (Fintype.equivFin _)
  let V : Y.affineOpens := Stacks.Norm.preimageAffineOpen f U
  let eω : Γ(ω.sheaf, f ⁻¹ᵁ U.1) ≃ₗ[Γ(Y, f ⁻¹ᵁ U.1)]
      Module.Dual Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) :=
    (ω.localEquiv U V le_rfl (selfFactorization Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1))).trans
      selfFactorizationDualEquiv
  have hlam : Function.Bijective (fun c : Γ(Y, f ⁻¹ᵁ U.1) => c • eω m) := by
    rw [show (fun c : Γ(Y, f ⁻¹ᵁ U.1) => c • eω m) = eω ∘ (fun c => c • m) from
      funext fun c ↦ (eω.map_smul c m).symm]
    exact eω.bijective.comp (s.2 (f ⁻¹ᵁ U.1) hle)
  obtain ⟨b, hb₁, hb₂⟩ :=
    exists_different_obj_affine_eq_span_and_discriminantIdeal_eq_span_norm ω τ U bas (eω m) hlam
  exact ⟨U, b, hxU, (differentIdealSheaf_ideal ω τ V).trans hb₁, hb₂⟩

end NormOfDifferent

end Stacks.Discriminant

