@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace
open scoped AlgebraicGeometry Matrix

universe u

namespace Stacks.Discriminant

/-- The scalar tower `Γ(S, W) → Γ(X, U) → Γ(Y, V)` attached to a morphism `f : Y ⟶ X` over
`pX : X ⟶ S` and affine opens `V ⊆ f⁻¹U`, `U ⊆ pX⁻¹W`. -/
theorem isScalarTower_appLE {S X Y : Scheme.{u}} (pX : X ⟶ S) (f : Y ⟶ X) {W : S.Opens}
    {U : X.Opens} {V : Y.Opens} (hUW : U ≤ pX ⁻¹ᵁ W) (hVU : V ≤ f ⁻¹ᵁ U)
    (hVW : V ≤ (f ≫ pX) ⁻¹ᵁ W) :
    letI := Stacks.Smooth.algebraAppLE pX hUW
    letI := Stacks.Smooth.algebraAppLE f hVU
    letI := Stacks.Smooth.algebraAppLE (f ≫ pX) hVW
    IsScalarTower Γ(S, W) Γ(X, U) Γ(Y, V) := by
  let := Stacks.Smooth.algebraAppLE pX hUW
  let := Stacks.Smooth.algebraAppLE f hVU
  let := Stacks.Smooth.algebraAppLE (f ≫ pX) hVW
  refine IsScalarTower.of_algebraMap_eq fun r => ?_
  have h := Scheme.Hom.appLE_comp_appLE f pX W U V hUW hVU
  change ((f ≫ pX).appLE W V hVW).hom r = (f.appLE U V hVU).hom ((pX.appLE W U hUW).hom r)
  rw [← h]
  rfl

/-- **[Stacks, Tag 0BWJ] on a chart.**  Let `f : Y ⟶ X` be a morphism over `pX : X ⟶ S` which is
locally of finite type, and let `W = Spec R ⊆ S`, `U = Spec A ⊆ X`, `V = Spec B ⊆ Y` be affine
opens with `V ⊆ f⁻¹U` and `U ⊆ pX⁻¹W`.  If `Ω[A⁄R]` and `Ω[B⁄R]` are free of rank `n` — which is
what smoothness of relative dimension `n` of `X` and `Y` over `S` gives — then the ideal of the
Kähler different of `f` over `V` is generated by `∧ⁿ(df)`, the determinant of the matrix of
`B ⊗_A Ω[A⁄R] → Ω[B⁄R]` in the two bases. -/
theorem kaehlerDifferent_ideal_eq_span_det {S X Y : Scheme.{u}} (pX : X ⟶ S) (f : Y ⟶ X)
    [IsLocallyNoetherian X] [IsLocallyNoetherian Y]
    [LocallyOfFiniteType f] {n : ℕ} {W : S.Opens} (U : X.affineOpens)
    (V : Y.affineOpens) (hUW : U.1 ≤ pX ⁻¹ᵁ W) (hVU : V.1 ≤ f ⁻¹ᵁ U.1)
    (hVW : V.1 ≤ (f ≫ pX) ⁻¹ᵁ W) :
    letI := Stacks.Smooth.algebraAppLE pX hUW
    letI := Stacks.Smooth.algebraAppLE f hVU
    letI := Stacks.Smooth.algebraAppLE (f ≫ pX) hVW
    letI := isScalarTower_appLE pX f hUW hVU hVW
    ∀ (bA : Module.Basis (Fin n) Γ(X, U.1) Ω[Γ(X, U.1)⁄Γ(S, W)])
      (bB : Module.Basis (Fin n) Γ(Y, V.1) Ω[Γ(Y, V.1)⁄Γ(S, W)]),
      (kaehlerDifferent f).ideal V =
        Ideal.span {(LinearMap.toMatrix (bA.baseChange Γ(Y, V.1)) bB
          (KaehlerDifferential.mapBaseChange Γ(S, W) Γ(X, U.1) Γ(Y, V.1))).det} := by
  let := Stacks.Smooth.algebraAppLE pX hUW
  let := Stacks.Smooth.algebraAppLE f hVU
  let := Stacks.Smooth.algebraAppLE (f ≫ pX) hVW
  let := isScalarTower_appLE pX f hUW hVU hVW
  intro bA bB
  rw [kaehlerDifferent_ideal_eq_fittingIdeal U V hVU]
  exact fittingIdeal_kaehlerDifferential_eq_span_det_of_bases bA bB

/-! ### Charts on which the relative differentials are free -/

/-- **A chart on which the relative differentials of a smooth morphism of relative dimension `n`
are free of rank `n`.**  Every point of the source has an affine open neighbourhood inside any
prescribed open lying over an affine open `W` of the base, on which `Ω[Γ(X, U)⁄Γ(S, W)]` is free
of rank `n`.

A standard smooth presentation of relative dimension `n` around the point gives a basis of
`Ω` of cardinality `n` on some chart over some affine open of the base ([Stacks, Tag 00T7]);
the differentials are quasi-coherent, so their sections localize to a basic open of that chart
inside the prescribed open, and the basis localizes with them.  The affine open of the base can
then be taken to be the prescribed one, because the sections of `Ω_{X/S}` over an affine open
`U` are `Ω[Γ(X, U)⁄Γ(S, W)]` for every affine open `W` with `U ⊆ p⁻¹W`. -/
@[ega "IV 16.5.8" "special case", sga "3 XI 1.9" "partial"]
theorem exists_isAffineOpen_basis_kaehlerDifferential {X S : Scheme.{u}} (p : X ⟶ S) {n : ℕ}
    [SmoothOfRelativeDimension n p] (x : X) {W : S.Opens} (hW : IsAffineOpen W)
    {T : X.Opens} (hxT : x ∈ T) (hTW : T ≤ p ⁻¹ᵁ W) :
    ∃ (U : X.Opens), IsAffineOpen U ∧ x ∈ U ∧ ∃ (hUT : U ≤ T),
      letI := Stacks.Smooth.algebraAppLE p (hUT.trans hTW)
      Nonempty (Module.Basis (Fin n) Γ(X, U) Ω[Γ(X, U)⁄Γ(S, W)]) := by
  classical
  obtain ⟨W₀, hW₀, U₀, hU₀, hxU₀, e₀, hstd⟩ :=
    SmoothOfRelativeDimension.exists_isStandardSmoothOfRelativeDimension (n := n) (f := p) x
  let := Stacks.Smooth.algebraAppLE p e₀
  have hstd' : Algebra.IsStandardSmoothOfRelativeDimension n Γ(S, W₀) Γ(X, U₀) := hstd
  obtain ⟨ι, σ, hσ, hι, P, hP⟩ := hstd'.out
  have : Finite ι := hι
  have : Finite σ := hσ
  have hcard : Nat.card ((Set.range P.map)ᶜ : Set ι) = n :=
    (Stacks.RelativeDifferentialStalkMap.natCard_compl_range_map P).trans hP
  set F := Scheme.Hom.relativeDifferentials p with hF
  -- the sections of `Ω_{X/S}` on the standard smooth chart are free of rank `n`
  let b₀ : Module.Basis (Fin n) Γ(X, U₀) Γ(F, U₀) :=
    (P.basisKaehler.reindex (Finite.equivFinOfCardEq hcard)).map
      (sectionsRelativeDifferentialsEquiv p hU₀ hW₀ e₀).symm
  -- shrink the chart to a basic open inside `T`
  obtain ⟨g, hgT, hxg⟩ := hU₀.exists_basicOpen_le (V := T) ⟨x, hxT⟩ hxU₀
  refine ⟨X.basicOpen g, hU₀.basicOpen g, hxg, hgT, ?_⟩
  have : IsLocalization (Submonoid.powers g) Γ(X, X.basicOpen g) :=
    hU₀.isLocalization_basicOpen g
  let : Module Γ(X, U₀) Γ(F, X.basicOpen g) :=
    Module.compHom _ (algebraMap Γ(X, U₀) Γ(X, X.basicOpen g))
  have : IsScalarTower Γ(X, U₀) Γ(X, X.basicOpen g) Γ(F, X.basicOpen g) :=
    IsScalarTower.of_algebraMap_smul fun _ _ => rfl
  let ρ : Γ(F, U₀) →ₗ[Γ(X, U₀)] Γ(F, X.basicOpen g) :=
    { toFun a := F.presheaf.map (homOfLE (X.basicOpen_le g)).op a
      map_add' a b := by exact map_add _ a b
      map_smul' r a := by exact Scheme.Modules.map_smul F (homOfLE (X.basicOpen_le g)) r a }
  have : IsLocalizedModule (Submonoid.powers g) ρ :=
    isLocalizedModule_restrict_basicOpen F hU₀ g ρ fun _ => rfl
  exact ⟨(b₀.ofIsLocalizedModule Γ(X, X.basicOpen g) (Submonoid.powers g) ρ).map
    (sectionsRelativeDifferentialsEquiv p (hU₀.basicOpen g) hW (hgT.trans hTW))⟩

/-! ### The relative differentials of a morphism smooth of relative dimension `n` -/

/-- **The sheaf of relative differentials of a morphism smooth of relative dimension `n` is
finite locally free of rank `n`.**  Finite local freeness of rank `n` is affine-local on
sections for a quasi-coherent module, and the charts of
`Stacks.Discriminant.exists_isAffineOpen_basis_kaehlerDifferential` give a basis of `n` sections
around every point. -/
@[ega "IV 16.5.8" "special case",
  sga "1 II 4.3" "(ii), special case",
  sga "1 III 5.2" "special case",
  sga "3 XI 1.9" "partial",
  sga "6 VIII 2.4" "partial"]
theorem isFiniteLocallyFreeOfRank_relativeDifferentials {S X : Scheme.{u}} (p : X ⟶ S) (n : ℕ)
    [SmoothOfRelativeDimension n p] :
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (Scheme.Hom.relativeDifferentials p) n := by
  have : (Scheme.Hom.relativeDifferentials p).IsQuasicoherent :=
    Scheme.Hom.isQuasicoherent_relativeDifferentials p
  refine (Scheme.Modules.isFiniteLocallyFreeOfRank_iff _ n).mp
    (Stacks.Modules.isFiniteLocallyFreeOfRank_of_module_affineOpens _ n fun x => ?_)
  obtain ⟨W, hxW, -⟩ := exists_affine_subset (p.base x) ⊤ trivial
  obtain ⟨U, hU, hxU, hUW, hb⟩ :=
    exists_isAffineOpen_basis_kaehlerDifferential (n := n) p x W.2 (T := p ⁻¹ᵁ W.1) hxW le_rfl
  refine ⟨⟨U, hU⟩, hxU, ?_⟩
  let := Stacks.Smooth.algebraAppLE p (hUW.trans (le_refl (p ⁻¹ᵁ W.1)))
  exact Module.IsFiniteLocallyFreeOfRank.of_basis'
    (hb.some.map (sectionsRelativeDifferentialsEquiv p hU W.2 hUW).symm)

/-- **The sheaf `Ω^n_{X/S}` of relative differential `n`-forms of a morphism smooth of relative
dimension `n` is invertible.**  It is the top exterior power of a module of rank `n`, i.e. the
determinant line bundle. -/
theorem isInvertible_relativeDifferentialForms {S X : Scheme.{u}} (p : X ⟶ S) (n : ℕ)
    [SmoothOfRelativeDimension n p] :
    AlgebraicGeometry.SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property
      (Scheme.Hom.relativeDifferentialForms p (n : ℤ)) :=
  have := isFiniteLocallyFreeOfRank_relativeDifferentials p n
  Scheme.Modules.isInvertible_exteriorPower_self (Scheme.Hom.relativeDifferentials p) n

/-- **The pullback `f^*Ω^n_{X/S}` of the sheaf of relative differential `n`-forms along a
morphism `f : Y ⟶ X` is invertible**, by [Stacks, Tag 0B8L]: the pullback of an invertible module
is invertible. -/
theorem isInvertible_pullback_relativeDifferentialForms {S X Y : Scheme.{u}} (p : X ⟶ S)
    (f : Y ⟶ X) (n : ℕ) [SmoothOfRelativeDimension n p] :
    AlgebraicGeometry.SheafOfModules.IsInvertible Y.sheaf.obj Y.ringCatSheaf.property
      ((Scheme.Modules.pullback f).obj (Scheme.Hom.relativeDifferentialForms p (n : ℤ))) :=
  Stacks.RingedSpace.modulePullback_isInvertible_algebraicGeometry f.toLRSHom.toShHom _
    (isInvertible_relativeDifferentialForms p n)

/-! ### The non-étale locus and effective Cartier divisors -/

/-- A morphism étale at a point is unramified there: an étale algebra is formally étale and of
finite presentation, hence unramified. -/
theorem unramifiedAt_of_etaleAt {X S : Scheme.{u}} (f : X ⟶ S) (x : X) (h : EtaleAt f x) :
    UnramifiedAt f x := by
  obtain ⟨U, hU, hxU, V, hV, e, hEt⟩ := h
  refine ⟨U, hU, hxU, V, hV, e, ?_⟩
  let _ : Algebra Γ(S, V) Γ(X, U) := (f.appLE V U e).hom.toAlgebra
  let _ : Algebra.Etale Γ(S, V) Γ(X, U) := RingHom.etale_algebraMap.mpr hEt
  let _ : Algebra.FormallyEtale Γ(S, V) Γ(X, U) := ‹Algebra.Etale _ _›.formallyEtale
  let _ : Algebra.FinitePresentation Γ(S, V) Γ(X, U) := ‹Algebra.Etale _ _›.finitePresentation
  exact ⟨inferInstance, inferInstance⟩

/-- A point at which a morphism locally of finite type is étale lies outside the closed subscheme
cut out by its Kähler different: that subscheme has the support of `Ω_{Y/X}` as its underlying
closed set, and `Ω_{Y/X}` vanishes near a point of unramifiedness. -/
theorem notMem_support_kaehlerDifferent_of_etaleAt {X Y : Scheme.{u}} (f : Y ⟶ X)
    [LocallyOfFiniteType f] {y : Y} (h : EtaleAt f y) :
    y ∉ (kaehlerDifferent f).support := by
  intro hy
  refine (AlgebraicGeometry.unramifiedAt_iff_notMem_supp_relativeDifferentials f y).mp
    (unramifiedAt_of_etaleAt f y h) ?_
  rw [← AlgebraicGeometry.fittingIdeal_zero_support_eq_supp
    (Scheme.Hom.relativeDifferentials f)]
  exact hy

/-- A local generator of the Kähler different on an affine open is a nonzerodivisor as soon as
`f` is étale at the associated points of `Y`.

In a Noetherian ring the zerodivisors are the union of the associated primes, the associated
primes of `Γ(Y, V)` are the associated points of `Y` lying in `V`, and a point at which `f` is
étale lies outside the support of the Kähler different, hence outside the zero locus of the
generator. -/
theorem mem_nonZeroDivisors_of_kaehlerDifferent_ideal_eq_span {X Y : Scheme.{u}} (f : Y ⟶ X)
    [IsLocallyNoetherian Y] [LocallyOfFiniteType f]
    (hét : ∀ y ∈ Stacks.Divisors.schemeAssociatedPoints Y, EtaleAt f y)
    (V : Y.affineOpens) (h : Γ(Y, V.1))
    (hh : (kaehlerDifferent f).ideal V = Ideal.span {h}) :
    h ∈ nonZeroDivisors Γ(Y, V.1) := by
  have : IsNoetherianRing Γ(Y, V.1) := IsLocallyNoetherian.component_noetherian V
  have : (unitModule Y).IsQuasicoherent := isQuasicoherent_unitModule Y
  by_contra hc
  have hmem : h ∈ (↑(nonZeroDivisors Γ(Y, V.1)) : Set Γ(Y, V.1))ᶜ := hc
  rw [← biUnion_associatedPrimes_eq_compl_nonZeroDivisors Γ(Y, V.1)] at hmem
  simp only [Set.mem_iUnion, SetLike.mem_coe, exists_prop] at hmem
  obtain ⟨p, hp, hhp⟩ := hmem
  have hp' : p ∈ associatedPrimes Γ(Y, V.1) Γ(unitModule Y, V.1) := hp
  rw [Stacks.AlgebraicGeometry.AssociatedPointPrime.associatedPrimes_eq_image_associatedPoints
    (unitModule Y) V.2] at hp'
  obtain ⟨y, hy, rfl⟩ := hp'
  have hsupp : (y : Y) ∉ (kaehlerDifferent f).support :=
    notMem_support_kaehlerDifferent_of_etaleAt f (hét _ hy)
  rw [mem_support_iff_primeIdealOf (kaehlerDifferent f) V (y : Y) y.2, hh] at hsupp
  refine hsupp ((PrimeSpectrum.mem_zeroLocus _ _).mpr ?_)
  exact SetLike.coe_subset_coe.mpr (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hhp))

/-- **[Stacks, Tag 0BWJ], the Cartier property.**  If the closed subscheme `R ⊆ Y` cut out by the
Kähler different of `f` is locally principal and `f` is étale at the associated points of `Y`,
then `R` is an effective Cartier divisor: every local generator is a nonzerodivisor. -/
theorem isEffectiveCartierDivisor_kaehlerDifferent {X Y : Scheme.{u}} (f : Y ⟶ X)
    [IsLocallyNoetherian Y] [LocallyOfFiniteType f]
    (hprin : Stacks.Divisors.IsLocallyPrincipal (kaehlerDifferent f))
    (hét : ∀ y ∈ Stacks.Divisors.schemeAssociatedPoints Y, EtaleAt f y) :
    Stacks.Divisors.IsEffectiveCartierDivisor (kaehlerDifferent f) := by
  refine Stacks.Divisors.isEffectiveCartierDivisor_of_forall_mem_support _ fun x _ => ?_
  obtain ⟨V, hxV, hV⟩ := hprin x
  obtain ⟨h, hh⟩ := hV.principal
  exact ⟨V, h, hxV, hh, mem_nonZeroDivisors_of_kaehlerDifferent_ideal_eq_span f hét V h hh⟩

/-! ### Tag 0BWJ -/

/-- A morphism over `S` whose source is smooth over `S` is locally of finite type:
[Stacks, Tag 01T8] applied to the composite, which is smooth. -/
theorem locallyOfFiniteType_of_smoothOfRelativeDimension {S X Y : Scheme.{u}} (pX : X ⟶ S)
    (f : Y ⟶ X) (n : ℕ) [SmoothOfRelativeDimension n (f ≫ pX)] : LocallyOfFiniteType f :=
  let : Smooth (f ≫ pX) := SmoothOfRelativeDimension.smooth n (f ≫ pX)
  locallyOfFiniteType_of_comp f pX

/-- The source of a morphism smooth of relative dimension `n` over a locally Noetherian base is
locally Noetherian: a smooth morphism is locally of finite type. -/
theorem isLocallyNoetherian_of_smoothOfRelativeDimension {S X : Scheme.{u}} (p : X ⟶ S)
    (n : ℕ) [IsLocallyNoetherian S] [SmoothOfRelativeDimension n p] : IsLocallyNoetherian X :=
  let : Smooth p := SmoothOfRelativeDimension.smooth n p
  LocallyOfFiniteType.isLocallyNoetherian p

section Main

variable {S X Y : Scheme.{u}} (pX : X ⟶ S) (f : Y ⟶ X) (n : ℕ) [IsLocallyNoetherian S]
  [SmoothOfRelativeDimension n pX] [SmoothOfRelativeDimension n (f ≫ pX)]

/-- **[Stacks, Tag 0BWJ], the local equation of `R`.**  Let `X` and `Y` be smooth of relative
dimension `n` over a locally Noetherian base `S` and let `f : Y ⟶ X` be a morphism over `S`.
Every point of `Y` has an affine chart `V = Spec B` over an affine chart `U = Spec A` of `X` over
an affine chart `W = Spec R` of `S`, on which `Ω[A⁄R]` and `Ω[B⁄R]` are free of rank `n` and the
ideal of the Kähler different of `f` is generated by `∧ⁿ(df)` — the determinant of the matrix of
`B ⊗_A Ω[A⁄R] → Ω[B⁄R]` in those bases. -/
@[stacks 0BWJ "the Kähler-different form of the local equation of `R`: on affine charts
`V = Spec B` over `U = Spec A` over `W = Spec R` of the base, the Kähler different of Tag 0BVW is
generated by `∧ⁿ(df)`, the determinant of `B ⊗_A Ω_{A/R} → Ω_{B/R}` in bases of rank `n`. The
Kähler different equals the different of Tag 0BW4 by Tag 0BWG; the statement for the different
itself is `exists_chart_differentIdealSheaf_ideal_eq_span_det`"]
theorem exists_chart_kaehlerDifferent_ideal_eq_span_det (y : Y) :
    letI : LocallyOfFiniteType f := locallyOfFiniteType_of_smoothOfRelativeDimension pX f n
    ∃ (W : S.Opens), IsAffineOpen W ∧ ∃ (U : X.affineOpens) (V : Y.affineOpens)
      (hUW : U.1 ≤ pX ⁻¹ᵁ W) (hVU : V.1 ≤ f ⁻¹ᵁ U.1) (hVW : V.1 ≤ (f ≫ pX) ⁻¹ᵁ W),
      y ∈ V.1 ∧
      letI := Stacks.Smooth.algebraAppLE pX hUW
      letI := Stacks.Smooth.algebraAppLE f hVU
      letI := Stacks.Smooth.algebraAppLE (f ≫ pX) hVW
      letI := isScalarTower_appLE pX f hUW hVU hVW
      ∃ (bA : Module.Basis (Fin n) Γ(X, U.1) Ω[Γ(X, U.1)⁄Γ(S, W)])
        (bB : Module.Basis (Fin n) Γ(Y, V.1) Ω[Γ(Y, V.1)⁄Γ(S, W)]),
        (kaehlerDifferent f).ideal V =
          Ideal.span {(LinearMap.toMatrix (bA.baseChange Γ(Y, V.1)) bB
            (KaehlerDifferential.mapBaseChange Γ(S, W) Γ(X, U.1) Γ(Y, V.1))).det} := by
  let : LocallyOfFiniteType f := locallyOfFiniteType_of_smoothOfRelativeDimension pX f n
  have : IsLocallyNoetherian X := isLocallyNoetherian_of_smoothOfRelativeDimension pX n
  have : IsLocallyNoetherian Y := isLocallyNoetherian_of_smoothOfRelativeDimension (f ≫ pX) n
  obtain ⟨W, hyW, -⟩ := exists_affine_subset ((f ≫ pX).base y) ⊤ trivial
  have hxW : pX.base (f.base y) ∈ W.1 := hyW
  obtain ⟨U, hU, hxU, hUW, bA⟩ :=
    exists_isAffineOpen_basis_kaehlerDifferential (n := n) pX (f.base y) W.2 (T := pX ⁻¹ᵁ W.1) hxW
      le_rfl
  have hyfU : y ∈ f ⁻¹ᵁ U := hxU
  have hfUW : (f ⁻¹ᵁ U) ≤ (f ≫ pX) ⁻¹ᵁ W.1 := fun z hz => hUW hz
  obtain ⟨V, hV, hyV, hVU, bB⟩ :=
    exists_isAffineOpen_basis_kaehlerDifferential (n := n) (f ≫ pX) y W.2 (T := f ⁻¹ᵁ U) hyfU hfUW
  refine ⟨W.1, W.2, ⟨U, hU⟩, ⟨V, hV⟩, hUW, hVU, hVU.trans hfUW, hyV, ?_⟩
  obtain ⟨bA⟩ := bA
  obtain ⟨bB⟩ := bB
  exact ⟨bA, bB, kaehlerDifferent_ideal_eq_span_det pX f ⟨U, hU⟩ ⟨V, hV⟩ hUW hVU
    (hVU.trans hfUW) bA bB⟩

/-- **The local equation of `R` as the top wedge of `df`.**  The same charts as in
`Stacks.Discriminant.exists_chart_kaehlerDifferent_ideal_eq_span_det`, with the generator of the
Kähler different presented not as a determinant but as the multiplier by which the map
`⋀ⁿ(df) : ⋀ⁿ(B ⊗_A Ω[A⁄R]) ⟶ ⋀ⁿΩ[B⁄R]` of the two rank-one top exterior powers carries one top
wedge to the other.

This is the chartwise form of the sheaf-level statement of [Stacks, Tag 0BWJ] that `R` is the
zero locus of the global section `∧ⁿ(df)` of `(f^*Ω^n_{X/S})^{⊗-1} ⊗ Ω^n_{Y/S}`. -/
theorem exists_chart_kaehlerDifferent_ideal_eq_span_exteriorPower_map (y : Y) :
    letI : LocallyOfFiniteType f := locallyOfFiniteType_of_smoothOfRelativeDimension pX f n
    ∃ (W : S.Opens), IsAffineOpen W ∧ ∃ (U : X.affineOpens) (V : Y.affineOpens)
      (hUW : U.1 ≤ pX ⁻¹ᵁ W) (hVU : V.1 ≤ f ⁻¹ᵁ U.1) (hVW : V.1 ≤ (f ≫ pX) ⁻¹ᵁ W),
      y ∈ V.1 ∧
      letI := Stacks.Smooth.algebraAppLE pX hUW
      letI := Stacks.Smooth.algebraAppLE f hVU
      letI := Stacks.Smooth.algebraAppLE (f ≫ pX) hVW
      letI := isScalarTower_appLE pX f hUW hVU hVW
      ∃ (bA : Module.Basis (Fin n) Γ(X, U.1) Ω[Γ(X, U.1)⁄Γ(S, W)])
        (bB : Module.Basis (Fin n) Γ(Y, V.1) Ω[Γ(Y, V.1)⁄Γ(S, W)]) (d : Γ(Y, V.1)),
        exteriorPower.map n
            (KaehlerDifferential.mapBaseChange Γ(S, W) Γ(X, U.1) Γ(Y, V.1))
            (exteriorPower.ιMulti Γ(Y, V.1) n (bA.baseChange Γ(Y, V.1))) =
          d • exteriorPower.ιMulti Γ(Y, V.1) n bB ∧
        (kaehlerDifferent f).ideal V = Ideal.span {d} := by
  let : LocallyOfFiniteType f := locallyOfFiniteType_of_smoothOfRelativeDimension pX f n
  obtain ⟨W, hW, U, V, hUW, hVU, hVW, hyV, bA, bB, hspan⟩ :=
    exists_chart_kaehlerDifferent_ideal_eq_span_det pX f n y
  let := Stacks.Smooth.algebraAppLE pX hUW
  let := Stacks.Smooth.algebraAppLE f hVU
  let := Stacks.Smooth.algebraAppLE (f ≫ pX) hVW
  let := isScalarTower_appLE pX f hUW hVU hVW
  exact ⟨W, hW, U, V, hUW, hVU, hVW, hyV, bA, bB, _,
    exteriorPower.map_top_ιMulti_eq_det_smul (bA.baseChange Γ(Y, V.1)) bB _, hspan⟩

/-- **[Stacks, Tag 0BWJ], local principality.**  The closed subscheme `R ⊆ Y` cut out by the
Kähler different of `f` — the different of `f` by [Stacks, Tag 0BWG] — is locally principal: on
the charts of `Stacks.Discriminant.exists_chart_kaehlerDifferent_ideal_eq_span_det` it is cut out
by the single function `∧ⁿ(df)`. -/
@[stacks 0BWJ "the Kähler-different form of local principality: the closed subscheme cut out by
the Kähler different of Tag 0BVW is locally principal. The Kähler different equals the different
of Tag 0BW4 by Tag 0BWG; the statement for the different itself is
`isLocallyPrincipal_differentIdealSheaf_of_smoothOfRelativeDimension`"]
theorem isLocallyPrincipal_kaehlerDifferent :
    letI : LocallyOfFiniteType f := locallyOfFiniteType_of_smoothOfRelativeDimension pX f n
    Stacks.Divisors.IsLocallyPrincipal (kaehlerDifferent f) := by
  let : LocallyOfFiniteType f := locallyOfFiniteType_of_smoothOfRelativeDimension pX f n
  intro y
  obtain ⟨W, hW, U, V, hUW, hVU, hVW, hyV, bA, bB, hspan⟩ :=
    exists_chart_kaehlerDifferent_ideal_eq_span_det pX f n y
  exact ⟨V, hyV, ⟨_, hspan⟩⟩

/-- **[Stacks, Tag 0BWJ], the effective Cartier divisor.**  If moreover `f` is étale at the
associated points of `Y`, the closed subscheme `R ⊆ Y` cut out by the Kähler different of `f` is
an effective Cartier divisor: its local equation `∧ⁿ(df)` is a nonzerodivisor, because it does
not vanish at any associated point of `Y`. -/
@[stacks 0BWJ "the Kähler-different form of the Cartier property: if `f` is étale at the
associated points of `Y`, the closed subscheme cut out by the Kähler different of Tag 0BVW is an
effective Cartier divisor. The Kähler different equals the different of Tag 0BW4 by Tag 0BWG;
the statement for the different itself is
`isEffectiveCartierDivisor_differentIdealSheaf_of_smoothOfRelativeDimension`"]
theorem isEffectiveCartierDivisor_kaehlerDifferent_of_etaleAt
    (hét : ∀ y ∈ Stacks.Divisors.schemeAssociatedPoints Y, EtaleAt f y) :
    letI : LocallyOfFiniteType f := locallyOfFiniteType_of_smoothOfRelativeDimension pX f n
    Stacks.Divisors.IsEffectiveCartierDivisor (kaehlerDifferent f) := by
  let : LocallyOfFiniteType f := locallyOfFiniteType_of_smoothOfRelativeDimension pX f n
  have : IsLocallyNoetherian Y := isLocallyNoetherian_of_smoothOfRelativeDimension (f ≫ pX) n
  exact isEffectiveCartierDivisor_kaehlerDifferent f
    (isLocallyPrincipal_kaehlerDifferent pX f n) hét

end Main

end Stacks.Discriminant

end
