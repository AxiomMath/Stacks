module

public import Mathlib.AlgebraicGeometry.RelativeGluing
public import Mathlib.Topology.LocalAtTarget
public import Mathlib.CategoryTheory.Limits.Shapes.IsTerminal
public import StacksFrontier.AlgebraicGeometry.Morphisms.WeakNormalization.Factorization
public import StacksFrontier.AlgebraicGeometry.Morphisms.WeakNormalization.RelativeSeminormalization
public import StacksFrontier.AlgebraicGeometry.Morphisms.WeakNormalization.SeminormalizationLocalization
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.RingTheory.Seminormalization.SeminormalizationInitial

/-!
# The initial subintegral factorization of a dominant qcqs morphism

A quasi-compact, quasi-separated, dominant morphism of schemes admits an initial
factorization through a universal homeomorphism inducing isomorphisms on all
residue fields.  This is the relative seminormalization of the morphism.

The existence of that initial object is
`AlgebraicGeometry.exists_initial_subintegralFactorization`, and the chosen factorization is
`AlgebraicGeometry.seminormalizationFactorization`, initial by
`AlgebraicGeometry.seminormalizationFactorizationIsInitial`, all in
`StacksFrontier.RingTheory.Seminormalization.SeminormalizationInitial`.  This file contains the
affine charts of the factorization.

## Main definitions

* `AlgebraicGeometry.affineSemiNormalizationFactorization` is the subintegral factorization of
  the restriction of `f` to an affine open of the target.

## Main results

* `AlgebraicGeometry.specMap_appTop_isDominant` and
  `AlgebraicGeometry.affineRestriction_specMap_isDominant`: dominance passes to the affine
  charts.
* `AlgebraicGeometry.relativeSeminormalization_localization_specMap_isPullback` and
  `AlgebraicGeometry.relativeSeminormalization_basicOpen_specMap_isOpenImmersion`: the charts of
  the relative seminormalization over a basic open of an affine open of the target.

## References

* [Stacks Project, Tag 0H3N](https://stacks.math.columbia.edu/tag/0H3N)
-/

@[expose] public noncomputable section

open CategoryTheory

universe u

namespace AlgebraicGeometry

/-- Passing to global sections preserves dominance when source and target are
quasi-compact. -/
private theorem specMap_appTop_isDominant
    {Y X : Scheme.{u}} (f : Y ⟶ X) [CompactSpace Y] [CompactSpace X]
    [IsDominant f] : IsDominant (Scheme.Spec.map f.appTop.op) := by
  have hcomp : IsDominant (f ≫ X.toSpecΓ) := inferInstance
  rw [Scheme.toSpecΓ_naturality f] at hcomp
  have : IsDominant (Y.toSpecΓ ≫ Scheme.Spec.map f.appTop.op) := hcomp
  exact IsDominant.of_comp Y.toSpecΓ (Scheme.Spec.map f.appTop.op)

/-- Restricting a dominant qcqs morphism to the inverse image of an affine open
still gives a dominant map on the spectra of sections. -/
private theorem affineRestriction_specMap_isDominant
    {Y X : Scheme.{u}} (f : Y ⟶ X) [QuasiCompact f] [QuasiSeparated f]
    [IsDominant f] (U : X.Opens) (hU : IsAffineOpen U) :
    IsDominant (Scheme.Spec.map (f ∣_ U).appTop.op) := by
  have : IsDominant (f ∣_ U) := IsZariskiLocalAtTarget.restrict ‹IsDominant f› U
  have : IsAffine U := hU
  have : CompactSpace U.toScheme := Scheme.compactSpace_of_isAffine U.toScheme
  have : CompactSpace (f ⁻¹ᵁ U).toScheme :=
    isCompact_iff_compactSpace.mp (f.isCompact_preimage hU.isCompact)
  exact specMap_appTop_isDominant (f ∣_ U)

/-- The local relative-seminormalization factorization over an affine open. -/
private noncomputable def affineSemiNormalizationFactorization
    {Y X : Scheme.{u}} (f : Y ⟶ X) [QuasiCompact f] [QuasiSeparated f]
    [IsDominant f] (U : X.Opens) (hU : IsAffineOpen U) :
    SubintegralFactorization (f ∣_ U) where
  middle := Spec (affineSemiNormalizationAlgebra f U hU)
  toMiddle := affineSemiNormalizationFromSource f U hU
  toBase := affineSemiNormalizationToBase f U hU
  fac := affineSemiNormalization_fac f U hU
  universalHomeomorphism := (affineSemiNormalizationToBase_subintegral f U hU).1
  residueFieldIsomorphisms := (affineSemiNormalizationToBase_subintegral f U hU).2

/-- The localized relative seminormalization is generated by the image of the
original one over the localized base. -/
private theorem relativeSeminormalization_localization_adjoin
    (A B Aₛ Bₛ : Type u) [CommRing A] [CommRing B] [CommRing Aₛ] [CommRing Bₛ]
    [Algebra A B] (S : Submonoid A)
    [Algebra A Aₛ] [IsLocalization S Aₛ]
    [Algebra B Bₛ] [IsLocalization (S.map (algebraMap A B)) Bₛ]
    [Algebra A Bₛ] [IsScalarTower A B Bₛ]
    [Algebra Aₛ Bₛ] [IsScalarTower A Aₛ Bₛ]
    (hdom : IsDominant
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op))
    (hdomₛ : IsDominant
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap Aₛ Bₛ)).op)) :
    Algebra.adjoin Aₛ
      (algebraMap B Bₛ '' relativeSeminormalization A B hdom) =
        relativeSeminormalization Aₛ Bₛ hdomₛ := by
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro x ⟨b, hb, rfl⟩
    exact relativeSeminormalization_localization_map_mem
      A B Aₛ Bₛ S hdom hdomₛ hb
  · intro x hx
    obtain ⟨b, hb, s, rfl⟩ :=
      (mem_relativeSeminormalization_localization_iff A B Aₛ Bₛ S hdom hdomₛ x).mp hx
    rw [IsLocalization.mk'_eq_mul_mk'_one]
    refine mul_mem (Algebra.subset_adjoin ⟨b, hb, rfl⟩) ?_
    let t : S.map (algebraMap A B) :=
      ⟨algebraMap A B s.1, Submonoid.mem_map.mpr ⟨s.1, s.2, rfl⟩⟩
    have ht : IsLocalization.mk' Bₛ 1 t =
        algebraMap Aₛ Bₛ (IsLocalization.mk' Aₛ 1 s) := by
      let ψ : Aₛ →+* Bₛ := IsLocalization.map Bₛ (algebraMap A B)
        (Submonoid.le_comap_map S)
      have hψ : (algebraMap Aₛ Bₛ : Aₛ →+* Bₛ) = ψ := by
        apply IsLocalization.ringHom_ext S
        ext a
        simp [ψ, ← IsScalarTower.algebraMap_apply]
      rw [hψ]
      simp [ψ, IsLocalization.map_mk', t]
    rw [ht]
    exact Subalgebra.algebraMap_mem _ _

/-- The localized chart transition is over the corresponding localization of
the base chart. -/
private theorem relativeSeminormalization_localization_specMap_base
    (A B Aₛ Bₛ : Type u) [CommRing A] [CommRing B] [CommRing Aₛ] [CommRing Bₛ]
    [Algebra A B] (S : Submonoid A)
    [Algebra A Aₛ] [IsLocalization S Aₛ]
    [Algebra B Bₛ] [IsLocalization (S.map (algebraMap A B)) Bₛ]
    [Algebra A Bₛ] [IsScalarTower A B Bₛ]
    [Algebra Aₛ Bₛ] [IsScalarTower A Aₛ Bₛ]
    (hdom : IsDominant
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op))
    (hdomₛ : IsDominant
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap Aₛ Bₛ)).op)) :
    relativeSeminormalization_localization_specMap
        A B Aₛ Bₛ S hdom hdomₛ ≫
      Scheme.Spec.map (CommRingCat.ofHom
        (algebraMap A (relativeSeminormalization A B hdom))).op =
    Scheme.Spec.map (CommRingCat.ofHom
        (algebraMap Aₛ (relativeSeminormalization Aₛ Bₛ hdomₛ))).op ≫
      Scheme.Spec.map (CommRingCat.ofHom (algebraMap A Aₛ)).op := by
  have h : CommRingCat.ofHom (algebraMap A
      (relativeSeminormalization A B hdom)) ≫
      CommRingCat.ofHom (relativeSeminormalization_localization_algHom
        A B Aₛ Bₛ S hdom hdomₛ).toRingHom =
    CommRingCat.ofHom (algebraMap A Aₛ) ≫
      CommRingCat.ofHom (algebraMap Aₛ
        (relativeSeminormalization Aₛ Bₛ hdomₛ)) := by
    rw [← CommRingCat.ofHom_comp, ← CommRingCat.ofHom_comp]
    exact congrArg CommRingCat.ofHom
      (relativeSeminormalization_localization_algHom_base A B Aₛ Bₛ S hdom hdomₛ)
  simpa only [op_comp, Scheme.Spec.map_comp,
    relativeSeminormalization_localization_specMap] using
      congrArg (fun q => Scheme.Spec.map q.op) h

/-- Localizing an affine chart of the base gives a pullback square on the
relative-seminormalization charts. -/
private theorem relativeSeminormalization_localization_specMap_isPullback
    (A B Aₛ Bₛ : Type u) [CommRing A] [CommRing B] [CommRing Aₛ] [CommRing Bₛ]
    [Algebra A B] (S : Submonoid A)
    [Algebra A Aₛ] [IsLocalization S Aₛ]
    [Algebra B Bₛ] [IsLocalization (S.map (algebraMap A B)) Bₛ]
    [Algebra A Bₛ] [IsScalarTower A B Bₛ]
    [Algebra Aₛ Bₛ] [IsScalarTower A Aₛ Bₛ]
    (hdom : IsDominant
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op))
    (hdomₛ : IsDominant
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap Aₛ Bₛ)).op)) :
    IsPullback
      (relativeSeminormalization_localization_specMap
        A B Aₛ Bₛ S hdom hdomₛ)
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap Aₛ
        (relativeSeminormalization Aₛ Bₛ hdomₛ))).op)
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A
        (relativeSeminormalization A B hdom))).op)
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A Aₛ)).op) := by
  let E := relativeSeminormalization A B hdom
  let Eₛ := relativeSeminormalization Aₛ Bₛ hdomₛ
  let j := (relativeSeminormalization_localization_algHom
    A B Aₛ Bₛ S hdom hdomₛ).toRingHom
  let : Algebra E Eₛ := j.toAlgebra
  have : IsLocalization (S.map (algebraMap A E)) Eₛ :=
    relativeSeminormalization_localization_isLocalization
      A B Aₛ Bₛ S hdom hdomₛ
  have hbase := relativeSeminormalization_localization_algHom_base
    A B Aₛ Bₛ S hdom hdomₛ
  have hpush : IsPushout
      (CommRingCat.ofHom (algebraMap A E))
      (CommRingCat.ofHom (algebraMap A Aₛ))
      (CommRingCat.ofHom (algebraMap E Eₛ))
      (CommRingCat.ofHom (algebraMap Aₛ Eₛ)) :=
    CommRingCat.isPushout_of_isLocalization (algebraMap A E) (algebraMap Aₛ Eₛ) hbase.symm S
  simpa [relativeSeminormalization_localization_specMap, j, E, Eₛ] using
    isPullback_SpecMap_of_isPushout (CommRingCat.ofHom (algebraMap A E))
      (CommRingCat.ofHom (algebraMap A Aₛ)) (CommRingCat.ofHom j)
      (CommRingCat.ofHom (algebraMap Aₛ Eₛ)) hpush

/-- For a basic open of the base, the localized relative-seminormalization
chart map is an open immersion. -/
private theorem relativeSeminormalization_basicOpen_specMap_isOpenImmersion
    (A B Aₛ Bₛ : Type u) [CommRing A] [CommRing B] [CommRing Aₛ] [CommRing Bₛ]
    [Algebra A B] (r : A)
    [Algebra A Aₛ] [IsLocalization (Submonoid.powers r) Aₛ]
    [Algebra B Bₛ]
      [IsLocalization ((Submonoid.powers r).map (algebraMap A B)) Bₛ]
    [Algebra A Bₛ] [IsScalarTower A B Bₛ]
    [Algebra Aₛ Bₛ] [IsScalarTower A Aₛ Bₛ]
    (hdom : IsDominant
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op))
    (hdomₛ : IsDominant
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap Aₛ Bₛ)).op)) :
    IsOpenImmersion (relativeSeminormalization_localization_specMap
      A B Aₛ Bₛ (Submonoid.powers r) hdom hdomₛ) := by
  have hbase : IsOpenImmersion
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A Aₛ)).op) :=
    IsOpenImmersion.of_isLocalization r
  exact MorphismProperty.of_isPullback
    (relativeSeminormalization_localization_specMap_isPullback
      A B Aₛ Bₛ (Submonoid.powers r) hdom hdomₛ).flip hbase

/-- A quasi-compact, quasi-separated, dominant morphism of schemes has an initial subintegral
factorization (the `semi_initial` assertion of Tag 0H3N). -/
example {Y X : Scheme.{u}} (f : Y ⟶ X) [QuasiCompact f] [QuasiSeparated f]
    [IsDominant f] :
    ∃ F : SubintegralFactorization f, Nonempty (Limits.IsInitial F) :=
  exists_initial_subintegralFactorization f

end AlgebraicGeometry

end
