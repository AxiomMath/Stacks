module

public import StacksFrontier.AlgebraicGeometry.Modules.FiniteBiproducts
public import StacksFrontier.AlgebraicGeometry.AmpleLocalGeneration.FromExtension
public import StacksFrontier.AlgebraicGeometry.AmpleGlobalGeneration.Twist
public import StacksFrontier.AlgebraicGeometry.AmpleEventualGeneration.Affine
public import StacksFrontier.AlgebraicGeometry.CoherenceCriteria.Basic
public import StacksFrontier.AlgebraicGeometry.CoherentAbelian.Basic
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.CoherenceClosure

/-!
# Generated high twists of an ample module

Let `ℒ` be an ample invertible module on a scheme `X`.  For every bound `d₀` there is a `d ≥ d₀`
such that `ℒ^{⊗ d}` is generated by finitely many global sections: this is clause (7) of
[Stacks, Tag 01Q3] (`AlgebraicGeometry.isEventuallyGloballyGenerated_of_isAmple`) at the module
`𝒪_X`, read through `𝒪_X ⊗ ℒ^{⊗ d} ≅ ℒ^{⊗ d}`.  On a locally Noetherian scheme a finite direct
sum of copies of an invertible module is moreover quasi-coherent of finite type.

## Main results

* `Stacks.AmpleGlobalGeneration.exists_le_generatingSections_tensorPowModule`: the generation.
* `Stacks.AmpleGlobalGeneration.isFiniteType_biproduct_const_of_isInvertibleModule`: finite type
  of a finite direct sum of copies of an invertible module on a locally Noetherian scheme.

## References

* [Stacks Project, Tag 01Q3](https://stacks.math.columbia.edu/tag/01Q3)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits MonoidalCategory
open Stacks.Ample

universe u

attribute [local instance] Stacks.SheafInternalHom.schemeMonoidalCategory

namespace Stacks.AmpleGlobalGeneration

variable {X : Scheme.{u}}

/-- **High twists of an ample module are generated by finitely many global sections.**  For an
ample invertible `ℒ` and every `d₀ : ℕ` there are `d ≥ d₀` and a finite family of global sections
generating `ℒ^{⊗ d}`. -/
theorem exists_le_generatingSections_tensorPowModule (L : X.Modules) [IsInvertibleModule X L]
    (hL : IsAmple X L) (d₀ : ℕ) :
    ∃ d : ℕ, d₀ ≤ d ∧ ∃ σ : (tensorPowModule X L (d : ℤ)).GeneratingSections, Finite σ.I := by
  obtain ⟨n₀, hn₀⟩ :=
    Stacks.AmpleLocalGeneration.isEventuallyGloballyGenerated_of_isAmple L hL (unitModule X)
      (isQuasicoherent_of_isInvertibleModule _)
      (Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule _)
  refine ⟨max d₀ n₀.toNat, le_max_left _ _, ?_⟩
  obtain ⟨σ, hσ⟩ := hn₀ ((max d₀ n₀.toNat : ℕ) : ℤ) (by omega)
  set e := unitTensorIso L ((max d₀ n₀.toNat : ℕ) : ℤ)
  have : Epi (C := SheafOfModules.{u} X.ringCatSheaf) e.hom :=
    ⟨fun g h hgh => (cancel_epi (C := X.Modules) e.hom).1 hgh⟩
  exact ⟨σ.ofEpi e.hom, hσ⟩

/-- **A finite direct sum of copies of an invertible module on a locally Noetherian scheme is of
finite type.**  The module is coherent, being quasi-coherent of finite type on a locally
Noetherian scheme, coherence is stable under finite coproducts, and the biproduct is the
coproduct. -/
theorem isFiniteType_biproduct_const_of_isInvertibleModule [IsLocallyNoetherian X]
    (L : X.Modules) [IsInvertibleModule X L] {ι : Type} [Finite ι] :
    SheafOfModules.IsFiniteType.{u, u, u} (show X.Modules from ⨁ fun _ : ι => L) := by
  have : L.IsQuasicoherent := isQuasicoherent_of_isInvertibleModule L
  have : SheafOfModules.IsFiniteType.{u, u, u} L :=
    Stacks.AmpleEventualGeneration.isFiniteType_of_isInvertibleModule L
  have hL : Stacks.SheafOfModules.IsCoherent L :=
    AlgebraicGeometry.CoherentAbelian.stacksIsCoherent_of_isCoherent
      (Stacks.AlgebraicGeometry.CoherenceCriteria.isCoherent_of_isQuasicoherent_of_isFiniteType L)
  have e : (⨁ fun _ : ι => L) ≅ ∐ fun _ : ι => L := biproduct.isoCoproduct _
  have h := (Stacks.SheafOfModules.coherentModules X.ringCatSheaf).prop_of_iso e.symm
    (Stacks.SheafOfModules.isCoherent_sigma (fun _ : ι => L) fun _ => hL)
  exact h.isFiniteType

end Stacks.AmpleGlobalGeneration

end
