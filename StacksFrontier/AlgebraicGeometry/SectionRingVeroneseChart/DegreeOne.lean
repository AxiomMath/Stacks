## What is not done here

**No stacks attribute is attached.** This file is the degree-one input to the integer-degree
family `twistComparison` assembled in the sibling
`StacksFrontier/AlgebraicGeometry/SectionRingVeroneseChart/IntegerDegree.lean`, for which the second
claim of Tag 01QI is proved there. Tag 01QH's map itself is Tag 01NK's `θ`,
`Stacks.SectionRingProjMorphism.Theta.projThetaUnital`.

**`pbTwistIsoTensorPow` in degree `d` is not identified with Tag 01N8's comparison.** The two are
isomorphisms with the same source and target. The multiplicativity of
`Stacks.AlgebraicGeometry.GoodOpenIntTwist.theta` that the identification would use is now
available in every integer bidegree, as
`Stacks.AlgebraicGeometry.GoodOpenIntTwist.theta_mul`, and so is the same multiplicativity for
the pullback and the transport legs of `pbTwistIsoTensorPow`, namely
`Stacks.AlgebraicGeometry.PullbackTensorPowInt.pullbackTensorPowModuleIntIso_tensorPowModuleAddIso`
and `Stacks.AlgebraicGeometry.TensorPowCongrInt.tensorPowModuleIsoOfIsoInt_mul`, and for the
structural leg that pulls `theta_mul` back along the lift
(`Stacks.SectionRingVeroneseChart.pullbackTheta_mul`). The remaining structural leg's square and
the pasting of the five are proved too, as
`Stacks.SectionRingVeroneseChart.pbTwistIsoGood_mul` and
`Stacks.SectionRingVeroneseChart.twistComparison_mul`
(`StacksFrontier/AlgebraicGeometry/TwistTensor/VeroneseChartGradedAlgebra.lean`), so what remains
for the identification is not a bidegree square but the uniqueness argument that two
multiplicative families of isomorphisms agreeing in degree one agree in every degree, which the
repository does not carry. Nothing below uses it.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite
open AlgebraicGeometry.ProjectiveSpectrum.Proj (twistingSheaf)
open Stacks.Ample (IsInvertibleModule tensorPowModule tensorPowModuleOneIso
  tensorPowModuleZeroIso tensorPowModuleAddIso unitModule)
open Stacks.AmpleFiniteAvoidance (grading nvOpen)
open Stacks.GradedSections (powSections)
open Stacks.RelativeVeryAmple (tensorModules tensorModulesMapIso tensorPowModuleCongr)
open Stacks.AlgebraicGeometry.GoodOpenIntTwist (goodOpen twist theta)
open Stacks.AlgebraicGeometry.HyperplaneTwistSequence (tensorRightModules
  pullbackTensorPowModuleIntIso tensorPowModuleIsoOfIsoInt)

universe u

namespace Stacks.SectionRingVeroneseChart

section Monoidal

attribute [local instance] Stacks.SheafOfModules.monoidalCategoryPresheafOfModules
  Stacks.SheafOfModules.symmetricCategoryPresheafOfModules
  Stacks.SheafInternalHom.isMonoidal_localIso
  Stacks.SheafInternalHom.isLocalization_sheafify Stacks.SheafInternalHom.monoidalCategory
  Stacks.SheafInternalHom.sheafifyMonoidal Stacks.SheafInternalHom.braidedCategory
  Stacks.SheafInternalHom.schemeMonoidalCategory
  Stacks.SectionRingGeometric.schemeBraidedCategory
  Stacks.SectionRingGeometric.schemePreadditive
  Stacks.SectionRingGeometric.schemeTensorRightAdditive

variable {X : Scheme.{u}} (L : X.Modules) [IsInvertibleModule X L]

/-! ### The canonical morphism lifted through Tag 01MU's open `W₁` -/

/-- **The canonical morphism of Stacks Tag 01PZ, lifted through Tag 01MU's open `W₁`.** The first
claim of Stacks Tag 01QI
(`Stacks.SectionRingProjGoodOpen.projHomOfIsAmple_preimage_whereInvertible`) puts the image of the
canonical morphism inside `W₁`, and `AlgebraicGeometry.IsOpenImmersion.lift` factors it. -/
def goodLift (hL : Stacks.Ample.IsAmple X L) : X ⟶ (goodOpen (grading L)).toScheme :=
  IsOpenImmersion.lift (goodOpen (grading L)).ι
    (Stacks.SectionRingProjMorphism.projHomOfIsAmple L hL) (by
      rw [Scheme.Opens.range_ι]
      rintro y ⟨x, rfl⟩
      exact (Stacks.SectionRingProjGoodOpen.projHomOfIsAmple_preimage_whereInvertible L hL).ge
        (Opens.mem_top x))

/-- The lift through `W₁`, composed with the open immersion, is the canonical morphism. -/
@[reassoc] theorem goodLift_comp_ι (hL : Stacks.Ample.IsAmple X L) :
    goodLift L hL ≫ (goodOpen (grading L)).ι
      = Stacks.SectionRingProjMorphism.projHomOfIsAmple L hL :=
  IsOpenImmersion.lift_fac _ _ _

/-! ### `f^*𝒪_Y(c)` -/

/-- **`f^*𝒪_Y(c)`**, the pullback along the canonical morphism of Stacks Tag 01PZ of the `c`-th
twist of `Proj Γ_*(X, L)`, for an arbitrary integer `c`. -/
abbrev pbTwist (hL : Stacks.Ample.IsAmple X L) (c : ℤ) : X.Modules :=
  (Scheme.Modules.pullback (Stacks.SectionRingProjMorphism.projHomOfIsAmple L hL)).obj
    (twistingSheaf (grading L) c)

/-- **`f^*𝒪_Y(c)` is the pullback along the lift through `W₁` of the restricted twist.** The
canonical morphism is the lift followed by the open immersion, and
`AlgebraicGeometry.Scheme.Modules.pullbackComp` identifies the iterated pullback with the pullback
along the composite. -/
def pbTwistIsoGood (hL : Stacks.Ample.IsAmple X L) (c : ℤ) :
    pbTwist L hL c ≅ (Scheme.Modules.pullback (goodLift L hL)).obj (twist (grading L) c) :=
  eqToIso (congrArg
      (fun φ : X ⟶ AlgebraicGeometry.Proj (grading L) =>
        (Scheme.Modules.pullback φ).obj (twistingSheaf (grading L) c))
      (goodLift_comp_ι L hL).symm) ≪≫
    ((Scheme.Modules.pullbackComp (goodLift L hL) (goodOpen (grading L)).ι).app
      (twistingSheaf (grading L) c)).symm

/-- **`f^*𝒪_Y(c)` is invertible**, in every integer degree: on `W₁` every twist is invertible
(`Stacks.AlgebraicGeometry.GoodOpenIntTwist.isInvertibleModule_twist`) and invertibility is
stable under pullback. -/
instance isInvertibleModule_pbTwist (hL : Stacks.Ample.IsAmple X L) (c : ℤ) :
    IsInvertibleModule X (pbTwist L hL c) :=
  Stacks.AlgebraicGeometry.ProjAmpleTwist.isInvertibleModule_of_iso (pbTwistIsoGood L hL c).symm

/-! ### `f^*𝒪_Y(c) ≅ (f^*𝒪_Y(1))^{⊗ c}` -/

/-- **`f^*𝒪_Y(c) ≅ (f^*𝒪_Y(1))^{⊗ c}`, in every integer degree.** The pullback along the lift
through `W₁` of Tag 01MU's comparison
`Stacks.AlgebraicGeometry.GoodOpenIntTwist.theta`, with the pullback commuted past the integer
tensor powers by `…HyperplaneTwistSequence.pullbackTensorPowModuleIntIso` and the base of the
powers read back as `f^*𝒪_Y(1)`. -/
def pbTwistIsoTensorPow (hL : Stacks.Ample.IsAmple X L) (c : ℤ) :
    pbTwist L hL c ≅ tensorPowModule X (pbTwist L hL 1) c :=
  pbTwistIsoGood L hL c ≪≫
    (Scheme.Modules.pullback (goodLift L hL)).mapIso (theta (grading L) c).symm ≪≫
    pullbackTensorPowModuleIntIso (goodLift L hL) (twist (grading L) 1) c ≪≫
    tensorPowModuleIsoOfIsoInt X _ (pbTwist L hL 1) (pbTwistIsoGood L hL 1).symm c

/-! ### Stacks Tag 01N8's comparison at the tensor-power spelling -/

/-- Stacks Tag 01N8's comparison `f^*𝒪_Y(d) ≅ 𝓛^{⊗ d}` with its target read at the integer
tensor power `Stacks.Ample.tensorPowModule` rather than the iterated tensor product: in a
nonnegative degree the two are the same object. -/
def twistIsoPow (hL : Stacks.Ample.IsAmple X L) {d : ℕ} (hd : 0 < d)
    (hcov : (⨆ a : powSections L d, nvOpen L a) = ⊤) :
    pbTwist L hL (d : ℤ) ≅ tensorPowModule X L (d : ℤ) :=
  twistIso L hL hd hcov

/-! ### The descent to degree one -/

/-- **The degree `d + 1` comparison, split as `1 + d`.** Both sides of Stacks Tag 01N8's
comparison in degree `d + 1` are split by the addition law of the tensor powers at `(1, d)`, and
the degree-`d` factors are rewritten by the comparison in degree `d`. What is left is the
degree-one statement tensored on the right by `𝓛^{⊗ d}`. -/
def twistOneTensorIso (hL : Stacks.Ample.IsAmple X L) {d : ℕ} (hd : 0 < d)
    (hcov : (⨆ a : powSections L d, nvOpen L a) = ⊤)
    (hcov' : (⨆ a : powSections L (d + 1), nvOpen L a) = ⊤) :
    tensorModules X (pbTwist L hL 1) (tensorPowModule X L (d : ℤ))
      ≅ tensorModules X L (tensorPowModule X L (d : ℤ)) :=
  tensorModulesMapIso X (tensorPowModuleOneIso X (pbTwist L hL 1)).symm
      ((twistIsoPow L hL hd hcov).symm ≪≫ pbTwistIsoTensorPow L hL (d : ℤ)) ≪≫
    tensorPowModuleAddIso X (pbTwist L hL 1) 1 (d : ℤ) ≪≫
    tensorPowModuleCongr X (pbTwist L hL 1)
      (show (1 : ℤ) + (d : ℤ) = ((d + 1 : ℕ) : ℤ) from by push_cast; ring) ≪≫
    (pbTwistIsoTensorPow L hL ((d + 1 : ℕ) : ℤ)).symm ≪≫
    twistIsoPow L hL (Nat.succ_pos d) hcov' ≪≫
    tensorPowModuleCongr X L
      (show ((d + 1 : ℕ) : ℤ) = (1 : ℤ) + (d : ℤ) from by push_cast; ring) ≪≫
    (tensorPowModuleAddIso X L 1 (d : ℤ)).symm ≪≫
    tensorModulesMapIso X (tensorPowModuleOneIso X L) (Iso.refl _)

/-- **`f^*𝒪_Y(1) ≅ 𝓛`.** `twistOneTensorIso` is the statement tensored on the right by the
invertible module `𝓛^{⊗ d}`, and tensoring on the right by an invertible module is an equivalence
(Stacks Tag 0FFM, `Stacks.SheafOfModules.TensorPower.isEquivalence_tensorRightFunctor`), hence
fully faithful; `CategoryTheory.Functor.preimageIso` removes the factor. -/
def twistOneIso (hL : Stacks.Ample.IsAmple X L) {d : ℕ} (hd : 0 < d)
    (hcov : (⨆ a : powSections L d, nvOpen L a) = ⊤)
    (hcov' : (⨆ a : powSections L (d + 1), nvOpen L a) = ⊤) :
    pbTwist L hL 1 ≅ L :=
  haveI : (tensorRightModules X (tensorPowModule X L (d : ℤ))).IsEquivalence :=
    Stacks.SheafOfModules.TensorPower.isEquivalence_tensorRightFunctor _ _ _
  Functor.preimageIso (tensorRightModules X (tensorPowModule X L (d : ℤ)))
    (show (tensorRightModules X (tensorPowModule X L (d : ℤ))).obj (pbTwist L hL 1)
        ≅ (tensorRightModules X (tensorPowModule X L (d : ℤ))).obj L from
      twistOneTensorIso L hL hd hcov hcov')

/-! ### The degree supplied by ampleness -/

/-- **For `L` ample the opens `X_a` cover `X` in two consecutive degrees.** The degree
`n₀ + 1` of `exists_forall_iSup_nvOpen_eq_top` and its successor. -/
theorem exists_consecutive_iSup_nvOpen_eq_top (hL : Stacks.Ample.IsAmple X L) :
    ∃ d : ℕ, 0 < d ∧ (⨆ a : powSections L d, nvOpen L a) = ⊤ ∧
      (⨆ a : powSections L (d + 1), nvOpen L a) = ⊤ := by
  obtain ⟨n₀, h⟩ := exists_forall_iSup_nvOpen_eq_top L hL
  exact ⟨n₀ + 1, Nat.succ_pos _, h _ (Nat.le_succ _), h _ (by omega)⟩

/-- **`f^*𝒪_Y(1) ≅ 𝓛`, with no hypothesis beyond ampleness of `𝓛`.** `twistOneIso` at a degree
supplied by `exists_consecutive_iSup_nvOpen_eq_top`. -/
def degreeOneIso (hL : Stacks.Ample.IsAmple X L) : pbTwist L hL 1 ≅ L :=
  twistOneIso L hL (exists_consecutive_iSup_nvOpen_eq_top L hL).choose_spec.1
    (exists_consecutive_iSup_nvOpen_eq_top L hL).choose_spec.2.1
    (exists_consecutive_iSup_nvOpen_eq_top L hL).choose_spec.2.2

end Monoidal

end Stacks.SectionRingVeroneseChart

end
