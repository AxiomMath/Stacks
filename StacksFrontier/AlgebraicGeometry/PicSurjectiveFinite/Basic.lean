open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace
open Stacks.SheafOfModules.TensorStalkRingedSpace
open Stacks.SheafOfModules

universe u

namespace Stacks.PicFinite

variable {X Y : Scheme.{u}}

/-! ### A morphism which is an isomorphism over an open is one over every smaller open -/

/-- A morphism which is an isomorphism over `V` is an isomorphism over every open `W ≤ V`. -/
theorem isIso_morphismRestrict_of_le (f : X ⟶ Y) {V W : Y.Opens} [IsIso (f ∣_ V)] (h : W ≤ V) :
    IsIso (f ∣_ W) := by
  have hImage : V.ι ''ᵁ (V.ι ⁻¹ᵁ W) = W := by
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι, inf_eq_right.2 h]
  have h1 := (MorphismProperty.arrow_mk_iso_iff (MorphismProperty.isomorphisms Scheme)
    (morphismRestrictRestrict f V (V.ι ⁻¹ᵁ W))).1
      (show IsIso (f ∣_ V ∣_ (V.ι ⁻¹ᵁ W)) from inferInstance)
  rw [hImage] at h1
  exact h1

/-- A morphism which is an isomorphism over `V` induces an isomorphism `f.app W` on the
sections over every open `W ≤ V`. -/
theorem isIso_app_of_le (f : X ⟶ Y) {V W : Y.Opens} [IsIso (f ∣_ V)] (h : W ≤ V) :
    IsIso (f.app W) := by
  have := isIso_morphismRestrict_of_le f h
  have h3 : IsIso (f.app (W.ι ''ᵁ ⊤) ≫
      X.presheaf.map (eqToHom (image_morphismRestrict_preimage f W ⊤)).op) := by
    rw [← morphismRestrict_appTop f W]
    exact inferInstanceAs (IsIso ((f ∣_ W).app ⊤))
  have h4 : IsIso (f.app (W.ι ''ᵁ ⊤)) :=
    IsIso.of_isIso_comp_right _
      (X.presheaf.map (eqToHom (image_morphismRestrict_preimage f W ⊤)).op)
  rw [Scheme.Opens.ι_image_top] at h4
  exact h4

/-- A morphism which is an isomorphism over `V` is invertible on the sections over every open
inside `V`. -/
instance fact_isIso_app_of_isIso_morphismRestrict (f : X ⟶ Y) {V : Y.Opens} [IsIso (f ∣_ V)] :
    Fact (∀ W : Y.Opens, W ≤ V → IsIso (f.app W)) :=
  ⟨fun _ h => isIso_app_of_le f h⟩

/-! ### Descending functions and units through an isomorphism on sections over `V` -/

/-- A unit upstairs over the preimage of an open `W ≤ V`, descended to the target through the
inverse of `f.app W`, for `f` invertible on the sections over every open inside `V`. -/
noncomputable def descendUnitOfIsIsoApp (f : X ⟶ Y) {V : Y.Opens}
    [hV : Fact (∀ W : Y.Opens, W ≤ V → IsIso (f.app W))] {W : Y.Opens}
    (h : W ≤ V) : (Γ(X, f ⁻¹ᵁ W))ˣ →* (Γ(Y, W))ˣ :=
  have := hV.out W h
  Units.map (inv (f.app W)).hom

/-- The descended unit pulls back to the unit it came from. -/
theorem map_descendUnitOfIsIsoApp (f : X ⟶ Y) {V : Y.Opens}
    [hV : Fact (∀ W : Y.Opens, W ≤ V → IsIso (f.app W))] {W : Y.Opens}
    (h : W ≤ V) (x : (Γ(X, f ⁻¹ᵁ W))ˣ) :
    Units.map (f.app W).hom (descendUnitOfIsIsoApp f h x) = x := by
  have := hV.out W h
  refine Units.ext ?_
  exact congrArg (fun q => (CommRingCat.Hom.hom q) x.val) (IsIso.inv_hom_id (f.app W))

/-- Descending a unit commutes with restriction to a smaller open. -/
theorem descendUnitOfIsIsoApp_naturality (f : X ⟶ Y) {V : Y.Opens}
    [hV : Fact (∀ W : Y.Opens, W ≤ V → IsIso (f.app W))] {A B : Y.Opens}
    (hA : A ≤ V) (h : B ≤ A) (x : (Γ(X, f ⁻¹ᵁ A))ˣ) :
    descendUnitOfIsIsoApp f (h.trans hA)
        (Units.map (X.presheaf.map ((Opens.map f.base).map (homOfLE h)).op).hom x) =
      Units.map (Y.presheaf.map (homOfLE h).op).hom (descendUnitOfIsIsoApp f hA x) := by
  have i1 := hV.out A hA
  have i2 := hV.out B (h.trans hA)
  have nat : Y.presheaf.map (homOfLE h).op ≫ f.app B =
      f.app A ≫ X.presheaf.map ((Opens.map f.base).map (homOfLE h)).op :=
    f.naturality (homOfLE h).op
  have key : X.presheaf.map ((Opens.map f.base).map (homOfLE h)).op ≫ inv (f.app B) =
      inv (f.app A) ≫ Y.presheaf.map (homOfLE h).op := by
    rw [IsIso.comp_inv_eq, Category.assoc, nat, IsIso.inv_hom_id_assoc]
  exact Units.ext (congrArg (fun q => (CommRingCat.Hom.hom q) x.val) key)

/-! ### Descending functions and units through an isomorphism over `V` -/

/-- A unit upstairs over the preimage of an open `W ≤ V`, descended to the target through the
inverse of `f.app W`, for `f` an isomorphism over `V`. -/
noncomputable def descendUnit (f : X ⟶ Y) {V : Y.Opens} [IsIso (f ∣_ V)] {W : Y.Opens}
    (h : W ≤ V) : (Γ(X, f ⁻¹ᵁ W))ˣ →* (Γ(Y, W))ˣ :=
  descendUnitOfIsIsoApp f h

/-- The descended unit pulls back to the unit it came from. -/
theorem map_descendUnit (f : X ⟶ Y) {V : Y.Opens} [IsIso (f ∣_ V)] {W : Y.Opens}
    (h : W ≤ V) (x : (Γ(X, f ⁻¹ᵁ W))ˣ) :
    Units.map (f.app W).hom (descendUnit f h x) = x :=
  map_descendUnitOfIsIsoApp f h x

/-- Descending a unit commutes with restriction to a smaller open. -/
theorem descendUnit_naturality (f : X ⟶ Y) {V : Y.Opens} [IsIso (f ∣_ V)] {A B : Y.Opens}
    (hA : A ≤ V) (h : B ≤ A) (x : (Γ(X, f ⁻¹ᵁ A))ˣ) :
    descendUnit f (h.trans hA)
        (Units.map (X.presheaf.map ((Opens.map f.base).map (homOfLE h)).op).hom x) =
      Units.map (Y.presheaf.map (homOfLE h).op).hom (descendUnit f hA x) :=
  descendUnitOfIsIsoApp_naturality f hA h x

/-! ### The V-separated trivializing cover -/

/-- If `Vᶜ` is discrete, every point `t ∉ V` has an open neighbourhood meeting `Vᶜ` only in
`t`. -/
theorem exists_isolating_open (V : Y.Opens) [DiscreteTopology (Vᶜ : Set Y)] {t : Y}
    (ht : t ∉ V) : ∃ O : Y.Opens, t ∈ O ∧ ∀ z ∈ O, z ≠ t → z ∈ V := by
  have hmem : t ∈ (Vᶜ : Set Y) := ht
  obtain ⟨O, hO, hOeq⟩ :=
    isOpen_induced_iff.mp (isOpen_discrete ({(⟨t, hmem⟩ : (Vᶜ : Set Y))} : Set _))
  refine ⟨⟨O, hO⟩, ?_, ?_⟩
  · change (⟨t, hmem⟩ : (Vᶜ : Set Y)).1 ∈ O
    have : (⟨t, hmem⟩ : (Vᶜ : Set Y)) ∈ Subtype.val ⁻¹' O := by rw [hOeq]; rfl
    exact this
  · intro z hz hzt
    by_contra hzV
    have hz' : (⟨z, hzV⟩ : (Vᶜ : Set Y)) ∈ Subtype.val ⁻¹' O := hz
    rw [hOeq] at hz'
    exact hzt (congrArg Subtype.val hz')

/-- A point of the target has a chart which is trivializing for `L` and meets `Vᶜ` at most in
the point itself, as soon as `L` is trivial above some neighbourhood of every point. -/
theorem exists_separated_chart_of_hasTrivializingTargetCover (f : X ⟶ Y) (V : Y.Opens)
    [DiscreteTopology (Vᶜ : Set Y)] (L : X.Modules)
    (hL : Stacks.Divisors.HasTrivializingTargetCover f L) (y : Y) :
    ∃ W : Y.Opens, y ∈ W ∧ (∀ z ∈ W, z ≠ y → z ∈ V) ∧
      Nonempty (L.restrict (f ⁻¹ᵁ W).ι ≅
        _root_.SheafOfModules.unit (f ⁻¹ᵁ W).toScheme.ringCatSheaf) := by
  obtain ⟨W₀, hyW₀, e₀⟩ := hL y
  obtain ⟨O, hyO, hOsep⟩ : ∃ O : Y.Opens, y ∈ O ∧ ∀ z ∈ O, z ≠ y → z ∈ V := by
    by_cases hyV : y ∈ V
    · exact ⟨V, hyV, fun z hz _ => hz⟩
    · exact exists_isolating_open V hyV
  exact ⟨W₀ ⊓ O, ⟨hyW₀, hyO⟩, fun z hz hzy => hOsep z hz.2 hzy,
    ⟨restrictIsoUnitOfLE L (P := f ⁻¹ᵁ (W₀ ⊓ O)) (A := f ⁻¹ᵁ W₀) (fun _ hx => hx.1) e₀.some⟩⟩

/-- For `f` finite and `L` invertible, a point of the target has a chart which is trivializing
for `L` and meets `Vᶜ` at most in the point itself. -/
theorem exists_separated_chart (f : X ⟶ Y) [IsFinite f] (V : Y.Opens)
    [DiscreteTopology (Vᶜ : Set Y)] (L : X.Modules)
    [IsInvertible X.presheaf (structureSheafRing X.toRingedSpace).property L] (y : Y) :
    ∃ W : Y.Opens, y ∈ W ∧ (∀ z ∈ W, z ≠ y → z ∈ V) ∧
      Nonempty (L.restrict (f ⁻¹ᵁ W).ι ≅
        _root_.SheafOfModules.unit (f ⁻¹ᵁ W).toScheme.ringCatSheaf) :=
  exists_separated_chart_of_hasTrivializingTargetCover f V L
    (Stacks.Divisors.hasTrivializingTargetCover_of_isFinite f L) y

/-- A cover of `Y` by charts, one around each point, any two distinct ones meeting only inside
`V`, together with a generator of `L` over the inverse image of each chart: the chart data of
Tag 0C0T. -/
structure ChartData (f : X ⟶ Y) (V : Y.Opens) (L : X.Modules) where
  /-- The chart around a point of the target. -/
  chart : Y → Y.Opens
  /-- Each chart contains the point it is indexed by, so the charts cover. -/
  mem_chart : ∀ y, y ∈ chart y
  /-- Two distinct charts meet only inside `V`. -/
  inf_chart_le : ∀ y z, y ≠ z → chart y ⊓ chart z ≤ V
  /-- A generator of `L` over the inverse image of each chart. -/
  generator : ∀ y, GeneratorSections X.toRingedSpace L (f ⁻¹ᵁ chart y)

/-- Chart data exist as soon as `L` is trivial above some neighbourhood of every point of the
target. -/
theorem nonempty_chartData_of_hasTrivializingTargetCover (f : X ⟶ Y) (V : Y.Opens)
    [DiscreteTopology (Vᶜ : Set Y)] (L : X.Modules)
    (hL : Stacks.Divisors.HasTrivializingTargetCover f L) :
    Nonempty (ChartData f V L) := by
  choose W hmem hsep htriv using exists_separated_chart_of_hasTrivializingTargetCover f V L hL
  refine ⟨⟨W, hmem, ?_, fun y => Stacks.Divisors.normChartSourceGenerator f L ⟨W y, htriv y⟩⟩⟩
  intro y z hyz p hp
  rcases eq_or_ne p y with rfl | hpy
  · exact hsep z p hp.2 fun hc => hyz (hc ▸ rfl)
  · exact hsep y p hp.1 hpy

/-- Chart data exist for a finite morphism `f`, an open `V` with discrete complement, and an
invertible module `L`. -/
theorem nonempty_chartData (f : X ⟶ Y) [IsFinite f] (V : Y.Opens)
    [DiscreteTopology (Vᶜ : Set Y)] (L : X.Modules)
    [IsInvertible X.presheaf (structureSheafRing X.toRingedSpace).property L] :
    Nonempty (ChartData f V L) :=
  nonempty_chartData_of_hasTrivializingTargetCover f V L
    (Stacks.Divisors.hasTrivializingTargetCover_of_isFinite f L)

/-- The charts cover the target. -/
theorem ChartData.cover {f : X ⟶ Y} {V : Y.Opens} {L : X.Modules} (D : ChartData f V L) :
    (⊤ : Y.Opens) ≤ ⨆ y, D.chart y :=
  fun y _ => Opens.mem_iSup.2 ⟨y, D.mem_chart y⟩

/-- Two charts containing an open not contained in `V` are the same chart. -/
theorem ChartData.eq_of_not_le {f : X ⟶ Y} {V : Y.Opens} {L : X.Modules} (D : ChartData f V L)
    {i j : Y} {A : Y.Opens} (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) (h : ¬ A ≤ V) : i = j := by
  by_contra hij
  exact h ((le_inf hi hj).trans (D.inf_chart_le i j hij))

variable {f : X ⟶ Y} {V : Y.Opens} {L : X.Modules}

/-! ### The transition cocycle on the target -/

/-- The transition unit of two chart generators, upstairs. -/
noncomputable def ChartData.ratio (D : ChartData f V L) (i j : Y) (A : Y.Opens)
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) : (Γ(X, f ⁻¹ᵁ A))ˣ :=
  generatorRatioUnit (X := X.toRingedSpace) L (f ⁻¹ᵁ A)
    (generatorRestrict (X := X.toRingedSpace) L
      ((Opens.map f.base).map (homOfLE hj)).le (D.generator j))
    (generatorRestrict (X := X.toRingedSpace) L
      ((Opens.map f.base).map (homOfLE hi)).le (D.generator i))

/-- The ratio of a chart generator with itself is one. -/
theorem ChartData.ratio_self (D : ChartData f V L) (i : Y) (A : Y.Opens)
    (hi hj : A ≤ D.chart i) : D.ratio i i A hi hj = 1 :=
  generatorRatioUnit_self (X := X.toRingedSpace) L (f ⁻¹ᵁ A) _

/-- Exchanging the two charts inverts the ratio. -/
theorem ChartData.ratio_symm (D : ChartData f V L) (i j : Y) (A : Y.Opens)
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) :
    D.ratio j i A hj hi = (D.ratio i j A hi hj)⁻¹ :=
  generatorRatioUnit_symm (X := X.toRingedSpace) L (f ⁻¹ᵁ A) _ _

/-- The ratios of chart generators are multiplicative over three charts. -/
theorem ChartData.ratio_comp (D : ChartData f V L) (i j k : Y) (A : Y.Opens)
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) (hk : A ≤ D.chart k) :
    D.ratio i j A hi hj * D.ratio j k A hj hk = D.ratio i k A hi hk :=
  generatorRatioUnit_comp (X := X.toRingedSpace) L (f ⁻¹ᵁ A) _ _ _

/-- The ratio over a smaller open is the restriction of the ratio. -/
theorem ChartData.ratio_restrict (D : ChartData f V L) (i j : Y) {A B : Y.Opens}
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) (h : B ≤ A) :
    D.ratio i j B (h.trans hi) (h.trans hj) =
      Units.map (X.presheaf.map ((Opens.map f.base).map (homOfLE h)).op).hom
        (D.ratio i j A hi hj) :=
  (congrArg₂ (generatorRatioUnit (X := X.toRingedSpace) L (f ⁻¹ᵁ B))
      (generatorRestrict_trans (X := X.toRingedSpace) L
        ((Opens.map f.base).map (homOfLE hj)).le
        ((Opens.map f.base).map (homOfLE h)).le (D.generator j)).symm
      (generatorRestrict_trans (X := X.toRingedSpace) L
        ((Opens.map f.base).map (homOfLE hi)).le
        ((Opens.map f.base).map (homOfLE h)).le (D.generator i)).symm).trans
    (generatorRatioUnit_restrict (X := X.toRingedSpace) L
      ((Opens.map f.base).map (homOfLE h)).le _ _)

section DescendOfIsIsoApp
variable [Fact (∀ W : Y.Opens, W ≤ V → IsIso (f.app W))]

open Classical in
/-- The descended transition unit: the ratio of the chart generators upstairs, pushed down
through the inverse of `f.app` over opens inside `V`. Two distinct charts meet inside `V`, so
the descent is available; on the diagonal the transition is one. -/
noncomputable def ChartData.transitionOfIsIsoApp (D : ChartData f V L) (i j : Y) (A : Y.Opens)
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) : (Γ(Y, A))ˣ :=
  if h : A ≤ V then descendUnitOfIsIsoApp f h (D.ratio i j A hi hj) else 1

open Classical in
/-- Over an open inside `V`, the transition unit is the descended ratio. -/
theorem ChartData.transitionOfIsIsoApp_of_le (D : ChartData f V L) (i j : Y) (A : Y.Opens)
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) (h : A ≤ V) :
    D.transitionOfIsIsoApp i j A hi hj = descendUnitOfIsIsoApp f h (D.ratio i j A hi hj) :=
  dite_eq_left h

open Classical in
/-- Over an open not inside `V`, the transition unit is one. -/
theorem ChartData.transitionOfIsIsoApp_of_not_le (D : ChartData f V L) (i j : Y) (A : Y.Opens)
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) (h : ¬ A ≤ V) :
    D.transitionOfIsIsoApp i j A hi hj = 1 :=
  dite_eq_right h

/-- The transition unit from a chart to itself is one. -/
theorem ChartData.transitionOfIsIsoApp_self (D : ChartData f V L) (i : Y) (A : Y.Opens)
    (hi hj : A ≤ D.chart i) : D.transitionOfIsIsoApp i i A hi hj = 1 := by
  by_cases h : A ≤ V
  · rw [D.transitionOfIsIsoApp_of_le i i A hi hj h, D.ratio_self i A hi hj, map_one]
  · exact D.transitionOfIsIsoApp_of_not_le i i A hi hj h

/-- Exchanging the two charts inverts the transition unit. -/
theorem ChartData.transitionOfIsIsoApp_symm (D : ChartData f V L) (i j : Y) (A : Y.Opens)
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) :
    D.transitionOfIsIsoApp j i A hj hi = (D.transitionOfIsIsoApp i j A hi hj)⁻¹ := by
  by_cases h : A ≤ V
  · rw [D.transitionOfIsIsoApp_of_le j i A hj hi h, D.transitionOfIsIsoApp_of_le i j A hi hj h,
      D.ratio_symm i j A hi hj, map_inv]
  · obtain rfl := D.eq_of_not_le hi hj h
    rw [D.transitionOfIsIsoApp_self i A hj hi, inv_one]

/-- The transition units satisfy the cocycle condition. -/
theorem ChartData.transitionOfIsIsoApp_cocycle (D : ChartData f V L) (i j k : Y) (A : Y.Opens)
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) (hk : A ≤ D.chart k) :
    D.transitionOfIsIsoApp j k A hj hk * D.transitionOfIsIsoApp i j A hi hj =
      D.transitionOfIsIsoApp i k A hi hk := by
  by_cases h : A ≤ V
  · rw [D.transitionOfIsIsoApp_of_le j k A hj hk h, D.transitionOfIsIsoApp_of_le i j A hi hj h,
      D.transitionOfIsIsoApp_of_le i k A hi hk h, ← map_mul, mul_comm,
      D.ratio_comp i j k A hi hj hk]
  · obtain rfl := D.eq_of_not_le hi hj h
    obtain rfl := D.eq_of_not_le hj hk h
    rw [D.transitionOfIsIsoApp_self i A hj hk, one_mul]

/-- The transition unit over a smaller open is the restriction of the transition unit. -/
theorem ChartData.transitionOfIsIsoApp_restrict (D : ChartData f V L) (i j : Y) {A B : Y.Opens}
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) (h : B ≤ A) :
    Units.map (Y.presheaf.map (homOfLE h).op).hom (D.transitionOfIsIsoApp i j A hi hj) =
      D.transitionOfIsIsoApp i j B (h.trans hi) (h.trans hj) := by
  by_cases hA : A ≤ V
  · rw [D.transitionOfIsIsoApp_of_le i j A hi hj hA,
      D.transitionOfIsIsoApp_of_le i j B (h.trans hi) (h.trans hj) (h.trans hA),
      D.ratio_restrict i j hi hj h, descendUnitOfIsIsoApp_naturality f hA h]
  · obtain rfl := D.eq_of_not_le hi hj hA
    rw [D.transitionOfIsIsoApp_self i A hi hj,
      D.transitionOfIsIsoApp_self i B (h.trans hi) (h.trans hj), map_one]

/-- The descended transition units form a unit cocycle on the target. -/
noncomputable def ChartData.transitionCocycleOfIsIsoApp (D : ChartData f V L) :
    UnitTransitionCocycle Y.toRingedSpace D.chart where
  transition i j A hi hj := D.transitionOfIsIsoApp i j A hi hj
  restrict hi hj h := D.transitionOfIsIsoApp_restrict _ _ hi hj h
  symm i j A hi hj := D.transitionOfIsIsoApp_symm i j A hi hj
  cocycle i j k A hi hj hk := D.transitionOfIsIsoApp_cocycle i j k A hi hj hk

end DescendOfIsIsoApp

section Descend
variable [IsIso (f ∣_ V)]

open Classical in
/-- The descended transition unit: the ratio of the chart generators upstairs, pushed down
through the isomorphism over `V`. Two distinct charts meet inside `V`, so the descent is
available; on the diagonal the transition is one. -/
noncomputable def ChartData.transition (D : ChartData f V L) (i j : Y) (A : Y.Opens)
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) : (Γ(Y, A))ˣ :=
  D.transitionOfIsIsoApp i j A hi hj

open Classical in
/-- Over an open inside `V`, the transition unit is the descended ratio. -/
theorem ChartData.transition_of_le (D : ChartData f V L) (i j : Y) (A : Y.Opens)
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) (h : A ≤ V) :
    D.transition i j A hi hj = descendUnit f h (D.ratio i j A hi hj) :=
  D.transitionOfIsIsoApp_of_le i j A hi hj h

open Classical in
/-- Over an open not inside `V`, the transition unit is one. -/
theorem ChartData.transition_of_not_le (D : ChartData f V L) (i j : Y) (A : Y.Opens)
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) (h : ¬ A ≤ V) :
    D.transition i j A hi hj = 1 :=
  D.transitionOfIsIsoApp_of_not_le i j A hi hj h

/-- The transition unit from a chart to itself is one. -/
theorem ChartData.transition_self (D : ChartData f V L) (i : Y) (A : Y.Opens)
    (hi hj : A ≤ D.chart i) : D.transition i i A hi hj = 1 :=
  D.transitionOfIsIsoApp_self i A hi hj

end Descend

section Descend
variable [IsIso (f ∣_ V)]

/-- Exchanging the two charts inverts the transition unit. -/
theorem ChartData.transition_symm (D : ChartData f V L) (i j : Y) (A : Y.Opens)
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) :
    D.transition j i A hj hi = (D.transition i j A hi hj)⁻¹ :=
  D.transitionOfIsIsoApp_symm i j A hi hj

/-- The transition units satisfy the cocycle condition. -/
theorem ChartData.transition_cocycle (D : ChartData f V L) (i j k : Y) (A : Y.Opens)
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) (hk : A ≤ D.chart k) :
    D.transition j k A hj hk * D.transition i j A hi hj = D.transition i k A hi hk :=
  D.transitionOfIsIsoApp_cocycle i j k A hi hj hk

/-- The transition unit over a smaller open is the restriction of the transition unit. -/
theorem ChartData.transition_restrict (D : ChartData f V L) (i j : Y) {A B : Y.Opens}
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) (h : B ≤ A) :
    Units.map (Y.presheaf.map (homOfLE h).op).hom (D.transition i j A hi hj) =
      D.transition i j B (h.trans hi) (h.trans hj) :=
  D.transitionOfIsIsoApp_restrict i j hi hj h

/-- The descended transition units form a unit cocycle on the target. -/
noncomputable def ChartData.transitionCocycle (D : ChartData f V L) :
    UnitTransitionCocycle Y.toRingedSpace D.chart :=
  D.transitionCocycleOfIsIsoApp

end Descend

/-! ### Morphisms of presheaves of modules, and bijectivity on a cover -/

/-- A morphism of presheaves of modules assembled from a family of additive, semilinear maps
compatible with restriction. The family is given at the presheaves' own objects, so no
instance search over the two spellings of the section ring is involved. -/
noncomputable def presheafHomOfFamily {C : Type*} [Category C] {R : Cᵒᵖ ⥤ RingCat.{u}}
    (M N : PresheafOfModules.{u} R) (g : ∀ A : Cᵒᵖ, M.obj A → N.obj A)
    (hadd : ∀ (A : Cᵒᵖ) (s t : M.obj A), g A (s + t) = g A s + g A t)
    (hsmul : ∀ (A : Cᵒᵖ) (r : R.obj A) (s : M.obj A), g A (r • s) = r • g A s)
    (hnat : ∀ {A B : Cᵒᵖ} (i : A ⟶ B) (s : M.obj A), g B (M.map i s) = N.map i (g A s)) :
    M ⟶ N where
  app A := ModuleCat.ofHom { toFun := g A, map_add' := hadd A, map_smul' := hsmul A }
  naturality i := ModuleCat.hom_ext (LinearMap.ext fun s => hnat i s)

/-- A sheaf of modules on a scheme, read as a sheaf of sets. -/
noncomputable def typeSheafOfModules {Z : Scheme.{u}} (M : Z.Modules) :
    TopCat.Sheaf (Type u) Z.toPresheafedSpace :=
  ⟨M.val.presheaf ⋙ forget AddCommGrpCat,
    (TopCat.Presheaf.isSheaf_iff_isSheaf_comp (forget AddCommGrpCat) M.val.presheaf).mp
      (SheafOfModules.isSheaf M)⟩

private theorem smul_of_add {R S : Type*} [CommRing R] [Ring S] {M : Type*}
    [AddCommGroup M] [Module S M] (φ : R →+* S) (a b c : R) (hc : c = a + b) (g : M) :
    φ c • g = φ a • g + φ b • g := by
  rw [hc, map_add, add_smul]

private theorem smul_of_mul {R S : Type*} [CommRing R] [Ring S] {M : Type*}
    [AddCommGroup M] [Module S M] (φ : R →+* S) (a b c : R) (hc : c = a * b) (g : M) :
    φ c • g = φ a • (φ b • g) := by
  rw [hc, map_mul, mul_smul]

private theorem smul_eq_smul_of_mul_eq {R S : Type*} [CommRing R] [Ring S] {M : Type*}
    [AddCommGroup M] [Module S M] (φ : R →+* S) (c u x : R) (g g' : M)
    (hg : g' = φ u • g) (hx : x = u * c) : φ c • g' = φ x • g := by
  rw [hg, hx, smul_smul, ← map_mul, mul_comm c u]

private theorem bijective_of_generators {R : Type*} [CommRing R] {M N : Type*}
    [AddCommGroup M] [Module R M] [AddCommGroup N] [Module R N]
    (b : M) (hb : Function.Bijective fun c : R => c • b)
    (t : N) (ht : Function.Bijective fun c : R => c • t)
    (g : M → N) (hg : ∀ (c : R) (x : M), g (c • x) = c • g x)
    (hsurj : Function.Surjective g) : Function.Bijective g := by
  obtain ⟨lam, hlam⟩ := ht.surjective (g b)
  obtain ⟨c₀, hc₀⟩ := hsurj t
  obtain ⟨d, hd⟩ := hb.surjective c₀
  have hlam' : lam • t = g b := hlam
  have hd' : d • b = c₀ := hd
  have hu : d * lam = 1 := by
    refine ht.injective (show (d * lam) • t = (1 : R) • t from ?_)
    rw [mul_smul, hlam', ← hg, hd', hc₀, one_smul]
  refine ⟨fun x y hxy => ?_, hsurj⟩
  obtain ⟨cx, hcx⟩ := hb.surjective x
  obtain ⟨cy, hcy⟩ := hb.surjective y
  have hcx' : cx • b = x := hcx
  have hcy' : cy • b = y := hcy
  rw [← hcx', ← hcy'] at hxy ⊢
  rw [hg, hg, ← hlam', smul_smul, smul_smul] at hxy
  have h := ht.injective hxy
  have e1 : cx * (lam * d) = cy * (lam * d) := by rw [← mul_assoc, ← mul_assoc, h]
  rw [mul_comm lam d, hu, mul_one, mul_one] at e1
  rw [e1]

/-- **A morphism out of an invertible module which hits a local generator over each member of
an open cover is bijective on the sections over every open.** Over an open on which both
modules are free of rank one the morphism is multiplication by a scalar, which surjectivity
forces to be a unit; the sheaf condition propagates bijectivity to every open. -/
theorem bijective_app_of_generator_images {Z : Scheme.{u}}
    {N M : _root_.SheafOfModules.{u} (structureSheafRing Z.toRingedSpace)}
    [IsInvertible Z.presheaf (structureSheafRing Z.toRingedSpace).property N]
    (φ : N ⟶ M) {ι : Type u} (K : ι → Z.Opens) (hK : (⨆ i, K i) = ⊤)
    (gen : ∀ i, GeneratorSections Z.toRingedSpace M (K i))
    (hτ : ∀ i, ∃ τ : N.val.obj (op (K i)), φ.val.app (op (K i)) τ = (gen i).val)
    (A : Z.Opens) : Function.Bijective (φ.val.app (op A)).hom := by
  classical
  have hlocal : ∀ x : Z.toRingedSpace.carrier, IsLocalRing (ringStalk Z.toRingedSpace x) :=
    Z.isLocalRing
  choose P hxP b hb using
    Stacks.SheafOfModules.exists_bijective_smul_of_isInvertible (X := Z.toRingedSpace) N
  refine bijective_app_of_bijective_on_cover φ (fun p : ι × Z.carrier => K p.1 ⊓ P p.2) ?_ ?_ A
  · refine IsOpenCover.mk (top_le_iff.1 fun x _ => ?_)
    have hx : x ∈ (⨆ i, K i) := by rw [hK]; exact Opens.mem_top x
    obtain ⟨i, hi⟩ := Opens.mem_iSup.1 hx
    exact Opens.mem_iSup.2 ⟨(i, x), ⟨hi, hxP x⟩⟩
  · rintro ⟨i, x⟩ B hB
    obtain ⟨τ, hτi⟩ := hτ i
    have hBK : B ≤ K i := hB.trans inf_le_left
    have hBP : B ≤ P x := hB.trans inf_le_right
    have hbB : Function.Bijective (fun c : Z.presheaf.obj (op B) =>
        c • N.val.restrictₛₗ (homOfLE hBP).op (b x)) := hb x B hBP
    have htB : Function.Bijective (fun c : Z.presheaf.obj (op B) =>
        c • M.val.restrictₛₗ (homOfLE hBK).op (gen i).val) := (gen i).property B hBK
    refine bijective_of_generators _ hbB _ htB (φ.val.app (op B)).hom
      (fun c y => (φ.val.app (op B)).hom.map_smul c y) ?_
    intro y
    obtain ⟨c, hc⟩ := htB.surjective y
    have hc' : c • M.val.restrictₛₗ (homOfLE hBK).op (gen i).val = y := hc
    refine ⟨c • N.val.restrictₛₗ (homOfLE hBK).op τ, ?_⟩
    rw [(φ.val.app (op B)).hom.map_smul,
      show (φ.val.app (op B)).hom (N.val.restrictₛₗ (homOfLE hBK).op τ) =
          M.val.restrictₛₗ (homOfLE hBK).op ((φ.val.app (op (K i))).hom τ) from
        PresheafOfModules.naturality_apply φ.val (homOfLE hBK).op τ,
      hτi, hc']

/-! ### Pulling sections back along `f` -/

/-- Pulling a section of the structure sheaf back along `f`, as a ring map into the section
ring in the spelling that acts on modules. -/
noncomputable def pull (f : X ⟶ Y) (W : Y.Opens) :
    Γ(Y, W) →+* (structureSheaf X.sheaf).obj.obj (op (f ⁻¹ᵁ W)) := (f.app W).hom

/-- Pulling back along `f` commutes with restriction to a smaller open. -/
theorem pull_restrict (f : X ⟶ Y) {W W' : Y.Opens} (h : W' ≤ W) (c : Γ(Y, W)) :
    X.ringCatSheaf.obj.map ((Opens.map f.base).map (homOfLE h)).op (pull f W c) =
      pull f W' (Y.presheaf.map (homOfLE h).op c) :=
  (congrArg (fun q => (CommRingCat.Hom.hom q) c) (f.naturality (homOfLE h).op)).symm

/-! ### Chart data with a lifted cocycle of transition units -/

/-- **Chart data together with a cocycle of transition units on the target.** A cover of `Y` by
charts, a generator of `L` over the inverse image of each chart, and a unit cocycle on those
charts whose transitions pull back along `f` to the ratios of those generators.

This is what the comparison with `L` needs, and all it needs. The hypothesis that makes Tag
0C0T's transition units available — that `f` is an isomorphism over an open containing every
overlap of two distinct charts, so that a ratio upstairs has a canonical descent — enters only
in producing the cocycle, which is `Stacks.PicFinite.ChartData.toLiftedChartData`. Any other
source of transition units lifting the ratios gives the same comparison, and in particular a
*chosen* lift, which is what a closed immersion with nilpotent ideal provides and what Tag 09NY
needs. -/
structure LiftedChartData (f : X ⟶ Y) (L : X.Modules) where
  /-- The chart around a point of the target. -/
  chart : Y → Y.Opens
  /-- Each chart contains the point it is indexed by, so the charts cover. -/
  mem_chart : ∀ y, y ∈ chart y
  /-- A generator of `L` over the inverse image of each chart. -/
  generator : ∀ y, GeneratorSections X.toRingedSpace L (f ⁻¹ᵁ chart y)
  /-- The transition units on the target. -/
  cocycle : UnitTransitionCocycle Y.toRingedSpace chart
  /-- Each transition unit pulls back to the ratio of the two chart generators. -/
  pull_transition : ∀ (i j : Y) (A : Y.Opens) (hi : A ≤ chart i) (hj : A ≤ chart j),
    pull f A (cocycle.transition i j A hi hj).val =
      generatorRatio (X := X.toRingedSpace) L (f ⁻¹ᵁ A)
        (generatorRestrict (X := X.toRingedSpace) L
          ((Opens.map f.base).map (homOfLE hj)).le (generator j))
        (generatorRestrict (X := X.toRingedSpace) L
          ((Opens.map f.base).map (homOfLE hi)).le (generator i))

namespace LiftedChartData

variable (D : LiftedChartData f L)

/-! ### The chart generators of `L` -/

/-- The chart generator of `L`, restricted to the preimage of a smaller open. -/
noncomputable def chartGen (i : Y) {W : Y.Opens} (hW : W ≤ D.chart i) :
    GeneratorSections X.toRingedSpace L (f ⁻¹ᵁ W) :=
  generatorRestrict (X := X.toRingedSpace) L
    ((Opens.map f.base).map (homOfLE hW)).le (D.generator i)

/-- Restricting a restricted chart generator to a smaller open gives the chart generator
restricted to that open. -/
theorem chartGen_restrict (i : Y) {W W' : Y.Opens} (hW : W ≤ D.chart i) (h : W' ≤ W) :
    L.val.map ((Opens.map f.base).map (homOfLE h)).op (D.chartGen i hW).val =
      (D.chartGen i (h.trans hW)).val :=
  congrArg Subtype.val (generatorRestrict_trans (X := X.toRingedSpace) L
    ((Opens.map f.base).map (homOfLE hW)).le ((Opens.map f.base).map (homOfLE h)).le
    (D.generator i))

/-- The transition units pull back to the ratios of the chart generators, in the `chartGen`
spelling. -/
theorem pull_transition_chartGen (i j : Y) (A : Y.Opens) (hi : A ≤ D.chart i)
    (hj : A ≤ D.chart j) :
    pull f A (D.cocycle.transition i j A hi hj).val =
      generatorRatio (X := X.toRingedSpace) L (f ⁻¹ᵁ A) (D.chartGen j hj) (D.chartGen i hi) :=
  D.pull_transition i j A hi hj

/-- The charts cover the target. -/
theorem cover : (⊤ : Y.Opens) ≤ ⨆ y, D.chart y :=
  fun y _ => Opens.mem_iSup.2 ⟨y, D.mem_chart y⟩

/-- The charts cover the target. -/
theorem chart_iSup : ⨆ y, D.chart y = ⊤ := top_le_iff.1 D.cover

/-- The preimages of the charts cover the source. -/
theorem preimage_chart_iSup : (⨆ i : Y, f ⁻¹ᵁ D.chart i) = ⊤ :=
  top_le_iff.1 fun x _ => Opens.mem_iSup.2 ⟨f.base x, D.mem_chart (f.base x)⟩

/-- **The lifted invertible module on the target.** -/
noncomputable def descend : Y.Modules := D.cocycle.glue

/-- The lifted module is invertible. -/
theorem isInvertible_descend :
    IsInvertible Y.presheaf (structureSheaf Y.sheaf).property D.descend :=
  D.cocycle.isInvertible_glue D.cover

/-- A transition from a chart to itself is one. This is the cocycle identity at `i = j = k`,
where it reads `t * t = t` in a group of units. -/
theorem transition_self (i : Y) (A : Y.Opens) (hi hj : A ≤ D.chart i) :
    D.cocycle.transition i i A hi hj = 1 :=
  right_eq_mul.mp (D.cocycle.cocycle i i i A hi hi hi).symm

/-- Sections of the pushforward of `L` agreeing on the chart cover are equal. -/
theorem ext_of_restrict_charts (W : Y.Opens)
    (x y : ((Scheme.Modules.pushforward f).obj L).val.obj (op W))
    (hxy : ∀ i, ((Scheme.Modules.pushforward f).obj L).val.map
          (homOfLE (inf_le_left : W ⊓ D.chart i ≤ W)).op x =
        ((Scheme.Modules.pushforward f).obj L).val.map
          (homOfLE (inf_le_left : W ⊓ D.chart i ≤ W)).op y) :
    x = y := by
  refine TopCat.Sheaf.eq_of_locally_eq'
    (typeSheafOfModules ((Scheme.Modules.pushforward f).obj L))
    (fun i => W ⊓ D.chart i) W (fun i => homOfLE inf_le_left) ?_ x y hxy
  have hc : W ⊓ (⨆ i, D.chart i) = ⨆ i, W ⊓ D.chart i := inf_iSup_eq W D.chart
  rw [D.chart_iSup, inf_top_eq] at hc
  exact hc ▸ le_refl _

/-- Two chart generators differ by the pullback of the transition unit. -/
theorem chartGen_eq_smul (i j : Y) (A : Y.Opens) (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) :
    (D.chartGen i hi).val =
      pull f A (D.cocycle.transition i j A hi hj).val • (D.chartGen j hj).val := by
  rw [D.pull_transition_chartGen i j A hi hj]
  exact generatorRatio_spec (X := X.toRingedSpace) L (f ⁻¹ᵁ A)
    (D.chartGen j hj) (D.chartGen i hi)

/-! ### The comparison with the pushforward -/

/-- The section of `L` determined by a compatible family of coordinates of
`LiftedChartData.descend` over an open inside a single chart: the `i`-th coordinate pulled
back, times the `i`-th chart generator. -/
noncomputable def localSection (i : Y) {W : Y.Opens} (hW : W ≤ D.chart i)
    (s : D.descend.val.obj (op W)) : L.val.obj (op (f ⁻¹ᵁ W)) :=
  pull f W (D.cocycle.chartLinearEquiv i hW s) • (D.chartGen i hW).val

/-- **The local sections agree on overlaps**, by the cocycle condition. -/
theorem localSection_eq (i j : Y) {A : Y.Opens} (hi : A ≤ D.chart i) (hj : A ≤ D.chart j)
    (s : D.descend.val.obj (op A)) : D.localSection i hi s = D.localSection j hj s :=
  smul_eq_smul_of_mul_eq (pull f A) (D.cocycle.chartLinearEquiv i hi s)
    (D.cocycle.transition i j A hi hj).val (D.cocycle.chartLinearEquiv j hj s)
    (D.chartGen j hj).val (D.chartGen i hi).val (D.chartGen_eq_smul i j A hi hj)
    (TopCat.Sheaf.GlueData.trans_sectionsEquiv D.cocycle.toGlueData i j hi hj s).symm

/-- `localSection` is additive. -/
theorem localSection_add (i : Y) {W : Y.Opens} (hW : W ≤ D.chart i)
    (s t : D.descend.val.obj (op W)) :
    D.localSection i hW (s + t) = D.localSection i hW s + D.localSection i hW t :=
  smul_of_add (pull f W) _ _ _
    ((D.cocycle.chartLinearEquiv i hW).map_add s t) (D.chartGen i hW).val

/-- `localSection` is semilinear along `pull f`. -/
theorem localSection_smul (i : Y) {W : Y.Opens} (hW : W ≤ D.chart i)
    (r : Y.ringCatSheaf.obj.obj (op W)) (s : D.descend.val.obj (op W)) :
    D.localSection i hW (r • s) = pull f W r • D.localSection i hW s :=
  smul_of_mul (pull f W) r _ _
    (((D.cocycle.chartLinearEquiv i hW).map_smul r s).trans (smul_eq_mul ..))
    (D.chartGen i hW).val

/-- `localSection` commutes with restriction to a smaller open. -/
theorem localSection_restrict (i : Y) {W W' : Y.Opens} (hW : W ≤ D.chart i) (h : W' ≤ W)
    (s : D.descend.val.obj (op W)) :
    L.val.map ((Opens.map f.base).map (homOfLE h)).op (D.localSection i hW s) =
      D.localSection i (h.trans hW) (D.descend.val.map (homOfLE h).op s) := by
  have key : L.val.map ((Opens.map f.base).map (homOfLE h)).op
        (pull f W (D.cocycle.chartLinearEquiv i hW s) • (D.chartGen i hW).val) =
      X.ringCatSheaf.obj.map ((Opens.map f.base).map (homOfLE h)).op
          (pull f W (D.cocycle.chartLinearEquiv i hW s)) •
        L.val.map ((Opens.map f.base).map (homOfLE h)).op (D.chartGen i hW).val :=
    PresheafOfModules.map_smul L.val _ _ _
  rw [pull_restrict f h, D.chartGen_restrict i hW h,
    ← D.cocycle.chartLinearEquiv_restrict i hW h s] at key
  exact key

/-- The chart comparison, as local data for gluing a map of sheaves of sets. -/
noncomputable def localHom (i : Y) :
    TopCat.Sheaf.LocalSheafHom (typeSheafOfModules D.descend)
      (typeSheafOfModules ((Scheme.Modules.pushforward f).obj L)) (D.chart i) where
  app _W hW s := D.localSection i hW s
  naturality _ _ hW _ j s := D.localSection_restrict i hW j.le s

/-- The glued comparison, as a map of sheaves of sets. -/
noncomputable def typeComparison :
    typeSheafOfModules D.descend ⟶
      typeSheafOfModules ((Scheme.Modules.pushforward f).obj L) :=
  (TopCat.Sheaf.existsUnique_hom_of_localHom D.chart D.chart_iSup _ _ D.localHom
    (fun i j _A hAi hAj => funext fun s => D.localSection_eq i j hAi hAj s)).choose

/-- Over an open inside a chart, the glued comparison is `localSection`. -/
theorem typeComparison_app (i : Y) (W : Y.Opens) (hW : W ≤ D.chart i)
    (s : D.descend.val.obj (op W)) :
    D.typeComparison.1.app (op W) s = D.localSection i hW s :=
  congrFun ((TopCat.Sheaf.existsUnique_hom_of_localHom D.chart D.chart_iSup _ _ D.localHom
    (fun i j _A hAi hAj => funext fun s => D.localSection_eq i j hAi hAj s)).choose_spec.1
      i W hW) s

/-- The glued comparison commutes with restriction. -/
theorem typeComparison_restrict {A B : (Y.Opens)ᵒᵖ} (j : A ⟶ B) (s : D.descend.val.obj A) :
    D.typeComparison.1.app B (D.descend.val.map j s) =
      ((Scheme.Modules.pushforward f).obj L).val.map j (D.typeComparison.1.app A s) :=
  NatTrans.naturality_apply D.typeComparison.1 j s

/-- The glued comparison, read as a map into the sections of the pushforward. -/
noncomputable def comparisonFun (A : (Y.Opens)ᵒᵖ) (s : D.descend.val.obj A) :
    ((Scheme.Modules.pushforward f).obj L).val.obj A :=
  D.typeComparison.1.app A s

/-- Over an open inside a chart, `comparisonFun` is `localSection`. -/
theorem comparisonFun_of_le (i : Y) (W : Y.Opens) (hW : W ≤ D.chart i)
    (s : D.descend.val.obj (op W)) : D.comparisonFun (op W) s = D.localSection i hW s :=
  D.typeComparison_app i W hW s

/-- `comparisonFun` commutes with restriction. -/
theorem comparisonFun_restrict {A B : (Y.Opens)ᵒᵖ} (j : A ⟶ B) (s : D.descend.val.obj A) :
    D.comparisonFun B (D.descend.val.map j s) =
      ((Scheme.Modules.pushforward f).obj L).val.map j (D.comparisonFun A s) :=
  D.typeComparison_restrict j s

/-- A section of the lifted module has the given image once its restrictions to the opens
`A ⊓ chart i` are sent by `localSection` to the restrictions of that image. -/
private theorem comparisonFun_eq_of_localSection (A : (Y.Opens)ᵒᵖ) (x : D.descend.val.obj A)
    (y : ((Scheme.Modules.pushforward f).obj L).val.obj A)
    (h : ∀ i, D.localSection i (inf_le_right : A.unop ⊓ D.chart i ≤ D.chart i)
        (D.descend.val.map (homOfLE (inf_le_left : A.unop ⊓ D.chart i ≤ A.unop)).op x) =
      ((Scheme.Modules.pushforward f).obj L).val.map
        (homOfLE (inf_le_left : A.unop ⊓ D.chart i ≤ A.unop)).op y) :
    D.comparisonFun A x = y := by
  refine D.ext_of_restrict_charts A.unop _ _ fun i => ?_
  rw [← D.comparisonFun_restrict]
  exact (D.comparisonFun_of_le i (A.unop ⊓ D.chart i) inf_le_right _).trans (h i)

/-- `comparisonFun` is additive. -/
theorem comparisonFun_add (A : (Y.Opens)ᵒᵖ) (s t : D.descend.val.obj A) :
    D.comparisonFun A (s + t) = D.comparisonFun A s + D.comparisonFun A t := by
  refine D.comparisonFun_eq_of_localSection A _ _ fun i => ?_
  erw [(D.descend.val.map _).hom.map_add, D.localSection_add,
    (((Scheme.Modules.pushforward f).obj L).val.map _).hom.map_add,
    ← D.comparisonFun_restrict, ← D.comparisonFun_restrict,
    D.comparisonFun_of_le i (A.unop ⊓ D.chart i) inf_le_right,
    D.comparisonFun_of_le i (A.unop ⊓ D.chart i) inf_le_right]
  rfl

/-- `comparisonFun` is semilinear over the structure sheaf of `Y`. -/
theorem comparisonFun_smul (A : (Y.Opens)ᵒᵖ) (r : Y.ringCatSheaf.obj.obj A)
    (s : D.descend.val.obj A) : D.comparisonFun A (r • s) = r • D.comparisonFun A s := by
  refine D.comparisonFun_eq_of_localSection A _ _ fun i => ?_
  erw [PresheafOfModules.map_smul, D.localSection_smul,
    PresheafOfModules.map_smul ((Scheme.Modules.pushforward f).obj L).val,
    ← D.comparisonFun_restrict, D.comparisonFun_of_le i (A.unop ⊓ D.chart i) inf_le_right]
  rfl

/-- **The comparison morphism from the lifted module to the pushforward of `L`.** -/
noncomputable def pushforwardComparison :
    D.descend ⟶ (Scheme.Modules.pushforward f).obj L :=
  ⟨presheafHomOfFamily D.descend.val ((Scheme.Modules.pushforward f).obj L).val
    D.comparisonFun D.comparisonFun_add D.comparisonFun_smul
    fun {_ _} j s => D.comparisonFun_restrict j s⟩

/-- The comparison sends the chart section of the `i`-th chart to the `i`-th chart generator. -/
theorem pushforwardComparison_chartSection (i : Y) :
    D.pushforwardComparison.val.app (op (D.chart i)) (D.cocycle.chartSection i) =
      (D.chartGen i le_rfl).val := by
  have h1 : (D.cocycle.chartSection i).val i = (1 : Γ(Y, D.chart i ⊓ D.chart i)) :=
    congrArg Units.val (D.transition_self i (D.chart i ⊓ D.chart i) inf_le_left inf_le_right)
  have h2 : D.cocycle.chartLinearEquiv i (le_refl (D.chart i)) (D.cocycle.chartSection i) = 1 := by
    rw [show D.cocycle.chartLinearEquiv i (le_refl (D.chart i)) (D.cocycle.chartSection i) =
        Y.presheaf.map (homOfLE (le_inf le_rfl (le_refl (D.chart i)))).op
          ((D.cocycle.chartSection i).val i) from rfl, h1, map_one]
  refine (D.comparisonFun_of_le i (D.chart i) le_rfl (D.cocycle.chartSection i)).trans ?_
  change pull f (D.chart i) (D.cocycle.chartLinearEquiv i le_rfl
    (D.cocycle.chartSection i)) • (D.chartGen i le_rfl).val = _
  rw [h2, map_one, one_smul]

/-- The adjunct of the comparison: a morphism from the pullback of the lifted module. -/
noncomputable def pullbackComparison : (Scheme.Modules.pullback f).obj D.descend ⟶ L :=
  ((Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv D.descend L).symm
    D.pushforwardComparison

/-- The adjunct of the comparison, composed with the unit of the adjunction, is the
comparison. -/
theorem pullbackComparison_unit (U : Y.Opens) (a : D.descend.val.obj (op U)) :
    D.pullbackComparison.val.app (op (f ⁻¹ᵁ U))
        (((Scheme.Modules.pullbackPushforwardAdjunction f).unit.app
          D.descend).val.app (op U) a) =
      D.pushforwardComparison.val.app (op U) a := by
  have h := Adjunction.homEquiv_unit (adj := Scheme.Modules.pullbackPushforwardAdjunction f)
    (f := D.pullbackComparison)
  have h2 : (Scheme.Modules.pullbackPushforwardAdjunction f).homEquiv D.descend L
      D.pullbackComparison = D.pushforwardComparison := Equiv.apply_symm_apply _ _
  exact congrArg (fun q => q.val.app (op U) a) (h.symm.trans h2)

/-- The adjunct of the comparison is an isomorphism. -/
theorem isIso_pullbackComparison : IsIso D.pullbackComparison := by
  have hdesc : IsInvertible Y.presheaf (structureSheafRing Y.toRingedSpace).property D.descend :=
    D.isInvertible_descend
  have : IsInvertible X.presheaf (structureSheafRing X.toRingedSpace).property
      ((Scheme.Modules.pullback f).obj D.descend) :=
    Stacks.Modules.isInvertible_pullback f D.descend
  have hτ : ∀ i : Y, ∃ τ : ((Scheme.Modules.pullback f).obj D.descend).val.obj
        (op (f ⁻¹ᵁ D.chart i)),
      D.pullbackComparison.val.app (op (f ⁻¹ᵁ D.chart i)) τ = (D.chartGen i le_rfl).val :=
    fun i => ⟨_, (D.pullbackComparison_unit (D.chart i)
      (D.cocycle.chartSection i)).trans (D.pushforwardComparison_chartSection i)⟩
  refine Scheme.Modules.Hom.isIso_iff_isIso_app.mpr fun A => ?_
  exact (ConcreteCategory.isIso_iff_bijective (D.pullbackComparison.app A)).mpr
    (bijective_app_of_generator_images D.pullbackComparison _ D.preimage_chart_iSup
      (fun i => D.chartGen i le_rfl) hτ A)

/-- **The pullback of the lifted module is `L`.** -/
noncomputable def pullbackIso : (Scheme.Modules.pullback f).obj D.descend ≅ L :=
  haveI := D.isIso_pullbackComparison
  asIso D.pullbackComparison

end LiftedChartData

/-! ### Tag 0C0T's chart data, read as lifted chart data -/

section ComparisonOfIsIsoApp
variable [Fact (∀ W : Y.Opens, W ≤ V → IsIso (f.app W))]

/-- The descended transition unit pulls back to the ratio of the two chart generators. -/
theorem ChartData.pull_transitionOfIsIsoApp_val (D : ChartData f V L) (i j : Y) (A : Y.Opens)
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) :
    pull f A (D.transitionOfIsIsoApp i j A hi hj).val =
      generatorRatio (X := X.toRingedSpace) L (f ⁻¹ᵁ A)
        (generatorRestrict (X := X.toRingedSpace) L
          ((Opens.map f.base).map (homOfLE hj)).le (D.generator j))
        (generatorRestrict (X := X.toRingedSpace) L
          ((Opens.map f.base).map (homOfLE hi)).le (D.generator i)) := by
  have h : Units.map (f.app A).hom (D.transitionOfIsIsoApp i j A hi hj) = D.ratio i j A hi hj := by
    by_cases hV : A ≤ V
    · rw [D.transitionOfIsIsoApp_of_le i j A hi hj hV, map_descendUnitOfIsIsoApp f hV]
    · obtain rfl := D.eq_of_not_le hi hj hV
      rw [D.transitionOfIsIsoApp_self i A hi hj, D.ratio_self i A hi hj, map_one]
  exact (congrArg Units.val h).trans
    (generatorRatioUnit_val (X := X.toRingedSpace) L (f ⁻¹ᵁ A) _ _)

/-- **Chart data as lifted chart data, along a morphism invertible on sections over `V`.** The
transition units are the ratios of the chart generators descended through the inverse of
`f.app`, which is available because two distinct charts meet only inside `V`. -/
noncomputable def ChartData.toLiftedChartDataOfIsIsoApp (D : ChartData f V L) :
    LiftedChartData f L where
  chart := D.chart
  mem_chart := D.mem_chart
  generator := D.generator
  cocycle := D.transitionCocycleOfIsIsoApp
  pull_transition i j A hi hj := D.pull_transitionOfIsIsoApp_val i j A hi hj

end ComparisonOfIsIsoApp

section Comparison
variable [IsIso (f ∣_ V)]

/-- The descended transition unit pulls back to the ratio of the two chart generators. -/
theorem ChartData.pull_transition_val (D : ChartData f V L) (i j : Y) (A : Y.Opens)
    (hi : A ≤ D.chart i) (hj : A ≤ D.chart j) :
    pull f A (D.transition i j A hi hj).val =
      generatorRatio (X := X.toRingedSpace) L (f ⁻¹ᵁ A)
        (generatorRestrict (X := X.toRingedSpace) L
          ((Opens.map f.base).map (homOfLE hj)).le (D.generator j))
        (generatorRestrict (X := X.toRingedSpace) L
          ((Opens.map f.base).map (homOfLE hi)).le (D.generator i)) :=
  D.pull_transitionOfIsIsoApp_val i j A hi hj

/-- **Tag 0C0T's chart data as lifted chart data.** The transition units are the ratios of the
chart generators descended through the isomorphism over `V`, which is available because two
distinct charts meet only inside `V`. -/
noncomputable def ChartData.toLiftedChartData (D : ChartData f V L) : LiftedChartData f L :=
  D.toLiftedChartDataOfIsIsoApp

end Comparison

/-- **An invertible module descends along a morphism which is invertible on the sections over
every open inside `V`, with `Y \ V` discrete**, provided it is trivial above some neighbourhood
of every point of the target. This is the argument of [Stacks, Tag 0C0T] with finiteness of the
morphism used only through that trivializing cover ([Stacks, Tag 0BUT]), and with the
isomorphism over `V` used only through its effect on sections. For `V = Y` the hypothesis says
`f_* 𝒪_X = 𝒪_Y`, which is the case of [Stacks, Tag 0E24]. -/
theorem exists_isInvertible_modulePullback_iso_of_forall_isIso_app
    {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
    (V : Y.Opens) (hV : ∀ W : Y.Opens, W ≤ V → IsIso (f.app W))
    [DiscreteTopology (Vᶜ : Set Y)] (L : X.Modules)
    [IsInvertible X.presheaf (structureSheafRing X.toRingedSpace).property L]
    (hL : Stacks.Divisors.HasTrivializingTargetCover f L) :
    ∃ M : Y.Modules,
      IsInvertible Y.presheaf (structureSheafRing Y.toRingedSpace).property M ∧
        Nonempty ((AlgebraicGeometry.Scheme.Modules.pullback f).obj M ≅ L) := by
  have : Fact (∀ W : Y.Opens, W ≤ V → IsIso (f.app W)) := ⟨hV⟩
  obtain ⟨D⟩ := nonempty_chartData_of_hasTrivializingTargetCover f V L hL
  exact ⟨D.toLiftedChartDataOfIsIsoApp.descend, D.toLiftedChartDataOfIsIsoApp.isInvertible_descend,
    ⟨D.toLiftedChartDataOfIsIsoApp.pullbackIso⟩⟩

/-- **An invertible module descends along a morphism that is an isomorphism away from a
discrete closed subset**, provided it is trivial above some neighbourhood of every point of the
target. This is the argument of [Stacks, Tag 0C0T] with finiteness of the morphism used only
through that trivializing cover ([Stacks, Tag 0BUT]). -/
theorem exists_isInvertible_modulePullback_iso_of_hasTrivializingTargetCover
    {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y)
    (V : Y.Opens) [IsIso (f ∣_ V)] [DiscreteTopology (Vᶜ : Set Y)] (L : X.Modules)
    [IsInvertible X.presheaf (structureSheafRing X.toRingedSpace).property L]
    (hL : Stacks.Divisors.HasTrivializingTargetCover f L) :
    ∃ M : Y.Modules,
      IsInvertible Y.presheaf (structureSheafRing Y.toRingedSpace).property M ∧
        Nonempty ((AlgebraicGeometry.Scheme.Modules.pullback f).obj M ≅ L) :=
  exists_isInvertible_modulePullback_iso_of_forall_isIso_app f V
    (fun _ h => isIso_app_of_le f h) L hL

/-- **An invertible module descends along a finite morphism that is an isomorphism away
from a discrete closed subset.** -/
@[stacks 0C0T]
theorem exists_isInvertible_modulePullback_iso
    {X Y : AlgebraicGeometry.Scheme.{u}} (f : X ⟶ Y) [AlgebraicGeometry.IsFinite f]
    (V : Y.Opens) [IsIso (f ∣_ V)] [DiscreteTopology (Vᶜ : Set Y)]
    (L : X.Modules)
    (hL : AlgebraicGeometry.SheafOfModules.IsInvertible X.presheaf
      ((Presheaf.isSheaf_iff_isSheaf_comp _ X.presheaf
        (forget₂ CommRingCat RingCat)).mp X.IsSheaf) L) :
    ∃ M : Y.Modules,
      AlgebraicGeometry.SheafOfModules.IsInvertible Y.presheaf
          ((Presheaf.isSheaf_iff_isSheaf_comp _ Y.presheaf
            (forget₂ CommRingCat RingCat)).mp Y.IsSheaf) M ∧
        Nonempty ((AlgebraicGeometry.Scheme.Modules.pullback f).obj M ≅ L) := by
  have hL' : IsInvertible X.presheaf (structureSheafRing X.toRingedSpace).property L :=
    (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry X.presheaf _ L).mpr hL
  obtain ⟨D⟩ := nonempty_chartData f V L
  exact ⟨D.toLiftedChartData.descend,
    (Stacks.SheafOfModules.isInvertible_iff_algebraicGeometry Y.presheaf _ _).mp
      D.toLiftedChartData.isInvertible_descend,
    ⟨D.toLiftedChartData.pullbackIso⟩⟩

end Stacks.PicFinite

end
