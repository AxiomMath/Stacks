/-!
# The Artin--Rees step of the theorem on formal functions

Let `A` be a ring, `I ⊆ A` an ideal, `f : X ⟶ Spec A` a morphism of schemes, `ℱ` a sheaf of
modules on `X` and `p ≥ 0`. Write `𝓘 = I · 𝒪_X` for the ideal sheaf `I` generates on `X`.
[Stacks, Tag 02OB] produces a single integer `c ≥ 0` such that

1. `Ker(H^p(X, ℱ) → H^p(X, ℱ / 𝓘 ^ n ℱ)) ⊆ I ^ (n - c) · H^p(X, ℱ)` for `n ≥ c`;
2. the inverse system `n ↦ H^p(X, ℱ / 𝓘 ^ n ℱ)` satisfies the Mittag-Leffler condition;
3. for `k ≥ n + c`, the image of `H^p(X, ℱ / 𝓘 ^ k ℱ)` in `H^p(X, ℱ / 𝓘 ^ n ℱ)` is the image
   of `H^p(X, ℱ)`.

The whole of the source's input is [Stacks, Tag 02OA], applied in the two degrees `p` and
`p + 1`; the hypotheses `A` Noetherian, `f` proper and `ℱ` coherent are used for nothing else,
and are therefore not repeated here. [Stacks, Tag 02OA] is unavailable in this library — its
own input, [Stacks, Tag 02O8], reduces to the proper mapping theorem [Stacks, Tag 02O5] — so its
two relevant clauses are carried as the named hypotheses `h02OA_image` and `h02OA_kernel`.

Everything else is in place, and that is what this file is: the three clauses of
[Stacks, Tag 02OB] *given* [Stacks, Tag 02OA]. The geometric input is the short exact sequence
`0 → 𝓘 ^ n ℱ → ℱ → ℱ / 𝓘 ^ n ℱ → 0` and its long exact cohomology sequence, in the
`Γ(X, 𝒪_X)`-module spelling, from
`StacksFrontier/AlgebraicGeometry/FormalFunctions/IdealPowerCohomologySequence.lean`.

## Main definitions

* `Stacks.Cohomology.FormalFunctions.baseRingHom` — the ring map `A ⟶ Γ(X, 𝒪_X)` along which
  `A` acts on the cohomology of `X`.
* `Stacks.Cohomology.FormalFunctions.cohomologyOverBase` and `cohomologyOverBaseMap` —
  `H^p(X, ℱ)` and `H^p(X, φ)` as an `A`-module and an `A`-linear map.

## Main results

* `Stacks.Cohomology.FormalFunctions.exists_uniform_bound_cohomology_idealPowerQuotient` —
  the three clauses of [Stacks, Tag 02OB], granted [Stacks, Tag 02OA].

## Implementation notes

The source's `I ^ (n - c) H^p(X, ℱ)` is read as the `A`-submodule generated by the products,
not as the `Γ(X, 𝒪_X)`-submodule generated by the image of `I ^ (n - c)`; the latter is strictly
larger in general, so only the former is the source's statement. That is why the first clause is
stated after restriction of scalars, while the second and third — which mention no ideal — stay
at `Γ(X, 𝒪_X)`-modules, where the inverse system `adicQuotientSystem` and the long exact
sequence live.

`cohomologyOverBase` duplicates `Stacks.AlgebraicGeometry.FreenessOverDVR.cohomologyOver`, which
has no counterpart on morphisms and lives in a file about discrete valuation rings; the pair
here is restated rather than imported, and the two are definitionally equal.

Clause (2) is deduced from clause (3) exactly as the source does, through
`isMittagLefflerCategorical_of_range_eq_submodule`: the stabilized value of the images of the
transition maps of `adicQuotientSystem 𝓘 ℱ` under `H^p` is the image of `H^p(X, ℱ)`.

## References

* [Stacks Project, Tag 02OB](https://stacks.math.columbia.edu/tag/02OB)
* [Stacks Project, Tag 02OA](https://stacks.math.columbia.edu/tag/02OA)
* [Stacks Project, Tag 02N0](https://stacks.math.columbia.edu/tag/02N0)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

universe u

attribute [local instance] AlgebraicGeometry.Scheme.Modules.submoduleCompleteLattice

namespace Stacks.Cohomology.FormalFunctions

open Stacks.Cohomology.AffineBase Stacks.Algebraization

/-! ### Submodule inclusions and the adic tower -/

/-- Composing the inclusions of three nested submodules of a sheaf of modules. -/
public lemma submoduleInclusion_comp {X : Scheme.{u}} {F : X.Modules} {N₃ N₂ N₁ : F.Submodule}
    (h₃₂ : N₃ ≤ N₂) (h₂₁ : N₂ ≤ N₁) :
    submoduleInclusion h₃₂ ≫ submoduleInclusion h₂₁ = submoduleInclusion (h₃₂.trans h₂₁) :=
  (AlgebraicGeometry.Scheme.Modules.mono_submodule_ι N₁).right_cancellation _ _ <|
    (Category.assoc _ _ _).trans <|
      ((congrArg (submoduleInclusion h₃₂ ≫ ·) (submoduleInclusion_comp_ι h₂₁)).trans
        (submoduleInclusion_comp_ι h₃₂)).trans
          (submoduleInclusion_comp_ι (h₃₂.trans h₂₁)).symm

/-- The transition maps of `adicQuotientSystem` are the exponent-lowering maps
`idealPowerQuotientDrop`: both are determined by their compatibility with the quotient
projection, which is an epimorphism. -/
public lemma adicQuotientSystem_map_eq_idealPowerQuotientDrop {X : Scheme.{u}}
    (I : X.IdealSheafData) (F : X.Modules) {n k : ℕ} (h : n ≤ k) :
    (adicQuotientSystem I F).map (homOfLE h).op = idealPowerQuotientDrop I h F :=
  (cancel_epi (cokernel.π (C := X.Modules) (idealPowerMultiple I k F).ι)).1 <|
    (quotientMapOfLE_π (idealPowerMultiple_antitone I F h)).trans
      (idealPowerQuotientDrop_π I h F).symm

/-! ### Cohomology as a module over the base ring -/

variable (A : Type u) [CommRing A] {X : Scheme.{u}} (f : X ⟶ Spec (.of A))

/-- The ring map `A ⟶ Γ(X, 𝒪_X)` through which `A` acts on everything on `X`: the composite
`A ≅ Γ(Spec A, 𝒪) ⟶ Γ(X, 𝒪_X)`. This is the map `baseIdeal` pushes an ideal along. -/
public abbrev baseRingHom : A →+* Γ(X, ⊤) :=
  ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom

/-- `H^p(X, ℱ)` as an `A`-module, the action being restriction of scalars along
`baseRingHom`. -/
public abbrev cohomologyOverBase (p : ℕ) (F : X.Modules) : ModuleCat.{u} A :=
  (ModuleCat.restrictScalars (baseRingHom A f)).obj
    (((moduleGlobalSections X).rightDerived p).obj F)

/-- `H^p(X, φ)` as an `A`-linear map. -/
public abbrev cohomologyOverBaseMap (p : ℕ) {F G : X.Modules} (φ : F ⟶ G) :
    cohomologyOverBase A f p F ⟶ cohomologyOverBase A f p G :=
  (ModuleCat.restrictScalars (baseRingHom A f)).map
    (((moduleGlobalSections X).rightDerived p).map φ)

/-! ### The theorem -/

variable (I : Ideal A) (F : X.Modules) (p : ℕ)

/-- **Stacks Project, Tag 02OB**, granted [Stacks, Tag 02OA].

There is a single `c ≥ 0` such that, with `𝓘 = I · 𝒪_X`:

1. `Ker(H^p(X, ℱ) → H^p(X, ℱ / 𝓘 ^ n ℱ)) ⊆ I ^ (n - c) · H^p(X, ℱ)` for every `n ≥ c`;
2. the inverse system `n ↦ H^p(X, ℱ / 𝓘 ^ n ℱ)` satisfies the Mittag-Leffler condition;
3. for every `k ≥ n + c`, the image of `H^p(X, ℱ / 𝓘 ^ k ℱ)` in `H^p(X, ℱ / 𝓘 ^ n ℱ)` equals
   the image of `H^p(X, ℱ)`.

The two hypotheses are the clauses of [Stacks, Tag 02OA] that the source's proof uses, each
quantified over the degree because the proof applies them in degrees `p` and `p + 1` and takes
the larger of the two constants: `h02OA_image` is clause (2) of that lemma in the case `n = 0`,
and `h02OA_kernel` is its clause (3). The source's standing hypotheses — `A` Noetherian, `f`
proper and `ℱ` coherent — are what make [Stacks, Tag 02OA] true and are used nowhere else, so
they do not appear.

Clause (1) is the kernel-image identity of the long exact sequence of
`0 → 𝓘 ^ n ℱ → ℱ → ℱ / 𝓘 ^ n ℱ → 0` followed by `h02OA_image`. Clause (3) is the diagram chase
along the ladder of those sequences: naturality of the connecting map carries a class of
`H^p(X, ℱ / 𝓘 ^ k ℱ)` to one annihilated by the connecting map of the exponent-`n` sequence,
because `h02OA_kernel` in degree `p + 1` identifies the kernel of `H^(p+1)(𝓘 ^ k ℱ) → H^(p+1)(ℱ)`
with a kernel that `H^(p+1)(𝓘 ^ k ℱ) → H^(p+1)(𝓘 ^ n ℱ)` factors through. Clause (2) follows
from clause (3). -/
@[stacks 02OB "granted Tag 02OA, carried as the hypotheses h02OA_image and h02OA_kernel"]
public theorem exists_uniform_bound_cohomology_idealPowerQuotient
    (h02OA_image : ∀ q : ℕ, ∃ c : ℕ, ∀ k : ℕ, c ≤ k →
      LinearMap.range (cohomologyOverBaseMap A f q
          (idealPowerMultiple (baseIdealSheaf A I f) k F).ι).hom ≤
        I ^ (k - c) • (⊤ : Submodule A (cohomologyOverBase A f q F)))
    (h02OA_kernel : ∀ q : ℕ, ∃ c : ℕ, ∀ k : ℕ, c ≤ k →
      LinearMap.ker (((moduleGlobalSections X).rightDerived q).map
          (idealPowerMultiple (baseIdealSheaf A I f) k F).ι).hom =
        LinearMap.ker (((moduleGlobalSections X).rightDerived q).map
          (submoduleInclusion (idealPowerMultiple_antitone (baseIdealSheaf A I f) F
            (Nat.sub_le k c)))).hom) :
    ∃ c : ℕ,
      (∀ n : ℕ, c ≤ n →
          LinearMap.ker (cohomologyOverBaseMap A f p
              (cokernel.π (C := X.Modules)
                (idealPowerMultiple (baseIdealSheaf A I f) n F).ι)).hom ≤
            I ^ (n - c) • (⊤ : Submodule A (cohomologyOverBase A f p F))) ∧
        IsMittagLefflerCategorical
          (adicQuotientSystem (baseIdealSheaf A I f) F ⋙
            (moduleGlobalSections X).rightDerived p) ∧
        ∀ n k : ℕ, (hk : n + c ≤ k) →
          LinearMap.range (((moduleGlobalSections X).rightDerived p).map
              (idealPowerQuotientDrop (baseIdealSheaf A I f)
                ((Nat.le_add_right n c).trans hk) F)).hom =
            LinearMap.range (((moduleGlobalSections X).rightDerived p).map
              (cokernel.π (C := X.Modules)
                (idealPowerMultiple (baseIdealSheaf A I f) n F).ι)).hom := by
  classical
  obtain ⟨c₂, hc₂⟩ := h02OA_image p
  obtain ⟨c₃, hc₃⟩ := h02OA_kernel (p + 1)
  set 𝓘 := baseIdealSheaf A I f
  have apply_comp {M N P : ModuleCat.{u} Γ(X, ⊤)} {φ : M ⟶ N} {ψ : N ⟶ P} {χ : M ⟶ P}
      (e : φ ≫ ψ = χ) (x : M) : ψ.hom (φ.hom x) = χ.hom x :=
    LinearMap.congr_fun (ModuleCat.hom_ext_iff.1 e) x
  have key : ∀ n k : ℕ, ∀ hnk : n ≤ k, n + max c₂ c₃ ≤ k →
      LinearMap.range (((moduleGlobalSections X).rightDerived p).map
          (idealPowerQuotientDrop 𝓘 hnk F)).hom =
        LinearMap.range (((moduleGlobalSections X).rightDerived p).map
          (cokernel.π (C := X.Modules) (idealPowerMultiple 𝓘 n F).ι)).hom := by
    intro n k hnk hk
    have hn3 : n ≤ k - c₃ := by omega
    have hk3 : c₃ ≤ k := by omega
    refine le_antisymm ?_ ?_
    · intro y hy
      obtain ⟨x, rfl⟩ := LinearMap.mem_range.1 hy
      have hz : (idealPowerδ 𝓘 F k p).hom x ∈
          LinearMap.ker (((moduleGlobalSections X).rightDerived (p + 1)).map
            (idealPowerMultiple 𝓘 k F).ι).hom :=
        (exact_δ_cohomology_idealPowerMultiple 𝓘 F k p).apply_apply_eq_zero x
      rw [hc₃ k hk3, LinearMap.mem_ker] at hz
      have hfac : ((moduleGlobalSections X).rightDerived (p + 1)).map
            (submoduleInclusion (idealPowerMultiple_antitone 𝓘 F (Nat.sub_le k c₃))) ≫
          ((moduleGlobalSections X).rightDerived (p + 1)).map
            (submoduleInclusion (idealPowerMultiple_antitone 𝓘 F hn3)) =
          ((moduleGlobalSections X).rightDerived (p + 1)).map
            (submoduleInclusion (idealPowerMultiple_antitone 𝓘 F hnk)) :=
        (Functor.map_comp _ _ _).symm.trans
          (congrArg _ (submoduleInclusion_comp _ _))
      have hδ : (idealPowerδ 𝓘 F n p).hom
          ((((moduleGlobalSections X).rightDerived p).map
            (idealPowerQuotientDrop 𝓘 hnk F)).hom x) = 0 := by
        refine (apply_comp (idealPowerδ_naturality 𝓘 F p hnk) x).trans
          ((apply_comp hfac ((idealPowerδ 𝓘 F k p).hom x)).symm.trans ?_)
        rw [hz, map_zero]
      obtain ⟨w, hw⟩ := (exact_cohomology_idealPowerQuotient_δ 𝓘 F n p _).1 hδ
      exact LinearMap.mem_range.2 ⟨w, hw⟩
    · rw [← idealPowerQuotientDrop_π 𝓘 hnk F, Functor.map_comp, ModuleCat.hom_comp]
      exact LinearMap.range_comp_le_range _ _
  refine ⟨max c₂ c₃, ?_, ?_, fun n k hk =>
    key n k ((Nat.le_add_right n (max c₂ c₃)).trans hk) hk⟩
  · -- Clause (1).
    intro n hn x hx
    have hx' : x ∈ LinearMap.ker (((moduleGlobalSections X).rightDerived p).map
        (cokernel.π (C := X.Modules) (idealPowerMultiple 𝓘 n F).ι)).hom := hx
    rw [ker_cohomology_idealPowerQuotient_eq_range] at hx'
    have hmem : x ∈ LinearMap.range
        (cohomologyOverBaseMap A f p (idealPowerMultiple 𝓘 n F).ι).hom := hx'
    refine Submodule.smul_mono_left ?_
      (hc₂ n ((le_max_left c₂ c₃).trans hn) hmem)
    exact Ideal.pow_le_pow_right (Nat.sub_le_sub_left (le_max_left c₂ c₃) n)
  · -- Clause (2), from clause (3).
    refine isMittagLefflerCategorical_of_range_eq_submodule _ (fun i => i + max c₂ c₃)
      (fun i => Nat.le_add_right i _)
      (fun i => LinearMap.range (((moduleGlobalSections X).rightDerived p).map
        (cokernel.π (C := X.Modules) (idealPowerMultiple 𝓘 i F).ι)).hom) ?_
    intro i k hbi hik
    have h1 : (adicQuotientSystem 𝓘 F ⋙ (moduleGlobalSections X).rightDerived p).map
          (homOfLE hik).op =
        ((moduleGlobalSections X).rightDerived p).map (idealPowerQuotientDrop 𝓘 hik F) :=
      congrArg (((moduleGlobalSections X).rightDerived p).map)
        (adicQuotientSystem_map_eq_idealPowerQuotientDrop 𝓘 F hik)
    rw [h1]
    exact key i k hik hbi

end Stacks.Cohomology.FormalFunctions

end
