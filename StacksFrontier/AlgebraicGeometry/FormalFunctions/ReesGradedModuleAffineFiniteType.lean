module

public import StacksFrontier.AlgebraicGeometry.Blowup.ReesAlgebraFiniteType
public import StacksFrontier.AlgebraicGeometry.Blowup.ReesIdealPowerComparison
public import StacksFrontier.AlgebraicGeometry.Divisors.AssociatedPoints.Finiteness
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.CoherentAdicSystem.AssociatedGraded

/-!
# The graded module of ideal-power multiples is of finite type on every affine open

Let `X` be a scheme, `ℐ ⊆ 𝒪_X` a quasi-coherent sheaf of ideals and `F` a quasi-coherent
`𝒪_X`-module of finite type. `Stacks.Blowup.isFiniteType_reesGradedModule` already says that the
graded module `⨁ₙ ℐⁿF` over the Rees algebra `⨁ₙ ℐⁿ` is of finite type in the *sheaf-theoretic*
sense `SheafOfModules.GradedModule.IsFiniteType`: there is a covering family on each member of
which finitely many homogeneous sections generate, generation itself being local.

This file proves the *affine-local* form `Stacks.Coherent.IsFiniteTypeOnAffine`: over every
affine open `U` there is one finite set of homogeneous sections over `U` whose multiples by the
homogeneous sections of `⨁ₙ ℐⁿ` over `U` span, in every degree, the whole group of sections of
that degree over `U`. No covering and no sheafification is left in the conclusion.

## Main results

* `Stacks.Blowup.isFiniteTypeOnAffine_reesGradedModule`: **`⨁ₙ ℐⁿF` is of finite type on every
  affine open** when `F` is quasi-coherent of finite type.
* `Stacks.Blowup.isFiniteTypeOnAffine_reesGradedModule_of_isCoherent`: the same for `F`
  coherent, which is the hypothesis of [Stacks, Tag 02O8].

## References

* [Stacks Project, Tag 02O8](https://stacks.math.columbia.edu/tag/02O8)
* [Stacks Project, Tag 087Z](https://stacks.math.columbia.edu/tag/087Z)
* [Stacks Project, Tag 0897](https://stacks.math.columbia.edu/tag/0897)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

namespace Stacks.Blowup

universe u

variable {X : Scheme.{u}} (I : X.IdealSheafData) (F : X.Modules)

/-- Transporting a section of `⨁ₙ ℐⁿF` along an equality of degrees, in the `Eq.rec` form in
which `Stacks.Coherent.IsFiniteTypeOnAffine` writes it, does not change the underlying section
of `F`. -/
public lemma val_eqRec_reesGradedModule {d n : ℤ} (h : d = n) (U : (Opens X)ᵒᵖ)
    (z : ((reesGradedModule I F).piece d).val.obj U) :
    (h ▸ z : ((reesGradedModule I F).piece n).val.obj U).1 = z.1 := by
  subst h; rfl

/-- **The induction over `J · M`.** If every product of an element of the ideal `J` with one of a
family of generators of `M` lies in the subgroup of a submodule `N` generated by `S`, then so
does every element of `J · M`. -/
private theorem exists_mem_closure_of_mem_idealSmulTop {R M : Type*} [CommRing R]
    [AddCommGroup M] [Module R M] (J : Ideal R) (N : Submodule R M) (S : Set N)
    (G : Finset M) (hG : Submodule.span R (G : Set M) = ⊤)
    (hgen : ∀ b ∈ J, ∀ g ∈ G, ∃ hb : b • g ∈ N,
      (⟨b • g, hb⟩ : N) ∈ AddSubgroup.closure S)
    (y : M) (hy : y ∈ J • (⊤ : Submodule R M)) :
    ∃ hy' : y ∈ N, (⟨y, hy'⟩ : N) ∈ AddSubgroup.closure S := by
  refine Submodule.smul_induction_on
    (p := fun y => ∃ hy' : y ∈ N, (⟨y, hy'⟩ : N) ∈ AddSubgroup.closure S) hy ?_ ?_
  · intro r hr z _
    obtain ⟨c, -, hc⟩ := Submodule.mem_span_finset.1 (by rw [hG]; exact Submodule.mem_top (x := z))
    choose hb hmem using fun g (hg : g ∈ G) => hgen (r * c g) (Ideal.mul_mem_right _ _ hr) g hg
    have hsum : (∑ g ∈ G.attach, (⟨(r * c g.1) • g.1, hb g.1 g.2⟩ : N)).1 = r • z := by
      refine (AddSubmonoidClass.coe_finsetSum _ _).trans ?_
      refine Eq.trans (Finset.sum_congr rfl fun g _ => (smul_smul r (c g.1) g.1).symm) ?_
      rw [← Finset.smul_sum, Finset.sum_attach G fun g => c g • g, hc]
    refine ⟨hsum ▸ (∑ g ∈ G.attach, (⟨(r * c g.1) • g.1, hb g.1 g.2⟩ : N)).2, ?_⟩
    rw [show (⟨r • z, hsum ▸ (∑ g ∈ G.attach, (⟨(r * c g.1) • g.1, hb g.1 g.2⟩ : N)).2⟩ : N) =
        ∑ g ∈ G.attach, (⟨(r * c g.1) • g.1, hb g.1 g.2⟩ : N) from Subtype.ext hsum.symm]
    exact sum_mem fun g _ => hmem g.1 g.2
  · intro z z' hz hz'
    obtain ⟨h1, hm1⟩ := hz
    obtain ⟨h2, hm2⟩ := hz'
    refine ⟨Submodule.add_mem _ h1 h2, ?_⟩
    rw [show (⟨z + z', Submodule.add_mem _ h1 h2⟩ : N) = ⟨z, h1⟩ + ⟨z', h2⟩ from Subtype.ext rfl]
    exact add_mem hm1 hm2

/-- `exists_mem_closure_of_mem_idealSmulTop` with the membership proof supplied by the caller
rather than produced: the two subtype elements differ only in a proof, so they are the same. -/
private theorem mem_closure_of_mem_idealSmulTop {R M : Type*} [CommRing R]
    [AddCommGroup M] [Module R M] (J : Ideal R) (N : Submodule R M) (S : Set N)
    (G : Finset M) (hG : Submodule.span R (G : Set M) = ⊤)
    (hgen : ∀ b ∈ J, ∀ g ∈ G, ∃ hb : b • g ∈ N,
      (⟨b • g, hb⟩ : N) ∈ AddSubgroup.closure S)
    (y : M) (hy : y ∈ J • (⊤ : Submodule R M)) (hy' : y ∈ N) :
    (⟨y, hy'⟩ : N) ∈ AddSubgroup.closure S :=
  (exists_mem_closure_of_mem_idealSmulTop J N S G hG hgen y hy).choose_spec

/-- **`⨁ₙ ℐⁿF` is of finite type on every affine open** when `F` is quasi-coherent of finite
type: over an affine open `U` the generators of `Γ(F, U)`, read in degree zero, span every
homogeneous degree of `⨁ₙ ℐⁿF` over `U` under the action of the degree-`n` sections of `⨁ₙ ℐⁿ`
over `U`. -/
public theorem isFiniteTypeOnAffine_reesGradedModule [F.IsQuasicoherent] [F.IsFiniteType] :
    Stacks.Coherent.IsFiniteTypeOnAffine (reesGradedModule I F) := by
  classical
  intro U
  let : Module.Finite Γ(X, U.1) Γ(F, U.1) :=
    AlgebraicGeometry.moduleFinite_sections_on_affine F U.1 U.2
  obtain ⟨G, hG⟩ : (⊤ : Submodule Γ(X, U.1) Γ(F, U.1)).FG := Module.Finite.fg_top
  refine ⟨G.image fun g => ⟨(0 : ℤ), reesSectionZero I F g⟩, fun n => ?_⟩
  rcases lt_or_ge n 0 with hn | hn
  · have h0 : (reesMultiple I n F).toSubmodule.obj (op U.1) = ⊥ :=
      (congrArg (fun N : F.Submodule => N.toSubmodule.obj (op U.1))
        (reesMultiple_eq_bot_of_neg I n F hn)).trans
        (SheafOfModules.Submodule.bot_obj F (op U.1))
    refine (AddSubgroup.eq_top_iff' _).2 fun x => ?_
    rw [show x = 0 from Subtype.ext ((Submodule.eq_bot_iff _).1 h0 x.1 x.2)]
    exact zero_mem _
  obtain ⟨k, rfl⟩ := Int.eq_ofNat_of_zero_le hn
  have hsec : (reesMultiple I (k : ℤ) F).toSubmodule.obj (op U.1) =
      I.ideal U ^ k • (⊤ : Submodule Γ(X, U.1) Γ(F, U.1)) :=
    (congrArg (fun N : F.Submodule => N.toSubmodule.obj (op U.1))
      (reesMultiple_eq_idealPowerMultiple I F k)).trans
      (Stacks.Algebraization.idealPowerMultiple_toSubmodule_obj_affine I k F U)
  have hgen : ∀ b ∈ I.ideal U ^ k, ∀ g ∈ G,
      ∃ hb : b • g ∈ (reesMultiple I (k : ℤ) F).toSubmodule.obj (op U.1),
        (⟨b • g, hb⟩ : ((reesGradedModule I F).piece (k : ℤ)).val.obj (op U.1)) ∈
          AddSubgroup.closure
            { t : ((reesGradedModule I F).piece (k : ℤ)).val.obj (op U.1) |
              ∃ s : Σ d : ℤ, ((reesGradedModule I F).piece d).val.obj (op U.1),
                s ∈ G.image (fun g => ⟨(0 : ℤ), reesSectionZero I F g⟩) ∧
                  ∃ (m : ℤ) (a : ((reesGradedAlgebra I).piece m).val.obj (op U.1))
                    (h : s.1 + m = (k : ℤ)),
                    t = h ▸ (reesGradedModule I F).smul s.1 m (op U.1) s.2 a } := by
    intro b hb g hg
    set a : (reesPiece I (k : ℤ)).val.obj (op U.1) :=
      (reesPieceAffineEquiv I (k : ℤ) (Int.natCast_nonneg k) U).symm
        ⟨b, by rw [Int.toNat_natCast]; exact hb⟩ with ha
    have hamb : reesPieceAmbient I (k : ℤ) U.1 a = b := by
      rw [← reesPieceAffineEquiv_coe I (k : ℤ) (Int.natCast_nonneg k) U, ha,
        AddEquiv.apply_symm_apply]
    set t : ((reesGradedModule I F).piece (k : ℤ)).val.obj (op U.1) :=
      (zero_add (k : ℤ)) ▸
        (reesGradedModule I F).smul 0 (k : ℤ) (op U.1) (reesSectionZero I F g) a with ht
    have htval : t.1 = b • g := by
      rw [ht, val_eqRec_reesGradedModule]
      show reesPieceAmbient I (k : ℤ) U.1 a • g = b • g
      rw [hamb]
    refine ⟨htval ▸ t.2, ?_⟩
    rw [show (⟨b • g, htval ▸ t.2⟩ :
        ((reesGradedModule I F).piece (k : ℤ)).val.obj (op U.1)) = t from
      Subtype.ext htval.symm]
    exact AddSubgroup.subset_closure
      ⟨⟨(0 : ℤ), reesSectionZero I F g⟩, Finset.mem_image_of_mem _ hg,
        (k : ℤ), a, zero_add (k : ℤ), ht⟩
  refine (AddSubgroup.eq_top_iff' _).2 fun x => ?_
  exact mem_closure_of_mem_idealSmulTop (I.ideal U ^ k) _ _ G hG hgen x.1 (hsec.le x.2) x.2

/-- **`⨁ₙ ℐⁿF` is of finite type on every affine open as soon as `F` is coherent.** -/
public theorem isFiniteTypeOnAffine_reesGradedModule_of_isCoherent (hF : F.IsCoherent) :
    Stacks.Coherent.IsFiniteTypeOnAffine (reesGradedModule I F) :=
  let := hF
  let := hF.isFiniteType
  let : F.IsQuasicoherent := _root_.isQuasicoherent_of_isCoherent F
  isFiniteTypeOnAffine_reesGradedModule I F

end Stacks.Blowup

end
