module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.ULiftUnit
public import StacksFrontier.AlgebraicGeometry.CoherenceCriteria.Basic
public import StacksFrontier.AlgebraicGeometry.ResolutionsAndBounds.IdealProductTensor
public import StacksFrontier.Topology.Sheaves.Modules.Generators.TensorGloballyGenerated

/-!
# Generating global sections of every power of a sheaf of ideals

Let `X` be a scheme and `𝓘` a quasi-coherent sheaf of ideals on it, given by its affine-local
ideal data. If `𝓘` is generated by global sections then so is every power `𝓘ⁿ`, by the `n`-fold
products of the generators.

The powers are taken in the `Stacks.AlgebraicGeometry.IdealPowerColimit.idealPow` encoding, the
subsheaf `𝓘ⁿ 𝒪_X` of `Stacks.AlgebraicGeometry.IdealPower.idealPowerMultiple` whose sections
over an affine open `V` are the ideal `𝓘(V)ⁿ`.

## Main results

* `AlgebraicGeometry.idealPowerMultiple_structureModule_eq`: two ideal-power multiples of the
  structure sheaf whose ideals agree on every affine open are the same subsheaf; its instances
  are `AlgebraicGeometry.idealPow_pow_one` and `AlgebraicGeometry.idealPow_mul_one`.
* `AlgebraicGeometry.idealPowZeroIso`: the zeroth power of a sheaf of ideals is the whole
  structure sheaf.
* `AlgebraicGeometry.idealPowGeneratingSections`: generating global sections of every power
  `𝓘ⁿ` of a sheaf of ideals, from generating global sections of `𝓘` itself.

## References

* [Stacks Project, Tag 01CA](https://stacks.math.columbia.edu/tag/01CA)
* [Stacks Project, Tag 01AO](https://stacks.math.columbia.edu/tag/01AO)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry TopologicalSpace
open Stacks.AlgebraicGeometry.IdealPower
open Stacks.AlgebraicGeometry.IdealPowerColimit

universe u

namespace AlgebraicGeometry

variable {X : Scheme.{u}}

/-! ### Re-indexing the powers of a sheaf of ideals -/

/-- Two ideal-power multiples of the structure sheaf whose ideals agree on every affine open are
the same subsheaf of the structure sheaf. -/
public theorem idealPowerMultiple_structureModule_eq (K K' : X.IdealSheafData) (m n : ℕ)
    (h : ∀ V : X.affineOpens, (K.ideal V ^ m : Ideal Γ(X, V.1)) = K'.ideal V ^ n) :
    idealPowerMultiple K m (structureModule X)
      = idealPowerMultiple K' n (structureModule X) :=
  Scheme.Modules.submodule_eq_of_obj_affineOpens_eq _ _ fun V =>
    (obj_idealPow_affineOpen K m V).trans
      ((h V).trans (obj_idealPow_affineOpen K' n V).symm)

/-- Ideal powers of sheaves of ideals with equal ideals on every affine open are equal. -/
private theorem idealPow_eq_of_ideal_pow_eq (K K' : X.IdealSheafData) (m n : ℕ)
    (h : ∀ V : X.affineOpens, (K.ideal V ^ m : Ideal Γ(X, V.1)) = K'.ideal V ^ n) :
    idealPow K m = idealPow K' n := by
  change subMod (idealPowerMultiple K m (structureModule X))
    = subMod (idealPowerMultiple K' n (structureModule X))
  rw [idealPowerMultiple_structureModule_eq K K' m n h]

/-- The first power of `𝓘ⁿ` is the `n`-th power of `𝓘`. -/
public theorem idealPow_pow_one (J : X.IdealSheafData) (n : ℕ) :
    idealPow (J ^ n) 1 = idealPow J n :=
  idealPow_eq_of_ideal_pow_eq _ _ _ _ fun V => by
    rw [pow_one, Scheme.IdealSheafData.ideal_pow]
    rfl

/-- The first power of the product `𝓘ⁿ 𝓘` is the `(n + 1)`-st power of `𝓘`. -/
public theorem idealPow_mul_one (J : X.IdealSheafData) (n : ℕ) :
    idealPow (J ^ n * J) 1 = idealPow J (n + 1) :=
  idealPow_eq_of_ideal_pow_eq _ _ _ _ fun V => by
    rw [pow_one, pow_succ, Scheme.IdealSheafData.ideal_mul, Scheme.IdealSheafData.ideal_pow]
    rfl

/-! ### The zeroth power -/

/-- Every section of the structure sheaf lies in the zeroth power of a sheaf of ideals. -/
public theorem mem_idealPowerMultiple_zero (J : X.IdealSheafData) (V : X.Opens)
    (x : Γ(structureModule X, V)) :
    x ∈ (idealPowerMultiple J 0 (structureModule X)).toSubmodule.obj (op V) :=
  mem_of_forall_affineOpens _ x fun W _ => (obj_idealPow_affineOpen J 0 W).ge
    (show _ ∈ (J.ideal W ^ 0 : Ideal Γ(X, W.1)) by
      rw [pow_zero, Ideal.one_eq_top]
      exact Submodule.mem_top)

/-- The zeroth power of a sheaf of ideals is the whole structure sheaf. -/
public def idealPowZeroIso (J : X.IdealSheafData) :
    (idealPow J 0 : SheafOfModules.{u} X.ringCatSheaf) ≅ structureModule X :=
  have h : IsIso (idealPowerMultiple J 0 (structureModule X)).ι :=
    Stacks.SheafOfModules.isIso_ι_of_forall_mem _ fun V x => mem_idealPowerMultiple_zero J V.unop x
  @asIso _ _ _ _ _ h

/-! ### Generating sections of the powers -/

/-- Generating global sections of every power `𝓘ⁿ` of a sheaf of ideals, from generating global
sections of `𝓘` itself: the `n`-fold products of the given sections. -/
public def idealPowGeneratingSections (J : X.IdealSheafData)
    (σ : (idealPow J 1).GeneratingSections) :
    ∀ n : ℕ, (idealPow J n).GeneratingSections
  | 0 => SheafOfModules.GeneratingSections.equivOfIso (idealPowZeroIso J).symm
      (Stacks.AlgebraicGeometry.CoherenceCriteria.unitGeneratingSections (R := X.ringCatSheaf))
  | n + 1 => by
      have σ' : (idealPow (J ^ n) 1).GeneratingSections :=
        SheafOfModules.GeneratingSections.equivOfIso
          (eqToIso (idealPow_pow_one J n).symm) (idealPowGeneratingSections J σ n)
      have τ : (Stacks.AlgebraicGeometry.IdealProduct.tensorModules
          (idealPow (J ^ n) 1) (idealPow J 1)).GeneratingSections :=
        Stacks.SheafOfModules.tensorSheafGeneratingSections X.toRingedSpace
          (idealPow (J ^ n) 1) (idealPow J 1) σ' σ
      haveI : @Epi (SheafOfModules.{u} X.ringCatSheaf) _ _ _
          (Stacks.AlgebraicGeometry.IdealProduct.idealPowMul (J ^ n) J 1) :=
        ⟨fun g₁ g₂ hg => (Stacks.AlgebraicGeometry.IdealProduct.epi_idealPowMul
          (J ^ n) J 1).left_cancellation g₁ g₂ hg⟩
      exact SheafOfModules.GeneratingSections.equivOfIso (eqToIso (idealPow_mul_one J n))
        (SheafOfModules.GeneratingSections.ofEpi τ
          (Stacks.AlgebraicGeometry.IdealProduct.idealPowMul (J ^ n) J 1))

end AlgebraicGeometry

end
