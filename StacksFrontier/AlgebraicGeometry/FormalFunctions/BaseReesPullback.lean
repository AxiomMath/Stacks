module

public import StacksFrontier.AlgebraicGeometry.Blowup.ReesPullbackFlat
public import StacksFrontier.AlgebraicGeometry.FormalFunctions.CohomologyGradedReesFinite
public import StacksFrontier.AlgebraicGeometry.PuncturedSpectrumPicard.PrincipalPowerSubscheme

/-!
# The Rees algebra of `ℐ = I · 𝒪_X` as a pullback from the base

Let `A` be a ring, `I ⊆ A` an ideal and `f : X ⟶ Spec A` a morphism of schemes. Write `Ĩ` for
the quasi-coherent ideal sheaf on `Spec A` generated by `I` and `B̃ = ⨁_{n ≥ 0} Ĩⁿ` for its Rees
algebra, a sheaf of graded algebras on `Spec A`; `B̃` is the sheaf attached to the graded ring
`B = ⨁_{n ≥ 0} Iⁿ`. Write `ℐ = I · 𝒪_X`. Since `ℐ` is the inverse image of `Ĩ`, the Rees algebra
`⨁_{n ≥ 0} ℐⁿ` is the Rees algebra of the inverse image of `Ĩ`, and there is a canonical unital
homomorphism of sheaves of graded algebras

`Φ : f^* B̃ ⟶ ⨁_{n ≥ 0} ℐⁿ`.

It is surjective on affine charts in every nonnegative degree, and an isomorphism in every
nonnegative degree when `f` is flat. It is not an isomorphism for a general proper `f`: for
`A = k[t]`, `I = (t)` and `f` the closed immersion `Spec(k[t]/t²) ⟶ Spec A`, `ℐ² = 0` while
`f^*(Ĩ²) ≅ k[t]/t² ≠ 0`.

## Main definitions

* `Stacks.Blowup.reesGradedPullbackHomOfEq`: the comparison `Stacks.Blowup.reesGradedPullbackHom`,
  read along an equality identifying a sheaf of ideals upstairs with the inverse image of one
  downstairs.
* `Stacks.Cohomology.FormalFunctions.specIdealSheaf`: `Ĩ`, the quasi-coherent ideal sheaf on
  `Spec A` generated by `I`.
* `Stacks.Cohomology.FormalFunctions.specReesAlgebra`: `B̃ = ⨁_{n ≥ 0} Ĩⁿ`, the Rees algebra of
  `Ĩ` as a sheaf of graded algebras on `Spec A`.
* `Stacks.Cohomology.FormalFunctions.baseReesPullbackHom`: the comparison
  `Φ : f^* B̃ ⟶ ⨁ₙ ℐⁿ`.

## Main results

* `Stacks.Cohomology.FormalFunctions.baseIdealSheaf_eq_comap_specIdealSheaf` and
  `Stacks.Cohomology.FormalFunctions.baseReesAlgebra_eq_comap`: `ℐ` is the inverse image of `Ĩ`,
  and therefore `⨁ₙ ℐⁿ` is the Rees algebra of that inverse image.
* `Stacks.Cohomology.FormalFunctions.surjective_reesPullbackComparisonLinear_specIdealSheaf`:
  `Φ` is surjective on an affine chart in every nonnegative degree, for every `f`.
* `Stacks.Cohomology.FormalFunctions.isIso_baseReesPullbackHom_app`: for a flat `f`, `Φ` is an
  isomorphism in every nonnegative degree.

## References

* [Stacks Project, Tag 01OG](https://stacks.math.columbia.edu/tag/01OG)
* [Stacks Project, Tag 0897](https://stacks.math.columbia.edu/tag/0897)
* [Stacks Project, Tag 02O8](https://stacks.math.columbia.edu/tag/02O8)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open Stacks.Blowup
open scoped AlgebraicGeometry

universe u

namespace Stacks.Blowup

variable {Z W : Scheme.{u}} (g : Z ⟶ W) (K : W.IdealSheafData) {L : Z.IdealSheafData}

/-- `Stacks.Blowup.reesGradedPullbackHom` with its target read along an equality identifying a
sheaf of ideals on `Z` with the inverse image of `K`. -/
def reesGradedPullbackHomOfEq (h : L = K.comap g) :
    SheafOfModules.GradedAlgebra.UnitalHom
      (Stacks.Conormal.gradedPullback g (reesGradedAlgebra K)) (reesGradedAlgebra L) :=
  h ▸ reesGradedPullbackHom g K

/-- For a flat `g` the comparison, read along such an equality, is an isomorphism in every
nonnegative degree. -/
theorem isIso_reesGradedPullbackHomOfEq_app [AlgebraicGeometry.Flat g] (h : L = K.comap g)
    (n : ℤ) (hn : 0 ≤ n) : IsIso ((reesGradedPullbackHomOfEq g K h).app n) := by
  subst h
  exact isIso_reesGradedPullbackHom_app g K n hn

end Stacks.Blowup

namespace Stacks.Cohomology.FormalFunctions

variable {A : Type u} [CommRing A] (I : Ideal A) (X : Over (Spec (.of A)))

/-! ### `B̃` on the base -/

/-- `Ĩ`, the quasi-coherent ideal sheaf on `Spec A` generated by the ideal `I`. -/
abbrev specIdealSheaf : (Spec (.of A)).IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop (I.map (Scheme.ΓSpecIso (.of A)).inv.hom)

/-- `B̃ = ⨁_{n ≥ 0} Ĩⁿ`, the Rees algebra of `Ĩ` as a sheaf of graded algebras on `Spec A`. -/
abbrev specReesAlgebra : SheafOfModules.GradedAlgebra.{u, u} (Spec (.of A)).ringCatSheaf :=
  reesGradedAlgebra (specIdealSheaf I)

/-! ### `⨁ₙ ℐⁿ` as the Rees algebra of an inverse image -/

/-- `ℐ = I · 𝒪_X` is the inverse image of `Ĩ` along `f`. -/
theorem baseIdealSheaf_eq_comap_specIdealSheaf :
    baseIdealSheaf A I X.hom = (specIdealSheaf I).comap X.hom :=
  Stacks.PuncturedSpectrumPicard.baseIdealSheaf_eq_comap A I X.hom

/-- `⨁_{n ≥ 0} ℐⁿ` is the Rees algebra of the inverse image of `Ĩ`. -/
theorem baseReesAlgebra_eq_comap :
    baseReesAlgebra I X = reesGradedAlgebra ((specIdealSheaf I).comap X.hom) :=
  congrArg reesGradedAlgebra (baseIdealSheaf_eq_comap_specIdealSheaf I X)

/-! ### The comparison `Φ : f^* B̃ ⟶ ⨁ₙ ℐⁿ` -/

/-- The comparison `Φ : f^* B̃ ⟶ ⨁_{n ≥ 0} ℐⁿ`, a unital homomorphism of sheaves of graded
algebras: `Stacks.Blowup.reesGradedPullbackHom` for `Ĩ` and `f`, with its target read as
`Stacks.Cohomology.FormalFunctions.baseReesAlgebra`. -/
def baseReesPullbackHom :
    SheafOfModules.GradedAlgebra.UnitalHom
      (Stacks.Conormal.gradedPullback X.hom (specReesAlgebra I)) (baseReesAlgebra I X) :=
  reesGradedPullbackHomOfEq X.hom (specIdealSheaf I)
    (baseIdealSheaf_eq_comap_specIdealSheaf I X)

/-- The comparison `f^* B̃ ⟶ ⨁ₙ (Ĩ.comap f)ⁿ` is surjective on an affine chart in every
nonnegative degree, for every `f`. -/
theorem surjective_reesPullbackComparisonLinear_specIdealSheaf (n : ℤ) (hn : 0 ≤ n)
    (U : (Spec (.of A)).affineOpens) (V : X.left.affineOpens) (hVU : V.1 ≤ X.hom ⁻¹ᵁ U.1) :
    Function.Surjective (reesPullbackComparisonLinear X.hom (specIdealSheaf I) n V.1) :=
  surjective_reesPullbackComparisonLinear X.hom (specIdealSheaf I) n hn U V hVU

/-- For a flat `f` the comparison `Φ : f^* B̃ ⟶ ⨁_{n ≥ 0} ℐⁿ` is an isomorphism in every
nonnegative degree. -/
theorem isIso_baseReesPullbackHom_app [AlgebraicGeometry.Flat X.hom] (n : ℤ) (hn : 0 ≤ n) :
    IsIso ((baseReesPullbackHom I X).app n) :=
  isIso_reesGradedPullbackHomOfEq_app X.hom (specIdealSheaf I)
    (baseIdealSheaf_eq_comap_specIdealSheaf I X) n hn

end Stacks.Cohomology.FormalFunctions

end
