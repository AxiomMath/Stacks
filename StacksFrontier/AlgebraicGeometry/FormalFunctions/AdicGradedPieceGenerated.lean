* [Stacks Project, Tag 01AO](https://stacks.math.columbia.edu/tag/01AO)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite
open Stacks.AlgebraicGeometry.IdealPower
open Stacks.AlgebraicGeometry.IdealPowerColimit
open Stacks.AlgebraicGeometry.IdealProduct
open Stacks.SheafOfModules.TensorStalkRingedSpace

universe u v

namespace Stacks.Abelian

/-! ### Descending a map along an exact pair -/

section Descent

variable {D : Type u} [Category.{v} D] [Abelian D] {A B C Z : D} {f : A ⟶ B} {g : B ⟶ C}
  {hfg : f ≫ g = 0} {ψ : B ⟶ Z}

/-- **The map out of the right-hand term of an exact pair whose second map is an epimorphism.**
If `A ⟶ B ⟶ C` is exact with `B ⟶ C` an epimorphism then `g` exhibits `C` as the cokernel of
`f`, so a map `ψ : B ⟶ Z` killing `f` descends to `C ⟶ Z`.

The epimorphism hypothesis is an explicit argument rather than an instance, and the vanishing
composite `hfg` is a variable rather than `S.zero`: at the call site the ambient category is one
of the two interchangeable spellings of the category of modules on a scheme, and an `Epi`
hypothesis available at one of them is not found by instance search at the other. -/
public noncomputable def exactDesc (hex : (ShortComplex.mk f g hfg).Exact) (hg : Epi g)
    (hfψ : f ≫ ψ = 0) : C ⟶ Z :=
  letI := hg
  hex.gIsCokernel.desc (CokernelCofork.ofπ ψ hfψ)

/-- The descended map composed with `g` is the original map. -/
public lemma comp_exactDesc (hex : (ShortComplex.mk f g hfg).Exact) (hg : Epi g)
    (hfψ : f ≫ ψ = 0) : g ≫ exactDesc hex hg hfψ = ψ :=
  let := hg
  Cofork.IsColimit.π_desc hex.gIsCokernel

/-- **The descended map is an epimorphism when the map it descends is.** A morphism through
which an epimorphism factors is an epimorphism. -/
public lemma epi_exactDesc (hex : (ShortComplex.mk f g hfg).Exact) (hg : Epi g)
    (hfψ : f ≫ ψ = 0) (hψ : Epi ψ) : Epi (exactDesc hex hg hfψ) :=
  let := hψ
  epi_of_epi_fac (comp_exactDesc hex hg hfψ)

end Descent

/-! ### Reassociation and cancellation with the ingredients as variables

Each statement here is a one-line fact about an abstract category which takes the composites it
talks about, and the equations between them, as explicit arguments. That is what lets it be
applied in term mode to morphisms whose `Category` instance is one of the two interchangeable
spellings of the category of modules on a scheme, where `rw` cannot build a motive. -/

section Reassoc

variable {D : Type u} [Category.{v} D] {A B B' C E : D}

/-- Reassociation against a known composite: if `v ≫ w` is `vw` then `(u ≫ v) ≫ w` is
`u ≫ vw`. -/
public lemma assoc_eq_of_comp_eq (u : A ⟶ B) (v : B ⟶ C) (w : C ⟶ E) (vw : B ⟶ E)
    (h : v ≫ w = vw) : (u ≫ v) ≫ w = u ≫ vw := by
  rw [Category.assoc, h]

/-- **A composite vanishes once it has been rerouted through a map killed by its last factor.**
If `u ≫ v` is `s ≫ t` and `t ≫ z` vanishes then `u ≫ v ≫ z` vanishes. -/
public lemma comp_comp_eq_zero_of_comp_eq [HasZeroMorphisms D] (u : A ⟶ B) (v : B ⟶ C)
    (s : A ⟶ B') (t : B' ⟶ C) (z : C ⟶ E) (h : u ≫ v = s ≫ t) (ht : t ≫ z = 0) :
    u ≫ v ≫ z = 0 := by
  rw [← Category.assoc, h, Category.assoc, ht, comp_zero]

/-- **A map factors through `s` once both composites into a monomorphism agree.** For `w` a
monomorphism, `u = v ≫ s` follows from `u ≫ w = m`, `v ≫ i = m` and `s ≫ w = i`.

The three equations are variables precisely so that each may be supplied at the spelling its own
proof produces: `w` and `i` are inclusions of subsheaves of a module which the tree names
through two definitionally equal but syntactically different constants. -/
public lemma eq_comp_of_comp_eq_of_mono (u : A ⟶ B) (v : A ⟶ B') (s : B' ⟶ B) (w : B ⟶ C)
    (i : B' ⟶ C) (m : A ⟶ C) (hw : Mono w) (hu : u ≫ w = m) (hv : v ≫ i = m)
    (hs : s ≫ w = i) : u = v ≫ s := by
  let := hw
  refine (cancel_mono w).mp ?_
  rw [Category.assoc, hs, hv, hu]

end Reassoc

end Stacks.Abelian

namespace Stacks.Cohomology.FormalFunctions

variable {X : Scheme.{u}} (J : X.IdealSheafData) (M : X.Modules) (n : ℕ)

/-! ### The two spellings of `𝓘 ⁿ M` -/

/-- **The tree's two `𝓘 ⁿ M` constants are definitionally equal.**
`Stacks.Algebraization.idealPowerMultiple`
(`StacksFrontier/AlgebraicGeometry/FormalGeometry/IdealPowerQuotient.lean:76`) and
`Stacks.AlgebraicGeometry.IdealPower.idealPowerMultiple`
(`StacksFrontier/AlgebraicGeometry/Modules/IdealPowerMultiple.lean:129`) have byte-identical bodies:
each is the `sInf` of the submodules of `M` dominating `𝓘(U) ⁿ Γ(M, U)` on every affine open `U`.

Nothing is merged or deleted here. This lemma only records the identification, so that a rewrite
whose statement is phrased with one of them can be used on a goal phrased with the other.

Note that `Stacks.AlgebraicGeometry.IdealPowerComparison.idealPowerMultiple_eq_idealPowSmul`,
which identifies `𝓘 ⁿ M` with the subsheaf cut out by the affine-local products, is stated
against the `IdealPower` constant and *not* against the `Stacks.Algebraization` one that
`StacksFrontier/AlgebraicGeometry/FormalFunctions/AdicGradedPieceShortExact.lean` — and hence the
graded piece below — is built from. The name does not reveal this. -/
public lemma algebraization_idealPowerMultiple_eq (I : X.IdealSheafData) (k : ℕ)
    (N : X.Modules) :
    Stacks.Algebraization.idealPowerMultiple I k N =
      Stacks.AlgebraicGeometry.IdealPower.idealPowerMultiple I k N :=
  rfl

/-! ### The graded piece -/

/-- **The graded piece `𝓘 ⁿ M / 𝓘 ⁿ⁺¹ M` of the `𝓘`-adic filtration**, exactly the object
`StacksFrontier/AlgebraicGeometry/FormalFunctions/AdicGradedPieceShortExact.lean` computes with. -/
public noncomputable abbrev adicGradedPieceModule : X.Modules :=
  cokernel (C := X.Modules) (Stacks.Algebraization.submoduleInclusion
    (Stacks.Algebraization.idealPowerMultiple_antitone J M (Nat.le_succ n)))

/-- The inclusion `𝓘 ⁿ⁺¹ M ⟶ 𝓘 ⁿ M` whose cokernel the graded piece is. -/
public noncomputable abbrev adicGradedPieceInclusion :
    idealPowSmul J (n + 1) M ⟶ idealPowSmul J n M :=
  Stacks.Algebraization.submoduleInclusion
    (Stacks.Algebraization.idealPowerMultiple_antitone J M (Nat.le_succ n))

/-- The short complex `𝓘 M ⟶ M ⟶ M / 𝓘 M`, at the spelling of the category of modules on a
ringed space that the tensor product of [Stacks, Tag 01CA] is indexed by. -/
public noncomputable abbrev adicIdealShortComplex :
    ShortComplex (SheafOfModules.{u} X.ringCatSheaf) :=
  ShortComplex.mk (Stacks.Algebraization.idealPowerMultiple J 1 M).ι
    (cokernel.π (C := X.Modules) (Stacks.Algebraization.idealPowerMultiple J 1 M).ι)
    (cokernel.condition (C := X.Modules) _)

/-- `𝓘 M ⟶ M ⟶ M / 𝓘 M` is exact: its second map is the cokernel of its first. -/
public lemma adicIdealShortComplex_exact : (adicIdealShortComplex J M).Exact :=
  ShortComplex.exact_of_g_is_cokernel _ (cokernelIsCokernel _)

/-- The projection `M ⟶ M / 𝓘 M` is an epimorphism. -/
public lemma epi_adicIdealShortComplex_g : Epi (adicIdealShortComplex J M).g :=
  inferInstanceAs (Epi (cokernel.π (C := X.Modules) _))

/-! ### The epimorphism `𝓘 ⁿ ⊗ M ⟶ 𝓘 ⁿ M / 𝓘 ⁿ⁺¹ M` -/

/-- **Multiplication of sections followed by the projection onto the graded piece**, as a
morphism `𝓘 ⁿ ⊗_{𝒪_X} M ⟶ 𝓘 ⁿ M / 𝓘 ⁿ⁺¹ M`. -/
public noncomputable def idealPowTensorToGradedPiece [M.IsQuasicoherent] :
    tensorModules (idealPow J n) M ⟶ adicGradedPieceModule J M n :=
  idealPowTensorToSmul J n M ≫
    cokernel.π (C := X.Modules) (adicGradedPieceInclusion J M n)

/-- The projection `𝓘 ⁿ M ⟶ 𝓘 ⁿ M / 𝓘 ⁿ⁺¹ M` is an epimorphism. -/
public lemma epi_adicGradedPiece_π :
    Epi (cokernel.π (C := X.Modules) (adicGradedPieceInclusion J M n)) :=
  inferInstanceAs (Epi (cokernel.π (C := X.Modules) (adicGradedPieceInclusion J M n)))

/-- **`𝓘 ⁿ ⊗_{𝒪_X} M ⟶ 𝓘 ⁿ M / 𝓘 ⁿ⁺¹ M` is an epimorphism**, for quasi-coherent `M`: it is
`Stacks.AlgebraicGeometry.IdealPowerColimit.epi_idealPowTensorToSmul` followed by a cokernel
projection. -/
public lemma epi_idealPowTensorToGradedPiece [M.IsQuasicoherent] :
    Epi (idealPowTensorToGradedPiece J M n) :=
  @epi_comp _ _ _ _ _ (idealPowTensorToSmul J n M) (epi_idealPowTensorToSmul J n M)
    (cokernel.π (C := X.Modules) (adicGradedPieceInclusion J M n))
    (epi_adicGradedPiece_π J M n)

/-! ### The zero composite `𝓘 ⁿ ⊗ 𝓘 M ⟶ 𝓘 ⁿ ⊗ M ⟶ 𝓘 ⁿ M / 𝓘 ⁿ⁺¹ M` -/

/-- The map `𝓘 ⁿ ⊗_{𝒪_X} 𝓘 M ⟶ 𝓘 ⁿ ⊗_{𝒪_X} M` induced by the inclusion `𝓘 M ⟶ M`. -/
public noncomputable abbrev idealPowTensorIdealMap :
    tensorModules (idealPow J n) (idealPowSmul J 1 M) ⟶ tensorModules (idealPow J n) M :=
  (Functor.uncurry.obj (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf)).map
    (X := (idealPow J n, idealPowSmul J 1 M)) (Y := (idealPow J n, M))
    (𝟙 (idealPow J n), (Stacks.Algebraization.idealPowerMultiple J 1 M).ι)

/-- Multiplication of sections `𝓘 ⁿ ⊗_{𝒪_X} 𝓘 M ⟶ M`, `a ⊗ b ↦ a b`. -/
public noncomputable abbrev idealPowIdealTensorToModule :
    tensorModules (idealPow J n) (idealPowSmul J 1 M) ⟶ M :=
  idealPowTensorIdealMap J M n ≫ idealPowTensorToModule J n M

/-- **Multiplication of sections of `𝓘 ⁿ` with sections of `𝓘 M`, on a local pure tensor**: the
image of `a ⊗ b` is `a b`, computed in `M`.

The value of `a` is passed as a section `r` of the structure sheaf and the value of `b` as a
section `y` of `M`, each with the equation identifying it, because `Γ(𝒪_X, V)` is not a scalar
for `Γ(M, V)` at the transparency of instance search — the device of
`Stacks.AlgebraicGeometry.IdealPowerColimit.smulToModule_app_toTensorSheafSection`. -/
public theorem idealPowIdealTensorToModule_app_toTensorSheafSection (V : X.Opens)
    (a : Γ(idealPow J n, V)) (b : Γ(idealPowSmul J 1 M, V)) (r : Γ(X, V)) (y : Γ(M, V))
    (hr : (idealPowInclusion J n).app V a = r) (hy : b.1 = y) :
    (idealPowIdealTensorToModule J M n).app V
        (toTensorSheafSection X.toRingedSpace (idealPow J n) (idealPowSmul J 1 M) (op V)
          (a ⊗ₜ[X.presheaf.obj (op V)] b))
      = r • y := by
  subst hy
  refine Eq.trans ?_
    (smulToModule_app_toTensorSheafSection (idealPowInclusion J n) M V a b.1 r hr)
  exact congrArg (ConcreteCategory.hom ((idealPowTensorToModule J n M).app V))
    (tensorSheafMap_app_toTensorSheafSection X.toRingedSpace _ _ _ _ _ _ V a b)

/-- **Multiplication of sections of `𝓘 ⁿ` with sections of `𝓘 M` takes values in `𝓘 ⁿ⁺¹ M`.**
The containment is checked on an affine open neighbourhood of each point, where a section of the
tensor product is a finite sum of pure tensors `∑ aⱼ ⊗ bⱼ`; there `aⱼ` lies in `𝓘(V) ⁿ` by
`Stacks.AlgebraicGeometry.IdealPower.obj_idealPow_affineOpen` and `bⱼ` in `𝓘(V) Γ(M, V)` by
`Stacks.AlgebraicGeometry.IdealPowerColimit.idealPowerMultiple_obj_affineOpen`, so each product
lies in `𝓘(V) ⁿ 𝓘(V) Γ(M, V) = 𝓘(V) ⁿ⁺¹ Γ(M, V)`. -/
public theorem exists_mem_succ_idealPowIdealTensorToModule [M.IsQuasicoherent] (W : X.Opens)
    (t : Γ(tensorModules (idealPow J n) (idealPowSmul J 1 M), W)) (p : X) (hp : p ∈ W) :
    ∃ (V : X.Opens) (hV : V ≤ W), p ∈ V ∧
      (idealPowIdealTensorToModule J M n).app V
          ((tensorModules (idealPow J n) (idealPowSmul J 1 M)).presheaf.map
            (homOfLE hV).op t) ∈
        (Stacks.Algebraization.idealPowerMultiple J (n + 1) M).toSubmodule.obj (op V) := by
  obtain ⟨V, hV, hpV, m, a, b, heq⟩ :=
    exists_affineOpen_sum_toTensorSheafSection (idealPow J n) (idealPowSmul J 1 M) W t p hp
  refine ⟨V.1, hV, hpV, ?_⟩
  have htarget : J.ideal V ^ (n + 1) • (⊤ : Submodule Γ(X, V.1) Γ(M, V.1)) ≤
      (Stacks.Algebraization.idealPowerMultiple J (n + 1) M).toSubmodule.obj (op V.1) :=
    (idealPowerMultiple_obj_affineOpen J (n + 1) M V).ge
  have hterm : ∀ j : Fin m, (idealPowIdealTensorToModule J M n).app V.1
      (toTensorSheafSection X.toRingedSpace (idealPow J n) (idealPowSmul J 1 M) (op V.1)
        (a j ⊗ₜ[X.presheaf.obj (op V.1)] b j)) ∈
      J.ideal V ^ (n + 1) • (⊤ : Submodule Γ(X, V.1) Γ(M, V.1)) := by
    intro j
    obtain ⟨r, hr⟩ : ∃ r : Γ(X, V.1), (idealPowInclusion J n).app V.1 (a j) = r := ⟨_, rfl⟩
    obtain ⟨y, hy⟩ : ∃ y : Γ(M, V.1), (b j).1 = y := ⟨_, rfl⟩
    rw [idealPowIdealTensorToModule_app_toTensorSheafSection J M n V.1 (a j) (b j) r y hr hy]
    have hrmem : r ∈ (J.ideal V ^ n : Ideal Γ(X, V.1)) := by
      rw [← obj_idealPow_affineOpen J n V, ← hr]
      exact (a j).2
    have hymem : y ∈ J.ideal V ^ 1 • (⊤ : Submodule Γ(X, V.1) Γ(M, V.1)) := by
      refine (idealPowerMultiple_obj_affineOpen J 1 M V).le ?_
      rw [← hy]
      exact (b j).2
    have hmul := Submodule.smul_mem_smul hrmem hymem
    rwa [← Submodule.smul_assoc, Ideal.smul_eq_mul, ← pow_add] at hmul
  refine htarget ?_
  refine Eq.subst (motive := fun z ↦ z ∈ J.ideal V ^ (n + 1) •
      (⊤ : Submodule Γ(X, V.1) Γ(M, V.1)))
    (Eq.trans (congrArg (ConcreteCategory.hom ((idealPowIdealTensorToModule J M n).app V.1)) heq)
      (map_sum _ _ _)).symm ?_
  exact Submodule.sum_mem _ fun j _ ↦ hterm j

/-- **The factorization `𝓘 ⁿ ⊗_{𝒪_X} 𝓘 M ⟶ 𝓘 ⁿ⁺¹ M`** of multiplication of sections through the
subsheaf `𝓘 ⁿ⁺¹ M` of `M`. This is the mathematical content of the file. -/
public noncomputable def idealPowIdealTensorToSucc [M.IsQuasicoherent] :
    tensorModules (idealPow J n) (idealPowSmul J 1 M) ⟶ idealPowSmul J (n + 1) M :=
  factorThruOfLocalMem (Stacks.Algebraization.idealPowerMultiple J (n + 1) M)
    (idealPowIdealTensorToModule J M n) (exists_mem_succ_idealPowIdealTensorToModule J M n)

/-- The factorization composed with the inclusion of `𝓘 ⁿ⁺¹ M` into `M` is multiplication of
sections. -/
public theorem idealPowIdealTensorToSucc_comp_ι [M.IsQuasicoherent] :
    idealPowIdealTensorToSucc J M n ≫
        (Stacks.Algebraization.idealPowerMultiple J (n + 1) M).ι =
      idealPowIdealTensorToModule J M n :=
  factorThruOfLocalMem_ι _ _ _

/-- **`𝓘 ⁿ ⊗ 𝓘 M ⟶ 𝓘 ⁿ ⊗ M ⟶ 𝓘 ⁿ M` factors through the inclusion `𝓘 ⁿ⁺¹ M ⟶ 𝓘 ⁿ M`.** Both
sides become multiplication of sections after composition with the monomorphism `𝓘 ⁿ M ⟶ M`. -/
public theorem idealPowTensorIdealMap_comp_idealPowTensorToSmul [M.IsQuasicoherent] :
    idealPowTensorIdealMap J M n ≫ idealPowTensorToSmul J n M =
      idealPowIdealTensorToSucc J M n ≫ adicGradedPieceInclusion J M n := by
  have hu : (idealPowTensorIdealMap J M n ≫ idealPowTensorToSmul J n M) ≫
      (Stacks.AlgebraicGeometry.IdealPower.idealPowerMultiple J n M).ι =
      idealPowIdealTensorToModule J M n :=
    Stacks.Abelian.assoc_eq_of_comp_eq _ _ _ _ (idealPowTensorToSmul_ι J n M)
  have hs : adicGradedPieceInclusion J M n ≫
      (Stacks.AlgebraicGeometry.IdealPower.idealPowerMultiple J n M).ι =
      (Stacks.Algebraization.idealPowerMultiple J (n + 1) M).ι :=
    Stacks.Algebraization.submoduleInclusion_comp_ι _
  have hw : Mono ((Stacks.AlgebraicGeometry.IdealPower.idealPowerMultiple J n M).ι :
      idealPowSmul J n M ⟶ M) := inferInstance
  exact Stacks.Abelian.eq_comp_of_comp_eq_of_mono _ _ _ _ _ _ hw hu
    (idealPowIdealTensorToSucc_comp_ι J M n) hs

/-- **The composite `𝓘 ⁿ ⊗ 𝓘 M ⟶ 𝓘 ⁿ ⊗ M ⟶ 𝓘 ⁿ M / 𝓘 ⁿ⁺¹ M` is zero.** The image of
`a ⊗ b m` is `a b m`, which lies in `𝓘 ⁿ⁺¹ M` and so dies in the cokernel. -/
public theorem idealPowTensorIdeal_comp_toGradedPiece [M.IsQuasicoherent] :
    idealPowTensorIdealMap J M n ≫ idealPowTensorToGradedPiece J M n = 0 :=
  Stacks.Abelian.comp_comp_eq_zero_of_comp_eq (idealPowTensorIdealMap J M n)
    (idealPowTensorToSmul J n M) (idealPowIdealTensorToSucc J M n)
    (adicGradedPieceInclusion J M n)
    (cokernel.π (C := X.Modules) (adicGradedPieceInclusion J M n))
    (idealPowTensorIdealMap_comp_idealPowTensorToSmul J M n)
    (cokernel.condition (C := X.Modules) _)

/-! ### The descent to `𝓘 ⁿ ⊗ (M / 𝓘 M)`, through the braiding -/

/-- The map `𝓘 M ⊗_{𝒪_X} 𝓘 ⁿ ⟶ M ⊗_{𝒪_X} 𝓘 ⁿ` induced by the inclusion `𝓘 M ⟶ M`. -/
public noncomputable abbrev idealTensorIdealPowMap :
    tensorModules (idealPowSmul J 1 M) (idealPow J n) ⟶ tensorModules M (idealPow J n) :=
  (Functor.uncurry.obj (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf)).map
    (X := (idealPowSmul J 1 M, idealPow J n)) (Y := (M, idealPow J n))
    ((Stacks.Algebraization.idealPowerMultiple J 1 M).ι, 𝟙 (idealPow J n))

/-- The map `M ⊗_{𝒪_X} 𝓘 ⁿ ⟶ (M / 𝓘 M) ⊗_{𝒪_X} 𝓘 ⁿ` induced by the projection `M ⟶ M / 𝓘 M`. -/
public noncomputable abbrev quotientTensorIdealPowMap :
    tensorModules M (idealPow J n) ⟶
      tensorModules (Stacks.Algebraization.idealPowerQuotient J 1 M) (idealPow J n) :=
  (Functor.uncurry.obj (Stacks.SheafOfModules.Tensor.sheafTensor.{u, u, u, u, u} X.sheaf)).map
    (X := (M, idealPow J n))
    (Y := (Stacks.Algebraization.idealPowerQuotient J 1 M, idealPow J n))
    (cokernel.π (C := X.Modules) (Stacks.Algebraization.idealPowerMultiple J 1 M).ι,
      𝟙 (idealPow J n))

/-- The braiding `M ⊗_{𝒪_X} 𝓘 ⁿ ≅ 𝓘 ⁿ ⊗_{𝒪_X} M`. -/
public noncomputable abbrev moduleIdealPowSwap :
    tensorModules M (idealPow J n) ≅ tensorModules (idealPow J n) M :=
  Stacks.SheafOfModules.TensorPresentations.tensorSheafSwap X.toRingedSpace M (idealPow J n)

/-- **`M ⊗ 𝓘 ⁿ ⟶ 𝓘 ⁿ M / 𝓘 ⁿ⁺¹ M`**, the epimorphism of the previous section read on the side
where right exactness of the tensor product is available. -/
public noncomputable def moduleTensorIdealPowToGradedPiece [M.IsQuasicoherent] :
    tensorModules M (idealPow J n) ⟶ adicGradedPieceModule J M n :=
  (moduleIdealPowSwap J M n).hom ≫ idealPowTensorToGradedPiece J M n

/-- `M ⊗ 𝓘 ⁿ ⟶ 𝓘 ⁿ M / 𝓘 ⁿ⁺¹ M` is an epimorphism. -/
public lemma epi_moduleTensorIdealPowToGradedPiece [M.IsQuasicoherent] :
    Epi (moduleTensorIdealPowToGradedPiece J M n) :=
  @epi_comp _ _ _ _ _ (moduleIdealPowSwap J M n).hom inferInstance
    (idealPowTensorToGradedPiece J M n) (epi_idealPowTensorToGradedPiece J M n)

/-- **The composite `𝓘 M ⊗ 𝓘 ⁿ ⟶ M ⊗ 𝓘 ⁿ ⟶ 𝓘 ⁿ M / 𝓘 ⁿ⁺¹ M` is zero**, by naturality of the
braiding and the vanishing of the composite on the other side. -/
public theorem idealTensorIdealPow_comp_toGradedPiece [M.IsQuasicoherent] :
    idealTensorIdealPowMap J M n ≫ moduleTensorIdealPowToGradedPiece J M n = 0 :=
  Stacks.Abelian.comp_comp_eq_zero_of_comp_eq (idealTensorIdealPowMap J M n)
    (moduleIdealPowSwap J M n).hom
    (Stacks.SheafOfModules.TensorPresentations.tensorSheafSwap X.toRingedSpace
      (idealPowSmul J 1 M) (idealPow J n)).hom
    (idealPowTensorIdealMap J M n) (idealPowTensorToGradedPiece J M n)
    (Stacks.SheafOfModules.TensorPresentations.tensorSheafSwap_naturality X.toRingedSpace
      (Stacks.Algebraization.idealPowerMultiple J 1 M).ι (𝟙 (idealPow J n))).symm
    (idealPowTensorIdeal_comp_toGradedPiece J M n)

/-- **`M ⊗ 𝓘 ⁿ ⟶ (M / 𝓘 M) ⊗ 𝓘 ⁿ` is an epimorphism**: this is exactness of [Stacks, Tag 01CC]
at the last nonzero term, tensoring on the right by `𝓘 ⁿ`. -/
public lemma epi_quotientTensorIdealPowMap : Epi (quotientTensorIdealPowMap J M n) :=
  @AlgebraicGeometry.SheafOfModules.tensorSheafMap_epi X.toRingedSpace _ _ (idealPow J n)
    (cokernel.π (C := X.Modules) (Stacks.Algebraization.idealPowerMultiple J 1 M).ι)
    (epi_adicIdealShortComplex_g J M)

/-- The composite `𝓘 M ⊗ 𝓘 ⁿ ⟶ M ⊗ 𝓘 ⁿ ⟶ (M / 𝓘 M) ⊗ 𝓘 ⁿ` is zero. -/
public lemma idealTensorIdealPow_comp_quotientTensorIdealPowMap :
    idealTensorIdealPowMap J M n ≫ quotientTensorIdealPowMap J M n = 0 :=
  (@AlgebraicGeometry.SheafOfModules.tensorSheafMap_exact X.toRingedSpace
    (adicIdealShortComplex J M) (idealPow J n) (adicIdealShortComplex_exact J M)
    (epi_adicIdealShortComplex_g J M)).choose

/-- **`𝓘 M ⊗ 𝓘 ⁿ ⟶ M ⊗ 𝓘 ⁿ ⟶ (M / 𝓘 M) ⊗ 𝓘 ⁿ` is exact**: this is exactness of
[Stacks, Tag 01CC] at the middle term, tensoring on the right by `𝓘 ⁿ`. -/
public lemma exact_idealTensorIdealPow :
    (ShortComplex.mk (idealTensorIdealPowMap J M n) (quotientTensorIdealPowMap J M n)
      (idealTensorIdealPow_comp_quotientTensorIdealPowMap J M n)).Exact :=
  (@AlgebraicGeometry.SheafOfModules.tensorSheafMap_exact X.toRingedSpace
    (adicIdealShortComplex J M) (idealPow J n) (adicIdealShortComplex_exact J M)
    (epi_adicIdealShortComplex_g J M)).choose_spec

/-- **`(M / 𝓘 M) ⊗ 𝓘 ⁿ ⟶ 𝓘 ⁿ M / 𝓘 ⁿ⁺¹ M`**, the descent of
`moduleTensorIdealPowToGradedPiece` along the cokernel presentation of `(M / 𝓘 M) ⊗ 𝓘 ⁿ`. -/
public noncomputable def quotientTensorIdealPowToGradedPiece [M.IsQuasicoherent] :
    tensorModules (Stacks.Algebraization.idealPowerQuotient J 1 M) (idealPow J n) ⟶
      adicGradedPieceModule J M n :=
  Stacks.Abelian.exactDesc (exact_idealTensorIdealPow J M n)
    (epi_quotientTensorIdealPowMap J M n) (idealTensorIdealPow_comp_toGradedPiece J M n)

/-- The descent is an epimorphism, the map it descends being one. -/
public lemma epi_quotientTensorIdealPowToGradedPiece [M.IsQuasicoherent] :
    Epi (quotientTensorIdealPowToGradedPiece J M n) :=
  Stacks.Abelian.epi_exactDesc _ _ _ (epi_moduleTensorIdealPowToGradedPiece J M n)

/-- The braiding `𝓘 ⁿ ⊗_{𝒪_X} (M / 𝓘 M) ≅ (M / 𝓘 M) ⊗_{𝒪_X} 𝓘 ⁿ`. -/
public noncomputable abbrev idealPowQuotientSwap :
    tensorModules (idealPow J n) (Stacks.Algebraization.idealPowerQuotient J 1 M) ≅
      tensorModules (Stacks.Algebraization.idealPowerQuotient J 1 M) (idealPow J n) :=
  Stacks.SheafOfModules.TensorPresentations.tensorSheafSwap X.toRingedSpace (idealPow J n)
    (Stacks.Algebraization.idealPowerQuotient J 1 M)

/-- **The surjection `𝓘 ⁿ ⊗_{𝒪_X} (M / 𝓘 M) ⟶ 𝓘 ⁿ M / 𝓘 ⁿ⁺¹ M`** of step (b) of
[Stacks, Tag 0EXD], with the un-quotiented `𝓘 ⁿ` as its left factor. -/
public noncomputable def idealPowTensorQuotientToGradedPiece [M.IsQuasicoherent] :
    tensorModules (idealPow J n) (Stacks.Algebraization.idealPowerQuotient J 1 M) ⟶
      adicGradedPieceModule J M n :=
  (idealPowQuotientSwap J M n).hom ≫ quotientTensorIdealPowToGradedPiece J M n

/-- **`𝓘 ⁿ ⊗_{𝒪_X} (M / 𝓘 M) ⟶ 𝓘 ⁿ M / 𝓘 ⁿ⁺¹ M` is an epimorphism.** -/
public lemma epi_idealPowTensorQuotientToGradedPiece [M.IsQuasicoherent] :
    Epi (idealPowTensorQuotientToGradedPiece J M n) :=
  @epi_comp _ _ _ _ _ (idealPowQuotientSwap J M n).hom inferInstance
    (quotientTensorIdealPowToGradedPiece J M n)
    (epi_quotientTensorIdealPowToGradedPiece J M n)

/-! ### The graded piece is generated by global sections -/

/-- **The graded piece `𝓘 ⁿ M / 𝓘 ⁿ⁺¹ M` of the `𝓘`-adic filtration is generated by global
sections**, given that `𝓘 ⁿ` and `M / 𝓘 M` are.

The products of the two given families generate `𝓘 ⁿ ⊗_{𝒪_X} (M / 𝓘 M)`
([Stacks, Tag 01AO]), and that module surjects onto the graded piece. -/
public noncomputable def generatingSectionsAdicGradedPiece [M.IsQuasicoherent]
    (hI : (idealPow J n).GeneratingSections)
    (hM : (Stacks.Algebraization.idealPowerQuotient J 1 M).GeneratingSections) :
    (adicGradedPieceModule J M n).GeneratingSections :=
  @SheafOfModules.GeneratingSections.ofEpi _ _ _ _ _ _ _ _
    (Stacks.SheafOfModules.tensorSheafGeneratingSections X.toRingedSpace _ _ hI hM)
    (idealPowTensorQuotientToGradedPiece J M n)
    (epi_idealPowTensorQuotientToGradedPiece J M n)

end Stacks.Cohomology.FormalFunctions

