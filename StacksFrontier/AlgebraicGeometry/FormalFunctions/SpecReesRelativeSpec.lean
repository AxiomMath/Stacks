module

public import StacksFrontier.AlgebraicGeometry.FormalFunctions.BaseReesPullbackClosedImmersion
public import StacksFrontier.AlgebraicGeometry.RelativeSpecBaseChange.AffineAlgebraHom
public import StacksFrontier.AlgebraicGeometry.RelativeSpecOpenRestriction.RelativeSpecBaseChange

/-!
# `Spec_{Spec A}(B̃) = Spec B`, and `Spec(B) ×_{Spec A} X = Spec_X(f^* B̃)`

Let `A` be a ring, `I ⊆ A` an ideal, `B = reesAlgebra I` its Rees algebra and `f : X ⟶ Spec A` a
morphism of schemes. Write `Ĩ` for the quasi-coherent ideal sheaf on `Spec A` generated by `I`
and `B̃ = ⨁_{n ≥ 0} Ĩⁿ` for its Rees algebra sheaf.

This file identifies `Spec_{Spec A}(B̃)` with `Spec B` over `Spec A`, and the base change
`Spec(B) ×_{Spec A} X` with the relative spectrum over `X` of the algebra pullback of `B̃`
([Stacks, Tag 01LX] part (2)). A morphism of algebra sheaves `ψ : f^* B̃ ⟶ ⨁_{n ≥ 0} ℐⁿ`, with
`ℐ = I · 𝒪_X`, then gives a morphism from `X' = Spec_X(⨁_{n ≥ 0} ℐⁿ)` to that base change,
which is a closed immersion when `ψ` is locally surjective.

## Main definitions

* `Stacks.Blowup.reesAlgebraCongr`: transport of the Rees algebra along a ring isomorphism
  carrying one ideal to the other.
* `Stacks.RelativeSpec.AlgebraSheaf.isoOfSectionsIso` and
  `Stacks.RelativeSpec.AlgebraSheaf.isoOfSectionsRingEquiv`: over an affine base, an isomorphism
  of the global sections of two quasi-coherent algebra sheaves compatible with their structure
  maps is an isomorphism of algebra sheaves.
* `Stacks.Cohomology.FormalFunctions.specReesAlgebraSheaf`: `B̃` as a sheaf of commutative
  algebras on `Spec A`.
* `Stacks.Cohomology.FormalFunctions.specReesSectionsEquiv`: `Γ(Spec A, B̃) ≅ reesAlgebra I`.
* `Stacks.Cohomology.FormalFunctions.reesRelativeSpecToPullback`: the morphism
  `X' ⟶ Spec(B) ×_{Spec A} X` attached to a morphism of algebra sheaves
  `ψ : f^* B̃ ⟶ ⨁_{n ≥ 0} ℐⁿ`.

## Main results

* `Stacks.Cohomology.FormalFunctions.specReesRelativeSpecIso`: **`Spec_{Spec A}(B̃) ≅ Spec B`**
  over `Spec A`.
* `Stacks.Cohomology.FormalFunctions.reesBaseChangeRelativeSpecIso`: **`Spec(B) ×_{Spec A} X` is
  `Spec_X(f^* B̃)`**, the relative spectrum of the algebra pullback of `B̃`.
* `Stacks.Cohomology.FormalFunctions.isClosedImmersion_reesRelativeSpecToPullback`: a *locally
  surjective* morphism of algebra sheaves `ψ : f^* B̃ ⟶ ⨁ₙ ℐⁿ` exhibits `X'` as a closed
  subscheme of the honest base change.
* `Stacks.Cohomology.FormalFunctions.isCohomologyReesFiniteOfGradedModule_of_algebraPullbackHom`:
  [Stacks, Tag 02O8]'s hypothesis `h0897` at one graded module, granted a locally surjective `ψ`.

## References

* [Stacks Project, Tag 0897](https://stacks.math.columbia.edu/tag/0897)
* [Stacks Project, Tag 02O8](https://stacks.math.columbia.edu/tag/02O8)
* [Stacks Project, Tag 01LX](https://stacks.math.columbia.edu/tag/01LX)
* [Stacks Project, Tag 01S8](https://stacks.math.columbia.edu/tag/01S8)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open Stacks.Blowup Stacks.RelativeSpec Stacks.AffineAlgebraEquivalence
open Stacks.AlgebraicGeometry.GradedProperCohomology
open scoped DirectSum

universe u

namespace Stacks.Blowup

/-! ### Transport of the Rees algebra along a ring isomorphism -/

variable {R R' : Type*} [CommRing R] [CommRing R'] (e : R ≃+* R')

/-- **A polynomial lies in the Rees algebra of `I` exactly when its image lies in the Rees
algebra of `I.map e`**, for a ring isomorphism `e`. -/
theorem mem_reesAlgebra_map_iff {I : Ideal R} {J : Ideal R'}
    (h : J = I.map (e : R →+* R')) (f : Polynomial R) :
    f.map (e : R →+* R') ∈ reesAlgebra J ↔ f ∈ reesAlgebra I := by
  subst h
  simp only [mem_reesAlgebra_iff, Polynomial.coeff_map, ← Ideal.map_pow]
  refine forall_congr' fun i => ?_
  exact Ideal.apply_mem_of_equiv_iff (f := e) (I := I ^ i) (x := f.coeff i)

/-- **Transport of the Rees algebra along a ring isomorphism** carrying `I` to `J`: apply `e` to
the coefficients. -/
def reesAlgebraCongr {I : Ideal R} {J : Ideal R'} (h : J = I.map (e : R →+* R')) :
    ↥(reesAlgebra I) ≃+* ↥(reesAlgebra J) where
  toFun x := ⟨(x : Polynomial R).map (e : R →+* R'), (mem_reesAlgebra_map_iff e h _).2 x.2⟩
  invFun y := ⟨(y : Polynomial R').map (e.symm : R' →+* R), by
    refine (mem_reesAlgebra_map_iff e h _).1 ?_
    rw [Polynomial.map_map]
    simp⟩
  left_inv x := by ext1; simp [Polynomial.map_map]
  right_inv y := by ext1; simp [Polynomial.map_map]
  map_mul' x y := by ext1; simp
  map_add' x y := by ext1; simp

/-- The transport of the Rees algebra carries the structural map of `R` to that of `R'`: a
constant polynomial goes to a constant polynomial. -/
theorem reesAlgebraCongr_algebraMap {I : Ideal R} {J : Ideal R'}
    (h : J = I.map (e : R →+* R')) (r : R) :
    reesAlgebraCongr e h (algebraMap R ↥(reesAlgebra I) r)
      = algebraMap R' ↥(reesAlgebra J) (e r) := by
  ext1
  simp [reesAlgebraCongr]

end Stacks.Blowup

namespace Stacks.RelativeSpec.AlgebraSheaf

/-! ### Isomorphisms of algebra sheaves over an affine base -/

variable {X : Scheme.{u}} [IsAffine X] (A B : AlgebraSheaf.{u} X)
  [A.IsQuasicoherent] [B.IsQuasicoherent]

/-- **Over an affine base, an isomorphism of the global sections of two quasi-coherent algebra
sheaves compatible with their structure maps is an isomorphism of algebra sheaves.** -/
def isoOfSectionsIso (e : A.sections ⊤ ≅ B.sections ⊤)
    (he : A.unitTop ≫ e.hom = B.unitTop) : A ≅ B :=
  have he' : B.unitTop ≫ e.inv = A.unitTop := by
    rw [← he, Category.assoc, e.hom_inv_id, Category.comp_id]
  { hom := algebraHom A B he
    inv := algebraHom B A he'
    hom_inv_id := by
      refine Under.UnderMorphism.ext (Sheaf.hom_ext (hom_ext_app_top A ?_))
      change (algebraHom A B he).right.hom.app (op ⊤) ≫
        (algebraHom B A he').right.hom.app (op ⊤) = _
      rw [algebraHom_right_app_top, algebraHom_right_app_top, e.hom_inv_id]
      rfl
    inv_hom_id := by
      refine Under.UnderMorphism.ext (Sheaf.hom_ext (hom_ext_app_top B ?_))
      change (algebraHom B A he').right.hom.app (op ⊤) ≫
        (algebraHom A B he).right.hom.app (op ⊤) = _
      rw [algebraHom_right_app_top, algebraHom_right_app_top, e.inv_hom_id]
      rfl }

/-- `Stacks.RelativeSpec.AlgebraSheaf.isoOfSectionsIso` from a *ring* isomorphism of the global
sections. -/
def isoOfSectionsRingEquiv (ρ : ↥(A.sections ⊤) ≃+* ↥(B.sections ⊤))
    (hρ : ∀ r, ρ (A.unitTop.hom r) = B.unitTop.hom r) : A ≅ B :=
  isoOfSectionsIso A B
    { hom := CommRingCat.ofHom (ρ : ↥(A.sections ⊤) →+* ↥(B.sections ⊤))
      inv := CommRingCat.ofHom (ρ.symm : ↥(B.sections ⊤) →+* ↥(A.sections ⊤))
      hom_inv_id := CommRingCat.hom_ext (RingHom.ext fun x => ρ.symm_apply_apply x)
      inv_hom_id := CommRingCat.hom_ext (RingHom.ext fun x => ρ.apply_symm_apply x) }
    (CommRingCat.hom_ext (RingHom.ext hρ))

end Stacks.RelativeSpec.AlgebraSheaf

namespace Stacks.Cohomology.FormalFunctions

variable {A : Type u} [CommRing A] (I : Ideal A)

/-! ### `B̃` on the base, and its global sections -/

/-- **`B̃ = ⨁_{n ≥ 0} Ĩⁿ` as a sheaf of commutative `𝒪_{Spec A}`-algebras**: the Rees algebra
sheaf of `Ĩ`. -/
abbrev specReesAlgebraSheaf : AlgebraSheaf (Spec (.of A)) :=
  reesAlgebraSheaf (specIdealSheaf I)

/-- `Γ(Spec A, ⊤) ≅ A` as a ring isomorphism, in the direction in which
`Stacks.Cohomology.FormalFunctions.specIdealSheaf` pushes `I` forward. -/
abbrev specTopEquiv : A ≃+* ↥Γ(Spec (.of A), ⊤) :=
  (Scheme.ΓSpecIso (.of A)).symm.commRingCatIsoToRingEquiv

/-- `Ĩ(Spec A) = I`, read through `Γ(Spec A, ⊤) ≅ A`: the ideal sheaf `Ĩ` is by definition the
one induced by the image of `I` in the global sections. -/
theorem specIdealSheaf_ideal_top :
    (specIdealSheaf I).ideal ⟨⊤, isAffineOpen_top _⟩
      = I.map ((specTopEquiv (A := A)) : A →+* ↥Γ(Spec (.of A), ⊤)) := by
  rw [show ((specTopEquiv (A := A)) : A →+* ↥Γ(Spec (.of A), ⊤))
    = (Scheme.ΓSpecIso (.of A)).inv.hom from rfl]
  simp

/-- **`Γ(Spec A, B̃) ≅ reesAlgebra I`**: over the whole of `Spec A` the sections of `B̃ = ⨁ₙ Ĩⁿ`
are the ordinary Rees algebra of `I`. -/
def specReesSectionsEquiv : ↥(reesAlgebra I) ≃+* ↥((specReesAlgebraSheaf I).sections ⊤) :=
  (reesAlgebraCongr (specTopEquiv (A := A)) (specIdealSheaf_ideal_top I)).trans
    (reesSectionsRingEquiv (specIdealSheaf I) ⟨⊤, isAffineOpen_top _⟩)

/-- The identification of `Γ(Spec A, B̃)` with `reesAlgebra I` carries `algebraMap` to the
structural map of the algebra sheaf. -/
theorem specReesSectionsEquiv_algebraMap (r : A) :
    specReesSectionsEquiv I (algebraMap A ↥(reesAlgebra I) r)
      = (specReesAlgebraSheaf I).unitTop.hom (specTopEquiv r) := by
  show reesSectionsRingEquiv (specIdealSheaf I) ⟨⊤, isAffineOpen_top _⟩
    (reesAlgebraCongr (specTopEquiv (A := A)) (specIdealSheaf_ideal_top I)
      (algebraMap A ↥(reesAlgebra I) r)) = _
  rw [reesAlgebraCongr_algebraMap]
  exact reesSectionsRingEquiv_algebraMap (specIdealSheaf I) ⟨⊤, isAffineOpen_top _⟩ _

/-! ### `Spec_{Spec A}(B̃) = Spec B` -/

/-- The ring isomorphism of global sections between `B̃` and the pushed-forward structure sheaf of
`Spec B ⟶ Spec A`: both are `reesAlgebra I`, the first by
`Stacks.Cohomology.FormalFunctions.specReesSectionsEquiv` and the second by
`Γ(Spec B, ⊤) ≅ B`. -/
def specReesPushforwardSectionsEquiv :
    ↥((specReesAlgebraSheaf I).sections ⊤) ≃+*
      ↥((pushforwardAlgebra (reesSpecToBase I)).sections ⊤) :=
  (specReesSectionsEquiv I).symm.trans
    (Scheme.ΓSpecIso (.of ↥(reesAlgebra I))).symm.commRingCatIsoToRingEquiv

/-- The identification of global sections is compatible with the two structure maps. -/
theorem specReesPushforwardSectionsEquiv_unitTop (r : ↥Γ(Spec (.of A), ⊤)) :
    specReesPushforwardSectionsEquiv I ((specReesAlgebraSheaf I).unitTop.hom r)
      = (pushforwardAlgebra (reesSpecToBase I)).unitTop.hom r := by
  have hsym : (specReesSectionsEquiv I).symm ((specReesAlgebraSheaf I).unitTop.hom r)
      = algebraMap A ↥(reesAlgebra I) (specTopEquiv.symm r) := by
    refine (specReesSectionsEquiv I).injective ?_
    rw [RingEquiv.apply_symm_apply, specReesSectionsEquiv_algebraMap]
    simp
  have hnat := congrArg (fun k : CommRingCat.of A ⟶ Γ(Spec (.of ↥(reesAlgebra I)), ⊤) =>
      k.hom (specTopEquiv.symm r))
    (Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (algebraMap A ↥(reesAlgebra I))))
  show (Scheme.ΓSpecIso (.of ↥(reesAlgebra I))).inv.hom
    ((specReesSectionsEquiv I).symm ((specReesAlgebraSheaf I).unitTop.hom r)) = _
  rw [hsym]
  refine hnat.trans ?_
  show (reesSpecToBase I).appTop.hom
    ((Scheme.ΓSpecIso (.of A)).inv.hom (specTopEquiv.symm r)) = _
  congr 1
  show specTopEquiv (A := A) (specTopEquiv.symm r) = r
  simp

/-- **`B̃` is the pushed-forward structure sheaf of `Spec B ⟶ Spec A`.** -/
def specReesAlgebraSheafIso :
    specReesAlgebraSheaf I ≅ pushforwardAlgebra (reesSpecToBase I) :=
  letI := isQuasicoherent_pushforwardAlgebra (reesSpecToBase I)
  AlgebraSheaf.isoOfSectionsRingEquiv _ _ (specReesPushforwardSectionsEquiv I)
    (specReesPushforwardSectionsEquiv_unitTop I)

/-- **`Spec_{Spec A}(B̃) ≅ Spec B` over `Spec A`.** -/
def specReesRelativeSpecIso :
    (Over.mk (relativeSpecToBase (specReesAlgebraSheaf I)) : Over (Spec (.of A)))
      ≅ Over.mk (reesSpecToBase I) :=
  letI := isQuasicoherent_pushforwardAlgebra (reesSpecToBase I)
  (relativeSpecOverIso (specReesAlgebraSheafIso I)).trans
    (overRelativeSpecIso (reesSpecToBase I)).symm

/-! ### `Spec(B) ×_{Spec A} X = Spec_X(f^* B̃)` -/

variable (X : Over (Spec (.of A)))

/-- **The honest base change `Spec(B) ×_{Spec A} X` is `Spec_X(f^* B̃)`**, the relative spectrum
over `X` of the algebra pullback of `B̃`. -/
def reesBaseChangeRelativeSpecIso :
    (Over.pullback X.hom).obj (Over.mk (reesSpecToBase I))
      ≅ Over.mk (relativeSpecToBase
          ((algebraPullback X.hom).obj (specReesAlgebraSheaf I))) :=
  ((Over.pullback X.hom).mapIso (specReesRelativeSpecIso I).symm).trans
    (relativeSpecBaseChangeIso X.hom (specReesAlgebraSheaf I))

/-- The morphism `X' = Spec_X(⨁ₙ ℐⁿ) ⟶ Spec(B) ×_{Spec A} X` attached to a morphism of algebra
sheaves `ψ : f^* B̃ ⟶ ⨁_{n ≥ 0} ℐⁿ`: the relative spectrum of `ψ`, followed by the identification
of `Spec_X(f^* B̃)` with the base change. -/
def reesRelativeSpecToPullback
    (ψ : (algebraPullback X.hom).obj (specReesAlgebraSheaf I) ⟶
      reesAlgebraSheaf (baseIdealSheaf A I X.hom)) :
    (reesRelativeSpec I X).left ⟶ pullback (reesSpecToBase I) X.hom :=
  (relativeSpecMapOfAlgebraHom ((algebraPullback X.hom).obj (specReesAlgebraSheaf I))
      (reesAlgebraSheaf (baseIdealSheaf A I X.hom)) ψ).left ≫
    (reesBaseChangeRelativeSpecIso I X).inv.left

/-- **A locally surjective `ψ : f^* B̃ ⟶ ⨁_{n ≥ 0} ℐⁿ` exhibits `X' = Spec_X(⨁ₙ ℐⁿ)` as a closed
subscheme of the honest base change `Spec(B) ×_{Spec A} X`.** -/
theorem isClosedImmersion_reesRelativeSpecToPullback
    (ψ : (algebraPullback X.hom).obj (specReesAlgebraSheaf I) ⟶
      reesAlgebraSheaf (baseIdealSheaf A I X.hom))
    (hψ : CategoryTheory.Sheaf.IsLocallySurjective ψ.right) :
    AlgebraicGeometry.IsClosedImmersion (reesRelativeSpecToPullback I X ψ) :=
  have hci := Stacks.RelativeSpecClosedImmersion.isClosedImmersion_relativeSpecMapOfAlgebraHom
    ((algebraPullback X.hom).obj (specReesAlgebraSheaf I))
    (reesAlgebraSheaf (baseIdealSheaf A I X.hom)) ψ hψ
  have : IsIso (reesBaseChangeRelativeSpecIso I X).inv.left :=
    show IsIso ((Over.forget X.left).map (reesBaseChangeRelativeSpecIso I X).inv) from
      inferInstance
  @AlgebraicGeometry.IsClosedImmersion.comp _ _ _ _ _ hci inferInstance

/-! ### `h0897` for the Rees algebra, reduced to one locally surjective algebra map -/

attribute [local instance] cohomologyGradedModule

/-- **[Stacks, Tag 02O8]'s hypothesis `h0897` at one graded module, granted a morphism of
algebra sheaves.**

Same statement as
`Stacks.Cohomology.FormalFunctions.isCohomologyReesFiniteOfGradedModule_of_closedImmersion`,
except that the closed immersion `X' ⟶ Spec(B) ×_{Spec A} X` is replaced by a *locally
surjective* morphism of sheaves of commutative `𝒪_X`-algebras
`ψ : f^* B̃ ⟶ ⨁_{n ≥ 0} ℐⁿ`, with `f^* B̃` the algebra pullback. -/
theorem isCohomologyReesFiniteOfGradedModule_of_algebraPullbackHom [IsNoetherianRing A]
    (M : SheafOfModules.GradedModule.{u, u, u} (baseReesAlgebra I X)) (p : ℕ)
    (hX : AlgebraicGeometry.IsProper X.hom)
    (hqc : ∀ n : ℤ, (pieceModule M n).IsQuasicoherent)
    (hft : M.IsFiniteType)
    (hneg : ∀ n : ℤ, n < 0 → IsZero (M.piece n : X.left.Modules))
    (ψ : (algebraPullback X.hom).obj (specReesAlgebraSheaf I) ⟶
      reesAlgebraSheaf (baseIdealSheaf A I X.hom))
    (hψ : CategoryTheory.Sheaf.IsLocallySurjective ψ.right)
    (F' : (reesRelativeSpec I X).left.Modules) [F'.IsCoherent]
    (cmp :
      letI := gradedCohomologySumModuleRees I X M p hneg
      gradedCohomologySum M p ≃ₗ[↥(reesAlgebra I)]
        ↥((ModuleCat.restrictScalars (specAlgebraRingHom ↥(reesAlgebra I)
            (reesRelativeSpecToPullback I X ψ ≫
              pullback.fst (reesSpecToBase I) X.hom))).obj
          (cohomologyOf (reesRelativeSpec I X).left p F'))) :
    IsCohomologyReesFiniteOfGradedModule I X M p :=
  isCohomologyReesFiniteOfGradedModule_of_closedImmersion I X M p hX hqc hft hneg
    (reesRelativeSpecToPullback I X ψ)
    (isClosedImmersion_reesRelativeSpecToPullback I X ψ hψ) F' cmp

end Stacks.Cohomology.FormalFunctions

end
