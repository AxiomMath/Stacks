module

public import StacksFrontier.AlgebraicGeometry.FormalFunctions.BaseReesPullbackLocallySurjective
public import StacksFrontier.AlgebraicGeometry.FormalFunctions.CohomologyGradedReesBaseChange
public import StacksFrontier.AlgebraicGeometry.RelativeSpecClosedImmersion.Basic

/-!
# `Spec_X(⨁ₙ ℐⁿ)` is a closed subscheme of `Spec_X(f^* B̃)`

Let `A` be a ring, `I ⊆ A` an ideal and `f : X ⟶ Spec A` a morphism of schemes. Write
`Ĩ` for the quasi-coherent ideal sheaf on `Spec A` generated by `I`, `B̃ = ⨁_{n ≥ 0} Ĩⁿ` for its
Rees algebra, and `ℐ = I · 𝒪_X`. The comparison `Φ : f^* B̃ ⟶ ⨁_{n ≥ 0} ℐⁿ` of
`Stacks.Cohomology.FormalFunctions.baseReesPullbackHom` is not an isomorphism in general, not even
for a proper `f`, but it is locally surjective in every degree. This file shows that the relative
spectra of both sheaves of graded algebras exist and that the induced morphism

`Spec_X(⨁_{n ≥ 0} ℐⁿ) ⟶ Spec_X(f^* B̃)`

is a closed immersion, with no hypothesis on `f`.

## Main definitions

* `Stacks.Cohomology.FormalFunctions.specReesPullbackAlgebra`: `𝓑 = f^* B̃`, the pullback along
  `f` of the Rees algebra of `Ĩ`, as a sheaf of graded algebras.
* `Stacks.Cohomology.FormalFunctions.specReesPullbackAlgebraSheaf`: the same, as a sheaf of
  commutative `𝒪_X`-algebras.
* `Stacks.Cohomology.FormalFunctions.specReesPullbackAlgebraSheafMap`: `Φ` as a morphism of
  algebra sheaves.

## Main results

* `Stacks.Cohomology.FormalFunctions.specReesPullbackAlgebra_mul_comm`: the homogeneous
  multiplication of `f^* B̃` is commutative.
* `Stacks.Cohomology.FormalFunctions.isQuasicoherent_specReesPullbackAlgebraSheaf`: `f^* B̃` is
  quasi-coherent as a sheaf of algebras.
* `Stacks.Cohomology.FormalFunctions.isLocallySurjective_specReesPullbackAlgebraSheafMap`: `Φ` is
  locally surjective as a morphism of algebra sheaves.
* `Stacks.Cohomology.FormalFunctions.isClosedImmersion_reesRelativeSpecToSpecReesPullback`:
  `Spec_X(⨁ₙ ℐⁿ) ⟶ Spec_X(f^* B̃)` is a closed immersion, for an arbitrary `f`.

## References

* [Stacks Project, Tag 0897](https://stacks.math.columbia.edu/tag/0897)
* [Stacks Project, Tag 02O8](https://stacks.math.columbia.edu/tag/02O8)
* [Stacks Project, Tag 01LX](https://stacks.math.columbia.edu/tag/01LX)
* [Stacks Project, Tag 01S8](https://stacks.math.columbia.edu/tag/01S8)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite TopologicalSpace
open Stacks.Blowup Stacks.RelativeSpec Stacks.AffineAlgebraEquivalence

universe u

namespace Stacks.Cohomology.FormalFunctions

variable {A : Type u} [CommRing A] (I : Ideal A) (X : Over (Spec (.of A)))

/-! ### `𝓑 = f^* B̃` as a sheaf of commutative algebras -/

/-- `𝓑 = f^* B̃`, the pullback along `f : X ⟶ Spec A` of the Rees algebra of `Ĩ`, as a sheaf of
graded algebras. -/
abbrev specReesPullbackAlgebra : SheafOfModules.GradedAlgebra.{u, u} X.left.ringCatSheaf :=
  Stacks.Conormal.gradedPullback X.hom (specReesAlgebra I)

/-- The homogeneous multiplication of `f^* B̃` is commutative. -/
theorem specReesPullbackAlgebra_mul_comm (i j : ℤ) (W : (Opens ↥X.left)ᵒᵖ)
    (a : ((specReesPullbackAlgebra I X).piece i).val.obj W)
    (b : ((specReesPullbackAlgebra I X).piece j).val.obj W) :
    HEq (((specReesPullbackAlgebra I X).mul i j).app W a b)
      (((specReesPullbackAlgebra I X).mul j i).app W b a) :=
  Stacks.Conormal.gradedPullback_mul_comm X.hom (specReesAlgebra I)
    (fun i j W a b => reesMultiplication_comm (specIdealSheaf I) i j W a b) i j W a b

/-- `𝓑 = f^* B̃` as a sheaf of commutative `𝒪_X`-algebras. -/
abbrev specReesPullbackAlgebraSheaf : AlgebraSheaf X.left :=
  gradedAlgebraSheaf X.left (specReesPullbackAlgebra I X) (specReesPullbackAlgebra_mul_comm I X)

/-- `f^* B̃` is quasi-coherent as a sheaf of algebras. -/
instance isQuasicoherent_specReesPullbackAlgebraSheaf :
    AlgebraSheaf.IsQuasicoherent (specReesPullbackAlgebraSheaf I X) :=
  isQuasicoherent_gradedAlgebraSheaf X.left (specReesPullbackAlgebra I X) _
    (Stacks.Conormal.gradedPullback_negative_isZero X.hom (specReesAlgebra I)
      (reesPiece_negative_isZero (specIdealSheaf I)))
    (isQuasicoherent_coprod_of_small _ fun n : ℕ =>
      Stacks.Conormal.gradedPullback_isQuasicoherent X.hom (specReesAlgebra I)
        (reesPiece_isQuasicoherent (specIdealSheaf I)) (n : ℤ))

/-! ### `Φ` as a morphism of algebra sheaves -/

/-- `Φ : f^* B̃ ⟶ ⨁_{n ≥ 0} ℐⁿ` as a morphism of sheaves of commutative `𝒪_X`-algebras: the
ungraded realization of `Stacks.Cohomology.FormalFunctions.baseReesPullbackHom`. -/
def specReesPullbackAlgebraSheafMap :
    specReesPullbackAlgebraSheaf I X ⟶ reesAlgebraSheaf (baseIdealSheaf A I X.hom) :=
  gradedAlgebraSheafMap X.left (baseReesPullbackHom I X) (specReesPullbackAlgebra_mul_comm I X)
    (fun i j W a b => reesMultiplication_comm (baseIdealSheaf A I X.hom) i j W a b)

/-- The ungraded realization of `Φ` is locally surjective, for an arbitrary `f`. -/
theorem isLocallySurjective_specReesPullbackAlgebraSheafMap :
    Sheaf.IsLocallySurjective (specReesPullbackAlgebraSheafMap I X).right :=
  isLocallySurjective_gradedAlgebraSheafMap X.left (baseReesPullbackHom I X)
    (specReesPullbackAlgebra_mul_comm I X)
    (fun i j W a b => reesMultiplication_comm (baseIdealSheaf A I X.hom) i j W a b)
    (isLocallySurjective_baseReesPullbackHom_app I X)

/-! ### The closed immersion -/

/-- The morphism `Spec_X(⨁_{n ≥ 0} ℐⁿ) ⟶ Spec_X(f^* B̃)` induced by `Φ` is a closed immersion, for
an arbitrary `f : X ⟶ Spec A`. -/
theorem isClosedImmersion_reesRelativeSpecToSpecReesPullback :
    IsClosedImmersion (relativeSpecMapOfAlgebraHom (specReesPullbackAlgebraSheaf I X)
      (reesAlgebraSheaf (baseIdealSheaf A I X.hom))
      (specReesPullbackAlgebraSheafMap I X)).left :=
  Stacks.RelativeSpecClosedImmersion.isClosedImmersion_relativeSpecMapOfAlgebraHom _ _ _
    (isLocallySurjective_specReesPullbackAlgebraSheafMap I X)

end Stacks.Cohomology.FormalFunctions

end
