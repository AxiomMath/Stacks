module

public import StacksFrontier.AlgebraicGeometry.Examples.HironakaLocalModel.FirstBlowupCharts
public import StacksFrontier.AlgebraicGeometry.MoreMorphisms.CohenMacaulaySlice.Comap

/-!
# The strict-transform centre of the local model, on the charts of the first blow-up

Let `A = k[x, y, z]`, `I = (x, y)` and `J = (x - y², z)` on `Spec A`, and let
`J' = AlgebraicGeometry.TwoStepTower.strictCentre I J` be the ideal sheaf on `Bl_I Spec A` of the
strict transform of `V(J)`. On the two charts of
`StacksFrontier/AlgebraicGeometry/Examples/HironakaLocalModel/FirstBlowupCharts.lean`:

* on `U₂ = Spec k[x₁, y, z]` (`x = x₁·y`), `x - y² = y·(x₁ - y)` and `J' = (x₁ - y, z)`;
* on `U₁ = Spec k[x, y₁, z]` (`y = x·y₁`), `x - y² = x·(1 - x·y₁²)` and `J' = (1 - x·y₁², z)`.

## Main results

* `Stacks.Examples.HironakaLocalModel.comap_strictCentre_eq_ker`: for any open immersion
  `ι : V ⟶ Bl_I W`, the strict-transform centre restricted to `V` is the kernel of the inclusion
  in `V` of the part of `V(J·𝒪_V)` off the exceptional divisor.
* `Stacks.Examples.HironakaLocalModel.mem_ker_basicOpen_ι_iff`: on an affine scheme, the kernel
  of the inclusion of the part of `V(K)` where `e` is invertible is the `e`-saturation of `K`.
* `Stacks.Examples.HironakaLocalModel.comap_chartι_one_strictCentre` and
  `Stacks.Examples.HironakaLocalModel.comap_chartι_zero_strictCentre`: the two chart equations of
  the strict transform.

## Implementation notes

The strict transform is the scheme-theoretic image of the complement of the exceptional preimage
(`AlgebraicGeometry.TwoStepTower.strictCentre_eq_ker`), and kernels of quasi-compact morphisms
commute with restriction along open immersions of the target
(`AlgebraicGeometry.TwoStepTower.ker_eq_comap_of_isPullback`). The base change of
`V(J) ×_W Bl_I W ⟶ Bl_I W` along a chart `ι` is `V(J·𝒪_V)`, by the pasting of cartesian squares
`AlgebraicGeometry.TwoStepTower.isPullback_subschemeι_comap`, so the restriction of the strict
centre is the kernel of `V(J·𝒪_V) ∖ E ⟶ V`, and on an affine chart on which the exceptional ideal
is principal, generated by `e`, that kernel is the `e`-saturation of `J·𝒪_V`, read off from the
localization `Γ(V(K), D(e)) = Γ(V(K), ⊤)_e`.
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits MvPolynomial
open AlgebraicGeometry.TwoStepTower

universe u

namespace Stacks.Examples.HironakaLocalModel

/-! ### The strict-transform centre on an open of the blow-up -/

section General

variable {W V : Scheme.{u}} (I J : W.IdealSheafData) (ι : V ⟶ blowUp I)

/-- The comparison morphism `V(J·𝒪_V) ⟶ V(J) ×_W Bl_I W` over a morphism `ι : V ⟶ Bl_I W`. -/
def chartBaseChangeMap :
    (J.comap (ι ≫ blowUpToBase I)).subscheme ⟶ pullback J.subschemeι (blowUpToBase I) :=
  pullback.lift ((J.comapIso (ι ≫ blowUpToBase I)).hom ≫ pullback.snd _ _)
    ((J.comap (ι ≫ blowUpToBase I)).subschemeι ≫ ι) (by
      simp only [Category.assoc]
      rw [← pullback.condition, Scheme.IdealSheafData.comapIso_hom_fst_assoc])

/-- `V(J·𝒪_V)` is the base change along `ι` of `V(J) ×_W Bl_I W ⟶ Bl_I W`. -/
theorem isPullback_chartBaseChangeMap :
    IsPullback (chartBaseChangeMap I J ι) (J.comap (ι ≫ blowUpToBase I)).subschemeι
      (pullback.snd J.subschemeι (blowUpToBase I)) ι := by
  refine IsPullback.of_right ?_ (pullback.lift_snd _ _ _)
    (IsPullback.of_hasPullback J.subschemeι (blowUpToBase I))
  rw [chartBaseChangeMap, pullback.lift_fst]
  exact (isPullback_subschemeι_comap (ι ≫ blowUpToBase I) J).flip

/-- The exceptional complement pulls back to the part of `V(J·𝒪_V)` off the exceptional
divisor `V(I·𝒪_V)`. -/
theorem preimage_exceptionalComplement_chartBaseChangeMap :
    chartBaseChangeMap I J ι ⁻¹ᵁ
        Stacks.StrictTransform.exceptionalComplement J.subschemeι (blowUpToBase I)
          (exceptionalIdeal I) =
      (J.comap (ι ≫ blowUpToBase I)).subschemeι ⁻¹ᵁ
        (I.comap (ι ≫ blowUpToBase I)).support.compl := by
  ext x
  change (pullback.snd J.subschemeι (blowUpToBase I)).base ((chartBaseChangeMap I J ι).base x) ∈
      ((I.comap (blowUpToBase I)).support : Set (blowUp I))ᶜ ↔
    (J.comap (ι ≫ blowUpToBase I)).subschemeι.base x ∈
      ((I.comap (ι ≫ blowUpToBase I)).support : Set V)ᶜ
  rw [← Scheme.Hom.comp_apply, chartBaseChangeMap, pullback.lift_snd,
    Scheme.IdealSheafData.comap_comp I ι (blowUpToBase I), Scheme.Hom.comp_apply]
  simp only [Scheme.IdealSheafData.support_comap]
  rfl

variable [IsOpenImmersion ι]

/-- **The strict-transform centre on an open of the blow-up.** For an open immersion
`ι : V ⟶ Bl_I W`, the restriction to `V` of the ideal of the strict transform of `V(J)` is the
kernel of the inclusion in `V` of the part of `V(J·𝒪_V)` off `V(I·𝒪_V)`. -/
theorem comap_strictCentre_eq_ker :
    (strictCentre I J).comap ι =
      (((J.comap (ι ≫ blowUpToBase I)).subschemeι ⁻¹ᵁ
          (I.comap (ι ≫ blowUpToBase I)).support.compl).ι ≫
        (J.comap (ι ≫ blowUpToBase I)).subschemeι).ker := by
  have hsq := (isPullback_morphismRestrict (chartBaseChangeMap I J ι)
    (Stacks.StrictTransform.exceptionalComplement J.subschemeι (blowUpToBase I)
      (exceptionalIdeal I))).paste_vert (isPullback_chartBaseChangeMap I J ι)
  have hk := ker_eq_comap_of_isPullback hsq.flip
  rw [preimage_exceptionalComplement_chartBaseChangeMap] at hk
  rw [strictCentre_eq_ker, hk]

end General

/-! ### Kernels on affine schemes -/

section Affine

variable {Y : Scheme.{u}} [IsAffine Y]

/-- The ideal of global sections of `Scheme.IdealSheafData.ofIdealTop L` is `L`. -/
theorem ideal_top_ofIdealTop (L : Ideal Γ(Y, ⊤)) :
    (Scheme.IdealSheafData.ofIdealTop L).ideal ⟨⊤, isAffineOpen_top Y⟩ = L :=
  Scheme.IdealSheafData.equivOfIsAffine.apply_symm_apply L

/-- On an affine scheme, a global section vanishes on the basic open of `e` exactly when it is
killed by a power of `e`. -/
theorem appTop_basicOpen_ι_eq_zero_iff (e s : Γ(Y, ⊤)) :
    (Y.basicOpen e).ι.appTop.hom s = 0 ↔ ∃ n : ℕ, e ^ n * s = 0 := by
  rw [Scheme.Opens.ι_appTop]
  have key : ∀ (Z : Y.Opens) (_ : Z = Y.basicOpen e),
      (Y.presheaf.map (homOfLE (le_top : Z ≤ ⊤)).op).hom s = 0 ↔ ∃ n : ℕ, e ^ n * s = 0 := by
    rintro Z rfl
    let : Algebra Γ(Y, ⊤) Γ(Y, Y.basicOpen e) :=
      (Y.presheaf.map (homOfLE (le_top : Y.basicOpen e ≤ ⊤)).op).hom.toAlgebra
    have : IsLocalization.Away e Γ(Y, Y.basicOpen e) :=
      (isAffineOpen_top Y).isLocalization_basicOpen e
    refine (IsLocalization.map_eq_zero_iff (Submonoid.powers e) Γ(Y, Y.basicOpen e) s).trans ?_
    constructor
    · rintro ⟨⟨_, n, rfl⟩, h⟩
      exact ⟨n, h⟩
    · rintro ⟨n, h⟩
      exact ⟨⟨_, n, rfl⟩, h⟩
  exact key _ (Scheme.Opens.ι_image_top _)

/-- **The kernel off a principal divisor is the saturation.** On an affine scheme `Y`, for an
ideal sheaf `K` and a global section `e`, the kernel of the inclusion in `Y` of the part of
`V(K)` where `e` is invertible consists of the global sections `f` with `eⁿ·f ∈ K` for some
`n`. -/
theorem mem_ker_basicOpen_ι_iff (K : Y.IdealSheafData) (e f : Γ(Y, ⊤)) :
    f ∈ ((K.subschemeι ⁻¹ᵁ Y.basicOpen e).ι ≫ K.subschemeι).ker.ideal
        ⟨⊤, isAffineOpen_top Y⟩ ↔
      ∃ n : ℕ, e ^ n * f ∈ K.ideal ⟨⊤, isAffineOpen_top Y⟩ := by
  have : IsAffine K.subscheme := isAffine_of_isAffineHom K.subschemeι
  rw [Scheme.ker_of_isAffine, ideal_top_ofIdealTop,
    RingHom.mem_ker, Scheme.Hom.comp_appTop, CommRingCat.hom_comp, RingHom.comp_apply,
    Scheme.preimage_basicOpen_top, appTop_basicOpen_ι_eq_zero_iff]
  simp only [← map_pow, ← map_mul, ← RingHom.mem_ker]
  rw [show RingHom.ker K.subschemeι.appTop.hom = K.ideal ⟨⊤, isAffineOpen_top Y⟩ from
    Scheme.IdealSheafData.ker_subschemeι_app K ⟨⊤, isAffineOpen_top Y⟩]

end Affine

/-! ### Ideal sheaves of ideals of `k[x, y, z]` -/

section IdealSheaves

variable (k : Type u) [Field k]

/-- The inverse image of the ideal sheaf of `K` along `Spec φ` is the ideal sheaf of `φ(K)`. -/
theorem comap_specMap_idealSheafOf (φ : Ring3 k →+* Ring3 k) (K : Ideal (Ring3 k)) :
    (idealSheafOf k K).comap (Spec.map (CommRingCat.ofHom φ)) = idealSheafOf k (K.map φ) := by
  rw [idealSheafOf, Stacks.AlgebraicGeometry.comap_ofIdealTop, Ideal.map_map, idealSheafOf,
    Ideal.map_map, ← CommRingCat.hom_comp, ← Scheme.ΓSpecIso_inv_naturality]
  rfl

/-- The ideal sheaf of a principal ideal `(e)` is supported off the basic open of `e`. -/
theorem support_compl_idealSheafOf_span_singleton (e : Ring3 k) :
    (idealSheafOf k (Ideal.span {e})).support.compl = (ambient k).basicOpen (gammaEquiv k e) := by
  ext x
  change x ∉ (((idealSheafOf k (Ideal.span {e})).support : TopologicalSpace.Closeds (ambient k)) :
    Set (ambient k)) ↔ _
  rw [Scheme.IdealSheafData.coe_support_ofIdealTop, Ideal.map_span, Set.image_singleton,
    Scheme.zeroLocus_span, Scheme.zeroLocus_singleton]
  simp only [Set.mem_compl_iff, not_not, SetLike.mem_coe]
  rfl

/-- Membership in the image of an ideal of `k[x, y, z]` in `Γ(Spec k[x, y, z], ⊤)`. -/
theorem gammaEquiv_mem_map_iff (K : Ideal (Ring3 k)) (f : Ring3 k) :
    gammaEquiv k f ∈ K.map (gammaEquiv k : Ring3 k →+* Γ(ambient k, ⊤)) ↔ f ∈ K := by
  rw [Ideal.map_comap_of_equiv, Ideal.mem_comap]
  simp

end IdealSheaves

/-! ### The strict-transform centre on the charts -/

section Charts

variable (k : Type u) [Field k]

/-- **The strict-transform centre on a chart, as a saturation.** If the exceptional ideal on the
`i`-th chart is generated by `e`, a global section `f` lies in the strict-transform centre there
exactly when `eⁿ·f` lies in the total transform `J·𝒪` for some `n`. -/
theorem mem_comap_chartι_strictCentre_iff (i : Fin 2) (e : Ring3 k)
    (he : (centreRingIdeal k).map (chartHom k i : Ring3 k →+* Ring3 k) = Ideal.span {e})
    (f : Ring3 k) :
    gammaEquiv k f ∈ ((strictCentre (centreIdeal k) (curveIdeal k)).comap (chartι k i)).ideal
        ⟨⊤, isAffineOpen_top _⟩ ↔
      ∃ n : ℕ, e ^ n * f ∈ (curveRingIdeal k).map (chartHom k i : Ring3 k →+* Ring3 k) := by
  rw [comap_strictCentre_eq_ker, chartι_comp_blowUpToBase, comap_specMap_idealSheafOf,
    comap_specMap_idealSheafOf, he, support_compl_idealSheafOf_span_singleton,
    mem_ker_basicOpen_ι_iff, idealSheafOf_ideal_top]
  simp only [← map_pow, ← map_mul, gammaEquiv_mem_map_iff]

/-- If every variable is congruent to its image modulo `K`, so is every polynomial. -/
theorem sub_aeval_mem {σ R : Type*} [CommRing R] (K : Ideal (MvPolynomial σ R))
    (g : σ → MvPolynomial σ R) (hg : ∀ j, X j - g j ∈ K) (f : MvPolynomial σ R) :
    f - aeval g f ∈ K := by
  induction f using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
    rw [map_add, add_sub_add_comm]
    exact add_mem hp hq
  | mul_X p j hp =>
    rw [map_mul, aeval_X, show p * X j - aeval g p * g j =
      (p - aeval g p) * X j + aeval g p * (X j - g j) by ring]
    exact add_mem (K.mul_mem_right _ hp) (K.mul_mem_left _ (hg j))

/-- On the chart of the pivot `y` the total transform of `I` is `(y)`. -/
theorem map_chartHom_one_centreRingIdeal :
    (centreRingIdeal k).map (chartHom k 1 : Ring3 k →+* Ring3 k) = Ideal.span {X 1} := by
  rw [Ideal.map_span, Set.image_insert_eq, Set.image_singleton]
  simp only [chartHom, Matrix.cons_val_one, Matrix.cons_val_zero, AlgHom.coe_toRingHom, aeval_X]
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_mono (by simp))
  rintro _ (rfl | rfl)
  · exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)
  · exact Ideal.subset_span rfl

/-- On the chart of the pivot `x` the total transform of `I` is `(x)`. -/
theorem map_chartHom_zero_centreRingIdeal :
    (centreRingIdeal k).map (chartHom k 0 : Ring3 k →+* Ring3 k) = Ideal.span {X 0} := by
  rw [Ideal.map_span, Set.image_insert_eq, Set.image_singleton]
  simp only [chartHom, Matrix.cons_val_one, Matrix.cons_val_zero, AlgHom.coe_toRingHom, aeval_X]
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_mono (by simp))
  rintro _ (rfl | rfl)
  · exact Ideal.subset_span rfl
  · exact Ideal.mul_mem_right _ _ (Ideal.subset_span rfl)

/-- On the chart of the pivot `y` the total transform of `J` is `(x₁y - y², z)`. -/
theorem map_chartHom_one_curveRingIdeal :
    (curveRingIdeal k).map (chartHom k 1 : Ring3 k →+* Ring3 k) =
      Ideal.span {X 0 * X 1 - X 1 ^ 2, X 2} := by
  rw [Ideal.map_span, Set.image_insert_eq, Set.image_singleton]
  simp [chartHom]

/-- On the chart of the pivot `x` the total transform of `J` is `(x - (x y₁)², z)`. -/
theorem map_chartHom_zero_curveRingIdeal :
    (curveRingIdeal k).map (chartHom k 0 : Ring3 k →+* Ring3 k) =
      Ideal.span {X 0 - (X 0 * X 1) ^ 2, X 2} := by
  rw [Ideal.map_span, Set.image_insert_eq, Set.image_singleton]
  simp [chartHom]

/-- If `a = e * u`, then `(a, z) ≤ (u, z)`. -/
private theorem span_pair_le_of_eq_mul {R : Type*} [CommRing R] {a e u : R} (z : R)
    (h : a = e * u) : Ideal.span {a, z} ≤ Ideal.span {u, z} := by
  rw [Ideal.span_le]
  rintro _ (rfl | rfl)
  · rw [h]
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span (Set.mem_insert _ _))
  · exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)

/-- If `a = e * u` and `f ∈ (u, z)`, then some power of `e` times `f` lies in `(a, z)`. -/
private theorem exists_pow_mul_mem_span_pair {R : Type*} [CommRing R] {a e u : R} (z : R)
    (h : a = e * u) {f : R} (hf : f ∈ Ideal.span {u, z}) :
    ∃ n : ℕ, e ^ n * f ∈ Ideal.span {a, z} := by
  obtain ⟨c, d, rfl⟩ := Ideal.mem_span_pair.mp hf
  exact ⟨1, Ideal.mem_span_pair.mpr ⟨c, d * e, by rw [h]; ring⟩⟩

/-- The saturation on the chart of the pivot `y`: `(y(x₁ - y), z) : y^∞ = (x₁ - y, z)`. -/
theorem exists_pow_mul_mem_iff_chart_one (f : Ring3 k) :
    (∃ n : ℕ, X 1 ^ n * f ∈ Ideal.span {X 0 * X 1 - X 1 ^ 2, (X 2 : Ring3 k)}) ↔
      f ∈ Ideal.span {X 0 - X 1, (X 2 : Ring3 k)} := by
  have h : (X 0 * X 1 - X 1 ^ 2 : Ring3 k) = X 1 * (X 0 - X 1) := by ring
  set P : Ideal (Ring3 k) := Ideal.span {X 0 - X 1, X 2}
  constructor
  · rintro ⟨n, hn⟩
    have hle := span_pair_le_of_eq_mul (X 2 : Ring3 k) h
    let σ : Ring3 k →ₐ[k] Ring3 k := aeval ![X 1, X 1, 0]
    have hσ : ∀ p ∈ P, σ p = 0 := by
      intro p hp
      refine (Ideal.span_le (I := RingHom.ker (σ : Ring3 k →+* Ring3 k))).mpr ?_ hp
      rintro _ (rfl | rfl) <;> simp [σ]
    have hsub : f - σ f ∈ P := sub_aeval_mem P ![X 1, X 1, 0] (fun j ↦ by
      fin_cases j
      · change X 0 - X 1 ∈ P
        exact Ideal.subset_span (Set.mem_insert _ _)
      · change X 1 - X 1 ∈ P
        rw [sub_self]
        exact P.zero_mem
      · change X 2 - 0 ∈ P
        rw [sub_zero]
        exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)) f
    have h0 : σ (X 1 ^ n * f) = 0 := hσ _ (hle hn)
    have h1 : σ f = 0 := by
      rw [map_mul, map_pow] at h0
      have hX : σ (X 1) = X 1 := by simp [σ]
      rw [hX] at h0
      exact (mul_eq_zero.mp h0).resolve_left (pow_ne_zero _ (X_ne_zero _))
    rwa [h1, sub_zero] at hsub
  · exact exists_pow_mul_mem_span_pair (X 2 : Ring3 k) h

/-- The saturation on the chart of the pivot `x`:
`(x(1 - x·y₁²), z) : x^∞ = (1 - x·y₁², z)`. -/
theorem exists_pow_mul_mem_iff_chart_zero (f : Ring3 k) :
    (∃ n : ℕ, X 0 ^ n * f ∈ Ideal.span {X 0 - (X 0 * X 1) ^ 2, (X 2 : Ring3 k)}) ↔
      f ∈ Ideal.span {1 - X 0 * X 1 ^ 2, (X 2 : Ring3 k)} := by
  have h : (X 0 - (X 0 * X 1) ^ 2 : Ring3 k) = X 0 * (1 - X 0 * X 1 ^ 2) := by ring
  set Q : Ideal (Ring3 k) := Ideal.span {1 - X 0 * X 1 ^ 2, X 2}
  constructor
  · rintro ⟨n, hn⟩
    have hle := span_pair_le_of_eq_mul (X 2 : Ring3 k) h
    have hu : (X 0 * X 1 ^ 2 : Ring3 k) ^ n * f ∈ Q := by
      rw [show (X 0 * X 1 ^ 2 : Ring3 k) ^ n * f = X 1 ^ (2 * n) * (X 0 ^ n * f) by ring]
      exact Q.mul_mem_left _ (hle hn)
    obtain ⟨c, hc⟩ := one_sub_dvd_one_sub_pow (X 0 * X 1 ^ 2 : Ring3 k) n
    have hv : (1 - (X 0 * X 1 ^ 2 : Ring3 k) ^ n) * f ∈ Q := by
      rw [hc, mul_assoc]
      exact Q.mul_mem_right _ (Ideal.subset_span (Set.mem_insert _ _))
    rw [show f = (1 - (X 0 * X 1 ^ 2 : Ring3 k) ^ n) * f + (X 0 * X 1 ^ 2 : Ring3 k) ^ n * f by
      ring]
    exact add_mem hv hu
  · exact exists_pow_mul_mem_span_pair (X 2 : Ring3 k) h

/-- **The strict transform on the chart of the pivot `y`.** On `U₂ = Spec k[x₁, y, z]`, with
`x = x₁·y`, the strict transform of `V(x - y², z)` is cut out by `(x₁ - y, z)`. -/
theorem comap_chartι_one_strictCentre :
    (strictCentre (centreIdeal k) (curveIdeal k)).comap (chartι k 1) =
      idealSheafOf k (Ideal.span {X 0 - X 1, X 2}) := by
  apply Scheme.IdealSheafData.ext_of_isAffine
  ext g
  obtain ⟨f, rfl⟩ := (gammaEquiv k).surjective g
  rw [mem_comap_chartι_strictCentre_iff k 1 (X 1) (map_chartHom_one_centreRingIdeal k),
    idealSheafOf_ideal_top, gammaEquiv_mem_map_iff, map_chartHom_one_curveRingIdeal]
  exact exists_pow_mul_mem_iff_chart_one k f

/-- **The strict transform on the chart of the pivot `x`.** On `U₁ = Spec k[x, y₁, z]`, with
`y = x·y₁`, the strict transform of `V(x - y², z)` is cut out by `(1 - x·y₁², z)`. -/
theorem comap_chartι_zero_strictCentre :
    (strictCentre (centreIdeal k) (curveIdeal k)).comap (chartι k 0) =
      idealSheafOf k (Ideal.span {1 - X 0 * X 1 ^ 2, X 2}) := by
  apply Scheme.IdealSheafData.ext_of_isAffine
  ext g
  obtain ⟨f, rfl⟩ := (gammaEquiv k).surjective g
  rw [mem_comap_chartι_strictCentre_iff k 0 (X 0) (map_chartHom_zero_centreRingIdeal k),
    idealSheafOf_ideal_top, gammaEquiv_mem_map_iff, map_chartHom_zero_curveRingIdeal]
  exact exists_pow_mul_mem_iff_chart_zero k f

end Charts

end Stacks.Examples.HironakaLocalModel
