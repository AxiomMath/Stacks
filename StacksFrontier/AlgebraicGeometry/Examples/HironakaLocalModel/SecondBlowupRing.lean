module

public import Mathlib.Algebra.Category.Ring.Constructions
public import Mathlib.Algebra.MvPolynomial.Division
public import Mathlib.RingTheory.Flat.TorsionFree
public import Mathlib.RingTheory.RingHom.Flat
public import Mathlib.RingTheory.DedekindDomain.PID
public import Mathlib.RingTheory.Polynomial.Basic
public import StacksFrontier.RingTheory.Henselian.Quotient

/-!
# The second blow-up of Hironaka's local model: the ring-level facts

Hironaka's example (the source of [Stacks, Tag 08J1]) is, near its special point, the two-step
blow-up tower of `𝔸³_k = Spec k[x, y, z]`: blow up `(x, y)`, then the strict transform of
`(x - y², z)`. On the chart `U₂ = Spec k[v, y, z]` of the first blow-up (with `x = (v + y)·y`,
`v = x₁ - y`) the second centre is the coordinate subspace `(v, z)`, whose blow-up has the two
charts `Spec k[v, y, z₂]` (`z = v·z₂`) and `Spec k[v₂, y, z]` (`v = z·v₂`). This file collects the
commutative algebra of that picture.

All three rings `k[x, y, z]`, `k[v, y, z]` and the chart rings are `MvPolynomial (Fin 3) k`, with
the variables named in the order written (`X 0, X 1, X 2`); the line `V(x, y) = Spec k[z]` has
coordinate ring `k[X]` (`Polynomial k`), and the two surfaces `k[v, z₂]`, `k[v₂, z]` over it are
`MvPolynomial (Fin 2) k`.

## Main definitions

* `Stacks.Examples.HironakaLocalModel.towerMap`: `k[x, y, z] ⟶ k[v, y, z]`, `x ↦ (v + y)·y`.
* `Stacks.Examples.HironakaLocalModel.blowupChartMap i j`: the chart map
  `k[X] ⟶ k[X]`, `X j ↦ X i · X j`, of the blow-up of `(X i, X j)` on the chart where `X i`
  generates.
* `Stacks.Examples.HironakaLocalModel.lineMap`: `k[x, y, z] ⟶ k[z]`, the closed immersion of
  `V(x, y)`.
* `Stacks.Examples.HironakaLocalModel.surfaceMap`,
  `Stacks.Examples.HironakaLocalModel.lineToChartOne`,
  `Stacks.Examples.HironakaLocalModel.lineToChartTwo`: the base change of the two charts to
  `V(x, y)`, `Spec k[v, z₂]` with `z ↦ v·z₂` and `Spec k[v₂, z]` with `z ↦ z`.

## Main results

* `Stacks.Examples.HironakaLocalModel.isPushout_of_surjective`: a commutative square of rings
  with two surjective sides whose kernels correspond is a pushout.
* `Stacks.Examples.HironakaLocalModel.flat_of_injective_polynomial`: an injective ring map from
  `k[X]` to a domain is flat.
* `Stacks.Examples.HironakaLocalModel.flat_lineToChartOne`,
  `Stacks.Examples.HironakaLocalModel.flat_lineToChartTwo`: `k[z] ⟶ k[v, w]`, `z ↦ v·w`, and
  `k[z] ⟶ k[v, w]`, `z ↦ w`, are flat.
* `Stacks.Examples.HironakaLocalModel.isPushout_chartOne`,
  `Stacks.Examples.HironakaLocalModel.isPushout_chartTwo`: the base change of the two charts of
  the second blow-up to `V(x, y)`.
* `Stacks.Examples.HironakaLocalModel.span_X_one_mul_eq_inf`: `(y, v·w) = (y, v) ⊓ (y, w)` in
  `k[v, y, w]`.
* `Stacks.Examples.HironakaLocalModel.fibreIdeal_chartOne`,
  `Stacks.Examples.HironakaLocalModel.fibreIdeal_chartTwo`: the ideal of the fibre over the
  origin on the two charts is `(y, v·z₂)`, resp. `(y, z)`.
-/

@[expose] public noncomputable section

open CategoryTheory MvPolynomial

universe u

namespace Stacks.Examples.HironakaLocalModel

/-! ### Generalities -/

/-- If `g` is a ring endomorphism of a polynomial ring with `p - g p ∈ J` on the constants and the
variables, then `p - g p ∈ J` for every `p`. -/
theorem sub_mem_of_forall {σ R : Type*} [CommRing R]
    (g : MvPolynomial σ R →+* MvPolynomial σ R) (J : Ideal (MvPolynomial σ R))
    (hC : ∀ c, C c - g (C c) ∈ J) (hX : ∀ i, X i - g (X i) ∈ J) (p : MvPolynomial σ R) :
    p - g p ∈ J := by
  induction p using MvPolynomial.induction_on with
  | C c => exact hC c
  | add p q hp hq =>
    rw [map_add]
    convert J.add_mem hp hq using 1
    ring
  | mul_X p i hp =>
    rw [map_mul]
    convert J.add_mem (J.mul_mem_right (X i) hp) (J.mul_mem_left (g p) (hX i)) using 1
    ring

/-- A ring map `f` whose kernel contains `J`, and which has a map `s` back with `p - s (f p) ∈ J`
for all `p`, has kernel exactly `J`. -/
theorem ker_eq_of_sub_mem {P B : Type*} [CommRing P] [CommRing B] (f : P →+* B) (s : B →+* P)
    (J : Ideal P) (hJ : J ≤ RingHom.ker f) (h : ∀ p, p - s (f p) ∈ J) : RingHom.ker f = J := by
  refine le_antisymm (fun p hp => ?_) hJ
  have := h p
  rwa [RingHom.mem_ker.1 hp, map_zero, sub_zero] at this

/-- **A commutative square of rings with two surjective sides whose kernels correspond is a
pushout.** If `β : A ⟶ B` and `γ : T ⟶ C` are surjective, `γ ∘ f = δ ∘ β`, and the kernel of `γ` is
generated by the image under `f` of the kernel of `β`, then `C = T ⊗_A B`: the square is
`T ⟶ T/I·T` over `A ⟶ A/I`, `I = ker β`. -/
theorem isPushout_of_surjective {A B T C : Type u} [CommRing A] [CommRing B] [CommRing T]
    [CommRing C] (β : A →+* B) (f : A →+* T) (γ : T →+* C) (δ : B →+* C)
    (hw : γ.comp f = δ.comp β) (hβ : Function.Surjective β) (hγ : Function.Surjective γ)
    (hker : RingHom.ker γ = (RingHom.ker β).map f) :
    IsPushout (CommRingCat.ofHom f) (CommRingCat.ofHom β) (CommRingCat.ofHom γ)
      (CommRingCat.ofHom δ) := by
  let := f.toAlgebra
  set I := RingHom.ker β with hI
  have h0 := (CommRingCat.isPushout_iff_isPushout (R := A) (R' := A ⧸ I) (S := T)
    (S' := T ⧸ I.map (algebraMap A T))).2 (Stacks.Henselian.isPushout_quotient_map I)
  let e₃ : A ⧸ I ≃+* B := RingHom.quotientKerEquivOfSurjective hβ
  let e₄ : T ⧸ I.map (algebraMap A T) ≃+* C :=
    (Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hγ)
  refine h0.flip.of_iso (Iso.refl _) (Iso.refl _) e₃.toCommRingCatIso e₄.toCommRingCatIso
    ?_ ?_ ?_ ?_
  · rfl
  · ext a
    rfl
  · ext t
    rfl
  · ext a
    change γ (f a) = δ (β a)
    exact congrArg (fun φ : A →+* C => φ a) hw

/-- **An injective ring map from `k[X]` to a domain is flat**: `k[X]` is a principal ideal domain,
and a torsion-free module over it is flat. -/
theorem flat_of_injective_polynomial {k : Type*} [Field k] {D : Type*} [CommRing D] [IsDomain D]
    (f : Polynomial k →+* D) (hf : Function.Injective f) : f.Flat := by
  let := f.toAlgebra
  have : Module.IsTorsionFree (Polynomial k) D :=
    Module.isTorsionFree_iff_algebraMap_injective.2 hf
  change Module.Flat (Polynomial k) D
  infer_instance

/-! ### The maps of the local model -/

variable (k : Type u) [Field k]

/-- The composite `k[x, y, z] ⟶ k[v, y, z]` of the first blow-up's chart `U₂` (`x = x₁·y`) with
the change of coordinates `v = x₁ - y`: `x ↦ (v + y)·y`, `y ↦ y`, `z ↦ z`. -/
def towerMap : MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 3) k :=
  aeval ![(X 0 + X 1) * X 1, X 1, X 2]

/-- The chart map of the blow-up of the coordinate subspace `(X i, X j)` on the chart where `X i`
generates the centre: `X j ↦ X i · X j`, every other variable fixed. The new `X j` of the chart is
the fraction `X j / X i`. -/
def blowupChartMap {σ : Type*} [DecidableEq σ] (i j : σ) :
    MvPolynomial σ k →ₐ[k] MvPolynomial σ k :=
  aeval fun l => if l = j then X i * X j else X l

/-- The chart map `blowupChartMap k i j` sends `X j` to `X i * X j`. -/
theorem blowupChartMap_X_self {σ : Type*} [DecidableEq σ] (i j : σ) :
    blowupChartMap k i j (X j) = X i * X j := by
  simp [blowupChartMap]

/-- The chart map `blowupChartMap k i j` fixes every variable `X l` with `l ≠ j`. -/
theorem blowupChartMap_X_of_ne {σ : Type*} [DecidableEq σ] (i j : σ) {l : σ} (hl : l ≠ j) :
    blowupChartMap k i j (X l) = X l := by
  simp [blowupChartMap, hl]

/-- The closed immersion of the line `V(x, y) = Spec k[z]` into `Spec k[x, y, z]`:
`x ↦ 0`, `y ↦ 0`, `z ↦ z`. -/
def lineMap : MvPolynomial (Fin 3) k →ₐ[k] Polynomial k :=
  aeval ![0, 0, Polynomial.X]

/-- The reduction `k[v, y, w] ⟶ k[v, w]` modulo `y`: `v ↦ v`, `y ↦ 0`, `w ↦ w`. It is the base
change of either chart of the second blow-up to `V(x, y)`. -/
def surfaceMap : MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 2) k :=
  aeval ![X 0, 0, X 1]

/-- The family over `V(x, y)` on the first chart: `k[z] ⟶ k[v, z₂]`, `z ↦ v·z₂`. -/
def lineToChartOne : Polynomial k →ₐ[k] MvPolynomial (Fin 2) k :=
  Polynomial.aeval (X 0 * X 1)

/-- The family over `V(x, y)` on the second chart: `k[z] ⟶ k[v₂, z]`, `z ↦ z`. -/
def lineToChartTwo : Polynomial k →ₐ[k] MvPolynomial (Fin 2) k :=
  Polynomial.aeval (X 1)

/-- The first chart of the second blow-up, `k[v, y, z] ⟶ k[v, y, z₂]`, `z ↦ v·z₂`. -/
abbrev chartOneMap : MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 3) k :=
  blowupChartMap k 0 2

/-- The second chart of the second blow-up, `k[v, y, z] ⟶ k[v₂, y, z]`, `v ↦ z·v₂`. -/
abbrev chartTwoMap : MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 3) k :=
  blowupChartMap k 2 0

/-! ### The line `V(x, y)` -/

/-- The section `k[z] ⟶ k[x, y, z]`, `z ↦ z`. -/
private def lineSection : Polynomial k →ₐ[k] MvPolynomial (Fin 3) k :=
  Polynomial.aeval (X 2)

/-- The map `k[x, y, z] ⟶ k[z]`, `x, y ↦ 0`, `z ↦ z`, is surjective. -/
theorem lineMap_surjective : Function.Surjective (lineMap k) := by
  intro q
  refine ⟨lineSection k q, ?_⟩
  change ((lineMap k).comp (lineSection k)) q = q
  have : (lineMap k).comp (lineSection k) = AlgHom.id k _ :=
    Polynomial.algHom_ext (by simp [lineMap, lineSection])
  rw [this]
  rfl

/-- **The line `V(x, y)`**: the kernel of `k[x, y, z] ⟶ k[z]` is `(x, y)`. -/
theorem ker_lineMap :
    RingHom.ker (lineMap k : MvPolynomial (Fin 3) k →+* Polynomial k) =
      Ideal.span {X 0, X 1} := by
  refine ker_eq_of_sub_mem _ (lineSection k : Polynomial k →+* MvPolynomial (Fin 3) k) _ ?_ ?_
  · rw [Ideal.span_le]
    rintro _ (rfl | rfl) <;> simp [lineMap]
  · refine sub_mem_of_forall (((lineSection k).comp (lineMap k) :
      MvPolynomial (Fin 3) k →ₐ[k] _) : MvPolynomial (Fin 3) k →+* _) _ ?_ ?_
    · intro c
      simp
    · intro i
      fin_cases i
      · simpa [lineMap] using Ideal.subset_span (by simp)
      · simpa [lineMap] using Ideal.subset_span (by simp)
      · simp [lineMap, lineSection]

/-! ### The surface `k[v, w]` -/

/-- The section `k[v, w] ⟶ k[v, y, w]`. -/
private def surfaceSection : MvPolynomial (Fin 2) k →ₐ[k] MvPolynomial (Fin 3) k :=
  aeval ![X 0, X 2]

/-- The reduction `k[v, y, w] ⟶ k[v, w]` modulo `y` is surjective. -/
theorem surfaceMap_surjective : Function.Surjective (surfaceMap k) := by
  intro q
  refine ⟨surfaceSection k q, ?_⟩
  change ((surfaceMap k).comp (surfaceSection k)) q = q
  have : (surfaceMap k).comp (surfaceSection k) = AlgHom.id k _ := by
    refine MvPolynomial.algHom_ext fun i => ?_
    fin_cases i <;> simp [surfaceMap, surfaceSection]
  rw [this]
  rfl

/-- The kernel of the reduction `k[v, y, w] ⟶ k[v, w]` is `(y)`. -/
theorem ker_surfaceMap :
    RingHom.ker (surfaceMap k : MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 2) k) =
      Ideal.span {X 1} := by
  refine ker_eq_of_sub_mem _ (surfaceSection k : MvPolynomial (Fin 2) k →+* _) _ ?_ ?_
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    simp [surfaceMap]
  · refine sub_mem_of_forall (((surfaceSection k).comp (surfaceMap k) :
      MvPolynomial (Fin 3) k →ₐ[k] _) : MvPolynomial (Fin 3) k →+* _) _ ?_ ?_
    · intro c
      simp
    · intro i
      fin_cases i
      · simp [surfaceMap, surfaceSection]
      · simp [surfaceMap]
      · simp [surfaceMap, surfaceSection]

/-! ### Flatness of the two families over `V(x, y)` -/

/-- An algebra map `k[z] ⟶ k[v, w]` with a left inverse `ψ` is injective. -/
private theorem lineToChart_injective_of_comp {f : Polynomial k →ₐ[k] MvPolynomial (Fin 2) k}
    (ψ : MvPolynomial (Fin 2) k →ₐ[k] Polynomial k) (h : ψ.comp f = AlgHom.id k _) :
    Function.Injective f :=
  Function.LeftInverse.injective (g := ψ) fun p => congrArg (fun φ => φ p) h

/-- The map `k[z] ⟶ k[v, w]`, `z ↦ v·w`, is injective. -/
theorem lineToChartOne_injective : Function.Injective (lineToChartOne k) :=
  lineToChart_injective_of_comp k (aeval ![Polynomial.X, 1])
    (Polynomial.algHom_ext (by simp [lineToChartOne]))

/-- The map `k[z] ⟶ k[v, w]`, `z ↦ w`, is injective. -/
theorem lineToChartTwo_injective : Function.Injective (lineToChartTwo k) :=
  lineToChart_injective_of_comp k (aeval ![0, Polynomial.X])
    (Polynomial.algHom_ext (by simp [lineToChartTwo]))

/-- `k[z] ⟶ k[v, w]`, `z ↦ v·w`, is flat. -/
theorem flat_lineToChartOne :
    (lineToChartOne k : Polynomial k →+* MvPolynomial (Fin 2) k).Flat :=
  flat_of_injective_polynomial _ (lineToChartOne_injective k)

/-- `k[z] ⟶ k[v, w]`, `z ↦ w`, is flat. -/
theorem flat_lineToChartTwo :
    (lineToChartTwo k : Polynomial k →+* MvPolynomial (Fin 2) k).Flat :=
  flat_of_injective_polynomial _ (lineToChartTwo_injective k)

/-! ### The base change of the two charts to `V(x, y)` -/

/-- The square formed by the first chart of the second blow-up over `k[x, y, z]`, the line
`V(x, y)` and the surface `k[v, w]` commutes. -/
theorem surfaceMap_comp_chartOne :
    ((surfaceMap k).comp ((chartOneMap k).comp (towerMap k))) =
      (lineToChartOne k).comp (lineMap k) := by
  refine MvPolynomial.algHom_ext fun i => ?_
  fin_cases i <;> simp [surfaceMap, blowupChartMap, towerMap, lineMap, lineToChartOne]

/-- The square formed by the second chart of the second blow-up over `k[x, y, z]`, the line
`V(x, y)` and the surface `k[v, w]` commutes. -/
theorem surfaceMap_comp_chartTwo :
    ((surfaceMap k).comp ((chartTwoMap k).comp (towerMap k))) =
      (lineToChartTwo k).comp (lineMap k) := by
  refine MvPolynomial.algHom_ext fun i => ?_
  fin_cases i <;> simp [surfaceMap, blowupChartMap, towerMap, lineMap, lineToChartTwo]

/-- The composite of a chart map with `towerMap` sends `x` into `(y)`. -/
private theorem chartTower_X_zero_mem (i j : Fin 3) (hj : (1 : Fin 3) ≠ j) :
    ((blowupChartMap k i j).comp (towerMap k)) (X 0) ∈ Ideal.span {X 1} := by
  simp only [AlgHom.coe_comp, Function.comp_apply, towerMap, aeval_X, Matrix.cons_val_zero,
    map_mul, map_add, blowupChartMap_X_of_ne k i j hj]
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)

/-- The composite of a chart map with `towerMap` fixes `y`. -/
private theorem chartTower_X_one (i j : Fin 3) (hj : (1 : Fin 3) ≠ j) :
    ((blowupChartMap k i j).comp (towerMap k)) (X 1) = X 1 := by
  simp [towerMap, blowupChartMap_X_of_ne k i j hj]

/-- The extension of `(x, y)` to a chart of the second blow-up is `(y)`, as soon as the chart map
fixes `y` and sends `x` into `(y)`. -/
private theorem map_span_eq_span_X_one (φ : MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 3) k)
    (h0 : φ (X 0) ∈ Ideal.span {X 1}) (h1 : φ (X 1) = X 1) :
    (Ideal.span {X 0, X 1} : Ideal (MvPolynomial (Fin 3) k)).map
        (φ : MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 3) k) =
      Ideal.span {X 1} := by
  rw [Ideal.map_span, Set.image_pair]
  refine le_antisymm ?_ ?_
  · rw [Ideal.span_le]
    rintro _ (rfl | rfl)
    · exact h0
    · change φ (X 1) ∈ _
      rw [h1]
      exact Ideal.subset_span rfl
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    refine Ideal.subset_span (Or.inr ?_)
    exact h1.symm

/-- **The base change of a chart of the second blow-up to `V(x, y)`**, given the commuting
square. -/
private theorem isPushout_chart (i j : Fin 3) (hj : (1 : Fin 3) ≠ j)
    (L : Polynomial k →ₐ[k] MvPolynomial (Fin 2) k)
    (h : (surfaceMap k).comp ((blowupChartMap k i j).comp (towerMap k)) = L.comp (lineMap k)) :
    IsPushout (CommRingCat.ofHom (((blowupChartMap k i j).comp (towerMap k) : _ →ₐ[k] _) :
        MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 3) k))
      (CommRingCat.ofHom (lineMap k : MvPolynomial (Fin 3) k →+* Polynomial k))
      (CommRingCat.ofHom (surfaceMap k : MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 2) k))
      (CommRingCat.ofHom (L : Polynomial k →+* MvPolynomial (Fin 2) k)) := by
  refine isPushout_of_surjective _ _ _ _ (congrArg AlgHom.toRingHom h) (lineMap_surjective k)
    (surfaceMap_surjective k) ?_
  rw [ker_surfaceMap, ker_lineMap]
  exact (map_span_eq_span_X_one k _ (chartTower_X_zero_mem k i j hj)
    (chartTower_X_one k i j hj)).symm

/-- **The base change of the first chart to `V(x, y)`.**
`k[v, y, z₂] ⊗_{k[x,y,z]} k[z] = k[v, z₂]`, with `z ↦ v·z₂`. -/
theorem isPushout_chartOne :
    IsPushout (CommRingCat.ofHom (((chartOneMap k).comp (towerMap k) : _ →ₐ[k] _) :
        MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 3) k))
      (CommRingCat.ofHom (lineMap k : MvPolynomial (Fin 3) k →+* Polynomial k))
      (CommRingCat.ofHom (surfaceMap k : MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 2) k))
      (CommRingCat.ofHom (lineToChartOne k : Polynomial k →+* MvPolynomial (Fin 2) k)) :=
  isPushout_chart k 0 2 (by decide) _ (surfaceMap_comp_chartOne k)

/-- **The base change of the second chart to `V(x, y)`.** `k[v₂, y, z] ⊗_{k[x,y,z]} k[z] =
k[v₂, z]`, with `z ↦ z`. -/
theorem isPushout_chartTwo :
    IsPushout (CommRingCat.ofHom (((chartTwoMap k).comp (towerMap k) : _ →ₐ[k] _) :
        MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 3) k))
      (CommRingCat.ofHom (lineMap k : MvPolynomial (Fin 3) k →+* Polynomial k))
      (CommRingCat.ofHom (surfaceMap k : MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 2) k))
      (CommRingCat.ofHom (lineToChartTwo k : Polynomial k →+* MvPolynomial (Fin 2) k)) :=
  isPushout_chart k 2 0 (by decide) _ (surfaceMap_comp_chartTwo k)

/-! ### The fibre over the origin -/

/-- In `k[v, y, w]`, `(v) ⊓ (w) = (v·w)`: the two variables are non-associate primes. -/
theorem span_X_zero_inf_span_X_two :
    (Ideal.span {X 0} ⊓ Ideal.span {X 2} : Ideal (MvPolynomial (Fin 3) k)) =
      Ideal.span {X 0 * X 2} := by
  refine le_antisymm (fun p hp => ?_) ?_
  · obtain ⟨hp0, hp2⟩ := Ideal.mem_inf.1 hp
    rw [Ideal.mem_span_singleton] at hp0 hp2 ⊢
    obtain ⟨q, rfl⟩ := hp0
    have hX2 : Prime (X 2 : MvPolynomial (Fin 3) k) := MvPolynomial.X_prime
    rcases hX2.dvd_or_dvd hp2 with h | h
    · exfalso
      obtain ⟨r, hr⟩ := h
      have := congrArg (MvPolynomial.eval ![1, 0, 0]) hr
      simp at this
    · exact mul_dvd_mul_left _ h
  · rw [Ideal.span_le, Set.singleton_subset_iff]
    exact ⟨Ideal.mul_mem_right _ _ (Ideal.subset_span rfl),
      Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)⟩

/-- The retraction `k[v, y, w] ⟶ k[v, y, w]` killing `y`. -/
private def killY : MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 3) k :=
  aeval ![X 0, 0, X 2]

private theorem sub_killY_mem (p : MvPolynomial (Fin 3) k) :
    p - killY k p ∈ Ideal.span {X 1} := by
  refine sub_mem_of_forall ((killY k : _ →ₐ[k] _) : MvPolynomial (Fin 3) k →+* _) _ ?_ ?_ p
  · intro c
    simp
  · intro i
    fin_cases i
    · simp [killY]
    · simp [killY]
    · simp [killY]

private theorem killY_mem_span {a p : MvPolynomial (Fin 3) k} (ha : killY k a = a)
    (hp : p ∈ Ideal.span {X 1, a}) : killY k p ∈ Ideal.span {a} := by
  obtain ⟨r, s, rfl⟩ := Ideal.mem_span_pair.1 hp
  rw [map_add, map_mul, map_mul, ha]
  have : killY k (X 1) = 0 := by simp [killY]
  rw [this, mul_zero, zero_add]
  exact Ideal.mul_mem_left _ _ (Ideal.subset_span rfl)

/-- In `k[v, y, w]`, `(y, v·w) = (y, v) ⊓ (y, w)`: the closed subscheme
`{y = 0, v·w = 0}` is the scheme-theoretic union of `{y = v = 0}` and `{y = w = 0}`. -/
theorem span_X_one_mul_eq_inf :
    (Ideal.span {X 1, X 0 * X 2} : Ideal (MvPolynomial (Fin 3) k)) =
      Ideal.span {X 1, X 0} ⊓ Ideal.span {X 1, X 2} := by
  refine le_antisymm ?_ (fun p hp => ?_)
  · rw [Ideal.span_le]
    rintro _ (rfl | rfl)
    · exact ⟨Ideal.subset_span (Or.inl rfl), Ideal.subset_span (Or.inl rfl)⟩
    · exact ⟨Ideal.mul_mem_right _ _ (Ideal.subset_span (Or.inr rfl)),
        Ideal.mul_mem_left _ _ (Ideal.subset_span (Or.inr rfl))⟩
  · obtain ⟨hp0, hp2⟩ := hp
    have h0 := killY_mem_span k (by simp [killY]) hp0
    have h2 := killY_mem_span k (by simp [killY]) hp2
    have hk : killY k p ∈ Ideal.span {X 0 * X 2} := by
      rw [← span_X_zero_inf_span_X_two]
      exact ⟨h0, h2⟩
    have hsplit : p = (p - killY k p) + killY k p := by ring
    rw [hsplit]
    refine Ideal.add_mem _ ?_ ?_
    · exact (Ideal.span_mono (by simp)) (sub_killY_mem k p)
    · exact (Ideal.span_mono (by simp)) hk

/-- The ideal of the origin `(x, y, z)` of `Spec k[x, y, z]`. -/
abbrev originIdeal : Ideal (MvPolynomial (Fin 3) k) := Ideal.span {X 0, X 1, X 2}

/-- The extension of the origin `(x, y, z)` along a map sending `x` into `(y)`, fixing `y` and
sending `z` to `a` is `(y, a)`. -/
private theorem map_originIdeal_eq (φ : MvPolynomial (Fin 3) k →ₐ[k] MvPolynomial (Fin 3) k)
    (a : MvPolynomial (Fin 3) k) (h0 : φ (X 0) ∈ Ideal.span {X 1}) (h1 : φ (X 1) = X 1)
    (h2 : φ (X 2) = a) :
    (originIdeal k).map (φ : MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 3) k) =
      Ideal.span {X 1, a} := by
  rw [Ideal.map_span]
  refine le_antisymm ?_ ?_
  · rw [Ideal.span_le]
    rintro _ ⟨q, hq, rfl⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq
    rcases hq with rfl | rfl | rfl
    · exact Ideal.span_mono (by simp) h0
    · exact Ideal.subset_span (by simp [h1])
    · exact Ideal.subset_span (by simp [h2])
  · rw [Ideal.span_le]
    rintro _ (rfl | rfl)
    · exact Ideal.subset_span ⟨X 1, by simp, h1⟩
    · exact Ideal.subset_span ⟨X 2, by simp, h2⟩

/-- **The fibre over the origin on the first chart** is cut out by `(y, v·z₂)`. -/
theorem fibreIdeal_chartOne :
    (originIdeal k).map (((chartOneMap k).comp (towerMap k) : _ →ₐ[k] _) :
        MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 3) k) =
      Ideal.span {X 1, X 0 * X 2} :=
  map_originIdeal_eq k _ _ (chartTower_X_zero_mem k 0 2 (by decide))
    (chartTower_X_one k 0 2 (by decide)) (by simp [towerMap, blowupChartMap])

/-- **The fibre over the origin on the second chart** is cut out by `(y, z)`. -/
theorem fibreIdeal_chartTwo :
    (originIdeal k).map (((chartTwoMap k).comp (towerMap k) : _ →ₐ[k] _) :
        MvPolynomial (Fin 3) k →+* MvPolynomial (Fin 3) k) =
      Ideal.span {X 1, X 2} :=
  map_originIdeal_eq k _ _ (chartTower_X_zero_mem k 2 0 (by decide))
    (chartTower_X_one k 2 0 (by decide)) (by simp [towerMap, blowupChartMap])

end Stacks.Examples.HironakaLocalModel

