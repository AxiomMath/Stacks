module

public import StacksFrontier.AlgebraicGeometry.Examples.HironakaLocalModel.ModelFactsOfNodal
public import StacksFrontier.AlgebraicGeometry.Examples.HironakaLocalModel.OriginFibreCharts
public import StacksFrontier.AlgebraicGeometry.Blowup.ClassifyingMorphism
public import StacksFrontier.AlgebraicGeometry.Chow.FamilyFibreDivisors.PointSectionCartier
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.ProjectiveClosedSubschemeAlgebraization.IdealSheaves
public import StacksFrontier.AlgebraicGeometry.ClosedImmersion.IdealSheafComapMap
public import StacksFrontier.AlgebraicGeometry.Examples.HironakaLocalModel.OriginFibreSb4

/-!
# The fibre of Hironaka's local model over the origin

Let `T` be the local model of Hironaka's tower: `Spec k[x, y, z]` blown up in `I = (x, y)`, then in
the strict transform `J'` of `V(x - y², z)`. This file shows that the fibre `Z_O` of `T` over the
origin is the scheme-theoretic union of two closed subschemes meeting in one reduced `k`-point:

* `A`, the lift (Tag 0806, the universal property of blowing up) of the fibre `(Bl_I)_O ≅ ℙ¹_k`
  of the first blow-up, along which `J'` restricts to an effective Cartier divisor;
* `B`, the fibre of the exceptional divisor of the second blow-up over the point of `V(J')`
  above the origin.

The equalities of ideal sheaves are checked on four affine charts covering the source of the tower.

## Main results

* `Stacks.Examples.HironakaLocalModel.nodal_originFibre`: the nodal decomposition, in the form of
  the hypothesis of `Stacks.Examples.HironakaLocalModel.modelFacts_of_nodal`.
* `Stacks.Examples.HironakaLocalModel.modelFacts`: the model facts of
  `Stacks.Examples.HironakaNotProjective.ModelFacts`, for every field.

## References

* [Stacks Project, Tag 08J1](https://stacks.math.columbia.edu/tag/08J1)
* [Stacks Project, Tag 0806](https://stacks.math.columbia.edu/tag/0806)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry MvPolynomial
open AlgebraicGeometry.TwoStepTower
open Stacks.AlgebraicGeometry.ProjPolyChart (polyGrading projToSpecCoeff)
open Stacks.Examples.HironakaConicChart Stacks.Examples.HironakaNotProjective

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

namespace Stacks.Examples.HironakaLocalModel

/-- A principal ideal generated by a nonzerodivisor is an effective Cartier divisor on `Spec R`. -/
theorem isEffectiveCartierDivisor_idealSheafSpec_span_singleton {R : Type u} [CommRing R]
    (a : R) (ha : a ∈ nonZeroDivisors R) :
    Stacks.Divisors.IsEffectiveCartierDivisor (idealSheafSpec (Ideal.span {a})) := by
  simp only [idealSheafSpec, Ideal.map_span, Set.image_singleton]
  exact Stacks.Divisors.isEffectiveCartierDivisor_ofIdealTop_span _
    (Stacks.Divisors.isRegular_ringEquiv
      (Scheme.ΓSpecIso (CommRingCat.of R)).symm.commRingCatIsoToRingEquiv
      (isRegular_iff_mem_nonZeroDivisors.mpr ha))

variable (k : Type u) [Field k]

/-- The blow-up morphism of the first blow-up is separated. -/
instance : IsSeparated (blowUpToBase (centreIdeal k)) :=
  Stacks.RelativeProj.Situation.isSeparated_relativeProjToBase _

/-- The blow-up morphism of the second blow-up is separated. -/
instance : IsSeparated (blowUpToBase (strictCurve k)) :=
  Stacks.RelativeProj.Situation.isSeparated_relativeProjToBase _

/-- The origin `Spec k ⟶ Spec k[x, y, z]` is a closed immersion. -/
instance : IsClosedImmersion (modelKPoint k 0) :=
  IsClosedImmersion.spec_of_surjective _ fun c => ⟨C c, by simp⟩

/-- The kernel of the origin `Spec k ⟶ Spec k[x, y, z]` is `(x, y, z)`. -/
theorem ker_modelKPoint_zero : (modelKPoint k 0).ker = originIdealSheaf k := by
  have h : RingHom.ker (MvPolynomial.eval (0 : Fin 3 → k)) = originIdeal k := ker_originMap k
  rw [modelKPoint, ker_specMap_ofHom, h]

/-! ### The fibre over the origin -/

/-- The fibre `T_O` of the tower over the origin. -/
abbrev originFibre : Scheme.{u} :=
  pullback (strictTower (centreIdeal k) (curveIdeal k)) (modelKPoint k 0)

/-- The inclusion of `T_O` into the source of the tower. -/
abbrev originFibreι : originFibre k ⟶ blowUp (strictCurve k) := pullback.fst _ _

/-- The structure morphism of `T_O`. -/
abbrev originFibreToPoint : originFibre k ⟶ Spec (.of k) := pullback.snd _ _

/-- The ideal sheaf of `T_O` in the source of the tower is `towerFibreIdeal k`. -/
theorem ker_originFibreι : (originFibreι k).ker = towerFibreIdeal k := by
  rw [Scheme.IdealSheafData.ker_fst_of_isClosedImmersion, ker_modelKPoint_zero]

/-! ### The component `A`: the strict transform of the fibre of the first blow-up -/

/-- The fibre `(B₁)_O` of the first blow-up over the origin. -/
abbrev firstFibre : Scheme.{u} := pullback (blowUpToBase (centreIdeal k)) (modelKPoint k 0)

/-- The inclusion of `(B₁)_O` into the first blow-up. -/
abbrev firstFibreι : firstFibre k ⟶ blowUp (centreIdeal k) := pullback.fst _ _

/-- The structure morphism of `(B₁)_O`. -/
abbrev firstFibreToPoint : firstFibre k ⟶ Spec (.of k) := pullback.snd _ _

/-- The coordinate line `k[x₁, y, z] ⟶ k[t]`, `x₁ ↦ t`, `y, z ↦ 0`. -/
def lineX : Ring3 k →ₐ[k] Polynomial k := aeval ![Polynomial.X, 0, 0]

/-- The coordinate line `lineX k` is surjective. -/
theorem lineX_surjective : Function.Surjective (lineX k) := by
  have h : (lineX k).comp (Polynomial.aeval (X 0 : Ring3 k)) = AlgHom.id k (Polynomial k) :=
    Polynomial.algHom_ext (by simp [lineX])
  exact fun f ↦ ⟨Polynomial.aeval (X 0 : Ring3 k) f,
    congrArg (fun φ : Polynomial k →ₐ[k] Polynomial k ↦ φ f) h⟩

/-- The kernel of the coordinate line `lineX k` is `(y, z)`. -/
theorem ker_lineX :
    RingHom.ker (lineX k : Ring3 k →+* Polynomial k) = Ideal.span {X 1, X 2} := by
  set P : Ideal (Ring3 k) := Ideal.span {X 1, X 2}
  refine le_antisymm (fun f hf ↦ ?_) ?_
  · have hσ : (Polynomial.aeval (X 0 : Ring3 k)).comp (lineX k) =
        aeval ![X 0, (0 : Ring3 k), 0] := by
      apply MvPolynomial.algHom_ext
      intro j
      fin_cases j <;> simp [lineX]
    have hsub : f - aeval ![X 0, (0 : Ring3 k), 0] f ∈ P := sub_aeval_mem P ![X 0, 0, 0]
      (fun j ↦ by
        fin_cases j
        · change X 0 - X 0 ∈ P
          rw [sub_self]
          exact P.zero_mem
        · change X 1 - 0 ∈ P
          rw [sub_zero]
          exact Ideal.subset_span (Set.mem_insert _ _)
        · change X 2 - 0 ∈ P
          rw [sub_zero]
          exact Ideal.subset_span (Set.mem_insert_of_mem _ rfl)) f
    have h0 : aeval ![X 0, (0 : Ring3 k), 0] f = 0 := by
      rw [← hσ, AlgHom.comp_apply, show lineX k f = 0 from hf, map_zero]
    rwa [h0, sub_zero] at hsub
  · rw [Ideal.span_le]
    rintro _ (rfl | rfl) <;> simp [lineX]

/-- The coordinate line `Spec k[t]` of the chart `U₂` is the fibre of `U₂ ⟶ Spec k[x, y, z]` over
the origin. -/
theorem isPullback_lineX :
    IsPullback (Spec.map (CommRingCat.ofHom (lineX k : Ring3 k →+* Polynomial k)))
      (Spec.map (CommRingCat.ofHom (algebraMap k (Polynomial k))))
      (Spec.map (CommRingCat.ofHom (chartHom k 1 : Ring3 k →+* Ring3 k))) (modelKPoint k 0) := by
  have hw : (lineX k : Ring3 k →+* Polynomial k).comp (chartHom k 1 : Ring3 k →+* Ring3 k) =
      (algebraMap k (Polynomial k)).comp (MvPolynomial.eval (0 : Fin 3 → k)) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp [lineX]
    · intro j
      fin_cases j <;> simp [lineX, chartHom]
  have hker : RingHom.ker (lineX k : Ring3 k →+* Polynomial k) =
      (RingHom.ker (MvPolynomial.eval (0 : Fin 3 → k))).map
        (chartHom k 1 : Ring3 k →+* Ring3 k) := by
    refine le_antisymm ?_ ?_
    · rw [ker_lineX, Ideal.span_le]
      rintro _ (rfl | rfl)
      · have h1 : (chartHom k 1 : Ring3 k →+* Ring3 k) (X 1) = X 1 := by simp [chartHom]
        rw [← h1]
        exact Ideal.mem_map_of_mem _ (by simp [RingHom.mem_ker])
      · have h2 : (chartHom k 1 : Ring3 k →+* Ring3 k) (X 2) = X 2 := by simp [chartHom]
        rw [← h2]
        exact Ideal.mem_map_of_mem _ (by simp [RingHom.mem_ker])
    · rw [Ideal.map_le_iff_le_comap]
      intro p hp
      rw [Ideal.mem_comap, RingHom.mem_ker, ← RingHom.comp_apply, hw, RingHom.comp_apply,
        RingHom.mem_ker.mp hp, map_zero]
  exact isPullback_SpecMap_of_isPushout _ _ _ _
    (isPushout_of_surjective (MvPolynomial.eval (0 : Fin 3 → k))
      (chartHom k 1 : Ring3 k →+* Ring3 k) (lineX k : Ring3 k →+* Polynomial k)
      (algebraMap k (Polynomial k)) hw (fun r ↦ ⟨C r, eval_C r⟩) (lineX_surjective k) hker)

/-- The chart `Spec k[x₁]` of `(B₁)_O` (on `U₂`). -/
def firstFibreChart : Spec (.of (Polynomial k)) ⟶ firstFibre k :=
  pullback.lift (Spec.map (CommRingCat.ofHom (lineX k : Ring3 k →+* Polynomial k)) ≫ chartι k 1)
    (Spec.map (CommRingCat.ofHom (algebraMap k (Polynomial k)))) (by
      rw [Category.assoc, chartι_comp_blowUpToBase]
      exact (isPullback_lineX k).w)

/-- The chart `Spec k[x₁]` of `(B₁)_O` is the preimage in `(B₁)_O` of the chart `U₂` of the first
blow-up. -/
theorem isPullback_firstFibreChart :
    IsPullback (firstFibreChart k)
      (Spec.map (CommRingCat.ofHom (lineX k : Ring3 k →+* Polynomial k)))
      (firstFibreι k) (chartι k 1) := by
  refine IsPullback.of_right (h₁₂ := firstFibreToPoint k) (v₁₃ := modelKPoint k 0)
    (h₂₂ := blowUpToBase (centreIdeal k)) ?_ (pullback.lift_fst _ _ _)
    (IsPullback.of_hasPullback _ _).flip
  rw [firstFibreChart, pullback.lift_snd, chartι_comp_blowUpToBase]
  exact (isPullback_lineX k).flip

/-- The chart `Spec k[x₁] ⟶ (B₁)_O` is an open immersion. -/
instance : IsOpenImmersion (firstFibreChart k) :=
  MorphismProperty.of_isPullback (P := @IsOpenImmersion) (isPullback_firstFibreChart k).flip
    inferInstance

/-- The restriction of `J'` to the coordinate line `Spec k[t]` of the chart `U₂` is `(t)`. -/
theorem comap_lineX_chartι_strictCurve :
    (strictCurve k).comap
        (Spec.map (CommRingCat.ofHom (lineX k : Ring3 k →+* Polynomial k)) ≫ chartι k 1) =
      idealSheafSpec (Ideal.span {(Polynomial.X : Polynomial k)}) := by
  rw [Scheme.IdealSheafData.comap_comp, comap_chartι_one_strictCentre]
  refine (comap_specMap_idealSheafSpec (lineX k : Ring3 k →+* Polynomial k) _).trans ?_
  congr 1
  rw [Ideal.map_span, Set.image_insert_eq, Set.image_singleton]
  have h0 : (lineX k : Ring3 k →+* Polynomial k) (X 0 - X 1) = Polynomial.X := by simp [lineX]
  have h2 : (lineX k : Ring3 k →+* Polynomial k) (X 2) = 0 := by simp [lineX]
  rw [h0, h2, Set.pair_comm, Ideal.span_insert_zero]

/-- The restriction of `J'` to `(B₁)_O` is an effective Cartier divisor. -/
theorem isEffectiveCartierDivisor_comap_firstFibreι :
    Stacks.Divisors.IsEffectiveCartierDivisor ((strictCurve k).comap (firstFibreι k)) := by
  refine Stacks.Chow.isEffectiveCartierDivisor_of_comap_of_isOpenImmersion _ (firstFibreChart k)
    ?_ ?_
  · intro x hx
    have hx' : x ∈ (((strictCurve k).comap (firstFibreι k)).support : Set (firstFibre k)) := hx
    rw [Scheme.IdealSheafData.support_comap] at hx'
    obtain ⟨y, hy⟩ := support_strictCentre_subset_range_chartι_one k hx'
    obtain ⟨z, hz, -⟩ := Scheme.Pullback.exists_preimage_pullback x y hy.symm
    refine ⟨(isPullback_firstFibreChart k).isoPullback.inv z, ?_⟩
    rw [← Scheme.Hom.comp_apply, IsPullback.isoPullback_inv_fst, hz]
  · rw [← Scheme.IdealSheafData.comap_comp,
      show firstFibreChart k ≫ firstFibreι k =
        Spec.map (CommRingCat.ofHom (lineX k : Ring3 k →+* Polynomial k)) ≫ chartι k 1 from
        pullback.lift_fst _ _ _, comap_lineX_chartι_strictCurve]
    exact isEffectiveCartierDivisor_idealSheafSpec_span_singleton _
      Polynomial.X_mem_nonZeroDivisors

/-- The inclusion `(B₁)_O ⟶ B₁` lifts to the second blow-up. -/
theorem exists_strictLift :
    ∃ g : firstFibre k ⟶ blowUp (strictCurve k),
      g ≫ blowUpToBase (strictCurve k) = firstFibreι k :=
  Stacks.Blowup.exists_hom_blowUp_of_isEffectiveCartierDivisor _ _
    (isEffectiveCartierDivisor_comap_firstFibreι k)

/-- **The strict transform `A` of `(B₁)_O`**: the lift of `(B₁)_O ⟶ B₁` to the second blow-up
(the universal property of blowing up, [Stacks, Tag 0806]). -/
def strictLift : firstFibre k ⟶ blowUp (strictCurve k) := (exists_strictLift k).choose

/-- The strict lift lies over the inclusion `(B₁)_O ⟶ B₁`. -/
theorem strictLift_comp : strictLift k ≫ blowUpToBase (strictCurve k) = firstFibreι k :=
  (exists_strictLift k).choose_spec

/-- The blow-up morphism of the second blow-up is separated ([Stacks, Tag 01O2]). -/
theorem sb3b_isSeparated_blowUpToBase_strictCurve :
    IsSeparated (blowUpToBase (strictCurve k)) :=
  Stacks.RelativeProj.Situation.isSeparated_relativeProjToBase _

/-- The strict lift `(B₁)_O ⟶ B₂` is a closed immersion. -/
instance : IsClosedImmersion (strictLift k) := by
  have : IsClosedImmersion (strictLift k ≫ blowUpToBase (strictCurve k)) := by
    rw [strictLift_comp]
    infer_instance
  exact IsClosedImmersion.of_comp (strictLift k) (blowUpToBase (strictCurve k))

/-- The line `v ↦ (v, 0, 0)` of the chart `U₂₁` lies over the line `x₁ ↦ (x₁, 0, 0)` of `U₂`. -/
theorem sb3b_lineX_comp_chartOneMap_comp_shiftHom :
    (lineX k : Ring3 k →+* Polynomial k).comp
        (((chartOneMap k).comp (shiftHom k) : Ring3 k →ₐ[k] Ring3 k) : Ring3 k →+* Ring3 k) =
      (lineX k : Ring3 k →+* Polynomial k) := by
  have halg : (lineX k).comp ((chartOneMap k).comp (shiftHom k)) = lineX k := by
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i <;> simp [lineX, shiftHom, blowupChartMap]
  exact congrArg (fun φ : Ring3 k →ₐ[k] Polynomial k => (φ : Ring3 k →+* Polynomial k)) halg

/-- On the chart `U₂₁`, the strict lift restricted to the chart `Spec k[x₁]` of `(B₁)_O` is the
line `v ↦ (v, 0, 0)` (uniqueness of lifts to the blow-up, [Stacks, Tag 0806]). -/
theorem sb3b_firstFibreChart_comp_strictLift :
    firstFibreChart k ≫ strictLift k =
      Spec.map (CommRingCat.ofHom (lineX k : Ring3 k →+* Polynomial k)) ≫ towerChartOne k := by
  refine Stacks.Blowup.eq_of_comp_eq (blowUpToBase (strictCurve k))
    (V := (strictCurve k).support.compl)
    (f := Spec.map (CommRingCat.ofHom (lineX k : Ring3 k →+* Polynomial k)) ≫ chartι k 1)
    ?_ _ _ ?_ ?_
  · rw [Stacks.Blowup.preimage_compl_support, comap_lineX_chartι_strictCurve]
    exact Stacks.Divisors.isSchemeTheoreticallyDense_compl_of_isEffectiveCartierDivisor _
      (isEffectiveCartierDivisor_idealSheafSpec_span_singleton _ Polynomial.X_mem_nonZeroDivisors)
  · rw [Category.assoc, strictLift_comp, firstFibreChart, pullback.lift_fst]
  · rw [Category.assoc, towerChartOne_comp_blowUpToBase, ← Category.assoc, ← Spec.map_comp,
      ← CommRingCat.ofHom_comp, sb3b_lineX_comp_chartOneMap_comp_shiftHom]

/-- On the chart `U₂₁`, the ideal sheaf of `A` is contained in `(X 1, X 2)`. -/
theorem comap_towerChartOne_ker_strictLift :
    (strictLift k).ker.comap (towerChartOne k) ≤ idealSheafOf k (Ideal.span {X 1, X 2}) := by
  refine (comap_ker_le_ker_of_comp_eq (strictLift k) (towerChartOne k) (firstFibreChart k)
    _ (sb3b_firstFibreChart_comp_strictLift k)).trans_eq ?_
  rw [ker_specMap_ofHom, ker_lineX]

/-- On the basic chart `towerBasicChart k f hf`, the ideal sheaf of `A` is contained in that
of `T_O`. -/
theorem comap_towerBasicChart_ker_strictLift (f : Ring3 k) (hf : f ∈ strictSpan k) :
    (strictLift k).ker.comap (towerBasicChart k f hf) ≤
      (towerFibreIdeal k).comap (towerBasicChart k f hf) := by
  let ψ : pullback (towerBasicChart k f hf) (originFibreι k) ⟶ firstFibre k :=
    pullback.lift (pullback.snd _ _ ≫ originFibreι k ≫ blowUpToBase (strictCurve k))
      (pullback.snd _ _ ≫ originFibreToPoint k) (by
        simp only [Category.assoc]
        rw [← pullback.condition])
  have htop : (pullback.fst (towerBasicChart k f hf) (originFibreι k) ≫
      towerBasicChart k f hf ≫ blowUpToBase (strictCurve k)) ⁻¹ᵁ
        (strictCurve k).support.compl = ⊤ := by
    rw [towerBasicChart_comp]
    exact eq_top_iff.2 fun x _ => range_firstBasicι_subset k f hf ⟨_, rfl⟩
  have hψ : ψ ≫ strictLift k =
      pullback.fst (towerBasicChart k f hf) (originFibreι k) ≫ towerBasicChart k f hf := by
    refine Stacks.Blowup.eq_of_comp_eq (blowUpToBase (strictCurve k))
      (V := (strictCurve k).support.compl)
      (f := pullback.fst (towerBasicChart k f hf) (originFibreι k) ≫
        towerBasicChart k f hf ≫ blowUpToBase (strictCurve k)) ?_ _ _ ?_ ?_
    · rw [htop]
      intro V
      rw [show V.ι ⁻¹ᵁ ⊤ = ⊤ by simp]
      have : IsIso (⊤ : V.toScheme.Opens).ι := (Scheme.topIso V.toScheme).isIso_hom
      infer_instance
    · rw [Category.assoc, strictLift_comp, pullback.lift_fst, pullback.condition_assoc]
    · rw [Category.assoc]
  refine (comap_ker_le_ker_of_comp_eq (strictLift k) (towerBasicChart k f hf) ψ _ hψ).trans_eq ?_
  rw [Scheme.IdealSheafData.ker_fst_of_isClosedImmersion, ker_originFibreι]

/-- `(B₁)_O` is isomorphic to `ℙ¹_k` over `Spec k`. -/
theorem exists_iso_projectiveLine_firstFibre :
    ∃ e : firstFibre k ≅ AlgebraicGeometry.Proj (polyGrading k 1),
      e.hom ≫ projToSpecCoeff k 1 = firstFibreToPoint k :=
  exists_iso_projectiveLine_pullback_blowUpToBase_centreIdeal k 0 rfl rfl

/-! ### The component `B`: the exceptional fibre over `o'` -/

/-- The point `o'` of the first blow-up lies over the origin. -/
theorem chartLinePoint_zero_comp : chartLinePoint k 0 ≫ blowUpToBase (centreIdeal k) =
    modelKPoint k 0 :=
  chartLinePoint_comp_blowUpToBase k 0 0 (by simp) (by simp) (by simp)

/-- The point `o'` is a closed immersion into the first blow-up. -/
instance : IsClosedImmersion (chartLinePoint k 0) := by
  have : IsClosedImmersion (chartLinePoint k 0 ≫ blowUpToBase (centreIdeal k)) := by
    rw [chartLinePoint_zero_comp]
    infer_instance
  exact IsClosedImmersion.of_comp _ (blowUpToBase (centreIdeal k))

/-- The fibre of the second blow-up over `o'`. -/
abbrev exceptionalFibre : Scheme.{u} :=
  pullback (blowUpToBase (strictCurve k)) (chartLinePoint k 0)

/-- The inclusion of the fibre over `o'` into the second blow-up. -/
abbrev exceptionalFibreι : exceptionalFibre k ⟶ blowUp (strictCurve k) := pullback.fst _ _

/-- The structure morphism of the fibre over `o'`. -/
abbrev exceptionalFibreToPoint : exceptionalFibre k ⟶ Spec (.of k) := pullback.snd _ _

/-- On a chart of the source of the tower over `U₂`, the fibre over `o'` contains the closed
subscheme `V(K)` as soon as `V(K)` maps to the point `x₁ = y = z = 0`. -/
theorem comap_ker_exceptionalFibreι_le (g : Spec (.of (Ring3 k)) ⟶ blowUp (strictCurve k))
    (ψ : Ring3 k →+* Ring3 k)
    (hg : g ≫ blowUpToBase (strictCurve k) = Spec.map (CommRingCat.ofHom ψ) ≫ chartι k 1)
    (K : Ideal (Ring3 k))
    (hK : (Ideal.Quotient.mk K).comp ψ =
      (algebraMap k (Ring3 k ⧸ K)).comp (MvPolynomial.eval ![0, 0, 0])) :
    (exceptionalFibreι k).ker.comap g ≤ idealSheafOf k K := by
  have hlift : (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk K)) ≫ g) ≫
      blowUpToBase (strictCurve k) =
        Spec.map (CommRingCat.ofHom (algebraMap k (Ring3 k ⧸ K))) ≫ chartLinePoint k 0 := by
    rw [Category.assoc, hg, chartLinePoint, modelKPoint]
    simp only [← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp, hK]
  have hle := comap_ker_le_ker_of_comp_eq (exceptionalFibreι k) g (pullback.lift _ _ hlift)
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk K))) (pullback.lift_fst _ _ _)
  rwa [ker_specMap_ofHom, Ideal.mk_ker] at hle

/-- Variant of `comap_ker_exceptionalFibreι_le` for an algebra map `φ` sending each variable
into `P`. -/
private theorem comap_ker_exceptionalFibreι_le_of_mem
    (g : Spec (.of (Ring3 k)) ⟶ blowUp (strictCurve k)) (φ : Ring3 k →ₐ[k] Ring3 k)
    (hg : g ≫ blowUpToBase (strictCurve k) =
      Spec.map (CommRingCat.ofHom (φ : Ring3 k →+* Ring3 k)) ≫ chartι k 1)
    (P : Ideal (Ring3 k)) (hP : ∀ i, φ (X i) ∈ P) :
    (exceptionalFibreι k).ker.comap g ≤ idealSheafOf k P := by
  refine comap_ker_exceptionalFibreι_le k g _ hg P
    (MvPolynomial.ringHom_ext (fun c => ?_) fun i => ?_)
  · simp only [RingHom.comp_apply, RingHom.coe_coe, MvPolynomial.algHom_C, MvPolynomial.eval_C]
    rfl
  · simpa [show (![0, 0, 0] : Fin 3 → k) i = 0 by fin_cases i <;> rfl] using
      Ideal.Quotient.eq_zero_iff_mem.mpr (hP i)

/-- On the chart `U₂₁`, the ideal sheaf of `B` is contained in `(X 1, X 0)`. -/
theorem comap_towerChartOne_ker_exceptionalFibreι :
    (exceptionalFibreι k).ker.comap (towerChartOne k) ≤
      idealSheafOf k (Ideal.span {X 1, X 0}) := by
  refine comap_ker_exceptionalFibreι_le_of_mem k _ _ (towerChartOne_comp_blowUpToBase k) _
    fun i => ?_
  have h0 : (X 0 : Ring3 k) ∈ Ideal.span {X 1, X 0} := Ideal.subset_span (by simp)
  have h1 : (X 1 : Ring3 k) ∈ Ideal.span {X 1, X 0} := Ideal.subset_span (by simp)
  fin_cases i <;> simp [shiftHom, blowupChartMap, h1, Ideal.add_mem _ h0 h1,
    Ideal.mul_mem_right _ _ h0]

/-- On the chart `towerChartTwo k`, the ideal sheaf of `B` is contained in `(X 1, X 2)`. -/
theorem comap_towerChartTwo_ker_exceptionalFibreι :
    (exceptionalFibreι k).ker.comap (towerChartTwo k) ≤
      idealSheafOf k (Ideal.span {X 1, X 2}) := by
  refine comap_ker_exceptionalFibreι_le_of_mem k _ _ (towerChartTwo_comp_blowUpToBase k) _
    fun i => ?_
  have h1 : (X 1 : Ring3 k) ∈ Ideal.span {X 1, X 2} := Ideal.subset_span (by simp)
  have h2 : (X 2 : Ring3 k) ∈ Ideal.span {X 1, X 2} := Ideal.subset_span (by simp)
  fin_cases i <;> simp [shiftHom, blowupChartMap, h1, h2,
    Ideal.add_mem _ (Ideal.mul_mem_right _ _ h2) h1]

/-! ### The nodal decomposition -/

/-- The strict lift of `(B₁)_O` lies over the origin. -/
theorem strictLift_comp_strictTower :
    strictLift k ≫ strictTower (centreIdeal k) (curveIdeal k) =
      firstFibreToPoint k ≫ modelKPoint k 0 := by
  rw [strictTower, ← Category.assoc, strictLift_comp, pullback.condition]

/-- The fibre of the second blow-up over `o'` lies over the origin. -/
theorem exceptionalFibreι_comp_strictTower :
    exceptionalFibreι k ≫ strictTower (centreIdeal k) (curveIdeal k) =
      exceptionalFibreToPoint k ≫ modelKPoint k 0 := by
  rw [strictTower, ← Category.assoc, pullback.condition, Category.assoc,
    chartLinePoint_zero_comp]

/-- `A` as a closed subscheme of `T_O`. -/
def componentAι : firstFibre k ⟶ originFibre k :=
  pullback.lift (strictLift k) (firstFibreToPoint k) (strictLift_comp_strictTower k)

/-- `B` as a closed subscheme of `T_O`. -/
def componentBι : exceptionalFibre k ⟶ originFibre k :=
  pullback.lift (exceptionalFibreι k) (exceptionalFibreToPoint k)
    (exceptionalFibreι_comp_strictTower k)

/-- The composite `A ⟶ T_O ⟶ B₂` is the strict lift. -/
@[reassoc (attr := simp)]
theorem componentAι_fst : componentAι k ≫ originFibreι k = strictLift k :=
  pullback.lift_fst _ _ _

/-- The composite `A ⟶ T_O ⟶ Spec k` is the structure morphism of `(B₁)_O`. -/
@[reassoc (attr := simp)]
theorem componentAι_snd : componentAι k ≫ originFibreToPoint k = firstFibreToPoint k :=
  pullback.lift_snd _ _ _

/-- The composite `B ⟶ T_O ⟶ B₂` is the inclusion of the fibre over `o'`. -/
@[reassoc (attr := simp)]
theorem componentBι_fst : componentBι k ≫ originFibreι k = exceptionalFibreι k :=
  pullback.lift_fst _ _ _

/-- The composite `B ⟶ T_O ⟶ Spec k` is the structure morphism of the fibre over `o'`. -/
@[reassoc (attr := simp)]
theorem componentBι_snd : componentBι k ≫ originFibreToPoint k = exceptionalFibreToPoint k :=
  pullback.lift_snd _ _ _

/-- **The fibre over the origin is the union of `A` and `B`**, as ideal sheaves on the source of
the tower: checked on the four charts. -/
theorem ker_strictLift_inf_ker_exceptionalFibreι :
    (strictLift k).ker ⊓ (exceptionalFibreι k).ker = (originFibreι k).ker := by
  refine le_antisymm ?_ (le_inf ?_ ?_)
  · rw [ker_originFibreι]
    refine le_of_comap_le_four (towerChartOne k) (towerChartTwo k)
      (towerBasicChart k _ (unitEq_mem_strictSpan k))
      (towerBasicChart k _ (X_two_mem_strictSpan k)) (towerChart_cover k) ?_ ?_ ?_ ?_
    · refine ((Scheme.IdealSheafData.map_gc (towerChartOne k)).monotone_l.map_inf_le _ _).trans ?_
      rw [comap_towerChartOne_towerFibreIdeal]
      refine (inf_le_inf (comap_towerChartOne_ker_strictLift k)
        (comap_towerChartOne_ker_exceptionalFibreι k)).trans (idealSheafOf_inf_le k ?_)
      rw [span_X_one_mul_eq_inf, inf_comm]
    · refine ((Scheme.IdealSheafData.map_gc (towerChartTwo k)).monotone_l.map_inf_le _ _).trans
        (inf_le_right.trans ?_)
      rw [comap_towerChartTwo_towerFibreIdeal]
      exact comap_towerChartTwo_ker_exceptionalFibreι k
    · exact ((Scheme.IdealSheafData.map_gc _).monotone_l.map_inf_le _ _).trans
        (inf_le_left.trans (comap_towerBasicChart_ker_strictLift k _ _))
    · exact ((Scheme.IdealSheafData.map_gc _).monotone_l.map_inf_le _ _).trans
        (inf_le_left.trans (comap_towerBasicChart_ker_strictLift k _ _))
  · rw [← componentAι_fst]
    exact Scheme.Hom.le_ker_comp _ _
  · rw [← componentBι_fst]
    exact Scheme.Hom.le_ker_comp _ _

/-- The inclusion `A ⟶ T_O` is a closed immersion. -/
instance : IsClosedImmersion (componentAι k) := by
  have : IsClosedImmersion (componentAι k ≫ originFibreι k) := by
    rw [componentAι_fst]
    infer_instance
  exact IsClosedImmersion.of_comp _ (originFibreι k)

/-- The inclusion `B ⟶ T_O` is a closed immersion. -/
instance : IsClosedImmersion (componentBι k) := by
  have : IsClosedImmersion (componentBι k ≫ originFibreι k) := by
    rw [componentBι_fst]
    infer_instance
  exact IsClosedImmersion.of_comp _ (originFibreι k)

/-- The ideal sheaf of `A` in `T_O`. -/
def componentA : (originFibre k).IdealSheafData := (componentAι k).ker

/-- The ideal sheaf of `B` in `T_O`. -/
def componentB : (originFibre k).IdealSheafData := (componentBι k).ker

/-- **`T_O` is the scheme-theoretic union of `A` and `B`.** -/
theorem componentA_inf_componentB : componentA k ⊓ componentB k = ⊥ := by
  have hmap : (componentA k ⊓ componentB k).map (originFibreι k) =
      (⊥ : (originFibre k).IdealSheafData).map (originFibreι k) := by
    rw [Scheme.IdealSheafData.map_bot, ← ker_strictLift_inf_ker_exceptionalFibreι,
      (Scheme.IdealSheafData.map_gc (originFibreι k)).u_inf, componentA, componentB,
      Scheme.IdealSheafData.map_ker, Scheme.IdealSheafData.map_ker, componentAι_fst,
      componentBι_fst]
  rw [← Scheme.IdealSheafData.comap_map_of_isClosedImmersion (componentA k ⊓ componentB k)
    (originFibreι k), hmap, Scheme.IdealSheafData.comap_map_of_isClosedImmersion]

/-- The node `A ∩ B`, as a `k`-point of `(B₁)_O`. -/
def nodePoint : Spec (.of k) ⟶ firstFibre k :=
  pullback.lift (chartLinePoint k 0) (𝟙 _) (by rw [chartLinePoint_zero_comp, Category.id_comp])

/-- The node maps to the point `o'` of the first blow-up. -/
@[reassoc (attr := simp)]
theorem nodePoint_fst : nodePoint k ≫ firstFibreι k = chartLinePoint k 0 :=
  pullback.lift_fst _ _ _

/-- The node is a section of the structure morphism of `(B₁)_O`. -/
@[reassoc (attr := simp)]
theorem nodePoint_snd : nodePoint k ≫ firstFibreToPoint k = 𝟙 _ :=
  pullback.lift_snd _ _ _

/-- The node `A ∩ B`, as a `k`-point of `B`. -/
def nodePointB : Spec (.of k) ⟶ exceptionalFibre k :=
  pullback.lift (nodePoint k ≫ strictLift k) (𝟙 _) (by
    rw [Category.assoc, strictLift_comp, nodePoint_fst, Category.id_comp])

/-- The node of `B` and the node of `(B₁)_O` have the same image in the second blow-up. -/
@[reassoc (attr := simp)]
theorem nodePointB_fst : nodePointB k ≫ exceptionalFibreι k = nodePoint k ≫ strictLift k :=
  pullback.lift_fst _ _ _

/-- The node of `B` is a section of the structure morphism of `B`. -/
@[reassoc (attr := simp)]
theorem nodePointB_snd : nodePointB k ≫ exceptionalFibreToPoint k = 𝟙 _ :=
  pullback.lift_snd _ _ _

/-- **`A` and `B` meet in the node**, a cartesian square over `T_O`. -/
theorem isPullback_nodePoint :
    IsPullback (nodePoint k) (nodePointB k) (componentAι k) (componentBι k) := by
  have hw : nodePoint k ≫ componentAι k = nodePointB k ≫ componentBι k := by
    apply pullback.hom_ext <;> simp
  have hL : ∀ s : PullbackCone (componentAι k) (componentBι k),
      (s.snd ≫ exceptionalFibreToPoint k) ≫ nodePoint k = s.fst := by
    intro s
    have hc := s.condition
    have h1 := congrArg (· ≫ originFibreι k ≫ blowUpToBase (strictCurve k)) hc
    have h2 := congrArg (· ≫ originFibreToPoint k) hc
    simp only [Category.assoc, componentAι_fst_assoc, componentBι_fst_assoc, strictLift_comp,
      componentAι_snd, componentBι_snd] at h1 h2
    apply pullback.hom_ext
    · simp only [Category.assoc, nodePoint_fst]
      rw [h1, ← pullback.condition]
    · simp only [Category.assoc, nodePoint_snd, Category.comp_id]
      rw [h2]
  refine IsPullback.of_isLimit (PullbackCone.IsLimit.mk hw
    (fun s => s.snd ≫ exceptionalFibreToPoint k) hL (fun s => ?_) (fun s m _ hm₂ => ?_))
  · have h1 := congrArg (· ≫ originFibreι k) s.condition
    simp only [Category.assoc, componentAι_fst, componentBι_fst] at h1
    apply pullback.hom_ext
    · rw [Category.assoc, nodePointB_fst, ← Category.assoc, hL, h1]
    · simp only [Category.assoc, nodePointB_snd, Category.comp_id]
  · rw [← hm₂, Category.assoc, nodePointB_snd, Category.comp_id]

/-- **`A ∩ B` is the node**: the ideal sheaf of the scheme-theoretic intersection is the kernel of
the node. -/
theorem componentA_sup_componentB :
    componentA k ⊔ componentB k = (nodePoint k ≫ componentAι k).ker := by
  refine le_antisymm (sup_le (Scheme.Hom.le_ker_comp _ _) ?_)
    (ker_le_ker_comp_of_isPullback (isPullback_nodePoint k))
  rw [(isPullback_nodePoint k).w]
  exact Scheme.Hom.le_ker_comp _ _

/-- The scheme-theoretic intersection `A ∩ B` maps isomorphically to `Spec k`. -/
theorem isIso_sup_subschemeι_comp :
    IsIso ((componentA k ⊔ componentB k).subschemeι ≫ originFibreToPoint k) := by
  have : Subsingleton (Spec (CommRingCat.of k)) :=
    inferInstanceAs (Subsingleton (PrimeSpectrum k))
  have : IsClosedImmersion (nodePoint k ≫ componentAι k) :=
    isClosedImmersion_of_comp_eq_id (originFibreToPoint k) _ (by simp)
  have hker : (nodePoint k ≫ componentAι k).ker = (componentA k ⊔ componentB k).subschemeι.ker := by
    rw [Scheme.IdealSheafData.ker_subschemeι, componentA_sup_componentB]
  have hfac := IsClosedImmersion.lift_fac (nodePoint k ≫ componentAι k)
    (componentA k ⊔ componentB k).subschemeι hker.le
  have : (componentA k ⊔ componentB k).subschemeι ≫ originFibreToPoint k =
      IsClosedImmersion.lift (nodePoint k ≫ componentAι k)
        (componentA k ⊔ componentB k).subschemeι hker.le := by
    have h := congrArg (· ≫ originFibreToPoint k) hfac
    simp only [Category.assoc, componentAι_snd, nodePoint_snd] at h
    exact h.symm
  rw [this]
  exact IsClosedImmersion.isIso_lift _ _ hker

/-- A closed immersion `f` is isomorphic to the closed subscheme cut out by its kernel, compatibly
with every factorization through `f`. -/
private theorem exists_iso_ker_subscheme {X Y : Scheme.{u}} (f : X ⟶ Y) [IsClosedImmersion f] :
    ∃ e : f.ker.subscheme ≅ X, ∀ {Z : Scheme.{u}} (a : X ⟶ Z) (c : Y ⟶ Z),
      f ≫ c = a → e.hom ≫ a = f.ker.subschemeι ≫ c := by
  have : IsIso f.toImage :=
    IsClosedImmersion.isIso_of_ker_eq _ f.imageι _ f.toImage_imageι
      (Scheme.IdealSheafData.ker_subschemeι _).symm
  refine ⟨(asIso f.toImage).symm, fun a c h => ?_⟩
  rw [Iso.symm_hom, asIso_inv, IsIso.inv_comp_eq]
  change _ = f.toImage ≫ f.imageι ≫ _
  rw [← Category.assoc, Scheme.Hom.toImage_imageι, h]

/-- `A` is isomorphic to `ℙ¹_k` over `Spec k`. -/
theorem exists_iso_componentA :
    ∃ eA : (componentA k).subscheme ≅ AlgebraicGeometry.Proj (polyGrading k 1),
      eA.hom ≫ projToSpecCoeff k 1 = (componentA k).subschemeι ≫ originFibreToPoint k := by
  unfold componentA
  obtain ⟨e₀, he₀⟩ := exists_iso_ker_subscheme (componentAι k)
  obtain ⟨e, he⟩ := exists_iso_projectiveLine_firstFibre k
  refine ⟨e₀ ≪≫ e, ?_⟩
  rw [Iso.trans_hom, Category.assoc, he]
  exact he₀ _ _ (componentAι_snd k)

/-- `B` is isomorphic to every fibre `F'` of the exceptional divisor of the second blow-up over
`o'`, compatibly with the maps to the second blow-up and to `Spec k`. -/
theorem exists_iso_componentB {F' : Scheme.{u}}
    (q' : F' ⟶ exceptionalDivisor (strictCurve k)) (g' : F' ⟶ Spec (.of k))
    (h : IsPullback q' g' (Stacks.AlgebraicGeometry.exceptionalSubschemeMap (strictCurve k))
      (strictLinePoint k 0)) :
    ∃ e : (componentB k).subscheme ≅ F',
      e.hom ≫ q' ≫ (exceptionalIdeal (strictCurve k)).subschemeι =
          (componentB k).subschemeι ≫ originFibreι k ∧
        e.hom ≫ g' = (componentB k).subschemeι ≫ originFibreToPoint k := by
  unfold componentB
  obtain ⟨e₀, he₀⟩ := exists_iso_ker_subscheme (componentBι k)
  have h' := (Stacks.AlgebraicGeometry.isPullback_blowUpToBase_comp_subschemeι_iff
    (strictCurve k) (strictLinePoint k 0) q' g').mpr h
  rw [strictLinePoint_subschemeι] at h'
  let e₂ := (IsPullback.of_hasPullback (blowUpToBase (strictCurve k))
    (chartLinePoint k 0)).isoIsPullback _ _ h'
  have he₁ : e₂.hom ≫ q' ≫ (exceptionalIdeal (strictCurve k)).subschemeι = exceptionalFibreι k :=
    IsPullback.isoIsPullback_hom_fst _ _ _ _
  have he₂ : e₂.hom ≫ g' = exceptionalFibreToPoint k := IsPullback.isoIsPullback_hom_snd _ _ _ _
  refine ⟨e₀ ≪≫ e₂, ?_, ?_⟩
  · rw [Iso.trans_hom, Category.assoc, he₁]
    exact he₀ _ _ (componentBι_fst k)
  · rw [Iso.trans_hom, Category.assoc, he₂]
    exact he₀ _ _ (componentBι_snd k)

/-- **The nodal decomposition of the fibre of the model tower over the origin.** -/
theorem nodal_originFibre :
    ∃ (ZO : Scheme.{u}) (qO : ZO ⟶ modelSpace k) (gO : ZO ⟶ Spec (.of k))
      (_ : IsPullback qO gO (modelTower k) (modelKPoint k 0)) (IA IB : ZO.IdealSheafData),
      IA ⊓ IB = ⊥ ∧ IsIso ((IA ⊔ IB).subschemeι ≫ gO) ∧
      (∃ eA : IA.subscheme ≅ AlgebraicGeometry.Proj (polyGrading k 1),
        eA.hom ≫ projToSpecCoeff k 1 = IA.subschemeι ≫ gO) ∧
      ∃ o' : Spec (.of k) ⟶
          (strictCentre (modelIdealSheafI k) (modelIdealSheafJ k)).subscheme,
        ∀ {F' : Scheme.{u}}
          (q' : F' ⟶ exceptionalDivisor (strictCentre (modelIdealSheafI k) (modelIdealSheafJ k)))
          (g' : F' ⟶ Spec (.of k)),
          IsPullback q' g' (Stacks.AlgebraicGeometry.exceptionalSubschemeMap
            (strictCentre (modelIdealSheafI k) (modelIdealSheafJ k))) o' →
          ∃ e : IB.subscheme ≅ F',
            e.hom ≫ q' ≫ (exceptionalIdeal
              (strictCentre (modelIdealSheafI k) (modelIdealSheafJ k))).subschemeι =
                IB.subschemeι ≫ qO ∧
              e.hom ≫ g' = IB.subschemeι ≫ gO :=
  ⟨originFibre k, originFibreι k, originFibreToPoint k, IsPullback.of_hasPullback _ _,
    componentA k, componentB k, componentA_inf_componentB k, isIso_sup_subschemeι_comp k,
    exists_iso_componentA k, strictLinePoint k 0, fun q' g' h => exists_iso_componentB k q' g' h⟩

/-- **The model facts of Hironaka's example.** -/
theorem modelFacts : ModelFacts k :=
  modelFacts_of_nodal k (nodal_originFibre k)

end Stacks.Examples.HironakaLocalModel

