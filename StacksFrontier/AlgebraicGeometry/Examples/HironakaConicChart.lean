/-!
# The two affine charts of `ℙ³` on which Hironaka's tower is one local model

Hironaka's example (Stacks Tag 08J1, see
`StacksFrontier/AlgebraicGeometry/Examples/ProjectivityNotLocalOnBase.lean`) blows up the two conics
`C = {X₀X₁ = X₂², X₃ = 0}` and `D = {X₀X₁ = X₃², X₂ = 0}` of `Y = ℙ³_k` in the two orders over
`Y - {Q}` and `Y - {P}`, where `P = [1 : 0 : 0 : 0]` and `Q = [0 : 1 : 0 : 0]` are the two points
of `C ∩ D`. This file shows that near `P` and near `Q` the pair of conics is the **same local
model**: on `A = k[x, y, z]` the pair of ideals

`I = (x, y)`,  `J = (x - y², z)`.

* On the chart `D₊(X₀)`, with affine coordinates `a = X₁/X₀`, `b = X₂/X₀`, `c = X₃/X₀`, the
  ideals are `C = (a - b², c)` and `D = (a - c², b)`; in the coordinates `x = a - b²`, `y = c`,
  `z = b` they become `C = (x, y)` and `D = (x + z² - y², z) = (x - y², z)`.
* On the chart `D₊(X₁)`, with `a' = X₀/X₁`, `b' = X₂/X₁`, `c' = X₃/X₁`, the roles are swapped:
  `x = a' - c'²`, `y = b'`, `z = c'` give `D = (x, y)` and `C = (x - y², z)`.

The open immersions `chartP, chartQ : Spec A ⟶ Y` are the standard charts
`Spec k[X]_{(X i)} ⟶ Proj k[X]` (`AlgebraicGeometry.Proj.awayι`) precomposed with the
identification `k[X]_{(X i)} ≅ k[Y_j : j ≠ i]`
(`Stacks.AlgebraicGeometry.ProjPolyChart.chartEquiv`) and the coordinate change above.

## Main definitions

* `Stacks.Examples.HironakaConicChart.modelIdealSheafI`,
  `Stacks.Examples.HironakaConicChart.modelIdealSheafJ`: the ideal sheaves of `(x, y)` and
  `(x - y², z)` on `Spec k[x, y, z]`.
* `Stacks.Examples.HironakaConicChart.chartP`, `Stacks.Examples.HironakaConicChart.chartQ`: the
  two open immersions `Spec k[x, y, z] ⟶ ℙ³_k`, onto `D₊(X₀)` and `D₊(X₁)`.
* `Stacks.Examples.HironakaConicChart.chartPAwayQ`,
  `Stacks.Examples.HironakaConicChart.chartQAwayP`: the same charts as open immersions into
  `Y - {Q}` and `Y - {P}`.
* `Stacks.Examples.HironakaConicChart.modelPoint`: the `k`-rational point `(c₀, c₁, c₂)` of
  `Spec k[x, y, z]`, and `Stacks.Examples.HironakaConicChart.modelKPoint` the corresponding
  morphism `Spec k ⟶ Spec k[x, y, z]`.
* `Stacks.Examples.HironakaConicChart.pointC₀`, `Stacks.Examples.HironakaConicChart.pointD₀`: the
  points `[1 : 1 : 1 : 0] ∈ C` and `[1 : 1 : 0 : 1] ∈ D`.

## Main results

All in the namespace `Stacks.Examples.HironakaConicChart`:

* `comap_idealSheafC_chartP`, `comap_idealSheafD_chartP`: `C|_{D₊(X₀)} = I`, `D|_{D₊(X₀)} = J`.
* `comap_idealSheafD_chartQ`, `comap_idealSheafC_chartQ`: `D|_{D₊(X₁)} = I`, `C|_{D₊(X₁)} = J`;
  `comap_comap_idealSheafC_chartPAwayQ` and its three siblings say the same for the restrictions
  of `C` and `D` to `Y - {Q}`, `Y - {P}`, the form `AlgebraicGeometry.TwoStepTower`'s restriction
  lemma `exists_isPullback_strictTower` consumes.
* `chartP_origin`, `chartQ_origin`: the origin goes to `P`, resp. `Q`.
* `range_chartP_subset_opensAwayQ`, `range_chartQ_subset_opensAwayP`.
* `basicOpen_X_zero_inter_supportSet_idealSheafC` (and the three siblings): each chart contains
  each conic minus one of the two special points.
* `chartQ_modelPoint_eq_pointC₀`, `chartQ_modelPoint_eq_pointD₀`: the model coordinates of
  `c₀` and `d₀` in the two charts (`c₀ = chartP (0, 0, 1) = chartQ (1, 1, 0)`,
  `d₀ = chartP (1, 1, 0) = chartQ (0, 0, 1)`); `span_le_iff_eq_pointC₀`, `span_le_iff_eq_pointD₀`
  identify `c₀`, `d₀` by their homogeneous ideals; `pointC₀_mem_supportSet_idealSheafC`,
  `pointD₀_mem_supportSet_idealSheafD` and `pointC₀_ne_pointP` etc. place them on `C - {P, Q}`,
  `D - {P, Q}`.

## Implementation notes

The general statement `comap_chart_homogeneousIdealSheaf` computes the pullback of the ideal
sheaf of a homogeneous ideal with finitely many generators along `Spec B ⟶ Spec A_{(f)} ⟶ Proj`:
by `homogeneousIdealSheaf_ideal_basicOpen_eq_span_range` the ideal over `D₊(f)` is generated by
the chart functions `v_j / f^{m_j}`, and `appLE_awayι_awayToSection` says the chart takes them to
themselves. Points are then handled through supports: a point of the chart lies in `V₊(𝔞)`
exactly when the chart generators of `𝔞` vanish at its model point
(`le_asHomogeneousIdeal_chart_iff`).
-/

@[expose] public noncomputable section

open CategoryTheory MvPolynomial AlgebraicGeometry HomogeneousLocalization
open AlgebraicGeometry.ProjectiveSpectrum.Proj (homogeneousIdealSheaf
  mem_supportSet_homogeneousIdealSheaf_iff homogeneousIdealSheaf_ideal_basicOpen_eq_span_range)
open Stacks.Examples.HironakaConicIntersection Stacks.Examples.HironakaConicIdealSheaf

universe u

namespace Stacks.Examples.HironakaConicChart

/-! ### The ideal sheaf of an ideal on an affine scheme -/

section SpecIdeal

variable {R : Type u} [CommRing R]

/-- The ideal sheaf on `Spec R` of an ideal `𝔞 ⊆ R`. (Definitionally the same as
`Stacks.Blowup.AffineModel.specIdealSheaf 𝔞` and `Stacks.LocalCohomology.specIdealSheaf R 𝔞`.) -/
abbrev specIdeal (𝔞 : Ideal R) : (Spec (CommRingCat.of R)).IdealSheafData :=
  Scheme.IdealSheafData.ofIdealTop (𝔞.map (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom)

/-- The ideal of global sections of `specIdeal 𝔞`. -/
theorem ideal_specIdeal_top (𝔞 : Ideal R) :
    (specIdeal 𝔞).ideal ⟨⊤, isAffineOpen_top _⟩ =
      𝔞.map (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom := by
  simp

/-- The support of the ideal sheaf of `𝔞` on `Spec R` is `V(𝔞)`. -/
theorem mem_supportSet_specIdeal_iff (𝔞 : Ideal R) (p : Spec (CommRingCat.of R)) :
    p ∈ (specIdeal 𝔞).supportSet ↔ 𝔞 ≤ p.asIdeal := by
  rw [Scheme.IdealSheafData.mem_supportSet_iff_mem_support, ← SetLike.mem_coe,
    Scheme.IdealSheafData.coe_support_ofIdealTop, AlgebraicGeometry.Spec_zeroLocus]
  change p ∈ PrimeSpectrum.zeroLocus
    ((Ideal.comap (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom
      (𝔞.map (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom) : Ideal R) : Set R) ↔ _
  rw [Ideal.comap_map_of_surjective' (Scheme.ΓSpecIso (CommRingCat.of R)).inv.hom
    (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of R)).inv).2 𝔞,
    (RingHom.injective_iff_ker_eq_bot _).mp
      (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (CommRingCat.of R)).inv).1,
    sup_bot_eq]
  exact Iff.rfl

/-- The ideal sheaf of `𝔞` pulls back along `Spec R' ⟶ Spec R` to the ideal sheaf of `g(𝔞)`. -/
theorem comap_specIdeal {R' : Type u} [CommRing R'] (g : R →+* R') (𝔞 : Ideal R) :
    (specIdeal 𝔞).comap (Spec.map (CommRingCat.ofHom g)) = specIdeal (𝔞.map g) := by
  rw [Stacks.AlgebraicGeometry.comap_ofIdealTop, Ideal.map_map]
  change _ = Scheme.IdealSheafData.ofIdealTop _
  rw [Ideal.map_map]
  congr 2
  have h := Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom g)
  exact (congrArg CommRingCat.Hom.hom h).symm

end SpecIdeal

/-- A point lies in the support of an ideal sheaf exactly when its image does, read through the
pullback. -/
theorem mem_supportSet_comap_iff {X Z : Scheme.{u}} (I : Z.IdealSheafData) (φ : X ⟶ Z) (x : X) :
    x ∈ (I.comap φ).supportSet ↔ φ x ∈ I.supportSet := by
  simp only [Scheme.IdealSheafData.mem_supportSet_iff_mem_support,
    Scheme.IdealSheafData.support_comap]
  rfl

/-! ### Pulling back the ideal sheaf of a homogeneous ideal to a standard chart -/

section Chart

variable {S σ : Type u} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S] (𝒮 : ℕ → σ)
  [GradedRing 𝒮] (𝔞 : HomogeneousIdeal 𝒮) {f : S} {d : ℕ} (hf : f ∈ 𝒮 d) (hd : 0 < d)
  {ι : Type*} [Finite ι] (v : ι → S) (m : ι → ℕ) (hv : ∀ j, v j ∈ 𝒮 (m j • d))
  (h𝔞 : 𝔞.toIdeal = Ideal.span (Set.range v))

include h𝔞

/-- **The ideal sheaf of a homogeneous ideal on a standard chart.** If `𝔞` is generated by
finitely many homogeneous `v j` of degrees `m j · d`, its ideal sheaf pulls back along the chart
`Spec A_{(f)} ⟶ Proj 𝒮` to the ideal sheaf of the ideal generated by the fractions
`v j / f ^ (m j)`. -/
theorem comap_awayι_homogeneousIdealSheaf :
    (homogeneousIdealSheaf 𝒮 𝔞).comap (Proj.awayι 𝒮 f hf hd) =
      specIdeal (Ideal.span (Set.range fun j => Away.mk 𝒮 hf (m j) (v j) (hv j))) := by
  apply Scheme.IdealSheafData.ext_of_isAffine
  have hle : (⊤ : (Spec (CommRingCat.of (Away 𝒮 f))).Opens) ≤
      Proj.awayι 𝒮 f hf hd ⁻¹ᵁ Proj.basicOpen 𝒮 f := by
    intro x _
    change Proj.awayι 𝒮 f hf hd x ∈ Proj.basicOpen 𝒮 f
    rw [← Proj.opensRange_awayι 𝒮 f hf hd]
    exact ⟨x, rfl⟩
  rw [Stacks.IdealSheaf.ideal_comap_appLE _ _
      ⟨Proj.basicOpen 𝒮 f, Proj.isAffineOpen_basicOpen 𝒮 f hf hd⟩ ⟨⊤, isAffineOpen_top _⟩ hle,
    homogeneousIdealSheaf_ideal_basicOpen_eq_span_range 𝒮 𝔞 hf hd v m hv h𝔞,
    ideal_specIdeal_top, Ideal.map_span, Ideal.map_span, ← Set.range_comp, ← Set.range_comp]
  congr 2
  funext j
  exact Stacks.AlgebraicGeometry.ProjTwistChain.appLE_awayι_awayToSection hd hf hle _

/-- **The ideal sheaf of a homogeneous ideal on a chart `Spec B ⟶ Spec A_{(f)} ⟶ Proj 𝒮`.** -/
theorem comap_chart_homogeneousIdealSheaf {B : Type u} [CommRing B] (g : Away 𝒮 f →+* B) :
    (homogeneousIdealSheaf 𝒮 𝔞).comap (Spec.map (CommRingCat.ofHom g) ≫ Proj.awayι 𝒮 f hf hd) =
      specIdeal (Ideal.span (Set.range fun j => g (Away.mk 𝒮 hf (m j) (v j) (hv j)))) := by
  rw [Scheme.IdealSheafData.comap_comp, comap_awayι_homogeneousIdealSheaf 𝒮 𝔞 hf hd v m hv h𝔞,
    comap_specIdeal, Ideal.map_span, ← Set.range_comp]
  rfl

/-- **Points of a chart in `V₊(𝔞)`.** The image of a point `p` of `Spec B` under the chart
`Spec B ⟶ Spec A_{(f)} ⟶ Proj 𝒮` contains `𝔞` exactly when `p` contains the chart generators
`g (v j / f ^ (m j))`. -/
theorem le_asHomogeneousIdeal_chart_iff {B : Type u} [CommRing B] (g : Away 𝒮 f →+* B)
    (p : Spec (CommRingCat.of B)) :
    𝔞.toIdeal ≤
        ((Spec.map (CommRingCat.ofHom g) ≫ Proj.awayι 𝒮 f hf hd) p).asHomogeneousIdeal.toIdeal ↔
      ∀ j, g (Away.mk 𝒮 hf (m j) (v j) (hv j)) ∈ p.asIdeal := by
  rw [← mem_supportSet_homogeneousIdealSheaf_iff, ← mem_supportSet_comap_iff,
    comap_chart_homogeneousIdealSheaf 𝒮 𝔞 hf hd v m hv h𝔞, mem_supportSet_specIdeal_iff,
    Ideal.span_le, Set.range_subset_iff]
  rfl

end Chart

/-! ### The local model -/

section Model

variable (k : Type u) [Field k]

attribute [local instance] MvPolynomial.gradedAlgebra

/-- The coordinate ring `A = k[x, y, z]` of the local model, `x, y, z = X 0, X 1, X 2`. -/
abbrev ModelRing : Type u := MvPolynomial (Fin 3) k

/-- The first centre of the local model: `I = (x, y)`. -/
def modelIdealI : Ideal (ModelRing k) := Ideal.span {X 0, X 1}

/-- The second centre of the local model: `J = (x - y², z)`. -/
def modelIdealJ : Ideal (ModelRing k) := Ideal.span {X 0 - X 1 ^ 2, X 2}

/-- The ideal sheaf of `I = (x, y)` on `Spec k[x, y, z]`. -/
abbrev modelIdealSheafI : (Spec (CommRingCat.of (ModelRing k))).IdealSheafData :=
  specIdeal (modelIdealI k)

/-- The ideal sheaf of `J = (x - y², z)` on `Spec k[x, y, z]`. -/
abbrev modelIdealSheafJ : (Spec (CommRingCat.of (ModelRing k))).IdealSheafData :=
  specIdeal (modelIdealJ k)

/-! #### The chart `D₊(X₀)` -/

/-- The affine coordinate `X_j / X₀` of the chart `D₊(X₀)`, as a variable of `k[Y_j : j ≠ 0]`. -/
abbrev yP (j : Fin 4) (hj : j ≠ 0) : MvPolynomial {j : Fin (3 + 1) // j ≠ 0} k := X ⟨j, hj⟩

/-- The coordinate change `x ↦ a - b²`, `y ↦ c`, `z ↦ b` on `D₊(X₀)`
(`a, b, c = X₁/X₀, X₂/X₀, X₃/X₀`). -/
def toChartP : ModelRing k →ₐ[k] MvPolynomial {j : Fin (3 + 1) // j ≠ 0} k :=
  aeval ![yP k 1 (by decide) - yP k 2 (by decide) ^ 2, yP k 3 (by decide), yP k 2 (by decide)]

/-- Its inverse `a ↦ x + z²`, `b ↦ z`, `c ↦ y`. -/
def ofChartP : MvPolynomial {j : Fin (3 + 1) // j ≠ 0} k →ₐ[k] ModelRing k :=
  aeval fun j => ![0, X 0 + X 2 ^ 2, X 2, X 1] j.1

/-- `ofChartP` is a left inverse of `toChartP`. -/
theorem ofChartP_comp_toChartP : (ofChartP k).comp (toChartP k) = AlgHom.id k _ := by
  refine MvPolynomial.algHom_ext fun i => ?_
  fin_cases i <;> simp [toChartP, ofChartP]

/-- `ofChartP` is a right inverse of `toChartP`. -/
theorem toChartP_comp_ofChartP : (toChartP k).comp (ofChartP k) = AlgHom.id k _ := by
  refine MvPolynomial.algHom_ext fun ⟨j, hj⟩ => ?_
  fin_cases j
  · exact absurd rfl hj
  all_goals simp [toChartP, ofChartP]

/-- The coordinate change on `D₊(X₀)`, as an isomorphism. -/
def chartCoordEquivP : ModelRing k ≃ₐ[k] MvPolynomial {j : Fin (3 + 1) // j ≠ 0} k :=
  AlgEquiv.ofAlgHom (toChartP k) (ofChartP k) (toChartP_comp_ofChartP k)
    (ofChartP_comp_toChartP k)

/-- The inverse of the chart identification `k[Y_j : j ≠ i] ≅ k[X]_{(Xᵢ)}` is the retraction
`Xᵢ ↦ 1`. -/
theorem chartEquiv_symm_apply (i : Fin (3 + 1))
    (y : Away (Stacks.AlgebraicGeometry.ProjPolyChart.polyGrading k 3) (X i)) :
    (Stacks.AlgebraicGeometry.ProjPolyChart.chartEquiv k 3 i).symm y =
      Stacks.AlgebraicGeometry.ProjPolyChart.chartRetract k 3 i y := by
  conv_rhs => rw [← (Stacks.AlgebraicGeometry.ProjPolyChart.chartEquiv k 3 i).apply_symm_apply y]
  rw [Stacks.AlgebraicGeometry.ProjPolyChart.chartEquiv_apply, ← RingHom.comp_apply,
    Stacks.AlgebraicGeometry.ProjPolyChart.chartRetract_comp_chartHom, RingHom.id_apply]

/-- The chart ring identification on `D₊(X₀)`: `k[x, y, z] ≅ k[X]_{(X₀)}`, sending
`x, y, z` to `X₁/X₀ - (X₂/X₀)², X₃/X₀, X₂/X₀`. -/
def chartRingEquivP : ModelRing k ≃+* Away (homogeneousSubmodule (Fin 4) k) (X 0) :=
  (chartCoordEquivP k).toRingEquiv.trans
    (Stacks.AlgebraicGeometry.ProjPolyChart.chartEquiv k 3 0)

/-- On a fraction `a / X₀ ^ n` the inverse chart identification is `a(1, a, b, c)` read in the
model coordinates. -/
theorem chartRingEquivP_symm_mk (n : ℕ) (a : MvPolynomial (Fin 4) k)
    (ha : a ∈ (homogeneousSubmodule (Fin 4) k) (n • 1)) :
    (chartRingEquivP k).symm (Away.mk (homogeneousSubmodule (Fin 4) k) (X_mem_one k 0) n a ha) =
      ofChartP k (Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom k 3 0 a) := by
  change (chartCoordEquivP k).symm
    ((Stacks.AlgebraicGeometry.ProjPolyChart.chartEquiv k 3 0).symm _) = _
  rw [chartEquiv_symm_apply]
  exact congrArg (chartCoordEquivP k).symm
    (Stacks.AlgebraicGeometry.ProjPolyChart.chartRetract_mk k 3 0 n a ha)

/-- **The chart `D₊(X₀)` of `ℙ³_k` in the model coordinates**, an open immersion
`Spec k[x, y, z] ⟶ ℙ³_k`. -/
def chartP : Spec (CommRingCat.of (ModelRing k)) ⟶ projectiveThreeSpace k :=
  Spec.map (CommRingCat.ofHom (chartRingEquivP k).symm.toRingHom) ≫
    Proj.awayι (homogeneousSubmodule (Fin 4) k) (X 0) (X_mem_one k 0) one_pos

/-- `chartP` is an open immersion. -/
instance : IsOpenImmersion (chartP k) := by
  have : IsIso (CommRingCat.ofHom (chartRingEquivP k).symm.toRingHom) :=
    (chartRingEquivP k).symm.toCommRingCatIso.isIso_hom
  unfold chartP
  infer_instance

/-- The image of `chartP` is `D₊(X₀)`. -/
theorem opensRange_chartP :
    (chartP k).opensRange = Proj.basicOpen (homogeneousSubmodule (Fin 4) k) (X 0) := by
  have : IsIso (CommRingCat.ofHom (chartRingEquivP k).symm.toRingHom) :=
    (chartRingEquivP k).symm.toCommRingCatIso.isIso_hom
  unfold chartP
  rw [Scheme.Hom.opensRange_comp_of_isIso, Proj.opensRange_awayι]

/-- The pullback of a conic's ideal sheaf (generated by `v`) along a chart `e` of `D₊(X₀)` or
`D₊(X₁)` is the ideal sheaf of `(a, b)`, once `e⁻¹` sends the chart generators to `a, b`. -/
private theorem comap_chart_conic_eq_specIdeal_pair {i : Fin 4}
    (e : ModelRing k ≃+* Away (homogeneousSubmodule (Fin 4) k) (X i))
    (𝔞 : HomogeneousIdeal (homogeneousSubmodule (Fin 4) k)) (v : Fin 2 → MvPolynomial (Fin 4) k)
    (hv : ∀ j, v j ∈ homogeneousSubmodule (Fin 4) k (generatorDegrees j • 1))
    (h𝔞 : 𝔞.toIdeal = Ideal.span (Set.range v)) (a b : ModelRing k)
    (h : ∀ j, e.symm (Away.mk (homogeneousSubmodule (Fin 4) k) (X_mem_one k i)
      (generatorDegrees j) (v j) (hv j)) = ![a, b] j) :
    (homogeneousIdealSheaf (homogeneousSubmodule (Fin 4) k) 𝔞).comap
        (Spec.map (CommRingCat.ofHom e.symm.toRingHom) ≫
          Proj.awayι (homogeneousSubmodule (Fin 4) k) (X i) (X_mem_one k i) one_pos) =
      specIdeal (Ideal.span {a, b}) := by
  rw [comap_chart_homogeneousIdealSheaf _ 𝔞 (X_mem_one k i) one_pos v _ hv h𝔞,
    show (fun j => e.symm.toRingHom (Away.mk (homogeneousSubmodule (Fin 4) k) (X_mem_one k i)
      (generatorDegrees j) (v j) (hv j))) = ![a, b] from funext h, Matrix.range_cons,
    Matrix.range_cons, Matrix.range_empty, Set.union_empty, Set.singleton_union]

/-- **`C` on the chart `D₊(X₀)` is `I = (x, y)`.** -/
theorem comap_idealSheafC_chartP : (idealSheafC k).comap (chartP k) = modelIdealSheafI k := by
  unfold chartP
  rw [idealSheafC, comap_chart_conic_eq_specIdeal_pair k (chartRingEquivP k) _ (generatorsC k)
    (generatorsC_mem k) (conicIdealC_eq_span_range k) (X 0) (X 1) fun j => ?_]
  · rfl
  rw [chartRingEquivP_symm_mk]
  fin_cases j <;> simp [generatorsC, ofChartP,
    Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom]

/-- **`D` on the chart `D₊(X₀)` is `J = (x - y², z)`.** In the model coordinates `D` is
`(x + z² - y², z)`, which is `(x - y², z)`. -/
theorem comap_idealSheafD_chartP : (idealSheafD k).comap (chartP k) = modelIdealSheafJ k := by
  unfold chartP
  rw [idealSheafD, comap_chart_conic_eq_specIdeal_pair k (chartRingEquivP k) _ (generatorsD k)
    (generatorsD_mem k) (conicIdealD_eq_span_range k) (X 0 - X 1 ^ 2 + X 2 * X 2) (X 2) fun j => ?_]
  · rw [Ideal.span_pair_add_mul_right]; rfl
  rw [chartRingEquivP_symm_mk]
  fin_cases j <;> simp [generatorsD, ofChartP,
    Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom]
  ring

/-! #### The chart `D₊(X₁)` -/

/-- The affine coordinate `X_j / X₁` of the chart `D₊(X₁)`, as a variable of `k[Y_j : j ≠ 1]`. -/
abbrev yQ (j : Fin 4) (hj : j ≠ 1) : MvPolynomial {j : Fin (3 + 1) // j ≠ 1} k := X ⟨j, hj⟩

/-- The coordinate change `x ↦ a' - c'²`, `y ↦ b'`, `z ↦ c'` on `D₊(X₁)`
(`a', b', c' = X₀/X₁, X₂/X₁, X₃/X₁`). -/
def toChartQ : ModelRing k →ₐ[k] MvPolynomial {j : Fin (3 + 1) // j ≠ 1} k :=
  aeval ![yQ k 0 (by decide) - yQ k 3 (by decide) ^ 2, yQ k 2 (by decide), yQ k 3 (by decide)]

/-- Its inverse `a' ↦ x + z²`, `b' ↦ y`, `c' ↦ z`. -/
def ofChartQ : MvPolynomial {j : Fin (3 + 1) // j ≠ 1} k →ₐ[k] ModelRing k :=
  aeval fun j => ![X 0 + X 2 ^ 2, 0, X 1, X 2] j.1

/-- `ofChartQ` is a left inverse of `toChartQ`. -/
theorem ofChartQ_comp_toChartQ : (ofChartQ k).comp (toChartQ k) = AlgHom.id k _ := by
  refine MvPolynomial.algHom_ext fun i => ?_
  fin_cases i <;> simp [toChartQ, ofChartQ]

/-- `ofChartQ` is a right inverse of `toChartQ`. -/
theorem toChartQ_comp_ofChartQ : (toChartQ k).comp (ofChartQ k) = AlgHom.id k _ := by
  refine MvPolynomial.algHom_ext fun ⟨j, hj⟩ => ?_
  fin_cases j
  · simp [toChartQ, ofChartQ]
  · exact absurd rfl hj
  all_goals simp [toChartQ, ofChartQ]

/-- The coordinate change on `D₊(X₁)`, as an isomorphism. -/
def chartCoordEquivQ : ModelRing k ≃ₐ[k] MvPolynomial {j : Fin (3 + 1) // j ≠ 1} k :=
  AlgEquiv.ofAlgHom (toChartQ k) (ofChartQ k) (toChartQ_comp_ofChartQ k)
    (ofChartQ_comp_toChartQ k)

/-- The chart ring identification on `D₊(X₁)`: `k[x, y, z] ≅ k[X]_{(X₁)}`, sending
`x, y, z` to `X₀/X₁ - (X₃/X₁)², X₂/X₁, X₃/X₁`. -/
def chartRingEquivQ : ModelRing k ≃+* Away (homogeneousSubmodule (Fin 4) k) (X 1) :=
  (chartCoordEquivQ k).toRingEquiv.trans
    (Stacks.AlgebraicGeometry.ProjPolyChart.chartEquiv k 3 1)

/-- On a fraction `a / X₁ ^ n` the inverse chart identification is `a(a', 1, b', c')` read in
the model coordinates. -/
theorem chartRingEquivQ_symm_mk (n : ℕ) (a : MvPolynomial (Fin 4) k)
    (ha : a ∈ (homogeneousSubmodule (Fin 4) k) (n • 1)) :
    (chartRingEquivQ k).symm (Away.mk (homogeneousSubmodule (Fin 4) k) (X_mem_one k 1) n a ha) =
      ofChartQ k (Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom k 3 1 a) := by
  change (chartCoordEquivQ k).symm
    ((Stacks.AlgebraicGeometry.ProjPolyChart.chartEquiv k 3 1).symm _) = _
  rw [chartEquiv_symm_apply]
  exact congrArg (chartCoordEquivQ k).symm
    (Stacks.AlgebraicGeometry.ProjPolyChart.chartRetract_mk k 3 1 n a ha)

/-- **The chart `D₊(X₁)` of `ℙ³_k` in the model coordinates**, an open immersion
`Spec k[x, y, z] ⟶ ℙ³_k`. -/
def chartQ : Spec (CommRingCat.of (ModelRing k)) ⟶ projectiveThreeSpace k :=
  Spec.map (CommRingCat.ofHom (chartRingEquivQ k).symm.toRingHom) ≫
    Proj.awayι (homogeneousSubmodule (Fin 4) k) (X 1) (X_mem_one k 1) one_pos

/-- `chartQ` is an open immersion. -/
instance : IsOpenImmersion (chartQ k) := by
  have : IsIso (CommRingCat.ofHom (chartRingEquivQ k).symm.toRingHom) :=
    (chartRingEquivQ k).symm.toCommRingCatIso.isIso_hom
  unfold chartQ
  infer_instance

/-- The image of `chartQ` is `D₊(X₁)`. -/
theorem opensRange_chartQ :
    (chartQ k).opensRange = Proj.basicOpen (homogeneousSubmodule (Fin 4) k) (X 1) := by
  have : IsIso (CommRingCat.ofHom (chartRingEquivQ k).symm.toRingHom) :=
    (chartRingEquivQ k).symm.toCommRingCatIso.isIso_hom
  unfold chartQ
  rw [Scheme.Hom.opensRange_comp_of_isIso, Proj.opensRange_awayι]

/-- **`D` on the chart `D₊(X₁)` is `I = (x, y)`.** -/
theorem comap_idealSheafD_chartQ : (idealSheafD k).comap (chartQ k) = modelIdealSheafI k := by
  unfold chartQ
  rw [idealSheafD, comap_chart_conic_eq_specIdeal_pair k (chartRingEquivQ k) _ (generatorsD k)
    (generatorsD_mem k) (conicIdealD_eq_span_range k) (X 0) (X 1) fun j => ?_]
  · rfl
  rw [chartRingEquivQ_symm_mk]
  fin_cases j <;> simp [generatorsD, ofChartQ,
    Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom]

/-- **`C` on the chart `D₊(X₁)` is `J = (x - y², z)`.** In the model coordinates `C` is
`(x + z² - y², z)`, which is `(x - y², z)`. -/
theorem comap_idealSheafC_chartQ : (idealSheafC k).comap (chartQ k) = modelIdealSheafJ k := by
  unfold chartQ
  rw [idealSheafC, comap_chart_conic_eq_specIdeal_pair k (chartRingEquivQ k) _ (generatorsC k)
    (generatorsC_mem k) (conicIdealC_eq_span_range k) (X 0 - X 1 ^ 2 + X 2 * X 2) (X 2) fun j => ?_]
  · rw [Ideal.span_pair_add_mul_right]; rfl
  rw [chartRingEquivQ_symm_mk]
  fin_cases j <;> simp [generatorsC, ofChartQ,
    Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom]
  ring

/-! ### Points of the model and of the charts -/

/-- **The `k`-rational point `(c₀, c₁, c₂)` of `Spec k[x, y, z]`**: the kernel of evaluation at
`c`. -/
def modelPoint (c : Fin 3 → k) : Spec (CommRingCat.of (ModelRing k)) :=
  ⟨RingHom.ker (MvPolynomial.eval c), RingHom.ker_isPrime _⟩

/-- Membership in the rational point `c` is vanishing at `c`. -/
theorem mem_modelPoint_iff (c : Fin 3 → k) (a : ModelRing k) :
    a ∈ (modelPoint k c).asIdeal ↔ eval c a = 0 :=
  RingHom.mem_ker

/-- The origin `x = y = z = 0` of the model. -/
abbrev origin : Spec (CommRingCat.of (ModelRing k)) := modelPoint k 0

/-- The `k`-point `Spec k ⟶ Spec k[x, y, z]` at `c`. -/
def modelKPoint (c : Fin 3 → k) : Spec (CommRingCat.of k) ⟶ Spec (CommRingCat.of (ModelRing k)) :=
  Spec.map (CommRingCat.ofHom (MvPolynomial.eval c))

/-- The `k`-point at `c` hits the point `modelPoint k c`. -/
theorem modelKPoint_apply (c : Fin 3 → k) (t : Spec (CommRingCat.of k)) :
    modelKPoint k c t = modelPoint k c := by
  apply PrimeSpectrum.ext
  change Ideal.comap (MvPolynomial.eval c) t.asIdeal = RingHom.ker (MvPolynomial.eval c)
  have := t.isPrime
  rw [Ideal.eq_bot_of_prime t.asIdeal, RingHom.ker_eq_comap_bot]

/-- A point of `Spec k[x, y, z]` containing all `X i - c i` is the rational point `c`. -/
theorem eq_modelPoint_of (q : Spec (CommRingCat.of (ModelRing k))) (c : Fin 3 → k)
    (h : ∀ i, X i - C (c i) ∈ q.asIdeal) : q = modelPoint k c := by
  have hfac : (Ideal.Quotient.mk q.asIdeal) =
      (Ideal.Quotient.mk q.asIdeal).comp (C.comp (MvPolynomial.eval c)) := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun i => ?_)
    · simp
    · simpa [Ideal.Quotient.eq] using h i
  have hle : RingHom.ker (MvPolynomial.eval c) ≤ q.asIdeal := by
    intro a ha
    rw [← Ideal.Quotient.eq_zero_iff_mem, hfac, RingHom.comp_apply, RingHom.comp_apply,
      RingHom.mem_ker.mp ha, map_zero, map_zero]
  have hmax : (RingHom.ker (MvPolynomial.eval c)).IsMaximal :=
    RingHom.ker_isMaximal_of_surjective _ fun r => ⟨C r, eval_C r⟩
  exact PrimeSpectrum.ext (hmax.eq_of_le q.isPrime.ne_top hle).symm

/-- Distinct rational points of the model are distinct points. -/
theorem modelPoint_injective : Function.Injective (modelPoint k) := by
  intro c c' h
  funext i
  have hi : X i - C (c' i) ∈ (modelPoint k c').asIdeal := by
    rw [mem_modelPoint_iff]; simp
  rw [← h, mem_modelPoint_iff] at hi
  simpa [sub_eq_zero] using hi

/-- **Points of `D₊(X₀)` in `V₊(𝔞)`, in the model coordinates.** -/
theorem le_chartP_iff (𝔞 : HomogeneousIdeal (homogeneousSubmodule (Fin 4) k)) {ι : Type*}
    [Finite ι] (v : ι → MvPolynomial (Fin 4) k) (m : ι → ℕ)
    (hv : ∀ j, v j ∈ homogeneousSubmodule (Fin 4) k (m j • 1))
    (h𝔞 : 𝔞.toIdeal = Ideal.span (Set.range v)) (p : Spec (CommRingCat.of (ModelRing k))) :
    𝔞.toIdeal ≤ (chartP k p).asHomogeneousIdeal.toIdeal ↔
      ∀ j, ofChartP k (Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom k 3 0 (v j)) ∈
        p.asIdeal := by
  unfold chartP
  rw [le_asHomogeneousIdeal_chart_iff _ 𝔞 (X_mem_one k 0) one_pos v m hv h𝔞]
  simp only [RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, chartRingEquivP_symm_mk]

/-- **Points of `D₊(X₁)` in `V₊(𝔞)`, in the model coordinates.** -/
theorem le_chartQ_iff (𝔞 : HomogeneousIdeal (homogeneousSubmodule (Fin 4) k)) {ι : Type*}
    [Finite ι] (v : ι → MvPolynomial (Fin 4) k) (m : ι → ℕ)
    (hv : ∀ j, v j ∈ homogeneousSubmodule (Fin 4) k (m j • 1))
    (h𝔞 : 𝔞.toIdeal = Ideal.span (Set.range v)) (p : Spec (CommRingCat.of (ModelRing k))) :
    𝔞.toIdeal ≤ (chartQ k p).asHomogeneousIdeal.toIdeal ↔
      ∀ j, ofChartQ k (Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom k 3 1 (v j)) ∈
        p.asIdeal := by
  unfold chartQ
  rw [le_asHomogeneousIdeal_chart_iff _ 𝔞 (X_mem_one k 1) one_pos v m hv h𝔞]
  simp only [RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom, chartRingEquivQ_symm_mk]

/-- The ideal of a coordinate point is generated by the other coordinates, as a range. -/
theorem coordinateIdeal_eq_span_range (j : Fin 4) :
    coordinateIdeal k j = Ideal.span (Set.range fun i : {i : Fin 4 // i ≠ j} => X i.1) := by
  rw [coordinateIdeal, Set.image_eq_range]
  rfl

/-- **The chart `D₊(X₀)` sends the origin to `P = [1 : 0 : 0 : 0]`.** -/
theorem chartP_origin : chartP k (origin k) = pointP k := by
  refine (eq_coordinatePoint_iff k 0 _).mp ?_
  refine (le_chartP_iff k (coordinateHomogeneousIdeal k 0) (fun i : {i : Fin 4 // i ≠ 0} => X i.1)
    (fun _ => 1) (fun i => by simpa using X_mem_one k i.1)
    (coordinateIdeal_eq_span_range k 0) _).mpr ?_
  rintro ⟨j, hj⟩
  fin_cases j
  · exact absurd rfl hj
  all_goals (rw [origin, mem_modelPoint_iff]; simp [ofChartP,
      Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom])

/-- **The chart `D₊(X₁)` sends the origin to `Q = [0 : 1 : 0 : 0]`.** -/
theorem chartQ_origin : chartQ k (origin k) = pointQ k := by
  refine (eq_coordinatePoint_iff k 1 _).mp ?_
  refine (le_chartQ_iff k (coordinateHomogeneousIdeal k 1) (fun i : {i : Fin 4 // i ≠ 1} => X i.1)
    (fun _ => 1) (fun i => by simpa using X_mem_one k i.1)
    (coordinateIdeal_eq_span_range k 1) _).mpr ?_
  rintro ⟨j, hj⟩
  fin_cases j
  · (rw [origin, mem_modelPoint_iff]; simp [ofChartQ,
      Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom])
  · exact absurd rfl hj
  all_goals (rw [origin, mem_modelPoint_iff]; simp [ofChartQ,
      Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom])

/-- `D₊(X₀)` misses `Q`. -/
theorem pointQ_not_mem_basicOpen_X_zero :
    pointQ k ∉ Proj.basicOpen (homogeneousSubmodule (Fin 4) k) (X 0) := by
  rw [Proj.mem_basicOpen, not_not]
  exact Ideal.subset_span ⟨0, by decide, rfl⟩

/-- `D₊(X₁)` misses `P`. -/
theorem pointP_not_mem_basicOpen_X_one :
    pointP k ∉ Proj.basicOpen (homogeneousSubmodule (Fin 4) k) (X 1) := by
  rw [Proj.mem_basicOpen, not_not]
  exact Ideal.subset_span ⟨1, by decide, rfl⟩

/-- The chart `chartP` lands in `D₊(X₀)`. -/
theorem chartP_mem_basicOpen (p : Spec (CommRingCat.of (ModelRing k))) :
    chartP k p ∈ Proj.basicOpen (homogeneousSubmodule (Fin 4) k) (X 0) := by
  rw [← opensRange_chartP]
  exact ⟨p, rfl⟩

/-- The chart `chartQ` lands in `D₊(X₁)`. -/
theorem chartQ_mem_basicOpen (p : Spec (CommRingCat.of (ModelRing k))) :
    chartQ k p ∈ Proj.basicOpen (homogeneousSubmodule (Fin 4) k) (X 1) := by
  rw [← opensRange_chartQ]
  exact ⟨p, rfl⟩

/-- **The chart `D₊(X₀)` lies in `Y - {Q}`.** -/
theorem range_chartP_subset_opensAwayQ :
    Set.range (chartP k) ⊆ (opensAwayQ k : Set (projectiveThreeSpace k)) := by
  rintro _ ⟨p, rfl⟩ h
  exact pointQ_not_mem_basicOpen_X_zero k (Set.mem_singleton_iff.mp h ▸ chartP_mem_basicOpen k p)

/-- **The chart `D₊(X₁)` lies in `Y - {P}`.** -/
theorem range_chartQ_subset_opensAwayP :
    Set.range (chartQ k) ⊆ (opensAwayP k : Set (projectiveThreeSpace k)) := by
  rintro _ ⟨p, rfl⟩ h
  exact pointP_not_mem_basicOpen_X_one k (Set.mem_singleton_iff.mp h ▸ chartQ_mem_basicOpen k p)

/-! ### The charts into `Y - {Q}` and `Y - {P}` -/

/-- The chart `D₊(X₀)` as an open immersion into `Y - {Q}`. -/
def chartPAwayQ : Spec (CommRingCat.of (ModelRing k)) ⟶ (opensAwayQ k).toScheme :=
  IsOpenImmersion.lift (opensAwayQ k).ι (chartP k)
    (by rw [Scheme.Opens.range_ι]; exact range_chartP_subset_opensAwayQ k)

/-- `chartPAwayQ` followed by the inclusion of `Y - {Q}` is the chart `chartP`. -/
@[reassoc (attr := simp)]
theorem chartPAwayQ_ι : chartPAwayQ k ≫ (opensAwayQ k).ι = chartP k :=
  IsOpenImmersion.lift_fac _ _ _

/-- `chartPAwayQ` is an open immersion. -/
instance : IsOpenImmersion (chartPAwayQ k) := by
  have : IsOpenImmersion (chartPAwayQ k ≫ (opensAwayQ k).ι) := by
    rw [chartPAwayQ_ι]; infer_instance
  exact IsOpenImmersion.of_comp _ (opensAwayQ k).ι

/-- The chart `D₊(X₁)` as an open immersion into `Y - {P}`. -/
def chartQAwayP : Spec (CommRingCat.of (ModelRing k)) ⟶ (opensAwayP k).toScheme :=
  IsOpenImmersion.lift (opensAwayP k).ι (chartQ k)
    (by rw [Scheme.Opens.range_ι]; exact range_chartQ_subset_opensAwayP k)

/-- `chartQAwayP` followed by the inclusion of `Y - {P}` is the chart `chartQ`. -/
@[reassoc (attr := simp)]
theorem chartQAwayP_ι : chartQAwayP k ≫ (opensAwayP k).ι = chartQ k :=
  IsOpenImmersion.lift_fac _ _ _

/-- `chartQAwayP` is an open immersion. -/
instance : IsOpenImmersion (chartQAwayP k) := by
  have : IsOpenImmersion (chartQAwayP k ≫ (opensAwayP k).ι) := by
    rw [chartQAwayP_ι]; infer_instance
  exact IsOpenImmersion.of_comp _ (opensAwayP k).ι

/-- `C|_{Y - Q}` on the chart `D₊(X₀)` is `I`. -/
theorem comap_comap_idealSheafC_chartPAwayQ :
    ((idealSheafC k).comap (opensAwayQ k).ι).comap (chartPAwayQ k) = modelIdealSheafI k := by
  rw [← Scheme.IdealSheafData.comap_comp, chartPAwayQ_ι, comap_idealSheafC_chartP]

/-- `D|_{Y - Q}` on the chart `D₊(X₀)` is `J`. -/
theorem comap_comap_idealSheafD_chartPAwayQ :
    ((idealSheafD k).comap (opensAwayQ k).ι).comap (chartPAwayQ k) = modelIdealSheafJ k := by
  rw [← Scheme.IdealSheafData.comap_comp, chartPAwayQ_ι, comap_idealSheafD_chartP]

/-- `D|_{Y - P}` on the chart `D₊(X₁)` is `I`. -/
theorem comap_comap_idealSheafD_chartQAwayP :
    ((idealSheafD k).comap (opensAwayP k).ι).comap (chartQAwayP k) = modelIdealSheafI k := by
  rw [← Scheme.IdealSheafData.comap_comp, chartQAwayP_ι, comap_idealSheafD_chartQ]

/-- `C|_{Y - P}` on the chart `D₊(X₁)` is `J`. -/
theorem comap_comap_idealSheafC_chartQAwayP :
    ((idealSheafC k).comap (opensAwayP k).ι).comap (chartQAwayP k) = modelIdealSheafJ k := by
  rw [← Scheme.IdealSheafData.comap_comp, chartQAwayP_ι, comap_idealSheafC_chartQ]

/-! ### Each conic minus one special point lies in one chart -/

/-- In a prime ideal, `ab - w² ∈ 𝔭` with `a ∈ 𝔭` or `b ∈ 𝔭` forces `w ∈ 𝔭`. -/
theorem mem_of_mul_sub_sq_mem {R : Type*} [CommRing R] {𝔭 : Ideal R} [𝔭.IsPrime] {a b w : R}
    (h : a * b - w ^ 2 ∈ 𝔭) (hab : a ∈ 𝔭 ∨ b ∈ 𝔭) : w ∈ 𝔭 := by
  have hmul : a * b ∈ 𝔭 := hab.elim (fun ha => 𝔭.mul_mem_right b ha) (fun hb => 𝔭.mul_mem_left a hb)
  refine Ideal.IsPrime.mem_of_pow_mem ‹_› 2 ?_
  simpa using 𝔭.sub_mem hmul h

/-- A point of `ℙ³` whose prime contains `X₀, X₂, X₃` is `Q`. -/
theorem eq_pointQ_of_mem (x : projectiveThreeSpace k)
    (h0 : X 0 ∈ x.asHomogeneousIdeal.toIdeal) (h2 : X 2 ∈ x.asHomogeneousIdeal.toIdeal)
    (h3 : X 3 ∈ x.asHomogeneousIdeal.toIdeal) : x = pointQ k := by
  refine (eq_coordinatePoint_iff k 1 x).mp ?_
  rw [coordinateIdeal, Ideal.span_le]
  rintro _ ⟨i, hi, rfl⟩
  fin_cases i
  exacts [h0, absurd rfl hi, h2, h3]

/-- A point of `ℙ³` whose prime contains `X₁, X₂, X₃` is `P`. -/
theorem eq_pointP_of_mem (x : projectiveThreeSpace k)
    (h1 : X 1 ∈ x.asHomogeneousIdeal.toIdeal) (h2 : X 2 ∈ x.asHomogeneousIdeal.toIdeal)
    (h3 : X 3 ∈ x.asHomogeneousIdeal.toIdeal) : x = pointP k := by
  refine (eq_coordinatePoint_iff k 0 x).mp ?_
  rw [coordinateIdeal, Ideal.span_le]
  rintro _ ⟨i, hi, rfl⟩
  fin_cases i
  exacts [absurd rfl hi, h1, h2, h3]

/-- The points of `C`: `X₀X₁ - X₂²` and `X₃` vanish. -/
theorem mem_supportSet_idealSheafC_iff (x : projectiveThreeSpace k) :
    x ∈ (idealSheafC k).supportSet ↔
      X 0 * X 1 - X 2 ^ 2 ∈ x.asHomogeneousIdeal.toIdeal ∧ X 3 ∈ x.asHomogeneousIdeal.toIdeal := by
  rw [idealSheafC, mem_supportSet_homogeneousIdealSheaf_iff]
  change conicIdealC k ≤ _ ↔ _
  rw [conicIdealC_eq_span_range, Ideal.span_le, Set.range_subset_iff, Fin.forall_fin_two]
  rfl

/-- The points of `D`: `X₀X₁ - X₃²` and `X₂` vanish. -/
theorem mem_supportSet_idealSheafD_iff (x : projectiveThreeSpace k) :
    x ∈ (idealSheafD k).supportSet ↔
      X 0 * X 1 - X 3 ^ 2 ∈ x.asHomogeneousIdeal.toIdeal ∧ X 2 ∈ x.asHomogeneousIdeal.toIdeal := by
  rw [idealSheafD, mem_supportSet_homogeneousIdealSheaf_iff]
  change conicIdealD k ≤ _ ↔ _
  rw [conicIdealD_eq_span_range, Ideal.span_le, Set.range_subset_iff, Fin.forall_fin_two]
  rfl

/-- If `z ∉ U` and every point of `S` other than `z` lies in `U`, then `U ∩ S = S \ {z}`. -/
private theorem inter_eq_sdiff_singleton {α : Type*} {U S : Set α} {z : α} (hz : z ∉ U)
    (h : ∀ x ∈ S, x ≠ z → x ∈ U) : U ∩ S = S \ {z} := by
  ext x
  exact ⟨fun ⟨hU, hS⟩ => ⟨hS, fun e => hz (e ▸ hU)⟩, fun ⟨hS, hx⟩ => ⟨h x hS hx, hS⟩⟩

/-- **`D₊(X₀) ∩ C = C - {Q}`.** -/
theorem basicOpen_X_zero_inter_supportSet_idealSheafC :
    (Proj.basicOpen (homogeneousSubmodule (Fin 4) k) (X 0) : Set (projectiveThreeSpace k)) ∩
      (idealSheafC k).supportSet = (idealSheafC k).supportSet \ {pointQ k} :=
  inter_eq_sdiff_singleton (pointQ_not_mem_basicOpen_X_zero k) fun x hS hne => by
    rw [SetLike.mem_coe, Proj.mem_basicOpen]
    intro hx
    obtain ⟨hA, hB⟩ := (mem_supportSet_idealSheafC_iff k x).mp hS
    have := x.isPrime
    exact hne (eq_pointQ_of_mem k x hx (mem_of_mul_sub_sq_mem hA (Or.inl hx)) hB)

/-- **`D₊(X₀) ∩ D = D - {Q}`.** -/
theorem basicOpen_X_zero_inter_supportSet_idealSheafD :
    (Proj.basicOpen (homogeneousSubmodule (Fin 4) k) (X 0) : Set (projectiveThreeSpace k)) ∩
      (idealSheafD k).supportSet = (idealSheafD k).supportSet \ {pointQ k} :=
  inter_eq_sdiff_singleton (pointQ_not_mem_basicOpen_X_zero k) fun x hS hne => by
    rw [SetLike.mem_coe, Proj.mem_basicOpen]
    intro hx
    obtain ⟨hA, hB⟩ := (mem_supportSet_idealSheafD_iff k x).mp hS
    have := x.isPrime
    exact hne (eq_pointQ_of_mem k x hx hB (mem_of_mul_sub_sq_mem hA (Or.inl hx)))

/-- **`D₊(X₁) ∩ C = C - {P}`.** -/
theorem basicOpen_X_one_inter_supportSet_idealSheafC :
    (Proj.basicOpen (homogeneousSubmodule (Fin 4) k) (X 1) : Set (projectiveThreeSpace k)) ∩
      (idealSheafC k).supportSet = (idealSheafC k).supportSet \ {pointP k} :=
  inter_eq_sdiff_singleton (pointP_not_mem_basicOpen_X_one k) fun x hS hne => by
    rw [SetLike.mem_coe, Proj.mem_basicOpen]
    intro hx
    obtain ⟨hA, hB⟩ := (mem_supportSet_idealSheafC_iff k x).mp hS
    have := x.isPrime
    exact hne (eq_pointP_of_mem k x hx (mem_of_mul_sub_sq_mem hA (Or.inr hx)) hB)

/-- **`D₊(X₁) ∩ D = D - {P}`.** -/
theorem basicOpen_X_one_inter_supportSet_idealSheafD :
    (Proj.basicOpen (homogeneousSubmodule (Fin 4) k) (X 1) : Set (projectiveThreeSpace k)) ∩
      (idealSheafD k).supportSet = (idealSheafD k).supportSet \ {pointP k} :=
  inter_eq_sdiff_singleton (pointP_not_mem_basicOpen_X_one k) fun x hS hne => by
    rw [SetLike.mem_coe, Proj.mem_basicOpen]
    intro hx
    obtain ⟨hA, hB⟩ := (mem_supportSet_idealSheafD_iff k x).mp hS
    have := x.isPrime
    exact hne (eq_pointP_of_mem k x hx hB (mem_of_mul_sub_sq_mem hA (Or.inr hx)))

/-! ### The points `c₀ = [1 : 1 : 1 : 0] ∈ C` and `d₀ = [1 : 1 : 0 : 1] ∈ D` -/

/-- Linear equations of `c₀ = [1 : 1 : 1 : 0]`: `X₀ - X₁`, `X₀ - X₂`, `X₃`. -/
def generatorsC₀ : Fin 3 → MvPolynomial (Fin 4) k := ![X 0 - X 1, X 0 - X 2, X 3]

/-- Linear equations of `d₀ = [1 : 1 : 0 : 1]`: `X₀ - X₁`, `X₂`, `X₀ - X₃`. -/
def generatorsD₀ : Fin 3 → MvPolynomial (Fin 4) k := ![X 0 - X 1, X 2, X 0 - X 3]

/-- The equations of `c₀` are linear forms. -/
theorem generatorsC₀_mem (j : Fin 3) :
    generatorsC₀ k j ∈ homogeneousSubmodule (Fin 4) k (1 • 1) := by
  rw [smul_eq_mul, mul_one, mem_homogeneousSubmodule]
  fin_cases j
  exacts [(isHomogeneous_X k 0).sub (isHomogeneous_X k 1),
    (isHomogeneous_X k 0).sub (isHomogeneous_X k 2), isHomogeneous_X k 3]

/-- The equations of `d₀` are linear forms. -/
theorem generatorsD₀_mem (j : Fin 3) :
    generatorsD₀ k j ∈ homogeneousSubmodule (Fin 4) k (1 • 1) := by
  rw [smul_eq_mul, mul_one, mem_homogeneousSubmodule]
  fin_cases j
  exacts [(isHomogeneous_X k 0).sub (isHomogeneous_X k 1), isHomogeneous_X k 2,
    (isHomogeneous_X k 0).sub (isHomogeneous_X k 3)]

/-- The homogeneous ideal of `c₀`. -/
def homogeneousIdealC₀ : HomogeneousIdeal (homogeneousSubmodule (Fin 4) k) :=
  ⟨Ideal.span (Set.range (generatorsC₀ k)), Ideal.homogeneous_span _ _ (by
    rintro _ ⟨j, rfl⟩
    exact ⟨_, generatorsC₀_mem k j⟩)⟩

/-- The homogeneous ideal of `d₀`. -/
def homogeneousIdealD₀ : HomogeneousIdeal (homogeneousSubmodule (Fin 4) k) :=
  ⟨Ideal.span (Set.range (generatorsD₀ k)), Ideal.homogeneous_span _ _ (by
    rintro _ ⟨j, rfl⟩
    exact ⟨_, generatorsD₀_mem k j⟩)⟩

/-- **The point `c₀ = [1 : 1 : 1 : 0]` of `C`**, the model point `(0, 0, 1)` of the chart
`D₊(X₀)`. -/
def pointC₀ : projectiveThreeSpace k := chartP k (modelPoint k ![0, 0, 1])

/-- **The point `d₀ = [1 : 1 : 0 : 1]` of `D`**, the model point `(1, 1, 0)` of the chart
`D₊(X₀)`. -/
def pointD₀ : projectiveThreeSpace k := chartP k (modelPoint k ![1, 1, 0])

/-- **`c₀` is the point `[1 : 1 : 1 : 0]`**: the only point whose prime contains
`X₀ - X₁, X₀ - X₂, X₃`. -/
theorem span_le_iff_eq_pointC₀ (y : projectiveThreeSpace k) :
    Ideal.span (Set.range (generatorsC₀ k)) ≤ y.asHomogeneousIdeal.toIdeal ↔ y = pointC₀ k := by
  have key := le_chartP_iff k (homogeneousIdealC₀ k) (generatorsC₀ k) (fun _ => 1)
    (generatorsC₀_mem k) rfl
  have e0 : ofChartP k (Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom k 3 0
      (generatorsC₀ k 0)) = 1 - (X 0 + X 2 ^ 2) := by
    simp [generatorsC₀, ofChartP, Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom]
  have e1 : ofChartP k (Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom k 3 0
      (generatorsC₀ k 1)) = 1 - X 2 := by
    simp [generatorsC₀, ofChartP, Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom]
  have e2 : ofChartP k (Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom k 3 0
      (generatorsC₀ k 2)) = X 1 := by
    simp [generatorsC₀, ofChartP, Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom]
  constructor
  · intro h
    have hg : ∀ j, generatorsC₀ k j ∈ y.asHomogeneousIdeal.toIdeal :=
      fun j => h (Ideal.subset_span ⟨j, rfl⟩)
    have hy : y ∈ Proj.basicOpen (homogeneousSubmodule (Fin 4) k) (X 0) := by
      rw [Proj.mem_basicOpen]
      intro h0
      obtain ⟨i, hi⟩ := Stacks.ProjectiveSpace.exists_mem_basicOpen_X y
      rw [Proj.mem_basicOpen] at hi
      apply hi
      fin_cases i
      · exact h0
      · simpa [generatorsC₀] using Ideal.sub_mem _ h0 (hg 0)
      · simpa [generatorsC₀] using Ideal.sub_mem _ h0 (hg 1)
      · exact hg 2
    rw [← opensRange_chartP] at hy
    obtain ⟨p, rfl⟩ := hy
    have hp := (key p).mp h
    have h0 := hp 0
    have h1 := hp 1
    have h2 := hp 2
    rw [e0] at h0
    rw [e1] at h1
    rw [e2] at h2
    rw [pointC₀]
    congr 1
    refine eq_modelPoint_of k p _ fun i => ?_
    match i with
    | 0 =>
      have e : (X 0 - C (![0, 0, 1] 0) : ModelRing k) =
          (1 + X 2) * (1 - X 2) - (1 - (X 0 + X 2 ^ 2)) := by simp; ring
      rw [e]
      exact sub_mem (Ideal.mul_mem_left _ _ h1) h0
    | 1 =>
      have e : (X 1 - C (![0, 0, 1] 1) : ModelRing k) = X 1 := by simp
      rw [e]
      exact h2
    | 2 =>
      have e : (X 2 - C (![0, 0, 1] 2) : ModelRing k) = -(1 - X 2) := by simp
      rw [e]
      exact neg_mem h1
  · rintro rfl
    refine (key _).mpr fun j => ?_
    match j with
    | 0 => rw [e0, mem_modelPoint_iff]; simp
    | 1 => rw [e1, mem_modelPoint_iff]; simp
    | 2 => rw [e2, mem_modelPoint_iff]; simp

/-- **`d₀` is the point `[1 : 1 : 0 : 1]`**: the only point whose prime contains
`X₀ - X₁, X₂, X₀ - X₃`. -/
theorem span_le_iff_eq_pointD₀ (y : projectiveThreeSpace k) :
    Ideal.span (Set.range (generatorsD₀ k)) ≤ y.asHomogeneousIdeal.toIdeal ↔ y = pointD₀ k := by
  have key := le_chartP_iff k (homogeneousIdealD₀ k) (generatorsD₀ k) (fun _ => 1)
    (generatorsD₀_mem k) rfl
  have e0 : ofChartP k (Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom k 3 0
      (generatorsD₀ k 0)) = 1 - (X 0 + X 2 ^ 2) := by
    simp [generatorsD₀, ofChartP, Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom]
  have e1 : ofChartP k (Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom k 3 0
      (generatorsD₀ k 1)) = X 2 := by
    simp [generatorsD₀, ofChartP, Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom]
  have e2 : ofChartP k (Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom k 3 0
      (generatorsD₀ k 2)) = 1 - X 1 := by
    simp [generatorsD₀, ofChartP, Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom]
  constructor
  · intro h
    have hg : ∀ j, generatorsD₀ k j ∈ y.asHomogeneousIdeal.toIdeal :=
      fun j => h (Ideal.subset_span ⟨j, rfl⟩)
    have hy : y ∈ Proj.basicOpen (homogeneousSubmodule (Fin 4) k) (X 0) := by
      rw [Proj.mem_basicOpen]
      intro h0
      obtain ⟨i, hi⟩ := Stacks.ProjectiveSpace.exists_mem_basicOpen_X y
      rw [Proj.mem_basicOpen] at hi
      apply hi
      fin_cases i
      · exact h0
      · simpa [generatorsD₀] using Ideal.sub_mem _ h0 (hg 0)
      · exact hg 1
      · simpa [generatorsD₀] using Ideal.sub_mem _ h0 (hg 2)
    rw [← opensRange_chartP] at hy
    obtain ⟨p, rfl⟩ := hy
    have hp := (key p).mp h
    have h0 := hp 0
    have h1 := hp 1
    have h2 := hp 2
    rw [e0] at h0
    rw [e1] at h1
    rw [e2] at h2
    rw [pointD₀]
    congr 1
    refine eq_modelPoint_of k p _ fun i => ?_
    match i with
    | 0 =>
      have e : (X 0 - C (![1, 1, 0] 0) : ModelRing k) =
          -((1 - (X 0 + X 2 ^ 2)) + X 2 * X 2) := by simp; ring
      rw [e]
      exact neg_mem (add_mem h0 (Ideal.mul_mem_left _ _ h1))
    | 1 =>
      have e : (X 1 - C (![1, 1, 0] 1) : ModelRing k) = -(1 - X 1) := by simp
      rw [e]
      exact neg_mem h2
    | 2 =>
      have e : (X 2 - C (![1, 1, 0] 2) : ModelRing k) = X 2 := by simp
      rw [e]
      exact h1
  · rintro rfl
    refine (key _).mpr fun j => ?_
    match j with
    | 0 => rw [e0, mem_modelPoint_iff]; simp
    | 1 => rw [e1, mem_modelPoint_iff]; simp
    | 2 => rw [e2, mem_modelPoint_iff]; simp

/-- **`c₀` in the chart `D₊(X₁)`** is the model point `(1, 1, 0)`. -/
theorem chartQ_modelPoint_eq_pointC₀ : chartQ k (modelPoint k ![1, 1, 0]) = pointC₀ k := by
  refine (span_le_iff_eq_pointC₀ k _).mp ((le_chartQ_iff k (homogeneousIdealC₀ k)
    (generatorsC₀ k) (fun _ => 1) (generatorsC₀_mem k) rfl _).mpr fun j => ?_)
  rw [mem_modelPoint_iff]
  fin_cases j <;>
    simp [generatorsC₀, ofChartQ, Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom]

/-- **`d₀` in the chart `D₊(X₁)`** is the model point `(0, 0, 1)`. -/
theorem chartQ_modelPoint_eq_pointD₀ : chartQ k (modelPoint k ![0, 0, 1]) = pointD₀ k := by
  refine (span_le_iff_eq_pointD₀ k _).mp ((le_chartQ_iff k (homogeneousIdealD₀ k)
    (generatorsD₀ k) (fun _ => 1) (generatorsD₀_mem k) rfl _).mpr fun j => ?_)
  rw [mem_modelPoint_iff]
  fin_cases j <;>
    simp [generatorsD₀, ofChartQ, Stacks.AlgebraicGeometry.ProjPolyChart.setOneHom]

/-- `c₀ ∈ C`. -/
theorem pointC₀_mem_supportSet_idealSheafC : pointC₀ k ∈ (idealSheafC k).supportSet := by
  rw [pointC₀, ← mem_supportSet_comap_iff, comap_idealSheafC_chartP,
    mem_supportSet_specIdeal_iff, modelIdealI, Ideal.span_le]
  rintro _ (rfl | rfl) <;> rw [SetLike.mem_coe, mem_modelPoint_iff] <;> simp

/-- `d₀ ∈ D`. -/
theorem pointD₀_mem_supportSet_idealSheafD : pointD₀ k ∈ (idealSheafD k).supportSet := by
  rw [pointD₀, ← mem_supportSet_comap_iff, comap_idealSheafD_chartP,
    mem_supportSet_specIdeal_iff, modelIdealJ, Ideal.span_le]
  rintro _ (rfl | rfl) <;> rw [SetLike.mem_coe, mem_modelPoint_iff] <;> simp

/-- `c₀ ≠ P`. -/
theorem pointC₀_ne_pointP : pointC₀ k ≠ pointP k := by
  intro h
  rw [pointC₀, ← chartP_origin] at h
  have := modelPoint_injective k ((chartP k).isOpenEmbedding.injective h)
  simpa using congrFun this 2

/-- `c₀ ≠ Q`. -/
theorem pointC₀_ne_pointQ : pointC₀ k ≠ pointQ k := fun h =>
  pointQ_not_mem_basicOpen_X_zero k (h ▸ chartP_mem_basicOpen k _)

/-- `d₀ ≠ P`. -/
theorem pointD₀_ne_pointP : pointD₀ k ≠ pointP k := by
  intro h
  rw [pointD₀, ← chartP_origin] at h
  have := modelPoint_injective k ((chartP k).isOpenEmbedding.injective h)
  simpa using congrFun this 0

/-- `d₀ ≠ Q`. -/
theorem pointD₀_ne_pointQ : pointD₀ k ≠ pointQ k := fun h =>
  pointQ_not_mem_basicOpen_X_zero k (h ▸ chartP_mem_basicOpen k _)

