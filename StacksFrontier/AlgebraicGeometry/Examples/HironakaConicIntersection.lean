module

public import Mathlib.Algebra.MvPolynomial.Division
public import Mathlib.Algebra.MvPolynomial.Eval
public import Mathlib.RingTheory.Ideal.Maps
public import Mathlib.RingTheory.Ideal.Operations
public import StacksFrontier.RingTheory.MvPolynomial.KillSet

/-!
# The two conics of Hironaka's example, and their intersection

Hironaka's Example B.3.4.1 — the proper, Zariski-locally projective, non-projective morphism of
smooth complex `3`-folds that refutes the Zariski-locality of projectivity, see
`StacksFrontier/AlgebraicGeometry/Examples/ProjectivityNotLocalOnBase.lean` — begins from two smooth
conics in `ℙ³` whose scheme-theoretic intersection is reduced and consists of two points. The
source's conics are

`C = {xy = z², w = 0}` and `D = {xy = w², z = 0}`,

meeting in `P = [1 : 0 : 0 : 0]` and `Q = [0 : 1 : 0 : 0]`.

This file proves that first step, at the level of the homogeneous ideals in
`k[x, y, z, w] = MvPolynomial (Fin 4) k`, the variables `x, y, z, w` being `X 0, X 1, X 2, X 3`.
The scheme-theoretic intersection of two closed subschemes is cut out by the *sum* of their
homogeneous ideals, and a closed subscheme is reduced exactly when its homogeneous ideal is
radical, so the content is:

* `Stacks.Examples.HironakaConicIntersection.conicIdealC_sup_conicIdealD_eq_inf` — the sum of the
  two conic ideals is the intersection of the ideal of `P` with the ideal of `Q`. This is
  "`C ∩ D` consists of the two points `P` and `Q`".
* `Stacks.Examples.HironakaConicIntersection.isRadical_conicIdealC_sup_conicIdealD` — that sum is
  a radical ideal. This is "the closed subscheme `C ∩ D` is reduced".

Both hold over any commutative domain of coefficients, so in particular over `ℂ`.

## The method

Everything rests on one tool, `Stacks.Examples.HironakaConicIntersection.killVars`: the retraction
of `k[x_i]` sending the variables in a finite set to zero and fixing the rest. Two facts about it
carry the file.

* `Stacks.Examples.HironakaConicIntersection.sub_killVars_mem_span`: a polynomial differs from its
  image by an element of the ideal generated by the killed variables. This is an induction over
  monomials.
* `Stacks.Examples.HironakaConicIntersection.ker_killVars`: consequently the kernel *is* that
  ideal, so by `RingHom.ker_isPrime` the ideal generated by any finite set of variables is prime.
  That is `Stacks.Examples.HironakaConicIntersection.isPrime_span_image_X`, and it gives
  primality of the ideals of `P` and of `Q` — the two points being reduced — which is in turn
  what makes their intersection radical.

The hard half of the intersection computation — that a polynomial vanishing at both points lies
in `(xy, z, w)` — is the same retraction applied to `{z, w}`: it makes the image of the polynomial
divisible by `x` and by `y`, and `x` and `y` are primes of `k[x, y, z, w]` neither of which
divides the other, so their product divides the image.

## What this is not

This is the *first* step of Hironaka's construction and no more. The construction still needs, and
this repository does not have: the two conics as closed subschemes of `ℙ³_ℂ` rather than as
homogeneous ideals, their smoothness, the two blow-up towers, the canonical isomorphism over
`Y - P - Q` that permits glueing, and the `1`-cycle argument showing that the glued threefold is
not projective. That list, and what each missing step needs, is in
`StacksFrontier/AlgebraicGeometry/Examples/ProjectivityNotLocalOnBase.lean`.

## References

* [Stacks Project, Tag 08J1](https://stacks.math.columbia.edu/tag/08J1)
* [H, Example B.3.4.1]
-/

@[expose] public noncomputable section

open MvPolynomial

universe u

namespace Stacks.Examples.HironakaConicIntersection

/-! ### Killing a finite set of variables -/

variable {σ : Type*} [DecidableEq σ] (k : Type u) [CommRing k]

/-- The retraction of `k[x_i]` that sends the variables indexed by `s` to zero and fixes the
others. -/
def killVars (s : Finset σ) : MvPolynomial σ k →ₐ[k] MvPolynomial σ k :=
  aeval fun i ↦ if i ∈ s then 0 else X i

@[simp]
theorem killVars_X (s : Finset σ) (i : σ) :
    killVars k s (X i) = if i ∈ s then 0 else X i := by
  simp [killVars]

@[simp]
theorem killVars_C (s : Finset σ) (a : k) : killVars k s (C a) = C a := by
  simp [killVars]

/-- `killVars` is `MvPolynomial.killSet` at the underlying set of the finite set. -/
theorem killVars_eq_killSet (s : Finset σ) : killVars k s = killSet k (s : Set σ) :=
  algHom_ext fun i => by
    by_cases hi : i ∈ s
    · rw [killVars_X, if_pos hi, killSet_X_of_mem (Finset.mem_coe.mpr hi)]
    · rw [killVars_X, if_neg hi, killSet_X_of_notMem (by simpa using hi)]

/-- **A polynomial differs from its image under `killVars` by an element of the ideal generated by
the killed variables.** This is `MvPolynomial.sub_killSet_mem_span`. -/
theorem sub_killVars_mem_span (s : Finset σ) (g : MvPolynomial σ k) :
    g - killVars k s g ∈ Ideal.span (X '' (s : Set σ) : Set (MvPolynomial σ k)) := by
  rw [killVars_eq_killSet]
  exact sub_killSet_mem_span _ g

/-- **The kernel of `killVars` is the ideal generated by the killed variables.** This is
`MvPolynomial.ker_killSet`. -/
theorem ker_killVars (s : Finset σ) :
    RingHom.ker (killVars k s) = Ideal.span (X '' (s : Set σ) : Set (MvPolynomial σ k)) := by
  rw [killVars_eq_killSet]
  exact ker_killSet _

omit [DecidableEq σ] in
/-- **The ideal generated by a finite set of variables is prime**, the coefficients being a
domain. This is `MvPolynomial.isPrime_span_X_image`. -/
theorem isPrime_span_image_X [IsDomain k] (s : Finset σ) :
    (Ideal.span (X '' (s : Set σ) : Set (MvPolynomial σ k))).IsPrime :=
  isPrime_span_X_image _

/-! ### The two conics and the two points

The homogeneous coordinates `x, y, z, w` of `ℙ³` are `X 0, X 1, X 2, X 3`. -/

variable (k : Type u) [CommRing k]

/-- **The homogeneous ideal of the conic `C = {xy = z², w = 0} ⊂ ℙ³`.** -/
def conicIdealC : Ideal (MvPolynomial (Fin 4) k) :=
  Ideal.span {X 0 * X 1 - X 2 ^ 2, X 3}

/-- **The homogeneous ideal of the conic `D = {xy = w², z = 0} ⊂ ℙ³`.** -/
def conicIdealD : Ideal (MvPolynomial (Fin 4) k) :=
  Ideal.span {X 0 * X 1 - X 3 ^ 2, X 2}

/-- **The homogeneous ideal of the point `P = [1 : 0 : 0 : 0]`**, generated by the three
coordinates vanishing there. -/
def pointIdealP : Ideal (MvPolynomial (Fin 4) k) := Ideal.span {X 1, X 2, X 3}

/-- **The homogeneous ideal of the point `Q = [0 : 1 : 0 : 0]`**, generated by the three
coordinates vanishing there. -/
def pointIdealQ : Ideal (MvPolynomial (Fin 4) k) := Ideal.span {X 0, X 2, X 3}

/-- **The ideal `(xy, z, w)`**, identified below both with the sum of the two conic ideals and
with the intersection of the ideals of `P` and of `Q`. -/
def pointPairIdeal : Ideal (MvPolynomial (Fin 4) k) := Ideal.span {X 0 * X 1, X 2, X 3}

/-- The two variables `z` and `w`, the ones killed by the retraction used below. -/
def zwVars : Finset (Fin 4) := {2, 3}

/-! #### Generators -/

theorem X_zero_mul_X_one_mem_pointPairIdeal :
    (X 0 * X 1 : MvPolynomial (Fin 4) k) ∈ pointPairIdeal k :=
  Ideal.subset_span (by simp)

theorem X_two_mem_pointPairIdeal : (X 2 : MvPolynomial (Fin 4) k) ∈ pointPairIdeal k :=
  Ideal.subset_span (by simp)

theorem X_three_mem_pointPairIdeal : (X 3 : MvPolynomial (Fin 4) k) ∈ pointPairIdeal k :=
  Ideal.subset_span (by simp)

theorem X_one_mem_pointIdealP : (X 1 : MvPolynomial (Fin 4) k) ∈ pointIdealP k :=
  Ideal.subset_span (by simp)

theorem X_two_mem_pointIdealP : (X 2 : MvPolynomial (Fin 4) k) ∈ pointIdealP k :=
  Ideal.subset_span (by simp)

theorem X_three_mem_pointIdealP : (X 3 : MvPolynomial (Fin 4) k) ∈ pointIdealP k :=
  Ideal.subset_span (by simp)

theorem X_zero_mem_pointIdealQ : (X 0 : MvPolynomial (Fin 4) k) ∈ pointIdealQ k :=
  Ideal.subset_span (by simp)

theorem X_two_mem_pointIdealQ : (X 2 : MvPolynomial (Fin 4) k) ∈ pointIdealQ k :=
  Ideal.subset_span (by simp)

theorem X_three_mem_pointIdealQ : (X 3 : MvPolynomial (Fin 4) k) ∈ pointIdealQ k :=
  Ideal.subset_span (by simp)

theorem X_two_mem_conicIdealD : (X 2 : MvPolynomial (Fin 4) k) ∈ conicIdealD k :=
  Ideal.subset_span (by simp)

theorem X_three_mem_conicIdealC : (X 3 : MvPolynomial (Fin 4) k) ∈ conicIdealC k :=
  Ideal.subset_span (by simp)

/-! #### Primality of the two point ideals -/

theorem pointIdealP_eq_span_image_X :
    pointIdealP k = Ideal.span (X '' ((({1, 2, 3} : Finset (Fin 4)) : Set (Fin 4)))) := by
  rw [pointIdealP]
  congr 1
  simp [Set.image_insert_eq]

theorem pointIdealQ_eq_span_image_X :
    pointIdealQ k = Ideal.span (X '' ((({0, 2, 3} : Finset (Fin 4)) : Set (Fin 4)))) := by
  rw [pointIdealQ]
  congr 1
  simp [Set.image_insert_eq]

/-- **The ideal of `P` is prime**: `P` is a reduced point. -/
theorem isPrime_pointIdealP [IsDomain k] : (pointIdealP k).IsPrime := by
  rw [pointIdealP_eq_span_image_X]
  exact isPrime_span_image_X k _

/-- **The ideal of `Q` is prime**: `Q` is a reduced point. -/
theorem isPrime_pointIdealQ [IsDomain k] : (pointIdealQ k).IsPrime := by
  rw [pointIdealQ_eq_span_image_X]
  exact isPrime_span_image_X k _

/-! ### The intersection of the two conics -/

/-- The ideal `(xy - a², b)` lies in `(xy, z, w)` as soon as `a` and `b` do. -/
private theorem span_sub_sq_pair_le_pointPairIdeal {a b : MvPolynomial (Fin 4) k}
    (ha : a ∈ pointPairIdeal k) (hb : b ∈ pointPairIdeal k) :
    Ideal.span {X 0 * X 1 - a ^ 2, b} ≤ pointPairIdeal k := by
  refine Ideal.span_le.2 (Set.insert_subset_iff.2 ⟨Ideal.sub_mem _
    (X_zero_mul_X_one_mem_pointPairIdeal k) ?_, Set.singleton_subset_iff.2 hb⟩)
  rw [pow_two]
  exact Ideal.mul_mem_right _ _ ha

/-- **The scheme-theoretic intersection of the two conics is cut out by `(xy, z, w)`.** The sum of
the two conic ideals is `(xy, z, w)`.

For `⊆`: `xy - z²` and `xy - w²` are `xy` minus a multiple of `z`, resp. of `w`, and `z` and `w`
are generators of `(xy, z, w)`. For `⊇`: `z` lies in the ideal of `D` and `w` in the ideal of `C`,
and `xy = (xy - z²) + z · z` puts `xy` in the sum. -/
theorem conicIdealC_sup_conicIdealD : conicIdealC k ⊔ conicIdealD k = pointPairIdeal k := by
  refine le_antisymm (sup_le ?_ ?_) (Ideal.span_le.2 ?_)
  · exact span_sub_sq_pair_le_pointPairIdeal k (X_two_mem_pointPairIdeal k)
      (X_three_mem_pointPairIdeal k)
  · exact span_sub_sq_pair_le_pointPairIdeal k (X_three_mem_pointPairIdeal k)
      (X_two_mem_pointPairIdeal k)
  · have hz : (X 2 : MvPolynomial (Fin 4) k) ∈ conicIdealC k ⊔ conicIdealD k :=
      Submodule.mem_sup_right (X_two_mem_conicIdealD k)
    have hw : (X 3 : MvPolynomial (Fin 4) k) ∈ conicIdealC k ⊔ conicIdealD k :=
      Submodule.mem_sup_left (X_three_mem_conicIdealC k)
    rintro g hg
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
    obtain rfl | rfl | rfl := hg
    · have hC : (X 0 * X 1 - X 2 ^ 2 : MvPolynomial (Fin 4) k) ∈ conicIdealC k ⊔ conicIdealD k :=
        Submodule.mem_sup_left (Ideal.subset_span (by simp))
      have hsum := Ideal.add_mem _ hC (Ideal.mul_mem_left _ (X 2) hz)
      rwa [pow_two, sub_add_cancel] at hsum
    · exact hz
    · exact hw

theorem span_image_X_zwVars_le_pointPairIdeal :
    Ideal.span (X '' (zwVars : Set (Fin 4)) : Set (MvPolynomial (Fin 4) k)) ≤
      pointPairIdeal k := by
  rw [Ideal.span_le]
  rintro _ ⟨i, hi, rfl⟩
  have hi' : i = 2 ∨ i = 3 := by
    simpa [zwVars] using hi
  obtain rfl | rfl := hi'
  · exact X_two_mem_pointPairIdeal k
  · exact X_three_mem_pointPairIdeal k

/-- Killing `z` and `w` sends `(x_i, z, w)` into `(x_i)`, for `i` not among the killed variables. -/
private theorem span_triple_le_comap_killVars {i : Fin 4} (hi : i ∉ zwVars) :
    Ideal.span {(X i : MvPolynomial (Fin 4) k), X 2, X 3} ≤
      Ideal.comap (killVars k zwVars) (Ideal.span {X i}) := by
  rw [Ideal.span_le]
  rintro g hg
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  simp only [SetLike.mem_coe, Ideal.mem_comap]
  obtain rfl | rfl | rfl := hg
  · rw [killVars_X, ite_eq_right hi]
    exact Ideal.mem_span_singleton_self _
  · rw [killVars_X, ite_eq_left (by decide : (2 : Fin 4) ∈ zwVars)]
    exact Submodule.zero_mem _
  · rw [killVars_X, ite_eq_left (by decide : (3 : Fin 4) ∈ zwVars)]
    exact Submodule.zero_mem _

theorem pointIdealP_le_comap :
    pointIdealP k ≤ Ideal.comap (killVars k zwVars)
      (Ideal.span {(X 1 : MvPolynomial (Fin 4) k)}) :=
  span_triple_le_comap_killVars k (by decide)

theorem pointIdealQ_le_comap :
    pointIdealQ k ≤ Ideal.comap (killVars k zwVars)
      (Ideal.span {(X 0 : MvPolynomial (Fin 4) k)}) :=
  span_triple_le_comap_killVars k (by decide)

/-- **A polynomial vanishing at both `P` and `Q` lies in `(xy, z, w)`.** The hard half of the
intersection computation.

Kill `z` and `w`. Vanishing at `P` makes the image divisible by `y`, vanishing at `Q` makes it
divisible by `x`; `x` and `y` are primes of `k[x, y, z, w]` and neither divides the other, so `xy`
divides the image. The difference between a polynomial and its image lies in `(z, w)` by
`Stacks.Examples.HironakaConicIntersection.sub_killVars_mem_span`, and `(z, w) ⊆ (xy, z, w)`. -/
theorem pointIdealP_inf_pointIdealQ_le [IsDomain k] :
    pointIdealP k ⊓ pointIdealQ k ≤ pointPairIdeal k := by
  intro g hg
  rw [Submodule.mem_inf] at hg
  obtain ⟨hgP, hgQ⟩ := hg
  have hdvdY : (X 1 : MvPolynomial (Fin 4) k) ∣ killVars k zwVars g :=
    Ideal.mem_span_singleton.1 (pointIdealP_le_comap k hgP)
  have hdvdX : (X 0 : MvPolynomial (Fin 4) k) ∣ killVars k zwVars g :=
    Ideal.mem_span_singleton.1 (pointIdealQ_le_comap k hgQ)
  obtain ⟨h, hh⟩ := hdvdX
  rw [hh] at hdvdY
  have hprime : Prime (X 1 : MvPolynomial (Fin 4) k) := MvPolynomial.X_prime
  have hnotdvd : ¬ (X 1 : MvPolynomial (Fin 4) k) ∣ X 0 := by
    rw [MvPolynomial.X_dvd_X]
    decide
  obtain ⟨h', rfl⟩ : (X 1 : MvPolynomial (Fin 4) k) ∣ h :=
    (hprime.dvd_or_dvd hdvdY).resolve_left hnotdvd
  have hkill : killVars k zwVars g ∈ pointPairIdeal k := by
    rw [hh, show (X 0 : MvPolynomial (Fin 4) k) * (X 1 * h') = X 0 * X 1 * h' by ring]
    exact Ideal.mul_mem_right _ _ (X_zero_mul_X_one_mem_pointPairIdeal k)
  have hdiff : g - killVars k zwVars g ∈ pointPairIdeal k :=
    span_image_X_zwVars_le_pointPairIdeal k (sub_killVars_mem_span k zwVars g)
  have hg' := Ideal.add_mem _ hdiff hkill
  rwa [sub_add_cancel] at hg'

theorem le_pointIdealP_inf_pointIdealQ :
    pointPairIdeal k ≤ pointIdealP k ⊓ pointIdealQ k := by
  rw [pointPairIdeal, Ideal.span_le]
  rintro g hg
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hg
  simp only [SetLike.mem_coe, Submodule.mem_inf]
  obtain rfl | rfl | rfl := hg
  · exact ⟨Ideal.mul_mem_left _ _ (X_one_mem_pointIdealP k),
      Ideal.mul_mem_right _ _ (X_zero_mem_pointIdealQ k)⟩
  · exact ⟨X_two_mem_pointIdealP k, X_two_mem_pointIdealQ k⟩
  · exact ⟨X_three_mem_pointIdealP k, X_three_mem_pointIdealQ k⟩

/-- **`(xy, z, w)` is the intersection of the ideal of `P` with the ideal of `Q`.** -/
theorem pointPairIdeal_eq_inf [IsDomain k] :
    pointPairIdeal k = pointIdealP k ⊓ pointIdealQ k :=
  le_antisymm (le_pointIdealP_inf_pointIdealQ k) (pointIdealP_inf_pointIdealQ_le k)

/-- **`C ∩ D` consists of the two points `P` and `Q`.** The sum of the homogeneous ideals of the
two conics — the homogeneous ideal of their scheme-theoretic intersection — is the intersection of
the homogeneous ideal of `P` with that of `Q`. -/
theorem conicIdealC_sup_conicIdealD_eq_inf [IsDomain k] :
    conicIdealC k ⊔ conicIdealD k = pointIdealP k ⊓ pointIdealQ k := by
  rw [conicIdealC_sup_conicIdealD, pointPairIdeal_eq_inf]

/-- **The closed subscheme `C ∩ D` is reduced.** The homogeneous ideal of the scheme-theoretic
intersection of the two conics is radical, being the intersection of two prime ideals. -/
theorem isRadical_conicIdealC_sup_conicIdealD [IsDomain k] :
    (conicIdealC k ⊔ conicIdealD k).IsRadical := by
  rw [conicIdealC_sup_conicIdealD_eq_inf]
  exact (isPrime_pointIdealP k).isRadical.inf (isPrime_pointIdealQ k).isRadical

end Stacks.Examples.HironakaConicIntersection

end
