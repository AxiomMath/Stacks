module

public import StacksFrontier.AlgebraicGeometry.Examples.CoefficientProjFibre
public import StacksFrontier.AlgebraicGeometry.ProjClosedImmersion.Quotient
public import StacksFrontier.RingTheory.MvPolynomial.KillLastVariable
public import StacksFrontier.RingTheory.MvPolynomial.MonomialCoefficientIdeal

/-!
# Recognizing the fibres of a coefficientwise projective family

A coefficientwise projective family whose extended coefficient ideal is one of three concrete
homogeneous ideals of the polynomial ring has a recognizable fibre:

* the zero ideal gives projective space `ℙ^m`;
* the ideal generated by the last variable gives `ℙ^{m-1}`, the polynomial ring in one variable
  fewer;
* the ideal generated by a product `Xᵢ Xⱼ` of two variables gives the vanishing locus of that
  product in `ℙ^m`, a closed subscheme of projective space.

Each is an instance of one statement: a graded surjection out of the polynomial ring whose kernel
is the extended coefficient ideal and which carries each graded piece onto the graded piece of the
same degree identifies its target's `Proj` with the fibre, over the base.

## Main definitions

* `Stacks.CoefficientProj.monomialPairGrading`: the grading of `k[X₀, …, X_m] ⧸ (Xᵢ Xⱼ)`.
* `Stacks.CoefficientProj.monomialPairLocus`: its `Proj`, the vanishing locus of `Xᵢ Xⱼ` in
  `ℙ^m_k`, with its structure morphism and its closed immersion into `ℙ^m_k`.

## Main results

* `Stacks.CoefficientProj.exists_isPullback_of_gradedSurjection`: the general recognition
  statement.
* `Stacks.CoefficientProj.exists_isPullback_projectiveSpace`,
  `Stacks.CoefficientProj.exists_isPullback_projectiveSpace_of_span_X_last` and
  `Stacks.CoefficientProj.exists_isPullback_monomialPairLocus`: the three instances.
* `Stacks.CoefficientProj.isClosedImmersion_monomialPairLocusToProjectiveSpace` and
  `Stacks.CoefficientProj.monomialPairLocusToProjectiveSpace_comp`: the vanishing locus of
  `Xᵢ Xⱼ` is a closed subscheme of `ℙ^m_k`, over `Spec k`.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry MvPolynomial HomogeneousLocalization
open HomogeneousIdeal TensorProduct Stacks.GradedModel Stacks.ProjectiveCohomology

namespace Stacks.CoefficientProj

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

/-! ### The degree-zero structure map of a polynomial ring -/

/-- The identification of the coefficient ring with the degree-zero part of a polynomial ring is
the structure map of the degree-zero part as an algebra over the coefficient ring. -/
theorem polyDegreeZeroHom_eq (R : Type u) [CommRing R] (n : ℕ) :
    polyDegreeZeroHom R n = CommRingCat.ofHom (algebraMap R ↥(polyGrading R n 0)) := by
  rw [polyDegreeZeroHom]
  congr 1

/-- The isomorphism `projModelIso R n` from `Proj R[X₀, …, X_n]` to `ℙ^n_R` commutes with the
structure morphisms to `Spec R`, that of `ℙ^n_R` being the one of its `CanonicallyOver`
instance. -/
theorem projModelIso_hom_structure (R : Type u) [CommRing R] (n : ℕ) :
    (projModelIso R n).hom ≫
        (projectiveSpaceOverRing n (CommRingCat.of R) ↘ Spec (CommRingCat.of R)) =
      projModelToSpec R n :=
  projModelIso_hom_structureMorphism R n

/-! ### The vanishing locus of a product of two variables in projective space -/

section MonomialPair

variable (k : Type u) [CommRing k] (m : ℕ) (i j : Fin (m + 1))

/-- The ideal of `k[X₀, …, X_m]` generated by the product `Xᵢ Xⱼ` is homogeneous. -/
theorem isHomogeneous_span_X_mul_X :
    (Ideal.span {X i * X j} : Ideal (MvPolynomial (Fin (m + 1)) k)).IsHomogeneous
      (homogeneousSubmodule (Fin (m + 1)) k) := by
  refine Ideal.homogeneous_span _ _ ?_
  rintro p rfl
  exact ⟨2, (isHomogeneous_X k i).mul (isHomogeneous_X k j)⟩

/-- The grading by total degree of `k[X₀, …, X_m] ⧸ (Xᵢ Xⱼ)`. -/
abbrev monomialPairGrading :
    ℕ → Submodule k (MvPolynomial (Fin (m + 1)) k ⧸
      (Ideal.span {X i * X j} : Ideal (MvPolynomial (Fin (m + 1)) k))) :=
  quotientGrading (homogeneousSubmodule (Fin (m + 1)) k) (Ideal.span {X i * X j})

/-- `k[X₀, …, X_m] ⧸ (Xᵢ Xⱼ)` is a graded algebra for its grading by total degree. -/
instance : GradedAlgebra (monomialPairGrading k m i j) :=
  quotientGradedAlgebra _ (isHomogeneous_span_X_mul_X k m i j)

/-- **The vanishing locus of `Xᵢ Xⱼ` in `ℙ^m_k`**: `Proj` of the quotient of `k[X₀, …, X_m]` by
the ideal generated by `Xᵢ Xⱼ`. -/
def monomialPairLocus : Scheme.{u} :=
  AlgebraicGeometry.Proj (monomialPairGrading k m i j)

/-- The structure morphism of the vanishing locus of `Xᵢ Xⱼ` over `Spec k`. -/
def monomialPairLocusToSpec : monomialPairLocus k m i j ⟶ Spec (CommRingCat.of k) :=
  Proj.toSpecZero (monomialPairGrading k m i j) ≫
    Spec.map (CommRingCat.ofHom (algebraMap k ↥(monomialPairGrading k m i j 0)))

/-- The quotient map onto `k[X₀, …, X_m] ⧸ (Xᵢ Xⱼ)`, as a homomorphism of graded rings. -/
def monomialPairMk :
    homogeneousSubmodule (Fin (m + 1)) k →+*ᵍ monomialPairGrading k m i j where
  __ := Ideal.Quotient.mk (Ideal.span {X i * X j})
  map_mem ha := mk_mem_quotientGrading ha

/-- The quotient map onto `k[X₀, …, X_m] ⧸ (Xᵢ Xⱼ)` is surjective. -/
theorem surjective_monomialPairMk : Function.Surjective (monomialPairMk k m i j) :=
  Ideal.Quotient.mk_surjective

/-- The kernel of the quotient map onto `k[X₀, …, X_m] ⧸ (Xᵢ Xⱼ)` is the ideal generated by
`Xᵢ Xⱼ`. -/
theorem ker_monomialPairMk :
    RingHom.ker (monomialPairMk k m i j).toRingHom =
      (Ideal.span {X i * X j} : Ideal (MvPolynomial (Fin (m + 1)) k)) :=
  Ideal.mk_ker

/-- The irrelevant ideal of `k[X₀, …, X_m] ⧸ (Xᵢ Xⱼ)` is contained in the image of the irrelevant
ideal of `k[X₀, …, X_m]` under the quotient map. -/
theorem irrelevant_le_map_monomialPairMk :
    (monomialPairGrading k m i j)₊ ≤
      (homogeneousSubmodule (Fin (m + 1)) k)₊.map (monomialPairMk k m i j) := by
  refine (HomogeneousIdeal.irrelevant_le _).2 fun d hd x hx => ?_
  obtain ⟨p, hp, rfl⟩ := hx
  exact Ideal.mem_map_of_mem _ (HomogeneousIdeal.mem_irrelevant_of_mem _ hd hp)

/-- **The vanishing locus of `Xᵢ Xⱼ` is a closed subscheme of `Proj k[X₀, …, X_m]`.** -/
def monomialPairLocusι :
    monomialPairLocus k m i j ⟶ AlgebraicGeometry.Proj (polyGrading k m) :=
  Proj.map (monomialPairMk k m i j) (irrelevant_le_map_monomialPairMk k m i j)

/-- The morphism from the vanishing locus of `Xᵢ Xⱼ` to `Proj k[X₀, …, X_m]` is a closed
immersion. -/
instance isClosedImmersion_monomialPairLocusι :
    IsClosedImmersion (monomialPairLocusι k m i j) :=
  Proj.isClosedImmersion_map_of_surjective _ (surjective_monomialPairMk k m i j)

/-- The closed immersion of the vanishing locus of `Xᵢ Xⱼ` into `ℙ^m_k`. -/
def monomialPairLocusToProjectiveSpace :
    monomialPairLocus k m i j ⟶ projectiveSpaceOverRing m (CommRingCat.of k) :=
  monomialPairLocusι k m i j ≫ (projModelIso k m).hom

/-- The morphism from the vanishing locus of `Xᵢ Xⱼ` to `ℙ^m_k` is a closed immersion. -/
instance isClosedImmersion_monomialPairLocusToProjectiveSpace :
    IsClosedImmersion (monomialPairLocusToProjectiveSpace k m i j) := by
  rw [monomialPairLocusToProjectiveSpace,
    MorphismProperty.cancel_right_of_respectsIso (P := @IsClosedImmersion)]
  infer_instance

/-- The closed immersion of the vanishing locus of `Xᵢ Xⱼ` into `ℙ^m_k` is a morphism over
`Spec k`. -/
theorem monomialPairLocusToProjectiveSpace_comp :
    monomialPairLocusToProjectiveSpace k m i j ≫
        (projectiveSpaceOverRing m (CommRingCat.of k) ↘ Spec (CommRingCat.of k)) =
      monomialPairLocusToSpec k m i j := by
  rw [monomialPairLocusToProjectiveSpace, Category.assoc,
    projModelIso_hom_structure, projModelToSpec_eq, polyDegreeZeroHom_eq,
    monomialPairLocusι]
  exact map_comp_toSpecZero_comp (irrelevant_le_map_monomialPairMk k m i j) <| by
    rw [← CommRingCat.ofHom_comp]
    congr 1

end MonomialPair

/-! ### Recognizing a fibre from a graded surjection -/

variable {m : ℕ} {R : Type u} [CommRing R] (K : (Fin (m + 1) →₀ ℕ) → Ideal R)
  (S : Type u) [CommRing S] [Algebra R S]

/-- For a graded surjection `f` out of `S[X₀, …, X_m]` with kernel the extended coefficient ideal
and respecting `S`, the degree-zero part of the induced graded isomorphism
`quotientKerGradedHom f hJ hsurj` is compatible with the structure maps from `S`. This is the
degree-zero compatibility that `Stacks.CoefficientProj.exists_isPullback_of_gradedIso` asks for. -/
theorem gradedZeroRingHom_quotientKerGradedHom {M : Type u} [CommRing M] [Algebra S M]
    {ℳ : ℕ → Submodule S M} [GradedAlgebra ℳ]
    (f : homogeneousSubmodule (Fin (m + 1)) S →+*ᵍ ℳ)
    (hJ : RingHom.ker f.toRingHom = coefficientIdeal (baseChange K S))
    (hsurj : Function.Surjective f)
    (hf0 : ∀ r : S, f (algebraMap S (MvPolynomial (Fin (m + 1)) S) r) = algebraMap S M r) :
    CommRingCat.ofHom (algebraMap S ↥(projGrading (baseChange K S) 0)) ≫
        CommRingCat.ofHom (quotientKerGradedHom f hJ hsurj).gradedZeroRingHom =
      CommRingCat.ofHom (algebraMap S ↥(ℳ 0)) := by
  rw [← CommRingCat.ofHom_comp]
  congr 1
  refine RingHom.ext fun r => Subtype.ext ?_
  simpa [SetLike.GradeZero.coe_algebraMap] using
    quotientKerGradedHom_algebraMap f hJ hsurj hf0 r

/-- **A graded surjection out of the polynomial ring whose kernel is the extended coefficient
ideal identifies its target's `Proj` with the fibre of the family.** -/
theorem exists_isPullback_of_gradedSurjection {M : Type u} [CommRing M] [Algebra S M]
    (ℳ : ℕ → Submodule S M) [GradedAlgebra ℳ]
    (f : homogeneousSubmodule (Fin (m + 1)) S →+*ᵍ ℳ)
    (hJ : RingHom.ker f.toRingHom = coefficientIdeal (baseChange K S))
    (hsurj : Function.Surjective f)
    (honto : ∀ d, ∀ y ∈ ℳ d, ∃ a ∈ homogeneousSubmodule (Fin (m + 1)) S d, f a = y)
    (hf0 : ∀ r : S, f (algebraMap S (MvPolynomial (Fin (m + 1)) S) r) = algebraMap S M r) :
    ∃ g : AlgebraicGeometry.Proj ℳ ⟶ AlgebraicGeometry.Proj (projGrading K),
      IsPullback g
        (Proj.toSpecZero ℳ ≫ Spec.map (CommRingCat.ofHom (algebraMap S ↥(ℳ 0))))
        (toSpecBase K) (Spec.map (CommRingCat.ofHom (algebraMap R S))) :=
  exists_isPullback_of_gradedIso K S ℳ (quotientKerGradedHom f hJ hsurj)
    (quotientKerGradedInv f hJ hsurj honto) (quotientKerGradedInv_comp_hom f hJ hsurj honto)
    (quotientKerGradedHom_comp_inv f hJ hsurj honto)
    (gradedZeroRingHom_quotientKerGradedHom K S f hJ hsurj hf0)

/-! ### The three recognizable fibres -/

/-- A fibre recognition for `Proj S[X₀, …, X_n]` with its degree-zero structure map gives one for
`ℙ^n_S`. -/
private theorem exists_isPullback_projectiveSpace_of_polyGrading {N : ℕ}
    (K' : (Fin (N + 1) →₀ ℕ) → Ideal R) {n : ℕ}
    (hg : ∃ g : AlgebraicGeometry.Proj (homogeneousSubmodule (Fin (n + 1)) S) ⟶
        AlgebraicGeometry.Proj (projGrading K'),
      IsPullback g (Proj.toSpecZero (homogeneousSubmodule (Fin (n + 1)) S) ≫
        Spec.map (CommRingCat.ofHom (algebraMap S ↥(homogeneousSubmodule (Fin (n + 1)) S 0))))
        (toSpecBase K') (Spec.map (CommRingCat.ofHom (algebraMap R S)))) :
    ∃ g : projectiveSpaceOverRing n (CommRingCat.of S) ⟶ AlgebraicGeometry.Proj (projGrading K'),
      IsPullback g (projectiveSpaceOverRing n (CommRingCat.of S) ↘ Spec (CommRingCat.of S))
        (toSpecBase K') (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
  obtain ⟨g, hg⟩ := hg
  rw [show Proj.toSpecZero (homogeneousSubmodule (Fin (n + 1)) S) ≫
      Spec.map (CommRingCat.ofHom (algebraMap S ↥(homogeneousSubmodule (Fin (n + 1)) S 0))) =
      projModelToSpec S n from by rw [projModelToSpec_eq, polyDegreeZeroHom_eq]] at hg
  refine ⟨(projModelIso S n).inv ≫ g, hg.of_iso' (projModelIso S n).symm (Iso.refl _)
    (Iso.refl _) (Iso.refl _) (by simp) ?_ (by simp) (by simp)⟩
  rw [Iso.refl_hom, Category.comp_id, Iso.symm_hom,
    ← projModelIso_hom_structure S n, Iso.inv_hom_id_assoc]

/-- **When the extended coefficient ideal is zero the fibre is projective space.** -/
theorem exists_isPullback_projectiveSpace
    (hJ : coefficientIdeal (baseChange K S) = ⊥) :
    ∃ g : projectiveSpaceOverRing m (CommRingCat.of S) ⟶
        AlgebraicGeometry.Proj (projGrading K),
      IsPullback g (projectiveSpaceOverRing m (CommRingCat.of S) ↘ Spec (CommRingCat.of S))
        (toSpecBase K) (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
  have hker : RingHom.ker (GradedRingHom.id (homogeneousSubmodule (Fin (m + 1)) S)).toRingHom =
      coefficientIdeal (baseChange K S) := by
    rw [hJ]
    exact (RingHom.ker_eq_bot_iff_eq_zero _).mpr fun _ h => h
  have hg := exists_isPullback_of_gradedSurjection K S
    (homogeneousSubmodule (Fin (m + 1)) S) (GradedRingHom.id _) hker (fun y => ⟨y, rfl⟩)
    (fun _ y hy => ⟨y, hy, rfl⟩) (fun _ => rfl)
  exact exists_isPullback_projectiveSpace_of_polyGrading S K hg

/-- **When the extended coefficient ideal is generated by the last variable the fibre is
projective space of one dimension less.** -/
theorem exists_isPullback_projectiveSpace_of_span_X_last {n : ℕ}
    (K : (Fin (n + 2) →₀ ℕ) → Ideal R)
    (hJ : coefficientIdeal (baseChange K S) =
      Ideal.span {X (Fin.last (n + 1))}) :
    ∃ g : projectiveSpaceOverRing n (CommRingCat.of S) ⟶
        AlgebraicGeometry.Proj (projGrading K),
      IsPullback g (projectiveSpaceOverRing n (CommRingCat.of S) ↘ Spec (CommRingCat.of S))
        (toSpecBase K) (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
  have hker : RingHom.ker (killLastGradedHom S (n + 1)).toRingHom =
      coefficientIdeal (baseChange K S) := by
    rw [hJ]
    exact ker_killLast S (n + 1)
  have hg := exists_isPullback_of_gradedSurjection K S
    (homogeneousSubmodule (Fin (n + 1)) S) (killLastGradedHom S (n + 1)) hker
    (surjective_killLast S (n + 1)) (exists_isHomogeneous_killLast_eq S (n + 1))
    (fun r => (killLast S (n + 1)).commutes r)
  exact exists_isPullback_projectiveSpace_of_polyGrading S K hg

/-- **When the extended coefficient ideal is generated by a product of two variables the fibre is
the vanishing locus of that product in projective space.** -/
theorem exists_isPullback_monomialPairLocus (i j : Fin (m + 1))
    (hJ : coefficientIdeal (baseChange K S) = Ideal.span {X i * X j}) :
    ∃ g : monomialPairLocus S m i j ⟶ AlgebraicGeometry.Proj (projGrading K),
      IsPullback g (monomialPairLocusToSpec S m i j) (toSpecBase K)
        (Spec.map (CommRingCat.ofHom (algebraMap R S))) := by
  have hker : RingHom.ker (monomialPairMk S m i j).toRingHom =
      coefficientIdeal (baseChange K S) := by
    rw [hJ]
    exact ker_monomialPairMk S m i j
  exact exists_isPullback_of_gradedSurjection K S (monomialPairGrading S m i j)
    (monomialPairMk S m i j) hker (surjective_monomialPairMk S m i j)
    (fun _ _ hy => hy) (fun _ => rfl)

end Stacks.CoefficientProj

end
