module

public import StacksFrontier.AlgebraicGeometry.Examples.HironakaConicIntersection
public import StacksFrontier.AlgebraicGeometry.ProjIdealSheaf.HomogeneousIdealSheaf
public import StacksFrontier.AlgebraicGeometry.ProjectiveSpace.Dimension.Basic

/-!
# The two conics of Hironaka's example as ideal sheaves on `ℙ³`

Hironaka's Example B.3.4.1 (Stacks Tag 08J1, see
`StacksFrontier/AlgebraicGeometry/Examples/ProjectivityNotLocalOnBase.lean`) starts from the two
conics `C = {xy = z², w = 0}` and `D = {xy = w², z = 0}` of `Y = ℙ³_k`, which meet in the two
points `P = [1 : 0 : 0 : 0]` and `Q = [0 : 1 : 0 : 0]`. Their homogeneous ideals and the
intersection computation are in
`StacksFrontier/AlgebraicGeometry/Examples/HironakaConicIntersection.lean`. This file turns them into
the objects the blow-up construction consumes:

* the quasi-coherent ideal sheaves `idealSheafC` and `idealSheafD` on
  `Y = Proj k[x, y, z, w]`, both of finite type (the hypothesis of
  `Stacks.Blowup.isProjective_blowUpToBase`);
* the closed points `pointP` and `pointQ` of `Y`, and the opens `Y - {Q}`, `Y - {P}` and
  `Y - {P, Q}`, with `(Y - {Q}) ⊔ (Y - {P}) = ⊤` and `(Y - {Q}) ⊓ (Y - {P}) = Y - {P, Q}`;
* the support of `idealSheafC ⊔ idealSheafD` is exactly `{P, Q}`, so that over `Y - {P, Q}` the
  restrictions of the two ideal sheaves are comaximal: `C` and `D` are disjoint there.

## Main definitions

* `Stacks.Examples.HironakaConicIdealSheaf.coordinatePoint`: the coordinate point
  `V₊(X i : i ≠ j)` of `Proj k[X_i : i ∈ σ]`.
* `Stacks.Examples.HironakaConicIdealSheaf.idealSheafC`,
  `Stacks.Examples.HironakaConicIdealSheaf.idealSheafD`: the two conics.
* `Stacks.Examples.HironakaConicIdealSheaf.pointP`,
  `Stacks.Examples.HironakaConicIdealSheaf.pointQ`: the points `P` and `Q`.
* `Stacks.Examples.HironakaConicIdealSheaf.opensAwayP`,
  `Stacks.Examples.HironakaConicIdealSheaf.opensAwayQ`,
  `Stacks.Examples.HironakaConicIdealSheaf.opensAwayPQ`: `Y - {P}`, `Y - {Q}`, `Y - {P, Q}`.

## Main results

* `Stacks.Examples.HironakaConicIdealSheaf.eq_coordinatePoint_iff`: over a field, a point of
  projective space whose homogeneous prime contains all coordinates but `X j` *is* the coordinate
  point; in particular coordinate points are closed (`isClosed_singleton_coordinatePoint`).
* `Stacks.Examples.HironakaConicIdealSheaf.isFiniteType_idealSheafC`,
  `Stacks.Examples.HironakaConicIdealSheaf.isFiniteType_idealSheafD`.
* `Stacks.Examples.HironakaConicIdealSheaf.supportSet_idealSheafC_sup_idealSheafD`:
  `Supp(𝒥_C + 𝒥_D) = {P, Q}`.
* `Stacks.Examples.HironakaConicIdealSheaf.comap_idealSheafC_sup_comap_idealSheafD_eq_top`:
  on `Y - {P, Q}` the restrictions of `𝒥_C` and `𝒥_D` sum to the unit ideal sheaf.

## Implementation notes

The ideal sheaves are `AlgebraicGeometry.ProjectiveSpectrum.Proj.homogeneousIdealSheaf` of the
homogeneous ideals of `HironakaConicIntersection`, so their chart ideals over `D₊(X i)` are the
degree-zero localizations (`homogeneousIdealSheaf_ideal_basicOpen_eq_span_range`). The support
computation reduces, through `supportSet_homogeneousIdealSheaf`, to
`conicIdealC_sup_conicIdealD_eq_inf` and to the identification of the points of `ℙ³` containing
the ideal of `P` (resp. `Q`); the latter is the only geometry here, and it is where the base must
be a field: over a domain that is not a field the "point" `V₊(y, z, w)` is not closed.

## References

* [Stacks Project, Tag 08J1](https://stacks.math.columbia.edu/tag/08J1)
* [H, Example B.3.4.1]
-/

@[expose] public noncomputable section

open MvPolynomial AlgebraicGeometry
open AlgebraicGeometry.ProjectiveSpectrum.Proj (homogeneousIdealSheaf
  mem_supportSet_homogeneousIdealSheaf_iff isFiniteType_homogeneousIdealSheaf)
open Stacks.Examples.HironakaConicIntersection

universe u v

namespace Stacks.Examples.HironakaConicIdealSheaf

attribute [local instance] MvPolynomial.gradedAlgebra

/-! ### Coordinate points of projective space -/

section CoordinatePoint

variable (k : Type u) [Field k] {σ : Type v}

/-- The ideal generated by all coordinates except `X j`: the homogeneous ideal of the coordinate
point `[0 : … : 1 : … : 0]` (the `1` in position `j`). -/
def coordinateIdeal (j : σ) : Ideal (MvPolynomial σ k) :=
  Ideal.span (X '' {i | i ≠ j})

/-- The ideal of a coordinate point is homogeneous. -/
theorem isHomogeneous_coordinateIdeal (j : σ) :
    (coordinateIdeal k j).IsHomogeneous (homogeneousSubmodule σ k) :=
  Ideal.homogeneous_span _ _ (by
    rintro _ ⟨i, -, rfl⟩
    exact ⟨1, (mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X k i)⟩)

/-- The ideal of a coordinate point, as a homogeneous ideal. -/
def coordinateHomogeneousIdeal (j : σ) : HomogeneousIdeal (homogeneousSubmodule σ k) :=
  ⟨coordinateIdeal k j, isHomogeneous_coordinateIdeal k j⟩

/-- **The coordinate point `[0 : … : 1 : … : 0]` of `Proj k[X_i : i ∈ σ]`**, the `1` in
position `j`: the homogeneous prime generated by the other coordinates. -/
def coordinatePoint (j : σ) : AlgebraicGeometry.Proj (homogeneousSubmodule σ k) :=
  (⟨coordinateHomogeneousIdeal k j, isPrime_span_X_image _, fun h => by
    have hX : (X j : MvPolynomial σ k) ∈ coordinateIdeal k j :=
      h (HomogeneousIdeal.mem_irrelevant_of_mem _ one_pos
        ((mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X k j)))
    exact (X_mem_span_X_image_iff.mp hX) rfl⟩ : ProjectiveSpectrum (homogeneousSubmodule σ k))

/-- The homogeneous prime of the coordinate point is the ideal of the other coordinates. -/
theorem coordinatePoint_toIdeal (j : σ) :
    (coordinatePoint k j).asHomogeneousIdeal.toIdeal = coordinateIdeal k j :=
  rfl

/-- **A homogeneous polynomial of degree `n` agrees with its `X j ^ n` term modulo the other
coordinates.** -/
theorem sub_monomial_mem_coordinateIdeal {n : ℕ} {p : MvPolynomial σ k} (hp : p.IsHomogeneous n)
    (j : σ) :
    p - monomial (Finsupp.single j n) (p.coeff (Finsupp.single j n)) ∈ coordinateIdeal k j := by
  classical
  rw [coordinateIdeal, mem_ideal_span_X_image]
  intro m hm
  rw [mem_support_iff, coeff_sub, coeff_monomial] at hm
  by_contra hcon
  simp only [Set.mem_setOf_eq, ne_eq, not_exists, not_and, not_not] at hcon
  have hmj : m = Finsupp.single j (m j) := by
    ext i
    by_cases hij : i = j
    · subst hij; simp
    · rw [Finsupp.single_apply, if_neg (Ne.symm hij)]
      exact hcon i hij
  by_cases heq : Finsupp.single j n = m
  · rw [if_pos heq, heq, sub_self] at hm
    exact hm rfl
  · rw [if_neg heq, sub_zero] at hm
    have hw := hp hm
    rw [hmj, Finsupp.weight_single] at hw
    apply heq
    rw [hmj, ← hw]
    simp

/-- **A point of projective space over a field whose prime contains all coordinates but `X j` is
the coordinate point.** Some coordinate is not in the prime, and it can only be `X j`; then a
homogeneous element of the prime is `c · X j ^ n` modulo the ideal of the coordinate point, and
primality forces `c = 0`. -/
theorem eq_coordinatePoint_iff (j : σ) (x : AlgebraicGeometry.Proj (homogeneousSubmodule σ k)) :
    coordinateIdeal k j ≤ x.asHomogeneousIdeal.toIdeal ↔ x = coordinatePoint k j := by
  constructor
  · intro hx
    have hXj : (X j : MvPolynomial σ k) ∉ x.asHomogeneousIdeal := by
      obtain ⟨i, hi⟩ := Stacks.ProjectiveSpace.exists_mem_basicOpen_X x
      rw [Proj.mem_basicOpen] at hi
      by_cases hij : i = j
      · subst hij; exact hi
      · exact absurd (hx (Ideal.subset_span ⟨i, hij, rfl⟩)) hi
    have hle : x.asHomogeneousIdeal.toIdeal ≤ coordinateIdeal k j := by
      intro a ha
      refine ((isHomogeneous_coordinateIdeal k j).mem_iff).mpr fun n => ?_
      set p : MvPolynomial σ k :=
        ((DirectSum.decompose (homogeneousSubmodule σ k) a n : homogeneousSubmodule σ k n) :
          MvPolynomial σ k)
      have hpx : p ∈ x.asHomogeneousIdeal.toIdeal :=
        (x.asHomogeneousIdeal.isHomogeneous.mem_iff).mp ha n
      have hp : p.IsHomogeneous n := (mem_homogeneousSubmodule _ _).mp (Subtype.prop _)
      set c := p.coeff (Finsupp.single j n)
      have hdiff := sub_monomial_mem_coordinateIdeal k hp j
      have hmon : C c * X j ^ n ∈ x.asHomogeneousIdeal.toIdeal := by
        rw [C_mul_X_pow_eq_monomial]
        have h := sub_mem hpx (hx hdiff)
        rwa [sub_sub_cancel] at h
      have hc : c = 0 := by
        by_contra hc
        rcases x.isPrime.mem_or_mem hmon with h | h
        · exact x.isPrime.ne_top
            (Ideal.eq_top_of_isUnit_mem _ h ((isUnit_iff_ne_zero.mpr hc).map C))
        · exact hXj (x.isPrime.mem_of_pow_mem n h)
      have hc' : p.coeff (Finsupp.single j n) = 0 := hc
      rwa [hc', map_zero, sub_zero] at hdiff
    exact ProjectiveSpectrum.ext (HomogeneousIdeal.ext (le_antisymm hle hx))
  · rintro rfl
    exact le_rfl

/-- **Coordinate points are closed.** The singleton is the support of the ideal sheaf of the
ideal of the point. -/
theorem isClosed_singleton_coordinatePoint (j : σ) :
    IsClosed ({coordinatePoint k j} : Set (AlgebraicGeometry.Proj (homogeneousSubmodule σ k))) := by
  have h : ({coordinatePoint k j} : Set (AlgebraicGeometry.Proj (homogeneousSubmodule σ k))) =
      (homogeneousIdealSheaf (homogeneousSubmodule σ k)
        (coordinateHomogeneousIdeal k j)).supportSet := by
    ext x
    rw [mem_supportSet_homogeneousIdealSheaf_iff, Set.mem_singleton_iff]
    exact (eq_coordinatePoint_iff k j x).symm
  rw [h]
  exact Scheme.IdealSheafData.isClosed_supportSet _

end CoordinatePoint

/-! ### The conics, the points and the opens of `ℙ³` -/

variable (k : Type u) [Field k]

/-- `Y = ℙ³_k = Proj k[x, y, z, w]`, the variables being `X 0, X 1, X 2, X 3`. -/
abbrev projectiveThreeSpace : Scheme.{u} := AlgebraicGeometry.Proj (homogeneousSubmodule (Fin 4) k)

/-- `xy - z²` is homogeneous of degree `2`. -/
theorem X_zero_mul_X_one_sub_X_two_sq_mem :
    (X 0 * X 1 - X 2 ^ 2 : MvPolynomial (Fin 4) k) ∈ homogeneousSubmodule (Fin 4) k 2 :=
  (mem_homogeneousSubmodule _ _).mpr
    (((isHomogeneous_X k 0).mul (isHomogeneous_X k 1)).sub ((isHomogeneous_X k 2).pow 2))

/-- `xy - w²` is homogeneous of degree `2`. -/
theorem X_zero_mul_X_one_sub_X_three_sq_mem :
    (X 0 * X 1 - X 3 ^ 2 : MvPolynomial (Fin 4) k) ∈ homogeneousSubmodule (Fin 4) k 2 :=
  (mem_homogeneousSubmodule _ _).mpr
    (((isHomogeneous_X k 0).mul (isHomogeneous_X k 1)).sub ((isHomogeneous_X k 3).pow 2))

/-- A variable is homogeneous of degree `1`. -/
theorem X_mem_one (i : Fin 4) :
    (X i : MvPolynomial (Fin 4) k) ∈ homogeneousSubmodule (Fin 4) k 1 :=
  (mem_homogeneousSubmodule _ _).mpr (isHomogeneous_X k i)

/-- The generators of the ideal of `C`: `xy - z²` and `w`. -/
def generatorsC : Fin 2 → MvPolynomial (Fin 4) k := ![X 0 * X 1 - X 2 ^ 2, X 3]

/-- The generators of the ideal of `D`: `xy - w²` and `z`. -/
def generatorsD : Fin 2 → MvPolynomial (Fin 4) k := ![X 0 * X 1 - X 3 ^ 2, X 2]

/-- The degrees of the generators of either conic: `2` and `1`. -/
def generatorDegrees : Fin 2 → ℕ := ![2, 1]

/-- The generators of the ideal of `C` are homogeneous of degrees `2` and `1`. -/
theorem generatorsC_mem (j : Fin 2) :
    generatorsC k j ∈ homogeneousSubmodule (Fin 4) k (generatorDegrees j • 1) := by
  fin_cases j
  · simpa [generatorsC, generatorDegrees] using X_zero_mul_X_one_sub_X_two_sq_mem k
  · simpa [generatorsC, generatorDegrees] using X_mem_one k 3

/-- The generators of the ideal of `D` are homogeneous of degrees `2` and `1`. -/
theorem generatorsD_mem (j : Fin 2) :
    generatorsD k j ∈ homogeneousSubmodule (Fin 4) k (generatorDegrees j • 1) := by
  fin_cases j
  · simpa [generatorsD, generatorDegrees] using X_zero_mul_X_one_sub_X_three_sq_mem k
  · simpa [generatorsD, generatorDegrees] using X_mem_one k 2

/-- The ideal of `C` is generated by `generatorsC`. -/
theorem conicIdealC_eq_span_range : conicIdealC k = Ideal.span (Set.range (generatorsC k)) := by
  rw [conicIdealC, generatorsC, Matrix.range_cons, Matrix.range_cons, Matrix.range_empty,
    Set.union_empty, Set.singleton_union]

/-- The ideal of `D` is generated by `generatorsD`. -/
theorem conicIdealD_eq_span_range : conicIdealD k = Ideal.span (Set.range (generatorsD k)) := by
  rw [conicIdealD, generatorsD, Matrix.range_cons, Matrix.range_cons, Matrix.range_empty,
    Set.union_empty, Set.singleton_union]

/-- The ideal of `C = {xy = z², w = 0}`, as a homogeneous ideal. -/
def conicHomogeneousIdealC : HomogeneousIdeal (homogeneousSubmodule (Fin 4) k) :=
  ⟨conicIdealC k, by
    rw [conicIdealC_eq_span_range]
    exact Ideal.homogeneous_span _ _ (by
      rintro _ ⟨j, rfl⟩
      exact ⟨_, generatorsC_mem k j⟩)⟩

/-- The ideal of `D = {xy = w², z = 0}`, as a homogeneous ideal. -/
def conicHomogeneousIdealD : HomogeneousIdeal (homogeneousSubmodule (Fin 4) k) :=
  ⟨conicIdealD k, by
    rw [conicIdealD_eq_span_range]
    exact Ideal.homogeneous_span _ _ (by
      rintro _ ⟨j, rfl⟩
      exact ⟨_, generatorsD_mem k j⟩)⟩

/-- **The ideal sheaf of the conic `C = {xy = z², w = 0} ⊂ ℙ³`.** -/
def idealSheafC : (projectiveThreeSpace k).IdealSheafData :=
  homogeneousIdealSheaf (homogeneousSubmodule (Fin 4) k) (conicHomogeneousIdealC k)

/-- **The ideal sheaf of the conic `D = {xy = w², z = 0} ⊂ ℙ³`.** -/
def idealSheafD : (projectiveThreeSpace k).IdealSheafData :=
  homogeneousIdealSheaf (homogeneousSubmodule (Fin 4) k) (conicHomogeneousIdealD k)

/-- The ideal sheaf of `C` is of finite type. -/
theorem isFiniteType_idealSheafC : (idealSheafC k).IsFiniteType :=
  isFiniteType_homogeneousIdealSheaf _ _ one_pos X (X_mem_one k)
    (Stacks.ProjectiveSpace.iSup_basicOpen_X_eq_top k (Fin 4)) (generatorsC k) generatorDegrees
    (generatorsC_mem k) (conicIdealC_eq_span_range k)

/-- The ideal sheaf of `D` is of finite type. -/
theorem isFiniteType_idealSheafD : (idealSheafD k).IsFiniteType :=
  isFiniteType_homogeneousIdealSheaf _ _ one_pos X (X_mem_one k)
    (Stacks.ProjectiveSpace.iSup_basicOpen_X_eq_top k (Fin 4)) (generatorsD k) generatorDegrees
    (generatorsD_mem k) (conicIdealD_eq_span_range k)

/-- **The point `P = [1 : 0 : 0 : 0]` of `ℙ³`.** -/
def pointP : projectiveThreeSpace k := coordinatePoint k 0

/-- **The point `Q = [0 : 1 : 0 : 0]` of `ℙ³`.** -/
def pointQ : projectiveThreeSpace k := coordinatePoint k 1

/-- The ideal of the coordinate point `[1 : 0 : 0 : 0]` is the ideal `(y, z, w)` of `P`. -/
theorem coordinateIdeal_zero : coordinateIdeal k (0 : Fin 4) = pointIdealP k := by
  rw [pointIdealP_eq_span_image_X, coordinateIdeal]
  congr 2
  ext i
  fin_cases i <;> simp

/-- The ideal of the coordinate point `[0 : 1 : 0 : 0]` is the ideal `(x, z, w)` of `Q`. -/
theorem coordinateIdeal_one : coordinateIdeal k (1 : Fin 4) = pointIdealQ k := by
  rw [pointIdealQ_eq_span_image_X, coordinateIdeal]
  congr 2
  ext i
  fin_cases i <;> simp

/-- The points `x` of `ℙ³` whose homogeneous prime contains the ideal of `P` are `P` alone. -/
theorem pointIdealP_le_iff (x : projectiveThreeSpace k) :
    pointIdealP k ≤ x.asHomogeneousIdeal.toIdeal ↔ x = pointP k := by
  rw [← coordinateIdeal_zero]
  exact eq_coordinatePoint_iff k 0 x

/-- The points `x` of `ℙ³` whose homogeneous prime contains the ideal of `Q` are `Q` alone. -/
theorem pointIdealQ_le_iff (x : projectiveThreeSpace k) :
    pointIdealQ k ≤ x.asHomogeneousIdeal.toIdeal ↔ x = pointQ k := by
  rw [← coordinateIdeal_one]
  exact eq_coordinatePoint_iff k 1 x

/-- `P ≠ Q`: the coordinate `x` vanishes at `Q` and not at `P`. -/
theorem pointP_ne_pointQ : pointP k ≠ pointQ k := by
  intro h
  have hQ : (X 0 : MvPolynomial (Fin 4) k) ∈ (pointQ k).asHomogeneousIdeal.toIdeal :=
    Ideal.subset_span ⟨0, by decide, rfl⟩
  rw [← h] at hQ
  exact (X_mem_span_X_image_iff.mp hQ) rfl

/-- `P` is a closed point. -/
theorem isClosed_singleton_pointP : IsClosed ({pointP k} : Set (projectiveThreeSpace k)) :=
  isClosed_singleton_coordinatePoint k 0

/-- `Q` is a closed point. -/
theorem isClosed_singleton_pointQ : IsClosed ({pointQ k} : Set (projectiveThreeSpace k)) :=
  isClosed_singleton_coordinatePoint k 1

/-- **The open `Y - {P}`.** -/
def opensAwayP : (projectiveThreeSpace k).Opens :=
  ⟨{pointP k}ᶜ, (isClosed_singleton_pointP k).isOpen_compl⟩

/-- **The open `Y - {Q}`.** -/
def opensAwayQ : (projectiveThreeSpace k).Opens :=
  ⟨{pointQ k}ᶜ, (isClosed_singleton_pointQ k).isOpen_compl⟩

/-- **The open `Y - {P, Q}`.** -/
def opensAwayPQ : (projectiveThreeSpace k).Opens :=
  ⟨{pointP k, pointQ k}ᶜ, by
    rw [Set.insert_eq]
    exact ((isClosed_singleton_pointP k).union (isClosed_singleton_pointQ k)).isOpen_compl⟩

/-- `(Y - {Q}) ∪ (Y - {P}) = Y`, since `P ≠ Q`. -/
theorem opensAwayQ_sup_opensAwayP : opensAwayQ k ⊔ opensAwayP k = ⊤ := by
  refine TopologicalSpace.Opens.ext ?_
  ext x
  simp only [opensAwayQ, opensAwayP, TopologicalSpace.Opens.coe_sup,
    TopologicalSpace.Opens.coe_mk, TopologicalSpace.Opens.coe_top, Set.mem_union,
    Set.mem_compl_iff, Set.mem_singleton_iff, Set.mem_univ, iff_true]
  by_cases hQ : x = pointQ k
  · exact Or.inr fun hP => pointP_ne_pointQ k (hP.symm.trans hQ)
  · exact Or.inl hQ

/-- `(Y - {Q}) ∩ (Y - {P}) = Y - {P, Q}`. -/
theorem opensAwayQ_inf_opensAwayP : opensAwayQ k ⊓ opensAwayP k = opensAwayPQ k := by
  refine TopologicalSpace.Opens.ext ?_
  ext x
  simp only [opensAwayQ, opensAwayP, opensAwayPQ, TopologicalSpace.Opens.coe_inf,
    TopologicalSpace.Opens.coe_mk, Set.mem_inter_iff, Set.mem_compl_iff, Set.mem_singleton_iff,
    Set.mem_insert_iff, not_or]
  exact and_comm

/-! ### `C` and `D` meet exactly in `P` and `Q` -/

/-- A point lies in the support of a sum of ideal sheaves iff it lies in both supports. -/
private theorem mem_supportSet_sup_iff {J J' : (projectiveThreeSpace k).IdealSheafData}
    (x : projectiveThreeSpace k) :
    x ∈ (J ⊔ J').supportSet ↔ x ∈ J.supportSet ∧ x ∈ J'.supportSet := by
  change x ∈ ((J ⊔ J').support : Set (projectiveThreeSpace k)) ↔ _
  rw [Scheme.IdealSheafData.support_sup, TopologicalSpace.Closeds.coe_inf]
  rfl

/-- **The support of `𝒥_C + 𝒥_D` is `{P, Q}`.** The sum of the two conic ideals is the
intersection of the ideals of `P` and `Q`, and a point containing that intersection contains one
of them, hence is `P` or `Q`. -/
theorem supportSet_idealSheafC_sup_idealSheafD :
    (idealSheafC k ⊔ idealSheafD k).supportSet = {pointP k, pointQ k} := by
  ext x
  rw [mem_supportSet_sup_iff, idealSheafC, idealSheafD, mem_supportSet_homogeneousIdealSheaf_iff,
    mem_supportSet_homogeneousIdealSheaf_iff, Set.mem_insert_iff, Set.mem_singleton_iff,
    ← pointIdealP_le_iff, ← pointIdealQ_le_iff, ← Ideal.IsPrime.inf_le x.isPrime]
  change conicIdealC k ≤ _ ∧ conicIdealD k ≤ _ ↔ _
  rw [← sup_le_iff, conicIdealC_sup_conicIdealD_eq_inf]

/-- The support of `𝒥_C + 𝒥_D` does not meet `Y - {P, Q}`. -/
theorem supportSet_idealSheafC_sup_idealSheafD_inter_opensAwayPQ :
    (idealSheafC k ⊔ idealSheafD k).supportSet ∩ (opensAwayPQ k : Set (projectiveThreeSpace k)) =
      ∅ := by
  rw [supportSet_idealSheafC_sup_idealSheafD]
  exact Set.inter_compl_self _

/-- **`C` and `D` are disjoint over `Y - {P, Q}`.** The restrictions of `𝒥_C` and `𝒥_D` to the
open subscheme `Y - {P, Q}` sum to the unit ideal sheaf. -/
theorem comap_idealSheafC_sup_comap_idealSheafD_eq_top :
    (idealSheafC k).comap (opensAwayPQ k).ι ⊔ (idealSheafD k).comap (opensAwayPQ k).ι = ⊤ := by
  rw [← Scheme.IdealSheafData.support_eq_bot_iff, Scheme.IdealSheafData.support_sup,
    Scheme.IdealSheafData.support_comap, Scheme.IdealSheafData.support_comap]
  refine TopologicalSpace.Closeds.ext ?_
  ext y
  simp only [TopologicalSpace.Closeds.coe_inf, TopologicalSpace.Closeds.coe_preimage,
    TopologicalSpace.Closeds.coe_bot, Set.mem_inter_iff, Set.mem_preimage, Set.mem_empty_iff_false,
    iff_false, not_and]
  intro hC hD
  have hmem : (opensAwayPQ k).ι y ∈ (idealSheafC k ⊔ idealSheafD k).supportSet ∩
      (opensAwayPQ k : Set (projectiveThreeSpace k)) := by
    refine ⟨(mem_supportSet_sup_iff k _).mpr ⟨hC, hD⟩, ?_⟩
    rw [← Scheme.Opens.range_ι (opensAwayPQ k)]
    exact ⟨y, rfl⟩
  rw [supportSet_idealSheafC_sup_idealSheafD_inter_opensAwayPQ] at hmem
  exact hmem

end Stacks.Examples.HironakaConicIdealSheaf

end
