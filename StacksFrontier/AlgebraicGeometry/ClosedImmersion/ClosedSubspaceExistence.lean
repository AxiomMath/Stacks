module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Abelian
public import Mathlib.Geometry.RingedSpace.LocallyRingedSpace
public import Mathlib.Topology.Sheaves.LocallySurjective
public import Mathlib.Topology.Sheaves.Sheafify
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.ClosedImmersion.ClosedSubspace
public import StacksFrontier.Topology.Sheaves.ClosedImmersion.PushforwardAlgStruct

/-!
# Existence of the closed subspace cut out by an ideal sheaf

Let `X` be a locally ringed space and let `j : J ⟶ 𝒪_X` be a monomorphism of sheaves of modules
exhibiting `J` as a locally generated sheaf of ideals. This file constructs the associated closed
subspace: its underlying space is the support of `𝒪_X / J`, its inclusion is a closed immersion,
and the ideal sheaf of that inclusion is canonically `J`, compatibly with the inclusions into the
structure sheaf.

## Main results

* `Stacks.ClosedImmersion.exists_closedSubspaceData`: the data of the associated closed subspace
  exists.
* `Stacks.ClosedImmersion.closedSubspace`: a choice of it.

## Implementation notes

The structure sheaf of the subspace is the sheafification of the quotient presheaf of `𝒪_X` by
the ideal generated by the image of `j`, restricted to the support. The fact that a sheaf whose
stalks off a closed set are terminal is a pushforward from that closed set is proved for an
arbitrary `AlgebraicStructureType`.

## References

* [Stacks Project, Tag 01HN](https://stacks.math.columbia.edu/tag/01HN)
* [Stacks Project, Tag 01C2](https://stacks.math.columbia.edu/tag/01C2)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open RingedSpaceModuleAdjunction

universe u

namespace Stacks.ClosedImmersion

variable (X : LocallyRingedSpace.{u})


/-- The support `quotientSupport X J j` of `𝒪_X / J` is closed. -/
theorem quotientSupport_isClosed
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) :
    IsClosed (quotientSupport X J j) := by
  rw [quotientSupport, show {x : X | ∀ (U : Opens X) (hx : x ∈ U) (s : J.val.obj (op U)),
      ¬ IsUnit (X.presheaf.germ U x hx (j.val.app (op U) s))} =
      ⋂ U : Opens X, ⋂ s : J.val.obj (op U),
         (X.toRingedSpace.basicOpen (j.val.app (op U) s)).carrierᶜ by
    ext x
    simp only [Set.mem_iInter, Set.mem_compl_iff]
    change (∀ (U : Opens X) (hx : x ∈ U) (s : J.val.obj (op U)),
      ¬ IsUnit (X.presheaf.germ U x hx (j.val.app (op U) s))) ↔
      ∀ (U : Opens X) (s : J.val.obj (op U)),
        ¬ ∃ hx : x ∈ U, IsUnit (X.presheaf.germ U x hx (j.val.app (op U) s))
    exact ⟨fun h U s ⟨hx, hu⟩ => h U hx s hu, fun h U hx s hu => h U s ⟨hx, hu⟩⟩]
  exact isClosed_iInter fun U => isClosed_iInter fun s =>
    (X.toRingedSpace.basicOpen (j.val.app (op U) s)).2.isClosed_compl

/-- If a presheaf of commutative rings `F` has terminal sections over every open neighbourhood of
`x` contained in a fixed neighbourhood `U₀`, then its stalk at `x` is terminal. -/
noncomputable def isTerminalStalkOfTerminalNeighborhood
    (F : TopCat.Presheaf CommRingCat.{u} X.toRingedSpace) (x : X)
    (U₀ : Opens X) (hx₀ : x ∈ U₀)
    (hterm : ∀ V : OpenNhds x, V.1 ≤ U₀ → IsTerminal (F.obj (op V.1))) :
    IsTerminal (TopCat.Presheaf.stalk F x) := by
  let D := (OpenNhds.inclusion x).op ⋙ F
  let V₀ : OpenNhds x := ⟨U₀, hx₀⟩
  have hV₀ : IsTerminal (D.obj (op V₀)) := hterm V₀ le_rfl
  have hV : ∀ V : OpenNhds x,
      IsTerminal (D.obj (op ⟨V.1 ⊓ U₀, ⟨V.2, hx₀⟩⟩)) :=
    fun V => hterm ⟨V.1 ⊓ U₀, ⟨V.2, hx₀⟩⟩ inf_le_right
  apply IsTerminal.ofIso hV₀
  let term_cocone : Cocone D :=
    Cocone.mk (D.obj (op V₀))
      { app := fun j => hV₀.from _
        naturality := fun _ _ _ => hV₀.hom_ext _ _ }
  refine ⟨colimit.ι D (op V₀), colimit.desc D term_cocone, ?_, ?_⟩
  · exact hV₀.hom_ext _ _
  · apply colimit.hom_ext
    intro j
    change colimit.ι D j ≫
        (colimit.desc D term_cocone ≫ colimit.ι D (op V₀)) =
      colimit.ι D j ≫ 𝟙 _
    rw [Category.comp_id]
    conv_lhs => rw [← Category.assoc, colimit.ι_desc]
    let V : OpenNhds x := ⟨j.unop.1 ⊓ U₀, ⟨j.unop.2, hx₀⟩⟩
    have hιj : colimit.ι D j =
        D.map (Quiver.Hom.op (homOfLE (show V.1 ≤ j.unop.1 from inf_le_left))) ≫
          colimit.ι D (op V) :=
      (colimit.w D _).symm
    have hι₀ : colimit.ι D (op V₀) =
        D.map (Quiver.Hom.op (homOfLE (show V.1 ≤ U₀ from inf_le_right))) ≫
          colimit.ι D (op V) :=
      (colimit.w D _).symm
    rw [hι₀, ← Category.assoc, hιj]
    exact congrArg (· ≫ _) ((hV j.unop).hom_ext _ _)

/-- The ideal of `𝒪_X(U)` generated by the image under `j` of the sections of `J` over `U`. -/
def quotientIdeal
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace))
    (U : (Opens X)ᵒᵖ) : Ideal (X.presheaf.obj U) :=
  Ideal.span (Set.range fun s : J.val.obj U => j.val.app U s)

/-- If the image under `j` of a section of `J` over `U` is a unit, then `quotientIdeal X J j U`
is the unit ideal. -/
theorem quotientIdeal_eq_top_of_unit_section
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace))
    (U : (Opens X)ᵒᵖ) (s : J.val.obj U)
    (hs : IsUnit (M := X.presheaf.obj U) (j.val.app U s)) :
    quotientIdeal X J j U = ⊤ := by
  have hmem : j.val.app U s ∈ quotientIdeal X J j U := Ideal.subset_span ⟨s, rfl⟩
  obtain ⟨t, ht⟩ := hs.exists_right_inv
  have hone : (1 : X.presheaf.obj U) ∈ quotientIdeal X J j U := by
    simpa only [ht] using Ideal.mul_mem_right t (quotientIdeal X J j U) hmem
  exact (Ideal.eq_top_iff_one _).2 hone

/-- The quotient of a commutative ring by the unit ideal is a terminal commutative ring. -/
noncomputable def terminal_commRingCat_of_quotient_by_top
    {R : Type u} [CommRing R] (I : Ideal R) (hI : I = ⊤) :
    IsTerminal (CommRingCat.of (R ⧸ I)) := by
  have : Subsingleton (R ⧸ I) := Ideal.Quotient.subsingleton_iff.mpr hI
  let e : R ⧸ I ≃+* PUnit := {
    toFun := fun _ => PUnit.unit
    invFun := fun _ => 0
    left_inv := fun _ => Subsingleton.elim _ _
    right_inv := fun _ => Subsingleton.elim _ _
    map_mul' := by intros; rfl
    map_add' := by intros; rfl }
  exact CategoryTheory.Limits.IsTerminal.ofIso CommRingCat.punitIsTerminal
    (RingEquiv.toCommRingCatIso e).symm

/-- The presheaf of commutative rings `U ↦ 𝒪_X(U) / quotientIdeal X J j U`. -/
noncomputable def quotientRingPresheaf
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) :
    TopCat.Presheaf CommRingCat.{u} X.toRingedSpace where
  obj U := CommRingCat.of (X.presheaf.obj U ⧸ quotientIdeal X J j U)
  map {U V} f := CommRingCat.ofHom <| Ideal.Quotient.lift
    (quotientIdeal X J j U)
    ((Ideal.Quotient.mk (quotientIdeal X J j V)).comp (X.presheaf.map f).hom)
    (by
      intro a ha
      apply Ideal.Quotient.eq_zero_iff_mem.mpr
      have hI : quotientIdeal X J j U ≤
          Ideal.comap (X.presheaf.map f).hom (quotientIdeal X J j V) := by
        apply Ideal.span_le.mpr
        rintro _ ⟨s, rfl⟩
        change (X.presheaf.map f).hom (j.val.app U s) ∈
          quotientIdeal X J j V
        have hn := congrArg (fun k => k.hom s) (j.val.naturality f)
        simp only [ModuleCat.comp_apply] at hn
        change (j.val.app V) (J.val.map f s) =
          (X.presheaf.map f).hom (j.val.app U s) at hn
        rw [← hn]
        exact Ideal.subset_span ⟨_, rfl⟩
      exact hI ha)
  map_id U := by
    apply CommRingCat.hom_ext
    apply Ideal.Quotient.ringHom_ext
    ext a
    simp
  map_comp f g := by
    apply CommRingCat.hom_ext
    apply Ideal.Quotient.ringHom_ext
    ext a
    simp

/-- The sheaf of commutative rings `𝒪_X / J`, the sheafification of `quotientRingPresheaf`. -/
noncomputable def quotientRingSheaf
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) :
    TopCat.Sheaf CommRingCat.{u} X.toRingedSpace :=
  (presheafToSheaf (Opens.grothendieckTopology X.toRingedSpace) CommRingCat).obj
    (quotientRingPresheaf X J j)

/-- At a point outside `quotientSupport X J j`, the stalk of `quotientRingSheaf X J j` is
terminal. -/
noncomputable def quotientRingSheaf_stalk_isTerminal_of_not_mem_support
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) (x : X)
    (hx : x ∉ quotientSupport X J j) :
    IsTerminal (TopCat.Presheaf.stalk (quotientRingSheaf X J j).obj x) := by
  have hExists : ∃ (U : Opens X) (hxU : x ∈ U)
      (s : J.val.obj (op U)), IsUnit (X.presheaf.germ U x hxU (j.val.app (op U) s)) := by
    simpa [quotientSupport] using hx
  choose U hxU s hs using hExists
  choose V i hxV hunit using X.toRingedSpace.isUnit_res_of_isUnit_germ U
    (j.val.app (op U) s) x hxU hs
  have hunitJ : IsUnit (M := X.presheaf.obj (op V))
      (j.val.app (op V) (J.val.map i.op s)) := by
    have hn := congrArg (fun k => k.hom s) (j.val.naturality i.op)
    simp only [ModuleCat.comp_apply] at hn
    change j.val.app (op V) (J.val.map i.op s) =
      (X.presheaf.map i.op).hom (j.val.app (op U) s) at hn
    rw [hn]
    exact hunit
  have hterm : ∀ W : OpenNhds x, W.1 ≤ V →
      IsTerminal ((quotientRingPresheaf X J j).obj (op W.1)) := by
    intro W hWV
    have hunitW : IsUnit (M := X.presheaf.obj (op W.1)) (j.val.app (op W.1)
        (J.val.map (homOfLE hWV).op (J.val.map i.op s))) := by
      have hres : j.val.app (op W.1)
          (J.val.map (homOfLE hWV).op (J.val.map i.op s)) =
          (X.presheaf.map (homOfLE hWV).op).hom (j.val.app (op V) (J.val.map i.op s)) :=
        congrArg (fun k => k.hom (J.val.map i.op s)) (j.val.naturality (homOfLE hWV).op)
      rw [hres]
      exact RingHom.isUnit_map _ hunitJ
    have hIW : quotientIdeal X J j (op W.1) = ⊤ :=
      quotientIdeal_eq_top_of_unit_section X J j (op W.1) _ hunitW
    exact terminal_commRingCat_of_quotient_by_top _ hIW
  have hpre : IsTerminal (TopCat.Presheaf.stalk (quotientRingPresheaf X J j) x) :=
    isTerminalStalkOfTerminalNeighborhood X (quotientRingPresheaf X J j) x V hxV hterm
  let η := CategoryTheory.toSheafify (Opens.grothendieckTopology X.toRingedSpace)
    (quotientRingPresheaf X J j)
  have hη : IsIso ((TopCat.Presheaf.stalkFunctor CommRingCat x).map η) :=
    TopCat.Presheaf.stalkFunctor_map_unit_toSheafify_isIso x CommRingCat
      (quotientRingPresheaf X J j)
  exact IsTerminal.ofIso hpre (@asIso _ _ _ _ _ hη)

/-- The stalk map of the unit of sheafification is bijective. -/
private theorem toSheafify_stalkFunctor_map_bijective
    (P : TopCat.Presheaf CommRingCat.{u} X.toRingedSpace) (x : X) :
    Function.Bijective ((TopCat.Presheaf.stalkFunctor CommRingCat x).map
      (CategoryTheory.toSheafify (Opens.grothendieckTopology X.toRingedSpace) P)).hom :=
  (ConcreteCategory.isIso_iff_bijective _).mp
    (TopCat.Presheaf.stalkFunctor_map_unit_toSheafify_isIso x CommRingCat P)

/-- At a point of `quotientSupport X J j`, the stalk of `quotientRingPresheaf X J j` is a
nontrivial ring. -/
theorem quotientRingPresheaf_stalk_nontrivial
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) (x : X)
    (hx : x ∈ quotientSupport X J j) :
    Nontrivial (TopCat.Presheaf.stalk (C := CommRingCat)
      (quotientRingPresheaf X J j) x) := by
  classical
  let P : TopCat.Presheaf CommRingCat X.toRingedSpace := quotientRingPresheaf X J j
  have h10 : (1 : TopCat.Presheaf.stalk (C := CommRingCat) P x) ≠ 0 := by
    intro h10
    have hgerm : P.germ ⊤ x (by simp) (1 : P.obj (op ⊤)) =
        P.germ ⊤ x (by simp) 0 := by
      simpa using h10
    obtain ⟨V, hxV, i₁, i₂, hloc⟩ := P.germ_eq x (by simp : x ∈ (⊤ : Opens X))
      (by simp : x ∈ (⊤ : Opens X)) (1 : P.obj (op ⊤)) 0 hgerm
    have hloc' : (Ideal.Quotient.mk (quotientIdeal X J j (op V)))
        (1 : X.presheaf.obj (op V)) = 0 := by
      have hi : i₁ = i₂ := Subsingleton.elim _ _
      subst i₂
      have hqone : (1 : P.obj (op V)) = 0 := by
        simpa only [map_one, map_zero] using hloc
      change (1 : P.obj (op V)) = 0
      exact hqone
    have hmem : (1 : X.presheaf.obj (op V)) ∈ quotientIdeal X J j (op V) :=
      Ideal.Quotient.eq_zero_iff_mem.mp hloc'
    have hle : Ideal.map (X.presheaf.germ V x hxV).hom
        (quotientIdeal X J j (op V)) ≤ IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
      rw [Ideal.map_le_iff_le_comap]
      apply Ideal.span_le.mpr
      rintro _ ⟨s, rfl⟩
      change X.presheaf.germ V x hxV
          (j.val.app (op V) s) ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x)
      rw [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff]
      exact hx V hxV s
    have hone : (1 : X.presheaf.stalk x) ∈
        IsLocalRing.maximalIdeal (X.presheaf.stalk x) := by
      have hm := hle (Ideal.mem_map_of_mem _ hmem)
      simp at hm
    have htop : IsLocalRing.maximalIdeal (X.presheaf.stalk x) = ⊤ :=
      (Ideal.eq_top_iff_one _).2 hone
    exact (IsLocalRing.maximalIdeal.isMaximal (X.presheaf.stalk x)).ne_top htop
  exact ⟨⟨1, 0, h10⟩⟩

/-- The quotient map from the structure presheaf of `X` to `quotientRingPresheaf X J j`. -/
def quotientRingPresheafQuotientMap
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) :
    X.presheaf ⟶ quotientRingPresheaf X J j where
  app U := CommRingCat.ofHom (Ideal.Quotient.mk (quotientIdeal X J j U))
  naturality {U V} f := by
    apply CommRingCat.hom_ext
    ext a
    change (Ideal.Quotient.mk (quotientIdeal X J j V)).comp
        (X.presheaf.map f).hom a =
      ((Ideal.Quotient.lift (quotientIdeal X J j U)
        ((Ideal.Quotient.mk (quotientIdeal X J j V)).comp (X.presheaf.map f).hom) _).comp
        (Ideal.Quotient.mk (quotientIdeal X J j U))) a
    simp only [RingHom.comp_apply, Ideal.Quotient.lift_mk]

/-- The quotient map `𝒪_X ⟶ quotientRingSheaf X J j` of sheaves of commutative rings. -/
noncomputable def quotientRingSheafMap
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) :
    X.toRingedSpace.sheaf ⟶ quotientRingSheaf X J j :=
  (TopCat.Sheaf.forget CommRingCat X.toRingedSpace).preimage
    (quotientRingPresheafQuotientMap X J j ≫
    (sheafificationAdjunction (Opens.grothendieckTopology X.toRingedSpace) CommRingCat).unit.app
        (quotientRingPresheaf X J j))

/-- The quotient map `quotientRingSheafMap X J j` is surjective on stalks. -/
theorem quotientRingSheafMap_stalk_surjective
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) (x : X) :
    Function.Surjective ((TopCat.Presheaf.stalkFunctor CommRingCat x).map
      ((TopCat.Sheaf.forget CommRingCat X.toRingedSpace).map
        (quotientRingSheafMap X J j))).hom := by
  let q₀ : (TopCat.Sheaf.forget CommRingCat.{u} X.toRingedSpace).obj
      X.toRingedSpace.sheaf ⟶
      quotientRingPresheaf X J j :=
    quotientRingPresheafQuotientMap X J j
  let η : quotientRingPresheaf X J j ⟶
      (TopCat.Sheaf.forget CommRingCat.{u} X.toRingedSpace).obj (quotientRingSheaf X J j) :=
    CategoryTheory.toSheafify (Opens.grothendieckTopology X.toRingedSpace)
      (quotientRingPresheaf X J j)
  have h0 : Function.Surjective ((TopCat.Presheaf.stalkFunctor CommRingCat x).map q₀).hom := by
    intro z
    obtain ⟨U, hxU, s, rfl⟩ := (quotientRingPresheaf X J j).exists_germ_eq z
    obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective s
    let r' : ((TopCat.Sheaf.forget CommRingCat.{u} X.toRingedSpace).obj
        X.toRingedSpace.sheaf).obj
        (op U) := by
      change X.presheaf.obj (op U)
      exact r
    refine ⟨((TopCat.Sheaf.forget CommRingCat.{u} X.toRingedSpace).obj
      X.toRingedSpace.sheaf).germ
      U x hxU r', ?_⟩
    rw [TopCat.Presheaf.stalkFunctor_map_germ_apply]
    change (quotientRingPresheaf X J j).germ U x hxU
        ((q₀.app (op U)).hom r) = _
    have hr' : (q₀.app (op U)).hom r' = s := by
      change (Ideal.Quotient.mk (quotientIdeal X J j (op U))) r = s
      exact hr
    exact congrArg (fun t => (quotientRingPresheaf X J j).germ U x hxU t) hr'
  have hηsurj : Function.Surjective
      ((TopCat.Presheaf.stalkFunctor CommRingCat x).map η).hom :=
    (toSheafify_stalkFunctor_map_bijective X _ x).2
  have hmap : (TopCat.Sheaf.forget CommRingCat X.toRingedSpace).map
      (quotientRingSheafMap X J j) = q₀ ≫ η := by
    change (TopCat.Sheaf.forget CommRingCat.{u} X.toRingedSpace).map
      ((TopCat.Sheaf.forget CommRingCat.{u} X.toRingedSpace).preimage (q₀ ≫ η)) = q₀ ≫ η
    exact Functor.map_preimage _ _
  have hcat : (TopCat.Presheaf.stalkFunctor CommRingCat x).map
      ((TopCat.Sheaf.forget CommRingCat X.toRingedSpace).map (quotientRingSheafMap X J j)) =
      ((TopCat.Presheaf.stalkFunctor CommRingCat x).map q₀) ≫
        ((TopCat.Presheaf.stalkFunctor CommRingCat x).map η) := by
    rw [hmap, Functor.map_comp]
  have hcomp : ((TopCat.Presheaf.stalkFunctor CommRingCat x).map
      ((TopCat.Sheaf.forget CommRingCat X.toRingedSpace).map
        (quotientRingSheafMap X J j))).hom =
      ((TopCat.Presheaf.stalkFunctor CommRingCat x).map η).hom.comp
        ((TopCat.Presheaf.stalkFunctor CommRingCat x).map q₀).hom := by
    calc
      _ = CommRingCat.Hom.hom
          (((TopCat.Presheaf.stalkFunctor CommRingCat x).map q₀) ≫
            ((TopCat.Presheaf.stalkFunctor CommRingCat x).map η)) := congrArg _ hcat
      _ = _ := by simp only [CommRingCat.hom_comp]
  rw [hcomp]
  exact hηsurj.comp h0

/-- At a point of `quotientSupport X J j`, the stalk of `quotientRingSheaf X J j` is a local
ring. -/
theorem quotientRingSheaf_stalk_isLocalRing_of_mem_support
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) (x : X)
    (hx : x ∈ quotientSupport X J j) :
    IsLocalRing (TopCat.Presheaf.stalk (C := CommRingCat)
      (quotientRingSheaf X J j).obj x) := by
  let P := quotientRingPresheaf X J j
  let Q := quotientRingSheaf X J j
  let η := CategoryTheory.toSheafify (Opens.grothendieckTopology X.toRingedSpace) P
  let f := ((TopCat.Presheaf.stalkFunctor CommRingCat x).map η).hom
  have hfInjective : Function.Injective f := (toSheafify_stalkFunctor_map_bijective X P x).1
  have hP : Nontrivial (TopCat.Presheaf.stalk (C := CommRingCat) P x) :=
    quotientRingPresheaf_stalk_nontrivial X J j x hx
  have hPone : (1 : TopCat.Presheaf.stalk (C := CommRingCat) P x) ≠ 0 := by
    let := hP
    exact one_ne_zero
  have hQone : (1 : TopCat.Presheaf.stalk (C := CommRingCat) Q.obj x) ≠ 0 := by
    intro h
    have heq : f 1 = f 0 := by
      rwa [map_one, map_zero]
    exact hPone (hfInjective heq)
  let : Nontrivial (TopCat.Presheaf.stalk (C := CommRingCat) Q.obj x) :=
    ⟨⟨1, 0, hQone⟩⟩
  let qx := ((TopCat.Presheaf.stalkFunctor CommRingCat x).map
    ((TopCat.Sheaf.forget CommRingCat X.toRingedSpace).map (quotientRingSheafMap X J j))).hom
  let : IsLocalRing ((TopCat.Presheaf.stalkFunctor CommRingCat x).obj
      ((TopCat.Sheaf.forget CommRingCat X.toRingedSpace).obj X.toRingedSpace.sheaf)) := by
    change IsLocalRing (X.presheaf.stalk x)
    exact X.isLocalRing x
  exact IsLocalRing.of_surjective' qx (quotientRingSheafMap_stalk_surjective X J j x)

/-- At a point of `quotientSupport X J j`, the map on stalks induced by `quotientRingSheafMap`
is a local ring homomorphism. -/
theorem quotientRingSheafMap_stalk_isLocalHom
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) (x : X)
    (hx : x ∈ quotientSupport X J j) :
    IsLocalHom (((TopCat.Presheaf.stalkFunctor CommRingCat x).map
      ((TopCat.Sheaf.forget CommRingCat X.toRingedSpace).map
        (quotientRingSheafMap X J j))).hom) := by
  let : IsLocalRing ((TopCat.Presheaf.stalkFunctor CommRingCat x).obj
      ((TopCat.Sheaf.forget CommRingCat X.toRingedSpace).obj X.toRingedSpace.sheaf)) := by
    change IsLocalRing (X.presheaf.stalk x)
    exact X.isLocalRing x
  let : IsLocalRing ((TopCat.Presheaf.stalkFunctor CommRingCat x).obj
      ((TopCat.Sheaf.forget CommRingCat X.toRingedSpace).obj (quotientRingSheaf X J j))) := by
    change IsLocalRing (TopCat.Presheaf.stalk (C := CommRingCat)
      (quotientRingSheaf X J j).obj x)
    exact quotientRingSheaf_stalk_isLocalRing_of_mem_support X J j x hx
  exact IsLocalHom.of_surjective _
    (quotientRingSheafMap_stalk_surjective X J j x)

/-- A ring isomorphism is a local homomorphism. -/
theorem quotientRingEquiv_isLocalHom
    {R S : Type u} [CommRing R] [CommRing S]
    (e : R ≃+* S) : IsLocalHom (e : R →+* S) := by
  constructor
  intro a he
  simpa using he.map e.symm

/-- Commutative rings as an `AlgebraicStructureType`, with the forgetful functor to types. -/
def commRingAlgStructure : AlgebraicStructureType.{u, u + 1} where
  C := CommRingCat.{u}
  F := CategoryTheory.forget CommRingCat

/-- The zero ring `PUnit`, a terminal object of `commRingAlgStructure`. -/
def commRingAlgStructureWithFinal : commRingAlgStructure.WithFinal where
  zero := CommRingCat.of.{u} PUnit
  isTerminal := CommRingCat.punitIsTerminal
  fZeroUnique := (inferInstance : Unique PUnit)

section ClosedSupport

universe v

open TopCat

/-- If a sheaf `G` of algebraic structures has terminal stalks at every point of an open `W`,
then `G(W)` is terminal. -/
noncomputable def closedSupport_isTerminalSections (X : TopCat.{u})
    (S : AlgebraicStructureType.{u, v}) [HasColimits S.C] (Sfinal : S.WithFinal)
    (G : TopCat.Sheaf S.C X) (W : Opens X)
    (hW : ∀ x : X, x ∈ W → Nonempty (TopCat.Presheaf.stalk G.obj x ≅ Sfinal.zero)) :
    IsTerminal (G.obj.obj (Opposite.op W)) := by
  have hF_reflects :
    IsTerminal (S.F.obj (G.obj.obj (Opposite.op W))) → IsTerminal (G.obj.obj (Opposite.op W)) := by
    intro hFterm
    haveI : ReflectsLimit (Functor.empty S.C) S.F := reflectsLimit_of_reflectsIsomorphisms _ _
    exact IsTerminal.isTerminalOfObj S.F _ hFterm
  apply hF_reflects
  have hH_sheaf : Presheaf.IsSheaf (Opens.grothendieckTopology X) (G.obj ⋙ S.F) :=
    Presheaf.isSheaf_comp_of_isSheaf _ _ _ G.property
  set H := G.obj ⋙ S.F
  have hStalkUniq : ∀ (x : ↑X), x ∈ W → Unique (Presheaf.stalk H x) := by
    intro x hxW
    have hIso : Presheaf.stalk H x ≅ S.F.obj (Presheaf.stalk G.obj x) :=
      (preservesColimitIso S.F ((OpenNhds.inclusion x).op ⋙ G.obj)).symm
    let isoG := Classical.choice (hW x hxW)
    have hIso2 : S.F.obj (Presheaf.stalk G.obj x) ≅ S.F.obj Sfinal.zero := S.F.mapIso isoG
    have hIso3 : Presheaf.stalk H x ≅ S.F.obj Sfinal.zero := hIso ≪≫ hIso2
    exact @Equiv.unique _ _ Sfinal.fZeroUnique hIso3.toEquiv
  apply (Types.isTerminalEquivUnique _).invFun
  have hSheafH := (Presheaf.isSheaf_iff_isSheafUniqueGluing_types H).mp hH_sheaf
  have hSub : Subsingleton (H.obj (Opposite.op W)) := by
    constructor; intro a b
    apply Presheaf.section_ext ⟨H, hH_sheaf⟩ W a b
    intro x hx
    exact @Subsingleton.elim _ (hStalkUniq x hx).instSubsingleton _ _
  have hNe : Nonempty (H.obj (Opposite.op W)) := by
    have hLocal :
      ∀ (p : ↑W),
        ∃ (V : Opens ↑X) (_ : (p : ↑X) ∈ V) (_ : V ≤ W), Nonempty (H.obj (Opposite.op V)) := by
      intro ⟨x, hxW⟩
      obtain ⟨⟨V, hxV⟩, s, _⟩ :=
        Types.jointly_surjective_of_isColimit (colimit.isColimit ((OpenNhds.inclusion x).op ⋙ H))
          (hStalkUniq x hxW).default
      refine ⟨V ⊓ W, ⟨hxV, hxW⟩, inf_le_right, ?_⟩
      exact ⟨H.map (homOfLE inf_le_left).op s⟩
    choose V hxV hVW hNe' using hLocal
    have sf : ∀ (p : ↑W), H.obj (Opposite.op (V p)) := fun p => (hNe' p).some
    have hCompat : Presheaf.IsCompatible H V sf := by
      intro i j
      have hle : V i ⊓ V j ≤ W := le_trans inf_le_left (hVW i)
      have hSub' : Subsingleton (H.obj (Opposite.op (V i ⊓ V j))) := by
        constructor; intro a b
        apply Presheaf.section_ext ⟨H, hH_sheaf⟩ (V i ⊓ V j) a b
        intro x hx
        exact @Subsingleton.elim _ (hStalkUniq x (hle hx)).instSubsingleton _ _
      exact hSub'.elim _ _
    obtain ⟨s, _, _⟩ := hSheafH V sf hCompat
    have hSupV : iSup V = W := by
      apply le_antisymm
      · exact iSup_le hVW
      · intro x hxW; exact le_iSup V ⟨x, hxW⟩ (hxV ⟨x, hxW⟩)
    rw [← hSupV]; exact ⟨s⟩
  exact @Unique.mk _ (Classical.choice (hNe.map Inhabited.mk)) (fun a => hSub.elim _ _)

/-- If the sections of a sheaf `G` over `W` and over `U ⊓ W` are terminal, then the restriction
map `G(U ⊔ W) ⟶ G(U)` is an isomorphism. -/
theorem closedSupport_isIsoRestriction (X : TopCat.{u}) (S : AlgebraicStructureType.{u, v})
    [HasColimits S.C] (G : TopCat.Sheaf S.C X) (U : Opens X) (W : Opens X)
    (hW_term : IsTerminal (G.obj.obj (Opposite.op W)))
    (hUW_term : IsTerminal (G.obj.obj (Opposite.op (U ⊓ W)))) :
    IsIso (G.obj.map (homOfLE (le_sup_left : U ≤ U ⊔ W)).op) := by
  have hpb : IsLimit (G.interUnionPullbackCone U W) := G.isLimitPullbackCone U W
  let cone :
    PullbackCone (G.obj.map (homOfLE inf_le_left : (U ⊓ W) ⟶ U).op)
      (G.obj.map (homOfLE inf_le_right : (U ⊓ W) ⟶ W).op) :=
    PullbackCone.mk (𝟙 _) (hW_term.from _) (hUW_term.hom_ext _ _)
  let lift := hpb.lift cone
  have h1 : lift ≫ (G.interUnionPullbackCone U W).fst = 𝟙 _ := hpb.fac cone WalkingCospan.left
  suffices h2 : (G.interUnionPullbackCone U W).fst ≫ lift = 𝟙 _ from ⟨⟨lift, h2, h1⟩⟩
  have hlift_self : hpb.lift (G.interUnionPullbackCone U W) = 𝟙 _ := by
    symm; exact hpb.uniq _ _ (fun j => by simp)
  have hfst_lift_eq :
    (G.interUnionPullbackCone U W).fst ≫ lift = hpb.lift (G.interUnionPullbackCone U W) := by
    exact
      (hpb.uniq (G.interUnionPullbackCone U W) ((G.interUnionPullbackCone U W).fst ≫ lift)
        (fun j => by
          match j with
          | WalkingCospan.left =>
            exact
              (Category.assoc _ _ _).trans
                (((G.interUnionPullbackCone U W).fst ≫= h1).trans (Category.comp_id _))
          | WalkingCospan.right => exact hW_term.hom_ext _ _
          | WalkingCospan.one => exact hUW_term.hom_ext _ _))
  rw [hfst_lift_eq, hlift_self]

/-- A sheaf of algebraic structures on `X` whose stalks at the points outside a closed set `Z`
are terminal is isomorphic to the pushforward of a sheaf on `Z`. -/
lemma closedSupport_essImage_of_terminal_stalks
    (X : TopCat.{u}) (Z : Set X) (hZ : IsClosed Z)
    (S : AlgebraicStructureType.{u, v}) [HasColimits S.C] (Sfinal : S.WithFinal)
    (G : TopCat.Sheaf S.C X)
    (hstalk : ∀ x : X, x ∉ Z → Nonempty (TopCat.Presheaf.stalk G.obj x ≅ Sfinal.zero)) :
    (TopCat.Sheaf.pushforward S.C (Stacks.subsetInclusion X Z)).essImage G := by
  set i := Stacks.subsetInclusion X Z
  set Gi := Opens.map i
  have hZc_open : IsOpen (Zᶜ : Set X) := hZ.isOpen_compl
  set Zc : Opens X := ⟨Zᶜ, hZc_open⟩
  have hGterm : ∀ (W : Opens X), (W : Set X) ⊆ Zᶜ → IsTerminal (G.obj.obj (Opposite.op W)) :=
    fun W hW => closedSupport_isTerminalSections X S Sfinal G W (fun x hx => hstalk x (hW hx))
  have hRestrIso : ∀ U : Opens X, IsIso (G.obj.map (homOfLE (le_sup_left : U ≤ U ⊔ Zc)).op) :=
    fun U => closedSupport_isIsoRestriction X S G U Zc
      (hGterm Zc (le_refl _)) (hGterm (U ⊓ Zc) inf_le_right)
  have hsurj : Function.Surjective Gi.obj := by
    intro V
    obtain ⟨U, hU, hVU⟩ := isOpen_induced_iff.mp V.2
    exact ⟨⟨U, hU⟩, Opens.ext hVU⟩
  have sup_Zc_le_of_opensMap_le :
    ∀ (W₁ W₂ : Opens X), Gi.obj W₁ ≤ Gi.obj W₂ → W₁ ⊔ Zc ≤ W₂ ⊔ Zc := by
    intro W₁ W₂ hle x hx
    rcases hx with hx1 | hx2
    · by_cases hxZ : x ∈ Z
      · exact Or.inl (hle (show (⟨x, hxZ⟩ : Z) ∈ Gi.obj W₁ from hx1))
      · exact Or.inr hxZ
    · exact Or.inr hx2
  have sup_Zc_eq_of_opensMap_eq :
    ∀ (W₁ W₂ : Opens X), Gi.obj W₁ = Gi.obj W₂ → W₁ ⊔ Zc = W₂ ⊔ Zc := fun W₁ W₂ heq =>
    le_antisymm (sup_Zc_le_of_opensMap_le _ _ heq.le) (sup_Zc_le_of_opensMap_le _ _ heq.ge)
  let sObj : Opens (TopCat.of Z) → Opens X := fun V => (Classical.choose (hsurj V)) ⊔ Zc
  have hsObj_eq : ∀ (V : Opens (TopCat.of Z)) (W : Opens X), Gi.obj W = V → sObj V = W ⊔ Zc := by
    intro V W hW
    have hchoose := Classical.choose_spec (hsurj V)
    exact sup_Zc_eq_of_opensMap_eq _ _ (hchoose.trans hW.symm)
  have hsObj_section : ∀ V : Opens (TopCat.of Z), Gi.obj (sObj V) = V := by
    intro V
    have hchoose := Classical.choose_spec (hsurj V)
    ext ⟨x, hxZ⟩
    constructor
    · intro hx
      rcases hx with hx1 | hx2
      · have : (⟨x, hxZ⟩ : Z) ∈ (Gi.obj (Classical.choose (hsurj V)) : Set (TopCat.of Z)) := hx1
        rw [hchoose] at this; exact this
      · exact absurd hxZ hx2
    · intro hx
      left
      have : (⟨x, hxZ⟩ : Z) ∈ (V : Set (TopCat.of Z)) := hx
      rw [← hchoose] at this; exact this
  have hsObj_mono : ∀ (V₁ V₂ : Opens (TopCat.of Z)), V₁ ≤ V₂ → sObj V₁ ≤ sObj V₂ :=
    fun V₁ V₂ hle => sup_Zc_le_of_opensMap_le _ _
      (by rw [Classical.choose_spec (hsurj V₁), Classical.choose_spec (hsurj V₂)]; exact hle)
  let s : Opens (TopCat.of Z) ⥤ Opens X :=
    { obj := sObj
      map := fun {V₁ V₂} f => homOfLE (hsObj_mono V₁ V₂ (leOfHom f))
      map_id := fun _ => rfl
      map_comp := fun _ _ => rfl }
  have hs_left : ∀ U : Opens X, s.obj (Gi.obj U) = U ⊔ Zc := fun U => hsObj_eq (Gi.obj U) U rfl
  let Fpre : (Opens (TopCat.of Z))ᵒᵖ ⥤ S.C := s.op ⋙ G.obj
  have hFsheaf : Presheaf.IsSheaf (Opens.grothendieckTopology (TopCat.of Z)) Fpre := by
    have : ReflectsLimitsOfSize.{u, u} S.F := reflectsLimits_of_reflectsIsomorphisms
    apply Presheaf.isSheaf_of_isSheaf_comp (s := S.F)
    set H : (Opens X)ᵒᵖ ⥤ Type u := G.obj ⋙ S.F
    have hH_sheaf : Presheaf.IsSheaf (Opens.grothendieckTopology X) H :=
      Presheaf.isSheaf_comp_of_isSheaf _ _ _ G.property
    have hH_UG := (Presheaf.isSheaf_iff_isSheafUniqueGluing_types H).mp hH_sheaf
    apply (Presheaf.isSheaf_iff_isSheafUniqueGluing_types (X := TopCat.of Z) (s.op ⋙ H)).mpr
    have hsMeet : ∀ V₁ V₂ : Opens (TopCat.of Z), s.obj V₁ ⊓ s.obj V₂ = s.obj (V₁ ⊓ V₂) := by
      intro V₁ V₂; apply le_antisymm
      · intro x ⟨hx1, hx2⟩
        by_cases hxZ : x ∈ Z
        · have h1 : (⟨x, hxZ⟩ : Z) ∈ (Gi.obj (s.obj V₁) : Set (TopCat.of Z)) := hx1
          have h2 : (⟨x, hxZ⟩ : Z) ∈ (Gi.obj (s.obj V₂) : Set (TopCat.of Z)) := hx2
          rw [hsObj_section] at h1 h2
          have h3 : (⟨x, hxZ⟩ : Z) ∈ (Gi.obj (s.obj (V₁ ⊓ V₂)) : Set (TopCat.of Z)) := by
            rw [hsObj_section]; exact ⟨h1, h2⟩
          exact h3
        · exact (le_sup_right : Zc ≤ s.obj (V₁ ⊓ V₂)) hxZ
      · exact le_inf (s.map (homOfLE inf_le_left)).le (s.map (homOfLE inf_le_right)).le
    have hsSupNonempty :
      ∀ {ι : Type u} [Nonempty ι] (U : ι → Opens (TopCat.of Z)),
        s.obj (iSup U) = iSup (s.obj ∘ U) := by
      intro ι _ U; apply le_antisymm
      · intro x hx
        by_cases hxZ : x ∈ Z
        · have hmem : (⟨x, hxZ⟩ : Z) ∈ (Gi.obj (s.obj (iSup U)) : Set (TopCat.of Z)) := hx
          rw [hsObj_section] at hmem
          have hmem' : ∃ i, (⟨x, hxZ⟩ : Z) ∈ (U i : Set (TopCat.of Z)) := Opens.mem_iSup.mp hmem
          obtain ⟨i, hi⟩ := hmem'
          have : (⟨x, hxZ⟩ : Z) ∈ (Gi.obj (s.obj (U i)) : Set (TopCat.of Z)) := by
            rw [hsObj_section]; exact hi
          exact le_iSup (s.obj ∘ U) i this
        · exact
            le_iSup (s.obj ∘ U) (Classical.arbitrary ι)
              ((le_sup_right : Zc ≤ s.obj (U (Classical.arbitrary ι))) hxZ)
      · exact iSup_le (fun i => hsObj_mono (U i) (iSup U) (le_iSup U i))
    have hsBot : s.obj ⊥ = Zc := by
      apply le_antisymm
      · intro x hx
        by_cases hxZ : x ∈ Z
        · have hmem : (⟨x, hxZ⟩ : Z) ∈ (Gi.obj (s.obj ⊥) : Set (TopCat.of Z)) := hx
          rw [hsObj_section] at hmem; exact hmem.elim
        · exact (show x ∈ (Zc : Set X) from hxZ)
      · exact (le_sup_right : Zc ≤ s.obj ⊥)
    intro U sf sections_sf hcompat_sf
    by_cases hne : Nonempty U
    · have hSupEq : s.obj (iSup sf) = iSup (s.obj ∘ sf) := hsSupNonempty sf
      have hcompat_X : Presheaf.IsCompatible H (s.obj ∘ sf) sections_sf := by
        intro i j
        have hcij := hcompat_sf i j
        have hmeq := hsMeet (sf i) (sf j)
        have hleft :
          (Opens.infLELeft (s.obj (sf i)) (s.obj (sf j))) =
            (eqToHom hmeq ≫ s.map (Opens.infLELeft (sf i) (sf j))) :=
          Subsingleton.elim _ _
        have hright :
          (Opens.infLERight (s.obj (sf i)) (s.obj (sf j))) =
            (eqToHom hmeq ≫ s.map (Opens.infLERight (sf i) (sf j))) :=
          Subsingleton.elim _ _
        simp only [Function.comp, hleft, hright, op_comp, Functor.map_comp, eqToHom_op,
          eqToHom_map]
        exact congrArg _ hcij
      obtain ⟨t, ht_glue, ht_unique⟩ := hH_UG (s.obj ∘ sf) sections_sf hcompat_X
      let t' : (s.op ⋙ H).obj (Opposite.op (iSup sf)) := H.map (eqToHom hSupEq).op t
      refine ⟨t', fun i => ?_, fun t'' ht''_glue => ?_⟩
      · have heq_op :
          (eqToHom hSupEq).op ≫ (s.map (Opens.leSupr sf i)).op =
            (Opens.leSupr (s.obj ∘ sf) i).op := by
          apply Quiver.Hom.unop_inj; exact Subsingleton.elim _ _
        simp only [t', Functor.comp_map, Functor.op_map, Quiver.Hom.unop_op]
        simp only [←
            types_comp_apply (H.map (eqToHom hSupEq).op) (H.map (s.map (Opens.leSupr sf i)).op),
          ← H.map_comp, heq_op]
        exact ht_glue i
      · have ht''_X :
          Presheaf.IsGluing H (s.obj ∘ sf) sections_sf (H.map (eqToHom hSupEq.symm).op t'') := by
          intro i
          have heq_op :
            (eqToHom hSupEq.symm).op ≫ (Opens.leSupr (s.obj ∘ sf) i).op =
              (s.map (Opens.leSupr sf i)).op := by
            apply Quiver.Hom.unop_inj; exact Subsingleton.elim _ _
          simp only [←
              types_comp_apply (H.map (eqToHom hSupEq.symm).op)
                (H.map (Opens.leSupr (s.obj ∘ sf) i).op),
            ← H.map_comp, heq_op]
          exact ht''_glue i
        have heq := ht_unique (H.map (eqToHom hSupEq.symm).op t'') ht''_X
        symm; dsimp only [t']
        rw [← heq]
        have hid :
          (eqToHom hSupEq.symm).op ≫ (eqToHom hSupEq).op = 𝟙 (Opposite.op (s.obj (iSup sf))) := by
          simp [eqToHom_op, eqToHom_trans]
        simp only [← types_comp_apply (H.map (eqToHom hSupEq.symm).op) (H.map (eqToHom hSupEq).op),
          ← H.map_comp, hid, H.map_id]
        rfl
    · have : IsEmpty U := not_nonempty_iff.mp hne
      have hiSup_bot : iSup sf = ⊥ := by
        apply le_antisymm
        · exact iSup_le (fun i => IsEmpty.elim inferInstance i)
        · exact Set.empty_subset _
      have hterm : IsTerminal (G.obj.obj (Opposite.op (s.obj ⊥))) := by
        rw [hsBot]; exact hGterm Zc (le_of_eq (show (Zc : Set X) = Zᶜ from rfl))
      have hH : Unique (H.obj (Opposite.op (s.obj ⊥))) :=
        (Types.isTerminalEquivUnique _).toFun
          (hterm.isTerminalObj S.F (G.obj.obj (Opposite.op (s.obj ⊥))))
      have hUnique : Unique ((s.op ⋙ H).obj (Opposite.op (iSup sf))) := by
        rw [hiSup_bot]
        exact hH
      exact ⟨hUnique.default, fun i => IsEmpty.elim inferInstance i,
        fun _ _ => hUnique.instSubsingleton.elim _ _⟩
  let F : TopCat.Sheaf S.C (TopCat.of Z) := ⟨Fpre, hFsheaf⟩
  let natIso : ((Sheaf.pushforward S.C i).obj F).obj ≅ G.obj := by
    refine NatIso.ofComponents (fun U => ?_) (fun {U V} f => ?_)
    · have heq : s.obj (Gi.obj U.unop) = U.unop ⊔ Zc := hs_left U.unop
      have := hRestrIso U.unop
      exact
        (G.obj.mapIso (eqToIso heq).op).symm ≪≫
          asIso (G.obj.map (homOfLE (le_sup_left : U.unop ≤ U.unop ⊔ Zc)).op)
    · change
        G.obj.map (s.map (Gi.map f.unop)).op ≫
            G.obj.map (eqToIso _).op.inv ≫ G.obj.map (homOfLE _).op =
          (G.obj.map (eqToIso _).op.inv ≫ G.obj.map (homOfLE _).op) ≫ G.obj.map f
      simp only [Category.assoc, ← G.obj.map_comp]
      exact congr_arg G.obj.map (Subsingleton.elim _ _)
  exact ⟨F, ⟨(Sheaf.forget S.C X).preimageIso natIso⟩⟩

end ClosedSupport

/-- A locally ringed space with an inducing map into `X` landing in `quotientSupport X J j`,
whose structure sheaf pushes forward to `quotientRingSheaf X J j`. -/
structure QuotientSupportSpaceData
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) where
  /-- The locally ringed space. -/
  space : LocallyRingedSpace.{u}
  /-- The continuous map from `space` to `X`. -/
  inclusion : space.toTopCat ⟶ X.toRingedSpace
  /-- The pushforward of the structure sheaf of `space` is `quotientRingSheaf X J j`. -/
  quotientSheafIso : (TopCat.Sheaf.pushforward CommRingCat inclusion).obj space.sheaf ≅
    quotientRingSheaf X J j
  /-- The map `inclusion` is inducing. -/
  inclusion_inducing : Topology.IsInducing inclusion.hom
  /-- The map `inclusion` lands in `quotientSupport X J j`. -/
  inclusion_mem_support : ∀ z : space, inclusion z ∈ quotientSupport X J j

/-- A choice of `QuotientSupportSpaceData X J j` whose underlying space is the subspace
`quotientSupport X J j` of `X`. -/
noncomputable def quotientSupportSpaceData
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) :
    QuotientSupportSpaceData X J j := by
  classical
  let Z := quotientSupport X J j
  let Q := quotientRingSheaf X J j
  let i := Stacks.subsetInclusion X.toRingedSpace Z
  letI : HasColimits commRingAlgStructure.C := by
    change HasColimits CommRingCat.{u}
    infer_instance
  have hZ : IsClosed Z := quotientSupport_isClosed X J j
  have hess : (TopCat.Sheaf.pushforward CommRingCat i).essImage Q := by
    apply closedSupport_essImage_of_terminal_stalks X.toRingedSpace Z hZ
      (commRingAlgStructure.{u}) (commRingAlgStructureWithFinal.{u}) Q
    intro x hx
    exact ⟨(quotientRingSheaf_stalk_isTerminal_of_not_mem_support X J j x hx).uniqueUpToIso
      commRingAlgStructureWithFinal.isTerminal⟩
  have hData : Nonempty (Σ F : TopCat.Sheaf CommRingCat (TopCat.of Z),
      (TopCat.Sheaf.pushforward CommRingCat i).obj F ≅ Q) := by
    rcases hess with ⟨F, e⟩
    exact ⟨⟨F, Classical.choice e⟩⟩
  let d := Classical.choice hData
  let F : TopCat.Sheaf CommRingCat (TopCat.of Z) := d.1
  let e : (TopCat.Sheaf.pushforward CommRingCat i).obj F ≅ Q := d.2
  have hF_local : ∀ z : TopCat.of Z,
      IsLocalRing (TopCat.Presheaf.stalk (C := CommRingCat) F.obj z) := by
    intro z
    let hpush := TopCat.Presheaf.stalkPushforward CommRingCat i F.obj z
    have hhpush : IsIso hpush :=
      TopCat.Presheaf.stalkPushforward.stalkPushforward_iso_of_isInducing
        CommRingCat (Topology.IsInducing.subtypeVal) F.obj z
    let ePushQ := (TopCat.Presheaf.stalkFunctor CommRingCat (i.hom z)).mapIso
      ((TopCat.Sheaf.forget CommRingCat X.toRingedSpace).mapIso e)
    let eFQ : TopCat.Presheaf.stalk (C := CommRingCat) F.obj z ≅
        TopCat.Presheaf.stalk (C := CommRingCat) Q.obj (i.hom z) :=
      (asIso hpush).symm ≪≫ ePushQ
    have hQ : IsLocalRing (TopCat.Presheaf.stalk (C := CommRingCat) Q.obj (i.hom z)) :=
      quotientRingSheaf_stalk_isLocalRing_of_mem_support X J j (i.hom z) z.2
    let : IsLocalRing (TopCat.Presheaf.stalk (C := CommRingCat) Q.obj (i.hom z)) := hQ
    have hQone : (1 : TopCat.Presheaf.stalk (C := CommRingCat) Q.obj (i.hom z)) ≠ 0 :=
      one_ne_zero
    have hF_one : (1 : TopCat.Presheaf.stalk (C := CommRingCat) F.obj z) ≠ 0 := by
      intro h
      have heq : eFQ.hom.hom 1 = eFQ.hom.hom 0 := by
        rw [h]
      apply hQone
      calc
        1 = eFQ.hom.hom 1 := (map_one eFQ.hom.hom).symm
        _ = eFQ.hom.hom 0 := heq
        _ = 0 := map_zero eFQ.hom.hom
    let : Nontrivial (TopCat.Presheaf.stalk (C := CommRingCat) F.obj z) :=
      ⟨⟨1, 0, hF_one⟩⟩
    have hbij := (ConcreteCategory.isIso_iff_bijective _).mp
      (inferInstance : IsIso eFQ.hom)
    let eRing : TopCat.Presheaf.stalk (C := CommRingCat) F.obj z ≃+*
        TopCat.Presheaf.stalk (C := CommRingCat) Q.obj (i.hom z) :=
      RingEquiv.ofBijective eFQ.hom.hom hbij
    apply IsLocalRing.of_isUnit_or_isUnit_one_sub_self
    intro a
    rcases hQ.isUnit_or_isUnit_one_sub_self (eRing a) with ha | h1a
    · left
      simpa using ha.map eRing.symm
    · right
      simpa using h1a.map eRing.symm
  let L : LocallyRingedSpace.{u} :=
    { carrier := TopCat.of Z
      presheaf := F.obj
      IsSheaf := F.property
      isLocalRing := hF_local }
  refine ⟨L, i, e, ?_, ?_⟩
  · change Topology.IsInducing Subtype.val
    exact Topology.IsInducing.subtypeVal
  · intro z
    exact z.2

/-- The morphism of presheaves underlying `quotientRingSheafMap X J j`. -/
noncomputable def quotientRingSheafMapPresheaf
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) :
    X.toRingedSpace.presheaf ⟶ (quotientRingSheaf X J j).obj :=
  (TopCat.Sheaf.forget CommRingCat X.toRingedSpace).map
    (quotientRingSheafMap X J j)

/-- The morphism of presheaves from `quotientRingSheaf X J j` to the pushforward of the structure
sheaf of `D.space` underlying the inverse of `D.quotientSheafIso`. -/
noncomputable def quotientSupportSpaceIsoInvPresheaf
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace))
    (D : QuotientSupportSpaceData X J j) :
    (quotientRingSheaf X J j).obj ⟶
      (TopCat.Presheaf.pushforward CommRingCat D.inclusion).obj
        D.space.toRingedSpace.presheaf :=
  (TopCat.Sheaf.forget CommRingCat X.toRingedSpace).map D.quotientSheafIso.inv

/-- The morphism of ringed spaces `D.space ⟶ X` given by `D.inclusion` and the quotient map of
structure sheaves. -/
noncomputable def quotientSupportSpaceSheafedMap
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace))
    (D : QuotientSupportSpaceData X J j) :
    D.space.toRingedSpace ⟶ X.toRingedSpace :=
  InducedCategory.homMk
    { base := D.inclusion
      c := quotientRingSheafMapPresheaf X J j ≫ quotientSupportSpaceIsoInvPresheaf X J j D }

/-- `quotientSupportSpaceSheafedMap X J j D` as a morphism of locally ringed spaces. -/
noncomputable def quotientSupportSpaceLocallyRingedMap
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace))
    (D : QuotientSupportSpaceData X J j) : D.space ⟶ X := by
  refine ⟨(quotientSupportSpaceSheafedMap X J j D).hom, ?_⟩
  intro z
  let x := D.inclusion z
  let qx := (TopCat.Presheaf.stalkFunctor CommRingCat x).map
    (quotientRingSheafMapPresheaf X J j)
  let ex := (TopCat.Presheaf.stalkFunctor CommRingCat x).map
    (quotientSupportSpaceIsoInvPresheaf X J j D)
  let px := D.space.toRingedSpace.presheaf.stalkPushforward CommRingCat D.inclusion z
  have heq : (quotientSupportSpaceSheafedMap X J j D).hom.stalkMap z =
      qx ≫ ex ≫ px := by
    change (TopCat.Presheaf.stalkFunctor CommRingCat x).map
        (quotientRingSheafMapPresheaf X J j ≫ quotientSupportSpaceIsoInvPresheaf X J j D) ≫
          px = qx ≫ ex ≫ px
    rw [Functor.map_comp]
    rfl
  let : IsLocalRing (X.toRingedSpace.presheaf.stalk x) := X.isLocalRing x
  let Q := quotientRingSheaf X J j
  let : IsLocalRing ((TopCat.Presheaf.stalkFunctor CommRingCat x).obj
      Q.obj) := by
    change IsLocalRing (TopCat.Presheaf.stalk (C := CommRingCat)
      Q.obj x)
    exact quotientRingSheaf_stalk_isLocalRing_of_mem_support X J j x
      (D.inclusion_mem_support z)
  let : IsLocalRing (D.space.toRingedSpace.presheaf.stalk z) := D.space.isLocalRing z
  have hqx : IsLocalHom qx.hom := quotientRingSheafMap_stalk_isLocalHom X J j x
    (D.inclusion_mem_support z)
  let : IsLocalHom qx.hom := hqx
  have hex : IsIso ex := by
    let F := TopCat.Sheaf.forget CommRingCat X.toRingedSpace
    let eInv := (F.mapIso D.quotientSheafIso).symm
    have h₂ : IsIso (F.map D.quotientSheafIso.inv) := by
      change IsIso eInv.hom
      exact Iso.isIso_hom eInv
    let : IsIso (F.map D.quotientSheafIso.inv) := h₂
    let eStalk := (TopCat.Presheaf.stalkFunctor CommRingCat x).mapIso eInv
    change IsIso eStalk.hom
    exact Iso.isIso_hom eStalk
  have hpx : IsIso px := by
    dsimp [px]
    exact TopCat.Presheaf.stalkPushforward.stalkPushforward_iso_of_isInducing
      CommRingCat D.inclusion_inducing D.space.sheaf.obj z
  let exEquiv : _ ≃+* _ := RingEquiv.ofBijective ex.hom
    ((ConcreteCategory.isIso_iff_bijective _).mp hex)
  let pxEquiv : _ ≃+* _ := RingEquiv.ofBijective px.hom
    ((ConcreteCategory.isIso_iff_bijective _).mp hpx)
  have hpushLocal : IsLocalRing ((TopCat.Presheaf.stalkFunctor CommRingCat x).obj
      ((TopCat.Presheaf.pushforward CommRingCat D.inclusion).obj
        D.space.toRingedSpace.presheaf)) := by
    let : IsLocalRing ((TopCat.Presheaf.stalkFunctor CommRingCat z).obj
        D.space.toRingedSpace.presheaf) := by
      change IsLocalRing (D.space.toRingedSpace.presheaf.stalk z)
      exact D.space.isLocalRing z
    exact RingEquiv.isLocalRing pxEquiv.symm
  let : IsLocalRing ((TopCat.Presheaf.stalkFunctor CommRingCat x).obj
      ((TopCat.Presheaf.pushforward CommRingCat D.inclusion).obj
        D.space.toRingedSpace.presheaf)) := hpushLocal
  have hEx : IsLocalHom ex.hom := quotientRingEquiv_isLocalHom exEquiv
  have hPx : IsLocalHom px.hom := quotientRingEquiv_isLocalHom pxEquiv
  let : IsLocalHom ex.hom := hEx
  let : IsLocalHom px.hom := hPx
  rw [heq]
  change IsLocalHom ((px.hom).comp ((ex.hom).comp qx.hom))
  constructor
  intro a ha
  change IsUnit (px.hom (ex.hom (qx.hom a))) at ha
  have h₁ : IsUnit (ex.hom (qx.hom a)) := hPx.map_nonunit _ ha
  have h₂ : IsUnit (qx.hom a) := hEx.map_nonunit _ h₁
  exact hqx.map_nonunit _ h₂

/-- A section of `𝒪_X` lies in `quotientIdeal X J j U` exactly when it is the image under `j` of
a section of `J`. -/
theorem mem_quotientIdeal_iff
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace))
    (U : (Opens X)ᵒᵖ) (r : X.presheaf.obj U) :
    r ∈ quotientIdeal X J j U ↔ ∃ s, j.val.app U s = r := by
  change r ∈ Submodule.span ((structureSheafRing X.toRingedSpace).obj.obj U)
    (Set.range (j.val.app U)) ↔ _
  rw [show Submodule.span ((structureSheafRing X.toRingedSpace).obj.obj U)
      (Set.range (j.val.app U)) = (j.val.app U).hom.range from
    Submodule.span_eq (j.val.app U).hom.range]
  rfl

/-- A locally surjective morphism of sheaves of `𝒪_X`-modules is an epimorphism. -/
theorem module_epi_of_locally_surjective
    {M N : SheafOfModules.{u} (structureSheafRing X.toRingedSpace)} (f : M ⟶ N)
    (hf : TopCat.Presheaf.IsLocallySurjective
      ((PresheafOfModules.toPresheaf _).map f.val)) : Epi f := by
  have : Sheaf.IsLocallySurjective ((SheafOfModules.toSheaf _).map f) := hf
  exact (SheafOfModules.toSheaf _).epi_of_epi_map (inferInstance)

/-- `quotientRingSheafMapPresheaf X J j` is the quotient map `quotientRingPresheafQuotientMap`
followed by the unit of sheafification. -/
theorem quotientRingSheafMapPresheaf_eq
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) :
    quotientRingSheafMapPresheaf X J j = quotientRingPresheafQuotientMap X J j ≫
      CategoryTheory.toSheafify (Opens.grothendieckTopology X.toRingedSpace)
        (quotientRingPresheaf X J j) :=
  Functor.map_preimage (TopCat.Sheaf.forget CommRingCat X.toRingedSpace) _

/-- The quotient map `quotientRingSheafMapPresheaf X J j` vanishes on the image of `j`. -/
theorem quotientRingSheafMap_zero
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace))
    (U : (Opens X)ᵒᵖ) (s : J.val.obj U) :
    (quotientRingSheafMapPresheaf X J j).app U (j.val.app U s) = 0 := by
  rw [quotientRingSheafMapPresheaf_eq]
  change (CategoryTheory.toSheafify (Opens.grothendieckTopology X.toRingedSpace)
      (quotientRingPresheaf X J j)).app U
      (Ideal.Quotient.mk (quotientIdeal X J j U) (j.val.app U s)) = 0
  have hz : Ideal.Quotient.mk (quotientIdeal X J j U) (j.val.app U s) = 0 :=
    Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨s, rfl⟩)
  exact (congrArg ((CategoryTheory.toSheafify
    (Opens.grothendieckTopology X.toRingedSpace) (quotientRingPresheaf X J j)).app U) hz).trans
      (map_zero ((CategoryTheory.toSheafify
        (Opens.grothendieckTopology X.toRingedSpace) (quotientRingPresheaf X J j)).app U).hom)

/-- A section of `𝒪_X` killed by `quotientRingSheafMapPresheaf X J j` lies, near every point of
its domain, in the image of `j`. -/
theorem quotientRingSheafMap_locally_exact
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace))
    (U : Opens X) (r : X.presheaf.obj (op U))
    (hr : (quotientRingSheafMapPresheaf X J j).app (op U) r = 0)
    (x : X) (hx : x ∈ U) :
    ∃ (V : Opens X) (i : V ⟶ U), x ∈ V ∧
      ∃ s, j.val.app (op V) s = X.presheaf.map i.op r := by
  let P := quotientRingPresheaf X J j
  let η := CategoryTheory.toSheafify (Opens.grothendieckTopology X.toRingedSpace) P
  have hinj := (toSheafify_stalkFunctor_map_bijective X P x).1
  have hzero : P.germ U x hx (Ideal.Quotient.mk (quotientIdeal X J j (op U)) r) =
      P.germ U x hx 0 := by
    apply hinj
    have hr' : η.app (op U) ((quotientRingPresheafQuotientMap X J j).app (op U) r) = 0 := by
      rwa [quotientRingSheafMapPresheaf_eq] at hr
    exact (TopCat.Presheaf.stalkFunctor_map_germ_apply U x hx η _).trans
      ((congrArg (TopCat.Presheaf.germ
          (sheafify (Opens.grothendieckTopology X.toRingedSpace) P) U x hx)
        (hr'.trans (map_zero (η.app (op U)).hom).symm)).trans
        (TopCat.Presheaf.stalkFunctor_map_germ_apply U x hx η 0).symm)
  obtain ⟨V, hxV, i, i', hv⟩ := P.germ_eq x hx hx _ _ hzero
  refine ⟨V, i, hxV, (mem_quotientIdeal_iff X J j _ _).mp ?_⟩
  apply Ideal.Quotient.eq_zero_iff_mem.mp
  change Ideal.Quotient.mk (quotientIdeal X J j (op V)) (X.presheaf.map i.op r) = 0
  exact hv.trans (map_zero (P.map i'.op).hom)

/-- The morphism of sheaves of `𝒪_X`-modules from `𝒪_X` to the pushforward of the structure
sheaf of `D.space` along `quotientSupportSpaceLocallyRingedMap X J j D`. -/
noncomputable abbrev supportStructureMap
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace))
    (D : QuotientSupportSpaceData X J j) :=
  SheafOfModules.unitToPushforwardObjUnit
    (structureSheafHom (quotientSupportSpaceLocallyRingedMap X J j D).toShHom)

/-- On sections, `supportStructureMap X J j D` is `quotientRingSheafMapPresheaf X J j` followed
by `quotientSupportSpaceIsoInvPresheaf X J j D`. -/
theorem supportStructureMap_apply
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace))
    (D : QuotientSupportSpaceData X J j) (U : (Opens X)ᵒᵖ) (r : X.presheaf.obj U) :
    (supportStructureMap X J j D).val.app U r =
      (quotientSupportSpaceIsoInvPresheaf X J j D).app U
        ((quotientRingSheafMapPresheaf X J j).app U r) := rfl

/-- `supportStructureMap X J j D` is an epimorphism. -/
theorem supportStructureMap_epi
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace))
    (D : QuotientSupportSpaceData X J j) : Epi (supportStructureMap X J j D) := by
  apply module_epi_of_locally_surjective
  have hq : TopCat.Presheaf.IsLocallySurjective (quotientRingSheafMapPresheaf X J j) := by
    rw [TopCat.Presheaf.locally_surjective_iff_surjective_on_stalks]
    exact quotientRingSheafMap_stalk_surjective X J j
  have he : IsIso (quotientSupportSpaceIsoInvPresheaf X J j D) :=
    (TopCat.Sheaf.forget CommRingCat X.toRingedSpace).map_isIso D.quotientSheafIso.inv
  have : TopCat.Presheaf.IsLocallySurjective
      (quotientRingSheafMapPresheaf X J j ≫ quotientSupportSpaceIsoInvPresheaf X J j D) := by
    have : Presheaf.IsLocallySurjective (Opens.grothendieckTopology X.toRingedSpace)
        (quotientRingSheafMapPresheaf X J j) := hq
    have : Presheaf.IsLocallySurjective (Opens.grothendieckTopology X.toRingedSpace)
        (quotientSupportSpaceIsoInvPresheaf X J j D) :=
      Presheaf.isLocallySurjective_of_iso _ _
    exact Presheaf.isLocallySurjective_comp _ _ _
  constructor
  intro U t x hx
  obtain ⟨V, i, ⟨s, hs⟩, hxV⟩ := this.imageSieve_mem t x hx
  exact ⟨V, i, ⟨s, hs⟩, hxV⟩

/-- The composite of `j` with `supportStructureMap X J j D` is zero. -/
theorem ideal_comp_supportStructureMap
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace))
    (D : QuotientSupportSpaceData X J j) : j ≫ supportStructureMap X J j D = 0 := by
  ext U s
  change (supportStructureMap X J j D).val.app U (j.val.app U s) = 0
  exact (supportStructureMap_apply X J j D U (j.val.app U s)).trans
    ((congrArg ((quotientSupportSpaceIsoInvPresheaf X J j D).app U)
      (quotientRingSheafMap_zero X J j U s)).trans
        (map_zero ((quotientSupportSpaceIsoInvPresheaf X J j D).app U).hom))

/-- A section of `𝒪_X` killed by `supportStructureMap X J j D` lies, near every point of its
domain, in the image of `j`. -/
theorem supportStructureMap_locally_exact
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace))
    (D : QuotientSupportSpaceData X J j)
    (U : Opens X) (r : X.presheaf.obj (op U))
    (hr : (supportStructureMap X J j D).val.app (op U) r = 0)
    (x : X) (hx : x ∈ U) :
    ∃ (V : Opens X) (i : V ⟶ U), x ∈ V ∧
      ∃ s, j.val.app (op V) s = X.presheaf.map i.op r := by
  apply quotientRingSheafMap_locally_exact X J j U r _ x hx
  have he : IsIso ((quotientSupportSpaceIsoInvPresheaf X J j D).app (op U)) := by
    change IsIso (((TopCat.Sheaf.forget CommRingCat X.toRingedSpace).mapIso
      D.quotientSheafIso).inv.app (op U))
    infer_instance
  apply ((ConcreteCategory.isIso_iff_bijective _).mp he).1
  rwa [map_zero, ← supportStructureMap_apply]

/-- For a monomorphism `j`, the lift of `j` to the kernel of `supportStructureMap X J j D` is an
isomorphism. -/
theorem ideal_kernelLift_isIso
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) [Mono j]
    (D : QuotientSupportSpaceData X J j) :
    IsIso (kernel.lift (supportStructureMap X J j D) j
      (ideal_comp_supportStructureMap X J j D)) := by
  let q := supportStructureMap X J j D
  let k := kernel.lift q j (ideal_comp_supportStructureMap X J j D)
  have hk : k ≫ kernel.ι q = j := kernel.lift_ι _ _ _
  have : Mono k := mono_of_mono_fac hk
  have : Epi k := by
    apply module_epi_of_locally_surjective
    constructor
    intro U t x hx
    let r : X.presheaf.obj (op U) := (kernel.ι q).val.app (op U) t
    have hr : q.val.app (op U) r = 0 :=
      DFunLike.congr_fun (congrArg (fun f => (f.val.app (op U)).hom)
        (kernel.condition q)) t
    obtain ⟨V, i, hxV, s, hs⟩ := supportStructureMap_locally_exact X J j D U r hr x hx
    refine ⟨V, i, ⟨s, ?_⟩, hxV⟩
    have hinj : Function.Injective ((kernel.ι q).val.app (op V)) := by
      have : Mono (kernel.ι q).val :=
        (SheafOfModules.forget _).map_mono (kernel.ι q)
      exact PresheafOfModules.injective_of_mono (kernel.ι q).val (op V)
    apply hinj
    have hk' := DFunLike.congr_fun (congrArg (fun f => (f.val.app (op V)).hom) hk) s
    have hn := DFunLike.congr_fun
      (congrArg (fun f => f.hom) ((kernel.ι q).val.naturality i.op)) t
    exact hk'.trans (hs.trans hn.symm)
  exact isIso_of_mono_of_epi k

-- Prefer `hasCokernels_of_hasCoequalizers`, the instance in the statement of
-- `ClosedSubspaceData`, over `Abelian.has_cokernels`.
attribute [local instance 1100] CategoryTheory.Limits.hasCokernels_of_hasCoequalizers

/-- For a monomorphism `j : J ⟶ 𝒪_X` with `J` locally generated by sections, the data of the
associated closed subspace exists. -/
public theorem exists_closedSubspaceData
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) [Mono j]
    (hJ : Nonempty (SheafOfModules.LocalGeneratorsData.{u} J)) :
    Nonempty (ClosedSubspaceData X J j) := by
  classical
  let D := quotientSupportSpaceData X J j
  let f := quotientSupportSpaceLocallyRingedMap X J j D
  let q := supportStructureMap X J j D
  let w := ideal_comp_supportStructureMap X J j D
  have : IsIso (kernel.lift q j w) := ideal_kernelLift_isIso X J j D
  let e : J ≅ kernel q := asIso (kernel.lift q j w)
  have he : e.hom ≫ kernel.ι q = j := kernel.lift_ι q j w
  have : Epi q := supportStructureMap_epi X J j D
  let hc := Abelian.epiIsCokernelOfKernel (KernelFork.ofι j w) (kernel.isoKernel q j e he)
  let eqt := (cokernelIsCokernel j).coconePointUniqueUpToIso hc
  have hgen : Nonempty (SheafOfModules.LocalGeneratorsData.{u} (kernel q)) := by
    obtain ⟨g⟩ := hJ
    refine ⟨{
      I := g.I
      X := g.X
      coversTop := g.coversTop
      generators := fun i => ?_ }⟩
    exact (g.generators i).ofEpi ((SheafOfModules.overFunctor _ (g.X i)).map e.hom)
  refine ⟨{ space := D.space
            inclusion := f
            isClosedImmersion := ⟨?_, inferInstance, hgen⟩
            range_eq_support := ?_
            idealIso := e
            idealIso_compat := he
            quotientIso := eqt
            quotientIso_compat := ?_ }⟩
  · change Topology.IsClosedEmbedding (Subtype.val : quotientSupport X J j → X)
    exact (quotientSupport_isClosed X J j).isClosedEmbedding_subtypeVal
  · change Set.range (Subtype.val : quotientSupport X J j → X) = _
    exact Subtype.range_coe
  · exact (cokernelIsCokernel j).comp_coconePointUniqueUpToIso_hom hc WalkingParallelPair.one

/-- The closed subspace associated to a locally generated sheaf of ideals on a locally ringed
space. -/
@[stacks 01HN,
  stacks 01HM "the construction of the example: the subspace is the support of the quotient"]
public noncomputable def closedSubspace
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) [Mono j]
    (hJ : Nonempty (SheafOfModules.LocalGeneratorsData.{u} J)) :
    ClosedSubspaceData X J j := (exists_closedSubspaceData X J j hJ).some

/-- The canonical inclusion of the associated closed subspace is a closed immersion. -/
public instance closedSubspace_isClosedImmersion
    (J : SheafOfModules.{u} (structureSheafRing X.toRingedSpace))
    (j : J ⟶ SheafOfModules.unit (structureSheafRing X.toRingedSpace)) [Mono j]
    (hJ : Nonempty (SheafOfModules.LocalGeneratorsData.{u} J)) :
    IsClosedImmersion (closedSubspace X J j hJ).inclusion.toShHom :=
  (closedSubspace X J j hJ).isClosedImmersion

end Stacks.ClosedImmersion
