module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Subscheme
public import StacksFrontier.AlgebraicGeometry.Conormal.IdealLift
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The ideal sheaf of a morphism of ringed spaces and the ideal sheaf data of a scheme morphism

For a morphism of ringed spaces `j : Z ⟶ X`, `Stacks.ClosedImmersion.idealSheaf j` is the kernel
of `𝒪_X ⟶ j_* 𝒪_Z` in `CategoryTheory.SheafOfModules (structureSheafRing X)`. For a morphism of
schemes `f`, `AlgebraicGeometry.Scheme.Hom.ker f` is an `AlgebraicGeometry.Scheme.IdealSheafData`:
an ideal of `Γ(X, U)` for each affine open `U`, compatible under localization. When `f` is
quasi-compact, over an affine open `U` the sections of the ideal sheaf of `f` sit inside `Γ(X, U)`
as exactly the ideal `f.ker.ideal U`.

## Main results

* `Stacks.ClosedImmersion.mem_range_idealSheafι_val_app_iff`: for a morphism of ringed spaces,
  the sections of `𝒪_X` over an open that come from the ideal sheaf are those killed by the
  structure-sheaf map.
* `Stacks.ClosedImmersion.range_idealSheafι_val_app`: for a morphism of schemes `f`, the image of
  the sections of the ideal sheaf over `V` is the kernel of `Γ(X, V) ⟶ Γ(Z, f⁻¹V)`.
* `Stacks.ClosedImmersion.range_idealSheafι_val_app_eq_ker_ideal`: for a quasi-compact morphism
  of schemes `f` and an affine open `U`, the image of the sections of
  `Stacks.ClosedImmersion.idealSheaf f.toLRSHom.toShHom` over `U` in `Γ(X, U)` is the ideal
  `f.ker.ideal U`.
* `Stacks.ClosedImmersion.bijOn_idealSheafι_val_app`: the inclusion of the ideal sheaf is a
  bijection from its sections over an affine open `U` onto `f.ker.ideal U`.
* `Stacks.ClosedImmersion.range_idealSheafι_val_app_eq_map_of_le`: over affine opens `U ≤ V` the
  sections of the ideal sheaf over `U` are generated by the restrictions of the sections over `V`.
* `Stacks.ClosedImmersion.range_idealSheafι_val_app_subschemeι`: for `I : X.IdealSheafData`, the
  sections of the ideal sheaf of `AlgebraicGeometry.Scheme.IdealSheafData.subschemeι` over an
  affine open `U` are `I.ideal U`.
* `Stacks.ClosedImmersion.range_idealSheafι_val_app_subschemeι_pow`: the same for the subscheme
  cut out by `I ^ n`, whose sections are `I.ideal U ^ n`.
* `Stacks.ClosedImmersion.ker_ideal_le_range_idealSheafι_val_app`: without quasi-compactness,
  `f.ker.ideal U` is contained in the image of the sections of the ideal sheaf.

## References

* [Stacks Project, Tag 01C2](https://stacks.math.columbia.edu/tag/01C2)
* [Stacks Project, Tag 01R1](https://stacks.math.columbia.edu/tag/01R1)
* [Stacks Project, Tag 01R2](https://stacks.math.columbia.edu/tag/01R2)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite
open RingedSpaceModuleAdjunction

universe u

namespace Stacks.ClosedImmersion

/-! ### Sections of the ideal sheaf of a morphism of ringed spaces -/

/-- **The sections of the ideal sheaf, over an arbitrary open.** A section of `𝒪_X` over an open
`V` comes from a section of the ideal sheaf of `j : Z ⟶ X` exactly when the structure-sheaf map
of `j` kills it. -/
theorem mem_range_idealSheafι_val_app_iff {Z X : RingedSpace.{u, u}} (j : Z ⟶ X)
    (V : Opens X.carrier) (a : (SheafOfModules.unit (structureSheafRing X)).val.obj (op V)) :
    a ∈ LinearMap.range ((idealSheafι j).val.app (op V)).hom ↔
      (structureSheafModuleHom j).val.app (op V) a = 0 :=
  ⟨fun ⟨y, hy⟩ ↦ hy ▸ congr($(kernel.condition (structureSheafModuleHom j)).val.app (op V) y),
    fun h ↦ exists_idealSheaf_section_of_app_eq_zero j V a h⟩

/-- **The ideal sheaf of a morphism of ringed spaces has the pointwise kernels as its sections.**
The image in `𝒪_X(V)` of the sections over `V` of the ideal sheaf of `j` is the kernel of the
structure-sheaf map of `j` on sections over `V`. -/
theorem range_idealSheafι_val_app_eq_ker {Z X : RingedSpace.{u, u}} (j : Z ⟶ X)
    (V : Opens X.carrier) :
    LinearMap.range ((idealSheafι j).val.app (op V)).hom =
      LinearMap.ker ((structureSheafModuleHom j).val.app (op V)).hom :=
  Submodule.ext fun a ↦ mem_range_idealSheafι_val_app_iff j V a

/-! ### Sections of the ideal sheaf of a morphism of schemes -/

variable {Z X : Scheme.{u}} (f : Z ⟶ X)

/-- **The sections of the ideal sheaf of a morphism of schemes.** Over an open `V ⊆ X`, the image
in `Γ(X, V)` of the sections of `Stacks.ClosedImmersion.idealSheaf f.toLRSHom.toShHom` is the
kernel of the ring map `Γ(X, V) ⟶ Γ(Z, f⁻¹V)` induced by `f`. -/
@[sga "3 VIIA 1.3" "partial"]
theorem range_idealSheafι_val_app (V : X.Opens) :
    LinearMap.range ((idealSheafι f.toLRSHom.toShHom).val.app (op V)).hom =
      RingHom.ker (f.app V).hom :=
  Submodule.ext fun s ↦ mem_range_idealSheafι_val_app_iff f.toLRSHom.toShHom V s

/-- For a quasi-compact morphism of schemes `f : Z ⟶ X` and an affine open `U ⊆ X`, the image in
`Γ(X, U)` of the sections over `U` of the ringed-space ideal sheaf
`Stacks.ClosedImmersion.idealSheaf f.toLRSHom.toShHom` is exactly the ideal
`AlgebraicGeometry.Scheme.Hom.ker f` assigns to `U`. -/
theorem range_idealSheafι_val_app_eq_ker_ideal [QuasiCompact f] (U : X.affineOpens) :
    LinearMap.range ((idealSheafι f.toLRSHom.toShHom).val.app (op U.1)).hom = f.ker.ideal U :=
  (range_idealSheafι_val_app f U.1).trans (f.ker_apply U).symm

/-- Membership form of `Stacks.ClosedImmersion.range_idealSheafι_val_app_eq_ker_ideal`: a section
of `𝒪_X` over an affine open lies in the ideal of `AlgebraicGeometry.Scheme.Hom.ker f` there
exactly when it is the image of a section of the ideal sheaf. -/
theorem mem_ker_ideal_iff_exists_idealSheaf_section [QuasiCompact f] (U : X.affineOpens)
    (s : Γ(X, U.1)) :
    s ∈ f.ker.ideal U ↔
      ∃ y : (idealSheaf f.toLRSHom.toShHom).val.obj (op U.1),
        (idealSheafι f.toLRSHom.toShHom).val.app (op U.1) y = s :=
  SetLike.ext_iff.1 (range_idealSheafι_val_app_eq_ker_ideal f U).symm s

/-- For a quasi-compact `f` and an affine open `U`, the inclusion of the ideal sheaf into `𝒪_X`
is a bijection from the sections of `Stacks.ClosedImmersion.idealSheaf f.toLRSHom.toShHom` over
`U` onto the ideal `f.ker.ideal U`. -/
theorem bijOn_idealSheafι_val_app [QuasiCompact f] (U : X.affineOpens) :
    Set.BijOn ((idealSheafι f.toLRSHom.toShHom).val.app (op U.1)) Set.univ
      (f.ker.ideal U : Set Γ(X, U.1)) :=
  ⟨fun y _ ↦ (mem_ker_ideal_iff_exists_idealSheaf_section f U _).2 ⟨y, rfl⟩,
    (injective_idealSheafι_val_app f.toLRSHom.toShHom U.1).injOn,
    fun s hs ↦ ((mem_ker_ideal_iff_exists_idealSheaf_section f U s).1 hs).imp
      fun _ hy ↦ ⟨Set.mem_univ _, hy⟩⟩

/-- **The sections of the ideal sheaf over a smaller affine open are generated by those over a
bigger one.** For a quasi-compact `f` and affine opens `U ≤ V`, every section of
`Stacks.ClosedImmersion.idealSheaf f.toLRSHom.toShHom` over `U` is a `Γ(X, U)`-combination of
restrictions of sections over `V`. -/
theorem range_idealSheafι_val_app_eq_map_of_le [QuasiCompact f] {U V : X.affineOpens} (h : U ≤ V) :
    LinearMap.range ((idealSheafι f.toLRSHom.toShHom).val.app (op U.1)).hom =
      Ideal.map (X.presheaf.map (homOfLE h).op).hom (f.ker.ideal V) :=
  (range_idealSheafι_val_app_eq_ker_ideal f U).trans (f.ker.map_ideal h).symm

/-- Without quasi-compactness, the ideal `AlgebraicGeometry.Scheme.Hom.ker f` assigns to an
affine open `U` is contained in the image of the sections of the ideal sheaf over `U`. -/
theorem ker_ideal_le_range_idealSheafι_val_app (U : X.affineOpens) :
    f.ker.ideal U ≤ LinearMap.range ((idealSheafι f.toLRSHom.toShHom).val.app (op U.1)).hom :=
  (range_idealSheafι_val_app f U.1).ge.trans' (f.ideal_ker_le U)

/-! ### The ideal sheaf of a closed subscheme -/

/-- **The ideal sheaf of a closed subscheme is its defining ideal sheaf data.** For
`I : X.IdealSheafData` and an affine open `U ⊆ X`, the sections over `U` of the ringed-space ideal
sheaf of `AlgebraicGeometry.Scheme.IdealSheafData.subschemeι` land in `Γ(X, U)` as `I.ideal U`. -/
theorem range_idealSheafι_val_app_subschemeι (I : X.IdealSheafData) (U : X.affineOpens) :
    LinearMap.range ((idealSheafι I.subschemeι.toLRSHom.toShHom).val.app (op U.1)).hom =
      I.ideal U :=
  (range_idealSheafι_val_app_eq_ker_ideal I.subschemeι U).trans
    (congrArg (fun J : X.IdealSheafData ↦ J.ideal U) I.ker_subschemeι)

/-- **The ideal sheaf of the subscheme cut out by a power.** The sections over an affine open `U`
of the ringed-space ideal sheaf of `(I ^ n).subschemeι` land in `Γ(X, U)` as the `n`th power of
the ideal `I.ideal U`. -/
theorem range_idealSheafι_val_app_subschemeι_pow (I : X.IdealSheafData) (n : ℕ)
    (U : X.affineOpens) :
    LinearMap.range ((idealSheafι (I ^ n).subschemeι.toLRSHom.toShHom).val.app (op U.1)).hom =
      I.ideal U ^ n :=
  (range_idealSheafι_val_app_subschemeι (I ^ n) U).trans
    (congrFun (Scheme.IdealSheafData.ideal_pow (I := I) n) U)

end Stacks.ClosedImmersion

end
