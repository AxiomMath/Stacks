module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.Generators
public import Mathlib.Algebra.Category.ModuleCat.Sheaf.PullbackFree
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.EpiLocallySurjective
public import StacksFrontier.Topology.Sheaves.Functors.Module.RingedSpace
public import StacksCore.Tactic.StacksAttribute

/-!
# Closed immersions of ringed spaces

A closed immersion of ringed spaces is a morphism whose underlying continuous map is a closed
embedding, whose map on structure sheaves is surjective, and whose kernel is locally generated
by sections.

## Main definitions

* `idealSheaf i` is the kernel of `𝒪_X ⟶ i_* 𝒪_Z`, regarded as a sheaf of `𝒪_X`-modules.
* `IsClosedImmersion i` is the Stacks Project notion of a closed immersion of ringed spaces.

## Main results

* `isClosedImmersion_iff` characterizes the definition by its three constituent conditions.
* `isLocallySurjective_structureSheafHom` turns the surjectivity condition into local
  surjectivity on sections. This is the form consumers need: the condition is stated as an
  epimorphism in the category of sheaves of modules, whereas cancelling it against maps of
  sheaves of rings requires local surjectivity, and nothing in Mathlib connects the two.
* `exists_covering_structureSheafHom` is the same fact spelled out section by section.

## Implementation notes

The map of structure sheaves is regarded as a morphism of sheaves of modules via
`SheafOfModules.unitToPushforwardObjUnit`. Its surjectivity is expressed by `Epi` and local
generation of its categorical kernel by the existence of
`SheafOfModules.LocalGeneratorsData`. The class supplies the epimorphism instance, so clients
can use the structure-sheaf map directly; the closed-embedding and local-generation conditions
are exposed as projections.

The passage from `Epi` to local surjectivity is
`Stacks.SheafOfModules.EpiMono.isLocallySurjective_of_epi`. Because
`unitToPushforwardObjUnit_val_app_apply` makes the underlying map on sections of
`unitToPushforwardObjUnit (structureSheafHom i)` literally the map on sections of `i`'s
structure-sheaf component, local surjectivity here is a statement about `i` itself.

## References

* [Stacks Project, Tag 01C2](https://stacks.math.columbia.edu/tag/01C2)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace
open RingedSpaceModuleAdjunction

universe u

namespace Stacks.ClosedImmersion

/-- The ideal sheaf associated to a morphism of ringed spaces: the kernel of
`𝒪_X ⟶ i_* 𝒪_Z`, regarded as a sheaf of `𝒪_X`-modules. -/
noncomputable abbrev idealSheaf {X Z : RingedSpace.{u, u}} (i : Z ⟶ X) :
    SheafOfModules.{u} (structureSheafRing X) :=
  kernel (SheafOfModules.unitToPushforwardObjUnit (structureSheafHom i))

/-- **Stacks Project, Tag 01C2.** A morphism of ringed spaces is a closed immersion when its
underlying continuous map is a closed embedding, its map on structure sheaves is surjective,
and the kernel of that map is locally generated by sections. -/
@[stacks 01C2, stacks 01HK "the same three conditions for a morphism of locally ringed spaces"]
class IsClosedImmersion {X Z : RingedSpace.{u, u}} (i : Z ⟶ X) : Prop where
  /-- The underlying continuous map is a closed embedding. -/
  isClosedEmbedding : Topology.IsClosedEmbedding i.hom.base
  /-- The map on structure sheaves is surjective. -/
  structureSheafMap_epi :
    Epi (SheafOfModules.unitToPushforwardObjUnit (structureSheafHom i))
  /-- The kernel of the map on structure sheaves is locally generated by sections. -/
  kernel_locallyGenerated :
    Nonempty (SheafOfModules.LocalGeneratorsData.{u} (idealSheaf i))

/-- A morphism of ringed spaces is a closed immersion exactly when it satisfies the three
conditions in the definition. -/
theorem isClosedImmersion_iff {X Z : RingedSpace.{u, u}} (i : Z ⟶ X) :
    IsClosedImmersion i ↔
      Topology.IsClosedEmbedding i.hom.base ∧
        Epi (SheafOfModules.unitToPushforwardObjUnit (structureSheafHom i)) ∧
          Nonempty (SheafOfModules.LocalGeneratorsData.{u} (idealSheaf i)) :=
  ⟨fun ⟨a, b, c⟩ ↦ ⟨a, b, c⟩, fun ⟨a, b, c⟩ ↦ ⟨a, b, c⟩⟩

/-- The structure-sheaf map of a closed immersion is an epimorphism. -/
instance epi_structureSheafHom {X Z : RingedSpace.{u, u}} (i : Z ⟶ X)
    [h : IsClosedImmersion i] :
    Epi (SheafOfModules.unitToPushforwardObjUnit (structureSheafHom i)) :=
  h.structureSheafMap_epi

/-- The structure-sheaf map of a closed immersion is locally surjective on sections. This is
the usable form of the surjectivity condition: it is what lets the map be cancelled against
morphisms of sheaves of rings, which the definition's `Epi` in sheaves of modules does not
do by itself. -/
theorem isLocallySurjective_structureSheafHom {X Z : RingedSpace.{u, u}} (i : Z ⟶ X)
    [IsClosedImmersion i] :
    Presheaf.IsLocallySurjective (Opens.grothendieckTopology X.carrier)
      ((PresheafOfModules.toPresheaf (structureSheafRing X).obj).map
        (SheafOfModules.unitToPushforwardObjUnit (structureSheafHom i)).val) :=
  Stacks.SheafOfModules.EpiMono.isLocallySurjective_of_epi _

/-- Section-level form: every section of `i_* 𝒪_Z` over an open set is, after restriction to
the members of some open covering, in the image of the structure-sheaf map. -/
theorem exists_covering_structureSheafHom {X Z : RingedSpace.{u, u}} (i : Z ⟶ X)
    [IsClosedImmersion i] {V : Opens X.carrier}
    (s : ToType (((PresheafOfModules.toPresheaf (structureSheafRing X).obj).obj
      ((SheafOfModules.pushforward (structureSheafHom i)).obj
        (SheafOfModules.unit (structureSheafRing Z))).val).obj (.op V))) :
    Presheaf.imageSieve ((PresheafOfModules.toPresheaf (structureSheafRing X).obj).map
        (SheafOfModules.unitToPushforwardObjUnit (structureSheafHom i)).val) s ∈
      Opens.grothendieckTopology X.carrier V :=
  Stacks.SheafOfModules.EpiMono.imageSieve_mem_of_epi _ s

end Stacks.ClosedImmersion

end
