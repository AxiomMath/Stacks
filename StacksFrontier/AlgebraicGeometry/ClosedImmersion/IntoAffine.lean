module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.QuotientUnitQuasicoherent
public import StacksFrontier.AlgebraicGeometry.ClosedImmersion.IdealSheafAffine
public import StacksFrontier.AlgebraicGeometry.ClosedImmersion.IdealSheafUniqueness
public import StacksFrontier.AlgebraicGeometry.ClosedImmersionTFAE.Basic
public import StacksFrontier.AlgebraicGeometry.QuasicoherentExtension.Basic

/-!
# Closed immersions into an affine scheme

A closed immersion of locally ringed spaces into `Spec R` is the spectrum of a quotient of `R`
by a uniquely determined ideal. In particular the source of such a closed immersion is an affine
scheme, even though it is a priori only a locally ringed space.

## Main results

* `Stacks.ClosedImmersion.exists_ideal_tilde_iso`: a quasi-coherent ideal subsheaf of
  `𝒪_{Spec R}` is the sheaf `I^~` associated to an ideal `I` of `R`.
* `Stacks.ClosedImmersion.isQuasicoherent_of_localGenerators`: a submodule of the structure
  sheaf of an affine scheme which is locally generated by sections is quasi-coherent.
* `Stacks.ClosedImmersion.isQuasicoherent_idealSheaf_spec`: the ideal sheaf of a closed
  immersion of locally ringed spaces into `Spec R` is quasi-coherent.
* `Stacks.ClosedImmersion.existsUnique_ideal_iso_quotientSpec`: **Tag 01IH**, a closed immersion
  into `Spec R` is, over `Spec R`, the spectrum of the quotient by a unique ideal of `R`.

## Implementation notes

The ideal sheaf `I ⊆ 𝒪_{Spec R}` of the closed immersion is quasi-coherent for a reason that
does not need the source to be a scheme: the quotient `𝒪_{Spec R} / I` is quasi-coherent because
`I` is locally generated by sections
(`Stacks.SheafOfModules.isQuasicoherent_cokernel_toUnit`), and on an affine scheme the left term
of a short exact sequence whose other two terms are quasi-coherent is quasi-coherent
([Stacks, Tag 01IE]).

A quasi-coherent module on `Spec R` is `Γ(M)^~`; for an ideal subsheaf the global sections
inject into `R`, and the resulting ideal `I` is the one sought. The two closed immersions
`Z ⟶ Spec R` and `Spec (R ⧸ I) ⟶ Spec R` then have the same ideal sheaf — the second by
`Stacks.ClosedImmersion.IdealSheafAffine.exists_tilde_iso_kernel_quotUnitHom` — so they are
isomorphic over `Spec R` by `Stacks.ClosedImmersion.existsUnique_iso_of_idealSheaf_iso`.

Uniqueness of the ideal is elementary: a morphism `Spec (R ⧸ I) ⟶ Spec (R ⧸ J)` over `Spec R`
comes, `Spec` being fully faithful on locally ringed spaces, from a ring map `R ⧸ J ⟶ R ⧸ I`
compatible with the two quotient maps, which forces `J ≤ I`.

The identification of `R` with the global sections of `𝒪_{Spec R}` is the unit of the adjunction
between `~` and global sections. Its defining equation is recorded as
`Stacks.ClosedImmersion.unitSectionsIso_hom`, and the compatibility
`Stacks.ClosedImmersion.tilde_map_unitSectionsIso_hom_comp` is the left triangle identity of
that adjunction.

## References

* [Stacks Project, Tag 01IE](https://stacks.math.columbia.edu/tag/01IE)
* [Stacks Project, Tag 01IH](https://stacks.math.columbia.edu/tag/01IH)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open RingedSpaceModuleAdjunction

universe u

namespace Stacks.ClosedImmersion

variable {R : CommRingCat.{u}}

/-! ### Global sections of the structure sheaf of an affine scheme -/

/-- The canonical identification of `R` with the global sections of `𝒪_{Spec R}`, regarded as a
module over itself: the unit of the adjunction `~ ⊣ Γ`, which is an isomorphism. -/
private def unitSectionsIso (R : CommRingCat.{u}) :
    ModuleCat.of ↑R ↑R ≅ moduleSpecΓFunctor.obj (SheafOfModules.unit (Spec R).ringCatSheaf) :=
  tilde.toTildeΓNatIso.app (ModuleCat.of ↑R ↑R)

/-- Applying `~` to `Stacks.ClosedImmersion.unitSectionsIso` and composing with the counit of the
adjunction recovers the identification of `R^~` with `𝒪_{Spec R}`. This is the left triangle
identity of the adjunction `~ ⊣ Γ`. -/
private theorem tilde_map_unitSectionsIso_hom_comp (R : CommRingCat.{u}) :
    tilde.map (unitSectionsIso R).hom ≫
      Scheme.Modules.fromTildeΓ (SheafOfModules.unit (Spec R).ringCatSheaf) =
      (tildeSelf (R := R)).hom :=
  tilde.adjunction.left_triangle_components (ModuleCat.of ↑R ↑R)

/-- Naturality of the counit of the adjunction `~ ⊣ Γ`, in the shape its uses need. -/
private theorem fromTildeΓ_naturality {M N : (Spec R).Modules} (f : M ⟶ N) :
    tilde.map (moduleSpecΓFunctor.map f) ≫ Scheme.Modules.fromTildeΓ N =
      Scheme.Modules.fromTildeΓ M ≫ f :=
  Scheme.Modules.fromTildeΓNatTrans.naturality f

/-! ### Quasi-coherent ideal subsheaves of the structure sheaf of an affine scheme -/

/-- The map on global sections induced by an ideal subsheaf of `𝒪_{Spec R}`, with values in
`R`. -/
private def sectionsSubtype (J : (Spec R).Modules)
    (j : J ⟶ SheafOfModules.unit (Spec R).ringCatSheaf) :
    moduleSpecΓFunctor.obj J ⟶ ModuleCat.of ↑R ↑R :=
  moduleSpecΓFunctor.map j ≫ (unitSectionsIso R).inv

private theorem sectionsSubtype_eq (J : (Spec R).Modules)
    (j : J ⟶ SheafOfModules.unit (Spec R).ringCatSheaf) :
    sectionsSubtype J j = moduleSpecΓFunctor.map j ≫ (unitSectionsIso R).inv := rfl

/-- Global sections of an ideal subsheaf of `𝒪_{Spec R}` inject into `R`: taking global sections
is a right adjoint, hence preserves monomorphisms. -/
private theorem injective_sectionsSubtype (J : (Spec R).Modules)
    (j : J ⟶ SheafOfModules.unit (Spec R).ringCatSheaf) (hj : Mono j) :
    Function.Injective (sectionsSubtype J j).hom := by
  have : moduleSpecΓFunctor.IsRightAdjoint := ⟨tilde.functor R, ⟨tilde.adjunction⟩⟩
  have : PreservesLimitsOfShape WalkingCospan (moduleSpecΓFunctor (R := R)) :=
    tilde.adjunction.rightAdjoint_preservesLimits.preservesLimitsOfShape
  have : Mono (moduleSpecΓFunctor.map j) := preserves_mono_of_preservesLimit moduleSpecΓFunctor j
  exact (ModuleCat.mono_iff_injective (sectionsSubtype J j)).mp
    (mono_comp (moduleSpecΓFunctor.map j) (unitSectionsIso R).inv)

/-- An injective map of `R`-modules into `R` identifies its source with an ideal of `R`,
compatibly with the inclusion of that ideal. -/
private theorem exists_rangeIso_of_injective {M : ModuleCat.{u} ↑R} (φ : M ⟶ ModuleCat.of ↑R ↑R)
    (hφ : Function.Injective φ.hom) :
    ∃ (I : Ideal ↑R) (eM : ModuleCat.of ↑R I ≅ M),
      eM.hom ≫ φ = ModuleCat.ofHom (Submodule.subtype I) := by
  have hbij : Function.Bijective φ.hom.rangeRestrict :=
    ⟨fun _ _ h ↦ hφ (congrArg Subtype.val h), φ.hom.surjective_rangeRestrict⟩
  refine ⟨LinearMap.range φ.hom, (LinearEquiv.ofBijective _ hbij).symm.toModuleIso, ?_⟩
  ext x
  exact congrArg Subtype.val ((LinearEquiv.ofBijective _ hbij).apply_symm_apply x)

/-- **A quasi-coherent ideal subsheaf of `𝒪_{Spec R}` is `I^~`.** The ideal `I` is the image of
the global sections of the subsheaf in `R`, and the identification is compatible with the two
inclusions into `𝒪_{Spec R}`. -/
theorem exists_ideal_tilde_iso (J : (Spec R).Modules)
    (j : J ⟶ SheafOfModules.unit (Spec R).ringCatSheaf) (hj : Mono j)
    (hJ : J.IsQuasicoherent) :
    ∃ I : Ideal ↑R, ∃ e : tilde (ModuleCat.of ↑R I) ≅ J,
      e.hom ≫ j =
        tilde.map (ModuleCat.ofHom (Submodule.subtype I)) ≫ (tildeSelf (R := R)).hom := by
  have hiso : IsIso (Scheme.Modules.fromTildeΓ J) := inferInstance
  obtain ⟨I, eM, heM⟩ :=
    exists_rangeIso_of_injective (sectionsSubtype J j) (injective_sectionsSubtype J j hj)
  have heM' : eM.hom ≫ moduleSpecΓFunctor.map j =
      ModuleCat.ofHom (Submodule.subtype I) ≫ (unitSectionsIso R).hom := by
    rw [← heM, sectionsSubtype_eq, Category.assoc, Category.assoc, Iso.inv_hom_id,
      Category.comp_id]
  have hmaps : tilde.map eM.hom ≫ tilde.map (moduleSpecΓFunctor.map j) =
      tilde.map (ModuleCat.ofHom (Submodule.subtype I)) ≫
        tilde.map (unitSectionsIso R).hom := by
    rw [← tilde.map_comp, ← tilde.map_comp, heM']
  refine ⟨I, (tilde.functor R).mapIso eM ≪≫
    @asIso _ _ _ _ (Scheme.Modules.fromTildeΓ J) hiso, ?_⟩
  exact (Category.assoc _ _ _).trans
    ((congrArg (fun z ↦ tilde.map eM.hom ≫ z) (fromTildeΓ_naturality j).symm).trans
      (((Category.assoc _ _ _).symm.trans
          ((congrArg (fun z ↦ z ≫ Scheme.Modules.fromTildeΓ
              (SheafOfModules.unit (Spec R).ringCatSheaf)) hmaps).trans
            (Category.assoc _ _ _))).trans
        (congrArg (fun z ↦ tilde.map (ModuleCat.ofHom (Submodule.subtype I)) ≫ z)
          (tilde_map_unitSectionsIso_hom_comp R))))

/-! ### Quasi-coherence of the ideal sheaf -/

/-- **A locally generated submodule of the structure sheaf of an affine scheme is
quasi-coherent.** The quotient by the submodule is quasi-coherent because the submodule is
locally generated by sections, and the submodule is then the left term of a short exact sequence
on an affine scheme whose other two terms are quasi-coherent. -/
theorem isQuasicoherent_of_localGenerators {X : Scheme.{u}} [IsAffine X] {J : X.Modules}
    (j : J ⟶ SheafOfModules.unit X.ringCatSheaf) (hj : Mono j) (G : J.LocalGeneratorsData) :
    J.IsQuasicoherent := by
  let S : ShortComplex X.Modules := ShortComplex.mk j (cokernel.π j) (cokernel.condition j)
  have : S.X₃.IsQuasicoherent := Stacks.SheafOfModules.isQuasicoherent_cokernel_toUnit j G
  exact Stacks.AlgebraicGeometry.QuasicoherentExtension.isQuasicoherent_left_of_shortExact S
    (.mk' (ShortComplex.exact_of_g_is_cokernel S (cokernelIsCokernel j)) hj coequalizer.π_epi)

/-- **The ideal sheaf of a closed immersion of locally ringed spaces into `Spec R` is
quasi-coherent.** -/
theorem isQuasicoherent_idealSheaf_spec {Z : LocallyRingedSpace.{u}}
    (i : Z ⟶ (Spec R).toLocallyRingedSpace) [hi : IsClosedImmersion i.toShHom] :
    (idealSheaf i.toShHom).IsQuasicoherent :=
  isQuasicoherent_of_localGenerators (X := Spec R) (J := idealSheaf i.toShHom)
    (kernel.ι (SheafOfModules.unitToPushforwardObjUnit (structureSheafHom i.toShHom)))
    equalizer.ι_mono hi.kernel_locallyGenerated.some

/-- The affine case of [Stacks, Tag 01IN], in the shape the classification needs: the ideal
sheaf of `Spec (R ⧸ I) ⟶ Spec R` is `I^~`. -/
private theorem exists_idealSheaf_quotientSpec_iso (I : Ideal ↑R) :
    ∃ e : tilde (ModuleCat.of ↑R I) ≅
        idealSheaf (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).toLRSHom.toShHom,
      e.hom ≫ kernel.ι (SheafOfModules.unitToPushforwardObjUnit (structureSheafHom
          (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).toLRSHom.toShHom)) =
        tilde.map (ModuleCat.ofHom (Submodule.subtype I)) ≫ (tildeSelf (R := R)).hom :=
  IdealSheafAffine.exists_tilde_iso_kernel_quotUnitHom I

/-- Two isomorphisms `e`, `e'` out of the same object, compatible with maps `f`, `f'` to a common
target, give `(e'.symm ≪≫ e).hom ≫ f = f'`. -/
private theorem symm_trans_hom_comp_eq {C : Type*} [Category C] {A B B' T : C}
    (e : A ≅ B) (e' : A ≅ B') (f : B ⟶ T) (f' : B' ⟶ T) (h : e.hom ≫ f = e'.hom ≫ f') :
    (e'.symm ≪≫ e).hom ≫ f = f' := by
  rw [Iso.trans_hom, Iso.symm_hom, Category.assoc, h, Iso.inv_hom_id_assoc]

/-! ### Uniqueness of the ideal -/

/-- A morphism `Spec (R ⧸ I) ⟶ Spec (R ⧸ J)` over `Spec R` forces `J ≤ I`. -/
private theorem le_of_quotientSpec_hom (I J : Ideal ↑R)
    (f : (Spec (CommRingCat.of (↑R ⧸ I))).toLocallyRingedSpace ⟶
      (Spec (CommRingCat.of (↑R ⧸ J))).toLocallyRingedSpace)
    (hf : f ≫ (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk J))).toLRSHom =
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).toLRSHom) :
    J ≤ I := by
  have hmap : Spec.toLocallyRingedSpace.map (Spec.fullyFaithfulToLocallyRingedSpace.preimage f ≫
        Opposite.op (CommRingCat.ofHom (Ideal.Quotient.mk J))) =
      Spec.toLocallyRingedSpace.map
        (Opposite.op (CommRingCat.ofHom (Ideal.Quotient.mk I))) := by
    rw [Spec.toLocallyRingedSpace.map_comp,
      Spec.fullyFaithfulToLocallyRingedSpace.map_preimage f]
    exact hf
  have hring : CommRingCat.ofHom (Ideal.Quotient.mk J) ≫
      (Spec.fullyFaithfulToLocallyRingedSpace.preimage f).unop =
      CommRingCat.ofHom (Ideal.Quotient.mk I) := by
    simpa using congrArg Quiver.Hom.unop (Spec.toLocallyRingedSpace.map_injective hmap)
  intro x hx
  refine Ideal.Quotient.eq_zero_iff_mem.1 ?_
  have h := congrArg (fun g : R ⟶ CommRingCat.of (↑R ⧸ I) ↦ g.hom x) hring
  simpa [Ideal.Quotient.eq_zero_iff_mem.2 hx] using h.symm

/-! ### The classification of closed immersions into an affine scheme -/

/-- A closed immersion of locally ringed spaces into `Spec R` is, over `Spec R`, the spectrum of
the quotient by a unique ideal of `R`. -/
@[stacks 01IH]
theorem existsUnique_ideal_iso_quotientSpec {Z : LocallyRingedSpace.{u}}
    (i : Z ⟶ (Spec R).toLocallyRingedSpace) [IsClosedImmersion i.toShHom] :
    ∃! I : Ideal ↑R, ∃ e : Z ≅ (Spec (CommRingCat.of (↑R ⧸ I))).toLocallyRingedSpace,
      i = e.hom ≫ (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).toLRSHom := by
  obtain ⟨I, eI, heI⟩ := exists_ideal_tilde_iso (idealSheaf i.toShHom)
    (kernel.ι (SheafOfModules.unitToPushforwardObjUnit (structureSheafHom i.toShHom)))
    equalizer.ι_mono (isQuasicoherent_idealSheaf_spec i)
  obtain ⟨eq, heq⟩ := exists_idealSheaf_quotientSpec_iso (R := R) I
  have hci : AlgebraicGeometry.IsClosedImmersion
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))) := inferInstance
  have hq : IsClosedImmersion
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).toLRSHom.toShHom :=
    ((Stacks.AlgebraicGeometry.ClosedImmersionTFAE.closedImmersion_tfae
      (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I)))).out 1 6).mp hci
  obtain ⟨e, he, -⟩ := existsUnique_iso_of_idealSheaf_iso i
    (Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk I))).toLRSHom (eI.symm ≪≫ eq)
    (symm_trans_hom_comp_eq _ _ _ _ (heq.trans heI.symm))
  refine ⟨I, ⟨e, he.symm⟩, ?_⟩
  rintro I' ⟨e', he'⟩
  exact le_antisymm
    (le_of_quotientSpec_hom I I' _ (symm_trans_hom_comp_eq _ _ _ _ (he'.symm.trans he.symm)))
    (le_of_quotientSpec_hom I' I _ (symm_trans_hom_comp_eq _ _ _ _ (he.trans he')))

end Stacks.ClosedImmersion

end
