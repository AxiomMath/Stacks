module

public import StacksFrontier.AlgebraicGeometry.LimitIndexUniverseIntegral.Affine

/-!
# Sections of a limit of affine schemes at a free index universe: the surjective half

For an inverse system of **affine** schemes indexed by (the opposite of) a directed preorder in
the schemes' own universe, Mathlib's
`AlgebraicGeometry.exists_appTop_π_eq_of_isAffine_of_isLimit` says that every global section of
the limit comes from a stage, and
`AlgebraicGeometry.exists_appTop_map_eq_zero_of_isAffine_of_isLimit` says that a stage section
vanishing in the limit already vanishes at a later stage. Together they are
`Γ(\lim X_i, ⊤) = \colim_i Γ(X_i, ⊤)`, i.e. the structure-sheaf case of [Stacks, Tag 01Z0]. Both
are stated with the index category in the schemes' universe.

At a free index universe the two halves behave differently.

* **Injectivity fails.** `Stacks.Refute01Z0` gives a system of spectra of the finitely generated
  subrings of a non-`u`-small field whose limit is the **empty** scheme, so every stage section
  vanishes in the limit while the colimit of the stage rings is nonzero.
* **Injectivity holds up to a power when the transition morphisms are finite.** This is
  `Stacks.IntegralLimitAffine.exists_pow_appTop_map_eq_zero`.
* **Surjectivity holds** with no smallness or finiteness hypothesis, for affine stages and a
  directed index. This is the content of this file.

## Main definitions

* `Stacks.Tag01Z0FreeIndexSections.sectionsSubring`: the subring of `Γ(c.pt, ⊤)` generated by the
  images of the global sections of the stages.

## Main results

* `Stacks.Tag01Z0FreeIndexSections.sectionsSubring_eq_top`: for a limit cone of affine schemes at
  an arbitrary index universe, `sectionsSubring` is all of `Γ(c.pt, ⊤)`.
* `Stacks.Tag01Z0FreeIndexSections.exists_appTop_eq_of_isAffine_of_isLimit`: for a directed index,
  every global section of the limit is the image of a global section of some stage.
* `Stacks.Tag01Z0FreeIndexSections.sections_surjective_and_pow_descends`: for finite transition
  morphisms, the map from the stage sections to `Γ(c.pt, ⊤)` is onto, and a stage section
  vanishing in the limit has a positive power vanishing at a later stage.

## Implementation notes

Let `L'` be the subring of `Γ(c.pt, ⊤)` generated by the images of the stages. The corestricted
maps form a cone with vertex `Spec L'`, and the limit factors it as `Spec L' ⟶ c.pt`, while the
inclusion `L' ↪ Γ(c.pt, ⊤)` gives `c.pt ⟶ Spec L'`. The composite `c.pt ⟶ Spec L' ⟶ c.pt` agrees
with the identity on every cone projection, so it is the identity, and the underlying ring map
exhibits every section of `c.pt` as an element of `L'`.

## References

* [The Stacks Project, Tag 01Z0](https://stacks.math.columbia.edu/tag/01Z0)
-/

@[expose] public section

noncomputable section

universe w u

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite

namespace Stacks.Tag01Z0FreeIndexSections

open Stacks.IntegralLimitAffine

variable {I : Type w} [Preorder I] (D : Iᵒᵖ ⥤ Scheme.{u}) (c : Cone D)

/-- The subring of the global sections of the vertex of a cone generated by the images of the
global sections of all the stages. -/
def sectionsSubring : Subring ↥Γ(c.pt, ⊤) :=
  ⨆ i : I, (sectionsCocone D c i).range

/-- The image of a global section of a stage lies in `sectionsSubring`. -/
theorem mem_sectionsSubring (i : I) (x : ↥Γ(D.obj (op i), ⊤)) :
    sectionsCocone D c i x ∈ sectionsSubring D c :=
  le_iSup (fun i : I ↦ (sectionsCocone D c i).range) i (RingHom.mem_range.mpr ⟨x, rfl⟩)

/-- The cocone on the global sections of the stages, corestricted to the subring its images
generate. -/
def sectionsCoconeRestrict (i : I) :
    ↥Γ(D.obj (op i), ⊤) →+* ↥(sectionsSubring D c) :=
  (sectionsCocone D c i).codRestrict (sectionsSubring D c) (mem_sectionsSubring D c i)

/-- The underlying element of `sectionsCoconeRestrict D c i x` is `sectionsCocone D c i x`. -/
@[simp] theorem coe_sectionsCoconeRestrict (i : I) (x : ↥Γ(D.obj (op i), ⊤)) :
    (sectionsCoconeRestrict D c i x : ↥Γ(c.pt, ⊤)) = sectionsCocone D c i x := rfl

/-- The corestricted maps are compatible with the transition maps of the stages. -/
theorem sectionsCoconeRestrict_comp (i j : I) (h : i ≤ j) (x : ↥Γ(D.obj (op i), ⊤)) :
    sectionsCoconeRestrict D c j (sectionsMap D i j h x) = sectionsCoconeRestrict D c i x :=
  Subtype.ext (sectionsCocone_comp D c i j h x)

/-- The inclusion of the subring generated by the images into the global sections of the vertex,
as a morphism of `CommRingCat`. -/
def sectionsSubringι : CommRingCat.of ↥(sectionsSubring D c) ⟶ Γ(c.pt, ⊤) :=
  CommRingCat.ofHom (sectionsSubring D c).subtype

/-- The composite of `sectionsCoconeRestrict D c i` with `sectionsSubringι D c` is the map on
global sections of the cone projection at `i`. -/
theorem ofHom_sectionsCoconeRestrict_comp_ι (i : I) :
    CommRingCat.ofHom (sectionsCoconeRestrict D c i) ≫ sectionsSubringι D c
      = (c.π.app (op i)).appTop :=
  CommRingCat.hom_ext (RingHom.ext fun _ ↦ rfl)

/-- For a limit cone `c` of affine schemes, at an index universe independent of the schemes'
universe, the subring of `Γ(c.pt, ⊤)` generated by the images of the stages' global sections is
all of `Γ(c.pt, ⊤)`. -/
theorem sectionsSubring_eq_top [∀ i, IsAffine (D.obj i)] (hc : IsLimit c) :
    sectionsSubring D c = ⊤ := by
  have haff : IsAffine c.pt := Scheme.isAffine_of_isLimit c hc
  have hcompat : ∀ (i j : I) (h : i ≤ j) (x : ↥Γ(D.obj (op i), ⊤)),
      sectionsCoconeRestrict D c j (sectionsMap D i j h x) = sectionsCoconeRestrict D c i x :=
    sectionsCoconeRestrict_comp D c
  obtain ⟨m, hm⟩ : ∃ m : Spec (CommRingCat.of ↥(sectionsSubring D c)) ⟶ c.pt,
      ∀ X, m ≫ c.π.app X
        = (specCone D ↥(sectionsSubring D c) (sectionsCoconeRestrict D c) hcompat).π.app X :=
    ⟨hc.lift (specCone D ↥(sectionsSubring D c) (sectionsCoconeRestrict D c) hcompat),
      fun X ↦ hc.fac _ X⟩
  have hstep : Spec.map (sectionsSubringι D c) ≫ m = c.pt.isoSpec.inv := by
    refine hc.hom_ext fun X ↦ ?_
    have haffX : IsAffine (((Functor.const Iᵒᵖ).obj c.pt).obj X) := haff
    have h1 : (Spec.map (sectionsSubringι D c) ≫ m) ≫ c.π.app X
        = Spec.map (CommRingCat.ofHom (sectionsCoconeRestrict D c X.unop) ≫
            sectionsSubringι D c) ≫ (D.obj X).isoSpec.inv := by
      rw [Category.assoc, hm X, specCone_π_app, ← Category.assoc, ← Spec.map_comp]
    rw [h1, ofHom_sectionsCoconeRestrict_comp_ι D c X.unop]
    exact Scheme.isoSpec_inv_naturality (c.π.app X)
  obtain ⟨β, hβ⟩ : ∃ β : Γ(c.pt, ⊤) ⟶ CommRingCat.of ↥(sectionsSubring D c),
      Spec.map β = m ≫ c.pt.isoSpec.hom :=
    ⟨Spec.preimage _, Spec.map_preimage _⟩
  have hring : β ≫ sectionsSubringι D c = 𝟙 Γ(c.pt, ⊤) := by
    refine Spec.map_injective ?_
    rw [Spec.map_comp, Spec.map_id, hβ, ← Category.assoc, hstep, Iso.inv_hom_id]
  refine le_antisymm le_top fun x _ ↦ ?_
  have hx := congrArg (fun φ : Γ(c.pt, ⊤) ⟶ Γ(c.pt, ⊤) ↦ φ.hom x) hring
  simp only [CommRingCat.hom_comp, RingHom.coe_comp, Function.comp_apply,
    CommRingCat.hom_id, RingHom.id_apply] at hx
  rw [← hx]
  exact (β.hom x).2

/-- For a limit cone `c` of affine schemes indexed by the opposite of a nonempty directed preorder
in an arbitrary universe, every global section of `c.pt` is the image of a global section of some
stage. -/
theorem exists_appTop_eq_of_isAffine_of_isLimit [Nonempty I] [IsDirectedOrder I]
    [∀ i, IsAffine (D.obj i)] (hc : IsLimit c) (s : ↥Γ(c.pt, ⊤)) :
    ∃ (i : I) (t : ↥Γ(D.obj (op i), ⊤)), (c.π.app (op i)).appTop.hom t = s := by
  have hmono : ∀ {i j : I}, i ≤ j →
      (sectionsCocone D c i).range ≤ (sectionsCocone D c j).range := by
    intro i j h y hy
    obtain ⟨x, hx⟩ := RingHom.mem_range.mp hy
    exact RingHom.mem_range.mpr ⟨sectionsMap D i j h x, (sectionsCocone_comp D c i j h x).trans hx⟩
  have hdir : Directed (· ≤ ·) fun i : I ↦ (sectionsCocone D c i).range := by
    intro i j
    obtain ⟨k, hik, hjk⟩ := exists_ge_ge i j
    exact ⟨k, hmono hik, hmono hjk⟩
  have hs : s ∈ sectionsSubring D c := by rw [sectionsSubring_eq_top D c hc]; trivial
  obtain ⟨i, hi⟩ := (Subring.mem_iSup_of_directed hdir).mp hs
  obtain ⟨t, ht⟩ := RingHom.mem_range.mp hi
  exact ⟨i, t, ht⟩

/-- Let `D` be an inverse system of affine schemes indexed by the opposite of a nonempty directed
preorder in an arbitrary universe, with finite transition morphisms, and let `c` be a limit cone.
Then:

1. every global section of `c.pt` is the image of a global section of some stage;
2. a global section of a stage whose image in `c.pt` vanishes has a positive power vanishing at
   some later stage. -/
theorem sections_surjective_and_pow_descends [Nonempty I] [IsDirectedOrder I]
    [∀ i, IsAffine (D.obj i)] (hc : IsLimit c)
    (hfinite : ∀ (i j : I) (h : i ≤ j), IsFinite (D.map (homOfLE h).op)) :
    (∀ s : ↥Γ(c.pt, ⊤), ∃ (i : I) (t : ↥Γ(D.obj (op i), ⊤)),
        (c.π.app (op i)).appTop.hom t = s) ∧
      (∀ (i : I) (s : ↥Γ(D.obj (op i), ⊤)), (c.π.app (op i)).appTop.hom s = 0 →
        ∃ (j : I) (h : i ≤ j) (n : ℕ), 0 < n ∧
          (D.map (homOfLE h).op).appTop.hom (s ^ n) = 0) := by
  have haff : IsAffine c.pt := Scheme.isAffine_of_isLimit c hc
  refine ⟨exists_appTop_eq_of_isAffine_of_isLimit D c hc, fun i s hs ↦ ?_⟩
  exact exists_pow_appTop_map_eq_zero D c hc hfinite i s hs

end Stacks.Tag01Z0FreeIndexSections

end

end
