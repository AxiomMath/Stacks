namespace AlgebraicGeometry

/-! ### Supported sections from ideal-power torsion -/

/-- A module element killed by a unit scalar is zero. -/
private lemma eq_zero_of_isUnit_smul_eq_zero {R M : Type*} [Ring R] [AddCommGroup M]
    [Module R M] {r : R} (hr : IsUnit r) {m : M} (h : r • m = 0) : m = 0 := by
  obtain ⟨v, -, hv⟩ := isUnit_iff_exists.mp hr
  calc m = (1 : R) • m := (one_smul R m).symm
    _ = (v * r) • m := by rw [hv]
    _ = v • (r • m) := mul_smul v r m
    _ = 0 := by rw [h, smul_zero]

/-- A section killed by a power of `g` restricts to zero on the basic open set of `g`, where `g`
itself becomes invertible. -/
private lemma res_basicOpen_eq_zero_of_pow_smul_eq_zero {X : Scheme.{u}} (G : X.Modules)
    (U : X.Opens) (g : Γ(X, U)) (m : Γ(G, U)) {n : ℕ} (hm : (g ^ n) • m = 0) :
    G.val.presheaf.map (homOfLE (X.basicOpen_le g)).op m = 0 := by
  have hunit : IsUnit (X.presheaf.map (homOfLE (X.basicOpen_le g)).op g) :=
    X.toRingedSpace.isUnit_res_basicOpen g
  have key := G.val.map_smul (homOfLE (X.basicOpen_le g)).op (g ^ n) m
  have hz : (G.val.map (homOfLE (X.basicOpen_le g)).op) ((g ^ n) • m) = 0 := by
    rw [hm]
    exact map_zero _
  refine eq_zero_of_isUnit_smul_eq_zero ?_ (key.symm.trans hz)
  have h := hunit.pow n
  rw [← map_pow] at h
  exact h

/-- One direction of Tag 07ZP's torsion characterization of supported sections, the one that
needs no quasi-coherence: a section of `G` over `U` killed by a power of `g` has zero germ at
every point of `U` where `g` is invertible, hence lies in the sections supported on any `Z`
whose intersection with `U` is the zero locus of `g`. -/
private lemma mem_supportedSectionsSubmodule_of_pow_smul_eq_zero
    {X : Scheme.{u}} (G : X.Modules) {Z : Set X} (U : X.Opens) (g : Γ(X, U))
    (hZ : Z ∩ (U : Set X) = X.zeroLocus (U := U) {g} ∩ (U : Set X))
    (m : Γ(G, U)) {n : ℕ} (hm : (g ^ n) • m = 0) :
    m ∈ (supportedSectionsSubmodule Z G).toSubmodule.obj (op U) := by
  have hres := res_basicOpen_eq_zero_of_pow_smul_eq_zero G U g m hm
  rw [mem_supportedSectionsSubmodule_iff]
  intro x hx hxZ
  have hxV : x ∈ X.basicOpen g := by
    by_contra hmem
    refine hxZ (((Set.ext_iff.mp hZ x).mpr ⟨?_, hx⟩)).1
    rw [Scheme.zeroLocus_singleton]
    simpa using hmem
  calc TopCat.Presheaf.germ G.val.presheaf U x hx m
      = TopCat.Presheaf.germ G.val.presheaf (X.basicOpen g) x hxV
          (G.val.presheaf.map (homOfLE (X.basicOpen_le g)).op m) :=
        (TopCat.Presheaf.germ_res_apply G.val.presheaf
          (homOfLE (X.basicOpen_le g)) x hxV m).symm
    _ = 0 := by rw [hres, map_zero]

/-! ### The ring-theoretic core -/

/-- If the `k`th Fitting ideal of a finite module `M` is generated by `f`, the quotient of `M`
by its `f`-primary component has unit `k`th Fitting ideal. -/
private lemma fittingIdeal_quotient_primaryComponent_eq_top
    {R M : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [Module.Finite R M] (k : ℕ) (f : R)
    (hfit : _root_.fittingIdeal (R := R) (M := M) (k : ℤ) = Ideal.span {f}) :
    _root_.fittingIdeal (R := R)
      (M := M ⧸ Ideal.primaryComponent M (Ideal.span {f})) (k : ℤ) = ⊤ := by
  by_contra htop
  obtain ⟨p, hpmax, hle⟩ := Ideal.exists_le_maximal _ htop
  have : p.IsPrime := hpmax.isPrime
  have hgen := _root_.Stacks.Fitting.exists_fin_span_atPrime_quotient_primaryComponent k f hfit p
  have hnle := ((fittingIdeal_local_generation_tfae k p).out 3 1).mp hgen
  exact hnle hle

/-! ### Finiteness and surjectivity of a quotient of modules on a scheme -/

-- isFiniteType_of_epi_modules: see
-- StacksFrontier.AlgebraicGeometry.LocalCohomology.ImprovingCoherentModules.DepthTwoExtension

private lemma sections_surjective_spec {R : CommRingCat.{u}}
    {M N : (Spec R).Modules} [M.IsQuasicoherent] [N.IsQuasicoherent]
    (q : M ⟶ N) [Epi q] : Function.Surjective (q.app ⊤) := by
  have hMiso : IsIso M.fromTildeΓ := Scheme.Modules.isIso_fromTildeΓ_of_isQuasicoherent M
  have hNiso : IsIso N.fromTildeΓ := Scheme.Modules.isIso_fromTildeΓ_of_isQuasicoherent N
  have h := Scheme.Modules.fromTildeΓNatTrans.naturality q
  change (tilde.functor R).map (moduleSpecΓFunctor.map q) ≫ N.fromTildeΓ =
    M.fromTildeΓ ≫ q at h
  have hrhs : Epi (M.fromTildeΓ ≫ q) := by
    have : Epi M.fromTildeΓ := IsIso.epi_of_iso _
    exact epi_comp' inferInstance ‹Epi q›
  have hlhs : Epi ((tilde.functor R).map (moduleSpecΓFunctor.map q) ≫ N.fromTildeΓ) := by
    rw [h]; exact hrhs
  have hmap : Epi ((tilde.functor R).map (moduleSpecΓFunctor.map q)) :=
    (epi_comp_iff_of_isIso _ N.fromTildeΓ).mp hlhs
  have hΓ : Epi (moduleSpecΓFunctor.map q) :=
    (tilde.functor R).epi_of_epi_map inferInstance
  exact (ModuleCat.epi_iff_surjective (moduleSpecΓFunctor.map q)).mp inferInstance

/-- An epimorphism of quasi-coherent modules is surjective on sections over an affine open. -/
private lemma sections_surjective_affine {X : Scheme.{u}} {M N : X.Modules}
    [M.IsQuasicoherent] [N.IsQuasicoherent] (q : M ⟶ N) [Epi q]
    (U : X.affineOpens) : Function.Surjective (q.app U.1) := by
  have : IsOpenImmersion U.2.fromSpec := U.2.isOpenImmersion_fromSpec
  have h := sections_surjective_spec ((Scheme.Modules.restrictFunctor U.2.fromSpec).map q)
  change Function.Surjective (q.app (U.2.fromSpec ''ᵁ ⊤)) at h
  have hi : U.2.fromSpec ''ᵁ ⊤ = U.1 :=
    (Scheme.Hom.image_top_eq_opensRange _).trans U.2.opensRange_fromSpec
  rw [hi] at h
  exact h

/-- The map on sections over an affine open, as a linear map over the *commutative* ring of
functions there. `AlgebraicGeometry.Scheme.ringCatSheaf` presents the same ring as a `RingCat`
object, and a `Submodule` quotient formed over `Γ(X, U)` has no `Module` instance for that
second spelling, so `Submodule.liftQ` must be fed a map in this one. -/
private def sectionsLinearMap {X : Scheme.{u}} {M N : X.Modules} (q : M ⟶ N)
    (U : X.affineOpens) : Γ(M, U.1) →ₗ[Γ(X, U.1)] Γ(N, U.1) where
  toFun := fun m => (q.val.app (op U.1)).hom m
  map_add' := fun a c => map_add _ a c
  map_smul' := fun c a => map_smul _ c a

/-- If a submodule `T` of the sections of `M` over an affine open dies in `N`, and the `k`-th
Fitting ideal of the quotient by `T` is the unit ideal, then so is the `k`-th Fitting ideal of
the sections of `N`. -/
private lemma fittingIdeal_sections_eq_top_of_le_ker {X : Scheme.{u}} {M N : X.Modules}
    (q : M ⟶ N) [Epi q] [M.IsQuasicoherent] [N.IsQuasicoherent]
    (U : X.affineOpens) [Module.Finite Γ(X, U.1) Γ(M, U.1)]
    [Module.Finite Γ(X, U.1) Γ(N, U.1)]
    (T : Submodule Γ(X, U.1) Γ(M, U.1))
    (hT : T ≤ LinearMap.ker (sectionsLinearMap q U)) (k : ℕ)
    (hTtop : _root_.fittingIdeal (R := Γ(X, U.1)) (M := Γ(M, U.1) ⧸ T) (k : ℤ) = ⊤) :
    _root_.fittingIdeal (R := Γ(X, U.1)) (M := Γ(N, U.1)) (k : ℤ) = ⊤ := by
  let q' := T.liftQ (sectionsLinearMap q U) hT
  have hq'surj : Function.Surjective q' := by
    intro m
    obtain ⟨n, hn⟩ := sections_surjective_affine q U m
    exact ⟨T.mkQ n, hn⟩
  have hmono := (fittingIdeal_basic_properties.{u, u, u, u}
    (R := Γ(X, U.1)) (M := Γ(M, U.1) ⧸ T)).2.2.2.2.1 Γ(N, U.1) q' k hq'surj
  rw [hTtop] at hmono
  exact top_le_iff.mp hmono

/-! ### The main result -/

/-- The content of Tag 0CZP, for an arbitrary second morphism `b : B ⟶ S` and an arbitrary
effective Cartier divisor `E` on `B` whose ideal is the inverse image of the `k`-th Fitting
ideal. Tag 0CZP is the case of the blowup in that Fitting ideal, where `E` is the exceptional
ideal; stating it this way keeps `b` and `E` opaque, which is what makes the affine-chart
arguments below elaborate. -/
private lemma isGeneratedByNear_strictTransform_sheaf
    {S B : Scheme.{u}} (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent] (k : ℕ)
    (b : B ⟶ S) (E : B.IdealSheafData)
    (hEcart : Stacks.Divisors.IsEffectiveCartierDivisor E)
    (hE : E = (fittingIdeal F (k : ℤ)).comap b)
    (s : Stacks.StrictTransform.baseChange (𝟙 S) b) :
    IsGeneratedByNear (Stacks.StrictTransform.sheaf (𝟙 S) b E F) k s := by
  classical
  have hGft : ((Scheme.Modules.pullback (pullback.fst (𝟙 S) b)).obj F).IsFiniteType :=
    SheafOfModules.pullback_isFiniteType (pullback.fst (𝟙 S) b).toLRSHom.toShHom F
  have hGqc : ((Scheme.Modules.pullback (pullback.fst (𝟙 S) b)).obj F).IsQuasicoherent := by
    let F' : SheafOfModules S.ringCatSheaf := F
    have hF' : F'.IsQuasicoherent := ‹F.IsQuasicoherent›
    exact @SheafOfModules.modulePullback_isQuasicoherent _ _
      (pullback.fst (𝟙 S) b).toLRSHom.toShHom F' hF'
  -- the exceptional preimage is closed, and its complement retrocompact: the complement of an
  -- effective Cartier divisor is affine over the ambient scheme (Tag 07ZU), hence
  -- quasi-compact, and that passes to the base change
  have hZ : IsClosed (Stacks.StrictTransform.exceptionalPreimage (𝟙 S) b E) :=
    E.support.isClosed.preimage (pullback.snd (𝟙 S) b).continuous
  have hEaff : IsAffineHom (Scheme.Opens.ι E.support.compl) :=
    Stacks.Divisors.isAffineHom_compl_of_isEffectiveCartierDivisor E hEcart
  have hEqc : QuasiCompact (Scheme.Opens.ι E.support.compl) := inferInstance
  have hqcW : QuasiCompact (Stacks.StrictTransform.exceptionalComplement (𝟙 S) b E).ι :=
    Stacks.StrictTransform.quasiCompact_exceptionalComplement_ι (𝟙 S) b E
  have hZc : IsRetrocompact
      ((Stacks.StrictTransform.exceptionalPreimage (𝟙 S) b E)ᶜ :
        Set (Stacks.StrictTransform.baseChange (𝟙 S) b)) := by
    rw [Stacks.StrictTransform.exceptionalPreimage_eq_compl, compl_compl]
    exact IsRetrocompact_iff_isSpectralMap_subtypeVal.mpr
      (quasiCompact_iff_isSpectralMap.mp hqcW)
  have hsupqc : SheafOfModules.IsQuasicoherent.{u, u, u}
      (supportedSectionsObj (Stacks.StrictTransform.exceptionalPreimage (𝟙 S) b E)
        ((Scheme.Modules.pullback (pullback.fst (𝟙 S) b)).obj F)) :=
    supportedSectionsSubmodule_isQuasicoherent _ hZ hZc _
  have hepi : Epi (Stacks.StrictTransform.π (𝟙 S) b E F) :=
    inferInstanceAs (Epi (cokernel.π _))
  have hQft : (Stacks.StrictTransform.sheaf (𝟙 S) b E F).IsFiniteType :=
    isFiniteType_of_epi_modules (Stacks.StrictTransform.π (𝟙 S) b E F) hGft
  have hQqc : (Stacks.StrictTransform.sheaf (𝟙 S) b E F).IsQuasicoherent :=
    Stacks.AlgebraicGeometry.QuasicoherentColimits.isQuasicoherent_cokernel _
  refine (isGeneratedByNear_iff_fittingIdeal_stalk_eq_top
    (Stacks.StrictTransform.sheaf (𝟙 S) b E F) k s).2 ?_
  -- the inverse image of `E` on the base change is the `k`-th Fitting ideal of `G`
  have hJG : E.comap (pullback.snd (𝟙 S) b) =
      fittingIdeal ((Scheme.Modules.pullback (pullback.fst (𝟙 S) b)).obj F) (k : ℤ) := by
    rw [hE, ← Scheme.IdealSheafData.comap_comp]
    have hcond : pullback.snd (𝟙 S) b ≫ b = pullback.fst (𝟙 S) b := by
      simpa using (pullback.condition (f := 𝟙 S) (g := b)).symm
    rw [hcond]
    exact fittingIdeal_comap _ F _
  have hJZ : ((E.comap (pullback.snd (𝟙 S) b)).support : Set
      (Stacks.StrictTransform.baseChange (𝟙 S) b)) =
      Stacks.StrictTransform.exceptionalPreimage (𝟙 S) b E := by
    rw [Scheme.IdealSheafData.support_comap]
    rfl
  -- a chart on which that ideal is principal, by Tags 02OS and 053P
  obtain ⟨U, hsU, hU⟩ :=
    Stacks.Divisors.isLocallyPrincipal_comap (pullback.snd (𝟙 S) b) E
      (Stacks.Divisors.isLocallyPrincipal_of_isEffectiveCartierDivisor E hEcart) s
  obtain ⟨g, hg⟩ := hU
  have hGfin := moduleFinite_sections_on_affine
    ((Scheme.Modules.pullback (pullback.fst (𝟙 S) b)).obj F) U.1 U.2
  have hQfin := moduleFinite_sections_on_affine
    (Stacks.StrictTransform.sheaf (𝟙 S) b E F) U.1 U.2
  have hfit : _root_.fittingIdeal
      (M := Γ((Scheme.Modules.pullback (pullback.fst (𝟙 S) b)).obj F, U.1)) (k : ℤ) =
      Ideal.span {g} := by
    rw [← fittingIdeal_ideal ((Scheme.Modules.pullback (pullback.fst (𝟙 S) b)).obj F)
      (k : ℤ) U, ← hJG]
    exact hg
  -- on `U` the exceptional preimage is the zero locus of `g`
  have hZI : (Stacks.StrictTransform.exceptionalPreimage (𝟙 S) b E) ∩
      (U.1 : Set (Stacks.StrictTransform.baseChange (𝟙 S) b)) =
      (Stacks.StrictTransform.baseChange (𝟙 S) b).zeroLocus (U := U.1) {g} ∩
      (U.1 : Set (Stacks.StrictTransform.baseChange (𝟙 S) b)) := by
    rw [← hJZ, (E.comap (pullback.snd (𝟙 S) b)).coe_support_inter U, hg,
      Scheme.zeroLocus_span]
  -- sections killed by a power of `g` are supported there, hence die in the strict transform
  set T := Ideal.primaryComponent
      Γ((Scheme.Modules.pullback (pullback.fst (𝟙 S) b)).obj F, U.1) (Ideal.span {g}) with hTdef
  have hTker : T ≤ LinearMap.ker
      (sectionsLinearMap (Stacks.StrictTransform.π (𝟙 S) b E F) U) := by
    intro m hm
    rw [hTdef, Ideal.primaryComponent_mem] at hm
    obtain ⟨n, hn⟩ := hm
    rw [Submodule.mem_torsionBySet_iff] at hn
    have hpow : (g ^ n) • m = 0 :=
      hn ⟨g ^ n, Ideal.pow_mem_pow (Ideal.mem_span_singleton_self g) n⟩
    have hm' : m ∈ (supportedSectionsSubmodule
        (Stacks.StrictTransform.exceptionalPreimage (𝟙 S) b E)
        ((Scheme.Modules.pullback (pullback.fst (𝟙 S) b)).obj F)).toSubmodule.obj (op U.1) :=
      mem_supportedSectionsSubmodule_of_pow_smul_eq_zero _ U.1 g hZI m hpow
    exact congrArg (fun t :
      (supportedSectionsObj (Stacks.StrictTransform.exceptionalPreimage (𝟙 S) b E)
        ((Scheme.Modules.pullback (pullback.fst (𝟙 S) b)).obj F)) ⟶
        Stacks.StrictTransform.sheaf (𝟙 S) b E F =>
        (t.val.app (op U.1)).hom ⟨m, hm'⟩)
      (cokernel.condition (supportedSectionsι
        (Stacks.StrictTransform.exceptionalPreimage (𝟙 S) b E)
        ((Scheme.Modules.pullback (pullback.fst (𝟙 S) b)).obj F)))
  have hfitQ : _root_.fittingIdeal
      (R := Γ(Stacks.StrictTransform.baseChange (𝟙 S) b, U.1))
      (M := Γ(Stacks.StrictTransform.sheaf (𝟙 S) b E F, U.1)) (k : ℤ) = ⊤ :=
    fittingIdeal_sections_eq_top_of_le_ker (Stacks.StrictTransform.π (𝟙 S) b E F) U T hTker k
      (by rw [hTdef]; exact fittingIdeal_quotient_primaryComponent_eq_top k g hfit)
  rw [← fittingIdeal_ideal (Stacks.StrictTransform.sheaf (𝟙 S) b E F) (k : ℤ) U] at hfitQ
  refine top_le_iff.mp ?_
  rw [IdealSheafData.stalk]
  refine le_iSup_of_le U (le_iSup_of_le hsU ?_)
  rw [hfitQ, Ideal.map_top]

/-- **Stacks Project, Tag 0CZP.** The strict transform of a finite type quasi-coherent module on
the blowup of its `k`-th Fitting ideal is locally generated by at most `k` sections. -/
@[stacks 0CZP]
theorem strictTransformSheaf_isGeneratedByNear
    {S : Scheme.{u}} (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (k : ℕ) (s : Stacks.StrictTransform.baseChange (𝟙 S)
      (blowUpToBase (fittingIdeal F (k : ℤ)))) :
    IsGeneratedByNear
      (Stacks.StrictTransform.sheaf (𝟙 S) (blowUpToBase (fittingIdeal F (k : ℤ)))
        (exceptionalIdeal (fittingIdeal F (k : ℤ))) F)
      k s :=
  isGeneratedByNear_strictTransform_sheaf F k (blowUpToBase (fittingIdeal F (k : ℤ)))
    (exceptionalIdeal (fittingIdeal F (k : ℤ))) inferInstance rfl s

end AlgebraicGeometry

