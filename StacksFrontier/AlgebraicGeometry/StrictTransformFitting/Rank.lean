/-!
# Strict transforms and Fitting blowups

The strict transform of a finite type quasi-coherent module under the blowup of its `k`-th
Fitting closed subscheme is finite locally free of rank `k`, provided the module already has
that rank away from the centre.

## Main definitions

There are no new definitions.

## Main results

* `AlgebraicGeometry.isFiniteLocallyFreeOfRank_strictTransform_fittingBlowUp` gives the rank of
  the strict transform.

## Implementation notes

The open complement of the Fitting centre is the complement of the support of its ideal sheaf.
The strict transform construction is defined on the base change along the blowup, so the
identity morphism of the base is supplied as the map to the base.

The proof combines three inputs. Tag 0CZP
(`AlgebraicGeometry.strictTransformSheaf_isGeneratedByNear`) says the strict transform is
generated by `k` sections near every point, so by Tag 0C3F its `k`-th Fitting ideal has unit
ideal stalks everywhere, hence is the unit ideal. Tag 0C3G
(`AlgebraicGeometry.finiteLocallyFreeOfRank_tfae_fittingIdeal`) then reduces rank `k` to the
vanishing of the `(k-1)`-st Fitting ideal, which is checked on the complement `V` of the
exceptional divisor: there the strict transform agrees with the pullback of `F`, which has rank
`k` by hypothesis, and `V` is scheme-theoretically dense, so an ideal sheaf vanishing on `V`
vanishes. Density of `V` comes from Tag 07ZU applied to the inverse image of the Fitting ideal
on the base change, which is an effective Cartier divisor by Tag 02OO (6)
(`Stacks.Divisors.isPullbackDefined_of_flat`) applied to the second projection — an isomorphism,
because the first factor of the fibre product is the identity.

## References

* [Stacks Project, Tag 0CZQ](https://stacks.math.columbia.edu/tag/0CZQ)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace
open AlgebraicGeometry.Scheme.Modules

universe u

namespace AlgebraicGeometry

/-! ### Transport lemmas -/

/-- An ideal vanishing after a scheme-theoretically dominant base change vanishes. -/
private alias ideal_eq_bot_of_comap_eq_bot :=
  Stacks.StrictTransformFittingRank.ideal_eq_bot_of_comap_eq_bot

/-- An ideal sheaf whose stalk ideals are all the unit ideal is the unit ideal. -/
private alias ideal_eq_top_of_stalk_eq_top :=
  Stacks.StrictTransformFittingRank.ideal_eq_top_of_stalk_eq_top

/-- Pointwise finite generating families assemble into finite type data. -/
private alias isFiniteType_of_isGeneratedByNear :=
  Stacks.StrictTransformFittingRank.isFiniteType_of_isGeneratedByNear

/-- Generation by `k` sections everywhere makes the `k`-th Fitting ideal the unit ideal. -/
private lemma fittingIdeal_eq_top_of_isGeneratedByNear {X : Scheme.{u}}
    (F : X.Modules) [F.IsFiniteType] [F.IsQuasicoherent] (k : ℕ)
    (h : ∀ x, IsGeneratedByNear F k x) :
    fittingIdeal F k = ⊤ := by
  apply ideal_eq_top_of_stalk_eq_top
  intro x
  exact (isGeneratedByNear_iff_fittingIdeal_stalk_eq_top F k x).mp (h x)

/-- Pullback of a finite type module is of finite type. -/
private alias isFiniteType_pullback := AlgebraicGeometry.isFiniteType_modulePullback

attribute [local instance] isFiniteType_pullback

/-- Finite local freeness of rank `k` is the `(k-1)`-st Fitting ideal vanishing and the `k`-th
being the unit ideal. -/
private lemma isFiniteLocallyFreeOfRank_iff_fittingIdeal {X : Scheme.{u}}
    (F : X.Modules) [F.IsFiniteType] [F.IsQuasicoherent] (k : ℕ) :
    SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F k ↔
      (k = 0 ∨ fittingIdeal F ((k : ℤ) - 1) = ⊥) ∧ fittingIdeal F (k : ℤ) = ⊤ :=
  (finiteLocallyFreeOfRank_tfae_fittingIdeal F k).out 1 2

/-- Finite local freeness of fixed rank is preserved by base change. -/
private lemma isFiniteLocallyFreeOfRank_pullback {X Y : Scheme.{u}}
    (f : X ⟶ Y) (F : Y.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (k : ℕ) (h : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F k) :
    SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback f).obj F) k := by
  rw [isFiniteLocallyFreeOfRank_iff_fittingIdeal] at h ⊢
  simp only [← fittingIdeal_comap]
  refine ⟨h.1.imp id (fun he => ?_), ?_⟩
  · simp only [he, Scheme.IdealSheafData.comap_bot]
  · simp only [h.2, Scheme.IdealSheafData.comap_top]

/-- A sheaf isomorphism transports finite local bases and their rank. -/
private alias isFiniteLocallyFreeOfRank_of_iso :=
  Stacks.StrictTransformFittingRank.isFiniteLocallyFreeOfRank_of_iso

/-- On an open disjoint from the support condition, the supported-sections inclusion is zero. -/
private lemma restrict_supportedSectionsι_eq_zero {X : Scheme.{u}}
    (F : X.Modules) (Z : Set X) (U : X.Opens) (hU : Disjoint (U : Set X) Z) :
    (Scheme.Modules.restrictFunctor U.ι).map (supportedSectionsι Z F) = 0 := by
  ext V s
  show (s.1 : Γ(F, U.ι ''ᵁ V)) = 0
  apply TopCat.Presheaf.section_ext ⟨F.val.presheaf, F.isSheaf⟩
  intro x hx
  have hxZ : x ∉ Z := by
    intro hxZ
    exact Set.disjoint_left.mp hU
      (by obtain ⟨y, hy, rfl⟩ := hx; exact y.property) hxZ
  exact (s.property x hx hxZ).trans
    (map_zero (TopCat.Presheaf.germ F.val.presheaf (U.ι ''ᵁ V) x hx).hom).symm

/-- The quotient by supported sections restricts to the original module on the complement of the
support condition. -/
private def pullbackSupportedSectionsCokernelIso {X : Scheme.{u}}
    (F : X.Modules) (Z : Set X) (U : X.Opens) (hU : Disjoint (U : Set X) Z) :
    (Scheme.Modules.pullback U.ι).obj (cokernel (supportedSectionsι Z F)) ≅
      (Scheme.Modules.pullback U.ι).obj F := by
  let T := Scheme.Modules.restrictFunctor U.ι
  let i := supportedSectionsι Z F
  let e := Scheme.Modules.restrictFunctorIsoPullback U.ι
  have hT : T.Additive := Functor.additive_of_iso e.symm
  exact (e.app _).symm ≪≫ PreservesCokernel.iso T i ≪≫
    cokernelIsoOfEq (restrict_supportedSectionsι_eq_zero F Z U hU) ≪≫
    cokernelZeroIsoTarget ≪≫ e.app F

/-- A module generated by `k` sections which has rank `k` on a scheme-theoretically dense open
is finite locally free of that rank everywhere. -/
private lemma isFiniteLocallyFreeOfRank_of_generated_of_dense_open
    {X : Scheme.{u}} (F : X.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (k : ℕ) (U : X.Opens) [IsSchemeTheoreticallyDominant U.ι]
    (hgen : ∀ x, IsGeneratedByNear F k x)
    (hrank : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback U.ι).obj F) k) :
    SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} F k := by
  rw [isFiniteLocallyFreeOfRank_iff_fittingIdeal] at hrank ⊢
  refine ⟨?_, fittingIdeal_eq_top_of_isGeneratedByNear F k hgen⟩
  rcases hrank.1 with hk | hk
  · exact Or.inl hk
  · exact Or.inr (ideal_eq_bot_of_comap_eq_bot U.ι _ (by rwa [fittingIdeal_comap]))

/-! ### The main result -/

/-- **Stacks Project, Tag 0CZQ.** Blowing up the `k`-th Fitting ideal and taking the strict
transform makes a generically rank-`k` module finite locally free of rank `k`. -/
@[stacks 0CZQ]
theorem isFiniteLocallyFreeOfRank_strictTransform_fittingBlowUp
    {S : Scheme.{u}} (F : S.Modules) [F.IsFiniteType] [F.IsQuasicoherent]
    (k : ℕ)
    (h : let I := fittingIdeal F (k : ℤ)
      let U : S.Opens := ⟨I.supportᶜ, I.support.isClosed.isOpen_compl⟩
      SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
        ((Scheme.Modules.pullback U.ι).obj F) k) :
    SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (Stacks.StrictTransform.sheaf (𝟙 S) (blowUpToBase (fittingIdeal F (k : ℤ)))
        (exceptionalIdeal (fittingIdeal F (k : ℤ))) F) k := by
  let I := fittingIdeal F (k : ℤ)
  let X := Stacks.StrictTransform.baseChange (𝟙 S) (blowUpToBase I)
  let b : X ⟶ S := pullback.fst (𝟙 S) (blowUpToBase I)
  let p : X ⟶ blowUp I := pullback.snd (𝟙 S) (blowUpToBase I)
  let E := I.comap b
  let U : S.Opens := I.support.compl
  let V : X.Opens := E.support.compl
  let G := Stacks.StrictTransform.sheaf (𝟙 S) (blowUpToBase I) (exceptionalIdeal I) F
  have hgen : ∀ x, IsGeneratedByNear G k x :=
    strictTransformSheaf_isGeneratedByNear F k
  have hGft : G.IsFiniteType := isFiniteType_of_isGeneratedByNear G k hgen
  have hGqc : G.IsQuasicoherent :=
    Stacks.StrictTransform.isQuasicoherent_sheaf (𝟙 S) (blowUpToBase I) (exceptionalIdeal I) F
  have hE : E = (exceptionalIdeal I).comap p := by
    have hb : b = p ≫ blowUpToBase I :=
      (Category.comp_id b).symm.trans (pullback.condition ..)
    exact (congrArg (I.comap ·) hb).trans (I.comap_comp p _)
  have hpiso : IsIso p := by
    show IsIso (pullback.snd (𝟙 S) (show _ ⟶ S from blowUpToBase I))
    infer_instance
  have hCartier : Stacks.Divisors.IsEffectiveCartierDivisor E := by
    rw [hE]
    exact Stacks.Divisors.isPullbackDefined_of_flat p _ inferInstance
  have hVdom : IsSchemeTheoreticallyDominant V.ι :=
    Stacks.SchemeTheoreticImage.isSchemeTheoreticallyDominant_of_dense V
      (Stacks.Divisors.isSchemeTheoreticallyDense_compl_of_isEffectiveCartierDivisor E hCartier)
  apply isFiniteLocallyFreeOfRank_of_generated_of_dense_open G k V hgen
  have hEV : (E.support : Set X) =
      Stacks.StrictTransform.exceptionalPreimage (𝟙 S) (blowUpToBase I) (exceptionalIdeal I) := by
    rw [hE, Scheme.IdealSheafData.support_comap]
    rfl
  have hVU : Set.range (V.ι ≫ b).base ⊆ Set.range U.ι.base := by
    rintro _ ⟨x, rfl⟩
    refine ⟨⟨b (V.ι x), ?_⟩, rfl⟩
    have hx := x.property
    change V.ι x ∉ E.support at hx
    show b (V.ι x) ∉ I.support
    change V.ι x ∉ (I.comap b).support at hx
    rw [Scheme.IdealSheafData.support_comap] at hx
    exact hx
  let g : V.toScheme ⟶ U.toScheme := IsOpenImmersion.lift U.ι (V.ι ≫ b) hVU
  have hg : g ≫ U.ι = V.ι ≫ b := IsOpenImmersion.lift_fac _ _ hVU
  have hrank : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback g).obj ((Scheme.Modules.pullback U.ι).obj F)) k :=
    isFiniteLocallyFreeOfRank_pullback g _ k h
  let e : (Scheme.Modules.pullback g).obj ((Scheme.Modules.pullback U.ι).obj F) ≅
      (Scheme.Modules.pullback V.ι).obj G :=
    (Scheme.Modules.pullbackComp g U.ι).app F ≪≫
      (Scheme.Modules.pullbackCongr hg).app F ≪≫
      ((Scheme.Modules.pullbackComp V.ι b).app F).symm ≪≫
      (pullbackSupportedSectionsCokernelIso ((Scheme.Modules.pullback b).obj F)
        (Stacks.StrictTransform.exceptionalPreimage (𝟙 S) (blowUpToBase I)
          (exceptionalIdeal I)) V
        (by rw [← hEV]; exact disjoint_compl_left)).symm
  exact isFiniteLocallyFreeOfRank_of_iso e k hrank

end AlgebraicGeometry

end
