module

public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierAffineLocal
public import StacksFrontier.AlgebraicGeometry.F6Rank89.IdealSheafStalk
public import StacksFrontier.AlgebraicGeometry.Properties.Dimension

/-!
# Local rings along an effective Cartier divisor

An effective Cartier divisor `D` on a scheme `X` is locally cut out by a single nonzerodivisor,
so the stalk of its ideal sheaf at any point is a principal ideal generated by a regular element
— the unit ideal off the support. Dividing by that element drops the Krull dimension of the
local ring by exactly one, which is the content of
`Stacks.Divisors.ringKrullDim_stalk_subscheme_add_one`.

The file closes with the one-dimensional case of
`AlgebraicGeometry.topologicalKrullDim_eq_iSup_krullDimOfRing_stalk`: on an integral scheme of
dimension one, every closed point has a local ring of dimension exactly one.

## Main results

* `Stacks.Divisors.exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor`: at every point,
  the stalk of the ideal sheaf of an effective Cartier divisor is generated by a regular element.
* `Stacks.Divisors.ringKrullDim_stalk_subscheme_add_one`: the local ring of a point of an
  effective Cartier divisor has Krull dimension one less than the local ring of its image.
* `Stacks.Divisors.ringKrullDim_stalk_subscheme_add_length`: the same drop by `n` when the stalk
  of the ideal sheaf is generated by a regular sequence of length `n`.
* `AlgebraicGeometry.ringKrullDim_stalk_eq_one_of_integral_curve`: a closed point of an integral
  scheme of dimension one has a one-dimensional local ring.

## Implementation notes

Off the support the generator is `1`, since the stalk is then the unit ideal
(`AlgebraicGeometry.IdealSheafData.stalk_eq_top_iff_not_mem_support`), and `1` is regular. On the
support, the generator is the germ of the nonzerodivisor produced by
`Stacks.Divisors.isEffectiveCartierDivisor_iff_affineLocal`, and it stays a nonzerodivisor in the
local ring because localization at a prime maps nonzerodivisors to nonzerodivisors.

`Stacks.Divisors.isEffectiveCartierDivisor_iff_affineLocal` is declared in **two** modules of this
library with the same fully-qualified name, so they are mutually unimportable; the import above
names `StacksDraft.AlgebraicGeometry.F3b.Divisors.EffectiveCartierAffineLocal` rather than
`StacksDraft.AlgebraicGeometry.Divisors.EffectiveCartierFold.AffineLocal` because the latter
cannot be imported alongside the chapter-42 dimension material that the sibling modules of this
directory use. The two statements are identical.

`Stacks.Divisors.ringKrullDim_stalk_subscheme_add_length` is the same argument run off
`ringKrullDim_add_length_eq_ringKrullDim_of_isRegular`, which performs the `n` steps at once.

The dimension drop is read off the Mathlib result
`ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors`, applied to the
kernel of the map on stalks induced by the closed immersion `D.subschemeι`; that kernel is the
stalk of the ideal sheaf by
`AlgebraicGeometry.IdealSheafData.stalk_ker_of_isClosedImmersion`. The regular element lies in the
maximal ideal exactly because the point is in the support, which is where the hypothesis that it
comes from `D.subscheme` is used.

`AlgebraicGeometry.ringKrullDim_stalk_eq_one_of_integral_curve` argues in the specialization order
rather than with ideals: `AlgebraicGeometry.ringKrullDim_stalk_eq_coheight` turns the local Krull
dimension into the coheight of the point, which is at least one because the point is not the
generic point and at most one because it is bounded by the Krull dimension of the space. That the
closed point is not generic is the only place integrality is used: were it generic, the space
would be a single point and so of dimension zero.
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace Stacks.Divisors

/-- At every point, the stalk of the ideal sheaf of an effective Cartier divisor is generated by
a regular element of the local ring. -/
theorem exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor {X : Scheme.{u}}
    (I : X.IdealSheafData) (hI : IsEffectiveCartierDivisor I) (x : X) :
    ∃ a : X.presheaf.stalk x, IsRegular a ∧ IdealSheafData.stalk I x = Ideal.span {a} := by
  by_cases hx : x ∈ I.support
  · obtain ⟨U, hU, hxU, f, hf, e, he⟩ :=
      (isEffectiveCartierDivisor_iff_affineLocal I).mp hI x hx
    let p := hU.primeIdealOf ⟨x, hxU⟩
    let : Algebra Γ(X, U) (X.presheaf.stalk x) :=
      X.presheaf.algebra_section_stalk ⟨x, hxU⟩
    have : IsLocalization.AtPrime (X.presheaf.stalk x) p.asIdeal :=
      hU.isLocalization_stalk ⟨x, hxU⟩
    refine ⟨(X.presheaf.germ U x hxU).hom f, ?_, ?_⟩
    · exact isRegular_iff_mem_nonZeroDivisors.mpr <| IsLocalization.map_nonZeroDivisors_le
        p.asIdeal.primeCompl (X.presheaf.stalk x) ⟨f, hf.mem_nonZeroDivisors, rfl⟩
    · rw [IdealSheafData.stalk_eq_map_germ I x ⟨U, hU⟩ hxU,
        ideal_eq_quotient_of_chart I U hU (Ideal.span {f}) e he, Ideal.map_span]
      simp only [Set.image_singleton]
  · exact ⟨1, isRegular_one,
      ((IdealSheafData.stalk_eq_top_iff_not_mem_support I x).mpr hx).trans
        Ideal.span_singleton_one.symm⟩

/-- The local ring of `D.subscheme` at `z` has the Krull dimension of the quotient of the local
ring of `X` by any ideal equal to the stalk of the ideal sheaf. -/
private theorem ringKrullDim_stalk_subscheme_eq_quotient {X : Scheme.{u}} (D : X.IdealSheafData)
    (z : D.subscheme) (J : Ideal (X.presheaf.stalk (D.subschemeι z)))
    (hJ : IdealSheafData.stalk D (D.subschemeι z) = J) :
    ringKrullDim (D.subscheme.presheaf.stalk z) =
      ringKrullDim (X.presheaf.stalk (D.subschemeι z) ⧸ J) := by
  have hker : RingHom.ker ((D.subschemeι).stalkMap z).hom = J := by
    rw [← IdealSheafData.stalk_ker_of_isClosedImmersion D.subschemeι z,
      Scheme.IdealSheafData.ker_subschemeι]
    exact hJ
  have heq := (((D.subschemeι).stalkMap z).hom.quotientKerEquivOfSurjective
    (D.subschemeι.stalkMap_surjective z)).ringKrullDim
  rw [hker] at heq
  exact heq.symm

/-- The local ring of a point of an effective Cartier divisor on a locally Noetherian scheme has
Krull dimension one less than the local ring of its image. -/
theorem ringKrullDim_stalk_subscheme_add_one {X : Scheme.{u}} [IsLocallyNoetherian X]
    (D : X.IdealSheafData) (hD : IsEffectiveCartierDivisor D) (z : D.subscheme) :
    ringKrullDim (D.subscheme.presheaf.stalk z) + 1 =
      ringKrullDim (X.presheaf.stalk (D.subschemeι z)) := by
  let i := D.subschemeι
  obtain ⟨a, ha, hDa⟩ :=
    exists_isRegular_stalk_eq_span_of_isEffectiveCartierDivisor D hD (i z)
  have hzSupport : i z ∈ D.support := by
    change i z ∈ (D.support : Set X)
    rw [← Scheme.IdealSheafData.range_subschemeι]
    exact Set.mem_range_self z
  have hna : ¬ IsUnit a := fun hunit ↦
    (IdealSheafData.stalk_eq_top_iff_not_mem_support D (i z)).mp
      (hDa.trans (Ideal.span_singleton_eq_top.mpr hunit)) hzSupport
  have ham : a ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk (i z)) :=
    (IsLocalRing.mem_maximalIdeal a).2 (by simpa [mem_nonunits_iff] using hna)
  rw [ringKrullDim_stalk_subscheme_eq_quotient D z _ hDa]
  exact ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors
    ha.mem_nonZeroDivisors ham

/-- **A closed subscheme cut out by a regular sequence of length `n` drops the Krull dimension
of the local ring by `n`.**  This is the length-`n` form of
`Stacks.Divisors.ringKrullDim_stalk_subscheme_add_one`. -/
theorem ringKrullDim_stalk_subscheme_add_length {X : Scheme.{u}} [IsLocallyNoetherian X]
    (D : X.IdealSheafData) (z : D.subscheme)
    (rs : List (X.presheaf.stalk (D.subschemeι z)))
    (hreg : RingTheory.Sequence.IsRegular (X.presheaf.stalk (D.subschemeι z)) rs)
    (hstalk : IdealSheafData.stalk D (D.subschemeι z) = Ideal.ofList rs) :
    ringKrullDim (D.subscheme.presheaf.stalk z) + rs.length
      = ringKrullDim (X.presheaf.stalk (D.subschemeι z)) := by
  rw [ringKrullDim_stalk_subscheme_eq_quotient D z _ hstalk]
  exact ringKrullDim_add_length_eq_ringKrullDim_of_isRegular rs hreg

end Stacks.Divisors

namespace AlgebraicGeometry

/-- A closed point of an integral scheme of dimension one has a local ring of Krull dimension
one. -/
theorem ringKrullDim_stalk_eq_one_of_integral_curve (C : Scheme.{u}) [IsIntegral C]
    (hCdim : topologicalKrullDim C = 1) (x : C) (hx : IsClosed ({x} : Set C)) :
    ringKrullDim (C.presheaf.stalk x) = 1 := by
  let : IrreducibleSpace C := AlgebraicGeometry.irreducibleSpace_of_isIntegral C
  let : PartialOrder C := specializationOrder C
  have hdimOrder : Order.krullDim C = 1 :=
    (Order.krullDim_eq_of_orderIso (irreducibleSetEquivPoints (α := C))).symm.trans hCdim
  have hnotGeneric : x ≠ genericPoint C := by
    intro hxgeneric
    have huniv : (Set.univ : Set C) = {x} := by
      calc
        Set.univ = closure ({genericPoint C} : Set C) := (genericPoint_spec C).symm
        _ = closure ({x} : Set C) := by rw [hxgeneric]
        _ = {x} := hx.closure_eq
    have : Subsingleton C := Set.subsingleton_univ_iff.mp <| by
      rw [huniv]
      exact Set.subsingleton_singleton
    have hdimZero : topologicalKrullDim C ≤ 0 := by
      rw [topologicalKrullDim, Order.krullDim_nonpos_iff_forall_isMax]
      intro A B _
      change (B : Set C) ⊆ A
      exact fun y _ ↦ Set.eq_univ_iff_forall.mp A.2.nonempty.eq_univ y
    rw [hCdim] at hdimZero
    norm_num at hdimZero
  have hlt : x < genericPoint C := lt_of_le_of_ne (OrderTop.le_top x) hnotGeneric
  have hlow : (1 : ℕ∞) ≤ Order.coheight x := by
    simpa [show genericPoint C = (⊤ : C) from rfl, Order.coheight_top] using
      Order.coheight_add_one_le hlt
  have hhigh : (Order.coheight x : WithBot ℕ∞) ≤ 1 :=
    (Order.coheight_le_krullDim x).trans_eq hdimOrder
  rw [AlgebraicGeometry.ringKrullDim_stalk_eq_coheight]
  exact le_antisymm hhigh (by exact_mod_cast hlow)

end AlgebraicGeometry

end
