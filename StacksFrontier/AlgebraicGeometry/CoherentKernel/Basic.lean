-/

@[expose] public section

open CategoryTheory Limits SheafOfModules TopologicalSpace AlgebraicGeometry
open Stacks.AlgebraicGeometry.CoherentTFAE

universe u v' u' v₁ u₁

namespace Stacks.AlgebraicGeometry.CoherentKernel

/-! ### Finite type from generating sections over a covering -/

section FiniteType

variable {C : Type u'} [Category.{v'} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
  [∀ Y : C, HasWeakSheafify (J.over Y) AddCommGrpCat.{u}]
  [∀ Y : C, (J.over Y).WEqualsLocallyBijective AddCommGrpCat.{u}]

/-- **A sheaf of modules generated by finitely many sections over each member of a covering of
the terminal object is of finite type.** This is nothing but the `LocalGeneratorsData`
constructor; it is stated with the site instances abstract so that applying it needs no instance
search over an iterated slice of the site. -/
theorem isFiniteType_of_coversTop (M : SheafOfModules.{u} R) {ι : Type u'} (Y : ι → C)
    (hY : J.CoversTop Y) (σ : ∀ i, (M.over (Y i)).GeneratingSections)
    (hσ : ∀ i, Finite (σ i).I) : M.IsFiniteType := by
  have hd : (⟨ι, Y, hY, σ⟩ : M.LocalGeneratorsData).IsFiniteType := ⟨fun i => ⟨hσ i⟩⟩
  constructor
  exact ⟨⟨ι, Y, hY, σ⟩, hd⟩

end FiniteType

/-! ### Transport of a map out of a free module, its kernel, and generating sections -/

section Transport

variable {C : Type u'} [Category.{v'} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
  {C' : Type u₁} [Category.{v₁} C'] {J' : GrothendieckTopology C'} {S : Sheaf J' RingCat.{u}}
  [HasSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [HasSheafify J' AddCommGrpCat.{u}] [J'.WEqualsLocallyBijective AddCommGrpCat.{u}]

section Forward

variable (Φ : SheafOfModules.{u} R ⥤ SheafOfModules.{u} S) {I : Type u}
  [hcolim : PreservesColimitsOfShape (Discrete I) Φ] (η : unit S ≅ Φ.obj (unit R))

/-- The image under `Φ` of a map `φ : free I ⟶ M`, read as a map out of `free I` again and into
a module `N` identified with `Φ.obj M`. -/
noncomputable def mapFreeHom {M : SheafOfModules.{u} R} (φ : free I ⟶ M)
    {N : SheafOfModules.{u} S} (α : Φ.obj M ≅ N) : (free I : SheafOfModules.{u} S) ⟶ N :=
  (mapFreeIso Φ I η).hom ≫ Φ.map φ ≫ α.hom

/-- A left exact `Φ` carries `kernel φ` to the kernel of `mapFreeHom Φ η φ α`. -/
noncomputable def kernelMapFreeIso [hlim : PreservesFiniteLimits Φ]
    [hzero : Φ.PreservesZeroMorphisms]
    {M : SheafOfModules.{u} R} (φ : free I ⟶ M)
    {N : SheafOfModules.{u} S} (α : Φ.obj M ≅ N) :
    Φ.obj (kernel φ) ≅ kernel (mapFreeHom Φ η φ α) :=
  have h : kernel (Φ.map φ) ≅ kernel (mapFreeHom Φ η φ α) :=
    kernel.mapIso (Φ.map φ) (mapFreeHom Φ η φ α) (mapFreeIso Φ I η).symm α
      (by simp [mapFreeHom])
  PreservesKernel.iso Φ φ ≪≫ h

end Forward

section Backward

variable (Ψ : SheafOfModules.{u} S ⥤ SheafOfModules.{u} R)
  [hcolimΨ : PreservesColimitsOfSize.{u, u} Ψ] (ηΨ : unit R ≅ Ψ.obj (unit S))

/-- Generating sections of `N` give generating sections of any module identified with
`Ψ.obj N`, with the same index type. -/
noncomputable def generatingSectionsOfMap {M : SheafOfModules.{u} R} {N : SheafOfModules.{u} S}
    (β : Ψ.obj N ≅ M) (σ : N.GeneratingSections) : M.GeneratingSections :=
  GeneratingSections.equivOfIso β (σ.map Ψ ηΨ)

/-- The generating sections `generatingSectionsOfMap Ψ ηΨ β σ` are indexed by `σ.I`. -/
@[simp]
theorem generatingSectionsOfMap_I {M : SheafOfModules.{u} R} {N : SheafOfModules.{u} S}
    (β : Ψ.obj N ≅ M) (σ : N.GeneratingSections) :
    (generatingSectionsOfMap Ψ ηΨ β σ).I = σ.I :=
  rfl

end Backward

end Transport

/-! ### The affine input: the kernel of a map from a finite free module on a spectrum -/

section Spec

variable {A : CommRingCat.{u}} {I : Type u}

/-- The global sections of the finite free module `free I` on `Spec A` are `I →₀ A`. -/
noncomputable def freeSectionsIso : ModuleCat.of A (I →₀ A) ≅
    moduleSpecΓFunctor.obj (SheafOfModules.free.{u} (R := (Spec A).ringCatSheaf) I) :=
  tilde.isoTop _ ≪≫ moduleSpecΓFunctor.mapIso (tildeFinsupp I)

/-- **A free module on a spectrum is quasi-coherent**: it is the `tilde` of a free module. -/
theorem isQuasicoherent_free :
    (SheafOfModules.free.{u} (R := (Spec A).ringCatSheaf) I).IsQuasicoherent :=
  (SheafOfModules.isQuasicoherent (Spec A).ringCatSheaf).prop_of_iso (tildeFinsupp I)
    inferInstance

variable [Finite I] [IsNoetherianRing A]

/-- **The sections of the kernel of a map out of a finite free module form a finite module**,
over a Noetherian ring. -/
theorem finite_moduleSpecΓ_kernel (N : (Spec A).Modules)
    (ζ : SheafOfModules.free.{u} I ⟶ N) :
    Module.Finite A (moduleSpecΓFunctor.obj (kernel ζ)) := by
  have hfin : Module.Finite A
      (moduleSpecΓFunctor.obj (SheafOfModules.free.{u} (R := (Spec A).ringCatSheaf) I)) :=
    Module.Finite.equiv (freeSectionsIso (A := A) (I := I)).toLinearEquiv
  have hnoeth : IsNoetherian A
      (moduleSpecΓFunctor.obj (SheafOfModules.free.{u} (R := (Spec A).ringCatSheaf) I)) :=
    inferInstance
  have hinj : Function.Injective (moduleSpecΓFunctor.map (kernel.ι ζ)).hom :=
    QcohLimits.injective_app_kernel_ι ζ ⊤
  exact Module.Finite.of_injective (moduleSpecΓFunctor.map (kernel.ι ζ)).hom hinj

/-- **On the spectrum of a Noetherian ring the kernel of a map from a finite free module to a
quasi-coherent module is generated by finitely many global sections.** -/
theorem exists_finite_generatingSections_kernel_spec (N : (Spec A).Modules)
    [N.IsQuasicoherent] (ζ : SheafOfModules.free.{u} I ⟶ N) :
    ∃ σ : (kernel ζ).GeneratingSections, Finite σ.I := by
  have _hfree : (SheafOfModules.free.{u} (R := (Spec A).ringCatSheaf) I).IsQuasicoherent :=
    isQuasicoherent_free
  have hker : (kernel ζ).IsQuasicoherent := QcohLimits.isQuasicoherent_kernel ζ
  have hfin : Module.Finite A (moduleSpecΓFunctor.obj (kernel ζ)) :=
    finite_moduleSpecΓ_kernel N ζ
  obtain ⟨τ, hτ⟩ := @exists_finite_generatingSections_tilde _ _ hfin
  have hiso : IsIso (Scheme.Modules.fromTildeΓ (kernel ζ)) :=
    (isQuasicoherent_iff_isIso_fromTildeΓ (kernel ζ)).mp hker
  exact ⟨GeneratingSections.equivOfIso
    (@asIso _ _ _ _ (Scheme.Modules.fromTildeΓ (kernel ζ)) hiso) τ, hτ⟩

end Spec

/-! ### Restriction of modules along an isomorphism of schemes -/

section RestrictIso

variable {Y Z : Scheme.{u}} (e : Y ≅ Z)

/-- **Restriction of modules along an isomorphism of schemes is an equivalence.** -/
noncomputable def restrictEquiv : Y.Modules ≌ Z.Modules :=
  CategoryTheory.Equivalence.mk (Scheme.Modules.restrictFunctor e.inv)
    (Scheme.Modules.restrictFunctor e.hom)
    (Scheme.Modules.restrictFunctorId.symm ≪≫
      (Scheme.Modules.restrictFunctorCongr e.hom_inv_id).symm ≪≫
      Scheme.Modules.restrictFunctorComp e.hom e.inv)
    ((Scheme.Modules.restrictFunctorComp e.inv e.hom).symm ≪≫
      Scheme.Modules.restrictFunctorCongr e.inv_hom_id ≪≫ Scheme.Modules.restrictFunctorId)

/-- Restriction of modules along the inverse of an isomorphism of schemes is an equivalence. -/
noncomputable instance isEquivalence_restrictFunctor_inv :
    (Scheme.Modules.restrictFunctor e.inv).IsEquivalence :=
  inferInstanceAs ((restrictEquiv e).functor.IsEquivalence)

end RestrictIso

/-! ### Restriction from a slice site to a slice of a slice -/

section Slice

variable {X : Scheme.{u}} (U : X.Opens) (W : CategoryTheory.Over U)

/-- **Modules on the slice of the slice over `W : Over U` are modules on the slice over
`W.left`.** -/
noncomputable def sliceEquiv : SheafOfModules.{u} (Sheaf.over X.ringCatSheaf W.left) ≌
    SheafOfModules.{u} ((Sheaf.over X.ringCatSheaf U).over W) :=
  SheafOfModules.pushforwardPushforwardEquivalence.{u} (Over.iteratedSliceEquiv W)
    (S := (X.ringCatSheaf.over U).over W) (R := X.ringCatSheaf.over W.left) (𝟙 _) (𝟙 _)
    (by ext : 2; exact X.ringCatSheaf.1.map_id _)
    (by ext : 2; exact X.ringCatSheaf.1.map_id _)

/-- The structure sheaf of the slice of the slice is carried to the structure sheaf. -/
noncomputable def sliceEquivUnitIso :
    SheafOfModules.unit.{u} ((Sheaf.over X.ringCatSheaf U).over W) ≅
      (sliceEquiv U W).functor.obj
        (SheafOfModules.unit.{u} (Sheaf.over X.ringCatSheaf W.left)) :=
  Iso.refl _

/-- **Restriction from the slice site over `U` to the slice site over `W.left`**: restrict to
`W` inside the slice over `U`, then read the result on `Over W.left`. -/
noncomputable def sliceRestrict : SheafOfModules.{u} (Sheaf.over X.ringCatSheaf U) ⥤
    SheafOfModules.{u} (Sheaf.over X.ringCatSheaf W.left) :=
  SheafOfModules.overFunctor.{u} (X.ringCatSheaf.over U) W ⋙ (sliceEquiv U W).inverse

/-- Restriction of modules on the slice site over `U` to the slice over `W` is a left
adjoint. -/
noncomputable instance isLeftAdjoint_overFunctor_slice :
    (SheafOfModules.overFunctor.{u} (X.ringCatSheaf.over U) W).IsLeftAdjoint :=
  inferInstanceAs (SheafOfModules.pushforward.{u}
    (𝟙 ((X.ringCatSheaf.over U).over W))).IsLeftAdjoint

/-- `sliceRestrict U W` preserves finite limits. -/
noncomputable instance preservesFiniteLimits_sliceRestrict :
    PreservesFiniteLimits (sliceRestrict U W) :=
  inferInstanceAs (PreservesFiniteLimits
    (SheafOfModules.overFunctor.{u} (X.ringCatSheaf.over U) W ⋙ (sliceEquiv U W).inverse))

/-- `sliceRestrict U W` preserves zero morphisms. -/
noncomputable instance preservesZeroMorphisms_sliceRestrict :
    (sliceRestrict U W).PreservesZeroMorphisms :=
  inferInstanceAs ((SheafOfModules.overFunctor.{u} (X.ringCatSheaf.over U) W ⋙
    (sliceEquiv U W).inverse).PreservesZeroMorphisms)

/-- `sliceRestrict U W` preserves coproducts indexed by `I`. -/
noncomputable instance preservesColimitsOfShape_sliceRestrict (I : Type u) :
    PreservesColimitsOfShape (Discrete I) (sliceRestrict U W) :=
  inferInstanceAs (PreservesColimitsOfShape (Discrete I)
    (SheafOfModules.overFunctor.{u} (X.ringCatSheaf.over U) W ⋙ (sliceEquiv U W).inverse))

/-- The structure sheaf of the slice over `U` restricts to the structure sheaf of the slice
over `W.left`. -/
noncomputable def sliceRestrictUnitIso :
    SheafOfModules.unit.{u} (Sheaf.over X.ringCatSheaf W.left) ≅
      (sliceRestrict U W).obj (SheafOfModules.unit.{u} (Sheaf.over X.ringCatSheaf U)) :=
  Iso.refl _

/-- **Restricting `F.over U` to the slice over `W.left` gives `F.over W.left`.** -/
noncomputable def sliceRestrictObjIso (F : X.Modules) :
    (sliceRestrict U W).obj (F.over U) ≅ F.over W.left :=
  ((sliceEquiv U W).unitIso.app (F.over W.left)).symm

/-- Going back up: the slice restriction of `M` is carried by `sliceEquiv` to `M.over W`. -/
noncomputable def sliceEquivCounitIso (M : SheafOfModules.{u} (Sheaf.over X.ringCatSheaf U)) :
    (sliceEquiv U W).functor.obj ((sliceRestrict U W).obj M) ≅ M.over W :=
  (sliceEquiv U W).counitIso.app (M.over W)

end Slice

/-! ### From the slice site to the spectrum of an affine open -/

section Composite

variable {X : Scheme.{u}} {U : X.Opens} (W : CategoryTheory.Over U) (hV : IsAffineOpen W.left)

/-- **Restriction from the slice site over `U` all the way to `Spec Γ(X, W.left)`**, for `W` an
object of the slice whose underlying open is affine: restrict to the slice over `W.left`, read
the result on the open subscheme `W.left`, then read it on the spectrum. -/
noncomputable def toSpec : SheafOfModules.{u} (Sheaf.over X.ringCatSheaf U) ⥤
    (Spec Γ(X, W.left)).Modules :=
  sliceRestrict U W ⋙ (Scheme.Modules.overEquiv W.left).functor ⋙
    Scheme.Modules.restrictFunctor hV.isoSpec.inv

/-- `toSpec W hV` preserves finite limits. -/
theorem preservesFiniteLimits_toSpec : PreservesFiniteLimits (toSpec W hV) :=
  inferInstanceAs (PreservesFiniteLimits (sliceRestrict U W ⋙
    (Scheme.Modules.overEquiv W.left).functor ⋙
      Scheme.Modules.restrictFunctor hV.isoSpec.inv))

/-- `toSpec W hV` preserves zero morphisms. -/
theorem preservesZeroMorphisms_toSpec : (toSpec W hV).PreservesZeroMorphisms :=
  inferInstanceAs ((sliceRestrict U W ⋙ (Scheme.Modules.overEquiv W.left).functor ⋙
    Scheme.Modules.restrictFunctor hV.isoSpec.inv).PreservesZeroMorphisms)

/-- `toSpec W hV` preserves coproducts indexed by `I`. -/
theorem preservesColimitsOfShape_toSpec (I : Type u) :
    PreservesColimitsOfShape (Discrete I) (toSpec W hV) :=
  inferInstanceAs (PreservesColimitsOfShape (Discrete I) (sliceRestrict U W ⋙
    (Scheme.Modules.overEquiv W.left).functor ⋙
      Scheme.Modules.restrictFunctor hV.isoSpec.inv))

/-- `toSpec` carries the structure sheaf of the slice over `U` to the structure sheaf of the
spectrum. -/
noncomputable def toSpecUnitIso :
    SheafOfModules.unit.{u} (Spec Γ(X, W.left)).ringCatSheaf ≅
      (toSpec W hV).obj (SheafOfModules.unit.{u} (Sheaf.over X.ringCatSheaf U)) :=
  (Scheme.Modules.restrictUnitIso hV.isoSpec.inv).symm ≪≫
    (Scheme.Modules.restrictFunctor hV.isoSpec.inv).mapIso
      (CoherentFinite.overFunctorUnitIso W.left)

/-- `toSpec` carries `F.over U` to the module `specRestrict F hV` of
`Stacks.AlgebraicGeometry.CoherentTFAE`. -/
noncomputable def toSpecObjIso (F : X.Modules) :
    (toSpec W hV).obj (F.over U) ≅ specRestrict F hV :=
  (Scheme.Modules.restrictFunctor hV.isoSpec.inv).mapIso
    ((Scheme.Modules.overEquiv W.left).functor.mapIso (sliceRestrictObjIso U W F) ≪≫
      (Scheme.Modules.overFunctorEquiv W.left).app F)

end Composite

/-! ### The affine cover of a slice site -/

section Cover

variable {X : Scheme.{u}}

/-- An affine open contained in `U`, read as an object of the slice site over `U`. -/
abbrev affineSlice (U : X.Opens) (V : {V : X.affineOpens // (V : X.Opens) ≤ U}) :
    CategoryTheory.Over U :=
  Over.mk (homOfLE V.2)

/-- **The affine opens contained in `U` cover the terminal object of the slice site over `U`.**
Affine opens form a basis of the topology, so every object of the slice is covered by the ones
among them that it contains. -/
theorem coversTop_affineSlice (U : X.Opens) :
    ((Opens.grothendieckTopology _).over U).CoversTop (affineSlice U) := by
  intro Z
  rw [GrothendieckTopology.mem_over_iff, Opens.mem_grothendieckTopology]
  intro x hx
  obtain ⟨V, hVmem, hxV, hVle⟩ :=
    Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens (U := Z.left) hx
  refine ⟨V, homOfLE hVle, ?_, hxV⟩
  rw [Sieve.overEquiv_iff, Sieve.mem_ofObjects_iff]
  exact ⟨⟨⟨V, hVmem⟩, le_trans hVle (leOfHom Z.hom)⟩, ⟨Over.homMk (homOfLE le_rfl)⟩⟩

end Cover

/-! ### The kernel condition of coherence -/

section Main

variable {X : Scheme.{u}} (F : X.Modules)

/-- **The kernel of a map from a finite free module on the slice site over `U` is generated by
finitely many sections over every affine `W ≤ U` whose coordinate ring is Noetherian.**

The kernel is pushed all the way to `Spec Γ(X, W.left)` by `toSpec`, where it becomes the kernel
of a map from a finite free module onto a quasi-coherent module and
`exists_finite_generatingSections_kernel_spec` applies; the generating sections obtained there
are then carried back through the three transports by `generatingSectionsOfMap`. -/
theorem exists_finite_generatingSections_overKernel [F.IsQuasicoherent] {U : X.Opens}
    (W : CategoryTheory.Over U) (hV : IsAffineOpen W.left)
    [hnoeth : IsNoetherianRing Γ(X, W.left)] {I : Type u} [hfin : Finite I]
    (φ : (free I : SheafOfModules.{u} (Sheaf.over X.ringCatSheaf U)) ⟶ F.over U) :
    ∃ σ : ((kernel φ).over W).GeneratingSections, Finite σ.I := by
  have hcol : PreservesColimitsOfShape (Discrete I) (toSpec W hV) :=
    preservesColimitsOfShape_toSpec W hV I
  have _hqc : (specRestrict F hV).IsQuasicoherent := inferInstance
  have hc1 : PreservesColimitsOfSize.{u, u} (sliceEquiv U W).functor := inferInstance
  have hc2 : PreservesColimitsOfSize.{u, u} (Scheme.Modules.overEquiv W.left).inverse :=
    inferInstance
  have hc3 : PreservesColimitsOfSize.{u, u}
      (Scheme.Modules.restrictFunctor hV.isoSpec.hom) := inferInstance
  have hκ : (toSpec W hV).obj (kernel φ) ≅
      kernel (mapFreeHom (I := I) (hcolim := hcol) (toSpec W hV) (toSpecUnitIso W hV) φ
        (toSpecObjIso W hV F)) :=
    kernelMapFreeIso (I := I) (hcolim := hcol) (hlim := preservesFiniteLimits_toSpec W hV)
      (hzero := preservesZeroMorphisms_toSpec W hV) (toSpec W hV) (toSpecUnitIso W hV) φ
      (toSpecObjIso W hV F)
  obtain ⟨σ, hσ⟩ := exists_finite_generatingSections_kernel_spec (specRestrict F hV)
    (mapFreeHom (I := I) (hcolim := hcol) (toSpec W hV) (toSpecUnitIso W hV) φ
      (toSpecObjIso W hV F))
  refine ⟨generatingSectionsOfMap (hcolimΨ := hc1) (sliceEquiv U W).functor
    (sliceEquivUnitIso U W) (sliceEquivCounitIso U W (kernel φ))
    (generatingSectionsOfMap (hcolimΨ := hc2)
      (Scheme.Modules.overEquiv W.left).inverse
      (AffinePushforward.overInverseUnitIso W.left)
      (((Scheme.Modules.overEquiv W.left).unitIso.app
        ((sliceRestrict U W).obj (kernel φ))).symm)
      (generatingSectionsOfMap (hcolimΨ := hc3)
        (Scheme.Modules.restrictFunctor hV.isoSpec.hom)
        (Scheme.Modules.restrictUnitIso hV.isoSpec.hom).symm
        (restrictIsoSelf hV.isoSpec
          ((Scheme.Modules.overEquiv W.left).functor.obj ((sliceRestrict U W).obj (kernel φ))))
        (GeneratingSections.equivOfIso hκ.symm σ))), ?_⟩
  exact hσ

/-- **The kernel condition of [Stacks, Tag 01BV] holds for a quasi-coherent module on a locally
Noetherian scheme.** The affine opens contained in `U` cover the slice site over `U`, and over
each of them the kernel is generated by finitely many sections. -/
theorem isFiniteType_kernel [IsLocallyNoetherian X] [F.IsQuasicoherent] (U : X.Opens)
    (I : Type u) (hI : Finite I)
    (φ : (free I : SheafOfModules.{u} (Sheaf.over X.ringCatSheaf U)) ⟶ F.over U) :
    (kernel φ).IsFiniteType := by
  have hgen : ∀ V : {V : X.affineOpens // (V : X.Opens) ≤ U},
      ∃ σ : ((kernel φ).over (affineSlice U V)).GeneratingSections, Finite σ.I := fun V =>
    exists_finite_generatingSections_overKernel
      (hnoeth := IsLocallyNoetherian.component_noetherian V.1) (hfin := hI) F
      (affineSlice U V) V.1.2 φ
  choose σ hσ using hgen
  exact isFiniteType_of_coversTop (kernel φ) (affineSlice U) (coversTop_affineSlice U) σ hσ

/-- **[Stacks, Tag 01XZ], the implication (2) ⇒ (1): a quasi-coherent module of finite type on a
locally Noetherian scheme is coherent.** -/
theorem isCoherent_of_isQuasicoherent_isFiniteType [IsLocallyNoetherian X] [F.IsQuasicoherent]
    [F.IsFiniteType] : F.IsCoherent where
  isFiniteType := ‹F.IsFiniteType›
  kernel_isFiniteType U I hI φ := isFiniteType_kernel F U I hI φ

end Main

/-! ### The structure sheaf is of finite type -/

section Unit

variable {C : Type u'} [Category.{v'} C] {J : GrothendieckTopology C} {R : Sheaf J RingCat.{u}}
  [HasWeakSheafify J AddCommGrpCat.{u}] [J.WEqualsLocallyBijective AddCommGrpCat.{u}]
  [∀ Y : C, HasSheafify (J.over Y) AddCommGrpCat.{u}]
  [∀ Y : C, (J.over Y).WEqualsLocallyBijective AddCommGrpCat.{u}] [HasBinaryProducts C]

/-- **The structure sheaf is generated by one global section**, namely the one corresponding to
its identity morphism. The associated map `free PUnit ⟶ unit R` is a split epimorphism, with
`SheafOfModules.ιFree` as a section. -/
noncomputable def unitGeneratingSections :
    (SheafOfModules.unit R : SheafOfModules.{u} R).GeneratingSections where
  I := PUnit.{u + 1}
  s _ := (SheafOfModules.unit R : SheafOfModules.{u} R).unitHomEquiv (𝟙 _)
  epi := by
    have h : ιFree (R := R) (PUnit.unit : PUnit.{u + 1}) ≫
        (SheafOfModules.unit R : SheafOfModules.{u} R).freeHomEquiv.symm
          (fun _ => (SheafOfModules.unit R : SheafOfModules.{u} R).unitHomEquiv (𝟙 _)) = 𝟙 _ := by
      rw [← unitHomEquiv_symm_freeHomEquiv_apply, Equiv.apply_symm_apply, Equiv.symm_apply_apply]
    exact (IsSplitEpi.mk' ⟨_, h⟩).epi

/-- **The structure sheaf is of finite type.** -/
instance isFiniteType_unit : (SheafOfModules.unit R : SheafOfModules.{u} R).IsFiniteType :=
  have h : Finite (unitGeneratingSections (R := R)).I := inferInstanceAs (Finite PUnit.{u + 1})
  @isFiniteType_of_generatingSections _ _ _ _ _ _ _ _ _ _ (unitGeneratingSections (R := R)) h

end Unit

/-! ### Finite local freeness gives quasi-coherence and finite type -/

section LocallyFree

variable {X : Scheme.{u}} (F : X.Modules)
  [h : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree (R := X.ringCatSheaf) F]

/-- **A finite locally free module is quasi-coherent and of finite type.** The two halves are
`Stacks.FiniteLocallyFree.isFiniteType` and, for quasi-coherence, the relation-free
quasi-coherent data `SheafOfModules.LocalGeneratorsData.quasiCoherentData` attached to a locally
free basis. The bridge `hb` is needed because the repository carries two copies of the predicate
of [Stacks, Tag 01C6] (2) with the same body. -/
theorem isQuasicoherent_isFiniteType_of_isFiniteLocallyFree :
    F.IsQuasicoherent ∧ F.IsFiniteType :=
  have hb : Stacks.FiniteLocallyFree.IsFiniteLocallyFree (R := X.ringCatSheaf) F := by
    constructor
    exact h.exists_isFiniteLocallyFreeData
  have h1 : F.IsFiniteType := Stacks.FiniteLocallyFree.isFiniteType (h := hb) F
  have h2 : F.IsQuasicoherent := by
    obtain ⟨q, hq, -⟩ := h.exists_isFiniteLocallyFreeData
    exact q.quasiCoherentData.isQuasicoherent
  ⟨h2, h1⟩

end LocallyFree

/-! ### The equivalence of [Stacks, Tag 01XZ] and the consequences drawn from it -/

section Consequences

variable (X : Scheme.{u}) [IsLocallyNoetherian X]

/-- **The five equivalent conditions of [Stacks, Tag 01XZ]** for a module on a locally Noetherian
scheme: coherence, quasi-coherence together with finite type, finite presentation, and the two
forms — at every affine open and on some affine open covering — of being the sheaf associated to
a finite module.

Every implication but the two into (1) was available beforehand; the new one is
`isCoherent_of_isQuasicoherent_isFiniteType`. -/
@[stacks 01XZ "five equivalent conditions"]
theorem coherent_tfae (F : X.Modules) :
    List.TFAE [
      F.IsCoherent,
      F.IsQuasicoherent ∧ F.IsFiniteType,
      F.IsFinitePresentation,
      ∀ (U : X.Opens) (hU : IsAffineOpen U), IsFiniteTildeOn F U hU,
      ∃ (ι : Type u) (U : ι → X.Opens),
        IsOpenCover U ∧ ∀ i, ∃ hU : IsAffineOpen (U i), IsFiniteTildeOn F (U i) hU
    ] := by
  tfae_have 1 → 2 := fun hc => @isQuasicoherent_isFiniteType_of_isCoherent _ F hc
  tfae_have 2 → 1 := fun hc => @isCoherent_of_isQuasicoherent_isFiniteType _ F _ hc.1 hc.2
  tfae_have 2 → 3 := fun hc =>
    @isFinitePresentation_of_isCoherent' _ F
      (@isCoherent_of_isQuasicoherent_isFiniteType _ F _ hc.1 hc.2)
  tfae_have 3 → 2 := isQuasicoherent_isFiniteType_of_isFinitePresentation F
  tfae_have 2 → 4 := CoherentFinite.forall_isFiniteTildeOn_of_isQuasicoherent_isFiniteType F
  tfae_have 4 → 5 := exists_affineOpenCover_isFiniteTildeOn F
  tfae_have 5 → 2 := isQuasicoherent_isFiniteType_of_cover_isFiniteTildeOn F
  tfae_finish

/-- **On a locally Noetherian scheme the structure sheaf is coherent.** -/
@[stacks 01XZ "the structure sheaf is coherent"]
theorem structureSheaf_isCoherent : (SheafOfModules.unit X.ringCatSheaf).IsCoherent :=
  isCoherent_of_isQuasicoherent_isFiniteType (SheafOfModules.unit X.ringCatSheaf)

/-- **A finite locally free module on a locally Noetherian scheme is coherent.** -/
@[stacks 01XZ "finite locally free modules are coherent"]
theorem isCoherent_of_isFiniteLocallyFree (F : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree (R := X.ringCatSheaf) F] :
    F.IsCoherent :=
  have h := isQuasicoherent_isFiniteType_of_isFiniteLocallyFree F
  @isCoherent_of_isQuasicoherent_isFiniteType _ F _ h.1 h.2

/-- **An invertible module on a locally Noetherian scheme is coherent.** An invertible module on
a scheme is finite locally free of rank one, by
`Stacks.SheafRankOne.isFiniteLocallyFreeOfRank_one_of_isInvertible_scheme`. -/
@[stacks 01XZ "invertible modules are coherent"]
theorem isCoherent_of_isInvertible (F : X.Modules)
    [AlgebraicGeometry.SheafOfModules.IsInvertible X.presheaf X.ringCatSheaf.2 F] :
    F.IsCoherent :=
  have _h0 : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank
      (R := X.ringCatSheaf) F 1 :=
    Stacks.SheafRankOne.isFiniteLocallyFreeOfRank_one_of_isInvertible_scheme X F
  have h : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFree (R := X.ringCatSheaf) F :=
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree F 1
  @isCoherent_of_isFiniteLocallyFree _ _ F h

end Consequences

end Stacks.AlgebraicGeometry.CoherentKernel

