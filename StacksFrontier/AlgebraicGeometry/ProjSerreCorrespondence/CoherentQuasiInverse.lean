module

public import StacksFrontier.AlgebraicGeometry.CoherentTFAE.Basic
public import StacksFrontier.AlgebraicGeometry.ProjSerreCorrespondence.CoherentQuotientFunctor
public import StacksFrontier.AlgebraicGeometry.ProjSerreCorrespondence.NonnegFinite
public import StacksFrontier.AlgebraicGeometry.ProjSerreCorrespondence.SectionsCounit

/-!
# `ℱ ↦ ⨁_{n ≥ 0} Γ(X, ℱ(n))` is fully faithful into `Mod^fg_A / Mod^fg_{A, torsion}`

Let `A` be a graded ring whose degree-zero part `A₀` is Noetherian and which is generated by
finitely many elements of `A₁` over `A₀`, and let `X = Proj A`. The functor
`ℱ ↦ ⨁_{n ≥ 0} Γ(X, ℱ(n))` from `Coh(𝒪_X)` to the quotient category
`Mod^fg_A / Mod^fg_{A, torsion}` is fully faithful, and its composite with the functor `M ↦ M̃`
out of the quotient category is isomorphic to the identity of `Coh(𝒪_X)`.

## Main definitions

* `Stacks.AlgebraicGeometry.ProjSerreCorrespondence.nonnegTwistedSectionsQuotientFunctor`: the
  functor `Coh(𝒪_X) ⟶ Mod^fg_A / Mod^fg_{A, torsion}`, the functor `ℱ ↦ ⨁_{n ≥ 0} Γ(X, ℱ(n))`
  followed by the quotient functor.
* `Stacks.AlgebraicGeometry.ProjSerreCorrespondence.coherentCounitIso`: a natural isomorphism from
  the composite with `M ↦ M̃` to the identity of `Coh(𝒪_X)`.

## Main results

* `Stacks.AlgebraicGeometry.ProjSerreCorrespondence.faithful_nonnegTwistedSectionsQuotientFunctor`
  and
  `Stacks.AlgebraicGeometry.ProjSerreCorrespondence.full_nonnegTwistedSectionsQuotientFunctor`:
  the functor `ℱ ↦ ⨁_{n ≥ 0} Γ(X, ℱ(n))` into the quotient category is fully faithful.

## References

* [Stacks Project, Tag 0BXD](https://stacks.math.columbia.edu/tag/0BXD)
* [Stacks Project, Tag 0AG5](https://stacks.math.columbia.edu/tag/0AG5)
* [Stacks Project, Tag 01XZ](https://stacks.math.columbia.edu/tag/01XZ)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace AlgebraicGeometry
open Stacks.AlgebraicGeometry.ProjSheafFunctoriality
open Stacks.AlgebraicGeometry.ProjTwistFunctor (projRingSheaf)

namespace Stacks.AlgebraicGeometry.ProjSerreCorrespondence

universe u

variable {A : Type u} {σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] [IsNoetherianRing (𝒜 0)] [IsNoetherianRing A]
  [Algebra.FiniteType (𝒜 0) A] [CompactSpace (AlgebraicGeometry.Proj 𝒜)]
  {n : ℕ} (x : Fin n → A) (hx : ∀ i, x i ∈ 𝒜 1)
  (hgen : Algebra.adjoin (𝒜 0) (Set.range x) = ⊤)

/-! ### The functor into the quotient category -/

/-- The functor

`Coh(𝒪_X) ⟶ Mod^fg_A / Mod^fg_{A, torsion}`

sending a coherent `𝒪_X`-module `ℱ` to the class of the finitely generated graded `A`-module
`⨁_{n ≥ 0} Γ(X, ℱ(n))`. -/
def nonnegTwistedSectionsQuotientFunctor :
    Stacks.SheafOfModules.CoherentModules (projRingSheaf 𝒜) ⥤
      IrrelevantQuotient.{u, u, u} 𝒜 (d := 1) Nat.one_pos :=
  nonnegTwistedSectionsCoherentFunctor 𝒜 x hx hgen ⋙
    toIrrelevantQuotient.{u, u, u} 𝒜 Nat.one_pos

/-! ### The counit -/

omit [IsNoetherianRing (𝒜 0)] [IsNoetherianRing A] [Algebra.FiniteType (𝒜 0) A]
  [CompactSpace (AlgebraicGeometry.Proj 𝒜)] in
/-- A coherent module on `Proj A` is quasi-coherent. -/
theorem isQuasicoherent_of_coherentModules
    (F : Stacks.SheafOfModules.CoherentModules (projRingSheaf 𝒜)) :
    SheafOfModules.IsQuasicoherent (R := (AlgebraicGeometry.Proj 𝒜).ringCatSheaf) F.obj :=
  have : _root_.SheafOfModules.IsCoherent F.obj :=
    AlgebraicGeometry.CoherentAbelian.isCoherent_of_stacksIsCoherent F.property
  _root_.isQuasicoherent_of_isCoherent F.obj

/-- The component of `nonnegSectionsCounit` at a coherent module is an isomorphism. -/
instance isIso_nonnegSectionsCounit_app_coherentModules
    (F : Stacks.SheafOfModules.CoherentModules (projRingSheaf 𝒜)) :
    IsIso ((nonnegSectionsCounit.{u, u} 𝒜).app F.obj) :=
  isIso_nonnegSectionsCounit_app 𝒜 F.obj (isQuasicoherent_of_coherentModules 𝒜 F)

/-- The natural transformation `nonnegSectionsCounit`, restricted to the coherent modules, as a
natural isomorphism. -/
def coherentSectionsCounitIso :
    (Stacks.SheafOfModules.coherentModules (projRingSheaf 𝒜)).ι ⋙
        (nonnegTwistedSectionsFunctor.{u, u} 𝒜 ⋙ associatedModuleSheafFunctor.{u, u, u} 𝒜) ≅
      (Stacks.SheafOfModules.coherentModules (projRingSheaf 𝒜)).ι :=
  haveI : ∀ F : Stacks.SheafOfModules.CoherentModules (projRingSheaf 𝒜),
      IsIso ((Functor.whiskerLeft
        (Stacks.SheafOfModules.coherentModules (projRingSheaf 𝒜)).ι
        (nonnegSectionsCounit.{u, u} 𝒜)).app F) :=
    fun F => isIso_nonnegSectionsCounit_app 𝒜 F.obj (isQuasicoherent_of_coherentModules 𝒜 F)
  haveI : IsIso (Functor.whiskerLeft
      (Stacks.SheafOfModules.coherentModules (projRingSheaf 𝒜)).ι
      (nonnegSectionsCounit.{u, u} 𝒜)) :=
    NatIso.isIso_of_isIso_app _
  asIso (Functor.whiskerLeft (Stacks.SheafOfModules.coherentModules (projRingSheaf 𝒜)).ι
    (nonnegSectionsCounit.{u, u} 𝒜))

/-- The composite of `nonnegTwistedSectionsQuotientFunctor` with the functor `M ↦ M̃` out of the
quotient category is naturally isomorphic to the identity of `Coh(𝒪_X)`. -/
def coherentCounitIso :
    nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen ⋙ coherentQuotientFunctor.{u, u} 𝒜 ≅
      𝟭 (Stacks.SheafOfModules.CoherentModules (projRingSheaf 𝒜)) :=
  Functor.fullyFaithfulCancelRight
    (Stacks.SheafOfModules.coherentModules (projRingSheaf 𝒜)).ι
    (Functor.associator (nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen)
        (coherentQuotientFunctor.{u, u} 𝒜)
        (Stacks.SheafOfModules.coherentModules (projRingSheaf 𝒜)).ι ≪≫
      Functor.isoWhiskerLeft (nonnegTwistedSectionsCoherentFunctor 𝒜 x hx hgen)
        (Functor.isoWhiskerRight (coherentQuotientFunctorFac.{u, u} 𝒜)
          (Stacks.SheafOfModules.coherentModules (projRingSheaf 𝒜)).ι) ≪≫
      coherentSectionsCounitIso 𝒜 ≪≫
      (Functor.leftUnitor (Stacks.SheafOfModules.coherentModules (projRingSheaf 𝒜)).ι).symm)

/-! ### Full faithfulness -/

omit [Algebra.FiniteType (𝒜 0) A] in
/-- The functor `nonnegTwistedSectionsQuotientFunctor` is faithful. -/
theorem faithful_nonnegTwistedSectionsQuotientFunctor :
    (nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen).Faithful :=
  Functor.Faithful.of_comp_iso (coherentCounitIso 𝒜 x hx hgen)

omit [Algebra.FiniteType (𝒜 0) A] in
/-- If `A` is generated by `A₁` over `A₀`, the functor `nonnegTwistedSectionsQuotientFunctor` is
full. -/
theorem full_nonnegTwistedSectionsQuotientFunctor
    (hgen' : Algebra.adjoin (𝒜 0) ((𝒜 1 : Set A)) = ⊤) :
    (nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen).Full :=
  have := faithful_coherentQuotientFunctor.{u, u} 𝒜 hgen'
  Functor.Full.of_comp_faithful_iso (coherentCounitIso 𝒜 x hx hgen)

end Stacks.AlgebraicGeometry.ProjSerreCorrespondence

end
