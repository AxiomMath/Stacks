/-! ### The consequences of the source's hypotheses -/

section Derived

variable {A : Type u} {σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] [IsNoetherianRing (𝒜 0)]
  {m : ℕ} (x : Fin m → A) (hx : ∀ i, x i ∈ 𝒜 1)
  (hgen : Algebra.adjoin (𝒜 0) (Set.range x) = ⊤)

include hx hgen

/-- **`A` is Noetherian** when `A₀` is and `A` is generated over `A₀` by finitely many elements of
`A₁`, for a generating family indexed by an arbitrary `Fin m`. -/
theorem isNoetherianRing_of_adjoin_range : IsNoetherianRing A := by
  obtain ⟨k, y, -, hygen⟩ := Stacks.ProjCoherentDegreeOne.exists_two_le_generators 𝒜 x hx hgen
  exact Stacks.ProjCoherentDegreeOne.isNoetherianRing 𝒜 y hygen

omit [IsNoetherianRing (𝒜 0)] in
/-- **`A` is a finitely generated `A₀`-algebra**, for a generating family indexed by an arbitrary
`Fin m`. -/
theorem finiteType_of_adjoin_range : Algebra.FiniteType (𝒜 0) A := by
  obtain ⟨k, y, -, hygen⟩ := Stacks.ProjCoherentDegreeOne.exists_two_le_generators 𝒜 x hx hgen
  exact Stacks.ProjCoherentDegreeOne.finiteType 𝒜 y hygen

omit [IsNoetherianRing (𝒜 0)] in
/-- **The standard opens of the degree-one homogeneous elements cover `Proj A`**. -/
theorem degreeOneCover_of_adjoin_range : DegreeOneCover 𝒜 := by
  obtain ⟨k, y, hy, hygen⟩ := Stacks.ProjCoherentDegreeOne.exists_two_le_generators 𝒜 x hx hgen
  exact le_antisymm le_top
    ((Stacks.ProjCoherentDegreeOne.iSup_basicOpen_eq_top 𝒜 y hy hygen).ge.trans
      (iSup_le fun i => le_iSup_of_le ⟨y i, hy i⟩ le_rfl))

end Derived

/-! ### The comparison `M_{≥ 0} ⟶ ⨁_{n ≥ 0} Γ(X, M̃(n))` -/

section Comparison

variable {A : Type u} {σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] [IsNoetherianRing A]

attribute [local instance] twistedGlobalSectionsModuleInstance nonnegTwistedSectionsModule
  shiftedGlobalSectionsModuleInstance

/-- **The degree-`≥ 0` truncation of a finitely generated graded module**, as an object of
`Mod^fg_A`. -/
def nonnegTruncation (N : FiniteGradedModules.{u, u, u} 𝒜) : FiniteGradedModules.{u, u, u} 𝒜 :=
  ⟨gradedTruncation 𝒜 N.obj 0, moduleFinite_gradedTruncation 𝒜 N.obj N.property 0⟩

/-- **The inclusion `M_{≥ 0} ⟶ M`** of the degree-`≥ 0` truncation, in `Mod^fg_A`. -/
def nonnegTruncationι (N : FiniteGradedModules.{u, u, u} 𝒜) : nonnegTruncation 𝒜 N ⟶ N :=
  ⟨gradedTruncationι 𝒜 N.obj 0⟩

/-- **The inclusion of the degree-`≥ 0` truncation is an isomorphism in the quotient category.** -/
theorem isIso_toIrrelevantQuotient_map_nonnegTruncationι
    (hgen : Algebra.adjoin (𝒜 0) ((𝒜 1 : Set A)) = ⊤)
    (N : FiniteGradedModules.{u, u, u} 𝒜) :
    IsIso ((toIrrelevantQuotient.{u, u, u} 𝒜 Nat.one_pos).map (nonnegTruncationι 𝒜 N)) :=
  isIso_toIrrelevantQuotient_map 𝒜 hgen (nonnegTruncationι 𝒜 N)
    (isIso_map_gradedTruncationι 𝒜 N.obj 0)

/-- **The canonical map `M ⟶ ⨁_{n ∈ ℤ} Γ(X, M̃(n))`**: the map of Tag 01MR into
`⨁_{n ∈ ℤ} Γ(X, M(n)~)`, read through the identification of that graded module with
`⨁_{n ∈ ℤ} Γ(X, M̃(n))` of Tag 0B5R (3). -/
def canonicalTwistedComparison (hcover : DegreeOneCover 𝒜)
    (N : FiniteGradedModules.{u, u, u} 𝒜) :
    N.obj ⟶ twistedSectionsGradedModule 𝒜 (associatedModuleSheaf 𝒜 N.obj.grade) :=
  canonicalShiftedMap 𝒜 N.obj ≫ (twistedShiftedGradedIso 𝒜 N.obj.grade hcover).inv

omit [IsNoetherianRing A] in
/-- Read in `⨁_{n ∈ ℤ} Γ(X, M(n)~)`, the canonical map above is the map of Tag 01MR. -/
theorem twistedToShiftedSections_canonicalTwistedComparison (hcover : DegreeOneCover 𝒜)
    (N : FiniteGradedModules.{u, u, u} 𝒜) (z : N.obj.carrier) :
    twistedToShiftedSections 𝒜 N.obj.grade
        ((canonicalTwistedComparison 𝒜 hcover N).toLinearMap z) =
      (globalSectionsModuleMap 𝒜 N.obj.grade).hom z := by
  have hcomp : canonicalTwistedComparison 𝒜 hcover N ≫
      (twistedShiftedGradedIso 𝒜 N.obj.grade hcover).hom = canonicalShiftedMap 𝒜 N.obj := by
    rw [canonicalTwistedComparison, Category.assoc, Iso.inv_hom_id, Category.comp_id]
  exact congrArg
    (fun g : N.obj ⟶ shiftedSectionsGradedModule 𝒜 N.obj.grade => g.toLinearMap z) hcomp

omit [IsNoetherianRing A] in
/-- The canonical map carries the degree-`≥ 0` truncation into the degree-`≥ 0` truncation of
the twisted global sections. -/
theorem canonicalTwistedComparison_mem_nonneg (hcover : DegreeOneCover 𝒜)
    (N : FiniteGradedModules.{u, u, u} 𝒜) (z : (gradedTruncation 𝒜 N.obj 0).carrier) :
    (gradedTruncationι 𝒜 N.obj 0 ≫ canonicalTwistedComparison 𝒜 hcover N).toLinearMap z ∈
      nonnegTwistedSectionsSubmodule 𝒜 (associatedModuleSheaf 𝒜 N.obj.grade) := by
  induction z using DirectSum.Decomposition.inductionOn (gradedTruncation 𝒜 N.obj 0).grade with
  | zero =>
      rw [map_zero]
      exact Submodule.zero_mem _
  | homogeneous w =>
      rename_i i
      rcases lt_or_ge i 0 with hi | hi
      · have h0 : (w : (gradedTruncation 𝒜 N.obj 0).carrier) = 0 := by
          rw [← AddSubgroup.mem_bot, ← grade_gradedTruncation_eq_bot 𝒜 N.obj (k := 0) hi]
          exact w.2
        rw [h0, map_zero]
        exact Submodule.zero_mem _
      · exact coe_twistedGlobalSectionsGrading_subset_truncation 𝒜
          (associatedModuleSheaf 𝒜 N.obj.grade)
          (twistedGlobalSectionsModule 𝒜 (associatedModuleSheaf 𝒜 N.obj.grade)).smul_homogeneous
          0 i hi
          ((gradedTruncationι 𝒜 N.obj 0 ≫ canonicalTwistedComparison 𝒜 hcover N).map_grade i
            (w : (gradedTruncation 𝒜 N.obj 0).carrier) w.2)
  | add w w' hw hw' =>
      rw [map_add]
      exact Submodule.add_mem _ hw hw'

variable [IsNoetherianRing (𝒜 0)] {m : ℕ} (x : Fin m → A) (hx : ∀ i, x i ∈ 𝒜 1)
  (hgen : Algebra.adjoin (𝒜 0) (Set.range x) = ⊤)

/-- **The comparison `M_{≥ 0} ⟶ ⨁_{n ≥ 0} Γ(X, M̃(n))` in `Mod^fg_A`**. -/
def nonnegComparison (hcover : DegreeOneCover 𝒜) (N : FiniteGradedModules.{u, u, u} 𝒜)
    (hF : Stacks.SheafOfModules.IsCoherent (associatedModuleSheaf 𝒜 N.obj.grade)) :
    nonnegTruncation 𝒜 N ⟶
      nonnegTwistedSectionsFiniteObj 𝒜 x hx hgen
        (associatedModuleSheaf 𝒜 N.obj.grade) hF :=
  ⟨{ toLinearMap :=
      { toFun := fun z =>
          ⟨(gradedTruncationι 𝒜 N.obj 0 ≫ canonicalTwistedComparison 𝒜 hcover N).toLinearMap z,
            canonicalTwistedComparison_mem_nonneg 𝒜 hcover N z⟩
        map_add' := fun z w => Subtype.ext (map_add _ z w)
        map_smul' := fun a z => Subtype.ext (map_smul _ a z) }
     map_grade := fun i z hz =>
      (gradedTruncationι 𝒜 N.obj 0 ≫ canonicalTwistedComparison 𝒜 hcover N).map_grade i z hz }⟩

/-- The underlying map of the comparison, read in the ambient twisted global sections. -/
theorem coe_nonnegComparison_apply (hcover : DegreeOneCover 𝒜)
    (N : FiniteGradedModules.{u, u, u} 𝒜)
    (hF : Stacks.SheafOfModules.IsCoherent (associatedModuleSheaf 𝒜 N.obj.grade))
    (z : (gradedTruncation 𝒜 N.obj 0).carrier) :
    ((nonnegComparison 𝒜 x hx hgen hcover N hF).hom.toLinearMap z :
        ↥(nonnegTwistedSectionsSubmodule 𝒜 (associatedModuleSheaf 𝒜 N.obj.grade))).val =
      (canonicalTwistedComparison 𝒜 hcover N).toLinearMap
        ((gradedTruncationι 𝒜 N.obj 0).toLinearMap z) :=
  rfl

/-- **The kernel of the comparison is torsion**: a homogeneous element of `M_{≥ 0}` killed by the
comparison is annihilated by every homogeneous scalar of large enough degree. -/
theorem exists_forall_smul_eq_zero_of_nonnegComparison_eq_zero
    (hgen1 : Algebra.adjoin (𝒜 0) ((𝒜 1 : Set A)) = ⊤) (hcover : DegreeOneCover 𝒜)
    (N : FiniteGradedModules.{u, u, u} 𝒜)
    (hF : Stacks.SheafOfModules.IsCoherent (associatedModuleSheaf 𝒜 N.obj.grade))
    (i : ℤ) (y : (gradedTruncation 𝒜 N.obj 0).carrier)
    (hy : y ∈ (gradedTruncation 𝒜 N.obj 0).grade i)
    (hzero : (nonnegComparison 𝒜 x hx hgen hcover N hF).hom.toLinearMap y = 0) :
    ∃ P : ℕ, ∀ k : ℕ, P ≤ k → ∀ a ∈ 𝒜 k, a • y = 0 := by
  have hmem : (gradedTruncationι 𝒜 N.obj 0).toLinearMap y ∈ N.obj.grade i :=
    (gradedTruncationι 𝒜 N.obj 0).map_grade i y hy
  have hzero' : ((nonnegComparison 𝒜 x hx hgen hcover N hF).hom.toLinearMap y :
      ↥(nonnegTwistedSectionsSubmodule 𝒜 (associatedModuleSheaf 𝒜 N.obj.grade))) = 0 := hzero
  have hvanish : (canonicalTwistedComparison 𝒜 hcover N).toLinearMap
      ((gradedTruncationι 𝒜 N.obj 0).toLinearMap y) =
        (0 : twistedGlobalSections 𝒜 (associatedModuleSheaf 𝒜 N.obj.grade)) :=
    (coe_nonnegComparison_apply 𝒜 x hx hgen hcover N hF y).symm.trans
      (congrArg Subtype.val hzero')
  have hshift : (globalSectionsModuleMap 𝒜 N.obj.grade).hom
      ((gradedTruncationι 𝒜 N.obj 0).toLinearMap y) = 0 := by
    rw [← twistedToShiftedSections_canonicalTwistedComparison 𝒜 hcover N, hvanish, map_zero]
  have hof : (globalSectionsModuleMap 𝒜 N.obj.grade).hom
      ((gradedTruncationι 𝒜 N.obj 0).toLinearMap y) =
      DirectSum.of (fun k : ℤ => shiftedSectionsComponent 𝒜 N.obj.grade k) i
        (degreeNToGlobalSections 𝒜 N.obj.grade i ⟨_, hmem⟩) :=
    (globalSectionsModuleMap 𝒜 N.obj.grade).map_homogeneous i ⟨_, hmem⟩
  have hsec : degreeNToGlobalSections 𝒜 N.obj.grade i ⟨_, hmem⟩ = 0 := by
    have h := congrArg
      (DirectSum.component ℤ ℤ (fun k : ℤ => shiftedSectionsComponent 𝒜 N.obj.grade k) i)
      (hof.symm.trans hshift)
    rwa [← DirectSum.apply_eq_component, DirectSum.of_eq_same, map_zero] at h
  obtain ⟨P, hP⟩ := exists_irrelevant_pow_smul_eq_zero_of_degreeNToGlobalSections_eq_zero
    𝒜 N.obj.grade hgen1 i ⟨_, hmem⟩ hsec
  refine ⟨P, fun k hk a ha => Subtype.ext ?_⟩
  exact ProjLargeDegreeSections.smul_eq_zero_of_irrelevant_pow_annihilates 𝒜 hgen1 hP hk ha

/-- **The cokernel of the comparison is torsion.** A homogeneous element of
`⨁_{n ≥ 0} Γ(X, M̃(n))` is carried into the image of the comparison by every homogeneous scalar
of large enough degree. -/
theorem exists_forall_mem_range_nonnegComparison
    (hgen1 : Algebra.adjoin (𝒜 0) ((𝒜 1 : Set A)) = ⊤) (hcover : DegreeOneCover 𝒜)
    (N : FiniteGradedModules.{u, u, u} 𝒜)
    (hF : Stacks.SheafOfModules.IsCoherent (associatedModuleSheaf 𝒜 N.obj.grade))
    (i : ℤ)
    (t : ↥(nonnegTwistedSectionsSubmodule 𝒜 (associatedModuleSheaf 𝒜 N.obj.grade)))
    (ht : t ∈ nonnegTwistedSectionsGrade 𝒜 (associatedModuleSheaf 𝒜 N.obj.grade) i) :
    ∃ P : ℕ, ∀ k : ℕ, P ≤ k → ∀ a ∈ 𝒜 k,
      ∃ w : (gradedTruncation 𝒜 N.obj 0).carrier,
        a • t = (nonnegComparison 𝒜 x hx hgen hcover N hF).hom.toLinearMap w := by
  have hinj := (bijective_twistedToShiftedSections 𝒜 N.obj.grade hcover).1
  rcases lt_or_ge i 0 with hi | hi
  · have h0 : t = 0 := AddSubgroup.mem_bot.mp
      ((nonnegTwistedSectionsGrade_eq_bot 𝒜
        (associatedModuleSheaf 𝒜 N.obj.grade) i hi).le ht)
    refine ⟨0, fun k _ a _ => ⟨0, ?_⟩⟩
    rw [h0, smul_zero]
    exact (map_zero (nonnegComparison 𝒜 x hx hgen hcover N hF).hom.toLinearMap).symm
  obtain ⟨s', hs'⟩ := (DirectSum.mem_rangeGrading ℤ
    (fun j : ℤ => twistedSectionsComponent 𝒜 (associatedModuleSheaf 𝒜 N.obj.grade) j) i
    (t : twistedGlobalSections 𝒜 (associatedModuleSheaf 𝒜 N.obj.grade))).mp
    ((mem_nonnegTwistedSectionsGrade 𝒜 (associatedModuleSheaf 𝒜 N.obj.grade) i t).mp ht)
  obtain ⟨P, hP⟩ := exists_irrelevant_pow_smul_mem_range_degreeNToGlobalSections
    𝒜 N.obj.grade hgen1 x hx hgen i (twistedToShiftedComponent 𝒜 N.obj.grade i s')
  refine ⟨P, fun k hk a ha => ?_⟩
  obtain ⟨mm, hmm⟩ := hP k ⟨a, ha⟩ (Ideal.pow_le_pow_right hk
    (AlgebraicGeometry.ProjectiveSpectrum.Proj.mem_irrelevant_pow_of_mem 𝒜 hgen1 k ha))
  have hdeg : (0 : ℤ) ≤ (k : ℤ) + i := by omega
  obtain ⟨w, -, hw⟩ := exists_gradedTruncationι_eq 𝒜 N.obj (k := 0) hdeg mm.2
  refine ⟨w, Subtype.ext (hinj ?_)⟩
  have hsmul : twistedToShiftedSections 𝒜 N.obj.grade
      (a • (t : twistedGlobalSections 𝒜 (associatedModuleSheaf 𝒜 N.obj.grade))) =
      ((⟨a, ha⟩ : 𝒜 k) : A) • twistedToShiftedSections 𝒜 N.obj.grade
        (t : twistedGlobalSections 𝒜 (associatedModuleSheaf 𝒜 N.obj.grade)) :=
    ProjCoherentII.twistedToShiftedSections_smul 𝒜 N.obj.grade _ _
  change twistedToShiftedSections 𝒜 N.obj.grade
      (a • (t : twistedGlobalSections 𝒜 (associatedModuleSheaf 𝒜 N.obj.grade))) =
    twistedToShiftedSections 𝒜 N.obj.grade
      ((canonicalTwistedComparison 𝒜 hcover N).toLinearMap
        ((gradedTruncationι 𝒜 N.obj 0).toLinearMap w))
  rw [hsmul, hs', twistedToShiftedSections_of,
    globalSectionsModuleMap_smul_of 𝒜 N.obj.grade k i ⟨a, ha⟩, hmm,
    twistedToShiftedSections_canonicalTwistedComparison 𝒜 hcover N, hw]
  exact ((globalSectionsModuleMap 𝒜 N.obj.grade).map_homogeneous ((k : ℤ) + i) mm).symm

/-- **The comparison is an isomorphism in the quotient category.** -/
theorem isIso_toIrrelevantQuotient_map_nonnegComparison
    (hgen1 : Algebra.adjoin (𝒜 0) ((𝒜 1 : Set A)) = ⊤) (hcover : DegreeOneCover 𝒜)
    (N : FiniteGradedModules.{u, u, u} 𝒜)
    (hF : Stacks.SheafOfModules.IsCoherent (associatedModuleSheaf 𝒜 N.obj.grade)) :
    IsIso ((toIrrelevantQuotient.{u, u, u} 𝒜 Nat.one_pos).map
      (nonnegComparison 𝒜 x hx hgen hcover N hF)) :=
  isIso_toIrrelevantQuotient_map_of_elements 𝒜 (nonnegComparison 𝒜 x hx hgen hcover N hF)
    (fun i y hy hzero =>
      exists_forall_smul_eq_zero_of_nonnegComparison_eq_zero 𝒜 x hx hgen hgen1 hcover N hF
        i y hy hzero)
    (fun i t ht =>
      exists_forall_mem_range_nonnegComparison 𝒜 x hx hgen hgen1 hcover N hF i t ht)

/-! ### The equivalence -/

/-- **The candidate quasi-inverse is essentially surjective.** -/
theorem essSurj_nonnegTwistedSectionsQuotientFunctor
    [Algebra.FiniteType (𝒜 0) A] [CompactSpace (AlgebraicGeometry.Proj 𝒜)]
    (hgen1 : Algebra.adjoin (𝒜 0) ((𝒜 1 : Set A)) = ⊤) (hcover : DegreeOneCover 𝒜) :
    (nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen).EssSurj := by
  have := isSerreClass_irrelevantModules.{u, u, u} 𝒜 Nat.one_pos
  have := CategoryTheory.Localization.essSurj (toIrrelevantQuotient.{u, u, u} 𝒜 Nat.one_pos)
    (ObjectProperty.isoModSerre (irrelevantModules.{u, u, u} 𝒜 1))
  refine ⟨fun Z => ⟨(finiteCoherentSheafFunctor.{u, u} 𝒜).obj
      ((toIrrelevantQuotient.{u, u, u} 𝒜 Nat.one_pos).objPreimage Z), ⟨?_⟩⟩⟩
  set N := (toIrrelevantQuotient.{u, u, u} 𝒜 Nat.one_pos).objPreimage Z
  have := isIso_toIrrelevantQuotient_map_nonnegComparison 𝒜 x hx hgen hgen1 hcover N
    ((finiteCoherentSheafFunctor.{u, u} 𝒜).obj N).property
  have := isIso_toIrrelevantQuotient_map_nonnegTruncationι 𝒜 hgen1 N
  exact (asIso ((toIrrelevantQuotient.{u, u, u} 𝒜 Nat.one_pos).map
        (nonnegComparison 𝒜 x hx hgen hcover N
          ((finiteCoherentSheafFunctor.{u, u} 𝒜).obj N).property))).symm ≪≫
      asIso ((toIrrelevantQuotient.{u, u, u} 𝒜 Nat.one_pos).map (nonnegTruncationι 𝒜 N)) ≪≫
    (toIrrelevantQuotient.{u, u, u} 𝒜 Nat.one_pos).objObjPreimageIso Z

/-- **The candidate quasi-inverse is an equivalence.** -/
@[ega "III 2.3.3" "special case"]
theorem isEquivalence_nonnegTwistedSectionsQuotientFunctor
    [Algebra.FiniteType (𝒜 0) A] [CompactSpace (AlgebraicGeometry.Proj 𝒜)]
    (hgen1 : Algebra.adjoin (𝒜 0) ((𝒜 1 : Set A)) = ⊤) (hcover : DegreeOneCover 𝒜) :
    (nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen).IsEquivalence where
  faithful := faithful_nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen
  full := full_nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen hgen1
  essSurj := essSurj_nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen hgen1 hcover

/-- **The inverse of the candidate quasi-inverse is `M ↦ M̃`**: it is isomorphic to
`coherentQuotientFunctor`. -/
@[ega "III 2.3.3" "degree-one case"]
def invIsoCoherentQuotientFunctor [Algebra.FiniteType (𝒜 0) A]
    [CompactSpace (AlgebraicGeometry.Proj 𝒜)]
    (hgen1 : Algebra.adjoin (𝒜 0) ((𝒜 1 : Set A)) = ⊤) (hcover : DegreeOneCover 𝒜) :
    haveI := isEquivalence_nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen hgen1 hcover
    (nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen).inv ≅ coherentQuotientFunctor.{u, u} 𝒜 :=
  haveI := isEquivalence_nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen hgen1 hcover
  (Functor.rightUnitor (nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen).inv).symm ≪≫
    Functor.isoWhiskerLeft (nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen).inv
      (coherentCounitIso 𝒜 x hx hgen).symm ≪≫
    (Functor.associator (nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen).inv
      (nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen)
      (coherentQuotientFunctor.{u, u} 𝒜)).symm ≪≫
    Functor.isoWhiskerRight
      (nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen).asEquivalence.counitIso
      (coherentQuotientFunctor.{u, u} 𝒜) ≪≫
    Functor.leftUnitor (coherentQuotientFunctor.{u, u} 𝒜)

/-- **The equivalence of Stacks 0BXD**, with `M ↦ M̃` for its functor and
`ℱ ↦ ⨁_{n ≥ 0} Γ(X, ℱ(n))` for its inverse on the nose. -/
def serreEquivalence [Algebra.FiniteType (𝒜 0) A] [CompactSpace (AlgebraicGeometry.Proj 𝒜)]
    (hgen1 : Algebra.adjoin (𝒜 0) ((𝒜 1 : Set A)) = ⊤) (hcover : DegreeOneCover 𝒜) :
    IrrelevantQuotient.{u, u, u} 𝒜 (d := 1) Nat.one_pos ≌
      Stacks.SheafOfModules.CoherentModules (projRingSheaf 𝒜) :=
  haveI := isEquivalence_nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen hgen1 hcover
  Equivalence.changeFunctor
    (nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen).asEquivalence.symm
    (invIsoCoherentQuotientFunctor 𝒜 x hx hgen hgen1 hcover)

/-- The functor of the equivalence is `M ↦ M̃` out of the quotient category. -/
theorem serreEquivalence_functor [Algebra.FiniteType (𝒜 0) A]
    [CompactSpace (AlgebraicGeometry.Proj 𝒜)]
    (hgen1 : Algebra.adjoin (𝒜 0) ((𝒜 1 : Set A)) = ⊤) (hcover : DegreeOneCover 𝒜) :
    (serreEquivalence 𝒜 x hx hgen hgen1 hcover).functor = coherentQuotientFunctor.{u, u} 𝒜 :=
  rfl

/-- The inverse of the equivalence is `ℱ ↦ ⨁_{n ≥ 0} Γ(X, ℱ(n))`. -/
theorem serreEquivalence_inverse [Algebra.FiniteType (𝒜 0) A]
    [CompactSpace (AlgebraicGeometry.Proj 𝒜)]
    (hgen1 : Algebra.adjoin (𝒜 0) ((𝒜 1 : Set A)) = ⊤) (hcover : DegreeOneCover 𝒜) :
    (serreEquivalence 𝒜 x hx hgen hgen1 hcover).inverse =
      nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen :=
  rfl

/-- **The equivalence is induced by `M ↦ M̃`**: composing it with the quotient functor and with
the inclusion of the coherent sheaves gives back the associated-sheaf functor on `Mod^fg_A`. -/
@[ega "III 2.3.3" "degree-one case"]
def serreEquivalenceFunctorFac [Algebra.FiniteType (𝒜 0) A]
    [CompactSpace (AlgebraicGeometry.Proj 𝒜)]
    (hgen1 : Algebra.adjoin (𝒜 0) ((𝒜 1 : Set A)) = ⊤) (hcover : DegreeOneCover 𝒜) :
    toIrrelevantQuotient.{u, u, u} 𝒜 Nat.one_pos ⋙
        (serreEquivalence 𝒜 x hx hgen hgen1 hcover).functor ⋙
          (Stacks.SheafOfModules.coherentModules (projRingSheaf 𝒜)).ι ≅
      finiteAssociatedSheafFunctor.{u, u} 𝒜 :=
  (Functor.associator (toIrrelevantQuotient.{u, u, u} 𝒜 Nat.one_pos)
      (coherentQuotientFunctor.{u, u} 𝒜)
      (Stacks.SheafOfModules.coherentModules (projRingSheaf 𝒜)).ι).symm ≪≫
    Functor.isoWhiskerRight (coherentQuotientFunctorFac.{u, u} 𝒜)
      (Stacks.SheafOfModules.coherentModules (projRingSheaf 𝒜)).ι ≪≫
    finiteCoherentSheafFunctorCompι.{u, u} 𝒜

end Comparison

/-! ### Stacks 0BXD -/

section Main

variable {A : Type u} {σ : Type u} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A]
  (𝒜 : ℕ → σ) [GradedRing 𝒜] [IsNoetherianRing (𝒜 0)]
  {m : ℕ} (x : Fin m → A) (hx : ∀ i, x i ∈ 𝒜 1)
  (hgen : Algebra.adjoin (𝒜 0) (Set.range x) = ⊤)

/-- Let `A` be a graded ring such that `A₀` is Noetherian and `A` is generated by finitely many
elements of `A₁` over `A₀`, and set `X = Proj A`. Then `M ↦ M̃` induces an equivalence

`Mod^fg_A / Mod^fg_{A, torsion} ⟶ Coh(𝒪_X)`

whose quasi-inverse is `ℱ ↦ ⨁_{n ≥ 0} Γ(X, ℱ(n))`.

The third clause is what says the equivalence is *induced* by `M ↦ M̃`: composed with the quotient
functor and read in all sheaves of `𝒪_X`-modules, its functor is the associated-sheaf functor on
`Mod^fg_A`. -/
@[stacks 0BXD "the equivalence Mod^fg_A / Mod^fg_{A,torsion} ⟶ Coh(O_X) induced by M ↦ M~, \
with quasi-inverse F ↦ ⨁_{n ≥ 0} Γ(X, F(n)), at the source's hypotheses: A_0 Noetherian and A \
generated by finitely many elements of A_1 over A_0. The torsion subcategory is the irrelevant \
finitely generated graded modules in generation degree one, which for a Noetherian A generated \
in degree one is the source's Mod^fg_{A,torsion}. The Noetherianity of A, its finite type over \
A_0 and the quasi-compactness of Proj A are derived from those hypotheses rather than assumed, \
which is why the statement opens with haveI. The equality clauses pin the functor to M ↦ M~ and \
the inverse to F ↦ ⨁_{n ≥ 0} Γ(X, F(n)) on the nose, and the last clause says the functor is \
induced by M ↦ M~", ega "III 2.3.3" "(F), special case"]
theorem equivalence_coherentQuotientFunctor :
    haveI := isNoetherianRing_of_adjoin_range 𝒜 x hx hgen
    haveI := finiteType_of_adjoin_range 𝒜 x hx hgen
    haveI : CompactSpace (AlgebraicGeometry.Proj 𝒜) :=
      QuasiCompact.compactSpace_of_compactSpace (AlgebraicGeometry.Proj.toSpecZero 𝒜)
    ∃ e : IrrelevantQuotient.{u, u, u} 𝒜 (d := 1) Nat.one_pos ≌
            Stacks.SheafOfModules.CoherentModules (projRingSheaf 𝒜),
      e.functor = coherentQuotientFunctor.{u, u} 𝒜 ∧
      e.inverse = nonnegTwistedSectionsQuotientFunctor 𝒜 x hx hgen ∧
      Nonempty (toIrrelevantQuotient.{u, u, u} 𝒜 Nat.one_pos ⋙ e.functor ⋙
        (Stacks.SheafOfModules.coherentModules (projRingSheaf 𝒜)).ι ≅
          finiteAssociatedSheafFunctor.{u, u} 𝒜) := by
  have := isNoetherianRing_of_adjoin_range 𝒜 x hx hgen
  have := finiteType_of_adjoin_range 𝒜 x hx hgen
  have : CompactSpace (AlgebraicGeometry.Proj 𝒜) :=
    QuasiCompact.compactSpace_of_compactSpace (AlgebraicGeometry.Proj.toSpecZero 𝒜)
  obtain ⟨k, y, hy, hygen⟩ := Stacks.ProjCoherentDegreeOne.exists_two_le_generators 𝒜 x hx hgen
  exact ⟨serreEquivalence 𝒜 x hx hgen
      (Stacks.ProjCoherentDegreeOne.adjoin_degreeOne_eq_top 𝒜 y hy hygen)
      (degreeOneCover_of_adjoin_range 𝒜 x hx hgen),
    serreEquivalence_functor 𝒜 x hx hgen _ _, serreEquivalence_inverse 𝒜 x hx hgen _ _,
    ⟨serreEquivalenceFunctorFac 𝒜 x hx hgen _ _⟩⟩

end Main

end Stacks.AlgebraicGeometry.ProjSerreCorrespondence

