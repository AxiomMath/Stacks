module

public import StacksFrontier.AlgebraicGeometry.HomogeneousAwayMapCriteria.Basic
public import StacksFrontier.AlgebraicGeometry.RelativeProjGradedIdeal.Identification

/-!
# Cutting out a closed subscheme of a relative Proj by a graded ideal generated in one degree

Work in Situation 01NN: a scheme `S`, a quasi-coherent graded `𝒪_S`-algebra `A`, the relative
homogeneous spectrum `p : Proj_S(A) ⟶ S` with `p` quasi-compact, and a closed immersion
`i : Z ⟶ Proj_S(A)`. Tag 0801 identifies `Z` with `Proj_S(A/ℐ)` for the saturated graded ideal
`ℐ = twistKerGradedIdeal A D i`. Tags 0802 and 0803 need the same identification for a *smaller*
ideal: the one generated by a submodule `ℱ` of a single homogeneous piece `A_d`.

That ideal is not saturated, so it is not the ideal of equations and Tag 0801's chart comparison
does not apply to it directly. What applies instead is
`Stacks.ProjQuotientFiniteCover.ker_eq_ker_projMap_quotientMk_of_saturation`, whose two
hypotheses — containment in the ideal of equations, and recovery of it after saturation on each
chart — are exactly what
`Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.IsEquationSubmodule` and
`Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.CutsOutOnCharts` say. This file makes that
translation and glues the result.

## Main results

* `Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.generatedByDegree_le_of_le`: the graded ideal
  generated by `ℱ` lies inside any graded ideal containing `ℱ` in degree `d`.
* `Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.chartIdeal_le_ker_awayMap`: the chart ideal of
  `ℱ` over an open of the base kills the quotient by any graded ideal containing `ℱ`.
* `Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.ker_chartRestrict_eq_ker_chartMap_of_chart`:
  the chart form of the identification for such an ideal, from one `ChartCuttingData`.
* `Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.ker_eq_ker_projQuotientHom_of_cutsOutOnCharts`:
  **`Z` and `Proj_S(A/ℐ)` cut out the same ideal sheaf of `Proj_S(A)`**, for a graded ideal `ℐ`
  squeezed between `ℱ` and Tag 0801's ideal which `ℱ` cuts out on the charts.

## References

* [Stacks Project, Tag 0801](https://stacks.math.columbia.edu/tag/0801)
* [Stacks Project, Tag 0802](https://stacks.math.columbia.edu/tag/0802)
* [Stacks Project, Tag 0803](https://stacks.math.columbia.edu/tag/0803)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace Opposite
open Stacks.AlgebraicGeometry.ChartBaseChange
open Stacks.AlgebraicGeometry.RelativeProj
open Stacks.AlgebraicGeometry.RelativeProjBridge
open Stacks.AlgebraicGeometry.RelativeProjMapDomain
open Stacks.AlgebraicGeometry.RelativeProjTwists
open Stacks.HomogeneousIdeal

universe u

namespace Stacks.AlgebraicGeometry.RelativeProjGradedIdeal

attribute [local instance_reducible] AlgebraicGeometry.Scheme.Modules

variable {S : Scheme.{u}} (A : SheafGradedAlgebra S)

/-! ### Comparing the ideal generated in one degree with a given graded ideal -/

/-- **The graded ideal generated by `ℱ ⊆ A_d` lies inside every graded ideal whose degree-`d`
piece contains `ℱ`.** The products that generate it are carried into the given ideal by its
`mul_mem` field; the degree transport is the `HEq` of `IsGeneratedInDegree`, discharged by
substituting the degree. -/
theorem generatedByDegree_le_of_le {d : ℤ} (ℱ : (A.piece d).Submodule) (ℐ : GradedIdeal A)
    (hle : ℱ ≤ ℐ.piece d) (n : ℤ) : generatedByDegree A ℱ n ≤ ℐ.piece n := by
  refine generatedByDegree_le A ℱ ?_
  intro m hm V f hf a x hx
  subst hm
  rw [eq_of_heq hx]
  exact ℐ.mul_mem d m V (hle (op V) hf) a

/-- **A submodule of `A_d` all of whose local sections are equations for the quotient by a graded
ideal lies in the degree-`d` piece of that ideal.** This is
`Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.quotProj_app_eq_zero_iff`, which holds over
every open of the base and needs no affineness. -/
theorem le_piece_of_isEquationSubmodule {d : ℕ} (ℱ : (A.piece (d : ℤ)).Submodule)
    (ℐ : QcohGradedIdeal A) (heq : IsEquationSubmodule A ℱ (quotHom A ℐ)) :
    ℱ ≤ ℐ.piece (d : ℤ) := fun X a ha =>
  (quotProj_app_eq_zero_iff A ℐ (d : ℤ) X.unop a).1 (heq X.unop a ha)

/-! ### The chart ideal of `ℱ` kills the quotient by a graded ideal containing `ℱ` -/

/-- **The local sections of `ℱ ⊆ A_d`, read as homogeneous elements of degree `d` of the graded
ring of sections, are equations for the quotient by any graded ideal containing `ℱ`.** A section
of `ℱ` has one nonzero homogeneous component, in degree `d`, where the containment applies. -/
theorem degreeSectionSet_subset_sectionIdeal {d : ℕ} (ℱ : (A.piece (d : ℤ)).Submodule)
    (ℐ : QcohGradedIdeal A) (hle : ℱ ≤ ℐ.piece (d : ℤ)) (U : S.Opens) :
    degreeSectionSet A ℱ U ⊆ (sectionIdeal A ℐ U).toIdeal := by
  rintro x ⟨a, ha, rfl⟩
  refine SetLike.mem_coe.2 ?_
  rw [mem_sectionIdeal_iff]
  intro n
  by_cases hn : d = n
  · subst hn
    have h2 := hle (op U) ha
    rwa [← DirectSum.of_eq_same (β := A.sectionPieces U) d a] at h2
  · have h0 : (DirectSum.of (A.sectionPieces U) d a) n = 0 :=
      DirectSum.of_eq_of_ne (β := A.sectionPieces U) d n a (Ne.symm hn)
    rw [h0]
    exact Submodule.zero_mem _

/-- **The ideal that `ℱ ⊆ A_d` generates on a standard open of a chart kills the quotient by any
graded ideal containing `ℱ`.** Each generator is a fraction whose numerator lies in the ideal
generated by the local sections of `ℱ`, hence in the kernel of the quotient homomorphism on
sections, so the fraction dies with exponent zero in
`Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff`. -/
theorem chartIdeal_le_ker_awayMap {d : ℕ} (ℱ : (A.piece (d : ℤ)).Submodule)
    (ℐ : QcohGradedIdeal A) (hle : ℱ ≤ ℐ.piece (d : ℤ)) (U : S.Opens)
    {e : ℕ} {f : A.sectionRing U} (hf : f ∈ A.grading U e) :
    chartIdeal A ℱ U hf ≤
      RingHom.ker (HomogeneousLocalization.Away.map ((quotHom A ℐ).sectionHom U) f) := by
  rw [chartIdeal, Ideal.span_le]
  rintro z ⟨k, x, hx, hxspan, rfl⟩
  refine (Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff
    ((quotHom A ℐ).sectionHom U) hf k x hx).2 ⟨0, ?_⟩
  rw [pow_zero, one_mul]
  exact Ideal.span_le.2 (degreeSectionSet_subset_sectionIdeal A ℱ ℐ hle U) hxspan

/-! ### The chart form of the identification -/

variable (D : TwistData A) {Z : Scheme.{u}} (i : Z ⟶ (relativeProj A).scheme)

/-- **The chart form of the identification for a graded ideal generated in a single degree.**
Over an affine open `U` of the base, `Z` and the chart map of `Proj_S(A/ℐ)` cut out the same
ideal sheaf of the chart `Proj Γ(U, A)`, given a `ChartCuttingData` for `ℱ` over `U`.

The absolute input is
`Stacks.ProjQuotientFiniteCover.ker_eq_ker_projMap_quotientMk_of_saturation`. Its containment
hypothesis is `hsub` read through `mem_sectionIdeal_iff` and Tag 0801's chart comparison
`sectionIdeal_eq_idealOfClosedSubscheme`; its saturation hypothesis is the `ker_le` field of the
cutting data, which places a fraction killed on `Z` in the chart ideal of `ℱ`, followed by
`chartIdeal_le_ker_awayMap`. -/
theorem ker_chartRestrict_eq_ker_chartMap_of_chart [IsClosedImmersion i]
    [QuasiCompact (relativeProj A).toBase] {d : ℕ} (ℱ : (A.piece (d : ℤ)).Submodule)
    (ℐ : QcohGradedIdeal A) (hle : ℱ ≤ ℐ.piece (d : ℤ))
    (hsub : ∀ n : ℤ, ℐ.piece n ≤ (twistKerGradedIdeal A D i).piece n)
    (U : S.Opens) (hU : IsAffineOpen U)
    (C : ChartCuttingData A ℱ (quotHom A (twistKerGradedIdeal A D i)) U) :
    (chartRestrict ((relativeProj A).chart U hU) i).ker =
      (ProjBundleSurjection.chartMap (surjectiveOnAffineSections_quotHom A ℐ) U hU).ker := by
  have := compactSpace_proj_grading A U hU
  rw [chartMap_eq_comp_projMap_quotientMk A ℐ U hU, Scheme.Hom.ker_comp_of_isIso]
  have hid : (sectionIdeal A (twistKerGradedIdeal A D i) U).toIdeal =
      Stacks.AlgebraicGeometry.IdealOfClosedSubscheme.idealOfClosedSubscheme (A.grading U)
        (chartRestrict ((relativeProj A).chart U hU) i) :=
    sectionIdeal_eq_idealOfClosedSubscheme A D i U hU
  refine Stacks.ProjQuotientFiniteCover.ker_eq_ker_projMap_quotientMk_of_saturation
    (A.grading U) (chartRestrict ((relativeProj A).chart U hU) i) (sectionIdeal A ℐ U)
    ?_ C.deg C.elt C.elt_mem C.deg_pos C.cover ?_ _
  · rw [← hid]
    intro x hx
    rw [mem_sectionIdeal_iff] at hx ⊢
    exact fun n => hsub (n : ℤ) (op U) (hx n)
  · intro c n a ha hex
    rw [← hid] at hex
    exact (Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff
      ((quotHom A ℐ).sectionHom U) (C.elt_mem c) n a ha).1
      (chartIdeal_le_ker_awayMap A ℱ ℐ hle U (C.elt_mem c)
        (C.ker_le c ((Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff
          ((quotHom A (twistKerGradedIdeal A D i)).sectionHom U) (C.elt_mem c) n a ha).2 hex)))

/-- **`Z` and `Proj_S(A/ℐ)` cut out the same ideal sheaf of `Proj_S(A)`** for a graded ideal `ℐ`
whose degree-`d` piece contains `ℱ`, which is contained in Tag 0801's ideal, and which `ℱ` cuts
out on the charts.

The affine cover is the one the cutting-out data names; its preimages cover `Proj_S(A)` because
the members cover `S`, and over each the chart comparison is
`ker_chartRestrict_eq_ker_chartMap_of_chart`. The gluing is
`ker_eq_ker_projQuotientHom_of_ker_chart_cover`. -/
theorem ker_eq_ker_projQuotientHom_of_cutsOutOnCharts [IsClosedImmersion i]
    [QuasiCompact (relativeProj A).toBase] {d : ℕ} (ℱ : (A.piece (d : ℤ)).Submodule)
    (ℐ : QcohGradedIdeal A) (hle : ℱ ≤ ℐ.piece (d : ℤ))
    (hsub : ∀ n : ℤ, ℐ.piece n ≤ (twistKerGradedIdeal A D i).piece n)
    (hcut : CutsOutOnCharts A ℱ (quotHom A (twistKerGradedIdeal A D i))) :
    i.ker = (projQuotientHom A ℐ).ker := by
  obtain ⟨Cd⟩ := hcut
  refine ker_eq_ker_projQuotientHom_of_ker_chart_cover A i ℐ
    (fun k => ⟨Cd.cover k, Cd.isAffineOpen_cover k⟩)
    (Scheme.Hom.iSup_preimage_eq_top _ Cd.iSup_cover) fun k => ?_
  exact ker_chartRestrict_eq_ker_chartMap_of_chart A D i ℱ ℐ hle hsub _
    (Cd.isAffineOpen_cover k) (Cd.chart k)

end Stacks.AlgebraicGeometry.RelativeProjGradedIdeal

end
