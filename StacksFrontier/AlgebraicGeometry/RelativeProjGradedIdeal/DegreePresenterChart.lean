namespace Stacks.AlgebraicGeometry.RelativeProjGradedIdeal

attribute [local instance_reducible] AlgebraicGeometry.Scheme.Modules

universe u

/-! ### Two morphisms of absolute projective spectra with the same chart kernels -/

section Absolute

variable {A B C σ τ υ : Type u} [CommRing A] [CommRing B] [CommRing C]
  [SetLike σ A] [AddSubgroupClass σ A] [SetLike τ B] [AddSubgroupClass τ B]
  [SetLike υ C] [AddSubgroupClass υ C]
  {𝒜 : ℕ → σ} {ℬ : ℕ → τ} {𝒞 : ℕ → υ} [GradedRing 𝒜] [GradedRing ℬ] [GradedRing 𝒞]

/-- **Two morphisms of absolute projective spectra out of `Proj 𝒜` have the same kernel ideal
sheaf as soon as their chart kernels agree.** For graded ring homomorphisms `φ` and `χ` out of
`𝒜` satisfying Mathlib's hypothesis for `AlgebraicGeometry.Proj.map`, and homogeneous `f k` of
positive degrees whose standard opens cover `Proj 𝒜`, it is enough that
`HomogeneousLocalization.Away.map φ (f k)` and `Away.map χ (f k)` have the same kernel.

Both inclusions are `Stacks.ProjQuotientChartIdeal.ker_le_ker_of_app_awayMk`, whose chart
hypothesis `Stacks.ProjQuotientChartIdeal.awayToSection_mem_ker_app_projMap_iff` turns into
exactly membership in those two kernels. -/
public theorem ker_projMap_eq_of_ker_awayMap_eq (φ : 𝒜 →+*ᵍ ℬ)
    (hφ : HomogeneousIdeal.irrelevant ℬ ≤ (HomogeneousIdeal.irrelevant 𝒜).map φ)
    (χ : 𝒜 →+*ᵍ 𝒞)
    (hχ : HomogeneousIdeal.irrelevant 𝒞 ≤ (HomogeneousIdeal.irrelevant 𝒜).map χ)
    [QuasiCompact (AlgebraicGeometry.Proj.map φ hφ)]
    [QuasiCompact (AlgebraicGeometry.Proj.map χ hχ)]
    {ι : Type*} (f : ι → A) (d : ι → ℕ) (hf : ∀ k, f k ∈ 𝒜 (d k)) (hd : ∀ k, 0 < d k)
    (hcover : ⨆ k, AlgebraicGeometry.Proj.basicOpen 𝒜 (f k) = ⊤)
    (H : ∀ k, RingHom.ker (Away.map φ (f k)) = RingHom.ker (Away.map χ (f k))) :
    (AlgebraicGeometry.Proj.map φ hφ).ker = (AlgebraicGeometry.Proj.map χ hχ).ker := by
  have hiff := fun (k : ι) (z : Away 𝒜 (f k)) =>
    ((Stacks.ProjQuotientChartIdeal.awayToSection_mem_ker_app_projMap_iff φ hφ
      (hf k) (hd k) z).trans (Iff.of_eq (congrArg (z ∈ ·) (H k)))).trans
      (Stacks.ProjQuotientChartIdeal.awayToSection_mem_ker_app_projMap_iff χ hχ
        (hf k) (hd k) z).symm
  exact le_antisymm
    (Stacks.ProjQuotientChartIdeal.ker_le_ker_of_app_awayMk 𝒜 _ _ f d hf hd hcover fun k z hz =>
      (hiff k z).1 hz)
    (Stacks.ProjQuotientChartIdeal.ker_le_ker_of_app_awayMk 𝒜 _ _ f d hf hd hcover fun k z hz =>
      (hiff k z).2 hz)

end Absolute

/-! ### The homogeneous ideal of sections that `ℱ𝒜` cuts out -/

section Sections

variable {S : Scheme.{u}} (𝒜 : SheafGradedAlgebra S) {d : ℕ} (ℱ : (𝒜.piece (d : ℤ)).Submodule)

/-- **The sectionwise kernel of a degreewise morphism contains the generators of `ℱ𝒜`** when the
local sections of `ℱ` are equations for the closed subscheme presented by `ψ`: a product of a
local section of `ℱ` with a homogeneous local section of `𝒜` is killed because `ψ` is
multiplicative and already kills the first factor. -/
public theorem isGeneratedInDegree_kernelSubmodule {B : SheafGradedAlgebra S}
    (ψ : SheafGradedAlgebraHom 𝒜 B) (heq : IsEquationSubmodule 𝒜 ℱ ψ) (n : ℤ) :
    IsGeneratedInDegree 𝒜 ℱ n (Stacks.Algebraization.kernelSubmodule (ψ.app n)) := by
  intro m hm U g hg a x hx
  subst hm
  have hzero : (ψ.app ((d : ℤ) + m)).app U x = 0 := by
    rw [eq_of_heq hx, ψ.app_mul (d : ℤ) m U g a, heq U g hg]
    simp
  exact (AlgebraicGeometry.mem_kernelSubmodule_iff (ψ.app ((d : ℤ) + m)) U x).2 hzero

/-- **A local section of the graded ring of sections lying in `I_U` is killed by `ψ`.** Here `I_U`
is the homogeneous ideal of `Γ(U, 𝒜)` that `ℱ𝒜` cuts out; the statement is
`…isGeneratedInDegree_kernelSubmodule` read on every homogeneous component at once. -/
public theorem sectionGradedIdeal_le_ker_sectionHom
    (hqc : IsQuasicoherentQuotPieces 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ))
    {B : SheafGradedAlgebra S} (ψ : SheafGradedAlgebraHom 𝒜 B)
    (heq : IsEquationSubmodule 𝒜 ℱ ψ) (U : S.Opens) :
    (sectionGradedIdeal 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ) hqc U).toIdeal ≤
      RingHom.ker (ψ.sectionHom U).toRingHom := by
  intro w hw
  rw [mem_sectionGradedIdeal_iff] at hw
  refine RingHom.mem_ker.2 ((sectionHom_eq_zero_iff ψ U w).2 fun n => ?_)
  refine (AlgebraicGeometry.mem_kernelSubmodule_iff (ψ.app (n : ℤ)) U (w n)).1 ?_
  exact generatedByDegree_le 𝒜 ℱ
    (isGeneratedInDegree_kernelSubmodule 𝒜 ℱ ψ heq (n : ℤ)) (op U) (hw n)

/-- **The local sections of `ℱ` generate, inside `Γ(U, 𝒜)`, an ideal contained in `I_U`.** A
generator is a single homogeneous summand `ι_d a` with `a` a local section of `ℱ`, so the quotient
homomorphism sends it to the summand `ι_d` of `(ℱ𝒜)_d ∋ a`, which is zero. -/
public theorem span_degreeSectionSet_le_sectionGradedIdeal
    (hqc : IsQuasicoherentQuotPieces 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ)) (U : S.Opens) :
    Ideal.span (degreeSectionSet 𝒜 ℱ U) ≤
      (sectionGradedIdeal 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ) hqc U).toIdeal := by
  refine Ideal.span_le.2 ?_
  rintro x ⟨a, ha, rfl⟩
  refine (Stacks.GradedKerQuotient.mem_homogeneousKer_iff (𝒜.grading U) _ _ _).2 ?_
  have h0 : (quotMk 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ) hqc).sectionPieceHom U d a = 0 :=
    (quotMkApp_app_eq_zero_iff 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ) (d : ℤ) U a).2
      (le_generatedByDegree_self 𝒜 ℱ (op U) ha)
  rw [(quotMk 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ) hqc).sectionHom_of U a, h0, map_zero]

/-- **The kernel of the graded quotient map by a homogeneous ideal, read as a ring
homomorphism, is that ideal.** This is `Ideal.mk_ker` at the spelling
`Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff` produces, which coerces
the graded homomorphism to a ring homomorphism before taking the kernel. -/
public theorem ker_coe_quotientMk {A' σ' : Type*} [CommRing A'] [SetLike σ' A']
    [AddSubgroupClass σ' A'] {ι : Type*} [DecidableEq ι] [AddMonoid ι] {𝒞 : ι → σ'}
    [GradedRing 𝒞] (I : HomogeneousIdeal 𝒞) :
    RingHom.ker ((Stacks.HomogeneousIdeal.quotientMk I :
      𝒞 →+*ᵍ Stacks.HomogeneousIdeal.quotientGrading I) : A' →+* A' ⧸ I.toIdeal) = I.toIdeal :=
  Ideal.mk_ker

end Sections

/-! ### The chart-level comparison -/

section Chart

variable {S : Scheme.{u}} (𝒜 : SheafGradedAlgebra S) {d : ℕ} (ℱ : (𝒜.piece (d : ℤ)).Submodule)
  (hqc : IsQuasicoherentQuotPieces 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ))
  {B : SheafGradedAlgebra S} (ψ : SheafGradedAlgebraHom 𝒜 B)
  (heq : IsEquationSubmodule 𝒜 ℱ ψ)

include heq in
/-- **The two chart kernels agree, at the level of degree-zero localizations.** Over an affine
open `U` of the base and away from a homogeneous `f` of positive degree, the kernel of the map
induced by `ψ` is the kernel of the map induced by the graded quotient by `I_U`, as soon as `ℱ`
cuts the closed subscheme out on that standard open.

One inclusion is the hypothesis `hle`, which is the `ker_le` field of
`…ChartCuttingData`, followed by `…span_degreeSectionSet_le_sectionGradedIdeal`; the other is
`…sectionGradedIdeal_le_ker_sectionHom`. Both are read on fractions by
`Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff`. -/
public theorem ker_awayMap_sectionHom_eq (U : S.Opens) {e : ℕ} {f : 𝒜.sectionRing U}
    (hf : f ∈ 𝒜.grading U e)
    (hle : RingHom.ker (Away.map (ψ.sectionHom U) f) ≤ chartIdeal 𝒜 ℱ U hf) :
    RingHom.ker (Away.map (ψ.sectionHom U) f) =
      RingHom.ker (Away.map (Stacks.HomogeneousIdeal.quotientMk
        (sectionGradedIdeal 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ) hqc U)) f) := by
  refine le_antisymm (hle.trans (Ideal.span_le.2 ?_)) fun z hz => ?_
  · rintro z ⟨k, x, hx, hxspan, rfl⟩
    refine (Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff
      _ hf k x hx).2 ⟨0, ?_⟩
    rw [pow_zero, one_mul, ker_coe_quotientMk]
    exact span_degreeSectionSet_le_sectionGradedIdeal 𝒜 ℱ hqc U hxspan
  · obtain ⟨n, a, ha, rfl⟩ := Away.mk_surjective _ hf z
    obtain ⟨k, hk⟩ := (Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff
      _ hf n a ha).1 hz
    rw [ker_coe_quotientMk] at hk
    exact (Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff
      _ hf n a ha).2 ⟨k, sectionGradedIdeal_le_ker_sectionHom 𝒜 ℱ hqc ψ heq U hk⟩

include heq in
/-- **The chart-level `iso` clause.** Over an affine open `U` of the base on whose chart `ℱ` cuts
the closed subscheme out, the chart map of `ψ` and the chart map of `𝒜 ⟶ 𝒜/ℱ𝒜` have the same
kernel ideal sheaf.

Both chart maps are morphisms of absolute projective spectra of graded quotients of `Γ(U, 𝒜)` —
the first by `…ProjBundleSurjection.chartMap_eq_map`, the second by `…chartMap_quotMk_eq` up to
the chart isomorphism, which `AlgebraicGeometry.Scheme.Hom.ker_comp_of_isIso` cancels — so
`…ker_projMap_eq_of_ker_awayMap_eq` applies with the covering family of the chart data. -/
public theorem ker_chartMap_eq_ker_chartMap_quotMk
    (hℐ : ∀ n : ℤ, (((gradedIdealGeneratedByDegree 𝒜 ℱ).piece n).toSheafOfModules
      : S.Modules).IsQuasicoherent)
    (hψ : ProjBundleSurjection.SurjectiveOnAffineSections ψ)
    (U : S.Opens) (hU : IsAffineOpen U) (CD : ChartCuttingData 𝒜 ℱ ψ U) :
    (ProjBundleSurjection.chartMap hψ U hU).ker =
      (ProjBundleSurjection.chartMap
        (surjectiveOnAffineSections_quotMk 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ) hqc hℐ)
        U hU).ker := by
  have : IsClosedImmersion (AlgebraicGeometry.Proj.map (ψ.sectionHom U)
      (ProjBundleSurjection.irrelevant_le_map_sectionHom hψ hU)) := by
    rw [← ProjBundleSurjection.chartMap_eq_map]
    exact ProjBundleSurjection.isClosedImmersion_chartMap hψ U hU
  have : IsClosedImmersion (sectionAmbientHom 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ) hqc U) :=
    AlgebraicGeometry.Proj.isClosedImmersion_map_quotientMk _
  rw [ProjBundleSurjection.chartMap_eq_map,
    chartMap_quotMk_eq 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ) hqc hℐ hU,
    Scheme.Hom.ker_comp_of_isIso]
  refine ker_projMap_eq_of_ker_awayMap_eq _ _ _ _
    (fun c => (CD.elt c : 𝒜.sectionRing U)) CD.deg CD.elt_mem CD.deg_pos CD.cover fun c => ?_
  exact ker_awayMap_sectionHom_eq 𝒜 ℱ hqc ψ heq U (CD.elt_mem c) (CD.ker_le c)

end Chart

/-! ### Tag 0801 for a single-degree graded ideal, from the general case -/

/-- **A graded quotient presentation of a closed subscheme of a relative Proj presents it, in
addition, as the relative Proj of the quotient by any single-degree graded ideal that cuts it out
on the charts.** This is Tag 0801 for `ℱ𝒜`, derived from Tag 0801 for the graded ideal the
presentation `P` carries, and it is the second of the two Tag 0801 inputs of Tag 0802.

The identification is an equality of kernel ideal sheaves, both morphisms being closed
immersions; `Stacks.AlgebraicGeometry.KerChart.ker_eq_of_forall_chart` reduces it to the charts
over the cover of the base that the cutting data provides, and
`…ker_chartMap_eq_ker_chartMap_quotMk` settles one chart. The kernel clause of the resulting
presentation is `…isQuotientByDegreeSubmodule_quotMk`. -/
public theorem degreeQuotientPresenter_of_gradedQuotientPresentation {S : Scheme.{u}}
    (𝒜 : SheafGradedAlgebra S) {Z : Scheme.{u}} {i : Z ⟶ (relativeProj 𝒜).scheme}
    [IsClosedImmersion i] (P : GradedQuotientPresentation 𝒜 i) :
    DegreeQuotientPresenter 𝒜 i P.hom := by
  intro d _ ℱ hℱqc heq hcut
  obtain ⟨CD⟩ := hcut
  have hqc := isQuasicoherentQuotPieces_gradedIdealGeneratedByDegree 𝒜 ℱ hℱqc
  have hℐ : ∀ n : ℤ, (((gradedIdealGeneratedByDegree 𝒜 ℱ).piece n).toSheafOfModules
      : S.Modules).IsQuasicoherent := fun n =>
    isQuasicoherent_generatedByDegree_of_mulFamily 𝒜 ℱ hℱqc n
  have : IsClosedImmersion (ProjBundleSurjection.map P.surjective) :=
    ProjBundleSurjection.isClosedImmersion_map P.surjective
  have : IsClosedImmersion
      (quotAmbientHom 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ) hqc hℐ) :=
    isClosedImmersion_quotAmbientHom 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ) hqc hℐ
  have hcov : (⨆ k : CD.index,
      ((relativeProj 𝒜).chart (CD.cover k) (CD.isAffineOpen_cover k)).opensRange) = ⊤ := by
    have hk : ∀ k : CD.index,
        ((relativeProj 𝒜).chart (CD.cover k) (CD.isAffineOpen_cover k)).opensRange =
          (relativeProj 𝒜).toBase ⁻¹ᵁ (CD.cover k) := fun k => by
      rw [← Scheme.Hom.image_top_eq_opensRange]
      exact RelativeProjTwistGlue.chart_image_top (relativeProj 𝒜) _ _
    rw [iSup_congr hk, ← Scheme.Hom.preimage_iSup, CD.iSup_cover, Scheme.Hom.preimage_top]
  have hiZ : i.ker = (ProjBundleSurjection.map P.surjective).ker := by
    conv_lhs => rw [← P.iso_comp]
    exact Scheme.Hom.ker_comp_of_isIso _ _
  have hker : i.ker = (quotAmbientHom 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ) hqc hℐ).ker := by
    rw [hiZ]
    refine KerChart.ker_eq_of_forall_chart _ _
      (fun k : CD.index => (relativeProj 𝒜).chart (CD.cover k) (CD.isAffineOpen_cover k))
      (fun k => ProjBundleSurjection.chartMap P.surjective (CD.cover k) (CD.isAffineOpen_cover k))
      (fun k => (relativeProj P.target).chart (CD.cover k) (CD.isAffineOpen_cover k))
      (fun k => (ProjBundleSurjection.isPullback_chart P.surjective _ _).flip)
      (fun k => ProjBundleSurjection.chartMap
        (surjectiveOnAffineSections_quotMk 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ) hqc hℐ)
        (CD.cover k) (CD.isAffineOpen_cover k))
      (fun k => (relativeProj
          (quotSheafGradedAlgebra 𝒜 (gradedIdealGeneratedByDegree 𝒜 ℱ) hqc)).chart
        (CD.cover k) (CD.isAffineOpen_cover k))
      (fun k => (ProjBundleSurjection.isPullback_chart _ _ _).flip) hcov fun k =>
      ker_chartMap_eq_ker_chartMap_quotMk 𝒜 ℱ hqc P.hom heq hℐ P.surjective
        (CD.cover k) (CD.isAffineOpen_cover k) (CD.chart k)
  exact ⟨{ toGradedQuotientPresentation :=
             gradedQuotientPresentation_of_ker_eq 𝒜 _ hqc hℐ i hker
           kernel := isQuotientByDegreeSubmodule_quotMk 𝒜 ℱ hqc }⟩

end Stacks.AlgebraicGeometry.RelativeProjGradedIdeal

end
