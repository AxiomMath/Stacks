module

public import StacksFrontier.AlgebraicGeometry.ProjBundleSurjection.Basic
public import StacksFrontier.AlgebraicGeometry.RelativeProjGradedIdeal.Basic

/-!
# Presenting a closed subscheme of a relative Proj as the relative Proj of a graded quotient

Work in Situation 01NN: a scheme `S` and a quasi-coherent graded `𝒪_S`-algebra `𝒜`, with
`p : X = Proj_S(𝒜) ⟶ S` the relative homogeneous spectrum, and let `i : Z ⟶ X` be a closed
immersion. This file carries the vocabulary in which Stacks Tags 0801, 0802 and 0803 are stated
here: what it is for `Z` to be the relative Proj of a graded quotient of `𝒜`, what it is for a
quasi-coherent submodule `ℱ` of a single homogeneous piece `𝒜_d` to cut `Z` out, and what it is
for the kernel of the quotient to be the graded ideal `ℱ𝒜` that `ℱ` generates.

It holds definitions only. Everything proved about them is in the siblings:
`StacksFrontier/AlgebraicGeometry/RelativeProjGradedIdeal/IsoClause.lean` reduces the `iso` clause
of a `GradedQuotientPresentation` to the charts,
`StacksFrontier/AlgebraicGeometry/RelativeProjGradedIdeal/QuotientPresentation.lean` discharges the
kernel clause for the quotient by `ℱ𝒜`,
`StacksFrontier/AlgebraicGeometry/RelativeProjGradedIdeal/DegreePresenterChart.lean` derives
`DegreeQuotientPresenter` from `GradedQuotientPresentation`, and
`StacksFrontier/AlgebraicGeometry/RelativeProjGradedIdeal/ClosedSubscheme.lean` proves Tags 0802
and 0803.

## Main definitions

* `Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.GradedQuotientPresentation`: a presentation
  of a closed subscheme of `Proj_S(𝒜)` as the relative Proj of a graded quotient of `𝒜`.
* `Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.IsQuotientByDegreeSubmodule`: the kernel of
  such a quotient is the graded ideal generated by `ℱ ⊆ 𝒜_d`.
* `Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.CutsOutOnCharts`: on every chart of the
  relative Proj, the equations of the closed subscheme are generated by the local sections
  of `ℱ`.
* `Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.DegreeQuotientPresentation`: a presentation
  of `Z` as `Proj_S(𝒜/ℱ𝒜)`.
* `Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.DegreeQuotientPresenter`: Tag 0801 for a
  graded ideal generated in a single degree, as an input.

## References

* [Stacks Project, Tag 01NN](https://stacks.math.columbia.edu/tag/01NN)
* [Stacks Project, Tag 0801](https://stacks.math.columbia.edu/tag/0801)
* [Stacks Project, Tag 0802](https://stacks.math.columbia.edu/tag/0802)

## Not done here

No Stacks tag is claimed: a definition is not an assertion of the Stacks project, and nothing is
proved here.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace Opposite
open Stacks.AlgebraicGeometry.RelativeProj
open Stacks.AlgebraicGeometry.RelativeProjBridge
open Stacks.AlgebraicGeometry.RelativeProjMapDomain

namespace Stacks.AlgebraicGeometry.RelativeProjGradedIdeal

attribute [local instance_reducible] AlgebraicGeometry.Scheme.Modules

universe u

variable {S : Scheme.{u}}


/-- A presentation of a closed subscheme of a relative Proj as the relative Proj of a graded
quotient: a graded algebra `ℬ`, a degreewise surjection `𝒜 ⟶ ℬ`, and an identification of the
closed subscheme with `Proj_S(ℬ)` over `Proj_S(𝒜)`. -/
public structure GradedQuotientPresentation (A : SheafGradedAlgebra S) {Z : Scheme.{u}}
    (i : Z ⟶ (relativeProj A).scheme) where
  /-- The quotient graded algebra. -/
  target : SheafGradedAlgebra S
  /-- The quotient homomorphism. -/
  hom : SheafGradedAlgebraHom A target
  /-- It is surjective on homogeneous sections over the affine opens of the base. -/
  surjective : ProjBundleSurjection.SurjectiveOnAffineSections hom
  /-- The closed subscheme is the relative Proj of the quotient. -/
  iso : Z ≅ (relativeProj target).scheme
  /-- The identification is one over the ambient relative Proj. -/
  iso_comp : iso.hom ≫ ProjBundleSurjection.map surjective = i

/-- The local sections of `ℱ ⊆ 𝒜_d` over an open of the base, viewed inside the graded ring of
sections of `𝒜` over that open as homogeneous elements of degree `d`. -/
public def degreeSectionSet (A : SheafGradedAlgebra S) {d : ℕ}
    (ℱ : (A.piece (d : ℤ)).Submodule) (U : S.Opens) : Set (A.sectionRing U) :=
  {x | ∃ a ∈ ℱ.toSubmodule.obj (op U), x = DirectSum.of (A.sectionPieces U) d a}

/-- The ideal that `ℱ ⊆ 𝒜_d` generates in the degree-zero homogeneous localization of `Γ(U, 𝒜)`
away from a homogeneous `f` of degree `e`: the ideal spanned by the fractions `x / f ^ k` whose
numerator lies in the ideal generated by the local sections of `ℱ` over `U`.

This is the ideal of sections of the standard open `D₊(f)` of the chart over `U` that the
equations `ℱ` cut out. -/
public def chartIdeal (A : SheafGradedAlgebra S) {d : ℕ} (ℱ : (A.piece (d : ℤ)).Submodule)
    (U : S.Opens) {e : ℕ} {f : A.sectionRing U} (hf : f ∈ A.grading U e) :
    Ideal (HomogeneousLocalization.Away (A.grading U) f) :=
  Ideal.span {z | ∃ (k : ℕ) (x : A.sectionRing U) (hx : x ∈ A.grading U (k • e)),
    x ∈ Ideal.span (degreeSectionSet A ℱ U) ∧
      z = HomogeneousLocalization.Away.mk (A.grading U) hf k x hx}

/-- The data witnessing that `ℱ ⊆ 𝒜_d` cuts out, on the chart over an affine open `U` of the
base, the closed subscheme presented by a degreewise surjection `ψ : 𝒜 ⟶ ℬ`: a family of
homogeneous sections of positive degree whose standard opens cover the chart, and on each of
them the statement that the ideal of the closed subscheme is generated by the sections of `ℱ`. -/
public structure ChartCuttingData (A : SheafGradedAlgebra S) {d : ℕ}
    (ℱ : (A.piece (d : ℤ)).Submodule) {B : SheafGradedAlgebra S}
    (ψ : SheafGradedAlgebraHom A B) (U : S.Opens) where
  /-- The index of the family of homogeneous sections. -/
  index : Type u
  /-- The homogeneous section indexed by `c`. -/
  elt : index → A.sectionRing U
  /-- Its degree. -/
  deg : index → ℕ
  /-- The degrees are positive. -/
  deg_pos (c : index) : 0 < deg c
  /-- The sections are homogeneous of the stated degrees. -/
  elt_mem (c : index) : elt c ∈ A.grading U (deg c)
  /-- The standard opens of the family cover the chart. -/
  cover : (⨆ c, AlgebraicGeometry.Proj.basicOpen (A.grading U) (elt c)) = ⊤
  /-- On each standard open the equations of the closed subscheme are generated by `ℱ`. -/
  ker_le (c : index) :
    RingHom.ker (HomogeneousLocalization.Away.map (ψ.sectionHom U) (elt c)) ≤
      chartIdeal A ℱ U (elt_mem c)

/-- `ℱ ⊆ 𝒜_d` **cuts out on the charts** the closed subscheme presented by a degreewise
surjection `ψ : 𝒜 ⟶ ℬ`: there is a cover of the base by affine opens over each of which the
equations of the closed subscheme are, on every standard open of a covering family of the chart,
generated by the local sections of `ℱ`.

This is the condition that makes the relative Proj of `𝒜/ℱ𝒜` and the closed subscheme presented
by `ψ` agree: both are covered by the standard opens of the charts, and on each of them the two
ideals coincide. -/
public structure CuttingData (A : SheafGradedAlgebra S) {d : ℕ}
    (ℱ : (A.piece (d : ℤ)).Submodule) {B : SheafGradedAlgebra S}
    (ψ : SheafGradedAlgebraHom A B) where
  /-- The index of the cover of the base. -/
  index : Type u
  /-- The affine open of the base indexed by `k`. -/
  cover (k : index) : S.Opens
  /-- Each member of the cover is affine. -/
  isAffineOpen_cover (k : index) : IsAffineOpen (cover k)
  /-- The members cover the base. -/
  iSup_cover : (⨆ k, cover k) = ⊤
  /-- Over each member, the chart-level cutting-out data. -/
  chart (k : index) : ChartCuttingData A ℱ ψ (cover k)

/-- `ℱ ⊆ 𝒜_d` cuts out the closed subscheme presented by `ψ` on the charts of some cover of the
base by affine opens. -/
public def CutsOutOnCharts (A : SheafGradedAlgebra S) {d : ℕ}
    (ℱ : (A.piece (d : ℤ)).Submodule) {B : SheafGradedAlgebra S}
    (ψ : SheafGradedAlgebraHom A B) : Prop :=
  Nonempty (CuttingData A ℱ ψ)

/-- Every local section of `ℱ ⊆ 𝒜_d` is an equation for the closed subscheme presented by
`ψ : 𝒜 ⟶ ℬ`, i.e. `ℱ` is contained in the degree-`d` part of the kernel of `ψ`. -/
public def IsEquationSubmodule (A : SheafGradedAlgebra S) {d : ℕ}
    (ℱ : (A.piece (d : ℤ)).Submodule) {B : SheafGradedAlgebra S}
    (ψ : SheafGradedAlgebraHom A B) : Prop :=
  ∀ (U : S.Opens), ∀ a ∈ ℱ.toSubmodule.obj (op U), (ψ.app (d : ℤ)).app U a = 0

/-- The kernel of a degreewise surjection `𝒜 ⟶ ℬ` is the graded ideal `ℱ𝒜` generated by a
submodule `ℱ` of a single homogeneous piece `𝒜_d`, tested degree by degree on the local sections
over the affine opens of the base. -/
public def IsQuotientByDegreeSubmodule (A : SheafGradedAlgebra S) {d : ℤ}
    (ℱ : (A.piece d).Submodule) {B : SheafGradedAlgebra S}
    (ψ : SheafGradedAlgebraHom A B) : Prop :=
  ∀ (n : ℤ) (U : S.Opens), IsAffineOpen U → ∀ a : Γ(A.piece n, U),
    (ψ.app n).app U a = 0 ↔ a ∈ (generatedByDegree A ℱ n).toSubmodule.obj (op U)

/-- A presentation of a closed subscheme `Z` of `Proj_S(𝒜)` as the relative Proj of the quotient
of `𝒜` by the graded ideal generated by `ℱ ⊆ 𝒜_d`: this is the assertion
`Z = Proj_S(𝒜/ℱ𝒜)`. -/
public structure DegreeQuotientPresentation (A : SheafGradedAlgebra S) {Z : Scheme.{u}}
    (i : Z ⟶ (relativeProj A).scheme) {d : ℕ} (ℱ : (A.piece (d : ℤ)).Submodule)
    extends GradedQuotientPresentation A i where
  /-- The kernel of the quotient homomorphism is the graded ideal generated by `ℱ`. -/
  kernel : IsQuotientByDegreeSubmodule A ℱ hom

/-- Tag 0801 for a graded ideal generated in a single degree, as an input: a quasi-coherent
submodule `ℱ` of one homogeneous piece `𝒜_d`, `d > 0`, all of whose local sections are equations
for the closed subscheme `Z` and which cuts `Z` out on every chart, presents `Z` as the relative
Proj of `𝒜/ℱ𝒜`. -/
public def DegreeQuotientPresenter (A : SheafGradedAlgebra S) {Z : Scheme.{u}}
    (i : Z ⟶ (relativeProj A).scheme) {B : SheafGradedAlgebra S}
    (ψ : SheafGradedAlgebraHom A B) : Prop :=
  ∀ (d : ℕ), 0 < d → ∀ ℱ : (A.piece (d : ℤ)).Submodule,
    ℱ.toSheafOfModules.IsQuasicoherent → IsEquationSubmodule A ℱ ψ → CutsOutOnCharts A ℱ ψ →
      Nonempty (DegreeQuotientPresentation A i ℱ)

end Stacks.AlgebraicGeometry.RelativeProjGradedIdeal

end
