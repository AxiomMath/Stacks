namespace Stacks.AlgebraicGeometry.RelativeProjGradedIdeal

attribute [local instance_reducible] AlgebraicGeometry.Scheme.Modules

universe u

/-! ### Arithmetic of fractions with a homogeneous denominator -/

section AwayArith

variable {ι A σ : Type*} [CommRing A] [SetLike σ A] [AddSubgroupClass σ A] [AddCommMonoid ι]
  [DecidableEq ι] (ℬ : ι → σ) [GradedRing ℬ] {t : ι} {g : A} (hg : g ∈ ℬ t)

/-- **Fractions with a common denominator add numeratorwise**, with the numerator of the sum a
free argument so that no rewrite is needed at the point of use. -/
public theorem awayMk_add_eq {n : ℕ} {u v w : A} (hu : u ∈ ℬ (n • t)) (hv : v ∈ ℬ (n • t))
    (hw : w ∈ ℬ (n • t)) (huvw : u + v = w) :
    Away.mk ℬ hg n w hw = Away.mk ℬ hg n u hu + Away.mk ℬ hg n v hv := by
  subst huvw
  exact Stacks.AlgebraicGeometry.ProjAwayBaseChange.awayMk_add ℬ hg n u v hu hv

/-- **Fractions multiply numeratorwise, adding the exponents of the denominator.** Both the
target exponent and the numerator of the product are free arguments, so that no degree rewrite
and no numerator rewrite is needed at the point of use. -/
public theorem awayMk_mul_eq {p q n : ℕ} (hn : p + q = n) {u v w : A} (hu : u ∈ ℬ (p • t))
    (hv : v ∈ ℬ (q • t)) (hw : w ∈ ℬ (n • t)) (huvw : u * v = w) :
    Away.mk ℬ hg p u hu * Away.mk ℬ hg q v hv = Away.mk ℬ hg n w hw := by
  subst hn huvw
  apply HomogeneousLocalization.val_injective
  rw [HomogeneousLocalization.val_mul, Away.val_mk, Away.val_mk, Away.val_mk,
    Localization.mk_mul]
  exact congrArg (Localization.mk (u * v)) (Subtype.ext (pow_add g p q).symm)

end AwayArith

variable {S : Scheme.{u}} (𝒜 : SheafGradedAlgebra S) {d : ℕ} (ℱ : (𝒜.piece (d : ℤ)).Submodule)

/-! ### The local sections of `ℱ` are equations -/

/-- **The ideal of `Γ(U, 𝒜)` spanned by the local sections of `ℱ` is killed by `ψ`.** A generator
is the single homogeneous summand `ι_d a` of a local section `a` of `ℱ`, and `ψ` kills it because
`a` lies in `(ℱ𝒜)_d`, which is the degree-`d` part of the kernel of `ψ` by hypothesis. -/
public theorem span_degreeSectionSet_le_ker_sectionHom {B : SheafGradedAlgebra S}
    (ψ : SheafGradedAlgebraHom 𝒜 B) (hker : IsQuotientByDegreeSubmodule 𝒜 ℱ ψ)
    {U : S.Opens} (hU : IsAffineOpen U) :
    Ideal.span (degreeSectionSet 𝒜 ℱ U) ≤ RingHom.ker (ψ.sectionHom U).toRingHom := by
  refine Ideal.span_le.2 ?_
  rintro x ⟨a, ha, rfl⟩
  have key : ψ.sectionHom U (DirectSum.of (𝒜.sectionPieces U) d a) = 0 := by
    rw [ψ.sectionHom_of U a, show ψ.sectionPieceHom U d a = 0 from
      (hker (d : ℤ) U hU a).2 (le_generatedByDegree_self 𝒜 ℱ (op U) ha), map_zero]
  exact RingHom.mem_ker.2 key

/-! ### The affine-local description of the generated graded ideal -/

/-- **The generated graded ideal vanishes below the generating degree.** A product of a local
section of `ℱ ⊆ 𝒜_d` with a homogeneous local section of complementary degree `n - d < 0` is
zero, because the negative homogeneous pieces of `𝒜` are zero objects. -/
public theorem eq_zero_of_mem_generatedByDegree_of_lt {n : ℤ} (hn : n < (d : ℤ))
    {V : S.Opens} {y : Γ(𝒜.piece n, V)}
    (hy : y ∈ (generatedByDegree 𝒜 ℱ n).toSubmodule.obj (op V)) : y = 0 := by
  have hgen : IsGeneratedInDegree 𝒜 ℱ n
      (Stacks.Algebraization.kernelSubmodule (𝟙 (𝒜.piece n))) := by
    intro m hm W g hg a x hx
    subst hm
    have hsub : Subsingleton Γ(𝒜.piece m, W) :=
      _root_.Stacks.subsingleton_of_isZero (𝒜.negative_isZero m (by omega)) (op W)
    have hx0 : x = 0 := by
      rw [eq_of_heq hx, show a = 0 from hsub.elim a 0, map_zero]
    rw [hx0]
    exact Submodule.zero_mem _
  have hbot : (Stacks.Algebraization.kernelSubmodule (𝟙 (𝒜.piece n))).toSubmodule.obj (op V)
      = ⊥ := by
    rw [Stacks.Algebraization.kernelSubmodule_toSubmodule_obj]
    exact LinearMap.ker_id
  exact (Submodule.eq_bot_iff _).1 hbot y (generatedByDegree_le 𝒜 ℱ hgen (op V) hy)

/-- **A homogeneous local section of `ℱ𝒜` of degree `d + m` lies in the ideal spanned by `ℱ`.**
Over an affine open the degree-`(d + m)` piece of `ℱ𝒜` is the `Γ(S, U)`-span of the products
`g · b` of a local section `g` of `ℱ` with a homogeneous local section `b` of `𝒜_m`; in the graded
ring of sections such a product is `ι_d g * ι_m b`, so it lies in the ideal that the summands
`ι_d g` generate. -/
public theorem of_mem_span_degreeSectionSet_add
    (hqc : ((ℱ.toSheafOfModules : S.Modules)).IsQuasicoherent)
    {U : S.Opens} (hU : IsAffineOpen U) (m : ℕ) (y : Γ(𝒜.piece ((d : ℤ) + (m : ℤ)), U))
    (hy : y ∈ (generatedByDegree 𝒜 ℱ ((d : ℤ) + (m : ℤ))).toSubmodule.obj (op U)) :
    DirectSum.of (𝒜.sectionPieces U) (d + m) y ∈ Ideal.span (degreeSectionSet 𝒜 ℱ U) := by
  rw [← mulSheafSubmodule_eq_generatedByDegree 𝒜 ℱ hqc (m : ℤ),
    show (mulSheafSubmodule 𝒜 ℱ hqc (m : ℤ)).toSubmodule.obj (op U) =
        Submodule.span Γ(S, U) (mulSet 𝒜 ℱ (m : ℤ) U) from
      Stacks.AlgebraicGeometry.GabberColimit.obj_sheafSubmodule _ _ _ ⟨U, hU⟩] at hy
  induction hy using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨g, hg, b, rfl⟩ := hz
    have hmul : DirectSum.of (𝒜.sectionPieces U) d g * DirectSum.of (𝒜.sectionPieces U) m b =
        DirectSum.of (𝒜.sectionPieces U) (d + m) ((𝒜.mul (d : ℤ) (m : ℤ)).app U g b) :=
      (DirectSum.of_mul_of (A := 𝒜.sectionPieces U) g b).trans
        (congrArg (DirectSum.of (𝒜.sectionPieces U) (d + m)) (𝒜.gMul_def U g b))
    rw [← hmul]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨g, hg, rfl⟩)
  | zero =>
    rw [map_zero]
    exact Submodule.zero_mem _
  | add p q _ _ hp hq =>
    rw [map_add]
    exact Submodule.add_mem _ hp hq
  | smul r p _ hp =>
    rw [← 𝒜.strHom_mul_of U r p]
    exact Ideal.mul_mem_left _ _ hp

/-- **The affine-local description of `ℱ𝒜` in the graded ring of sections.** A homogeneous local
section of `ℱ𝒜` of any degree `n`, over an affine open of the base, lies in the ideal of
`Γ(U, 𝒜)` spanned by the local sections of `ℱ`. -/
public theorem of_mem_span_degreeSectionSet
    (hqc : ((ℱ.toSheafOfModules : S.Modules)).IsQuasicoherent)
    {U : S.Opens} (hU : IsAffineOpen U) {n : ℕ} (y : Γ(𝒜.piece (n : ℤ), U))
    (hy : y ∈ (generatedByDegree 𝒜 ℱ (n : ℤ)).toSubmodule.obj (op U)) :
    DirectSum.of (𝒜.sectionPieces U) n y ∈ Ideal.span (degreeSectionSet 𝒜 ℱ U) := by
  rcases Nat.lt_or_ge n d with hlt | hge
  · rw [eq_zero_of_mem_generatedByDegree_of_lt 𝒜 ℱ (by exact_mod_cast hlt) hy, map_zero]
    exact Submodule.zero_mem _
  · obtain ⟨m, rfl⟩ : ∃ m : ℕ, n = d + m := ⟨n - d, by omega⟩
    exact of_mem_span_degreeSectionSet_add 𝒜 ℱ hqc hU m y hy

/-! ### The chart-level kernel -/

/-- **The kernel of the chart-level map induced by a quotient by `ℱ𝒜` is `chartIdeal`.** Over an
affine open `U` of the base and away from a homogeneous `f ∈ Γ(U, 𝒜)` of degree `e`, the kernel of
`HomogeneousLocalization.Away.map (ψ.sectionHom U) f` is exactly the ideal generated by the
fractions whose numerator lies in the ideal spanned by the local sections of `ℱ`. -/
public theorem ker_awayMap_sectionHom_eq_chartIdeal
    {B : SheafGradedAlgebra S} (ψ : SheafGradedAlgebraHom 𝒜 B)
    (hqc : ((ℱ.toSheafOfModules : S.Modules)).IsQuasicoherent)
    (hker : IsQuotientByDegreeSubmodule 𝒜 ℱ ψ)
    {U : S.Opens} (hU : IsAffineOpen U) {e : ℕ} {f : 𝒜.sectionRing U}
    (hf : f ∈ 𝒜.grading U e) :
    RingHom.ker (HomogeneousLocalization.Away.map (ψ.sectionHom U) f) =
      chartIdeal 𝒜 ℱ U hf := by
  refine le_antisymm (fun z hz => ?_) (Ideal.span_le.2 ?_)
  · obtain ⟨k, x, hx, rfl⟩ := Away.mk_surjective _ hf z
    obtain ⟨j, hj⟩ := (Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff
      (ψ.sectionHom U) hf k x hx).1 hz
    have hy : f ^ j * x ∈ 𝒜.grading U ((k + j) • e) := by
      rw [add_smul, add_comm (k • e) (j • e)]
      exact SetLike.mul_mem_graded (SetLike.pow_mem_graded j hf) hx
    obtain ⟨w, hw⟩ := (𝒜.mem_grading_iff U (f ^ j * x)).1 hy
    have h1 : ψ.sectionHom U (DirectSum.of (𝒜.sectionPieces U) ((k + j) • e) w) = 0 := by
      rw [hw]
      exact RingHom.mem_ker.1 hj
    have h2 : (ψ.app (((k + j) • e : ℕ) : ℤ)).app U w = 0 := by
      have h3 := (sectionHom_eq_zero_iff ψ U _).1 h1 ((k + j) • e)
      rwa [DirectSum.of_eq_same] at h3
    have hmem : f ^ j * x ∈ Ideal.span (degreeSectionSet 𝒜 ℱ U) := by
      rw [← hw]
      exact of_mem_span_degreeSectionSet 𝒜 ℱ hqc hU w ((hker _ U hU w).1 h2)
    rw [← Stacks.AlgebraicGeometry.ProjAwayBaseChange.awayMk_mulPow (𝒜.grading U) hf k j x hx hy]
    exact Ideal.subset_span ⟨k + j, f ^ j * x, hy, hmem, rfl⟩
  · rintro z ⟨k, x, hx, hxspan, rfl⟩
    refine (Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff
      (ψ.sectionHom U) hf k x hx).2 ⟨0, ?_⟩
    rw [pow_zero, one_mul]
    exact span_degreeSectionSet_le_ker_sectionHom 𝒜 ℱ ψ hker hU hxspan

/-! ### The chart-level kernel at a section of degree one -/

/-- **A homogeneous summand of degree `n` is homogeneous of degree `n • 1`.** This is the
membership a fraction with denominator a power of a degree-one section asks for, and it is given
a name because it occurs inside the statements below, where an inline proof would make the
generating family awkward to use. -/
public theorem of_mem_grading_smul_one (U : S.Opens) {n : ℕ} (y : 𝒜.sectionPieces U n) :
    DirectSum.of (𝒜.sectionPieces U) n y ∈ 𝒜.grading U (n • 1) := by
  simp

/-- **A homogeneous local section of `ℱ𝒜` of degree `d + m` gives a fraction in the ideal
generated by the local sections of `ℱ`.** This is `…of_mem_span_degreeSectionSet_add` with the
induction run on fractions instead of on the graded ring of sections: the generators of the
affine-local description of `ℱ𝒜` are already split as a degree-`d` factor from `ℱ` times a
degree-`m` factor, so each one becomes a *multiple* of a single generator `s / f ^ d`. -/
public theorem awayMk_mem_span_degreeOne_add
    (hqc : ((ℱ.toSheafOfModules : S.Modules)).IsQuasicoherent)
    {U : S.Opens} (hU : IsAffineOpen U) {f : 𝒜.sectionRing U} (hf : f ∈ 𝒜.grading U 1)
    (m : ℕ) (y : Γ(𝒜.piece ((d : ℤ) + (m : ℤ)), U))
    (hy : y ∈ (generatedByDegree 𝒜 ℱ ((d : ℤ) + (m : ℤ))).toSubmodule.obj (op U)) :
    HomogeneousLocalization.Away.mk (𝒜.grading U) hf (d + m)
        (DirectSum.of (𝒜.sectionPieces U) (d + m) y) (of_mem_grading_smul_one 𝒜 U y) ∈
      Ideal.span (Set.range fun s : ℱ.toSubmodule.obj (op U) =>
        HomogeneousLocalization.Away.mk (𝒜.grading U) hf d
          (DirectSum.of (𝒜.sectionPieces U) d s.1) (of_mem_grading_smul_one 𝒜 U s.1)) := by
  rw [← mulSheafSubmodule_eq_generatedByDegree 𝒜 ℱ hqc (m : ℤ),
    show (mulSheafSubmodule 𝒜 ℱ hqc (m : ℤ)).toSubmodule.obj (op U) =
        Submodule.span Γ(S, U) (mulSet 𝒜 ℱ (m : ℤ) U) from
      Stacks.AlgebraicGeometry.GabberColimit.obj_sheafSubmodule _ _ _ ⟨U, hU⟩] at hy
  induction hy using Submodule.span_induction with
  | mem z hz =>
    obtain ⟨g, hg, b, rfl⟩ := hz
    have hmul : DirectSum.of (𝒜.sectionPieces U) d g * DirectSum.of (𝒜.sectionPieces U) m b =
        DirectSum.of (𝒜.sectionPieces U) (d + m) ((𝒜.mul (d : ℤ) (m : ℤ)).app U g b) :=
      (DirectSum.of_mul_of (A := 𝒜.sectionPieces U) g b).trans
        (congrArg (DirectSum.of (𝒜.sectionPieces U) (d + m)) (𝒜.gMul_def U g b))
    have key := awayMk_mul_eq (𝒜.grading U) hf (rfl : d + m = d + m)
      (of_mem_grading_smul_one 𝒜 U g) (of_mem_grading_smul_one 𝒜 U b)
      (of_mem_grading_smul_one 𝒜 U _) hmul
    rw [← key]
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨⟨g, hg⟩, rfl⟩)
  | zero =>
    rw [(awayMk_congr (𝒜.grading U) hf _ (of_mem_grading_smul_one 𝒜 U 0) (zero_mem _)
      (map_zero _)).trans (awayMk_zero (𝒜.grading U) hf (d + m))]
    exact Submodule.zero_mem _
  | add p q _ _ hp hq =>
    rw [awayMk_add_eq (𝒜.grading U) hf (of_mem_grading_smul_one 𝒜 U p)
      (of_mem_grading_smul_one 𝒜 U q) (of_mem_grading_smul_one 𝒜 U (p + q))
      (map_add (DirectSum.of (𝒜.sectionPieces U) (d + m)) p q).symm]
    exact Submodule.add_mem _ hp hq
  | smul r p _ hp =>
    have hs : DirectSum.of (𝒜.sectionPieces U) (d + m) p *
          DirectSum.of (𝒜.sectionPieces U) 0 (r • 𝒜.one U) =
        DirectSum.of (𝒜.sectionPieces U) (d + m) (r • p) := by
      rw [mul_comm, ← 𝒜.strHom_apply U r]
      exact 𝒜.strHom_mul_of U r p
    have key := awayMk_mul_eq (𝒜.grading U) hf (n := d + m) (Nat.add_zero (d + m))
      (of_mem_grading_smul_one 𝒜 U p) (of_mem_grading_smul_one 𝒜 U (r • 𝒜.one U))
      (of_mem_grading_smul_one 𝒜 U (r • p)) hs
    rw [← key]
    exact Ideal.mul_mem_right _ _ hp

/-- **A homogeneous local section of `ℱ𝒜` of any degree gives a fraction in the ideal generated
by the local sections of `ℱ`.** Below the generating degree `(ℱ𝒜)_n` vanishes, so the fraction is
zero. -/
public theorem awayMk_mem_span_degreeOne
    (hqc : ((ℱ.toSheafOfModules : S.Modules)).IsQuasicoherent)
    {U : S.Opens} (hU : IsAffineOpen U) {f : 𝒜.sectionRing U} (hf : f ∈ 𝒜.grading U 1)
    {n : ℕ} (y : Γ(𝒜.piece (n : ℤ), U))
    (hy : y ∈ (generatedByDegree 𝒜 ℱ (n : ℤ)).toSubmodule.obj (op U)) :
    HomogeneousLocalization.Away.mk (𝒜.grading U) hf n
        (DirectSum.of (𝒜.sectionPieces U) n y) (of_mem_grading_smul_one 𝒜 U y) ∈
      Ideal.span (Set.range fun s : ℱ.toSubmodule.obj (op U) =>
        HomogeneousLocalization.Away.mk (𝒜.grading U) hf d
          (DirectSum.of (𝒜.sectionPieces U) d s.1) (of_mem_grading_smul_one 𝒜 U s.1)) := by
  rcases Nat.lt_or_ge n d with hlt | hge
  · have hy0 : DirectSum.of (𝒜.sectionPieces U) n y = 0 := by
      rw [eq_zero_of_mem_generatedByDegree_of_lt 𝒜 ℱ (by exact_mod_cast hlt) hy, map_zero]
    rw [(awayMk_congr (𝒜.grading U) hf _ (of_mem_grading_smul_one 𝒜 U y) (zero_mem _) hy0).trans
      (awayMk_zero (𝒜.grading U) hf n)]
    exact Submodule.zero_mem _
  · obtain ⟨m, rfl⟩ : ∃ m : ℕ, n = d + m := ⟨n - d, by omega⟩
    exact awayMk_mem_span_degreeOne_add 𝒜 ℱ hqc hU hf m y hy

/-- **At a section of degree one the chart-level kernel is spanned by the local sections of `ℱ`
themselves.** Over an affine open `U` of the base and away from a homogeneous `f ∈ Γ(U, 𝒜)` of
degree `1`, the kernel of `HomogeneousLocalization.Away.map (ψ.sectionHom U) f` is generated by
the fractions `s / f ^ d` with `s` a single local section of `ℱ` over `U`.

This is sharper than `…ker_awayMap_sectionHom_eq_chartIdeal`, whose generators are the fractions
with an arbitrary numerator in the ideal that the local sections of `ℱ` span, at an arbitrary
exponent of the denominator. -/
public theorem ker_awayMap_sectionHom_eq_span_degreeOne
    {B : SheafGradedAlgebra S} (ψ : SheafGradedAlgebraHom 𝒜 B)
    (hqc : ((ℱ.toSheafOfModules : S.Modules)).IsQuasicoherent)
    (hker : IsQuotientByDegreeSubmodule 𝒜 ℱ ψ)
    {U : S.Opens} (hU : IsAffineOpen U) {f : 𝒜.sectionRing U} (hf : f ∈ 𝒜.grading U 1) :
    RingHom.ker (HomogeneousLocalization.Away.map (ψ.sectionHom U) f) =
      Ideal.span (Set.range fun s : ℱ.toSubmodule.obj (op U) =>
        HomogeneousLocalization.Away.mk (𝒜.grading U) hf d
          (DirectSum.of (𝒜.sectionPieces U) d s.1) (of_mem_grading_smul_one 𝒜 U s.1)) := by
  refine le_antisymm (fun z hz => ?_) (Ideal.span_le.2 ?_)
  · obtain ⟨k, x, hx, rfl⟩ := Away.mk_surjective _ hf z
    obtain ⟨j, hj⟩ := (Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff
      (ψ.sectionHom U) hf k x hx).1 hz
    have hy : f ^ j * x ∈ 𝒜.grading U ((k + j) • 1) := by
      rw [add_smul, add_comm (k • 1) (j • 1)]
      exact SetLike.mul_mem_graded (SetLike.pow_mem_graded j hf) hx
    have hy' : f ^ j * x ∈ 𝒜.grading U (k + j) := by
      rwa [show (k + j) • 1 = k + j by simp] at hy
    obtain ⟨w, hw⟩ := (𝒜.mem_grading_iff U (f ^ j * x)).1 hy'
    have h1 : ψ.sectionHom U (DirectSum.of (𝒜.sectionPieces U) (k + j) w) = 0 := by
      rw [hw]
      exact RingHom.mem_ker.1 hj
    have h2 : (ψ.app ((k + j : ℕ) : ℤ)).app U w = 0 := by
      have h3 := (sectionHom_eq_zero_iff ψ U _).1 h1 (k + j)
      rwa [DirectSum.of_eq_same] at h3
    rw [← Stacks.AlgebraicGeometry.ProjAwayBaseChange.awayMk_mulPow (𝒜.grading U) hf k j x hx hy,
      awayMk_congr (𝒜.grading U) hf _ hy (of_mem_grading_smul_one 𝒜 U w) hw.symm]
    exact awayMk_mem_span_degreeOne 𝒜 ℱ hqc hU hf w ((hker _ U hU w).1 h2)
  · rintro z ⟨s, rfl⟩
    refine (Stacks.AlgebraicGeometry.HomogeneousAwayMap.awayMk_mem_ker_awayMap_iff
      (ψ.sectionHom U) hf d _ (of_mem_grading_smul_one 𝒜 U _)).2 ⟨0, ?_⟩
    rw [pow_zero, one_mul]
    exact span_degreeSectionSet_le_ker_sectionHom 𝒜 ℱ ψ hker hU
      (Ideal.subset_span ⟨s.1, s.2, rfl⟩)

end Stacks.AlgebraicGeometry.RelativeProjGradedIdeal

