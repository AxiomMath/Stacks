module

public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.PullbackUnitGenerators
public import StacksFrontier.AlgebraicGeometry.QuasicoherentBasicOpen.LocalSections
public import StacksFrontier.AlgebraicGeometry.RelativeProjGradedIdeal.Quotient
public import StacksFrontier.AlgebraicGeometry.TorsionQuasicoherent.Basic
public import StacksFrontier.AlgebraicGeometry.TorsionQuasicoherent.Local

/-!
# The graded ideal generated in one degree is quasi-coherent

Work in Situation 01NN: a scheme `S` and a quasi-coherent, commutative, nonnegatively graded
`𝒪_S`-algebra `𝒜` in the sheaf-level form
`Stacks.AlgebraicGeometry.RelativeProjBridge.SheafGradedAlgebra`. For a quasi-coherent
`𝒪_S`-submodule `ℱ` of the degree-`d` homogeneous piece,
`Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.generatedByDegree` is the degree-`n` piece
`(ℱ𝒜)_n` of the graded ideal `ℱ𝒜` that `ℱ` generates.

Every homogeneous piece of `ℱ𝒜` is quasi-coherent, and `ℱ𝒜` is packaged as a
`Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.QcohGradedIdeal`.

## Main definitions

* `Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.qcohGradedIdealGeneratedByDegree`: the graded
  ideal `ℱ𝒜` generated by a quasi-coherent submodule of a single homogeneous piece, packaged
  together with quasi-coherence of all of its homogeneous pieces.

## Main results

* `Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.isQuasicoherent_generatedByDegree`: **every
  homogeneous piece `(ℱ𝒜)_n` of the graded ideal generated by a quasi-coherent submodule `ℱ` of
  `𝒜_d` is quasi-coherent.**
* `Stacks.AlgebraicGeometry.RelativeProjGradedIdeal.piece_qcohGradedIdealGeneratedByDegree`: the
  homogeneous pieces of the packaged ideal are the submodules `(ℱ𝒜)_n`.

## References

* [Stacks Project, Tag 0801](https://stacks.math.columbia.edu/tag/0801)
* [Stacks Project, Tag 0803](https://stacks.math.columbia.edu/tag/0803)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace Opposite
open Stacks.AlgebraicGeometry.QuasicoherentBaseChange
open Stacks.AlgebraicGeometry.RelativeProjBridge

universe u

namespace Stacks.AlgebraicGeometry.RelativeProjGradedIdeal

attribute [local instance_reducible] AlgebraicGeometry.Scheme.Modules

variable {S : Scheme.{u}}

/-- **Every homogeneous piece of the graded ideal generated by a quasi-coherent submodule of one
homogeneous piece is quasi-coherent.** -/
theorem isQuasicoherent_generatedByDegree (𝒜 : SheafGradedAlgebra S) {d : ℤ}
    (ℱ : (𝒜.piece d).Submodule) (hℱ : ℱ.toSheafOfModules.IsQuasicoherent) (n : ℤ) :
    (generatedByDegree 𝒜 ℱ n).toSheafOfModules.IsQuasicoherent :=
  isQuasicoherent_generatedByDegree_of_mulFamily 𝒜 ℱ hℱ n

/-- **The graded ideal `ℱ𝒜` generated by a quasi-coherent submodule of a single homogeneous
piece, with its quasi-coherence.** -/
def qcohGradedIdealGeneratedByDegree (𝒜 : SheafGradedAlgebra S) {d : ℤ}
    (ℱ : (𝒜.piece d).Submodule) (hℱ : ℱ.toSheafOfModules.IsQuasicoherent) :
    QcohGradedIdeal 𝒜 where
  toGradedIdeal := gradedIdealGeneratedByDegree 𝒜 ℱ
  isQuasicoherent n := isQuasicoherent_generatedByDegree 𝒜 ℱ hℱ n

/-- The underlying graded ideal of the packaged datum is `ℱ𝒜`. -/
@[simp]
theorem toGradedIdeal_qcohGradedIdealGeneratedByDegree (𝒜 : SheafGradedAlgebra S) {d : ℤ}
    (ℱ : (𝒜.piece d).Submodule) (hℱ : ℱ.toSheafOfModules.IsQuasicoherent) :
    (qcohGradedIdealGeneratedByDegree 𝒜 ℱ hℱ).toGradedIdeal = gradedIdealGeneratedByDegree 𝒜 ℱ :=
  rfl

/-- The homogeneous pieces of the packaged datum are the submodules `(ℱ𝒜)_n`. -/
@[simp]
theorem piece_qcohGradedIdealGeneratedByDegree (𝒜 : SheafGradedAlgebra S) {d : ℤ}
    (ℱ : (𝒜.piece d).Submodule) (hℱ : ℱ.toSheafOfModules.IsQuasicoherent) (n : ℤ) :
    (qcohGradedIdealGeneratedByDegree 𝒜 ℱ hℱ).piece n = generatedByDegree 𝒜 ℱ n :=
  rfl

end Stacks.AlgebraicGeometry.RelativeProjGradedIdeal

end
