module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.ProjStalkGlobalSections.Stalk

/-!
# Degree-zero elements as global sections on Proj

Let `S` be a commutative ring with a nonnegative grading `𝒮 : ℕ → σ`. A degree-zero element
of `S` determines a global section of the structure sheaf of `Proj(S)`, and for a `ℤ`-graded
`S`-module `M` a degree-zero element of `M` determines a global section of the associated
sheaf `M̃`. The second assignment is linear over `𝒮 0`, acting on global sections through the
first. On a positive-degree standard open and at a homogeneous-prime stalk both maps are the
ordinary localization map `m ↦ m / 1`.

## Main definitions

* `Stacks.AlgebraicGeometry.ProjStalkGlobalSections.degreeZeroRingToGlobalSections`: the
  canonical ring map `𝒮 0 →+* Γ(Proj(S), 𝒪)`.
* `Stacks.AlgebraicGeometry.ProjStalkGlobalSections.degreeZeroToGlobalSections`: the
  canonical `𝒮 0`-linear map `𝒨 0 →ₗ Γ(Proj(S), M̃)`.

## Main results

* `Stacks.AlgebraicGeometry.ProjStalkGlobalSections.degreeZeroRingToGlobalSections_basicOpen`
  and `Stacks.AlgebraicGeometry.ProjStalkGlobalSections.degreeZeroToGlobalSections_basicOpen`:
  the restriction to a standard open is `a ↦ a / 1`.
* `Stacks.AlgebraicGeometry.ProjStalkGlobalSections.degreeZeroRingToGlobalSections_stalk` and
  `Stacks.AlgebraicGeometry.ProjStalkGlobalSections.degreeZeroToGlobalSections_stalk`: the
  germ at a homogeneous prime is `a ↦ a / 1`.

## Implementation notes

The ring map is obtained from the canonical map `ProjectiveSpectrum.Proj.awayToSection` for
the standard open `D₊(1) = Proj(S)`; the transport along `ProjectiveSpectrum.basicOpen_one`
is a substitution of opens, so the two `cases`-style lemmas `castSection_apply` and
`castRingHom_apply` are what make it computable on points.

The module map is given directly by the global homogeneous fraction `x ↦ m / 1`, whose
local-fraction condition is witnessed on all of `Proj(S)` with numerator `m` and denominator
`1`. Linearity over `𝒮 0` is checked pointwise after representing the scalar as a fraction.

The standard-open comparison uses the degree-zero fraction with exponent zero, so that the
denominator `f ^ 0` is the unit of the submonoid generated by `f`. The stalk formula is stated
after coercion from the degree-zero localization into the ambient localized module, where
`m / 1` is represented canonically.

The two statements about the structure sheaf alone — the sections over a standard open
`Γ(D₊(f), 𝒪) = S₍f₎` and the stalk `𝒪_{Proj(S), x} = S₍𝔭₎` — are
`AlgebraicGeometry.Proj.basicOpenIsoAway` and `AlgebraicGeometry.Proj.stalkIso'` in Mathlib,
and are recorded here rather than restated.

## References

* [Stacks Project, Tag 01M7](https://stacks.math.columbia.edu/tag/01M7)
-/

@[expose] public section

open CategoryTheory TopologicalSpace Opposite TopCat DirectSum
open AlgebraicGeometry
open Stacks.GradedLocalization

namespace Stacks.AlgebraicGeometry.ProjStalkGlobalSections

universe u v w t

attribute [local instance] ProjectiveSpectrum.isPrime
attribute [local instance_reducible] ProjectiveSpectrum.top
attribute [local implicit_reducible] TopCat.Sheaf sheafCompose

section Ring

variable {S : Type u} {σ : Type w} [CommRing S] [SetLike σ S]
  [AddSubgroupClass σ S] (𝒮 : ℕ → σ) [GradedRing 𝒮]

/-- Enlarging the denominators does not change the image of a degree-zero element. -/
private lemma fromZero_mapId {P Q : Submonoid S} (h : P ≤ Q) (a : 𝒮 0) :
    HomogeneousLocalization.mapId 𝒮 h (HomogeneousLocalization.fromZeroRingHom 𝒮 P a) =
      HomogeneousLocalization.fromZeroRingHom 𝒮 Q a := by
  apply Quotient.sound'
  rfl

/-- Transporting a section along an equality of opens does not change its values. -/
private lemma castSection_apply {U V : Opens (ProjectiveSpectrum.top 𝒮)} (h : U = V)
    (s : (ProjectiveSpectrum.Proj.structureSheaf 𝒮).1.obj (op U)) (x : V) :
    (h ▸ s).1 x = s.1 ⟨x.1, by simpa only [h] using x.2⟩ := by
  cases h
  rfl

/-- Transporting a ring map into sections along an equality of opens is transport of the
values. -/
private lemma castRingHom_apply {U V : Opens (ProjectiveSpectrum.top 𝒮)} (h : U = V)
    (φ : HomogeneousLocalization.Away 𝒮 1 →+*
      (ProjectiveSpectrum.Proj.structureSheaf 𝒮).1.obj (op U))
    (a : HomogeneousLocalization.Away 𝒮 1) :
    (h ▸ φ) a = h ▸ φ a := by
  cases h
  rfl

/-- A degree-zero element of `S` gives the corresponding global section of the structure
sheaf of `Proj(S)`, namely the one whose value at every point is `a / 1`. -/
noncomputable def degreeZeroRingToGlobalSections :
    𝒮 0 →+* (ProjectiveSpectrum.Proj.structureSheaf 𝒮).1.obj (op ⊤) :=
  (show HomogeneousLocalization.Away 𝒮 1 →+*
      (ProjectiveSpectrum.Proj.structureSheaf 𝒮).1.obj (op ⊤) from
    (ProjectiveSpectrum.basicOpen_one 𝒮 ▸
      (ProjectiveSpectrum.Proj.awayToSection 𝒮 1).hom)).comp
    (HomogeneousLocalization.fromZeroRingHom 𝒮 (Submonoid.powers 1))

/-- The value of the global section attached to `a` at a point is `a / 1`. -/
private lemma degreeZeroRingToGlobalSections_apply (x : ProjectiveSpectrum.top 𝒮) (a : 𝒮 0) :
    (degreeZeroRingToGlobalSections 𝒮 a).1 ⟨x, trivial⟩ =
      HomogeneousLocalization.fromZeroRingHom 𝒮 x.asHomogeneousIdeal.toIdeal.primeCompl a := by
  unfold degreeZeroRingToGlobalSections
  dsimp
  rw [castRingHom_apply, castSection_apply (𝒮 := 𝒮) (ProjectiveSpectrum.basicOpen_one 𝒮)
    ((ProjectiveSpectrum.Proj.awayToSection 𝒮 1).hom
      (HomogeneousLocalization.fromZeroRingHom 𝒮 (Submonoid.powers 1) a)) ⟨x, trivial⟩]
  exact (fromZero_mapId (𝒮 := 𝒮) (Submonoid.powers_le.mpr (one_mem _)) a).symm

/-- Restricting the global section attached to `a` to `D₊(f)` gives `a / 1` in `S₍f₎`. -/
theorem degreeZeroRingToGlobalSections_basicOpen (f : S) (a : 𝒮 0) :
    (ProjectiveSpectrum.Proj.structureSheaf 𝒮).1.map
      (homOfLE le_top).op (degreeZeroRingToGlobalSections 𝒮 a) =
      (ProjectiveSpectrum.Proj.awayToSection 𝒮 f).hom
        (HomogeneousLocalization.fromZeroRingHom 𝒮 (Submonoid.powers f) a) := by
  ext x
  rw [Proj.res_apply, degreeZeroRingToGlobalSections_apply]
  apply congrArg HomogeneousLocalization.val
  exact (fromZero_mapId (𝒮 := 𝒮) (Submonoid.powers_le.mpr (show f ∈
      x.1.asHomogeneousIdeal.toIdeal.primeCompl from x.2)) a).symm

/-- The germ at `x` of the global section attached to `a` is `a / 1` in `S₍p₎`. -/
theorem degreeZeroRingToGlobalSections_stalk
    (x : ProjectiveSpectrum.top 𝒮) (a : 𝒮 0) :
    Proj.stalkIso' 𝒮 x
      ((ProjectiveSpectrum.Proj.structureSheaf 𝒮).presheaf.germ ⊤ x
        (show x ∈ (⊤ : Opens (ProjectiveSpectrum.top 𝒮)) from trivial)
        (degreeZeroRingToGlobalSections 𝒮 a)) =
      HomogeneousLocalization.fromZeroRingHom 𝒮
        x.asHomogeneousIdeal.toIdeal.primeCompl a := by
  rw [Proj.stalkIso'_germ, degreeZeroRingToGlobalSections_apply]

end Ring

section Module

variable {S : Type u} {M : Type v} {σ : Type w} {τ : Type t}
  [CommRing S] [AddCommGroup M] [Module S M]
  [SetLike σ S] [AddSubgroupClass σ S] (𝒮 : ℕ → σ) [GradedRing 𝒮]
  [SetLike τ M] [AddSubgroupClass τ M] (𝒨 : ℤ → τ) [Decomposition 𝒨]
  [SetLike.GradedSMul 𝒮 𝒨]

/-- The degree-zero piece of a graded module is a module over the degree-zero ring: the
grading compatibility sends `𝒮 0 • 𝒨 0` into `𝒨 (0 +ᵥ 0) = 𝒨 0`. -/
noncomputable instance degreeZeroPieceModule : Module (𝒮 0) (𝒨 0) where
  smul a m := ⟨(a : S) • (m : M), by
    have h := SetLike.GradedSMul.smul_mem (A := 𝒮) (B := 𝒨) a.property m.property
    simpa only [show (0 : ℕ) +ᵥ (0 : ℤ) = 0 from rfl] using h⟩
  one_smul m := Subtype.ext (one_smul S (m : M))
  mul_smul a b m := Subtype.ext (mul_smul (a : S) (b : S) (m : M))
  smul_zero a := Subtype.ext (smul_zero (a : S))
  smul_add a m n := Subtype.ext (smul_add (a : S) (m : M) (n : M))
  add_smul a b m := Subtype.ext (add_smul (a : S) (b : S) (m : M))
  zero_smul m := Subtype.ext (zero_smul S (m : M))

omit [Decomposition 𝒨] [SetLike.GradedSMul 𝒮 𝒨] in
/-- The structure-sheaf global section attached to a degree-zero element of `S` acts on a
module fiber as the image of that element under the localization map. -/
private theorem degreeZeroGlobalScalar_apply (a : 𝒮 0) (x : ProjectiveSpectrum.top 𝒮) :
    ProjectiveSpectrum.Proj.moduleScalarMap 𝒮 ⊤ (degreeZeroRingToGlobalSections 𝒮 a)
      ⟨x, trivial⟩ =
      algebraMap S (Localization x.asHomogeneousIdeal.toIdeal.primeCompl) a.1 := by
  change HomogeneousLocalization.val
    ((degreeZeroRingToGlobalSections 𝒮 a).1 ⟨x, trivial⟩) = _
  rw [← Proj.stalkIso'_germ 𝒮 ⊤ x trivial (degreeZeroRingToGlobalSections 𝒮 a),
    degreeZeroRingToGlobalSections_stalk]
  change Localization.mk a.1 (1 : x.asHomogeneousIdeal.toIdeal.primeCompl) = _
  exact Localization.mk_algebraMap (A := S) a.1

/-- The canonical `𝒮 0`-linear map from `𝒨 0` to the global sections of `M̃`, sending `m` to
the global homogeneous fraction `m / 1`. -/
noncomputable def degreeZeroToGlobalSections :
    letI : Module (𝒮 0)
        ((ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒨).val.obj (op ⊤)) :=
      Module.compHom _ (degreeZeroRingToGlobalSections 𝒮)
    𝒨 0 →ₗ[𝒮 0] (ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒨).val.obj (op ⊤) := by
  letI : Module (𝒮 0)
      ((ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒨).val.obj (op ⊤)) :=
    Module.compHom _ (degreeZeroRingToGlobalSections 𝒮)
  let toSections := fun (m : 𝒨 0) =>
    (⟨(fun x => LocalizedModule.mk m.1
        (1 : x.1.asHomogeneousIdeal.toIdeal.primeCompl)), by
      intro x
      exact ⟨⊤, x.2, 𝟙 _, 0, m.1, 1, m.2, SetLike.one_mem_graded 𝒮,
        (fun y => y.1.isPrime.one_notMem), fun y => rfl⟩⟩ :
      ProjectiveSpectrum.Proj.moduleSections 𝒮 𝒨 ⊤)
  exact {
    toFun := fun m => toSections m
    map_add' := by
      intro m n
      apply Subtype.ext
      funext x
      change LocalizedModule.mk (m.1 + n.1)
          (1 : x.1.asHomogeneousIdeal.toIdeal.primeCompl) =
        LocalizedModule.mk m.1 (1 : x.1.asHomogeneousIdeal.toIdeal.primeCompl) +
          LocalizedModule.mk n.1 (1 : x.1.asHomogeneousIdeal.toIdeal.primeCompl)
      rw [LocalizedModule.mk_add_mk]
      simp
    map_smul' := by
      intro a m
      apply Subtype.ext
      funext x
      change LocalizedModule.mk (a.1 • m.1)
          (1 : x.1.asHomogeneousIdeal.toIdeal.primeCompl) =
        (ProjectiveSpectrum.Proj.moduleScalarMap 𝒮 ⊤
          (degreeZeroRingToGlobalSections 𝒮 a) x) •
          LocalizedModule.mk m.1 (1 : x.1.asHomogeneousIdeal.toIdeal.primeCompl)
      rw [degreeZeroGlobalScalar_apply 𝒮 a x.1, ← Localization.mk_algebraMap (A := S) a.1,
        LocalizedModule.mk_smul_mk]
      simp
  }

omit [Decomposition 𝒨] in
/-- The global section attached to a degree-zero element `m` has value `m / 1` at every
point. -/
theorem degreeZeroToGlobalSections_apply (m : 𝒨 0)
    (x : (⊤ : Opens (ProjectiveSpectrum.top 𝒮))) :
    (degreeZeroToGlobalSections 𝒮 𝒨 m).1 x =
      LocalizedModule.mk m.1 (1 : x.1.asHomogeneousIdeal.toIdeal.primeCompl) := rfl

/-- Restricting the global section defined by a degree-zero element `m` to a positive-degree
standard open `D₊(f)` gives the degree-zero fraction `m / f ^ 0`. -/
theorem degreeZeroToGlobalSections_basicOpen {f : S} {d : ℕ}
    (hf : f ∈ 𝒮 d) (hd : 0 < d) (m : 𝒨 0) :
    ProjectiveSpectrum.Proj.associatedModuleSheafStandardOpenEquiv 𝒮 𝒨 hf hd
      ((ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒨).val.map (homOfLE le_top).op
        (degreeZeroToGlobalSections 𝒮 𝒨 m)) =
      ProjectiveSpectrum.Proj.degreeZeroFraction 𝒮 𝒨 hf 0 m.1
        (by simpa only [zero_smul] using m.2) := by
  let e := ProjectiveSpectrum.Proj.associatedModuleSheafStandardOpenEquiv 𝒮 𝒨 hf hd
  have hden (x : ProjectiveSpectrum.basicOpen 𝒮 f) :
      (1 : x.1.asHomogeneousIdeal.toIdeal.primeCompl) =
        ⟨f ^ 0, x.1.asHomogeneousIdeal.toIdeal.primeCompl.pow_mem x.2 0⟩ :=
    Subtype.ext (pow_zero f).symm
  refine e.eq_symm_apply.mp (Subtype.ext (funext fun x => ?_))
  change ((ProjectiveSpectrum.Proj.associatedModuleSheaf 𝒮 𝒨).val.map
      (homOfLE le_top).op (degreeZeroToGlobalSections 𝒮 𝒨 m)).1 x =
    (ProjectiveSpectrum.Proj.degreeZeroToSection 𝒮 𝒨 f
      (ProjectiveSpectrum.Proj.degreeZeroFraction 𝒮 𝒨 hf 0 m.1
        (by simpa only [zero_smul] using m.2))).1 x
  rw [ProjectiveSpectrum.Proj.degreeZeroToSection_fraction]
  change LocalizedModule.mk m.1 (1 : x.1.asHomogeneousIdeal.toIdeal.primeCompl) = _
  rw [hden x]

omit [Decomposition 𝒨] in
/-- The germ at `x` of the global section defined by a degree-zero element `m` is the
fraction `m / 1` in `M₍p₎`. -/
theorem degreeZeroToGlobalSections_stalk
    (x : ProjectiveSpectrum.top 𝒮) (m : 𝒨 0) :
    ((associatedModuleSheafStalkEquiv 𝒮 𝒨 x
      (associatedModuleSheafGerm 𝒮 𝒨 x ⊤
        (show x ∈ (⊤ : Opens (ProjectiveSpectrum.top 𝒮)) from trivial)
        (degreeZeroToGlobalSections 𝒮 𝒨 m)) : degreeZeroModuleAt 𝒮 𝒨 x) :
      ProjectiveSpectrum.Proj.ModuleFiber (M := M) 𝒮 x) =
        LocalizedModule.mk m.1 (1 : x.asHomogeneousIdeal.toIdeal.primeCompl) :=
  associatedModuleSheafStalkEquiv_germ 𝒮 𝒨 x ⊤ trivial
    (degreeZeroToGlobalSections 𝒮 𝒨 m)

end Module

end Stacks.AlgebraicGeometry.ProjStalkGlobalSections
