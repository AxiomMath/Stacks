/-!
# Integer polynomials in pulled back functions cutting out a point

Let `V` be a scheme smooth over an algebraically closed field `K` and let `φ : V ⟶ U` be a
morphism to an affine scheme such that `V ⟶ U × Spec K` is unramified. Then there is a point
`v ∈ V` and global functions `g₁, …, g_d` of `U` together with integer polynomials whose values
on the `gᵢ` generate the maximal ideal of `𝒪_{V, v}`: the morphism `V ⟶ Spec ℤ[T₁, …, T_d]`
through `U` sends the maximal ideal of the target onto generators of the maximal ideal at `v`.

This is the point-selection step of the proof of **Stacks 06N3** (a DM algebraic stack is
Deligne–Mumford) on one scheme chart, in a form which needs no residual field of the stack: the
source picks a field point of the stack whose self-product is étale, so that functions on the
chart vanishing at a point already cut out the fibre; here the functions on the chart are
allowed to take nonzero values, and an étale coordinate map `V ⟶ 𝐀^d_K` moves the point to one
whose coordinates are simple roots of integer polynomials.

## Main results

* `IsLocalRing.exists_list_subset_eq_maximalIdeal`: a generating set of the maximal ideal of a
  Noetherian local ring contains a minimal generating list.
* `IsLocalRing.span_sub_algebraMap_eq_maximalIdeal`: for a local `K`-algebra with residue field
  `K`, if the maximal ideal is generated by elements of the subring generated by `K` and the
  image of a ring `A`, then it is generated by the elements `α a - c` lying in it.
* `MvPolynomial.sub_C_eval_mem_span`: `p - p(c)` lies in the ideal generated by the `Xᵢ - cᵢ`.
-/

@[expose] public section

open CategoryTheory IsLocalRing

universe u

namespace IsLocalRing

/-- **A minimal generating list of the maximal ideal can be taken from any generating set.** Let
`T` be a Noetherian local ring and `S ⊆ 𝔪_T` a set generating `𝔪_T`. Then there is a list of
elements of `S`, of length the minimal number of generators of `𝔪_T`, generating `𝔪_T`. -/
theorem exists_list_subset_eq_maximalIdeal {T : Type*} [CommRing T] [IsLocalRing T]
    [IsNoetherianRing T] (S : Set T) (hS : S ⊆ maximalIdeal T)
    (hspan : Ideal.span S = maximalIdeal T) :
    ∃ xs : List T, (∀ x ∈ xs, x ∈ S) ∧
      xs.length = (maximalIdeal T).spanFinrank ∧ Ideal.ofList xs = maximalIdeal T := by
  classical
  let s : Set (maximalIdeal T) := {y | (y : T) ∈ S}
  have hcoe : ∀ t : Set (maximalIdeal T),
      Submodule.span T t = ⊤ ↔ Ideal.span (((↑) : maximalIdeal T → T) '' t) = maximalIdeal T := by
    intro t
    rw [← Submodule.map_injective_of_injective (maximalIdeal T).injective_subtype |>.eq_iff,
      Submodule.map_span, Submodule.map_top, Submodule.range_subtype]
    rfl
  have himg : ((↑) : maximalIdeal T → T) '' s = S :=
    Set.ext fun x => ⟨by rintro ⟨y, hy, rfl⟩; exact hy, fun hx => ⟨⟨x, hS hx⟩, hx, rfl⟩⟩
  have hs : Submodule.span T s = ⊤ := by
    rw [hcoe, himg, hspan]
  rw [← CotangentSpace.span_image_eq_top_iff] at hs
  obtain ⟨b, hbs, hbspan, hbli⟩ :=
    exists_linearIndependent (ResidueField T) ((maximalIdeal T).toCotangent '' s)
  rw [hs] at hbspan
  have hbfin : b.Finite := hbli.setFinite
  have hpre : ∀ c ∈ b, ∃ y : maximalIdeal T, (y : T) ∈ S ∧ (maximalIdeal T).toCotangent y = c :=
    fun c hc => hbs hc
  choose! pre hpreS hpreC using hpre
  let bs : Finset (CotangentSpace T) := hbfin.toFinset
  have hbs' : (bs : Set (CotangentSpace T)) = b := hbfin.coe_toFinset
  let xs : List T := bs.toList.map fun c => (pre c : T)
  refine ⟨xs, ?_, ?_, ?_⟩
  · intro x hx
    obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hx
    exact hpreS c (hbfin.mem_toFinset.1 (Finset.mem_toList.1 hc))
  · have hli : LinearIndependent (ResidueField T) ((↑) : bs → CotangentSpace T) := by
      rwa [← hbs'] at hbli
    have := finrank_span_finset_eq_card hli
    rw [hbs', hbspan, finrank_top] at this
    rw [List.length_map, Finset.length_toList, ← this,
      spanFinrank_maximalIdeal_eq_finrank_cotangentSpace]
  · let t : Set (maximalIdeal T) := {y | ∃ c ∈ b, y = pre c}
    have ht : (maximalIdeal T).toCotangent '' t = b := by
      refine Set.ext fun c => ⟨?_, fun hc => ⟨_, ⟨c, hc, rfl⟩, hpreC c hc⟩⟩
      rintro ⟨y, ⟨d, hd, rfl⟩, rfl⟩
      rwa [hpreC d hd]
    have htop : Submodule.span T t = ⊤ := by
      rw [← CotangentSpace.span_image_eq_top_iff, ht, hbspan]
    rw [hcoe] at htop
    rw [← htop, Ideal.ofList]
    congr 1
    refine Set.ext fun y => ⟨fun hy => ?_, ?_⟩
    · obtain ⟨c, hc, rfl⟩ := List.mem_map.1 hy
      exact ⟨pre c, ⟨c, hbfin.mem_toFinset.1 (Finset.mem_toList.1 hc), rfl⟩, rfl⟩
    · rintro ⟨_, ⟨c, hc, rfl⟩, rfl⟩
      exact List.mem_map.2 ⟨c, Finset.mem_toList.2 (hbfin.mem_toFinset.2 hc), rfl⟩

/-- **Generators of the maximal ideal of a rational point from a generating subring.** Let `O`
be a local `K`-algebra whose residue field is `K` (every element is congruent to an element of
`K` modulo `𝔪`), let `α : A → O` be a ring map, and suppose `𝔪` is generated by elements of the
subring generated by `K` and `α(A)` lying in `𝔪`. Then `𝔪` is generated by the elements
`α a - c` (`a ∈ A`, `c ∈ K`) lying in `𝔪`. -/
theorem span_sub_algebraMap_eq_maximalIdeal {K O A : Type*} [Field K] [CommRing O]
    [IsLocalRing O] [Algebra K O] [CommRing A] (α : A →+* O)
    (hrat : ∀ x : O, ∃ c : K, x - algebraMap K O c ∈ maximalIdeal O)
    (hgen : maximalIdeal O ≤ Ideal.span {x | x ∈ maximalIdeal O ∧
      x ∈ Subring.closure (Set.range α ∪ Set.range (algebraMap K O))}) :
    Ideal.span {x | x ∈ maximalIdeal O ∧ ∃ a c, x = α a - algebraMap K O c} =
      maximalIdeal O := by
  set J := Ideal.span {x | x ∈ maximalIdeal O ∧ ∃ a c, x = α a - algebraMap K O c} with hJ
  refine le_antisymm ((Ideal.span_le).2 fun x hx => hx.1) (hgen.trans ((Ideal.span_le).2 ?_))
  -- every element of the subring is a constant modulo `J`
  have hsub : ∀ x ∈ Subring.closure (Set.range α ∪ Set.range (algebraMap K O)),
      ∃ c : K, x - algebraMap K O c ∈ J := by
    intro x hx
    induction hx using Subring.closure_induction with
    | mem x hx =>
      rcases hx with ⟨a, rfl⟩ | ⟨c, rfl⟩
      · obtain ⟨c, hc⟩ := hrat (α a)
        exact ⟨c, Ideal.subset_span ⟨hc, a, c, rfl⟩⟩
      · exact ⟨c, by simp⟩
    | zero => exact ⟨0, by simp⟩
    | one => exact ⟨1, by simp⟩
    | add x y _ _ hx hy =>
      obtain ⟨c, hc⟩ := hx
      obtain ⟨d, hd⟩ := hy
      refine ⟨c + d, ?_⟩
      have : x + y - algebraMap K O (c + d) =
          (x - algebraMap K O c) + (y - algebraMap K O d) := by
        rw [map_add]; ring
      rw [this]
      exact J.add_mem hc hd
    | neg x _ hx =>
      obtain ⟨c, hc⟩ := hx
      refine ⟨-c, ?_⟩
      have : -x - algebraMap K O (-c) = -(x - algebraMap K O c) := by
        rw [map_neg]; ring
      rw [this]
      exact J.neg_mem hc
    | mul x y _ _ hx hy =>
      obtain ⟨c, hc⟩ := hx
      obtain ⟨d, hd⟩ := hy
      refine ⟨c * d, ?_⟩
      have : x * y - algebraMap K O (c * d) =
          x * (y - algebraMap K O d) + algebraMap K O d * (x - algebraMap K O c) := by
        rw [map_mul]; ring
      rw [this]
      exact J.add_mem (J.mul_mem_left _ hd) (J.mul_mem_left _ hc)
  rintro x ⟨hxm, hxT⟩
  obtain ⟨c, hc⟩ := hsub x hxT
  have hJm : J ≤ maximalIdeal O := (Ideal.span_le).2 fun y hy => hy.1
  have hcm : algebraMap K O c ∈ maximalIdeal O := by
    simpa using (maximalIdeal O).sub_mem hxm (hJm hc)
  have hc0 : c = 0 := by
    by_contra hne
    exact (mem_maximalIdeal _).1 hcm ((IsUnit.mk0 c hne).map (algebraMap K O))
  simpa [hc0] using hc

end IsLocalRing

namespace MvPolynomial

/-- **A polynomial minus its value at a point lies in the ideal of that point.** -/
theorem sub_C_eval_mem_span {σ R : Type*} [CommRing R] (c : σ → R) (p : MvPolynomial σ R) :
    p - C (eval c p) ∈ Ideal.span (Set.range fun i => X i - C (c i)) := by
  set J := Ideal.span (Set.range fun i => X i - C (c i)) with hJ
  induction p using MvPolynomial.induction_on with
  | C a => simp
  | add p q hp hq =>
    have : p + q - C (eval c (p + q)) = (p - C (eval c p)) + (q - C (eval c q)) := by
      simp only [map_add]; ring
    rw [this]
    exact J.add_mem hp hq
  | mul_X p i hp =>
    have : p * X i - C (eval c (p * X i)) =
        (p - C (eval c p)) * X i + C (eval c p) * (X i - C (c i)) := by
      simp only [map_mul, eval_X]; ring
    rw [this]
    exact J.add_mem (J.mul_mem_right _ hp) (J.mul_mem_left _ (Ideal.subset_span ⟨i, rfl⟩))

end MvPolynomial

/-- **Simple roots of integer polynomials are infinite in an algebraically closed field.** The
roots of unity of order prime to the characteristic are simple roots of `Xⁿ - 1`, and there are
`n` of them for infinitely many `n`. -/
theorem setOf_simpleRoot_infinite (K : Type*) [Field K] [IsAlgClosed K] :
    {x : K | ∃ G : Polynomial ℤ, Polynomial.aeval x G = 0 ∧
      Polynomial.aeval x (Polynomial.derivative G) ≠ 0}.Infinite := by
  classical
  intro hfin
  set N := hfin.toFinset.card
  obtain ⟨n, hnN, hn0⟩ : ∃ n : ℕ, N < n ∧ (n : K) ≠ 0 := by
    by_cases h : ((N + 1 : ℕ) : K) = 0
    · refine ⟨N + 2, by omega, ?_⟩
      have : ((N + 2 : ℕ) : K) = ((N + 1 : ℕ) : K) + 1 := by push_cast; ring
      rw [this, h, zero_add]
      exact one_ne_zero
    · exact ⟨N + 1, by omega, h⟩
  have hnpos : 0 < n := by omega
  have : NeZero (n : K) := ⟨hn0⟩
  obtain ⟨ζ, hζ⟩ := HasEnoughRootsOfUnity.exists_primitiveRoot K n
  have hsub : Polynomial.nthRootsFinset n (1 : K) ⊆ hfin.toFinset := by
    intro x hx
    rw [Polynomial.mem_nthRootsFinset hnpos] at hx
    rw [Set.Finite.mem_toFinset]
    refine ⟨Polynomial.X ^ n - 1, by simp [hx], ?_⟩
    have hx0 : x ≠ 0 := by
      rintro rfl
      rw [zero_pow hnpos.ne'] at hx
      exact zero_ne_one hx
    simp only [Polynomial.derivative_sub, Polynomial.derivative_X_pow, Polynomial.derivative_one,
      sub_zero, map_mul, Polynomial.aeval_X_pow, map_natCast]
    exact mul_ne_zero (by exact_mod_cast hn0) (pow_ne_zero _ hx0)
  have := Finset.card_le_card hsub
  rw [hζ.card_nthRootsFinset] at this
  omega



namespace MvPolynomial

/-- The kernel of evaluation at a point is a maximal ideal. -/
private theorem ker_eval_isMaximal {σ K : Type*} [Field K] (c : σ → K) :
    (RingHom.ker (eval c)).IsMaximal :=
  RingHom.ker_isMaximal_of_surjective _ fun k => ⟨C k, by simp⟩

/-- **The kernel of evaluation at a point is generated by the `Xᵢ - cᵢ`.** -/
theorem ker_eval_eq_span {σ K : Type*} [Field K] (c : σ → K) :
    RingHom.ker (eval c) = Ideal.span (Set.range fun i => X i - C (c i)) := by
  refine le_antisymm (fun r hr => ?_) ((Ideal.span_le).2 ?_)
  · have := sub_C_eval_mem_span c r
    rwa [RingHom.mem_ker.1 hr, map_zero, sub_zero] at this
  · rintro _ ⟨i, rfl⟩
    simp

end MvPolynomial

namespace IsLocalRing

/-- **A simple root of an integer polynomial, perturbed inside the maximal ideal.** Let `O` be a
local `K`-algebra, `b ∈ K` a simple root of `G ∈ ℤ[X]`, and `z ∈ O` congruent to `b` modulo `𝔪`.
Then `G(z) = (z - b) · u` for a unit `u`. -/
theorem exists_isUnit_aeval_eq_mul {K O : Type*} [Field K] [CommRing O] [IsLocalRing O]
    [Algebra K O] (G : Polynomial ℤ) (b : K) (hG : Polynomial.aeval b G = 0)
    (hG' : Polynomial.aeval b (Polynomial.derivative G) ≠ 0) (z : O)
    (hz : z - algebraMap K O b ∈ maximalIdeal O) :
    ∃ u : O, IsUnit u ∧ Polynomial.aeval z G = (z - algebraMap K O b) * u := by
  set GK := G.map (algebraMap ℤ K) with hGK
  have hroot : GK.IsRoot b := by
    rwa [Polynomial.IsRoot, hGK, Polynomial.eval_map_algebraMap]
  set H := GK /ₘ (Polynomial.X - Polynomial.C b) with hH
  have hfac : (Polynomial.X - Polynomial.C b) * H = GK :=
    Polynomial.mul_divByMonic_eq_iff_isRoot.2 hroot
  have hHb : H.eval b ≠ 0 := by
    have hd := congrArg (fun p => (Polynomial.derivative p).eval b) hfac
    simp only [Polynomial.derivative_mul, Polynomial.derivative_sub, Polynomial.derivative_X,
      Polynomial.derivative_C, sub_zero, one_mul, Polynomial.eval_add, Polynomial.eval_mul,
      Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C, sub_self, zero_mul,
      add_zero] at hd
    rwa [hd, hGK, Polynomial.derivative_map, Polynomial.eval_map_algebraMap]
  refine ⟨Polynomial.aeval z H, ?_, ?_⟩
  · by_contra hu
    have h1 : residue O (Polynomial.aeval z H) = 0 := (residue_eq_zero_iff _).2 hu
    have h2 : residue O z = residue O (algebraMap K O b) := by
      rw [← sub_eq_zero, ← map_sub]
      exact (residue_eq_zero_iff _).2 hz
    have h3 : residue O (Polynomial.aeval z H) = algebraMap K (ResidueField O) (H.eval b) := by
      have e1 : residue O (Polynomial.aeval z H) =
          Polynomial.aeval (residue O z) H :=
        (Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom K O (ResidueField O)) z H).symm
      rw [e1, h2]
      show Polynomial.aeval (algebraMap O (ResidueField O) (algebraMap K O b)) H = _
      rw [← IsScalarTower.algebraMap_apply, Polynomial.aeval_algebraMap_apply,
        Polynomial.coe_aeval_eq_eval]
    rw [h3] at h1
    exact hHb ((map_eq_zero_iff _ (algebraMap K (ResidueField O)).injective).1 h1)
  · have : Polynomial.aeval z G = Polynomial.aeval z GK := by
      rw [hGK, Polynomial.aeval_map_algebraMap]
    rw [this, ← hfac, map_mul, map_sub, Polynomial.aeval_X, Polynomial.aeval_C]

end IsLocalRing

namespace RingHom

/-- **Finiteness through a bijective first map.** -/
theorem finite_comp_of_bijective {K L M : Type*} [Field K] [Field L] [Field M]
    (a : K →+* L) (b : L →+* M) (ha : Function.Bijective a)
    (h : letI := b.toAlgebra; Module.Finite L M) :
    letI := (b.comp a).toAlgebra; Module.Finite K M := by
  let := a.toAlgebra
  let := b.toAlgebra
  let := (b.comp a).toAlgebra
  have : IsScalarTower K L M := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : Module.Finite K L :=
    Module.Finite.of_surjective (Algebra.linearMap K L) ha.2
  exact Module.Finite.trans L M

end RingHom

namespace AlgebraicGeometry

open Limits

/-- The map on global sections of `V ⟶ Spec R` induced by `θ`, on `(ΓSpecIso R).inv r`. -/
private theorem appTop_toSpecΓ_comp_inv_apply {V : Scheme.{u}} {R : CommRingCat.{u}}
    (θ : R ⟶ Γ(V, ⊤)) (r : R) :
    (V.toSpecΓ ≫ Spec.map θ).appTop ((Scheme.ΓSpecIso R).inv r) = θ r := by
  have h : (Scheme.ΓSpecIso R).inv ≫ (V.toSpecΓ ≫ Spec.map θ).appTop = θ := by
    rw [Scheme.Hom.comp_appTop, Scheme.toSpecΓ_appTop, Scheme.ΓSpecIso_naturality,
      ← Category.assoc, Iso.inv_hom_id, Category.id_comp]
  exact congrArg (fun k => k.hom r) h

/-- **Prime of a point under a morphism to an affine spectrum.** For a ring map
`θ : R ⟶ Γ(V, ⊤)` and the induced `ψ : V ⟶ Spec R`, an element of `R` lies in the prime of
`ψ v` exactly when the germ of its image at `v` is not a unit. -/
theorem mem_asIdeal_toSpecΓ_comp_iff {V : Scheme.{u}} {R : CommRingCat.{u}} (θ : R ⟶ Γ(V, ⊤))
    (v : V) (r : R) :
    r ∈ ((V.toSpecΓ ≫ Spec.map θ) v).asIdeal ↔
      V.presheaf.germ ⊤ v trivial (θ r) ∈ maximalIdeal (V.presheaf.stalk v) := by
  have h1 : v ∈ V.basicOpen (θ r) ↔ (V.toSpecΓ ≫ Spec.map θ) v ∈ PrimeSpectrum.basicOpen r := by
    rw [← appTop_toSpecΓ_comp_inv_apply θ r, ← basicOpen_eq_of_affine]
    show _ ↔ v ∈ (V.toSpecΓ ≫ Spec.map θ) ⁻¹ᵁ (Spec R).basicOpen ((Scheme.ΓSpecIso R).inv r)
    rw [Scheme.preimage_basicOpen]
    rfl
  rw [← not_iff_not, mem_maximalIdeal, mem_nonunits_iff, not_not, ← Scheme.mem_basicOpen_top, h1]
  rfl

/-- The map on global sections of the morphism `V ⟶ Spec R` induced by `θ : R ⟶ Γ(V, ⊤)`. -/
theorem appTop_toSpecΓ_comp_apply {V : Scheme.{u}} {R : CommRingCat.{u}} (θ : R ⟶ Γ(V, ⊤))
    (r : R) : (V.toSpecΓ ≫ Spec.map θ).appTop ((Scheme.ΓSpecIso R).inv r) = θ r :=
  appTop_toSpecΓ_comp_inv_apply θ r

/-- **The stalk map of `V ⟶ Spec R` on germs of elements of `R`.** -/
theorem stalkMap_toSpecΓ_comp_germ {V : Scheme.{u}} {R : CommRingCat.{u}} (θ : R ⟶ Γ(V, ⊤))
    (v : V) (r : R) :
    ((V.toSpecΓ ≫ Spec.map θ).stalkMap v).hom
        ((Spec R).presheaf.germ ⊤ ((V.toSpecΓ ≫ Spec.map θ) v) trivial
          ((Scheme.ΓSpecIso R).inv r)) =
      V.presheaf.germ ⊤ v trivial (θ r) :=
  (Scheme.Hom.germ_stalkMap_apply (V.toSpecΓ ≫ Spec.map θ) ⊤ v trivial _).trans
    (congrArg _ (appTop_toSpecΓ_comp_apply θ r))

/-- **The maximal ideal of a stalk of `Spec R` is generated by generators of the prime.** -/
theorem maximalIdeal_stalk_spec_eq_span {R : CommRingCat.{u}} (p : Spec R) (G : Set R)
    (hG : p.asIdeal = Ideal.span G) :
    maximalIdeal ((Spec R).presheaf.stalk p) =
      Ideal.span
        ((fun r => (Spec R).presheaf.germ ⊤ p trivial ((Scheme.ΓSpecIso R).inv r)) '' G) := by
  revert p G
  refine fun (p : PrimeSpectrum.Top R) G hG => ?_
  let : IsLocalRing ((structurePresheafInCommRingCat R).stalk p) :=
    IsLocalization.AtPrime.isLocalRing _ p.asIdeal
  have h := IsLocalization.AtPrime.map_eq_maximalIdeal (R := R) p.asIdeal
    ((structurePresheafInCommRingCat R).stalk p)
  rw [hG, Ideal.map_span] at h
  have himg : (fun r => (Spec R).presheaf.germ ⊤ p trivial ((Scheme.ΓSpecIso R).inv r)) '' G =
      (algebraMap R ((structurePresheafInCommRingCat R).stalk p)) '' G :=
    Set.image_congr fun r _ => rfl
  rw [himg]
  exact h.symm

/-- The morphism `V ⟶ Spec K[T₁, …, T_n]` sending `Tᵢ` to `xᵢ` lies over `Spec K`. -/
private theorem toSpecΓ_aeval_comp_spec_algebraMap {K : Type u} [Field K] {V : Scheme.{u}}
    (gV : V ⟶ Spec (.of K)) {n : ℕ} (x : Fin n → Γ(V, ⊤)) :
    letI : Algebra K Γ(V, ⊤) := ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop).hom.toAlgebra
    (V.toSpecΓ ≫ Spec.map (CommRingCat.ofHom (MvPolynomial.aeval (R := K) x).toRingHom)) ≫
      Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K))) = gV := by
  let _ : Algebra K Γ(V, ⊤) := ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop).hom.toAlgebra
  have h1 : CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin n) K)) ≫
      CommRingCat.ofHom (MvPolynomial.aeval (R := K) x).toRingHom =
        (Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop := by
    ext k
    simp [RingHom.algebraMap_toAlgebra]
  rw [Category.assoc, ← Spec.map_comp, h1, Spec.map_comp, ← Category.assoc,
    ← Scheme.toSpecΓ_naturality, Category.assoc, toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]

/-- Evaluation at `v` is compatible with the residue field map when `ψ ≫ q = gV`. -/
private theorem Γevaluation_comp_residueFieldMap {K : Type u} [Field K] {V Y : Scheme.{u}}
    (gV : V ⟶ Spec (.of K)) (ψ : V ⟶ Y) (q : Y ⟶ Spec (.of K)) (hψq : ψ ≫ q = gV) (v : V)
    (x : K) :
    V.Γevaluation v (gV.appTop ((Scheme.ΓSpecIso (.of K)).inv x)) =
      ψ.residueFieldMap v (Y.Γevaluation (ψ v) (q.appTop ((Scheme.ΓSpecIso (.of K)).inv x))) := by
  have happ : ψ.appTop (q.appTop ((Scheme.ΓSpecIso (.of K)).inv x)) =
      gV.appTop ((Scheme.ΓSpecIso (.of K)).inv x) := by
    rw [← hψq, Scheme.Hom.comp_appTop]
    rfl
  rw [Scheme.Γevaluation_naturality_apply, happ]


/-- **Étale coordinates at a rational point from functions of the target.** Let `V` be smooth
over a field `K`, `φ : V ⟶ U`, and `v₁ ∈ V` a point with residue field `K` whose maximal ideal is
generated by elements of the subring generated by `K` and the germs of `φ^* Γ(U)`. Then there
are `g₁, …, g_d ∈ Γ(U)` such that `V ⟶ Spec K[T₁, …, T_d]`, `Tᵢ ↦ φ^* gᵢ`, is étale at `v₁`. -/
theorem exists_etaleAt_toSpecΓ_mvPolynomial
    {K : Type u} [Field K] {V U : Scheme.{u}} (gV : V ⟶ Spec (.of K)) [Smooth gV]
    (φ : V ⟶ U) (v₁ : V)
    (hsep : letI := ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop ≫ V.Γevaluation v₁).hom.toAlgebra
      Module.Finite K (V.residueField v₁) ∧ Algebra.IsSeparable K (V.residueField v₁))
    (hrat : letI : Algebra K (V.presheaf.stalk v₁) :=
        ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop ≫ V.presheaf.germ ⊤ v₁ trivial).hom.toAlgebra
      ∀ x : V.presheaf.stalk v₁, ∃ c : K, x - algebraMap K _ c ∈ maximalIdeal _)
    (hgen : letI : Algebra K (V.presheaf.stalk v₁) :=
        ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop ≫ V.presheaf.germ ⊤ v₁ trivial).hom.toAlgebra
      maximalIdeal (V.presheaf.stalk v₁) ≤ Ideal.span {x | x ∈ maximalIdeal (V.presheaf.stalk v₁) ∧
        x ∈ Subring.closure (Set.range (fun a : Γ(U, ⊤) =>
            V.presheaf.germ ⊤ v₁ trivial (φ.appTop a)) ∪
          Set.range (algebraMap K (V.presheaf.stalk v₁)))}) :
    letI : Algebra K Γ(V, ⊤) := ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop).hom.toAlgebra
    ∃ (d : ℕ) (g : Fin d → Γ(U, ⊤)),
      EtaleAt (V.toSpecΓ ≫ Spec.map (CommRingCat.ofHom
        (MvPolynomial.aeval (R := K) (fun i => φ.appTop (g i))).toRingHom)) v₁ := by
  classical
  let algΓ : Algebra K Γ(V, ⊤) := ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop).hom.toAlgebra
  let algO : Algebra K (V.presheaf.stalk v₁) :=
    ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop ≫ V.presheaf.germ ⊤ v₁ trivial).hom.toAlgebra
  set α : Γ(U, ⊤) →+* V.presheaf.stalk v₁ :=
    (V.presheaf.germ ⊤ v₁ trivial).hom.comp φ.appTop.hom with hα
  have hregL : IsRegularLocalRing (V.presheaf.stalk v₁) :=
    (isRegular_of_smooth_over_field gV).isRegularLocalRing_stalk v₁
  obtain ⟨xs, hxsS, hlen, hofList⟩ := IsLocalRing.exists_list_subset_eq_maximalIdeal _
    (fun x hx => hx.1) (IsLocalRing.span_sub_algebraMap_eq_maximalIdeal α hrat hgen)
  have hpick : ∀ i : Fin xs.length, ∃ a c, xs.get i = α a - algebraMap K _ c :=
    fun i => (hxsS _ (List.get_mem _ _)).2
  choose g cval hgc using hpick
  refine ⟨xs.length, g, ?_⟩
  set θ : CommRingCat.of (MvPolynomial (Fin xs.length) K) ⟶ Γ(V, ⊤) := CommRingCat.ofHom
    (MvPolynomial.aeval (R := K) (fun i => φ.appTop (g i))).toRingHom with hθ
  set ψ := V.toSpecΓ ≫ Spec.map θ with hψ
  set q : Spec (.of (MvPolynomial (Fin xs.length) K)) ⟶ Spec (.of K) :=
    Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin xs.length) K))) with hq
  have hψq : ψ ≫ q = gV := toSpecΓ_aeval_comp_spec_algebraMap gV _
  have : LocallyOfFiniteType (ψ ≫ q) := by rw [hψq]; infer_instance
  have : LocallyOfFiniteType ψ := LocallyOfFiniteType.of_comp (g := q) inferInstance
  have : Smooth q := by
    rw [hq, HasRingHomProperty.Spec_iff (P := @Smooth)]
    exact RingHom.smooth_algebraMap.2
      (show Algebra.Smooth K (MvPolynomial (Fin xs.length) K) from {})
  -- the prime of `ψ v₁`
  have hθX : ∀ i, θ (MvPolynomial.X i - MvPolynomial.C (cval i)) =
      φ.appTop (g i) - algebraMap K Γ(V, ⊤) (cval i) := by
    intro i
    simp [θ]
  have hgermX : ∀ i, V.presheaf.germ ⊤ v₁ trivial
      (θ (MvPolynomial.X i - MvPolynomial.C (cval i))) = xs.get i := by
    intro i
    rw [hθX, map_sub, hgc]
    rfl
  set G : Set (MvPolynomial (Fin xs.length) K) :=
    Set.range fun i => MvPolynomial.X i - MvPolynomial.C (cval i) with hG
  have hPle : Ideal.span G ≤ (ψ v₁).asIdeal := by
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    refine (mem_asIdeal_toSpecΓ_comp_iff θ v₁ _).2 ?_
    rw [hgermX]
    exact (hxsS _ (List.get_mem _ _)).1
  have hker : Ideal.span G = RingHom.ker (MvPolynomial.eval cval) :=
    (MvPolynomial.ker_eval_eq_span cval).symm
  have hmax : (Ideal.span G).IsMaximal := by
    rw [hker]
    exact MvPolynomial.ker_eval_isMaximal cval
  have hP : (ψ v₁).asIdeal = Ideal.span G :=
    (hmax.eq_of_le (ψ v₁).2.ne_top hPle).symm
  have hmP := maximalIdeal_stalk_spec_eq_span (ψ v₁) G hP
  have hA : Ideal.map (ψ.stalkMap v₁).hom (maximalIdeal _) =
      maximalIdeal (V.presheaf.stalk v₁) := by
    rw [hmP, Ideal.map_span, ← hofList, Ideal.ofList]
    congr 1
    ext y
    simp only [Set.mem_image, hG, Set.mem_range, exists_exists_eq_and, Set.mem_setOf_eq]
    constructor
    · rintro ⟨i, rfl⟩
      rw [stalkMap_toSpecΓ_comp_germ, hgermX]
      exact List.get_mem _ _
    · intro hy
      obtain ⟨i, rfl⟩ := List.get_of_mem hy
      exact ⟨i, by rw [stalkMap_toSpecΓ_comp_germ, hgermX]⟩
  have hB : let := (ψ.residueFieldMap v₁).hom.toAlgebra
      Module.Finite ((Spec (.of (MvPolynomial (Fin xs.length) K))).residueField (ψ v₁))
          (V.residueField v₁) ∧
        Algebra.IsSeparable ((Spec (.of (MvPolynomial (Fin xs.length) K))).residueField (ψ v₁))
          (V.residueField v₁) := by
    let : Algebra K ((Spec (.of (MvPolynomial (Fin xs.length) K))).residueField (ψ v₁)) :=
      ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫
        (Spec (.of (MvPolynomial (Fin xs.length) K))).Γevaluation (ψ v₁)).hom.toAlgebra
    let : Algebra ((Spec (.of (MvPolynomial (Fin xs.length) K))).residueField (ψ v₁))
        (V.residueField v₁) := (ψ.residueFieldMap v₁).hom.toAlgebra
    let : Algebra K (V.residueField v₁) :=
      ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop ≫ V.Γevaluation v₁).hom.toAlgebra
    have : IsScalarTower K ((Spec (.of (MvPolynomial (Fin xs.length) K))).residueField (ψ v₁))
        (V.residueField v₁) :=
      IsScalarTower.of_algebraMap_eq (Γevaluation_comp_residueFieldMap gV ψ q hψq v₁)
    have : Module.Finite K (V.residueField v₁) := hsep.1
    have : Algebra.IsSeparable K (V.residueField v₁) := hsep.2
    exact ⟨Module.Finite.of_restrictScalars_finite K _ _,
      Algebra.isSeparable_tower_top_of_isSeparable K _ _⟩
  have h17 := (unramifiedAt_tfae ψ v₁).out 1 7
  have hunr : UnramifiedAt ψ v₁ := h17.2 ⟨hA, hB⟩
  -- the dimensions agree
  have hregP : IsRegularLocalRing
      ((Spec (.of (MvPolynomial (Fin xs.length) K))).presheaf.stalk (ψ v₁)) :=
    (isRegular_of_smooth_over_field q).isRegularLocalRing_stalk (ψ v₁)
  have hle1 : (maximalIdeal ((Spec (.of (MvPolynomial (Fin xs.length) K))).presheaf.stalk
      (ψ v₁))).spanFinrank ≤ xs.length := by
    rw [hmP]
    have hfin : (((fun r => (Spec (.of (MvPolynomial (Fin xs.length) K))).presheaf.germ ⊤ (ψ v₁)
        trivial ((Scheme.ΓSpecIso _).inv r)) '' G)).Finite :=
      (Set.finite_range _).image _
    refine (Submodule.spanFinrank_span_le_ncard_of_finite hfin).trans ?_
    refine (Set.ncard_image_le (Set.finite_range _)).trans ?_
    rw [← Set.image_univ]
    exact (Set.ncard_image_le Set.finite_univ).trans (by rw [Set.ncard_univ]; simp)
  have hle2 : xs.length ≤
      (maximalIdeal ((Spec (.of (MvPolynomial (Fin xs.length) K))).presheaf.stalk
        (ψ v₁))).spanFinrank := by
    obtain ⟨s, hsenc, hspan⟩ := Submodule.FG.exists_span_set_encard_eq_spanFinrank
      (IsNoetherian.noetherian (maximalIdeal
        ((Spec (.of (MvPolynomial (Fin xs.length) K))).presheaf.stalk (ψ v₁))))
    have hm : maximalIdeal (V.presheaf.stalk v₁) = Ideal.span ((ψ.stalkMap v₁).hom '' s) := by
      rw [← hA, ← Ideal.map_span]
      congr 1
      exact hspan.symm
    have h1 : ((maximalIdeal (V.presheaf.stalk v₁)).spanFinrank : ℕ∞) ≤
        ((ψ.stalkMap v₁).hom '' s).encard := by
      rw [hm]
      exact Submodule.spanFinrank_span_le_encard _
    have h2 := h1.trans ((Set.encard_image_le _ _).trans hsenc.le)
    rw [← hlen] at h2
    exact_mod_cast h2
  have hdim : ringKrullDim (V.presheaf.stalk v₁) =
      ringKrullDim ((Spec (.of (MvPolynomial (Fin xs.length) K))).presheaf.stalk (ψ v₁)) := by
    rw [← IsRegularLocalRing.spanFinrank_maximalIdeal,
      ← IsRegularLocalRing.spanFinrank_maximalIdeal, ← hlen, le_antisymm hle1 hle2]
  exact etaleAt_of_unramifiedAt_of_ringKrullDim_eq ψ v₁ hunr hdim


/-- **A point of a smooth scheme over an algebraically closed field cut out by integral
functions of the target.** Let `V` be nonempty and smooth over an algebraically closed field
`K` and `φ : V ⟶ U` such that at every point the maximal ideal of `𝒪_{V, v}` is generated by
elements of the subring generated by `K` and the germs of `φ^* Γ(U)` (for instance when
`V ⟶ U ×_S Spec K` is unramified). Then there is a point `v ∈ V` with residue field `K` at which
the maximal ideal of `𝒪_{U, φ v}` generates the maximal ideal of `𝒪_{V, v}`. -/
theorem exists_point_map_maximalIdeal_eq_of_isAlgClosed
    {K : Type u} [Field K] [IsAlgClosed K] {V U : Scheme.{u}} (gV : V ⟶ Spec (.of K))
    [Smooth gV] (φ : V ⟶ U) [Nonempty V]
    (hgen : ∀ v : V, letI : Algebra K (V.presheaf.stalk v) :=
        ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop ≫ V.presheaf.germ ⊤ v trivial).hom.toAlgebra
      maximalIdeal (V.presheaf.stalk v) ≤ Ideal.span {x | x ∈ maximalIdeal (V.presheaf.stalk v) ∧
        x ∈ Subring.closure (Set.range (fun a : Γ(U, ⊤) =>
            V.presheaf.germ ⊤ v trivial (φ.appTop a)) ∪
          Set.range (algebraMap K (V.presheaf.stalk v)))}) :
    ∃ v : V, (letI := ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop ≫ V.Γevaluation v).hom.toAlgebra
        Module.Finite K (V.residueField v) ∧ Algebra.IsSeparable K (V.residueField v)) ∧
      Ideal.map (φ.stalkMap v).hom (maximalIdeal (U.presheaf.stalk (φ v))) =
        maximalIdeal (V.presheaf.stalk v) := by
  classical
  obtain ⟨v₁, -, hsep₁⟩ :=
    (dense_closedPoints_with_finite_separable_residueField_of_smooth gV).nonempty
  have hrat : letI : Algebra K (V.presheaf.stalk v₁) :=
        ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop ≫ V.presheaf.germ ⊤ v₁ trivial).hom.toAlgebra
      ∀ x : V.presheaf.stalk v₁, ∃ c : K, x - algebraMap K _ c ∈ maximalIdeal _ := by
    let : Algebra K (V.residueField v₁) :=
      ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop ≫ V.Γevaluation v₁).hom.toAlgebra
    have : Module.Finite K (V.residueField v₁) := hsep₁.1
    intro x
    obtain ⟨c, hc⟩ := (IsAlgClosed.algebraMap_bijective_of_isIntegral (k := K)
      (K := V.residueField v₁)).2 (V.residue v₁ x)
    refine ⟨c, (IsLocalRing.residue_eq_zero_iff _).1 ?_⟩
    rw [map_sub, sub_eq_zero]
    exact hc.symm
  obtain ⟨d, g, hEt⟩ := exists_etaleAt_toSpecΓ_mvPolynomial gV φ v₁ hsep₁ hrat (hgen v₁)
  let algΓ : Algebra K Γ(V, ⊤) := ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop).hom.toAlgebra
  set θ : CommRingCat.of (MvPolynomial (Fin d) K) ⟶ Γ(V, ⊤) := CommRingCat.ofHom
    (MvPolynomial.aeval (R := K) (fun i => φ.appTop (g i))).toRingHom with hθ
  set ψ := V.toSpecΓ ≫ Spec.map θ with hψ
  obtain ⟨U', hU', hv₁U', V', hV', e, hEtR⟩ := hEt
  have : Etale (ψ.resLE V' U' e) := etale_resLE_of_appLE_etale ψ U' hU' V' hV' e hEtR
  have : UniversallyOpen (ψ.resLE V' U' e) := inferInstance
  have hOopen : IsOpen (Set.range (U'.ι ≫ ψ)) := by
    rw [← Scheme.Hom.resLE_comp_ι]
    exact (V'.ι.isOpenEmbedding.isOpenMap.comp (ψ.resLE V' U' e).isOpenMap).isOpen_range
  have hv₁O : ψ v₁ ∈ Set.range (U'.ι ≫ ψ) := ⟨⟨v₁, hv₁U'⟩, rfl⟩
  obtain ⟨_, ⟨h, rfl⟩, hh₁, hhO⟩ :=
    PrimeSpectrum.isTopologicalBasis_basic_opens.exists_subset_of_mem_open hv₁O hOopen
  have hh0 : h ≠ 0 := by
    rintro rfl
    exact hh₁ (Ideal.zero_mem _)
  -- a point with coordinates simple roots of integer polynomials
  set Sg : Set K := {x : K | ∃ G : Polynomial ℤ, Polynomial.aeval x G = 0 ∧
      Polynomial.aeval x (Polynomial.derivative G) ≠ 0} with hSg
  obtain ⟨b, hbS, hbh⟩ : ∃ b ∈ Set.pi Set.univ (fun _ : Fin d => Sg),
      MvPolynomial.eval b h ≠ 0 := by
    by_contra hcon
    have hcon' : ∀ x ∈ Set.pi Set.univ (fun _ : Fin d => Sg), MvPolynomial.eval x h = 0 :=
      fun x hx => Classical.byContradiction fun hne => hcon ⟨x, hx, hne⟩
    exact hh0 (MvPolynomial.funext_set (fun _ => Sg) (fun _ => setOf_simpleRoot_infinite K)
      (q := 0) fun x hx => by rw [hcon' x hx, map_zero])
  have hbmax : (RingHom.ker (MvPolynomial.eval (R := K) b)).IsMaximal :=
    MvPolynomial.ker_eval_isMaximal b
  let Pb : Spec (.of (MvPolynomial (Fin d) K)) := ⟨RingHom.ker (MvPolynomial.eval b), hbmax.isPrime⟩
  obtain ⟨u, hu⟩ := hhO (show Pb ∈ PrimeSpectrum.basicOpen h from hbh)
  set v : V := U'.ι u with hvdef
  have hψv : ψ v = Pb := hu
  have hEtv : EtaleAt ψ v := ⟨U', hU', u.2, V', hV', e, hEtR⟩
  have hunr : UnramifiedAt ψ v := ((etaleAt_iff_smoothAt_and_unramifiedAt ψ v).1 hEtv).2
  set q : Spec (.of (MvPolynomial (Fin d) K)) ⟶ Spec (.of K) :=
    Spec.map (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin d) K))) with hq
  have hψq : ψ ≫ q = gV := toSpecΓ_aeval_comp_spec_algebraMap gV _
  have : LocallyOfFiniteType (ψ ≫ q) := by rw [hψq]; infer_instance
  have : LocallyOfFiniteType ψ := LocallyOfFiniteType.of_comp (g := q) inferInstance
  obtain ⟨hA, hB⟩ := ((unramifiedAt_tfae ψ v).out 1 7).1 hunr
  -- the maximal ideal at `v` is generated by the `φ^* gᵢ - bᵢ`
  let algO : Algebra K (V.presheaf.stalk v) :=
    ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop ≫ V.presheaf.germ ⊤ v trivial).hom.toAlgebra
  set z : Fin d → V.presheaf.stalk v := fun i => V.presheaf.germ ⊤ v trivial (φ.appTop (g i))
    with hz
  have hθX : ∀ i, V.presheaf.germ ⊤ v trivial
      (θ (MvPolynomial.X i - MvPolynomial.C (b i))) = z i - algebraMap K _ (b i) := by
    intro i
    simp only [θ, CommRingCat.hom_ofHom, AlgHom.toRingHom_eq_coe, RingHom.coe_coe, map_sub,
      MvPolynomial.aeval_X, MvPolynomial.aeval_C, z]
    rfl
  have hPb : (ψ v).asIdeal = Ideal.span (Set.range fun i =>
      MvPolynomial.X i - MvPolynomial.C (b i)) := by
    rw [hψv]
    exact MvPolynomial.ker_eval_eq_span b
  have hmv : maximalIdeal (V.presheaf.stalk v) =
      Ideal.span (Set.range fun i => z i - algebraMap K _ (b i)) := by
    rw [← hA, maximalIdeal_stalk_spec_eq_span (ψ v) _ hPb, Ideal.map_span]
    congr 1
    ext y
    simp only [Set.mem_image, Set.mem_range, exists_exists_eq_and]
    constructor <;> rintro ⟨i, rfl⟩ <;> exact ⟨i, by rw [stalkMap_toSpecΓ_comp_germ, hθX]⟩
  have hym : ∀ i, z i - algebraMap K _ (b i) ∈ maximalIdeal (V.presheaf.stalk v) := fun i => by
    rw [hmv]
    exact Ideal.subset_span ⟨i, rfl⟩
  -- the integer polynomials
  have hbS : ∀ i, ∃ G : Polynomial ℤ, Polynomial.aeval (b i) G = 0 ∧
      Polynomial.aeval (b i) (Polynomial.derivative G) ≠ 0 := fun i => hbS i (Set.mem_univ i)
  choose G hG hG' using hbS
  have hfac : ∀ i, ∃ w : V.presheaf.stalk v, IsUnit w ∧
      Polynomial.aeval (z i) (G i) = (z i - algebraMap K _ (b i)) * w := fun i =>
    IsLocalRing.exists_isUnit_aeval_eq_mul (G i) (b i) (hG i) (hG' i) (z i) (hym i)
  choose w hw hzw using hfac
  set f : Fin d → Γ(U, ⊤) := fun i => Polynomial.aeval (g i) (G i) with hf
  have himf : ∀ i, (φ.stalkMap v).hom (U.presheaf.germ ⊤ (φ v) trivial (f i)) =
      Polynomial.aeval (z i) (G i) := by
    intro i
    rw [Scheme.Hom.germ_stalkMap_apply φ ⊤ v trivial]
    exact (Polynomial.aeval_algHom_apply
      ((V.presheaf.germ ⊤ v trivial).hom.comp φ.appTop.hom).toIntAlgHom (g i) (G i)).symm
  have hfm : ∀ i, U.presheaf.germ ⊤ (φ v) trivial (f i) ∈
      maximalIdeal (U.presheaf.stalk (φ v)) := by
    intro i
    rw [mem_maximalIdeal, mem_nonunits_iff]
    intro hu
    have h1 := hu.map (φ.stalkMap v).hom
    rw [himf, hzw] at h1
    exact (mem_maximalIdeal _).1 ((maximalIdeal _).mul_mem_right _ (hym i)) h1
  have hmap : Ideal.map (φ.stalkMap v).hom (maximalIdeal (U.presheaf.stalk (φ v))) =
      maximalIdeal (V.presheaf.stalk v) := by
    refine le_antisymm ?_ ?_
    · rw [Ideal.map_le_iff_le_comap]
      intro x hx
      exact map_nonunit _ x hx
    · rw [hmv, Ideal.span_le]
      rintro _ ⟨i, rfl⟩
      have h1 : (z i - algebraMap K _ (b i)) =
          (φ.stalkMap v).hom (U.presheaf.germ ⊤ (φ v) trivial (f i)) * ↑(hw i).unit⁻¹ := by
        rw [himf, hzw, mul_assoc, IsUnit.mul_val_inv, mul_one]
      show (z i - algebraMap K _ (b i)) ∈ _
      rw [h1]
      exact Ideal.mul_mem_right _ _ (Ideal.mem_map_of_mem _ (hfm i))
  -- the residue field at `v` is `K`
  have ha : Function.Bijective ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫
      (Spec (.of (MvPolynomial (Fin d) K))).Γevaluation (ψ v)).hom := by
    have hmaxv : (ψ v).asIdeal.IsMaximal := by rw [hψv]; exact hbmax
    refine ⟨RingHom.injective _, fun y => ?_⟩
    have e := Scheme.Spec.algebraMap_residueFieldIso_inv (.of (MvPolynomial (Fin d) K)) (ψ v)
    obtain ⟨r, hr⟩ := Ideal.algebraMap_residueField_surjective (ψ v).asIdeal
      ((Scheme.Spec.residueFieldIso (.of (MvPolynomial (Fin d) K)) (ψ v)).hom y)
    have hy : y = (Spec (.of (MvPolynomial (Fin d) K))).residue (ψ v)
        ((Spec (.of (MvPolynomial (Fin d) K))).presheaf.germ ⊤ (ψ v) trivial
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin d) K))).inv r)) := by
      have this : (Scheme.Spec.residueFieldIso _ (ψ v)).inv
          (algebraMap (MvPolynomial (Fin d) K) _ r) =
          (Spec (.of (MvPolynomial (Fin d) K))).residue (ψ v)
            ((Spec (.of (MvPolynomial (Fin d) K))).presheaf.germ ⊤ (ψ v) trivial
              ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin d) K))).inv r)) :=
        congrArg (fun k => k.hom r) e
      rw [← this, hr]
      exact (Iso.hom_inv_id_apply _ y).symm
    set c := MvPolynomial.eval b r with hc
    have hdiff : r - MvPolynomial.C c ∈ (ψ v).asIdeal := by
      rw [hψv]
      show MvPolynomial.eval b (r - MvPolynomial.C c) = 0
      simp [hc]
    have hgm : (Spec (.of (MvPolynomial (Fin d) K))).presheaf.germ ⊤ (ψ v) trivial
        ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin d) K))).inv (r - MvPolynomial.C c)) ∈
          maximalIdeal _ := by
      rw [mem_maximalIdeal, mem_nonunits_iff, ← Scheme.mem_basicOpen_top, basicOpen_eq_of_affine]
      exact fun h => h hdiff
    have hq' : q.appTop ((Scheme.ΓSpecIso (.of K)).inv c) =
        (Scheme.ΓSpecIso (.of (MvPolynomial (Fin d) K))).inv (MvPolynomial.C c) :=
      (congrArg (fun k => k.hom c) (Scheme.ΓSpecIso_inv_naturality
        (CommRingCat.ofHom (algebraMap K (MvPolynomial (Fin d) K))))).symm
    refine ⟨c, ?_⟩
    show (Spec (.of (MvPolynomial (Fin d) K))).residue (ψ v)
        ((Spec (.of (MvPolynomial (Fin d) K))).presheaf.germ ⊤ (ψ v) trivial
          (q.appTop ((Scheme.ΓSpecIso (.of K)).inv c))) = y
    rw [hq', hy]
    have h0 : (Spec (.of (MvPolynomial (Fin d) K))).residue (ψ v)
        ((Spec (.of (MvPolynomial (Fin d) K))).presheaf.germ ⊤ (ψ v) trivial
          ((Scheme.ΓSpecIso (.of (MvPolynomial (Fin d) K))).inv (r - MvPolynomial.C c))) = 0 :=
      (IsLocalRing.residue_eq_zero_iff _).2 hgm
    rw [map_sub, map_sub, map_sub, sub_eq_zero] at h0
    exact h0.symm
  have heqalg : ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop ≫ V.Γevaluation v).hom =
      (ψ.residueFieldMap v).hom.comp ((Scheme.ΓSpecIso (.of K)).inv ≫ q.appTop ≫
        (Spec (.of (MvPolynomial (Fin d) K))).Γevaluation (ψ v)).hom := by
    ext x
    exact Γevaluation_comp_residueFieldMap gV ψ q hψq v x
  refine ⟨v, ?_, hmap⟩
  have hfin := RingHom.finite_comp_of_bijective _ (ψ.residueFieldMap v).hom ha hB.1
  rw [← heqalg] at hfin
  let := ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop ≫ V.Γevaluation v).hom.toAlgebra
  have : Module.Finite K (V.residueField v) := hfin
  exact ⟨hfin, inferInstance⟩


/-- **Generators of the maximal ideal from unramifiedness over an affine fibre product.** Let
`φ : V ⟶ U` and `gV : V ⟶ Spec K` agree over an affine scheme `T`, with `U` affine. If the
induced morphism `V ⟶ U ×_T Spec K` is unramified at `v`, then the maximal ideal of `𝒪_{V, v}`
is generated by elements lying in it of the subring generated by `K` and the germs of
`φ^* Γ(U)`. This is the input of
`AlgebraicGeometry.exists_point_map_maximalIdeal_eq_of_isAlgClosed`. -/
theorem maximalIdeal_le_span_closure_of_unramifiedAt_pullback
    {K : Type u} [Field K] {V U T : Scheme.{u}} [IsAffine U] [IsAffine T]
    (aU : U ⟶ T) (k : Spec (.of K) ⟶ T) (gV : V ⟶ Spec (.of K)) (φ : V ⟶ U)
    (hc : φ ≫ aU = gV ≫ k) (v : V) [LocallyOfFiniteType (pullback.lift φ gV hc)]
    (h : UnramifiedAt (pullback.lift φ gV hc) v) :
    letI : Algebra K (V.presheaf.stalk v) :=
      ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop ≫ V.presheaf.germ ⊤ v trivial).hom.toAlgebra
    maximalIdeal (V.presheaf.stalk v) ≤ Ideal.span {x | x ∈ maximalIdeal (V.presheaf.stalk v) ∧
      x ∈ Subring.closure (Set.range (fun a : Γ(U, ⊤) =>
          V.presheaf.germ ⊤ v trivial (φ.appTop a)) ∪
        Set.range (algebraMap K (V.presheaf.stalk v)))} := by
  let algO : Algebra K (V.presheaf.stalk v) :=
    ((Scheme.ΓSpecIso (.of K)).inv ≫ gV.appTop ≫ V.presheaf.germ ⊤ v trivial).hom.toAlgebra
  set f := pullback.lift φ gV hc with hf
  set Tsub := Subring.closure (Set.range (fun a : Γ(U, ⊤) =>
      V.presheaf.germ ⊤ v trivial (φ.appTop a)) ∪ Set.range (algebraMap K (V.presheaf.stalk v)))
    with hTsub
  set ρ : Γ(pullback aU k, ⊤) →+* V.presheaf.stalk v :=
    (V.presheaf.germ ⊤ v trivial).hom.comp f.appTop.hom with hρ
  have hgenY := CommRingCat.closure_range_union_range_eq_top_of_isPushout
    (isPushout_appTop_of_isPullback (IsPullback.of_hasPullback aU k))
  have hρT : ∀ y : Γ(pullback aU k, ⊤), ρ y ∈ Tsub := by
    intro y
    have hle : Subring.closure (Set.range (pullback.fst aU k).appTop ∪
        Set.range (pullback.snd aU k).appTop) ≤ Tsub.comap ρ := by
      rw [Subring.closure_le]
      rintro _ (⟨a, rfl⟩ | ⟨c, rfl⟩)
      · have e1 : f.appTop ((pullback.fst aU k).appTop a) = φ.appTop a := by
          have := congrArg (fun m => m.appTop.hom a) (pullback.lift_fst φ gV hc)
          rwa [Scheme.Hom.comp_appTop] at this
        refine Subring.subset_closure (Or.inl ⟨a, ?_⟩)
        show V.presheaf.germ ⊤ v trivial (φ.appTop a) =
          V.presheaf.germ ⊤ v trivial (f.appTop ((pullback.fst aU k).appTop a))
        rw [e1]
      · have e2 : f.appTop ((pullback.snd aU k).appTop c) = gV.appTop c := by
          have := congrArg (fun m => m.appTop.hom c) (pullback.lift_snd φ gV hc)
          rwa [Scheme.Hom.comp_appTop] at this
        refine Subring.subset_closure (Or.inr ⟨(Scheme.ΓSpecIso (.of K)).hom c, ?_⟩)
        show V.presheaf.germ ⊤ v trivial
            (gV.appTop ((Scheme.ΓSpecIso (.of K)).inv ((Scheme.ΓSpecIso (.of K)).hom c))) =
          V.presheaf.germ ⊤ v trivial (f.appTop ((pullback.snd aU k).appTop c))
        rw [Iso.hom_inv_id_apply, e2]
    exact hle (hgenY ▸ Subring.mem_top y)
  have h17 := (unramifiedAt_tfae f v).out 1 7
  refine (h17.1 h).1.symm.le.trans ?_
  rw [Ideal.map_le_iff_le_comap]
  intro x hx
  let : Algebra Γ(pullback aU k, ⊤) ((pullback aU k).presheaf.stalk (f v)) :=
    ((pullback aU k).presheaf.germ ⊤ (f v) trivial).hom.toAlgebra
  have hloc := (isAffineOpen_top (pullback aU k)).isLocalization_stalk ⟨f v, trivial⟩
  obtain ⟨⟨a, b⟩, hab⟩ := IsLocalization.surj
    ((isAffineOpen_top (pullback aU k)).primeIdealOf ⟨f v, trivial⟩).asIdeal.primeCompl x
  have hbu : IsUnit ((pullback aU k).presheaf.germ ⊤ (f v) trivial b) :=
    IsLocalization.map_units _ b
  have hgerm : ∀ y : Γ(pullback aU k, ⊤), (f.stalkMap v).hom
      ((pullback aU k).presheaf.germ ⊤ (f v) trivial y) = ρ y := fun y =>
    Scheme.Hom.germ_stalkMap_apply f ⊤ v trivial y
  have hab' : (f.stalkMap v).hom x * ρ b = ρ a := by
    rw [← hgerm, ← hgerm, ← map_mul]
    exact congrArg _ hab
  have hxm : (f.stalkMap v).hom x ∈ maximalIdeal (V.presheaf.stalk v) := map_nonunit _ x hx
  have hρbu : IsUnit (ρ b) := by rw [← hgerm]; exact hbu.map _
  have hρa : ρ a ∈ Ideal.span {x | x ∈ maximalIdeal (V.presheaf.stalk v) ∧ x ∈ Tsub} := by
    refine Ideal.subset_span ⟨?_, hρT a⟩
    rw [← hab']
    exact Ideal.mul_mem_right _ _ hxm
  rw [Ideal.mem_comap]
  have : (f.stalkMap v).hom x = ρ a * ↑hρbu.unit⁻¹ := by
    rw [← hab', mul_assoc, IsUnit.mul_val_inv, mul_one]
  rw [this]
  exact Ideal.mul_mem_right _ _ hρa

end AlgebraicGeometry

