/-!
# Generating an invertible module by dimension plus one sections

Over an infinite field, an invertible module on an algebraic scheme generated by the image of
a vector space is already generated by the image of a subspace of dimension at most one more
than the dimension of the scheme.

## Main results

* `AlgebraicGeometry.exists_submodule_generatingSections_finrank_le_dimension_add_one`: the
  bounded-dimensional generating subspace.

## Implementation notes

Generation is expressed by the epimorphism from the free module associated with the given
family of global sections, with a single section over the whole scheme read as a compatible
family over all opens by `Stacks.SheafOfModules.sectionsOfTop`. The dimension bound is stated
in natural numbers, with the
dimension of the empty scheme read as zero, so that the conclusion is meaningful there too
even though its topological Krull dimension is `⊥`.

The combinatorial core is `exists_finset_avoiding_submodules`: on a Noetherian space, given a
family of proper subspaces indexed by the points, closed in the sense that each vector has a
closed vanishing locus, a set of at most `n` vectors escaping every subspace exists as soon as
every chain of irreducible closed subsets has length less than `n`. Infinitude of the base
field is what lets a single vector avoid the finitely many subspaces attached to the generic
points of the irreducible components at each stage.

## References

* [Stacks Project, Tag 0B3Z](https://stacks.math.columbia.edu/tag/0B3Z)
-/

@[expose] public noncomputable section

open CategoryTheory TopologicalSpace

universe u

namespace AlgebraicGeometry

private lemma exists_finset_avoiding_submodules
    {k V T : Type*} [Field k] [Infinite k] [AddCommGroup V] [Module k V]
    [TopologicalSpace T] [NoetherianSpace T]
    (B : T → Submodule k V) (hB : ∀ x, B x ≠ ⊤)
    (hclosed : ∀ v, IsClosed {x | v ∈ B x})
    (n : ℕ) (Z : Set T) (hZ : IsClosed Z)
    (hdim : ∀ p : LTSeries (IrreducibleCloseds T),
      (p.last : Set T) ⊆ Z → p.length < n) :
    ∃ S : Finset V, S.card ≤ n ∧ ∀ x ∈ Z, ∃ v ∈ S, v ∉ B x := by
  classical
  induction n generalizing Z with
  | zero =>
      refine ⟨∅, by simp, fun x hx ↦ ?_⟩
      let C : IrreducibleCloseds T :=
        ⟨closure {x}, isIrreducible_singleton.closure, isClosed_closure⟩
      have h := hdim (RelSeries.singleton _ C)
        (show (C : Set T) ⊆ Z from closure_minimal (Set.singleton_subset_iff.mpr hx) hZ)
      simp at h
  | succ n ih =>
      obtain ⟨C, hCfin, hCc, hCi, hCZ⟩ :=
        NoetherianSpace.exists_finite_set_isClosed_irreducible hZ
      let : Finite C := hCfin.to_subtype
      let x (c : C) : T := (hCi c.1 c.2).nonempty.choose
      have hx (c : C) : x c ∈ c.1 := (hCi c.1 c.2).nonempty.choose_spec
      obtain ⟨v, hv⟩ := Submodule.exists_forall_notMem_of_forall_ne_top
        (fun c : C ↦ B (x c)) (fun c ↦ hB (x c))
      obtain ⟨S, hSn, hS⟩ := ih (Z ∩ {x | v ∈ B x}) (hZ.inter (hclosed v)) (by
        intro p hp
        obtain ⟨c, hc, hpc⟩ := isIrreducible_iff_sUnion_isClosed.mp
          p.last.isIrreducible hCfin.toFinset (by simpa using hCc)
          (by simpa only [Set.Finite.coe_toFinset, ← hCZ] using hp.trans Set.inter_subset_left)
        have hc' : c ∈ C := by simpa using hc
        let D : IrreducibleCloseds T := ⟨c, hCi c hc', hCc c hc'⟩
        have hlt : p.last < D := by
          refine lt_of_le_of_ne hpc fun heq ↦ ?_
          have hx' : x ⟨c, hc'⟩ ∈ (p.last : Set T) := by
            rw [heq]
            exact hx ⟨c, hc'⟩
          exact hv ⟨c, hc'⟩ (hp hx').2
        simpa using hdim (p.snoc D hlt) (by
          simp only [RelSeries.last_snoc]
          rw [hCZ]
          exact Set.subset_sUnion_of_mem hc'))
      refine ⟨insert v S, (Finset.card_insert_le v S).trans (Nat.add_le_add_right hSn 1),
        fun y hy => ?_⟩
      by_cases hyv : v ∈ B y
      · obtain ⟨w, hw, hwy⟩ := hS y ⟨hy, hyv⟩
        exact ⟨w, Finset.mem_insert_of_mem hw, hwy⟩
      · exact ⟨v, Finset.mem_insert_self _ _, hyv⟩

/- The binders below are those of `topologicalKrullDim_closure_singleton_eq_trdeg`, but the two
conclusions are independent: that lemma evaluates `topologicalKrullDim (closure {x})` as the
`toENat` of the transcendence degree, which does not record that the degree is finite, whereas
this one bounds the degree by `ℵ₀` and says nothing about the dimension. -/
private lemma trdeg_residueField_lt_aleph0
    (k : Type u) [Field k] (X : Scheme.{u}) (f : X ⟶ Spec (.of k))
    [LocallyOfFiniteType f] (x : X) :
    letI : Algebra k (X.residueField x) :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.Γevaluation x).hom.toAlgebra
    Algebra.trdeg k (X.residueField x) < Cardinal.aleph0 := by
  let : Algebra k (X.residueField x) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.Γevaluation x).hom.toAlgebra
  let p : PrimeSpectrum k := f x
  have : p.asIdeal.IsPrime := p.isPrime
  have hbase : (((Scheme.ΓSpecIso (.of k)).inv ≫
      (Spec (.of k)).Γevaluation (f x)).hom).EssFiniteType := by
    show (((Scheme.ΓSpecIso (.of k)).inv ≫
      (Spec (.of k)).presheaf.germ ⊤ (f x) trivial ≫
      (Spec (.of k)).residue (f x)).hom).EssFiniteType
    rw [← Scheme.Spec.algebraMap_residueFieldIso_inv]
    exact (show (algebraMap k p.asIdeal.ResidueField).EssFiniteType from
        RingHom.essFiniteType_algebraMap.mpr inferInstance).comp
      (RingHom.FiniteType.essFiniteType
        (RingHom.FiniteType.of_surjective _
          (Scheme.Spec.residueFieldIso (.of k) (f x)).symm.commRingCatIsoToRingEquiv.surjective))
  let : Algebra.EssFiniteType k (X.residueField x) := by
    rw [← RingHom.essFiniteType_algebraMap]
    show (((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.Γevaluation x).hom).EssFiniteType
    rw [← Scheme.Γevaluation_naturality]
    exact hbase.comp (RingHom.EssFiniteType.residueFieldMap
      (LocallyOfFiniteType.stalkMap f x))
  exact trdeg_lt_aleph0 k (X.residueField x)

private lemma topologicalKrullDim_ne_top_of_finiteType
    (k : Type u) [Field k] (X : Scheme.{u}) (f : X ⟶ Spec (.of k))
    [LocallyOfFiniteType f] [QuasiCompact f] : topologicalKrullDim X ≠ ⊤ := by
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  have : IsNoetherian X := { __ := LocallyOfFiniteType.isLocallyNoetherian f }
  have : Finite (genericPoints X) :=
    (genericPoints.finite (NoetherianSpace.finite_irreducibleComponents (α := X))).to_subtype
  rw [topologicalKrullDim_eq_iSup_trdeg_residueField k X f]
  exact iSup_ne_top fun x ↦ ne_of_lt <| WithBot.coe_lt_coe.mpr (Cardinal.toENat_lt_top.mpr
    (trdeg_residueField_lt_aleph0 k X f x.1))

private lemma span_singleton_eq_top_of_notMem_maximalIdeal_smul
    {R M : Type*} [CommRing R] [IsLocalRing R] [AddCommGroup M] [Module R M]
    (e : M ≃ₗ[R] R) {m : M}
    (hm : m ∉ IsLocalRing.maximalIdeal R • (⊤ : Submodule R M)) :
    Submodule.span R {m} = ⊤ := by
  have hu : IsUnit (e m) := IsLocalRing.notMem_maximalIdeal.mp (by
    intro h
    apply hm
    have hmem := Submodule.smul_mem_smul h
      (Submodule.mem_top : e.symm 1 ∈ (⊤ : Submodule R M))
    convert hmem using 1
    apply e.injective
    simp)
  obtain ⟨a, ha⟩ := hu
  refine (Submodule.span_singleton_eq_top_iff R m).mpr fun y ↦ ⟨e y * ↑a⁻¹, e.injective ?_⟩
  simp [← ha, mul_assoc]

private lemma nat_le_dimension_toNat {n : ℕ} {d : WithBot ℕ∞}
    (h : (n : WithBot ℕ∞) ≤ d) (hd : d ≠ ⊤) :
    n ≤ (d.unbotD 0).toNat := by
  cases d using WithBot.recBotCoe with
  | bot => simp at h
  | coe d =>
      have hd' : d ≠ ⊤ := by simpa using hd
      lift d to ℕ using hd'
      simpa using h

/-- `Stacks.SheafOfModules.sectionsOfTop_eval_top` at the spelling a scheme gives its structure
sheaf, where it is needed as a rewriting rule. -/
private theorem sectionsOfTopEvalTop (X : Scheme.{u}) (L : X.Modules) (t : Γ(L, ⊤)) :
    (Stacks.SheafOfModules.sectionsOfTop L t).eval (Opposite.op ⊤) = t :=
  Stacks.SheafOfModules.sectionsOfTop_eval_top L t

/-- The locus where a section of an invertible module vanishes in the residue fibre. -/
private noncomputable def vanishingLocus (X : Scheme.{u}) (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (s : L.sections) : Set X :=
  (Stacks.NonvanishingTrivialize.nonvanishingLocus X.toRingedSpace L s)ᶜ

private theorem isClosed_vanishingLocus (X : Scheme.{u}) (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (s : L.sections) : IsClosed (vanishingLocus X L s) :=
  (Stacks.NonvanishingTrivialize.isOpen_nonvanishingLocus X.toRingedSpace L s).isClosed_compl

private noncomputable def stalkScalarMap (k : Type u) [Field k] (X : Scheme.{u})
    (A : Algebra k Γ(X, ⊤)) (x : X) :
    k →+*
      (TopCat.Presheaf.stalk (C := CommRingCat.{u}) X.toRingedSpace.presheaf x : CommRingCat) := by
  let := A
  exact ((TopCat.Presheaf.Γgerm X.toRingedSpace.presheaf x).hom).comp
    (algebraMap k Γ(X, ⊤))

private theorem globalSection_germ_smul
    (k : Type u) [Field k] (X : Scheme.{u})
    (A : Algebra k Γ(X, ⊤)) (L : X.Modules) (x : X)
    (r : k) (t : Γ(L, ⊤)) :
    letI : Module k Γ(L, ⊤) := Module.compHom _ (algebraMap k Γ(X, ⊤))
    letI : Module
        (TopCat.Presheaf.stalk (C := CommRingCat.{u}) X.toRingedSpace.presheaf x : CommRingCat)
        (TopCat.Presheaf.stalk (C := Ab.{u}) L.val.presheaf x) :=
      PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
        (R := X.toRingedSpace.presheaf) L.val x
    letI : Module k (TopCat.Presheaf.stalk (C := Ab.{u}) L.val.presheaf x) :=
      Module.compHom _ (stalkScalarMap k X A x)
    (TopCat.Presheaf.Γgerm (C := Ab.{u}) L.val.presheaf x).hom
      ((algebraMap k Γ(X, ⊤) r) • t) =
      (stalkScalarMap k X A x r) •
        (TopCat.Presheaf.Γgerm (C := Ab.{u}) L.val.presheaf x).hom t := by
  let := A
  let : Module
      (TopCat.Presheaf.stalk (C := CommRingCat.{u}) X.toRingedSpace.presheaf x : CommRingCat)
      (TopCat.Presheaf.stalk (C := Ab.{u}) L.val.presheaf x) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.toRingedSpace.presheaf) L.val x
  show (TopCat.Presheaf.germ (C := Ab.{u}) L.val.presheaf ⊤ x (Set.mem_univ x)).hom
      ((algebraMap k Γ(X, ⊤) r) • t) =
    (TopCat.Presheaf.germ X.toRingedSpace.presheaf ⊤ x (Set.mem_univ x)).hom
        (algebraMap k Γ(X, ⊤) r) •
      (TopCat.Presheaf.germ (C := Ab.{u}) L.val.presheaf ⊤ x (Set.mem_univ x)).hom t
  exact PresheafOfModules.germ_smul (M := L.val) x ⊤ (Set.mem_univ x)
    (algebraMap k Γ(X, ⊤) r) t

private noncomputable def vanishingVectors
    (k : Type u) [Field k] (X : Scheme.{u})
    (A : Algebra k Γ(X, ⊤)) (L : X.Modules) [Module k Γ(L, ⊤)]
    (V : Type u) [AddCommGroup V] [Module k V]
    (s : V →ₗ[k] Γ(L, ⊤))
    (hsmul : ∀ (a : k) (t : Γ(L, ⊤)),
      a • t = (algebraMap k Γ(X, ⊤) a) • t) (x : X) : Submodule k V := by
  let := A
  let : Module
      (TopCat.Presheaf.stalk (C := CommRingCat.{u}) X.toRingedSpace.presheaf x : CommRingCat)
      (TopCat.Presheaf.stalk (C := Ab.{u}) L.val.presheaf x) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.toRingedSpace.presheaf) L.val x
  let : Module k (TopCat.Presheaf.stalk (C := Ab.{u}) L.val.presheaf x) :=
    Module.compHom _ (stalkScalarMap k X A x)
  let R := (TopCat.Presheaf.stalk (C := CommRingCat.{u}) X.toRingedSpace.presheaf x : Type u)
  let M : Submodule R (TopCat.Presheaf.stalk (C := Ab.{u}) L.val.presheaf x) :=
    IsLocalRing.maximalIdeal R • ⊤
  let g := (TopCat.Presheaf.Γgerm (C := Ab.{u}) L.val.presheaf x).hom
  exact {
    carrier := {v | g (s v) ∈ M}
    zero_mem' := by
      change g (s 0) ∈ M
      rw [s.map_zero]
      exact (map_zero g).symm ▸ M.zero_mem
    add_mem' := fun {v w} hv hw ↦ by
      change g (s (v + w)) ∈ M
      rw [s.map_add]
      exact (map_add g (s v) (s w)).symm ▸ M.add_mem hv hw
    smul_mem' := fun a v hv ↦ by
      change g (s (a • v)) ∈ M
      rw [s.map_smul, hsmul a (s v)]
      exact (globalSection_germ_smul k X A L x a (s v)).symm ▸
        M.smul_mem (stalkScalarMap k X A x a) hv }

/-- The stalk of an invertible module at a point is free of rank one over the stalk of the
structure sheaf: a local trivialization of the module identifies it with the free module on a
one-element index set over the open it trivializes on, and taking stalks there. -/
private lemma nonempty_stalk_linearEquiv_of_invertible
    (X : Scheme.{u}) (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L] (x : X) :
    letI : Module (X.presheaf.stalk x) (L.presheaf.stalk x) :=
      PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
        (R := X.presheaf) L.val x
    Nonempty (L.presheaf.stalk x ≃ₗ[X.presheaf.stalk x] X.presheaf.stalk x) := by
  classical
  let : Module (X.presheaf.stalk x) (L.presheaf.stalk x) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.presheaf) L.val x
  let hfree : SheafOfModules.IsFiniteLocallyFreeOfRank (R := X.ringCatSheaf) L 1 :=
    (Stacks.ModuleDescent.isInvertible_iff_isFiniteLocallyFreeOfRank_one X L).mp inferInstance
  obtain ⟨q, hq, hr⟩ := hfree.exists_isFiniteLocallyFreeOfRankData
  have hcover := (Opens.coversTop_iff X q.X).mp q.coversTop
  obtain ⟨i, hi⟩ := hcover.exists_mem x
  let R := LocallyFreeRank.toRingSheaf X.toTopCat X.sheaf
  let U := q.X i
  let E := U.sheafOfModulesEquivOver R
  have : IsIso (q.generators i).π := hq.isIso i
  let e : SheafOfModules.free (q.generators i).I ≅ L.over U := asIso (q.generators i).π
  let eFree : SheafOfModules.free (q.generators i).I ≅ E.functor.obj
      (SheafOfModules.free (q.generators i).I) :=
    SheafOfModules.mapFreeIso E.functor (q.generators i).I
      (U.sheafOfModulesEquivOverUnit R)
  let t : LocallyFreeRank.Trivialization X.toTopCat R L U := ⟨(q.generators i).I, by
    exact (eFree ≪≫ E.functor.mapIso e ≪≫
      LocallyFreeRank.restrictModIsoOver X.toTopCat U R L).symm⟩
  obtain ⟨e⟩ := LocallyFreeRank.Trivialization.stalk_linearEquiv_finsupp
    X.toTopCat X.sheaf L x hi t
  change L.presheaf.stalk x ≃ₗ[X.presheaf.stalk x]
    (t.ι →₀ X.presheaf.stalk x) at e
  let : Unique t.ι := Equiv.unique (hr i).some
  exact ⟨e.trans (Finsupp.uniqueLinearEquiv
    (X.presheaf.stalk x) (X.presheaf.stalk x) (default : t.ι))⟩

private noncomputable def stalkRingEquiv (X : Scheme.{u}) (x : X) :
    (TopCat.Presheaf.stalk (structureSheaf X.sheaf).obj x : RingCat) ≃+*
      (X.presheaf.stalk x : CommRingCat) :=
  (preservesColimitIso (forget₂ CommRingCat RingCat)
    ((OpenNhds.inclusion x).op ⋙ X.sheaf.obj)).symm.ringCatIsoToRingEquiv

private lemma stalkRingEquiv_germ (X : Scheme.{u}) (x : X)
    (U : X.Opens) (hx : x ∈ U) (r : Γ(X, U)) :
    stalkRingEquiv X x ((TopCat.Presheaf.germ (structureSheaf X.sheaf).obj U x hx).hom r) =
      (X.presheaf.germ U x hx).hom r :=
  congrArg (fun g ↦ (ConcreteCategory.hom g) r) (ι_preservesColimitIso_inv
    (forget₂ CommRingCat RingCat) ((OpenNhds.inclusion x).op ⋙ X.sheaf.obj) (Opposite.op ⟨U, hx⟩))

private lemma stalk_smul_eq (X : Scheme.{u}) (L : X.Modules) (x : X)
    (r : TopCat.Presheaf.stalk (C := RingCat.{u}) (structureSheaf X.sheaf).obj x)
    (m : TopCat.Presheaf.stalk (C := Ab.{u}) L.val.presheaf x) :
    letI : Module
        (TopCat.Presheaf.stalk (C := RingCat.{u}) (structureSheaf X.sheaf).obj x)
        (TopCat.Presheaf.stalk (C := Ab.{u}) L.val.presheaf x) :=
      PresheafOfModules.instModuleCarrierStalkRingCatCarrierAbPresheafOpensCarrier L.val x
    letI : Module (X.presheaf.stalk x) (TopCat.Presheaf.stalk (C := Ab.{u}) L.val.presheaf x) :=
      PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier L.val x
    r • m = stalkRingEquiv X x r • m := by
  let : Module
      (TopCat.Presheaf.stalk (C := RingCat.{u}) (structureSheaf X.sheaf).obj x)
      (TopCat.Presheaf.stalk (C := Ab.{u}) L.val.presheaf x) :=
    PresheafOfModules.instModuleCarrierStalkRingCatCarrierAbPresheafOpensCarrier L.val x
  let : Module (X.presheaf.stalk x) (TopCat.Presheaf.stalk (C := Ab.{u}) L.val.presheaf x) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier L.val x
  obtain ⟨U, hxU, m₀, rfl⟩ := TopCat.Presheaf.exists_germ_eq L.val.presheaf m
  obtain ⟨V, hxV, r₀, rfl⟩ := TopCat.Presheaf.exists_germ_eq (structureSheaf X.sheaf).obj r
  let W : X.Opens := U ⊓ V
  have hxW : x ∈ W := ⟨hxU, hxV⟩
  have hr : (TopCat.Presheaf.germ (structureSheaf X.sheaf).obj V x hxV).hom r₀ =
      (TopCat.Presheaf.germ (structureSheaf X.sheaf).obj W x hxW).hom
        ((structureSheaf X.sheaf).obj.map (homOfLE inf_le_right).op r₀) := by
    rw [TopCat.Presheaf.germ_res_apply]
  have hm : (TopCat.Presheaf.germ L.val.presheaf U x hxU).hom m₀ =
      (TopCat.Presheaf.germ L.val.presheaf W x hxW).hom
        (L.val.presheaf.map (homOfLE inf_le_left).op m₀) := by
    rw [TopCat.Presheaf.germ_res_apply]
  rw [hr, hm]
  have hcompat : stalkRingEquiv X x
      ((TopCat.Presheaf.germ (structureSheaf X.sheaf).obj W x hxW).hom
        ((structureSheaf X.sheaf).obj.map (homOfLE inf_le_right).op r₀)) =
      (X.presheaf.germ W x hxW).hom
        ((structureSheaf X.sheaf).obj.map (homOfLE inf_le_right).op r₀) :=
    stalkRingEquiv_germ X x W hxW _
  rw [hcompat]
  exact (PresheafOfModules.germ_ringCat_smul (M := L.val) x W hxW
    ((structureSheaf X.sheaf).obj.map (homOfLE inf_le_right).op r₀)
    (L.val.presheaf.map (homOfLE inf_le_left).op m₀)).symm.trans
      (PresheafOfModules.germ_smul (M := L.val) x W hxW
        ((structureSheaf X.sheaf).obj.map (homOfLE inf_le_right).op r₀)
        (L.val.presheaf.map (homOfLE inf_le_left).op m₀))

private lemma span_eq_top_of_smul_compatible
    {R S M : Type*} [Semiring R] [Semiring S] [AddCommMonoid M]
    [Module R M] [Module S M] (e : R → S)
    (he : ∀ (r : R) (m : M), r • m = e r • m) (s : Set M)
    (h : Submodule.span R s = ⊤) : Submodule.span S s = ⊤ := by
  have hmem : ∀ m ∈ Submodule.span R s, m ∈ Submodule.span S s := by
    intro m hm
    induction hm using Submodule.span_induction with
    | mem m hm => exact Submodule.subset_span hm
    | zero => exact Submodule.zero_mem _
    | add x y hx hy ihx ihy => exact Submodule.add_mem _ ihx ihy
    | smul r m hm ih =>
      rw [he]
      exact Submodule.smul_mem _ _ ih
  exact eq_top_iff.mpr fun m _ ↦ hmem m (h ▸ Submodule.mem_top)

private lemma span_eq_top_iff_of_equiv_smul
    {R S M : Type*} [Semiring R] [Semiring S] [AddCommMonoid M]
    [Module R M] [Module S M] (e : R ≃+* S)
    (he : ∀ (r : R) (m : M), r • m = e r • m) (s : Set M) :
    Submodule.span R s = ⊤ ↔ Submodule.span S s = ⊤ :=
  ⟨span_eq_top_of_smul_compatible e he s,
    span_eq_top_of_smul_compatible e.symm
      (fun r m ↦ by simpa using (he (e.symm r) m).symm) s⟩

private theorem vanishingVectors_ne_top
    (k : Type u) [Field k] (X : Scheme.{u})
    (A : Algebra k Γ(X, ⊤)) (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    [Module k Γ(L, ⊤)]
    (V : Type u) [AddCommGroup V] [Module k V]
    (s : V →ₗ[k] Γ(L, ⊤))
    (hsmul : ∀ (a : k) (t : Γ(L, ⊤)),
      a • t = (algebraMap k Γ(X, ⊤) a) • t)
    (x : X)
    (hspan : Submodule.span (R :=
      (TopCat.Presheaf.stalk (structureSheaf X.sheaf).obj x : RingCat))
      (Set.range fun v : V ↦ (TopCat.Presheaf.Γgerm L.val.presheaf x).hom
        ((Stacks.SheafOfModules.sectionsOfTop L (s v)).eval (Opposite.op ⊤))) = ⊤) :
    vanishingVectors k X A L V s hsmul x ≠ ⊤ := by
  classical
  let := A
  let R : Type u := X.presheaf.stalk x
  let M : Type u := L.presheaf.stalk x
  let : Module R (L.presheaf.stalk x) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.presheaf) L.val x
  let : Module (X.presheaf.stalk x)
      (TopCat.Presheaf.stalk (C := Ab.{u}) L.val.presheaf x) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.presheaf) L.val x
  obtain ⟨e⟩ := nonempty_stalk_linearEquiv_of_invertible X L x
  let : Nontrivial M := e.toEquiv.nontrivial
  let : Module.Finite R M := Module.Finite.of_surjective
    e.symm.toLinearMap e.symm.surjective
  have hann : Module.annihilator R M ≠ ⊤ := fun h ↦
    (not_subsingleton_iff_nontrivial.mpr (inferInstance : Nontrivial M))
      (Module.annihilator_eq_top_iff.mp h)
  have hmax : IsLocalRing.maximalIdeal R ≤ (Module.annihilator R M).jacobson := by
    rw [← IsLocalRing.jacobson_eq_maximalIdeal (Module.annihilator R M) hann]
  have hproper : (IsLocalRing.maximalIdeal R • (⊤ : Submodule R M)) ≠ ⊤ :=
    (Submodule.top_ne_ideal_smul_of_le_jacobson_annihilator hmax).symm
  intro htop
  have hmem (v : V) :
      (TopCat.Presheaf.Γgerm (C := Ab.{u}) L.val.presheaf x).hom (s v) ∈
        IsLocalRing.maximalIdeal R • (⊤ : Submodule R M) := by
    have : v ∈ (vanishingVectors k X A L V s hsmul x : Submodule k V) := by simp [htop]
    change (TopCat.Presheaf.Γgerm (C := Ab.{u}) L.val.presheaf x).hom (s v) ∈
      IsLocalRing.maximalIdeal R • (⊤ : Submodule R M) at this
    simpa [R, M] using this
  have hspan' : Submodule.span (R := (X.presheaf.stalk x : CommRingCat))
      (Set.range fun v : V ↦ (TopCat.Presheaf.Γgerm
        (C := Ab.{u}) L.val.presheaf x).hom (s v)) = ⊤ :=
    (span_eq_top_iff_of_equiv_smul (stalkRingEquiv X x)
      (stalk_smul_eq X L x) _).mp (by simpa only [sectionsOfTopEvalTop] using hspan)
  have hle : Submodule.span R
      (Set.range fun v : V ↦ (TopCat.Presheaf.Γgerm L.val.presheaf x).hom (s v)) ≤
      IsLocalRing.maximalIdeal R • (⊤ : Submodule R M) :=
    Submodule.span_le.mpr (Set.range_subset_iff.mpr hmem)
  exact hproper (top_le_iff.mp (hspan' ▸ hle))

private theorem isClosed_setOf_mem_vanishingVectors
    (k : Type u) [Field k] (X : Scheme.{u})
    (A : Algebra k Γ(X, ⊤)) (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    [Module k Γ(L, ⊤)]
    (V : Type u) [AddCommGroup V] [Module k V]
    (s : V →ₗ[k] Γ(L, ⊤))
    (hsmul : ∀ (a : k) (t : Γ(L, ⊤)),
      a • t = (algebraMap k Γ(X, ⊤) a) • t)
    (v : V) : IsClosed {x | v ∈ vanishingVectors k X A L V s hsmul x} := by
  convert isClosed_vanishingLocus X L (Stacks.SheafOfModules.sectionsOfTop L (s v)) using 1
  ext x
  simp only [vanishingLocus, Set.mem_compl_iff, Set.mem_ofPred_eq, not_not,
    Stacks.NonvanishingTrivialize.nonvanishingLocus, sectionsOfTopEvalTop]
  rfl

/-- An invertible sheaf generated by a linear family of sections is generated by a
subspace of dimension at most one more than the dimension of the scheme. -/
@[stacks 0B3Z]
theorem exists_submodule_generatingSections_finrank_le_dimension_add_one
    (k : Type u) [Field k] [Infinite k] (X : Scheme.{u})
    (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f] [QuasiCompact f]
    (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L]
    (V : Type u) [AddCommGroup V] [Module k V] :
    letI : Algebra k Γ(X, ⊤) :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom.toAlgebra
    letI : Module k Γ(L, ⊤) :=
      Module.compHom Γ(L, ⊤) (algebraMap k Γ(X, ⊤))
    ∀ (s : V →ₗ[k] Γ(L, ⊤)),
      Epi (L.freeHomEquiv.symm (fun v : V ↦ Stacks.SheafOfModules.sectionsOfTop L (s v))) →
      ∃ W : Submodule k V,
        FiniteDimensional k W ∧
        Module.finrank k W ≤ ((topologicalKrullDim X).unbotD 0).toNat + 1 ∧
        Epi (L.freeHomEquiv.symm (fun w : W ↦ Stacks.SheafOfModules.sectionsOfTop L (s w.1))) := by
  classical
  intro s hs
  let : Algebra k Γ(X, ⊤) := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom.toAlgebra
  let : Module k Γ(L, ⊤) := Module.compHom _ (algebraMap k Γ(X, ⊤))
  have hgen : ∀ x : X,
      Submodule.span (R := (TopCat.Presheaf.stalk (structureSheaf X.sheaf).obj x : RingCat))
        (Set.range fun v : V ↦
          (TopCat.Presheaf.Γgerm L.val.presheaf x).hom
            ((Stacks.SheafOfModules.sectionsOfTop L (s v)).eval (Opposite.op ⊤))) = ⊤ :=
    (generates_iff_stalkwise_generates (structureSheaf X.sheaf) L
      (fun v : V ↦ Stacks.SheafOfModules.sectionsOfTop L (s v))).mp hs
  have hsmul : ∀ (a : k) (t : Γ(L, ⊤)), a • t = (algebraMap k Γ(X, ⊤) a) • t := fun _ _ ↦ rfl
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace f
  have : IsNoetherian X := { __ := LocallyOfFiniteType.isLocallyNoetherian f }
  obtain ⟨S, hSn, hS⟩ := exists_finset_avoiding_submodules
    (vanishingVectors k X (inferInstance : Algebra k Γ(X, ⊤)) L V s hsmul)
    (fun x ↦ vanishingVectors_ne_top k X _ L V s hsmul x (hgen x))
    (isClosed_setOf_mem_vanishingVectors k X _ L V s hsmul)
    (((topologicalKrullDim X).unbotD 0).toNat + 1) Set.univ isClosed_univ fun p _ ↦
      Nat.lt_succ_of_le (nat_le_dimension_toNat (Order.LTSeries.length_le_krullDim p)
        (topologicalKrullDim_ne_top_of_finiteType k X f))
  let W : Submodule k V := Submodule.span k (S : Set V)
  refine ⟨W, inferInstance, (finrank_span_finset_le_card S).trans hSn, ?_⟩
  refine (generates_iff_stalkwise_generates (structureSheaf X.sheaf) L
    (fun w : W ↦ Stacks.SheafOfModules.sectionsOfTop L (s w.1))).mpr fun x => ?_
  obtain ⟨v, hv, hnv⟩ := hS x (Set.mem_univ x)
  let R : Type u := X.presheaf.stalk x
  let M : Type u := L.presheaf.stalk x
  let : Module R (L.presheaf.stalk x) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.presheaf) L.val x
  let : Module (X.presheaf.stalk x)
      (TopCat.Presheaf.stalk (C := Ab.{u}) L.val.presheaf x) :=
    PresheafOfModules.instModuleCarrierStalkCommRingCatCarrierAbPresheafOpensCarrier
      (R := X.presheaf) L.val x
  obtain ⟨e⟩ := nonempty_stalk_linearEquiv_of_invertible X L x
  have hnv' : (TopCat.Presheaf.Γgerm L.val.presheaf x).hom (s v) ∉
      IsLocalRing.maximalIdeal R • (⊤ : Submodule R M) := hnv
  have htop : Submodule.span (X.presheaf.stalk x : CommRingCat)
      {(TopCat.Presheaf.Γgerm L.val.presheaf x).hom (s v)} = ⊤ :=
    span_singleton_eq_top_of_notMem_maximalIdeal_smul e hnv'
  have hspan : Submodule.span R
      (Set.range fun w : W ↦ (TopCat.Presheaf.Γgerm L.val.presheaf x).hom (s w.1)) = ⊤ :=
    top_le_iff.mp <| htop.symm.trans_le <|
      Submodule.span_mono (Set.singleton_subset_iff.mpr ⟨⟨v, Submodule.subset_span hv⟩, rfl⟩)
  simpa only [sectionsOfTopEvalTop] using
    (span_eq_top_iff_of_equiv_smul (stalkRingEquiv X x) (stalk_smul_eq X L x) _).mpr hspan

end AlgebraicGeometry
