/-!
# Completed local rings after extending the ground field

Let `X` be locally of finite type over a field `k` and let `Y = X ×_k K` for a field extension
`K / k`. At a point `y` of `Y` lying over `x` in `X`, equality of the local dimensions together
with separability of `κ(x) / k` makes a power-series presentation of the completed local ring
at `x` base-change to one of the completed local ring at `y`.

## Main results

* `AlgebraicGeometry.exists_baseChanged_powerSeries_quotient_algEquiv_adicCompletion`: the
  base-changed power-series presentation of the completed local ring upstairs.

## Implementation notes

The ideal generated upstairs by the same power series is written as the image of the original
ideal under the coefficient map on multivariate power series. That an isomorphism is one "as in
the presentation of a complete local ring" is recorded by requiring that it be compatible with
the evaluation of constants, i.e. that composing with evaluation at the origin recovers the
constant-coefficient map. The `K`-algebra structures record compatibility with the structure
morphism `Y ⟶ Spec K`.

The proof is the standard flatness argument: the stalk upstairs is flat over the stalk
downstairs, the maximal ideal downstairs generates the maximal ideal upstairs — that is where
reducedness of `κ(x) ⊗_k K` enters — and the induced map of completions is therefore both
surjective, by a power-series lifting of generators, and injective, by the local criterion.

## References

* [Stacks Project, Tag 0C54](https://stacks.math.columbia.edu/tag/0C54)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits IsLocalRing

universe u

namespace AlgebraicGeometry

/-- The injectivity step of Stacks 0C54: a surjection from a Noetherian local ring into
an algebra flat over the base is injective once both rings have the same residue field
and the base maximal ideal generates both maximal ideals. -/
private lemma injective_of_flat_of_maximalIdeal_eq
    {R S B : Type*} [CommRing R] [CommRing S] [CommRing B]
    [IsLocalRing R] [IsLocalRing S] [IsLocalRing B]
    [IsNoetherianRing S] [Algebra R S] [Algebra R B]
    [IsLocalHom (algebraMap R S)] [Module.Flat R B]
    (h : S →ₐ[R] B) [IsLocalHom h.toRingHom]
    (hmS : (maximalIdeal R).map (algebraMap R S) = maximalIdeal S)
    (hmB : (maximalIdeal R).map (algebraMap R B) = maximalIdeal B) :
    Function.Injective h := by
  let u : S →ₗ[R] B := h.toLinearMap
  have hu : Function.Injective
      (Submodule.mapQ (maximalIdeal R • (⊤ : Submodule R S))
        (maximalIdeal R • (⊤ : Submodule R B)) u
        (Submodule.smul_top_le_comap_smul_top (maximalIdeal R) u)) := by
    apply (Stacks.Flatness.FibreNonZeroDivisor.mapQ_injective_iff _).2
    intro s hs
    have hsB : h s ∈ maximalIdeal B := by
      change h s ∈ maximalIdeal R • (⊤ : Submodule R B) at hs
      rw [Ideal.smul_top_eq_map] at hs
      exact hmB ▸ hs
    have hsS : s ∈ maximalIdeal S := by
      rw [← IsLocalRing.maximalIdeal_comap h.toRingHom]
      exact hsB
    show s ∈ maximalIdeal R • (⊤ : Submodule R S)
    rw [Ideal.smul_top_eq_map]
    exact hmS ▸ hsS
  exact (open Module.Flat in
    injective_and_flat_quotient_range_of_injective_mapQ_maximalIdeal_of_isNoetherianRing
      (S := S) u hu).1

/-- The maximal ideal in a finite-variable power series ring over a field is generated by
the variables. -/
private lemma maximalIdeal_mvPowerSeries_eq_span_X (F : Type*) [Field F] (n : ℕ) :
    maximalIdeal (MvPowerSeries (Fin n) F) =
      Ideal.span (Set.range (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n) F)) := by
  open Stacks.MvPowerSeries.RegularParameters in
  apply le_antisymm
  · intro a ha
    obtain ⟨g, _, hg⟩ := exists_sum_X_mul_of_constantCoeff_eq_zero a
      ((mem_maximalIdeal_iff_constantCoeff_eq_zero_field a).mp ha)
    rw [hg]
    exact Ideal.sum_mem _ fun i _ =>
      Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨i, rfl⟩)
  · exact Ideal.span_le.mpr (Set.range_subset_iff.mpr fun i =>
      (mem_maximalIdeal_iff_constantCoeff_eq_zero_field _).mpr (MvPowerSeries.constantCoeff_X i))

/-- Changing the coefficient field maps the maximal ideal of a finite-variable power
series ring onto the maximal ideal upstairs. -/
private lemma map_maximalIdeal_mvPowerSeries_eq {E F : Type*} [Field E] [Field F]
    (n : ℕ) (φ : E →+* F) :
    (maximalIdeal (MvPowerSeries (Fin n) E)).map (MvPowerSeries.map φ) =
      maximalIdeal (MvPowerSeries (Fin n) F) := by
  rw [maximalIdeal_mvPowerSeries_eq_span_X,
    maximalIdeal_mvPowerSeries_eq_span_X, Ideal.map_span, ← Set.range_comp]
  congr 2
  exact funext fun i => MvPowerSeries.map_X φ i

private lemma map_ideal_le_constantCoeff_ker {R S : Type*} [CommRing R] [CommRing S]
    (n : ℕ) (φ : R →+* S) (I : Ideal (MvPowerSeries (Fin n) R))
    (hI : I ≤ RingHom.ker (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) R →+* R)) :
    I.map (MvPowerSeries.map φ) ≤
      RingHom.ker (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) S →+* S) := by
  rw [Ideal.map_le_iff_le_comap]
  intro a ha
  show MvPowerSeries.constantCoeff (MvPowerSeries.map φ a) = 0
  rw [MvPowerSeries.constantCoeff_map]
  exact map_zero φ ▸ congrArg φ (hI ha)

/-- The coefficient extension of a quotient presentation carries the maximal ideal onto
the maximal ideal of the extended quotient. -/
private lemma quotientMap_map_maximalIdeal_eq {E F : Type*} [Field E] [Field F]
    (n : ℕ) (φ : E →+* F) (I : Ideal (MvPowerSeries (Fin n) E)) :
    let J := I.map (MvPowerSeries.map φ)
    ((maximalIdeal (MvPowerSeries (Fin n) E)).map (Ideal.Quotient.mk I)).map
        (Ideal.quotientMap J (MvPowerSeries.map φ) Ideal.le_comap_map) =
      (maximalIdeal (MvPowerSeries (Fin n) F)).map (Ideal.Quotient.mk J) := by
  let J := I.map (MvPowerSeries.map φ)
  dsimp only
  rw [Ideal.map_map, Ideal.quotientMap_comp_mk,
    ← Ideal.map_map, map_maximalIdeal_mvPowerSeries_eq]

/-- A quotient by equations with zero constant coefficient is local. -/
private theorem quotientPowerSeriesIsLocal {F : Type*} [Field F]
    (n : ℕ) (I : Ideal (MvPowerSeries (Fin n) F))
    (hI : I ≤ RingHom.ker
      (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) F →+* F)) :
    IsLocalRing (MvPowerSeries (Fin n) F ⧸ I) := by
  have hproper : I ≠ ⊤ := by
    intro htop
    have h1 : (1 : MvPowerSeries (Fin n) F) ∈ RingHom.ker
        (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) F →+* F) :=
      hI (by simp [htop])
    exact one_ne_zero ((RingHom.mem_ker).mp h1)
  let : Nontrivial (MvPowerSeries (Fin n) F ⧸ I) :=
    Ideal.Quotient.nontrivial_iff.mpr hproper
  exact IsLocalRing.of_surjective' (Ideal.Quotient.mk I)
    Ideal.Quotient.mk_surjective

/-- The maximal ideal of a power-series quotient is the image of the original maximal
ideal. -/
private lemma quotient_powerSeries_maximalIdeal_eq {F : Type*} [Field F]
    (n : ℕ) (I : Ideal (MvPowerSeries (Fin n) F))
    (hI : I ≤ RingHom.ker
      (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) F →+* F)) :
    let : IsLocalRing (MvPowerSeries (Fin n) F ⧸ I) :=
      quotientPowerSeriesIsLocal n I hI
    (maximalIdeal (MvPowerSeries (Fin n) F)).map (Ideal.Quotient.mk I) =
      maximalIdeal (MvPowerSeries (Fin n) F ⧸ I) := by
  let : IsLocalRing (MvPowerSeries (Fin n) F ⧸ I) :=
    quotientPowerSeriesIsLocal n I hI
  exact IsLocalRing.map_maximalIdeal_of_surjective (Ideal.Quotient.mk I)
    Ideal.Quotient.mk_surjective

/-- The coefficient-extension map between power-series quotients carries one maximal ideal
onto the other. -/
private lemma quotientMap_map_maximalIdeal_eq_quotients
    {E F : Type*} [Field E] [Field F] (n : ℕ) (φ : E →+* F)
    (I : Ideal (MvPowerSeries (Fin n) E))
    (hI : I ≤ RingHom.ker
      (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) E →+* E)) :
    let J := I.map (MvPowerSeries.map φ)
    let hJ := map_ideal_le_constantCoeff_ker n φ I hI
    let : IsLocalRing (MvPowerSeries (Fin n) E ⧸ I) :=
      quotientPowerSeriesIsLocal n I hI
    let : IsLocalRing (MvPowerSeries (Fin n) F ⧸ J) :=
      quotientPowerSeriesIsLocal n J hJ
    (maximalIdeal (MvPowerSeries (Fin n) E ⧸ I)).map
        (Ideal.quotientMap J (MvPowerSeries.map φ) Ideal.le_comap_map) =
      maximalIdeal (MvPowerSeries (Fin n) F ⧸ J) := by
  let J := I.map (MvPowerSeries.map φ)
  let hJ := map_ideal_le_constantCoeff_ker n φ I hI
  let : IsLocalRing (MvPowerSeries (Fin n) E ⧸ I) :=
    quotientPowerSeriesIsLocal n I hI
  let : IsLocalRing (MvPowerSeries (Fin n) F ⧸ J) :=
    quotientPowerSeriesIsLocal n J hJ
  dsimp only
  rw [← quotient_powerSeries_maximalIdeal_eq n I hI,
    ← quotient_powerSeries_maximalIdeal_eq n J hJ]
  exact quotientMap_map_maximalIdeal_eq n φ I

/-
`powerSeries_hom_ext` and `mvPowerSeries_hom_ext` lived here, repeating the two lemmas now
public at `StacksFrontier/RingTheory/MvPowerSeries/HomExt.lean:32` and `:58`, which this file
imports.
-/

/-- Evaluation after changing coefficients agrees with the original evaluation if the
coefficient maps and variable images agree. -/
private lemma mvPowerSeries_eval_map_eq {E F B : Type*}
    [CommRing E] [CommRing F] [CommRing B]
    (M : Ideal B) [IsHausdorff M B] (n : ℕ) (φ : E →+* F)
    (σ : F →+* B) (τ : E →+* B) (v : Fin n → B)
    (hσ : σ.comp φ = τ) (hv : ∀ i, v i ∈ M)
    (G : MvPowerSeries (Fin n) E →+* B)
    (hGC : ∀ c, G (MvPowerSeries.C c) = τ c)
    (hGX : ∀ i, G (MvPowerSeries.X i) = v i)
    (H : MvPowerSeries (Fin n) F →+* B)
    (hHC : ∀ c, H (MvPowerSeries.C c) = σ c)
    (hHX : ∀ i, H (MvPowerSeries.X i) = v i) :
    H.comp (MvPowerSeries.map φ) = G := by
  apply mvPowerSeries_hom_ext M n
  · intro c
    simpa only [RingHom.comp_apply, MvPowerSeries.map_C, hHC] using
      congrArg (fun f : E →+* B => f c) hσ |>.trans (hGC c).symm
  · intro i
    simp only [RingHom.comp_apply, MvPowerSeries.map_X, hHX, hGX]
  · intro i
    simpa only [RingHom.comp_apply, MvPowerSeries.map_X, hHX] using hv i

/-- The coefficient extension of an ideal of equations lies in the kernel of a compatible
evaluation map. -/
private lemma map_ideal_le_ker_of_eval_map_eq {A B C : Type*}
    [CommRing A] [CommRing B] [CommRing C]
    (f : A →+* B) (I : Ideal A) (G : A →+* C) (H : B →+* C)
    (hI : I ≤ RingHom.ker G) (hHG : H.comp f = G) :
    I.map f ≤ RingHom.ker H := by
  rw [Ideal.map_le_iff_le_comap]
  intro a ha
  show H (f a) = 0
  rw [← RingHom.comp_apply, hHG]
  exact hI ha

/-- The power series evaluation map is onto when its variables generate the ideal of
completeness and its coefficient map is onto modulo that ideal. -/
private lemma exists_surjective_eval₂Hom {C B : Type*} [CommRing C] [CommRing B]
    (J : Ideal B) [IsAdicComplete J B] {n : ℕ} (v : Fin n → B)
    (hv : Ideal.span (Set.range v) = J) (σ : C →+* B)
    (hσ : Function.Surjective ((Ideal.Quotient.mk J).comp σ)) :
    ∃ F : MvPowerSeries (Fin n) C →+* B,
      Function.Surjective F ∧
      (∀ i, F (MvPowerSeries.X i) = v i) ∧
      ∀ c, F (MvPowerSeries.C c) = σ c := by
  let _ : WithIdeal C := ⟨⊥⟩
  have : DiscreteTopology C := is_bot_adic_iff.1 rfl
  let _ : WithIdeal B := ⟨J⟩
  obtain ⟨_, _⟩ : CompleteSpace B ∧ T2Space B :=
    (IsAdic.isAdicComplete_iff (I := J) rfl).mp ‹IsAdicComplete J B›
  have hvJ : ∀ i, v i ∈ J := fun i => hv ▸ Ideal.subset_span ⟨i, rfl⟩
  have heval : MvPowerSeries.HasEval v :=
    { hpow := fun i => WithIdeal.isTopologicallyNilpotent_of_mem (hvJ i)
      tendsto_zero := by simp [Filter.cofinite_eq_bot] }
  let F : MvPowerSeries (Fin n) C →+* B :=
    MvPowerSeries.eval₂Hom (φ := σ) continuous_of_discreteTopology heval
  have hFcoe : ⇑F = MvPowerSeries.eval₂ σ v := MvPowerSeries.coe_eval₂Hom _ _
  have hFX : ∀ i, F (MvPowerSeries.X i) = v i := fun i => by
    rw [hFcoe, MvPowerSeries.eval₂_X]
  have hFC : ∀ c, F (MvPowerSeries.C c) = σ c := fun c => by
    rw [hFcoe, MvPowerSeries.eval₂_C]
  have hmapF : Ideal.map F
      (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin n) (R := C)))) = J := by
    rw [Ideal.map_span, ← hv, ← Set.range_comp]
    exact congrArg _ (congrArg Set.range (funext hFX))
  have : IsHausdorff (Ideal.map F
      (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin n) (R := C))))) B := by
    rw [hmapF]; infer_instance
  refine ⟨F, ?_, hFX, hFC⟩
  refine surjective_of_mk_map_comp_surjective
    (I := Ideal.span (Set.range (MvPowerSeries.X (σ := Fin n) (R := C)))) F fun b => ?_
  obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective b
  obtain ⟨c, hc⟩ := hσ (Ideal.Quotient.mk J r)
  refine ⟨MvPowerSeries.C c, ?_⟩
  rw [RingHom.comp_apply, hFC c, ← hr]
  exact Ideal.Quotient.eq.2 (by rw [hmapF]; exact Ideal.Quotient.eq.1 hc)

/-- A map into a local ring factors through localization at the kernel of its residue
map: every denominator has nonzero residue, hence is a unit. -/
private lemma lift_to_localization_at_residue_kernel
    {D B F : Type*} [CommRing D] [CommRing B] [IsLocalRing B] [Field F]
    (ψ : D →+* F) (ρ : D →+* B) (ε : B →+* F)
    (hε : RingHom.ker ε = maximalIdeal B) (h : ε.comp ρ = ψ) :
    let p := RingHom.ker ψ
    let : p.IsPrime := RingHom.ker_isPrime ψ
    ∃ ρloc : Localization.AtPrime p →+* B,
      ρloc.comp (algebraMap D (Localization.AtPrime p)) = ρ := by
  let p := RingHom.ker ψ
  let : p.IsPrime := RingHom.ker_isPrime ψ
  have hunit : ∀ s : p.primeCompl, IsUnit (ρ s) := by
    intro s
    have hnot : ρ s ∉ maximalIdeal B := fun hs => s.2 ((RingHom.mem_ker).mpr
      ((DFunLike.congr_fun h (s : D)).symm.trans
        ((RingHom.mem_ker).mp (hε ▸ hs : ρ s ∈ RingHom.ker ε))))
    simpa [IsLocalRing.mem_maximalIdeal, mem_nonunits_iff] using hnot
  exact ⟨IsLocalization.lift (S := Localization.AtPrime p) hunit,
    IsLocalization.lift_comp hunit⟩

/-- If a local ring is a localization of `A` and its residue map factors through `D`,
then the induced map from the localization of `D` at the residue kernel onto the residue
field is surjective. -/
private lemma surjective_localization_to_residue
    {A D S F : Type*} [CommRing A] [CommRing D] [CommRing S] [Field F]
    (θ : A →+* D) (φ : A →+* S) (ψ : D →+* F) (ε : S →+* F)
    (hε : Function.Surjective ε) (hcomm : ψ.comp θ = ε.comp φ)
    (hloc : let p := RingHom.ker (ψ.comp θ)
      letI : p.IsPrime := RingHom.ker_isPrime _
      letI : Algebra A S := φ.toAlgebra
      IsLocalization.AtPrime S p) :
    let p₀ := RingHom.ker ψ
    let : p₀.IsPrime := RingHom.ker_isPrime _
    let hunit : ∀ t : p₀.primeCompl, IsUnit (ψ t) := fun t => by
      have ht : ψ t ≠ 0 := fun hz => t.2 ((RingHom.mem_ker).mpr hz)
      exact isUnit_iff_ne_zero.mpr ht
    Function.Surjective
      (IsLocalization.lift (S := Localization.AtPrime p₀) hunit) := by
  let p₀ := RingHom.ker ψ
  let : p₀.IsPrime := RingHom.ker_isPrime ψ
  let p := RingHom.ker (ψ.comp θ)
  let : p.IsPrime := RingHom.ker_isPrime _
  let : Algebra A S := φ.toAlgebra
  have : IsLocalization.AtPrime S p := hloc
  let hunit : ∀ t : p₀.primeCompl, IsUnit (ψ t) := fun t =>
    isUnit_iff_ne_zero.mpr fun hz => t.2 ((RingHom.mem_ker).mpr hz)
  dsimp only
  intro b
  obtain ⟨s, rfl⟩ := hε b
  obtain ⟨a, t, ht⟩ := IsLocalization.exists_mk'_eq (M := p.primeCompl) s
  have ht₀ : θ (t : A) ∉ p₀ := fun hθt => t.2 ((Ideal.mem_comap).mpr hθt)
  let t₀ : p₀.primeCompl := ⟨θ t, ht₀⟩
  refine ⟨IsLocalization.mk' (Localization.AtPrime p₀) (θ a) t₀, ?_⟩
  apply (IsLocalization.lift_mk'_spec (S := Localization.AtPrime p₀)
    (g := ψ) hunit (θ a) (ε s) t₀).mpr
  have hspec := IsLocalization.mk'_spec S a t
  rw [ht] at hspec
  have hεspec := congrArg ε hspec
  have hθa := DFunLike.congr_fun hcomm a
  have hθt := DFunLike.congr_fun hcomm (t : A)
  rw [map_mul] at hεspec
  change ε s * ε (φ t) = ε (φ a) at hεspec
  change ψ (θ a) = ε (φ a) at hθa
  change ψ (θ t) = ε (φ t) at hθt
  show ψ (θ a) = ψ (θ t) * ε s
  rw [hθa, hθt]
  simpa only [mul_comm] using hεspec.symm

/-- If a local ring is a localization of a ring surjecting onto a residue tensor product,
and its maximal ideal comes from the kernel of that surjection, the localized tensor
product is its residue field. -/
private lemma localization_residue_ringEquiv_of_maximalIdeal
    {A D S F : Type*} [CommRing A] [CommRing D] [CommRing S]
    [IsLocalRing S] [Field F]
    (θ : A →+* D) (φ : A →+* S) (ψ : D →+* F) (ε : S →+* F)
    (m : Ideal A) (hθsurj : Function.Surjective θ)
    (hθm : m ≤ RingHom.ker θ)
    (hm : m.map φ = maximalIdeal S)
    (hεker : RingHom.ker ε = maximalIdeal S)
    (hεsurj : Function.Surjective ε)
    (hcomm : ψ.comp θ = ε.comp φ)
    (hloc : let p := RingHom.ker (ψ.comp θ)
      letI : p.IsPrime := RingHom.ker_isPrime _
      letI : Algebra A S := φ.toAlgebra
      IsLocalization.AtPrime S p) :
    let p₀ := RingHom.ker ψ
    let : p₀.IsPrime := RingHom.ker_isPrime _
    ∃ e : Localization.AtPrime p₀ ≃+* F,
      e.toRingHom.comp (algebraMap D (Localization.AtPrime p₀)) = ψ := by
  let p₀ := RingHom.ker ψ
  let : p₀.IsPrime := RingHom.ker_isPrime ψ
  let p := RingHom.ker (ψ.comp θ)
  let : p.IsPrime := RingHom.ker_isPrime _
  let : Algebra A S := φ.toAlgebra
  have : IsLocalization.AtPrime S p := hloc
  let hunit : ∀ t : p₀.primeCompl, IsUnit (ψ t) := fun t =>
    isUnit_iff_ne_zero.mpr fun hz => t.2 ((RingHom.mem_ker).mpr hz)
  let ψloc : Localization.AtPrime p₀ →+* F := IsLocalization.lift hunit
  have hzero (d : D) (hd : ψ d = 0) :
      algebraMap D (Localization.AtPrime p₀) d = 0 := by
    obtain ⟨a, rfl⟩ := hθsurj d
    have ha : φ a ∈ maximalIdeal S := by
      rw [← hεker, RingHom.mem_ker, ← RingHom.comp_apply, ← hcomm]
      exact hd
    have ham' : algebraMap A S a ∈ m.map (algebraMap A S) := (hm ▸ ha : φ a ∈ m.map φ)
    obtain ⟨t, ht, hta⟩ : ∃ t : A, t ∈ p.primeCompl ∧ t * a ∈ m :=
      (IsLocalization.algebraMap_mem_map_algebraMap_iff p.primeCompl S m a).mp ham'
    have ht₀ : θ t ∉ p₀ := by
      intro ht₀
      apply ht
      show (ψ.comp θ) t = 0
      exact (RingHom.mem_ker).mp ht₀
    refine (IsLocalization.map_eq_zero_iff p₀.primeCompl _ (θ a)).mpr ⟨⟨θ t, ht₀⟩, ?_⟩
    rw [← map_mul]
    exact (RingHom.mem_ker).mp (hθm hta)
  have hinj : Function.Injective ψloc := by
    refine (RingHom.injective_iff_ker_eq_bot ψloc).mpr
      ((RingHom.ker_eq_bot_iff_eq_zero ψloc).mpr fun z hz => ?_)
    obtain ⟨⟨d, s⟩, rfl⟩ := IsLocalization.mk'_surjective p₀.primeCompl z
    have hd : ψ d = 0 := by
      simpa using (IsLocalization.lift_mk'_spec (S := Localization.AtPrime p₀)
        (g := ψ) hunit d (0 : F) s).mp hz
    exact (IsLocalization.mk'_eq_zero_iff (S := Localization.AtPrime p₀) d s).mpr
      ((IsLocalization.map_eq_zero_iff p₀.primeCompl _ d).mp (hzero d hd))
  exact ⟨RingEquiv.ofBijective ψloc
    ⟨hinj, surjective_localization_to_residue θ φ ψ ε hεsurj hcomm hloc⟩,
    IsLocalization.lift_comp hunit⟩

/-- A canonical identification of the localized residue tensor product with the residue
field yields the coefficient field inside the completed local ring, compatibly with the
original tensor map. -/
private lemma coefficient_section_of_localization
    {D B F : Type*} [CommRing D] [CommRing B] [IsLocalRing B] [Field F]
    (ψ : D →+* F) (ρ : D →+* B) (ε : B →+* F)
    (hε : RingHom.ker ε = maximalIdeal B) (hsquare : ε.comp ρ = ψ)
    (e : let p := RingHom.ker ψ
      letI : p.IsPrime := RingHom.ker_isPrime _
      Localization.AtPrime p ≃+* F)
    (he : let p := RingHom.ker ψ
      letI : p.IsPrime := RingHom.ker_isPrime _
      e.toRingHom.comp (algebraMap D (Localization.AtPrime p)) = ψ) :
    ∃ σ : F →+* B, ε.comp σ = RingHom.id F ∧ σ.comp ψ = ρ := by
  let p := RingHom.ker ψ
  let : p.IsPrime := RingHom.ker_isPrime ψ
  obtain ⟨ρloc, hρloc⟩ := lift_to_localization_at_residue_kernel ψ ρ ε hε hsquare
  have hεloc : ε.comp ρloc = e.toRingHom := by
    apply IsLocalization.ringHom_ext (M := p.primeCompl)
    calc
      (ε.comp ρloc).comp (algebraMap D (Localization.AtPrime p)) =
          ε.comp (ρloc.comp (algebraMap D (Localization.AtPrime p))) :=
            RingHom.comp_assoc _ _ _
      _ = ψ := by rw [hρloc, hsquare]
      _ = e.toRingHom.comp (algebraMap D (Localization.AtPrime p)) := he.symm
  let σ : F →+* B := ρloc.comp e.symm.toRingHom
  refine ⟨σ, ?_, ?_⟩
  · show ε.comp (ρloc.comp e.symm.toRingHom) = RingHom.id F
    rw [← RingHom.comp_assoc, hεloc]
    exact RingHom.ext fun x => e.apply_symm_apply x
  · have hinv : e.symm.toRingHom.comp ψ = algebraMap D (Localization.AtPrime p) := by
      apply RingHom.ext
      intro d
      have hd := DFunLike.congr_fun he d
      change e (algebraMap D (Localization.AtPrime p) d) = ψ d at hd
      show e.symm (ψ d) = algebraMap D (Localization.AtPrime p) d
      rw [← hd, e.symm_apply_apply]
    show (ρloc.comp e.symm.toRingHom).comp ψ = ρ
    rw [RingHom.comp_assoc, hinv, hρloc]

/-- Taking constant coefficients commutes with the coefficientwise map after passing to
the two quotients. -/
private lemma quotient_constantCoeff_map {R S : Type*} [CommRing R] [CommRing S]
    (n : ℕ) (φ : R →+* S) (I : Ideal (MvPowerSeries (Fin n) R))
    (hI : I ≤ RingHom.ker
      (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) R →+* R)) :
    let J := I.map (MvPowerSeries.map φ)
    let hJ := map_ideal_le_constantCoeff_ker n φ I hI
    (Ideal.Quotient.lift J
      (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) S →+* S) hJ).comp
        (Ideal.quotientMap J (MvPowerSeries.map φ) (Ideal.le_comap_map)) =
      φ.comp (Ideal.Quotient.lift I
        (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) R →+* R) hI) := by
  dsimp
  refine RingHom.ext fun a => ?_
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
  exact MvPowerSeries.constantCoeff_map φ a

/-- The map on completions agrees with the original map on elements of the local rings. -/
private lemma completionMap_comp_algebraMap {A B : Type*} [CommRing A] [CommRing B]
    (φ : A →+* B) (I : Ideal A) (J : Ideal B) (hIJ : I.map φ ≤ J) :
    (adicCompletionMap φ I J hIJ).comp (algebraMap A (AdicCompletion I A)) =
      (algebraMap B (AdicCompletion J B)).comp φ := by
  apply RingHom.ext
  intro a
  apply AdicCompletion.ext_evalₐ
  intro m
  unfold adicCompletionMap
  simp only [RingHom.comp_apply]
  rw [AdicCompletion.evalₐ_liftRingHom]
  simp

/-- Reduction modulo the ideals commutes with the induced map on completions. -/
private lemma completionMap_evalOne {A B : Type*} [CommRing A] [CommRing B]
    (φ : A →+* B) (I : Ideal A) (J : Ideal B) (hIJ : I.map φ ≤ J) :
    (AdicCompletion.evalOneₐ J).toRingHom.comp (adicCompletionMap φ I J hIJ) =
      (Ideal.quotientMap J φ (Ideal.map_le_iff_le_comap.mp hIJ)).comp
        (AdicCompletion.evalOneₐ I).toRingHom := by
  apply RingHom.ext
  intro a
  show Ideal.Quotient.factor (show J ^ 1 ≤ J by simp)
      (AdicCompletion.evalₐ J 1 (adicCompletionMap φ I J hIJ a)) =
    Ideal.quotientMap J φ (Ideal.map_le_iff_le_comap.mp hIJ)
      (Ideal.Quotient.factor (show I ^ 1 ≤ I by simp) (AdicCompletion.evalₐ I 1 a))
  unfold adicCompletionMap
  rw [AdicCompletion.evalₐ_liftRingHom]
  obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective (AdicCompletion.evalₐ I 1 a)
  simp only [RingHom.comp_apply]
  have hx' : (AdicCompletion.evalₐ I 1).toRingHom a = Ideal.Quotient.mk (I ^ 1) x := hx.symm
  rw [hx']
  rw [← hx]
  rfl

/-- Extension of the maximal ideal commutes with completion of a local map when that ideal
already extends exactly in the original local rings. -/
private lemma completionMap_map_maximalIdeal_eq {A B : Type*} [CommRing A] [CommRing B]
    [IsLocalRing A] [IsLocalRing B] [IsNoetherianRing A] [IsNoetherianRing B]
    (φ : A →+* B) (hmax : (maximalIdeal A).map φ = maximalIdeal B) :
    (maximalIdeal (AdicCompletion (maximalIdeal A) A)).map
        (adicCompletionMap φ (maximalIdeal A) (maximalIdeal B) hmax.le) =
      maximalIdeal (AdicCompletion (maximalIdeal B) B) := by
  rw [AdicCompletion.maximalIdeal_eq_map, Ideal.map_map,
    completionMap_comp_algebraMap, ← Ideal.map_map, hmax,
    AdicCompletion.maximalIdeal_eq_map]

/-- The map from the ground field to a residue field is the evaluation of global sections. -/
private lemma fieldToResidue_eq_Γevaluation {k : Type u} [Field k] {Z : Scheme.{u}}
    (f : Z ⟶ Spec (.of k)) (z : Z) :
    fieldToResidue f z = (Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ Z.Γevaluation z := by
  simp only [fieldToResidue, fieldToStalk, Category.assoc]
  exact congrArg _ (congrArg _ (Z.germ_residue (U := ⊤) z trivial))

/-- A power-series presentation of a completed local ring over `k` gives, after extending
scalars to `K`, the presentation by the same equations over the residue field upstairs. -/
@[stacks 0C54]
theorem exists_baseChanged_powerSeries_quotient_algEquiv_adicCompletion
    (k K : Type u) [Field k] [Field K] [Algebra k K]
    (X : Scheme.{u}) (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f]
    (y : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u}))
    (hdim :
      ringKrullDim
          (X.presheaf.stalk
            ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).base y)) =
        ringKrullDim
          ((pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).presheaf.stalk y))
    (hsep :
      let x :=
        (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).base y
      letI : Algebra k (X.residueField x) :=
        ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.Γevaluation x).hom.toAlgebra
      Algebra.IsSeparableExtension k (X.residueField x))
    (n : ℕ)
    (I : Ideal
      (MvPowerSeries (Fin n)
        (X.residueField
          ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).base y))))
    (hI : I ≤ RingHom.ker
      (MvPowerSeries.constantCoeff :
        MvPowerSeries (Fin n)
            (X.residueField
              ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).base y)) →+*
          X.residueField
            ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).base y)))
    (e :
      let x :=
        (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).base y
      let R := X.presheaf.stalk x
      let κ := X.residueField x
      letI : Algebra k R :=
        ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.presheaf.germ ⊤ x (by simp)).hom.toAlgebra
      letI : Algebra k κ :=
        ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.Γevaluation x).hom.toAlgebra
      (MvPowerSeries (Fin n) κ ⧸ I) ≃ₐ[k]
        AdicCompletion (maximalIdeal R) R)
    (he :
      let x :=
        (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).base y
      let R := X.presheaf.stalk x
      let κ := X.residueField x
      letI : Algebra k R :=
        ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.presheaf.germ ⊤ x (by simp)).hom.toAlgebra
      letI : Algebra k κ :=
        ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.Γevaluation x).hom.toAlgebra
      (AdicCompletion.evalOneₐ (maximalIdeal R)).toRingHom.comp
          e.toRingEquiv.toRingHom =
        Ideal.Quotient.lift I
          (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) κ →+* κ) hI) :
    let Y := pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K)))
    let p : Y ⟶ X := pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))
    let g : Y ⟶ Spec (.of K) := pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k K)))
    let x := p.base y
    let RY := Y.presheaf.stalk y
    let κy := Y.residueField y
    let κMap : X.residueField x →+* κy := (p.residueFieldMap y).hom
    let J : Ideal (MvPowerSeries (Fin n) κy) := I.map (MvPowerSeries.map κMap)
    let : Algebra K RY :=
      ((Scheme.ΓSpecIso (.of K)).inv ≫ g.appTop ≫ Y.presheaf.germ ⊤ y (by simp)).hom.toAlgebra
    let : Algebra K κy :=
      ((Scheme.ΓSpecIso (.of K)).inv ≫ g.appTop ≫ Y.Γevaluation y).hom.toAlgebra
    ∃ (hJ : J ≤ RingHom.ker
        (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) κy →+* κy))
      (eY : (MvPowerSeries (Fin n) κy ⧸ J) ≃ₐ[K]
        AdicCompletion (maximalIdeal RY) RY),
      (AdicCompletion.evalOneₐ (maximalIdeal RY)).toRingHom.comp
          eY.toRingEquiv.toRingHom =
        Ideal.Quotient.lift J
          (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) κy →+* κy) hJ := by
    let Y := pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K)))
    let p : Y ⟶ X := pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))
    let κMap : X.residueField (p.base y) →+* Y.residueField y := (p.residueFieldMap y).hom
    let : Algebra k (X.presheaf.stalk (p.base y)) :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
        X.presheaf.germ ⊤ (p.base y) (by simp)).hom.toAlgebra
    let : Algebra k (X.residueField (p.base y)) :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
        X.Γevaluation (p.base y)).hom.toAlgebra
    have : Flat (Spec.map (CommRingCat.ofHom (algebraMap k K))) :=
      Flat.SpecMap_iff.mpr (RingHom.flat_algebraMap_iff.mpr inferInstance)
    have : Flat p := inferInstance
    have hpflat : (p.stalkMap y).hom.Flat := Flat.stalkMap p y
    let g : Y ⟶ Spec (.of K) := pullback.snd f
      (Spec.map (CommRingCat.ofHom (algebraMap k K)))
    have : LocallyOfFiniteType g := inferInstance
    have : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian g
    have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
    have hmax := map_maximalIdeal_stalkMap_eq_of_isReduced_tensorProduct
      k K X f y hdim (by
        dsimp
        let : (f (p.base y)).asIdeal.IsPrime := (f (p.base y)).isPrime
        let : Algebra k (X.residueField (p.base y)) :=
          ((CommRingCat.ofHom (algebraMap k (f (p.base y)).asIdeal.ResidueField)) ≫
            (Scheme.Spec.residueFieldIso (.of k) (f (p.base y))).inv ≫
            f.residueFieldMap (p.base y)).hom.toAlgebra
        apply Algebra.isReduced_tensorProduct_of_isSeparableExtension_or_isSeparablyGenerated
        left
        have hcat :
            CommRingCat.ofHom (algebraMap k (f (p.base y)).asIdeal.ResidueField) ≫
                (Scheme.Spec.residueFieldIso (.of k) (f (p.base y))).inv ≫
                f.residueFieldMap (p.base y) =
              (Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫
                X.Γevaluation (p.base y) := by
          calc
            _ = ((Scheme.ΓSpecIso (.of k)).inv ≫
                (Spec (.of k)).presheaf.germ ⊤ (f (p.base y)) (by simp) ≫
                (Spec (.of k)).residue (f (p.base y))) ≫
                f.residueFieldMap (p.base y) := by
                  rw [← Category.assoc,
                    Scheme.Spec.algebraMap_residueFieldIso_inv (.of k) (f (p.base y))]
            _ = _ := by
              simpa only [Category.assoc, Scheme.germ_residue] using
                congrArg ((Scheme.ΓSpecIso (.of k)).inv ≫ ·)
                  (Scheme.Γevaluation_naturality f (p.base y))
        exact hcat.symm ▸ hsep
      )
    obtain ⟨θ, ψ, φ, hθl, hθr, hψl, hψr, hφl, hφr, hφψ, hloc⟩ :=
      stalkOfBaseChange_isLocalization f (p.base y) y rfl
    let A := stalkBaseChangeRing (K := K) f (p.base y)
    let D := residueBaseChangeRing (K := K) f (p.base y)
    let lA : X.presheaf.stalk (p.base y) →+* A :=
      (pushout.inl (fieldToStalk f (p.base y))
        (CommRingCat.ofHom (algebraMap k K))).hom
    let rA : K →+* A :=
      (pushout.inr (fieldToStalk f (p.base y))
        (CommRingCat.ofHom (algebraMap k K))).hom
    let lD : X.residueField (p.base y) →+* D :=
      (pushout.inl (fieldToResidue f (p.base y))
        (CommRingCat.ofHom (algebraMap k K))).hom
    let rD : K →+* D :=
      (pushout.inr (fieldToResidue f (p.base y))
        (CommRingCat.ofHom (algebraMap k K))).hom
    have hθsurj : Function.Surjective θ.hom := by
      apply RingHom.range_eq_top.mp
      apply top_le_iff.mp
      calc
        ⊤ = Subring.closure (Set.range lD ∪ Set.range rD) :=
          (CommRingCat.closure_range_union_range_eq_top_of_isPushout
            (IsPushout.of_hasPushout _ _)).symm
        _ ≤ θ.hom.range := by
          apply Subring.closure_le.mpr
          simp only [Set.union_subset_iff, RingHom.coe_range, Set.range_subset_iff,
            Set.mem_range]
          refine ⟨fun c => ?_, fun c => ⟨rA c, congrArg (fun t : _ ⟶ D => t.hom c) hθr⟩⟩
          obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective c
          exact ⟨lA a, congrArg (fun t : _ ⟶ D => t.hom a) hθl⟩
    let m : Ideal A := (maximalIdeal (X.presheaf.stalk (p.base y))).map lA
    have hθm : m ≤ RingHom.ker θ.hom := by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      have h := congrArg (fun t : _ ⟶ D => t.hom a) hθl
      change θ.hom (lA a) = lD (X.residue (p.base y) a) at h
      show θ.hom (lA a) = 0
      rw [h]
      have ha0 : X.residue (p.base y) a = 0 := by
        rw [← (IsLocalRing.ker_residue (R := X.presheaf.stalk (p.base y)))] at ha
        exact (RingHom.mem_ker).mp ha
      rw [ha0, map_zero]
    have hφlA : φ.hom.comp lA = (p.stalkMap y).hom := by
      have h := congrArg CommRingCat.Hom.hom hφl
      change φ.hom.comp lA =
        ((X.presheaf.stalkCongr (.of_eq (rfl : p.base y = p.base y))).hom ≫
          p.stalkMap y).hom at h
      simpa using h
    have hm : m.map φ.hom = maximalIdeal (Y.presheaf.stalk y) := by
      show ((maximalIdeal (X.presheaf.stalk (p.base y))).map lA).map φ.hom = _
      rw [Ideal.map_map, hφlA]
      exact hmax
    have hcomm : ψ.hom.comp θ.hom = (Y.residue y).hom.comp φ.hom :=
      congrArg CommRingCat.Hom.hom hφψ
    have hbase :
        (p.stalkMap y).hom.comp
            (fieldToStalk f (p.base y)).hom =
          (fieldToStalk g y).hom.comp
            (algebraMap k K) := by
      have hr := congrArg CommRingCat.Hom.hom hφr
      change φ.hom.comp rA =
        (fieldToStalk g y).hom at hr
      ext a
      have hc := pushout.condition
        (f := fieldToStalk f (p.base y))
        (g := CommRingCat.ofHom (algebraMap k K))
      have hc' := congrArg (fun t : CommRingCat.of k ⟶ A => t.hom a) hc
      change lA ((fieldToStalk f (p.base y)).hom a) =
        rA ((algebraMap k K) a) at hc'
      show (p.stalkMap y).hom
          ((fieldToStalk f (p.base y)).hom a) =
        (fieldToStalk g y).hom
          ((algebraMap k K) a)
      rw [← hφlA, ← hr, RingHom.comp_apply, RingHom.comp_apply, hc']
    have hfieldToResidue :
        (fieldToResidue f (p.base y)).hom =
          algebraMap k (X.residueField (p.base y)) :=
      congrArg CommRingCat.Hom.hom (fieldToResidue_eq_Γevaluation f (p.base y))
    have hloc' :
        let q := RingHom.ker (ψ.hom.comp θ.hom)
        let : q.IsPrime := RingHom.ker_isPrime _
        let : Algebra A (Y.presheaf.stalk y) := φ.hom.toAlgebra
        IsLocalization.AtPrime (Y.presheaf.stalk y) q := by
      simpa only [stalkBaseChangePrime,
        RingHom.comap_ker] using hloc
    obtain ⟨eD, heD⟩ := localization_residue_ringEquiv_of_maximalIdeal
      θ.hom φ.hom ψ.hom (Y.residue y).hom m hθsurj hθm hm
      (IsLocalRing.ker_residue) Ideal.Quotient.mk_surjective hcomm hloc'
    let : Algebra K (Y.presheaf.stalk y) :=
      ((Scheme.ΓSpecIso (.of K)).inv ≫ g.appTop ≫
        Y.presheaf.germ ⊤ y (by simp)).hom.toAlgebra
    let Bhat := AdicCompletion (maximalIdeal (Y.presheaf.stalk y)) (Y.presheaf.stalk y)
    let : Algebra K Bhat :=
      ((algebraMap (Y.presheaf.stalk y) Bhat).comp
        (algebraMap K (Y.presheaf.stalk y))).toAlgebra
    have hcompletionFlat :
        (adicCompletionMap (p.stalkMap y).hom
          (maximalIdeal (X.presheaf.stalk (p.base y)))
          (maximalIdeal (Y.presheaf.stalk y))
          (IsLocalRing.map_maximalIdeal_le (p.stalkMap y).hom)).Flat :=
      (adicCompletionMap_flat_iff (p.stalkMap y).hom).mpr hpflat
    have hcompletionMax := completionMap_map_maximalIdeal_eq
      (p.stalkMap y).hom hmax
    have hcompletionResidueField :
        (AdicCompletion.evalOneₐ (maximalIdeal (Y.presheaf.stalk y))).toRingHom.comp
            (adicCompletionMap (p.stalkMap y).hom
              (maximalIdeal (X.presheaf.stalk (p.base y)))
              (maximalIdeal (Y.presheaf.stalk y))
              (IsLocalRing.map_maximalIdeal_le (p.stalkMap y).hom)) =
          κMap.comp
            (AdicCompletion.evalOneₐ
              (maximalIdeal (X.presheaf.stalk (p.base y)))).toRingHom :=
      completionMap_evalOne (p.stalkMap y).hom
        (maximalIdeal (X.presheaf.stalk (p.base y)))
        (maximalIdeal (Y.presheaf.stalk y))
        (IsLocalRing.map_maximalIdeal_le (p.stalkMap y).hom)
    let hJ := map_ideal_le_constantCoeff_ker n κMap I hI
    have hpresentationResidueSquare :
        (AdicCompletion.evalOneₐ (maximalIdeal (Y.presheaf.stalk y))).toRingHom.comp
          ((adicCompletionMap (p.stalkMap y).hom
            (maximalIdeal (X.presheaf.stalk (p.base y)))
            (maximalIdeal (Y.presheaf.stalk y))
            (IsLocalRing.map_maximalIdeal_le (p.stalkMap y).hom)).comp
              e.toRingEquiv.toRingHom) =
        (Ideal.Quotient.lift (I.map (MvPowerSeries.map κMap))
          (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) (Y.residueField y) →+*
            Y.residueField y) hJ).comp
          (Ideal.quotientMap (I.map (MvPowerSeries.map κMap))
            (MvPowerSeries.map κMap) Ideal.le_comap_map) := by
      calc
        _ = κMap.comp ((AdicCompletion.evalOneₐ
            (maximalIdeal (X.presheaf.stalk (p.base y)))).toRingHom.comp
              e.toRingEquiv.toRingHom) := by
                exact congrArg (fun h => h.comp e.toRingEquiv.toRingHom)
                  hcompletionResidueField
        _ = κMap.comp (Ideal.Quotient.lift I
            (MvPowerSeries.constantCoeff :
              MvPowerSeries (Fin n) (X.residueField (p.base y)) →+*
                X.residueField (p.base y)) hI) := by rw [he]
        _ = _ := (quotient_constantCoeff_map n κMap I hI).symm
    let c : AdicCompletion (maximalIdeal (X.presheaf.stalk (p.base y)))
        (X.presheaf.stalk (p.base y)) →+* Bhat :=
      adicCompletionMap (p.stalkMap y).hom
        (maximalIdeal (X.presheaf.stalk (p.base y)))
        (maximalIdeal (Y.presheaf.stalk y))
        (IsLocalRing.map_maximalIdeal_le (p.stalkMap y).hom)
    let G : MvPowerSeries (Fin n) (X.residueField (p.base y)) →+* Bhat :=
      c.comp (e.toRingEquiv.toRingHom.comp (Ideal.Quotient.mk I))
    let σx : X.residueField (p.base y) →+* Bhat :=
      G.comp MvPowerSeries.C
    have hσxres : (AdicCompletion.evalOneₐ
        (maximalIdeal (Y.presheaf.stalk y))).toRingHom.comp σx = κMap := by
      apply RingHom.ext
      intro a
      have h := DFunLike.congr_fun hpresentationResidueSquare
        (Ideal.Quotient.mk I (MvPowerSeries.C a))
      show (AdicCompletion.evalOneₐ (maximalIdeal (Y.presheaf.stalk y))).toRingHom
          (σx a) = κMap a
      change (AdicCompletion.evalOneₐ (maximalIdeal (Y.presheaf.stalk y))).toRingHom
          (σx a) =
        ((Ideal.Quotient.lift (I.map (MvPowerSeries.map κMap))
          (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) (Y.residueField y) →+*
            Y.residueField y) hJ).comp
          (Ideal.quotientMap (I.map (MvPowerSeries.map κMap))
            (MvPowerSeries.map κMap) Ideal.le_comap_map))
          (Ideal.Quotient.mk I (MvPowerSeries.C a)) at h
      simp only [RingHom.comp_apply, Ideal.quotientMap_mk, MvPowerSeries.map_C] at h
      exact h
    have hσxbase : σx.comp
        (fieldToResidue f (p.base y)).hom =
          (algebraMap K Bhat).comp (algebraMap k K) := by
      rw [hfieldToResidue]
      apply RingHom.ext
      intro a
      have hQ : Ideal.Quotient.mk I
          (MvPowerSeries.C (algebraMap k (X.residueField (p.base y)) a)) =
          algebraMap k (MvPowerSeries (Fin n) (X.residueField (p.base y)) ⧸ I) a := by
        rw [← Ideal.Quotient.mk_algebraMap, MvPowerSeries.algebraMap_apply]
      have he' := e.commutes a
      have hc' := DFunLike.congr_fun
        (completionMap_comp_algebraMap (p.stalkMap y).hom
          (maximalIdeal (X.presheaf.stalk (p.base y)))
          (maximalIdeal (Y.presheaf.stalk y))
          (IsLocalRing.map_maximalIdeal_le (p.stalkMap y).hom))
        ((fieldToStalk f (p.base y)).hom a)
      have hb := DFunLike.congr_fun hbase a
      change (p.stalkMap y).hom (algebraMap k (X.presheaf.stalk (p.base y)) a) =
        algebraMap K (Y.presheaf.stalk y) (algebraMap k K a) at hb
      show σx (algebraMap k (X.residueField (p.base y)) a) =
        algebraMap K Bhat (algebraMap k K a)
      show G (MvPowerSeries.C (algebraMap k (X.residueField (p.base y)) a)) = _
      show c (e (Ideal.Quotient.mk I
        (MvPowerSeries.C (algebraMap k (X.residueField (p.base y)) a)))) = _
      rw [hQ, he']
      show c (algebraMap k
          (AdicCompletion (maximalIdeal (X.presheaf.stalk (p.base y)))
            (X.presheaf.stalk (p.base y))) a) = _
      rw [show algebraMap k
          (AdicCompletion (maximalIdeal (X.presheaf.stalk (p.base y)))
            (X.presheaf.stalk (p.base y))) a =
          algebraMap (X.presheaf.stalk (p.base y)) _
            (algebraMap k (X.presheaf.stalk (p.base y)) a) from rfl]
      show c (algebraMap (X.presheaf.stalk (p.base y)) _
        ((fieldToStalk f (p.base y)).hom a)) = _
      rw [← RingHom.comp_apply, hc', RingHom.comp_apply]
      show (algebraMap (Y.presheaf.stalk y) Bhat)
        ((p.stalkMap y).hom (algebraMap k (X.presheaf.stalk (p.base y)) a)) = _
      rw [hb]
      rfl
    let ε : Bhat →+* Y.residueField y :=
      (AdicCompletion.evalOneₐ (maximalIdeal (Y.presheaf.stalk y))).toRingHom
    have hpush :
        fieldToResidue f (p.base y) ≫
            CommRingCat.ofHom σx =
          CommRingCat.ofHom (algebraMap k K) ≫
            CommRingCat.ofHom (algebraMap K Bhat) :=
      CommRingCat.hom_ext hσxbase
    let ρcat : D ⟶ CommRingCat.of Bhat :=
      pushout.desc (CommRingCat.ofHom σx)
        (CommRingCat.ofHom (algebraMap K Bhat)) hpush
    let ρ : D →+* Bhat := ρcat.hom
    have hψl' : ψ.hom.comp lD = κMap := by
      have h := congrArg CommRingCat.Hom.hom hψl
      change ψ.hom.comp lD =
        κMap.comp ((X.residueFieldCongr rfl).hom).hom at h
      simpa using h
    have hψr' : ψ.hom.comp rD =
        (fieldToResidue g y).hom :=
      congrArg CommRingCat.Hom.hom hψr
    have hεker : RingHom.ker ε = maximalIdeal Bhat := by
      show RingHom.ker
        (AdicCompletion.evalOneₐ (maximalIdeal (Y.presheaf.stalk y))).toRingHom = _
      rw [AdicCompletion.ker_evalOneₐ_eq_map
        (maximalIdeal (Y.presheaf.stalk y))
        ((maximalIdeal (Y.presheaf.stalk y)).fg_of_isNoetherianRing),
        AdicCompletion.maximalIdeal_eq_map]
    have hKres : ε.comp (algebraMap K Bhat) =
        (fieldToResidue g y).hom := by
      show ε.comp ((algebraMap (Y.presheaf.stalk y) Bhat).comp
          (algebraMap K (Y.presheaf.stalk y))) = _
      rw [← RingHom.comp_assoc]
      show ((AdicCompletion.evalOneₐ (maximalIdeal (Y.presheaf.stalk y))).toRingHom.comp
          (algebraMap (Y.presheaf.stalk y) Bhat)).comp
          (algebraMap K (Y.presheaf.stalk y)) = _
      rw [AdicCompletion.evalOneₐ_comp_algebraMap_eq_mk]
      rfl
    have hρres : ε.comp ρ = ψ.hom := by
      have hcat : ρcat ≫ CommRingCat.ofHom ε = ψ := by
        apply (pushout.hom_ext
          (f := fieldToResidue f (p.base y))
          (g := CommRingCat.ofHom (algebraMap k K)))
        · calc
            _ = (pushout.inl
                (fieldToResidue f (p.base y))
                (CommRingCat.ofHom (algebraMap k K)) ≫ ρcat) ≫
                  CommRingCat.ofHom ε := (Category.assoc _ _ _).symm
            _ = CommRingCat.ofHom σx ≫ CommRingCat.ofHom ε := by
              rw [show ρcat = pushout.desc (CommRingCat.ofHom σx)
                (CommRingCat.ofHom (algebraMap K Bhat)) hpush from rfl,
                pushout.inl_desc]
            _ = _ := CommRingCat.hom_ext (hσxres.trans hψl'.symm)
        · calc
            _ = (pushout.inr
                (fieldToResidue f (p.base y))
                (CommRingCat.ofHom (algebraMap k K)) ≫ ρcat) ≫
                  CommRingCat.ofHom ε := (Category.assoc _ _ _).symm
            _ = CommRingCat.ofHom (algebraMap K Bhat) ≫ CommRingCat.ofHom ε := by
              rw [show ρcat = pushout.desc (CommRingCat.ofHom σx)
                (CommRingCat.ofHom (algebraMap K Bhat)) hpush from rfl,
                pushout.inr_desc]
            _ = _ := CommRingCat.hom_ext (hKres.trans hψr'.symm)
      exact congrArg CommRingCat.Hom.hom hcat
    obtain ⟨σy, hσyres, hσyρ⟩ :=
      coefficient_section_of_localization ψ.hom ρ ε hεker hρres eD heD
    let : Algebra K (Y.residueField y) :=
      ((Scheme.ΓSpecIso (.of K)).inv ≫ g.appTop ≫ Y.Γevaluation y).hom.toAlgebra
    have hρl : ρ.comp lD = σx := congrArg CommRingCat.Hom.hom
      (pushout.inl_desc (CommRingCat.ofHom σx) (CommRingCat.ofHom (algebraMap K Bhat)) hpush)
    have hρr : ρ.comp rD = algebraMap K Bhat := congrArg CommRingCat.Hom.hom
      (pushout.inr_desc (CommRingCat.ofHom σx) (CommRingCat.ofHom (algebraMap K Bhat)) hpush)
    have hσyκ : σy.comp κMap = σx := by
      calc
        σy.comp κMap = σy.comp (ψ.hom.comp lD) := by rw [hψl']
        _ = (σy.comp ψ.hom).comp lD := RingHom.comp_assoc _ _ _
        _ = ρ.comp lD := by rw [hσyρ]
        _ = σx := hρl
    have hfieldToResidueK :
        (fieldToResidue g y).hom =
          algebraMap K (Y.residueField y) :=
      congrArg CommRingCat.Hom.hom (fieldToResidue_eq_Γevaluation g y)
    have hσyK : σy.comp (algebraMap K (Y.residueField y)) =
        algebraMap K Bhat := by
      calc
        σy.comp (algebraMap K (Y.residueField y)) = σy.comp (ψ.hom.comp rD) := by
          rw [← hfieldToResidueK, hψr']
        _ = (σy.comp ψ.hom).comp rD := RingHom.comp_assoc _ _ _
        _ = ρ.comp rD := by rw [hσyρ]
        _ = algebraMap K Bhat := hρr
    let v : Fin n → Bhat := fun i => G (MvPowerSeries.X i)
    let : IsLocalRing (MvPowerSeries (Fin n) (X.residueField (p.base y)) ⧸ I) :=
      quotientPowerSeriesIsLocal n I hI
    let Qx := MvPowerSeries (Fin n) (X.residueField (p.base y)) ⧸ I
    let b : Qx →+* Bhat := c.comp e.toRingEquiv.toRingHom
    have hbmax : (maximalIdeal Qx).map b = maximalIdeal Bhat := by
      show (maximalIdeal Qx).map (c.comp e.toRingEquiv.toRingHom) = _
      rw [← Ideal.map_map, IsLocalRing.map_maximalIdeal_of_surjective
        e.toRingEquiv.toRingHom e.surjective]
      exact hcompletionMax
    have hv : Ideal.span (Set.range v) = maximalIdeal Bhat := by
      calc
        Ideal.span (Set.range v) =
            (Ideal.span (Set.range
              (MvPowerSeries.X : Fin n → MvPowerSeries (Fin n)
                (X.residueField (p.base y))))).map G := by
              rw [Ideal.map_span, ← Set.range_comp]
              rfl
        _ = (maximalIdeal (MvPowerSeries (Fin n)
            (X.residueField (p.base y)))).map G := by
              rw [maximalIdeal_mvPowerSeries_eq_span_X]
        _ = ((maximalIdeal (MvPowerSeries (Fin n)
            (X.residueField (p.base y)))).map (Ideal.Quotient.mk I)).map b := by
              rw [Ideal.map_map]
              rfl
        _ = (maximalIdeal Qx).map b := by
              rw [quotient_powerSeries_maximalIdeal_eq n I hI]
        _ = maximalIdeal Bhat := hbmax
    have hσysurj : Function.Surjective
        ((Ideal.Quotient.mk (maximalIdeal Bhat)).comp σy) := by
      intro b
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
      refine ⟨ε a, Ideal.Quotient.eq.mpr ?_⟩
      rw [← hεker, RingHom.mem_ker, map_sub, sub_eq_zero]
      simpa using
        DFunLike.congr_fun hσyres (ε a)
    obtain ⟨H, hHsurj, hHX, hHC⟩ :=
      exists_surjective_eval₂Hom (maximalIdeal Bhat) v hv σy hσysurj
    have hvmax : ∀ i, v i ∈ maximalIdeal Bhat := fun i =>
      hv ▸ Ideal.subset_span ⟨i, rfl⟩
    have hHG : H.comp (MvPowerSeries.map κMap) = G :=
      mvPowerSeries_eval_map_eq (maximalIdeal Bhat) n κMap σy σx v
        hσyκ hvmax G (fun _ => rfl) (fun _ => rfl) H hHC hHX
    have hIker : I ≤ RingHom.ker G := by
      intro a ha
      show G a = 0
      show c (e (Ideal.Quotient.mk I a)) = 0
      rw [Ideal.Quotient.eq_zero_iff_mem.mpr ha, map_zero, map_zero]
    have hJker : I.map (MvPowerSeries.map κMap) ≤ RingHom.ker H :=
      map_ideal_le_ker_of_eval_map_eq (MvPowerSeries.map κMap) I G H hIker hHG
    have hHK (a : K) : H (algebraMap K
        (MvPowerSeries (Fin n) (Y.residueField y)) a) = algebraMap K Bhat a := by
      rw [MvPowerSeries.algebraMap_apply, hHC]
      exact DFunLike.congr_fun hσyK a
    let Hₐ : MvPowerSeries (Fin n) (Y.residueField y) →ₐ[K] Bhat :=
      { toRingHom := H
        commutes' := hHK }
    let Qy := MvPowerSeries (Fin n) (Y.residueField y) ⧸
      I.map (MvPowerSeries.map κMap)
    let FQ : Qy →ₐ[K] Bhat := Ideal.Quotient.liftₐ
      (I.map (MvPowerSeries.map κMap)) Hₐ
      (fun a ha => (RingHom.mem_ker).mp (hJker ha))
    have hFQsurj : Function.Surjective FQ := fun b => by
      obtain ⟨a, rfl⟩ := hHsurj b
      exact ⟨Ideal.Quotient.mk (I.map (MvPowerSeries.map κMap)) a, rfl⟩
    let q : Qx →+* Qy :=
      Ideal.quotientMap (I.map (MvPowerSeries.map κMap))
        (MvPowerSeries.map κMap) Ideal.le_comap_map
    have hFQq : FQ.toRingHom.comp q = b := by
      refine RingHom.ext fun z => ?_
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
      show FQ (q (Ideal.Quotient.mk I a)) = b (Ideal.Quotient.mk I a)
      rw [Ideal.quotientMap_mk]
      exact DFunLike.congr_fun hHG a
    have hbflat : b.Flat :=
      (RingHom.Flat.of_bijective (f := e.toRingEquiv.toRingHom)
        e.toRingEquiv.bijective).comp hcompletionFlat
    let : IsLocalRing Qy := quotientPowerSeriesIsLocal n
      (I.map (MvPowerSeries.map κMap)) hJ
    have hqmax : (maximalIdeal Qx).map q = maximalIdeal Qy :=
      quotientMap_map_maximalIdeal_eq_quotients n κMap I hI
    let : Algebra Qx Qy := q.toAlgebra
    let : Algebra Qx Bhat := b.toAlgebra
    have : Module.Flat Qx Bhat := RingHom.flat_algebraMap_iff.mp hbflat
    have : IsLocalHom (algebraMap Qx Qy) :=
      ((IsLocalRing.local_hom_TFAE q).out 3 1).mp hqmax.le
    let FQR : Qy →ₐ[Qx] Bhat :=
      { toRingHom := FQ.toRingHom
        commutes' := fun z => DFunLike.congr_fun hFQq z }
    have : IsLocalHom FQR.toRingHom :=
      IsLocalHom.of_surjective FQR.toRingHom hFQsurj
    have hFQinj : Function.Injective FQ :=
      injective_of_flat_of_maximalIdeal_eq FQR hqmax hbmax
    have hεH : ε.comp H =
        (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) (Y.residueField y) →+*
          Y.residueField y) := by
      apply mvPowerSeries_hom_ext (maximalIdeal (Y.residueField y)) n
      · intro a
        show ε (H (MvPowerSeries.C a)) = a
        rw [hHC]
        simpa using DFunLike.congr_fun hσyres a
      · intro i
        show ε (H (MvPowerSeries.X i)) =
          MvPowerSeries.constantCoeff (MvPowerSeries.X i)
        rw [hHX, MvPowerSeries.constantCoeff_X]
        exact (RingHom.mem_ker).mp (hεker ▸ hvmax i)
      · intro i
        show ε (H (MvPowerSeries.X i)) ∈ maximalIdeal (Y.residueField y)
        rw [hHX, (RingHom.mem_ker).mp (hεker ▸ hvmax i)]
        exact Ideal.zero_mem _
    have hresQ : ε.comp FQ.toRingHom =
        Ideal.Quotient.lift (I.map (MvPowerSeries.map κMap))
          (MvPowerSeries.constantCoeff : MvPowerSeries (Fin n) (Y.residueField y) →+*
            Y.residueField y) hJ := by
      refine RingHom.ext fun z => ?_
      obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
      exact DFunLike.congr_fun hεH a
    exact ⟨hJ, AlgEquiv.ofBijective FQ ⟨hFQinj, hFQsurj⟩, hresQ⟩

end AlgebraicGeometry
