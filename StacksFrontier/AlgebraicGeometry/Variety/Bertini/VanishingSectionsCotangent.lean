module

public import StacksFrontier.AlgebraicGeometry.Variety.Bertini.VanishingLinearSystem
public import StacksFrontier.AlgebraicGeometry.AmplePowers.ModuleStalk
public import StacksFrontier.AlgebraicGeometry.NonvanishingPullback.GlobalSections
public import StacksFrontier.AlgebraicGeometry.Divisors.EffectiveCartierWeilDivisor
public import StacksFrontier.AlgebraicGeometry.FormalGeometry.IdealPowerQuotient

/-!
# Germs of sections vanishing on a subscheme through a point

Let `X` be a proper scheme over a field `k`, `ℒ` an ample invertible `𝒪_X`-module and `I` a
quasi-coherent sheaf of ideals whose stalk at a point `x` is the maximal ideal `𝔪_x`. Write
`V_n ⊆ Γ(X, ℒ ^⊗ n)` for the sections vanishing on `V(I)`. Then for all `n ≫ 0` the germs at `x`
of the members of `V_n` span `𝔪_x ℒ^{⊗ n}_x` over `𝒪_{X,x}`; equivalently `V_n` surjects onto
`𝔪_x ℒ_x^{⊗ n} / 𝔪_x^2 ℒ_x^{⊗ n}`.

Every member of `V_n` vanishes at the points of `V(I)`: its pullback to `V(I)` is zero, and the
nonvanishing locus of a pulled back section is the preimage of the nonvanishing locus. Conversely,
by [Stacks, Tag 01Q3] the subsheaf `I ℒ ^⊗ n` is generated by finitely many global sections for
`n ≫ 0`; these lie in `V_n`, and their germs generate the stalk of `I ℒ ^⊗ n` at `x`, which
contains `I_x ℒ^{⊗ n}_x = 𝔪_x ℒ^{⊗ n}_x`.

## References

* [Stacks Project, Tag 0FH5](https://stacks.math.columbia.edu/tag/0FH5)
* [Stacks Project, Tag 01Q3](https://stacks.math.columbia.edu/tag/01Q3)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite Stacks.Ample
open scoped Stacks.ModuleStalk Stacks.FinGenFromCover

universe u

namespace Stacks.SectionsVanishingOnSubscheme

section General

variable {X : Scheme.{u}}

/-- A submodule of a module stalk over `𝒪_{X,x}` contains the span, over the stalk of the
`RingCat`-valued structure sheaf, of each of its subsets. -/
theorem mem_of_mem_span_ringStalk {M : X.Modules} {x : X}
    (S : Submodule (X.presheaf.stalk x) (TopCat.Presheaf.stalk (C := Ab.{u}) M.presheaf x))
    {A : Set (TopCat.Presheaf.stalk (C := Ab.{u}) M.presheaf x)} (hA : A ⊆ S)
    {z : TopCat.Presheaf.stalk (C := Ab.{u}) M.presheaf x}
    (hz : z ∈ Submodule.span (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat) A) :
    z ∈ S := by
  induction hz using Submodule.span_induction with
  | mem y hy => exact hA hy
  | zero => exact S.zero_mem
  | add y w _ _ hy hw => exact S.add_mem hy hw
  | smul r y _ hy =>
    obtain ⟨r', hr'⟩ := Stacks.StalkwiseGeneration.exists_stalk_smul_eq M x r y
    rw [hr']
    exact S.smul_mem r' hy

end General

/-- **Every member of `V_n` vanishes at a point of `V(I)`**: its germ lies in `𝔪_x ℒ^{⊗ n}_x`. -/
theorem Γgerm_mem_maximalSmul_of_mem_vanishingSections (k : Type u) [CommRing k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (I : X.IdealSheafData) (L : X.Modules) [IsInvertibleModule X L] (n : ℤ)
    (x : X) (hx : x ∈ I.support) (v : vanishingSections k f I L n) :
    ((tensorPowModule X L n).presheaf.Γgerm x).hom
        ((v : Stacks.Bertini.globalSections k f (tensorPowModule X L n)) :
          Γ(tensorPowModule X L n, ⊤)) ∈
      Stacks.ModuleStalk.maximalSmul (tensorPowModule X L n) x := by
  obtain ⟨z, rfl⟩ : x ∈ Set.range I.subschemeι := by rw [I.range_subschemeι]; exact hx
  by_contra hv
  have hmem : z ∈ I.subschemeι ⁻¹' nonvanishingLocus (tensorPowModule X L n)
      ((v : Stacks.Bertini.globalSections k f (tensorPowModule X L n)) :
        Γ(tensorPowModule X L n, ⊤)) := hv
  have hpb := (Set.ext_iff.mp
    (Stacks.NonvanishingPullback.preimage_nonvanishingLocus_pullbackGlobalSections I.subschemeι
      (tensorPowModule X L n) ((v : Stacks.Bertini.globalSections k f (tensorPowModule X L n)) :
        Γ(tensorPowModule X L n, ⊤))) z).mp hmem
  have h0 : pullbackGlobalSections I.subschemeι (tensorPowModule X L n)
      ((v : Stacks.Bertini.globalSections k f (tensorPowModule X L n)) :
        Γ(tensorPowModule X L n, ⊤)) = 0 := v.2
  rw [h0, nonvanishingLocus_zero] at hpb
  exact hpb

/-- If `I ℒ ^⊗ n` is generated by finitely many global sections and `I_x = 𝔪_x`, then the germs
at `x` of the members of `V_n` span a submodule containing `𝔪_x ℒ^{⊗ n}_x`. -/
theorem maximalSmul_le_span_of_isFinGen (k : Type u) [CommRing k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (I : X.IdealSheafData) (L : X.Modules)
    [IsInvertibleModule X L] (n : ℤ) (x : X)
    (hI : IdealSheafData.stalk I x = IsLocalRing.maximalIdeal (X.presheaf.stalk x))
    (hgen : Stacks.AmpleEventualGeneration.IsFinGen
      (Stacks.Algebraization.idealPowerMultiple I 1 (tensorPowModule X L n)).asModules) :
    Stacks.ModuleStalk.maximalSmul (tensorPowModule X L n) x ≤
      Submodule.span (X.presheaf.stalk x)
        (Set.range fun v : vanishingSections k f I L n =>
          ((tensorPowModule X L n).presheaf.Γgerm x).hom
            ((v : Stacks.Bertini.globalSections k f (tensorPowModule X L n)) :
              Γ(tensorPowModule X L n, ⊤))) := by
  set F := tensorPowModule X L n with hF
  set P := Stacks.Algebraization.idealPowerMultiple I 1 F with hP
  set S := Submodule.span (X.presheaf.stalk x)
    (Set.range fun v : vanishingSections k f I L n =>
      (F.presheaf.Γgerm x).hom
        ((v : Stacks.Bertini.globalSections k f F) : Γ(F, ⊤))) with hS
  obtain ⟨J, t, -, hspan⟩ := Stacks.AmpleLocalGeneration.isFinGenOn_of_isFinGen hgen ⊤
  -- the germ of every section of `I ℒ ^⊗ n` lies in `S`
  have hPS : ∀ (U : X.Opens) (hxU : x ∈ U) (s : Γ(F, U)), s ∈ P.toSubmodule.obj (op U) →
      (F.presheaf.germ U x hxU).hom s ∈ S := by
    intro U hxU s hs
    have hg : (P.asModules.presheaf.germ U x hxU).hom ⟨s, hs⟩ ∈
        S.comap (Stacks.ModuleStalk.map P.ιModules x) := by
      refine mem_of_mem_span_ringStalk _ ?_ ((hspan x (Opens.mem_top x)).ge Submodule.mem_top)
      rintro - ⟨j, rfl⟩
      rw [SetLike.mem_coe, Submodule.mem_comap, Stacks.ModuleStalk.map_apply,
        Stacks.ModuleStalk.mapFun_Γgerm]
      exact Submodule.subset_span ⟨⟨_, restrictionMap_app_ιModules_eq_zero I F (t j)⟩, rfl⟩
    rw [Submodule.mem_comap, Stacks.ModuleStalk.map_apply,
      Stacks.ModuleStalk.mapFun_germ P.ιModules x U hxU ⟨s, hs⟩] at hg
    exact hg
  obtain ⟨_, ⟨U₀, hU₀, rfl⟩, hxU₀, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  have hcolon : IsLocalRing.maximalIdeal (X.presheaf.stalk x) ≤ S.colon Set.univ := by
    rw [← hI, IdealSheafData.stalk_eq_map_germ I x ⟨U₀, hU₀⟩ hxU₀, Ideal.map_le_iff_le_comap]
    intro b hb
    rw [Ideal.mem_comap, Submodule.mem_colon]
    intro w _
    obtain ⟨V, hxV, w₀, hw₀⟩ := F.presheaf.exists_germ_eq w
    obtain ⟨_, ⟨U, hU, rfl⟩, hxU, hUV⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open
        (show x ∈ ((U₀ ⊓ V : X.Opens) : Set X) from ⟨hxU₀, hxV⟩) (U₀ ⊓ V).isOpen
    have hUU₀ : U ≤ U₀ := fun y hy => (hUV hy).1
    have hUV' : U ≤ V := fun y hy => (hUV hy).2
    have hb' : (X.presheaf.map (homOfLE hUU₀).op).hom b ∈ I.ideal ⟨U, hU⟩ :=
      I.ideal_le_comap_ideal (U := ⟨U, hU⟩) (V := ⟨U₀, hU₀⟩) hUU₀ hb
    have hs : (X.presheaf.map (homOfLE hUU₀).op).hom b • (F.presheaf.map (homOfLE hUV').op).hom w₀
        ∈ P.toSubmodule.obj (op U) :=
      (Stacks.Algebraization.idealPowerMultiple_le_iff I 1 F P).mp le_rfl ⟨U, hU⟩
        (Submodule.smul_mem_smul (by rwa [pow_one]) Submodule.mem_top)
    have h := hPS U hxU _ hs
    rwa [Stacks.ModuleStalk.germ_smul, TopCat.Presheaf.germ_res_apply,
      TopCat.Presheaf.germ_res_apply, hw₀] at h
  rw [Stacks.ModuleStalk.maximalSmul, Submodule.smul_le]
  intro r hr w _
  exact Submodule.mem_colon.mp (hcolon hr) w (Set.mem_univ w)

section OverField

/-- **The germs at `x` of the sections of `ℒ ^⊗ n` vanishing on `V(I)` span `𝔪_x ℒ^{⊗ n}_x`
for all `n ≫ 0`**, when `X` is proper over a field, `ℒ` is ample and `I_x = 𝔪_x`. -/
theorem exists_bound_span_germ_vanishingSections_eq_maximalSmul (k : Type u) [Field k]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) [IsProper f] (L : X.Modules) [IsInvertibleModule X L]
    (hL : IsAmple X L) (I : X.IdealSheafData) (x : X)
    (hI : IdealSheafData.stalk I x = IsLocalRing.maximalIdeal (X.presheaf.stalk x)) :
    ∃ n₀ : ℤ, ∀ n : ℤ, n₀ ≤ n →
      Submodule.span (X.presheaf.stalk x)
        (Set.range fun v : vanishingSections k f I L n =>
          ((tensorPowModule X L n).presheaf.Γgerm x).hom
            ((v : Stacks.Bertini.globalSections k f (tensorPowModule X L n)) :
              Γ(tensorPowModule X L n, ⊤))) =
      Stacks.ModuleStalk.maximalSmul (tensorPowModule X L n) x := by
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  obtain ⟨n₀, hn₀⟩ := exists_isFinGen_idealPowerMultiple_tensorPowModule I L hL
  refine ⟨n₀, fun n hn => le_antisymm ?_ (maximalSmul_le_span_of_isFinGen k f I L n x hI
    (hn₀ n hn))⟩
  rw [Submodule.span_le]
  rintro - ⟨v, rfl⟩
  exact Γgerm_mem_maximalSmul_of_mem_vanishingSections k f I L n x
    ((IdealSheafData.stalk_le_maximalIdeal_iff_mem_support I x).mp hI.le) v

end OverField

end Stacks.SectionsVanishingOnSubscheme

end
