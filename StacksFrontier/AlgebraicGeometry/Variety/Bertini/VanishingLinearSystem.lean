/-! ### The restriction map to a closed subscheme -/

section General

variable (k : Type u) [CommRing k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))

/-- **Restriction of global sections to the closed subscheme cut out by `I`**, as a `k`-linear
map `Γ(X, F) ⟶ Γ(Z, F|_Z)` for `Z = V(I)` with the `k`-scheme structure it inherits from `X`. -/
def restrictionMap (I : X.IdealSheafData) (F : X.Modules) :
    Stacks.Bertini.globalSections k f F →ₗ[k]
      Stacks.Bertini.globalSections k (I.subschemeι ≫ f)
        ((Scheme.Modules.pullback I.subschemeι).obj F) where
  toFun s := pullbackGlobalSections I.subschemeι F s
  map_add' s t :=
    map_add (ConcreteCategory.hom (pullbackGlobalSections I.subschemeι F)) s t
  map_smul' _ s :=
    AlgebraicGeometry.SectionsEqualizer.pullbackGlobalSections_smul I.subschemeι F _ s

/-- **The linear system `V_n` of [Stacks, Tag 0FD5]**: the global sections of `ℒ ^⊗ n` which
vanish on the closed subscheme cut out by `I`, as a `k`-subspace of `Γ(X, ℒ ^⊗ n)`.

The whole of [Stacks, Tag 0FD5] is
`Stacks.SectionsVanishingOnSubscheme.exists_bound_generatesOffSupport_and_isImmersion`. -/
def vanishingSections (I : X.IdealSheafData) (L : X.Modules)
    [IsInvertibleModule X L] (n : ℤ) :
    Submodule k (Stacks.Bertini.globalSections k f (tensorPowModule X L n)) :=
  LinearMap.ker (restrictionMap k f I (tensorPowModule X L n))

/-- A global section of `ℒ ^⊗ n` lies in `V_n` exactly when it restricts to zero on the closed
subscheme cut out by `I`. -/
theorem mem_vanishingSections_iff (I : X.IdealSheafData) (L : X.Modules)
    [IsInvertibleModule X L] (n : ℤ)
    (s : Stacks.Bertini.globalSections k f (tensorPowModule X L n)) :
    s ∈ vanishingSections k f I L n ↔
      pullbackGlobalSections I.subschemeι (tensorPowModule X L n) s = 0 :=
  Iff.rfl

/-- **The projective space `P(V_n)`**, the target of the canonical morphism the source attaches
to the linear system `V_n`: it is `Proj (Sym_k V_n)`, a scheme over `Spec k`. -/
abbrev projectiveSpaceOfVanishingSections (I : X.IdealSheafData) (L : X.Modules)
    [IsInvertibleModule X L] (n : ℤ) : Scheme.{u} :=
  projectiveSpaceOfModule k (vanishingSections k f I L n)

/-! ### Generation off the closed subscheme -/

/-- **The generation conclusion of [Stacks, Tag 0FD5] at one degree**: the sections vanishing on
the closed subscheme cut out by `I` generate `ℒ ^⊗ n` at every point of the open complement,
i.e. their germs span each such stalk. -/
def GeneratesOffSupport (I : X.IdealSheafData) (L : X.Modules) [IsInvertibleModule X L] (n : ℤ) :
    Prop :=
  ∀ x ∈ I.support.compl,
    Submodule.span (R := (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat))
      (Set.range fun s : vanishingSections k f I L n =>
        ((tensorPowModule X L n).presheaf.Γgerm x).hom
          (s : Stacks.Bertini.globalSections k f (tensorPowModule X L n))) = ⊤

/-! ### Sections of the twisted ideal vanish on the subscheme -/

/-- The inclusion `I F ⟶ F` of the subsheaf generated by the products of sections of `I` with
sections of `F` becomes zero after restriction to the closed subscheme cut out by `I`. -/
theorem pullback_map_ιModules_eq_zero (I : X.IdealSheafData) (F : X.Modules) :
    (Scheme.Modules.pullback I.subschemeι).map
        (Stacks.Algebraization.idealPowerMultiple I 1 F).ιModules = 0 := by
  have h := Stacks.Algebraization.pullback_map_idealPowerMultiple_ι_eq_zero I 1 F
  rw [pow_one I] at h
  exact h

/-- **A global section of the subsheaf `I F` of `F` vanishes on the closed subscheme cut out by
`I`.** At `F = ℒ ^⊗ n` this is the inclusion `Γ(X, I ℒ ^⊗ n) ⊆ V_n`. -/
theorem restrictionMap_app_ιModules_eq_zero (I : X.IdealSheafData) (F : X.Modules)
    (t : Γ((Stacks.Algebraization.idealPowerMultiple I 1 F).asModules, ⊤)) :
    pullbackGlobalSections I.subschemeι F
        ((Stacks.Algebraization.idealPowerMultiple I 1 F).ιModules.app ⊤ t) = 0 := by
  have h := ConcreteCategory.congr_hom
    (Stacks.AlgebraicGeometry.IdealOfClosedSubscheme.pullbackGlobalSections_naturality_app
      I.subschemeι
      (Stacks.Algebraization.idealPowerMultiple I 1 F).ιModules) t
  rw [pullback_map_ιModules_eq_zero I F] at h
  simpa using h.symm

/-! ### The inclusion of the twisted ideal off the subscheme -/

/-- **Off the support of `I` the inclusion `I F ⟶ F` is surjective on stalks.** Every germ is
represented by a section over an affine open disjoint from the support, and on such an open the
subsheaf is all of `F`. -/
theorem surjStalk_ιModules (I : X.IdealSheafData) (F : X.Modules) {x : X}
    (hx : x ∈ I.support.compl) :
    Stacks.SectionProduct.SurjStalk
      (Stacks.Algebraization.idealPowerMultiple I 1 F).ιModules x := by
  intro z
  obtain ⟨U, hxU, w, hw⟩ := F.presheaf.exists_germ_eq z
  obtain ⟨-, ⟨V, hVaff, rfl⟩, hxV, hVU⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open
      (show x ∈ ((U ⊓ I.support.compl : X.Opens) : Set X) from ⟨hxU, hx⟩)
      (U ⊓ I.support.compl).isOpen
  have hVle : (V : X.Opens) ≤ U ⊓ I.support.compl := hVU
  have htop : (Stacks.Algebraization.idealPowerMultiple I 1 F).obj (op V) = ⊤ :=
    Stacks.Algebraization.idealPowerMultiple_obj_eq_top_of_le_compl_support I 1 F ⟨V, hVaff⟩
      (hVle.trans inf_le_right)
  set wV : Γ(F, V) := F.presheaf.map (homOfLE (hVle.trans inf_le_left)).op w with hwV
  have hmem : wV ∈ (Stacks.Algebraization.idealPowerMultiple I 1 F).obj (op V) := by
    rw [htop]; trivial
  refine ⟨((Stacks.Algebraization.idealPowerMultiple I 1 F).asModules.presheaf.germ V x hxV).hom
    ⟨wV, hmem⟩, ?_⟩
  rw [Stacks.ModuleStalk.mapFun_germ
    (Stacks.Algebraization.idealPowerMultiple I 1 F).ιModules x V hxV ⟨wV, hmem⟩]
  have happ : (Stacks.Algebraization.idealPowerMultiple I 1 F).ιModules.app V ⟨wV, hmem⟩ = wV :=
    rfl
  rw [happ, hwV, TopCat.Presheaf.germ_res_apply]
  exact hw

/-! ### Generation from global generation of the twisted ideal -/

/-- **The second step of the proof of [Stacks, Tag 0FD5]**: if the subsheaf `I ℒ ^⊗ n` of
`ℒ ^⊗ n` is generated by finitely many global sections, then the sections of `ℒ ^⊗ n` vanishing
on the closed subscheme cut out by `I` generate `ℒ ^⊗ n` off that subscheme. -/
theorem generatesOffSupport_of_isFinGen (I : X.IdealSheafData) (L : X.Modules)
    [IsInvertibleModule X L] (n : ℤ)
    (hgen : IsFinGen
      (Stacks.Algebraization.idealPowerMultiple I 1 (tensorPowModule X L n)).asModules) :
    GeneratesOffSupport k f I L n := by
  obtain ⟨J, t, hJ, hspan⟩ :=
    Stacks.AmpleLocalGeneration.isFinGenOn_of_isFinGen hgen ⊤
  intro x hx
  have hmem : ∀ j : J,
      (Stacks.Algebraization.idealPowerMultiple I 1 (tensorPowModule X L n)).ιModules.app ⊤
        (t j) ∈ vanishingSections k f I L n := fun j =>
    restrictionMap_app_ιModules_eq_zero I (tensorPowModule X L n) (t j)
  have hbig := Stacks.SectionTensorFormula.span_transport
    (Stacks.Algebraization.idealPowerMultiple I 1 (tensorPowModule X L n)).ιModules
    (surjStalk_ιModules I (tensorPowModule X L n) hx) ⊤ (Opens.mem_top x) t
    (hspan x (Opens.mem_top x))
  refine le_antisymm le_top ?_
  rw [← hbig]
  refine Submodule.span_mono ?_
  rintro - ⟨j, rfl⟩
  exact ⟨⟨_, hmem j⟩, rfl⟩

/-! ### The ample input -/

/-- **For every sufficiently positive `n` the subsheaf `I ℒ ^⊗ n` of `ℒ ^⊗ n` is generated by
finitely many global sections.** This is clause (7) of [Stacks, Tag 01Q3] applied to the
quasi-coherent ideal sheaf `I`, of finite type because `X` is locally Noetherian, followed by the
surjection `I ⊗ ℒ ^⊗ n ⟶ I ℒ ^⊗ n`. -/
theorem exists_isFinGen_idealPowerMultiple_tensorPowModule [IsLocallyNoetherian X]
    (I : X.IdealSheafData) (L : X.Modules) [IsInvertibleModule X L] (hL : IsAmple X L) :
    ∃ n₀ : ℤ, ∀ n : ℤ, n₀ ≤ n →
      IsFinGen
        (Stacks.Algebraization.idealPowerMultiple I 1 (tensorPowModule X L n)).asModules := by
  have : (structureModule X).IsQuasicoherent :=
    Stacks.AlgebraicGeometry.AffineQcohPushforward.isQuasicoherent_unit X
  have hqc : (idealPow I 1).IsQuasicoherent := inferInstance
  have hft : SheafOfModules.IsFiniteType.{u, u, u} (idealPow I 1) :=
    Stacks.AlgebraicGeometry.FiniteTypeBridge.isFiniteType_idealPow I 1
      fun V => Scheme.IdealSheafData.isFiniteType_of_isLocallyNoetherian I V
  obtain ⟨n₀, hn₀⟩ :=
    Stacks.AmpleLocalGeneration.isEventuallyGloballyGenerated_of_isAmple L hL
      (idealPow I 1) hqc hft
  refine ⟨n₀, fun n hn => ?_⟩
  obtain ⟨σ, hσ⟩ := hn₀ n hn
  have h1 : IsFinGen (idealPow I 1 ⊗ tensorPowModule X L n) := ⟨σ, hσ⟩
  have h2 : IsFinGen
      (Stacks.RelativeVeryAmple.tensorModules X (idealPow I 1) (tensorPowModule X L n)) :=
    h1.of_iso (Stacks.AmplePullbackPart1.tensorIsoTensorModules X _ _)
  have : (tensorPowModule X L n).IsQuasicoherent :=
    Stacks.AmpleGlobalGeneration.isQuasicoherent_of_isInvertibleModule _
  exact h2.of_epi (idealPowTensorToSmul I 1 (tensorPowModule X L n))
    (epi_idealPowTensorToSmul I 1 (tensorPowModule X L n))

end General

section OverField

variable (k : Type u) [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))

/-! ### The generation half of Stacks Tag 0FD5 -/

/-- **The generation conclusion of [Stacks, Tag 0FD5].** Let `X` be a proper scheme over a field
`k`, let `ℒ` be an ample invertible `𝒪_X`-module and let `Z ⊂ X` be the closed subscheme cut out
by a quasi-coherent sheaf of ideals `I`. Then there is an `n₀` such that for every `n ≥ n₀` the
kernel `V_n` of `Γ(X, ℒ ^⊗ n) ⟶ Γ(Z, ℒ ^⊗ n|_Z)` generates `ℒ ^⊗ n` on `X ∖ Z`.

This is the generation half of the tag; the whole of [Stacks, Tag 0FD5], generation together with
the immersion, is
`Stacks.SectionsVanishingOnSubscheme.exists_bound_generatesOffSupport_and_isImmersion`. -/
theorem exists_bound_generatesOffSupport [IsProper f] (I : X.IdealSheafData) (L : X.Modules)
    [IsInvertibleModule X L] (hL : IsAmple X L) :
    ∃ n₀ : ℤ, ∀ n : ℤ, n₀ ≤ n → GeneratesOffSupport k f I L n := by
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  obtain ⟨n₀, hn₀⟩ := exists_isFinGen_idealPowerMultiple_tensorPowModule I L hL
  exact ⟨n₀, fun n hn => generatesOffSupport_of_isFinGen k f I L n (hn₀ n hn)⟩

end OverField

/-! ### Glueing the chart morphisms of Stacks Tag 01NE -/

section Glue

variable {Y : Scheme.{u}} {N : ℕ}

open Stacks.SectionsToProjectiveSpace

/-- The composite of two morphisms on global sections, applied to a section. -/
theorem appTop_appTop {A B C : Scheme.{u}} (g : A ⟶ B) (g' : B ⟶ C) (a : Γ(C, ⊤)) :
    g.appTop (g'.appTop a) = (g ≫ g').appTop a :=
  (CategoryTheory.ConcreteCategory.congr_hom (Scheme.Hom.comp_appTop g g') a).symm

/-- **The glueing step of [Stacks, Tag 01NE] as data.** Given a cover of `Y` by opens `V i`, on
each of which a family `t i` of sections of `𝒪_Y` spans the unit ideal, and a unit on each overlap
by which the two families differ, this is the morphism `Y ⟶ ℙᴺ_ℤ` restricting on each chart to the
morphism of that family. -/
def homOfCover (V : Fin (N + 1) → Y.Opens) (hV : IsOpenCover V)
    (t : ∀ i, Fin (N + 1) → Γ((V i).toScheme, ⊤))
    (ht : ∀ i, Ideal.span (Set.range (t i)) = ⊤)
    (w : ∀ i j, Γ((V i ⊓ V j : Y.Opens).toScheme, ⊤)ˣ)
    (hw : ∀ i j k, resOfLE (inf_le_left : V i ⊓ V j ≤ V i) (t i k) =
      (w i j : Γ((V i ⊓ V j : Y.Opens).toScheme, ⊤)) *
        resOfLE (inf_le_right : V i ⊓ V j ≤ V j) (t j k)) :
    Y ⟶ projectiveSpaceAtUniverse.{u} N :=
  (Y.openCoverOfIsOpenCover V hV).glueMorphisms
    (fun i => toProjectiveSpaceAtUniverse (t i) (ht i)) <| by
      have key : ∀ i j, Y.homOfLE (inf_le_left : V i ⊓ V j ≤ V i) ≫
          toProjectiveSpaceAtUniverse (t i) (ht i) =
            Y.homOfLE (inf_le_right : V i ⊓ V j ≤ V j) ≫
              toProjectiveSpaceAtUniverse (t j) (ht j) := by
        intro i j
        rw [Stacks.ProjGlobalSectionsAppTop.hasPullbackNaturality
            (Y.homOfLE (inf_le_left : V i ⊓ V j ≤ V i)) (t i) (ht i)
            (span_range_comp _ _ (ht i)),
          Stacks.ProjGlobalSectionsAppTop.hasPullbackNaturality
            (Y.homOfLE (inf_le_right : V i ⊓ V j ≤ V j)) (t j) (ht j)
            (span_range_comp _ _ (ht j))]
        have hfun : (fun k => (Y.homOfLE (inf_le_left : V i ⊓ V j ≤ V i)).appTop (t i k)) =
            fun k => (w i j : Γ((V i ⊓ V j : Y.Opens).toScheme, ⊤)) *
              (Y.homOfLE (inf_le_right : V i ⊓ V j ≤ V j)).appTop (t j k) := funext (hw i j)
        exact (toProjectiveSpaceAtUniverse_congr hfun _ _).trans
          (Stacks.ProjGlobalSectionsAppTop.hasUnitInvariance (w i j)
            (fun k => (Y.homOfLE (inf_le_right : V i ⊓ V j ≤ V j)).appTop (t j k))
            (span_range_comp _ _ (ht j))
            (by rw [span_range_unit_smul]; exact span_range_comp _ _ (ht j)))
      intro i j
      change pullback.fst (V i).ι (V j).ι ≫ toProjectiveSpaceAtUniverse (t i) (ht i) =
        pullback.snd (V i).ι (V j).ι ≫ toProjectiveSpaceAtUniverse (t j) (ht j)
      rw [← cancel_epi (isPullback_opens_inf (V i) (V j)).isoPullback.hom, ← Category.assoc,
        ← Category.assoc, (isPullback_opens_inf (V i) (V j)).isoPullback_hom_fst,
        (isPullback_opens_inf (V i) (V j)).isoPullback_hom_snd]
      exact key i j

/-- The glued morphism restricts on the `i`-th chart to the morphism of the `i`-th family. This is
what pins it down. -/
theorem ι_homOfCover (V : Fin (N + 1) → Y.Opens) (hV : IsOpenCover V)
    (t : ∀ i, Fin (N + 1) → Γ((V i).toScheme, ⊤))
    (ht : ∀ i, Ideal.span (Set.range (t i)) = ⊤)
    (w : ∀ i j, Γ((V i ⊓ V j : Y.Opens).toScheme, ⊤)ˣ)
    (hw : ∀ i j k, resOfLE (inf_le_left : V i ⊓ V j ≤ V i) (t i k) =
      (w i j : Γ((V i ⊓ V j : Y.Opens).toScheme, ⊤)) *
        resOfLE (inf_le_right : V i ⊓ V j ≤ V j) (t j k)) (i : Fin (N + 1)) :
    (V i).ι ≫ homOfCover V hV t ht w hw = toProjectiveSpaceAtUniverse (t i) (ht i) :=
  (Y.openCoverOfIsOpenCover V hV).ι_glueMorphisms _ _ i

end Glue

/-! ### The charts of a family of sections over an open subscheme -/

section Charts

open Stacks.ProjectiveFromSections Stacks.SectionsToProjectiveSpace

variable {X : Scheme.{u}} {L : X.Modules} [IsInvertibleModule X L] {N : ℕ}

/-- The comparison morphism `V ⟶ W` of open subschemes attached to an open `V` of an open
subscheme `U` of `X` whose points land in an open `W` of `X`. -/
def liftOpen (U : X.Opens) (V : U.toScheme.Opens) (W : X.Opens)
    (h : ∀ x : V, (U.ι (x : U.toScheme) : X) ∈ W) : V.toScheme ⟶ W.toScheme :=
  IsOpenImmersion.lift W.ι (V.ι ≫ U.ι) <| by
    rw [Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp, Scheme.Opens.range_ι,
      Scheme.Opens.range_ι]
    exact (Set.image_subset_iff).2 fun x hx => h ⟨x, hx⟩

/-- The comparison morphism `liftOpen U V W h` followed by the inclusion of `W` is the inclusion
of `V` followed by the inclusion of `U`. -/
@[simp] theorem liftOpen_ι (U : X.Opens) (V : U.toScheme.Opens) (W : X.Opens)
    (h : ∀ x : V, (U.ι (x : U.toScheme) : X) ∈ W) :
    liftOpen U V W h ≫ W.ι = V.ι ≫ U.ι :=
  IsOpenImmersion.lift_fac _ _ _

/-- Two morphisms of open subschemes with the same composite into `X` are equal, because the
inclusion of an open subscheme is a monomorphism. -/
theorem hom_ext_opens {U : X.Opens} {V : U.toScheme.Opens} {W : X.Opens}
    {g g' : V.toScheme ⟶ W.toScheme} (hg : g ≫ W.ι = V.ι ≫ U.ι)
    (hg' : g' ≫ W.ι = V.ι ≫ U.ι) : g = g' := by
  rw [← cancel_mono W.ι, hg, hg']

variable (s : Fin (N + 1) → Γ(L, ⊤)) (U : X.Opens)

/-- The `i`-th chart of `U`: the part of `U` on which `sᵢ` does not vanish, as an open of the open
subscheme `U`. -/
abbrev chartOpen (i : Fin (N + 1)) : U.toScheme.Opens := U.ι ⁻¹ᵁ nvCover s i

/-- The comparison morphism from the `i`-th chart of `U` to the nonvanishing open `X_{sᵢ}`. -/
def chartMap (i : Fin (N + 1)) : (chartOpen s U i).toScheme ⟶ (nvCover s i).toScheme :=
  liftOpen U (chartOpen s U i) (nvCover s i) fun x =>
    show (U.ι (x : U.toScheme) : X) ∈ nvCover s i from x.2

/-- The comparison morphism from the `i`-th chart of `U` followed by the inclusion of `X_{sᵢ}` is
the inclusion of the chart into `U` followed by the inclusion of `U`. -/
theorem chartMap_ι (i : Fin (N + 1)) :
    chartMap s U i ≫ (nvCover s i).ι = (chartOpen s U i).ι ≫ U.ι :=
  liftOpen_ι _ _ _ _

/-- The ratios `s_k / sᵢ`, read as sections of the structure sheaf of the `i`-th chart of `U`.
This is the family the morphism to projective space is built from on that chart. -/
def chartSection (i k : Fin (N + 1)) : Γ((chartOpen s U i).toScheme, ⊤) :=
  (chartMap s U i).appTop (chartRatio s i k)

/-- The ratios out of `sᵢ` span the unit ideal on the `i`-th chart, because `sᵢ / sᵢ = 1`. -/
theorem span_range_chartSection (i : Fin (N + 1)) :
    Ideal.span (Set.range (chartSection s U i)) = ⊤ := by
  rw [Ideal.eq_top_iff_one]
  have h1 : chartSection s U i i = 1 := by
    rw [chartSection, chartRatio_self]; exact map_one _
  rw [← h1]
  exact Ideal.subset_span ⟨i, rfl⟩

/-- The comparison morphism from an overlap of two charts of `U` to the corresponding overlap of
nonvanishing opens. -/
def chartMapInf (i j : Fin (N + 1)) :
    (chartOpen s U i ⊓ chartOpen s U j : U.toScheme.Opens).toScheme ⟶
      (nvCover s i ⊓ nvCover s j : X.Opens).toScheme :=
  liftOpen U _ _ fun x =>
    show (U.ι (x : U.toScheme) : X) ∈ (nvCover s i ⊓ nvCover s j : X.Opens) from ⟨x.2.1, x.2.2⟩

/-- The comparison morphism from the overlap of the `i`-th and `j`-th charts of `U` followed by
the inclusion of `X_{sᵢ} ⊓ X_{sⱼ}` is the inclusion of the overlap into `U` followed by the
inclusion of `U`. -/
theorem chartMapInf_ι (i j : Fin (N + 1)) :
    chartMapInf s U i j ≫ (nvCover s i ⊓ nvCover s j : X.Opens).ι =
      (chartOpen s U i ⊓ chartOpen s U j : U.toScheme.Opens).ι ≫ U.ι :=
  liftOpen_ι _ _ _ _

/-- Restricting a chart to an overlap and comparing is comparing and then restricting. -/
private theorem homOfLE_chartMap_of_le (i j a : Fin (N + 1))
    (h : chartOpen s U i ⊓ chartOpen s U j ≤ chartOpen s U a)
    (h' : nvCover s i ⊓ nvCover s j ≤ nvCover s a) :
    U.toScheme.homOfLE h ≫ chartMap s U a = chartMapInf s U i j ≫ X.homOfLE h' := by
  refine hom_ext_opens ?_ ?_
  · rw [Category.assoc, chartMap_ι, ← Category.assoc, Scheme.homOfLE_ι]
  · rw [Category.assoc, Scheme.homOfLE_ι, chartMapInf_ι]

/-- Restricting the `i`-th chart to an overlap and comparing is comparing and then restricting. -/
theorem homOfLE_chartMap_left (i j : Fin (N + 1)) :
    U.toScheme.homOfLE (inf_le_left : chartOpen s U i ⊓ chartOpen s U j ≤ chartOpen s U i) ≫
        chartMap s U i =
      chartMapInf s U i j ≫
        X.homOfLE (inf_le_left : nvCover s i ⊓ nvCover s j ≤ nvCover s i) :=
  homOfLE_chartMap_of_le s U i j i _ _

/-- `homOfLE_chartMap_left` for the second chart. -/
theorem homOfLE_chartMap_right (i j : Fin (N + 1)) :
    U.toScheme.homOfLE (inf_le_right : chartOpen s U i ⊓ chartOpen s U j ≤ chartOpen s U j) ≫
        chartMap s U j =
      chartMapInf s U i j ≫
        X.homOfLE (inf_le_right : nvCover s i ⊓ nvCover s j ≤ nvCover s j) :=
  homOfLE_chartMap_of_le s U i j j _ _

/-- The transition unit `sⱼ / sᵢ` on an overlap of two charts of `U`. -/
def chartUnit (i j : Fin (N + 1)) :
    Γ((chartOpen s U i ⊓ chartOpen s U j : U.toScheme.Opens).toScheme, ⊤)ˣ where
  val := (chartMapInf s U i j).appTop (chartTransUnit s i j).val
  inv := (chartMapInf s U i j).appTop (chartTransUnit s i j).inv
  val_inv := by rw [← map_mul, (chartTransUnit s i j).val_inv]; exact map_one _
  inv_val := by rw [← map_mul, (chartTransUnit s i j).inv_val]; exact map_one _

/-- The restriction of a chart family to an overlap is the comparison of the restricted ratio. -/
private theorem resOfLE_chartSection_of_le (i j a k : Fin (N + 1))
    (h : chartOpen s U i ⊓ chartOpen s U j ≤ chartOpen s U a)
    (h' : nvCover s i ⊓ nvCover s j ≤ nvCover s a) :
    resOfLE h (chartSection s U a k) =
      (chartMapInf s U i j).appTop (resOfLE h' (chartRatio s a k)) := by
  change (U.toScheme.homOfLE _).appTop ((chartMap s U a).appTop (chartRatio s a k)) = _
  rw [appTop_appTop, homOfLE_chartMap_of_le s U i j a h h']
  exact (appTop_appTop _ _ _).symm

/-- The restriction of the `i`-th chart family to an overlap is the comparison of the restricted
ratio. -/
theorem resOfLE_chartSection_left (i j k : Fin (N + 1)) :
    resOfLE (inf_le_left : chartOpen s U i ⊓ chartOpen s U j ≤ chartOpen s U i)
        (chartSection s U i k) =
      (chartMapInf s U i j).appTop
        (resOfLE (inf_le_left : nvCover s i ⊓ nvCover s j ≤ nvCover s i) (chartRatio s i k)) :=
  resOfLE_chartSection_of_le s U i j i k _ _

/-- `resOfLE_chartSection_left` for the second chart. -/
theorem resOfLE_chartSection_right (i j k : Fin (N + 1)) :
    resOfLE (inf_le_right : chartOpen s U i ⊓ chartOpen s U j ≤ chartOpen s U j)
        (chartSection s U j k) =
      (chartMapInf s U i j).appTop
        (resOfLE (inf_le_right : nvCover s i ⊓ nvCover s j ≤ nvCover s j)
          (chartRatio s j k)) :=
  resOfLE_chartSection_of_le s U i j j k _ _

/-- **The two chart families of `U` differ by the transition unit on the overlap.** This is the
cocycle identity of the ratios, transported to the charts of the open subscheme. -/
theorem chartSection_agree (i j k : Fin (N + 1)) :
    resOfLE (inf_le_left : chartOpen s U i ⊓ chartOpen s U j ≤ chartOpen s U i)
        (chartSection s U i k) =
      (chartUnit s U i j :
          Γ((chartOpen s U i ⊓ chartOpen s U j : U.toScheme.Opens).toScheme, ⊤)) *
        resOfLE (inf_le_right : chartOpen s U i ⊓ chartOpen s U j ≤ chartOpen s U j)
          (chartSection s U j k) := by
  rw [resOfLE_chartSection_left s U i j k, resOfLE_chartSection_right s U i j k,
    chartRatio_agree, map_mul]
  rfl

/-- **The charts cover the open subscheme** as soon as at each of its points one of the `sᵢ` does
not vanish. -/
theorem isOpenCover_chartOpen (hU : ∀ x ∈ U, ∃ i, x ∈ nvCover s i) :
    IsOpenCover (chartOpen s U) := by
  refine eq_top_iff.2 fun x _ => ?_
  obtain ⟨i, hi⟩ := hU (U.ι x) x.2
  exact TopologicalSpace.Opens.mem_iSup.2 ⟨i, hi⟩

end Charts

/-! ### The linear system read through a basis -/

section Basis

variable (k : Type u) [CommRing k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
  {I : X.IdealSheafData} {L : X.Modules} [IsInvertibleModule X L] {m : ℤ} {N : ℕ}

/-- `X ∖ Z`, the open complement of the closed subscheme cut out by `I`. -/
abbrev openComplement (I : X.IdealSheafData) : X.Opens := I.support.compl

/-- The `k`-subspace of `V_n` consisting of the sections whose germ at `x` lies in a given
submodule of the stalk of `ℒ ^⊗ n`. -/
def germSubmodule (x : X)
    (S : Submodule (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat)
      (TopCat.Presheaf.stalk (C := Ab.{u}) (tensorPowModule X L m).presheaf x)) :
    Submodule k (vanishingSections k f I L m) where
  carrier := {t | ((tensorPowModule X L m).presheaf.Γgerm x).hom
    (t : Stacks.Bertini.globalSections k f (tensorPowModule X L m)) ∈ S}
  add_mem' {a c} ha hc :=
    (fun (u v : Γ(tensorPowModule X L m, ⊤))
        (hu : ((tensorPowModule X L m).presheaf.Γgerm x).hom u ∈ S)
        (hv : ((tensorPowModule X L m).presheaf.Γgerm x).hom v ∈ S) =>
      Eq.mpr (congrArg (· ∈ S) (map_add ((tensorPowModule X L m).presheaf.Γgerm x).hom u v))
        (S.add_mem hu hv))
      (a : Stacks.Bertini.globalSections k f (tensorPowModule X L m))
      (c : Stacks.Bertini.globalSections k f (tensorPowModule X L m)) ha hc
  zero_mem' :=
    Eq.mpr (congrArg (· ∈ S) (map_zero ((tensorPowModule X L m).presheaf.Γgerm x).hom))
      S.zero_mem
  smul_mem' c t ht :=
    (fun (a : Γ(X, ⊤)) (u : Γ(tensorPowModule X L m, ⊤))
        (hu : ((tensorPowModule X L m).presheaf.Γgerm x).hom u ∈ S) =>
      mem_of_Γgerm_smul (tensorPowModule X L m) x a u S hu)
      (Stacks.Bertini.baseRingHom k f c)
      (t : Stacks.Bertini.globalSections k f (tensorPowModule X L m)) ht

/-- **A submodule of the stalk containing the germs of a basis of `V_n` contains the germ of every
member of `V_n`.** The germs of a basis therefore span exactly as much of the stalk as the germs
of the whole linear system. -/
theorem Γgerm_mem_of_basis (b : Module.Basis (Fin N) k (vanishingSections k f I L m)) (x : X)
    (S : Submodule (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat)
      (TopCat.Presheaf.stalk (C := Ab.{u}) (tensorPowModule X L m).presheaf x))
    (hb : ∀ i, ((tensorPowModule X L m).presheaf.Γgerm x).hom
      ((b i : Stacks.Bertini.globalSections k f (tensorPowModule X L m))) ∈ S)
    (t : vanishingSections k f I L m) :
    ((tensorPowModule X L m).presheaf.Γgerm x).hom
      (t : Stacks.Bertini.globalSections k f (tensorPowModule X L m)) ∈ S := by
  have hle : (⊤ : Submodule k (vanishingSections k f I L m)) ≤ germSubmodule k f x S := by
    rw [← b.span_eq, Submodule.span_le]
    rintro - ⟨i, rfl⟩
    exact hb i
  exact hle Submodule.mem_top

/-- A member of a basis of `V_n`, read as a global section of `ℒ ^⊗ n`. -/
def basisSection (b : Module.Basis (Fin (N + 1)) k (vanishingSections k f I L m))
    (i : Fin (N + 1)) : Γ(tensorPowModule X L m, ⊤) :=
  (b i : Stacks.Bertini.globalSections k f (tensorPowModule X L m))

/-- **If `V_n` generates `ℒ ^⊗ n` off the closed subscheme then so does any basis of `V_n`**: the
germ of a `k`-linear combination lies in the span of the germs of the basis, because the scalars
act through the structure sheaf. -/
theorem span_range_basisSection_eq_top
    (b : Module.Basis (Fin (N + 1)) k (vanishingSections k f I L m))
    (h : GeneratesOffSupport k f I L m) {x : X} (hx : x ∈ openComplement I) :
    Submodule.span (R := (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat))
        (Set.range fun i => ((tensorPowModule X L m).presheaf.Γgerm x).hom
          (basisSection k f b i)) = ⊤ :=
  eq_top_iff.2 ((h x hx).ge.trans (Submodule.span_le.2 (by
    rintro - ⟨t, rfl⟩
    exact Γgerm_mem_of_basis k f b x
      (Submodule.span (R := (TopCat.Presheaf.stalk X.ringCatSheaf.obj x : RingCat))
        (Set.range fun i => ((tensorPowModule X L m).presheaf.Γgerm x).hom
          (basisSection k f b i)))
      (fun i => Submodule.subset_span ⟨i, rfl⟩) t)))

/-- At every point off the closed subscheme some member of a basis of `V_n` does not vanish. -/
theorem exists_mem_nvCover_basisSection
    (b : Module.Basis (Fin (N + 1)) k (vanishingSections k f I L m))
    (h : GeneratesOffSupport k f I L m) {x : X} (hx : x ∈ openComplement I) :
    ∃ i, x ∈ Stacks.ProjectiveFromSections.nvCover (basisSection k f b) i :=
  exists_mem_nvOpen_of_span_eq_top (tensorPowModule X L m) _ x
    (span_range_basisSection_eq_top k f b h hx)

end Basis

/-! ### The morphism to the projective space of the linear system -/

section Morphism

open Stacks.ProjectiveFromSections Stacks.SectionsToProjectiveSpace

variable (k : Type u) [CommRing k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
  {I : X.IdealSheafData} {L : X.Modules} [IsInvertibleModule X L] {m : ℤ} {N : ℕ}

/-- **The morphism `X ∖ Z ⟶ ℙᴺ_ℤ` attached to a basis of the linear system `V_n`**: the morphism
of [Stacks, Tag 01NE] for the family of basis sections, which generates `ℒ ^⊗ n` on `X ∖ Z`,
glued over the charts of `X ∖ Z` on which one basis section does not vanish. -/
def toProjectiveSpaceAtUniverseOffSupport
    (b : Module.Basis (Fin (N + 1)) k (vanishingSections k f I L m))
    (h : GeneratesOffSupport k f I L m) :
    (openComplement I).toScheme ⟶ projectiveSpaceAtUniverse.{u} N :=
  homOfCover (chartOpen (basisSection k f b) (openComplement I))
    (isOpenCover_chartOpen _ _ fun _ hx => exists_mem_nvCover_basisSection k f b h hx)
    (chartSection (basisSection k f b) (openComplement I))
    (span_range_chartSection (basisSection k f b) (openComplement I))
    (chartUnit (basisSection k f b) (openComplement I))
    (chartSection_agree (basisSection k f b) (openComplement I))

/-- **The morphism is the one [Stacks, Tag 01NE] describes**: on the chart of `X ∖ Z` where the
`i`-th basis section does not vanish it is the morphism of the ratios `b_k / b_i`. -/
theorem ι_toProjectiveSpaceAtUniverseOffSupport
    (b : Module.Basis (Fin (N + 1)) k (vanishingSections k f I L m))
    (h : GeneratesOffSupport k f I L m) (i : Fin (N + 1)) :
    (chartOpen (basisSection k f b) (openComplement I) i).ι ≫
        toProjectiveSpaceAtUniverseOffSupport k f b h =
      toProjectiveSpaceAtUniverse
        (chartSection (basisSection k f b) (openComplement I) i)
        (span_range_chartSection (basisSection k f b) (openComplement I) i) :=
  ι_homOfCover _ _ _ _ _ _ i

/-- The morphism `X ∖ Z ⟶ ℙᴺ_k`, over `Spec k`. -/
def toProjectiveSpaceOverOffSupport
    (b : Module.Basis (Fin (N + 1)) k (vanishingSections k f I L m))
    (h : GeneratesOffSupport k f I L m) :
    (openComplement I).toScheme ⟶ projectiveSpaceOverRing N (.of k) :=
  Stacks.AmpleProjectiveImmersion.liftOver ((openComplement I).ι ≫ f)
    (toProjectiveSpaceAtUniverseOffSupport k f b h)

/-- The coordinate isomorphism `ℙᴺ_k ≅ P(V_n)` of [Stacks, Tag 0FCY] attached to a basis of `V_n`,
read as an isomorphism of schemes. -/
def coordIso (b : Module.Basis (Fin (N + 1)) k (vanishingSections k f I L m)) :
    projectiveSpaceOverRing N (.of k) ≅
      projectiveSpaceOfModule k (vanishingSections k f I L m) :=
  (CategoryTheory.Over.forget (Spec (.of k))).mapIso (basisProjectiveSpaceOfModuleIso b).symm

/-- The coordinate isomorphism commutes with the two structure morphisms to `Spec k`. -/
theorem coordIso_hom_comp_toSpec
    (b : Module.Basis (Fin (N + 1)) k (vanishingSections k f I L m)) :
    (coordIso k f b).hom ≫ projectiveSpaceOfModuleToSpec k (vanishingSections k f I L m) =
      pullback.fst (terminal.from (Spec (.of k)))
        (terminal.from (projectiveSpaceAtUniverse.{u} N)) :=
  CategoryTheory.Over.w (basisProjectiveSpaceOfModuleIso b).inv

/-- **The morphism `X ∖ Z ⟶ P(V_n)` of [Stacks, Tag 0FD5] in a basis of `V_n`**: the morphism to
`ℙᴺ_k` attached to the basis sections, followed by the coordinate isomorphism `ℙᴺ_k ≅ P(V_n)` of
[Stacks, Tag 0FCY].

The source speaks of *the* canonical morphism, which is basis free; this construction chooses a
basis, and the two are not compared here. See the module documentation.

This **is** the morphism of [Stacks, Tag 0FCY] attached to the restricted linear system:
`Stacks.SectionsVanishingOnSubscheme.toProjectiveSpaceOfVanishingSections_eq` identifies it with
`AlgebraicGeometry.toProjectiveSpaceOfModule` applied to the basis sections restricted to
`X ∖ Z`. It is the morphism the whole of [Stacks, Tag 0FD5] —
`Stacks.SectionsVanishingOnSubscheme.exists_bound_generatesOffSupport_and_isImmersion` — asserts
to be an immersion. -/
def toProjectiveSpaceOfVanishingSections
    (b : Module.Basis (Fin (N + 1)) k (vanishingSections k f I L m))
    (h : GeneratesOffSupport k f I L m) :
    (openComplement I).toScheme ⟶ projectiveSpaceOfModule k (vanishingSections k f I L m) :=
  toProjectiveSpaceOverOffSupport k f b h ≫ (coordIso k f b).hom

/-- **The morphism to `P(V_n)` is a morphism of schemes over `k`.**

The whole of [Stacks, Tag 0FD5] is
`Stacks.SectionsVanishingOnSubscheme.exists_bound_generatesOffSupport_and_isImmersion`. -/
theorem toProjectiveSpaceOfVanishingSections_comp_toSpec
    (b : Module.Basis (Fin (N + 1)) k (vanishingSections k f I L m))
    (h : GeneratesOffSupport k f I L m) :
    toProjectiveSpaceOfVanishingSections k f b h ≫
        projectiveSpaceOfModuleToSpec k (vanishingSections k f I L m) =
      (openComplement I).ι ≫ f := by
  rw [toProjectiveSpaceOfVanishingSections, Category.assoc, coordIso_hom_comp_toSpec]
  exact Stacks.AmpleProjectiveImmersion.liftOver_fst _ _

/-- **Being an immersion does not depend on the coordinate presentation**: the morphism to
`P(V_n)` is an immersion exactly when the morphism to `ℙᴺ_k` it is built from is, because the two
differ by an isomorphism. -/
theorem isImmersion_iff_isImmersion_toProjectiveSpaceOver
    (b : Module.Basis (Fin (N + 1)) k (vanishingSections k f I L m))
    (h : GeneratesOffSupport k f I L m) :
    IsImmersion (toProjectiveSpaceOfVanishingSections k f b h) ↔
      IsImmersion (toProjectiveSpaceOverOffSupport k f b h) := by
  rw [toProjectiveSpaceOfVanishingSections]
  exact IsImmersion.comp_iff _ _

end Morphism

section OverFieldMorphism

variable (k : Type u) [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k))

/-- **The morphism of [Stacks, Tag 0FD5] exists in every sufficiently positive degree.** Let `X`
be proper over a field `k`, let `ℒ` be ample and invertible and let `Z ⊂ X` be the closed
subscheme cut out by `I`. Then there is an `n₀` such that for every `n ≥ n₀` and every basis of
the linear system `V_n` the basis determines a morphism `X ∖ Z ⟶ P(V_n)` over `k`.

What this does **not** assert is that the morphism is an immersion, which is the second half of
the tag. The whole of [Stacks, Tag 0FD5] is
`Stacks.SectionsVanishingOnSubscheme.exists_bound_generatesOffSupport_and_isImmersion`. -/
theorem exists_bound_hom_projectiveSpaceOfVanishingSections [IsProper f]
    (I : X.IdealSheafData) (L : X.Modules) [IsInvertibleModule X L] (hL : IsAmple X L) :
    ∃ n₀ : ℤ, ∀ n : ℤ, n₀ ≤ n → ∀ (N : ℕ),
      Module.Basis (Fin (N + 1)) k (vanishingSections k f I L n) →
      ∃ p : (openComplement I).toScheme ⟶
          projectiveSpaceOfModule k (vanishingSections k f I L n),
        p ≫ projectiveSpaceOfModuleToSpec k (vanishingSections k f I L n) =
          (openComplement I).ι ≫ f := by
  obtain ⟨n₀, hn₀⟩ := exists_bound_generatesOffSupport k f I L hL
  exact ⟨n₀, fun n hn N b => ⟨toProjectiveSpaceOfVanishingSections k f b (hn₀ n hn),
    toProjectiveSpaceOfVanishingSections_comp_toSpec k f b (hn₀ n hn)⟩⟩

end OverFieldMorphism


end Stacks.SectionsVanishingOnSubscheme

