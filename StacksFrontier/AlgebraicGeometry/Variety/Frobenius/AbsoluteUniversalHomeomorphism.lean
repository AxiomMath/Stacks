module

public import Mathlib.AlgebraicGeometry.Morphisms.Integral
public import Mathlib.AlgebraicGeometry.Morphisms.UniversallyInjective
public import Mathlib.AlgebraicGeometry.ResidueField
public import Mathlib.RingTheory.RingHom.PurelyInseparable
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Morphisms.UniversalHomeomorphism.Defs.Basic
public import StacksFrontier.AlgebraicGeometry.Variety.Frobenius.Absolute

/-!
# The absolute Frobenius is a universal homeomorphism

For a scheme in positive prime characteristic, its absolute Frobenius is a universal
homeomorphism, is integral, and induces purely inseparable extensions of residue fields. It is
the identity on points, and on sections it is the `p`-th power map, so each section is a root of
the integral equation `T ^ p - g` and each residue-field extension is generated by `p`-th roots.

## Main results

* `AlgebraicGeometry.absoluteFrobenius_universalHomeomorphism` states that the absolute
  Frobenius is a universal homeomorphism.
* `AlgebraicGeometry.absoluteFrobenius_isIntegralHom` states that it is integral.
* `AlgebraicGeometry.absoluteFrobenius_residueFieldMap_isPurelyInseparable` states that all of
  its induced residue-field maps are purely inseparable.

## Implementation notes

The first two conclusions are supplied as instances of
`AlgebraicGeometry.UniversalHomeomorphism` and `AlgebraicGeometry.IsIntegralHom`. The
residue-field conclusion uses the canonical map `AlgebraicGeometry.Scheme.Hom.residueFieldMap`;
`RingHom.IsPurelyInseparable` packages the algebra structure induced by that map without making
a separate choice.

## References

* [Stacks Project, Tag 0CC8](https://stacks.math.columbia.edu/tag/0CC8)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits CategoryTheory.MorphismProperty
open Stacks.Frobenius

universe u

namespace AlgebraicGeometry

/-- A ring endomorphism given by a positive power map is integral: every element is a root of
`T ^ p - x`. -/
private lemma isIntegral_of_power_map {R : Type*} [CommRing R] (p : ℕ)
    (hp : 0 < p) (f : R →+* R) (hf : ∀ x, f x = x ^ p) : f.IsIntegral := by
  let : Algebra R R := f.toAlgebra
  intro x
  apply _root_.IsIntegral.of_pow hp
  change f.IsIntegralElem (x ^ p)
  simpa only [← hf x] using f.isIntegralElem_map

/-- On stalks, the absolute Frobenius is again the `p`-th power map. -/
private lemma absoluteFrobenius_stalkMap_apply (X : Scheme.{u}) (p : ℕ)
    [Fact p.Prime] (hX : IsInCharacteristic X p) (x : X)
    (s : X.presheaf.stalk x) :
    (absoluteFrobenius X p hX).stalkMap x s = s ^ p := by
  obtain ⟨U, hxU, g, rfl⟩ := X.presheaf.exists_germ_eq s
  have h := Scheme.Hom.germ_stalkMap_apply (absoluteFrobenius X p hX) U x hxU g
  rw [absoluteFrobenius_app_apply] at h
  simp only [absoluteFrobenius_apply, absoluteFrobenius_preimage] at h
  exact h.trans (map_pow (X.presheaf.germ U x hxU).hom g p)

/-- The absolute Frobenius is integral, since it is affine and the power map on sections is. -/
private theorem absoluteFrobenius_isIntegralHom_aux
    (X : Scheme.{u}) (p : ℕ) [Fact p.Prime] (hX : IsInCharacteristic X p) :
    IsIntegralHom (absoluteFrobenius X p hX) := by
  let f := absoluteFrobenius X p hX
  have : IsAffineHom f := ⟨fun U hU => by simpa [f] using hU⟩
  constructor
  intro U hU
  exact isIntegral_of_power_map p (Fact.out : p.Prime).pos
    (f.app U).hom (fun x => absoluteFrobenius_app_apply X p hX U x)

/-- Each residue field of a scheme in characteristic `p` is purely inseparable over its image
under the absolute Frobenius, because that image contains every `p`-th power. -/
private theorem absoluteFrobenius_residueFieldMap_isPurelyInseparable_aux
    (X : Scheme.{u}) (p : ℕ) [Fact p.Prime] (hX : IsInCharacteristic X p)
    (x : X) :
    ((absoluteFrobenius X p hX).residueFieldMap x).hom.IsPurelyInseparable := by
  let f := absoluteFrobenius X p hX
  have hf : ∀ a : X.residueField x, (f.residueFieldMap x) a = a ^ p := by
    intro a
    obtain ⟨s, rfl⟩ := X.residue_surjective x a
    have h := congrArg (fun g => g s) (Scheme.residue_residueFieldMap f x)
    change f.residueFieldMap x (X.residue x s) = X.residue x (f.stalkMap x s) at h
    rw [h, absoluteFrobenius_stalkMap_apply, map_pow]
  have hp0 : (p : X.residueField x) = 0 := by
    simpa using congrArg (fun a : Γ(X, ⊤) => X.Γevaluation x a) hX
  have : CharP (X.residueField x) p := by
    rw [← ringChar.eq_iff]
    exact ((Nat.dvd_prime Fact.out).mp (ringChar.dvd hp0)).resolve_left CharP.ringChar_ne_one
  let : Algebra (X.residueField x) (X.residueField x) := (f.residueFieldMap x).hom.toAlgebra
  change _root_.IsPurelyInseparable (X.residueField x) (X.residueField x)
  refine (isPurelyInseparable_iff_pow_mem (X.residueField x) p).mpr fun a => ⟨1, ?_⟩
  simp only [pow_one]
  change a ^ p ∈ (f.residueFieldMap x).hom.range
  exact ⟨a, hf a⟩

/-- The absolute Frobenius of a scheme in positive prime characteristic is a universal
homeomorphism. -/
@[stacks 0CC8]
instance absoluteFrobenius_universalHomeomorphism
    (X : Scheme.{u}) (p : ℕ) [Fact p.Prime] (hX : IsInCharacteristic X p) :
    UniversalHomeomorphism (absoluteFrobenius X p hX) := by
  let f := absoluteFrobenius X p hX
  have : IsIntegralHom f := absoluteFrobenius_isIntegralHom_aux X p hX
  have : UniversallyInjective f := by
    apply ((tfae_universallyInjective f).out 1 3).mpr
    exact ⟨(fun _ _ h => by simpa [f] using h),
      absoluteFrobenius_residueFieldMap_isPurelyInseparable_aux X p hX⟩
  have : Surjective f := ⟨fun x => ⟨x, by simp [f]⟩⟩
  have : UniversallyClosed f :=
    (IsIntegralHom.iff_universallyClosed_and_isAffineHom.mp ‹IsIntegralHom f›).1
  constructor
  intro X' Y' i₁ i₂ f' H
  have : Surjective f' :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback H.flip inferInstance
  exact isHomeomorph_iff_continuous_isClosedMap_bijective.mpr
    ⟨Scheme.Hom.continuous f', UniversallyClosed.universally_isClosedMap _ _ _ H,
     ⟨UniversallyInjective.universally_injective _ _ _ H, f'.surjective⟩⟩

/-- The absolute Frobenius of a scheme in positive prime characteristic is integral. -/
@[stacks 0CC8]
instance absoluteFrobenius_isIntegralHom
    (X : Scheme.{u}) (p : ℕ) [Fact p.Prime] (hX : IsInCharacteristic X p) :
    IsIntegralHom (absoluteFrobenius X p hX) :=
  absoluteFrobenius_isIntegralHom_aux X p hX

/-- The map on residue fields induced by the absolute Frobenius is purely inseparable at every
point. -/
@[stacks 0CC8]
theorem absoluteFrobenius_residueFieldMap_isPurelyInseparable
    (X : Scheme.{u}) (p : ℕ) [Fact p.Prime] (hX : IsInCharacteristic X p)
    (x : X) :
    ((absoluteFrobenius X p hX).residueFieldMap x).hom.IsPurelyInseparable :=
  absoluteFrobenius_residueFieldMap_isPurelyInseparable_aux X p hX x

end AlgebraicGeometry

end
