/-!
# Dimensions of local rings after an extension of the ground field

Let `K / k` be an extension of fields, let `X` be locally of finite type over `k` and let
`Y = X ×_{Spec k} Spec K`. At a point `y` of `Y` with image `x` in `X`, the dimension of the
quotient of `𝒪_{Y, y}` by the ideal generated by the maximal ideal of `𝒪_{X, x}` is both the
increase in local dimension from `x` to `y` and the loss of residue-field transcendence degree.

## Main results

* `AlgebraicGeometry.fiberLocalRing_dimension_add_localRing_dimension_eq` expresses the fibre
  dimension as the increase in local-ring dimension.
* `AlgebraicGeometry.fiberLocalRing_dimension_add_trdeg_eq` expresses it as the loss of
  transcendence degree.

## Implementation notes

The quotient `𝒪_{Y, y} / 𝔪_x 𝒪_{Y, y}` is written literally as the quotient by the image of the
maximal ideal under the projection's map on local rings. Krull dimensions take values in
`WithBot ℕ∞`, so the two differences in the source are stated as additive equalities, and
transcendence degrees are compared with them through `Cardinal.toENat`.

## References

* [Stacks Project, Tag 0C4Z](https://stacks.math.columbia.edu/tag/0C4Z)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open scoped TensorProduct

namespace AlgebraicGeometry

universe u

/-- Extension of the ground field does not change the dimension of a scheme locally of finite
type at a point: on an affine chart the base change is `Γ(X, U) ⊗[k] K`, and local dimension is
invariant under that base change. -/
@[sga "3 VIB 4.2" "more general"]
lemma topologicalKrullDimAt_baseChange_eq
    (k K : Type u) [Field k] [Field K] [Algebra k K]
    (X : Scheme.{u}) (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f]
    (y : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})) :
    topologicalKrullDimAt
        (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u}) y =
      topologicalKrullDimAt X
        ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).base y) := by
  let Y := (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})
  let g : Y ⟶ X := pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))
  let x := g.base y
  obtain ⟨U, hU, hxU, _⟩ :=
    exists_isAffineOpen_mem_and_subset (show x ∈ (⊤ : X.Opens) from trivial)
  let : Algebra k Γ(X, U) :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appLE ⊤ U (by simp)).hom.toAlgebra
  have : Algebra.FiniteType k Γ(X, U) := by
    change (((Scheme.ΓSpecIso (.of k)).inv ≫ f.appLE ⊤ U (by simp)).hom).FiniteType
    exact (f.finiteType_appLE (isAffineOpen_top _) hU _).comp
      (RingHom.FiniteType.of_surjective _
        (Scheme.ΓSpecIso (.of k)).symm.commRingCatIsoToRingEquiv.surjective)
  let V : Y.Opens := g ⁻¹ᵁ U
  have hyV : y ∈ V := hxU
  obtain ⟨_, e, _hfst, _hsnd, hprime, _harrow⟩ :=
    affineBaseChangeLocalModel k K X f y U hU hxU
  let q : PrimeSpectrum (Γ(X, U) ⊗[k] K) := e.hom ⟨y, hyV⟩
  let : Algebra K (Γ(X, U) ⊗[k] K) := Algebra.TensorProduct.rightAlgebra
  calc
    topologicalKrullDimAt Y y = topologicalKrullDimAt (↥V) ⟨y, hyV⟩ :=
      Topology.IsOpenEmbedding.topologicalKrullDimAt_eq
        (IsOpen.isOpenEmbedding_subtypeVal V.2) ⟨y, hyV⟩
    _ = TopologicalSpace.localKrullDim (PrimeSpectrum (Γ(X, U) ⊗[k] K)) q := by
      rw [← TopologicalSpace.topologicalKrullDimAt_eq_localKrullDim
        (PrimeSpectrum (Γ(X, U) ⊗[k] K)) q]
      exact topologicalKrullDimAt_eq_of_homeomorph e.hom.homeomorph ⟨y, hyV⟩
    _ = topologicalKrullDimAt X x := by
      rw [topologicalKrullDimAt_eq_affine_open x U hxU hU, ← hprime]
      exact (Algebra.IsPushout.localKrullDim_comap_eq k K Γ(X, U)
        (Γ(X, U) ⊗[k] K) q).symm

/-- A scheme locally of finite type over a field is locally Noetherian. -/
private theorem isLocallyNoetherian_of_locallyOfFiniteType_field
    (k : Type u) [Field k] (X : Scheme.{u}) (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f] :
    IsLocallyNoetherian X :=
  have : IsLocallyNoetherian (Spec (.of k)) := isLocallyNoetherian_Spec.mpr inferInstance
  LocallyOfFiniteType.isLocallyNoetherian f

/-- **Stacks Project, Tag 0C4Z.** After extension of the ground field, the dimension of the local
fibre ring plus the dimension of the original local ring is the dimension of the new local
ring. -/
@[stacks 0C4Z "local-ring dimension equality"]
theorem fiberLocalRing_dimension_add_localRing_dimension_eq
    (k K : Type u) [Field k] [Field K] [Algebra k K]
    (X : Scheme.{u}) (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f]
    (y : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})) :
    let Y := (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})
    let g : Y ⟶ X := pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))
    let x := g.base y
    ringKrullDim
          ((Y.presheaf.stalk y) ⧸
            Ideal.map (g.stalkMap y).hom
              (IsLocalRing.maximalIdeal (X.presheaf.stalk x))) +
        ringKrullDim (X.presheaf.stalk x) =
      ringKrullDim (Y.presheaf.stalk y) := by
  dsimp
  let Y := (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})
  let g : Y ⟶ X := pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))
  let R := X.presheaf.stalk (g.base y)
  let S := Y.presheaf.stalk y
  have : IsLocallyNoetherian X := isLocallyNoetherian_of_locallyOfFiniteType_field k X f
  have : IsLocallyNoetherian Y := isLocallyNoetherian_of_locallyOfFiniteType_field K Y
    (pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k K))))
  have : Flat (Spec.map (CommRingCat.ofHom (algebraMap k K)) :
      Spec (.of K) ⟶ Spec (.of k)) :=
    Flat.SpecMap_iff.mpr (RingHom.Flat.of_isField (Field.toIsField k) _)
  let : Algebra R S := (g.stalkMap y).hom.toAlgebra
  have : Module.Flat R S := by
    change (g.stalkMap y).hom.Flat
    exact AlgebraicGeometry.Flat.stalkMap g y
  have : IsLocalHom (algebraMap R S) := by
    change IsLocalHom (g.stalkMap y).hom
    infer_instance
  change ringKrullDim (ClosedFibre R S) + ringKrullDim R = ringKrullDim S
  rw [add_comm]
  exact (ringKrullDim_eq_add_ringKrullDim_closedFibre R S inferInstance).symm

/-- **Stacks Project, Tag 0C4Z.** After extension of the ground field, the dimension of the local
fibre ring plus the transcendence degree of the new residue field is the transcendence degree of
the original residue field. -/
@[stacks 0C4Z "transcendence degree equality"]
theorem fiberLocalRing_dimension_add_trdeg_eq
    (k K : Type u) [Field k] [Field K] [Algebra k K]
    (X : Scheme.{u}) (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f]
    (y : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})) :
    let Y := (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})
    let g : Y ⟶ X := pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))
    let h : Y ⟶ Spec (.of K) := pullback.snd f (Spec.map
      (CommRingCat.ofHom (algebraMap k K)))
    let x := g.base y
    letI : Algebra k (X.residueField x) := (fieldToResidue f x).hom.toAlgebra
    letI : Algebra K (Y.residueField y) := (fieldToResidue h y).hom.toAlgebra
    ringKrullDim
          ((Y.presheaf.stalk y) ⧸
            Ideal.map (g.stalkMap y).hom
              (IsLocalRing.maximalIdeal (X.presheaf.stalk x))) +
        (Cardinal.toENat (Algebra.trdeg K (Y.residueField y)) : WithBot ℕ∞) =
      (Cardinal.toENat (Algebra.trdeg k (X.residueField x)) : WithBot ℕ∞) := by
  dsimp
  let Y := (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})
  let g : Y ⟶ X := pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))
  let h : Y ⟶ Spec (.of K) :=
    pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k K)))
  let x := g.base y
  let : Algebra k (X.residueField x) := (fieldToResidue f x).hom.toAlgebra
  let : Algebra K (Y.residueField y) := (fieldToResidue h y).hom.toAlgebra
  have hX := topologicalKrullDimAt_eq_trdeg_add_krullDim_stalk k X f x
  have hY := topologicalKrullDimAt_eq_trdeg_add_krullDim_stalk K Y h y
  have htop := topologicalKrullDimAt_baseChange_eq k K X f y
  change topologicalKrullDimAt X x =
    (Cardinal.toENat (Algebra.trdeg k (X.residueField x)) : WithBot ℕ∞) +
      ringKrullDim (X.presheaf.stalk x) at hX
  change topologicalKrullDimAt Y y =
    (Cardinal.toENat (Algebra.trdeg K (Y.residueField y)) : WithBot ℕ∞) +
      ringKrullDim (Y.presheaf.stalk y) at hY
  have hsum := hY.symm.trans (htop.trans hX)
  rw [← fiberLocalRing_dimension_add_localRing_dimension_eq k K X f y] at hsum
  have : IsLocallyNoetherian X := isLocallyNoetherian_of_locallyOfFiniteType_field k X f
  apply Stacks.KrullDimension.LocalBaseChange.add_right_cancel_coe
    (c := Ideal.height (IsLocalRing.maximalIdeal (X.presheaf.stalk x)))
    Ideal.height_ne_top_of_isPrime
  rw [IsLocalRing.maximalIdeal_height_eq_ringKrullDim (R := X.presheaf.stalk x)]
  convert hsum using 1
  ac_rfl

end AlgebraicGeometry

end
