/-!
# Maximal ideals after a change of the ground field

Let `X` be locally of finite type over a field `k`, let `K / k` be an extension of fields and let
`Y = X ×_{Spec k} Spec K`. At a point `y` of `Y` with image `x` in `X`, the special fibre of the
map on local rings — the quotient of `𝒪_{Y, y}` by the ideal generated by the maximal ideal of
`𝒪_{X, x}` — is a localization of the tensor product of residue fields `κ(x) ⊗[k] K`.
Consequently, if the two local rings have the same dimension and that tensor product is reduced,
the maximal ideal of `𝒪_{X, x}` already generates the maximal ideal of `𝒪_{Y, y}`.

## Main results

* `AlgebraicGeometry.specialFibreRingEquiv` identifies the special fibre of the map on local
  rings with the corresponding localization of the tensor product of residue fields.
* `AlgebraicGeometry.map_maximalIdeal_stalkMap_eq_of_isReduced_tensorProduct` identifies the
  extended maximal ideal with the maximal ideal after the change of fields.

## Implementation notes

The base change is a categorical pullback of schemes. Mathlib's
`AlgebraicGeometry.Scheme.Pullback.Triplet.tensor` is the pushout of residue fields, so it
represents `κ(x) ⊗[k] K` here, and `AlgebraicGeometry.Scheme.Pullback.ofPointTensor` to `κ(y)`
determines the prime at which that tensor product is localized. Equality of the two rings is
recorded as a ring equivalence. The canonical `k`-algebra structure on the residue field is the
composite through the residue field of the corresponding point of `Spec k`.

## References

* [Stacks Project, Tag 0C4Y](https://stacks.math.columbia.edu/tag/0C4Y)
* [Stacks Project, Tag 0C50](https://stacks.math.columbia.edu/tag/0C50)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open scoped TensorProduct

universe u

namespace AlgebraicGeometry

/-- The residue field of the spectrum of a field is canonically the field. -/
noncomputable def specFieldResidueIso (K : Type u) [Field K]
    (x : Spec (CommRingCat.of K)) :
    (Spec (CommRingCat.of K)).residueField x ≅ CommRingCat.of K := by
  let : x.asIdeal.IsPrime := x.2
  exact Scheme.Spec.residueFieldIso (CommRingCat.of K) x ≪≫
    (x.asIdeal.algEquivResidueFieldOfField.symm.toRingEquiv.toCommRingCatIso)

/-- The identification of the residue field of `Spec K` with `K` is compatible with
`Scheme.residueFieldCongr`. -/
lemma specFieldResidueIso_congr (K : Type u) [Field K]
    {s t : Spec (CommRingCat.of K)} (h : s = t) :
    (specFieldResidueIso K t).inv ≫
      ((Spec (CommRingCat.of K)).residueFieldCongr h).inv =
        (specFieldResidueIso K s).inv := by
  cases h
  simp

/-- The pushout presentation of the base changed stalk agrees with the usual tensor product. -/
noncomputable def stalkPushoutTensorIso
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) (x : X) :
    let R := X.presheaf.stalk x
    letI : Algebra k R :=
      (fieldToStalk f x).hom.toAlgebra
    CommRingCat.of (R ⊗[k] K) ≅
      stalkBaseChangeRing (K := K) f x := by
  let R := X.presheaf.stalk x
  let : Algebra k R :=
    (fieldToStalk f x).hom.toAlgebra
  exact (CommRingCat.isPushout_tensorProduct k R K).isoPushout

/-- The pushout presentation of the residue-field base change agrees with the tensor product. -/
noncomputable def residuePushoutTensorIso
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) (x : X) :
    let R := X.residueField x
    letI : Algebra k R :=
      (fieldToResidue f x).hom.toAlgebra
    CommRingCat.of (R ⊗[k] K) ≅
      residueBaseChangeRing (K := K) f x := by
  let R := X.residueField x
  let : Algebra k R :=
    (fieldToResidue f x).hom.toAlgebra
  exact (CommRingCat.isPushout_tensorProduct k R K).isoPushout

/-- The isomorphism `stalkPushoutTensorIso` carries the left inclusion into `𝒪_{X,x} ⊗[k] K` to
the first pushout inclusion. -/
lemma stalkPushoutTensorIso_inl
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) (x : X) :
    let R := X.presheaf.stalk x
    letI : Algebra k R :=
      (fieldToStalk f x).hom.toAlgebra
    CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := k) (A := R) (B := K)) ≫
      (stalkPushoutTensorIso f x).hom =
        pushout.inl (fieldToStalk f x)
          (CommRingCat.ofHom (algebraMap k K : k →+* K)) := by
  let : Algebra k (X.presheaf.stalk x) :=
    (fieldToStalk f x).hom.toAlgebra
  exact (CommRingCat.isPushout_tensorProduct k (X.presheaf.stalk x) K).inl_isoPushout_hom

/-- The isomorphism `stalkPushoutTensorIso` carries the right inclusion into `𝒪_{X,x} ⊗[k] K` to
the second pushout inclusion. -/
lemma stalkPushoutTensorIso_inr
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) (x : X) :
    let R := X.presheaf.stalk x
    letI : Algebra k R :=
      (fieldToStalk f x).hom.toAlgebra
    CommRingCat.ofHom (Algebra.TensorProduct.includeRight.toRingHom (R := k) (A := K)) ≫
      (stalkPushoutTensorIso f x).hom =
        pushout.inr (fieldToStalk f x)
          (CommRingCat.ofHom (algebraMap k K : k →+* K)) := by
  let : Algebra k (X.presheaf.stalk x) :=
    (fieldToStalk f x).hom.toAlgebra
  exact (CommRingCat.isPushout_tensorProduct k (X.presheaf.stalk x) K).inr_isoPushout_hom

/-- The isomorphism `residuePushoutTensorIso` carries the left inclusion into `κ(x) ⊗[k] K` to
the first pushout inclusion. -/
lemma residuePushoutTensorIso_inl
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) (x : X) :
    let R := X.residueField x
    letI : Algebra k R :=
      (fieldToResidue f x).hom.toAlgebra
    CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom (R := k) (A := R) (B := K)) ≫
      (residuePushoutTensorIso f x).hom =
        pushout.inl (fieldToResidue f x)
          (CommRingCat.ofHom (algebraMap k K : k →+* K)) := by
  let : Algebra k (X.residueField x) :=
    (fieldToResidue f x).hom.toAlgebra
  exact (CommRingCat.isPushout_tensorProduct k (X.residueField x) K).inl_isoPushout_hom

/-- The isomorphism `residuePushoutTensorIso` carries the right inclusion into `κ(x) ⊗[k] K` to
the second pushout inclusion. -/
lemma residuePushoutTensorIso_inr
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) (x : X) :
    let R := X.residueField x
    letI : Algebra k R :=
      (fieldToResidue f x).hom.toAlgebra
    CommRingCat.ofHom (Algebra.TensorProduct.includeRight.toRingHom (R := k) (A := K)) ≫
      (residuePushoutTensorIso f x).hom =
        pushout.inr (fieldToResidue f x)
          (CommRingCat.ofHom (algebraMap k K : k →+* K)) := by
  let : Algebra k (X.residueField x) :=
    (fieldToResidue f x).hom.toAlgebra
  exact (CommRingCat.isPushout_tensorProduct k (X.residueField x) K).inr_isoPushout_hom

/-- The inverse of the residue field identification of `Spec K` at `s` is the germ followed by the
residue map. -/
private lemma specFieldResidueIso_inv_eq (K : Type u) [Field K] (s : Spec (CommRingCat.of K)) :
    (specFieldResidueIso K s).inv =
      (Scheme.ΓSpecIso (CommRingCat.of K)).inv ≫
        (Spec (CommRingCat.of K)).presheaf.germ ⊤ s trivial ≫
          (Spec (CommRingCat.of K)).residue s := by
  rw [← Scheme.Spec.algebraMap_residueFieldIso_inv]
  rfl

/-- The ground-field map to a residue field factors through the residue field of the base. -/
lemma fieldToResidue_eq_residueFieldMap
    {k : Type u} [Field k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (x : X) :
    fieldToResidue f x =
      (specFieldResidueIso k (f x)).inv ≫ f.residueFieldMap x := by
  rw [specFieldResidueIso_inv_eq]
  unfold fieldToResidue fieldToStalk
  have h₁ :
      (Spec (CommRingCat.of k)).presheaf.germ ⊤ (f x) trivial ≫ f.stalkMap x =
        f.appTop ≫ X.presheaf.germ ⊤ x trivial := by
    simpa only [Scheme.Hom.preimage_top] using f.germ_stalkMap ⊤ x trivial
  simp only [Category.assoc]
  rw [← reassoc_of% h₁, Scheme.residue_residueFieldMap]

/-- For a map of field spectra, the ground-field map to the residue field is
the field homomorphism followed by the canonical residue-field isomorphism. -/
lemma fieldToResidue_specMap
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    (z : Spec (CommRingCat.of K)) :
    fieldToResidue
      (Spec.map (CommRingCat.ofHom (algebraMap k K))) z =
      CommRingCat.ofHom (algebraMap k K) ≫ (specFieldResidueIso K z).inv := by
  unfold fieldToResidue fieldToStalk
  rw [specFieldResidueIso_inv_eq,
    ← reassoc_of% Scheme.ΓSpecIso_inv_naturality (CommRingCat.ofHom (algebraMap k K))]
  simp only [Category.assoc]

/-- The ground-field map to a residue field, expressed through the residue field of a point `s`
of the base equal to the image of `x`. -/
private lemma fieldToResidue_eq_comp_residueFieldCongr
    {k : Type u} [Field k] {X : Scheme.{u}} (f : X ⟶ Spec (.of k)) (x : X)
    {s : Spec (.of k)} (h : f x = s) :
    fieldToResidue f x =
      (specFieldResidueIso k s).inv ≫
        ((Spec (.of k)).residueFieldCongr h).inv ≫ f.residueFieldMap x := by
  rw [fieldToResidue_eq_residueFieldMap]
  simpa only [Category.assoc] using
    congrArg (· ≫ f.residueFieldMap x) (specFieldResidueIso_congr k h).symm

/-- The ground-field map is compatible with the first leg of the tensor product of residue
fields attached to a triplet. -/
lemma residueBaseChangeTensor_condition_left {k K : Type u} [Field k] [Field K] [Algebra k K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    (T : Scheme.Pullback.Triplet f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) :
    fieldToResidue f T.x ≫ 𝟙 _ =
      (specFieldResidueIso k T.s).inv ≫
        ((Spec (.of k)).residueFieldCongr T.hx).inv ≫ f.residueFieldMap T.x := by
  rw [Category.comp_id, fieldToResidue_eq_comp_residueFieldCongr f T.x T.hx]

/-- The field extension is compatible with the second leg of the tensor product of residue
fields attached to a triplet. -/
lemma residueBaseChangeTensor_condition_right {k K : Type u} [Field k] [Field K] [Algebra k K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    (T : Scheme.Pullback.Triplet f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) :
    CommRingCat.ofHom (algebraMap k K : k →+* K) ≫ (specFieldResidueIso K T.y).inv =
      (specFieldResidueIso k T.s).inv ≫
        ((Spec (.of k)).residueFieldCongr T.hy).inv ≫
          (Spec.map (CommRingCat.ofHom (algebraMap k K))).residueFieldMap T.y := by
  rw [← fieldToResidue_specMap, fieldToResidue_eq_comp_residueFieldCongr _ T.y T.hy]

/-- The comparison map from the pushout presentation of `κ(x) ⊗_k K` to the tensor product of
residue fields attached to a point of the base change. -/
noncomputable def residueBaseChangeTensorHom
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    (y : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})) :
    pushout (fieldToResidue f
          ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) y))
        (CommRingCat.ofHom (algebraMap k K : k →+* K)) ⟶
      (Scheme.Pullback.Triplet.ofPoint y).tensor :=
  pushout.map _ _ _ _ (𝟙 _)
    (specFieldResidueIso K (Scheme.Pullback.Triplet.ofPoint y).y).inv
    (specFieldResidueIso k (Scheme.Pullback.Triplet.ofPoint y).s).inv
    (residueBaseChangeTensor_condition_left f (Scheme.Pullback.Triplet.ofPoint y))
    (residueBaseChangeTensor_condition_right f (Scheme.Pullback.Triplet.ofPoint y))

/-- The comparison map `residueBaseChangeTensorHom` is an isomorphism. -/
instance residueBaseChangeTensorHom_isIso
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    (y : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})) :
    IsIso (residueBaseChangeTensorHom f y) :=
  pushout.map_isIso _ _ _ _ _ _ _
    (residueBaseChangeTensor_condition_left f (Scheme.Pullback.Triplet.ofPoint y))
    (residueBaseChangeTensor_condition_right f (Scheme.Pullback.Triplet.ofPoint y))

/-- The residue-field tensor in the pullback carrier is the tensor product over the
original ground field. -/
noncomputable def residueBaseChangeTensorIso
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    (y : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})) :
    residueBaseChangeRing (K := K) f
      ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) y) ≅
        (Scheme.Pullback.Triplet.ofPoint y).tensor :=
  @asIso CommRingCat _ _ _ (residueBaseChangeTensorHom f y)
    (residueBaseChangeTensorHom_isIso f y)

/-- The forward map of `residueBaseChangeTensorIso` is `residueBaseChangeTensorHom`. -/
@[simp]
lemma residueBaseChangeTensorIso_hom
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    (y : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})) :
    (residueBaseChangeTensorIso f y).hom = residueBaseChangeTensorHom f y := rfl

/-- On the residue-field factor, the comparison map is the first leg of the tensor product. -/
@[simp]
lemma inl_comp_residueBaseChangeTensorHom
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    (y : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})) :
    pushout.inl (fieldToResidue f
          ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) y))
        (CommRingCat.ofHom (algebraMap k K : k →+* K)) ≫
      residueBaseChangeTensorHom f y = (Scheme.Pullback.Triplet.ofPoint y).tensorInl :=
  (pushout.inl_desc _ _ _).trans (Category.id_comp _)

/-- On the extension-field factor, the comparison map is the second leg of the tensor product,
after identifying the residue field of the corresponding point of `Spec K`. -/
@[simp]
lemma inr_comp_residueBaseChangeTensorHom
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    (y : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})) :
    pushout.inr (fieldToResidue f
          ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) y))
        (CommRingCat.ofHom (algebraMap k K : k →+* K)) ≫
      residueBaseChangeTensorHom f y =
        (specFieldResidueIso K (Scheme.Pullback.Triplet.ofPoint y).y).inv ≫
          (Scheme.Pullback.Triplet.ofPoint y).tensorInr :=
  pushout.inr_desc _ _ _

/-- A map from the pushout presentation of `κ(x) ⊗_k K` to `κ(y)` whose two legs are the
residue-field maps of the projections equals `residueBaseChangeTensorIso` followed by
`Scheme.Pullback.ofPointTensor`. -/
lemma residueBaseChangeTensorIso_comp_ofPointTensor
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    (y : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u}))
    (ψ : residueBaseChangeRing (K := K) f
      ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) y) ⟶
        (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u}).residueField y)
    (hl : pushout.inl (fieldToResidue f
        ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) y))
        (CommRingCat.ofHom (algebraMap k K : k →+* K)) ≫ ψ =
        (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).residueFieldMap y)
    (hr : pushout.inr (fieldToResidue f
        ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) y))
        (CommRingCat.ofHom (algebraMap k K : k →+* K)) ≫ ψ =
        fieldToResidue
          (pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) y) :
    (residueBaseChangeTensorIso f y).hom ≫ Scheme.Pullback.ofPointTensor y = ψ := by
  have hfield : (specFieldResidueIso K (Scheme.Pullback.Triplet.ofPoint y).y).inv ≫
      (pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).residueFieldMap y =
      fieldToResidue (pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) y := by
    rw [fieldToResidue_eq_residueFieldMap]
    rfl
  apply pushout.hom_ext
  · have hinl : (Scheme.Pullback.Triplet.ofPoint y).tensorInl ≫
        Scheme.Pullback.ofPointTensor y =
        (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).residueFieldMap y :=
      pushout.inl_desc _ _ _
    refine (Category.assoc _ _ _).symm.trans ?_
    refine (congrArg (fun q => q ≫ Scheme.Pullback.ofPointTensor y)
      (inl_comp_residueBaseChangeTensorHom f y)).trans ?_
    exact hinl.trans hl.symm
  · have hinr : (Scheme.Pullback.Triplet.ofPoint y).tensorInr ≫
        Scheme.Pullback.ofPointTensor y =
        (pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).residueFieldMap y :=
      pushout.inr_desc _ _ _
    refine (Category.assoc _ _ _).symm.trans ?_
    refine (congrArg (fun q => q ≫ Scheme.Pullback.ofPointTensor y)
      (inr_comp_residueBaseChangeTensorHom f y)).trans ?_
    refine (Category.assoc _ _ _).trans ?_
    refine (congrArg (fun q => (specFieldResidueIso K
      (Scheme.Pullback.Triplet.ofPoint y).y).inv ≫ q) hinr).trans ?_
    exact hfield.trans hr.symm

/-- A commutative square of local rings induces an equivalence of its special fibres
when the vertical maps are isomorphisms. -/
noncomputable def specialFibreCongr
    {R S R' S' : Type u} [CommRing R] [CommRing S] [CommRing R'] [CommRing S']
    [IsLocalRing R] [IsLocalRing R']
    (f : R →+* S) (g : R' →+* S') (eR : R ≃+* R') (eS : S ≃+* S')
    (h : eS.toRingHom.comp f = g.comp eR.toRingHom) :
    S ⧸ (IsLocalRing.maximalIdeal R).map f ≃+*
      S' ⧸ (IsLocalRing.maximalIdeal R').map g :=
  Ideal.quotientEquiv _ _ eS (by
    calc
      (IsLocalRing.maximalIdeal R').map g
          = ((IsLocalRing.maximalIdeal R).map eR.toRingHom).map g :=
              congrArg (Ideal.map g) (IsLocalRing.map_ringEquiv_maximalIdeal eR).symm
      _ = (IsLocalRing.maximalIdeal R).map (g.comp eR.toRingHom) := by rw [Ideal.map_map]
      _ = (IsLocalRing.maximalIdeal R).map (eS.toRingHom.comp f) := by rw [h]
      _ = ((IsLocalRing.maximalIdeal R).map f).map eS.toRingHom := by rw [Ideal.map_map])

/-- Quotienting a prime localization by the extension of an ideal agrees with
localizing the quotient at the induced prime. -/
noncomputable def quotientLocalizationEquiv
    {A : Type u} [CommRing A] (p J : Ideal A) [p.IsPrime] (hJ : J ≤ p) :
    let q := p.map (Ideal.Quotient.mk J)
    letI : q.IsPrime := Ideal.isPrime_map_quotientMk_of_isPrime hJ
    (Localization.AtPrime p ⧸ J.map (algebraMap A (Localization.AtPrime p))) ≃+*
      Localization.AtPrime q := by
  let q : Ideal (A ⧸ J) := p.map (Ideal.Quotient.mk J)
  have : q.IsPrime := Ideal.isPrime_map_quotientMk_of_isPrime hJ
  have hq : q.comap (Ideal.Quotient.mk J) = p := Ideal.comap_map_mk hJ
  have hm : Algebra.algebraMapSubmonoid (A ⧸ J) p.primeCompl = q.primeCompl := by
    ext z
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective z
    simp only [Algebra.algebraMapSubmonoid, Submonoid.mem_map, Ideal.mem_primeCompl_iff]
    constructor
    · rintro ⟨b, hb, hab⟩
      exact hab ▸ (by simpa [← hq] using hb : Ideal.Quotient.mk J b ∉ q)
    · intro ha
      exact ⟨a, by simpa [← hq] using ha, rfl⟩
  have : IsLocalization q.primeCompl
      (Localization.AtPrime p ⧸ J.map (algebraMap A (Localization.AtPrime p))) := by
    rw [← hm]
    infer_instance
  exact (IsLocalization.algEquiv q.primeCompl _ (Localization.AtPrime q)).toRingEquiv

/-- The same quotient-localization comparison after identifying the quotient ring
with another presentation. -/
noncomputable def quotientLocalizationEquivOfRingEquiv
    {A B : Type u} [CommRing A] [CommRing B]
    (p J : Ideal A) [p.IsPrime] (hJ : J ≤ p)
    (e : A ⧸ J ≃+* B) (q : Ideal B) [q.IsPrime]
    (h : p = q.comap (e.toRingHom.comp (Ideal.Quotient.mk J))) :
    (Localization.AtPrime p ⧸ J.map (algebraMap A (Localization.AtPrime p))) ≃+*
      Localization.AtPrime q := by
  let pbar := p.map (Ideal.Quotient.mk J)
  have : pbar.IsPrime := Ideal.isPrime_map_quotientMk_of_isPrime hJ
  have hpbar : pbar = q.comap e.toRingHom := by
    apply Ideal.comap_injective_of_surjective (Ideal.Quotient.mk J)
      Ideal.Quotient.mk_surjective
    simpa only [pbar, Ideal.comap_map_mk hJ, Ideal.comap_comap] using h
  exact (quotientLocalizationEquiv p J hJ).trans
    (Localization.localRingEquiv pbar q e hpbar)

/-- Tensoring the residue-field quotient with the extension field is the quotient of
the original tensor product by the extended maximal ideal. -/
noncomputable def tensorSpecialFibreQuotientEquiv
    (k R K : Type u) [Field k] [CommRing R] [IsLocalRing R] [Field K]
    [Algebra k R] [Algebra k K] :
    ((R ⊗[k] K) ⧸
      (IsLocalRing.maximalIdeal R).map (algebraMap R (R ⊗[k] K))) ≃+*
      IsLocalRing.ResidueField R ⊗[k] K :=
  (Algebra.TensorProduct.quotientTensorEquiv (R := k) k K R
    (IsLocalRing.maximalIdeal R)).symm.toRingEquiv

/-- On the first factor, reduction of `R ⊗[k] K` followed by `tensorSpecialFibreQuotientEquiv`
is the residue map of `R` followed by the left inclusion. -/
lemma tensorSpecialFibreQuotientEquiv_comp_includeLeft
    (k R K : Type u) [Field k] [CommRing R] [IsLocalRing R] [Field K]
    [Algebra k R] [Algebra k K] :
    ((tensorSpecialFibreQuotientEquiv k R K).toRingHom.comp
      (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map
        (algebraMap R (R ⊗[k] K))))).comp
          (Algebra.TensorProduct.includeLeftRingHom (R := k) (A := R) (B := K)) =
      (Algebra.TensorProduct.includeLeftRingHom (R := k)
        (A := IsLocalRing.ResidueField R) (B := K)).comp
          (IsLocalRing.residue R) := by
  ext r
  show (tensorSpecialFibreQuotientEquiv k R K)
    ((Ideal.Quotient.mk _) (r ⊗ₜ[k] 1)) =
      (IsLocalRing.residue R r) ⊗ₜ[k] 1
  show (Algebra.TensorProduct.quotientTensorEquiv (R := k) k K R
    (IsLocalRing.maximalIdeal R)).symm
      ((Ideal.Quotient.mk _) (r ⊗ₜ[k] 1)) =
        (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R)) r ⊗ₜ[k] 1
  exact Algebra.TensorProduct.quotientTensorEquiv_symm_apply_tmul
    (R := k) k K R (IsLocalRing.maximalIdeal R) r 1

/-- On the second factor, reduction of `R ⊗[k] K` followed by `tensorSpecialFibreQuotientEquiv`
is the right inclusion of `K`. -/
lemma tensorSpecialFibreQuotientEquiv_comp_includeRight
    (k R K : Type u) [Field k] [CommRing R] [IsLocalRing R] [Field K]
    [Algebra k R] [Algebra k K] :
    ((tensorSpecialFibreQuotientEquiv k R K).toRingHom.comp
      (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map
        (algebraMap R (R ⊗[k] K))))).comp
          (Algebra.TensorProduct.includeRight.toRingHom (R := k) (A := K)) =
      (Algebra.TensorProduct.includeRight.toRingHom :
        K →+* IsLocalRing.ResidueField R ⊗[k] K) := by
  ext r
  show (tensorSpecialFibreQuotientEquiv k R K)
    ((Ideal.Quotient.mk _) (1 ⊗ₜ[k] r)) =
      1 ⊗ₜ[k] r
  show (Algebra.TensorProduct.quotientTensorEquiv (R := k) k K R
    (IsLocalRing.maximalIdeal R)).symm
      ((Ideal.Quotient.mk _) (1 ⊗ₜ[k] r)) =
        (Ideal.Quotient.mk (IsLocalRing.maximalIdeal R)) 1 ⊗ₜ[k] r
  exact Algebra.TensorProduct.quotientTensorEquiv_symm_apply_tmul
    (R := k) k K R (IsLocalRing.maximalIdeal R) 1 r

/-- The algebraic special fibre of a prime localization of a tensor product. -/
noncomputable def localTensorSpecialFibreEquiv
    (k R K L : Type u) [Field k] [CommRing R] [IsLocalRing R] [Field K]
    [Field L] [Algebra k R] [Algebra k K]
    (ρ : R ⊗[k] K →+* L)
    (ψ : IsLocalRing.ResidueField R ⊗[k] K →+* L)
    (hρ : ρ = ψ.comp ((tensorSpecialFibreQuotientEquiv k R K).toRingHom.comp
      (Ideal.Quotient.mk ((IsLocalRing.maximalIdeal R).map
        (algebraMap R (R ⊗[k] K)))))) :
    let q := RingHom.ker ρ
    letI : q.IsPrime := RingHom.ker_isPrime _
    let q₀ := RingHom.ker ψ
    letI : q₀.IsPrime := RingHom.ker_isPrime _
    (Localization.AtPrime q ⧸
      (IsLocalRing.maximalIdeal R).map
        (algebraMap R (Localization.AtPrime q))) ≃+*
      Localization.AtPrime q₀ := by
  let A := R ⊗[k] K
  let q := RingHom.ker ρ
  let J := (IsLocalRing.maximalIdeal R).map (algebraMap R A)
  let e := tensorSpecialFibreQuotientEquiv k R K
  let : q.IsPrime := RingHom.ker_isPrime _
  let : (RingHom.ker ψ).IsPrime := RingHom.ker_isPrime _
  have hJ : J ≤ q := by
    intro a ha
    change ρ a = 0
    rw [hρ]
    have hz : (Ideal.Quotient.mk J) a = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr ha
    change ψ (e ((Ideal.Quotient.mk J) a)) = 0
    rw [hz]
    simp
  have hq : q = (RingHom.ker ψ).comap
      (e.toRingHom.comp (Ideal.Quotient.mk J)) := by
    simpa only [q, J, e, RingHom.comap_ker] using congrArg RingHom.ker hρ
  have hmap : J.map (algebraMap A (Localization.AtPrime q)) =
      (IsLocalRing.maximalIdeal R).map (algebraMap R (Localization.AtPrime q)) := by
    simp only [J, Ideal.map_map]
    exact congrArg (Ideal.map · (IsLocalRing.maximalIdeal R))
      (IsScalarTower.algebraMap_eq R A (Localization.AtPrime q))
  change (Localization.AtPrime q ⧸
      (IsLocalRing.maximalIdeal R).map (algebraMap R (Localization.AtPrime q))) ≃+*
      Localization.AtPrime (RingHom.ker ψ)
  rw [← hmap]
  exact quotientLocalizationEquivOfRingEquiv q J hJ e (RingHom.ker ψ) hq

/-- **Stacks Project, Tag 0C4Y (special fibre).**  For a point `y` of the base change of
a scheme over `k` to an extension field `K`, the quotient of `𝒪_{Y,y}` by the extension
of the maximal ideal of `𝒪_{X,x}` is the localization of `κ(x) ⊗_k K` at the prime
induced by `y`. -/
@[stacks 0C4Y "special_fibre"]
noncomputable def specialFibreRingEquiv
    (k K : Type u) [Field k] [Field K] [Algebra k K]
    {X : Scheme.{u}} (f : X ⟶ Spec (.of k))
    (y : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})) :
    let p := RingHom.ker (Scheme.Pullback.ofPointTensor y).hom
    letI : p.IsPrime := RingHom.ker_isPrime _
    ((pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u}).presheaf.stalk y ⧸
        Ideal.map
          ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).stalkMap y).hom
          (IsLocalRing.maximalIdeal
            (X.presheaf.stalk
              ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).base y)))) ≃+*
      Localization.AtPrime p := by
  let g := Spec.map (CommRingCat.ofHom (algebraMap k K))
  let Y := (pullback f g : Scheme.{u})
  let F := pullback.fst f g
  let x := (pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))) y
  have hθl := inl_comp_stalkBaseChangeResidueMap (K := K) f x
  have hθr := inr_comp_stalkBaseChangeResidueMap (K := K) f x
  have hψl := inl_comp_residueBaseChangeToResidueField f x y rfl
  have hψr := inr_comp_residueBaseChangeToResidueField f x y rfl
  have hφl := inl_comp_stalkBaseChangeToStalk f x y rfl
  have hφr := inr_comp_stalkBaseChangeToStalk f x y rfl
  have hcomm := stalkBaseChangeResidueMap_comp_residueBaseChangeToResidueField f x y rfl
  have hLoc := isLocalization_stalkBaseChangePrime f x y rfl _ _ _ hφl hφr hcomm
  let A := stalkBaseChangeRing (K := K) f x
  let B := residueBaseChangeRing (K := K) f x
  let p₀ := RingHom.ker (residueBaseChangeToResidueField f x y rfl).hom
  let pA := stalkBaseChangePrime f x (stalkBaseChangeResidueMap (K := K) f x) p₀
  let : Algebra A (Y.presheaf.stalk y) := (stalkBaseChangeToStalk f x y rfl).hom.toAlgebra
  have : p₀.IsPrime := RingHom.ker_isPrime _
  have : pA.IsPrime := Ideal.comap_isPrime _ _
  let : IsLocalization.AtPrime (Y.presheaf.stalk y) pA := hLoc
  let eLoc : (Y.presheaf.stalk y) ≃+* Localization.AtPrime pA :=
    (IsLocalization.algEquiv pA.primeCompl (Y.presheaf.stalk y)
      (Localization.AtPrime pA)).toRingEquiv
  let R := X.presheaf.stalk x
  have : IsLocalRing R := inferInstance
  let : Algebra k R :=
    (fieldToStalk f x).hom.toAlgebra
  let : Algebra k (X.residueField x) :=
    (fieldToResidue f x).hom.toAlgebra
  let eA := stalkPushoutTensorIso (K := K) f x
  let eB := residuePushoutTensorIso (K := K) f x
  let eT := residueBaseChangeTensorIso f y
  have hψ : eT.hom ≫ Scheme.Pullback.ofPointTensor y =
      residueBaseChangeToResidueField f x y rfl := by
    apply residueBaseChangeTensorIso_comp_ofPointTensor f y
      (residueBaseChangeToResidueField f x y rfl)
    · dsimp only [x] at hψl
      simpa only [Scheme.residueFieldCongr_refl, Iso.refl_hom, Category.id_comp] using hψl
    · exact hψr
  let J := (IsLocalRing.maximalIdeal R).map (algebraMap R (R ⊗[k] K))
  let τ : R ⊗[k] K →+* (X.residueField x ⊗[k] K) :=
    (tensorSpecialFibreQuotientEquiv k R K).toRingHom.comp (Ideal.Quotient.mk J)
  have hθcat : eA.hom ≫ stalkBaseChangeResidueMap (K := K) f x =
      CommRingCat.ofHom τ ≫ eB.hom := by
    apply (CommRingCat.isPushout_tensorProduct k R K).hom_ext
    · dsimp only [eA]
      rw [← Category.assoc, stalkPushoutTensorIso_inl]
      refine hθl.trans ?_
      rw [← residuePushoutTensorIso_inl]
      simp only [← Category.assoc]
      exact congrArg (· ≫ eB.hom)
        (congrArg CommRingCat.ofHom
          (tensorSpecialFibreQuotientEquiv_comp_includeLeft k R K)).symm
    · dsimp only [eA]
      rw [← Category.assoc, stalkPushoutTensorIso_inr]
      refine hθr.trans ?_
      rw [← residuePushoutTensorIso_inr]
      simp only [← Category.assoc]
      exact congrArg (· ≫ eB.hom)
        (congrArg CommRingCat.ofHom
          (tensorSpecialFibreQuotientEquiv_comp_includeRight k R K)).symm
  let ρ : R ⊗[k] K →+* Y.residueField y :=
    (eA.hom ≫ stalkBaseChangeToStalk f x y rfl ≫ Y.residue y).hom
  let ψ' : IsLocalRing.ResidueField R ⊗[k] K →+* Y.residueField y :=
    (eB.hom ≫ residueBaseChangeToResidueField f x y rfl).hom
  have hρ : ρ = ψ'.comp τ := by
    have hc : eA.hom ≫ stalkBaseChangeToStalk f x y rfl ≫ Y.residue y =
        CommRingCat.ofHom τ ≫ eB.hom ≫ residueBaseChangeToResidueField f x y rfl := by
      calc
        _ = eA.hom ≫ stalkBaseChangeResidueMap (K := K) f x ≫
              residueBaseChangeToResidueField f x y rfl := by
          simpa only [Category.assoc] using congrArg (eA.hom ≫ ·) hcomm.symm
        _ = _ := by
          simpa only [Category.assoc] using
            congrArg (· ≫ residueBaseChangeToResidueField f x y rfl) hθcat
    exact congrArg CommRingCat.Hom.hom hc
  have hpA : pA =
      RingHom.ker ((Y.residue y).hom.comp (stalkBaseChangeToStalk f x y rfl).hom) := by
    change Ideal.comap (stalkBaseChangeResidueMap (K := K) f x).hom
      (RingHom.ker (residueBaseChangeToResidueField f x y rfl).hom) = _
    rw [RingHom.comap_ker]
    exact congrArg (RingHom.ker ∘ CommRingCat.Hom.hom) hcomm
  have hqA : RingHom.ker ρ = pA.comap eA.hom.hom := by
    rw [hpA, ← RingHom.comap_ker]
    rfl
  let q := RingHom.ker ρ
  have : q.IsPrime := RingHom.ker_isPrime _
  let eALoc : Localization.AtPrime q ≃+* Localization.AtPrime pA :=
    Localization.localRingEquiv q pA eA.commRingCatIsoToRingEquiv hqA
  let eS : Y.presheaf.stalk y ≃+* Localization.AtPrime q := eLoc.trans eALoc.symm
  have hFc : CommRingCat.ofHom (algebraMap R (R ⊗[k] K)) ≫ eA.hom ≫
      stalkBaseChangeToStalk f x y rfl = F.stalkMap y := by
    rw [show CommRingCat.ofHom (algebraMap R (R ⊗[k] K)) =
      CommRingCat.ofHom (Algebra.TensorProduct.includeLeftRingHom
        (R := k) (A := R) (B := K)) from rfl]
    rw [← Category.assoc, stalkPushoutTensorIso_inl]
    dsimp only [x] at hφl
    dsimp only [x, F, g] at ⊢
    refine hφl.trans ?_
    simp
  have heLoc (a : A) : eLoc ((stalkBaseChangeToStalk f x y rfl).hom a) =
      algebraMap A (Localization.AtPrime pA) a := by
    exact (IsLocalization.algEquiv pA.primeCompl (Y.presheaf.stalk y)
      (Localization.AtPrime pA)).commutes a
  have heALoc (a : R ⊗[k] K) :
      eALoc (algebraMap (R ⊗[k] K) (Localization.AtPrime q) a) =
        algebraMap A (Localization.AtPrime pA) (eA.hom.hom a) := by
    exact Localization.localRingHom_to_map q pA
      eA.commRingCatIsoToRingEquiv hqA a
  have hsource : eS.toRingHom.comp (F.stalkMap y).hom =
      algebraMap R (Localization.AtPrime q) := by
    apply RingHom.ext
    intro r
    have hFcr : (F.stalkMap y).hom r =
        (stalkBaseChangeToStalk f x y rfl).hom (eA.hom.hom ((algebraMap R (R ⊗[k] K)) r)) := by
      exact (congrArg (fun m : R ⟶ Y.presheaf.stalk y => m.hom r) hFc).symm
    apply eALoc.injective
    change eALoc (eALoc.symm (eLoc ((F.stalkMap y).hom r))) = _
    rw [eALoc.apply_symm_apply, hFcr, heLoc]
    change _ = eALoc ((algebraMap (R ⊗[k] K) (Localization.AtPrime q))
      ((algebraMap R (R ⊗[k] K)) r))
    exact (heALoc _).symm
  let eFibre : (Y.presheaf.stalk y ⧸
      (IsLocalRing.maximalIdeal R).map (F.stalkMap y).hom) ≃+*
      (Localization.AtPrime q ⧸
        (IsLocalRing.maximalIdeal R).map (algebraMap R (Localization.AtPrime q))) :=
    specialFibreCongr (F.stalkMap y).hom
      (algebraMap R (Localization.AtPrime q)) (RingEquiv.refl R) eS hsource
  let eQuot := localTensorSpecialFibreEquiv k R K (Y.residueField y) ρ ψ' hρ
  let eResid : (IsLocalRing.ResidueField R ⊗[k] K) ≃+*
      (Scheme.Pullback.Triplet.ofPoint y).tensor :=
    (eB ≪≫ eT).commRingCatIsoToRingEquiv
  have hresPrime : RingHom.ker ψ' =
      (RingHom.ker (Scheme.Pullback.ofPointTensor y).hom).comap eResid.toRingHom := by
    rw [RingHom.comap_ker]
    exact congrArg RingHom.ker (congrArg CommRingCat.Hom.hom
      (show eB.hom ≫ residueBaseChangeToResidueField f x y rfl =
          (eB ≪≫ eT).hom ≫ Scheme.Pullback.ofPointTensor y by
        simp only [Iso.trans_hom, Category.assoc, hψ]))
  let q₀ := RingHom.ker ψ'
  have : q₀.IsPrime := RingHom.ker_isPrime _
  let p := RingHom.ker (Scheme.Pullback.ofPointTensor y).hom
  have : p.IsPrime := RingHom.ker_isPrime _
  let ePrime : Localization.AtPrime q₀ ≃+* Localization.AtPrime p :=
    Localization.localRingEquiv q₀ p eResid hresPrime
  exact eFibre.trans (eQuot.trans ePrime)

/-- A point of the spectrum of a commutative ring is a prime ideal. -/
local instance primeSpectrum_isPrime (R : CommRingCat.{u}) (z : Spec R) :
    z.asIdeal.IsPrime := z.isPrime

/-- Under the identifications `k ≃ κ(s)` and `K ≃ κ(y)`, the residue-field map of
`Spec K → Spec k` at `y` is the field extension `k → K`. -/
private lemma residueFieldMap_specAlgebraMap_comp_residueFieldEquiv
    (k K : Type u) [Field k] [Field K] [Algebra k K]
    (s : Spec (.of k)) (y : Spec (.of K)) [s.asIdeal.IsPrime] [y.asIdeal.IsPrime]
    (h : Spec.map (CommRingCat.ofHom (algebraMap k K)) y = s) :
    (((Spec.map (CommRingCat.ofHom (algebraMap k K))).residueFieldMap y).hom.comp
        ((Spec (.of k)).residueFieldCongr h).inv.hom).comp
      ((s.asIdeal.algEquivResidueFieldOfField).toRingEquiv.trans
        (Scheme.Spec.residueFieldIso (.of k) s).symm.commRingCatIsoToRingEquiv) =
      ((y.asIdeal.algEquivResidueFieldOfField).toRingEquiv.trans
        (Scheme.Spec.residueFieldIso (.of K) y).symm.commRingCatIsoToRingEquiv).toRingHom.comp
        (algebraMap k K) := by
  let g := Spec.map (CommRingCat.ofHom (algebraMap k K))
  have : (g y).asIdeal.IsPrime := (g y).isPrime
  let eR : k ≃+* (Spec (.of k)).residueField s :=
    (s.asIdeal.algEquivResidueFieldOfField).toRingEquiv.trans
      (Scheme.Spec.residueFieldIso (.of k) s).symm.commRingCatIsoToRingEquiv
  let eC : K ≃+* (Spec (.of K)).residueField y :=
    (y.asIdeal.algEquivResidueFieldOfField).toRingEquiv.trans
      (Scheme.Spec.residueFieldIso (.of K) y).symm.commRingCatIsoToRingEquiv
  let eRg : k ≃+* (Spec (.of k)).residueField (g y) :=
    ((g y).asIdeal.algEquivResidueFieldOfField).toRingEquiv.trans
      (Scheme.Spec.residueFieldIso (.of k) (g y)).symm.commRingCatIsoToRingEquiv
  ext z
  apply (Scheme.Spec.residueFieldIso (.of K) y).commRingCatIsoToRingEquiv.injective
  have hbridge := specResidueFieldMap_bridge
    (CommRingCat.ofHom (algebraMap k K)) y
  have hbridge' := congrArg
    (fun φ => φ ((g y).asIdeal.algEquivResidueFieldOfField z)) hbridge
  have hbridge'' :
      (Scheme.Spec.residueFieldIso (.of K) y).commRingCatIsoToRingEquiv
        ((g.residueFieldMap y).hom (eRg z)) =
      y.asIdeal.algEquivResidueFieldOfField (algebraMap k K z) := by
    rw [Ideal.algEquivResidueFieldOfField_apply,
      Ideal.ResidueField.map_algebraMap] at hbridge'
    change (Scheme.Spec.residueFieldIso (.of K) y).hom.hom
        ((g.residueFieldMap y).hom
          ((Scheme.Spec.residueFieldIso (.of k) (g y)).inv.hom
            ((g y).asIdeal.algEquivResidueFieldOfField z))) =
      (algebraMap K y.asIdeal.ResidueField) (algebraMap k K z) at hbridge'
    simpa [eRg, CategoryTheory.Iso.commRingCatIsoToRingEquiv,
      Ideal.algEquivResidueFieldOfField_apply] using hbridge'
  have htransport : (Scheme.residueFieldCongr h).inv.hom (eR z) = eRg z := by
    simpa [eR, eRg, Scheme.residueFieldCongr] using
      spec_residueFieldEquiv_congr k s (g y) h.symm z
  show (Scheme.Spec.residueFieldIso (.of K) y).commRingCatIsoToRingEquiv
      (g.residueFieldMap y ((Scheme.residueFieldCongr h).inv (eR z))) =
    (Scheme.Spec.residueFieldIso (.of K) y).commRingCatIsoToRingEquiv
      (eC (algebraMap k K z))
  rw [htransport]
  exact hbridge''.trans (by
    simp [eC, RingEquiv.trans_apply, CategoryTheory.Iso.commRingCatIsoToRingEquiv])

private lemma add_right_cancel_of_ne_top {a b c : WithBot ℕ∞} (hc : c ≠ ⊤) (hc' : c ≠ ⊥)
    (h : a + c = b + c) : a = b := by
  induction c using WithBot.recBotCoe with
  | bot => exact False.elim (hc' rfl)
  | coe c =>
    cases c using ENat.recTopCoe with
    | top => exact False.elim (hc rfl)
    | coe c => exact (ENat.WithBot.add_natCast_cancel (c := c)).mp h

/-- The residue-field tensor of a triplet is the pushout of the residue-field maps, with the
base residue field taken at the image of `x`. -/
private lemma isPushout_residueFieldMap_tensor {X Y S : Scheme.{u}} {f : X ⟶ S} {g : Y ⟶ S}
    (T : Scheme.Pullback.Triplet f g) :
    IsPushout (CommRingCat.ofHom (f.residueFieldMap T.x).hom)
      (CommRingCat.ofHom ((g.residueFieldMap T.y).hom.comp
        (S.residueFieldCongr (T.hy.trans T.hx.symm)).inv.hom))
      T.tensorInl T.tensorInr := by
  have hpo₀ : IsPushout
      (CommRingCat.ofHom ((f.residueFieldMap T.x).hom.comp (S.residueFieldCongr T.hx).inv.hom))
      (CommRingCat.ofHom ((g.residueFieldMap T.y).hom.comp (S.residueFieldCongr T.hy).inv.hom))
      T.tensorInl T.tensorInr := IsPushout.of_hasPushout _ _
  apply hpo₀.of_iso (Scheme.residueFieldCongr T.hx.symm) (Iso.refl _) (Iso.refl _) (Iso.refl _)
  · ext z
    simp [Scheme.residueFieldCongr]
  · ext z
    simp [Scheme.residueFieldCongr]
  · simp
  · simp

/-- **The residue-field tensor of the pullback carrier at a point of a base change by a field
extension is the tensor product `κ(x) ⊗[k] K`.** Both are pushouts of the same square of
fields, so the comparison is a ring isomorphism. -/
theorem nonempty_pullbackPointTensorRingEquiv
    (k K : Type u) [Field k] [Field K] [Algebra k K]
    (X : Scheme.{u}) (f : X ⟶ Spec (.of k))
    (y : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})) :
    letI x := (pullback.fst f
      (Spec.map (CommRingCat.ofHom (algebraMap k K)))).base y
    letI : (f x).asIdeal.IsPrime := (f x).isPrime
    letI := ((CommRingCat.ofHom (algebraMap k (f x).asIdeal.ResidueField)) ≫
      (Scheme.Spec.residueFieldIso (.of k) (f x)).inv ≫
      f.residueFieldMap x).hom.toAlgebra
    Nonempty ((Scheme.Pullback.Triplet.ofPoint y).tensor ≃+*
      TensorProduct k (X.residueField x) K) := by
  let g := Spec.map (CommRingCat.ofHom (algebraMap k K))
  let T := Scheme.Pullback.Triplet.ofPoint y
  let R := (Spec (.of k)).residueField (f T.x)
  let A := X.residueField T.x
  let C := (Spec (.of K)).residueField T.y
  let hxy : g T.y = f T.x := T.hy.trans T.hx.symm
  let : T.y.asIdeal.IsPrime := T.y.isPrime
  let : (f T.x).asIdeal.IsPrime := (f T.x).isPrime
  let : (g T.y).asIdeal.IsPrime := (g T.y).isPrime
  let eR : k ≃+* R :=
    ((f T.x).asIdeal.algEquivResidueFieldOfField).toRingEquiv.trans
      (Scheme.Spec.residueFieldIso (.of k) (f T.x)).symm.commRingCatIsoToRingEquiv
  let eC : K ≃+* C :=
    (T.y.asIdeal.algEquivResidueFieldOfField).toRingEquiv.trans
      (Scheme.Spec.residueFieldIso (.of K) T.y).symm.commRingCatIsoToRingEquiv
  let eRg : k ≃+* (Spec (.of k)).residueField (g T.y) :=
    ((g T.y).asIdeal.algEquivResidueFieldOfField).toRingEquiv.trans
      (Scheme.Spec.residueFieldIso (.of k) (g T.y)).symm.commRingCatIsoToRingEquiv
  let a : R →+* A := (f.residueFieldMap T.x).hom
  let b : R →+* C := (g.residueFieldMap T.y).hom.comp
    ((Spec (.of k)).residueFieldCongr hxy).inv.hom
  let i : A →+* T.tensor := T.tensorInl.hom
  let j : K →+* T.tensor := T.tensorInr.hom.comp eC
  have hpo : IsPushout (CommRingCat.ofHom a) (CommRingCat.ofHom b)
      T.tensorInl T.tensorInr := isPushout_residueFieldMap_tensor T
  let := ((CommRingCat.ofHom (algebraMap k (f T.x).asIdeal.ResidueField)) ≫
    (Scheme.Spec.residueFieldIso (.of k) (f T.x)).inv ≫
    f.residueFieldMap T.x).hom.toAlgebra
  have hcommf : a.comp eR = algebraMap k A := RingHom.ext fun _ => rfl
  have hcommg : b.comp eR = eC.toRingHom.comp (algebraMap k K) :=
    residueFieldMap_specAlgebraMap_comp_residueFieldEquiv k K (f T.x) T.y hxy
  have hpo' : IsPushout (CommRingCat.ofHom (algebraMap k A))
      (CommRingCat.ofHom (algebraMap k K)) (CommRingCat.ofHom i) (CommRingCat.ofHom j) := by
    apply hpo.of_iso eR.symm.toCommRingCatIso (Iso.refl _)
      eC.symm.toCommRingCatIso (Iso.refl _)
    · ext z
      simpa using DFunLike.congr_fun hcommf (eR.symm z)
    · ext z
      have hz := DFunLike.congr_fun hcommg (eR.symm z)
      simpa using congrArg eC.symm hz
    · simp [i]
    · ext z
      simp [j]
  let hTensor := CommRingCat.isPushout_tensorProduct k A K
  let e := hpo'.isoIsPushout _ _ hTensor
  exact ⟨e.commRingCatIsoToRingEquiv⟩

private lemma pullback_point_tensor_isReduced
    (k K : Type u) [Field k] [Field K] [Algebra k K]
    (X : Scheme.{u}) (f : X ⟶ Spec (.of k))
    (y : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u}))
    (hreduced :
      let x := (pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap k K)))).base y
      letI : (f x).asIdeal.IsPrime := (f x).isPrime
      letI := ((CommRingCat.ofHom (algebraMap k (f x).asIdeal.ResidueField)) ≫
        (Scheme.Spec.residueFieldIso (.of k) (f x)).inv ≫
        f.residueFieldMap x).hom.toAlgebra
      _root_.IsReduced (TensorProduct k (X.residueField x) K)) :
    _root_.IsReduced (Scheme.Pullback.Triplet.ofPoint y).tensor :=
  (nonempty_pullbackPointTensorRingEquiv k K X f y).elim fun e =>
    isReduced_of_ringEquiv e hreduced

/-- **Stacks Project, Tag 0C50.** Let `X` be locally of finite type over a field `k` and let
`Y = X ×_{Spec k} Spec K` for an extension of fields `K / k`. If a point `y` of `Y` and its image
`x` in `X` have local rings of the same dimension, and the scalar extension `κ(x) ⊗[k] K` of the
residue field at `x` is reduced — for instance if `κ(x) / k` or `K / k` is separable — then the
maximal ideal of `𝒪_{X, x}` generates the maximal ideal of `𝒪_{Y, y}`. -/
@[stacks 0C50]
theorem map_maximalIdeal_stalkMap_eq_of_isReduced_tensorProduct
    (k K : Type u) [Field k] [Field K] [Algebra k K]
    (X : Scheme.{u}) (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f]
    (y : (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u}))
    (hdim :
      ringKrullDim
          (X.presheaf.stalk
            ((pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).base y)) =
        ringKrullDim
          ((pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).presheaf.stalk y))
    (hreduced :
      let x := (pullback.fst f
        (Spec.map (CommRingCat.ofHom (algebraMap k K)))).base y
      letI : (f x).asIdeal.IsPrime := (f x).isPrime
      letI := ((CommRingCat.ofHom (algebraMap k (f x).asIdeal.ResidueField)) ≫
        (Scheme.Spec.residueFieldIso (.of k) (f x)).inv ≫
        f.residueFieldMap x).hom.toAlgebra
      _root_.IsReduced (TensorProduct k (X.residueField x) K)) :
    Ideal.map
        ((pullback.fst f
          (Spec.map (CommRingCat.ofHom (algebraMap k K)))).stalkMap y).hom
        (IsLocalRing.maximalIdeal
          (X.presheaf.stalk
            ((pullback.fst f
              (Spec.map (CommRingCat.ofHom (algebraMap k K)))).base y))) =
      IsLocalRing.maximalIdeal
        ((pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K)))).presheaf.stalk y) :=
  let Y := (pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))) : Scheme.{u})
  let : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  let g : Y ⟶ X := pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))
  let x := g.base y
  let I := Ideal.map (g.stalkMap y).hom (IsLocalRing.maximalIdeal (X.presheaf.stalk x))
  let B := Y.presheaf.stalk y
  have hdimfiber : ringKrullDim (B ⧸ I) = 0 := by
    have hformula := fiberLocalRing_dimension_add_localRing_dimension_eq k K X f y
    dsimp [Y, g, x, I, B] at hformula ⊢
    rw [← hdim] at hformula
    exact add_right_cancel_of_ne_top ringKrullDim_ne_top ringKrullDim_ne_bot
      (by simpa using hformula)
  let p := RingHom.ker (Scheme.Pullback.ofPointTensor y).hom
  let : p.IsPrime := RingHom.ker_isPrime _
  let : _root_.IsReduced (B ⧸ I) := isReduced_of_ringEquiv
    (specialFibreRingEquiv k K f y) (isReduced_localizationPreserves (Ideal.primeCompl p) _
      (pullback_point_tensor_isReduced k K X f y hreduced))
  let : Nontrivial (B ⧸ I) := Ideal.Quotient.nontrivial_iff.mpr
    (IsLocalRing.map_maximalIdeal_lt_top (g.stalkMap y).hom).ne
  let : IsLocalRing (B ⧸ I) := IsLocalRing.of_surjective' _ Ideal.Quotient.mk_surjective
  have hfield : IsField (B ⧸ I) := by
    let : Ring.KrullDimLE 0 (B ⧸ I) := ringKrullDimZero_iff_ringKrullDim_eq_zero.mpr hdimfiber
    exact Ring.KrullDimLE.isField_of_isReduced
  by
    show I = IsLocalRing.maximalIdeal B
    exact IsLocalRing.eq_maximalIdeal
      ((Ideal.Quotient.maximal_ideal_iff_isField_quotient I).mpr hfield)

end AlgebraicGeometry

