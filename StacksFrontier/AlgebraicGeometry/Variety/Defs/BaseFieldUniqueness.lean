/-!
# Uniqueness of the base field

A scheme can be locally of finite type over two different fields.  Stacks Tag 04MK says that if
the scheme is reduced and connected then the two fields nevertheless single out the same subring
of its global sections, namely their common integral closure there.

## Main definitions

No new definitions are introduced.

## Main results

* `AlgebraicGeometry.integralClosure_baseField_toSubring_eq`: the integral closures of two base
  fields in the global sections of a reduced connected scheme which is locally of finite type over
  each of them are the same subring of those global sections.

## Implementation notes

The two closures are `Subalgebra`s over different base rings, so they cannot be compared with `=`
directly.  The conclusion is therefore an equality of the underlying subrings, taken with
`Subalgebra.toSubring`: that coercion forgets exactly the base-ring action, which is the one thing
differing between the two sides, and it lands both in `Subring Γ(X, 𝒪_X)`, where `=` is a genuine
equality of subobjects of the global sections and entails equality of the underlying sets.  It is
therefore strictly stronger than an isomorphism of the two fields.  The algebra structure on the
global sections is the one induced contravariantly by the given structure morphism, as in Tag
04MI.

Both inclusions come from one lemma applied twice.  Being locally of finite type over a field
makes the scheme locally Noetherian (Tags 01T6 and 01OZ), hence locally connected with
quasi-compact connected opens (Tags 04ME, 04MF and 04ZB), so such opens cover it.  Over one of
them the two closures agree: Tag 04L7 makes the invertible global functions modulo either closure
a finitely generated group, so the units of one closure modulo those of the intersection of the
two are finitely generated as well, and the Hilbert Nullstellensatz then makes each closure finite
over that intersection; as each closure is integrally closed in the global sections, it absorbs
the other.

The passage from those opens to the whole scheme goes through the nonvanishing locus rather than
through chains of overlapping opens.  A monic polynomial over the second field which kills a
section on one quasi-compact connected open kills it globally: near every point the value of that
polynomial lies in the integral closure of the second field, which is a field by Tag 04MI, so that
value is locally either zero or a unit; its nonvanishing locus is therefore clopen, and
connectedness of the scheme makes it empty.

## References

* [Stacks Project, Tag 04MK](https://stacks.math.columbia.edu/tag/04MK)
* [Stacks Project, Tag 04L7](https://stacks.math.columbia.edu/tag/04L7)
* [Stacks Project, Tag 04MI](https://stacks.math.columbia.edu/tag/04MI)
-/

@[expose] public section

open CategoryTheory TopologicalSpace

universe u

namespace AlgebraicGeometry

/-- A subgroup of a finitely generated commutative group is finitely generated, because such a
group is a Noetherian `ℤ`-module. -/
private theorem subgroup_fg_of_group_fg {G : Type*} [Group G] (hcomm : ∀ x y : G, x * y = y * x)
    (hG : Group.FG G) (H : Subgroup G) : H.FG := by
  let _ : CommGroup G := { ‹Group G› with mul_comm := hcomm }
  have : Module.Finite ℤ (Additive G) :=
    Module.Finite.iff_addGroup_fg.mpr (GroupFG.iff_add_fg.mp hG)
  refine (Subgroup.fg_iff_add_fg H).2 ?_
  rw [← AddSubgroup.toIntSubmodule_toAddSubgroup (Subgroup.toAddSubgroup H),
    ← Submodule.fg_iff_addSubgroup_fg]
  exact _root_.IsNoetherian.noetherian _

/-- If the target of a homomorphism is a finitely generated commutative group, the source is
generated by the kernel together with finitely many elements: lift a finite generating set of the
image. -/
private theorem exists_finite_mul_ker_eq {G Q : Type*} [Group G] [Group Q]
    (hcomm : ∀ x y : Q, x * y = y * x) (hQ : Group.FG Q) (ψ : G →* Q) :
    ∃ T : Set G, T.Finite ∧
      ∀ u : G, ∃ h ∈ ψ.ker, ∃ w ∈ Subgroup.closure T, u = h * w := by
  classical
  obtain ⟨S, hS, hSfin⟩ := (Subgroup.fg_iff _).1 (subgroup_fg_of_group_fg hcomm hQ ψ.range)
  have : Finite S := hSfin
  have hmem : ∀ s : S, (s : Q) ∈ ψ.range := fun s => hS ▸ Subgroup.subset_closure s.2
  let lift : S → G := fun s => Classical.choose (hmem s)
  have hliftspec (s : S) : ψ (lift s) = (s : Q) := Classical.choose_spec (hmem s)
  refine ⟨Set.range lift, Set.finite_range lift, fun u => ?_⟩
  have hu : ψ u ∈ Subgroup.closure (S : Set Q) := hS ▸ ⟨u, rfl⟩
  have hex : ∃ w ∈ Subgroup.closure (Set.range lift), ψ w = ψ u := by
    refine Subgroup.closure_induction
      (p := fun y _ => ∃ w ∈ Subgroup.closure (Set.range lift), ψ w = y)
      (fun z hz => ⟨lift ⟨z, hz⟩, Subgroup.subset_closure ⟨⟨z, hz⟩, rfl⟩, hliftspec ⟨z, hz⟩⟩)
      ⟨1, Subgroup.one_mem _, map_one ψ⟩
      (fun _ _ _ _ ⟨w, hw, hwz⟩ ⟨w', hw', hwz'⟩ =>
        ⟨w * w', Subgroup.mul_mem _ hw hw', by rw [map_mul, hwz, hwz']⟩)
      (fun _ _ ⟨w, hw, hwz⟩ => ⟨w⁻¹, Subgroup.inv_mem _ hw, by rw [map_inv, hwz]⟩) hu
  obtain ⟨w, hw, hwu⟩ := hex
  refine ⟨u * w⁻¹, ?_, w, hw, by group⟩
  simp [MonoidHom.mem_ker, map_mul, map_inv, hwu]

/-- **The Hilbert Nullstellensatz step.**  If `L` is a field over a Jacobson ring `K` whose units
are the `K`-multiples of a group generated by finitely many units, then `L` is a finite
`K`-module: those units and their inverses generate `L` as a `K`-algebra. -/
private theorem finite_of_units_generated (K L : Type*) [CommRing K] [IsJacobsonRing K]
    [Field L] [Algebra K L] (T : Set Lˣ) (hT : T.Finite)
    (hgen : ∀ u : Lˣ, ∃ c : K, ∃ w ∈ Subgroup.closure T,
      (u : L) = algebraMap K L c * (w : L)) :
    Module.Finite K L := by
  classical
  let gens : Set L :=
    (fun w : Lˣ => (w : L)) '' T ∪ (fun w : Lˣ => ((w⁻¹ : Lˣ) : L)) '' T
  have hgensfin : gens.Finite := (hT.image _).union (hT.image _)
  let B : Subalgebra K L := Algebra.adjoin K gens
  let V : Subgroup Lˣ :=
    { carrier := fun u => (u : L) ∈ B ∧ ((u⁻¹ : Lˣ) : L) ∈ B
      one_mem' := ⟨by simp, by simp⟩
      mul_mem' := fun {u v} hu hv =>
        ⟨by simpa using B.mul_mem hu.1 hv.1,
          by simpa [mul_inv_rev] using B.mul_mem hv.2 hu.2⟩
      inv_mem' := fun {u} hu => ⟨hu.2, by simpa using hu.1⟩ }
  have hTV : T ⊆ V := fun w hw =>
    ⟨Algebra.subset_adjoin (Set.mem_union_left _ ⟨w, hw, rfl⟩),
      Algebra.subset_adjoin (Set.mem_union_right _ ⟨w, hw, rfl⟩)⟩
  have hBtop : B = ⊤ := by
    refine top_unique fun x _ => ?_
    by_cases hx : x = 0
    · simp [hx]
    · obtain ⟨c, w, hw, hxw⟩ := hgen (Units.mk0 x hx)
      rw [show x = algebraMap K L c * (w : L) by simpa using hxw]
      exact B.mul_mem (B.algebraMap_mem c) ((Subgroup.closure_le V).2 hTV hw).1
  have : Algebra.FiniteType K B := Algebra.FiniteType.adjoin_of_finite hgensfin
  have : Algebra.FiniteType K L :=
    Algebra.FiniteType.of_surjective B.val fun y => ⟨⟨y, by rw [hBtop]; trivial⟩, rfl⟩
  exact finite_of_finite_type_of_isJacobsonRing K L

/-- The intersection of two subrings which are fields is a field: an element of the intersection
is invertible in each, and the two inverses agree because both invert it in the ambient ring. -/
private theorem isField_inf {R : Type u} [CommRing R] (A B : Subring R)
    (hA : IsField (↥A)) (hB : IsField (↥B)) : IsField (↥(A ⊓ B)) := by
  classical
  have hone : (1 : ↥(A ⊓ B)) ≠ 0 := by
    intro h
    have : Subsingleton R :=
      subsingleton_of_zero_eq_one (congrArg (fun z : ↥(A ⊓ B) => (z : R)) h).symm
    obtain ⟨x, y, hxy⟩ := hA.nontrivial.exists_pair_ne
    exact hxy (Subtype.ext (Subsingleton.elim _ _))
  refine ⟨⟨1, 0, hone⟩, mul_comm, ?_⟩
  intro x hx
  have hm := Subring.mem_inf.mp x.2
  have hxA : (⟨x.1, hm.1⟩ : ↥A) ≠ 0 := fun h =>
    hx (Subtype.ext (congrArg (fun z : ↥A => (z : R)) h))
  have hxB : (⟨x.1, hm.2⟩ : ↥B) ≠ 0 := fun h =>
    hx (Subtype.ext (congrArg (fun z : ↥B => (z : R)) h))
  obtain ⟨ya, hya⟩ := hA.mul_inv_cancel hxA
  obtain ⟨yb, hyb⟩ := hB.mul_inv_cancel hxB
  have hyaR : (x.1 : R) * (ya : R) = 1 := congrArg Subtype.val hya
  have hybR : (x.1 : R) * (yb : R) = 1 := congrArg Subtype.val hyb
  have hyab : (ya : R) = (yb : R) := by
    calc (ya : R) = (ya : R) * ((x.1 : R) * (yb : R)) := by rw [hybR, mul_one]
      _ = ((x.1 : R) * (ya : R)) * (yb : R) := by ring
      _ = (yb : R) := by rw [hyaR, one_mul]
  exact ⟨⟨(ya : R), Subring.mem_inf.mpr ⟨ya.2, hyab ▸ yb.2⟩⟩, Subtype.ext hyaR⟩

/-- If the invertible elements of a ring modulo the units of a subring `B` form a finitely
generated group and `A`, `B` are subrings which are fields, then `A` is a finite module over
`A ⊓ B`: the units of `A` lying in that kernel are exactly the units of `A ⊓ B`. -/
private theorem finite_of_fg_units_quotient_inf {R : Type u} [CommRing R] (A B : Subring R)
    (hA : IsField (↥A)) (hB : IsField (↥B))
    (hfg : Group.FG (Rˣ ⧸ (Units.map B.subtype.toMonoidHom).range)) :
    letI : Algebra (↥(A ⊓ B)) (↥A) :=
      (Subring.inclusion (inf_le_left : A ⊓ B ≤ A)).toAlgebra
    Module.Finite (↥(A ⊓ B)) (↥A) := by
  classical
  let _ : Field ↥A := hA.toField
  let _ : Field ↥B := hB.toField
  let _ : Field ↥(A ⊓ B) := (isField_inf A B hA hB).toField
  let _ : Algebra ↥(A ⊓ B) ↥A := (Subring.inclusion (inf_le_left : A ⊓ B ≤ A)).toAlgebra
  let ψ : (↥A)ˣ →* Rˣ ⧸ (Units.map B.subtype.toMonoidHom).range :=
    (QuotientGroup.mk' _).comp (Units.map A.subtype.toMonoidHom)
  obtain ⟨T, hTfin, hTgen⟩ := exists_finite_mul_ker_eq (fun x y => mul_comm x y) hfg ψ
  refine finite_of_units_generated ↥(A ⊓ B) ↥A T hTfin fun u => ?_
  obtain ⟨h, hh, w, hw, huhw⟩ := hTgen u
  have hhB : ((h : ↥A) : R) ∈ B := by
    obtain ⟨v, hv⟩ := MonoidHom.mem_range.mp ((QuotientGroup.eq_one_iff _).mp hh)
    rw [show ((h : ↥A) : R) = ((v : ↥B) : R) by simpa using (congrArg Units.val hv).symm]
    exact (v : ↥B).2
  refine ⟨⟨((h : ↥A) : R), Subring.mem_inf.mpr ⟨(h : ↥A).2, hhB⟩⟩, w, hw, ?_⟩
  refine Subtype.ext ?_
  rw [huhw]
  rfl

/-- **Tag 04L7 at the integral closure of the ground field.**  On a quasi-compact connected
reduced scheme locally of finite type over `k`, the invertible global functions modulo the units
of the integral closure of `k` in them form a finitely generated abelian group.

That closure is a field by Tag 04MI and is integrally closed in the global sections, so the
scheme is locally of finite type over it and condition (1) of Tag 04L7 holds for it. -/
private theorem fg_units_quotient_integralClosure (k : Type u) [Field k] (X : Scheme.{u})
    (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f] [ConnectedSpace X] [IsReduced X]
    [CompactSpace X] :
    letI : Algebra k Γ(X, ⊤) := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom.toAlgebra
    Group.FG (Γ(X, ⊤)ˣ ⧸ (Units.map
      ((integralClosure k Γ(X, ⊤)).toSubring.subtype).toMonoidHom).range) := by
  let fk := ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom
  let _ : Algebra k Γ(X, ⊤) := fk.toAlgebra
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have : NoetherianSpace X := noetherianSpace_of_isLocallyNoetherianSpace X
    (isLocallyNoetherianSpace_of_isLocallyNoetherian X)
  let A : Subalgebra k Γ(X, ⊤) := integralClosure k Γ(X, ⊤)
  let _ : Field ↥A := (integralClosure_globalSections_isField k X f).toField
  let φ : ↥A →+* Γ(X, ⊤) := A.val
  let g : X ⟶ Spec (.of ↥A) :=
    ΓSpec.adjunction.homEquiv X (Opposite.op (.of ↥A)) (CommRingCat.ofHom φ).op
  have hg : (Scheme.ΓSpecIso (.of ↥A)).inv ≫ g.appTop = CommRingCat.ofHom φ :=
    ΓSpecIso_inv_ΓSpec_adjunction_homEquiv (CommRingCat.ofHom φ)
  have hmap : ((Scheme.ΓSpecIso (.of ↥A)).inv ≫ g.appTop).hom = φ :=
    congrArg CommRingCat.Hom.hom hg
  let q : Spec (.of ↥A) ⟶ Spec (.of k) := Spec.map (CommRingCat.ofHom (algebraMap k ↥A))
  have hfactor : g ≫ q = f := by
    apply AlgebraicGeometry.ext_to_Spec
    show (Scheme.ΓSpecIso (.of k)).inv ≫
      (Spec.map (CommRingCat.ofHom (algebraMap k ↥A))).appTop ≫ g.appTop = _
    rw [← Category.assoc, ← Scheme.ΓSpecIso_inv_naturality
      (CommRingCat.ofHom (algebraMap k ↥A)), Category.assoc, hg]
    show CommRingCat.ofHom (φ.comp (algebraMap k ↥A)) =
      (Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop
    apply CommRingCat.Hom.ext
    ext x
    show (algebraMap k Γ(X, ⊤)) x = fk x
    rfl
  have : LocallyOfFiniteType (g ≫ q) := hfactor ▸ (inferInstance : LocallyOfFiniteType f)
  have : LocallyOfFiniteType g := locallyOfFiniteType_of_comp g q
  let _ : Algebra ↥A Γ(X, ⊤) := φ.toAlgebra
  have hclosed : integralClosure ↥A Γ(X, ⊤) = ⊥ := by
    show integralClosure ↥(integralClosure k Γ(X, ⊤)) Γ(X, ⊤) = ⊥
    exact integralClosure_idem (R := k) (A := Γ(X, ⊤))
  have h1 : ∀ x : Γ(X, ⊤), φ.IsIntegralElem x → x ∈ Set.range φ := by
    intro x hx
    have hmem : x ∈ integralClosure ↥A Γ(X, ⊤) := hx
    rwa [hclosed, Algebra.mem_bot] at hmem
  have hfg := fg_units_quotient_of_integrallyClosed ↥A X g
    NoetherianSpace.finite_irreducibleComponents (by simpa only [hmap] using h1)
  rwa [hmap] at hfg

/-- In a locally Noetherian space every point has a quasi-compact connected open neighbourhood:
a Noetherian neighbourhood has finitely many connected components, so the one containing the point
is open, and it is quasi-compact because the neighbourhood is Noetherian. -/
private theorem exists_isCompact_isConnected_opens_mem (Y : Scheme.{u})
    (hY : IsLocallyNoetherianSpace Y) (y : Y) :
    ∃ V : Y.Opens, y ∈ V ∧ IsCompact (V : Set Y) ∧ _root_.IsConnected (V : Set Y) := by
  obtain ⟨W, hWopen, hyW, hWnoeth⟩ := hY y
  have : NoetherianSpace W := hWnoeth
  have : Finite (ConnectedComponents W) := NoetherianSpace.finite_connectedComponents W
  have hC : IsClopen (connectedComponent (⟨y, hyW⟩ : W)) :=
    isClopen_connectedComponent_of_finite_connectedComponents _
  have hmem : y ∈ Subtype.val '' connectedComponent (⟨y, hyW⟩ : W) :=
    ⟨⟨y, hyW⟩, mem_connectedComponent, rfl⟩
  refine ⟨(⟨Subtype.val '' connectedComponent (⟨y, hyW⟩ : W), ?_⟩ : Y.Opens), hmem, ?_, ?_⟩
  · exact hWopen.isOpenMap_subtype_val _ hC.2
  · exact (NoetherianSpace.isCompact _).image continuous_subtype_val
  · exact ⟨⟨y, hmem⟩, ((isConnected_connectedComponent
      (x := (⟨y, hyW⟩ : W))).image _ continuous_subtype_val.continuousOn).isPreconnected⟩

/-- The structure map on the global sections of an open subscheme is the restriction of the
structure map of the ambient scheme. -/
private theorem appTop_opens_structureMap {k : Type u} [CommRing k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (V : X.Opens) :
    ((Scheme.ΓSpecIso (.of k)).inv ≫ (V.ι ≫ f).appTop).hom
      = V.ι.appTop.hom.comp ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom := by
  simp only [Scheme.Hom.comp_appTop]
  rfl

/-- A polynomial with coefficients in `R` evaluated at an element integral over `R` is again
integral over `R`. -/
private theorem eval₂_mem_integralClosure {R S : Type*} [CommRing R] [CommRing S] (f : R →+* S)
    {x : S} (hx : f.IsIntegralElem x) (p : Polynomial R) :
    letI : Algebra R S := f.toAlgebra
    Polynomial.eval₂ f x p ∈ integralClosure R S := by
  let _ : Algebra R S := f.toAlgebra
  exact Algebra.adjoin_singleton_le (show x ∈ integralClosure R S from hx)
    (Polynomial.aeval_mem_adjoin_singleton R x)

/-- **The quasi-compact case of Tag 04MK, one inclusion.**  On a quasi-compact connected reduced
scheme locally of finite type over two fields, a global section integral over the first is
integral over the second.

Both integral closures are fields by Tag 04MI, and Tag 04L7 makes the invertible global functions
modulo the second closure finitely generated.  Hence the units of the first closure modulo those
of the intersection are finitely generated, so the first closure is finite — in particular
integral — over the intersection by the Hilbert Nullstellensatz.  The second closure is
integrally closed in the global sections, so it absorbs the first. -/
private theorem isIntegralElem_of_isIntegralElem_of_compactSpace
    (k₁ k₂ : Type u) [Field k₁] [Field k₂] (X : Scheme.{u})
    (a : X ⟶ Spec (.of k₁)) (b : X ⟶ Spec (.of k₂))
    [LocallyOfFiniteType a] [LocallyOfFiniteType b] [IsReduced X] [ConnectedSpace X]
    [CompactSpace X] (s : Γ(X, ⊤))
    (hs : ((Scheme.ΓSpecIso (.of k₁)).inv ≫ a.appTop).hom.IsIntegralElem s) :
    ((Scheme.ΓSpecIso (.of k₂)).inv ≫ b.appTop).hom.IsIntegralElem s := by
  let _ : Algebra k₁ Γ(X, ⊤) := ((Scheme.ΓSpecIso (.of k₁)).inv ≫ a.appTop).hom.toAlgebra
  let _ : Algebra k₂ Γ(X, ⊤) := ((Scheme.ΓSpecIso (.of k₂)).inv ≫ b.appTop).hom.toAlgebra
  let S₁ : Subring Γ(X, ⊤) := (integralClosure k₁ Γ(X, ⊤)).toSubring
  let S₂ : Subring Γ(X, ⊤) := (integralClosure k₂ Γ(X, ⊤)).toSubring
  have hS₁ : IsField ↥S₁ := integralClosure_globalSections_isField k₁ X a
  have hS₂ : IsField ↥S₂ := integralClosure_globalSections_isField k₂ X b
  let _ : Field ↥(S₁ ⊓ S₂) := (isField_inf S₁ S₂ hS₁ hS₂).toField
  let _ : Algebra ↥(S₁ ⊓ S₂) ↥S₁ :=
    (Subring.inclusion (inf_le_left : S₁ ⊓ S₂ ≤ S₁)).toAlgebra
  have : Module.Finite ↥(S₁ ⊓ S₂) ↥S₁ :=
    finite_of_fg_units_quotient_inf S₁ S₂ hS₁ hS₂ (fg_units_quotient_integralClosure k₂ X b)
  have : Algebra.IsIntegral ↥(S₁ ⊓ S₂) ↥S₁ := Algebra.IsIntegral.of_finite _ _
  let _ : Algebra ↥S₁ Γ(X, ⊤) := S₁.subtype.toAlgebra
  let _ : Algebra ↥S₂ Γ(X, ⊤) := S₂.subtype.toAlgebra
  let _ : Algebra ↥(S₁ ⊓ S₂) Γ(X, ⊤) := (S₁ ⊓ S₂).subtype.toAlgebra
  have : IsScalarTower ↥(S₁ ⊓ S₂) ↥S₁ Γ(X, ⊤) := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have hCs : (S₁ ⊓ S₂).subtype.IsIntegralElem s :=
    isIntegral_trans (R := ↥(S₁ ⊓ S₂)) (A := ↥S₁) s
      (isIntegral_algebraMap (R := ↥S₁) (A := Γ(X, ⊤)) (x := (⟨s, hs⟩ : ↥S₁)))
  have hS₂s : S₂.subtype.IsIntegralElem s :=
    RingHom.IsIntegralElem.of_comp
      (f := Subring.inclusion (inf_le_right : S₁ ⊓ S₂ ≤ S₂)) (g := S₂.subtype) hCs
  have hclosed : integralClosure ↥S₂ Γ(X, ⊤) = ⊥ := by
    show integralClosure ↥(integralClosure k₂ Γ(X, ⊤)) Γ(X, ⊤) = ⊥
    exact integralClosure_idem (R := k₂) (A := Γ(X, ⊤))
  have hmem : s ∈ integralClosure ↥S₂ Γ(X, ⊤) := hS₂s
  rw [hclosed, Algebra.mem_bot] at hmem
  obtain ⟨y, hy⟩ := hmem
  exact hy ▸ (y : ↥S₂).2

/-- A global section of a connected reduced scheme which near every point restricts either to zero
or to a unit, and which restricts to zero on some nonempty open, is zero: its nonvanishing locus
is then clopen and misses a point. -/
private theorem eq_zero_of_forall_locally_eq_zero_or_isUnit {X : Scheme.{u}} [IsReduced X]
    [ConnectedSpace X] (q : Γ(X, ⊤))
    (hloc : ∀ x : X, ∃ V : X.Opens, x ∈ V ∧
      (V.ι.appTop.hom q = 0 ∨ IsUnit (V.ι.appTop.hom q)))
    (U : X.Opens) (hUne : (U : Set X).Nonempty) (hU : U.ι.appTop.hom q = 0) : q = 0 := by
  classical
  have hzero : ∀ V : X.Opens, V.ι.appTop.hom q = 0 → ∀ x ∈ V, x ∉ X.basicOpen q := by
    intro V hV x hxV hx
    have hpre := V.ι.preimage_basicOpen_top q
    rw [hV, Scheme.basicOpen_zero] at hpre
    have hxmem : (⟨x, hxV⟩ : V.toScheme) ∈ V.ι ⁻¹ᵁ X.basicOpen q := hx
    rwa [hpre] at hxmem
  have hunit : ∀ V : X.Opens, IsUnit (V.ι.appTop.hom q) → ∀ x ∈ V, x ∈ X.basicOpen q := by
    intro V hV x hxV
    have hpre := V.ι.preimage_basicOpen_top q
    rw [Scheme.basicOpen_of_isUnit _ hV] at hpre
    have hxmem : (⟨x, hxV⟩ : V.toScheme) ∈ V.ι ⁻¹ᵁ X.basicOpen q := by
      rw [hpre]
      trivial
    exact hxmem
  have hopen : IsOpen ((X.basicOpen q : Set X)ᶜ) := by
    refine isOpen_iff_forall_mem_open.mpr fun x hx => ?_
    obtain ⟨V, hxV, hor⟩ := hloc x
    have hV0 : V.ι.appTop.hom q = 0 := hor.resolve_right fun hu => hx (hunit V hu x hxV)
    exact ⟨(V : Set X), fun z hz => hzero V hV0 z hz, V.isOpen, hxV⟩
  have hclopen : IsClopen (X.basicOpen q : Set X) :=
    ⟨isOpen_compl_iff.mp hopen, (X.basicOpen q).isOpen⟩
  obtain ⟨x₀, hx₀⟩ := hUne
  have hbot : X.basicOpen q = ⊥ := by
    refine SetLike.ext' ?_
    by_contra hne
    obtain ⟨z, hz⟩ := Set.nonempty_iff_ne_empty.mpr hne
    have huniv : (X.basicOpen q : Set X) = Set.univ := IsClopen.eq_univ hclopen ⟨z, hz⟩
    have hmemset : x₀ ∈ (X.basicOpen q : Set X) := by
      rw [huniv]
      trivial
    exact hzero U hU x₀ hx₀ hmemset
  exact (basicOpen_eq_bot_iff q).mp hbot

/-- Evaluating a polynomial over the base field at a global section commutes with restriction to
an open subscheme. -/
private theorem appTop_opens_eval₂ {k : Type u} [CommRing k] {X : Scheme.{u}}
    (f : X ⟶ Spec (.of k)) (V : X.Opens) (s : Γ(X, ⊤)) (P : Polynomial k) :
    V.ι.appTop.hom (Polynomial.eval₂ ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop).hom s P) =
      Polynomial.eval₂ ((Scheme.ΓSpecIso (.of k)).inv ≫ (V.ι ≫ f).appTop).hom
        (V.ι.appTop.hom s) P := by
  rw [appTop_opens_structureMap]
  exact Polynomial.hom_eval₂ P _ V.ι.appTop.hom s

/-- A global section integral over `k₁` restricts, on a quasi-compact connected open, to a section
integral over `k₂`, by the quasi-compact case. -/
private theorem isIntegralElem_restrict
    (k₁ k₂ : Type u) [Field k₁] [Field k₂] (X : Scheme.{u})
    (a : X ⟶ Spec (.of k₁)) (b : X ⟶ Spec (.of k₂))
    [LocallyOfFiniteType a] [LocallyOfFiniteType b] [IsReduced X]
    (V : X.Opens) (hVc : IsCompact (V : Set X)) (hVconn : _root_.IsConnected (V : Set X))
    (s : Γ(X, ⊤))
    (hs : ((Scheme.ΓSpecIso (.of k₁)).inv ≫ a.appTop).hom.IsIntegralElem s) :
    ((Scheme.ΓSpecIso (.of k₂)).inv ≫ (V.ι ≫ b).appTop).hom.IsIntegralElem
      (V.ι.appTop.hom s) := by
  let _ : CompactSpace V.toScheme := isCompact_iff_compactSpace.mp hVc
  let _ : ConnectedSpace V.toScheme := isConnected_iff_connectedSpace.mp hVconn
  refine isIntegralElem_of_isIntegralElem_of_compactSpace k₁ k₂ V.toScheme
    (V.ι ≫ a) (V.ι ≫ b) (V.ι.appTop.hom s) ?_
  rw [appTop_opens_structureMap]
  exact hs.map V.ι.appTop.hom

/-- On a quasi-compact connected open subscheme the value of a polynomial over `k₂` at a global
section integral over `k₁` is either zero or a unit: by the quasi-compact case that section is
integral over `k₂` there, so the value lies in the integral closure of `k₂`, a field by Tag
04MI. -/
private theorem eval₂_restrict_eq_zero_or_isUnit
    (k₁ k₂ : Type u) [Field k₁] [Field k₂] (X : Scheme.{u})
    (a : X ⟶ Spec (.of k₁)) (b : X ⟶ Spec (.of k₂))
    [LocallyOfFiniteType a] [LocallyOfFiniteType b] [IsReduced X]
    (V : X.Opens) (hVc : IsCompact (V : Set X)) (hVconn : _root_.IsConnected (V : Set X))
    (s : Γ(X, ⊤))
    (hs : ((Scheme.ΓSpecIso (.of k₁)).inv ≫ a.appTop).hom.IsIntegralElem s)
    (P : Polynomial k₂) :
    V.ι.appTop.hom
        (Polynomial.eval₂ ((Scheme.ΓSpecIso (.of k₂)).inv ≫ b.appTop).hom s P) = 0 ∨
      IsUnit (V.ι.appTop.hom
        (Polynomial.eval₂ ((Scheme.ΓSpecIso (.of k₂)).inv ≫ b.appTop).hom s P)) := by
  classical
  let _ : CompactSpace V.toScheme := isCompact_iff_compactSpace.mp hVc
  let _ : ConnectedSpace V.toScheme := isConnected_iff_connectedSpace.mp hVconn
  have hsV := isIntegralElem_restrict k₁ k₂ X a b V hVc hVconn s hs
  let _ : Algebra k₂ Γ(V.toScheme, ⊤) :=
    ((Scheme.ΓSpecIso (.of k₂)).inv ≫ (V.ι ≫ b).appTop).hom.toAlgebra
  let Sv : Subring Γ(V.toScheme, ⊤) := (integralClosure k₂ Γ(V.toScheme, ⊤)).toSubring
  have hfield : IsField ↥Sv :=
    integralClosure_globalSections_isField k₂ V.toScheme (V.ι ≫ b)
  let _ : Field ↥Sv := hfield.toField
  have hmemSv : V.ι.appTop.hom
      (Polynomial.eval₂ ((Scheme.ΓSpecIso (.of k₂)).inv ≫ b.appTop).hom s P) ∈ Sv := by
    rw [appTop_opens_eval₂]
    exact eval₂_mem_integralClosure _ hsV P
  by_cases hz : (⟨_, hmemSv⟩ : ↥Sv) = 0
  · exact Or.inl (congrArg Subtype.val hz)
  · exact Or.inr ((isUnit_iff_ne_zero.mpr hz).map Sv.subtype)

/-- **Tag 04MK, one inclusion.**  On a connected reduced scheme locally of finite type over two
fields, a global section integral over the first field is integral over the second.

A monic polynomial over `k₂` killing the section on one quasi-compact connected open — produced by
the quasi-compact case — kills it everywhere: near every point its value is zero or a unit, so the
nonvanishing locus of that value is clopen, and connectedness makes it empty. -/
private theorem isIntegralElem_of_isIntegralElem
    (k₁ k₂ : Type u) [Field k₁] [Field k₂] (X : Scheme.{u})
    (a : X ⟶ Spec (.of k₁)) (b : X ⟶ Spec (.of k₂))
    [LocallyOfFiniteType a] [LocallyOfFiniteType b] [IsReduced X] [ConnectedSpace X]
    (s : Γ(X, ⊤))
    (hs : ((Scheme.ΓSpecIso (.of k₁)).inv ≫ a.appTop).hom.IsIntegralElem s) :
    ((Scheme.ΓSpecIso (.of k₂)).inv ≫ b.appTop).hom.IsIntegralElem s := by
  classical
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian a
  have hlocn : IsLocallyNoetherianSpace X := isLocallyNoetherianSpace_of_isLocallyNoetherian X
  obtain ⟨V₀, hx₀V₀, hV₀c, hV₀conn⟩ :=
    exists_isCompact_isConnected_opens_mem X hlocn (Classical.arbitrary X)
  obtain ⟨P, hPmonic, hPeval⟩ := isIntegralElem_restrict k₁ k₂ X a b V₀ hV₀c hV₀conn s hs
  refine ⟨P, hPmonic, ?_⟩
  refine eq_zero_of_forall_locally_eq_zero_or_isUnit _ (fun x => ?_) V₀
    ⟨Classical.arbitrary X, hx₀V₀⟩ ?_
  · obtain ⟨V, hxV, hVc, hVconn⟩ := exists_isCompact_isConnected_opens_mem X hlocn x
    exact ⟨V, hxV, eval₂_restrict_eq_zero_or_isUnit k₁ k₂ X a b V hVc hVconn s hs P⟩
  · rw [appTop_opens_eval₂, hPeval]

/-- **Stacks Project, Tag 04MK (Uniqueness of base field).**  Let `X` be a reduced connected
scheme which is locally of finite type over a field `k₁` and also over a field `k₂`.  Then the
integral closure of `k₁` in `Γ(X, 𝒪_X)` and the integral closure of `k₂` in `Γ(X, 𝒪_X)` are the
same subring of `Γ(X, 𝒪_X)`.

Each inclusion is `isIntegralElem_of_isIntegralElem`: locally of finite type over a field makes
`X` locally Noetherian, hence covered by quasi-compact connected opens, and on such an open the
two closures agree because Tag 04L7 makes the invertible global functions modulo either closure
finitely generated, which by the Hilbert Nullstellensatz forces each closure to be finite over
their intersection.  A monic polynomial over `k₂` killing a section on one such open then kills it
globally, since its value is everywhere locally zero or a unit — the closures are fields by Tag
04MI — so its nonvanishing locus is clopen and `X` is connected. -/
@[stacks 04MK]
theorem integralClosure_baseField_toSubring_eq (k₁ k₂ : Type u) [Field k₁] [Field k₂]
    (X : Scheme.{u}) (a : X ⟶ Spec (.of k₁)) (b : X ⟶ Spec (.of k₂))
    [LocallyOfFiniteType a] [LocallyOfFiniteType b] [IsReduced X] [ConnectedSpace X] :
    letI : Algebra k₁ Γ(X, ⊤) := ((Scheme.ΓSpecIso (.of k₁)).inv ≫ a.appTop).hom.toAlgebra
    letI : Algebra k₂ Γ(X, ⊤) := ((Scheme.ΓSpecIso (.of k₂)).inv ≫ b.appTop).hom.toAlgebra
    (integralClosure k₁ Γ(X, ⊤)).toSubring = (integralClosure k₂ Γ(X, ⊤)).toSubring := by
  let _ : Algebra k₁ Γ(X, ⊤) := ((Scheme.ΓSpecIso (.of k₁)).inv ≫ a.appTop).hom.toAlgebra
  let _ : Algebra k₂ Γ(X, ⊤) := ((Scheme.ΓSpecIso (.of k₂)).inv ≫ b.appTop).hom.toAlgebra
  exact le_antisymm (fun x hx => isIntegralElem_of_isIntegralElem k₁ k₂ X a b x hx)
    (fun x hx => isIntegralElem_of_isIntegralElem k₂ k₁ X b a x hx)

end AlgebraicGeometry

