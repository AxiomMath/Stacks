/-!
# Dimension of an intersection in affine space

Let `k` be a field and let `X` and `Y` be closed subsets of affine `n`-space over `k`, both
equidimensional, of dimensions `r` and `s`. Then every irreducible component of `X ∩ Y` has
dimension at least `r + s - n`.

## Main results

* `AlgebraicGeometry.add_le_add_topologicalKrullDim_irreducibleComponent_inter`: the
  intersection-dimension bound, **Stacks Tag 0B2Q**.
* `AlgebraicGeometry.AffineIntersection.ker_diag`: the diagonal of affine `n`-space is cut out
  by `n` equations, which is the reduction the proof runs on.
* `Ideal.height_le_height_map_add_encard_of_span_eq_ker`: Krull's height theorem read through a
  surjection, the ring-theoretic input.

## Implementation notes

Affine `n`-space over `k` is the prime spectrum of `R = MvPolynomial (Fin n) k`. Closed subsets
and their intersection carry the subspace topology; dimensions are `topologicalKrullDim`, with
values in `WithBot ℕ∞`, and `r`, `s` are natural numbers, which is no restriction because the
dimension of a nonempty closed subset of affine space is a natural number. The bound is written
in the additive form `r + s ≤ n + dim Z`, avoiding truncated subtraction in `WithBot ℕ∞`; it is
equivalent to the stated `dim Z ≥ r + s - n` because an irreducible component is nonempty and so
has dimension at least `0`. No nonemptiness hypothesis is imposed: `X ∩ Y` may be empty, in
which case it has no irreducible components and the statement is vacuous, exactly as in the
source.

The proof is the source's reduction to the diagonal. Write `X = V(I)`, `Y = V(J)` and put
`A = R ⧸ I`, `B = R ⧸ J`, `C = R ⧸ (I + J)`, so that `Spec A`, `Spec B` and `Spec C` are `X`,
`Y` and `X ∩ Y`. The product `X × Y` is `Spec (A ⊗[k] B)`, and the diagonal cuts it down to
`X ∩ Y`: the `k`-algebra map `diag : A ⊗[k] B → C` induced by the two quotient maps is
surjective, and its kernel is generated by the `n` elements `xᵢ ⊗ 1 - 1 ⊗ xᵢ` (`ker_diag`).
That is the Lean form of `X ∩ Y = (X × Y) ∩ V(x₁ - y₁, …, xₙ - yₙ)`, and it needs no
`2n`-variable polynomial ring.

Fix an irreducible component `Z` of `X ∩ Y`. Since `C` is Jacobson and Noetherian, `Z` carries a
closed point `t` lying on no other component, so the dimension of `Spec C` at `t` is the
dimension of `Z` (Stacks Tag 0A21, local dimension as the largest dimension of a component
through the point) and equals the height of the maximal ideal of `t` (Stacks Tag 0A21,
dimension at a closed point). Equidimensionality enters through
`AlgebraicGeometry.topologicalKrullDimAt_eq_of_equidimensional`: it makes the dimension of
`Spec A` at *every* point equal to `r`, and likewise `s` for `Spec B`. Stacks Tag 0B2M part (1)
then gives `r + s` for the dimension of the product at the point `M` above `t`, which is the
height of `M`;
and Krull's height theorem, applied to the `n` generators of the kernel of `diag`, bounds that
height by the height at `t` plus `n`.

## References

* [Stacks Project, Tag 0B2Q](https://stacks.math.columbia.edu/tag/0B2Q)
* [Stacks Project, Tag 0B2M](https://stacks.math.columbia.edu/tag/0B2M)
* [Stacks Project, Tag 0A21](https://stacks.math.columbia.edu/tag/0A21)
* [Stacks Project, Tag 00KW](https://stacks.math.columbia.edu/tag/00KW)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TensorProduct TopologicalSpace
open MvPolynomial (X)

universe u v

/-- **Krull's height theorem through a surjection.** If `δ` is a surjective ring map whose
kernel is generated by a set `s`, and `M` is a prime containing `s`, then the height of `M` is
at most the height of its image plus the cardinality of `s`. This is the iterated form of
Stacks Tag 00KW that the reduction to the diagonal consumes. -/
@[stacks 00KW "through a surjection"]
theorem Ideal.height_le_height_map_add_encard_of_span_eq_ker {T C : Type*} [CommRing T]
    [CommRing C] [IsNoetherianRing T] (δ : T →+* C) (hδ : Function.Surjective δ) (s : Set T)
    (hspan : Ideal.span s = RingHom.ker δ) (M : Ideal T) [M.IsPrime] (hsM : s ⊆ M) :
    M.height ≤ (M.map δ).height + s.encard := by
  obtain ⟨e, he⟩ : ∃ e : T ⧸ Ideal.span s ≃+* C,
      (e : T ⧸ Ideal.span s →+* C).comp (Ideal.Quotient.mk (Ideal.span s)) = δ :=
    ⟨(Ideal.quotEquivOfEq hspan).trans (RingHom.quotientKerEquivOfSurjective hδ), by
      ext t
      simp [RingHom.quotientKerEquivOfSurjective]⟩
  have h := RingEquiv.height_map e (M.map (Ideal.Quotient.mk (Ideal.span s)))
  rw [show Ideal.map e (M.map (Ideal.Quotient.mk (Ideal.span s)))
      = Ideal.map (e : T ⧸ Ideal.span s →+* C) (M.map (Ideal.Quotient.mk (Ideal.span s)))
      from rfl, Ideal.map_map, he] at h
  rw [h]
  exact Ideal.height_le_height_add_encard_of_subset s hsM

namespace AlgebraicGeometry

namespace AffineIntersection

variable {k : Type u} [Field k] {ι : Type v} (I J : Ideal (MvPolynomial ι k))

/-- The *diagonal map*: the `k`-algebra map `R⧸I ⊗[k] R⧸J → R⧸(I + J)` induced by the two
quotient maps. On spectra it is the closed immersion identifying `V(I) ∩ V(J)` with the
intersection of `V(I) × V(J)` with the diagonal. -/
noncomputable def diag :
    (MvPolynomial ι k ⧸ I) ⊗[k] (MvPolynomial ι k ⧸ J) →ₐ[k] MvPolynomial ι k ⧸ (I ⊔ J) :=
  Algebra.TensorProduct.lift (Ideal.Quotient.factorₐ k le_sup_left)
    (Ideal.Quotient.factorₐ k le_sup_right) fun _ _ ↦ Commute.all _ _

/-- The diagonal map on a tensor of classes is the class of the product. -/
@[simp] lemma diag_tmul (a : MvPolynomial ι k ⧸ I) (b : MvPolynomial ι k ⧸ J) :
    diag I J (a ⊗ₜ[k] b) =
      Ideal.Quotient.factorₐ k le_sup_left a * Ideal.Quotient.factorₐ k le_sup_right b :=
  Algebra.TensorProduct.lift_tmul _ _ _ _ _

/-- The diagonal map sends `a ⊗ b` to the class of `a * b`. -/
@[simp] lemma diag_mk_tmul_mk (a b : MvPolynomial ι k) :
    diag I J (Ideal.Quotient.mk I a ⊗ₜ[k] Ideal.Quotient.mk J b) =
      Ideal.Quotient.mk (I ⊔ J) (a * b) := by
  simp [Ideal.Quotient.factorₐ_apply, Ideal.Quotient.factor_mk, map_mul]

/-- The diagonal map restricted to the left factor is the quotient map. -/
@[simp] lemma diag_mk_tmul_one (a : MvPolynomial ι k) :
    diag I J (Ideal.Quotient.mk I a ⊗ₜ[k] 1) = Ideal.Quotient.mk (I ⊔ J) a := by
  simp [Ideal.Quotient.factorₐ_apply, Ideal.Quotient.factor_mk]

/-- The diagonal map restricted to the right factor is the quotient map. -/
@[simp] lemma diag_one_tmul (b : MvPolynomial ι k) :
    diag I J ((1 : MvPolynomial ι k ⧸ I) ⊗ₜ[k] Ideal.Quotient.mk J b) =
      Ideal.Quotient.mk (I ⊔ J) b := by
  simp [Ideal.Quotient.factorₐ_apply, Ideal.Quotient.factor_mk]

/-- The diagonal map is surjective: `R⧸(I + J)` is generated by the image of `R⧸I`. -/
lemma diag_surjective : Function.Surjective (diag I J) := fun c ↦ by
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective c
  exact ⟨Ideal.Quotient.mk I a ⊗ₜ[k] 1, by simp⟩

/-- The `i`-th equation cutting out the diagonal, `xᵢ ⊗ 1 - 1 ⊗ xᵢ`. -/
noncomputable def diagGen (i : ι) :
    (MvPolynomial ι k ⧸ I) ⊗[k] (MvPolynomial ι k ⧸ J) :=
  Ideal.Quotient.mk I (X i) ⊗ₜ[k] 1 - 1 ⊗ₜ[k] Ideal.Quotient.mk J (X i)

/-- The image of `R` in the quotient of the tensor product by the diagonal equations, taken
through the left factor. -/
noncomputable def diagInl :
    MvPolynomial ι k →ₐ[k]
      ((MvPolynomial ι k ⧸ I) ⊗[k] (MvPolynomial ι k ⧸ J)) ⧸
        Ideal.span (Set.range (diagGen I J)) :=
  (Ideal.Quotient.mkₐ k _).comp
    ((Algebra.TensorProduct.includeLeft (S := k)).comp (Ideal.Quotient.mkₐ k I))

/-- The image of `R` in the quotient of the tensor product by the diagonal equations, taken
through the right factor. -/
noncomputable def diagInr :
    MvPolynomial ι k →ₐ[k]
      ((MvPolynomial ι k ⧸ I) ⊗[k] (MvPolynomial ι k ⧸ J)) ⧸
        Ideal.span (Set.range (diagGen I J)) :=
  (Ideal.Quotient.mkₐ k _).comp
    (Algebra.TensorProduct.includeRight.comp (Ideal.Quotient.mkₐ k J))

/-- `diagInl` sends a polynomial to the class of its image in the left factor. -/
lemma diagInl_apply (a : MvPolynomial ι k) :
    diagInl I J a = Ideal.Quotient.mk (Ideal.span (Set.range (diagGen I J)))
      (Ideal.Quotient.mk I a ⊗ₜ[k] 1) := rfl

/-- `diagInr` sends a polynomial to the class of its image in the right factor. -/
lemma diagInr_apply (b : MvPolynomial ι k) :
    diagInr I J b = Ideal.Quotient.mk (Ideal.span (Set.range (diagGen I J)))
      ((1 : MvPolynomial ι k ⧸ I) ⊗ₜ[k] Ideal.Quotient.mk J b) := rfl

/-- Modulo the diagonal equations the two inclusions of `R` agree: they agree on the variables,
by the very definition of those equations. -/
lemma diagInl_eq_diagInr : diagInl I J = diagInr I J := by
  refine MvPolynomial.algHom_ext fun i ↦ ?_
  rw [← sub_eq_zero, diagInl_apply, diagInr_apply, ← map_sub, Ideal.Quotient.eq_zero_iff_mem]
  exact Ideal.subset_span ⟨i, rfl⟩

/-- Both `I` and `J` die in the quotient of the tensor product by the diagonal equations: `I`
because the left inclusion factors through `R⧸I`, and `J` because the left inclusion agrees
there with the right one. -/
lemma diagInl_vanish : ∀ a ∈ I ⊔ J, diagInl I J a = 0 := by
  intro a ha
  obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.mp ha
  have h1 : diagInl I J y = 0 := by
    rw [diagInl_apply, Ideal.Quotient.eq_zero_iff_mem.mpr hy]
    simp
  have h2 : diagInl I J z = 0 := by
    rw [diagInl_eq_diagInr, diagInr_apply, Ideal.Quotient.eq_zero_iff_mem.mpr hz]
    simp
  rw [map_add, h1, h2, add_zero]

/-- The map `R⧸(I + J) → (R⧸I ⊗[k] R⧸J) ⧸ (diagonal equations)` induced by `diagInl`. It splits
the map induced by `diag`, which is what makes the diagonal equations generate the whole
kernel. -/
noncomputable def diagSection :
    MvPolynomial ι k ⧸ (I ⊔ J) →ₐ[k]
      ((MvPolynomial ι k ⧸ I) ⊗[k] (MvPolynomial ι k ⧸ J)) ⧸
        Ideal.span (Set.range (diagGen I J)) :=
  Ideal.Quotient.liftₐ (I ⊔ J) (diagInl I J) (diagInl_vanish I J)

/-- `diagSection` splits `diag` after passing to the quotient by the diagonal equations. -/
lemma diagSection_comp_diag :
    (diagSection I J).comp (diag I J) =
      Ideal.Quotient.mkₐ k (Ideal.span (Set.range (diagGen I J))) := by
  refine Algebra.TensorProduct.ext' fun a b ↦ ?_
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective a
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective b
  have hx : diagSection I J (Ideal.Quotient.mk (I ⊔ J) x) = diagInl I J x := rfl
  have hy : diagSection I J (Ideal.Quotient.mk (I ⊔ J) y) = diagInr I J y := by
    rw [← diagInl_eq_diagInr]; rfl
  calc (diagSection I J).comp (diag I J)
        (Ideal.Quotient.mk I x ⊗ₜ[k] Ideal.Quotient.mk J y)
      = diagSection I J (Ideal.Quotient.mk (I ⊔ J) (x * y)) := by
        simp only [AlgHom.comp_apply, diag_mk_tmul_mk]
    _ = diagInl I J x * diagInr I J y := by rw [← hx, ← hy, ← map_mul, map_mul]
    _ = Ideal.Quotient.mk (Ideal.span (Set.range (diagGen I J)))
          (Ideal.Quotient.mk I x ⊗ₜ[k] Ideal.Quotient.mk J y) := by
        rw [diagInl_apply, diagInr_apply, ← map_mul, Algebra.TensorProduct.tmul_mul_tmul,
          mul_one, one_mul]
    _ = _ := rfl

/-- **The diagonal is cut out by the variables' differences.** The kernel of the diagonal map
`R⧸I ⊗[k] R⧸J → R⧸(I + J)` is generated by the elements `xᵢ ⊗ 1 - 1 ⊗ xᵢ`. Together with
`diag_surjective` this is the Lean form of the source's identity
`X ∩ Y = (X × Y) ∩ V(x₁ - y₁, …, xₙ - yₙ)`. -/
theorem ker_diag :
    RingHom.ker (diag I J).toRingHom = Ideal.span (Set.range (diagGen I J)) := by
  refine le_antisymm (fun t ht ↦ ?_) ?_
  · have h0 : Ideal.Quotient.mkₐ k (Ideal.span (Set.range (diagGen I J))) t = 0 := by
      rw [← diagSection_comp_diag I J]
      simp only [AlgHom.comp_apply, show diag I J t = 0 from ht, map_zero]
    rwa [Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.eq_zero_iff_mem] at h0
  · rw [Ideal.span_le]
    rintro t ⟨i, rfl⟩
    simp [RingHom.mem_ker, diagGen]

end AffineIntersection


/-- `Spec (R ⧸ I)` is homeomorphic to the zero locus of `I` in `Spec R`. -/
private noncomputable def quotientHomeoZeroLocus {R : Type*} [CommRing R] (I : Ideal R) :
    PrimeSpectrum (R ⧸ I) ≃ₜ ↥(PrimeSpectrum.zeroLocus (I : Set R)) :=
  (PrimeSpectrum.isClosedEmbedding_comap_of_surjective _ _
      Ideal.Quotient.mk_surjective).isEmbedding.toHomeomorph.trans
    (Homeomorph.setCongr (by
      rw [range_comap_of_surjective _ _ Ideal.Quotient.mk_surjective]
      simp [Ideal.mk_ker]))

/-- At a closed point of the spectrum of a finite-type `k`-algebra the local dimension is the
height of the corresponding maximal ideal. This is Stacks Tag 0A21 (dimension at a closed
point) combined with the identification of the dimension of a stalk with a coheight. -/
private lemma topologicalKrullDimAt_spec_eq_height (k : Type u) [Field k] (S : Type u)
    [CommRing S] [Algebra k S] [Algebra.FiniteType k S] (p : Spec (CommRingCat.of S))
    (hp : p.asIdeal.IsMaximal) :
    topologicalKrullDimAt ↥(Spec (CommRingCat.of S)) p = (p.asIdeal.height : WithBot ℕ∞) := by
  have hft := locallyOfFiniteType_specMap_algebraMap k S
  rw [topologicalKrullDimAt_eq_krullDimOfRing_stalk k _
      (Spec.map (CommRingCat.ofHom (algebraMap k S))) p
      ((PrimeSpectrum.isClosed_singleton_iff_isMaximal p).mpr hp),
    ringKrullDim_stalk_eq_coheight, idealHeight_eq_coheight]

/-- The preimage of an irreducible component under a homeomorphism is an irreducible
component. -/
private lemma preimage_mem_irreducibleComponents_of_homeomorph {X Y : Type*}
    [TopologicalSpace X] [TopologicalSpace Y] (e : X ≃ₜ Y) (Z : Set Y)
    (hZ : Z ∈ irreducibleComponents Y) : e ⁻¹' Z ∈ irreducibleComponents X := by
  obtain ⟨y, hy⟩ := hZ.1.nonempty
  exact preimage_mem_irreducibleComponents hZ e.isOpenEmbedding
    ⟨y, hy, e.symm y, e.apply_symm_apply y⟩

/-- A homeomorphism preserves the dimension of a subset. -/
lemma topologicalKrullDim_preimage_of_homeomorph {X Y : Type*} [TopologicalSpace X]
    [TopologicalSpace Y] (e : X ≃ₜ Y) (Z : Set Y) :
    topologicalKrullDim (e ⁻¹' Z) = topologicalKrullDim Z :=
  IsHomeomorph.topologicalKrullDim_eq _
    (e.isEmbedding.homeomorphOfSubsetRange (by simp)).isHomeomorph

/-- **Stacks Tag 0B2M, part (1), for affine schemes.** The local dimension of
`Spec (A ⊗[k] B)` at any point is the sum of the local dimensions of `Spec A` and `Spec B`,
when the latter are constant. The product of the two affine schemes is the spectrum of the
tensor product, by `AlgebraicGeometry.pullbackSpecIso`. -/
private lemma topologicalKrullDimAt_tensor_eq_add (k : Type u) [Field k] (A B : Type u)
    [CommRing A] [CommRing B] [Algebra k A] [Algebra k B]
    [Algebra.FiniteType k A] [Algebra.FiniteType k B] {a b : WithBot ℕ∞}
    (hA : ∀ p : Spec (CommRingCat.of A),
      topologicalKrullDimAt ↥(Spec (CommRingCat.of A)) p = a)
    (hB : ∀ p : Spec (CommRingCat.of B),
      topologicalKrullDimAt ↥(Spec (CommRingCat.of B)) p = b)
    (M : Spec (CommRingCat.of (A ⊗[k] B))) :
    topologicalKrullDimAt ↥(Spec (CommRingCat.of (A ⊗[k] B))) M = a + b := by
  have hA' := locallyOfFiniteType_specMap_algebraMap k A
  have hB' := locallyOfFiniteType_specMap_algebraMap k B
  rw [topologicalKrullDimAt_eq_of_homeomorph
      (Scheme.homeoOfIso (pullbackSpecIso k A B)).symm M,
    topologicalKrullDimAt_pullback k _ _ _, hA, hB]

/-- An irreducible component of the spectrum of a Jacobson Noetherian ring carries a closed
point lying on no other component: the complement of the other components is open and dense in
the component, and a Jacobson space has a closed point in every nonempty locally closed
subset. -/
private lemma exists_isMaximal_mem_unique_irreducibleComponent (S : Type u) [CommRing S]
    [IsNoetherianRing S] [IsJacobsonRing S] (Z : Set (Spec (CommRingCat.of S)))
    (hZ : Z ∈ irreducibleComponents ↥(Spec (CommRingCat.of S))) :
    ∃ p : Spec (CommRingCat.of S), p.asIdeal.IsMaximal ∧ p ∈ Z ∧
      ∀ W ∈ irreducibleComponents ↥(Spec (CommRingCat.of S)), p ∈ W → W = Z := by
  have hnoeth : NoetherianSpace ↥(Spec (CommRingCat.of S)) :=
    inferInstanceAs (NoetherianSpace (PrimeSpectrum S))
  have hfin : (irreducibleComponents ↥(Spec (CommRingCat.of S))).Finite :=
    NoetherianSpace.finite_irreducibleComponents
  have hUopen : IsOpen (⋃₀ (irreducibleComponents ↥(Spec (CommRingCat.of S)) \ {Z}))ᶜ := by
    rw [Set.sUnion_eq_biUnion, isOpen_compl_iff]
    exact hfin.sdiff.isClosed_biUnion fun W hW ↦ isClosed_of_mem_irreducibleComponents W hW.1
  have hclosure :
      closure (⋃₀ (irreducibleComponents ↥(Spec (CommRingCat.of S)) \ {Z}))ᶜ = Z :=
    closure_sUnion_irreducibleComponents_sdiff_singleton hfin Z hZ
  have hUne : (⋃₀ (irreducibleComponents ↥(Spec (CommRingCat.of S)) \ {Z}))ᶜ.Nonempty := by
    rcases Set.eq_empty_or_nonempty
      (⋃₀ (irreducibleComponents ↥(Spec (CommRingCat.of S)) \ {Z}))ᶜ with h | h
    · rw [h, closure_empty] at hclosure
      exact absurd hclosure.symm hZ.1.nonempty.ne_empty
    · exact h
  obtain ⟨p, hpU, hpc⟩ := nonempty_inter_closedPoints hUne hUopen.isLocallyClosed
  refine ⟨p, (PrimeSpectrum.isClosed_singleton_iff_isMaximal p).mp hpc,
    hclosure ▸ subset_closure hpU, fun W hW hpW ↦ ?_⟩
  by_contra hne
  exact hpU ⟨W, ⟨hW, hne⟩, hpW⟩
/-- The tensor product of two finite-type `k`-algebras is of finite type. -/
private lemma finiteType_tensor (k : Type u) [Field k] (A B : Type u) [CommRing A] [CommRing B]
    [Algebra k A] [Algebra k B] [Algebra.FiniteType k A] [Algebra.FiniteType k B] :
    Algebra.FiniteType k (A ⊗[k] B) :=
  have : Algebra.FiniteType A (A ⊗[k] B) := Algebra.FiniteType.baseChange (R := k) (A := B) _
  Algebra.FiniteType.trans (S := A) inferInstance inferInstance

/-- The Krull-height half of the reduction to the diagonal: the maximal ideal of
`R⧸I ⊗[k] R⧸J` above a prime `t` of `R⧸(I + J)` has height at most that of `t` plus `n`,
because the kernel of the diagonal map is generated by `n` elements. -/
private lemma height_comap_diag_le (k : Type u) [Field k] (n : ℕ)
    (I J : Ideal (MvPolynomial (Fin n) k))
    (t : PrimeSpectrum (MvPolynomial (Fin n) k ⧸ (I ⊔ J))) :
    (Ideal.comap (AffineIntersection.diag I J).toRingHom t.asIdeal).height ≤
      t.asIdeal.height + (n : ℕ∞) := by
  have hTft := finiteType_tensor k (MvPolynomial (Fin n) k ⧸ I) (MvPolynomial (Fin n) k ⧸ J)
  have hTnoeth : IsNoetherianRing
      ((MvPolynomial (Fin n) k ⧸ I) ⊗[k] (MvPolynomial (Fin n) k ⧸ J)) :=
    Algebra.FiniteType.isNoetherianRing k _
  have hδsurj : Function.Surjective (AffineIntersection.diag I J).toRingHom :=
    AffineIntersection.diag_surjective I J
  have hMprime : (Ideal.comap (AffineIntersection.diag I J).toRingHom t.asIdeal).IsPrime :=
    Ideal.comap_isPrime _ _
  have hsM : Set.range (AffineIntersection.diagGen I J) ⊆
      Ideal.comap (AffineIntersection.diag I J).toRingHom t.asIdeal := by
    intro x hx
    have hker : x ∈ RingHom.ker (AffineIntersection.diag I J).toRingHom := by
      rw [AffineIntersection.ker_diag]
      exact Ideal.subset_span hx
    have hmem : (AffineIntersection.diag I J).toRingHom x ∈ t.asIdeal := by
      rw [RingHom.mem_ker.mp hker]
      exact t.asIdeal.zero_mem
    exact hmem
  have hencard : (Set.range (AffineIntersection.diagGen I J)).encard ≤ (n : ℕ∞) := by
    rw [← Set.image_univ]
    exact (Set.encard_image_le _ _).trans (by simp [Set.encard_univ])
  refine le_trans (Ideal.height_le_height_map_add_encard_of_span_eq_ker _ hδsurj _
    (AffineIntersection.ker_diag I J).symm _ hsM) ?_
  rw [Ideal.map_comap_of_surjective _ hδsurj]
  gcongr

/-- The product half of the reduction to the diagonal: the height of the maximal ideal of
`R⧸I ⊗[k] R⧸J` above a closed point of `R⧸(I + J)` is the sum of the local dimensions of
`Spec (R⧸I)` and `Spec (R⧸J)`, by Stacks Tag 0B2M part (1). -/
private lemma height_comap_diag_eq_add (k : Type u) [Field k] (n : ℕ)
    (I J : Ideal (MvPolynomial (Fin n) k)) {a b : WithBot ℕ∞}
    (hA : ∀ p : Spec (CommRingCat.of (MvPolynomial (Fin n) k ⧸ I)),
      topologicalKrullDimAt ↥(Spec (CommRingCat.of (MvPolynomial (Fin n) k ⧸ I))) p = a)
    (hB : ∀ p : Spec (CommRingCat.of (MvPolynomial (Fin n) k ⧸ J)),
      topologicalKrullDimAt ↥(Spec (CommRingCat.of (MvPolynomial (Fin n) k ⧸ J))) p = b)
    (t : Spec (CommRingCat.of (MvPolynomial (Fin n) k ⧸ (I ⊔ J))))
    (ht : t.asIdeal.IsMaximal) :
    ((Ideal.comap (AffineIntersection.diag I J).toRingHom t.asIdeal).height : WithBot ℕ∞) =
      a + b := by
  have hTft := finiteType_tensor k (MvPolynomial (Fin n) k ⧸ I) (MvPolynomial (Fin n) k ⧸ J)
  have hδsurj : Function.Surjective (AffineIntersection.diag I J).toRingHom :=
    AffineIntersection.diag_surjective I J
  have hMmax : (Ideal.comap (AffineIntersection.diag I J).toRingHom t.asIdeal).IsMaximal :=
    Ideal.comap_isMaximal_of_surjective _ hδsurj
  have hMprime := hMmax.isPrime
  rw [← topologicalKrullDimAt_spec_eq_height k
    ((MvPolynomial (Fin n) k ⧸ I) ⊗[k] (MvPolynomial (Fin n) k ⧸ J))
    (⟨_, hMprime⟩ : PrimeSpectrum ((MvPolynomial (Fin n) k ⧸ I) ⊗[k]
      (MvPolynomial (Fin n) k ⧸ J))) hMmax]
  exact topologicalKrullDimAt_tensor_eq_add k _ _ hA hB _

/-- The local form of the intersection bound: at a closed point `t` of `V(I) ∩ V(J)`, the
height of the maximal ideal of `t` is at least `a + b - n`, where `a` and `b` are the constant
local dimensions of `Spec (R⧸I)` and `Spec (R⧸J)`. This is the reduction to the diagonal: the
point of `Spec (R⧸I ⊗ R⧸J)` lying over `t` has height `a + b`, and `t` is cut out in it by the
`n` diagonal equations. -/
private lemma add_le_height_of_isMaximal (k : Type u) [Field k] (n : ℕ)
    (I J : Ideal (MvPolynomial (Fin n) k)) {a b : WithBot ℕ∞}
    (hA : ∀ p : Spec (CommRingCat.of (MvPolynomial (Fin n) k ⧸ I)),
      topologicalKrullDimAt ↥(Spec (CommRingCat.of (MvPolynomial (Fin n) k ⧸ I))) p = a)
    (hB : ∀ p : Spec (CommRingCat.of (MvPolynomial (Fin n) k ⧸ J)),
      topologicalKrullDimAt ↥(Spec (CommRingCat.of (MvPolynomial (Fin n) k ⧸ J))) p = b)
    (t : Spec (CommRingCat.of (MvPolynomial (Fin n) k ⧸ (I ⊔ J))))
    (ht : t.asIdeal.IsMaximal) :
    a + b ≤ (n : WithBot ℕ∞) + (t.asIdeal.height : WithBot ℕ∞) := by
  rw [← height_comap_diag_eq_add k n I J hA hB t ht]
  calc ((Ideal.comap (AffineIntersection.diag I J).toRingHom t.asIdeal).height : WithBot ℕ∞)
      ≤ ((t.asIdeal.height + (n : ℕ∞) : ℕ∞) : WithBot ℕ∞) :=
        WithBot.coe_le_coe.mpr (height_comap_diag_le k n I J t)
    _ = (n : WithBot ℕ∞) + (t.asIdeal.height : WithBot ℕ∞) := by
        push_cast
        exact add_comm _ _


section Core

variable {k : Type u} [Field k] {n : ℕ}

local notation "MvFin" => MvPolynomial (Fin n) k

/-- The intersection bound, stated on the spectra of the coordinate rings: if the local
dimension of `Spec (R⧸I)` is constantly `r` and that of `Spec (R⧸J)` constantly `s`, then every
irreducible component of `Spec (R⧸(I + J))` has dimension at least `r + s - n`. -/
private lemma add_le_add_topologicalKrullDim_of_quotient (r s : ℕ) (I J : Ideal MvFin)
    (hXe : Equidimensional ↥(Spec (CommRingCat.of (MvFin ⧸ I))))
    (hXd : topologicalKrullDim ↥(Spec (CommRingCat.of (MvFin ⧸ I))) = (r : WithBot ℕ∞))
    (hYe : Equidimensional ↥(Spec (CommRingCat.of (MvFin ⧸ J))))
    (hYd : topologicalKrullDim ↥(Spec (CommRingCat.of (MvFin ⧸ J))) = (s : WithBot ℕ∞))
    (Z : Set ↥(Spec (CommRingCat.of (MvFin ⧸ (I ⊔ J)))))
    (hZ : Z ∈ irreducibleComponents ↥(Spec (CommRingCat.of (MvFin ⧸ (I ⊔ J))))) :
    (r : WithBot ℕ∞) + s ≤ n + topologicalKrullDim Z := by
  obtain ⟨t, htmax, htZ, htonly⟩ :=
    exists_isMaximal_mem_unique_irreducibleComponent (MvFin ⧸ (I ⊔ J)) Z hZ
  have hft := locallyOfFiniteType_specMap_algebraMap k (MvFin ⧸ (I ⊔ J))
  have hatt : topologicalKrullDimAt ↥(Spec (CommRingCat.of (MvFin ⧸ (I ⊔ J)))) t =
      topologicalKrullDim Z := by
    rw [topologicalKrullDimAt_eq_iSup_irreducibleComponents k _
      (Spec.map (CommRingCat.ofHom (algebraMap k (MvFin ⧸ (I ⊔ J))))) t]
    refine le_antisymm (iSup₂_le fun W hW ↦ le_of_eq ?_) (le_iSup₂_of_le Z ⟨hZ, htZ⟩ le_rfl)
    rw [htonly W hW.1 hW.2]
  have htheight : (t.asIdeal.height : WithBot ℕ∞) = topologicalKrullDim Z := by
    rw [← topologicalKrullDimAt_spec_eq_height k _ t htmax, hatt]
  rw [← htheight]
  exact add_le_height_of_isMaximal k n I J
    (topologicalKrullDimAt_eq_of_equidimensional k _
      (Spec.map (CommRingCat.ofHom (algebraMap k (MvFin ⧸ I)))) hXe hXd)
    (topologicalKrullDimAt_eq_of_equidimensional k _
      (Spec.map (CommRingCat.ofHom (algebraMap k (MvFin ⧸ J)))) hYe hYd) t htmax

end Core

/-- **Stacks Project, Tag 0B2Q.** Let `k` be a field and let `Xs` and `Ys` be closed subsets of
affine `n`-space over `k`, that is, of the prime spectrum of `MvPolynomial (Fin n) k`. If `Xs`
and `Ys` are equidimensional of dimensions `r` and `s`, then every irreducible component `Z` of
`Xs ∩ Ys` satisfies `r + s ≤ n + dim Z`, that is, has dimension at least `r + s - n`. -/
@[stacks 0B2Q]
theorem add_le_add_topologicalKrullDim_irreducibleComponent_inter (k : Type u) [Field k]
    (n r s : ℕ) (Xs Ys : Set (PrimeSpectrum (MvPolynomial (Fin n) k)))
    (hXc : IsClosed Xs) (hYc : IsClosed Ys)
    (hXe : Equidimensional Xs) (hYe : Equidimensional Ys)
    (hXd : topologicalKrullDim Xs = r) (hYd : topologicalKrullDim Ys = s)
    (Z : Set ↥(Xs ∩ Ys)) (hZ : Z ∈ irreducibleComponents ↥(Xs ∩ Ys)) :
    (r : WithBot ℕ∞) + s ≤ n + topologicalKrullDim Z := by
  obtain ⟨I, rfl⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal Xs).mp hXc
  obtain ⟨J, rfl⟩ := (PrimeSpectrum.isClosed_iff_zeroLocus_ideal Ys).mp hYc
  have eC : Spec (CommRingCat.of (MvPolynomial (Fin n) k ⧸ (I ⊔ J))) ≃ₜ
      ↥(PrimeSpectrum.zeroLocus (I : Set (MvPolynomial (Fin n) k)) ∩
        PrimeSpectrum.zeroLocus (J : Set (MvPolynomial (Fin n) k))) :=
    (quotientHomeoZeroLocus (I ⊔ J)).trans
      (Homeomorph.setCongr (by rw [PrimeSpectrum.zeroLocus_sup]))
  rw [← topologicalKrullDim_preimage_of_homeomorph eC Z]
  exact add_le_add_topologicalKrullDim_of_quotient r s I J
    (TopologicalSpace.Equidimensional.of_homeomorph (quotientHomeoZeroLocus I) hXe)
    ((IsHomeomorph.topologicalKrullDim_eq _ (quotientHomeoZeroLocus I).isHomeomorph).trans hXd)
    (TopologicalSpace.Equidimensional.of_homeomorph (quotientHomeoZeroLocus J) hYe)
    ((IsHomeomorph.topologicalKrullDim_eq _ (quotientHomeoZeroLocus J).isHomeomorph).trans hYd)
    (eC ⁻¹' Z) (preimage_mem_irreducibleComponents_of_homeomorph eC Z hZ)

end AlgebraicGeometry

