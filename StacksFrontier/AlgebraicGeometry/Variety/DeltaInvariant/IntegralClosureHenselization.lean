/-!
# The integral closure in the total ring of fractions after henselization

Let `A` be a reduced one-dimensional Nagata local ring and let `Ah` be a henselization, or a
strict henselization, of `A`. **The base change to `Ah` of the integral closure of `A` in its
total ring of fractions is the integral closure of `Ah` in its own total ring of fractions.**

## Main results

* `IsLocalRing.isFractionRing_of_injective_of_isLocalization_powers`: a total ring of fractions
  generated by one element stays one after an injective finite extension.
* `IsLocalRing.isIntegral_iff_mem_range_tensorProduct`: the image of a normal finite base change
  inside a total ring of fractions is the integral closure.
* `IsLocalRing.exists_integralClosure_henselization_map` and
  `IsLocalRing.tensorProduct_integralClosure_isIntegralClosure_strictHenselization` identify the
  base-changed integral closure with the integral closure of the henselization, respectively of
  the strict henselization, inside its total ring of fractions.

## Implementation notes

The assertion that the tensor product is the integral closure is expressed by an injective
algebra map into `FractionRing Ah`, compatible both with the map from `FractionRing A` and with
the canonical map from `Ah`, whose image is exactly the integral closure of `Ah`. This records
the canonical base-change embedding implicit in the source rather than merely an abstract ring
isomorphism.

The embedding and the two compatibilities come from
`IsLocalRing.exists_common_fractionRing_localization_and_injective_tensorProduct`, which treats
henselization, strict henselization and completion uniformly through the properties of them that
are used: flatness, reducedness, dimension one, and the assertion that a chosen element of the
maximal ideal still cuts out the closed point. Here that last assertion is
`IsLocalRing.IsHenselization.radical_span_eq_maximalIdeal_map`. Normality of the base-changed
integral closure is
`IsLocalRing.isNormalRing_tensorProduct_integralClosure_of_isHenselization`, and it is what makes
the image integrally closed.

## References

* [Stacks Project, Tag 0C3V](https://stacks.math.columbia.edu/tag/0C3V)
-/

@[expose] public section

open IsLocalRing
open scoped TensorProduct

universe u v

namespace IsLocalRing

/-- **A total ring of fractions is detected by a single element of a subring.** Let `R` be an
algebra over `B` whose structure map into the total ring of fractions of `B` is injective and
compatible with the scalars, and suppose that total ring of fractions is already the localization
of `B` away from a single element `b`. Then it is a total ring of fractions of `R` as well: the
powers of the image of `b` are cofinal among the nonzerodivisors of `R`. -/
public theorem isFractionRing_of_injective_of_isLocalization_powers
    {B R : Type u} [CommRing B] [CommRing R]
    [Algebra B R] [Algebra R (FractionRing B)] [IsScalarTower B R (FractionRing B)]
    (hinj : Function.Injective (algebraMap R (FractionRing B))) (b : B)
    (hLB : IsLocalization (Submonoid.powers b) (FractionRing B)) :
    IsFractionRing R (FractionRing B) := by
  let : IsLocalization (Submonoid.powers b) (FractionRing B) := hLB
  have hmap : algebraMap R (FractionRing B) (algebraMap B R b) =
      algebraMap B (FractionRing B) b :=
    (IsScalarTower.algebraMap_apply B R (FractionRing B) b).symm
  have hunit : IsUnit (algebraMap R (FractionRing B) (algebraMap B R b)) := by
    rw [hmap]
    exact IsLocalization.map_units (FractionRing B) ⟨b, Submonoid.mem_powers b⟩
  have hpow : IsLocalization (Submonoid.powers (algebraMap B R b)) (FractionRing B) := by
    rw [isLocalization_iff]
    refine ⟨?_, ?_, fun {x y} hxy => ⟨1, by simp [hinj hxy]⟩⟩
    · rintro ⟨x, n, rfl⟩
      rw [map_pow]
      exact hunit.pow n
    · intro z
      obtain ⟨⟨a, d⟩, hz⟩ := IsLocalization.surj
        (M := Submonoid.powers b) (S := FractionRing B) z
      obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff d.1 b).mp d.2
      refine ⟨(algebraMap B R a, ⟨(algebraMap B R b) ^ n, ⟨n, rfl⟩⟩), ?_⟩
      rw [map_pow, hmap]
      calc z * (algebraMap B (FractionRing B) b) ^ n
          = z * algebraMap B (FractionRing B) d.1 := by rw [← map_pow, hn]
        _ = algebraMap B (FractionRing B) a := hz
        _ = algebraMap R (FractionRing B) (algebraMap B R a) :=
            IsScalarTower.algebraMap_apply B R (FractionRing B) a
  let : IsLocalization (Submonoid.powers (algebraMap B R b)) (FractionRing B) := hpow
  have hreg : algebraMap B R b ∈ nonZeroDivisors R :=
    localization_submonoid_le_nonZeroDivisors (S := FractionRing B)
      (Submonoid.powers (algebraMap B R b)) hinj (Submonoid.mem_powers _)
  show IsLocalization (nonZeroDivisors R) (FractionRing B)
  rw [isLocalization_iff]
  refine ⟨fun r => ?_, fun z => ?_, fun {x y} hxy => ⟨1, by simp [hinj hxy]⟩⟩
  · have hregK : algebraMap R (FractionRing B) r.1 ∈ nonZeroDivisors (FractionRing B) := by
      rw [mem_nonZeroDivisors_iff]
      have hleft : ∀ z, algebraMap R (FractionRing B) r.1 * z = 0 → z = 0 := by
        intro z hz
        obtain ⟨⟨a, d⟩, hrep⟩ := IsLocalization.surj
          (M := Submonoid.powers (algebraMap B R b)) (S := FractionRing B) z
        have hm : algebraMap R (FractionRing B) r.1 * algebraMap R (FractionRing B) a = 0 := by
          calc algebraMap R (FractionRing B) r.1 * algebraMap R (FractionRing B) a
              = algebraMap R (FractionRing B) r.1 *
                (z * algebraMap R (FractionRing B) d.1) := by rw [hrep.symm]
            _ = (algebraMap R (FractionRing B) r.1 * z) *
                algebraMap R (FractionRing B) d.1 := by ring
            _ = 0 := by rw [hz]; simp
        have ha : a = 0 :=
          (mem_nonZeroDivisors_iff.mp r.2).1 a (hinj (by simpa [map_mul] using hm))
        have hz' : z * algebraMap R (FractionRing B) d.1 = 0 := by simpa [ha] using hrep
        exact (IsLocalization.map_units (FractionRing B) d).mul_left_eq_zero.mp hz'
      exact ⟨hleft, fun z hz => hleft z (by simpa [mul_comm] using hz)⟩
    rwa [IsFractionRing.nonZeroDivisors_eq_isUnit B (FractionRing B)] at hregK
  · obtain ⟨⟨a, d⟩, hrep⟩ := IsLocalization.surj
      (M := Submonoid.powers (algebraMap B R b)) (S := FractionRing B) z
    obtain ⟨n, hn⟩ := (Submonoid.mem_powers_iff d.1 (algebraMap B R b)).mp d.2
    exact ⟨(a, ⟨d.1, by rw [← hn]; exact pow_mem hreg n⟩), hrep⟩

/-- **The image of a normal finite base change inside a total ring of fractions is the integral
closure.** Let `S` be a finite `A`-algebra, let `B` be an `A`-algebra whose total ring of
fractions is the localization away from a single element `t`, and let `g` be an injective
`A`-algebra map of `S ⊗[A] B` into that total ring of fractions which extends the canonical map
from `B`. If `S ⊗[A] B` is a normal ring, then an element of the total ring of fractions is
integral over `B` exactly when it lies in the image of `g`. -/
public theorem isIntegral_iff_mem_range_tensorProduct
    {A S B : Type u} [CommRing A] [CommRing S] [CommRing B]
    [Algebra A S] [Algebra A B] [Module.Finite A S]
    (g : (S ⊗[A] B) →ₐ[A] FractionRing B) (hg : Function.Injective g)
    (hcompat : ∀ b : B, g (Algebra.TensorProduct.includeRight b) =
      algebraMap B (FractionRing B) b)
    (hnormal : IsNormalRing (S ⊗[A] B))
    (t : B) (hLB : IsLocalization (Submonoid.powers t) (FractionRing B))
    (x : FractionRing B) :
    IsIntegral B x ↔ x ∈ Set.range g := by
  let : Algebra B (S ⊗[A] B) := Algebra.TensorProduct.rightAlgebra
  let : IsScalarTower A B (S ⊗[A] B) := Algebra.TensorProduct.right_isScalarTower
  let : Algebra (S ⊗[A] B) (FractionRing B) := g.toAlgebra
  let gB : (S ⊗[A] B) →ₐ[B] FractionRing B :=
    { toRingHom := g.toRingHom
      commutes' := fun b => by
        show g (Algebra.TensorProduct.includeRight b) = algebraMap B (FractionRing B) b
        exact hcompat b }
  let : IsScalarTower B (S ⊗[A] B) (FractionRing B) :=
    IsScalarTower.of_algebraMap_eq' gB.comp_algebraMap.symm
  have : IsFractionRing (S ⊗[A] B) (FractionRing B) :=
    isFractionRing_of_injective_of_isLocalization_powers hg t hLB
  let : Module.Finite B (S ⊗[A] B) := by
    let : Module.Finite B (B ⊗[A] S) := Module.Finite.base_change (R := A) (A := B) (M := S)
    exact Module.Finite.equiv (Algebra.TensorProduct.commRight A B S).toLinearEquiv
  let : Algebra.IsIntegral B (S ⊗[A] B) := Algebra.IsIntegral.of_finite B _
  have hclosed : IsIntegrallyClosedIn (S ⊗[A] B) (FractionRing B) :=
    (IsLocalization.algEquiv (nonZeroDivisors (S ⊗[A] B)) (FractionRing (S ⊗[A] B))
      (FractionRing B)).isIntegrallyClosedIn.mp hnormal.isIntegrallyClosed
  refine ⟨fun hx => ?_, ?_⟩
  · exact hclosed.isIntegral_iff.mp (IsIntegral.tower_top (A := S ⊗[A] B) hx)
  · rintro ⟨y, rfl⟩
    exact (Algebra.IsIntegral.isIntegral y).map gB

/-- The image of the base-changed integral closure in `FractionRing B` is the integral closure
of `B`, given normality and that `FractionRing B` is a localization away from one element. -/
private theorem range_eq_restrictScalars_integralClosure
    {A B : Type u} [CommRing A] [IsReduced A] [CommRing B] [Algebra A B]
    (hA : IsNagataRing A)
    (g : (integralClosure A (FractionRing A) ⊗[A] B) →ₐ[A] FractionRing B)
    (hg : Function.Injective g)
    (hright : g.comp (Algebra.TensorProduct.includeRight :
      B →ₐ[A] (integralClosure A (FractionRing A) ⊗[A] B)) =
        IsScalarTower.toAlgHom A B (FractionRing B))
    (hnormal : IsNormalRing (integralClosure A (FractionRing A) ⊗[A] B))
    (t : B) (hLB : IsLocalization (Submonoid.powers t) (FractionRing B)) :
    g.range = (integralClosure B (FractionRing B)).restrictScalars A := by
  let : Module.Finite A (integralClosure A (FractionRing A)) :=
    module_finite_integralClosure_fractionRing hA
  ext x
  change x ∈ Set.range g ↔ IsIntegral B x
  exact (isIntegral_iff_mem_range_tensorProduct g hg
    (fun b => by simpa using congrArg (fun k : B →ₐ[A] FractionRing B => k b) hright)
    hnormal t hLB x).symm

/-- **Stacks Project, Tag 0C3V.** After strict henselization, the base change of the integral
closure in the total ring of fractions is the integral closure in the new total ring of
fractions. -/
@[stacks 0C3V "strict_henselization_integral_closure"]
public lemma tensorProduct_integralClosure_isIntegralClosure_strictHenselization
    {A Ash : Type u} [CommRing A] [IsLocalRing A] [IsReduced A]
    [CommRing Ash] [IsLocalRing Ash] [Algebra A Ash]
    (K : Type v) [Field K] [Algebra (ResidueField A) K]
    [IsSepClosure (ResidueField A) K] [IsHenselization A K Ash]
    (hA : IsNagataRing A) (hdim : ringKrullDim A = 1) :
    ∃ q : FractionRing A →ₐ[A] FractionRing Ash,
      ∃ g : (integralClosure A (FractionRing A) ⊗[A] Ash) →ₐ[A] FractionRing Ash,
        Function.Injective g ∧
          g.range = (integralClosure Ash (FractionRing Ash)).restrictScalars A ∧
          g.comp (Algebra.TensorProduct.includeLeft :
            integralClosure A (FractionRing A) →ₐ[A]
              (integralClosure A (FractionRing A) ⊗[A] Ash)) =
              q.comp (integralClosure A (FractionRing A)).val ∧
          g.comp (Algebra.TensorProduct.includeRight :
            Ash →ₐ[A] (integralClosure A (FractionRing A) ⊗[A] Ash)) =
              IsScalarTower.toAlgHom A Ash (FractionRing Ash) := by
  let : IsNoetherianRing A := hA.1
  let : Module.Flat A Ash := IsHenselization.flat (L := K)
  have hredAsh : IsReduced Ash := strictHenselization_isReduced (A := A) (Ash := Ash) K
  have hdimAsh : ringKrullDim Ash = 1 :=
    (strictHenselization_ringKrullDim (A := A) (Ash := Ash) K).trans hdim
  obtain ⟨f, hfm, hLA, hLAC, hbase⟩ :=
    exists_common_fractionRing_localization_and_injective_tensorProduct hA hdim
  let : IsLocalization (Submonoid.powers f) (FractionRing A) := hLA
  have hfreg : f ∈ nonZeroDivisors A :=
    localization_submonoid_le_nonZeroDivisors (S := FractionRing A) (Submonoid.powers f)
      (IsFractionRing.injective A (FractionRing A)) (Submonoid.mem_powers f)
  have hfAshreg : algebraMap A Ash f ∈ nonZeroDivisors Ash :=
    nonZeroDivisor_algebraMap_of_flat hfreg
  have hfmAsh : algebraMap A Ash f ∈ maximalIdeal Ash := by
    rw [← IsHenselization.map_maximalIdeal (R := A) (Rh := Ash) (L := K)]
    exact Ideal.mem_map_of_mem (algebraMap A Ash) hfm
  let : IsNoetherianRing Ash :=
    (strictHenselization_isNagataRing (A := A) (Ash := Ash) K hA).1
  have hradAsh : (Ideal.span {algebraMap A Ash f} : Ideal Ash).radical = maximalIdeal Ash :=
    radical_span_regular_eq_maximalIdeal Ash hfAshreg hfmAsh hdimAsh
  obtain ⟨hLAsh, ⟨q, g, hg, hcompLeft, hcompRight⟩⟩ := hbase Ash hredAsh hdimAsh hradAsh
  exact ⟨q, g, hg, range_eq_restrictScalars_integralClosure hA g hg hcompRight
    (isNormalRing_tensorProduct_integralClosure_of_isHenselization A Ash K)
    (algebraMap A Ash f) hLAsh, hcompLeft, hcompRight⟩

section Henselization

variable (A Ah : Type u) [CommRing A] [IsLocalRing A] [IsReduced A]
  [CommRing Ah] [IsLocalRing Ah] [Algebra A Ah] [IsHenselization A (ResidueField A) Ah]

omit [IsReduced A] in
/-- The ideal generated by the image of an element cutting out the closed point of `A` cuts out
the closed point of a henselization of `A`, because henselization maps the maximal ideal onto
the maximal ideal. -/
public lemma IsHenselization.radical_span_eq_maximalIdeal_map {f : A}
    (hrad : (Ideal.span {f}).radical = maximalIdeal A) :
    (Ideal.span {algebraMap A Ah f}).radical = maximalIdeal Ah := by
  have hfA : f ∈ maximalIdeal A := by
    rw [← hrad]
    exact Ideal.le_radical (Ideal.subset_span (Set.mem_singleton f))
  apply le_antisymm
  · refine (IsLocalRing.maximalIdeal.isMaximal Ah).isPrime.radical_le_iff.mpr
      (Ideal.span_le.mpr ?_)
    rintro x hx
    rcases Set.mem_singleton_iff.mp hx with rfl
    have hmem : algebraMap A Ah f ∈ (maximalIdeal A).map (algebraMap A Ah) :=
      Ideal.mem_map_of_mem (algebraMap A Ah) hfA
    rwa [IsHenselization.map_maximalIdeal (R := A) (L := ResidueField A) (Rh := Ah)] at hmem
  · rw [← IsHenselization.map_maximalIdeal (R := A) (L := ResidueField A) (Rh := Ah)]
    calc (maximalIdeal A).map (algebraMap A Ah)
        = (Ideal.span {f}).radical.map (algebraMap A Ah) := by rw [hrad]
      _ ≤ (Ideal.map (algebraMap A Ah) (Ideal.span {f})).radical :=
          Ideal.map_radical_le (algebraMap A Ah)
      _ = (Ideal.span {algebraMap A Ah f}).radical := by rw [Ideal.map_span]; simp

/-- **Stacks Project, Tag 0C3V.** The base change to a henselization of the integral closure in
the total ring of fractions is the integral closure of the henselization in its total ring of
fractions. -/
@[stacks 0C3V "henselization_integral_closure"]
public theorem exists_integralClosure_henselization_map
    (hA : IsNagataRing A) (hdim : ringKrullDim A = 1) :
    ∃ q : FractionRing A →ₐ[A] FractionRing Ah,
      ∃ g : (integralClosure A (FractionRing A) ⊗[A] Ah) →ₐ[A] FractionRing Ah,
        Function.Injective g ∧
          g.range = (integralClosure Ah (FractionRing Ah)).restrictScalars A ∧
          g.comp (Algebra.TensorProduct.includeLeft :
            integralClosure A (FractionRing A) →ₐ[A]
              (integralClosure A (FractionRing A) ⊗[A] Ah)) =
              q.comp (integralClosure A (FractionRing A)).val ∧
          g.comp (Algebra.TensorProduct.includeRight :
            Ah →ₐ[A] (integralClosure A (FractionRing A) ⊗[A] Ah)) =
              IsScalarTower.toAlgHom A Ah (FractionRing Ah) := by
  let : IsNoetherianRing A := hA.1
  have hAhRed : IsReduced Ah := IsHenselization.isReduced (A := A) (Ah := Ah)
  have hdimAh : ringKrullDim Ah = 1 :=
    (IsHenselization.ringKrullDim_eq (A := A) (Ah := Ah)).trans hdim
  obtain ⟨f, hf, hlocA, hlocA', hbase⟩ :=
    exists_common_fractionRing_localization_and_injective_tensorProduct hA hdim
  let : Module.Flat A Ah := IsHenselization.flat (L := ResidueField A)
  have hradA :=
    radical_span_eq_maximalIdeal_of_fractionRing_localization A hdim hf hlocA
  have hradAh := IsHenselization.radical_span_eq_maximalIdeal_map A Ah hradA
  let : Algebra (ResidueField A) (ResidueField A) := Algebra.id (ResidueField A)
  obtain ⟨hLocAh, ⟨q, g, hginj, hleft, hright⟩⟩ := hbase Ah hAhRed hdimAh hradAh
  exact ⟨q, g, hginj, range_eq_restrictScalars_integralClosure hA g hginj hright
    (isNormalRing_tensorProduct_integralClosure_of_isHenselization A Ah (ResidueField A))
    (algebraMap A Ah f) hLocAh, hleft, hright⟩

end Henselization

end IsLocalRing

end
