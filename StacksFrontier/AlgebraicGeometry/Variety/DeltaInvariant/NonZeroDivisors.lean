/-!
# Parameters, nonzerodivisors, and the total ring of fractions

An element of a ring whose powers already localize to the total ring of fractions is a
nonzerodivisor; this survives flat base change and passage to the integral closure. In a
one-dimensional Noetherian local ring, a nonzerodivisor in the maximal ideal cuts out the
closed point, and conversely a parameter whose powers give the total ring of fractions cuts
out the closed point.

## Main results

* `nonZeroDivisor_of_powerLocalization`, `nonZeroDivisor_algebraMap_of_flat` and
  `nonZeroDivisor_integralClosure_of_powerLocalization` produce nonzerodivisors.
* `localization_submonoid_le_nonZeroDivisors` bounds a localizing submonoid by the
  nonzerodivisors.
* `IsLocalRing.radical_span_regular_eq_maximalIdeal` and
  `IsLocalRing.radical_span_eq_maximalIdeal_of_fractionRing_localization` identify the radical
  of the ideal generated by such an element with the maximal ideal.

## References

* [Stacks Project, Tag 0C3V](https://stacks.math.columbia.edu/tag/0C3V)
-/

@[expose] public section

/-- If the powers of `f` localize `A` to its total ring of fractions, then `f` is a
nonzerodivisor. -/
public theorem nonZeroDivisor_of_powerLocalization {A : Type*} [CommRing A]
    {f : A} (hL : IsLocalization (Submonoid.powers f) (FractionRing A)) :
    f ∈ nonZeroDivisors A := by
  exact mem_nonZeroDivisors_of_injective (IsFractionRing.injective A (FractionRing A))
    (IsLocalization.map_units (FractionRing A) ⟨f, Submonoid.mem_powers f⟩).mem_nonZeroDivisors

/-- A nonzerodivisor stays a nonzerodivisor after flat base change. -/
@[ega "IV 20.6.9" "partial"]
public theorem nonZeroDivisor_algebraMap_of_flat {A B : Type*} [CommRing A] [CommRing B]
    [Algebra A B] [Module.Flat A B] {f : A} (hf : f ∈ nonZeroDivisors A) :
    algebraMap A B f ∈ nonZeroDivisors B := by
  rw [mem_nonZeroDivisors_iff]
  have hs := Module.Flat.isSMulRegular_of_nonZeroDivisors (M := B) hf
  exact ⟨fun x hx => hs (by simpa [Algebra.smul_def] using hx),
    fun x hx => hs (by simpa [Algebra.smul_def, mul_comm] using hx)⟩

/-- If the powers of `f` localize `A` to its total ring of fractions, then the image of `f` in
the integral closure of `A` there is a nonzerodivisor. -/
public theorem nonZeroDivisor_integralClosure_of_powerLocalization
    {A : Type*} [CommRing A] {f : A}
    (hL : IsLocalization (Submonoid.powers f) (FractionRing A)) :
    algebraMap A (integralClosure A (FractionRing A)) f ∈
      nonZeroDivisors (integralClosure A (FractionRing A)) := by
  exact mem_nonZeroDivisors_of_injective (f := (integralClosure A (FractionRing A)).val)
    Subtype.val_injective
    (IsLocalization.map_units (FractionRing A) ⟨f, Submonoid.mem_powers f⟩).mem_nonZeroDivisors

/-- A submonoid that localizes to a ring with injective structure map consists of
nonzerodivisors. -/
public lemma localization_submonoid_le_nonZeroDivisors
    {R S : Type*} [CommRing R] [CommRing S] [Algebra R S]
    (M : Submonoid R) [IsLocalization M S]
    (hinj : Function.Injective (algebraMap R S)) :
    M ≤ nonZeroDivisors R := fun s hs =>
  isRegular_iff_mem_nonZeroDivisors.mp <|
    (IsLocalization.injective_iff_isRegular M (S := S)).mp hinj ⟨s, hs⟩

namespace IsLocalRing

/-- In a one-dimensional Noetherian local ring, a nonzerodivisor in the maximal ideal cuts out
the closed point. -/
public theorem radical_span_regular_eq_maximalIdeal
    (A : Type*) [CommRing A] [IsNoetherianRing A] [IsLocalRing A] {x : A}
    (hx : x ∈ nonZeroDivisors A) (hxm : x ∈ IsLocalRing.maximalIdeal A)
    (hdim : ringKrullDim A = 1) :
    (Ideal.span {x} : Ideal A).radical = IsLocalRing.maximalIdeal A := by
  let I : Ideal A := Ideal.span {x}
  let Q := A ⧸ I
  have hItop : I ≠ ⊤ := ne_top_of_le_ne_top (IsLocalRing.maximalIdeal.isMaximal A).ne_top
    ((Ideal.span_singleton_le_iff_mem _).mpr hxm)
  have hdimQ' : ringKrullDim (A ⧸ Ideal.span {x}) = 0 := by
    have h :=
      ringKrullDim_quotient_span_singleton_succ_eq_ringKrullDim_of_mem_nonZeroDivisors hx hxm
    rw [hdim] at h
    have hbound : ringKrullDim (A ⧸ Ideal.span {x}) ≤ 1 := by
      rw [← hdim]
      exact ringKrullDim_quotient_le (Ideal.span {x})
    cases hq : ringKrullDim (A ⧸ Ideal.span {x}) with
    | bot =>
      exfalso
      have : Nontrivial (A ⧸ Ideal.span {x}) := Ideal.Quotient.nontrivial_iff.mpr hItop
      have hnonneg : (0 : WithBot ℕ∞) ≤ ringKrullDim (A ⧸ Ideal.span {x}) :=
        ringKrullDim_nonneg_of_nontrivial
      simp [hq] at hnonneg
    | coe d =>
      cases d with
      | top =>
        exfalso
        rw [hq] at hbound
        exact (not_le_of_gt (WithBot.coe_lt_coe.mpr (WithTop.coe_lt_top 1))) hbound
      | coe n =>
        have hnat : n + 1 = 1 :=
          ENat.natCast_inj.mp (WithBot.coe_inj.mp (by simpa [hq] using h))
        simp [show n = 0 by omega]
  have hdimQ : ringKrullDim Q = 0 := by simpa [Q, I] using hdimQ'
  have : Nontrivial Q := Ideal.Quotient.nontrivial_iff.mpr hItop
  have : IsLocalRing Q :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  have : IsLocalHom (Ideal.Quotient.mk I) :=
    IsLocalHom.of_surjective (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  have : Ring.KrullDimLE 0 Q := Ring.krullDimLE_iff.mpr hdimQ.le
  have hrad : I.radical = (nilradical Q).comap (Ideal.Quotient.mk I) := by
    change I.radical = Ideal.comap (Ideal.Quotient.mk I) (⊥ : Ideal Q).radical
    rw [Ideal.comap_radical, ← RingHom.ker_eq_comap_bot, Ideal.mk_ker]
  change I.radical = IsLocalRing.maximalIdeal A
  rw [hrad, Ring.KrullDimLE.nilradical_eq_maximalIdeal Q,
    IsLocalRing.maximalIdeal_comap (Ideal.Quotient.mk I)]

/-- In a reduced one-dimensional local ring, an element of the maximal ideal whose powers
localize to the total ring of fractions cuts out the closed point. -/
public lemma radical_span_eq_maximalIdeal_of_fractionRing_localization
    (R : Type*) [CommRing R] [IsLocalRing R] [IsReduced R]
    (hdim : ringKrullDim R = 1) {f : R} (hf : f ∈ maximalIdeal R)
    (hLoc : IsLocalization (Submonoid.powers f) (FractionRing R)) :
    (Ideal.span {f}).radical = maximalIdeal R := by
  have hreg : f ∈ nonZeroDivisors R :=
    localization_submonoid_le_nonZeroDivisors (S := FractionRing R) (Submonoid.powers f)
      (IsFractionRing.injective R (FractionRing R)) (Submonoid.mem_powers f)
  have hdimLE : Ring.KrullDimLE 1 R := by
    rw [Ring.krullDimLE_iff, hdim]
    norm_num
  refine le_antisymm ((IsLocalRing.maximalIdeal.isMaximal R).isPrime.radical_le_iff.mpr
    ((Ideal.span_singleton_le_iff_mem _).mpr hf)) ?_
  rw [Ideal.radical_eq_sInf]
  refine le_sInf fun p hp => ?_
  obtain hpmin | hpmax := (Ring.krullDimLE_one_iff.mp hdimLE) p hp.2
  · exact absurd hreg (notMem_nonZeroDivisors_of_mem_mem_minimalPrimes
      (hp.1 (Ideal.mem_span_singleton_self f)) hpmin)
  · rw [IsLocalRing.eq_maximalIdeal hpmax]

end IsLocalRing
