module

public import Mathlib.LinearAlgebra.Span.Basic
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.GlobalTypesOfModules
public import StacksFrontier.AlgebraicGeometry.AmpleWire.UnitStalk

/-!
# A spanning family of global sections generates a globally generated module

Let `X` be a scheme whose category of `𝒪_X`-modules is `k`-linear, and let `ℳ` be an
`𝒪_X`-module generated by its global sections. A global section of `ℳ` is a morphism
`𝒪_X ⟶ ℳ`. If a family `b : ι → Hom(𝒪_X, ℳ)` spans `Hom(𝒪_X, ℳ)` over `k`, then the morphism
`⨁_ι 𝒪_X ⟶ ℳ` it defines is an epimorphism: each generating section is a `k`-linear combination
of the `b i`, so the surjection from the free module on all generating sections factors through
it.

This is the step of the proof of Stacks 0DPA that turns "the sheaf `𝒦(m)` is globally generated
and `dim_k H⁰(ℙⁿ_k, 𝒦(m)) = N`" into "there is a surjection `𝒪^{⊕ N} ⟶ 𝒦(m)`".

## Main results

* `AlgebraicGeometry.epi_sigmaDesc_of_span_eq_top`: the morphism `⨁_ι 𝒪_X ⟶ ℳ` defined by a
  `k`-spanning family of global sections of a globally generated `ℳ` is an epimorphism.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

variable {k : Type u} [Field k] {X : Scheme.{u}} [Linear k X.Modules]

/-- **A spanning family of global sections generates.** If `ℳ` is generated by its global
sections and `b : ι → Hom(𝒪_X, ℳ)` spans `Hom(𝒪_X, ℳ)` over `k`, with `ι` finite, then the
morphism `⨁_ι 𝒪_X ⟶ ℳ` given by `b` is an epimorphism. -/
theorem epi_sigmaDesc_of_span_eq_top {M : X.Modules}
    (hM : SheafOfModules.IsGeneratedByGlobalSections M) {ι : Type*} [Finite ι]
    (b : ι → (Stacks.Ample.unitModule X ⟶ M))
    (hb : Submodule.span k (Set.range b) = ⊤) :
    Epi (Sigma.desc b : ∐ (fun _ : ι => Stacks.Ample.unitModule X) ⟶ M) := by
  have := Fintype.ofFinite ι
  obtain ⟨σ⟩ := hM
  have hc : ∀ i : σ.I, ∃ c : ι → k,
      ∑ j, c j • b j = Sigma.ι (fun _ : σ.I => Stacks.Ample.unitModule X) i ≫ σ.π :=
    fun i => (Submodule.mem_span_range_iff_exists_fun k).1 (hb ▸ Submodule.mem_top)
  choose c hc using hc
  let φ : (∐ fun _ : σ.I => Stacks.Ample.unitModule X) ⟶
      ∐ fun _ : ι => Stacks.Ample.unitModule X :=
    Sigma.desc fun i => ∑ j, c i j • Sigma.ι (fun _ : ι => Stacks.Ample.unitModule X) j
  have hfac : φ ≫ Sigma.desc b = σ.π := by
    refine Sigma.hom_ext _ _ fun i => ?_
    rw [Sigma.ι_comp_desc_assoc, Preadditive.sum_comp, ← hc i]
    exact Finset.sum_congr rfl fun j _ => by rw [Linear.smul_comp, Sigma.ι_comp_desc]
  have : Epi (φ ≫ Sigma.desc b) := hfac ▸ σ.epi
  exact epi_of_epi φ _

end AlgebraicGeometry
