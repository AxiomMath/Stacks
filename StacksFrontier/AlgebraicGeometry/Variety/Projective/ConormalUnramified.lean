module

public import StacksFrontier.AlgebraicGeometry.Variety.Projective.ProjectionStalkMap
public import StacksFrontier.AlgebraicGeometry.Variety.Projective.TangencyLocus
public import StacksFrontier.AlgebraicGeometry.Variety.Tangent.UnramifiedCotangent

/-!
# The conormal space of a closed subscheme of a projective space, and unramifiedness

Let `V` be a vector space over a field `k`, let `x` be a point of a scheme `X` closed-immersed in
`𝐏(V)`, and let `W_x` be the hyperplane of degree-one forms vanishing at the image of `x`. The
*conormal space* of `X` at `x` is the subspace of `W_x` whose affine coordinates have zero class
in `𝔪_x / 𝔪_x²`. The cotangent space of `𝐏(V)` at a rational point is `W_x`, so the conormal space
is the kernel of the surjection from that cotangent space onto the one of `X`.

The projection `r_W` away from the linear subspace cut out by a submodule `W` is unramified at `x`
as soon as `W ⊓ W_x` spans `W_x` together with the conormal space: the affine coordinates of
`W ⊓ W_x` come from the target, those of the conormal space die in `𝔪_x / 𝔪_x²`, and together they
generate `𝔪_x` modulo `𝔪_x²`, which is the vanishing of the relative cotangent space.

## Main definitions

* `AlgebraicGeometry.ProjectiveSpaceOfModule.toStalk`: the local ring of `𝐏(V)` at the image of
  `x`, mapped to the stalk of `X` at `x`.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.conormal`: the conormal space.

## Main results

* `AlgebraicGeometry.ProjectiveSpaceOfModule.conormal_indep`: the conormal space does not depend
  on the chart vector, so it may be computed in whichever chart a given projection dictates.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.maximalIdeal_le_span_chartGerm`: the affine
  coordinates of `W_x` generate the maximal ideal at `x` modulo its square.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.chartGerm_mem_map_maximalIdeal`: the affine
  coordinate of a form in `W ⊓ W_x` lies in the ideal generated by the image of the maximal ideal
  of `𝐏(W)` at the image point.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.unramifiedAt_projection_of_sup_eq`: the projection is
  unramified at `x` when `W ⊓ W_x` spans `W_x` together with the conormal space.

## Implementation notes

The conormal space is built as an explicit `Submodule`, rather than as the comap of an ideal along
the affine-coordinate map, because the latter needs `Submodule.restrictScalars` and hence an
`IsScalarTower k R R` instance which is not available for a homogeneous localization.

Three pitfalls in this part of the library.

First, a `(deterministic) timeout at isDefEq` here is *not* always a universe mismatch. An
*applied* `show` which forces `toStalk` to unfold across `projectionDomain` provokes one even when
all the universes already agree; the stalk map must be decomposed as a composite of ring
homomorphisms *before* being applied to an element.

Second, `(j ≫ ι).base x` and `(j.base x).1` are definitionally equal but not interchangeable for
`rw`, which needs the type of the rewritten argument to match syntactically.
`AlgebraicGeometry.ProjectiveSpaceOfModule.stalkMap_projection_chartGerm` uses the second
spelling, so every statement feeding it must use that spelling too. The same syntactic-matching
problem appears in a second guise: a membership extracted from a span over a lambda arrives
un-beta-reduced, and must be reduced before any rewrite will fire on it.

Third, the `Algebra k` structure on a homogeneous localization reuses
`HomogeneousLocalization.instSMul` rather than `Algebra.toSMul`, so `Algebra.smul_def` does not
apply to it; `AlgebraicGeometry.ProjectiveSpaceOfModule.smul_eq_groundFieldHom_mul` is the
replacement.

## References

* [Stacks Project, Tag 0B1Q](https://stacks.math.columbia.edu/tag/0B1Q)
* [Stacks Project, Tag 0B2E](https://stacks.math.columbia.edu/tag/0B2E)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory IsLocalRing

attribute [local instance] AlgebraicGeometry.stalkResidueAlgebra
  AlgebraicGeometry.stalkMapAlgebra AlgebraicGeometry.stalkMapIsLocalHom
  AlgebraicGeometry.residueFieldMapAlgebra
  AlgebraicGeometry.relativeCotangentSpaceResidueModule

namespace AlgebraicGeometry.ProjectiveSpaceOfModule

universe u

variable {k V : Type u} [Field k] [AddCommGroup V] [Module k V]
variable {X : Scheme.{u}} (i : X ⟶ projectiveSpaceOfModule k V) (x : X)

/-- The local ring of `𝐏(V)` at the image of `x`, mapped to the stalk of `X` at `x`. -/
public def toStalk : localRing (i.base x) →+* X.presheaf.stalk x :=
  (i.stalkMap x).hom.comp ((stalkRingEquiv (i.base x)).symm : localRing (i.base x) →+* _)

/-- **The conormal space of `X` at `x`**: the degree-one forms vanishing at the image of `x`
whose affine coordinate has zero class in `𝔪_x / 𝔪_x²`. -/
public def conormal {v₀ : V} (hv₀ : v₀ ∉ pointSubmodule k V (i.base x)) : Submodule k V where
  carrier := {v | v ∈ pointSubmodule k V (i.base x) ∧
    toStalk i x (chartGerm (i.base x) hv₀ v) ∈ maximalIdeal (X.presheaf.stalk x) ^ 2}
  zero_mem' := by refine ⟨Submodule.zero_mem _, ?_⟩; simp
  add_mem' := fun {a b} ha hb => by
    refine ⟨Submodule.add_mem _ ha.1 hb.1, ?_⟩
    rw [LinearMap.map_add, RingHom.map_add]
    exact Ideal.add_mem _ ha.2 hb.2
  smul_mem' := fun c {a} ha => by
    refine ⟨Submodule.smul_mem _ _ ha.1, ?_⟩
    have h1 : chartGerm (i.base x) hv₀ (c • a) = c • chartGerm (i.base x) hv₀ a :=
      LinearMap.map_smul _ _ _
    rw [h1, smul_eq_groundFieldHom_mul, RingHom.map_mul]
    exact Ideal.mul_mem_left _ _ ha.2

/-- Membership in the conormal space, unfolded. -/
public theorem mem_conormal_iff {v₀ : V} (hv₀ : v₀ ∉ pointSubmodule k V (i.base x)) (v : V) :
    v ∈ conormal i x hv₀ ↔ (v ∈ pointSubmodule k V (i.base x) ∧
      toStalk i x (chartGerm (i.base x) hv₀ v) ∈ maximalIdeal (X.presheaf.stalk x) ^ 2) :=
  Iff.rfl

/-- The conormal space consists of degree-one forms vanishing at the image of `x`. -/
public theorem conormal_le {v₀ : V} (hv₀ : v₀ ∉ pointSubmodule k V (i.base x)) :
    conormal i x hv₀ ≤ pointSubmodule k V (i.base x) := fun _ hv => hv.1

section ClosedImmersion

variable [IsClosedImmersion i]

/-- The comparison map to the stalk of a closed subscheme is surjective. -/
public theorem toStalk_surjective : Function.Surjective (toStalk i x) :=
  (i.stalkMap_surjective x).comp (stalkRingEquiv (i.base x)).symm.surjective

/-- The comparison map to the stalk of a closed subscheme is a local homomorphism. -/
public instance : IsLocalHom (toStalk i x) := RingHom.isLocalHom_comp _ _

/-- The comparison map carries the maximal ideal of `𝐏(V)` at the image of `x` onto the maximal
ideal of `X` at `x`. -/
public theorem map_maximalIdeal_toStalk :
    (maximalIdeal (localRing (i.base x))).map (toStalk i x) =
      maximalIdeal (X.presheaf.stalk x) := by
  rw [← maximalIdeal_comap (toStalk i x),
    Ideal.map_comap_of_surjective _ (toStalk_surjective i x)]

/-- The comparison map sends differences in the square of the maximal ideal into the square of the
maximal ideal of the stalk. -/
private theorem toStalk_sub_mem_sq {a b : localRing (i.base x)}
    (h : a - b ∈ maximalIdeal (localRing (i.base x)) ^ 2) :
    toStalk i x a - toStalk i x b ∈ maximalIdeal (X.presheaf.stalk x) ^ 2 := by
  rw [← RingHom.map_sub, ← map_maximalIdeal_toStalk i x, ← Ideal.map_pow]
  exact Ideal.mem_map_of_mem _ h

/-- **The conormal space does not depend on the chart vector**, once the two chart vectors are
normalised against each other. This is what allows it to be defined once and then computed in a
chart lying inside the submodule cut out by a given projection. -/
public theorem conormal_indep {v₀ v₁ : V} (hv₀ : v₀ ∉ pointSubmodule k V (i.base x))
    (hv₁ : v₁ ∉ pointSubmodule k V (i.base x))
    (hsub : v₀ - v₁ ∈ pointSubmodule k V (i.base x)) :
    conormal i x hv₀ = conormal i x hv₁ := by
  have key : ∀ (a b : V) (ha : a ∉ pointSubmodule k V (i.base x))
      (hb : b ∉ pointSubmodule k V (i.base x)), a - b ∈ pointSubmodule k V (i.base x) →
      conormal i x ha ≤ conormal i x hb := by
    intro a b ha hb hab v hv
    refine ⟨hv.1, ?_⟩
    have hd : chartGerm (i.base x) hb v - chartGerm (i.base x) ha v ∈
        maximalIdeal (localRing (i.base x)) ^ 2 :=
      chartGerm_sub_chartGerm_mem_maximalIdeal_sq ha hb hab hv.1
    simpa using Ideal.add_mem _ (toStalk_sub_mem_sq i x hd) hv.2
  exact le_antisymm (key v₀ v₁ hv₀ hv₁ hsub)
    (key v₁ v₀ hv₁ hv₀ (by simpa using Submodule.neg_mem _ hsub))

/-- **The affine coordinates of `W_x` generate `𝔪_x` modulo `𝔪_x²`.** -/
public theorem maximalIdeal_le_span_chartGerm
    {f : Module.Dual k V} (hf : pointSubmodule k V (i.base x) = LinearMap.ker f)
    {v₀ : V} (hv₀ : v₀ ∉ pointSubmodule k V (i.base x)) (hfv₀ : f v₀ = 1) :
    maximalIdeal (X.presheaf.stalk x) ≤
      Ideal.span ((fun v => toStalk i x (chartGerm (i.base x) hv₀ v)) ''
        (↑(pointSubmodule k V (i.base x)) : Set V)) +
        maximalIdeal (X.presheaf.stalk x) ^ 2 := by
  intro η hη
  obtain ⟨ζ, hζ⟩ := toStalk_surjective i x η
  have hζm : ζ ∈ maximalIdeal (localRing (i.base x)) := by
    rw [mem_maximalIdeal]
    intro hu
    exact (mem_maximalIdeal η).mp hη (hζ ▸ hu.map (toStalk i x))
  obtain ⟨w, hw, hdiff⟩ := exists_sub_chartGerm_mem_maximalIdeal_sq hf hv₀ hfv₀ hζm
  rw [← hζ]
  exact Submodule.mem_sup.mpr ⟨toStalk i x (chartGerm (i.base x) hv₀ w),
    Ideal.subset_span ⟨w, hw, rfl⟩, _, toStalk_sub_mem_sq i x hdiff, by abel⟩

end ClosedImmersion

section Projection

variable (W : Submodule k V) (j : X ⟶ (projectionDomain k V W).toScheme)

/-- The stalk map of a composite, as a composite of ring homomorphisms. -/
private theorem stalkMap_comp_hom {Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Y ⟶ Z) :
    ((f ≫ g).stalkMap x).hom = (f.stalkMap x).hom.comp (g.stalkMap (f.base x)).hom := by
  rw [Scheme.Hom.stalkMap_comp]; rfl

/-- The comparison map of a composite with the inclusion of the domain of a projection
decomposes through the stalk of that domain. -/
public theorem toStalk_apply_decomp (xi : localRing ((j.base x).1)) :
    toStalk (j ≫ (projectionDomain k V W).ι) x xi =
      (j.stalkMap x).hom ((((projectionDomain k V W).ι.stalkMap (j.base x)).hom)
        ((stalkRingEquiv ((j.base x).1)).symm xi)) := by
  unfold toStalk
  rw [stalkMap_comp_hom]
  rfl

/-- **The affine coordinate of a form in `W ⊓ W_x` comes from the target of the projection**: it
lies in the ideal generated by the image of the maximal ideal of `𝐏(W)` at the image point. -/
public theorem chartGerm_mem_map_maximalIdeal
    {w₀ : ↥W} (hw₀ : w₀ ∉ pointSubmodule k ↥W ((projection k V W).base (j.base x)))
    (hv₀ : (w₀ : V) ∉ pointSubmodule k V (j.base x).1)
    (u : ↥W) (hu : (u : V) ∈ pointSubmodule k V (j.base x).1) :
    toStalk (j ≫ (projectionDomain k V W).ι) x (chartGerm _ hv₀ (u : V)) ∈
      (maximalIdeal ((projectiveSpaceOfModule k ↥W).presheaf.stalk
        ((projection k V W).base (j.base x)))).map
          ((j ≫ projection k V W).stalkMap x).hom := by
  have hmem : chartGerm ((projection k V W).base (j.base x)) hw₀ u ∈
      maximalIdeal (localRing ((projection k V W).base (j.base x))) :=
    chartGerm_mem_maximalIdeal hw₀ ((mem_pointSubmodule_projection_iff (j.base x) u).mpr hu)
  have hloc : IsLocalHom
      (stalkRingEquiv ((projection k V W).base (j.base x))).symm.toRingHom :=
    (stalkRingEquiv ((projection k V W).base (j.base x))).symm.surjective.isLocalHom
  have hstalkmem : (stalkRingEquiv ((projection k V W).base (j.base x))).symm
      (chartGerm ((projection k V W).base (j.base x)) hw₀ u) ∈
      maximalIdeal ((projectiveSpaceOfModule k ↥W).presheaf.stalk
        ((projection k V W).base (j.base x))) := by
    rw [← maximalIdeal_comap
      (stalkRingEquiv ((projection k V W).base (j.base x))).symm.toRingHom] at hmem
    exact hmem
  rw [toStalk_apply_decomp x W j, ← stalkMap_projection_chartGerm (j.base x) hw₀ hv₀ u,
    stalkMap_comp_hom]
  exact Ideal.mem_map_of_mem _ hstalkmem

/-- **The projection is unramified at `x` when `W ⊓ W_x` spans `W_x` together with the conormal
space.** The affine coordinates of `W ⊓ W_x` come from the target, those of the conormal space die
in `𝔪_x / 𝔪_x²`, and together they generate `𝔪_x` modulo `𝔪_x²`. -/
public theorem unramifiedAt_projection_of_sup_eq
    [IsClosedImmersion (j ≫ (projectionDomain k V W).ι)]
    [LocallyOfFiniteType (j ≫ projection k V W)]
    {f : Module.Dual k V} (hf : pointSubmodule k V (j.base x).1 = LinearMap.ker f)
    {w₀ : ↥W} (hw₀ : w₀ ∉ pointSubmodule k ↥W ((projection k V W).base (j.base x)))
    (hv₀ : (w₀ : V) ∉ pointSubmodule k V (j.base x).1) (hfw₀ : f (w₀ : V) = 1)
    (hsup : (W ⊓ pointSubmodule k V (j.base x).1) ⊔
        conormal (j ≫ (projectionDomain k V W).ι) x hv₀ =
      pointSubmodule k V (j.base x).1)
    (hsep : Algebra.IsSeparable
      ((projectiveSpaceOfModule k ↥W).residueField ((j ≫ projection k V W).base x))
      (X.residueField x)) :
    UnramifiedAt (j ≫ projection k V W) x := by
  rw [unramifiedAt_iff_subsingleton_relativeCotangentSpace _ x hsep,
    subsingleton_relativeCotangentSpace_iff]
  refine le_trans
    (maximalIdeal_le_span_chartGerm (j ≫ (projectionDomain k V W).ι) x hf hv₀ hfw₀)
    (sup_le ?_ le_sup_right)
  rw [Ideal.span_le]
  rintro _ ⟨v, hv, rfl⟩
  have hv' : v ∈ pointSubmodule k V (j.base x).1 := hv
  rw [← hsup] at hv'
  obtain ⟨u, hu, z, hz, huz⟩ := Submodule.mem_sup.mp hv'
  beta_reduce
  rw [← huz, LinearMap.map_add, RingHom.map_add]
  refine Ideal.add_mem _ ?_ (Submodule.mem_sup_right hz.2)
  refine Submodule.mem_sup_left ?_
  exact chartGerm_mem_map_maximalIdeal x W j hw₀ hv₀ ⟨u, hu.1⟩ hu.2

/-- `unramifiedAt_projection_of_sup_eq` for a closed immersion presented as factoring through the
domain of the projection, which is the form in which the projection away from a point is given. -/
public theorem unramifiedAt_projection_of_sup_eq_of_fac
    (i : X ⟶ projectiveSpaceOfModule k V) [IsClosedImmersion i]
    (hj : j ≫ (projectionDomain k V W).ι = i)
    [LocallyOfFiniteType (j ≫ projection k V W)]
    {f : Module.Dual k V} (hf : pointSubmodule k V (i.base x) = LinearMap.ker f)
    {w₀ : ↥W} (hw₀ : w₀ ∉ pointSubmodule k ↥W ((projection k V W).base (j.base x)))
    (hv₀ : (w₀ : V) ∉ pointSubmodule k V (i.base x)) (hfw₀ : f (w₀ : V) = 1)
    (hsup : (W ⊓ pointSubmodule k V (i.base x)) ⊔ conormal i x hv₀ =
      pointSubmodule k V (i.base x))
    (hsep : Algebra.IsSeparable
      ((projectiveSpaceOfModule k ↥W).residueField ((j ≫ projection k V W).base x))
      (X.residueField x)) :
    UnramifiedAt (j ≫ projection k V W) x := by
  subst hj
  exact unramifiedAt_projection_of_sup_eq x W j hf hw₀ hv₀ hfw₀ hsup hsep

end Projection

end AlgebraicGeometry.ProjectiveSpaceOfModule

end
