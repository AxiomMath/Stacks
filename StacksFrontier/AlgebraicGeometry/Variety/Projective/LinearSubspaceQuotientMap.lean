module

public import StacksFrontier.AlgebraicGeometry.Intersection.Projections.LinearAction
public import StacksFrontier.AlgebraicGeometry.Limits.ProjGradedSurjection01N0
public import StacksFrontier.AlgebraicGeometry.Variety.Projective.DimensionOfProjectiveSpace
public import StacksFrontier.AlgebraicGeometry.Variety.Projective.LinearSubspaceDimension
public import StacksFrontier.AlgebraicGeometry.Variety.Projective.LinesAvoidingSubvariety
public import StacksFrontier.LinearAlgebra.SymmetricPower.Presentation

/-!
# The closed immersion of the projective space of a quotient

For a submodule `W` of `V` the linear subspace `linearSubspace k V W ⊆ 𝐏(V)` cut out by the
degree-one equations in `W` is the image of the closed immersion `𝐏(V ⧸ W) ⟶ 𝐏(V)` induced by the
quotient map `V ⟶ V ⧸ W`. Hence it is homeomorphic to `𝐏(V ⧸ W)` and its dimension is
`dim_k (V ⧸ W) - 1`; a line, cut out by a submodule of corank two, has dimension one.

## Main definitions

* `AlgebraicGeometry.ProjectiveSpaceOfModule.quotientMap`: the morphism
  `𝐏(V ⧸ W) ⟶ 𝐏(V)` induced by `V ⟶ V ⧸ W`.

## Main results

* `SymPow.surjective_gradedSymAlgMap`: the graded homomorphism `Sym` of a surjective linear map
  is surjective.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.isClosedImmersion_quotientMap`: that morphism is a
  closed immersion.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.range_quotientMap`: its image is
  `linearSubspace k V W`.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.topologicalKrullDim_linearSubspace`: the dimension
  of `linearSubspace k V W` is the dimension of `𝐏(V ⧸ W)`.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.topologicalKrullDim_linearSubspace_of_finrank_eq`:
  it is `m` when `dim_k (V ⧸ W) = m + 1`.
* `AlgebraicGeometry.ProjectiveSpaceOfModule.topologicalKrullDim_linearSubspace_eq_one`: a line
  has dimension one.

## Implementation notes

The homeomorphism `L(W) ≃ₜ 𝐏(V ⧸ W)` on underlying spaces and the dimension of `L(W)` for a
finite-dimensional `V` are in
`StacksFrontier.AlgebraicGeometry.Variety.Projective.LinearSubspaceDimension`, which this file
imports; here the identification is through the closed immersion of schemes, and the dimension
statements need no finiteness of `V`.

The quotient map `V ⟶ V ⧸ W` is surjective, so `Sym (V ⟶ V ⧸ W)` is surjective — the symmetric
algebra is generated by the image of `ι` — and therefore the induced morphism of `Proj`'s is
defined everywhere and is a closed immersion, which is
`AlgebraicGeometry.Proj.isClosedImmersion_map_of_surjective'` (Tag 01N0 part (2)).

Its image is computed from the kernel of `Sym (V ⟶ V ⧸ W)`, which is the ideal generated by
`ι W`: the inclusion `⊆` is `SymPow.ker_symAlgMap_le_rangeIdeal`, and `⊇` is immediate. On points
the morphism is `ProjectiveSpectrum.comap`, so a point of the image is a relevant homogeneous
prime containing that kernel, that is a point at which every degree-one form in `W` vanishes,
which is membership in `linearSubspace k V W`; conversely a relevant homogeneous prime containing
`ι W` pushes forward to one of `Sym (V ⧸ W)` and comes back to itself, the pushforward being
prime because the map is surjective with kernel inside the prime, and relevant because the
irrelevant ideal of `Sym V` lands in the irrelevant ideal of `Sym (V ⧸ W)`.

Dimensions take values in `WithBot ℕ∞`. The statement is therefore an equality of the dimension
of `linearSubspace k V W` with the dimension of `𝐏(V ⧸ W)` rather than `dim_k (V ⧸ W) - 1`: for
`W = ⊤` the quotient is zero, `𝐏(0)` is empty and the dimension is `⊥`, which no subtraction-free
form of `dim_k (V ⧸ W) - 1` describes. The numerical corollary is stated from
`dim_k (V ⧸ W) = m + 1`, which excludes that case.

## References

* [Stacks Project, Tag 01N0](https://stacks.math.columbia.edu/tag/01N0)
* [Stacks Project, Tag 0B1R](https://stacks.math.columbia.edu/tag/0B1R)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory HomogeneousIdeal TopologicalSpace

universe u

namespace SymPow

variable {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
  [AddCommGroup N] [Module R N]

/-- The graded homomorphism induced by a surjective linear map is surjective. -/
public theorem surjective_gradedSymAlgMap (f : M →ₗ[R] N) (hf : Function.Surjective f) :
    Function.Surjective (gradedSymAlgMap f) :=
  symAlgMap_surjective f hf

end SymPow

namespace AlgebraicGeometry.ProjectiveSpaceOfModule

variable (k V : Type u) [Field k] [AddCommGroup V] [Module k V] (W : Submodule k V)

/-- The graded surjection `Sym_k V ⟶ Sym_k (V ⧸ W)` induced by the quotient map. -/
public abbrev quotientGradedHom :
    (fun n => SymPow.symmetricPower n k V) →+*ᵍ (fun n => SymPow.symmetricPower n k (V ⧸ W)) :=
  SymPow.gradedSymAlgMap W.mkQ

/-- The irrelevant ideal of `Sym_k V` is carried into the irrelevant ideal of `Sym_k (V ⧸ W)`:
the homomorphism is graded. -/
public theorem irrelevant_le_comap_quotientGradedHom :
    irrelevant (fun n => SymPow.symmetricPower n k V) ≤
      (irrelevant (fun n => SymPow.symmetricPower n k (V ⧸ W))).comap
        (quotientGradedHom k V W) := by
  rw [HomogeneousIdeal.irrelevant_le]
  intro n hn x hx
  exact mem_irrelevant_of_mem _ hn ((quotientGradedHom k V W).map_mem hx)

/-- **The morphism `𝐏(V ⧸ W) ⟶ 𝐏(V)` induced by the quotient map.** -/
public def quotientMap :
    projectiveSpaceOfModule k (V ⧸ W) ⟶ projectiveSpaceOfModule k V :=
  Proj.map (quotientGradedHom k V W)
    (Proj.irrelevant_le_map_of_surjective _ (surjective_gradedSymAlgMap_mkQ W))

/-- The morphism `𝐏(V ⧸ W) ⟶ 𝐏(V)` induced by the quotient map is a closed immersion. -/
public instance isClosedImmersion_quotientMap : IsClosedImmersion (quotientMap k V W) :=
  Proj.isClosedImmersion_map_of_surjective' _ (surjective_gradedSymAlgMap_mkQ W)

/-- The kernel of `Sym_k V ⟶ Sym_k (V ⧸ W)` is the ideal generated by the degree-one forms in
`W`. -/
public theorem ker_quotientGradedHom_le_span :
    RingHom.ker ((quotientGradedHom k V W).toRingHom) ≤
      Ideal.span (Set.range ((SymmetricAlgebra.ι k V) ∘ ((↑) : W → V))) := fun x hx =>
  SymPow.ker_symAlgMap_le_rangeIdeal W.subtype W.mkQ W.mkQ_surjective
    (by rw [Submodule.ker_mkQ, Submodule.range_subtype]) (hx : SymPow.symAlgMap W.mkQ x = 0)

/-- A point of `𝐏(V)` whose prime contains the kernel of `Sym_k V ⟶ Sym_k (V ⧸ W)` lies in the
image of `𝐏(V ⧸ W) ⟶ 𝐏(V)`. -/
private theorem mem_range_quotientMap_of_ker_le (p : projectiveSpaceOfModule k V)
    (hker : RingHom.ker ((quotientGradedHom k V W).toRingHom) ≤ p.asHomogeneousIdeal.toIdeal) :
    p ∈ Set.range (quotientMap k V W).base := by
  have hsurj := surjective_gradedSymAlgMap_mkQ W
  have hprime : (p.asHomogeneousIdeal.map (quotientGradedHom k V W)).toIdeal.IsPrime := by
    have := p.isPrime
    exact Ideal.map_isPrime_of_surjective hsurj hker
  have hcomap : (p.asHomogeneousIdeal.map (quotientGradedHom k V W)).comap
      (quotientGradedHom k V W) = p.asHomogeneousIdeal := by
    refine HomogeneousIdeal.ext ?_
    rw [HomogeneousIdeal.toIdeal_comap, HomogeneousIdeal.toIdeal_map,
      Ideal.comap_map_of_surjective _ hsurj, sup_eq_left]
    exact hker
  have hrel : ¬ irrelevant (fun n => SymPow.symmetricPower n k (V ⧸ W)) ≤
      p.asHomogeneousIdeal.map (quotientGradedHom k V W) := by
    intro hle
    refine p.not_irrelevant_le ((irrelevant_le_comap_quotientGradedHom k V W).trans ?_)
    rw [← hcomap]
    exact HomogeneousIdeal.comap_mono _ hle
  exact ⟨⟨p.asHomogeneousIdeal.map (quotientGradedHom k V W), hprime, hrel⟩,
    ProjectiveSpectrum.ext hcomap⟩

/-- **The image of `𝐏(V ⧸ W) ⟶ 𝐏(V)` is the linear subspace cut out by `W`.** -/
public theorem range_quotientMap :
    Set.range (quotientMap k V W).base = linearSubspace k V W := by
  ext p
  rw [mem_linearSubspace_iff]
  constructor
  · rintro ⟨q, rfl⟩ v hv
    rw [mem_pointSubmodule_iff]
    change quotientGradedHom k V W (SymmetricAlgebra.ι k V v) ∈ q.asHomogeneousIdeal
    rw [SymPow.gradedSymAlgMap_apply, SymPow.symAlgMap_ι,
      show W.mkQ v = 0 from (Submodule.Quotient.mk_eq_zero W).mpr hv, map_zero]
    exact zero_mem _
  · intro hp
    refine mem_range_quotientMap_of_ker_le k V W p
      ((ker_quotientGradedHom_le_span k V W).trans ?_)
    rw [Ideal.span_le]
    rintro _ ⟨w, rfl⟩
    exact (mem_pointSubmodule_iff k V p (w : V)).mp (hp w.2)

/-- **A projective linear subspace is homeomorphic to the projective space of the quotient.** -/
public theorem topologicalKrullDim_linearSubspace :
    topologicalKrullDim (linearSubspace k V W) =
      topologicalKrullDim (projectiveSpaceOfModule k (V ⧸ W)) :=
  ((IsHomeomorph.topologicalKrullDim_eq _
      (quotientMap k V W).isClosedEmbedding.isEmbedding.toHomeomorph.isHomeomorph).trans
    (IsHomeomorph.topologicalKrullDim_eq _
      (Homeomorph.setCongr (range_quotientMap k V W)).isHomeomorph)).symm

/-- The dimension of the linear subspace cut out by a submodule of corank `m + 1` is `m`. -/
public theorem topologicalKrullDim_linearSubspace_of_finrank_eq {m : ℕ}
    (hW : Module.finrank k (V ⧸ W) = m + 1) :
    topologicalKrullDim (linearSubspace k V W) = (m : WithBot ℕ∞) := by
  have : FiniteDimensional k (V ⧸ W) := .of_finrank_eq_succ hW
  rw [topologicalKrullDim_linearSubspace,
    topologicalKrullDim_projectiveSpaceOfModule_of_finrank_eq hW]

/-- **A line has dimension one**: the linear subspace cut out by a submodule of corank two. -/
public theorem topologicalKrullDim_linearSubspace_eq_one
    (hW : Module.finrank k (V ⧸ W) = 2) :
    topologicalKrullDim (linearSubspace k V W) = 1 :=
  topologicalKrullDim_linearSubspace_of_finrank_eq k V W (m := 1) hW

end AlgebraicGeometry.ProjectiveSpaceOfModule

end
