* [Stacks Project, Tag 0B2T](https://stacks.math.columbia.edu/tag/0B2T)
* [Stacks Project, Tag 01MY](https://stacks.math.columbia.edu/tag/01MY)
* [Stacks Project, Tag 0FCY](https://stacks.math.columbia.edu/tag/0FCY)
-/

@[expose] public noncomputable section

open AlgebraicGeometry TopologicalSpace
open Stacks.AlgebraicGeometry.ProjShared Stacks.AlgebraicGeometry.ProjTwistChain

namespace AlgebraicGeometry.ProjectiveSpaceOfModule

universe u v

variable (k : Type u) (V : Type v) [Field k] [AddCommGroup V] [Module k V]

/-- A vector has degree one in the symmetric algebra: the image of `v` under `SymmetricAlgebra.ι`
lies in the first symmetric power, which is the range of that map. -/
public theorem ι_mem_symmetricPower_one (v : V) :
    SymmetricAlgebra.ι k V v ∈ SymPow.symmetricPower 1 k V := by
  rw [SymPow.symmetricPower, pow_one]
  exact LinearMap.mem_range_self _ v

/-- The space of degree-one forms vanishing at a point of `P(V)`: the preimage in `V` of the
homogeneous prime cutting out the point. -/
public def pointSubmodule (q : projectiveSpaceOfModule k V) : Submodule k V :=
  (Submodule.restrictScalars k q.asHomogeneousIdeal.toIdeal).comap (SymmetricAlgebra.ι k V)

/-- A vector lies in the space of degree-one forms vanishing at a point exactly when its image
in the symmetric algebra lies in the homogeneous prime of that point. -/
public theorem mem_pointSubmodule_iff (q : projectiveSpaceOfModule k V) (v : V) :
    v ∈ pointSubmodule k V q ↔ SymmetricAlgebra.ι k V v ∈ q.asHomogeneousIdeal := Iff.rfl

/-- The projective linear subspace cut out by the degree-one equations in a submodule `W` of
`V`: the projective zero locus of the image of `W` in the symmetric algebra. -/
public def linearSubspace (W : Submodule k V) : Set (projectiveSpaceOfModule k V) :=
  ProjectiveSpectrum.zeroLocus (fun n => SymPow.symmetricPower n k V)
    (Set.range ((SymmetricAlgebra.ι k V) ∘ ((↑) : W → V)))

/-- A point lies on the linear subspace cut out by `W` exactly when every degree-one form in `W`
vanishes at it. -/
public theorem mem_linearSubspace_iff (W : Submodule k V) (q : projectiveSpaceOfModule k V) :
    q ∈ linearSubspace k V W ↔ W ≤ pointSubmodule k V q := by
  have h : q ∈ linearSubspace k V W ↔
      Set.range ((SymmetricAlgebra.ι k V) ∘ ((↑) : W → V)) ⊆ q.asHomogeneousIdeal :=
    ProjectiveSpectrum.mem_zeroLocus _ _ _
  rw [h, Set.range_subset_iff]
  exact ⟨fun hw v hv => (mem_pointSubmodule_iff k V q v).mpr (hw ⟨v, hv⟩),
    fun hw w => (mem_pointSubmodule_iff k V q (w : V)).mp (hw w.2)⟩

/-- A projective linear subspace is closed: it is a projective zero locus. -/
public theorem isClosed_linearSubspace (W : Submodule k V) :
    IsClosed (linearSubspace k V W) :=
  ProjectiveSpectrum.isClosed_zeroLocus _ _

/-- More equations cut out a smaller linear subspace. -/
public theorem linearSubspace_antitone {W W' : Submodule k V} (h : W ≤ W') :
    linearSubspace k V W' ⊆ linearSubspace k V W := fun q hq =>
  (mem_linearSubspace_iff k V W q).mpr (h.trans ((mem_linearSubspace_iff k V W' q).mp hq))

/-- No equations cut out the whole projective space. -/
@[simp]
public theorem linearSubspace_bot : linearSubspace k V ⊥ = Set.univ :=
  Set.eq_univ_of_forall fun q => (mem_linearSubspace_iff k V ⊥ q).mpr bot_le

/-- All degree-one equations cut out the empty set: a point of `Proj` does not contain the
irrelevant ideal. -/
@[simp]
public theorem linearSubspace_top : linearSubspace k V ⊤ = ∅ := by
  refine Set.eq_empty_iff_forall_notMem.mpr fun q hq => ?_
  obtain ⟨x, hx⟩ := exists_ι_notMem k V q
  exact hx ((mem_pointSubmodule_iff k V q x).mp
    ((mem_linearSubspace_iff k V ⊤ q).mp hq trivial))

/-- A nonzero linear functional on a vector space is surjective. -/
public theorem surjective_of_dual_ne_zero {f : Module.Dual k V} (hf : f ≠ 0) :
    Function.Surjective f := by
  obtain ⟨v, hv⟩ : ∃ v, f v ≠ 0 := DFunLike.ne_iff.mp hf
  intro c
  exact ⟨(c / f v) • v, by rw [map_smul, smul_eq_mul, div_mul_cancel₀ _ hv]⟩

/-- A closed point of `P(V)` has no proper specializations: a point whose homogeneous prime
contains that of a closed point equals it. -/
public theorem eq_of_asHomogeneousIdeal_le {p q : projectiveSpaceOfModule k V}
    (hp : IsClosed ({p} : Set (projectiveSpaceOfModule k V)))
    (hle : p.asHomogeneousIdeal.toIdeal ≤ q.asHomogeneousIdeal.toIdeal) : q = p := by
  have hqmem : q ∈ closure ({p} : Set (projectiveSpaceOfModule k V)) := by
    let A : ℕ → Submodule k (SymmetricAlgebra k V) := fun n => SymPow.symmetricPower n k V
    let pp : ProjectiveSpectrum A := p
    let qq : ProjectiveSpectrum A := q
    show qq ∈ closure ({pp} : Set (ProjectiveSpectrum A))
    rw [← ProjectiveSpectrum.zeroLocus_vanishingIdeal_eq_closure,
      ProjectiveSpectrum.mem_zeroLocus]
    intro z hz
    rw [ProjectiveSpectrum.vanishingIdeal_singleton] at hz
    exact hle hz
  simpa [hp.closure_eq] using hqmem

/-- The degree-one forms vanishing at the point cut out by a nonzero functional are exactly the
vectors it kills. -/
public theorem pointSubmodule_linearFunctionalPoint (f : Module.Dual k V) (hf : f ≠ 0) :
    pointSubmodule k V (linearFunctionalPoint k V f hf) = LinearMap.ker f := by
  ext v
  rw [mem_pointSubmodule_iff, linearFunctionalPoint_ι_mem, LinearMap.mem_ker]

/-- The homogeneous ideal of the point cut out by a nonzero functional `f` is generated by the
degree-one forms in the kernel of `f`. -/
public theorem span_range_ι_ker_eq (f : Module.Dual k V) (hf : f ≠ 0) :
    Ideal.span (Set.range ((SymmetricAlgebra.ι k V) ∘ ((↑) : LinearMap.ker f → V))) =
      (linearFunctionalPoint k V f hf).asHomogeneousIdeal.toIdeal := by
  have hri : SymPow.rangeIdeal (LinearMap.ker f).subtype =
      Ideal.span (Set.range ((SymmetricAlgebra.ι k V) ∘ ((↑) : LinearMap.ker f → V))) := rfl
  refine le_antisymm (Ideal.span_le.mpr ?_) fun z hz => ?_
  · rintro _ ⟨w, rfl⟩
    refine (linearFunctionalPoint_mem k V f hf _).mpr ?_
    have hw : f (w : V) = 0 := w.2
    simp [Function.comp_apply, SymPow.symAlgMap_ι, hw]
  · rw [← hri]
    exact SymPow.ker_symAlgMap_le_rangeIdeal (LinearMap.ker f).subtype f
      (surjective_of_dual_ne_zero k V hf) (by rw [Submodule.range_subtype])
      ((linearFunctionalPoint_mem k V f hf z).mp hz)

/-- **The hyperplane of a point.** The linear subspace cut out by the kernel of a nonzero
functional is the single point that functional cuts out. -/
public theorem linearSubspace_ker (f : Module.Dual k V) (hf : f ≠ 0) :
    linearSubspace k V (LinearMap.ker f) = {linearFunctionalPoint k V f hf} := by
  ext q
  rw [mem_linearSubspace_iff, Set.mem_singleton_iff]
  constructor
  · intro hq
    refine eq_of_asHomogeneousIdeal_le k V (linearFunctionalPoint_isClosed k V f hf) ?_
    rw [← span_range_ι_ker_eq k V f hf, Ideal.span_le]
    rintro _ ⟨w, rfl⟩
    exact (mem_pointSubmodule_iff k V q (w : V)).mp (hq w.2)
  · rintro rfl
    rw [pointSubmodule_linearFunctionalPoint]

/-- Over an algebraically closed field every closed point of `P(V)` is the point cut out by a
nonzero linear functional on `V`. -/
public theorem exists_eq_linearFunctionalPoint [IsAlgClosed k] [Module.Finite k V]
    (p : projectiveSpaceOfModule k V) (hp : IsClosed ({p} : Set (projectiveSpaceOfModule k V))) :
    ∃ (f : Module.Dual k V) (hf : f ≠ 0), p = linearFunctionalPoint k V f hf := by
  obtain ⟨f, hf, _, hfull⟩ := exists_dual_of_closedPoint k V ⟨p, hp⟩
  refine ⟨f, hf, ProjectiveSpectrum.ext (HomogeneousIdeal.toIdeal_injective ?_)⟩
  ext z
  exact (hfull z).trans (linearFunctionalPoint_mem k V f hf z).symm

/-- **The hyperplane of a closed point cuts out exactly that point.** -/
public theorem linearSubspace_pointSubmodule [IsAlgClosed k] [Module.Finite k V]
    (p : projectiveSpaceOfModule k V) (hp : IsClosed ({p} : Set (projectiveSpaceOfModule k V))) :
    linearSubspace k V (pointSubmodule k V p) = {p} := by
  obtain ⟨f, hf, rfl⟩ := exists_eq_linearFunctionalPoint k V p hp
  rw [pointSubmodule_linearFunctionalPoint, linearSubspace_ker]

/-- The degree-one forms vanishing at a closed point form a hyperplane of `V`. -/
public theorem finrank_quotient_pointSubmodule [IsAlgClosed k] [Module.Finite k V]
    (p : projectiveSpaceOfModule k V) (hp : IsClosed ({p} : Set (projectiveSpaceOfModule k V))) :
    Module.finrank k (V ⧸ pointSubmodule k V p) = 1 := by
  obtain ⟨f, hf, rfl⟩ := exists_eq_linearFunctionalPoint k V p hp
  rw [pointSubmodule_linearFunctionalPoint,
    (LinearMap.quotKerEquivOfSurjective f (surjective_of_dual_ne_zero k V hf)).finrank_eq,
    Module.finrank_self]

/-- The image under the inclusion of `W` of a positive-degree symmetric power of `W` lands in
the homogeneous prime of any point of the linear subspace cut out by `W`. -/
private theorem symAlgMap_subtype_mem (W : Submodule k V) (q : projectiveSpaceOfModule k V)
    (h : W ≤ pointSubmodule k V q) (d : ℕ) (hd : 0 < d) (g : SymmetricAlgebra k W)
    (hg : g ∈ SymPow.symmetricPower d k W) :
    SymPow.symAlgMap W.subtype g ∈ q.asHomogeneousIdeal.toIdeal := by
  obtain ⟨m, rfl⟩ : ∃ m, d = m + 1 := ⟨d - 1, by omega⟩
  rw [SymPow.symmetricPower, pow_succ'] at hg
  refine Submodule.mul_induction_on hg ?_ fun x y hx hy => by
    simpa only [map_add] using add_mem hx hy
  rintro a ⟨x, rfl⟩ b _
  rw [_root_.map_mul, SymPow.symAlgMap_ι]
  exact q.asHomogeneousIdeal.toIdeal.mul_mem_right _
    ((mem_pointSubmodule_iff k V q (x : V)).mp (h x.2))

/-- **The domain of the linear projection away from `W`.** A point of `P(V)` lies outside the
domain of definition of the morphism induced by the inclusion `W ≤ V` exactly when it lies on
the linear subspace cut out by `W`. -/
public theorem notMem_mapDomain_iff_mem_linearSubspace (W : Submodule k V)
    (q : projectiveSpaceOfModule k V) :
    q ∉ mapDomain (fun n => SymPow.symmetricPower n k W)
        (fun n => SymPow.symmetricPower n k V) (SymPow.gradedSymAlgMap W.subtype) ↔
      q ∈ linearSubspace k V W := by
  rw [mem_linearSubspace_iff]
  constructor
  · intro h v hv
    rw [mem_pointSubmodule_iff]
    by_contra hmem
    refine h ((mem_mapDomain_iff _ _ _ q).mpr
      ⟨1, SymmetricAlgebra.ι k W ⟨v, hv⟩, Nat.one_pos, ?_, ?_⟩)
    · simp
    · simpa [SymPow.gradedSymAlgMap_apply, SymPow.symAlgMap_ι] using hmem
  · intro h hq
    obtain ⟨d, g, hd, hg, hgq⟩ := (mem_mapDomain_iff _ _ _ q).mp hq
    exact hgq (symAlgMap_subtype_mem k V W q h d hd g hg)

/-- The domain of definition of the projection away from `W` is the complement of the linear
subspace cut out by `W`. -/
public theorem coe_mapDomain_subtype (W : Submodule k V) :
    (mapDomain (fun n => SymPow.symmetricPower n k W)
          (fun n => SymPow.symmetricPower n k V) (SymPow.gradedSymAlgMap W.subtype) :
        Set (projectiveSpaceOfModule k V)) = (linearSubspace k V W)ᶜ := by
  ext q
  rw [Set.mem_compl_iff, ← notMem_mapDomain_iff_mem_linearSubspace k V W q, not_not]
  exact Iff.rfl

/-- **The linear projection away from a linear subspace.** For a submodule `W ≤ V` the inclusion
induces a morphism from the complement of the linear subspace cut out by `W` to `P(W)`; for a
hyperplane `W` attached to a closed point `p` this is the projection `r_p` away from `p`. -/
public def projection (W : Submodule k V) :
    (mapDomain (fun n => SymPow.symmetricPower n k W)
        (fun n => SymPow.symmetricPower n k V)
        (SymPow.gradedSymAlgMap W.subtype)).toScheme ⟶ projectiveSpaceOfModule k W :=
  mapHom _ _ (SymPow.gradedSymAlgMap W.subtype)

/-- The projection away from a closed point is defined exactly on the complement of that
point. -/
public theorem coe_mapDomain_pointSubmodule [IsAlgClosed k] [Module.Finite k V]
    (p : projectiveSpaceOfModule k V) (hp : IsClosed ({p} : Set (projectiveSpaceOfModule k V))) :
    (mapDomain (fun n => SymPow.symmetricPower n k (pointSubmodule k V p))
          (fun n => SymPow.symmetricPower n k V)
          (SymPow.gradedSymAlgMap (pointSubmodule k V p).subtype) :
        Set (projectiveSpaceOfModule k V)) = {p}ᶜ := by
  rw [coe_mapDomain_subtype, linearSubspace_pointSubmodule k V p hp]

/-- A degree-zero element of the homogeneous prime of a point of `P(V)` is zero: a nonzero
scalar is a unit of the symmetric algebra. -/
public theorem eq_zero_of_mem_symmetricPower_zero (q : projectiveSpaceOfModule k V)
    {x : SymmetricAlgebra k V} (hx0 : x ∈ SymPow.symmetricPower 0 k V)
    (hx : x ∈ q.asHomogeneousIdeal) : x = 0 := by
  rw [SymPow.symmetricPower, pow_zero, Submodule.mem_one] at hx0
  obtain ⟨c, rfl⟩ := hx0
  by_contra hne
  have hc : c ≠ 0 := by
    rintro rfl
    exact hne (by simp)
  refine (Ideal.ne_top_iff_one _).mp q.isPrime.ne_top ?_
  have hmul := q.asHomogeneousIdeal.toIdeal.mul_mem_left (algebraMap k _ c⁻¹) hx
  rwa [← _root_.map_mul, inv_mul_cancel₀ hc, _root_.map_one] at hmul

/-- A point of `P(V)` is determined by the positive-degree homogeneous elements of its
homogeneous prime. -/
public theorem eq_of_forall_homogeneous_mem_iff {q q' : projectiveSpaceOfModule k V}
    (h : ∀ d : ℕ, 0 < d → ∀ x ∈ SymPow.symmetricPower d k V,
      (x ∈ q.asHomogeneousIdeal ↔ x ∈ q'.asHomogeneousIdeal)) : q = q' := by
  refine ProjectiveSpectrum.ext (HomogeneousIdeal.toIdeal_injective ?_)
  ext z
  rw [q.asHomogeneousIdeal.isHomogeneous.mem_iff, q'.asHomogeneousIdeal.isHomogeneous.mem_iff]
  refine forall_congr' fun n => ?_
  have hproj : (↑((DirectSum.decompose (fun m => SymPow.symmetricPower m k V) z) n) :
      SymmetricAlgebra k V) ∈ SymPow.symmetricPower n k V :=
    ((DirectSum.decompose (fun m => SymPow.symmetricPower m k V) z) n).property
  rcases Nat.eq_zero_or_pos n with rfl | hn
  · exact ⟨fun hz => by simp [eq_zero_of_mem_symmetricPower_zero k V q hproj hz],
      fun hz => by simp [eq_zero_of_mem_symmetricPower_zero k V q' hproj hz]⟩
  · exact h n hn _ hproj

/-- **The projection away from `W` on points.** A homogeneous element of `Sym W` of positive
degree lies in the homogeneous prime of the image of a point exactly when its image in `Sym V`
lies in the homogeneous prime of that point. -/
public theorem mem_projection_iff (W : Submodule k V)
    (y : (mapDomain (fun n => SymPow.symmetricPower n k W)
      (fun n => SymPow.symmetricPower n k V)
      (SymPow.gradedSymAlgMap W.subtype)).toScheme)
    {d : ℕ} (hd : 0 < d) {g : SymmetricAlgebra k W}
    (hg : g ∈ SymPow.symmetricPower d k W) :
    g ∈ (projection k V W y).asHomogeneousIdeal ↔
      SymPow.symAlgMap W.subtype g ∈
        (y.val : projectiveSpaceOfModule k V).asHomogeneousIdeal := by
  unfold projection
  have hpre := mapHom_preimage_basicOpen (fun n => SymPow.symmetricPower n k W)
    (fun n => SymPow.symmetricPower n k V) (SymPow.gradedSymAlgMap W.subtype) g d hg hd
  have h : y ∈ mapHom (fun n => SymPow.symmetricPower n k W)
        (fun n => SymPow.symmetricPower n k V) (SymPow.gradedSymAlgMap W.subtype) ⁻¹ᵁ
        Proj.basicOpen (fun n => SymPow.symmetricPower n k W) g ↔
      y ∈ (mapDomain (fun n => SymPow.symmetricPower n k W)
        (fun n => SymPow.symmetricPower n k V) (SymPow.gradedSymAlgMap W.subtype)).ι ⁻¹ᵁ
        Proj.basicOpen (fun n => SymPow.symmetricPower n k V)
          (SymPow.gradedSymAlgMap W.subtype g) := by rw [hpre]
  rw [Scheme.Hom.mem_preimage, Scheme.Hom.mem_preimage, Proj.mem_basicOpen,
    Proj.mem_basicOpen] at h
  exact not_iff_not.mp h

/-- **The projection away from `W` on the points cut out by linear functionals.** The point cut
out by a functional `f` on `V` is sent to the point of `P(W)` cut out by the restriction of `f`
to `W`. -/
public theorem projection_eq_linearFunctionalPoint (W : Submodule k V)
    (y : (mapDomain (fun n => SymPow.symmetricPower n k W)
      (fun n => SymPow.symmetricPower n k V)
      (SymPow.gradedSymAlgMap W.subtype)).toScheme)
    (f : Module.Dual k V) (hf : f ≠ 0) (hfW : f ∘ₗ W.subtype ≠ 0)
    (hy : (y.val : projectiveSpaceOfModule k V) = linearFunctionalPoint k V f hf) :
    projection k V W y = linearFunctionalPoint k W (f ∘ₗ W.subtype) hfW := by
  refine eq_of_forall_homogeneous_mem_iff k W fun d hd g hg => ?_
  rw [mem_projection_iff k V W y hd hg, hy, linearFunctionalPoint_mem k V f hf,
    linearFunctionalPoint_mem k W (f ∘ₗ W.subtype) hfW, SymPow.symAlgMap_comp_apply]

/-- **The fibre of the projection away from `W` through a point lies on the join of `W` and that
point.** Two points of the domain of definition with the same image lie together on a linear
subspace whose equations are the degree-one forms vanishing on `W` and at the second point. For
`W` the hyperplane of a closed point `p` and `q` a closed point distinct from `p`, that linear
subspace is the line through `p` and `q`. -/
public theorem mem_linearSubspace_inf_of_projection_eq (W : Submodule k V)
    (y q : (mapDomain (fun n => SymPow.symmetricPower n k W)
      (fun n => SymPow.symmetricPower n k V)
      (SymPow.gradedSymAlgMap W.subtype)).toScheme)
    (h : projection k V W y = projection k V W q) :
    (y.val : projectiveSpaceOfModule k V) ∈
      linearSubspace k V (W ⊓ pointSubmodule k V q.val) := by
  rw [mem_linearSubspace_iff]
  rintro u ⟨huW, huq⟩
  have h1 : SymmetricAlgebra.ι k W ⟨u, huW⟩ ∈ SymPow.symmetricPower 1 k W := by simp
  have hιq : SymPow.symAlgMap W.subtype (SymmetricAlgebra.ι k W ⟨u, huW⟩) ∈
      (q.val : projectiveSpaceOfModule k V).asHomogeneousIdeal := by
    rw [SymPow.symAlgMap_ι]
    exact (mem_pointSubmodule_iff k V q.val u).mp huq
  have hmem : SymmetricAlgebra.ι k W ⟨u, huW⟩ ∈ (projection k V W y).asHomogeneousIdeal := by
    rw [h]
    exact (mem_projection_iff k V W q Nat.one_pos h1).mpr hιq
  have hy := (mem_projection_iff k V W y Nat.one_pos h1).mp hmem
  rw [SymPow.symAlgMap_ι] at hy
  exact (mem_pointSubmodule_iff k V y.val u).mpr hy

/-- A functional whose kernel contains the kernel of a nonzero functional is a scalar multiple
of it. -/
private theorem exists_smul_of_ker_le_ker {f g : Module.Dual k V} (hg : g ≠ 0)
    (hle : LinearMap.ker g ≤ LinearMap.ker f) : ∃ c : k, f = c • g := by
  obtain ⟨v, hv⟩ : ∃ v, g v ≠ 0 := DFunLike.ne_iff.mp hg
  refine ⟨f ((g v)⁻¹ • v), ?_⟩
  ext w
  have hker : w - (g w) • ((g v)⁻¹ • v) ∈ LinearMap.ker g := by
    rw [LinearMap.mem_ker, map_sub, map_smul, map_smul, smul_eq_mul, smul_eq_mul,
      inv_mul_cancel₀ hv, mul_one, sub_self]
  have hz := LinearMap.mem_ker.mp (hle hker)
  rw [map_sub, map_smul, smul_eq_mul, sub_eq_zero] at hz
  rw [LinearMap.smul_apply, smul_eq_mul, hz, mul_comm]

/-- Two nonzero functionals one of whose kernels contains the other's have equal kernels. -/
private theorem ker_eq_ker_of_le {f g : Module.Dual k V} (hf : f ≠ 0) (hg : g ≠ 0)
    (hle : LinearMap.ker g ≤ LinearMap.ker f) : LinearMap.ker f = LinearMap.ker g := by
  obtain ⟨c, rfl⟩ := exists_smul_of_ker_le_ker k V hg hle
  have hc : c ≠ 0 := by
    rintro rfl
    exact hf (by simp)
  exact LinearMap.ker_smul g c hc

/-- Of two nonzero functionals with distinct kernels, some vector is killed by the second but
not by the first. -/
private theorem exists_apply_eq_zero_and_ne_zero {f g : Module.Dual k V} (hf : f ≠ 0)
    (hg : g ≠ 0) (hne : LinearMap.ker f ≠ LinearMap.ker g) : ∃ v, g v = 0 ∧ f v ≠ 0 := by
  by_contra hc
  refine hne (ker_eq_ker_of_le k V hf hg fun x hx => LinearMap.mem_ker.mpr ?_)
  by_contra hfx
  exact hc ⟨x, LinearMap.mem_ker.mp hx, hfx⟩

/-- The common kernel of two nonzero functionals with distinct kernels has corank two: together
they define a surjection onto `k × k`. -/
private theorem finrank_quotient_inf_ker {f g : Module.Dual k V} (hf : f ≠ 0) (hg : g ≠ 0)
    (hne : LinearMap.ker f ≠ LinearMap.ker g) :
    Module.finrank k (V ⧸ (LinearMap.ker f ⊓ LinearMap.ker g)) = 2 := by
  obtain ⟨v, hv0, hv⟩ := exists_apply_eq_zero_and_ne_zero k V hf hg hne
  obtain ⟨w, hw0, hw⟩ := exists_apply_eq_zero_and_ne_zero k V hg hf hne.symm
  have hsurj : Function.Surjective (f.prod g) := by
    rintro ⟨a, b⟩
    have h1 : f ((a / f v) • v + (b / g w) • w) = a := by
      rw [map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul, hw0, mul_zero, add_zero,
        div_mul_cancel₀ _ hv]
    have h2 : g ((a / f v) • v + (b / g w) • w) = b := by
      rw [map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul, hv0, mul_zero, zero_add,
        div_mul_cancel₀ _ hw]
    exact ⟨(a / f v) • v + (b / g w) • w, Prod.ext h1 h2⟩
  rw [← LinearMap.ker_prod f g,
    (LinearMap.quotKerEquivOfSurjective (f.prod g) hsurj).finrank_eq]
  simp

/-- **Two nonzero functionals with distinct kernels have common kernel of corank two.** This is
`finrank_quotient_inf_ker` above, made available to other modules.

It holds over an arbitrary field and asks nothing of `V` beyond being a module, which is what
distinguishes it from `finrank_quotient_lineSubmodule` below: that form reads the same corank off
two distinct *closed* points and so needs `[IsAlgClosed k]` and `[Module.Finite k V]`. Over the
residue field of a point that is not closed only this form applies, and the chart computations
that work there are outside this file. -/
@[sga "7 XVII 2.1" "partial"]
public alias finrank_quotient_inf_ker_eq_two := finrank_quotient_inf_ker

/-- The submodule of degree-one forms vanishing at two points of `P(V)`. For distinct closed
points it has corank two in `V`, so the linear subspace it cuts out is the line joining them. -/
public def lineSubmodule (p q : projectiveSpaceOfModule k V) : Submodule k V :=
  pointSubmodule k V p ⊓ pointSubmodule k V q

/-- The first of the two points lies on the linear subspace cut out by `lineSubmodule`. -/
public theorem left_mem_linearSubspace_lineSubmodule (p q : projectiveSpaceOfModule k V) :
    p ∈ linearSubspace k V (lineSubmodule k V p q) :=
  (mem_linearSubspace_iff k V _ p).mpr inf_le_left

/-- The second of the two points lies on the linear subspace cut out by `lineSubmodule`. -/
public theorem right_mem_linearSubspace_lineSubmodule (p q : projectiveSpaceOfModule k V) :
    q ∈ linearSubspace k V (lineSubmodule k V p q) :=
  (mem_linearSubspace_iff k V _ q).mpr inf_le_right

/-- A closed point of `P(V)` is determined by its hyperplane of degree-one forms. -/
public theorem eq_of_pointSubmodule_eq [IsAlgClosed k] [Module.Finite k V]
    {p q : projectiveSpaceOfModule k V}
    (hp : IsClosed ({p} : Set (projectiveSpaceOfModule k V)))
    (hq : IsClosed ({q} : Set (projectiveSpaceOfModule k V)))
    (h : pointSubmodule k V p = pointSubmodule k V q) : p = q :=
  Set.singleton_injective (by
    rw [← linearSubspace_pointSubmodule k V p hp, h, linearSubspace_pointSubmodule k V q hq])

/-- **The line through two distinct closed points.** The degree-one forms vanishing at both of
two distinct closed points have corank two in `V`, so the linear subspace they cut out is a
projective line, and it passes through both points. -/
public theorem finrank_quotient_lineSubmodule [IsAlgClosed k] [Module.Finite k V]
    {p q : projectiveSpaceOfModule k V}
    (hp : IsClosed ({p} : Set (projectiveSpaceOfModule k V)))
    (hq : IsClosed ({q} : Set (projectiveSpaceOfModule k V))) (hpq : p ≠ q) :
    Module.finrank k (V ⧸ lineSubmodule k V p q) = 2 := by
  obtain ⟨f, hf, rfl⟩ := exists_eq_linearFunctionalPoint k V p hp
  obtain ⟨g, hg, rfl⟩ := exists_eq_linearFunctionalPoint k V q hq
  have hne : LinearMap.ker f ≠ LinearMap.ker g := by
    refine fun h => hpq ?_
    have hzero : ∀ v, f v = 0 ↔ g v = 0 := fun v => by
      rw [← LinearMap.mem_ker, ← LinearMap.mem_ker, h]
    obtain ⟨c, rfl⟩ := Module.Dual.exists_units_smul_eq_of_forall_eq_zero_iff hg hzero
    exact linearFunctionalPoint_units_smul k V c g hg hf
  rw [lineSubmodule, pointSubmodule_linearFunctionalPoint, pointSubmodule_linearFunctionalPoint]
  exact finrank_quotient_inf_ker k V hf hg hne

end AlgebraicGeometry.ProjectiveSpaceOfModule

end
