/-!
# A criterion for gluing one-dimensional rings

Let `A` and `B` be subrings of a field `K` which is the fraction field of `A`, with `A`
Noetherian of dimension one. The multiplication map from `A ⊗[ℤ] B` to `K` fails to be
surjective exactly when `A` and `B` are both contained in a discrete valuation subring of `K`.
The obstruction is the subring generated by `A` and `B`: if the map is not surjective that
subring is not a field, so it has a proper nonzero ideal, and a valuation subring dominating it
is Noetherian by Krull--Akizuki, hence a discrete valuation ring.

## Main results

* `Subring.not_surjective_tensorProduct_iff_exists_isDiscreteValuationRing` gives the
  equivalence between failure of surjectivity and existence of the discrete valuation subring.

## Implementation notes

The rings in the gluing situation are represented as literal subrings of their common fraction
field. Thus the map from the tensor product is the canonical multiplication map induced by the
two subtype homomorphisms. The intersection ring of the situation is determined by `A` and `B`
and is not needed in the statement of this criterion.

## References

* [Stacks Project, Tag 09N0](https://stacks.math.columbia.edu/tag/09N0)
-/

@[expose] public section

/-- In a subring of a field that is itself a field, the inverse of a nonzero element lies in it. -/
private theorem inv_mem_of_isField {K : Type*} [Field K] {S : Subring K} (hS : IsField S)
    {x : K} (hx : x ∈ S) (hx0 : x ≠ 0) : x⁻¹ ∈ S := by
  let _ := hS.toField
  exact Submonoid.inv_mem_of_isUnit (isUnit_iff_ne_zero.mpr
    (fun hz => hx0 (congrArg Subtype.val hz) : (⟨x, hx⟩ : S) ≠ 0))

/-- A valuation subring containing a nonzero nonunit is not a field. -/
private theorem ValuationSubring.not_isField_of_mem_nonunits {K : Type*} [Field K]
    (V : ValuationSubring K) {c : K} (hc : c ∈ V.nonunits) (hc0 : c ≠ 0) : ¬ IsField V :=
  fun hf => (V.mem_nonunits_iff_or.mp hc).resolve_left hc0
    (inv_mem_of_isField (S := V.toSubring) hf (V.nonunits_subset hc) hc0)

namespace Subring

universe u

/-- A subring that is a field and contains a subring whose fraction field is `K` is all of `K`. -/
private theorem eq_top_of_le_of_isField {K : Type*} [Field K] {A C : Subring K}
    [IsFractionRing A K] (hAC : A ≤ C) (hC : IsField C) : C = ⊤ := by
  refine (Subring.eq_top_iff' C).2 fun k => ?_
  obtain ⟨a, b, hb, rfl⟩ := IsFractionRing.div_surjective A k
  have hb0 : (b : K) ≠ 0 := fun hz => nonZeroDivisors.ne_zero hb (Subtype.ext hz)
  rw [div_eq_mul_inv]
  exact C.mul_mem (hAC a.2) (inv_mem_of_isField hC (hAC b.2) hb0)

/-- If two subrings of a field lie in a common discrete valuation subring, the multiplication
map from their tensor product is not surjective. -/
private theorem not_surjective_tensorProduct_of_le_isDiscreteValuationRing {K : Type u} [Field K]
    {A B O : Subring K} [IsDiscreteValuationRing O] (hAO : A ≤ O) (hBO : B ≤ O) :
    ¬ Function.Surjective
      (Algebra.TensorProduct.lift (B := B) A.subtype.toIntAlgHom
        B.subtype.toIntAlgHom (fun _ _ ↦ Commute.all _ _)) := by
  intro hsurj
  have hmap : ∀ z, Algebra.TensorProduct.lift (B := B) A.subtype.toIntAlgHom
      B.subtype.toIntAlgHom (fun _ _ ↦ Commute.all _ _) z ∈ O := by
    intro z
    induction z with
    | tmul a b =>
      simpa [Algebra.TensorProduct.lift_tmul] using O.mul_mem (hAO a.2) (hBO b.2)
    | add x y hx hy =>
      simpa only [map_add] using O.add_mem hx hy
  have hOtop : O = ⊤ := (Subring.eq_top_iff' O).2 fun x => by
    obtain ⟨z, rfl⟩ := hsurj x
    exact hmap z
  have hOfield : IsField O := by
    rw [hOtop]
    exact Subring.topEquiv.toMulEquiv.isField (Field.toIsField K)
  exact IsDiscreteValuationRing.not_isField O hOfield

/-- For two subrings of a field that is the fraction field of the first, with
the first Noetherian and one-dimensional, the multiplication map from their
tensor product is not surjective if and only if they are contained in a common
discrete valuation subring. -/
@[stacks 09N0]
public theorem not_surjective_tensorProduct_iff_exists_isDiscreteValuationRing
    {K : Type u} [Field K] (A B : Subring K)
    [IsFractionRing A K] [IsNoetherianRing A]
    (h_dim : ringKrullDim A = 1) :
    (¬ Function.Surjective
      (Algebra.TensorProduct.lift (B := B) A.subtype.toIntAlgHom
        B.subtype.toIntAlgHom (fun _ _ ↦ Commute.all _ _))) ↔
      ∃ O : Subring K, IsDiscreteValuationRing O ∧ A ≤ O ∧ B ≤ O := by
  let f := Algebra.TensorProduct.lift (B := B) A.subtype.toIntAlgHom
    B.subtype.toIntAlgHom (fun _ _ ↦ Commute.all _ _)
  let C : Subring K := f.toRingHom.range
  have hAC : A ≤ C := fun x hx =>
    ⟨(⟨x, hx⟩ : A) ⊗ₜ[ℤ] (1 : B), by simp [f, Algebra.TensorProduct.lift_tmul]⟩
  have hBC : B ≤ C := fun y hy =>
    ⟨(1 : A) ⊗ₜ[ℤ] (⟨y, hy⟩ : B), by simp [f, Algebra.TensorProduct.lift_tmul]⟩
  constructor
  · intro hns
    have hCfield : ¬ IsField C := fun hCf => hns fun k =>
      RingHom.mem_range.1 ((Subring.eq_top_iff' C).1 (eq_top_of_le_of_isField hAC hCf) k)
    obtain ⟨I, hbot, htop⟩ :=
      (Ring.not_isField_iff_exists_ideal_bot_lt_and_lt_top (R := C)).mp hCfield
    obtain ⟨V, hCV, hI_nonunits⟩ :=
      Ideal.image_subset_nonunits_valuationSubring I (ne_of_lt htop)
    obtain ⟨c, hcI, hc0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot (ne_of_gt hbot)
    have hAO : A ≤ V.toSubring := hAC.trans hCV
    have hNoeth : IsNoetherianRing (↥V.toSubring) := by
      refine krull_akizuki (↥A) K K h_dim V.toSubring ?_
      rintro _ ⟨a, rfl⟩
      exact hAO a.2
    have hDVR : IsDiscreteValuationRing V :=
      (valuation_ring_noetherian_iff_dvr_or_field V).mp hNoeth |>.resolve_right
        (V.not_isField_of_mem_nonunits (hI_nonunits ⟨c, hcI, rfl⟩) fun hz => hc0 (Subtype.ext hz))
    exact ⟨V.toSubring, hDVR, hAO, hBC.trans hCV⟩
  · rintro ⟨O, hDVR, hAO, hBO⟩
    exact not_surjective_tensorProduct_of_le_isDiscreteValuationRing hAO hBO

end Subring
