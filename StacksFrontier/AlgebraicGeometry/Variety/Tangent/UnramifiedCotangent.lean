module

public import StacksFrontier.AlgebraicGeometry.Variety.Tangent.MaximalIdealCotangent
public import StacksFrontier.AlgebraicGeometry.Variety.Tangent.Unramified
public import StacksFrontier.Deformation.Basic

/-!
# Unramifiedness read on the relative cotangent space

A morphism locally of finite type is unramified at a point exactly when the relative cotangent
space `𝔪_x / (𝔪_{f x} 𝒪_{X,x} + 𝔪_x²)` of its stalk map vanishes there, that is, exactly when
the maximal ideal of the local ring at the point is generated by the maximal ideal of the target
together with the square of its own.

## Main results

* `IsLocalRing.subsingleton_relativeCotangentSpace_iff`: the relative cotangent space of a local
  homomorphism vanishes exactly when the maximal ideal of the source generates, with the square
  of the maximal ideal of the target, that whole maximal ideal.
* `AlgebraicGeometry.unramifiedAt_iff_subsingleton_relativeCotangentSpace`: a morphism locally of
  finite type is unramified at a point exactly when the relative cotangent space of its stalk map
  there vanishes.

## Implementation notes

The separability hypothesis on the residue field extension is the one under which the relative
tangent space is the `κ(x)`-linear dual of the relative cotangent space (Tag 0B2E). It is
automatic at a closed point over an algebraically closed field, where both residue fields are the
base field.

## References

* [Stacks Project, Tag 06GY](https://stacks.math.columbia.edu/tag/06GY)
* [Stacks Project, Tag 0B2E](https://stacks.math.columbia.edu/tag/0B2E)
* [Stacks Project, Tag 0B2G](https://stacks.math.columbia.edu/tag/0B2G)
-/

@[expose] public section

open CategoryTheory IsLocalRing

universe u v

namespace IsLocalRing

/-- **The relative cotangent space of a local homomorphism vanishes exactly when the maximal
ideal of the target is generated by that of the source together with its own square.** -/
public theorem subsingleton_relativeCotangentSpace_iff {R : Type u} {S : Type v} [CommRing R]
    [CommRing S] [IsLocalRing R] [IsLocalRing S] (f : R →+* S) [IsLocalHom f] :
    Subsingleton (Deformation.relativeCotangentSpace f) ↔
      maximalIdeal S ≤ (maximalIdeal R).map f + maximalIdeal S ^ 2 := by
  rw [Submodule.Quotient.subsingleton_iff, Submodule.comap_subtype_eq_top]

/-- **Descent of the unramifiedness condition along a surjection.** For a surjective local
homomorphism `ψ : A → B` and an ideal `J` of `A`, the maximal ideal of `B` is generated by the
image of `J` together with its own square exactly when the maximal ideal of `A` is generated by
`J`, the kernel of `ψ`, and its own square. -/
public theorem le_map_add_sq_iff_of_surjective {A : Type u} {B : Type v} [CommRing A] [CommRing B]
    [IsLocalRing A] [IsLocalRing B] (ψ : A →+* B) [IsLocalHom ψ]
    (hψ : Function.Surjective ψ) (J : Ideal A) :
    maximalIdeal B ≤ J.map ψ + maximalIdeal B ^ 2 ↔
      maximalIdeal A ≤ J + RingHom.ker ψ + maximalIdeal A ^ 2 := by
  have hmB : (maximalIdeal A).map ψ = maximalIdeal B := by
    rw [← maximalIdeal_comap ψ, Ideal.map_comap_of_surjective ψ hψ]
  set K : Ideal A := J + RingHom.ker ψ + maximalIdeal A ^ 2 with hK
  have hkerK : RingHom.ker ψ ≤ K := by
    rw [hK, Ideal.add_eq_sup, Ideal.add_eq_sup]
    exact le_sup_of_le_left le_sup_right
  have hkermap : (RingHom.ker ψ).map ψ = ⊥ := by
    rw [eq_bot_iff, Ideal.map_le_iff_le_comap, ← RingHom.ker_eq_comap_bot]
  have hmap : K.map ψ = J.map ψ + maximalIdeal B ^ 2 := by
    rw [hK, Ideal.add_eq_sup, Ideal.add_eq_sup, Ideal.map_sup, Ideal.map_sup,
      Ideal.map_pow, hmB, hkermap, Ideal.add_eq_sup]
    simp
  rw [← hmap]
  refine ⟨fun h ↦ ?_, fun h ↦ hmB.ge.trans (Ideal.map_mono h)⟩
  have := Ideal.comap_mono (f := ψ) h
  rwa [maximalIdeal_comap ψ, Ideal.comap_map_of_surjective' ψ hψ K,
    sup_eq_left.mpr hkerK] at this

end IsLocalRing

namespace AlgebraicGeometry

attribute [local instance] AlgebraicGeometry.stalkResidueAlgebra
  AlgebraicGeometry.stalkMapAlgebra AlgebraicGeometry.stalkMapIsLocalHom
  AlgebraicGeometry.residueFieldMapAlgebra
  AlgebraicGeometry.relativeCotangentSpaceResidueModule

/-- **A morphism locally of finite type is unramified at a point exactly when the relative
cotangent space of its stalk map there vanishes.** -/
public theorem unramifiedAt_iff_subsingleton_relativeCotangentSpace {X S : Scheme.{u}}
    (f : X ⟶ S) [LocallyOfFiniteType f] (x : X)
    (hsep : Algebra.IsSeparable (S.residueField (f.base x)) (X.residueField x)) :
    UnramifiedAt f x ↔
      Subsingleton (Deformation.relativeCotangentSpace (f.stalkMap x).hom) := by
  rw [← subsingleton_dottedTangentArrow_iff_unramifiedAt f x]
  refine (Equiv.subsingleton_congr
    (dottedTangentArrowEquivDualRelativeCotangentSpace f x hsep).toEquiv).trans ?_
  exact Module.subsingleton_dual_iff (ToType (X.residueField x))

end AlgebraicGeometry

end
