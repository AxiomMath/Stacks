/-!
# Geometric irreducible components are defined over a finite subextension

Let `K` be a separable closure of a field `k` and let `X` be locally of finite type over `k`.
Every irreducible component of the base change of `X` to `K` is the inverse image of an
irreducible component of the base change to some finite intermediate extension of `k` in `K`.
Consequently every such component is fixed by all automorphisms of `K` which fix a suitable
finite intermediate extension.

The proof is local: the generic point of the component lies in an affine open whose base change
is the spectrum of a tensor product `R ⊗[k] K`; the corresponding prime is finitely generated
because that ring is Noetherian, and the finitely many coefficients of a chosen set of generators
span a finite intermediate extension over which the prime, and hence the whole component, is
already invariant. Descent of the component to that intermediate extension is then
`AlgebraicGeometry.fixed_geometricComponent_iff_exists_geometricallyIrreducible_component`.

## Main results

* `AlgebraicGeometry.exists_finite_subextension_defining_component`: every geometric irreducible
  component is the inverse image of a component over a finite subextension.
* `AlgebraicGeometry.exists_finite_subextension_stabilizing_irreducible_component`: every
  geometric irreducible component is fixed by the automorphisms fixing a finite subextension.

## Implementation notes

Base changes are represented by categorical pullbacks. The two projection equations uniquely
characterize the canonical morphism from the base change over the separable closure to the base
change over the finite intermediate field. Saying that the inverse image of the component over
the intermediate field is the given component expresses the equality after base change in the
source.

## References

* [Stacks Project, Tag 04KZ](https://stacks.math.columbia.edu/tag/04KZ)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits
open scoped TensorProduct

namespace AlgebraicGeometry

universe u

/-! ### The Galois action on a tensor product -/

/-- The Galois action `AlgebraicGeometry.tensorGaloisAut` of
`StacksFrontier/AlgebraicGeometry/Variety/Geometric/GaloisInvariantClosed.lean` on a tensor
product sends `a ⊗ b` to `a ⊗ σ b`. -/
@[simp]
private theorem tensorGaloisAut_tmul
    {k K A : Type u} [Field k] [Field K] [CommRing A]
    [Algebra k K] [Algebra k A] (σ : K ≃ₐ[k] K) (a : A) (b : K) :
    tensorGaloisAut k K A σ (a ⊗ₜ[k] b) = a ⊗ₜ[k] σ b := rfl

/-! ### Finite subextensions fixing a finitely generated ideal -/

/-- The second coordinates of a chosen representation of an element of `A ⊗[k] K` as a finite
sum of elementary tensors. -/
private noncomputable def tensorCoefficients {k K A : Type u} [Field k] [Field K]
    [CommRing A] [Algebra k K] [Algebra k A] (z : A ⊗[k] K) : Finset K := by
  classical
  exact (TensorProduct.exists_finset z).choose.image Prod.snd

private theorem tensorCoefficients_repr {k K A : Type u} [Field k] [Field K]
    [CommRing A] [Algebra k K] [Algebra k A] (z : A ⊗[k] K) :
    z = ((TensorProduct.exists_finset z).choose).sum fun q => q.1 ⊗ₜ[k] q.2 :=
  (TensorProduct.exists_finset z).choose_spec

/-- The intermediate field generated by the coefficients of a finite set of elements of
`A ⊗[k] K`. -/
private noncomputable def tensorCoefficientField {k K A : Type u} [Field k] [Field K]
    [CommRing A] [Algebra k K] [Algebra k A] (s : Finset (A ⊗[k] K)) :
    IntermediateField k K := by
  classical
  exact IntermediateField.adjoin k (↑(s.biUnion tensorCoefficients) : Set K)

private theorem finite_tensorCoefficientField {k K A : Type u} [Field k] [Field K]
    [CommRing A] [Algebra k K] [Algebra k A] [IsSepClosure k K]
    (s : Finset (A ⊗[k] K)) : FiniteDimensional k (tensorCoefficientField s) := by
  classical
  have halg : Algebra.IsAlgebraic k K := IsSepClosure.separable.isAlgebraic
  exact IntermediateField.finiteDimensional_adjoin
    (S := (↑(s.biUnion tensorCoefficients) : Set K)) fun x _ => (halg.isIntegral).1 x

/-- A finite set of elements of `A ⊗[k] K` is fixed by all `k`-automorphisms of `K`
fixing a suitable finite intermediate field. -/
private theorem exists_finite_field_fixing_tensor_finset {k K A : Type u} [Field k] [Field K]
    [CommRing A] [Algebra k K] [Algebra k A] [IsSepClosure k K]
    (s : Finset (A ⊗[k] K)) :
    ∃ E : IntermediateField k K, FiniteDimensional k E ∧
      ∀ σ : K ≃ₐ[k] K, (∀ x : E, σ x = x) →
        ∀ z ∈ s, tensorGaloisAut k K A σ z = z := by
  classical
  refine ⟨tensorCoefficientField s, finite_tensorCoefficientField s, ?_⟩
  intro σ hσ z hz
  rw [tensorCoefficients_repr z, map_sum]
  refine Finset.sum_congr rfl fun q hq => ?_
  have hmem : q.2 ∈ (IntermediateField.adjoin k
      (↑(s.biUnion tensorCoefficients) : Set K) : Set K) :=
    IntermediateField.subset_adjoin k (↑(s.biUnion tensorCoefficients) : Set K)
      (Finset.mem_biUnion.mpr ⟨z, hz, Finset.mem_image.mpr ⟨q, hq, rfl⟩⟩)
  rw [tensorGaloisAut_tmul, hσ ⟨q.2, hmem⟩]

/-- A finitely generated ideal of `A ⊗[k] K` is invariant under all `k`-automorphisms of `K`
fixing a suitable finite intermediate field. -/
private theorem exists_finite_field_fixing_tensor_fg_ideal {k K A : Type u} [Field k] [Field K]
    [CommRing A] [Algebra k K] [Algebra k A] [IsSepClosure k K]
    (I : Ideal (A ⊗[k] K)) (hI : I.FG) :
    ∃ E : IntermediateField k K, FiniteDimensional k E ∧
      ∀ σ : K ≃ₐ[k] K, (∀ x : E, σ x = x) →
        Ideal.comap (tensorGaloisAut k K A σ).toRingEquiv.toRingHom I = I := by
  classical
  obtain ⟨s, hs⟩ := hI
  obtain ⟨E, hE, hfix⟩ := exists_finite_field_fixing_tensor_finset (k := k) (K := K) (A := A) s
  refine ⟨E, hE, fun σ hσ => ?_⟩
  have hinv : I.map (tensorGaloisAut k K A σ).symm.toRingEquiv.toRingHom = I := by
    have hsymm : ∀ z ∈ s, (tensorGaloisAut k K A σ).symm z = z := by
      intro z hz
      refine (tensorGaloisAut k K A σ).injective ?_
      rw [AlgEquiv.apply_symm_apply, hfix σ hσ z hz]
    rw [← hs, Ideal.map_span]
    refine congrArg _ (Set.eq_of_subset_of_subset ?_ ?_)
    · rintro _ ⟨y, hy, rfl⟩
      show (tensorGaloisAut k K A σ).symm y ∈ (↑s : Set (A ⊗[k] K))
      rw [hsymm y hy]
      exact hy
    · exact fun x hx => ⟨x, hx, hsymm x hx⟩
  exact (Ideal.map_comap_of_equiv (tensorGaloisAut k K A σ).symm.toRingEquiv).symm.trans hinv

/-! ### Stabilizing a geometric irreducible component -/

/-- A separable closure of a field is a separable closure of each of its intermediate
fields. -/
public theorem isSepClosure_of_intermediateField {k K : Type u} [Field k] [Field K]
    [Algebra k K] [IsSepClosure k K] (E : IntermediateField k K) : IsSepClosure E K := by
  let : Algebra.IsSeparable E K := Algebra.isSeparable_tower_top_of_isSeparable k E K
  exact ⟨IsSepClosure.sep_closed k, inferInstance⟩

/-- If `Spec A` is of finite type over a field `k`, then `A ⊗[k] K` is Noetherian for every
field extension `K` of `k`. -/
private theorem isNoetherianRing_tensorProduct {k K A : Type u} [Field k] [Field K]
    [CommRing A] [Algebra k K] [Algebra k A]
    [LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap k A)))] :
    IsNoetherianRing (A ⊗[k] K) := by
  have hK : IsLocallyNoetherian (Spec (.of K)) := by
    rw [isLocallyNoetherian_Spec]
    infer_instance
  have hpb : IsLocallyNoetherian (pullback (Spec.map (CommRingCat.ofHom (algebraMap k A)))
      (Spec.map (CommRingCat.ofHom (algebraMap k K)))) := inferInstance
  have : IsLocallyNoetherian (Spec (.of (A ⊗[k] K))) :=
    isLocallyNoetherian_of_isOpenImmersion (pullbackSpecIso k A K).inv
  exact (isLocallyNoetherian_Spec (R := .of (A ⊗[k] K))).mp this

/-- A morphism of base changes to `K` lying over a morphism of `k`-schemes and over `Spec K`
intertwines the Galois self-maps. -/
private theorem galoisBaseChangeMap_comm_of_comp
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    {X X' : Scheme.{u}} (f : X ⟶ Spec (.of k)) (f' : X' ⟶ Spec (.of k)) (h : X' ⟶ X)
    (m : pullback f' (Spec.map (CommRingCat.ofHom (algebraMap k K))) ⟶
      pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))))
    (hfst : m ≫ pullback.fst _ _ = pullback.fst _ _ ≫ h)
    (hsnd : m ≫ pullback.snd _ _ = pullback.snd _ _) (σ : K ≃ₐ[k] K) :
    m ≫ galoisBaseChangeMap k K X f σ = galoisBaseChangeMap k K X' f' σ ≫ m := by
  refine pullback.hom_ext ?_ ?_
  · rw [Category.assoc, galoisBaseChangeMap_fst, hfst, Category.assoc, hfst, ← Category.assoc,
      galoisBaseChangeMap_fst]
  · rw [Category.assoc, galoisBaseChangeMap_snd, ← Category.assoc, hsnd, Category.assoc, hsnd,
      galoisBaseChangeMap_snd]

/-- An automorphism of the base change fixing the generic point of an irreducible component
maps the component onto itself. -/
private theorem galoisBaseChangeMap_image_eq_of_genericPoint
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    (X : Scheme.{u}) (f : X ⟶ Spec (.of k)) (σ : K ≃ₐ[k] K)
    (Z : irreducibleComponents
      (pullback (C := Scheme.{u}) f (Spec.map (CommRingCat.ofHom (algebraMap k K)))))
    (hZ : (galoisBaseChangeMap k K X f σ).base Z.2.1.genericPoint = Z.2.1.genericPoint) :
    (galoisBaseChangeMap k K X f σ).base '' (Z : Set _) = Z := by
  have hcl := Z.2.1.closure_genericPoint (isClosed_of_mem_irreducibleComponents Z.1 Z.2)
  let a := Scheme.homeoOfIso
    ((galoisActionOnBaseChange k K (Over.mk f)).ρAut (MulOpposite.op σ)).asIso
  have ha : ∀ x, (galoisBaseChangeMap k K X f σ).base x = a x := fun _ => rfl
  rw [← hcl, Set.image_congr' ha, a.image_closure, Set.image_singleton,
    show a Z.2.1.genericPoint = _ from (ha _).symm.trans hZ, hcl]

/-- Every point of the base change to `K` of the spectrum of a `k`-algebra of finite type is
fixed by the automorphisms of `K` fixing a suitable finite intermediate extension. -/
private theorem exists_finite_field_fixing_point_spec
    {k K R : Type u} [Field k] [Field K] [Algebra k K] [IsSepClosure k K] [CommRing R] [Algebra k R]
    [LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap k R)))]
    (y : pullback (C := Scheme.{u}) (Spec.map (CommRingCat.ofHom (algebraMap k R)))
      (Spec.map (CommRingCat.ofHom (algebraMap k K)))) :
    ∃ E : IntermediateField k K, FiniteDimensional k E ∧
      ∀ σ : K ≃ₐ[k] K, (∀ x : E, σ x = x) →
        (galoisBaseChangeMap k K (Spec (.of R))
          (Spec.map (CommRingCat.ofHom (algebraMap k R))) σ).base y = y := by
  let e := pullbackSpecIso k R K
  let p : PrimeSpectrum (R ⊗[k] K) := e.hom.base y
  obtain ⟨E, hE, hI⟩ := exists_finite_field_fixing_tensor_fg_ideal (k := k) (K := K) (A := R)
    p.asIdeal ((isNoetherianRing_iff_ideal_fg _).mp isNoetherianRing_tensorProduct p.asIdeal)
  refine ⟨E, hE, fun σ hσ => ?_⟩
  let τ := tensorGaloisAut k K R σ
  let localAction := galoisBaseChangeMap k K (Spec (.of R))
    (Spec.map (CommRingCat.ofHom (algebraMap k R))) σ
  have hprime : PrimeSpectrum.comap τ.toRingEquiv.toRingHom p = p := by
    apply PrimeSpectrum.ext
    rw [PrimeSpectrum.comap_asIdeal]
    exact hI σ hσ
  have hcomp : localAction ≫ e.hom =
      e.hom ≫ Spec.map (CommRingCat.ofHom τ.toRingEquiv.toRingHom) := by
    rw [show localAction = _ from galoisBaseChangeMap_pullbackSpecIso k K R σ]
    simp [Category.assoc]
    rfl
  apply e.hom.isEmbedding.injective
  have hh := congrArg (fun v => v.base y) hcomp
  change e.hom.base (localAction.base y) =
    (Spec.map (CommRingCat.ofHom τ.toRingEquiv.toRingHom)).base p at hh
  exact hh.trans hprime

/-- Every irreducible component of the base change of a scheme locally of finite type along a
separable closure is carried onto itself by the automorphisms of the closure fixing a suitable
finite intermediate extension. -/
private theorem exists_finite_field_stabilizing_component
    {k K : Type u} [Field k] [Field K] [Algebra k K] [IsSepClosure k K]
    (X : Scheme.{u}) (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f]
    (Z : irreducibleComponents
      (pullback (C := Scheme.{u}) f
        (Spec.map (CommRingCat.ofHom (algebraMap k K))))) :
    ∃ E : IntermediateField k K, FiniteDimensional k E ∧
      ∀ σ : K ≃ₐ[k] K, (∀ x : E, σ x = x) →
        (galoisBaseChangeMap k K X f σ).base '' (Z : Set _) = (Z : Set _) := by
  classical
  let Y := pullback (C := Scheme.{u}) f
    (Spec.map (CommRingCat.ofHom (algebraMap k K)))
  let q := pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K)))
  let η := Z.2.1.genericPoint
  obtain ⟨R, i, hi, y, hy⟩ := Scheme.exists_Spec_apply_eq (q.base η)
  let φ : CommRingCat.of k ⟶ R := Spec.preimage (i ≫ f)
  have hφ : Spec.map φ = i ≫ f := Spec.map_preimage _
  let : Algebra k R := φ.hom.toAlgebra
  have hφ_alg : φ = CommRingCat.ofHom (algebraMap k R) := by
    apply CommRingCat.hom_ext
    ext r
    rfl
  have hbase : Spec.map (CommRingCat.ofHom (algebraMap k R)) = i ≫ f := by
    rw [← hφ_alg]
    exact hφ
  have : IsOpenImmersion i := hi
  have : LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap k R))) := by
    rw [hbase]
    infer_instance
  let g := Spec.map (CommRingCat.ofHom (algebraMap k K))
  let m : pullback (Spec.map (CommRingCat.ofHom (algebraMap k R))) g ⟶ Y := pullback.map
    (Spec.map (CommRingCat.ofHom (algebraMap k R))) g f g i (𝟙 _)
    (𝟙 _) (by rw [Category.comp_id, hbase]) (by simp)
  have hmrange : Set.range m.base = q.base ⁻¹' Set.range i.base := by
    show Set.range (pullback.map
      (Spec.map (CommRingCat.ofHom (algebraMap k R))) g f g i (𝟙 _) (𝟙 _) _ _).base = _
    rw [Scheme.Pullback.range_map]
    simp [q, g]
  obtain ⟨yR, hyR⟩ : η ∈ Set.range m.base := by
    rw [hmrange]
    exact ⟨y, hy⟩
  obtain ⟨E, hE, hfixR⟩ := exists_finite_field_fixing_point_spec (K := K) yR
  refine ⟨E, hE, fun σ hσ => galoisBaseChangeMap_image_eq_of_genericPoint X f σ Z ?_⟩
  have hcommute := galoisBaseChangeMap_comm_of_comp f
    (Spec.map (CommRingCat.ofHom (algebraMap k R))) i m (pullback.lift_fst _ _ _)
    (by simp only [m, pullback.map, Category.comp_id]; exact pullback.lift_snd _ _ _) σ
  have hpoint : (galoisBaseChangeMap k K X f σ).base (m.base yR) =
      m.base ((galoisBaseChangeMap k K (Spec (.of R))
        (Spec.map (CommRingCat.ofHom (algebraMap k R))) σ).base yR) := by
    simpa [Scheme.Hom.comp_base, TopCat.coe_comp] using
      congrArg (fun h => h.base yR) hcommute
  rw [hfixR σ hσ] at hpoint
  simpa [hyR] using hpoint

/-! ### Descent to a finite subextension -/

/-- The canonical isomorphism from the iterated base change along a tower to the base change
along the composite, oriented so that the composite is given by an equation. -/
private noncomputable def baseChangeTowerIso
    {X S E K : Scheme.{u}} (f : X ⟶ S) (g : E ⟶ S) (h : K ⟶ E)
    (g' : K ⟶ S) (hcomp : g' = h ≫ g) :
    pullback (pullback.snd f g) h ≅ pullback f g' :=
  (pullbackLeftPullbackSndIso f g h).trans (pullback.congrHom rfl hcomp).symm

private lemma baseChangeTowerIso_hom_fst
    {X S E K : Scheme.{u}} (f : X ⟶ S) (g : E ⟶ S) (h : K ⟶ E)
    (g' : K ⟶ S) (hcomp : g' = h ≫ g) :
    (baseChangeTowerIso f g h g' hcomp).hom ≫ pullback.fst f g' =
      pullback.fst (pullback.snd f g) h ≫ pullback.fst f g := by
  dsimp only [baseChangeTowerIso, Iso.trans_hom, Iso.symm_hom]
  rw [Category.assoc, pullback.congrHom_inv, pullback.lift_fst, Category.comp_id,
    pullbackLeftPullbackSndIso_hom_fst]

private lemma baseChangeTowerIso_hom_snd
    {X S E K : Scheme.{u}} (f : X ⟶ S) (g : E ⟶ S) (h : K ⟶ E)
    (g' : K ⟶ S) (hcomp : g' = h ≫ g) :
    (baseChangeTowerIso f g h g' hcomp).hom ≫ pullback.snd f g' =
      pullback.snd (pullback.snd f g) h := by
  dsimp only [baseChangeTowerIso, Iso.trans_hom, Iso.symm_hom]
  rw [Category.assoc, pullback.congrHom_inv, pullback.lift_snd, Category.comp_id,
    pullbackLeftPullbackSndIso_hom_snd]

private lemma baseChangeTowerIso_comp_of_projection
    {X S E K : Scheme.{u}} (f : X ⟶ S) (g : E ⟶ S) (h : K ⟶ E)
    (g' : K ⟶ S) (hcomp : g' = h ≫ g)
    (p : pullback f g' ⟶ pullback f g)
    (hp₁ : p ≫ pullback.fst f g = pullback.fst f g')
    (hp₂ : p ≫ pullback.snd f g = pullback.snd f g' ≫ h) :
    (baseChangeTowerIso f g h g' hcomp).hom ≫ p =
      pullback.fst (pullback.snd f g) h := by
  refine pullback.hom_ext ?_ ?_
  · rw [Category.assoc, hp₁, baseChangeTowerIso_hom_fst]
  · rw [Category.assoc, hp₂, ← Category.assoc, baseChangeTowerIso_hom_snd,
      pullback.condition]

/-- For a tower `k → E → K`, the structure morphism `Spec K → Spec k` factors through
`Spec E`. -/
private theorem spec_map_algebraMap_eq_comp {k E K : Type u} [CommRing k] [CommRing E]
    [CommRing K] [Algebra k E] [Algebra E K] [Algebra k K] [IsScalarTower k E K] :
    Spec.map (CommRingCat.ofHom (algebraMap k K)) =
      Spec.map (CommRingCat.ofHom (algebraMap E K)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap k E)) := by
  rw [← Spec.map_comp]
  refine congrArg Spec.map (CommRingCat.hom_ext ?_)
  ext x
  exact IsScalarTower.algebraMap_apply k E K x

/-- A morphism from a base change over `E` to a base change over `k`, both to `K`, lying over a
morphism of schemes and over `Spec K`, intertwines the Galois self-maps of an `E`-automorphism
of `K` and of its restriction to `k`. -/
private theorem galoisBaseChangeMap_restrictScalars_comm_of_comp
    {k E K : Type u} [Field k] [Field E] [Field K] [Algebra k E] [Algebra E K] [Algebra k K]
    [IsScalarTower k E K] {X Y : Scheme.{u}} (f : X ⟶ Spec (.of k)) (fE : Y ⟶ Spec (.of E))
    (h : Y ⟶ X)
    (m : pullback fE (Spec.map (CommRingCat.ofHom (algebraMap E K))) ⟶
      pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))))
    (hfst : m ≫ pullback.fst _ _ = pullback.fst _ _ ≫ h)
    (hsnd : m ≫ pullback.snd _ _ = pullback.snd _ _) (σ : K ≃ₐ[E] K) :
    m ≫ galoisBaseChangeMap k K X f (σ.restrictScalars k) =
      galoisBaseChangeMap E K Y fE σ ≫ m := by
  refine pullback.hom_ext ?_ ?_
  · rw [Category.assoc, galoisBaseChangeMap_fst, hfst, Category.assoc, hfst, ← Category.assoc,
      galoisBaseChangeMap_fst]
  · rw [Category.assoc, galoisBaseChangeMap_snd, ← Category.assoc, hsnd, Category.assoc, hsnd,
      galoisBaseChangeMap_snd]
    rfl

/-- The inverse image of an irreducible component under an isomorphism of schemes is an
irreducible component. -/
private theorem preimage_mem_irreducibleComponents_of_iso {A B : Scheme.{u}} (e : A ≅ B)
    {Z : Set B} (hZ : Z ∈ irreducibleComponents B) :
    e.hom.base ⁻¹' Z ∈ irreducibleComponents A := by
  let h := e.schemeIsoToHomeo
  have key := image_mem_irreducibleComponents_of_isPreirreducible_fiber h.symm
    h.symm.continuous h.symm.isOpenMap
    (fun _ => (Set.subsingleton_singleton.preimage h.symm.injective).isPreirreducible)
    h.symm.surjective hZ
  rw [h.image_symm] at key
  exact key

/-- If a set in the base change over `k` is stable under the Galois self-map of the restriction
to `k` of an `E`-automorphism of `K`, then its transport along a compatible isomorphism with a
base change over `E` is stable under the Galois self-map of that automorphism. -/
private theorem galoisBaseChangeMap_image_preimage_of_iso
    {k E K : Type u} [Field k] [Field E] [Field K] [Algebra k E] [Algebra E K] [Algebra k K]
    [IsScalarTower k E K] {X Y : Scheme.{u}} (f : X ⟶ Spec (.of k)) (fE : Y ⟶ Spec (.of E))
    (h : Y ⟶ X)
    (e : pullback fE (Spec.map (CommRingCat.ofHom (algebraMap E K))) ≅
      pullback f (Spec.map (CommRingCat.ofHom (algebraMap k K))))
    (hfst : e.hom ≫ pullback.fst _ _ = pullback.fst _ _ ≫ h)
    (hsnd : e.hom ≫ pullback.snd _ _ = pullback.snd _ _) (σ : K ≃ₐ[E] K)
    {Z : Set (pullback (C := Scheme.{u}) f (Spec.map (CommRingCat.ofHom (algebraMap k K))))}
    (hZ : (galoisBaseChangeMap k K X f (σ.restrictScalars k)).base '' Z = Z) :
    (galoisBaseChangeMap E K Y fE σ).base '' (e.hom.base ⁻¹' Z) = e.hom.base ⁻¹' Z := by
  have hc := galoisBaseChangeMap_restrictScalars_comm_of_comp f fE h e.hom hfst hsnd σ
  have hsurj : Function.Surjective e.hom.base := e.schemeIsoToHomeo.surjective
  have hpt (x) : (galoisBaseChangeMap k K X f (σ.restrictScalars k)).base (e.hom.base x) =
      e.hom.base ((galoisBaseChangeMap E K Y fE σ).base x) := by
    simpa [Scheme.Hom.comp_base, TopCat.coe_comp] using congrArg (fun r => r.base x) hc
  apply e.schemeIsoToHomeo.injective.image_injective
  show e.hom.base '' _ = e.hom.base '' _
  rw [Set.image_preimage_eq Z hsurj]
  calc e.hom.base '' ((galoisBaseChangeMap E K Y fE σ).base '' (e.hom.base ⁻¹' Z))
      = (galoisBaseChangeMap k K X f (σ.restrictScalars k)).base ''
          (e.hom.base '' (e.hom.base ⁻¹' Z)) := by
        rw [Set.image_image, Set.image_image]
        exact Set.image_congr' fun x => (hpt x).symm
    _ = Z := by rw [Set.image_preimage_eq Z hsurj, hZ]

/-- **Stacks Project, Tag 04KZ.** Every irreducible component after extension to a separable
closure is defined over a finite intermediate extension. -/
@[stacks 04KZ "component_defined_over_finite_extension"]
public theorem exists_finite_subextension_defining_component
    {k K : Type u} [Field k] [Field K] [Algebra k K] [IsSepClosure k K]
    (X : Scheme.{u}) (f : X ⟶ Spec (.of k)) [LocallyOfFiniteType f]
    (Z : irreducibleComponents
      (pullback (C := Scheme.{u}) f (Spec.map (CommRingCat.ofHom (algebraMap k K))))) :
    ∃ (E : IntermediateField k K) (_ : FiniteDimensional k E)
      (T : irreducibleComponents
        (pullback (C := Scheme.{u}) f (Spec.map (CommRingCat.ofHom (algebraMap k E)))))
      (p : pullback (C := Scheme.{u}) f (Spec.map (CommRingCat.ofHom (algebraMap k K))) ⟶
        pullback (C := Scheme.{u}) f (Spec.map (CommRingCat.ofHom (algebraMap k E)))),
      p ≫ pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k E))) =
          pullback.fst f (Spec.map (CommRingCat.ofHom (algebraMap k K))) ∧
        p ≫ pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k E))) =
          pullback.snd f (Spec.map (CommRingCat.ofHom (algebraMap k K))) ≫
            Spec.map (CommRingCat.ofHom E.val) ∧
        p.base ⁻¹' (T : Set _) = (Z : Set _) := by
  classical
  obtain ⟨E, hE, hfix⟩ := exists_finite_field_stabilizing_component X f Z
  let : Algebra E K := E.val.toAlgebra
  have : IsScalarTower k E K := inferInstance
  have : IsSepClosure E K := isSepClosure_of_intermediateField E
  let gE := Spec.map (CommRingCat.ofHom (algebraMap k E))
  let gK := Spec.map (CommRingCat.ofHom (algebraMap k K))
  let gEK := Spec.map (CommRingCat.ofHom (algebraMap E K))
  have hcomp : gK = gEK ≫ gE := spec_map_algebraMap_eq_comp (k := k) (E := E) (K := K)
  let YE := pullback f gE
  let Y := pullback f gK
  let fE := pullback.snd f gE
  let YEK := pullback fE gEK
  let qE := pullback.fst f gE
  let qT := pullback.fst fE gEK
  let e := baseChangeTowerIso f gE gEK gK hcomp
  let Tbar : (galoisActionOnGeometricIrreducibleComponents E K (Over.mk fE)).V :=
    ⟨e.hom.base ⁻¹' (Z : Set Y), preimage_mem_irreducibleComponents_of_iso e Z.2⟩
  have hfixedE : ∀ σop : MulOpposite (K ≃ₐ[E] K),
      ConcreteCategory.hom
        ((galoisActionOnGeometricIrreducibleComponents E K (Over.mk fE)).ρ σop).asHom Tbar =
        Tbar := by
    intro σop
    apply Subtype.ext
    rw [galoisActionOnGeometricIrreducibleComponents_ρ_apply_coe]
    exact galoisBaseChangeMap_image_preimage_of_iso f fE qE e
      (baseChangeTowerIso_hom_fst f gE gEK gK hcomp) (baseChangeTowerIso_hom_snd f gE gEK gK hcomp)
      σop.unop (hfix (σop.unop.restrictScalars k) fun x => σop.unop.commutes x)
  obtain ⟨T, -, hTpre⟩ :=
    (fixed_geometricComponent_iff_exists_geometricallyIrreducible_component
      E K YE fE Tbar).mp hfixedE
  let p := baseChangeComparison k E K X f
  have hp₁ : p ≫ qE = pullback.fst f gK := pullback.lift_fst _ _ _
  have hp₂ : p ≫ pullback.snd f gE = pullback.snd f gK ≫ gEK := pullback.lift_snd _ _ _
  have hmapE : gEK = Spec.map (CommRingCat.ofHom E.val) := by
    refine congrArg Spec.map ?_
    apply CommRingCat.hom_ext
    ext x
    rfl
  have hecomp : e.hom ≫ p = qT :=
    baseChangeTowerIso_comp_of_projection f gE gEK gK hcomp p hp₁ hp₂
  have hpre : e.hom.base ⁻¹' (p.base ⁻¹' (T : Set YE)) = e.hom.base ⁻¹' (Z : Set Y) := by
    ext x
    show p.base (e.hom.base x) ∈ (T : Set YE) ↔ e.hom.base x ∈ (Z : Set Y)
    have hx : p.base (e.hom.base x) = qT.base x := by
      simpa [Scheme.Hom.comp_base, TopCat.coe_comp] using
        congrArg (fun r : Scheme.Hom YEK YE => r.base x) hecomp
    rw [hx]
    exact Set.ext_iff.mp hTpre x
  exact ⟨E, hE, T, p, hp₁, by rw [hp₂, hmapE],
    Set.preimage_injective.mpr e.schemeIsoToHomeo.surjective hpre⟩

/-- A morphism from the base change to `K` into the base change to an intermediate field `E`,
over `X` and over `Spec E`, is invariant under the Galois action of automorphisms fixing `E`. -/
private theorem galoisActionOnBaseChange_ρ_comp_eq_of_fixed
    {k K : Type u} [Field k] [Field K] [Algebra k K]
    (X : Over (Spec (.of k))) (E : IntermediateField k K)
    (p : pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap k K))) ⟶
      pullback X.hom (Spec.map (CommRingCat.ofHom (algebraMap k E))))
    (hp1 : p ≫ pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap k E))) =
      pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap k K))))
    (hp2 : p ≫ pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap k E))) =
      pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap k K))) ≫
        Spec.map (CommRingCat.ofHom E.val))
    (σ : K ≃ₐ[k] K) (hσ : ∀ x : E, σ x = x) :
    ((galoisActionOnBaseChange k K X).ρ (MulOpposite.op σ)).asHom ≫ p = p := by
  let q := ((galoisActionOnBaseChange k K X).ρ (MulOpposite.op σ)).asHom
  have hqfst : q ≫ pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap k K))) =
      pullback.fst X.hom (Spec.map (CommRingCat.ofHom (algebraMap k K))) := by
    simp [q, galoisActionOnBaseChange, CategoryTheory.Limits.pullback.map,
      CategoryTheory.Limits.pullback.lift_fst]
  have hqsnd : q ≫ pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap k K))) =
      pullback.snd X.hom (Spec.map (CommRingCat.ofHom (algebraMap k K))) ≫
        specMapAlgAut k K σ := by
    simp [q, galoisActionOnBaseChange, CategoryTheory.Limits.pullback.map,
      CategoryTheory.Limits.pullback.lift_snd]
  show q ≫ p = p
  refine pullback.hom_ext ?_ ?_
  · rw [Category.assoc, hp1, hqfst]
  · rw [Category.assoc, hp2, ← Category.assoc, hqsnd, Category.assoc]
    congr 1
    unfold specMapAlgAut
    rw [← Spec.map_comp]
    congr 1
    ext x
    exact hσ x

/-- A geometric irreducible component of a scheme locally of finite type over a field is
stabilized by the Galois group over some finite intermediate extension. -/
public theorem exists_finite_subextension_stabilizing_irreducible_component
    {k K : Type u} [Field k] [Field K] [Algebra k K] [IsSepClosure k K]
    (X : Over (Spec (.of k))) [LocallyOfFiniteType X.hom]
    (T : (galoisActionOnGeometricIrreducibleComponents k K X).V) :
    ∃ (E : IntermediateField k K) (_ : FiniteDimensional k E),
      ∀ σ : K ≃ₐ[k] K, (∀ x : E, σ x = x) →
        ConcreteCategory.hom
          ((galoisActionOnGeometricIrreducibleComponents k K X).ρ
            (MulOpposite.op σ)).asHom T = T := by
  classical
  obtain ⟨E, hE, T', p, hp1, hp2, hpT⟩ :=
    exists_finite_subextension_defining_component X.left X.hom T
  refine ⟨E, hE, fun σ hσ => Subtype.ext ?_⟩
  let q := ((galoisActionOnBaseChange k K X).ρ (MulOpposite.op σ)).asHom
  have hqp : q ≫ p = p := galoisActionOnBaseChange_ρ_comp_eq_of_fixed X E p hp1 hp2 σ hσ
  have hsurj : Function.Surjective q.base :=
    (Scheme.homeoOfIso ((galoisActionOnBaseChange k K X).ρAut (MulOpposite.op σ)).asIso).surjective
  rw [galoisActionOnGeometricIrreducibleComponents_ρ_apply_coe, ← hpT]
  have hpre : q.base ⁻¹' (p.base ⁻¹' (T' : Set _)) = p.base ⁻¹' (T' : Set _) := by
    rw [← Set.preimage_comp, ← TopCat.coe_comp, ← Scheme.Hom.comp_base, hqp]
  exact (congrArg (q.base '' ·) hpre).symm.trans (Set.image_preimage_eq _ hsurj)


end AlgebraicGeometry
