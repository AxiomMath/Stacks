/-!
# Complete local rings of schemes over fields

Let `X` be a locally Noetherian scheme over a field and let `x` be a point of `X`.
The completion of the local ring at `x` is a quotient of a formal power series ring over
the residue field at `x`.  The presentation can be chosen compatibly with the ground field
when the residue-field extension is separable.

## Main results

* `AlgebraicGeometry.exists_surjective_eval₂Hom` presents a complete ring as a quotient of a
  formal power series ring, given a finite generating family of the ideal of completion.
* `AlgebraicGeometry.exists_powerSeries_quotient_ringEquiv_adicCompletion` gives the
  power-series presentation and records its action on residue fields.
* `AlgebraicGeometry.exists_powerSeries_quotient_ringEquiv_adicCompletion_of_isSeparable`
  gives a presentation compatible with the ground-field maps when the residue extension is
  separable.

## Implementation notes

The completed local ring is represented by Mathlib's `AdicCompletion` at the maximal ideal.
Saying that the first presentation induces the identity on residue fields means that a constant
`a` is sent, modulo the maximal ideal of the completion, to the image of `a` under the canonical
residue-field isomorphism induced by the completion map.  In the separable case, compatibility
with the `k`-algebra structures is written as equality on elements of `k`; this avoids choosing
additional, propositionally equal `Algebra` instances.

## References

* [Stacks Project, Tag 0C53](https://stacks.math.columbia.edu/tag/0C53)
* [Stacks Project, Tag 0C52](https://stacks.math.columbia.edu/tag/0C52)
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry IsLocalRing

universe u

namespace AlgebraicGeometry

/-- A complete local ring that is an algebra over a field admits a ring-homomorphism section
of its residue map. -/
private theorem exists_residueField_section (R : Type u) [CommRing R] [IsLocalRing R]
    [IsAdicComplete (maximalIdeal R) R] (F : Type u) [Field F] [Algebra F R] :
    ∃ s : ResidueField R →+* R, (residue R).comp s = RingHom.id _ := by
  obtain ⟨Λ, hΛ⟩ :=
    (IsLocalRing.exists_isCoefficientRing_and_exists_surjective_mvPowerSeries R).1
  have := hΛ.isLocalHom
  let _ : Algebra F (ResidueField R) := ((residue R).comp (algebraMap F R)).toAlgebra
  have : CharP (ResidueField R) (ringChar F) :=
    charP_of_injective_algebraMap
      (RingHom.injective (algebraMap F (ResidueField R))) (ringChar F)
  have hchar : (ringChar (ResidueField R) : R) = 0 := by
    rw [CharP.eq (ResidueField R) (ringChar.charP (ResidueField R)) ‹_›,
      ← map_natCast (algebraMap F R) (ringChar F), ringChar.Nat.cast_ringChar, map_zero]
  have hbot : maximalIdeal Λ.toSubring = ⊥ := by
    rw [← IsLocalRing.maximalIdeal_comap Λ.toSubring.subtype,
      hΛ.comap_maximalIdeal_eq_span_ringChar, Ideal.span_singleton_eq_bot]
    exact Subtype.ext (by push_cast; exact hchar)
  let _ : Field Λ.toSubring := (isField_iff_maximalIdeal_eq.2 hbot).toField
  have hbij : Function.Bijective ((residue R).comp Λ.toSubring.subtype) := by
    refine ⟨RingHom.injective _, fun y => ?_⟩
    obtain ⟨x, hx⟩ := hΛ.residueField_map_surjective y
    obtain ⟨z, hz⟩ : ∃ z, residue Λ.toSubring z = x := Ideal.Quotient.mk_surjective x
    exact ⟨z, by
      rw [RingHom.comp_apply, ← ResidueField.map_residue Λ.toSubring.subtype z, hz, hx]⟩
  exact ⟨Λ.toSubring.subtype.comp (RingEquiv.ofBijective _ hbij).symm.toRingHom,
    RingHom.ext fun x => (RingEquiv.ofBijective _ hbij).apply_symm_apply x⟩

/-- Evaluating the variables of a power series ring at a finite generating family of an ideal
of a complete ring gives a surjection onto that ring, sending the variables to the chosen
generators, the constants along the given map, and the ideal generated by the variables onto
the given ideal. -/
public theorem exists_surjective_eval₂Hom {K R : Type*} [CommRing K] [CommRing R]
    (I : Ideal R) [IsAdicComplete I R] {n : ℕ} (y : Fin n → R)
    (hy : Ideal.span (Set.range y) = I) (f : K →+* R)
    (hf : Function.Surjective ((Ideal.Quotient.mk I).comp f)) :
    ∃ F : MvPowerSeries (Fin n) K →+* R, Function.Surjective F ∧
      (∀ i, F (MvPowerSeries.X i) = y i) ∧
      (∀ c : K, F (MvPowerSeries.C c) = f c) ∧
      Ideal.map F (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin n) (R := K)))) = I := by
  let _ : WithIdeal K := ⟨⊥⟩
  have : DiscreteTopology K := is_bot_adic_iff.1 rfl
  let _ : WithIdeal R := ⟨I⟩
  obtain ⟨hcs, ht2⟩ := (IsAdic.isAdicComplete_iff (I := I) rfl).1 ‹IsAdicComplete I R›
  have := hcs
  have := ht2
  have ha : MvPowerSeries.HasEval y :=
    { hpow := fun i => WithIdeal.isTopologicallyNilpotent_of_mem
        (show y i ∈ I from hy ▸ Ideal.subset_span ⟨i, rfl⟩)
      tendsto_zero := by simp [Filter.cofinite_eq_bot] }
  set F : MvPowerSeries (Fin n) K →+* R :=
    MvPowerSeries.eval₂Hom (φ := f) continuous_of_discreteTopology ha
  have hFX : ∀ i, F (MvPowerSeries.X i) = y i := fun i => by
    rw [MvPowerSeries.coe_eval₂Hom]; exact MvPowerSeries.eval₂_X f y i
  have hFC : ∀ c : K, F (MvPowerSeries.C c) = f c := fun c => by
    rw [MvPowerSeries.coe_eval₂Hom]; exact MvPowerSeries.eval₂_C f y c
  have hmapF : Ideal.map F
      (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin n) (R := K)))) = I := by
    rw [Ideal.map_span, ← hy, ← Set.range_comp]
    exact congrArg _ (congrArg Set.range (funext hFX))
  have hhaus : IsHausdorff (Ideal.map F
      (Ideal.span (Set.range (MvPowerSeries.X (σ := Fin n) (R := K))))) R := by
    rw [hmapF]; infer_instance
  refine ⟨F, ?_, hFX, hFC, hmapF⟩
  refine surjective_of_mk_map_comp_surjective (I := Ideal.span (Set.range
    (MvPowerSeries.X (σ := Fin n) (R := K)))) F fun b => ?_
  obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective b
  obtain ⟨c, hc⟩ := hf (Ideal.Quotient.mk I r)
  refine ⟨MvPowerSeries.C c, ?_⟩
  rw [RingHom.comp_apply, hFC c, ← hr]
  exact Ideal.Quotient.eq.2 (by rw [hmapF]; exact Ideal.Quotient.eq.1 hc)

/-- A complete Noetherian local ring with a section of its residue map is a quotient of a
formal power series ring over its residue field. -/
private theorem exists_powerSeries_presentation {K R : Type*} [Field K] [CommRing R]
    [IsLocalRing R] [IsNoetherianRing R] [IsAdicComplete (maximalIdeal R) R]
    (s : K →+* R)
    (hs : Function.Surjective ((residue R).comp s)) :
    ∃ (n : ℕ) (I : Ideal (MvPowerSeries (Fin n) K))
      (e : (MvPowerSeries (Fin n) K ⧸ I) ≃+* R),
      ∀ a : K, e (Ideal.Quotient.mk I (MvPowerSeries.C a)) = s a := by
  obtain ⟨n, y, hy⟩ :=
    Submodule.fg_iff_exists_fin_generating_family.1
      ((maximalIdeal R).fg_of_isNoetherianRing)
  obtain ⟨F, hF, -, hFC, -⟩ := exists_surjective_eval₂Hom (maximalIdeal R) y hy s hs
  exact ⟨n, RingHom.ker F, F.quotientKerEquivOfSurjective hF,
    fun a => by rw [RingHom.quotientKerEquivOfSurjective_apply_mk, hFC]⟩

/-- The completed local ring at a point of a locally Noetherian scheme is a quotient of a
formal power series ring over its residue field, with the presentation inducing the canonical
identification on residue fields. -/
@[stacks 0C53 "power-series presentation"]
theorem exists_powerSeries_quotient_ringEquiv_adicCompletion
    (k : Type u) [Field k] (X : Scheme.{u}) (f : X ⟶ Spec (.of k))
    [IsLocallyNoetherian X] (x : X) :
    ∃ (n : ℕ) (I : Ideal (MvPowerSeries (Fin n) (X.residueField x)))
      (e : (MvPowerSeries (Fin n) (X.residueField x) ⧸ I) ≃+*
        AdicCompletion (maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x)),
      ∀ a : X.residueField x,
        residue (AdicCompletion (maximalIdeal (X.presheaf.stalk x))
            (X.presheaf.stalk x))
            (e (Ideal.Quotient.mk I (MvPowerSeries.C a))) =
          IsLocalRing.ResidueField.map
            (algebraMap (X.presheaf.stalk x)
              (AdicCompletion (maximalIdeal (X.presheaf.stalk x))
                (X.presheaf.stalk x))) a := by
  let R := X.presheaf.stalk x
  let A := AdicCompletion (maximalIdeal R) R
  let kToStalk : k →+* R :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.presheaf.germ ⊤ x trivial).hom
  let _ : Algebra k R := kToStalk.toAlgebra
  let _ : Algebra k A := ((algebraMap R A).comp kToStalk).toAlgebra
  obtain ⟨s, hs⟩ := exists_residueField_section A k
  let ρ : ResidueField R →+* ResidueField A :=
    ResidueField.map (algebraMap R A)
  let ρe : ResidueField R ≃+* ResidueField A :=
    RingEquiv.ofBijective ρ (AdicCompletion.residueField_map_bijective R)
  let t : ResidueField R →+* A := s.comp ρe.toRingHom
  have ht : Function.Surjective ((residue A).comp t) := by
    intro b
    obtain ⟨a, rfl⟩ := ρe.surjective b
    refine ⟨a, ?_⟩
    simpa [t, ρe] using
      congrArg (fun g : ResidueField A →+* ResidueField A => g (ρ a)) hs
  obtain ⟨n, I, e, he⟩ := exists_powerSeries_presentation t ht
  refine ⟨n, I, e, ?_⟩
  intro a
  show residue A (e (Ideal.Quotient.mk I (MvPowerSeries.C a))) = ρ a
  refine (congrArg (residue A) (he a)).trans ?_
  show residue A (s (ρ a)) = ρ a
  simpa only [RingHom.comp_apply, RingHom.id_apply] using
    congrArg (fun g => g (ρ a)) hs

/-- If the residue field at the point is separable over the ground field, the power-series
presentation of the completed local ring can be chosen to respect the ground-field maps. -/
@[stacks 0C53 "separable ground-field compatibility"]
theorem exists_powerSeries_quotient_ringEquiv_adicCompletion_of_isSeparable
    (k : Type u) [Field k] (X : Scheme.{u}) (f : X ⟶ Spec (.of k))
    [IsLocallyNoetherian X] (x : X)
    (hsep :
      let kToStalk : k →+* X.presheaf.stalk x :=
        ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.presheaf.germ ⊤ x trivial).hom
      letI : Algebra k (X.residueField x) :=
        ((X.residue x).hom.comp kToStalk).toAlgebra
      Algebra.IsSeparable k (X.residueField x)) :
    let kToStalk : k →+* X.presheaf.stalk x :=
      ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.presheaf.germ ⊤ x trivial).hom
    let kToResidue : k →+* X.residueField x := (X.residue x).hom.comp kToStalk
    ∃ (n : ℕ) (I : Ideal (MvPowerSeries (Fin n) (X.residueField x)))
      (e : (MvPowerSeries (Fin n) (X.residueField x) ⧸ I) ≃+*
        AdicCompletion (maximalIdeal (X.presheaf.stalk x)) (X.presheaf.stalk x)),
      (∀ a : X.residueField x,
        residue (AdicCompletion (maximalIdeal (X.presheaf.stalk x))
            (X.presheaf.stalk x))
            (e (Ideal.Quotient.mk I (MvPowerSeries.C a))) =
          IsLocalRing.ResidueField.map
            (algebraMap (X.presheaf.stalk x)
              (AdicCompletion (maximalIdeal (X.presheaf.stalk x))
                (X.presheaf.stalk x))) a) ∧
      (∀ a : k,
        e (Ideal.Quotient.mk I (MvPowerSeries.C (kToResidue a))) =
          algebraMap (X.presheaf.stalk x)
            (AdicCompletion (maximalIdeal (X.presheaf.stalk x))
              (X.presheaf.stalk x)) (kToStalk a)) := by
  let R := X.presheaf.stalk x
  let A := AdicCompletion (maximalIdeal R) R
  let kToStalk : k →+* R :=
    ((Scheme.ΓSpecIso (.of k)).inv ≫ f.appTop ≫ X.presheaf.germ ⊤ x trivial).hom
  let kToResidue : k →+* ResidueField R := (residue R).comp kToStalk
  let _ : Algebra k R := kToStalk.toAlgebra
  let _ : Algebra k A := ((algebraMap R A).comp kToStalk).toAlgebra
  let _ : Algebra k (ResidueField R) := kToResidue.toAlgebra
  let _ : Algebra k (ResidueField A) :=
    ((residue A).comp ((algebraMap R A).comp kToStalk)).toAlgebra
  have : Algebra.IsSeparable k (ResidueField R) := hsep
  let ρ : ResidueField R →+* ResidueField A :=
    ResidueField.map (algebraMap R A)
  let ρe : ResidueField R ≃+* ResidueField A :=
    RingEquiv.ofBijective ρ (AdicCompletion.residueField_map_bijective R)
  let ρa : ResidueField R ≃ₐ[k] ResidueField A :=
    { ρe with
      commutes' := by
        intro a
        show ρ (residue R (kToStalk a)) =
          residue A (algebraMap R A (kToStalk a))
        exact ResidueField.map_residue (algebraMap R A) (kToStalk a) }
  have : Algebra.IsSeparable k (ResidueField A) := AlgEquiv.Algebra.isSeparable ρa
  have hsepExt : Algebra.IsSeparableExtension k (ResidueField A) := by
    constructor
    intro K' _
    have : Algebra.IsSeparable k K' := Algebra.IsSeparable.of_algHom k _ K'.val
    obtain ⟨s, hs⟩ := exists_isTranscendenceBasis k K'
    exact ⟨s, hs, Algebra.isSeparable_tower_top_of_isSeparable k _ _⟩
  obtain ⟨s, hs⟩ := exists_residueField_algHom_section (k := k) (A := A) hsepExt
  let t : ResidueField R →+* A := s.toRingHom.comp ρe.toRingHom
  have ht : Function.Surjective ((residue A).comp t) := by
    intro b
    obtain ⟨a, rfl⟩ := ρe.surjective b
    refine ⟨a, ?_⟩
    show residue A (s (ρ a)) = ρ a
    exact congrArg (fun g : ResidueField A →ₐ[k] ResidueField A => g (ρ a)) hs
  obtain ⟨n, I, e, he⟩ := exists_powerSeries_presentation t ht
  refine ⟨n, I, e, ?_, ?_⟩
  · intro a
    show residue A (e (Ideal.Quotient.mk I (MvPowerSeries.C a))) = ρ a
    refine (congrArg (residue A) (he a)).trans ?_
    show residue A (s (ρ a)) = ρ a
    exact congrArg (fun g : ResidueField A →ₐ[k] ResidueField A => g (ρ a)) hs
  · intro a
    show e (Ideal.Quotient.mk I (MvPowerSeries.C (kToResidue a))) =
      algebraMap R A (kToStalk a)
    rw [he]
    show s (ρe (kToResidue a)) = algebraMap R A (kToStalk a)
    rw [show ρe (kToResidue a) = algebraMap k (ResidueField A) a from ρa.commutes a]
    exact s.commutes a

end AlgebraicGeometry

add_to_stacks 0C52 "completed_local_ring_presentation"
  AlgebraicGeometry.exists_powerSeries_quotient_ringEquiv_adicCompletion
