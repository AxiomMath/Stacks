open CategoryTheory Limits

namespace AlgebraicGeometry

universe u

/-! ### The twists on `ℙ⁰` are trivial -/

section TwistsOnProjectiveZero

attribute [local instance] MvPolynomial.gradedAlgebra

/-- **A global section vanishing nowhere trivialises an invertible module.** If the nonvanishing
locus of a global section `s` of an invertible module `L` on a ringed space with local stalks is
the whole space, then multiplication by `s` is an isomorphism `𝒪_X ⟶ L`.

This is the trivialization clause of [Stacks, Tag 01CY],
`Stacks.SheafOfModules.isIso_over_nonvanishingOpen`, read at a nonvanishing locus equal to `⊤`:
every open is then contained in it, so every component of the morphism is bijective by
`Stacks.SheafOfModules.bijective_smul_eval_of_le_nonvanishingOpen`, and a morphism of sheaves of
modules with all components isomorphisms is an isomorphism. The point of the restriction to `⊤`
is that the conclusion is about `L` itself rather than about its restriction to the localized
site over the locus. -/
@[ega "0 5.5.2" "special case"]
public theorem isIso_unitHomEquiv_symm_of_nonvanishingOpen_eq_top
    {X : RingedSpace.{u, u}}
    [∀ x : X.carrier,
      IsLocalRing (Stacks.SheafOfModules.TensorStalkRingedSpace.ringStalk X x)]
    (L : SheafOfModules.{u}
      (structureSheafRing X))
    [Stacks.SheafOfModules.IsInvertible X.presheaf
      (structureSheafRing X).property L]
    (s : L.sections) (h : Stacks.SheafOfModules.nonvanishingOpen L s = ⊤) :
    IsIso (L.unitHomEquiv.symm s) := by
  refine Stacks.SheafOfModules.isIso_of_isIso_val_app _ fun A => ?_
  rw [ConcreteCategory.isIso_iff_bijective]
  exact Stacks.SheafOfModules.bijective_smul_eval_of_le_nonvanishingOpen L s A.unop (h ▸ le_top)

/-- **`𝒪 ≅ 𝒪(1)` on `Proj A[T₀]`.** A polynomial ring in a single variable has its irrelevant
ideal generated by that variable, so the standard open `D₊(T₀)` is the whole of `Proj A[T₀]`
(`AlgebraicGeometry.ProjectiveSpace.oneVariable_basicOpen_X_zero_eq_top`). The section `T₀/1` of
`𝒪(1)` does not vanish on `D₊(T₀)`
(`Stacks.ProjTwistSection.basicOpen_le_nonvanishingOpen_homogeneousSection`), hence vanishes
nowhere, and `isIso_unitHomEquiv_symm_of_nonvanishingOpen_eq_top` turns multiplication by it into
an isomorphism.

Invertibility of `𝒪(1)` is [Stacks, Tag 01MW] for a ring generated in degree one over its
degree-zero part, which a polynomial ring is. -/
public def unitModuleIsoTwistingSheafOneOneVariable (A : Type u) [CommRing A] :
    Stacks.Ample.unitModule
        (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin 1) A)) ≅
      ProjectiveSpectrum.Proj.twistingSheaf
        (MvPolynomial.homogeneousSubmodule (Fin 1) A) 1 := by
  have hf : (MvPolynomial.X 0 : MvPolynomial (Fin 1) A) ∈
      MvPolynomial.homogeneousSubmodule (Fin 1) A 1 := MvPolynomial.isHomogeneous_X A 0
  haveI : Stacks.SheafOfModules.IsInvertible
      (AlgebraicGeometry.Proj
        (MvPolynomial.homogeneousSubmodule (Fin 1) A)).toRingedSpace.presheaf
      (structureSheafRing (AlgebraicGeometry.Proj
        (MvPolynomial.homogeneousSubmodule (Fin 1) A)).toRingedSpace).property
      (Stacks.ProjTwistSection.twistingModule
        (MvPolynomial.homogeneousSubmodule (Fin 1) A) 1) :=
    Stacks.AlgebraicGeometry.ProjDegreeOne.isInvertible_twistingSheaf
      (MvPolynomial.homogeneousSubmodule (Fin 1) A)
      (MvPolynomial.adjoin_homogeneousSubmodule_one_eq_top (Fin 1) A) 1
  have htop : Stacks.SheafOfModules.nonvanishingOpen
      (X := (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin 1) A)).toRingedSpace)
      (Stacks.ProjTwistSection.twistingModule (MvPolynomial.homogeneousSubmodule (Fin 1) A) 1)
      (Stacks.ProjTwistSection.homogeneousSection
        (MvPolynomial.homogeneousSubmodule (Fin 1) A) (MvPolynomial.X 0) hf) = ⊤ := by
    refine top_le_iff.mp (le_trans (le_of_eq ?_)
      (Stacks.ProjTwistSection.basicOpen_le_nonvanishingOpen_homogeneousSection
        (MvPolynomial.homogeneousSubmodule (Fin 1) A) (MvPolynomial.X 0) hf))
    exact (AlgebraicGeometry.ProjectiveSpace.oneVariable_basicOpen_X_zero_eq_top A).symm
  exact @asIso _ _ _ _ _ (isIso_unitHomEquiv_symm_of_nonvanishingOpen_eq_top _ _ htop)

/-- **`𝒪(d) ≅ 𝒪` on `Proj A[T₀]` in every integer degree.** The degree-one case is
`unitModuleIsoTwistingSheafOneOneVariable`; the passage to an arbitrary degree is the
identification `𝒪(1)^{⊗ d} ≅ 𝒪(d)` of [Stacks, Tag 01CU] for a ring generated in degree one
(`Stacks.AlgebraicGeometry.ProjTwistPowers.tensorPowModuleIsoTwistingSheaf`) together with the
fact that every integer tensor power of a module isomorphic to the structure sheaf is isomorphic
to the structure sheaf (`Stacks.RelativeAmple.tensorPowModuleIsoUnitModule`). -/
public def twistingSheafIsoUnitModuleOneVariable (A : Type u) [CommRing A] (d : ℤ) :
    ProjectiveSpectrum.Proj.twistingSheaf (MvPolynomial.homogeneousSubmodule (Fin 1) A) d ≅
      Stacks.Ample.unitModule
        (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin 1) A)) :=
  (Stacks.AlgebraicGeometry.ProjTwistPowers.tensorPowModuleIsoTwistingSheaf
      (MvPolynomial.homogeneousSubmodule (Fin 1) A)
      (MvPolynomial.adjoin_homogeneousSubmodule_one_eq_top (Fin 1) A) d).symm ≪≫
    Stacks.RelativeAmple.tensorPowModuleIsoUnitModule
      (AlgebraicGeometry.Proj (MvPolynomial.homogeneousSubmodule (Fin 1) A))
      (ProjectiveSpectrum.Proj.twistingSheaf
        (MvPolynomial.homogeneousSubmodule (Fin 1) A) 1)
      (unitModuleIsoTwistingSheafOneOneVariable A).symm d

/-- **`𝒪(d) ≅ 𝒪` on `ℙ⁰_S` in every integer degree, over an arbitrary base scheme.** The twisting
sheaf of `ℙ⁰_S` is the inverse image along `ℙ⁰_S ⟶ ℙ⁰_ℤ` of the twisting sheaf of the integral
model, which is `Proj ℤ[T₀]`; that one is trivial by `twistingSheafIsoUnitModuleOneVariable`, and
the inverse image of the structure sheaf is the structure sheaf
(`Stacks.RelativeAmple.pullbackUnitModuleIso`). -/
public def projectiveTwistingSheafZeroIsoUnit (S : Scheme.{u}) (d : ℤ) :
    (Scheme.Modules.pullback (projectiveSpaceOver.toIntegralAtUniverse 0 S)).obj
        (ProjectiveSpectrum.Proj.twistingSheaf
          (MvPolynomial.homogeneousSubmodule (Fin (0 + 1)) (ULift.{u} ℤ)) d) ≅
      Stacks.Ample.unitModule (projectiveSpaceOver 0 S) :=
  (Scheme.Modules.pullback (projectiveSpaceOver.toIntegralAtUniverse 0 S)).mapIso
      (twistingSheafIsoUnitModuleOneVariable (ULift.{u} ℤ) d) ≪≫
    Stacks.RelativeAmple.pullbackUnitModuleIso
      (projectiveSpaceOver.toIntegralAtUniverse 0 S)

/-- **The twists on `ℙ⁰` are trivial**: for a module `𝒢` on `ℙ⁰_R` and any `d ∈ ℤ`, `𝒢(d) ≅ 𝒢`.
This is the identification the source makes when it says that on `ℙ⁰_k = Spec k` one has
`ℱ(d) = ℱ`.

The twist is the tensor product of `𝒢` with the degree-`d` twisting sheaf, which is trivial by
`projectiveTwistingSheafZeroIsoUnit`; cancelling the structure sheaf is the right unitor of the
tensor product of sheaves of modules, `Stacks.SheafOfModules.tensorLeftFunctorObjUnitIso`. -/
public def projectiveTwistZeroIso (R : Type u) [CommRing R]
    (G : (projectiveSpaceOverRing 0 (.of R)).Modules) (d : ℤ) :
    projectiveTwist 0 G d ≅ G :=
  Stacks.RelativeVeryAmple.tensorModulesMapIso (projectiveSpaceOver 0 (Spec (.of R)))
      (Iso.refl G) (projectiveTwistingSheafZeroIsoUnit (Spec (.of R)) d) ≪≫
    Stacks.SheafOfModules.tensorLeftFunctorObjUnitIso
      (projectiveSpaceOver 0 (Spec (.of R))).presheaf
      (Stacks.SheafInternalHom.isSheaf_structureRingPresheaf
        (projectiveSpaceOver 0 (Spec (.of R)))) G

end TwistsOnProjectiveZero

/-! ### The Hilbert polynomial is a numerical polynomial -/

attribute [local instance] isCoherent_projectiveTwist

variable (k : Type u) [Field k] (n : ℕ)

/-- **The Hilbert polynomial is the Euler characteristic of the twist.** For a coherent sheaf on
projective space over a field, the value at `d` of the Hilbert polynomial of [Stacks, Tag 08AD]
is the Euler characteristic of the `d`-th twist: both are the same alternating sum of dimensions
of cohomology. -/
public theorem hilbertPolynomial_eq_eulerCharacteristic
    (F : (projectiveSpaceOverRing n (.of k)).Modules) [F.IsCoherent] (d : ℤ) :
    hilbertPolynomial k n F d =
      eulerCharacteristic k (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k))
        (projectiveTwist n F d) :=
  rfl

/-- Additivity of `χ` on a short exact sequence `𝒜 ⟶ ℬ ⟶ 𝒞` with `𝒜 ≅ ℱ(d-1)`, `ℬ ≅ ℱ(d)` gives
the first difference of the Hilbert polynomial. -/
private theorem hilbertPolynomial_sub_eq_of_euler_add
    (F : (projectiveSpaceOverRing n (.of k)).Modules) [F.IsCoherent] (d : ℤ)
    {S : ShortComplex (projectiveSpaceOverRing n (.of k)).Modules}
    [S.X₁.IsCoherent] [S.X₂.IsCoherent] [S.X₃.IsCoherent]
    (e₁ : S.X₁ ≅ projectiveTwist n F (d - 1)) (e₂ : S.X₂ ≅ projectiveTwist n F d)
    (hadd : eulerCharacteristic k (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k)) S.X₂ =
      eulerCharacteristic k (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k)) S.X₁ +
        eulerCharacteristic k (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k)) S.X₃) :
    hilbertPolynomial k n F d - hilbertPolynomial k n F (d - 1) =
      eulerCharacteristic k (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k)) S.X₃ := by
  rw [hilbertPolynomial_eq_eulerCharacteristic, hilbertPolynomial_eq_eulerCharacteristic,
    ← eulerCharacteristic_eq_of_iso k _ e₁, ← eulerCharacteristic_eq_of_iso k _ e₂, hadd]
  ring

/-- **The first difference of the Hilbert polynomial along a hyperplane sequence.** Let `ℱ` be a
coherent sheaf on `ℙⁿ_k` and let `0 ⟶ 𝒜 ⟶ ℬ ⟶ 𝒞 ⟶ 0` be a short exact sequence of coherent
sheaves on `ℙⁿ_k` with `𝒜 ≅ ℱ(d-1)` and `ℬ ≅ ℱ(d)`. Then
`χ(ℙⁿ_k, ℱ(d)) - χ(ℙⁿ_k, ℱ(d-1)) = χ(ℙⁿ_k, 𝒞)`.

This is additivity of the Euler characteristic, [Stacks, Tag 08AA], read at the twisted sequence
of [Stacks, Tag 0EGK]; the finite-dimensionality it needs is assumed in the finitely many degrees
below the affine covering number, which is the content of [Stacks, Tag 02O6] over a field
base. -/
@[sga "6 XIII 1.7" "partial"]
public theorem hilbertPolynomial_sub_eq_eulerCharacteristic_of_shortExact
    (F : (projectiveSpaceOverRing n (.of k)).Modules) [F.IsCoherent] (d : ℤ)
    {S : ShortComplex (projectiveSpaceOverRing n (.of k)).Modules} (hS : S.ShortExact)
    [S.X₁.IsCoherent] [S.X₂.IsCoherent] [S.X₃.IsCoherent]
    (e₁ : S.X₁ ≅ projectiveTwist n F (d - 1)) (e₂ : S.X₂ ≅ projectiveTwist n F d)
    (hfin₁ : ∀ i < (projectiveSpaceOverRing n (.of k)).affineCoverNum ⊤,
      FiniteDimensional k (cohomologyOverField k
        (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k)) S.X₁ i))
    (hfin₃ : ∀ i < (projectiveSpaceOverRing n (.of k)).affineCoverNum ⊤,
      FiniteDimensional k (cohomologyOverField k
        (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k)) S.X₃ i)) :
    hilbertPolynomial k n F d - hilbertPolynomial k n F (d - 1) =
      eulerCharacteristic k (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k)) S.X₃ :=
  hilbertPolynomial_sub_eq_of_euler_add k n F d e₁ e₂
    (eulerCharacteristic_add_of_shortExact_of_finiteDimensional' k
      (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k)) hS hfin₁ hfin₃)

/-- **The first difference of the Hilbert polynomial along a hyperplane sequence, with no
finiteness hypothesis.** Same statement as
`AlgebraicGeometry.hilbertPolynomial_sub_eq_eulerCharacteristic_of_shortExact`, with the
degreewise finite-dimensionality discharged by
`AlgebraicGeometry.cohomologyFiniteDimensionalOverField_of_isProper`, which is
[Stacks, Tag 02O6] over a field base. -/
@[sga "6 XIII 1.7" "partial"]
public theorem hilbertPolynomial_sub_eq_eulerCharacteristic_of_shortExact'
    (F : (projectiveSpaceOverRing n (.of k)).Modules) [F.IsCoherent] (d : ℤ)
    {S : ShortComplex (projectiveSpaceOverRing n (.of k)).Modules} (hS : S.ShortExact)
    [S.X₁.IsCoherent] [S.X₂.IsCoherent] [S.X₃.IsCoherent]
    (e₁ : S.X₁ ≅ projectiveTwist n F (d - 1)) (e₂ : S.X₂ ≅ projectiveTwist n F d) :
    hilbertPolynomial k n F d - hilbertPolynomial k n F (d - 1) =
      eulerCharacteristic k (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k)) S.X₃ :=
  hilbertPolynomial_sub_eq_of_euler_add k n F d e₁ e₂
    (eulerCharacteristic_add_of_shortExact k (projectiveSpaceOverRing n (.of k) ↘ Spec (.of k)) hS)

/-- **[Stacks, Tag 08AC], granted the hyperplane difference formula.** For a field `k`, an
integer `n ≥ 0` and a coherent sheaf `ℱ` on `ℙⁿ_k`, the function `d ↦ χ(ℙⁿ_k, ℱ(d))` is a
numerical polynomial.

The one hypothesis is the geometric fact the source's inductive step consumes, for the given
field: for a coherent sheaf on `ℙ^{m+1}_k` there is a coherent sheaf on `ℙ^m_k` whose Hilbert
polynomial is the first difference of the given one — the displayed equation of the source's
proof, read through the identification of the hyperplane with `ℙ^m_k`. Everything else is proved:
the base case is constant because the twists on `ℙ⁰_k` are trivial
(`AlgebraicGeometry.projectiveTwistZeroIso`), the induction on `n` is carried out, and
[Stacks, Tag 00JZ] in the form `main_00JZ` turns each difference back into the function.

`hstep` is itself a theorem, `AlgebraicGeometry.exists_coherent_hilbertPolynomial_sub_eq`; the
hypothesis-free form of the tag is
`AlgebraicGeometry.isNumericalPolynomial_hilbertPolynomial'`. -/
@[stacks 08AC "the induction on n of the source's proof together with its base case, the \
triviality of the twists on P^0; its one geometric input is the hypothesis hstep, the hyperplane \
difference formula of Stacks 0EGK, 08A0, 089Z and 08AA, which is discharged by \
AlgebraicGeometry.exists_coherent_hilbertPolynomial_sub_eq"]
public theorem isNumericalPolynomial_hilbertPolynomial
    (hstep : ∀ (m : ℕ) (G : (projectiveSpaceOverRing (m + 1) (.of k)).Modules)
      (_ : G.IsCoherent), ∃ (H : (projectiveSpaceOverRing m (.of k)).Modules)
        (hH : H.IsCoherent), ∀ d : ℤ,
          hilbertPolynomial k (m + 1) G d - hilbertPolynomial k (m + 1) G (d - 1) =
            @hilbertPolynomial k _ m H hH d)
    (F : (projectiveSpaceOverRing n (.of k)).Modules) [F.IsCoherent] :
    IsNumericalPolynomial (hilbertPolynomial k n F) := by
  suffices h : ∀ (m : ℕ) (G : (projectiveSpaceOverRing m (.of k)).Modules) (hG : G.IsCoherent),
      IsNumericalPolynomial (@hilbertPolynomial k _ m G hG) from h n F ‹_›
  intro m
  induction m with
  | zero =>
    intro G hG
    have hconst : ∀ d : ℤ, @hilbertPolynomial k _ 0 G hG d =
        eulerCharacteristic k (projectiveSpaceOverRing 0 (.of k) ↘ Spec (.of k)) G := by
      intro d
      rw [hilbertPolynomial_eq_eulerCharacteristic]
      exact eulerCharacteristic_eq_of_iso k _ (projectiveTwistZeroIso k G d)
    exact (IsNumericalPolynomial.const
      (eulerCharacteristic k (projectiveSpaceOverRing 0 (.of k) ↘ Spec (.of k)) G)).congr
      (Filter.Eventually.of_forall fun d => (hconst d).symm)
  | succ p ih =>
    intro G hG
    obtain ⟨H, hH, hd⟩ := hstep p G hG
    exact main_00JZ _ ((ih H hH).congr (Filter.Eventually.of_forall fun d => (hd d).symm))

