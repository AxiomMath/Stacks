module

public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import StacksFrontier.RingTheory.RegularLocalRing.Colimit

/-!
# The stalk of a hypersurface in a regular scheme is regular away from the square of the maximal
ideal

A closed subscheme `Z ⊂ Y` whose ideal is principal at a point `z` — a hypersurface at `z` — has
regular local ring there as soon as the ambient local ring `𝒪_{Y,z}` is regular and the local
equation does **not** lie in `𝔪_z²`. This is the local algebra behind every Jacobian criterion:
a quotient of a regular local ring by one element of `𝔪 ∖ 𝔪²` is again regular
([Stacks, Tag 00NQ]), and the stalk map of a closed immersion is surjective, so the stalk of the
subscheme is exactly that quotient.

## Main results

* `IsRegularLocalRing.of_surjective_of_ker_eq_span_singleton`: the ring-level statement — a
  surjection out of a regular local ring whose kernel is generated by an element of `𝔪 ∖ 𝔪²`
  has regular local target.
* `AlgebraicGeometry.isRegularLocalRing_stalk_of_ker_stalkMap_eq_span_singleton`: the same read
  on the stalk map of a morphism surjective on stalks, in particular a closed immersion.

## Implementation notes

The local equation is a parameter: which element of `𝒪_{Y,z}` generates the kernel of the stalk
map is particular to the subscheme at hand, and for the zero scheme of a section of an
invertible module it is read off from a trivialization. What is proved here is everything that
follows once such a generator is named, so that the geometric input reduces to exhibiting it and
checking that it avoids `𝔪_z²`.

No `@[stacks]` attribute is attached: this is the transport of
`Stacks.RegularLocalRing.DirectedColimit.isRegularLocalRing_quotient_span_singleton`, which
carries the registration of Tag 00NQ's content, along a surjection, not the statement of a tag.

## References

* [Stacks Project, Tag 00NQ](https://stacks.math.columbia.edu/tag/00NQ)
* [Stacks Project, Tag 00NU](https://stacks.math.columbia.edu/tag/00NU)
-/

@[expose] public section

open CategoryTheory IsLocalRing

universe u

/-- **A surjection out of a regular local ring with kernel generated by a regular parameter has
regular local target.** If `A` is a regular local ring, `x ∈ 𝔪_A` does not lie in `𝔪_A²` and
`φ : A → B` is surjective with kernel `(x)`, then `B` is a regular local ring.

The first isomorphism theorem identifies `B` with `A/(x)`, which is regular by
`Stacks.RegularLocalRing.DirectedColimit.isRegularLocalRing_quotient_span_singleton`, and
regularity transports along a ring isomorphism. -/
theorem IsRegularLocalRing.of_surjective_of_ker_eq_span_singleton {A B : Type*} [CommRing A]
    [CommRing B] [IsRegularLocalRing A] (φ : A →+* B) (hφ : Function.Surjective φ) {x : A}
    (hx : x ∈ maximalIdeal A) (hx2 : x ∉ maximalIdeal A ^ 2)
    (hker : RingHom.ker φ = Ideal.span {x}) : IsRegularLocalRing B := by
  have hreg : IsRegularLocalRing (A ⧸ Ideal.span {x}) :=
    Stacks.RegularLocalRing.DirectedColimit.isRegularLocalRing_quotient_span_singleton hx hx2
  exact IsRegularLocalRing.of_ringEquiv
    ((Ideal.quotEquivOfEq hker.symm).trans (RingHom.quotientKerEquivOfSurjective hφ))

namespace AlgebraicGeometry

/-- **A hypersurface in a regular scheme is regular at a point where its local equation avoids
the square of the maximal ideal.** Let `f : Z ⟶ Y` be surjective on stalks — a closed immersion,
for instance — let `z` be a point of `Z`, and suppose the kernel of the stalk map at `z` is
generated by a single element `x` of `𝔪_{Y, f z}` which does not lie in `𝔪_{Y, f z}²`. If
`𝒪_{Y, f z}` is a regular local ring then so is `𝒪_{Z, z}`.

This is the step of a Jacobian criterion that turns the non-vanishing of the differential of a
local equation into regularity of the zero locus; combined with
`AlgebraicGeometry.smoothAt_iff_isRegularLocalRing_stalk` it turns it into smoothness over a
field. -/
theorem isRegularLocalRing_stalk_of_ker_stalkMap_eq_span_singleton {Y Z : Scheme.{u}} (f : Z ⟶ Y)
    [SurjectiveOnStalks f] (z : Z) [IsRegularLocalRing (Y.presheaf.stalk (f z))]
    {x : Y.presheaf.stalk (f z)} (hx : x ∈ maximalIdeal (Y.presheaf.stalk (f z)))
    (hx2 : x ∉ maximalIdeal (Y.presheaf.stalk (f z)) ^ 2)
    (hker : RingHom.ker (f.stalkMap z).hom = Ideal.span {x}) :
    IsRegularLocalRing (Z.presheaf.stalk z) :=
  IsRegularLocalRing.of_surjective_of_ker_eq_span_singleton (f.stalkMap z).hom
    (f.stalkMap_surjective z) hx hx2 hker

end AlgebraicGeometry

end
