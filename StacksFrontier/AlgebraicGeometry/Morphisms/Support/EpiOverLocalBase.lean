module

public import Mathlib.AlgebraicGeometry.Morphisms.UniversallyClosed
public import StacksFrontier.AlgebraicGeometry.DevissageNoetherian.Support
public import StacksFrontier.AlgebraicGeometry.Modules.StalkSupport
public import StacksFrontier.AlgebraicGeometry.Morphisms.Support.Functoriality
public import StacksFrontier.AlgebraicGeometry.Perfect.SupportPullback.Basic

/-!
# Epimorphisms of modules detected on the closed fibre over a local base

Let `X` be a scheme universally closed over the spectrum of a local ring `A`, and let `i : E ⟶ X`
be a morphism whose image is the fibre over the closed point of `Spec(A)`. This file proves that
a morphism of `𝒪_X`-modules with target of finite type is an epimorphism as soon as its
restriction along `i` is.

This is the step that turns "generated by global sections along the closed fibre" into
"generated by global sections", and it is what the source of [Stacks, Tag 0B64] leaves implicit
in the proof of its clause (3).

## Main results

* `AlgebraicGeometry.Scheme.Modules.isZero_of_isZero_pullback_of_range_eq_fibre`: a module of
  finite type whose restriction to the closed fibre vanishes, vanishes.
* `AlgebraicGeometry.Scheme.Modules.epi_of_epi_pullback_of_range_eq_fibre`: the epimorphism
  criterion.

## The argument

The support of a module of finite type is closed ([Stacks, Tag 056J]), its image under a
universally closed morphism is closed, and a nonempty closed subset of the spectrum of a local
ring contains the closed point — every point specializes to it. So a nonzero module of finite
type has a point of its support in the fibre over the closed point, i.e. in the image of `i`;
and the support of the restriction along `i` is the inverse image of the support
([Stacks, Tag 056J] again), so that point witnesses a nonzero restriction.

For the criterion, apply this to the cokernel: pullback is a left adjoint, so it preserves the
cokernel, and the cokernel of an epimorphism is zero.

## References

* [Stacks Project, Tag 056J](https://stacks.math.columbia.edu/tag/056J)
* [Stacks Project, Tag 0B64](https://stacks.math.columbia.edu/tag/0B64)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.Scheme.Modules

variable {A : Type u} [CommRing A] [IsLocalRing A] {X E : Scheme.{u}}

/-- **A module of finite type whose restriction to the closed fibre vanishes, vanishes.** Were
its support nonempty, the image of the support would be a closed subset of `Spec(A)` containing
the specialization of one of its points, hence containing the closed point; a point of the
support over the closed point lies in the image of `i`, and the support of the restriction is
the inverse image of the support. -/
public theorem isZero_of_isZero_pullback_of_range_eq_fibre (f : X ⟶ Spec (.of A))
    [UniversallyClosed f] (i : E ⟶ X)
    (hi : Set.range i.base = f.base ⁻¹' {IsLocalRing.closedPoint A}) (M : X.Modules)
    (hM : M.IsFiniteType) (h : IsZero ((Scheme.Modules.pullback i).obj M)) : IsZero M := by
  have hM' := hM
  refine Stacks.AlgebraicGeometry.DevissageNoetherian.isZero_of_supp_eq_empty M
    (Set.eq_empty_iff_forall_notMem.mpr fun x hx => ?_)
  have hclosed : IsClosed (f.base '' SheafOfModules.supp M) :=
    f.isClosedMap _ (@SheafOfModules.isClosed_supp _ X.ringCatSheaf M hM)
  have hmem : (IsLocalRing.closedPoint A) ∈ f.base '' SheafOfModules.supp M :=
    (IsLocalRing.specializes_closedPoint (f.base x)).mem_closed hclosed ⟨x, hx, rfl⟩
  obtain ⟨y, hy, hyf⟩ := hmem
  obtain ⟨z, rfl⟩ : y ∈ Set.range i.base := by rw [hi]; exact hyf
  have hz : z ∈ i.base ⁻¹' SheafOfModules.supp M := hy
  rw [← SheafOfModules.supp_pullback i M, _root_.SheafOfModules.supp_eq_empty_of_isZero h] at hz
  exact hz

/-- **An epimorphism is detected on the closed fibre.** The cokernel of the restriction is the
restriction of the cokernel, because pullback is a left adjoint; so the cokernel has vanishing
restriction and is of finite type, hence vanishes. -/
public theorem epi_of_epi_pullback_of_range_eq_fibre (f : X ⟶ Spec (.of A))
    [UniversallyClosed f] (i : E ⟶ X)
    (hi : Set.range i.base = f.base ⁻¹' {IsLocalRing.closedPoint A}) {M N : X.Modules}
    (φ : M ⟶ N) (hN : N.IsFiniteType) (h : Epi ((Scheme.Modules.pullback i).map φ)) : Epi φ := by
  let : PreservesColimitsOfSize.{u, u} (Scheme.Modules.pullback i) :=
    (Scheme.Modules.pullbackPushforwardAdjunction i).leftAdjoint_preservesColimits
  have h' := h
  have hz : IsZero ((Scheme.Modules.pullback i).obj (cokernel φ)) :=
    (isZero_cokernel_of_epi ((Scheme.Modules.pullback i).map φ)).of_iso
      (PreservesCokernel.iso (Scheme.Modules.pullback i) φ)
  have hc := isZero_of_isZero_pullback_of_range_eq_fibre f i hi (cokernel φ)
    (isFiniteType_cokernel φ hN) hz
  exact Abelian.epi_of_cokernel_π_eq_zero φ (hc.eq_of_tgt _ _)

end AlgebraicGeometry.Scheme.Modules

end
