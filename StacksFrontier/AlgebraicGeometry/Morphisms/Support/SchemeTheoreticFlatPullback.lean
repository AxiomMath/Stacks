module

public import Mathlib.AlgebraicGeometry.Morphisms.Flat
public import StacksFrontier.AlgebraicGeometry.DivisorFlatPullback.Basic
public import StacksFrontier.AlgebraicGeometry.Divisors.AssociatedPoints.Finiteness
public import StacksFrontier.AlgebraicGeometry.Morphisms.Support.Pullback
public import StacksFrontier.AlgebraicGeometry.Morphisms.Support.SchemeTheoretic
public import StacksFrontier.AlgebraicGeometry.PullbackSections.Affine
public import StacksFrontier.RingTheory.Ideal.Annihilator.FlatBaseChange

/-!
# The scheme-theoretic support of a finite type quasi-coherent module under flat pullback

Let `f : Y ⟶ X` be a flat morphism of schemes and let `F` be a quasi-coherent `𝒪_X`-module of
finite type with scheme-theoretic support `Z ⊆ X`. Then the scheme-theoretic inverse image
`f⁻¹Z` is the scheme-theoretic support of `f^*F`.

## Main results

* `AlgebraicGeometry.Scheme.Modules.annihilator_sections_pullback_of_flat`: the affine case. If
  `V` is an affine open of `Y` inside the preimage of an affine open `U` of `X`, then the
  annihilator of `Γ(f^*F, V)` is generated by the image of the annihilator of `Γ(F, U)`.
* `AlgebraicGeometry.Scheme.Modules.schemeTheoreticSupport_pullback`: the two closed subschemes
  of `Y` agree, as ideal sheaves.

## References

* [Stacks Project, Tag 07T8](https://stacks.math.columbia.edu/tag/07T8)
* [Stacks Project, Tag 07T9](https://stacks.math.columbia.edu/tag/07T9)
-/

@[expose] public noncomputable section

open CategoryTheory TensorProduct

universe u

namespace AlgebraicGeometry.Scheme.Modules

/-- **The annihilator of the sections of a finite type quasi-coherent module is compatible with
flat pullback.** If `V` is an affine open of `Y` contained in the preimage of an affine open `U`
of `X`, then the annihilator of `Γ(f^*F, V)` is the ideal generated by the image of
`Ann_{Γ(X, U)} Γ(F, U)` under restriction along `f`. -/
theorem annihilator_sections_pullback_of_flat {X Y : Scheme.{u}} (f : Y ⟶ X) [Flat f]
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType]
    (U : X.affineOpens) (V : Y.affineOpens) (hVU : (V : Y.Opens) ≤ f ⁻¹ᵁ (U : X.Opens)) :
    Module.annihilator Γ(Y, V.1) Γ((Scheme.Modules.pullback f).obj F, V.1) =
      (Module.annihilator Γ(X, U.1) Γ(F, U.1)).map (f.appLE U.1 V.1 hVU).hom := by
  let R := Γ(X, U.1)
  let S := Γ(Y, V.1)
  let α := f.appLE U.1 V.1 hVU
  let : Algebra R S := α.hom.toAlgebra
  have : Module.Flat R S :=
    RingHom.flat_algebraMap_iff.mp (show α.hom.Flat from f.flat_appLE U.2 V.2 hVU)
  have : Module.Finite R Γ(F, U.1) := moduleFinite_sections_on_affine F U.1 U.2
  let T := (ModuleCat.restrictScalars (algebraMap R S)).obj (ModuleCat.of S S)
  have : IsScalarTower R S T := IsScalarTower.of_algebraMap_smul fun _ _ ↦ rfl
  show Module.annihilator S Γ((Scheme.Modules.pullback f).obj F, V.1) =
    Ideal.map (algebraMap R S) (Module.annihilator R Γ(F, U.1))
  calc
    _ = Module.annihilator S ((ModuleCat.extendScalars (algebraMap R S)).obj (.of R Γ(F, U.1))) :=
      (affinePullbackSectionsBaseChangeIso f F U.2 V.2 hVU).toLinearEquiv.annihilator_eq.symm
    _ = Module.annihilator S (S ⊗[R] Γ(F, U.1)) :=
      (TensorProduct.AlgebraTensorModule.congr (.refl S S : T ≃ₗ[S] S) (.refl R _)).annihilator_eq
    _ = _ := (ann_extension_eq_ann_baseChange_module (R := R) (S := S) (M := Γ(F, U.1))).symm

/-- The scheme-theoretic inverse image of the scheme-theoretic support of a finite type
quasi-coherent module along a flat morphism is the scheme-theoretic support of its pullback. -/
@[stacks 07T9]
theorem schemeTheoreticSupport_pullback {X Y : Scheme.{u}} (f : Y ⟶ X) [Flat f]
    (F : X.Modules) [F.IsQuasicoherent] [F.IsFiniteType] :
    schemeTheoreticSupport ((Scheme.Modules.pullback f).obj F) =
      (schemeTheoreticSupport F).comap f := by
  let ι := Σ U : X.affineOpens, {V : Y.affineOpens // (V : Y.Opens) ≤ f ⁻¹ᵁ (U : X.Opens)}
  have hcover : (⨆ i : ι, (i.2.1 : Y.Opens)) = ⊤ := by
    rw [← top_le_iff]
    intro y _
    obtain ⟨_, ⟨U, hU, rfl⟩, hyU, -⟩ :=
      X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (f.base y)) isOpen_univ
    obtain ⟨_, ⟨V, hV, rfl⟩, hyV, hVU⟩ :=
      Y.isBasis_affineOpens.exists_subset_of_mem_open hyU (f ⁻¹ᵁ U).isOpen
    exact TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨⟨U, hU⟩, ⟨⟨V, hV⟩, hVU⟩⟩, hyV⟩
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top (fun i : ι ↦ i.2.1) hcover fun i ↦ ?_
  rw [schemeTheoreticSupport_ideal, Stacks.IdealSheaf.ideal_comap_appLE
    (schemeTheoreticSupport F) f i.1 i.2.1 i.2.2, schemeTheoreticSupport_ideal]
  exact annihilator_sections_pullback_of_flat f F i.1 i.2.1 i.2.2

end AlgebraicGeometry.Scheme.Modules

end
