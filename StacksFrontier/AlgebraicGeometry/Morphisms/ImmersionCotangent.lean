module

public import Mathlib.AlgebraicGeometry.Morphisms.Immersion
public import Mathlib.RingTheory.Ideal.Cotangent

/-!
# An immersion is surjective on maximal ideals and on cotangent spaces

A morphism of schemes surjective on stalks — an immersion, in particular — is surjective on the
maximal ideals of the stalks and therefore on their cotangent spaces `𝔪/𝔪²`. So a family of
elements generating the maximal ideal of the target at `f x` has an image generating the maximal
ideal of the source at `x`, and the classes of that image already span the cotangent space
`𝔪_x/𝔪_x²` over the residue field of `x`.

This is the direction of the comparison the library did not have. In
`StacksDraft.AlgebraicGeometry.Variety.SeparatingPointsTangentVectors` the separation predicates
occur as *hypotheses* from which a closed immersion is deduced, whereas the proof of
[Stacks, Tag 0FD6](https://stacks.math.columbia.edu/tag/0FD6) uses the converse: "as
`φ_{ℒ,ψ}` is an immersion the map `V → ℒ_x/𝔪_x²ℒ_x` is surjective (small detail omitted)".

## Main definitions

* `AlgebraicGeometry.stalkMapOnMaximalIdeal`: the map `𝔪_{f x} → 𝔪_x` induced by the stalk map.

## Main results

* `AlgebraicGeometry.map_maximalIdeal_stalkMap`: for `f` surjective on stalks,
  `𝔪_{f x} · 𝒪_{X,x} = 𝔪_x`.
* `AlgebraicGeometry.exists_mem_maximalIdeal_stalkMap_eq`: every element of `𝔪_x` is the image of
  an element of `𝔪_{f x}`.
* `AlgebraicGeometry.span_image_stalkMap_eq_maximalIdeal`: the image of a generating family of
  `𝔪_{f x}` generates `𝔪_x`.
* `AlgebraicGeometry.surjective_toCotangent_stalkMap`: the cotangent space of `𝒪_{X,x}` is
  exhausted by the classes of the images of elements of `𝔪_{f x}`.
* `AlgebraicGeometry.span_image_toCotangent_stalkMap_eq_top`: the classes of the image of a
  generating family of `𝔪_{f x}` span `𝔪_x/𝔪_x²` over the residue field of `x`.
* `Submodule.span_eq_top_of_ideal_span_image_eq`: a subset of an ideal whose elements generate
  that ideal spans it as a module over the ring, the ideal being read as a submodule.

## Implementation notes

The ring-theoretic input is Mathlib's `IsLocalRing.map_maximalIdeal_of_surjective`, which needs
only that the homomorphism is surjective: a surjective homomorphism of local rings is
automatically local. Nothing below therefore mentions `IsLocalHom`, and the hypothesis is
`AlgebraicGeometry.SurjectiveOnStalks`, which `AlgebraicGeometry.IsImmersion` provides as an
instance through `AlgebraicGeometry.IsPreimmersion`.

The cotangent space is Mathlib's `Ideal.Cotangent` of the maximal ideal, that is
`IsLocalRing.CotangentSpace`. The spanning statement is obtained over `𝒪_{X,x}` first and then
pushed to the residue field by `Submodule.span_le_restrictScalars`, which avoids the Noetherian
hypothesis of Mathlib's `IsLocalRing.CotangentSpace.span_image_eq_top_iff`.

No `@[stacks]` attribute is attached: this is the ring-theoretic half of a detail the source
omits, not the statement of a tag.
-/

@[expose] public noncomputable section

open CategoryTheory IsLocalRing

universe u

/-- A subset of an ideal `I` whose elements generate `I` spans `I` as a module over the ring,
the ideal being read as a submodule through its coercion to a type. -/
theorem Submodule.span_eq_top_of_ideal_span_image_eq {R : Type*} [CommRing R] (I : Ideal R)
    {S : Set I} (h : Ideal.span (((↑) : I → R) '' S) = I) : Submodule.span R S = ⊤ := by
  refine Submodule.map_injective_of_injective (Submodule.injective_subtype I) ?_
  rw [Submodule.map_span, Submodule.map_top, Submodule.range_subtype]
  exact h

namespace AlgebraicGeometry

variable {X Y : Scheme.{u}} (f : X ⟶ Y) [SurjectiveOnStalks f] (x : X)

/-- **A morphism surjective on stalks is surjective on maximal ideals**: the maximal ideal of
`𝒪_{X,x}` is generated by the image of the maximal ideal of `𝒪_{Y,f x}`. -/
theorem map_maximalIdeal_stalkMap :
    (maximalIdeal (Y.presheaf.stalk (f x))).map (f.stalkMap x).hom =
      maximalIdeal (X.presheaf.stalk x) :=
  IsLocalRing.map_maximalIdeal_of_surjective _ (f.stalkMap_surjective x)

/-- Every element of `𝔪_x` is the image of an element of `𝔪_{f x}`. -/
theorem exists_mem_maximalIdeal_stalkMap_eq (a : X.presheaf.stalk x)
    (ha : a ∈ maximalIdeal (X.presheaf.stalk x)) :
    ∃ b ∈ maximalIdeal (Y.presheaf.stalk (f x)), (f.stalkMap x).hom b = a := by
  obtain ⟨b, rfl⟩ := f.stalkMap_surjective x a
  refine ⟨b, ?_, rfl⟩
  rw [← IsLocalRing.maximalIdeal_comap (f.stalkMap x).hom]
  exact ha

/-- **The image of a generating family of `𝔪_{f x}` generates `𝔪_x`.** -/
theorem span_image_stalkMap_eq_maximalIdeal {T : Set (Y.presheaf.stalk (f x))}
    (hT : Ideal.span T = maximalIdeal (Y.presheaf.stalk (f x))) :
    Ideal.span ((f.stalkMap x).hom '' T) = maximalIdeal (X.presheaf.stalk x) := by
  rw [← Ideal.map_span, hT, map_maximalIdeal_stalkMap]

/-- The map `𝔪_{f x} ⟶ 𝔪_x` induced on maximal ideals by a morphism surjective on stalks. -/
def stalkMapOnMaximalIdeal :
    maximalIdeal (Y.presheaf.stalk (f x)) → maximalIdeal (X.presheaf.stalk x) := fun b =>
  ⟨(f.stalkMap x).hom b, by
    rw [← map_maximalIdeal_stalkMap f x]; exact Ideal.mem_map_of_mem _ b.2⟩

/-- The element of `𝒪_{X,x}` underlying `stalkMapOnMaximalIdeal f x b` is the image of `b` under
the stalk map. -/
@[simp]
theorem coe_stalkMapOnMaximalIdeal (b : maximalIdeal (Y.presheaf.stalk (f x))) :
    (stalkMapOnMaximalIdeal f x b : X.presheaf.stalk x) = (f.stalkMap x).hom b := rfl

/-- The map `𝔪_{f x} ⟶ 𝔪_x` induced by a morphism surjective on stalks is surjective. -/
theorem surjective_stalkMapOnMaximalIdeal : Function.Surjective (stalkMapOnMaximalIdeal f x) := by
  rintro ⟨a, ha⟩
  obtain ⟨b, hb, hba⟩ := exists_mem_maximalIdeal_stalkMap_eq f x a ha
  exact ⟨⟨b, hb⟩, Subtype.ext hba⟩

/-- **A morphism surjective on stalks is surjective on cotangent spaces.** Every element of
`𝔪_x/𝔪_x²` is the class of the image of an element of `𝔪_{f x}`. -/
theorem surjective_toCotangent_stalkMap :
    Function.Surjective fun b : maximalIdeal (Y.presheaf.stalk (f x)) =>
      (maximalIdeal (X.presheaf.stalk x)).toCotangent (stalkMapOnMaximalIdeal f x b) :=
  ((maximalIdeal (X.presheaf.stalk x)).toCotangent_surjective).comp
    (surjective_stalkMapOnMaximalIdeal f x)

/-- **The classes of the image of a generating family of `𝔪_{f x}` span the cotangent space
`𝔪_x/𝔪_x²`** over the residue field of `x`. -/
theorem span_image_toCotangent_stalkMap_eq_top
    {T : Set (maximalIdeal (Y.presheaf.stalk (f x)))}
    (hT : Ideal.span (((↑) : maximalIdeal (Y.presheaf.stalk (f x)) → Y.presheaf.stalk (f x)) ''
      T) = maximalIdeal (Y.presheaf.stalk (f x))) :
    Submodule.span (ResidueField (X.presheaf.stalk x))
        ((maximalIdeal (X.presheaf.stalk x)).toCotangent '' (stalkMapOnMaximalIdeal f x '' T)) =
      ⊤ := by
  have himg : Ideal.span
      (((↑) : maximalIdeal (X.presheaf.stalk x) → X.presheaf.stalk x) ''
        (stalkMapOnMaximalIdeal f x '' T)) = maximalIdeal (X.presheaf.stalk x) := by
    have h := span_image_stalkMap_eq_maximalIdeal f x hT
    rw [Set.image_image] at h ⊢
    exact h
  have hmod : Submodule.span (X.presheaf.stalk x) (stalkMapOnMaximalIdeal f x '' T) = ⊤ :=
    Submodule.span_eq_top_of_ideal_span_image_eq _ himg
  have hcot : Submodule.span (X.presheaf.stalk x)
      ((maximalIdeal (X.presheaf.stalk x)).toCotangent ''
        (stalkMapOnMaximalIdeal f x '' T)) = ⊤ := by
    rw [← Submodule.map_span, hmod, Submodule.map_top, LinearMap.range_eq_top.mpr
      (maximalIdeal (X.presheaf.stalk x)).toCotangent_surjective]
  exact Submodule.span_eq_top_of_span_eq_top (X.presheaf.stalk x)
    (ResidueField (X.presheaf.stalk x)) _ hcot

end AlgebraicGeometry

end
