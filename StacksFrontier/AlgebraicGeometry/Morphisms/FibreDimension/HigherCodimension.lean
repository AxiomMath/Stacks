/-!
# Fibre dimension over a point of higher codimension

Let `f : X ⟶ Y` be locally of finite type, let `x` be a point of `X` with image `y`, and assume
that the local ring `𝒪_{Y,y}` is Noetherian. Suppose that every irreducible component of `X`
through `x` has its generic point mapping away from `y`, and that the fibre through each such
generic point has dimension `d` there. Then

`dim_x(X_y) ≤ d + dim 𝒪_{Y,y} - 1`.

When `dim 𝒪_{Y,y} ≤ 1` the bound forces the fibre dimension at `x` to be at most `d`, and
together with the lower bound coming from the semicontinuity of the fibre dimension along a
specialization it gives `dim_x(X_y) = d` without the hypothesis that the generic points map away
from `y`.

Both statements are read off the dimension formula. Replacing `Y` by `Spec 𝒪_{Y,y}` — which is
legitimate because the fibre dimension is insensitive to base change and because
`Spec 𝒪_{Y,y}` is Noetherian, while `Y` itself need not be — the general dimension formula
`AlgebraicGeometry.ringKrullDim_stalk_add_trdeg_le_of_forall_genericPoints` bounds
`dim 𝒪_{X,x} + trdeg_{κ(y)} κ(x)` by `dim 𝒪_{Y,y} + d`, and the hypothesis that no component
through `x` dominates `y` makes the ideal generated by `𝔪_{Y,y}` in `𝒪_{X,x}` avoid every
minimal prime, so the fibre stalk has dimension at least one less than `𝒪_{X,x}`. The dimension
of the fibre at `x` is the dimension of the fibre stalk plus the residue-field transcendence
degree (Stacks 02FX), which closes the computation.

## Main definitions

No new definitions are introduced.

## Main results

* `AlgebraicGeometry.fromSpecStalk_mem_genericPoints_of_minimalPrimes_ideal`: the point of `X`
  cut out by a minimal prime of `𝒪_{X,x}` is the generic point of an irreducible component.
* `AlgebraicGeometry.ringKrullDim_fiber_stalk_succ_le_of_genericPoints`: if no irreducible
  component through `x` has its generic point over `y`, then the local ring of the fibre at `x`
  has dimension at least one less than `𝒪_{X,x}`.
* `AlgebraicGeometry.topologicalKrullDimAt_fiber_add_one_le_of_genericPoints`: the bound
  `dim_x(X_y) + 1 ≤ d + dim 𝒪_{Y,y}` of Stacks 0B2K.
* `AlgebraicGeometry.topologicalKrullDimAt_fiber_eq_of_target_dim_le_one`: the equality
  `dim_x(X_y) = d` of Stacks 0B2I.

## Implementation notes

Dimensions take values in `WithBot ℕ∞`, which has no subtraction, so the source's bound
`d + dim 𝒪_{Y,y} - 1` is written by adding one to the left-hand side. For a finite right-hand
side that is the strict inequality the source's proof displays, and the hypotheses force
`dim 𝒪_{Y,y}` to be positive, so the two readings agree; if the right-hand side is infinite,
both hold automatically. A point is placed in its scheme-theoretic fibre by
`AlgebraicGeometry.Scheme.Hom.asFiber`, and generic points of irreducible components are
described either as the points of `genericPoints` or by the condition that the closure of the
singleton is an irreducible component.

## References

* [Stacks Project, Tag 0B2I](https://stacks.math.columbia.edu/tag/0B2I)
* [Stacks Project, Tag 0B2K](https://stacks.math.columbia.edu/tag/0B2K)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace AlgebraicGeometry

variable {X Y : Scheme.{u}}

/-- Every point of `Spec 𝒪_{X,x}` maps to a generalization of `x`. -/
private lemma fromSpecStalk_specializes (x : X) (q : Spec (X.presheaf.stalk x)) :
    X.fromSpecStalk x q ⤳ x := by
  have hmem : X.fromSpecStalk x q ∈ Set.range (X.fromSpecStalk x).base := ⟨q, rfl⟩
  rwa [Scheme.range_fromSpecStalk] at hmem

/-- The local dimension of a fibre at a point is the supremum of the dimensions of the
irreducible components of the fibre through it. -/
private lemma topologicalKrullDimAt_fiber_eq_iSup (f : X ⟶ Y) [LocallyOfFiniteType f] (y : Y)
    (a : f.fiber y) : topologicalKrullDimAt (f.fiber y) a =
      ⨆ Z ∈ {Z ∈ irreducibleComponents (f.fiber y) | a ∈ Z}, topologicalKrullDim Z := by
  have hft : LocallyOfFiniteType (f.fiberToSpecResidueField y) := by
    change LocallyOfFiniteType (pullback.snd f (Y.fromSpecResidueField y))
    infer_instance
  exact topologicalKrullDimAt_eq_iSup_irreducibleComponents (Y.residueField y) (f.fiber y)
    (f.fiberToSpecResidueField y) a

/-- The point of `X` cut out by a minimal prime of the local ring `𝒪_{X,x}` is the generic point
of an irreducible component of `X`: the points of `Spec 𝒪_{X,x}` are exactly the
generalizations of `x`, a generalization of such a point is again one, and there it corresponds
to a prime below the given minimal one, hence equal to it. -/
theorem fromSpecStalk_mem_genericPoints_of_minimalPrimes_ideal (x : X)
    {p : Ideal (X.presheaf.stalk x)} (hp : p ∈ minimalPrimes (X.presheaf.stalk x)) :
    X.fromSpecStalk x ⟨p, hp.isPrime⟩ ∈ genericPoints X := by
  have hpp : p.IsPrime := hp.isPrime
  set s := X.fromSpecStalk x
  set η : X := s ⟨p, hpp⟩
  have hηx : η ⤳ x := fromSpecStalk_specializes x ⟨p, hpp⟩
  refine (mem_genericPoints_iff_forall_specializes_eq η).2 fun z hz => ?_
  obtain ⟨q, rfl⟩ : ∃ q : Spec (X.presheaf.stalk x), s q = z := by
    have hzx : z ∈ Set.range s.base := by
      rw [Scheme.range_fromSpecStalk]
      exact hz.trans hηx
    exact hzx
  have hqple : q.asIdeal ≤ p :=
    (PrimeSpectrum.asIdeal_le_asIdeal q ⟨p, hpp⟩).mp
      ((PrimeSpectrum.le_iff_specializes q ⟨p, hpp⟩).mpr
        (s.isEmbedding.isInducing.specializes_iff.mp hz))
  have hmin : Minimal Ideal.IsPrime p := by
    rw [← IsMinimalPrime.iff_minimal]
    simpa using hp
  exact congrArg s.base
    (PrimeSpectrum.ext (le_antisymm hqple (hmin.2 q.isPrime hqple)))

/-- If every irreducible component of `X` through `x` has its generic point mapping away from
`f x`, then the ideal generated by the maximal ideal of `𝒪_{Y, f x}` in `𝒪_{X,x}` is contained
in no minimal prime: a minimal prime containing it would pull the maximal ideal back to itself,
which forces the corresponding generic point of `X` to lie over `f x`. -/
theorem map_maximalIdeal_notMem_minimalPrimes_of_genericPoints (f : X ⟶ Y) (x : X)
    (h : ∀ η : X, η ∈ genericPoints X → η ⤳ x → f η ≠ f x) :
    ∀ p ∈ (⊥ : Ideal (X.presheaf.stalk x)).minimalPrimes,
      ¬ Ideal.map (f.stalkMap x).hom
        (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f x))) ≤ p := by
  intro p hp hIp
  have hpp : p.IsPrime := hp.1.1
  set B := Y.presheaf.stalk (f x)
  set φ := (f.stalkMap x).hom
  set pSpec : Spec (X.presheaf.stalk x) := ⟨p, hpp⟩
  set η : X := X.fromSpecStalk x pSpec
  have hηgen : η ∈ genericPoints X :=
    fromSpecStalk_mem_genericPoints_of_minimalPrimes_ideal x (p := p) (by simpa using hp)
  have hηx : η ⤳ x := fromSpecStalk_specializes x pSpec
  -- the prime pulls back to the maximal ideal of `B`
  have hmle : IsLocalRing.maximalIdeal B ≤ Ideal.comap φ p := Ideal.map_le_iff_le_comap.mp hIp
  have hcomap : Ideal.comap φ p = IsLocalRing.maximalIdeal B :=
    ((IsLocalRing.maximalIdeal.isMaximal B).eq_of_le (Ideal.comap_isPrime φ p).ne_top hmle).symm
  -- hence `f η = f x`, contradicting the hypothesis
  have hz : (Spec.map (f.stalkMap x)) pSpec = IsLocalRing.closedPoint B :=
    PrimeSpectrum.ext hcomap
  have hfactor : f η = Y.fromSpecStalk (f x) ((Spec.map (f.stalkMap x)) pSpec) :=
    (congrArg (fun g : Spec (X.presheaf.stalk x) ⟶ Y => g pSpec)
      (Scheme.SpecMap_stalkMap_fromSpecStalk f (x := x))).symm
  refine h η hηgen hηx ?_
  rw [hfactor, hz]
  exact Scheme.fromSpecStalk_closedPoint

/-- If every irreducible component of `X` through `x` has its generic point mapping away from
`f x`, then the local ring of the fibre of `f` at `x` has Krull dimension at least one less than
that of `𝒪_{X,x}`: the fibre stalk is the quotient of `𝒪_{X,x}` by the ideal generated by the
maximal ideal of `𝒪_{Y, f x}`, and that ideal avoids every minimal prime. -/
theorem ringKrullDim_fiber_stalk_succ_le_of_genericPoints (f : X ⟶ Y) [LocallyOfFiniteType f]
    (x : X) [IsNoetherianRing (X.presheaf.stalk x)]
    (h : ∀ η : X, η ∈ genericPoints X → η ⤳ x → f η ≠ f x) :
    ringKrullDim ((f.fiber (f x)).presheaf.stalk (f.asFiber x)) + 1 ≤
      ringKrullDim (X.presheaf.stalk x) := by
  rw [← ringKrullDim_eq_of_ringEquiv (quotientStalkEquivFiberStalk f x)]
  exact ringKrullDim_quotient_succ_le_of_forall_notMem_minimalPrimes
    (Ideal.map (f.stalkMap x).hom (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f x))))
    (map_maximalIdeal_notMem_minimalPrimes_of_genericPoints f x h)

/-- At a generic point of an irreducible component, the fibre dimension is the transcendence
degree of the residue-field extension: the local ring of the fibre there has dimension zero, so
Stacks 02FX leaves only the transcendence degree. Consequently a fibre dimension of `d` bounds
that transcendence degree by `d`. -/
theorem toENat_trdeg_le_of_fiberDimensionAt_eq (f : X ⟶ Y) [LocallyOfFiniteType f] (η : X)
    {d : ℕ} (hη : topologicalKrullDimAt (f.fiber (f η)) (f.asFiber η) = (d : WithBot ℕ∞)) :
    Cardinal.toENat (@Algebra.trdeg (Y.residueField (f η)) (X.residueField η) _ _
      (f.residueFieldMap η).hom.toAlgebra) ≤ (d : ℕ∞) := by
  let : Algebra (Y.residueField (f η)) (X.residueField η) :=
    (f.residueFieldMap η).hom.toAlgebra
  have hle : (Cardinal.toENat (Algebra.trdeg (Y.residueField (f η)) (X.residueField η)) :
      WithBot ℕ∞) ≤ (d : WithBot ℕ∞) := by
    rw [← hη, topologicalKrullDimAt_fiber_eq_ringKrullDim_stalk_add_trdeg f η]
    exact le_add_of_nonneg_left Order.krullDim_nonneg
  exact_mod_cast hle

/-- Over a locally Noetherian base, if every generic point of `X` specializing to `x` maps away
from `f x` with fibre dimension `d` there, then `dim_x(X_{f x}) + 1 ≤ d + dim 𝒪_{Y, f x}`. -/
theorem topologicalKrullDimAt_fiber_add_one_le_of_forall_genericPoints (f : X ⟶ Y)
    [IsLocallyNoetherian Y] [LocallyOfFiniteType f] (x : X) (d : ℕ)
    (h : ∀ η : X, η ∈ genericPoints X → η ⤳ x →
      f η ≠ f x ∧ topologicalKrullDimAt (f.fiber (f η)) (f.asFiber η) = (d : WithBot ℕ∞)) :
    topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x) + 1 ≤
      (d : WithBot ℕ∞) + ringKrullDim (Y.presheaf.stalk (f x)) := by
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian f
  have hformula := ringKrullDim_stalk_add_trdeg_le_of_forall_genericPoints f x (d : ℕ∞)
    fun η hη hηx => toENat_trdeg_le_of_fiberDimensionAt_eq f η (h η hη hηx).2
  have hdrop := ringKrullDim_fiber_stalk_succ_le_of_genericPoints f x
    fun η hη hηx => (h η hη hηx).1
  let : Algebra (Y.residueField (f x)) (X.residueField x) := (f.residueFieldMap x).hom.toAlgebra
  set t : ℕ∞ := Cardinal.toENat (Algebra.trdeg (Y.residueField (f x)) (X.residueField x))
  rw [topologicalKrullDimAt_fiber_eq_ringKrullDim_stalk_add_trdeg f x]
  calc (ringKrullDim ((f.fiber (f x)).presheaf.stalk (f.asFiber x)) + (t : WithBot ℕ∞)) + 1
      = (ringKrullDim ((f.fiber (f x)).presheaf.stalk (f.asFiber x)) + 1)
          + (t : WithBot ℕ∞) := by ac_rfl
    _ ≤ ringKrullDim (X.presheaf.stalk x) + (t : WithBot ℕ∞) := add_le_add hdrop le_rfl
    _ ≤ ringKrullDim (Y.presheaf.stalk (f x)) + ((d : ℕ∞) : WithBot ℕ∞) := hformula
    _ = (d : WithBot ℕ∞) + ringKrullDim (Y.presheaf.stalk (f x)) := by
      rw [add_comm]; norm_cast

/-- **Stacks Project, Tag 0B2K.** The dimension at a point of a fibre is bounded by the
generic fibre dimension plus the dimension of the base local ring minus one, provided every
irreducible component through the point dominates a nonclosed generalization of its image. -/
@[stacks 0B2K]
theorem topologicalKrullDimAt_fiber_add_one_le_of_genericPoints (f : X ⟶ Y)
    [LocallyOfFiniteType f] (x : X) [IsNoetherianRing (Y.presheaf.stalk (f x))] (d : ℕ)
    (h : ∀ Z ∈ irreducibleComponents X, x ∈ Z → ∀ η : X, IsGenericPoint η Z →
      (f η ≠ f x ∧
        topologicalKrullDimAt (f.fiber (f η)) (f.asFiber η) = (d : WithBot ℕ∞))) :
    topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x) + 1 ≤
      (d : WithBot ℕ∞) + ringKrullDim (Y.presheaf.stalk (f x)) := by
  set B := Y.presheaf.stalk (f x)
  set T := Spec B
  set b := Y.fromSpecStalk (f x)
  set P : Scheme.{u} := pullback f b
  set g : P ⟶ X := pullback.fst f b
  set f' : P ⟶ T := pullback.snd f b
  have hpb : IsPullback g f' f b := IsPullback.of_hasPullback f b
  have : IsLocallyNoetherian T := isLocallyNoetherian_Spec.mpr ‹IsNoetherianRing B›
  have : LocallyOfFiniteType f' :=
    MorphismProperty.IsStableUnderBaseChange.of_isPullback
      (P := @LocallyOfFiniteType) hpb inferInstance
  have : Flat b := flat_fromSpecStalk Y (f x)
  -- the point of the base change over `x` and the closed point
  set cA : Spec (X.presheaf.stalk x) := IsLocalRing.closedPoint (X.presheaf.stalk x)
  set cB : Spec B := IsLocalRing.closedPoint B
  have : IsLocalHom (f.stalkMap x).hom := f.toLRSHom.prop x
  have hαβ : X.fromSpecStalk x ≫ f = Spec.map (f.stalkMap x) ≫ b :=
    (Scheme.SpecMap_stalkMap_fromSpecStalk f (x := x)).symm
  set i : Spec (X.presheaf.stalk x) ⟶ P :=
    pullback.lift (X.fromSpecStalk x) (Spec.map (f.stalkMap x)) hαβ
  set x' : P := i cA
  have hfst : g x' = x := (congrArg (fun k : Spec (X.presheaf.stalk x) ⟶ X => k cA)
    (pullback.lift_fst (X.fromSpecStalk x) (Spec.map (f.stalkMap x)) hαβ)).trans
      (Scheme.fromSpecStalk_closedPoint (x := x))
  have hsnd : f' x' = cB := (congrArg (fun k : Spec (X.presheaf.stalk x) ⟶ T => k cA)
    (pullback.lift_snd (X.fromSpecStalk x) (Spec.map (f.stalkMap x)) hαβ)).trans
      (AlgebraicGeometry.Spec_closedPoint (f := f.stalkMap x))
  -- transport the hypothesis to the base change
  have h' : ∀ η : P, η ∈ genericPoints P → η ⤳ x' →
      (f' η ≠ f' x' ∧
        topologicalKrullDimAt (f'.fiber (f' η)) (f'.asFiber η) = (d : WithBot ℕ∞)) := by
    intro η hηmem hηx'
    have hηgeneric : g η ∈ genericPoints X :=
      mem_genericPoints_of_generalizingMap (Flat.generalizingMap g) hηmem
    have hηx : g η ⤳ x := by simpa [hfst] using hηx'.map g.continuous
    have horig := h (closure {g η}) hηgeneric (specializes_iff_mem_closure.mp hηx) (g η) rfl
    refine ⟨fun heq => horig.1 ?_,
      (topologicalKrullDimAt_fiber_eq_of_isPullback hpb η).trans horig.2⟩
    calc f (g η) = b (f' η) := congrArg (fun k : P ⟶ Y => k η) hpb.w
      _ = b (f' x') := congrArg b heq
      _ = f x := by rw [hsnd]; exact Scheme.fromSpecStalk_closedPoint
  have hbaseDim : ringKrullDim (T.presheaf.stalk (f' x')) = ringKrullDim B := by
    rw [hsnd]
    exact ringKrullDim_eq_of_ringEquiv (stalkClosedPointIso B).commRingCatIsoToRingEquiv
  rw [show topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x) =
      topologicalKrullDimAt (f'.fiber (f' x')) (f'.asFiber x') by
    rw [← hfst]
    exact (topologicalKrullDimAt_fiber_eq_of_isPullback hpb x').symm, ← hbaseDim]
  exact topologicalKrullDimAt_fiber_add_one_le_of_forall_genericPoints f' x' d h'

/-- The local dimension of a fibre at a point only depends on the point, not on the description
of its image. -/
private lemma fiberDimensionAt_eq_of_target_eq (f : X ⟶ Y) (x : X) (y : Y) (hy : f x = y) :
    topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x) =
      topologicalKrullDimAt (f.fiber y) ((f.fiberHomeo y).symm ⟨x, hy⟩) := by
  subst hy
  simp [Scheme.Hom.asFiber]

private lemma topologicalKrullDimAt_fiber_le_of_forall_genericPoints_ne (f : X ⟶ Y)
    [LocallyOfFiniteType f] {η x : X} (hηx : η ⤳ x) [IsNoetherianRing (Y.presheaf.stalk (f η))]
    (hYdim : ringKrullDim (Y.presheaf.stalk (f η)) ≤ 1) (d : ℕ)
    (hgeneric : ∀ ν : X, closure {ν} ∈ irreducibleComponents X → x ∈ closure {ν} →
      topologicalKrullDimAt (f.fiber (f ν)) (f.asFiber ν) = d)
    (hvert : ¬ ∃ ν : X, closure {ν} ∈ irreducibleComponents X ∧ η ∈ closure {ν} ∧ f ν = f η) :
    topologicalKrullDimAt (f.fiber (f η)) (f.asFiber η) ≤ (d : WithBot ℕ∞) := by
  have h0B2K := topologicalKrullDimAt_fiber_add_one_le_of_genericPoints f η d (by
    intro Z hZ hηZ ν hνZ
    have hνcomponent : closure {ν} ∈ irreducibleComponents X := by rwa [hνZ.def]
    have hxν : x ∈ closure {ν} := by
      rw [hνZ.def]
      exact closure_minimal (Set.singleton_subset_iff.mpr hηZ)
        (isClosed_of_mem_irreducibleComponents Z hZ) (specializes_iff_mem_closure.mp hηx)
    exact ⟨fun heq => hvert ⟨ν, hνcomponent, by rwa [hνZ.def], heq⟩,
      hgeneric ν hνcomponent hxν⟩)
  have hrhs : (d : WithBot ℕ∞) + ringKrullDim (Y.presheaf.stalk (f η))
      ≤ ((d + 1 : ℕ) : WithBot ℕ∞) := by
    rw [Nat.cast_add, Nat.cast_one]
    simpa [add_comm] using add_le_add_left hYdim (d : WithBot ℕ∞)
  exact ENat.WithBot.lt_add_one_iff.mp
    (ENat.WithBot.add_one_le_natCast_iff.mp (h0B2K.trans hrhs))

/-- Each irreducible component of the fibre through `x` has dimension at most `d`, under the
hypotheses of Stacks 0B2I. Either the component's generic point comes from a generic point of a
component of `X` lying over `f x`, and then the assumption applies to that point directly, or no
such component exists and Stacks 0B2K applies at that generic point. -/
private theorem fiber_irreducibleComponent_dim_le (f : X ⟶ Y) [LocallyOfFiniteType f] (x : X)
    (hY : IsNoetherianRing (Y.presheaf.stalk (f x)))
    (hYdim : ringKrullDim (Y.presheaf.stalk (f x)) ≤ 1) (d : ℕ)
    (hgeneric : ∀ η : X, closure {η} ∈ irreducibleComponents X → x ∈ closure {η} →
      topologicalKrullDimAt (f.fiber (f η)) (f.asFiber η) = d)
    (C : Set (f.fiber (f x))) (hC : C ∈ irreducibleComponents (f.fiber (f x)))
    (hzC : f.asFiber x ∈ C) : topologicalKrullDim C ≤ (d : WithBot ℕ∞) := by
  have hCle (a : f.fiber (f x)) (ha : a ∈ C) :
      topologicalKrullDim C ≤ topologicalKrullDimAt (f.fiber (f x)) a := by
    rw [topologicalKrullDimAt_fiber_eq_iSup f (f x) a]
    exact le_iSup_of_le C (le_iSup_of_le ⟨hC, ha⟩ le_rfl)
  set ξ : f.fiber (f x) := hC.1.genericPoint
  have hξC : IsGenericPoint ξ C :=
    hC.1.isGenericPoint_genericPoint (isClosed_of_mem_irreducibleComponents C hC)
  have hξz : ξ ⤳ f.asFiber x := hξC.specializes hzC
  set η : X := f.fiberι (f x) ξ
  have hηy : f η = f x := by
    have hmem : η ∈ f ⁻¹' {f x} := by rw [← f.range_fiberι (f x)]; exact ⟨ξ, rfl⟩
    exact hmem
  have hb_eqξ : (f.fiberHomeo (f x)).symm ⟨η, hηy⟩ = ξ :=
    (f.fiberι (f x)).isEmbedding.injective (Scheme.Hom.fiberι_fiberHomeo_symm f (f x) _)
  have hηx : η ⤳ x := by
    have hh := hξz.map (f.fiberι (f x)).continuous
    rwa [Scheme.Hom.fiberι_asFiber] at hh
  by_cases hvert : ∃ ν : X, closure {ν} ∈ irreducibleComponents X ∧ η ∈ closure {ν} ∧ f ν = f x
  · -- some component through `η` has its generic point over `f x`
    obtain ⟨ν, hνcomponent, hην, hνy⟩ := hvert
    have hxν : x ∈ closure {ν} :=
      closure_minimal (Set.singleton_subset_iff.mpr hην) isClosed_closure
        (specializes_iff_mem_closure.mp hηx)
    have hνdim := hgeneric ν hνcomponent hxν
    set a : f.fiber (f x) := (f.fiberHomeo (f x)).symm ⟨ν, hνy⟩
    have hsub : (⟨ν, Set.mem_singleton_iff.mpr hνy⟩ : f ⁻¹' {f x}) ⤳
        ⟨η, Set.mem_singleton_iff.mpr hηy⟩ :=
      Topology.IsInducing.subtypeVal.specializes_iff.mp
        (specializes_iff_mem_closure.mpr hην)
    have hspec : a ⤳ ξ := by
      rw [← hb_eqξ]
      exact (f.fiberHomeo (f x)).symm.isOpenEmbedding.isInducing.specializes_iff.mpr hsub
    have hCsub : C ⊆ closure {a} := by
      rw [← hξC.def]
      exact closure_minimal (Set.singleton_subset_iff.mpr
        (specializes_iff_mem_closure.mp hspec)) isClosed_closure
    have haC : a ∈ C :=
      hC.2 isIrreducible_singleton.closure hCsub (subset_closure (Set.mem_singleton a))
    exact (hCle a haC).trans_eq
      ((fiberDimensionAt_eq_of_target_eq f ν (f x) hνy).symm.trans hνdim)
  · -- no component through `η` has its generic point over `f x`: apply Stacks 0B2K at `η`
    have : IsNoetherianRing (Y.presheaf.stalk (f η)) := by rwa [hηy]
    have hb := topologicalKrullDimAt_fiber_le_of_forall_genericPoints_ne f hηx
      (by rwa [hηy]) d hgeneric fun ⟨ν, hν, hην, hνη⟩ => hvert ⟨ν, hν, hην, hνη.trans hηy⟩
    rw [fiberDimensionAt_eq_of_target_eq f η (f x) hηy, hb_eqξ] at hb
    exact (hCle ξ hξC.mem).trans hb

/-- **Stacks Project, Tag 0B2I.** If the local ring of the target at `y` is Noetherian of
dimension at most one, and the fibre dimension at every generic point of an irreducible
component of `X` through `x` is `d`, then the fibre dimension at `x` is `d`. -/
@[stacks 0B2I, ega "IV 7.1.13"]
theorem topologicalKrullDimAt_fiber_eq_of_target_dim_le_one (f : X ⟶ Y) [LocallyOfFiniteType f]
    (x : X) (hY : IsNoetherianRing (Y.presheaf.stalk (f x)))
    (hYdim : ringKrullDim (Y.presheaf.stalk (f x)) ≤ 1) (d : ℕ)
    (hgeneric : ∀ η : X, closure {η} ∈ irreducibleComponents X → x ∈ closure {η} →
      topologicalKrullDimAt (f.fiber (f η)) (f.asFiber η) = d) :
    topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x) = d := by
  refine le_antisymm ?_ ?_
  · rw [topologicalKrullDimAt_fiber_eq_iSup f (f x) (f.asFiber x)]
    exact iSup_le fun C => iSup_le fun hC =>
      fiber_irreducibleComponent_dim_le f x hY hYdim d hgeneric C hC.1 hC.2
  · set Z : irreducibleComponents X :=
      ⟨irreducibleComponent x, irreducibleComponent_mem_irreducibleComponents x⟩
    set η : X := (genericPoints.ofComponent Z : X)
    have hηx : η ⤳ x :=
      (genericPoints.isGenericPoint_ofComponent Z).specializes mem_irreducibleComponent
    rw [← hgeneric η (genericPoints.ofComponent Z).2 (specializes_iff_mem_closure.mp hηx)]
    exact fiberDimensionAt_le_of_specializes f hηx

end AlgebraicGeometry

