      let q : R[X] := P'.g
      let m := standardEtalePairMapRingEquiv P α
      let e : B ≃+* StandardEtale.StandardEtaleAlg R p q :=
        β.symm.trans (pres.equivRing.toRingEquiv.trans
          (m.trans P'.equivAwayQuotient.toRingEquiv))
      have hcompat : ∀ r : R, β ((f.resLE V.1 U.1 hUV).appTop.hom (α.symm r)) =
          (f.appLE V U hUV).hom r := by
        intro r
        have htop : (f.resLE V.1 U.1 hUV).appTop =
            V.1.topIso.hom ≫ f.appLE V U hUV ≫ U.1.topIso.inv := by
          simp [Scheme.Hom.appTop]
        calc
          β ((f.resLE V.1 U.1 hUV).appTop.hom (α.symm r)) =
              β ((V.1.topIso.hom ≫ f.appLE V U hUV ≫ U.1.topIso.inv).hom
                (α.symm r)) := congrArg β (congrArg (fun g : R₀ ⟶ B₀ => g (α.symm r)) htop)
          _ = (f.appLE V U hUV).hom r := by
            show U.1.topIso.hom
              ((V.1.topIso.hom ≫ f.appLE V U hUV ≫ U.1.topIso.inv)
                (V.1.topIso.inv r)) = _
            simp only [CommRingCat.comp_apply, CommRingCat.hom_inv_apply]
      let : Algebra R B := (f.appLE V U hUV).hom.toAlgebra
      have hcomm : e.toRingHom.comp (f.appLE V U hUV).hom =
          StandardEtale.standardEtaleMap R p q := by
        apply RingHom.ext
        intro r
        have hr := hcompat r
        have h0 : pres.equivRing.toRingEquiv
            ((f.resLE V.1 U.1 hUV).appTop.hom (α.symm r)) =
            algebraMap R₀ P.Ring (α.symm r) := by
          show pres.equivRing (algebraMap R₀ B₀ (α.symm r)) = _
          exact pres.equivRing.commutes (α.symm r)
        have hm : m (pres.equivRing.toRingEquiv
            ((f.resLE V.1 U.1 hUV).appTop.hom (α.symm r))) =
            (algebraMap R P'.Ring) r := by
          rw [h0]
          simpa using standardEtalePairMapRingEquiv_algebraMap P α (α.symm r)
        simp only [RingHom.comp_apply]
        show e ((f.appLE V U hUV).hom r) = _
        rw [← hr]
        simp only [e, RingEquiv.trans_apply, RingEquiv.symm_apply_apply]
        rw [hm]
        calc
          P'.equivAwayQuotient ((algebraMap R P'.Ring) r) =
              algebraMap R (StandardEtale.StandardEtaleAlg R p q) r :=
            P'.equivAwayQuotient.commutes r
          _ = StandardEtale.standardEtaleMap R p q r := by
            rfl
      let φ : R[X] →+* StandardEtale.StandardEtaleAlg R p q :=
        (Ideal.Quotient.mk _).comp (algebraMap R[X] (Localization.Away q))
      have hp : φ p = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Set.mem_singleton _))
      have hq : IsUnit (φ q) :=
        (IsLocalization.Away.algebraMap_isUnit q).map (Ideal.Quotient.mk _)
      obtain ⟨a, b, n, hab⟩ := P'.cond
      have hbez : φ p.derivative * φ a = φ q ^ n := by
        have hm := congrArg φ hab
        simpa [p, q, map_add, map_mul, map_pow, hp] using hm
      have hder : IsUnit (φ p.derivative) :=
        isUnit_of_dvd_unit ⟨φ a, hbez.symm⟩ (hq.pow n)
      exact ⟨U, V, hxU, hUV, p, q, P'.monic_f, e, hcomm,
        Ideal.notMem_of_isUnit (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal (hder.map e.symm)⟩
    · rintro ⟨U, V, hxU, hUV, p, q, hp, e, hcomm, hnot⟩
      let R := Γ(S, V.1)
      let B := Γ(X, U.1)
      let : Algebra R B := (f.appLE V U hUV).hom.toAlgebra
      let L := Localization.Away q
      let I₀ : Ideal R[X] := Ideal.span {p}
      let Iₛ : Ideal L := Ideal.span {(algebraMap R[X] L) p}
      let Iᵢ : Ideal L := Ideal.map (algebraMap R[X] L) I₀
      have hI : Iᵢ = Iₛ := by
        show Ideal.map (algebraMap R[X] L) (Ideal.span {p}) = _
        rw [Ideal.map_span]
        simp [Iₛ]
      let Aᵢ := etalePresentationLocalization R p q
      let eQ : StandardEtale.StandardEtaleAlg R p q ≃ₐ[R] Aᵢ :=
        Ideal.quotientEquivAlgOfEq R hI.symm
      have hQcomm (r : R) : eQ (StandardEtale.standardEtaleMap R p q r) =
          algebraMap R Aᵢ r := by
        have hmap : StandardEtale.standardEtaleMap R p q r =
            algebraMap R (StandardEtale.StandardEtaleAlg R p q) r := rfl
        rw [hmap]
        exact eQ.commutes r
      let eAlg : B ≃ₐ[R] Aᵢ := {
        toRingEquiv := e.trans eQ.toRingEquiv
        commutes' r := by
          have hbase : e (algebraMap R B r) = StandardEtale.standardEtaleMap R p q r := by
            show e ((f.appLE V U hUV).hom r) = _
            exact congrArg
              (fun φ : R →+* StandardEtale.StandardEtaleAlg R p q => φ r) hcomm
          exact (congrArg eQ hbase).trans (hQcomm r)
      }
      let C := etalePresentationBase R p
      have : IsScalarTower R[X] C Aᵢ := by infer_instance
      let dᵢ : Aᵢ := algebraMap C Aᵢ (algebraMap R[X] C p.derivative)
      have hderQ : eQ (Ideal.Quotient.mk Iₛ ((algebraMap R[X] L) p.derivative)) = dᵢ := by
        show (Ideal.quotientEquivAlgOfEq R hI.symm)
          (Ideal.Quotient.mk Iₛ ((algebraMap R[X] L) p.derivative)) = _
        rw [Ideal.quotientEquivAlgOfEq_mk]
        show Ideal.Quotient.mk Iᵢ ((algebraMap R[X] L) p.derivative) =
          (algebraMap C Aᵢ) (algebraMap R[X] C p.derivative)
        rw [← IsScalarTower.algebraMap_apply R[X] C Aᵢ]
        rfl
      let dB : B := eAlg.symm dᵢ
      have hdB : dB = e.symm (Ideal.Quotient.mk Iₛ ((algebraMap R[X] L) p.derivative)) := by
        show (e.trans eQ.toRingEquiv).symm dᵢ = _
        rw [← hderQ]
        simp
      have hnotB : dB ∉ (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal := by
        rw [hdB]
        exact hnot
      obtain ⟨W', hWU, hxW, _, _⟩ := hbasic U V hxU hUV dB hnotB
      let B' := Γ(X, W'.1)
      let : Algebra B B' := (X.presheaf.map (homOfLE hWU).op).hom.toAlgebra
      let : Algebra R B' := (f.appLE V W' (hWU.trans hUV)).hom.toAlgebra
      let A' := Localization.Away dᵢ
      let : Algebra Aᵢ A' :=
        @OreLocalization.instAlgebra Aᵢ _ (Submonoid.powers dᵢ) _ Aᵢ _
          (Algebra.id Aᵢ)
      let : Algebra R A' :=
        @OreLocalization.instAlgebra Aᵢ _ (Submonoid.powers dᵢ) _ R _
          (inferInstance : Algebra R Aᵢ)
      have hmap : algebraMap R A' =
          (algebraMap Aᵢ A').comp (algebraMap R Aᵢ) := by
        ext r
        rfl
      have : IsScalarTower R Aᵢ A' := IsScalarTower.of_algebraMap_eq'
        (R := R) (S := Aᵢ) (A := A') hmap
      have : IsLocalization.Away dᵢ A' := by
        show IsLocalization.Away dᵢ (Localization.Away dᵢ)
        infer_instance
      have hpow : Submonoid.map eAlg (Submonoid.powers dB) = Submonoid.powers dᵢ := by
        rw [Submonoid.map_powers]
        congr 1
        simp [dB]
      let locIso : B' ≃ₐ[R] A' :=
        IsLocalization.algEquivOfAlgEquiv B' A' eAlg hpow
      have hstdA' : Algebra.IsStandardEtale R A' := by
        simpa [A', dᵢ, C, Aᵢ, etalePresentationBase, etalePresentationLocalization] using
          etalePresentationLocalization_away_derivative_isStandardEtale p q hp
      have : Algebra.IsStandardEtale R A' := hstdA'
      have : Algebra.IsStandardEtale R B' :=
        Algebra.IsStandardEtale.of_equiv locIso.symm
      have hEtAlg : Algebra.Etale R B' := by infer_instance
      exact ⟨W'.1, W'.2, hxW, V.1, V.2, hWU.trans hUV, RingHom.etale_algebraMap.mpr hEtAlg⟩
  refine List.tfae_of_forall (b := C1) ?_
  intro a ha
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
  rcases ha with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · exact Iff.rfl
  · exact h12.symm
  · exact h13.symm
  · exact h14.symm
  · exact h15.symm
  · exact h16.symm
  · exact h17.symm
  · exact h18.symm
  · exact h19.symm
  · exact h1a.symm
  · exact h1b.symm

end AlgebraicGeometry

