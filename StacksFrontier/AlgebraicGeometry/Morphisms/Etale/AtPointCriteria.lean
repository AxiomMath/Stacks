      have hcardF : Fintype.card ι = Fintype.card σ := by
        simpa [Nat.card_eq_fintype_card] using hcard
      let n := Fintype.card ι
      let eι : Fin n ≃ ι := (Fintype.equivFin ι).symm
      let eσ : Fin n ≃ σ := (Fin.castOrderIso hcardF).toEquiv.trans
