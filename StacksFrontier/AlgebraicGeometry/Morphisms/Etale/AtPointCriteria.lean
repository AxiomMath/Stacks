      let Q : Algebra.SubmersivePresentation R B (Fin n) (Fin n) := P.reindex eι eσ
      exact ⟨U, V, hxU, hUV, n, Q.toPreSubmersivePresentation,
        Ideal.notMem_of_isUnit (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal Q.jacobian_isUnit⟩
    · rintro ⟨U, V, hxU, hUV, n, P, hnot⟩
      let R := Γ(S, V.1)
      let B := Γ(X, U.1)
      let : Algebra R B := (f.appLE V U hUV).hom.toAlgebra
      obtain ⟨W', hWU, hxW, _, _⟩ := hbasic U V hxU hUV P.jacobian hnot
      let B' := Γ(X, W'.1)
      let : Algebra B B' := (X.presheaf.map (homOfLE hWU).op).hom.toAlgebra
      let : Algebra R B' := (f.appLE V W' (hWU.trans hUV)).hom.toAlgebra
      let Q : Algebra.PreSubmersivePresentation R B' (Unit ⊕ Fin n) (Unit ⊕ Fin n) :=
        (Algebra.PreSubmersivePresentation.localizationAway B' P.jacobian).comp P
      have hJ : IsUnit Q.jacobian := by
        rw [Algebra.PreSubmersivePresentation.comp_jacobian_eq_jacobian_smul_jacobian,
          Algebra.smul_def, Algebra.PreSubmersivePresentation.localizationAway_jacobian]
        have hu : IsUnit (algebraMap B B' P.jacobian) :=
          IsLocalization.Away.algebraMap_isUnit P.jacobian
        exact hu.mul hu
      let Qs : Algebra.SubmersivePresentation R B' (Unit ⊕ Fin n) (Unit ⊕ Fin n) :=
        ⟨Q, hJ⟩
      have hdim : Qs.dimension = 0 := by
        show Nat.card (Unit ⊕ Fin n) - Nat.card (Unit ⊕ Fin n) = 0
        simp
      have hStd : Algebra.IsStandardSmoothOfRelativeDimension 0 R B' := by
        have h' := Qs.isStandardSmoothOfRelativeDimension hdim
        simpa using h'
      exact h18.mpr ⟨W', V, hxW, hWU.trans hUV, hStd⟩
  have h1a : C1 ↔ C10 := by
    constructor
    · intro h
      obtain ⟨U, hU, hxU, V, hV, hUV, hEt⟩ := h
      obtain ⟨W, hW, hxW, hWV, hStd⟩ :=
        (etaleAt_iff_exists_isStandardEtale_restrict f x V hV (hUV hxU)).mp
          ⟨U, hU, hxU, V, hV, hUV, hEt⟩
      exact ⟨⟨W, hW⟩, ⟨V, hV⟩, hxW, hWV, hStd⟩
    · rintro ⟨U, V, hxU, hUV, hStd⟩
      exact (etaleAt_iff_exists_isStandardEtale_restrict
        f x V.1 V.2 (hUV hxU)).mpr ⟨U.1, U.2, hxU, hUV, hStd⟩
  have h1b : C1 ↔ C11 := by
    constructor
    · intro h
      obtain ⟨U, V, hxU, hUV, hStd⟩ := h1a.mp h
      let R := Γ(S, V.1)
      let B := Γ(X, U.1)
      let R₀ := Γ(V.1.toScheme, ⊤)
      let B₀ := Γ(U.1.toScheme, ⊤)
      let : Algebra R₀ B₀ := (f.resLE V.1 U.1 hUV).appTop.hom.toAlgebra
      change Algebra.IsStandardEtale R₀ B₀ at hStd
