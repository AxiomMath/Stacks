/-! ### Vanishing of the relative differentials at a point -/

/-- A subsingleton module is generated by the empty set, hence by at most `d` elements for any
nonnegative `d`. -/
private theorem generatedByAtMost_of_subsingleton
    {R M : Type*} [Semiring R] [AddCommMonoid M] [Module R M]
    (hM : Subsingleton M) (d : WithBot ℕ∞) (hd : 0 ≤ d) :
    GeneratedByAtMost R M d := by
  let : Subsingleton M := hM
  refine ⟨∅, ?_, ?_⟩
  · have htop : (⊤ : Submodule R M) ≤ ⊥ := by
      intro m _
      rw [Submodule.mem_bot]
      exact Subsingleton.elim m 0
    have hbot : (⊥ : Submodule R M) = ⊤ := top_unique htop
    simpa using hbot
  · simpa using hd

/-- A module generated by at most zero elements is a subsingleton. -/
theorem subsingleton_of_generatedByAtMost_zero
    {R M : Type*} [Semiring R] [AddCommMonoid M] [Module R M]
    (h : GeneratedByAtMost R M 0) : Subsingleton M := by
  obtain ⟨s, hspan, hcard⟩ := h
  have hs : s = ∅ := Finset.card_eq_zero.mp (Nat.le_zero.mp (by exact_mod_cast hcard))
  subst hs
  have hbot : (⊤ : Submodule R M) = ⊥ := by simpa using hspan.symm
  refine ⟨fun a b => ?_⟩
  have ha : a ∈ (⊥ : Submodule R M) := hbot ▸ Submodule.mem_top
  have hb : b ∈ (⊥ : Submodule R M) := hbot ▸ Submodule.mem_top
  rw [Submodule.mem_bot] at ha hb
  rw [ha, hb]

/-- **The relative differentials at a point vanish exactly when the stalk map is formally
unramified.** The stalk of the sheaf of relative differentials is the module of Kähler
differentials of the stalk map. -/
private theorem subsingleton_relativeDifferentialStalk_iff_formallyUnramified_stalkMap
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) :
    Subsingleton (relativeDifferentialStalk f x) ↔
      (f.stalkMap x).hom.FormallyUnramified := by
  classical
  let := Stacks.RelativeDifferentialStalkMap.algebraStalkMap f x
  have he := Stacks.RelativeDifferentialStalkMap.relativeDifferentialsStalkKaehlerEquiv f x
  show Subsingleton (relativeDifferentialStalk f x) ↔
    Algebra.FormallyUnramified (ToType (S.presheaf.stalk (f x)))
      (ToType (X.sheaf.presheaf.stalk x))
  rw [Algebra.formallyUnramified_iff]
  exact Equiv.subsingleton_congr he.toEquiv

/-- **The relative differentials at a point vanish exactly when their residue-field fibre
does.** Nakayama's lemma, the stalk being a finite module over the local ring. -/
private theorem subsingleton_relativeDifferentialStalk_iff_relativeCotangentSpace
    {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f] (x : X) :
    Subsingleton (relativeDifferentialStalk f x) ↔
      Subsingleton (relativeCotangentSpace f x) := by
  classical
  let := relativeDifferentialStalkModule f x
  let : Algebra ↥(X.presheaf.stalk x) ↥(X.residueField x) := (X.residue x).hom.toAlgebra
  have hfin := Stacks.RelativeDifferentialStalkMap.finite_relativeDifferentialStalk f x
  show _ ↔ Subsingleton (↥(X.residueField x) ⊗[↥(X.presheaf.stalk x)]
    relativeDifferentialStalk f x)
  exact (IsLocalRing.subsingleton_tensorProduct
    (R := ↥(X.presheaf.stalk x)) (M := relativeDifferentialStalk f x)).symm

/-- **The two residue-field fibres of the relative differentials vanish together**, through their
canonical identification. -/
private theorem subsingleton_relativeCotangentSpace_iff_fiber
    {X S : Scheme.{u}} (f : X ⟶ S) (x : X) :
    Subsingleton (relativeCotangentSpace f x) ↔
      Subsingleton (fiberRelativeCotangentSpace f x) := by
  classical
  let e := (Stacks.FiberCotangentAssembly.fiberDifferentialsTensorIdentification f x).equiv
  exact Equiv.subsingleton_congr
    (Equiv.ofBijective e.hom.hom ((ConcreteCategory.isIso_iff_bijective e.hom).mp inferInstance))

/-- **Unramifiedness at a point is formal unramifiedness of the stalk map**, read through the
vanishing of the relative differentials. -/
@[ega "IV 17.4.1" "more general", sga "3 XI 1.3" "(i)(a)⇔(c)"]
private theorem unramifiedAt_iff_subsingleton_relativeDifferentialStalk
    {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f] (x : X) :
    UnramifiedAt f x ↔ Subsingleton (relativeDifferentialStalk f x) :=
  (unramifiedAt_iff_formallyUnramified_stalkMap f x).trans
    (subsingleton_relativeDifferentialStalk_iff_formallyUnramified_stalkMap f x).symm

/-- **The scheme-theoretic fibre detects unramifiedness at a point.** The fibre is the base change
of `f` along the canonical morphism from the spectrum of the residue field of the image point. -/
@[ega "IV 17.4.1" "more general",
  ega "IV 17.8.1" "case Y = S",
  sga "1 I 5.8" "Net clause, special case"]
private theorem unramifiedAt_iff_fiber
    {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f] (x : X) :
    UnramifiedAt f x ↔
      UnramifiedAt (f.fiberToSpecResidueField (f x)) (f.asFiber x) := by
  have hsq : CategoryTheory.IsPullback (f.fiberι (f x))
      (f.fiberToSpecResidueField (f x)) f (S.fromSpecResidueField (f x)) :=
    CategoryTheory.IsPullback.of_hasPullback f (S.fromSpecResidueField (f x))
  have h := unramifiedAt_iff_of_isPullback hsq (f.asFiber x)
  rwa [show (f.fiberι (f x)).base (f.asFiber x) = x from f.fiberι_asFiber x] at h

/-- **Formal unramifiedness of the stalk map is the local criterion of the source**: the maximal
ideal of the base generates the maximal ideal of the source, and the residue field extension is
finite separable. -/
@[ega "0 21.7.4" "a ⇔ b", ega "IV 17.4.1.2" "partial"]
private theorem formallyUnramified_stalkMap_iff_residueCriterion
    {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFiniteType f] (x : X) :
    (f.stalkMap x).hom.FormallyUnramified ↔
      Ideal.map (f.stalkMap x).hom
          (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))) =
        IsLocalRing.maximalIdeal (X.presheaf.stalk x) ∧
        (letI := (f.residueFieldMap x).hom.toAlgebra
         Module.Finite (S.residueField (f x)) (X.residueField x) ∧
           Algebra.IsSeparable (S.residueField (f x)) (X.residueField x)) := by
  let A := S.presheaf.stalk (f x)
  let B := X.presheaf.stalk x
  algebraize [(f.stalkMap x).hom]
  have : IsLocalHom (algebraMap A B) :=
    inferInstanceAs (IsLocalHom (f.stalkMap x).hom)
  have : Algebra.EssFiniteType A B :=
    RingHom.essFiniteType_algebraMap.mpr (LocallyOfFiniteType.stalkMap f x)
  have h := Algebra.FormallyUnramified.iff_map_maximalIdeal_eq (R := A) (S := B)
  constructor
  · intro hu
    have h' := h.mp hu
    refine ⟨?_, ?_⟩
    · have hmax := h'.2
      change (IsLocalRing.maximalIdeal A).map (algebraMap A B) = _ at hmax
      convert hmax using 1
    · let := (f.residueFieldMap x).hom.toAlgebra
      have hsep : Algebra.IsSeparable (S.residueField (f x)) (X.residueField x) := by
        convert! h'.1
        refine Algebra.algebra_ext _ _ fun y ↦ ?_
        obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective y
        rfl
      have : Algebra.EssFiniteType (S.residueField (f x)) (X.residueField x) := by
        have : Algebra.EssFiniteType A (IsLocalRing.ResidueField B) :=
          Algebra.EssFiniteType.comp A B (IsLocalRing.ResidueField B)
        have hess : Algebra.EssFiniteType (IsLocalRing.ResidueField A)
            (IsLocalRing.ResidueField B) :=
          Algebra.EssFiniteType.of_comp A (IsLocalRing.ResidueField A)
            (IsLocalRing.ResidueField B)
        convert! hess
        refine Algebra.algebra_ext _ _ fun y ↦ ?_
        obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective y
        rfl
      have : Algebra.IsAlgebraic (S.residueField (f x)) (X.residueField x) :=
        Algebra.IsSeparable.isAlgebraic _ _
      exact ⟨Algebra.finite_of_essFiniteType_of_isAlgebraic, hsep⟩
  · rintro ⟨hmax, hres⟩
    apply h.mpr
    refine ⟨?_, ?_⟩
    · convert! hres.2
      refine Algebra.algebra_ext _ _ fun y ↦ ?_
      obtain ⟨y, rfl⟩ := IsLocalRing.residue_surjective y
      rfl
    · show (IsLocalRing.maximalIdeal A).map (algebraMap A B) = _
      convert hmax using 1

/-- **Flatness of the stalk map together with vanishing relative differentials gives smoothness at
the point.** The numerical criterion of Tag 01V9, the vanishing module being generated by the
empty set. -/
private theorem smoothAt_of_flat_of_subsingleton_relativeDifferentialStalk
    {X S : Scheme.{u}} (f : X ⟶ S) [LocallyOfFinitePresentation f]
    (x : X) (hflat : (f.stalkMap x).hom.Flat)
    (hΩ : Subsingleton (relativeDifferentialStalk f x)) :
    InfinitesimalLifting.SmoothAt f x := by
  let := relativeDifferentialStalkModule f x
  have hgen : GeneratedByAtMost (X.presheaf.stalk x) (relativeDifferentialStalk f x)
      (topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x)) :=
    generatedByAtMost_of_subsingleton hΩ _ (topologicalKrullDimAt_nonneg (f.asFiber x))
  have hcrit : (f.stalkMap x).hom.Flat ∧
      (let B := X.presheaf.stalk x
       let Ω := relativeDifferentialStalk f x
       let := relativeDifferentialStalkModule f x
       GeneratedByAtMost B Ω (topologicalKrullDimAt (f.fiber (f x)) (f.asFiber x))) :=
    ⟨hflat, hgen⟩
  exact (Stacks.Tag01V9NumericalCriterion.smoothAt_tfae f x).out 1 3 |>.mpr hcrit

/-! ### Standard étale presentations -/

/-- Mapping the defining ideal of a standard étale pair along a ring isomorphism gives the defining
ideal of the transported pair. -/
private theorem standardEtalePair_span_map
    {R R' : Type*} [CommRing R] [CommRing R'] (P : StandardEtalePair R) (e : R ≃+* R') :
    Ideal.span {Polynomial.C (P.map (e : R →+* R')).f,
        Polynomial.X * Polynomial.C (P.map (e : R →+* R')).g - 1} =
      Ideal.map ((Polynomial.mapEquiv (Polynomial.mapEquiv e) :
          Polynomial (Polynomial R) ≃+* Polynomial (Polynomial R')) :
        Polynomial (Polynomial R) →+* Polynomial (Polynomial R'))
        (Ideal.span {Polynomial.C P.f, Polynomial.X * Polynomial.C P.g - 1}) := by
  rw [Ideal.map_span]
  congr 1
  ext z
  simp [Polynomial.mapEquiv, StandardEtalePair.map]

/-- Transport of a standard étale pair along a ring isomorphism of its base. -/
private noncomputable def standardEtalePairMapRingEquiv
    {R R' : Type*} [CommRing R] [CommRing R'] (P : StandardEtalePair R)
    (e : R ≃+* R') : P.Ring ≃+* (P.map (e : R →+* R')).Ring := by
  let P' := P.map (e : R →+* R')
  let f : Polynomial (Polynomial R) ≃+* Polynomial (Polynomial R') :=
    Polynomial.mapEquiv (Polynomial.mapEquiv e)
  let I : Ideal (Polynomial (Polynomial R)) :=
    Ideal.span {Polynomial.C P.f, Polynomial.X * Polynomial.C P.g - 1}
  let J : Ideal (Polynomial (Polynomial R')) :=
    Ideal.span {Polynomial.C P'.f, Polynomial.X * Polynomial.C P'.g - 1}
  have hJ : J = Ideal.map (f : Polynomial (Polynomial R) →+* Polynomial (Polynomial R')) I := by
    exact standardEtalePair_span_map P e
  exact P.equivPolynomialQuotient.toRingEquiv.trans
    ((Ideal.quotientEquiv I J f hJ).trans P'.equivPolynomialQuotient.toRingEquiv.symm)

/-- The transport of a standard étale pair is compatible with the structure maps. -/
private theorem standardEtalePairMapRingEquiv_algebraMap
    {R R' : Type*} [CommRing R] [CommRing R'] (P : StandardEtalePair R)
    (e : R ≃+* R') (r : R) :
    standardEtalePairMapRingEquiv P e (algebraMap R P.Ring r) =
      algebraMap R' (P.map (e : R →+* R')).Ring (e r) := by
  let P' := P.map (e : R →+* R')
  let f : Polynomial (Polynomial R) ≃+* Polynomial (Polynomial R') :=
    Polynomial.mapEquiv (Polynomial.mapEquiv e)
  let I : Ideal (Polynomial (Polynomial R)) :=
    Ideal.span {Polynomial.C P.f, Polynomial.X * Polynomial.C P.g - 1}
  let J : Ideal (Polynomial (Polynomial R')) :=
    Ideal.span {Polynomial.C P'.f, Polynomial.X * Polynomial.C P'.g - 1}
  have hJ : J = Ideal.map (f : Polynomial (Polynomial R) →+* Polynomial (Polynomial R')) I := by
    exact standardEtalePair_span_map P e
  show ((P.equivPolynomialQuotient.toRingEquiv.trans
    ((Ideal.quotientEquiv I J f hJ).trans P'.equivPolynomialQuotient.toRingEquiv.symm))
      (algebraMap R P.Ring r)) = _
  rw [RingEquiv.trans_apply]
  have : IsScalarTower R R[X] (Polynomial (Polynomial R)) :=
    IsScalarTower.of_algebraMap_eq (R := R) (S := R[X])
      (A := Polynomial (Polynomial R)) (by intro r; simp)
  have hcommP : P.equivPolynomialQuotient.toRingEquiv (algebraMap R P.Ring r) =
      algebraMap R (Polynomial (Polynomial R) ⧸ I) r :=
    P.equivPolynomialQuotient.commutes r
  have hmk : @algebraMap R (Polynomial (Polynomial R) ⧸ I) _ _
      (Ideal.Quotient.algebra R (I := I)) r =
      Ideal.Quotient.mk I (Polynomial.C (Polynomial.C r)) := by
    rfl
  rw [hcommP, hmk, RingEquiv.trans_apply, Ideal.quotientEquiv_mk]
  have hcoeff : f (Polynomial.C (Polynomial.C r)) =
      Polynomial.C (Polynomial.C (e r)) := by
    simp [f, Polynomial.mapEquiv]
  rw [hcoeff]
  have hmk' : @algebraMap R' (Polynomial (Polynomial R') ⧸ J) _ _
      (Ideal.Quotient.algebra R' (I := J)) (e r) =
      Ideal.Quotient.mk J (Polynomial.C (Polynomial.C (e r))) := by
    rfl
  rw [← hmk']
  show P'.equivPolynomialQuotient.symm
      (algebraMap R' (Polynomial (Polynomial R') ⧸ J) (e r)) = _
  exact P'.equivPolynomialQuotient.symm.commutes (e r)

/-- The quotient of a one-variable polynomial ring by a single polynomial. -/
private abbrev etalePresentationBase (R : Type*) [CommRing R] (p : R[X]) :=
  R[X] ⧸ Ideal.span {p}

/-- The localization away from `q` of the quotient by `p`, as a quotient of the localization. -/
private abbrev etalePresentationLocalization (R : Type*) [CommRing R] (p q : R[X]) :=
  Localization.Away q ⧸
    Ideal.map (algebraMap R[X] (Localization.Away q)) (Ideal.span {p})

/-- **Inverting the derivative makes an explicit presentation standard étale.** For `p` monic, the
localization of `R[x]_q/(p)` away from the image of `p'` is a standard étale `R`-algebra. -/
private theorem etalePresentationLocalization_away_derivative_isStandardEtale
    {R : Type*} [CommRing R] (p q : R[X]) (hp : p.Monic) :
    let C := etalePresentationBase R p
    let B := etalePresentationLocalization R p q
    let d := algebraMap C B (algebraMap R[X] C p.derivative)
    Algebra.IsStandardEtale R (Localization.Away d) := by
  let L := Localization.Away q
  let I0 : Ideal R[X] := Ideal.span {p}
  let I : Ideal L := Ideal.map (algebraMap R[X] L) I0
  have hI : I = Ideal.span {(algebraMap R[X] L) p} := by
    show Ideal.map (algebraMap R[X] L) (Ideal.span {p}) = _
    rw [Ideal.map_span]
    simp
  let B := L ⧸ I
  have : IsScalarTower R R[X] B :=
    IsScalarTower.of_algebraMap_eq (R := R) (S := R[X]) (A := B) (by intro r; rfl)
  let C := R[X] ⧸ I0
  let : Algebra R[X] C := (Ideal.Quotient.mk I0).toAlgebra
  let : IsScalarTower R R[X] C := by infer_instance
  let : Algebra C B := Ideal.Quotient.algebraQuotientMapQuotient
  have : IsScalarTower R[X] C B :=
    IsScalarTower.of_algebraMap_eq (R := R[X]) (S := C) (A := B) (by intro a; rfl)
  have hloc := IsLocalization.instQuotientIdealAlgebraMapSubmonoidMapRingHomAlgebraMap
      (M := Submonoid.powers q) (S := L) I0
  have : IsLocalization (Algebra.algebraMapSubmonoid C (Submonoid.powers q)) B := hloc
  let q₀ : C := algebraMap R[X] C q
  let a₀ : C := algebraMap R[X] C p.derivative
  let d : B := algebraMap C B a₀
  let B' := Localization.Away d
  let : Algebra B B' := inferInstance
  have : IsScalarTower C B B' := by infer_instance
  have : IsScalarTower R C B' :=
    IsScalarTower.of_algebraMap_eq (R := R) (S := C) (A := B') (by intro r; rfl)
  have : IsLocalization.Away q₀ B := by
    convert (inferInstance : IsLocalization (Algebra.algebraMapSubmonoid C
      (Submonoid.powers q)) B) using 1
    rw [Algebra.algebraMapSubmonoid, Submonoid.map_powers]
  have : IsLocalization.Away (algebraMap C B a₀) B' := by infer_instance
  have : IsLocalization.Away (a₀ * q₀) B' := IsLocalization.Away.mul B B' q₀ a₀
  let L₂ := Localization.Away (q * p.derivative)
  let I₂ : Ideal L₂ := Ideal.map (algebraMap R[X] L₂) I0
  have hI₂ : I₂ = Ideal.span {(algebraMap R[X] L₂) p} := by
    show Ideal.map (algebraMap R[X] L₂) (Ideal.span {p}) = _
    rw [Ideal.map_span]
    simp
  let A₂ := L₂ ⧸ I₂
  let : Algebra C A₂ := Ideal.Quotient.algebraQuotientMapQuotient
  have : IsScalarTower R[X] C A₂ := by infer_instance
  have : IsScalarTower R C A₂ :=
    IsScalarTower.of_algebraMap_eq (R := R) (S := C) (A := A₂) (by intro r; rfl)
  have hloc₂ := IsLocalization.instQuotientIdealAlgebraMapSubmonoidMapRingHomAlgebraMap
      (M := Submonoid.powers (q * p.derivative)) (S := L₂) I0
  have : IsLocalization (Algebra.algebraMapSubmonoid C
      (Submonoid.powers (q * p.derivative))) A₂ := hloc₂
  have : IsLocalization.Away (a₀ * q₀) A₂ := by
    convert (inferInstance : IsLocalization (Algebra.algebraMapSubmonoid C
      (Submonoid.powers (q * p.derivative))) A₂) using 1
    rw [Algebra.algebraMapSubmonoid, Submonoid.map_powers]
    simp [q₀, a₀, map_mul, mul_comm]
  have locIso : B' ≃ₐ[C] A₂ := IsLocalization.algEquiv
    (Submonoid.powers (a₀ * q₀)) B' A₂
  let P : StandardEtalePair R := ⟨p, hp, q * p.derivative, q, 0, 1, by
    simp [mul_comm]⟩
  let eA₂ : A₂ ≃ₐ[R] StandardEtale.StandardEtaleAlg R p (q * p.derivative) :=
    Ideal.quotientEquivAlgOfEq R hI₂
  let e : B' ≃ₐ[R] P.Ring :=
    (locIso.restrictScalars R).trans (eA₂.trans P.equivAwayQuotient.symm)
  have hstd : Algebra.IsStandardEtale R B' := Algebra.IsStandardEtale.of_equiv e.symm
  show Algebra.IsStandardEtale R (Localization.Away d)
  exact hstd

/-! ### The criteria -/

/-- **Stacks Project, Tag 02GU.** Ten equivalent criteria for a morphism of schemes locally of
finite presentation to be étale at a point. -/
@[stacks 02GU, sga "4½ Arcata 2.1.1" "b) <=> c)"]
public theorem etaleAt_tfae {X S : Scheme.{u}} (f : X ⟶ S)
    [LocallyOfFinitePresentation f] (x : X) :
    List.TFAE [
      EtaleAt f x,
      (f.stalkMap x).hom.Flat ∧
        EtaleAt (f.fiberToSpecResidueField (f x)) (f.asFiber x),
      (f.stalkMap x).hom.Flat ∧
        UnramifiedAt (f.fiberToSpecResidueField (f x)) (f.asFiber x),
      (f.stalkMap x).hom.Flat ∧
        Subsingleton (relativeDifferentialStalk f x),
      (f.stalkMap x).hom.Flat ∧
        Subsingleton (fiberRelativeCotangentSpace f x),
      (f.stalkMap x).hom.Flat ∧
        Subsingleton (relativeCotangentSpace f x),
      (f.stalkMap x).hom.Flat ∧
        (Ideal.map (f.stalkMap x).hom
            (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))) =
          IsLocalRing.maximalIdeal (X.presheaf.stalk x) ∧
          (letI := (f.residueFieldMap x).hom.toAlgebra
           Module.Finite (S.residueField (f x)) (X.residueField x) ∧
             Algebra.IsSeparable (S.residueField (f x)) (X.residueField x))),
      ∃ (U : X.affineOpens) (V : S.affineOpens) (_ : x ∈ U.1)
          (hUV : U.1 ≤ f ⁻¹ᵁ V.1),
        letI : Algebra Γ(S, V.1) Γ(X, U.1) :=
          (f.appLE V U hUV).hom.toAlgebra
        Algebra.IsStandardSmoothOfRelativeDimension 0 Γ(S, V.1) Γ(X, U.1),
      ∃ (U : X.affineOpens) (V : S.affineOpens) (hxU : x ∈ U.1)
          (hUV : U.1 ≤ f ⁻¹ᵁ V.1),
        letI : Algebra Γ(S, V.1) Γ(X, U.1) :=
          (f.appLE V U hUV).hom.toAlgebra
        ∃ (n : ℕ) (P : Algebra.PreSubmersivePresentation
            Γ(S, V.1) Γ(X, U.1) (Fin n) (Fin n)),
          P.jacobian ∉ (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal,
      ∃ (U : X.affineOpens) (V : S.affineOpens) (_ : x ∈ U.1)
          (hUV : U.1 ≤ f ⁻¹ᵁ V.1),
        IsStandardEtale (f.resLE V.1 U.1 hUV),
      ∃ (U : X.affineOpens) (V : S.affineOpens) (hxU : x ∈ U.1)
          (hUV : U.1 ≤ f ⁻¹ᵁ V.1)
          (p q : Γ(S, V.1)[X]),
        p.Monic ∧
          ∃ e : Γ(X, U.1) ≃+* StandardEtale.StandardEtaleAlg Γ(S, V.1) p q,
            e.toRingHom.comp (f.appLE V U hUV).hom =
              StandardEtale.standardEtaleMap Γ(S, V.1) p q ∧
            e.symm ((Ideal.Quotient.mk
              (Ideal.span {(algebraMap Γ(S, V.1)[X]
                (Localization.Away q)) p}))
              ((algebraMap Γ(S, V.1)[X] (Localization.Away q))
                (derivative p))) ∉
              (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal] := by
  let C1 := EtaleAt f x
  let C2 := (f.stalkMap x).hom.Flat ∧
    EtaleAt (f.fiberToSpecResidueField (f x)) (f.asFiber x)
  let C3 := (f.stalkMap x).hom.Flat ∧
    UnramifiedAt (f.fiberToSpecResidueField (f x)) (f.asFiber x)
  let C4 := (f.stalkMap x).hom.Flat ∧
    Subsingleton (relativeDifferentialStalk f x)
  let C5 := (f.stalkMap x).hom.Flat ∧
    Subsingleton (fiberRelativeCotangentSpace f x)
  let C6 := (f.stalkMap x).hom.Flat ∧
    Subsingleton (relativeCotangentSpace f x)
  let C7 := (f.stalkMap x).hom.Flat ∧
    (Ideal.map (f.stalkMap x).hom
        (IsLocalRing.maximalIdeal (S.presheaf.stalk (f x))) =
      IsLocalRing.maximalIdeal (X.presheaf.stalk x) ∧
      (let := (f.residueFieldMap x).hom.toAlgebra
       Module.Finite (S.residueField (f x)) (X.residueField x) ∧
         Algebra.IsSeparable (S.residueField (f x)) (X.residueField x)))
  let C8 := ∃ (U : X.affineOpens) (V : S.affineOpens) (_ : x ∈ U.1)
      (hUV : U.1 ≤ f ⁻¹ᵁ V.1),
    let : Algebra Γ(S, V.1) Γ(X, U.1) := (f.appLE V U hUV).hom.toAlgebra
    Algebra.IsStandardSmoothOfRelativeDimension 0 Γ(S, V.1) Γ(X, U.1)
  let C9 := ∃ (U : X.affineOpens) (V : S.affineOpens) (hxU : x ∈ U.1)
      (hUV : U.1 ≤ f ⁻¹ᵁ V.1),
    let : Algebra Γ(S, V.1) Γ(X, U.1) := (f.appLE V U hUV).hom.toAlgebra
    ∃ (n : ℕ) (P : Algebra.PreSubmersivePresentation
        Γ(S, V.1) Γ(X, U.1) (Fin n) (Fin n)),
      P.jacobian ∉ (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal
  let C10 := ∃ (U : X.affineOpens) (V : S.affineOpens) (_ : x ∈ U.1)
      (hUV : U.1 ≤ f ⁻¹ᵁ V.1),
    IsStandardEtale (f.resLE V.1 U.1 hUV)
  let C11 := ∃ (U : X.affineOpens) (V : S.affineOpens) (hxU : x ∈ U.1)
      (hUV : U.1 ≤ f ⁻¹ᵁ V.1)
      (p q : Γ(S, V.1)[X]),
    p.Monic ∧
      ∃ e : Γ(X, U.1) ≃+* StandardEtale.StandardEtaleAlg Γ(S, V.1) p q,
        e.toRingHom.comp (f.appLE V U hUV).hom =
            StandardEtale.standardEtaleMap Γ(S, V.1) p q ∧
          e.symm ((Ideal.Quotient.mk
            (Ideal.span {(algebraMap Γ(S, V.1)[X]
              (Localization.Away q)) p}))
            ((algebraMap Γ(S, V.1)[X] (Localization.Away q))
              (derivative p))) ∉
            (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal
  show List.TFAE [C1, C2, C3, C4, C5, C6, C7, C8, C9, C10, C11]
  let hSmooth := Stacks.Tag01V9NumericalCriterion.smoothAt_tfae f x
  let hEtale := etaleAt_iff_smoothAt_and_unramifiedAt f x
  let hEtaleFiber := etaleAt_iff_smoothAt_and_unramifiedAt
    (f.fiberToSpecResidueField (f x)) (f.asFiber x)
  have hUnramFiber := unramifiedAt_iff_fiber f x
  have hUnramOmega := unramifiedAt_iff_subsingleton_relativeDifferentialStalk f x
  -- Étaleness at `x` is flatness together with unramifiedness at `x`.
  have hCrit {P : Prop} (hu : UnramifiedAt f x ↔ P) :
      C1 ↔ (f.stalkMap x).hom.Flat ∧ P := by
    constructor
    · intro h
      have hs := (hSmooth.out 1 2).mp (hEtale.mp h).1
      exact ⟨hs.1, hu.mp (hEtale.mp h).2⟩
    · rintro ⟨hflat, hp⟩
      exact hEtale.mpr
        ⟨smoothAt_of_flat_of_subsingleton_relativeDifferentialStalk f x hflat
          (hUnramOmega.mp (hu.mpr hp)),
          hu.mpr hp⟩
  have h12 : C1 ↔ C2 := by
    constructor
    · intro h
      have hs := (hSmooth.out 1 2).mp (hEtale.mp h).1
      exact ⟨hs.1, hEtaleFiber.mpr ⟨hs.2, hUnramFiber.mp (hEtale.mp h).2⟩⟩
    · rintro ⟨hflat, hFiber⟩
      have hs := hEtaleFiber.mp hFiber
      have hcrit : (f.stalkMap x).hom.Flat ∧
          InfinitesimalLifting.SmoothAt (f.fiberToSpecResidueField (f x))
            (f.asFiber x) := ⟨hflat, hs.1⟩
      exact hEtale.mpr ⟨(hSmooth.out 1 2).mpr hcrit, hUnramFiber.mpr hs.2⟩
  have h13 : C1 ↔ C3 := hCrit hUnramFiber
  have h14 : C1 ↔ C4 := hCrit hUnramOmega
  have h16 : C1 ↔ C6 := hCrit (hUnramOmega.trans
    (subsingleton_relativeDifferentialStalk_iff_relativeCotangentSpace f x))
  have h15 : C1 ↔ C5 := hCrit (hUnramOmega.trans
    ((subsingleton_relativeDifferentialStalk_iff_relativeCotangentSpace f x).trans
      (subsingleton_relativeCotangentSpace_iff_fiber f x)))
  have h17 : C1 ↔ C7 := hCrit ((unramifiedAt_iff_formallyUnramified_stalkMap f x).trans
    (formallyUnramified_stalkMap_iff_residueCriterion f x))
  have h18 : C1 ↔ C8 := by
    constructor
    · rintro ⟨U, hU, hxU, V, hV, hUV, hEt⟩
      let U' : X.affineOpens := ⟨U, hU⟩
      let V' : S.affineOpens := ⟨V, hV⟩
      let : Algebra Γ(S, V'.1) Γ(X, U'.1) :=
        (f.appLE V' U' hUV).hom.toAlgebra
      have hEtAlg : Algebra.Etale Γ(S, V'.1) Γ(X, U'.1) :=
        RingHom.etale_algebraMap.mp hEt
      exact ⟨U', V', hxU, hUV,
        (Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero).mp hEtAlg⟩
    · rintro ⟨U, V, hxU, hUV, hStd⟩
      let : Algebra Γ(S, V.1) Γ(X, U.1) := (f.appLE V U hUV).hom.toAlgebra
      have hEtAlg : Algebra.Etale Γ(S, V.1) Γ(X, U.1) :=
        (Algebra.Etale.iff_isStandardSmoothOfRelativeDimension_zero).mpr hStd
      exact ⟨U.1, U.2, hxU, V.1, V.2, hUV, RingHom.etale_algebraMap.mpr hEtAlg⟩
  -- Shrinking an affine open to the basic open of a function not vanishing at `x`.
  have hbasic (U : X.affineOpens) (V : S.affineOpens) (hxU : x ∈ U.1) (hUV : U.1 ≤ f ⁻¹ᵁ V.1)
      (g : Γ(X, U.1)) (hg : g ∉ (U.2.primeIdealOf ⟨x, hxU⟩).asIdeal) :
      ∃ (W : X.affineOpens) (hWU : W.1 ≤ U.1) (_ : x ∈ W.1),
        letI : Algebra Γ(S, V.1) Γ(X, U.1) := (f.appLE V U hUV).hom.toAlgebra
        letI : Algebra Γ(X, U.1) Γ(X, W.1) := (X.presheaf.map (homOfLE hWU).op).hom.toAlgebra
        letI : Algebra Γ(S, V.1) Γ(X, W.1) := (f.appLE V W (hWU.trans hUV)).hom.toAlgebra
        IsLocalization.Away g Γ(X, W.1) ∧ IsScalarTower Γ(S, V.1) Γ(X, U.1) Γ(X, W.1) := by
    have hpre : U.2.primeIdealOf ⟨x, hxU⟩ ∈ U.2.fromSpec ⁻¹ᵁ X.basicOpen g := by
      rw [U.2.fromSpec_preimage_basicOpen]
      exact hg
    have hx' : U.2.fromSpec (U.2.primeIdealOf ⟨x, hxU⟩) ∈ X.basicOpen g := hpre
    refine ⟨⟨X.basicOpen g, U.2.basicOpen g⟩, X.basicOpen_le _,
      by simpa [U.2.fromSpec_primeIdealOf] using hx', ?_⟩
    let : Algebra Γ(S, V.1) Γ(X, U.1) := (f.appLE V U hUV).hom.toAlgebra
    let : Algebra Γ(X, U.1) Γ(X, X.basicOpen g) :=
      (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom.toAlgebra
    let : Algebra Γ(S, V.1) Γ(X, X.basicOpen g) :=
      (f.appLE V (X.basicOpen g) ((X.basicOpen_le g).trans hUV)).hom.toAlgebra
    refine ⟨by simpa using U.2.isLocalization_basicOpen g, ?_⟩
    exact IsScalarTower.of_algebraMap_eq fun a =>
      (congrArg (fun φ : Γ(S, V.1) ⟶ Γ(X, X.basicOpen g) => φ.hom a)
        (Scheme.Hom.appLE_map (f := f) (U := V.1) (V := U.1) hUV
          (homOfLE (X.basicOpen_le g)).op)).symm
  have h19 : C1 ↔ C9 := by
    constructor
    · intro h
      obtain ⟨U, V, hxU, hUV, hStd⟩ := h18.mp h
      let R := Γ(S, V.1)
      let B := Γ(X, U.1)
      let : Algebra R B := (f.appLE V U hUV).hom.toAlgebra
      obtain ⟨ι, σ, hσ, hι, P, hPdim⟩ := hStd.out
      let : Finite σ := hσ
      let : Finite ι := hι
      let : Fintype σ := Fintype.ofFinite σ
      let : Fintype ι := Fintype.ofFinite ι
      have hle : Nat.card σ ≤ Nat.card ι :=
        P.toPreSubmersivePresentation.card_relations_le_card_vars_of_isFinite
      have hdim : P.dimension = 0 := hPdim
      have hcard : Nat.card ι = Nat.card σ :=
