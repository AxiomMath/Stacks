module

public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.LinearAlgebra.Matrix.Rank
public import Mathlib.RingTheory.LocalRing.ResidueField.Ideal

/-!
# A polynomial presentation with full-rank Jacobian at a prime

Fix a prime of a polynomial ring containing a finitely generated ideal. The Jacobian of the
chosen generators has full column rank over the residue field of that prime. This file packages
that situation, together with the affine scheme it cuts out and the canonical morphisms and
point attached to it, so that the étaleness, flatness and unramifiedness statements of the
source lemma can all be phrased against the same data.

## Main definitions

* `AlgebraicGeometry.FullRankJacobianSituation` packages the equations, the prime, and the
  full-rank hypothesis.
* `AlgebraicGeometry.FullRankJacobianSituation.equationIdeal` is the ideal generated by the
  equations.
* `AlgebraicGeometry.FullRankJacobianSituation.zeroScheme` is the closed subscheme cut out by
  the equations.
* `AlgebraicGeometry.FullRankJacobianSituation.inclusion`,
  `AlgebraicGeometry.FullRankJacobianSituation.point` and
  `AlgebraicGeometry.FullRankJacobianSituation.over` give the canonical immersion, the
  corresponding point, and the structure morphism.

## Main results

There are no results beyond the definitions.

## Implementation notes

The polynomial variables and the equations are indexed by `Fin n` and `Fin m`. The rank
condition is imposed after applying the canonical map to the residue field of the prime, so it
is a statement about a matrix over a field and `Matrix.rank` is the usual one. The point and the
structure morphism are canonically determined by the standing data, rather than by additional
choices: the point is the image of the prime under the quotient map, which is again prime
because the equations lie in it.

## References

* [Stacks Project, Tag 024Y](https://stacks.math.columbia.edu/tag/024Y)
-/

@[expose] public section

universe u

noncomputable section

namespace AlgebraicGeometry

/-- A polynomial quotient with a specified prime at which the Jacobian of its equations has rank
equal to the number of variables. -/
public structure FullRankJacobianSituation (R : Type u) [CommRing R] (n m : ℕ) where
  /-- The equations cutting out the affine subscheme. -/
  equations : Fin m → MvPolynomial (Fin n) R
  /-- A prime of the ambient polynomial ring. -/
  prime : Ideal (MvPolynomial (Fin n) R)
  /-- The selected ideal is prime. -/
  prime_isPrime : prime.IsPrime
  /-- All equations vanish at the selected prime. -/
  equations_mem_prime : ∀ i, equations i ∈ prime
  /-- The Jacobian has full column rank at the selected prime. -/
  jacobian_rank :
    letI : prime.IsPrime := prime_isPrime
    (Matrix.of fun (i : Fin m) (j : Fin n) =>
      algebraMap (MvPolynomial (Fin n) R) prime.ResidueField
        (MvPolynomial.pderiv j (equations i))).rank = n

namespace FullRankJacobianSituation

variable {R : Type u} [CommRing R] {n m : ℕ}

/-- The ideal generated by the defining equations. -/
public def equationIdeal (S : FullRankJacobianSituation R n m) :
    Ideal (MvPolynomial (Fin n) R) :=
  Ideal.span (Set.range S.equations)

/-- The closed subscheme of affine space cut out by the equations. -/
public abbrev zeroScheme (S : FullRankJacobianSituation R n m) : Scheme.{u} :=
  Spec (.of (MvPolynomial (Fin n) R ⧸ S.equationIdeal))

/-- The canonical immersion into affine `n`-space, represented here by the polynomial spectrum
identified with affine space over `Spec R`. -/
public def inclusion (S : FullRankJacobianSituation R n m) :
    S.zeroScheme ⟶ Spec (.of (MvPolynomial (Fin n) R)) :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk S.equationIdeal))

/-- The point of the quotient scheme corresponding to the selected prime. -/
public def point (S : FullRankJacobianSituation R n m) : S.zeroScheme := by
  letI : S.prime.IsPrime := S.prime_isPrime
  let h : S.equationIdeal ≤ S.prime :=
    Ideal.span_le.mpr (Set.range_subset_iff.mpr S.equations_mem_prime)
  exact ⟨S.prime.map (Ideal.Quotient.mk S.equationIdeal),
    Ideal.isPrime_map_quotientMk_of_isPrime h⟩

/-- The canonical morphism from the polynomial quotient to the base. -/
public def over (S : FullRankJacobianSituation R n m) :
    S.zeroScheme ⟶ Spec (.of R) :=
  Spec.map (CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin n) R ⧸ S.equationIdeal)))

end FullRankJacobianSituation

end AlgebraicGeometry

end
