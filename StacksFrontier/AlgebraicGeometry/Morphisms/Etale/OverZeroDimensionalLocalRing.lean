/-!
# Quasi-finite algebras and étale schemes over a zero-dimensional local ring

A local ring of Krull dimension zero is henselian, so a quasi-finite algebra of finite type over
it splits as a finite part and a part whose fibre over the maximal ideal vanishes. The maximal
ideal of such a ring is its nilradical, which forces the second part to be the zero ring: a
quasi-finite algebra of finite type over a local ring of dimension zero is therefore a finite
module. Geometrically, an affine scheme étale over the spectrum of such a ring is finite over it.

## Main results

* `Module.Finite.of_quasiFinite_of_krullDimLE_zero`: a quasi-finite algebra of finite type over
  a local ring of Krull dimension zero is a finite module.
* `AlgebraicGeometry.isFinite_of_isAffine_of_etale_over_krullDimLE_zero`: an affine scheme étale
  over the spectrum of a local ring of Krull dimension zero is finite over it.

## Implementation notes

The splitting is item (13) of Stacks 04GG, carried by
`HenselianLocalRing.TFAE_factorization_etale_quasiFinite`, which is available because a local
ring of Krull dimension zero is henselian
(`henselianLocalRing_of_krullDimLE_zero`, Stacks 06RS). Its second factor `B` has subsingleton
fibre `κ ⊗_A B` over the maximal ideal, and `κ ⊗_A B` is the quotient of `B` by the ideal
generated by the maximal ideal (`Algebra.TensorProduct.quotIdealMapEquivQuotTensor`); since the
maximal ideal of a local ring of dimension zero consists of nilpotents, that ideal is contained in
the nilradical of `B`, so its being the unit ideal makes `1 : B` nilpotent and `B` the zero ring.

The geometric statement is reduced to the algebraic one through the global sections of the source,
exactly as `AlgebraicGeometry.isFinite_of_isAffine_of_etale_over_field` is for a field base; the
algebra structure on the global sections is the one induced by the structure morphism.

## References

* [Stacks Project, Tag 04GG](https://stacks.math.columbia.edu/tag/04GG)
* [Stacks Project, Tag 06RS](https://stacks.math.columbia.edu/tag/06RS)
-/

@[expose] public section

open CategoryTheory TensorProduct

universe u

/-! ### Quasi-finite algebras over a local ring of dimension zero -/

/-- A commutative ring in which the unit element is nilpotent is trivial. -/
private theorem subsingleton_of_isNilpotent_one (B : Type*) [CommRing B]
    (h : IsNilpotent (1 : B)) : Subsingleton B := by
  obtain ⟨n, hn⟩ := h
  rw [one_pow] at hn
  exact subsingleton_of_zero_eq_one hn.symm

/-- An algebra over a local ring of Krull dimension zero whose fibre over the maximal ideal is
subsingleton is itself the zero ring: the maximal ideal consists of nilpotents, so the ideal it
generates lies in the nilradical, and that ideal being everything makes `1` nilpotent. -/
private theorem subsingleton_of_subsingleton_residueFieldTensor (A : Type u) [CommRing A]
    [IsLocalRing A] [Ring.KrullDimLE 0 A] (B : Type u) [CommRing B] [Algebra A B]
    (h : Subsingleton (IsLocalRing.ResidueField A ⊗[A] B)) : Subsingleton B := by
  have hmap : (IsLocalRing.maximalIdeal A).map (algebraMap A B) ≤ nilradical B := by
    rw [Ideal.map_le_iff_le_comap, ← Ring.KrullDimLE.nilradical_eq_maximalIdeal]
    exact fun x hx ↦ IsNilpotent.map hx _
  have htop : (IsLocalRing.maximalIdeal A).map (algebraMap A B) = ⊤ := by
    have hq : Subsingleton (B ⧸ (IsLocalRing.maximalIdeal A).map (algebraMap A B)) :=
      (Algebra.TensorProduct.quotIdealMapEquivQuotTensor B
        (IsLocalRing.maximalIdeal A)).toEquiv.subsingleton_congr.2 h
    exact Ideal.Quotient.subsingleton_iff.1 hq
  exact subsingleton_of_isNilpotent_one B (hmap ((Ideal.eq_top_iff_one _).1 htop))

/-- A quasi-finite algebra of finite type over a local ring of Krull dimension zero is a finite
module. Compare `Module.Finite.of_quasiFinite`, which assumes the base artinian. -/
theorem Module.Finite.of_quasiFinite_of_krullDimLE_zero (A : Type u) [CommRing A] [IsLocalRing A]
    [Ring.KrullDimLE 0 A] (S : Type u) [CommRing S] [Algebra A S] [Algebra.FiniteType A S]
    [Algebra.QuasiFinite A S] : Module.Finite A S := by
  have _ : HenselianLocalRing A := henselianLocalRing_of_krullDimLE_zero A
  obtain ⟨A', B', _, _, _, _, e, hA', hB'⟩ :=
    ((HenselianLocalRing.TFAE_factorization_etale_quasiFinite A).out 1 13 rfl rfl).1
      ‹HenselianLocalRing A› S ‹Algebra.FiniteType A S› ‹Algebra.QuasiFinite A S›
  have _ : Subsingleton B' := subsingleton_of_subsingleton_residueFieldTensor A B' hB'
  have _ : Module.Finite A A' := hA'
  have _ : Module.Finite A B' :=
    Module.Finite.of_surjective (Algebra.linearMap A B') fun b ↦ ⟨0, Subsingleton.elim _ _⟩
  exact Module.Finite.of_surjective e.symm.toLinearMap e.symm.surjective

/-! ### Affine schemes étale over a zero-dimensional local ring -/

namespace AlgebraicGeometry

variable (A : Type u) [CommRing A] {X : Scheme.{u}} (f : X ⟶ Spec (.of A))

/-- The algebra structure on the global sections of a scheme over the spectrum of a commutative
ring, induced by the structure morphism through the identification of the ring with the global
sections of its spectrum. -/
private noncomputable abbrev sectionsAlgebraOfSpecHom : Algebra A Γ(X, ⊤) :=
  ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom.toAlgebra

/-- The global sections of an affine scheme étale over the spectrum of a commutative ring form an
étale algebra over that ring. -/
private theorem algebra_etale_sections [IsAffine X] [Etale f] :
    letI := sectionsAlgebraOfSpecHom A f
    Algebra.Etale A Γ(X, ⊤) := by
  let := sectionsAlgebraOfSpecHom A f
  have happ : RingHom.Etale f.appTop.hom :=
    (HasRingHomProperty.iff_of_isAffine (P := @Etale)).mp inferInstance
  have hφ : RingHom.Etale ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop).hom :=
    (RingHom.Etale.respectsIso.cancel_left_isIso (Scheme.ΓSpecIso (.of A)).inv f.appTop).2 happ
  rw [← RingHom.etale_algebraMap]
  exact hφ

/-- **An affine scheme étale over the spectrum of a local ring of Krull dimension zero is finite
over it.** The global sections form an étale, hence quasi-finite, algebra over the ring, and over
a local ring of dimension zero such an algebra is a finite module. -/
theorem isFinite_of_isAffine_of_etale_over_krullDimLE_zero [IsLocalRing A] [Ring.KrullDimLE 0 A]
    [IsAffine X] [Etale f] : IsFinite f := by
  let := sectionsAlgebraOfSpecHom A f
  let : Algebra.Etale A Γ(X, ⊤) := algebra_etale_sections A f
  have hmod : Module.Finite A Γ(X, ⊤) := Module.Finite.of_quasiFinite_of_krullDimLE_zero A Γ(X, ⊤)
  have hspec : IsFinite (Spec.map ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop)) :=
    (IsFinite.SpecMap_iff _).2 (RingHom.finite_algebraMap.2 hmod)
  have hf : X.isoSpec.hom ≫ Spec.map ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop) = f := by
    calc
      X.isoSpec.hom ≫ Spec.map ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop) =
          X.isoSpec.hom ≫ Spec.map f.appTop ≫ Spec.map (Scheme.ΓSpecIso (.of A)).inv := by
        rw [Spec.map_comp]
      _ = (f ≫ (Spec (.of A)).isoSpec.hom) ≫ Spec.map (Scheme.ΓSpecIso (.of A)).inv := by
        rw [← Category.assoc, Scheme.isoSpec_hom_naturality f]
      _ = f := by
        show (f ≫ (Spec (.of A)).toSpecΓ) ≫ Spec.map (Scheme.ΓSpecIso (.of A)).inv = f
        rw [Category.assoc, toSpecΓ_SpecMap_ΓSpecIso_inv, Category.comp_id]
  have : IsFinite (X.isoSpec.hom ≫ Spec.map ((Scheme.ΓSpecIso (.of A)).inv ≫ f.appTop)) :=
    inferInstance
  rwa [hf] at this

end AlgebraicGeometry

end
