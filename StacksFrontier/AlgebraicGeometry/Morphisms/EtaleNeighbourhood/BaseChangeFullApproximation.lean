module

public import StacksFrontier.AlgebraicGeometry.Morphisms.EtaleNeighbourhood.BaseChangeJointApproximation
public import StacksFrontier.AlgebraicGeometry.Morphisms.EtaleNeighbourhood.BaseChangeTruncationBridge

/-!
# The point of `Y_σ` over `y`, and the structure morphism of `Y_σ` over `S`

Stacks Tag 0CAW is handed a morphism `σ : 𝒪_{T, t} → 𝒪^∧_{S, s}` of `𝒪_{S, s}`-algebras, the
base change `Y_σ = Y ×_{T, σ} Spec 𝒪^∧_{S, s}` of `g : Y ⟶ T` along the morphism `b` that `σ`
determines, and "the unique point `y_σ` of `Y_σ` lying over `y`". This file establishes the two
facts about that point and that base change which the tag's hypotheses leave implicit.

The first is that lying over `y` already forces `y_σ` to lie over the closed point of
`Spec 𝒪^∧_{S, s}`. Since `σ` is a map of `𝒪_{S, s}`-algebras and `𝒪_{S, s} → 𝒪_{T, t}` is local,
the maximal ideal of `𝒪^∧_{S, s}` — which is generated by the image of `𝔪_s` — is carried into
the prime of `y_σ`, and a prime containing the maximal ideal of a local ring is that ideal. So
the fibre of `Y_σ` over `y` meets only the closed fibre, which is why the source can speak of
*the* point over `y`.

The second is the identification of the two ways `Y_σ` is a scheme over `S`: through
`Y_σ → Y → T → S` and through `Y_σ → Spec 𝒪^∧_{S, s} → Spec 𝒪_{S, s} → S`. They agree, by the
pullback square together with the hypothesis that `σ` is a map of `𝒪_{S, s}`-algebras, and the
agreement is what identifies the two readings of the statement that the map
`φ : 𝒪_{X, x} → 𝒪^∧_{Y_σ, y_σ}` of the tag is a map of `𝒪_{S, s}`-algebras.

## Main results

* `StacksDraft.ArtinApproximation.snd_eq_closedPoint_of_fst_eq`: a point of `Y_σ` over `y` lies
  over the closed point of `Spec 𝒪^∧_{S, s}`.
* `StacksDraft.ArtinApproximation.specMapSigma_comp_eq`: the morphism
  `b : Spec 𝒪^∧_{S, s} ⟶ T` followed by `T ⟶ S` is the canonical morphism
  `Spec 𝒪^∧_{S, s} ⟶ Spec 𝒪_{S, s} ⟶ S`.
* `StacksDraft.ArtinApproximation.pullback_fst_comp_eq`: the same, read on `Y_σ`.
* `StacksDraft.ArtinApproximation.stalkHomAt_pullback_fst_comp`: the resulting identity of the
  two maps `𝒪_{S, s} → 𝒪_{Y_σ, y_σ}`.
* `StacksDraft.ArtinApproximation.maximalIdeal_pow_le_comap_stalkHomAt`: the map of local rings
  of a morphism of schemes descends to the truncations at `𝔪 ^ N`.

## References

* [Stacks Project, Tag 0CAW](https://stacks.math.columbia.edu/tag/0CAW)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry IsLocalRing

universe u

namespace StacksDraft.ArtinApproximation

/-- **The map of local rings of a morphism of schemes descends to the truncations.** It carries
the `N`-th power of the maximal ideal of the local ring at the image point into the `N`-th power
of the maximal ideal of the local ring at the point. -/
theorem maximalIdeal_pow_le_comap_stalkHomAt {A B : Scheme.{u}} {a : A} {b : B}
    (m : A ⟶ B) (hm : m a = b) (N : ℕ) :
    maximalIdeal (B.presheaf.stalk b) ^ N ≤
      Ideal.comap (m.stalkHomAt hm) (maximalIdeal (A.presheaf.stalk a) ^ N) := by
  rw [← Ideal.map_le_iff_le_comap, Ideal.map_pow]
  exact Ideal.pow_right_mono (IsLocalRing.map_maximalIdeal_le _) N

/-- **A point of the completed base change lying over `y` lies over the closed point.** Let
`h : T ⟶ S` carry `t` to `s` on a locally Noetherian `S`, let `g : Y ⟶ T` carry `y` to `t`, and
let `σ : 𝒪_{T, t} → 𝒪^∧_{S, s}` be a homomorphism of `𝒪_{S, s}`-algebras, giving
`b : Spec 𝒪^∧_{S, s} ⟶ T` through `Spec 𝒪_{T, t} ⟶ T`. Then every point `y_σ` of
`Y_σ = Y ×_{T, b} Spec 𝒪^∧_{S, s}` lying over `y` lies over the closed point of
`Spec 𝒪^∧_{S, s}`.

This is why Stacks Tag 0CAW can speak of *the* point of `Y_σ` over `y`: the fibre of `Y_σ` over
`y` meets only the closed fibre. It also discharges the hypothesis `hvσ` of
`StacksDraft.ArtinApproximation.exists_truncationEquiv_stalk_relativeBaseChange` and of
`StacksDraft.ArtinApproximation.exists_elementaryEtaleNeighborhood_algebraization`, both of which
ask for it separately.

The pullback square puts `b y_σ` at `t`, and `T.fromSpecStalk t` is injective, so the prime
`𝔮 = (pullback.snd g b y_σ).asIdeal` of `𝒪^∧_{S, s}` has `σ ⁻¹ 𝔮 = 𝔪_t`. Being a map of
`𝒪_{S, s}`-algebras, `σ` carries `𝔪_s` — which lands in `𝔪_t` because `𝒪_{S, s} → 𝒪_{T, t}` is
local — into `𝔮`, so `𝔮` contains the ideal generated by the image of `𝔪_s`, which is the
maximal ideal of `𝒪^∧_{S, s}`. A prime containing the maximal ideal of a local ring is it. -/
theorem snd_eq_closedPoint_of_fst_eq
    {S T Y : Scheme.{u}} [IsLocallyNoetherian S] (h : T ⟶ S) (g : Y ⟶ T)
    {s : S} {t : T} {y : Y} (hy : g y = t) (ht : h t = s)
    (σ : T.presheaf.stalk t →+*
      AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s))
    (hσbase : σ.comp (h.stalkHomAt ht) =
      algebraMap (S.presheaf.stalk s)
        (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s)))
    (b : Spec (CommRingCat.of (AdicCompletion (maximalIdeal (S.presheaf.stalk s))
      (S.presheaf.stalk s))) ⟶ T)
    (hb : b = Spec.map (CommRingCat.ofHom σ) ≫ T.fromSpecStalk t)
    (yσ : (pullback g b : Scheme.{u})) (hyσ : pullback.fst g b yσ = y) :
    pullback.snd g b yσ =
      IsLocalRing.closedPoint
        (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s)) := by
  -- The pullback square puts the image of `yσ` in the base above `t`.
  have hbt : b (pullback.snd g b yσ) = t := by
    have hc := congrArg (fun ψ : (pullback g b : Scheme.{u}) ⟶ T => ψ yσ)
      (pullback.condition (f := g) (g := b))
    simp only [Scheme.Hom.comp_apply] at hc
    rw [← hc, hyσ]
    exact hy
  -- `T.fromSpecStalk t` is injective, so the image in `Spec 𝒪_{T, t}` is its closed point.
  have hq : Spec.map (CommRingCat.ofHom σ) (pullback.snd g b yσ) =
      IsLocalRing.closedPoint (T.presheaf.stalk t) := by
    refine (T.fromSpecStalk t).isEmbedding.injective ?_
    rw [Scheme.fromSpecStalk_closedPoint]
    have hbt' : (Spec.map (CommRingCat.ofHom σ) ≫ T.fromSpecStalk t)
        (pullback.snd g b yσ) = t := by
      rw [← hb]; exact hbt
    simpa only [Scheme.Hom.comp_apply] using hbt'
  -- Read that as an equation of ideals.
  have hcomap : Ideal.comap σ (pullback.snd g b yσ).asIdeal =
      maximalIdeal (T.presheaf.stalk t) := congrArg PrimeSpectrum.asIdeal hq
  -- The maximal ideal of the completion is generated by `𝔪_s`, which `σ` carries into the prime
  -- of `yσ` because `σ` is a map of `𝒪_{S, s}`-algebras.
  have hmaxle : maximalIdeal
        (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s)) ≤
      (pullback.snd g b yσ).asIdeal := by
    rw [AdicCompletion.maximalIdeal_eq_map, Ideal.map_le_iff_le_comap]
    intro a ha
    have h1 : h.stalkHomAt ht a ∈ maximalIdeal (T.presheaf.stalk t) := by
      rw [← IsLocalRing.maximalIdeal_comap (h.stalkHomAt ht)] at ha
      exact ha
    rw [← hcomap] at h1
    have h3 : algebraMap (S.presheaf.stalk s)
        (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s)) a =
        σ (h.stalkHomAt ht a) := (RingHom.congr_fun hσbase a).symm
    rw [Ideal.mem_comap, h3]
    exact h1
  refine PrimeSpectrum.ext ?_
  exact ((maximalIdeal.isMaximal _).eq_of_le
    (pullback.snd g b yσ).isPrime.ne_top hmaxle).symm

/-- **The morphism `Spec 𝒪^∧_{S, s} ⟶ T` of Stacks Tag 0CAW, followed by `T ⟶ S`, is the
canonical morphism `Spec 𝒪^∧_{S, s} ⟶ Spec 𝒪_{S, s} ⟶ S`.** This is the hypothesis that `σ` is
a map of `𝒪_{S, s}`-algebras, read as an identity of morphisms of schemes. -/
theorem specMapSigma_comp_eq {S T : Scheme.{u}} (hT : T ⟶ S) {s : S} {t : T} (ht : hT t = s)
    (σ : T.presheaf.stalk t →+*
      AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s))
    (hσbase : σ.comp (hT.stalkHomAt ht) =
      algebraMap (S.presheaf.stalk s)
        (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s)))
    (b : Spec (CommRingCat.of (AdicCompletion (maximalIdeal (S.presheaf.stalk s))
      (S.presheaf.stalk s))) ⟶ T)
    (hb : b = Spec.map (CommRingCat.ofHom σ) ≫ T.fromSpecStalk t) :
    b ≫ hT =
      Spec.map (CommRingCat.ofHom (algebraMap (S.presheaf.stalk s)
        (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s)))) ≫
        S.fromSpecStalk s := by
  subst ht
  have key : T.fromSpecStalk t ≫ hT =
      Spec.map (CommRingCat.ofHom (hT.stalkHomAt (rfl : hT t = hT t))) ≫
        S.fromSpecStalk (hT t) := by
    have h1 : hT.stalkHomAt (rfl : hT t = hT t) = (hT.stalkMap t).hom := by
      simp [Scheme.Hom.stalkHomAt]
    rw [h1, CommRingCat.ofHom_hom]
    exact (Scheme.SpecMap_stalkMap_fromSpecStalk hT).symm
  rw [hb, Category.assoc, key, ← Category.assoc, ← Spec.map_comp, ← CommRingCat.ofHom_comp,
    hσbase]

/-- **The structure morphism of `Y_σ` over `S` factors through `Spec 𝒪^∧_{S, s}`.** The two ways
`Y_σ = Y ×_{T, σ} Spec 𝒪^∧_{S, s}` is a scheme over `S` — through `Y ⟶ T ⟶ S` and through
`Spec 𝒪^∧_{S, s} ⟶ Spec 𝒪_{S, s} ⟶ S` — agree. -/
theorem pullback_fst_comp_eq {S T Y : Scheme.{u}} (hT : T ⟶ S) (g : Y ⟶ T) {s : S} {t : T}
    (ht : hT t = s)
    (σ : T.presheaf.stalk t →+*
      AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s))
    (hσbase : σ.comp (hT.stalkHomAt ht) =
      algebraMap (S.presheaf.stalk s)
        (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s)))
    (b : Spec (CommRingCat.of (AdicCompletion (maximalIdeal (S.presheaf.stalk s))
      (S.presheaf.stalk s))) ⟶ T)
    (hb : b = Spec.map (CommRingCat.ofHom σ) ≫ T.fromSpecStalk t) :
    pullback.fst g b ≫ g ≫ hT =
      pullback.snd g b ≫
        Spec.map (CommRingCat.ofHom (algebraMap (S.presheaf.stalk s)
          (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s)))) ≫
          S.fromSpecStalk s := by
  rw [← Category.assoc, pullback.condition, Category.assoc,
    specMapSigma_comp_eq hT ht σ hσbase b hb]

/-- **The two maps `𝒪_{S, s} → 𝒪_{Y_σ, y_σ}` agree.** The `𝒪_{S, s}`-algebra structure of the
local ring of `Y_σ` at `y_σ` read through `Y_σ → Y → T → S` is the one read through
`Y_σ → Spec 𝒪^∧_{S, s}` and the completion map. This identifies the two readings of the
statement, in Stacks Tag 0CAW, that `φ : 𝒪_{X, x} → 𝒪^∧_{Y_σ, y_σ}` is a map of
`𝒪_{S, s}`-algebras. -/
theorem stalkHomAt_pullback_fst_comp {S T Y : Scheme.{u}} [IsLocallyNoetherian S]
    (hT : T ⟶ S) (g : Y ⟶ T) {s : S} {t : T}
    (ht : hT t = s)
    (σ : T.presheaf.stalk t →+*
      AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s))
    (hσbase : σ.comp (hT.stalkHomAt ht) =
      algebraMap (S.presheaf.stalk s)
        (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s)))
    (b : Spec (CommRingCat.of (AdicCompletion (maximalIdeal (S.presheaf.stalk s))
      (S.presheaf.stalk s))) ⟶ T)
    (hb : b = Spec.map (CommRingCat.ofHom σ) ≫ T.fromSpecStalk t)
    {y : Y} (hy : g y = t) (yσ : (pullback g b : Scheme.{u}))
    (hyσ : pullback.fst g b yσ = y)
    (hvσ : pullback.snd g b yσ =
      closedPoint (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s))) :
    (pullback.fst g b ≫ g ≫ hT).stalkHomAt
        (show (pullback.fst g b ≫ g ≫ hT) yσ = s by
          change hT (g (pullback.fst g b yσ)) = s; rw [hyσ, hy, ht]) =
      ((pullback.snd g b).stalkHomAt hvσ).comp
        ((stalkClosedPointIso (CommRingCat.of
            (AdicCompletion (maximalIdeal (S.presheaf.stalk s))
              (S.presheaf.stalk s)))).inv.hom.comp
          (algebraMap (S.presheaf.stalk s)
            (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s)))) := by
  have hloc : IsLocalHom (CommRingCat.ofHom (algebraMap (S.presheaf.stalk s)
      (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s)))).hom :=
    show IsLocalHom (algebraMap (S.presheaf.stalk s)
      (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s))) from
      inferInstance
  have hc : (Spec.map (CommRingCat.ofHom (algebraMap (S.presheaf.stalk s)
        (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s)))) ≫
      S.fromSpecStalk s)
      (closedPoint (AdicCompletion (maximalIdeal (S.presheaf.stalk s))
        (S.presheaf.stalk s))) = s := by
    change S.fromSpecStalk s ((Spec.map (CommRingCat.ofHom (algebraMap (S.presheaf.stalk s)
      (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s)))))
        (closedPoint _)) = s
    rw [Spec_closedPoint, Scheme.fromSpecStalk_closedPoint]
  have hcongr : ∀ {X Z : Scheme.{u}} {x : X} {z : Z} (m m' : X ⟶ Z), m = m' →
      ∀ (h : m x = z) (h' : m' x = z), m.stalkHomAt h = m'.stalkHomAt h' := by
    intro X Z x z m m' hmm' h h'
    subst hmm'
    rfl
  rw [hcongr _ _ (pullback_fst_comp_eq hT g ht σ hσbase b hb) _
      (show (pullback.snd g b ≫
          Spec.map (CommRingCat.ofHom (algebraMap (S.presheaf.stalk s)
            (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s)))) ≫
            S.fromSpecStalk s) yσ = s by
        change (Spec.map (CommRingCat.ofHom (algebraMap (S.presheaf.stalk s)
          (AdicCompletion (maximalIdeal (S.presheaf.stalk s)) (S.presheaf.stalk s)))) ≫
            S.fromSpecStalk s) (pullback.snd g b yσ) = s
        rw [hvσ]
        exact hc),
    Scheme.Hom.stalkHomAt_comp (pullback.snd g b) _ hvσ hc,
    stalkHomAt_specMap_fromSpecStalk _ hloc hc, CommRingCat.hom_ofHom]

end StacksDraft.ArtinApproximation

end
