module

public import StacksFrontier.AlgebraicGeometry.Morphisms.DescentLocus.ChartLocus
public import StacksFrontier.AlgebraicGeometry.Morphisms.DescentLocus.ChartSections
public import StacksFrontier.AlgebraicGeometry.Perfect.ProperFlatGlobalSectionsKernelModel
public import StacksFrontier.AlgebraicGeometry.Modules.FreeMapIsoLocus
public import StacksFrontier.AlgebraicGeometry.Morphisms.DescentLocusChartAlgebra
public import StacksFrontier.AlgebraicGeometry.FiniteLocallyFree.RankFromBasis

/-!
# The chart of a kernel model

Let `A` be a Noetherian ring, `f₀ : X₀ ⟶ Spec A` proper and `F` a coherent `𝒪_{X₀}`-module flat
over `A`. A *kernel model* (`KernelModelData`) is an element `g ∈ A`, a `β × r` matrix `D` over
`A` and, for every `A`-algebra `B` in which `g` is invertible and every base change `X'` of `X₀`
to `B`, a `B`-linear identification of `Γ(X', F')` with the kernel of `D ⊗ B`, natural in `B`.
Such data exists near every prime by
`Stacks.AlgebraicGeometry.ProperFlatGlobalSections.exists_away_kernelModel`.

From a kernel model this file builds the closed subscheme `Y = Spec (A ⧸ I)_g` cut out by the
entries of `D` inside `D(g)`, the `r` universal sections `σᵢ` of `F` over `X₀ ×_A Y`, and the open
`Z ⊆ Y` over which `σ` trivialises `F` on every fibre (`KernelModelData.chart`). The two halves of
the characterising property of `Z` are `KernelModelData.nonempty_iso_free_of_exists_lift` (a base
change factoring through `Z` along which `F` has rank `r` makes `F` free) and
`KernelModelData.exists_lift_of_iso_free` (a base change to `Spec B` along which `F` is free of
rank `r` factors through `Z`).

## Main definitions

* `AlgebraicGeometry.DescentLocus.KernelModelData`: the data of a kernel model.
* `AlgebraicGeometry.DescentLocus.KernelModelData.chart`: the immersion `Z ⟶ Spec A`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry.DescentLocus

variable {A : Type u} [CommRing A] {X₀ : Scheme.{u}} (f₀ : X₀ ⟶ Spec (.of A)) (F : X₀.Modules)

/-- The image of a vector of the kernel of `D ⊗ B` under a further ring map lies in the kernel of
`D ⊗ B'`. -/
theorem map_mem_ker_mulVecLin {β r : ℕ} (D : Matrix (Fin β) (Fin r) A) {B B' : Type u}
    [CommRing B] [CommRing B'] (φ : A →+* B) (ψ : B →+* B')
    (v : LinearMap.ker (Matrix.mulVecLin (D.map φ))) :
    ψ ∘ (v : Fin r → B) ∈ LinearMap.ker (Matrix.mulVecLin (D.map (ψ.comp φ))) := by
  have hv := v.2
  rw [LinearMap.mem_ker, Matrix.mulVecLin_apply] at hv ⊢
  funext i
  have h := RingHom.map_mulVec ψ (D.map φ) (v : Fin r → B) i
  rw [hv, Pi.zero_apply, map_zero, Matrix.map_map] at h
  exact h.symm

/-- A **kernel model** of `F` over `D(g)`. -/
structure KernelModelData where
  /-- The element to invert. -/
  g : A
  /-- The number of columns. -/
  r : ℕ
  /-- The number of rows. -/
  β : ℕ
  /-- The matrix. -/
  D : Matrix (Fin β) (Fin r) A
  /-- The identification of global sections. -/
  Φ : ∀ {B : Type u} [CommRing B] (φ : A →+* B) (_ : IsUnit (φ g)) {X' : Scheme.{u}}
      {f' : X' ⟶ Spec (.of B)} {g' : X' ⟶ X₀}
      (_ : IsPullback g' f' f₀ (Spec.map (CommRingCat.ofHom φ))),
      letI := Stacks.Cech.sectionsModule f' ((Scheme.Modules.pullback g').obj F) ⊤
      LinearMap.ker (Matrix.mulVecLin (D.map φ)) ≃ₗ[B] Γ((Scheme.Modules.pullback g').obj F, ⊤)
  /-- Its naturality. -/
  nat : ∀ {B B' : Type u} [CommRing B] [CommRing B'] (φ : A →+* B) (ψ : B →+* B')
      (hg : IsUnit (φ g)) {X' X'' : Scheme.{u}} {f' : X' ⟶ Spec (.of B)}
      {f'' : X'' ⟶ Spec (.of B')} {g' : X' ⟶ X₀} {g'' : X'' ⟶ X'}
      (hsq : IsPullback g' f' f₀ (Spec.map (CommRingCat.ofHom φ)))
      (hsq' : IsPullback g'' f'' f' (Spec.map (CommRingCat.ofHom ψ)))
      (v : LinearMap.ker (Matrix.mulVecLin (D.map φ))),
      ((Scheme.Modules.pullbackComp g'' g').hom.app F).app ⊤
          (AlgebraicGeometry.pullbackSectionHom g'' ((Scheme.Modules.pullback g').obj F) ⊤ ⊤
            (by simp) (Φ φ hg hsq v)) =
        Φ (ψ.comp φ) (hg.map ψ)
          (Stacks.Cech.isPullback_comp_specMap φ ψ f₀ f' f'' g' g'' hsq hsq')
          ⟨ψ ∘ (v : Fin r → B), map_mem_ker_mulVecLin D φ ψ v⟩

/-- A kernel model with `g ∉ p` and entries in `p` exists at every prime `p`. -/
theorem exists_kernelModelData [IsNoetherianRing A] [IsProper f₀] [F.IsCoherent]
    (hflat : IsFlatOver f₀.toLRSHom.toShHom F) (p : Ideal A) [p.IsPrime] :
    ∃ M : KernelModelData f₀ F, M.g ∉ p ∧ ∀ i j, M.D i j ∈ p := by
  obtain ⟨g, hg, r, β, D, hD, Φ, nat⟩ :=
    Stacks.AlgebraicGeometry.ProperFlatGlobalSections.exists_away_kernelModel f₀ F hflat p
  exact ⟨⟨g, r, β, D, Φ, nat⟩, hg, hD⟩

namespace KernelModelData

variable {f₀ F} (M : KernelModelData f₀ F)

/-- The ideal generated by the entries of the matrix. -/
def ideal : Ideal A := Ideal.span (Set.range fun ij : Fin M.β × Fin M.r ↦ M.D ij.1 ij.2)

theorem ideal_fg : M.ideal.FG :=
  ⟨(Set.finite_range (fun ij : Fin M.β × Fin M.r ↦ M.D ij.1 ij.2)).toFinset, by simp [ideal]⟩

/-- A ring map kills the ideal of entries exactly when it kills every entry. -/
theorem map_eq_zero_of_mem_ideal {B : Type u} [CommRing B] (φ : A →+* B)
    (h : ∀ i j, φ (M.D i j) = 0) : ∀ a ∈ M.ideal, φ a = 0 := by
  intro a ha
  have : M.ideal ≤ RingHom.ker φ := by
    rw [ideal, Ideal.span_le]
    rintro _ ⟨ij, rfl⟩
    exact h ij.1 ij.2
  exact this ha

/-- Every vector is in the kernel of `D ⊗ B` when `D` maps to zero. -/
theorem mem_ker_of_map_eq_zero {B : Type u} [CommRing B] (φ : A →+* B)
    (h : ∀ i j, φ (M.D i j) = 0) (v : Fin M.r → B) :
    v ∈ LinearMap.ker (Matrix.mulVecLin (M.D.map φ)) := by
  have : M.D.map φ = 0 := by ext i j; simp [h i j]
  simp [this]

/-- The kernel of `D ⊗ B` is everything when `D` maps to zero. -/
private theorem ker_mulVecLin_map_eq_top {B : Type u} [CommRing B] (φ : A →+* B)
    (h : ∀ i j, φ (M.D i j) = 0) : LinearMap.ker (Matrix.mulVecLin (M.D.map φ)) = ⊤ :=
  eq_top_iff.2 fun v _ ↦ M.mem_ker_of_map_eq_zero φ h v

/-- **Dimension of the sections over a field.** -/
theorem finrank_sections_eq {K : Type u} [Field K] (φ : A →+* K) (hg : IsUnit (φ M.g))
    {X' : Scheme.{u}} {f' : X' ⟶ Spec (.of K)} {g' : X' ⟶ X₀}
    (H : IsPullback g' f' f₀ (Spec.map (CommRingCat.ofHom φ))) :
    @Module.finrank K Γ((Scheme.Modules.pullback g').obj F, ⊤) _ _
        (Stacks.Cech.sectionsModule f' ((Scheme.Modules.pullback g').obj F) ⊤) =
      Module.finrank K (LinearMap.ker (Matrix.mulVecLin (M.D.map φ))) := by
  let := Stacks.Cech.sectionsModule f' ((Scheme.Modules.pullback g').obj F) ⊤
  exact (M.Φ φ hg H).finrank_eq.symm

theorem finrank_sections_le {K : Type u} [Field K] (φ : A →+* K) (hg : IsUnit (φ M.g))
    {X' : Scheme.{u}} {f' : X' ⟶ Spec (.of K)} {g' : X' ⟶ X₀}
    (H : IsPullback g' f' f₀ (Spec.map (CommRingCat.ofHom φ))) :
    @Module.finrank K Γ((Scheme.Modules.pullback g').obj F, ⊤) _ _
        (Stacks.Cech.sectionsModule f' ((Scheme.Modules.pullback g').obj F) ⊤) ≤ M.r := by
  rw [M.finrank_sections_eq φ hg H]
  exact (Submodule.finrank_le _).trans (by simp)

theorem finrank_sections_eq_r {K : Type u} [Field K] (φ : A →+* K) (hg : IsUnit (φ M.g))
    (h : ∀ i j, φ (M.D i j) = 0)
    {X' : Scheme.{u}} {f' : X' ⟶ Spec (.of K)} {g' : X' ⟶ X₀}
    (H : IsPullback g' f' f₀ (Spec.map (CommRingCat.ofHom φ))) :
    @Module.finrank K Γ((Scheme.Modules.pullback g').obj F, ⊤) _ _
        (Stacks.Cech.sectionsModule f' ((Scheme.Modules.pullback g').obj F) ⊤) = M.r := by
  rw [M.finrank_sections_eq φ hg H]
  rw [M.ker_mulVecLin_map_eq_top φ h, finrank_top]
  simp

/-- **Congruence for `Φ`.** Equal ring maps and equal comparison maps give the same identification,
up to the transport of sections along the equality of the pullbacks. -/
theorem Φ_congr {B : Type u} [CommRing B] {φ₁ φ₂ : A →+* B} (hφ : φ₁ = φ₂)
    (hg₁ : IsUnit (φ₁ M.g)) (hg₂ : IsUnit (φ₂ M.g)) {X' : Scheme.{u}}
    {f' : X' ⟶ Spec (.of B)} {g₁ g₂ : X' ⟶ X₀} (hgg : g₁ = g₂)
    (H₁ : IsPullback g₁ f' f₀ (Spec.map (CommRingCat.ofHom φ₁)))
    (H₂ : IsPullback g₂ f' f₀ (Spec.map (CommRingCat.ofHom φ₂)))
    (v : LinearMap.ker (Matrix.mulVecLin (M.D.map φ₁))) :
    ((Scheme.Modules.pullbackCongr hgg).hom.app F).app ⊤ (M.Φ φ₁ hg₁ H₁ v) =
      M.Φ φ₂ hg₂ H₂ ⟨(v : Fin M.r → B), hφ ▸ v.2⟩ := by
  subst hφ hgg
  simp [Scheme.Modules.pullbackCongr]

/-! ### The chart -/

/-- The ring `(A ⧸ I)_g`, `I` the ideal of entries of `D`. -/
abbrev Rring : Type u := chartRing M.g M.ideal

/-- The closed subscheme `Y` of `D(g)` cut out by the entries of `D`, as a map to `Spec A`. -/
abbrev ιY : Spec (.of M.Rring) ⟶ Spec (.of A) := chartSpecMap M.g M.ideal

theorem D_map_chartRingHom (i : Fin M.β) (j : Fin M.r) :
    chartRingHom M.g M.ideal (M.D i j) = 0 :=
  chartRingHom_eq_zero _ _ (Ideal.subset_span ⟨(i, j), rfl⟩)

/-- The universal sections over `X₀ ×_A Y`. -/
def secY (i : Fin M.r) : Γ((Scheme.Modules.pullback (pullback.fst f₀ M.ιY)).obj F, ⊤) :=
  M.Φ (chartRingHom M.g M.ideal) (isUnit_chartRingHom _ _) (IsPullback.of_hasPullback f₀ M.ιY)
    ⟨Pi.single i 1, M.mem_ker_of_map_eq_zero _ M.D_map_chartRingHom _⟩

/-- The morphism `𝒪^r ⟶ F_Y` given by the universal sections. -/
def σ : Scheme.Modules.free (pullback f₀ M.ιY) (ULift.{u} (Fin M.r)) ⟶
    (Scheme.Modules.pullback (pullback.fst f₀ M.ιY)).obj F :=
  Scheme.Modules.freeHomOfSections _ M.secY

variable [F.IsFiniteType]

instance : ((Scheme.Modules.pullback (pullback.fst f₀ M.ιY)).obj F).IsFiniteType :=
  SheafOfModules.pullback_isFiniteType (pullback.fst f₀ M.ιY).toLRSHom.toShHom F

/-- The open of `X₀ ×_A Y` over which `σ` is an isomorphism (on rank `r` base changes). -/
def isoOpen : (pullback f₀ M.ιY).Opens :=
  Classical.choose (Scheme.Modules.exists_isoLocus _ M.σ)

theorem isoOpen_spec {T : Scheme.{u}} (h : T ⟶ pullback f₀ M.ιY)
    (hr : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback h).obj ((Scheme.Modules.pullback (pullback.fst f₀ M.ιY)).obj F))
        M.r) :
    IsIso ((Scheme.Modules.pullback h).map M.σ) ↔ Set.range h ⊆ M.isoOpen :=
  Classical.choose_spec (Scheme.Modules.exists_isoLocus _ M.σ) h hr

variable [IsProper f₀]

/-- **The chart**: the open of `Y` over which `σ` is an isomorphism on every fibre, over
`Spec A`. -/
def chart : Over (Spec (.of A)) := chartOver (pullback.snd f₀ M.ιY) M.isoOpen M.ιY

instance : IsImmersion M.chart.hom := by
  dsimp only [chart]; infer_instance

theorem finitePresentation_chart [IsNoetherianRing A] : FinitePresentation M.chart.hom :=
  finitePresentation_chartOver_hom _ _ _ (finitePresentation_chartSpecMap _ _ M.ideal_fg)

/-- The comparison map from a base change of `X₀` over a morphism factoring through `Y`. -/
def liftY {X' T : Scheme.{u}} {q : X' ⟶ X₀} {p' : X' ⟶ T} {t : T ⟶ Spec (.of A)}
    (H : IsPullback q p' f₀ t) (l : T ⟶ Spec (.of M.Rring)) (hl : l ≫ M.ιY = t) :
    X' ⟶ pullback f₀ M.ιY :=
  pullback.lift q (p' ≫ l) (by rw [Category.assoc, hl, H.w])

omit [SheafOfModules.IsFiniteType F] [IsProper f₀] in
@[reassoc (attr := simp)]
theorem liftY_fst {X' T : Scheme.{u}} {q : X' ⟶ X₀} {p' : X' ⟶ T} {t : T ⟶ Spec (.of A)}
    (H : IsPullback q p' f₀ t) (l : T ⟶ Spec (.of M.Rring)) (hl : l ≫ M.ιY = t) :
    M.liftY H l hl ≫ pullback.fst f₀ M.ιY = q :=
  pullback.lift_fst _ _ _

omit [SheafOfModules.IsFiniteType F] [IsProper f₀] in
theorem isPullback_liftY {X' T : Scheme.{u}} {q : X' ⟶ X₀} {p' : X' ⟶ T} {t : T ⟶ Spec (.of A)}
    (H : IsPullback q p' f₀ t) (l : T ⟶ Spec (.of M.Rring)) (hl : l ≫ M.ιY = t) :
    IsPullback (M.liftY H l hl) p' (pullback.snd f₀ M.ιY) l := by
  refine IsPullback.of_right ?_ (pullback.lift_snd _ _ _) (IsPullback.of_hasPullback f₀ M.ιY)
  rw [liftY_fst, hl]
  exact H

/-- The pullback of `F_Y` along `liftY` is the pullback of `F`. -/
def liftYIso {X' T : Scheme.{u}} {q : X' ⟶ X₀} {p' : X' ⟶ T} {t : T ⟶ Spec (.of A)}
    (H : IsPullback q p' f₀ t) (l : T ⟶ Spec (.of M.Rring)) (hl : l ≫ M.ιY = t) :
    (Scheme.Modules.pullback (M.liftY H l hl)).obj
        ((Scheme.Modules.pullback (pullback.fst f₀ M.ιY)).obj F) ≅
      (Scheme.Modules.pullback q).obj F :=
  (Scheme.Modules.pullbackComp _ _).app F ≪≫
    (Scheme.Modules.pullbackCongr (M.liftY_fst H l hl)).app F

/-- **A base change factoring through the chart, along which `F` has rank `r`, makes `F` free of
rank `r`.** -/
theorem nonempty_iso_free_of_exists_lift {X' T : Scheme.{u}} {q : X' ⟶ X₀} {p' : X' ⟶ T}
    {t : T ⟶ Spec (.of A)} (H : IsPullback q p' f₀ t)
    (hr : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback q).obj F) M.r)
    (hl : ∃ m : T ⟶ M.chart.left, m ≫ M.chart.hom = t) :
    Nonempty ((Scheme.Modules.pullback q).obj F ≅ SheafOfModules.free (ULift.{u} (Fin M.r))) := by
  obtain ⟨l, hl, hrange⟩ := (exists_lift_chartOver_iff (pullback.snd f₀ M.ιY) M.isoOpen M.ιY t).1 hl
  have hrange' : Set.range (M.liftY H l hl) ⊆ M.isoOpen :=
    (range_subset_iff_of_isPullback _ _ (M.isPullback_liftY H l hl)).2 hrange
  have hr' := AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso
    (M.liftYIso H l hl).symm hr
  have hiso : IsIso ((Scheme.Modules.pullback (M.liftY H l hl)).map M.σ) :=
    (M.isoOpen_spec _ hr').2 hrange'
  exact ⟨(M.liftYIso H l hl).symm ≪≫
    (asIso ((Scheme.Modules.pullback (M.liftY H l hl)).map M.σ)).symm ≪≫
    schemeModulesPullbackObjFreeIso _ _⟩

omit [SheafOfModules.IsFiniteType F] [IsProper f₀] in
/-- **Over a base along which `F` is free of rank `r`, `D` vanishes.** If the structure maps of
`X'` and of all its base changes are bijective on global functions and `F` pulls back to a free
module of rank `r`, then every entry of `D` maps to zero in `B`: the free basis of the sections
stays a basis on every fibre, so it gives a residuewise basis of the kernel of `D ⊗ B`. -/
theorem map_D_eq_zero {B : Type u} [CommRing B] (φ : A →+* B) (hg : IsUnit (φ M.g))
    {X' : Scheme.{u}} {f' : X' ⟶ Spec (.of B)} {q : X' ⟶ X₀}
    (H : IsPullback q f' f₀ (Spec.map (CommRingCat.ofHom φ)))
    (hp0 : Function.Bijective (Stacks.Cech.globalRingHom f').hom)
    (hp : ∀ {B' : Type u} [CommRing B'] (ψ : B →+* B'),
      Function.Bijective
        (Stacks.Cech.globalRingHom (pullback.snd f' (Spec.map (CommRingCat.ofHom ψ)))).hom)
    (e : (Scheme.Modules.pullback q).obj F ≅ SheafOfModules.free (ULift.{u} (Fin M.r))) :
    ∀ i j, φ (M.D i j) = 0 := by
  let := Stacks.Cech.sectionsModule f' ((Scheme.Modules.pullback q).obj F) ⊤
  let bΓ : Module.Basis (Fin M.r) Γ(X', ⊤) Γ((Scheme.Modules.pullback q).obj F, ⊤) :=
    (freeSectionsBasis X' M.r).map (sectionsLinearEquivOfIso e ⊤).symm
  let bB := basisOverBase f' hp0 _ bΓ
  let b : Fin M.r → Fin M.r → B := fun j ↦ ((M.Φ φ hg H).symm (bB j) : Fin M.r → B)
  have hb : ∀ j, Matrix.mulVec (M.D.map φ) (b j) = 0 := fun j ↦ by
    have := ((M.Φ φ hg H).symm (bB j)).2
    rwa [LinearMap.mem_ker, Matrix.mulVecLin_apply] at this
  have hzero := Matrix.eq_zero_of_mulVec_eq_zero_of_linearIndependent_residueField
    (M.D.map φ) b hb (fun Q _ ↦ ?_)
  · intro i j
    simpa using congrFun (congrFun hzero i) j
  -- the residuewise linear independence
  let ψ := algebraMap B Q.ResidueField
  let hsq' := IsPullback.of_hasPullback f' (Spec.map (CommRingCat.ofHom ψ))
  let g'' := pullback.fst f' (Spec.map (CommRingCat.ofHom ψ))
  let f'' := pullback.snd f' (Spec.map (CommRingCat.ofHom ψ))
  let H' := Stacks.Cech.isPullback_comp_specMap φ ψ f₀ f' f'' q g'' H hsq'
  let := Stacks.Cech.sectionsModule f'' ((Scheme.Modules.pullback (g'' ≫ q)).obj F) ⊤
  let Φ' := M.Φ (ψ.comp φ) (hg.map ψ) H'
  let W : Scheme.Modules.free (pullback f' (Spec.map (CommRingCat.ofHom ψ))) (ULift.{u} (Fin M.r)) ≅
      (Scheme.Modules.pullback (g'' ≫ q)).obj F :=
    (schemeModulesPullbackObjFreeIso g'' _).symm ≪≫
      (Scheme.Modules.pullback g'').mapIso e.symm ≪≫ (Scheme.Modules.pullbackComp g'' q).app F
  let bκ := basisOverBase f'' (hp ψ) _
    ((freeSectionsBasis _ M.r).map (sectionsLinearEquivOfIso W ⊤))
  have key : ∀ j, Φ' ⟨ψ ∘ b j, map_mem_ker_mulVecLin M.D φ ψ _⟩ = bκ j := by
    intro j
    rw [← M.nat φ ψ hg H hsq' ((M.Φ φ hg H).symm (bB j)), LinearEquiv.apply_symm_apply]
    simp only [bκ, coe_basisOverBase, Module.Basis.map_apply, bB, bΓ]
    change ((Scheme.Modules.pullbackComp g'' q).hom.app F).app ⊤
        (pullbackSectionHom g'' _ ⊤ ⊤ _ (e.inv.app ⊤ (freeSectionsBasis X' M.r j))) =
      ((Scheme.Modules.pullbackComp g'' q).hom.app F).app ⊤
        (((Scheme.Modules.pullback g'').map e.inv).app ⊤
          ((schemeModulesPullbackObjFreeIso g'' _).inv.app ⊤ (freeSectionsBasis _ M.r j)))
    congr 1
    refine (pullbackSectionHom_naturality_apply g'' e.inv ⊤ ⊤ _
      (freeSectionsBasis X' M.r j)).symm.trans ?_
    congr 1
    let ε := sectionsLinearEquivOfIso (schemeModulesPullbackObjFreeIso g'' (ULift.{u} (Fin M.r))) ⊤
    have h2 : ε (pullbackSectionHom g'' (Scheme.Modules.free X' (ULift.{u} (Fin M.r))) ⊤ ⊤ le_top
        (freeSectionsBasis X' M.r j)) = freeSectionsBasis _ M.r j :=
      schemeModulesPullbackObjFreeIso_hom_pullbackSectionHom g'' M.r le_top j
    exact ((LinearEquiv.symm_apply_apply ε _).symm.trans (congrArg ε.symm h2) :)
  have hli : LinearIndependent Q.ResidueField (Φ'.symm ∘ bκ) :=
    bκ.linearIndependent.map' _ Φ'.symm.ker
  have : (Φ'.symm ∘ bκ) = fun j ↦ (⟨ψ ∘ b j, map_mem_ker_mulVecLin M.D φ ψ _⟩ :
        LinearMap.ker (Matrix.mulVecLin (M.D.map (ψ.comp φ)))) := by
    funext j; rw [Function.comp_apply, ← key, LinearEquiv.symm_apply_apply]
  rw [this] at hli
  exact hli.map' _ (Submodule.ker_subtype _)

/-- **A base along which `F` is free of rank `r` factors through the chart.** Here the base is
`Spec B` over `D(g)`, and the structure maps of `X'` and of its base changes are bijective on
global functions. -/
theorem exists_lift_of_iso_free {B : Type u} [CommRing B] (φ : A →+* B) (hg : IsUnit (φ M.g))
    {X' : Scheme.{u}} {f' : X' ⟶ Spec (.of B)} {q : X' ⟶ X₀}
    (H : IsPullback q f' f₀ (Spec.map (CommRingCat.ofHom φ)))
    (hp0 : Function.Bijective (Stacks.Cech.globalRingHom f').hom)
    (hp : ∀ {B' : Type u} [CommRing B'] (ψ : B →+* B'),
      Function.Bijective
        (Stacks.Cech.globalRingHom (pullback.snd f' (Spec.map (CommRingCat.ofHom ψ)))).hom)
    (e : (Scheme.Modules.pullback q).obj F ≅ SheafOfModules.free (ULift.{u} (Fin M.r))) :
    ∃ m : Spec (.of B) ⟶ M.chart.left, m ≫ M.chart.hom = Spec.map (CommRingCat.ofHom φ) := by
  have hD := M.map_D_eq_zero φ hg H hp0 hp e
  let χ := chartRingLift φ hg (M.map_eq_zero_of_mem_ideal φ hD)
  have hχ : χ.comp (chartRingHom M.g M.ideal) = φ := chartRingLift_comp _ _ _
  let l : Spec (.of B) ⟶ Spec (.of M.Rring) := Spec.map (CommRingCat.ofHom χ)
  have hl : l ≫ M.ιY = Spec.map (CommRingCat.ofHom φ) := by
    rw [← hχ, CommRingCat.ofHom_comp, Spec.map_comp]
  let h' := M.liftY H l hl
  have sq' : IsPullback h' f' (pullback.snd f₀ M.ιY) (Spec.map (CommRingCat.ofHom χ)) :=
    M.isPullback_liftY H l hl
  -- the pulled back universal sections
  let s' : Fin M.r → Γ((Scheme.Modules.pullback h').obj
      ((Scheme.Modules.pullback (pullback.fst f₀ M.ιY)).obj F), ⊤) :=
    fun i ↦ pullbackSectionHom h' _ ⊤ ⊤ le_top (M.secY i)
  have hker := M.ker_mulVecLin_map_eq_top φ hD
  have hs' : ∀ i, (M.liftYIso H l hl).hom.app ⊤ (s' i) =
      M.Φ φ hg H ⟨Pi.single i 1, M.mem_ker_of_map_eq_zero φ hD _⟩ := by
    intro i
    have h1 := M.nat (chartRingHom M.g M.ideal) χ (isUnit_chartRingHom _ _)
      (IsPullback.of_hasPullback f₀ M.ιY) sq'
      ⟨Pi.single i 1, M.mem_ker_of_map_eq_zero _ M.D_map_chartRingHom _⟩
    have h2 := M.Φ_congr hχ ((isUnit_chartRingHom M.g M.ideal).map χ) hg
      (M.liftY_fst H l hl)
      (Stacks.Cech.isPullback_comp_specMap _ χ f₀ _ f' _ h'
        (IsPullback.of_hasPullback f₀ M.ιY) sq') H
      ⟨χ ∘ (Pi.single i 1 : Fin M.r → M.Rring), map_mem_ker_mulVecLin M.D _ χ
        ⟨Pi.single i 1, M.mem_ker_of_map_eq_zero _ M.D_map_chartRingHom _⟩⟩
    have h3 : (χ ∘ (Pi.single i 1 : Fin M.r → M.Rring)) = Pi.single i 1 := by
      funext k
      by_cases hk : k = i
      · subst hk; simp
      · simp [hk]
    simp only [liftYIso, Iso.trans_hom, Iso.app_hom, Scheme.Modules.Hom.comp_app]
    change ((Scheme.Modules.pullbackCongr (M.liftY_fst H l hl)).hom.app F).app ⊤
      (((Scheme.Modules.pullbackComp h' (pullback.fst f₀ M.ιY)).hom.app F).app ⊤ (s' i)) = _
    rw [show ((Scheme.Modules.pullbackComp h' (pullback.fst f₀ M.ιY)).hom.app F).app ⊤ (s' i) = _
      from h1, h2]
    congr 2
  -- the pulled back `σ` is an isomorphism
  let e' : (Scheme.Modules.pullback q).obj F ≅ Scheme.Modules.free X' (ULift.{u} (Fin M.r)) := e
  let := Stacks.Cech.sectionsModule f' ((Scheme.Modules.pullback q).obj F) ⊤
  let := Stacks.Cech.sectionsModule f' (Scheme.Modules.free X' (ULift.{u} (Fin M.r))) ⊤
  let kerTop : LinearMap.ker (Matrix.mulVecLin (M.D.map φ)) ≃ₗ[B] (Fin M.r → B) :=
    LinearEquiv.ofTop _ hker
  let bK := (Pi.basisFun B (Fin M.r)).map kerTop.symm
  have hbK : ∀ i, bK i = ⟨Pi.single i 1, M.mem_ker_of_map_eq_zero φ hD _⟩ := fun i ↦ by
    apply kerTop.injective
    simp [bK, kerTop]
  let bF := (bK.map (M.Φ φ hg H)).map (baseSectionsEquivOfIso f' e')
  let bΓ := basisOfBasisOverBase f' hp0 _ bF
  have hbΓ : ∀ i, bΓ i = e'.hom.app ⊤ ((M.liftYIso H l hl).hom.app ⊤ (s' i)) := fun i ↦ by
    rw [hs', ← hbK i]
    simp only [bΓ, coe_basisOfBasisOverBase, bF, Module.Basis.map_apply]
    rfl
  let ψ := Scheme.Modules.freeHomOfSections (Scheme.Modules.free X' (ULift.{u} (Fin M.r))) bΓ
  have hψ : IsIso ψ := Scheme.Modules.isIso_of_bijective_app_top ψ
    (Scheme.Modules.bijective_app_top_freeHomOfSections_of_basis _ bΓ)
  have hcomp : Scheme.Modules.freeHomOfSections _ s' ≫ ((M.liftYIso H l hl).hom ≫ e'.hom) = ψ := by
    rw [Scheme.Modules.freeHomOfSections_comp]
    congr 1
    funext i
    rw [hbΓ]
    rfl
  have hiso1 : IsIso (Scheme.Modules.freeHomOfSections _ s') := by
    have : IsIso (Scheme.Modules.freeHomOfSections _ s' ≫ ((M.liftYIso H l hl).hom ≫ e'.hom)) := by
      rw [hcomp]; exact hψ
    exact IsIso.of_isIso_comp_right _ ((M.liftYIso H l hl).hom ≫ e'.hom)
  have hiso : IsIso ((Scheme.Modules.pullback h').map M.σ) := by
    rw [σ, Scheme.Modules.pullback_map_freeHomOfSections]
    infer_instance
  -- hence `l` lands in the chart
  have hr' : AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback h').obj ((Scheme.Modules.pullback (pullback.fst f₀ M.ιY)).obj F))
        M.r :=
    AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso
      ((M.liftYIso H l hl) ≪≫ e').symm
      (AlgebraicGeometry.SheafOfModules.isFiniteLocallyFreeOfRank_free (R := X'.ringCatSheaf) M.r)
  have hrange := (M.isoOpen_spec h' hr').1 hiso
  have hrange' := (range_subset_iff_of_isPullback _ _ sq').1 hrange
  exact (exists_lift_chartOver_iff _ _ _ _).2 ⟨l, hl, hrange'⟩

end KernelModelData

end AlgebraicGeometry.DescentLocus
