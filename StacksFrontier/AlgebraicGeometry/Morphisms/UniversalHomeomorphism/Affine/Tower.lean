/-!
# Universal homeomorphisms of affine schemes

For an inclusion of rings, the induced map on spectra is a universal homeomorphism exactly
when each finite set of elements is contained in an algebra generated by a finite sequence
whose successive elements satisfy one of two elementary integral relations over their
predecessors: either the square and the cube of the element lie in the algebra generated by
its predecessors, or, for some prime `p`, both `p` times the element and its `p`-th power do.

## Main definitions

No new definitions are introduced.

## Main results

* `AlgebraicGeometry.universalHomeomorphism_spec_iff_finite_adjoin_tower` characterizes
  universal homeomorphisms of affine spectra by finite towers of square-and-cube or
  prime-power extensions.

## Implementation notes

The finite sequence is indexed by `Fin n`. At index `i`, the algebra generated by the
preceding elements is expressed as the algebra generated by the range of the restriction to
indices less than `i`. The forward direction runs a Zorn argument over the subalgebras all of
whose finite subsets admit such a tower; the reverse direction checks integrality, universal
injectivity and surjectivity separately and concludes from the characterization of universal
homeomorphisms.

## References

* [Stacks Project, Tag 0CNE](https://stacks.math.columbia.edu/tag/0CNE)
-/

@[expose] public section

open CategoryTheory CategoryTheory.MorphismProperty CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

private def finiteTowerPredicate (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    (C : Subalgebra A B) : Prop :=
  ∀ E : Finset B, (E : Set B) ⊆ C →
    ∃ (n : ℕ) (b : Fin n → B),
      Set.range b ⊆ C ∧
        ((E : Set B) ⊆ Algebra.adjoin A (Set.range b)) ∧
          ∀ i : Fin n,
            (((b i) ^ 2 ∈ Algebra.adjoin A
                (Set.range fun j : { j : Fin n // j < i } ↦ b j)) ∧
              ((b i) ^ 3 ∈ Algebra.adjoin A
                (Set.range fun j : { j : Fin n // j < i } ↦ b j))) ∨
            (∃ p : ℕ, p.Prime ∧
              (((p : B) * b i ∈ Algebra.adjoin A
                  (Set.range fun j : { j : Fin n // j < i } ↦ b j)) ∧
                ((b i) ^ p ∈ Algebra.adjoin A
                  (Set.range fun j : { j : Fin n // j < i } ↦ b j))))

private lemma finiteTowerPredicate_bot (A B : Type u) [CommRing A] [CommRing B]
    [Algebra A B] : finiteTowerPredicate A B (⊥ : Subalgebra A B) := by
  intro E hE
  refine ⟨0, Fin.elim0, by simp, ?_, fun i => i.elim0⟩
  simpa [Algebra.adjoin_empty] using hE

private lemma finiteTowerPredicate_iSup_of_chain {A B : Type u} [CommRing A] [CommRing B]
    [Algebra A B] (c : Set (Subalgebra A B)) (hc : IsChain (· ≤ ·) c)
    (hcne : c.Nonempty) (hgood : ∀ C ∈ c, finiteTowerPredicate A B C) :
    finiteTowerPredicate A B (⨆ C : {C : Subalgebra A B // C ∈ c}, C.1) := by
  classical
  obtain ⟨C₀, hC₀⟩ := hcne
  let I := {C : Subalgebra A B // C ∈ c}
  have hdir : Directed (· ≤ ·) (fun i : I => i.1) := by
    intro i j
    obtain ⟨k, hk, hik, hjk⟩ := hc.directedOn i.1 i.2 j.1 j.2
    exact ⟨⟨k, hk⟩, hik, hjk⟩
  have hmember {x : B} (hx : x ∈ ⨆ i : I, i.1) : ∃ i : I, x ∈ i.1 := by
    refine Algebra.iSup_induction (S := fun i : I => i.1)
      (motive := fun x => ∃ i : I, x ∈ i.1) hx (fun i _ hy => ⟨i, hy⟩) ?_ ?_
      fun a => ⟨⟨C₀, hC₀⟩, C₀.algebraMap_mem a⟩
    · rintro x y ⟨i, hi⟩ ⟨j, hj⟩
      obtain ⟨k, hik, hjk⟩ := hdir i j
      exact ⟨k, k.1.add_mem (hik hi) (hjk hj)⟩
    · rintro x y ⟨i, hi⟩ ⟨j, hj⟩
      obtain ⟨k, hik, hjk⟩ := hdir i j
      exact ⟨k, k.1.mul_mem (hik hi) (hjk hj)⟩
  intro E hE
  have hcover : ∃ i : I, (E : Set B) ⊆ i.1 := by
    induction E using Finset.induction_on with
    | empty => exact ⟨⟨C₀, hC₀⟩, by simp⟩
    | @insert x E hx ih =>
        obtain ⟨i, hi⟩ := ih fun y hy => hE (Finset.mem_insert_of_mem hy)
        obtain ⟨j, hj⟩ := hmember (x := x) (hE (by simp))
        obtain ⟨k, hik, hjk⟩ := hdir i j
        refine ⟨k, fun y hy => ?_⟩
        rcases Finset.mem_insert.mp hy with rfl | hyE
        · exact hjk hj
        · exact hik (hi hyE)
  obtain ⟨i, hEi⟩ := hcover
  obtain ⟨n, b, hbC, hEt, hsteps⟩ := hgood i.1 i.2 E hEi
  exact ⟨n, b, fun x hx => Algebra.mem_iSup_of_mem i (hbC hx), hEt, hsteps⟩

private lemma exists_polynomial_representation
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    (C : Subalgebra A B) (b x : B)
    (hx : x ∈ Algebra.adjoin A ((C : Set B) ∪ {b})) :
    ∃ p : Polynomial C, Polynomial.eval₂ (algebraMap C B) b p = x := by
  rw [Algebra.adjoin_union_eq_adjoin_adjoin, Algebra.adjoin_eq,
    Algebra.adjoin_singleton_eq_range_aeval] at hx
  obtain ⟨p, hp⟩ := hx
  exact ⟨p, by simpa [Polynomial.aeval_def] using hp⟩

private lemma finiteTowerPredicate_adjoin_special
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    (C : Subalgebra A B) (hC : finiteTowerPredicate A B C) (b : B)
    (hspecial : ((b ^ 2 ∈ C) ∧ (b ^ 3 ∈ C)) ∨
      (∃ p : ℕ, p.Prime ∧ ((p : B) * b ∈ C) ∧ (b ^ p ∈ C))) :
    finiteTowerPredicate A B (Algebra.adjoin A ((C : Set B) ∪ {b})) := by
  classical
  intro E hE
  let rep (x : B) : Polynomial C :=
    if hx : x ∈ E then
      Classical.choose (exists_polynomial_representation C b x (hE hx))
    else 0
  have hrep {x : B} (hx : x ∈ E) :
      Polynomial.eval₂ (algebraMap C B) b (rep x) = x := by
    simp only [rep, hx, reduceDIte]
    exact (Classical.choose_spec (exists_polynomial_representation C b x (hE hx)))
  let extra : Finset C :=
    if h : b ^ 2 ∈ C ∧ b ^ 3 ∈ C then
      {⟨b ^ 2, h.1⟩, ⟨b ^ 3, h.2⟩}
    else if h : ∃ p : ℕ, p.Prime ∧ (p : B) * b ∈ C ∧ b ^ p ∈ C then
      {⟨(Classical.choose h : ℕ) * b, (Classical.choose_spec h).2.1⟩,
        ⟨b ^ Classical.choose h, (Classical.choose_spec h).2.2⟩}
    else ∅
  let coeff : Finset C := E.biUnion (fun x => (rep x).coeffs) ∪ extra
  let coeffB : Finset B := coeff.image fun x : C => (x : B)
  have hcoeffC : (coeffB : Set B) ⊆ C := by
    intro x hx
    rcases Finset.mem_image.mp hx with ⟨y, hy, rfl⟩
    exact y.property
  obtain ⟨n, a, haC, hcoeff, hsteps⟩ := hC coeffB hcoeffC
  let U := Algebra.adjoin A (Set.range a)
  let seq : Fin (n + 1) → B := Fin.snoc (fun i => a i) b
  let T := Algebra.adjoin A (Set.range seq)
  have hcs (i : Fin n) : seq i.castSucc = a i := by simp [seq]
  have hsl : seq (Fin.last n) = b := by simp [seq]
  have hcoeffU : ∀ x : C, x ∈ coeff → (x : B) ∈ U := by
    intro x hx
    apply hcoeff
    exact Finset.mem_image.mpr ⟨x, hx, rfl⟩
  have hULeT : U ≤ T :=
    Algebra.adjoin_le_iff.mpr fun _ ⟨i, hi⟩ => Algebra.subset_adjoin ⟨i.castSucc, (hcs i).trans hi⟩
  have hbT : b ∈ T := Algebra.subset_adjoin ⟨Fin.last n, hsl⟩
  have hpoly (x : B) (hx : x ∈ E) :
      Polynomial.eval₂ (algebraMap C B) b (rep x) ∈ T := by
    rw [(rep x).as_sum_support_C_mul_X_pow]
    rw [Polynomial.eval₂_finsetSum]
    simp only [Polynomial.eval₂_mul, Polynomial.eval₂_C]
    apply T.sum_mem
    intro i hi
    apply T.mul_mem
    · have hci : (rep x).coeff i ∈ coeff := by
        apply Finset.mem_union.mpr
        left
        apply Finset.mem_biUnion.mpr
        exact ⟨x, hx, Polynomial.mem_coeffs_iff.mpr ⟨i, hi, rfl⟩⟩
      have hmem := hULeT (hcoeffU _ hci)
      simpa using hmem
    · simpa using T.pow_mem hbT i
  have hEt : (E : Set B) ⊆ T := by
    intro x hx
    rw [← hrep hx]
    exact hpoly x hx
  have hseqD : Set.range seq ⊆ Algebra.adjoin A ((C : Set B) ∪ {b}) := by
    rintro x ⟨i, rfl⟩
    refine Fin.lastCases ?_ ?_ i
    · apply Algebra.subset_adjoin
      simp [seq]
    · intro i
      apply Algebra.subset_adjoin
      simpa [seq] using
        (Set.mem_union_left {b} (haC ⟨i, rfl⟩))
  have hprefix (i : Fin n) :
      Algebra.adjoin A (Set.range fun j : {j : Fin n // j < i} ↦ a j.1) ≤
        Algebra.adjoin A
          (Set.range fun j : {j : Fin (n + 1) // j < i.castSucc} ↦ seq j.1) :=
    Algebra.adjoin_le_iff.mpr fun _ ⟨j, hj⟩ => Algebra.subset_adjoin
      ⟨⟨j.1.castSucc, Fin.castSucc_lt_castSucc_iff.mpr j.2⟩, (hcs _).trans hj⟩
  have hlast : U ≤ Algebra.adjoin A
      (Set.range fun j : {j : Fin (n + 1) // j < Fin.last n} ↦ seq j.1) :=
    Algebra.adjoin_le_iff.mpr fun _ ⟨i, hi⟩ => Algebra.subset_adjoin
      ⟨⟨i.castSucc, Fin.castSucc_lt_last i⟩, (hcs _).trans hi⟩
  have hnew (y : C) (hy : y ∈ extra) : (y : B) ∈ Algebra.adjoin A
      (Set.range fun j : {j : Fin (n + 1) // j < Fin.last n} ↦ seq j.1) :=
    hlast (hcoeffU y (by simp [coeff, hy]))
  refine ⟨n + 1, seq, hseqD, hEt, ?_⟩
  intro i
  refine Fin.lastCases ?_ ?_ i
  · rw [hsl]
    by_cases hs : b ^ 2 ∈ C ∧ b ^ 3 ∈ C
    · exact Or.inl ⟨hnew ⟨b ^ 2, hs.1⟩ (by simp [extra, hs]),
        hnew ⟨b ^ 3, hs.2⟩ (by simp [extra, hs])⟩
    · have hpEx : ∃ p : ℕ, p.Prime ∧ (p : B) * b ∈ C ∧ b ^ p ∈ C :=
        hspecial.resolve_left hs
      exact Or.inr ⟨_, (Classical.choose_spec hpEx).1,
        hnew ⟨_, (Classical.choose_spec hpEx).2.1⟩ (by simp [extra, hs, hpEx]),
        hnew ⟨_, (Classical.choose_spec hpEx).2.2⟩ (by simp [extra, hs, hpEx])⟩
  · intro i
    rw [hcs]
    exact (hsteps i).imp (fun h => ⟨hprefix i h.1, hprefix i h.2⟩)
      fun ⟨p, hp, h⟩ => ⟨p, hp, hprefix i h.1, hprefix i h.2⟩

private lemma exists_maximal_finiteTowerSubalgebra (A B : Type u) [CommRing A] [CommRing B]
    [Algebra A B] :
    ∃ C : Subalgebra A B, finiteTowerPredicate A B C ∧
      ∀ D : Subalgebra A B, finiteTowerPredicate A B D → C ≤ D → D ≤ C := by
  obtain ⟨C, -, hC, hmax⟩ := zorn_le_nonempty₀ {C | finiteTowerPredicate A B C}
    (fun c hc hcc y hy => ⟨⨆ C : {C : Subalgebra A B // C ∈ c}, C.1,
      finiteTowerPredicate_iSup_of_chain c hcc ⟨y, hy⟩ fun C hC => hc hC,
      fun z hz => le_iSup (fun C : {C : Subalgebra A B // C ∈ c} => C.1) ⟨z, hz⟩⟩)
    ⊥ (finiteTowerPredicate_bot A B)
  exact ⟨C, hC, fun D hD => hmax hD⟩

private lemma eq_of_sq_cube_eq_field {K : Type*} [Field K] {x y : K}
    (h2 : x ^ 2 = y ^ 2) (h3 : x ^ 3 = y ^ 3) : x = y := by
  have hmul : x * x ^ 2 = y * x ^ 2 := by linear_combination h3 - y * h2
  by_cases hx : x = 0
  · subst x
    have : y ^ 2 = 0 := by simpa using h2.symm
    exact (eq_zero_of_pow_eq_zero this).symm
  · exact mul_right_cancel₀ (pow_ne_zero 2 hx) hmul

private lemma eq_of_prime_relations_field {K : Type*} [Field K] {p : ℕ}
    (hp : p.Prime) {x y : K} (hmul : (p : K) * x = (p : K) * y)
    (hpow : x ^ p = y ^ p) : x = y := by
  by_cases hp0 : (p : K) = 0
  · have : Fact p.Prime := ⟨hp⟩
    have : CharP K p := (CharP.charP_iff_prime_eq_zero hp).2 hp0
    have hsub : (x - y) ^ p = 0 := by
      rw [sub_pow_char, hpow, sub_self]
    exact sub_eq_zero.mp (eq_zero_of_pow_eq_zero hsub)
  · exact mul_left_cancel₀ hp0 hmul

private lemma ringHom_eq_on_adjoin {A B K : Type*} [CommRing A] [CommRing B]
    [Algebra A B] [Field K] (f g : B →+* K)
    (hA : ∀ a : A, f (algebraMap A B a) = g (algebraMap A B a))
    (s : Set B) (hs : ∀ x ∈ s, f x = g x) :
    ∀ x ∈ Algebra.adjoin A s, f x = g x := by
  refine fun x hx => Algebra.adjoin_induction (s := s)
    (p := fun x _ => f x = g x) hs hA ?_ ?_ hx
  · intro x y _ _ hfx hfy
    simp [hfx, hfy]
  · intro x y _ _ hfx hfy
    simp [hfx, hfy]

private lemma ringHoms_agree_on_tower {A B K : Type*} [CommRing A] [CommRing B]
    [Algebra A B] [Field K] (f g : B →+* K)
    (hA : ∀ a : A, f (algebraMap A B a) = g (algebraMap A B a))
    (n : ℕ) (b : Fin n → B)
    (hstep : ∀ i : Fin n,
      (((b i) ^ 2 ∈ Algebra.adjoin A
          (Set.range fun j : {j : Fin n // j < i} ↦ b j.1)) ∧
        ((b i) ^ 3 ∈ Algebra.adjoin A
          (Set.range fun j : {j : Fin n // j < i} ↦ b j.1))) ∨
      (∃ p : ℕ, p.Prime ∧
        (((p : B) * b i ∈ Algebra.adjoin A
            (Set.range fun j : {j : Fin n // j < i} ↦ b j.1)) ∧
          ((b i) ^ p ∈ Algebra.adjoin A
            (Set.range fun j : {j : Fin n // j < i} ↦ b j.1))))) :
    ∀ i : Fin n, f (b i) = g (b i) := by
  intro i
  induction i using WellFoundedLT.induction with
  | ind i ih =>
    have hagree : ∀ x ∈ Algebra.adjoin A
        (Set.range fun j : {j : Fin n // j < i} ↦ b j.1), f x = g x :=
      ringHom_eq_on_adjoin f g hA _ (Set.forall_mem_range.mpr fun j => ih j.1 j.2)
    rcases hstep i with ⟨h2, h3⟩ | ⟨p, hp, hmul, hpow⟩
    · exact eq_of_sq_cube_eq_field (by simpa only [map_pow] using hagree _ h2)
        (by simpa only [map_pow] using hagree _ h3)
    · exact eq_of_prime_relations_field hp
        (by simpa only [map_mul, map_natCast] using hagree _ hmul)
        (by simpa only [map_pow] using hagree _ hpow)

private lemma algebra_isIntegral_of_finiteTower {A B : Type u} [CommRing A] [CommRing B]
    [Algebra A B] (n : ℕ) (b : Fin n → B)
    (hstep : ∀ i : Fin n,
      (((b i) ^ 2 ∈ Algebra.adjoin A
          (Set.range fun j : {j : Fin n // j < i} ↦ b j.1)) ∧
        ((b i) ^ 3 ∈ Algebra.adjoin A
          (Set.range fun j : {j : Fin n // j < i} ↦ b j.1))) ∨
      (∃ p : ℕ, p.Prime ∧
        (((p : B) * b i ∈ Algebra.adjoin A
            (Set.range fun j : {j : Fin n // j < i} ↦ b j.1)) ∧
          ((b i) ^ p ∈ Algebra.adjoin A
            (Set.range fun j : {j : Fin n // j < i} ↦ b j.1))))) :
    ∀ i : Fin n, _root_.IsIntegral A (b i) := by
  intro i
  induction i using WellFoundedLT.induction with
  | ind i ih =>
    have hprefix : Algebra.adjoin A (Set.range fun j : {j : Fin n // j < i} ↦ b j.1) ≤
        integralClosure A B :=
      Algebra.adjoin_le (Set.range_subset_iff.mpr fun j => ih j.1 j.2)
    rcases hstep i with ⟨h2, -⟩ | ⟨p, hp, -, hpow⟩
    · exact IsIntegral.of_pow two_pos (hprefix h2 : _root_.IsIntegral A _)
    · exact IsIntegral.of_pow hp.pos (hprefix hpow : _root_.IsIntegral A _)

private lemma ringHoms_unique_of_towerCondition {A B : Type u} [CommRing A] [CommRing B]
    [Algebra A B]
    (htower : ∀ E : Finset B, ∃ (n : ℕ) (b : Fin n → B),
      ((E : Set B) ⊆ Algebra.adjoin A (Set.range b)) ∧
        ∀ i : Fin n,
          (((b i) ^ 2 ∈ Algebra.adjoin A
              (Set.range fun j : {j : Fin n // j < i} ↦ b j.1)) ∧
            ((b i) ^ 3 ∈ Algebra.adjoin A
              (Set.range fun j : {j : Fin n // j < i} ↦ b j.1))) ∨
          (∃ p : ℕ, p.Prime ∧
            (((p : B) * b i ∈ Algebra.adjoin A
                (Set.range fun j : {j : Fin n // j < i} ↦ b j.1)) ∧
              ((b i) ^ p ∈ Algebra.adjoin A
                (Set.range fun j : {j : Fin n // j < i} ↦ b j.1))))) :
    ∀ K : Type u, [Field K] → ∀ f g : B →+* K,
      (∀ a : A, f (algebraMap A B a) = g (algebraMap A B a)) → f = g := by
  intro K _ f g hA
  refine RingHom.ext fun x => ?_
  obtain ⟨n, b, hE, hsteps⟩ := htower {x}
  exact ringHom_eq_on_adjoin f g hA (Set.range b)
    (Set.forall_mem_range.mpr (ringHoms_agree_on_tower f g hA n b hsteps)) x (hE (by simp))

private lemma algebra_isIntegral_of_towerCondition {A B : Type u} [CommRing A] [CommRing B]
    [Algebra A B]
    (htower : ∀ E : Finset B, ∃ (n : ℕ) (b : Fin n → B),
      ((E : Set B) ⊆ Algebra.adjoin A (Set.range b)) ∧
        ∀ i : Fin n,
          (((b i) ^ 2 ∈ Algebra.adjoin A
              (Set.range fun j : {j : Fin n // j < i} ↦ b j.1)) ∧
            ((b i) ^ 3 ∈ Algebra.adjoin A
              (Set.range fun j : {j : Fin n // j < i} ↦ b j.1))) ∨
          (∃ p : ℕ, p.Prime ∧
            (((p : B) * b i ∈ Algebra.adjoin A
                (Set.range fun j : {j : Fin n // j < i} ↦ b j.1)) ∧
              ((b i) ^ p ∈ Algebra.adjoin A
                (Set.range fun j : {j : Fin n // j < i} ↦ b j.1))))) :
    Algebra.IsIntegral A B := by
  refine ⟨fun x => ?_⟩
  obtain ⟨n, b, hE, hsteps⟩ := htower {x}
  exact Algebra.adjoin_le (S := integralClosure A B)
    (Set.range_subset_iff.mpr (algebra_isIntegral_of_finiteTower n b hsteps)) (hE (by simp))

/-- An inclusion of rings induces a universal homeomorphism on spectra exactly when every finite
set is contained in a finite, successively elementary extension. -/
@[stacks 0CNE]
theorem universalHomeomorphism_spec_iff_finite_adjoin_tower
    (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    (hAB : Function.Injective (algebraMap A B)) :
    UniversalHomeomorphism
        (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op) ↔
      ∀ E : Finset B, ∃ (n : ℕ) (b : Fin n → B),
        ((E : Set B) ⊆ Algebra.adjoin A (Set.range b)) ∧
          ∀ i : Fin n,
            (((b i) ^ 2 ∈ Algebra.adjoin A
                (Set.range fun j : { j : Fin n // j < i } ↦ b j)) ∧
              ((b i) ^ 3 ∈ Algebra.adjoin A
                (Set.range fun j : { j : Fin n // j < i } ↦ b j))) ∨
            (∃ p : ℕ, p.Prime ∧
              (((p : B) * b i ∈ Algebra.adjoin A
                  (Set.range fun j : { j : Fin n // j < i } ↦ b j)) ∧
                ((b i) ^ p ∈ Algebra.adjoin A
                  (Set.range fun j : { j : Fin n // j < i } ↦ b j)))) := by
  classical
  constructor
  · intro hUH E
    obtain ⟨C, hC, hmax⟩ := exists_maximal_finiteTowerSubalgebra A B
    have hCtop : C = ⊤ := by
      by_contra hCtop
      have hCB := universalHomeomorphism_specMap_to_subalgebra hUH C
      obtain ⟨b, hbC, hspecial⟩ : ∃ b : B, b ∉ C ∧
          ((b ^ 2 ∈ C ∧ b ^ 3 ∈ C) ∨
            ∃ p : ℕ, p.Prime ∧ (p : B) * b ∈ C ∧ b ^ p ∈ C) := by
        rcases exists_special_element_over_subalgebra C hCB hCtop with
          ⟨b, hbC, h2, h3⟩ | ⟨p, hp, b, hbC, hmul, hpow⟩
        · exact ⟨b, hbC, Or.inl ⟨h2, h3⟩⟩
        · exact ⟨b, hbC, Or.inr ⟨p, hp, hmul, hpow⟩⟩
      exact hbC (hmax _ (finiteTowerPredicate_adjoin_special C hC b hspecial)
        (fun x hx => Algebra.subset_adjoin (Set.mem_union_left _ hx))
        (Algebra.subset_adjoin (Set.mem_union_right (C : Set B) (Set.mem_singleton b))))
    obtain ⟨n, b, _, hEt, hsteps⟩ := hC E (by simp [hCtop])
    exact ⟨n, b, by simpa [hCtop] using hEt, hsteps⟩
  · intro htower
    let f := Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op
    have hAI : Algebra.IsIntegral A B := algebra_isIntegral_of_towerCondition htower
    have hIntegral : IsIntegralHom f :=
      IsIntegralHom.SpecMap_iff.mpr (algebraMap_isIntegral_iff.mpr hAI)
    have hInjective : UniversallyInjective f := by
      apply ((tfae_universallyInjective f).out 2 1).mp
      intro K _ g₁ g₂ hcomp
      have hpre := congrArg Scheme.Spec.preimage hcomp
      have hA : ∀ a : A,
          (Scheme.Spec.preimage g₁).unop.hom (algebraMap A B a) =
            (Scheme.Spec.preimage g₂).unop.hom (algebraMap A B a) := by
        have hfpre : (Scheme.Spec.preimage f).unop.hom = algebraMap A B := by
          show (Scheme.Spec.preimage
            (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op)).unop.hom = _
          rw [Scheme.Spec.preimage_map]
          rfl
        intro a
        have hpre' := congrArg
          (fun q : Opposite.op (CommRingCat.of K) ⟶ Opposite.op (CommRingCat.of A) =>
            q.unop) hpre
        simp only [Scheme.Spec.preimage_comp, CategoryTheory.unop_comp] at hpre'
        have hval := congrArg
          (fun q : CommRingCat.of A ⟶ CommRingCat.of K => q.hom a) hpre'
        simp only [CommRingCat.hom_comp, RingHom.comp_apply] at hval
        rw [hfpre] at hval
        simpa only [RingHom.comp_apply] using hval
      apply Spec.homEquiv.injective
      apply CommRingCat.hom_ext_iff.mpr
      exact ringHoms_unique_of_towerCondition htower K
        (Spec.homEquiv g₁).hom (Spec.homEquiv g₂).hom hA
    have hSurjective : Function.Surjective f := by
      change Function.Surjective (PrimeSpectrum.comap (algebraMap A B))
      intro p
      obtain ⟨q, hq, hqprime, hqp⟩ :=
        Ideal.exists_ideal_over_prime_of_isIntegral p.asIdeal ⊥ (by
          intro x hx
          have hx' : algebraMap A B x = 0 := by simpa using hx
          have : x = 0 := hAB (by simpa using hx')
          simp [this])
      exact ⟨⟨q, hqprime⟩, PrimeSpectrum.ext hqp⟩
    exact (universalHomeomorphism_iff_integral_universallyInjective_surjective f).2
      ⟨hIntegral, hInjective, (surjective_iff f).2 hSurjective⟩

end AlgebraicGeometry

