/-!
# Flat unramified algebras are formally étale

For an unramified ring map `R → A` the kernel of the multiplication map `A ⊗[R] A → A` is a
finitely generated idempotent ideal, hence generated by an idempotent, and the complementary
idempotent `e` satisfies `e * (a ⊗ 1) = e * (1 ⊗ a)` for every `a`. If the map is moreover flat,
this idempotent produces, for every square-zero ideal, the unique lift required by formal
étaleness.

## Main results

* `Stacks.FormallyEtale.exists_isIdempotentElem_lmul'_eq_one` is the diagonal idempotent of a
  formally unramified, essentially finite type algebra.
* `Stacks.FormallyEtale.exists_algHom_lift` lifts an `R`-algebra map `A →ₐ[R] R ⧸ I` through a
  square-zero ideal `I` of the base itself.
* `Stacks.FormallyEtale.formallyEtale_of_flat` is the ring-theoretic input for Tag 04FF: a flat,
  formally unramified algebra of essentially finite type is formally étale. The tag's own
  statement, for morphisms of schemes, is not proved here and carries no tag in this file.

## Implementation notes

The lifting problem for a general square-zero ideal `I` of an `R`-algebra `B` reduces, by base
change along `R → B`, to the case where the ideal lives in the base ring itself; that case is
`Stacks.FormallyEtale.exists_algHom_lift` and it is where the idempotent is used.

Given `φ : A →ₐ[R] R ⧸ I`, the diagonal idempotent is pushed into `A ⧸ I A` along
`a ⊗ b ↦ a * φ b`, where the second factor makes sense because `R ⧸ I` maps to `A ⧸ I A`. The
resulting idempotent of `A ⧸ I A` lifts to an idempotent `ẽ` of `A` because `I A` is square
zero, and the two defining properties of the diagonal idempotent become

* `φ ẽ = 1`, and
* `A * ẽ = R * ẽ + I * (A * ẽ)`, whence `A * ẽ = R * ẽ` because `I ^ 2 = 0`.

So `A ⧸ (1 - ẽ)` is generated by the image of `R`, and flatness of `A`, through the equational
criterion, shows that `r * ẽ = 0` forces `r = 0`. Hence `R ≃ A ⧸ (1 - ẽ)` and the inverse of that
isomorphism, precomposed with the quotient map, is the required lift.

Hypotheses are stated as `Algebra.FormallyUnramified` together with `Algebra.EssFiniteType`, which
is what the finite generation of the diagonal ideal needs; an `Algebra.Unramified` algebra
satisfies both.

## References

* [Stacks Project, Tag 04FF](https://stacks.math.columbia.edu/tag/04FF)
-/

@[expose] public section

open scoped TensorProduct

universe u v

namespace Stacks.FormallyEtale

/-- Two elements of a square-zero ideal multiply to zero. -/
private theorem mul_eq_zero_of_mem_of_sq_eq_bot {S : Type*} [CommRing S] {J : Ideal S}
    (hJ : J ^ 2 = ⊥) {x y : S} (hx : x ∈ J) (hy : y ∈ J) : x * y = 0 := by
  have := Ideal.mul_mem_mul hx hy
  rwa [← pow_two, hJ, Ideal.mem_bot] at this

/-- An element of a quotient by a square-zero ideal which is idempotent lifts to an idempotent:
if `x` represents it then `3 * x ^ 2 - 2 * x ^ 3` does the job. -/
@[sga "3 VIIB 1.6" "partial"]
theorem exists_isIdempotentElem_quotient_mk_eq {A : Type u} [CommRing A] (J : Ideal A)
    (hJ : J ^ 2 = ⊥) {b : A ⧸ J} (hb : IsIdempotentElem b) :
    ∃ c : A, IsIdempotentElem c ∧ Ideal.Quotient.mk J c = b := by
  obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective b
  have hx : x ^ 2 - x ∈ J := by
    refine Ideal.Quotient.eq_zero_iff_mem.mp ?_
    rw [map_sub, map_pow, sq, hb, sub_self]
  have hx2 := mul_eq_zero_of_mem_of_sq_eq_bot hJ hx hx
  have hb' : Ideal.Quotient.mk J x * Ideal.Quotient.mk J x = Ideal.Quotient.mk J x := hb
  refine ⟨3 * x ^ 2 - 2 * x ^ 3, ?_, ?_⟩
  · change (3 * x ^ 2 - 2 * x ^ 3) * (3 * x ^ 2 - 2 * x ^ 3) = 3 * x ^ 2 - 2 * x ^ 3
    linear_combination (4 * x ^ 2 - 4 * x - 3) * hx2
  · simp only [map_sub, map_mul, map_pow, map_ofNat]
    linear_combination (1 - 2 * Ideal.Quotient.mk J x) * hb'

/-- If `I ^ 2 = 0` and a submodule `P` is contained in `N + I • P`, then `P` is contained in `N`:
substituting the inclusion into itself replaces `I • P` by `I • N + I ^ 2 • P`. -/
theorem le_of_le_sup_smul {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    {I : Ideal R} (hI : I ^ 2 = ⊥) {N P : Submodule R M} (h : P ≤ N ⊔ I • P) : P ≤ N := by
  have h2 : I • P ≤ N := by
    refine (Submodule.smul_mono le_rfl h).trans ?_
    rw [Submodule.smul_sup]
    refine sup_le Submodule.smul_le_right ?_
    rw [← Submodule.mul_smul, ← pow_two, hI, Submodule.bot_smul]
    exact bot_le
  exact h.trans (sup_le le_rfl h2)

variable {R : Type u} {A : Type v} [CommRing R] [CommRing A] [Algebra R A]

/-- **The diagonal idempotent of a formally unramified algebra.** For a formally unramified
algebra of essentially finite type the kernel of `A ⊗[R] A → A` is finitely generated and
idempotent, so it is generated by an idempotent `ε`; the complementary idempotent `e = 1 - ε`
has multiplication-map value `1` and identifies the two inclusions `A → A ⊗[R] A`. -/
theorem exists_isIdempotentElem_lmul'_eq_one [Algebra.FormallyUnramified R A]
    [Algebra.EssFiniteType R A] :
    ∃ e : A ⊗[R] A, IsIdempotentElem e ∧ Algebra.TensorProduct.lmul' R e = 1 ∧
      ∀ a : A, e * a ⊗ₜ[R] (1 : A) = e * (1 : A) ⊗ₜ[R] a := by
  obtain ⟨ε, hε, hspan⟩ :=
    (Ideal.isIdempotentElem_iff_of_fg _ (KaehlerDifferential.ideal_fg R A)).mp
      ((Ideal.cotangent_subsingleton_iff _).mp (inferInstanceAs (Subsingleton Ω[A⁄R])))
  rw [Ideal.submodule_span_eq] at hspan
  have hmem : ε ∈ KaehlerDifferential.ideal R A := by
    rw [hspan]
    exact Ideal.mem_span_singleton_self ε
  have hε' : ε * ε = ε := hε
  refine ⟨1 - ε, ?_, ?_, fun a => ?_⟩
  · change (1 - ε) * (1 - ε) = 1 - ε
    linear_combination hε'
  · have hz : Algebra.TensorProduct.lmul' R ε = 0 := hmem
    rw [map_sub, map_one, hz, sub_zero]
  · have h : a ⊗ₜ[R] (1 : A) - (1 : A) ⊗ₜ[R] a ∈ KaehlerDifferential.ideal R A := by
      simpa only [neg_sub] using
        neg_mem (KaehlerDifferential.one_smul_sub_smul_one_mem_ideal R a)
    rw [hspan] at h
    obtain ⟨c, hc⟩ := Ideal.mem_span_singleton'.mp h
    linear_combination (ε - 1) * hc - c * hε'

/-- **Lifting through a square-zero ideal of the base.** Let `A` be a flat, formally unramified
`R`-algebra of essentially finite type and let `I` be a square-zero ideal of `R`. Then every
`R`-algebra map `A → R ⧸ I` lifts to an `R`-algebra map `A → R`. -/
theorem exists_algHom_lift [Algebra.FormallyUnramified R A] [Algebra.EssFiniteType R A]
    [Module.Flat R A] (I : Ideal R) (hI : I ^ 2 = ⊥) (φ : A →ₐ[R] R ⧸ I) :
    ∃ ψ : A →ₐ[R] R, ∀ a : A, Ideal.Quotient.mk I (ψ a) = φ a := by
  classical
  obtain ⟨e, he, he1, hea⟩ := exists_isIdempotentElem_lmul'_eq_one (R := R) (A := A)
  -- the square-zero ideal `I A` of `A`
  have hJ : (I.map (algebraMap R A)) ^ 2 = ⊥ := by
    rw [← Ideal.map_pow, hI, Ideal.map_bot]
  have hφJ : ∀ a ∈ I.map (algebraMap R A), φ a = 0 := by
    have hle : I.map (algebraMap R A) ≤ RingHom.ker (φ : A →+* R ⧸ I) := by
      rw [Ideal.map_le_iff_le_comap]
      intro r hr
      simp only [Ideal.mem_comap, RingHom.mem_ker, RingHom.coe_coe, AlgHom.commutes,
        Ideal.Quotient.algebraMap_eq]
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hr
    exact fun a ha => hle ha
  set Φ : A ⧸ I.map (algebraMap R A) →ₐ[R] R ⧸ I := Ideal.Quotient.liftₐ _ φ hφJ with hΦ
  set ν : R ⧸ I →ₐ[R] A ⧸ I.map (algebraMap R A) :=
    Ideal.Quotient.liftₐ I ((Ideal.Quotient.mkₐ R _).comp (Algebra.ofId R A))
      (fun r hr => Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.mem_map_of_mem _ hr)) with hν
  set θ : A ⊗[R] A →ₐ[R] A ⧸ I.map (algebraMap R A) :=
    Algebra.TensorProduct.lift (Ideal.Quotient.mkₐ R _) (ν.comp φ)
      (fun _ _ => Commute.all _ _) with hθ
  have hΦmk : ∀ a : A, Φ (Ideal.Quotient.mk _ a) = φ a := fun a => rfl
  have hΦν : ∀ z : R ⧸ I, Φ (ν z) = z := by
    intro z
    obtain ⟨r, rfl⟩ := Ideal.Quotient.mk_surjective z
    change Φ (Ideal.Quotient.mk _ (algebraMap R A r)) = _
    rw [hΦmk, AlgHom.commutes, Ideal.Quotient.algebraMap_eq]
  have hθtmul : ∀ x y : A, θ (x ⊗ₜ[R] y) = Ideal.Quotient.mk _ x * ν (φ y) := by
    intro x y; rw [hθ]; simp
  -- the induced idempotent of `A ⧸ I A`
  have he' : e * e = e := he
  have hθe : IsIdempotentElem (θ e) := by
    change θ e * θ e = θ e
    rw [← map_mul, he']
  have hΦθ : ∀ z : A ⊗[R] A, Φ (θ z) = φ (Algebra.TensorProduct.lmul' R z) := by
    have : Φ.comp θ = φ.comp (Algebra.TensorProduct.lmul' R) := by
      refine Algebra.TensorProduct.ext' fun x y => ?_
      simp only [AlgHom.comp_apply, hθtmul, map_mul, hΦmk, hΦν,
        Algebra.TensorProduct.lmul'_apply_tmul]
    exact fun z => AlgHom.congr_fun this z
  obtain ⟨g, hg, hgmk⟩ := exists_isIdempotentElem_quotient_mk_eq _ hJ hθe
  have hgg : g * g = g := hg
  have hφg : φ g = 1 := by rw [← hΦmk, hgmk, hΦθ, he1, map_one]
  -- the two defining properties of `e`, transported to `g`
  have hstar : ∀ a : A, Ideal.Quotient.mk (I.map (algebraMap R A)) (a * g) =
      ν (φ a) * Ideal.Quotient.mk _ g := by
    intro a
    have h := congrArg θ (hea a)
    simp only [map_mul, hθtmul, ← hgmk, map_one, mul_one, one_mul] at h
    rw [map_mul]
    linear_combination h
  -- `A * g = R * g`
  have key : ∀ a : A, ∃ r : R, a * g = algebraMap R A r * g := by
    have hmem : ∀ z : A, z * g ∈ (Ideal.span {g} : Ideal A).restrictScalars R := fun z =>
      (Submodule.restrictScalars_mem R _ _).mpr (Ideal.mem_span_singleton'.mpr ⟨z, rfl⟩)
    have hMN : (Ideal.span {g} : Ideal A).restrictScalars R ≤ Submodule.span R {g} := by
      refine le_of_le_sup_smul hI ?_
      intro x hx
      obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp (Submodule.restrictScalars_mem R _ x |>.mp hx)
      obtain ⟨r, hr⟩ := Ideal.Quotient.mk_surjective (φ c)
      have h1 : c * g - algebraMap R A r * g ∈ I.map (algebraMap R A) := by
        refine Ideal.Quotient.eq_zero_iff_mem.mp ?_
        rw [map_sub, hstar, hstar, AlgHom.commutes, Ideal.Quotient.algebraMap_eq, hr, sub_self]
      have h2 : (c * g - algebraMap R A r * g) ∈ I • (⊤ : Submodule R A) := by
        rwa [Ideal.smul_top_eq_map]
      have h3 : (c * g - algebraMap R A r * g) * g ∈
          I • (Ideal.span {g} : Ideal A).restrictScalars R := by
        refine Submodule.smul_induction_on h2 ?_ ?_
        · intro i hi z _
          have hz : (i • z) * g = i • (z * g) := by
            rw [Algebra.smul_def, Algebra.smul_def, mul_assoc]
          rw [hz]
          exact Submodule.smul_mem_smul hi (hmem z)
        · intro y z hy hz
          rw [add_mul]
          exact add_mem hy hz
      have h4 : (c * g - algebraMap R A r * g) * g = c * g - algebraMap R A r * g := by
        linear_combination (c - algebraMap R A r) * hgg
      rw [h4] at h3
      have h5 : c * g = r • g + (c * g - algebraMap R A r * g) := by
        rw [Algebra.smul_def]; ring
      rw [h5]
      exact add_mem (Submodule.mem_sup_left (Submodule.smul_mem (Submodule.span R {g}) r
        (Submodule.mem_span_singleton_self g))) (Submodule.mem_sup_right h3)
    intro a
    obtain ⟨r, hr⟩ := Submodule.mem_span_singleton.mp
      (hMN (hmem a))
    exact ⟨r, by rw [← hr, Algebra.smul_def]⟩
  -- flatness: `g` is not annihilated by a nonzero scalar
  have inj : ∀ r : R, algebraMap R A r * g = 0 → r = 0 := by
    intro r hr
    have hrI : r ∈ I := by
      have hz : φ (algebraMap R A r * g) = 0 := by rw [hr, map_zero]
      rwa [map_mul, hφg, mul_one, AlgHom.commutes, Ideal.Quotient.algebraMap_eq,
        Ideal.Quotient.eq_zero_iff_mem] at hz
    have hsum : ∑ _i : Fin 1, r • g = 0 := by
      simp only [Finset.univ_unique, Finset.sum_singleton, Algebra.smul_def]
      exact hr
    obtain ⟨k, a, y, hy, ha⟩ := Module.Flat.isTrivialRelation_of_sum_smul_eq_zero
      (R := R) (M := A) (f := fun _ : Fin 1 => r) (x := fun _ : Fin 1 => g) hsum
    choose c hc using fun j : Fin k => Ideal.Quotient.mk_surjective (φ (y j))
    have hraj : ∀ j : Fin k, r * a 0 j = 0 := by
      intro j
      simpa only [Finset.univ_unique, Finset.sum_singleton,
        show (default : Fin 1) = 0 from rfl] using ha j
    have hone : φ g = ∑ j : Fin k, Ideal.Quotient.mk I (a 0 j) * φ (y j) := by
      rw [show g = ∑ j : Fin k, a 0 j • y j from hy 0, map_sum]
      refine Finset.sum_congr rfl fun j _ => ?_
      rw [map_smul, Algebra.smul_def, Ideal.Quotient.algebraMap_eq]
    have hu : 1 - ∑ j : Fin k, a 0 j * c j ∈ I := by
      refine Ideal.Quotient.eq_zero_iff_mem.mp ?_
      rw [map_sub, map_one, map_sum]
      simp only [map_mul, hc]
      rw [← hone, hφg, sub_self]
    have hru := mul_eq_zero_of_mem_of_sq_eq_bot hI hrI hu
    have expand : r * (1 - ∑ j : Fin k, a 0 j * c j) + ∑ j : Fin k, r * a 0 j * c j = r := by
      rw [mul_sub, mul_one, Finset.mul_sum]
      simp only [mul_assoc]
      rw [sub_add_cancel]
    rw [← expand, hru, zero_add]
    exact Finset.sum_eq_zero fun j _ => by rw [hraj j, zero_mul]
  -- the complementary quotient is the base ring
  have hKmul : ∀ z ∈ (Ideal.span {1 - g} : Ideal A), z * g = 0 := by
    intro z hz
    obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hz
    linear_combination (-c) * hgg
  have halg : ∀ r : R, algebraMap R (A ⧸ (Ideal.span {1 - g} : Ideal A)) r =
      Ideal.Quotient.mk _ (algebraMap R A r) := by
    intro r
    rw [IsScalarTower.algebraMap_apply R A (A ⧸ (Ideal.span {1 - g} : Ideal A)),
      Ideal.Quotient.algebraMap_eq]
  have hbij : Function.Bijective
      (algebraMap R (A ⧸ (Ideal.span {1 - g} : Ideal A))) := by
    refine ⟨(injective_iff_map_eq_zero _).mpr fun r hr => ?_, fun b => ?_⟩
    · refine inj r (hKmul _ ?_)
      rw [halg] at hr
      exact Ideal.Quotient.eq_zero_iff_mem.mp hr
    · obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective b
      obtain ⟨r, hr⟩ := key a
      refine ⟨r, ?_⟩
      rw [halg, Ideal.Quotient.mk_eq_mk_iff_sub_mem]
      refine Ideal.mem_span_singleton'.mpr ⟨algebraMap R A r - a, ?_⟩
      linear_combination hr
  set E : R ≃ₐ[R] A ⧸ (Ideal.span {1 - g} : Ideal A) :=
    AlgEquiv.ofBijective (Algebra.ofId R _) hbij with hE
  refine ⟨(E.symm : A ⧸ (Ideal.span {1 - g} : Ideal A) →ₐ[R] R).comp
    (Ideal.Quotient.mkₐ R _), fun a => ?_⟩
  have h1 : algebraMap R (A ⧸ (Ideal.span {1 - g} : Ideal A)) (E.symm (Ideal.Quotient.mk _ a)) =
      Ideal.Quotient.mk _ a :=
    E.apply_symm_apply _
  rw [halg, Ideal.Quotient.mk_eq_mk_iff_sub_mem] at h1
  have h2 : a * g = algebraMap R A (E.symm (Ideal.Quotient.mk _ a)) * g := by
    linear_combination -hKmul _ h1
  change Ideal.Quotient.mk I (E.symm (Ideal.Quotient.mk _ a)) = φ a
  rw [← Ideal.Quotient.algebraMap_eq, ← AlgHom.commutes φ]
  calc φ (algebraMap R A (E.symm (Ideal.Quotient.mk _ a)))
      = φ (algebraMap R A (E.symm (Ideal.Quotient.mk _ a)) * g) := by rw [map_mul, hφg, mul_one]
    _ = φ (a * g) := by rw [← h2]
    _ = φ a := by rw [map_mul, hφg, mul_one]

/-- **A flat unramified ring map is formally étale.** This is the ring-theoretic input for
Tag 04FF, which asserts the corresponding statement for morphisms of schemes. A flat, formally
unramified algebra of essentially finite type is formally étale: the lifting problem for a
square-zero ideal of an `R`-algebra `B` is base changed to `B`, where
`Stacks.FormallyEtale.exists_algHom_lift` solves it. -/
@[ega "IV 17.6.2" "c) ⇒ a), affine case",
  ega "IV 17.7.10" "special case",
  sga "4½ Arcata 2.1.1" "more general"]
theorem formallyEtale_of_flat [Algebra.FormallyUnramified R A] [Algebra.EssFiniteType R A]
    [Module.Flat R A] : Algebra.FormallyEtale R A := by
  have : Algebra.FormallySmooth R A := by
    refine Algebra.FormallySmooth.of_comp_surjective fun B _ _ I hI φ => ?_
    obtain ⟨ψ, hψ⟩ := exists_algHom_lift (R := B) (A := B ⊗[R] A) I hI
      (Algebra.TensorProduct.lift (Algebra.ofId B (B ⧸ I)) φ fun _ _ => Commute.all _ _)
    refine ⟨(ψ.restrictScalars R).comp Algebra.TensorProduct.includeRight, ?_⟩
    ext a
    simpa using hψ (1 ⊗ₜ a)
  exact Algebra.FormallyEtale.of_formallyUnramified_and_formallySmooth

end Stacks.FormallyEtale

end
