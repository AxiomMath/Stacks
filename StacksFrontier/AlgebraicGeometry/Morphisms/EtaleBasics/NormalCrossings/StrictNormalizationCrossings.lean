/-!
# A strict normal crossings divisor satisfies the normalization criterion

Let `D` be a strict normal crossings divisor on a locally Noetherian scheme `X`. This file proves
that `D` satisfies condition (2) of Tag 0CBR, that is
`Stacks.Divisors.IsNormalizationCrossingsDivisor`: the closed subscheme cut out by `D` is
reduced, its normalization `ν : D^ν ⟶ D` is unramified, and for every `n ≥ 1` the scheme `Z_n`,
the complement of the fat diagonal in the `n`-fold fibre power of `ν`, is regular and maps to `X`
by a local complete intersection morphism whose conormal sheaf is locally free of rank `n`.

## Main results

* `Stacks.Divisors.isNormalizationCrossingsDivisor_of_isStrictNormalCrossingsDivisor`: the
  implication (1) to (2) of Tag 0CBR in the strict case.

## Implementation notes

Reducedness is the first clause of
`Stacks.Divisors.isStrictNormalCrossingsDivisor_iff` and unramifiedness of the normalization is
`Stacks.Divisors.unramified_divisorNormalization_of_isStrictNormalCrossingsDivisor`, so only the
three clauses attached to `Z_{m+1}` remain. All three are checked on the open cover of `Z_{m+1}`
supplied by `Stacks.Divisors.exists_componentIntersection_cover_normalizationDistinct`, whose
members are isomorphic over `X` to scheme-theoretic intersections of `m + 1` distinct irreducible
components of `D`.

Working on a cover is unavoidable rather than a convenience: `Z_n ⟶ X` is in general not an
immersion, since distinct orderings of the same `n` components give distinct points of `Z_n` with
the same image in `X`. Only its restriction to a member of the cover is a closed immersion.

Over one member of the cover everything comes from the stalk description of a component
intersection,
`Stacks.Divisors.exists_isWeaklyRegular_ofList_eq_stalk_componentIntersection`: the stalk of the
ideal sheaf of an intersection of `r` components is generated by a weakly regular sequence of
length `r` taken from a regular system of parameters of the ambient regular local ring. That
sequence is a `List`, while both consumers of it — the Koszul criterion for a local complete
intersection morphism and the rank criterion for the conormal sheaf — ask for a `Fin r`-indexed
tuple, so the conversion is isolated in a private lemma.

Regularity of `Z_{m+1}` is Zariski-local by Tag 02IU and the local complete intersection property
is Zariski-local on the source, so those two clauses transfer along the cover directly. For the
conormal sheaf the transfer is in two steps: the restriction of the conormal sheaf of
`Z_{m+1} ⟶ X` to a member `V` of the cover is the conormal sheaf of the induced morphism
`V ⟶ (⊤ : X.Opens)`, by Tag 04FA, and that morphism sits in a cartesian square over the closed
immersion of the component intersection whose vertical legs are isomorphisms, so Tag 04F9
identifies the two conormal sheaves up to a pullback, which preserves the rank.

## References

* [Stacks Project, Tag 0CBR](https://stacks.math.columbia.edu/tag/0CBR)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open Stacks.Thickenings (universalConormalSheaf)

universe u

namespace Stacks.Divisors

/-- A list of length `r` is the `List.ofFn` of a `Fin r`-indexed tuple whose range is the set of
members of the list. This is the bridge between the `List`-valued stalk description of a
component intersection and the `Fin`-indexed hypotheses of the Koszul and conormal-rank
criteria. -/
private lemma exists_finTuple_ofFn_eq_of_length {R : Type*} {r : ℕ} (xs : List R)
    (hlen : xs.length = r) :
    ∃ g : Fin r → R, List.ofFn g = xs ∧ Set.range g = {a | a ∈ xs} := by
  subst hlen
  refine ⟨xs.get, List.ofFn_get xs, ?_⟩
  ext a
  simp only [Set.mem_range, Set.mem_ofPred_eq, List.mem_iff_get]

variable {X : Scheme.{u}} [IsLocallyNoetherian X] (D : X.IdealSheafData)

/-- At every point of a nonempty intersection of `r` irreducible components of a strict normal
crossings divisor, the ideal of the intersection in the ambient local ring is generated by a
weakly regular sequence of `r` elements of the maximal ideal, read as a `Fin r`-indexed tuple. -/
private theorem exists_finTuple_stalk_componentIntersection
    (h : IsStrictNormalCrossingsDivisor D)
    (J : Finset (irreducibleComponents D.subscheme)) (m : ℕ)
    (hcard : J.card = m + 1) (z : (componentIntersection D J).subscheme) :
    ∃ g : Fin (m + 1) → X.presheaf.stalk ((componentIntersection D J).subschemeι.base z),
      RingTheory.Sequence.IsWeaklyRegular
          (X.presheaf.stalk ((componentIntersection D J).subschemeι.base z)) (List.ofFn g) ∧
        (∀ k, g k ∈ IsLocalRing.maximalIdeal
          (X.presheaf.stalk ((componentIntersection D J).subschemeι.base z))) ∧
          Ideal.span (Set.range g) =
            RingHom.ker ((componentIntersection D J).subschemeι.stalkMap z).hom := by
  have hJ : J.Nonempty := Finset.card_pos.mp (by omega)
  have hxs : ((componentIntersection D J).subschemeι.base z) ∈
      (((componentIntersection D J).support : Set X)) := by
    rw [← Scheme.IdealSheafData.range_subschemeι]
    exact ⟨z, rfl⟩
  obtain ⟨-, xs, hlen, hmax, hreg, hofList⟩ :=
    exists_isWeaklyRegular_ofList_eq_stalk_componentIntersection D h J hJ _ hxs
  obtain ⟨g, hofn, hrange⟩ := exists_finTuple_ofFn_eq_of_length xs (hlen.trans hcard)
  have hmem : ∀ k, g k ∈ xs := by
    intro k
    have : g k ∈ Set.range g := ⟨k, rfl⟩
    rwa [hrange] at this
  refine ⟨g, hofn ▸ hreg, fun k => hmax _ (hmem k), ?_⟩
  rw [kernel_stalkMap_subscheme_eq_idealStalk, ← hofList]
  exact congrArg Ideal.span hrange

/-- The closed immersion of a nonempty intersection of `r` irreducible components of a strict
normal crossings divisor into the ambient scheme is a local complete intersection morphism: its
stalk ideals are generated by weakly regular sequences of length `r`. -/
private theorem isLocalCompleteIntersectionMorphism_componentIntersectionSubschemeι
    (h : IsStrictNormalCrossingsDivisor D)
    (J : Finset (irreducibleComponents D.subscheme)) (m : ℕ)
    (hcard : J.card = m + 1) :
    IsLocalCompleteIntersectionMorphism (componentIntersection D J).subschemeι :=
  AlgebraicGeometry.isLocalCompleteIntersectionMorphism_of_stalk_isWeaklyRegular
    (componentIntersection D J).subschemeι (m + 1)
    (exists_finTuple_stalk_componentIntersection D h J m hcard)

/-- The conormal sheaf of the closed immersion of a nonempty intersection of `r` irreducible
components of a strict normal crossings divisor into the ambient scheme is finite locally free of
rank `r`. -/
private theorem isFiniteLocallyFreeOfRank_universalConormalSheaf_componentIntersectionSubschemeι
    (h : IsStrictNormalCrossingsDivisor D)
    (J : Finset (irreducibleComponents D.subscheme)) (m : ℕ)
    (hcard : J.card = m + 1) :
    SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (universalConormalSheaf (componentIntersection D J).subschemeι) (m + 1) :=
  AlgebraicGeometry.isFiniteLocallyFreeOfRank_universalConormalSheaf_of_stalk_span
    (componentIntersection D J).subschemeι (m + 1) fun z => by
      obtain ⟨g, hreg, -, hspan⟩ :=
        exists_finTuple_stalk_componentIntersection D h J m hcard z
      exact ⟨g, hreg, hspan.symm⟩

/-- **The regularity clause of condition (2) of Tag 0CBR for a strict normal crossings divisor.**
The scheme `Z_{m+1}` is covered by opens isomorphic to intersections of `m + 1` irreducible
components of the divisor, each of which is regular by Tag 0BIA, and regularity is Zariski
local. -/
private theorem isRegular_normalizationDistinct_succ_of_isStrictNormalCrossingsDivisor
    (h : IsStrictNormalCrossingsDivisor D) (m : ℕ) :
    AlgebraicGeometry.IsRegular (normalizationDistinct D (m + 1)) := by
  obtain ⟨ι, V, hVtop, hV⟩ := exists_componentIntersection_cover_normalizationDistinct D h m
  refine ((isRegular_tfae_cover (normalizationDistinct D (m + 1))).out 4 1 rfl rfl).mp
    ⟨ι, V, hVtop, fun a => ?_⟩
  obtain ⟨J, hJcard, e, -⟩ := hV a
  have hreg : AlgebraicGeometry.IsRegular (componentIntersection D J).subscheme :=
    (((isStrictNormalCrossingsDivisor_iff D h.1).mp h).2.2 J
      (Finset.card_pos.mp (by omega))).1
  exact ObjectProperty.prop_of_iso (fun Y : Scheme.{u} => AlgebraicGeometry.IsRegular Y)
    e.symm hreg

/-- **The local complete intersection clause of condition (2) of Tag 0CBR for a strict normal
crossings divisor.** On each member of the cover of `Z_{m+1}` by opens isomorphic over `X` to
intersections of `m + 1` irreducible components, the morphism to `X` is the closed immersion of
such an intersection composed with an isomorphism, and the local complete intersection property
is Zariski local on the source. -/
private theorem isLocalCompleteIntersectionMorphism_normalizationDistinctToAmbient_succ
    (h : IsStrictNormalCrossingsDivisor D) (m : ℕ) :
    IsLocalCompleteIntersectionMorphism (normalizationDistinctToAmbient D (m + 1)) := by
  obtain ⟨ι, V, hVtop, hV⟩ := exists_componentIntersection_cover_normalizationDistinct D h m
  refine IsZariskiLocalAtSource.of_iSup_eq_top
    (P := @IsLocalCompleteIntersectionMorphism.{u}) V hVtop fun a => ?_
  obtain ⟨J, hJcard, e, he⟩ := hV a
  rw [← he, MorphismProperty.cancel_left_of_respectsIso
    (@IsLocalCompleteIntersectionMorphism.{u})]
  exact isLocalCompleteIntersectionMorphism_componentIntersectionSubschemeι D h J m hJcard

/-- **The conormal rank clause of condition (2) of Tag 0CBR for a strict normal crossings
divisor.** On a member `V` of the cover of `Z_{m+1}`, the restriction of the conormal sheaf of
`Z_{m+1} ⟶ X` is the conormal sheaf of `V ⟶ (⊤ : X.Opens)` by Tag 04FA, and the latter is the
pullback along an isomorphism of the conormal sheaf of the closed immersion of an intersection of
`m + 1` irreducible components by Tag 04F9. -/
private theorem isFiniteLocallyFreeOfRank_universalConormalSheaf_normalizationDistinct_succ
    [Unramified (divisorNormalization D)] (h : IsStrictNormalCrossingsDivisor D) (m : ℕ) :
    haveI := formallyUnramified_normalizationDistinctToAmbient D (m + 1)
    SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (universalConormalSheaf (normalizationDistinctToAmbient D (m + 1))) (m + 1) := by
  have := formallyUnramified_normalizationDistinctToAmbient D (m + 1)
  obtain ⟨ι, V, hVtop, hV⟩ := exists_componentIntersection_cover_normalizationDistinct D h m
  refine (Scheme.Modules.isFiniteLocallyFreeOfRank_iff _ _).mp
    (Scheme.Modules.isFiniteLocallyFreeOfRank_of_iSup_eq_top V hVtop fun a => ?_)
  obtain ⟨J, hJcard, e, he⟩ := hV a
  have hUV : V a ≤ normalizationDistinctToAmbient D (m + 1) ⁻¹ᵁ (⊤ : X.Opens) := by simp
  have : FormallyUnramified
      ((normalizationDistinctToAmbient D (m + 1)).resLE (⊤ : X.Opens) (V a) hUV) :=
    Stacks.Thickenings.formallyUnramified_resLE (normalizationDistinctToAmbient D (m + 1)) hUV
  have hsq : IsPullback ((normalizationDistinctToAmbient D (m + 1)).resLE (⊤ : X.Opens) (V a) hUV)
      e.hom X.topIso.hom (componentIntersection D J).subschemeι := by
    refine IsPullback.of_vert_isIso ⟨?_⟩
    rw [Scheme.topIso_hom, Scheme.Hom.resLE_comp_ι, he]
  have hpull : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      ((Scheme.Modules.pullback e.hom).obj
        (universalConormalSheaf (componentIntersection D J).subschemeι)) (m + 1) :=
    Scheme.Modules.isFiniteLocallyFreeOfRank_pullback_obj e.hom _ (m + 1)
      (isFiniteLocallyFreeOfRank_universalConormalSheaf_componentIntersectionSubschemeι D h J m
        hJcard)
  have hres : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (universalConormalSheaf
        ((normalizationDistinctToAmbient D (m + 1)).resLE (⊤ : X.Opens) (V a) hUV)) (m + 1) :=
    SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso.{u, u, u}
      (universalConormalSheafFlatBaseChangeIso hsq) hpull
  exact (Scheme.Modules.isFiniteLocallyFreeOfRank_iff _ _).mpr
    (SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso.{u, u, u}
      (universalConormalSheafRestrictIso (normalizationDistinctToAmbient D (m + 1)) hUV).symm hres)

/-- **A strict normal crossings divisor satisfies condition (2) of Tag 0CBR.** It is reduced and
its normalization is unramified by Tag 0BIA, and for `n ≥ 1` the scheme `Z_n` is covered by opens
isomorphic over the ambient scheme to intersections of `n` distinct irreducible components of the
divisor, which makes `Z_n` regular, makes `Z_n ⟶ X` a local complete intersection morphism, and
makes the conormal sheaf of `Z_n ⟶ X` finite locally free of rank `n`. -/
theorem isNormalizationCrossingsDivisor_of_isStrictNormalCrossingsDivisor
    (h : IsStrictNormalCrossingsDivisor D) : IsNormalizationCrossingsDivisor D := by
  have hν : Unramified (divisorNormalization D) :=
    unramified_divisorNormalization_of_isStrictNormalCrossingsDivisor D h
  refine ⟨((isStrictNormalCrossingsDivisor_iff D h.1).mp h).1, hν, fun n hn => ?_⟩
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  exact ⟨isRegular_normalizationDistinct_succ_of_isStrictNormalCrossingsDivisor D h m,
    isLocalCompleteIntersectionMorphism_normalizationDistinctToAmbient_succ D h m,
    isFiniteLocallyFreeOfRank_universalConormalSheaf_normalizationDistinct_succ D h m⟩

end Stacks.Divisors

end
