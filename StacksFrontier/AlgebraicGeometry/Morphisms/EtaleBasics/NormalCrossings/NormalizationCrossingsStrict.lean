universe u

namespace Stacks.Divisors

/-! ### A list of generators as a supremum of principal ideals -/

/-- The ideal generated by the entries of `List.ofFn g` is the supremum of the principal ideals
generated by the values of `g`. -/
private theorem ofList_ofFn_eq_iSup_span_singleton {R : Type*} [CommRing R] {k : ℕ}
    (g : Fin k → R) :
    Ideal.ofList (List.ofFn g) = ⨆ i, Ideal.span {g i} := by
  have hset : {r | r ∈ List.ofFn g} = ⋃ i, ({g i} : Set R) := by
    ext r
    simp [List.mem_ofFn, eq_comm]
  rw [Ideal.ofList, hset]
  refine le_antisymm (Ideal.span_le.mpr fun r hr => ?_)
    (iSup_le fun i => Ideal.span_le.mpr fun r hr =>
      Ideal.subset_span (Set.mem_iUnion.mpr ⟨i, hr⟩))
  obtain ⟨i, hi⟩ := Set.mem_iUnion.mp hr
  exact le_iSup (fun i => Ideal.span {g i}) i (Ideal.subset_span hi)

/-- A point of the support of an ideal sheaf lifts to a point of the subscheme it cuts out. -/
private theorem exists_subschemeι_eq_of_mem_support {Y : Scheme.{u}} (I : Y.IdealSheafData)
    {y : Y} (hy : y ∈ I.support) : ∃ z : I.subscheme, I.subschemeι z = y :=
  (Scheme.IdealSheafData.range_subschemeι (I := I)).ge hy

/-! ### Transporting condition (2) across the cover of the distinct locus -/

section Cover

variable {X : Scheme.{u}} [IsLocallyNoetherian X] {E : X.IdealSheafData}
  {m : ℕ} {A : Fin m → Scheme.{u}}

/-- **The three clauses of condition (2) read on an intersection of branches.** For an injective
tuple `t` of `n + 1` branch indices, the closed subscheme of the ambient scheme cut out by the
supremum of the corresponding branch ideals has regular local rings, its closed immersion is a
local complete intersection morphism, and each of its stalk ideals needs exactly `n + 1`
generators. -/
private theorem lci_regular_spanFinrank_iSup_branchIdeal
    (hE : IsNormalizationCrossingsDivisor E)
    (ε : ∀ j, A j ⟶ divisorNormalizationScheme E)
    (hopen : ∀ j, IsOpenImmersion (ε j))
    (hclosed : ∀ j, IsClosedImmersion (ε j ≫ divisorNormalizationToAmbient E))
    (hcover : ∀ y : divisorNormalizationScheme E, ∃ j, y ∈ Set.range (ε j).base)
    (hdisj : ∀ j k, j ≠ k → Disjoint (Set.range (ε j).base) (Set.range (ε k).base))
    (hiso : ∀ j, ∃ e : A j ≅ ((ε j ≫ divisorNormalizationToAmbient E).ker).subscheme,
        e.hom ≫ ((ε j ≫ divisorNormalizationToAmbient E).ker).subschemeι =
          ε j ≫ divisorNormalizationToAmbient E)
    (n : ℕ) (t : Fin (n + 1) → Fin m) (ht : Function.Injective t) :
    IsLocalCompleteIntersectionMorphism
        (⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).subschemeι ∧
      ∀ z : (⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).subscheme,
        IsRegularLocalRing
            ((⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).subscheme.presheaf.stalk z) ∧
          (RingHom.ker
            ((⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).subschemeι.stalkMap
              z).hom).spanFinrank = n + 1 := by
  obtain ⟨hν, hZ⟩ := hE.2
  have : Unramified (divisorNormalization E) := hν
  have : ∀ j, IsOpenImmersion (ε j) := hopen
  have : ∀ j, IsClosedImmersion (ε j ≫ divisorNormalization E ≫ E.subschemeι) := hclosed
  have : IsIso (Scheme.Opens.ι (⊤ : X.Opens)) :=
    ⟨(Scheme.topIso X).inv, (Scheme.topIso X).hom_inv_id, (Scheme.topIso X).inv_hom_id⟩
  obtain ⟨hregZ, hlciZ, hrankZ⟩ := hZ (n + 1) (Nat.succ_le_succ (Nat.zero_le n))
  have := formallyUnramified_normalizationDistinctToAmbient E (n + 1)
  obtain ⟨V, -, hV⟩ :=
    exists_tupleOpens_cover_fibrePowerDistinctOpens (divisorNormalization E) E.subschemeι ε
      hcover hdisj (fun j => (ε j ≫ divisorNormalizationToAmbient E).ker) hiso n
      (normalizationDistinctOpens E (n + 1)) rfl
  obtain ⟨e, he⟩ := hV ⟨t, ht⟩
  replace he : e.hom ≫ (⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).subschemeι =
      (V ⟨t, ht⟩).ι ≫ normalizationDistinctToAmbient E (n + 1) := he
  -- the local complete intersection clause
  have hWlci : IsLocalCompleteIntersectionMorphism
      ((V ⟨t, ht⟩).ι ≫ normalizationDistinctToAmbient E (n + 1)) :=
    isLocalCompleteIntersectionMorphism_comp _ _
      (isLocalCompleteIntersectionMorphism_of_isOpenImmersion (V ⟨t, ht⟩).ι) hlciZ
  have hKlci : IsLocalCompleteIntersectionMorphism
      (⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).subschemeι := by
    have hfac : (⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).subschemeι =
        e.inv ≫ (V ⟨t, ht⟩).ι ≫ normalizationDistinctToAmbient E (n + 1) := by
      rw [← he, Iso.inv_hom_id_assoc]
    rw [hfac]
    exact isLocalCompleteIntersectionMorphism_comp _ _
      (isLocalCompleteIntersectionMorphism_of_isOpenImmersion e.inv) hWlci
  refine ⟨hKlci, ?_⟩
  -- the conormal rank clause, transported to the closed immersion of the intersection
  have hUV : V ⟨t, ht⟩ ≤ (normalizationDistinctToAmbient E (n + 1)) ⁻¹ᵁ (⊤ : X.Opens) := by simp
  have : FormallyUnramified
      ((normalizationDistinctToAmbient E (n + 1)).resLE ⊤ (V ⟨t, ht⟩) hUV) :=
    Stacks.Thickenings.formallyUnramified_resLE _ hUV
  have hres : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (universalConormalSheaf
        ((normalizationDistinctToAmbient E (n + 1)).resLE ⊤ (V ⟨t, ht⟩) hUV)) (n + 1) :=
    SheafOfModules.IsFiniteLocallyFreeOfRank.of_iso.{u, u, u}
      (universalConormalSheafRestrictIso (normalizationDistinctToAmbient E (n + 1)) hUV)
      ((Scheme.Modules.isFiniteLocallyFreeOfRank_iff _ (n + 1)).mp
        (Scheme.Modules.IsFiniteLocallyFreeOfRank.restrict (V ⟨t, ht⟩).ι
          ((Scheme.Modules.isFiniteLocallyFreeOfRank_iff _ (n + 1)).mpr hrankZ)))
  have hsq : IsPullback ((normalizationDistinctToAmbient E (n + 1)).resLE ⊤ (V ⟨t, ht⟩) hUV)
      e.hom (Scheme.Opens.ι (⊤ : X.Opens))
      (⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).subschemeι :=
    IsPullback.of_vert_isIso ⟨by rw [Scheme.Hom.resLE_comp_ι]; exact he.symm⟩
  have hinv : ∀ z, e.hom.base (e.inv.base z) = z := fun z => by
    rw [← Scheme.Hom.comp_apply, Iso.inv_hom_id]
    rfl
  have hfl : SheafOfModules.IsFiniteLocallyFree.{u, u, u}
      (universalConormalSheaf
        (⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).subschemeι) :=
    isFiniteLocallyFree_universalConormalSheaf_of_isLocalCompleteIntersection _ hKlci
  have hKrank : SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u}
      (universalConormalSheaf
        (⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).subschemeι) (n + 1) := by
    refine isFiniteLocallyFreeOfRank_universalConormalSheaf_of_forall_isPullback _ (n + 1) hfl
      fun z => ?_
    exact ⟨(V ⟨t, ht⟩).toScheme, (⊤ : X.Opens).toScheme, _, e.hom,
      Scheme.Opens.ι (⊤ : X.Opens), hsq, e.inv.base z, inferInstance, hinv z, hres⟩
  intro z
  refine ⟨?_, spanFinrank_ker_stalkMap_eq_of_isFiniteLocallyFreeOfRank_universalConormalSheaf
    _ (n + 1) hKrank z⟩
  -- the regularity clause, transported pointwise
  obtain ⟨w, rfl⟩ : ∃ w, e.hom.base w = z := ⟨e.inv.base z, hinv z⟩
  refine (isRegularLocalRing_stalk_iff_of_isOpenImmersion e.hom w).mp ?_
  refine (isRegularLocalRing_stalk_iff_of_isOpenImmersion (V ⟨t, ht⟩).ι w).mpr ?_
  exact ((isRegular_iff_regular_stalks (normalizationDistinct E (n + 1))).mp hregZ).2 _

/-- **An intersection of branches is cut out by a regular sequence of the expected length.** For
an injective tuple `t` of `n + 1` branch indices and a point `x` in the support of the supremum of
the corresponding branch ideals, the stalk of that supremum at `x` is generated by a regular
sequence of length `n + 1` of the local ring at `x`. -/
private theorem exists_isRegular_ofList_eq_stalk_iSup_branchIdeal
    (hE : IsNormalizationCrossingsDivisor E)
    (ε : ∀ j, A j ⟶ divisorNormalizationScheme E)
    (hopen : ∀ j, IsOpenImmersion (ε j))
    (hclosed : ∀ j, IsClosedImmersion (ε j ≫ divisorNormalizationToAmbient E))
    (hcover : ∀ y : divisorNormalizationScheme E, ∃ j, y ∈ Set.range (ε j).base)
    (hdisj : ∀ j k, j ≠ k → Disjoint (Set.range (ε j).base) (Set.range (ε k).base))
    (hiso : ∀ j, ∃ e : A j ≅ ((ε j ≫ divisorNormalizationToAmbient E).ker).subscheme,
        e.hom ≫ ((ε j ≫ divisorNormalizationToAmbient E).ker).subschemeι =
          ε j ≫ divisorNormalizationToAmbient E)
    (n : ℕ) (t : Fin (n + 1) → Fin m) (ht : Function.Injective t) (x : X)
    (hx : x ∈ (⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).support) :
    ∃ rs : List (X.presheaf.stalk x), RingTheory.Sequence.IsRegular (X.presheaf.stalk x) rs ∧
      Ideal.ofList rs =
        IdealSheafData.stalk (⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker) x ∧
      rs.length = n + 1 := by
  obtain ⟨hKlci, hKpt⟩ :=
    lci_regular_spanFinrank_iSup_branchIdeal hE ε hopen hclosed hcover hdisj hiso n t ht
  obtain ⟨z, rfl⟩ := exists_subschemeι_eq_of_mem_support _ hx
  have hkos : IsKoszulRegularImmersion
      (⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).subschemeι :=
    isKoszulRegularImmersion_of_koszul_comp_smooth _ (𝟙 X) (by simpa using hKlci)
  have hregimm : IsRegularImmersion
      (⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).subschemeι :=
    (isRegularImmersion_iff_isKoszulRegularImmersion _).mpr hkos
  obtain ⟨rs, hrsreg, hrsgen⟩ :=
    exists_isRegular_ker_stalkMap_of_isRegularImmersion _ hregimm z
  refine ⟨rs, hrsreg, hrsgen.trans (kernel_stalkMap_subscheme_eq_idealStalk _ z), ?_⟩
  have hlen := Koszul.spanFinrank_eq_length_of_isRegular rs hrsreg
  rw [hrsgen, (hKpt z).2] at hlen
  exact hlen.symm

/-- **Each branch is a principal divisor in every local ring it meets.** This is the case of one
single branch of `Stacks.Divisors.exists_isRegular_ofList_eq_stalk_iSup_branchIdeal`. -/
private theorem exists_span_singleton_eq_stalk_branchIdeal
    (hE : IsNormalizationCrossingsDivisor E)
    (ε : ∀ j, A j ⟶ divisorNormalizationScheme E)
    (hopen : ∀ j, IsOpenImmersion (ε j))
    (hclosed : ∀ j, IsClosedImmersion (ε j ≫ divisorNormalizationToAmbient E))
    (hcover : ∀ y : divisorNormalizationScheme E, ∃ j, y ∈ Set.range (ε j).base)
    (hdisj : ∀ j k, j ≠ k → Disjoint (Set.range (ε j).base) (Set.range (ε k).base))
    (hiso : ∀ j, ∃ e : A j ≅ ((ε j ≫ divisorNormalizationToAmbient E).ker).subscheme,
        e.hom ≫ ((ε j ≫ divisorNormalizationToAmbient E).ker).subschemeι =
          ε j ≫ divisorNormalizationToAmbient E)
    (j : Fin m) (x : X) (hx : x ∈ (ε j ≫ divisorNormalizationToAmbient E).ker.support) :
    ∃ g : X.presheaf.stalk x,
      IdealSheafData.stalk ((ε j ≫ divisorNormalizationToAmbient E).ker) x = Ideal.span {g} := by
  have hsub : Subsingleton (Fin (0 + 1)) := by
    simpa using (inferInstance : Subsingleton (Fin 1))
  have hsingle : (⨆ _k : Fin (0 + 1), (ε j ≫ divisorNormalizationToAmbient E).ker) =
      (ε j ≫ divisorNormalizationToAmbient E).ker := by
    simp
  obtain ⟨rs, -, hgen, hlen⟩ :=
    exists_isRegular_ofList_eq_stalk_iSup_branchIdeal hE ε hopen hclosed hcover hdisj hiso 0
      (fun _ => j) (fun a b _ => Subsingleton.elim a b) x (by rw [hsingle]; exact hx)
  rw [hsingle] at hgen
  obtain ⟨g, rfl⟩ : ∃ g, rs = [g] := List.length_eq_one_iff.mp hlen
  exact ⟨g, hgen.symm.trans (by simp [Ideal.ofList])⟩

end Cover

/-! ### The local equation of the divisor -/

/-- **The strict normal crossings data at a point.** Under condition (2) of Tag 0CBR together with
a finite disjoint cover of the normalization by opens mapping to the ambient scheme by closed
immersions, the local ring at a point of the support of the divisor is regular and the stalk of
the divisor there is generated by the product of a nonempty initial segment of a regular system of
parameters. -/
private theorem isRegularLocalRing_and_stalk_eq_prod_take
    {U : Scheme.{u}} [IsLocallyNoetherian U] {E : U.IdealSheafData}
    (hE : IsNormalizationCrossingsDivisor E)
    {m : ℕ} {A : Fin m → Scheme.{u}}
    (ε : ∀ j, A j ⟶ divisorNormalizationScheme E)
    (hopen : ∀ j, IsOpenImmersion (ε j))
    (hclosed : ∀ j, IsClosedImmersion (ε j ≫ divisorNormalizationToAmbient E))
    (hcover : ∀ y : divisorNormalizationScheme E, ∃ j, y ∈ Set.range (ε j).base)
    (hdisj : ∀ j k, j ≠ k → Disjoint (Set.range (ε j).base) (Set.range (ε k).base))
    (hiso : ∀ j, ∃ e : A j ≅ ((ε j ≫ divisorNormalizationToAmbient E).ker).subscheme,
        e.hom ≫ ((ε j ≫ divisorNormalizationToAmbient E).ker).subschemeι =
          ε j ≫ divisorNormalizationToAmbient E)
    (x : U) (hx : x ∈ E.support) :
    IsRegularLocalRing (U.presheaf.stalk x) ∧
      ∃ (rs : List (U.presheaf.stalk x)) (r : ℕ), IsLocalRing.IsSystemOfParameters rs ∧
        Ideal.ofList rs = IsLocalRing.maximalIdeal (U.presheaf.stalk x) ∧ 1 ≤ r ∧
          r ≤ rs.length ∧ IdealSheafData.stalk E x = Ideal.span {(rs.take r).prod} := by
  classical
  have : IsReduced E.subscheme := hE.1
  obtain ⟨hν, -⟩ := hE.2
  have : Unramified (divisorNormalization E) := hν
  have : IsLocallyNoetherian E.subscheme :=
    LocallyOfFiniteType.isLocallyNoetherian E.subschemeι
  have hsurj : Surjective (divisorNormalization E) :=
    Scheme.surjective_normalization E.subscheme
      (finite_irreducibleComponents_of_isCompact E.subscheme)
  have : ∀ j, IsOpenImmersion (ε j) := hopen
  have : ∀ j, IsClosedImmersion (ε j ≫ divisorNormalizationToAmbient E) := hclosed
  -- a local equation for each branch through `x`
  have hbranch : ∀ j : Fin m, x ∈ (ε j ≫ divisorNormalizationToAmbient E).ker.support →
      ∃ g : U.presheaf.stalk x,
        IdealSheafData.stalk ((ε j ≫ divisorNormalizationToAmbient E).ker) x =
          Ideal.span {g} :=
    fun j hj =>
      exists_span_singleton_eq_stalk_branchIdeal hE ε hopen hclosed hcover hdisj hiso j x hj
  choose! g hg using hbranch
  -- the branches through `x`
  set S : Finset (Fin m) :=
    Finset.univ.filter
      (fun j => x ∈ (ε j ≫ divisorNormalizationToAmbient E).ker.support) with hS
  have hmemS : ∀ j, j ∈ S ↔ x ∈ (ε j ≫ divisorNormalizationToAmbient E).ker.support := by
    intro j; simp [hS]
  have hSne : S.Nonempty := by
    obtain ⟨y₀, hy₀⟩ := exists_subschemeι_eq_of_mem_support E hx
    obtain ⟨y, hy⟩ := (divisorNormalization E).surjective y₀
    obtain ⟨j, z, hz⟩ := hcover y
    refine ⟨j, (hmemS j).2 (Scheme.Hom.range_subset_ker_support _ ⟨z, ?_⟩)⟩
    rw [Scheme.Hom.comp_apply, hz]
    change (divisorNormalization E ≫ E.subschemeι).base y = x
    rw [Scheme.Hom.comp_apply, hy]
    exact hy₀
  obtain ⟨n, hn⟩ : ∃ n, S.card = n + 1 :=
    ⟨S.card - 1, by have := Finset.card_pos.mpr hSne; omega⟩
  -- an injective enumeration of them
  set t : Fin (n + 1) → Fin m := fun k => (S.orderIsoOfFin hn k : Fin m) with hT
  have ht : Function.Injective t := fun a b hab =>
    (S.orderIsoOfFin hn).injective (Subtype.ext hab)
  have htS : ∀ k, t k ∈ S := fun k => (S.orderIsoOfFin hn k).2
  have htsurj : ∀ j ∈ S, ∃ k, t k = j := by
    intro j hj
    obtain ⟨k, hk⟩ := (S.orderIsoOfFin hn).surjective ⟨j, hj⟩
    exact ⟨k, congrArg Subtype.val hk⟩
  have hgt : ∀ k, IdealSheafData.stalk ((ε (t k) ≫ divisorNormalizationToAmbient E).ker) x =
      Ideal.span {g (t k)} := fun k => hg (t k) ((hmemS (t k)).1 (htS k))
  -- the stalk of the intersection of those branches is generated by their equations
  have hstalkK :
      IdealSheafData.stalk (⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker) x =
        Ideal.ofList (List.ofFn fun k => g (t k)) := by
    rw [idealStalk_iSup_eq_iSup, ofList_ofFn_eq_iSup_span_singleton]
    exact iSup_congr hgt
  have hgmax : ∀ k, g (t k) ∈ IsLocalRing.maximalIdeal (U.presheaf.stalk x) := by
    intro k
    have hne : IdealSheafData.stalk ((ε (t k) ≫ divisorNormalizationToAmbient E).ker) x ≠ ⊤ := by
      rw [Ne, IdealSheafData.stalk_eq_top_iff_not_mem_support, not_not]
      exact (hmemS (t k)).1 (htS k)
    refine IsLocalRing.le_maximalIdeal hne ?_
    rw [hgt k]
    exact Ideal.subset_span rfl
  have hfsmax : ∀ a ∈ List.ofFn fun k => g (t k),
      a ∈ IsLocalRing.maximalIdeal (U.presheaf.stalk x) := by
    intro a ha
    obtain ⟨k, rfl⟩ := List.mem_ofFn.mp ha
    exact hgmax k
  have hfsle : Ideal.ofList (List.ofFn fun k => g (t k)) ≤
      IsLocalRing.maximalIdeal (U.presheaf.stalk x) :=
    Ideal.span_le.mpr fun a ha => hfsmax a ha
  -- `x` lies in the support of that intersection
  have hxK : x ∈ (⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).support := by
    by_contra hcon
    rw [← IdealSheafData.stalk_eq_top_iff_not_mem_support, hstalkK] at hcon
    exact (IsLocalRing.maximalIdeal.isMaximal (U.presheaf.stalk x)).ne_top
      (top_le_iff.mp (le_trans (le_of_eq hcon.symm) hfsle))
  -- the branch equations form a regular sequence
  obtain ⟨rs₀, hrs₀reg, hrs₀gen, hrs₀len⟩ :=
    exists_isRegular_ofList_eq_stalk_iSup_branchIdeal hE ε hopen hclosed hcover hdisj hiso n t ht
      x hxK
  have hfsreg : RingTheory.Sequence.IsRegular (U.presheaf.stalk x)
      (List.ofFn fun k => g (t k)) :=
    Koszul.isRegular_of_ofList_eq_of_length_eq _ rs₀
      (by rw [List.length_ofFn, hrs₀len]) (by rw [hrs₀gen, hstalkK]) hrs₀reg
  -- the quotient by them is a regular local ring
  have hquot : IsRegularLocalRing
      (U.presheaf.stalk x ⧸ Ideal.ofList (List.ofFn fun k => g (t k))) := by
    obtain ⟨-, hKpt⟩ :=
      lci_regular_spanFinrank_iSup_branchIdeal hE ε hopen hclosed hcover hdisj hiso n t ht
    obtain ⟨z, hz⟩ := exists_subschemeι_eq_of_mem_support _ hxK
    have hiso' := ((⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).subschemeι.stalkMap
      z).hom.quotientKerEquivOfSurjective
        ((⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).subschemeι.stalkMap_surjective z)
    have h2 : IsRegularLocalRing (U.presheaf.stalk
        ((⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).subschemeι z) ⧸
          IdealSheafData.stalk (⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker)
            ((⨆ k, (ε (t k) ≫ divisorNormalizationToAmbient E).ker).subschemeι z)) := by
      have := (hKpt z).1
      rw [← kernel_stalkMap_subscheme_eq_idealStalk _ z]
      exact IsRegularLocalRing.of_ringEquiv hiso'.symm
    rw [hz] at h2
    rw [← hstalkK]
    exact h2
  -- extend to a regular system of parameters
  obtain ⟨hRreg, rs, hsop, hgenrs, hlers, htake⟩ :=
    exists_isSystemOfParameters_append_of_isRegular_quotient hfsmax hfsreg.toIsWeaklyRegular hquot
  refine ⟨hRreg, rs, (List.ofFn fun k => g (t k)).length, hsop, hgenrs, ?_, hlers, ?_⟩
  · rw [List.length_ofFn]
    exact Nat.succ_le_succ (Nat.zero_le n)
  · -- the two inclusions computing the stalk of `E`
    rw [htake]
    have hEle : ∀ j : Fin m, E ≤ (ε j ≫ divisorNormalizationToAmbient E).ker := by
      intro j
      have hle := Scheme.Hom.le_ker_comp (ε j) (divisorNormalizationToAmbient E)
      rwa [show (divisorNormalizationToAmbient E).ker = E from
        Scheme.IdealSheafData.eq_ker_comp_subschemeι_of_surjective E
          (divisorNormalization E)] at hle
    refine le_antisymm ?_ ?_
    · refine le_span_singleton_prod_of_forall_le hfsreg fun a ha => ?_
      obtain ⟨k, rfl⟩ := List.mem_ofFn.mp ha
      exact le_trans (IdealSheafData.stalk_mono (hEle (t k)) x)
        (le_of_eq (hgt k))
    · rw [Scheme.IdealSheafData.stalk_eq_iInf_of_finite_cover E (divisorNormalization E) ε
        hcover x]
      refine le_iInf fun j => ?_
      by_cases hj : j ∈ S
      · obtain ⟨k, rfl⟩ := htsurj j hj
        rw [show ((ε (t k) ≫ divisorNormalization E ≫ E.subschemeι).ker) =
          ((ε (t k) ≫ divisorNormalizationToAmbient E).ker) from rfl,
          hgt k]
        exact span_singleton_prod_le (List.mem_ofFn.mpr ⟨k, rfl⟩)
      · rw [show IdealSheafData.stalk
          ((ε j ≫ divisorNormalization E ≫ E.subschemeι).ker) x = ⊤ from
            (IdealSheafData.stalk_eq_top_iff_not_mem_support _ x).mpr fun hc =>
              hj ((hmemS j).2 hc)]
        exact le_top

/-! ### The main theorem -/

/-- A divisor satisfying condition (2) of Tag 0CBR whose normalization is a finite disjoint
union of open subschemes each mapping to the ambient scheme by a closed immersion is a strict
normal crossings divisor. -/
public theorem isStrictNormalCrossingsDivisor_of_isNormalizationCrossingsDivisor_of_closedCover
    {U : Scheme.{u}} [IsLocallyNoetherian U] (E : U.IdealSheafData)
    (h : IsNormalizationCrossingsDivisor E)
    {m : ℕ} {A : Fin m → Scheme.{u}}
    (ε : ∀ j, A j ⟶ divisorNormalizationScheme E)
    (hopen : ∀ j, IsOpenImmersion (ε j))
    (hclosed : ∀ j, IsClosedImmersion (ε j ≫ divisorNormalizationToAmbient E))
    (hcover : ∀ y : divisorNormalizationScheme E, ∃ j, y ∈ Set.range (ε j).base)
    (hdisj : ∀ j k, j ≠ k → Disjoint (Set.range (ε j).base) (Set.range (ε k).base))
    (hiso : ∀ j, ∃ e : A j ≅ ((ε j ≫ divisorNormalizationToAmbient E).ker).subscheme,
        e.hom ≫ ((ε j ≫ divisorNormalizationToAmbient E).ker).subschemeι =
          ε j ≫ divisorNormalizationToAmbient E) :
    IsStrictNormalCrossingsDivisor E := by
  have key := isRegularLocalRing_and_stalk_eq_prod_take h ε hopen hclosed hcover hdisj hiso
  refine ⟨?_, ?_⟩
  · refine isEffectiveCartierDivisor_of_stalk_isPrincipal_nonZeroDivisor E fun x hx => ?_
    obtain ⟨hRreg, rs, r, hsop, hgen, -, -, hstalk⟩ := key x hx
    have := hRreg
    exact ⟨(rs.take r).prod,
      IsRegularLocalRing.mem_nonZeroDivisors_prod_take_of_ofList_eq_maximalIdeal hsop hgen r,
      hstalk⟩
  · intro y
    have hx : E.subschemeι y ∈ E.support :=
      (Scheme.IdealSheafData.range_subschemeι (I := E)).le ⟨y, rfl⟩
    obtain ⟨hRreg, rs, r, hsop, hgen, hr1, hrle, hstalk⟩ := key (E.subschemeι y) hx
    exact ⟨hRreg, rs, r, hsop, hgen, hr1, hrle,
      (kernel_stalkMap_subscheme_eq_idealStalk E y).trans hstalk⟩

end Stacks.Divisors

