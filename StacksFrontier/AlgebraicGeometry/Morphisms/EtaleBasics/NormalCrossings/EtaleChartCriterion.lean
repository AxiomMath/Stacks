module

public import StacksFrontier.AlgebraicGeometry.Morphisms.EtaleBasics.NormalCrossings.StrictHenselization
public import StacksFrontier.AlgebraicGeometry.Morphisms.EtaleBasics.NormalCrossings.StrictHenselizationCriterion
public import StacksFrontier.AlgebraicGeometry.Morphisms.EtaleNeighbourhood.StalkStrictHenselization
public import StacksFrontier.RingTheory.NormalCrossingsChart.BranchRegularity

/-!
# Strict normal crossings on an étale chart from a normal factorisation of the local equations

Let `X` be a locally Noetherian scheme, let `D` be a closed subscheme with strict normal
crossings at the strict henselizations — condition (2) of Tag 0CBS — and let `g : U ⟶ X` be an
étale morphism. If at every point `u` of the inverse image of `D` the stalk ideal of `D.comap g`
is generated by a product of at least one element whose quotients `𝒪_{U, u} / (fⱼ)` are normal
domains, then `D.comap g` is a strict normal crossings divisor on `U`.

This is the étale-chart form of
`Stacks.Divisors.isStrictNormalCrossingsDivisor_of_exists_regular_factorization`, and it is what
the proof of (2) ⇒ (1) of Tag 0CBS consumes. Two things are relaxed. The factorisation of the
local equation into branches is not available Zariski-locally on `X`, only on an étale
neighbourhood, so the divisor on which strict normal crossings is asserted is the inverse image
`D.comap g`; and condition (2) is used at the single strict henselization supplied by
`AlgebraicGeometry.exists_isHenselization_stalk_of_etale`, not quantified over every strict
henselization of every local ring of `U`. The branches are only required to be *normal*, which
is what the J-2 or Nagata hypothesis of Tag 0CBS produces after shrinking; condition (2) then
upgrades normality to regularity, because in the strict henselization the local equation is a
product of distinct regular parameters and a normal branch must be a single one of them.

## Main results

* `Stacks.Divisors.isStrictNormalCrossingsDivisor_comap_of_etale_of_forall_normal_factorization`:
  the criterion above.

## Implementation notes

A strict henselization `Ash` of `𝒪_{X, g u}` is also one of `𝒪_{U, u}`, and the two morphisms
`Spec Ash ⟶ X` built from the structure maps agree, so the strict normal crossings divisor
produced by condition (2) at `g u` *is* the inverse image of `D.comap g` under the canonical
morphism `Spec Ash ⟶ U`.

The upgrade from a normal branch to a regular one is
`isRegularLocalRing_quotient_of_isIntegrallyClosed_of_dvd_prod`; its divisibility hypothesis
comes from the two descriptions of the stalk ideal, as the ideal generated by the product of the
branches and as the ideal generated by the product of an initial segment of a regular system of
parameters of `Ash`: the two generators are associates, and each branch divides the first.

The effective Cartier conjunct is obtained by flat pullback from the one on `X`, which condition
(2) supplies by
`Stacks.Divisors.isEffectiveCartierDivisor_of_isStrictNormalCrossingsAtStrictHenselizations`;
an étale morphism is flat.

## References

* [Stacks Project, Tag 0CBS](https://stacks.math.columbia.edu/tag/0CBS)
* [Stacks Project, Tag 04GU](https://stacks.math.columbia.edu/tag/04GU)
* [Stacks Project, Tag 0BI9](https://stacks.math.columbia.edu/tag/0BI9)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory IsLocalRing

universe u

namespace Stacks.Divisors

/-- **Stacks Project, Tag 0CBS, the étale-chart core of (2) ⇒ (1).** Let `D` be a closed
subscheme of a locally Noetherian scheme `X` with strict normal crossings at the strict
henselizations, and let `g : U ⟶ X` be étale with `U` locally Noetherian. If at every point `u`
of the support of `D.comap g` the stalk ideal of `D.comap g` is generated by a product of at
least one element each of whose quotients `𝒪_{U, u} / (fⱼ)` is a normal domain, then `D.comap g`
is a strict normal crossings divisor.

In Tag 0CBS such a chart, with such a factorisation, is what the J-2 or Nagata hypothesis
produces. -/
public theorem isStrictNormalCrossingsDivisor_comap_of_etale_of_forall_normal_factorization
    {X U : Scheme.{u}} [IsLocallyNoetherian X] [IsLocallyNoetherian U] (g : U ⟶ X)
    [AlgebraicGeometry.Etale g] (D : X.IdealSheafData)
    (hD : IsStrictNormalCrossingsAtStrictHenselizations D)
    (hfac : ∀ u : U, u ∈ (D.comap g).support → ∃ fs : List (U.presheaf.stalk u),
      (∀ f ∈ fs, IsDomain ((U.presheaf.stalk u : Type u) ⧸ Ideal.span {f}) ∧
        IsIntegrallyClosed ((U.presheaf.stalk u : Type u) ⧸ Ideal.span {f})) ∧
        1 ≤ fs.length ∧
        AlgebraicGeometry.IdealSheafData.stalk (D.comap g) u = Ideal.span {fs.prod}) :
    IsStrictNormalCrossingsDivisor (D.comap g) := by
  refine ⟨isPullbackDefined_of_flat g D
    (isEffectiveCartierDivisor_of_isStrictNormalCrossingsAtStrictHenselizations D hD), fun y ↦ ?_⟩
  set u : U := (D.comap g).subschemeι y with hu
  have hus : u ∈ (D.comap g).support :=
    (Scheme.IdealSheafData.range_subschemeι (I := D.comap g)).le ⟨y, rfl⟩
  have hxs : g u ∈ D.support := by
    have hsc := Scheme.IdealSheafData.support_comap D g
    rw [hsc] at hus
    exact hus
  obtain ⟨fs, hfsnor, hfs1, hfsgen⟩ := hfac u hus
  -- A strict henselization of the local ring of `X` at `g u`.
  obtain ⟨Ash, _, _, _, _⟩ := IsLocalRing.exists_isHenselization_separableClosure
    (X.presheaf.stalk (g u) : Type u)
  set L := SeparableClosure (ResidueField (X.presheaf.stalk (g u))) with hL
  have hNoethAsh : IsNoetherianRing Ash :=
    IsLocalRing.isNoetherianRing_of_isHenselization
      (A := (X.presheaf.stalk (g u) : Type u)) L
  have hlocX : IsLocalHom (algebraMap (X.presheaf.stalk (g u)) Ash) :=
    IsLocalRing.IsHenselization.isLocalHom (L := L)
  -- It is also a strict henselization of the local ring of `U` at `u`.
  let : Algebra (X.presheaf.stalk (g u)) (U.presheaf.stalk u) := (g.stalkMap u).hom.toAlgebra
  obtain ⟨algB, algκ, htower, hlocal, hsc, hH⟩ :=
    AlgebraicGeometry.exists_isHenselization_stalk_of_etale g u L Ash
  let := algB
  let := algκ
  have := htower
  have := hlocal
  have := hsc
  have := hH
  -- The two morphisms `Spec Ash ⟶ X` agree, so condition (2) at `g u` is a statement about the
  -- inverse image of `D.comap g`.
  have hglue : Spec.map (CommRingCat.ofHom (algebraMap (U.presheaf.stalk u) Ash)) ≫
      U.fromSpecStalk u ≫ g =
      Spec.map (CommRingCat.ofHom (algebraMap (X.presheaf.stalk (g u)) Ash)) ≫
        X.fromSpecStalk (g u) := by
    refine spec_map_comp_fromSpecStalk_comp_eq g u _ _
      (CommRingCat.hom_ext (RingHom.ext fun z => ?_))
    exact (IsScalarTower.algebraMap_apply (X.presheaf.stalk (g u)) (U.presheaf.stalk u) Ash z).symm
  have hSNC : IsStrictNormalCrossingsDivisor ((D.comap g).comap
      (Spec.map (CommRingCat.ofHom (algebraMap (U.presheaf.stalk u) Ash)) ≫
        U.fromSpecStalk u)) := by
    rw [← Scheme.IdealSheafData.comap_comp, Category.assoc, hglue]
    exact hD (g u) ((Scheme.IdealSheafData.range_subschemeι (I := D)).ge hxs) L Ash
  obtain ⟨hreg, hs, s, hsop, hsgen, -, hsle, hmap⟩ :=
    exists_isSystemOfParameters_map_stalk_of_comap_fromSpecStalk (D.comap g) u hus hSNC
  have := hreg
  -- Each branch divides the product of the initial segment of the regular system of parameters.
  have hprod : (Ideal.span {fs.prod}).map (algebraMap (U.presheaf.stalk u) Ash) =
      Ideal.span {(hs.take s).prod} := hfsgen ▸ hmap
  have hdvdall : ∀ f ∈ fs, algebraMap (U.presheaf.stalk u) Ash f ∣ (hs.take s).prod := by
    intro f hf
    refine dvd_trans (map_dvd _ (List.dvd_prod hf)) ?_
    rw [Ideal.map_span, Set.image_singleton] at hprod
    exact Ideal.span_singleton_le_span_singleton.mp hprod.ge
  -- Condition (2) upgrades a normal branch to a regular one.
  have hfsreg : ∀ f ∈ fs, IsRegularLocalRing ((U.presheaf.stalk u : Type u) ⧸ Ideal.span {f}) := by
    intro f hf
    obtain ⟨hdom, hic⟩ := hfsnor f hf
    have hfmem : f ∈ maximalIdeal (U.presheaf.stalk u) := by
      by_contra hc
      have : Ideal.span {f} = (⊤ : Ideal (U.presheaf.stalk u)) :=
        Ideal.span_singleton_eq_top.mpr (IsLocalRing.notMem_maximalIdeal.mp hc)
      exact (not_subsingleton _) (Ideal.Quotient.subsingleton_iff.mpr this)
    exact isRegularLocalRing_quotient_of_isIntegrallyClosed_of_dvd_prod L hfmem hdom hic
      hsop hsgen hsle (hdvdall f hf)
  obtain ⟨hA, -, ts, htsop, htsgen⟩ :=
    IsRegularLocalRing.isRegularLocalRing_and_exists_isSystemOfParameters_append_of_isHenselization
      L hfsreg hsop hsgen hsle hprod
  refine ⟨hA, fs ++ ts, fs.length, htsop, htsgen, hfs1, by simp, ?_⟩
  obtain ⟨W, huW⟩ := exists_affineOpens_mem u
  have hstalk := AlgebraicGeometry.stalk_ker_eq_of_affine_target (D.comap g).subschemeι y W.1 W.2
    huW
  rw [Scheme.IdealSheafData.ker_subschemeι] at hstalk
  rw [List.take_left, ← hstalk, hfsgen]

end Stacks.Divisors

end
