/-!
# Smooth pullback of a normal crossings divisor

The scheme-theoretic inverse image of a strict normal crossings divisor along a smooth morphism
is again a strict normal crossings divisor, and the same holds for normal crossings divisors.

## Main results

* `Stacks.Divisors.isStrictNormalCrossingsDivisor_comap`: smooth pullback preserves strict
  normal crossings divisors.
* `Stacks.Divisors.isNormalCrossingsDivisor_comap`: smooth pullback preserves normal crossings
  divisors.

## Implementation notes

A divisor is represented by its ideal sheaf data and its pullback by
`Scheme.IdealSheafData.comap`. A smooth morphism is flat and locally of finite type, so the
pullback of an effective Cartier divisor along it is again an effective Cartier divisor and the
source of a smooth morphism to a locally Noetherian scheme is locally Noetherian; both
conclusions therefore also assert that the pullback divisor is defined.

The local statement is about the point `z` of the fibre product `Y ×_X D` carrying the chosen
point of the pullback divisor. The local ring of the fibre product there is a localization of a
tensor product of local rings, so the kernel of the stalk map of the first projection is the
ideal generated by the image of the local equation of `D`
(`AlgebraicGeometry.ker_stalkMap_pullback_fst`). Flatness and regularity of the closed fibre of
a smooth morphism promote a regular system of parameters on the base to one on the source whose
initial segment is the image of the original
(`IsLocalRing.exists_isSystemOfParameters_append_of_flat`), so the local equation of the
pullback is the same product of parameters.

For the normal crossings statement the étale chart of the pullback is obtained by base changing
an étale chart `U → X` of `D` along the smooth morphism; the two pullbacks of `D` to `Y ×_X U`
agree because the pullback square commutes.

## References

* [Stacks Project, Tag 0CBP](https://stacks.math.columbia.edu/tag/0CBP)
* [Stacks Project, Tag 0CBQ](https://stacks.math.columbia.edu/tag/0CBQ)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

namespace Algebra.TensorProduct

/-- For a surjective algebra map `R → C`, the kernel of `B → B ⊗_R C` is the ideal generated by
the image of the kernel of `R → C`. -/
@[sga "3 V 9.1" "ker(Cα → C)"]
theorem ker_includeLeftRingHom (R B C : Type*) [CommRing R] [CommRing B] [CommRing C]
    [Algebra R B] [Algebra R C] (hC : Function.Surjective (algebraMap R C)) :
    RingHom.ker (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct R B C) =
      (RingHom.ker (algebraMap R C)).map (algebraMap R B) := by
  have h2 : (Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := B) (B := C)).toRingHom =
      (Algebra.TensorProduct.map (AlgHom.id R B) (Algebra.ofId R C)).toRingHom.comp
        (Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := B) (B := R)).toRingHom := by
    ext b; simp
  have h3 : RingHom.ker
        (Algebra.TensorProduct.map (AlgHom.id R B) (Algebra.ofId R C)).toRingHom =
      (RingHom.ker (algebraMap R C)).map
        (Algebra.TensorProduct.includeRight (R := R) (A := B) (B := R)).toRingHom := by
    have h := Algebra.TensorProduct.lTensor_ker (A := B) (Algebra.ofId R C) hC
    dsimp [Algebra.ofId] at h
    exact h
  show RingHom.ker (Algebra.TensorProduct.includeLeft (S := R)).toRingHom = _
  rw [h2, ← RingHom.comap_ker, h3]
  have h4 : (Algebra.TensorProduct.includeLeft (R := R) (S := R) (A := B) (B := R)).toRingHom =
      ((Algebra.TensorProduct.rid R R B).toRingEquiv.symm : B →+* TensorProduct R B R) := by
    ext b
    exact (Algebra.TensorProduct.rid R R B).toRingEquiv.injective (by simp)
  have h5 : (algebraMap R B) =
      ((Algebra.TensorProduct.rid R R B).toRingEquiv : TensorProduct R B R →+* B).comp
        (Algebra.TensorProduct.includeRight (R := R) (A := B) (B := R)).toRingHom := by
    ext x; simp [Algebra.smul_def]
  rw [h4, h5, ← Ideal.map_map, Ideal.comap_coe, Ideal.map_coe, Ideal.comap_symm]

/-- The same computation as `Algebra.TensorProduct.ker_includeLeftRingHom` after localizing the
tensor product, provided the composite out of `B` stays a local homomorphism. -/
theorem ker_comp_includeLeftRingHom_of_isLocalization
    (R B C P : Type*) [CommRing R] [CommRing B] [CommRing C] [CommRing P]
    [Algebra R B] [Algebra R C] (φ : TensorProduct R B C →+* P)
    [IsLocalHom (φ.comp Algebra.TensorProduct.includeLeftRingHom)]
    (hC : Function.Surjective (algebraMap R C))
    (hloc : let := φ.toAlgebra; ∃ M : Submonoid (TensorProduct R B C), IsLocalization M P) :
    RingHom.ker (φ.comp Algebra.TensorProduct.includeLeftRingHom) =
      (RingHom.ker (algebraMap R C)).map (algebraMap R B) := by
  let := φ.toAlgebra
  obtain ⟨M, hM⟩ := hloc
  have hφ : Function.Injective φ := by
    refine IsLocalization.injective P (M := M) fun t ht ↦ ?_
    obtain ⟨b, hb⟩ := Algebra.TensorProduct.includeLeft_surjective R B hC t
    have hu : IsUnit ((φ.comp Algebra.TensorProduct.includeLeftRingHom) b) := by
      show IsUnit (φ (Algebra.TensorProduct.includeLeft (S := R) b))
      rw [hb]
      exact IsLocalization.map_units P (⟨t, ht⟩ : M)
    exact hb ▸ ((isUnit_of_map_unit _ b hu).map
      (Algebra.TensorProduct.includeLeftRingHom : B →+* TensorProduct R B C)).mem_nonZeroDivisors
  rw [RingHom.ker_comp_of_injective _ hφ]
  exact ker_includeLeftRingHom R B C hC

end Algebra.TensorProduct

namespace AlgebraicGeometry

/-- The kernel of the stalk map of the first projection of a fibre product along a closed
immersion is the ideal generated by the image of the kernel of the stalk map of that closed
immersion. -/
theorem ker_stalkMap_pullback_fst {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Z ⟶ Y)
    [IsClosedImmersion g] (z : (pullback f g).carrier) :
    let x := pullback.fst f g z
    let y := pullback.snd f g z
    let h : f x = g y := congrArg (fun k : pullback f g ⟶ Y => k z) pullback.condition
    RingHom.ker ((pullback.fst f g).stalkMap z).hom =
      Ideal.map (f.stalkMap x).hom
        (RingHom.ker ((eqToHom (congrArg Y.presheaf.stalk h) ≫ g.stalkMap y).hom)) := by
  intro x y h
  let : Algebra (Y.presheaf.stalk ((pullback.fst f g ≫ f) z)) (X.presheaf.stalk x) :=
    (f.stalkMap x).hom.toAlgebra
  let : Algebra (Y.presheaf.stalk ((pullback.fst f g ≫ f) z)) (Z.presheaf.stalk y) :=
    (eqToHom (congrArg Y.presheaf.stalk h) ≫ g.stalkMap y).hom.toAlgebra
  obtain ⟨φ, hφ, _, hloc⟩ := BaseChangeStalk.pullback_stalk_isLocalization f g z
  have : IsLocalHom (φ.comp Algebra.TensorProduct.includeLeftRingHom) := by
    rw [hφ]; infer_instance
  rw [← hφ]
  refine Algebra.TensorProduct.ker_comp_includeLeftRingHom_of_isLocalization _ _ _ _ φ ?_ hloc
  exact (g.stalkMap_surjective _).comp
    (ConcreteCategory.bijective_of_isIso (eqToHom (congrArg Y.presheaf.stalk h))).2

/-- The closed fibre of the stalk map of a smooth morphism is a regular local ring. -/
@[ega "IV 17.5.8" "(iii), special case"]
theorem isRegularLocalRing_closedFibre_of_smooth {X Y : Scheme.{u}} (f : Y ⟶ X) [Smooth f]
    (x : Y) :
    IsRegularLocalRing ((Y.presheaf.stalk x) ⧸
      Ideal.map (f.stalkMap x).hom (IsLocalRing.maximalIdeal (X.presheaf.stalk (f x)))) := by
  have : MorphismProperty.IsStableUnderBaseChangeAlong (@Smooth)
      (X.fromSpecResidueField (f x)) :=
    ⟨fun hpb hg => smooth_isStableUnderBaseChange.of_isPullback hpb hg⟩
  have hs : Smooth (f.fiberToSpecResidueField (f x)) :=
    MorphismProperty.pullback_snd f (X.fromSpecResidueField (f x)) inferInstance
  have hreg := @isRegular_of_smooth_over_field _ _ _ (f.fiberToSpecResidueField (f x)) hs
  have hstalk := ((isRegular_tfae _).out 1 2).mp hreg
  let := hstalk.2 (f.asFiber x)
  exact IsRegularLocalRing.of_ringEquiv (quotientStalkEquivFiberStalk f x).symm

end AlgebraicGeometry

namespace IsLocalRing

/-- Along a flat local homomorphism of Noetherian local rings with regular closed fibre, a
regular system of parameters of the source extends, by its image followed by lifts of a regular
system of parameters of the closed fibre, to a regular system of parameters of the target. -/
@[ega "IV 7.5.1.1" "special case"]
theorem exists_isSystemOfParameters_append_of_flat
    {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    [IsNoetherianRing A] [IsNoetherianRing B] [IsLocalRing A] [IsLocalRing B]
    [Module.Flat A B] [IsLocalHom (algebraMap A B)]
    (rs : List A) (hrs : IsSystemOfParameters rs)
    (hgen : Ideal.ofList rs = maximalIdeal A)
    (hF : IsRegularLocalRing (B ⧸ Ideal.map (algebraMap A B) (maximalIdeal A))) :
    ∃ ts : List B, IsSystemOfParameters (rs.map (algebraMap A B) ++ ts) ∧
      Ideal.ofList (rs.map (algebraMap A B) ++ ts) = maximalIdeal B := by
  classical
  set I := Ideal.map (algebraMap A B) (maximalIdeal A) with hI
  set F := B ⧸ I with hFdef
  let : IsRegularLocalRing F := hF
  set q := Ideal.Quotient.mk I with hq
  have hmax : Ideal.map q (maximalIdeal B) = maximalIdeal F :=
    map_maximalIdeal_of_surjective q Ideal.Quotient.mk_surjective
  obtain ⟨s, hcard, hs⟩ :=
    (IsNoetherian.noetherian (maximalIdeal F)).exists_span_finset_card_eq_spanFinrank
  set ts := s.toList.map (Function.surjInv (Ideal.Quotient.mk_surjective (I := I))) with hts
  have hmap : ts.map q = s.toList := by
    simp only [hts, List.map_map]
    exact List.map_id'' (fun z => Function.surjInv_eq Ideal.Quotient.mk_surjective z) _
  have hspan : Ideal.ofList s.toList = maximalIdeal F := by
    simpa [Ideal.ofList] using hs
  have hgenB : Ideal.ofList (rs.map (algebraMap A B) ++ ts) = maximalIdeal B := by
    rw [Ideal.ofList_append, ← Ideal.map_ofList, hgen]
    show I ⊔ Ideal.ofList ts = _
    have heq : Ideal.map q (Ideal.ofList ts) = Ideal.map q (maximalIdeal B) := by
      rw [Ideal.map_ofList, hmap, hspan, hmax]
    have hcm := congrArg (Ideal.comap q) heq
    rw [Ideal.comap_map_of_surjective q Ideal.Quotient.mk_surjective,
      Ideal.comap_map_of_surjective q Ideal.Quotient.mk_surjective,
      show Ideal.comap q ⊥ = I from Ideal.mk_ker] at hcm
    have hle : I ≤ maximalIdeal B := map_maximalIdeal_le (algebraMap A B)
    simpa only [sup_comm, sup_eq_right.mpr hle] using hcm
  have hdimF : ringKrullDim F = (ts.length : WithBot ℕ∞) := by
    rw [← hF.spanFinrank_maximalIdeal]
    congr 1
    simp only [hts, List.length_map, Finset.length_toList, hcard]
    rfl
  have : Algebra.HasGoingDown A B := Algebra.HasGoingDown.of_flat
  have : (maximalIdeal B).LiesOver (maximalIdeal A) := ResidueField.instLiesOverMaximalIdeal
  have hdim : ringKrullDim B = ringKrullDim A + ringKrullDim F := by
    rw [← maximalIdeal_height_eq_ringKrullDim (R := B),
      Ideal.height_eq_height_add_of_liesOver_of_hasGoingDown (maximalIdeal A) (maximalIdeal B),
      WithBot.coe_add, maximalIdeal_height_eq_ringKrullDim,
      show Ideal.map (Ideal.Quotient.mk I) (maximalIdeal B) = maximalIdeal F from hmax,
      maximalIdeal_height_eq_ringKrullDim]
  refine ⟨ts, ⟨?_, ?_⟩, hgenB⟩
  · rw [hgenB, (maximalIdeal.isMaximal B).isPrime.radical]
  · rw [hdim, hrs.2, hdimF]
    simp only [List.length_append, List.length_map, Nat.cast_add]

end IsLocalRing

namespace AlgebraicGeometry

/-- The kernel of a stalk map is unchanged by precomposition with an isomorphism. -/
theorem ker_stalkMap_comp_of_isIso {X Y Z : Scheme.{u}} (e : X ⟶ Y) [IsIso e] (g : Y ⟶ Z)
    (x : X) :
    RingHom.ker ((e ≫ g).stalkMap x).hom = RingHom.ker (g.stalkMap (e x)).hom := by
  rw [Scheme.Hom.stalkMap_comp]
  exact RingHom.ker_comp_of_injective _
    (ConcreteCategory.bijective_of_isIso (e.stalkMap x)).1

end AlgebraicGeometry

namespace Stacks.Divisors

/-- The two projections of a fibre product have the same image in the base. -/
private theorem apply_fst_eq_apply_snd {X Y Z : Scheme.{u}} (f : X ⟶ Y) (g : Z ⟶ Y)
    (z : (pullback f g).carrier) : f (pullback.fst f g z) = g (pullback.snd f g z) :=
  congrArg (fun k : pullback f g ⟶ Y => k z) pullback.condition

/-- At a point of the fibre product of a smooth morphism with the subscheme of a strict normal
crossings divisor, the local ring of the source is regular and the kernel of the stalk map of
the first projection is cut out by an initial segment of a regular system of parameters. -/
private theorem pullback_stalk_isSystemOfParameters {X Y : Scheme.{u}} [IsLocallyNoetherian X]
    (f : Y ⟶ X) [Smooth f] (D : X.IdealSheafData)
    (hD : IsStrictNormalCrossingsDivisor D) (z : (pullback f D.subschemeι).carrier) :
    let x := pullback.fst f D.subschemeι z
    IsRegularLocalRing (Y.presheaf.stalk x) ∧
      ∃ (rs : List (Y.presheaf.stalk x)) (r : ℕ),
        IsLocalRing.IsSystemOfParameters rs ∧
        Ideal.ofList rs = IsLocalRing.maximalIdeal (Y.presheaf.stalk x) ∧
        1 ≤ r ∧ r ≤ rs.length ∧
        RingHom.ker ((pullback.fst f D.subschemeι).stalkMap z).hom =
          Ideal.span {(rs.take r).prod} := by
  classical
  let : IsLocallyNoetherian Y := LocallyOfFiniteType.isLocallyNoetherian f
  let x := pullback.fst f D.subschemeι z
  let d := pullback.snd f D.subschemeι z
  have h : f x = D.subschemeι d := apply_fst_eq_apply_snd f D.subschemeι z
  let t := eqToHom (congrArg X.presheaf.stalk h) ≫ D.subschemeι.stalkMap d
  have hbase : IsRegularLocalRing (X.presheaf.stalk (f x)) ∧
      ∃ (rs : List (X.presheaf.stalk (f x))) (r : ℕ),
        IsLocalRing.IsSystemOfParameters rs ∧
        Ideal.ofList rs = IsLocalRing.maximalIdeal (X.presheaf.stalk (f x)) ∧
        1 ≤ r ∧ r ≤ rs.length ∧ RingHom.ker t.hom = Ideal.span {(rs.take r).prod} := by
    dsimp only [t]
    generalize hp : f x = p at h ⊢
    clear hp
    subst p
    simpa using hD.2 d
  obtain ⟨hA, rs, r, hrs, hgen, hr, hrle, hk⟩ := hbase
  let A := X.presheaf.stalk (f x)
  let B := Y.presheaf.stalk x
  let : Algebra A B := (f.stalkMap x).hom.toAlgebra
  have : Module.Flat A B := Flat.stalkMap f x
  have : IsLocalHom (algebraMap A B) := inferInstanceAs (IsLocalHom (f.stalkMap x).hom)
  have hF := isRegularLocalRing_closedFibre_of_smooth f x
  have hB' := isRegularLocalRing_of_flat_of_regular_closedFibre A B hA hF
  obtain ⟨ts, hparams, hgens⟩ :=
    IsLocalRing.exists_isSystemOfParameters_append_of_flat (B := B) rs hrs hgen hF
  refine ⟨hB', rs.map (algebraMap A B) ++ ts, r, hparams, hgens, hr, ?_, ?_⟩
  · simpa only [List.length_append, List.length_map] using
      hrle.trans (Nat.le_add_right rs.length ts.length)
  · rw [ker_stalkMap_pullback_fst]
    show Ideal.map (algebraMap A B) (RingHom.ker t.hom) = _
    rw [hk, Ideal.map_span, Set.image_singleton]
    congr 1
    rw [List.take_append_of_le_length (by simpa using hrle), ← List.map_take, ← map_list_prod]

/-- **Stacks Project, Tag 0CBP.** The pullback of a strict normal crossings divisor along a
smooth morphism is a strict normal crossings divisor. -/
@[stacks 0CBP]
theorem isStrictNormalCrossingsDivisor_comap {X Y : Scheme.{u}} [IsLocallyNoetherian X]
    (f : Y ⟶ X) [Smooth f] (D : X.IdealSheafData)
    (hD : IsStrictNormalCrossingsDivisor D) :
    @IsStrictNormalCrossingsDivisor Y (LocallyOfFiniteType.isLocallyNoetherian f)
      (D.comap f) := by
  refine ⟨isPullbackDefined_of_flat f D hD.1, fun y ↦ ?_⟩
  set e := (D.comapIso f).hom with he'
  set g := pullback.fst f D.subschemeι with hg
  have H := pullback_stalk_isSystemOfParameters f D hD (e y)
  have H' : IsRegularLocalRing (Y.presheaf.stalk ((e ≫ g) y)) ∧
      ∃ (rs : List (Y.presheaf.stalk ((e ≫ g) y))) (r : ℕ),
        IsLocalRing.IsSystemOfParameters rs ∧
        Ideal.ofList rs = IsLocalRing.maximalIdeal (Y.presheaf.stalk ((e ≫ g) y)) ∧
        1 ≤ r ∧ r ≤ rs.length ∧
        RingHom.ker ((e ≫ g).stalkMap y).hom = Ideal.span {(rs.take r).prod} := by
    rw [ker_stalkMap_comp_of_isIso]
    exact H
  have he : e ≫ g = (D.comap f).subschemeι := D.comapIso_hom_fst f
  rw [he] at H'
  exact H'

/-- **Stacks Project, Tag 0CBQ.** The pullback of a normal crossings divisor along a smooth
morphism is a normal crossings divisor. -/
@[stacks 0CBQ]
theorem isNormalCrossingsDivisor_comap {X Y : Scheme.{u}} [IsLocallyNoetherian X]
    (f : Y ⟶ X) [Smooth f] (D : X.IdealSheafData)
    (hD : IsNormalCrossingsDivisor D) :
    @IsNormalCrossingsDivisor Y (LocallyOfFiniteType.isLocallyNoetherian f) (D.comap f) := by
  refine ⟨isPullbackDefined_of_flat f D hD.1, fun y ↦ ?_⟩
  set d : D.subscheme := pullback.snd f D.subschemeι ((D.comapIso f).hom y) with hd
  have hdd : f ((D.comap f).subschemeι y) = D.subschemeι d := by
    rw [← D.comapIso_hom_fst f]
    exact apply_fst_eq_apply_snd f D.subschemeι _
  obtain ⟨U, g, hU, hg, hq, hE⟩ := hD.2 d
  obtain ⟨q, hq⟩ := hq
  obtain ⟨v, hvY, -⟩ :=
    Scheme.Pullback.exists_preimage_pullback ((D.comap f).subschemeι y) q (hdd.trans hq.symm)
  have hdiv : (D.comap g).comap (pullback.snd f g) = (D.comap f).comap (pullback.fst f g) := by
    simpa only [Scheme.IdealSheafData.comap_comp] using
      congrArg (fun m : pullback f g ⟶ X => D.comap m)
        (pullback.condition (f := f) (g := g)).symm
  refine ⟨pullback f g, pullback.fst f g,
    LocallyOfFiniteType.isLocallyNoetherian (pullback.snd f g), inferInstance, ⟨v, hvY⟩, ?_⟩
  rw [← hdiv]
  exact isStrictNormalCrossingsDivisor_comap (pullback.snd f g) (D.comap g) hE

end Stacks.Divisors
