/-!
# The étale chart on which the branches of the divisor are separated

Let `X` be a locally Noetherian scheme and `D` a closed subscheme with strict normal crossings at
the strict henselizations. At a point `p` of `D` a regular system of parameters of
`𝒪^{sh}_{X, p}` cutting out `D` exists by hypothesis; it is defined over an étale neighbourhood
of `p`, because the strict henselization is a filtered colimit of étale algebras over any affine
chart. Over that neighbourhood the local equation of `D` factors into branches, and shrinking it
Zariski-locally — which is where the J-2 or Nagata hypothesis of Tag 0CBS enters — makes every
branch normal at *every* point of the chart, not only at the chosen one.

## Main results

* `Stacks.Divisors.exists_etale_chart_forall_normal_factorization`: the étale neighbourhood with
  the factorisation, in the form consumed by
  `Stacks.Divisors.isStrictNormalCrossingsDivisor_comap_of_etale_of_forall_normal_factorization`.

## Implementation notes

The affine chart of `X` around `p` is carried abstractly, as an open immersion `ι : Spec R ⟶ X`
hitting `p` at a prime `𝔭` with `𝒪_{X, p}` a localization of `R` at `𝔭` compatibly with `ι`;
that is all the construction uses, and it is what `AlgebraicGeometry.IsAffineOpen.fromSpec`
supplies.

The chart is `Spec B` for `B` an étale `R`-algebra carrying the parameters, restricted to the
basic open complement of the shrinking denominator. Restriction is by an open immersion rather
than by replacing `B` with a localization, so the ring-theoretic data is not transported: the
local ring of the restricted chart at a point is identified with the local ring of `Spec B` at
its image by the isomorphism of stalks of an open immersion, and every statement is moved across
that single isomorphism.

The strict henselization `Λ` is a `B`-algebra through the stage map, and the local ring of
`Spec B` at the prime `q` lying under the closed point of `Λ` maps to `Λ` by the universal
property of the localization, compatibly. That map is ind-étale, hence faithfully flat, which is
what identifies the stalk ideal of the inverse image of `D` with the ideal generated by the
product of the branches: the two ideals have the same extension to `Λ`.

## References

* [Stacks Project, Tag 0CBS](https://stacks.math.columbia.edu/tag/0CBS)
* [Stacks Project, Tag 04GP](https://stacks.math.columbia.edu/tag/04GP)
* [Stacks Project, Tag 07C3](https://stacks.math.columbia.edu/tag/07C3)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory IsLocalRing

universe u

namespace Stacks.Divisors

/-- The product of a list is, up to the ideal it generates, the product of the sublist of its
entries that are not units. -/
private theorem span_prod_filter {A : Type u} [CommRing A] (P : A → Bool) :
    ∀ (l : List A), (∀ a ∈ l, P a = false → IsUnit a) →
      Ideal.span {(l.filter P).prod} = Ideal.span {l.prod}
  | [], _ => by simp
  | a :: l, hu => by
    have ih := span_prod_filter P l (fun b hb hb' => hu b (List.mem_cons_of_mem a hb) hb')
    by_cases ha : P a = true
    · rw [List.filter_cons_of_pos ha, List.prod_cons, List.prod_cons,
        ← Ideal.span_singleton_mul_span_singleton, ← Ideal.span_singleton_mul_span_singleton, ih]
    · have hafalse : P a = false := by simpa using ha
      rw [List.filter_cons_of_neg (by simp [hafalse]), List.prod_cons, ih]
      exact (Ideal.span_singleton_mul_left_unit (hu a List.mem_cons_self hafalse) l.prod).symm


/-- The stalk ideal of the inverse image of `D` under `Spec.map φ ≫ X.fromSpecStalk x`, read at
the closed point and transported along the identification of that stalk with the ring, is the
extension of the stalk ideal of `D` at `x`. -/
private theorem map_stalk_comap_specMap_fromSpecStalk {Y : Scheme.{u}}
    (E : Y.IdealSheafData) (x : Y) {A : CommRingCat.{u}} [IsLocalRing (A : Type u)]
    (φ : Y.presheaf.stalk x ⟶ A) [IsLocalHom φ.hom] :
    (AlgebraicGeometry.IdealSheafData.stalk
        (E.comap (Spec.map φ ≫ Y.fromSpecStalk x)) (closedPoint (A : Type u))).map
          (AlgebraicGeometry.stalkClosedPointIso A).hom.hom
      = (AlgebraicGeometry.IdealSheafData.stalk E x).map φ.hom := by
  obtain ⟨W, hxW⟩ := exists_affineOpens_mem x
  have hgc : (Spec.map φ ≫ Y.fromSpecStalk x) (closedPoint (A : Type u)) = x :=
    (congrArg (Y.fromSpecStalk x).base.hom
      (AlgebraicGeometry.Spec_closedPoint (f := φ))).trans
      AlgebraicGeometry.Scheme.fromSpecStalk_closedPoint
  have hgW : (Spec.map φ ≫ Y.fromSpecStalk x) (closedPoint (A : Type u)) ∈ W.1 := by
    rw [hgc]; exact hxW
  rw [AlgebraicGeometry.stalk_comap E (Spec.map φ ≫ Y.fromSpecStalk x)
      (closedPoint (A : Type u)),
    AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ E _ W hgW,
    AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ E x W hxW,
    Ideal.map_map, Ideal.map_map, Ideal.map_map]
  congr 1
  have hgerm := AlgebraicGeometry.Scheme.germ_stalkClosedPointTo_Spec_fromSpecStalk
    (X := Y) (R := A) φ W.1 hgW
  rw [AlgebraicGeometry.Scheme.stalkClosedPointTo] at hgerm
  have hgerm' := congrArg CommRingCat.Hom.hom hgerm
  simp only [CommRingCat.hom_comp] at hgerm'
  exact hgerm'


/-- The factorisation property of an étale chart restricts to an open subscheme. -/
private theorem forall_normal_factorization_restrict {X U : Scheme.{u}}
    (g : U ⟶ X) (D : X.IdealSheafData) (W : U.Opens)
    (hfac : ∀ x : U, x ∈ W → x ∈ (D.comap g).support →
      ∃ fs : List (U.presheaf.stalk x),
        (∀ f ∈ fs, IsDomain ((U.presheaf.stalk x : Type u) ⧸ Ideal.span {f}) ∧
          IsIntegrallyClosed ((U.presheaf.stalk x : Type u) ⧸ Ideal.span {f})) ∧
          1 ≤ fs.length ∧
          AlgebraicGeometry.IdealSheafData.stalk (D.comap g) x = Ideal.span {fs.prod}) :
    ∀ u : W.toScheme, u ∈ (D.comap (W.ι ≫ g)).support →
      ∃ fs : List (W.toScheme.presheaf.stalk u),
        (∀ f ∈ fs, IsDomain ((W.toScheme.presheaf.stalk u : Type u) ⧸ Ideal.span {f}) ∧
          IsIntegrallyClosed ((W.toScheme.presheaf.stalk u : Type u) ⧸ Ideal.span {f})) ∧
          1 ≤ fs.length ∧
          AlgebraicGeometry.IdealSheafData.stalk (D.comap (W.ι ≫ g)) u
            = Ideal.span {fs.prod} := by
  intro u hu
  have hsupp : W.ι u ∈ (D.comap g).support := by
    rw [Scheme.IdealSheafData.comap_comp, Scheme.IdealSheafData.support_comap] at hu
    exact hu
  obtain ⟨fs, hfsnor, hfs1, hfsgen⟩ := hfac (W.ι u) u.2 hsupp
  have : IsIso (W.ι.stalkMap u) := inferInstance
  set e : (U.presheaf.stalk (W.ι u) : Type u) ≃+* (W.toScheme.presheaf.stalk u : Type u) :=
    (asIso (W.ι.stalkMap u)).commRingCatIsoToRingEquiv with he
  have hecoe : (e : (U.presheaf.stalk (W.ι u) : Type u) →+* _) = (W.ι.stalkMap u).hom := rfl
  refine ⟨fs.map e, ?_, by simpa using hfs1, ?_⟩
  · intro f hf
    obtain ⟨f₀, hf₀, rfl⟩ := List.mem_map.mp hf
    obtain ⟨hdom, hic⟩ := hfsnor f₀ hf₀
    have := hdom
    have := hic
    have hJ : Ideal.span {e f₀} = (Ideal.span {f₀}).map (e : _ →+* _) := by
      rw [Ideal.map_span, Set.image_singleton]
      rfl
    set q := Ideal.quotientEquiv (Ideal.span {f₀}) (Ideal.span {e f₀}) e hJ with hq
    exact ⟨q.symm.injective.isDomain _, IsIntegrallyClosed.of_equiv q⟩
  · rw [Scheme.IdealSheafData.comap_comp,
      AlgebraicGeometry.stalk_comap (D.comap g) W.ι u, hfsgen, Ideal.map_span,
      Set.image_singleton, ← hecoe, map_list_prod]
    rfl

/-- **The étale chart of Stacks Project, Tag 0CBS, (2) ⇒ (1).** Let `D` be a closed subscheme of
a locally Noetherian scheme `X` with strict normal crossings at the strict henselizations and let
`p` be a point of `D` lying in an affine chart `ι : Spec R ⟶ X` at the prime `𝔭`. Given the
shrinking property that the J-2 or Nagata hypothesis of Tag 0CBS supplies — that the locus where
a principal quotient of an étale `R`-algebra is normal contains a neighbourhood of any point
where it is regular — there is an étale neighbourhood of `p` on which the local equation of `D`
factors, at every point, into branches with normal quotients. -/
public theorem exists_etale_chart_forall_normal_factorization
    {X : Scheme.{u}} [IsLocallyNoetherian X] (D : X.IdealSheafData)
    (hD : IsStrictNormalCrossingsAtStrictHenselizations D)
    (p : X) (hp : p ∈ D.support)
    (R : CommRingCat.{u}) [IsNoetherianRing (R : Type u)] (ι : Spec R ⟶ X) [IsOpenImmersion ι]
    (𝔭 : PrimeSpectrum (R : Type u)) (hιp : ι 𝔭 = p)
    [Algebra (R : Type u) (X.presheaf.stalk p)]
    [IsLocalization.AtPrime (X.presheaf.stalk p) 𝔭.asIdeal]
    (γ : R ⟶ X.presheaf.stalk p)
    (hγ : γ.hom = algebraMap (R : Type u) (X.presheaf.stalk p))
    (hcompat : X.fromSpecStalk p = Spec.map γ ≫ ι)
    (hshrink : ∀ (B : Type u) [CommRing B] [Algebra (R : Type u) B],
      Algebra.Etale (R : Type u) B →
      ∀ (y : B) (q : PrimeSpectrum B) (hy : y ∈ q.asIdeal),
        IsRegularLocalRing (Localization.AtPrime
          (Stacks.NormalCrossingsChart.quotPoint y q hy).asIdeal) →
        ∃ t ∉ q.asIdeal, ∀ (q' : PrimeSpectrum B) (hy' : y ∈ q'.asIdeal), t ∉ q'.asIdeal →
          IsDomain (Localization.AtPrime
            (Stacks.NormalCrossingsChart.quotPoint y q' hy').asIdeal) ∧
          IsIntegrallyClosed (Localization.AtPrime
            (Stacks.NormalCrossingsChart.quotPoint y q' hy').asIdeal)) :
    ∃ (U : Scheme.{u}) (g : U ⟶ X) (_ : IsLocallyNoetherian U) (_ : AlgebraicGeometry.Etale g),
      (∃ u : U, g u = p) ∧
      ∀ u : U, u ∈ (D.comap g).support → ∃ fs : List (U.presheaf.stalk u),
        (∀ f ∈ fs, IsDomain ((U.presheaf.stalk u : Type u) ⧸ Ideal.span {f}) ∧
          IsIntegrallyClosed ((U.presheaf.stalk u : Type u) ⧸ Ideal.span {f})) ∧
          1 ≤ fs.length ∧
          AlgebraicGeometry.IdealSheafData.stalk (D.comap g) u = Ideal.span {fs.prod} := by
  classical
  -- A strict henselization of the local ring at `p`.
  obtain ⟨Λ, instΛring, instΛlocal, instΛalg, instΛhens⟩ :=
    IsLocalRing.exists_isHenselization_separableClosure (X.presheaf.stalk p : Type u)
  set L := SeparableClosure (ResidueField (X.presheaf.stalk p)) with hL
  have : IsNoetherianRing Λ :=
    IsLocalRing.isNoetherianRing_of_isHenselization (A := (X.presheaf.stalk p : Type u)) L
  have hlocAΛ : IsLocalHom (algebraMap (X.presheaf.stalk p : Type u) Λ) :=
    IsLocalRing.IsHenselization.isLocalHom (L := L)
  let algRΛ : Algebra (R : Type u) Λ :=
    ((algebraMap (X.presheaf.stalk p : Type u) Λ).comp
      (algebraMap (R : Type u) (X.presheaf.stalk p))).toAlgebra
  have htowerR : IsScalarTower (R : Type u) (X.presheaf.stalk p) Λ :=
    IsScalarTower.of_algebraMap_eq' rfl
  have hindRΛ : StacksDraft.IndEtale (R : Type u) Λ :=
    StacksDraft.indEtale_of_isHenselization_atPrime (X.presheaf.stalk p : Type u) 𝔭.asIdeal L
  -- Condition (2) at `p`.
  have hSNCp := hD p ((Scheme.IdealSheafData.range_subschemeι (I := D)).ge hp) L Λ
  obtain ⟨hregΛ, hs, s, hsop, hsgen, hs1, hsle, hmapp⟩ :=
    exists_isSystemOfParameters_map_stalk_of_comap_fromSpecStalk D p hp hSNCp
  have := hregΛ
  -- Descend the initial segment of the regular system of parameters to an étale stage.
  obtain ⟨B, instB, instBalg, hBet, h, yfun, hyfun⟩ :=
    StacksDraft.exists_etale_algHom_forall_eq hindRΛ
      (fun i : Fin (hs.take s).length => (hs.take s).get i)
  have := hBet
  have hNoethB : IsNoetherianRing B := Algebra.FiniteType.isNoetherianRing (R : Type u) B
  let algBΛ : Algebra B Λ := (h : B →+* Λ).toAlgebra
  have htowerRB : IsScalarTower (R : Type u) B Λ :=
    IsScalarTower.of_algebraMap_eq (fun x => (h.commutes x).symm)
  set ys : List B := List.ofFn yfun with hys
  have hmapys : ys.map (h : B →+* Λ) = hs.take s := by
    rw [hys, List.map_ofFn]
    rw [show ((h : B →+* Λ) ∘ yfun) = (hs.take s).get from funext hyfun]
    exact List.ofFn_get _
  have hprodys : (h : B →+* Λ) ys.prod = (hs.take s).prod := by
    rw [map_list_prod, hmapys]
  -- The prime of `B` under the closed point of `Λ`.
  set qi : Ideal B := Ideal.comap (h : B →+* Λ) (maximalIdeal Λ) with hqi
  have hqip : qi.IsPrime := by rw [hqi]; exact Ideal.IsPrime.comap _
  set qP : PrimeSpectrum B := ⟨qi, hqip⟩ with hqP
  have hqover : Ideal.comap (algebraMap (R : Type u) B) qi = 𝔭.asIdeal := by
    rw [hqi, Ideal.comap_comap,
      show (h : B →+* Λ).comp (algebraMap (R : Type u) B) = algebraMap (R : Type u) Λ from
        RingHom.ext fun x => h.commutes x]
    exact StacksDraft.under_maximalIdeal_of_isHenselization_atPrime
      (X.presheaf.stalk p : Type u) 𝔭.asIdeal L
  have hyhs : ∀ y ∈ ys, h y ∈ hs := by
    intro y hy
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp (hys ▸ hy)
    rw [hyfun i]
    exact List.take_subset s hs (List.get_mem _ _)
  have hyq : ∀ y ∈ ys, y ∈ qi := fun y hy => by
    change h y ∈ maximalIdeal Λ
    rw [← hsgen]
    exact Ideal.subset_span (hyhs y hy)
  -- The chart.
  have hNB : IsNoetherianRing ((CommRingCat.of B) : Type u) :=
    inferInstanceAs (IsNoetherianRing B)
  have hspecet : AlgebraicGeometry.Etale
      (Spec.map (CommRingCat.ofHom (algebraMap (R : Type u) B))) :=
    HasRingHomProperty.Spec_iff.mpr (RingHom.etale_algebraMap.mpr hBet)
  have hιet : AlgebraicGeometry.Etale ι := inferInstance
  set φ : R ⟶ CommRingCat.of B := CommRingCat.ofHom (algebraMap (R : Type u) B) with hφ
  have hspecet' : AlgebraicGeometry.Etale (Spec.map φ) := hspecet
  set gmor : (Spec (CommRingCat.of B) : Scheme.{u}) ⟶ X := Spec.map φ ≫ ι with hgmor
  have hgmoret : AlgebraicGeometry.Etale gmor :=
    AlgebraicGeometry.Etale.etale_comp (f := Spec.map φ) ι
  set qS : (Spec (CommRingCat.of B) : Scheme.{u}) := ⟨qi, hqip⟩ with hqS
  have hgq : gmor qS = p := by
    show ι ((Spec.map φ) qS) = p
    rw [show (Spec.map φ) qS = 𝔭 from PrimeSpectrum.ext hqover]
    exact hιp
  -- The ideal of the inverse image of `D` on the chart.
  have hsurj : Function.Surjective ((Scheme.ΓSpecIso (CommRingCat.of B)).inv).hom :=
    (ConcreteCategory.bijective_of_isIso ((Scheme.ΓSpecIso (CommRingCat.of B)).inv)).2
  set J : Ideal B := Ideal.comap ((Scheme.ΓSpecIso (CommRingCat.of B)).inv).hom
    ((D.comap gmor).ideal ⟨⊤, isAffineOpen_top (Spec (CommRingCat.of B))⟩) with hJdef
  have hJstalk : ∀ q' : (Spec (CommRingCat.of B) : Scheme.{u}),
      AlgebraicGeometry.IdealSheafData.stalk (D.comap gmor) q'
        = J.map (((Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
            (Spec (CommRingCat.of B)).presheaf.germ ⊤ q' trivial)).hom := by
    intro q'
    have h1 := AlgebraicGeometry.IdealSheafData.stalk_eq_map_germ (D.comap gmor) q'
      ⟨⊤, isAffineOpen_top (Spec (CommRingCat.of B))⟩ trivial
    have h2 : (D.comap gmor).ideal ⟨⊤, isAffineOpen_top (Spec (CommRingCat.of B))⟩
        = J.map ((Scheme.ΓSpecIso (CommRingCat.of B)).inv).hom :=
      (Ideal.map_comap_of_surjective _ hsurj _).symm
    rw [h1]
    conv_lhs => rw [h2]
    rw [Ideal.map_map]
    rfl
  -- The local ring of the chart at `q` and its map to `Λ`.
  set β : CommRingCat.of B ⟶ (Spec (CommRingCat.of B)).presheaf.stalk qS :=
    (Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
      (Spec (CommRingCat.of B)).presheaf.germ ⊤ qS trivial with hβ
  let algBS : Algebra B ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) :=
    β.hom.toAlgebra
  have hlocS : IsLocalization.AtPrime
      ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) qi :=
    StructureSheaf.IsLocalization.to_stalk (CommRingCat.of B) qS
  have hunits : ∀ t : qi.primeCompl, IsUnit ((h : B →+* Λ) (t : B)) := fun t =>
    IsLocalRing.notMem_maximalIdeal.mp (fun hc => t.2 hc)
  let algSΛ : Algebra ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) Λ :=
    (IsLocalization.lift (M := qi.primeCompl)
      (S := ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u)) hunits).toAlgebra
  have htowerBS : IsScalarTower B ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) Λ :=
    IsScalarTower.of_algebraMap_eq (fun x => (IsLocalization.lift_eq hunits x).symm)
  have hcompBSΛ : (algebraMap ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) Λ).comp
      (algebraMap B ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u)) = (h : B →+* Λ) :=
    RingHom.ext fun x => IsLocalization.lift_eq hunits x
  have hlocSΛ : IsLocalHom
      (algebraMap ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) Λ) := by
    refine ((IsLocalRing.local_hom_TFAE
      (algebraMap ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) Λ)).out 3 1).mp ?_
    rw [← IsLocalization.AtPrime.map_eq_maximalIdeal qi
      ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u), Ideal.map_map, hcompBSΛ,
      Ideal.map_le_iff_le_comap, hqi]
  have hindRB : StacksDraft.IndEtale (R : Type u) B :=
    AlgebraicGeometry.indEtale_of_etale hBet
  have hindBΛ : StacksDraft.IndEtale B Λ := StacksDraft.indEtale_of_comp hindRB hindRΛ
  have hindBS : StacksDraft.IndEtale B
      ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) :=
    StacksDraft.indEtale_atPrime qi
  have hindSΛ : StacksDraft.IndEtale
      ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) Λ :=
    StacksDraft.indEtale_of_comp hindBS hindBΛ
  have hflatSΛ : Module.Flat ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) Λ :=
    StacksDraft.flat_of_indEtale hindSΛ
  have hffSΛ : Module.FaithfullyFlat
      ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) Λ :=
    Module.FaithfullyFlat.of_flat_of_isLocalHom
  -- The two morphisms `Spec Λ ⟶ X` agree.
  set ψ : (Spec (CommRingCat.of B)).presheaf.stalk qS ⟶ CommRingCat.of Λ :=
    CommRingCat.ofHom
      (algebraMap ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) Λ) with hψ
  set ψ' : X.presheaf.stalk p ⟶ CommRingCat.of Λ :=
    CommRingCat.ofHom (algebraMap (X.presheaf.stalk p : Type u) Λ) with hψ'
  have hring : (φ ≫ β) ≫ ψ = γ ≫ ψ' := by
    refine CommRingCat.hom_ext (RingHom.ext fun x => ?_)
    show (algebraMap ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) Λ)
        (β.hom ((algebraMap (R : Type u) B) x))
      = (algebraMap (X.presheaf.stalk p : Type u) Λ) (γ.hom x)
    rw [hγ]
    show (algebraMap ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) Λ)
        ((algebraMap B ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u))
          ((algebraMap (R : Type u) B) x)) = _
    rw [← RingHom.comp_apply, hcompBSΛ]
    show h ((algebraMap (R : Type u) B) x) = _
    rw [h.commutes x]
    exact IsScalarTower.algebraMap_apply (R : Type u) (X.presheaf.stalk p : Type u) Λ x
  have hglue : Spec.map ψ ≫ (Spec (CommRingCat.of B)).fromSpecStalk qS ≫ gmor
      = Spec.map ψ' ≫ X.fromSpecStalk p := by
    rw [hgmor, Spec.fromSpecStalk_eq (CommRingCat.of B) qS, ← hβ, hcompat,
      show Spec.map ψ ≫ Spec.map β ≫ Spec.map φ ≫ ι = Spec.map ((φ ≫ β) ≫ ψ) ≫ ι from by
        simp only [Spec.map_comp, Category.assoc],
      hring, Spec.map_comp]
    simp only [Category.assoc]
  -- The stalk ideal at `q` is generated by the product of the branches.
  have : IsLocalHom ψ.hom := hlocSΛ
  have : IsLocalHom ψ'.hom := hlocAΛ
  have hcp1 := map_stalk_comap_specMap_fromSpecStalk D p ψ'
  have hcp2 := map_stalk_comap_specMap_fromSpecStalk (D.comap gmor) qS ψ
  have hcomapeq : (D.comap gmor).comap
      (Spec.map ψ ≫ (Spec (CommRingCat.of B)).fromSpecStalk qS)
      = D.comap (Spec.map ψ' ≫ X.fromSpecStalk p) := by
    rw [← Scheme.IdealSheafData.comap_comp, Category.assoc, hglue]
  have hkey1 : (AlgebraicGeometry.IdealSheafData.stalk (D.comap gmor) qS).map
      (algebraMap ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) Λ)
      = Ideal.span {(hs.take s).prod} := by
    have h2 : (AlgebraicGeometry.IdealSheafData.stalk (D.comap gmor) qS).map ψ.hom
        = Ideal.span {(hs.take s).prod} := by
      rw [← hcp2, hcomapeq, hcp1]
      exact hmapp
    exact h2
  have hkey2 : (Ideal.span {(algebraMap B
      ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) ys.prod)}).map
      (algebraMap ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) Λ)
      = Ideal.span {(hs.take s).prod} := by
    rw [Ideal.map_span, Set.image_singleton, ← RingHom.comp_apply, hcompBSΛ, hprodys]
  have hstalkq : AlgebraicGeometry.IdealSheafData.stalk (D.comap gmor) qS
      = Ideal.span {(algebraMap B
        ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) ys.prod)} :=
    Ideal.map_injective_of_faithfullyFlat
      (A := ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u)) (B := Λ)
      (by rw [hkey1, hkey2])
  -- Each branch is regular at `q`.
  have hregbranch : ∀ (y : B) (hy : y ∈ ys), IsRegularLocalRing (Localization.AtPrime
      (Stacks.NormalCrossingsChart.quotPoint y qP (hyq y hy)).asIdeal) := by
    intro y hy
    refine (Stacks.NormalCrossingsChart.isRegularLocalRing_quotient_iff_atPrime y qP (hyq y hy)
      ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u)).mp ?_
    have hmem : algebraMap B ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) y
        ∈ maximalIdeal ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) := by
      rw [← IsLocalization.AtPrime.map_eq_maximalIdeal qi
        ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u)]
      exact Ideal.mem_map_of_mem _ (hyq y hy)
    refine isRegularLocalRing_quotient_of_flat_of_isLocalHom Λ hmem ?_
    have heq : algebraMap ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) Λ
        (algebraMap B ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) y) = h y := by
      rw [← RingHom.comp_apply, hcompBSΛ]
      rfl
    rw [heq]
    exact IsRegularLocalRing.isRegularLocalRing_quotient_span_singleton_of_mem_isSystemOfParameters
      hsop hsgen (hyhs y hy)
  -- Shrink: one denominator per branch, and one for the ideal.
  have hsh : ∀ (y : B) (hy : y ∈ ys), ∃ t ∉ qi,
      ∀ (q' : PrimeSpectrum B) (hy' : y ∈ q'.asIdeal), t ∉ q'.asIdeal →
        IsDomain (Localization.AtPrime
          (Stacks.NormalCrossingsChart.quotPoint y q' hy').asIdeal) ∧
        IsIntegrallyClosed (Localization.AtPrime
          (Stacks.NormalCrossingsChart.quotPoint y q' hy').asIdeal) :=
    fun y hy => hshrink B hBet y qP (hyq y hy) (hregbranch y hy)
  choose tf htfq htf using hsh
  set t₁ : B := (ys.attach.map (fun z => tf z.1 z.2)).prod with ht₁
  have ht₁mem : t₁ ∈ qi.primeCompl := by
    rw [ht₁]
    refine Submonoid.list_prod_mem _ ?_
    intro x hx
    obtain ⟨z, -, rfl⟩ := List.mem_map.mp hx
    exact htfq z.1 z.2
  have hJmap : J.map (algebraMap B ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u))
      = (Ideal.span {ys.prod}).map
        (algebraMap B ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u)) := by
    rw [Ideal.map_span, Set.image_singleton, ← hstalkq]
    exact ((hJstalk qS).symm : _)
  obtain ⟨t₀, ht₀q, ht₀1, ht₀2⟩ := Ideal.exists_notMem_mul_mem_of_map_eq_map (q := qi)
    (IsNoetherian.noetherian J) ⟨{ys.prod}, by simp⟩
    ((Spec (CommRingCat.of B)).presheaf.stalk qS : Type u) hJmap
  set t : B := t₀ * t₁ with ht
  have htq : t ∉ qi := fun hc => (hqip.mem_or_mem hc).elim ht₀q (fun hc' => ht₁mem hc')
  set W : (Spec (CommRingCat.of B)).Opens := PrimeSpectrum.basicOpen t with hW
  have hqW : qS ∈ W := htq
  have hWet : AlgebraicGeometry.Etale W.ι := inferInstance
  refine ⟨W.toScheme, W.ι ≫ gmor, inferInstance,
    AlgebraicGeometry.Etale.etale_comp (f := W.ι) gmor, ⟨⟨qS, hqW⟩, hgq⟩, ?_⟩
  refine forall_normal_factorization_restrict gmor D W ?_
  intro x hxW hxs
  have hxp : x.asIdeal.IsPrime := x.isPrime
  let algBSx : Algebra B ((Spec (CommRingCat.of B)).presheaf.stalk x : Type u) :=
    ((Scheme.ΓSpecIso (CommRingCat.of B)).inv ≫
      (Spec (CommRingCat.of B)).presheaf.germ ⊤ x trivial).hom.toAlgebra
  have hlocSx : IsLocalization.AtPrime
      ((Spec (CommRingCat.of B)).presheaf.stalk x : Type u) x.asIdeal :=
    StructureSheaf.IsLocalization.to_stalk (CommRingCat.of B) x
  have htx : t ∉ x.asIdeal := hxW
  have ht₀x : t₀ ∉ x.asIdeal := fun hc => htx (ht ▸ Ideal.mul_mem_right _ _ hc)
  have ht₁x : t₁ ∉ x.asIdeal := fun hc => htx (ht ▸ Ideal.mul_mem_left _ _ hc)
  have hunit₀ : IsUnit (algebraMap B
      ((Spec (CommRingCat.of B)).presheaf.stalk x : Type u) t₀) :=
    IsLocalization.map_units (M := x.asIdeal.primeCompl)
      ((Spec (CommRingCat.of B)).presheaf.stalk x : Type u)
      (⟨t₀, ht₀x⟩ : x.asIdeal.primeCompl)
  have hJx : AlgebraicGeometry.IdealSheafData.stalk (D.comap gmor) x
      = Ideal.span {(algebraMap B
          ((Spec (CommRingCat.of B)).presheaf.stalk x : Type u) ys.prod)} := by
    have e1 : AlgebraicGeometry.IdealSheafData.stalk (D.comap gmor) x
        = J.map (algebraMap B ((Spec (CommRingCat.of B)).presheaf.stalk x : Type u)) :=
      hJstalk x
    rw [e1, Ideal.map_eq_map_of_mul_mem _ hunit₀ ht₀1 ht₀2, Ideal.map_span, Set.image_singleton]
  -- The branches through `x`.
  set l : List ((Spec (CommRingCat.of B)).presheaf.stalk x : Type u) :=
    ys.map (algebraMap B ((Spec (CommRingCat.of B)).presheaf.stalk x : Type u)) with hl
  set P : ((Spec (CommRingCat.of B)).presheaf.stalk x : Type u) → Bool :=
    fun z => decide (¬ IsUnit z) with hP
  have hlprod : l.prod
      = algebraMap B ((Spec (CommRingCat.of B)).presheaf.stalk x : Type u) ys.prod := by
    rw [hl, ← map_list_prod]
  have hspanfilter : Ideal.span {(l.filter P).prod} = Ideal.span {l.prod} := by
    refine span_prod_filter P l (fun a _ ha => ?_)
    by_contra hc
    simp only [hP, decide_eq_false_iff_not, not_not] at ha
    exact hc ha
  have hmemBtoIdeal : ∀ y : B, ¬ IsUnit (algebraMap B
      ((Spec (CommRingCat.of B)).presheaf.stalk x : Type u) y) → y ∈ x.asIdeal := by
    intro y hy
    by_contra hc
    exact hy (IsLocalization.map_units (M := x.asIdeal.primeCompl)
      ((Spec (CommRingCat.of B)).presheaf.stalk x : Type u)
      (⟨y, hc⟩ : x.asIdeal.primeCompl))
  refine ⟨l.filter P, ?_, ?_, ?_⟩
  · intro f hf
    rw [List.mem_filter] at hf
    obtain ⟨y, hy, rfl⟩ := List.mem_map.mp (hl ▸ hf.1)
    have hnu : ¬ IsUnit (algebraMap B
        ((Spec (CommRingCat.of B)).presheaf.stalk x : Type u) y) := by
      have := hf.2
      simp only [hP, decide_eq_true_eq] at this
      exact this
    have hyx : y ∈ x.asIdeal := hmemBtoIdeal y hnu
    have htfx : tf y hy ∉ x.asIdeal := by
      intro hc
      refine ht₁x ?_
      have hdvd : tf y hy ∣ t₁ := by
        rw [ht₁]
        exact List.dvd_prod (List.mem_map_of_mem (List.mem_attach ys ⟨y, hy⟩))
      obtain ⟨c, hc'⟩ := hdvd
      rw [hc']
      exact Ideal.mul_mem_right _ _ hc
    exact (Stacks.NormalCrossingsChart.isDomain_and_isIntegrallyClosed_quotient_iff_atPrime y x
      hyx ((Spec (CommRingCat.of B)).presheaf.stalk x : Type u)).mpr (htf y hy x hyx htfx)
  · by_contra hc
    have hnil : l.filter P = [] := List.eq_nil_of_length_eq_zero (by omega)
    have htop : AlgebraicGeometry.IdealSheafData.stalk (D.comap gmor) x = ⊤ := by
      rw [hJx, ← hlprod, ← hspanfilter, hnil]
      simp
    exact (stalk_eq_top_iff_notMem_support _ x).mp htop hxs
  · rw [hJx, ← hlprod, ← hspanfilter]

end Stacks.Divisors

