module

public import StacksFrontier.AlgebraicGeometry.Divisors.RegularImmersion.FlatAtDivisor
public import StacksFrontier.AlgebraicGeometry.Etale.NormalCrossings.Defs
public import StacksFrontier.RingTheory.RegularLocalRing.SystemOfParametersProduct

/-!
# The stalk ideal of a strict normal crossings divisor

The strict normal crossings condition on an ideal sheaf `D` of a locally Noetherian scheme `X` is
stated at a point `y` of the subscheme cut out by `D`, in terms of the kernel of the stalk map of
the closed immersion `D.subschemeι`. That kernel is the stalk of the ideal sheaf itself, so the
condition can be read off directly from `Scheme.IdealSheafData.stalk`: at every point `x` of the
support of `D` the local ring `𝒪_{X, x}` is regular and the ideal `D_x` is generated by the
product of an initial segment of a regular system of parameters. In particular `D_x` is generated
by a nonzerodivisor.

## Main results

* `Stacks.Divisors.exists_isSystemOfParameters_stalk_eq_of_isStrictNormalCrossingsDivisor`: the
  strict normal crossings condition, read on the stalk ideal.
* `Stacks.Divisors.exists_mem_nonZeroDivisors_stalk_eq_of_isStrictNormalCrossingsDivisor`: the
  stalk ideal of a strict normal crossings divisor is generated by a nonzerodivisor.

## Implementation notes

Points of the support of `D` and points of `D.subscheme` are interchanged by
`Scheme.IdealSheafData.range_subschemeι`, which identifies the range of the closed immersion with
the support. Phrasing the hypothesis as membership in the support rather than as a point of the
subscheme is what makes the statements free of transport along an equality of points: the point of
`X` is a variable, so the chosen point of the subscheme can be substituted for it.

The identification of the kernel of the stalk map with the stalk ideal is
`AlgebraicGeometry.stalk_ker_eq_of_affine_target`, applied on any affine open neighbourhood,
together with `Scheme.IdealSheafData.ker_subschemeι`.

The nonzerodivisor statement needs no further geometry: it is
`IsRegularLocalRing.mem_nonZeroDivisors_prod_take_of_ofList_eq_maximalIdeal` applied in the stalk,
whose regularity is the first conjunct of the strict normal crossings condition.

## References

* [Stacks Project, Tag 0BI9](https://stacks.math.columbia.edu/tag/0BI9)
* [Stacks Project, Tag 0AG8](https://stacks.math.columbia.edu/tag/0AG8)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory IsLocalRing

universe u

namespace Stacks.Divisors

/-- **The strict normal crossings condition read on the stalk ideal.** For `D` a strict normal
crossings divisor on a locally Noetherian scheme `X` and `x` a point of the support of `D`, the
local ring `𝒪_{X, x}` is regular and the stalk of `D` at `x` is generated by the product of a
nonempty initial segment of a regular system of parameters. -/
theorem exists_isSystemOfParameters_stalk_eq_of_isStrictNormalCrossingsDivisor
    {X : Scheme.{u}} [IsLocallyNoetherian X] (D : X.IdealSheafData)
    (hD : IsStrictNormalCrossingsDivisor D) (x : X) (hx : x ∈ D.support) :
    IsRegularLocalRing (X.presheaf.stalk x) ∧
      ∃ (rs : List (X.presheaf.stalk x)) (r : ℕ), IsSystemOfParameters rs ∧
        Ideal.ofList rs = maximalIdeal (X.presheaf.stalk x) ∧ 1 ≤ r ∧ r ≤ rs.length ∧
          AlgebraicGeometry.IdealSheafData.stalk D x = Ideal.span {(rs.take r).prod} := by
  obtain ⟨y, rfl⟩ : ∃ y : D.subscheme, D.subschemeι y = x :=
    (Scheme.IdealSheafData.range_subschemeι (I := D)).ge hx
  obtain ⟨hreg, rs, r, hrs, hgen, hr1, hrle, hker⟩ := hD.2 y
  obtain ⟨U, hxU⟩ := exists_affineOpens_mem (D.subschemeι y)
  have hstalk := AlgebraicGeometry.stalk_ker_eq_of_affine_target D.subschemeι y U.1 U.2 hxU
  rw [Scheme.IdealSheafData.ker_subschemeι] at hstalk
  exact ⟨hreg, rs, r, hrs, hgen, hr1, hrle, hstalk.trans hker⟩

/-- **The stalk ideal of a strict normal crossings divisor is generated by a nonzerodivisor.**
This is the hypothesis of the stalkwise criterion for an effective Cartier divisor, Tag 0AG8. -/
theorem exists_mem_nonZeroDivisors_stalk_eq_of_isStrictNormalCrossingsDivisor
    {X : Scheme.{u}} [IsLocallyNoetherian X] (D : X.IdealSheafData)
    (hD : IsStrictNormalCrossingsDivisor D) (x : X) (hx : x ∈ D.support) :
    ∃ f ∈ nonZeroDivisors (X.presheaf.stalk x),
      AlgebraicGeometry.IdealSheafData.stalk D x = Ideal.span {f} := by
  obtain ⟨hreg, rs, r, hrs, hgen, -, -, hstalk⟩ :=
    exists_isSystemOfParameters_stalk_eq_of_isStrictNormalCrossingsDivisor D hD x hx
  have := hreg
  exact ⟨(rs.take r).prod,
    IsRegularLocalRing.mem_nonZeroDivisors_prod_take_of_ofList_eq_maximalIdeal hrs hgen r, hstalk⟩

end Stacks.Divisors

end
