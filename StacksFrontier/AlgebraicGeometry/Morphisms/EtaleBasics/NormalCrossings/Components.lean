/-!
# Characterization of strict normal crossings divisors

An effective Cartier divisor on a locally Noetherian scheme has strict normal crossings exactly
when it is reduced, each of its irreducible components is an effective Cartier divisor, and
every nonempty finite intersection of components is regular with all of its own components of
the expected codimension.

## Main definitions

* `Stacks.Divisors.componentIdeal` gives an irreducible component of a divisor its reduced
  closed subscheme structure in the ambient scheme.
* `Stacks.Divisors.componentIntersection` is the scheme-theoretic intersection of a finite set
  of components.

## Main results

* `Stacks.Divisors.isStrictNormalCrossingsDivisor_iff` characterizes strict normal crossings
  divisors by their components and the intersections of those components.
* `Stacks.Divisors.kernel_stalkMap_subscheme_eq_idealStalk` and
  `Stacks.Divisors.idealStalk_iSup_eq_iSup` are the two stalk computations behind the
  characterization, stated for consumers outside this file.
* `Stacks.Divisors.le_span_singleton_prod_of_forall_le` and
  `Stacks.Divisors.span_singleton_prod_eq_of_forall_le`: for a regular sequence in a Noetherian
  local ring, the ideal generated by the product of the entries is the intersection of the
  principal ideals they generate.
* `Stacks.Divisors.exists_isWeaklyRegular_ofList_eq_stalk_componentIntersection` reads the
  stalk of the ideal sheaf of an intersection of components off a regular system of parameters:
  it is generated by a weakly regular sequence of length the number of components.

## Implementation notes

Irreducible components are indexed by the irreducible components of the divisor's underlying
closed subscheme. Their images in the ambient scheme carry the canonical reduced closed
subscheme structure, and the supremum of their ideal sheaves defines their scheme-theoretic
intersection. Codimension is measured in the ambient scheme at the image of the generic point
of each component of the intersection.

Both directions are proved at the level of stalks. Going from strict normal crossings to the
three conditions, the local equation of the divisor factors as a product of a regular system of
parameters, each factor cutting out one component; reducedness and the Cartier property of the
components follow, and regularity of an intersection comes from the quotient of a regular local
ring by part of a regular system of parameters. The converse reconstructs the local equation at
a point as the product over the finitely many components through that point, the key input being
that the stalk of the ideal sheaf of a reduced divisor is the intersection of the stalks of its
components and that a finite intersection of distinct principal primes in a regular local ring
is their product.

## References

* [Stacks Project, Tag 0BIA](https://stacks.math.columbia.edu/tag/0BIA)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace

universe u

namespace Stacks.Divisors

/-- An irreducible component of a closed subscheme, with its reduced closed
subscheme structure in the ambient scheme. -/
public def componentIdeal {X : Scheme.{u}} (D : X.IdealSheafData)
    (C : irreducibleComponents D.subscheme) : X.IdealSheafData :=
  Scheme.IdealSheafData.vanishingIdeal
    ⟨closure (D.subschemeι '' (C : Set D.subscheme)), isClosed_closure⟩

/-- The scheme-theoretic intersection of a finite set of irreducible components. -/
public def componentIntersection {X : Scheme.{u}} (D : X.IdealSheafData)
    (J : Finset (irreducibleComponents D.subscheme)) : X.IdealSheafData :=
  ⨆ C ∈ J, componentIdeal D C

private lemma componentIdeal_support_eq_image {X : Scheme.{u}}
    (D : X.IdealSheafData) (C : irreducibleComponents D.subscheme) :
    (componentIdeal D C).support =
      ⟨D.subschemeι '' (C : Set D.subscheme), by
        exact D.subschemeι.isClosedEmbedding.isClosedMap _
          (isClosed_of_mem_irreducibleComponents _ C.2)⟩ := by
  ext x
  change x ∈ closure (D.subschemeι '' (C : Set D.subscheme)) ↔
    x ∈ D.subschemeι '' (C : Set D.subscheme)
  rw [(D.subschemeι.isClosedEmbedding.isClosedMap _
    (isClosed_of_mem_irreducibleComponents _ C.2)).closure_eq]

private lemma componentIdeal_support_covers {X : Scheme.{u}}
    (D : X.IdealSheafData) (y : D.subscheme) :
    ∃ C : irreducibleComponents D.subscheme,
      D.subschemeι y ∈ (componentIdeal D C).support := by
  refine ⟨⟨irreducibleComponent y, irreducibleComponent_mem_irreducibleComponents y⟩, ?_⟩
  rw [componentIdeal_support_eq_image]
  exact ⟨y, mem_irreducibleComponent, rfl⟩

private lemma componentIdeal_isReduced {X : Scheme.{u}}
    (D : X.IdealSheafData) (C : irreducibleComponents D.subscheme) :
    IsReduced (componentIdeal D C).subscheme :=
  Scheme.IdealSheafData.isReduced_subscheme_vanishingIdeal _

private lemma componentIdeal_isIntegral {X : Scheme.{u}}
    (D : X.IdealSheafData) (C : irreducibleComponents D.subscheme) :
    IsIntegral (componentIdeal D C).subscheme := by
  let I := componentIdeal D C
  let : IsReduced I.subscheme := componentIdeal_isReduced D C
  let : IrreducibleSpace I.subscheme :=
    Scheme.IdealSheafData.irreducibleSpace_subscheme X I (by
      rw [I.range_subschemeι, componentIdeal_support_eq_image]
      exact C.2.1.image D.subschemeι.base D.subschemeι.continuous.continuousOn)
  exact isIntegral_of_irreducibleSpace_of_isReduced I.subscheme

attribute [local instance] componentIdeal_isIntegral

private lemma componentIntersection_support_eq_iInter {X : Scheme.{u}}
    (D : X.IdealSheafData)
    (J : Finset (irreducibleComponents D.subscheme)) :
    (componentIntersection D J).support = ⨅ C ∈ J, (componentIdeal D C).support := by
  simp [componentIntersection]

private lemma componentIdeal_genericPoint_closure {X : Scheme.{u}}
    (D : X.IdealSheafData) (C : irreducibleComponents D.subscheme)
    [IsIntegral (componentIdeal D C).subscheme] :
    closure ({(componentIdeal D C).subschemeι
                (_root_.genericPoint (componentIdeal D C).subscheme)} : Set X) =
        D.subschemeι '' (C : Set D.subscheme) := by
  let I := componentIdeal D C
  rw [← Set.image_singleton, I.subschemeι.isClosedEmbedding.closure_image_eq,
    genericPoint_closure, Set.image_univ, I.range_subschemeι]
  exact congrArg Closeds.carrier (componentIdeal_support_eq_image D C)

private lemma componentSupport_genericPoint_closure {X : Scheme.{u}}
    (D : X.IdealSheafData) (C : irreducibleComponents D.subscheme) :
    closure ({D.subschemeι C.2.1.genericPoint} : Set X) =
      D.subschemeι '' (C : Set D.subscheme) := by
  rw [← Set.image_singleton, D.subschemeι.isClosedEmbedding.closure_image_eq]
  exact congrArg (fun s : Set D.subscheme => D.subschemeι '' s)
    (C.2.1.isGenericPoint_genericPoint
      (isClosed_of_mem_irreducibleComponents _ C.2)).def

private lemma componentIdeal_genericPoint_eq_componentGenericPoint {X : Scheme.{u}}
    (D : X.IdealSheafData) (C : irreducibleComponents D.subscheme)
    [IsIntegral (componentIdeal D C).subscheme] :
    (componentIdeal D C).subschemeι
        (_root_.genericPoint (componentIdeal D C).subscheme) =
      D.subschemeι C.2.1.genericPoint :=
  (isGenericPoint_def.mpr (componentIdeal_genericPoint_closure D C)).eq
    (isGenericPoint_def.mpr (componentSupport_genericPoint_closure D C))

private alias codimension_closureSingleton_eq_coheight :=
  Stacks.AlgebraicGeometry.CodimensionOneDivisor.codimension_closureSingleton_eq_coheight

private lemma component_genericPoint_codimension_one {X : Scheme.{u}}
    [IsLocallyNoetherian X] (D : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D)
    (C : irreducibleComponents D.subscheme) :
    codimension (IrreducibleCloseds.closureSingleton
      (D.subschemeι C.2.1.genericPoint)) = 1 := by
  rw [codimension_closureSingleton_eq_coheight]
  have hdim : (Order.coheight (D.subschemeι C.2.1.genericPoint) : WithBot ℕ∞) = 1 := by
    rw [← AlgebraicGeometry.ringKrullDim_stalk_eq_coheight]
    exact_mod_cast ringKrullDim_stalk_eq_one_of_isEffectiveCartierDivisor D hD
      C.2.1.genericPoint
      ⟨C, C.2.1.isGenericPoint_genericPoint (isClosed_of_mem_irreducibleComponents _ C.2)⟩
  exact_mod_cast hdim

/-- Each irreducible component of a strict normal crossings divisor is an effective Cartier
divisor: it is integral of codimension one in a scheme whose local rings along it are regular,
hence unique factorization domains. -/
private lemma componentIdeal_effectiveCartier_of_strictNormalCrossings
    {X : Scheme.{u}} [IsLocallyNoetherian X] (D : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D)
    (hSNCD : IsStrictNormalCrossingsDivisor D)
    (C : irreducibleComponents D.subscheme) :
    IsEffectiveCartierDivisor
      (componentIdeal D C) := by
  have hUFD : ∀ x : X, x ∈ (componentIdeal D C).support →
      UniqueFactorizationMonoid (X.presheaf.stalk x) := by
    intro x hx
    rw [componentIdeal_support_eq_image D C] at hx
    obtain ⟨y, -, rfl⟩ := hx
    have := (hSNCD.2 y).1
    exact IsRegularLocalRing.uniqueFactorizationMonoid _
  have hcodim := component_genericPoint_codimension_one D hD C
  rw [← componentIdeal_genericPoint_eq_componentGenericPoint D C] at hcodim
  exact isEffectiveCartierDivisor_of_codimension_one_of_uniqueFactorizationMonoid
    (I := componentIdeal D C)
    (hcodim := hcodim) hUFD

private lemma idealStalk_iSup {X : Scheme.{u}} (ι : Type*)
    (F : ι → X.IdealSheafData) (x : X) :
    IdealSheafData.stalk (⨆ i, F i) x =
      ⨆ i, IdealSheafData.stalk (F i) x := by
  simp only [IdealSheafData.stalk, Scheme.IdealSheafData.ideal_iSup,
    iSup_apply, Ideal.map_iSup]
  exact le_antisymm
    (iSup₂_le fun U hs => iSup_le fun i => le_iSup_of_le i (le_iSup₂_of_le U hs le_rfl))
    (iSup_le fun i => iSup₂_le fun U hs => le_iSup₂_of_le U hs (le_iSup_of_le i le_rfl))

private lemma componentIntersection_stalk_eq_iSup {X : Scheme.{u}}
    (D : X.IdealSheafData) (J : Finset (irreducibleComponents D.subscheme))
    (x : X) :
    IdealSheafData.stalk (componentIntersection D J) x =
      ⨆ C ∈ J, IdealSheafData.stalk (componentIdeal D C) x := by
  have hsup : componentIntersection D J =
      ⨆ C : {C // C ∈ J}, componentIdeal D C.1 :=
    (iSup_subtype'' (s := (J : Set (irreducibleComponents D.subscheme)))
      (f := componentIdeal D)).symm
  rw [hsup, idealStalk_iSup]
  exact iSup_subtype'' (s := (J : Set (irreducibleComponents D.subscheme)))
    (f := fun C => IdealSheafData.stalk (componentIdeal D C) x)

private lemma kernel_stalkMap_subscheme
    {X : Scheme.{u}} (I : X.IdealSheafData) (y : I.subscheme) :
    RingHom.ker (I.subschemeι.stalkMap y).hom =
      IdealSheafData.stalk I (I.subschemeι y) := by
  let x := I.subschemeι y
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, -⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  let f := I.subschemeι
  let V := f ⁻¹ᵁ (U : X.Opens)
  let hV : IsAffineOpen V := hU.preimage f
  have hyV : y ∈ V := hxU
  let p := hU.primeIdealOf ⟨x, hxU⟩
  let q := hV.primeIdealOf ⟨y, hyV⟩
  let g := (f.app U).hom
  have hqp : q.asIdeal.comap g = p.asIdeal :=
    congrArg PrimeSpectrum.asIdeal (by
      simpa [q, p, g, f, V, Scheme.Hom.app_eq_appLE] using
        IsAffineOpen.comap_primeIdealOf_appLE (f := f) U hU V hV le_rfl (x := y) hyV :
      q.comap g = p)
  let M := p.asIdeal.primeCompl
  let T := q.asIdeal.primeCompl
  have hMT : Submonoid.map g M = T := by
    ext b
    change (∃ a ∈ M, g a = b) ↔ b ∈ T
    constructor
    · rintro ⟨a, ha, rfl⟩ hga
      exact ha (hqp.le hga)
    · intro hb
      obtain ⟨a, rfl⟩ := (I.subschemeι_app_surjective ⟨U, hU⟩) b
      exact ⟨a, fun ha => hb (hqp.ge ha), rfl⟩
  let : Algebra Γ(X, U) (X.presheaf.stalk x) :=
    X.presheaf.algebra_section_stalk ⟨x, hxU⟩
  let : IsLocalization M (X.presheaf.stalk x) := hU.isLocalization_stalk ⟨x, hxU⟩
  let : Algebra Γ(I.subscheme, V) (I.subscheme.presheaf.stalk y) :=
    I.subscheme.presheaf.algebra_section_stalk ⟨y, hyV⟩
  let : IsLocalization T (I.subscheme.presheaf.stalk y) :=
    hV.isLocalization_stalk ⟨y, hyV⟩
  have hle : M ≤ Submonoid.comap g T := Submonoid.map_le_iff_le_comap.mp hMT.le
  let g' : X.presheaf.stalk x →+* I.subscheme.presheaf.stalk y :=
    IsLocalization.map (I.subscheme.presheaf.stalk y) g hle
  have hg' : g'.comp (algebraMap Γ(X, U) (X.presheaf.stalk x)) =
      (algebraMap Γ(I.subscheme, V) (I.subscheme.presheaf.stalk y)).comp g :=
    IsLocalization.map_comp _
  have hstalk : (I.subschemeι.stalkMap y).hom = g' :=
    IsLocalization.ringHom_ext M <|
      (CommRingCat.hom_ext_iff.mp (Scheme.Hom.germ_stalkMap f (U : X.Opens) y hxU)).trans hg'.symm
  have hkernel : RingHom.ker g = I.ideal ⟨U, hU⟩ := by
    simpa [g, f, Scheme.Hom.app_eq_appLE] using
      Scheme.IdealSheafData.ker_subschemeι_app I ⟨U, hU⟩
  rw [hstalk, IsLocalization.ker_map _ g hMT, hkernel,
    IdealSheafData.stalk_eq_map_germ I x ⟨U, hU⟩ hxU]
  rfl

private lemma regular_stalk_of_regular_subscheme
    {X : Scheme.{u}} (I : X.IdealSheafData)
    (hI : AlgebraicGeometry.IsRegular I.subscheme) (y : I.subscheme) :
    IsRegularLocalRing (I.subscheme.presheaf.stalk y) := by
  obtain ⟨U, hyU, hU⟩ := hI y
  have : IsRegularRing Γ(I.subscheme, U) := hU
  let := I.subscheme.presheaf.algebra_section_stalk ⟨y, hyU⟩
  have := U.2.isLocalization_stalk ⟨y, hyU⟩
  exact IsRegularRing.isRegularLocalRing_of_isLocalization
    (U.2.primeIdealOf ⟨y, hyU⟩).asIdeal (I.subscheme.presheaf.stalk y)

private lemma regular_stalk_quotient_of_regular_subscheme
    {X : Scheme.{u}} (I : X.IdealSheafData)
    (hI : AlgebraicGeometry.IsRegular I.subscheme) (y : I.subscheme) :
    IsRegularLocalRing
      (X.presheaf.stalk (I.subschemeι y) ⧸
        IdealSheafData.stalk I (I.subschemeι y)) := by
  have := regular_stalk_of_regular_subscheme I hI y
  rw [← kernel_stalkMap_subscheme I y]
  exact IsRegularLocalRing.of_ringEquiv ((I.subschemeι.stalkMap y).hom.quotientKerEquivOfSurjective
    (I.subschemeι.stalkMap_surjective y)).symm

private lemma componentIntersection_stalk_quotient_regular
    {X : Scheme.{u}} (D : X.IdealSheafData)
    (J : Finset (irreducibleComponents D.subscheme))
    (hJ : AlgebraicGeometry.IsRegular (componentIntersection D J).subscheme)
    {x : X} (hx : x ∈ (componentIntersection D J).support) :
    IsRegularLocalRing
      (X.presheaf.stalk x ⧸
        IdealSheafData.stalk (componentIntersection D J) x) := by
  obtain ⟨y, rfl⟩ := (componentIntersection D J).range_subschemeι.symm.subset hx
  exact regular_stalk_quotient_of_regular_subscheme _ hJ y

private lemma componentIdeal_stalk_isPrime_at_support {X : Scheme.{u}}
    (D : X.IdealSheafData) (C : irreducibleComponents D.subscheme)
    {x : X} (hx : x ∈ (componentIdeal D C).support) :
    (IdealSheafData.stalk (componentIdeal D C) x).IsPrime := by
  obtain ⟨y, rfl⟩ := (componentIdeal D C).range_subschemeι.symm.subset hx
  rw [← kernel_stalkMap_subscheme]
  exact RingHom.ker_isPrime _

private lemma regularSequence_mem_isSMulRegular
    {R M : Type*} [CommRing R] [IsLocalRing R] [AddCommGroup M]
    [Module R M] [IsNoetherian R M] {rs : List R}
    (h : RingTheory.Sequence.IsRegular M rs) {a : R} (ha : a ∈ rs) :
    IsSMulRegular M a := by
  classical
  exact ((RingTheory.Sequence.isRegular_cons_iff M a (rs.erase a)).mp
    (IsLocalRing.isRegular_of_perm h (List.perm_cons_erase ha))).1

private lemma regularSequence_prod_isSMulRegular
    {R M : Type*} [CommRing R] [IsLocalRing R] [AddCommGroup M]
    [Module R M] [IsNoetherian R M] {rs : List R}
    (h : RingTheory.Sequence.IsRegular M rs) : IsSMulRegular M rs.prod :=
  List.prod_induction (IsSMulRegular M) (fun _ _ ha hb => ha.mul hb)
    (IsSMulRegular.one M) (fun _ ha => regularSequence_mem_isSMulRegular h ha)

private lemma span_prod_cons_eq_inf
    {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    {x : R} {xs : List R} (h : RingTheory.Sequence.IsRegular R (x :: xs)) :
    Ideal.span {(x :: xs).prod} = Ideal.span {xs.prod} ⊓ Ideal.span {x} := by
  have hle := smul_top_inf_eq_smul_of_isSMulRegular_on_quot
    (regularSequence_prod_isSMulRegular ((RingTheory.Sequence.isRegular_cons_iff R x xs).mp h).2)
  simp only [← Submodule.ideal_span_singleton_smul, Ideal.smul_eq_mul, Ideal.mul_top,
    Ideal.span_singleton_mul_span_singleton] at hle
  refine le_antisymm ?_ (by simpa only [List.prod_cons, mul_comm] using hle)
  rw [List.prod_cons, ← Ideal.span_singleton_mul_span_singleton, mul_comm]
  exact Ideal.mul_le_inf

private lemma regularSequence_prefix
    {R M : Type*} [CommRing R] [IsLocalRing R] [AddCommGroup M]
    [Module R M] [IsNoetherian R M] {xs ys : List R}
    (h : RingTheory.Sequence.IsRegular M (xs ++ ys)) :
    RingTheory.Sequence.IsRegular M xs := by
  refine ⟨(RingTheory.Sequence.isWeaklyRegular_append_iff M xs ys).mp h.toIsWeaklyRegular |>.1,
    fun heq => h.top_ne_smul (top_unique ?_).symm⟩
  rw [Ideal.ofList_append, Submodule.sup_smul]
  exact heq.le.trans le_sup_left

private lemma regularSequence_tail
    {R M : Type*} [CommRing R] [IsLocalRing R] [AddCommGroup M]
    [Module R M] [IsNoetherian R M] {x : R} {xs : List R}
    (h : RingTheory.Sequence.IsRegular M (x :: xs)) :
    RingTheory.Sequence.IsRegular M xs :=
  regularSequence_prefix (ys := [x])
    (IsLocalRing.isRegular_of_perm h (List.perm_append_comm (l₁ := [x])))

private lemma radical_span_prod_of_regularSequence
    {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R]
    {xs : List R} (h : RingTheory.Sequence.IsRegular R xs)
    (hprime : ∀ x ∈ xs, (Ideal.span {x}).IsPrime) :
    (Ideal.span {xs.prod}).IsRadical := by
  induction xs with
  | nil =>
    simp only [List.prod_nil, Ideal.span_singleton_one]
    exact le_top
  | cons x xs ih =>
    rw [span_prod_cons_eq_inf h]
    exact (ih (regularSequence_tail h) (fun a ha => hprime a (by simp [ha]))).inf
      (hprime x (by simp)).isRadical

private lemma regularSystemOfParameters_length
    {R : Type*} [CommRing R] [IsRegularLocalRing R]
    {rs : List R} (hparams : IsLocalRing.IsSystemOfParameters rs) :
    rs.length = (IsLocalRing.maximalIdeal R).spanFinrank := by
  have hlen : (rs.length : WithBot ℕ∞) = ringKrullDim R := by exact_mod_cast hparams.2.symm
  exact_mod_cast hlen.trans IsRegularLocalRing.spanFinrank_maximalIdeal.symm

/-- A nodup sublist of a regular system of parameters extends to a regular system of parameters
by appending a list. -/
private lemma exists_append_parameters
    {R : Type*} [CommRing R] [IsRegularLocalRing R]
    {rs xs : List R} (hgen : Ideal.ofList rs = IsLocalRing.maximalIdeal R)
    (hlen : rs.length = (IsLocalRing.maximalIdeal R).spanFinrank)
    (hxs : xs.Nodup) (hsub : xs ⊆ rs) :
    ∃ ys : List R, Ideal.ofList (xs ++ ys) = IsLocalRing.maximalIdeal R ∧
      (xs ++ ys).length = (IsLocalRing.maximalIdeal R).spanFinrank := by
  obtain ⟨ts, hp, hs⟩ := List.subperm_iff.mp (hxs.subperm hsub)
  obtain ⟨ys, hys⟩ := hs.exists_perm_append
  have hperm : rs.Perm (xs ++ ys) := hp.symm.trans hys
  refine ⟨ys, ?_, hperm.length_eq.symm.trans hlen⟩
  rw [← hgen]
  exact congrArg Ideal.span (Set.ext fun a => hperm.mem_iff.symm)

private lemma regular_quotient_of_subset_parameters
    {R : Type*} [CommRing R] [IsRegularLocalRing R]
    {rs xs : List R} (hgen : Ideal.ofList rs = IsLocalRing.maximalIdeal R)
    (hlen : rs.length = (IsLocalRing.maximalIdeal R).spanFinrank)
    (hxs : xs.Nodup) (hsub : xs ⊆ rs) :
    IsRegularLocalRing (R ⧸ Ideal.ofList xs) ∧
      ringKrullDim (R ⧸ Ideal.ofList xs) + xs.length = ringKrullDim R := by
  obtain ⟨ys, hgen', hlen'⟩ := exists_append_parameters hgen hlen hxs hsub
  have h :=
    ((IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      R).1 (xs ++ ys) hgen' hlen').2 xs.length (by simp)
  rwa [List.take_left] at h

private lemma regularSystemOfParameters_prime
    {R : Type*} [CommRing R] [IsRegularLocalRing R]
    {rs : List R} (hgen : Ideal.ofList rs = IsLocalRing.maximalIdeal R)
    (hlen : rs.length = (IsLocalRing.maximalIdeal R).spanFinrank)
    {a : R} (ha : a ∈ rs) : (Ideal.span {a}).IsPrime := by
  have hq := (regular_quotient_of_subset_parameters hgen hlen (List.nodup_singleton a)
    (List.cons_subset.mpr ⟨ha, List.nil_subset rs⟩)).1
  rw [Ideal.ofList_singleton] at hq
  exact (Ideal.Quotient.isDomain_iff_prime _).mp (IsRegularLocalRing.isDomain _)

private lemma regularSystemOfParameters_prod_isRadical
    {R : Type*} [CommRing R] [IsRegularLocalRing R]
    {rs : List R} (hparams : IsLocalRing.IsSystemOfParameters rs)
    (hgen : Ideal.ofList rs = IsLocalRing.maximalIdeal R) (n : ℕ) :
    (Ideal.span {(rs.take n).prod}).IsRadical := by
  have hlen := regularSystemOfParameters_length hparams
  have hreg :=
    ((IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      R).1 rs hgen hlen).1
  exact radical_span_prod_of_regularSequence
    (regularSequence_prefix (ys := rs.drop n) (by simpa only [List.take_append_drop] using hreg))
    (fun a ha => regularSystemOfParameters_prime hgen hlen (List.mem_of_mem_take ha))

private lemma isReduced_of_strictNormalCrossings
    {X : Scheme.{u}} [IsLocallyNoetherian X] (D : X.IdealSheafData)
    (h : IsStrictNormalCrossingsDivisor D) : IsReduced D.subscheme := by
  have hstalk (y : D.subscheme) : IsReduced (D.subscheme.presheaf.stalk y) := by
    let R := X.presheaf.stalk (D.subschemeι y)
    obtain ⟨hR, rs, r, hparams, hgen, _, _, hker⟩ := h.2 y
    have : IsRegularLocalRing R := hR
    let f := (D.subschemeι.stalkMap y).hom
    have : IsReduced (R ⧸ RingHom.ker f) := by
      rw [hker]
      exact (Ideal.isRadical_iff_quotient_reduced _).mp
        (regularSystemOfParameters_prod_isRadical hparams hgen r)
    let e := f.quotientKerEquivOfSurjective (D.subschemeι.stalkMap_surjective y)
    exact isReduced_of_injective e.symm e.symm.injective
  exact isReduced_of_isReduced_stalk D.subscheme

private theorem exists_regular_generator_at_support
    {X : Scheme.{u}} (I : X.IdealSheafData) (x : X)
    (hI : IsEffectiveCartierDivisor I)
    (hx : x ∈ I.support) :
    ∃ b : X.presheaf.stalk x,
      b ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) ∧ IsRegular b ∧
        IdealSheafData.stalk I x = Ideal.span {b} := by
  obtain ⟨U, hU, hxU, a, ha, e, he⟩ := (isEffectiveCartierDivisor_iff_affineLocal I).mp hI x
    (by rwa [Scheme.IdealSheafData.mem_supportSet_iff_mem_support])
  have hgen : I.ideal ⟨U, hU⟩ = Ideal.span {a} :=
    ideal_eq_quotient_of_chart I U hU (Ideal.span {a}) e he
  let b : X.presheaf.stalk x := (X.presheaf.germ U x hxU).hom a
  have hstalk : IdealSheafData.stalk I x = Ideal.span {b} := by
    rw [IdealSheafData.stalk_eq_map_germ I x ⟨U, hU⟩ hxU, hgen, Ideal.map_span]
    simp [b]
  have hmax : b ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x) :=
    (stalk_le_maximalIdeal_iff_mem_support I x).2 hx (hstalk.ge (Ideal.subset_span rfl))
  have hreg : IsRegular b := by
    let q := hU.primeIdealOf ⟨x, hxU⟩
    let A := Γ(X, U)
    let R := X.presheaf.stalk x
    let : Algebra A R := X.presheaf.algebra_section_stalk ⟨x, hxU⟩
    have : IsLocalization.AtPrime R q.asIdeal := hU.isLocalization_stalk ⟨x, hxU⟩
    have hb' : algebraMap A R a ∈ nonZeroDivisors R :=
      IsLocalization.map_nonZeroDivisors_le q.asIdeal.primeCompl R
        ⟨a, isRegular_iff_mem_nonZeroDivisors.1 ha, rfl⟩
    exact isRegular_iff_mem_nonZeroDivisors.2 hb'
  exact ⟨b, hmax, hreg, hstalk⟩


private lemma ambient_regular_at_regular_cartier
    {X : Scheme.{u}} [IsLocallyNoetherian X] (I : X.IdealSheafData)
    (hI : IsEffectiveCartierDivisor I)
    (hreg : AlgebraicGeometry.IsRegular I.subscheme) (y : I.subscheme) :
    IsRegularLocalRing (X.presheaf.stalk (I.subschemeι y)) := by
  obtain ⟨b, _, hb, hgen⟩ :=
    exists_regular_generator_at_support I _ hI (I.range_subschemeι.subset ⟨y, rfl⟩)
  have hquot := regular_stalk_quotient_of_regular_subscheme I hreg y
  rw [hgen] at hquot
  exact isRegularLocalRing_of_nonZeroDivisor _ b
    (isRegular_iff_mem_nonZeroDivisors.mp hb) hquot

private lemma ambient_regular_of_component_intersections
    {X : Scheme.{u}} [IsLocallyNoetherian X] (D : X.IdealSheafData)
    (hCartier : ∀ C : irreducibleComponents D.subscheme,
      IsEffectiveCartierDivisor (componentIdeal D C))
    (hreg : ∀ C : irreducibleComponents D.subscheme,
      AlgebraicGeometry.IsRegular (componentIdeal D C).subscheme) (y : D.subscheme) :
    IsRegularLocalRing (X.presheaf.stalk (D.subschemeι y)) := by
  obtain ⟨C, hC⟩ := componentIdeal_support_covers D y
  obtain ⟨z, hz⟩ := (componentIdeal D C).range_subschemeι.symm.subset hC
  rw [← hz]
  exact ambient_regular_at_regular_cartier _ (hCartier C) (hreg C) z

private lemma finite_components_through_of_open_embedding
    {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y] [NoetherianSpace Y]
    {f : Y → X} (hf : Topology.IsOpenEmbedding f) {x : X} (hx : x ∈ Set.range f) :
    Finite {C : irreducibleComponents X // x ∈ (C : Set X)} := by
  let g : {C : irreducibleComponents X // x ∈ (C : Set X)} → irreducibleComponents Y :=
    fun C => ⟨f ⁻¹' (C.1 : Set X),
      preimage_mem_irreducibleComponents C.1.2 hf ⟨x, C.2, hx⟩⟩
  have hclosed (C : irreducibleComponents X) (hC : x ∈ (C : Set X)) :
      closure (f '' (f ⁻¹' (C : Set X))) = (C : Set X) := by
    rw [Set.image_preimage_eq_inter_range]
    exact le_antisymm
      (closure_minimal Set.inter_subset_left (isClosed_of_mem_irreducibleComponents _ C.2))
      (subset_closure_inter_of_isPreirreducible_of_isOpen C.2.1.2 hf.isOpen_range ⟨x, hC, hx⟩)
  have hg : Function.Injective g := by
    intro C E h
    have hpre : f ⁻¹' (C.1 : Set X) = f ⁻¹' (E.1 : Set X) := congrArg Subtype.val h
    rw [Subtype.ext_iff, Subtype.ext_iff, ← hclosed C.1 C.2, ← hclosed E.1 E.2, hpre]
  have : Finite (irreducibleComponents Y) :=
    (NoetherianSpace.finite_irreducibleComponents (α := Y)).to_subtype
  exact Finite.of_injective g hg

private lemma finite_components_through
    (X : Scheme) [IsLocallyNoetherian X] (x : X) :
    Finite {C : irreducibleComponents X // x ∈ (C : Set X)} := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, _⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  let V : X.Opens := U
  have : IsNoetherianRing Γ(X, V) := IsLocallyNoetherian.component_noetherian ⟨V, hU⟩
  have : NoetherianSpace V := noetherianSpace_of_isAffineOpen V hU
  exact finite_components_through_of_open_embedding V.ι.isOpenEmbedding ⟨⟨x, hxU⟩, rfl⟩

private lemma zeroLocus_idealStalk
    {X : Scheme.{u}} (I : X.IdealSheafData) (x : X) :
    PrimeSpectrum.zeroLocus (IdealSheafData.stalk I x : Set (X.presheaf.stalk x)) =
      X.fromSpecStalk x ⁻¹' (I.support : Set X) := by
  obtain ⟨_, ⟨U, hU, rfl⟩, hxU, _⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ x) isOpen_univ
  change IsAffineOpen U at hU
  rw [IdealSheafData.stalk_eq_map_germ I x ⟨U, hU⟩ hxU]
  ext p
  let q := PrimeSpectrum.comap (X.presheaf.germ U x hxU).hom p
  have hqU : hU.fromSpec q ∈ U := hU.range_fromSpec.subset ⟨q, rfl⟩
  change (I.ideal ⟨U, hU⟩).map (X.presheaf.germ U x hxU).hom ≤ p.asIdeal ↔
    X.fromSpecStalk x p ∈ I.support
  rw [← hU.fromSpecStalk_eq_fromSpecStalk hxU,
    IsAffineOpen.fromSpecStalk]
  change (I.ideal ⟨U, hU⟩).map (X.presheaf.germ U x hxU).hom ≤ p.asIdeal ↔
    hU.fromSpec q ∈ I.support
  rw [Scheme.IdealSheafData.mem_support_iff_of_mem (U := ⟨U, hU⟩) hqU]
  change _ ↔ q ∈ hU.fromSpec ⁻¹' X.zeroLocus (I.ideal ⟨U, hU⟩ : Set Γ(X, U))
  rw [hU.fromSpec_preimage_zeroLocus]
  exact Ideal.map_le_iff_le_comap

private lemma componentIdeal_support_subset
    {X : Scheme.{u}} (D : X.IdealSheafData) (C : irreducibleComponents D.subscheme) :
    (componentIdeal D C).support ≤ D.support := by
  rw [componentIdeal_support_eq_image]
  rintro _ ⟨y, _, rfl⟩
  exact D.range_subschemeι.subset ⟨y, rfl⟩

private lemma idealStalk_radical_of_isReduced
    {X : Scheme.{u}} (I : X.IdealSheafData) [IsReduced I.subscheme] (y : I.subscheme) :
    (IdealSheafData.stalk I (I.subschemeι y)).IsRadical := by
  rw [← kernel_stalkMap_subscheme]
  let e := (I.subschemeι.stalkMap y).hom.quotientKerEquivOfSurjective
    (I.subschemeι.stalkMap_surjective y)
  exact (Ideal.isRadical_iff_quotient_reduced _).mpr (isReduced_of_injective e e.injective)


private lemma zeroLocus_stalk_eq_iUnion_component_stalks
    {X : Scheme.{u}} (D : X.IdealSheafData) (x : X) :
    PrimeSpectrum.zeroLocus (IdealSheafData.stalk D x : Set (X.presheaf.stalk x)) =
      ⋃ C : {C : irreducibleComponents D.subscheme // x ∈ (componentIdeal D C).support},
        PrimeSpectrum.zeroLocus
          (IdealSheafData.stalk (componentIdeal D C.1) x :
            Set (X.presheaf.stalk x)) := by
  simp_rw [zeroLocus_idealStalk]
  ext p
  simp only [Set.mem_preimage]
  refine ⟨fun hp => ?_, fun hp => (Set.mem_iUnion.mp hp).elim fun C hp =>
    componentIdeal_support_subset D C.1 hp⟩
  obtain ⟨y, hy⟩ := D.range_subschemeι.symm.subset hp
  obtain ⟨C, hC⟩ := componentIdeal_support_covers D y
  rw [hy] at hC
  have hpx : X.fromSpecStalk x p ⤳ x := X.range_fromSpecStalk.subset ⟨p, rfl⟩
  have hxC : x ∈ (componentIdeal D C).support :=
    (closure_minimal (Set.singleton_subset_iff.mpr hC)
      (componentIdeal D C).support.isClosed) hpx.mem_closure
  exact Set.mem_iUnion.mpr ⟨⟨C, hxC⟩, hC⟩

private lemma idealStalk_eq_iInf_component_stalks
    {X : Scheme.{u}} (D : X.IdealSheafData) [IsReduced D.subscheme] (y : D.subscheme) :
    IdealSheafData.stalk D (D.subschemeι y) =
      ⨅ C : {C : irreducibleComponents D.subscheme //
          D.subschemeι y ∈ (componentIdeal D C).support},
        IdealSheafData.stalk (componentIdeal D C.1) (D.subschemeι y) := by
  have h := congrArg PrimeSpectrum.vanishingIdeal
    (zeroLocus_stalk_eq_iUnion_component_stalks D (D.subschemeι y))
  rw [PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical,
    (idealStalk_radical_of_isReduced D y).radical,
    PrimeSpectrum.vanishingIdeal_iUnion] at h
  convert h using 1
  congr 1
  funext C
  rw [PrimeSpectrum.vanishingIdeal_zeroLocus_eq_radical,
    (componentIdeal_stalk_isPrime_at_support D C.1 C.2).isRadical.radical]

private lemma finite_component_stalks_through
    {X : Scheme.{u}} [IsLocallyNoetherian X] (D : X.IdealSheafData) (y : D.subscheme) :
    Finite {C : irreducibleComponents D.subscheme //
      D.subschemeι y ∈ (componentIdeal D C).support} := by
  have : IsLocallyNoetherian D.subscheme :=
    LocallyOfFiniteType.isLocallyNoetherian D.subschemeι
  have := finite_components_through D.subscheme y
  let g : {C : irreducibleComponents D.subscheme //
      D.subschemeι y ∈ (componentIdeal D C).support} →
      {C : irreducibleComponents D.subscheme // y ∈ (C : Set D.subscheme)} :=
    fun C => ⟨C.1, by
      have hC := C.2
      rw [componentIdeal_support_eq_image] at hC
      obtain ⟨z, hz, he⟩ := hC
      exact D.subschemeι.isClosedEmbedding.injective he ▸ hz⟩
  exact Finite.of_injective g fun C E h => Subtype.ext (congrArg Subtype.val h :)


private lemma componentIdeal_stalk_le_iff
    {X : Scheme.{u}} (D : X.IdealSheafData) (C E : irreducibleComponents D.subscheme)
    {x : X} (hxC : x ∈ (componentIdeal D C).support) :
    IdealSheafData.stalk (componentIdeal D E) x ≤
        IdealSheafData.stalk (componentIdeal D C) x ↔ E = C := by
  refine ⟨fun hle => ?_, fun h => h ▸ le_rfl⟩
  let η := D.subschemeι C.2.1.genericPoint
  have hclosure : closure ({η} : Set X) = (componentIdeal D C).support := by
    rw [componentIdeal_support_eq_image]
    exact componentSupport_genericPoint_closure D C
  have hηx : η ⤳ x := specializes_iff_mem_closure.mpr (hclosure.symm ▸ hxC)
  obtain ⟨p, hp⟩ := X.range_fromSpecStalk.symm.subset hηx
  have hpC : p ∈ PrimeSpectrum.zeroLocus
      (IdealSheafData.stalk (componentIdeal D C) x :
        Set (X.presheaf.stalk x)) := by
    rw [zeroLocus_idealStalk]
    change X.fromSpecStalk x p ∈ ((componentIdeal D C).support : Set X)
    rw [hp, ← hclosure]
    exact subset_closure (Set.mem_singleton η)
  have hpE : p ∈ PrimeSpectrum.zeroLocus
      (IdealSheafData.stalk (componentIdeal D E) x :
        Set (X.presheaf.stalk x)) := hle.trans hpC
  rw [zeroLocus_idealStalk] at hpE
  change X.fromSpecStalk x p ∈ (componentIdeal D E).support at hpE
  rw [hp] at hpE
  have hCE : (componentIdeal D C).support ≤ (componentIdeal D E).support := by
    change ((componentIdeal D C).support : Set X) ⊆ ((componentIdeal D E).support : Set X)
    rw [← hclosure]
    exact closure_minimal (Set.singleton_subset_iff.mpr hpE)
      (componentIdeal D E).support.isClosed
  have hsub : (C : Set D.subscheme) ⊆ (E : Set D.subscheme) := by
    rw [componentIdeal_support_eq_image, componentIdeal_support_eq_image] at hCE
    intro z hz
    obtain ⟨w, hw, he⟩ := hCE ⟨z, hz, rfl⟩
    exact D.subschemeι.isClosedEmbedding.injective he ▸ hw
  exact Subtype.ext (Set.Subset.antisymm (C.2.2 E.2.1 hsub) hsub)

private lemma inf_span_eq_mul_of_prime
    {R : Type*} [CommRing R] {I : Ideal R} (hI : I.IsPrime)
    {a : R} (ha : a ∉ I) : I ⊓ Ideal.span {a} = I * Ideal.span {a} := by
  apply le_antisymm _ Ideal.mul_le_inf
  intro b hb
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton.mp hb.2
  have hc : c ∈ I := (hI.mem_or_mem hb.1).resolve_left ha
  simpa only [mul_comm] using Ideal.mul_mem_mul hc (Ideal.subset_span (Set.mem_singleton a))

private lemma prod_eq_inf_of_prime_principal
    {R ι : Type*} [CommRing R] (s : Finset ι) (I : ι → Ideal R)
    (hprime : ∀ i ∈ s, (I i).IsPrime)
    (hprincipal : ∀ i ∈ s, (I i).IsPrincipal)
    (hincomp : ∀ i ∈ s, ∀ j ∈ s, I i ≤ I j → i = j) :
    s.prod I = s.inf I := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert i s hi ih =>
    have hprime' := fun j hj => hprime j (Finset.mem_insert_of_mem hj)
    have hprincipal' := fun j hj => hprincipal j (Finset.mem_insert_of_mem hj)
    have hincomp' := fun j hj k hk => hincomp j (Finset.mem_insert_of_mem hj)
      k (Finset.mem_insert_of_mem hk)
    rw [Finset.prod_insert hi, Finset.inf_insert, ← ih hprime' hprincipal' hincomp']
    have hnot : ¬ s.prod I ≤ I i := by
      rw [(hprime i (Finset.mem_insert_self i s)).prod_le]
      rintro ⟨j, hj, hji⟩
      exact hi ((hincomp j (Finset.mem_insert_of_mem hj) i
        (Finset.mem_insert_self i s) hji) ▸ hj)
    have hprod : (s.prod I).IsPrincipal := by
      refine Finset.prod_induction _ (fun J : Ideal R => J.IsPrincipal) (fun J K hJ hK => ?_)
        ⟨⟨1, by simp⟩⟩ hprincipal'
      obtain ⟨a, rfl⟩ := hJ.principal
      obtain ⟨b, rfl⟩ := hK.principal
      rw [Ideal.span_singleton_mul_span_singleton]
      exact ⟨⟨a * b, rfl⟩⟩
    obtain ⟨a, ha⟩ := hprod.principal
    rw [ha] at hnot ⊢
    exact (inf_span_eq_mul_of_prime (hprime i (Finset.mem_insert_self i s))
      (fun h => hnot ((Ideal.span_singleton_le_iff_mem _).mpr h))).symm

private lemma idealStalk_eq_prod_component_stalks
    {X : Scheme.{u}} [IsLocallyNoetherian X] (D : X.IdealSheafData) [IsReduced D.subscheme]
    (hCartier : ∀ C : irreducibleComponents D.subscheme,
      IsEffectiveCartierDivisor (componentIdeal D C))
    (y : D.subscheme) :
    let S := {C : irreducibleComponents D.subscheme //
      D.subschemeι y ∈ (componentIdeal D C).support}
    let _ : Finite S := finite_component_stalks_through D y
    let _ : Fintype S := Fintype.ofFinite S
    IdealSheafData.stalk D (D.subschemeι y) =
      ∏ C : S, IdealSheafData.stalk (componentIdeal D C.1) (D.subschemeι y) := by
  classical
  let S := {C : irreducibleComponents D.subscheme //
    D.subschemeι y ∈ (componentIdeal D C).support}
  have : Finite S := finite_component_stalks_through D y
  let : Fintype S := Fintype.ofFinite S
  let F : S → Ideal (X.presheaf.stalk (D.subschemeι y)) :=
    fun C => IdealSheafData.stalk (componentIdeal D C.1) (D.subschemeι y)
  change IdealSheafData.stalk D (D.subschemeι y) = ∏ C : S, F C
  rw [idealStalk_eq_iInf_component_stalks]
  have hprime : ∀ C ∈ (Finset.univ : Finset S), (F C).IsPrime :=
    fun C _ => componentIdeal_stalk_isPrime_at_support D C.1 C.2
  have hprincipal : ∀ C ∈ (Finset.univ : Finset S), (F C).IsPrincipal := by
    intro C _
    obtain ⟨b, _, _, hb⟩ := exists_regular_generator_at_support
      (componentIdeal D C.1) _ (hCartier C.1) C.2
    exact ⟨⟨b, hb⟩⟩
  have hincomp : ∀ C ∈ (Finset.univ : Finset S), ∀ E ∈ (Finset.univ : Finset S),
      F C ≤ F E → C = E :=
    fun C _ E _ hle => Subtype.ext ((componentIdeal_stalk_le_iff D E.1 C.1 E.2).mp hle)
  simpa only [Finset.inf_univ_eq_iInf] using
    (prod_eq_inf_of_prime_principal Finset.univ F hprime hprincipal hincomp).symm


private lemma exists_eq_factor_of_prime_products
    {R ι κ : Type*} [CommRing R] (s : Finset ι) (t : Finset κ)
    (I : ι → Ideal R) (J : κ → Ideal R)
    (hI : ∀ i ∈ s, (I i).IsPrime) (hJ : ∀ j ∈ t, (J j).IsPrime)
    (hanti : ∀ i ∈ s, ∀ k ∈ s, I k ≤ I i → k = i)
    (hprod : s.prod I = t.prod J) {i : ι} (hi : i ∈ s) :
    ∃ j ∈ t, I i = J j := by
  have hle : t.prod J ≤ I i := by
    rw [← hprod]
    exact Ideal.prod_le_inf.trans (Finset.inf_le hi)
  obtain ⟨j, hj, hji⟩ := (hI i hi).prod_le.mp hle
  have hle' : s.prod I ≤ J j := by
    rw [hprod]
    exact Ideal.prod_le_inf.trans (Finset.inf_le hj)
  obtain ⟨k, hk, hkj⟩ := (hJ j hj).prod_le.mp hle'
  have hki := hanti i hi k hk (hkj.trans hji)
  exact ⟨j, hj, (hki ▸ hkj).antisymm hji⟩

private lemma prod_span_singleton_list {R : Type*} [CommRing R] (l : List R) :
    (l.map (fun a => Ideal.span {a})).prod = Ideal.span {l.prod} := by
  simpa using Ideal.multiset_prod_span_singleton (l : Multiset R)

private lemma component_stalk_eq_parameter_ideal
    {X : Scheme.{u}} [IsLocallyNoetherian X] (D : X.IdealSheafData) [IsReduced D.subscheme]
    (hCartier : ∀ C : irreducibleComponents D.subscheme,
      IsEffectiveCartierDivisor (componentIdeal D C))
    (y : D.subscheme) [IsRegularLocalRing (X.presheaf.stalk (D.subschemeι y))]
    (rs : List (X.presheaf.stalk (D.subschemeι y)))
    (hgen : Ideal.ofList rs = IsLocalRing.maximalIdeal (X.presheaf.stalk (D.subschemeι y)))
    (hlen : rs.length = (IsLocalRing.maximalIdeal (X.presheaf.stalk (D.subschemeι y))).spanFinrank)
    (r : ℕ) (hprod : IdealSheafData.stalk D (D.subschemeι y) =
      Ideal.span {(rs.take r).prod})
    (C : irreducibleComponents D.subscheme)
    (hC : D.subschemeι y ∈ (componentIdeal D C).support) :
    ∃ a ∈ rs.take r, IdealSheafData.stalk (componentIdeal D C) (D.subschemeι y) =
      Ideal.span {a} := by
  classical
  let S := {C : irreducibleComponents D.subscheme //
    D.subschemeι y ∈ (componentIdeal D C).support}
  have : Finite S := finite_component_stalks_through D y
  let : Fintype S := Fintype.ofFinite S
  let F : S → Ideal (X.presheaf.stalk (D.subschemeι y)) :=
    fun C => IdealSheafData.stalk (componentIdeal D C.1) (D.subschemeι y)
  let G : Fin (rs.take r).length → Ideal (X.presheaf.stalk (D.subschemeι y)) :=
    fun j => Ideal.span {(rs.take r).get j}
  have hFG : (Finset.univ.prod F) = Finset.univ.prod G := by
    rw [← idealStalk_eq_prod_component_stalks D hCartier y, hprod]
    symm
    change (∏ j, Ideal.span {(rs.take r).get j}) = _
    rw [← List.prod_ofFn]
    have heq : (List.ofFn fun j => Ideal.span {(rs.take r).get j}) =
        (rs.take r).map (fun a => Ideal.span {a}) :=
      List.ofFn_getElem_eq_map (rs.take r) (fun a => Ideal.span {a})
    rw [heq]
    exact prod_span_singleton_list _
  obtain ⟨j, _, hj⟩ := exists_eq_factor_of_prime_products Finset.univ Finset.univ F G
    (fun C _ => componentIdeal_stalk_isPrime_at_support D C.1 C.2)
    (fun j _ => regularSystemOfParameters_prime hgen hlen
      (List.mem_of_mem_take (List.get_mem _ _)))
    (fun C _ E _ hle => Subtype.ext ((componentIdeal_stalk_le_iff D C.1 E.1 C.2).mp hle))
    hFG (i := ⟨C, hC⟩) (Finset.mem_univ _)
  exact ⟨(rs.take r).get j, List.get_mem _ _, hj⟩

private lemma componentIntersection_mem_component {X : Scheme.{u}}
    (D : X.IdealSheafData) (J : Finset (irreducibleComponents D.subscheme))
    {x : X} (hx : x ∈ ((componentIntersection D J).support : Set X))
    {C : irreducibleComponents D.subscheme} (hC : C ∈ J) :
    x ∈ (componentIdeal D C).support := by
  rw [componentIntersection_support_eq_iInter] at hx
  exact (iInf₂_le C hC : (⨅ E ∈ J, (componentIdeal D E).support) ≤ _) hx

/-- A list of elements generating exactly the stalks of the components in `J` generates the stalk
of their intersection. -/
private lemma ofList_eq_stalk_componentIntersection {X : Scheme.{u}}
    (D : X.IdealSheafData) (J : Finset (irreducibleComponents D.subscheme)) (x : X)
    (xs : List (X.presheaf.stalk x))
    (h₁ : ∀ C ∈ J, ∃ b ∈ xs, IdealSheafData.stalk (componentIdeal D C) x = Ideal.span {b})
    (h₂ : ∀ b ∈ xs, ∃ C ∈ J, IdealSheafData.stalk (componentIdeal D C) x = Ideal.span {b}) :
    Ideal.ofList xs = IdealSheafData.stalk (componentIntersection D J) x := by
  rw [componentIntersection_stalk_eq_iSup]
  apply le_antisymm
  · refine Ideal.span_le.mpr fun b hb => ?_
    obtain ⟨C, hC, he⟩ := h₂ b hb
    exact (he.ge.trans (le_iSup₂ (f := fun C (_ : C ∈ J) =>
      IdealSheafData.stalk (componentIdeal D C) x) C hC)) (Ideal.subset_span rfl)
  · refine iSup₂_le fun C hC => ?_
    obtain ⟨b, hb, he⟩ := h₁ C hC
    rw [he, Ideal.span_le]
    rintro _ rfl
    exact Ideal.subset_span hb

/-- At a point of an intersection of components of a strict normal crossings divisor, the local
ring is regular and the stalk of the intersection is generated by a nodup part of a regular
system of parameters, with one entry per component. -/
private lemma exists_parameters_of_mem_componentIntersection
    {X : Scheme.{u}} [IsLocallyNoetherian X] (D : X.IdealSheafData)
    (h : IsStrictNormalCrossingsDivisor D)
    (J : Finset (irreducibleComponents D.subscheme)) (hJ : J.Nonempty)
    (x : X) (hxs : x ∈ ((componentIntersection D J).support : Set X)) :
    IsRegularLocalRing (X.presheaf.stalk x) ∧
      ∃ rs xs : List (X.presheaf.stalk x),
        Ideal.ofList rs = IsLocalRing.maximalIdeal (X.presheaf.stalk x) ∧
        rs.length = (IsLocalRing.maximalIdeal (X.presheaf.stalk x)).spanFinrank ∧
        xs.Nodup ∧ xs ⊆ rs ∧ xs.length = J.card ∧
        Ideal.ofList xs = IdealSheafData.stalk (componentIntersection D J) x := by
  classical
  have hx := fun C (hC : C ∈ J) => componentIntersection_mem_component D J hxs hC
  obtain ⟨C₀, hC₀⟩ := hJ
  have hxD : x ∈ (D.support : Set X) := componentIdeal_support_subset D C₀ (hx C₀ hC₀)
  rw [← D.range_subschemeι] at hxD
  obtain ⟨z, rfl⟩ := hxD
  have : IsReduced D.subscheme := isReduced_of_strictNormalCrossings D h
  have hCartier := fun C => componentIdeal_effectiveCartier_of_strictNormalCrossings D h.1 h C
  obtain ⟨hR, rs, r, hp, hg, hr, hr', hk⟩ := h.2 z
  have heq (C : {C // C ∈ J}) : ∃ a ∈ rs,
      IdealSheafData.stalk (componentIdeal D C.1) (D.subschemeι z) =
        Ideal.span {a} := by
    rw [kernel_stalkMap_subscheme] at hk
    obtain ⟨a, ha, he⟩ := component_stalk_eq_parameter_ideal D hCartier z rs hg
      (regularSystemOfParameters_length hp) r hk C.1 (hx C.1 C.2)
    exact ⟨a, List.mem_of_mem_take ha, he⟩
  choose a ha he using heq
  have hinj : Function.Injective a := fun C E haeq => Subtype.ext <|
    (componentIdeal_stalk_le_iff D E.1 C.1 (hx E.1 E.2)).mp (by rw [he C, he E, haeq])
  refine ⟨hR, rs, J.attach.toList.map a, hg, regularSystemOfParameters_length hp,
    List.Nodup.map hinj J.attach.nodup_toList, ?_, by simp,
    ofList_eq_stalk_componentIntersection D J _ _ ?_ ?_⟩
  · intro b hb
    obtain ⟨C, _, rfl⟩ := List.mem_map.mp hb
    exact ha C
  · intro C hC
    exact ⟨a ⟨C, hC⟩, List.mem_map_of_mem (by simp), he ⟨C, hC⟩⟩
  · intro b hb
    obtain ⟨C, _, rfl⟩ := List.mem_map.mp hb
    exact ⟨C.1, C.2, he C⟩

private lemma componentIntersection_local_equations
    {X : Scheme.{u}} [IsLocallyNoetherian X] (D : X.IdealSheafData)
    (h : IsStrictNormalCrossingsDivisor D)
    (J : Finset (irreducibleComponents D.subscheme)) (hJ : J.Nonempty)
    (y : (componentIntersection D J).subscheme) :
    IsRegularLocalRing (X.presheaf.stalk ((componentIntersection D J).subschemeι y) ⧸
      IdealSheafData.stalk (componentIntersection D J)
        ((componentIntersection D J).subschemeι y)) ∧
    ringKrullDim (X.presheaf.stalk ((componentIntersection D J).subschemeι y) ⧸
      IdealSheafData.stalk (componentIntersection D J)
        ((componentIntersection D J).subschemeι y)) + J.card =
      ringKrullDim (X.presheaf.stalk ((componentIntersection D J).subschemeι y)) := by
  obtain ⟨hR, rs, xs, hg, hlen, hnodup, hsub, hlength, hideal⟩ :=
    exists_parameters_of_mem_componentIntersection D h J hJ _
      ((componentIntersection D J).range_subschemeι.subset ⟨y, rfl⟩)
  have hlocal := regular_quotient_of_subset_parameters hg hlen hnodup hsub
  rwa [hideal, hlength] at hlocal

private lemma regular_subscheme_of_stalk_quotient_regular
    {X : Scheme.{u}} [IsLocallyNoetherian X] (I : X.IdealSheafData)
    (h : ∀ y : I.subscheme, IsRegularLocalRing (X.presheaf.stalk (I.subschemeι y) ⧸
      IdealSheafData.stalk I (I.subschemeι y))) :
    AlgebraicGeometry.IsRegular I.subscheme := by
  apply ((AlgebraicGeometry.isRegular_tfae I.subscheme).out 1 2).mpr
  refine ⟨LocallyOfFiniteType.isLocallyNoetherian I.subschemeι, fun y => ?_⟩
  have hq := h y
  rw [← kernel_stalkMap_subscheme] at hq
  let e := (I.subschemeι.stalkMap y).hom.quotientKerEquivOfSurjective
    (I.subschemeι.stalkMap_surjective y)
  exact IsRegularLocalRing.of_ringEquiv e

private lemma isReduced_of_regular_subscheme
    {X : Scheme.{u}} (I : X.IdealSheafData) (h : AlgebraicGeometry.IsRegular I.subscheme) :
    IsReduced I.subscheme := by
  have hs (y : I.subscheme) : IsReduced (I.subscheme.presheaf.stalk y) := by
    have := regular_stalk_of_regular_subscheme I h y
    have := IsRegularLocalRing.isDomain (I.subscheme.presheaf.stalk y)
    infer_instance
  exact isReduced_of_isReduced_stalk I.subscheme

private lemma componentIntersection_regular_codimension
    {X : Scheme.{u}} [IsLocallyNoetherian X] (D : X.IdealSheafData)
    (h : IsStrictNormalCrossingsDivisor D)
    (J : Finset (irreducibleComponents D.subscheme)) (hJ : J.Nonempty) :
    AlgebraicGeometry.IsRegular (componentIntersection D J).subscheme ∧
      ∀ C : irreducibleComponents (componentIntersection D J).subscheme,
        codimension (IrreducibleCloseds.closureSingleton
          ((componentIntersection D J).subschemeι C.2.1.genericPoint)) = (J.card : ℕ∞) := by
  let I := componentIntersection D J
  have hreg : AlgebraicGeometry.IsRegular I.subscheme :=
    regular_subscheme_of_stalk_quotient_regular I
      (fun y => (componentIntersection_local_equations D h J hJ y).1)
  refine ⟨hreg, fun C => ?_⟩
  have : IsReduced I.subscheme := isReduced_of_regular_subscheme I hreg
  let y := C.2.1.genericPoint
  have hy : closure ({y} : Set I.subscheme) = C :=
    (C.2.1.isGenericPoint_genericPoint (isClosed_of_mem_irreducibleComponents _ C.2)).def
  have hfield : IsField (I.subscheme.presheaf.stalk y) :=
    isField_stalk_of_closure_mem_irreducibleComponents I.subscheme y (hy ▸ C.2)
  have hzero : ringKrullDim (I.subscheme.presheaf.stalk y) = 0 :=
    ringKrullDim_eq_zero_of_isField hfield
  have hdim := (componentIntersection_local_equations D h J hJ y).2
  rw [← kernel_stalkMap_subscheme] at hdim
  rw [ringKrullDim_eq_of_ringEquiv ((I.subschemeι.stalkMap y).hom.quotientKerEquivOfSurjective
    (I.subschemeι.stalkMap_surjective y)), hzero, zero_add] at hdim
  rw [codimension_closureSingleton_eq_coheight]
  have hco := AlgebraicGeometry.ringKrullDim_stalk_eq_coheight (I.subschemeι y)
  exact_mod_cast hco.symm.trans hdim.symm

private lemma coheight_fromSpecStalk {X : Scheme.{u}} (x : X)
    (p : Spec (X.presheaf.stalk x)) :
    Order.coheight (X.fromSpecStalk x p) = p.asIdeal.height := by
  let f := X.fromSpecStalk x
  have hiff {p q : Spec (X.presheaf.stalk x)} : f p ≤ f q ↔ p ≤ q := by
    rw [Scheme.le_iff_specializes, Scheme.le_iff_specializes]
    exact f.isEmbedding.isInducing.specializes_iff
  have hmono : StrictMono f := fun p q hpq =>
    lt_iff_le_not_ge.mpr ⟨hiff.mpr hpq.le, fun hqp => hpq.not_ge (hiff.mp hqp)⟩
  have hco := Order.coheight_eq_of_strictMono f hmono (fun p y hpy => by
    have hpx : f p ⤳ x := X.range_fromSpecStalk.subset ⟨p, rfl⟩
    obtain ⟨q, rfl⟩ := X.range_fromSpecStalk.symm.subset
      ((Scheme.le_iff_specializes.mp hpy.le).trans hpx : y ⤳ x)
    exact ⟨q, lt_iff_le_not_ge.mpr ⟨hiff.mp hpy.le,
      fun hqp => hpy.not_ge (hiff.mpr hqp)⟩, rfl⟩) p
  rw [← hco, ← Order.coheight_orderIso (specOrderIsoPrimeSpectrum (X.presheaf.stalk x))]
  exact (PrimeSpectrum.height_eq_orderHeight p).symm

private lemma exists_component_genericPoint_of_prime_stalk
    {X : Scheme.{u}} (I : X.IdealSheafData) (x : X)
    (hp : (IdealSheafData.stalk I x).IsPrime) :
    ∃ C : irreducibleComponents I.subscheme,
      I.subschemeι C.2.1.genericPoint =
        X.fromSpecStalk x ⟨IdealSheafData.stalk I x, hp⟩ := by
  let p : PrimeSpectrum (X.presheaf.stalk x) := ⟨_, hp⟩
  have hxI : X.fromSpecStalk x p ∈ (I.support : Set X) := by
    change p ∈ X.fromSpecStalk x ⁻¹' (I.support : Set X)
    rw [← zeroLocus_idealStalk]
    exact (le_rfl : IdealSheafData.stalk I x ≤ p.asIdeal)
  obtain ⟨t, ht⟩ := I.range_subschemeι.symm.subset hxI
  let C : irreducibleComponents I.subscheme :=
    ⟨irreducibleComponent t, irreducibleComponent_mem_irreducibleComponents t⟩
  have hηt : C.2.1.genericPoint ⤳ t :=
    (C.2.1.isGenericPoint_genericPoint (isClosed_of_mem_irreducibleComponents _ C.2)).specializes
      mem_irreducibleComponent
  have hpx : X.fromSpecStalk x p ⤳ x := X.range_fromSpecStalk.subset ⟨p, rfl⟩
  obtain ⟨q, hq⟩ :=
    X.range_fromSpecStalk.symm.subset ((hηt.map I.subschemeι.continuous).trans (ht ▸ hpx))
  have hqI : q ∈ PrimeSpectrum.zeroLocus
      (IdealSheafData.stalk I x : Set (X.presheaf.stalk x)) := by
    rw [zeroLocus_idealStalk]
    change X.fromSpecStalk x q ∈ (I.support : Set X)
    rw [hq]
    exact I.range_subschemeι.subset ⟨_, rfl⟩
  have hqp : q ⤳ p := by
    apply (X.fromSpecStalk x).isEmbedding.isInducing.specializes_iff.mp
    rw [hq, ← ht]
    exact hηt.map I.subschemeι.continuous
  have heq : q = p := (PrimeSpectrum.le_iff_specializes q p).mpr hqp |>.antisymm hqI
  exact ⟨C, hq.symm.trans (congrArg (X.fromSpecStalk x) heq)⟩

private lemma height_idealStalk_of_regular_subscheme
    {X : Scheme.{u}} (I : X.IdealSheafData) (hI : AlgebraicGeometry.IsRegular I.subscheme)
    (n : ℕ) (hcodim : ∀ C : irreducibleComponents I.subscheme,
      codimension (IrreducibleCloseds.closureSingleton
        (I.subschemeι C.2.1.genericPoint)) = n)
    (y : I.subscheme) :
    (IdealSheafData.stalk I (I.subschemeι y)).height = n := by
  have := regular_stalk_quotient_of_regular_subscheme I hI y
  have hp : (IdealSheafData.stalk I (I.subschemeι y)).IsPrime :=
    (Ideal.Quotient.isDomain_iff_prime _).mp (IsRegularLocalRing.isDomain _)
  obtain ⟨C, hC⟩ := exists_component_genericPoint_of_prime_stalk I (I.subschemeι y) hp
  let p : Spec (X.presheaf.stalk (I.subschemeι y)) := ⟨_, hp⟩
  have hC' : I.subschemeι C.2.1.genericPoint = X.fromSpecStalk (I.subschemeι y) p := hC
  calc
    (IdealSheafData.stalk I (I.subschemeι y)).height = p.asIdeal.height := rfl
    _ = Order.coheight (X.fromSpecStalk (I.subschemeι y) p) :=
      (coheight_fromSpecStalk _ p).symm
    _ = n := by
      rw [← hC', ← codimension_closureSingleton_eq_coheight]
      exact hcodim C

private lemma exists_parameters_extending_generators
    {R : Type*} [CommRing R] [IsRegularLocalRing R] (xs : List R)
    (hq : IsRegularLocalRing (R ⧸ Ideal.ofList xs))
    (hh : (Ideal.ofList xs).height = xs.length) :
    ∃ rs : List R, Ideal.ofList rs = IsLocalRing.maximalIdeal R ∧
      rs.length = (IsLocalRing.maximalIdeal R).spanFinrank ∧
      xs.length ≤ rs.length ∧ rs.take xs.length = xs := by
  let I := Ideal.ofList xs
  have : IsDomain (R ⧸ I) := IsRegularLocalRing.isDomain _
  have : I.IsPrime := (Ideal.Quotient.isDomain_iff_prime _).mp this
  obtain ⟨ts, hgen, hlen, c, hc, hI, hdim⟩ :=
    IsRegularLocalRing.exists_ofList_eq_maximalIdeal_length_eq_spanFinrank_and_ofList_take_eq I hq
  have hCM := Module.IsMaximalCohenMacaulay.ringKrullDim_eq_height_add_ringKrullDim_quotient
    (IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay R).2 I
  have he : ringKrullDim (R ⧸ I) + c = ringKrullDim (R ⧸ I) + xs.length := by
    rw [hdim, hCM, hh, add_comm]
    norm_cast
  have hqnum : ringKrullDim (R ⧸ I) =
      ((IsLocalRing.maximalIdeal (R ⧸ I)).spanFinrank : WithBot ℕ∞) :=
    IsRegularLocalRing.spanFinrank_maximalIdeal.symm
  rw [hqnum] at he
  have he' : (IsLocalRing.maximalIdeal (R ⧸ I)).spanFinrank + c =
      (IsLocalRing.maximalIdeal (R ⧸ I)).spanFinrank + xs.length := by exact_mod_cast he
  have hcx : c = xs.length := Nat.add_left_cancel he'
  subst c
  refine ⟨xs ++ ts.drop xs.length, ?_, ?_, by simp, List.take_left⟩
  · change Ideal.ofList (ts.take xs.length) = Ideal.ofList xs at hI
    rw [Ideal.ofList_append, ← hI, ← Ideal.ofList_append, List.take_append_drop, hgen]
  · simp only [List.length_append, List.length_drop]
    omega

private lemma strictNormalCrossings_parameters_of_intersections
    {X : Scheme.{u}} [IsLocallyNoetherian X] (D : X.IdealSheafData)
    [IsReduced D.subscheme]
    (hCartier : ∀ C : irreducibleComponents D.subscheme,
      IsEffectiveCartierDivisor (componentIdeal D C))
    (hInter : ∀ J : Finset (irreducibleComponents D.subscheme), J.Nonempty →
      AlgebraicGeometry.IsRegular (componentIntersection D J).subscheme ∧
        ∀ C : irreducibleComponents (componentIntersection D J).subscheme,
          codimension (IrreducibleCloseds.closureSingleton
            ((componentIntersection D J).subschemeι C.2.1.genericPoint)) = (J.card : ℕ∞))
    (y : D.subscheme) [IsRegularLocalRing (X.presheaf.stalk (D.subschemeι y))] :
    ∃ (rs : List (X.presheaf.stalk (D.subschemeι y))) (r : ℕ),
      IsLocalRing.IsSystemOfParameters rs ∧
      Ideal.ofList rs = IsLocalRing.maximalIdeal (X.presheaf.stalk (D.subschemeι y)) ∧
      1 ≤ r ∧ r ≤ rs.length ∧
      RingHom.ker (D.subschemeι.stalkMap y).hom = Ideal.span {(rs.take r).prod} := by
  classical
  let x := D.subschemeι y
  let S := {C : irreducibleComponents D.subscheme // x ∈ (componentIdeal D C).support}
  have : Finite S := finite_component_stalks_through D y
  let : Fintype S := Fintype.ofFinite S
  let e : S ↪ irreducibleComponents D.subscheme := ⟨Subtype.val, Subtype.val_injective⟩
  let J := Finset.univ.map e
  have hJ : J.Nonempty := by
    obtain ⟨C, hC⟩ := componentIdeal_support_covers D y
    exact ⟨C, Finset.mem_map.mpr ⟨⟨C, hC⟩, Finset.mem_univ _, rfl⟩⟩
  have hxJ : x ∈ (componentIntersection D J).support := by
    rw [componentIntersection_support_eq_iInter]
    change x ∈ (⨅ C ∈ J, (componentIdeal D C).support : Closeds X)
    simp only [Closeds.mem_iInf]
    intro C hC
    obtain ⟨C, _, rfl⟩ := Finset.mem_map.mp hC
    exact C.2
  obtain ⟨hreg, hcodim⟩ := hInter J hJ
  have hex (C : S) : ∃ a : X.presheaf.stalk x,
      IdealSheafData.stalk (componentIdeal D C.1) x = Ideal.span {a} := by
    obtain ⟨a, _, _, ha⟩ := exists_regular_generator_at_support
      (componentIdeal D C.1) x (hCartier C.1) C.2
    exact ⟨a, ha⟩
  choose a ha using hex
  let xs := (Finset.univ : Finset S).toList.map a
  have hlength : xs.length = J.card := by simp [xs, J]
  have hI : Ideal.ofList xs = IdealSheafData.stalk (componentIntersection D J) x := by
    refine ofList_eq_stalk_componentIntersection D J x xs (fun C hC => ?_) fun b hb => ?_
    · obtain ⟨C, _, rfl⟩ := Finset.mem_map.mp hC
      exact ⟨a C, List.mem_map.mpr ⟨C, by simp, rfl⟩, ha C⟩
    · obtain ⟨C, _, rfl⟩ := List.mem_map.mp hb
      exact ⟨C.1, Finset.mem_map.mpr ⟨C, Finset.mem_univ _, rfl⟩, ha C⟩
  have hquot : IsRegularLocalRing (X.presheaf.stalk x ⧸ Ideal.ofList xs) := by
    rw [hI]
    exact componentIntersection_stalk_quotient_regular D J hreg hxJ
  have hheight : (Ideal.ofList xs).height = xs.length := by
    rw [hI, hlength]
    obtain ⟨z, hz⟩ := (componentIntersection D J).range_subschemeι.symm.subset hxJ
    rw [← hz]
    exact height_idealStalk_of_regular_subscheme (componentIntersection D J) hreg J.card hcodim z
  obtain ⟨rs, hgen, hlen, hr, htake⟩ :=
    exists_parameters_extending_generators xs hquot hheight
  refine ⟨rs, xs.length, ?_, hgen, ?_, hr, ?_⟩
  · constructor
    · rw [hgen]
      exact (inferInstance : (IsLocalRing.maximalIdeal _).IsPrime).isRadical.radical
    · rw [← IsRegularLocalRing.spanFinrank_maximalIdeal, hlen]
  · exact hlength ▸ hJ.card_pos
  · rw [kernel_stalkMap_subscheme, htake, idealStalk_eq_prod_component_stalks D hCartier y]
    calc
      (∏ C : S, IdealSheafData.stalk (componentIdeal D C.1) x) =
          ∏ C : S, Ideal.span {a C} := Finset.prod_congr rfl (fun C _ => ha C)
      _ = (xs.map (fun b => Ideal.span {b})).prod := by
        simp [xs, List.map_map]
      _ = Ideal.span {xs.prod} := prod_span_singleton_list xs

/-- A locally Noetherian effective Cartier divisor has strict normal crossings
if and only if it is reduced and all finite nonempty intersections of its
irreducible components are regular of the expected codimension. -/
@[stacks 0BIA]
public theorem isStrictNormalCrossingsDivisor_iff {X : Scheme.{u}}
    [IsLocallyNoetherian X] (D : X.IdealSheafData)
    (hD : IsEffectiveCartierDivisor D) :
    IsStrictNormalCrossingsDivisor D ↔
      (IsReduced D.subscheme ∧
        (∀ C : irreducibleComponents D.subscheme,
          IsEffectiveCartierDivisor
            (componentIdeal D C)) ∧
        (∀ J : Finset (irreducibleComponents D.subscheme), J.Nonempty →
          AlgebraicGeometry.IsRegular (componentIntersection D J).subscheme ∧
            ∀ C : irreducibleComponents (componentIntersection D J).subscheme,
              codimension (IrreducibleCloseds.closureSingleton
                ((componentIntersection D J).subschemeι C.2.1.genericPoint)) =
                  (J.card : ℕ∞))) := by
  refine ⟨fun h => ⟨isReduced_of_strictNormalCrossings D h,
    componentIdeal_effectiveCartier_of_strictNormalCrossings D hD h,
    componentIntersection_regular_codimension D h⟩, fun h => ⟨hD, fun y => ?_⟩⟩
  have hregC (C : irreducibleComponents D.subscheme) :
      AlgebraicGeometry.IsRegular (componentIdeal D C).subscheme := by
    simpa [componentIntersection] using (h.2.2 {C} (Finset.singleton_nonempty C)).1
  have := ambient_regular_of_component_intersections D h.2.1 hregC y
  have := h.1
  exact ⟨inferInstance, strictNormalCrossings_parameters_of_intersections D h.2.1 h.2.2 y⟩

/-! ### Local equations of an intersection of components -/

/-- A nodup sublist of a regular system of parameters of a regular local ring is a weakly
regular sequence whose entries lie in the maximal ideal. -/
@[sga "2 IV 5.3" "partial"]
private lemma weaklyRegular_of_subset_parameters
    {R : Type*} [CommRing R] [IsRegularLocalRing R]
    {rs xs : List R} (hgen : Ideal.ofList rs = IsLocalRing.maximalIdeal R)
    (hlen : rs.length = (IsLocalRing.maximalIdeal R).spanFinrank)
    (hxs : xs.Nodup) (hsub : xs ⊆ rs) :
    RingTheory.Sequence.IsWeaklyRegular R xs ∧
      ∀ a ∈ xs, a ∈ IsLocalRing.maximalIdeal R := by
  obtain ⟨ys, hgen', hlen'⟩ := exists_append_parameters hgen hlen hxs hsub
  have hseq :=
    ((IsRegularLocalRing.isRegular_and_isRegularLocalRing_quotient_and_isMaximalCohenMacaulay
      R).1 (xs ++ ys) hgen' hlen').1
  refine ⟨((RingTheory.Sequence.isWeaklyRegular_append_iff R xs ys).mp
    hseq.toIsWeaklyRegular).1, fun a ha => ?_⟩
  rw [← hgen]
  exact Ideal.subset_span (hsub ha)

/-- **The stalk ideal of an intersection of components of a strict normal crossings divisor.**
At every point of a nonempty finite intersection of irreducible components of a strict normal
crossings divisor, the ambient local ring is regular and the stalk of the ideal sheaf of the
intersection is generated by a weakly regular sequence of length the number of components,
taken from a regular system of parameters. -/
public theorem exists_isWeaklyRegular_ofList_eq_stalk_componentIntersection
    {X : Scheme.{u}} [IsLocallyNoetherian X] (D : X.IdealSheafData)
    (h : IsStrictNormalCrossingsDivisor D)
    (J : Finset (irreducibleComponents D.subscheme)) (hJ : J.Nonempty)
    (x : X) (hxs : x ∈ ((componentIntersection D J).support : Set X)) :
    IsRegularLocalRing (X.presheaf.stalk x) ∧
      ∃ xs : List (X.presheaf.stalk x), xs.length = J.card ∧
        (∀ a ∈ xs, a ∈ IsLocalRing.maximalIdeal (X.presheaf.stalk x)) ∧
        RingTheory.Sequence.IsWeaklyRegular (X.presheaf.stalk x) xs ∧
        Ideal.ofList xs = IdealSheafData.stalk (componentIntersection D J) x := by
  obtain ⟨hR, rs, xs, hg, hlen, hnodup, hsub, hlength, hideal⟩ :=
    exists_parameters_of_mem_componentIntersection D h J hJ x hxs
  obtain ⟨hwr, hmem⟩ := weaklyRegular_of_subset_parameters hg hlen hnodup hsub
  exact ⟨hR, xs, hlength, hmem, hwr, hideal⟩

/-- The ideal generated by the product of the entries of a list is contained in the principal
ideal generated by any one of them. -/
public lemma span_singleton_prod_le {R : Type*} [CommRing R] {xs : List R} {a : R}
    (ha : a ∈ xs) : Ideal.span {xs.prod} ≤ Ideal.span {a} :=
  Ideal.span_singleton_le_span_singleton.mpr (List.dvd_prod ha)

/-- For a regular sequence in a Noetherian local ring, an ideal contained in every principal
ideal generated by an entry is contained in the ideal generated by the product of the
entries. -/
public lemma le_span_singleton_prod_of_forall_le
    {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R] :
    ∀ {xs : List R}, RingTheory.Sequence.IsRegular R xs → ∀ {I : Ideal R},
      (∀ a ∈ xs, I ≤ Ideal.span {a}) → I ≤ Ideal.span {xs.prod}
  | [], _, _, _ => by simp
  | x :: xs, h, I, hI => by
      rw [span_prod_cons_eq_inf h]
      exact le_inf
        (le_span_singleton_prod_of_forall_le (regularSequence_tail h)
          fun a ha => hI a (List.mem_cons_of_mem _ ha))
        (hI x List.mem_cons_self)

/-- For a regular sequence in a Noetherian local ring the ideal generated by the product of the
entries is the intersection of the principal ideals generated by the entries. -/
public lemma span_singleton_prod_eq_of_forall_le
    {R : Type*} [CommRing R] [IsLocalRing R] [IsNoetherianRing R] {xs : List R}
    (h : RingTheory.Sequence.IsRegular R xs) {I : Ideal R}
    (hle : ∀ a ∈ xs, I ≤ Ideal.span {a})
    (hge : ∀ J : Ideal R, (∀ a ∈ xs, J ≤ Ideal.span {a}) → J ≤ I) :
    I = Ideal.span {xs.prod} :=
  le_antisymm (le_span_singleton_prod_of_forall_le h hle)
    (hge _ fun _ ha => span_singleton_prod_le ha)

/-! ### The stalk computations, stated for consumers outside this file -/

/-- **The stalk of a supremum of quasi-coherent ideals is the supremum of the stalks.**  The
ideal sheaf of a supremum is the supremum of the ideal sheaves, and taking the stalk at a point
commutes with it. -/
public alias idealStalk_iSup_eq_iSup := idealStalk_iSup

/-- **The kernel of the stalk map of the closed immersion cut out by a quasi-coherent ideal is
the stalk of that ideal.**  Closed immersions are affine-locally the quotient by the ideal, so
the stalk map is affine-locally a localisation of a quotient map. -/
@[ega "I 4.1.7" "partial"]
public alias kernel_stalkMap_subscheme_eq_idealStalk := kernel_stalkMap_subscheme

end Stacks.Divisors
