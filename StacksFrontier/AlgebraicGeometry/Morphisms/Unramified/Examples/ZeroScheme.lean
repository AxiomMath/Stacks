module

public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.LinearAlgebra.Matrix.Rank
public import Mathlib.RingTheory.LocalRing.ResidueField.Ideal

/-!
# Polynomial systems with full-rank Jacobian at a prime

Fix a commutative ring `R`, a finite system `g₁, …, g_m` of polynomials in `n` variables over
`R`, and a prime `q` of `R[x₁, …, x_n]` containing all the `gᵢ`. The data is said to have
*full-rank Jacobian at `q`* if the matrix `(∂gᵢ/∂x_j)` has rank `n` over the residue field of
`q`. This file packages that data and builds the basic geometry attached to it: the closed
subscheme of affine `n`-space cut out by the equations, its structure morphism to `Spec R`, and
the point of it determined by `q`.

## Main definitions

* `AlgebraicGeometry.FullRankJacobianSystem` packages the equations, the prime, and the
  full-rank hypothesis.
* `AlgebraicGeometry.FullRankJacobianSystem.equationIdeal` is the ideal generated by the
  equations.
* `AlgebraicGeometry.FullRankJacobianSystem.zeroScheme` is the closed subscheme of affine
  `n`-space that they cut out.
* `AlgebraicGeometry.FullRankJacobianSystem.inclusion`,
  `AlgebraicGeometry.FullRankJacobianSystem.point` and
  `AlgebraicGeometry.FullRankJacobianSystem.over` give the canonical closed immersion into
  affine `n`-space, the point of the zero scheme corresponding to the prime, and the structure
  morphism to the base.

## Implementation notes

The variables and the equations are indexed by `Fin n` and `Fin m`. The rank condition is
imposed after applying the canonical map to the residue field of the prime. The point and the
two morphisms are determined by the standing data and involve no further choices.

## References

* [Stacks Project, Tag 024Y](https://stacks.math.columbia.edu/tag/024Y)
-/

@[expose] public section

universe u

namespace AlgebraicGeometry

noncomputable section

/-- A finite system of polynomial equations in `n` variables over `R`, together with a prime of
the polynomial ring containing them at which the Jacobian matrix of the system has rank `n`. -/
public structure FullRankJacobianSystem (R : Type u) [CommRing R] (n m : ℕ) where
  /-- The equations cutting out the affine subscheme. -/
  equations : Fin m → MvPolynomial (Fin n) R
  /-- A prime of the ambient polynomial ring. -/
  prime : Ideal (MvPolynomial (Fin n) R)
  /-- The selected ideal is prime. -/
  prime_isPrime : prime.IsPrime
  /-- All equations vanish at the selected prime. -/
  equations_mem_prime : ∀ i, equations i ∈ prime
  /-- The Jacobian has full column rank at the selected prime. -/
  jacobian_rank :
    letI : prime.IsPrime := prime_isPrime
    (Matrix.of fun (i : Fin m) (j : Fin n) =>
      algebraMap (MvPolynomial (Fin n) R) prime.ResidueField
        (MvPolynomial.pderiv j (equations i))).rank = n

namespace FullRankJacobianSystem

variable {R : Type u} [CommRing R] {n m : ℕ}

/-- The selected prime of a full-rank Jacobian system is prime, as an instance. -/
instance (S : FullRankJacobianSystem R n m) : S.prime.IsPrime := S.prime_isPrime

/-- The ideal generated by the defining equations. -/
public def equationIdeal (S : FullRankJacobianSystem R n m) :
    Ideal (MvPolynomial (Fin n) R) :=
  Ideal.span (Set.range S.equations)

/-- Every equation lies in the ideal it generates together with the others. -/
public theorem equations_mem_equationIdeal (S : FullRankJacobianSystem R n m) (i : Fin m) :
    S.equations i ∈ S.equationIdeal :=
  Ideal.subset_span ⟨i, rfl⟩

/-- The selected prime contains the ideal generated by the equations. -/
public theorem equationIdeal_le_prime (S : FullRankJacobianSystem R n m) :
    S.equationIdeal ≤ S.prime :=
  Ideal.span_le.mpr (Set.range_subset_iff.mpr S.equations_mem_prime)

/-- The closed subscheme of affine `n`-space cut out by the equations. -/
public abbrev zeroScheme (S : FullRankJacobianSystem R n m) : Scheme.{u} :=
  Spec (.of (MvPolynomial (Fin n) R ⧸ S.equationIdeal))

/-- The canonical closed immersion of the zero scheme into affine `n`-space over `Spec R`,
realized as the spectrum of the polynomial ring. -/
public def inclusion (S : FullRankJacobianSystem R n m) :
    S.zeroScheme ⟶ Spec (.of (MvPolynomial (Fin n) R)) :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk S.equationIdeal))

/-- The point of the zero scheme corresponding to the selected prime. -/
public def point (S : FullRankJacobianSystem R n m) : S.zeroScheme :=
  ⟨S.prime.map (Ideal.Quotient.mk S.equationIdeal),
    Ideal.isPrime_map_quotientMk_of_isPrime S.equationIdeal_le_prime⟩

/-- The prime ideal of `FullRankJacobianSystem.point` is the image of the selected prime in the
quotient by the equations. -/
@[simp]
public theorem point_asIdeal (S : FullRankJacobianSystem R n m) :
    S.point.asIdeal = S.prime.map (Ideal.Quotient.mk S.equationIdeal) :=
  rfl

/-- A polynomial outside the selected prime has image outside the prime of the corresponding
point of the zero scheme. -/
public theorem mk_notMem_point_asIdeal (S : FullRankJacobianSystem R n m)
    {g : MvPolynomial (Fin n) R} (hg : g ∉ S.prime) :
    Ideal.Quotient.mk S.equationIdeal g ∉ S.point.asIdeal := by
  rw [point_asIdeal]
  intro hmem
  obtain ⟨p, hp, heq⟩ :=
    (Ideal.mem_map_iff_of_surjective (Ideal.Quotient.mk S.equationIdeal)
      Ideal.Quotient.mk_surjective).mp hmem
  have hdiff : p - g ∈ S.prime := S.equationIdeal_le_prime (Ideal.Quotient.eq.mp heq)
  exact hg (by simpa [sub_sub_cancel] using sub_mem hp hdiff)

/-- The structure morphism of the zero scheme to the base. -/
public def over (S : FullRankJacobianSystem R n m) : S.zeroScheme ⟶ Spec (.of R) :=
  Spec.map (CommRingCat.ofHom (algebraMap R (MvPolynomial (Fin n) R ⧸ S.equationIdeal)))

end FullRankJacobianSystem

end

end AlgebraicGeometry
