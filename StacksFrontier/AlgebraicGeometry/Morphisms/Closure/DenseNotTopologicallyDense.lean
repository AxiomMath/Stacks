module

public import Mathlib.Algebra.MvPolynomial.Variables
public import Mathlib.AlgebraicGeometry.AffineScheme
public import Mathlib.AlgebraicGeometry.Morphisms.SchemeTheoreticallyDominant
public import Mathlib.AlgebraicGeometry.Restrict
public import Mathlib.AlgebraicGeometry.StructureSheaf
public import Mathlib.RingTheory.Localization.Away.Basic
public import Mathlib.RingTheory.MvPolynomial.Ideal
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Morphisms.Closure.SchemeTheoreticallyDense

/-!
# A scheme-theoretic closure that is not topologically dense

Let `k` be a field, let `A = k[x, z₁, z₂, …]/(xⁿ zₙ)` and let `I = (z₁, z₂, …) ⊆ A`. In the
affine scheme `X = Spec A` consider the open subscheme `U = X \ V(I)`. The ring map
`A → ∏ₙ A_{zₙ}` is injective, so the scheme-theoretic closure of `U` is all of `X`. On the
other hand the morphism `X → Spec k[x]` is surjective, while its restriction to `U` is not:
every point of `U` is sent to a prime containing `x`. Hence `U` is not dense in the
topological space underlying `X`, and so the scheme-theoretic closure of an open subscheme
being the whole scheme does not imply that the open is topologically dense.

## Main definitions

* `relationIdeal`, `coordinateRing` and `zIdeal` build the ring `A` and the ideal `I`.
* `openComplement` is the open subscheme `U`.
* `xProjection` is the morphism `Spec A → Spec k[x]`.

## Main results

* `injective_localizationProduct`: the map `A → ∏ₙ A_{zₙ}` is injective.
* `coe_openComplement`: the open `U` is the complement of `V(I)`.
* `schemeTheoreticImage_openInclusion`: the scheme-theoretic closure of `U` is `X`.
* `surjective_xProjection`, `xProjection_openComplement_avoids_xOpen` and
  `not_surjective_xProjection_openComplement`: the projection to `Spec k[x]` is surjective,
  but its restriction to `U` is not.
* `not_dense_openComplement`: the open `U` is not topologically dense in `X`.

## Implementation notes

The variable `x` is indexed by `Sum.inl ()` and `zₙ₊₁` by `Sum.inr n`, so the relations are
`x ^ (n + 1) * zₙ₊₁` for `n : ℕ`. The open `U` is presented as the union of the basic opens
`D(zₙ)`, and `coe_openComplement` identifies that union with the complement of `V(I)`.

Only the unconditional inequality `AlgebraicGeometry.Scheme.Hom.ideal_ker_le` is used to
compute the kernel ideal sheaf of the inclusion of `U`: that inclusion is not quasi-compact,
which is exactly what makes the example possible.

`MvPolynomial.support_X_pow_mul` is a general fact about the support of the product of a power
of a variable with a polynomial that Mathlib does not record; Mathlib only has the case of a
single variable, `MvPolynomial.support_X_mul`.

The property refuted here is weaker than
`AlgebraicGeometry.Scheme.Opens.IsSchemeTheoreticallyDense`: this example only asserts that
the scheme-theoretic image of the open immersion is everything, which is the scheme-theoretic
closure of `U` in `X` itself rather than in every open subscheme of `X`.

## References

* [Stacks Project, Tag 01RB](https://stacks.math.columbia.edu/tag/01RB)
* [Stacks Project, Tag 01RC](https://stacks.math.columbia.edu/tag/01RC)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory
open Finsupp

universe u

namespace MvPolynomial

/-- The support of `X i ^ r * p` is the support of `p` translated by `r` in the `i`-th
exponent. -/
private theorem support_X_pow_mul {σ R : Type*} [CommSemiring R] (i : σ) (r : ℕ)
    (p : MvPolynomial σ R) :
    (X i ^ r * p).support = p.support.map (addLeftEmbedding (Finsupp.single i r)) := by
  classical
  induction r with
  | zero => simp [Finset.map_eq_image, addLeftEmbedding]
  | succ r ih =>
      rw [pow_succ', mul_assoc, support_X_mul, ih, Finset.map_map]
      congr 1
      ext m
      simp [add_assoc, add_comm, Finsupp.single_add]

end MvPolynomial

namespace Stacks.Morphisms.DenseNotTopologicallyDense

variable (k : Type u) [Field k]

/-- The polynomial ring `k[x]`. -/
public abbrev xRing := MvPolynomial Unit k

/-- The ideal of `k[x, z₁, z₂, …]` generated by the elements `x ^ (n + 1) * zₙ₊₁`. -/
public def relationIdeal : Ideal (MvPolynomial (Unit ⊕ ℕ) k) :=
  Ideal.span (Set.range (fun n : ℕ =>
    MvPolynomial.X (Sum.inl ()) ^ (n + 1) * MvPolynomial.X (Sum.inr n)))

/-- The ring `A = k[x, z₁, z₂, …]/(xⁿ zₙ)`. -/
public abbrev coordinateRing := MvPolynomial (Unit ⊕ ℕ) k ⧸ relationIdeal k

/-- The residue class of `zₙ₊₁` in the coordinate ring `A`. -/
public def z (n : ℕ) : coordinateRing k :=
  Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X (Sum.inr n))

/-- The ideal `I = (z₁, z₂, …)` of `A`. -/
public def zIdeal : Ideal (coordinateRing k) := Ideal.span (Set.range (z k))

/-- The inclusion `k[x] → A`. -/
public def xInclusion : xRing k →+* coordinateRing k :=
  (Ideal.Quotient.mk (relationIdeal k)).comp
    (MvPolynomial.rename (R := k) (Sum.inl : Unit → Unit ⊕ ℕ))

/-- The affine scheme `X = Spec A`. -/
public abbrev exampleScheme : Scheme.{u} := Spec (.of (coordinateRing k))

/-- The open subscheme `U = X \ V(I)`, presented as the union of the basic opens `D(zₙ)`. -/
public def openComplement : (exampleScheme k).Opens :=
  ⨆ n : ℕ, PrimeSpectrum.basicOpen (z k n)

/-- The morphism `X = Spec A → Spec k[x]` induced by the inclusion `k[x] → A`. -/
public def xProjection : exampleScheme k ⟶ Spec (.of (xRing k)) :=
  Spec.map (CommRingCat.ofHom (xInclusion k))

/-- The evaluation `k[x, z₁, z₂, …] → k[x]` setting every `zₙ` to zero. -/
private def xEval : MvPolynomial (Unit ⊕ ℕ) k →+* xRing k :=
  (MvPolynomial.aeval (fun i : Unit ⊕ ℕ =>
      match i with
      | Sum.inl _ => MvPolynomial.X ()
      | Sum.inr _ => 0)).toRingHom

/-- Setting every `zₙ` to zero kills the relations. -/
private lemma relationIdeal_le_ker_xEval : relationIdeal k ≤ RingHom.ker (xEval k) := by
  rw [relationIdeal]
  apply Ideal.span_le.mpr
  rintro _ ⟨n, rfl⟩
  simp [xEval, MvPolynomial.aeval_X]

/-- The retraction `A → k[x]` setting every `zₙ` to zero. -/
private def xRetraction : coordinateRing k →+* xRing k :=
  Ideal.Quotient.lift (relationIdeal k) (xEval k) fun _a ha =>
    RingHom.mem_ker.mp (relationIdeal_le_ker_xEval k ha)

/-- The retraction `A → k[x]` is a left inverse of the inclusion `k[x] → A`. -/
private lemma xRetraction_comp_xInclusion :
    (xRetraction k).comp (xInclusion k) = RingHom.id (xRing k) := by
  apply MvPolynomial.ringHom_ext'
  · ext c
    simp [xRetraction, xEval, xInclusion]
  · intro i
    cases i
    simp [xRetraction, xEval, xInclusion]

/-- The exponent vector of the monomial `x ^ (n + 1) * zₙ₊₁`. -/
private def relationExponent (n : ℕ) : (Unit ⊕ ℕ) →₀ ℕ :=
  Finsupp.single (Sum.inl ()) (n + 1) + Finsupp.single (Sum.inr n) 1

/-- The generator `x ^ (n + 1) * zₙ₊₁` is the monomial with exponent `relationExponent n`. -/
private lemma relationGenerator_eq_monomial (n : ℕ) :
    MvPolynomial.X (Sum.inl ()) ^ (n + 1) * MvPolynomial.X (Sum.inr n) =
      MvPolynomial.monomial (relationExponent n) (1 : k) := by
  rw [MvPolynomial.X_pow_eq_monomial]
  simp only [MvPolynomial.X, MvPolynomial.monomial_mul_monomial]
  congr 1
  simp

/-- The relation ideal is spanned by monomials. -/
private lemma relationIdeal_eq_span_monomials :
    relationIdeal k = Ideal.span
      ((fun s => MvPolynomial.monomial s (1 : k)) '' Set.range relationExponent) := by
  rw [relationIdeal, ← Set.range_comp']
  exact congrArg Ideal.span (congrArg Set.range (funext (relationGenerator_eq_monomial k)))

/-- Membership in the relation ideal is a condition on the exponents appearing in the
support. -/
private lemma mem_relationIdeal_iff (p : MvPolynomial (Unit ⊕ ℕ) k) :
    p ∈ relationIdeal k ↔ ∀ m ∈ p.support, ∃ n : ℕ, relationExponent n ≤ m := by
  rw [relationIdeal_eq_span_monomials, MvPolynomial.mem_ideal_span_monomial_image]
  aesop

/-- Every polynomial admits an index `n` exceeding every `x`-exponent of its support and such
that `zₙ₊₁` does not occur in it. -/
private lemma exists_fresh_index (p : MvPolynomial (Unit ⊕ ℕ) k) :
    ∃ n : ℕ, (∀ m ∈ p.support, m (Sum.inl ()) < n) ∧ ∀ m ∈ p.support, m (Sum.inr n) = 0 := by
  let zvars : Finset ℕ := p.vars.image (fun i =>
    match i with
    | Sum.inl _ => 0
    | Sum.inr n => n)
  let n : ℕ := max (p.support.sup fun m => m (Sum.inl ())) (zvars.sup id) + 1
  have hnXbound : p.support.sup (fun m => m (Sum.inl ())) < n := by dsimp [n]; omega
  have hnZbound : zvars.sup id < n := by dsimp [n]; omega
  refine ⟨n, fun m hm => (Finset.le_sup (f := fun m => m (Sum.inl ())) hm).trans_lt hnXbound,
    fun m hm => ?_⟩
  by_contra hne
  have hnFresh : Sum.inr n ∉ p.vars := fun hv =>
    not_le_of_gt hnZbound (Finset.le_sup (f := id) (Finset.mem_image.mpr ⟨Sum.inr n, hv, rfl⟩))
  exact hnFresh ((MvPolynomial.mem_vars_iff_mem_support (p := p) (Sum.inr n)).2
    ⟨m, hm, Finsupp.mem_support_iff.mpr hne⟩)

/-- If `zₙ₊₁` does not occur in `p` and every `x`-exponent of `p` is below `n`, then
`zₙ₊₁ ^ r * p` lies in the relation ideal only if `p` does. -/
private lemma mem_relationIdeal_of_X_pow_mul_mem (p : MvPolynomial (Unit ⊕ ℕ) k) (n r : ℕ)
    (hX : ∀ m ∈ p.support, m (Sum.inl ()) < n) (hZ : ∀ m ∈ p.support, m (Sum.inr n) = 0)
    (h : MvPolynomial.X (Sum.inr n) ^ r * p ∈ relationIdeal k) : p ∈ relationIdeal k := by
  refine (mem_relationIdeal_iff k p).2 fun m hm => ?_
  have hshift : m + Finsupp.single (Sum.inr n) r ∈
      (MvPolynomial.X (Sum.inr n) ^ r * p).support := by
    rw [MvPolynomial.support_X_pow_mul]
    exact Finset.mem_map.mpr ⟨m, hm, by simp [addLeftEmbedding, add_comm]⟩
  obtain ⟨j, hj⟩ := (mem_relationIdeal_iff k _).mp h _ hshift
  by_cases hjn : j = n
  · subst j
    have hxle : n + 1 ≤ m (Sum.inl ()) := by
      simpa [relationExponent, Finsupp.single_apply] using Finsupp.le_def.mp hj (Sum.inl ())
    have hxm := hX m hm
    omega
  · refine ⟨j, Finsupp.le_def.mpr fun i => ?_⟩
    have hle := Finsupp.le_def.mp hj i
    cases i with
    | inl q => simpa [relationExponent, Finsupp.single_apply] using hle
    | inr q =>
        by_cases hqn : q = n
        · subst q
          simp [relationExponent, hZ m hm, hjn] at hle ⊢
        · simpa [relationExponent, Finsupp.single_apply, hqn, hjn] using hle

/-- The canonical map from `A` to the product of its localizations at the `zₙ` is
injective. -/
@[stacks 01RC "localization injection"]
public theorem injective_localizationProduct :
    Function.Injective (fun a : coordinateRing k =>
      fun n : ℕ => (algebraMap (coordinateRing k) (Localization.Away (z k n))) a) := by
  intro a b hab
  obtain ⟨p, hp⟩ := Ideal.Quotient.mk_surjective (a - b)
  obtain ⟨n, hX, hZ⟩ := exists_fresh_index k p
  have hlocp' : (algebraMap (coordinateRing k) (Localization.Away (z k n)))
      (Ideal.Quotient.mk (relationIdeal k) p) =
        (algebraMap (coordinateRing k) (Localization.Away (z k n))) 0 := by
    rw [map_zero, hp]
    simp only [map_sub, congrFun hab n, sub_self]
  obtain ⟨c, hc⟩ := (IsLocalization.eq_iff_exists
    (Submonoid.powers (z k n)) (Localization.Away (z k n))).mp hlocp'
  obtain ⟨r, hr⟩ := (Submonoid.mem_powers_iff c.1 (z k n)).mp c.2
  rw [← hr] at hc
  have hpoly : MvPolynomial.X (Sum.inr n) ^ r * p ∈ relationIdeal k := by
    apply (Ideal.Quotient.eq_zero_iff_mem).mp
    simpa [z, map_mul, map_pow] using hc
  rw [← sub_eq_zero, ← hp]
  exact Ideal.Quotient.eq_zero_iff_mem.2 (mem_relationIdeal_of_X_pow_mul_mem k p n r hX hZ hpoly)

/-- The open `U` is the complement of the closed set `V(I)` cut out by `I = (z₁, z₂, …)`. -/
public theorem coe_openComplement :
    (openComplement k : Set (exampleScheme k)) =
      (PrimeSpectrum.zeroLocus (zIdeal k : Set (coordinateRing k)))ᶜ := by
  ext p
  constructor
  · intro hp hmem
    obtain ⟨n, hn⟩ := TopologicalSpace.Opens.mem_iSup.mp hp
    have hzn : z k n ∈ zIdeal k := Ideal.subset_span ⟨n, rfl⟩
    exact (PrimeSpectrum.mem_basicOpen _ _).mp hn ((PrimeSpectrum.mem_zeroLocus p _).mp hmem hzn)
  · intro hp
    by_contra hcon
    have hz : ∀ n : ℕ, z k n ∈ p.asIdeal := by
      intro n
      by_contra hzn
      exact hcon (TopologicalSpace.Opens.mem_iSup.mpr
        ⟨n, (PrimeSpectrum.mem_basicOpen _ _).mpr hzn⟩)
    have hle : zIdeal k ≤ p.asIdeal := by
      rw [zIdeal]
      exact Ideal.span_le.mpr (Set.range_subset_iff.mpr hz)
    exact hp ((PrimeSpectrum.mem_zeroLocus p _).mpr (SetLike.coe_subset_coe.mpr hle))

/-- A global section of `X` restricting to zero on `U` restricts to zero on each `D(zₙ)`. -/
private lemma presheaf_map_basicOpen_eq_zero
    (s : Γ(exampleScheme k, ⊤))
    (hs : (((openComplement k).ι.appTop).hom s = 0)) (n : ℕ) :
    ((exampleScheme k).presheaf.map (homOfLE (le_top :
      (PrimeSpectrum.basicOpen (z k n) : (exampleScheme k).Opens) ≤ ⊤)).op).hom s = 0 := by
  let X := exampleScheme k
  let f := (openComplement k).ι
  let V : X.Opens := PrimeSpectrum.basicOpen (z k n)
  have hV : V ≤ f.opensRange := by
    dsimp [V, f]
    rw [Scheme.Opens.opensRange_ι]
    exact le_iSup (fun n : ℕ => PrimeSpectrum.basicOpen (z k n)) n
  let i : Opposite.op ⊤ ⟶ Opposite.op V := (homOfLE (le_top : V ≤ ⊤)).op
  have hval := congrArg (fun φ : Γ(X, ⊤) →+* Γ((openComplement k).toScheme, f ⁻¹ᵁ V) => φ s)
    (congrArg CommRingCat.Hom.hom (Scheme.Hom.naturality f i))
  have hzeroV : (f.app V).hom ((X.presheaf.map i).hom s) = 0 := by
    have hz : (CommRingCat.Hom.hom
        (f.appTop ≫ (openComplement k).toScheme.presheaf.map
          ((TopologicalSpace.Opens.map f.base).map i.unop).op)) s = 0 := by
      change ((openComplement k).toScheme.presheaf.map
        ((TopologicalSpace.Opens.map f.base).map i.unop).op).hom
          ((f.appTop).hom s) = 0
      rw [show (f.appTop).hom s = 0 by simpa [f] using hs]
      exact map_zero _
    exact hval ▸ hz
  have : IsIso (f.app V) := Scheme.Hom.isIso_app f V hV
  have hres : (X.presheaf.map i).hom s = 0 :=
    (ConcreteCategory.bijective_of_isIso (f.app V)).1 (by simpa using hzeroV)
  exact hres

/-- An element of `A` whose global section restricts to zero on `D(zₙ)` vanishes in the
localization `A_{zₙ}`. -/
private lemma algebraMap_away_eq_zero_of_restrict (a : coordinateRing k) (n : ℕ)
    (h : ((exampleScheme k).presheaf.map (homOfLE (le_top :
      (PrimeSpectrum.basicOpen (z k n) : (exampleScheme k).Opens) ≤ ⊤)).op).hom
        ((StructureSheaf.globalSectionsIso (coordinateRing k)).hom.hom a) = 0) :
    algebraMap (coordinateRing k) (Localization.Away (z k n)) a = 0 := by
  let R := coordinateRing k
  let X := exampleScheme k
  let g := StructureSheaf.globalSectionsIso R
  let V : X.Opens := PrimeSpectrum.basicOpen (z k n)
  let i : Opposite.op ⊤ ⟶ Opposite.op V := (homOfLE (le_top : V ≤ ⊤)).op
  change algebraMap R (Localization.Away (z k n)) a = 0
  let _ : Algebra R Γ(X, V) := by
    change Algebra R ((Spec.structureSheaf R).obj.obj (Opposite.op V))
    exact StructureSheaf.openAlgebra R (Opposite.op V)
  let _ : IsLocalization (Submonoid.powers (z k n)) (Γ(X, V)) := by
    change IsLocalization (Submonoid.powers (z k n)) ((Spec.structureSheaf R).obj.obj
      (Opposite.op (PrimeSpectrum.basicOpen (z k n))))
    exact StructureSheaf.IsLocalization.to_basicOpen R (z k n)
  let e := IsLocalization.algEquiv (Submonoid.powers (z k n))
    (Localization.Away (z k n)) (Γ(X, V))
  have hg : g.hom = CommRingCat.ofHom (algebraMap R
      ((Spec.structureSheaf R).obj.obj (Opposite.op ⊤))) := by
    change (StructureSheaf.globalSectionsIso (CommRingCat.of R)).hom = _
    exact StructureSheaf.globalSectionsIso_hom (CommRingCat.of R)
  have hmap : g.hom ≫ X.presheaf.map i =
      CommRingCat.ofHom (algebraMap R Γ(X, V)) := by
    rw [hg]
    change CommRingCat.ofHom (algebraMap R ((Spec.structureSheaf R).obj.obj
      (Opposite.op ⊤))) ≫ (Spec.structureSheaf R).obj.map i =
        CommRingCat.ofHom (algebraMap R ((Spec.structureSheaf R).obj.obj
          (Opposite.op V)))
    exact StructureSheaf.algebraMap_self_map R (Opposite.op V) (Opposite.op ⊤) i
  have hsecAlg : (X.presheaf.map i).hom (g.hom.hom a) =
      algebraMap R Γ(X, V) a := by
    change (g.hom ≫ X.presheaf.map i).hom a = algebraMap R Γ(X, V) a
    exact congrArg (fun φ : CommRingCat.of R ⟶ Γ(X, V) => φ.hom a) hmap
  have hlocalSec : algebraMap R Γ(X, V) a = 0 := hsecAlg.symm.trans h
  have heq : e (algebraMap R (Localization.Away (z k n)) a) =
      algebraMap R Γ(X, V) a := e.commutes a
  apply e.injective
  rw [hlocalSec] at heq
  simpa using heq

/-- A global section of `X` restricting to zero on `U` is zero. -/
private lemma appTop_eq_zero_of_eq_zero
    (s : Γ(exampleScheme k, ⊤))
    (hs : (((openComplement k).ι.appTop).hom s = 0)) : s = 0 := by
  let g := StructureSheaf.globalSectionsIso (coordinateRing k)
  let a : coordinateRing k := g.inv.hom s
  have hglobal : g.hom.hom a = s := by
    change g.hom.hom (g.inv.hom s) = s
    exact congrArg (fun φ : Γ(exampleScheme k, ⊤) →+* Γ(exampleScheme k, ⊤) => φ s)
      (congrArg CommRingCat.Hom.hom g.inv_hom_id)
  have ha : a = 0 := injective_localizationProduct k (by
    funext n
    change (algebraMap (coordinateRing k) (Localization.Away (z k n))) a =
      (algebraMap (coordinateRing k) (Localization.Away (z k n))) 0
    rw [algebraMap_away_eq_zero_of_restrict k a n
      (by rw [hglobal]; exact presheaf_map_basicOpen_eq_zero k s hs n)]
    simp)
  rw [← hglobal, ha]
  exact map_zero _

/-- The scheme-theoretic closure of the open `U` is all of `X`. -/
@[stacks 01RC "scheme-theoretic closure"]
public theorem schemeTheoreticImage_openInclusion :
    IsSchemeTheoreticallyDominant (openComplement k).ι := by
  rw [isSchemeTheoreticallyDominant_iff]
  apply Scheme.IdealSheafData.ext_of_isAffine
  have hf : Function.Injective
      (CommRingCat.Hom.hom ((openComplement k).ι.appTop)) := by
    intro s t hst
    apply sub_eq_zero.mp
    apply appTop_eq_zero_of_eq_zero k (s - t)
    rw [map_sub, hst, sub_self]
  exact le_antisymm
    ((Scheme.Hom.ideal_ker_le (openComplement k).ι ⟨⊤, isAffineOpen_top _⟩).trans
      ((RingHom.injective_iff_ker_eq_bot _).mp hf).le) bot_le

/-- The projection `X = Spec A → Spec k[x]` is surjective. -/
@[stacks 01RC "surjective projection"]
public theorem surjective_xProjection : Function.Surjective (xProjection k).base := by
  intro q
  refine ⟨PrimeSpectrum.comap (xRetraction k) q, ?_⟩
  let q' : PrimeSpectrum (xRing k) := q
  change PrimeSpectrum.comap (xInclusion k) (PrimeSpectrum.comap (xRetraction k) q') = q'
  rw [← PrimeSpectrum.comap_comp_apply, xRetraction_comp_xInclusion]
  rfl

/-- The image of `U` under the projection to `Spec k[x]` avoids the basic open `D(x)`. -/
@[stacks 01RC "restricted projection"]
public theorem xProjection_openComplement_avoids_xOpen :
    ∀ p : exampleScheme k, p ∈ (openComplement k : Set (exampleScheme k)) →
      (xProjection k).base p ∉
        (PrimeSpectrum.basicOpen (MvPolynomial.X () : xRing k) :
          Set (PrimeSpectrum (xRing k))) := by
  intro p hp
  obtain ⟨n, hn⟩ := TopologicalSpace.Opens.mem_iSup.mp hp
  have hrel : (xInclusion k (MvPolynomial.X ())) ^ (n + 1) * z k n = 0 := by
    apply (Ideal.Quotient.eq_zero_iff_mem).2
    have hgen : MvPolynomial.X (Sum.inl ()) ^ (n + 1) * MvPolynomial.X (Sum.inr n) ∈
        relationIdeal k := Ideal.subset_span ⟨n, rfl⟩
    simpa [xInclusion, z, map_mul, map_pow] using hgen
  have hprod : (xInclusion k (MvPolynomial.X ())) ^ (n + 1) * z k n ∈ p.asIdeal := by
    rw [hrel]
    exact p.asIdeal.zero_mem
  have hpow : (xInclusion k (MvPolynomial.X ())) ^ (n + 1) ∈ p.asIdeal :=
    (p.isPrime.mem_or_mem hprod).resolve_right ((PrimeSpectrum.mem_basicOpen _ _).mp hn)
  have hx : xInclusion k (MvPolynomial.X ()) ∈ p.asIdeal :=
    p.isPrime.mem_of_pow_mem (n + 1) hpow
  exact fun hmem => hmem hx

/-- The generic point of `Spec k[x]` lies in the basic open `D(x)`. -/
private lemma bot_mem_basicOpen_X :
    (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum (xRing k)) ∈
      PrimeSpectrum.basicOpen (MvPolynomial.X () : xRing k) := by
  rw [PrimeSpectrum.mem_basicOpen]
  simp [MvPolynomial.X_ne_zero]

/-- The restriction of the projection to `Spec k[x]` to the open `U` is not surjective. -/
@[stacks 01RC "restricted projection not surjective"]
public theorem not_surjective_xProjection_openComplement :
    ¬ Set.SurjOn (xProjection k).base
      (openComplement k : Set (exampleScheme k))
      (Set.univ : Set (PrimeSpectrum (xRing k))) := by
  intro hsurj
  obtain ⟨p, hp, hpeq⟩ := hsurj (Set.mem_univ (⟨⊥, Ideal.isPrime_bot⟩ : PrimeSpectrum (xRing k)))
  exact xProjection_openComplement_avoids_xOpen k p hp (by rw [hpeq]; exact bot_mem_basicOpen_X k)

/-- Although its scheme-theoretic closure is all of `X`, the open `U` is not topologically
dense in `X`. -/
@[stacks 01RC "not topologically dense"]
public theorem not_dense_openComplement :
    ¬ Dense (openComplement k : Set (exampleScheme k)) := by
  intro hdense
  obtain ⟨_, hmem, p, hp, rfl⟩ := ((surjective_xProjection k).denseRange.dense_image
    (xProjection k).continuous hdense).inter_open_nonempty _ (PrimeSpectrum.basicOpen _).2
    ⟨_, bot_mem_basicOpen_X k⟩
  exact xProjection_openComplement_avoids_xOpen k p hp hmem

end Stacks.Morphisms.DenseNotTopologicallyDense

end
