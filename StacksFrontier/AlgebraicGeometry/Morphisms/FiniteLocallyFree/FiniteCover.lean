/-!
# Finite morphisms after a finite locally free base change

A finite morphism to an affine scheme becomes a closed subscheme of a finite locally free
scheme after a surjective finite locally free base change. The ambient scheme is the
set-theoretic union of finitely many closed copies of the new base.

## Main results

* `Stacks.Morphisms.exists_finiteLocallyFree_cover_closedImmersion` constructs the base change,
  the ambient scheme, and the finite family of closed sections.

## Implementation notes

The base-changed source is the canonical pullback, rather than a separately chosen scheme
equipped with an isomorphism. A closed section `s` of `p` identifies its image with the base,
which is the formal content of "maps isomorphically to `X'`" in the source. The pointwise
coverage condition says precisely that these finitely many images cover the ambient scheme
set-theoretically.

The algebraic core is `Stacks.Morphisms.finite_free_monicRelationQuotient`: the quotient of
`A'[T_1, …, T_n]` by one monic polynomial in each variable separately is finite and free over
`A'`. It is proved by induction on `n`, peeling off the first variable with
`MvPolynomial.finSuccEquiv` and recognizing the result as a quotient of a univariate polynomial
ring by a monic polynomial.

## References

* [Stacks Project, Tag 03HW](https://stacks.math.columbia.edu/tag/03HW)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Polynomial
open scoped TensorProduct

universe u

namespace Stacks.Morphisms

/-- The element `P i (T i)` of `R[T_0, …, T_{n-1}]`, for a family `P` of univariate
polynomials. -/
private noncomputable def monicRelation {R : Type u} [CommRing R] {n : ℕ}
    (P : Fin n → R[X]) : Fin n → MvPolynomial (Fin n) R :=
  fun i ↦ Polynomial.toMvPolynomial i (P i)

/-- The ideal of `R[T_0, …, T_{n-1}]` generated by `P 0 (T 0), …, P (n-1) (T (n-1))`. -/
private noncomputable def monicRelationIdeal {R : Type u} [CommRing R] {n : ℕ}
    (P : Fin n → R[X]) : Ideal (MvPolynomial (Fin n) R) :=
  Ideal.span (Set.range (monicRelation P))

private lemma finSuccEquiv_monicRelation_succ {R : Type u} [CommRing R] {n : ℕ}
    (i : Fin n) (p : R[X]) :
    (MvPolynomial.finSuccEquiv R n) (Polynomial.toMvPolynomial i.succ p) =
      Polynomial.C (Polynomial.toMvPolynomial i p) :=
  Polynomial.induction_on' p (fun p q hp hq ↦ by simp [hp, hq]) fun m a ↦ by
    simp [MvPolynomial.finSuccEquiv_apply, Polynomial.toMvPolynomial,
      ← Polynomial.C_mul_X_pow_eq_monomial]

private lemma finSuccEquiv_monicRelation_zero {R : Type u} [CommRing R] {n : ℕ} (p : R[X]) :
    (MvPolynomial.finSuccEquiv R n) (Polynomial.toMvPolynomial (0 : Fin (n + 1)) p) =
      Polynomial.map MvPolynomial.C p :=
  Polynomial.induction_on' p (fun p q hp hq ↦ by simp [hp, hq]) fun m a ↦ by
    simp [MvPolynomial.finSuccEquiv_apply, Polynomial.toMvPolynomial,
      ← Polynomial.C_mul_X_pow_eq_monomial]

/-- Peeling off the variable `T 0`: under `MvPolynomial.finSuccEquiv`, the ideal of monic
relations becomes the relations in the remaining variables together with `P 0`. -/
private lemma monicRelationIdeal_finSuccEquiv {R : Type u} [CommRing R] {n : ℕ}
    (P : Fin (n + 1) → R[X]) :
    Ideal.map (MvPolynomial.finSuccEquiv R n) (monicRelationIdeal P) =
      Ideal.map Polynomial.C (monicRelationIdeal fun i : Fin n ↦ P i.succ) ⊔
        Ideal.span {Polynomial.map MvPolynomial.C (P 0)} := by
  classical
  set tail : Fin n → R[X] := fun i ↦ P i.succ with htail
  set f : Fin (n + 1) → Polynomial (MvPolynomial (Fin n) R) := fun i ↦
    (MvPolynomial.finSuccEquiv R n) (monicRelation P i) with hf
  have h0 : f 0 = Polynomial.map MvPolynomial.C (P 0) := by
    simp [hf, monicRelation, finSuccEquiv_monicRelation_zero]
  have hs (i : Fin n) : f i.succ = Polynomial.C (monicRelation tail i) := by
    simp [hf, htail, monicRelation, finSuccEquiv_monicRelation_succ]
  have hrange : Set.range f = {Polynomial.map MvPolynomial.C (P 0)} ∪
      Set.range fun i : Fin n ↦ Polynomial.C (monicRelation tail i) := by
    ext q
    constructor
    · rintro ⟨i, rfl⟩
      refine Fin.cases ?_ (fun j ↦ ?_) i
      · exact Or.inl (by simp [h0])
      · exact Or.inr ⟨j, by rw [hs]⟩
    · rintro (hq | ⟨i, rfl⟩)
      · exact ⟨0, h0.trans hq.symm⟩
      · exact ⟨i.succ, hs i⟩
  rw [monicRelationIdeal, Ideal.map_span]
  have himage : (MvPolynomial.finSuccEquiv R n) '' Set.range (monicRelation P) = Set.range f :=
    (Set.range_comp _ (monicRelation P)).symm
  rw [himage, hrange, Ideal.span_union, monicRelationIdeal, Ideal.map_span]
  have hset : (Set.range fun i : Fin n ↦ Polynomial.C (monicRelation tail i)) =
      Polynomial.C '' Set.range (monicRelation tail) :=
    Set.range_comp Polynomial.C (monicRelation tail)
  rw [hset]
  exact sup_comm _ _

/-- Forming polynomials commutes with quotienting by an ideal of the coefficients, as
`R`-algebras. -/
private noncomputable def monicRelationPolynomialCoeffEquiv {R : Type u} [CommRing R] {n : ℕ}
    (P : Fin n → R[X]) :
    Polynomial (MvPolynomial (Fin n) R ⧸ monicRelationIdeal P) ≃ₐ[R]
      Polynomial (MvPolynomial (Fin n) R) ⧸
        Ideal.map Polynomial.C (monicRelationIdeal P) := by
  refine AlgEquiv.ofRingEquiv
    (f := Ideal.polynomialQuotientEquivQuotientPolynomial (monicRelationIdeal P)) fun r ↦ ?_
  change Ideal.polynomialQuotientEquivQuotientPolynomial (monicRelationIdeal P)
      (Polynomial.C (algebraMap R (MvPolynomial (Fin n) R ⧸ monicRelationIdeal P) r)) =
    Ideal.Quotient.mk (Ideal.map Polynomial.C (monicRelationIdeal P))
      (Polynomial.C (MvPolynomial.C r))
  have hr : algebraMap R (MvPolynomial (Fin n) R ⧸ monicRelationIdeal P) r =
      Ideal.Quotient.mk (monicRelationIdeal P) (MvPolynomial.C r) := rfl
  rw [hr]
  simp [Ideal.polynomialQuotientEquivQuotientPolynomial]

/-- The quotient of `R[T_0, …, T_{n-1}]` by one monic polynomial in each variable separately is
finite and free over `R`. -/
@[ega "0 10.3.1.2" "more general", ega "0 22.4.1" "(i)", sga "3 XXIV 6.2" "partial"]
private theorem finite_free_monicRelationQuotient {R : Type u} [CommRing R]
    (n : ℕ) (P : Fin n → R[X]) (hP : ∀ i, (P i).Monic) :
    Module.Finite R (MvPolynomial (Fin n) R ⧸ monicRelationIdeal P) ∧
      Module.Free R (MvPolynomial (Fin n) R ⧸ monicRelationIdeal P) := by
  induction n with
  | zero =>
      have hI : monicRelationIdeal P = ⊥ := by
        simp [monicRelationIdeal]
      let e : (MvPolynomial (Fin 0) R ⧸ monicRelationIdeal P) ≃ₐ[R] R :=
        (Ideal.quotientEquivAlgOfEq R hI).trans <|
          (AlgEquiv.quotientBot R (MvPolynomial (Fin 0) R)).trans
            (MvPolynomial.isEmptyAlgEquiv R (Fin 0))
      exact ⟨Module.Finite.of_surjective e.symm.toLinearMap e.symm.surjective,
        Module.Free.of_equiv e.symm.toLinearEquiv⟩
  | succ n ih =>
      set tail : Fin n → R[X] := fun i ↦ P i.succ with htail
      obtain ⟨hfinite, hfree⟩ := ih tail fun i ↦ hP i.succ
      set A := MvPolynomial (Fin n) R with hA
      set J := monicRelationIdeal tail with hJ
      set Q := A ⧸ J with hQ
      set f : Polynomial A := Polynomial.map MvPolynomial.C (P 0) with hfdef
      set q : Polynomial Q := f.map (Ideal.Quotient.mk J) with hq
      set I₀ : Ideal (Polynomial A) := Ideal.map Polynomial.C J with hI₀
      set I₁ : Ideal (Polynomial A) := Ideal.span {f} with hI₁
      set hCoeff := monicRelationPolynomialCoeffEquiv tail with hCoeffDef
      have hgen : (hCoeff : Polynomial Q →+* Polynomial A ⧸ I₀) q =
          Ideal.Quotient.mkₐ R I₀ f := by
        show Ideal.polynomialQuotientEquivQuotientPolynomial J _ = _
        exact Ideal.polynomialQuotientEquivQuotientPolynomial_map_mk J f
      have heqCoeff : Ideal.map (hCoeff : Polynomial Q →+* Polynomial A ⧸ I₀)
          (Ideal.span {q}) = Ideal.map (Ideal.Quotient.mkₐ R I₀) I₁ := by
        rw [Ideal.map_span, Set.image_singleton, hI₁, Ideal.map_span, Set.image_singleton]
        ext x
        simp [hgen]
      set eCoeff := Ideal.quotientEquivAlg (Ideal.span {q})
        (Ideal.map (Ideal.Quotient.mkₐ R I₀) I₁) hCoeff heqCoeff.symm with heCoeff
      have heq : Ideal.map (MvPolynomial.finSuccEquiv R n) (monicRelationIdeal P) = I₀ ⊔ I₁ := by
        simpa [hI₀, hI₁, hfdef, htail, hJ] using monicRelationIdeal_finSuccEquiv P
      set e : (MvPolynomial (Fin (n + 1)) R ⧸ monicRelationIdeal P) ≃ₐ[R]
          Polynomial Q ⧸ Ideal.span {q} :=
        (Ideal.quotientEquivAlg (monicRelationIdeal P) (I₀ ⊔ I₁)
            (MvPolynomial.finSuccEquiv R n) heq.symm).trans
          ((DoubleQuot.quotQuotEquivQuotSupₐ R I₀ I₁).symm.trans eCoeff.symm) with hedef
      have hqMonic : q.Monic := ((hP 0).map (algebraMap R A)).map (Ideal.Quotient.mk J)
      let _ : Module.Finite R Q := hfinite
      let _ : Module.Free R Q := hfree
      let _ : Module.Finite Q (Polynomial Q ⧸ Ideal.span {q}) := hqMonic.finite_quotient
      let _ : Module.Free Q (Polynomial Q ⧸ Ideal.span {q}) := hqMonic.free_quotient
      have hfiniteB : Module.Finite R (Polynomial Q ⧸ Ideal.span {q}) :=
        Module.Finite.trans Q (Polynomial Q ⧸ Ideal.span {q})
      have hfreeB : Module.Free R (Polynomial Q ⧸ Ideal.span {q}) :=
        Module.Free.trans (R := R) (S := Q) (M := Polynomial Q ⧸ Ideal.span {q})
      exact ⟨Module.Finite.of_surjective e.symm.toLinearMap e.symm.surjective,
        Module.Free.of_equiv e.symm.toLinearEquiv⟩

/-- The spectrum map of a finite free algebra is finite locally free. -/
private theorem isFiniteLocallyFree_spec_algebraMap {A B : Type u} [CommRing A] [CommRing B]
    [Algebra A B] [Module.Finite A B] [Module.Free A B] :
    IsFiniteLocallyFree (Spec.map (CommRingCat.ofHom (algebraMap A B))) := by
  refine (specMap_finiteLocallyFree_iff _ _ _).2 ⟨?_, ?_, ?_⟩
  · rw [IsFinite.SpecMap_iff]
    exact RingHom.finite_algebraMap.mpr inferInstance
  · rw [Flat.SpecMap_iff]
    change (algebraMap A B).Flat
    rw [RingHom.flat_algebraMap_iff]
    infer_instance
  · rw [LocallyOfFinitePresentation.SpecMap_iff]
    change (algebraMap A B).FinitePresentation
    let _ : Module.FinitePresentation A B := Module.finitePresentation_of_projective A B
    exact RingHom.finitePresentation_algebraMap.mpr
      (Algebra.FinitePresentation.of_finitePresentation A B)

/-- **Stacks Project, Tag 03HW.** After a surjective finite locally free base change,
a finite morphism to an affine scheme embeds into a finite locally free scheme covered
set-theoretically by finitely many closed sections. -/
@[stacks 03HW]
theorem exists_finiteLocallyFree_cover_closedImmersion
    {Y X : Scheme.{u}} (f : Y ⟶ X) [IsFinite f] [IsAffine X] :
    ∃ (X' : Scheme.{u}) (g : X' ⟶ X),
      Surjective g ∧ IsFiniteLocallyFree g ∧
      Surjective (pullback.fst f g) ∧
      IsFiniteLocallyFree (pullback.fst f g) ∧
      ∃ (Z' : Scheme.{u}) (p : Z' ⟶ X')
        (i : pullback f g ⟶ Z'),
        IsClosedImmersion i ∧
        i ≫ p = pullback.snd f g ∧
        IsFiniteLocallyFree p ∧
        ∃ (m : ℕ) (s : Fin m → (X' ⟶ Z')),
          (∀ j, IsClosedImmersion (s j) ∧ s j ≫ p = 𝟙 X') ∧
          (∀ z : Z', ∃ j : Fin m, ∃ x : X', (s j).base x = z) := by
  classical
  let R := Γ(X, ⊤)
  let S := Γ(Y, ⊤)
  have : IsAffine Y := isAffine_of_isAffineHom f
  let _ : Algebra R S := f.appTop.hom.toAlgebra
  have hfR : (algebraMap R S).Finite := by
    simpa only [RingHom.algebraMap_toAlgebra] using f.finite_appTop
  let _ : Module.Finite R S := RingHom.finite_algebraMap.mp hfR
  obtain ⟨A', _, _, hAfinite, hAfree, hAinj, n, d, α, qMap, hqMap⟩ :=
    exists_finite_free_extension_quotient_split_polynomials (R := R) (S := S)
  let _ : Module.Finite R A' := hAfinite
  let _ : Module.Free R A' := hAfree
  let _ : Algebra A' (S ⊗[R] A') := Algebra.TensorProduct.rightAlgebra
  let P : Fin n → A'[X] := fun i ↦ ∏ j : Fin (d i), (Polynomial.X - Polynomial.C (α i j))
  have hrel (i : Fin n) : monicRelation P i =
      ∏ j : Fin (d i), (MvPolynomial.X i - MvPolynomial.C (α i j)) := by
    simp [monicRelation, P]
  have hJ : monicRelationIdeal P = Ideal.span (Set.range fun i : Fin n ↦
      ∏ j : Fin (d i), (MvPolynomial.X i - MvPolynomial.C (α i j))) := by
    rw [monicRelationIdeal, funext hrel]
  have hP : ∀ i, (P i).Monic := fun i ↦
    Polynomial.monic_prod_of_monic Finset.univ _ fun j _ ↦ Polynomial.monic_X_sub_C (α i j)
  obtain ⟨hCfinite, hCfree⟩ := finite_free_monicRelationQuotient n P hP
  let C : Type u := MvPolynomial (Fin n) A' ⧸ monicRelationIdeal P
  let _ : Module.Finite A' C := hCfinite
  let _ : Module.Free A' C := hCfree
  let eJ : C ≃ₐ[A'] (MvPolynomial (Fin n) A' ⧸ _) := Ideal.quotientEquivAlgOfEq A' hJ
  let qMap' : C →ₐ[A'] S ⊗[R] A' := qMap.comp eJ.toAlgHom
  have hqMap' : Function.Surjective qMap' := hqMap.comp eJ.surjective
  let X' : Scheme.{u} := Spec (.of A')
  let Z' : Scheme.{u} := Spec (.of C)
  let gSpec : X' ⟶ Spec R := Spec.map (CommRingCat.ofHom (algebraMap R A'))
  let g : X' ⟶ X := gSpec ≫ X.isoSpec.inv
  have hgFLF : IsFiniteLocallyFree g := by
    obtain ⟨_, _, _⟩ := (isFiniteLocallyFree_iff_isFinite_flat_locallyOfFinitePresentation gSpec).1
      isFiniteLocallyFree_spec_algebraMap
    exact (isFiniteLocallyFree_iff_isFinite_flat_locallyOfFinitePresentation g).2
      ⟨inferInstance, inferInstance, inferInstance⟩
  have hgSurj : Surjective g := by
    rw [surjective_iff]
    intro x
    obtain ⟨y, hy⟩ := RingHom.IsIntegral.comap_surjective
      (RingHom.finite_algebraMap.mpr hAfinite).to_isIntegral hAinj (X.isoSpec.hom x)
    refine ⟨y, X.isoSpec.hom.homeomorph.injective ?_⟩
    show (X.isoSpec.inv ≫ X.isoSpec.hom) (gSpec y) = X.isoSpec.hom x
    rw [X.isoSpec.inv_hom_id]
    exact hy
  refine ⟨X', g, hgSurj, hgFLF, ?_, ?_, ?_⟩
  · infer_instance
  · let _ : IsFiniteLocallyFree g := hgFLF
    let _ : MorphismProperty.IsStableUnderBaseChangeAlong
        (@IsFiniteLocallyFree : MorphismProperty Scheme.{u}) f :=
      ⟨fun {_ _} {_} {_} {_} h hg ↦
        MorphismProperty.IsStableUnderBaseChange.of_isPullback h hg⟩
    exact MorphismProperty.pullback_fst f g hgFLF
  · let fSpec := Spec.map (CommRingCat.ofHom (algebraMap R S))
    have hApp : CommRingCat.ofHom (algebraMap R S) = f.appTop := by
      apply CommRingCat.hom_ext
      ext a
      rfl
    let ePullMap : pullback f g ⟶ pullback fSpec gSpec :=
      pullback.map f g fSpec gSpec Y.isoSpec.hom (𝟙 X') X.isoSpec.hom
        (by simpa [fSpec, hApp] using (Scheme.isoSpec_hom_naturality (f := f)).symm)
        (by simp [g, gSpec])
    let ePull : pullback f g ≅ Spec (.of (S ⊗[R] A')) :=
      asIso ePullMap ≪≫ AlgebraicGeometry.pullbackSpecIso R S A'
    let i : pullback f g ⟶ Z' :=
      ePull.hom ≫ Spec.map (CommRingCat.ofHom qMap'.toRingHom)
    let p : Z' ⟶ X' := Spec.map (CommRingCat.ofHom (algebraMap A' C))
    have hpFLF : IsFiniteLocallyFree p := isFiniteLocallyFree_spec_algebraMap
    have hiClosed : IsClosedImmersion i := by
      let _ : IsClosedImmersion (Spec.map (CommRingCat.ofHom qMap'.toRingHom)) :=
        IsClosedImmersion.spec_of_surjective (CommRingCat.ofHom qMap'.toRingHom) hqMap'
      exact IsClosedImmersion.comp ePull.hom _
    have hip : i ≫ p = pullback.snd f g := by
      have hcomp : CommRingCat.ofHom (algebraMap A' C) ≫
          CommRingCat.ofHom qMap'.toRingHom =
          CommRingCat.ofHom (algebraMap A' (S ⊗[R] A')) := by
        apply CommRingCat.hom_ext
        ext a
        exact qMap'.commutes a
      have hright : CommRingCat.ofHom (algebraMap A' (S ⊗[R] A')) =
          CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom := by
        apply CommRingCat.hom_ext
        ext a
        simp [Algebra.TensorProduct.right_algebraMap_apply,
          Algebra.TensorProduct.includeRight_apply]
      calc
        i ≫ p = ePull.hom ≫ Spec.map (CommRingCat.ofHom qMap'.toRingHom) ≫
            Spec.map (CommRingCat.ofHom (algebraMap A' C)) := rfl
        _ = ePull.hom ≫ Spec.map
            (CommRingCat.ofHom (algebraMap A' C) ≫ CommRingCat.ofHom qMap'.toRingHom) := by
              rw [← Spec.map_comp]
        _ = ePull.hom ≫ Spec.map (CommRingCat.ofHom (algebraMap A' (S ⊗[R] A'))) := by
              rw [hcomp]
        _ = ePullMap ≫ (pullbackSpecIso R S A').hom ≫
            Spec.map (CommRingCat.ofHom (algebraMap A' (S ⊗[R] A'))) := rfl
        _ = ePullMap ≫ ((pullbackSpecIso R S A').hom ≫
            Spec.map (CommRingCat.ofHom Algebra.TensorProduct.includeRight.toRingHom)) := by
              rw [hright]
        _ = ePullMap ≫ pullback.snd fSpec gSpec :=
              congrArg (fun h ↦ ePullMap ≫ h) (pullbackSpecIso_hom_snd R S A')
        _ = pullback.snd f g := by
              simp only [ePullMap, pullback.map, pullback.lift_snd, Category.comp_id]
    let K := (i : Fin n) → Fin (d i)
    let ev (k : K) : MvPolynomial (Fin n) A' →ₐ[A'] A' := MvPolynomial.aeval fun i ↦ α i (k i)
    have hevkill (k : K) : monicRelationIdeal P ≤ RingHom.ker (ev k).toRingHom := by
      rw [hJ]
      refine Ideal.span_le.mpr ?_
      rintro z ⟨i, rfl⟩
      show MvPolynomial.aeval (fun j ↦ α j (k j))
        (∏ j : Fin (d i), (MvPolynomial.X i - MvPolynomial.C (α i j))) = 0
      rw [map_prod]
      refine Finset.prod_eq_zero (Finset.mem_univ (k i)) ?_
      show MvPolynomial.aeval (fun j ↦ α j (k j))
        (MvPolynomial.X i - MvPolynomial.C (α i (k i))) = 0
      rw [map_sub, MvPolynomial.aeval_X, MvPolynomial.aeval_C]
      simp [Algebra.algebraMap_self]
    let evC (k : K) : C →ₐ[A'] A' :=
      Ideal.Quotient.liftₐ _ (ev k) fun a ha ↦ RingHom.mem_ker.mp (hevkill k ha)
    let sK (k : K) : X' ⟶ Z' := Spec.map (CommRingCat.ofHom (evC k).toRingHom)
    have hevCsurj (k : K) : Function.Surjective (evC k) := by
      intro a
      refine ⟨Ideal.Quotient.mk (monicRelationIdeal P) (MvPolynomial.C a), ?_⟩
      show MvPolynomial.aeval (fun i ↦ α i (k i)) (MvPolynomial.C a) = a
      rw [MvPolynomial.aeval_C]
      rfl
    have hsK (k : K) : IsClosedImmersion (sK k) ∧ sK k ≫ p = 𝟙 X' := by
      refine ⟨IsClosedImmersion.spec_of_surjective _ (hevCsurj k), ?_⟩
      have hcomp : CommRingCat.ofHom (algebraMap A' C) ≫
          CommRingCat.ofHom (evC k).toRingHom = 𝟙 (CommRingCat.of A') := by
        ext a
        simp [evC]
      dsimp only [sK, p]
      rw [← Spec.map_comp, ← Spec.map_id]
      exact congrArg Spec.map hcomp
    have hcover : ∀ z : Z', ∃ k : K, ∃ x : X', (sK k).base x = z := by
      intro z
      have : z.asIdeal.IsPrime := z.isPrime
      let θ : C →+* C ⧸ z.asIdeal := Ideal.Quotient.mk z.asIdeal
      let φ : MvPolynomial (Fin n) A' →+* C ⧸ z.asIdeal :=
        θ.comp (Ideal.Quotient.mk (monicRelationIdeal P))
      have _ : IsDomain (C ⧸ z.asIdeal) := Ideal.Quotient.isDomain z.asIdeal
      have hkill : ∀ i, φ (∏ j : Fin (d i),
          (MvPolynomial.X i - MvPolynomial.C (α i j))) = 0 := by
        intro i
        have hi : Ideal.Quotient.mk (monicRelationIdeal P)
            (∏ j : Fin (d i), (MvPolynomial.X i - MvPolynomial.C (α i j))) = 0 :=
          Ideal.Quotient.eq_zero_iff_mem.mpr (by
            rw [← hrel i]
            exact Ideal.subset_span ⟨i, rfl⟩)
        show θ (Ideal.Quotient.mk (monicRelationIdeal P)
          (∏ j : Fin (d i), (MvPolynomial.X i - MvPolynomial.C (α i j)))) = 0
        rw [hi]
        simp
      choose k hk using fun i ↦
        Stacks.Spectrum.PolynomialQuotientImage.exists_eq_of_factoredPoly_eq_zero d α φ hkill i
      let ψ : A' →+* C ⧸ z.asIdeal := θ.comp (algebraMap A' C)
      have hcoeff : (Ideal.Quotient.mk (monicRelationIdeal P)).comp
          (algebraMap A' (MvPolynomial (Fin n) A')) = algebraMap A' C :=
        Ideal.Quotient.mk_comp_algebraMap (R₁ := A') _
      have hcomp : ψ.comp (ev k).toRingHom = φ := by
        apply MvPolynomial.ringHom_ext
        · intro a
          show ψ (ev k (MvPolynomial.C a)) = φ (MvPolynomial.C a)
          rw [MvPolynomial.aeval_C]
          show θ (algebraMap A' C (algebraMap A' A' a)) =
            θ (Ideal.Quotient.mk (monicRelationIdeal P) (MvPolynomial.C a))
          simp only [Algebra.algebraMap_self, RingHom.id_apply]
          rw [← MvPolynomial.algebraMap_eq]
          exact congrArg θ (RingHom.congr_fun hcoeff a).symm
        · intro i
          show ψ (ev k (MvPolynomial.X i)) = φ (MvPolynomial.X i)
          rw [MvPolynomial.aeval_X, ← hk i]
          show θ (algebraMap A' C (α i (k i))) =
            θ (Ideal.Quotient.mk (monicRelationIdeal P) (MvPolynomial.C (α i (k i))))
          rw [← MvPolynomial.algebraMap_eq]
          exact congrArg θ (RingHom.congr_fun hcoeff (α i (k i))).symm
      have hfac : ψ.comp (evC k).toRingHom = θ := Ideal.Quotient.ringHom_ext hcomp
      refine ⟨k, PrimeSpectrum.comap ψ ⟨⊥, Ideal.isPrime_bot⟩, ?_⟩
      apply PrimeSpectrum.ext
      show Ideal.comap (evC k).toRingHom
        (PrimeSpectrum.comap ψ ⟨⊥, Ideal.isPrime_bot⟩).asIdeal = z.asIdeal
      ext a
      rw [PrimeSpectrum.comap_asIdeal, Ideal.mem_comap]
      show (ψ.comp (evC k).toRingHom) a = 0 ↔ a ∈ z.asIdeal
      rw [hfac]
      simp [θ, Ideal.Quotient.eq_zero_iff_mem]
    refine ⟨Z', p, i, hiClosed, hip, hpFLF, Fintype.card K,
      fun j ↦ sK ((Fintype.equivFin K).symm j), fun j ↦ hsK _, fun z ↦ ?_⟩
    obtain ⟨k, x, hx⟩ := hcover z
    exact ⟨Fintype.equivFin K k, x, by simpa using hx⟩

end Stacks.Morphisms

end
