module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Basic
public import StacksFrontier.AlgebraicGeometry.Discriminant.DiscriminantIdeal
public import StacksFrontier.AlgebraicGeometry.Morphisms.FiniteLocallyFree.Norm

/-!
# The norm of an ideal sheaf along a finite locally free morphism

Let `f : Y ⟶ X` be a finite locally free morphism, with source `Y` and base `X`, and let
`Norm_f : f_*𝒪_Y → 𝒪_X` be its determinant norm (Tag 0BD2).  For a quasi-coherent ideal sheaf
`I ⊆ 𝒪_Y` the *norm* `Norm_f(I) ⊆ 𝒪_X` is the ideal sheaf whose ideal over an affine open `U`
of `X` is generated by the norms of the sections of `I` over the affine open `f⁻¹U`.  When `I`
cuts out a locally principal closed subscheme `R`, generated by `h` over `f⁻¹U`, this ideal is
generated by `Norm_f(h)`: it is the ideal sheaf of the norm of `R` in the sense of Divisors,
Section 0BCX, where the norm of `R` is cut out locally by the norm of a local equation.

## Main definitions

* `Stacks.Norm.normIdealSheaf`: the norm `Norm_f(I)` of an ideal sheaf `I` on the source, as an
  ideal sheaf on the base.

## Main results

* `Stacks.Norm.normIdealSheaf_ideal_eq_span_of_eq_span`: over an affine open `U` of the base on
  whose preimage `I` is generated by `h`, the norm of `I` is generated by `Norm_f(h)`.
* `Stacks.Norm.eq_normIdealSheaf_of_forall_exists`: the globalization principle.  An ideal sheaf
  `J` on the base is the norm of `I` as soon as every point of the base has an affine open
  neighbourhood `U` with `I` generated over `f⁻¹U` by some `h` and `J` generated over `U` by
  `Norm_f(h)`.
* `Stacks.Norm.exists_affineOpens_mem_le_free`: the affine opens of the base over which the
  sections of `𝒪_Y` are free form a basis of the base.

## Implementation notes

The norm is not additive, so the ideals over affine opens are defined as spans of images.
Compatibility with principal opens `U_g` of an affine open `U` is the one computation: the
sections of `𝒪_Y` over `f⁻¹(U_g)` are the localization of those over `f⁻¹U` at `f^♯ g`, so every
section of `I` over `f⁻¹(U_g)` becomes the restriction of a section `s` of `I` over `f⁻¹U` after
multiplying by a power of `f^♯ g`, and the norm of that power is a unit over `U_g`.

## References

* [Stacks Project, Section 0BCX](https://stacks.math.columbia.edu/tag/0BCX)
* [Stacks Project, Tag 0BD2](https://stacks.math.columbia.edu/tag/0BD2)
* [Stacks Project, Tag 0BWA](https://stacks.math.columbia.edu/tag/0BWA)
* [Stacks Project, Tag 0C17](https://stacks.math.columbia.edu/tag/0C17)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory Opposite TopologicalSpace

universe u

namespace Stacks.Norm

variable {X Y : Scheme.{u}} (f : Y ⟶ X) [Stacks.Morphisms.IsFiniteLocallyFree f]

/-- The preimage of an affine open of the base along a finite locally free morphism, as an affine
open of the source. -/
abbrev preimageAffineOpen (U : X.affineOpens) : Y.affineOpens :=
  ⟨f ⁻¹ᵁ U.1, IsAffineHom.isAffine_preimage U.1 U.2⟩

/-- The ideal over an affine open `U` of the base generated by the norms of the sections of an
ideal sheaf `I` of the source over `f⁻¹U`. -/
def normIdeal (I : Y.IdealSheafData) (U : X.affineOpens) : Ideal Γ(X, U.1) :=
  Ideal.span ((finiteLocallyFreeNorm f).app U.1 ''
    (I.ideal (preimageAffineOpen f U) : Set Γ(Y, (preimageAffineOpen f U).1)))

/-- The norm ideals are compatible with passing to a principal open of an affine open. -/
theorem normIdeal_map_basicOpen (I : Y.IdealSheafData) (U : X.affineOpens) (g : Γ(X, U.1)) :
    (normIdeal f I U).map (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom =
      normIdeal f I (X.affineBasicOpen g) := by
  let N := finiteLocallyFreeNorm f
  let U' := X.affineBasicOpen g
  have hle : f ⁻¹ᵁ U'.1 ≤ f ⁻¹ᵁ U.1 := f.preimage_mono (X.basicOpen_le g)
  let ρ := (Y.presheaf.map (homOfLE hle).op).hom
  let σ : Γ(X, U.1) →+* Γ(X, U'.1) := (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom
  have hnat : ∀ s, N.app U'.1 (ρ s) = σ (N.app U.1 s) := fun s ↦
    N.naturality (homOfLE (X.basicOpen_le g)) s
  change Ideal.map σ (Ideal.span (N.app U.1 '' (I.ideal (preimageAffineOpen f U) : Set _))) =
    Ideal.span (N.app U'.1 '' (I.ideal (preimageAffineOpen f U') : Set _))
  rw [Ideal.map_span,
    ← I.map_ideal (U := preimageAffineOpen f U') (V := preimageAffineOpen f U) hle]
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
  · rintro _ ⟨_, ⟨s, hs, rfl⟩, rfl⟩
    rw [← hnat]
    exact Ideal.subset_span ⟨ρ s, Ideal.mem_map_of_mem _ hs, rfl⟩
  · rintro _ ⟨t, ht, rfl⟩
    let : Algebra Γ(Y, f ⁻¹ᵁ U.1) Γ(Y, f ⁻¹ᵁ U'.1) := ρ.toAlgebra
    have : IsLocalization.Away (f.app U.1 g) Γ(Y, f ⁻¹ᵁ U'.1) :=
      (preimageAffineOpen f U).2.isLocalization_of_eq_basicOpen (f.app U.1 g) (homOfLE hle)
        (f.preimage_basicOpen g)
    obtain ⟨⟨⟨s, hs⟩, ⟨_, n, rfl⟩⟩, hst⟩ :=
      (IsLocalization.mem_map_algebraMap_iff (Submonoid.powers (f.app U.1 g))
        Γ(Y, f ⁻¹ᵁ U'.1)).mp ht
    obtain ⟨u, hu⟩ : IsUnit (N.app U'.1 (ρ (f.app U.1 g ^ n))) :=
      (IsLocalization.map_units Γ(Y, f ⁻¹ᵁ U'.1)
        (⟨_, n, rfl⟩ : Submonoid.powers (f.app U.1 g))).map _
    have hmul : N.app U'.1 t * N.app U'.1 (ρ (f.app U.1 g ^ n)) = σ (N.app U.1 s) := by
      rw [← map_mul, ← hnat]
      exact congrArg _ hst
    have ht' : N.app U'.1 t = σ (N.app U.1 s) * ↑u⁻¹ := by
      rw [← hmul, ← hu, mul_assoc, Units.mul_inv, mul_one]
    rw [ht']
    exact Ideal.mul_mem_right _ _ (Ideal.subset_span ⟨_, ⟨s, hs, rfl⟩, rfl⟩)

/-- **The norm of an ideal sheaf.**  For a finite locally free morphism `f : Y ⟶ X` and an ideal
sheaf `I` on `Y`, the ideal sheaf `Norm_f(I)` on `X` whose ideal over an affine open `U` is
generated by the norms of the sections of `I` over `f⁻¹U`.  For `I` locally principal it is the
ideal sheaf of the norm of the closed subscheme cut out by `I`. -/
def normIdealSheaf (I : Y.IdealSheafData) : X.IdealSheafData where
  ideal := normIdeal f I
  map_ideal_basicOpen := normIdeal_map_basicOpen f I

/-- Over an affine open `U` of the base, the ideal of `normIdealSheaf f I` is `normIdeal f I U`. -/
theorem normIdealSheaf_ideal (I : Y.IdealSheafData) (U : X.affineOpens) :
    (normIdealSheaf f I).ideal U = normIdeal f I U :=
  rfl

/-- Over an affine open `U` of the base on whose preimage the ideal sheaf `I` is generated by
`h`, the norm of `I` is generated by the norm of `h`. -/
theorem normIdealSheaf_ideal_eq_span_of_eq_span (I : Y.IdealSheafData) (U : X.affineOpens)
    (h : Γ(Y, f ⁻¹ᵁ U.1)) (hI : I.ideal (preimageAffineOpen f U) = Ideal.span {h}) :
    (normIdealSheaf f I).ideal U = Ideal.span {(finiteLocallyFreeNorm f).app U.1 h} := by
  rw [normIdealSheaf_ideal, normIdeal, hI]
  refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr (Set.singleton_subset_iff.mpr
    (Ideal.subset_span ⟨h, Ideal.mem_span_singleton_self h, rfl⟩)))
  rintro _ ⟨s, hs, rfl⟩
  obtain ⟨c, rfl⟩ := Ideal.mem_span_singleton'.mp hs
  rw [map_mul]
  exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)

/-- **Globalization of norms of locally principal ideal sheaves.**  Let `f : Y ⟶ X` be finite
locally free, `I` an ideal sheaf on `Y` and `J` an ideal sheaf on `X`.  If every point of `X`
has an affine open neighbourhood `U` such that `I` is generated over `f⁻¹U` by some `h` and `J`
is generated over `U` by `Norm_f(h)`, then `J` is the norm of `I`. -/
theorem eq_normIdealSheaf_of_forall_exists (I : Y.IdealSheafData) (J : X.IdealSheafData)
    (H : ∀ x : X, ∃ (U : X.affineOpens) (h : Γ(Y, f ⁻¹ᵁ U.1)), x ∈ U.1 ∧
      I.ideal (preimageAffineOpen f U) = Ideal.span {h} ∧
        J.ideal U = Ideal.span {(finiteLocallyFreeNorm f).app U.1 h}) :
    J = normIdealSheaf f I := by
  choose U h hxU hI hJ using H
  refine Scheme.IdealSheafData.ext_of_iSup_eq_top U
    (top_le_iff.mp fun x _ ↦ Opens.mem_iSup.mpr ⟨x, hxU x⟩) fun x ↦ ?_
  rw [hJ x, normIdealSheaf_ideal_eq_span_of_eq_span f I (U x) (h x) (hI x)]

/-- If the sections of `𝒪_Y` over `f⁻¹V` become free after inverting `a`, then the sections over
`f⁻¹(V_a)` are free over the sections of the principal open `V_a`. -/
theorem module_free_sections_basicOpen_of_free_away {V : X.Opens} (hV : IsAffineOpen V)
    (a : Γ(X, V))
    (hfree : letI : Algebra Γ(X, V) Γ(Y, f ⁻¹ᵁ V) := (f.app V).hom.toAlgebra
      Module.Free (Localization.Away a) (LocalizedModule.Away a Γ(Y, f ⁻¹ᵁ V))) :
    letI : Algebra Γ(X, X.basicOpen a) Γ(Y, f ⁻¹ᵁ X.basicOpen a) :=
      (f.app (X.basicOpen a)).hom.toAlgebra
    Module.Free Γ(X, X.basicOpen a) Γ(Y, f ⁻¹ᵁ X.basicOpen a) := by
  let : Algebra Γ(X, V) Γ(Y, f ⁻¹ᵁ V) := (f.app V).hom.toAlgebra
  let : Algebra Γ(X, V) Γ(X, X.basicOpen a) :=
    (X.presheaf.map (homOfLE (X.basicOpen_le a)).op).hom.toAlgebra
  have : IsLocalization (.powers a) Γ(X, X.basicOpen a) := hV.isLocalization_basicOpen a
  let : Algebra Γ(Y, f ⁻¹ᵁ V) Γ(Y, Y.basicOpen (f.app V a)) :=
    (Y.presheaf.map (homOfLE (Y.basicOpen_le (f.app V a))).op).hom.toAlgebra
  let : Algebra Γ(X, V) Γ(Y, Y.basicOpen (f.app V a)) :=
    ((algebraMap Γ(Y, f ⁻¹ᵁ V) Γ(Y, Y.basicOpen (f.app V a))).comp
      (algebraMap Γ(X, V) Γ(Y, f ⁻¹ᵁ V))).toAlgebra
  have : IsScalarTower Γ(X, V) Γ(Y, f ⁻¹ᵁ V) Γ(Y, Y.basicOpen (f.app V a)) :=
    IsScalarTower.of_algebraMap_eq' rfl
  let : Algebra Γ(X, X.basicOpen a) Γ(Y, Y.basicOpen (f.app V a)) :=
    (f.appLE (X.basicOpen a) (Y.basicOpen (f.app V a))
      (Scheme.preimage_basicOpen f a).ge).hom.toAlgebra
  have : IsScalarTower Γ(X, V) Γ(X, X.basicOpen a) Γ(Y, Y.basicOpen (f.app V a)) := by
    refine IsScalarTower.of_algebraMap_eq' ?_
    have hX : f.app V ≫ Y.presheaf.map (homOfLE (Y.basicOpen_le (f.app V a))).op =
        f.appLE V (Y.basicOpen (f.app V a)) (Y.basicOpen_le (f.app V a)) := by
      rw [f.app_eq_appLE, f.appLE_map]
    have hY : X.presheaf.map (homOfLE (X.basicOpen_le a)).op ≫
        f.appLE (X.basicOpen a) (Y.basicOpen (f.app V a))
          (Scheme.preimage_basicOpen f a).ge =
        f.appLE V (Y.basicOpen (f.app V a)) (Y.basicOpen_le (f.app V a)) := by
      rw [f.map_appLE]
    simpa only [CommRingCat.hom_comp, RingHom.algebraMap_toAlgebra] using
      congrArg CommRingCat.Hom.hom (hX.trans hY.symm)
  have : IsLocalization.Away (algebraMap Γ(X, V) Γ(Y, f ⁻¹ᵁ V) a)
      Γ(Y, Y.basicOpen (f.app V a)) :=
    (IsAffineHom.isAffine_preimage V hV).isLocalization_basicOpen (f.app V a)
  have : IsLocalization (Algebra.algebraMapSubmonoid Γ(Y, f ⁻¹ᵁ V) (.powers a))
      Γ(Y, Y.basicOpen (f.app V a)) := inferInstance
  have hh := (f.appLE_congr le_rfl rfl (Scheme.preimage_basicOpen f a)
    (fun {R S} g ↦ let := g.hom.toAlgebra; Module.Free R S)).mpr
    (Stacks.Discriminant.free_of_localized_free Γ(X, V) Γ(Y, f ⁻¹ᵁ V)
      Γ(X, X.basicOpen a) Γ(Y, Y.basicOpen (f.app V a)) a hfree)
  rwa [Scheme.Hom.appLE_eq_app] at hh

/-- **Free charts of a finite locally free morphism form a basis.**  For a finite locally free
`f : Y ⟶ X`, every open neighbourhood `W` of a point `x` of the base contains an affine open
neighbourhood `U` of `x` over which `Γ(Y, f⁻¹U)` is a free `Γ(X, U)`-module. -/
theorem exists_affineOpens_mem_le_free (x : X) (W : X.Opens) (hxW : x ∈ W) :
    ∃ U : X.affineOpens, x ∈ U.1 ∧ U.1 ≤ W ∧
      letI : Algebra Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) := (f.app U.1).hom.toAlgebra
      Module.Free Γ(X, U.1) Γ(Y, f ⁻¹ᵁ U.1) := by
  obtain ⟨_, ⟨V, hV, rfl⟩, hxV, hVW⟩ :=
    X.isBasis_affineOpens.exists_subset_of_mem_open hxW W.isOpen
  let : Algebra Γ(X, V) Γ(Y, f ⁻¹ᵁ V) := (f.app V).hom.toAlgebra
  obtain ⟨_, _⟩ := module_finite_and_projective_sections f ⟨V, hV⟩
  obtain ⟨a, haV, hfree⟩ := Stacks.Discriminant.exists_away_free_at_prime Γ(X, V)
    Γ(Y, f ⁻¹ᵁ V) (hV.primeIdealOf ⟨x, hxV⟩)
  have hxa : x ∈ X.basicOpen a := by
    rw [← hV.fromSpec_image_basicOpen]
    exact ⟨hV.primeIdealOf ⟨x, hxV⟩, haV, hV.fromSpec_primeIdealOf ⟨x, hxV⟩⟩
  exact ⟨⟨X.basicOpen a, hV.basicOpen a⟩, hxa, (X.basicOpen_le a).trans hVW,
    module_free_sections_basicOpen_of_free_away f hV a hfree⟩

end Stacks.Norm

end
