module

public import Mathlib.AlgebraicGeometry.AffineSpace
public import Mathlib.AlgebraicGeometry.Morphisms.FiniteType
public import Mathlib.AlgebraicGeometry.QuasiAffine
public import Mathlib.RingTheory.Extension.Generators
public import StacksCore.Tactic.StacksAttribute

/-!
# A quasi-affine scheme of finite type over a base immerses into affine space

If `X` is quasi-affine and `π : X ⟶ S` is locally of finite type, then for some `n` there is an
immersion `X ⟶ 𝔸ⁿ_S` over `S`. This is [Stacks, Tag 04II].

## Main results

* `AlgebraicGeometry.exists_immersion_affineSpace`: the relative immersion.

## The construction

Being quasi-affine, `X` has a basis of affine opens of the form `X_r` for `r ∈ Γ(X, ⊤)`, and
being quasi-compact it is covered by finitely many of them; shrinking, each may be chosen to lie
over an affine open `V ⊆ S`. On such a chart `Γ(X, X_r)` is a finite-type `Γ(S, V)`-algebra and
a localization of `Γ(X, ⊤)` at `r`, so it is generated over `Γ(S, V)` by `r`, by `1/r`, and by
finitely many global functions: clearing denominators in a finite generating set produces
numerators in `Γ(X, ⊤)`, and the inverse of `r` is needed to recover the generators themselves.

Taking all these functions together, one per chart for `r` and finitely many more, gives a
finite family of global sections of `X`, hence a morphism `i : X ⟶ 𝔸^α_S` over `S`. Being an
immersion is Zariski-local at the target, and over the basic open `𝔸^α_S`-locus of the
coordinate belonging to the chart's `r` the preimage is exactly `X_r`, where the comparison map
of rings is the surjection just described; so `i` restricts to a closed immersion there. Finally
the index set is transported along an equivalence with `ULift (Fin n)` to put the statement in
the form of the source.

## Implementation notes

The coordinate type of `AlgebraicGeometry.AffineSpace` must live in the universe of the schemes,
so the finite index set is `ULift (Fin n)` rather than `Fin n`.

The two algebra facts the argument needs are proved here as private lemmas: that a finite-type
algebra over a localization away from one element is generated by numerators together with the
element and its inverse, and that a ring map whose image contains a generating set of the target
as an algebra is surjective.

## References

* [Stacks Project, Tag 04II](https://stacks.math.columbia.edu/tag/04II)
* [Stacks Project, Tag 01M0](https://stacks.math.columbia.edu/tag/01M0)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry

/-- A chart of the covering used in `AlgebraicGeometry.exists_immersion_affineSpace`: an affine
open `base` of the target, a global function `basic` on the source whose nonvanishing locus is
affine, and the containment making that locus lie over `base`. -/
private structure AffineBasicChart {X S : Scheme.{u}} (f : X ⟶ S) where
  base : S.Opens
  base_affine : IsAffineOpen base
  basic : Γ(X, ⊤)
  source_affine : IsAffineOpen (X.basicOpen basic)
  mapsTo : X.basicOpen basic ≤ f ⁻¹ᵁ base

/-- A quasi-affine scheme over `S` is covered by finitely many charts: the nonvanishing loci of
global functions are a basis of affine opens, the preimages of the affine opens of `S` are open,
and the space is quasi-compact. -/
private theorem exists_finite_affineBasicChart_cover
    {X S : Scheme.{u}} (f : X ⟶ S) [X.IsQuasiAffine] :
    ∃ (J : Type u) (_ : Fintype J) (c : J → AffineBasicChart f),
      ∀ x : X, ∃ j, x ∈ X.basicOpen (c j).basic := by
  classical
  let hV (x : X) : ∃ V : S.affineOpens, f x ∈ V.1 := by
    obtain ⟨_, ⟨V, hV, rfl⟩, hxV, -⟩ :=
      S.isBasis_affineOpens.exists_subset_of_mem_open (Set.mem_univ (f x)) isOpen_univ
    exact ⟨⟨V, hV⟩, hxV⟩
  let V (x : X) : S.affineOpens := Classical.choose (hV x)
  have hxV (x : X) : f x ∈ (V x).1 := Classical.choose_spec (hV x)
  let hU (x : X) : ∃ r : Γ(X, ⊤), IsAffineOpen (X.basicOpen r) ∧
      x ∈ X.basicOpen r ∧ X.basicOpen r ≤ f ⁻¹ᵁ (V x).1 := by
    obtain ⟨W, hW, hxr, hrV⟩ :=
      (Scheme.IsQuasiAffine.isBasis_basicOpen X).exists_subset_of_mem_open (hxV x)
        (f ⁻¹ᵁ (V x).1).2
    rcases hW with ⟨U, hUmem, hUW⟩
    rcases hUmem with ⟨r, hr, hUr⟩
    have hbasic : W = ((X.basicOpen r : X.Opens) : Set X) :=
      hUW.symm.trans (congrArg (fun Z : X.Opens => (Z : Set X)) hUr.symm)
    exact ⟨r, hr, by simpa [hbasic] using hxr,
      SetLike.coe_subset_coe.mp (hbasic ▸ hrV)⟩
  let c : X → AffineBasicChart f := fun x =>
    ⟨(V x).1, (V x).2, Classical.choose (hU x),
      (Classical.choose_spec (hU x)).1, (Classical.choose_spec (hU x)).2.2⟩
  obtain ⟨t, ht⟩ := isCompact_univ.elim_finite_subcover
    (fun x => (X.basicOpen (c x).basic : Set X))
    (fun x => (X.basicOpen (c x).basic).2) (by
      intro x _
      exact Set.mem_iUnion.mpr ⟨x, (Classical.choose_spec (hU x)).2.1⟩)
  let J := {x // x ∈ t}
  let _ : Fintype J := Fintype.ofFinite J
  refine ⟨J, inferInstance, fun x => c x.1, ?_⟩
  intro x
  rcases Set.mem_iUnion₂.mp (ht (Set.mem_univ x)) with ⟨y, hyt, hxy⟩
  exact ⟨⟨y, hyt⟩, hxy⟩

/-- A finite type algebra after inverting one element is generated by finitely many
numerators together with the inverted element and its inverse. -/
private theorem exists_generators_away_by_numerators
    {R A B : Type u} [CommRing R] [CommRing A] [CommRing B]
    [Algebra R B] [Algebra A B]
    (f : A) [IsLocalization.Away f B] [Algebra.FiniteType R B] :
    ∃ (n : ℕ) (a : Fin n → A),
      Algebra.adjoin R
        (Set.range (fun i => algebraMap A B (a i)) ∪
          {algebraMap A B f, IsLocalization.Away.invSelf f}) = ⊤ := by
  obtain ⟨n, ⟨P⟩⟩ :=
    (Algebra.FiniteType.iff_exists_generators (R := R) (S := B)).mp inferInstance
  choose k hk using fun i : Fin n => IsLocalization.Away.surj f (P.val i)
  choose a ha using hk
  let C := Algebra.adjoin R
    (Set.range (fun i => algebraMap A B (a i)) ∪
      {algebraMap A B f, IsLocalization.Away.invSelf f})
  have hgen : ∀ i, P.val i ∈ C := by
    intro i
    have haC : algebraMap A B (a i) ∈ C := Algebra.subset_adjoin (Set.mem_union_left _ ⟨i, rfl⟩)
    have hinvC : IsLocalization.Away.invSelf f ∈ C :=
      Algebra.subset_adjoin (Set.mem_union_right _ (Set.mem_insert_of_mem _ rfl))
    have hk := ha i
    have heq : P.val i = algebraMap A B (a i) * IsLocalization.Away.invSelf f ^ (k i) := calc
      P.val i = P.val i * (algebraMap A B f * IsLocalization.Away.invSelf f) ^ (k i) := by
        simp [IsLocalization.Away.mul_invSelf]
      _ = algebraMap A B (a i) * IsLocalization.Away.invSelf f ^ (k i) := by
        rw [mul_pow, ← mul_assoc, hk]
    rw [heq]
    exact C.mul_mem haC (C.pow_mem hinvC (k i))
  have hD : Algebra.adjoin R (Set.range P.val) = ⊤ := by
    rw [Algebra.adjoin_range_eq_range_aeval]
    exact (AlgHom.range_eq_top _).2 P.aeval_val_surjective
  exact ⟨n, a, le_antisymm le_top (by
    rw [← hD]
    exact Algebra.adjoin_le (Set.range_subset_iff.mpr hgen))⟩

/-- A ring map compatible with the base whose image contains a set generating the target as an
algebra over that base is surjective. -/
private theorem surjective_of_adjoin_eq_top_of_range
    {R B C : Type u} [CommRing R] [CommRing B] [CommRing C]
    [Algebra R B] [Algebra R C]
    (φ : C →+* B) (hscalar : ∀ r, φ (algebraMap R C r) = algebraMap R B r)
    (s : Set B) (hs : Algebra.adjoin R s = ⊤)
    (hrange : ∀ x ∈ s, x ∈ Set.range φ) : Function.Surjective φ := by
  let ψ : C →ₐ[R] B := { toRingHom := φ, commutes' := hscalar }
  exact fun x => ψ.mem_range.mp (Algebra.adjoin_le (fun y hy => ψ.mem_range.mpr (hrange y hy))
    (Algebra.eq_top_iff.mp hs x))

/-- **Stacks Project, Tag 04II.** A quasi-affine scheme locally of finite type over `S` admits,
over `S`, an immersion into a finite-dimensional relative affine space. -/
@[stacks 04II]
theorem exists_immersion_affineSpace
    {X S : Scheme.{u}} (f : X ⟶ S) [X.IsQuasiAffine] [LocallyOfFiniteType f] :
    ∃ (n : ℕ) (i : X ⟶ AffineSpace (ULift.{u} (Fin n)) S),
      IsImmersion i ∧ i ≫ (AffineSpace (ULift.{u} (Fin n)) S ↘ S) = f := by
  classical
  obtain ⟨J, hJ, c, hcover⟩ := exists_finite_affineBasicChart_cover f
  let _ : Fintype J := hJ
  let B (j : J) := Γ(X, X.basicOpen (c j).basic)
  let A := Γ(X, ⊤)
  let _algB (j : J) : Algebra (Γ(S, (c j).base)) (B j) :=
    (f.appLE (c j).base (X.basicOpen (c j).basic) (c j).mapsTo).hom.toAlgebra
  let _algBft (j : J) : Algebra.FiniteType (Γ(S, (c j).base)) (B j) :=
    f.finiteType_appLE (c j).base_affine (c j).source_affine (c j).mapsTo
  let _algAB (j : J) : Algebra A (B j) :=
    (X.presheaf.map (homOfLE (X.basicOpen_le (c j).basic)).op).hom.toAlgebra
  let _locB (j : J) : IsLocalization.Away (c j).basic (B j) :=
    isLocalization_basicOpen_of_qcqs isCompact_univ isQuasiSeparated_univ (c j).basic
  have hgens (j : J) :=
    exists_generators_away_by_numerators (R := Γ(S, (c j).base))
      (A := A) (B := B j) (c j).basic
  choose n a hgen using hgens
  let α := Σ j : J, Fin (n j + 1)
  let coord : α → Γ(X, ⊤) := fun z =>
    Fin.cases (c z.1).basic (a z.1) z.2
  let i0 : X ⟶ AffineSpace α S := AffineSpace.homOfVector f coord
  let count := Fintype.card α
  let idx : α ≃ ULift.{u} (Fin count) :=
    (Fintype.equivFin α).trans (Equiv.ulift.{u, 0}.symm)
  let ek : ULift.{u, 0} (Fin count) ≃ α := idx.symm
  let e : AffineSpace α S ≅ AffineSpace (ULift.{u, 0} (Fin count)) S :=
    (AffineSpace.functor.mapIso ek.toIso.op).app S
  let Y := AffineSpace α S
  let π : Y ⟶ S := (AffineSpace.over α S).hom
  have : IsAffineHom π := by change IsAffineHom (AffineSpace α S ↘ S); infer_instance
  have hproj : i0 ≫ π = f := AffineSpace.homOfVector_over f coord
  let O (j : J) : Y.Opens := π ⁻¹ᵁ (c j).base
  have hO (j : J) : IsAffineOpen (O j) := (c j).base_affine.preimage π
  let k (j : J) : α := ⟨j, 0⟩
  let q (z : α) : Γ(Y, ⊤) := AffineSpace.coord S z
  let qj (j : J) : Γ(Y, ⊤) := q (k j)
  let qO (j : J) : Γ(Y, O j) :=
    Y.presheaf.map (homOfLE (le_top : O j ≤ ⊤)).op (qj j)
  let W (j : J) : Y.Opens := Y.basicOpen (qO j)
  have hW (j : J) : IsAffineOpen (W j) := (hO j).basicOpen (qO j)
  have hbaseW (j : J) : W j ≤ π ⁻¹ᵁ (c j).base :=
    Scheme.basicOpen_le Y (qO j)
  let _algW (j : J) : Algebra (Γ(S, (c j).base)) (Γ(Y, W j)) :=
    (π.appLE (c j).base (W j) (hbaseW j)).hom.toAlgebra
  let _locW (j : J) : IsLocalization.Away (qO j) (Γ(Y, W j)) :=
    (hO j).isLocalization_basicOpen (qO j)
  have hcoord (j : J) : (i0.appTop).hom (qj j) = (c j).basic := by
    simp [qj, q, k, i0, coord]
  have hpreCoord (j : J) : i0 ⁻¹ᵁ Y.basicOpen (qj j) = X.basicOpen (c j).basic := by
    rw [Scheme.Hom.preimage_basicOpen_top, hcoord]
  have hW_eq (j : J) : W j = O j ⊓ Y.basicOpen (qj j) :=
    Scheme.basicOpen_res Y (qj j) (homOfLE (le_top : O j ≤ ⊤)).op
  have hpreW (j : J) : i0 ⁻¹ᵁ W j = X.basicOpen (c j).basic := by
    rw [hW_eq, Scheme.Hom.preimage_inf, hpreCoord]
    exact inf_eq_right.mpr (by
      change X.basicOpen (c j).basic ≤ i0 ⁻¹ᵁ (π ⁻¹ᵁ (c j).base)
      rw [← Scheme.Hom.comp_preimage, hproj]
      exact (c j).mapsTo)
  have hUW (j : J) : X.basicOpen (c j).basic ≤ i0 ⁻¹ᵁ W j :=
    le_of_eq (hpreW j).symm
  let coordW (j : J) (z : α) : Γ(Y, W j) :=
    Y.presheaf.map (homOfLE (le_top : W j ≤ ⊤)).op (q z)
  have hcoordTop (j : J) (z : α) :
      (i0.appLE ⊤ (X.basicOpen (c j).basic) (by simp)).hom (q z) =
        algebraMap A (B j) (coord z) := by
    change (X.presheaf.map (homOfLE (X.basicOpen_le (c j).basic)).op).hom
        ((i0.appTop).hom (q z)) =
      (X.presheaf.map (homOfLE (X.basicOpen_le (c j).basic)).op).hom (coord z)
    simp [i0, q]
  have hcoordW (j : J) (z : α) :
      (i0.appLE (W j) (X.basicOpen (c j).basic) (hUW j)).hom (coordW j z) =
        algebraMap A (B j) (coord z) :=
    (DFunLike.congr_fun (congrArg CommRingCat.Hom.hom
      (i0.map_appLE (hUW j) (homOfLE (show W j ≤ (⊤ : Y.Opens) from le_top)).op))
      (q z)).trans (hcoordTop j z)
  have hfactor (j : J) :
      π.appLE (c j).base (W j) (hbaseW j) ≫
        i0.appLE (W j) (X.basicOpen (c j).basic) (hUW j) =
      f.appLE (c j).base (X.basicOpen (c j).basic) (c j).mapsTo := by
    simpa [hproj] using Scheme.Hom.appLE_comp_appLE i0 π (c j).base (W j)
      (X.basicOpen (c j).basic) (hbaseW j) (hUW j)
  have hImm0 : IsImmersion i0 := by
    let _ : MorphismProperty.RespectsRight @IsImmersion @IsOpenImmersion :=
      ⟨fun g hg f hf => by
        let _ : IsImmersion g := inferInstance
        exact IsImmersion.comp f g⟩
    let _ : MorphismProperty.HasOfPostcompProperty @IsImmersion @IsOpenImmersion :=
      MorphismProperty.HasOfPostcompProperty.of_le @IsImmersion ⊤
        (by intro X Y f hf; trivial)
    apply IsZariskiLocalAtTarget.of_forall_source_exists_preimage i0
    intro x
    obtain ⟨j, hxj⟩ := hcover x
    refine ⟨W j, ?_, ?_⟩
    · change x ∈ i0 ⁻¹ᵁ W j; rw [hpreW j]; exact hxj
    · rw [hpreW j]
      let g := i0.resLE (W j) (X.basicOpen (c j).basic) (hUW j)
      let φ := (i0.appLE (W j) (X.basicOpen (c j).basic) (hUW j)).hom
      have hscalar : ∀ r : Γ(S, (c j).base),
          φ (algebraMap (Γ(S, (c j).base)) (Γ(Y, W j)) r) =
            algebraMap (Γ(S, (c j).base)) (B j) r :=
        fun r => DFunLike.congr_fun (congrArg CommRingCat.Hom.hom (hfactor j)) r
      have hcoordφ (z : α) : φ (coordW j z) = algebraMap A (B j) (coord z) := hcoordW j z
      have hbasicφ : φ (coordW j (k j)) = algebraMap A (B j) (c j).basic := by
        simpa [coord, k] using hcoordφ (k j)
      have hrange : ∀ z ∈ Set.range (fun z : Fin (n j) => algebraMap A (B j) (a j z)) ∪
            {algebraMap A (B j) (c j).basic,
              IsLocalization.Away.invSelf (c j).basic},
          z ∈ Set.range φ := by
        intro z hz
        rcases hz with hz | hz
        · rcases Set.mem_range.mp hz with ⟨w, rfl⟩
          exact ⟨coordW j ⟨j, Fin.succ w⟩, by simpa [coord] using hcoordφ ⟨j, Fin.succ w⟩⟩
        · rcases Set.mem_insert_iff.mp hz with hbasic | hinv
          · subst z
            exact ⟨coordW j (k j), hbasicφ⟩
          · rcases Set.mem_singleton_iff.mp hinv with rfl
            let _ : Algebra (Γ(Y, O j)) (Γ(Y, W j)) :=
              (Y.presheaf.map (homOfLE (hbaseW j)).op).hom.toAlgebra
            let t : Γ(Y, W j) := IsLocalization.Away.invSelf (qO j)
            have hq : φ (algebraMap (Γ(Y, O j)) (Γ(Y, W j)) (qO j)) =
                algebraMap A (B j) (c j).basic := by
              have hrestrict : algebraMap (Γ(Y, O j)) (Γ(Y, W j)) (qO j) =
                  coordW j (k j) := by
                change (Y.presheaf.map (homOfLE (hbaseW j)).op).hom
                    ((Y.presheaf.map (homOfLE (le_top : O j ≤ ⊤)).op).hom (qj j)) =
                  (Y.presheaf.map (homOfLE (le_top : W j ≤ ⊤)).op).hom (qj j)
                rw [← CommRingCat.comp_apply, ← Functor.map_comp]
                rfl
              rw [hrestrict, hbasicφ]
            have hinvmap : φ t = IsLocalization.Away.invSelf (c j).basic := by
              have hprod : algebraMap A (B j) (c j).basic * φ t = 1 := by
                calc
                  algebraMap A (B j) (c j).basic * φ t =
                      φ (algebraMap (Γ(Y, O j)) (Γ(Y, W j)) (qO j) * t) := by
                        rw [map_mul, hq]
                  _ = 1 := by rw [IsLocalization.Away.mul_invSelf, map_one]
              exact left_inv_eq_right_inv (by rwa [mul_comm])
                (IsLocalization.Away.mul_invSelf (c j).basic)
            exact ⟨t, hinvmap⟩
      have hsurj : Function.Surjective φ :=
        surjective_of_adjoin_eq_top_of_range φ hscalar _ (hgen j) hrange
      have : IsAffine ((W j).toScheme) := hW j
      have : IsAffine ((X.basicOpen (c j).basic).toScheme) := (c j).source_affine
      let _ : IsClosedImmersion g :=
        IsClosedImmersion.of_surjective_of_isAffine g
          ((RingHom.surjective_respectsIso.arrow_mk_iso_iff
            (arrowResLEAppIso i0 (W j) (X.basicOpen (c j).basic) (hUW j))).mpr hsurj)
      rw [← Scheme.Hom.resLE_comp_ι i0 (hUW j)]
      infer_instance
  refine ⟨count, i0 ≫ e.hom, ?_, ?_⟩
  · let _ : IsImmersion i0 := hImm0
    infer_instance
  · change i0 ≫ AffineSpace.reindex (ek.toIso.hom) S ≫
      (AffineSpace.over (ULift.{u, 0} (Fin count)) S).hom = f
    have hp : AffineSpace.reindex (ek.toIso.hom) S ≫
        (AffineSpace.over (ULift.{u, 0} (Fin count)) S).hom =
          (AffineSpace.over α S).hom := AffineSpace.reindex_over _ _
    rw [hp, hproj]

end AlgebraicGeometry

end
