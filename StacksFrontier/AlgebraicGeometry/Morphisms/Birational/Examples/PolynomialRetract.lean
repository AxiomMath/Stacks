module

public import Mathlib.RingTheory.MvPolynomial.Ideal
public import Mathlib.RingTheory.Localization.FractionRing
public import Mathlib.RingTheory.Spectrum.Prime.Homeomorph
public import StacksCore.Tactic.StacksAttribute

/-!
# A polynomial ring retract with infinitely many square-zero elements

Let `k` be a commutative ring, `A = k[x]`, and let `B` be the quotient of
`k[x, y_a | a ∈ k]` by the relations `(x - a) y_a = 0` and `y_a y_b = 0`. Setting every `y_a`
to zero retracts `B` onto `A`, so `A` includes into `B` and the kernel of the retraction is
square-zero. Consequently the inclusion induces a homeomorphism of spectra, and localizing `B`
at the generic point recovers the rational function field `k(x)`.

This is the ring theory behind Stacks Example 29.50.4, whose point is that `Spec B ⟶ Spec A`
is birational without being an isomorphism over any nonempty open.

## Main definitions

* `AlgebraicGeometry.PolynomialRetract.baseRing` is `k[x]`, and
  `AlgebraicGeometry.PolynomialRetract.extensionRing` the displayed quotient.
* `AlgebraicGeometry.PolynomialRetract.inclusionMap` and `.retractionMap` are the canonical
  maps between them.
* `AlgebraicGeometry.PolynomialRetract.projectionKernel` is the kernel of the retraction, and
  `.genericLocalizationEquiv` identifies the localization there with `k(x)`.

## Main results

* `AlgebraicGeometry.PolynomialRetract.retractionMap_comp_inclusionMap` and
  `.inclusionMap_injective`: the two maps exhibit `A` as a retract of `B`.
* `AlgebraicGeometry.PolynomialRetract.projectionKernel_sq`: the kernel is square-zero.
* `AlgebraicGeometry.PolynomialRetract.isHomeomorph_comap_inclusionMap`: the induced map on
  spectra is a homeomorphism.
* `AlgebraicGeometry.PolynomialRetract.genericLocalizationEquiv_map`: that identification is
  induced by the retraction, hence canonical over `k[x]`.

## Implementation notes

A polynomial ring in one variable is realized as `MvPolynomial Unit k`. In the larger
polynomial ring the variables are indexed by `Unit ⊕ k`: the left variable is `x` and the right
variables are the `y_a`. The generic point is represented by the kernel of the retraction, and
`FractionRing (MvPolynomial Unit k)` represents `k(x)`.

## References

* [Stacks Project, Tag 01RQ](https://stacks.math.columbia.edu/tag/01RQ), Example 29.50.4
-/

@[expose] public section

universe u

namespace AlgebraicGeometry.PolynomialRetract

variable (k : Type*) [CommRing k]

/-- The ring `k[x]`, represented as a multivariate polynomial ring on one variable. -/
abbrev baseRing := MvPolynomial Unit k

/-- The ideal generated by `(x - a)y_a` and `y_a y_b`, for `a, b ∈ k`. -/
noncomputable def relationIdeal : Ideal (MvPolynomial (Unit ⊕ k) k) :=
  Ideal.span
    (Set.range (fun a : k =>
        (MvPolynomial.X (Sum.inl ()) - MvPolynomial.C a) * MvPolynomial.X (Sum.inr a)) ∪
      Set.range (fun ab : k × k =>
        MvPolynomial.X (Sum.inr ab.1) * MvPolynomial.X (Sum.inr ab.2)))

/-- The ring `k[x, {y_a}]/((x-a)y_a, y_a y_b)`. -/
abbrev extensionRing :=
  MvPolynomial (Unit ⊕ k) k ⧸ relationIdeal k

/-- The canonical map from `k[x]` to the displayed quotient ring. -/
noncomputable def inclusionMap : baseRing k →+* extensionRing k :=
  (Ideal.Quotient.mk (relationIdeal k)).comp
    (MvPolynomial.rename (R := k) (Sum.inl : Unit → Unit ⊕ k))

/-- The homomorphism which fixes `x` and sends every `y_a` to zero. -/
noncomputable def retractionMap : extensionRing k →+* baseRing k :=
  Ideal.Quotient.lift (relationIdeal k)
    (MvPolynomial.eval₂Hom MvPolynomial.C (Sum.elim (fun _ => MvPolynomial.X ()) (fun _ => 0)))
    (by
      change relationIdeal k ≤ RingHom.ker
        (MvPolynomial.eval₂Hom MvPolynomial.C
          (Sum.elim (fun _ => MvPolynomial.X ()) (fun _ => 0)))
      rw [relationIdeal]
      apply Ideal.span_le.2
      rintro f (hf | hf)
      · obtain ⟨a, rfl⟩ := hf
        simp
      · obtain ⟨⟨a, b⟩, rfl⟩ := hf
        simp)

/-- Setting every `y_a` to zero is a retraction of the canonical inclusion of `k[x]`. -/
@[stacks 01RQ "ring_maps"]
theorem retractionMap_comp_inclusionMap :
    (retractionMap k).comp (inclusionMap k) = RingHom.id (baseRing k) := by
  ext <;> simp [inclusionMap, retractionMap]

/-- The retraction fixes every element of `k[x]`. -/
private theorem retractionMap_inclusionMap (a : baseRing k) :
    retractionMap k (inclusionMap k a) = a :=
  RingHom.congr_fun (retractionMap_comp_inclusionMap k) a

/-- The canonical map from `k[x]` to the quotient ring is injective, being a section of the
retraction. -/
@[stacks 01RQ "ring_maps"]
theorem inclusionMap_injective : Function.Injective (inclusionMap k) := by
  intro x y h
  simpa only [retractionMap_inclusionMap] using congrArg (retractionMap k) h



section General

variable (k : Type*) [CommRing k]

private noncomputable def nilVariableIdeal : Ideal (MvPolynomial (Unit ⊕ k) k) :=
  Ideal.span (Set.range (fun a : k => MvPolynomial.X (Sum.inr a)))

/-- Every polynomial agrees, modulo the ideal generated by the square-zero variables, with the
polynomial in `x` alone obtained by discarding them. -/
private lemma polynomial_sub_rename_killCompl_mem (p : MvPolynomial (Unit ⊕ k) k) :
    p - MvPolynomial.rename (R := k) (Sum.inl : Unit → Unit ⊕ k)
      (MvPolynomial.killCompl (R := k)
        (Sum.inl_injective : Function.Injective (Sum.inl : Unit → Unit ⊕ k)) p)
      ∈ nilVariableIdeal k := by
  classical
  let f : Unit → Unit ⊕ k := Sum.inl
  let hf : Function.Injective f := Sum.inl_injective
  let κ : MvPolynomial (Unit ⊕ k) k →ₐ[k] MvPolynomial Unit k :=
    MvPolynomial.killCompl hf
  let ρ : MvPolynomial Unit k →+* MvPolynomial (Unit ⊕ k) k :=
    (MvPolynomial.rename f).toRingHom
  have hC (a : k) : (MvPolynomial.C a : MvPolynomial (Unit ⊕ k) k) -
      ρ (κ (MvPolynomial.C a)) ∈ nilVariableIdeal k := by simp [ρ, κ, nilVariableIdeal]
  have hmul (q : MvPolynomial (Unit ⊕ k) k) (i : Unit ⊕ k)
      (hq : q - ρ (κ q) ∈ nilVariableIdeal k) :
      q * MvPolynomial.X i - ρ (κ (q * MvPolynomial.X i)) ∈ nilVariableIdeal k := by
    cases i with
    | inl u =>
        have hκ : κ (q * MvPolynomial.X (Sum.inl u)) = κ q * MvPolynomial.X u := by
          simp [κ, MvPolynomial.killCompl, f]
        have hρ : ρ (MvPolynomial.X u) = MvPolynomial.X (Sum.inl u) := by
          simp [ρ, f]
        rw [hκ, map_mul, hρ, show q * MvPolynomial.X (Sum.inl u) -
            ρ (κ q) * MvPolynomial.X (Sum.inl u) =
            MvPolynomial.X (Sum.inl u) * (q - ρ (κ q)) by ring]
        exact (nilVariableIdeal k).mul_mem_left (MvPolynomial.X (Sum.inl u)) hq
    | inr a =>
        have hκ : κ (q * MvPolynomial.X (Sum.inr a)) = 0 := by
          simp [κ, MvPolynomial.killCompl, f]
        rw [hκ, map_zero, sub_zero]
        exact (nilVariableIdeal k).mul_mem_left _ <|
          Ideal.subset_span ⟨a, rfl⟩
  have h : ∀ q : MvPolynomial (Unit ⊕ k) k,
      q - ρ (κ q) ∈ nilVariableIdeal k := by
    intro q
    induction q using MvPolynomial.induction_on with
    | C a => exact hC a
    | add q r hq hr =>
        convert (nilVariableIdeal k).add_mem hq hr using 1
        simp only [map_add]
        ring
    | mul_X q i hq => exact hmul q i hq
  simpa [κ, ρ, f] using h p

/-- On polynomials, the retraction is the algebra map that discards the square-zero variables. -/
private lemma retraction_polynomial_eq_killCompl (p : MvPolynomial (Unit ⊕ k) k) :
    MvPolynomial.eval₂Hom MvPolynomial.C
      (Sum.elim (fun _ : Unit => MvPolynomial.X ()) (fun _ : k => 0)) p =
      MvPolynomial.killCompl (R := k)
        (Sum.inl_injective : Function.Injective (Sum.inl : Unit → Unit ⊕ k)) p := by
  classical
  let κ : MvPolynomial (Unit ⊕ k) k →+* MvPolynomial Unit k :=
    (MvPolynomial.killCompl
      (Sum.inl_injective : Function.Injective (Sum.inl : Unit → Unit ⊕ k))).toRingHom
  have h : MvPolynomial.eval₂Hom MvPolynomial.C
      (Sum.elim (fun _ : Unit => MvPolynomial.X ()) (fun _ : k => 0)) = κ := by
    apply MvPolynomial.ringHom_ext'
    · ext a
      simp [κ]
    · rintro (u | a) <;> simp [κ, MvPolynomial.killCompl]
  exact DFunLike.congr_fun h p

/-- A polynomial killed by the retraction lies in the ideal generated by the square-zero
variables. -/
private lemma retraction_kernel_rep_mem_nilVariableIdeal (p : MvPolynomial (Unit ⊕ k) k)
    (hp : MvPolynomial.eval₂Hom MvPolynomial.C
      (Sum.elim (fun _ : Unit => MvPolynomial.X ()) (fun _ : k => 0)) p = 0) :
    p ∈ nilVariableIdeal k := by
  have hkill : MvPolynomial.killCompl (R := k)
      (Sum.inl_injective : Function.Injective (Sum.inl : Unit → Unit ⊕ k)) p = 0 := by
    rw [← retraction_polynomial_eq_killCompl (k := k) p, hp]
  simpa [hkill] using polynomial_sub_rename_killCompl_mem (k := k) p

/-- A representative of an element of the retraction kernel lies in the ideal generated by the
square-zero variables. -/
private lemma mem_nilVariableIdeal_of_mk_mem_projectionKernel (p : MvPolynomial (Unit ⊕ k) k)
    (hp : Ideal.Quotient.mk (relationIdeal k) p ∈ RingHom.ker (retractionMap k)) :
    p ∈ nilVariableIdeal k :=
  retraction_kernel_rep_mem_nilVariableIdeal k p
    (by simpa [RingHom.mem_ker, retractionMap] using hp)

/-- The square of the ideal generated by the square-zero variables lies in the relation ideal. -/
private lemma nilVariableIdeal_sq_le_relationIdeal :
    nilVariableIdeal k ^ 2 ≤ relationIdeal k := by
  rw [pow_two, nilVariableIdeal, Ideal.span_mul_span]
  refine Ideal.span_le.2 ?_
  rintro z ⟨x, ⟨a, rfl⟩, y, ⟨b, rfl⟩, rfl⟩
  exact Ideal.subset_span (Or.inr ⟨(a, b), rfl⟩)

/-- The ideal generated by the square-zero variables in the larger ring. -/
noncomputable abbrev projectionKernel : Ideal (extensionRing k) :=
  RingHom.ker (retractionMap k)

/-- The kernel of the retraction has square zero. -/
theorem projectionKernel_sq : projectionKernel k ^ 2 = ⊥ := by
  refine le_antisymm ?_ bot_le
  rw [pow_two, Ideal.mul_le]
  intro b hb c hc
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective b
  obtain ⟨q, rfl⟩ := Ideal.Quotient.mk_surjective c
  have hpq : p * q ∈ relationIdeal k :=
    nilVariableIdeal_sq_le_relationIdeal (k := k) <| by
      rw [pow_two]
      exact Ideal.mul_mem_mul (mem_nilVariableIdeal_of_mk_mem_projectionKernel k p hb)
        (mem_nilVariableIdeal_of_mk_mem_projectionKernel k q hc)
  rw [Ideal.mem_bot, ← map_mul]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hpq

/-- Every element of the retraction kernel is nilpotent, its square being zero. -/
private lemma projectionKernel_le_nilradical :
    projectionKernel k ≤ nilradical (extensionRing k) := by
  intro b hb
  rw [mem_nilradical]
  refine ⟨2, ?_⟩
  have h : b ^ 2 ∈ projectionKernel k ^ 2 := by
    simpa [pow_two] using Ideal.mul_mem_mul hb hb
  rw [projectionKernel_sq] at h
  exact Ideal.mem_bot.mp h

/-- The inclusion of the polynomial ring induces a homeomorphism on spectra. -/
theorem isHomeomorph_comap_inclusionMap :
    IsHomeomorph (PrimeSpectrum.comap (inclusionMap k)) := by
  let f := retractionMap k
  have hsurj : Function.Surjective f := fun a => ⟨inclusionMap k a, retractionMap_inclusionMap k a⟩
  have hpow : ∀ a : baseRing k, ∃ n > 0, a ^ n ∈ f.range := by
    intro a
    obtain ⟨b, hb⟩ := hsurj a
    exact ⟨1, by omega, b, by simp [hb]⟩
  have hret : IsHomeomorph (PrimeSpectrum.comap f) :=
    PrimeSpectrum.isHomeomorph_comap f hpow (projectionKernel_le_nilradical (k := k))
  let H := hret.homeomorph
  have hleft : (PrimeSpectrum.comap (inclusionMap k)).comp
      (PrimeSpectrum.comap f) = id := by
    rw [← PrimeSpectrum.comap_comp]
    simp only [f, retractionMap_comp_inclusionMap]
    funext x
    rfl
  have heq : PrimeSpectrum.comap (inclusionMap k) = H.symm := by
    funext x
    obtain ⟨a, rfl⟩ := H.surjective x
    calc
      PrimeSpectrum.comap (inclusionMap k) (H a) = a := by
        simpa [H, f] using congrFun hleft a
      _ = H.symm (H a) := by simp
  rw [heq]
  exact H.symm.isHomeomorph

end General

section Field

variable (k : Type*) [Field k]

/-- The kernel is prime because the polynomial-ring retract is a domain. -/
noncomputable instance projectionKernel_isPrime : (projectionKernel k).IsPrime :=
  RingHom.ker_isPrime (retractionMap k)

/-- The map from the prime localization induced by the retraction. -/
noncomputable def localizationToFraction :
    Localization.AtPrime (projectionKernel k) →+* FractionRing (baseRing k) :=
  IsLocalization.map (M := (projectionKernel k).primeCompl)
    (T := nonZeroDivisors (baseRing k)) (FractionRing (baseRing k))
    (retractionMap k) (by
      intro s hs
      change retractionMap k s ∈ nonZeroDivisors (baseRing k)
      exact mem_nonZeroDivisors_iff_ne_zero.mpr fun h => hs h)

/-- The map from the fraction field induced by the inclusion. -/
noncomputable def fractionToLocalization :
    FractionRing (baseRing k) →+* Localization.AtPrime (projectionKernel k) :=
  IsLocalization.map (M := nonZeroDivisors (baseRing k))
    (T := (projectionKernel k).primeCompl)
    (Localization.AtPrime (projectionKernel k)) (inclusionMap k) (by
    intro s hs
    change inclusionMap k s ∈ (projectionKernel k).primeCompl
    change inclusionMap k s ∉ projectionKernel k
    intro h
    have hr : retractionMap k (inclusionMap k s) = 0 := by
      simpa [projectionKernel, RingHom.mem_ker] using h
    have heq := congrArg (fun g : baseRing k →+* baseRing k => g s)
      (retractionMap_comp_inclusionMap k)
    have hs' : s = 0 := by simpa using heq.symm.trans hr
    exact (mem_nonZeroDivisors_iff_ne_zero.mp hs) hs'
    )

/-- The polynomial `x - a` is nonzero. -/
private lemma X_sub_C_ne_zero (a : k) :
    MvPolynomial.X () - MvPolynomial.C a ≠ (0 : baseRing k) := by
  intro h
  have hcoeff := congrArg (fun q : baseRing k => q.coeff (Finsupp.single () 1)) h
  have hsingle : Finsupp.single () 1 ≠ (0 : Unit →₀ ℕ) := Finsupp.single_ne_zero.mpr one_ne_zero
  have : (1 : k) = 0 := by
    simp [MvPolynomial.coeff_C_of_ne_zero hsingle] at hcoeff
  exact one_ne_zero this

/-- Each square-zero variable `y_a` vanishes in the prime localization, being killed by the
unit `x - a`. -/
private lemma algebraMap_mk_X_inr_eq_zero (a : k) :
    algebraMap (extensionRing k) (Localization.AtPrime (projectionKernel k))
      (Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X (Sum.inr a))) = 0 := by
  let d : extensionRing k := Ideal.Quotient.mk (relationIdeal k)
    (MvPolynomial.X (Sum.inl ()) - MvPolynomial.C a)
  have hd : d ∉ projectionKernel k := by
    intro hd
    have hz : retractionMap k d = 0 := by
      simpa [projectionKernel, RingHom.mem_ker] using hd
    have hz' : MvPolynomial.X () - MvPolynomial.C a = 0 := by
      simpa [d, retractionMap] using hz
    exact X_sub_C_ne_zero k a hz'
  have hu : IsUnit (algebraMap (extensionRing k)
      (Localization.AtPrime (projectionKernel k)) d) :=
    (IsLocalization.AtPrime.isUnit_to_map_iff
      (S := Localization.AtPrime (projectionKernel k))
      (I := projectionKernel k) d).2 hd
  have hrel : d * Ideal.Quotient.mk (relationIdeal k) (MvPolynomial.X (Sum.inr a)) = 0 := by
    change Ideal.Quotient.mk (relationIdeal k)
      ((MvPolynomial.X (Sum.inl ()) - MvPolynomial.C a) * MvPolynomial.X (Sum.inr a)) = 0
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span (Or.inl ⟨a, rfl⟩))
  have hloc := congrArg (algebraMap (extensionRing k)
    (Localization.AtPrime (projectionKernel k))) hrel
  exact hu.mul_left_cancel (by simpa using hloc)

/-- The ideal generated by the square-zero variables vanishes in the prime localization. -/
private lemma algebraMap_mk_eq_zero_of_mem_nilVariableIdeal {q : MvPolynomial (Unit ⊕ k) k}
    (hq : q ∈ nilVariableIdeal k) :
    algebraMap (extensionRing k) (Localization.AtPrime (projectionKernel k))
      (Ideal.Quotient.mk (relationIdeal k) q) = 0 := by
  unfold nilVariableIdeal at hq
  induction hq using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨a, rfl⟩ := hx
      exact algebraMap_mk_X_inr_eq_zero k a
  | zero => simp
  | add x y _ _ hx hy =>
      change algebraMap (extensionRing k) (Localization.AtPrime (projectionKernel k))
        ((Ideal.Quotient.mk (relationIdeal k) x) +
          (Ideal.Quotient.mk (relationIdeal k) y)) = 0
      rw [map_add, hx, hy]
      simp
  | smul c x _ hx =>
      change algebraMap (extensionRing k) (Localization.AtPrime (projectionKernel k))
        ((Ideal.Quotient.mk (relationIdeal k) c) *
          (Ideal.Quotient.mk (relationIdeal k) x)) = 0
      rw [map_mul, hx]
      simp

/-- Every element of the retraction kernel vanishes in its prime localization. -/
lemma localization_algebraMap_sub_retraction_zero (b : extensionRing k)
    (hb : b ∈ projectionKernel k) :
    algebraMap (extensionRing k) (Localization.AtPrime (projectionKernel k)) b = 0 := by
  obtain ⟨p, rfl⟩ := Ideal.Quotient.mk_surjective b
  exact algebraMap_mk_eq_zero_of_mem_nilVariableIdeal k
    (mem_nilVariableIdeal_of_mk_mem_projectionKernel k p hb)

/-- The localization maps compose to the identity on the fraction field. -/
lemma localization_retraction_section_comp :
    (localizationToFraction k).comp (fractionToLocalization k) =
      RingHom.id (FractionRing (baseRing k)) := by
  apply IsFractionRing.ringHom_ext (A := baseRing k)
  intro a
  simp [localizationToFraction, fractionToLocalization, RingHom.comp_apply,
    retractionMap_inclusionMap]

/-- The localization maps compose to the identity on the prime localization. -/
lemma localization_section_retraction_comp :
    (fractionToLocalization k).comp (localizationToFraction k) =
      RingHom.id (Localization.AtPrime (projectionKernel k)) := by
  apply IsLocalization.ringHom_ext (M := (projectionKernel k).primeCompl)
  apply RingHom.ext
  intro b
  change fractionToLocalization k
      (localizationToFraction k (algebraMap (extensionRing k)
        (Localization.AtPrime (projectionKernel k)) b)) =
        algebraMap (extensionRing k) (Localization.AtPrime (projectionKernel k)) b
  simp only [localizationToFraction, fractionToLocalization, IsLocalization.map_eq]
  have hd : b - inclusionMap k (retractionMap k b) ∈ projectionKernel k := by
    change retractionMap k (b - inclusionMap k (retractionMap k b)) = 0
    rw [map_sub, retractionMap_inclusionMap, sub_self]
  have hz := localization_algebraMap_sub_retraction_zero (k := k)
    (b - inclusionMap k (retractionMap k b)) hd
  rw [map_sub] at hz
  exact (sub_eq_zero.mp hz).symm

/-- Localization of the larger ring at its generic point is the fraction field
of the polynomial ring. -/
noncomputable def genericLocalizationEquiv :
    Localization.AtPrime (projectionKernel k) ≃+* FractionRing (baseRing k) :=
  RingEquiv.ofRingHom (localizationToFraction k) (fractionToLocalization k)
    (localization_retraction_section_comp k) (localization_section_retraction_comp k)

/-- The generic-localization equivalence is induced by the retraction. -/
theorem genericLocalizationEquiv_map (b : extensionRing k) :
    genericLocalizationEquiv k
      (algebraMap (extensionRing k) (Localization.AtPrime (projectionKernel k)) b) =
      algebraMap (baseRing k) (FractionRing (baseRing k)) ((retractionMap k) b) := by
  simp [genericLocalizationEquiv, localizationToFraction]

end Field

end AlgebraicGeometry.PolynomialRetract
