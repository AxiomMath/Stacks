/-!
# Relative weak normalization and localization

The relative weak normalization of an algebra commutes with localization at a multiplicative
subset of the base ring.

One inclusion is maximality of the relative weak normalization over the localized base: the
localization of the relative weak normalization is still universally homeomorphic over the
localized base, because that square of spectra is a pullback. The other inclusion is the
elementwise criterion: an element of the relative weak normalization over the localized base is
reached by a finite tower of adjunctions of special elements, and each special element can be
written as a fraction whose numerator is special over the original base, hence already in the
relative weak normalization.

## Main results

* `AlgebraicGeometry.relativeWeakNormalization_localization` identifies the relative weak
  normalization after localization with the subalgebra generated by the image of the original
  relative weak normalization.

## Implementation notes

The localization of the subalgebra is represented inside the localized target by the subalgebra
generated over the localized base by its canonical image. The algebra structure on the localized
target is the canonical map obtained from the universal property of localization.

## References

* [Stacks Project, Tag 0H3K](https://stacks.math.columbia.edu/tag/0H3K)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry


private lemma localization_liftsGeneralizations (A : Type u) [CommRing A]
    (S : Submonoid A) :
    LiftsGeneralizations
      (fun x : PrimeSpectrum (Localization S) =>
        PrimeSpectrum.comap (algebraMap A (Localization S)) x) := by
  intro x y' y hxy hy'y
  let e := IsLocalization.primeSpectrumOrderIso S (Localization S)
  have heq (x : PrimeSpectrum (Localization S)) :
      (e x).1 = PrimeSpectrum.comap (algebraMap A (Localization S)) x := by
    apply PrimeSpectrum.ext
    simp [e, IsLocalization.primeSpectrumOrderIso, Ideal.under_def]
  have hy'le : y' ≤ (e x).1 := by
    rwa [(heq x).trans hxy, PrimeSpectrum.le_iff_specializes]
  have hdisj : Disjoint (S : Set A) y'.asIdeal := Set.disjoint_left.mpr fun a ha hya =>
    Set.disjoint_left.mp (e x).2 ha ((PrimeSpectrum.asIdeal_le_asIdeal y' (e x).1).2 hy'le hya)
  let z : PrimeSpectrum (Localization S) := e.symm ⟨y', hdisj⟩
  have hzx : z ≤ x := e.symm_apply_le.mpr hy'le
  exact ⟨z, (PrimeSpectrum.le_iff_specializes z x).1 hzx, (heq z).symm.trans (by simp [z])⟩

private lemma localization_isPullback (A B : Type u) [CommRing A] [CommRing B]
    [Algebra A B] (S : Submonoid A) :
    IsPullback
      (Scheme.Spec.map (CommRingCat.ofHom
        (algebraMap B (Localization (S.map (algebraMap A B))))).op)
      (Scheme.Spec.map (CommRingCat.ofHom
        (IsLocalization.map (Localization (S.map (algebraMap A B)))
          (algebraMap A B) S.le_comap_map)).op)
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op)
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A (Localization S))).op) := by
  let : Algebra (Localization S) (Localization (S.map (algebraMap A B))) :=
    (IsLocalization.map (Localization (S.map (algebraMap A B))) (algebraMap A B)
      S.le_comap_map).toAlgebra
  have : IsScalarTower A (Localization S) (Localization (S.map (algebraMap A B))) :=
    IsScalarTower.of_algebraMap_eq' (IsLocalization.map_comp _).symm
  have hlocB : IsLocalization (Algebra.algebraMapSubmonoid B S)
      (Localization (S.map (algebraMap A B))) := by
    change IsLocalization (S.map (algebraMap A B)) _
    infer_instance
  have hp : Algebra.IsPushout A B (Localization S)
      (Localization (S.map (algebraMap A B))) :=
    Algebra.isPushout_of_isLocalization S (Localization S) B _
  exact isPullback_SpecMap_of_isPushout _ _ _ _
    (CommRingCat.isPushout_of_isPushout A B (Localization S)
      (Localization (S.map (algebraMap A B))))

private lemma localization_isDominant (A B : Type u) [CommRing A] [CommRing B]
    [Algebra A B]
    (h : IsDominant (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op))
    (S : Submonoid A) :
    let f : Localization S →+* Localization (S.map (algebraMap A B)) :=
      IsLocalization.map (Localization (S.map (algebraMap A B))) (algebraMap A B)
        S.le_comap_map
    let _ : Algebra (Localization S) (Localization (S.map (algebraMap A B))) := f.toAlgebra
    IsDominant (Scheme.Spec.map (CommRingCat.ofHom f).op) := by
  let f : Localization S →+* Localization (S.map (algebraMap A B)) :=
    IsLocalization.map (Localization (S.map (algebraMap A B))) (algebraMap A B)
      S.le_comap_map
  let : Algebra (Localization S) (Localization (S.map (algebraMap A B))) := f.toAlgebra
  let g := Scheme.Spec.map (CommRingCat.ofHom (algebraMap A (Localization S))).op
  let q := Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op
  have sq := localization_isPullback A B S
  have : IsDominant q := h
  have hpb : IsDominant (pullback.snd q g) :=
    isDominant_pullback_snd_of_liftsGeneralizations q g
      (localization_liftsGeneralizations A S)
  have hcomp : IsDominant (sq.isoPullback.hom ≫ pullback.snd q g) := inferInstance
  rwa [sq.isoPullback_hom_snd] at hcomp

/-- `Spec` of a composite of ring maps is the composite of the `Spec` maps. -/
private theorem spec_map_comp_ofHom {R S T : Type u} [CommRing R] [CommRing S] [CommRing T]
    (f : R →+* S) (g : S →+* T) :
    Scheme.Spec.map (CommRingCat.ofHom g).op ≫ Scheme.Spec.map (CommRingCat.ofHom f).op =
      Scheme.Spec.map (CommRingCat.ofHom (g.comp f)).op := by
  rw [← Scheme.Spec.map_comp]
  congr 1

private theorem bot_specMap_universalHomeomorphism
    (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    (h : IsDominant (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op)) :
    UniversalHomeomorphism
      (Scheme.Spec.map
        (CommRingCat.ofHom (algebraMap A (⊥ : Subalgebra A B))).op) := by
  let R : Subalgebra A B := ⊥
  let f : CommRingCat.of A ⟶ CommRingCat.of R := CommRingCat.ofHom (algebraMap A R)
  let g : CommRingCat.of R ⟶ CommRingCat.of B := CommRingCat.ofHom R.val.toRingHom
  let F := Scheme.Spec.map f.op
  let G := Scheme.Spec.map g.op
  have hs : Function.Surjective (algebraMap A R) := fun x => by
    obtain ⟨a, ha⟩ : (x : B) ∈ Set.range (algebraMap A B) := x.property
    exact ⟨a, Subtype.ext ha⟩
  have hfactor : G ≫ F = Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op := by
    exact spec_map_comp_ofHom (algebraMap A R) R.val.toRingHom
  have hdomF : IsDominant F := by
    have : IsDominant (G ≫ F) := hfactor ▸ h
    exact IsDominant.of_comp G F
  have : IsClosedImmersion F := IsClosedImmersion.spec_of_surjective f hs
  exact (universalHomeomorphism_iff_integral_universallyInjective_surjective F).mpr
    ⟨IsIntegralHom.SpecMap_iff.mpr
        (algebraMap_isIntegral_iff.mpr (Algebra.isIntegral_of_surjective hs)),
      inferInstance,
      surjective_of_isDominant_of_isClosed_range F
        (Scheme.Hom.isClosedEmbedding F).isClosed_range⟩

private theorem bot_subalgebra_to_target_universalHomeomorphism
    (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    (hdom : IsDominant
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op))
    (h : UniversalHomeomorphism
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op)) :
    UniversalHomeomorphism
      (Scheme.Spec.map
        (CommRingCat.ofHom ((⊥ : Subalgebra A B).val.toRingHom)).op) := by
  let A0 : Subalgebra A B := ⊥
  let f0 : A →+* A0 := algebraMap A A0
  let g0 : A0 →+* B := A0.val.toRingHom
  have hfg : g0.comp f0 = algebraMap A B := RingHom.ext fun _ => rfl
  have h' : UniversalHomeomorphism
      (Scheme.Spec.map (CommRingCat.ofHom (g0.comp f0)).op) := by
    rwa [hfg]
  have : MorphismProperty.HasOfPostcompProperty
      (@UniversalHomeomorphism.{u}) (@UniversalHomeomorphism.{u}) :=
    universalHomeomorphism_hasTwoOutOfThreeProperty.toHasOfPostcompProperty
  exact MorphismProperty.of_postcomp (@UniversalHomeomorphism.{u})
    (Scheme.Spec.map (CommRingCat.ofHom g0).op)
    (Scheme.Spec.map (CommRingCat.ofHom f0).op)
    (bot_specMap_universalHomeomorphism A B hdom) (spec_map_comp_ofHom f0 g0 ▸ h')

private lemma clear_special_step {B : Type u} [CommRing B] (E : Subring B)
    (S : Submonoid E) (x : Localization (S.map E.subtype))
    (hx : x ∉ Set.range
      (IsLocalization.map (M := S) (S := Localization S) (T := S.map E.subtype)
        (Localization (S.map E.subtype)) E.subtype S.le_comap_map))
    (hstep :
      (x ^ 2 ∈ Set.range
        (IsLocalization.map (M := S) (S := Localization S) (T := S.map E.subtype)
          (Localization (S.map E.subtype)) E.subtype S.le_comap_map) ∧
        x ^ 3 ∈ Set.range
        (IsLocalization.map (M := S) (S := Localization S) (T := S.map E.subtype)
          (Localization (S.map E.subtype)) E.subtype S.le_comap_map)) ∨
      ∃ p : ℕ, p.Prime ∧
        (p : Localization (S.map E.subtype)) * x ∈ Set.range
          (IsLocalization.map (M := S) (S := Localization S) (T := S.map E.subtype)
            (Localization (S.map E.subtype)) E.subtype S.le_comap_map) ∧
        x ^ p ∈ Set.range
          (IsLocalization.map (M := S) (S := Localization S) (T := S.map E.subtype)
            (Localization (S.map E.subtype)) E.subtype S.le_comap_map)) :
    ∃ (s : S) (y : B),
      x = IsLocalization.mk' (Localization (S.map E.subtype)) y
          ⟨E.subtype s.1, Submonoid.mem_map_of_mem E.subtype s.2⟩ ∧
        ((y ^ 2 ∈ E ∧ y ^ 3 ∈ E) ∨ ∃ p : ℕ, p.Prime ∧ (p : B) * y ∈ E ∧ y ^ p ∈ E) := by
  rcases hstep with ⟨h2, h3⟩ | ⟨p, hp, hp1, hpp⟩
  · let b : Fin 3 → B := fun i => if i.val = 1 ∨ i.val = 2 then 1 else 0
    have hb : ∀ i, algebraMap B (Localization (S.map E.subtype)) (b i) *
        x ^ (i.val + 1) ∈ Set.range
          (IsLocalization.map (M := S) (S := Localization S) (T := S.map E.subtype)
            (Localization (S.map E.subtype)) E.subtype S.le_comap_map) := by
      intro i
      fin_cases i
      · exact ⟨0, by simp [b]⟩
      · simpa [b] using h2
      · simpa [b] using h3
    obtain ⟨s, y, hx', hy, hy'⟩ :=
      IsLocalization.exists_numerator_not_mem_of_localization E S b x hx hb
    exact ⟨s, y, hx', Or.inl ⟨by simpa [b] using hy' ⟨1, by decide⟩,
      by simpa [b] using hy' ⟨2, by decide⟩⟩⟩
  · let b : Fin p → B := fun i => if i.val = 0 then p else if i.val + 1 = p then 1 else 0
    have hb : ∀ i, algebraMap B (Localization (S.map E.subtype)) (b i) *
        x ^ (i.val + 1) ∈ Set.range
          (IsLocalization.map (M := S) (S := Localization S) (T := S.map E.subtype)
            (Localization (S.map E.subtype)) E.subtype S.le_comap_map) := by
      intro i
      by_cases h0 : i.val = 0
      · simpa [b, h0, hp.one_lt.ne] using hp1
      · by_cases hpow : i.val + 1 = p
        · simpa [b, h0, hpow] using hpp
        · exact ⟨0, by simp [b, h0, hpow]⟩
    obtain ⟨s, y, hx', hy, hy'⟩ :=
      IsLocalization.exists_numerator_not_mem_of_localization E S b x hx hb
    refine ⟨s, y, hx', Or.inr ⟨p, hp, ?_, ?_⟩⟩
    · simpa [b] using hy' ⟨0, hp.pos⟩
    · have := hp.two_le
      simpa [b, show p - 1 ≠ 0 by omega, show p - 1 + 1 = p by omega] using
        hy' ⟨p - 1, by omega⟩

private noncomputable def localized_base_map {A B : Type u} [CommRing A] [CommRing B]
    [Algebra A B] (S : Submonoid A) (E : Subalgebra A B) :
    Localization S →+* Localization (S.map (algebraMap A E)) :=
  IsLocalization.map (Localization (S.map (algebraMap A E))) (algebraMap A E)
    S.le_comap_map

private noncomputable def localized_subalgebra_ringMap {A B : Type u}
    [CommRing A] [CommRing B] [Algebra A B] (S : Submonoid A)
    (E : Subalgebra A B) :
    Localization (S.map (algebraMap A E)) →+* Localization (S.map (algebraMap A B)) := by
  let SC := S.map (algebraMap A E)
  let SB := S.map (algebraMap A B)
  have hSC : SC ≤ Submonoid.comap (E.val : E →+* B) SB := by
    intro z hz
    obtain ⟨s, hs, rfl⟩ := Submonoid.mem_map.mp hz
    exact Submonoid.mem_map_of_mem (algebraMap A B) hs
  exact IsLocalization.map (M := SC) (S := Localization SC) (T := SB)
    (Localization SB) E.val hSC

private noncomputable def localized_subalgebra_algHom {A B : Type u}
    [CommRing A] [CommRing B] [Algebra A B] (S : Submonoid A)
    (E : Subalgebra A B) :
    let g : Localization S →+* Localization (S.map (algebraMap A E)) :=
      localized_base_map S E
    let _ : Algebra (Localization S) (Localization (S.map (algebraMap A E))) := g.toAlgebra
    let f : Localization S →+* Localization (S.map (algebraMap A B)) :=
      IsLocalization.map (Localization (S.map (algebraMap A B))) (algebraMap A B)
        S.le_comap_map
    let _ : Algebra (Localization S) (Localization (S.map (algebraMap A B))) := f.toAlgebra
    Localization (S.map (algebraMap A E)) →ₐ[Localization S]
      Localization (S.map (algebraMap A B)) := by
  let g := localized_base_map S E
  let f := localized_subalgebra_ringMap S E
  let fmain : Localization S →+* Localization (S.map (algebraMap A B)) :=
    IsLocalization.map (Localization (S.map (algebraMap A B))) (algebraMap A B)
      S.le_comap_map
  let : Algebra (Localization S) (Localization (S.map (algebraMap A E))) := g.toAlgebra
  let : Algebra (Localization S) (Localization (S.map (algebraMap A B))) := fmain.toAlgebra
  have hbase : (f.comp g).comp (algebraMap A (Localization S)) =
      fmain.comp (algebraMap A (Localization S)) := by
    ext a
    simp [f, g, fmain, localized_subalgebra_ringMap, localized_base_map,
      IsLocalization.map_eq]
  have hcomp : f.comp g = fmain := IsLocalization.ringHom_ext S hbase
  exact ⟨f, fun r => DFunLike.congr_fun hcomp r⟩

private theorem localized_subalgebra_range_eq_adjoin {A B : Type u}
    [CommRing A] [CommRing B] [Algebra A B] (S : Submonoid A)
    (E : Subalgebra A B) :
    let f : Localization S →+* Localization (S.map (algebraMap A B)) :=
      IsLocalization.map (Localization (S.map (algebraMap A B))) (algebraMap A B)
        S.le_comap_map
    let _ : Algebra (Localization S) (Localization (S.map (algebraMap A B))) := f.toAlgebra
    let SC := S.map (algebraMap A E)
    let _ : Algebra (Localization S) (Localization SC) :=
      (localized_base_map S E).toAlgebra
    let g := localized_subalgebra_algHom S E
    AlgHom.range g = Algebra.adjoin (Localization S)
      (algebraMap B (Localization (S.map (algebraMap A B))) '' (E : Set B)) := by
  let fmain : Localization S →+* Localization (S.map (algebraMap A B)) :=
    IsLocalization.map (Localization (S.map (algebraMap A B))) (algebraMap A B)
      S.le_comap_map
  let : Algebra (Localization S) (Localization (S.map (algebraMap A B))) := fmain.toAlgebra
  let SC := S.map (algebraMap A E)
  let : Algebra (Localization S) (Localization SC) := (localized_base_map S E).toAlgebra
  let g := localized_subalgebra_algHom S E
  have hrange_le : AlgHom.range g ≤ Algebra.adjoin (Localization S)
      (algebraMap B (Localization (S.map (algebraMap A B))) '' (E : Set B)) := by
    intro x hx
    rw [AlgHom.mem_range] at hx
    obtain ⟨z, rfl⟩ := hx
    obtain ⟨⟨c, s⟩, hs⟩ := IsLocalization.surj SC z
    obtain ⟨a, ha, hs_eq⟩ := Submonoid.mem_map.mp s.2
    let d : Localization (S.map (algebraMap A B)) := algebraMap B _ (c : B)
    let t : Localization S := IsLocalization.mk' (Localization S) 1 ⟨a, ha⟩
    have hnum : (g : Localization SC →+* _) z *
        algebraMap B _ ((algebraMap A B) a) = d := by
      have hh := congrArg (localized_subalgebra_ringMap S E) hs
      change localized_subalgebra_ringMap S E z *
        algebraMap B _ ((algebraMap A B) a) = d
      rw [← hs_eq] at hh
      simpa [localized_subalgebra_ringMap, SC, d, IsLocalization.map_eq,
        Subalgebra.algebraMap_eq] using hh
    have hfrac : fmain t * algebraMap B _ ((algebraMap A B) a) = 1 := by
      calc
        fmain t * algebraMap B _ ((algebraMap A B) a) =
            fmain t * fmain (algebraMap A (Localization S) a) := by
              simp [fmain, IsLocalization.map_eq]
        _ = fmain (t * algebraMap A (Localization S) a) := by rw [map_mul]
        _ = 1 := by rw [show t * algebraMap A (Localization S) a = 1 by simp [t], map_one]
    have hunit : IsUnit
        (algebraMap B (Localization (S.map (algebraMap A B))) ((algebraMap A B) a)) :=
      IsLocalization.map_units _
        ⟨(algebraMap A B) a, Submonoid.mem_map_of_mem (algebraMap A B) ha⟩
    have hz : g z = d * fmain t :=
      hunit.mul_left_inj.mp (hnum.trans (by rw [mul_assoc, hfrac, mul_one]))
    rw [hz]
    exact Subalgebra.mul_mem _ (Algebra.subset_adjoin ⟨(c : B), c.2, rfl⟩)
      (Subalgebra.algebraMap_mem _ t)
  have hadjoin_le : Algebra.adjoin (Localization S)
      (algebraMap B (Localization (S.map (algebraMap A B))) '' (E : Set B)) ≤ AlgHom.range g := by
    rw [Algebra.adjoin_le_iff]
    rintro x ⟨b, hb, rfl⟩
    rw [SetLike.mem_coe, AlgHom.mem_range]
    refine ⟨algebraMap E (Localization SC) ⟨b, hb⟩, ?_⟩
    simp [g, localized_subalgebra_algHom, localized_subalgebra_ringMap,
      SC, IsLocalization.map_eq]
  exact le_antisymm hrange_le hadjoin_le

private theorem localized_relativeWeakNormalization_isUniversalHomeomorphism
    (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    (h : IsDominant (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op))
    (S : Submonoid A) :
    let C := relativeWeakNormalization A B
    let _ : Algebra A C := inferInstance
    let g : Localization S →+* Localization (S.map (algebraMap A C)) :=
      localized_base_map S C
    let _ : Algebra (Localization S) (Localization (S.map (algebraMap A C))) := g.toAlgebra
    UniversalHomeomorphism (Scheme.Spec.map (CommRingCat.ofHom g).op) := by
  let C := relativeWeakNormalization A B
  let g : Localization S →+* Localization (S.map (algebraMap A C)) :=
    localized_base_map S C
  let : Algebra (Localization S) (Localization (S.map (algebraMap A C))) := g.toAlgebra
  exact (universalHomeomorphism_iff _).mpr
    (MorphismProperty.of_isPullback (localization_isPullback A C S)
      (relativeWeakNormalization_isUniversalHomeomorphism A B h).universally_isHomeomorph)

private theorem localized_original_relativeWeakNormalization_le
    (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    (h : IsDominant (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op))
    (S : Submonoid A) :
    let f : Localization S →+* Localization (S.map (algebraMap A B)) :=
      IsLocalization.map (Localization (S.map (algebraMap A B))) (algebraMap A B)
        S.le_comap_map
    let _ : Algebra (Localization S) (Localization (S.map (algebraMap A B))) := f.toAlgebra
    Algebra.adjoin (Localization S)
        (algebraMap B (Localization (S.map (algebraMap A B))) ''
          (relativeWeakNormalization A B : Set B)) ≤
      relativeWeakNormalization (Localization S)
        (Localization (S.map (algebraMap A B)) ) := by
  let f : Localization S →+* Localization (S.map (algebraMap A B)) :=
    IsLocalization.map (Localization (S.map (algebraMap A B))) (algebraMap A B)
      S.le_comap_map
  let : Algebra (Localization S) (Localization (S.map (algebraMap A B))) := f.toAlgebra
  let C := relativeWeakNormalization A B
  let CLoc := Localization (S.map (algebraMap A C))
  let : Algebra (Localization S) CLoc := (localized_base_map S C).toAlgebra
  let g := localized_subalgebra_algHom S C
  have hdom : IsDominant (Scheme.Spec.map (CommRingCat.ofHom f).op) := by
    simpa [f] using localization_isDominant A B h S
  have hUH : UniversalHomeomorphism
      (Scheme.Spec.map (CommRingCat.ofHom (localized_base_map S C)).op) :=
    localized_relativeWeakNormalization_isUniversalHomeomorphism A B h S
  change Algebra.adjoin (Localization S)
      (algebraMap B (Localization (S.map (algebraMap A B))) ''
        (relativeWeakNormalization A B : Set B)) ≤
    relativeWeakNormalization (Localization S)
      (Localization (S.map (algebraMap A B)))
  rw [← localized_subalgebra_range_eq_adjoin S C]
  exact range_le_relativeWeakNormalization
    (Localization S) (Localization (S.map (algebraMap A B))) CLoc g hdom hUH

private lemma localized_clear_special_step {A B : Type u}
    [CommRing A] [CommRing B] [Algebra A B] (S : Submonoid A)
    (E : Subalgebra A B) (x : Localization (S.map (algebraMap A B)))
    (hx : x ∉ Set.range (localized_subalgebra_ringMap S E))
    (hstep :
      (x ^ 2 ∈ Set.range (localized_subalgebra_ringMap S E) ∧
        x ^ 3 ∈ Set.range (localized_subalgebra_ringMap S E)) ∨
      ∃ p : ℕ, p.Prime ∧
        (p : Localization (S.map (algebraMap A B))) * x ∈
          Set.range (localized_subalgebra_ringMap S E) ∧
        x ^ p ∈ Set.range (localized_subalgebra_ringMap S E)) :
    ∃ (s : S) (y : B),
      x = IsLocalization.mk' (Localization (S.map (algebraMap A B))) y
          ⟨algebraMap A B s.1, Submonoid.mem_map_of_mem (algebraMap A B) s.2⟩ ∧
        ((y ^ 2 ∈ E ∧ y ^ 3 ∈ E) ∨ ∃ p : ℕ, p.Prime ∧
          (p : B) * y ∈ E ∧ y ^ p ∈ E) := by
  let T := S.map (algebraMap A E)
  let SB := S.map (algebraMap A B)
  let RE := Localization (T.map E.toSubring.subtype)
  have hmon : T.map E.toSubring.subtype = S.map (algebraMap A B) := by
    ext z
    simp [T, Submonoid.mem_map, Subalgebra.toSubring]
  have : IsLocalization SB RE := by
    dsimp [SB]
    rw [← hmon]
    infer_instance
  let e : Localization SB ≃ₐ[B] RE := IsLocalization.algEquiv SB (Localization SB) RE
  let cE : Localization T →+* RE :=
    IsLocalization.map (M := T) (S := Localization T) (T := T.map E.toSubring.subtype)
      RE E.toSubring.subtype T.le_comap_map
  have hcomp : e.toRingEquiv.toRingHom.comp (localized_subalgebra_ringMap S E) = cE := by
    refine IsLocalization.ringHom_ext T (RingHom.ext fun a => ?_)
    have hleft : localized_subalgebra_ringMap S E
        (algebraMap E (Localization T) a) = algebraMap B (Localization SB) ((a : E) : B) := by
      simp [localized_subalgebra_ringMap, IsLocalization.map_eq, T, SB]
    have hright : cE (algebraMap E (Localization T) a) = algebraMap B RE ((a : E) : B) :=
      IsLocalization.map_eq T.le_comap_map (a : E)
    change e (localized_subalgebra_ringMap S E (algebraMap E (Localization T) a)) =
      cE (algebraMap E (Localization T) a)
    rw [hleft, e.commutes, hright]
  have hx' : e x ∉ Set.range cE := fun ⟨z, hz⟩ => hx ⟨z, e.injective <|
    (DFunLike.congr_fun hcomp z : e (localized_subalgebra_ringMap S E z) = cE z).trans hz⟩
  have hrange_map {y : Localization SB}
      (hy : y ∈ Set.range (localized_subalgebra_ringMap S E)) : e y ∈ Set.range cE :=
    hy.elim fun z hz => ⟨z, (DFunLike.congr_fun hcomp z).symm.trans (congrArg (⇑e) hz)⟩
  have hstep' : ((e x) ^ 2 ∈ Set.range cE ∧ (e x) ^ 3 ∈ Set.range cE) ∨
      ∃ p : ℕ, p.Prime ∧ (p : RE) * e x ∈ Set.range cE ∧ (e x) ^ p ∈ Set.range cE := by
    rcases hstep with hsq | ⟨p, hp, hpx, hpow⟩
    · exact Or.inl ⟨by simpa only [map_pow] using hrange_map hsq.1,
        by simpa only [map_pow] using hrange_map hsq.2⟩
    · exact Or.inr ⟨p, hp, by simpa only [map_mul, map_natCast] using hrange_map hpx,
        by simpa only [map_pow] using hrange_map hpow⟩
  obtain ⟨t, y, hxy, hy⟩ := clear_special_step E.toSubring T (e x) hx' hstep'
  obtain ⟨s, hs, ht⟩ := Submonoid.mem_map.mp t.2
  refine ⟨⟨s, hs⟩, y, ?_, hy⟩
  apply e.injective
  have hnum : algebraMap B RE (E.toSubring.subtype t.1) = algebraMap B RE (algebraMap A B s) :=
    congrArg (algebraMap B RE) (congrArg Subtype.val ht).symm
  refine (IsLocalization.map_units (R := B) (M := SB) RE
    ⟨algebraMap A B s, Submonoid.mem_map_of_mem (algebraMap A B) hs⟩).mul_left_inj.mp ?_
  calc
    e x * algebraMap B RE (algebraMap A B s) = algebraMap B RE y := by
      rw [hxy, ← hnum, IsLocalization.mk'_spec]
    _ = _ := by
      rw [← e.commutes y, ← e.commutes (algebraMap A B s), ← map_mul, IsLocalization.mk'_spec]

private theorem adjoin_special_isUniversalHomeomorphism
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B] (E : Subalgebra A B)
    (y : B)
    (hy : ((y ^ 2 ∈ E ∧ y ^ 3 ∈ E) ∨
      ∃ p : ℕ, p.Prime ∧ (p : B) * y ∈ E ∧ y ^ p ∈ E)) :
    let X := Algebra.adjoin E ({y} : Set B)
    UniversalHomeomorphism
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap E X)).op) := by
  let X := Algebra.adjoin E ({y} : Set B)
  have hinj : Function.Injective (algebraMap E X) := fun _ _ hab =>
    Subtype.ext (congrArg (fun z : X => (z : B)) hab)
  apply (universalHomeomorphism_spec_iff_finite_adjoin_tower E X hinj).2
  intro F
  let b : Fin 1 → X := fun _ => ⟨y, Algebra.subset_adjoin (by simp)⟩
  have hrange : Set.range b = (Subtype.val : X → B) ⁻¹' ({y} : Set B) := by
    ext z
    simp [b, Subtype.ext_iff]
  have htop : Algebra.adjoin E (Set.range b) = ⊤ := by
    rw [hrange]
    exact Algebra.adjoin_adjoin_coe_preimage
  refine ⟨1, b, by simp [htop], fun i => ?_⟩
  fin_cases i
  have hmem (z : X) (w : B) (hw : w ∈ E) (hz : (z : B) = w) :
      z ∈ Algebra.adjoin E (Set.range fun j : {j : Fin 1 // j < 0} => b j) := by
    rw [show z = algebraMap E X ⟨w, hw⟩ from Subtype.ext hz]
    exact (Algebra.adjoin E _).algebraMap_mem _
  rcases hy with ⟨hy2, hy3⟩ | ⟨p, hp, hpy, hyp⟩
  · exact Or.inl ⟨hmem _ _ hy2 rfl, hmem _ _ hy3 rfl⟩
  · exact Or.inr ⟨p, hp, hmem _ _ hpy rfl, hmem _ _ hyp rfl⟩

private theorem special_element_mem_relativeWeakNormalization
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    (h : IsDominant (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op))
    (y : B)
    (hy : ((y ^ 2 ∈ relativeWeakNormalization A B ∧
        y ^ 3 ∈ relativeWeakNormalization A B) ∨
      ∃ p : ℕ, p.Prime ∧
        (p : B) * y ∈ relativeWeakNormalization A B ∧
        y ^ p ∈ relativeWeakNormalization A B)) :
    y ∈ relativeWeakNormalization A B := by
  let C := relativeWeakNormalization A B
  let X := Algebra.adjoin C ({y} : Set B)
  let fAX : A →+* X := (algebraMap C X).comp (algebraMap A C)
  let : Algebra A X := fAX.toAlgebra
  have : MorphismProperty.IsStableUnderComposition (@UniversalHomeomorphism.{u}) :=
    universalHomeomorphism_hasTwoOutOfThreeProperty.toIsStableUnderComposition
  have hcomp := MorphismProperty.comp_mem (@UniversalHomeomorphism.{u})
    (Scheme.Spec.map (CommRingCat.ofHom (algebraMap C X)).op)
    (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A C)).op)
    (adjoin_special_isUniversalHomeomorphism C y hy)
    (relativeWeakNormalization_isUniversalHomeomorphism A B h)
  rw [spec_map_comp_ofHom] at hcomp
  let g : X →ₐ[A] B :=
    { toRingHom := X.val.toRingHom
      commutes' := by
        intro a
        change (X.val) (fAX a) = algebraMap A B a
        simp [fAX] }
  have hyX : y ∈ g.range := ⟨⟨y, Algebra.subset_adjoin (by simp)⟩, rfl⟩
  exact range_le_relativeWeakNormalization A B X g h hcomp hyX

private theorem localized_relativeWeakNormalization_le_adjoin
    {A B : Type u} [CommRing A] [CommRing B] [Algebra A B]
    (h : IsDominant (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op))
    (S : Submonoid A) :
    let f : Localization S →+* Localization (S.map (algebraMap A B)) :=
      IsLocalization.map (Localization (S.map (algebraMap A B))) (algebraMap A B)
        S.le_comap_map
    let _ : Algebra (Localization S) (Localization (S.map (algebraMap A B))) := f.toAlgebra
    Algebra.adjoin (Localization S)
        (algebraMap B (Localization (S.map (algebraMap A B))) ''
          (relativeWeakNormalization A B : Set B)) ≥
      relativeWeakNormalization (Localization S)
        (Localization (S.map (algebraMap A B))) := by
  let R := Localization S
  let RB := Localization (S.map (algebraMap A B))
  let f : R →+* RB := IsLocalization.map RB (algebraMap A B) S.le_comap_map
  let : Algebra R RB := f.toAlgebra
  let C := relativeWeakNormalization A B
  let D := relativeWeakNormalization R RB
  let H : Subalgebra R RB := Algebra.adjoin R (algebraMap B RB '' (C : Set B))
  let : Algebra R (Localization (S.map (algebraMap A C))) :=
    (localized_base_map S C).toAlgebra
  have hrangeSet : Set.range (localized_subalgebra_ringMap S C) = (H : Set RB) := by
    rw [← show AlgHom.range (localized_subalgebra_algHom S C) = H by
      simpa [R, RB, H] using localized_subalgebra_range_eq_adjoin S C]
    ext x
    simp [localized_subalgebra_algHom]
  have hD : UniversalHomeomorphism (Scheme.Spec.map (CommRingCat.ofHom (algebraMap R D)).op) :=
    relativeWeakNormalization_isUniversalHomeomorphism R RB
      (by simpa [f, R, RB] using localization_isDominant A B h S)
  have : Surjective (Scheme.Spec.map (CommRingCat.ofHom (algebraMap R D)).op) :=
    ((universalHomeomorphism_iff_integral_universallyInjective_surjective _).mp hD).2.2
  let A0 : Subalgebra R D := ⊥
  have : IsScalarTower R A0 D := IsScalarTower.of_algebraMap_eq' (RingHom.ext fun _ => rfl)
  have htower := (universalHomeomorphism_spec_iff_finite_adjoin_tower A0 D fun _ _ hxy =>
    Subtype.ext hxy).mp (bot_subalgebra_to_target_universalHomeomorphism R D inferInstance hD)
  let HD : Subalgebra R D := H.comap D.val
  have hbase : ∀ a : A0, (algebraMap A0 D) a ∈ HD := fun a => by
    obtain ⟨r, hr⟩ : (a : D) ∈ Set.range (algebraMap R D) := a.property
    change ((a : D) : RB) ∈ H
    exact hr ▸ H.algebraMap_mem r
  change D ≤ H
  intro z hz
  obtain ⟨n, b, hzAd, hstep⟩ := htower {⟨z, hz⟩}
  have hadj : ∀ s : Set D, s ⊆ HD → ∀ w ∈ Algebra.adjoin A0 s, w ∈ HD := fun s hs w hw =>
    Algebra.adjoin_induction (p := fun w _ => w ∈ HD) (fun _ hw => hs hw) hbase
      (fun _ _ _ _ h₁ h₂ => HD.add_mem h₁ h₂) (fun _ _ _ _ h₁ h₂ => HD.mul_mem h₁ h₂) hw
  have hb (i : Fin n) : b i ∈ HD := by
    induction i using WellFoundedLT.induction with
    | _ i ih =>
      have htrans (w : D)
          (hw : w ∈ Algebra.adjoin A0 (Set.range fun j : {j : Fin n // j < i} => b j)) :
          (w : RB) ∈ Set.range (localized_subalgebra_ringMap S C) :=
        hrangeSet ▸ hadj _ (Set.range_subset_iff.2 fun j : {j : Fin n // j < i} => ih j.1 j.2) w hw
      change (b i : RB) ∈ (H : Set RB)
      rw [← hrangeSet]
      by_contra hx
      obtain ⟨s, y, hrepr, hy⟩ := localized_clear_special_step S C _ hx <| (hstep i).imp
        (fun hs => ⟨htrans _ hs.1, htrans _ hs.2⟩)
        fun ⟨p, hp, hmul, hpow⟩ => ⟨p, hp, htrans _ hmul, htrans _ hpow⟩
      refine hx ⟨IsLocalization.mk' _
        (⟨y, special_element_mem_relativeWeakNormalization h y (by simpa [C] using hy)⟩ : C)
        ⟨algebraMap A C s.1, Submonoid.mem_map_of_mem _ s.2⟩, ?_⟩
      simp [hrepr, localized_subalgebra_ringMap, IsLocalization.map_mk']
  exact hadj _ (Set.range_subset_iff.2 hb) ⟨z, hz⟩ (hzAd (by simp))

/-- Relative weak normalization commutes with localization at a submonoid of the base. -/
@[stacks 0H3K]
public theorem relativeWeakNormalization_localization
    (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    (h : IsDominant (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op))
    (S : Submonoid A) :
    let f : Localization S →+* Localization (S.map (algebraMap A B)) :=
      IsLocalization.map (Localization (S.map (algebraMap A B))) (algebraMap A B)
        S.le_comap_map
    let _ : Algebra (Localization S) (Localization (S.map (algebraMap A B))) := f.toAlgebra
    Algebra.adjoin (Localization S)
        (algebraMap B (Localization (S.map (algebraMap A B))) ''
          (relativeWeakNormalization A B : Set B)) =
      relativeWeakNormalization (Localization S)
    (Localization (S.map (algebraMap A B))) :=
  le_antisymm (localized_original_relativeWeakNormalization_le A B h S)
    (localized_relativeWeakNormalization_le_adjoin (A := A) (B := B) h S)

end AlgebraicGeometry
