module

public import Mathlib.Algebra.Algebra.Subalgebra.Directed
public import Mathlib.Algebra.Algebra.Subalgebra.Tower
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.ResidueField
public import StacksFrontier.AlgebraicGeometry.Morphisms.UniversalHomeomorphism.Affine.TowerResidue
public import StacksFrontier.AlgebraicGeometry.Morphisms.UniversalHomeomorphism.Defs.TwoOutOfThree

/-!
# Relative seminormalization of an affine algebra

For a dominant map of affine spectra there is a largest intermediate subalgebra whose spectrum is
universally homeomorphic to the base and has the same residue fields.

## Main definitions

* `AlgebraicGeometry.relativeSeminormalization` is the relative seminormalization of an algebra
  inside a dominant algebra.

## Main results

* `AlgebraicGeometry.relativeSeminormalization_universalHomeomorphism`: its spectrum is
  universally homeomorphic to the spectrum of the base.
* `AlgebraicGeometry.relativeSeminormalization_residueFieldMap_isIso`: that morphism induces
  isomorphisms on all residue fields.
* `AlgebraicGeometry.map_mem_relativeSeminormalization`: maximality among intermediate algebras
  with those two properties.

## Implementation notes

A factorization through an intermediate ring is represented by an `A`-algebra `C` together with
an `A`-algebra homomorphism `C →ₐ[A] B`; it need not be injective. The relative seminormalization
is exposed as a chosen subalgebra, because later results discuss its formation under
localization.

The construction is a union of *square-cube towers*: finite sequences in `B` each of whose
members has square and cube already in the algebra generated by its predecessors. These towers
are the data appearing in the criterion
`AlgebraicGeometry.universalHomeomorphism_and_residueFieldIso_iff_finite_adjoin_square_cube`, and
they are closed under concatenation, so the subalgebras they generate form a directed family
whose supremum is again described by the criterion. The map from the base is first replaced by its
image subalgebra, which is a closed immersion on spectra and surjective by dominance; the
two-out-of-three property of universal homeomorphisms then transfers the conclusion between the
map out of the base and the map out of its image.

## References

* [Stacks Project, Tag 0H3L](https://stacks.math.columbia.edu/tag/0H3L)
-/

@[expose] public section

open CategoryTheory

universe u

namespace AlgebraicGeometry

/-- The elements of a finite sequence in `B` strictly preceding a given index. -/
public def squareCubePrefix {R B : Type u} [CommRing R] [CommRing B]
    [Algebra R B] (n : ℕ) (b : Fin n → B) (i : Fin n) : Set B :=
  Set.range (fun j : Fin i => b (Fin.castLE i.isLt.le j))

/-- A finite sequence in `B` is a square-cube tower over `R` when each member has square and
cube in the `R`-algebra generated by its predecessors. -/
public def squareCubeTowerValid {R B : Type u} [CommRing R] [CommRing B]
    [Algebra R B] (n : ℕ) (b : Fin n → B) : Prop :=
  ∀ i : Fin n,
    b i ^ 2 ∈ Algebra.adjoin R (squareCubePrefix (R := R) (B := B) n b i) ∧
    b i ^ 3 ∈ Algebra.adjoin R (squareCubePrefix (R := R) (B := B) n b i)

/-- A square-cube tower: a length, a sequence of that length, and the tower condition. -/
public structure SquareCubeTower (R B : Type u) [CommRing R] [CommRing B]
    [Algebra R B] where
  /-- The length of the tower. -/
  n : ℕ
  /-- The members of the tower. -/
  b : Fin n → B
  /-- Each member has square and cube in the algebra generated by its predecessors. -/
  valid : squareCubeTowerValid (R := R) (B := B) n b

/-- The subalgebra generated by the members of a square-cube tower. -/
public def squareCubeTowerAlgebra {R B : Type u} [CommRing R] [CommRing B]
    [Algebra R B] (t : SquareCubeTower R B) : Subalgebra R B :=
  Algebra.adjoin R (Set.range t.b)

private lemma squareCubePrefix_append_left {R B : Type u} [CommRing R] [CommRing B]
    [Algebra R B] (m n : ℕ) (f : Fin m → B) (g : Fin n → B) (i : Fin m) :
    squareCubePrefix (R := R) (B := B) (m + n) (Fin.append f g) (Fin.castAdd n i) =
      squareCubePrefix (R := R) (B := B) m f i := by
  ext x
  simp only [squareCubePrefix, Set.mem_range]
  constructor
  · rintro ⟨j, rfl⟩
    change Fin i.val at j
    have hidx : Fin.castLE (Fin.castAdd n i).isLt.le j =
        Fin.castAdd n (Fin.castLE i.isLt.le j) := by
      apply Fin.ext
      simp only [Fin.val_castLE, Fin.val_castAdd]
    refine ⟨j, ?_⟩
    rw [hidx, Fin.append_left]
  · rintro ⟨j, rfl⟩
    change Fin i.val at j
    let j' : Fin (Fin.castAdd n i).val := ⟨j.val, by simp⟩
    have hidx : Fin.castLE (Fin.castAdd n i).isLt.le j' =
        Fin.castAdd n (Fin.castLE i.isLt.le j) := by
      apply Fin.ext
      simp only [Fin.val_castLE, Fin.val_castAdd, j']
    refine ⟨j', ?_⟩
    rw [hidx, Fin.append_left]

private lemma squareCubePrefix_append_right_subset {R B : Type u} [CommRing R]
    [CommRing B] [Algebra R B] (m n : ℕ) (f : Fin m → B) (g : Fin n → B)
    (i : Fin n) :
    squareCubePrefix (R := R) (B := B) n g i ⊆
      squareCubePrefix (R := R) (B := B) (m + n) (Fin.append f g) (Fin.natAdd m i) := by
  rintro x ⟨j, rfl⟩
  let j' : Fin (Fin.natAdd m i).val :=
    ⟨m + j.val, by simp only [Fin.val_natAdd]; omega⟩
  refine ⟨j', ?_⟩
  have hidx : Fin.castLE (Fin.natAdd m i).isLt.le j' =
      Fin.natAdd m (Fin.castLE i.isLt.le j) := by
    apply Fin.ext
    simp only [Fin.val_castLE, Fin.val_natAdd, j']
  change Fin.append f g (Fin.castLE (Fin.natAdd m i).isLt.le j') =
    g (Fin.castLE i.isLt.le j)
  rw [hidx, Fin.append_right]

private lemma squareCubeTowerValid_append {R B : Type u} [CommRing R] [CommRing B]
    [Algebra R B] {m n : ℕ} {f : Fin m → B} {g : Fin n → B}
    (hf : squareCubeTowerValid (R := R) (B := B) m f)
    (hg : squareCubeTowerValid (R := R) (B := B) n g) :
    squareCubeTowerValid (R := R) (B := B) (m + n) (Fin.append f g) := by
  intro i
  refine Fin.addCases ?_ ?_ i
  · intro j
    simpa [squareCubePrefix_append_left] using hf j
  · intro j
    have hle : Algebra.adjoin R (squareCubePrefix (R := R) (B := B) n g j) ≤
        Algebra.adjoin R
          (squareCubePrefix (R := R) (B := B) (m + n) (Fin.append f g) (Fin.natAdd m j)) :=
      Algebra.adjoin_mono (squareCubePrefix_append_right_subset m n f g j)
    exact ⟨by simpa [Fin.append_right] using hle (hg j).1,
      by simpa [Fin.append_right] using hle (hg j).2⟩

private noncomputable def squareCubeTowerAlgebras {R B : Type u} [CommRing R]
    [CommRing B] [Algebra R B] : SquareCubeTower R B → Subalgebra R B :=
  squareCubeTowerAlgebra

private instance squareCubeTower_nonempty {R B : Type u} [CommRing R] [CommRing B]
    [Algebra R B] : Nonempty (SquareCubeTower R B) :=
  ⟨⟨0, Fin.elim0, fun i => i.elim0⟩⟩

private lemma squareCubeTowerAlgebras_directed {R B : Type u} [CommRing R]
    [CommRing B] [Algebra R B] :
    Directed (· ≤ ·) (squareCubeTowerAlgebras (R := R) (B := B)) := by
  intro t₁ t₂
  refine ⟨⟨t₁.n + t₂.n, Fin.append t₁.b t₂.b,
    squareCubeTowerValid_append t₁.valid t₂.valid⟩, ?_, ?_⟩
  · exact Algebra.adjoin_mono
      (Set.range_subset_iff.2 fun i => ⟨Fin.castAdd t₂.n i, Fin.append_left _ _ _⟩)
  · exact Algebra.adjoin_mono
      (Set.range_subset_iff.2 fun i => ⟨Fin.natAdd t₁.n i, Fin.append_right _ _ _⟩)

/-- The union of the subalgebras generated by all square-cube towers. -/
public noncomputable def relativeSeminormalizationOverImage
    (R B : Type u) [CommRing R] [CommRing B] [Algebra R B] : Subalgebra R B :=
  ⨆ t : SquareCubeTower R B, squareCubeTowerAlgebra t

private lemma mem_adjoin_subtype {R B : Type u} [CommRing R] [CommRing B]
    [Algebra R B] (C : Subalgebra R B) (n : ℕ) (b : Fin n → C) (x : C) :
    (x : B) ∈ Algebra.adjoin R (Set.range (fun i => (b i : B))) ↔
      x ∈ Algebra.adjoin R (Set.range b) := by
  have hEq : Algebra.adjoin R (Set.range (fun i => (b i : B))) =
      Subalgebra.map C.val (Algebra.adjoin R (Set.range b)) := by
    have hrange : C.val '' Set.range b = Set.range (fun i => (b i : B)) := by
      ext y
      simp
    rw [← hrange]
    exact Algebra.adjoin_image R (C.val) (Set.range b)
  rw [hEq, Subalgebra.mem_map]
  constructor
  · rintro ⟨y, hy, hxy⟩
    rwa [← (Subtype.ext hxy : y = x)]
  · exact fun hx => ⟨x, hx, rfl⟩

private lemma algHom_mem_adjoin {R A B : Type u} [CommRing R] [CommRing A]
    [CommRing B] [Algebra R A] [Algebra R B] (f : A →ₐ[R] B)
    {s : Set A} {x : A} (hx : x ∈ Algebra.adjoin R s) :
    f x ∈ Algebra.adjoin R (f '' s) := by
  rw [Algebra.adjoin_image]
  exact Subalgebra.mem_map.mpr ⟨x, hx, rfl⟩

/-- An `S`-algebra map into `B` sends `adjoin S (range b)` into `adjoin T (range (f ∘ b))` for any
subalgebra `T` of `B` containing the image of `S`. -/
private lemma algHom_mem_adjoin_range_of_base {A S B C : Type u} {ι : Type*} [CommRing A]
    [CommRing S] [CommRing B] [CommRing C] [Algebra A B] [Algebra S B] [Algebra S C]
    (T : Subalgebra A B) (f : C →ₐ[S] B) (hbase : ∀ s : S, algebraMap S B s ∈ T) (b : ι → C)
    {x : C} (hx : x ∈ Algebra.adjoin S (Set.range b)) :
    f x ∈ Algebra.adjoin T (Set.range fun i => f (b i)) := by
  induction hx using Algebra.adjoin_induction with
  | mem y hy =>
      obtain ⟨i, rfl⟩ := hy
      exact Algebra.subset_adjoin ⟨i, rfl⟩
  | algebraMap s =>
      rw [f.commutes]
      exact (Algebra.adjoin T _).algebraMap_mem (⟨_, hbase s⟩ : T)
  | add x y _ _ ihx ihy => rw [map_add]; exact Subalgebra.add_mem _ ihx ihy
  | mul x y _ _ ihx ihy => rw [map_mul]; exact Subalgebra.mul_mem _ ihx ihy

private lemma image_range_eq_range {A B : Type u} {ι : Type*} (f : A → B) (b : ι → A) :
    f '' Set.range b = Set.range (fun i => f (b i)) :=
  (Set.range_comp f b).symm

private lemma residueFieldMap_isIso_of_stalkMap_surjective {X Y : Scheme.{u}}
    (f : X ⟶ Y) (x : X) (hsurj : Function.Surjective (f.stalkMap x)) :
    IsIso (f.residueFieldMap x) := by
  refine (ConcreteCategory.isIso_iff_bijective _).2
    ⟨RingHom.injective (f.residueFieldMap x).hom, fun y => ?_⟩
  obtain ⟨z, rfl⟩ := IsLocalRing.residue_surjective (R := X.presheaf.stalk x) y
  obtain ⟨w, rfl⟩ := hsurj z
  refine ⟨IsLocalRing.residue (Y.presheaf.stalk (f x)) w, ?_⟩
  change IsLocalRing.ResidueField.map (f.stalkMap x).hom _ = _
  exact IsLocalRing.ResidueField.map_residue _ _

/-- If the spectrum of the image subalgebra of `A` in `B` surjects onto that of `A`, it is
universally homeomorphic to it with unchanged residue fields. -/
private lemma imageSubalgebra_spec_properties_of_surjective (A B : Type u) [CommRing A]
    [CommRing B] [Algebra A B]
    (hq : Function.Surjective
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A (Algebra.ofId A B).range)).op)) :
    UniversalHomeomorphism
        (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A (Algebra.ofId A B).range)).op) ∧
      (∀ x, IsIso ((Scheme.Spec.map
        (CommRingCat.ofHom (algebraMap A (Algebra.ofId A B).range)).op).residueFieldMap x)) := by
  have hsurj : Function.Surjective (algebraMap A (Algebra.ofId A B).range) :=
    AlgHom.rangeRestrict_surjective (Algebra.ofId A B)
  have : IsClosedImmersion
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A (Algebra.ofId A B).range)).op) :=
    IsClosedImmersion.spec_of_surjective _ hsurj
  exact ⟨(universalHomeomorphism_iff_integral_universallyInjective_surjective _).2
      ⟨inferInstance, inferInstance, (surjective_iff _).2 hq⟩,
    fun x => residueFieldMap_isIso_of_stalkMap_surjective _ x (Scheme.Hom.stalkMap_surjective _ x)⟩

/-- For a dominant map of affine spectra, the spectrum of the image subalgebra is universally
homeomorphic to the base with unchanged residue fields. -/
private lemma imageSubalgebra_properties (A B : Type u) [CommRing A] [CommRing B]
    [Algebra A B]
    (hdom : IsDominant
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op)) :
    let S : Subalgebra A B := (Algebra.ofId A B).range
    UniversalHomeomorphism
        (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A S)).op) ∧
      (∀ x, IsIso ((Scheme.Spec.map
        (CommRingCat.ofHom (algebraMap A S)).op).residueFieldMap x)) := by
  classical
  let S : Subalgebra A B := (Algebra.ofId A B).range
  let : Algebra S B := S.toAlgebra
  let q := Scheme.Spec.map (CommRingCat.ofHom (algebraMap A S)).op
  let p := Scheme.Spec.map (CommRingCat.ofHom (algebraMap S B)).op
  have : IsClosedImmersion q := IsClosedImmersion.spec_of_surjective _
    (AlgHom.rangeRestrict_surjective (Algebra.ofId A B))
  have hcomp : p ≫ q = Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op := by
    change Scheme.Spec.map (CommRingCat.ofHom (algebraMap S B)).op ≫
        Scheme.Spec.map (CommRingCat.ofHom (algebraMap A S)).op = _
    rw [← Functor.map_comp]
    congr 1
  have hdenseq : DenseRange q := by
    apply DenseRange.of_comp (g := fun x => p x)
    have hf := (isDominant_iff _).mp hdom
    rwa [← hcomp] at hf
  have hsurjq : Function.Surjective q := by
    rw [← Set.range_eq_univ, ← q.isClosedEmbedding.isClosed_range.closure_eq]
    exact hdenseq.closure_range
  exact imageSubalgebra_spec_properties_of_surjective A B hsurjq

/-- A square-cube tower lying inside a subalgebra is a square-cube tower of that subalgebra. -/
private def liftSquareCubeTower {R B : Type u} [CommRing R] [CommRing B]
    [Algebra R B] (t : SquareCubeTower R B) (C : Subalgebra R B)
    (hTC : squareCubeTowerAlgebra t ≤ C) : SquareCubeTower R C := by
  let bC : Fin t.n → C := fun i => ⟨t.b i, hTC (Algebra.subset_adjoin ⟨i, rfl⟩)⟩
  refine ⟨t.n, bC, ?_⟩
  intro i
  have hprefix : Algebra.adjoin R (squareCubePrefix (R := R) (B := B) t.n t.b i) ≤
      squareCubeTowerAlgebra t :=
    Algebra.adjoin_mono (Set.range_subset_iff.2 fun j => ⟨Fin.castLE i.isLt.le j, rfl⟩)
  have h2C : (bC i : B) ^ 2 ∈ C := hTC (hprefix (t.valid i).1)
  have h3C : (bC i : B) ^ 3 ∈ C := hTC (hprefix (t.valid i).2)
  let pC : Fin i → C := fun j => bC (Fin.castLE i.isLt.le j)
  exact ⟨(mem_adjoin_subtype C i.val pC ⟨(bC i : B) ^ 2, h2C⟩).mp (t.valid i).1,
    (mem_adjoin_subtype C i.val pC ⟨(bC i : B) ^ 3, h3C⟩).mp (t.valid i).2⟩

private lemma relativeSeminormalizationOverImage_properties
    (R B : Type u) [CommRing R] [CommRing B] [Algebra R B]
    (hRB : Function.Injective (algebraMap R B)) :
    let D := relativeSeminormalizationOverImage R B
    UniversalHomeomorphism
        (Scheme.Spec.map (CommRingCat.ofHom (algebraMap R D)).op) ∧
      (∀ x, IsIso
        ((Scheme.Spec.map (CommRingCat.ofHom (algebraMap R D)).op).residueFieldMap x)) := by
  classical
  let D : Subalgebra R B := relativeSeminormalizationOverImage R B
  have hRD : Function.Injective (algebraMap R D) := fun x y hxy =>
    hRB (congrArg Subtype.val hxy)
  have hcoe : (D : Set B) = ⋃ t : SquareCubeTower R B,
      (squareCubeTowerAlgebra t : Set B) :=
    Subalgebra.coe_iSup_of_directed squareCubeTowerAlgebras_directed
  have hcover (E : Finset B) (hE : (E : Set B) ⊆ D) :
      ∃ t : SquareCubeTower R B, (E : Set B) ⊆ squareCubeTowerAlgebra t := by
    induction E using Finset.induction_on with
    | empty => exact ⟨Classical.choice inferInstance, by simp⟩
    | @insert b E hb ih =>
      obtain ⟨t₁, ht₁⟩ := ih fun x hx => hE (Finset.mem_insert_of_mem hx)
      have hbD : b ∈ (D : Set B) := hE (by simp)
      rw [hcoe] at hbD
      obtain ⟨t₂, ht₂⟩ := Set.mem_iUnion.mp hbD
      obtain ⟨t, ht₁t, ht₂t⟩ := squareCubeTowerAlgebras_directed t₁ t₂
      refine ⟨t, fun x hx => ?_⟩
      rcases Finset.mem_insert.mp hx with rfl | hxE
      · exact ht₂t ht₂
      · exact ht₁t (ht₁ hxE)
  have hTower : ∀ E : Finset D, ∃ (n : ℕ) (b : Fin n → D),
      (↑E : Set D) ⊆ Algebra.adjoin R (Set.range b) ∧
        ∀ i : Fin n,
          b i ^ 2 ∈ Algebra.adjoin R
              (Set.range (fun j : Fin i ↦ b (Fin.castLE i.isLt.le j))) ∧
            b i ^ 3 ∈ Algebra.adjoin R
              (Set.range (fun j : Fin i ↦ b (Fin.castLE i.isLt.le j))) := by
    intro E
    let EB : Finset B := E.image fun x : D => (x : B)
    have hEB : (EB : Set B) ⊆ D := by
      intro x hx
      rcases Finset.mem_image.mp hx with ⟨y, hy, rfl⟩
      exact y.property
    obtain ⟨t, ht⟩ := hcover EB hEB
    let T : Subalgebra R B := squareCubeTowerAlgebra t
    have hTD : T ≤ D := le_iSup (fun q : SquareCubeTower R B => squareCubeTowerAlgebra q) t
    let tT : SquareCubeTower R T := liftSquareCubeTower t T le_rfl
    let f : T →ₐ[R] D := T.inclusion hTD
    let bD : Fin tT.n → D := fun i => f (tT.b i)
    have hvalidD : squareCubeTowerValid (R := R) (B := D) tT.n bD := by
      intro i
      simpa [bD, squareCubePrefix, image_range_eq_range] using
        And.intro (algHom_mem_adjoin f (tT.valid i).1) (algHom_mem_adjoin f (tT.valid i).2)
    refine ⟨tT.n, bD, fun x hx => ?_, hvalidD⟩
    have hxT : (x : B) ∈ T := ht (Finset.mem_image.mpr ⟨x, hx, rfl⟩)
    let xT : T := ⟨x, hxT⟩
    have hxGen : xT ∈ Algebra.adjoin R (Set.range tT.b) :=
      (mem_adjoin_subtype T tT.n tT.b xT).mp (by
        simpa [T, squareCubeTowerAlgebra, tT, liftSquareCubeTower] using xT.property)
    have hxMap := algHom_mem_adjoin f hxGen
    have hfx : f xT = x := Subtype.ext rfl
    rw [hfx] at hxMap
    simpa [bD, image_range_eq_range] using hxMap
  exact (universalHomeomorphism_and_residueFieldIso_iff_finite_adjoin_square_cube
    (A := R) (B := D) hRD).mpr hTower

private lemma relativeSeminormalization_map_properties
    (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    (hdom : IsDominant
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op)) :
    let S : Subalgebra A B := (Algebra.ofId A B).range
    let D : Subalgebra S B := relativeSeminormalizationOverImage S B
    UniversalHomeomorphism
        (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A (D.restrictScalars A))).op) ∧
      (∀ x, IsIso ((Scheme.Spec.map
        (CommRingCat.ofHom (algebraMap A (D.restrictScalars A))).op).residueFieldMap x)) := by
  classical
  let S : Subalgebra A B := (Algebra.ofId A B).range
  let : Algebra S B := S.toAlgebra
  let : IsScalarTower A S B := inferInstance
  have hSB : Function.Injective (algebraMap S B) := fun _ _ h => Subtype.ext h
  let D : Subalgebra S B := relativeSeminormalizationOverImage S B
  let C : Subalgebra A B := D.restrictScalars A
  let : Algebra S C := (inferInstance : Algebra S D)
  let : IsScalarTower A S C := IsScalarTower.of_algebraMap_eq fun _ => rfl
  let f := Scheme.Spec.map (CommRingCat.ofHom (algebraMap S C)).op
  let q := Scheme.Spec.map (CommRingCat.ofHom (algebraMap A S)).op
  let g := Scheme.Spec.map (CommRingCat.ofHom (algebraMap A C)).op
  have hD := relativeSeminormalizationOverImage_properties S B hSB
  change UniversalHomeomorphism
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap S D)).op) ∧
    (∀ x, IsIso ((Scheme.Spec.map
      (CommRingCat.ofHom (algebraMap S D)).op).residueFieldMap x)) at hD
  have hImage := imageSubalgebra_properties A B hdom
  change UniversalHomeomorphism q ∧ (∀ x, IsIso (q.residueFieldMap x)) at hImage
  have hcomp : f ≫ q = g := by
    change Scheme.Spec.map (CommRingCat.ofHom (algebraMap S C)).op ≫
        Scheme.Spec.map (CommRingCat.ofHom (algebraMap A S)).op = _
    rw [← Functor.map_comp]
    congr 1
  have hUH : UniversalHomeomorphism g := by
    rw [← hcomp]
    exact universalHomeomorphism_hasTwoOutOfThreeProperty.toIsStableUnderComposition.comp_mem
      f q hD.1 hImage.1
  refine ⟨?_, ?_⟩
  · simpa [g, C, D, S] using hUH
  · intro x
    have hrescomp : IsIso ((f ≫ q).residueFieldMap x) := by
      rw [AlgebraicGeometry.Scheme.residueFieldMap_comp]
      have : IsIso (q.residueFieldMap (f x)) := hImage.2 (f x)
      have : IsIso (f.residueFieldMap x) := hD.2 x
      exact (asIso (q.residueFieldMap (f x)) ≪≫ asIso (f.residueFieldMap x)).isIso_hom
    have hresg : IsIso (g.residueFieldMap x) := by
      rw [← hcomp]
      exact hrescomp
    simpa [g, C, D, S] using hresg

private lemma image_inclusion_properties
    (A C : Type u) [CommRing A] [CommRing C] [Algebra A C]
    (hAC : UniversalHomeomorphism
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A C)).op))
    (hres : ∀ x, IsIso ((Scheme.Spec.map
      (CommRingCat.ofHom (algebraMap A C)).op).residueFieldMap x)) :
    let S : Subalgebra A C := (Algebra.ofId A C).range
    UniversalHomeomorphism
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap S C)).op) ∧
      (∀ x, IsIso ((Scheme.Spec.map
        (CommRingCat.ofHom (algebraMap S C)).op).residueFieldMap x)) := by
  classical
  let S : Subalgebra A C := (Algebra.ofId A C).range
  let : Algebra S C := S.toAlgebra
  let f := Scheme.Spec.map (CommRingCat.ofHom (algebraMap S C)).op
  let q := Scheme.Spec.map (CommRingCat.ofHom (algebraMap A S)).op
  let k := Scheme.Spec.map (CommRingCat.ofHom (algebraMap A C)).op
  have hcomp : f ≫ q = k := by
    change Scheme.Spec.map (CommRingCat.ofHom (algebraMap S C)).op ≫
        Scheme.Spec.map (CommRingCat.ofHom (algebraMap A S)).op = _
    rw [← Functor.map_comp]
    congr 1
  have hsurjK : Function.Surjective k :=
    (surjective_iff k).mp
      ((universalHomeomorphism_iff_integral_universallyInjective_surjective k).mp hAC).2.2
  have hsurjQ : Function.Surjective q := by
    intro y
    obtain ⟨x, hx⟩ := hsurjK y
    refine ⟨f x, ?_⟩
    change (f ≫ q) x = y
    rw [hcomp]
    exact hx
  have hq : UniversalHomeomorphism q :=
    (imageSubalgebra_spec_properties_of_surjective A C hsurjQ).1
  have hk : UniversalHomeomorphism (f ≫ q) := by
    rw [hcomp]
    exact hAC
  have hf : UniversalHomeomorphism f :=
    universalHomeomorphism_hasTwoOutOfThreeProperty.of_postcomp f q hq hk
  refine ⟨?_, ?_⟩
  · simpa [f, S] using hf
  · intro x
    have hkres : IsIso ((f ≫ q).residueFieldMap x) := by
      rw [hcomp]
      exact hres x
    have : IsIso (q.residueFieldMap (f x)) :=
      (imageSubalgebra_spec_properties_of_surjective A C hsurjQ).2 (f x)
    have : IsIso (q.residueFieldMap (f x) ≫ f.residueFieldMap x) := by
      rw [← AlgebraicGeometry.Scheme.residueFieldMap_comp]
      exact hkres
    have hfres : IsIso (f.residueFieldMap x) :=
      IsIso.of_isIso_comp_left (q.residueFieldMap (f x)) (f.residueFieldMap x)
    simpa [f, S] using hfres

/-- The relative seminormalization of `A` in `B`, for a dominant map `Spec B ⟶ Spec A`. -/
@[stacks 0H3L "the algebra"]
public noncomputable def relativeSeminormalization
    (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    (_hdom : IsDominant
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op)) :
    Subalgebra A B :=
  let S : Subalgebra A B := (Algebra.ofId A B).range
  letI : Algebra S B := S.toAlgebra
  (relativeSeminormalizationOverImage S B).restrictScalars A

/-- The spectrum of the relative seminormalization is universally homeomorphic to the spectrum of
the base. -/
@[stacks 0H3L "part (1), universal homeomorphism"]
public theorem relativeSeminormalization_universalHomeomorphism
    (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    (hdom : IsDominant
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op)) :
    UniversalHomeomorphism
      (Scheme.Spec.map (CommRingCat.ofHom
        (algebraMap A (relativeSeminormalization A B hdom))).op) :=
  (relativeSeminormalization_map_properties A B hdom).1

/-- The relative seminormalization induces isomorphisms on all residue fields. -/
@[stacks 0H3L "part (1), residue fields"]
public theorem relativeSeminormalization_residueFieldMap_isIso
    (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    (hdom : IsDominant
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op)) :
    let f := Scheme.Spec.map (CommRingCat.ofHom
      (algebraMap A (relativeSeminormalization A B hdom))).op
    ∀ x, IsIso (f.residueFieldMap x) :=
  (relativeSeminormalization_map_properties A B hdom).2

/-- Every intermediate algebra universally homeomorphic to the base and with unchanged residue
fields maps into the relative seminormalization. -/
@[stacks 0H3L "part (2)"]
public theorem map_mem_relativeSeminormalization
    (A B : Type u) [CommRing A] [CommRing B] [Algebra A B]
    (hdom : IsDominant
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A B)).op))
    {C : Type u} [CommRing C] [Algebra A C] (g : C →ₐ[A] B)
    [UniversalHomeomorphism
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A C)).op)]
    (hres : ∀ x, IsIso ((Scheme.Spec.map
      (CommRingCat.ofHom (algebraMap A C)).op).residueFieldMap x)) :
    ∀ c, g c ∈ relativeSeminormalization A B hdom := by
  classical
  let S : Subalgebra A C := (Algebra.ofId A C).range
  let : Algebra S C := S.toAlgebra
  have hSC := image_inclusion_properties A C
    (inferInstance : UniversalHomeomorphism
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap A C)).op)) hres
  change UniversalHomeomorphism
      (Scheme.Spec.map (CommRingCat.ofHom (algebraMap S C)).op) ∧
    (∀ x, IsIso ((Scheme.Spec.map
      (CommRingCat.ofHom (algebraMap S C)).op).residueFieldMap x)) at hSC
  have hfinite := (universalHomeomorphism_and_residueFieldIso_iff_finite_adjoin_square_cube
    (A := S) (B := C) fun _ _ h => Subtype.ext h).mp hSC
  let sToB : S →+* B := g.toRingHom.comp S.val
  let : Algebra S B := sToB.toAlgebra
  let f : C →ₐ[S] B :=
    { toRingHom := g.toRingHom
      commutes' := fun s => rfl }
  let T : Subalgebra A B := (Algebra.ofId A B).range
  let : Algebra T B := T.toAlgebra
  have hbase : ∀ s : S, algebraMap S B s ∈ T := by
    intro s
    change g s.val ∈ T
    obtain ⟨a, ha⟩ := s.property
    rw [← ha]
    change g (algebraMap A C a) ∈ T
    rw [g.commutes]
    exact T.algebraMap_mem a
  intro c
  obtain ⟨n, b, hc, hb⟩ := hfinite {c}
  let bB : Fin n → B := fun i => f (b i)
  have hvalid : squareCubeTowerValid (R := T) (B := B) n bB := by
    intro i
    let prev : Fin i → C := fun j => b (Fin.castLE i.isLt.le j)
    let prevB : Fin i → B := fun j => f (prev j)
    have hpow (k : ℕ) (hk : b i ^ k ∈ Algebra.adjoin S (Set.range prev)) :
        bB i ^ k ∈ Algebra.adjoin T (Set.range prevB) := by
      simpa [bB] using algHom_mem_adjoin_range_of_base T f hbase prev hk
    exact ⟨hpow 2 (hb i).1, hpow 3 (hb i).2⟩
  let t : SquareCubeTower T B := ⟨n, bB, hvalid⟩
  have hcAdjoin : c ∈ Algebra.adjoin S (Set.range b) := hc (by simp)
  have hmemTower : g c ∈ squareCubeTowerAlgebra t :=
    algHom_mem_adjoin_range_of_base T f hbase b hcAdjoin
  have hmem : g c ∈ relativeSeminormalizationOverImage T B :=
    le_iSup (fun q : SquareCubeTower T B => squareCubeTowerAlgebra q) t hmemTower
  simpa only [relativeSeminormalization, Subalgebra.mem_restrictScalars] using hmem

end AlgebraicGeometry

