module

public import StacksFrontier.AlgebraicGeometry.Morphisms.Fibres.BertiniChartChangeOfBasis
public import StacksFrontier.AlgebraicGeometry.Morphisms.Fibres.BertiniChartFractionField
public import StacksFrontier.AlgebraicGeometry.Morphisms.Fibres.BertiniChartSubstitution

/-!
# The generic fibre of the universal divisor on a chart of the Bertini situation

Let `A = Γ(U, ⊤) ⧸ √0` be the reduced chart ring of a trivializing affine chart in the Bertini
situation, with fraction field `K`, and let `Ω` be a fraction field of the chart ring
`A[xⱼ]/(∑ⱼ xⱼ fⱼ)` of the universal divisor over the chart, compatible with `K`. On a chart
carrying an invertible linear substitution of the parameters, `Ω` is geometrically irreducible
over the subfield generated over `k` by the images of the parameters, and these images are
algebraically independent over `k`.

## Main definitions

* `Stacks.Bertini.FamilyDivisors.reducedChartDivisorRing`: the chart ring
  `A[xⱼ : j ∈ basisIndex]/(∑ⱼ xⱼ fⱼ)` of the universal divisor over the reduced chart ring.

## Main results

* `Stacks.Bertini.FamilyDivisors.Hypotheses.isGeometricallyIrreducible_reducedChartDivisor`: the
  function field of the universal divisor over the chart is geometrically irreducible over the
  subfield generated by the parameters.
* `Stacks.Bertini.FamilyDivisors.Hypotheses.algebraicIndependent_reducedChartDivisor`: the images
  of the parameters are algebraically independent over `k`.
* `Stacks.Bertini.FamilyDivisors.Hypotheses.exists_chart_generic_fibre`: there is a chart on
  which the chart ring of the universal divisor is a domain and both conclusions hold for every
  compatible fraction field `Ω`.
* `Stacks.Bertini.FamilyDivisors.Hypotheses.isDomain_reducedChartDivisorRing` and
  `Stacks.Bertini.FamilyDivisors.injective_algebraMap_reducedChartDivisorRing`: on a chart
  carrying a substitution, the chart ring of the universal divisor is a domain and contains the
  reduced chart ring.

## References

* [Stacks Project, Tag 0G4F](https://stacks.math.columbia.edu/tag/0G4F)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

universe u v

namespace Stacks.Bertini.FamilyDivisors

variable {D : FamilyDivisors.{u, v}}

/-- The chart ring of the universal divisor over the reduced chart ring: the polynomial ring on
the parameters of the family modulo the universal linear form of the chart equations. -/
abbrev reducedChartDivisorRing (c : D.Chart) : Type u :=
  MvPolynomial D.basisIndex (reducedChartRing c.U) ⧸
    Ideal.span {Algebra.universalLinearForm (reducedChartEquation c)}

/-- If an invertible `k`-linear substitution of the parameters carries the chart equations to a
tuple `g` whose zeroth entry is a unit, then the chart ring of the universal divisor contains the
reduced chart ring. -/
theorem injective_algebraMap_reducedChartDivisorRing (c : D.Chart) {m : ℕ}
    (b : Matrix (Fin (m + 3)) D.basisIndex D.k) (b' : Matrix D.basisIndex (Fin (m + 3)) D.k)
    (hbb' : b * b' = 1) (hb'b : b' * b = 1) :
    letI := reducedChartAlgebra c.U
    ∀ (g : Fin (m + 3) → reducedChartRing c.U) (w : reducedChartRing c.U),
      (∀ i, g i = ∑ j : D.basisIndex,
          algebraMap D.k (reducedChartRing c.U) (b i j) * reducedChartEquation c j) →
      w * g ⟨0, by omega⟩ = 1 →
      Function.Injective (algebraMap (reducedChartRing c.U) (reducedChartDivisorRing c)) := by
  let := reducedChartAlgebra c.U
  intro g w hg hw
  exact Algebra.injective_algebraMap_quotient_span_universalLinearForm_of_linearSubst D.k
    (reducedChartRing c.U) (reducedChartEquation c) b b' hbb' hb'b g hg hw

namespace Hypotheses

variable (h : D.Hypotheses)

include h

/-- Let `Ω` be a fraction field of the chart ring of the universal divisor over the reduced chart
ring of a trivializing affine chart, compatibly with the fraction field `K` of the chart's own
domain. If an invertible `k`-linear substitution of the parameters carries the chart equations to
a tuple `g` whose zeroth entry is a unit and whose first two entries carry the codimension datum,
then `Ω` is geometrically irreducible over the subfield generated over `k` by the images of the
parameters. -/
@[stacks 0G4F "the generic fibre over a chart, from the tag's own hypotheses"]
theorem isGeometricallyIrreducible_reducedChartDivisor (c : D.Chart) {m : ℕ}
    (b : Matrix (Fin (m + 3)) D.basisIndex D.k) (b' : Matrix D.basisIndex (Fin (m + 3)) D.k)
    (hbb' : b * b' = 1) (hb'b : b' * b = 1) (Ω : Type u) [Field Ω] [Algebra D.k Ω] :
    letI := reducedChartAlgebra c.U
    ∀ [Algebra (reducedChartFractionRing c.U) Ω]
      [IsScalarTower D.k (reducedChartFractionRing c.U) Ω]
      [Algebra (reducedChartDivisorRing c) Ω] [IsFractionRing (reducedChartDivisorRing c) Ω]
      (g : Fin (m + 3) → reducedChartRing c.U) (w : reducedChartRing c.U),
      (∀ i, g i = ∑ j : D.basisIndex,
          algebraMap D.k (reducedChartRing c.U) (b i j) * reducedChartEquation c j) →
      w * g ⟨0, by omega⟩ = 1 →
      (∃ q : Ideal (reducedChartRing c.U),
        q ∈ (Ideal.span {g ⟨1, by omega⟩, g ⟨2, by omega⟩}).minimalPrimes ∧
          ringKrullDim (reducedChartRing c.U ⧸ q) + 2 = ringKrullDim (reducedChartRing c.U)) →
      (∀ a : reducedChartRing c.U,
        algebraMap (reducedChartFractionRing c.U) Ω
            (algebraMap (reducedChartRing c.U) (reducedChartFractionRing c.U) a) =
          Algebra.universalDivisorChartMap (reducedChartRing c.U) Ω (reducedChartEquation c)
            (MvPolynomial.C a)) →
      letI F : IntermediateField D.k Ω :=
        IntermediateField.adjoin D.k
          (Set.range fun j : D.basisIndex =>
            Algebra.universalDivisorChartMap (reducedChartRing c.U) Ω (reducedChartEquation c)
              (MvPolynomial.X j))
      letI : Algebra F Ω := F.toSubalgebra.toAlgebra
      Algebra.IsGeometricallyIrreducible F Ω := by
  let := reducedChartAlgebra c.U
  intro _ _ _ _ g w hg hw hcodim hcompat
  have := h.isDomain_reducedChartRing c
  have := h.algebraFiniteType_reducedChartRing c
  have := isScalarTower_reducedChartFractionRing (D := D) c.U
  exact Algebra.isGeometricallyIrreducible_universalDivisorChart_of_linearSubst D.k
    (reducedChartRing c.U) (reducedChartFractionRing c.U) Ω (reducedChartEquation c) b b'
    hbb' hb'b (by omega) g hg hw hcompat
    (h.isGeometricallyIrreducible_reducedChartFractionRing c) hcodim

/-- In the situation of
`Stacks.Bertini.FamilyDivisors.Hypotheses.isGeometricallyIrreducible_reducedChartDivisor` the
images of the parameters of the family in `Ω` are algebraically independent over `k`. -/
@[stacks 0G4F "the dominance over the parameter space, from the tag's own hypotheses"]
theorem algebraicIndependent_reducedChartDivisor (c : D.Chart) {m : ℕ}
    (b : Matrix (Fin (m + 3)) D.basisIndex D.k) (b' : Matrix D.basisIndex (Fin (m + 3)) D.k)
    (hbb' : b * b' = 1) (hb'b : b' * b = 1) (Ω : Type u) [Field Ω] [Algebra D.k Ω] :
    letI := reducedChartAlgebra c.U
    ∀ [Algebra (reducedChartFractionRing c.U) Ω]
      [IsScalarTower D.k (reducedChartFractionRing c.U) Ω]
      [Algebra (reducedChartDivisorRing c) Ω] [IsFractionRing (reducedChartDivisorRing c) Ω]
      (g : Fin (m + 3) → reducedChartRing c.U) (w : reducedChartRing c.U),
      (∀ i, g i = ∑ j : D.basisIndex,
          algebraMap D.k (reducedChartRing c.U) (b i j) * reducedChartEquation c j) →
      w * g ⟨0, by omega⟩ = 1 →
      (∃ q : Ideal (reducedChartRing c.U),
        q ∈ (Ideal.span {g ⟨1, by omega⟩, g ⟨2, by omega⟩}).minimalPrimes ∧
          ringKrullDim (reducedChartRing c.U ⧸ q) + 2 = ringKrullDim (reducedChartRing c.U)) →
      (∀ a : reducedChartRing c.U,
        algebraMap (reducedChartFractionRing c.U) Ω
            (algebraMap (reducedChartRing c.U) (reducedChartFractionRing c.U) a) =
          Algebra.universalDivisorChartMap (reducedChartRing c.U) Ω (reducedChartEquation c)
            (MvPolynomial.C a)) →
      AlgebraicIndependent D.k fun j : D.basisIndex =>
        Algebra.universalDivisorChartMap (reducedChartRing c.U) Ω (reducedChartEquation c)
          (MvPolynomial.X j) := by
  let := reducedChartAlgebra c.U
  intro _ _ _ _ g w hg hw hcodim hcompat
  have := h.isDomain_reducedChartRing c
  have := h.algebraFiniteType_reducedChartRing c
  have := isScalarTower_reducedChartFractionRing (D := D) c.U
  exact Algebra.algebraicIndependent_universalDivisorChartMap_X_of_linearSubst D.k
    (reducedChartRing c.U) (reducedChartFractionRing c.U) Ω (reducedChartEquation c) b b'
    hbb' hb'b (by omega) g hg hw hcompat hcodim

/-- If an invertible `k`-linear substitution of the parameters carries the chart equations to a
tuple `g` whose zeroth entry is a unit, then the chart ring of the universal divisor over the
reduced chart ring is a domain. -/
theorem isDomain_reducedChartDivisorRing (c : D.Chart) {m : ℕ}
    (b : Matrix (Fin (m + 3)) D.basisIndex D.k) (b' : Matrix D.basisIndex (Fin (m + 3)) D.k)
    (hbb' : b * b' = 1) (hb'b : b' * b = 1) :
    letI := reducedChartAlgebra c.U
    ∀ (g : Fin (m + 3) → reducedChartRing c.U) (w : reducedChartRing c.U),
      (∀ i, g i = ∑ j : D.basisIndex,
          algebraMap D.k (reducedChartRing c.U) (b i j) * reducedChartEquation c j) →
      w * g ⟨0, by omega⟩ = 1 →
      IsDomain (reducedChartDivisorRing c) := by
  let := reducedChartAlgebra c.U
  intro g w hg hw
  have := h.isDomain_reducedChartRing c
  exact Algebra.isDomain_quotient_span_universalLinearForm_of_linearSubst D.k
    (reducedChartRing c.U) (reducedChartEquation c) b b' hbb' hb'b g hg hw

/-- There is a trivializing affine chart whose chart ring of the universal divisor is a domain
and on which, for every fraction field `Ω` of that ring compatible with the chart's own fraction
field, the function field of the universal divisor is geometrically irreducible over the subfield
generated by the parameters and the parameters are algebraically independent over `k`. -/
@[stacks 0G4F "the generic fibre and the dominance on a chart, from the tag's own hypotheses"]
theorem exists_chart_generic_fibre :
    ∃ c : D.Chart,
      IsDomain (reducedChartDivisorRing c) ∧
      letI := reducedChartAlgebra c.U
      ∀ (Ω : Type u) [Field Ω] [Algebra D.k Ω] [Algebra (reducedChartFractionRing c.U) Ω]
        [IsScalarTower D.k (reducedChartFractionRing c.U) Ω]
        [Algebra (reducedChartDivisorRing c) Ω] [IsFractionRing (reducedChartDivisorRing c) Ω],
      (∀ a : reducedChartRing c.U,
        algebraMap (reducedChartFractionRing c.U) Ω
            (algebraMap (reducedChartRing c.U) (reducedChartFractionRing c.U) a) =
          Algebra.universalDivisorChartMap (reducedChartRing c.U) Ω (reducedChartEquation c)
            (MvPolynomial.C a)) →
      (AlgebraicIndependent D.k fun j : D.basisIndex =>
        Algebra.universalDivisorChartMap (reducedChartRing c.U) Ω (reducedChartEquation c)
          (MvPolynomial.X j)) ∧
      letI F : IntermediateField D.k Ω :=
        IntermediateField.adjoin D.k
          (Set.range fun j : D.basisIndex =>
            Algebra.universalDivisorChartMap (reducedChartRing c.U) Ω (reducedChartEquation c)
              (MvPolynomial.X j))
      letI : Algebra F Ω := F.toSubalgebra.toAlgebra
      Algebra.IsGeometricallyIrreducible F Ω := by
  obtain ⟨c, m, b, b', hbb', hb'b, hrest⟩ := h.exists_chart_substitution
  let := reducedChartAlgebra c.U
  obtain ⟨g, w, hg, hw, hcodim⟩ := hrest
  refine ⟨c, h.isDomain_reducedChartDivisorRing c b b' hbb' hb'b g w hg hw,
    fun Ω _ _ _ _ _ _ hcompat ↦ ?_⟩
  exact ⟨h.algebraicIndependent_reducedChartDivisor c b b' hbb' hb'b Ω g w hg hw hcodim hcompat,
    h.isGeometricallyIrreducible_reducedChartDivisor c b b' hbb' hb'b Ω g w hg hw hcodim hcompat⟩

end Hypotheses

end Stacks.Bertini.FamilyDivisors

end
