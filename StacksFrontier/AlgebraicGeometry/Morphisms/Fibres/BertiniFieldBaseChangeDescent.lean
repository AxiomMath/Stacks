-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits

universe u

namespace AlgebraicGeometry

/-- **The zero scheme of the zero section is the whole scheme.** The defining ideal of `Z(s)` on
an affine open is generated by the values `φ (s|_U)` of the `Γ(X, U)`-linear functionals on
`Γ(L, U)` ([Stacks, Tag 02OQ], `AlgebraicGeometry.zeroScheme_ideal`); at `s = 0` every one of
those values is `0`, so the ideal is the zero ideal on every affine open. -/
theorem zeroScheme_zero {X : Scheme.{u}} (L : X.Modules)
    [SheafOfModules.IsInvertible X.sheaf.obj X.ringCatSheaf.property L] :
    zeroScheme X L 0 = ⊥ := by
  ext U
  rw [zeroScheme_ideal]
  simp

end AlgebraicGeometry

namespace Stacks.Bertini.FamilyDivisors

variable (D : FamilyDivisors.{u, u}) (K : Type u) [Field K] [Algebra D.k K]

/-- **The reindexing of parameter spaces** `𝔸^r_K ⟶ 𝔸^{r'}_K` along
`dim_K (K ⊗_k V) = dim_k V`, from the index set of the original situation to that of the base
changed one. -/
def parameterBaseReindex :
    𝔸(D.basisIndex; Spec (.of (D.baseChangeFamily K).k)) ⟶
      (D.baseChangeFamily K).parameterBase :=
  AffineSpace.reindex (D.baseChangeFamilyBasisIndexEquiv K)
    (Spec (.of (D.baseChangeFamily K).k))

/-- The reindexing in the other direction. -/
def parameterBaseReindexInv :
    (D.baseChangeFamily K).parameterBase ⟶
      𝔸(D.basisIndex; Spec (.of (D.baseChangeFamily K).k)) :=
  AffineSpace.reindex (D.baseChangeFamilyBasisIndexEquiv K).symm
    (Spec (.of (D.baseChangeFamily K).k))

/-- The two reindexings are inverse to each other, the index sets being in bijection. -/
theorem parameterBaseReindexInv_comp_parameterBaseReindex :
    D.parameterBaseReindexInv K ≫ D.parameterBaseReindex K = 𝟙 _ := by
  refine AffineSpace.hom_ext ?_ fun j => ?_
  · rw [Category.assoc, parameterBaseReindex, parameterBaseReindexInv,
      AffineSpace.reindex_over, AffineSpace.reindex_over, Category.id_comp]
  · rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, parameterBaseReindex,
      parameterBaseReindexInv, AffineSpace.reindex_appTop_coord,
      AffineSpace.reindex_appTop_coord, Equiv.symm_apply_apply, Scheme.Hom.id_appTop]
    rfl

/-- The preimage of a nonempty open of the parameter space of the base-changed situation under
the reindexing is nonempty. -/
theorem nonempty_preimage_parameterBaseReindex
    {U : ((D.baseChangeFamily K).parameterBase).Opens} (hU : U.1.Nonempty) :
    (D.parameterBaseReindex K ⁻¹ᵁ U).1.Nonempty := by
  obtain ⟨x, hx⟩ := hU
  refine ⟨(D.parameterBaseReindexInv K).base x, ?_⟩
  change (D.parameterBaseReindex K).base ((D.parameterBaseReindexInv K).base x) ∈ U
  rw [← Scheme.Hom.comp_apply, D.parameterBaseReindexInv_comp_parameterBaseReindex K]
  exact hx

variable (M : Type u) [Field M] [Algebra D.k M] [Algebra K M] [IsScalarTower D.k K M]

/-- **The `M`-point of `𝔸^r_K` with coordinate tuple `c`**, indexed by the index set of the
original situation. -/
def parameterPointOver (c : Fin (Module.finrank D.k D.V) → M) :
    Spec (.of M) ⟶ 𝔸(D.basisIndex; Spec (.of (D.baseChangeFamily K).k)) :=
  AffineSpace.homOfVector
    (Spec.map (CommRingCat.ofHom (algebraMap (D.baseChangeFamily K).k M)))
    (fun i => (Scheme.ΓSpecIso (.of M)).inv (c i.down))

/-- `Spec M ⟶ Spec k` factors through `Spec K`. -/
theorem specMap_algebraMap_comp :
    Spec.map (CommRingCat.ofHom (algebraMap K M)) ≫
        Spec.map (CommRingCat.ofHom (algebraMap D.k K)) =
      Spec.map (CommRingCat.ofHom (algebraMap D.k M)) := by
  have h : (algebraMap K M).comp (algebraMap D.k K) = algebraMap D.k M := by
    ext t
    rw [RingHom.comp_apply, ← IsScalarTower.algebraMap_apply]
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, h]

omit [Algebra D.k M] [IsScalarTower D.k K M] in
/-- **The parameter point of the base-changed situation, read through the reindexing.** -/
theorem parameterBaseReindex_parameterPointOver
    (c : Fin (Module.finrank D.k D.V) → M)
    (a' : Fin (Module.finrank (D.baseChangeFamily K).k (D.baseChangeFamily K).V) → M)
    (ha' : ∀ j, a' j = c (finCongr (D.finrank_baseChangeFamily K) j)) :
    D.parameterPointOver K M c ≫ D.parameterBaseReindex K =
      (D.baseChangeFamily K).parameterPoint a' := by
  refine AffineSpace.hom_ext ?_ fun j => ?_
  · rw [Category.assoc, parameterBaseReindex, AffineSpace.reindex_over, parameterPointOver,
      AffineSpace.homOfVector_over, (D.baseChangeFamily K).parameterPoint_comp_base M a']
  · rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, parameterBaseReindex,
      AffineSpace.reindex_appTop_coord, parameterPointOver,
      AffineSpace.homOfVector_appTop_coord,
      (D.baseChangeFamily K).parameterPoint_appTop_coord M a' j, ha' j.down]
    rfl

/-- **The parameter point of the original situation, read through the base change of parameter
spaces.** -/
theorem map_parameterPointOver (c : Fin (Module.finrank D.k D.V) → M) :
    D.parameterPointOver K M c ≫
        AffineSpace.map D.basisIndex
          (Spec.map (CommRingCat.ofHom (algebraMap D.k K))) =
      D.parameterPoint c := by
  refine AffineSpace.hom_ext ?_ fun i => ?_
  · rw [Category.assoc, AffineSpace.map_over, ← Category.assoc, parameterPointOver,
      AffineSpace.homOfVector_over, D.parameterPoint_comp_base M c]
    exact D.specMap_algebraMap_comp K M
  · rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, AffineSpace.map_appTop_coord,
      parameterPointOver, AffineSpace.homOfVector_appTop_coord,
      D.parameterPoint_appTop_coord M c i]

/-- **A coordinate tuple read in a bigger field gives the same point of the parameter space.** -/
theorem parameterPoint_algebraMap (F : Type u) [Field F] [Algebra D.k F] [Algebra F M]
    [IsScalarTower D.k F M] (a : Fin (Module.finrank D.k D.V) → F) :
    D.parameterPoint (fun i => algebraMap F M (a i)) =
      Spec.map (CommRingCat.ofHom (algebraMap F M)) ≫ D.parameterPoint a := by
  refine AffineSpace.hom_ext ?_ fun i => ?_
  · rw [Category.assoc, D.parameterPoint_comp_base F a, D.parameterPoint_comp_base M _]
    exact (D.specMap_algebraMap_comp F M).symm
  · rw [Scheme.Hom.comp_appTop, CommRingCat.comp_apply, D.parameterPoint_appTop_coord F a i,
      D.parameterPoint_appTop_coord M _ i, appTop_specMap_algebraMap F M (a i.down)]

/-- **Smoothness over a field descends along a field extension, in cartesian-square form.**
If `g : Y ⟶ Spec K'` is the base change of `f : X ⟶ Spec k'` along `K'/k'` and `g` is smooth,
then so is `f`. This is `AlgebraicGeometry.smooth_of_smooth_pullback_snd_spec_algebraMap` read on
an arbitrary cartesian square rather than on the chosen pullback. -/
theorem smooth_of_isPullback_spec_algebraMap (k' K' : Type u) [Field k'] [Field K']
    [Algebra k' K'] {X Y : Scheme.{u}} {f : X ⟶ Spec (.of k')} {g : Y ⟶ Spec (.of K')}
    {p : Y ⟶ X} (h : IsPullback p g f (Spec.map (CommRingCat.ofHom (algebraMap k' K'))))
    (hg : Smooth g) : Smooth f := by
  refine MorphismProperty.of_isPullback_of_descendsAlong
    (P := @Smooth) (Q := @Surjective ⊓ @Flat ⊓ @QuasiCompact) h.flip ?_ hg
  obtain ⟨hs, hfl, hqc⟩ := Stacks.QuasiProjectiveFieldDescent.faithfullyFlat_extensionMap k' K'
  exact ⟨⟨hs, hfl⟩, hqc⟩

/-- **The conclusion of [Stacks, Tag 0FD6] descends from an algebraic closure of the base field
to the base field.** If the divisor `H_w` is smooth for general `w` in the situation base changed
to `k̄`, then `H_v` is smooth for general `v` in the original situation.

The nonempty open of `𝔸^r_k` is the one
`AlgebraicGeometry.AffineSpace.exists_nonempty_preimage_map_le` produces from the nonempty open
of `𝔸^r_{k̄}` supplied by the hypothesis. For a field extension `k'/k` and a `k'`-point of that
open, the divisor is read over `M = \overline{k'}`, an extension of `k̄` by `IsAlgClosed.lift`; the
point of `𝔸^r_{k̄}` it determines lies in the given open, so the hypothesis applies to it, and the
divisor over `M` is the base change of the one over `k'`
(`Stacks.Bertini.FamilyDivisors.exists_isPullback_specializedDivisor_baseChangeFamily`), whose
smoothness therefore follows by flat descent
(`AlgebraicGeometry.smooth_of_smooth_pullback_snd_spec_algebraMap`). -/
theorem forGeneral_smooth_specializedDivisor_of_forGeneral_baseChangeAlgebraicClosure
    (h : D.baseChangeAlgebraicClosure.ForGeneral (fun K' _ _ w =>
      ∀ a : Fin (Module.finrank D.baseChangeAlgebraicClosure.k
          D.baseChangeAlgebraicClosure.V) → K',
        w = ∑ i, TensorProduct.tmul D.baseChangeAlgebraicClosure.k
            (D.baseChangeAlgebraicClosure.basis i) (a i) →
          Smooth ((D.baseChangeAlgebraicClosure.specializedDivisor K' a).subschemeι ≫
            D.baseChangeAlgebraicClosure.baseChangeToSpec K'))) :
    D.ForGeneral (fun F _ _ w =>
      ∀ a : Fin (Module.finrank D.k D.V) → F,
        w = ∑ i, TensorProduct.tmul D.k (D.basis i) (a i) →
          Smooth ((D.specializedDivisor F a).subschemeι ≫ D.baseChangeToSpec F)) := by
  obtain ⟨U, hUne, hU⟩ := h
  obtain ⟨U₀, hU₀ne, hU₀⟩ := AlgebraicGeometry.AffineSpace.exists_nonempty_preimage_map_le
    (n := D.basisIndex) D.k (AlgebraicClosure D.k)
    (D.parameterBaseReindex (AlgebraicClosure D.k) ⁻¹ᵁ U)
    (D.nonempty_preimage_parameterBaseReindex (AlgebraicClosure D.k) hUne)
  refine ⟨U₀, hU₀ne, ?_⟩
  intro F _ _ a hmem a₂ heq
  obtain rfl := D.coordinates_injective F a a₂ heq
  -- the algebraic closure of `F`, an extension of `k̄` over `k`
  let : Algebra (AlgebraicClosure D.k) (AlgebraicClosure F) :=
    (IsAlgClosed.lift (R := D.k) (S := AlgebraicClosure D.k)
      (M := AlgebraicClosure F)).toRingHom.toAlgebra
  have : IsScalarTower D.k (AlgebraicClosure D.k) (AlgebraicClosure F) :=
    IsScalarTower.of_algebraMap_eq fun x =>
      ((IsAlgClosed.lift (R := D.k) (S := AlgebraicClosure D.k)
        (M := AlgebraicClosure F)).commutes x).symm
  -- the point of `𝔸^r_{k̄}` determined by the tuple, read over the algebraic closure of `F`
  have hmem' : ∀ q : Spec (.of (AlgebraicClosure F)),
      D.baseChangeAlgebraicClosure.parameterPoint
        (fun j => algebraMap F (AlgebraicClosure F)
          (a (finCongr (D.finrank_baseChangeFamily (AlgebraicClosure D.k)) j))) q ∈ U := by
    intro q
    rw [← D.parameterBaseReindex_parameterPointOver (AlgebraicClosure D.k) (AlgebraicClosure F)
      (fun i => algebraMap F (AlgebraicClosure F) (a i)) _ fun j => rfl]
    refine hU₀ ?_
    have hmem2 : (D.parameterPoint (fun i => algebraMap F (AlgebraicClosure F) (a i))) q ∈ U₀ := by
      rw [D.parameterPoint_algebraMap (AlgebraicClosure F) F a]
      exact hmem _
    rw [← D.map_parameterPointOver (AlgebraicClosure D.k) (AlgebraicClosure F)
      (fun i => algebraMap F (AlgebraicClosure F) (a i))] at hmem2
    exact hmem2
  -- smoothness over the algebraic closure of `F`, then flat descent
  obtain ⟨p, hp⟩ := D.exists_isPullback_specializedDivisor_baseChangeFamily
    (AlgebraicClosure D.k) F (AlgebraicClosure F) a
    (fun j => algebraMap F (AlgebraicClosure F)
      (a (finCongr (D.finrank_baseChangeFamily (AlgebraicClosure D.k)) j))) fun j => rfl
  exact smooth_of_isPullback_spec_algebraMap F (AlgebraicClosure F) hp
    (hU (AlgebraicClosure F) _ hmem' _ rfl)

/-- **[Stacks, Tag 0FD6].** In the standing situation of [Stacks, Tag 0G47] with `X` smooth over
a field `k`, if the image of `ψ` generates `L` and the morphism `φ_{L,ψ} : X → 𝐏(V)` it
determines is an immersion, then the divisor `H_v` is smooth over `k'` for general
`v ∈ V ⊗_k k'`.

This is the statement with **no hypothesis that `k` be algebraically closed**: that case is
`Stacks.Bertini.FamilyDivisors.forGeneral_smooth_specializedDivisor_of_generates_pointwise_of_`
`basis'`, and the reduction of [Stacks, Tag 02FY] to it is
`Stacks.Bertini.FamilyDivisors.forGeneral_smooth_specializedDivisor_baseChange`
`AlgebraicClosure` followed by
`Stacks.Bertini.FamilyDivisors.forGeneral_smooth_specializedDivisor_of_forGeneral_`
`baseChangeAlgebraicClosure`.

Hypothesis (3) is read at a basis of `V` indexed by `Fin (m + 1)`, which forces `dim_k V ≥ 1`;
the degenerate case is added in
`Stacks.Bertini.FamilyDivisors.forGeneral_smooth_specializedDivisor`, and the statement with (3)
on the canonical morphism `φ_{L,ψ}` of [Stacks, Tag 0FCY] is
`Stacks.Bertini.FamilyDivisors.forGeneral_smooth_specializedDivisor_of_isImmersion_`
`canonicalMorphism`. (1) is the instance `[Smooth D.toBase]`, (2) is `hgen`, quasi-compactness
of `X` is derived rather than assumed, and no dimension datum or proof obligation is taken. -/
theorem forGeneral_smooth_specializedDivisor_of_basis [Smooth D.toBase] (hgen : D.Generates)
    {m : ℕ} (b : Module.Basis (Fin (m + 1)) D.k D.V)
    (himm : D.IsImmersive b (D.generatesBy_basis hgen b)) :
    D.ForGeneral (fun K _ _ w =>
      ∀ a : Fin (Module.finrank D.k D.V) → K,
        w = ∑ i, TensorProduct.tmul D.k (D.basis i) (a i) →
          Smooth ((D.specializedDivisor K a).subschemeι ≫ D.baseChangeToSpec K)) :=
  D.forGeneral_smooth_specializedDivisor_of_forGeneral_baseChangeAlgebraicClosure
    (D.forGeneral_smooth_specializedDivisor_baseChangeAlgebraicClosure hgen b himm)

/-! ### The degenerate case `dim V = 0` -/

/-- **`H_v = X` when the linear system is zero.** The section `ψ(v) = Σᵢ aᵢ ψ(vᵢ)` is a sum over
`Fin (dim V)`, so it is the empty sum `0` when `dim V = 0`, and the zero scheme of the zero
section is the whole scheme. -/
theorem specializedDivisor_eq_bot_of_finrank_eq_zero (h0 : Module.finrank D.k D.V = 0)
    (a : Fin (Module.finrank D.k D.V) → K) : D.specializedDivisor K a = ⊥ := by
  have : IsEmpty (Fin (Module.finrank D.k D.V)) := by rw [h0]; infer_instance
  have hsec : D.specializedSection K a = 0 := by
    simp only [specializedSection, Finset.univ_eq_empty, Finset.sum_empty]
  rw [specializedDivisor, hsec, zeroScheme_zero]

/-- **[Stacks, Tag 0FD6] in the degenerate case `dim V = 0`**, where hypothesis (1) alone gives
the conclusion.

The linear system being zero, the only vector of `V ⊗_k k'` is `0` and `H_0 = X_{k'}` by
`Stacks.Bertini.FamilyDivisors.specializedDivisor_eq_bot_of_finrank_eq_zero`; so the morphism
whose smoothness is asserted is an isomorphism followed by `X_{k'} → Spec k'`, which is smooth
because hypothesis (1) is stable under base change
(`Stacks.Bertini.FamilyDivisors.smooth_baseChangeFamily`). Nothing is asked of the parameter
point, so the nonempty open of the definition of `ForGeneral` is all of
`𝔸^0_k = Spec k`, nonempty because `𝔸^r_k` is irreducible. -/
theorem forGeneral_smooth_specializedDivisor_of_finrank_eq_zero [Smooth D.toBase]
    (h0 : Module.finrank D.k D.V = 0) :
    D.ForGeneral (fun K _ _ w =>
      ∀ a : Fin (Module.finrank D.k D.V) → K,
        w = ∑ i, TensorProduct.tmul D.k (D.basis i) (a i) →
          Smooth ((D.specializedDivisor K a).subschemeι ≫ D.baseChangeToSpec K)) := by
  have := D.irreducibleSpace_parameterBase
  refine ⟨⊤, ?_, ?_⟩
  · exact Set.univ_nonempty
  · intro F _ _ _ _ a _
    have : IsIso (D.specializedDivisor F a).subschemeι :=
      (Scheme.isIso_subschemeι_iff_eq_bot _).mpr
        (D.specializedDivisor_eq_bot_of_finrank_eq_zero F h0 a)
    have : Smooth (D.baseChangeToSpec F) := D.smooth_baseChangeFamily F
    infer_instance

/-- **[Stacks, Tag 0FD6].** In the standing situation of [Stacks, Tag 0G47] with `X` smooth over
a field `k`, if the image of `ψ` generates `L` and the morphism `φ_{L,ψ} : X → 𝐏(V)` it
determines is an immersion, then the divisor `H_v` is smooth over `k'` for general
`v ∈ V ⊗_k k'`.

This takes the data of [Stacks, Tag 0G47] — the field `k`, the scheme `X` over it, the
invertible module `L`, the finite dimensional linear system `V` with its basis, and `ψ` — and
the source's three hypotheses, and nothing else: (1) is the instance `[Smooth D.toBase]`, (2) is
`hgen`, and (3) is `himm`. There is no hypothesis that `k` be algebraically closed, no
quasi-compactness assumption, no dimension datum, no proof obligation, and no condition on
`dim V`: the degenerate case `dim V = 0` that the source allows is
`Stacks.Bertini.FamilyDivisors.forGeneral_smooth_specializedDivisor_of_finrank_eq_zero`, and
`dim V ≥ 1` is
`Stacks.Bertini.FamilyDivisors.forGeneral_smooth_specializedDivisor_of_basis`, the basis of the
standing situation reindexed along `dim V = m + 1`.

Hypothesis (3) is read at every basis of `V` indexed by some `Fin (m + 1)` rather than at one:
that is not a strengthening, because by
`Stacks.Bertini.FamilyDivisors.isImmersive_congr_basis'` the hypothesis holds at one such basis
exactly when it holds at all of them, and when `dim V = 0` there are none and `himm` says
nothing — which is what lets the degenerate case be covered at all.

Hypothesis (3) is spelled through the morphism built from a basis; the same statement with (3)
on the canonical morphism `φ_{L,ψ}` of [Stacks, Tag 0FCY] is
`Stacks.Bertini.FamilyDivisors.forGeneral_smooth_specializedDivisor_of_isImmersion_`
`canonicalMorphism`, which is how the tag is
registered. -/
theorem forGeneral_smooth_specializedDivisor [Smooth D.toBase] (hgen : D.Generates)
    (himm : ∀ (m : ℕ) (b : Module.Basis (Fin (m + 1)) D.k D.V),
      D.IsImmersive b (D.generatesBy_basis hgen b)) :
    D.ForGeneral (fun K _ _ w =>
      ∀ a : Fin (Module.finrank D.k D.V) → K,
        w = ∑ i, TensorProduct.tmul D.k (D.basis i) (a i) →
          Smooth ((D.specializedDivisor K a).subschemeι ≫ D.baseChangeToSpec K)) := by
  rcases Nat.eq_zero_or_pos (Module.finrank D.k D.V) with h0 | hpos
  · exact D.forGeneral_smooth_specializedDivisor_of_finrank_eq_zero h0
  · obtain ⟨m, hm⟩ : ∃ m, Module.finrank D.k D.V = m + 1 :=
      ⟨_, (Nat.succ_pred_eq_of_pos hpos).symm⟩
    exact D.forGeneral_smooth_specializedDivisor_of_basis hgen
      (D.basis.reindex (finCongr hm)) (himm m _)

end Stacks.Bertini.FamilyDivisors

end
