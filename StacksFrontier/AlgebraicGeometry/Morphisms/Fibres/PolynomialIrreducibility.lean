/-!
# Irreducibility of specializations of a polynomial

An absolutely irreducible polynomial over a domain remains irreducible after every
field-valued specialization on some nonempty principal open subset of the domain.

## Main results

* `MvPolynomial.exists_away_irreducible_map`: an absolutely irreducible multivariate
  polynomial has irreducible specializations over a nonempty principal open subset.

## Implementation notes

The polynomial ring in finitely many variables is represented by `MvPolynomial ι A`, where `ι`
is a finite type. The algebraic closure used to test absolute irreducibility is allowed to be
any algebraically closed extension of the fraction field. A specialization over the principal
open determined by `f` is represented by a ring homomorphism from `Localization.Away f`.

The universal factors are bounded by total degree. Auxiliary variables express that an ideal
generated by their nonconstant coefficients contains one, so their specializations are
nonconstant. The Nullstellensatz and localization then give a nonzero constant in the ideal of
factorization equations.

## References

* [Stacks Project, Tag 0557](https://stacks.math.columbia.edu/tag/0557)
-/

@[expose] public section

universe u v w x y

namespace MvPolynomial

attribute [local instance] MvPolynomial.algebraMvPolynomial

/-- If no point of an algebraically closed extension annihilates an ideal of the polynomial
ring, then the ideal contains a nonzero constant. -/
private lemma exists_nonzero_constant_mem
    (A K L τ : Type*) [CommRing A] [IsDomain A]
    [Field K] [Algebra A K] [IsFractionRing A K]
    [Field L] [Algebra K L] [IsAlgClosed L] [Finite τ]
    (I : Ideal (MvPolynomial τ A))
    (h : ∀ x : τ → L, ¬ ∀ p ∈ I,
      eval₂Hom ((algebraMap K L).comp (algebraMap A K)) x p = 0) :
    ∃ f : A, f ≠ 0 ∧ C f ∈ I := by
  classical
  let J := I.map (algebraMap (MvPolynomial τ A) (MvPolynomial τ K))
  have hJ : J = ⊤ := by
    by_contra hJ
    obtain ⟨m, hm, hJm⟩ := Ideal.exists_le_maximal J hJ
    obtain ⟨x, hx⟩ := eq_vanishingIdeal_singleton_of_isMaximal L hm
    apply h x
    intro p hp
    have hp' := hJm (Ideal.mem_map_of_mem
      (algebraMap (MvPolynomial τ A) (MvPolynomial τ K)) hp)
    rw [hx, mem_vanishingIdeal_singleton_iff] at hp'
    simpa only [MvPolynomial.algebraMap_def, aeval_eq_eval₂Hom, eval₂Hom_map_hom] using hp'
  have h1 : algebraMap (MvPolynomial τ A) (MvPolynomial τ K) 1 ∈ J := by simp [hJ]
  obtain ⟨m, hm, hmI⟩ :=
    (IsLocalization.algebraMap_mem_map_algebraMap_iff
      ((nonZeroDivisors A).map (C (σ := τ))) (MvPolynomial τ K) I 1).mp h1
  obtain ⟨f, hf, rfl⟩ := hm
  exact ⟨f, mem_nonZeroDivisors_iff_ne_zero.mp hf, by simpa using hmI⟩

/-- A nonzero non-unit polynomial over a field has a nonzero coefficient in positive degree. -/
private lemma exists_nonzero_coeff_of_not_isUnit
    {R ι : Type*} [Field R] {p : MvPolynomial ι R}
    (hp : p ≠ 0) (hu : ¬ IsUnit p) :
    ∃ d : ι →₀ ℕ, d ≠ 0 ∧ p.coeff d ≠ 0 := by
  classical
  by_contra! h
  have he : p = C (p.coeff 0) := by
    ext d
    by_cases hd : d = 0
    · simp [hd]
    · simp [coeff_C_of_ne_zero hd, h d hd]
  apply hu
  rw [he]
  apply IsUnit.map C
  apply isUnit_iff_ne_zero.mpr
  intro hc
  apply hp
  rw [he, hc, map_zero]

/-- Over a reduced ring, a polynomial with a nonzero coefficient in positive degree is not a
unit. -/
private lemma not_isUnit_of_coeff_ne_zero
    {R ι : Type*} [CommRing R] [IsReduced R]
    {p : MvPolynomial ι R} {d : ι →₀ ℕ}
    (hd : d ≠ 0) (hc : p.coeff d ≠ 0) : ¬ IsUnit p := by
  intro hu
  obtain ⟨a, _, rfl⟩ := isUnit_iff_eq_C_of_isReduced.mp hu
  exact hc (coeff_C_of_ne_zero hd a)

/-- A bound on the total degree bounds the support inside a box of exponents. -/
private lemma support_subset_Iic_of_totalDegree_le
    {R ι : Type*} [CommSemiring R] [Finite ι] [DecidableEq ι]
    (p : MvPolynomial ι R) {N : ℕ} (hp : p.totalDegree ≤ N) :
    p.support ⊆ Finset.Iic (Finsupp.equivFunOnFinite.symm fun _ : ι => N) := by
  intro d hd
  rw [Finset.mem_Iic]
  exact fun i => (le_degreeOf_of_mem_support i hd).trans
    ((degreeOf_le_totalDegree p i).trans hp)

/-- The universal polynomial with indeterminate coefficients on a given finite set of
exponents. -/
private noncomputable def genericPolynomial
    {ι β : Type*} (R : Type*) [CommSemiring R]
    (s : Finset (ι →₀ ℕ)) (i : β) :
    MvPolynomial ι (MvPolynomial (β × s) R) :=
  ∑ d : s, monomial d.val (X (i, d))

private lemma coeff_genericPolynomial
    {ι β : Type*} (R : Type*) [CommSemiring R]
    (s : Finset (ι →₀ ℕ)) (i : β) (d : s) :
    (genericPolynomial R s i).coeff d.val = X (i, d) := by
  classical
  simp [genericPolynomial, coeff_sum, coeff_monomial]

private lemma map_genericPolynomial
    {R S ι β : Type*} [CommSemiring R] [CommSemiring S]
    (s : Finset (ι →₀ ℕ)) (i : β) (φ : R →+* S)
    (x : β × s → S) :
    (genericPolynomial R s i).map (eval₂Hom φ x) =
      ∑ d : s, monomial d.val (x (i, d)) := by
  classical
  simp [genericPolynomial, map_sum, map_monomial]

private lemma sum_monomial_subtype_coeff
    {R ι : Type*} [CommSemiring R]
    (s : Finset (ι →₀ ℕ)) (p : MvPolynomial ι R) (hp : p.support ⊆ s) :
    ∑ d : s, monomial d.val (p.coeff d.val) = p := by
  classical
  calc
    _ = ∑ d ∈ s, monomial d (p.coeff d) :=
      (Finset.sum_subtype s (fun _ => Iff.rfl) (fun d => monomial d (p.coeff d))).symm
    _ = ∑ d ∈ p.support, monomial d (p.coeff d) := by
      symm
      apply Finset.sum_subset hp
      intro d _ hd
      simp [notMem_support_iff.mp hd]
    _ = p := support_sum_monomial_coeff p

/-- Specializing the generic polynomial at coefficients of `p` recovers `p`. -/
private lemma map_genericPolynomial_eq
    {R S ι β : Type*} [CommSemiring R] [CommSemiring S]
    (s : Finset (ι →₀ ℕ)) (i : β) (φ : R →+* S) (x : β × s → S)
    (p : MvPolynomial ι S) (hp : p.support ⊆ s) (hx : ∀ d : s, x (i, d) = p.coeff d.val) :
    (genericPolynomial R s i).map (eval₂Hom φ x) = p := by
  rw [map_genericPolynomial]
  simpa [hx] using sum_monomial_subtype_coeff s p hp

/-- The universal witness that the `i`-th generic polynomial is nonconstant: it evaluates to one
exactly when some positive-degree coefficient is invertible, with `j` supplying the inverse. -/
private noncomputable def nonconstantCertificate
    {ι β : Type*} (R : Type*) [CommSemiring R]
    (s : Finset (ι →₀ ℕ)) (i j : β) :
    MvPolynomial (β × s) R := by
  classical
  exact ∑ d : s, if d.val = 0 then 0 else X (j, d) * X (i, d)

private lemma not_isUnit_map_genericPolynomial
    {R S ι β : Type*} [CommSemiring R] [CommRing S] [IsReduced S] [Nontrivial S]
    (s : Finset (ι →₀ ℕ)) (i j : β) (φ : R →+* S)
    (x : β × s → S)
    (h : eval₂Hom φ x (nonconstantCertificate R s i j) = 1) :
    ¬ IsUnit ((genericPolynomial R s i).map (eval₂Hom φ x)) := by
  classical
  intro hu
  obtain ⟨a, _, ha⟩ := isUnit_iff_eq_C_of_isReduced.mp hu
  have hx (d : s) (hd : d.val ≠ 0) : x (i, d) = 0 := by
    have he := congrArg (·.coeff d.val) ha
    simpa [coeff_map, coeff_genericPolynomial, coeff_C_of_ne_zero hd] using he
  have hz : eval₂Hom φ x (nonconstantCertificate R s i j) = 0 := by
    unfold nonconstantCertificate
    rw [map_sum]
    apply Finset.sum_eq_zero
    intro d _
    by_cases hd : d.val = 0
    · simp [hd]
    · simp [hd, hx d hd]
  exact zero_ne_one (hz.symm.trans h)

private lemma eval_nonconstantCertificate
    {R S ι β : Type*} [CommSemiring R] [Field S] [DecidableEq ι]
    (s : Finset (ι →₀ ℕ)) (i j : β) (φ : R →+* S)
    (x : β × s → S) (d : s) (hd : d.val ≠ 0)
    (hc : x (i, d) ≠ 0)
    (hx : ∀ e : s, x (j, e) = if e = d then (x (i, d))⁻¹ else 0) :
    eval₂Hom φ x (nonconstantCertificate R s i j) = 1 := by
  classical
  simp only [nonconstantCertificate, map_sum, apply_ite, map_zero, map_mul,
    eval₂Hom_X', hx]
  rw [Finset.sum_eq_single d]
  · simp [hd, hc]
  · intro e _ he
    simp [he]
  · simp

/-- The ideal of equations expressing that a polynomial factors as a product of two
nonconstant polynomials with support in `s`. -/
private noncomputable def factorizationIdeal
    {A ι : Type*} [CommRing A] (P : MvPolynomial ι A) (s : Finset (ι →₀ ℕ)) :
    Ideal (MvPolynomial (Fin 4 × s) A) :=
  Ideal.span (Set.range (fun d =>
      (P.map C - genericPolynomial A s (0 : Fin 4) * genericPolynomial A s 1).coeff d) ∪
    {nonconstantCertificate A s (0 : Fin 4) 2 - 1, nonconstantCertificate A s (1 : Fin 4) 3 - 1})

/-- If `P` stays irreducible under `c`, then no point over `c` is a common zero of
`factorizationIdeal P s`. -/
private lemma not_forall_eval_factorizationIdeal
    {A L ι : Type*} [CommRing A] [Field L] (P : MvPolynomial ι A) (c : A →+* L)
    (hP : Irreducible (P.map c)) (s : Finset (ι →₀ ℕ)) (x : Fin 4 × s → L) :
    ¬ ∀ p ∈ factorizationIdeal P s, eval₂Hom c x p = 0 := by
  intro hx
  let F := eval₂Hom c x
  have hFC : F.comp C = c := by ext a; simp [F]
  have hE : (P.map C - genericPolynomial A s (0 : Fin 4) * genericPolynomial A s 1).map F = 0 := by
    ext d
    rw [coeff_map, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply]
    exact hx _ (Ideal.subset_span (Or.inl ⟨d, rfl⟩))
  have hfac : P.map c =
      (genericPolynomial A s (0 : Fin 4)).map F * (genericPolynomial A s 1).map F := by
    apply sub_eq_zero.mp
    simpa only [map_sub, map_mul, map_map, hFC] using hE
  have hone (p : MvPolynomial (Fin 4 × s) A) (hp : p - 1 ∈ factorizationIdeal P s) : F p = 1 := by
    apply sub_eq_zero.mp
    simpa only [map_sub, map_one] using hx _ hp
  have hU := hone _ (Ideal.subset_span (Or.inr (Set.mem_insert _ _)))
  have hV := hone _ (Ideal.subset_span (Or.inr (Set.mem_insert_of_mem _ rfl)))
  rcases hP.isUnit_or_isUnit hfac with hQ | hR
  · exact not_isUnit_map_genericPolynomial s 0 2 c x hU hQ
  · exact not_isUnit_map_genericPolynomial s 1 3 c x hV hR

/-- A factorization of `P.map φ` into two nonunits with support in `s` gives a point over `φ`
at which every element of `factorizationIdeal P s` vanishes. -/
private lemma exists_factorizationIdeal_le_ker
    {A S ι : Type*} [CommRing A] [Field S] (P : MvPolynomial ι A) (s : Finset (ι →₀ ℕ))
    (φ : A →+* S) {q r : MvPolynomial ι S} (hqs : q.support ⊆ s) (hrs : r.support ⊆ s)
    (hq0 : q ≠ 0) (hr0 : r ≠ 0) (hq : ¬ IsUnit q) (hr : ¬ IsUnit r) (hqr : P.map φ = q * r) :
    ∃ x, factorizationIdeal P s ≤ RingHom.ker (eval₂Hom φ x) := by
  classical
  obtain ⟨d, hd, hqd⟩ := exists_nonzero_coeff_of_not_isUnit hq0 hq
  obtain ⟨e, he, hre⟩ := exists_nonzero_coeff_of_not_isUnit hr0 hr
  let d' : s := ⟨d, hqs (mem_support_iff.mpr hqd)⟩
  let e' : s := ⟨e, hrs (mem_support_iff.mpr hre)⟩
  let x : Fin 4 × s → S := fun z =>
    if z.1 = 0 then q.coeff z.2.val else
    if z.1 = 1 then r.coeff z.2.val else
    if z.1 = 2 then (if z.2 = d' then (q.coeff d)⁻¹ else 0) else
      (if z.2 = e' then (r.coeff e)⁻¹ else 0)
  let F := eval₂Hom φ x
  have hFC : F.comp C = φ := by ext a; simp [F]
  have hQ : (genericPolynomial A s (0 : Fin 4)).map F = q :=
    map_genericPolynomial_eq s 0 φ x q hqs fun _ => by simp [x]
  have hR : (genericPolynomial A s (1 : Fin 4)).map F = r :=
    map_genericPolynomial_eq s 1 φ x r hrs fun _ => by simp [x]
  have hU : F (nonconstantCertificate A s (0 : Fin 4) 2) = 1 := by
    apply eval_nonconstantCertificate s 0 2 φ x d' hd
    · simpa [x, d'] using hqd
    · exact fun a => by simp [x, d']
  have hV : F (nonconstantCertificate A s (1 : Fin 4) 3) = 1 := by
    apply eval_nonconstantCertificate s 1 3 φ x e' he
    · simpa [x, e'] using hre
    · exact fun a => by simp [x, e']
  have hE : (P.map C - genericPolynomial A s (0 : Fin 4) * genericPolynomial A s 1).map F = 0 := by
    simp only [map_sub, map_mul, map_map, hFC, hQ, hR, hqr, sub_self]
  refine ⟨x, ?_⟩
  unfold factorizationIdeal
  apply Ideal.span_le.mpr
  rintro a (⟨d, rfl⟩ | rfl | rfl)
  · simpa only [SetLike.mem_coe, RingHom.mem_ker, coeff_map, AddMonoidAlgebra.coeff_zero,
      Finsupp.zero_apply] using congrArg (·.coeff d) hE
  · simpa only [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_one, sub_eq_zero] using hU
  · simpa only [SetLike.mem_coe, RingHom.mem_ker, map_sub, map_one, sub_eq_zero] using hV

/-- On a suitable nonempty principal open subset, no specialization of an absolutely irreducible
polynomial factors into two nonunits whose supports lie in a prescribed finite set. -/
private lemma exists_nonzero_no_bounded_factorization
    (A K L ι : Type*) [CommRing A] [IsDomain A]
    [Field K] [Algebra A K] [IsFractionRing A K]
    [Field L] [Algebra K L] [IsAlgClosed L]
    (P : MvPolynomial ι A)
    (hP : Irreducible (P.map ((algebraMap K L).comp (algebraMap A K))))
    (s : Finset (ι →₀ ℕ)) :
    ∃ f : A, f ≠ 0 ∧ ∀ (S : Type*) [Field S] (φ : A →+* S), φ f ≠ 0 →
      ∀ q r : MvPolynomial ι S, q.support ⊆ s → r.support ⊆ s →
        q ≠ 0 → r ≠ 0 → P.map φ = q * r → IsUnit q ∨ IsUnit r := by
  obtain ⟨f, hf, hfI⟩ := exists_nonzero_constant_mem A K L (Fin 4 × s) (factorizationIdeal P s)
    (not_forall_eval_factorizationIdeal P _ hP s)
  refine ⟨f, hf, fun S _ φ hφ q r hqs hrs hq0 hr0 hqr => ?_⟩
  by_contra! hu
  obtain ⟨x, hx⟩ := exists_factorizationIdeal_le_ker P s φ hqs hrs hq0 hr0 hu.1 hu.2 hqr
  exact hφ (by simpa only [RingHom.mem_ker, eval₂Hom_C] using hx hfI)

/-- **Stacks Project, Tag 0557.** An absolutely irreducible polynomial over a domain
remains irreducible under every specialization to a field after restricting to a
nonempty principal open subset. -/
@[stacks 0557, ega "IV 9.7.5", ega "IV 9.7.4" "c ⇒ b"]
theorem exists_away_irreducible_map
    (A : Type u) [CommRing A] [IsDomain A]
    (K : Type v) [Field K] [Algebra A K] [IsFractionRing A K]
    (Kbar : Type w) [Field Kbar] [Algebra K Kbar] [IsAlgClosed Kbar]
    (ι : Type x) [Finite ι] (P : MvPolynomial ι A)
    (hP : Irreducible (P.map ((algebraMap K Kbar).comp (algebraMap A K)))) :
    ∃ f : A, f ≠ 0 ∧
      ∀ (κ : Type y) [Field κ] (φ : Localization.Away f →+* κ),
        Irreducible (P.map (φ.comp (algebraMap A (Localization.Away f)))) := by
  classical
  obtain ⟨d, hd, hPd⟩ := exists_nonzero_coeff_of_not_isUnit hP.ne_zero hP.not_isUnit
  have hPdA : P.coeff d ≠ 0 := fun h => hPd (by simp [coeff_map, h])
  let s := Finset.Iic (Finsupp.equivFunOnFinite.symm fun _ : ι => P.totalDegree)
  obtain ⟨f, hf, hspecialize⟩ :=
    exists_nonzero_no_bounded_factorization A K Kbar ι P hP s
  refine ⟨f * P.coeff d, mul_ne_zero hf hPdA, fun κ _ φ => ?_⟩
  let ψ := φ.comp (algebraMap A (Localization.Away (f * P.coeff d)))
  have hψ : ψ (f * P.coeff d) ≠ 0 :=
    ((IsLocalization.Away.algebraMap_isUnit (S := Localization.Away (f * P.coeff d))
      (f * P.coeff d)).map φ).ne_zero
  rw [map_mul] at hψ
  obtain ⟨hψf, hψd⟩ := mul_ne_zero_iff.mp hψ
  have hcoeff : (P.map ψ).coeff d ≠ 0 := by simpa only [coeff_map] using hψd
  have hzero : P.map ψ ≠ 0 := fun h => hcoeff (by rw [h, AddMonoidAlgebra.coeff_zero, Finsupp.zero_apply])
  refine ⟨not_isUnit_of_coeff_ne_zero hd hcoeff, fun q r hqr => ?_⟩
  obtain ⟨hq, hr⟩ := mul_ne_zero_iff.mp (hqr ▸ hzero : q * r ≠ 0)
  have hdegree : q.totalDegree + r.totalDegree ≤ P.totalDegree := by
    rw [← totalDegree_mul_of_isDomain hq hr, ← hqr]
    exact Finset.sup_mono (support_map_subset ψ P)
  exact hspecialize κ ψ hψf q r
    (support_subset_Iic_of_totalDegree_le q (by omega))
    (support_subset_Iic_of_totalDegree_le r (by omega)) hq hr hqr

end MvPolynomial

