module

public import StacksFrontier.AlgebraicGeometry.Morphisms.Fibres.BertiniInvertibleChart
public import StacksFrontier.RingTheory.Spectrum.Prime.LocalDimension

/-!
# Hypothesis (3) of the Bertini irreducibility theorem, read on a chart as a height

Hypothesis (3) of the Bertini irreducibility theorem fixes an irreducible component `Z` of
`H_{v₂} ∩ H_{v₃}` with `codim(Z, X) = 2`. On a trivializing affine chart `U` meeting `Z`, with
`g₂, g₃ ∈ Γ(U, ⊤)` the functions representing `v₂, v₃`, the prime cutting out `Z ∩ U` is a
minimal prime over `(g₂, g₃)` of height exactly two:

    ∃ p ∈ (Ideal.span {g₂, g₃}).minimalPrimes, p.height = 2.

## Main results

* `Stacks.Bertini.FamilyDivisors.Hypotheses.exists_mem_minimalPrimes_height_eq_two`: on a
  trivializing affine chart meeting `Z`, some minimal prime over `(g₂, g₃)` has height exactly
  two.
* `Stacks.Bertini.FamilyDivisors.Hypotheses.exists_chart_isUnit_and_height_eq_two`: there is a
  trivializing affine chart on which the function of `v₁` is a unit and on which `(g₂, g₃)` has a
  minimal prime of height exactly two.
* `Stacks.Bertini.FamilyDivisors.Hypotheses.linearIndependent_distinguished`: the three
  distinguished vectors `v₁, v₂, v₃` of hypothesis (3) are linearly independent.

## References

* [Stacks Project, Tag 0G4F](https://stacks.math.columbia.edu/tag/0G4F)
* [Stacks Project, Tag 02I4](https://stacks.math.columbia.edu/tag/02I4)
* [Stacks Project, Tag 00ON](https://stacks.math.columbia.edu/tag/00ON)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

universe u v

namespace Stacks.Bertini.FamilyDivisors

/-- A point of a trivializing affine chart lies in the zero locus of the ideal generated by the
functions of two vectors of the linear system exactly when it lies in both of their divisors. -/
theorem mem_zeroLocus_span_pair_iff {D : FamilyDivisors.{u, v}} (c : D.Chart) (w w' : D.V)
    (x : c.U.toScheme) :
    x ∈ c.U.toScheme.zeroLocus (U := ⊤)
        ((Ideal.span {chartFunction c.triv w, chartFunction c.triv w'} :
          Ideal Γ(c.U.toScheme, ⊤)) : Set Γ(c.U.toScheme, ⊤)) ↔
      c.U.ι.base x ∈ D.divisorSet w ∩ D.divisorSet w' := by
  rw [Scheme.zeroLocus_span, Set.mem_inter_iff, mem_divisorSet_iff c.triv w x,
    mem_divisorSet_iff c.triv w' x]
  simp [Scheme.mem_zeroLocus_iff]

namespace Hypotheses

variable {D : FamilyDivisors.{u, v}} (h : D.Hypotheses)

include h

/-- On a trivializing affine chart `U` that meets `Z`, the prime of `Γ(U, ⊤)` cutting out `Z ∩ U`
is a minimal prime over the ideal generated by the functions `g₂, g₃` of `v₂, v₃`, and its height
is exactly two. -/
@[stacks 0G4F "hypothesis (3) read on a chart meeting Z, as an exact height"]
theorem exists_mem_minimalPrimes_height_eq_two (c : D.Chart)
    (hZ : ((c.U : Set D.X) ∩ (h.Z : Set D.X)).Nonempty) :
    ∃ p : Ideal Γ(c.U.toScheme, ⊤),
      p ∈ (Ideal.span {chartFunction c.triv h.v₂, chartFunction c.triv h.v₃}).minimalPrimes ∧
        p.height = 2 := by
  have hmem := mem_zeroLocus_span_pair_iff c h.v₂ h.v₃
  obtain ⟨p, hp, hph⟩ := Scheme.exists_mem_minimalPrimes_height_eq_of_isAffineOpen c.U
    ((D.isClosed_divisorSet h.v₂).inter (D.isClosed_divisorSet h.v₃)) h.Z_component hZ
    (I := Ideal.span {chartFunction c.triv h.v₂, chartFunction c.triv h.v₃})
    (by rintro _ ⟨x, hx, rfl⟩; exact (hmem x).mp hx)
    (fun x hx => (hmem x).mpr (h.Z_component.1 hx))
  exact ⟨p, hp, by rw [hph, h.Z_codimension]⟩

/-- There is a trivializing affine chart on which the function of `v₁` is a unit and on which
some minimal prime over the ideal generated by the functions of `v₂` and `v₃` has height exactly
two. -/
@[stacks 0G4F "hypothesis (3) on a single chart: an invertible first function and an exact height"]
theorem exists_chart_isUnit_and_height_eq_two :
    ∃ c : D.Chart, IsUnit (chartFunction c.triv h.v₁) ∧
      ∃ p : Ideal Γ(c.U.toScheme, ⊤),
        p ∈ (Ideal.span {chartFunction c.triv h.v₂, chartFunction c.triv h.v₃}).minimalPrimes ∧
          p.height = 2 := by
  obtain ⟨c, hZ, hunit⟩ := h.exists_chart_isUnit_chartFunction
  exact ⟨c, hunit, h.exists_mem_minimalPrimes_height_eq_two c hZ⟩

/-! ### The three distinguished vectors are linearly independent -/

/-- A vector in the span of `v₂` and `v₃` has `Z` inside its divisor. -/
theorem subset_divisorSet_of_mem_span {w : D.V}
    (hw : w ∈ Submodule.span D.k {h.v₂, h.v₃}) : (h.Z : Set D.X) ⊆ D.divisorSet w := by
  intro x hxZ
  obtain ⟨c, -, hxc⟩ := D.exists_chart_le ⊤ x trivial
  obtain ⟨y, hy⟩ : x ∈ Set.range c.U.ι.base := by
    rwa [Scheme.Opens.range_ι]
  rw [← hy]
  have hin := (mem_zeroLocus_span_pair_iff c h.v₂ h.v₃ y).mpr
    (by rw [hy]; exact h.Z_component.1 hxZ)
  have hgw : chartFunction c.triv w ∈
      Ideal.span {chartFunction c.triv h.v₂, chartFunction c.triv h.v₃} := by
    simpa only [Set.image_pair] using chartFunction_mem_span_image c.triv hw
  refine (mem_divisorSet_iff c.triv w y).mpr ?_
  rw [Scheme.mem_zeroLocus_iff]
  rintro f (rfl : f = chartFunction c.triv w)
  exact (c.U.toScheme.mem_zeroLocus_iff _ y).mp hin _ hgw

/-- The vector `v₁` is not in the span of `v₂` and `v₃`. -/
@[stacks 0G4F "v₁ is independent from v₂ and v₃"]
theorem v₁_notMem_span : h.v₁ ∉ Submodule.span D.k {h.v₂, h.v₃} :=
  fun hmem ↦ h.Z_not_subset (h.subset_divisorSet_of_mem_span hmem)

/-- On a trivializing affine chart meeting `Z`, the ideal generated by the functions of `v₂` and
`v₃` is not principal. -/
theorem not_isPrincipal_span_pair (c : D.Chart)
    (hZ : ((c.U : Set D.X) ∩ (h.Z : Set D.X)).Nonempty) :
    ¬ (Ideal.span {chartFunction c.triv h.v₂, chartFunction c.triv h.v₃} :
        Ideal Γ(c.U.toScheme, ⊤)).IsPrincipal := by
  intro hprin
  have := h.isLocallyNoetherian
  obtain ⟨p, hp, hph⟩ := h.exists_mem_minimalPrimes_height_eq_two c hZ
  have hle := Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ p hp
  rw [hph] at hle
  norm_num at hle

/-- The vectors `v₂` and `v₃` are linearly independent. -/
@[stacks 0G4F "v₂ and v₃ are independent"]
theorem linearIndependent_v₂_v₃ : LinearIndependent D.k ![h.v₂, h.v₃] := by
  obtain ⟨c, hZ, -⟩ := h.exists_chart_isUnit_chartFunction
  have hnp := h.not_isPrincipal_span_pair c hZ
  simp only [linearIndependent_fin2, Matrix.cons_val_one, Matrix.cons_val_zero, ne_eq]
  constructor
  · intro h₃
    refine hnp ⟨chartFunction c.triv h.v₂, ?_⟩
    rw [h₃, chartFunction_zero, Set.pair_comm, Ideal.span_insert_zero]
  · intro a ha
    refine hnp ⟨chartFunction c.triv h.v₃, ?_⟩
    rw [← ha, chartFunction_smul]
    refine le_antisymm (Ideal.span_le.mpr ?_) (Ideal.span_le.mpr ?_)
    · rintro x hx
      simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
      rcases hx with rfl | rfl
      · exact Ideal.mul_mem_left _ _ (Ideal.mem_span_singleton_self _)
      · exact Ideal.mem_span_singleton_self _
    · rintro x (rfl : x = _)
      exact Ideal.subset_span (by simp)

/-- The three distinguished vectors `v₁, v₂, v₃` of hypothesis (3) are linearly independent. -/
@[stacks 0G4F "the three distinguished vectors are linearly independent"]
theorem linearIndependent_distinguished : LinearIndependent D.k ![h.v₁, h.v₂, h.v₃] := by
  rw [show (![h.v₁, h.v₂, h.v₃] : Fin 3 → D.V) = Fin.cons h.v₁ ![h.v₂, h.v₃] from rfl,
    linearIndependent_finCons, Matrix.range_cons_cons_empty]
  exact ⟨h.linearIndependent_v₂_v₃, h.v₁_notMem_span⟩

end Hypotheses

end Stacks.Bertini.FamilyDivisors

end
