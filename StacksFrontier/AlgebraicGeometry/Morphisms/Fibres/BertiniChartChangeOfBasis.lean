module

public import Mathlib.Data.Matrix.Mul
public import StacksFrontier.AlgebraicGeometry.Morphisms.Fibres.BertiniChartFunctionField

/-!
# The universal divisor over a chart, under a change of basis of the linear system

A change of basis of the linear system acts on the parameters of the family by an invertible
linear substitution of the variables of the chart ring `A[xⱼ]`, and it carries the universal
linear form of a tuple `f` to the universal linear form of the transformed tuple. The chart
statements `Algebra.isGeometricallyIrreducible_universalDivisorChart` and
`Algebra.algebraicIndependent_universalDivisorChartMap_X`, stated for a tuple `f₀, …, fₙ ∈ A`
with `f₀` invertible and the codimension-two condition imposed on `f₁, f₂`, therefore hold with
these hypotheses imposed on the image of the tuple under an arbitrary invertible `k`-linear
change of the parameters.

## Main definitions

* `Algebra.linearSubst` is the `A`-algebra map `A[xⱼ : j ∈ σ] → A[xᵢ : i ∈ ρ]` substituting
  `∑ᵢ bᵢⱼxᵢ` for `xⱼ`, for a matrix `b`, and `Algebra.linearSubstEquiv` is the isomorphism it
  is when `b` is invertible.
* `Algebra.quotientLinearSubstEquiv` is the induced isomorphism of chart rings
  `A[xⱼ]/(∑ⱼ fⱼxⱼ) ≃ A[xᵢ]/(∑ᵢ (bf)ᵢxᵢ)`.
* `Algebra.linearSubstChartAlgebra` transports a presentation of a field `Ω` as a fraction field
  of the first chart ring to one of the second.

## Main results

* `Algebra.linearSubst_universalLinearForm`: a linear substitution carries the universal linear
  form of `f` to the universal linear form of `bf`.
* `Algebra.isGeometricallyIrreducible_universalDivisorChart_of_linearSubst`: the geometric
  irreducibility of the chart's function field over the field generated by the parameters, with
  the invertibility and codimension-two hypotheses imposed on an arbitrary invertible
  `k`-linear change of the parameters rather than on three of them.
* `Algebra.algebraicIndependent_universalDivisorChartMap_X_of_linearSubst`: the same for the
  algebraic independence of the images of the parameters.
* `Algebra.isDomain_quotient_span_universalLinearForm_of_linearSubst` and
  `Algebra.injective_algebraMap_quotient_span_universalLinearForm_of_linearSubst`: the chart ring
  is a domain containing `A` as soon as some invertible `k`-linear change of the parameters
  carries the tuple to one with an invertible zeroth entry.

## References

* [Stacks Project, Tag 0G4F](https://stacks.math.columbia.edu/tag/0G4F)
-/

@[expose] public noncomputable section

universe u v w

open MvPolynomial

namespace Algebra

/-! ### Invertible linear substitutions in a polynomial ring -/

section LinearSubst

variable {A : Type*} [CommRing A]

/-- The image of a pair of mutually inverse matrices under a ring map is again a pair of
mutually inverse matrices. -/
theorem _root_.Matrix.map_mul_eq_one {R S : Type*} [CommRing R] [CommRing S] {ρ σ : Type*}
    [Fintype σ] [DecidableEq ρ] {b : Matrix ρ σ R} {c : Matrix σ ρ R} (φ : R →+* S)
    (h : b * c = 1) : b.map φ * c.map φ = 1 := by
  rw [← Matrix.map_mul, h]
  exact Matrix.map_one _ (map_zero φ) (map_one φ)

/-- The linear substitution of the variables: the `A`-algebra map
`A[xⱼ : j ∈ σ] → A[xᵢ : i ∈ ρ]` substituting `∑ᵢ bᵢⱼxᵢ` for `xⱼ`. -/
def linearSubst {ρ : Type v} {σ : Type w} [Fintype ρ] (b : Matrix ρ σ A) :
    MvPolynomial σ A →ₐ[A] MvPolynomial ρ A :=
  aeval fun j ↦ ∑ i, C (b i j) * X i

/-- The linear substitution along `b` sends `xⱼ` to `∑ᵢ bᵢⱼxᵢ`. -/
@[simp]
theorem linearSubst_X {ρ : Type v} {σ : Type w} [Fintype ρ] (b : Matrix ρ σ A) (j : σ) :
    linearSubst b (X j) = ∑ i, C (b i j) * X i := by
  simp [linearSubst]

/-- A linear substitution fixes the constants. -/
@[simp]
theorem linearSubst_C {ρ : Type v} {σ : Type w} [Fintype ρ] (b : Matrix ρ σ A) (a : A) :
    linearSubst b (C a) = C a := by
  simp [linearSubst]

/-- A linear substitution carries the linear form with coefficients `a` to the linear form with
coefficients `b a`. -/
private theorem linearSubst_sum_C_mul_X {ρ σ : Type*} [Fintype ρ] [Fintype σ]
    (b : Matrix ρ σ A) (a : σ → A) :
    linearSubst b (∑ j, C (a j) * X j) = ∑ i, C (∑ j, b i j * a j) * X i := by
  calc linearSubst b (∑ j, C (a j) * X j)
      = ∑ j, ∑ i, C (b i j * a j) * X i := by
        rw [map_sum]
        refine Finset.sum_congr rfl fun j _ ↦ ?_
        rw [map_mul, linearSubst_C, linearSubst_X, Finset.mul_sum]
        refine Finset.sum_congr rfl fun i _ ↦ ?_
        rw [← mul_assoc, ← C_mul, mul_comm (a j) (b i j)]
    _ = ∑ i, ∑ j, C (b i j * a j) * X i := Finset.sum_comm
    _ = ∑ i, C (∑ j, b i j * a j) * X i := by
        refine Finset.sum_congr rfl fun i _ ↦ ?_
        rw [map_sum, Finset.sum_mul]

/-- Substituting along `c` and then along `b` is substituting along `b * c`. -/
theorem linearSubst_comp {ρ σ τ : Type*} [Fintype ρ] [Fintype σ] (b : Matrix ρ σ A)
    (c : Matrix σ τ A) :
    (linearSubst b).comp (linearSubst c) = linearSubst (b * c) := by
  refine MvPolynomial.algHom_ext fun j ↦ ?_
  show linearSubst b (linearSubst c (X j)) = linearSubst (b * c) (X j)
  rw [linearSubst_X c j, linearSubst_X (b * c) j, linearSubst_sum_C_mul_X]
  simp only [Matrix.mul_apply]

/-- The identity matrix substitutes each variable for itself. -/
theorem linearSubst_one {σ : Type*} [Fintype σ] [DecidableEq σ] :
    linearSubst (1 : Matrix σ σ A) = AlgHom.id A (MvPolynomial σ A) := by
  refine MvPolynomial.algHom_ext fun j ↦ ?_
  rw [linearSubst_X, AlgHom.coe_id, id_eq, Finset.sum_eq_single j]
  · simp
  · intro i _ hij
    simp [hij]
  · simp

/-- Substituting along a matrix and then along a left inverse of it is the identity. -/
theorem linearSubst_linearSubst {ρ σ : Type*} [Fintype ρ] [Fintype σ] [DecidableEq ρ]
    (b : Matrix ρ σ A) (c : Matrix σ ρ A) (hbc : b * c = 1) (p : MvPolynomial ρ A) :
    linearSubst b (linearSubst c p) = p := by
  have h := DFunLike.congr_fun (linearSubst_comp b c) p
  rw [hbc, linearSubst_one] at h
  simpa using h

/-- A linear substitution with a left inverse is injective. -/
theorem linearSubst_injective {ρ σ : Type*} [Fintype ρ] [Finite σ] [DecidableEq σ]
    (b : Matrix ρ σ A) (c : Matrix σ ρ A) (hcb : c * b = 1) :
    Function.Injective (linearSubst b) :=
  let := Fintype.ofFinite σ
  Function.LeftInverse.injective (g := linearSubst c) (linearSubst_linearSubst c b hcb)

/-- An invertible linear substitution, as an isomorphism of polynomial rings. -/
def linearSubstEquiv {ρ σ : Type*} [Fintype ρ] [Fintype σ] [DecidableEq ρ] [DecidableEq σ]
    (b : Matrix ρ σ A) (c : Matrix σ ρ A) (hbc : b * c = 1) (hcb : c * b = 1) :
    MvPolynomial σ A ≃ₐ[A] MvPolynomial ρ A :=
  AlgEquiv.ofAlgHom (linearSubst b) (linearSubst c)
    (by rw [linearSubst_comp, hbc, linearSubst_one])
    (by rw [linearSubst_comp, hcb, linearSubst_one])

/-- The isomorphism `Algebra.linearSubstEquiv b c hbc hcb` acts as `Algebra.linearSubst b`. -/
@[simp]
theorem linearSubstEquiv_apply {ρ σ : Type*} [Fintype ρ] [Fintype σ] [DecidableEq ρ]
    [DecidableEq σ] (b : Matrix ρ σ A) (c : Matrix σ ρ A) (hbc : b * c = 1) (hcb : c * b = 1)
    (p : MvPolynomial σ A) : linearSubstEquiv b c hbc hcb p = linearSubst b p := rfl

/-- A linear substitution carries the universal linear form of `f` to the universal linear form
of the tuple transformed by the matrix of the substitution. -/
theorem linearSubst_universalLinearForm {ρ σ : Type*} [Fintype ρ] [Fintype σ]
    (b : Matrix ρ σ A) (f : σ → A) :
    linearSubst b (universalLinearForm f) = universalLinearForm fun i => ∑ j, b i j * f j := by
  exact linearSubst_sum_C_mul_X b f

/-- The isomorphism of the chart rings of two tuples related by an invertible linear
substitution. -/
def quotientLinearSubstEquiv {ρ σ : Type*} [Fintype ρ] [Fintype σ] [DecidableEq ρ]
    [DecidableEq σ] (f : σ → A) (b : Matrix ρ σ A) (c : Matrix σ ρ A) (hbc : b * c = 1)
    (hcb : c * b = 1) :
    (MvPolynomial σ A ⧸ Ideal.span {universalLinearForm f}) ≃ₐ[A]
      (MvPolynomial ρ A ⧸ Ideal.span {universalLinearForm fun i => ∑ j, b i j * f j}) :=
  Ideal.quotientEquivAlg (Ideal.span {universalLinearForm f})
    (Ideal.span {universalLinearForm fun i ↦ ∑ j, b i j * f j})
    (linearSubstEquiv b c hbc hcb) (by
      rw [Ideal.map_span, Set.image_singleton,
        show (linearSubstEquiv b c hbc hcb : MvPolynomial σ A →+* MvPolynomial ρ A)
            (universalLinearForm f) = universalLinearForm fun i ↦ ∑ j, b i j * f j from
          linearSubst_universalLinearForm b f])

/-- The inverse of `Algebra.quotientLinearSubstEquiv` is induced by the inverse substitution. -/
theorem quotientLinearSubstEquiv_symm_mk {ρ σ : Type*} [Fintype ρ] [Fintype σ] [DecidableEq ρ]
    [DecidableEq σ] (f : σ → A) (b : Matrix ρ σ A) (c : Matrix σ ρ A) (hbc : b * c = 1)
    (hcb : c * b = 1) (p : MvPolynomial ρ A) :
    (quotientLinearSubstEquiv f b c hbc hcb).symm (Ideal.Quotient.mk _ p) =
      Ideal.Quotient.mk _ (linearSubst c p) := by
  refine (quotientLinearSubstEquiv f b c hbc hcb).injective ?_
  rw [AlgEquiv.apply_symm_apply]
  show (Ideal.Quotient.mk _ p : MvPolynomial ρ A ⧸ _) =
    Ideal.Quotient.mk _ (linearSubst b (linearSubst c p))
  rw [linearSubst_linearSubst b c hbc p]

end LinearSubst

/-! ### Transporting a fraction field of the chart ring -/

section Transport

variable (A Ω : Type u) [CommRing A] [CommRing Ω] {ρ σ : Type*} [Fintype ρ] [Fintype σ]
  [DecidableEq ρ] [DecidableEq σ] (f : σ → A) (b : Matrix ρ σ A) (c : Matrix σ ρ A)
  (hbc : b * c = 1) (hcb : c * b = 1)
  [Algebra (MvPolynomial σ A ⧸ Ideal.span {universalLinearForm f}) Ω]

/-- The algebra structure of `Ω` over the chart ring of the transformed tuple, through
`Algebra.quotientLinearSubstEquiv`. -/
@[instance_reducible]
def linearSubstChartAlgebra :
    Algebra (MvPolynomial ρ A ⧸
      Ideal.span {universalLinearForm fun i => ∑ j, b i j * f j}) Ω :=
  ((algebraMap (MvPolynomial σ A ⧸ Ideal.span {universalLinearForm f}) Ω).comp
    (quotientLinearSubstEquiv f b c hbc hcb).toRingEquiv.symm.toRingHom).toAlgebra

/-- The transported presentation is again a fraction field. -/
theorem isFractionRing_linearSubstChart
    [IsFractionRing (MvPolynomial σ A ⧸ Ideal.span {universalLinearForm f}) Ω] :
    letI := linearSubstChartAlgebra A Ω f b c hbc hcb
    IsFractionRing (MvPolynomial ρ A ⧸
      Ideal.span {universalLinearForm fun i => ∑ j, b i j * f j}) Ω :=
  (IsFractionRing.isFractionRing_iff_of_base_ringEquiv Ω
    (quotientLinearSubstEquiv f b c hbc hcb).toRingEquiv).mp inferInstance

/-- The chart map of the transformed tuple is the chart map of the original one precomposed with
the substitution. -/
theorem universalDivisorChartMap_linearSubstChartAlgebra (p : MvPolynomial ρ A) :
    letI := linearSubstChartAlgebra A Ω f b c hbc hcb
    universalDivisorChartMap A Ω (fun i => ∑ j, b i j * f j) p =
      universalDivisorChartMap A Ω f (linearSubst c p) := by
  let := linearSubstChartAlgebra A Ω f b c hbc hcb
  show algebraMap (MvPolynomial σ A ⧸ Ideal.span {universalLinearForm f}) Ω
      ((quotientLinearSubstEquiv f b c hbc hcb).toRingEquiv.symm (Ideal.Quotient.mk _ p)) = _
  rw [show (quotientLinearSubstEquiv f b c hbc hcb).toRingEquiv.symm (Ideal.Quotient.mk _ p) =
      Ideal.Quotient.mk _ (linearSubst c p) from
    quotientLinearSubstEquiv_symm_mk f b c hbc hcb p]
  rfl

end Transport

/-! ### The two chart statements for an arbitrary change of basis -/

section ChangeOfBasis

/-- Two families related by an invertible `k`-linear transformation generate the same
subfield. -/
theorem adjoin_range_eq_of_linearSubst {k Ω : Type u} [Field k] [Field Ω] [Algebra k Ω]
    {ρ σ : Type*} [Fintype ρ] [Fintype σ] (y : ρ → Ω) (x : σ → Ω) (b : Matrix ρ σ k)
    (c : Matrix σ ρ k) (hx : ∀ j, x j = ∑ i, algebraMap k Ω (b i j) * y i)
    (hy : ∀ i, y i = ∑ j, algebraMap k Ω (c j i) * x j) :
    IntermediateField.adjoin k (Set.range y) = IntermediateField.adjoin k (Set.range x) := by
  refine le_antisymm ?_ ?_
  · rw [IntermediateField.adjoin_le_iff]
    rintro _ ⟨i, rfl⟩
    rw [hy i]
    exact sum_mem fun j _ ↦ mul_mem (IntermediateField.algebraMap_mem _ _)
      (IntermediateField.subset_adjoin k _ ⟨j, rfl⟩)
  · rw [IntermediateField.adjoin_le_iff]
    rintro _ ⟨j, rfl⟩
    rw [hx j]
    exact sum_mem fun i _ ↦ mul_mem (IntermediateField.algebraMap_mem _ _)
      (IntermediateField.subset_adjoin k _ ⟨i, rfl⟩)

/-- Geometric irreducibility over a subfield depends only on the subfield. -/
private theorem isGeometricallyIrreducible_of_intermediateField_eq {k Ω : Type u} [Field k]
    [Field Ω] [Algebra k Ω] {E F : IntermediateField k Ω} (h : E = F)
    (hE : letI : Algebra E Ω := E.toSubalgebra.toAlgebra
      Algebra.IsGeometricallyIrreducible E Ω) :
    letI : Algebra F Ω := F.toSubalgebra.toAlgebra
    Algebra.IsGeometricallyIrreducible F Ω := by
  subst h
  exact hE

variable (k A K Ω : Type u) [Field k] [CommRing A] [IsDomain A] [Algebra k A]
  [Algebra.FiniteType k A] [Field K] [Algebra A K] [IsFractionRing A K] [Algebra k K]
  [IsScalarTower k A K] [Field Ω] [Algebra K Ω] [Algebra k Ω] [IsScalarTower k K Ω]
  {σ : Type u} [Fintype σ] [DecidableEq σ] {n : ℕ} (f : σ → A)
  (b : Matrix (Fin (n + 1)) σ k) (c : Matrix σ (Fin (n + 1)) k) (hbc : b * c = 1)
  (hcb : c * b = 1)
  [Algebra (MvPolynomial σ A ⧸ Ideal.span {universalLinearForm f}) Ω]
  [IsFractionRing (MvPolynomial σ A ⧸ Ideal.span {universalLinearForm f}) Ω]

omit [IsDomain A] [Algebra.FiniteType k A] [IsFractionRing A K] [DecidableEq σ]
  [IsFractionRing (MvPolynomial σ A ⧸ Ideal.span {universalLinearForm f}) Ω] in
/-- The chart map sends a constant coming from the base field to its image in `Ω`. -/
theorem universalDivisorChartMap_C_algebraMap
    (hcompat : ∀ a : A, algebraMap K Ω (algebraMap A K a) =
      universalDivisorChartMap A Ω f (C a)) (t : k) :
    universalDivisorChartMap A Ω f (C (algebraMap k A t)) = algebraMap k Ω t := by
  rw [← hcompat, ← IsScalarTower.algebraMap_apply k A K, ← IsScalarTower.algebraMap_apply k K Ω]

omit [IsDomain A] [Algebra.FiniteType k A] [IsFractionRing A K]
  [IsFractionRing (MvPolynomial σ A ⧸ Ideal.span {universalLinearForm f}) Ω] in
/-- The images in `Ω` of the old and the new parameters are `k`-linear combinations of one
another. -/
private theorem universalDivisorChartMap_X_linearSubst
    (hcompat : ∀ a : A, algebraMap K Ω (algebraMap A K a) =
      universalDivisorChartMap A Ω f (C a)) :
    letI := linearSubstChartAlgebra A Ω f (b.map (algebraMap k A)) (c.map (algebraMap k A))
      (Matrix.map_mul_eq_one _ hbc) (Matrix.map_mul_eq_one _ hcb)
    (∀ j : σ, universalDivisorChartMap A Ω f (X j) =
        ∑ i, algebraMap k Ω (b i j) *
          universalDivisorChartMap A Ω
            (fun i => ∑ j, (b.map (algebraMap k A)) i j * f j) (X i)) ∧
      ∀ i : Fin (n + 1), universalDivisorChartMap A Ω
          (fun i => ∑ j, (b.map (algebraMap k A)) i j * f j) (X i) =
        ∑ j, algebraMap k Ω (c j i) * universalDivisorChartMap A Ω f (X j) := by
  let := linearSubstChartAlgebra A Ω f (b.map (algebraMap k A)) (c.map (algebraMap k A))
    (Matrix.map_mul_eq_one _ hbc) (Matrix.map_mul_eq_one _ hcb)
  have hmap := universalDivisorChartMap_linearSubstChartAlgebra A Ω f
    (b.map (algebraMap k A)) (c.map (algebraMap k A))
    (Matrix.map_mul_eq_one (algebraMap k A) hbc) (Matrix.map_mul_eq_one (algebraMap k A) hcb)
  have hC := universalDivisorChartMap_C_algebraMap k A K Ω f hcompat
  refine ⟨fun j ↦ ?_, fun i ↦ ?_⟩
  · have hpf : universalDivisorChartMap A Ω
        (fun i ↦ ∑ j, (b.map (algebraMap k A)) i j * f j)
          (linearSubst (b.map (algebraMap k A)) (X j)) =
        universalDivisorChartMap A Ω f (X j) := by
      rw [hmap, linearSubst_linearSubst _ _ (Matrix.map_mul_eq_one (algebraMap k A) hcb)]
    rw [← hpf, linearSubst_X, map_sum]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [map_mul, hmap, linearSubst_C, Matrix.map_apply, hC]
  · rw [hmap, linearSubst_X, map_sum]
    refine Finset.sum_congr rfl fun j _ ↦ ?_
    rw [map_mul, Matrix.map_apply, hC]

include c hbc hcb

/-- The function field of the universal divisor over a chart is geometrically irreducible over
the field generated by the parameters. This is
`Algebra.isGeometricallyIrreducible_universalDivisorChart` with the parameters indexed by an
arbitrary finite set `σ` and its hypotheses imposed not on `f` itself but on the image `g` of `f`
under an invertible `k`-linear transformation `b` of the parameters. -/
@[stacks 0G4F "the generic fibre over a chart, for distinguished vectors of an arbitrary basis"]
theorem isGeometricallyIrreducible_universalDivisorChart_of_linearSubst (hn : 2 ≤ n)
    (g : Fin (n + 1) → A) (hg : ∀ i, g i = ∑ j, algebraMap k A (b i j) * f j)
    {w : A} (hw : w * g 0 = 1)
    (hcompat : ∀ a : A, algebraMap K Ω (algebraMap A K a) =
      universalDivisorChartMap A Ω f (C a))
    (hK : Algebra.IsGeometricallyIrreducible k K)
    (hcodim : ∃ p : Ideal A,
      p ∈ (Ideal.span {g ⟨1, by omega⟩, g ⟨2, by omega⟩}).minimalPrimes ∧
        ringKrullDim (A ⧸ p) + 2 = ringKrullDim A) :
    letI F : IntermediateField k Ω :=
      IntermediateField.adjoin k
        (Set.range fun j : σ => universalDivisorChartMap A Ω f (X j))
    letI : Algebra F Ω := F.toSubalgebra.toAlgebra
    Algebra.IsGeometricallyIrreducible F Ω := by
  obtain rfl : g = fun i ↦ ∑ j, (b.map (algebraMap k A)) i j * f j := funext hg
  let := linearSubstChartAlgebra A Ω f (b.map (algebraMap k A)) (c.map (algebraMap k A))
    (Matrix.map_mul_eq_one _ hbc) (Matrix.map_mul_eq_one _ hcb)
  have := isFractionRing_linearSubstChart A Ω f (b.map (algebraMap k A))
    (c.map (algebraMap k A)) (Matrix.map_mul_eq_one _ hbc) (Matrix.map_mul_eq_one _ hcb)
  have hmap := universalDivisorChartMap_linearSubstChartAlgebra A Ω f
    (b.map (algebraMap k A)) (c.map (algebraMap k A))
    (Matrix.map_mul_eq_one (algebraMap k A) hbc) (Matrix.map_mul_eq_one (algebraMap k A) hcb)
  obtain ⟨hx, hy⟩ := universalDivisorChartMap_X_linearSubst k A K Ω f b c hbc hcb hcompat
  refine isGeometricallyIrreducible_of_intermediateField_eq
    (adjoin_range_eq_of_linearSubst _ _ b c hx hy) ?_
  refine isGeometricallyIrreducible_universalDivisorChart k A K Ω hn _ hw (fun a ↦ ?_) hK hcodim
  rw [hmap, linearSubst_C]
  exact hcompat a

/-- The parameters of a chart are algebraically independent over the base field. This is
`Algebra.algebraicIndependent_universalDivisorChartMap_X` with the parameters indexed by an
arbitrary finite set and its hypotheses imposed on the image of `f` under an invertible
`k`-linear transformation of the parameters. -/
@[stacks 0G4F "the dominance over the parameter space, for an arbitrary basis"]
theorem algebraicIndependent_universalDivisorChartMap_X_of_linearSubst (hn : 2 ≤ n)
    (g : Fin (n + 1) → A) (hg : ∀ i, g i = ∑ j, algebraMap k A (b i j) * f j)
    {w : A} (hw : w * g 0 = 1)
    (hcompat : ∀ a : A, algebraMap K Ω (algebraMap A K a) =
      universalDivisorChartMap A Ω f (C a))
    (hcodim : ∃ p : Ideal A,
      p ∈ (Ideal.span {g ⟨1, by omega⟩, g ⟨2, by omega⟩}).minimalPrimes ∧
        ringKrullDim (A ⧸ p) + 2 = ringKrullDim A) :
    AlgebraicIndependent k fun j : σ => universalDivisorChartMap A Ω f (X j) := by
  obtain rfl : g = fun i ↦ ∑ j, (b.map (algebraMap k A)) i j * f j := funext hg
  let := linearSubstChartAlgebra A Ω f (b.map (algebraMap k A)) (c.map (algebraMap k A))
    (Matrix.map_mul_eq_one _ hbc) (Matrix.map_mul_eq_one _ hcb)
  have := isFractionRing_linearSubstChart A Ω f (b.map (algebraMap k A))
    (c.map (algebraMap k A)) (Matrix.map_mul_eq_one _ hbc) (Matrix.map_mul_eq_one _ hcb)
  have hmap := universalDivisorChartMap_linearSubstChartAlgebra A Ω f
    (b.map (algebraMap k A)) (c.map (algebraMap k A))
    (Matrix.map_mul_eq_one (algebraMap k A) hbc) (Matrix.map_mul_eq_one (algebraMap k A) hcb)
  obtain ⟨hx, -⟩ := universalDivisorChartMap_X_linearSubst k A K Ω f b c hbc hcb hcompat
  have hbase := algebraicIndependent_universalDivisorChartMap_X k A K Ω hn
    (fun i ↦ ∑ j, (b.map (algebraMap k A)) i j * f j) hw (fun a ↦ by
      rw [hmap, linearSubst_C]; exact hcompat a) hcodim
  rw [algebraicIndependent_iff_injective_aeval] at hbase ⊢
  have heq : (MvPolynomial.aeval fun j : σ ↦ universalDivisorChartMap A Ω f (X j) :
        MvPolynomial σ k →ₐ[k] Ω) =
      (MvPolynomial.aeval fun i : Fin (n + 1) ↦ universalDivisorChartMap A Ω
        (fun i ↦ ∑ j, (b.map (algebraMap k A)) i j * f j) (X i)).comp (linearSubst b) := by
    refine MvPolynomial.algHom_ext fun j ↦ ?_
    rw [MvPolynomial.aeval_X, AlgHom.comp_apply, linearSubst_X, map_sum, hx j]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [map_mul, MvPolynomial.aeval_C, MvPolynomial.aeval_X]
  rw [heq, AlgHom.coe_comp]
  exact hbase.comp (linearSubst_injective b c hcb)

end ChangeOfBasis

/-! ### The chart ring is a domain after an arbitrary change of basis -/

section Domain

variable (k A : Type u) [Field k] [CommRing A] [IsDomain A] [Algebra k A]
  {σ : Type*} [Fintype σ] [DecidableEq σ] {n : ℕ} (f : σ → A)

/-- If the zeroth entry of the image `b · f` of a tuple `f` under an invertible `k`-linear change
`b` of the parameters is invertible, then the chart ring of `f` is a domain. -/
theorem isDomain_quotient_span_universalLinearForm_of_linearSubst
    (b : Matrix (Fin (n + 1)) σ k) (c : Matrix σ (Fin (n + 1)) k) (hbc : b * c = 1)
    (hcb : c * b = 1) (g : Fin (n + 1) → A)
    (hg : ∀ i, g i = ∑ j, algebraMap k A (b i j) * f j) {w : A} (hw : w * g 0 = 1) :
    IsDomain (MvPolynomial σ A ⧸ Ideal.span {universalLinearForm f}) := by
  obtain rfl : g = fun i ↦ ∑ j, (b.map (algebraMap k A)) i j * f j := funext hg
  have := isDomain_quotient_span_universalLinearForm
    (fun i ↦ ∑ j, (b.map (algebraMap k A)) i j * f j) hw
  have e := quotientLinearSubstEquiv f (b.map (algebraMap k A)) (c.map (algebraMap k A))
    (Matrix.map_mul_eq_one _ hbc) (Matrix.map_mul_eq_one _ hcb)
  have : Nontrivial (MvPolynomial σ A ⧸ Ideal.span {universalLinearForm f}) :=
    e.toEquiv.nontrivial
  exact Function.Injective.isDomain e.toRingEquiv.toRingHom fun _ _ hxy ↦ e.injective hxy

omit [IsDomain A] in
/-- If the zeroth entry of the image `b · f` of a tuple `f` under an invertible `k`-linear change
`b` of the parameters is invertible, then the chart ring of `f` contains `A`. -/
theorem injective_algebraMap_quotient_span_universalLinearForm_of_linearSubst
    (b : Matrix (Fin (n + 1)) σ k) (c : Matrix σ (Fin (n + 1)) k) (hbc : b * c = 1)
    (hcb : c * b = 1) (g : Fin (n + 1) → A)
    (hg : ∀ i, g i = ∑ j, algebraMap k A (b i j) * f j) {w : A} (hw : w * g 0 = 1) :
    Function.Injective
      (algebraMap A (MvPolynomial σ A ⧸ Ideal.span {universalLinearForm f})) := by
  obtain rfl : g = fun i ↦ ∑ j, (b.map (algebraMap k A)) i j * f j := funext hg
  have hinj := injective_algebraMap_quotient_span_universalLinearForm
    (fun i ↦ ∑ j, (b.map (algebraMap k A)) i j * f j) hw
  have e := quotientLinearSubstEquiv f (b.map (algebraMap k A)) (c.map (algebraMap k A))
    (Matrix.map_mul_eq_one _ hbc) (Matrix.map_mul_eq_one _ hcb)
  exact fun x y hxy ↦ hinj (by rw [← e.commutes, ← e.commutes, hxy])

end Domain

end Algebra

