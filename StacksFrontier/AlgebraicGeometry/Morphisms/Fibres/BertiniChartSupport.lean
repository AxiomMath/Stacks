module

public import StacksFrontier.AlgebraicGeometry.Limits.ReducedInducedSubscheme
public import StacksFrontier.AlgebraicGeometry.Morphisms.Fibres.BertiniChartEquation
public import StacksFrontier.Topology.Irreducible.OpenCover

/-!
# The universal divisor over a trivializing chart is irreducible

In the standing situation of the Bertini theorems ([Stacks, Tag 0G47]) the universal divisor
`H_univ ⊂ 𝔸^r_X` is cut out, over an affine open `U = Spec A` of `X` trivializing `L`, by the
universal linear form `x₁f₁ + ⋯ + x_rf_r` of the functions `fᵢ ∈ A` representing the sections
`ψ(vᵢ)`; this is `Stacks.Bertini.FamilyDivisors.ideal_universalDivisor_comap_chartMap`. This
module converts that local equation into the topology of `H_univ`: the part of the support of
`H_univ` lying over `U` is irreducible.

The conversion is Mathlib's `AlgebraicGeometry.Scheme.IdealSheafData.supportSet_inter`, which
reads the support of a quasi-coherent ideal sheaf over an affine open as the zero locus of its
ideal there, together with the identification of the ideal of a pullback along an open immersion
with the ideal on its image
(`AlgebraicGeometry.Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion`).

## Main definitions

* `Stacks.Bertini.FamilyDivisors.chartOpen` is the chart `𝔸^r_U ⊂ 𝔸^r_X` as an affine open of
  the parameter space.
* `Stacks.Bertini.FamilyDivisors.chartΓEquiv` and
  `Stacks.Bertini.FamilyDivisors.chartMvPolynomialEquiv` identify its ring of functions with
  `Γ(𝔸^r_U, ⊤)` and with the polynomial ring `A[xᵢ]`.

## Main results

* `Stacks.Bertini.FamilyDivisors.ideal_universalDivisor_chartOpen`: the ideal of `H_univ` on the
  chart is generated by the local equation.
* `Stacks.Bertini.FamilyDivisors.chartSubschemeΓEquiv`: the ring of `H_univ` over the chart is
  `A[xᵢ]/(∑ᵢ xᵢfᵢ)`.
* `Stacks.Bertini.FamilyDivisors.isIrreducible_supportSet_inter_chart`: the part of the support
  of `H_univ` lying over a trivializing affine open is irreducible.
* `Stacks.Bertini.FamilyDivisors.isIrreducible_supportSet_universalDivisor`: `H_univ` is
  irreducible, glued from the charts over a trivializing affine cover of `X` whose pieces
  pairwise meet.
* `Stacks.Bertini.FamilyDivisors.isIrreducible_supportSet_universalDivisor_of_directed`: the
  same for a cover in which the intersection of two members contains a member, which removes
  both topological hypotheses.
* `Stacks.Bertini.FamilyDivisors.irreducibleSpace_universalDivisor_subscheme`: `H_univ` is then
  an irreducible scheme, which is what makes its generic point and function field available.

## Implementation notes

The chart is taken as the image `𝔸^r_U ''ᵁ ⊤` of the open immersion `𝔸^r_U ⟶ 𝔸^r_X` rather than
as the preimage `AlgebraicGeometry.AffineSpace.chart` of `U`, so that the ring of functions on
it is the one Mathlib's `ideal_comap_of_isOpenImmersion` produces and no transport along an
equality of opens is needed; the two opens agree by
`Stacks.Bertini.FamilyDivisors.chartOpen_coe`.

The parameters of the family are indexed by the basis of the linear system lifted to the universe
of the scheme, so the chart-level irreducibility is used in its reindexed form, and in the
version that asks only for the spectrum of the chart ring to be irreducible rather than for the
ring to be a domain: `Algebra.isIrreducible_zeroLocus_linearForm_of_isPrime_nilradical`. The
chart ring is therefore never required to be reduced.

## References

* [Stacks Project, Tag 0G47](https://stacks.math.columbia.edu/tag/0G47)
* [Stacks Project, Tag 0G4F](https://stacks.math.columbia.edu/tag/0G4F)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u v

namespace Stacks.Bertini.FamilyDivisors

variable (D : FamilyDivisors.{u, v}) (U : D.X.Opens) [IsAffine U.toScheme]

/-- The chart `𝔸^r_U ⊂ 𝔸^r_X` of the parameter space over an affine open `U` of `X`, as an
affine open of the parameter space. -/
def chartOpen : D.parameterSpace.affineOpens :=
  ⟨D.chartMap U ''ᵁ ⊤,
    (isAffineOpen_top 𝔸(D.basisIndex; U.toScheme)).image_of_isOpenImmersion _⟩

/-- The chart of the parameter space over an open of `X` is the preimage of that open. -/
theorem chartOpen_coe : (D.chartOpen U).1 = AffineSpace.chart D.basisIndex U :=
  (Scheme.Hom.image_top_eq_opensRange _).trans
    (TopologicalSpace.Opens.ext (AffineSpace.range_map_ι U))

/-- The functions on the chart of the parameter space over an affine open `U` of `X` are the
functions on `𝔸^r_U`. -/
def chartΓEquiv :
    Γ(𝔸(D.basisIndex; U.toScheme), ⊤) ≃+* Γ(D.parameterSpace, (D.chartOpen U).1) :=
  ((D.chartMap U).appIso ⊤).symm.commRingCatIsoToRingEquiv

/-- `chartΓEquiv` is the inverse of the isomorphism of a function sheaf along an open
immersion. -/
theorem chartΓEquiv_toRingHom :
    (D.chartΓEquiv U : Γ(𝔸(D.basisIndex; U.toScheme), ⊤) →+*
      Γ(D.parameterSpace, (D.chartOpen U).1)) = ((D.chartMap U).appIso ⊤).inv.hom :=
  rfl

/-- The functions on the chart of the parameter space over an affine open `U = Spec A` of `X`
are the polynomial ring `A[xᵢ]`. -/
def chartMvPolynomialEquiv :
    Γ(D.parameterSpace, (D.chartOpen U).1) ≃+* MvPolynomial D.basisIndex Γ(U.toScheme, ⊤) :=
  (D.chartΓEquiv U).symm.trans
    (AffineSpace.ΓIso D.basisIndex U.toScheme).commRingCatIsoToRingEquiv

/-- The tuple of functions representing the sections `ψ(v₁), …, ψ(v_r)` on a trivializing chart,
indexed by the parameters of the family. -/
def chartEquationIndex
    (eU : D.restrictedModule U ≅ SheafOfModules.unit U.toScheme.ringCatSheaf)
    (j : D.basisIndex) : Γ(U.toScheme, ⊤) :=
  D.chartEquation eU j.down

omit [IsAffine U.toScheme] in
/-- Reindexing the chart equation by the parameters does not change its range. -/
theorem range_chartEquationIndex
    (eU : D.restrictedModule U ≅ SheafOfModules.unit U.toScheme.ringCatSheaf) :
    Set.range (D.chartEquationIndex U eU) = Set.range (D.chartEquation eU) :=
  (ULift.down_surjective (α := Fin (Module.finrank D.k D.V))).range_comp _

/-- **The local equation of the universal divisor, read on the chart.** The identification of
the functions on the chart with a polynomial ring carries the local equation of `H_univ` to the
universal linear form of the functions representing the sections `ψ(vᵢ)`. -/
theorem chartMvPolynomialEquiv_chartΓEquiv_chartSection
    (eU : D.restrictedModule U ≅ SheafOfModules.unit U.toScheme.ringCatSheaf) :
    D.chartMvPolynomialEquiv U (D.chartΓEquiv U (D.chartSection eU)) =
      ∑ j, MvPolynomial.C (D.chartEquationIndex U eU j) * MvPolynomial.X j := by
  have hγ : D.chartMvPolynomialEquiv U (D.chartΓEquiv U (D.chartSection eU)) =
      (AffineSpace.ΓIso D.basisIndex U.toScheme).hom (D.chartSection eU) := by
    change (AffineSpace.ΓIso D.basisIndex U.toScheme).commRingCatIsoToRingEquiv
      ((D.chartΓEquiv U).symm (D.chartΓEquiv U (D.chartSection eU))) = _
    rw [RingEquiv.symm_apply_apply]
    rfl
  rw [hγ, D.ΓIso_hom_chartSection eU]
  exact Fintype.sum_equiv Equiv.ulift.symm _ _ fun i => rfl

/-- **The ideal of the universal divisor on a trivializing chart.** On the chart of the parameter
space over an affine open `U` of `X` trivializing `L`, the universal divisor is cut out by the
image of the local equation `∑ᵢ xᵢfᵢ` of `𝔸^r_U`. -/
theorem ideal_universalDivisor_chartOpen
    (eU : D.restrictedModule U ≅ SheafOfModules.unit U.toScheme.ringCatSheaf) :
    D.universalDivisor.ideal (D.chartOpen U) =
      Ideal.span {D.chartΓEquiv U (D.chartSection eU)} := by
  set φ := (D.chartΓEquiv U : Γ(𝔸(D.basisIndex; U.toScheme), ⊤) →+*
    Γ(D.parameterSpace, (D.chartOpen U).1)) with hφ
  have hcomap := Scheme.IdealSheafData.ideal_comap_of_isOpenImmersion
    D.universalDivisor (D.chartMap U) ⟨⊤, isAffineOpen_top 𝔸(D.basisIndex; U.toScheme)⟩
  rw [D.ideal_universalDivisor_comap_chartMap eU, ← D.chartΓEquiv_toRingHom U] at hcomap
  have hchart : Ideal.comap φ (D.universalDivisor.ideal (D.chartOpen U)) =
      Ideal.span {D.chartSection eU} := hcomap.symm
  calc D.universalDivisor.ideal (D.chartOpen U)
      = Ideal.map φ (Ideal.comap φ (D.universalDivisor.ideal (D.chartOpen U))) :=
        (Ideal.map_comap_of_surjective φ (D.chartΓEquiv U).surjective _).symm
    _ = Ideal.map φ (Ideal.span {D.chartSection eU}) := by rw [hchart]
    _ = Ideal.span {D.chartΓEquiv U (D.chartSection eU)} := by
        rw [Ideal.map_span, Set.image_singleton, hφ]
        rfl

/-- **The ideal of the universal divisor on a chart, read in the polynomial ring.** The
identification of the functions on the chart with `A[xᵢ]` carries the ideal of `H_univ` there to
the ideal generated by the universal linear form of the chart equations. -/
theorem map_chartMvPolynomialEquiv_ideal_universalDivisor
    (eU : D.restrictedModule U ≅ SheafOfModules.unit U.toScheme.ringCatSheaf) :
    Ideal.span {∑ j, MvPolynomial.C (D.chartEquationIndex U eU j) * MvPolynomial.X j} =
      Ideal.map (D.chartMvPolynomialEquiv U : Γ(D.parameterSpace, (D.chartOpen U).1) →+*
          MvPolynomial D.basisIndex Γ(U.toScheme, ⊤))
        (D.universalDivisor.ideal (D.chartOpen U)) := by
  rw [D.ideal_universalDivisor_chartOpen U eU, Ideal.map_span, Set.image_singleton,
    show ((D.chartMvPolynomialEquiv U : _ →+* _)) (D.chartΓEquiv U (D.chartSection eU)) =
        ∑ j, MvPolynomial.C (D.chartEquationIndex U eU j) * MvPolynomial.X j from
      D.chartMvPolynomialEquiv_chartΓEquiv_chartSection U eU]

/-- **The ring of the universal divisor over a trivializing affine chart.** The part of `H_univ`
lying over the chart of the parameter space above an affine open `U = Spec A` of `X` trivializing
`L` is affine with ring `A[xᵢ]/(∑ᵢ xᵢfᵢ)`.

This is Mathlib's `AlgebraicGeometry.Scheme.IdealSheafData.subschemeObjIso`, which reads the ring
of a closed subscheme over an affine open as the quotient by the ideal there, composed with the
identification `Stacks.Bertini.FamilyDivisors.chartMvPolynomialEquiv` of the functions on the
chart with a polynomial ring and with the computation
`Stacks.Bertini.FamilyDivisors.ideal_universalDivisor_chartOpen` of the ideal.

It is the ring whose fraction field is the function field of `H_univ` once `H_univ` is integral,
which is the presentation `Algebra.isGeometricallyIrreducible_universalDivisorChart` consumes. -/
def chartSubschemeΓEquiv
    (eU : D.restrictedModule U ≅ SheafOfModules.unit U.toScheme.ringCatSheaf) :
    Γ(D.universalDivisor.subscheme,
        D.universalDivisor.subschemeι ⁻¹ᵁ (D.chartOpen U : D.parameterSpace.Opens)) ≃+*
      (MvPolynomial D.basisIndex Γ(U.toScheme, ⊤) ⧸
        Ideal.span {∑ j, MvPolynomial.C (D.chartEquationIndex U eU j) * MvPolynomial.X j}) :=
  (D.universalDivisor.subschemeObjIso (D.chartOpen U)).commRingCatIsoToRingEquiv.trans
    (Ideal.quotientEquiv _ _ (D.chartMvPolynomialEquiv U)
      (D.map_chartMvPolynomialEquiv_ideal_universalDivisor U eU))

/-- **Restricting a function on `𝔸^r_X` to the part of `H_univ` over the chart** is taking its
class modulo the local equation of the universal divisor. -/
theorem chartSubschemeΓEquiv_subschemeι_app
    (eU : D.restrictedModule U ≅ SheafOfModules.unit U.toScheme.ringCatSheaf)
    (a : Γ(D.parameterSpace, (D.chartOpen U : D.parameterSpace.Opens))) :
    D.chartSubschemeΓEquiv U eU (D.universalDivisor.subschemeι.app (D.chartOpen U) a) =
      Ideal.Quotient.mk _ (D.chartMvPolynomialEquiv U a) := by
  have hmk : (D.universalDivisor.subschemeObjIso (D.chartOpen U)).hom
      (D.universalDivisor.subschemeι.app (D.chartOpen U) a) =
      Ideal.Quotient.mk (D.universalDivisor.ideal (D.chartOpen U)) a := by
    rw [← CommRingCat.comp_apply,
      Scheme.IdealSheafData.subschemeι_app D.universalDivisor (D.chartOpen U),
      Category.assoc, Iso.inv_hom_id, Category.comp_id]
    rfl
  change Ideal.quotientEquiv _ _ (D.chartMvPolynomialEquiv U)
      (D.map_chartMvPolynomialEquiv_ideal_universalDivisor U eU)
      ((D.universalDivisor.subschemeObjIso (D.chartOpen U)).hom
        (D.universalDivisor.subschemeι.app (D.chartOpen U) a)) = _
  rw [hmk, Ideal.quotientEquiv_mk]

/-- **The universal divisor is irreducible over a trivializing affine chart.** Let `U = Spec A`
be an affine open of `X` on which `L` is trivialized, with `A` Noetherian and `Spec A`
irreducible, and let `f₁, …, f_r ∈ A` be the functions representing the sections
`ψ(v₁), …, ψ(v_r)` there. If some `fᵢ` is not nilpotent and every irreducible component of
`V(f₁, …, f_r)` has codimension at least two in `Spec A`, then the zero locus of the ideal of
`H_univ` on the chart over `U` is irreducible.

This is `Algebra.isIrreducible_zeroLocus_linearForm_of_isPrime_nilradical` transported along the
identification of the functions on the chart with `A[xᵢ]`. -/
theorem isIrreducible_zeroLocus_ideal_universalDivisor_chartOpen
    [IsNoetherianRing Γ(U.toScheme, ⊤)] (hnil : (nilradical Γ(U.toScheme, ⊤)).IsPrime)
    (eU : D.restrictedModule U ≅ SheafOfModules.unit U.toScheme.ringCatSheaf)
    {i₀ : Fin (Module.finrank D.k D.V)} (hf : ¬ IsNilpotent (D.chartEquation eU i₀))
    (hcodim : ∀ p ∈ (Ideal.span (Set.range (D.chartEquation eU))).minimalPrimes,
      2 ≤ p.height) :
    IsIrreducible (PrimeSpectrum.zeroLocus
      (D.universalDivisor.ideal (D.chartOpen U) :
        Set Γ(D.parameterSpace, (D.chartOpen U).1))) := by
  have hbase := Algebra.isIrreducible_zeroLocus_linearForm_of_isPrime_nilradical hnil
    (D.chartEquationIndex U eU) (i₀ := ULift.up i₀) hf
    (by rwa [D.range_chartEquationIndex U eU])
  have hset : ({D.chartΓEquiv U (D.chartSection eU)} :
      Set Γ(D.parameterSpace, (D.chartOpen U).1)) =
      (D.chartMvPolynomialEquiv U).symm ''
        {∑ j, MvPolynomial.C (D.chartEquationIndex U eU j) * MvPolynomial.X j} := by
    rw [Set.image_singleton, ← D.chartMvPolynomialEquiv_chartΓEquiv_chartSection U eU,
      RingEquiv.symm_apply_apply]
  rw [D.ideal_universalDivisor_chartOpen U eU, PrimeSpectrum.zeroLocus_span, hset]
  exact PrimeSpectrum.isIrreducible_zeroLocus_image _ _ hbase

/-- **The part of the universal divisor over a trivializing affine chart is irreducible.** In the
situation of `isIrreducible_zeroLocus_ideal_universalDivisor_chartOpen`, the intersection of the
support of `H_univ` with the chart of the parameter space over `U` is an irreducible subset of
`𝔸^r_X`.

This is the local step of the proof of [Stacks, Tag 0G4F]: the irreducibility of `H_U`. -/
theorem isIrreducible_supportSet_inter_chart
    [IsNoetherianRing Γ(U.toScheme, ⊤)] (hnil : (nilradical Γ(U.toScheme, ⊤)).IsPrime)
    (eU : D.restrictedModule U ≅ SheafOfModules.unit U.toScheme.ringCatSheaf)
    {i₀ : Fin (Module.finrank D.k D.V)} (hf : ¬ IsNilpotent (D.chartEquation eU i₀))
    (hcodim : ∀ p ∈ (Ideal.span (Set.range (D.chartEquation eU))).minimalPrimes,
      2 ≤ p.height) :
    IsIrreducible (D.universalDivisor.supportSet ∩
      (AffineSpace.chart D.basisIndex U : Set D.parameterSpace)) := by
  rw [← D.chartOpen_coe U, Scheme.IdealSheafData.supportSet_inter,
    ← (D.chartOpen U).2.fromSpec_image_zeroLocus]
  exact (D.isIrreducible_zeroLocus_ideal_universalDivisor_chartOpen U hnil eU hf hcodim).image _
    (D.chartOpen U).2.fromSpec.continuous.continuousOn

/-- **The universal divisor is irreducible.** Let `X` be covered by affine opens `Uᵢ = Spec Aᵢ`
trivializing `L`, with each `Aᵢ` Noetherian and each `Spec Aᵢ` irreducible, on each of which some
section `ψ(v_j)` is represented by a function that is not nilpotent and the common zero locus of
the representing functions has every irreducible component of codimension at least two. If
`H_univ` is nonempty and any two of its nonempty parts over the `Uᵢ` meet, then `H_univ` is
irreducible.

This is the passage from the charts to `H_univ` in the proof of [Stacks, Tag 0G4F]: the chart
pieces are irreducible by
`Stacks.Bertini.FamilyDivisors.isIrreducible_supportSet_inter_chart`, they are open and they
cover, so `isIrreducible_of_isOpen_cover` applies. -/
theorem isIrreducible_supportSet_universalDivisor {ι : Sort*} (W : ι → D.X.Opens)
    (hW : ⨆ i, W i = ⊤) [∀ i, IsAffine (W i).toScheme]
    [∀ i, IsNoetherianRing Γ((W i).toScheme, ⊤)]
    (hnil : ∀ i, (nilradical Γ((W i).toScheme, ⊤)).IsPrime)
    (eW : ∀ i, D.restrictedModule (W i) ≅ SheafOfModules.unit (W i).toScheme.ringCatSheaf)
    (hf : ∀ i, ∃ j, ¬ IsNilpotent (D.chartEquation (eW i) j))
    (hcodim : ∀ i, ∀ p ∈ (Ideal.span (Set.range (D.chartEquation (eW i)))).minimalPrimes,
      2 ≤ p.height)
    (hne : D.universalDivisor.supportSet.Nonempty)
    (hmeet : ∀ i j,
      (D.universalDivisor.supportSet ∩
        (AffineSpace.chart D.basisIndex (W i) : Set D.parameterSpace)).Nonempty →
      (D.universalDivisor.supportSet ∩
        (AffineSpace.chart D.basisIndex (W j) : Set D.parameterSpace)).Nonempty →
      (D.universalDivisor.supportSet ∩
        (AffineSpace.chart D.basisIndex (W i) : Set D.parameterSpace) ∩
        (AffineSpace.chart D.basisIndex (W j) : Set D.parameterSpace)).Nonempty) :
    IsIrreducible D.universalDivisor.supportSet := by
  refine isIrreducible_of_isOpen_cover hne
    (fun i => (AffineSpace.chart D.basisIndex (W i) : Set D.parameterSpace))
    (fun i => (AffineSpace.chart D.basisIndex (W i)).isOpen) ?_ (fun i _ => ?_) hmeet
  · rw [AffineSpace.iUnion_coe_chart D.basisIndex W hW]
    exact Set.subset_univ _
  · obtain ⟨j, hj⟩ := hf i
    exact D.isIrreducible_supportSet_inter_chart (W i) (hnil i) (eW i) hj (hcodim i)

/-- **The universal divisor is irreducible, for a cover closed under refining intersections.**
Same as `Stacks.Bertini.FamilyDivisors.isIrreducible_supportSet_universalDivisor`, but with the
two topological hypotheses replaced by the requirement that the intersection of any two members
of the cover contain a member: the parts of `H_univ` over the charts are then automatically
nonempty, because each is irreducible, and the part over a member inside `Uᵢ ∩ Uⱼ` witnesses
that the parts over `Uᵢ` and over `Uⱼ` meet.

This is the shape in which the union argument of [Stacks, Tag 0G4F] is run: the cover is the
family of all affine opens of `X` trivializing `L` on which the hypotheses hold, which is closed
under passing to a smaller affine open. -/
@[stacks 0G4F "the passage from the trivializing charts to the universal divisor"]
theorem isIrreducible_supportSet_universalDivisor_of_directed {ι : Sort*} [Nonempty ι]
    (W : ι → D.X.Opens) (hW : ⨆ i, W i = ⊤) (hdir : ∀ i j, ∃ k, W k ≤ W i ⊓ W j)
    [∀ i, IsAffine (W i).toScheme] [∀ i, IsNoetherianRing Γ((W i).toScheme, ⊤)]
    (hnil : ∀ i, (nilradical Γ((W i).toScheme, ⊤)).IsPrime)
    (eW : ∀ i, D.restrictedModule (W i) ≅ SheafOfModules.unit (W i).toScheme.ringCatSheaf)
    (hf : ∀ i, ∃ j, ¬ IsNilpotent (D.chartEquation (eW i) j))
    (hcodim : ∀ i, ∀ p ∈ (Ideal.span (Set.range (D.chartEquation (eW i)))).minimalPrimes,
      2 ≤ p.height) :
    IsIrreducible D.universalDivisor.supportSet := by
  have hpiece : ∀ i, IsIrreducible (D.universalDivisor.supportSet ∩
      (AffineSpace.chart D.basisIndex (W i) : Set D.parameterSpace)) := fun i => by
    obtain ⟨j, hj⟩ := hf i
    exact D.isIrreducible_supportSet_inter_chart (W i) (hnil i) (eW i) hj (hcodim i)
  refine D.isIrreducible_supportSet_universalDivisor W hW hnil eW hf hcodim
    ((hpiece (Classical.arbitrary ι)).1.mono Set.inter_subset_left) fun i j _ _ => ?_
  obtain ⟨k, hk⟩ := hdir i j
  obtain ⟨x, hxS, hxk⟩ := (hpiece k).1
  exact ⟨x, ⟨hxS, AffineSpace.chart_mono (hk.trans inf_le_left) hxk⟩,
    AffineSpace.chart_mono (hk.trans inf_le_right) hxk⟩

/-- **`H_univ` is an irreducible scheme.** The closed subscheme of `𝔸^r_X` cut out by the
universal divisor is irreducible as soon as the support of the universal divisor is; this is the
form in which the generic point of `H_univ`, and hence its function field, is available.

The scheme in the statement is `Stacks.Bertini.FamilyDivisors.universalDivisorScheme`. -/
theorem irreducibleSpace_universalDivisor_subscheme
    (h : IsIrreducible D.universalDivisor.supportSet) :
    IrreducibleSpace D.universalDivisor.subscheme :=
  Scheme.IdealSheafData.irreducibleSpace_subscheme _ D.universalDivisor
    (by rwa [Scheme.IdealSheafData.range_subschemeι])

end Stacks.Bertini.FamilyDivisors

end
