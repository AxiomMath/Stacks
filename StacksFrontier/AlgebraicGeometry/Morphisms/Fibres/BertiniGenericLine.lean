module

public import StacksFrontier.AlgebraicGeometry.Morphisms.Fibres.Bertini
public import StacksFrontier.AlgebraicGeometry.Morphisms.Fibres.BertiniChartFunctionField

/-!
# Geometric irreducibility of the generic line section

Let `K/k` be a finitely generated, geometrically irreducible field extension, think of it as the
function field of a variety `X`, and let `s, t₁, …, tₙ` be algebraically independent elements of
`K`. Cutting `X` by the `n` generic hyperplanes

    tᵢ x₀ᵢ = ξᵢ + x₁ᵢ s,        with `x₀ᵢ, x₁ᵢ, ξᵢ` independent indeterminates,

is the same as restricting the map `(s, t) : X → 𝔸^{n+1}` to the generic line
`tᵢ = (ξᵢ + x₁ᵢ s)/x₀ᵢ`.
This module shows that the generic fibre stays geometrically irreducible: one cut is Stacks Tag
0G4D applied to the pair `g = (tᵢ, -s)`, and the cuts are performed one after another, each over
the field generated by the parameters of the previous ones.

This is the reduction from a geometrically irreducible variety to a geometrically irreducible curve
in the Lang–Weil argument behind the remark Stacks Tag 0BA7 (points of every large degree over a
finite field).

## Main results

* `Algebra.algebraicIndependent_lineCut`: after one cut, `x₀, x₁, ξ = t x₀ - s x₁`, `s` and the
  remaining members of the independent family are algebraically independent.
* `Algebra.isGeometricallyIrreducible_lineCut`: one generic cut is geometrically irreducible, by
  Stacks Tag 0G4D.
* `Algebra.exists_isGeometricallyIrreducible_genericLine`: **the generic line section.** All `n`
  cuts, with the parameter field `E = k(x₀ᵢ, x₁ᵢ, ξᵢ)` purely transcendental over `k`, the field
  `L` geometrically irreducible over `E` and generated over `E` by `K`, and `s` still
  transcendental over `E`.

## Implementation notes

The iteration produces a new pair of fields at every cut: the next ambient field is
`FractionRing (MvPolynomial (Fin 2) L)` and the next base field is the intermediate field of it
generated by the parameters, as in Tag 0G4D. The statement therefore quantifies existentially over
the two fields and their algebra structures, and records only what later steps use.

## References

* [Stacks Project, Tag 0G4D](https://stacks.math.columbia.edu/tag/0G4D)
* [Stacks Project, Tag 0BA7](https://stacks.math.columbia.edu/tag/0BA7)
-/

@[expose] public section

universe u

open MvPolynomial

namespace Algebra

/-- An affine-linear expression `a * t + b` with `a ≠ 0` in a transcendental element `t` is again
transcendental. -/
theorem transcendental_algebraMap_mul_add {S A : Type*} [CommRing S] [IsDomain S] [CommRing A]
    [IsDomain A] [Algebra S A] {t : A} (ht : Transcendental S t) {a : S}
    (ha : algebraMap S A a ≠ 0) (b : S) :
    Transcendental S (algebraMap S A a * t + algebraMap S A b) := by
  intro h
  have h1 : IsAlgebraic S (algebraMap S A a * t) := by
    simpa using h.sub (isAlgebraic_algebraMap (R := S) (A := A) b)
  exact ht (IsAlgebraic.of_mul (mem_nonZeroDivisors_of_ne_zero ha)
    (isAlgebraic_algebraMap a) h1)


section LineCut

variable {E L Ω : Type u} [Field E] [Field L] [Field Ω] [Algebra E L] [Algebra L Ω]
  [Algebra E Ω] [IsScalarTower E L Ω]

/-- **Algebraic independence after one cut.** Let `s, t` and a family `w` in `L` be algebraically
independent over `E`, and let `x₀, x₁ ∈ Ω` be algebraically independent over `L`. Then `x₀, x₁`,
the linear combination `ξ = t x₀ - s x₁`, the element `s` and the family `w` are algebraically
independent over `E`. -/
theorem algebraicIndependent_lineCut {ι : Type*} {x : Fin 2 → Ω} (hx : AlgebraicIndependent L x)
    {s t : L} {w : ι → L}
    (h : AlgebraicIndependent E fun o : Option (Option ι) => o.elim s fun o' => o'.elim t w) :
    AlgebraicIndependent E fun o : Option (Fin 2 ⊕ Option ι) =>
      o.elim (algebraMap L Ω t * x 0 - algebraMap L Ω s * x 1)
        (Sum.elim x fun o' => algebraMap L Ω (o'.elim s w)) := by
  set Z : Fin 2 ⊕ Option ι → Ω := Sum.elim x fun o' => algebraMap L Ω (o'.elim s w) with hZ
  have h1 := h.sumElim_comp hx
  let f : Option (Fin 2 ⊕ Option ι) → Fin 2 ⊕ Option (Option ι) := fun o =>
    o.elim (Sum.inr (some none))
      (Sum.elim Sum.inl fun o' => Sum.inr (o'.elim none fun j => some (some j)))
  have hf : Function.Injective f := by
    rintro (_ | _ | _ | _) (_ | _ | _ | _) <;> simp [f]
  have h2 := h1.comp f hf
  have hfam : (Sum.elim x (algebraMap L Ω ∘ fun o : Option (Option ι) =>
      o.elim s fun o' => o'.elim t w)) ∘ f = fun o => o.elim (algebraMap L Ω t) Z := by
    funext o
    rcases o with _ | _ | _ | _ <;> simp [f, Z]
  rw [hfam, AlgebraicIndependent.option_iff] at h2
  refine AlgebraicIndependent.option_iff.mpr ⟨h2.1, ?_⟩
  let S := Algebra.adjoin E (Set.range Z)
  let a : S := ⟨x 0, Algebra.subset_adjoin ⟨Sum.inl 0, rfl⟩⟩
  let b : S := -(⟨algebraMap L Ω s, Algebra.subset_adjoin ⟨Sum.inr none, rfl⟩⟩ *
    ⟨x 1, Algebra.subset_adjoin ⟨Sum.inl 1, rfl⟩⟩)
  have hrw : algebraMap L Ω t * x 0 - algebraMap L Ω s * x 1 =
      algebraMap S Ω a * algebraMap L Ω t + algebraMap S Ω b := by
    simp only [a, b, map_neg, map_mul]
    show _ = x 0 * _ + -(algebraMap L Ω s * x 1)
    ring
  rw [hrw]
  exact transcendental_algebraMap_mul_add h2.2 (hx.ne_zero 0) b


/-- **One generic cut is geometrically irreducible.** Let `L/E` be a finitely generated,
geometrically irreducible field extension, let `s, t` and a family `w` in `L` be algebraically
independent over `E`, and let `Ω = L(x₀, x₁)` with `x₀, x₁` algebraically independent over `L`.
Then `Ω` is geometrically irreducible over `F = E(x₀, x₁, ξ)`, where `ξ = t x₀ - s x₁`. This is
Stacks Tag 0G4D for the pair `g = (t, -s)`. -/
theorem isGeometricallyIrreducible_lineCut [hL : Algebra.IsGeometricallyIrreducible E L]
    (hfg : (⊤ : IntermediateField E L).FG) {ι : Type*} {x : Fin 2 → Ω}
    (hgen : IntermediateField.adjoin L (Set.range x) = ⊤) (hx : AlgebraicIndependent L x)
    {s t : L} {w : ι → L}
    (h : AlgebraicIndependent E fun o : Option (Option ι) => o.elim s fun o' => o'.elim t w) :
    letI F := IntermediateField.adjoin E
      (Set.range x ∪ {algebraMap L Ω t * x 0 - algebraMap L Ω s * x 1})
    letI : Algebra F Ω := F.toSubalgebra.toAlgebra
    Algebra.IsGeometricallyIrreducible F Ω := by
  have hAI := algebraicIndependent_lineCut hx h
  have hξ : ∑ i, algebraMap L Ω (![t, -s] i) * x i =
      algebraMap L Ω t * x 0 - algebraMap L Ω s * x 1 := by
    simp [Fin.sum_univ_two]
    ring
  let f : Fin 2 ⊕ Bool → Option (Fin 2 ⊕ Option ι) :=
    Sum.elim (fun i => some (Sum.inl i)) fun b => b.rec none (some (Sum.inr none))
  have hf : Function.Injective f := by
    rintro (_ | _ | _) (_ | _ | _) <;> simp [f]
  have key := isGeometricallyIrreducible_adjoin_linearCombination E L Ω 2 (by norm_num) x
    ![t, -s] hgen hx hL hfg ![0, -1] (by
      convert hAI.comp f hf using 1
      funext o
      rcases o with i | _ | _
      · simp [f]
      · simp [f, hξ]
      · simp [f])
  exact hξ ▸ key

/-- **The remaining members stay independent after one cut.** In the situation of
`Algebra.isGeometricallyIrreducible_lineCut`, the element `s` and the family `w` are algebraically
independent over `F = E(x₀, x₁, ξ)`. -/
theorem algebraicIndependent_adjoin_lineCut {ι : Type*} {x : Fin 2 → Ω}
    (hx : AlgebraicIndependent L x) {s t : L} {w : ι → L}
    (h : AlgebraicIndependent E fun o : Option (Option ι) => o.elim s fun o' => o'.elim t w) :
    AlgebraicIndependent
      (IntermediateField.adjoin E
        (Set.range x ∪ {algebraMap L Ω t * x 0 - algebraMap L Ω s * x 1}))
      fun o : Option ι => algebraMap L Ω (o.elim s w) := by
  have hAI := algebraicIndependent_lineCut hx h
  set ξ := algebraMap L Ω t * x 0 - algebraMap L Ω s * x 1
  let X : Option (Fin 2) → Ω := fun o => o.elim ξ x
  let f : Option ι ⊕ Option (Fin 2) → Option (Fin 2 ⊕ Option ι) :=
    Sum.elim (fun o => some (Sum.inr o)) fun o => o.elim none fun i => some (Sum.inl i)
  have hf : Function.Injective f := by
    rintro (_ | _ | _) (_ | _ | _) <;> simp [f]
  have h2 := hAI.comp f hf
  have hfam : (fun o : Option (Fin 2 ⊕ Option ι) =>
      o.elim ξ (Sum.elim x fun o' => algebraMap L Ω (o'.elim s w))) ∘ f =
      Sum.elim (fun o : Option ι => algebraMap L Ω (o.elim s w)) X := by
    funext o
    rcases o with (_ | _) | (_ | _) <;> simp [f, X]
  rw [hfam, AlgebraicIndependent.sumElim_iff] at h2
  have hrange : Set.range X = Set.range x ∪ {ξ} := by
    rw [Set.union_singleton]
    exact Option.range_elim ξ x
  rw [← hrange, IntermediateField.algebraicIndependent_adjoin_iff]
  exact h2.2

end LineCut

section Adjoin

variable {k K E L : Type*} [Field k] [Field K] [Field E] [Field L] [Algebra k K] [Algebra k E]
  [Algebra E L] [Algebra k L] [Algebra K L] [IsScalarTower k E L] [IsScalarTower k K L]

/-- If `L` is generated over `E` by the image of an extension `K = k(S)` of `k`, then any subset
`T` of `L` whose intermediate field over `E` contains the image of `S` generates `L` over `E`. -/
theorem adjoin_eq_top_of_image_subset {S : Set K} (hS : IntermediateField.adjoin k S = ⊤)
    (h : IntermediateField.adjoin E (Set.range (algebraMap K L)) = ⊤) {T : Set L}
    (hST : algebraMap K L '' S ⊆ IntermediateField.adjoin E T) :
    IntermediateField.adjoin E T = ⊤ := by
  refine top_le_iff.mp (h.symm.trans_le ?_)
  rw [IntermediateField.adjoin_le_iff]
  rintro _ ⟨z, rfl⟩
  have hz : z ∈ IntermediateField.adjoin k S := hS ▸ IntermediateField.mem_top
  have hmap : IsScalarTower.toAlgHom k K L z ∈
      (IntermediateField.adjoin k S).map (IsScalarTower.toAlgHom k K L) := ⟨z, hz, rfl⟩
  rw [IntermediateField.adjoin_map] at hmap
  have hle : IntermediateField.adjoin k (IsScalarTower.toAlgHom k K L '' S) ≤
      (IntermediateField.adjoin E T).restrictScalars k := by
    rw [IntermediateField.adjoin_le_iff]
    exact hST
  exact hle hmap

/-- If `L` is generated over `E` by the image of a finitely generated extension `K` of `k`, then
`L` is finitely generated over `E`. -/
theorem fg_top_of_adjoin_range_eq_top (hfg : (⊤ : IntermediateField k K).FG)
    (h : IntermediateField.adjoin E (Set.range (algebraMap K L)) = ⊤) :
    (⊤ : IntermediateField E L).FG := by
  classical
  obtain ⟨S, hS⟩ := hfg
  refine ⟨S.image (algebraMap K L), (adjoin_eq_top_of_image_subset hS h ?_)⟩
  intro z hz
  exact IntermediateField.subset_adjoin E _ (by simpa using hz)

omit [Algebra k K] [Algebra k E] [Algebra k L] [IsScalarTower k E L] [IsScalarTower k K L] in
/-- If `L = E(K)` and `Ω = L(x)` with `x` lying in an intermediate field `F` of `Ω/E`, then
`Ω = F(K)`. -/
theorem adjoin_range_algebraMap_eq_top_of_subset {Ω : Type*} [Field Ω] [Algebra L Ω] [Algebra E Ω]
    [IsScalarTower E L Ω] [Algebra K Ω] [IsScalarTower K L Ω] {ι : Type*} {x : ι → Ω}
    (hgen : IntermediateField.adjoin L (Set.range x) = ⊤)
    (h : IntermediateField.adjoin E (Set.range (algebraMap K L)) = ⊤)
    (F : IntermediateField E Ω) (hx : Set.range x ⊆ F) :
    IntermediateField.adjoin F (Set.range (algebraMap K Ω)) = ⊤ := by
  set M := IntermediateField.adjoin F (Set.range (algebraMap K Ω))
  have hL : ∀ l : L, algebraMap L Ω l ∈ M := by
    intro l
    have hl : l ∈ IntermediateField.adjoin E (Set.range (algebraMap K L)) :=
      h ▸ IntermediateField.mem_top
    have hmap : IsScalarTower.toAlgHom E L Ω l ∈
        (IntermediateField.adjoin E (Set.range (algebraMap K L))).map
          (IsScalarTower.toAlgHom E L Ω) := ⟨l, hl, rfl⟩
    rw [IntermediateField.adjoin_map] at hmap
    have hle : IntermediateField.adjoin E
        (IsScalarTower.toAlgHom E L Ω '' Set.range (algebraMap K L)) ≤ M.restrictScalars E := by
      rw [IntermediateField.adjoin_le_iff]
      rintro _ ⟨_, ⟨z, rfl⟩, rfl⟩
      exact IntermediateField.subset_adjoin F _ ⟨z, IsScalarTower.algebraMap_apply K L Ω z⟩
    exact hle hmap
  refine top_le_iff.mp fun z _ => ?_
  have hz : z ∈ IntermediateField.adjoin L (Set.range x) := hgen ▸ IntermediateField.mem_top
  have hle : (IntermediateField.adjoin L (Set.range x)).toSubfield ≤ M.toSubfield := by
    rw [IntermediateField.adjoin_toSubfield]
    refine Subfield.closure_le.mpr ?_
    rintro _ (⟨l, rfl⟩ | ⟨i, rfl⟩)
    · exact hL l
    · exact M.algebraMap_mem (⟨x i, hx ⟨i, rfl⟩⟩ : F)
  exact hle hz

omit [Algebra k K] [Algebra K L] [IsScalarTower k K L] [Algebra E L] [Algebra k L]
  [IsScalarTower k E L] in
/-- If `E = k(p)`, then the intermediate field of `Ω/E` generated by `T` is generated over `k` by
the image of `p` together with `T`. -/
theorem adjoin_range_comp_union_eq_restrictScalars {Ω : Type*} [Field Ω] [Algebra E Ω]
    [Algebra k Ω] [IsScalarTower k E Ω] {ι : Type*} {p : ι → E}
    (hp : IntermediateField.adjoin k (Set.range p) = ⊤) (T : Set Ω) :
    IntermediateField.adjoin k (Set.range (algebraMap E Ω ∘ p) ∪ T) =
      (IntermediateField.adjoin E T).restrictScalars k := by
  set M := IntermediateField.adjoin k (Set.range (algebraMap E Ω ∘ p) ∪ T)
  refine le_antisymm ?_ fun z hz => ?_
  · rw [IntermediateField.adjoin_le_iff]
    rintro _ (⟨i, rfl⟩ | hT)
    · exact IntermediateField.algebraMap_mem _ (p i)
    · exact IntermediateField.subset_adjoin E T hT
  · have hE : ∀ e : E, algebraMap E Ω e ∈ M := by
      intro e
      have he : e ∈ IntermediateField.adjoin k (Set.range p) := hp ▸ IntermediateField.mem_top
      have hmap : IsScalarTower.toAlgHom k E Ω e ∈
          (IntermediateField.adjoin k (Set.range p)).map (IsScalarTower.toAlgHom k E Ω) :=
        ⟨e, he, rfl⟩
      rw [IntermediateField.adjoin_map, ← Set.range_comp] at hmap
      exact IntermediateField.adjoin.mono k _ _ Set.subset_union_left hmap
    have hz' : z ∈ IntermediateField.adjoin E T := hz
    have hle : (IntermediateField.adjoin E T).toSubfield ≤ M.toSubfield := by
      rw [IntermediateField.adjoin_toSubfield]
      refine Subfield.closure_le.mpr ?_
      rintro _ (⟨e, rfl⟩ | hT)
      · exact hE e
      · exact IntermediateField.subset_adjoin k _ (Set.mem_union_right _ hT)
    exact hle hz'

omit [Algebra k K] [Algebra K L] [IsScalarTower k K L] [Algebra E L] [Algebra k L]
  [IsScalarTower k E L] in
/-- A family `q` in an intermediate field `F` of `Ω/E` generates `F` over `k` as soon as its image
in `Ω` generates `F` over `k`. -/
theorem adjoin_range_eq_top_of_restrictScalars {Ω : Type*} [Field Ω] [Algebra E Ω] [Algebra k Ω]
    [IsScalarTower k E Ω] (F : IntermediateField E Ω) [IsScalarTower k F Ω] {ι : Type*}
    (q : ι → F)
    (hq : IntermediateField.adjoin k (Set.range (algebraMap F Ω ∘ q)) = F.restrictScalars k) :
    IntermediateField.adjoin k (Set.range q) = ⊤ := by
  apply IntermediateField.map_injective (IsScalarTower.toAlgHom k F Ω)
  rw [IntermediateField.adjoin_map, ← Set.range_comp]
  rw [show (⇑(IsScalarTower.toAlgHom k F Ω) ∘ q) = algebraMap F Ω ∘ q from rfl, hq]
  ext z
  simp only [IntermediateField.mem_restrictScalars, IntermediateField.mem_map,
    IntermediateField.mem_top, true_and, IsScalarTower.coe_toAlgHom']
  exact ⟨fun hz => ⟨⟨z, hz⟩, rfl⟩, by rintro ⟨y, rfl⟩; exact y.2⟩

end Adjoin

section Reindex

variable {R A : Type*} [CommRing R] [CommRing A] [Algebra R A]

/-- Splitting off the last row of a `Fin (n + 1) × β`-indexed family. -/
theorem algebraicIndependent_lastCases {β : Type*} {n : ℕ} {a : β → A} {b : Fin n × β → A}
    (h : AlgebraicIndependent R (Sum.elim a b)) :
    AlgebraicIndependent R fun q : Fin (n + 1) × β =>
      Fin.lastCases (motive := fun _ => β → A) a (fun i j => b (i, j)) q.1 q.2 := by
  let φ : Fin (n + 1) × β → β ⊕ (Fin n × β) := fun q =>
    Fin.lastCases (motive := fun _ => β ⊕ (Fin n × β)) (Sum.inl q.2) (fun i => Sum.inr (i, q.2))
      q.1
  have hφ : Function.Injective φ := by
    rintro ⟨i, j⟩ ⟨i', j'⟩ h
    induction i using Fin.lastCases <;> induction i' using Fin.lastCases <;> simp_all [φ]
  convert h.comp φ hφ using 1
  funext ⟨i, j⟩
  induction i using Fin.lastCases <;> simp [φ]

/-- The range of a family split off along its last row. -/
theorem range_lastCases {α β : Type*} {n : ℕ} (a : β → α) (b : Fin n × β → α) :
    (Set.range fun q : Fin (n + 1) × β =>
      Fin.lastCases (motive := fun _ => β → α) a (fun i j => b (i, j)) q.1 q.2) =
      Set.range b ∪ Set.range a := by
  ext z
  constructor
  · rintro ⟨⟨i, j⟩, rfl⟩
    induction i using Fin.lastCases with
    | last => exact Or.inr ⟨j, by simp⟩
    | cast i => exact Or.inl ⟨(i, j), by simp⟩
  · rintro (⟨⟨i, j⟩, rfl⟩ | ⟨j, rfl⟩)
    · exact ⟨(i.castSucc, j), by simp⟩
    · exact ⟨(Fin.last n, j), by simp⟩

/-- Three members of a family indexed by `Option (Fin 2 ⊕ ι)`. -/
theorem algebraicIndependent_three_of_option {ι : Type*} {ξ : A} {x : Fin 2 → A} {z : ι → A}
    (h : AlgebraicIndependent R fun o : Option (Fin 2 ⊕ ι) => o.elim ξ (Sum.elim x z)) :
    AlgebraicIndependent R ![x 0, x 1, ξ] := by
  let f : Fin 3 → Option (Fin 2 ⊕ ι) := ![some (Sum.inl 0), some (Sum.inl 1), none]
  have hf : Function.Injective f := by
    intro a b hab
    fin_cases a <;> fin_cases b <;> simp_all [f]
  convert h.comp f hf using 1
  funext j
  fin_cases j <;> rfl

/-- The range of `![x 0, x 1, ξ]`. -/
theorem range_three {α : Type*} (x : Fin 2 → α) (ξ : α) :
    Set.range ![x 0, x 1, ξ] = Set.range x ∪ {ξ} := by
  ext z
  simp only [Set.mem_range, Set.mem_union, Set.mem_singleton_iff, Fin.exists_fin_succ]
  simp [eq_comm, or_assoc]

end Reindex

section GenericLine

/-- **Geometric irreducibility of the generic line section.** Let `K/k` be a finitely generated,
geometrically irreducible field extension and let `s, t₁, …, tₙ` together with a family `w` be
algebraically independent over `k`. Cut `n` times by the generic hyperplanes
`tᵢ x₀ᵢ = ξᵢ + x₁ᵢ s`, with `x₀ᵢ, x₁ᵢ, ξᵢ` independent indeterminates. The outcome is a tower
`k ⊆ E ⊆ L ⊇ K` with

* `E = k(x₀ᵢ, x₁ᵢ, ξᵢ)` purely transcendental over `k` on the `3n` parameters `p i j`;
* `L` geometrically irreducible over `E` and generated over `E` by the image of `K`;
* `s` and the family `w` still algebraically independent over `E`;
* the relations `tᵢ x₀ᵢ = ξᵢ + x₁ᵢ s` in `L`.

When `s, t` is a transcendence basis of `K/k`, `L` is the function field of the preimage in
`Spec K`'s model of the generic line `tᵢ = (ξᵢ + x₁ᵢ s)/x₀ᵢ` of the `t`-space. -/
theorem exists_isGeometricallyIrreducible_genericLine (k K : Type u) [Field k] [Field K]
    [Algebra k K] [Algebra.IsGeometricallyIrreducible k K]
    (hfg : (⊤ : IntermediateField k K).FG) (n : ℕ) {ι : Type u} (s : K) (t : Fin n → K)
    (w : ι → K)
    (hind : AlgebraicIndependent k fun o : Option (Fin n ⊕ ι) => o.elim s (Sum.elim t w)) :
    ∃ (E L : Type u) (_ : Field E) (_ : Field L) (_ : Algebra k E) (_ : Algebra E L)
      (_ : Algebra k L) (_ : Algebra K L) (_ : IsScalarTower k E L) (_ : IsScalarTower k K L)
      (p : Fin n → Fin 3 → E),
      AlgebraicIndependent k (fun q : Fin n × Fin 3 => p q.1 q.2) ∧
      IntermediateField.adjoin k (Set.range fun q : Fin n × Fin 3 => p q.1 q.2) = ⊤ ∧
      Algebra.IsGeometricallyIrreducible E L ∧
      IntermediateField.adjoin E (Set.range (algebraMap K L)) = ⊤ ∧
      AlgebraicIndependent E (fun o : Option ι => algebraMap K L (o.elim s w)) ∧
      ∀ i, algebraMap K L (t i) * algebraMap E L (p i 0) =
        algebraMap E L (p i 2) + algebraMap E L (p i 1) * algebraMap K L s := by
  induction n generalizing ι with
  | zero =>
    refine ⟨k, K, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
      inferInstance, inferInstance, inferInstance, Fin.elim0, ?_, ?_, inferInstance, ?_, ?_,
      fun i => i.elim0⟩
    · exact algebraicIndependent_empty_type
    · refine top_le_iff.mp fun z _ => ?_
      exact IntermediateField.algebraMap_mem _ z
    · simp
    · let f : Option ι → Option (Fin 0 ⊕ ι) := fun o => o.elim none fun j => some (Sum.inr j)
      have hf : Function.Injective f := by
        rintro (_ | _) (_ | _) <;> simp [f]
      convert hind.comp f hf using 1
      funext o
      rcases o with _ | _ <;> simp [f]
  | succ n ih =>
    -- Move the last of the `t`'s into the family `w` and cut the other `n` first.
    let w' : Option ι → K := fun o => o.elim (t (Fin.last n)) w
    let g : Option (Fin n ⊕ Option ι) → Option (Fin (n + 1) ⊕ ι) := fun o =>
      o.elim none (Sum.elim (fun i => some (Sum.inl i.castSucc))
        fun o' => o'.elim (some (Sum.inl (Fin.last n))) fun j => some (Sum.inr j))
    have hg : Function.Injective g := by
      rintro (_ | _ | _ | _) (_ | _ | _ | _) <;> simp [g, Fin.castSucc_ne_last, Fin.castSucc_inj,
        (Fin.castSucc_ne_last _).symm]
    have hind' : AlgebraicIndependent k fun o : Option (Fin n ⊕ Option ι) =>
        o.elim s (Sum.elim (t ∘ Fin.castSucc) w') := by
      convert hind.comp g hg using 1
      funext o
      rcases o with _ | _ | _ | _ <;> simp [g, w']
    obtain ⟨E, L, _, _, _, _, _, _, _, _, p, hpind, hpgen, hL, hLgen, hsw, hrel⟩ :=
      ih (t ∘ Fin.castSucc) w' hind'
    clear ih hind hind' hg
    -- The cut.
    let Ω := FractionRing (MvPolynomial (Fin 2) L)
    let x : Fin 2 → Ω := fun i => algebraMap (MvPolynomial (Fin 2) L) Ω (X i)
    have hxgen : IntermediateField.adjoin L (Set.range x) = ⊤ :=
      adjoin_range_algebraMap_X_eq_top L Ω
    have hx : AlgebraicIndependent L x := algebraicIndependent_algebraMap_X L Ω
    have hLfg : (⊤ : IntermediateField E L).FG := fg_top_of_adjoin_range_eq_top hfg hLgen
    have hcut : AlgebraicIndependent E fun o : Option (Option ι) =>
        o.elim (algebraMap K L s) fun o' => o'.elim (algebraMap K L (t (Fin.last n)))
          (algebraMap K L ∘ w) := by
      convert hsw using 1
      funext o
      rcases o with _ | _ | _ <;> simp [w']
    set ξ : Ω := algebraMap L Ω (algebraMap K L (t (Fin.last n))) * x 0 -
      algebraMap L Ω (algebraMap K L s) * x 1 with hξ
    let F := IntermediateField.adjoin E (Set.range x ∪ {ξ})
    have hFgi : Algebra.IsGeometricallyIrreducible F Ω :=
      isGeometricallyIrreducible_lineCut hLfg hxgen hx hcut
    have hFind := algebraicIndependent_adjoin_lineCut (Ω := Ω) hx hcut
    have hAI := algebraicIndependent_lineCut (Ω := Ω) hx hcut
    have hxF : ∀ i, x i ∈ F := fun i =>
      IntermediateField.subset_adjoin E _ (Set.mem_union_left _ ⟨i, rfl⟩)
    have hξF : ξ ∈ F := IntermediateField.subset_adjoin E _ (Set.mem_union_right _ rfl)
    have : IsScalarTower k F Ω := IsScalarTower.of_algebraMap_eq fun c => rfl
    let newp : Fin 3 → F := ![⟨x 0, hxF 0⟩, ⟨x 1, hxF 1⟩, ⟨ξ, hξF⟩]
    let p' : Fin (n + 1) → Fin 3 → F :=
      Fin.lastCases newp fun i j => algebraMap E F (p i j)
    have hcomp : algebraMap F Ω ∘ newp = ![x 0, x 1, ξ] := by
      funext j
      fin_cases j <;> rfl
    refine ⟨F, Ω, inferInstance, inferInstance, inferInstance, inferInstance, inferInstance,
      inferInstance, this, inferInstance, p', ?_, ?_, hFgi, ?_, ?_, ?_⟩
    · have hold : AlgebraicIndependent k fun q : Fin n × Fin 3 => algebraMap E F (p q.1 q.2) :=
        hpind.map' (f := IsScalarTower.toAlgHom k E F) (algebraMap E F).injective
      have hnew : AlgebraicIndependent E newp := by
        refine AlgebraicIndependent.of_comp (IsScalarTower.toAlgHom E F Ω) ?_
        rw [show (⇑(IsScalarTower.toAlgHom E F Ω) ∘ newp) = algebraMap F Ω ∘ newp from rfl, hcomp]
        exact algebraicIndependent_three_of_option hAI
      have hrange : Set.range (fun q : Fin n × Fin 3 => algebraMap E F (p q.1 q.2)) ⊆
          Set.range (algebraMap E F) := fun _ ⟨q, hq⟩ => ⟨p q.1 q.2, hq⟩
      have hkEF : IsScalarTower k E F := IsScalarTower.of_algebraMap_eq fun c =>
        Subtype.ext (IsScalarTower.algebraMap_apply k E Ω c)
      have hsum := hold.sumElim_of_tower (S := E) hrange hnew
      have hfin := algebraicIndependent_lastCases hsum
      exact hfin
    · refine adjoin_range_eq_top_of_restrictScalars F _ ?_
      rw [← adjoin_range_comp_union_eq_restrictScalars hpgen, ← range_three x ξ, Set.range_comp]
      have hr := range_lastCases newp fun q : Fin n × Fin 3 => algebraMap E F (p q.1 q.2)
      rw [show (fun q : Fin (n + 1) × Fin 3 => p' q.1 q.2) = _ from rfl, hr, Set.image_union,
        ← Set.range_comp, ← Set.range_comp, hcomp]
      rfl
    · exact adjoin_range_algebraMap_eq_top_of_subset hxgen hLgen F
        (by rintro _ ⟨i, rfl⟩; exact hxF i)
    · convert hFind using 1
      funext o
      rcases o with _ | _ <;> simp [IsScalarTower.algebraMap_apply K L Ω]
    · intro i
      induction i using Fin.lastCases with
      | last =>
        simp only [p', newp, Fin.lastCases_last]
        show _ * x 0 = ξ + x 1 * _
        rw [hξ, IsScalarTower.algebraMap_apply K L Ω, IsScalarTower.algebraMap_apply K L Ω s]
        ring
      | cast i =>
        have h := congrArg (algebraMap L Ω) (hrel i)
        simp only [p', Fin.lastCases_castSucc, map_mul, map_add, Function.comp_apply] at h ⊢
        rw [IsScalarTower.algebraMap_apply K L Ω, IsScalarTower.algebraMap_apply K L Ω s,
          ← IsScalarTower.algebraMap_apply E F Ω, ← IsScalarTower.algebraMap_apply E F Ω,
          ← IsScalarTower.algebraMap_apply E F Ω, IsScalarTower.algebraMap_apply E L Ω,
          IsScalarTower.algebraMap_apply E L Ω (p i 2),
          IsScalarTower.algebraMap_apply E L Ω (p i 1)]
        exact h

end GenericLine

end Algebra
