module

public import StacksFrontier.AlgebraicGeometry.Morphisms.Fibres.BertiniChartCodimension
public import StacksFrontier.RingTheory.Ideal.NilradicalQuotient

/-!
# The chart ring of the Bertini situation as a finite type `k`-algebra, and its reduction

On a trivializing affine chart `U` of the Bertini situation of [Stacks, Tag 0G4F], the ring
`Γ(U, ⊤)` is a `k`-algebra of finite type through the structure morphism of `X`. Its reduction
`A = Γ(U, ⊤) ⧸ √0` is a domain of finite type over `k`, and when `U` meets `Z` there is a minimal
prime `p` over the ideal generated by the images of the chart functions of `v₂, v₃` with

    dim (A ⧸ p) + 2 = dim A.

## Main definitions

* `Stacks.Bertini.FamilyDivisors.chartRingHom`: the structural ring map `k → Γ(U, ⊤)`.
* `Stacks.Bertini.FamilyDivisors.chartAlgebra` and
  `Stacks.Bertini.FamilyDivisors.reducedChartAlgebra`: the resulting `k`-algebra structures on the
  chart ring and on its reduced quotient.

## Main results

* `Stacks.Bertini.FamilyDivisors.finiteType_chartRingHom`: the chart ring is of finite type over
  `k` when `X` is, and
  `Stacks.Bertini.FamilyDivisors.Hypotheses.algebraFiniteType_reducedChartRing` the same for its
  reduced quotient.
* `Stacks.Bertini.FamilyDivisors.Hypotheses.exists_ringKrullDim_quotient_add_two_eq_reducedChart`:
  on a trivializing affine chart meeting `Z`, some minimal prime `p` of the reduced chart ring `A`
  over the ideal generated by the images of the chart functions of `v₂, v₃` satisfies
  `dim (A ⧸ p) + 2 = dim A`.

## References

* [Stacks Project, Tag 0G4F](https://stacks.math.columbia.edu/tag/0G4F)
* [Stacks Project, Tag 00ON](https://stacks.math.columbia.edu/tag/00ON)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory TopologicalSpace Opposite

universe u v

namespace Stacks.Bertini.FamilyDivisors

variable {D : FamilyDivisors.{u, v}}

/-- **The structural ring map `k → Γ(U, ⊤)` of a chart**: the structure morphism of `X` on global
sections followed by restriction to `U`. -/
def chartRingHom (U : D.X.Opens) : D.k →+* Γ(U.toScheme, ⊤) :=
  (U.ι.appTop).hom.comp (baseRingHom D.k D.toBase)

/-- `chartRingHom U` sends `a` to the restriction to `U` of the scalar `a` on `X`. -/
@[simp]
theorem chartRingHom_apply (U : D.X.Opens) (a : D.k) :
    chartRingHom U a = U.ι.appTop (D.baseScalar a) :=
  rfl

/-- The `k`-algebra structure of a chart ring. -/
@[instance_reducible]
def chartAlgebra (U : D.X.Opens) : Algebra D.k Γ(U.toScheme, ⊤) :=
  (chartRingHom U).toAlgebra

/-- **A chart ring of a scheme of finite type over `k` is a finite type `k`-algebra.** -/
theorem finiteType_chartRingHom (U : D.X.Opens) [IsAffine U.toScheme]
    [LocallyOfFiniteType D.toBase] : (chartRingHom U).FiniteType := by
  have hcomp : chartRingHom U =
      ((U.ι ≫ D.toBase).appTop).hom.comp ((Scheme.ΓSpecIso (.of D.k)).inv).hom :=
    rfl
  rw [hcomp]
  refine RingHom.FiniteType.comp ?_ (RingHom.FiniteType.of_surjective _ ?_)
  · change ((U.ι ≫ D.toBase).app ⊤).hom.FiniteType
    rw [← Scheme.Hom.appLE_eq_app (f := U.ι ≫ D.toBase) (U := ⊤)]
    exact HasRingHomProperty.appLE (P := @LocallyOfFiniteType) (Q := @RingHom.FiniteType)
      (U.ι ≫ D.toBase) inferInstance ⟨⊤, isAffineOpen_top _⟩ ⟨⊤, isAffineOpen_top _⟩ _
  · exact (ConcreteCategory.bijective_of_isIso (Scheme.ΓSpecIso (.of D.k)).inv).2

/-! ### The reduced chart ring -/

/-- The reduced ring of a chart: the chart ring modulo its nilradical. -/
abbrev reducedChartRing (U : D.X.Opens) : Type u :=
  Γ(U.toScheme, ⊤) ⧸ nilradical Γ(U.toScheme, ⊤)

/-- The structural ring map `k → Γ(U, ⊤) ⧸ √0` of the reduced chart ring. -/
def reducedChartRingHom (U : D.X.Opens) : D.k →+* reducedChartRing U :=
  (Ideal.Quotient.mk _).comp (chartRingHom U)

/-- The `k`-algebra structure of the reduced chart ring. -/
@[instance_reducible]
def reducedChartAlgebra (U : D.X.Opens) : Algebra D.k (reducedChartRing U) :=
  (reducedChartRingHom U).toAlgebra

/-- The structural map of the reduced chart ring of a scheme locally of finite type over `k` is
of finite type. -/
theorem finiteType_reducedChartRingHom (U : D.X.Opens) [IsAffine U.toScheme]
    [LocallyOfFiniteType D.toBase] : (reducedChartRingHom U).FiniteType :=
  RingHom.FiniteType.comp (RingHom.FiniteType.of_surjective _ Ideal.Quotient.mk_surjective)
    (finiteType_chartRingHom U)

namespace Hypotheses

variable (h : D.Hypotheses)

include h

/-- The reduced ring of a chart is a domain. -/
theorem isDomain_reducedChartRing (c : D.Chart) : IsDomain (reducedChartRing c.U) :=
  have := h.irreducibleSpace
  have := D.isPrime_nilradical_chart c
  Ideal.Quotient.isDomain _

/-- **The reduced ring of a chart is a finite type `k`-algebra.** -/
theorem algebraFiniteType_reducedChartRing (c : D.Chart) :
    letI := reducedChartAlgebra c.U
    Algebra.FiniteType D.k (reducedChartRing c.U) := by
  let := reducedChartAlgebra c.U
  have := h.locallyOfFiniteType
  exact RingHom.finiteType_algebraMap.mp (finiteType_reducedChartRingHom c.U)

/-- On a trivializing affine chart meeting `Z`, the reduced chart ring `A` is a domain of finite
type over `k`, and some minimal prime `p` over the ideal generated by the images of the functions
of `v₂` and `v₃` satisfies `dim (A ⧸ p) + 2 = dim A`. -/
@[stacks 0G4F "hypothesis (3) as the codimension datum of the chart statements"]
theorem exists_ringKrullDim_quotient_add_two_eq_reducedChart (c : D.Chart)
    (hZ : ((c.U : Set D.X) ∩ (h.Z : Set D.X)).Nonempty) :
    letI := reducedChartAlgebra c.U
    ∃ p : Ideal (reducedChartRing c.U),
      p ∈ (Ideal.span {Ideal.Quotient.mk _ (chartFunction c.triv h.v₂),
        Ideal.Quotient.mk _ (chartFunction c.triv h.v₃)}).minimalPrimes ∧
        ringKrullDim (reducedChartRing c.U ⧸ p) + 2 = ringKrullDim (reducedChartRing c.U) := by
  let := reducedChartAlgebra c.U
  have := h.isDomain_reducedChartRing c
  have := h.algebraFiniteType_reducedChartRing c
  obtain ⟨p, hp, hph⟩ := h.exists_mem_minimalPrimes_height_eq_two c hZ
  obtain ⟨q, hq, hqh⟩ := Ideal.exists_mem_minimalPrimes_map_quotientMk_height_eq
    (le_refl (nilradical Γ(c.U.toScheme, ⊤))) hp hph
  rw [Ideal.map_span, Set.image_pair] at hq
  have : q.IsPrime := hq.isPrime
  refine ⟨q, hq, ?_⟩
  exact_mod_cast Stacks.Spectrum.LocalDimensionFormula.ringKrullDim_quotient_add_eq_ringKrullDim
    D.k (reducedChartRing c.U) q hqh

end Hypotheses

end Stacks.Bertini.FamilyDivisors

end
