module

public import StacksFrontier.AlgebraicGeometry.Morphisms.Fibres.BertiniAffineSpaceChart
public import StacksFrontier.AlgebraicGeometry.Morphisms.Fibres.BertiniFamilyDivisors
public import StacksFrontier.AlgebraicGeometry.Morphisms.Fibres.BertiniPullbackTrivialization
public import StacksFrontier.AlgebraicGeometry.Morphisms.Fibres.BertiniUniversalDivisorIrreducible

/-!
# The universal divisor on a trivializing chart

In the standing situation of the Bertini theorems ([Stacks, Tag 0G47]) the universal divisor
`H_univ ⊂ 𝔸^r_X` is the zero scheme of `s_univ = ∑ᵢ xᵢ ψ(vᵢ)`. Over an affine open
`U = Spec A` of `X` on which the invertible module `L` is trivialized, the chart
`𝔸^r_U ⊂ 𝔸^r_X` is affine with ring of functions `A[x₁, …, x_r]`, and `H_univ` is cut out there
by the universal linear form `x₁f₁ + ⋯ + x_rf_r` of the functions `fᵢ ∈ A` representing the
sections `ψ(vᵢ)`.

This is the chart-level identification that the irreducibility of `H_univ` is glued from; the
irreducibility of the chart itself is
`Algebra.isIrreducible_zeroLocus_universalLinearForm`.

## Main definitions

* `Stacks.Bertini.FamilyDivisors.chartMap` is the open immersion `𝔸^r_U ⟶ 𝔸^r_X`.
* `Stacks.Bertini.FamilyDivisors.chartEquation` is the tuple `f₁, …, f_r ∈ Γ(U, ⊤)` of
  functions representing the sections `ψ(vᵢ)` under a trivialization of `L` over `U`.

## Main results

* `Stacks.Bertini.FamilyDivisors.universalDivisor_comap_chartMap`: the universal divisor,
  pulled back to the chart, is the zero scheme of `∑ᵢ xᵢ · f_i`.
* `Stacks.Bertini.FamilyDivisors.ideal_universalDivisor_comap_chartMap`: its ideal on the
  (affine) chart is generated by that function.
* `Stacks.Bertini.FamilyDivisors.ΓIso_hom_chartSection`: under the identification of the
  functions on the chart with a polynomial ring, that function is the universal linear form.

## Implementation notes

The pullback of the universal section along `𝔸^r_U → 𝔸^r_X` is computed by
`Stacks.Bertini.zeroScheme_sum_smul_comap`, whose coefficient hypothesis is
`AlgebraicGeometry.AffineSpace.map_appTop_coord`. The resulting section lives on the pullback
of `L` along `𝔸^r_U → X`; the comparison with the pullback along `𝔸^r_U → U → X` is the
associativity isomorphism of module pullbacks, and the section is transported along it by
`AlgebraicGeometry.SectionsEqualizer.pullbackGlobalSections_comp`.

## References

* [Stacks Project, Tag 0G47](https://stacks.math.columbia.edu/tag/0G47)
* [Stacks Project, Tag 0G4F](https://stacks.math.columbia.edu/tag/0G4F)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits TopologicalSpace Opposite

universe u v

namespace Stacks.Bertini.FamilyDivisors

variable (D : FamilyDivisors.{u, v}) (U : D.X.Opens)

/-- The chart `𝔸^r_U ⟶ 𝔸^r_X` of the parameter space over an open of `X`. -/
abbrev chartMap : 𝔸(D.basisIndex; U.toScheme) ⟶ D.parameterSpace :=
  AffineSpace.map D.basisIndex U.ι

/-- The projection `𝔸^r_U ⟶ U` of a chart of the parameter space. -/
abbrev chartProjection : 𝔸(D.basisIndex; U.toScheme) ⟶ U.toScheme :=
  𝔸(D.basisIndex; U.toScheme) ↘ U.toScheme

/-- The restriction of `L` to an open of `X`, as the pullback along the open immersion. -/
abbrev restrictedModule : U.toScheme.Modules := (Scheme.Modules.pullback U.ι).obj D.L

/-- The restriction to `U` of the section of `L` attached to a vector. -/
def restrictedSection (w : D.V) : Γ(D.restrictedModule U, ⊤) :=
  pullbackGlobalSections U.ι D.L (D.sectionOf w)

/-- The chart lies over the open it is taken above. -/
theorem chartMap_comp_parameterProjection :
    D.chartMap U ≫ D.parameterProjection = D.chartProjection U ≫ U.ι :=
  AffineSpace.map_over U.ι

/-- **The universal divisor on a chart.** Pulled back to the chart over an open `U` of `X`, the
universal divisor is the zero scheme of `∑ᵢ xᵢ · ψ(vᵢ)|_U` on `𝔸^r_U`. -/
theorem universalDivisor_comap_chartMap :
    D.universalDivisor.comap (D.chartMap U) =
      zeroScheme 𝔸(D.basisIndex; U.toScheme)
        ((Scheme.Modules.pullback (D.chartProjection U)).obj (D.restrictedModule U))
        (∑ i, AffineSpace.coord U.toScheme (ULift.up i) •
          pullbackGlobalSections (D.chartProjection U) (D.restrictedModule U)
            (D.restrictedSection U (D.basis i))) := by
  let := D.isInvertible
  have hinv : SheafOfModules.IsInvertible 𝔸(D.basisIndex; U.toScheme).sheaf.obj
      𝔸(D.basisIndex; U.toScheme).ringCatSheaf.property
      ((Scheme.Modules.pullback U.ι ⋙
        Scheme.Modules.pullback (D.chartProjection U)).obj D.L) :=
    inferInstanceAs (SheafOfModules.IsInvertible 𝔸(D.basisIndex; U.toScheme).sheaf.obj
      𝔸(D.basisIndex; U.toScheme).ringCatSheaf.property
      ((Scheme.Modules.pullback (D.chartProjection U)).obj (D.restrictedModule U)))
  have hcoord : ∀ i : Fin (Module.finrank D.k D.V),
      (D.chartMap U).appTop (AffineSpace.coord D.X (ULift.up i)) =
        AffineSpace.coord U.toScheme (ULift.up i) :=
    fun i => AffineSpace.map_appTop_coord _ _
  have hbase := zeroScheme_sum_smul_comap D.L D.parameterProjection (D.chartMap U)
    (D.chartProjection U ≫ U.ι) (D.chartMap_comp_parameterProjection U)
    (fun i => AffineSpace.coord D.X (ULift.up i))
    (fun i => AffineSpace.coord U.toScheme (ULift.up i)) hcoord
    (fun i => D.sectionOf (D.basis i))
  refine hbase.symm.trans (zeroScheme_eq_of_iso
    ((Scheme.Modules.pullbackComp (D.chartProjection U) U.ι).app D.L) ?_).symm
  rw [map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [Scheme.Modules.Hom.app_smul]
  exact congrArg (fun z => AffineSpace.coord U.toScheme (ULift.up i) • z)
    (SectionsEqualizer.pullbackGlobalSections_comp (D.chartProjection U) U.ι D.L
      (D.sectionOf (D.basis i)))

variable {U}

/-- The functions `f₁, …, f_r ∈ Γ(U, ⊤)` representing the sections `ψ(v₁), …, ψ(v_r)` under a
trivialization of `L` over `U`. -/
def chartEquation (eU : D.restrictedModule U ≅ SheafOfModules.unit U.toScheme.ringCatSheaf)
    (i : Fin (Module.finrank D.k D.V)) : Γ(U.toScheme, ⊤) :=
  eU.hom.app ⊤ (D.restrictedSection U (D.basis i))

/-- The local equation of the universal divisor on a trivializing chart: the function
`∑ᵢ xᵢfᵢ` on `𝔸^r_U`. -/
def chartSection (eU : D.restrictedModule U ≅ SheafOfModules.unit U.toScheme.ringCatSheaf) :
    Γ(𝔸(D.basisIndex; U.toScheme), ⊤) :=
  ∑ i, AffineSpace.coord U.toScheme (ULift.up i) *
    (D.chartProjection U).appTop (D.chartEquation eU i)

/-- **The universal divisor is cut out on a trivializing affine chart by `∑ᵢ xᵢfᵢ`.** -/
theorem ideal_universalDivisor_comap_chartMap [IsAffine U.toScheme]
    (eU : D.restrictedModule U ≅ SheafOfModules.unit U.toScheme.ringCatSheaf) :
    (D.universalDivisor.comap (D.chartMap U)).ideal
        ⟨⊤, isAffineOpen_top 𝔸(D.basisIndex; U.toScheme)⟩ =
      Ideal.span {D.chartSection eU} := by
  let := D.isInvertible
  rw [D.universalDivisor_comap_chartMap U]
  exact Stacks.Divisors.zeroScheme_ideal_top_sum_smul (D.chartProjection U)
    (D.restrictedModule U) eU _ _

/-- **The local equation is the universal linear form.** Under the identification of the
functions on the chart with a polynomial ring over `Γ(U, ⊤)`, the local equation of the
universal divisor is `∑ᵢ xᵢfᵢ`. -/
theorem ΓIso_hom_chartSection [IsAffine U.toScheme]
    (eU : D.restrictedModule U ≅ SheafOfModules.unit U.toScheme.ringCatSheaf) :
    (AffineSpace.ΓIso D.basisIndex U.toScheme).hom (D.chartSection eU) =
      ∑ i, MvPolynomial.C (D.chartEquation eU i) * MvPolynomial.X (ULift.up i) := by
  rw [chartSection, map_sum]
  refine Finset.sum_congr rfl fun i _ => ?_
  rw [map_mul, AffineSpace.ΓIso_hom_coord, AffineSpace.ΓIso_hom_appTop, mul_comm]

end Stacks.Bertini.FamilyDivisors

end
