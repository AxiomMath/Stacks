@[expose] public noncomputable section

universe u v w

namespace Algebra

open MvPolynomial

attribute [local instance] MvPolynomial.algebraMvPolynomial

variable {A : Type u} [CommRing A] {n : ℕ}

section AnyIndex

variable {σ : Type v} [Fintype σ]

/-- The universal linear form `∑ᵢ fᵢxᵢ ∈ A[xᵢ : i ∈ σ]` of a family `f` of elements of `A`
indexed by a finite set. For `σ = {1, …, r}` this is `x₁f₁ + ⋯ + x_rf_r`; in the Bertini
situation `σ` indexes the chosen basis of the linear system. -/
def universalLinearForm (f : σ → A) : MvPolynomial σ A :=
  ∑ i, C (f i) * X i

/-- The coefficient of the monomial `xⱼ` in the universal linear form of `f` is `fⱼ`. -/
theorem coeff_universalLinearForm (f : σ → A) (j : σ) :
    (universalLinearForm f).coeff (Finsupp.single j 1) = f j := by
  classical
  rw [universalLinearForm, coeff_sum]
  rw [Finset.sum_eq_single j]
  · simp
  · intro i _ hij
    have hne : ¬ ((Finsupp.single i 1 : σ →₀ ℕ) = Finsupp.single j 1) :=
      fun h => hij (Finsupp.single_left_injective one_ne_zero h)
    simp [coeff_C_mul, coeff_X, hne]
  · simp

/-- The universal linear form is compatible with extension of scalars. -/
theorem map_universalLinearForm {B : Type w} [CommRing B] (φ : A →+* B) (f : σ → A) :
    MvPolynomial.map φ (universalLinearForm f) = universalLinearForm fun i => φ (f i) := by
  simp [universalLinearForm]

end AnyIndex

/-- The extension of an ideal to a multivariate polynomial ring contracts back to itself. -/
private theorem comap_C_map_C {σ : Type v} (I : Ideal A) :
    Ideal.comap (C : A →+* MvPolynomial σ A) (Ideal.map C I) = I := by
  classical
  ext a
  rw [Ideal.mem_comap, mem_map_C_iff]
  refine ⟨fun h => by simpa using h 0, fun h m => ?_⟩
  rcases eq_or_ne m 0 with rfl | hm
  · simp [h]
  · simp [coeff_C, Ne.symm hm]

/-- Constants of a multivariate polynomial ring are faithful: the zero ideal contracts to the
zero ideal. -/
private theorem comap_C_bot {σ : Type v} : Ideal.comap (C : A →+* MvPolynomial σ A) ⊥ = ⊥ := by
  rw [← RingHom.ker_eq_comap_bot]
  exact (RingHom.injective_iff_ker_eq_bot _).mp (C_injective σ A)

/-- The extension of a prime ideal to a multivariate polynomial ring is prime. -/
@[ega "IV 5.5.3" "primality of p' = pA[T]"]
private theorem isPrime_map_C {σ : Type v} {p : Ideal A} (hp : p.IsPrime) :
    (Ideal.map (C : A →+* MvPolynomial σ A) p).IsPrime := by
  have := hp
  have : IsDomain (A ⧸ p) := Ideal.Quotient.isDomain p
  let e := MvPolynomial.quotientEquivQuotientMvPolynomial (σ := σ) p
  have : Nontrivial (MvPolynomial σ A ⧸ (Ideal.map C p : Ideal (MvPolynomial σ A))) :=
    e.toEquiv.symm.nontrivial
  have : IsDomain (MvPolynomial σ A ⧸ (Ideal.map C p : Ideal (MvPolynomial σ A))) :=
    Function.Injective.isDomain (e.symm : _ →+* MvPolynomial σ (A ⧸ p)) e.symm.injective
  exact Ideal.Quotient.isDomain_iff_prime _ |>.mp inferInstance

/-- **Eliminating the first variable.** Over a domain in which `f₁` is invertible, the universal
linear form generates a prime ideal: the quotient is the polynomial ring in `x₂, …, x_r`. -/
theorem isPrime_span_universalLinearForm {R : Type u} [CommRing R] [IsDomain R]
    (g : Fin (n + 1) → R) (hg : IsUnit (g 0)) :
    (Ideal.span {universalLinearForm g}).IsPrime := by
  classical
  set e := MvPolynomial.finSuccEquiv R n with he_def
  set a : MvPolynomial (Fin n) R := C (g 0) with ha_def
  set b : MvPolynomial (Fin n) R := ∑ i : Fin n, C (g i.succ) * X i with hb_def
  have ha : IsUnit a := hg.map C
  obtain ⟨c, hc⟩ := ha.exists_right_inv
  have hC : ∀ r : R, (MvPolynomial.finSuccEquiv R n) (C r) = Polynomial.C (C r) := by
    intro r
    simp [MvPolynomial.finSuccEquiv_apply, MvPolynomial.eval₂Hom_C]
  have he : e (universalLinearForm g) = Polynomial.C a * Polynomial.X + Polynomial.C b := by
    rw [universalLinearForm, Fin.sum_univ_succ, hb_def]
    simp [he_def, ha_def, hC, MvPolynomial.finSuccEquiv_X_zero,
      MvPolynomial.finSuccEquiv_X_succ, Polynomial.C_mul]
  have key : a * -(c * b) = -b := by rw [mul_neg, ← mul_assoc, hc, one_mul]
  have hfactor : Polynomial.C a * Polynomial.X + Polynomial.C b
      = Polynomial.C a * (Polynomial.X - Polynomial.C (-(c * b))) := by
    rw [mul_sub, ← Polynomial.C_mul, key, Polynomial.C_neg, sub_neg_eq_add]
  have hspan : Ideal.span {e (universalLinearForm g)}
      = Ideal.span {Polynomial.X - Polynomial.C (-(c * b))} := by
    rw [he, hfactor]
    exact Ideal.span_singleton_mul_left_unit (ha.map Polynomial.C) _
  have hprime : (Ideal.span {Polynomial.X - Polynomial.C (-(c * b))} :
      Ideal (Polynomial (MvPolynomial (Fin n) R))).IsPrime := by
    rw [← Polynomial.ker_evalRingHom]
    exact RingHom.ker_isPrime _
  have hcomap : Ideal.comap e.toRingEquiv
      (Ideal.span {Polynomial.X - Polynomial.C (-(c * b))})
      = Ideal.span {universalLinearForm g} := by
    rw [← hspan, ← Ideal.map_symm, Ideal.map_span]
    simp
  rw [← hcomap]
  exact hprime.comap _

section Generic

variable [IsDomain A]

/-- The prime ideal of `A[x₁, …, x_r]` contracted from the ideal that the universal linear form
generates over the fraction field of `A`. -/
def genericPrime (f : Fin (n + 1) → A) : Ideal (MvPolynomial (Fin (n + 1)) A) :=
  Ideal.comap (MvPolynomial.map (algebraMap A (FractionRing A)))
    (Ideal.span {universalLinearForm fun i => algebraMap A (FractionRing A) (f i)})

/-- The generic prime is prime as soon as `f₁ ≠ 0`. -/
theorem genericPrime_isPrime {f : Fin (n + 1) → A} (hf : f 0 ≠ 0) :
    (genericPrime f).IsPrime := by
  have hunit : IsUnit (algebraMap A (FractionRing A) (f 0)) :=
    (isUnit_iff_ne_zero (G₀ := FractionRing A)).mpr
      fun h => hf ((IsFractionRing.to_map_eq_zero_iff).mp h)
  exact (isPrime_span_universalLinearForm _ hunit).comap _

omit [IsDomain A] in
/-- The universal linear form lies in the generic prime. -/
theorem span_le_genericPrime (f : Fin (n + 1) → A) :
    Ideal.span {universalLinearForm f} ≤ genericPrime f := by
  refine Ideal.span_le.mpr (Set.singleton_subset_iff.mpr ?_)
  show universalLinearForm f ∈ genericPrime f
  rw [genericPrime, Ideal.mem_comap, map_universalLinearForm]
  exact Ideal.subset_span rfl

/-- The generic prime is contained in every prime containing the universal linear form that
contracts to zero in `A`: it is the saturation of the ideal the form generates. -/
theorem genericPrime_le {f : Fin (n + 1) → A} {q : Ideal (MvPolynomial (Fin (n + 1)) A)}
    (hqp : q.IsPrime) (hq : Ideal.span {universalLinearForm f} ≤ q)
    (hbot : Ideal.comap (C : A →+* MvPolynomial (Fin (n + 1)) A) q = ⊥) :
    genericPrime f ≤ q := by
  have := hqp
  have hmapspan : Ideal.map
      (algebraMap (MvPolynomial (Fin (n + 1)) A) (MvPolynomial (Fin (n + 1)) (FractionRing A)))
      (Ideal.span {universalLinearForm f})
      = Ideal.span {universalLinearForm fun i => algebraMap A (FractionRing A) (f i)} := by
    rw [Ideal.map_span, Set.image_singleton, MvPolynomial.algebraMap_def, map_universalLinearForm]
  have hinj : Function.Injective (algebraMap (MvPolynomial (Fin (n + 1)) A)
      (MvPolynomial (Fin (n + 1)) (FractionRing A))) := by
    rw [MvPolynomial.algebraMap_def]
    exact MvPolynomial.map_injective _ (IsFractionRing.injective A (FractionRing A))
  intro z hz
  rw [genericPrime, Ideal.mem_comap] at hz
  have hz' : z ∈ Ideal.comap
      (algebraMap (MvPolynomial (Fin (n + 1)) A) (MvPolynomial (Fin (n + 1)) (FractionRing A)))
      (Ideal.map
        (algebraMap (MvPolynomial (Fin (n + 1)) A) (MvPolynomial (Fin (n + 1)) (FractionRing A)))
        (Ideal.span {universalLinearForm f})) := by
    rw [Ideal.mem_comap, hmapspan, MvPolynomial.algebraMap_def]
    exact hz
  rw [Ideal.mem_comap] at hz'
  obtain ⟨⟨⟨y, hy⟩, ⟨m, hm⟩⟩, hzy⟩ :=
    (IsLocalization.mem_map_algebraMap_iff
      ((nonZeroDivisors A).map (C : A →+* MvPolynomial (Fin (n + 1)) A))
      (MvPolynomial (Fin (n + 1)) (FractionRing A))).mp hz'
  simp only at hzy
  have hmul : z * m = y := hinj (by simpa using hzy)
  obtain ⟨s, hs, hsm⟩ := hm
  have hsq : m ∉ q := by
    intro hmq
    have hsc : s ∈ Ideal.comap (C : A →+* MvPolynomial (Fin (n + 1)) A) q := by
      rw [Ideal.mem_comap, hsm]; exact hmq
    rw [hbot] at hsc
    exact (nonZeroDivisors.ne_zero hs) (by simpa using hsc)
  rcases hqp.mem_or_mem (show z * m ∈ q from hmul ▸ hq hy) with h | h
  · exact h
  · exact absurd h hsq

end Generic

section Minimal

variable [IsDomain A] [IsNoetherianRing A]

/-- **A minimal prime over the universal linear form contracts to zero.** If every irreducible
component of `V(f₁, …, f_r)` has codimension at least two in `Spec A`, then no nonzero element
of `A` lies in a minimal prime over the universal linear form. -/
theorem comap_C_eq_bot_of_mem_minimalPrimes {f : Fin (n + 1) → A}
    (hcodim : ∀ p ∈ (Ideal.span (Set.range f)).minimalPrimes, 2 ≤ p.height)
    {q : Ideal (MvPolynomial (Fin (n + 1)) A)}
    (hq : q ∈ (Ideal.span {universalLinearForm f}).minimalPrimes) :
    Ideal.comap (C : A →+* MvPolynomial (Fin (n + 1)) A) q = ⊥ := by
  classical
  have : q.IsPrime := hq.isPrime
  have : (Ideal.span {universalLinearForm f} : Ideal (MvPolynomial (Fin (n + 1)) A)).IsPrincipal :=
    ⟨⟨universalLinearForm f, rfl⟩⟩
  have hq1 : q.height ≤ ((1 : ℕ) : ℕ∞) := by
    simpa using Ideal.height_le_one_of_isPrincipal_of_mem_minimalPrimes _ q hq
  have hq1' := Ideal.height_le_iff.mp hq1
  -- the contraction `p` of `q`
  set p := Ideal.comap (C : A →+* MvPolynomial (Fin (n + 1)) A) q with hp_def
  have hpp : p.IsPrime := Ideal.comap_isPrime _ _
  by_contra hpne
  have hmaple : Ideal.map (C : A →+* MvPolynomial (Fin (n + 1)) A) p ≤ q :=
    Ideal.map_le_iff_le_comap.mpr le_rfl
  have hmapp : (Ideal.map (C : A →+* MvPolynomial (Fin (n + 1)) A) p).IsPrime := isPrime_map_C hpp
  have hmapne : Ideal.map (C : A →+* MvPolynomial (Fin (n + 1)) A) p ≠ ⊥ := by
    intro h
    refine hpne ?_
    calc p = Ideal.comap (C : A →+* MvPolynomial (Fin (n + 1)) A) (Ideal.map C p) :=
          (comap_C_map_C p).symm
      _ = ⊥ := by rw [h, comap_C_bot]
  -- by Krull's principal ideal theorem `q` has height one, so it equals `pA[x]`
  have hmapeq : Ideal.map (C : A →+* MvPolynomial (Fin (n + 1)) A) p = q := by
    rcases eq_or_lt_of_le hmaple with h | h
    · exact h
    · refine absurd (Ideal.height_eq_zero_iff_eq_bot.mp ?_) hmapne
      have hh := hq1' _ hmapp h
      rwa [Nat.cast_one, Order.lt_one_iff] at hh
  -- hence every `fᵢ` lies in `p`
  have hcoeff : ∀ i, f i ∈ p := by
    intro i
    have hmem : universalLinearForm f ∈ Ideal.map (C : A →+* MvPolynomial (Fin (n + 1)) A) p := by
      rw [hmapeq]; exact hq.1.2 (Ideal.subset_span rfl)
    have := (mem_map_C_iff).mp hmem (Finsupp.single i 1)
    rwa [coeff_universalLinearForm] at this
  have hspanle : Ideal.span (Set.range f) ≤ p := by
    rw [Ideal.span_le]; rintro _ ⟨i, rfl⟩; exact hcoeff i
  obtain ⟨p', hp'min, hp'le⟩ := Ideal.exists_minimalPrimes_le hspanle
  have : p'.IsPrime := hp'min.isPrime
  -- but `p` has height at most one, contradicting the codimension hypothesis
  have hnot : ¬ (p'.height ≤ ((1 : ℕ) : ℕ∞)) := by
    intro hle
    have : (2 : ℕ∞) ≤ ((1 : ℕ) : ℕ∞) := (hcodim p' hp'min).trans hle
    simp at this
  rw [Ideal.height_le_iff] at hnot
  push Not at hnot
  obtain ⟨p'', hp''prime, hp''lt, hp''h⟩ := hnot
  have := hp''prime
  have : (Ideal.map (C : A →+* MvPolynomial (Fin (n + 1)) A) p'').IsPrime := isPrime_map_C hp''prime
  have hp''p : p'' < p := lt_of_lt_of_le hp''lt hp'le
  have hlt2 : Ideal.map (C : A →+* MvPolynomial (Fin (n + 1)) A) p'' < q := by
    refine lt_of_le_of_ne (le_trans (Ideal.map_mono hp''p.le) hmaple) ?_
    intro hEq
    refine absurd ?_ (ne_of_lt hp''p)
    have := congrArg (Ideal.comap (C : A →+* MvPolynomial (Fin (n + 1)) A)) hEq
    rwa [comap_C_map_C, ← hp_def] at this
  have hzero : Ideal.map (C : A →+* MvPolynomial (Fin (n + 1)) A) p'' = ⊥ := by
    refine Ideal.height_eq_zero_iff_eq_bot.mp ?_
    have hh := hq1' _ inferInstance hlt2
    rwa [Nat.cast_one, Order.lt_one_iff] at hh
  have : p'' = ⊥ := by
    have := congrArg (Ideal.comap (C : A →+* MvPolynomial (Fin (n + 1)) A)) hzero
    rwa [comap_C_map_C, comap_C_bot] at this
  rw [this] at hp''h
  simp at hp''h

variable (f : Fin (n + 1) → A)

/-- **The radical of the universal linear form.** Under the codimension hypothesis the ideal
generated by the universal linear form has a unique minimal prime, namely the generic prime. -/
theorem radical_span_universalLinearForm (hf : f 0 ≠ 0)
    (hcodim : ∀ p ∈ (Ideal.span (Set.range f)).minimalPrimes, 2 ≤ p.height) :
    (Ideal.span {universalLinearForm f}).radical = genericPrime f := by
  have hgp : (genericPrime f).IsPrime := genericPrime_isPrime hf
  refine le_antisymm ?_ ?_
  · rw [Ideal.radical_eq_sInf]
    exact sInf_le ⟨span_le_genericPrime f, hgp⟩
  · rw [Ideal.radical_eq_sInf]
    refine le_sInf ?_
    rintro J ⟨hJle, hJp⟩
    have := hJp
    obtain ⟨q, hqmin, hqle⟩ := Ideal.exists_minimalPrimes_le hJle
    have : q.IsPrime := hqmin.isPrime
    refine le_trans ?_ hqle
    exact genericPrime_le ‹q.IsPrime› hqmin.1.2
      (comap_C_eq_bot_of_mem_minimalPrimes hcodim hqmin)

/-- **The universal divisor over an affine chart is irreducible.** Let `A` be a Noetherian domain
and `f₁, …, f_r ∈ A` with `f₁ ≠ 0`. If every irreducible component of `V(f₁, …, f_r)` has
codimension at least two in `Spec A`, then the zero locus of `x₁f₁ + ⋯ + x_rf_r` in
`Spec A[x₁, …, x_r]` is irreducible.

This is the irreducibility of `H_U` in the proof of [Stacks, Tag 0G4F]; see the module docstring
for what the source deduces from it and what is not formalized here. -/
@[stacks 0G4F "irreducibility of the universal divisor over an affine chart"]
theorem isIrreducible_zeroLocus_universalLinearForm (hf : f 0 ≠ 0)
    (hcodim : ∀ p ∈ (Ideal.span (Set.range f)).minimalPrimes, 2 ≤ p.height) :
    IsIrreducible (PrimeSpectrum.zeroLocus {universalLinearForm f} :
      Set (PrimeSpectrum (MvPolynomial (Fin (n + 1)) A))) := by
  rw [← PrimeSpectrum.zeroLocus_span, PrimeSpectrum.isIrreducible_zeroLocus_iff,
    radical_span_universalLinearForm f hf hcodim]
  exact genericPrime_isPrime hf

end Minimal

/-! ### An arbitrary set of parameters

The parameters of the Bertini situation are indexed by the basis of the linear system, lifted to
the universe of the scheme, rather than by `Fin (r)`; so the chart statement is reindexed along an
arbitrary bijection. -/

section Reindex

/-- A zero locus is irreducible if its preimage under a surjective map of spectra is. -/
private theorem isIrreducible_zeroLocus_of_surjective_comap {R S : Type*} [CommRing R]
    [CommRing S] (φ : R →+* S) (hφ : Function.Surjective (PrimeSpectrum.comap φ))
    (s : Set R) (t : Set S) (hpre : PrimeSpectrum.comap φ ⁻¹' PrimeSpectrum.zeroLocus s =
      PrimeSpectrum.zeroLocus t)
    (h : IsIrreducible (PrimeSpectrum.zeroLocus t)) :
    IsIrreducible (PrimeSpectrum.zeroLocus s : Set (PrimeSpectrum R)) := by
  have himg : PrimeSpectrum.zeroLocus s =
      PrimeSpectrum.comap φ '' PrimeSpectrum.zeroLocus t := by
    rw [← hpre, Set.image_preimage_eq _ hφ]
  rw [himg]
  exact h.image _ (PrimeSpectrum.continuous_comap _).continuousOn

/-- Transporting a zero locus along an isomorphism of rings preserves irreducibility. -/
theorem _root_.PrimeSpectrum.isIrreducible_zeroLocus_image {R S : Type*} [CommRing R] [CommRing S]
    (e : R ≃+* S) (s : Set R)
    (h : IsIrreducible (PrimeSpectrum.zeroLocus s)) :
    IsIrreducible (PrimeSpectrum.zeroLocus (e '' s) : Set (PrimeSpectrum S)) := by
  refine isIrreducible_zeroLocus_of_surjective_comap (e.symm : S →+* R)
    (PrimeSpectrum.comapEquiv e).surjective _ _ ?_ h
  rw [PrimeSpectrum.preimage_comap_zeroLocus, ← Set.image_comp]
  congr 1
  ext x
  simp

/-- **The universal divisor over an affine chart is irreducible, for parameters indexed by an
arbitrary finite set.** Let `A` be a Noetherian domain, let `σ` be a finite index set and let
`f : σ → A` be a family with `f i₀ ≠ 0` for some index `i₀`. If every irreducible component of
the common zero locus `V(f)` has codimension at least two in `Spec A`, then the zero locus of
`∑ᵢ fᵢxᵢ` in `Spec A[xᵢ : i ∈ σ]` is irreducible.

This is `Algebra.isIrreducible_zeroLocus_universalLinearForm` reindexed: the proof renames the
variables along a bijection `σ ≃ Fin (n + 1)` carrying `i₀` to `0`. -/
theorem isIrreducible_zeroLocus_linearForm [IsDomain A] [IsNoetherianRing A] {σ : Type v}
    [Fintype σ] (f : σ → A) {i₀ : σ} (hf : f i₀ ≠ 0)
    (hcodim : ∀ p ∈ (Ideal.span (Set.range f)).minimalPrimes, 2 ≤ p.height) :
    IsIrreducible (PrimeSpectrum.zeroLocus {∑ i, C (f i) * X i} :
      Set (PrimeSpectrum (MvPolynomial σ A))) := by
  classical
  obtain ⟨m, hm⟩ : ∃ m, Fintype.card σ = m + 1 :=
    ⟨Fintype.card σ - 1, (Nat.succ_pred_eq_of_pos (Fintype.card_pos_iff.mpr ⟨i₀⟩)).symm⟩
  set e₁ : σ ≃ Fin (m + 1) := (Fintype.equivFin σ).trans (finCongr hm) with he₁
  set e : σ ≃ Fin (m + 1) := e₁.trans (Equiv.swap (e₁ i₀) 0) with he
  have hei : e i₀ = 0 := by simp [he]
  have hsymm : e.symm 0 = i₀ := by rw [← hei, Equiv.symm_apply_apply]
  set g : Fin (m + 1) → A := fun j => f (e.symm j) with hg
  have hg0 : g 0 ≠ 0 := by rw [hg]; simpa [hsymm] using hf
  have hrange : Set.range g = Set.range f := e.symm.surjective.range_comp f
  have hmain := isIrreducible_zeroLocus_universalLinearForm g hg0 (by rw [hrange]; exact hcodim)
  have hφ : (MvPolynomial.renameEquiv A e) (∑ i, C (f i) * X i) = universalLinearForm g := by
    rw [map_sum, universalLinearForm]
    refine Fintype.sum_equiv e _ _ fun i => ?_
    rw [map_mul, MvPolynomial.renameEquiv_apply, MvPolynomial.renameEquiv_apply, rename_C,
      rename_X, hg]
    simp only [Equiv.symm_apply_apply]
  have hset : ({∑ i, C (f i) * X i} : Set (MvPolynomial σ A)) =
      (MvPolynomial.renameEquiv A e).symm.toRingEquiv '' {universalLinearForm g} := by
    rw [Set.image_singleton, ← hφ]
    simp
  rw [hset]
  exact PrimeSpectrum.isIrreducible_zeroLocus_image _ _ hmain

end Reindex

/-! ### Dropping the reducedness hypothesis

The zero locus of the linear form is a topological object, so it does not see the nilpotents of
`A`: the statement above may therefore be run in the reduced quotient `A / √0`, which is a domain
exactly when `Spec A` is irreducible. This is the ring-level form of the reduction step with
which the source of [Stacks, Tag 0G4F] begins. -/

section Reduction

variable [IsNoetherianRing A]

/-- **The universal divisor over an affine chart is irreducible, without a reducedness
hypothesis.** Let `A` be a Noetherian ring whose nilradical is prime — equivalently, with `Spec A`
irreducible — let `σ` be a finite index set and let `f : σ → A` be a family with `f i₀` not
nilpotent for some index `i₀`. If every irreducible component of the common zero locus `V(f)` has
codimension at least two in `Spec A`, then the zero locus of `∑ᵢ fᵢxᵢ` in `Spec A[xᵢ : i ∈ σ]` is
irreducible.

This is the reduction step at the beginning of the proof of [Stacks, Tag 0G4F], carried out on a
chart: the source replaces `X` by its reduction, which changes neither the topology of `X` nor
that of the universal divisor. Here `A` is replaced by `A / √0`, which is a Noetherian domain,
and `Algebra.isIrreducible_zeroLocus_linearForm` is applied there; the comparison map
`Spec (A/√0)[xᵢ] → Spec A[xᵢ]` is surjective because its kernel consists of nilpotents, so the
two zero loci are homeomorphic, and heights and minimal primes are unchanged by
`Ideal.le_height_of_mem_minimalPrimes_map_quotientMk`. -/
@[stacks 0G4F "the reduction step and the irreducibility of the universal divisor over a chart"]
theorem isIrreducible_zeroLocus_linearForm_of_isPrime_nilradical
    (hnil : (nilradical A).IsPrime) {σ : Type v} [Fintype σ] (f : σ → A) {i₀ : σ}
    (hf : ¬ IsNilpotent (f i₀))
    (hcodim : ∀ p ∈ (Ideal.span (Set.range f)).minimalPrimes, 2 ≤ p.height) :
    IsIrreducible (PrimeSpectrum.zeroLocus {∑ i, C (f i) * X i} :
      Set (PrimeSpectrum (MvPolynomial σ A))) := by
  classical
  have hprime := hnil
  have : IsDomain (A ⧸ nilradical A) := Ideal.Quotient.isDomain _
  set π : A →+* A ⧸ nilradical A := Ideal.Quotient.mk (nilradical A) with hπ
  set g : σ → A ⧸ nilradical A := fun i => π (f i) with hg
  have hg0 : g i₀ ≠ 0 := by
    rw [hg, hπ, Ne, Ideal.Quotient.eq_zero_iff_mem, mem_nilradical]
    exact hf
  have hspan : Ideal.span (Set.range g) = (Ideal.span (Set.range f)).map π := by
    rw [Ideal.map_span, hg, ← Set.range_comp]
    rfl
  have hcodim' : ∀ p ∈ (Ideal.span (Set.range g)).minimalPrimes, 2 ≤ p.height := by
    intro p hp
    rw [hspan] at hp
    exact Ideal.le_height_of_mem_minimalPrimes_map_quotientMk le_rfl hcodim hp
  have hbase := isIrreducible_zeroLocus_linearForm g hg0 hcodim'
  -- the comparison of the two polynomial rings
  set φ : MvPolynomial σ A →+* MvPolynomial σ (A ⧸ nilradical A) := MvPolynomial.map π with hφ
  have hφsurj : Function.Surjective φ :=
    MvPolynomial.map_surjective π Ideal.Quotient.mk_surjective
  have hker : (RingHom.ker φ : Set (MvPolynomial σ A)) ⊆ nilradical (MvPolynomial σ A) := by
    intro p hp
    have hcoeff : ∀ m, p.coeff m ∈ nilradical A := by
      intro m
      have hzero : (MvPolynomial.map π p).coeff m = 0 := by
        rw [show MvPolynomial.map π p = φ p from rfl, RingHom.mem_ker.mp hp]
        simp
      rw [MvPolynomial.coeff_map, hπ, Ideal.Quotient.eq_zero_iff_mem] at hzero
      exact hzero
    refine Ideal.map_le_iff_le_comap.mpr (fun a ha => ?_) (mem_map_C_iff.mpr hcoeff)
    exact (mem_nilradical.mp ha).map (C : A →+* MvPolynomial σ A)
  have hsurj : Function.Surjective (PrimeSpectrum.comap φ) := by
    rw [← Set.range_eq_univ, _root_.range_comap_of_surjective _ φ hφsurj]
    exact PrimeSpectrum.zeroLocus_eq_univ_iff _ |>.mpr hker
  refine isIrreducible_zeroLocus_of_surjective_comap φ hsurj _ _ ?_ hbase
  rw [PrimeSpectrum.preimage_comap_zeroLocus, Set.image_singleton]
  congr 1
  rw [hφ]
  simp [hg]

end Reduction

end Algebra

end
