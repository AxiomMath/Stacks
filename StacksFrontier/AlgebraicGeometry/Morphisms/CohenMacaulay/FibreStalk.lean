/-!
# The local ring of a scheme-theoretic fibre

For a morphism of schemes `f : X ⟶ Y` and a point `x` of `X`, the local ring of the fibre of
`f` over `f x` at the point corresponding to `x` is the quotient of the local ring of `X` at
`x` by the ideal generated by the maximal ideal of the local ring of `Y` at `f x`. Moreover,
every fibre of a morphism with locally Noetherian source is locally Noetherian.

## Main definitions

* `AlgebraicGeometry.FlatMorphismWithCohenMacaulaySource` packages a flat morphism of locally
  Noetherian schemes whose source is Cohen–Macaulay.
* `AlgebraicGeometry.quotientStalkEquivFiberStalk` is the canonical equivalence from the
  quotient of the source stalk to the fibre stalk.
* `AlgebraicGeometry.specMapFiberIsoSpecFiberRing` is the fibre of a morphism of spectra, as the
  spectrum of Mathlib's fibre ring `Ideal.Fiber 𝔭 S = κ(𝔭) ⊗_R S`.
* `AlgebraicGeometry.fiberIsoSpecMapFiberAppTop` is the fibre of a morphism of *affine schemes*,
  as the fibre of the induced map of spectra.
* `AlgebraicGeometry.fiberIsoSpecFiberRing` is their composite: the fibre of a morphism of affine
  schemes is `Spec (κ(𝔭) ⊗_{Γ(Y, ⊤)} Γ(X, ⊤))`.

## Main results

* `AlgebraicGeometry.isLocallyNoetherian_fiber` gives locally Noetherian fibres.
* `AlgebraicGeometry.isCohenMacaulayLocalRing_stalk` gives Cohen–Macaulay source stalks.
* `AlgebraicGeometry.quotientStalk_bridge` is the equivalence at the point of the fibre
  presented as `f.fiberι _ (f.asFiber x)`, together with its compatibility with the stalk map.
* `AlgebraicGeometry.quotientStalkEquivFiberStalk_mk` identifies the equivalence with the
  canonical stalk map on representatives.

## Implementation notes

The Noetherianity and local-ring structures on both stalks, the local-homomorphism property of
the stalk map, and its flatness are already supplied by Mathlib. Each result is stated under
only the hypotheses it needs; the hypotheses of the standing flat-morphism situation imply these
specializations. The quotient equivalence is required to commute with the canonical stalk map,
so it identifies the displayed rings canonically rather than merely abstractly. Local
Noetherianness and flatness are stored as typeclass fields of
`FlatMorphismWithCohenMacaulaySource`, following Mathlib; Cohen–Macaulayness of the source is
the scheme predicate `AlgebraicGeometry.IsCohenMacaulay`.

The three fibre isomorphisms are declarations rather than chains of local `let`s inside the
Noetherianity proofs, so the transport chain they share exists once.

## References

* [Stacks Project, Tag 0C0X](https://stacks.math.columbia.edu/tag/0C0X)
-/

@[expose] public section

open CategoryTheory Limits

universe u

namespace AlgebraicGeometry

/-- A flat morphism of locally Noetherian schemes with Cohen–Macaulay source. -/
public structure FlatMorphismWithCohenMacaulaySource where
  /-- The source scheme. -/
  X : Scheme.{u}
  /-- The target scheme. -/
  Y : Scheme.{u}
  /-- The morphism from source to target. -/
  f : X ⟶ Y
  /-- The source is locally Noetherian. -/
  [sourceLocallyNoetherian : IsLocallyNoetherian X]
  /-- The target is locally Noetherian. -/
  [targetLocallyNoetherian : IsLocallyNoetherian Y]
  /-- The morphism is flat. -/
  [flat : Flat f]
  /-- The source is Cohen–Macaulay. -/
  sourceCohenMacaulay : IsCohenMacaulay X

attribute [instance]
  FlatMorphismWithCohenMacaulaySource.sourceLocallyNoetherian
  FlatMorphismWithCohenMacaulaySource.targetLocallyNoetherian
  FlatMorphismWithCohenMacaulaySource.flat

/-- A localization of a local ring at a submonoid of units is the ring itself, as an
algebra. -/
private noncomputable def localizationEquivOfSurjective
    {R S : Type u} [CommRing R] [CommRing S] [Algebra R S]
    [IsLocalRing R] [IsLocalRing S] (M : Submonoid R) [IsLocalization M S]
    (h : Function.Surjective (algebraMap R S)) : R ≃ₐ[R] S := by
  have : IsLocalHom (algebraMap R S) := IsLocalHom.of_surjective _ h
  have hM : M ≤ IsUnit.submonoid R := fun s hs =>
    (isUnit_map_iff (algebraMap R S) s).mp (IsLocalization.map_units S ⟨s, hs⟩)
  letI : IsLocalization M R := IsLocalization.self hM
  exact IsLocalization.algEquiv M R S

/-- **The local ring of a fibre, presented at the canonical fibre point.** The quotient of the
local ring of `X` at `f.fiberι _ (f.asFiber x)` by the extension of the maximal ideal of the
local ring of `Y` is the local ring of the fibre, compatibly with the canonical stalk map. -/
public theorem quotientStalk_bridge {X Y : Scheme.{u}}
    (f : X ⟶ Y) (x : X) :
    ∃ e :
      ((X.presheaf.stalk (f.fiberι (f x) (f.asFiber x))) ⧸
        Ideal.map (f.stalkMap (f.fiberι (f x) (f.asFiber x))).hom
          (IsLocalRing.maximalIdeal
            (Y.presheaf.stalk (f (f.fiberι (f x) (f.asFiber x)))))) ≃+*
        ((f.fiber (f x)).presheaf.stalk (f.asFiber x)),
      ∀ b : X.presheaf.stalk (f.fiberι (f x) (f.asFiber x)),
        e (Ideal.Quotient.mk
          (Ideal.map (f.stalkMap (f.fiberι (f x) (f.asFiber x))).hom
            (IsLocalRing.maximalIdeal
              (Y.presheaf.stalk (f (f.fiberι (f x) (f.asFiber x)))))) b) =
          ((f.fiberι (f x)).stalkMap (f.asFiber x)).hom b := by
  classical
  let g := Y.fromSpecResidueField (f x)
  let z : (pullback f g).carrier := f.asFiber x
  let pX : pullback f g ⟶ X := pullback.fst f g
  let pY : pullback f g ⟶ Spec (Y.residueField (f x)) := pullback.snd f g
  let h : (pX ≫ f).base z = (pY ≫ g).base z :=
    congrArg (fun k : pullback f g ⟶ Y => k.base z) pullback.condition
  let R := Y.presheaf.stalk ((pX ≫ f).base z)
  let A := X.presheaf.stalk (pX.base z)
  let B := (Spec (Y.residueField (f x))).presheaf.stalk (pY.base z)
  let C := (pullback f g).presheaf.stalk z
  let eEq : R ≃+* Y.presheaf.stalk (g (pY.base z)) :=
    (eqToIso (congrArg Y.presheaf.stalk h)).commRingCatIsoToRingEquiv
  let _ : Algebra R A := (f.stalkMap (pX.base z)).hom.toAlgebra
  let ρ : R →+* B :=
    (((eqToHom (congrArg Y.presheaf.stalk h)) ≫ g.stalkMap (pY.base z)).hom)
  let _ : Algebra R B := ρ.toAlgebra
  have hρ : Function.Surjective ρ := by
    intro b
    obtain ⟨c, hc⟩ := g.stalkMap_surjective (pY.base z) b
    refine ⟨eEq.symm c, ?_⟩
    change (g.stalkMap (pY.base z)).hom (eEq (eEq.symm c)) = b
    rw [eEq.apply_symm_apply, hc]
  let hb : pY.base z = IsLocalRing.closedPoint (Y.residueField (f x)) :=
    Subsingleton.elim _ _
  let eB : B ≃+* Y.residueField (f x) :=
    (((Spec (Y.residueField (f x))).presheaf.stalkCongr (.of_eq hb)) ≪≫
      stalkClosedPointIso (Y.residueField (f x))).commRingCatIsoToRingEquiv
  let _ : Field B := (eB.isField (Field.toIsField _)).toField
  let ρAlg : R →ₐ[R] B := Algebra.ofId R B
  let eR : (R ⧸ IsLocalRing.maximalIdeal R) ≃ₐ[R] B :=
    (Ideal.quotientEquivAlgOfEq R (IsLocalRing.ker_eq_maximalIdeal ρ hρ).symm).trans
      (Ideal.quotientKerAlgEquivOfSurjective (f := ρAlg) hρ)
  have : IsLocalHom (algebraMap R A) := f.toLRSHom.prop (pX.base z)
  let I : Ideal A := Ideal.map (algebraMap R A) (IsLocalRing.maximalIdeal R)
  have hIlt : I < ⊤ := (IsLocalRing.map_maximalIdeal_le (algebraMap R A)).trans_lt
    (IsLocalRing.maximalIdeal.isMaximal A).lt_top
  let Q := A ⧸ I
  let e₁ := Algebra.TensorProduct.quotIdealMapEquivTensorQuot (A := R) A
      (IsLocalRing.maximalIdeal R)
  let e₂ := Algebra.TensorProduct.congr (AlgEquiv.refl (R := A) (A₁ := A)) eR
  let eQT := e₁.trans e₂
  let _ : Nontrivial Q := Ideal.Quotient.nontrivial_iff.mpr hIlt.ne
  let _ : IsLocalRing Q :=
    IsLocalRing.of_surjective' (Ideal.Quotient.mk I) Ideal.Quotient.mk_surjective
  let _ := eQT.toRingEquiv.isLocalRing
  obtain ⟨φ, hleft, _, hLoc⟩ := BaseChangeStalk.pullback_stalk_isLocalization f g z
  let T := TensorProduct R A B
  let _ : Algebra T C := φ.toAlgebra
  obtain ⟨M, hM⟩ := hLoc
  let _ : IsLocalization M C := hM
  have hφsurj : Function.Surjective φ := by
    intro c
    obtain ⟨a, ha⟩ := pX.stalkMap_surjective z c
    exact ⟨Algebra.TensorProduct.includeLeft (R := R) (S := A) (A := A) (B := B) a,
      (DFunLike.congr_fun hleft a).trans ha⟩
  let eLoc : T ≃ₐ[T] C := localizationEquivOfSurjective M hφsurj
  refine ⟨eQT.toRingEquiv.trans eLoc.toRingEquiv, fun b => ?_⟩
  change A at b
  have hmk : eQT (Ideal.Quotient.mk I b) =
      Algebra.TensorProduct.includeLeft (R := R) (S := A) (A := A) (B := B) b := by
    simp [eQT, e₁, e₂, I, Algebra.TensorProduct.quotIdealMapEquivTensorQuot_mk,
      Algebra.TensorProduct.congr_apply, Algebra.TensorProduct.map_tmul]
  have heLoc (t : T) : eLoc t = φ t := by
    calc
      eLoc t = algebraMap T C t := by
        simpa [eLoc, localizationEquivOfSurjective] using eLoc.commutes t
      _ = φ t := rfl
  change eLoc (eQT (Ideal.Quotient.mk I b)) = _
  rw [hmk, heLoc]
  exact DFunLike.congr_fun hleft b

/-- **The fibre of a morphism of spectra is the spectrum of the fibre ring**, Mathlib's
`AlgebraicGeometry.Spec.fiberToSpecResidueFieldIso` read as an isomorphism of the fibres rather
than of the arrows down to `Spec κ(𝔭)`. -/
public noncomputable def specMapFiberIsoSpecFiberRing {R S : Type u} [CommRing R] [CommRing S]
    [Algebra R S] (p : PrimeSpectrum R) :
    (Spec.map (CommRingCat.ofHom (algebraMap R S))).fiber p ≅
      Spec (CommRingCat.of (p.asIdeal.Fiber S)) :=
  asIso (Spec.fiberToSpecResidueFieldIso R S p).hom.left

/-- **The fibre of a morphism of affine schemes is the fibre of the induced map of spectra.**
Both `f` and the inclusion of the residue field are transported along `Y.isoSpec`, which is a
monomorphism, so the two pullback squares have isomorphic vertices
(`pullbackMap_of_comp_mono_isIso`), and the source is then transported along `X.isoSpec`. -/
public noncomputable def fiberIsoSpecMapFiberAppTop {X Y : Scheme.{u}} (f : X ⟶ Y)
    [IsAffine X] [IsAffine Y] (y : Y) :
    f.fiber y ≅ (Spec.map f.appTop).fiber (Y.isoSpec.hom y) := by
  let p : Spec Γ(Y, ⊤) := Y.isoSpec.hom y
  let q : Spec (Y.residueField y) ⟶ Spec ((Spec Γ(Y, ⊤)).residueField p) :=
    Spec.map (f := Y.isoSpec.hom.residueFieldMap y)
  have hq : IsIso q := by
    dsimp [q]
    infer_instance
  have hright : Y.fromSpecResidueField y ≫ Y.isoSpec.hom =
      q ≫ (Spec Γ(Y, ⊤)).fromSpecResidueField p := by
    dsimp [q, p]
    exact (Scheme.Hom.SpecMap_residueFieldMap_fromSpecResidueField
      (f := Y.isoSpec.hom) y).symm
  let m₀ : pullback f (Y.fromSpecResidueField y) ⟶
      pullback (f ≫ Y.isoSpec.hom) (Y.fromSpecResidueField y ≫ Y.isoSpec.hom) :=
    pullback.map f (Y.fromSpecResidueField y) (f ≫ Y.isoSpec.hom)
      (Y.fromSpecResidueField y ≫ Y.isoSpec.hom) (𝟙 X)
      (𝟙 (Spec (Y.residueField y))) Y.isoSpec.hom (by simp) (by simp)
  have hm₀ : IsIso m₀ := pullbackMap_of_comp_mono_isIso f
    (Y.fromSpecResidueField y) Y.isoSpec.hom
  let m₁ : pullback (f ≫ Y.isoSpec.hom)
      (Y.fromSpecResidueField y ≫ Y.isoSpec.hom) ⟶
      pullback (Spec.map f.appTop) ((Spec Γ(Y, ⊤)).fromSpecResidueField p) :=
    pullback.map (f ≫ Y.isoSpec.hom)
      (Y.fromSpecResidueField y ≫ Y.isoSpec.hom) (Spec.map f.appTop)
      ((Spec Γ(Y, ⊤)).fromSpecResidueField p) X.isoSpec.hom q (𝟙 (Spec Γ(Y, ⊤)))
      ((Category.comp_id _).trans (Scheme.isoSpec_hom_naturality f).symm)
      ((Category.comp_id _).trans hright)
  have hm₁ : IsIso m₁ := by
    dsimp [m₁]
    infer_instance
  exact @asIso _ _ _ _ m₀ hm₀ ≪≫ @asIso _ _ _ _ m₁ hm₁

/-- **The fibre of a morphism of affine schemes is the spectrum of the fibre ring
`κ(𝔭) ⊗_{Γ(Y, ⊤)} Γ(X, ⊤)`.** The composite of the two results above, with `Spec.map f.appTop`
recognised as the spectrum of `algebraMap Γ(Y, ⊤) Γ(X, ⊤)` — the same morphism, by `rfl`, once
`f.appTop` is made the algebra map. The prime is an explicit argument with its own equation
rather than written `Y.isoSpec.hom y` in place, because at that spelling the point is not
syntactically a `PrimeSpectrum` and `p.asIdeal.IsPrime` fails to synthesize.

This is the affine chart description of a scheme-theoretic fibre. It was already present in this
file as a chain of local `let`s inside the Noetherianity proofs below, where no search for it
could find it; the proofs now call it. -/
public noncomputable def fiberIsoSpecFiberRing {X Y : Scheme.{u}} (f : X ⟶ Y)
    [IsAffine X] [IsAffine Y] (y : Y) (p : PrimeSpectrum ↑Γ(Y, ⊤))
    (hp : Y.isoSpec.hom y = p) :
    letI : Algebra ↑Γ(Y, ⊤) ↑Γ(X, ⊤) := f.appTop.hom.toAlgebra
    f.fiber y ≅ Spec (CommRingCat.of (p.asIdeal.Fiber ↑Γ(X, ⊤))) :=
  letI : Algebra ↑Γ(Y, ⊤) ↑Γ(X, ⊤) := f.appTop.hom.toAlgebra
  hp ▸ (fiberIsoSpecMapFiberAppTop f y).trans
    (specMapFiberIsoSpecFiberRing (S := ↑Γ(X, ⊤)) (Y.isoSpec.hom y))

/-- Every fibre of a morphism from the spectrum of a Noetherian ring is locally Noetherian. -/
private theorem isLocallyNoetherian_affine_fiber {R S : Type u}
    [CommRing R] [CommRing S] (φ : R →+* S) [IsNoetherianRing S]
    (p : PrimeSpectrum R) :
    IsLocallyNoetherian ((Spec.map (CommRingCat.ofHom φ)).fiber p) := by
  let _ : Algebra R S := φ.toAlgebra
  let f : Spec (.of S) ⟶ Spec (.of R) := Spec.map (CommRingCat.ofHom φ)
  have : IsNoetherianRing (p.asIdeal.Fiber S) := by
    let _ : Algebra S (p.asIdeal.Fiber S) := Algebra.TensorProduct.rightAlgebra
    let e := Ideal.Fiber.algEquivQuotient (R := R) (S := S) p.asIdeal
    exact isNoetherianRing_of_ringEquiv _ e.symm.toRingEquiv
  let W := p.asIdeal.Fiber S
  let i : (f.fiber p) ≅ Spec (.of W) := specMapFiberIsoSpecFiberRing (R := R) (S := S) p
  have : IsAffine (f.fiber p) := IsAffine.of_isIso i.hom
  have hΓ : IsNoetherianRing Γ(f.fiber p, ⊤) := isNoetherianRing_of_ringEquiv W
    ((Scheme.Γ.mapIso i.op).symm.trans (Scheme.ΓSpecIso (.of W))).commRingCatIsoToRingEquiv.symm
  apply isLocallyNoetherian_of_affine_cover (S := fun _ : Unit =>
    ⟨⊤, isAffineOpen_top (f.fiber p)⟩)
  · simp
  · exact fun _ => hΓ

/-- Every fibre of a morphism of affine schemes with locally Noetherian source is locally
Noetherian. -/
private lemma isLocallyNoetherian_affineSource_affineTarget_fiber {X Y : Scheme.{u}}
    (f : X ⟶ Y) [IsAffine X] [IsAffine Y] [IsLocallyNoetherian X] (y : Y) :
    IsLocallyNoetherian (f.fiber y) := by
  let p : Spec Γ(Y, ⊤) := Y.isoSpec.hom y
  let e : f.fiber y ≅ (Spec.map f.appTop).fiber p := fiberIsoSpecMapFiberAppTop f y
  have : IsNoetherianRing Γ(X, ⊤) :=
    IsLocallyNoetherian.component_noetherian ⟨⊤, isAffineOpen_top X⟩
  have : IsLocallyNoetherian ((Spec.map f.appTop).fiber p) :=
    isLocallyNoetherian_affine_fiber f.appTop.hom p
  exact isLocallyNoetherian_of_isOpenImmersion e.hom

/-- Every fibre of a morphism to an affine scheme with locally Noetherian source is locally
Noetherian. -/
private lemma isLocallyNoetherian_affineTarget_fiber {X Y : Scheme.{u}}
    (f : X ⟶ Y) [IsLocallyNoetherian X] [IsAffine Y] (y : Y) :
    IsLocallyNoetherian (f.fiber y) := by
  let 𝒰 := X.affineCover
  let 𝒱 := Scheme.Pullback.openCoverOfLeft 𝒰 f (Y.fromSpecResidueField y)
  apply (isLocallyNoetherian_iff_openCover 𝒱).2
  intro i
  have : IsAffine (𝒰.X i) := Scheme.isAffine_affineCover X i
  have : IsOpenImmersion (𝒰.f i) := 𝒰.map_prop i
  have : IsLocallyNoetherian (𝒰.X i) :=
    isLocallyNoetherian_of_isOpenImmersion (𝒰.f i)
  exact isLocallyNoetherian_affineSource_affineTarget_fiber (𝒰.f i ≫ f) y

/-- Every scheme-theoretic fibre of a morphism with locally Noetherian source is locally
Noetherian. -/
public theorem isLocallyNoetherian_fiber {X Y : Scheme.{u}}
    (f : X ⟶ Y) [IsLocallyNoetherian X] (y : Y) :
    IsLocallyNoetherian (f.fiber y) := by
  let U := (Y.affineCover.f (Y.affineCover.idx y)).opensRange
  have hU : IsAffineOpen U := isAffineOpen_opensRange _
  have hy : y ∈ U := Y.affineCover.covers y
  let XU := (f ⁻¹ᵁ U).toScheme
  let fU : XU ⟶ U.toScheme := f ∣_ U
  let yU : U.toScheme := ⟨y, hy⟩
  have : IsAffine U.toScheme := hU
  have hUfiber : IsLocallyNoetherian (fU.fiber yU) :=
    isLocallyNoetherian_affineTarget_fiber fU yU
  let hPull := (isPullback_morphismRestrict f U).flip
  let hFib := isPullback_fiberToSpecResidueField_of_isPullback hPull yU
  let m := pullback.map fU (U.toScheme.fromSpecResidueField yU) f
    (Y.fromSpecResidueField (U.ι yU)) (f ⁻¹ᵁ U).ι
    (Spec.map ((U.ι).residueFieldMap yU)) U.ι hPull.w.symm (by simp)
  have hm : IsIso m := hFib.isIso_fst_of_isIso
  let e : fU.fiber yU ≅ f.fiber y := @asIso _ _ _ _ m hm
  exact isLocallyNoetherian_of_isOpenImmersion e.inv

/-- Every local ring of a Cohen–Macaulay scheme is Cohen–Macaulay. -/
@[ega "IV 5.7.1" "forward implication"]
public theorem isCohenMacaulayLocalRing_stalk (X : Scheme.{u})
    [IsLocallyNoetherian X] (hX : IsCohenMacaulay X) (x : X) :
    IsCohenMacaulayLocalRing (X.presheaf.stalk x) := by
  obtain ⟨_, hx⟩ :=
    (((isCohenMacaulay_tfae_stalk X).out 1 2 rfl rfl).mp hX).2 x
  exact hx

/-- The local ring of the fibre at `x` is canonically the quotient of the source local ring by
the extended maximal ideal of the target local ring. -/
public noncomputable def quotientStalkEquivFiberStalk {X Y : Scheme.{u}}
    (f : X ⟶ Y) (x : X) :
    ((X.presheaf.stalk x) ⧸
      Ideal.map (f.stalkMap x).hom
        (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f x)))) ≃+*
      ((f.fiber (f x)).presheaf.stalk (f.asFiber x)) := by
  classical
  let F := (f.fiber (f x)).presheaf.stalk (f.asFiber x)
  let Q : X → Type _ := fun a =>
    (X.presheaf.stalk a) ⧸ Ideal.map (f.stalkMap a).hom
      (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f a)))
  let P : X → Type _ := fun a => Q a ≃+* F
  have h : f.fiberι (f x) (f.asFiber x) = x := f.fiberι_asFiber x
  have e : P (f.fiberι (f x) (f.asFiber x)) := Classical.choose (quotientStalk_bridge f x)
  change P x
  exact h ▸ e

/-- The quotient-to-fibre equivalence is induced by the canonical map on stalks. -/
public theorem quotientStalkEquivFiberStalk_mk {X Y : Scheme.{u}}
    (f : X ⟶ Y) (x : X) (b : X.presheaf.stalk x) :
    quotientStalkEquivFiberStalk f x
      (Ideal.Quotient.mk
        (Ideal.map (f.stalkMap x).hom
          (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f x)))) b) =
        ((f.fiberι (f x)).stalkMap (f.asFiber x)).hom
          ((X.presheaf.stalkCongr
            (.of_eq (f.fiberι_asFiber x).symm)).hom b) := by
  classical
  let F := (f.fiber (f x)).presheaf.stalk (f.asFiber x)
  let Q : X → Type _ := fun a =>
    (X.presheaf.stalk a) ⧸ Ideal.map (f.stalkMap a).hom
      (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f a)))
  let P : X → Type _ := fun a => Q a ≃+* F
  let y₀ := f.fiberι (f x) (f.asFiber x)
  let h : y₀ = x := f.fiberι_asFiber x
  let ex := quotientStalk_bridge f x
  have he := Classical.choose_spec ex
  let e : P y₀ := Classical.choose ex
  let J : ∀ a : X, Ideal (X.presheaf.stalk a) := fun a =>
    Ideal.map (f.stalkMap a).hom
      (IsLocalRing.maximalIdeal (Y.presheaf.stalk (f a)))
  have hcastFun : ∀ {a b : X} (h : a = b) (e : P a) (r : Q b),
      (h ▸ e) r = e (h.symm ▸ r) := by
    intro a b h e r
    cases h
    rfl
  have hcastMk : ∀ {a b : X} (h : a = b) (r : X.presheaf.stalk b),
      h.symm ▸ (Ideal.Quotient.mk (J b) r) =
        Ideal.Quotient.mk (J a)
          ((X.presheaf.stalkCongr (.of_eq h.symm)).hom r) := by
    intro a b h r
    cases h
    simp [TopCat.Presheaf.stalkCongr]
  change (h ▸ e) (Ideal.Quotient.mk (J x) b) = _
  rw [hcastFun h e (Ideal.Quotient.mk (J x) b), hcastMk h b]
  change (Classical.choose ex)
      (Ideal.Quotient.mk (J y₀)
        ((X.presheaf.stalkCongr (.of_eq h.symm)).hom b)) = _
  exact he ((X.presheaf.stalkCongr (.of_eq h.symm)).hom b)

end AlgebraicGeometry
