module

public import Mathlib.AlgebraicGeometry.Limits
public import Mathlib.AlgebraicGeometry.Morphisms.ClosedImmersion
public import Mathlib.AlgebraicGeometry.Morphisms.OpenImmersion
public import Mathlib.RingTheory.Unramified.Basic
public import StacksFrontier.AlgebraicGeometry.WeilCohomology.FurtherProperties.ScalarExtension

/-!
# The splitting `k' ⊗_k k'' = k'' × l` and the decomposition of `X ×_k Spec k''`

Let `k''/k'/k` be a tower of algebras with `k'` unramified over `k` (for instance finite
separable), and let `X` be a scheme over `Spec k'`. The proof of Stacks 0FHX writes
`k' ⊗_k k'' = k'' × l`, so that `Spec k' ×_{Spec k} Spec k''` is the disjoint union of `Spec k''`
and `Spec l`, and deduces that `X ×_{Spec k} Spec k''` is the disjoint union of
`X ×_{Spec k'} Spec k''` and `X ×_{Spec k'} Spec l`. This file proves these scheme-theoretic
facts.

* The kernel of the multiplication map `k' ⊗_k k'' → k''` is generated by an idempotent, the
  image of the idempotent generating the kernel of `k' ⊗_k k' → k'`; this is the splitting
  `k' ⊗_k k'' = k'' × l`, the first projection being the multiplication map.
* Hence the graph `Spec k'' ⟶ Spec k' ×_{Spec k} Spec k''` of `Spec k'' ⟶ Spec k'`, which is
  `Spec` of the multiplication map, is an open and closed immersion.
* The square formed by `X ×_{Spec k'} Spec k'' ⟶ X ×_{Spec k} Spec k''`, the graph and
  `π × id : X ×_{Spec k} Spec k'' ⟶ Spec k' ×_{Spec k} Spec k''` is cartesian. So the
  comparison morphism `X ×_{Spec k'} Spec k'' ⟶ X ×_{Spec k} Spec k''` is an open and closed
  immersion whose image is the preimage of the graph. Its complement is the preimage of the
  complement `Spec l` of the graph, the scheme `X ×_{Spec k'} Spec l`.

## Main definitions

* `Stacks.WeilCohomology.specGraph`: the graph `Spec B ⟶ Spec A ×_{Spec k} Spec B`.
* `Stacks.WeilCohomology.baseChangeComparison`: `X ×_{Spec A} Spec B ⟶ X ×_{Spec k} Spec B`.
* `Stacks.WeilCohomology.productMap`: `π × id : X ×_{Spec k} Spec B ⟶ Spec A ×_{Spec k} Spec B`.
* `Stacks.WeilCohomology.rangeComplement`: the open complement of a closed immersion.

## Main results

* `Stacks.WeilCohomology.exists_isIdempotentElem_ker_tensorMulHom`: the kernel of
  `A ⊗_k B → B` is generated by an idempotent when `A` is unramified over `k`.
* `Stacks.WeilCohomology.isPullback_baseChangeComparison`: the cartesian square above.
* `Stacks.WeilCohomology.range_baseChangeComparison`: the image of `X ×_{Spec A} Spec B` is the
  preimage of the graph.
* `Stacks.WeilCohomology.nonempty_isColimit_rangeComplement`: an open and closed immersion
  `U ⟶ Z` exhibits `Z` as the disjoint union of `U` and the complement of its image.

## References

* [Stacks Project, Tag 0FHX](https://stacks.math.columbia.edu/tag/0FHX)
-/

@[expose] public section

noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped TensorProduct

universe u

namespace Stacks.WeilCohomology

section Algebra

variable (k A B : Type*) [CommRing k] [CommRing A] [CommRing B] [Algebra k A] [Algebra k B]
  [Algebra A B] [IsScalarTower k A B]

/-- The map `A ⊗_k A → A ⊗_k B`, `a ⊗ a' ↦ a ⊗ a'`, induced by the structure map `A → B` on the
second factor. -/
abbrev tensorDiagonalMap : A ⊗[k] A →ₐ[k] A ⊗[k] B :=
  Algebra.TensorProduct.map (AlgHom.id k A) (IsScalarTower.toAlgHom k A B)

/-- Multiplication `A ⊗_k B → B` after `A ⊗_k A → A ⊗_k B` is multiplication `A ⊗_k A → A`
followed by the structure map `A → B`. -/
theorem tensorMulHom_comp_tensorDiagonalMap :
    (tensorMulHom k A B).comp (tensorDiagonalMap k A B) =
      (IsScalarTower.toAlgHom k A B).comp (Algebra.TensorProduct.lmul' k) := by
  ext a <;> simp

/-- Every `x ∈ A ⊗_k B` is congruent to `1 ⊗ (multiplication of x)` modulo the image of the
kernel of `A ⊗_k A → A`. -/
theorem sub_includeRight_tensorMulHom_mem (x : A ⊗[k] B) :
    x - Algebra.TensorProduct.includeRight (tensorMulHom k A B x) ∈
      (KaehlerDifferential.ideal k A).map (tensorDiagonalMap k A B) := by
  induction x using TensorProduct.induction_on with
  | zero => simp
  | add x y hx hy =>
    have : x + y - Algebra.TensorProduct.includeRight (tensorMulHom k A B (x + y)) =
        (x - Algebra.TensorProduct.includeRight (tensorMulHom k A B x)) +
          (y - Algebra.TensorProduct.includeRight (tensorMulHom k A B y)) := by
      rw [map_add, map_add]
      abel
    rw [this]
    exact Ideal.add_mem _ hx hy
  | tmul a b =>
    have hmem : tensorDiagonalMap k A B ((1 : A) ⊗ₜ[k] a - a ⊗ₜ[k] (1 : A)) ∈
        (KaehlerDifferential.ideal k A).map (tensorDiagonalMap k A B) :=
      Ideal.mem_map_of_mem _ (KaehlerDifferential.one_smul_sub_smul_one_mem_ideal k a)
    have := Ideal.mul_mem_right ((1 : A) ⊗ₜ[k] b) _ (neg_mem hmem)
    convert this using 1
    simp only [map_sub, Algebra.TensorProduct.map_tmul, AlgHom.id_apply,
      IsScalarTower.coe_toAlgHom',
      map_one, tensorMulHom_tmul, Algebra.TensorProduct.includeRight_apply, neg_sub, sub_mul,
      Algebra.TensorProduct.tmul_mul_tmul, one_mul, mul_one]

/-- The kernel of the multiplication map `A ⊗_k B → B` is generated by the image of the kernel of
the multiplication map `A ⊗_k A → A`. -/
theorem ker_tensorMulHom_eq_map :
    RingHom.ker (tensorMulHom k A B) =
      (KaehlerDifferential.ideal k A).map (tensorDiagonalMap k A B) := by
  apply le_antisymm
  · intro x hx
    simpa [(RingHom.mem_ker).mp hx] using sub_includeRight_tensorMulHom_mem k A B x
  · rw [Ideal.map_le_iff_le_comap]
    intro z hz
    rw [Ideal.mem_comap, RingHom.mem_ker]
    have h := congrArg (fun φ : A ⊗[k] A →ₐ[k] B => φ z) (tensorMulHom_comp_tensorDiagonalMap k A B)
    simp only [AlgHom.comp_apply] at h
    show tensorMulHom k A B (tensorDiagonalMap k A B z) = 0
    rw [h, (RingHom.mem_ker).mp hz, map_zero]

/-- For `A` unramified over `k`, the kernel of the multiplication map `A ⊗_k B → B` is generated by
an idempotent. -/
theorem exists_isIdempotentElem_ker_tensorMulHom [Algebra.EssFiniteType k A]
    [Algebra.FormallyUnramified k A] :
    ∃ e : A ⊗[k] B, IsIdempotentElem e ∧ RingHom.ker (tensorMulHom k A B) = Ideal.span {e} := by
  obtain ⟨e, he, hsp⟩ : ∃ e, IsIdempotentElem e ∧ KaehlerDifferential.ideal k A = Ideal.span {e} :=
    (Ideal.isIdempotentElem_iff_of_fg _ (KaehlerDifferential.ideal_fg k A)).mp <|
      (Ideal.cotangent_subsingleton_iff _).mp <| inferInstanceAs <| Subsingleton Ω[A⁄k]
  refine ⟨tensorDiagonalMap k A B e, he.map _, ?_⟩
  rw [ker_tensorMulHom_eq_map, hsp, Ideal.map_span, Set.image_singleton]

end Algebra

section Complement

variable {U Z : Scheme.{u}} (f : U ⟶ Z) [IsClosedImmersion f]

/-- The complement of the image of a closed immersion, as an open subscheme. -/
def rangeComplement : Z.Opens :=
  ⟨(Set.range f)ᶜ, f.isClosedEmbedding.isClosed_range.isOpen_compl⟩

/-- The underlying set of `rangeComplement f`. -/
@[simp]
theorem coe_rangeComplement : (rangeComplement f : Set Z) = (Set.range f)ᶜ := rfl

/-- The image of an open and closed immersion and its complement are complementary opens. -/
theorem isCompl_opensRange_rangeComplement [IsOpenImmersion f] :
    IsCompl f.opensRange (rangeComplement f).ι.opensRange := by
  rw [Scheme.Opens.opensRange_ι, isCompl_iff, disjoint_iff, codisjoint_iff]
  constructor <;> apply SetLike.coe_injective <;> simp [Scheme.Hom.coe_opensRange, rangeComplement]

/-- An open and closed immersion `U ⟶ Z` exhibits `Z` as the disjoint union of `U` and the
complement of its image. -/
theorem nonempty_isColimit_rangeComplement [IsOpenImmersion f] :
    Nonempty (IsColimit (BinaryCofan.mk f (rangeComplement f).ι)) :=
  nonempty_isColimit_binaryCofanMk_of_isCompl _ _ (isCompl_opensRange_rangeComplement f)

end Complement

section Geometry

/-- The structure morphism `Spec S ⟶ Spec R` of an `R`-algebra `S`. -/
local notation "specStructure" R:max S:max => Spec.map (CommRingCat.ofHom (algebraMap R S))

variable (k A B : Type u) [CommRing k] [CommRing A] [CommRing B] [Algebra k A] [Algebra k B]
  [Algebra A B] [IsScalarTower k A B]

/-- `Spec B ⟶ Spec A ⟶ Spec k` is the structure morphism of `Spec B`. -/
theorem specMap_algebraMap_comp :
    specStructure A B ≫ specStructure k A = specStructure k B := by
  rw [← Spec.map_comp, ← CommRingCat.ofHom_comp, ← IsScalarTower.algebraMap_eq]

/-- The graph `Spec B ⟶ Spec A ×_{Spec k} Spec B` of the structure morphism `Spec B ⟶ Spec A`. -/
def specGraph : Spec (.of B) ⟶ pullback (specStructure k A) (specStructure k B) :=
  pullback.lift (specStructure A B) (𝟙 _) (by rw [specMap_algebraMap_comp, Category.id_comp])

/-- The first component of the graph is the structure morphism `Spec B ⟶ Spec A`. -/
@[reassoc (attr := simp)]
theorem specGraph_fst : specGraph k A B ≫ pullback.fst _ _ = specStructure A B :=
  pullback.lift_fst _ _ _

/-- The second component of the graph is the identity. -/
@[reassoc (attr := simp)]
theorem specGraph_snd : specGraph k A B ≫ pullback.snd _ _ = 𝟙 _ :=
  pullback.lift_snd _ _ _

/-- The graph is `Spec` of the multiplication map `A ⊗_k B → B`. -/
theorem specGraph_eq :
    specGraph k A B = Spec.map (CommRingCat.ofHom (tensorMulHom k A B).toRingHom) ≫
      (pullbackSpecIso k A B).inv := by
  apply pullback.hom_ext
  · rw [specGraph_fst, Category.assoc, pullbackSpecIso_inv_fst', ← Spec.map_comp]
    apply congrArg Spec.map
    ext a
    simp
  · rw [specGraph_snd, Category.assoc, pullbackSpecIso_inv_snd, ← Spec.map_comp, ← Spec.map_id]
    apply congrArg Spec.map
    ext b
    simp

/-- The multiplication map `A ⊗_k B → B` is surjective. -/
theorem tensorMulHom_surjective : Function.Surjective (tensorMulHom k A B) :=
  fun b => ⟨1 ⊗ₜ b, by simp⟩

/-- For `A` unramified over `k`, the graph `Spec B ⟶ Spec A ×_{Spec k} Spec B` is an open
immersion. -/
instance isOpenImmersion_specGraph [Algebra.EssFiniteType k A] [Algebra.FormallyUnramified k A] :
    IsOpenImmersion (specGraph k A B) := by
  rw [specGraph_eq]
  have : IsOpenImmersion (Spec.map (CommRingCat.ofHom (tensorMulHom k A B).toRingHom)) :=
    (isOpenImmersion_SpecMap_iff_of_surjective _ (tensorMulHom_surjective k A B)).mpr
      (exists_isIdempotentElem_ker_tensorMulHom k A B)
  infer_instance

/-- The graph `Spec B ⟶ Spec A ×_{Spec k} Spec B` is a closed immersion. -/
instance isClosedImmersion_specGraph : IsClosedImmersion (specGraph k A B) := by
  rw [specGraph_eq]
  have : IsClosedImmersion (Spec.map (CommRingCat.ofHom (tensorMulHom k A B).toRingHom)) :=
    IsClosedImmersion.spec_of_surjective _ (tensorMulHom_surjective k A B)
  infer_instance

variable {A} {X : Scheme.{u}} (π : X ⟶ Spec (.of A))

/-- The canonical morphism `X ×_{Spec A} Spec B ⟶ X ×_{Spec k} Spec B`. -/
def baseChangeComparison :
    pullback π (specStructure A B) ⟶ pullback (π ≫ specStructure k A) (specStructure k B) :=
  pullback.lift (pullback.fst _ _) (pullback.snd _ _) (by
    rw [pullback.condition_assoc, specMap_algebraMap_comp k A B])

/-- The comparison morphism commutes with the projections to `X`. -/
@[reassoc (attr := simp)]
theorem baseChangeComparison_fst :
    baseChangeComparison k B π ≫ pullback.fst _ _ = pullback.fst _ _ :=
  pullback.lift_fst _ _ _

/-- The comparison morphism commutes with the projections to `Spec B`. -/
@[reassoc (attr := simp)]
theorem baseChangeComparison_snd :
    baseChangeComparison k B π ≫ pullback.snd _ _ = pullback.snd _ _ :=
  pullback.lift_snd _ _ _

/-- The morphism `π × id : X ×_{Spec k} Spec B ⟶ Spec A ×_{Spec k} Spec B`. -/
def productMap :
    pullback (π ≫ specStructure k A) (specStructure k B) ⟶
      pullback (specStructure k A) (specStructure k B) :=
  pullback.map _ _ _ _ π (𝟙 _) (𝟙 _) (by simp) (by simp)

omit [Algebra A B] [IsScalarTower k A B] in
/-- The first component of `π × id` is `π` on the first factor. -/
@[reassoc (attr := simp)]
theorem productMap_fst : productMap k B π ≫ pullback.fst _ _ = pullback.fst _ _ ≫ π :=
  pullback.lift_fst _ _ _

omit [Algebra A B] [IsScalarTower k A B] in
/-- The second component of `π × id` is the second projection. -/
@[reassoc (attr := simp)]
theorem productMap_snd : productMap k B π ≫ pullback.snd _ _ = pullback.snd _ _ := by
  rw [productMap, pullback.lift_snd, Category.comp_id]

omit [Algebra A B] [IsScalarTower k A B] in
/-- The square with sides `π × id` and `π` is cartesian:
`X ×_{Spec k} Spec B = X ×_{Spec A} (Spec A ×_{Spec k} Spec B)`. -/
theorem isPullback_productMap :
    IsPullback (pullback.fst _ _) (productMap k B π) π (pullback.fst _ _) := by
  refine IsPullback.of_bot (v₂₁ := pullback.snd _ _) (v₂₂ := specStructure k A)
    (h₃₁ := specStructure k B) ?_ (productMap_fst k B π).symm (IsPullback.of_hasPullback _ _)
  rw [productMap_snd]
  exact IsPullback.of_hasPullback _ _

/-- `X ×_{Spec A} Spec B ⟶ X ×_{Spec k} Spec B ⟶ Spec A ×_{Spec k} Spec B` factors through the
graph. -/
theorem baseChangeComparison_productMap :
    baseChangeComparison k B π ≫ productMap k B π = pullback.snd _ _ ≫ specGraph k A B := by
  apply pullback.hom_ext
  · simp [pullback.condition]
  · simp

/-- **The square of Stacks 0FHX.** The square
```
X ×_{Spec A} Spec B ──→ X ×_{Spec k} Spec B
        │                       │ π × id
        ↓                       ↓
     Spec B ───graph───→ Spec A ×_{Spec k} Spec B
```
is cartesian. -/
theorem isPullback_baseChangeComparison :
    IsPullback (baseChangeComparison k B π) (pullback.snd _ _) (productMap k B π)
      (specGraph k A B) := by
  refine IsPullback.of_right ?_ (baseChangeComparison_productMap k B π)
    (isPullback_productMap k B π)
  rw [baseChangeComparison_fst, specGraph_fst]
  exact IsPullback.of_hasPullback _ _

/-- For `A` unramified over `k`, `X ×_{Spec A} Spec B ⟶ X ×_{Spec k} Spec B` is an open
immersion, as the base change of the graph. -/
instance [Algebra.EssFiniteType k A] [Algebra.FormallyUnramified k A] :
    IsOpenImmersion (baseChangeComparison k B π) :=
  MorphismProperty.of_isPullback (P := @IsOpenImmersion)
    (isPullback_baseChangeComparison k B π).flip
    (inferInstanceAs (IsOpenImmersion (specGraph k A B)))

/-- `X ×_{Spec A} Spec B ⟶ X ×_{Spec k} Spec B` is a closed immersion, as the base change of the
graph. -/
instance : IsClosedImmersion (baseChangeComparison k B π) :=
  MorphismProperty.of_isPullback (P := @IsClosedImmersion)
    (isPullback_baseChangeComparison k B π).flip
    (inferInstanceAs (IsClosedImmersion (specGraph k A B)))

/-- The image of `X ×_{Spec A} Spec B` in `X ×_{Spec k} Spec B` is the preimage of the graph. -/
theorem range_baseChangeComparison :
    Set.range (baseChangeComparison k B π) =
      productMap k B π ⁻¹' Set.range (specGraph k A B) := by
  have h1 : baseChangeComparison k B π =
      (isPullback_baseChangeComparison k B π).flip.isoPullback.hom ≫ pullback.snd _ _ := by simp
  rw [h1, Scheme.Hom.comp_base, TopCat.coe_comp, Set.range_comp,
    Set.range_eq_univ.mpr (ConcreteCategory.bijective_of_isIso _).2, Set.image_univ,
    Scheme.Pullback.range_snd]

end Geometry

end Stacks.WeilCohomology
