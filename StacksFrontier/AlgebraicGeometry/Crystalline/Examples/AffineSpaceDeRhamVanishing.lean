module

public import Mathlib.Algebra.Category.Grp.Abelian
public import Mathlib.Algebra.Category.Grp.Zero
public import Mathlib.Algebra.Homology.ShortComplex.HomologicalComplex
public import StacksFrontier.AlgebraicGeometry.Crystalline.Examples.AffineSpaceDeRham

/-!
# The completed de Rham complex of affine space stops in degree `r`

In the setup of the example of [Stacks, Tag 07LK] — the base `A = 𝐙_p`, the presentation
`C = 𝐅_p[x_1, …, x_r] = P/pP` with `P = 𝐙_p[x_1, …, x_r]`, and the completed thickening
`D = P^∧` — the completed divided power de Rham complex

`D → Ω¹_D → Ω²_D → ⋯`

of `Crystalline.AffineSpaceCrystallineSetup.deRhamComplexNat` has no terms above degree `r`, so
it is the complex `D → Ω¹_D → ⋯ → Ω^r_D` displayed in the source, and its cohomology vanishes
outside degrees `0, …, r`. Since the complex is indexed by `ℕ`, it has no negative degrees, so this
is the vanishing above degree `r`. This is the first of the four consequences drawn in
[Stacks, Tag 07LK] from the representation of `RΓ(Cris(X/S), 𝒪_{X/S})` by the displayed complex,
for the complex itself.

## Main results

* `Crystalline.AffineSpaceCrystallineSetup.differentials_eq_span_sup`: modulo `p^e`, the module
  `Ω¹_{D/A,δ}` of divided power differentials of `D` is generated by `dx_1, …, dx_r`.
* `Crystalline.AffineSpaceCrystallineSetup.pow_smul_top_forms_eq_top`: for `i > r` the module
  `Ω^i_{D/A,δ}` satisfies `p^e Ω^i = Ω^i` for every `e`.
* `Crystalline.AffineSpaceCrystallineSetup.subsingleton_completedForms`: hence `Ω^i_D = 0` for
  `i > r`.
* `Crystalline.AffineSpaceCrystallineSetup.isZero_homology_deRhamComplexNat`: the cohomology of
  the complex vanishes in degrees above `r`.

## Implementation notes

The argument for the vanishing is: every `b ∈ D` agrees modulo `p^e` with the image of a
polynomial `f ∈ P`, the differential `d(f)` of a polynomial is a `D`-combination of the `dx_k` by
the Leibniz rule, and `d(p^e w) = p^e d(w)` since `p` is a constant.  So `Ω¹ = N + p^e Ω¹` with
`N` generated by the `r` elements `dx_k`.  Expanding a wedge of `i > r` vectors along this
decomposition, each term either wedges at least `r + 1` vectors of `N` — and so vanishes, an
exterior power of a module with `r` generators being zero above degree `r` — or carries at least
one factor of `p^e`.  Hence `Ω^i = p^e Ω^i` for all `e`, and the adic completion of such a module
is zero.

The filtration is indexed by powers of `p` read in `A = 𝐙_p`, matching the completion used for
`Ω^i_D`; `pow_smul_top_forms_eq_top` converts to that indexing from the statement over `D`, which
is where the argument naturally takes place, since `Ω¹_{D/A,δ}` is a `D`-module.

## References

* [Stacks Project, Tag 07LK](https://stacks.math.columbia.edu/tag/07LK)
* [Stacks Project, Tag 07LG](https://stacks.math.columbia.edu/tag/07LG)
* [Stacks Project, Tag 07HZ](https://stacks.math.columbia.edu/tag/07HZ)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits

namespace Crystalline

/-! ### Two general lemmas -/

section General

variable {S M : Type*} [CommRing S] [AddCommGroup M] [Module S M]

/-- An element of `(c) • ⊤` is a multiple `c • z`. -/
private lemma mem_span_singleton_smul_top_iff {c : S} {x : M} :
    x ∈ Ideal.span {c} • (⊤ : Submodule S M) ↔ ∃ z, c • z = x := by
  rw [Submodule.ideal_span_singleton_smul, Submodule.mem_smul_pointwise_iff_exists]
  simp

/-- A wedge of `i` vectors of a submodule generated by `r < i` elements vanishes. -/
private lemma ιMulti_eq_zero_of_mem_span {r i : ℕ} (g : Fin r → M) (hi : r < i)
    (w : Fin i → M) (hw : ∀ j, w j ∈ Submodule.span S (Set.range g)) :
    exteriorPower.ιMulti S i w = 0 := by
  obtain ⟨g', hg'⟩ : ∃ g' : Fin r → Submodule.span S (Set.range g),
      (Submodule.span S (Set.range g)).subtype ∘ g' = g :=
    ⟨fun k ↦ ⟨g k, Submodule.subset_span (Set.mem_range_self k)⟩, rfl⟩
  have htop : Submodule.span S (Set.range g') = ⊤ := by
    apply SetLike.coe_injective
    apply Set.image_injective.mpr (Submodule.span S (Set.range g)).injective_subtype
    rw [← Submodule.map_coe, ← Submodule.span_image, ← Set.range_comp, hg',
      ← Submodule.map_coe, ← LinearMap.range_eq_map, Submodule.range_subtype]
  have hsub : Subsingleton (⋀[S]^i (Submodule.span S (Set.range g))) :=
    exteriorPower.subsingleton_of_span_eq_top_of_card_lt g' htop i (by simpa using hi)
  have hzero : exteriorPower.ιMulti S i (fun j ↦ (⟨w j, hw j⟩ :
      Submodule.span S (Set.range g))) = 0 := Subsingleton.elim _ _
  have hmap : exteriorPower.ιMulti S i w =
      exteriorPower.map i (Submodule.span S (Set.range g)).subtype
        (exteriorPower.ιMulti S i (fun j ↦ (⟨w j, hw j⟩ :
          Submodule.span S (Set.range g)))) := by
    rw [exteriorPower.map_apply_ιMulti]
    rfl
  rw [hmap, hzero, map_zero]

/-- If `M` is generated by `r` elements together with `cM`, then every wedge of `i > r` vectors of
`M` is divisible by `c`: expanding the wedge, a term with more than `r` factors from the
`r`-generated part vanishes, and every other term keeps a factor of `c`. -/
private lemma exteriorPower_smul_top_eq_top {r i : ℕ} (g : Fin r → M) (c : S) (hi : r < i)
    (hM : (⊤ : Submodule S M) = Submodule.span S (Set.range g) ⊔ Ideal.span {c} • ⊤) :
    Ideal.span {c} • (⊤ : Submodule S (⋀[S]^i M)) = ⊤ := by
  classical
  have key : ∀ m : ℕ, ∀ w : Fin i → M,
      (∀ j : Fin i, m ≤ (j : ℕ) → w j ∈ Submodule.span S (Set.range g)) →
      exteriorPower.ιMulti S i w ∈ Ideal.span {c} • (⊤ : Submodule S (⋀[S]^i M)) := by
    intro m
    induction m with
    | zero =>
      intro w hw
      rw [ιMulti_eq_zero_of_mem_span g hi w fun j ↦ hw j (Nat.zero_le _)]
      exact Submodule.zero_mem _
    | succ m ih =>
      intro w hw
      by_cases hm : m < i
      · have hmem : w ⟨m, hm⟩ ∈
            Submodule.span S (Set.range g) ⊔ Ideal.span {c} • (⊤ : Submodule S M) := by
          rw [← hM]
          exact Submodule.mem_top
        obtain ⟨n, hn, y, hy, hny⟩ := Submodule.mem_sup.mp hmem
        have hu : Function.update w ⟨m, hm⟩ (n + y) = w := by
          rw [hny]
          exact Function.update_eq_self ⟨m, hm⟩ w
        have hsplit : exteriorPower.ιMulti S i w =
            exteriorPower.ιMulti S i (Function.update w ⟨m, hm⟩ n) +
              exteriorPower.ιMulti S i (Function.update w ⟨m, hm⟩ y) :=
          calc exteriorPower.ιMulti S i w
              = exteriorPower.ιMulti S i (Function.update w ⟨m, hm⟩ (n + y)) := by rw [hu]
            _ = _ + _ := by simp
        rw [hsplit]
        refine Submodule.add_mem _ (ih _ ?_) ?_
        · intro j hj
          by_cases hjm : j = ⟨m, hm⟩
          · rw [hjm, Function.update_self]
            exact hn
          · rw [Function.update_of_ne hjm]
            refine hw j ?_
            have hne : (j : ℕ) ≠ m := fun h ↦ hjm (Fin.ext h)
            omega
        · obtain ⟨z, hz⟩ := mem_span_singleton_smul_top_iff.mp hy
          have hsm : exteriorPower.ιMulti S i (Function.update w ⟨m, hm⟩ y) =
              c • exteriorPower.ιMulti S i (Function.update w ⟨m, hm⟩ z) := by
            rw [← hz]
            simp
          rw [hsm]
          exact Submodule.smul_mem_smul (Ideal.mem_span_singleton_self c) Submodule.mem_top
      · exact ih w fun j hj ↦ hw j (by omega)
  have hle : Submodule.span S (Set.range (exteriorPower.ιMulti S i)) ≤
      Ideal.span {c} • (⊤ : Submodule S (⋀[S]^i M)) := by
    rw [Submodule.span_le]
    rintro _ ⟨w, rfl⟩
    exact key i w fun j hj ↦ (Nat.not_le.mpr j.isLt hj).elim
  rw [exteriorPower.ιMulti_span] at hle
  exact le_antisymm le_top hle

/-- A module equal to `I^n M` for every `n` has trivial `I`-adic completion. -/
private lemma subsingleton_adicCompletion (I : Ideal S)
    (h : ∀ n : ℕ, I ^ n • (⊤ : Submodule S M) = ⊤) :
    Subsingleton (AdicCompletion I M) := by
  refine ⟨fun x y ↦ AdicCompletion.ext fun n ↦ ?_⟩
  obtain ⟨a, ha⟩ := Submodule.Quotient.mk_surjective (I ^ n • (⊤ : Submodule S M)) (x.val n)
  obtain ⟨b, hb⟩ := Submodule.Quotient.mk_surjective (I ^ n • (⊤ : Submodule S M)) (y.val n)
  rw [← ha, ← hb, Submodule.Quotient.eq, h n]
  exact Submodule.mem_top

end General

namespace AffineSpaceCrystallineSetup

variable (T : AffineSpaceCrystallineSetup)

/-! ### Leibniz rules for the divided power differential of `D` -/

/-- The divided power differential of `D` is additive. -/
public theorem differential_add (x y : T.D) :
    T.differential (x + y) = T.differential x + T.differential y := by
  change (dividedPowerDifferentialRelations (A := T.A) T.completedDividedPowers).mkQ
      (KaehlerDifferential.D T.A T.D (x + y)) = _
  rw [map_add, map_add]
  rfl

/-- The divided power differential of `D` satisfies the Leibniz rule. -/
public theorem differential_mul (x y : T.D) :
    T.differential (x * y) = x • T.differential y + y • T.differential x := by
  change (dividedPowerDifferentialRelations (A := T.A) T.completedDividedPowers).mkQ
      (KaehlerDifferential.D T.A T.D (x * y)) = _
  rw [Derivation.leibniz, map_add, map_smul, map_smul]
  rfl

/-- The divided power differential of `D` kills the image of the crystalline base. -/
public theorem differential_algebraMap (a : T.A) :
    T.differential (algebraMap T.A T.D a) = 0 := by
  change (dividedPowerDifferentialRelations (A := T.A) T.completedDividedPowers).mkQ
      (KaehlerDifferential.D T.A T.D (algebraMap T.A T.D a)) = _
  rw [Derivation.map_algebraMap, map_zero]

/-! ### The differentials of the coordinates generate modulo `p^e` -/

/-- The differential `dx_k` of the `k`-th coordinate, read in `Ω¹_{D/A,δ}`. -/
public def coordinateDifferential (k : Fin T.r) : T.differentials :=
  T.differential (algebraMap T.P T.D (MvPolynomial.X k))

/-- The `D`-submodule of `Ω¹_{D/A,δ}` generated by `dx_1, …, dx_r`. -/
public def coordinateSpan : Submodule T.D T.differentials :=
  Submodule.span T.D (Set.range T.coordinateDifferential)

/-- The differential of (the image in `D` of) a polynomial is a `D`-combination of the `dx_k`. -/
public theorem differential_algebraMap_mem_coordinateSpan (f : T.P) :
    T.differential (algebraMap T.P T.D f) ∈ T.coordinateSpan := by
  refine MvPolynomial.induction_on
    (motive := fun f ↦ T.differential (algebraMap T.P T.D f) ∈ T.coordinateSpan) f
    (fun a ↦ ?_) (fun f g hf hg ↦ ?_) (fun f k hf ↦ ?_)
  · have hC : algebraMap T.P T.D (MvPolynomial.C a) = algebraMap T.A T.D a := by
      rw [show (MvPolynomial.C a : T.P) = algebraMap T.A T.P a from rfl]
      exact (IsScalarTower.algebraMap_apply T.A T.P T.D a).symm
    rw [hC, T.differential_algebraMap]
    exact Submodule.zero_mem _
  · rw [map_add, T.differential_add]
    exact Submodule.add_mem _ hf hg
  · rw [map_mul, T.differential_mul]
    refine Submodule.add_mem _ (Submodule.smul_mem _ _ ?_) (Submodule.smul_mem _ _ hf)
    exact Submodule.subset_span (Set.mem_range_self k)

/-- Every element of `D` agrees modulo `p^e` with the image of a polynomial: the reduction
`P → D/p^e D` is surjective, `D` being the `p`-adic completion of `P`. -/
public theorem exists_polynomial_sub_mem (e : ℕ) (b : T.D) :
    ∃ f : T.P, b - algebraMap T.P T.D f ∈ Ideal.span {(T.p : T.D) ^ e} := by
  classical
  obtain ⟨f, hf⟩ := Submodule.Quotient.mk_surjective
    (DividedPowers.pAdicIdeal (A := T.P) T.p ^ e • (⊤ : Submodule T.P T.P))
    (AdicCompletion.eval (DividedPowers.pAdicIdeal (A := T.P) T.p) T.P e b)
  refine ⟨f, ?_⟩
  have hker : b - algebraMap T.P T.D f ∈
      DividedPowers.pAdicIdeal (A := T.P) T.p ^ e • (⊤ : Submodule T.P T.D) := by
    rw [AdicCompletion.pow_smul_top_eq_ker_eval (Submodule.fg_span_singleton _),
      LinearMap.mem_ker, map_sub,
      show algebraMap T.P T.D f =
        AdicCompletion.of (DividedPowers.pAdicIdeal (A := T.P) T.p) T.P f from rfl,
      AdicCompletion.eval_of, ← hf]
    simp
  have hpow : DividedPowers.pAdicIdeal (A := T.P) T.p ^ e = Ideal.span {(T.p : T.P) ^ e} :=
    Ideal.span_singleton_pow _ _
  rw [hpow] at hker
  obtain ⟨w, hw⟩ := mem_span_singleton_smul_top_iff.mp hker
  refine Ideal.mem_span_singleton.mpr ⟨w, ?_⟩
  rw [← hw, Algebra.smul_def, map_pow, map_natCast]

/-- Modulo `p^e`, the module `Ω¹_{D/A,δ}` of divided power differentials of `D` over `A = 𝐙_p`
is generated by the differentials `dx_1, …, dx_r` of the coordinates. -/
public theorem differentials_eq_span_sup (e : ℕ) :
    (⊤ : Submodule T.D T.differentials) =
      T.coordinateSpan ⊔ Ideal.span {(T.p : T.D) ^ e} • ⊤ := by
  have hle : Submodule.span T.D
      (Set.range (dividedPowerDifferential (A := T.A) T.completedDividedPowers)) ≤
      T.coordinateSpan ⊔ Ideal.span {(T.p : T.D) ^ e} • ⊤ := by
    rw [Submodule.span_le]
    rintro _ ⟨b, rfl⟩
    obtain ⟨f, hf⟩ := T.exists_polynomial_sub_mem e b
    obtain ⟨w, hw⟩ := Ideal.mem_span_singleton.mp hf
    have hb : b = algebraMap T.P T.D f + (T.p : T.D) ^ e * w := by
      rw [← hw]
      ring
    change T.differential b ∈ ↑(T.coordinateSpan ⊔ Ideal.span {(T.p : T.D) ^ e} • ⊤)
    rw [hb, T.differential_add]
    refine Submodule.add_mem _
      (Submodule.mem_sup_left (T.differential_algebraMap_mem_coordinateSpan f))
      (Submodule.mem_sup_right ?_)
    rw [T.differential_mul,
      show ((T.p : T.D) ^ e) = algebraMap T.A T.D ((T.p : T.A) ^ e) by rw [map_pow, map_natCast],
      T.differential_algebraMap, smul_zero, add_zero, mem_span_singleton_smul_top_iff]
    exact ⟨T.differential w, by rw [map_pow, map_natCast]⟩
  rw [dividedPowerDifferentials_span] at hle
  exact le_antisymm hle le_top

/-! ### Vanishing above degree `r` -/

/-- For `i > r`, the module `Ω^i_{D/A,δ}` of divided power differential forms satisfies
`p^e Ω^i = Ω^i` for every `e`, as `D`-modules. -/
public theorem pow_smul_top_forms_eq_top_D {i : ℕ} (hi : T.r < i) (e : ℕ) :
    Ideal.span {(T.p : T.D)} ^ e • (⊤ : Submodule T.D (T.forms i)) = ⊤ := by
  have h := exteriorPower_smul_top_eq_top (S := T.D) (M := T.differentials)
    T.coordinateDifferential ((T.p : T.D) ^ e) hi (T.differentials_eq_span_sup e)
  rwa [← Ideal.span_singleton_pow] at h

/-- For `i > r`, the module `Ω^i_{D/A,δ}` satisfies `p^e Ω^i = Ω^i` for every `e`, as modules
over the crystalline base `A = 𝐙_p`. -/
public theorem pow_smul_top_forms_eq_top {i : ℕ} (hi : T.r < i) (e : ℕ) :
    T.baseIdeal ^ e • (⊤ : Submodule T.A (T.forms i)) = ⊤ := by
  have hmap : Ideal.map (algebraMap T.A T.D) (T.baseIdeal ^ e) =
      Ideal.span {(T.p : T.D)} ^ e := by
    rw [Ideal.map_pow, baseIdeal, Ideal.map_span]
    simp
  have h := Ideal.smul_restrictScalars (R := T.A) (S := T.D) (T.baseIdeal ^ e)
    (⊤ : Submodule T.D (T.forms i))
  rw [hmap, T.pow_smul_top_forms_eq_top_D hi e, Submodule.restrictScalars_top] at h
  exact h.symm

/-- **The complex stops in degree `r`.**  For `i > r` the term `Ω^i_D` of the completed divided
power de Rham complex of `D` is zero, so the complex is the displayed
`D → Ω¹_D → ⋯ → Ω^r_D`. -/
public theorem subsingleton_completedForms {i : ℕ} (hi : T.r < i) :
    Subsingleton (T.completedForms i) :=
  subsingleton_adicCompletion T.baseIdeal (T.pow_smul_top_forms_eq_top hi)

/-- For `i > r` the degree-`i` term of the complex is the zero group. -/
public theorem isZero_deRhamComplexNat_X {i : ℕ} (hi : T.r < i) :
    IsZero (T.deRhamComplexNat.X i) := by
  rw [T.deRhamComplexNat_X]
  exact AddCommGrpCat.isZero_iff_subsingleton.mpr (T.subsingleton_completedForms hi)

/-- **Conclusion (1) of [Stacks, Tag 07LK], for the displayed complex.**  The cohomology of the
completed divided power de Rham complex of `D` vanishes in every degree above `r`; the complex
being indexed by `ℕ`, it has no degrees below `0`.  So the cohomology of the complex is zero
outside degrees `0, …, r`. -/
public theorem isZero_homology_deRhamComplexNat {i : ℕ} (hi : T.r < i) :
    IsZero (T.deRhamComplexNat.homology i) :=
  (T.deRhamComplexNat.exactAt_iff_isZero_homology i).mp
    (HomologicalComplex.ExactAt.of_isZero (T.isZero_deRhamComplexNat_X hi))

end AffineSpaceCrystallineSetup

end Crystalline

