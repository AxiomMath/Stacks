module

public import Mathlib.LinearAlgebra.Matrix.Determinant.Basic
public import StacksFrontier.AlgebraicGeometry.Crystalline.Examples.AffineSpaceDeRhamDegreeZero

/-!
# The top degree coefficients of the completed de Rham complex of affine space

In the setup of the example of [Stacks, Tag 07LK], with `r = s + 1 > 0` variables, this module
reads the top term `Ω^r_D` of the displayed complex `D → Ω¹_D → ⋯ → Ω^r_D` through coefficient
functionals

`c_m : Ω^r_D → 𝐙_p`, "the coefficient of `x^m dx_1 ∧ ⋯ ∧ dx_r`",

and proves the divisibility properties of the coefficients of exact forms on which the
conclusions (3) and (4) of the source rest.

## The coefficient functionals

`Crystalline.AffineSpaceCrystallineSetup.topFunctional` is the `D`-linear functional
`Ω^r_{D/A,δ} → D` sending `ω_1 ∧ ⋯ ∧ ω_r` to the determinant of the coordinate functionals
`det (∂_k(ω_j))`; it sends `g dx_1 ∧ ⋯ ∧ dx_r` to `g`.  Composing with the monomial coefficient
`D → 𝐙_p` and completing gives `Crystalline.AffineSpaceCrystallineSetup.topCoeff`.

## The exact forms

Modulo `p^t`, the module `Ω^{r-1}_{D/A,δ}` is generated over `D` by the wedges
`dx_{σ(1)} ∧ ⋯ ∧ dx_{σ(r-1)}` (`forms_mem_span_sup`), and the de Rham differential of
`g dx_{σ(1)} ∧ ⋯ ∧ dx_{σ(r-1)}` is `dg ∧ dx_{σ(1)} ∧ ⋯`, whose determinant is, by expansion along
the first row, a combination of the partial derivatives `∂g/∂x_k` with constant coefficients.  So
the top functional of an exact form is a divergence `∑_k ∂b_k/∂x_k` up to `p^t`
(`exists_topFunctional_deRhamDifferential_eq`).  At the diagonal monomial
`m(N) = (N, …, N)` the coefficient of `∂b/∂x_k` is `(N + 1)` times a coefficient of `b`, which
gives the two divisibility statements:

* `pow_dvd_topCoeff_completedDifferential`: the coefficient at `m(p^k - 1)` of an exact form of
  `Ω^r_D` is divisible by `p^k`;
* `exists_pow_succ_dvd_topCoeff_completedDifferential`: for each exact form it is even divisible
  by `p^{k+1}` for all but finitely many `k`, because an element of `D` has all but finitely many
  monomial coefficients divisible by `p`.

## References

* [Stacks Project, Tag 07LK](https://stacks.math.columbia.edu/tag/07LK)
* [Stacks Project, Tag 07HZ](https://stacks.math.columbia.edu/tag/07HZ)
-/

@[expose] public noncomputable section

namespace Crystalline

/-! ### Wedges of vectors from a generated submodule -/

section General

variable {S M : Type*} [CommRing S] [AddCommGroup M] [Module S M]

/-- A wedge of vectors in the span of a finite family lies in the span of the wedges of members
of the family. -/
private lemma ιMulti_mem_span_ιMulti_comp {ι : Type*} [Fintype ι] [DecidableEq ι] (g : ι → M)
    {i : ℕ} (w : Fin i → M) (hw : ∀ j, w j ∈ Submodule.span S (Set.range g)) :
    exteriorPower.ιMulti S i w ∈
      Submodule.span S (Set.range fun σ : Fin i → ι ↦ exteriorPower.ιMulti S i (g ∘ σ)) := by
  choose c hc using fun j ↦ (Submodule.mem_span_range_iff_exists_fun S).mp (hw j)
  have hw' : w = fun j ↦ ∑ k, c j k • g k := funext fun j ↦ (hc j).symm
  rw [hw']
  show (exteriorPower.ιMulti S i).toMultilinearMap (fun j ↦ ∑ k, c j k • g k) ∈ _
  rw [MultilinearMap.map_sum]
  refine Submodule.sum_mem _ fun σ _ ↦ ?_
  rw [MultilinearMap.map_smul_univ]
  exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨σ, rfl⟩)

/-- If `M` is generated by a finite family `g` together with `cM`, then every wedge of `i`
vectors of `M` is a combination of wedges of members of `g` modulo `c`. -/
private lemma ιMulti_mem_span_sup {ι : Type*} [Fintype ι] [DecidableEq ι] (g : ι → M) (c : S)
    (hM : (⊤ : Submodule S M) = Submodule.span S (Set.range g) ⊔ Ideal.span {c} • ⊤) {i : ℕ}
    (w : Fin i → M) :
    exteriorPower.ιMulti S i w ∈
      Submodule.span S (Set.range fun σ : Fin i → ι ↦ exteriorPower.ιMulti S i (g ∘ σ)) ⊔
        Ideal.span {c} • (⊤ : Submodule S (⋀[S]^i M)) := by
  classical
  have hsmul (u : ⋀[S]^i M) :
      c • u ∈ Ideal.span {c} • (⊤ : Submodule S (⋀[S]^i M)) := by
    rw [Submodule.ideal_span_singleton_smul]
    exact (Submodule.mem_smul_pointwise_iff_exists _ c _).mpr ⟨u, Submodule.mem_top, rfl⟩
  have key : ∀ m : ℕ, ∀ w : Fin i → M,
      (∀ j : Fin i, m ≤ (j : ℕ) → w j ∈ Submodule.span S (Set.range g)) →
      exteriorPower.ιMulti S i w ∈
        Submodule.span S (Set.range fun σ : Fin i → ι ↦ exteriorPower.ιMulti S i (g ∘ σ)) ⊔
          Ideal.span {c} • (⊤ : Submodule S (⋀[S]^i M)) := by
    intro m
    induction m with
    | zero =>
      intro w hw
      exact Submodule.mem_sup_left
        (ιMulti_mem_span_ιMulti_comp g w fun j ↦ hw j (Nat.zero_le _))
    | succ m ih =>
      intro w hw
      by_cases hm : m < i
      · have hmem : w ⟨m, hm⟩ ∈
            Submodule.span S (Set.range g) ⊔ Ideal.span {c} • (⊤ : Submodule S M) := by
          rw [← hM]
          exact Submodule.mem_top
        obtain ⟨n, hn, y, hy, hny⟩ := Submodule.mem_sup.mp hmem
        have hu : Function.update w ⟨m, hm⟩ (n + y) = w := by
          rw [hny]
          exact Function.update_eq_self ⟨m, hm⟩ w
        have hsplit : exteriorPower.ιMulti S i w =
            exteriorPower.ιMulti S i (Function.update w ⟨m, hm⟩ n) +
              exteriorPower.ιMulti S i (Function.update w ⟨m, hm⟩ y) :=
          calc exteriorPower.ιMulti S i w
              = exteriorPower.ιMulti S i (Function.update w ⟨m, hm⟩ (n + y)) := by rw [hu]
            _ = _ + _ := by
                simp
        rw [hsplit]
        refine Submodule.add_mem _ (ih _ ?_) ?_
        · intro j hj
          by_cases hjm : j = ⟨m, hm⟩
          · rw [hjm, Function.update_self]
            exact hn
          · rw [Function.update_of_ne hjm]
            refine hw j ?_
            have hne : (j : ℕ) ≠ m := fun h ↦ hjm (Fin.ext h)
            omega
        · rw [Submodule.ideal_span_singleton_smul,
            Submodule.mem_smul_pointwise_iff_exists] at hy
          obtain ⟨z, -, hz⟩ := hy
          have hsm : exteriorPower.ιMulti S i (Function.update w ⟨m, hm⟩ y) =
              c • exteriorPower.ιMulti S i (Function.update w ⟨m, hm⟩ z) := by
            rw [← hz]
            simp
          rw [hsm]
          exact Submodule.mem_sup_right (hsmul _)
      · exact ih w fun j hj ↦ hw j (by omega)
  exact key i w fun j hj ↦ (Nat.not_le.mpr j.isLt hj).elim

end General

namespace AffineSpaceCrystallineSetup

variable (T : AffineSpaceCrystallineSetup)

/-! ### Forms modulo `p^t` -/

/-- The wedge `dx_{σ(1)} ∧ ⋯ ∧ dx_{σ(i)}` of differentials of coordinates, in `Ω^i_{D/A,δ}`. -/
public def wedgeCoordinates {i : ℕ} (σ : Fin i → Fin T.r) : T.forms i :=
  exteriorPower.ιMulti T.D i (T.coordinateDifferential ∘ σ)

/-- The `D`-submodule of `Ω^i_{D/A,δ}` generated by the wedges of the `dx_k`. -/
public def wedgeCoordinatesSpan (i : ℕ) : Submodule T.D (T.forms i) :=
  Submodule.span T.D (Set.range (T.wedgeCoordinates (i := i)))

/-- Modulo `p^t`, the module `Ω^i_{D/A,δ}` is generated over `D` by the wedges
`dx_{σ(1)} ∧ ⋯ ∧ dx_{σ(i)}` of the differentials of the coordinates. -/
public theorem forms_mem_span_sup (i t : ℕ) (ω : T.forms i) :
    ω ∈ T.wedgeCoordinatesSpan i ⊔
      Ideal.span {(T.p : T.D) ^ t} • (⊤ : Submodule T.D (T.forms i)) := by
  have hle : Submodule.span T.D (Set.range (exteriorPower.ιMulti T.D i
      (M := T.differentials))) ≤
      Submodule.span T.D (Set.range fun σ : Fin i → Fin T.r ↦
        exteriorPower.ιMulti T.D i (T.coordinateDifferential ∘ σ)) ⊔
      Ideal.span {(T.p : T.D) ^ t} • (⊤ : Submodule T.D (⋀[T.D]^i T.differentials)) := by
    rw [Submodule.span_le]
    rintro _ ⟨w, rfl⟩
    exact ιMulti_mem_span_sup T.coordinateDifferential _ (T.differentials_eq_span_sup t) w
  rw [exteriorPower.ιMulti_span] at hle
  exact hle Submodule.mem_top

/-! ### The divergence -/

/-- The divergence `(b_k)_k ↦ ∑_k ∂b_k/∂x_k` on `D^r`, as a `𝐙_p`-linear map. -/
public def divergence : (Fin T.r → T.D) →ₗ[T.A] T.D :=
  ∑ k, (T.pderivHom k) ∘ₗ LinearMap.proj k

/-- The divergence of `(b_k)_k` is `∑_k ∂b_k/∂x_k`. -/
public theorem divergence_apply (b : Fin T.r → T.D) :
    T.divergence b = ∑ k, T.pderiv k (b k) := by
  simp [divergence]

/-- Every partial derivative is a divergence. -/
public theorem pderiv_mem_range_divergence (k : Fin T.r) (b : T.D) :
    T.pderiv k b ∈ LinearMap.range T.divergence := by
  classical
  refine ⟨Pi.single k b, ?_⟩
  rw [divergence_apply, Finset.sum_eq_single k]
  · simp
  · intro j _ hj
    simp [Pi.single_apply, hj]
  · simp

/-- The diagonal multi-index `m(N) = (N, …, N)`, the exponent of `x_1^N ⋯ x_r^N`. -/
public def diagMonomial (N : ℕ) : Fin T.r →₀ ℕ :=
  Finsupp.equivFunOnFinite.symm fun _ ↦ N

/-- Every entry of the diagonal multi-index `m(N)` is `N`. -/
@[simp]
public theorem diagMonomial_apply (N : ℕ) (k : Fin T.r) : T.diagMonomial N k = N := rfl

/-- The diagonal multi-indices are pairwise distinct when there is at least one variable. -/
public theorem diagMonomial_injective (k : Fin T.r) : Function.Injective T.diagMonomial := by
  intro N N' h
  simpa using DFunLike.congr_fun h k

/-- **The coefficient of a divergence at a diagonal monomial.**  The coefficient of
`∑_k ∂b_k/∂x_k` at `x_1^N ⋯ x_r^N` is `N + 1` times the sum of the coefficients of the `b_k` at
`x_k ⋅ x_1^N ⋯ x_r^N`. -/
public theorem monomialCoeff_diagMonomial_divergence (N : ℕ) (b : Fin T.r → T.D) :
    T.monomialCoeff (T.diagMonomial N) (T.divergence b) =
      ((N + 1 : ℕ) : T.A) *
        ∑ k, T.monomialCoeff (T.diagMonomial N + Finsupp.single k 1) (b k) := by
  rw [divergence_apply, map_sum, Finset.mul_sum]
  refine Finset.sum_congr rfl fun k _ ↦ ?_
  rw [monomialCoeff_pderiv, diagMonomial_apply]
  push_cast
  ring

/-- An element of `D` has all but finitely many coefficients at the multi-indices
`m(N) + e_k` divisible by `p^t`: modulo `p^t` it is a polynomial. -/
public theorem exists_pow_dvd_monomialCoeff (t : ℕ) (a : T.D) (k : Fin T.r) :
    ∃ B : ℕ, ∀ N, B ≤ N →
      (T.p : T.A) ^ t ∣ T.monomialCoeff (T.diagMonomial N + Finsupp.single k 1) a := by
  classical
  obtain ⟨f, hf⟩ := T.exists_polynomial_sub_mem t a
  obtain ⟨w, hw⟩ := Ideal.mem_span_singleton.mp hf
  refine ⟨MvPolynomial.degreeOf k f, fun N hN ↦ ?_⟩
  have ha : a = algebraMap T.P T.D f + ((T.p : T.A) ^ t) • w := by
    rw [Algebra.smul_def, map_pow, map_natCast, ← hw]
    ring
  have hcoeff : f.coeff (T.diagMonomial N + Finsupp.single k 1) = 0 := by
    by_contra hne
    have h := MvPolynomial.monomial_le_degreeOf k (MvPolynomial.mem_support_iff.mpr hne)
    simp only [Finsupp.add_apply, diagMonomial_apply, Finsupp.single_eq_same] at h
    omega
  rw [ha, map_add, map_smul, T.monomialCoeff_algebraMap, hcoeff, zero_add, smul_eq_mul]
  exact dvd_mul_right _ _

/-- `Crystalline.AffineSpaceCrystallineSetup.exists_pow_dvd_monomialCoeff`, uniformly for the
`r` components of a family. -/
public theorem exists_pow_dvd_monomialCoeff_forall (t : ℕ) (b : Fin T.r → T.D) :
    ∃ B : ℕ, ∀ N, B ≤ N → ∀ k,
      (T.p : T.A) ^ t ∣ T.monomialCoeff (T.diagMonomial N + Finsupp.single k 1) (b k) := by
  choose B hB using fun k ↦ T.exists_pow_dvd_monomialCoeff t (b k) k
  exact ⟨Finset.univ.sup B, fun N hN k ↦
    hB k N ((Finset.le_sup (Finset.mem_univ k)).trans hN)⟩

/-! ### The top functional -/

variable {s : ℕ} (hs : T.r = s + 1)

/-- **The top functional** `Ω^r_{D/A,δ} → D`, for `r = s + 1`: it sends `ω_1 ∧ ⋯ ∧ ω_r` to the
determinant of the matrix `(∂_k(ω_j))_{j,k}` of coordinate functionals, so that it sends
`g dx_1 ∧ ⋯ ∧ dx_r` to `g`. -/
public def topFunctional : T.forms (s + 1) →ₗ[T.D] T.D :=
  exteriorPower.alternatingMapLinearEquiv
    (Matrix.detRowAlternating.compLinearMap
      (LinearMap.pi fun l : Fin (s + 1) ↦ T.coordinateFunctional (Fin.cast hs.symm l)))

/-- The top functional of a wedge is the determinant of the coordinate functionals. -/
public theorem topFunctional_ιMulti (v : Fin (s + 1) → T.differentials) :
    T.topFunctional hs (exteriorPower.ιMulti T.D (s + 1) v : T.forms (s + 1)) =
      (Matrix.of fun j l ↦ T.coordinateFunctional (Fin.cast hs.symm l) (v j)).det :=
  exteriorPower.alternatingMapLinearEquiv_apply_ιMulti _ v

/-- The top functional of the differential of `g dx_{σ(1)} ∧ ⋯ ∧ dx_{σ(s)}` is a divergence:
expanding the determinant along its first row `(∂g/∂x_k)_k`, the minors are constants. -/
public theorem topFunctional_deRhamDifferential_smul_ιMulti (g : T.D) (σ : Fin s → Fin T.r) :
    T.topFunctional hs (T.deRhamDifferential s (g • T.wedgeCoordinates σ)) ∈
      LinearMap.range T.divergence := by
  set F : Fin (s + 1) → T.D :=
    Fin.cons g fun j ↦ algebraMap T.P T.D (MvPolynomial.X (σ j)) with hF
  have hgen := (dividedPowerDeRhamComplex (A := T.A)
    T.completedDividedPowers).differential_generator s F
  have hd : T.deRhamDifferential s (g • T.wedgeCoordinates σ) =
      (exteriorPower.ιMulti T.D (s + 1) (fun j ↦ T.differential (F j)) : T.forms (s + 1)) := by
    rw [hF] at hgen
    simp only [Fin.cons_zero, Fin.cons_succ] at hgen
    exact hgen
  rw [hd, topFunctional_ιMulti, Matrix.det_succ_row_zero]
  refine Submodule.sum_mem _ fun l _ ↦ ?_
  have hminor : (Matrix.of fun j l ↦
      T.coordinateFunctional (Fin.cast hs.symm l) (T.differential (F j))).submatrix
        Fin.succ l.succAbove =
      (algebraMap T.A T.D).mapMatrix (Matrix.of fun j l' ↦
        if σ j = Fin.cast hs.symm (l.succAbove l') then (1 : T.A) else 0) := by
    ext j l'
    simp only [Matrix.submatrix_apply, Matrix.of_apply, RingHom.mapMatrix_apply,
      Matrix.map_apply, coordinateFunctional_differential, hF, Fin.cons_succ,
      pderiv_coordinate]
    split_ifs <;> simp
  rw [hminor, ← RingHom.map_det]
  simp only [Matrix.of_apply, hF, Fin.cons_zero, coordinateFunctional_differential]
  have heq : (-1 : T.D) ^ (l : ℕ) * T.pderiv (Fin.cast hs.symm l) g *
      algebraMap T.A T.D (Matrix.of fun j l' ↦
        if σ j = Fin.cast hs.symm (l.succAbove l') then (1 : T.A) else 0).det =
      T.pderiv (Fin.cast hs.symm l) (((-1 : T.A) ^ (l : ℕ) *
        (Matrix.of fun j l' ↦
          if σ j = Fin.cast hs.symm (l.succAbove l') then (1 : T.A) else 0).det) • g) := by
    rw [Derivation.map_smul, Algebra.smul_def, map_mul, map_pow, map_neg, map_one]
    ring
  rw [heq]
  exact T.pderiv_mem_range_divergence _ _

/-- The top functional of the differential of a combination of the wedges of the `dx_k` is a
divergence. -/
public theorem topFunctional_deRhamDifferential_mem_of_mem_span {ω : T.forms s}
    (hω : ω ∈ T.wedgeCoordinatesSpan s) :
    T.topFunctional hs (T.deRhamDifferential s ω) ∈ LinearMap.range T.divergence := by
  suffices h : ∀ g : T.D, T.topFunctional hs (T.deRhamDifferential s (g • ω)) ∈
      LinearMap.range T.divergence by
    simpa using h 1
  rw [wedgeCoordinatesSpan] at hω
  induction hω using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨σ, rfl⟩ := hx
    exact fun g ↦ T.topFunctional_deRhamDifferential_smul_ιMulti hs g σ
  | zero =>
    intro g
    rw [smul_zero, map_zero, map_zero]
    exact Submodule.zero_mem _
  | add x y _ _ hx hy =>
    intro g
    rw [smul_add, map_add, map_add]
    exact Submodule.add_mem _ (hx g) (hy g)
  | smul a x _ hx =>
    intro g
    rw [smul_smul]
    exact hx (g * a)

/-- **The top functional of an exact form is a divergence modulo `p^t`**: for every
`ω ∈ Ω^s_{D/A,δ}` and every `t` there are `b ∈ D^r` and `ω' ∈ Ω^s_{D/A,δ}` with
`top(dω) = ∑_k ∂b_k/∂x_k + p^t top(dω')`. -/
public theorem exists_topFunctional_deRhamDifferential_eq (ω : T.forms s) (t : ℕ) :
    ∃ b : Fin T.r → T.D, ∃ ω' : T.forms s,
      T.topFunctional hs (T.deRhamDifferential s ω) =
        T.divergence b + (T.p : T.A) ^ t • T.topFunctional hs (T.deRhamDifferential s ω') := by
  obtain ⟨ω₁, h₁, ω₂, h₂, rfl⟩ := Submodule.mem_sup.mp (T.forms_mem_span_sup s t ω)
  rw [Submodule.ideal_span_singleton_smul, Submodule.mem_smul_pointwise_iff_exists] at h₂
  obtain ⟨ω', -, rfl⟩ := h₂
  obtain ⟨b, hb⟩ := T.topFunctional_deRhamDifferential_mem_of_mem_span hs h₁
  refine ⟨b, ω', ?_⟩
  have hsmul : ((T.p : T.D) ^ t) • ω' = (T.p : T.A) ^ t • ω' := by
    rw [← map_natCast (algebraMap T.A T.D), ← map_pow, algebraMap_smul]
  rw [map_add, map_add, hb, hsmul, map_smul, LinearMap.map_smul_of_tower]

/-! ### The top coefficients -/

/-- The coefficient of `x^m dx_1 ∧ ⋯ ∧ dx_r` of a form in `Ω^r_{D/A,δ}`. -/
public def topCoeffForms (m : Fin T.r →₀ ℕ) : T.forms (s + 1) →ₗ[T.A] T.A :=
  T.monomialCoeff m ∘ₗ (T.topFunctional hs).restrictScalars T.A

/-- The top coefficients are the monomial coefficients of the top functional. -/
public theorem topCoeffForms_apply (m : Fin T.r →₀ ℕ) (ω : T.forms (s + 1)) :
    T.topCoeffForms hs m ω = T.monomialCoeff m (T.topFunctional hs ω) := rfl

/-- The integer `(p ^ k - 1) + 1` is `p ^ k` in `𝐙_p`. -/
private theorem natCast_pow_sub_one_add_one (k : ℕ) :
    ((T.p ^ k - 1 + 1 : ℕ) : T.A) = (T.p : T.A) ^ k := by
  rw [Nat.sub_add_cancel (Nat.one_le_pow _ _ (Fact.out : T.p.Prime).pos)]
  push_cast
  rfl

/-- The coefficient at `m(p^k - 1)` of an exact form of `Ω^r_{D/A,δ}` is divisible by `p^k`. -/
public theorem pow_dvd_topCoeffForms_deRhamDifferential (ω : T.forms s) (k : ℕ) :
    (T.p : T.A) ^ k ∣
      T.topCoeffForms hs (T.diagMonomial (T.p ^ k - 1)) (T.deRhamDifferential s ω) := by
  obtain ⟨b, ω', h⟩ := T.exists_topFunctional_deRhamDifferential_eq hs ω k
  rw [topCoeffForms_apply, h, map_add, map_smul, monomialCoeff_diagMonomial_divergence,
    natCast_pow_sub_one_add_one, smul_eq_mul]
  exact dvd_add (dvd_mul_right _ _) (dvd_mul_right _ _)

/-- For each form of `Ω^s_{D/A,δ}` and each `t`, the coefficient at `m(p^k - 1)` of its
differential is divisible by `p^{k+t}` for all but finitely many `k`. -/
public theorem exists_pow_add_dvd_topCoeffForms_deRhamDifferential (ω : T.forms s) (t : ℕ) :
    ∃ B : ℕ, ∀ k, B ≤ k → (T.p : T.A) ^ (k + t) ∣
      T.topCoeffForms hs (T.diagMonomial (T.p ^ k - 1)) (T.deRhamDifferential s ω) := by
  have hp : T.p.Prime := Fact.out
  obtain ⟨b, ω', h⟩ := T.exists_topFunctional_deRhamDifferential_eq hs ω t
  obtain ⟨B, hB⟩ := T.exists_pow_dvd_monomialCoeff_forall t b
  refine ⟨B, fun k hk ↦ ?_⟩
  have hkN : B ≤ T.p ^ k - 1 := by
    have : k < T.p ^ k := Nat.lt_pow_self hp.one_lt
    omega
  have h' := T.pow_dvd_topCoeffForms_deRhamDifferential hs ω' k
  rw [topCoeffForms_apply] at h'
  rw [topCoeffForms_apply, h, map_add, map_smul, monomialCoeff_diagMonomial_divergence,
    natCast_pow_sub_one_add_one, smul_eq_mul, pow_add]
  refine dvd_add (mul_dvd_mul_left _ (Finset.dvd_sum fun l _ ↦ hB _ hkN l)) ?_
  rw [mul_comm ((T.p : T.A) ^ k)]
  exact mul_dvd_mul_left _ h'

/-- For each form of `Ω^s_{D/A,δ}`, the coefficient at `m(p^k - 1)` of its differential is
divisible by `p^{k+1}` for all but finitely many `k`. -/
public theorem exists_pow_succ_dvd_topCoeffForms_deRhamDifferential (ω : T.forms s) :
    ∃ B : ℕ, ∀ k, B ≤ k → (T.p : T.A) ^ (k + 1) ∣
      T.topCoeffForms hs (T.diagMonomial (T.p ^ k - 1)) (T.deRhamDifferential s ω) :=
  T.exists_pow_add_dvd_topCoeffForms_deRhamDifferential hs ω 1

/-- **The coefficient of `x^m dx_1 ∧ ⋯ ∧ dx_r`** of a form in `Ω^r_D`, the top term of the
complex displayed in [Stacks, Tag 07LK], for `r = s + 1`: the `p`-adic completion of the
coefficient functional on `Ω^r_{D/A,δ}`, read in `𝐙_p`. -/
public def topCoeff (m : Fin T.r →₀ ℕ) : T.completedForms (s + 1) →ₗ[T.A] T.A :=
  (AdicCompletion.ofLinearEquiv T.baseIdeal T.A).symm.toLinearMap ∘ₗ
    (AdicCompletion.map T.baseIdeal (T.topCoeffForms hs m)).restrictScalars T.A

/-- The top coefficient on the dense image of `Ω^r_{D/A,δ}`. -/
@[simp]
public theorem topCoeff_ofForms (m : Fin T.r →₀ ℕ) (ω : T.forms (s + 1)) :
    T.topCoeff hs m (T.ofForms (s + 1) ω) = T.topCoeffForms hs m ω := by
  show (AdicCompletion.ofLinearEquiv T.baseIdeal T.A).symm
      (AdicCompletion.map T.baseIdeal (T.topCoeffForms hs m)
        (AdicCompletion.of T.baseIdeal (T.forms (s + 1)) ω)) = _
  rw [AdicCompletion.map_of, AdicCompletion.ofLinearEquiv_symm_of]

/-- Every element of `Ω^i_D` is the image of an element of `Ω^i_{D/A,δ}` up to `p^t`. -/
public theorem exists_eq_ofForms_add_pow_smul (i : ℕ) (ξ : T.completedForms i) (t : ℕ) :
    ∃ ω : T.forms i, ∃ ξ' : T.completedForms i,
      ξ = T.ofForms i ω + (T.p : T.A) ^ t • ξ' := by
  obtain ⟨ω, hω⟩ := Submodule.Quotient.mk_surjective
    (T.baseIdeal ^ t • (⊤ : Submodule T.A (T.forms i)))
    (AdicCompletion.eval T.baseIdeal (T.forms i) t ξ)
  have hmem : (show AdicCompletion T.baseIdeal (T.forms i) from ξ) -
      AdicCompletion.of T.baseIdeal (T.forms i) ω ∈
      (T.baseIdeal ^ t • ⊤ : Submodule T.A (AdicCompletion T.baseIdeal (T.forms i))) := by
    rw [AdicCompletion.pow_smul_top_eq_ker_eval (Submodule.fg_span_singleton _),
      LinearMap.mem_ker, map_sub, AdicCompletion.eval_of, ← hω, Submodule.mkQ_apply,
      sub_self]
  rw [Ideal.span_singleton_pow, Submodule.ideal_span_singleton_smul,
    Submodule.mem_smul_pointwise_iff_exists] at hmem
  obtain ⟨ξ', -, hξ'⟩ := hmem
  exact ⟨ω, ξ', eq_add_of_sub_eq' hξ'.symm⟩

/-- **The coefficient at `m(p^k - 1)` of an exact form of `Ω^r_D` is divisible by `p^k`.**  Here
`m(N) = (N, …, N)` is the diagonal multi-index, so the coefficient in question is that of
`x_1^{p^k - 1} ⋯ x_r^{p^k - 1} dx_1 ∧ ⋯ ∧ dx_r`. -/
public theorem pow_dvd_topCoeff_completedDifferential (y : T.completedForms s) (k : ℕ) :
    (T.p : T.A) ^ k ∣
      T.topCoeff hs (T.diagMonomial (T.p ^ k - 1)) (T.completedDifferential s y) := by
  obtain ⟨ω, y', rfl⟩ := T.exists_eq_ofForms_add_pow_smul s y k
  rw [map_add, map_smul, map_add, map_smul, T.completedDifferential_ofForms, topCoeff_ofForms,
    smul_eq_mul]
  exact dvd_add (T.pow_dvd_topCoeffForms_deRhamDifferential hs ω k) (dvd_mul_right _ _)

/-- **For each exact form of `Ω^r_D` and each `t`, its coefficient at `m(p^k - 1)` is
divisible by `p^{k+t}` for all but finitely many `k`.** -/
public theorem exists_pow_add_dvd_topCoeff_completedDifferential (y : T.completedForms s)
    (t : ℕ) : ∃ B : ℕ, ∀ k, B ≤ k → (T.p : T.A) ^ (k + t) ∣
      T.topCoeff hs (T.diagMonomial (T.p ^ k - 1)) (T.completedDifferential s y) := by
  obtain ⟨ω, y', rfl⟩ := T.exists_eq_ofForms_add_pow_smul s y t
  obtain ⟨B, hB⟩ := T.exists_pow_add_dvd_topCoeffForms_deRhamDifferential hs ω t
  refine ⟨B, fun k hk ↦ ?_⟩
  rw [map_add, map_smul, map_add, map_smul, T.completedDifferential_ofForms, topCoeff_ofForms,
    smul_eq_mul]
  refine dvd_add (hB k hk) ?_
  rw [pow_add, mul_comm]
  exact mul_dvd_mul_left _ (T.pow_dvd_topCoeff_completedDifferential hs y' k)

/-- **For each exact form of `Ω^r_D`, its coefficient at `m(p^k - 1)` is divisible by
`p^{k+1}` for all but finitely many `k`.** -/
public theorem exists_pow_succ_dvd_topCoeff_completedDifferential (y : T.completedForms s) :
    ∃ B : ℕ, ∀ k, B ≤ k → (T.p : T.A) ^ (k + 1) ∣
      T.topCoeff hs (T.diagMonomial (T.p ^ k - 1)) (T.completedDifferential s y) :=
  T.exists_pow_add_dvd_topCoeff_completedDifferential hs y 1

