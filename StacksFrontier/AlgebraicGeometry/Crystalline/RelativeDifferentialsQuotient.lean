module

public import StacksFrontier.AlgebraicGeometry.AffineDifferentialsIso.Vanishing
public import StacksFrontier.AlgebraicGeometry.Crystalline.DividedPowerRelations
public import StacksFrontier.AlgebraicGeometry.Crystalline.SchemeDifferentials
public import StacksFrontier.AlgebraicGeometry.Morphisms.Differentials.CotangentSheafComparison

/-!
# The divided power differentials as a quotient of the relative differentials

Let `(T, J, δ)` be a divided power scheme and `f : T → Y` a morphism of schemes.  The universal
divided power derivation `d_{T/Y,δ} : 𝒪_T → Ω_{T/Y,δ}` of
`Crystalline.universalDPSchemeDerivation` is in particular a derivation of `𝒪_T` relative to
`f⁻¹𝒪_Y`, so it factors uniquely through the sheaf of relative differentials `Ω_{T/Y}`: there is
exactly one map of `𝒪_T`-modules `Ω_{T/Y} → Ω_{T/Y,δ}` carrying `d_{T/Y}` to `d_{T/Y,δ}`.  This is
the comparison map of [Stacks, Tag 07IY].

Its kernel contains the divided power relations `d (δ_{n+1} x) - δ_n x · d x` for the local
sections `x` of the divided power ideal, since the divided power chain rule holds for
`d_{T/Y,δ}`; those relation sections are compatible with restriction, because the restriction maps
of `𝒪_T` are homomorphisms of divided power rings and the universal derivation is natural.

## Main definitions

* `Crystalline.dpComorphismDerivation` — `d_{T/Y,δ}` read as a derivation along the comorphism of
  `f`, and `Crystalline.dpStructuralDerivation` the same along `f⁻¹𝒪_Y → 𝒪_T`.
* `Crystalline.toDpDifferentials` — the comparison map `Ω_{T/Y} → Ω_{T/Y,δ}`.
* `Crystalline.dpRelationSection` — the divided power relation `d (δ_{n+1} x) - δ_n x · d x` as a
  section of `Ω_{T/Y}`.

## Main results

* `Crystalline.toDpDifferentials_d` — the comparison map carries `d_{T/Y}` to `d_{T/Y,δ}`.
* `Crystalline.toDpDifferentials_unique` — it is the only map of `𝒪_T`-modules doing so.
* `Crystalline.map_dpRelationSection` — the relation sections are stable under restriction.
* `Crystalline.toDpDifferentials_dpRelationSection` — the comparison map kills them.

## Scope

The quasi-coherence assertion of [Stacks, Tag 07IY] is proved downstream, in
`StacksFrontier.AlgebraicGeometry.Crystalline.DifferentialsQuasicoherent`, by identifying
`Ω_{T/Y,δ}` with the cokernel of the subsheaf of `Ω_{T/Y}` generated by the relation sections.
The identification of the sections over an affine open lying over an affine open with
`Ω¹_{Γ(W,𝒪_T)/Γ(V,𝒪_Y),δ}` is not proved, and nothing below carries that tag.

## References

* [Stacks Project, Tag 07IY](https://stacks.math.columbia.edu/tag/07IY)
* [Stacks Project, Tag 08RM](https://stacks.math.columbia.edu/tag/08RM)
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry Opposite TopologicalSpace
open scoped AlgebraicGeometry

universe u

namespace Crystalline

variable (T : DividedPowerScheme.{u}) (Y : Scheme.{u}) (f : T.scheme ⟶ Y)

/-! ### The comparison map -/

/-- The universal divided power derivation read as a derivation of `𝒪_T` along the comorphism of
`f`: a divided power derivation kills every section pulled back from an open of the base. -/
def dpComorphismDerivation : (dpDifferentialsSheaf T Y f).val.Derivation f.c where
  d {W} := AddMonoidHom.mk' (sheafApp T Y f W.unop) (sheafApp_add T Y f W.unop)
  d_mul a b := sheafApp_mul T Y f _ a b
  d_map i x := (sheafApp_naturality T Y f i.unop x).symm
  d_app {V} a := sheafApp_base T Y f _ ⟨V.unop, le_rfl, a,
    congrArg (fun g : Γ(Y, V.unop) ⟶ Γ(T.scheme, f ⁻¹ᵁ V.unop) ↦ ConcreteCategory.hom g a)
      (Scheme.Hom.appLE_eq_app f)⟩

/-- The universal divided power derivation read as a derivation of `𝒪_T` relative to the
structural map `f⁻¹𝒪_Y → 𝒪_T`. -/
def dpStructuralDerivation :
    SheafOfModules.SheafDerivation (inverseImageStructureMap f) (dpDifferentialsSheaf T Y f) :=
  Stacks.AlgebraicGeometry.AffineDifferentialsIso.toStructuralDerivation f _
    (dpComorphismDerivation T Y f)

/-- **The comparison map `Ω_{T/Y} → Ω_{T/Y,δ}`**, the factorization of the universal divided power
derivation through the universal relative derivation. -/
def toDpDifferentials : Scheme.Hom.relativeDifferentials f ⟶ dpDifferentialsSheaf T Y f :=
  (Scheme.Hom.existsUnique_hom_relativeDifferentials f _ (dpStructuralDerivation T Y f)).choose

/-- The comparison map carries the universal relative derivation to the universal divided power
derivation. -/
@[simp]
theorem toDpDifferentials_d (W : T.scheme.Opens) (x : Γ(T.scheme, W)) :
    (toDpDifferentials T Y f).val.app (op W)
        ((Scheme.Hom.universalRelativeDerivation f).d x) = sheafApp T Y f W x :=
  PresheafOfModules.Derivation.congr_d
    (Scheme.Hom.existsUnique_hom_relativeDifferentials f _
      (dpStructuralDerivation T Y f)).choose_spec.1 x

/-- **The comparison map is the only one** carrying the universal relative derivation to the
universal divided power derivation. -/
theorem toDpDifferentials_unique
    (α : Scheme.Hom.relativeDifferentials f ⟶ dpDifferentialsSheaf T Y f)
    (hα : ∀ (W : T.scheme.Opens) (x : Γ(T.scheme, W)),
      α.val.app (op W) ((Scheme.Hom.universalRelativeDerivation f).d x) =
        sheafApp T Y f W x) :
    α = toDpDifferentials T Y f :=
  (Scheme.Hom.existsUnique_hom_relativeDifferentials f _
      (dpStructuralDerivation T Y f)).choose_spec.2 α
    (by
      ext W a
      exact hα W.unop a)

/-! ### The divided power relation sections -/

/-- The sections of the relative differentials over an open, as a module over the ring of
sections of `𝒪_T` there; the two rings are the same, but the scalars of a presheaf of modules are
spelled through the `RingCat`-valued structure sheaf, so the instance is supplied by name. -/
instance relDiffObjModule (W : T.scheme.Opens) :
    Module ↑(T.scheme.sheaf.obj.obj (op W))
      ↥((Scheme.Hom.relativeDifferentials f).val.obj (op W)) :=
  ((Scheme.Hom.relativeDifferentials f).val.obj (op W)).isModule

/-- **The divided power relation** `d (δ_{n+1} x) - δ_n x · d x` of a section `x` of the divided
power ideal over an open, as a section of the relative differentials there. -/
def dpRelationSection (W : T.scheme.Opens)
    (x : ↥(sectionIdeal T.scheme.sheaf T.ideal (op W))) (n : ℕ) :
    ↥((Scheme.Hom.relativeDifferentials f).val.obj (op W)) :=
  dpRelation (T.dividedPowers.dividedPowers (op W))
    (Scheme.Hom.universalRelativeDerivation f).d (x : ↑(T.scheme.sheaf.obj.obj (op W))) n

/-- The relation section, unfolded. -/
theorem dpRelationSection_eq (W : T.scheme.Opens)
    (x : ↥(sectionIdeal T.scheme.sheaf T.ideal (op W))) (n : ℕ) :
    dpRelationSection T Y f W x n = dpRelation (T.dividedPowers.dividedPowers (op W))
      (Scheme.Hom.universalRelativeDerivation f).d
      (x : ↑(T.scheme.sheaf.obj.obj (op W))) n := rfl

/-- A section of `𝒪_T` acts on the relative differentials through the `RingCat`-valued structure
sheaf in the same way. -/
private theorem smul_eq_ringCatSheaf_smul (W : T.scheme.Opens)
    (c : ↑(T.scheme.sheaf.obj.obj (op W)))
    (z : ↥((Scheme.Hom.relativeDifferentials f).val.obj (op W))) :
    c • z = (show ↑(T.scheme.ringCatSheaf.obj.obj (op W)) from c) • z := rfl

/-- **The relation sections are stable under restriction**: the restriction maps of `𝒪_T` commute
with the divided powers and the universal relative derivation is natural. -/
theorem map_dpRelationSection {W W' : T.scheme.Opens} (i : op W ⟶ op W')
    (x : ↥(sectionIdeal T.scheme.sheaf T.ideal (op W))) (n : ℕ) :
    (Scheme.Hom.relativeDifferentials f).val.map i (dpRelationSection T Y f W x n) =
      dpRelationSection T Y f W' (DividedPowerStructure.restrict T.ideal i x) n := by
  have hd (a : ↑(T.scheme.sheaf.obj.obj (op W))) :
      (Scheme.Hom.relativeDifferentials f).val.map i
          ((Scheme.Hom.universalRelativeDerivation f).d a) =
        (Scheme.Hom.universalRelativeDerivation f).d (T.scheme.sheaf.obj.map i a) :=
    ((Scheme.Hom.universalRelativeDerivation f).d_map i a).symm
  have hdp (m : ℕ) :
      T.scheme.sheaf.obj.map i ((T.dividedPowers.dividedPowers (op W)).dpow m x) =
        (T.dividedPowers.dividedPowers (op W')).dpow m (T.scheme.sheaf.obj.map i x) :=
    (T.dividedPowers.naturality i).map_dpow x.2
  have hdpR (m : ℕ) :
      T.scheme.ringCatSheaf.obj.map i ((T.dividedPowers.dividedPowers (op W)).dpow m
          (x : ↑(T.scheme.sheaf.obj.obj (op W)))) =
        (T.dividedPowers.dividedPowers (op W')).dpow m (T.scheme.sheaf.obj.map i x) := hdp m
  rw [dpRelationSection_eq, dpRelationSection_eq, dpRelation_eq, dpRelation_eq, map_sub, hd,
    smul_eq_ringCatSheaf_smul T Y f W, smul_eq_ringCatSheaf_smul T Y f W',
    PresheafOfModules.map_smul, hd, hdp, hdpR]
  rfl

/-- **The comparison map kills the divided power relations**, which is the divided power chain
rule for the universal divided power derivation. -/
theorem toDpDifferentials_dpRelationSection (W : T.scheme.Opens)
    (x : ↥(sectionIdeal T.scheme.sheaf T.ideal (op W))) (n : ℕ) :
    (toDpDifferentials T Y f).val.app (op W) (dpRelationSection T Y f W x n) = 0 := by
  have hsmul (c : ↑(T.scheme.sheaf.obj.obj (op W)))
      (z : ↥((Scheme.Hom.relativeDifferentials f).val.obj (op W))) :
      (toDpDifferentials T Y f).val.app (op W) ((show
          ↑(T.scheme.ringCatSheaf.obj.obj (op W)) from c) • z) =
        (show ↑(T.scheme.ringCatSheaf.obj.obj (op W)) from c) •
          (toDpDifferentials T Y f).val.app (op W) z :=
    map_smul ((toDpDifferentials T Y f).val.app (op W)).hom _ z
  have hd (a : ↑(T.scheme.sheaf.obj.obj (op W))) :
      (toDpDifferentials T Y f).val.app (op W)
          ((Scheme.Hom.universalRelativeDerivation f).d a) = sheafApp T Y f W a :=
    toDpDifferentials_d T Y f W a
  rw [dpRelationSection_eq, dpRelation_eq, map_sub, smul_eq_ringCatSheaf_smul T Y f W, hsmul,
    hd, hd]
  exact sub_eq_zero_of_eq
    (sheafApp_dpow T Y f W n (x : ↑(T.scheme.sheaf.obj.obj (op W))) x.2)

end Crystalline

end
