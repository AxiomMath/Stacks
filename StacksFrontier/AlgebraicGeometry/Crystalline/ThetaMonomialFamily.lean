module

public import Mathlib.Algebra.BigOperators.Finsupp.Basic
public import Mathlib.GroupTheory.Submonoid.Centralizer
public import StacksFrontier.AlgebraicGeometry.Crystalline.CoordinateOperatorsUnique
public import StacksFrontier.RingTheory.AdicCompletion.InverseLimit

/-!
# The two algebraic inputs of the quasi-inverse of [Stacks, Tag 07JH]

The source of the functor of [Stacks, Lemma 60.17.3, Tag 07JG] in the affine algebraic form of
this chapter is `Crystalline.TaylorCrystal`, which carries, beyond the first-order comparison
datum, two pieces of data that the proof of [Stacks, Proposition 60.17.4, Tag 07JH] has to
produce again when it runs the construction backwards, out of a pair `(M, ∇)`:

* the tower of levels `M_e` with the identification `M ≅ lim_e M_e`, which the source reads off
  the objects `T_e = Spec(D_e)`;
* the composite coordinate operators `θ_K = ∏_i θ_i^{k_i}`, which the source reads off `D(2)`.

This module builds both from the four items of the pair alone.

`Crystalline.exists_isThetaMonomialFamily` is the second: a commuting family `θ_i` of self-maps
of `M` admits a family of composite operators in the sense of
`Crystalline.IsThetaMonomialFamily`.  The product `∏_i θ_i^{k_i}` is formed in the submonoid of
`Function.End M` generated by the `θ_i`, which is commutative by
`Submonoid.isMulCommutative_closure`, so `Finsupp.prod` applies and the two clauses of the
predicate are `Finsupp.prod_zero_index` and `Finsupp.prod_add_index'`.  Commutation of the `θ_i`
is item (07JD), integrability, so nothing beyond the items of the pair is used.

`Crystalline.adicLevelLimitEquiv` is the first: an `I`-adically complete module is the inverse
limit of its quotients `M ⧸ I^n M` along the quotient maps, in the form
`Crystalline.invLimit` takes.  Surjectivity of the canonical map is `AdicCompletion.of_surjective`
once the compatibility of a family is upgraded from consecutive indices to all pairs `m ≤ n`,
which is `Submodule.eq_factor_of_eq_factor_succ`; injectivity is Hausdorffness.

`Crystalline.map_add_of_isCoordinateExpansion` is a small third result: the coordinate operators of
a completed connection are additive.  They are not assumed to be, and the `θ_i` of
`Crystalline.Pair.hasCoordinateOperators` are a bare family of functions; additivity follows from
uniqueness of the expansion, since the `j`-th coordinate of `∇ m` modulo `p^n` is `θ_j(m)` by
`Crystalline.completedTensorCoordinateLevel_eq_of_hasSum` and `∇` is additive.

## Main definitions

* `Crystalline.thetaSubmonoid` — the submonoid of `Function.End M` generated by a family of
  self-maps, and `Crystalline.thetaGen` its generators.
* `Crystalline.adicLevel`, `Crystalline.adicLevelTransition` — the tower `M ⧸ I^n M` of a module
  and its transition maps.

## Main results

* `Crystalline.exists_isThetaMonomialFamily` — **a commuting family of coordinate operators has
  composite operators `θ_K = ∏_i θ_i^{k_i}`.**
* `Crystalline.map_add_of_isCoordinateExpansion` — **the coordinate operators of a completed
  connection are additive**, for a basis of `Ω` and a `p`-adically separated module.
* `Crystalline.adicLevelLimitEquiv` — **an `I`-adically complete module is the inverse limit of
  its quotients `M ⧸ I^n M`.**

## References

* [Stacks Project, Proposition 60.17.4, Tag 07JH](https://stacks.math.columbia.edu/tag/07JH)
* [Stacks Project, Lemma 60.17.3, Tag 07JG](https://stacks.math.columbia.edu/tag/07JG)
* [Stacks Project, Tag 07JD](https://stacks.math.columbia.edu/tag/07JD)
-/

@[expose] public section

open scoped IsMulCommutative

universe u v w uI

namespace Crystalline

/-! ### The composite coordinate operators of a commuting family -/

section ThetaMonomial

variable {M : Type w} {ι : Type uI} (theta : ι → (M → M))

/-- **The submonoid of `Function.End M` generated by a family of self-maps.**  When the family
commutes this submonoid is commutative, which is what lets the product `∏_i θ_i^{k_i}` of the
proof of [Stacks, Tag 07JH] be formed as a `Finsupp.prod`. -/
def thetaSubmonoid : Submonoid (Function.End M) :=
  Submonoid.closure (Set.range fun i ↦ (theta i : Function.End M))

/-- The generator `θ_i` of `Crystalline.thetaSubmonoid`. -/
def thetaGen (i : ι) : thetaSubmonoid theta :=
  ⟨theta i, Submonoid.subset_closure ⟨i, rfl⟩⟩

/-- **The submonoid generated by a commuting family is commutative.** -/
theorem thetaSubmonoid_isMulCommutative
    (hcomm : ∀ i j, theta i ∘ theta j = theta j ∘ theta i) :
    IsMulCommutative (thetaSubmonoid theta) := by
  refine Submonoid.isMulCommutative_closure _ ?_
  rintro a ⟨i, rfl⟩ b ⟨j, rfl⟩
  exact hcomm i j

/-- **The composite coordinate operators `θ_K = ∏_i θ_i^{k_i}` exist as soon as the `θ_i`
commute.**

`Crystalline.IsThetaMonomialFamily` is a predicate rather than a definition precisely because the
product is well defined only up to commutation of the factors; this is the statement that
commutation — item (07JD) of [Stacks, Tag 07JG], integrability — is all that is needed.  The
product is formed in `Crystalline.thetaSubmonoid`, commutative by
`Crystalline.thetaSubmonoid_isMulCommutative`, so `Finsupp.prod` is available there, and the two
clauses of the predicate are `Finsupp.prod_zero_index` and `Finsupp.prod_add_index'`. -/
theorem exists_isThetaMonomialFamily
    (hcomm : ∀ i j, theta i ∘ theta j = theta j ∘ theta i) :
    ∃ thetaPow : (ι →₀ ℕ) → (M → M), IsThetaMonomialFamily M theta thetaPow := by
  let := thetaSubmonoid_isMulCommutative theta hcomm
  refine ⟨fun K ↦ ((K.prod fun i k ↦ thetaGen theta i ^ k : thetaSubmonoid theta) :
    Function.End M), ?_, ?_⟩
  · exact congrArg Subtype.val
      (Finsupp.prod_zero_index (h := fun i k ↦ thetaGen theta i ^ k))
  · intro i K
    refine congrArg Subtype.val (?_ : _ = thetaGen theta i * _)
    rw [Finsupp.prod_add_index' (fun a ↦ pow_zero (thetaGen theta a))
      (fun a b₁ b₂ ↦ pow_add (thetaGen theta a) b₁ b₂), mul_comm,
      Finsupp.prod_single_index (h := fun j k ↦ thetaGen theta j ^ k)
        (pow_zero (thetaGen theta i)), pow_one]

end ThetaMonomial

/-! ### Additivity of the coordinate operators -/

section Additive

variable (p : ℕ) (D : Type u) [CommRing D] (Omega : Type v) [AddCommGroup Omega]
  [Module D Omega] (M : Type w) [AddCommGroup M] [Module D M] {ι : Type uI}
  {dx : ι → Omega} {dd : D → Omega} {nabla : CompletedConnection p D Omega dd M}

/-- **The coordinate operators of a completed connection are additive.**

The family `θ` of `Crystalline.Pair.hasCoordinateOperators` is a bare family of functions, with no
additivity assumed.  It is additive all the same: by
`Crystalline.completedTensorCoordinateLevel_eq_of_hasSum` the class of `θ_j(m)` modulo `p^n M` is
the `j`-th coordinate of `∇ m` read at level `n`, a `D`-linear functional of `∇ m`, and `∇` is
additive; so `θ_j(x + y) - θ_j(x) - θ_j(y)` lies in every `p^n M` and `M` is `p`-adically
separated.

The two hypotheses are the source's own: the basis is the uniqueness of the expansion
`∑ f_i d x_i` of [Stacks, Tag 07J9] and separatedness is the Hausdorff half of item (07JB). -/
theorem map_add_of_isCoordinateExpansion {theta : ι → (M → M)}
    (hco : IsCoordinateExpansion p D Omega dx nabla theta) (b : Module.Basis ι D Omega)
    (hdx : ∀ i, dx i = b i) (hM : IsHausdorff (DividedPowers.pAdicIdeal (A := D) p) M)
    (j : ι) (x y : M) : theta j (x + y) = theta j x + theta j y := by
  classical
  refine sub_eq_zero.mp (hM.haus' (theta j (x + y) - (theta j x + theta j y)) fun n ↦ ?_)
  rw [SModEq.zero]
  have hxy := completedTensorCoordinateLevel_eq_of_hasSum p D Omega M hco b hdx j (x + y) n
  have hx := completedTensorCoordinateLevel_eq_of_hasSum p D Omega M hco b hdx j x n
  have hy := completedTensorCoordinateLevel_eq_of_hasSum p D Omega M hco b hdx j y n
  rw [nabla.map_add x y, map_add, hx, hy] at hxy
  have h : Submodule.Quotient.mk (p := pLevel p D M n) (theta j (x + y)) =
      Submodule.Quotient.mk (p := pLevel p D M n) (theta j x + theta j y) := hxy.symm
  rw [Submodule.Quotient.eq] at h
  exact h

end Additive

/-! ### An adically complete module is the limit of its quotients -/

section Levels

variable {R : Type u} [CommRing R] (I : Ideal R) (M : Type w) [AddCommGroup M] [Module R M]

/-- **The level `M ⧸ I^n M` of the `I`-adic tower of a module.** -/
abbrev adicLevel (n : ℕ) : Type w := M ⧸ (I ^ n • ⊤ : Submodule R M)

/-- **The transition map `M ⧸ I^{n+1} M → M ⧸ I^n M` of the `I`-adic tower.** -/
abbrev adicLevelTransition (n : ℕ) : adicLevel I M (n + 1) →ₗ[R] adicLevel I M n :=
  Submodule.factorPow I M (Nat.le_succ n)

/-- **The canonical map from a module to the limit of its `I`-adic tower.** -/
def toAdicLevelLimit : M →ₗ[R] invLimit (adicLevel I M) (adicLevelTransition I M) :=
  LinearMap.codRestrict _ (LinearMap.pi fun n ↦ (I ^ n • ⊤ : Submodule R M).mkQ)
    fun x _ ↦ Submodule.factor_mk _ x

/-- The `n`-th component of `toAdicLevelLimit I M x` is the class of `x` in `M ⧸ I^n M`. -/
@[simp] theorem toAdicLevelLimit_val (x : M) (n : ℕ) :
    (toAdicLevelLimit I M x).val n = Submodule.Quotient.mk (p := I ^ n • ⊤) x := rfl

/-- **A compatible family of quotients is compatible for all pairs of indices.**  The limit
`Crystalline.invLimit` asks only for compatibility along consecutive indices, while
`AdicCompletion` asks for it along every `m ≤ n`; the two agree, by
`Submodule.eq_factor_of_eq_factor_succ`. -/
theorem transitionMap_eq_of_mem_invLimit
    (z : invLimit (adicLevel I M) (adicLevelTransition I M)) {m n : ℕ} (hmn : m ≤ n) :
    AdicCompletion.transitionMap I M hmn (z.val n) = z.val m :=
  (Submodule.eq_factor_of_eq_factor_succ
    (fun _ _ h ↦ Submodule.pow_smul_top_le I M h) z.val
    (fun k ↦ (z.property k).symm) hmn).symm

/-- **An `I`-adically complete module is the inverse limit of its quotients `M ⧸ I^n M`.**

This is the identification `M ≅ lim_e M_e` that `Crystalline.TaylorCrystal` carries, built from
item (07JB) of [Stacks, Tag 07JG] alone: injectivity of the canonical map is Hausdorffness, and
surjectivity is `AdicCompletion.of_surjective` applied to the family, which lies in the completion
by `Crystalline.transitionMap_eq_of_mem_invLimit`. -/
noncomputable def adicLevelLimitEquiv (hM : IsAdicComplete I M) :
    M ≃ₗ[R] invLimit (adicLevel I M) (adicLevelTransition I M) := by
  haveI := hM
  refine LinearEquiv.ofBijective (toAdicLevelLimit I M) ⟨fun x y hxy ↦ ?_, fun z ↦ ?_⟩
  · rw [IsHausdorff.eq_iff_smodEq (I := I)]
    intro n
    exact congrFun (Subtype.ext_iff.mp hxy) n
  · obtain ⟨x, hx⟩ := AdicCompletion.of_surjective I M
      ⟨z.val, fun hmn ↦ transitionMap_eq_of_mem_invLimit I M z hmn⟩
    refine ⟨x, Subtype.ext (funext fun n ↦ ?_)⟩
    exact congrFun (Subtype.ext_iff.mp hx) n

end Levels

end Crystalline

end
