module

public import StacksFrontier.AlgebraicGeometry.Crystalline.EnvelopeRetract

/-!
# The divided power envelope of an ideal which already has compatible divided powers

Let `(A, I, γ)` be a divided power ring, `f : A → B` a ring map and suppose the extended ideal
`J = I B` carries divided powers `δ` for which `f` is a divided power morphism (by
[Stacks, Tag 07H1] this happens for instance when `I` is principal).  Then the divided power
envelope `D_{B, γ}(J)` of [Stacks, Tag 07H8] is `B` itself: the identity of `B` is a map of
ring-ideal pairs into the divided power ring `(B, J, δ)` over `A`, so the universal property gives
`D_{B, γ}(J) → B`, and the canonical map `B → D_{B, γ}(J)` is a divided power morphism because `J`
is generated by the image of `I`, so its composite with the first is the identity of the envelope
by the uniqueness half of the universal property.

## Main definitions

* `Crystalline.DividedPowerEnvelope.equivOfExtension` — the isomorphism `D_{B, γ}(J) ≃ B`.

## Main results

* `Crystalline.DividedPowerEnvelope.equivOfExtension_algebraMap` — it is a retraction of the
  canonical map `B → D_{B, γ}(J)`, and `equivOfExtension_isDPMorphism`,
  `equivOfExtension_symm_isDPMorphism` — it is an isomorphism of divided power rings.

## References

* [Stacks Project, Tag 07H8](https://stacks.math.columbia.edu/tag/07H8)
* [Stacks Project, Tag 07H1](https://stacks.math.columbia.edu/tag/07H1)
-/

@[expose] public section

universe u

namespace Crystalline

namespace DividedPowerEnvelope

variable {A : DividedPowerRing.{u}} {B : Type u} [CommRing B] {f : A →+* B} {J : Ideal B}
  {hJ : A.ideal.map f ≤ J} (E : DividedPowerEnvelope A f J hJ)
  (δ : DividedPowers J) (hf : DividedPowers.IsDPMorphism A.dividedPowers δ f)

/-- The divided power ring `(B, J, δ)`. -/
abbrev extensionRing : DividedPowerRing.{u} := DividedPowerRing.of B J δ

/-- The structure map `A → (B, J, δ)`, a divided power morphism by hypothesis. -/
def extensionStructureMap :
    DividedPowers.DPMorphism A.dividedPowers (extensionRing δ).dividedPowers :=
  DividedPowers.DPMorphism.mk' hf

/-- The divided power morphism `D_{B, γ}(J) → (B, J, δ)` of the universal property applied to the
identity of `B`. -/
noncomputable def extensionRetraction :
    {q : DividedPowers.DPMorphism E.object.dividedPowers (extensionRing δ).dividedPowers //
      q.comp E.structureMap = extensionStructureMap δ hf} :=
  (E.homEquiv (extensionRing δ) (extensionStructureMap δ hf)).symm
    ⟨IdealPair.Hom.ofRingHom (RingHom.id B) (by rw [Ideal.map_id]),
      IdealPair.Hom.ext_toRingHom _ _ rfl⟩

/-- The retraction restricts to the identity on `B`. -/
theorem extensionRetraction_algebraMap (x : B) :
    (extensionRetraction E δ hf).1.toRingHom (E.algebraMap.toRingHom x) = x := by
  have hsymm := (E.homEquiv (extensionRing δ) (extensionStructureMap δ hf)).apply_symm_apply
    ⟨IdealPair.Hom.ofRingHom (RingHom.id B) (by rw [Ideal.map_id]),
      IdealPair.Hom.ext_toRingHom _ _ rfl⟩
  exact congrArg (fun z : IdealPair.Hom J (extensionRing δ).ideal ↦ z.toRingHom x)
    ((E.homEquiv_apply (extensionRing δ) (extensionStructureMap δ hf)
      (extensionRetraction E δ hf)).symm.trans (congrArg Subtype.val hsymm))

/-- The canonical map `B → D_{B, γ}(J)` is a divided power morphism for `δ`: the ideal `J` is
generated by the image of `I`, on which the map is the structure map of the envelope. -/
theorem algebraMap_isDPMorphism (hJf : J = A.ideal.map f)
    (hf : DividedPowers.IsDPMorphism A.dividedPowers δ f) :
    DividedPowers.IsDPMorphism δ E.object.dividedPowers E.algebraMap.toRingHom :=
  DividedPowers.IsDPMorphism.of_comp A.dividedPowers δ E.object.dividedPowers f
    E.algebraMap.toRingHom hJf hf (E.algebraMap_comp ▸ E.structureMap.isDPMorphism)

/-- **The envelope of an ideal which already has compatible divided powers is the ring itself.**
-/
noncomputable def equivOfExtension (hJf : J = A.ideal.map f) : E.object ≃+* B :=
  RingEquiv.ofRingHom (extensionRetraction E δ hf).1.toRingHom E.algebraMap.toRingHom
    (RingHom.ext fun x ↦ extensionRetraction_algebraMap E δ hf x)
    (congrArg DividedPowers.DPMorphism.toRingHom <| envelopeHom_ext E E.object
      ((DividedPowers.DPMorphism.mk' (algebraMap_isDPMorphism E δ hJf hf)).comp
        (extensionRetraction E δ hf).1) (DividedPowers.DPMorphism.id E.object.dividedPowers)
      (by
        apply DividedPowers.DPMorphism.ext
        ext a
        change E.algebraMap.toRingHom ((extensionRetraction E δ hf).1.toRingHom
          (E.structureMap.toRingHom a)) = E.structureMap.toRingHom a
        rw [← E.algebraMap_comp, RingHom.comp_apply, extensionRetraction_algebraMap])
      (RingHom.ext fun x ↦
        congrArg E.algebraMap.toRingHom (extensionRetraction_algebraMap E δ hf x)))

/-- The isomorphism `D_{B, γ}(J) ≃ B` is a retraction of the canonical map `B → D_{B, γ}(J)`. -/
@[simp] theorem equivOfExtension_algebraMap (hJf : J = A.ideal.map f) (x : B) :
    equivOfExtension E δ hf hJf (E.algebraMap.toRingHom x) = x :=
  extensionRetraction_algebraMap E δ hf x

/-- The inverse of `D_{B, γ}(J) ≃ B` is the canonical map `B → D_{B, γ}(J)`. -/
@[simp] theorem equivOfExtension_symm_apply (hJf : J = A.ideal.map f) (x : B) :
    (equivOfExtension E δ hf hJf).symm x = E.algebraMap.toRingHom x := rfl

/-- The isomorphism `D_{B, γ}(J) ≃ B` is a divided power morphism. -/
theorem equivOfExtension_isDPMorphism (hJf : J = A.ideal.map f) :
    DividedPowers.IsDPMorphism E.object.dividedPowers δ (equivOfExtension E δ hf hJf).toRingHom :=
  (extensionRetraction E δ hf).1.isDPMorphism

/-- The inverse isomorphism `B ≃ D_{B, γ}(J)` is a divided power morphism. -/
theorem equivOfExtension_symm_isDPMorphism (hJf : J = A.ideal.map f) :
    DividedPowers.IsDPMorphism δ E.object.dividedPowers
      (equivOfExtension E δ hf hJf).symm.toRingHom :=
  algebraMap_isDPMorphism E δ hJf hf

/-- The isomorphism `D_{B, γ}(J) ≃ B` is compatible with the structure maps from `A`. -/
theorem equivOfExtension_structureMap (hJf : J = A.ideal.map f) (a : A) :
    equivOfExtension E δ hf hJf (E.structureMap.toRingHom a) = f a := by
  rw [← E.algebraMap_comp, RingHom.comp_apply, equivOfExtension_algebraMap]

end DividedPowerEnvelope

end Crystalline

end
