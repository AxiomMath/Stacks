-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace
open scoped AlgebraicGeometry

universe w u

noncomputable section

namespace Crystalline.GlobalCrystallineSituation.SmallSite

namespace CrystallineThickening

variable {S : GlobalCrystallineSituation.{u}}

/-! ### Restriction to the whole ambient scheme -/

/-- **The restriction of an object of `Cris(X/S)` to the whole of its ambient scheme is that
object.**  This is the small-site form of
`Crystalline.GlobalCrystallineSituation.Thickening.isIso_restrictOpenHom_top`, transported along
the fully faithful inclusion `Cris(X/S) ⥤ CRIS(X/S)`. -/
theorem isIso_restrictOpenHom_top (A : CrystallineThickening S) :
    IsIso (A.restrictOpenHom (⊤ : A.obj.thickening.target.scheme.Opens)) :=
  have : IsIso ((CrystallineThickening.ι S).map
      (A.restrictOpenHom (⊤ : A.obj.thickening.target.scheme.Opens))) :=
    A.obj.isIso_restrictOpenHom_top
  isIso_of_fully_faithful (CrystallineThickening.ι S) _

/-- **The restriction of an object of `Cris(X/S)` to an open equal to the whole ambient scheme is
that object.** -/
theorem isIso_restrictOpenHom_of_eq_top (A : CrystallineThickening S)
    {V : A.obj.thickening.target.scheme.Opens} (hV : V = ⊤) : IsIso (A.restrictOpenHom V) := by
  subst hV
  exact isIso_restrictOpenHom_top A

/-- **The identification of an object of `Cris(X/S)` with its restriction to the whole of its
ambient scheme**, given by the structure morphism of that restriction. -/
def isoRestrictOpenTop (A : CrystallineThickening S) :
    A.restrictOpen (⊤ : A.obj.thickening.target.scheme.Opens) ≅ A :=
  haveI := isIso_restrictOpenHom_top A
  asIso (A.restrictOpenHom (⊤ : A.obj.thickening.target.scheme.Opens))

/-- The forward map of `isoRestrictOpenTop A` is the structure morphism of the restriction of `A`
to the whole of its ambient scheme. -/
@[simp]
theorem isoRestrictOpenTop_hom (A : CrystallineThickening S) :
    (isoRestrictOpenTop A).hom = A.restrictOpenHom (⊤ : A.obj.thickening.target.scheme.Opens) :=
  rfl

/-! ### Restriction of a restriction -/

/-- **The restriction of `A|_W` to the preimage of an open `V ≤ W` is `A|_V`.**  The structure
morphism `A|_W ⟶ A` is a Cartesian open immersion with image `W`, so restricting it over an open
inside `W` is an isomorphism. -/
theorem isIso_restrictOpenMap_restrictOpenHom (A : CrystallineThickening S)
    {V W : A.obj.thickening.target.scheme.Opens} (h : V ≤ W) :
    IsIso (restrictOpenMap (A.restrictOpenHom W) V) :=
  have : IsIso ((CrystallineThickening.ι S).map (restrictOpenMap (A.restrictOpenHom W) V)) :=
    Thickening.isIso_restrictOpenMap (A.obj.restrictOpenHom W)
      (A.obj.isCartesian_restrictOpenHom W) V
      (h.trans (Thickening.restrictOpenHom_targetHom_opensRange A.obj W).ge)
  isIso_of_fully_faithful (CrystallineThickening.ι S) _

/-- **Restricting `A|_W` to the preimage of an open `V ≤ W` and then including `A|_V` into `A|_W`
is the structure morphism of that restriction of `A|_W`.** -/
@[reassoc]
theorem restrictOpenMap_restrictOpenLE (A : CrystallineThickening S)
    {V W : A.obj.thickening.target.scheme.Opens} (h : V ≤ W) :
    restrictOpenMap (A.restrictOpenHom W) V ≫ restrictOpenLE A h =
      (A.restrictOpen W).restrictOpenHom ((A.restrictOpenHom W).hom.targetHom.hom ⁻¹ᵁ V) := by
  rw [← cancel_mono (A.restrictOpenHom W), Category.assoc, restrictOpenLE_restrictOpenHom,
    restrictOpenMap_restrictOpenHom]

/-- **The restriction of a restriction, as an isomorphism:** for opens `V ≤ W` of the ambient
scheme of `A`, the restriction of `A|_W` to the preimage of `V` is `A|_V`. -/
def isoRestrictOpenRestrictOpen (A : CrystallineThickening S)
    {V W : A.obj.thickening.target.scheme.Opens} (h : V ≤ W) :
    (A.restrictOpen W).restrictOpen ((A.restrictOpenHom W).hom.targetHom.hom ⁻¹ᵁ V) ≅
      A.restrictOpen V :=
  haveI := isIso_restrictOpenMap_restrictOpenHom A h
  asIso (restrictOpenMap (A.restrictOpenHom W) V)

/-- The forward map of `isoRestrictOpenRestrictOpen A h` is `restrictOpenMap` of the structure
morphism `A|_W ⟶ A` over `V`. -/
@[simp]
theorem isoRestrictOpenRestrictOpen_hom (A : CrystallineThickening S)
    {V W : A.obj.thickening.target.scheme.Opens} (h : V ≤ W) :
    (isoRestrictOpenRestrictOpen A h).hom = restrictOpenMap (A.restrictOpenHom W) V :=
  rfl

/-- **The identification of the restriction of `A|_W` to the preimage of `V` with `A|_V` composes
with `restrictOpenLE` to the structure morphism of that restriction of `A|_W`.** -/
@[reassoc]
theorem isoRestrictOpenRestrictOpen_hom_restrictOpenLE (A : CrystallineThickening S)
    {V W : A.obj.thickening.target.scheme.Opens} (h : V ≤ W) :
    (isoRestrictOpenRestrictOpen A h).hom ≫ restrictOpenLE A h =
      (A.restrictOpen W).restrictOpenHom ((A.restrictOpenHom W).hom.targetHom.hom ⁻¹ᵁ V) :=
  restrictOpenMap_restrictOpenLE A h

/-! ### Pullback of a restriction along an arbitrary morphism -/

/-- **A restriction pulls back along an arbitrary morphism of `Cris(X/S)` to a restriction.**  For
`g : B ⟶ A` and an open `V` of the ambient scheme of `A`, the fibre product of `A|_V ⟶ A` with `g`
is `B|_{g⁻¹V}`: a morphism into `B` whose composite with `g` factors through `A|_V` has ambient
image inside `g⁻¹V`, hence factors through `B|_{g⁻¹V}`, uniquely because the structure morphism of
a restriction is a monomorphism. -/
theorem isPullback_restrictOpenMap {A B : CrystallineThickening S} (g : B ⟶ A)
    (V : A.obj.thickening.target.scheme.Opens) :
    IsPullback (restrictOpenMap g V) (B.restrictOpenHom (g.hom.targetHom.hom ⁻¹ᵁ V))
      (A.restrictOpenHom V) g := by
  have key : ∀ s : PullbackCone (A.restrictOpenHom V) g,
      ∃ p : s.pt ⟶ B.restrictOpen (g.hom.targetHom.hom ⁻¹ᵁ V),
        p ≫ B.restrictOpenHom (g.hom.targetHom.hom ⁻¹ᵁ V) = s.snd := fun s ↦ by
    refine exists_comp_restrictOpenHom_eq _ _ fun x ↦ ?_
    have hx : (s.fst ≫ A.restrictOpenHom V).hom.targetHom.hom.base x ∈ V :=
      Thickening.comp_restrictOpenHom_targetHom_base_mem V s.fst.hom x
    rw [s.condition] at hx
    exact hx
  refine IsPullback.of_isLimit (PullbackCone.IsLimit.mk (restrictOpenMap_restrictOpenHom g V)
    (fun s ↦ (key s).choose) (fun s ↦ ?_) (fun s ↦ (key s).choose_spec) (fun s m _ hm₂ ↦ ?_))
  · refine (cancel_mono (A.restrictOpenHom V)).1 ?_
    rw [Category.assoc, restrictOpenMap_restrictOpenHom, ← Category.assoc, (key s).choose_spec,
      s.condition]
  · exact (cancel_mono (B.restrictOpenHom (g.hom.targetHom.hom ⁻¹ᵁ V))).1
      (hm₂.trans (key s).choose_spec.symm)

/-- **The fibre product of a restriction with an arbitrary morphism of `Cris(X/S)` exists.** -/
instance hasPullback_restrictOpenHom {A B : CrystallineThickening S}
    (V : A.obj.thickening.target.scheme.Opens) (g : B ⟶ A) :
    HasPullback (A.restrictOpenHom V) g :=
  (isPullback_restrictOpenMap g V).hasPullback

/-! ### Finite products of restrictions in the slice -/

section Products

variable (A : CrystallineThickening S)

/-- The fan of restrictions of `A` to a family of opens of its ambient scheme, with vertex the
restriction of `A` to the intersection of the family, inside the slice category `Over A`. -/
def restrictOpenFan {ι : Type w} (V : ι → A.obj.thickening.target.scheme.Opens) :
    Fan fun a ↦ Over.mk (A.restrictOpenHom (V a)) :=
  Fan.mk (Over.mk (A.restrictOpenHom (⨅ a, V a))) fun a ↦
    Over.homMk (restrictOpenLE A (iInf_le V a)) (restrictOpenLE_restrictOpenHom A _)

/-- The vertex of `restrictOpenFan A V` is the restriction of `A` to the intersection of the
family `V`, as an object of `Over A`. -/
@[simp]
theorem restrictOpenFan_pt {ι : Type w} (V : ι → A.obj.thickening.target.scheme.Opens) :
    (restrictOpenFan A V).pt = Over.mk (A.restrictOpenHom (⨅ a, V a)) :=
  rfl

/-- The projection of `restrictOpenFan A V` onto its `a`-th member is the inclusion
`restrictOpenLE` of the restriction to the intersection into the restriction to `V a`. -/
@[simp]
theorem restrictOpenFan_proj {ι : Type w} (V : ι → A.obj.thickening.target.scheme.Opens) (a : ι) :
    ((restrictOpenFan A V).proj a).left = restrictOpenLE A (iInf_le V a) :=
  rfl

/-- **The restriction of `A` to the intersection of a finite family of opens of its ambient scheme
is the product, in the slice `Over A`, of the restrictions to the members of the family.**  A
morphism into `A` whose ambient image lies in every member lies in the intersection, hence factors
through the restriction to it; the factorization is unique because the structure morphism of a
restriction is a monomorphism.  The empty family is allowed: the intersection is then the whole
ambient scheme, and the statement is `isIso_restrictOpenHom_top`. -/
def isLimit_restrictOpenFan {ι : Type w} [Finite ι]
    (V : ι → A.obj.thickening.target.scheme.Opens) : IsLimit (restrictOpenFan A V) := by
  have hw : ∀ (s : Fan fun a ↦ Over.mk (A.restrictOpenHom (V a))) (a : ι),
      (s.proj a).left ≫ A.restrictOpenHom (V a) = s.pt.hom := fun s a ↦ Over.w (s.proj a)
  have key : ∀ s : Fan fun a ↦ Over.mk (A.restrictOpenHom (V a)),
      ∃ p : s.pt.left ⟶ A.restrictOpen (⨅ a, V a),
        p ≫ A.restrictOpenHom (⨅ a, V a) = s.pt.hom := fun s ↦ by
    refine exists_comp_restrictOpenHom_eq _ _ fun x ↦ ?_
    have hmem : ∀ a : ι, s.pt.hom.hom.targetHom.hom.base x ∈ V a := fun a ↦ by
      have hx : ((s.proj a).left ≫ A.restrictOpenHom (V a)).hom.targetHom.hom.base x ∈ V a :=
        Thickening.comp_restrictOpenHom_targetHom_base_mem (V a) (s.proj a).left.hom x
      rwa [hw s a] at hx
    have hx : s.pt.hom.hom.targetHom.hom.base x ∈ ⋂ a : ι, (V a : Set _) :=
      Set.mem_iInter.2 hmem
    rwa [← Opens.coe_iInf V] at hx
  refine Fan.IsLimit.mk (restrictOpenFan A V)
    (fun s ↦ Over.homMk (key s).choose (key s).choose_spec)
    (fun s a ↦ ?_) (fun s m _ ↦ ?_)
  · refine Over.OverMorphism.ext ?_
    change (key s).choose ≫ restrictOpenLE A (iInf_le V a) = (s.proj a).left
    refine (cancel_mono (A.restrictOpenHom (V a))).1 ?_
    rw [Category.assoc, restrictOpenLE_restrictOpenHom, (key s).choose_spec, hw s a]
  · refine Over.OverMorphism.ext ?_
    change m.left = (key s).choose
    refine (cancel_mono (A.restrictOpenHom (⨅ a, V a))).1 ?_
    rw [(key s).choose_spec]
    exact Over.w m

/-- **The product in `Over A` of the restrictions of `A` to a finite family of opens of its ambient
scheme exists.** -/
theorem hasProduct_restrictOpenHom {ι : Type w} [Finite ι]
    (V : ι → A.obj.thickening.target.scheme.Opens) :
    HasProduct fun a ↦ Over.mk (A.restrictOpenHom (V a)) :=
  HasLimit.mk ⟨_, isLimit_restrictOpenFan A V⟩

/-- **Any product in `Over A` of the restrictions of `A` to a finite family of opens of its
ambient scheme is the restriction of `A` to the intersection of the family.** -/
def isoRestrictOpenIInf {ι : Type w} [Finite ι]
    (V : ι → A.obj.thickening.target.scheme.Opens)
    {c : Fan fun a ↦ Over.mk (A.restrictOpenHom (V a))} (hc : IsLimit c) :
    c.pt ≅ Over.mk (A.restrictOpenHom (⨅ a, V a)) :=
  hc.conePointUniqueUpToIso (isLimit_restrictOpenFan A V)

/-- **The domain of any product in `Over A` of the restrictions of `A` to a finite family of opens
of its ambient scheme is the restriction of `A` to the intersection of the family.** -/
def leftIsoRestrictOpenIInf {ι : Type w} [Finite ι]
    (V : ι → A.obj.thickening.target.scheme.Opens)
    {c : Fan fun a ↦ Over.mk (A.restrictOpenHom (V a))} (hc : IsLimit c) :
    c.pt.left ≅ A.restrictOpen (⨅ a, V a) :=
  (Over.forget A).mapIso (isoRestrictOpenIInf A V hc)

/-- **The iterated fibre products of a family of restrictions of `A` exist**, in the shape the
Čech complex of [Stacks, Tag 03AM] and the criterion of [Stacks, Tag 03F9] take them: the finite
products, in `Over A`, of the members of the covering family `restrictOpenCover`.  Here the
existence is obtained from `hasPullback_restrictOpenHom` through
`Stacks.Sites.hasProduct_fibreProducts`, which is the route available for an arbitrary covering
family; `isLimit_restrictOpenFan` gives the same conclusion for restrictions together with the
identification of the product. -/
theorem hasProduct_restrictOpenCover {ι : Type (u + 1)}
    (V : ι → A.obj.thickening.target.scheme.Opens) (n : ℕ) (i : Fin (n + 1) → ι) :
    HasProduct fun a ↦ Over.mk ((A.restrictOpenCover V).f (i a)) :=
  Stacks.Sites.hasProduct_fibreProducts (A.restrictOpenCover V)
    (fun j _ g ↦ hasPullback_restrictOpenHom (V j) g) n i

/-- **The ambient scheme of the restriction of an object of `Cris(X/S)` to an affine open of its
ambient scheme is affine**, being that open subscheme.  Composed with
`AlgebraicGeometry.IsAffineOpen.iInf` and `leftIsoRestrictOpenIInf` this makes the domain of a
finite product of restrictions to affine opens of a separated ambient scheme affine. -/
theorem isAffine_restrictOpen {V : A.obj.thickening.target.scheme.Opens} (hV : IsAffineOpen V) :
    IsAffine (A.restrictOpen V).obj.thickening.target.scheme :=
  hV

end Products

end CrystallineThickening

end Crystalline.GlobalCrystallineSituation.SmallSite

end

