-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite TopologicalSpace
open scoped AlgebraicGeometry

universe w t u

noncomputable section

namespace Stacks.CechSite

/-! ### Two pieces of general nonsense -/

/-- A natural isomorphism of presheaves induces one of the functors they become under
`CategoryTheory.Functor.rightOp`. -/
def natIsoRightOp {C : Type*} [Category* C] {D : Type*} [Category* D] {F G : Cᵒᵖ ⥤ D}
    (η : F ≅ G) : F.rightOp ≅ G.rightOp where
  hom := NatTrans.rightOp η.inv
  inv := NatTrans.rightOp η.hom
  hom_inv_id := by rw [← NatTrans.rightOp_comp, η.hom_inv_id, NatTrans.rightOp_id]
  inv_hom_id := by rw [← NatTrans.rightOp_comp, η.inv_hom_id, NatTrans.rightOp_id]

/-- **A functor between categories induces one between their categories of formal coproducts**,
acting on the components and leaving the index type alone. -/
@[simps]
def formalCoproductMap {D : Type*} [Category* D] {C : Type*} [Category* C] (Φ : D ⥤ C) :
    FormalCoproduct.{w} D ⥤ FormalCoproduct.{w} C where
  obj Y := ⟨Y.I, fun i ↦ Φ.obj (Y.obj i)⟩
  map f := ⟨f.f, fun i ↦ Φ.map (f.φ i)⟩
  map_id _ := FormalCoproduct.hom_ext rfl fun i ↦ by simp
  map_comp _ _ := FormalCoproduct.hom_ext rfl fun i ↦ by simp

/-- **Evaluating a presheaf on the formal coproducts of a category, after pushing the components
along a functor `Φ`, is evaluating the restriction of the presheaf along `Φ`.**  Both sides are
the product, over the index type, of the values of the presheaf on the images of the
components. -/
def evalOpFormalCoproductMapIso {D : Type*} [Category* D] {C : Type*} [Category* C] (Φ : D ⥤ C)
    {A : Type*} [Category* A] [Limits.HasProducts.{w} A] (P : Cᵒᵖ ⥤ A) :
    (formalCoproductMap.{w} Φ).op ⋙ (FormalCoproduct.evalOp.{w} C A).obj P ≅
      (FormalCoproduct.evalOp.{w} D A).obj (Φ.op ⋙ P) :=
  Iso.refl _

end Stacks.CechSite

namespace Crystalline.GlobalCrystallineSituation.SmallSite

variable {S : GlobalCrystallineSituation.{u}}

/-! ### Products of opens -/

/-- **A categorical product of opens of a scheme is their infimum.**  The two are isomorphic in
the thin category `X.Opens`, hence equal, the opens of a space being partially ordered. -/
theorem pi_opens_eq_iInf {X : Scheme.{u}} {α : Type w} (V : α → X.Opens) [HasProduct V] :
    ∏ᶜ V = ⨅ a, V a :=
  le_antisymm (le_iInf fun a ↦ leOfHom (Pi.π V a))
    (leOfHom (Pi.lift fun a ↦ homOfLE (iInf_le V a)))

namespace CrystallineThickening

/-! ### Restrictions as a thin part of the slice -/

/-- **Any two morphisms of `Over A` into the restriction of `A` to an open of its ambient scheme
are equal.**  The structure morphism of a restriction is a monomorphism, so a morphism over `A`
into it is determined by the triangle it fills.  Everything in this file that needs a naturality
square in `Over A` whose target is a restriction gets it from here. -/
theorem subsingleton_overHom_restrictOpen (A : CrystallineThickening S)
    (V : A.obj.thickening.target.scheme.Opens) (Y : Over A) :
    Subsingleton (Y ⟶ Over.mk (A.restrictOpenHom V)) :=
  ⟨fun f g ↦ Over.OverMorphism.ext
    ((cancel_mono (A.restrictOpenHom V)).1 ((Over.w f).trans (Over.w g).symm))⟩

/-- **The restriction of `A` to an open of its ambient scheme is a subterminal object of
`Over A`.**  This is `subsingleton_overHom_restrictOpen` in the form the alternating Čech
theory of a family in a category asks for it: the hypothesis `hU` of
`Stacks.CategoryTheory.CechComplex.Alternating.tres_congr_of_isSubterminal` of
`StacksFrontier/CategoryTheory/Sites/CechComplexAlternating.lean`, which is what makes the
alternating Čech cochains of a covering family a subcomplex.  So the members of the
restriction covering of an object of `Cris(X/S)` satisfy that hypothesis. -/
theorem isSubterminal_overMk_restrictOpenHom (A : CrystallineThickening S)
    (V : A.obj.thickening.target.scheme.Opens) :
    IsSubterminal (Over.mk (A.restrictOpenHom V)) :=
  fun Y f g ↦ (subsingleton_overHom_restrictOpen A V Y).elim f g

/-- **The restrictions of an object of `Cris(X/S)` to the opens of its ambient scheme, as a
functor to the slice `Over A`.**  This is `restrictOpenFunctor` lifted along `Over.forget A`; the
functor laws are automatic by `subsingleton_overHom_restrictOpen`. -/
def restrictOpenOverFunctor (A : CrystallineThickening S) :
    A.obj.thickening.target.scheme.Opens ⥤ Over A where
  obj W := Over.mk (A.restrictOpenHom W)
  map i := Over.homMk (restrictOpenLE A i.le) (restrictOpenLE_restrictOpenHom A i.le)
  map_id _ := (subsingleton_overHom_restrictOpen A _ _).elim _ _
  map_comp _ _ := (subsingleton_overHom_restrictOpen A _ _).elim _ _

/-- The functor `restrictOpenOverFunctor A` sends an open `W` of the ambient scheme to the
restriction of `A` to `W`, regarded as an object of `Over A` via `restrictOpenHom`. -/
@[simp]
theorem restrictOpenOverFunctor_obj (A : CrystallineThickening S)
    (W : A.obj.thickening.target.scheme.Opens) :
    (restrictOpenOverFunctor A).obj W = Over.mk (A.restrictOpenHom W) :=
  rfl

/-- **The restrictions to the opens of the ambient scheme, read in `Over A` and then forgotten,
are `restrictOpenFunctor`.** -/
theorem restrictOpenOverFunctor_comp_forget (A : CrystallineThickening S) :
    restrictOpenOverFunctor A ⋙ Over.forget A = restrictOpenFunctor A :=
  rfl

/-! ### The family of restrictions as a covering family -/

/-- **The family of restrictions of an object of `Cris(X/S)` to a family of opens of its ambient
scheme**, at an arbitrary index universe.  For `ι : Type (u + 1)` this is `restrictOpenCover`,
the shape in which `restrictCoverage` produces the covering families of the small crystalline
site; the index universe is free here because the coefficient category of the Zariski Čech
complex on the ambient scheme is `AddCommGrpCat.{u}`, which has only `Type u`-indexed products. -/
def restrictOpenHypercover (A : CrystallineThickening S) {ι : Type w}
    (V : ι → A.obj.thickening.target.scheme.Opens) : PreZeroHypercover.{w} A where
  I₀ := ι
  X i := A.restrictOpen (V i)
  f i := A.restrictOpenHom (V i)

/-- At the index universe `u + 1` the family of restrictions is `restrictOpenCover`, which is
what `restrictCoverage` produces. -/
theorem restrictOpenHypercover_eq_restrictOpenCover (A : CrystallineThickening S)
    {ι : Type (u + 1)} (V : ι → A.obj.thickening.target.scheme.Opens) :
    restrictOpenHypercover A V = A.restrictOpenCover V :=
  rfl

/-- `hasProduct_restrictOpenHom` as an instance, in the shape the Čech machinery asks for it:
the finite products of restrictions of `A`, taken in `Over A`, exist. -/
instance hasProduct_overMk_restrictOpenHom (A : CrystallineThickening S) {α : Type t} [Finite α]
    (W : α → A.obj.thickening.target.scheme.Opens) :
    HasProduct fun a ↦ Over.mk (A.restrictOpenHom (W a)) :=
  hasProduct_restrictOpenHom A W

/-- The same instance, in the spelling the Čech machinery of a `PreZeroHypercover` asks for. -/
instance hasProduct_restrictOpenHypercover (A : CrystallineThickening S) {ι : Type w}
    (V : ι → A.obj.thickening.target.scheme.Opens) {α : Type t} [Finite α]
    (i : α → (restrictOpenHypercover A V).I₀) :
    HasProduct fun a ↦ Over.mk ((restrictOpenHypercover A V).f (i a)) :=
  hasProduct_restrictOpenHom A fun a ↦ V (i a)

/-! ### The degreewise identification -/

section Degreewise

variable (A : CrystallineThickening S) {ι : Type w}
  (V : ι → A.obj.thickening.target.scheme.Opens)

/-- The fan of the restrictions of `A` to a tuple of members of a family of opens of its ambient
scheme, with vertex the restriction of `A` to the *categorical* product of those opens inside
`T.Opens`.  This is `restrictOpenFan` with the infimum replaced by the product, which is the
spelling the Čech complex of a family of opens uses. -/
def restrictOpenPiFan {α : Type t} (i : α → ι) [HasProduct fun a ↦ V (i a)] :
    Fan fun a ↦ Over.mk (A.restrictOpenHom (V (i a))) :=
  Fan.mk ((restrictOpenOverFunctor A).obj (∏ᶜ fun a ↦ V (i a)))
    fun a ↦ (restrictOpenOverFunctor A).map (Pi.π (fun b ↦ V (i b)) a)

/-- **The restriction of `A` to the categorical product of a finite tuple of opens of its ambient
scheme is the product, in `Over A`, of the restrictions to the members of the tuple.**  This is
`isLimit_restrictOpenFan` transported along `pi_opens_eq_iInf`; the transport costs nothing
because all parallel morphisms of `Over A` into a restriction agree. -/
def isLimit_restrictOpenPiFan {α : Type t} [Finite α] (i : α → ι)
    [HasProduct fun a ↦ V (i a)] : IsLimit (restrictOpenPiFan A V i) :=
  (isLimit_restrictOpenFan A fun a ↦ V (i a)).ofIsoLimit
    (Cone.ext (eqToIso (congrArg (fun W ↦ Over.mk (A.restrictOpenHom W))
        (pi_opens_eq_iInf fun a ↦ V (i a)).symm))
      fun _ ↦ (subsingleton_overHom_restrictOpen A _ _).elim _ _)

/-- **The degreewise comparison:** the product, in `Over A`, of the restrictions of `A` to a
finite tuple of members of a family of opens of its ambient scheme is the restriction of `A` to
the product of that tuple of opens. -/
def restrictOpenPiIso {α : Type t} [Finite α] (i : α → ι) [HasProduct fun a ↦ V (i a)] :
    (∏ᶜ fun a ↦ Over.mk (A.restrictOpenHom (V (i a)))) ≅
      (restrictOpenOverFunctor A).obj (∏ᶜ fun a ↦ V (i a)) :=
  (productIsProduct _).conePointUniqueUpToIso (isLimit_restrictOpenPiFan A V i)

/-- **Degreewise identification of the Čech formal coproducts.**  The formal coproduct of the
iterated fibre products of the restriction cover is the image, under `restrictOpenOverFunctor`,
of the formal coproduct of the iterated intersections of the open cover. -/
def cechFormalCoproductRestrictIso (α : Type) [Finite α] :
    Stacks.CechSite.cechFormalCoproduct (restrictOpenHypercover A V) α ≅
      (Stacks.CechSite.formalCoproductMap.{w} (restrictOpenOverFunctor A)).obj
        ((FormalCoproduct.mk ι V).power α) :=
  FormalCoproduct.isoOfComponents (Equiv.refl _) fun i ↦ restrictOpenPiIso A V i

/-- **The degreewise identifications are natural in the simplicial degree.**  The naturality is
free: both structure maps act on the index type by composition with the simplicial operator, and
their components are morphisms of `Over A` into a restriction of `A`, of which there is at most
one.  This is the compatibility with the Čech differential. -/
theorem cechFormalCoproductRestrictIso_naturality {n m : SimplexCategoryᵒᵖ} (g : n ⟶ m) :
    (Stacks.CechSite.cechSimplicialObject (restrictOpenHypercover A V)).map g ≫
        (cechFormalCoproductRestrictIso A V (ToType m.unop)).hom =
      (cechFormalCoproductRestrictIso A V (ToType n.unop)).hom ≫
        (Stacks.CechSite.formalCoproductMap.{w} (restrictOpenOverFunctor A)).map
          ((FormalCoproduct.mk ι V).cech.map g) :=
  (FormalCoproduct.hom_ext_iff' _ _).2 fun _ ↦
    ⟨rfl, (subsingleton_overHom_restrictOpen A _ _).elim _ _⟩

/-- The degreewise comparisons assembled into a morphism of simplicial objects. -/
def cechSimplicialObjectRestrictHom :
    Stacks.CechSite.cechSimplicialObject (restrictOpenHypercover A V) ⟶
      (FormalCoproduct.mk ι V).cech ⋙
        Stacks.CechSite.formalCoproductMap.{w} (restrictOpenOverFunctor A) where
  app n := (cechFormalCoproductRestrictIso A V (ToType n.unop)).hom
  naturality _ _ g := cechFormalCoproductRestrictIso_naturality A V g

/-- Each degreewise comparison is invertible. -/
instance isIso_cechSimplicialObjectRestrictHom_app (n : SimplexCategoryᵒᵖ) :
    IsIso ((cechSimplicialObjectRestrictHom A V).app n) :=
  inferInstanceAs (IsIso (cechFormalCoproductRestrictIso A V (ToType n.unop)).hom)

/-- **The Čech simplicial objects agree.**  The simplicial formal coproduct of the iterated fibre
products of the restriction cover is the image, under `restrictOpenOverFunctor`, of the
simplicial formal coproduct of the iterated intersections of the open cover. -/
def cechSimplicialObjectRestrictIso :
    Stacks.CechSite.cechSimplicialObject (restrictOpenHypercover A V) ≅
      (FormalCoproduct.mk ι V).cech ⋙
        Stacks.CechSite.formalCoproductMap.{w} (restrictOpenOverFunctor A) :=
  haveI := NatIso.isIso_of_isIso_app (cechSimplicialObjectRestrictHom A V)
  asIso (cechSimplicialObjectRestrictHom A V)

end Degreewise

/-! ### The comparison of complexes -/

section Complex

variable (A : CrystallineThickening S) {ι : Type w}
  (V : ι → A.obj.thickening.target.scheme.Opens)
  {A' : Type*} [Category* A'] [HasProducts.{w} A'] [Preadditive A']

/-- **The Čech cosimplicial object of the restriction cover is the Zariski Čech cosimplicial
object of the open cover**, for a coefficient presheaf given on the slice at `A`. -/
def sliceCechCosimplicialObjectRestrictIso (P : (Over A)ᵒᵖ ⥤ A') :
    Stacks.CechSite.sliceCechCosimplicialObject (restrictOpenHypercover A V) P ≅
      (FormalCoproduct.cosimplicialObjectFunctor ((FormalCoproduct.mk ι V).cech)).obj
        ((restrictOpenOverFunctor A).op ⋙ P) :=
  Functor.isoWhiskerRight (Stacks.CechSite.natIsoRightOp (cechSimplicialObjectRestrictIso A V))
    ((FormalCoproduct.evalOp.{w} (Over A) A').obj P)

/-- **The Čech complex of the restriction cover is the Zariski Čech complex of the open cover**,
for a coefficient presheaf given on the slice at `A`. -/
def sliceCechComplexRestrictIso (P : (Over A)ᵒᵖ ⥤ A') :
    Stacks.CechSite.sliceCechComplex (restrictOpenHypercover A V) P ≅
      (CategoryTheory.cechComplexFunctor V).obj ((restrictOpenOverFunctor A).op ⋙ P) :=
  Stacks.CechSite.sliceCechComplexIsoOfCosimplicialIso _
    (sliceCechCosimplicialObjectRestrictIso A V P)

/-- **The Čech complex of the restriction cover of `A` by a family of opens of its ambient scheme
is the Zariski Čech complex, on that family, of the restriction of the coefficient presheaf along
`restrictOpenFunctor A`.**

Degree by degree this is `restrictOpenPiIso`: the iterated fibre product
`A|_{V_{i₀}} ×_A ⋯ ×_A A|_{V_{i_p}}` is the restriction `A|_{V_{i₀} ∩ ⋯ ∩ V_{i_p}}`, so the
coefficient presheaf takes the same value on it as its restriction along `restrictOpenFunctor A`
takes on `V_{i₀} ∩ ⋯ ∩ V_{i_p}`.  The compatibility with the differentials is
`cechFormalCoproductRestrictIso_naturality`. -/
def cechComplexRestrictIso (I : (CrystallineThickening S)ᵒᵖ ⥤ A') :
    Stacks.CechSite.cechComplex (restrictOpenHypercover A V) I ≅
      (CategoryTheory.cechComplexFunctor V).obj ((restrictOpenFunctor A).op ⋙ I) :=
  sliceCechComplexRestrictIso A V ((Over.forget A).op ⋙ I)

end Complex

section Cohomology

variable (A : CrystallineThickening S) {ι : Type w}
  (V : ι → A.obj.thickening.target.scheme.Opens)
  {A' : Type*} [Category* A'] [HasProducts.{w} A'] [Abelian A']

/-- **The Čech cohomology of the restriction cover is the Zariski Čech cohomology of the open
cover**, on the restricted coefficient presheaf. -/
def cechCohomologyRestrictIso (I : (CrystallineThickening S)ᵒᵖ ⥤ A') (p : ℕ) :
    Stacks.CechSite.cechCohomology (restrictOpenHypercover A V) I p ≅
      ((CategoryTheory.cechComplexFunctor V).obj ((restrictOpenFunctor A).op ⋙ I)).homology p :=
  (HomologicalComplex.homologyFunctor A' (ComplexShape.up ℕ) p).mapIso
    (cechComplexRestrictIso A V I)

/-- **Transport of Čech vanishing from the ambient scheme to the small crystalline site.** -/
theorem isZero_cechCohomology_restrictOpenHypercover (I : (CrystallineThickening S)ᵒᵖ ⥤ A')
    (p : ℕ)
    (h : IsZero (((CategoryTheory.cechComplexFunctor V).obj
      ((restrictOpenFunctor A).op ⋙ I)).homology p)) :
    IsZero (Stacks.CechSite.cechCohomology (restrictOpenHypercover A V) I p) :=
  h.of_iso (cechCohomologyRestrictIso A V I p)

end Cohomology

/-! ### Sections of the sheaves involved -/

/-- **The abelian presheaf underlying the restriction `F_T` of a sheaf of `𝒪_{X/S}`-modules to
the ambient scheme of an object is the restriction of the abelian presheaf of `F` along
`restrictOpenFunctor A`.**  This holds by `rfl`: `modulePresheafRestriction` restricts scalars
along `ringRestrictionIso`, which does not touch the underlying abelian presheaf.  It is what
makes the Zariski Čech complex of `F_T` the target of `cechComplexRestrictIso`. -/
theorem toSheaf_moduleRestriction_obj (A : CrystallineThickening S)
    (F : SheafOfModules.{u} (structureSheaf S)) :
    ((SheafOfModules.toSheaf A.obj.thickening.target.scheme.ringCatSheaf).obj
        (moduleRestriction A F)).obj =
      (restrictOpenFunctor A).op ⋙ F.val.presheaf :=
  rfl

/-- **The sections of `F_T` over an open `W` of the ambient scheme of `A` are the sections of `F`
over `A|_W`**, by `rfl`. -/
theorem toSheaf_moduleRestriction_obj_obj (A : CrystallineThickening S)
    (F : SheafOfModules.{u} (structureSheaf S))
    (W : A.obj.thickening.target.scheme.Opens) :
    ((SheafOfModules.toSheaf A.obj.thickening.target.scheme.ringCatSheaf).obj
        (moduleRestriction A F)).obj.obj (op W) =
      F.val.presheaf.obj (op (A.restrictOpen W)) :=
  rfl

end CrystallineThickening

/-- **The abelian presheaf of `SmallSite.abelianSheaf F`, the abelian sheaf of the coefficient
universe `u + 1` attached to a sheaf of `𝒪_{X/S}`-modules, is the universe lift of the abelian
presheaf of `F`**, by `rfl`.  `abelianSheaf` had no sections lemma on base. -/
theorem abelianSheaf_obj (F : SheafOfModules.{u} (structureSheaf S)) :
    (abelianSheaf F).obj = F.val.presheaf ⋙ AddCommGrpCat.uliftFunctor.{u + 1, u} :=
  rfl

/-- **The sections of `SmallSite.abelianSheaf F` over an object of `Cris(X/S)` are the universe
lift of the sections of `F` there**, by `rfl`. -/
theorem abelianSheaf_obj_obj (F : SheafOfModules.{u} (structureSheaf S))
    (A : CrystallineThickening S) :
    (abelianSheaf F).obj.obj (op A) =
      AddCommGrpCat.uliftFunctor.{u + 1, u}.obj (F.val.presheaf.obj (op A)) :=
  rfl

/-! ### Čech vanishing on a standard restriction cover -/

open _root_.Crystalline.GlobalCrystallineSituation.SmallSite.CrystallineThickening in
/-- **The Čech cohomology of a locally quasi-coherent module vanishes in positive degrees on a
standard restriction cover of an object with affine ambient scheme.**

The cover is the family of restrictions `A|_{T_{g i}} ⟶ A` attached to a finite family `g` of
global sections of the affine ambient scheme `T` whose basic opens cover `Spec Γ(T, 𝒪_T)`.  By
`cechComplexRestrictIso` the Čech complex of that family on `Cris(X/S)` is the universe lift of
the Zariski Čech complex of the restriction `F_T` on the cover of `T` by those basic opens, and
the latter is exact in positive degrees because `F_T` is quasi-coherent
(`isQuasicoherent_moduleRestriction`), which is [Stacks, Tag 01X9]. -/
theorem isZero_cechCohomology_abelianSheaf_of_isStandardOpenCover
    (F : SheafOfModules.{u} (structureSheaf S)) (hF : IsLocallyQuasiCoherent F)
    (A : CrystallineThickening S) [IsAffine A.obj.thickening.target.scheme] {n : ℕ}
    (g : Fin n → Γ(A.obj.thickening.target.scheme, ⊤))
    (hg : PrimeSpectrum.IsStandardOpenCoverOfSpectrum g) (p : ℕ) (hp : 0 < p) :
    IsZero (Stacks.CechSite.cechCohomology
      (restrictOpenHypercover A fun i ↦ A.obj.thickening.target.scheme.basicOpen (g i))
      (abelianSheaf F).obj p) := by
  have := isQuasicoherent_moduleRestriction hF A
  have hzar : IsZero (((CategoryTheory.cechComplexFunctor
      fun i ↦ A.obj.thickening.target.scheme.basicOpen (g i)).obj
        ((restrictOpenFunctor A).op ⋙ F.val.presheaf)).homology p) :=
    Stacks.Cohomology.Cech.isZero_cechCohomology_of_isStandardOpenCover
      A.obj.thickening.target.scheme (moduleRestriction A F) ⊤
      (isAffineOpen_top _) g hg p hp
  exact Stacks.CechSite.isZero_cechCohomology_comp_coefficients _
    AddCommGrpCat.uliftFunctor.{u + 1, u} F.val.presheaf p
    (isZero_cechCohomology_restrictOpenHypercover A _ F.val.presheaf p hzar)

open _root_.Crystalline.GlobalCrystallineSituation.SmallSite.CrystallineThickening in
/-- `isZero_cechCohomology_abelianSheaf_of_isStandardOpenCover` with the index type of the cover
lifted to `Type (u + 1)`, which is the universe in which the covering families of
`restrictCoverage` — and hence the Čech-vanishing hypothesis of [Stacks, Tag 03F9] at the
coefficient universe `u + 1` — are indexed. -/
theorem isZero_cechCohomology_abelianSheaf_of_isStandardOpenCover_ulift
    (F : SheafOfModules.{u} (structureSheaf S)) (hF : IsLocallyQuasiCoherent F)
    (A : CrystallineThickening S) [IsAffine A.obj.thickening.target.scheme] {n : ℕ}
    (g : Fin n → Γ(A.obj.thickening.target.scheme, ⊤))
    (hg : PrimeSpectrum.IsStandardOpenCoverOfSpectrum g) (p : ℕ) (hp : 0 < p) :
    IsZero (Stacks.CechSite.cechCohomology
      (restrictOpenHypercover A fun i : ULift.{u + 1} (Fin n) ↦
        A.obj.thickening.target.scheme.basicOpen (g i.down))
      (abelianSheaf F).obj p) := by
  refine isZero_cechCohomology_restrictOpenHypercover A _ (abelianSheaf F).obj p ?_
  refine Stacks.CategoryTheory.CechComplex.isZero_homology_of_ulift
    (fun j : Fin n ↦ A.obj.thickening.target.scheme.basicOpen (g j))
    ((restrictOpenFunctor A).op ⋙ (abelianSheaf F).obj) p ?_
  exact (isZero_cechCohomology_abelianSheaf_of_isStandardOpenCover F hF A g hg p hp).of_iso
    (cechCohomologyRestrictIso A
      (fun j : Fin n ↦ A.obj.thickening.target.scheme.basicOpen (g j))
      (abelianSheaf F).obj p).symm

end Crystalline.GlobalCrystallineSituation.SmallSite

end

