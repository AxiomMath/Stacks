module

public import StacksFrontier.AlgebraicGeometry.Crystalline.SmallSite.CrystalLevelQuotientStructure

/-!
# The restriction map of `𝒪_{X/S}` along a level drop of the system of [Stacks, Tag 07JN]

The objects of the cosimplicial system `(X, T(n)_e, δ(n))` of
[Stacks, Proposition 60.20.1, Tag 07JN] have section rings `D(n)/(p)^{N + e}`, by
`...SmallSite.wholeSpaceSystemLevelRingEquiv`, and the transition map `T(n)_e ⟶ T(n)_{e + 1}` of
the system induces on them the reduction

`D(n)/(p)^{N + e + 1} ⟶ D(n)/(p)^{N + e}`,

by `...SmallSite.wholeSpaceSystemLevelRingEquiv_restrict`.  This module proves that this
reduction is **surjective** and that its **kernel is the principal ideal generated by
`p^{N + e}`**.

## Main results

Everything is in the namespace `Crystalline.GlobalCrystallineSituation.SmallSite`.

* `levelDrop` — the transition morphism `T(n)_e ⟶ T(n)_{e + 1}` of the system, named.
* `surjective_levelRestrict_structureSheaf` — **the reduction of the section rings along a level
  drop is surjective.**
* `levelRestrict_structureSheaf_eq_zero_iff_dvd` — **its kernel is the principal ideal
  `(p^{N + e})`**, in the divisibility spelling.

## References

* [Stacks Project, Proposition 60.21.3, Tag 07LG](https://stacks.math.columbia.edu/tag/07LG)
* [Stacks Project, Proposition 60.20.1, Tag 07JN](https://stacks.math.columbia.edu/tag/07JN)
* [Stacks Project, Lemma 60.19.3, Tag 07LF](https://stacks.math.columbia.edu/tag/07LF)
-/

@[expose] public section

open CategoryTheory AlgebraicGeometry Opposite Simplicial

universe u

noncomputable section

namespace Crystalline.GlobalCrystallineSituation.SmallSite

open Crystalline

variable {S : GlobalCrystallineSituation.{u}} [IsAffine S.X] [IsAffine S.S.scheme]
  (hp : IsNilpotent (S.p : Γ(S.X, ⊤))) [WholeSpacePresentation S hp]

/-- **The level drop `T(n)_e ⟶ T(n)_{e + 1}`** of the cosimplicial system of
[Stacks, Proposition 60.20.1, Tag 07JN], as a morphism of `Cris(X/S)`. -/
abbrev levelDrop (n e : ℕ) :
    ((wholeSpaceSystem S hp).obj (op ⦋n⦌)).obj e ⟶
      ((wholeSpaceSystem S hp).obj (op ⦋n⦌)).obj (e + 1) :=
  ((wholeSpaceSystem S hp).obj (op ⦋n⦌)).map (homOfLE (Nat.le_succ e))

/-- **The reduction of the section rings along a level drop is surjective.** -/
theorem surjective_levelRestrict_structureSheaf (n e : ℕ) :
    Function.Surjective fun z : ((structureSheaf S).val.obj
        (op (((wholeSpaceSystem S hp).obj (op ⦋n⦌)).obj (e + 1))) : Type u) ↦
      ((structureSheaf S).val.map (levelDrop hp n e).op).hom z := by
  intro y
  obtain ⟨d, hd⟩ := Ideal.Quotient.mk_surjective (wholeSpaceSystemLevelRingEquiv hp n e y)
  refine ⟨(wholeSpaceSystemLevelRingEquiv hp n (e + 1)).symm (Ideal.Quotient.mk _ d),
    (wholeSpaceSystemLevelRingEquiv hp n e).injective ?_⟩
  rwa [wholeSpaceSystemLevelRingEquiv_restrict hp n (homOfLE (Nat.le_succ e)),
    RingEquiv.apply_symm_apply, wholeSpaceSystemLevelMap_mk]

/-- **The kernel of the reduction of the section rings along a level drop is the principal ideal
generated by `p^{N + e}`**, as divisibility by the image of `p^{N + e}` in the section
ring. -/
theorem levelRestrict_structureSheaf_eq_zero_iff_dvd (n e : ℕ)
    (z : ((structureSheaf S).val.obj
      (op (((wholeSpaceSystem S hp).obj (op ⦋n⦌)).obj (e + 1))) : Type u)) :
    ((structureSheaf S).val.map (levelDrop hp n e).op).hom z = 0 ↔
      ((S.p : ((structureSheaf S).val.obj
        (op (((wholeSpaceSystem S hp).obj (op ⦋n⦌)).obj (e + 1))) : Type u)) ^
          wholeSpaceLevelExponent hp e) ∣ z := by
  rw [levelRestrict_structureSheaf_eq_zero_iff hp n e z]
  refine ⟨fun ⟨w, hw⟩ ↦ ⟨w, ?_⟩, fun ⟨w, hw⟩ ↦ ⟨w, ?_⟩⟩ <;> rw [hw, nsmul_eq_mul, Nat.cast_pow]

end Crystalline.GlobalCrystallineSituation.SmallSite

end

end
