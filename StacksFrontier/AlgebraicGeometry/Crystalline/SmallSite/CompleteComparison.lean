universe u

noncomputable section

namespace Crystalline.GlobalCrystallineSituation.SmallSite

/-! ### The coefficients of [Stacks, Tag 07MZ] -/

/-- **A finite type crystal in quasi-coherent `𝒪_{X/S}`-modules**, the coefficient sheaf of
[Stacks, Tag 07MZ]: a sheaf of modules that is quasi-coherent on the site, which is condition (1)
of [Stacks, Tag 07IT] for a crystal in quasi-coherent modules, and of finite type in the sense of
`SheafOfModules.IsFiniteTypeOnSite`, [Stacks, Tag 03DL] part (5): every object of the site has a
covering on whose members the restricted module is generated by finitely many global sections. -/
structure IsFiniteTypeQuasicoherentCrystal {S : GlobalCrystallineSituation.{u}}
    (M : SheafOfModules.{u} (structureSheaf S)) : Prop where
  /-- The module is quasi-coherent on the site. -/
  isQuasicoherentOnSite : M.IsQuasicoherentOnSite
  /-- The module is of finite type. -/
  isFiniteType : SheafOfModules.IsFiniteTypeOnSite M

/-! ### The situation of [Stacks, Tag 07MZ] -/

/-- **The hypotheses of [Stacks, Tag 07MZ], as data.**  On top of a global crystalline situation
`(p, (S, I, γ), X)` of [Stacks, Tag 07MF] this carries: that `S = Spec(A)` is affine, that `A` is
Noetherian and `p`-adically complete, that `p` is nilpotent in `A/I`, and a scheme `Y` proper and
smooth over `S` presenting `X` as `Y ×_S S₀`. -/
structure Situation07MZ (S : GlobalCrystallineSituation.{u}) where
  /-- `S = Spec(A)` is affine, so that `A = Γ(S, 𝒪_S)`. -/
  isAffine : IsAffine S.S.scheme
  /-- `A` is a Noetherian ring. -/
  isNoetherianRing : IsNoetherianRing ↥Γ(S.S.scheme, ⊤)
  /-- `A` is `p`-adically complete. -/
  isAdicComplete : IsAdicComplete (Ideal.span {(S.p : Γ(S.S.scheme, ⊤))}) ↥Γ(S.S.scheme, ⊤)
  /-- `p` is nilpotent in `A/I`, the global sections of the closed fibre `S₀`. -/
  prime_nilpotent_closedFiber :
    IsNilpotent (S.p : Γ(DividedPowerScheme.closedFiber S.S, ⊤))
  /-- The scheme `Y` of the remark. -/
  Y : Scheme.{u}
  /-- The structure morphism `Y ⟶ S`. -/
  toBase : Y ⟶ S.S.scheme
  /-- `Y ⟶ S` is proper. -/
  isProper : IsProper toBase
  /-- `Y ⟶ S` is smooth. -/
  isSmooth : Smooth toBase
  /-- The map `X ⟶ Y` presenting `X` as a subscheme of `Y`. -/
  toY : S.X ⟶ Y
  /-- `X = Y ×_S S₀`: the square on `X`, `Y`, `S₀` and `S` is cartesian. -/
  cartesian : IsPullback toY S.toClosedFiber toBase (DividedPowerScheme.closedFiberι S.S)

namespace Situation07MZ

variable {S : GlobalCrystallineSituation.{u}} (T : Situation07MZ S)

/-- **In the situation of [Stacks, Tag 07MZ] the map `X ⟶ Y` is a closed immersion.** -/
theorem isClosedImmersion_toY : IsClosedImmersion T.toY :=
  MorphismProperty.IsStableUnderBaseChange.of_isPullback (P := @IsClosedImmersion)
    T.cartesian.flip inferInstance

end Situation07MZ

end Crystalline.GlobalCrystallineSituation.SmallSite

end

end
