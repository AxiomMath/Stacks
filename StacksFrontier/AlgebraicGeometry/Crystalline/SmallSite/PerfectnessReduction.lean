module

public import StacksFrontier.AlgebraicGeometry.Crystalline.SmallSite.BaseChangeIsomorphism
public import StacksFrontier.AlgebraicGeometry.Crystalline.SmallSite.VanishingTransfer
public import StacksFrontier.Homology.Perfect.BaseChange
public import StacksFrontier.Homology.Perfect.NilpotentLifting
public import StacksFrontier.RingTheory.AdicCompletion.LiftToComplete

/-!
# Reductions of [Stacks, Tag 07MX] and [Stacks, Tag 07MY]

Let `F` be a crystal in finite locally free quasi-coherent `𝒪_{X/S}`-modules, with `X/S₀` proper
and smooth and `S = Spec(A)` affine. The propositions `Perfect07MX` and `Perfect07MY` assert that
`RΓ(Cris(X/S), F)` is a perfect object of `D(A)` when `p` is nilpotent in `A`, respectively when
`A` is `p`-adically complete and `p` is nilpotent in `A/I`. This file proves the following.

* `Perfect07MY` implies `Perfect07MX`: if `p` is nilpotent in `A`, then `A` is `p`-adically
  complete and `p` is nilpotent in `A/I`.
* `Perfect07MX` holds if and only if, under the same hypotheses, the derived reduction
  `RΓ(Cris(X/S), F) ⊗^L_A A/pA` is a perfect object of `D(A/pA)` ([Stacks, Tag 066W] and
  [Stacks, Tag 07LU]).
* Each of `Perfect07MX` and `Perfect07MY` follows from the vanishing of `H^i(Cris(X/S), F)` for
  all large `i` together with the perfectness of every `A`-module `H^i(Cris(X/S), F)`
  ([Stacks, Tag 066U]). By [Stacks, Tag 03FD] the vanishing may be read on the cohomology of the
  abelian sheaf underlying `F`.

## Main definitions

Everything lives in the namespace `Crystalline.GlobalCrystallineSituation.SmallSite`.

* `derivedGlobalSectionsUnbounded` — `RΓ(Cris(X/S), F)` as an object of `D(A)`.
* `derivedReductionModPrime` — the derived reduction `K ⊗^L_A A/pA` of an object of `D(A)`.
* `ModuleCohomologyBoundedAbove`, `AbelianCohomologyBoundedAbove` — vanishing of
  `H^i(Cris(X/S), F)` for large `i`, for the `A`-module and for the abelian group.
* `PerfectModPrime07MX` — the conclusion of [Stacks, Tag 07MX] read in `D(A/pA)`.
* `BoundedCohomology07MX`, `PerfectCohomology07MX`, `BoundedCohomology07MY`,
  `PerfectCohomology07MY` — the vanishing of `H^i(Cris(X/S), F)` for large `i`, and the
  perfectness of every `H^i(Cris(X/S), F)`, under the hypotheses of each remark.

## Main results

* `perfect07MX_of_perfect07MY` — **[Stacks, Tag 07MX] follows from [Stacks, Tag 07MY].**
* `perfect07MX_iff_perfectModPrime07MX` — **[Stacks, Tag 07MX] is equivalent to its derived
  reduction modulo `p`.**
* `moduleCohomologyBoundedAbove_iff_abelian` — the two boundedness conditions are equivalent.
* `perfect07MX_of_boundedCohomology_of_perfectCohomology`,
  `perfect07MY_of_boundedCohomology_of_perfectCohomology` — each remark follows from the
  vanishing and the perfectness of its cohomology modules.

## References

* [Stacks Project, Tag 03FD](https://stacks.math.columbia.edu/tag/03FD)
* [Stacks Project, Tag 066U](https://stacks.math.columbia.edu/tag/066U)
* [Stacks Project, Tag 066W](https://stacks.math.columbia.edu/tag/066W)
* [Stacks Project, Tag 07LU](https://stacks.math.columbia.edu/tag/07LU)
* [Stacks Project, Tag 07MX](https://stacks.math.columbia.edu/tag/07MX)
* [Stacks Project, Tag 07MY](https://stacks.math.columbia.edu/tag/07MY)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open scoped AlgebraicGeometry

universe v u

attribute [local instance] HasDerivedCategory.standard

namespace Crystalline.GlobalCrystallineSituation.SmallSite

/-! ### Two pieces of commutative algebra -/

/-- The ideal generated by a nilpotent element is nilpotent. -/
private lemma isNilpotent_idealSpanSingleton {R : Type*} [CommRing R] {x : R}
    (hx : IsNilpotent x) : IsNilpotent (Ideal.span {x}) := by
  obtain ⟨n, hn⟩ := hx
  exact ⟨n, by rw [Ideal.zero_eq_bot, Ideal.span_singleton_pow, hn,
    Ideal.span_singleton_eq_bot]⟩

/-- A finite projective module is a perfect module. -/
private lemma isPerfectModule_of_finite_projective {R : Type*} [CommRing R] (N : Type v)
    [AddCommGroup N] [Module R N] [Module.Finite R N] [Module.Projective R N] :
    StacksDraft.Perfect.IsPerfectModule (R := R) N := by
  let M : ModuleCat.{v} R := ModuleCat.of R N
  let P := (CochainComplex.singleFunctor (ModuleCat.{v} R) 0).obj M
  have h (i : ℤ) : Module.Finite R (P.X i) ∧ Module.Projective R (P.X i) := by
    by_cases hi : i = 0
    · subst i
      let e := (HomologicalComplex.singleObjXSelf (ComplexShape.up ℤ) 0 M).toLinearEquiv
      exact ⟨Module.Finite.equiv e.symm, Module.Projective.of_equiv' e.symm⟩
    · have hz := HomologicalComplex.isZero_single_obj_X (ComplexShape.up ℤ) 0 M i hi
      have : Subsingleton (P.X i) := ModuleCat.isZero_iff_subsingleton.mp hz
      exact ⟨inferInstance, Module.Projective.of_free⟩
  exact ⟨P, 0, 0, inferInstance, inferInstance, fun i ↦ (h i).1, fun i ↦ (h i).2,
    ⟨(DerivedCategory.singleFunctorIsoCompQ (ModuleCat.{v} R) 0).app M⟩⟩

/-- Perfectness of a module is transported along an isomorphism of the bundled modules. -/
private lemma isPerfectModule_of_iso {R : Type*} [CommRing R] {M N : ModuleCat.{v} R}
    (e : M ≅ N) (h : StacksDraft.Perfect.IsPerfectModule (R := R) (N : Type v)) :
    StacksDraft.Perfect.IsPerfectModule (R := R) (M : Type v) := by
  obtain ⟨P, a, b, ha, hb, hfin, hproj, ⟨i⟩⟩ := h
  exact ⟨P, a, b, ha, hb, hfin, hproj,
    ⟨(DerivedCategory.singleFunctor (ModuleCat.{v} R) 0).mapIso
      e.toLinearEquiv.toModuleIso ≪≫ i⟩⟩

/-- A module with no nonzero element is perfect. -/
private lemma isPerfectModule_of_isZero {R : Type*} [CommRing R] (M : ModuleCat.{v} R)
    (hM : IsZero M) : StacksDraft.Perfect.IsPerfectModule (R := R) (M : Type v) := by
  have : Subsingleton (M : Type v) := ModuleCat.isZero_iff_subsingleton.mp hM
  have : Finite (M : Type v) := Finite.of_subsingleton
  have : Module.Finite R (M : Type v) := Module.Finite.of_finite
  have : Module.Projective R (M : Type v) := Module.Projective.of_free
  exact isPerfectModule_of_finite_projective _

variable (S : GlobalCrystallineSituation.{u})

/-- If `p` is nilpotent in `Γ(S, 𝒪_S)`, then `p` is nilpotent in `Γ(S₀, 𝒪_{S₀})`, for `S₀` the
closed fibre of `S`. -/
theorem isNilpotent_prime_closedFiber_of_isNilpotent
    (hp : IsNilpotent (S.p : Γ(S.S.scheme, ⊤))) :
    IsNilpotent (S.p : Γ(DividedPowerScheme.closedFiber S.S, ⊤)) := by
  simpa only [map_natCast] using hp.map (DividedPowerScheme.closedFiberι S.S).appTop.hom

/-! ### [Stacks, Tag 07MX] follows from [Stacks, Tag 07MY] -/

/-- **[Stacks, Tag 07MY] implies [Stacks, Tag 07MX]**: `Perfect07MY S` implies `Perfect07MX S`. -/
theorem perfect07MX_of_perfect07MY (h : Perfect07MY S) : Perfect07MX S :=
  fun haff hp hproper hsmooth F hF ↦
    h haff (IsAdicComplete.of_isNilpotent _ (isNilpotent_idealSpanSingleton hp))
      (isNilpotent_prime_closedFiber_of_isNilpotent S hp) hproper hsmooth F hF

/-! ### `RΓ(Cris(X/S), F)` in the unbounded derived category -/

/-- **`RΓ(Cris(X/S), F)` as an object of the unbounded derived category `D(A)`**: the image of
`moduleULiftDerivedGlobalSections S F` under the inclusion `D⁺(A) ⥤ D(A)`. -/
abbrev derivedGlobalSectionsUnbounded (F : SheafOfModules.{u} (structureSheaf S)) :
    DerivedCategory (ModuleCat.{u + 1} Γ(S.S.scheme, ⊤)) :=
  (DerivedCategory.Plus.ι (C := ModuleCat.{u + 1} Γ(S.S.scheme, ⊤))).obj
    (moduleULiftDerivedGlobalSections S F)

/-! ### [Stacks, Tag 07MX] and its derived reduction modulo `p` -/

/-- **The derived reduction `K ⊗^L_A A/pA`** of an object `K` of `D(A)`, for `A = Γ(S, 𝒪_S)` and
`p` the prime of the situation. -/
abbrev derivedReductionModPrime
    (K : DerivedCategory (ModuleCat.{u + 1} Γ(S.S.scheme, ⊤))) :
    DerivedCategory
      (ModuleCat.{u + 1} (↥Γ(S.S.scheme, ⊤) ⧸ Ideal.span {(S.p : Γ(S.S.scheme, ⊤))})) :=
  (CochainComplex.DerivedExtensionScalars.totalDerivedExtensionScalars.{u, u, u + 1}
    (Ideal.Quotient.mk (Ideal.span {(S.p : Γ(S.S.scheme, ⊤))}))).functor.obj K

/-- **The conclusion of [Stacks, Tag 07MX] read in `D(A/pA)`**: under the hypotheses of that
remark, the derived reduction `RΓ(Cris(X/S), F) ⊗^L_A A/pA` is a perfect object of `D(A/pA)`. -/
def PerfectModPrime07MX : Prop :=
  IsAffine S.S.scheme → IsNilpotent (S.p : Γ(S.S.scheme, ⊤)) →
    IsProper S.toClosedFiber → Smooth S.toClosedFiber →
      ∀ F : SheafOfModules.{u} (structureSheaf S),
        IsFiniteLocallyFreeQuasicoherentCrystal F →
          StacksDraft.Perfect.IsPerfect.{u, u + 1, u + 2}
            (derivedReductionModPrime S (derivedGlobalSectionsUnbounded S F))

/-- **[Stacks, Tag 07MX] is equivalent to its derived reduction modulo `p`**: `Perfect07MX S`
holds if and only if `PerfectModPrime07MX S` does. -/
theorem perfect07MX_iff_perfectModPrime07MX :
    Perfect07MX S ↔ PerfectModPrime07MX S :=
  ⟨fun h haff hp hproper hsmooth F hF ↦ StacksDraft.Perfect.isPerfect_derivedExtensionScalars _ _
      (h haff hp hproper hsmooth F hF),
    fun h haff hp hproper hsmooth F hF ↦
      StacksDraft.Perfect.isPerfect_of_isPerfect_mod_isNilpotent _ _
        (h haff hp hproper hsmooth F hF) (isNilpotent_idealSpanSingleton hp)⟩

/-! ### Boundedness of the cohomology, in its two forms -/

/-- **`H^i(Cris(X/S), F)` vanishes in all large degrees**, for the `A`-module valued cohomology
`moduleULiftCohomology`. -/
def ModuleCohomologyBoundedAbove (F : SheafOfModules.{u} (structureSheaf S)) : Prop :=
  ∃ b : ℕ, ∀ i : ℕ, b < i → IsZero (moduleULiftCohomology S F i)

/-- **The abelian form of `ModuleCohomologyBoundedAbove`**: the abelian group
`H^i(Cris(X/S), -)` of the abelian sheaf underlying `F` vanishes in all large degrees. -/
def AbelianCohomologyBoundedAbove (F : SheafOfModules.{u} (structureSheaf S)) : Prop :=
  ∃ b : ℕ, ∀ i : ℕ, b < i → Subsingleton (cohomology S (abelianSheaf F) i)

/-- **The `A`-module `H^j(Cris(X/S), F)` vanishes exactly when the abelian group
`H^j(Cris(X/S), -)` of the abelian sheaf underlying `F` does.** -/
theorem isZero_moduleULiftCohomology_iff_subsingleton_cohomology
    (F : SheafOfModules.{u} (structureSheaf S)) (j : ℕ) :
    IsZero (moduleULiftCohomology S F j) ↔
      Subsingleton (cohomology S (abelianSheaf F) j) :=
  (isZero_moduleCohomology_iff S ((moduleULift S).obj F) j).trans
    (subsingleton_cohomology_iff_isZero_rightDerivedGlobalSections S (abelianSheaf F) j).symm

/-- **The two boundedness conditions are equivalent**: `ModuleCohomologyBoundedAbove S F` holds
if and only if `AbelianCohomologyBoundedAbove S F` does. -/
theorem moduleCohomologyBoundedAbove_iff_abelian
    (F : SheafOfModules.{u} (structureSheaf S)) :
    ModuleCohomologyBoundedAbove S F ↔ AbelianCohomologyBoundedAbove S F :=
  exists_congr fun _ ↦ forall₂_congr fun i _ ↦
    isZero_moduleULiftCohomology_iff_subsingleton_cohomology S F i

/-! ### [Stacks, Tag 066U] at `RΓ(Cris(X/S), F)` -/

/-- **`RΓ(Cris(X/S), F)` is a perfect object of `D(A)` as soon as its cohomology modules are
perfect and vanish in large degrees.** -/
theorem isPerfect_moduleULiftDerivedGlobalSections_of_bounded_of_isPerfectModule
    (F : SheafOfModules.{u} (structureSheaf S))
    (hb : ModuleCohomologyBoundedAbove S F)
    (hp : ∀ j : ℕ, StacksDraft.Perfect.IsPerfectModule (R := ↥Γ(S.S.scheme, ⊤))
      (moduleULiftCohomology S F j)) :
    StacksDraft.Perfect.IsPerfect.{u, u + 1, u + 2} (derivedGlobalSectionsUnbounded S F) := by
  obtain ⟨b, hbz⟩ := hb
  have hiso (j : ℕ) :
      (DerivedCategory.homologyFunctor (ModuleCat.{u + 1} Γ(S.S.scheme, ⊤)) (j : ℤ)).obj
          (derivedGlobalSectionsUnbounded S F) ≅
        moduleULiftCohomology S F j :=
    homologyModuleULiftDerivedGlobalSectionsIso S F j
  have hLE : (derivedGlobalSectionsUnbounded S F).IsLE (b : ℤ) := by
    rw [DerivedCategory.isLE_iff]
    intro i hi
    obtain ⟨j, rfl⟩ := Int.eq_ofNat_of_zero_le (a := i) (by omega)
    exact IsZero.of_iso (hbz j (by omega)) (hiso j)
  refine StacksDraft.Perfect.isPerfect_of_bounded_of_cohomology_isPerfect _
    ⟨(moduleULiftDerivedGlobalSections S F).property, ⟨(b : ℤ), hLE⟩⟩ (fun i ↦ ?_)
  rcases lt_or_ge i 0 with hi | hi
  · exact isPerfectModule_of_isZero _
      (isZero_homologyFunctor_obj_moduleULiftDerivedGlobalSections_of_neg F i hi)
  · obtain ⟨j, rfl⟩ := Int.eq_ofNat_of_zero_le (a := i) (by omega)
    exact isPerfectModule_of_iso (hiso j) (hp j)

/-! ### The two halves of [Stacks, Tag 07MX] and [Stacks, Tag 07MY] -/

/-- **The boundedness half of [Stacks, Tag 07MX]**: under the hypotheses of that remark, the
cohomology `H^i(Cris(X/S), F)` vanishes in all large degrees. -/
def BoundedCohomology07MX : Prop :=
  IsAffine S.S.scheme → IsNilpotent (S.p : Γ(S.S.scheme, ⊤)) →
    IsProper S.toClosedFiber → Smooth S.toClosedFiber →
      ∀ F : SheafOfModules.{u} (structureSheaf S),
        IsFiniteLocallyFreeQuasicoherentCrystal F → ModuleCohomologyBoundedAbove S F

/-- **The finiteness half of [Stacks, Tag 07MX]**: under the hypotheses of that remark, every
cohomology module `H^i(Cris(X/S), F)` is a perfect `A`-module. -/
def PerfectCohomology07MX : Prop :=
  IsAffine S.S.scheme → IsNilpotent (S.p : Γ(S.S.scheme, ⊤)) →
    IsProper S.toClosedFiber → Smooth S.toClosedFiber →
      ∀ F : SheafOfModules.{u} (structureSheaf S),
        IsFiniteLocallyFreeQuasicoherentCrystal F →
          ∀ j : ℕ, StacksDraft.Perfect.IsPerfectModule (R := ↥Γ(S.S.scheme, ⊤))
            (moduleULiftCohomology S F j)

/-- **The boundedness half of [Stacks, Tag 07MY]**: under the hypotheses of that remark, the
cohomology `H^i(Cris(X/S), F)` vanishes in all large degrees. -/
def BoundedCohomology07MY : Prop :=
  IsAffine S.S.scheme →
    IsAdicComplete (Ideal.span {(S.p : Γ(S.S.scheme, ⊤))}) ↥Γ(S.S.scheme, ⊤) →
      IsNilpotent (S.p : Γ(DividedPowerScheme.closedFiber S.S, ⊤)) →
        IsProper S.toClosedFiber → Smooth S.toClosedFiber →
          ∀ F : SheafOfModules.{u} (structureSheaf S),
            IsFiniteLocallyFreeQuasicoherentCrystal F → ModuleCohomologyBoundedAbove S F

/-- **The finiteness half of [Stacks, Tag 07MY]**: under the hypotheses of that remark, every
cohomology module `H^i(Cris(X/S), F)` is a perfect `A`-module. -/
def PerfectCohomology07MY : Prop :=
  IsAffine S.S.scheme →
    IsAdicComplete (Ideal.span {(S.p : Γ(S.S.scheme, ⊤))}) ↥Γ(S.S.scheme, ⊤) →
      IsNilpotent (S.p : Γ(DividedPowerScheme.closedFiber S.S, ⊤)) →
        IsProper S.toClosedFiber → Smooth S.toClosedFiber →
          ∀ F : SheafOfModules.{u} (structureSheaf S),
            IsFiniteLocallyFreeQuasicoherentCrystal F →
              ∀ j : ℕ, StacksDraft.Perfect.IsPerfectModule (R := ↥Γ(S.S.scheme, ⊤))
                (moduleULiftCohomology S F j)

/-- **[Stacks, Tag 07MX] follows from the boundedness and the finiteness of its cohomology
modules**: `BoundedCohomology07MX S` and `PerfectCohomology07MX S` together imply
`Perfect07MX S`. -/
theorem perfect07MX_of_boundedCohomology_of_perfectCohomology
    (hb : BoundedCohomology07MX S) (hp : PerfectCohomology07MX S) : Perfect07MX S :=
  fun haff hnil hproper hsmooth F hF ↦
    isPerfect_moduleULiftDerivedGlobalSections_of_bounded_of_isPerfectModule S F
      (hb haff hnil hproper hsmooth F hF) (hp haff hnil hproper hsmooth F hF)

/-- **[Stacks, Tag 07MY] follows from the boundedness and the finiteness of its cohomology
modules**: `BoundedCohomology07MY S` and `PerfectCohomology07MY S` together imply
`Perfect07MY S`. -/
theorem perfect07MY_of_boundedCohomology_of_perfectCohomology
    (hb : BoundedCohomology07MY S) (hp : PerfectCohomology07MY S) : Perfect07MY S :=
  fun haff hcomplete hnil hproper hsmooth F hF ↦
    isPerfect_moduleULiftDerivedGlobalSections_of_bounded_of_isPerfectModule S F
      (hb haff hcomplete hnil hproper hsmooth F hF)
      (hp haff hcomplete hnil hproper hsmooth F hF)

end Crystalline.GlobalCrystallineSituation.SmallSite

end
