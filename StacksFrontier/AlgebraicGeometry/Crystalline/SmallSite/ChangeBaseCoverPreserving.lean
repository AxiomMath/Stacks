module

public import Mathlib.CategoryTheory.Sites.CoverPreserving
public import StacksFrontier.AlgebraicGeometry.Crystalline.SmallSite.Functoriality
public import StacksFrontier.AlgebraicGeometry.Crystalline.SmallSite.StructureSheaf

/-!
# Change of divided power base preserves covers on the small crystalline site

Let `X' ⊆ X` and `S' ⊆ S` be open subschemes with `X'` mapping into `S'`, so that change of
divided power base gives a functor `Cris(X'/S') ⥤ Cris(X/S)` between small crystalline sites
(`Crystalline.GlobalCrystallineSituation.smallChangeBase`).  This file records that the functor
is *cover-preserving*: the sieve generated by the image of a covering sieve of `Cris(X'/S')` is
again a covering sieve.

## Main results

* `Crystalline.GlobalCrystallineSituation.smallChangeBase_coverPreserving` — change of divided
  power base `Cris(X'/S') ⥤ Cris(X/S)` is cover-preserving for the Zariski topologies.
* `Crystalline.GlobalCrystallineSituation.smallChangeBase_functorPullback_functorPushforward` —
  the pullback of the pushforward of a sieve along this functor is the sieve itself.

## References

* [Stacks Project, Tag 07KL](https://stacks.math.columbia.edu/tag/07KL)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

namespace Crystalline.GlobalCrystallineSituation

variable {S S' : GlobalCrystallineSituation.{u}} {f : S.S ⟶ S'.S} {g : S.X ⟶ S'.X}
  {h : S.toClosedFiber ≫ DividedPowerScheme.closedFiberMap f = g ≫ S'.toClosedFiber}
  [IsOpenImmersion g]

/-- Change of divided power base `Cris(X'/S') ⥤ Cris(X/S)` along open immersions `X' ⊆ X` and
`S' ⊆ S` is *cover-preserving* for the Zariski topologies of the small crystalline sites: the sieve
generated by the image of a covering sieve of `A` covers the image of `A`. -/
@[stacks 07KL "the functor is cover-preserving"]
theorem smallChangeBase_coverPreserving :
    CoverPreserving (smallTopology S) (smallTopology S') (smallChangeBase S S' f g h) where
  cover_preserve {A T} hT := by
    rw [← SmallSite.restrictCoverage_toGrothendieck] at hT
    induction hT with
    | of A R hR =>
      obtain ⟨I, V, hV, rfl⟩ := hR
      have hE : CrystallineThickening.IsZariskiCovering (A.restrictOpenCover V) :=
        CrystallineThickening.isZariskiCovering_restrictOpenCover A V hV
      have hmap : Sieve.generate
            ((A.restrictOpenCover V).map (smallChangeBase S S' f g h)).presieve₀ =
          (Sieve.generate (A.restrictOpenCover V).presieve₀).functorPushforward
            (smallChangeBase S S' f g h) :=
        PreZeroHypercover.sieve₀_map _
      exact hmap ▸ smallZariskiCovering_mem_smallTopology S'
        ((A.restrictOpenCover V).map (smallChangeBase S S' f g h)) ⟨hE.1, hE.2⟩
    | top A =>
      rw [Sieve.functorPushforward_top]
      exact (smallTopology S').top_mem _
    | transitive A R Q hR hQ ihR ihQ =>
      refine (smallTopology S').transitive ihR _ fun W m hm ↦ ?_
      obtain ⟨Z, k, q, hk, rfl⟩ := hm
      rw [Sieve.pullback_comp]
      exact (smallTopology S').pullback_stable q
        ((smallTopology S').superset_covering
          (Sieve.functorPushforward_pullback_le (F := smallChangeBase S S' f g h) k Q) (ihQ hk))

/-- **The pullback of the pushforward of a sieve along change of divided power base is the sieve
itself**, for change of base along open immersions `X' ⊆ X` and `S' ⊆ S`. -/
theorem smallChangeBase_functorPullback_functorPushforward [IsOpenImmersion f.hom]
    {A : CrystallineThickening S} (T : Sieve A) :
    (T.functorPushforward (smallChangeBase S S' f g h)).functorPullback
        (smallChangeBase S S' f g h) = T :=
  Sieve.functorPullback_functorPushforward_eq _

end Crystalline.GlobalCrystallineSituation

end
