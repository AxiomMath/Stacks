module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Crystalline.BigSite.Topology

/-!
# The small crystalline site

Fix a global crystalline situation `(p, (S, I, γ), X)`.  Among the divided power thickenings
`(U, T, δ)` of `X` relative to `(S, I, γ)` are the ones whose structure map `U ⟶ X` is an open
immersion; they span a full subcategory of the big crystalline category `CRIS(X/S)`.  The *small
crystalline site* `Cris(X/S, I, γ)`, abbreviated `Cris(X/S)`, is that full subcategory with the
Zariski topology, and the *crystalline topos* `(X/S)_cris` is its topos of sheaves of sets.

The covering families of the small site are the Zariski covering families of the big site whose
members all lie in the full subcategory: a family `{(Uᵢ, Tᵢ, δᵢ) ⟶ (U, T, δ)}` of `Cris(X/S)`
covers when `Uᵢ = U ×_T Tᵢ` for every `i` and `{Tᵢ ⟶ T}` is a Zariski covering of schemes. The
topology of the small site is the Grothendieck topology generated by these families.

## Main definitions

* `Crystalline.GlobalCrystallineSituation.Thickening.IsCrystalline` — the property cutting out the
  small crystalline category: the map `U ⟶ X` is an open immersion, [Stacks, Tag 07IG].
* `Crystalline.GlobalCrystallineSituation.CrystallineThickening` — the objects of `Cris(X/S)`, the
  full subcategory of `CRIS(X/S)` they span, [Stacks, Tag 07IG].
* `Crystalline.GlobalCrystallineSituation.CrystallineThickening.IsZariskiCovering` — a Zariski
  covering family of `Cris(X/S)`, [Stacks, Tag 07IG].
* `Crystalline.GlobalCrystallineSituation.smallPrecoverage` — the precoverage of `Cris(X/S)` whose
  covering presieves are those presented by a Zariski covering family.
* `Crystalline.GlobalCrystallineSituation.smallTopology` — the Zariski topology of the small
  crystalline site, [Stacks, Tag 07IG].
* `Crystalline.GlobalCrystallineSituation.smallTopos` — the crystalline topos `(X/S)_cris`,
  [Stacks, Tag 07IG].

## Main results

* `Crystalline.GlobalCrystallineSituation.smallZariskiCovering_mem_smallTopology` — the sieve
  generated by a Zariski covering family is a covering sieve of the small crystalline site.
* `Crystalline.GlobalCrystallineSituation.CrystallineThickening.isZariskiCovering_singleton_id` —
  the one-element family given by an identity is a Zariski covering.

## References

* [Stacks Project, Tag 07IG](https://stacks.math.columbia.edu/tag/07IG)
* [Stacks Project, Tag 07IB](https://stacks.math.columbia.edu/tag/07IB)
* [Stacks Project, Tag 07HM](https://stacks.math.columbia.edu/tag/07HM)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

namespace Crystalline.GlobalCrystallineSituation

namespace Thickening

variable {S : GlobalCrystallineSituation.{u}}

/-- The property that cuts out the small crystalline category: the structure map `U ⟶ X` of a
divided power thickening `(U, T, δ)` of `X` relative to `(S, I, γ)` is an open immersion. -/
@[stacks 07IG "(1), the condition on the objects"]
abbrev IsCrystalline : ObjectProperty (Thickening S) := fun A ↦ IsOpenImmersion A.toX

end Thickening

/-- The small crystalline category `Cris(X/S, I, γ)`, abbreviated `Cris(X/S)`: the full
subcategory of the big crystalline category `CRIS(X/S)` on the divided power thickenings
`(U, T, δ)` for which `U ⟶ X` is an open immersion. -/
@[stacks 07IG "(1), the full subcategory Cris(X/S)"]
abbrev CrystallineThickening (S : GlobalCrystallineSituation.{u}) :=
  (Thickening.IsCrystalline (S := S)).FullSubcategory

namespace CrystallineThickening

variable {S : GlobalCrystallineSituation.{u}}

/-- The inclusion of the small crystalline category into the big one. -/
abbrev ι (S : GlobalCrystallineSituation.{u}) : CrystallineThickening S ⥤ Thickening S :=
  (Thickening.IsCrystalline (S := S)).ι

/-- The inclusion `Cris(X/S) ⥤ CRIS(X/S)` is fully faithful, being the inclusion of a full
subcategory. -/
abbrev fullyFaithfulι (S : GlobalCrystallineSituation.{u}) : (ι S).FullyFaithful :=
  (Thickening.IsCrystalline (S := S)).fullyFaithfulι

/-- A Zariski covering family of the small crystalline category: a family of morphisms of
`Cris(X/S)` which is a Zariski covering family of the big crystalline category `CRIS(X/S)`, that
is, whose squares are Cartesian and whose ambient divided power schemes form a Zariski covering. -/
@[stacks 07IG "(1), the Zariski coverings"]
abbrev IsZariskiCovering {B : CrystallineThickening S} (E : PreZeroHypercover.{u + 1} B) : Prop :=
  Thickening.IsZariskiCovering (E.map (ι S))

/-- **The one-element family given by the identity of an object of `Cris(X/S)` is a Zariski
covering.** -/
theorem isZariskiCovering_singleton_id (B : CrystallineThickening S) :
    IsZariskiCovering (PreZeroHypercover.singleton.{u + 1} (𝟙 B)) := by
  refine ⟨fun _ ↦ Thickening.isCartesian_id B.obj, ?_⟩
  change Presieve.ofArrows (fun _ : PUnit.{u + 2} ↦ B.obj.thickening.target.scheme)
    (fun _ ↦ 𝟙 B.obj.thickening.target.scheme) ∈ _
  rw [Scheme.ofArrows_mem_precoverage_iff]
  exact ⟨fun x ↦ ⟨PUnit.unit, x, rfl⟩, fun _ ↦ inferInstance⟩

end CrystallineThickening

open CrystallineThickening

/-- The precoverage of `Cris(X/S)` whose covering presieves are those presented by a Zariski
covering family of the small crystalline category. -/
def smallPrecoverage (S : GlobalCrystallineSituation.{u}) :
    Precoverage (CrystallineThickening S) where
  coverings B := {R | ∃ E : PreZeroHypercover.{u + 1} B, R = E.presieve₀ ∧ IsZariskiCovering E}

/-- A presieve is covering for `Crystalline.GlobalCrystallineSituation.smallPrecoverage` exactly
when some Zariski covering family of the small crystalline category presents it. -/
theorem mem_smallPrecoverage_iff (S : GlobalCrystallineSituation.{u})
    {B : CrystallineThickening S} {R : Presieve B} :
    R ∈ smallPrecoverage S B ↔
      ∃ E : PreZeroHypercover.{u + 1} B, R = E.presieve₀ ∧ IsZariskiCovering E :=
  Iff.rfl

/-- The small crystalline site of `X` over `(S, I, γ)`: the full subcategory `Cris(X/S)` of
`CRIS(X/S)` on the thickenings `(U, T, δ)` with `U ⟶ X` an open immersion, endowed with the
Zariski topology, the topology generated by the Zariski covering families. -/
@[stacks 07IG "(1), the small crystalline site"]
abbrev smallTopology (S : GlobalCrystallineSituation.{u}) :
    GrothendieckTopology (CrystallineThickening S) :=
  (smallPrecoverage S).toGrothendieck

/-- **Every Zariski covering family covers in the small crystalline site.** -/
theorem smallZariskiCovering_mem_smallTopology (S : GlobalCrystallineSituation.{u})
    {B : CrystallineThickening S} (E : PreZeroHypercover.{u + 1} B) (hE : IsZariskiCovering E) :
    Sieve.generate E.presieve₀ ∈ smallTopology S B :=
  (smallPrecoverage S).generate_mem_toGrothendieck ⟨E, rfl, hE⟩

/-- The crystalline topos `(X/S)_cris`, the topos of sheaves of sets on the small crystalline
site. -/
@[stacks 07IG "(2), the crystalline topos"]
abbrev smallTopos (S : GlobalCrystallineSituation.{u}) :=
  Sheaf (smallTopology S) (Type (u + 1))

end Crystalline.GlobalCrystallineSituation

end
