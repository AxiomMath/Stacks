module

public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Crystalline.Differentials
public import StacksFrontier.AlgebraicGeometry.Crystalline.Differentials.PurelyInseparablePullback
public import StacksFrontier.AlgebraicGeometry.Crystalline.DividedPowerEnvelope.SingleRelation
public import StacksFrontier.RingTheory.DividedPowers.Polynomial.SetIndexed

/-!
# The divided powers of the purely inseparable extension

Let `(B, I, γ)` be a divided power ring, let `p ≠ 0` and let `λ ∈ B`.  The ring

`B' = B[z]⟨ξ⟩/(ξ - (z^p - λ)) = B⟨ξ⟩[z]/(z^p - ξ - λ)`

of the proof of Tag 07N1 is built in
`StacksFrontier.AlgebraicGeometry.Crystalline.Differentials.PurelyInseparablePullback` as
`Crystalline.PthRootExtension.primeRing`, which is by construction the quotient of the ordinary
polynomial ring `B⟨ξ⟩[z]` by the principal ideal generated by the monic polynomial `z^p - ξ - λ`.
This file equips it with the divided power ideal `J' = I B' + (ξ)` and divided powers `γ'`
extending `γ`, and proves that `γ'` sends `ξ` to `ξ^[n]` and hence that the differential of the
module of divided power differentials of `B'` over `A` satisfies `d(ξ^[n+1]) = ξ^[n] dξ`.

The divided powers are obtained by descent.  The polynomial ring `B⟨ξ⟩[z]` carries the unique
extension `δ` of the divided powers of `B⟨ξ⟩` to `I B⟨ξ⟩[z] + (ξ)B⟨ξ⟩[z]`, by flatness
(`Crystalline.polynomialDividedPowerRing`), and the intersection of the relation ideal
`(z^p - ξ - λ)` with that divided power ideal is stable under `δ`: an element of the
intersection is `h (z^p - ξ - λ)` with `h` again in the divided power ideal, because a monic
polynomial is regular modulo the extended ideal (`Crystalline.mem_map_C_of_mul_monic`), and then
`δ_n(h (z^p - ξ - λ)) = δ_n(h) (z^p - ξ - λ)^n` lies in the relation ideal.  So the divided
powers descend to the quotient.

## Main definitions

* `Crystalline.PthRootExtension.xiDPRing` — `B⟨ξ⟩` as a divided power ring with divided power
  ideal `I B⟨ξ⟩ + B⟨ξ⟩₊`.
* `Crystalline.PthRootExtension.zPolyDPRing` — `B⟨ξ⟩[z]` with the extension of those divided
  powers along `B⟨ξ⟩ → B⟨ξ⟩[z]`.
* `Crystalline.PthRootExtension.primeDividedPowers` — the divided powers `γ'` on
  `J' = I B' + (ξ)` of the proof of Tag 07N1.
* `Crystalline.PthRootExtension.primeDPRing` — `B'` as a divided power ring.

## Main results

* `Crystalline.PthRootExtension.isSubDPIdeal_relation_inf` — the relation ideal meets the
  divided power ideal of `B⟨ξ⟩[z]` in a sub divided power ideal.
* `Crystalline.PthRootExtension.primeDividedPowers_dpow_xiElt` — `γ'_n(ξ) = ξ^[n]`.
* `Crystalline.PthRootExtension.isDpowDifferential_dividedPowerDifferentials` — the first
  display of the proof of Tag 07N1, `d(ξ^[n+1]) = ξ^[n] dξ`, for the module of divided power
  differentials of `B'` over `A`.

## References

* [Stacks Project, Lemma 60.25.3, Tag 07N1](https://stacks.math.columbia.edu/tag/07N1)
* [Stacks Project, Lemma 60.2.4, Tag 07HC](https://stacks.math.columbia.edu/tag/07HC)
* [Stacks Project, Lemma 60.3.1, Tag 07H1](https://stacks.math.columbia.edu/tag/07H1)
-/

@[expose] public section

noncomputable section

open DividedPowers

universe u

namespace Crystalline.PthRootExtension

variable (B : DividedPowerRing.{u}) (p : ℕ) (lam : (B : Type u))

/-- `B⟨ξ⟩` as a divided power ring, with divided power ideal `I B⟨ξ⟩ + B⟨ξ⟩₊`. -/
public abbrev xiDPRing : DividedPowerRing.{u} :=
  .of (XiAlg B) (dividedPowerPolynomialIdeal B.ideal Unit)
    (setIndexedDividedPowerPolynomialDividedPowers B Unit)

/-- `B⟨ξ⟩[z]` as a divided power ring: the ordinary polynomial ring on `z` with the unique
extension of the divided powers of `B⟨ξ⟩` to `(I B⟨ξ⟩ + B⟨ξ⟩₊)B⟨ξ⟩[z]`. -/
public abbrev zPolyDPRing : DividedPowerRing.{u} := polynomialDividedPowerRing (xiDPRing B)

/-- The relation ideal `(z^p - ξ - λ)` of the extension inside `B⟨ξ⟩[z]`. -/
public abbrev relationIdeal : Ideal (Polynomial (XiAlg B)) :=
  Ideal.span {primePoly B p lam}

/-- The intersection of the relation ideal `(z^p - ξ - λ)` with the divided power ideal of
`B⟨ξ⟩[z]` is a sub divided power ideal. -/
public theorem isSubDPIdeal_relation_inf (hp : p ≠ 0) :
    DividedPowers.IsSubDPIdeal (zPolyDPRing B).dividedPowers
      (relationIdeal B p lam ⊓ (zPolyDPRing B).ideal) where
  isSubideal := inf_le_right
  dpow_mem n hn j hj := by
    obtain ⟨hjK, hjI⟩ := hj
    obtain ⟨h, rfl⟩ := Ideal.mem_span_singleton'.mp hjK
    have hmem : h ∈ (zPolyDPRing B).ideal :=
      mem_map_C_of_mul_monic (xiDPRing B).ideal (primePoly_monic B p lam hp) hjI
    refine ⟨?_, (zPolyDPRing B).dividedPowers.dpow_mem hn hjI⟩
    rw [(zPolyDPRing B).dividedPowers.dpow_mul_right hmem]
    exact Ideal.mul_mem_left _ _ (Ideal.pow_mem_of_mem _
      (Ideal.mem_span_singleton_self _) n (Nat.pos_of_ne_zero hn))

/-- The quotient map `B⟨ξ⟩[z] → B'` of the presentation of the extension. -/
public abbrev relationQuotientMk : Polynomial (XiAlg B) →+* primeRing B p lam :=
  Ideal.Quotient.mk (relationIdeal B p lam)

/-- The divided power ideal `J' = I B' + (ξ)` of the extension: the image of the divided power
ideal of `B⟨ξ⟩[z]`. -/
public abbrev primeIdeal : Ideal (primeRing B p lam) :=
  (zPolyDPRing B).ideal.map (relationQuotientMk B p lam)

/-- **The divided powers `γ'` of the proof of Tag 07N1** on `J' = I B' + (ξ)`, obtained by
descending the divided powers of `B⟨ξ⟩[z]` along the presentation. -/
public def primeDividedPowers (hp : p ≠ 0) : DividedPowers (primeIdeal B p lam) :=
  DividedPowers.Quotient.dividedPowers (zPolyDPRing B).dividedPowers
    (isSubDPIdeal_relation_inf B p lam hp)

/-- `B'` as a divided power ring `(B', J', γ')`. -/
public abbrev primeDPRing (hp : p ≠ 0) : DividedPowerRing.{u} :=
  .of (primeRing B p lam) (primeIdeal B p lam) (primeDividedPowers B p lam hp)

/-- The presentation `B⟨ξ⟩[z] → B'` is a divided power morphism for the divided powers `γ'`. -/
public theorem isDPMorphism_relationQuotientMk (hp : p ≠ 0) :
    DividedPowers.IsDPMorphism (zPolyDPRing B).dividedPowers (primeDividedPowers B p lam hp)
      (relationQuotientMk B p lam) :=
  DividedPowers.Quotient.isDPMorphism (zPolyDPRing B).dividedPowers
    (isSubDPIdeal_relation_inf B p lam hp)

/-- The image of `ξ` in `B'` is the class of the constant polynomial `ξ`. -/
public theorem xiElt_one_zero_eq_mk :
    xiElt B p lam 1 0 = relationQuotientMk B p lam (Polynomial.C (xi B)) := by
  rw [xiElt_one_zero]
  rfl

/-- The image of `ξ^[n]` in `B'` is the class of the constant polynomial `ξ^[n]`. -/
public theorem xiElt_zero_eq_mk (n : ℕ) :
    xiElt B p lam n 0 = relationQuotientMk B p lam (Polynomial.C (xiMonomial B n)) := by
  rw [xiElt_zero_right]
  rfl

/-- `ξ` lies in the divided power ideal of `B⟨ξ⟩[z]`. -/
public theorem polynomial_C_xi_mem : Polynomial.C (xi B) ∈ (zPolyDPRing B).ideal :=
  Ideal.mem_map_of_mem _ (variable_mem_polynomialIdeal B ())

/-- `ξ` lies in the divided power ideal `J'` of `B'`. -/
public theorem xiElt_one_zero_mem (_hp : p ≠ 0) :
    xiElt B p lam 1 0 ∈ primeIdeal B p lam := by
  rw [xiElt_one_zero_eq_mk]
  exact Ideal.mem_map_of_mem _ (polynomial_C_xi_mem B)

/-- **`γ'_n(ξ) = ξ^[n]`.**  The divided powers of the extension send `ξ` to the divided power
monomials `ξ^[n]`. -/
public theorem primeDividedPowers_dpow_xiElt (hp : p ≠ 0) (n : ℕ) :
    (primeDividedPowers B p lam hp).dpow n (xiElt B p lam 1 0) = xiElt B p lam n 0 := by
  rw [xiElt_one_zero_eq_mk, xiElt_zero_eq_mk,
    (isDPMorphism_relationQuotientMk B p lam hp).2 _ (polynomial_C_xi_mem B)]
  congr 1
  rw [(isDPMorphism_C_polynomialDividedPowerRing (xiDPRing B)).dpow_comp (n := n) (xi B)
    (variable_mem_polynomialIdeal B ())]
  congr 1
  exact setIndexedDividedPowerPolynomialDividedPowers_dpow_variable B () n

section Differentials

variable {A : Type u} [CommRing A] [Algebra A (B : Type u)]

/-- **The first display of the proof of Tag 07N1.**  The module of divided power differentials
of `B'` over `A` satisfies `d(ξ^[n+1]) = ξ^[n] dξ`: this is the property
`Crystalline.PthRootExtension.IsDpowDifferential` for the divided power differentials. -/
public theorem isDpowDifferential_dividedPowerDifferentials (hp : p ≠ 0) :
    IsDpowDifferential B p lam
      (pi' := (dividedPowerDifferentialRelations (A := A)
        (primeDividedPowers B p lam hp)).mkQ) := by
  intro n
  have h := dividedPowerDifferential_dpow (A := A)
    (hJ := primeDividedPowers B p lam hp)
    ⟨xiElt B p lam 1 0, xiElt_one_zero_mem B p lam hp⟩ n
  rwa [primeDividedPowers_dpow_xiElt B p lam hp (n + 1),
    primeDividedPowers_dpow_xiElt B p lam hp n] at h

end Differentials

end Crystalline.PthRootExtension

end

end
