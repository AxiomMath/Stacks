/-!
# Divided power derivations and divided power differentials

Let `B` be a divided power ring over a commutative ring `A`, that is, a commutative ring with an
ideal `J ⊆ B` carrying divided powers `δ`, together with a map `A → B`.  A *divided power
derivation* from `B` into a `B`-module `M` is an additive map `D : B → M` which satisfies the
Leibniz rule, vanishes on the image of `A`, and obeys the divided power chain rule

`D (δ_n x) = δ_{n-1} x · D x` for `n > 0` and `x ∈ J`.

The module `Ω¹_{B/A,δ}` of divided power differentials, built in
`StacksFrontier.AlgebraicGeometry.Crystalline.Differentials.DeRham` as the quotient of `Ω[B⁄A]` by
the relations `d (δ_{n+1} x) = δ_n x · d x`, is the target of the universal such derivation: every
divided power derivation factors uniquely through it.  Its projection also satisfies the
generation hypothesis of Tag 07HY, so the de Rham differential descends to its exterior powers.

Three computations of `Ω¹_{B/A,δ}` follow.  For a sub-divided-power ideal `K ⊆ B`, passing to
`B ⧸ K` adds exactly the relations `d k = 0`, so that

`Ω¹_{(B⧸K)/A,δ'} = (B⧸K) ⊗_B Ω¹_{B/A,δ} / ⟨1 ⊗ d k : k ∈ K⟩`.

For the polynomial ring `B[X]` with divided powers `δ'` extending `δ` along `C : B → B[X]`, the
differentials split off a free summand generated by `d X`:

`Ω¹_{B[X]/A,δ'} = (B[X] ⊗_B Ω¹_{B/A,δ}) ⊕ B[X] · d X`.

The same answer holds for the divided power polynomial algebra `P = B⟨x_w : w ∈ W⟩` on an
arbitrary family of variables, with divided power ideal `IP + P₊`:

`Ω¹_{P/A,δ'} = (P ⊗_B Ω¹_{B/A,δ}) ⊕ ⨁_w P · d x_w`,

because the relation `d(δ_n f) = δ_{n-1}(f) · d f` makes `d x_w^{[n]} = x_w^{[n-1]} · d x_w`, so a
divided power derivation of `P` is free data on the coefficients and on the variables.  That last
statement is proved by identifying divided power derivations into a module `N` with sections of
the square-zero divided power thickening `P ⊕ N`, to which the universal property of `P` applies.

All three computations are produced as canonical equivalences, specified by their values on the
universal differentials of the generators rather than merely as abstract isomorphisms.

## Main definitions

* `Crystalline.DividedPowerDerivation` — a divided power derivation into a module.
* `Crystalline.derivationQuotient` — the descent of a derivation killing an ideal to the quotient.

## Main results

* `Crystalline.dividedPowerDifferentials_lift` — the universal property of `Ω¹_{B/A,δ}`.
* `Crystalline.dividedPowerDifferentials_generationHypothesis` — the quotient projection satisfies
  the generation hypothesis of Tag 07HY.
* `Crystalline.dividedPowerDifferentialsQuotientEquiv` — the quotient formula.
* `Crystalline.dividedPowerDifferentialsPolynomialEquiv` — the polynomial formula.
* `Crystalline.dividedPowerDifferentialsDividedPowerPolynomialEquiv` — the divided power
  polynomial formula.

## Implementation notes

The ordinary derivation underlying a divided power derivation is recorded as a
`Derivation ℤ B M`, which is exactly an additive map satisfying the Leibniz rule; vanishing on the
specified map `A →+* B` and compatibility with the divided powers are the two extra fields.  The
base-ring map therefore stays explicit instead of being hidden in an `Algebra` instance.

Positive divided powers are indexed as `n + 1`, so the defining relations need no inequality
hypothesis.  In both computations the scalar extension is written with the new ring as the first
tensor factor, which is the order carrying Mathlib's standard module structure.

## References

* [Stacks Project, Tag 07HR](https://stacks.math.columbia.edu/tag/07HR)
* [Stacks Project, Tag 07HS](https://stacks.math.columbia.edu/tag/07HS)
* [Stacks Project, Tag 07HZ](https://stacks.math.columbia.edu/tag/07HZ)
-/

@[expose] public section

namespace Crystalline

/-! ### Divided power derivations -/

section Derivations

universe u v w

/-- A divided power `A`-derivation from a divided power ring `B` into a `B`-module `M`.

It is an additive map satisfying the Leibniz rule, vanishing on the image of `A`, and
sending `δ n x` to `δ (n - 1) x • D x` for every positive `n` and every `x` in the
distinguished ideal. -/
@[stacks 07HR]
public structure DividedPowerDerivation
    (A : Type u) [CommRing A]
    (B : DividedPowerRing.{v}) (f : A →+* B)
    (M : Type w) [AddCommGroup M] [Module B M]
    extends Derivation ℤ B M where
  /-- A divided power derivation vanishes on the image of the base ring. -/
  map_ringHom' (a : A) : toDerivation (f a) = 0
  /-- A divided power derivation commutes with positive divided power operations according
  to the divided power chain rule. -/
  map_dpow' (n : ℕ) (hn : 0 < n) (x : B) (hx : x ∈ B.ideal) :
    toDerivation (B.dividedPowers.dpow n x) =
      B.dividedPowers.dpow (n - 1) x • toDerivation x

namespace DividedPowerDerivation

variable {A : Type u} [CommRing A]
  {B : DividedPowerRing.{v}} {f : A →+* B}
  {M : Type w} [AddCommGroup M] [Module B M]

/-- A divided power derivation coerces to its underlying function. -/
public instance : CoeFun (DividedPowerDerivation A B f M) (fun _ ↦ B → M) :=
  ⟨fun D ↦ D.toDerivation⟩

/-- Divided power derivations are determined by their values. -/
@[ext]
public theorem ext {D E : DividedPowerDerivation A B f M} (h : ∀ x, D x = E x) : D = E := by
  cases D; cases E; simpa only [mk.injEq] using Derivation.ext (fun x ↦ h x)

/-- A divided power derivation is additive. -/
@[simp]
public theorem map_add (D : DividedPowerDerivation A B f M) (x y : B) :
    D (x + y) = D x + D y :=
  D.toDerivation.map_add x y

/-- A divided power derivation maps zero to zero. -/
@[simp]
public theorem map_zero (D : DividedPowerDerivation A B f M) : D 0 = 0 :=
  D.toDerivation.map_zero

/-- A divided power derivation vanishes on the image of the base ring. -/
@[simp]
public theorem map_ringHom (D : DividedPowerDerivation A B f M) (a : A) :
    D (f a) = 0 :=
  D.map_ringHom' a

/-- The Leibniz rule for a divided power derivation. -/
public theorem leibniz (D : DividedPowerDerivation A B f M) (x y : B) :
    D (x * y) = x • D y + y • D x :=
  D.toDerivation.leibniz x y

/-- The divided power chain rule for a divided power derivation. -/
public theorem map_dpow (D : DividedPowerDerivation A B f M) (n : ℕ) (hn : 0 < n)
    (x : B) (hx : x ∈ B.ideal) :
    D (B.dividedPowers.dpow n x) = B.dividedPowers.dpow (n - 1) x • D x :=
  D.map_dpow' n hn x hx

/-- Coercion to the underlying function is injective. -/
public theorem coe_injective : Function.Injective
    (fun D : DividedPowerDerivation A B f M ↦ (D : B → M)) :=
  fun _ _ h ↦ ext (congrFun h)

/-- The zero divided power derivation. -/
public instance : Zero (DividedPowerDerivation A B f M) :=
  ⟨{ toDerivation := 0
     map_ringHom' := fun _ ↦ rfl
     map_dpow' := by simp }⟩

/-- The zero divided power derivation is the zero function. -/
@[simp]
public theorem coe_zero : ((0 : DividedPowerDerivation A B f M) : B → M) = 0 :=
  rfl

/-- The pointwise sum of two divided power derivations. -/
public instance : Add (DividedPowerDerivation A B f M) :=
  ⟨fun D E ↦
    { toDerivation := D.toDerivation + E.toDerivation
      map_ringHom' := by simp
      map_dpow' := by
        intro n hn x hx
        change D _ + E _ = _ • (D x + E x)
        rw [D.map_dpow n hn x hx, E.map_dpow n hn x hx, smul_add] }⟩

/-- The sum of two divided power derivations is computed pointwise. -/
@[simp]
public theorem coe_add (D E : DividedPowerDerivation A B f M) :
    ((D + E : DividedPowerDerivation A B f M) : B → M) = D + E :=
  rfl

section Scalar

variable {S : Type*} [Monoid S] [DistribMulAction S M]
  [SMulCommClass ℤ S M] [SMulCommClass S B M]

/-- Scalar multiplication of divided power derivations is pointwise. -/
public instance : SMul S (DividedPowerDerivation A B f M) :=
  ⟨fun s D ↦
    { toDerivation := s • D.toDerivation
      map_ringHom' := by simp
      map_dpow' := by
        intro n hn x hx
        change s • D _ = _ • (s • D x)
        rw [D.map_dpow n hn x hx, smul_comm] }⟩

/-- A scalar multiple of a divided power derivation is computed pointwise. -/
@[simp]
public theorem coe_smul (s : S) (D : DividedPowerDerivation A B f M) :
    ((s • D : DividedPowerDerivation A B f M) : B → M) = s • (D : B → M) :=
  rfl

end Scalar

/-- Divided power derivations into a fixed module form an additive commutative monoid under
pointwise operations. -/
public instance : AddCommMonoid (DividedPowerDerivation A B f M) :=
  coe_injective.addCommMonoid _ coe_zero coe_add fun _ _ ↦ rfl

/-- Evaluation of divided power derivations, as an additive homomorphism into the space of
functions. -/
public def coeFnAddMonoidHom : DividedPowerDerivation A B f M →+ B → M where
  toFun := (⇑)
  map_zero' := coe_zero
  map_add' := coe_add

/-- The ring `B` acts distributively on divided power derivations, pointwise. -/
public instance : DistribMulAction B (DividedPowerDerivation A B f M) :=
  Function.Injective.distribMulAction coeFnAddMonoidHom coe_injective coe_smul

/-- Divided power derivations into a fixed module form a module under pointwise operations. -/
public instance : Module B (DividedPowerDerivation A B f M) :=
  Function.Injective.module B coeFnAddMonoidHom coe_injective coe_smul

/-- The pointwise negative of a divided power derivation. -/
public instance : Neg (DividedPowerDerivation A B f M) :=
  ⟨fun D ↦
    { toDerivation := -D.toDerivation
      map_ringHom' := by simp
      map_dpow' := by
        intro n hn x hx
        change -D _ = _ • (-D x)
        rw [D.map_dpow n hn x hx, smul_neg] }⟩

/-- The negative of a divided power derivation is computed pointwise. -/
@[simp]
public theorem coe_neg (D : DividedPowerDerivation A B f M) :
    ((-D : DividedPowerDerivation A B f M) : B → M) = -D :=
  rfl

/-- The pointwise difference of two divided power derivations. -/
public instance : Sub (DividedPowerDerivation A B f M) :=
  ⟨fun D E ↦
    { toDerivation := D.toDerivation - E.toDerivation
      map_ringHom' := by simp
      map_dpow' := by
        intro n hn x hx
        change D _ - E _ = _ • (D x - E x)
        rw [D.map_dpow n hn x hx, E.map_dpow n hn x hx, smul_sub] }⟩

/-- The difference of two divided power derivations is computed pointwise. -/
@[simp]
public theorem coe_sub (D E : DividedPowerDerivation A B f M) :
    ((D - E : DividedPowerDerivation A B f M) : B → M) = D - E :=
  rfl

/-- Divided power derivations into a fixed module form an additive commutative group under
pointwise operations. -/
public instance : AddCommGroup (DividedPowerDerivation A B f M) :=
  coe_injective.addCommGroup _ coe_zero coe_add coe_neg coe_sub
    (fun _ _ ↦ rfl) fun _ _ ↦ rfl

end DividedPowerDerivation

end Derivations

/-! ### The universal property of the divided power differentials -/

section UniversalProperty

universe u v w

variable {A : Type u} [CommRing A]
variable (B : DividedPowerRing.{v}) [Algebra A B]

/-- The quotient of Kähler differentials by the divided power relations represents
divided-power-compatible `A`-derivations. -/
@[stacks 07HZ "the universal divided power derivation"]
public theorem dividedPowerDifferentials_lift
    {M : Type w} [AddCommGroup M] [Module B M]
    (D : DividedPowerDerivation A B (algebraMap A B) M) :
    ∃! lift :
        dividedPowerDifferentials (A := A) B.dividedPowers →ₗ[B] M,
      ∀ b : B,
        lift (dividedPowerDifferential (A := A) B.dividedPowers b) = D b := by
  let rel := dividedPowerDifferentialRelations (A := A) B.dividedPowers
  let _ : Module A M := Module.compHom M (algebraMap A B)
  let _ : IsScalarTower A B M := IsScalarTower.of_algebraMap_smul (fun _ _ => rfl)
  let dA : Derivation A B M :=
    { toFun := D
      map_add' := D.map_add
      map_smul' := by
        intro a b
        rw [Algebra.smul_def, D.leibniz, D.map_ringHom, smul_zero, add_zero]
        rfl
      map_one_eq_zero' := D.map_one_eq_zero
      leibniz' := D.leibniz }
  let f : Ω[B⁄A] →ₗ[B] M := dA.liftKaehlerDifferential
  have hrel : rel ≤ LinearMap.ker f := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨x, n⟩, rfl⟩
    change f (dividedPowerDifferentialRelation (A := A) B.dividedPowers x n) = 0
    simp only [dividedPowerDifferentialRelation, map_sub, map_smul]
    change dA.liftKaehlerDifferential
        (KaehlerDifferential.D A B (B.dividedPowers.dpow (n + 1) x)) -
      B.dividedPowers.dpow n x • dA.liftKaehlerDifferential
        (KaehlerDifferential.D A B x) = 0
    rw [dA.liftKaehlerDifferential_comp_D, dA.liftKaehlerDifferential_comp_D]
    change D (B.dividedPowers.dpow (n + 1) x) - B.dividedPowers.dpow n x • D x = 0
    simp [D.map_dpow (n + 1) (by omega) x x.property]
  let lift : dividedPowerDifferentials (A := A) B.dividedPowers →ₗ[B] M :=
    rel.liftQ f hrel
  have hlift (b : B) :
      lift (dividedPowerDifferential (A := A) B.dividedPowers b) = D b := by
    change (rel.liftQ f hrel) (rel.mkQ (KaehlerDifferential.D A B b)) = D b
    rw [← LinearMap.comp_apply, rel.liftQ_mkQ]
    exact dA.liftKaehlerDifferential_comp_D b
  refine ⟨lift, hlift, ?_⟩
  intro g hg
  apply LinearMap.ext_on (dividedPowerDifferentials_span (A := A) B.dividedPowers)
  rintro _ ⟨b, rfl⟩
  rw [hg b, hlift b]

end UniversalProperty

/-! ### Descent of the de Rham differential -/

section DeRhamDescent

open Stacks.DeRham.DifferentialDescent

universe u

variable {A : Type u} [CommRing A]
variable (B : DividedPowerRing.{u}) [Algebra A B]

/-- The quotient projection satisfies the generation hypothesis for descending the de Rham
differential to divided power differential forms. -/
@[stacks 07HZ "descent of the de Rham differential"]
public theorem dividedPowerDifferentials_generationHypothesis
    (S : SourceDeRham A B) :
    S.GenerationHypothesis
      (dividedPowerDifferentialRelations (A := A) B.dividedPowers).mkQ :=
  generationHypothesis_of_ker_eq_relations B.dividedPowers S _ (Submodule.ker_mkQ _)

end DeRhamDescent

/-! ### Divided power differentials of a quotient -/

section Quotient

universe u v

/-- A derivation killing an ideal `K` descends to a derivation of the quotient ring, since its
underlying additive map factors through `B ⧸ K`. -/
public def derivationQuotient
    {A B M : Type*} [CommRing A] [CommRing B] [Algebra A B]
    {K : Ideal B} [AddCommGroup M] [Module (B ⧸ K) M] [Module B M] [Module A M]
    [IsScalarTower B (B ⧸ K) M] [Algebra A (B ⧸ K)]
    [IsScalarTower A B M]
    [IsScalarTower A (B ⧸ K) M]
    (hAlg : algebraMap A (B ⧸ K) = (Ideal.Quotient.mk K).comp (algebraMap A B))
    (D : Derivation A B M) (hD : ∀ k ∈ K, D k = 0) :
    Derivation A (B ⧸ K) M := by
  letI : Module A (B ⧸ K) := Algebra.toModule
  let D' : B ⧸ K →+ M :=
    QuotientAddGroup.lift K.toAddSubgroup D.toAddMonoidHom (by
      intro k hk
      exact AddMonoidHom.mem_ker.mpr (hD k hk))
  refine {
    toLinearMap := {
      toFun := D'
      map_add' := D'.map_add
      map_smul' := ?_ }
    map_one_eq_zero' := ?_
    leibniz' := ?_ }
  · intro a x
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective x
    rw [Algebra.smul_def, hAlg]
    simp only [RingHom.comp_apply, D', ← map_mul]
    change D (algebraMap A B a * b) = a • D b
    rw [← Algebra.smul_def, D.map_smul]
  · change D (1 : B) = 0
    exact D.map_one_eq_zero
  · intro x y
    obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective y
    change D (x * y) = (algebraMap B (B ⧸ K) x) • D y +
      (algebraMap B (B ⧸ K) y) • D x
    rw [D.leibniz]
    simp only [IsScalarTower.algebraMap_smul]

variable {A : Type u} [CommRing A]
variable (B : DividedPowerRing.{v}) [Algebra A B]

/-- The canonical quotient formula for divided power differentials. -/
@[stacks 07HS "quotient"]
public noncomputable def dividedPowerDifferentialsQuotientEquiv
    (K : Ideal B) (hK : DividedPowers.IsSubDPIdeal B.dividedPowers K) :
    let δ' := DividedPowers.Quotient.dividedPowers B.dividedPowers
      (J := K) (by simpa [inf_of_le_left hK.isSubideal] using hK)
    { e :
        (TensorProduct B (B ⧸ K)
          (dividedPowerDifferentials (A := A) B.dividedPowers) ⧸
          Submodule.span (B ⧸ K)
            (Set.range fun k : K ↦ TensorProduct.tmul B (1 : B ⧸ K)
              (dividedPowerDifferential (A := A) B.dividedPowers k)))
          ≃ₗ[B ⧸ K]
          dividedPowerDifferentials (A := A) δ' //
      ∀ b : B,
        e (Submodule.Quotient.mk
          (TensorProduct.tmul B (1 : B ⧸ K)
            (dividedPowerDifferential (A := A) B.dividedPowers b))) =
          dividedPowerDifferential (A := A) δ' (Ideal.Quotient.mk K b) } := by
  classical
  let B' := B ⧸ K
  let q : B →+* B' := Ideal.Quotient.mk K
  let hIJ : DividedPowers.IsSubDPIdeal B.dividedPowers (K ⊓ B.ideal) :=
    by simpa [inf_of_le_left hK.isSubideal] using hK
  let δ' := DividedPowers.Quotient.dividedPowers B.dividedPowers (J := K) hIJ
  let T₀ := dividedPowerDifferentials (A := A) B.dividedPowers
  let d₀ := dividedPowerDifferential (A := A) B.dividedPowers
  let N : Submodule B' (TensorProduct B B' T₀) :=
    Submodule.span B' (Set.range fun k : K ↦ TensorProduct.tmul B (1 : B') (d₀ k))
  let M := (TensorProduct B B' T₀) ⧸ N
  let tm : T₀ →ₗ[B] TensorProduct B B' T₀ :=
    (TensorProduct.AlgebraTensorModule.mk B B' B' T₀) 1
  let dmap : T₀ →ₗ[B] M := (N.mkQ.restrictScalars B).comp tm
  let ψ : Ω[B⁄A] →ₗ[B] M := dmap.comp (dividedPowerDifferentialRelations (A := A)
    B.dividedPowers).mkQ
  let D : Derivation A B M := Derivation.llcomp ψ (KaehlerDifferential.D A B)
  have D_apply (b : B) : D b = Submodule.Quotient.mk
      (TensorProduct.tmul B (1 : B') (d₀ b)) := by
    change N.mkQ (tm ((dividedPowerDifferentialRelations (A := A)
      B.dividedPowers).mkQ (KaehlerDifferential.D A B b))) = _
    rfl
  have D_k (k : B) (hk : k ∈ K) : D k = 0 := by
    rw [D_apply]
    exact (Submodule.Quotient.mk_eq_zero N).2 (Submodule.subset_span ⟨⟨k, hk⟩, rfl⟩)
  have D_dpow {n : ℕ} (hn : 0 < n) {b : B} (hb : b ∈ B.ideal) :
      D (B.dividedPowers.dpow n b) = B.dividedPowers.dpow (n - 1) b • D b := by
    obtain ⟨m, rfl⟩ := (Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn))
    have h := congrArg dmap (dividedPowerDifferential_dpow (A := A)
      (hJ := B.dividedPowers) ⟨b, hb⟩ m)
    rw [map_smul] at h
    change dmap (d₀ (B.dividedPowers.dpow (m + 1) b)) =
      B.dividedPowers.dpow m b • dmap (d₀ b)
    simpa [d₀] using h
  have hAlg : algebraMap A B' = q.comp (algebraMap A B) :=
    IsScalarTower.algebraMap_eq A B B'
  let Dq : Derivation A B' M := derivationQuotient hAlg D D_k
  have Dq_mk (b : B) : Dq (q b) = D b := by
    have hN : K.toAddSubgroup ≤ D.toAddMonoidHom.ker := fun k hk ↦
      AddMonoidHom.mem_ker.mpr (D_k k hk)
    change (QuotientAddGroup.lift K.toAddSubgroup D.toAddMonoidHom hN)
      (Ideal.Quotient.mk K b) = D b
    exact QuotientAddGroup.lift_mk K.toAddSubgroup hN b
  have Dq_dpow {n : ℕ} (hn : 0 < n) {b : B} (hb : b ∈ B.ideal) :
      Dq (δ'.dpow n (q b)) = δ'.dpow (n - 1) (q b) • Dq (q b) := by
    rw [DividedPowers.Quotient.dpow_apply B.dividedPowers hIJ hb, Dq_mk,
      DividedPowers.Quotient.dpow_apply (n := n - 1) B.dividedPowers hIJ hb, Dq_mk,
      D_dpow hn hb, ← Ideal.Quotient.algebraMap_eq]
    exact (IsScalarTower.algebraMap_smul B' _ _).symm
  have Dq_dpow' {n : ℕ} (hn : 0 < n) {x : B'}
      (hx : x ∈ B.ideal.map q) :
      Dq (δ'.dpow n x) = δ'.dpow (n - 1) x • Dq x := by
    obtain ⟨b, hb, rfl⟩ := (Ideal.mem_map_iff_of_surjective q
      Ideal.Quotient.mk_surjective).mp hx
    exact Dq_dpow hn hb
  let T := dividedPowerDifferentials (A := A) δ'
  let Rq := dividedPowerDifferentialRelations (A := A) δ'
  let Lq : Ω[B'⁄A] →ₗ[B'] M := Dq.liftKaehlerDifferential
  have hRq : Rq ≤ Lq.ker := by
    change Submodule.span B'
      (Set.range fun z : (B.ideal.map q) × ℕ ↦
        dividedPowerDifferentialRelation (A := A) δ' z.1 z.2) ≤ Lq.ker
    apply Submodule.span_le.2
    rintro _ ⟨⟨x, m⟩, rfl⟩
    change Lq (KaehlerDifferential.D A B' (δ'.dpow (m + 1) x) -
      δ'.dpow m x • KaehlerDifferential.D A B' x) = 0
    rw [map_sub, map_smul, Derivation.liftKaehlerDifferential_comp_D,
      Derivation.liftKaehlerDifferential_comp_D]
    change Dq (δ'.dpow (m + 1) x) - δ'.dpow m x • Dq x = 0
    rw [Dq_dpow' (Nat.succ_pos m) x.property]
    simp
  let g : T →ₗ[B'] M := Rq.liftQ Lq hRq
  have g_apply (x : B') : g (dividedPowerDifferential (A := A) δ' x) = Dq x := by
    change Lq (KaehlerDifferential.D A B' x) = Dq x
    exact Derivation.liftKaehlerDifferential_comp_D Dq x
  have hspanT : Submodule.span B' (Set.range (dividedPowerDifferential (A := A) δ')) = ⊤ :=
    dividedPowerDifferentials_span (A := A) δ'
  let Dt : Derivation A B' T := Derivation.llcomp Rq.mkQ (KaehlerDifferential.D A B')
  have Dt_apply (x : B') : Dt x = dividedPowerDifferential (A := A) δ' x := rfl
  have Dt_dpow {n : ℕ} (hn : 0 < n) {x : B'} (hx : x ∈ B.ideal.map q) :
      Dt (δ'.dpow n x) = δ'.dpow (n - 1) x • Dt x := by
    obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
    rw [Dt_apply, Dt_apply]
    simpa [Nat.succ_sub_one] using
      dividedPowerDifferential_dpow (A := A) (hJ := δ') ⟨x, hx⟩ m
  let Dc : Derivation A B T := Derivation.compAlgebraMap B Dt
  have Dc_apply (b : B) : Dc b = dividedPowerDifferential (A := A) δ' (q b) := rfl
  have Dc_dpow {n : ℕ} (hn : 0 < n) {b : B} (hb : b ∈ B.ideal) :
      Dc (B.dividedPowers.dpow n b) = B.dividedPowers.dpow (n - 1) b • Dc b := by
    obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
    change dividedPowerDifferential (A := A) δ'
        (q (B.dividedPowers.dpow (m + 1) b)) =
      B.dividedPowers.dpow m b • dividedPowerDifferential (A := A) δ' (q b)
    calc
      _ = dividedPowerDifferential (A := A) δ'
          (δ'.dpow (m + 1) (q b)) := by
            rw [← DividedPowers.Quotient.dpow_apply B.dividedPowers hIJ hb]
      _ = δ'.dpow m (q b) • dividedPowerDifferential (A := A) δ' (q b) :=
        dividedPowerDifferential_dpow (A := A) (hJ := δ')
          ⟨q b, Ideal.mem_map_of_mem q hb⟩ m
      _ = q (B.dividedPowers.dpow m b) •
          dividedPowerDifferential (A := A) δ' (q b) := by
            rw [DividedPowers.Quotient.dpow_apply (n := m) B.dividedPowers hIJ hb]
      _ = B.dividedPowers.dpow m b •
          dividedPowerDifferential (A := A) δ' (q b) :=
        (@IsScalarTower.algebraMap_smul B B' T _ _ _ _ _ _
          (B.dividedPowers.dpow m b) _).symm
  let Lc : Ω[B⁄A] →ₗ[B] T := Dc.liftKaehlerDifferential
  let R0 := dividedPowerDifferentialRelations (A := A) B.dividedPowers
  have hR0 : R0 ≤ Lc.ker := by
    change Submodule.span B
      (Set.range fun z : B.ideal × ℕ ↦
        dividedPowerDifferentialRelation (A := A) B.dividedPowers z.1 z.2) ≤ Lc.ker
    apply Submodule.span_le.2
    rintro _ ⟨⟨x, m⟩, rfl⟩
    change Lc (KaehlerDifferential.D A B (B.dividedPowers.dpow (m + 1) x) -
      B.dividedPowers.dpow m x • KaehlerDifferential.D A B x) = 0
    rw [map_sub, map_smul,
      Derivation.liftKaehlerDifferential_comp_D,
      Derivation.liftKaehlerDifferential_comp_D]
    change Dc (B.dividedPowers.dpow (m + 1) x) -
      B.dividedPowers.dpow m x • Dc x = 0
    rw [Dc_dpow (Nat.succ_pos m) x.property]
    simp
  let φ : T₀ →ₗ[B] T := R0.liftQ Lc hR0
  have φ_apply (b : B) : φ (d₀ b) = dividedPowerDifferential (A := A) δ' (q b) := by
    change Lc (KaehlerDifferential.D A B b) = _
    exact Derivation.liftKaehlerDifferential_comp_D Dc b
  let F0 : TensorProduct B B' T₀ →ₗ[B'] T :=
    TensorProduct.AlgebraTensorModule.lift
      (LinearMap.smulRight (LinearMap.id : B' →ₗ[B'] B') φ)
  have hN : N ≤ F0.ker := by
    apply Submodule.span_le.2
    rintro _ ⟨k, rfl⟩
    change F0 (TensorProduct.tmul B (1 : B') (d₀ (k : B))) = 0
    dsimp [F0]
    simp only [one_smul]
    rw [φ_apply]
    rw [Ideal.Quotient.eq_zero_iff_mem.mpr k.property]
    change Rq.mkQ (KaehlerDifferential.D A B' 0) = 0
    simp
  let F : M →ₗ[B'] T := N.liftQ F0 hN
  have F_apply (b : B) :
    F (Submodule.Quotient.mk (TensorProduct.tmul B (1 : B') (d₀ b))) =
        dividedPowerDifferential (A := A) δ' (q b) := by
    change F0 (TensorProduct.tmul B (1 : B') (d₀ b)) = _
    dsimp [F0]
    simp [φ_apply]
  have hspanT₀ : Submodule.span B (Set.range d₀) = ⊤ :=
    dividedPowerDifferentials_span (A := A) B.dividedPowers
  have hmapd : Submodule.map dmap (Submodule.span B (Set.range d₀)) ≤
      (Submodule.span B' (Set.range fun b : B ↦ N.mkQ
        (TensorProduct.tmul B (1 : B') (d₀ b)))).restrictScalars B := by
    rw [Submodule.map_span]
    exact Submodule.span_le.2 fun _ ⟨_, ⟨b, rfl⟩, h⟩ => h ▸ Submodule.subset_span ⟨b, rfl⟩
  have hspanM : Submodule.span B'
      (Set.range fun b : B ↦ N.mkQ
        (TensorProduct.tmul B (1 : B') (d₀ b))) = ⊤ := by
    apply le_antisymm le_top
    intro y hy
    obtain ⟨z, rfl⟩ := N.mkQ_surjective y
    clear hy
    induction z using TensorProduct.induction_on with
    | zero => simp
    | add x y hx hy => simpa only [map_add] using add_mem hx hy
    | tmul b x =>
        have hx : x ∈ Submodule.span B (Set.range d₀) := by
          rw [hspanT₀]
          exact Submodule.mem_top
        have hx' : dmap x ∈ Submodule.span B' (Set.range fun b : B ↦
            N.mkQ (TensorProduct.tmul B (1 : B') (d₀ b))) :=
          hmapd (Submodule.mem_map_of_mem hx)
        have hfactor : TensorProduct.tmul B b x =
            b • TensorProduct.tmul B (1 : B') x := by
          simpa using (TensorProduct.smul_tmul' b (1 : B') x).symm
        rw [hfactor, map_smul]
        change b • dmap x ∈ _
        exact Submodule.smul_mem _ _ hx'
  have hGFgen (b : B) :
      g (F (Submodule.Quotient.mk
        (TensorProduct.tmul B (1 : B') (d₀ b)))) =
        Submodule.Quotient.mk (TensorProduct.tmul B (1 : B') (d₀ b)) := by
    rw [F_apply, g_apply, Dq_mk, D_apply]
  have hGF : g.comp F = LinearMap.id := LinearMap.ext_on_range hspanM hGFgen
  have hFGgen (x : B') :
      F (g (dividedPowerDifferential (A := A) δ' x)) =
        dividedPowerDifferential (A := A) δ' x := by
    obtain ⟨b, rfl⟩ := q.surjective x
    rw [g_apply, Dq_mk, D_apply, F_apply]
  have hFG : F.comp g = LinearMap.id := LinearMap.ext_on_range hspanT hFGgen
  exact ⟨LinearEquiv.ofLinearMap F g hFG hGF, F_apply⟩

end Quotient

end Crystalline

