module

public import
  StacksFrontier.AlgebraicGeometry.Crystalline.Differentials.CompletedPolynomialDecomposition

/-!
# The filtration by coefficient degree is finite in each exterior degree

Let `A` be a ring, let `(B, I, δ)` be a divided power ring which is an `A`-algebra, let `W` index
a family of divided power variables, let `P = B⟨x_w : w ∈ W⟩` and let `D'` be the `p`-adic
completion of `P`.  `Crystalline.DividedPowerPolynomial.dividedPowerPolynomialFormsEquiv` and its
completion `..._completedDividedPowerPolynomialFormsEquiv` put the forms of `P` in bidegree form,

`Ωⁿ_{P/A,δ'} = ⨁_{i + j = n} ((⋀ⁱ_P (P ⊗_B Ω¹_{B/A,δ})) ⊗_P (⋀ʲ_P (W →₀ P)))`,

the summand `(i, j)` being the one with `i` coefficient differentials and `j` variable
differentials.  The filtration of the proof of [Stacks, Lemma 60.21.2, Tag 07LD] is

`F^k = σ_{≥k} Ω^*_B ∧ Ω^*_P`,

i.e. in exterior degree `n` the span of the summands with at least `k` coefficient differentials.
This module shows that **`F^k` meets exterior degree `n` in `0` as soon as `k > n`**, since there
is no summand with `i + j = n` and `i ≥ k > n`. The filtration is therefore finite in each degree,
and an operator that raises `k` by one is nilpotent.

The filtration `Crystalline.DividedPowerPolynomial.antidiagonalCoefficientFiltration` is defined
for an arbitrary family of modules indexed by the antidiagonal `{(i, j) : i + j = n}`; it is the
span of the summands with at least `k` in the first coordinate.

## Main definitions

* `Crystalline.DividedPowerPolynomial.antidiagonalCoefficientFiltration` — `F^k` on a direct sum
  over the antidiagonal of `n`: the span of the summands with at least `k` in the first
  coordinate.
* `Crystalline.DividedPowerPolynomial.polynomialFormsCoefficientFiltration` and
  `..._completedPolynomialFormsCoefficientFiltration` — the same filtration read on `Ωⁿ_{P/A,δ'}`
  and on `Ω̂ⁿ_{D'}` through the two decompositions.

## Main results

* `Crystalline.DividedPowerPolynomial.antidiagonalCoefficientFiltration_eq_bot` — **the
  filtration vanishes in exterior degree `n` from `k = n + 1` on**.
* `Crystalline.DividedPowerPolynomial.antidiagonalCoefficientFiltration_zero` — it exhausts in
  `k = 0`, so together with the previous item it is a filtration of finite length `n + 1`.
* `Crystalline.DividedPowerPolynomial.iterate_eq_zero_of_filtration` — **an operator that raises
  the step of a filtration of finite length is nilpotent**, stated over an abstract filtration.
* `Crystalline.DividedPowerPolynomial.iterate_eq_zero_of_raisesCoefficientDegree` — **an operator
  that raises the coefficient degree of each bidegree summand by one dies after `n + 1` steps in
  exterior degree `n`**.
* `Crystalline.DividedPowerPolynomial.iterate_eq_zero_of_raisesProjectionDegree` — the same
  nilpotence, read off a finite family of additive projections onto the summands.
* `..._polynomialFormsCoefficientFiltration_eq_bot` and
  `..._completedPolynomialFormsCoefficientFiltration_eq_bot` — the vanishing on `Ωⁿ_{P/A,δ'}` and
  on `Ω̂ⁿ_{D'}`.

## References

* [Stacks Project, Lemma 60.21.2, Tag 07LD](https://stacks.math.columbia.edu/tag/07LD)
* [Stacks Project, Proposition 60.21.3, Tag 07LG](https://stacks.math.columbia.edu/tag/07LG)
* [Stacks Project, Tag 07HS](https://stacks.math.columbia.edu/tag/07HS)
-/

@[expose] public noncomputable section

open DividedPowers

universe uA uB uW uR uS uM

namespace Crystalline

namespace DividedPowerPolynomial

/-! ### The filtration by coefficient degree on a direct sum over an antidiagonal -/

section Antidiagonal

variable (R : Type uR) [CommRing R] (n : ℕ)
  (S : {ij : ℕ × ℕ // ij.1 + ij.2 = n} → Type uS) [∀ ij, AddCommGroup (S ij)]
  [∀ ij, Module R (S ij)]

/-- **The step `k` of the filtration by coefficient degree**, on a direct sum of modules indexed
by the antidiagonal `{(i, j) : i + j = n}` of `n`: the span of the summands whose first
coordinate — the number of coefficient differentials — is at least `k`.

This is the `F^k = σ_{≥k} Ω^*_B ∧ Ω^*_P` of [Stacks, Lemma 60.21.2, Tag 07LD] read in exterior
degree `n` through the bidegree decomposition. -/
public def antidiagonalCoefficientFiltration (k : ℕ) :
    Submodule R (DirectSum {ij : ℕ × ℕ // ij.1 + ij.2 = n} S) :=
  ⨆ ij : {ij : ℕ × ℕ // ij.1 + ij.2 = n}, ⨆ _ : k ≤ ij.1.1,
    LinearMap.range (DirectSum.lof R {ij : ℕ × ℕ // ij.1 + ij.2 = n} S ij)

/-- A summand whose coefficient degree is at least `k` lies in the step `k`. -/
public theorem lof_mem_antidiagonalCoefficientFiltration {k : ℕ}
    {ij : {ij : ℕ × ℕ // ij.1 + ij.2 = n}} (hk : k ≤ ij.1.1) (x : S ij) :
    DirectSum.lof R {ij : ℕ × ℕ // ij.1 + ij.2 = n} S ij x ∈
      antidiagonalCoefficientFiltration R n S k :=
  Submodule.mem_iSup_of_mem ij (Submodule.mem_iSup_of_mem hk (LinearMap.mem_range_self _ x))

/-- **The step `k` is generated by the summands of coefficient degree at least `k`**: to bound it
by a submodule it is enough to bound those summands. -/
public theorem antidiagonalCoefficientFiltration_le {k : ℕ}
    {N : Submodule R (DirectSum {ij : ℕ × ℕ // ij.1 + ij.2 = n} S)}
    (h : ∀ ij : {ij : ℕ × ℕ // ij.1 + ij.2 = n}, k ≤ ij.1.1 → ∀ x : S ij,
      DirectSum.lof R {ij : ℕ × ℕ // ij.1 + ij.2 = n} S ij x ∈ N) :
    antidiagonalCoefficientFiltration R n S k ≤ N := by
  refine iSup_le fun ij ↦ iSup_le fun hk ↦ ?_
  rintro y ⟨x, rfl⟩
  exact h ij hk x

/-- **Every element lies in the step `0`.** -/
public theorem mem_antidiagonalCoefficientFiltration_zero
    (x : DirectSum {ij : ℕ × ℕ // ij.1 + ij.2 = n} S) :
    x ∈ antidiagonalCoefficientFiltration R n S 0 := by
  induction x using DirectSum.induction_on with
  | zero => exact Submodule.zero_mem _
  | of ij y => exact lof_mem_antidiagonalCoefficientFiltration R n S (Nat.zero_le _) y
  | add y z hy hz => exact Submodule.add_mem _ hy hz

/-- **The filtration exhausts at `k = 0`.** -/
public theorem antidiagonalCoefficientFiltration_zero :
    antidiagonalCoefficientFiltration R n S 0 = ⊤ :=
  eq_top_iff.2 fun x _ ↦ mem_antidiagonalCoefficientFiltration_zero R n S x

/-- The filtration decreases. -/
public theorem antidiagonalCoefficientFiltration_antitone {k l : ℕ} (hkl : k ≤ l) :
    antidiagonalCoefficientFiltration R n S l ≤ antidiagonalCoefficientFiltration R n S k :=
  antidiagonalCoefficientFiltration_le R n S fun _ hk x ↦
    lof_mem_antidiagonalCoefficientFiltration R n S (le_trans hkl hk) x

/-- **The filtration by coefficient degree vanishes in exterior degree `n` from `k = n + 1`
on.** -/
public theorem antidiagonalCoefficientFiltration_eq_bot {k : ℕ} (hk : n < k) :
    antidiagonalCoefficientFiltration R n S k = ⊥ :=
  iSup_eq_bot.2 fun ij ↦ iSup_neg fun hle ↦
    absurd (le_trans hle (Nat.le.intro ij.2)) (Nat.not_le_of_lt hk)

/-! ### Nilpotence of an operator that raises the filtration -/

/-- **An operator that raises the step of a filtration of finite length is nilpotent.**  If every
element lies in `F^0`, if `T` carries `F^k` into `F^{k+1}`, and if `F^{n+1} = 0`, then `T` iterated
`n + 1` times is zero. The filtration is an arbitrary family of submodules; it is not assumed to
decrease. -/
public theorem iterate_eq_zero_of_filtration {M : Type uM} [AddCommGroup M] [Module R M]
    (F : ℕ → Submodule R M) (T : M →ₗ[R] M) (htop : ∀ x : M, x ∈ F 0)
    (hT : ∀ (k : ℕ) (x : M), x ∈ F k → T x ∈ F (k + 1)) (hbot : F (n + 1) = ⊥) (x : M) :
    (fun y ↦ T y)^[n + 1] x = 0 := by
  have hstep (k : ℕ) : (fun y ↦ T y)^[k] x ∈ F k := by
    induction k with
    | zero => exact htop x
    | succ l hl => rw [Function.iterate_succ_apply']; exact hT l _ hl
  simpa [hbot] using hstep (n + 1)

/-- An endomorphism whose `n + 1`-fold iterate vanishes pointwise has vanishing power. -/
private theorem pow_eq_zero_of_iterate_eq_zero {M : Type uM} [AddCommGroup M] [Module R M]
    (T : M →ₗ[R] M) (h : ∀ x : M, (fun y ↦ T y)^[n + 1] x = 0) :
    (T : Module.End R M) ^ (n + 1) = 0 :=
  LinearMap.ext fun x ↦ (Module.End.pow_apply T (n + 1) x).trans (h x)

/-- The same, read as a power of an endomorphism: `T ^ (n + 1) = 0`. -/
public theorem pow_eq_zero_of_filtration {M : Type uM} [AddCommGroup M] [Module R M]
    (F : ℕ → Submodule R M) (T : M →ₗ[R] M) (htop : ∀ x : M, x ∈ F 0)
    (hT : ∀ (k : ℕ) (x : M), x ∈ F k → T x ∈ F (k + 1)) (hbot : F (n + 1) = ⊥) :
    (T : Module.End R M) ^ (n + 1) = 0 :=
  pow_eq_zero_of_iterate_eq_zero R n T (iterate_eq_zero_of_filtration R n F T htop hT hbot)

/-- **An operator that raises the coefficient degree of every bidegree summand by one raises the
filtration by one step.** -/
public theorem antidiagonalCoefficientFiltration_of_raisesCoefficientDegree
    (T : DirectSum {ij : ℕ × ℕ // ij.1 + ij.2 = n} S →ₗ[R]
      DirectSum {ij : ℕ × ℕ // ij.1 + ij.2 = n} S)
    (hT : ∀ (ij : {ij : ℕ × ℕ // ij.1 + ij.2 = n}) (x : S ij),
      T (DirectSum.lof R {ij : ℕ × ℕ // ij.1 + ij.2 = n} S ij x) ∈
        antidiagonalCoefficientFiltration R n S (ij.1.1 + 1))
    (k : ℕ) (x : DirectSum {ij : ℕ × ℕ // ij.1 + ij.2 = n} S)
    (hx : x ∈ antidiagonalCoefficientFiltration R n S k) :
    T x ∈ antidiagonalCoefficientFiltration R n S (k + 1) :=
  antidiagonalCoefficientFiltration_le R n S
    (N := Submodule.comap T (antidiagonalCoefficientFiltration R n S (k + 1)))
    (fun ij hk y ↦ antidiagonalCoefficientFiltration_antitone R n S
      (Nat.succ_le_succ hk) (hT ij y)) hx

/-- **An operator that raises the coefficient degree dies after `n + 1` steps in exterior degree
`n`.** If `T` carries each bidegree summand of coefficient degree `i` into the step `i + 1` of the
filtration, then `T` iterated `n + 1` times is zero. -/
public theorem iterate_eq_zero_of_raisesCoefficientDegree
    (T : DirectSum {ij : ℕ × ℕ // ij.1 + ij.2 = n} S →ₗ[R]
      DirectSum {ij : ℕ × ℕ // ij.1 + ij.2 = n} S)
    (hT : ∀ (ij : {ij : ℕ × ℕ // ij.1 + ij.2 = n}) (x : S ij),
      T (DirectSum.lof R {ij : ℕ × ℕ // ij.1 + ij.2 = n} S ij x) ∈
        antidiagonalCoefficientFiltration R n S (ij.1.1 + 1))
    (x : DirectSum {ij : ℕ × ℕ // ij.1 + ij.2 = n} S) :
    (fun y ↦ T y)^[n + 1] x = 0 :=
  iterate_eq_zero_of_filtration R n (antidiagonalCoefficientFiltration R n S) T
    (mem_antidiagonalCoefficientFiltration_zero R n S)
    (antidiagonalCoefficientFiltration_of_raisesCoefficientDegree R n S T hT)
    (antidiagonalCoefficientFiltration_eq_bot R n S (Nat.lt_succ_self n)) x

/-- The nilpotence of the previous result as a power of an endomorphism. -/
public theorem pow_eq_zero_of_raisesCoefficientDegree
    (T : DirectSum {ij : ℕ × ℕ // ij.1 + ij.2 = n} S →ₗ[R]
      DirectSum {ij : ℕ × ℕ // ij.1 + ij.2 = n} S)
    (hT : ∀ (ij : {ij : ℕ × ℕ // ij.1 + ij.2 = n}) (x : S ij),
      T (DirectSum.lof R {ij : ℕ × ℕ // ij.1 + ij.2 = n} S ij x) ∈
        antidiagonalCoefficientFiltration R n S (ij.1.1 + 1)) :
    (T : Module.End R (DirectSum {ij : ℕ × ℕ // ij.1 + ij.2 = n} S)) ^ (n + 1) = 0 :=
  pow_eq_zero_of_iterate_eq_zero R n T (iterate_eq_zero_of_raisesCoefficientDegree R n S T hT)

end Antidiagonal

/-! ### Nilpotence read off a finite family of projections -/

section Projections

/-- **An operator that raises the coefficient degree dies after `m` steps, read off the
projections onto the summands rather than off the span filtration.**

`pi i` is the projection onto the summand of coefficient degree `i`, of which there are `m` in the
exterior degree under consideration — so `∑_{i < m} pi i = id` — and the hypothesis on `T` is that
`pi l ∘ T ∘ pi i` vanishes whenever `l ≤ i`, which is what "raises the coefficient degree by one"
says. Unlike `Crystalline.DividedPowerPolynomial.iterate_eq_zero_of_raisesCoefficientDegree`,
`T` and the projections are only additive maps of an abelian group `C`. -/
public theorem iterate_eq_zero_of_raisesProjectionDegree {C : Type uM} [AddCommGroup C] (m : ℕ)
    (pi : ℕ → C →+ C) (T : C →+ C) (hsum : ∀ x : C, ∑ i ∈ Finset.range m, pi i x = x)
    (hT : ∀ (l i : ℕ), l ≤ i → ∀ x : C, pi l (T (pi i x)) = 0) (x : C) :
    (fun y ↦ T y)^[m] x = 0 := by
  have key : ∀ k : ℕ, ∀ l < k, pi l ((fun y ↦ T y)^[k] x) = 0 := by
    intro k
    induction k with
    | zero => exact fun l hl ↦ absurd hl (Nat.not_lt_zero l)
    | succ k ih =>
      intro l hl
      have hdec : ∑ i ∈ Finset.range m, T (pi i ((fun y ↦ T y)^[k] x)) =
          T ((fun y ↦ T y)^[k] x) := by
        rw [← map_sum, hsum]
      rw [Function.iterate_succ_apply', ← hdec, map_sum]
      refine Finset.sum_eq_zero fun i _ ↦ ?_
      rcases Nat.lt_or_ge i k with hik | hik
      · rw [ih i hik, map_zero, map_zero]
      · exact hT l i (le_trans (Nat.lt_succ_iff.mp hl) hik) _
  calc (fun y ↦ T y)^[m] x
      = ∑ i ∈ Finset.range m, pi i ((fun y ↦ T y)^[m] x) := (hsum _).symm
    _ = 0 := Finset.sum_eq_zero fun i hi ↦ key m i (Finset.mem_range.mp hi)

end Projections

/-! ### The filtration on the polynomial and completed forms -/

section Forms

variable (A : Type uA) [CommRing A] (B : DividedPowerRing.{uB}) [Algebra A B] (W : Type uW)

/-- The preimage of a vanishing submodule under a linear equivalence vanishes. -/
private theorem comap_equiv_eq_bot {R M N : Type*} [CommRing R] [AddCommGroup M] [Module R M]
    [AddCommGroup N] [Module R N] (e : M ≃ₗ[R] N) {F : Submodule R N} (h : F = ⊥) :
    F.comap e.toLinearMap = ⊥ := by
  rw [h, Submodule.comap_bot]
  exact LinearMap.ker_eq_bot.2 e.injective

/-- **The filtration by coefficient degree on `Ωⁿ_{P/A,δ'}`**, read through the bidegree
decomposition `Crystalline.DividedPowerPolynomial.dividedPowerPolynomialFormsEquiv`: the step `k`
is the span of the forms with at least `k` coefficient differentials. -/
public def polynomialFormsCoefficientFiltration (n k : ℕ) :
    Submodule (setIndexedDividedPowerPolynomialAlgebra B W)
      (dividedPowerDifferentialForms (A := A)
        (setIndexedDividedPowerPolynomialDividedPowers B W) n) :=
  Submodule.comap (dividedPowerPolynomialFormsEquiv A B W n).toLinearMap
    (antidiagonalCoefficientFiltration (setIndexedDividedPowerPolynomialAlgebra B W) n
      (fun ij ↦ polynomialBidegreeForms A B W ij.1.1 ij.1.2) k)

/-- **The filtration by coefficient degree on `Ωⁿ_{P/A,δ'}` vanishes from `k = n + 1` on.** -/
public theorem polynomialFormsCoefficientFiltration_eq_bot {n k : ℕ} (hk : n < k) :
    polynomialFormsCoefficientFiltration A B W n k = ⊥ := by
  exact comap_equiv_eq_bot _ (antidiagonalCoefficientFiltration_eq_bot _ n _ hk)

/-- The filtration by coefficient degree on `Ωⁿ_{P/A,δ'}` exhausts at `k = 0`. -/
public theorem polynomialFormsCoefficientFiltration_zero (n : ℕ) :
    polynomialFormsCoefficientFiltration A B W n 0 = ⊤ := by
  rw [polynomialFormsCoefficientFiltration,
    antidiagonalCoefficientFiltration_zero (setIndexedDividedPowerPolynomialAlgebra B W) n
      (fun ij ↦ polynomialBidegreeForms A B W ij.1.1 ij.1.2)]
  exact Submodule.comap_top _

variable (p : ℕ)

/-- **The filtration by coefficient degree on `Ω̂ⁿ_{D'}`**, read through the completed bidegree
decomposition
`Crystalline.DividedPowerPolynomial.completedDividedPowerPolynomialFormsEquiv`. -/
public def completedPolynomialFormsCoefficientFiltration (n k : ℕ) :
    Submodule (completedDividedPowerPolynomialRing B W p)
      (completedPolynomialForms A B W p n) :=
  Submodule.comap (completedDividedPowerPolynomialFormsEquiv A B W p n).toLinearMap
    (antidiagonalCoefficientFiltration (completedDividedPowerPolynomialRing B W p) n
      (fun ij ↦ completedPolynomialBidegreeForms A B W p ij.1.1 ij.1.2) k)

/-- **The filtration by coefficient degree on `Ω̂ⁿ_{D'}` vanishes from `k = n + 1` on.** -/
public theorem completedPolynomialFormsCoefficientFiltration_eq_bot {n k : ℕ} (hk : n < k) :
    completedPolynomialFormsCoefficientFiltration A B W p n k = ⊥ := by
  exact comap_equiv_eq_bot _ (antidiagonalCoefficientFiltration_eq_bot _ n _ hk)

/-- The filtration by coefficient degree on `Ω̂ⁿ_{D'}` exhausts at `k = 0`. -/
public theorem completedPolynomialFormsCoefficientFiltration_zero (n : ℕ) :
    completedPolynomialFormsCoefficientFiltration A B W p n 0 = ⊤ := by
  rw [completedPolynomialFormsCoefficientFiltration,
    antidiagonalCoefficientFiltration_zero (completedDividedPowerPolynomialRing B W p) n
      (fun ij ↦ completedPolynomialBidegreeForms A B W p ij.1.1 ij.1.2)]
  exact Submodule.comap_top _

end Forms

end DividedPowerPolynomial

end Crystalline

end
