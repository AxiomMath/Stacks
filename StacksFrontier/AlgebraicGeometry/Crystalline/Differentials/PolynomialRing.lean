/-!
# Divided power differentials of a polynomial ring

Let `B` be a divided power ring over `A` with divided powers `δ` on `J ⊆ B`, and let `δ'` be
divided powers on `J · B[X]` extending `δ` along `C : B → B[X]`.  The divided power differentials
of `B[X]` split off a free summand generated by `d X`:

`Ω¹_{B[X]/A,δ'} = (B[X] ⊗_B Ω¹_{B/A,δ}) ⊕ B[X] · d X`,

as a canonical equivalence characterized by its values on `d (C b)` and on `d X`.

## Main results

* `Crystalline.dividedPowerDifferentialsPolynomialEquiv` — the polynomial formula.

## References

* [Stacks Project, Tag 07HS](https://stacks.math.columbia.edu/tag/07HS)
-/

@[expose] public section

namespace Crystalline

/-! ### Divided power differentials of a polynomial ring -/

section Polynomial

open Polynomial

open scoped TensorProduct

universe u v w

private noncomputable def kahlerPolynomialDerivation
    {A : Type u} [CommRing A] (B : Type v) [CommRing B] [Algebra A B] :
    Derivation A (Polynomial B)
      ((Polynomial B ⊗[B] Ω[B⁄A]) × Polynomial B) := by
  let P := Polynomial B
  let dB : Derivation A B Ω[B⁄A] := KaehlerDifferential.D A B
  let e := PolynomialModule.polynomialTensorProductLEquivPolynomialModule B Ω[B⁄A]
  let dCoeff : Derivation A P (P ⊗[B] Ω[B⁄A]) := e.symm.compDer dB.mapCoeffs
  let dVar : Derivation A P P :=
    (Polynomial.derivative' (R := B)).restrictScalars A
  exact (LinearMap.inl P (P ⊗[B] Ω[B⁄A]) P).compDer dCoeff +
    (LinearMap.inr P (P ⊗[B] Ω[B⁄A]) P).compDer dVar

private noncomputable def kahlerPolynomialMap
    {A : Type u} [CommRing A] (B : Type v) [CommRing B] [Algebra A B] :
    Ω[Polynomial B⁄A] →ₗ[Polynomial B]
      ((Polynomial B ⊗[B] Ω[B⁄A]) × Polynomial B) :=
  (KaehlerDifferential.linearMapEquivDerivation A (Polynomial B)
      (M := (Polynomial B ⊗[B] Ω[B⁄A]) × Polynomial B)).symm
    (kahlerPolynomialDerivation B)

private lemma kahlerPolynomialMap_apply_D_C
    {A : Type u} [CommRing A] (B : Type v) [CommRing B] [Algebra A B] (b : B) :
    kahlerPolynomialMap B (KaehlerDifferential.D A (Polynomial B) (Polynomial.C b)) =
      (1 ⊗ₜ[B] KaehlerDifferential.D A B b, 0) := by
  rw [kahlerPolynomialMap, KaehlerDifferential.linearMapEquivDerivation_symm_apply,
    Derivation.liftKaehlerDifferential_comp_D]
  simp [kahlerPolynomialDerivation, Derivation.mapCoeffs_C,
    PolynomialModule.polynomialTensorProductLEquivPolynomialModule]

private lemma kahlerPolynomialMap_apply_D_X
    {A : Type u} [CommRing A] (B : Type v) [CommRing B] [Algebra A B] :
    kahlerPolynomialMap B (KaehlerDifferential.D A (Polynomial B) Polynomial.X) = (0, 1) := by
  rw [kahlerPolynomialMap, KaehlerDifferential.linearMapEquivDerivation_symm_apply,
    Derivation.liftKaehlerDifferential_comp_D]
  simp [kahlerPolynomialDerivation, Derivation.mapCoeffs_X]

private lemma polynomial_derivation_ext
    {A : Type u} [CommSemiring A] (B : Type v) [CommSemiring B] [Algebra A B]
    {M : Type*} [AddCommMonoid M] [Module (Polynomial B) M] [Module A M]
    [IsScalarTower A (Polynomial B) M]
    {D E : Derivation A (Polynomial B) M}
    (hC : ∀ b : B, D (Polynomial.C b) = E (Polynomial.C b))
    (hX : D Polynomial.X = E Polynomial.X) : D = E := by
  apply Derivation.ext
  intro p
  induction p using Polynomial.induction_on' with
  | add p q hp hq => simp [hp, hq]
  | monomial n b =>
      rw [← Polynomial.C_mul_X_pow_eq_monomial]
      rw [Derivation.leibniz, Derivation.leibniz, hC b,
        D.leibniz_pow, E.leibniz_pow, hX]

private noncomputable def polynomialCoefficientQuotient
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B] :
    Polynomial B ⊗[B] Ω[B⁄A] →ₗ[Polynomial B]
      Polynomial B ⊗[B] dividedPowerDifferentials (A := A) B.dividedPowers := by
  let f : Polynomial B ⊗[B] Ω[B⁄A] →ₗ[B]
      Polynomial B ⊗[B] dividedPowerDifferentials (A := A) B.dividedPowers :=
    TensorProduct.map (LinearMap.id)
      ((dividedPowerDifferentialRelations (A := A) B.dividedPowers).mkQ)
  refine
    { toFun := f
      map_add' := map_add f
      map_smul' := ?_ }
  intro p x
  induction x using TensorProduct.induction_on with
  | zero => simp [f]
  | tmul q ω =>
      change (p • q) ⊗ₜ[B]
        ((dividedPowerDifferentialRelations (A := A) B.dividedPowers).mkQ ω) =
        p • (q ⊗ₜ[B]
          ((dividedPowerDifferentialRelations (A := A) B.dividedPowers).mkQ ω))
      rw [TensorProduct.smul_tmul']
  | add x y hx hy => simp [map_add, hx, hy]

private lemma dividedPowerDerivation_add
    {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    {I : Ideal R} (hI : DividedPowers I) (D : Derivation ℤ R M)
    (x y : R) (hx : x ∈ I) (hy : y ∈ I)
    (hxD : ∀ n, D (hI.dpow (n + 1) x) = hI.dpow n x • D x)
    (hyD : ∀ n, D (hI.dpow (n + 1) y) = hI.dpow n y • D y)
    (n : ℕ) :
    D (hI.dpow (n + 1) (x + y)) = hI.dpow n (x + y) • D (x + y) := by
  rw [hI.dpow_add' (n := n + 1) hx hy, map_sum]
  simp_rw [D.leibniz]
  rw [Finset.sum_add_distrib]
  have hdy :
      (∑ k ∈ Finset.range (n + 2), hI.dpow k x • D (hI.dpow (n + 1 - k) y)) =
        (∑ k ∈ Finset.range (n + 1), hI.dpow k x * hI.dpow (n - k) y) • D y := by
    rw [Finset.sum_range_succ]
    have hz : D (hI.dpow 0 y) = 0 := by rw [hI.dpow_zero hy, D.map_one_eq_zero]
    have hend : n + 1 - (n + 1) = 0 := by omega
    rw [hend, hz]
    simp only [smul_zero, add_zero]
    calc
      (∑ k ∈ Finset.range (n + 1), hI.dpow k x • D (hI.dpow (n + 1 - k) y)) =
          ∑ k ∈ Finset.range (n + 1), (hI.dpow k x * hI.dpow (n - k) y) • D y := by
        apply Finset.sum_congr rfl
        intro k hk
        have hk' : k ≤ n := by simp only [Finset.mem_range] at hk; omega
        have heq : n + 1 - k = (n - k) + 1 := by omega
        rw [heq, hyD]
        simp [smul_smul]
      _ = (∑ k ∈ Finset.range (n + 1), hI.dpow k x * hI.dpow (n - k) y) • D y := by
        rw [← Finset.sum_smul]
  have hdx :
      (∑ k ∈ Finset.range (n + 2), hI.dpow (n + 1 - k) y • D (hI.dpow k x)) =
        (∑ k ∈ Finset.range (n + 1), hI.dpow k x * hI.dpow (n - k) y) • D x := by
    rw [Finset.sum_range_succ']
    have hz : D (hI.dpow 0 x) = 0 := by rw [hI.dpow_zero hx, D.map_one_eq_zero]
    simp only [hz, smul_zero, add_zero]
    calc
      (∑ k ∈ Finset.range (n + 1), hI.dpow (n + 1 - (k + 1)) y • D (hI.dpow (k + 1) x)) =
          ∑ k ∈ Finset.range (n + 1), hI.dpow (n - k) y • D (hI.dpow (k + 1) x) := by
        apply Finset.sum_congr rfl
        intro k hk
        congr 2
        omega
      _ = ∑ k ∈ Finset.range (n + 1), (hI.dpow (n - k) y * hI.dpow k x) • D x := by
        apply Finset.sum_congr rfl
        intro k hk
        rw [hxD k]
        simp [smul_smul, mul_comm]
      _ = (∑ k ∈ Finset.range (n + 1), hI.dpow k x * hI.dpow (n - k) y) • D x := by
        rw [← Finset.sum_smul]
        congr 1
        apply Finset.sum_congr rfl
        intro k hk
        ring
  rw [hdy, hdx, ← hI.dpow_add' (n := n) hx hy, D.map_add]
  simp [smul_add, add_comm]

private lemma dividedPowerDerivation_smul
    {R : Type u} [CommRing R] {M : Type v} [AddCommGroup M] [Module R M]
    {I : Ideal R} (hI : DividedPowers I) (D : Derivation ℤ R M)
    (x : R) (hx : x ∈ I)
    (hxD : ∀ n, D (hI.dpow (n + 1) x) = hI.dpow n x • D x)
    (a : R) (n : ℕ) :
    D (hI.dpow (n + 1) (a * x)) = hI.dpow n (a * x) • D (a * x) := by
  rw [hI.dpow_mul hx, D.leibniz, D.leibniz_pow, hxD n, hI.dpow_mul hx, D.leibniz]
  have hmul : x * hI.dpow n x = (n + 1 : R) * hI.dpow (n + 1) x := by
    simpa [hI.dpow_one hx, Nat.add_comm, Nat.choose_one_right] using
      hI.mul_dpow (m := 1) (n := n) hx
  have hcoeff : hI.dpow (n + 1) x * (n + 1 : R) * a ^ n =
      a ^ n * x * hI.dpow n x := by
    linear_combination -a ^ n * hmul
  have hcoeffM : hI.dpow (n + 1) x • (n + 1 : R) • a ^ n • D a =
      a ^ n • x • hI.dpow n x • D a := by
    calc
      hI.dpow (n + 1) x • (n + 1 : R) • a ^ n • D a =
          (hI.dpow (n + 1) x * (n + 1 : R) * a ^ n) • D a := by
            rw [smul_smul, smul_smul]
      _ = (a ^ n * x * hI.dpow n x) • D a := congrArg (fun r : R => r • D a) hcoeff
      _ = a ^ n • x • hI.dpow n x • D a := by rw [smul_smul, smul_smul]
  rw [smul_add, pow_succ]
  simp only [Nat.succ_sub_one]
  rw [← Nat.cast_smul_eq_nsmul R (n + 1) (a ^ n • D a)]
  simp only [Nat.cast_succ]
  rw [hcoeffM]
  module

private lemma dividedPowerDerivation_on_ideal_map
    {R : Type u} [CommRing R] {S : Type v} [CommRing S]
    {M : Type w} [AddCommGroup M] [Module R M]
    (I : Ideal R) (J : Ideal S) (hI : DividedPowers I) (f : S →+* R)
    (hmap : J.map f = I) (D : Derivation ℤ R M)
    (hgen : ∀ x ∈ J, ∀ n, D (hI.dpow (n + 1) (f x)) = hI.dpow n (f x) • D (f x))
    {x : R} (hx : x ∈ I) (n : ℕ) :
    D (hI.dpow (n + 1) x) = hI.dpow n x • D x := by
  let K : Ideal R :=
    { carrier := {x | x ∈ I ∧ ∀ n, D (hI.dpow (n + 1) x) = hI.dpow n x • D x}
      zero_mem' := by
        refine ⟨I.zero_mem, ?_⟩
        intro n
        cases n with
        | zero => simp [hI.dpow_one I.zero_mem, hI.dpow_zero I.zero_mem, D.map_zero]
        | succ n =>
            simp [hI.dpow_eval_zero (by omega : n + 2 ≠ 0), D.map_zero]
      add_mem' := by
        intro x y hx hy
        refine ⟨I.add_mem hx.1 hy.1, ?_⟩
        intro n
        exact dividedPowerDerivation_add hI D x y hx.1 hy.1 hx.2 hy.2 n
      smul_mem' := by
        intro a x hx
        refine ⟨I.smul_mem a hx.1, ?_⟩
        intro n
        change D (hI.dpow (n + 1) (a * x)) = hI.dpow n (a * x) • D (a * x)
        exact dividedPowerDerivation_smul hI D x hx.1 hx.2 a n }
  have hle : J ≤ K.comap f := by
    intro y hy
    have hyI : f y ∈ I := by rw [← hmap]; exact Ideal.mem_map_of_mem f hy
    exact ⟨hyI, fun n => hgen y hy n⟩
  have hIK : I ≤ K := by
    rw [← hmap]
    exact (Ideal.map_le_iff_le_comap).2 hle
  exact (hIK hx).2 n

private noncomputable def polynomialCoefficientQuotientProdMap
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B] :
    ((Polynomial B ⊗[B] Ω[B⁄A]) × Polynomial B) →ₗ[Polynomial B]
      ((Polynomial B ⊗[B] dividedPowerDifferentials (A := A) B.dividedPowers) ×
        Polynomial B) :=
  (polynomialCoefficientQuotient (A := A) B).prodMap (LinearMap.id :
    Polynomial B →ₗ[Polynomial B] Polynomial B)

private lemma polynomialCoefficientQuotient_tmul_one
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B]
    (ω : Ω[B⁄A]) :
    polynomialCoefficientQuotient (A := A) B (1 ⊗ₜ[B] ω) =
      1 ⊗ₜ[B]
        (dividedPowerDifferentialRelations (A := A) B.dividedPowers).mkQ ω := by
  simp [polynomialCoefficientQuotient]

private noncomputable def polynomialDividedPowerCandidateDerivation
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B] :
    Derivation A (Polynomial B)
      ((Polynomial B ⊗[B] dividedPowerDifferentials (A := A) B.dividedPowers) ×
        Polynomial B) :=
  ((polynomialCoefficientQuotientProdMap (A := A) B).comp (kahlerPolynomialMap B)).compDer
    (KaehlerDifferential.D A (Polynomial B))

private lemma polynomialDividedPowerCandidateDerivation_apply_C
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B]
    (b : B) :
    polynomialDividedPowerCandidateDerivation (A := A) B (Polynomial.C b) =
      (1 ⊗ₜ[B]
        (dividedPowerDifferentialRelations (A := A) B.dividedPowers).mkQ
          (KaehlerDifferential.D A B b), 0) := by
  simp [polynomialDividedPowerCandidateDerivation,
    polynomialCoefficientQuotientProdMap, kahlerPolynomialMap_apply_D_C,
    polynomialCoefficientQuotient_tmul_one]

private lemma polynomialDividedPowerCandidateDerivation_apply_X
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B] :
    polynomialDividedPowerCandidateDerivation (A := A) B Polynomial.X = (0, 1) := by
  simp [polynomialDividedPowerCandidateDerivation,
    polynomialCoefficientQuotientProdMap, kahlerPolynomialMap_apply_D_X]

/-- A divided power derivation from a derivation obeying the chain rule in positive degrees. -/
private noncomputable def dividedPowerDerivationOfDpowSucc
    {A : Type u} [CommRing A] {B : DividedPowerRing.{v}} [Algebra A B]
    {M : Type w} [AddCommGroup M] [Module B M] [Module A M] [IsScalarTower A B M]
    (D : Derivation A B M)
    (hD : ∀ (n : ℕ) (x : B), x ∈ B.ideal →
      D (B.dividedPowers.dpow (n + 1) x) = B.dividedPowers.dpow n x • D x) :
    DividedPowerDerivation A B (algebraMap A B) M where
  toDerivation := D.restrictScalars ℤ
  map_ringHom' := D.map_algebraMap
  map_dpow' n hn x hx := by
    obtain ⟨n, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn.ne'
    simpa using hD n x hx

private noncomputable def polynomialDividedPowerDerivation
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B]
    (δ' : DividedPowers (B.ideal.map (Polynomial.C : B →+* Polynomial B)))
    (h : DividedPowers.IsDPMorphism B.dividedPowers δ'
      (Polynomial.C : B →+* Polynomial B)) :
    DividedPowerDerivation A
      (DividedPowerRing.of (Polynomial B)
        (B.ideal.map (Polynomial.C : B →+* Polynomial B)) δ')
      (algebraMap A (Polynomial B))
      ((Polynomial B ⊗[B] dividedPowerDifferentials (A := A) B.dividedPowers) ×
        Polynomial B) := by
  let D := polynomialDividedPowerCandidateDerivation (A := A) B
  have hgen (b : B) (hb : b ∈ B.ideal) (n : ℕ) :
      D (δ'.dpow (n + 1) (Polynomial.C b)) =
        δ'.dpow n (Polynomial.C b) • D (Polynomial.C b) := by
    rw [h.dpow_comp (n := n + 1) b hb,
      h.dpow_comp (n := n) b hb,
      polynomialDividedPowerCandidateDerivation_apply_C,
      polynomialDividedPowerCandidateDerivation_apply_C]
    have hdp := dividedPowerDifferential_dpow (A := A) B.dividedPowers
      (⟨b, hb⟩ : B.ideal) n
    change (dividedPowerDifferentialRelations (A := A) B.dividedPowers).mkQ
        (KaehlerDifferential.D A B (B.dividedPowers.dpow (n + 1) b)) = _ at hdp
    rw [hdp]
    simp only [dividedPowerDifferential]
    ext
    · rw [TensorProduct.tmul_smul]
      change (B.dividedPowers.dpow n b • (1 : Polynomial B)) ⊗ₜ[B]
          (dividedPowerDifferentialRelations (A := A) B.dividedPowers).mkQ
            (KaehlerDifferential.D A B b) =
        (Polynomial.C (B.dividedPowers.dpow n b) • (1 : Polynomial B)) ⊗ₜ[B]
          (dividedPowerDifferentialRelations (A := A) B.dividedPowers).mkQ
            (KaehlerDifferential.D A B b)
      apply congrArg (fun p : Polynomial B => p ⊗ₜ[B]
        (dividedPowerDifferentialRelations (A := A) B.dividedPowers).mkQ
          (KaehlerDifferential.D A B b))
      have h₁ : B.dividedPowers.dpow n b • (1 : Polynomial B) =
          Polynomial.C (B.dividedPowers.dpow n b) := by
        rw [Algebra.smul_def, mul_one]
        rfl
      have h₂ : Polynomial.C (B.dividedPowers.dpow n b) • (1 : Polynomial B) =
          Polynomial.C (B.dividedPowers.dpow n b) := by simp
      rw [h₁, h₂]
    · simp
  exact dividedPowerDerivationOfDpowSucc D fun n x hx =>
    dividedPowerDerivation_on_ideal_map
      (B.ideal.map (Polynomial.C : B →+* Polynomial B)) B.ideal
      δ' (Polynomial.C : B →+* Polynomial B) rfl (D.restrictScalars ℤ) hgen hx n

private noncomputable def polynomialCoefficientDividedPowerDerivation
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B]
    (δ' : DividedPowers (B.ideal.map (Polynomial.C : B →+* Polynomial B)))
    (h : DividedPowers.IsDPMorphism B.dividedPowers δ'
      (Polynomial.C : B →+* Polynomial B)) :
    DividedPowerDerivation A B (algebraMap A B)
      (dividedPowerDifferentials (A := A) δ') := by
  let P := Polynomial B
  let M := dividedPowerDifferentials (A := A) δ'
  letI : LinearMap.CompatibleSMul Ω[P⁄A] M B P :=
    ⟨fun F b x ↦ by
      calc
        F (b • x) = F ((algebraMap B P b) • x) := by rw [IsScalarTower.algebraMap_smul]
        _ = (algebraMap B P b) • F x := map_smul F _ _
        _ = b • F x := IsScalarTower.algebraMap_smul P b (F x)⟩
  let q : Ω[P⁄A] →ₗ[B] M :=
    ((dividedPowerDifferentialRelations (A := A) δ').mkQ).restrictScalars B
  let D : Derivation A B M :=
    q.compDer ((KaehlerDifferential.map A A B P).compDer (KaehlerDifferential.D A B))
  have hgen (x : B) (hx : x ∈ B.ideal) (n : ℕ) :
      D (B.dividedPowers.dpow (n + 1) x) =
        B.dividedPowers.dpow n x • D x := by
    dsimp [D]
    rw [KaehlerDifferential.map_D, KaehlerDifferential.map_D]
    rw [Polynomial.algebraMap_eq]
    rw [← h.dpow_comp (n := n + 1) x hx]
    have hp := dividedPowerDifferential_dpow (A := A)
      δ'
      ⟨Polynomial.C x, Ideal.mem_map_of_mem (Polynomial.C : B →+* P) hx⟩ n
    change q (KaehlerDifferential.D A P
        (δ'.dpow (n + 1) (Polynomial.C x))) =
      δ'.dpow n (Polynomial.C x) • q (KaehlerDifferential.D A P (Polynomial.C x)) at hp
    rw [hp, h.dpow_comp (n := n) x hx]
    have hs := IsScalarTower.algebraMap_smul P (B.dividedPowers.dpow n x)
      (q (KaehlerDifferential.D A P (Polynomial.C x)))
    rw [Polynomial.algebraMap_eq] at hs
    exact hs
  exact dividedPowerDerivationOfDpowSucc D fun n x hx => hgen x hx n

private noncomputable def polynomialCoefficientDifferentialsLift
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B]
    (δ' : DividedPowers (B.ideal.map (Polynomial.C : B →+* Polynomial B)))
    (h : DividedPowers.IsDPMorphism B.dividedPowers δ'
      (Polynomial.C : B →+* Polynomial B)) :
    dividedPowerDifferentials (A := A) B.dividedPowers →ₗ[B]
      dividedPowerDifferentials (A := A) δ' :=
  Classical.choose (dividedPowerDifferentials_lift B
    (polynomialCoefficientDividedPowerDerivation (A := A) B δ' h))

private lemma polynomialCoefficientDifferentialsLift_apply
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B]
    (δ' : DividedPowers (B.ideal.map (Polynomial.C : B →+* Polynomial B)))
    (h : DividedPowers.IsDPMorphism B.dividedPowers δ'
      (Polynomial.C : B →+* Polynomial B)) (b : B) :
    polynomialCoefficientDifferentialsLift (A := A) B δ' h
      (dividedPowerDifferential (A := A) B.dividedPowers b) =
        dividedPowerDifferential (A := A) δ' (Polynomial.C b) := by
  calc
    polynomialCoefficientDifferentialsLift (A := A) B δ' h
        (dividedPowerDifferential (A := A) B.dividedPowers b) =
      (polynomialCoefficientDividedPowerDerivation (A := A) B δ' h) b :=
        (Classical.choose_spec (dividedPowerDifferentials_lift B
          (polynomialCoefficientDividedPowerDerivation (A := A) B δ' h))).1 b
    _ = dividedPowerDifferential (A := A) δ' (Polynomial.C b) := by
      simp [polynomialCoefficientDividedPowerDerivation, dividedPowerDerivationOfDpowSucc,
        dividedPowerDifferential, KaehlerDifferential.map_D]

private noncomputable def polynomialDividedPowerDifferentialsForwardMap
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B]
    (δ' : DividedPowers (B.ideal.map (Polynomial.C : B →+* Polynomial B)))
    (h : DividedPowers.IsDPMorphism B.dividedPowers δ'
      (Polynomial.C : B →+* Polynomial B)) :
    dividedPowerDifferentials (A := A) δ' →ₗ[Polynomial B]
      ((Polynomial B ⊗[B] dividedPowerDifferentials (A := A) B.dividedPowers) ×
        Polynomial B) :=
  Classical.choose (dividedPowerDifferentials_lift
    (DividedPowerRing.of (Polynomial B)
      (B.ideal.map (Polynomial.C : B →+* Polynomial B)) δ')
    (polynomialDividedPowerDerivation (A := A) B δ' h))

private lemma polynomialDividedPowerDifferentialsForwardMap_apply
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B]
    (δ' : DividedPowers (B.ideal.map (Polynomial.C : B →+* Polynomial B)))
    (h : DividedPowers.IsDPMorphism B.dividedPowers δ'
      (Polynomial.C : B →+* Polynomial B)) (p : Polynomial B) :
    polynomialDividedPowerDifferentialsForwardMap (A := A) B δ' h
      (dividedPowerDifferential (A := A) δ' p) =
      polynomialDividedPowerCandidateDerivation (A := A) B p :=
  (Classical.choose_spec (dividedPowerDifferentials_lift
    (DividedPowerRing.of (Polynomial B)
      (B.ideal.map (Polynomial.C : B →+* Polynomial B)) δ')
    (polynomialDividedPowerDerivation (A := A) B δ' h))).1 p

private lemma polynomialDividedPowerDifferentialsForwardMap_apply_C
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B]
    (δ' : DividedPowers (B.ideal.map (Polynomial.C : B →+* Polynomial B)))
    (h : DividedPowers.IsDPMorphism B.dividedPowers δ'
      (Polynomial.C : B →+* Polynomial B)) (b : B) :
    polynomialDividedPowerDifferentialsForwardMap (A := A) B δ' h
      (dividedPowerDifferential (A := A) δ' (Polynomial.C b)) =
      (1 ⊗ₜ[B] dividedPowerDifferential (A := A) B.dividedPowers b, 0) := by
  rw [polynomialDividedPowerDifferentialsForwardMap_apply,
    polynomialDividedPowerCandidateDerivation_apply_C]
  rfl

private lemma polynomialDividedPowerDifferentialsForwardMap_apply_X
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B]
    (δ' : DividedPowers (B.ideal.map (Polynomial.C : B →+* Polynomial B)))
    (h : DividedPowers.IsDPMorphism B.dividedPowers δ'
      (Polynomial.C : B →+* Polynomial B)) :
    polynomialDividedPowerDifferentialsForwardMap (A := A) B δ' h
      (dividedPowerDifferential (A := A) δ' Polynomial.X) = (0, 1) := by
  rw [polynomialDividedPowerDifferentialsForwardMap_apply,
    polynomialDividedPowerCandidateDerivation_apply_X]

private noncomputable def polynomialCoefficientTensorLift
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B]
    (δ' : DividedPowers (B.ideal.map (Polynomial.C : B →+* Polynomial B)))
    (h : DividedPowers.IsDPMorphism B.dividedPowers δ'
      (Polynomial.C : B →+* Polynomial B)) :
    Polynomial B ⊗[B] dividedPowerDifferentials (A := A) B.dividedPowers →ₗ[Polynomial B]
      dividedPowerDifferentials (A := A) δ' := by
  let P := Polynomial B
  let M := dividedPowerDifferentials (A := A) δ'
  let coeff := polynomialCoefficientDifferentialsLift (A := A) B δ' h
  let f : P →ₗ[P] (dividedPowerDifferentials (A := A) B.dividedPowers →ₗ[B] M) :=
    { toFun := fun p =>
        { toFun := fun ω => p • coeff ω
          map_add' := by intro x y; simp [smul_add, map_add]
          map_smul' := by
            intro b ω
            change p • coeff (b • ω) = b • (p • coeff ω)
            rw [coeff.map_smul]
            exact smul_comm p b (coeff ω) }
      map_add' := by intro p q; ext ω; simp [add_smul]
      map_smul' := by intro p q; ext ω; simp [mul_smul] }
  exact TensorProduct.AlgebraTensorModule.lift f

private noncomputable def polynomialDividedPowerDifferentialsInverseMap
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B]
    (δ' : DividedPowers (B.ideal.map (Polynomial.C : B →+* Polynomial B)))
    (h : DividedPowers.IsDPMorphism B.dividedPowers δ'
      (Polynomial.C : B →+* Polynomial B)) :
    ((Polynomial B ⊗[B] dividedPowerDifferentials (A := A) B.dividedPowers) ×
        Polynomial B) →ₗ[Polynomial B]
      dividedPowerDifferentials (A := A) δ' := by
  let P := Polynomial B
  let c := polynomialCoefficientTensorLift (A := A) B δ' h
  let dx : P →ₗ[P] dividedPowerDifferentials (A := A) δ' :=
    LinearMap.toSpanSingleton P _ (dividedPowerDifferential (A := A) δ' Polynomial.X)
  exact
    { toFun := fun x => c x.1 + dx x.2
      map_add' := by intro x y; simp [add_add_add_comm]
      map_smul' := by intro p x; simp [smul_add, dx, smul_smul] }

private lemma polynomialCoefficientTensorLift_tmul
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B]
    (δ' : DividedPowers (B.ideal.map (Polynomial.C : B →+* Polynomial B)))
    (h : DividedPowers.IsDPMorphism B.dividedPowers δ'
      (Polynomial.C : B →+* Polynomial B))
    (p : Polynomial B) (ω : dividedPowerDifferentials (A := A) B.dividedPowers) :
    polynomialCoefficientTensorLift (A := A) B δ' h (p ⊗ₜ[B] ω) =
      p • polynomialCoefficientDifferentialsLift (A := A) B δ' h ω := by
  simp [polynomialCoefficientTensorLift]

private lemma polynomialDividedPowerDifferentialsInverseMap_apply_C
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B]
    (δ' : DividedPowers (B.ideal.map (Polynomial.C : B →+* Polynomial B)))
    (h : DividedPowers.IsDPMorphism B.dividedPowers δ'
      (Polynomial.C : B →+* Polynomial B)) (b : B) :
    polynomialDividedPowerDifferentialsInverseMap (A := A) B δ' h
      (1 ⊗ₜ[B] dividedPowerDifferential (A := A) B.dividedPowers b, 0) =
        dividedPowerDifferential (A := A) δ' (Polynomial.C b) := by
  simp [polynomialDividedPowerDifferentialsInverseMap,
    polynomialCoefficientTensorLift_tmul, polynomialCoefficientDifferentialsLift_apply]

private lemma polynomialDividedPowerDifferentialsInverseMap_apply_X
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B]
    (δ' : DividedPowers (B.ideal.map (Polynomial.C : B →+* Polynomial B)))
    (h : DividedPowers.IsDPMorphism B.dividedPowers δ'
      (Polynomial.C : B →+* Polynomial B)) :
    polynomialDividedPowerDifferentialsInverseMap (A := A) B δ' h (0, 1) =
      dividedPowerDifferential (A := A) δ' Polynomial.X := by
  simp [polynomialDividedPowerDifferentialsInverseMap,
    polynomialCoefficientTensorLift]

private noncomputable def polynomialDividedPowerDifferentialsEquiv
    {A : Type u} [CommRing A] (B : DividedPowerRing.{v}) [Algebra A B]
    (δ' : DividedPowers (B.ideal.map (Polynomial.C : B →+* Polynomial B)))
    (h : DividedPowers.IsDPMorphism B.dividedPowers δ'
      (Polynomial.C : B →+* Polynomial B)) :
    dividedPowerDifferentials (A := A) δ' ≃ₗ[Polynomial B]
      ((Polynomial B ⊗[B] dividedPowerDifferentials (A := A) B.dividedPowers) ×
        Polynomial B) := by
  let P := Polynomial B
  let T := P ⊗[B] dividedPowerDifferentials (A := A) B.dividedPowers
  let F := polynomialDividedPowerDifferentialsForwardMap (A := A) B δ' h
  let G := polynomialDividedPowerDifferentialsInverseMap (A := A) B δ' h
  have hD : G.compDer (polynomialDividedPowerCandidateDerivation (A := A) B) =
      ((dividedPowerDifferentialRelations (A := A) δ').mkQ).compDer
        (KaehlerDifferential.D A P) := by
    apply polynomial_derivation_ext B
    · intro b
      change G (polynomialDividedPowerCandidateDerivation (A := A) B (Polynomial.C b)) =
        dividedPowerDifferential (A := A) δ' (Polynomial.C b)
      rw [polynomialDividedPowerCandidateDerivation_apply_C]
      exact polynomialDividedPowerDifferentialsInverseMap_apply_C B δ' h b
    · change G (polynomialDividedPowerCandidateDerivation (A := A) B Polynomial.X) =
        dividedPowerDifferential (A := A) δ' Polynomial.X
      rw [polynomialDividedPowerCandidateDerivation_apply_X]
      exact polynomialDividedPowerDifferentialsInverseMap_apply_X B δ' h
  have hGF : G.comp F = LinearMap.id := by
    apply LinearMap.ext_on_range (dividedPowerDifferentials_span (A := A) δ')
    intro p
    change G (F (dividedPowerDifferential (A := A) δ' p)) =
      dividedPowerDifferential (A := A) δ' p
    rw [polynomialDividedPowerDifferentialsForwardMap_apply]
    have hp := congrArg (fun D : Derivation A P
        (dividedPowerDifferentials (A := A) δ') => D p) hD
    simpa [Derivation.coe_comp, dividedPowerDifferential] using hp
  have hInl : (F.comp G).comp (LinearMap.inl P T P) = LinearMap.inl P T P := by
    apply LinearMap.ext
    intro z
    induction z using TensorProduct.induction_on with
    | zero =>
        change F (G 0) = 0
        simp
    | add x y hx hy => simp only [map_add, hx, hy]
    | tmul p ω =>
        let L : dividedPowerDifferentials (A := A) B.dividedPowers →ₗ[B]
            T × P :=
          (LinearMap.restrictScalars B
            ((F.comp G).comp (LinearMap.inl P T P))).comp
            (TensorProduct.mk B P
              (dividedPowerDifferentials (A := A) B.dividedPowers) p)
        let R : dividedPowerDifferentials (A := A) B.dividedPowers →ₗ[B]
            T × P :=
          (LinearMap.restrictScalars B (LinearMap.inl P T P)).comp
            (TensorProduct.mk B P
              (dividedPowerDifferentials (A := A) B.dividedPowers) p)
        have hLR : L = R := by
          apply LinearMap.ext_on_range
            (dividedPowerDifferentials_span (A := A) B.dividedPowers)
          intro b
          change F (G (p ⊗ₜ[B] dividedPowerDifferential (A := A)
            B.dividedPowers b, 0)) =
            (p ⊗ₜ[B] dividedPowerDifferential (A := A) B.dividedPowers b, 0)
          have hG : G (p ⊗ₜ[B] dividedPowerDifferential (A := A)
              B.dividedPowers b, 0) =
              p • dividedPowerDifferential (A := A) δ' (Polynomial.C b) := by
            simp [G, polynomialDividedPowerDifferentialsInverseMap,
              polynomialCoefficientTensorLift_tmul,
              polynomialCoefficientDifferentialsLift_apply]
          rw [hG, map_smul, polynomialDividedPowerDifferentialsForwardMap_apply_C]
          simp [TensorProduct.smul_tmul']
        exact LinearMap.congr_fun hLR ω
  have hInr : (F.comp G).comp (LinearMap.inr P T P) = LinearMap.inr P T P := by
    apply LinearMap.ext
    intro p
    simp [F, G, polynomialDividedPowerDifferentialsInverseMap,
      polynomialDividedPowerDifferentialsForwardMap_apply_X]
  have hFG : F.comp G = LinearMap.id :=
    LinearMap.prod_ext (hInl.trans (LinearMap.id_comp _).symm)
      (hInr.trans (LinearMap.id_comp _).symm)
  exact LinearEquiv.ofLinearMap F G hFG hGF

variable {A : Type u} [CommRing A]
variable (B : DividedPowerRing.{v}) [Algebra A B]

/-- The canonical polynomial decomposition of divided power differentials,
characterized by the differentials of constants and of the polynomial variable. -/
@[stacks 07HS "polynomial"]
public noncomputable def dividedPowerDifferentialsPolynomialEquiv
    (δ' : DividedPowers (B.ideal.map (Polynomial.C : B →+* B[X])))
    (_h : DividedPowers.IsDPMorphism B.dividedPowers δ'
      (Polynomial.C : B →+* B[X])) :
    { e : dividedPowerDifferentials (A := A) δ' ≃ₗ[B[X]]
        (TensorProduct B B[X] (dividedPowerDifferentials (A := A) B.dividedPowers) × B[X]) //
      (∀ b : B, e (dividedPowerDifferential (A := A) δ' (Polynomial.C b)) =
        (TensorProduct.tmul B (1 : B[X])
          (dividedPowerDifferential (A := A) B.dividedPowers b), 0)) ∧
      e (dividedPowerDifferential (A := A) δ' Polynomial.X) = (0, 1) } := by
  let hne : Nonempty { e : dividedPowerDifferentials (A := A) δ' ≃ₗ[B[X]]
      (TensorProduct B B[X] (dividedPowerDifferentials (A := A) B.dividedPowers) × B[X]) //
    (∀ b : B, e (dividedPowerDifferential (A := A) δ' (Polynomial.C b)) =
      (TensorProduct.tmul B (1 : B[X])
        (dividedPowerDifferential (A := A) B.dividedPowers b), 0)) ∧
    e (dividedPowerDifferential (A := A) δ' Polynomial.X) = (0, 1) } := by
    let h := _h
    refine ⟨⟨polynomialDividedPowerDifferentialsEquiv (A := A) B δ' h, ?_, ?_⟩⟩
    · intro b
      change polynomialDividedPowerDifferentialsForwardMap (A := A) B δ' h
        (dividedPowerDifferential (A := A) δ' (Polynomial.C b)) = _
      exact polynomialDividedPowerDifferentialsForwardMap_apply_C B δ' h b
    · change polynomialDividedPowerDifferentialsForwardMap (A := A) B δ' h
        (dividedPowerDifferential (A := A) δ' Polynomial.X) = _
      exact polynomialDividedPowerDifferentialsForwardMap_apply_X B δ' h
  exact Classical.choice hne

end Polynomial

