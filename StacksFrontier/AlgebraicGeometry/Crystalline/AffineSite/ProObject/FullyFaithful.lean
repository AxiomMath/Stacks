module

public import StacksFrontier.AlgebraicGeometry.Crystalline.AffineSite.ProObject.Construction

/-!
# Full faithfulness of the pro-object functor on completed thickenings

A map of pro-objects between the finite-level systems of two completed crystalline
thickenings is, level by level, a morphism out of some deep enough quotient of the source; by
completeness of the target these assemble into a single divided power map. This file carries out
that reconstruction and deduces that the functor `Crystalline.completedCrystallineToPro` from
the completed affine crystalline category `Cris^∧(C/A)` to the pro-objects of `Cris(C/A)` is
fully faithful (`Crystalline.completedCrystallineToPro_fullyFaithful`).

## References

* [Stacks Project, Tag 07KH](https://stacks.math.columbia.edu/tag/07KH)
-/

@[expose] public section

open CategoryTheory

universe u v w

namespace Crystalline

section ProObject

open Limits Opposite

/-- The finite-level term of a system is canonically the quotient of `B` by the
corresponding power of `(p)`. -/
private noncomputable def finiteLevelRingEquiv
    {S : AffineCrystallineSituation.{u, v}}
    {Y : CompletedCrystallineThickening.{u, v, w} S}
    (TY : FiniteLevelSystem Y) (e : ℕ) :
    Y.ring ⧸ (DividedPowers.pAdicIdeal (A := Y.ring) S.p) ^ (TY.cutoff + e) ≃+*
      (TY.term e).1.ring := by
  let q := (TY.projection e).toRingHom
  have hker : RingHom.ker q =
      (DividedPowers.pAdicIdeal (A := Y.ring) S.p) ^ (TY.cutoff + e) := by
    change RingHom.ker (TY.projection e).toRingHom = _
    exact TY.projection_ker e
  have hsurj : Function.Surjective q := by
    simpa only [q, DividedPowers.DPMorphism.coe_toRingHom, ConcreteCategory.hom] using
      TY.projection_surjective e
  exact (Ideal.quotientEquivAlgOfEq ℤ hker.symm).toRingEquiv.trans
    (RingHom.quotientKerEquivOfSurjective (f := q) hsurj)

/-- The identification above sends the class of `y` to its image under the projection. -/
private theorem finiteLevelRingEquiv_mk
    {S : AffineCrystallineSituation.{u, v}}
    {Y : CompletedCrystallineThickening.{u, v, w} S}
    (TY : FiniteLevelSystem Y) (e : ℕ) (y : Y.ring) :
    finiteLevelRingEquiv TY e (Ideal.Quotient.mk _ y) = (TY.projection e).toRingHom y := by
  rw [finiteLevelRingEquiv, RingEquiv.trans_apply, show (Ideal.quotientEquivAlgOfEq ℤ
      (show (DividedPowers.pAdicIdeal (A := Y.ring) S.p) ^ (TY.cutoff + e) =
        RingHom.ker (TY.projection e).toRingHom from (TY.projection_ker e).symm)).toRingEquiv
        (Ideal.Quotient.mk _ y) =
      Ideal.Quotient.mk (RingHom.ker (TY.projection e).toRingHom) y from
    Ideal.quotientEquivAlgOfEq_mk ℤ (TY.projection_ker e).symm y]
  exact RingHom.quotientKerEquivOfSurjective_apply_mk _ _

/-- The transition maps of a finite-level system commute with the projections. -/
private theorem transition_comp_projection_toRingHom
    {S : AffineCrystallineSituation.{u, v}}
    {Y : CompletedCrystallineThickening.{u, v, w} S}
    (TY : FiniteLevelSystem Y) {i k : ℕ} (h : i ≤ k) :
    (TY.transition h).hom.hom.toRingHom.comp (TY.projection k).toRingHom =
      (TY.projection i).toRingHom :=
  congrArg (fun f : DividedPowers.DPMorphism Y.ring.dividedPowers
    (TY.term i).1.ring.dividedPowers => f.toRingHom) (TY.transition_projection h)

/-- Finite-level morphisms that agree after composing with transition maps agree after
composing with the projections. -/
private theorem comp_projection_eq_of_transition_comp_eq
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CompletedCrystallineThickening.{u, v, w} S}
    (TX : FiniteLevelSystem X)
    (TY : FiniteLevelSystem Y)
    {e i i' k : ℕ} (hi : i ≤ k) (hi' : i' ≤ k)
    (g : TX.term i ⟶ TY.term e) (g' : TX.term i' ⟶ TY.term e)
    (heq : TX.transition hi ≫ g = TX.transition hi' ≫ g') :
    g.hom.hom.toRingHom.comp (TX.projection i).toRingHom =
      g'.hom.hom.toRingHom.comp (TX.projection i').toRingHom := by
  have hmap := congrArg (fun m : TX.term k ⟶ TY.term e => m.hom.hom.toRingHom) heq
  change g.hom.hom.toRingHom.comp (TX.transition hi).hom.hom.toRingHom =
    g'.hom.hom.toRingHom.comp (TX.transition hi').hom.hom.toRingHom at hmap
  rw [← transition_comp_projection_toRingHom TX hi, ← transition_comp_projection_toRingHom TX hi',
    ← RingHom.comp_assoc, ← RingHom.comp_assoc, hmap]

/-- A completed thickening is adically complete for the ideal generated by `p`. -/
private theorem isAdicComplete_pAdicIdeal
    {S : AffineCrystallineSituation.{u, v}}
    (Y : CompletedCrystallineThickening.{u, v, w} S) :
    IsAdicComplete (DividedPowers.pAdicIdeal (A := Y.ring) S.p) Y.ring := by
  simpa [DividedPowers.pAdicIdeal] using Y.isComplete

/-- The identifications at the various levels turn the quotient maps between powers of
`(p)` into the transition maps of the system. -/
private theorem finiteLevelRingEquiv_factor_comp
    {S : AffineCrystallineSituation.{u, v}}
    {Y : CompletedCrystallineThickening.{u, v, w} S}
    (TY : FiniteLevelSystem Y)
    {e e' : ℕ} (h : e ≤ e') :
    (finiteLevelRingEquiv TY e).toRingHom.comp
        (Ideal.Quotient.factorPow (DividedPowers.pAdicIdeal (A := Y.ring) S.p)
          (Nat.add_le_add_left h TY.cutoff)) =
      (TY.transition h).hom.hom.toRingHom.comp
        (finiteLevelRingEquiv TY e').toRingHom := by
  apply RingHom.ext
  intro z
  obtain ⟨y, rfl⟩ := Ideal.Quotient.mk_surjective z
  change finiteLevelRingEquiv TY e
      (Ideal.Quotient.factorPow (DividedPowers.pAdicIdeal (A := Y.ring) S.p)
        (Nat.add_le_add_left h TY.cutoff) (Ideal.Quotient.mk _ y)) =
    (TY.transition h).hom.hom.toRingHom
      (finiteLevelRingEquiv TY e' (Ideal.Quotient.mk _ y))
  rw [Ideal.Quotient.factorPow, Ideal.Quotient.factor_mk,
    finiteLevelRingEquiv_mk, finiteLevelRingEquiv_mk]
  exact (RingHom.congr_fun (transition_comp_projection_toRingHom TY h) y).symm

/-- A choice, at each level of the target, of a level of the source and a morphism
representing the given map of pro-objects. -/
private noncomputable def proHomChosenRep
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CompletedCrystallineThickening.{u, v, w} S}
    (TX : FiniteLevelSystem X)
    (TY : FiniteLevelSystem Y)
    (h : proObject X TX ⟶ proObject Y TY) (e : ℕ) :
    Σ i, TX.term i ⟶ TY.term e := by
  classical
  let p := proHom_has_level_map TX TY h e
  exact ⟨Classical.choose p, Classical.choose (Classical.choose_spec p)⟩

/-- The chosen representative does represent the given map of pro-objects. -/
private theorem proHomChosenRep_spec
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CompletedCrystallineThickening.{u, v, w} S}
    (TX : FiniteLevelSystem X)
    (TY : FiniteLevelSystem Y)
    (h : proObject X TX ⟶ proObject Y TY) (e : ℕ) :
    (presentationColimit TY).cocone.ι.app (op (op e)) ≫ h.unop.hom =
      yoneda.map (proHomChosenRep TX TY h e).2.op ≫
        (presentationColimit TX).cocone.ι.app (op (op (proHomChosenRep TX TY h e).1)) := by
  classical
  unfold proHomChosenRep
  exact Classical.choose_spec (Classical.choose_spec
    (proHom_has_level_map TX TY h e))

/-- Consecutive chosen representatives are compatible with the transition maps of the
target. -/
private theorem proHomChosenRep_map_compat
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CompletedCrystallineThickening.{u, v, w} S}
    (TX : FiniteLevelSystem X)
    (TY : FiniteLevelSystem Y)
    (h : proObject X TX ⟶ proObject Y TY) (e : ℕ) :
    (proHomChosenRep TX TY h e).2.hom.hom.toRingHom.comp
        (TX.projection (proHomChosenRep TX TY h e).1).toRingHom =
      (TY.transition (Nat.le_succ e)).hom.hom.toRingHom.comp
        ((proHomChosenRep TX TY h (e + 1)).2.hom.hom.toRingHom.comp
          (TX.projection (proHomChosenRep TX TY h (e + 1)).1).toRingHom) := by
  classical
  let r := proHomChosenRep TX TY h e
  let r' := proHomChosenRep TX TY h (e + 1)
  obtain ⟨_, hi, hi', heq⟩ := proHom_level_representatives_eventually_equal
    TX TY h r.2 r'.2 (Nat.le_succ e) (proHomChosenRep_spec TX TY h e)
      (proHomChosenRep_spec TX TY h (e + 1))
  exact comp_projection_eq_of_transition_comp_eq TX TY hi hi' r.2
    (r'.2 ≫ TY.transition (Nat.le_succ e)) heq

/-- The ring map from `B_X` to a finite quotient of `B_Y` determined by a map of
pro-objects. -/
private noncomputable def proHomQuotientMap
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CompletedCrystallineThickening.{u, v, w} S}
    (TX : FiniteLevelSystem X)
    (TY : FiniteLevelSystem Y)
    (h : proObject X TX ⟶ proObject Y TY) (e : ℕ) :
    X.ring →+* Y.ring ⧸ (DividedPowers.pAdicIdeal (A := Y.ring) S.p) ^ (TY.cutoff + e) :=
  (finiteLevelRingEquiv TY e).symm.toRingHom.comp
    ((proHomChosenRep TX TY h e).2.hom.hom.toRingHom.comp
      (TX.projection (proHomChosenRep TX TY h e).1).toRingHom)

/-- These finite-level ring maps form a compatible system over the powers of `(p)`. -/
private theorem proHomQuotientMap_compatible
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CompletedCrystallineThickening.{u, v, w} S}
    (TX : FiniteLevelSystem X)
    (TY : FiniteLevelSystem Y)
    (h : proObject X TX ⟶ proObject Y TY) (e : ℕ) :
    (Ideal.Quotient.factorPow (DividedPowers.pAdicIdeal (A := Y.ring) S.p)
        (Nat.add_le_add_left (Nat.le_succ e) TY.cutoff)).comp
      (proHomQuotientMap TX TY h (e + 1)) = proHomQuotientMap TX TY h e := by
  apply RingHom.ext
  intro x
  apply (finiteLevelRingEquiv TY e).injective
  change (finiteLevelRingEquiv TY e).toRingHom
      (Ideal.Quotient.factorPow (DividedPowers.pAdicIdeal (A := Y.ring) S.p)
        (Nat.add_le_add_left (Nat.le_succ e) TY.cutoff)
        (proHomQuotientMap TX TY h (e + 1) x)) =
    (finiteLevelRingEquiv TY e).toRingHom (proHomQuotientMap TX TY h e x)
  rw [← RingHom.comp_apply, finiteLevelRingEquiv_factor_comp]
  change (TY.transition (Nat.le_succ e)).hom.hom.toRingHom
      ((finiteLevelRingEquiv TY (e + 1))
        ((finiteLevelRingEquiv TY (e + 1)).symm
        ((proHomChosenRep TX TY h (e + 1)).2.hom.hom.toRingHom.comp
          (TX.projection (proHomChosenRep TX TY h (e + 1)).1).toRingHom x))) =
    (finiteLevelRingEquiv TY e)
      ((finiteLevelRingEquiv TY e).symm
      ((proHomChosenRep TX TY h e).2.hom.hom.toRingHom.comp
        (TX.projection (proHomChosenRep TX TY h e).1).toRingHom x))
  rw [RingEquiv.apply_symm_apply, RingEquiv.apply_symm_apply]
  exact congrArg (fun f : X.ring →+* (TY.term e).1.ring => f x)
    (proHomChosenRep_map_compat TX TY h e).symm

/-- The ring map `B_X → B_Y` obtained from a map of pro-objects by completeness of `B_Y`. -/
private noncomputable def proHomRingMap
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CompletedCrystallineThickening.{u, v, w} S}
    (TX : FiniteLevelSystem X)
    (TY : FiniteLevelSystem Y)
    (h : proObject X TX ⟶ proObject Y TY) : X.ring →+* Y.ring := by
  classical
  let I := DividedPowers.pAdicIdeal (A := Y.ring) S.p
  let a : ℕ → ℕ := fun e => TY.cutoff + e
  have ha : StrictMono a := fun _ _ h => by simpa [a] using h
  let := isAdicComplete_pAdicIdeal Y
  exact IsAdicComplete.StrictMono.liftRingHom I ha
    (proHomQuotientMap TX TY h)
    (fun {e} => by
      simpa [a] using proHomQuotientMap_compatible TX TY h e)

/-- The reduction of the ring map above at each level is the finite-level map it was built
from. -/
private theorem proHomRingMap_mk
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CompletedCrystallineThickening.{u, v, w} S}
    (TX : FiniteLevelSystem X)
    (TY : FiniteLevelSystem Y)
    (h : proObject X TX ⟶ proObject Y TY) (e : ℕ) :
    (Ideal.Quotient.mk ((DividedPowers.pAdicIdeal (A := Y.ring) S.p) ^ (TY.cutoff + e))).comp
      (proHomRingMap TX TY h) = proHomQuotientMap TX TY h e := by
  classical
  let I := DividedPowers.pAdicIdeal (A := Y.ring) S.p
  let a : ℕ → ℕ := fun e => TY.cutoff + e
  have ha : StrictMono a := fun _ _ h => by simpa [a] using h
  let := isAdicComplete_pAdicIdeal Y
  simpa [I, a, ha, proHomRingMap] using
    (IsAdicComplete.StrictMono.mk_comp_liftRingHom I ha
      (proHomQuotientMap TX TY h)
      (fun {n} => by
        simpa [a] using proHomQuotientMap_compatible TX TY h n) (n := e))

/-- The composite of the ring map above with a projection of the target system is the
chosen level representative. -/
private theorem proHomRingMap_projection
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CompletedCrystallineThickening.{u, v, w} S}
    (TX : FiniteLevelSystem X)
    (TY : FiniteLevelSystem Y)
    (h : proObject X TX ⟶ proObject Y TY) (e : ℕ) :
    (TY.projection e).toRingHom.comp (proHomRingMap TX TY h) =
      (proHomChosenRep TX TY h e).2.hom.hom.toRingHom.comp
        (TX.projection (proHomChosenRep TX TY h e).1).toRingHom := by
  apply RingHom.ext
  intro x
  calc
    (TY.projection e).toRingHom (proHomRingMap TX TY h x) =
        finiteLevelRingEquiv TY e
          (Ideal.Quotient.mk _ (proHomRingMap TX TY h x)) :=
      (finiteLevelRingEquiv_mk TY e (proHomRingMap TX TY h x)).symm
    _ = finiteLevelRingEquiv TY e (proHomQuotientMap TX TY h e x) :=
      congrArg (finiteLevelRingEquiv TY e)
        (congrArg (fun f : X.ring →+* _ => f x) (proHomRingMap_mk TX TY h e))
    _ = (proHomChosenRep TX TY h e).2.hom.hom.toRingHom
          ((TX.projection (proHomChosenRep TX TY h e).1).toRingHom x) := by
      change (finiteLevelRingEquiv TY e)
        ((finiteLevelRingEquiv TY e).symm
          ((proHomChosenRep TX TY h e).2.hom.hom.toRingHom.comp
            (TX.projection (proHomChosenRep TX TY h e).1).toRingHom x)) = _
      rw [RingEquiv.apply_symm_apply]
      rfl

/-- Two elements of a completed thickening with the same image at every finite level are
equal. -/
private theorem finiteLevel_projections_eq_implies_eq
    {S : AffineCrystallineSituation.{u, v}}
    {Y : CompletedCrystallineThickening.{u, v, w} S}
    (TY : FiniteLevelSystem Y)
    {x y : Y.ring}
    (h : ∀ e, (TY.projection e).toRingHom x = (TY.projection e).toRingHom y) : x = y := by
  let I := DividedPowers.pAdicIdeal (A := Y.ring) S.p
  let := isAdicComplete_pAdicIdeal Y
  rw [IsHausdorff.eq_iff_smodEq (I := I)]
  intro n
  have hker : x - y ∈ I ^ (TY.cutoff + n) := by
    have hk : x - y ∈ RingHom.ker (TY.projection n).toRingHom :=
      RingHom.mem_ker.mpr (by simp [map_sub, h n])
    rw [TY.projection_ker n] at hk
    simpa [I] using hk
  apply SModEq.sub_mem.mpr
  simpa [I, Ideal.smul_top_eq_map] using
    (Ideal.pow_le_pow_right (Nat.le_add_left n TY.cutoff) hker : x - y ∈ I ^ n)

/-- A map of pro-objects comes from a morphism of the completed crystalline thickenings. -/
private noncomputable def proHomToCompletedHom
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CompletedCrystallineThickening.{u, v, w} S}
    (TX : FiniteLevelSystem X)
    (TY : FiniteLevelSystem Y)
    (h : proObject X TX ⟶ proObject Y TY) : X ⟶ Y := by
  classical
  let f := proHomRingMap TX TY h
  let r0 := proHomChosenRep TX TY h 0
  let qY := Ideal.quotientMap (TY.term 0).1.ring.ideal
    (TY.projection 0).toRingHom
    (Ideal.map_le_iff_le_comap.mp (TY.projection 0).ideal_comp)
  let qg := Ideal.quotientMap (TY.term 0).1.ring.ideal
    r0.2.hom.hom.toRingHom
    (Ideal.map_le_iff_le_comap.mp r0.2.hom.hom.ideal_comp)
  have hqY : Function.Injective qY := finiteLevel_projection_quotientMap_injective TY 0
  have hlevel0 : ∀ x, qY (Ideal.Quotient.mk Y.ring.ideal (f x)) =
      qg (Ideal.Quotient.mk (TX.term r0.1).1.ring.ideal ((TX.projection r0.1).toRingHom x)) := by
    intro x
    have hx := RingHom.congr_fun (proHomRingMap_projection TX TY h 0) x
    simp only [qY, qg, Ideal.quotientMap_mk]
    exact congrArg _ hx
  have hIdeal : X.ring.ideal.map f ≤ Y.ring.ideal := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    have hsourceZero : Ideal.Quotient.mk (TX.term r0.1).1.ring.ideal
        ((TX.projection r0.1).toRingHom x) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr
        ((TX.projection r0.1).ideal_comp (Ideal.mem_map_of_mem _ hx))
    have hquotient_zero : Ideal.Quotient.mk Y.ring.ideal (f x) = 0 :=
      hqY (by rw [hlevel0, hsourceZero, map_zero, map_zero])
    exact Ideal.mem_comap.mpr (Ideal.Quotient.eq_zero_iff_mem.mp hquotient_zero)
  have hDpow : ∀ {n : ℕ} {x : X.ring}, x ∈ X.ring.ideal →
      Y.ring.dividedPowers.dpow n (f x) = f (X.ring.dividedPowers.dpow n x) := by
    intro n x hx
    apply finiteLevel_projections_eq_implies_eq TY
    intro e
    let r := proHomChosenRep TX TY h e
    have hproj := RingHom.congr_fun (proHomRingMap_projection TX TY h e)
    have hXideal : (TX.projection r.1).toRingHom x ∈ (TX.term r.1).1.ring.ideal :=
      (TX.projection r.1).ideal_comp (Ideal.mem_map_of_mem _ hx)
    have hYideal : f x ∈ Y.ring.ideal := hIdeal (Ideal.mem_map_of_mem f hx)
    have hprojXdp := DividedPowers.IsDPMorphism.map_dpow
      (TX.projection r.1).isDPMorphism hx (n := n)
    have hgdp := DividedPowers.IsDPMorphism.map_dpow
      r.2.hom.hom.isDPMorphism hXideal (n := n)
    have hprojYdp := DividedPowers.IsDPMorphism.map_dpow
      (TY.projection e).isDPMorphism hYideal (n := n)
    calc
      (TY.projection e).toRingHom (Y.ring.dividedPowers.dpow n (f x)) =
          (TY.term e).1.ring.dividedPowers.dpow n
            ((TY.projection e).toRingHom (f x)) := hprojYdp
      _ = (TY.term e).1.ring.dividedPowers.dpow n
            (r.2.hom.hom.toRingHom ((TX.projection r.1).toRingHom x)) :=
        congrArg _ (hproj x)
      _ = r.2.hom.hom.toRingHom
            ((TX.term r.1).1.ring.dividedPowers.dpow n
              ((TX.projection r.1).toRingHom x)) := hgdp.symm
      _ = r.2.hom.hom.toRingHom
            ((TX.projection r.1).toRingHom (X.ring.dividedPowers.dpow n x)) := by
        rw [hprojXdp]
      _ = (TY.projection e).toRingHom (f (X.ring.dividedPowers.dpow n x)) :=
        (hproj _).symm
  let dpm : DividedPowers.DPMorphism X.ring.dividedPowers Y.ring.dividedPowers :=
    DividedPowers.DPMorphism.mk' ⟨hIdeal, fun {n} x hx => hDpow (n := n) (x := x) hx⟩
  refine { hom := dpm, fromBase_comp := ?_, toQuotient_comp := ?_ }
  · apply DividedPowers.DPMorphism.ext
    funext a
    apply finiteLevel_projections_eq_implies_eq TY
    intro e
    let r := proHomChosenRep TX TY h e
    have hproj := RingHom.congr_fun (proHomRingMap_projection TX TY h e)
    have hXbase : (TX.projection r.1).toRingHom.comp X.fromBase.toRingHom =
        (TX.term r.1).1.fromBase.toRingHom :=
      congrArg (fun k : DividedPowers.DPMorphism S.A.dividedPowers
        (TX.term r.1).1.ring.dividedPowers => k.toRingHom)
        (TX.projection_fromBase r.1)
    have hYbase : (TY.projection e).toRingHom.comp Y.fromBase.toRingHom =
        (TY.term e).1.fromBase.toRingHom :=
      congrArg (fun k : DividedPowers.DPMorphism S.A.dividedPowers
        (TY.term e).1.ring.dividedPowers => k.toRingHom)
        (TY.projection_fromBase e)
    have hgmor : r.2.hom.hom.toRingHom.comp (TX.term r.1).1.fromBase.toRingHom =
        (TY.term e).1.fromBase.toRingHom :=
      congrArg (fun k : DividedPowers.DPMorphism S.A.dividedPowers
        (TY.term e).1.ring.dividedPowers => k.toRingHom) r.2.hom.fromBase_comp
    calc
      (TY.projection e).toRingHom (dpm.comp X.fromBase a) =
          r.2.hom.hom.toRingHom ((TX.projection r.1).toRingHom (X.fromBase a)) :=
        hproj (X.fromBase a)
      _ = r.2.hom.hom.toRingHom ((TX.term r.1).1.fromBase a) :=
        congrArg _ (RingHom.congr_fun hXbase a)
      _ = (TY.term e).1.fromBase a := RingHom.congr_fun hgmor a
      _ = (TY.projection e).toRingHom (Y.fromBase a) := (RingHom.congr_fun hYbase a).symm
  · apply RingHom.ext
    intro c
    let qX := Ideal.quotientMap (TX.term r0.1).1.ring.ideal
      (TX.projection r0.1).toRingHom
      (Ideal.map_le_iff_le_comap.mp (TX.projection r0.1).ideal_comp)
    have hqg : qg.comp (TX.term r0.1).1.toQuotient = (TY.term 0).1.toQuotient := by
      simpa [qg, DividedPowerRing.quotientRingHom] using
        r0.2.hom.toQuotient_comp
    apply hqY
    obtain ⟨x, hx⟩ := Ideal.Quotient.mk_surjective (X.toQuotient c)
    change qY ((DividedPowerRing.quotientRingHom
      dpm) (X.toQuotient c)) = qY (Y.toQuotient c)
    rw [← hx]
    calc
      qY ((DividedPowerRing.quotientRingHom
          dpm) (Ideal.Quotient.mk X.ring.ideal x)) =
          qY (Ideal.Quotient.mk Y.ring.ideal (f x)) := rfl
      _ = qg (Ideal.Quotient.mk (TX.term r0.1).1.ring.ideal
          ((TX.projection r0.1).toRingHom x)) := hlevel0 x
      _ = qg (qX (Ideal.Quotient.mk X.ring.ideal x)) := by
        simp [qX]
      _ = qg ((TX.term r0.1).1.toQuotient c) := by
        apply congrArg qg
        calc
          qX (Ideal.Quotient.mk X.ring.ideal x) = qX (X.toQuotient c) :=
            congrArg qX hx
          _ = (TX.term r0.1).1.toQuotient c := by
            simpa [qX, RingHom.comp_apply] using
              congrArg (fun k : S.C →+* (TX.term r0.1).1.ring ⧸
                (TX.term r0.1).1.ring.ideal => k c) (TX.projection_toQuotient r0.1)
      _ = (TY.term 0).1.toQuotient c := by
        simpa [RingHom.comp_apply] using
          congrArg (fun k : S.C →+* (TY.term 0).1.ring ⧸ (TY.term 0).1.ring.ideal => k c) hqg
      _ = qY (Y.toQuotient c) := by
        symm
        simpa [qY, RingHom.comp_apply] using
          congrArg (fun k : S.C →+* (TY.term 0).1.ring ⧸ (TY.term 0).1.ring.ideal => k c)
            (TY.projection_toQuotient 0)

/-- Two finite-level morphisms inducing the same map out of the completed thickening agree
after passing to a common deeper level. -/
private theorem finiteLevel_maps_equal_after_transition
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CompletedCrystallineThickening.{u, v, w} S}
    (TX : FiniteLevelSystem X)
    (TY : FiniteLevelSystem Y)
    {e i i' k : ℕ} (hi : i ≤ k) (hi' : i' ≤ k)
    (g : TX.term i ⟶ TY.term e) (g' : TX.term i' ⟶ TY.term e)
    (hproj : g.hom.hom.toRingHom.comp (TX.projection i).toRingHom =
      g'.hom.hom.toRingHom.comp (TX.projection i').toRingHom) :
    TX.transition hi ≫ g = TX.transition hi' ≫ g' := by
  have hp :
      (g.hom.hom.toRingHom.comp (TX.transition hi).hom.hom.toRingHom).comp
          (TX.projection k).toRingHom =
        (g'.hom.hom.toRingHom.comp (TX.transition hi').hom.hom.toRingHom).comp
          (TX.projection k).toRingHom := by
    rw [RingHom.comp_assoc, RingHom.comp_assoc, transition_comp_projection_toRingHom,
      transition_comp_projection_toRingHom, hproj]
  apply ObjectProperty.hom_ext
  apply DividedPowerThickening.Hom.ext
  apply DividedPowers.DPMorphism.ext
  funext x
  obtain ⟨y, rfl⟩ := TX.projection_surjective k x
  change g.hom.hom.toRingHom
      ((TX.transition hi).hom.hom.toRingHom ((TX.projection k).toRingHom y)) =
    g'.hom.hom.toRingHom
      ((TX.transition hi').hom.hom.toRingHom ((TX.projection k).toRingHom y))
  simpa [RingHom.comp_apply] using congrArg (fun m : X.ring →+* (TY.term e).1.ring => m y) hp

/-- For a map of pro-objects coming from a morphism of completed thickenings, the chosen
level representative computes that morphism. -/
private theorem proHomChosenRep_projection_eq
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CompletedCrystallineThickening.{u, v, w} S}
    (TX : FiniteLevelSystem X)
    (TY : FiniteLevelSystem Y)
    (f : X ⟶ Y) (e : ℕ) :
    (proHomChosenRep TX TY (proMap TX TY f) e).2.hom.hom.toRingHom.comp
        (TX.projection (proHomChosenRep TX TY (proMap TX TY f) e).1).toRingHom =
      (TY.projection e).toRingHom.comp f.hom.toRingHom := by
  classical
  let r := proHomChosenRep TX TY (proMap TX TY f) e
  let g := factorAtLevel TX TY f e
  obtain ⟨k, hi, hi', heq⟩ := proHom_level_representatives_eventually_equal
    TX TY (proMap TX TY f) r.2 g (le_refl e)
    (proHomChosenRep_spec TX TY (proMap TX TY f) e)
    (proMap_ι TX TY f e)
  exact (comp_projection_eq_of_transition_comp_eq TX TY hi hi' r.2 g
    (by simpa only [TY.transition_id, Category.comp_id] using heq)).trans
      (factorAtLevel_spec TX TY f e)

/-- Taking the pro-object map of a morphism and reconstructing a morphism gives back the
original morphism. -/
private theorem proHomToCompletedHom_proMap
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CompletedCrystallineThickening.{u, v, w} S}
    (TX : FiniteLevelSystem X)
    (TY : FiniteLevelSystem Y)
    (f : X ⟶ Y) :
    proHomToCompletedHom TX TY (proMap TX TY f) = f := by
  apply CompletedCrystallineThickening.Hom.ext
  apply DividedPowers.DPMorphism.ext
  funext x
  apply finiteLevel_projections_eq_implies_eq TY
  intro e
  change (TY.projection e).toRingHom (proHomRingMap TX TY (proMap TX TY f) x) =
    (TY.projection e).toRingHom (f.hom x)
  exact (RingHom.congr_fun (proHomRingMap_projection TX TY (proMap TX TY f) e) x).trans
    (RingHom.congr_fun (proHomChosenRep_projection_eq TX TY f e) x)

/-- Reconstructing a morphism from a map of pro-objects and taking its pro-object map gives
back the original map. -/
private theorem proMap_proHomToCompletedHom
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CompletedCrystallineThickening.{u, v, w} S}
    (TX : FiniteLevelSystem X)
    (TY : FiniteLevelSystem Y)
    (h : proObject X TX ⟶ proObject Y TY) :
    proMap TX TY (proHomToCompletedHom TX TY h) = h := by
  apply Quiver.Hom.unop_inj
  apply ObjectProperty.hom_ext
  apply (presentationColimit TY).isColimit.hom_ext
  intro j
  let e := j.unop.unop
  let f := proHomToCompletedHom TX TY h
  let r := proHomChosenRep TX TY h e
  let g := factorAtLevel TX TY f e
  have hg :
      (presentationColimit TY).cocone.ι.app (op (op e)) ≫ h.unop.hom =
        yoneda.map r.2.op ≫
          (presentationColimit TX).cocone.ι.app (op (op r.1)) :=
    proHomChosenRep_spec TX TY h e
  have hg' :
      (presentationColimit TY).cocone.ι.app (op (op e)) ≫
          (proMap TX TY f).unop.hom =
        yoneda.map g.op ≫
          (presentationColimit TX).cocone.ι.app (op (op (TY.cutoff + e))) :=
    proMap_ι TX TY f e
  have hproj :
      r.2.hom.hom.toRingHom.comp (TX.projection r.1).toRingHom =
        g.hom.hom.toRingHom.comp (TX.projection (TY.cutoff + e)).toRingHom :=
    (proHomRingMap_projection TX TY h e).symm.trans (factorAtLevel_spec TX TY f e).symm
  let k := max r.1 (TY.cutoff + e)
  have hi : r.1 ≤ k := Nat.le_max_left _ _
  have hi' : TY.cutoff + e ≤ k := Nat.le_max_right _ _
  have heq := finiteLevel_maps_equal_after_transition TX TY hi hi' r.2 g hproj
  let legK : (yoneda (C := (CrystallineThickening.{u, v, w} S)ᵒᵖ)).obj
      (op (TX.term k)) ⟶ (presentationColimit TX).cocone.pt :=
    (presentationColimit TX).cocone.ι.app (op (op k))
  have hrep : ∀ {i : ℕ} (hi : i ≤ k) (m : TX.term i ⟶ TY.term e),
      yoneda.map m.op ≫ (presentationColimit TX).cocone.ι.app (op (op i)) =
        yoneda.map (TX.transition hi ≫ m).op ≫ legK := by
    intro i hi m
    have hleg : yoneda.map (TX.transition hi).op ≫ legK =
        (presentationColimit TX).cocone.ι.app (op (op i)) := by
      simpa [legK, proPresentation, FiniteLevelSystem.diagram] using
        (presentationColimit TX).cocone.w ((homOfLE hi).op.op)
    rw [op_comp, Functor.map_comp, Category.assoc, hleg]
  refine hg'.trans (Eq.trans ?_ hg.symm)
  rw [hrep hi' g, hrep hi r.2, heq]

/-- The canonical pro-object construction sends each completed thickening to its
system of sufficiently deep crystalline quotients. On a morphism, its component
at each finite quotient is induced by a map from a sufficiently deep quotient
of the source. -/
@[stacks 07KH "pro_objects"]
public noncomputable def completedCrystallineToPro
    (S : AffineCrystallineSituation.{u, v}) :
    { F : CompletedCrystallineThickening.{u, v, w} S ⥤
        ProCrystallineThickening.{u, v, w} S //
      ∃ (T : ∀ X, FiniteLevelSystem X)
        (α : ∀ X, (F.obj X).unop.obj ≅
          colimit ((FiniteLevelSystem.diagram (T X)).op ⋙
            yoneda (C := (CrystallineThickening.{u, v, w} S)ᵒᵖ))),
        ∀ (X Y :
          CompletedCrystallineThickening.{u, v, w} S)
          (f : X ⟶ Y) (e : ℕ),
          ∃ (i : ℕ) (g : (T X).term i ⟶ (T Y).term e),
            (g.hom.hom.comp ((T X).projection i) =
              ((T Y).projection e).comp f.hom) ∧
            (colimit.ι ((FiniteLevelSystem.diagram (T Y)).op ⋙
                yoneda (C := (CrystallineThickening.{u, v, w} S)ᵒᵖ)) (op (op e)) ≫
                (α Y).inv ≫ ((F.map f).unop).hom ≫ (α X).hom =
              (yoneda (C := (CrystallineThickening.{u, v, w} S)ᵒᵖ)).map g.op ≫
                colimit.ι ((FiniteLevelSystem.diagram (T X)).op ⋙
                  yoneda (C := (CrystallineThickening.{u, v, w} S)ᵒᵖ))
                  (op (op i))) } := by
  classical
  let T : ∀ X : CompletedCrystallineThickening.{u, v, w} S,
      FiniteLevelSystem X :=
    fun X => finiteSystems S X
  let F : CompletedCrystallineThickening.{u, v, w} S ⥤
      ProCrystallineThickening.{u, v, w} S := {
    obj := fun X => proObject X (T X)
    map := fun {X Y} f => proMap (T X) (T Y) f
    map_id := by intro X; exact proMap_id (T X)
    map_comp := by
      intro X Y Z f g
      exact (proMap_comp (T X) (T Y) (T Z) f g).symm
  }
  refine ⟨F, T, (fun X => presentationIso (T X)), ?_⟩
  intro X Y f e
  let TX := T X
  let TY := T Y
  let i := TY.cutoff + e
  let g := factorAtLevel TX TY f e
  refine ⟨i, g, ?_, ?_⟩
  · apply DividedPowers.DPMorphism.ext
    funext x
    have h := congrArg (fun k : X.ring →+* (TY.term e).1.ring => k x)
      (factorAtLevel_spec TX TY f e)
    simpa [RingHom.comp_apply] using h
  · dsimp only [F, TX, TY, g, i]
    simp only [← Category.assoc, presentationIso_ι_inv, proMap_ι]
    let legX : (yoneda (C := (CrystallineThickening.{u, v, w} S)ᵒᵖ)).obj
        (op ((T X).term ((T Y).cutoff + e))) ⟶
          (presentationColimit (T X)).cocone.pt :=
      (presentationColimit (T X)).cocone.ι.app (op (op ((T Y).cutoff + e)))
    have hHom : legX ≫ (presentationIso (T X)).hom =
        colimit.ι ((FiniteLevelSystem.diagram (T X)).op ⋙
          yoneda (C := (CrystallineThickening.{u, v, w} S)ᵒᵖ))
          (op (op ((T Y).cutoff + e))) := by
      simpa [legX, FiniteLevelSystem.diagram] using
        (presentationIso_ι_hom (T X) ((T Y).cutoff + e))
    change (yoneda.map (factorAtLevel (T X) (T Y) f e).op ≫ legX) ≫
        (presentationIso (T X)).hom = _
    simp only [Category.assoc, hHom]

/-- Completed crystalline thickenings form a full subcategory of crystalline
pro-objects under the finite-level quotient construction. -/
@[stacks 07KH "pro_objects"]
public theorem completedCrystallineToPro_fullyFaithful
    (S : AffineCrystallineSituation.{u, v}) :
    Nonempty (completedCrystallineToPro.{u, v, w} S).val.FullyFaithful := by
  classical
  refine ⟨{
    preimage := fun {X Y} h => by
      change proObject X (finiteSystems S X) ⟶ proObject Y (finiteSystems S Y) at h
      exact proHomToCompletedHom (finiteSystems S X) (finiteSystems S Y) h
    map_preimage := by
      intro X Y h
      change proMap (finiteSystems S X) (finiteSystems S Y)
        (proHomToCompletedHom (finiteSystems S X) (finiteSystems S Y) h) = h
      exact proMap_proHomToCompletedHom (finiteSystems S X) (finiteSystems S Y) h
    preimage_map := by
      intro X Y f
      change proHomToCompletedHom (finiteSystems S X) (finiteSystems S Y)
        (proMap (finiteSystems S X) (finiteSystems S Y) f) = f
      exact proHomToCompletedHom_proMap (finiteSystems S X) (finiteSystems S Y) f
  }⟩

end ProObject

