/-!
# Finite levels of the divided power envelope of a presentation and its completion

Continuing `StacksFrontier.AlgebraicGeometry.Crystalline.AffineSite.Completed.Envelope`: the
reductions modulo `(p)^e` of the `p`-adic completion agree with those of the ring itself, the
universal property of the completed divided power structure is transported across universes,
and at large levels the reductions of the envelope and of its completion are both identified
with the divided power envelope of the reduced presentation
(`Crystalline.eventually_quotient_envelope_equiv`,
`Crystalline.eventually_completed_quotient_equiv`, [Stacks, Tag 07KG] part (2)).  Each such
finite level is an object of the little crystalline category `Cris(C/A)`
(`Crystalline.levelCrystallineThickening`, [Stacks, Tag 07KG] part (3)).

## References

* [Stacks Project, Tag 07KG](https://stacks.math.columbia.edu/tag/07KG)
-/

@[expose] public section

open CategoryTheory

universe u v w

namespace Crystalline

section FiniteLevelEnvelope

variable (s : AffineCrystallineSituation.{u, v})
variable {P : Type u} [CommRing P] [Algebra s.A P]
variable (f : P →ₐ[s.A] s.C)

/-- The kernel of evaluation at level `e` on the `p`-adic completion is the `e`-th power of the
ideal generated by `p` in the completion. -/
public theorem pAdicCompletionEvalKer
    {A : Type u} [CommRing A] (p e : ℕ) :
    RingHom.ker
      (AdicCompletion.evalₐ (DividedPowers.pAdicIdeal (A := A) p) e).toRingHom =
      DividedPowers.pAdicIdeal
          (A := AdicCompletion (DividedPowers.pAdicIdeal (A := A) p) A) p ^ e := by
  let P : Ideal A := DividedPowers.pAdicIdeal (A := A) p
  let Ahat := AdicCompletion P A
  have hP : DividedPowers.pAdicIdeal (A := Ahat) p = P.map (algebraMap A Ahat) := by
    change Ideal.span {(p : Ahat)} = (Ideal.span {(p : A)}).map (algebraMap A Ahat)
    rw [Ideal.map_span]
    simp
  rw [hP, ← Ideal.map_pow]
  ext x
  rw [RingHom.mem_ker]
  symm
  change x ∈ ((P ^ e).map (algebraMap A Ahat)).restrictScalars A ↔
    (AdicCompletion.evalₐ P e).toRingHom x = 0
  have hPfg : P.FG := by
    refine ⟨{(p : A)}, ?_⟩
    simp [P, DividedPowers.pAdicIdeal]
  rw [← Submodule.restrictScalars_mem A, ← Ideal.smul_top_eq_map,
    AdicCompletion.pow_smul_top_eq_ker_eval hPfg]
  have hEq : (P ^ e • (⊤ : Submodule A A) : Ideal A) = P ^ e := by
    ext y
    simp
  have hinj : Function.Injective (Ideal.Quotient.factor (le_of_eq hEq)) := by
    simpa [RingHom.injective_iff_ker_eq_bot, Ideal.Quotient.factor_ker] using
      Ideal.map_mk_eq_bot_of_le (le_of_eq hEq.symm)
  simpa [← AdicCompletion.factor_eval_eq_evalₐ] using
    (map_eq_zero_iff (Ideal.Quotient.factor (le_of_eq hEq)) hinj).symm

/-- Reducing the `p`-adic completion modulo `(p)^e` recovers the reduction of the ring itself. -/
public noncomputable def pAdicCompletionQuotientEquiv
    {A : Type u} [CommRing A] (p e : ℕ) :
    (AdicCompletion (DividedPowers.pAdicIdeal (A := A) p) A ⧸
        DividedPowers.pAdicIdeal
            (A := AdicCompletion (DividedPowers.pAdicIdeal (A := A) p) A) p ^ e) ≃+*
      A ⧸ DividedPowers.pAdicIdeal (A := A) p ^ e := by
  let eval := (AdicCompletion.evalₐ (DividedPowers.pAdicIdeal (A := A) p) e).toRingHom
  exact (Ideal.quotEquivOfEq (pAdicCompletionEvalKer p e).symm).trans
    (RingHom.quotientKerEquivOfSurjective
      (f := eval) (AdicCompletion.surjective_evalₐ (DividedPowers.pAdicIdeal (A := A) p) e))

/-- The comparison of `(p)^e`-reductions of `A` and of its `p`-adic completion is the identity
on the image of `A`. -/
public theorem pAdicCompletionQuotientEquiv_mk
    {A : Type u} [CommRing A] (p e : ℕ) (x : A) :
    pAdicCompletionQuotientEquiv p e
      (Ideal.Quotient.mk _ (algebraMap A
        (AdicCompletion (DividedPowers.pAdicIdeal (A := A) p) A) x)) =
      Ideal.Quotient.mk (DividedPowers.pAdicIdeal (A := A) p ^ e) x := by
  change pAdicCompletionQuotientEquiv p e
    (Ideal.Quotient.mk _ (AdicCompletion.of (DividedPowers.pAdicIdeal (A := A) p) A x)) = _
  simp only [pAdicCompletionQuotientEquiv, RingEquiv.trans_apply,
    Ideal.quotEquivOfEq_mk,
    RingHom.quotientKerEquivOfSurjective_apply_mk]
  change AdicCompletion.evalₐ (DividedPowers.pAdicIdeal (A := A) p) e
    (AdicCompletion.of (DividedPowers.pAdicIdeal (A := A) p) A x) = _
  exact AdicCompletion.evalₐ_of (DividedPowers.pAdicIdeal (A := A) p) e x

universe u' v' w'

/-- The universal property of the completed divided power structure, transported to an
arbitrary target universe by lifting the target along `ULift`. -/
public theorem completionLimitUniversal_down
    {A : Type u'} [CommRing A] (I : Ideal A) (γ : DividedPowers I)
    (p : ℕ) (hp : IsNilpotent (Ideal.Quotient.mk I (p : A))) (N : ℕ)
    (hlevel : ∀ e, N ≤ e →
      (DividedPowers.pAdicIdeal (A := A) p ^ e ≤ I) ∧
        γ.IsSubDPIdeal (DividedPowers.pAdicIdeal (A := A) p ^ e))
    (hlimit : DividedPowers.IsDividedPowerCompletionLimit.{u', max v' w'} I γ p hp N hlevel)
    {B : Type v'} [CommRing B] (J : Ideal B) (δ : DividedPowers J)
    (cone : ∀ e (he : N ≤ e),
      DividedPowers.DPMorphism δ
        (DividedPowers.quotientDividedPowers I γ p e (hlevel e he).1 (hlevel e he).2))
    (hcone : ∀ (m e : ℕ) (hm : N ≤ m) (he : N ≤ e) (hme : m ≤ e),
      (Ideal.Quotient.factor (Ideal.pow_le_pow_right hme)).comp
          (cone e he).toRingHom = (cone m hm).toRingHom) :
    ∃! g : DividedPowers.DPMorphism δ
        (DividedPowers.completedDividedPowers I γ p hp).1,
      ∀ e (he : N ≤ e),
        (AdicCompletion.evalₐ (DividedPowers.pAdicIdeal (A := A) p) e).toRingHom.comp
            g.toRingHom = (cone e he).toRingHom := by
  classical
  change (∀ e (he : N ≤ e),
      ((DividedPowers.completedDividedPowers I γ p hp).1).IsDPMorphism
        (DividedPowers.quotientDividedPowers I γ p e (hlevel e he).1 (hlevel e he).2)
        (AdicCompletion.evalₐ (DividedPowers.pAdicIdeal (A := A) p) e).toRingHom) ∧ _ at hlimit
  obtain ⟨_, hUniversal⟩ := hlimit
  let eULift : ULift.{max v' w', v'} B ≃+* B := ULift.ringEquiv
  let JLift : Ideal (ULift.{max v' w', v'} B) := J.map eULift.symm.toRingHom
  let δLift : DividedPowers JLift :=
    DividedPowers.ofRingEquiv (e := eULift.symm) (by rfl) δ
  have htoBase : δLift.IsDPMorphism δ eULift.toRingHom := by
    constructor
    · change JLift.map eULift.toRingHom ≤ J
      rw [show JLift.map eULift.toRingHom = J by
        dsimp [JLift]
        rw [Ideal.map_map]
        simp [eULift]]
    · intro n x hx
      change δ.dpow n (eULift x) =
        eULift (eULift.symm (δ.dpow n (eULift x)))
      rw [RingEquiv.apply_symm_apply]
  have hfromBase : δ.IsDPMorphism δLift eULift.symm.toRingHom :=
    ⟨le_of_eq rfl, fun _ _ => rfl⟩
  let toBaseDP : DividedPowers.DPMorphism δLift δ :=
    DividedPowers.DPMorphism.mk' htoBase
  let fromBaseDP : DividedPowers.DPMorphism δ δLift :=
    DividedPowers.DPMorphism.mk' hfromBase
  let coneLift (e : ℕ) (he : N ≤ e) :
      DividedPowers.DPMorphism δLift
        (DividedPowers.quotientDividedPowers I γ p e (hlevel e he).1 (hlevel e he).2) :=
    (cone e he).comp toBaseDP
  have hconeLift (m e : ℕ) (hm : N ≤ m) (he : N ≤ e) (hme : m ≤ e) :
      (Ideal.Quotient.factor (Ideal.pow_le_pow_right hme)).comp
          (coneLift e he).toRingHom = (coneLift m hm).toRingHom := by
    exact congrArg (fun q : B →+* A ⧸ DividedPowers.pAdicIdeal (A := A) p ^ m =>
      q.comp eULift.toRingHom) (hcone m e hm he hme)
  obtain ⟨gLift, hgLift, huniqLift⟩ := hUniversal JLift δLift coneLift hconeLift
  let g := gLift.comp fromBaseDP
  have hg (e : ℕ) (he : N ≤ e) :
      (AdicCompletion.evalₐ (DividedPowers.pAdicIdeal (A := A) p) e).toRingHom.comp
          g.toRingHom = (cone e he).toRingHom := by
    exact congrArg
      (fun q : ULift.{max v' w', v'} B →+* A ⧸ DividedPowers.pAdicIdeal (A := A) p ^ e =>
        q.comp eULift.symm.toRingHom) (hgLift e he)
  refine ⟨g, hg, ?_⟩
  intro g' hg'
  have hLiftCompat (e : ℕ) (he : N ≤ e) :
      (AdicCompletion.evalₐ (DividedPowers.pAdicIdeal (A := A) p) e).toRingHom.comp
          (g'.comp toBaseDP).toRingHom = (coneLift e he).toRingHom := by
    exact congrArg
      (fun q : B →+* A ⧸ DividedPowers.pAdicIdeal (A := A) p ^ e => q.comp eULift.toRingHom)
      (hg' e he)
  have hLiftEq : gLift = g'.comp toBaseDP := (huniqLift (g'.comp toBaseDP) hLiftCompat).symm
  calc
    g' = (g'.comp toBaseDP).comp fromBaseDP := by
      apply DividedPowers.DPMorphism.ext
      funext x
      change g'.toRingHom (eULift (eULift.symm x)) = g'.toRingHom x
      simp
    _ = gLift.comp fromBaseDP := by rw [← hLiftEq]
    _ = g := rfl

/-- At a level `e` where `(p)^e` is contained in the divided power ideals of both the envelope
and its completion and is stable under both divided power structures, the two reductions
modulo `(p)^e` agree as divided power rings, compatibly with the canonical map from the
envelope. -/
public noncomputable def completedQuotientBridge (e : ℕ)
    (hp : IsNilpotent (Ideal.Quotient.mk (presentationEnvelope s f).object.ideal
      (s.p : (presentationEnvelope s f).object)))
    (hD : DividedPowers.pAdicIdeal (A := (presentationEnvelope s f).object) s.p ^ e ≤
      (presentationEnvelope s f).object.ideal)
    (hDstable : (presentationEnvelope s f).object.dividedPowers.IsSubDPIdeal
      (DividedPowers.pAdicIdeal (A := (presentationEnvelope s f).object) s.p ^ e))
    (hhat : DividedPowers.pAdicIdeal
        (A := AdicCompletion
          (DividedPowers.pAdicIdeal (A := (presentationEnvelope s f).object) s.p)
          (presentationEnvelope s f).object) s.p ^ e ≤
      DividedPowers.completionIdeal (presentationEnvelope s f).object.ideal s.p hp)
    (hhatStable : (DividedPowers.completedDividedPowers
        (presentationEnvelope s f).object.ideal
        (presentationEnvelope s f).object.dividedPowers s.p hp).1.IsSubDPIdeal
      (DividedPowers.pAdicIdeal
        (A := AdicCompletion
          (DividedPowers.pAdicIdeal (A := (presentationEnvelope s f).object) s.p)
          (presentationEnvelope s f).object) s.p ^ e))
    (hEval : (DividedPowers.completedDividedPowers
        (presentationEnvelope s f).object.ideal
        (presentationEnvelope s f).object.dividedPowers s.p hp).1.IsDPMorphism
      (DividedPowers.quotientDividedPowers (presentationEnvelope s f).object.ideal
        (presentationEnvelope s f).object.dividedPowers s.p e hD hDstable)
      (AdicCompletion.evalₐ
        (DividedPowers.pAdicIdeal (A := (presentationEnvelope s f).object) s.p) e).toRingHom) :
    let D := (presentationEnvelope s f).object
    let Dhat := AdicCompletion (DividedPowers.pAdicIdeal (A := D) s.p) D
    let Ihat := DividedPowers.completionIdeal D.ideal s.p hp
    let γhat := (DividedPowers.completedDividedPowers D.ideal D.dividedPowers s.p hp).1
    {φ : (Dhat ⧸ DividedPowers.pAdicIdeal (A := Dhat) s.p ^ e) ≃+*
        (D ⧸ DividedPowers.pAdicIdeal (A := D) s.p ^ e) //
      (∀ x : D, φ (Ideal.Quotient.mk (DividedPowers.pAdicIdeal (A := Dhat) s.p ^ e)
        (algebraMap D Dhat x)) =
          Ideal.Quotient.mk (DividedPowers.pAdicIdeal (A := D) s.p ^ e) x) ∧
      (DividedPowers.quotientDividedPowers Ihat γhat s.p e hhat hhatStable).IsDPMorphism
        (DividedPowers.quotientDividedPowers D.ideal D.dividedPowers s.p e hD hDstable)
        φ.toRingHom ∧
      (DividedPowers.quotientDividedPowers D.ideal D.dividedPowers s.p e hD hDstable).IsDPMorphism
        (DividedPowers.quotientDividedPowers Ihat γhat s.p e hhat hhatStable)
        φ.symm.toRingHom} := by
  classical
  dsimp
  let env := presentationEnvelope s f
  let D := env.object
  let P := DividedPowers.pAdicIdeal (A := D) s.p
  let Dhat := AdicCompletion P D
  let Phat := DividedPowers.pAdicIdeal (A := Dhat) s.p
  let Ihat := DividedPowers.completionIdeal D.ideal s.p hp
  let γhat := (DividedPowers.completedDividedPowers D.ideal D.dividedPowers s.p hp).1
  let qD : D →+* D ⧸ P ^ e := Ideal.Quotient.mk (P ^ e)
  let qhat : Dhat →+* Dhat ⧸ Phat ^ e := Ideal.Quotient.mk (Phat ^ e)
  let QD : DividedPowerRing :=
    ⟨D ⧸ P ^ e, D.ideal.map qD,
      DividedPowers.quotientDividedPowers D.ideal D.dividedPowers s.p e hD hDstable⟩
  let Qhat : DividedPowerRing :=
    ⟨Dhat ⧸ Phat ^ e, Ihat.map qhat,
      DividedPowers.quotientDividedPowers Ihat γhat s.p e hhat hhatStable⟩
  have hDInf : D.dividedPowers.IsSubDPIdeal (P ^ e ⊓ D.ideal) := by
    rw [inf_eq_left.mpr hD]
    exact hDstable
  have hqD : D.dividedPowers.IsDPMorphism QD.dividedPowers qD := by
    simpa [QD, DividedPowers.quotientDividedPowers, P,
      inf_eq_left.mpr hD] using
      (DividedPowers.Quotient.isDPMorphism D.dividedPowers hDInf)
  have hhatInf : γhat.IsSubDPIdeal (Phat ^ e ⊓ Ihat) := by
    rw [inf_eq_left.mpr hhat]
    exact hhatStable
  have hqhat : γhat.IsDPMorphism Qhat.dividedPowers qhat := by
    simpa [Qhat, DividedPowers.quotientDividedPowers, Phat,
      inf_eq_left.mpr hhat] using
      (DividedPowers.Quotient.isDPMorphism γhat hhatInf)
  let α : D →+* Dhat := algebraMap D Dhat
  have hcompletionEval : (DividedPowers.completionToQuotient D.ideal s.p hp).comp α =
      Ideal.Quotient.mk D.ideal := by
    ext x
    change Ideal.Quotient.factor
        (DividedPowers.pAdicIdeal_pow_nilpotencyExponent_le D.ideal s.p hp)
        (AdicCompletion.evalₐ P
          (DividedPowers.nilpotencyExponent D.ideal s.p hp) (AdicCompletion.of P D x)) = _
    rw [AdicCompletion.evalₐ_of]
    exact Ideal.Quotient.factor_mk _ x
  have hαIdeal : D.ideal.map α ≤ Ihat := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    change DividedPowers.completionToQuotient D.ideal s.p hp (α x) = 0
    rw [← RingHom.comp_apply, hcompletionEval]
    exact Ideal.Quotient.eq_zero_iff_mem.mpr hx
  have hα : D.dividedPowers.IsDPMorphism γhat α := by
    refine ⟨hαIdeal, ?_⟩
    intro n x hx
    let xhat : Ihat := ⟨α x, hαIdeal (Ideal.mem_map_of_mem α hx)⟩
    have hn := (DividedPowers.completedDividedPowers D.ideal D.dividedPowers s.p hp).2
      n x hx xhat rfl
    simpa [xhat, α] using hn
  let φ : Dhat ⧸ Phat ^ e ≃+* D ⧸ P ^ e :=
    pAdicCompletionQuotientEquiv s.p e
  let eval : Dhat →+* D ⧸ P ^ e :=
    (AdicCompletion.evalₐ P e).toRingHom
  have hφcomp : φ.toRingHom.comp qhat = eval := by
    ext x
    change pAdicCompletionQuotientEquiv s.p e (Ideal.Quotient.mk (Phat ^ e) x) = eval x
    simp only [pAdicCompletionQuotientEquiv, RingEquiv.trans_apply]
    rw [Ideal.quotEquivOfEq_mk, RingHom.quotientKerEquivOfSurjective_apply_mk]
  have hφDP : Qhat.dividedPowers.IsDPMorphism QD.dividedPowers φ.toRingHom :=
    DividedPowers.IsDPMorphism.of_comp γhat Qhat.dividedPowers
      QD.dividedPowers qhat φ.toRingHom (by rfl) hqhat (hφcomp ▸ hEval)
  have hψcomp : φ.symm.toRingHom.comp qD = qhat.comp α := by
    ext x
    apply φ.injective
    calc
      φ.toRingHom (φ.symm.toRingHom (qD x)) = qD x := φ.apply_symm_apply (qD x)
      _ = eval (α x) := by
        symm
        change AdicCompletion.evalₐ P e
          (AdicCompletion.of P D x) = Ideal.Quotient.mk (P ^ e) x
        exact AdicCompletion.evalₐ_of P e x
      _ = φ.toRingHom (qhat (α x)) := ((RingHom.ext_iff.mp hφcomp) (α x)).symm
  have hψDP : QD.dividedPowers.IsDPMorphism Qhat.dividedPowers φ.symm.toRingHom :=
    DividedPowers.IsDPMorphism.of_comp D.dividedPowers QD.dividedPowers
      Qhat.dividedPowers qD φ.symm.toRingHom (by rfl) hqD
      (hψcomp ▸ DividedPowers.IsDPMorphism.comp Qhat.dividedPowers hqhat hα)
  exact ⟨φ, fun x => pAdicCompletionQuotientEquiv_mk s.p e x, hφDP, hψDP⟩

/-- At large levels the envelope of the reduced presentation is canonically
the reduction of the original envelope. The equation on presentation maps
fixes the isomorphism, and the last condition preserves divided powers. -/
@[stacks 07KG "part (2), finite-level envelope"]
public noncomputable def eventually_quotient_envelope_equiv
    (hf : Function.Surjective f) :
    let env := presentationEnvelope s f
    let D := env.object
    Σ' N : ℕ, ∀ e, N ≤ e →
      Σ' hcontained : DividedPowers.pAdicIdeal (A := D) s.p ^ e ≤ D.ideal,
      Σ' hstable : D.dividedPowers.IsSubDPIdeal
          (DividedPowers.pAdicIdeal (A := D) s.p ^ e),
      {φ : (D ⧸ (DividedPowers.pAdicIdeal (A := D) s.p ^ e)) ≃+*
          (levelEnvelope s f e).object //
        (∀ x : P,
          φ (Ideal.Quotient.mk (DividedPowers.pAdicIdeal (A := D) s.p ^ e)
            (env.algebraMap.toRingHom x)) =
              (levelEnvelope s f e).algebraMap.toRingHom
                (Ideal.Quotient.mk (DividedPowers.pAdicIdeal (A := P) s.p ^ e) x)) ∧
          (DividedPowers.quotientDividedPowers D.ideal D.dividedPowers s.p e
            hcontained hstable).IsDPMorphism
              (levelEnvelope s f e).object.dividedPowers φ.toRingHom ∧
          (levelEnvelope s f e).object.dividedPowers.IsDPMorphism
                (DividedPowers.quotientDividedPowers D.ideal D.dividedPowers s.p e
                hcontained hstable) φ.symm.toRingHom} := by
  dsimp
  let hEv := eventually_pAdicIdeal_isSubDPIdeal s f hf
  let N := Classical.choose hEv
  have hN := Classical.choose_spec hEv
  refine ⟨N, ?_⟩
  intro e he
  obtain ⟨hcontained, hstable⟩ := hN e he
  refine ⟨hcontained, hstable, ?_⟩
  exact quotientEnvelopeEquiv s f e hcontained hstable

/-- Completion does not change the finite quotients, compatibly with their
canonical maps and divided powers. This is the other identification in (2). -/
@[stacks 07KG "part (2), completion quotient"]
public noncomputable def eventually_completed_quotient_equiv
    (hf : Function.Surjective f) :
    let D := (presentationEnvelope s f).object
    Σ' hp : IsNilpotent (Ideal.Quotient.mk D.ideal (s.p : D)),
      Σ' N : ℕ, ∀ e, N ≤ e →
        Σ' hD : DividedPowers.pAdicIdeal (A := D) s.p ^ e ≤ D.ideal,
        Σ' hDstable : D.dividedPowers.IsSubDPIdeal
            (DividedPowers.pAdicIdeal (A := D) s.p ^ e),
        let Dhat := AdicCompletion (DividedPowers.pAdicIdeal (A := D) s.p) D
        let Ihat := DividedPowers.completionIdeal D.ideal s.p hp
        let γhat := (DividedPowers.completedDividedPowers D.ideal D.dividedPowers s.p hp).1
        Σ' hhat : DividedPowers.pAdicIdeal (A := Dhat) s.p ^ e ≤ Ihat,
        Σ' hhatStable : γhat.IsSubDPIdeal (DividedPowers.pAdicIdeal (A := Dhat) s.p ^ e),
        {φ : (Dhat ⧸ (DividedPowers.pAdicIdeal (A := Dhat) s.p ^ e)) ≃+*
            (D ⧸ (DividedPowers.pAdicIdeal (A := D) s.p ^ e)) //
          (∀ x : D,
            φ (Ideal.Quotient.mk (DividedPowers.pAdicIdeal (A := Dhat) s.p ^ e)
              (algebraMap D Dhat x)) =
                Ideal.Quotient.mk (DividedPowers.pAdicIdeal (A := D) s.p ^ e) x) ∧
            (DividedPowers.quotientDividedPowers Ihat γhat s.p e hhat hhatStable).IsDPMorphism
              (DividedPowers.quotientDividedPowers D.ideal D.dividedPowers s.p e hD hDstable)
                φ.toRingHom ∧
            (DividedPowers.quotientDividedPowers D.ideal D.dividedPowers s.p e hD
                hDstable).IsDPMorphism
            (DividedPowers.quotientDividedPowers Ihat γhat s.p e hhat hhatStable)
                φ.symm.toRingHom} := by
  classical
  dsimp
  let D := (presentationEnvelope s f).object
  let hp := presentationEnvelope_prime_nilpotent s f hf
  letI : Algebra (DividedPowers.IntegersAtPrime s.p) D :=
    (((presentationEnvelope s f).structureMap.toRingHom).comp
      (algebraMap (DividedPowers.IntegersAtPrime s.p) s.A)).toAlgebra
  let hDEx := DividedPowers.eventually_isDividedPowerCompletionLimit.{u, u}
    (I := D.ideal) D.dividedPowers s.p hp
  let ND := Classical.choose hDEx
  let hDData := Classical.choose_spec hDEx
  let hDlevels := Classical.choose hDData
  have hDLimit := Classical.choose_spec hDData
  let Dhat := AdicCompletion (DividedPowers.pAdicIdeal (A := D) s.p) D
  let Ihat := DividedPowers.completionIdeal D.ideal s.p hp
  let γhat := (DividedPowers.completedDividedPowers D.ideal D.dividedPowers s.p hp).1
  let hpHat := completionIdeal_prime_nilpotent D.ideal s.p hp
  letI : Algebra (DividedPowers.IntegersAtPrime s.p) Dhat :=
    (((algebraMap D Dhat).comp
      (algebraMap (DividedPowers.IntegersAtPrime s.p) D)).toAlgebra)
  let hHatEx := DividedPowers.eventually_isDividedPowerCompletionLimit.{u, u}
    (I := Ihat) γhat s.p hpHat
  let NH := Classical.choose hHatEx
  let hHatData := Classical.choose_spec hHatEx
  let hHatLevels := Classical.choose hHatData
  let N := max ND NH
  refine ⟨hp, N, ?_⟩
  intro e he
  have heD : ND ≤ e := (Nat.le_max_left _ _).trans he
  have heHat : NH ≤ e := (Nat.le_max_right _ _).trans he
  obtain ⟨hD, hDstable⟩ := hDlevels e heD
  obtain ⟨hhat, hhatStable⟩ := hHatLevels e heHat
  refine ⟨hD, hDstable, hhat, hhatStable, ?_⟩
  have hEval := hDLimit.1 e heD
  exact completedQuotientBridge s f e hp hD hDstable hhat hhatStable hEval

/-- For large `e`, the finite envelope is a crystalline thickening of `C/A`. -/
@[stacks 07KG "part (3)"]
public noncomputable def levelCrystallineThickening
    (hf : Function.Surjective f) :
    Σ' N : ℕ, ∀ e, N ≤ e →
      {X : DividedPowerThickening.{u, v, u} s //
        DividedPowerThickening.IsCrystalline X ∧
          X.ring = (levelEnvelope s f e).object ∧
          HEq X.fromBase.toRingHom
            (levelEnvelope s f e).structureMap.toRingHom ∧
          ∀ x : P, HEq (X.toQuotient (f x))
            (Ideal.Quotient.mk (levelEnvelope s f e).object.ideal
              ((levelEnvelope s f e).algebraMap.toRingHom
                (Ideal.Quotient.mk (DividedPowers.pAdicIdeal (A := P) s.p ^ e) x)))} := by
  classical
  dsimp
  let n := Classical.choose s.prime_nilpotent
  have hn : (s.p : s.C) ^ n = 0 := Classical.choose_spec s.prime_nilpotent
  refine ⟨n, ?_⟩
  intro e he
  let pP : Ideal P := DividedPowers.pAdicIdeal (A := P) s.p ^ e
  let qP : P →+* levelRing s (P := P) e := Ideal.Quotient.mk pP
  let lvl := levelEnvelope s f e
  let E := lvl.object
  have hpn : (s.p : s.C) ^ e = 0 := pow_eq_zero_of_le he hn
  have hpCast : f (s.p : P) = (s.p : s.C) := by simp
  have hkill : pP ≤ RingHom.ker f.toRingHom := by
    change Ideal.span {(s.p : P)} ^ e ≤ RingHom.ker f.toRingHom
    rw [Ideal.span_singleton_pow, Ideal.span_le, Set.singleton_subset_iff]
    apply RingHom.mem_ker.mpr
    rw [map_pow]
    exact (congrArg (fun z : s.C => z ^ e) hpCast).trans hpn
  let lift : levelRing s (P := P) e →+* s.C :=
    Ideal.Quotient.lift pP f.toRingHom hkill
  have hlift_mk (x : P) : lift (qP x) = f x :=
    Ideal.Quotient.lift_mk pP f.toRingHom hkill (a := x)
  have hlift_surj : Function.Surjective lift := by
    intro y
    obtain ⟨x, rfl⟩ := hf y
    exact ⟨qP x, hlift_mk x⟩
  have hker : RingHom.ker lift = levelKernel s f e := by
    ext z
    constructor
    · intro hz
      obtain ⟨x, rfl⟩ := Ideal.Quotient.mk_surjective z
      rw [RingHom.mem_ker, hlift_mk x] at hz
      exact (Ideal.mem_map_iff_of_surjective qP Ideal.Quotient.mk_surjective).2
        ⟨x, RingHom.mem_ker.mpr hz, rfl⟩
    · intro hz
      obtain ⟨x, hx, rfl⟩ :=
        (Ideal.mem_map_iff_of_surjective qP Ideal.Quotient.mk_surjective).mp hz
      rw [RingHom.mem_ker, hlift_mk x]
      exact RingHom.mem_ker.mp hx
  let eC : (levelRing s (P := P) e ⧸ levelKernel s f e) ≃+* s.C :=
    (Ideal.quotEquivOfEq hker.symm).trans
      (RingHom.quotientKerEquivOfSurjective (f := lift) hlift_surj)
  have heC_mk (x : P) :
      eC (Ideal.Quotient.mk (levelKernel s f e) (qP x)) = f x := by
    simp only [eC, RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk]
    exact hlift_mk x
  have hbaseIdeal : s.A.ideal.map (algebraMap s.A P) ≤ presentationKernel s f := by
    rw [Ideal.map_le_iff_le_comap]
    intro x hx
    change f (algebraMap s.A P x) = 0
    rw [f.commutes, ← Ideal.mem_bot, ← s.ideal_map_eq_bot]
    exact Ideal.mem_map_of_mem (algebraMap s.A s.C) hx
  let b : s.A →+* levelRing s (P := P) e :=
    qP.comp (algebraMap s.A P)
  have hlevelJ : s.A.ideal.map b ≤ levelKernel s f e := by
    rw [← Ideal.map_map]
    exact Ideal.map_mono hbaseIdeal
  let eEnvData := envelopeQuotientEquiv b (levelKernel s f e) hlevelJ lvl
  let eTotal : (E ⧸ E.ideal) ≃+* s.C := eEnvData.1.trans eC
  have hgen (x : P) :
      eTotal (Ideal.Quotient.mk E.ideal
        (lvl.algebraMap.toRingHom (qP x))) = f x := by
    dsimp [eTotal]
    rw [eEnvData.2 (qP x)]
    exact heC_mk x
  let toC : s.C →+* E ⧸ E.ideal := eTotal.symm.toRingHom
  have hcommute :
      (Ideal.Quotient.mk E.ideal).comp lvl.structureMap.toRingHom =
        toC.comp (algebraMap s.A s.C) := by
    refine RingHom.ext fun a => eTotal.injective ?_
    calc
      eTotal (Ideal.Quotient.mk E.ideal (lvl.structureMap.toRingHom a)) =
          eTotal (Ideal.Quotient.mk E.ideal
            (lvl.algebraMap.toRingHom (qP (algebraMap s.A P a)))) := by
              congr 2
              exact ((RingHom.ext_iff.mp lvl.algebraMap_comp) a).symm
      _ = f (algebraMap s.A P a) := hgen (algebraMap s.A P a)
      _ = algebraMap s.A s.C a := by rw [f.commutes]
      _ = eTotal (toC (algebraMap s.A s.C a)) := by simp [toC]
  have hpnE : (s.p : E) ^ e = 0 := by
    have hqP : qP (s.p : P) ^ e = 0 := by
      rw [← map_pow, Ideal.Quotient.eq_zero_iff_mem]
      exact Ideal.pow_mem_pow
        (Ideal.subset_span (Set.mem_singleton (s.p : P))) e
    calc
      (s.p : E) ^ e = lvl.algebraMap.toRingHom (qP (s.p : P)) ^ e := by
        simp [qP, lvl, E]
      _ = lvl.algebraMap.toRingHom (qP (s.p : P) ^ e) := by rw [map_pow]
      _ = 0 := by rw [hqP]; simp
  let X : DividedPowerThickening s :=
    ⟨E, lvl.structureMap, ⟨e, hpnE⟩, toC, hcommute⟩
  refine ⟨X, eTotal.symm.bijective, rfl, ?_, fun x => heq_of_eq (eTotal.injective ?_)⟩
  · rfl
  · exact (eTotal.apply_symm_apply (f x)).trans (hgen x).symm

end FiniteLevelEnvelope

end Crystalline
