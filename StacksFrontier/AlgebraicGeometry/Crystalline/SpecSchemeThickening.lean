module

public import StacksFrontier.AlgebraicGeometry.Crystalline.BigSite.Basic
public import StacksFrontier.AlgebraicGeometry.Crystalline.SpecDividedPowerScheme
public import StacksFrontier.RingTheory.DividedPowers.Nilpotent

/-!
# The divided power thickening of schemes attached to a divided power ring

Let `(A, I, γ)` be a divided power ring whose ideal is locally nilpotent — every element of `I` is
nilpotent, which by [Stacks, Tag 07GR] is the case as soon as `p` is nilpotent in `A`.  Then
`Spec (A/I) ↪ Spec A` is a thickening of schemes, its defining ideal is the quasi-coherent ideal
of `Spec (A, I, γ)`, and the two together make a `Crystalline.SchemeThickening` whose ambient
divided power scheme is `Crystalline.DividedPowerScheme.specDividedPowerScheme (A, I, γ)`.

This is the essential-surjectivity input for the affine-to-global bridge of
`StacksFrontier/AlgebraicGeometry/Crystalline/SmallSite/AffineGlobalBridge.lean`: it turns an object
of the ring-theoretic crystalline category `CRIS(C/A)` of [Stacks, Tag 07HM] into an object of
the geometric one, `CRIS(X/S)` of [Stacks, Tag 07I6].

## Main definitions

* `Crystalline.DividedPowerScheme.specSchemeThickening` — **the divided power thickening of
  schemes `Spec (A/I) ↪ Spec (A, I, γ)`.**
* `Crystalline.DividedPowerScheme.specSectionsRingIso` — the identification of `(A, I, γ)` with
  the divided power ring of global sections of `Spec (A, I, γ)`.

## Main results

* `DividedPowers.isDPMorphism_of_inverse` — the inverse of a ring isomorphism which is a divided
  power morphism and matches the two ideals is a divided power morphism.
* `Stacks.Thickenings.specMap_isThickening_of_nilKernel` — `Spec` of a surjective ring map with
  nil kernel is a thickening.  This re-derives publicly the private declaration of the same name
  in `StacksFrontier/AlgebraicGeometry/FormalSpace/Affine/FiniteTypeClassification.lean`.
* `Crystalline.DividedPowerScheme.ker_specQuotientImmersion` — the kernel ideal sheaf of
  `Spec (A/I) ↪ Spec A` is the quasi-coherent ideal generated by `I`.

## What is and is not proved

No tag attribute is placed in this file.  The nilpotence of the elements of a divided power ideal
over a ring in which `p` is nilpotent is [Stacks, Tag 07GR], available as
`DividedPowers.locallyNilpotent_iff_isNilpotent_natCast`; it is taken here as the hypothesis
`hnil`, so that the construction applies verbatim to any locally nilpotent divided power ideal.

The divided power structure on `Spec (A, I, γ)` is a non-canonical choice away from `⊤`; see
`Crystalline.DividedPowerScheme.specDividedPowerStructure`.  On `⊤` it is `γ`, which is what
`specSectionsRingIso` records.

## References

* [Stacks Project, Tag 07GR](https://stacks.math.columbia.edu/tag/07GR)
* [Stacks Project, Tag 07HM](https://stacks.math.columbia.edu/tag/07HM)
* [Stacks Project, Tag 07I6](https://stacks.math.columbia.edu/tag/07I6)
* [Stacks Project, Tag 04EX](https://stacks.math.columbia.edu/tag/04EX)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory Opposite
open scoped AlgebraicGeometry

universe u

namespace DividedPowers

/-- **The inverse of a divided power isomorphism is a divided power morphism.**  If `f : A → B` is
a divided power morphism with a two-sided inverse `g` and the target ideal `J` is contained in the
image of `I`, then `g` is a divided power morphism from `(J, δ)` to `(I, γ)`.

Stated with a two-sided inverse rather than a `RingEquiv` so that it applies directly to the two
halves of an isomorphism in `CommRingCat`. -/
theorem isDPMorphism_of_inverse {A B : Type*} [CommSemiring A] [CommSemiring B]
    {I : Ideal A} {J : Ideal B} {hI : DividedPowers I} {hJ : DividedPowers J}
    (f : A →+* B) (g : B →+* A) (hgf : ∀ a, g (f a) = a) (hfg : ∀ b, f (g b) = b)
    (hJle : J ≤ Ideal.map f I) (hdp : DividedPowers.IsDPMorphism hI hJ f) :
    DividedPowers.IsDPMorphism hJ hI g := by
  have hfsurj : Function.Surjective f := fun b ↦ ⟨g b, hfg b⟩
  refine ⟨Ideal.map_le_iff_le_comap.mpr fun b hb ↦ ?_, ?_⟩
  · obtain ⟨a, ha, rfl⟩ := (Ideal.mem_map_iff_of_surjective f hfsurj).mp (hJle hb)
    simpa [hgf] using ha
  · intro n b hb
    obtain ⟨a, ha, rfl⟩ := (Ideal.mem_map_iff_of_surjective f hfsurj).mp (hJle hb)
    rw [hgf, hdp.dpow_comp (n := n) a ha, hgf]

end DividedPowers

namespace Stacks.Thickenings

/-- **`Spec` of a surjective ring map with nil kernel is a thickening of schemes.**  It is a
closed immersion because the map is surjective, and surjective on points because every prime
contains the nil kernel.  This re-derives publicly the private declaration of the same name in
`StacksFrontier/AlgebraicGeometry/FormalSpace/Affine/FiniteTypeClassification.lean`. -/
theorem specMap_isThickening_of_nilKernel {R T : Type u} [CommRing R] [CommRing T]
    (f : R →+* T) (hf : Function.Surjective f)
    (hnil : ∀ x, x ∈ RingHom.ker f → IsNilpotent x) :
    IsThickening (Spec.map (CommRingCat.ofHom f)) := by
  refine ⟨AlgebraicGeometry.IsClosedImmersion.spec_of_surjective
    (CommRingCat.ofHom f) hf, ?_⟩
  change Function.Surjective (PrimeSpectrum.comap f)
  rw [← Set.range_eq_univ, range_comap_of_surjective _ f hf]
  refine Set.eq_univ_of_forall fun p ↦ (PrimeSpectrum.mem_zeroLocus _ _).2 fun x hx ↦ ?_
  obtain ⟨n, hn⟩ := hnil x hx
  exact p.isPrime.mem_of_pow_mem n (by simp [hn])

end Stacks.Thickenings

namespace Crystalline.DividedPowerScheme

variable (A : DividedPowerRing.{u})

/-- The ring isomorphism `A ≅ Γ(Spec A, ⊤)`. -/
noncomputable abbrev specSectionsRingEquiv : A ≃+* Γ(Spec (CommRingCat.of A), ⊤) :=
  (Scheme.ΓSpecIso (CommRingCat.of A)).symm.commRingCatIsoToRingEquiv

/-- On `⊤` the structure map of `Spec A` is the canonical isomorphism `A ≅ Γ(Spec A, ⊤)`. -/
theorem specSectionHom_top :
    specSectionHom A ⊤ = (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom := by
  dsimp only [specSectionHom]
  rw [show homOfLE (show (⊤ : (Spec (CommRingCat.of A)).Opens) ≤ ⊤ from le_top) =
    𝟙 _ from Subsingleton.elim _ _, op_id, CategoryTheory.Functor.map_id]
  rfl

/-- The divided power ideal of `Spec (A, I, γ)` on global sections is the image of `I`. -/
theorem specDividedPowerIdeal_top :
    A.ideal.map (specSectionsRingEquiv A : A →+* Γ(Spec (CommRingCat.of A), ⊤)) =
      Crystalline.sectionIdeal (Spec (CommRingCat.of A)).sheaf
        (specDividedPowerIdeal A) (op ⊤) := by
  have h := specDividedPowerIdeal_affine A ⟨⊤, isAffineOpen_top _⟩
  rwa [specSectionHom_top] at h

/-- **The divided power ring of global sections of `Spec (A, I, γ)` is `(A, I, γ)`.**  The
underlying ring isomorphism is `Scheme.ΓSpecIso`; it is a divided power morphism because the
divided powers chosen on `Spec (A, I, γ)` restrict to `γ` on `⊤`
(`specDividedPowerSchemeUnit`), and its inverse is one by
`DividedPowers.isDPMorphism_of_inverse`. -/
noncomputable def specSectionsRingIso :
    A ≅ (specDividedPowerScheme A).dividedPowers.toDividedPowerRing (op ⊤) where
  hom := specDividedPowerSchemeUnit A
  inv := DividedPowers.DPMorphism.mk'
    (f := (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom)
    (DividedPowers.isDPMorphism_of_inverse _ _
      (Scheme.ΓSpecIso (CommRingCat.of A)).inv_hom_id_apply
      (Scheme.ΓSpecIso (CommRingCat.of A)).hom_inv_id_apply
      (specDividedPowerIdeal_top A).ge (specDividedPowerSchemeUnit A).isDPMorphism)
  hom_inv_id := by
    apply DividedPowers.DPMorphism.ext
    funext a
    exact (Scheme.ΓSpecIso (CommRingCat.of A)).inv_hom_id_apply a
  inv_hom_id := by
    apply DividedPowers.DPMorphism.ext
    funext b
    exact (Scheme.ΓSpecIso (CommRingCat.of A)).hom_inv_id_apply b

/-- The closed immersion `Spec (A/I) ⟶ Spec (A, I, γ)` cut out by the divided power ideal. -/
noncomputable abbrev specQuotientImmersion :
    Spec (CommRingCat.of (↥A ⧸ A.ideal)) ⟶ Spec (CommRingCat.of A) :=
  Spec.map (CommRingCat.ofHom (Ideal.Quotient.mk A.ideal))

/-- On global sections, the kernel of the immersion `Spec (A/I) ⟶ Spec A` is the image of `I`. -/
theorem ker_specQuotientImmersion_appTop :
    RingHom.ker (specQuotientImmersion A).appTop.hom =
      A.ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom := by
  have hgf : Function.LeftInverse (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom
      (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom :=
    (Scheme.ΓSpecIso (CommRingCat.of A)).inv_hom_id_apply
  have hfg : Function.LeftInverse (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
      (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom :=
    (Scheme.ΓSpecIso (CommRingCat.of A)).hom_inv_id_apply
  have hinv : A.ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom =
      A.ideal.comap (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom :=
    le_antisymm
      (Ideal.map_le_comap_of_inverse (f := (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom) _
        A.ideal hgf)
      (Ideal.comap_le_map_of_inverse (f := (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom) _
        A.ideal hfg)
  have key : (Scheme.ΓSpecIso (CommRingCat.of (↥A ⧸ A.ideal))).hom.hom.comp
      (specQuotientImmersion A).appTop.hom =
      (Ideal.Quotient.mk A.ideal).comp (Scheme.ΓSpecIso (CommRingCat.of A)).hom.hom :=
    congrArg CommRingCat.Hom.hom (Scheme.ΓSpecIso_naturality _)
  have hinj : Function.Injective
      (Scheme.ΓSpecIso (CommRingCat.of (↥A ⧸ A.ideal))).hom.hom :=
    (ConcreteCategory.bijective_of_isIso _).injective
  rw [hinv, ← RingHom.ker_comp_of_injective (specQuotientImmersion A).appTop.hom hinj, key,
    ← RingHom.comap_ker, Ideal.mk_ker]

/-- **The kernel ideal sheaf of `Spec (A/I) ⟶ Spec A` is the quasi-coherent ideal generated by
`I`** — that is, the divided power ideal of `Spec (A, I, γ)`. -/
theorem ker_specQuotientImmersion :
    (specQuotientImmersion A).ker =
      Scheme.IdealSheafData.ofIdealTop
        (A.ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom) := by
  rw [Scheme.ker_of_isAffine, ker_specQuotientImmersion_appTop]

/-- **The divided power thickening of schemes `Spec (A/I) ↪ Spec (A, I, γ)`** attached to a
divided power ring whose ideal is locally nilpotent.  The immersion is a thickening because its
kernel is `I`, every element of which is nilpotent, and its defining ideal on an affine open is
the divided power ideal of `Spec (A, I, γ)` there, by `ker_specQuotientImmersion`.

By [Stacks, Tag 07GR] the hypothesis `hnil` holds for any divided power ideal in a ring in which
`p` is nilpotent; see `DividedPowers.locallyNilpotent_iff_isNilpotent_natCast`. -/
noncomputable def specSchemeThickening (hnil : A.ideal.LocallyNilpotent) :
    Crystalline.SchemeThickening.{u} where
  source := Spec (CommRingCat.of (↥A ⧸ A.ideal))
  target := specDividedPowerScheme A
  immersion := specQuotientImmersion A
  isThickening := Stacks.Thickenings.specMap_isThickening_of_nilKernel _
    Ideal.Quotient.mk_surjective fun x hx ↦ hnil x (by rwa [Ideal.mk_ker] at hx)
  ideal_eq_ker V :=
    (idealSheafAsSubmodule_obj_affine _ V).trans
      (congrArg (fun d : (Spec (CommRingCat.of A)).IdealSheafData ↦ d.ideal V)
        (ker_specQuotientImmersion A).symm)

/-- The target of `specSchemeThickening A hnil` is `specDividedPowerScheme A`. -/
@[simp]
theorem specSchemeThickening_target (hnil : A.ideal.LocallyNilpotent) :
    (specSchemeThickening A hnil).target = specDividedPowerScheme A := rfl

/-- The immersion of `specSchemeThickening A hnil` is the closed immersion
`specQuotientImmersion A : Spec (A/I) ⟶ Spec A`. -/
@[simp]
theorem specSchemeThickening_immersion (hnil : A.ideal.LocallyNilpotent) :
    (specSchemeThickening A hnil).immersion = specQuotientImmersion A := rfl

end Crystalline.DividedPowerScheme

end
