module

public import Mathlib.RingTheory.DividedPowers.SubDPIdeal
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Crystalline.DividedPowerEnvelope.PolynomialPresentation

/-!
# The kernel of the divided power polynomial presentation

Let `(B, I, γ)` be a divided power ring and let `J` be the ideal generated by `I` and a family
`f : T → B`. The surjection of
`Crystalline.surjectiveDividedPowerPolynomialMap` from the divided power polynomial algebra on
`T` onto the divided power envelope of `J` has an explicit kernel: it is generated by the
differences `x_t - f t` between the variables and their images, together with all divided powers
`γ_n` of the finitely supported linear relations among the `f t` whose constant term lies in `I`.

## Main definitions

* `Crystalline.kernelPresentationIdeal` is the ideal generated by those two families of
  relations.

## Main results

* `Crystalline.ker_surjectiveDividedPowerPolynomialMap` identifies that ideal with the kernel of
  the surjection onto the divided power envelope.

## Implementation notes

The finitely supported coefficients of a relation are represented by `T →₀ B`; its constant term
is an element of `B.ideal`, and the equality of the relation's value at `f` with that constant
term is part of the indexing condition for the second family of generators. The relation itself
is formed in the divided power polynomial algebra through its coefficient map.

The inclusion of the stated ideal in the kernel is direct. For the reverse inclusion the proof
works with the intersection of the ideal with the divided power ideal of the polynomial algebra,
which is a sub-divided-power ideal, so the quotient by it carries divided powers; the universal
property of the envelope then produces a map back, and comparing the two composites through the
universal property of the divided power polynomial algebra shows that anything killed by the
surjection already lies in the stated ideal. Replacing the index type `T` by the image
`Set.range f` is what makes the quotient construction available, since the generators are
indexed by values of `f` rather than by elements of `T`.

## References

* [Stacks Project, Tag 07HC](https://stacks.math.columbia.edu/tag/07HC)
-/

@[expose] public section

noncomputable section

namespace Crystalline

open DividedPowers

universe u w

/-- The ideal of relations in the divided power polynomial presentation of an envelope. -/
public def kernelPresentationIdeal (B : DividedPowerRing.{u}) (T : Type w) (f : T → B) :
    Ideal (DividedPowerAlgebra B (T →₀ B)) :=
  Ideal.span
    ((Set.range fun t : T =>
        dividedPowerPolynomialVariable B t -
          algebraMap B (DividedPowerAlgebra B (T →₀ B)) (f t)) ∪
      {y | ∃ (n : ℕ) (r : T →₀ B) (r₀ : B.ideal),
        1 ≤ n ∧
          r.sum (fun t a => a * f t) = (r₀ : B) ∧
          y = (setIndexedDividedPowerPolynomialDividedPowers B T).dpow n
            (r.sum (fun t a =>
              algebraMap B (DividedPowerAlgebra B (T →₀ B)) a *
                dividedPowerPolynomialVariable B t) -
              algebraMap B (DividedPowerAlgebra B (T →₀ B)) (r₀ : B))})

/-- Reindexing the support of a finitely supported family along `g` before summing. -/
private theorem sum_mapDomain_mul {B A S S' : Type*} [Semiring B] [Semiring A] (φ : B →+* A)
    (g : S → S') (r : S →₀ B) (c : S' → A) :
    (Finsupp.mapDomain g r).sum (fun t a => φ a * c t) = r.sum (fun s a => φ a * c (g s)) :=
  Finsupp.sum_mapDomain_index (by simp) (by intro t a b; simp [add_mul])

/-- A linear relation with constant term in `I` lies in the divided power ideal. -/
private theorem relation_mem_polynomialIdeal (B : DividedPowerRing.{u}) {S : Type w}
    (r : S →₀ B) (r₀ : B.ideal) :
    r.sum (fun t a => algebraMap B (DividedPowerAlgebra B (S →₀ B)) a *
        dividedPowerPolynomialVariable B t) -
      algebraMap B (DividedPowerAlgebra B (S →₀ B)) (r₀ : B) ∈
        dividedPowerPolynomialIdeal B.ideal S := by
  refine Ideal.sub_mem _ (Ideal.mem_sup_right (Submodule.sum_mem _ fun t _ => ?_))
    (Ideal.mem_sup_left (Ideal.mem_map_of_mem _ r₀.property))
  exact Ideal.mul_mem_left _ _ (variable_mem_positiveIdeal B t)

/-- The kernel of the surjection from the divided power polynomial algebra to the divided
power envelope is generated by variable relations and divided powers of linear relations. -/
@[stacks 07HC "kernel"]
public theorem ker_surjectiveDividedPowerPolynomialMap
    (B : DividedPowerRing.{u}) (T : Type w)
    (J : Ideal B) (hJ : B.ideal.map (RingHom.id B) ≤ J)
    (f : T → B) (hf : J = B.ideal ⊔ Ideal.span (Set.range f))
    (D : DividedPowerEnvelope B (RingHom.id B) J hJ) :
    RingHom.ker (surjectiveDividedPowerPolynomialMap B T J hJ f hf D).1.toRingHom =
      kernelPresentationIdeal B T f := by
  classical
  let P := setIndexedDividedPowerPolynomialAlgebra B T
  let δ := setIndexedDividedPowerPolynomialDividedPowers B T
  let Ipoly := dividedPowerPolynomialIdeal B.ideal T
  let coeff := setIndexedDividedPowerPolynomialCoefficientDPMorphism B T
  let ψ := (surjectiveDividedPowerPolynomialMap B T J hJ f hf D).1
  let K := kernelPresentationIdeal B T f
  let Q (t : T) : P :=
    dividedPowerPolynomialVariable B t -
      algebraMap B P (f t)
  let relation (r : T →₀ B) (r₀ : B) : P :=
    r.sum (fun t a => algebraMap B P a * dividedPowerPolynomialVariable B t) -
      algebraMap B P r₀
  let Kgens : Set P :=
    {x | ∃ (n : ℕ) (r : T →₀ B) (r₀ : B.ideal),
        0 < n ∧ r.sum (fun t a => a * f t) = (r₀ : B) ∧
          x = δ.dpow n (relation r r₀)} ∪
      {x | ∃ (m : ℕ) (t' t : T), 0 < m ∧
        x = dividedPowerPolynomialVariableMonomial B t' m * Q t}
  let K' : Ideal P := Ideal.span Kgens
  have hcoeff (a : B) : ψ.toRingHom (coeff.toRingHom a) = D.structureMap.toRingHom a := by
    have hh := congrArg
      (fun g : DividedPowers.DPMorphism B.dividedPowers D.object.dividedPowers =>
        g.toRingHom a)
      (surjectiveDividedPowerPolynomialMap B T J hJ f hf D).2.1
    change ψ.toRingHom (coeff.toRingHom a) = D.structureMap.toRingHom a at hh
    exact hh
  have hvar (t : T) : ψ (dividedPowerPolynomialVariable B t) =
      D.algebraMap.toRingHom (f t) :=
    (surjectiveDividedPowerPolynomialMap B T J hJ f hf D).2.2.1 t
  have hrelmem (r : T →₀ B) (r₀ : B.ideal)
      (_ : r.sum (fun t a => a * f t) = (r₀ : B)) : relation r r₀ ∈ Ipoly :=
    relation_mem_polynomialIdeal B r r₀
  have halg : D.algebraMap.toRingHom = D.structureMap.toRingHom := by
    ext x
    have hh := congrArg (fun g : B →+* D.object.carrier => g x) D.algebraMap_comp
    simpa using hh
  have hcoeff' (a : B) :
      ψ.toRingHom (algebraMap B P a) = D.structureMap.toRingHom a := by
    show ψ.toRingHom (coeff.toRingHom a) = D.structureMap.toRingHom a
    exact hcoeff a
  have hvar' (t : T) :
      ψ.toRingHom (dividedPowerPolynomialVariable B t) =
        D.structureMap.toRingHom (f t) := by
    have hv := hvar t
    change ψ.toRingHom (dividedPowerPolynomialVariable B t) =
      D.algebraMap.toRingHom (f t) at hv
    calc
      ψ.toRingHom (dividedPowerPolynomialVariable B t) =
          D.algebraMap.toRingHom (f t) := hv
      _ = D.structureMap.toRingHom (f t) :=
        congrArg (fun g : B →+* D.object.carrier => g (f t)) halg
  have hsum (r : T →₀ B) :
      ψ.toRingHom (r.sum (fun t a => algebraMap B P a *
        dividedPowerPolynomialVariable B t)) =
        D.structureMap.toRingHom (r.sum (fun t a => a * f t)) := by
    classical
    simp only [Finsupp.sum, map_sum, map_mul]
    apply Finset.sum_congr rfl
    intro t ht
    rw [hcoeff', hvar']
  have hqker (t : T) : Q t ∈ RingHom.ker ψ.toRingHom := by
    show ψ.toRingHom (Q t) = 0
    rw [map_sub, hvar', hcoeff']
    exact sub_self _
  have hK_le : K ≤ RingHom.ker ψ.toRingHom := by
    apply Ideal.span_le.2
    intro x hx
    change x ∈ Set.range (fun t : T => Q t) ∪
      {y | ∃ (n : ℕ) (r : T →₀ B) (r₀ : B.ideal),
        1 ≤ n ∧ r.sum (fun t a => a * f t) = (r₀ : B) ∧
          y = δ.dpow n (relation r r₀)} at hx
    rcases hx with hx | hx
    · rcases hx with ⟨t, rfl⟩
      exact hqker t
    · rcases hx with ⟨n, r, r₀, hn, hr, rfl⟩
      have hbase : ψ.toRingHom (relation r r₀) = 0 := by
        show ψ.toRingHom
          (r.sum (fun t a => algebraMap B P a * dividedPowerPolynomialVariable B t) -
            algebraMap B P r₀) = 0
        rw [map_sub, hsum, hcoeff', hr]
        simp
      have hdp := ψ.dpow_comp (n := n) (relation r r₀) (hrelmem r r₀ hr)
      show ψ.toRingHom (δ.dpow n (relation r r₀)) = 0
      rw [← hdp, hbase]
      exact D.object.dividedPowers.dpow_eval_zero (Nat.ne_of_gt (by omega))
  have hmonI (t' : T) {m : ℕ} (hm : 0 < m) :
      dividedPowerPolynomialVariableMonomial B t' m ∈ Ipoly :=
    Ideal.mem_sup_right (variableMonomial_mem_positiveIdeal B t' (Nat.ne_of_gt hm))
  have hqmem (t : T) : Q t ∈ K := by
    show Q t ∈ kernelPresentationIdeal B T f
    unfold kernelPresentationIdeal
    apply Ideal.subset_span
    exact Or.inl ⟨t, rfl⟩
  have hKprime_le : K' ≤ K ⊓ Ipoly := by
    apply Ideal.span_le.2
    rintro x hx
    change x ∈ Kgens at hx
    rcases hx with hx | hx
    · rcases hx with ⟨n, r, r₀, hn, hr, rfl⟩
      have hn' : 1 ≤ n := Nat.one_le_iff_ne_zero.mpr (Nat.ne_of_gt hn)
      refine ⟨?_, δ.dpow_mem (Nat.ne_of_gt hn) (hrelmem r r₀ hr)⟩
      show δ.dpow n (relation r r₀) ∈ kernelPresentationIdeal B T f
      unfold kernelPresentationIdeal
      apply Ideal.subset_span
      right
      exact ⟨n, r, r₀, hn', hr, rfl⟩
    · rcases hx with ⟨m, t', t, hm, rfl⟩
      refine ⟨?_, ?_⟩
      · exact K.mul_mem_left _ (hqmem t)
      · exact Ipoly.mul_mem_right (Q t) (hmonI t' hm)
  have hKgens_mem : Kgens ⊆ (Ipoly : Set P) := by
    rintro x (hx | hx)
    · rcases hx with ⟨n, r, r₀, hn, hr, rfl⟩
      exact δ.dpow_mem (Nat.ne_of_gt hn) (hrelmem r r₀ hr)
    · rcases hx with ⟨m, t', t, hm, rfl⟩
      exact Ipoly.mul_mem_right (Q t) (hmonI t' hm)
  have hKprime_stable : DividedPowers.IsSubDPIdeal δ K' :=
    (DividedPowers.span_isSubDPIdeal_iff (hI := δ) hKgens_mem).2 (by
      intro n hn x hx
      rcases hx with hx | hx
      · rcases hx with ⟨m, r, r₀, hm, hr, rfl⟩
        rw [δ.dpow_comp (Nat.ne_of_gt hm) (hrelmem r r₀ hr)]
        exact Ideal.mul_mem_left _ _
          (Ideal.subset_span (Or.inl ⟨n * m, r, r₀, by positivity, hr, rfl⟩))
      · rcases hx with ⟨m, t', t, hm, rfl⟩
        let v := dividedPowerPolynomialVariable B t'
        let vmon := dividedPowerPolynomialVariableMonomial B t' m
        have hv : v ∈ Ipoly := variable_mem_polynomialIdeal B t'
        have hmemb : vmon ∈ Ipoly := hmonI t' hm
        have hdpmon : δ.dpow n (δ.dpow m v) =
            (n.uniformBell m : P) * δ.dpow (n * m) v :=
          δ.dpow_comp (m := n) (n := m) (Nat.ne_of_gt hm) hv
        have hvmon : vmon = δ.dpow m v :=
          (setIndexedDividedPowerPolynomialDividedPowers_dpow_variable B t' m).symm
        have hpow : (Q t) ^ n = (Q t) ^ (n - 1) * Q t := by
          rw [show n = (n - 1) + 1 by omega, pow_succ]
          simp [Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr hn)]
        rw [mul_comm vmon (Q t), δ.dpow_mul hmemb, hvmon, hdpmon, hpow]
        have hgen : dividedPowerPolynomialVariableMonomial B t' (n * m) * Q t ∈ K' :=
          Ideal.subset_span (Or.inr ⟨n * m, t', t, by positivity, rfl⟩)
        rw [setIndexedDividedPowerPolynomialDividedPowers_dpow_variable B t' (n * m)]
        convert K'.mul_mem_left
          ((Q t) ^ (n - 1) * (n.uniformBell m : P)) hgen using 1
        ac_rfl
    )
  let Vgens : Set P := {x | ∃ (t : T) (m : ℕ), 0 < m ∧
    x = dividedPowerPolynomialVariableMonomial B t m}
  let V : Ideal P := Ideal.span Vgens
  let aug : P →+* B := (dividedPowerPolynomialAugmentation B T).toRingHom
  have haugCoeff (a : B) : aug (algebraMap B P a) = a :=
    (dividedPowerPolynomialAugmentation B T).commutes a
  have haugDP (n : ℕ) (m : T →₀ B) (hn : n ≠ 0) :
      aug (DividedPowerAlgebra.dp B n m) = 0 := by
    show (DividedPowerAlgebra.lift (dividedPowersBot B) 0
      (fun _ => by simp)) (DividedPowerAlgebra.dp B n m) = 0
    rw [DividedPowerAlgebra.lift_apply_dp]
    simp only [LinearMap.zero_apply]
    exact (dividedPowersBot B).dpow_eval_zero hn
  have hdpV (n : ℕ) (m : T →₀ B) (hn : n ≠ 0) :
      DividedPowerAlgebra.dp B n m ∈ V := by
    classical
    induction m using Finsupp.induction with
    | zero =>
        rw [DividedPowerAlgebra.dp_null_of_ne_zero hn]
        exact V.zero_mem
    | @single_add t a m ht ha ih =>
        rw [DividedPowerAlgebra.dp_add]
        apply Submodule.sum_mem
        intro k hk
        rcases k with ⟨u, v⟩
        have huv : u + v = n := Finset.HasAntidiagonal.mem_antidiagonal.mp hk
        by_cases hu : u = 0
        · subst u
          have hv : v = n := by omega
          subst v
          rw [DividedPowerAlgebra.dp_zero, one_mul]
          exact ih
        · have hsingle :
            DividedPowerAlgebra.dp B u (Finsupp.single t a) ∈ V := by
            rw [← Finsupp.smul_single_one t a, DividedPowerAlgebra.dp_smul]
            have hgen : dividedPowerPolynomialVariableMonomial B t u ∈ V := by
              apply Ideal.subset_span
              exact ⟨t, u, Nat.pos_of_ne_zero hu, rfl⟩
            simpa [Algebra.smul_def, dividedPowerPolynomialVariableMonomial] using
              V.mul_mem_left (algebraMap B P (a ^ u)) hgen
          exact V.mul_mem_right _ hsingle
  have hdecomp (x : P) :
      x - algebraMap B P (aug x) ∈ V := by
    induction x using DividedPowerAlgebra.induction_on with
    | C a =>
        rw [haugCoeff, sub_self]
        exact V.zero_mem
    | add x y hx hy =>
        have heq : x + y - algebraMap B P (aug (x + y)) =
            (x - algebraMap B P (aug x)) + (y - algebraMap B P (aug y)) := by
          simp only [map_add, map_add]
          ring
        rw [heq]
        exact V.add_mem hx hy
    | dp x n m hx =>
        let y := DividedPowerAlgebra.dp B n m
        have hy : y - algebraMap B P (aug y) ∈ V := by
          by_cases hn : n = 0
          · subst n
            simp [y, aug, dividedPowerPolynomialAugmentation,
              DividedPowerAlgebra.dp_zero]
          · rw [haugDP n m hn]
            simp only [map_zero, sub_zero]
            exact hdpV n m hn
        have heq : x * y - algebraMap B P (aug (x * y)) =
            (x - algebraMap B P (aug x)) * y +
              algebraMap B P (aug x) * (y - algebraMap B P (aug y)) := by
          simp only [map_mul]
          ring
        rw [heq]
        exact V.add_mem (V.mul_mem_right y hx)
          (V.mul_mem_left (algebraMap B P (aug x)) hy)
  have hV_le_positive : V ≤ dividedPowerPolynomialPositiveIdeal B T := by
    apply Ideal.span_le.2
    rintro x ⟨t, m, hm, rfl⟩
    exact variableMonomial_mem_positiveIdeal B t (Nat.ne_of_gt hm)
  have hpositive_le_V : dividedPowerPolynomialPositiveIdeal B T ≤ V := by
    intro x hx
    have hx0 : aug x = 0 := by
      change x ∈ RingHom.ker aug at hx
      exact RingHom.mem_ker.mp hx
    have hh := hdecomp x
    rw [hx0] at hh
    simpa using hh
  have hV_eq_positive : V = dividedPowerPolynomialPositiveIdeal B T :=
    le_antisymm hV_le_positive hpositive_le_V
  let Rcomb : (T →₀ B) →ₗ[B] P := Finsupp.linearCombination B Q
  have hRcomb_add (r s : T →₀ B) : Rcomb (r + s) = Rcomb r + Rcomb s :=
    map_add Rcomb r s
  have hRcomb_smul (a : B) (r : T →₀ B) :
      Rcomb (a • r) = a • Rcomb r := map_smul Rcomb a r
  have haugQ (t : T) : aug (Q t) = -f t := by
    dsimp [Q]
    rw [map_sub, haugCoeff]
    show aug (DividedPowerAlgebra.dp B 1 (Finsupp.single t 1)) - f t = -f t
    rw [haugDP 1 (Finsupp.single t 1) (by decide)]
    simp
  have haugRcomb (r : T →₀ B) :
      aug (Rcomb r) = -r.sum (fun t a => a * f t) := by
    classical
    simp [Rcomb, Finsupp.linearCombination_apply, Finsupp.sum,
      Algebra.smul_def, haugQ, haugCoeff, Finset.sum_neg_distrib]
  have haugI : Ipoly.map aug ≤ B.ideal := by
    show Ideal.map aug
      (Ideal.map (algebraMap B P) B.ideal ⊔
        dividedPowerPolynomialPositiveIdeal B T) ≤ B.ideal
    rw [Ideal.map_sup]
    apply sup_le
    · rw [Ideal.map_map]
      have hcomp : aug.comp (algebraMap B P) = RingHom.id B := by
        ext a
        exact haugCoeff a
      rw [hcomp]
      simp
    · apply Ideal.map_le_iff_le_comap.2
      intro x hx
      have hx0 : aug x = 0 := by
        change x ∈ RingHom.ker aug at hx
        exact RingHom.mem_ker.mp hx
      simp [hx0]
  have hVmul (t : T) {p : P} (hp : p ∈ V) : p * Q t ∈ K' := by
    induction hp using Submodule.span_induction with
    | mem x hx =>
        rcases hx with ⟨t', m, hm, rfl⟩
        exact Ideal.subset_span (Or.inr ⟨m, t', t, hm, rfl⟩)
    | zero => simp
    | add x y hx hy ihx ihy =>
        rw [add_mul]
        exact K'.add_mem ihx ihy
    | smul a x hx ih =>
        rw [smul_eq_mul, mul_assoc]
        exact K'.mul_mem_left a ih
  have hposMulComb {p : P} (hp : p ∈ dividedPowerPolynomialPositiveIdeal B T)
      (r : T →₀ B) : p * Rcomb r ∈ K' := by
    classical
    rw [← hV_eq_positive] at hp
    dsimp [Rcomb]
    rw [Finsupp.linearCombination_apply, Finsupp.sum, Finset.mul_sum]
    simp only [Algebra.smul_def]
    show (∑ t ∈ r.support,
      p * (algebraMap B P (r t) * Q t)) ∈ K'
    apply Submodule.sum_mem
    intro t ht
    have hterm : p * Q t ∈ K' := hVmul t hp
    have heq : p * (algebraMap B P (r t) * Q t) =
        algebraMap B P (r t) * (p * Q t) := by ring
    rw [heq]
    exact K'.mul_mem_left _ hterm
  let H : Ideal P := {
    carrier := {x | ∃ r : T →₀ B, x - Rcomb r ∈ K'}
    zero_mem' := by
      refine ⟨0, ?_⟩
      simp [Rcomb]
    add_mem' := by
      intro x y hx hy
      rcases hx with ⟨r, hr⟩
      rcases hy with ⟨s, hs⟩
      refine ⟨r + s, ?_⟩
      rw [hRcomb_add]
      have heq : x + y - (Rcomb r + Rcomb s) =
          (x - Rcomb r) + (y - Rcomb s) := by ring
      rw [heq]
      exact K'.add_mem hr hs
    smul_mem' := by
      intro a x hx
      rcases hx with ⟨r, hr⟩
      refine ⟨aug a • r, ?_⟩
      rw [hRcomb_smul]
      show a * x - (aug a) • Rcomb r ∈ K'
      rw [Algebra.smul_def]
      have hp : a - algebraMap B P (aug a) ∈
          dividedPowerPolynomialPositiveIdeal B T := by
        rw [dividedPowerPolynomialPositiveIdeal, RingHom.mem_ker]
        show aug (a - algebraMap B P (aug a)) = 0
        rw [map_sub]
        rw [haugCoeff]
        exact sub_self _
      have heq : a * x - algebraMap B P (aug a) * Rcomb r =
          a * (x - Rcomb r) + (a - algebraMap B P (aug a)) * Rcomb r := by ring
      rw [heq]
      exact K'.add_mem (K'.mul_mem_left a hr) (hposMulComb hp r)
  }
  have hRcombK (r : T →₀ B) : Rcomb r ∈ K := by
    classical
    show (∑ t ∈ r.support, (r t) • Q t) ∈ K
    apply Submodule.sum_mem
    intro t ht
    simpa [Algebra.smul_def] using K.mul_mem_left
      (algebraMap B P (r t)) (hqmem t)
  have hK_le_H : K ≤ H := by
    show kernelPresentationIdeal B T f ≤ H
    unfold kernelPresentationIdeal
    apply Ideal.span_le.2
    intro x hx
    change x ∈ Set.range (fun t : T => Q t) ∪
      {y | ∃ (n : ℕ) (r : T →₀ B) (r₀ : B.ideal),
        1 ≤ n ∧ r.sum (fun t a => a * f t) = (r₀ : B) ∧
          y = δ.dpow n (relation r r₀)} at hx
    show x ∈ H
    rcases hx with hx | hx
    · rcases hx with ⟨t, rfl⟩
      refine ⟨Finsupp.single t 1, ?_⟩
      simp [Rcomb, Finsupp.linearCombination_apply]
    · rcases hx with ⟨n, r, r₀, hn, hr, rfl⟩
      refine ⟨0, ?_⟩
      have hmem : δ.dpow n (relation r r₀) ∈ K' := by
        apply Ideal.subset_span
        exact Or.inl ⟨n, r, r₀, by omega, hr, rfl⟩
      simpa [Rcomb] using hmem
  have hH_le_K : H ≤ K := by
    intro x hx
    rcases hx with ⟨r, hr⟩
    rw [← sub_add_cancel x (Rcomb r)]
    exact K.add_mem (hKprime_le hr).1 (hRcombK r)
  have hKcap : K ⊓ Ipoly = K' := by
    apply le_antisymm
    · intro x hx
      rcases hx with ⟨hxK, hxI⟩
      rcases hK_le_H hxK with ⟨r, hr⟩
      have hresI : x - Rcomb r ∈ Ipoly := (hKprime_le hr).2
      have hcombI : Rcomb r ∈ Ipoly := by
        have hh := Ipoly.sub_mem hxI hresI
        simpa [sub_sub_cancel] using hh
      have haugComb : aug (Rcomb r) ∈ B.ideal :=
        haugI (Ideal.mem_map_of_mem _ hcombI)
      have hsumI : r.sum (fun t a => a * f t) ∈ B.ideal := by
        rw [haugRcomb] at haugComb
        have hh := B.ideal.neg_mem haugComb
        simpa using hh
      let r₀ : B.ideal := ⟨r.sum (fun t a => a * f t), hsumI⟩
      have hRcomb_relation : Rcomb r = relation r r₀ := by
        classical
        rw [show Rcomb r = ∑ t ∈ r.support,
            algebraMap B P (r t) * Q t by
          simp [Rcomb, Finsupp.linearCombination_apply, Finsupp.sum,
            Algebra.smul_def]]
        show (∑ t ∈ r.support,
            algebraMap B P (r t) *
              (dividedPowerPolynomialVariable B t - algebraMap B P (f t))) =
          (∑ t ∈ r.support,
            algebraMap B P (r t) * dividedPowerPolynomialVariable B t) -
            algebraMap B P (r₀ : B)
        calc
          (∑ t ∈ r.support,
              algebraMap B P (r t) *
                (dividedPowerPolynomialVariable B t - algebraMap B P (f t))) =
              ∑ t ∈ r.support,
                (algebraMap B P (r t) * dividedPowerPolynomialVariable B t -
                  algebraMap B P (r t) * algebraMap B P (f t)) := by
                  apply Finset.sum_congr rfl
                  intro t ht
                  ring
          _ = (∑ t ∈ r.support,
                algebraMap B P (r t) * dividedPowerPolynomialVariable B t) -
                ∑ t ∈ r.support,
                  algebraMap B P (r t) * algebraMap B P (f t) :=
                Finset.sum_sub_distrib
                  (f := fun t => algebraMap B P (r t) *
                    dividedPowerPolynomialVariable B t)
                  (g := fun t => algebraMap B P (r t) * algebraMap B P (f t))
          _ = (∑ t ∈ r.support,
                algebraMap B P (r t) * dividedPowerPolynomialVariable B t) -
                algebraMap B P (r₀ : B) := by
                  rw [show (∑ t ∈ r.support,
                      algebraMap B P (r t) * algebraMap B P (f t)) =
                      algebraMap B P (r.sum (fun t a => a * f t)) by
                        simp [Finsupp.sum, map_sum, map_mul]]
      have hgen : δ.dpow 1 (relation r r₀) ∈ K' := by
        apply Ideal.subset_span
        exact Or.inl ⟨1, r, r₀, by decide, rfl, rfl⟩
      have hRcombK' : Rcomb r ∈ K' := by
        rw [hRcomb_relation, ← δ.dpow_one (hrelmem r r₀ rfl)]
        exact hgen
      have heq : x = (x - Rcomb r) + Rcomb r := by ring
      rw [heq]
      exact K'.add_mem hr hRcombK'
    · exact hKprime_le
  have hKstable : δ.IsSubDPIdeal (K ⊓ Ipoly) := by
    rw [hKcap]
    exact hKprime_stable
  let R := Set.range f
  let fR : R → B := fun z => z.1
  let i : T → R := fun t => ⟨f t, ⟨t, rfl⟩⟩
  let chooseT : R → T := fun z => Classical.choose z.2
  have hchoose (z : R) : f (chooseT z) = z.1 := Classical.choose_spec z.2
  let PR := setIndexedDividedPowerPolynomialAlgebra B R
  let δR := setIndexedDividedPowerPolynomialDividedPowers B R
  let IR := dividedPowerPolynomialIdeal B.ideal R
  let KR := kernelPresentationIdeal B R fR
  let coeffR := setIndexedDividedPowerPolynomialCoefficientDPMorphism B R
  let coeffT := setIndexedDividedPowerPolynomialCoefficientDPMorphism B T
  let relR (r : R →₀ B) (r₀ : B) : PR :=
    r.sum (fun z a => algebraMap B PR a * dividedPowerPolynomialVariable B z) -
      algebraMap B PR r₀
  let CpolyT : DividedPowerRing := .of P Ipoly δ
  let CpolyR : DividedPowerRing := .of PR IR δR
  have hvarIR (z : R) : dividedPowerPolynomialVariable B z ∈ IR :=
    variable_mem_polynomialIdeal B z
  have hvarIT (t : T) : dividedPowerPolynomialVariable B t ∈ Ipoly :=
    variable_mem_polynomialIdeal B t
  obtain ⟨sec, hsec, hsec_unique⟩ :=
    existsUnique_dPMorphism_from_setIndexedDividedPowerPolynomial B R CpolyT coeffT
      (fun z => ⟨dividedPowerPolynomialVariable B (chooseT z), hvarIT _⟩)
  obtain ⟨ret, hret, hret_unique⟩ :=
    existsUnique_dPMorphism_from_setIndexedDividedPowerPolynomial B T CpolyR coeffR
      (fun t => ⟨dividedPowerPolynomialVariable B (i t), hvarIR _⟩)
  have hsec_coeff (a : B) : sec.toRingHom (algebraMap B PR a) = algebraMap B P a := by
    have hh := congrArg
      (fun g : DividedPowers.DPMorphism B.dividedPowers δ => g.toRingHom a) hsec.1
    change sec.toRingHom (algebraMap B PR a) = algebraMap B P a at hh
    exact hh
  have hsec_var (z : R) : sec (dividedPowerPolynomialVariable B z) =
      dividedPowerPolynomialVariable B (chooseT z) := hsec.2 z
  have hsec_var' (z : R) : sec.toRingHom (dividedPowerPolynomialVariable B z) =
      dividedPowerPolynomialVariable B (chooseT z) := hsec_var z
  have hret_coeff (a : B) : ret.toRingHom (algebraMap B P a) = algebraMap B PR a := by
    have hh := congrArg
      (fun g : DividedPowers.DPMorphism B.dividedPowers δR => g.toRingHom a) hret.1
    change ret.toRingHom (algebraMap B P a) = algebraMap B PR a at hh
    exact hh
  have hret_var (t : T) : ret (dividedPowerPolynomialVariable B t) =
      dividedPowerPolynomialVariable B (i t) := hret.2 t
  have hret_var' (t : T) : ret.toRingHom (dividedPowerPolynomialVariable B t) =
      dividedPowerPolynomialVariable B (i t) := hret_var t
  let idR : DividedPowers.DPMorphism δR δR := DividedPowers.DPMorphism.id δR
  have hidR_coeff : idR.comp coeffR = coeffR := by
    ext a
    rfl
  have hidR_var (z : R) : idR (dividedPowerPolynomialVariable B z) =
      dividedPowerPolynomialVariable B z := rfl
  have hcomp_coeff : (ret.comp sec).comp coeffR = coeffR := by
    ext a
    show ret.toRingHom (sec.toRingHom (algebraMap B PR a)) = algebraMap B PR a
    rw [hsec_coeff, hret_coeff]
  have hcomp_var (z : R) :
      (ret.comp sec) (dividedPowerPolynomialVariable B z) =
        dividedPowerPolynomialVariable B z := by
    show ret (sec (dividedPowerPolynomialVariable B z)) = _
    rw [hsec_var, hret_var]
    have hi : i (chooseT z) = z := by
      apply Subtype.ext
      exact hchoose z
    rw [hi]
  have hretsec : ret.comp sec = idR := by
    obtain ⟨e, he, hu⟩ :=
      existsUnique_dPMorphism_from_setIndexedDividedPowerPolynomial B R CpolyR coeffR
        (fun z => ⟨dividedPowerPolynomialVariable B z, hvarIR z⟩)
    have hcomp : (ret.comp sec).comp coeffR = coeffR ∧
        ∀ z : R, (ret.comp sec) (dividedPowerPolynomialVariable B z) =
          (dividedPowerPolynomialVariable B z : CpolyR) :=
      ⟨hcomp_coeff, hcomp_var⟩
    have hid : idR.comp coeffR = coeffR ∧
        ∀ z : R, idR (dividedPowerPolynomialVariable B z) =
          (dividedPowerPolynomialVariable B z : CpolyR) :=
      ⟨hidR_coeff, hidR_var⟩
    exact (hu _ hcomp).trans (hu _ hid).symm
  have hsecK : Ideal.map sec.toRingHom KR ≤ K := by
    rw [Ideal.map_le_iff_le_comap]
    dsimp [KR, K, kernelPresentationIdeal]
    apply Ideal.span_le.2
    rintro x (hx | hx)
    · rcases hx with ⟨z, rfl⟩
      show sec.toRingHom (dividedPowerPolynomialVariable B z -
        algebraMap B PR (fR z)) ∈ K
      rw [map_sub]
      show sec (dividedPowerPolynomialVariable B z) -
        sec.toRingHom (algebraMap B PR (fR z)) ∈ K
      rw [hsec_var, hsec_coeff]
      have hfr : fR z = f (chooseT z) := by simpa [fR] using (hchoose z).symm
      rw [hfr]
      exact Ideal.subset_span (Or.inl ⟨chooseT z, rfl⟩)
    · rcases hx with ⟨n, r, r₀, hn, hr, rfl⟩
      let r' : T →₀ B := Finsupp.mapDomain chooseT r
      have hval : r'.sum (fun t a => a * f t) = r.sum (fun z a => a * fR z) := by
        refine (sum_mapDomain_mul (RingHom.id B) chooseT r f).trans (Finsupp.sum_congr ?_)
        intro z hz
        simp [hchoose z, fR]
      have hpoly : sec.toRingHom
          (r.sum (fun z a => algebraMap B PR a * dividedPowerPolynomialVariable B z)) =
          r'.sum (fun t a => algebraMap B P a * dividedPowerPolynomialVariable B t) := by
        simpa only [Finsupp.sum, map_sum, map_mul, hsec_coeff, hsec_var'] using
          (sum_mapDomain_mul (algebraMap B P) chooseT r
            (dividedPowerPolynomialVariable B)).symm
      have hrel : sec.toRingHom (relR r r₀) = relation r' r₀ := by
        simp [relR, relation, map_sub, hsec_coeff, hpoly]
      have hmem : relR r r₀ ∈ IR := relation_mem_polynomialIdeal B r r₀
      have hdp := sec.dpow_comp (n := n) (relR r r₀) hmem
      show sec.toRingHom (δR.dpow n (relR r r₀)) ∈ K
      rw [← hdp, hrel]
      apply Ideal.subset_span
      right
      refine ⟨n, r', r₀, hn, ?_, rfl⟩
      simpa [hval] using hr
  have hretK : Ideal.map ret.toRingHom K ≤ KR := by
    rw [Ideal.map_le_iff_le_comap]
    dsimp [KR, K, kernelPresentationIdeal]
    apply Ideal.span_le.2
    rintro x (hx | hx)
    · rcases hx with ⟨t, rfl⟩
      show ret.toRingHom (dividedPowerPolynomialVariable B t -
        algebraMap B P (f t)) ∈ KR
      rw [map_sub]
      show ret (dividedPowerPolynomialVariable B t) -
        ret.toRingHom (algebraMap B P (f t)) ∈ KR
      rw [hret_var, hret_coeff]
      exact Ideal.subset_span (Or.inl ⟨i t, rfl⟩)
    · rcases hx with ⟨n, r, r₀, hn, hr, rfl⟩
      let r' : R →₀ B := Finsupp.mapDomain i r
      have hval : r'.sum (fun z a => a * fR z) = r.sum (fun t a => a * f t) := by
        exact sum_mapDomain_mul (RingHom.id B) i r fR
      have hpoly : ret.toRingHom
          (r.sum (fun t a => algebraMap B P a * dividedPowerPolynomialVariable B t)) =
          r'.sum (fun z a => algebraMap B PR a * dividedPowerPolynomialVariable B z) := by
        simpa only [Finsupp.sum, map_sum, map_mul, hret_coeff, hret_var'] using
          (sum_mapDomain_mul (algebraMap B PR) i r (dividedPowerPolynomialVariable B)).symm
      have hrel : ret.toRingHom (relation r r₀) = relR r' r₀ := by
        simp [relation, relR, map_sub, hret_coeff, hpoly]
      have hmem : relation r r₀ ∈ Ipoly := hrelmem r r₀ hr
      have hdp := ret.dpow_comp (n := n) (relation r r₀) hmem
      show ret.toRingHom (δ.dpow n (relation r r₀)) ∈ KR
      rw [← hdp, hrel]
      apply Ideal.subset_span
      right
      refine ⟨n, r', r₀, hn, ?_, rfl⟩
      simpa [hval] using hr
  have hKstableR : δR.IsSubDPIdeal (KR ⊓ IR) := by
    refine ⟨inf_le_right, ?_⟩
    intro n hn x hx
    have hsx : sec.toRingHom x ∈ K ⊓ Ipoly :=
      ⟨hsecK (Ideal.mem_map_of_mem _ hx.1),
        sec.ideal_comp (Ideal.mem_map_of_mem sec.toRingHom hx.2)⟩
    have hdp := hKstable.dpow_mem n hn hsx
    have hdp' : sec.toRingHom (δR.dpow n x) = δ.dpow n (sec.toRingHom x) :=
      (sec.dpow_comp (n := n) x hx.2).symm
    have hrxK : ret.toRingHom (δ.dpow n (sec.toRingHom x)) ∈ KR :=
      hretK (Ideal.mem_map_of_mem _ hdp.1)
    have hrxK' : ret.toRingHom (sec.toRingHom (δR.dpow n x)) ∈ KR := by
      rw [← hdp'] at hrxK
      exact hrxK
    have hcompx := congrArg
      (fun g : DividedPowers.DPMorphism δR δR => g.toRingHom (δR.dpow n x)) hretsec
    change ret.toRingHom (sec.toRingHom (δR.dpow n x)) = δR.dpow n x at hcompx
    rw [hcompx] at hrxK'
    have hrxI : δR.dpow n x ∈ IR := δR.dpow_mem hn hx.2
    exact ⟨hrxK', hrxI⟩
  let qR : PR →+* PR ⧸ KR := Ideal.Quotient.mk KR
  let dpQR := DividedPowers.Quotient.dividedPowers δR hKstableR
  let CQR : DividedPowerRing := .of (PR ⧸ KR) (IR.map qR) dpQR
  have hqRdp : δR.IsDPMorphism dpQR qR :=
    DividedPowers.Quotient.isDPMorphism δR hKstableR
  have hrelRmem (z : R) :
      dividedPowerPolynomialVariable B z - algebraMap B PR (fR z) ∈ KR := by
    show dividedPowerPolynomialVariable B z - algebraMap B PR (fR z) ∈
      kernelPresentationIdeal B R fR
    apply Ideal.subset_span
    exact Or.inl ⟨z, rfl⟩
  have hqRvar (t : T) : qR (algebraMap B PR (f t)) =
      qR (dividedPowerPolynomialVariable B (i t)) := by
    have hh : qR (dividedPowerPolynomialVariable B (i t) -
        algebraMap B PR (fR (i t))) = 0 :=
      Ideal.Quotient.eq_zero_iff_mem.mpr (hrelRmem (i t))
    exact (sub_eq_zero.mp ((map_sub qR _ _).symm.trans hh)).symm
  let b : B →+* PR ⧸ KR := qR.comp (algebraMap B PR)
  have hbJ : Ideal.map b J ≤ IR.map qR := by
    rw [hf, Ideal.map_sup]
    apply sup_le
    · show Ideal.map (qR.comp (algebraMap B PR)) B.ideal ≤ IR.map qR
      rw [← Ideal.map_map]
      exact (Ideal.map_mono coeffR.ideal_comp).trans hqRdp.ideal_comp
    · rw [Ideal.map_span]
      apply Ideal.span_le.2
      rintro y ⟨x, hx, rfl⟩
      rcases hx with ⟨t, rfl⟩
      have hvar : qR (dividedPowerPolynomialVariable B (i t)) ∈ IR.map qR :=
        Ideal.mem_map_of_mem _ (hvarIR (i t))
      show qR (algebraMap B PR (f t)) ∈ IR.map qR
      rw [hqRvar]
      exact hvar
  let qRMorph : DividedPowers.DPMorphism δR dpQR := DividedPowers.DPMorphism.mk' hqRdp
  let a : DividedPowers.DPMorphism B.dividedPowers dpQR := qRMorph.comp coeffR
  let bPair : IdealPair.Hom J (IR.map qR) := IdealPair.Hom.ofRingHom b hbJ
  have hPair : IdealPair.Hom.comp bPair (IdealPair.Hom.ofRingHom (RingHom.id B) hJ) =
      IdealPair.Hom.ofDPMorphism a := by
    apply IdealPair.Hom.ext_toRingHom
    apply RingHom.ext
    intro x
    rfl
  let envMap := (D.homEquiv CQR a).symm ⟨bPair, hPair⟩
  have hEnvPair : IdealPair.Hom.comp (IdealPair.Hom.ofDPMorphism envMap.1) D.algebraMap =
      bPair := by
    have hh := D.homEquiv_apply CQR a envMap
    have heq : D.homEquiv CQR a envMap = ⟨bPair, hPair⟩ :=
      (D.homEquiv CQR a).apply_symm_apply ⟨bPair, hPair⟩
    rw [heq] at hh
    exact hh.symm
  have hEnvMap (c : B) :
      envMap.1.toRingHom (D.algebraMap.toRingHom c) = qR (algebraMap B PR c) := by
    have hh := congrArg (fun g : IdealPair.Hom J (IR.map qR) => g.toRingHom c) hEnvPair
    change envMap.1.toRingHom (D.algebraMap.toRingHom c) = b c at hh
    exact hh
  let rho : DividedPowers.DPMorphism δ dpQR := qRMorph.comp ret
  let lambda : DividedPowers.DPMorphism δ dpQR := envMap.1.comp ψ
  have hrhoCoeff : rho.comp coeffT = a := by
    ext c
    show qR (ret.toRingHom (algebraMap B P c)) =
      qR (algebraMap B PR c)
    rw [hret_coeff]
  have hlambdaCoeff : lambda.comp coeffT = a := by
    ext c
    show envMap.1.toRingHom (ψ.toRingHom (algebraMap B P c)) =
      qR (algebraMap B PR c)
    rw [hcoeff', ← halg]
    exact hEnvMap c
  have hvarQR (t : T) :
      lambda (dividedPowerPolynomialVariable B t) =
        rho (dividedPowerPolynomialVariable B t) := by
    show envMap.1.toRingHom (ψ.toRingHom (dividedPowerPolynomialVariable B t)) =
      qR (ret.toRingHom (dividedPowerPolynomialVariable B t))
    rw [hvar', ← halg, hEnvMap, hret_var']
    exact hqRvar t
  have hmapsQR : lambda = rho := by
    obtain ⟨e, he, hu⟩ :=
      existsUnique_dPMorphism_from_setIndexedDividedPowerPolynomial B T CQR a
        (fun t => ⟨rho (dividedPowerPolynomialVariable B t),
          rho.ideal_comp (Ideal.mem_map_of_mem _ (hvarIT t))⟩)
    have hl : lambda.comp coeffT = a ∧ ∀ t,
        lambda (dividedPowerPolynomialVariable B t) =
          (rho (dividedPowerPolynomialVariable B t) : CQR) :=
      ⟨hlambdaCoeff, hvarQR⟩
    have hr : rho.comp coeffT = a ∧ ∀ t,
        rho (dividedPowerPolynomialVariable B t) =
          (rho (dividedPowerPolynomialVariable B t) : CQR) :=
      ⟨hrhoCoeff, fun _ => rfl⟩
    exact (hu _ hl).trans (hu _ hr).symm
  have hKker : RingHom.ker ψ.toRingHom ≤ K := by
    intro x hx
    have hqRet : qR (ret.toRingHom x) = 0 := by
      have hh := congrArg
        (fun g : DividedPowers.DPMorphism δ dpQR => g.toRingHom x) hmapsQR
      change envMap.1.toRingHom (ψ.toRingHom x) = qR (ret.toRingHom x) at hh
      have hx0 : ψ.toRingHom x = 0 := RingHom.mem_ker.mp hx
      rw [hx0] at hh
      change envMap.1.toRingHom 0 = qR (ret.toRingHom x) at hh
      rw [map_zero] at hh
      exact hh.symm
    have hretx : ret.toRingHom x ∈ KR :=
      Ideal.Quotient.eq_zero_iff_mem.mp hqRet
    have hsecx : sec.toRingHom (ret.toRingHom x) ∈ K :=
      hsecK (Ideal.mem_map_of_mem _ hretx)
    let qT : P →+* P ⧸ K := Ideal.Quotient.mk K
    let dpQT := DividedPowers.Quotient.dividedPowers δ hKstable
    let CQT : DividedPowerRing := .of (P ⧸ K) (Ipoly.map qT) dpQT
    have hqTdp : δ.IsDPMorphism dpQT qT :=
      DividedPowers.Quotient.isDPMorphism δ hKstable
    have hvarQT (t : T) : qT (dividedPowerPolynomialVariable B t) =
        qT (dividedPowerPolynomialVariable B (chooseT (i t))) := by
      have hchoose' : f (chooseT (i t)) = f t := by
        calc
          f (chooseT (i t)) = fR (i t) := by
            simpa [fR] using hchoose (i t)
          _ = f t := by rfl
      have hdiff : dividedPowerPolynomialVariable B t -
          dividedPowerPolynomialVariable B (chooseT (i t)) ∈ K := by
        have ht := hqmem t
        have hr := hqmem (chooseT (i t))
        have heq : dividedPowerPolynomialVariable B t -
            dividedPowerPolynomialVariable B (chooseT (i t)) =
            Q t - Q (chooseT (i t)) := by
          simp [Q, hchoose']
        rw [heq]
        exact K.sub_mem ht hr
      have hzero := Ideal.Quotient.eq_zero_iff_mem.mpr hdiff
      rw [map_sub] at hzero
      exact sub_eq_zero.mp hzero
    let qTMorph : DividedPowers.DPMorphism δ dpQT := DividedPowers.DPMorphism.mk' hqTdp
    have hmapsQT : qT.comp (sec.toRingHom.comp ret.toRingHom) = qT := by
      obtain ⟨e, he, hu⟩ :=
        existsUnique_dPMorphism_from_setIndexedDividedPowerPolynomial B T CQT
          (qTMorph.comp coeffT)
          (fun t => ⟨qT (dividedPowerPolynomialVariable B t),
            hqTdp.ideal_comp (Ideal.mem_map_of_mem _ (hvarIT t))⟩)
      have hid : qTMorph.comp coeffT = qTMorph.comp coeffT ∧ ∀ t,
          qT (dividedPowerPolynomialVariable B t) =
            (qT (dividedPowerPolynomialVariable B t) : CQT) :=
        ⟨rfl, fun _ => rfl⟩
      have hcompCoeff : (qTMorph.comp (sec.comp ret)).comp coeffT =
          qTMorph.comp coeffT := by
        ext c
        show qT (sec.toRingHom (ret.toRingHom (algebraMap B P c))) =
          qT (algebraMap B P c)
        rw [hret_coeff, hsec_coeff]
      have hcompVar : ∀ t,
          (qTMorph.comp (sec.comp ret)) (dividedPowerPolynomialVariable B t) =
            (qT (dividedPowerPolynomialVariable B t) : CQT) := by
        intro t
        show qT (sec.toRingHom (ret.toRingHom (dividedPowerPolynomialVariable B t))) = _
        rw [hret_var', hsec_var']
        exact (hvarQT t).symm
      have hcomp : (qTMorph.comp (sec.comp ret)).comp coeffT = qTMorph.comp coeffT ∧
          ∀ t, (qTMorph.comp (sec.comp ret)) (dividedPowerPolynomialVariable B t) =
            (qT (dividedPowerPolynomialVariable B t) : CQT) :=
        ⟨hcompCoeff, hcompVar⟩
      have heq := (hu _ hcomp).trans (hu _ hid).symm
      have heq' : qTMorph.comp (sec.comp ret) = qTMorph := heq
      have hring := congrArg DividedPowers.DPMorphism.toRingHom heq'
      show (qTMorph.comp (sec.comp ret)).toRingHom = qTMorph.toRingHom
      exact hring
    have hqTx : qT x = 0 := by
      have hh := congrArg (fun g : P →+* P ⧸ K => g x) hmapsQT
      change qT (sec.toRingHom (ret.toRingHom x)) = qT x at hh
      have hzero : qT (sec.toRingHom (ret.toRingHom x)) = 0 :=
        Ideal.Quotient.eq_zero_iff_mem.mpr hsecx
      rw [hzero] at hh
      exact hh.symm
    exact Ideal.Quotient.eq_zero_iff_mem.mp hqTx
  apply le_antisymm
  · exact hKker
  · exact hK_le

end Crystalline

