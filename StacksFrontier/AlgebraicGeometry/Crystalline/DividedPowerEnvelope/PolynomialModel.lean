module

public import StacksFrontier.AlgebraicGeometry.Crystalline.DividedPowerEnvelope
public import StacksFrontier.RingTheory.DividedPowers.Polynomial.SetIndexedUniversalProperty
public import Mathlib.RingTheory.RingHom.Flat

/-!
# The divided power envelope of the variables of a polynomial algebra

Let `(A, I, γ)` be a divided power ring and let `Q` be a polynomial algebra over `A` on elements
`x_w`, i.e. `MvPolynomial.aeval x : A[X_w] → Q` is bijective. The divided power envelope of
`I Q + (x_w)` relative to `γ` is the divided power polynomial algebra `A⟨x_w⟩` with its divided
power ideal `I A⟨x⟩ + A⟨x⟩₊`; this is the case `J = I` of [Stacks, Tag 07KE], and is proved here
directly from the universal property of `A⟨x_w⟩`.

## Main definitions

* `Crystalline.polynomialModelEnvelope` — the envelope `A⟨x_w⟩` of `I Q + (x_w)`.

## Main results

* `Crystalline.flat_structureMap_polynomialModelEnvelope` — it is flat (indeed free) over `A`.

## References

* [Stacks Project, Tag 07KE](https://stacks.math.columbia.edu/tag/07KE)
-/

@[expose] public section

universe u

namespace Crystalline

open DividedPowers

variable (A : DividedPowerRing.{u}) (W : Type u)

/-- The divided power polynomial algebra `A⟨x_w : w ∈ W⟩` as a divided power ring. -/
noncomputable abbrev polynomialModelRing : DividedPowerRing.{u} :=
  .of (setIndexedDividedPowerPolynomialAlgebra A W) (dividedPowerPolynomialIdeal A.ideal W)
    (setIndexedDividedPowerPolynomialDividedPowers A W)

variable {W} {Q : Type u} [CommRing Q] [Algebra A Q] (x : W → Q)

/-- The ideal of `Q` generated by the divided power ideal of `A` and the elements `x`. -/
def polynomialModelIdeal : Ideal Q :=
  A.ideal.map (algebraMap A Q) ⊔ Ideal.span (Set.range x)

/-- The ideal `I Q + (x_w)` contains the extension of the base divided power ideal. -/
theorem le_polynomialModelIdeal :
    A.ideal.map (algebraMap A Q) ≤ polynomialModelIdeal A x := le_sup_left

variable (hx : Function.Bijective (MvPolynomial.aeval x : MvPolynomial W A →ₐ[A] Q))

/-- The map from `Q`, identified with the polynomial algebra on `x`, to the divided power
polynomial algebra sending `x_w` to the variable `x_w`. -/
noncomputable def polynomialModelMap : Q →ₐ[A] setIndexedDividedPowerPolynomialAlgebra A W :=
  (MvPolynomial.aeval (dividedPowerPolynomialVariable A)).comp
    (AlgEquiv.ofBijective _ hx).symm.toAlgHom

/-- The map `Q → A⟨x_w⟩` sends `x_w` to the divided power variable `x_w`. -/
theorem polynomialModelMap_apply_x (w : W) :
    polynomialModelMap A x hx (x w) = dividedPowerPolynomialVariable A w := by
  have : (AlgEquiv.ofBijective _ hx).symm (x w) = MvPolynomial.X w := by
    rw [AlgEquiv.symm_apply_eq]
    simp
  simp [polynomialModelMap, this]

/-- The map `Q → A⟨x_w⟩` evaluates a polynomial in the `x_w` at the divided power variables. -/
theorem polynomialModelMap_aeval (p : MvPolynomial W A) :
    polynomialModelMap A x hx (MvPolynomial.aeval x p) =
      MvPolynomial.aeval (dividedPowerPolynomialVariable A) p := by
  have : (AlgEquiv.ofBijective _ hx).symm (MvPolynomial.aeval x p) = p := by
    rw [AlgEquiv.symm_apply_eq]
    rfl
  simp [polynomialModelMap, this]

/-- The map `Q → A⟨x_w⟩` carries `I Q + (x_w)` into the divided power ideal of `A⟨x_w⟩`. -/
theorem map_polynomialModelIdeal_le :
    (polynomialModelIdeal A x).map (polynomialModelMap A x hx).toRingHom ≤
      dividedPowerPolynomialIdeal A.ideal W := by
  rw [polynomialModelIdeal, Ideal.map_sup, Ideal.map_map]
  apply sup_le
  · apply Ideal.map_le_iff_le_comap.mpr
    intro a ha
    show polynomialModelMap A x hx (algebraMap A Q a) ∈ dividedPowerPolynomialIdeal A.ideal W
    rw [AlgHom.commutes]
    exact Ideal.mem_sup_left (Ideal.mem_map_of_mem _ ha)
  · rw [Ideal.map_span]
    apply Ideal.span_le.mpr
    rintro _ ⟨_, ⟨w, rfl⟩, rfl⟩
    show polynomialModelMap A x hx (x w) ∈ dividedPowerPolynomialIdeal A.ideal W
    rw [polynomialModelMap_apply_x]
    exact variable_mem_polynomialIdeal A w

/-- **The divided power envelope of `I Q + (x_w)` in the polynomial algebra `Q = A[x_w]` is the
divided power polynomial algebra `A⟨x_w⟩`.** -/
noncomputable def polynomialModelEnvelope :
    DividedPowerEnvelope A (algebraMap A Q) (polynomialModelIdeal A x)
      (le_polynomialModelIdeal A x) where
  object := polynomialModelRing A W
  structureMap := setIndexedDividedPowerPolynomialCoefficientDPMorphism A W
  algebraMap := IdealPair.Hom.ofRingHom (polynomialModelMap A x hx).toRingHom
    (map_polynomialModelIdeal_le A x hx)
  algebraMap_comp := by
    ext a
    exact (polynomialModelMap A x hx).commutes a
  homEquiv C a :=
    { toFun := fun q => ⟨IdealPair.Hom.comp (IdealPair.Hom.ofDPMorphism q.1)
          (IdealPair.Hom.ofRingHom (polynomialModelMap A x hx).toRingHom
            (map_polynomialModelIdeal_le A x hx)), by
          apply IdealPair.Hom.ext_toRingHom
          ext z
          change q.1.toRingHom (polynomialModelMap A x hx (algebraMap A Q z)) = a.toRingHom z
          rw [AlgHom.commutes]
          exact congrArg (fun r => r.toRingHom z) q.2⟩
      invFun := fun g => by
        refine ⟨Classical.choose (existsUnique_dPMorphism_from_setIndexedDividedPowerPolynomial
          A W C a (fun w => ⟨g.1.toRingHom (x w), g.1.ideal_comp (Ideal.mem_map_of_mem _
            (Ideal.mem_sup_right (Ideal.subset_span ⟨w, rfl⟩)))⟩)).exists, ?_⟩
        exact (Classical.choose_spec
          (existsUnique_dPMorphism_from_setIndexedDividedPowerPolynomial A W C a _).exists).1
      left_inv := fun q => by
        apply Subtype.ext
        have hu := existsUnique_dPMorphism_from_setIndexedDividedPowerPolynomial A W C a
          (fun w => ⟨q.1.toRingHom (polynomialModelMap A x hx (x w)),
            (IdealPair.Hom.comp (IdealPair.Hom.ofDPMorphism q.1)
              (IdealPair.Hom.ofRingHom (polynomialModelMap A x hx).toRingHom
                (map_polynomialModelIdeal_le A x hx))).ideal_comp (Ideal.mem_map_of_mem _
              (Ideal.mem_sup_right (Ideal.subset_span ⟨w, rfl⟩)))⟩)
        refine hu.unique (Classical.choose_spec hu.exists) ⟨q.2, fun w => ?_⟩
        change q.1.toRingHom (dividedPowerPolynomialVariable A w) =
          q.1.toRingHom (polynomialModelMap A x hx (x w))
        rw [polynomialModelMap_apply_x]
      right_inv := fun g => by
        apply Subtype.ext
        apply IdealPair.Hom.ext_toRingHom
        set χ := Classical.choose (existsUnique_dPMorphism_from_setIndexedDividedPowerPolynomial
          A W C a (fun w => ⟨g.1.toRingHom (x w), g.1.ideal_comp (Ideal.mem_map_of_mem _
            (Ideal.mem_sup_right (Ideal.subset_span ⟨w, rfl⟩)))⟩)).exists with hχ
        have hspec := Classical.choose_spec
          (existsUnique_dPMorphism_from_setIndexedDividedPowerPolynomial A W C a
            (fun w => ⟨g.1.toRingHom (x w), g.1.ideal_comp (Ideal.mem_map_of_mem _
              (Ideal.mem_sup_right (Ideal.subset_span ⟨w, rfl⟩)))⟩)).exists
        rw [← hχ] at hspec
        have key : (χ.toRingHom.comp (polynomialModelMap A x hx).toRingHom).comp
            (MvPolynomial.aeval (R := A) x).toRingHom =
              g.1.toRingHom.comp (MvPolynomial.aeval (R := A) x).toRingHom := by
          apply MvPolynomial.ringHom_ext
          · intro z
            change χ.toRingHom (polynomialModelMap A x hx (MvPolynomial.aeval x
              (MvPolynomial.C z))) = g.1.toRingHom (MvPolynomial.aeval x (MvPolynomial.C z))
            rw [MvPolynomial.aeval_C, AlgHom.commutes]
            exact (congrArg (fun r => r.toRingHom z) hspec.1).trans
              (congrArg (fun r => r.toRingHom z) g.2).symm
          · intro w
            change χ.toRingHom (polynomialModelMap A x hx (MvPolynomial.aeval x
              (MvPolynomial.X w))) = g.1.toRingHom (MvPolynomial.aeval x (MvPolynomial.X w))
            rw [MvPolynomial.aeval_X, polynomialModelMap_apply_x]
            exact hspec.2 w
        ext z
        obtain ⟨p, rfl⟩ := hx.2 z
        exact congrArg (fun r => r p) key }
  homEquiv_apply C a q := rfl

/-- The divided power polynomial algebra is flat (indeed free) over `A`. -/
theorem flat_structureMap_polynomialModelEnvelope :
    (polynomialModelEnvelope A x hx).structureMap.toRingHom.Flat := by
  have : Module.Free A (DividedPowerAlgebra A (W →₀ A)) :=
    .of_basis (dividedPowerPolynomialMonomialBasis A W)
  exact (RingHom.flat_algebraMap_iff (R := A) (S := DividedPowerAlgebra A (W →₀ A))).mpr
    inferInstance

end Crystalline
