module

public import Mathlib.RingTheory.DividedPowers.SubDPIdeal
public import Mathlib.RingTheory.Ideal.Quotient.Operations
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Crystalline.DividedPowerEnvelope
public import StacksFrontier.RingTheory.DividedPowers.Polynomial.Basic
public import StacksFrontier.RingTheory.DividedPowers.Polynomial.SetIndexed
public import StacksFrontier.RingTheory.DividedPowers.Polynomial.SetIndexedUniversalProperty

/-!
# A divided power polynomial presentation of a divided power envelope

Let `(B, I, γ)` be a divided power ring and let `J` be an ideal generated by `I` together with
a family `f : T → B`. Then the divided power envelope of `J` is a quotient of the divided power
polynomial algebra on `T` over `B`: there is a surjective divided power morphism from that
algebra onto the envelope, over `B`, carrying the variable `x_t` to the image of `f t`.

## Main results

* `Crystalline.surjectiveDividedPowerPolynomialMap` is that surjection, together with its
  compatibility with the coefficient ring, its values on the variables, and its surjectivity.

## Implementation notes

The result is subtype-valued so that later results can refer to this specific morphism rather
than to an unspecified one; its specification records exactly the three properties above. The
chosen envelope is allowed to be any object with the universal property of the divided power
envelope, so the statement does not depend on a construction.

Surjectivity is proved by exhibiting the image as a divided power subring with the same
universal property: the image of the polynomial algebra, equipped with the quotient divided
powers, receives a map from the envelope, and the universal property forces the composite with
the surjection onto the image to be the identity of the envelope.

The hypothesis that each `f t` belongs to `J` is not assumed separately — it follows from the
displayed generation equality `J = I ⊔ span (range f)`.

## References

* [Stacks Project, Tag 07HC](https://stacks.math.columbia.edu/tag/07HC)
-/

@[expose] public section

noncomputable section

namespace Crystalline

open DividedPowers

universe u w

/-- The divided power polynomial ring maps onto the envelope of an ideal generated
by the coefficient divided power ideal and the chosen variables. -/
@[stacks 07HC "surjection"]
public noncomputable def surjectiveDividedPowerPolynomialMap
    (B : DividedPowerRing.{u}) (T : Type w)
    (J : Ideal B) (hJ : B.ideal.map (RingHom.id B) ≤ J)
    (f : T → B) (hf : J = B.ideal ⊔ Ideal.span (Set.range f))
    (D : DividedPowerEnvelope B (RingHom.id B) J hJ) :
    { ψ : DividedPowers.DPMorphism
        (setIndexedDividedPowerPolynomialDividedPowers B T)
        D.object.dividedPowers //
      ψ.comp (setIndexedDividedPowerPolynomialCoefficientDPMorphism B T) =
          D.structureMap ∧
        (∀ t : T, ψ (dividedPowerPolynomialVariable B t) =
          D.algebraMap.toRingHom (f t)) ∧
        Function.Surjective ψ } := by
  classical
  let P := setIndexedDividedPowerPolynomialAlgebra B T
  let δ := setIndexedDividedPowerPolynomialDividedPowers B T
  let Ipoly := dividedPowerPolynomialIdeal B.ideal T
  let coeff := setIndexedDividedPowerPolynomialCoefficientDPMorphism B T
  have hf_mem (t : T) : f t ∈ J := by
    rw [hf]
    exact Ideal.mem_sup_right (Ideal.subset_span ⟨t, rfl⟩)
  let k : T → D.object.ideal := fun t =>
    ⟨D.algebraMap.toRingHom (f t),
      D.algebraMap.ideal_comp (Ideal.mem_map_of_mem _ (hf_mem t))⟩
  let e := existsUnique_dPMorphism_from_setIndexedDividedPowerPolynomial B T
    D.object D.structureMap k
  let φ := Classical.choose e.exists
  have hφ : φ.comp coeff = D.structureMap ∧
      ∀ t : T, φ (dividedPowerPolynomialVariable B t) =
        D.algebraMap.toRingHom (f t) := Classical.choose_spec e.exists
  let K : Ideal P := RingHom.ker φ.toRingHom
  have hK : DividedPowers.IsSubDPIdeal δ (K ⊓ Ipoly) :=
    DividedPowers.isSubDPIdeal_ker δ D.object.dividedPowers
      φ.isDPMorphism
  let QLarge : DividedPowerRing :=
    { carrier := P ⧸ K
      commRing := inferInstance
      ideal := Ipoly.map (Ideal.Quotient.mk K)
      dividedPowers := DividedPowers.Quotient.dividedPowers δ hK }
  let qLarge : DividedPowers.DPMorphism δ QLarge.dividedPowers :=
    DividedPowers.DPMorphism.mk'
      (DividedPowers.Quotient.isDPMorphism δ hK)
  let eRange := RingHom.quotientKerEquivRange φ.toRingHom
  have heIdeal : QLarge.ideal.map eRange.toRingHom =
      Ipoly.map (eRange.toRingHom.comp (Ideal.Quotient.mk K)) := by
    change (Ipoly.map (Ideal.Quotient.mk (RingHom.ker φ.toRingHom))).map
      eRange.toRingHom = Ipoly.map (eRange.toRingHom.comp
        (Ideal.Quotient.mk (RingHom.ker φ.toRingHom)))
    rw [Ideal.map_map]
  let Q : DividedPowerRing :=
    { carrier := φ.toRingHom.range
      commRing := inferInstance
      ideal := QLarge.ideal.map eRange.toRingHom
      dividedPowers := DividedPowers.ofRingEquiv rfl QLarge.dividedPowers }
  let eDP : DividedPowers.DPMorphism QLarge.dividedPowers Q.dividedPowers := by
    refine DividedPowers.DPMorphism.mk' (f := eRange.toRingHom) ?_
    refine ⟨?_, ?_⟩
    · exact le_of_eq rfl
    · intro n x hx
      exact DividedPowers.ofRingEquiv_dpow_apply heIdeal QLarge.dividedPowers
  let q : DividedPowers.DPMorphism δ Q.dividedPowers := eDP.comp qLarge
  have hQideal : Q.ideal = Ipoly.map q.toRingHom := by
    change (Ipoly.map (Ideal.Quotient.mk (RingHom.ker φ.toRingHom))).map
      eRange.toRingHom = Ipoly.map q.toRingHom
    rw [Ideal.map_map]
    rfl
  let a : DividedPowers.DPMorphism B.dividedPowers Q.dividedPowers := q.comp coeff
  let b : B →+* Q.carrier := q.toRingHom.comp coeff.toRingHom
  have hbI : B.ideal.map b ≤ Q.ideal := by
    change B.ideal.map a.toRingHom ≤ Q.ideal
    exact a.ideal_comp
  have hqValue (x : P) : q x = ⟨φ x, φ.toRingHom.mem_range_self x⟩ := by
    apply Subtype.ext
    change (RingHom.quotientKerEquivRange φ.toRingHom)
      (Ideal.Quotient.mk (RingHom.ker φ.toRingHom) x) = φ x
    dsimp [RingHom.quotientKerEquivRange]
  have hrel (t : T) : b (f t) = q (dividedPowerPolynomialVariable B t) := by
    have hc : φ (coeff.toRingHom (f t)) = D.algebraMap.toRingHom (f t) := by
      have hh := congrArg
        (fun g : DividedPowers.DPMorphism B.dividedPowers D.object.dividedPowers => g (f t)) hφ.1
      change φ (coeff.toRingHom (f t)) = D.structureMap (f t) at hh
      have hd := congrArg (fun g : B →+* D.object.carrier => g (f t)) D.algebraMap_comp
      simpa [RingHom.comp_apply] using hh.trans hd.symm
    change q (coeff.toRingHom (f t)) = q (dividedPowerPolynomialVariable B t)
    rw [hqValue, hqValue]
    exact Subtype.ext (hc.trans (hφ.2 t).symm)
  have hbSpan : (Ideal.span (Set.range f)).map b ≤ Q.ideal := by
    rw [Ideal.map_le_iff_le_comap, Ideal.span_le]
    rintro _ ⟨t, rfl⟩
    change b (f t) ∈ Q.ideal
    rw [hrel t]
    exact q.ideal_comp (Ideal.mem_map_of_mem _ (variable_mem_polynomialIdeal B t))
  have hbJ : J.map b ≤ Q.ideal := by
    refine (Ideal.map_mono hf.le).trans ?_
    rw [Ideal.map_sup]
    exact sup_le hbI hbSpan
  let bPair : IdealPair.Hom J Q.ideal := IdealPair.Hom.ofRingHom b hbJ
  have hbOver : IdealPair.Hom.comp bPair
      (IdealPair.Hom.ofRingHom (RingHom.id B) hJ) = IdealPair.Hom.ofDPMorphism a := by
    apply IdealPair.Hom.ext_toRingHom
    change b.comp (RingHom.id B) = a.toRingHom
    ext x
    rfl
  let qData := (D.homEquiv Q a).symm ⟨bPair, hbOver⟩
  have hqAlg : qData.1.toRingHom.comp D.algebraMap.toRingHom = b := by
    have hh := D.homEquiv_apply Q a qData
    have hval : (D.homEquiv Q a qData).1 = bPair :=
      congrArg Subtype.val ((D.homEquiv Q a).apply_symm_apply ⟨bPair, hbOver⟩)
    have hpair : bPair = IdealPair.Hom.comp
        (IdealPair.Hom.ofDPMorphism qData.1) D.algebraMap := hval.symm.trans hh
    have hr := congrArg IdealPair.Hom.toRingHom hpair.symm
    change qData.1.toRingHom.comp D.algebraMap.toRingHom = bPair.toRingHom at hr
    simpa only [bPair, IdealPair.Hom.ofRingHom] using hr
  let lift : Q.carrier →+* D.object.carrier :=
    SubringClass.subtype φ.toRingHom.range
  have hliftq : lift.comp q.toRingHom = φ.toRingHom := by
    apply RingHom.ext
    intro x
    change (q x).val = φ x
    exact congrArg Subtype.val (hqValue x)
  let liftDP : DividedPowers.DPMorphism Q.dividedPowers D.object.dividedPowers :=
    DividedPowers.DPMorphism.mk' (f := lift) (DividedPowers.IsDPMorphism.of_comp
      δ Q.dividedPowers D.object.dividedPowers
      (f := q.toRingHom) (g := lift) hQideal q.isDPMorphism (by
        rw [hliftq]
        exact φ.isDPMorphism))
  have hliftb : lift.comp b = D.algebraMap.toRingHom := by
    change (lift.comp q.toRingHom).comp coeff.toRingHom = D.algebraMap.toRingHom
    rw [hliftq]
    exact (congrArg DividedPowers.DPMorphism.toRingHom hφ.1).trans D.algebraMap_comp.symm
  let r := liftDP.comp qData.1
  have hrAlg : r.toRingHom.comp D.algebraMap.toRingHom = D.algebraMap.toRingHom := by
    change lift.comp (qData.1.toRingHom.comp D.algebraMap.toRingHom) = _
    rw [hqAlg, hliftb]
  have hrBase : r.comp D.structureMap = D.structureMap := by
    apply DividedPowers.DPMorphism.ext
    funext x
    have hqbase : qData.1 (D.structureMap x) = a x := congrArg (fun g : B →+* Q.carrier => g x)
      (congrArg DividedPowers.DPMorphism.toRingHom qData.2)
    have hbase : liftDP (a x) = D.structureMap x :=
      calc
        liftDP (a x) = lift (q (coeff x)) := rfl
        _ = φ (coeff x) := (RingHom.ext_iff.mp hliftq (coeff x)).symm
        _ = D.structureMap x := congrArg (fun g : B →+* D.object.carrier => g x)
          (congrArg DividedPowers.DPMorphism.toRingHom hφ.1)
    change liftDP (qData.1 (D.structureMap x)) = D.structureMap x
    exact (congrArg liftDP hqbase).trans hbase
  have hrId : r = DividedPowers.DPMorphism.id D.object.dividedPowers := by
    have hid : (DividedPowers.DPMorphism.id D.object.dividedPowers).comp D.structureMap =
        D.structureMap := by
      apply DividedPowers.DPMorphism.ext
      funext x
      rfl
    have hmaps : D.homEquiv D.object D.structureMap ⟨r, hrBase⟩ =
        D.homEquiv D.object D.structureMap ⟨_, hid⟩ := by
      apply Subtype.ext
      rw [D.homEquiv_apply D.object D.structureMap ⟨r, hrBase⟩,
        D.homEquiv_apply D.object D.structureMap ⟨_, hid⟩]
      apply IdealPair.Hom.ext_toRingHom
      exact hrAlg
    exact congrArg Subtype.val ((D.homEquiv D.object D.structureMap).injective hmaps)
  refine ⟨φ, hφ.1, hφ.2, fun d => ?_⟩
  have hrd := congrArg (fun g : D.object.carrier →+* D.object.carrier => g d)
    (congrArg DividedPowers.DPMorphism.toRingHom hrId)
  obtain ⟨x, hx⟩ := (qData.1 d).property
  exact ⟨x, hx.trans hrd⟩

end Crystalline

end
