module

public import Mathlib.RingTheory.MvPolynomial.Basic
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Crystalline.DividedPowerEnvelope
public import StacksFrontier.RingTheory.DividedPowers.Polynomial.Basic
public import StacksFrontier.RingTheory.DividedPowers.Polynomial.SetIndexed
public import StacksFrontier.RingTheory.DividedPowers.Polynomial.SetIndexedUniversalProperty

/-!
# Divided power envelopes after adjoining polynomial variables

Let `(A, I, γ)` be a divided power ring, `f : A → B` a ring homomorphism and `J ⊆ B` an ideal
containing `f(I)`. Adjoin ordinary polynomial variables `W` to `B` and take the divided power
envelope of the ideal generated by `J` and the variables. The result is the divided power
polynomial algebra on `W` over the divided power envelope of `J` itself.

## Main definitions

* `Crystalline.polynomialEnvelopeIdeal` is the ideal of `MvPolynomial W B` generated by the
  extension of `J` and the polynomial variables.

## Main results

* `Crystalline.baseIdeal_le_polynomialEnvelopeIdeal`: the image of the base divided power
  ideal lies in that ideal.
* `Crystalline.dividedPowerEnvelopeAddVariables`: the envelope is isomorphic to the divided power
  polynomial algebra on `W` over the envelope of `J`, by an isomorphism sending coefficients and
  variables to coefficients and variables, compatible with divided powers in both directions.

## References

* [Stacks Project, Tag 07KE](https://stacks.math.columbia.edu/tag/07KE)
-/

@[expose] public section

noncomputable section

universe u

namespace Crystalline

open DividedPowers

variable {A : DividedPowerRing.{u}} {B : Type u} [CommRing B]

/-- The ideal in the polynomial ring generated by the extended ideal and the variables. -/
public def polynomialEnvelopeIdeal (J : Ideal B) (W : Type u) :
    Ideal (MvPolynomial W B) :=
  J.map MvPolynomial.C + Ideal.span (Set.range (MvPolynomial.X : W → MvPolynomial W B))

/-- The image of the base divided power ideal lies in the polynomial envelope ideal. -/
public lemma baseIdeal_le_polynomialEnvelopeIdeal (f : A →+* B) (J : Ideal B)
    (hJ : A.ideal.map f ≤ J) (W : Type u) :
    A.ideal.map (MvPolynomial.C.comp f) ≤ polynomialEnvelopeIdeal J W := by
  calc
    A.ideal.map (MvPolynomial.C.comp f) = (A.ideal.map f).map MvPolynomial.C := by
      rw [Ideal.map_map]
    _ ≤ J.map MvPolynomial.C := Ideal.map_mono hJ
    _ ≤ polynomialEnvelopeIdeal J W := le_sup_left

/-- The map out of the envelope built from a morphism of pairs restricts to it on `B`. -/
private theorem symm_homEquiv_comp_algebraMap {f : A →+* B} {J : Ideal B}
    {hJ : A.ideal.map f ≤ J} (D : DividedPowerEnvelope A f J hJ) (C : DividedPowerRing.{u})
    (a : DividedPowers.DPMorphism A.dividedPowers C.dividedPowers)
    (t : IdealPair.HomOver (IdealPair.Hom.ofRingHom f hJ) (IdealPair.Hom.ofDPMorphism a)) :
    ((D.homEquiv C a).symm t).1.toRingHom.comp D.algebraMap.toRingHom = t.1.toRingHom :=
  congrArg IdealPair.Hom.toRingHom
    ((D.homEquiv_apply C a ((D.homEquiv C a).symm t)).symm.trans
      (congrArg Subtype.val ((D.homEquiv C a).apply_symm_apply t)))

/-- The divided power envelope of a polynomial algebra along the extended ideal and the
variables is canonically the divided power polynomial algebra over the original envelope. -/
@[stacks 07KE]
public theorem dividedPowerEnvelopeAddVariables (f : A →+* B) (J : Ideal B)
    (hJ : A.ideal.map f ≤ J) (W : Type u)
    (D : DividedPowerEnvelope A f J hJ)
    (E : DividedPowerEnvelope A (MvPolynomial.C.comp f)
      (polynomialEnvelopeIdeal J W) (baseIdeal_le_polynomialEnvelopeIdeal f J hJ W)) :
    ∃ e : E.object ≃+* setIndexedDividedPowerPolynomialAlgebra D.object W,
      DividedPowers.IsDPMorphism E.object.dividedPowers
        (setIndexedDividedPowerPolynomialDividedPowers D.object W) e.toRingHom ∧
      DividedPowers.IsDPMorphism
        (setIndexedDividedPowerPolynomialDividedPowers D.object W)
        E.object.dividedPowers e.symm.toRingHom ∧
      (∀ b : B, e (E.algebraMap.toRingHom (MvPolynomial.C b)) =
        algebraMap D.object (setIndexedDividedPowerPolynomialAlgebra D.object W)
          (D.algebraMap.toRingHom b)) ∧
      (∀ i : W, e (E.algebraMap.toRingHom (MvPolynomial.X i)) =
        dividedPowerPolynomialVariable D.object i) := by
  classical
  let P := setIndexedDividedPowerPolynomialAlgebra D.object W
  let Pdp : DividedPowerRing := .of P (dividedPowerPolynomialIdeal D.object.ideal W)
    (setIndexedDividedPowerPolynomialDividedPowers D.object W)
  let coeff := setIndexedDividedPowerPolynomialCoefficientDPMorphism D.object W
  let xvar (i : W) := dividedPowerPolynomialVariable D.object i
  let coeffB : B →+* P := coeff.toRingHom.comp D.algebraMap.toRingHom
  let polyToP : MvPolynomial W B →+* P := MvPolynomial.eval₂Hom coeffB xvar
  have hPolyIdeal :
      Ideal.map polyToP (polynomialEnvelopeIdeal J W) ≤
        dividedPowerPolynomialIdeal D.object.ideal W := by
    change Ideal.map polyToP
      (J.map MvPolynomial.C + Ideal.span (Set.range MvPolynomial.X)) ≤
        dividedPowerPolynomialIdeal D.object.ideal W
    rw [Ideal.add_eq_sup, Ideal.map_sup, Ideal.map_map]
    refine sup_le (Ideal.map_le_iff_le_comap.mpr fun b hb => ?_)
      (Ideal.map_le_iff_le_comap.mpr (Ideal.span_le.2 ?_))
    · change polyToP (MvPolynomial.C b) ∈ dividedPowerPolynomialIdeal D.object.ideal W
      rw [MvPolynomial.eval₂Hom_C]
      exact coeff.ideal_comp (Ideal.mem_map_of_mem _
        (D.algebraMap.ideal_comp (Ideal.mem_map_of_mem _ hb)))
    · rintro _ ⟨i, rfl⟩
      change polyToP (MvPolynomial.X i) ∈ dividedPowerPolynomialIdeal D.object.ideal W
      rw [MvPolynomial.eval₂Hom_X']
      exact variable_mem_polynomialIdeal D.object i
  let polyPair : IdealPair.Hom (polynomialEnvelopeIdeal J W)
      (dividedPowerPolynomialIdeal D.object.ideal W) :=
    IdealPair.Hom.ofRingHom polyToP hPolyIdeal
  let baseToP := coeff.comp D.structureMap
  have hPolyBase :
      IdealPair.Hom.comp polyPair
          (IdealPair.Hom.ofRingHom (MvPolynomial.C.comp f)
            (baseIdeal_le_polynomialEnvelopeIdeal f J hJ W)) =
        IdealPair.Hom.ofDPMorphism baseToP := by
    apply IdealPair.Hom.ext_toRingHom
    ext a
    change polyToP (MvPolynomial.C (f a)) = baseToP a
    rw [MvPolynomial.eval₂Hom_C]
    exact congrArg (fun g : A →+* P => g a)
      (congrArg (fun g : A →+* D.object.carrier => coeff.toRingHom.comp g) D.algebraMap_comp)
  let eData := (E.homEquiv Pdp baseToP).symm ⟨polyPair, hPolyBase⟩
  let eDP := eData.1
  have hEPoly : eDP.toRingHom.comp E.algebraMap.toRingHom = polyToP := by
    exact symm_homEquiv_comp_algebraMap E Pdp baseToP ⟨polyPair, hPolyBase⟩
  let coeffToE : B →+* E.object.carrier := E.algebraMap.toRingHom.comp MvPolynomial.C
  have hCoeffIdeal : J.map coeffToE ≤ E.object.ideal := by
    calc
      J.map coeffToE = (J.map MvPolynomial.C).map E.algebraMap.toRingHom := by
        rw [Ideal.map_map]
      _ ≤ E.object.ideal :=
        (Ideal.map_mono (le_sup_left :
          J.map MvPolynomial.C ≤ polynomialEnvelopeIdeal J W)).trans
          E.algebraMap.ideal_comp
  let coeffPair : IdealPair.Hom J E.object.ideal := IdealPair.Hom.ofRingHom coeffToE hCoeffIdeal
  have hCoeffOver :
      IdealPair.Hom.comp coeffPair (IdealPair.Hom.ofRingHom f hJ) =
        IdealPair.Hom.ofDPMorphism E.structureMap := by
    apply IdealPair.Hom.ext_toRingHom
    ext a
    exact congrArg (fun g : A →+* E.object.carrier => g a) E.algebraMap_comp
  let dData := (D.homEquiv E.object E.structureMap).symm ⟨coeffPair, hCoeffOver⟩
  let dToE := dData.1
  have hDAlg : dToE.toRingHom.comp D.algebraMap.toRingHom = coeffToE := by
    exact symm_homEquiv_comp_algebraMap D E.object E.structureMap ⟨coeffPair, hCoeffOver⟩
  have hVarE (i : W) : E.algebraMap.toRingHom (MvPolynomial.X i) ∈ E.object.ideal :=
    E.algebraMap.ideal_comp (Ideal.mem_map_of_mem _
      (Ideal.mem_sup_right (Ideal.subset_span ⟨i, rfl⟩)))
  let varToE : W → E.object.ideal := fun i => ⟨_, hVarE i⟩
  let u := existsUnique_dPMorphism_from_setIndexedDividedPowerPolynomial
    D.object W E.object dToE varToE
  let pDP := Classical.choose u.exists
  have hp : pDP.comp coeff = dToE ∧ ∀ i : W, pDP (xvar i) = varToE i :=
    Classical.choose_spec u.exists
  have hDComp : eDP.comp dToE = coeff := by
    refine envelopeHom_ext D Pdp _ _ ?_ ?_
    · calc
        (eDP.comp dToE).comp D.structureMap = eDP.comp (dToE.comp D.structureMap) := rfl
        _ = eDP.comp E.structureMap := by rw [dData.property]
        _ = baseToP := eData.property
    · ext b
      change eDP (dToE (D.algebraMap.toRingHom b)) = coeff (D.algebraMap.toRingHom b)
      rw [show dToE (D.algebraMap.toRingHom b) = E.algebraMap.toRingHom (MvPolynomial.C b) from
        RingHom.congr_fun hDAlg b, show eDP (E.algebraMap.toRingHom (MvPolynomial.C b)) =
        polyToP (MvPolynomial.C b) from RingHom.congr_fun hEPoly _]
      simp [polyToP, coeffB]
  let coeffP : W → dividedPowerPolynomialIdeal D.object.ideal W := fun i =>
    ⟨xvar i, variable_mem_polynomialIdeal D.object i⟩
  let uP := existsUnique_dPMorphism_from_setIndexedDividedPowerPolynomial
    D.object W Pdp coeff coeffP
  have hCompVar (i : W) : (eDP.comp pDP) (xvar i) = xvar i := by
    change eDP (pDP (xvar i)) = xvar i
    calc
      eDP (pDP (xvar i)) = eDP (varToE i) := by rw [hp.2 i]
      _ = polyToP (MvPolynomial.X i) := RingHom.congr_fun hEPoly (MvPolynomial.X i)
      _ = xvar i := by simp [polyToP]
  have hCompP : eDP.comp pDP = DividedPowers.DPMorphism.id
      (setIndexedDividedPowerPolynomialDividedPowers D.object W) :=
    uP.unique (y₁ := eDP.comp pDP)
      (y₂ := DividedPowers.DPMorphism.id
        (setIndexedDividedPowerPolynomialDividedPowers D.object W))
      ⟨(congrArg eDP.comp hp.1).trans hDComp, hCompVar⟩ ⟨rfl, fun _ => rfl⟩
  have hCoeffComp : pDP.toRingHom.comp coeffB = coeffToE := by
    ext b
    exact (congrArg (fun q : D.object.dividedPowers.DPMorphism E.object.dividedPowers =>
      q (D.algebraMap.toRingHom b)) hp.1).trans
        (congrArg (fun g : B →+* E.object.carrier => g b) hDAlg)
  have hPolyToE : pDP.toRingHom.comp polyToP = E.algebraMap.toRingHom := by
    apply MvPolynomial.ringHom_ext'
    · ext b
      change pDP (polyToP (MvPolynomial.C b)) = E.algebraMap.toRingHom (MvPolynomial.C b)
      rw [MvPolynomial.eval₂Hom_C]
      exact congrArg (fun g : B →+* E.object.carrier => g b) hCoeffComp
    · intro i
      change pDP (polyToP (MvPolynomial.X i)) = E.algebraMap.toRingHom (MvPolynomial.X i)
      rw [MvPolynomial.eval₂Hom_X']
      exact hp.2 i
  have hCompE : pDP.comp eDP = DividedPowers.DPMorphism.id E.object.dividedPowers := by
    refine envelopeHom_ext E E.object _ _ ?_ ?_
    · calc
        (pDP.comp eDP).comp E.structureMap = pDP.comp (eDP.comp E.structureMap) := rfl
        _ = pDP.comp baseToP := by rw [eData.property]
        _ = (pDP.comp coeff).comp D.structureMap := rfl
        _ = dToE.comp D.structureMap := congrArg (fun q => q.comp D.structureMap) hp.1
        _ = E.structureMap := dData.property
        _ = (DividedPowers.DPMorphism.id E.object.dividedPowers).comp E.structureMap := rfl
    · calc
        (pDP.comp eDP).toRingHom.comp E.algebraMap.toRingHom =
            pDP.toRingHom.comp (eDP.toRingHom.comp E.algebraMap.toRingHom) := by
              simpa only [DividedPowers.DPMorphism.comp_toRingHom] using
                (RingHom.comp_assoc E.algebraMap.toRingHom eDP.toRingHom pDP.toRingHom)
        _ = pDP.toRingHom.comp polyToP := by rw [hEPoly]
        _ = E.algebraMap.toRingHom := hPolyToE
  let e : E.object.carrier ≃+* P :=
    RingEquiv.ofRingHom eDP.toRingHom pDP.toRingHom
      (RingHom.ext fun x => congrArg (fun q => q x) hCompP)
      (RingHom.ext fun x => congrArg (fun q => q x) hCompE)
  refine ⟨e, eDP.isDPMorphism, pDP.isDPMorphism, fun b => ?_, fun i => ?_⟩
  · change eDP.toRingHom (E.algebraMap.toRingHom (MvPolynomial.C b)) = _
    calc
      eDP.toRingHom (E.algebraMap.toRingHom (MvPolynomial.C b)) =
          polyToP (MvPolynomial.C b) := RingHom.congr_fun hEPoly (MvPolynomial.C b)
      _ = coeff.toRingHom (D.algebraMap.toRingHom b) := by simp [polyToP, coeffB]
  · change eDP.toRingHom (E.algebraMap.toRingHom (MvPolynomial.X i)) = _
    calc
      eDP.toRingHom (E.algebraMap.toRingHom (MvPolynomial.X i)) =
          polyToP (MvPolynomial.X i) := RingHom.congr_fun hEPoly (MvPolynomial.X i)
      _ = xvar i := by simp [polyToP]

end Crystalline

end
