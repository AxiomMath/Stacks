module

public import StacksFrontier.AlgebraicGeometry.Crystalline.DividedPowerEnvelope.BaseChangeMap
public import StacksFrontier.AlgebraicGeometry.Crystalline.Support.EnvelopeBaseChange
public import StacksCore.Tactic.StacksAttribute

/-!
# Base change of a divided power envelope along a flat extension

Let `φ : (B, I, γ) → (B', I', γ')` be a morphism of divided power rings whose induced map
`B / I → B' / I'` is flat, let `J ⊆ B` be an ideal containing `I`, and let `J' ⊆ B'` be the
ideal generated by the image of `J` together with `I'`. Then the divided power envelope of `J'`
is the base change along `φ` of the divided power envelope of `J`.

## Main results

* `Crystalline.dividedPowerEnvelope_baseChange_of_flat_quotient` identifies
  `D_B(J) ⊗_B B'` with `D_{B'}(J')`, by a ring equivalence whose value on a pure tensor is the
  product of the canonical map on envelopes with the structural map of the target.

## Implementation notes

The formula on pure tensors specifies the canonical isomorphism rather than asserting that some
unspecified ring equivalence exists, and the flatness assumption is expressed through the
induced homomorphism of the two quotient rings rather than through either ring separately.

The proof presents both envelopes as quotients of divided power polynomial algebras on the
index set `J` — the surjection of `Crystalline.surjectiveDividedPowerPolynomialMap` with the
kernel computed by `Crystalline.ker_surjectiveDividedPowerPolynomialMap` — and then matches the
two kernels using `Crystalline.sourceKernel_map_le_targetKernel` and
`Crystalline.targetKernel_le_sourceKernel_map`. Flatness is what makes those two inclusions
hold.

## References

* [Stacks Project, Tag 07HE](https://stacks.math.columbia.edu/tag/07HE)
-/

@[expose] public section

open scoped TensorProduct

universe u v

namespace Crystalline

open DividedPowers

/-- A divided power envelope commutes with a flat extension modulo the divided
power ideals, provided the target ideal is the extension of the source ideal
plus the target divided power ideal. -/
@[stacks 07HE]
public theorem dividedPowerEnvelope_baseChange_of_flat_quotient
    {B B' : DividedPowerRing.{u}}
    (φ : DividedPowers.DPMorphism B.dividedPowers B'.dividedPowers)
    (J : Ideal B) (J' : Ideal B')
    (hJ : B.ideal.map (RingHom.id B) ≤ J)
    (hJ' : B'.ideal.map (RingHom.id B') ≤ J')
    (hJ'_eq : J' = J.map φ.toRingHom ⊔ B'.ideal)
    (hflat : RingHom.Flat (Ideal.quotientMap B'.ideal φ.toRingHom
      (Ideal.map_le_iff_le_comap.mp φ.ideal_comp)))
    (D : DividedPowerEnvelope B (RingHom.id B) J hJ)
    (D' : DividedPowerEnvelope B' (RingHom.id B') J' hJ') :
    letI : Algebra B D.object := D.algebraMap.toRingHom.toAlgebra
    letI : Algebra B B' := φ.toRingHom.toAlgebra
    ∃ e : (D.object ⊗[B] B') ≃+* D'.object,
      ∀ x y, e (TensorProduct.tmul B x y) =
        (dividedPowerEnvelopeBaseChangeMap φ J J' hJ hJ'
          (by rw [hJ'_eq]; exact le_sup_left) D D').toRingHom x *
          D'.algebraMap.toRingHom y := by
  classical
  let : Algebra B D.object := D.algebraMap.toRingHom.toAlgebra
  let : Algebra B B' := φ.toRingHom.toAlgebra
  let T : Type u := J
  let f : T → B := fun t => t.1
  let f' : T → B' := fun t => φ.toRingHom (f t)
  have hgen : J = B.ideal ⊔ Ideal.span (Set.range f) := by
    apply le_antisymm
    · intro x hx
      exact Ideal.mem_sup_right (Ideal.subset_span ⟨⟨x, hx⟩, rfl⟩)
    · apply sup_le
      · simpa using hJ
      · apply Ideal.span_le.2
        rintro x ⟨t, rfl⟩
        exact t.property
  have hmap : J.map φ.toRingHom ≤ J' := by
    rw [hJ'_eq]
    exact le_sup_left
  have hmapGen : J.map φ.toRingHom = Ideal.span (Set.range f') := by
    apply le_antisymm
    · apply Ideal.map_le_iff_le_comap.mpr
      intro x hx
      apply Ideal.subset_span
      exact ⟨⟨x, hx⟩, rfl⟩
    · apply Ideal.span_le.2
      rintro y ⟨t, rfl⟩
      exact Ideal.mem_map_of_mem φ.toRingHom t.property
  have hgen' : J' = B'.ideal ⊔ Ideal.span (Set.range f') := by
    rw [hJ'_eq, hmapGen, sup_comm]
  let ψData := surjectiveDividedPowerPolynomialMap B T J hJ f hgen D
  let ψ := ψData.1
  let ψ'Data := surjectiveDividedPowerPolynomialMap B' T J' hJ' f' hgen' D'
  let ψ' := ψ'Data.1
  let P := DividedPowerAlgebra B (T →₀ B)
  let P' := DividedPowerAlgebra B' (T →₀ B')
  let α : P →+* P' :=
    (DividedPowerAlgebra.map B'
      (Finsupp.mapRange.linearMap (α := T) (Algebra.linearMap B B'))).toRingHom
  have hαeq : α = polynomialCoefficientChange (T := T) φ := rfl
  let K' := kernelPresentationIdeal B' T f'
  have hker' : RingHom.ker ψ'.toRingHom = K' := by
    simpa [ψ', ψ'Data, K'] using ker_surjectiveDividedPowerPolynomialMap B' T J' hJ' f' hgen' D'
  have hRawEq : Ideal.map α (RingHom.ker ψ.toRingHom) = K' := by
    rw [show RingHom.ker ψ.toRingHom = kernelPresentationIdeal B T f by
      simpa [ψ, ψData] using ker_surjectiveDividedPowerPolynomialMap B T J hJ f hgen D]
    exact le_antisymm (sourceKernel_map_le_targetKernel φ J hflat)
      (targetKernel_le_sourceKernel_map φ J hflat)
  obtain ⟨eRaw, heRaw⟩ := dividedPowerEnvelope_tensor_equiv_quotient B T J hJ f hgen D B'
  let eSource : (D.object ⊗[B] B') ≃+* (P' ⧸ K') := eRaw.trans (Ideal.quotEquivOfEq hRawEq)
  have hSourcePure (p : P) (b' : B') :
      eSource (TensorProduct.tmul B (ψ.toRingHom p) b') =
        Ideal.Quotient.mk K' (α p * algebraMap B' P' b') :=
    (congrArg (Ideal.quotEquivOfEq hRawEq) (heRaw p b')).trans (Ideal.quotEquivOfEq_mk hRawEq _)
  let eTarget : (P' ⧸ K') ≃+* D'.object :=
    (Ideal.quotEquivOfEq hker'.symm).trans
      (RingHom.quotientKerEquivOfSurjective (f := ψ'.toRingHom) ψ'Data.2.2.2)
  have hTargetPure (z : P') : eTarget (Ideal.Quotient.mk K' z) = ψ'.toRingHom z := by
    rw [RingEquiv.trans_apply, Ideal.quotEquivOfEq_mk,
      RingHom.quotientKerEquivOfSurjective_apply_mk]
  have halgMap {A : DividedPowerRing.{u}} {I : Ideal A} {hI}
      (E : DividedPowerEnvelope A (RingHom.id A) I hI) :
      E.algebraMap.toRingHom = E.structureMap.toRingHom := by
    simpa using E.algebraMap_comp
  let a := D'.structureMap.comp φ
  let baseMap := dividedPowerEnvelopeBaseChangeMap φ J J' hJ hJ' hmap D D'
  have hbaseMap : baseMap.comp D.structureMap = a := by
    dsimp [baseMap, dividedPowerEnvelopeBaseChangeMap, a]
    exact ((D.homEquiv D'.object (D'.structureMap.comp φ)).symm
      ⟨IdealPair.Hom.comp D'.algebraMap
        (IdealPair.Hom.ofRingHom φ.toRingHom hmap), by
        have hRing :
            (IdealPair.Hom.comp
                (IdealPair.Hom.comp D'.algebraMap
                  (IdealPair.Hom.ofRingHom φ.toRingHom hmap))
                (IdealPair.Hom.ofRingHom (RingHom.id B) hJ)).toRingHom =
              (IdealPair.Hom.ofDPMorphism (D'.structureMap.comp φ)).toRingHom := by
            ext x
            show D'.algebraMap.toRingHom (φ.toRingHom x) =
              D'.structureMap.toRingHom (φ.toRingHom x)
            rw [halgMap D']
        have hext : ∀ (q r : IdealPair.Hom B.ideal D'.object.ideal),
            q.toRingHom = r.toRingHom → q = r := by
          intro q r h
          cases q
          cases r
          cases h
          rfl
        apply hext
        exact hRing⟩).2
  let coeff :=
    setIndexedDividedPowerPolynomialCoefficientDPMorphism
      B T
  let coeff' :=
    setIndexedDividedPowerPolynomialCoefficientDPMorphism
      B' T
  let αDP := DividedPowers.DPMorphism.mk'
    (polynomialCoefficientChange_isDPMorphism (T := T) φ)
  have hCoeffChange : αDP.comp coeff = coeff'.comp φ := by
    apply DividedPowers.DPMorphism.ext
    funext b
    show (DividedPowerAlgebra.map B'
      (Finsupp.mapRange.linearMap (α := T) (Algebra.linearMap B B')))
        (algebraMap B P b) = algebraMap B' P' (φ.toRingHom b)
    rw [AlgHom.commutes, IsScalarTower.algebraMap_eq B B' P']
    rfl
  have hVarChange (t : T) :
      αDP.toRingHom (dividedPowerPolynomialVariable B t) =
        dividedPowerPolynomialVariable B' t := by
    show DividedPowerAlgebra.map B'
      (Finsupp.mapRange.linearMap (α := T) (Algebra.linearMap B B'))
        (DividedPowerAlgebra.dp B 1 (Finsupp.single t 1)) = _
    rw [DividedPowerAlgebra.map_apply_dp]
    congr 1
    ext s
    by_cases hs : s = t <;> simp [Finsupp.mapRange.linearMap_apply, hs]
  let k : T → D'.object.ideal := fun t =>
    ⟨D'.algebraMap.toRingHom (φ.toRingHom (f t)),
      D'.algebraMap.ideal_comp
        (Ideal.mem_map_of_mem _ (hmap (Ideal.mem_map_of_mem _ t.property)))⟩
  have hUnique :=
    existsUnique_dPMorphism_from_setIndexedDividedPowerPolynomial
      B T D'.object (D'.structureMap.comp φ) k
  have hBaseMapProp :
      ((baseMap.comp ψ).comp coeff = D'.structureMap.comp φ) ∧
        (∀ t : T, (baseMap.comp ψ).toRingHom
          (dividedPowerPolynomialVariable B t) = (k t : D'.object)) := by
    constructor
    · show baseMap.comp (ψ.comp coeff) = _
      rw [ψData.2.1, hbaseMap]
    · intro t
      show baseMap.toRingHom (ψ.toRingHom
        (dividedPowerPolynomialVariable B t)) = _
      rw [show ψ.toRingHom (dividedPowerPolynomialVariable B t) = _ from ψData.2.2.1 t]
      have hb := congrArg (fun g => g.toRingHom (f t)) hbaseMap
      simpa [DividedPowers.DPMorphism.comp_toRingHom, halgMap D, halgMap D', k, a] using hb
  have hPolyProp :
      ((ψ'.comp αDP).comp coeff = D'.structureMap.comp φ) ∧
        (∀ t : T, (ψ'.comp αDP).toRingHom
          (dividedPowerPolynomialVariable B t) = (k t : D'.object)) := by
    constructor
    · show ψ'.comp (αDP.comp coeff) = _
      rw [hCoeffChange]
      show (ψ'.comp coeff').comp φ = _
      rw [ψ'Data.2.1]
    · intro t
      show ψ'.toRingHom (αDP.toRingHom
        (dividedPowerPolynomialVariable B t)) = _
      rw [hVarChange]
      rw [show ψ'.toRingHom (dividedPowerPolynomialVariable B' t) = _ from ψ'Data.2.2.1 t]
  have hcomp : baseMap.comp ψ = ψ'.comp αDP := by
    obtain ⟨g, hg, hUnique⟩ := hUnique
    have hbase := hUnique (baseMap.comp ψ) hBaseMapProp
    have hpoly := hUnique (ψ'.comp αDP) hPolyProp
    exact hbase.trans hpoly.symm
  have hcompApply (p : P) :
      baseMap.toRingHom (ψ.toRingHom p) = ψ'.toRingHom (α p) :=
    congrArg (fun g => g.toRingHom p) hcomp
  have hψ'coeff (b : B') :
      ψ'.toRingHom (algebraMap B' P' b) = D'.algebraMap.toRingHom b := by
    rw [halgMap D']
    exact congrArg (fun g => g.toRingHom b) ψ'Data.2.1
  refine ⟨eSource.trans eTarget, fun x y => ?_⟩
  obtain ⟨p, rfl⟩ := ψData.2.2.2 x
  show eTarget (eSource (TensorProduct.tmul B (ψ.toRingHom p) y)) = _
  rw [hSourcePure, hTargetPure, map_mul, ← hcompApply, hψ'coeff]
  rfl
end Crystalline
