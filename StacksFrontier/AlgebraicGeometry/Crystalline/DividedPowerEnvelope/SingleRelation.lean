/-!
# The divided power envelope of one regular relation

Let `(B, I, γ)` be a divided power ring and let `g ∈ B` be such that `r g ∈ I` forces `r ∈ I`,
that is, multiplication by `g` is injective modulo `I`.  The divided power envelope of the
ideal `I + (g)` is then presented by a single divided power variable: the surjection

`Ψ : B⟨ξ⟩ ⟶ D_{B, γ}(I + (g))`

of Lemma 07HC has kernel the ordinary principal ideal `(ξ - g)`, so that

`D_{B, γ}(I + (g)) = B⟨ξ⟩/(ξ - g)`.

Lemma 07HC presents the kernel as generated by `ξ - g` together with all divided powers
`δ_n(r ξ - r_0)` of the linear relations `r g = r_0` with `r_0 ∈ I`.  The regularity of `g`
makes every such relation a multiple of `ξ - g` by an element `r` of `I`, and then
`δ_n(r (ξ - g)) = (ξ - g)^n δ_n(r)` lies in `(ξ - g)` for `n ≥ 1`; so the extra generators are
redundant and the kernel collapses to `(ξ - g)`.

The case this is designed for is the purely inseparable relation of Tag 07N1: for a prime `p`
and `λ ∈ B` the element `g = z^p - λ` of `B[z]` is monic, hence regular modulo `I B[z]`, and the
conclusion is the identification

`D_{B[z], γ}(I B[z] + (z^p - λ)) = B[z]⟨ξ⟩/(ξ - (z^p - λ))`

of the proof of Tag 07N1 — the step which exhibits the ring `D'` of that lemma as a divided
power envelope and so equips it with divided powers extending those of `B`.

## Main definitions

* `Crystalline.polynomialDividedPowerRing` — the polynomial ring `B[z]` with the unique
  extension of `γ` to the ideal `I B[z]`.
* `Crystalline.envelopeEquivQuotientSingleRelation` — the identification
  `B⟨ξ⟩/(ξ - g) ≃ D_{B, γ}(I + (g))` for a regular `g`.

## Main results

* `Crystalline.kernelPresentationIdeal_unit_eq_span` — for a regular `g`, the kernel ideal of
  Lemma 07HC in one divided power variable is `(ξ - g)`.
* `Crystalline.mem_map_C_of_mul_monic` — a monic polynomial is regular modulo `I B[z]`.
* `Crystalline.ker_presentation_pthRootRelation` — the divided power envelope identification of
  the ring `D'` in the proof of Tag 07N1.

## Implementation notes

The envelope is taken, as in `Crystalline.surjectiveDividedPowerPolynomialMap`, along the
identity of `B`, so that the generating ideal is `I ⊔ (g)` and the divided powers imposed on it
extend `γ`.  The single relation is indexed by `Unit`, which is how the one-variable case of the
`T`-indexed presentation of Lemma 07HC is reached; the sums over `Unit` occurring in the kernel
generators are evaluated with `Finsupp.sum_fintype`.

The divided powers on `I B[z]` exist because `B → B[z]` is flat, and they are unique, so
`Crystalline.polynomialDividedPowerRing` is well defined as a divided power ring; the chosen
structure makes `Polynomial.C` a divided power morphism, which is
`Crystalline.isDPMorphism_C_polynomialDividedPowerRing`.

## References

* [Stacks Project, Lemma 60.2.4, Tag 07HC](https://stacks.math.columbia.edu/tag/07HC)
* [Stacks Project, Lemma 60.25.3, Tag 07N1](https://stacks.math.columbia.edu/tag/07N1)
-/

@[expose] public section

noncomputable section

open DividedPowers

universe u

namespace Crystalline

/-! ### The kernel of a one-variable presentation -/

/-- A finitely supported function on `Unit` has sum given by evaluation at `()`. -/
private theorem sum_unit_eq {R M : Type*} [Zero R] [AddCommMonoid M] (r : Unit →₀ R)
    (f : Unit → R → M) (hf : ∀ i, f i 0 = 0) : r.sum f = f () (r ()) := by
  rw [Finsupp.sum_fintype _ _ hf]
  simp

/-- For `g ∈ B` regular modulo the divided power ideal `I`, the kernel ideal of Lemma 07HC for
the one-variable presentation of the divided power envelope of `I + (g)` is the principal ideal
generated by `ξ - g`: the divided powers of the linear relations are redundant. -/
public theorem kernelPresentationIdeal_unit_eq_span (B : DividedPowerRing.{u})
    (g : (B : Type u)) (hg : ∀ r : (B : Type u), r * g ∈ B.ideal → r ∈ B.ideal) :
    kernelPresentationIdeal B Unit (fun _ ↦ g) =
      Ideal.span {dividedPowerPolynomialVariable (B : Type u) (ι := Unit) () -
        algebraMap (B : Type u) (DividedPowerAlgebra (B : Type u) (Unit →₀ (B : Type u))) g} := by
  classical
  rw [kernelPresentationIdeal, Set.range_unique, Ideal.span_union]
  refine sup_eq_left.mpr (Ideal.span_le.mpr ?_)
  rintro y ⟨n, r, r₀, hn, hr, rfl⟩
  have hs1 := sum_unit_eq r (fun _ a ↦ a * g) (by simp)
  have hrg : r () ∈ B.ideal := hg _ (by rw [← hs1, hr]; exact r₀.2)
  have key : r.sum (fun t a ↦
      algebraMap (B : Type u) (DividedPowerAlgebra (B : Type u) (Unit →₀ (B : Type u))) a *
        dividedPowerPolynomialVariable (B : Type u) t) -
      algebraMap (B : Type u) (DividedPowerAlgebra (B : Type u) (Unit →₀ (B : Type u)))
        (r₀ : (B : Type u)) =
      (dividedPowerPolynomialVariable (B : Type u) (ι := Unit) () -
        algebraMap (B : Type u) (DividedPowerAlgebra (B : Type u) (Unit →₀ (B : Type u))) g) *
        algebraMap (B : Type u) (DividedPowerAlgebra (B : Type u) (Unit →₀ (B : Type u)))
          (r ()) := by
    rw [sum_unit_eq _ _ (by simp), show (r₀ : (B : Type u)) = r () * g by rw [← hr, hs1]]
    simp only [map_mul]
    ring
  rw [key, (setIndexedDividedPowerPolynomialDividedPowers B Unit).dpow_mul
    (coefficient_mem_polynomialIdeal B hrg)]
  obtain ⟨m, rfl⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  exact Ideal.mem_span_singleton.mpr
    ⟨(dividedPowerPolynomialVariable (B : Type u) (ι := Unit) () -
        algebraMap (B : Type u) (DividedPowerAlgebra (B : Type u) (Unit →₀ (B : Type u))) g) ^ m *
      (setIndexedDividedPowerPolynomialDividedPowers B Unit).dpow (m + 1)
        (algebraMap (B : Type u) (DividedPowerAlgebra (B : Type u) (Unit →₀ (B : Type u)))
          (r ())), by ring⟩

/-- For `g` regular modulo the divided power ideal, the kernel of the one-variable divided power
polynomial presentation of the envelope of `I + (g)` is the principal ideal `(ξ - g)`. -/
public theorem ker_presentation_eq_span_of_regular (B : DividedPowerRing.{u})
    (g : (B : Type u)) (hg : ∀ r : (B : Type u), r * g ∈ B.ideal → r ∈ B.ideal)
    (J : Ideal (B : Type u)) (hJ : B.ideal.map (RingHom.id (B : Type u)) ≤ J)
    (hf : J = B.ideal ⊔ Ideal.span (Set.range (fun _ : Unit ↦ g)))
    (D : DividedPowerEnvelope B (RingHom.id (B : Type u)) J hJ) :
    RingHom.ker (surjectiveDividedPowerPolynomialMap B Unit J hJ (fun _ ↦ g) hf D).1.toRingHom =
      Ideal.span {dividedPowerPolynomialVariable (B : Type u) (ι := Unit) () -
        algebraMap (B : Type u) (DividedPowerAlgebra (B : Type u) (Unit →₀ (B : Type u))) g} :=
  (ker_surjectiveDividedPowerPolynomialMap B Unit J hJ (fun _ ↦ g) hf D).trans
    (kernelPresentationIdeal_unit_eq_span B g hg)

/-- The divided power envelope of `I + (g)` for a regular `g` is the quotient of the divided
power polynomial ring in one variable by the single ordinary relation `ξ = g`. -/
public def envelopeEquivQuotientSingleRelation (B : DividedPowerRing.{u})
    (g : (B : Type u)) (hg : ∀ r : (B : Type u), r * g ∈ B.ideal → r ∈ B.ideal)
    (J : Ideal (B : Type u)) (hJ : B.ideal.map (RingHom.id (B : Type u)) ≤ J)
    (hf : J = B.ideal ⊔ Ideal.span (Set.range (fun _ : Unit ↦ g)))
    (D : DividedPowerEnvelope B (RingHom.id (B : Type u)) J hJ) :
    (DividedPowerAlgebra (B : Type u) (Unit →₀ (B : Type u)) ⧸
        Ideal.span {dividedPowerPolynomialVariable (B : Type u) (ι := Unit) () -
          algebraMap (B : Type u) (DividedPowerAlgebra (B : Type u) (Unit →₀ (B : Type u)))
            g}) ≃+* (D.object : Type u) :=
  (Ideal.quotEquivOfEq (ker_presentation_eq_span_of_regular B g hg J hJ hf D).symm).trans
    (RingHom.quotientKerEquivOfSurjective
      (surjectiveDividedPowerPolynomialMap B Unit J hJ (fun _ ↦ g) hf D).2.2.2)

/-! ### Monic relations over a polynomial ring -/

/-- A monic polynomial is a regular element modulo the ideal generated by an ideal of the
coefficient ring: if `r q` has all coefficients in `I` and `q` is monic, then so does `r`. -/
public theorem mem_map_C_of_mul_monic {R : Type u} [CommRing R] (I : Ideal R)
    {q r : Polynomial R} (hq : q.Monic) (h : r * q ∈ I.map Polynomial.C) :
    r ∈ I.map (Polynomial.C : R →+* Polynomial R) := by
  have hker : Ideal.map (Polynomial.C : R →+* Polynomial R) I =
      RingHom.ker (Polynomial.mapRingHom (Ideal.Quotient.mk I)) := by
    rw [Polynomial.ker_mapRingHom, Ideal.mk_ker]
  rw [hker, RingHom.mem_ker] at h ⊢
  by_contra hr
  exact (hq.map (Ideal.Quotient.mk I)).mul_left_ne_zero hr
    (by simpa [Polynomial.map_mul] using h)

/-- The polynomial ring is flat over its coefficient ring, which is the criterion under which
divided powers extend along `B → B[z]`. -/
public theorem polynomialExtensionCriterion (B : DividedPowerRing.{u}) :
    (B.ideal.map (Polynomial.C : (B : Type u) →+* Polynomial (B : Type u)) = ⊥) ∨
      B.ideal.IsPrincipal ∨
      (Polynomial.C : (B : Type u) →+* Polynomial (B : Type u)).Flat :=
  Or.inr (Or.inr (by
    rw [← Polynomial.algebraMap_eq, RingHom.flat_algebraMap_iff]
    infer_instance))

/-- The polynomial ring `B[z]` over a divided power ring, with the unique extension of its
divided powers to the ideal `I B[z]`. -/
public abbrev polynomialDividedPowerRing (B : DividedPowerRing.{u}) : DividedPowerRing.{u} :=
  DividedPowerRing.of (Polynomial (B : Type u))
    (B.ideal.map (Polynomial.C : (B : Type u) →+* Polynomial (B : Type u)))
    (B.extendedDividedPowersOfMapEqBotOrIsPrincipalOrFlat
      (Polynomial.C : (B : Type u) →+* Polynomial (B : Type u))
      (polynomialExtensionCriterion B))

/-- The chosen divided powers on `I B[z]` make `B → B[z]` a divided power morphism, so they do
extend the divided powers of `B`. -/
public theorem isDPMorphism_C_polynomialDividedPowerRing (B : DividedPowerRing.{u}) :
    DividedPowers.IsDPMorphism B.dividedPowers (polynomialDividedPowerRing B).dividedPowers
      (Polynomial.C : (B : Type u) →+* Polynomial (B : Type u)) :=
  B.isDPMorphism_extendedDividedPowersOfMapEqBotOrIsPrincipalOrFlat
    (Polynomial.C : (B : Type u) →+* Polynomial (B : Type u))
    (polynomialExtensionCriterion B)

/-! ### The purely inseparable relation of Tag 07N1 -/

/-- **The divided power envelope identification of the proof of Tag 07N1.**  For a divided power
ring `(B, I, γ)`, an exponent `p ≠ 0` and `λ ∈ B`, the kernel of the one-variable divided power
polynomial presentation `B[z]⟨ξ⟩ ↠ D_{B[z], γ}(I B[z] + (z^p - λ))` is the principal ideal
generated by `ξ - (z^p - λ)`.  Equivalently, the ring `D[z]⟨ξ⟩/(ξ - (z^p - λ))` of Tag 07N1 is
the divided power envelope of the ideal generated by `z^p - λ` in `D[z]`, which is what equips
it with divided powers extending those of `D` and, through Lemma 07HW, supplies assumption
(07Q1) for it.

This is a step inside the proof of Tag 07N1 and carries no tag of its own: the conclusion of
that lemma — the existence of `e_M^•` with both composites homotopic to multiplication by `p` —
is `Crystalline.exists_homotopyInverse_pthRootExtension` in
`StacksFrontier.AlgebraicGeometry.Crystalline.Differentials.PurelyInseparablePullback`, which is
where the tag sits.  The kernel computation itself is the regular-element case of the general
kernel description of Lemma 07HC, which is tagged in
`StacksFrontier.AlgebraicGeometry.Crystalline.DividedPowerEnvelope.PresentationKernel`. -/
public theorem ker_presentation_pthRootRelation (B : DividedPowerRing.{u}) (p : ℕ) (hp : p ≠ 0)
    (lam : (B : Type u)) (J : Ideal (Polynomial (B : Type u)))
    (hJ : (polynomialDividedPowerRing B).ideal.map
      (RingHom.id (Polynomial (B : Type u))) ≤ J)
    (hf : J = (polynomialDividedPowerRing B).ideal ⊔
      Ideal.span (Set.range (fun _ : Unit ↦ Polynomial.X ^ p - Polynomial.C lam)))
    (D : DividedPowerEnvelope (polynomialDividedPowerRing B)
      (RingHom.id (Polynomial (B : Type u))) J hJ) :
    RingHom.ker (surjectiveDividedPowerPolynomialMap (polynomialDividedPowerRing B) Unit J hJ
        (fun _ ↦ Polynomial.X ^ p - Polynomial.C lam) hf D).1.toRingHom =
      Ideal.span {dividedPowerPolynomialVariable (Polynomial (B : Type u)) (ι := Unit) () -
        algebraMap (Polynomial (B : Type u))
          (DividedPowerAlgebra (Polynomial (B : Type u)) (Unit →₀ Polynomial (B : Type u)))
          (Polynomial.X ^ p - Polynomial.C lam)} :=
  ker_presentation_eq_span_of_regular (polynomialDividedPowerRing B)
    (Polynomial.X ^ p - Polynomial.C lam)
    (fun _ h ↦ mem_map_C_of_mul_monic B.ideal (Polynomial.monic_X_pow_sub_C lam hp) h)
    J hJ hf D

/-- The ring `D' = D[z]⟨ξ⟩/(ξ - (z^p - λ))` of Tag 07N1 as a divided power envelope: the
quotient of `D[z]⟨ξ⟩` by the single relation `ξ = z^p - λ` is the divided power envelope of the
ideal generated by `z^p - λ` in `D[z]`. -/
public def pthRootRelationEnvelopeEquiv (B : DividedPowerRing.{u}) (p : ℕ) (hp : p ≠ 0)
    (lam : (B : Type u)) (J : Ideal (Polynomial (B : Type u)))
    (hJ : (polynomialDividedPowerRing B).ideal.map
      (RingHom.id (Polynomial (B : Type u))) ≤ J)
    (hf : J = (polynomialDividedPowerRing B).ideal ⊔
      Ideal.span (Set.range (fun _ : Unit ↦ Polynomial.X ^ p - Polynomial.C lam)))
    (D : DividedPowerEnvelope (polynomialDividedPowerRing B)
      (RingHom.id (Polynomial (B : Type u))) J hJ) :
    (DividedPowerAlgebra (Polynomial (B : Type u)) (Unit →₀ Polynomial (B : Type u)) ⧸
        Ideal.span {dividedPowerPolynomialVariable (Polynomial (B : Type u)) (ι := Unit) () -
          algebraMap (Polynomial (B : Type u))
            (DividedPowerAlgebra (Polynomial (B : Type u)) (Unit →₀ Polynomial (B : Type u)))
            (Polynomial.X ^ p - Polynomial.C lam)}) ≃+* (D.object : Type u) :=
  envelopeEquivQuotientSingleRelation (polynomialDividedPowerRing B)
    (Polynomial.X ^ p - Polynomial.C lam)
    (fun _ h ↦ mem_map_C_of_mul_monic B.ideal (Polynomial.monic_X_pow_sub_C lam hp) h)
    J hJ hf D

end Crystalline

end

