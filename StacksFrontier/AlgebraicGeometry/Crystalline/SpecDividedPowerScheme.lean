/-!
# `Spec` of a divided power ring, as a divided power scheme

Let `(A, I, γ)` be a divided power ring.  This file builds the divided power scheme
`Spec (A, I, γ)`: the scheme `Spec A`, the quasi-coherent ideal generated by `I`, and a divided
power structure on that ideal whose value on an affine open `U` is an extension of `γ` along the
flat structure map `A → Γ(Spec A, U)`.  It also proves that compatibility of a morphism of schemes
with two divided power structures may be checked on affine opens alone.

## Main definitions

* `Crystalline.DividedPowerScheme.dividedPowerStructureOfBasis`: divided powers on a
  quasi-coherent ideal subsheaf, extended from a compatible family on a basis of opens.
* `Crystalline.DividedPowerScheme.dividedPowerStructureOfAffineSections`: divided powers on a
  quasi-coherent ideal subsheaf of `X`, extended from a divided power ring `A` mapping to
  `Γ(X, ⊤)` flatly on each affine open.
* `Crystalline.DividedPowerScheme.idealSheafAsSubmodule`: quasi-coherent ideal sheaf data, read
  as a submodule of the structure sheaf.
* `Crystalline.DividedPowerScheme.specDividedPowerIdeal`,
  `Crystalline.DividedPowerScheme.specDividedPowerStructure` and
  `Crystalline.DividedPowerScheme.specDividedPowerScheme`: the ideal, the divided power
  structure and the divided power scheme `Spec (A, I, γ)`.
* `Crystalline.DividedPowerScheme.toSpecDividedPowerScheme`: the morphism to `Spec (A, I, γ)`
  induced by a divided power homomorphism `A ⟶ Γ(T, ⊤)`.

## Main results

* `Crystalline.DividedPowerScheme.isDPMorphism_app_of_affine`: a morphism of schemes between the
  ambient schemes of two divided power schemes is compatible with the divided powers on every
  open as soon as it is compatible on every pair of affine opens.
* `Crystalline.DividedPowerScheme.specDividedPowerScheme_isDPMorphism`: the structure map
  `A → Γ(Spec A, U)` is a divided power homomorphism for every affine open `U`.
* `Crystalline.DividedPowerScheme.specDividedPowerHomEquiv`: morphisms of divided power schemes
  `T ⟶ Spec (A, I, γ)` are divided power homomorphisms `A ⟶ Γ(T, ⊤)`.

## Implementation notes

Divided powers extend along a flat ring map [Stacks, Tag 07H1]; this is
`DividedPowers.DividedPowerRing.extendedDividedPowersOfMapEqBotOrIsPrincipalOrFlat`.

The divided power structure on `Spec (A, I, γ)` is **a choice, not a canonical construction**: on
each affine open it is the extension of `γ` produced by
`DividedPowers.DividedPowerRing.extendedDividedPowersOfMapEqBotOrIsPrincipalOrFlat`, and that
extension is unique only under extra hypotheses.  On `⊤` it does restrict to `γ` itself, which is
what `specDividedPowerSchemeUnit` records.

## References

* [Stacks Project, Tag 07H1](https://stacks.math.columbia.edu/tag/07H1)
* [Stacks Project, Tag 07H5](https://stacks.math.columbia.edu/tag/07H5)
* [Stacks Project, Tag 07ME](https://stacks.math.columbia.edu/tag/07ME)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open RingedSpaceModuleAdjunction Opposite
open scoped AlgebraicGeometry

universe u

noncomputable section

namespace Crystalline.DividedPowerScheme

attribute [local implicit_reducible] dividedPowersOfSeparatingFamily

attribute [local implicit_reducible] idealTypeSheaf

section Basis

open TopologicalSpace

variable (X : Scheme.{u}) (I : (SheafOfModules.unit X.ringCatSheaf).Submodule)
  {ι : Type u} (B : ι → X.Opens) (hB : Opens.IsBasis (Set.range B))
  (δ : ∀ k, DividedPowers (Crystalline.sectionIdeal X.sheaf I (op (B k))))
  (hδ : ∀ a b (f : B b ⟶ B a),
    DividedPowers.IsDPMorphism (δ a) (δ b) (X.presheaf.map f.op).hom)

open TopologicalSpace in
/-- The `n+1`-st divided power of the basis family, as an endomorphism of the
ideal sheaf restricted to the basis. -/
def basisDpowRestricted (n : ℕ) :
    (inducedFunctor B).op ⋙ (idealTypeSheaf X I).obj ⟶
      (inducedFunctor B).op ⋙ (idealTypeSheaf X I).obj where
  app k := TypeCat.ofHom fun x => ⟨(δ k.unop).dpow (n + 1) x.val,
    (δ k.unop).dpow_mem (Nat.succ_ne_zero n) x.property⟩
  naturality := by
    intro a b f
    ext x
    apply Subtype.ext
    exact ((hδ a.unop b.unop ((inducedFunctor B).map f.unop)).map_dpow
      x.property).symm

open TopologicalSpace in
/-- The `n+1`-st divided power of the basis family, extended to the whole ideal sheaf. -/
def basisDpowHom (n : ℕ) : (idealTypeSheaf X I).obj ⟶ (idealTypeSheaf X I).obj :=
  TopCat.Sheaf.restrictHomEquivHom (idealTypeSheaf X I).obj (idealTypeSheaf X I) hB
    (basisDpowRestricted X I B δ hδ n)

open TopologicalSpace in
/-- On a basic open `B k`, the extended divided power endomorphism agrees with the basis family. -/
theorem basisDpowHom_app (n : ℕ) (k : ι) (x : I.obj (op (B k))) :
    (basisDpowHom X I B hB δ hδ n).app (op (B k)) x =
      (basisDpowRestricted X I B δ hδ n).app (op k) x :=
  ConcreteCategory.congr_hom (TopCat.Sheaf.extend_hom_app (idealTypeSheaf X I).obj
    (idealTypeSheaf X I) hB (basisDpowRestricted X I B δ hδ n) k) x

open TopologicalSpace in
/-- The divided power operations on the sections over an arbitrary open, obtained
by extending the basis family across the ideal sheaf. -/
def basisDpow (U : X.Opens) (n : ℕ) (x : Γ(X, U)) : Γ(X, U) :=
  have : Decidable (x ∈ I.obj (op U)) := Classical.dec _
  if hx : x ∈ I.obj (op U) then
    match n with
    | 0 => 1
    | n + 1 => ((basisDpowHom X I B hB δ hδ n).app (op U) ⟨x, hx⟩).val
  else 0

open TopologicalSpace in
/-- The divided powers `basisDpow` of a section outside the ideal vanish. -/
theorem basisDpow_of_notMem (U : X.Opens) (n : ℕ) (x : Γ(X, U)) (hx : x ∉ I.obj (op U)) :
    basisDpow X I B hB δ hδ U n x = 0 := by
  simp [basisDpow, hx]

open TopologicalSpace in
/-- The zeroth divided power `basisDpow` of a section of the ideal is `1`. -/
theorem basisDpow_zero (U : X.Opens) (x : Γ(X, U)) (hx : x ∈ I.obj (op U)) :
    basisDpow X I B hB δ hδ U 0 x = 1 := by
  simp only [basisDpow, dite_eq_left hx]

open TopologicalSpace in
/-- The `n+1`-st divided power `basisDpow` of a section of the ideal is the value of
`basisDpowHom` at that section. -/
theorem basisDpow_succ (U : X.Opens) (n : ℕ) (x : Γ(X, U)) (hx : x ∈ I.obj (op U)) :
    basisDpow X I B hB δ hδ U (n + 1) x =
      ((basisDpowHom X I B hB δ hδ n).app (op U) ⟨x, hx⟩).val := by
  simp only [basisDpow]
  exact dite_eq_left hx

open TopologicalSpace in
/-- Restricting `basisDpow` from `U` to a basic open `B k ⊆ U` gives the divided power `δ k` of
the restricted section. -/
theorem basisDpow_map (U : X.Opens) (n : ℕ) (x : Γ(X, U)) (hx : x ∈ I.obj (op U))
    (k : ι) (hk : B k ≤ U) :
    X.presheaf.map (homOfLE hk).op (basisDpow X I B hB δ hδ U n x) =
      (δ k).dpow n (X.presheaf.map (homOfLE hk).op x) := by
  cases n with
  | zero =>
    rw [basisDpow_zero X I B hB δ hδ U x hx, map_one]
    exact ((δ k).dpow_zero (I.map_mem (homOfLE hk).op hx)).symm
  | succ n =>
    have hb' := congrArg Subtype.val (ConcreteCategory.congr_hom
      ((basisDpowHom X I B hB δ hδ n).naturality (homOfLE hk).op) ⟨x, hx⟩)
    change ((basisDpowHom X I B hB δ hδ n).app (op (B k))
        ((idealTypeSheaf X I).obj.map (homOfLE hk).op ⟨x, hx⟩)).val =
      X.presheaf.map (homOfLE hk).op
        ((basisDpowHom X I B hB δ hδ n).app (op U) ⟨x, hx⟩).val at hb'
    have he := congrArg Subtype.val (basisDpowHom_app X I B hB δ hδ n k
      ((idealTypeSheaf X I).obj.map (homOfLE hk).op ⟨x, hx⟩))
    change ((basisDpowHom X I B hB δ hδ n).app (op (B k))
        ((idealTypeSheaf X I).obj.map (homOfLE hk).op ⟨x, hx⟩)).val =
      (δ k).dpow (n + 1) (X.presheaf.map (homOfLE hk).op x) at he
    rw [basisDpow_succ X I B hB δ hδ U n x hx]
    exact hb'.symm.trans he

open TopologicalSpace in
/-- The divided power structure on the sections over an open, built from the basis family. -/
def basisDividedPowersOn (U : X.Opens) :
    DividedPowers (Crystalline.sectionIdeal X.sheaf I (op U)) :=
  dividedPowersOfSeparatingFamily _
    (fun k : {k : ι // B k ≤ U} => Crystalline.sectionIdeal X.sheaf I (op (B k.val)))
    (fun k => δ k.val)
    (fun k => (X.presheaf.map (homOfLE k.property).op).hom)
    (fun _ _ h => section_ext_basis X B hB (fun k hk => h ⟨k, hk⟩))
    (fun x => ⟨fun hx k => I.map_mem (homOfLE k.property).op hx,
      fun hx => (mem_ideal_basis X I B hB x).mpr (fun k hk => hx ⟨k, hk⟩)⟩)
    (basisDpow X I B hB δ hδ U) (basisDpow_of_notMem X I B hB δ hδ U)
    (fun n x hx k => basisDpow_map X I B hB δ hδ U n x hx k.val k.property)

open TopologicalSpace in
/-- The divided powers of `basisDividedPowersOn` are given by `basisDpow`. -/
theorem basisDividedPowersOn_dpow (U : X.Opens) (n : ℕ) (x : Γ(X, U)) :
    (basisDividedPowersOn X I B hB δ hδ U).dpow n x = basisDpow X I B hB δ hδ U n x :=
  rfl

open TopologicalSpace in
/-- Compatible divided powers on a basis extend to the ideal sheaf. -/
def dividedPowerStructureOfBasis : Crystalline.DividedPowerStructure.{u, u, u} X.sheaf I where
  dividedPowers U := basisDividedPowersOn X I B hB δ hδ U.unop
  naturality := by
    intro U V f
    refine ⟨Ideal.map_le_iff_le_comap.mpr (fun x hx => I.map_mem f hx), ?_⟩
    intro n x hx
    apply section_ext_basis X B hB
    intro k hk
    have hUf : B k ≤ U.unop := hk.trans (leOfHom f.unop)
    have hxV : X.presheaf.map f x ∈ I.obj V := I.map_mem f hx
    change X.presheaf.map (homOfLE hk).op
        (basisDpow X I B hB δ hδ V.unop n (X.presheaf.map f x)) =
      X.presheaf.map (homOfLE hk).op
        (X.presheaf.map f (basisDpow X I B hB δ hδ U.unop n x))
    rw [basisDpow_map X I B hB δ hδ _ _ _ hxV]
    simp only [← CommRingCat.comp_apply, ← Functor.map_comp]
    have he' : X.presheaf.map (homOfLE hk).op (X.presheaf.map f x) =
        X.presheaf.map (homOfLE hUf).op x :=
      (ConcreteCategory.congr_hom (X.presheaf.map_comp f (homOfLE hk).op) x).symm.trans
        (congrArg (fun m => X.presheaf.map m x)
          (Subsingleton.elim (f ≫ (homOfLE hk).op) (homOfLE hUf).op))
    rw [he']
    exact (basisDpow_map X I B hB δ hδ U.unop n x hx k hUf).symm

open TopologicalSpace in
/-- On a basic open `B k`, the divided power structure `dividedPowerStructureOfBasis` is `δ k`. -/
theorem dividedPowerStructureOfBasis_dividedPowers (k : ι) :
    (dividedPowerStructureOfBasis X I B hB δ hδ).dividedPowers (op (B k)) = δ k := by
  apply DividedPowers.ext
  intro n x hx
  have hm := basisDpow_map X I B hB δ hδ (B k) n x hx k le_rfl
  show basisDpow X I B hB δ hδ (B k) n x = (δ k).dpow n x
  have he (y : Γ(X, B k)) : X.presheaf.map (homOfLE le_rfl).op y = y := by
    rw [show (homOfLE (le_rfl : B k ≤ B k)).op = 𝟙 (op (B k)) from Subsingleton.elim _ _,
      X.presheaf.map_id]
    exact CategoryTheory.id_apply y
  simp only [he] at hm
  apply Eq.trans hm
  congr 1
  exact he x

end Basis

/-- Divided powers transported along an equality of ideals. -/
def dividedPowersOfEq {R : Type*} [CommSemiring R] {I J : Ideal R} (h : I = J)
    (γ : DividedPowers I) : DividedPowers J := h ▸ γ

/-- A divided power morphism into `δ` remains one into `δ` transported along an equality of
ideals. -/
theorem isDPMorphism_dividedPowersOfEq
    {R S : Type*} [CommSemiring R] [CommSemiring S] {I : Ideal R} {J K : Ideal S}
    (h : J = K) (γ : DividedPowers I) (δ : DividedPowers J) (φ : R →+* S)
    (hd : DividedPowers.IsDPMorphism γ δ φ) :
    DividedPowers.IsDPMorphism γ (dividedPowersOfEq h δ) φ := by
  subst h
  exact hd

section AffineSections

open TopologicalSpace

variable (A : DividedPowerRing.{u}) (X : Scheme.{u})
  (I : (SheafOfModules.unit X.ringCatSheaf).Submodule) (ρ : A →+* Γ(X, ⊤))
  (hflat : ∀ U : X.affineOpens,
    ((X.presheaf.map (homOfLE (show U.1 ≤ ⊤ from le_top)).op).hom.comp ρ).Flat)
  (hI : ∀ U : X.affineOpens,
    A.ideal.map ((X.presheaf.map (homOfLE (show U.1 ≤ ⊤ from le_top)).op).hom.comp ρ) =
      Crystalline.sectionIdeal X.sheaf I (op U.1))

/-- The chosen extension of `A`'s divided powers to the sections on an affine open, along the
flat structure map. See `DividedPowerRing.extendedDividedPowersOfMapEqBotOrIsPrincipalOrFlat`;
the extension exists by Tag 07H1 but is not canonical. -/
def affineSectionsDividedPowers (U : X.affineOpens) :
    DividedPowers (Crystalline.sectionIdeal X.sheaf I (op U.1)) :=
  dividedPowersOfEq (hI U)
    (DividedPowers.DividedPowerRing.extendedDividedPowersOfMapEqBotOrIsPrincipalOrFlat A
      ((X.presheaf.map (homOfLE (show U.1 ≤ ⊤ from le_top)).op).hom.comp ρ)
      (Or.inr (Or.inr (hflat U))))

/-- The map `A → Γ(X, U)` is a divided power morphism into `affineSectionsDividedPowers` on an
affine open `U`. -/
theorem affineSectionsDividedPowers_isDPMorphism (U : X.affineOpens) :
    DividedPowers.IsDPMorphism A.dividedPowers
      (affineSectionsDividedPowers A X I ρ hflat hI U)
      ((X.presheaf.map (homOfLE (show U.1 ≤ ⊤ from le_top)).op).hom.comp ρ) :=
  isDPMorphism_dividedPowersOfEq (hI U) _ _ _
    (DividedPowers.DividedPowerRing.isDPMorphism_extendedDividedPowersOfMapEqBotOrIsPrincipalOrFlat
      A ((X.presheaf.map (homOfLE (show U.1 ≤ ⊤ from le_top)).op).hom.comp ρ)
      (Or.inr (Or.inr (hflat U))))

/-- For affine opens `V ⊆ U`, restriction `Γ(X, U) → Γ(X, V)` is a divided power morphism for
`affineSectionsDividedPowers`. -/
theorem affineSectionsDividedPowers_naturality (U V : X.affineOpens) (f : V.1 ⟶ U.1) :
    DividedPowers.IsDPMorphism (affineSectionsDividedPowers A X I ρ hflat hI U)
      (affineSectionsDividedPowers A X I ρ hflat hI V) (X.presheaf.map f.op).hom := by
  apply DividedPowers.IsDPMorphism.of_comp (hI := A.dividedPowers)
    (f := (X.presheaf.map (homOfLE (show U.1 ≤ ⊤ from le_top)).op).hom.comp ρ)
  · exact (hI U).symm
  · exact affineSectionsDividedPowers_isDPMorphism A X I ρ hflat hI U
  · have hr : (X.presheaf.map f.op).hom.comp
        ((X.presheaf.map (homOfLE (show U.1 ≤ ⊤ from le_top)).op).hom.comp ρ) =
        ((X.presheaf.map (homOfLE (show V.1 ≤ ⊤ from le_top)).op).hom.comp ρ) := by
      rw [← RingHom.comp_assoc, ← CommRingCat.hom_comp, ← Functor.map_comp]
      rfl
    exact hr ▸ affineSectionsDividedPowers_isDPMorphism A X I ρ hflat hI V

/-- Flat affine extension globalizes `A`'s divided powers across the ideal sheaf. -/
def dividedPowerStructureOfAffineSections :
    Crystalline.DividedPowerStructure.{u, u, u} X.sheaf I :=
  dividedPowerStructureOfBasis X I (fun U : X.affineOpens => U.1)
    (by simpa using X.isBasis_affineOpens) (affineSectionsDividedPowers A X I ρ hflat hI)
    (affineSectionsDividedPowers_naturality A X I ρ hflat hI)

/-- The map `A → Γ(X, U)` is a divided power morphism into
`dividedPowerStructureOfAffineSections` on every affine open `U`. -/
theorem dividedPowerStructureOfAffineSections_isDPMorphism (U : X.affineOpens) :
    DividedPowers.IsDPMorphism A.dividedPowers
      ((dividedPowerStructureOfAffineSections A X I ρ hflat hI).dividedPowers (op U.1))
      ((X.presheaf.map (homOfLE (show U.1 ≤ ⊤ from le_top)).op).hom.comp ρ) := by
  have he : (dividedPowerStructureOfAffineSections A X I ρ hflat hI).dividedPowers (op U.1) =
      affineSectionsDividedPowers A X I ρ hflat hI U :=
    dividedPowerStructureOfBasis_dividedPowers X I (fun U : X.affineOpens => U.1)
    (by simpa using X.isBasis_affineOpens) (affineSectionsDividedPowers A X I ρ hflat hI)
    (affineSectionsDividedPowers_naturality A X I ρ hflat hI) U
  rw [he]
  exact affineSectionsDividedPowers_isDPMorphism A X I ρ hflat hI U

end AffineSections

open TopologicalSpace in
/-- **Compatibility with divided powers is local on affine opens of both schemes.**  Given two
divided power schemes `X`, `Y` and a morphism `f : X.scheme ⟶ Y.scheme` of the ambient schemes,
if `f` is a divided power morphism on every pair of affine opens `W ⊆ f⁻¹(V)` then it is one on
every open `U` of `Y`. -/
theorem isDPMorphism_app_of_affine
    (X Y : Crystalline.DividedPowerScheme.{u}) (f : X.scheme ⟶ Y.scheme)
    (hf : ∀ (V : Y.scheme.affineOpens) (W : X.scheme.affineOpens)
      (h : W.1 ≤ f ⁻¹ᵁ V.1),
      DividedPowers.IsDPMorphism (Y.dividedPowers.dividedPowers (op V.1))
        (X.dividedPowers.dividedPowers (op W.1)) (f.appLE V.1 W.1 h).hom)
    (U : Y.scheme.Opens) :
    DividedPowers.IsDPMorphism (Y.dividedPowers.dividedPowers (op U))
      (X.dividedPowers.dividedPowers (op (f ⁻¹ᵁ U))) (f.app U).hom := by
  have hloc (z : X.scheme) (hz : z ∈ f ⁻¹ᵁ U) :
      ∃ (W : X.scheme.affineOpens) (hWU : W.1 ≤ f ⁻¹ᵁ U), z ∈ W.1 ∧
        DividedPowers.IsDPMorphism (Y.dividedPowers.dividedPowers (op U))
          (X.dividedPowers.dividedPowers (op W.1)) (f.appLE U W.1 hWU).hom := by
    obtain ⟨V, hV, hzV, hVU⟩ := Opens.isBasis_iff_nbhd.mp Y.scheme.isBasis_affineOpens hz
    obtain ⟨W, hW, hzW, hWV⟩ := Opens.isBasis_iff_nbhd.mp
      X.scheme.isBasis_affineOpens (U := f ⁻¹ᵁ V) (x := z) hzV
    refine ⟨⟨W, hW⟩, hWV.trans ((Opens.map f.base).map (homOfLE hVU)).le, hzW, ?_⟩
    rw [← f.map_appLE hWV (homOfLE hVU).op]
    exact DividedPowers.IsDPMorphism.comp (X.dividedPowers.dividedPowers (op W))
      (hf ⟨V, hV⟩ ⟨W, hW⟩ hWV) (Y.dividedPowers.naturality (homOfLE hVU).op)
  have hmem (x : Γ(Y.scheme, U))
      (hx : x ∈ Crystalline.sectionIdeal Y.scheme.sheaf Y.ideal (op U)) :
      f.app U x ∈ X.ideal.obj (op (f ⁻¹ᵁ U)) := by
    apply X.ideal.isSheaf (f.app U x)
    intro z hz
    obtain ⟨W, hWU, hzW, hW⟩ := hloc z hz
    exact ⟨W.1, homOfLE hWU, hW.ideal_comp (Ideal.mem_map_of_mem _ hx), hzW⟩
  refine ⟨Ideal.map_le_iff_le_comap.mpr fun x hx => hmem x hx, ?_⟩
  intro n x hx
  apply TopCat.Presheaf.IsSheaf.section_ext X.scheme.sheaf.property
  intro z hz
  obtain ⟨W, hWU, hzW, hW⟩ := hloc z hz
  refine ⟨W.1, hWU, hzW, ?_⟩
  exact ((X.dividedPowers.naturality (homOfLE hWU).op).map_dpow (n := n) (hmem x hx)).trans
    (hW.map_dpow (n := n) hx).symm

/-! ### Ideal sheaf data as a submodule of the structure sheaf -/

/-- Quasi-coherent ideal sheaf data, read as a submodule of the structure sheaf. -/
abbrev idealSheafAsSubmodule {X : Scheme.{u}} (I : X.IdealSheafData) :
    (SheafOfModules.unit X.ringCatSheaf).Submodule :=
  I.unitSubmodule

/-- On an affine open, the conversion recovers the ideal in the ideal-sheaf data. -/
theorem idealSheafAsSubmodule_obj_affine {X : Scheme.{u}}
    (I : X.IdealSheafData) (U : X.affineOpens) :
    (idealSheafAsSubmodule I).toSubmodule.obj (op U.1) = I.ideal U :=
  I.unitSubmodule_obj_affine U

/-- The embedded ideal associated to ideal-sheaf data is quasi-coherent. -/
theorem idealSheafAsSubmodule_isQuasicoherent {X : Scheme.{u}} (I : X.IdealSheafData) :
    (idealSheafAsSubmodule I).toSheafOfModules.IsQuasicoherent :=
  I.unitSubmodule_isQuasicoherent

/-! ### `Spec` of a divided power ring -/

/-- The canonical homomorphism from a ring to sections of its spectrum. -/
abbrev specSectionHom
    (A : DividedPowerRing.{u}) (U : (Spec (CommRingCat.of A)).Opens) :
    A →+* Γ(Spec (CommRingCat.of A), U) :=
  ((Spec (CommRingCat.of A)).presheaf.map (homOfLE le_top).op).hom.comp
    (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom

/-- The quasi-coherent ideal on the spectrum of a divided-power ring. -/
abbrev specDividedPowerIdeal (A : DividedPowerRing.{u}) :=
  idealSheafAsSubmodule (Scheme.IdealSheafData.ofIdealTop
    (A.ideal.map (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom))

/-- On an affine open `U` of `Spec A`, the sections of `specDividedPowerIdeal A` are the ideal
generated by the image of `I` under `A → Γ(Spec A, U)`. -/
theorem specDividedPowerIdeal_affine
    (A : DividedPowerRing.{u})
    (U : (Spec (CommRingCat.of A)).affineOpens) :
    A.ideal.map (specSectionHom A U.1) =
      Crystalline.sectionIdeal (Spec (CommRingCat.of A)).sheaf
        (specDividedPowerIdeal A) (op U.1) := by
  ext x
  show x ∈ A.ideal.map (specSectionHom A U.1) ↔
    x ∈ (specDividedPowerIdeal A).obj (op U.1)
  rw [idealSheafAsSubmodule_obj_affine]
  simp only [Scheme.IdealSheafData.ofIdealTop_ideal, Ideal.map_map]
  rfl

/-- On an affine scheme, restriction of sections from `⊤` to an affine open is flat. -/
theorem affineRestriction_flat (X : Scheme.{u}) [IsAffine X]
    (U : X.affineOpens) :
    (X.presheaf.map (homOfLE (show U.1 ≤ ⊤ from le_top)).op).hom.Flat := by
  simpa [Scheme.Hom.appLE] using
    (𝟙 X : X ⟶ X).flat_appLE (isAffineOpen_top X) U.2
      (show U.1 ≤ (𝟙 X) ⁻¹ᵁ ⊤ from le_top)

/-- The map `A → Γ(Spec A, U)` is flat for every affine open `U`. -/
theorem specSectionHom_flat
    (A : DividedPowerRing.{u})
    (U : (Spec (CommRingCat.of A)).affineOpens) :
    (specSectionHom A U.1).Flat :=
  RingHom.Flat.comp
    (RingHom.Flat.of_bijective
      (Scheme.ΓSpecIso (CommRingCat.of A)).symm.commRingCatIsoToRingEquiv.bijective)
    (affineRestriction_flat _ U)

/-- The divided power structure on the structure sheaf of `Spec A`. On each affine open it is
the extension of `A`'s divided powers along the flat structure map, chosen by
`DividedPowerRing.extendedDividedPowersOfMapEqBotOrIsPrincipalOrFlat`. Such an extension exists
by [Stacks, Tag 07H1](https://stacks.math.columbia.edu/tag/07H1) but is not canonical, so this
definition records a choice rather than constructing a distinguished structure. -/
def specDividedPowerStructure (A : DividedPowerRing.{u}) :
    Crystalline.DividedPowerStructure.{u, u, u}
      (Spec (CommRingCat.of A)).sheaf (specDividedPowerIdeal A) :=
  dividedPowerStructureOfAffineSections A (Spec (CommRingCat.of A))
    (specDividedPowerIdeal A) (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
    (specSectionHom_flat A) (specDividedPowerIdeal_affine A)

/-- The map `A → Γ(Spec A, U)` is a divided power morphism into `specDividedPowerStructure A` on
every affine open `U`. -/
theorem specDividedPowerStructure_isDPMorphism (A : DividedPowerRing.{u})
    (U : (Spec (CommRingCat.of A)).affineOpens) :
    DividedPowers.IsDPMorphism A.dividedPowers
      ((specDividedPowerStructure A).dividedPowers (op U.1)) (specSectionHom A U.1) :=
  dividedPowerStructureOfAffineSections_isDPMorphism A (Spec (CommRingCat.of A))
    (specDividedPowerIdeal A) (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom
    (specSectionHom_flat A) (specDividedPowerIdeal_affine A) U

/-- **The affine divided power scheme `Spec (A, I, γ)` attached to a divided power ring.**  Its
divided powers on the affine sections are the chosen, non-canonical extension of `A`'s divided
powers along the flat structure map; see `specDividedPowerStructure`. -/
def specDividedPowerScheme (A : DividedPowerRing.{u}) : DividedPowerScheme.{u} where
  scheme := Spec (CommRingCat.of A)
  ideal := specDividedPowerIdeal A
  isQuasicoherent := idealSheafAsSubmodule_isQuasicoherent _
  dividedPowers := specDividedPowerStructure A

/-- The underlying scheme of `specDividedPowerScheme A` is `Spec A`. -/
@[simp]
theorem specDividedPowerScheme_scheme (A : DividedPowerRing.{u}) :
    (specDividedPowerScheme A).scheme = Spec (CommRingCat.of A) := rfl

/-- The map `A → Γ(Spec A, U)` is a divided power morphism into the divided powers of
`specDividedPowerScheme A` on every affine open `U`. -/
theorem specDividedPowerScheme_isDPMorphism
    (A : DividedPowerRing.{u})
    (U : (Spec (CommRingCat.of A)).affineOpens) :
    DividedPowers.IsDPMorphism A.dividedPowers
      ((specDividedPowerScheme A).dividedPowers.dividedPowers (op U.1))
      (specSectionHom A U.1) :=
  specDividedPowerStructure_isDPMorphism A U

/-! ### Morphisms to `Spec (A, I, γ)` -/

/-- Compatibility of sections on a spectrum with an arbitrary scheme morphism. -/
theorem appLE_comp_specSectionHom
    (X : Scheme.{u}) (A : DividedPowerRing.{u})
    (f : X ⟶ Spec (CommRingCat.of A))
    (U : (Spec (CommRingCat.of A)).Opens) (V : X.Opens) (h : V ≤ f ⁻¹ᵁ U) :
    (f.appLE U V h).hom.comp (specSectionHom A U) =
      (X.presheaf.map (homOfLE (show V ≤ ⊤ from le_top)).op).hom.comp
        (f.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom) := by
  dsimp [specSectionHom]
  rw [← RingHom.comp_assoc, ← CommRingCat.hom_comp, Scheme.Hom.map_appLE, ← RingHom.comp_assoc,
    ← CommRingCat.hom_comp]
  rfl

/-- **A divided power homomorphism `A ⟶ Γ(T, ⊤)` induces a morphism of divided power schemes
`T ⟶ Spec (A, I, γ)`.**  The underlying morphism of schemes is the one of the `Γ`-`Spec`
adjunction. -/
def toSpecDividedPowerScheme
    (X : DividedPowerScheme.{u}) (A : DividedPowerRing.{u})
    (φ : A ⟶ X.dividedPowers.toDividedPowerRing (op ⊤)) :
    X ⟶ specDividedPowerScheme A where
  hom := (ΓSpec.adjunction.homEquiv X.scheme (op (CommRingCat.of A)))
    (CommRingCat.ofHom φ.toRingHom).op
  compatible := by
    let f : X.scheme ⟶ Spec (CommRingCat.of A) :=
      (ΓSpec.adjunction.homEquiv X.scheme (op (CommRingCat.of A)))
        (CommRingCat.ofHom φ.toRingHom).op
    apply isDPMorphism_app_of_affine
    intro U V h
    apply DividedPowers.IsDPMorphism.of_comp (hI := A.dividedPowers)
      (f := specSectionHom A U.1)
    · exact (specDividedPowerIdeal_affine A U).symm
    · exact specDividedPowerScheme_isDPMorphism A U
    · have he : f.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom =
          φ.toRingHom :=
        congrArg CommRingCat.Hom.hom
          (ΓSpecIso_inv_ΓSpec_adjunction_homEquiv (CommRingCat.ofHom φ.toRingHom))
      have hr := appLE_comp_specSectionHom X.scheme A f U.1 V.1 h
      rw [he] at hr
      exact hr ▸ DividedPowers.IsDPMorphism.comp _
        (X.dividedPowers.naturality (homOfLE (show V.1 ≤ ⊤ from le_top)).op)
        φ.isDPMorphism

/-- On global sections, `toSpecDividedPowerScheme X A φ` induces `φ`. -/
theorem toSpecDividedPowerScheme_appTop
    (X : DividedPowerScheme.{u}) (A : DividedPowerRing.{u})
    (φ : A ⟶ X.dividedPowers.toDividedPowerRing (op ⊤)) :
    (toSpecDividedPowerScheme X A φ).hom.appTop.hom.comp
        (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom = φ.toRingHom :=
  congrArg CommRingCat.Hom.hom
    (ΓSpecIso_inv_ΓSpec_adjunction_homEquiv (CommRingCat.ofHom φ.toRingHom))

/-- The canonical global sections map of a divided power spectrum: on `⊤` the chosen divided
powers of `Spec (A, I, γ)` restrict to `γ` itself. -/
def specDividedPowerSchemeUnit (A : DividedPowerRing.{u}) :
    A ⟶ (specDividedPowerScheme A).dividedPowers.toDividedPowerRing (op ⊤) := by
  apply DividedPowers.DPMorphism.mk' (f := (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom)
  have h := specDividedPowerScheme_isDPMorphism A ⟨⊤, isAffineOpen_top _⟩
  have he : specSectionHom A ⊤ = (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom := by
    dsimp only [specSectionHom]
    rw [show homOfLE (show (⊤ : (Spec (CommRingCat.of A)).Opens) ≤ ⊤ from le_top) =
      𝟙 _ from Subsingleton.elim _ _, op_id, CategoryTheory.Functor.map_id]
    rfl
  rwa [he] at h

/-- The ring homomorphism underlying `specDividedPowerSchemeUnit A` is the inverse of the
`Γ`-`Spec` isomorphism. -/
@[simp]
theorem specDividedPowerSchemeUnit_toRingHom (A : DividedPowerRing.{u}) :
    (specDividedPowerSchemeUnit A).toRingHom =
      (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom := rfl

/-- Morphisms of divided power schemes into a divided power spectrum are determined by the ring
homomorphism `A → Γ(T, ⊤)` they induce. -/
theorem toSpecDividedPowerScheme_hom_ext
    {X : DividedPowerScheme.{u}} {A : DividedPowerRing.{u}}
    {f g : X ⟶ specDividedPowerScheme A}
    (h : f.hom.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom =
      g.hom.appTop.hom.comp (Scheme.ΓSpecIso (CommRingCat.of A)).inv.hom) : f = g :=
  DividedPowerScheme.Hom.ext (ext_to_Spec (CommRingCat.hom_ext h))

/-- **Morphisms of divided power schemes `T ⟶ Spec (A, I, γ)` are divided power homomorphisms
`A ⟶ Γ(T, ⊤)`.**  This is the universal property of `Spec` of a divided power ring. -/
def specDividedPowerHomEquiv (X : DividedPowerScheme.{u}) (A : DividedPowerRing.{u}) :
    (X ⟶ specDividedPowerScheme A) ≃
      (A ⟶ X.dividedPowers.toDividedPowerRing (op ⊤)) where
  toFun f := specDividedPowerSchemeUnit A ≫
    DividedPowers.DPMorphism.mk' (f := f.hom.appTop.hom) (f.compatible ⊤)
  invFun := toSpecDividedPowerScheme X A
  left_inv f := by
    apply toSpecDividedPowerScheme_hom_ext
    exact toSpecDividedPowerScheme_appTop X A _
  right_inv φ := by
    apply DividedPowers.DPMorphism.ext
    exact congrArg (fun f : A →+* Γ(X.scheme, ⊤) => (f : A → Γ(X.scheme, ⊤)))
      (toSpecDividedPowerScheme_appTop X A φ)

/-! ### `Spec` of a morphism of divided power rings -/

/-- **The inverse of the `Γ`-`Spec` identification is natural.**  This is Mathlib's
`AlgebraicGeometry.Scheme.ΓSpecIso_naturality` transposed to the inverses and read on ring
homomorphisms. -/
theorem specSectionHom_naturality {R T : CommRingCat.{u}} (f : R ⟶ T) :
    (Spec.map f).appTop.hom.comp (Scheme.ΓSpecIso R).inv.hom =
      (Scheme.ΓSpecIso T).inv.hom.comp f.hom := by
  simpa only [CommRingCat.hom_comp] using
    (congrArg CommRingCat.Hom.hom (Scheme.ΓSpecIso_inv_naturality f)).symm

/-- **`Spec` of a morphism of divided power rings.**  Its underlying morphism of schemes is
`Spec` of the underlying ring homomorphism. -/
def specDividedPowerMap {A B : DividedPowerRing.{u}} (f : A ⟶ B) :
    specDividedPowerScheme B ⟶ specDividedPowerScheme A where
  hom := Spec.map (CommRingCat.ofHom f.toRingHom)
  compatible := by
    apply isDPMorphism_app_of_affine
    intro U V h
    apply DividedPowers.IsDPMorphism.of_comp (hI := A.dividedPowers)
      (f := specSectionHom A U.1)
    · exact (specDividedPowerIdeal_affine A U).symm
    · exact specDividedPowerScheme_isDPMorphism A U
    · have hr := appLE_comp_specSectionHom (Spec (CommRingCat.of B)) A
        (Spec.map (CommRingCat.ofHom f.toRingHom)) U.1 V.1 h
      rw [specSectionHom_naturality (CommRingCat.ofHom f.toRingHom)] at hr
      exact hr ▸ DividedPowers.IsDPMorphism.comp _
        ((specDividedPowerScheme B).dividedPowers.naturality
          (homOfLE (show V.1 ≤ ⊤ from le_top)).op)
        (DividedPowers.IsDPMorphism.comp _ (specDividedPowerSchemeUnit B).isDPMorphism
          f.isDPMorphism)

/-- The underlying morphism of schemes of `specDividedPowerMap f` is `Spec.map f`. -/
@[simp]
theorem specDividedPowerMap_hom {A B : DividedPowerRing.{u}} (f : A ⟶ B) :
    (specDividedPowerMap f).hom = Spec.map (CommRingCat.ofHom f.toRingHom) := rfl

/-- **`Spec` of a composite of morphisms of divided power rings.**  `Spec` is contravariant on
divided power rings. -/
@[reassoc]
theorem specDividedPowerMap_comp {R T W : DividedPowerRing.{u}} (a : R ⟶ T) (b : T ⟶ W) :
    specDividedPowerMap (a ≫ b) = specDividedPowerMap b ≫ specDividedPowerMap a := by
  refine DividedPowerScheme.Hom.ext ?_
  have hab : CommRingCat.ofHom (a ≫ b).toRingHom =
      CommRingCat.ofHom a.toRingHom ≫ CommRingCat.ofHom b.toRingHom :=
    CommRingCat.hom_ext (RingHom.ext fun _ ↦ rfl)
  show Spec.map (CommRingCat.ofHom (a ≫ b).toRingHom) =
    Spec.map (CommRingCat.ofHom b.toRingHom) ≫ Spec.map (CommRingCat.ofHom a.toRingHom)
  rw [hab, Spec.map_comp]

end Crystalline.DividedPowerScheme

