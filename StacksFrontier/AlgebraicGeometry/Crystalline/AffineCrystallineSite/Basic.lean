/-!
# A generator of the completed affine crystalline site

Fix an affine crystalline situation with base `(A, I, γ)`, target `C` and prime `p`, and present
`C` as a quotient of a polynomial algebra `A[x_i]`.  The divided power envelope `E` of the kernel
of that presentation has a `p`-adic completion, and that completion is again a divided power
ring over `A` whose quotient by its divided power ideal is `C`.  It is therefore an object of the
completed affine crystalline site.

That object is a generator in the weak sense needed for computing crystalline cohomology: every
completed crystalline thickening of `C` over `A` receives a divided power morphism from it,
compatible with the maps from the base and with the identifications of the quotients with `C`.
The morphism comes from the universal property of the envelope followed by the completeness of
the target, and it is not asserted unique.

## Main definitions

* `Crystalline.completedPolynomialEnvelopeThickening` — the completed envelope as an object of
  the completed affine crystalline site, together with the identification of its underlying
  divided power ring, its map from the base and its map to `C`.

## Main results

* `Crystalline.exists_hom_from_completedPolynomialEnvelope` — every completed crystalline
  thickening receives a morphism from it.

## Implementation notes

The underlying divided power ring is recorded exactly rather than abstractly: its carrier, ideal
and divided powers are those of the `p`-adic completion of the envelope.  The structural map to
`C` is pinned down by the presentation — after precomposition with the surjection from the
polynomial ring it is the composite of the envelope map, the completion map and the quotient
map — and since that surjection is onto, this determines it.

The existence statement is phrased by a divided power morphism together with the two
compatibility conditions rather than by a morphism of the bundled category, because the target
thickening may live in a universe different from the generator's and the bundled category has
morphisms only within one universe.

Lifting a divided power morphism along the completion uses that the divided power structure of
the target is determined on a subring generated by the images of the generators under the ring
operations and the divided powers; that subring is described by an inductive syntax of formal
divided power expressions.

## References

* [Stacks Project, Tag 07KI](https://stacks.math.columbia.edu/tag/07KI)
-/

@[expose] public section

open CategoryTheory

universe u v w x

namespace Crystalline

private def evalTerm {G : Type u} (B : DividedPowerRing.{v})
    (v : G → B) : DividedPowerRing.DPTerm G → B
  | .gen g => v g
  | .zero => 0
  | .one => 1
  | .add x y => evalTerm B v x + evalTerm B v y
  | .neg x => -(evalTerm B v x)
  | .mul x y => evalTerm B v x * evalTerm B v y
  | .dpow n x => B.dividedPowers.dpow n (evalTerm B v x)

private def termSubring {G : Type u} (B : DividedPowerRing.{v})
    (v : G → B) : Subring B where
  carrier := Set.range (evalTerm B v)
  zero_mem' := ⟨.zero, rfl⟩
  one_mem' := ⟨.one, rfl⟩
  add_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨.add x y, rfl⟩
  neg_mem' := by
    rintro _ ⟨x, rfl⟩
    exact ⟨.neg x, rfl⟩
  mul_mem' := by
    rintro _ _ ⟨x, rfl⟩ ⟨y, rfl⟩
    exact ⟨.mul x y, rfl⟩

private theorem termSubring_dpow {G : Type u} (B : DividedPowerRing.{v})
    (v : G → B) (n : ℕ) (x : B) (hx : x ∈ termSubring B v) :
    B.dividedPowers.dpow n x ∈ termSubring B v := by
  rcases hx with ⟨t, rfl⟩
  exact ⟨.dpow n t, rfl⟩

private theorem envelope_lift
    (A : DividedPowerRing.{u}) {P : Type v} [CommRing P]
    (a : A →+* P) (J : Ideal P) (ha : A.ideal.map a ≤ J)
    (E : DividedPowerEnvelope A a J ha)
    (B : DividedPowerRing.{w})
    (b : DividedPowers.DPMorphism A.dividedPowers B.dividedPowers)
    (f : P →+* B) (hf : J.map f ≤ B.ideal) (hfa : f.comp a = b.toRingHom) :
    ∃ g : DividedPowers.DPMorphism E.object.dividedPowers B.dividedPowers,
      g.comp E.structureMap = b ∧ g.toRingHom.comp E.algebraMap.toRingHom = f := by
  classical
  let S := termSubring B f
  let : Small.{max u v} (DividedPowerRing.DPTerm P) :=
    ⟨⟨ULift.{u} (DividedPowerRing.DPTerm P), ⟨Equiv.ulift.symm⟩⟩⟩
  let : Small.{max u v} S := small_of_surjective
    (f := fun t : DividedPowerRing.DPTerm P => (⟨evalTerm B f t, ⟨t, rfl⟩⟩ : S))
    (by rintro ⟨y, t, rfl⟩; exact ⟨t, rfl⟩)
  let e : Shrink.{max u v} S ≃+* S := Shrink.ringEquiv S
  let I := B.ideal.comap S.subtype
  let δ := DividedPowerRing.restrictDividedPowers B.ideal B.dividedPowers S
    (fun n y hy _ => termSubring_dpow B f n y hy)
  let K := I.map e.symm.toRingHom
  let δ' : DividedPowers K := DividedPowers.ofRingEquiv (e := e.symm) rfl δ
  let T := DividedPowerRing.of (Shrink.{max u v} S) K δ'
  let down : T →+* B := S.subtype.comp e.toRingHom
  have hdown_mem (y : T) : y ∈ K ↔ down y ∈ B.ideal := by
    change y ∈ I.map e.symm.toRingHom ↔ e y ∈ I
    rw [Ideal.mem_map_iff_of_surjective e.symm.toRingHom e.symm.surjective]
    refine ⟨?_, fun hy => ⟨e y, hy, e.symm_apply_apply y⟩⟩
    rintro ⟨z, hz, rfl⟩
    simpa using hz
  have hdown_dp (n : ℕ) (y : T) (hy : y ∈ K) :
      down (δ'.dpow n y) = B.dividedPowers.dpow n (down y) := by
    have hmem : e y ∈ I := (hdown_mem y).mp hy
    simp only [δ', DividedPowers.ofRingEquiv, down, RingHom.comp_apply,
      RingEquiv.symm_symm, RingEquiv.toRingHom_eq_coe, RingEquiv.coe_toRingHom,
      RingEquiv.apply_symm_apply]
    change ((DividedPowerRing.restrictDividedPowers B.ideal B.dividedPowers S _).dpow n
      (e y)).val = _
    dsimp only [DividedPowerRing.restrictDividedPowers]
    rw [dite_eq_left hmem]
    rfl
  let downDP : DividedPowers.DPMorphism T.dividedPowers B.dividedPowers :=
    ⟨down, Ideal.map_le_iff_le_comap.mpr (fun y hy => (hdown_mem y).mp hy),
      fun {n} y hy => (hdown_dp n y hy).symm⟩
  let fS : P →+* S := f.codRestrict S (fun y => ⟨.gen y, rfl⟩)
  let fT : P →+* T := e.symm.toRingHom.comp fS
  have hdf : down.comp fT = f := by
    ext y
    exact congrArg Subtype.val (e.apply_symm_apply (fS y))
  have hdfA : down.comp (fT.comp a) = b.toRingHom := by
    rw [← RingHom.comp_assoc, hdf, hfa]
  have hmemA (y : A) (hy : y ∈ A.ideal) : (fT.comp a) y ∈ K := by
    apply (hdown_mem _).mpr
    change (down.comp (fT.comp a)) y ∈ B.ideal
    rw [hdfA]
    exact b.ideal_comp (Ideal.mem_map_of_mem _ hy)
  let bT : DividedPowers.DPMorphism A.dividedPowers T.dividedPowers :=
    ⟨fT.comp a, Ideal.map_le_iff_le_comap.mpr hmemA, by
      intro n y hy
      apply (S.subtype_injective.comp e.injective)
      change down (δ'.dpow n ((fT.comp a) y)) = down ((fT.comp a) (A.dividedPowers.dpow n y))
      rw [hdown_dp _ _ (hmemA y hy)]
      change B.dividedPowers.dpow n ((down.comp (fT.comp a)) y) =
        (down.comp (fT.comp a)) (A.dividedPowers.dpow n y)
      rw [hdfA]
      exact b.dpow_comp y hy⟩
  let pair : IdealPair.Hom J T.ideal :=
    ⟨fT, Ideal.map_le_iff_le_comap.mpr (by
      intro y hy
      apply (hdown_mem _).mpr
      change (down.comp fT) y ∈ B.ideal
      rw [hdf]
      exact hf (Ideal.mem_map_of_mem _ hy))⟩
  have hover : IdealPair.Hom.comp pair
      (IdealPair.Hom.ofRingHom a ha) =
      IdealPair.Hom.ofDPMorphism bT := rfl
  let g := (E.homEquiv T bT).symm ⟨pair, hover⟩
  refine ⟨downDP.comp g.1, ?_, ?_⟩
  · apply DividedPowers.DPMorphism.ext
    have hg := congrArg DividedPowers.DPMorphism.toRingHom g.2
    change g.1.toRingHom.comp E.structureMap.toRingHom = fT.comp a at hg
    have hh : down.comp (g.1.toRingHom.comp E.structureMap.toRingHom) = b.toRingHom :=
      hg ▸ hdfA
    exact congrArg DFunLike.coe hh
  · have hg := E.homEquiv_apply T bT g
    have hval := congrArg Subtype.val ((E.homEquiv T bT).apply_symm_apply ⟨pair, hover⟩)
    have hring := congrArg IdealPair.Hom.toRingHom (hval.symm.trans hg)
    change fT = g.1.toRingHom.comp E.algebraMap.toRingHom at hring
    change down.comp (g.1.toRingHom.comp E.algebraMap.toRingHom) = f
    rw [← hring, hdf]

private noncomputable def dpMapToBot
    {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    {I : Ideal R} (γ : DividedPowers I) (f : R →+* S)
    (hf : I.map f ≤ ⊥) :
    DividedPowers.DPMorphism γ (_root_.dividedPowersBot S) := by
  classical
  refine DividedPowers.DPMorphism.mk' ⟨hf, ?_⟩
  intro n x hx
  have hfx : f x = 0 := Ideal.mem_bot.mp (hf (Ideal.mem_map_of_mem f hx))
  by_cases hn : n = 0
  · subst n
    rw [γ.dpow_zero hx]
    simp [dividedPowersBot, hfx]
  · have hfd : f (γ.dpow n x) = 0 :=
      Ideal.mem_bot.mp (hf (Ideal.mem_map_of_mem f (γ.dpow_mem hn hx)))
    simp [hfx, hfd, _root_.dividedPowersBot, hn]

/-- The base divided power ideal maps into the kernel of a presentation of `C`. -/
private theorem base_ideal_map_le_ker
    (s : AffineCrystallineSituation.{u, v}) {ι : Type w}
    (f : MvPolynomial ι s.A →ₐ[s.A] s.C) :
    s.A.ideal.map (algebraMap s.A (MvPolynomial ι s.A)) ≤ RingHom.ker f.toRingHom := by
  rw [Ideal.map_le_iff_le_comap]
  intro a ha
  change f (algebraMap s.A (MvPolynomial ι s.A) a) = 0
  rw [f.commutes, ← Ideal.mem_bot, ← s.ideal_map_eq_bot]
  exact Ideal.mem_map_of_mem (algebraMap s.A s.C) ha

private theorem polynomialEnvelopeQuotient
    (s : AffineCrystallineSituation.{u, v}) {ι : Type w}
    (f : MvPolynomial ι s.A →ₐ[s.A] s.C) (hf : Function.Surjective f) :
    let env := polynomialDividedPowerEnvelope s f
    ∃ e : s.C ≃+* (env.object ⧸ env.object.ideal),
      e.toRingHom.comp f.toRingHom =
        (Ideal.Quotient.mk env.object.ideal).comp env.algebraMap.toRingHom := by
  classical
  let env := polynomialDividedPowerEnvelope s f
  let E := env.object
  have hAP := base_ideal_map_le_ker s f
  let P := MvPolynomial ι s.A
  let J := RingHom.ker f.toRingHom
  let qP : P →+* P ⧸ J := Ideal.Quotient.mk J
  let Q : DividedPowerRing.{max u w} :=
    ⟨P ⧸ J, ⊥, _root_.dividedPowersBot (P ⧸ J)⟩
  let base : DividedPowers.DPMorphism s.A.dividedPowers Q.dividedPowers :=
    dpMapToBot s.A.dividedPowers (qP.comp (algebraMap s.A P)) (by
      rw [Ideal.map_le_iff_le_comap]
      intro a ha
      exact Ideal.Quotient.eq_zero_iff_mem.mpr
        (hAP (Ideal.mem_map_of_mem (algebraMap s.A P) ha)))
  let pair : IdealPair.Hom J Q.ideal :=
    IdealPair.Hom.ofRingHom qP (by
      rw [Ideal.map_le_iff_le_comap]
      intro x hx
      exact Ideal.Quotient.eq_zero_iff_mem.mpr hx)
  let basePair : IdealPair.Hom s.A.ideal J :=
    IdealPair.Hom.ofRingHom (algebraMap s.A P) hAP
  have hOver : IdealPair.Hom.comp pair basePair =
      IdealPair.Hom.ofDPMorphism base := by
    apply IdealPair.Hom.ext_toRingHom
    ext a
    rfl
  let qData := (env.homEquiv Q base).symm ⟨pair, hOver⟩
  let q := qData.1
  have hqAlg : q.toRingHom.comp env.algebraMap.toRingHom = qP := by
    have hval : (env.homEquiv Q base qData).1 = pair :=
      congrArg Subtype.val (Equiv.apply_symm_apply (env.homEquiv Q base) ⟨pair, hOver⟩)
    have hpair : pair = IdealPair.Hom.comp (IdealPair.Hom.ofDPMorphism q) env.algebraMap :=
      hval.symm.trans (env.homEquiv_apply Q base qData)
    simpa [pair, qP, IdealPair.Hom.comp, IdealPair.Hom.ofDPMorphism, IdealPair.Hom.ofRingHom]
      using congrArg IdealPair.Hom.toRingHom hpair.symm
  let qE : E →+* E ⧸ E.ideal := Ideal.Quotient.mk E.ideal
  let U : DividedPowerRing.{max u w} :=
    ⟨E ⧸ E.ideal, ⊥, _root_.dividedPowersBot (E ⧸ E.ideal)⟩
  let qEDP : DividedPowers.DPMorphism E.dividedPowers U.dividedPowers :=
    dpMapToBot E.dividedPowers qE (Ideal.map_quotient_self E.ideal).le
  let ψ : P ⧸ J →+* E ⧸ E.ideal :=
    Ideal.Quotient.lift J (qE.comp env.algebraMap.toRingHom) fun _ hx =>
      Ideal.Quotient.eq_zero_iff_mem.mpr (env.algebraMap.ideal_comp (Ideal.mem_map_of_mem _ hx))
  have hψmk : ψ.comp qP = qE.comp env.algebraMap.toRingHom :=
    Ideal.Quotient.lift_comp_mk J _ _
  let qbar : E ⧸ E.ideal →+* P ⧸ J :=
    Ideal.Quotient.lift E.ideal q.toRingHom fun _ hx =>
      Ideal.mem_bot.mp (q.ideal_comp (Ideal.mem_map_of_mem q.toRingHom hx))
  have hqbarMk : qbar.comp qE = q.toRingHom :=
    Ideal.Quotient.lift_comp_mk E.ideal _ _
  let ψDP : DividedPowers.DPMorphism Q.dividedPowers U.dividedPowers :=
    dpMapToBot Q.dividedPowers ψ (by simp [Q, U])
  have hqBase : q.toRingHom.comp env.structureMap.toRingHom =
      base.toRingHom := congrArg (fun h : DividedPowers.DPMorphism _ _ => h.toRingHom) qData.2
  have hrestrict : ψ.comp (q.toRingHom.comp env.algebraMap.toRingHom) =
      qE.comp env.algebraMap.toRingHom := by
    rw [hqAlg, hψmk]
  have hbase : (ψDP.comp q).comp env.structureMap =
      qEDP.comp env.structureMap := by
    apply DividedPowers.DPMorphism.ext
    funext a
    change ψ (q.toRingHom (env.structureMap.toRingHom a)) =
      qE (env.structureMap.toRingHom a)
    have hstruct : env.algebraMap.toRingHom (algebraMap s.A P a) =
        env.structureMap.toRingHom a := (RingHom.ext_iff.mp env.algebraMap_comp) a
    rw [← hstruct]
    exact congrFun (congrArg DFunLike.coe hrestrict) (algebraMap s.A P a)
  have hsubeq :
      (env.homEquiv U (qEDP.comp env.structureMap))
        ⟨ψDP.comp q, hbase⟩ =
      (env.homEquiv U (qEDP.comp env.structureMap)) ⟨qEDP, rfl⟩ := by
    apply Subtype.ext
    rw [env.homEquiv_apply, env.homEquiv_apply]
    apply IdealPair.Hom.ext_toRingHom
    exact hrestrict
  have hψbase : ψDP.comp q = qEDP :=
    congrArg Subtype.val
      ((env.homEquiv U (qEDP.comp env.structureMap)).injective hsubeq)
  have hqbarψ : qbar.comp ψ = RingHom.id (P ⧸ J) := Ideal.Quotient.ringHom_ext <| by
    rw [RingHom.comp_assoc, hψmk, ← RingHom.comp_assoc, hqbarMk, hqAlg, RingHom.id_comp]
  have hψq : ψ.comp q.toRingHom = qE := congrArg DividedPowers.DPMorphism.toRingHom hψbase
  have hψqbar : ψ.comp qbar = RingHom.id (E ⧸ E.ideal) := Ideal.Quotient.ringHom_ext <| by
    rw [RingHom.comp_assoc, hqbarMk, hψq, RingHom.id_comp]
  let ψEquiv : (P ⧸ J) ≃+* (E ⧸ E.ideal) := RingEquiv.ofRingHom ψ qbar hψqbar hqbarψ
  let pToC : (P ⧸ J) ≃+* s.C := RingHom.quotientKerEquivOfSurjective hf
  refine ⟨pToC.symm.trans ψEquiv, ?_⟩
  apply RingHom.ext
  intro x
  change ψ (pToC.symm (f x)) = qE (env.algebraMap.toRingHom x)
  have hx : pToC.symm (f x) = qP x := pToC.injective <| (pToC.apply_symm_apply (f x)).trans
    (RingHom.quotientKerEquivOfSurjective_apply_mk (f := f.toRingHom) hf x).symm
  rw [hx]
  exact (RingHom.ext_iff.mp hψmk) x

private theorem completionToQuotient_algebraMap
    {R : Type u} [CommRing R] (I : Ideal R) (p : ℕ)
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : R))) (x : R) :
    DividedPowers.completionToQuotient I p hp
      (algebraMap R (AdicCompletion (DividedPowers.pAdicIdeal p) R) x) =
      Ideal.Quotient.mk I x := by
  change (Ideal.Quotient.factor (DividedPowers.pAdicIdeal_pow_nilpotencyExponent_le I p hp))
    (AdicCompletion.evalₐ (DividedPowers.pAdicIdeal p)
      (DividedPowers.nilpotencyExponent I p hp) (AdicCompletion.of _ R x)) = _
  simp

private theorem completionToQuotient_algebraMap_eq_zero
    {R : Type u} [CommRing R] (I : Ideal R) (p : ℕ)
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : R))) (x : R) (hx : x ∈ I) :
    DividedPowers.completionToQuotient I p hp
      (algebraMap R (AdicCompletion (DividedPowers.pAdicIdeal p) R) x) = 0 := by
  rw [completionToQuotient_algebraMap]
  exact Ideal.Quotient.eq_zero_iff_mem.mpr hx

private noncomputable def completionEmbedding
    {R : Type u} [CommRing R] (I : Ideal R) (γ : DividedPowers I) (p : ℕ)
    (hp : IsNilpotent (Ideal.Quotient.mk I (p : R))) :
    DividedPowers.DPMorphism γ (DividedPowers.completedDividedPowers I γ p hp).1 where
  toRingHom := algebraMap R (AdicCompletion (DividedPowers.pAdicIdeal p) R)
  ideal_comp := Ideal.map_le_iff_le_comap.mpr fun x hx =>
    completionToQuotient_algebraMap_eq_zero I p hp x hx
  dpow_comp {n} x hx :=
    (DividedPowers.completedDividedPowers I γ p hp).2 n x hx
      ⟨algebraMap R _ x, completionToQuotient_algebraMap_eq_zero I p hp x hx⟩ rfl

/-- The completed divided power envelope of a surjective polynomial presentation,
as an object of the completed crystalline site. Its underlying divided power
ring is the canonical completion, not merely an abstract thickening. -/
@[stacks 07KI "the completed crystalline object", no_expose]
public noncomputable def completedPolynomialEnvelopeThickening
    (s : AffineCrystallineSituation.{u, v}) {ι : Type w}
    (f : MvPolynomial ι s.A →ₐ[s.A] s.C) (hf : Function.Surjective f) :
    {D : CompletedCrystallineThickening.{u, v, max u w} s //
      let env := polynomialDividedPowerEnvelope s f
      let E := env.object
      ∃ hp : IsNilpotent (Ideal.Quotient.mk E.ideal (s.p : E)),
        (D.ring = DividedPowerRing.of
            (pAdicCompletedDividedPowerEnvelope s f hf)
            (DividedPowers.completionIdeal E.ideal s.p hp)
            (DividedPowers.completedDividedPowers E.ideal E.dividedPowers s.p hp).1) ∧
        HEq D.fromBase.toRingHom
          ((algebraMap E (pAdicCompletedDividedPowerEnvelope s f hf)).comp
            env.structureMap.toRingHom) ∧
        HEq (D.toQuotient.comp f.toRingHom)
          ((Ideal.Quotient.mk (DividedPowers.completionIdeal E.ideal s.p hp)).comp
            ((algebraMap E (pAdicCompletedDividedPowerEnvelope s f hf)).comp
              env.algebraMap.toRingHom))} := by
  classical
  let env := polynomialDividedPowerEnvelope s f
  let E := env.object
  let e := (polynomialEnvelopeQuotient s f hf).choose
  have he := (polynomialEnvelopeQuotient s f hf).choose_spec
  have hp : IsNilpotent (Ideal.Quotient.mk E.ideal (s.p : E)) := by
    simpa only [map_natCast] using s.prime_nilpotent.map e.toRingHom
  let R := pAdicCompletedDividedPowerEnvelope s f hf
  let K := DividedPowers.completionIdeal E.ideal s.p hp
  let δ := (DividedPowers.completedDividedPowers E.ideal E.dividedPowers s.p hp).1
  let ce : (R ⧸ K) ≃+* E ⧸ E.ideal :=
    RingHom.quotientKerEquivOfSurjective
      (DividedPowers.completionToQuotient_surjective E.ideal s.p hp)
  have hce (z : R) : ce (Ideal.Quotient.mk K z) =
      DividedPowers.completionToQuotient E.ideal s.p hp z :=
    RingHom.quotientKerEquivOfSurjective_apply_mk _ z
  let q : s.C →+* R ⧸ K := ce.symm.toRingHom.comp e.toRingHom
  have hq (z : MvPolynomial ι s.A) :
      q (f z) = Ideal.Quotient.mk K (algebraMap E R (env.algebraMap.toRingHom z)) := by
    apply ce.injective
    change ce (ce.symm (e (f z))) = _
    rw [ce.apply_symm_apply, hce, completionToQuotient_algebraMap]
    exact (RingHom.ext_iff.mp he) z
  let b := (completionEmbedding E.ideal E.dividedPowers s.p hp).comp env.structureMap
  have hb (a : s.A) : b a = algebraMap E R (env.structureMap a) := rfl
  let D : CompletedCrystallineThickening.{u, v, max u w} s :=
    { ring := DividedPowerRing.of R K δ
      fromBase := b
      isComplete := by
        let P := DividedPowers.pAdicIdeal (A := E) s.p
        have hP : P.map (algebraMap E R) = Ideal.span {(s.p : R)} := by
          simp [P, DividedPowers.pAdicIdeal, Ideal.map_span, Set.image_singleton]
        rw [← hP]
        exact (IsAdicComplete.map_algebraMap_iff P R).mpr
          (AdicCompletion.isAdicComplete (M := E) (Submodule.fg_span_singleton _))
      toQuotient := q
      commutes := by
        ext a
        change Ideal.Quotient.mk K (b a) = q (algebraMap s.A s.C a)
        rw [← f.commutes, hq, hb]
        congr 2
        exact ((RingHom.ext_iff.mp env.algebraMap_comp) a).symm
      toQuotient_bijective := ce.symm.bijective.comp e.bijective }
  exact ⟨D, hp, rfl, HEq.rfl, heq_of_eq (RingHom.ext hq)⟩

private noncomputable def quotientEquivOfCompletedThickening
    (s : AffineCrystallineSituation.{u, v})
    (B : CompletedCrystallineThickening.{u, v, x} s) :
    s.C ≃+* B.ring ⧸ B.ring.ideal :=
  RingEquiv.ofBijective B.toQuotient B.toQuotient_bijective

private noncomputable def quotientMapToCompletedThickening
    (s : AffineCrystallineSituation.{u, v})
    (B : CompletedCrystallineThickening.{u, v, x} s) : B.ring →+* s.C :=
  (quotientEquivOfCompletedThickening s B).symm.toRingHom.comp
    (Ideal.Quotient.mk B.ring.ideal)

private theorem quotientMapToCompletedThickening_comp_base
    (s : AffineCrystallineSituation.{u, v})
    (B : CompletedCrystallineThickening.{u, v, x} s) :
    (quotientMapToCompletedThickening s B).comp B.fromBase.toRingHom =
      algebraMap s.A s.C := by
  ext a
  change (quotientEquivOfCompletedThickening s B).symm
      (Ideal.Quotient.mk B.ring.ideal (B.fromBase a)) = _
  have hc : Ideal.Quotient.mk B.ring.ideal (B.fromBase a) =
      B.toQuotient (algebraMap s.A s.C a) := (RingHom.ext_iff.mp B.commutes) a
  rw [hc]
  exact RingEquiv.symm_apply_apply (quotientEquivOfCompletedThickening s B) _

private theorem quotientMapToCompletedThickening_surjective
    (s : AffineCrystallineSituation.{u, v})
    (B : CompletedCrystallineThickening.{u, v, x} s) :
    Function.Surjective (quotientMapToCompletedThickening s B) := by
  intro c
  obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective
    (quotientEquivOfCompletedThickening s B c)
  refine ⟨b, ?_⟩
  simp [quotientMapToCompletedThickening, hb]

private theorem ker_quotientMapToCompletedThickening
    (s : AffineCrystallineSituation.{u, v})
    (B : CompletedCrystallineThickening.{u, v, x} s) :
    RingHom.ker (quotientMapToCompletedThickening s B) = B.ring.ideal := by
  ext b
  simp [quotientMapToCompletedThickening, RingHom.mem_ker,
    Ideal.Quotient.eq_zero_iff_mem]

private noncomputable def polynomialLiftToCompletedThickening
    (s : AffineCrystallineSituation.{u, v}) {ι : Type w}
    (B : CompletedCrystallineThickening.{u, v, x} s)
    [Algebra s.A B.ring]
    (f : MvPolynomial ι s.A →ₐ[s.A] s.C) :
    MvPolynomial ι s.A →ₐ[s.A] B.ring := by
  classical
  let vals : ι → B.ring := fun i => Classical.choose
    (quotientMapToCompletedThickening_surjective s B (f (MvPolynomial.X i)))
  exact MvPolynomial.aeval vals

private noncomputable def completedThickeningAlgHomToC
    (s : AffineCrystallineSituation.{u, v})
    (B : CompletedCrystallineThickening.{u, v, x} s)
    [Algebra s.A B.ring]
    (hA : algebraMap s.A B.ring = B.fromBase.toRingHom) :
    B.ring →ₐ[s.A] s.C where
  toRingHom := quotientMapToCompletedThickening s B
  commutes' := by
    intro a
    rw [hA]
    exact (RingHom.ext_iff.mp
      (quotientMapToCompletedThickening_comp_base s B)) a

private theorem quotientMapToCompletedThickening_polynomialLift
    (s : AffineCrystallineSituation.{u, v}) {ι : Type w}
    (B : CompletedCrystallineThickening.{u, v, x} s)
    [Algebra s.A B.ring]
    (hA : algebraMap s.A B.ring = B.fromBase.toRingHom)
    (f : MvPolynomial ι s.A →ₐ[s.A] s.C) :
    (completedThickeningAlgHomToC s B hA).comp
        (polynomialLiftToCompletedThickening s B f) = f := by
  classical
  apply MvPolynomial.algHom_ext
  intro i
  change quotientMapToCompletedThickening s B
    (MvPolynomial.aeval
      (fun i => Classical.choose
        (quotientMapToCompletedThickening_surjective s B
          (f (MvPolynomial.X i)))) (MvPolynomial.X i)) = _
  simp only [MvPolynomial.aeval_X]
  exact Classical.choose_spec
    (quotientMapToCompletedThickening_surjective s B (f (MvPolynomial.X i)))

private theorem completedThickening_prime_nilpotent
    (s : AffineCrystallineSituation.{u, v})
    (B : CompletedCrystallineThickening.{u, v, x} s) :
    IsNilpotent (Ideal.Quotient.mk B.ring.ideal (s.p : B.ring)) := by
  simpa only [map_natCast] using s.prime_nilpotent.map B.toQuotient

open DividedPowers

private theorem factor_eval {R : Type u} [CommRing R] (I : Ideal R)
    {m n : ℕ} (h : m ≤ n) (z : AdicCompletion I R) :
    Ideal.Quotient.factor (Ideal.pow_le_pow_right h) (AdicCompletion.evalₐ I n z) =
      AdicCompletion.evalₐ I m z := by
  obtain ⟨a, rfl⟩ := AdicCompletion.mk_surjective I R z
  simp only [AdicCompletion.evalₐ_mk, Ideal.Quotient.factor_mk]
  exact AdicCompletion.Ideal.mk_eq_mk I h a

private theorem pAdic_map {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    (f : R →+* S) (p n : ℕ) : (pAdicIdeal (A := R) p ^ n).map f =
      pAdicIdeal (A := S) p ^ n := by
  simp [pAdicIdeal, Ideal.map_pow, Ideal.map_span, Set.image_singleton]

private def pAdicQuotientMap {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    (f : R →+* S) (p n : ℕ) :
    (R ⧸ pAdicIdeal (A := R) p ^ n) →+* (S ⧸ pAdicIdeal (A := S) p ^ n) :=
  Ideal.quotientMap _ f (Ideal.map_le_iff_le_comap.mp (le_of_eq (pAdic_map f p n)))

private theorem quotientDP {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    {I : Ideal R} {J : Ideal S} {γ : DividedPowers I} {δ : DividedPowers J}
    (f : DividedPowers.DPMorphism γ δ) (p n : ℕ)
    (hI : pAdicIdeal p ^ n ≤ I) (hγ : γ.IsSubDPIdeal (pAdicIdeal p ^ n))
    (hJ : pAdicIdeal p ^ n ≤ J) (hδ : δ.IsSubDPIdeal (pAdicIdeal p ^ n)) :
    (quotientDividedPowers I γ p n hI hγ).IsDPMorphism
      (quotientDividedPowers J δ p n hJ hδ) (pAdicQuotientMap f.toRingHom p n) := by
  apply DividedPowers.IsDPMorphism.of_comp γ _ _ (Ideal.Quotient.mk _) _ rfl
  · exact DividedPowers.Quotient.isDPMorphism γ _
  · have hq : δ.IsDPMorphism (quotientDividedPowers J δ p n hJ hδ)
        (Ideal.Quotient.mk (pAdicIdeal p ^ n)) := DividedPowers.Quotient.isDPMorphism δ _
    convert hq.comp _ f.isDPMorphism using 1
    ext z
    rfl

private theorem completion_lift
    {R : Type u} {S : Type v} [CommRing R] [CommRing S]
    (I : Ideal R) (γ : DividedPowers I) (J : Ideal S) (δ : DividedPowers J)
    (p : ℕ) [Fact p.Prime]
    [Algebra (DividedPowers.IntegersAtPrime p) R]
    [Algebra (DividedPowers.IntegersAtPrime p) S]
    (hpR : IsNilpotent (Ideal.Quotient.mk I (p : R)))
    (hpS : IsNilpotent (Ideal.Quotient.mk J (p : S)))
    [IsAdicComplete (pAdicIdeal (A := S) p) S]
    (f : DividedPowers.DPMorphism γ δ) :
    ∃ g : DividedPowers.DPMorphism (completedDividedPowers I γ p hpR).1 δ,
      g.toRingHom.comp (algebraMap R (AdicCompletion (pAdicIdeal p) R)) = f.toRingHom := by
  classical
  let PR := pAdicIdeal (A := R) p
  let PS := pAdicIdeal (A := S) p
  let F : ∀ n, AdicCompletion PR R →+* S ⧸ PS ^ n := fun n =>
    (pAdicQuotientMap f.toRingHom p n).comp (AdicCompletion.evalₐ PR n).toRingHom
  have hc : ∀ {m n : ℕ} (h : m ≤ n),
      (Ideal.Quotient.factorPow PS h).comp (F n) = F m := by
    intro m n h
    ext z
    have hh : (Ideal.Quotient.factorPow PS h).comp (pAdicQuotientMap f.toRingHom p n) =
        (pAdicQuotientMap f.toRingHom p m).comp (Ideal.Quotient.factorPow PR h) := by
      ext z
      rfl
    change (Ideal.Quotient.factorPow PS h)
      (pAdicQuotientMap f.toRingHom p n (AdicCompletion.evalₐ PR n z)) = _
    rw [← RingHom.comp_apply, hh, RingHom.comp_apply]
    exact congrArg (pAdicQuotientMap f.toRingHom p m) (factor_eval PR h z)
  let g := IsAdicComplete.liftRingHom PS F hc
  have hg (n : ℕ) (z : AdicCompletion PR R) :
      Ideal.Quotient.mk (PS ^ n) (g z) = F n z :=
    IsAdicComplete.mk_liftRingHom PS F hc n z
  obtain ⟨N, hN, hlim⟩ := eventually_isDividedPowerCompletionLimit.{u, 0} I γ p hpR
  obtain ⟨M, hM, _⟩ := eventually_isDividedPowerCompletionLimit.{v, 0} J δ p hpS
  have hF (n : ℕ) (hn : N ≤ n) (hm : M ≤ n) :
      (completedDividedPowers I γ p hpR).1.IsDPMorphism
        (quotientDividedPowers J δ p n (hM n hm).1 (hM n hm).2) (F n) :=
    (quotientDP f p n (hN n hn).1 (hN n hn).2 (hM n hm).1 (hM n hm).2).comp _
      (hlim.1 n hn)
  have hgi : (completionIdeal I p hpR).map g ≤ J := by
    rw [Ideal.map_le_iff_le_comap]
    intro z hz
    let n := max N M
    have hmem := (hF n (le_max_left _ _) (le_max_right _ _)).ideal_comp
      (Ideal.mem_map_of_mem (F n) hz)
    rw [← hg] at hmem
    have hmem' : g z ∈ Ideal.comap (Ideal.Quotient.mk (PS ^ n))
        (J.map (Ideal.Quotient.mk (PS ^ n))) := hmem
    rwa [Ideal.comap_map_of_surjective' _ Ideal.Quotient.mk_surjective,
      Ideal.mk_ker, sup_eq_left.mpr (hM n (le_max_right _ _)).1] at hmem'
  have hdp : (completedDividedPowers I γ p hpR).1.IsDPMorphism δ g := by
    refine ⟨hgi, fun {k} z hz => ?_⟩
    apply (AdicCompletion.ofAlgEquiv PS).injective
    apply AdicCompletion.ext_evalₐ
    intro n
    let e := max n (max N M)
    have hne : n ≤ e := le_max_left _ _
    have hNe : N ≤ e := (le_max_left N M).trans (le_max_right n (max N M))
    have hMe : M ≤ e := (le_max_right N M).trans (le_max_right n (max N M))
    have hh := (hF e hNe hMe).dpow_comp (n := k) z hz
    have hq : δ.IsDPMorphism (quotientDividedPowers J δ p e (hM e hMe).1 (hM e hMe).2)
        (Ideal.Quotient.mk (PS ^ e)) := DividedPowers.Quotient.isDPMorphism δ _
    rw [← hg e z, hq.dpow_comp (g z) (hgi (Ideal.mem_map_of_mem g hz)), ← hg] at hh
    have hh' := congrArg (Ideal.Quotient.factor (Ideal.pow_le_pow_right hne)) hh
    change Ideal.Quotient.mk (PS ^ n) (δ.dpow k (g z)) =
      Ideal.Quotient.mk (PS ^ n) (g ((completedDividedPowers I γ p hpR).1.dpow k z)) at hh'
    simpa only [AdicCompletion.ofAlgEquiv_apply, AdicCompletion.evalₐ_of] using hh'
  refine ⟨DividedPowers.DPMorphism.mk' hdp, ?_⟩
  ext z
  apply (AdicCompletion.ofAlgEquiv PS).injective
  apply AdicCompletion.ext_evalₐ
  intro n
  change AdicCompletion.evalₐ PS n (AdicCompletion.of PS S (g (algebraMap R _ z))) =
    AdicCompletion.evalₐ PS n (AdicCompletion.of PS S (f z))
  rw [AdicCompletion.evalₐ_of, AdicCompletion.evalₐ_of, hg]
  change pAdicQuotientMap f.toRingHom p n (AdicCompletion.evalₐ PR n (AdicCompletion.of PR R z)) = _
  rw [AdicCompletion.evalₐ_of]
  rfl

private theorem polynomialEnvelopeMapToCompletedThickening
    (s : AffineCrystallineSituation.{u, v}) {ι : Type w}
    (B : CompletedCrystallineThickening.{u, v, x} s)
    [Algebra s.A B.ring]
    (hA : algebraMap s.A B.ring = B.fromBase.toRingHom)
    (f : MvPolynomial ι s.A →ₐ[s.A] s.C) :
    ∃ q : DividedPowers.DPMorphism
        (polynomialDividedPowerEnvelope s f).object.dividedPowers
        B.ring.dividedPowers,
      q.comp (polynomialDividedPowerEnvelope s f).structureMap =
        B.fromBase ∧
      q.toRingHom.comp
        (polynomialDividedPowerEnvelope s f).algebraMap.toRingHom =
        (polynomialLiftToCompletedThickening s B f).toRingHom := by
  classical
  let env := polynomialDividedPowerEnvelope s f
  let P := MvPolynomial ι s.A
  let J := RingHom.ker f.toRingHom
  let qPoly := polynomialLiftToCompletedThickening s B f
  have hAP := base_ideal_map_le_ker s f
  have hJ : J.map qPoly.toRingHom ≤ B.ring.ideal := by
    rw [Ideal.map_le_iff_le_comap]
    intro z hz
    have hz0 : f z = 0 := RingHom.mem_ker.mp hz
    have hcomp := (RingHom.ext_iff.mp
      (congrArg AlgHom.toRingHom
        (quotientMapToCompletedThickening_polynomialLift s B hA f))) z
    have hq0 : quotientMapToCompletedThickening s B (qPoly z) = 0 := hcomp.trans hz0
    rw [← ker_quotientMapToCompletedThickening s B]
    exact RingHom.mem_ker.mpr hq0
  exact envelope_lift s.A (algebraMap s.A P) J hAP env B.ring B.fromBase
    qPoly.toRingHom hJ (by
      ext a
      change qPoly (algebraMap s.A P a) = B.fromBase a
      rw [qPoly.commutes, hA]
      rfl)

/-- Every completed crystalline thickening receives a morphism from the
completed divided power envelope of a surjective polynomial presentation. -/
@[stacks 07KI "existence of a morphism to every completed crystalline object"]
public theorem exists_hom_from_completedPolynomialEnvelope
    (s : AffineCrystallineSituation.{u, v}) {ι : Type w}
    (f : MvPolynomial ι s.A →ₐ[s.A] s.C) (hf : Function.Surjective f)
    (B : CompletedCrystallineThickening.{u, v, x} s) :
    let D := (completedPolynomialEnvelopeThickening s f hf).1
    ∃ g : DividedPowers.DPMorphism D.ring.dividedPowers B.ring.dividedPowers,
      (g.comp D.fromBase = B.fromBase) ∧
        ((Ideal.quotientMap B.ring.ideal g.toRingHom
          (Ideal.map_le_iff_le_comap.mp g.ideal_comp)).comp D.toQuotient =
            B.toQuotient) := by
  classical
  let env := polynomialDividedPowerEnvelope s f
  let E := env.object
  let : Algebra s.A B.ring := B.fromBase.toRingHom.toAlgebra
  have hA : algebraMap s.A B.ring = B.fromBase.toRingHom := rfl
  obtain ⟨qEnv, hbase, hpoly⟩ := polynomialEnvelopeMapToCompletedThickening s B hA f
  have hpolyQ (z : MvPolynomial ι s.A) :
      Ideal.Quotient.mk B.ring.ideal
        (polynomialLiftToCompletedThickening s B f z) = B.toQuotient (f z) := by
    apply (quotientEquivOfCompletedThickening s B).symm.injective
    change quotientMapToCompletedThickening s B
      (polynomialLiftToCompletedThickening s B f z) =
        (quotientEquivOfCompletedThickening s B).symm
          (quotientEquivOfCompletedThickening s B (f z))
    rw [RingEquiv.symm_apply_apply]
    exact DFunLike.congr_fun (quotientMapToCompletedThickening_polynomialLift s B hA f) z
  have hspec := (completedPolynomialEnvelopeThickening s f hf).2
  generalize hd : (completedPolynomialEnvelopeThickening s f hf).1 = D at hspec ⊢
  clear hd
  dsimp only at hspec ⊢
  obtain ⟨hp, hr, hb, hq⟩ := hspec
  -- The lift out of the completed envelope depends on none of the thickening's components, so
  -- it is produced before `D` is destructured: later on the local context carries the
  -- expanded structure literal and every elaboration against it is several times dearer.
  let : Algebra (DividedPowers.IntegersAtPrime s.p) E :=
    (env.structureMap.toRingHom.comp (algebraMap (DividedPowers.IntegersAtPrime s.p) s.A)).toAlgebra
  let : Algebra (DividedPowers.IntegersAtPrime s.p) B.ring :=
    (B.fromBase.toRingHom.comp (algebraMap (DividedPowers.IntegersAtPrime s.p) s.A)).toAlgebra
  let : IsAdicComplete (pAdicIdeal (A := B.ring) s.p) B.ring := B.isComplete
  obtain ⟨g, hg⟩ := completion_lift E.ideal E.dividedPowers B.ring.ideal B.ring.dividedPowers
    s.p hp (completedThickening_prime_nilpotent s B) qEnv
  rcases D with ⟨r, b, hc, tq, hcomm, hbij⟩
  dsimp only at hr hb hq ⊢
  subst r
  refine ⟨g, ?_, ?_⟩
  · apply DividedPowers.DPMorphism.ext
    funext a
    change g (b a) = B.fromBase a
    have hba := (RingHom.ext_iff.mp (eq_of_heq hb)) a
    change b a = algebraMap E _ (env.structureMap a) at hba
    rw [hba]
    exact ((RingHom.ext_iff.mp hg) (env.structureMap a)).trans (DFunLike.congr_fun hbase a)
  · refine RingHom.ext (hf.forall.mpr fun z => ?_)
    have hqz := (RingHom.ext_iff.mp (eq_of_heq hq)) z
    change tq (f z) = Ideal.Quotient.mk (completionIdeal E.ideal s.p hp)
      (algebraMap E _ (env.algebraMap.toRingHom z)) at hqz
    change Ideal.quotientMap B.ring.ideal g.toRingHom
      (Ideal.map_le_iff_le_comap.mp g.ideal_comp) (tq (f z)) = B.toQuotient (f z)
    rw [hqz]
    change Ideal.Quotient.mk B.ring.ideal
      (g (algebraMap E _ (env.algebraMap.toRingHom z))) = B.toQuotient (f z)
    exact (congrArg (Ideal.Quotient.mk B.ring.ideal)
      (((RingHom.ext_iff.mp hg) (env.algebraMap.toRingHom z)).trans
        ((RingHom.ext_iff.mp hpoly) z))).trans (hpolyQ z)

end Crystalline

