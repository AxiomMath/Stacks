/-!
# The diagonal of a coproduct of divided power rings, and divided power differentials

Let `f : (A, I, γ) → (B, J, δ)` be a morphism of divided power rings and let `B(1)` be the
coproduct of `B` with itself over `A` in the category of divided power rings, with
coprojections `s₀, s₁ : B → B(1)`.  The diagonal `B(1) → B` is the map inverting both
coprojections; write `K` for its kernel.

Two facts about this diagonal are proved here.  The intersection `K ∩ I_{B(1)}` is stable under
the divided powers of `B(1)`, being the intersection of a kernel with the divided power ideal.
And the module of divided power differentials of `B` over `A` is canonically the conormal module
of the diagonal: the quotient of `K` by `K²` together with the divided powers of order at least
two of elements of `K ∩ I_{B(1)}`.  Under that identification the universal divided power
differential of `b` is the class of `s₁ b - s₀ b`.

## Main definitions

* `Crystalline.secondDividedPowerIdeal` — the ideal generated by the divided powers of order at
  least two of the elements of a given ideal.
* `Crystalline.graphRingHom` — the graph `b ↦ (b, D b)` of a divided power derivation `D`, as a
  ring homomorphism into the trivial square zero extension.
* `Crystalline.Pushout.diagonalMap` — the diagonal out of the coproduct.
* `Crystalline.Pushout.diagonalKernel` — its kernel.
* `Crystalline.Pushout.diagonalRelations` — the submodule of the kernel generated by its square
  and the divided powers of order at least two.
* `Crystalline.Pushout.diagonalConormal` — the resulting quotient, the diagonal conormal module.
* `Crystalline.Pushout.diagonalDifference` — the class of `s₁ b - s₀ b` in that quotient.

## Main results

* `DividedPowers.isSubDPIdeal_ker` records the stability under divided powers.
* `Crystalline.Pushout.dividedPowerDifferentialsEquivDiagonalConormal` is the canonical
  identification of divided power differentials with the diagonal conormal module, together with
  its value on universal divided power differentials.

## Implementation notes

The coproduct is expressed by an `IsPushout` square in the category of divided power rings rather
than by a construction, so the results apply to any realization of it.

The conormal module is restricted along the first coprojection; modulo the square of the diagonal
ideal either coprojection induces the same action, and the module structure over the coproduct
itself is kept as a reducible instance so that the quotient map stays usable.

The identification is produced by exhibiting maps in both directions.  The map from differentials
uses the universal property of divided power differentials applied to the derivation
`b ↦ [s₁ b - s₀ b]`; the map back uses the universal property of the coproduct against the
first-order thickening of `B` by the module of divided power differentials, whose divided powers
come from the second-order formula.

The diagonal API is placed in the namespace `Crystalline.Pushout` because the same words name a
different construction on the affine crystalline site, where the coproduct is taken among divided
power thickenings rather than among divided power rings.

## References

* [Stacks Project, Tag 07HT](https://stacks.math.columbia.edu/tag/07HT)
-/

@[expose] public section

open CategoryTheory

universe u v w

namespace Crystalline

open DividedPowerRing

/-- The ideal generated by the divided powers of order at least two of elements of `K`.

In the application, `K` is the intersection of the diagonal ideal with the distinguished
divided power ideal. -/
public def secondDividedPowerIdeal {R : Type*} [CommRing R] {J : Ideal R}
    (δ : DividedPowers J) (K : Ideal R) : Ideal R :=
  Ideal.span {y | ∃ (n : ℕ), 2 ≤ n ∧ ∃ x : R, x ∈ K ∧ y = δ.dpow n x}

/-- The graph `x ↦ (x, d x)` of a divided power derivation `d`, as a map to the trivial square
zero extension. -/
public def graphFun {A : Type u} [CommRing A] {D : DividedPowerRing.{v}}
    {M : Type w} [AddCommGroup M] [Module D M] [Module Dᵐᵒᵖ M]
    [IsCentralScalar D M] {f : A →+* D}
    (d : DividedPowerDerivation A D f M) : D → TrivSqZeroExt D M :=
  fun x => (x, d x)

/-- The graph of a divided power derivation `d` is a ring homomorphism to the trivial square zero
extension, the Leibniz rule for `d` being exactly multiplicativity. -/
public def graphRingHom {A : Type u} [CommRing A] {D : DividedPowerRing.{v}}
    {M : Type w} [AddCommGroup M] [Module D M] [Module Dᵐᵒᵖ M]
    [IsCentralScalar D M] {f : A →+* D}
    (d : DividedPowerDerivation A D f M) : D →+* TrivSqZeroExt D M := {
  toFun := graphFun d
  map_one' := TrivSqZeroExt.ext rfl d.map_one_eq_zero
  map_mul' := by
    intro x y
    apply TrivSqZeroExt.ext
    · rfl
    · change TrivSqZeroExt.snd (graphFun d (x * y)) =
        TrivSqZeroExt.snd (graphFun d x * graphFun d y)
      rw [TrivSqZeroExt.snd_mul]
      change d (x * y) = _
      rw [d.leibniz]
      simp only [graphFun, TrivSqZeroExt.fst, TrivSqZeroExt.snd, op_smul_eq_smul]
  map_zero' := TrivSqZeroExt.ext rfl d.map_zero
  map_add' := by
    intro x y
    apply TrivSqZeroExt.ext
    · rfl
    · change TrivSqZeroExt.snd (graphFun d (x + y)) =
        TrivSqZeroExt.snd (graphFun d x + graphFun d y)
      rw [TrivSqZeroExt.snd_add]
      change d (x + y) = _
      rw [d.map_add]
      rfl
}

namespace Pushout

variable {A B B₁ : DividedPowerRing.{u}}
variable {f : A ⟶ B} {s₀ s₁ : B ⟶ B₁}

private noncomputable def secondOrderEquiv (B : DividedPowerRing.{u})
    (M : Type u) [AddCommGroup M] [Module B M] [Module Bᵐᵒᵖ M]
    [IsCentralScalar B M] :
    TrivSqZeroExt B M ≃+ B × (M × PUnit.{1}) where
  toFun x := (x.1, (x.2, PUnit.unit))
  invFun x := (x.1, x.2.1)
  left_inv x := by ext <;> rfl
  right_inv x := by
    rcases x with ⟨a, m, n⟩
    cases n
    rfl
  map_add' x y := by ext <;> rfl

/-- The divided powers of the first-order thickening of a divided power ring by a module,
together with the formula for them in the coordinates of the square-zero extension and the
assertion that the structure map is a divided power morphism. -/
private noncomputable def secondOrderExtensionData (B : DividedPowerRing.{u})
    (M : Type u) [AddCommGroup M] [Module B M] [Module Bᵐᵒᵖ M]
    [IsCentralScalar B M] :
    {δ : DividedPowers (firstOrderExtensionIdeal B M) //
      ((∀ (n : ℕ) (x : TrivSqZeroExt B M), 2 ≤ n → x ∈ firstOrderExtensionIdeal B M →
        δ.dpow n x = (secondOrderEquiv B M).symm
          (B.dividedPowers.dpow n ((secondOrderEquiv B M x).1),
            (B.dividedPowers.dpow (n - 1) ((secondOrderEquiv B M x).1) •
              (secondOrderEquiv B M x).2.1, 0))) ∧
      B.dividedPowers.IsDPMorphism δ (algebraMap B (TrivSqZeroExt B M)))} := by
  classical
  refine ⟨Classical.choose (firstOrderExtension_dividedPowers B M), ?_, ?_⟩
  · intro n x hn hx
    have h := (Classical.choose_spec (firstOrderExtension_dividedPowers B M)).1 n x hn hx
    exact TrivSqZeroExt.ext h.1 h.2
  · exact (Classical.choose_spec (firstOrderExtension_dividedPowers B M)).2

private noncomputable abbrev secondOrderDividedPowers (B : DividedPowerRing.{u})
    (M : Type u) [AddCommGroup M] [Module B M] [Module Bᵐᵒᵖ M]
    [IsCentralScalar B M] : DividedPowers (firstOrderExtensionIdeal B M) :=
  (secondOrderExtensionData B M).1

private noncomputable def secondOrderRing (B : DividedPowerRing.{u})
    (M : Type u) [AddCommGroup M] [Module B M] [Module Bᵐᵒᵖ M]
    [IsCentralScalar B M] : DividedPowerRing :=
  .of (TrivSqZeroExt B M) (firstOrderExtensionIdeal B M) (secondOrderDividedPowers B M)

private lemma secondOrder_dpow_formula (B : DividedPowerRing.{u})
    (M : Type u) [AddCommGroup M] [Module B M] [Module Bᵐᵒᵖ M]
    [IsCentralScalar B M] (n : ℕ) (x : TrivSqZeroExt B M) (hn : 2 ≤ n)
    (hx : x ∈ firstOrderExtensionIdeal B M) :
    (secondOrderDividedPowers B M).dpow n x = (secondOrderEquiv B M).symm
      (B.dividedPowers.dpow n ((secondOrderEquiv B M x).1),
        (B.dividedPowers.dpow (n - 1) ((secondOrderEquiv B M x).1) •
          (secondOrderEquiv B M x).2.1, 0)) :=
  (secondOrderExtensionData B M).property.1 n x hn hx

/-- A ring map into the first-order thickening, lying over a divided power morphism `ψ` and
satisfying the second-order formula for divided powers, is a divided power morphism. -/
private lemma secondOrder_isDPMorphism {C B : DividedPowerRing.{u}} {M : Type u}
    [AddCommGroup M] [Module B M] [Module Bᵐᵒᵖ M] [IsCentralScalar B M]
    (ψ : C ⟶ B) (F : C →+* TrivSqZeroExt B M) (hfst : ∀ x, (F x).1 = ψ.toRingHom x)
    (hsnd : ∀ (n : ℕ) (x : C), 2 ≤ n → x ∈ C.ideal →
      (F (C.dividedPowers.dpow n x)).2 =
        B.dividedPowers.dpow (n - 1) (ψ.toRingHom x) • (F x).2) :
    C.dividedPowers.IsDPMorphism (secondOrderDividedPowers B M) F := by
  have hmem : ∀ x ∈ C.ideal, F x ∈ firstOrderExtensionIdeal B M := fun x hx ↦ by
    change (F x).1 ∈ B.ideal
    rw [hfst]
    exact ψ.isDPMorphism.ideal_comp (Ideal.mem_map_of_mem _ hx)
  refine ⟨Ideal.map_le_iff_le_comap.mpr hmem, ?_⟩
  intro n x hx
  have hFx := hmem x hx
  by_cases h0 : n = 0
  · subst n
    rw [(secondOrderDividedPowers B M).dpow_zero hFx, C.dividedPowers.dpow_zero hx]
    exact F.map_one.symm
  · by_cases h1 : n = 1
    · subst n
      rw [(secondOrderDividedPowers B M).dpow_one hFx, C.dividedPowers.dpow_one hx]
    · have hn : 2 ≤ n := by omega
      apply (secondOrderEquiv B M).injective
      change (secondOrderEquiv B M) ((secondOrderDividedPowers B M).dpow n (F x)) =
        (secondOrderEquiv B M) (F (C.dividedPowers.dpow n x))
      rw [secondOrder_dpow_formula B M n (F x) hn hFx]
      change (B.dividedPowers.dpow n (F x).1, (B.dividedPowers.dpow (n - 1) (F x).1 • (F x).2,
        PUnit.unit)) = ((F (C.dividedPowers.dpow n x)).1, ((F (C.dividedPowers.dpow n x)).2,
        PUnit.unit))
      rw [hfst, hfst, ψ.isDPMorphism.dpow_comp x hx, ← hsnd n x hn hx]

private noncomputable def squareZeroLiftDPMorphism {A : Type u} [CommRing A]
    {B : DividedPowerRing.{u}} {f : A →+* B} {M : Type u}
    [AddCommGroup M] [Module B M] [Module Bᵐᵒᵖ M] [IsCentralScalar B M]
    (D : DividedPowerDerivation A B f M) :
    B ⟶ secondOrderRing B M := by
  exact DividedPowers.DPMorphism.mk' (secondOrder_isDPMorphism (𝟙 B) (graphRingHom D)
    (fun _ ↦ rfl) fun n b hn hb ↦ D.map_dpow n (by omega) b hb)

/-- The diagonal map out of a coproduct of a divided power ring with itself. -/
public noncomputable def diagonalMap (h : IsPushout f f s₀ s₁) : B₁ ⟶ B :=
  h.desc (𝟙 B) (𝟙 B) (by simp)

/-- The kernel ideal of the diagonal map. -/
public noncomputable abbrev diagonalKernel (h : IsPushout f f s₀ s₁) : Ideal B₁ :=
  RingHom.ker (diagonalMap h).toRingHom

/-- The relations in the diagonal ideal generated by its square and the divided powers of
order at least two. -/
public noncomputable def diagonalRelations (h : IsPushout f f s₀ s₁) :
    Submodule B₁ (diagonalKernel h) :=
  Submodule.comap
    (Submodule.subtype ((diagonalKernel h : Ideal B₁) : Submodule B₁ B₁))
    ((((diagonalKernel h) ^ (2 : ℕ)) +
        secondDividedPowerIdeal B₁.dividedPowers
          (diagonalKernel h ⊓ B₁.ideal) : Ideal B₁) : Submodule B₁ B₁)

/-- The diagonal conormal module, modulo the divided powers of order at least two.

It is regarded as a module over `B` through the first coprojection. -/
public noncomputable def diagonalConormal (h : IsPushout f f s₀ s₁) : Type u :=
  RestrictScalars B B₁
    ((diagonalKernel h) ⧸ diagonalRelations h)

/-- The additive group structure of the diagonal conormal module, that of the quotient. -/
public noncomputable instance (h : IsPushout f f s₀ s₁) :
    AddCommGroup (diagonalConormal h) :=
  inferInstanceAs (AddCommGroup
    (RestrictScalars B B₁
      ((diagonalKernel h) ⧸ diagonalRelations h)))

/-- The diagonal conormal module is a `B`-module by restriction of scalars along the first
coprojection. -/
public noncomputable instance (h : IsPushout f f s₀ s₁) : Module B (diagonalConormal h) := by
  letI : Algebra B B₁ := s₀.toRingHom.toAlgebra
  exact inferInstanceAs (Module B
    (RestrictScalars B B₁
      ((diagonalKernel h) ⧸ diagonalRelations h)))

/-- The class of `s₁(b) - s₀(b)` in the diagonal conormal module. -/
public noncomputable def diagonalDifference (h : IsPushout f f s₀ s₁) (b : B) :
    diagonalConormal h :=
  Submodule.Quotient.mk ⟨s₁ b - s₀ b, by
    rw [RingHom.mem_ker]
    change (diagonalMap h).toRingHom (s₁.toRingHom b - s₀.toRingHom b) = 0
    rw [map_sub]
    have h₁ : (diagonalMap h).toRingHom (s₁.toRingHom b) = b := by
      have hc : s₁ ≫ diagonalMap h = 𝟙 B := by simp [diagonalMap]
      exact congrArg (fun q : B ⟶ B ↦ q.toRingHom b) hc
    have h₀ : (diagonalMap h).toRingHom (s₀.toRingHom b) = b := by
      have hc : s₀ ≫ diagonalMap h = 𝟙 B := by simp [diagonalMap]
      exact congrArg (fun q : B ⟶ B ↦ q.toRingHom b) hc
    rw [h₁, h₀, sub_self]⟩

private lemma diagonalMap_s₀ (h : IsPushout f f s₀ s₁) (b : B) :
    (diagonalMap h).toRingHom (s₀.toRingHom b) = b := by
  have hc : s₀ ≫ diagonalMap h = 𝟙 B := by simp [diagonalMap]
  exact congrArg (fun q : B ⟶ B ↦ q.toRingHom b) hc

private lemma diagonalMap_s₁ (h : IsPushout f f s₀ s₁) (b : B) :
    (diagonalMap h).toRingHom (s₁.toRingHom b) = b := by
  have hc : s₁ ≫ diagonalMap h = 𝟙 B := by simp [diagonalMap]
  exact congrArg (fun q : B ⟶ B ↦ q.toRingHom b) hc

private lemma diagonalDifference_mem (h : IsPushout f f s₀ s₁) (b : B) :
    s₁ b - s₀ b ∈ diagonalKernel h := by
  rw [RingHom.mem_ker]
  change (diagonalMap h).toRingHom (s₁.toRingHom b - s₀.toRingHom b) = 0
  rw [map_sub, diagonalMap_s₀, diagonalMap_s₁, sub_self]

private lemma diagonalClass_mem (h : IsPushout f f s₀ s₁) (x : B₁) :
    x - s₀.toRingHom ((diagonalMap h).toRingHom x) ∈ diagonalKernel h := by
  rw [RingHom.mem_ker, map_sub, diagonalMap_s₀, sub_self]

private noncomputable def diagonalClass (h : IsPushout f f s₀ s₁) (x : B₁) :
    diagonalConormal h :=
  Submodule.Quotient.mk ⟨x - s₀.toRingHom ((diagonalMap h).toRingHom x),
    diagonalClass_mem h x⟩

private lemma diagonalClass_s₀ (h : IsPushout f f s₀ s₁) (b : B) :
    diagonalClass h (s₀.toRingHom b) = 0 := by
  show Submodule.Quotient.mk
      (⟨s₀.toRingHom b - s₀.toRingHom ((diagonalMap h).toRingHom (s₀.toRingHom b)), _⟩ :
        diagonalKernel h) = Submodule.Quotient.mk (0 : diagonalKernel h)
  congr 1
  apply Subtype.ext
  show s₀.toRingHom b -
      s₀.toRingHom ((diagonalMap h).toRingHom (s₀.toRingHom b)) = 0
  rw [diagonalMap_s₀, sub_self]

private lemma diagonalClass_s₁ (h : IsPushout f f s₀ s₁) (b : B) :
    diagonalClass h (s₁.toRingHom b) = diagonalDifference h b := by
  show Submodule.Quotient.mk
      (⟨s₁.toRingHom b - s₀.toRingHom ((diagonalMap h).toRingHom (s₁.toRingHom b)), _⟩ :
        diagonalKernel h) = Submodule.Quotient.mk
      (⟨s₁.toRingHom b - s₀.toRingHom b, _⟩ : diagonalKernel h)
  congr 1
  apply Subtype.ext
  show s₁.toRingHom b -
      s₀.toRingHom ((diagonalMap h).toRingHom (s₁.toRingHom b)) =
    s₁.toRingHom b - s₀.toRingHom b
  rw [diagonalMap_s₁]

private lemma diagonalClass_eq_quotient_mk
    (h : IsPushout f f s₀ s₁) (k : diagonalKernel h) :
    diagonalClass h (k : B₁) = Submodule.Quotient.mk k := by
  show Submodule.Quotient.mk
      (⟨(k : B₁) - s₀.toRingHom ((diagonalMap h).toRingHom (k : B₁)), _⟩ :
        diagonalKernel h) = Submodule.Quotient.mk k
  congr 1
  apply Subtype.ext
  show (k : B₁) - s₀.toRingHom ((diagonalMap h).toRingHom (k : B₁)) = k
  rw [(RingHom.mem_ker).mp k.property, s₀.toRingHom.map_zero, sub_zero]

private lemma diagonalClass_leibniz (h : IsPushout f f s₀ s₁) (x y : B₁) :
    diagonalClass h (x * y) =
      (diagonalMap h).toRingHom x • diagonalClass h y +
        (diagonalMap h).toRingHom y • diagonalClass h x := by
  let : Algebra B B₁ := s₀.toRingHom.toAlgebra
  let q : diagonalKernel h →ₗ[B] diagonalConormal h :=
    ((diagonalRelations h).mkQ).restrictScalars B
  show q ⟨x * y - s₀.toRingHom ((diagonalMap h).toRingHom (x * y)),
      diagonalClass_mem h (x * y)⟩ =
    (diagonalMap h).toRingHom x •
        q ⟨y - s₀.toRingHom ((diagonalMap h).toRingHom y),
          diagonalClass_mem h y⟩ +
      (diagonalMap h).toRingHom y •
        q ⟨x - s₀.toRingHom ((diagonalMap h).toRingHom x),
          diagonalClass_mem h x⟩
  rw [← map_smul q ((diagonalMap h).toRingHom x),
    ← map_smul q ((diagonalMap h).toRingHom y), ← map_add q]
  show q ⟨x * y - s₀.toRingHom ((diagonalMap h).toRingHom (x * y)), _⟩ =
    q (s₀.toRingHom ((diagonalMap h).toRingHom x) •
        (⟨y - s₀.toRingHom ((diagonalMap h).toRingHom y), _⟩ : diagonalKernel h) +
      s₀.toRingHom ((diagonalMap h).toRingHom y) •
        (⟨x - s₀.toRingHom ((diagonalMap h).toRingHom x), _⟩ : diagonalKernel h))
  apply (Submodule.Quotient.eq (diagonalRelations h)).2
  show (x * y - s₀.toRingHom ((diagonalMap h).toRingHom (x * y)) -
      (s₀.toRingHom ((diagonalMap h).toRingHom x) *
          (y - s₀.toRingHom ((diagonalMap h).toRingHom y)) +
        s₀.toRingHom ((diagonalMap h).toRingHom y) *
          (x - s₀.toRingHom ((diagonalMap h).toRingHom x)))) ∈
    (diagonalKernel h) ^ 2 +
      secondDividedPowerIdeal B₁.dividedPowers
        (diagonalKernel h ⊓ B₁.ideal)
  have hx := diagonalClass_mem h x
  have hy := diagonalClass_mem h y
  have hprod :
      (x - s₀.toRingHom ((diagonalMap h).toRingHom x)) *
          (y - s₀.toRingHom ((diagonalMap h).toRingHom y)) ∈
        (diagonalKernel h) ^ 2 := by
    rw [pow_two]
    exact Ideal.mul_mem_mul hx hy
  have heq :
      x * y - s₀.toRingHom ((diagonalMap h).toRingHom (x * y)) -
        (s₀.toRingHom ((diagonalMap h).toRingHom x) *
            (y - s₀.toRingHom ((diagonalMap h).toRingHom y)) +
          s₀.toRingHom ((diagonalMap h).toRingHom y) *
            (x - s₀.toRingHom ((diagonalMap h).toRingHom x))) =
      (x - s₀.toRingHom ((diagonalMap h).toRingHom x)) *
        (y - s₀.toRingHom ((diagonalMap h).toRingHom y)) := by
    rw [map_mul, map_mul]
    ring
  rw [heq]
  exact Ideal.mem_sup_left hprod

private noncomputable def diagonalClassAdd (h : IsPushout f f s₀ s₁) :
    B₁ →+ diagonalConormal h where
  toFun := diagonalClass h
  map_zero' := by
    have hz : (⟨0 - s₀.toRingHom ((diagonalMap h).toRingHom 0),
        diagonalClass_mem h 0⟩ : diagonalKernel h) = 0 := by
      apply Subtype.ext
      simp only [map_zero, sub_zero]
      rfl
    change Submodule.Quotient.mk
      (⟨0 - s₀.toRingHom ((diagonalMap h).toRingHom 0), _⟩ : diagonalKernel h) = 0
    rw [hz]
    exact (Submodule.Quotient.mk_zero (diagonalRelations h)).symm
  map_add' x y := by
    have hrep :
        (⟨x + y - s₀.toRingHom ((diagonalMap h).toRingHom (x + y)),
          diagonalClass_mem h (x + y)⟩ : diagonalKernel h) =
        (⟨x - s₀.toRingHom ((diagonalMap h).toRingHom x),
          diagonalClass_mem h x⟩ : diagonalKernel h) +
        ⟨y - s₀.toRingHom ((diagonalMap h).toRingHom y), diagonalClass_mem h y⟩ := by
      apply Subtype.ext
      change x + y - s₀.toRingHom ((diagonalMap h).toRingHom (x + y)) =
        (x - s₀.toRingHom ((diagonalMap h).toRingHom x)) +
          (y - s₀.toRingHom ((diagonalMap h).toRingHom y))
      rw [map_add, map_add]
      abel
    change Submodule.Quotient.mk
        (⟨x + y - s₀.toRingHom ((diagonalMap h).toRingHom (x + y)), _⟩ :
          diagonalKernel h) = _
    rw [hrep, Submodule.Quotient.mk_add]
    rfl

private lemma dpow_add_mem_secondDividedPowerIdeal
    {R : Type u} [CommRing R] {J : Ideal R} (δ : DividedPowers J)
    (K : Ideal R) (x t : R) (n : ℕ) (hn : 0 < n)
    (hx : x ∈ J) (htK : t ∈ K) (htJ : t ∈ J) :
    δ.dpow n (x + t) - δ.dpow n x - δ.dpow (n - 1) x * t ∈
      secondDividedPowerIdeal δ K := by
  let L := secondDividedPowerIdeal δ K
  let F : Finset ℕ := Finset.range (n + 1)
  let g : ℕ → R := fun k ↦ δ.dpow k t * δ.dpow (n - k) x
  have hsum : δ.dpow n (x + t) = F.sum g := by
    rw [add_comm]
    exact δ.dpow_add' htJ hx
  have h0 : 0 ∈ F := by simp [F]
  have h1 : 1 ∈ F := by simp only [F, Finset.mem_range]; omega
  have h1' : 1 ∈ F.erase 0 := Finset.mem_erase.mpr ⟨by decide, h1⟩
  have hsplit : F.sum g = (F.erase 0 |>.erase 1).sum g +
      (δ.dpow 1 t * δ.dpow (n - 1) x) +
      (δ.dpow 0 t * δ.dpow n x) := by
    rw [← Finset.sum_erase_add F g h0,
      ← Finset.sum_erase_add (F.erase 0) g h1']
    simp [g, add_assoc]
  have hrest : (F.erase 0 |>.erase 1).sum g ∈ L := by
    apply Ideal.sum_mem
    intro k hk
    have hk0 : k ≠ 0 := (Finset.mem_erase.mp (Finset.mem_erase.mp hk).2).1
    have hk1 : k ≠ 1 := (Finset.mem_erase.mp hk).1
    have hkF : k ∈ F := (Finset.mem_erase.mp (Finset.mem_erase.mp hk).2).2
    have hkn : 2 ≤ k := by
      have := Finset.mem_range.mp hkF
      omega
    have hgen : δ.dpow k t ∈ L := Ideal.subset_span ⟨k, hkn, t, htK, rfl⟩
    simpa [mul_comm] using Ideal.mul_mem_left L (δ.dpow (n - k) x) hgen
  rw [hsum, hsplit]
  simp only [δ.dpow_zero htJ, δ.dpow_one htJ, one_mul]
  convert hrest using 1; ring


private lemma diagonalClass_dpow (h : IsPushout f f s₀ s₁)
    (n : ℕ) (hn : 0 < n) (x : B₁) (hx : x ∈ B₁.ideal) :
    diagonalClass h (B₁.dividedPowers.dpow n x) =
      B.dividedPowers.dpow (n - 1) ((diagonalMap h).toRingHom x) • diagonalClass h x := by
  let b := (diagonalMap h).toRingHom x
  let t := x - s₀.toRingHom b
  have hb : b ∈ B.ideal :=
    (diagonalMap h).isDPMorphism.ideal_comp (Ideal.mem_map_of_mem _ hx)
  have hs₀b : s₀.toRingHom b ∈ B₁.ideal :=
    s₀.isDPMorphism.ideal_comp (Ideal.mem_map_of_mem _ hb)
  have htK : t ∈ diagonalKernel h := diagonalClass_mem h x
  have htJ : t ∈ B₁.ideal := B₁.ideal.sub_mem hx hs₀b
  have hadd : x = s₀.toRingHom b + t := (add_sub_cancel _ _).symm
  have hdp := dpow_add_mem_secondDividedPowerIdeal B₁.dividedPowers
    (diagonalKernel h ⊓ B₁.ideal) (s₀.toRingHom b) t n hn hs₀b ⟨htK, htJ⟩ htJ
  rw [← hadd, s₀.isDPMorphism.dpow_comp (n := n) b hb] at hdp
  have hcoeff : s₀.toRingHom (B.dividedPowers.dpow (n - 1) b) =
      B₁.dividedPowers.dpow (n - 1) (s₀.toRingHom b) :=
    (s₀.isDPMorphism.dpow_comp (n := n - 1) b hb).symm
  let : Algebra B B₁ := s₀.toRingHom.toAlgebra
  let q : diagonalKernel h →ₗ[B] diagonalConormal h :=
    ((diagonalRelations h).mkQ).restrictScalars B
  show q ⟨B₁.dividedPowers.dpow n x -
      s₀.toRingHom ((diagonalMap h).toRingHom (B₁.dividedPowers.dpow n x)), _⟩ =
    B.dividedPowers.dpow (n - 1) b •
      q ⟨x - s₀.toRingHom b, diagonalClass_mem h x⟩
  rw [← map_smul q (B.dividedPowers.dpow (n - 1) b)]
  apply (Submodule.Quotient.eq (diagonalRelations h)).2
  show (B₁.dividedPowers.dpow n x -
      s₀.toRingHom ((diagonalMap h).toRingHom (B₁.dividedPowers.dpow n x)) -
      s₀.toRingHom (B.dividedPowers.dpow (n - 1) b) *
        (x - s₀.toRingHom b)) ∈
    (diagonalKernel h) ^ 2 +
      secondDividedPowerIdeal B₁.dividedPowers
        (diagonalKernel h ⊓ B₁.ideal)
  have hdiag : (diagonalMap h).toRingHom (B₁.dividedPowers.dpow n x) =
      B.dividedPowers.dpow n b :=
    (diagonalMap h).isDPMorphism.dpow_comp x hx |>.symm
  rw [hdiag, hcoeff]
  simpa [t, b] using Ideal.mem_sup_right hdp

private noncomputable def diagonalConormalLiftDPMorphism
    (h : IsPushout f f s₀ s₁) {M : Type u} [AddCommGroup M]
    [Module B M] [Module Bᵐᵒᵖ M] [IsCentralScalar B M]
    (g : diagonalConormal h →ₗ[B] M) : B₁ ⟶ secondOrderRing B M := by
  letI : Algebra B₁ B := (diagonalMap h).toRingHom.toAlgebra
  letI : Module B₁ M := Module.compHom M (diagonalMap h).toRingHom
  let dAdd : B₁ →+ M := g.toAddMonoidHom.comp (diagonalClassAdd h)
  let d : Derivation ℤ B₁ M := Derivation.mk' dAdd.toIntLinearMap (by
    intro x y
    change g (diagonalClass h (x * y)) =
      (diagonalMap h).toRingHom x • g (diagonalClass h y) +
        (diagonalMap h).toRingHom y • g (diagonalClass h x)
    rw [diagonalClass_leibniz]
    simp only [map_add, map_smul])
  let D : DividedPowerDerivation B B₁ s₀.toRingHom M := by
    refine ⟨d, ?_, ?_⟩
    · intro b
      change g (diagonalClass h (s₀.toRingHom b)) = 0
      rw [diagonalClass_s₀]
      simp
    · intro n hn x hx
      change g (diagonalClass h (B₁.dividedPowers.dpow n x)) =
        B₁.dividedPowers.dpow (n - 1) x • g (diagonalClass h x)
      rw [diagonalClass_dpow h n hn x hx, map_smul]
      congr 1
      exact (diagonalMap h).isDPMorphism.dpow_comp (n := n - 1) x hx
  let E := secondOrderRing B M
  let F : B₁ →+* E := {
    toFun := fun x ↦ ((diagonalMap h).toRingHom x, D x)
    map_one' :=
      TrivSqZeroExt.ext (diagonalMap h).toRingHom.map_one D.toDerivation.map_one_eq_zero
    map_mul' x y := by
      apply TrivSqZeroExt.ext
      · exact (diagonalMap h).toRingHom.map_mul x y
      · change D.toDerivation (x * y) =
          (diagonalMap h).toRingHom x • D y + MulOpposite.op ((diagonalMap h).toRingHom y) • D x
        rw [D.toDerivation.leibniz, IsCentralScalar.op_smul_eq_smul]
        rfl
    map_zero' := TrivSqZeroExt.ext (diagonalMap h).toRingHom.map_zero D.toDerivation.map_zero
    map_add' x y :=
      TrivSqZeroExt.ext ((diagonalMap h).toRingHom.map_add x y) (D.toDerivation.map_add x y) }
  exact DividedPowers.DPMorphism.mk' (secondOrder_isDPMorphism (diagonalMap h) F (fun _ ↦ rfl)
    fun n x hn hx ↦ by
      change D (B₁.dividedPowers.dpow n x) = _
      rw [D.map_dpow n (by omega) x hx,
        (diagonalMap h).isDPMorphism.dpow_comp (n := n - 1) x hx]
      rfl)

private lemma diagonalConormalLiftDPMorphism_apply
    (h : IsPushout f f s₀ s₁) {M : Type u} [AddCommGroup M]
    [Module B M] [Module Bᵐᵒᵖ M] [IsCentralScalar B M]
    (g : diagonalConormal h →ₗ[B] M) (x : B₁) :
    (diagonalConormalLiftDPMorphism h g).toRingHom x =
      ((diagonalMap h).toRingHom x, g (diagonalClass h x)) := rfl

private noncomputable def secondOrderProjectionDPMorphism
    (B : DividedPowerRing.{u}) (M : Type u) [AddCommGroup M]
    [Module B M] [Module Bᵐᵒᵖ M] [IsCentralScalar B M] :
    secondOrderRing B M ⟶ B := by
  letI : Algebra B (TrivSqZeroExt B M) := TrivSqZeroExt.algebra' B B M
  let p : TrivSqZeroExt B M →+* B := (TrivSqZeroExt.fstHom B B M).toRingHom
  have hp : (secondOrderDividedPowers B M).IsDPMorphism B.dividedPowers p := by
    refine ⟨?_, ?_⟩
    · exact Ideal.map_le_iff_le_comap.mpr fun x hx ↦ hx
    · intro n x hx
      by_cases h0 : n = 0
      · subst n
        rw [B.dividedPowers.dpow_zero (show p x ∈ B.ideal from hx),
          (secondOrderDividedPowers B M).dpow_zero hx]
        rfl
      · by_cases h1 : n = 1
        · subst n
          rw [B.dividedPowers.dpow_one (show p x ∈ B.ideal from hx),
            (secondOrderDividedPowers B M).dpow_one hx]
        · have hn : 2 ≤ n := by omega
          rw [secondOrder_dpow_formula B M n x hn hx]
          rfl
  exact DividedPowers.DPMorphism.mk' hp

private lemma diagonalDifference_span (h : IsPushout f f s₀ s₁) :
    Submodule.span B (Set.range (diagonalDifference h)) = ⊤ := by
  let W : Submodule B (diagonalConormal h) :=
    Submodule.span B (Set.range (diagonalDifference h))
  let M := (diagonalConormal h) ⧸ W
  let g : diagonalConormal h →ₗ[B] M := W.mkQ
  let : Module Bᵐᵒᵖ M := Module.compHom M (RingEquiv.toOpposite B).symm.toRingHom
  let : IsCentralScalar B M := ⟨by intro b m; rfl⟩
  let φ := diagonalConormalLiftDPMorphism h g
  let D₀ : DividedPowerDerivation B B (RingHom.id B) M := 0
  let ι := squareZeroLiftDPMorphism (A := B) (f := RingHom.id B) D₀
  have h₀ : s₀ ≫ φ = s₀ ≫ (diagonalMap h ≫ ι) := by
    ext b
    apply TrivSqZeroExt.ext
    · rfl
    · show g (diagonalClass h (s₀.toRingHom b)) = D₀ b
      rw [diagonalClass_s₀]
      simp [D₀]
  have h₁ : s₁ ≫ φ = s₁ ≫ (diagonalMap h ≫ ι) := by
    ext b
    apply TrivSqZeroExt.ext
    · rfl
    · show g (diagonalClass h (s₁.toRingHom b)) = D₀ b
      rw [diagonalClass_s₁]
      have hW : diagonalDifference h b ∈ W :=
        Submodule.subset_span ⟨b, rfl⟩
      show W.mkQ (diagonalDifference h b) = 0
      simpa [g] using (Submodule.Quotient.mk_eq_zero W).2 hW
  have hφ : φ = diagonalMap h ≫ ι := h.hom_ext h₀ h₁
  apply top_unique
  intro z hz
  obtain ⟨k, rfl⟩ := Submodule.Quotient.mk_surjective (diagonalRelations h) z
  have hdiagk : (diagonalMap h).toRingHom (k : B₁) = 0 := k.property
  have hιsnd (b : B) : TrivSqZeroExt.snd (ι.toRingHom b) = 0 := rfl
  have hsecond : g (diagonalClass h (k : B₁)) = 0 := by
    have hval := congrArg
      (fun q : B₁ ⟶ secondOrderRing B M ↦ TrivSqZeroExt.snd (q.toRingHom (k : B₁))) hφ
    rw [diagonalConormalLiftDPMorphism_apply] at hval
    change g (diagonalClass h (k : B₁)) =
      TrivSqZeroExt.snd (ι.toRingHom ((diagonalMap h).toRingHom (k : B₁))) at hval
    rwa [hdiagk, hιsnd] at hval
  have hclass := diagonalClass_eq_quotient_mk h k
  have hqk : g (Submodule.Quotient.mk k) = 0 := by
    simpa [hclass] using hsecond
  show (Submodule.Quotient.mk k : diagonalConormal h) ∈ W
  exact (Submodule.Quotient.mk_eq_zero W).1 hqk

private lemma diagonalDifference_leibniz (h : IsPushout f f s₀ s₁) (x y : B) :
    diagonalDifference h (x * y) =
      x • diagonalDifference h y + y • diagonalDifference h x := by
  have hd := diagonalClass_leibniz h (s₁.toRingHom x) (s₁.toRingHom y)
  rw [← s₁.toRingHom.map_mul] at hd
  simpa only [diagonalClass_s₁, diagonalMap_s₁] using hd


private noncomputable def diagonalDifferenceAdd
    {A B B₁ : DividedPowerRing.{u}} {f : A ⟶ B} {s₀ s₁ : B ⟶ B₁}
    (h : IsPushout f f s₀ s₁) : B →+ diagonalConormal h where
  toFun := diagonalDifference h
  map_zero' := by
    change Submodule.Quotient.mk
        (⟨s₁ 0 - s₀ 0, diagonalDifference_mem h 0⟩ : diagonalKernel h) =
      Submodule.Quotient.mk 0
    congr 1
    apply Subtype.ext
    change s₁.toRingHom 0 - s₀.toRingHom 0 = 0
    rw [s₁.toRingHom.map_zero, s₀.toRingHom.map_zero, sub_self]
  map_add' x y := by
    have hrep : (⟨s₁ (x + y) - s₀ (x + y), diagonalDifference_mem h (x + y)⟩ :
          diagonalKernel h) =
        (⟨s₁ x - s₀ x, diagonalDifference_mem h x⟩ : diagonalKernel h) +
          ⟨s₁ y - s₀ y, diagonalDifference_mem h y⟩ := by
      apply Subtype.ext
      change s₁.toRingHom (x + y) - s₀.toRingHom (x + y) =
        (s₁.toRingHom x - s₀.toRingHom x) + (s₁.toRingHom y - s₀.toRingHom y)
      rw [map_add, map_add]
      ring
    change Submodule.Quotient.mk
        (⟨s₁ (x + y) - s₀ (x + y), diagonalDifference_mem h (x + y)⟩ :
          diagonalKernel h) = _
    rw [hrep, Submodule.Quotient.mk_add]
    rfl

private noncomputable def diagonalDifferenceDPDerivation
    (h : IsPushout f f s₀ s₁) :
    DividedPowerDerivation A B f.toRingHom (diagonalConormal h) := by
  letI : Algebra B B₁ := s₀.toRingHom.toAlgebra
  let dAdd := diagonalDifferenceAdd h
  let d : Derivation ℤ B (diagonalConormal h) :=
    Derivation.mk' dAdd.toIntLinearMap (diagonalDifference_leibniz h)
  refine ⟨d, ?_, ?_⟩
  · intro a
    have hval : s₁.toRingHom (f.toRingHom a) - s₀.toRingHom (f.toRingHom a) = 0 :=
      sub_eq_zero.mpr (congrArg (fun q : A ⟶ B₁ ↦ q.toRingHom a) h.w).symm
    change Submodule.Quotient.mk
      (⟨s₁.toRingHom (f.toRingHom a) - s₀.toRingHom (f.toRingHom a), _⟩ :
        diagonalKernel h) = 0
    have hz : (⟨s₁.toRingHom (f.toRingHom a) - s₀.toRingHom (f.toRingHom a),
        diagonalDifference_mem h (f.toRingHom a)⟩ : diagonalKernel h) = 0 := Subtype.ext hval
    rw [hz]
    simp
  · intro n hn b hb
    have hs₁b : s₁.toRingHom b ∈ B₁.ideal :=
      s₁.isDPMorphism.ideal_comp (Ideal.mem_map_of_mem s₁.toRingHom hb)
    have hd := diagonalClass_dpow h n hn (s₁.toRingHom b) hs₁b
    rw [s₁.isDPMorphism.dpow_comp b hb] at hd
    change diagonalDifference h (B.dividedPowers.dpow n b) =
      B.dividedPowers.dpow (n - 1) b • diagonalDifference h b
    simpa only [diagonalClass_s₁, diagonalMap_s₁] using hd

private noncomputable def diagonalConormalInverseData
    {A B B₁ : DividedPowerRing.{u}}
    {f : A ⟶ B} {s₀ s₁ : B ⟶ B₁}
    (h : IsPushout f f s₀ s₁) :
    letI : Algebra A B := f.toRingHom.toAlgebra
    {R : diagonalConormal h →ₗ[B]
      dividedPowerDifferentials (A := A) B.dividedPowers //
      ∀ b : B, R (diagonalDifference h b) =
        dividedPowerDifferential (A := A) B.dividedPowers b} := by
  letI : Algebra A B := f.toRingHom.toAlgebra
  letI : Algebra B B₁ := s₀.toRingHom.toAlgebra
  let M := dividedPowerDifferentials (A := A) B.dividedPowers
  letI : Module Bᵐᵒᵖ M := Module.compHom M (RingEquiv.toOpposite B).symm.toRingHom
  letI : IsCentralScalar B M := ⟨by intro b m; rfl⟩
  let D₁ := universalDividedPowerDerivation (A := A) (B := B)
  let D₀ : DividedPowerDerivation B B (RingHom.id B) M := 0
  let E := secondOrderRing B M
  let ι₀ := squareZeroLiftDPMorphism (A := B) (f := RingHom.id B) D₀
  let ι₁ := squareZeroLiftDPMorphism (A := A) (f := f.toRingHom) D₁
  have hcomm : f ≫ ι₀ = f ≫ ι₁ := by
    ext a
    apply TrivSqZeroExt.ext
    · rfl
    · change 0 = D₁.toDerivation (f.toRingHom a)
      exact (D₁.map_ringHom a).symm
  let φ : B₁ ⟶ E := h.desc ι₀ ι₁ hcomm
  have hφ₀ : s₀ ≫ φ = ι₀ := by simp [φ]
  have hφ₁ : s₁ ≫ φ = ι₁ := by simp [φ]
  let p := secondOrderProjectionDPMorphism B M
  have hfirst : φ ≫ p = diagonalMap h := by
    apply h.hom_ext
    · calc
        s₀ ≫ (φ ≫ p) = (s₀ ≫ φ) ≫ p := by simp [Category.assoc]
        _ = ι₀ ≫ p := by rw [hφ₀]
        _ = 𝟙 B := by ext b; rfl
        _ = s₀ ≫ diagonalMap h := by simp [diagonalMap]
    · calc
        s₁ ≫ (φ ≫ p) = (s₁ ≫ φ) ≫ p := by simp [Category.assoc]
        _ = ι₁ ≫ p := by rw [hφ₁]
        _ = 𝟙 B := by ext b; rfl
        _ = s₁ ≫ diagonalMap h := by simp [diagonalMap]
  have hfst (x : B₁) : (φ.toRingHom x).1 = (diagonalMap h).toRingHom x :=
    congrArg (fun q : B₁ ⟶ B ↦ q.toRingHom x) hfirst
  have hKfst (k : diagonalKernel h) :
      (φ.toRingHom (k : B₁)).1 = 0 := by
    rw [hfst]
    exact k.property
  letI : Module B₁ M := Module.compHom M (diagonalMap h).toRingHom
  let κ : diagonalKernel h →ₗ[B₁] M := {
    toFun k := (φ.toRingHom (k : B₁)).2
    map_add' k l := by
      change (φ.toRingHom ((k : B₁) + (l : B₁))).2 =
        (φ.toRingHom (k : B₁)).2 + (φ.toRingHom (l : B₁)).2
      rw [map_add]
      rfl
    map_smul' a k := by
      change (φ.toRingHom (a * (k : B₁))).2 =
        (diagonalMap h).toRingHom a • (φ.toRingHom (k : B₁)).2
      rw [map_mul]
      change (φ.toRingHom a).1 • (φ.toRingHom (k : B₁)).2 +
          MulOpposite.op ((φ.toRingHom (k : B₁)).1) • (φ.toRingHom a).2 = _
      rw [hfst, hKfst k]
      simp
  }
  let Z : Ideal B₁ := {
    carrier := {x | ∃ hx : x ∈ diagonalKernel h, κ ⟨x, hx⟩ = 0}
    zero_mem' := by
      refine ⟨(diagonalKernel h).zero_mem, ?_⟩
      change κ (0 : diagonalKernel h) = 0
      exact map_zero κ
    add_mem' := by
      intro x y hx hy
      rcases hx with ⟨hxK, hxκ⟩
      rcases hy with ⟨hyK, hyκ⟩
      refine ⟨(diagonalKernel h).add_mem hxK hyK, ?_⟩
      change κ ((⟨x, hxK⟩ : diagonalKernel h) + ⟨y, hyK⟩) = 0
      rw [map_add, hxκ, hyκ, add_zero]
    smul_mem' := by
      intro a x hx
      rcases hx with ⟨hxK, hxκ⟩
      refine ⟨(diagonalKernel h).mul_mem_left a hxK, ?_⟩
      change κ (a • (⟨x, hxK⟩ : diagonalKernel h)) = 0
      rw [map_smul, hxκ, smul_zero]
  }
  have hpow : (diagonalKernel h) ^ (2 : ℕ) ≤ Z := by
    rw [pow_two]
    apply Ideal.mul_le.mpr
    intro x hx y hy
    have hxyK : x * y ∈ diagonalKernel h :=
      (diagonalKernel h).mul_mem_left x hy
    refine ⟨hxyK, ?_⟩
    change (φ.toRingHom (x * y)).2 = 0
    rw [map_mul]
    change (φ.toRingHom x).1 • (φ.toRingHom y).2 +
        MulOpposite.op ((φ.toRingHom y).1) • (φ.toRingHom x).2 = 0
    rw [hKfst ⟨x, hx⟩, hKfst ⟨y, hy⟩]
    simp
  have hdp : secondDividedPowerIdeal B₁.dividedPowers
      (diagonalKernel h ⊓ B₁.ideal) ≤ Z := by
    apply Ideal.span_le.mpr
    rintro z ⟨n, hn, t, ht, rfl⟩
    have htK : t ∈ diagonalKernel h := ht.1
    have htJ : t ∈ B₁.ideal := ht.2
    have hφt0 := hKfst ⟨t, htK⟩
    have hφtJ : φ.toRingHom t ∈ E.ideal :=
      φ.isDPMorphism.ideal_comp (Ideal.mem_map_of_mem _ htJ)
    have hφdp : E.dividedPowers.dpow n (φ.toRingHom t) =
        φ.toRingHom (B₁.dividedPowers.dpow n t) :=
      φ.isDPMorphism.dpow_comp (n := n) t htJ
    have hdpdiag : (B₁.dividedPowers.dpow n t) ∈ diagonalKernel h := by
      rw [RingHom.mem_ker]
      have htzero : (diagonalMap h).toRingHom t = 0 :=
        (RingHom.mem_ker).1 htK
      rw [← (diagonalMap h).isDPMorphism.dpow_comp (n := n) t htJ, htzero]
      exact B.dividedPowers.dpow_eval_zero (by omega)
    refine ⟨hdpdiag, ?_⟩
    change (φ.toRingHom (B₁.dividedPowers.dpow n t)).2 = 0
    rw [← hφdp]
    dsimp [E, secondOrderRing]
    change TrivSqZeroExt.snd
      ((secondOrderDividedPowers B M).dpow n (φ.toRingHom t)) = 0
    rw [secondOrder_dpow_formula B M n (φ.toRingHom t) (by omega) hφtJ]
    change B.dividedPowers.dpow (n - 1) (φ.toRingHom t).1 •
        TrivSqZeroExt.snd (φ.toRingHom t) = 0
    rw [hφt0, B.dividedPowers.dpow_eval_zero (by omega), zero_smul]
  have hsum : (diagonalKernel h) ^ (2 : ℕ) +
      secondDividedPowerIdeal B₁.dividedPowers
        (diagonalKernel h ⊓ B₁.ideal) ≤ Z := sup_le hpow hdp
  have hrel : diagonalRelations h ≤ LinearMap.ker κ := by
    intro k hk
    change (k : B₁) ∈ (diagonalKernel h) ^ (2 : ℕ) +
      secondDividedPowerIdeal B₁.dividedPowers
        (diagonalKernel h ⊓ B₁.ideal) at hk
    exact (hsum hk).2
  letI : IsScalarTower B B₁ M := IsScalarTower.of_algebraMap_smul (by
    intro b m
    change (diagonalMap h).toRingHom (s₀.toRingHom b) • m = b • m
    rw [diagonalMap_s₀])
  let R : diagonalConormal h →ₗ[B] M :=
    (diagonalRelations h).liftQ κ hrel |>.restrictScalars B
  refine ⟨R, ?_⟩
  intro b
  change (diagonalRelations h).liftQ κ hrel
      ((diagonalRelations h).mkQ
        (⟨s₁.toRingHom b - s₀.toRingHom b,
          diagonalDifference_mem h b⟩ : diagonalKernel h)) = _
  rw [Submodule.mkQ_apply, Submodule.liftQ_apply]
  change (φ.toRingHom (s₁.toRingHom b - s₀.toRingHom b)).2 = _
  have hs₀ : φ.toRingHom (s₀.toRingHom b) = ι₀.toRingHom b :=
    congrArg (fun q : B ⟶ E ↦ q.toRingHom b) hφ₀
  have hs₁ : φ.toRingHom (s₁.toRingHom b) = ι₁.toRingHom b :=
    congrArg (fun q : B ⟶ E ↦ q.toRingHom b) hφ₁
  rw [map_sub, hs₁, hs₀]
  change TrivSqZeroExt.snd (graphRingHom D₁ b) -
      TrivSqZeroExt.snd (graphRingHom D₀ b) =
    dividedPowerDifferential (A := A) B.dividedPowers b
  rw [show TrivSqZeroExt.snd (graphRingHom D₀ b) = 0 by rfl, sub_zero]
  rfl


private lemma nonempty_dividedPowerDifferentialsEquivDiagonalConormal
    (h : IsPushout f f s₀ s₁) :
    letI : Algebra A B := f.toRingHom.toAlgebra
    Nonempty
      {e : dividedPowerDifferentials (A := A) B.dividedPowers ≃ₗ[B] diagonalConormal h //
        ∀ b : B,
          e (dividedPowerDifferential (A := A) B.dividedPowers b) = diagonalDifference h b} := by
  let : Algebra A B := f.toRingHom.toAlgebra
  let D := diagonalDifferenceDPDerivation h
  let hex := dividedPowerDifferentials_lift B D
  let L : dividedPowerDifferentials (A := A) B.dividedPowers →ₗ[B]
      diagonalConormal h := Classical.choose hex
  have hL : ∀ b : B,
      L (dividedPowerDifferential (A := A) B.dividedPowers b) =
        diagonalDifference h b := (Classical.choose_spec hex).1
  let invData := diagonalConormalInverseData h
  let R : diagonalConormal h →ₗ[B]
      dividedPowerDifferentials (A := A) B.dividedPowers := invData.1
  have hR : ∀ b : B,
      R (diagonalDifference h b) =
        dividedPowerDifferential (A := A) B.dividedPowers b := invData.2
  have hgen : Submodule.span B
      (Set.range (dividedPowerDifferential (A := A) B.dividedPowers)) = ⊤ := by
    show Submodule.span B (Set.range fun b : B ↦
      (dividedPowerDifferentialRelations (A := A) B.dividedPowers).mkQ
        (KaehlerDifferential.D A B b)) = ⊤
    simpa only [LinearMap.map_span, ← Set.range_comp, Function.comp_def,
      Submodule.map_top, Submodule.range_mkQ] using
      congrArg
        (Submodule.map (dividedPowerDifferentialRelations
          (A := A) B.dividedPowers).mkQ)
        (KaehlerDifferential.span_range_derivation A B)
  have hRL : R.comp L = LinearMap.id := by
    apply LinearMap.ext_on hgen
    rintro _ ⟨b, rfl⟩
    simp only [LinearMap.comp_apply, LinearMap.id_apply, hL b, hR b]
  have hLR : L.comp R = LinearMap.id := by
    apply LinearMap.ext_on (diagonalDifference_span h)
    rintro _ ⟨b, rfl⟩
    simp only [LinearMap.comp_apply, LinearMap.id_apply, hR b, hL b]
  exact ⟨⟨LinearEquiv.ofLinear L R hLR hRL, hL⟩⟩

add_to_stacks 07HT "stability under divided powers" DividedPowers.isSubDPIdeal_ker

/-- Divided power differentials are canonically the conormal module of the diagonal,
modulo the square of its kernel and divided powers of order at least two. -/
@[stacks 07HT "canonical identification"]
public noncomputable def dividedPowerDifferentialsEquivDiagonalConormal
    (h : IsPushout f f s₀ s₁) :
    letI : Algebra A B := f.toRingHom.toAlgebra
    {e : dividedPowerDifferentials (A := A) B.dividedPowers ≃ₗ[B] diagonalConormal h //
      ∀ b : B,
        e (dividedPowerDifferential (A := A) B.dividedPowers b) = diagonalDifference h b} :=
  Classical.choice (by exact nonempty_dividedPowerDifferentialsEquivDiagonalConormal h)

end Pushout

