/-!
# The diagonal of a coproduct of crystalline thickenings, and differentials

Fix an affine crystalline situation with base `(A, I, γ)` and target `C`, and let `X` be a
crystalline thickening of `C` over `A`.  Let `Y` be a coproduct of `X` with itself in the
crystalline category `CRIS(C/A)`, with coprojections `s₀, s₁ : X → Y`, and let `Y → X` be the
diagonal, the map inverting both coprojections.  Write `K` for the kernel of the diagonal on
underlying rings.

The intersection of `K` with the divided power ideal of `Y` is stable under the divided powers of
`Y`, being the intersection of a kernel with the divided power ideal.  And the module of divided
power differentials of `X` over the base is canonically the conormal module of the diagonal: the
quotient of `K` by `K²` together with the divided powers of order at least two of the elements of
`K ∩ I_Y`.  Under that identification the universal divided power differential of `b` is the
class of `s₁ b - s₀ b`.

## Main definitions

* `Crystalline.diagonalMap` — the diagonal out of the coproduct of thickenings.
* `Crystalline.diagonalKernel` — its kernel on underlying rings.
* `Crystalline.diagonalRelations` — the submodule of the kernel generated by its square and the
  divided powers of order at least two.
* `Crystalline.diagonalConormal` — the resulting quotient, the diagonal conormal module.
* `Crystalline.diagonalDifference` — the class of `s₁ b - s₀ b` in that quotient.

## Main results

* `Crystalline.diagonalKernel_isSubDPIdeal` — stability under divided powers.

The canonical identification of divided power differentials with the diagonal conormal module,
`Crystalline.dividedPowerDifferentialsEquivDiagonalConormal`, is in
`StacksFrontier.AlgebraicGeometry.Crystalline.ModuleDifferentials.Thickening.ConormalEquiv`.

## Implementation notes

The coproduct is taken in `CRIS(C/A)` rather than in the category of all divided power rings, so
the diagonal is obtained from the colimit property of the crystalline category while the conormal
module is built from the underlying rings.  The conormal module is regarded as a module over the
ring of `X` through the first coprojection; modulo the square of the diagonal ideal either
coprojection induces the same action.

This file also builds the first-order thickening of `X` by a module `M`: the trivial square-zero
extension of the ring of `X` by `M` with its divided powers, an object of `CRIS(C/A)`, together
with its maps from `X` given by zero and by the graph of a divided power derivation.

The companion statement for a coproduct of divided power rings, rather than of thickenings, lives
in the namespace `Crystalline.Pushout`.

## References

* [Stacks Project, Tag 07HV](https://stacks.math.columbia.edu/tag/07HV)
-/

@[expose] public section

open CategoryTheory
open CategoryTheory.Limits
open DividedPowerRing

universe u v w

namespace Crystalline

open DividedPowerThickening

noncomputable def graphDPMorphism
    {A : Type u} [CommRing A] {D : DividedPowerRing.{v}} {M : Type w}
    [AddCommGroup M] [Module D M] [Module Dᵐᵒᵖ M] [IsCentralScalar D M]
    {f : A →+* D} (d : DividedPowerDerivation A D f M)
    (hdp : ∃ δ : DividedPowers (firstOrderExtensionIdeal D M),
      (∀ (n : ℕ) (b : firstOrderExtension D M), 2 ≤ n →
        b ∈ firstOrderExtensionIdeal D M →
        (δ.dpow n b).fst = D.dividedPowers.dpow n b.fst ∧
          (δ.dpow n b).snd = D.dividedPowers.dpow (n - 1) b.fst • b.snd) ∧
      DividedPowers.IsDPMorphism D.dividedPowers δ
        (algebraMap D (firstOrderExtension D M))) :
    D.dividedPowers.DPMorphism (Classical.choose hdp) := by
  classical
  let δ := Classical.choose hdp
  let J := firstOrderExtensionIdeal D M
  have hcoords := (Classical.choose_spec hdp).1
  refine DividedPowers.DPMorphism.mk' (f := graphRingHom d) ?_
  refine ⟨?_, ?_⟩
  · rw [Ideal.map_le_iff_le_comap]
    intro x hx
    change (TrivSqZeroExt.fstHom D D M).toRingHom (graphRingHom d x) ∈ D.ideal
    exact hx
  · intro n x hx
    have hxT : graphRingHom d x ∈ J := by
      change (TrivSqZeroExt.fstHom D D M).toRingHom (graphRingHom d x) ∈ D.ideal
      exact hx
    by_cases hn0 : n = 0
    · subst n
      rw [δ.dpow_zero hxT, D.dividedPowers.dpow_zero hx]
      exact TrivSqZeroExt.ext rfl d.map_one_eq_zero.symm
    · by_cases hn1 : n = 1
      · subst n
        rw [δ.dpow_one hxT, D.dividedPowers.dpow_one hx]
      · have hn2 : 2 ≤ n := by omega
        have hc := hcoords n (graphRingHom d x) hn2 hxT
        have hc2 : TrivSqZeroExt.snd (δ.dpow n (graphRingHom d x)) =
            D.dividedPowers.dpow (n - 1) x • d x := hc.2
        refine TrivSqZeroExt.ext hc.1 ?_
        rw [hc2]
        change D.dividedPowers.dpow (n - 1) x • d x =
          d (D.dividedPowers.dpow n x)
        exact (d.map_dpow n (by omega) x hx).symm

def firstOrderExtensionQuotientMap
    (D : DividedPowerRing.{u}) (M : Type v) [AddCommGroup M]
    [Module D M] [Module Dᵐᵒᵖ M] [IsCentralScalar D M] :
    (D ⧸ D.ideal) →+* (firstOrderExtension D M ⧸ firstOrderExtensionIdeal D M) :=
  Ideal.quotientMap (firstOrderExtensionIdeal D M) (TrivSqZeroExt.inlHom D M)
    (by
      intro x hx
      change (TrivSqZeroExt.fstHom D D M).toRingHom
        (TrivSqZeroExt.inlHom D M x) ∈ D.ideal
      simpa using hx)

/-- Two elements of the first order extension have the same class modulo its ideal iff their
first coordinates agree modulo the ideal of `D`. -/
private theorem firstOrderExtension_mk_eq_mk_iff
    (D : DividedPowerRing.{u}) (M : Type v) [AddCommGroup M] [Module D M]
    [Module Dᵐᵒᵖ M] [IsCentralScalar D M] (a b : firstOrderExtension D M) :
    Ideal.Quotient.mk (firstOrderExtensionIdeal D M) a =
      Ideal.Quotient.mk (firstOrderExtensionIdeal D M) b ↔ a.fst - b.fst ∈ D.ideal :=
  Ideal.Quotient.mk_eq_mk_iff_sub_mem a b

theorem graphQuotientMap_eq_inl
    {A : Type u} [CommRing A] {D : DividedPowerRing.{v}} {M : Type w}
    [AddCommGroup M] [Module D M] [Module Dᵐᵒᵖ M] [IsCentralScalar D M]
    {f : A →+* D} (d : DividedPowerDerivation A D f M) :
    Ideal.quotientMap (firstOrderExtensionIdeal D M) (graphRingHom d)
      (by
        intro x hx
        change (TrivSqZeroExt.fstHom D D M).toRingHom (graphRingHom d x) ∈ D.ideal
        exact hx) = firstOrderExtensionQuotientMap D M := by
  classical
  ext x
  exact (firstOrderExtension_mk_eq_mk_iff D M _ (TrivSqZeroExt.inlHom D M x)).2
    (by change x - x ∈ D.ideal; simp)

noncomputable abbrev firstOrderExtensionThickening
    {S : AffineCrystallineSituation.{u, v}}
    (X : CrystallineThickening.{u, v, w} S) (M : Type w)
    [AddCommGroup M] [Module X.1.ring M] [Module X.1.ringᵐᵒᵖ M]
    [IsCentralScalar X.1.ring M] : DividedPowerThickening S := by
  classical
  let D := X.1.ring
  let T := firstOrderExtension D M
  let J := firstOrderExtensionIdeal D M
  let hdp := firstOrderExtension_dividedPowers D M
  let δ := Classical.choose hdp
  have hmor := (Classical.choose_spec hdp).2
  let C : DividedPowerRing := ⟨T, J, δ⟩
  let base : DividedPowers.DPMorphism S.A.dividedPowers C.dividedPowers :=
    (DividedPowers.DPMorphism.mk' hmor).comp X.1.fromBase
  have hinl : D.ideal ≤ Ideal.comap (TrivSqZeroExt.inlHom D M) C.ideal := by
    intro x hx
    change (TrivSqZeroExt.fstHom D D M).toRingHom
      (TrivSqZeroExt.inlHom D M x) ∈ D.ideal
    simpa using hx
  let q : (D ⧸ D.ideal) →+* (C ⧸ C.ideal) :=
    firstOrderExtensionQuotientMap D M
  refine ⟨C, base, ?_, q.comp X.1.toQuotient, ?_⟩
  · change IsNilpotent (TrivSqZeroExt.inl (S.p : D))
    simpa [TrivSqZeroExt.algebraMap_eq_inl] using
      X.1.prime_nilpotent.map (algebraMap D T)
  · ext a
    have hxa := congrArg (fun f : S.A →+* D ⧸ D.ideal => (q.comp f) a) X.1.commutes
    have hi : (algebraMap D T : D →+* T) = TrivSqZeroExt.inlHom D M := by
      ext x
      · simp [T, firstOrderExtension, TrivSqZeroExt.algebraMap_eq_inl,
          TrivSqZeroExt.inlHom, TrivSqZeroExt.fst]
      · rfl
    change Ideal.Quotient.mk C.ideal
      (algebraMap D T (X.1.fromBase.toRingHom a)) =
      q (X.1.toQuotient (algebraMap S.A S.C a))
    rw [hi]
    change q (Ideal.Quotient.mk D.ideal (X.1.fromBase.toRingHom a)) =
      q (X.1.toQuotient (algebraMap S.A S.C a)) at hxa
    simp only [DividedPowers.DPMorphism.toRingHom_apply] at hxa
    exact hxa

private theorem firstOrderExtensionQuotient_bijective
    (D : DividedPowerRing.{u}) (M : Type v) [AddCommGroup M] [Module D M]
    [Module Dᵐᵒᵖ M] [IsCentralScalar D M] :
    Function.Bijective (firstOrderExtensionQuotientMap D M) := by
  classical
  constructor
  · intro x y hxy
    obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective x
    obtain ⟨b, rfl⟩ := Ideal.Quotient.mk_surjective y
    simp only [firstOrderExtensionQuotientMap, Ideal.quotientMap_mk] at hxy
    rw [firstOrderExtension_mk_eq_mk_iff] at hxy
    exact (Ideal.Quotient.mk_eq_mk_iff_sub_mem _ _).2 (by simpa using hxy)
  · intro y
    obtain ⟨t, rfl⟩ := Ideal.Quotient.mk_surjective y
    refine ⟨Ideal.Quotient.mk D.ideal t.1, ?_⟩
    simp only [firstOrderExtensionQuotientMap, Ideal.quotientMap_mk]
    exact (firstOrderExtension_mk_eq_mk_iff D M _ _).2 (by change t.1 - t.1 ∈ D.ideal; simp)

theorem firstOrderExtensionThickening_isCrystalline
    {S : AffineCrystallineSituation.{u, v}}
    (X : CrystallineThickening.{u, v, w} S) (M : Type w)
    [AddCommGroup M] [Module X.1.ring M] [Module X.1.ringᵐᵒᵖ M]
    [IsCentralScalar X.1.ring M] :
    DividedPowerThickening.IsCrystalline
      (firstOrderExtensionThickening X M) := by
  change Function.Bijective
    ((firstOrderExtensionQuotientMap X.1.ring M).comp X.1.toQuotient)
  exact (firstOrderExtensionQuotient_bijective X.1.ring M).comp X.property

noncomputable def firstOrderExtensionCrystalline
    {S : AffineCrystallineSituation.{u, v}}
    (X : CrystallineThickening.{u, v, w} S) (M : Type w)
    [AddCommGroup M] [Module X.1.ring M] [Module X.1.ringᵐᵒᵖ M]
    [IsCentralScalar X.1.ring M] : CrystallineThickening S :=
  ⟨firstOrderExtensionThickening X M,
    firstOrderExtensionThickening_isCrystalline X M⟩

noncomputable def firstOrderExtensionMapZero
    {S : AffineCrystallineSituation.{u, v}}
    (X : CrystallineThickening.{u, v, w} S) (M : Type w)
    [AddCommGroup M] [Module X.1.ring M] [Module X.1.ringᵐᵒᵖ M]
    [IsCentralScalar X.1.ring M] :
    X.1 ⟶ firstOrderExtensionThickening X M := by
  classical
  let D := X.1.ring
  let hdp := firstOrderExtension_dividedPowers D M
  let δ := Classical.choose hdp
  have hmor := (Classical.choose_spec hdp).2
  let f : DividedPowers.DPMorphism D.dividedPowers δ :=
    DividedPowers.DPMorphism.mk' hmor
  let E := firstOrderExtensionThickening X M
  refine { hom := f, fromBase_comp := ?_, toQuotient_comp := ?_ }
  · rfl
  · change (Ideal.quotientMap E.ring.ideal f.toRingHom
      (Ideal.map_le_iff_le_comap.mp f.ideal_comp)).comp X.1.toQuotient =
      E.toQuotient
    rfl

noncomputable def firstOrderExtensionMapGraph
    {S : AffineCrystallineSituation.{u, v}}
    (X : CrystallineThickening.{u, v, w} S) (M : Type w)
    [AddCommGroup M] [Module X.1.ring M] [Module X.1.ringᵐᵒᵖ M]
    [IsCentralScalar X.1.ring M]
    (d : DividedPowerDerivation S.A X.1.ring
      X.1.fromBase.toRingHom M) :
    X.1 ⟶ firstOrderExtensionThickening X M := by
  classical
  let D := X.1.ring
  let hdp := firstOrderExtension_dividedPowers D M
  let f := graphDPMorphism d hdp
  let E := firstOrderExtensionThickening X M
  refine { hom := f, fromBase_comp := ?_, toQuotient_comp := ?_ }
  · apply DividedPowers.DPMorphism.ext
    funext a
    apply TrivSqZeroExt.ext
    · rfl
    · exact d.map_ringHom a
  · change (Ideal.quotientMap E.ring.ideal f.toRingHom
      (Ideal.map_le_iff_le_comap.mp f.ideal_comp)).comp X.1.toQuotient =
      E.toQuotient
    change (Ideal.quotientMap (firstOrderExtensionIdeal D M)
      (graphRingHom d) _).comp X.1.toQuotient =
      (firstOrderExtensionQuotientMap D M).comp X.1.toQuotient
    rw [graphQuotientMap_eq_inl d]

variable {S : AffineCrystallineSituation.{u, v}}
variable {X Y : CrystallineThickening.{u, v, w} S}
variable {s₀ s₁ : X ⟶ Y}

/-- The diagonal map from a coproduct of a thickening with itself. -/
public noncomputable def diagonalMap (h : IsColimit (BinaryCofan.mk s₀ s₁)) : Y ⟶ X :=
  BinaryCofan.IsColimit.desc h (𝟙 X) (𝟙 X)

/-- The kernel of the diagonal map of affine crystalline thickenings. -/
public noncomputable abbrev diagonalKernel (h : IsColimit (BinaryCofan.mk s₀ s₁)) :
    Ideal Y.1.ring :=
  RingHom.ker (diagonalMap h).hom.hom.toRingHom

/-- The square and higher divided-power relations inside the diagonal kernel. -/
public noncomputable def diagonalRelations (h : IsColimit (BinaryCofan.mk s₀ s₁)) :
    Submodule Y.1.ring (diagonalKernel h) :=
  Submodule.comap
    (Submodule.subtype ((diagonalKernel h : Ideal Y.1.ring) : Submodule Y.1.ring Y.1.ring))
    ((((diagonalKernel h) ^ (2 : ℕ)) +
      secondDividedPowerIdeal Y.1.ring.dividedPowers
        (diagonalKernel h ⊓ Y.1.ring.ideal) : Ideal Y.1.ring) : Submodule Y.1.ring Y.1.ring)

/-- The diagonal conormal module, with its `X.1.ring`-module structure induced by the
first coprojection. -/
public noncomputable def diagonalConormal (h : IsColimit (BinaryCofan.mk s₀ s₁)) :
    Type w :=
  RestrictScalars X.1.ring Y.1.ring ((diagonalKernel h) ⧸ diagonalRelations h)

/-- The additive group structure on the diagonal conormal module. -/
public noncomputable instance (h : IsColimit (BinaryCofan.mk s₀ s₁)) :
    AddCommGroup (diagonalConormal h) :=
  inferInstanceAs (AddCommGroup
    (RestrictScalars X.1.ring Y.1.ring ((diagonalKernel h) ⧸ diagonalRelations h)))

/-- The `X.1.ring`-module structure on the diagonal conormal module, by restriction of
scalars along the first coprojection. -/
public noncomputable instance (h : IsColimit (BinaryCofan.mk s₀ s₁)) :
    Module X.1.ring (diagonalConormal h) := by
  letI : Algebra X.1.ring Y.1.ring := s₀.hom.hom.toRingHom.toAlgebra
  exact inferInstanceAs (Module X.1.ring
    (RestrictScalars X.1.ring Y.1.ring ((diagonalKernel h) ⧸ diagonalRelations h)))

/-- The class of the difference of the two coprojections in the diagonal conormal module. -/
public noncomputable def diagonalDifference (h : IsColimit (BinaryCofan.mk s₀ s₁))
    (b : X.1.ring) : diagonalConormal h :=
  Submodule.Quotient.mk ⟨s₁.hom.hom b - s₀.hom.hom b, by
    rw [RingHom.mem_ker]
    change (diagonalMap h).hom.hom.toRingHom
      (s₁.hom.hom.toRingHom b - s₀.hom.hom.toRingHom b) = 0
    rw [map_sub]
    have h₁ : s₁ ≫ diagonalMap h = 𝟙 X := BinaryCofan.IsColimit.inr_desc h (𝟙 X) (𝟙 X)
    have h₀ : s₀ ≫ diagonalMap h = 𝟙 X := BinaryCofan.IsColimit.inl_desc h (𝟙 X) (𝟙 X)
    have hb₁ := congrArg (fun q : X ⟶ X ↦ q.hom.hom.toRingHom b) h₁
    have hb₀ := congrArg (fun q : X ⟶ X ↦ q.hom.hom.toRingHom b) h₀
    change (diagonalMap h).hom.hom.toRingHom (s₁.hom.hom.toRingHom b) = b at hb₁
    change (diagonalMap h).hom.hom.toRingHom (s₀.hom.hom.toRingHom b) = b at hb₀
    rw [hb₁, hb₀, sub_self]⟩

noncomputable def diagonalClassRep
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CrystallineThickening.{u, v, w} S}
    {s₀ s₁ : X ⟶ Y} (h : IsColimit (BinaryCofan.mk s₀ s₁))
    (y : Y.1.ring) : diagonalKernel h :=
  ⟨y - s₀.hom.hom ((diagonalMap h).hom.hom y), by
    rw [RingHom.mem_ker]
    change (diagonalMap h).hom.hom.toRingHom
      (y - s₀.hom.hom.toRingHom ((diagonalMap h).hom.hom y)) = 0
    rw [map_sub]
    have hs₀ : (diagonalMap h).hom.hom.toRingHom
        (s₀.hom.hom.toRingHom ((diagonalMap h).hom.hom.toRingHom y)) =
        (diagonalMap h).hom.hom.toRingHom y := by
      have hc : s₀ ≫ diagonalMap h = 𝟙 X :=
        BinaryCofan.IsColimit.inl_desc h (𝟙 X) (𝟙 X)
      have hb := congrArg (fun q : X ⟶ X => q.hom.hom.toRingHom
        ((diagonalMap h).hom.hom.toRingHom y)) hc
      change (diagonalMap h).hom.hom.toRingHom
        (s₀.hom.hom.toRingHom ((diagonalMap h).hom.hom.toRingHom y)) = _ at hb
      exact hb
    change (diagonalMap h).hom.hom.toRingHom y -
      (diagonalMap h).hom.hom.toRingHom
        (s₀.hom.hom.toRingHom ((diagonalMap h).hom.hom.toRingHom y)) = 0
    rw [hs₀, sub_self]⟩

noncomputable def diagonalClass
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CrystallineThickening.{u, v, w} S}
    {s₀ s₁ : X ⟶ Y} (h : IsColimit (BinaryCofan.mk s₀ s₁))
    (y : Y.1.ring) : diagonalConormal h :=
  Submodule.Quotient.mk (diagonalClassRep h y)

theorem diagonalClass_add
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CrystallineThickening.{u, v, w} S}
    {s₀ s₁ : X ⟶ Y} (h : IsColimit (BinaryCofan.mk s₀ s₁))
    (y z : Y.1.ring) :
    diagonalClass h (y + z) = diagonalClass h y + diagonalClass h z := by
  dsimp only [diagonalClass]
  change Submodule.Quotient.mk (diagonalClassRep h (y + z)) =
    Submodule.Quotient.mk (diagonalClassRep h y + diagonalClassRep h z)
  apply congrArg Submodule.Quotient.mk
  apply Subtype.ext
  dsimp only [diagonalClassRep]
  change y + z - s₀.hom.hom.toRingHom
      ((diagonalMap h).hom.hom.toRingHom (y + z)) =
    (y - s₀.hom.hom.toRingHom ((diagonalMap h).hom.hom.toRingHom y)) +
      (z - s₀.hom.hom.toRingHom ((diagonalMap h).hom.hom.toRingHom z))
  rw [map_add ((diagonalMap h).hom.hom.toRingHom) y z]
  rw [map_add s₀.hom.hom.toRingHom
    ((diagonalMap h).hom.hom.toRingHom y) ((diagonalMap h).hom.hom.toRingHom z)]
  abel_nf

noncomputable def diagonalConormalAddEquiv
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CrystallineThickening.{u, v, w} S}
    {s₀ s₁ : X ⟶ Y} (h : IsColimit (BinaryCofan.mk s₀ s₁)) :
    diagonalConormal h ≃+ (diagonalKernel h) ⧸ diagonalRelations h :=
  { toFun := fun x => x
    invFun := fun x => x
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl
    map_add' := by intros; rfl }

noncomputable def diagonalConormalLinearEquiv
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CrystallineThickening.{u, v, w} S}
    {s₀ s₁ : X ⟶ Y} (h : IsColimit (BinaryCofan.mk s₀ s₁)) :
    letI : Algebra X.1.ring Y.1.ring := s₀.hom.hom.toRingHom.toAlgebra
    diagonalConormal h ≃ₗ[X.1.ring]
      (diagonalKernel h) ⧸ diagonalRelations h := by
  letI : Algebra X.1.ring Y.1.ring := s₀.hom.hom.toRingHom.toAlgebra
  letI : Module X.1.ring ((diagonalKernel h) ⧸ diagonalRelations h) :=
    Module.compHom ((diagonalKernel h) ⧸ diagonalRelations h)
      s₀.hom.hom.toRingHom
  refine { toAddEquiv := diagonalConormalAddEquiv h, map_smul' := ?_ }
  intro a x
  rfl

theorem diagonalConormalLinearEquiv_apply
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CrystallineThickening.{u, v, w} S}
    {s₀ s₁ : X ⟶ Y} (h : IsColimit (BinaryCofan.mk s₀ s₁))
    (x : diagonalConormal h) : diagonalConormalLinearEquiv h x = x := rfl

/-- A class in the diagonal conormal module is a combination of two others, with coefficients in
`X.1.ring`, as soon as the difference of representatives lies in the relations. -/
private theorem diagonalClass_eq_smul_add_smul
    (h : IsColimit (BinaryCofan.mk s₀ s₁)) (w z z' : Y.1.ring) (a b : X.1.ring)
    (hmem : (diagonalClassRep h w : Y.1.ring) -
      (s₀.hom.hom a * diagonalClassRep h z + s₀.hom.hom b * diagonalClassRep h z') ∈
      diagonalKernel h ^ (2 : ℕ) + secondDividedPowerIdeal Y.1.ring.dividedPowers
        (diagonalKernel h ⊓ Y.1.ring.ideal)) :
    diagonalClass h w = a • diagonalClass h z + b • diagonalClass h z' := by
  let : Algebra X.1.ring Y.1.ring := s₀.hom.hom.toRingHom.toAlgebra
  let : Module X.1.ring ((diagonalKernel h) ⧸ diagonalRelations h) :=
    Module.compHom ((diagonalKernel h) ⧸ diagonalRelations h)
      s₀.hom.hom.toRingHom
  apply (diagonalConormalLinearEquiv h).injective
  rw [(diagonalConormalLinearEquiv h).map_add, (diagonalConormalLinearEquiv h).map_smul,
    (diagonalConormalLinearEquiv h).map_smul, diagonalConormalLinearEquiv_apply,
    diagonalConormalLinearEquiv_apply, diagonalConormalLinearEquiv_apply]
  change Submodule.Quotient.mk (diagonalClassRep h w) =
    s₀.hom.hom.toRingHom a • (Submodule.Quotient.mk (diagonalClassRep h z) :
          (diagonalKernel h) ⧸ diagonalRelations h) +
      s₀.hom.hom.toRingHom b • (Submodule.Quotient.mk (diagonalClassRep h z') :
          (diagonalKernel h) ⧸ diagonalRelations h)
  rw [← Submodule.Quotient.mk_smul (R := Y.1.ring)
      (M := diagonalKernel h) (p := diagonalRelations h) (S := Y.1.ring),
    ← Submodule.Quotient.mk_smul (R := Y.1.ring)
      (M := diagonalKernel h) (p := diagonalRelations h) (S := Y.1.ring),
    ← Submodule.Quotient.mk_add]
  exact (Submodule.Quotient.eq (diagonalRelations h)).2 hmem

theorem diagonalClass_mul
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CrystallineThickening.{u, v, w} S}
    {s₀ s₁ : X ⟶ Y} (h : IsColimit (BinaryCofan.mk s₀ s₁))
    (y z : Y.1.ring) :
    diagonalClass h (y * z) =
      (diagonalMap h).hom.hom y • diagonalClass h z +
        (diagonalMap h).hom.hom z • diagonalClass h y := by
  refine diagonalClass_eq_smul_add_smul h _ _ _ _ _ ?_
  have heq : (diagonalClassRep h (y * z) : Y.1.ring) -
      (s₀.hom.hom ((diagonalMap h).hom.hom y) * diagonalClassRep h z +
        s₀.hom.hom ((diagonalMap h).hom.hom z) * diagonalClassRep h y) =
      (diagonalClassRep h y : Y.1.ring) * (diagonalClassRep h z : Y.1.ring) := by
    change (y * z - s₀.hom.hom.toRingHom
        ((diagonalMap h).hom.hom.toRingHom (y * z))) -
      (s₀.hom.hom.toRingHom ((diagonalMap h).hom.hom.toRingHom y) *
          (z - s₀.hom.hom.toRingHom ((diagonalMap h).hom.hom.toRingHom z)) +
        s₀.hom.hom.toRingHom ((diagonalMap h).hom.hom.toRingHom z) *
          (y - s₀.hom.hom.toRingHom ((diagonalMap h).hom.hom.toRingHom y))) =
      (y - s₀.hom.hom.toRingHom ((diagonalMap h).hom.hom.toRingHom y)) *
        (z - s₀.hom.hom.toRingHom ((diagonalMap h).hom.hom.toRingHom z))
    rw [map_mul ((diagonalMap h).hom.hom.toRingHom) y z, map_mul s₀.hom.hom.toRingHom]
    ring
  rw [heq, pow_two]
  exact Submodule.mem_sup_left (Ideal.mul_mem_mul (diagonalClassRep h y).property
    (diagonalClassRep h z).property)

theorem diagonalClass_dpow
    {S : AffineCrystallineSituation.{u, v}}
    {X Y : CrystallineThickening.{u, v, w} S}
    {s₀ s₁ : X ⟶ Y} (h : IsColimit (BinaryCofan.mk s₀ s₁))
    (n : ℕ) (y : Y.1.ring) (hn : 2 ≤ n) (hy : y ∈ Y.1.ring.ideal) :
    diagonalClass h (Y.1.ring.dividedPowers.dpow n y) =
      X.1.ring.dividedPowers.dpow (n - 1) ((diagonalMap h).hom.hom y) •
        diagonalClass h y := by
  refine (diagonalClass_eq_smul_add_smul h _ y y
    (X.1.ring.dividedPowers.dpow (n - 1) ((diagonalMap h).hom.hom y)) 0 ?_).trans
    (by rw [zero_smul, add_zero])
  rw [show s₀.hom.hom 0 = 0 from map_zero s₀.hom.hom.toRingHom, zero_mul, add_zero]
  let q := (diagonalMap h).hom.hom.toRingHom
  let a := s₀.hom.hom.toRingHom (q y)
  let k := diagonalClassRep h y
  let I₂ := secondDividedPowerIdeal Y.1.ring.dividedPowers
    (diagonalKernel h ⊓ Y.1.ring.ideal)
  have hqy : q y ∈ X.1.ring.ideal :=
    (Ideal.map_le_iff_le_comap.mp (diagonalMap h).hom.hom.ideal_comp) hy
  have ha : a ∈ Y.1.ring.ideal :=
    (Ideal.map_le_iff_le_comap.mp s₀.hom.hom.ideal_comp) hqy
  have hkK : (k : Y.1.ring) ∈ diagonalKernel h := k.property
  have hkI : (k : Y.1.ring) ∈ Y.1.ring.ideal := by
    dsimp [k, diagonalClassRep]
    exact sub_mem hy ha
  have hyak : y = a + (k : Y.1.ring) := by
    change y = s₀.hom.hom.toRingHom (q y) +
      (y - s₀.hom.hom.toRingHom (q y))
    abel
  let F (i : ℕ) := Y.1.ring.dividedPowers.dpow i a *
    Y.1.ring.dividedPowers.dpow (n - i) (k : Y.1.ring)
  have hadd : Y.1.ring.dividedPowers.dpow n y =
      ∑ i ∈ Finset.range (n + 1), F i := by
    rw [hyak]
    exact Y.1.ring.dividedPowers.dpow_add' ha hkI
  have hsplit : (∑ i ∈ Finset.range (n + 1), F i) =
      (∑ i ∈ Finset.range (n - 1), F i) + F (n - 1) + F n := by
    rw [show n + 1 = (n - 1 + 1) + 1 by omega,
      Finset.sum_range_succ, Finset.sum_range_succ]
    simp only [show n - 1 + 1 = n by omega]
  have hFn : F n = Y.1.ring.dividedPowers.dpow n a := by
    dsimp [F]
    rw [Nat.sub_self, Y.1.ring.dividedPowers.dpow_zero hkI, mul_one]
  have hFnm1 : F (n - 1) =
      Y.1.ring.dividedPowers.dpow (n - 1) a * (k : Y.1.ring) := by
    dsimp [F]
    rw [show n - (n - 1) = 1 by omega,
      Y.1.ring.dividedPowers.dpow_one hkI]
  have hcalc : Y.1.ring.dividedPowers.dpow n y -
      Y.1.ring.dividedPowers.dpow n a -
        Y.1.ring.dividedPowers.dpow (n - 1) a * (k : Y.1.ring) =
      ∑ i ∈ Finset.range (n - 1), F i := by
    rw [hadd, hsplit, hFnm1, hFn]
    ring
  have htail : (∑ i ∈ Finset.range (n - 1), F i) ∈ I₂ := by
    apply Submodule.sum_mem
    intro i hi
    have hi' : i < n - 1 := Finset.mem_range.mp hi
    have hgen : Y.1.ring.dividedPowers.dpow (n - i) (k : Y.1.ring) ∈ I₂ := by
      change Y.1.ring.dividedPowers.dpow (n - i) (k : Y.1.ring) ∈
        Ideal.span {z | ∃ m, 2 ≤ m ∧ ∃ x, x ∈ diagonalKernel h ⊓ Y.1.ring.ideal ∧
          z = Y.1.ring.dividedPowers.dpow m x}
      apply Ideal.subset_span
      exact ⟨n - i, by omega, k, ⟨hkK, hkI⟩, rfl⟩
    exact I₂.mul_mem_left (Y.1.ring.dividedPowers.dpow i a) hgen
  have hqdp : q (Y.1.ring.dividedPowers.dpow n y) =
      X.1.ring.dividedPowers.dpow n (q y) :=
    (diagonalMap h).hom.hom.isDPMorphism.dpow_comp y hy |>.symm
  have hs₀dp : ∀ m : ℕ, s₀.hom.hom.toRingHom
      (X.1.ring.dividedPowers.dpow m (q y)) =
      Y.1.ring.dividedPowers.dpow m a := by
    intro m
    simpa [a] using
      (s₀.hom.hom.isDPMorphism.dpow_comp (q y) hqy).symm
  have hrep : (diagonalClassRep h (Y.1.ring.dividedPowers.dpow n y) : Y.1.ring) =
      Y.1.ring.dividedPowers.dpow n y - Y.1.ring.dividedPowers.dpow n a := by
    change Y.1.ring.dividedPowers.dpow n y -
      s₀.hom.hom.toRingHom (q (Y.1.ring.dividedPowers.dpow n y)) = _
    rw [hqdp, hs₀dp n]
  change ((diagonalClassRep h (Y.1.ring.dividedPowers.dpow n y) : Y.1.ring) -
      s₀.hom.hom.toRingHom
        (X.1.ring.dividedPowers.dpow (n - 1) (q y)) * (k : Y.1.ring)) ∈
    diagonalKernel h ^ (2 : ℕ) + I₂
  rw [hrep, hs₀dp (n - 1), hcalc]
  exact Submodule.mem_sup_right htail

/-- The intersection of the diagonal ideal with the crystalline divided power ideal is
stable under divided powers. -/
@[stacks 07HV "stability under divided powers"]
public theorem diagonalKernel_isSubDPIdeal
    (h : IsColimit (BinaryCofan.mk s₀ s₁)) :
    Y.1.ring.dividedPowers.IsSubDPIdeal (diagonalKernel h ⊓ Y.1.ring.ideal) :=
  DividedPowers.isSubDPIdeal_ker Y.1.ring.dividedPowers
    (hJ := X.1.ring.dividedPowers) (diagonalMap h).hom.hom.isDPMorphism

end Crystalline

