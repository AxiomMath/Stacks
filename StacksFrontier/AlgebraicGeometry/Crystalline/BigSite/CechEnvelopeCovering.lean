/-!
# The smooth lifts of an affine open cover cover the final sheaf of the big crystalline site

Fix a global crystalline situation `(p, (S, I, γ), X)` with `S` affine and `p` nilpotent in
`A = Γ(S, ⊤)`, a family `{U_i}` of affine opens covering `X`, and for every `i` a smooth lift
`L_i` of `U_i` (`Crystalline.GlobalCrystallineSituation.CechEnvelope.SmoothLift`), with its object
`D_i = (U_i, Spec B_i, γ_i)` of `CRIS(X/S)`.  This file proves that the family `{D_i}` covers the
final object of the topos of `CRIS(X/S)` (`CechEnvelope.coversTop_object`): every object `T` has a
Zariski covering by objects each of which maps to some `D_i`.

The covering is by the restrictions of `T` to affine opens `W` of its ambient scheme whose
thickened part maps into some `U_i`.  A morphism `T|_W ⟶ D_i` is a divided power morphism
`B_i → Γ(W, 𝒪)` over `A` lifting `B_i → B_i/IB_i ≅ Γ(U_i) → Γ(W)/J`, `J` the divided power ideal:
the lift exists because `B_i` is smooth and `J` is locally nilpotent
(`CechEnvelope.exists_algHom_lift_of_locallyNilpotent`), and any such lift is a divided power
morphism because `IB_i` is generated by the image of `I` and `γ_i` extends `γ`
(`CechEnvelope.SmoothLift.nonempty_hom_thickening`).  The affine-to-global bridge
(`Crystalline.GlobalCrystallineSituation.homOfAffineSections`) realises it as a morphism of
`CRIS(X/S)` (`CechEnvelope.SmoothLift.nonempty_hom_object`).

## Main results

* `CechEnvelope.exists_algHom_lift_of_locallyNilpotent` — a smooth algebra lifts along a
  surjection with locally nilpotent kernel: finitely many lifted relations generate a nilpotent
  ideal.
* `CechEnvelope.SmoothLift.nonempty_hom_object` — every object with affine thickened scheme whose
  map to `X` factors through `U` maps to the object of a smooth lift of `U`.
* **`CechEnvelope.coversTop_object`** — the objects of the smooth lifts of an affine open cover
  cover the final sheaf of `CRIS(X/S)`.

## References

* [Stacks Project, Tag 07N5](https://stacks.math.columbia.edu/tag/07N5)
* [Stacks Project, Tag 07MW](https://stacks.math.columbia.edu/tag/07MW)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open scoped AlgebraicGeometry

universe u

namespace Crystalline.GlobalCrystallineSituation.CechEnvelope

/-- **A smooth algebra lifts along a surjection with locally nilpotent kernel.** If `A` is a
formally smooth `R`-algebra of finite presentation and `I` is a locally nilpotent ideal of `B`,
then every `R`-algebra map `A → B ⧸ I` lifts to an `R`-algebra map `A → B`. -/
@[ega "0 19.0.1" "affine case, partial", ega "0 19.3.10.1" "special case", ega "0 22.6.9" "partial"]
theorem exists_algHom_lift_of_locallyNilpotent {R A B : Type*} [CommRing R] [CommRing A]
    [CommRing B] [Algebra R A] [Algebra R B] [Algebra.FormallySmooth R A]
    [Algebra.FinitePresentation R A] (I : Ideal B) (hI : I.LocallyNilpotent)
    (g : A →ₐ[R] B ⧸ I) : ∃ h : A →ₐ[R] B, (Ideal.Quotient.mkₐ R I).comp h = g := by
  classical
  obtain ⟨n, f, hf, hK⟩ := Algebra.FinitePresentation.out (R := R) (A := A)
  choose b hb using fun k : Fin n ↦ Ideal.Quotient.mk_surjective (g (f (MvPolynomial.X k)))
  let φ : MvPolynomial (Fin n) R →ₐ[R] B := MvPolynomial.aeval b
  have hφ : (Ideal.Quotient.mkₐ R I).comp φ = g.comp f :=
    MvPolynomial.algHom_ext fun k ↦ by simp [φ, hb]
  have hφx : ∀ x, Ideal.Quotient.mk I (φ x) = g (f x) := fun x ↦ by
    simpa only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] using AlgHom.congr_fun hφ x
  obtain ⟨s, hs⟩ := hK
  replace hs : Ideal.span (s : Set (MvPolynomial (Fin n) R)) = RingHom.ker f := hs
  let I' : Ideal B := Ideal.span (φ '' (s : Set (MvPolynomial (Fin n) R)))
  have hker : ∀ x ∈ RingHom.ker f, Ideal.Quotient.mk I (φ x) = 0 := fun x hx ↦ by
    rw [hφx, show f x = 0 from hx, map_zero]
  have hI'I : I' ≤ I := Ideal.span_le.mpr fun y hy ↦ by
    obtain ⟨x, hx, rfl⟩ := hy
    exact Ideal.Quotient.eq_zero_iff_mem.mp (hker x (hs ▸ Ideal.subset_span hx))
  have hnil : IsNilpotent I' :=
    (Ideal.FG.isNilpotent_iff_le_nilradical ⟨s.image φ, by simp [I', Finset.coe_image]⟩).mpr
      fun x hx ↦ mem_nilradical.mpr (hI x (hI'I hx))
  have hKI' : RingHom.ker f ≤ RingHom.ker ((Ideal.Quotient.mkₐ R I').comp φ) := by
    rw [← hs, Ideal.span_le]
    intro x hx
    show Ideal.Quotient.mk I' (φ x) = 0
    exact Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨x, hx, rfl⟩)
  let ψ : A →ₐ[R] B ⧸ I' :=
    (Ideal.Quotient.liftₐ (RingHom.ker f) ((Ideal.Quotient.mkₐ R I').comp φ)
      fun x hx ↦ RingHom.mem_ker.mp (hKI' hx)).comp
      (Ideal.quotientKerAlgEquivOfSurjective hf).symm.toAlgHom
  have hψ : ∀ x, ψ (f x) = Ideal.Quotient.mk I' (φ x) := fun x ↦ by
    have : f x = (Ideal.quotientKerAlgEquivOfSurjective hf)
        (Ideal.Quotient.mk (RingHom.ker f) x) := rfl
    show Ideal.Quotient.liftₐ (R₁ := R) (RingHom.ker f)
      ((Ideal.Quotient.mkₐ R I').comp φ) (fun x hx ↦ RingHom.mem_ker.mp (hKI' hx))
      ((Ideal.quotientKerAlgEquivOfSurjective hf).symm (f x)) = _
    rw [this, AlgEquiv.symm_apply_apply]
    rfl
  refine ⟨Algebra.FormallySmooth.lift I' hnil ψ, AlgHom.ext fun a ↦ ?_⟩
  obtain ⟨x, rfl⟩ := hf a
  have h := congrArg (Ideal.Quotient.factor hI'I)
    ((AlgHom.congr_fun (Algebra.FormallySmooth.comp_lift I' hnil ψ) (f x)).trans (hψ x))
  simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk, Ideal.Quotient.factor_mk] at h ⊢
  rw [h, hφx]

open SmallSite

variable {S : GlobalCrystallineSituation.{u}} [IsAffine S.S.scheme]
  (hp : IsNilpotent (S.p : Γ(S.S.scheme, ⊤)))

namespace SmoothLift

variable {U : Scheme.{u}} {j : U ⟶ S.X} [IsAffine U] (L : SmoothLift S j)

omit [IsAffine U] [IsAffine S.S.scheme] in
/-- **The thickening of a smooth lift maps to every object of `CRIS(Γ(U, ⊤)/A)`.** -/
theorem nonempty_hom_thickening
    (Q : DividedPowerThickening.{u, u, u}
      (affineSituation (overSituation S j) (isNilpotent_prime_over S j hp))) :
    Nonempty (L.thickening hp ⟶ Q) := by
  let : Algebra (baseSectionsRing S) Q.ring := Q.fromBase.toRingHom.toAlgebra
  have := L.smooth
  have hC : ∀ a : baseSectionsRing S,
      Q.toQuotient ((sourceToBase (overSituation S j)).appTop.hom a) =
        Ideal.Quotient.mk Q.ring.ideal (Q.fromBase a) := fun a ↦
    (RingHom.congr_fun Q.commutes a).symm
  let ψ : L.ring →ₐ[baseSectionsRing S] Q.ring ⧸ Q.ring.ideal :=
    { toRingHom := Q.toQuotient.comp (L.equiv.symm.toRingHom.comp (Ideal.Quotient.mk _))
      commutes' := fun a ↦ by
        show Q.toQuotient (L.equiv.symm (Ideal.Quotient.mk _ (algebraMap _ L.ring a))) = _
        rw [← L.equiv_sourceToBase a, RingEquiv.symm_apply_apply, hC]
        rfl }
  obtain ⟨h, hh⟩ := exists_algHom_lift_of_locallyNilpotent Q.ring.ideal
    (locallyNilpotent_ideal (isNilpotent_prime_over S j hp) Q) ψ
  have hcomp : h.toRingHom.comp (algebraMap (baseSectionsRing S) L.ring) = Q.fromBase.toRingHom :=
    RingHom.ext h.commutes
  have hDP : DividedPowers.IsDPMorphism L.dividedPowerRing.dividedPowers Q.ring.dividedPowers
      h.toRingHom :=
    DividedPowers.IsDPMorphism.of_comp (baseSectionsRing S).dividedPowers _ _
      (algebraMap (baseSectionsRing S) L.ring) h.toRingHom rfl
      L.isDPMorphism_algebraMap (hcomp ▸ Q.fromBase.isDPMorphism)
  refine ⟨{ hom := DividedPowers.DPMorphism.mk' hDP
            fromBase_comp := by
              ext a
              exact h.commutes a
            toQuotient_comp := RingHom.ext fun c ↦ ?_ }⟩
  obtain ⟨b, hb⟩ := Ideal.Quotient.mk_surjective (L.equiv c)
  have h1 := AlgHom.congr_fun hh b
  simp only [AlgHom.comp_apply, Ideal.Quotient.mkₐ_eq_mk] at h1
  show DividedPowerRing.quotientRingHom (DividedPowers.DPMorphism.mk' hDP) (L.equiv c) = _
  rw [← hb]
  show Ideal.Quotient.mk Q.ring.ideal (h b) = _
  rw [h1]
  show Q.toQuotient (L.equiv.symm (Ideal.Quotient.mk _ b)) = _
  rw [hb]
  exact congrArg Q.toQuotient (L.equiv.symm_apply_apply (c : Γ(U, ⊤)))

/-- **Every object of `CRIS(X/S)` with affine thickened scheme whose map to `X` factors through
`j` maps to the object of a smooth lift.** -/
theorem nonempty_hom_object (T : Thickening S) [IsAffine T.thickening.source]
    (t : T.thickening.source ⟶ U) (ht : t ≫ j = T.toX) : Nonempty (T ⟶ L.object hp) := by
  have : IsAffine (overLift S j T t ht).thickening.source :=
    inferInstanceAs (IsAffine T.thickening.source)
  have : IsIso (specThickeningOfAffine (isNilpotent_prime_over S j hp) (L.thickening hp)).toX :=
    L.isIso_specToX hp
  have : IsAffine (specThickeningOfAffine (isNilpotent_prime_over S j hp)
      (L.thickening hp)).thickening.source := inferInstanceAs (IsAffine (Spec _))
  obtain ⟨g⟩ := L.nonempty_hom_thickening hp
    (wholeThickeningToAffine (isNilpotent_prime_over S j hp) (overLift S j T t ht))
  exact ⟨homOfOverLift S j (homOfAffineSections (isNilpotent_prime_over S j hp)
    ((wholeThickeningToAffineSpecIso (isNilpotent_prime_over S j hp) (L.thickening hp)).hom ≫ g))⟩

end SmoothLift

/-- **The objects of the smooth lifts of an affine open cover of `X` cover the final sheaf of the
big crystalline site.** -/
theorem coversTop_object {ι : Type*} (U : ι → S.X.Opens) [∀ i, IsAffine (U i)]
    (hU : ∀ x, ∃ i, x ∈ U i) (L : ∀ i, SmoothLift S (U i).ι) :
    (topology S).CoversTop fun i ↦ (L i).object hp := by
  intro T
  have key : ∀ x : T.thickening.source, ∃ (W : T.thickening.target.scheme.affineOpens) (i : ι),
      T.thickening.immersion x ∈ (W : T.thickening.target.scheme.Opens) ∧
      T.thickening.immersion ⁻¹ᵁ (W : T.thickening.target.scheme.Opens) ≤ T.toX ⁻¹ᵁ U i := by
    intro x
    obtain ⟨i, hi⟩ := hU (T.toX x)
    obtain ⟨W, hxW, -, hWU⟩ := exists_affineOpen_ambient T x ⊤ (U i) trivial hi
    exact ⟨W, i, hxW, hWU⟩
  choose W i hxW hWU using key
  let E := T.restrictOpenCover
    fun x : ULift.{u + 1} T.thickening.source ↦ (W x.down : T.thickening.target.scheme.Opens)
  have hE : Thickening.IsZariskiCovering E := T.isZariskiCovering_restrictOpenCover _ fun y ↦ by
    obtain ⟨x, rfl⟩ := T.thickening.isThickening.2 y
    exact ⟨⟨x⟩, hxW x⟩
  refine (topology S).superset_covering ?_ (zariskiCovering_mem_topology S E hE)
  rintro Z f ⟨Y, h, g, ⟨x⟩, rfl⟩
  let R := T.restrictOpen (W x.down : T.thickening.target.scheme.Opens)
  have : IsAffine R.thickening.source := (W x.down).2.preimage T.thickening.immersion
  have hrange : Set.range R.toX ⊆ Set.range (U (i x.down)).ι := by
    rintro _ ⟨z, rfl⟩
    rw [Scheme.Opens.range_ι]
    exact hWU x.down z.2
  obtain ⟨m⟩ := (L (i x.down)).nonempty_hom_object hp R
    (IsOpenImmersion.lift (U (i x.down)).ι R.toX hrange) (IsOpenImmersion.lift_fac _ _ _)
  exact ⟨i x.down, ⟨h ≫ m⟩⟩

end Crystalline.GlobalCrystallineSituation.CechEnvelope
