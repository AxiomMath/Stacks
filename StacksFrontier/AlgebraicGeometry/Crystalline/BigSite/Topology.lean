module

public import Mathlib.AlgebraicGeometry.Morphisms.Smooth
public import Mathlib.AlgebraicGeometry.Sites.Etale
public import Mathlib.AlgebraicGeometry.Sites.Fpqc
public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import Mathlib.CategoryTheory.Sites.Sheaf
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Crystalline.BigSite.Basic

/-!
# The big crystalline site

Fix a global crystalline situation `(p, (S, I, γ), X)`.  A family of morphisms
`{(Uᵢ, Tᵢ, δᵢ) ⟶ (U, T, δ)}` in the big crystalline category `CRIS(X/S)` is a *Zariski (étale,
smooth, fppf) covering* when `Uᵢ = U ×_T Tᵢ` for every `i` and `{Tᵢ ⟶ T}` is a Zariski (étale,
smooth, fppf) covering of schemes.  The *big crystalline site* is `CRIS(X/S)` with the Zariski
topology, and `(X/S)_CRIS` is its topos of sheaves.

## Main definitions

* `Crystalline.GlobalCrystallineSituation.Thickening.IsCartesian` — a morphism of `CRIS(X/S)`
  whose underlying square of schemes is Cartesian, which is `U_A = U_B ×_{T_B} T_A`.
* `Crystalline.GlobalCrystallineSituation.Thickening.IsCovering` — a covering family for a
  precoverage of schemes, and `IsZariskiCovering`, `IsEtaleCovering`, `IsSmoothCovering`,
  `IsFppfCovering` its four specialisations, [Stacks, Tag 07IB].
* `Crystalline.GlobalCrystallineSituation.topology` — the Zariski topology of the big crystalline
  site, generated by the Zariski covering families, [Stacks, Tag 07IB].
* `Crystalline.GlobalCrystallineSituation.topos` — the topos `(X/S)_CRIS`, [Stacks, Tag 07IB].

## Main results

* `Crystalline.GlobalCrystallineSituation.zariskiCovering_mem_topology` — the sieve generated by a
  Zariski covering family is a covering sieve of the big crystalline site.
* `Crystalline.GlobalCrystallineSituation.Thickening.isZariskiCovering_singleton_id` — the
  one-element family given by an identity is a Zariski covering.

## Implementation notes

The condition `Uᵢ = U ×_T Tᵢ` is stated invariantly as `CategoryTheory.IsPullback` for the square
of a morphism of divided power thickenings, and a family of morphisms is presented by a
`CategoryTheory.PreZeroHypercover`, whose associated presieve of ambient schemes is tested against
Mathlib's precoverages on `Scheme`.

The topology is `CategoryTheory.Precoverage.toGrothendieck` of the precoverage of Zariski covering
families, i.e. the smallest Grothendieck topology for which they are covering.  Taking the
generated topology avoids the base change stability of these families, [Stacks, Tag 07IA], which
rests on the unique extension of a divided power structure along a flat ring map and is not proved
here; consequently the covering families of `topology` are a priori larger than the Zariski
families themselves.

Syntomic coverings are omitted because the property of being a syntomic morphism of schemes is not
available.

## References

* [Stacks Project, Tag 07I5](https://stacks.math.columbia.edu/tag/07I5)
* [Stacks Project, Tag 07IB](https://stacks.math.columbia.edu/tag/07IB)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry

universe u

namespace Crystalline.GlobalCrystallineSituation

namespace Thickening

variable {S : GlobalCrystallineSituation.{u}}

/-- **A Cartesian morphism of divided power thickenings.**  The square of a morphism
`(U_A, T_A, δ_A) ⟶ (U_B, T_B, δ_B)` of `CRIS(X/S)` is Cartesian, that is `U_A = U_B ×_{T_B} T_A`
as schemes. -/
def IsCartesian {A B : Thickening S} (f : A ⟶ B) : Prop :=
  IsPullback f.sourceHom A.thickening.immersion B.thickening.immersion f.targetHom.hom

/-- The identity of an object of `CRIS(X/S)` is Cartesian. -/
theorem isCartesian_id (A : Thickening S) : IsCartesian (𝟙 A) :=
  show IsPullback (𝟙 A.thickening.source) A.thickening.immersion A.thickening.immersion
      (𝟙 A.thickening.target.scheme) from IsPullback.of_horiz_isIso ⟨by simp⟩

/-- The presieve of ambient divided power schemes underlying a family of morphisms of divided
power thickenings. -/
def targetPresieve {B : Thickening S} (E : PreZeroHypercover.{u + 1} B) :
    Presieve B.thickening.target.scheme :=
  Presieve.ofArrows (fun i ↦ (E.X i).thickening.target.scheme) (fun i ↦ (E.f i).targetHom.hom)

/-- **Stacks Project, Tag 07IB.**  A family of morphisms `{(Uᵢ, Tᵢ, δᵢ) ⟶ (U, T, δ)}` of divided
power thickenings of `X/S` is a covering for a precoverage `K` of schemes when every `Uᵢ` is
`U ×_T Tᵢ` and the family `{Tᵢ ⟶ T}` is a covering for `K`. -/
@[stacks 07IB "(1)"]
def IsCovering (K : Precoverage Scheme.{u}) {B : Thickening S}
    (E : PreZeroHypercover.{u + 1} B) : Prop :=
  (∀ i, IsCartesian (E.f i)) ∧ targetPresieve E ∈ K B.thickening.target.scheme

/-- **Stacks Project, Tag 07IB.**  A Zariski covering family of divided power thickenings of
`X/S`. -/
@[stacks 07IB "(1), Zariski coverings"]
abbrev IsZariskiCovering {B : Thickening S} (E : PreZeroHypercover.{u + 1} B) : Prop :=
  IsCovering Scheme.zariskiPrecoverage E

/-- **Stacks Project, Tag 07IB.**  An étale covering family of divided power thickenings of
`X/S`. -/
@[stacks 07IB "(1), étale coverings"]
abbrev IsEtaleCovering {B : Thickening S} (E : PreZeroHypercover.{u + 1} B) : Prop :=
  IsCovering Scheme.etalePrecoverage E

/-- **Stacks Project, Tag 07IB.**  A smooth covering family of divided power thickenings of
`X/S`. -/
@[stacks 07IB "(1), smooth coverings"]
abbrev IsSmoothCovering {B : Thickening S} (E : PreZeroHypercover.{u + 1} B) : Prop :=
  IsCovering (Scheme.precoverage @Smooth) E

/-- **Stacks Project, Tag 07IB.**  An fppf covering family of divided power thickenings of
`X/S`. -/
@[stacks 07IB "(1), fppf coverings"]
abbrev IsFppfCovering {B : Thickening S} (E : PreZeroHypercover.{u + 1} B) : Prop :=
  IsCovering Scheme.fppfPrecoverage E

/-- **The one-element family given by the identity of an object of `CRIS(X/S)` is a Zariski
covering.**  Its square is Cartesian and the identity of the ambient scheme is a surjective open
immersion. -/
theorem isZariskiCovering_singleton_id (B : Thickening S) :
    IsZariskiCovering (PreZeroHypercover.singleton.{u + 1} (𝟙 B)) := by
  refine ⟨fun _ ↦ isCartesian_id B, ?_⟩
  have h : targetPresieve (PreZeroHypercover.singleton.{u + 1} (𝟙 B)) =
      Presieve.ofArrows (fun _ : PUnit.{u + 2} ↦ B.thickening.target.scheme)
        (fun _ ↦ 𝟙 B.thickening.target.scheme) := rfl
  rw [h, Scheme.ofArrows_mem_precoverage_iff]
  exact ⟨fun x ↦ ⟨PUnit.unit, x, rfl⟩, fun _ ↦ inferInstance⟩

end Thickening

open Thickening

/-- The precoverage of `CRIS(X/S)` whose covering presieves are those presented by a Zariski
covering family of divided power thickenings. -/
def precoverage (S : GlobalCrystallineSituation.{u}) : Precoverage (Thickening S) where
  coverings B := {R | ∃ E : PreZeroHypercover.{u + 1} B, R = E.presieve₀ ∧ IsZariskiCovering E}

/-- A presieve is covering for `Crystalline.GlobalCrystallineSituation.precoverage` exactly when
some Zariski covering family presents it. -/
theorem mem_precoverage_iff (S : GlobalCrystallineSituation.{u}) {B : Thickening S}
    {R : Presieve B} :
    R ∈ precoverage S B ↔
      ∃ E : PreZeroHypercover.{u + 1} B, R = E.presieve₀ ∧ IsZariskiCovering E :=
  Iff.rfl

/-- **Stacks Project, Tag 07IB.**  The big crystalline site of `X` over `(S, I, γ)`: the category
`CRIS(X/S)` with the Zariski topology, the topology generated by the Zariski covering families of
divided power thickenings. -/
@[stacks 07IB "(2)", stacks 07I5]
abbrev topology (S : GlobalCrystallineSituation.{u}) : GrothendieckTopology (Thickening S) :=
  (precoverage S).toGrothendieck

/-- **Every Zariski covering family covers in the big crystalline site.** -/
theorem zariskiCovering_mem_topology (S : GlobalCrystallineSituation.{u}) {B : Thickening S}
    (E : PreZeroHypercover.{u + 1} B) (hE : IsZariskiCovering E) :
    Sieve.generate E.presieve₀ ∈ topology S B :=
  (precoverage S).generate_mem_toGrothendieck ⟨E, rfl, hE⟩

/-- **Stacks Project, Tag 07IB.**  The crystalline topos `(X/S)_CRIS`, the sheaves of sets on the
big crystalline site. -/
@[stacks 07IB "(3)"]
abbrev topos (S : GlobalCrystallineSituation.{u}) := Sheaf (topology S) (Type (u + 1))

end Crystalline.GlobalCrystallineSituation

end
