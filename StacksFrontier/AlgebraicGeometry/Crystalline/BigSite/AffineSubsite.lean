module

public import StacksFrontier.AlgebraicGeometry.Crystalline.BigSite.StructureSheaf

/-!
# The objects of `CRIS(X/S)` with affine ambient scheme form a dense subsite

Fix a global crystalline situation `(p, (S, I, γ), X)`.  The objects `(U, T, δ)` of the big
crystalline site `CRIS(X/S)` whose ambient scheme `T` is affine span a full subcategory
`CRIS_aff(X/S)`.  This file gives it the topology generated by the standard basic open covers of
the ambient schemes, the families `{(U, T, δ)|_{D(rᵢ)} ⟶ (U, T, δ)}` attached to global sections
`rᵢ` of `𝒪_T` generating the unit ideal, and proves that the inclusion
`CRIS_aff(X/S) ⥤ CRIS(X/S)` exhibits it as a dense subsite which is moreover cocontinuous.

## Main definitions

* `IsAffineAmbient`, `BigAffineThickening`, `bigAffineι` — the objects with affine ambient
  scheme, the full subcategory they span and its inclusion.
* `BigAffineThickening.restrictOpen`, `BigAffineThickening.restrictBasicOpen` and their structure
  morphisms — restrictions to affine opens and to basic opens.
* `bigAffineCoverage`, `bigAffineTopology` — the coverage by standard basic open covers and the
  topology it generates.

## Main results

* `bigAffineι_isCoverDense` — every object of `CRIS(X/S)` is covered by objects with affine
  ambient scheme.
* `functorPullback_pullback_mem_bigAffineTopology` — a covering sieve of `CRIS(X/S)` pulled back
  to an object with affine ambient scheme is a covering sieve of `CRIS_aff(X/S)`.
* `bigAffineTopology_eq_restrictedTopology` — the topology is the one restricted from `CRIS(X/S)`.
* `instIsDenseSubsiteBigAffineι`, `instIsCocontinuousBigAffineι` — the inclusion is a dense
  subsite and is cocontinuous.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite

universe u

namespace Crystalline.GlobalCrystallineSituation

variable (S : GlobalCrystallineSituation.{u})

/-- The property of an object `(U, T, δ)` of `CRIS(X/S)` that its ambient scheme `T` is
affine. -/
abbrev IsAffineAmbient : ObjectProperty (Thickening S) :=
  fun A ↦ IsAffine A.thickening.target.scheme

/-- The full subcategory `CRIS_aff(X/S)` of the big crystalline site on the objects with affine
ambient scheme. -/
abbrev BigAffineThickening := (IsAffineAmbient S).FullSubcategory

/-- The inclusion `CRIS_aff(X/S) ⥤ CRIS(X/S)`. -/
abbrev bigAffineι : BigAffineThickening S ⥤ Thickening S := (IsAffineAmbient S).ι

namespace BigAffineThickening

variable {S}

/-- The ambient scheme of an object of `CRIS_aff(X/S)` is affine. -/
instance isAffine_target (A : BigAffineThickening S) :
    IsAffine A.obj.thickening.target.scheme := A.property

/-- The object of `CRIS_aff(X/S)` given by an object of `CRIS(X/S)` with affine ambient
scheme. -/
def mk (A : Thickening S) [IsAffine A.thickening.target.scheme] : BigAffineThickening S :=
  ⟨A, inferInstance⟩

/-- The underlying object of `mk A` is `A`. -/
@[simp]
theorem mk_obj (A : Thickening S) [IsAffine A.thickening.target.scheme] : (mk A).obj = A := rfl

/-- **The restriction of an object of `CRIS(X/S)` to an affine open of its ambient scheme**, an
object of `CRIS_aff(X/S)`. -/
noncomputable def restrictOpen (A : Thickening S) {V : A.thickening.target.scheme.Opens}
    (hV : IsAffineOpen V) : BigAffineThickening S :=
  ⟨A.restrictOpen V, hV⟩

/-- The underlying object of `restrictOpen A hV` is the restriction `A|_V`. -/
@[simp]
theorem restrictOpen_obj (A : Thickening S) {V : A.thickening.target.scheme.Opens}
    (hV : IsAffineOpen V) : (restrictOpen A hV).obj = A.restrictOpen V := rfl

/-- The structure morphism of the restriction of an object of `CRIS_aff(X/S)` to an affine open
of its ambient scheme. -/
noncomputable def restrictOpenHom (A : BigAffineThickening S)
    {V : A.obj.thickening.target.scheme.Opens} (hV : IsAffineOpen V) :
    restrictOpen A.obj hV ⟶ A :=
  ObjectProperty.homMk (A.obj.restrictOpenHom V)

/-- The underlying morphism of `restrictOpenHom A hV` is the structure morphism `A|_V ⟶ A` in
`CRIS(X/S)`. -/
@[simp]
theorem restrictOpenHom_hom (A : BigAffineThickening S)
    {V : A.obj.thickening.target.scheme.Opens} (hV : IsAffineOpen V) :
    (restrictOpenHom A hV).hom = A.obj.restrictOpenHom V := rfl

/-- A basic open of the ambient scheme of an object of `CRIS_aff(X/S)` is affine. -/
theorem isAffineOpen_basicOpen (B : BigAffineThickening S)
    (r : Γ(B.obj.thickening.target.scheme, ⊤)) :
    IsAffineOpen (B.obj.thickening.target.scheme.basicOpen r) :=
  (isAffineOpen_top _).basicOpen r

/-- The restriction of an object of `CRIS_aff(X/S)` to the basic open `D(r)` of its ambient
scheme. -/
noncomputable abbrev restrictBasicOpen (B : BigAffineThickening S)
    (r : Γ(B.obj.thickening.target.scheme, ⊤)) : BigAffineThickening S :=
  restrictOpen B.obj (isAffineOpen_basicOpen B r)

/-- The structure morphism `B|_{D(r)} ⟶ B` of the restriction to a basic open. -/
noncomputable abbrev restrictBasicOpenHom (B : BigAffineThickening S)
    (r : Γ(B.obj.thickening.target.scheme, ⊤)) : restrictBasicOpen B r ⟶ B :=
  restrictOpenHom B (isAffineOpen_basicOpen B r)

end BigAffineThickening

open BigAffineThickening

/-- **The coverage of `CRIS_aff(X/S)` by standard basic open covers**: the covering presieves of
an object `B` are the families of restrictions `B|_{D(rᵢ)} ⟶ B` to the basic opens of a family
`(rᵢ)` of global sections of its ambient scheme generating the unit ideal.  Such a family pulls
back along `g : A ⟶ B` to the family defined by the images of the `rᵢ` over `A`. -/
def bigAffineCoverage : Coverage (BigAffineThickening S) where
  coverings B := {R | ∃ (I : Type (u + 1)) (f : I → Γ(B.obj.thickening.target.scheme, ⊤)),
    Ideal.span (Set.range f) = ⊤ ∧
      R = Presieve.ofArrows (fun i ↦ restrictBasicOpen B (f i))
        fun i ↦ restrictBasicOpenHom B (f i)}
  pullback := by
    rintro B A g R ⟨I, f, hf, rfl⟩
    refine ⟨Presieve.ofArrows
      (fun i ↦ restrictBasicOpen A (g.hom.targetHom.hom.appTop (f i)))
      fun i ↦ restrictBasicOpenHom A (g.hom.targetHom.hom.appTop (f i)), ⟨I, _, ?_, rfl⟩, ?_⟩
    · change Ideal.span (Set.range (g.hom.targetHom.hom.appTop.hom ∘ f)) = ⊤
      rw [Set.range_comp, ← Ideal.map_span, hf, Ideal.map_top]
    · rintro Z k ⟨i⟩
      obtain ⟨p, hp⟩ := Thickening.exists_comp_restrictOpenHom_eq
        (B.obj.thickening.target.scheme.basicOpen (f i))
        (A.obj.restrictOpenHom
          (A.obj.thickening.target.scheme.basicOpen (g.hom.targetHom.hom.appTop (f i))) ≫ g.hom)
        (fun x ↦ (Scheme.preimage_basicOpen_top g.hom.targetHom.hom (f i)).ge
          (show (Thickening.restrictOpen A.obj _).thickening.target.scheme from x).2)
      exact ⟨restrictBasicOpen B (f i), ObjectProperty.homMk p, restrictBasicOpenHom B (f i), ⟨i⟩,
        ObjectProperty.hom_ext _ hp⟩

/-- The family of restrictions to the basic opens of a family of sections generating the unit
ideal is a covering presieve of `bigAffineCoverage`. -/
theorem ofArrows_mem_bigAffineCoverage (B : BigAffineThickening S) {I : Type (u + 1)}
    (f : I → Γ(B.obj.thickening.target.scheme, ⊤)) (hf : Ideal.span (Set.range f) = ⊤) :
    Presieve.ofArrows (fun i ↦ restrictBasicOpen B (f i)) (fun i ↦ restrictBasicOpenHom B (f i)) ∈
      bigAffineCoverage S B :=
  ⟨I, f, hf, rfl⟩

/-- **The topology of `CRIS_aff(X/S)`**, generated by the standard basic open covers of the
ambient schemes. -/
abbrev bigAffineTopology : GrothendieckTopology (BigAffineThickening S) :=
  (bigAffineCoverage S).toGrothendieck

/-- A sieve on `B` containing the restrictions of `B` to a family of opens covering its ambient
scheme is a covering sieve. -/
private theorem mem_topology_of_forall_restrictOpenHom {B : Thickening S} {ι : Type (u + 1)}
    (V : ι → B.thickening.target.scheme.Opens) (hV : ∀ x, ∃ i, x ∈ V i) {R : Sieve B}
    (hR : ∀ i, R.arrows (B.restrictOpenHom (V i))) : R ∈ topology S B := by
  refine (topology S).superset_covering ?_ (zariskiCovering_mem_topology S _
    (Thickening.isZariskiCovering_restrictOpenCover B V hV))
  rw [Sieve.generate_le_iff]
  rintro Z k ⟨i⟩
  exact hR i

/-- **Every object of `CRIS(X/S)` is covered by objects with affine ambient scheme**: the
restrictions of an object to affine opens of its ambient scheme form a covering. -/
theorem bigAffineι_isCoverDense : (bigAffineι S).IsCoverDense (topology S) := by
  classical
  constructor
  intro B
  have hpt : ∀ x : B.thickening.target.scheme,
      ∃ W : B.thickening.target.scheme.Opens, IsAffineOpen W ∧ x ∈ W := fun x ↦ by
    obtain ⟨W, hW, hxW, -⟩ := exists_isAffineOpen_mem_and_subset (U := ⊤) (x := x) trivial
    exact ⟨W, hW, hxW⟩
  choose W hW hxW using hpt
  let V : ULift.{u + 1} B.thickening.target.scheme → B.thickening.target.scheme.Opens :=
    fun x ↦ W x.down
  exact mem_topology_of_forall_restrictOpenHom S V (fun x ↦ ⟨ULift.up x, hxW x⟩) fun i ↦
    Presieve.in_coverByImage (bigAffineι S)
      (show (bigAffineι S).obj (BigAffineThickening.restrictOpen B (hW i.down)) ⟶ B from
        B.restrictOpenHom (V i))

/-- The inclusion `CRIS_aff(X/S) ⥤ CRIS(X/S)` is cover-dense. -/
instance instIsCoverDenseBigAffineι : (bigAffineι S).IsCoverDense (topology S) :=
  bigAffineι_isCoverDense S

variable {S} in
/-- **A Zariski covering family pulled back to an object with affine ambient scheme contains a
standard basic open cover.** -/
theorem generate_le_of_isZariskiCovering {B : Thickening S} (E : PreZeroHypercover.{u + 1} B)
    (hE : Thickening.IsZariskiCovering E) (A : BigAffineThickening S)
    (g : (bigAffineι S).obj A ⟶ B) :
    ∃ (I : Type (u + 1)) (f : I → Γ(A.obj.thickening.target.scheme, ⊤)),
      Ideal.span (Set.range f) = ⊤ ∧
        ∀ i, ((Sieve.generate E.presieve₀).pullback g).arrows
          ((bigAffineι S).map (restrictBasicOpenHom A (f i))) := by
  classical
  have hE' : (∀ x, ∃ i, x ∈ Set.range ((E.f i).targetHom.hom).base) ∧
      ∀ i, IsOpenImmersion (E.f i).targetHom.hom := by
    simpa [Thickening.targetPresieve] using hE.2
  have hoi := hE'.2
  have hpt : ∀ x : A.obj.thickening.target.scheme, ∃ (i : E.I₀)
      (r : Γ(A.obj.thickening.target.scheme, ⊤)),
      x ∈ A.obj.thickening.target.scheme.basicOpen r ∧
        A.obj.thickening.target.scheme.basicOpen r ≤ Thickening.pullbackOpen (E.f i) g := by
    intro x
    obtain ⟨i, y, hy⟩ := hE'.1 (g.targetHom.hom.base x)
    obtain ⟨r, hr, hxr⟩ := (isAffineOpen_top A.obj.thickening.target.scheme).exists_basicOpen_le
      (V := Thickening.pullbackOpen (E.f i) g) ⟨x, ⟨y, hy⟩⟩ trivial
    exact ⟨i, r, hxr, hr⟩
  choose i r hxr hr using hpt
  refine ⟨ULift.{u + 1} A.obj.thickening.target.scheme, fun x ↦ r x.down, ?_, fun x ↦ ?_⟩
  · exact ((isAffineOpen_top A.obj.thickening.target.scheme).self_le_iSup_basicOpen_iff
      (s := Set.range fun x : ULift.{u + 1} A.obj.thickening.target.scheme ↦ r x.down)).mp
      fun x _ ↦ TopologicalSpace.Opens.mem_iSup.mpr ⟨⟨r x, ⟨ULift.up x, rfl⟩⟩, hxr x⟩
  · refine ⟨E.X (i x.down), A.obj.restrictOpenLE (hr x.down) ≫
      Thickening.pullbackLiftHom (E.f (i x.down)) g (hE.1 _), E.f (i x.down), ⟨i x.down⟩, ?_⟩
    refine (Category.assoc _ _ _).trans ?_
    rw [Thickening.pullbackLiftHom_comp]
    exact (Category.assoc _ _ _).symm.trans
      (congrArg (· ≫ g) (Thickening.restrictOpenLE_restrictOpenHom A.obj (hr x.down)))

/-- **A covering sieve of `CRIS(X/S)`, pulled back to an object with affine ambient scheme and
read in `CRIS_aff(X/S)`, is a covering sieve there.** -/
theorem functorPullback_pullback_mem_bigAffineTopology {B : Thickening S} {R : Sieve B}
    (hR : R ∈ topology S B) (A : BigAffineThickening S) (g : (bigAffineι S).obj A ⟶ B) :
    (R.pullback g).functorPullback (bigAffineι S) ∈ bigAffineTopology S A := by
  have hSat : ∀ {B : Thickening S} {R : Sieve B}, Coverage.Saturate (coverage S) B R →
      ∀ (A : BigAffineThickening S) (g : (bigAffineι S).obj A ⟶ B),
        (R.pullback g).functorPullback (bigAffineι S) ∈ bigAffineTopology S A := by
    intro B R hR
    induction hR with
    | of B P hP =>
      intro A g
      obtain ⟨E, rfl, hE⟩ := hP
      obtain ⟨I, f, hf, hle⟩ := generate_le_of_isZariskiCovering E hE A g
      refine Coverage.mem_toGrothendieck_sieves_of_superset _ ?_
        (ofArrows_mem_bigAffineCoverage S A f hf)
      rintro Z k ⟨i⟩
      exact hle i
    | top B =>
      intro A g
      exact (bigAffineTopology S).superset_covering (fun Z k _ ↦ trivial)
        ((bigAffineTopology S).top_mem A)
    | transitive B R Q hR hQ ihR ihQ =>
      intro A g
      refine (bigAffineTopology S).transitive (ihR A g) _ fun A₁ h hh ↦ ?_
      rw [← Sieve.functorPullback_pullback]
      simpa [← Sieve.pullback_comp, Category.assoc] using ihQ hh A₁ (𝟙 _)
  rw [topology_eq_coverage_toGrothendieck] at hR
  exact hSat (Coverage.mem_toGrothendieck.mp hR) A g

/-- **The inclusion `CRIS_aff(X/S) ⥤ CRIS(X/S)` is cocontinuous.** -/
instance instIsCocontinuousBigAffineι :
    (bigAffineι S).IsCocontinuous (bigAffineTopology S) (topology S) where
  cover_lift {A} R hR := by
    simpa using functorPullback_pullback_mem_bigAffineTopology S hR A (𝟙 _)

/-- **The topology of `CRIS_aff(X/S)` is the topology restricted from `CRIS(X/S)`.** -/
theorem bigAffineTopology_eq_restrictedTopology :
    bigAffineTopology S = (bigAffineι S).restrictedTopology (topology S) := by
  refine le_antisymm (((Coverage.gi (BigAffineThickening S)).gc _ _).2 fun B R hR ↦ ?_)
    fun A R hR ↦ ?_
  · obtain ⟨I, f, hf, rfl⟩ := hR
    show Sieve.generate _ ∈ (bigAffineι S).restrictedTopology (topology S) B
    rw [Functor.mem_restrictedTopology_iff]
    have htop := ((isAffineOpen_top B.obj.thickening.target.scheme).self_le_iSup_basicOpen_iff
      (s := Set.range f)).mpr hf
    exact mem_topology_of_forall_restrictOpenHom S _ (fun x ↦ by
      obtain ⟨⟨_, i, rfl⟩, hi⟩ := TopologicalSpace.Opens.mem_iSup.mp (htop trivial)
      exact ⟨i, hi⟩) fun i ↦
      ⟨restrictBasicOpen B (f i), restrictBasicOpenHom B (f i), 𝟙 _,
        Sieve.le_generate _ _ _ (Presieve.ofArrows.mk i), (Category.id_comp _).symm⟩
  · have hpull := functorPullback_pullback_mem_bigAffineTopology S
      ((Functor.mem_restrictedTopology_iff (G := bigAffineι S) (K := topology S)).mp hR) A (𝟙 _)
    rwa [Sieve.pullback_id, Sieve.functorPullback_functorPushforward_eq] at hpull

/-- **The inclusion exhibits `CRIS_aff(X/S)` as a dense subsite of `CRIS(X/S)`.** -/
instance instIsDenseSubsiteBigAffineι :
    (bigAffineι S).IsDenseSubsite (bigAffineTopology S) (topology S) := by
  rw [bigAffineTopology_eq_restrictedTopology]
  infer_instance

end Crystalline.GlobalCrystallineSituation

end
