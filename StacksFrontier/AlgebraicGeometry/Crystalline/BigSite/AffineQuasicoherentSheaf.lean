module

public import Mathlib.RingTheory.Localization.BaseChange
public import StacksFrontier.Algebra.Category.ModuleCat.Sheaf.DenseSubsiteModules
public import StacksFrontier.AlgebraicGeometry.Crystalline.BigSite.AffineSubsite
public import StacksFrontier.CategoryTheory.Sites.Modules.InverseImage.AbelianSheaf
public import StacksFrontier.RingTheory.Module.Localization.Exactness

/-!
# Presheaves of modules on `CRIS_aff(X/S)` with bijective base change are sheaves

Fix a global crystalline situation `(p, (S, I, γ), X)` and let `CRIS_aff(X/S)` be the full
subcategory of the big crystalline site on the objects with affine ambient scheme, with the
topology of `StacksFrontier/AlgebraicGeometry/Crystalline/BigSite/AffineSubsite.lean`, ringed by the
restriction `𝒪` of the structure sheaf `𝒪_{X/S}`, whose sections over `(U, T, δ)` are
`Γ(T, 𝒪_T)`.  For a presheaf of `𝒪`-modules `N` and a morphism `k : A ⟶ B` there is the base
change of sections `𝒪(A) ⊗_{𝒪(B)} N(B) ⟶ N(A)`, `r ⊗ x ↦ r • N(k)(x)`.  This file proves that
**if every such base change map is bijective, then `N` is a sheaf**.

The proof is Zariski descent for modules, as on the small site
(`StacksFrontier/AlgebraicGeometry/Crystalline/SmallSite/AffineQuasicoherentSheaf.lean`): the
topology is generated by the standard basic open covers, over which the bijectivity says that the
sections over `B|_{D(r)}` are the localization `N(B)_r`, and the sheaf condition is the exactness
of `0 → N(B) → ∏ N(B)_{rᵢ} → ∏ N(B)_{rᵢ rⱼ}`, [Stacks, Tag 00EK].

## Main definitions

Everything lives in the namespace `Crystalline.GlobalCrystallineSituation.BigAffine`.

* `structureSheaf` — the sheaf of rings `𝒪` of `CRIS_aff(X/S)`.
* `RingAlong k`, `ModuleAlong N k` — the sections of `𝒪` and of `N` over the source of `k`, as
  modules over the sections of `𝒪` over its target.
* `baseChange N k` — the base change of sections along `k`.
* `sheafOfBijectiveBaseChange` — a presheaf of modules all of whose base change maps are
  bijective, as a sheaf of modules.

## Main results

* `isSheaf_of_bijective_baseChange` — **a presheaf of modules on `CRIS_aff(X/S)` whose base
  change maps are all bijective is a sheaf.**

## References

* [Stacks Project, Tag 00EK](https://stacks.math.columbia.edu/tag/00EK)
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Opposite
open scoped TensorProduct

universe w u

noncomputable section

namespace Crystalline.GlobalCrystallineSituation.BigAffine

open BigAffineThickening

variable {S : GlobalCrystallineSituation.{u}}

/-- **The structure sheaf `𝒪` of `CRIS_aff(X/S)`**: the restriction of the structure sheaf of
`CRIS(X/S)`.  Its sections over `(U, T, δ)` are `Γ(T, 𝒪_T)`. -/
abbrev structureSheaf (S : GlobalCrystallineSituation.{u}) :
    Sheaf (bigAffineTopology S) RingCat.{u} :=
  Stacks.DenseSubsiteModules.ringRestriction (bigAffineTopology S) (topology S) (bigAffineι S)
    (crystallineStructureSheaf S)

/-- The ring of sections of `𝒪` over an object `(U, T, δ)` of `CRIS_aff(X/S)`, the ring
`Γ(T, 𝒪_T)`. -/
abbrev SectionRing (A : BigAffineThickening S) : Type u :=
  (structureSheaf S).obj.obj (op A)

/-- The sections of `𝒪` form a commutative ring. -/
instance instCommRingSectionRing (A : BigAffineThickening S) : CommRing (SectionRing A) :=
  inferInstanceAs (CommRing Γ(A.obj.thickening.target.scheme, ⊤))

/-- The restriction map `𝒪(B) ⟶ 𝒪(A)` along a morphism `k : A ⟶ B`. -/
abbrev sectionMap {A B : BigAffineThickening S} (k : A ⟶ B) :
    SectionRing B →+* SectionRing A :=
  ((structureSheaf S).obj.map k.op).hom

/-- **The sections of `𝒪` over the source of `k : A ⟶ B`**, as an `𝒪(B)`-algebra through the
restriction map of `k`; the synonym carries `k` in its type. -/
def RingAlong {A B : BigAffineThickening S} (_k : A ⟶ B) : Type u := SectionRing A

/-- **The sections of a presheaf of modules `N` over the source of `k : A ⟶ B`**, as an
`𝒪(B)`-module by restriction of scalars along the restriction map of `k`. -/
def ModuleAlong (N : PresheafOfModules.{w} (structureSheaf S).obj)
    {A B : BigAffineThickening S} (_k : A ⟶ B) : Type w :=
  N.obj (op A)

variable (N : PresheafOfModules.{w} (structureSheaf S).obj)
  {A B : BigAffineThickening S} (k : A ⟶ B)

/-- The commutative ring structure of `RingAlong k`. -/
instance instCommRingRingAlong : CommRing (RingAlong k) :=
  inferInstanceAs (CommRing (SectionRing A))

/-- `𝒪(A)` as an `𝒪(B)`-algebra through the restriction map of `k`. -/
instance instAlgebraRingAlong : Algebra (SectionRing B) (RingAlong k) :=
  (sectionMap k).toAlgebra

/-- The additive group of `ModuleAlong N k`. -/
instance instAddCommGroupModuleAlong : AddCommGroup (ModuleAlong N k) :=
  inferInstanceAs (AddCommGroup (N.obj (op A)))

/-- `N(A)` as a module over `RingAlong k`. -/
instance instModuleRingAlongModuleAlong : Module (RingAlong k) (ModuleAlong N k) :=
  inferInstanceAs (Module (SectionRing A) (N.obj (op A)))

/-- `N(A)` as an `𝒪(B)`-module, by restriction of scalars along the restriction map of `k`. -/
instance instModuleModuleAlong : Module (SectionRing B) (ModuleAlong N k) :=
  Module.compHom (N.obj (op A)) (sectionMap k)

/-- The two scalar actions on `ModuleAlong N k` are compatible. -/
instance instIsScalarTowerModuleAlong :
    IsScalarTower (SectionRing B) (RingAlong k) (ModuleAlong N k) where
  smul_assoc b t x := mul_smul (sectionMap k b) (show SectionRing A from t)
    (show N.obj (op A) from x)

/-- `N(A)` as a module over `RingAlong k`; the base change map is linear for it. -/
instance instModuleRingAlong : Module (RingAlong k) (N.obj (op A)) :=
  inferInstanceAs (Module (SectionRing A) (N.obj (op A)))

/-- The restriction map `N(B) ⟶ N(A)` along `k`, as an `𝒪(B)`-linear map. -/
def restrictAlong : N.obj (op B) →ₗ[SectionRing B] ModuleAlong N k where
  toFun x := N.restrictₛₗ k.op x
  map_add' x y := map_add (N.restrictₛₗ k.op) x y
  map_smul' b x := (N.restrictₛₗ k.op).map_smulₛₗ b x

/-- `restrictAlong N k` sends `x : N(B)` to its restriction `N(k)(x)`. -/
@[simp]
theorem restrictAlong_apply (x : N.obj (op B)) :
    restrictAlong N k x = N.restrictₛₗ k.op x :=
  rfl

/-- **The base change of sections of `N` along `k : A ⟶ B`**: the `𝒪(A)`-linear map
`𝒪(A) ⊗_{𝒪(B)} N(B) ⟶ N(A)`, `r ⊗ x ↦ r • N(k)(x)`. -/
def baseChange :
    RingAlong k ⊗[SectionRing B] N.obj (op B) →ₗ[RingAlong k] N.obj (op A) :=
  (restrictAlong N k).liftBaseChange (RingAlong k)

/-- The base change map sends `r ⊗ x` to `r • N(k)(x)`. -/
@[simp]
theorem baseChange_tmul (r : RingAlong k) (x : N.obj (op B)) :
    baseChange N k (r ⊗ₜ x) = r • N.restrictₛₗ k.op x :=
  rfl

/-- The restriction map along `ρ : Z' ⟶ Z` over `B`, as an `𝒪(B)`-linear map. -/
def transferAlong {Z Z' : BigAffineThickening S} {k : Z ⟶ B} {k' : Z' ⟶ B}
    (ρ : Z' ⟶ Z) (hρ : ρ ≫ k = k') :
    ModuleAlong N k →ₗ[SectionRing B] ModuleAlong N k' where
  toFun x := N.restrictₛₗ ρ.op x
  map_add' x y := map_add (N.restrictₛₗ ρ.op) x y
  map_smul' b x := by
    subst hρ
    have e : sectionMap (ρ ≫ k) b = sectionMap ρ (sectionMap k b) := by
      rw [sectionMap, sectionMap, sectionMap, op_comp, Functor.map_comp,
        RingCat.hom_comp, RingHom.comp_apply]
    change N.restrictₛₗ ρ.op (sectionMap k b • @id (N.obj (op Z)) x) =
      sectionMap (ρ ≫ k) b • @id (N.obj (op Z')) (N.restrictₛₗ ρ.op x)
    rw [LinearMap.map_smulₛₗ, e]
    rfl

/-- Restricting along `k` and then along `ρ` is restricting along `ρ ≫ k`. -/
theorem transferAlong_comp {Z Z' : BigAffineThickening S} {k : Z ⟶ B}
    {k' : Z' ⟶ B} (ρ : Z' ⟶ Z) (hρ : ρ ≫ k = k') :
    (transferAlong N ρ hρ).comp (restrictAlong N k) = restrictAlong N k' := by
  subst hρ
  ext x
  change N.map ρ.op (N.map k.op x) = N.map (ρ ≫ k).op x
  rw [op_comp, N.map_comp_apply]

/-- **The sections of `𝒪` over the restriction of an object to a basic open `D(r)` are the
localization away from `r`.** -/
instance isLocalization_restrictBasicOpen (B : BigAffineThickening S)
    (r : Γ(B.obj.thickening.target.scheme, ⊤)) :
    IsLocalization.Away (show SectionRing B from r)
      (RingAlong (restrictBasicOpenHom B r)) :=
  Γ_restrict_isLocalization _ r

/-- **When the base change map along the restriction to a basic open `D(r)` is bijective, the
restriction map `N(B) ⟶ N(B|_{D(r)})` is a localization away from `r`.** -/
theorem isLocalizedModule_restrictAlong (B : BigAffineThickening S)
    (r : Γ(B.obj.thickening.target.scheme, ⊤))
    (h : Function.Bijective (baseChange N (restrictBasicOpenHom B r))) :
    IsLocalizedModule.Away (show SectionRing B from r)
      (restrictAlong N (restrictBasicOpenHom B r)) := by
  rw [IsLocalizedModule.Away, isLocalizedModule_iff_isBaseChange (Submonoid.powers _)
    (RingAlong (restrictBasicOpenHom B r))]
  exact IsBaseChange.of_equiv (LinearEquiv.ofBijective _ h) fun x ↦
    one_smul (RingAlong (restrictBasicOpenHom B r))
      (restrictAlong N (restrictBasicOpenHom B r) x)

end Crystalline.GlobalCrystallineSituation.BigAffine

namespace Crystalline.GlobalCrystallineSituation.BigAffineThickening

variable {S : GlobalCrystallineSituation.{u}}

/-- The morphism `B|_{D(rs)} ⟶ B|_{D(r)}` between restrictions to basic opens. -/
def basicOpenMulLeft (B : BigAffineThickening S)
    (r s : Γ(B.obj.thickening.target.scheme, ⊤)) :
    restrictBasicOpen B (r * s) ⟶ restrictBasicOpen B r :=
  ObjectProperty.homMk (Thickening.restrictOpenLE B.obj
    (by rw [Scheme.basicOpen_mul]; exact inf_le_left))

/-- The morphism `B|_{D(rs)} ⟶ B|_{D(s)}` between restrictions to basic opens. -/
def basicOpenMulRight (B : BigAffineThickening S)
    (r s : Γ(B.obj.thickening.target.scheme, ⊤)) :
    restrictBasicOpen B (r * s) ⟶ restrictBasicOpen B s :=
  ObjectProperty.homMk (Thickening.restrictOpenLE B.obj
    (by rw [Scheme.basicOpen_mul]; exact inf_le_right))

/-- The morphism `B|_{D(rs)} ⟶ B|_{D(r)}` is a morphism over `B`. -/
@[reassoc]
theorem basicOpenMulLeft_restrictBasicOpenHom (B : BigAffineThickening S)
    (r s : Γ(B.obj.thickening.target.scheme, ⊤)) :
    basicOpenMulLeft B r s ≫ restrictBasicOpenHom B r = restrictBasicOpenHom B (r * s) :=
  ObjectProperty.hom_ext _ (Thickening.restrictOpenLE_restrictOpenHom B.obj _)

/-- The morphism `B|_{D(rs)} ⟶ B|_{D(s)}` is a morphism over `B`. -/
@[reassoc]
theorem basicOpenMulRight_restrictBasicOpenHom (B : BigAffineThickening S)
    (r s : Γ(B.obj.thickening.target.scheme, ⊤)) :
    basicOpenMulRight B r s ≫ restrictBasicOpenHom B s = restrictBasicOpenHom B (r * s) :=
  ObjectProperty.hom_ext _ (Thickening.restrictOpenLE_restrictOpenHom B.obj _)

end Crystalline.GlobalCrystallineSituation.BigAffineThickening

namespace Crystalline.GlobalCrystallineSituation.BigAffine

open BigAffineThickening

variable {S : GlobalCrystallineSituation.{u}} (N : PresheafOfModules.{w} (structureSheaf S).obj)

/-- **A presheaf of modules whose base change maps along restrictions to basic opens are
bijective satisfies descent for every standard basic open cover**, [Stacks, Tag 00EK]. -/
theorem isSheafFor_basicOpenCover (B : BigAffineThickening S) {I : Type (u + 1)}
    (f : I → Γ(B.obj.thickening.target.scheme, ⊤)) (hf : Ideal.span (Set.range f) = ⊤)
    (h : ∀ r : Γ(B.obj.thickening.target.scheme, ⊤),
      Function.Bijective (baseChange N (restrictBasicOpenHom B r))) :
    Presieve.IsSheafFor (N.presheaf ⋙ CategoryTheory.forget AddCommGrpCat.{w})
      (Presieve.ofArrows (fun i ↦ restrictBasicOpen B (f i))
        fun i ↦ restrictBasicOpenHom B (f i)) := by
  have hloc : ∀ r : Γ(B.obj.thickening.target.scheme, ⊤),
      IsLocalizedModule.Away (show SectionRing B from r)
        (restrictAlong N (restrictBasicOpenHom B r)) := fun r ↦
    isLocalizedModule_restrictAlong N B r (h r)
  let g : ∀ i, N.obj (op B) →ₗ[SectionRing B]
      ModuleAlong N (restrictBasicOpenHom B (f i)) := fun i ↦
    restrictAlong N (restrictBasicOpenHom B (f i))
  let l : ∀ i j, ModuleAlong N (restrictBasicOpenHom B (f i)) →ₗ[SectionRing B]
      ModuleAlong N (restrictBasicOpenHom B (f i * f j)) := fun i j ↦
    transferAlong N (basicOpenMulLeft B (f i) (f j))
      (basicOpenMulLeft_restrictBasicOpenHom B (f i) (f j))
  let r : ∀ i j, ModuleAlong N (restrictBasicOpenHom B (f j)) →ₗ[SectionRing B]
      ModuleAlong N (restrictBasicOpenHom B (f i * f j)) := fun i j ↦
    transferAlong N (basicOpenMulRight B (f i) (f j))
      (basicOpenMulRight_restrictBasicOpenHom B (f i) (f j))
  have hl : ∀ i j,
      (l i j).comp (g i) = restrictAlong N (restrictBasicOpenHom B (f i * f j)) :=
    fun i j ↦ transferAlong_comp N _ _
  have hr : ∀ i j,
      (r i j).comp (g j) = restrictAlong N (restrictBasicOpenHom B (f i * f j)) :=
    fun i j ↦ transferAlong_comp N _ _
  have : ∀ i, IsLocalizedModule.Away (show SectionRing B from f i) (g i) :=
    fun i ↦ hloc (f i)
  have : ∀ i j, IsLocalizedModule.Away
      ((show SectionRing B from f i) * (show SectionRing B from f j))
      ((l i j).comp (g i)) := fun i j ↦ by
    rw [hl i j]
    exact hloc (f i * f j)
  obtain ⟨hinj, hexact⟩ := IsLocalizedModule.Away.injective_pi_and_exact_of_span_range_eq_top
    (f := fun i ↦ (show SectionRing B from f i)) g l r hf
    fun i j ↦ (hl i j).trans (hr i j).symm
  rw [Presieve.isSheafFor_arrows_iff]
  intro x hx
  let y : ∀ i, ModuleAlong N (restrictBasicOpenHom B (f i)) := x
  have hcompat : ∀ i j, l i j (y i) = r i j (y j) := fun i j ↦
    hx i j (restrictBasicOpen B (f i * f j)) (basicOpenMulLeft B (f i) (f j))
      (basicOpenMulRight B (f i) (f j))
      ((basicOpenMulLeft_restrictBasicOpenHom B (f i) (f j)).trans
        (basicOpenMulRight_restrictBasicOpenHom B (f i) (f j)).symm)
  obtain ⟨m, hm⟩ := (hexact y).mp (funext fun p ↦ by
    simp only [LinearMap.pi_apply, LinearMap.sub_apply, LinearMap.comp_apply, LinearMap.proj_apply,
      Pi.zero_apply]
    exact sub_eq_zero.mpr (hcompat p.1 p.2))
  exact ⟨m, fun i ↦ congrFun hm i, fun t ht ↦
    hinj ((funext fun i ↦ ht i : LinearMap.pi g t = y).trans hm.symm)⟩

/-- **A presheaf of modules on `CRIS_aff(X/S)` whose base change maps along the restrictions to
basic opens are bijective is a sheaf.** -/
theorem isSheaf_of_bijective_baseChange_basicOpen
    (h : ∀ (B : BigAffineThickening S) (r : Γ(B.obj.thickening.target.scheme, ⊤)),
      Function.Bijective (baseChange N (restrictBasicOpenHom B r))) :
    Presheaf.IsSheaf (bigAffineTopology S) N.presheaf := by
  refine CategoryTheory.Sites.AbelianSheaf.isSheaf_of_forget (bigAffineTopology S) N.presheaf ?_
  rw [CategoryTheory.isSheaf_iff_isSheaf_of_type, Presieve.isSheaf_coverage]
  rintro B R ⟨I, f, hf, rfl⟩
  exact isSheafFor_basicOpenCover N B f hf (h B)

/-- **A presheaf of modules on `CRIS_aff(X/S)` all of whose base change maps
`𝒪(A) ⊗_{𝒪(B)} N(B) ⟶ N(A)` are bijective is a sheaf.** -/
theorem isSheaf_of_bijective_baseChange
    (h : ∀ {A B : BigAffineThickening S} (k : A ⟶ B), Function.Bijective (baseChange N k)) :
    Presheaf.IsSheaf (bigAffineTopology S) N.presheaf :=
  isSheaf_of_bijective_baseChange_basicOpen N fun B r ↦ h (restrictBasicOpenHom B r)

/-- **A presheaf of modules on `CRIS_aff(X/S)` all of whose base change maps are bijective, as a
sheaf of modules.** -/
def sheafOfBijectiveBaseChange
    (h : ∀ {A B : BigAffineThickening S} (k : A ⟶ B), Function.Bijective (baseChange N k)) :
    SheafOfModules.{w} (structureSheaf S) :=
  ⟨N, isSheaf_of_bijective_baseChange N h⟩

/-- The underlying presheaf of modules of `sheafOfBijectiveBaseChange N h` is `N`. -/
@[simp]
theorem sheafOfBijectiveBaseChange_val
    (h : ∀ {A B : BigAffineThickening S} (k : A ⟶ B), Function.Bijective (baseChange N k)) :
    (sheafOfBijectiveBaseChange N h).val = N :=
  rfl

end Crystalline.GlobalCrystallineSituation.BigAffine

end
