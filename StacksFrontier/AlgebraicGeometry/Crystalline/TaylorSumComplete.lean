module

public import StacksFrontier.AlgebraicGeometry.Crystalline.TaylorFormula

/-!
# Taylor sums in a `p`-adically complete module

Let `D` be a divided power ring, `M` a `D`-module with composite coordinate operators
`θ_K : M → M`, and `ι : M → N` an additive map into a `p`-adically complete `D`-module.  For a
family `ζ` of elements of the divided power ideal of `D` the **Taylor sum**

`T(m) = ∑_K ζ^{[K]} • ι(θ_K m)`

converges in `N` as soon as, for every `n`, only finitely many `θ_K m` lie outside `p^n M` —
the form in which the quasi-nilpotence condition [Stacks, Tag 07JE] is used.  This module
constructs it, `Crystalline.completeTaylorSum`, by the precompleteness of `N`, characterises it by
its congruences modulo `p^n N` (`Crystalline.taylorSum_sub_sum_mem` and
`Crystalline.eq_taylorSum_of_forall`), and proves the two identities the comparison of
[Stacks, Proposition 60.17.4, Tag 07JH] and of [Stacks, Lemma 60.17.5, Tag 07L5] needs:

* `Crystalline.taylorSum_add` — the Taylor sum is additive;
* `Crystalline.taylorSum_smul` — it is `f`-semilinear when `ι` is `g`-semilinear and Taylor's
  formula `f(a) = ∑_J g(∂_J a) ζ^{[J]}` holds modulo every `p^n`.

Nothing here assumes `p` nilpotent: the sums are taken in the complete module `N`, which is what
the `p`-adically completed divided power envelope of the source requires.

## References

* [Stacks Project, Proposition 60.17.4, Tag 07JH](https://stacks.math.columbia.edu/tag/07JH)
* [Stacks Project, Lemma 60.17.5, Tag 07L5](https://stacks.math.columbia.edu/tag/07L5)
* [Stacks Project, Tag 07JE](https://stacks.math.columbia.edu/tag/07JE)
-/

@[expose] public noncomputable section

open DividedPowers
open Finset.HasAntidiagonal

universe u uI

namespace Crystalline

/-! ### The filtration `p^n` and additive maps -/

section Filtration

variable (p : ℕ) {D : Type u} [CommRing D] {X Y : Type u} [AddCommGroup X] [Module D X]
  [AddCommGroup Y] [Module D Y]

/-- **An additive map carries `p^n X` into `p^n Y`**: the ideal `(p)^n` is generated by the
integer `p^n`, and an additive map is `ℤ`-linear. -/
theorem map_mem_pPowSmul_of_addMonoidHom (g : X →+ Y) {n : ℕ} {x : X}
    (hx : x ∈ pPowSmul p D X n) : g x ∈ pPowSmul p D Y n := by
  obtain ⟨y, hy⟩ := (mem_pPowSmul_iff p D X).mp hx
  refine (mem_pPowSmul_iff p D Y).mpr ⟨g y, ?_⟩
  have hcast : ((p : D) ^ n) = ((p ^ n : ℕ) : D) := by push_cast; ring
  rw [← hy, hcast, Nat.cast_smul_eq_nsmul, Nat.cast_smul_eq_nsmul, map_nsmul]

/-- A scalar in `(p)^n` carries every element into `p^n Y`. -/
theorem smul_mem_pPowSmul_of_mem {n : ℕ} {c : D} (hc : c ∈ pAdicIdeal (A := D) p ^ n) (y : Y) :
    c • y ∈ pPowSmul p D Y n :=
  Submodule.smul_mem_smul hc Submodule.mem_top

/-- The filtration `p^n Y` decreases. -/
theorem pPowSmul_antitone {m n : ℕ} (h : m ≤ n) : pPowSmul p D Y n ≤ pPowSmul p D Y m :=
  Submodule.smul_mono_left (Ideal.pow_le_pow_right h)

/-- A ring endomorphism carries `(p)^n` into itself. -/
theorem ringHom_mem_pAdicIdeal_pow (g : D →+* D) {n : ℕ} {c : D}
    (hc : c ∈ pAdicIdeal (A := D) p ^ n) : g c ∈ pAdicIdeal (A := D) p ^ n := by
  have h : (pAdicIdeal (A := D) p ^ n).map g ≤ pAdicIdeal (A := D) p ^ n := by
    rw [Ideal.map_pow, pAdicIdeal, Ideal.map_span, Set.image_singleton, map_natCast]
  exact h (Ideal.mem_map_of_mem g hc)

/-- The ideal `(p)^n` is the submodule `p^n D`. -/
theorem mem_pPowSmul_self_iff {n : ℕ} {c : D} :
    c ∈ pPowSmul p D D n ↔ c ∈ pAdicIdeal (A := D) p ^ n := by
  rw [pPowSmul, Ideal.smul_top_eq_map, Algebra.algebraMap_self, Ideal.map_id]
  rfl

/-- Congruences modulo a submodule compose. -/
private theorem sub_mem_of_sub_mem_of_sub_mem {R N : Type*} [Ring R] [AddCommGroup N]
    [Module R N] {U : Submodule R N} {x y z : N} (h₁ : x - y ∈ U) (h₂ : y - z ∈ U) :
    x - z ∈ U := by
  simpa using U.add_mem h₁ h₂

/-- The antidiagonals of distinct multi-indices are disjoint. -/
private theorem pairwiseDisjoint_antidiagonal {ι : Type*} [DecidableEq ι]
    (R : Finset (ι →₀ ℕ)) : (R : Set (ι →₀ ℕ)).PairwiseDisjoint fun Q ↦ antidiagonal Q := by
  intro Q _ Q' _ hQQ'
  simp only [Function.onFun, Finset.disjoint_left]
  intro P hP hP'
  exact hQQ' ((mem_antidiagonal.mp hP).symm.trans (mem_antidiagonal.mp hP'))

end Filtration

/-! ### The Taylor sum -/

section Sum

variable (p : ℕ) (D : DividedPowerRing.{u}) {ι : Type uI}
  {M : Type u} [AddCommGroup M] [Module (D : Type u) M]
  {N : Type u} [AddCommGroup N] [Module (D : Type u) N]
  (thetaPow : (ι →₀ ℕ) → (M → M)) (incl : M →+ N) (zeta : ι → (D : Type u))

/-- **The `K`-th term `ζ^{[K]} • ι(θ_K m)` of the Taylor sum.** -/
def taylorSumTerm (m : M) (K : ι →₀ ℕ) : N :=
  taylorMonomial D zeta K • incl (thetaPow K m)

/-- A Taylor term whose operator lands in `p^n M` lies in `p^n N`. -/
theorem taylorSumTerm_mem {m : M} {K : ι →₀ ℕ} {n : ℕ}
    (h : thetaPow K m ∈ pPowSmul p (D : Type u) M n) :
    taylorSumTerm D thetaPow incl zeta m K ∈ pPowSmul p (D : Type u) N n :=
  Submodule.smul_mem _ _ (map_mem_pPowSmul_of_addMonoidHom p incl h)

/-- **Two finite truncations of the Taylor sum agree modulo `p^n`** as soon as each contains
every multi-index whose operator does not land in `p^n M`. -/
theorem sum_taylorSumTerm_sub_mem (m : M) (n : ℕ) (S S' : Finset (ι →₀ ℕ))
    (hS : ∀ K ∉ S, thetaPow K m ∈ pPowSmul p (D : Type u) M n)
    (hS' : ∀ K ∉ S', thetaPow K m ∈ pPowSmul p (D : Type u) M n) :
    ∑ K ∈ S, taylorSumTerm D thetaPow incl zeta m K -
        ∑ K ∈ S', taylorSumTerm D thetaPow incl zeta m K ∈ pPowSmul p (D : Type u) N n := by
  classical
  rw [← Finset.sum_sdiff (Finset.inter_subset_left : S ∩ S' ⊆ S),
    ← Finset.sum_sdiff (Finset.inter_subset_right : S ∩ S' ⊆ S'), add_sub_add_right_eq_sub]
  refine Submodule.sub_mem _ (Submodule.sum_mem _ fun K hK ↦ ?_)
    (Submodule.sum_mem _ fun K hK ↦ ?_)
  · obtain ⟨h1, h2⟩ := Finset.mem_sdiff.mp hK
    exact taylorSumTerm_mem p D thetaPow incl zeta
      (hS' K fun h ↦ h2 (Finset.mem_inter.mpr ⟨h1, h⟩))
  · obtain ⟨h1, h2⟩ := Finset.mem_sdiff.mp hK
    exact taylorSumTerm_mem p D thetaPow incl zeta
      (hS K fun h ↦ h2 (Finset.mem_inter.mpr ⟨h, h1⟩))

variable (hfin : ∀ (n : ℕ) (m : M),
  {K : ι →₀ ℕ | thetaPow K m ∉ pPowSmul p (D : Type u) M n}.Finite)

/-- Outside the finite set `(hfin n m).toFinset` the operators land in `p^n M`. -/
theorem mem_pPowSmul_of_notMem_toFinset (n : ℕ) (m : M) (K : ι →₀ ℕ)
    (hK : K ∉ (hfin n m).toFinset) : thetaPow K m ∈ pPowSmul p (D : Type u) M n :=
  not_not.mp fun hc ↦ hK ((hfin n m).mem_toFinset.mpr hc)

include hfin in
/-- **The Taylor sum converges in a `p`-adically complete module**: there is an element of `N`
congruent modulo `p^n N` to every truncation that contains the multi-indices whose operator does
not land in `p^n M`. -/
theorem exists_taylorSum (hN : IsPrecomplete (pAdicIdeal (A := (D : Type u)) p) N) (m : M) :
    ∃ t : N, ∀ (n : ℕ) (S : Finset (ι →₀ ℕ)),
      (∀ K ∉ S, thetaPow K m ∈ pPowSmul p (D : Type u) M n) →
        t - ∑ K ∈ S, taylorSumTerm D thetaPow incl zeta m K ∈ pPowSmul p (D : Type u) N n := by
  classical
  set f : ℕ → N := fun n ↦ ∑ K ∈ (hfin n m).toFinset, taylorSumTerm D thetaPow incl zeta m K
    with hf
  have hgood : ∀ n, ∀ K ∉ (hfin n m).toFinset, thetaPow K m ∈ pPowSmul p (D : Type u) M n :=
    fun n ↦ mem_pPowSmul_of_notMem_toFinset p D thetaPow hfin n m
  obtain ⟨L, hL⟩ := hN.prec (f := f) fun {a b} hab ↦ by
    rw [SModEq.sub_mem]
    exact sum_taylorSumTerm_sub_mem p D thetaPow incl zeta m a _ _ (hgood a)
      fun K hK ↦ pPowSmul_antitone p hab (hgood b K hK)
  refine ⟨L, fun n S hS ↦ ?_⟩
  have h1 := SModEq.sub_mem.mp (hL n).symm
  have h2 := sum_taylorSumTerm_sub_mem p D thetaPow incl zeta m n _ S (hgood n) hS
  exact sub_mem_of_sub_mem_of_sub_mem h1 h2

variable (hN : IsAdicComplete (pAdicIdeal (A := (D : Type u)) p) N)

/-- **The Taylor sum `∑_K ζ^{[K]} • ι(θ_K m)`** in a `p`-adically complete module. -/
def completeTaylorSum (m : M) : N :=
  (exists_taylorSum p D thetaPow incl zeta hfin hN.toIsPrecomplete m).choose

/-- **The Taylor sum is congruent to its truncations** modulo `p^n N`, for every truncation
containing the multi-indices whose operator does not land in `p^n M`. -/
theorem taylorSum_sub_sum_mem (m : M) (n : ℕ) (S : Finset (ι →₀ ℕ))
    (hS : ∀ K ∉ S, thetaPow K m ∈ pPowSmul p (D : Type u) M n) :
    completeTaylorSum p D thetaPow incl zeta hfin hN m -
        ∑ K ∈ S, taylorSumTerm D thetaPow incl zeta m K ∈ pPowSmul p (D : Type u) N n :=
  (exists_taylorSum p D thetaPow incl zeta hfin hN.toIsPrecomplete m).choose_spec n S hS

/-- **The Taylor sum is the only element congruent to its truncations**: `N` being `p`-adically
separated, these congruences pin it down. -/
theorem eq_taylorSum_of_forall (m : M) (t : N)
    (ht : ∀ (n : ℕ) (S : Finset (ι →₀ ℕ)),
      (∀ K ∉ S, thetaPow K m ∈ pPowSmul p (D : Type u) M n) →
        t - ∑ K ∈ S, taylorSumTerm D thetaPow incl zeta m K ∈ pPowSmul p (D : Type u) N n) :
    t = completeTaylorSum p D thetaPow incl zeta hfin hN m := by
  classical
  rw [← sub_eq_zero]
  refine hN.toIsHausdorff.haus _ fun n ↦ ?_
  rw [SModEq.sub_mem, sub_zero]
  have hgood : ∀ K ∉ (hfin n m).toFinset, thetaPow K m ∈ pPowSmul p (D : Type u) M n :=
    mem_pPowSmul_of_notMem_toFinset p D thetaPow hfin n m
  have h1 := ht n _ hgood
  have h2 := taylorSum_sub_sum_mem p D thetaPow incl zeta hfin hN m n _ hgood
  exact sub_sub_sub_cancel_right t _ _ ▸ Submodule.sub_mem _ h1 h2

include hN in
/-- An element is determined modulo `p^n N` for all `n`: two elements of a `p`-adically
separated module whose difference lies in every `p^n N` are equal. -/
theorem eq_of_forall_sub_mem_pPowSmul {x y : N}
    (h : ∀ n : ℕ, x - y ∈ pPowSmul p (D : Type u) N n) : x = y := by
  rw [← sub_eq_zero]
  exact hN.toIsHausdorff.haus _ fun n ↦ by rw [SModEq.sub_mem, sub_zero]; exact h n

end Sum

/-! ### Additivity and semilinearity -/

section Identities

variable (p : ℕ) (D : DividedPowerRing.{u}) {ι : Type uI} [DecidableEq ι]
  {M : Type u} [AddCommGroup M] [Module (D : Type u) M]
  {N : Type u} [AddCommGroup N] [Module (D : Type u) N]
  {theta : ι → (M → M)} {thetaPow : (ι →₀ ℕ) → (M → M)} (incl : M →+ N)
  (zeta : ι → (D : Type u))
  (hfin : ∀ (n : ℕ) (m : M),
    {K : ι →₀ ℕ | thetaPow K m ∉ pPowSmul p (D : Type u) M n}.Finite)
  (hN : IsAdicComplete (pAdicIdeal (A := (D : Type u)) p) N)

/-- **The Taylor sum is additive**, the composite coordinate operators being additive. -/
theorem taylorSum_add (hfamM : IsThetaMonomialFamily M theta thetaPow)
    (hthAdd : ∀ (i : ι) (x y : M), theta i (x + y) = theta i x + theta i y) (m m' : M) :
    completeTaylorSum p D thetaPow incl zeta hfin hN (m + m') =
      completeTaylorSum p D thetaPow incl zeta hfin hN m +
        completeTaylorSum p D thetaPow incl zeta hfin hN m' := by
  classical
  refine (eq_taylorSum_of_forall p D thetaPow incl zeta hfin hN (m + m') _ fun n S hS ↦ ?_).symm
  set S₁ := (hfin n m).toFinset
  set S₂ := (hfin n m').toFinset
  have h₁ := mem_pPowSmul_of_notMem_toFinset p D thetaPow hfin n m
  have h₂ := mem_pPowSmul_of_notMem_toFinset p D thetaPow hfin n m'
  set U := S ∪ S₁ ∪ S₂ with hU
  have hU1 : ∀ K ∉ U, thetaPow K m ∈ pPowSmul p (D : Type u) M n :=
    fun K hK ↦ h₁ K fun h ↦ hK (Finset.mem_union_left _ (Finset.mem_union_right _ h))
  have hU2 : ∀ K ∉ U, thetaPow K m' ∈ pPowSmul p (D : Type u) M n :=
    fun K hK ↦ h₂ K fun h ↦ hK (Finset.mem_union_right _ h)
  have hU3 : ∀ K ∉ U, thetaPow K (m + m') ∈ pPowSmul p (D : Type u) M n :=
    fun K hK ↦ hS K fun h ↦ hK (Finset.mem_union_left _ (Finset.mem_union_left _ h))
  have hsplit : ∑ K ∈ U, taylorSumTerm D thetaPow incl zeta (m + m') K =
      ∑ K ∈ U, taylorSumTerm D thetaPow incl zeta m K +
        ∑ K ∈ U, taylorSumTerm D thetaPow incl zeta m' K := by
    rw [← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun K _ ↦ ?_
    simp only [taylorSumTerm]
    rw [hfamM.map_add hthAdd K m m', map_add, smul_add]
  have e1 := taylorSum_sub_sum_mem p D thetaPow incl zeta hfin hN m n U hU1
  have e2 := taylorSum_sub_sum_mem p D thetaPow incl zeta hfin hN m' n U hU2
  have e3 := sum_taylorSumTerm_sub_mem p D thetaPow incl zeta (m + m') n U S hU3 hS
  refine sub_mem_of_sub_mem_of_sub_mem ?_ e3
  rw [hsplit, add_sub_add_comm]
  exact Submodule.add_mem _ e1 e2

/-- **The Taylor sum is semilinear**: if `ι` is `g`-semilinear and Taylor's formula
`f(a) ≡ ∑_J g(∂_J a) ζ^{[J]}` holds modulo every `p^n`, with the surviving coefficients finite,
then `T(a • m) = f(a) • T(m)`.

The computation is the source's: the Leibniz rule `Crystalline.thetaPow_smul_eq_support` expands
`θ_L(a m)` over the antidiagonal of `L`, `Crystalline.taylorMonomial_mul` regroups
`ζ^{[J]} ζ^{[K]}`, and the double sum is the product of the expansion of `a` with the series of
`m`; the terms with an operator in `p^n` are dropped at the level `n`. -/
theorem taylorSum_smul {delta : ι → (D.carrier → D.carrier)}
    {deltaPow : (ι →₀ ℕ) → (D.carrier → D.carrier)} (f g : (D : Type u) →+* (D : Type u))
    (hincl : ∀ (x : (D : Type u)) (m : M), incl (x • m) = g x • incl m)
    (hfamM : IsThetaMonomialFamily M theta thetaPow)
    (hfamD : IsThetaMonomialFamily (D : Type u) delta deltaPow)
    (hthAdd : ∀ (i : ι) (x y : M), theta i (x + y) = theta i x + theta i y)
    (hleib : ∀ (i : ι) (a : (D : Type u)) (m : M),
      theta i (a • m) = a • theta i m + delta i a • m)
    (hzeta : ∀ i, zeta i ∈ D.ideal)
    (htay : ∀ (a : (D : Type u)) (n : ℕ), ∃ T : Finset (ι →₀ ℕ),
      (∀ J ∉ T, deltaPow J a ∈ pAdicIdeal (A := (D : Type u)) p ^ n) ∧
        f a - ∑ J ∈ T, g (deltaPow J a) * taylorMonomial D zeta J ∈
          pAdicIdeal (A := (D : Type u)) p ^ n)
    (a : (D : Type u)) (m : M) :
    completeTaylorSum p D thetaPow incl zeta hfin hN (a • m) =
      f a • completeTaylorSum p D thetaPow incl zeta hfin hN m := by
  classical
  refine (eq_taylorSum_of_forall p D thetaPow incl zeta hfin hN (a • m) _ fun n S' hS' ↦ ?_).symm
  set S := (hfin n m).toFinset
  have hS := mem_pPowSmul_of_notMem_toFinset p D thetaPow hfin n m
  obtain ⟨T, hTvan, hTay⟩ := htay a n
  set U := S' ∪ (T ×ˢ S).image (fun P : (ι →₀ ℕ) × (ι →₀ ℕ) ↦ P.1 + P.2) with hU
  have hUgood : ∀ K ∉ U, thetaPow K (a • m) ∈ pPowSmul p (D : Type u) M n :=
    fun K hK ↦ hS' K fun h ↦ hK (Finset.mem_union_left _ h)
  set F : (ι →₀ ℕ) × (ι →₀ ℕ) → N := fun P ↦
    (g (deltaPow P.1 a) * taylorMonomial D zeta P.1 * taylorMonomial D zeta P.2) •
      incl (thetaPow P.2 m) with hFdef
  -- The left side regrouped as a sum over pairs.
  have hterm : ∀ (J K : ι →₀ ℕ),
      taylorMonomial D zeta (J + K) •
          incl ((∏ i ∈ (J + K).support, ((J + K) i).choose (J i)) •
            (deltaPow J a • thetaPow K m)) = F (J, K) := by
    intro J K
    rw [map_nsmul, hincl, smul_comm, ← smul_assoc, nsmul_eq_mul, ← nsmul_eq_mul,
      ← taylorMonomial_mul D hzeta J K]
    simp only [hFdef]
    rw [smul_smul, mul_comm (taylorMonomial D zeta J * taylorMonomial D zeta K), ← mul_assoc]
  have hA : ∑ L ∈ U, taylorSumTerm D thetaPow incl zeta (a • m) L =
      ∑ P ∈ U.biUnion fun L ↦ antidiagonal L, F P := by
    rw [Finset.sum_biUnion (pairwiseDisjoint_antidiagonal U)]
    refine Finset.sum_congr rfl fun L _ ↦ ?_
    simp only [taylorSumTerm]
    rw [thetaPow_smul_eq_support hfamM hfamD hthAdd hleib a m L, map_sum, Finset.smul_sum]
    refine Finset.sum_congr rfl fun P hP ↦ ?_
    rw [mem_antidiagonal] at hP
    subst hP
    exact hterm P.1 P.2
  have hsub : T ×ˢ S ⊆ U.biUnion fun L ↦ antidiagonal L := by
    intro P hP
    refine Finset.mem_biUnion.mpr ⟨P.1 + P.2, ?_, mem_antidiagonal.mpr rfl⟩
    exact Finset.mem_union_right _ (Finset.mem_image.mpr ⟨P, hP, rfl⟩)
  have hB : ∑ P ∈ T ×ˢ S, F P - ∑ P ∈ U.biUnion (fun L ↦ antidiagonal L), F P ∈
      pPowSmul p (D : Type u) N n := by
    rw [← Finset.sum_sdiff hsub, sub_add_cancel_right]
    refine Submodule.neg_mem _ (Submodule.sum_mem _ fun P hP ↦ ?_)
    have hP' := (Finset.mem_sdiff.mp hP).2
    by_cases h1 : P.1 ∈ T
    · have h2 : P.2 ∉ S := fun h ↦ hP' (Finset.mem_product.mpr ⟨h1, h⟩)
      exact Submodule.smul_mem _ _ (map_mem_pPowSmul_of_addMonoidHom p incl (hS P.2 h2))
    · refine smul_mem_pPowSmul_of_mem p ?_ _
      rw [mul_assoc]
      exact Ideal.mul_mem_right _ _ (ringHom_mem_pAdicIdeal_pow p g (hTvan P.1 h1))
  have hC : ∑ P ∈ T ×ˢ S, F P =
      (∑ J ∈ T, g (deltaPow J a) * taylorMonomial D zeta J) •
        ∑ K ∈ S, taylorSumTerm D thetaPow incl zeta m K := by
    rw [Finset.sum_product, Finset.sum_smul]
    refine Finset.sum_congr rfl fun J _ ↦ ?_
    rw [Finset.smul_sum]
    refine Finset.sum_congr rfl fun K _ ↦ ?_
    simp only [hFdef, taylorSumTerm, smul_smul]
  have e1 := taylorSum_sub_sum_mem p D thetaPow incl zeta hfin hN m n S hS
  have e4 := sum_taylorSumTerm_sub_mem p D thetaPow incl zeta (a • m) n U S' hUgood hS'
  have h12 : f a • completeTaylorSum p D thetaPow incl zeta hfin hN m -
      ∑ P ∈ T ×ˢ S, F P ∈ pPowSmul p (D : Type u) N n := by
    rw [hC]
    refine sub_mem_of_sub_mem_of_sub_mem
      (y := f a • ∑ K ∈ S, taylorSumTerm D thetaPow incl zeta m K)
      (by rw [← smul_sub]; exact Submodule.smul_mem _ _ e1) ?_
    rw [← sub_smul]
    exact smul_mem_pPowSmul_of_mem p hTay _
  refine sub_mem_of_sub_mem_of_sub_mem (sub_mem_of_sub_mem_of_sub_mem h12 hB) ?_
  rw [← hA]
  exact e4

end Identities

/-! ### Composition of Taylor sums -/

section Composition

variable (p : ℕ) (D : DividedPowerRing.{u}) {ι : Type uI} [DecidableEq ι]
  {M : Type u} [AddCommGroup M] [Module (D : Type u) M]
  {N : Type u} [AddCommGroup N] [Module (D : Type u) N]
  {N₂ : Type u} [AddCommGroup N₂] [Module (D : Type u) N₂]
  {theta : ι → (M → M)} {thetaPow : (ι →₀ ℕ) → (M → M)}
  (hfin : ∀ (n : ℕ) (m : M),
    {K : ι →₀ ℕ | thetaPow K m ∉ pPowSmul p (D : Type u) M n}.Finite)
  (hN : IsAdicComplete (pAdicIdeal (A := (D : Type u)) p) N)
  (hN₂ : IsAdicComplete (pAdicIdeal (A := (D : Type u)) p) N₂)

omit [DecidableEq ι] in
/-- **A linear map commutes with Taylor sums**: `φ (∑_K ζ^{[K]} • ι(θ_K m)) =
∑_K ζ^{[K]} • φ(ι(θ_K m))`, the linear map carrying `p^n N` into `p^n N₂`. -/
theorem map_taylorSum (incl : M →+ N) (zeta : ι → (D : Type u)) (φ : N →ₗ[(D : Type u)] N₂)
    (m : M) :
    φ (completeTaylorSum p D thetaPow incl zeta hfin hN m) =
      completeTaylorSum p D thetaPow (φ.toAddMonoidHom.comp incl) zeta hfin hN₂ m := by
  refine eq_taylorSum_of_forall p D thetaPow _ zeta hfin hN₂ m _ fun n S hS ↦ ?_
  have h := map_mem_pPowSmul_of_addMonoidHom p φ.toAddMonoidHom
    (taylorSum_sub_sum_mem p D thetaPow incl zeta hfin hN m n S hS)
  simpa [taylorSumTerm, map_sub, map_sum, map_smul] using h

/-- **The Taylor sum of the zero family is the inclusion**: only the multi-index `0` survives. -/
theorem taylorSum_zero_family (hfamM : IsThetaMonomialFamily M theta thetaPow) (incl : M →+ N)
    (m : M) : completeTaylorSum p D thetaPow incl 0 hfin hN m = incl m := by
  classical
  refine (eq_taylorSum_of_forall p D thetaPow incl 0 hfin hN m _ fun n S hS ↦ ?_).symm
  have hsum : ∑ K ∈ S, taylorSumTerm D thetaPow incl 0 m K =
      if (0 : ι →₀ ℕ) ∈ S then incl m else 0 := by
    split_ifs with h
    · rw [Finset.sum_eq_single_of_mem (0 : ι →₀ ℕ) h]
      · simp [taylorSumTerm, hfamM.apply_zero]
      · intro K _ hK
        simp [taylorSumTerm, taylorMonomial_zero_family D hK]
    · refine Finset.sum_eq_zero fun K hK ↦ ?_
      have hK0 : K ≠ 0 := fun h0 ↦ h (h0 ▸ hK)
      simp [taylorSumTerm, taylorMonomial_zero_family D hK0]
  rw [hsum]
  split_ifs with h
  · rw [sub_self]; exact Submodule.zero_mem _
  · rw [sub_zero]
    have := hS 0 h
    rw [hfamM.apply_zero] at this
    exact map_mem_pPowSmul_of_addMonoidHom p incl this

/-- The finite set of multi-indices below some multi-index whose operator does not land in
`p^n M`: it is downward closed and contains every such multi-index. -/
def taylorBox (n : ℕ) (m : M) : Finset (ι →₀ ℕ) :=
  (hfin n m).toFinset.biUnion Finset.Iic

/-- The box `Crystalline.taylorBox` is downward closed. -/
theorem mem_taylorBox_of_le {n : ℕ} {m : M} {K L : ι →₀ ℕ}
    (hK : K ∈ taylorBox p D hfin n m) (hLK : L ≤ K) : L ∈ taylorBox p D hfin n m := by
  obtain ⟨Q, hQ, hKQ⟩ := Finset.mem_biUnion.mp hK
  exact Finset.mem_biUnion.mpr ⟨Q, hQ, Finset.mem_Iic.mpr (hLK.trans (Finset.mem_Iic.mp hKQ))⟩

/-- Outside the box `Crystalline.taylorBox` the operators land in `p^n M`. -/
theorem mem_pPowSmul_of_notMem_taylorBox {n : ℕ} {m : M} {K : ι →₀ ℕ}
    (hK : K ∉ taylorBox p D hfin n m) : thetaPow K m ∈ pPowSmul p (D : Type u) M n := by
  refine mem_pPowSmul_of_notMem_toFinset p D thetaPow hfin n m K fun h ↦ hK ?_
  exact Finset.mem_biUnion.mpr ⟨K, h, Finset.mem_Iic.mpr le_rfl⟩

/-- **The cocycle of Taylor sums**: summing the `η`-series of `θ_K m` against the `ξ`-series is
the `(ξ + η)`-series, `∑_K ξ^{[K]} • ∑_L η^{[L]} • ι(θ_L θ_K m) = ∑_Q (ξ + η)^{[Q]} • ι(θ_Q m)`.
This is the identity `c_{g,h} ∘ c_{f,g} = c_{f,h}` of [Stacks, Tag 07JH] in a complete module,
by the multi-index binomial formula `Crystalline.taylorMonomial_add`. -/
theorem taylorSum_taylorSum (hfamM : IsThetaMonomialFamily M theta thetaPow)
    (hthAdd : ∀ (i : ι) (x y : M), theta i (x + y) = theta i x + theta i y) (incl : M →+ N)
    {xi eta : ι → (D : Type u)} (hxi : ∀ i, xi i ∈ D.ideal) (heta : ∀ i, eta i ∈ D.ideal)
    (m : M) :
    completeTaylorSum p D thetaPow
        (AddMonoidHom.mk' (completeTaylorSum p D thetaPow incl eta hfin hN)
          (taylorSum_add p D incl eta hfin hN hfamM hthAdd)) xi hfin hN m =
      completeTaylorSum p D thetaPow incl (xi + eta) hfin hN m := by
  classical
  symm
  refine eq_taylorSum_of_forall p D thetaPow _ xi hfin hN m _ fun n S hS ↦ ?_
  set R := taylorBox p D hfin n m with hR
  have hRgood : ∀ K ∉ R, thetaPow K m ∈ pPowSmul p (D : Type u) M n :=
    fun K hK ↦ mem_pPowSmul_of_notMem_taylorBox p D hfin hK
  -- the inner truncation over `R` is good for each `θ_K m`
  have hinner : ∀ K, ∀ L ∉ R, thetaPow L (thetaPow K m) ∈ pPowSmul p (D : Type u) M n := by
    intro K L hL
    have : thetaPow L (thetaPow K m) = thetaPow (K + L) m := by rw [hfamM.add K L]; rfl
    rw [this]
    exact hRgood _ fun h ↦ hL (mem_taylorBox_of_le p D hfin h le_add_self)
  set G : (ι →₀ ℕ) × (ι →₀ ℕ) → N := fun P ↦
    (taylorMonomial D xi P.1 * taylorMonomial D eta P.2) • incl (thetaPow (P.1 + P.2) m)
    with hG
  -- the truncation of the right-hand side over `R` is a double sum
  have hdouble : ∀ K, taylorMonomial D xi K • completeTaylorSum p D thetaPow incl eta hfin hN
      (thetaPow K m) - ∑ L ∈ R, G (K, L) ∈ pPowSmul p (D : Type u) N n := by
    intro K
    have h := taylorSum_sub_sum_mem p D thetaPow incl eta hfin hN (thetaPow K m) n R (hinner K)
    have heq : ∑ L ∈ R, G (K, L) = taylorMonomial D xi K •
        ∑ L ∈ R, taylorSumTerm D thetaPow incl eta (thetaPow K m) L := by
      rw [Finset.smul_sum]
      refine Finset.sum_congr rfl fun L _ ↦ ?_
      simp only [hG, taylorSumTerm, smul_smul]
      rw [hfamM.add K L]; rfl
    rw [heq, ← smul_sub]
    exact Submodule.smul_mem _ _ h
  have hdown : ∀ K ∈ R, ∀ L ≤ K, L ∈ R := fun K hK L hLK ↦ mem_taylorBox_of_le p D hfin hK hLK
  have hbox : ∑ P ∈ R ×ˢ R, G P - ∑ Q ∈ R, taylorSumTerm D thetaPow incl (xi + eta) m Q ∈
      pPowSmul p (D : Type u) N n := by
    rw [← Finset.sum_filter_add_sum_filter_not (R ×ˢ R)
      fun P : (ι →₀ ℕ) × (ι →₀ ℕ) ↦ P.1 + P.2 ∈ R]
    have hiff : ∀ P : (ι →₀ ℕ) × (ι →₀ ℕ),
        P ∈ (R ×ˢ R).filter (fun P : (ι →₀ ℕ) × (ι →₀ ℕ) ↦ P.1 + P.2 ∈ R) ↔ P.1 + P.2 ∈ R := by
      intro P
      rw [Finset.mem_filter, Finset.mem_product]
      exact ⟨fun h ↦ h.2, fun h ↦ ⟨⟨hdown _ h _ le_self_add, hdown _ h _ le_add_self⟩, h⟩⟩
    have htb : (R ×ˢ R).filter (fun P : (ι →₀ ℕ) × (ι →₀ ℕ) ↦ P.1 + P.2 ∈ R) =
        R.biUnion fun Q ↦ antidiagonal Q := by
      ext P
      rw [hiff P, Finset.mem_biUnion]
      exact ⟨fun h ↦ ⟨P.1 + P.2, h, mem_antidiagonal.mpr rfl⟩,
        fun ⟨Q, hQ, hPQ⟩ ↦ (mem_antidiagonal.mp hPQ) ▸ hQ⟩
    have hmain : ∑ P ∈ (R ×ˢ R).filter (fun P : (ι →₀ ℕ) × (ι →₀ ℕ) ↦ P.1 + P.2 ∈ R), G P =
        ∑ Q ∈ R, taylorSumTerm D thetaPow incl (xi + eta) m Q := by
      rw [htb, Finset.sum_biUnion (pairwiseDisjoint_antidiagonal R)]
      refine Finset.sum_congr rfl fun Q _ ↦ ?_
      simp only [taylorSumTerm]
      rw [taylorMonomial_add D xi eta hxi heta Q, Finset.sum_smul]
      refine Finset.sum_congr rfl fun P hP ↦ ?_
      rw [mem_antidiagonal] at hP
      simp only [hG, hP]
    rw [hmain, add_sub_cancel_left]
    refine Submodule.sum_mem _ fun P hP ↦ ?_
    rw [Finset.mem_filter] at hP
    exact Submodule.smul_mem _ _ (map_mem_pPowSmul_of_addMonoidHom p incl (hRgood _ hP.2))
  have e1 := taylorSum_sub_sum_mem p D thetaPow incl (xi + eta) hfin hN m n R hRgood
  have e2 := sum_taylorSumTerm_sub_mem p D thetaPow
    (AddMonoidHom.mk' (completeTaylorSum p D thetaPow incl eta hfin hN)
      (taylorSum_add p D incl eta hfin hN hfamM hthAdd)) xi m n R S hRgood hS
  have e3 : ∑ K ∈ R, taylorSumTerm D thetaPow
        (AddMonoidHom.mk' (completeTaylorSum p D thetaPow incl eta hfin hN)
          (taylorSum_add p D incl eta hfin hN hfamM hthAdd)) xi m K -
      ∑ P ∈ R ×ˢ R, G P ∈ pPowSmul p (D : Type u) N n := by
    rw [Finset.sum_product, ← Finset.sum_sub_distrib]
    exact Submodule.sum_mem _ fun K _ ↦ hdouble K
  exact sub_mem_of_sub_mem_of_sub_mem (by simpa using Submodule.sub_mem _ e1 hbox)
    (by simpa using Submodule.sub_mem _ e2 e3)

end Composition

