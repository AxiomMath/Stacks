module

public import Mathlib.RingTheory.AdicCompletion.Algebra
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Crystalline.AffineSite
public import StacksFrontier.AlgebraicGeometry.Crystalline.DividedPowerEnvelope
public import StacksFrontier.RingTheory.DividedPowers.Ring

/-!
# The completed divided power envelope of a polynomial presentation

Work in an affine crystalline situation `(A, I, γ, C)`. Choosing a polynomial algebra
`P = A[x_i]` over the base together with a surjection `P → C` presents `C` as a quotient of a
divided power polynomial algebra. Let `J = ker(P → C)`; the hypothesis that `I` dies in `C`
forces `IP ⊆ J`, so the divided power envelope `D_{P, γ}(J)` of `J` relative to `(A, I, γ)` is
defined. Completing it `p`-adically gives the ring

  `D = lim_e D_{P, γ}(J) / p^e D_{P, γ}(J)`,

which is the ring computing crystalline cohomology of `C` over `A` from the chosen
presentation. This file constructs `D` together with its algebra structure over the base.

The same construction applied to the `(n + 1)`-fold tensor power `P ⊗_A … ⊗_A P` of the chosen
presentation, whose kernel over `C` is written `J(n)`, gives the rings

  `D(n) = lim_e D_{P ⊗_A … ⊗_A P, γ}(J(n)) / p^e D_{P ⊗_A … ⊗_A P, γ}(J(n))`

whose spectra are the `(n + 1)`-fold products of `Spec(D)` in the crystalline site.

## Main definitions

* `Crystalline.polynomialDividedPowerEnvelope` — the divided power envelope of the kernel of
  the chosen polynomial presentation of `C`.
* `Crystalline.pAdicCompletedDividedPowerEnvelope` — the ring `D` attached to a polynomial
  presentation.
* `Crystalline.toPAdicCompletedDividedPowerEnvelope` — the canonical map `P → D` from the
  chosen polynomial presentation to its completed divided power envelope.
* `Crystalline.mvPolynomialCoprojection` — the coprojection of a polynomial algebra into the
  factor of given index of a tensor power of itself.
* `Crystalline.tensorPowerPresentation` — the map `P ⊗_A … ⊗_A P → C` induced by a polynomial
  presentation `P → C`, whose kernel is `J(n)`.
* `Crystalline.pAdicCompletedTensorPowerEnvelope` — the ring `D(n)`.

## Implementation notes

The inverse limit is Mathlib's `AdicCompletion` for the principal ideal generated by the image
of `p`. The `(n + 1)`-fold tensor power of `P = A[x_i]` over `A` is the polynomial algebra
`A[x_i(j)]` on `Fin (n + 1) × ι`, and its `j`-th coprojection renames `x_i` to `x_i(j)`.

## References

* [Stacks Project, Tag 07J8](https://stacks.math.columbia.edu/tag/07J8)
* [Stacks Project, Equation 60.17.0.4, Tag 07JF](https://stacks.math.columbia.edu/tag/07JF)
-/

@[expose] public section

universe u v w

namespace Crystalline

/-- The divided power envelope of the kernel of a polynomial `A`-algebra map
to `C`. -/
public noncomputable def polynomialDividedPowerEnvelope
    (s : AffineCrystallineSituation.{u, v}) {ι : Type w}
    (f : MvPolynomial ι s.A →ₐ[s.A] s.C) :
    DividedPowerEnvelope s.A
      (algebraMap s.A (MvPolynomial ι s.A))
      (RingHom.ker f.toRingHom) (by
        rw [Ideal.map_le_iff_le_comap]
        intro x hx
        change f (algebraMap s.A (MvPolynomial ι s.A) x) = 0
        rw [f.commutes]
        have hx' : algebraMap s.A s.C x ∈
            s.A.ideal.map (algebraMap s.A s.C) :=
          Ideal.mem_map_of_mem (algebraMap s.A s.C) hx
        rw [s.ideal_map_eq_bot] at hx'
        exact hx') :=
  dividedPowerEnvelope s.A
    (algebraMap s.A (MvPolynomial ι s.A)) (RingHom.ker f.toRingHom) _

/-- The `p`-adically completed divided power envelope of the kernel of a
surjective polynomial presentation of `C` over `A`. -/
@[stacks 07J8]
public noncomputable abbrev pAdicCompletedDividedPowerEnvelope
    (s : AffineCrystallineSituation.{u, v}) {ι : Type w}
    (f : MvPolynomial ι s.A →ₐ[s.A] s.C) (_hf : Function.Surjective f) : Type (max u w) :=
  let E := (polynomialDividedPowerEnvelope s f).object
  AdicCompletion (Ideal.span {(s.p : E)}) E

/-- The completed divided power envelope has its canonical algebra structure
over the base ring. -/
public noncomputable instance
    (s : AffineCrystallineSituation.{u, v}) {ι : Type w}
    (f : MvPolynomial ι s.A →ₐ[s.A] s.C) (hf : Function.Surjective f) :
    Algebra s.A (pAdicCompletedDividedPowerEnvelope s f hf) :=
  let env := polynomialDividedPowerEnvelope s f
  let E := env.object
  ((algebraMap E (AdicCompletion (Ideal.span {(s.p : E)}) E)).comp
    env.structureMap.toRingHom).toAlgebra

/-- The canonical map `P → D` from a polynomial presentation of `C` to the `p`-adically
completed divided power envelope of its kernel: the map to the envelope followed by the map
to the completion. -/
public noncomputable def toPAdicCompletedDividedPowerEnvelope
    (s : AffineCrystallineSituation.{u, v}) {ι : Type w}
    (f : MvPolynomial ι s.A →ₐ[s.A] s.C) (hf : Function.Surjective f) :
    MvPolynomial ι s.A →+* pAdicCompletedDividedPowerEnvelope s f hf :=
  (algebraMap (polynomialDividedPowerEnvelope s f).object
      (pAdicCompletedDividedPowerEnvelope s f hf)).comp
    (polynomialDividedPowerEnvelope s f).algebraMap.toRingHom

/-- The coprojection of `R[x_i]` into the factor of index `j` of the `(n + 1)`-fold tensor
power `R[x_i] ⊗_R … ⊗_R R[x_i]`, presented as the polynomial algebra on `Fin (n + 1) × ι`:
it renames the variable `x_i` to the variable `x_i(j)` of the `j`-th factor. -/
public noncomputable def mvPolynomialCoprojection (R : Type u) [CommRing R] {ι : Type w}
    {n : ℕ} (j : Fin (n + 1)) :
    MvPolynomial ι R →ₐ[R] MvPolynomial (Fin (n + 1) × ι) R :=
  MvPolynomial.rename fun i ↦ (j, i)

/-- The map `P ⊗_A … ⊗_A P → C` on the `(n + 1)`-fold tensor power of a polynomial
presentation `f : P → C`, namely the map restricting to `f` on each tensor factor. Its kernel
is the ideal `J(n)`. -/
public noncomputable def tensorPowerPresentation (s : AffineCrystallineSituation.{u, v})
    {ι : Type w} (f : MvPolynomial ι s.A →ₐ[s.A] s.C) (n : ℕ) :
    MvPolynomial (Fin (n + 1) × ι) s.A →ₐ[s.A] s.C :=
  f.comp (MvPolynomial.rename Prod.snd)

/-- The map induced on the `(n + 1)`-fold tensor power restricts to the given presentation on
each of the `n + 1` tensor factors. -/
public lemma tensorPowerPresentation_comp_coprojection
    (s : AffineCrystallineSituation.{u, v}) {ι : Type w}
    (f : MvPolynomial ι s.A →ₐ[s.A] s.C) {n : ℕ} (j : Fin (n + 1)) :
    (tensorPowerPresentation s f n).comp (mvPolynomialCoprojection s.A j) = f := by
  ext i
  simp [tensorPowerPresentation, mvPolynomialCoprojection]

/-- The map induced on the `(n + 1)`-fold tensor power of a surjective polynomial
presentation is surjective. -/
public lemma tensorPowerPresentation_surjective (s : AffineCrystallineSituation.{u, v})
    {ι : Type w} (f : MvPolynomial ι s.A →ₐ[s.A] s.C) (hf : Function.Surjective f) (n : ℕ) :
    Function.Surjective (tensorPowerPresentation s f n) := by
  refine Function.Surjective.of_comp (g := mvPolynomialCoprojection s.A (0 : Fin (n + 1))) ?_
  rwa [← AlgHom.coe_comp, tensorPowerPresentation_comp_coprojection]

/-- The ring `D(n)`: the `p`-adically completed divided power envelope of the kernel `J(n)`
of the surjection `P ⊗_A … ⊗_A P → C` on the `(n + 1)`-fold tensor power of a surjective
polynomial presentation of `C` over `A`. -/
@[stacks 07JF]
public noncomputable abbrev pAdicCompletedTensorPowerEnvelope
    (s : AffineCrystallineSituation.{u, v}) {ι : Type w}
    (f : MvPolynomial ι s.A →ₐ[s.A] s.C) (hf : Function.Surjective f) (n : ℕ) :
    Type (max u w) :=
  pAdicCompletedDividedPowerEnvelope s (tensorPowerPresentation s f n)
    (tensorPowerPresentation_surjective s f hf n)

end Crystalline

end
