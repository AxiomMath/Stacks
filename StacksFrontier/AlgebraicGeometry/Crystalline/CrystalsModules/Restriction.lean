module

public import Mathlib.CategoryTheory.Sites.CoverPreserving
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Crystalline.BigSite.StructureSheaf
public import StacksFrontier.AlgebraicGeometry.Spaces.FormallySmooth.EtaleLocalLift

/-!
# Restriction to the ambient scheme of an object of the big crystalline site

An object `(U, T, δ)` of the big crystalline category restricts to `(U ∩ W, W, δ|_W)` over every
open `W` of its ambient scheme `T`, and these restrictions form a functor from the opens of `T`
to `CRIS(X/S)`.  That functor carries open covers to Zariski covering families and preserves
compatible families of sections, hence is continuous: the restriction `F_T` of a sheaf `F` on the
big crystalline site is a sheaf on `T`.  It is moreover cocontinuous: a covering family of a
restriction `(U ∩ W, W, δ|_W)` is refined by the restrictions of `(U, T, δ)` to a family of opens
covering `W`.

## Main results

* `Crystalline.GlobalCrystallineSituation.Thickening.restrictOpenMap_restrictOpenLE` — the
  restriction of an object to an open `V` inside an open `W` is, up to the canonical isomorphism,
  the restriction to `V` of the restriction to `W`.
* `Crystalline.GlobalCrystallineSituation.Thickening.liftRestrictOpen` — a morphism into an object
  whose map of ambient schemes has image inside an open factors through the restriction to that
  open.
* `Crystalline.GlobalCrystallineSituation.Thickening.coverPreserving_restrictOpenFunctor` and
  `Crystalline.GlobalCrystallineSituation.Thickening.compatiblePreserving_restrictOpenFunctor` —
  the two halves of continuity.
* `Crystalline.GlobalCrystallineSituation.Thickening.restrictOpenFunctor_isContinuous` — the
  restrictions to the opens of the ambient scheme form a continuous functor.
* `Crystalline.GlobalCrystallineSituation.Thickening.isSheaf_restriction` — the restriction of a
  sheaf on the big crystalline site to the ambient scheme of an object is a sheaf.
* `Crystalline.GlobalCrystallineSituation.Thickening.restrictOpenFunctor_isCocontinuous` — the
  restrictions to the opens of the ambient scheme form a cocontinuous functor.

## Implementation notes

Both halves of continuity rest on the same two facts: the structure morphism of a restriction is
a monomorphism, so a morphism into a restriction is determined by its composite into the object
itself; and a morphism whose ambient image lies in an open lifts to the restriction to that open,
which is `Crystalline.GlobalCrystallineSituation.Thickening.pullbackLiftHom` in the case where
the open over which the factorization exists is everything.

Compatible families are preserved because two morphisms out of one object into the restrictions
to `V₁` and to `V₂` which agree over a common larger open both factor through the restriction to
`V₁ ⊓ V₂`, by the lifting property, and the comparison is then an instance of compatibility of
the family over the two inclusions of `V₁ ⊓ V₂`.  The functor is not full and the categories of
structured arrows over an object of `CRIS(X/S)` can be empty, so neither
`CategoryTheory.compatiblePreservingOfFlat` nor
`CategoryTheory.compatiblePreservingOfDownwardsClosed` applies.

Cocontinuity is proved against the generating Zariski covering families, by
`CategoryTheory.Functor.isCocontinuous_toGrothendieck`: the covering sieves of the big crystalline
topology are a priori larger than the Zariski families, but the criterion only ever sees the sieve
generated by such a family, pulled back along a morphism `p` out of a restriction.  Given a point
of `W`, the open of the ambient scheme of `(U ∩ W, W, δ|_W)` over which `p` factors through the
member of the family covering the image of that point is
`Crystalline.GlobalCrystallineSituation.Thickening.pullbackOpen`, and its image in `T` is an open
`V ≤ W` containing the point for which the whole of `(U ∩ V, V, δ|_V)` factors through that
member; the factorization is read off `pullbackLiftHom`, whose source is the restriction of
`(U ∩ V, V, δ|_V)` to an open that is now everything.

## References

* [Stacks Project, Tag 00WW](https://stacks.math.columbia.edu/tag/00WW)
* [Stacks Project, Tag 07IQ](https://stacks.math.columbia.edu/tag/07IQ)
-/

@[expose] public section

open AlgebraicGeometry CategoryTheory TopologicalSpace

universe u

namespace Crystalline.GlobalCrystallineSituation

namespace Thickening

variable {S : GlobalCrystallineSituation.{u}}

/-- **The restriction of an object of `CRIS(X/S)` to an open equal to the whole ambient scheme is
that object.** -/
theorem isIso_restrictOpenHom_of_eq_top (A : Thickening S)
    {V : A.thickening.target.scheme.Opens} (hV : V = ⊤) : IsIso (A.restrictOpenHom V) := by
  subst hV
  exact A.isIso_restrictOpenHom_top

/-- **The map of ambient schemes of the structure morphism of a restriction is the open
immersion of the open in question.** -/
theorem restrictOpenHom_targetHom_hom (A : Thickening S)
    (V : A.thickening.target.scheme.Opens) :
    (A.restrictOpenHom V).targetHom.hom = V.ι := rfl

/-- **The image of the structure morphism of a restriction is the open in question.** -/
@[simp]
theorem restrictOpenHom_targetHom_opensRange (A : Thickening S)
    (V : A.thickening.target.scheme.Opens) :
    (A.restrictOpenHom V).targetHom.hom.opensRange = V :=
  V.opensRange_ι

/-- **A point of the ambient scheme of a restriction maps into the open in question.** -/
theorem restrictOpenHom_targetHom_base_mem (A : Thickening S)
    (V : A.thickening.target.scheme.Opens) (y : (A.restrictOpen V).thickening.target.scheme) :
    (A.restrictOpenHom V).targetHom.hom.base y ∈ V := by
  have h : (A.restrictOpenHom V).targetHom.hom.base y ∈
      (A.restrictOpenHom V).targetHom.hom.opensRange := ⟨y, rfl⟩
  rwa [restrictOpenHom_targetHom_opensRange] at h

/-- **A morphism into a restriction has ambient image inside the open in question.** -/
theorem comp_restrictOpenHom_targetHom_base_mem {X A : Thickening S}
    (V : A.thickening.target.scheme.Opens) (k : X ⟶ A.restrictOpen V)
    (y : X.thickening.target.scheme) :
    (k ≫ A.restrictOpenHom V).targetHom.hom.base y ∈ V :=
  restrictOpenHom_targetHom_base_mem A V _

/-- **A morphism factoring through a restriction has ambient image inside the open in
question.** -/
theorem targetHom_base_mem_of_comp_restrictOpenHom {X A : Thickening S}
    (V : A.thickening.target.scheme.Opens) (k : X ⟶ A.restrictOpen V) (r : X ⟶ A)
    (hk : k ≫ A.restrictOpenHom V = r) (y : X.thickening.target.scheme) :
    r.targetHom.hom.base y ∈ V := by
  subst hk
  exact comp_restrictOpenHom_targetHom_base_mem V k y

/-- **The morphism between the restrictions to two nested opens is a monomorphism.** -/
instance mono_restrictOpenLE (A : Thickening S) {V W : A.thickening.target.scheme.Opens}
    (h : V ≤ W) : Mono (A.restrictOpenLE h) :=
  have : Mono (A.restrictOpenLE h ≫ A.restrictOpenHom W) := by
    rw [restrictOpenLE_restrictOpenHom]
    infer_instance
  CategoryTheory.mono_of_mono (A.restrictOpenLE h) (A.restrictOpenHom W)

/-- **The restriction to an open inside another open, compared with the restriction of the
restriction.**  Composing the comparison with the inclusion of the smaller open into the larger
one gives the structure morphism of the restriction of the restriction. -/
theorem restrictOpenMap_restrictOpenLE (A : Thickening S)
    {V W : A.thickening.target.scheme.Opens} (h : V ≤ W) :
    restrictOpenMap (A.restrictOpenHom W) V ≫ A.restrictOpenLE h =
      (A.restrictOpen W).restrictOpenHom ((A.restrictOpenHom W).targetHom.hom ⁻¹ᵁ V) := by
  refine (cancel_mono (A.restrictOpenHom W)).1 ?_
  rw [Category.assoc, restrictOpenLE_restrictOpenHom, restrictOpenMap_restrictOpenHom]

/-- **The restriction of an object to the preimage of an open containing the image of a morphism
into it is that object.** -/
theorem isIso_restrictOpenHom_preimage {X A : Thickening S} (r : X ⟶ A)
    {V : A.thickening.target.scheme.Opens}
    (hr : ∀ x : X.thickening.target.scheme, r.targetHom.hom.base x ∈ V) :
    IsIso (X.restrictOpenHom (r.targetHom.hom ⁻¹ᵁ V)) :=
  X.isIso_restrictOpenHom_of_eq_top (eq_top_iff.2 fun x _ ↦ hr x)

/-- **A morphism of `CRIS(X/S)` whose map of ambient schemes has image inside an open of the
ambient scheme of its target factors through the restriction to that open.** -/
noncomputable def liftRestrictOpen {X A : Thickening S} (r : X ⟶ A)
    (V : A.thickening.target.scheme.Opens)
    (hr : ∀ x : X.thickening.target.scheme, r.targetHom.hom.base x ∈ V) :
    X ⟶ A.restrictOpen V :=
  haveI := isIso_restrictOpenHom_preimage r hr
  inv (X.restrictOpenHom (r.targetHom.hom ⁻¹ᵁ V)) ≫ restrictOpenMap r V

/-- **The factorization `liftRestrictOpen r V hr` composed with the structure morphism of the
restriction to `V` is `r`.** -/
@[reassoc]
theorem liftRestrictOpen_comp {X A : Thickening S} (r : X ⟶ A)
    (V : A.thickening.target.scheme.Opens)
    (hr : ∀ x : X.thickening.target.scheme, r.targetHom.hom.base x ∈ V) :
    liftRestrictOpen r V hr ≫ A.restrictOpenHom V = r := by
  have := isIso_restrictOpenHom_preimage r hr
  rw [liftRestrictOpen, Category.assoc, restrictOpenMap_restrictOpenHom, IsIso.inv_hom_id_assoc]

/-- **Cancelling the structure morphism of a restriction.**  Two factorizations of one morphism
through the restrictions to nested opens are compatible with the morphism between those
restrictions. -/
theorem restrictOpenLE_comp_eq {X A : Thickening S} {V W : A.thickening.target.scheme.Opens}
    (h : V ≤ W) (k : X ⟶ A.restrictOpen V) (r : X ⟶ A)
    (hk : k ≫ A.restrictOpenHom V = r) (f : X ⟶ A.restrictOpen W)
    (hf : f ≫ A.restrictOpenHom W = r) : k ≫ A.restrictOpenLE h = f :=
  (cancel_mono (A.restrictOpenHom W)).1 <| by
    rw [Category.assoc, restrictOpenLE_restrictOpenHom, hk, hf]

/-- **The restrictions to the opens of the ambient scheme carry open covers to Zariski covering
families.**  A covering sieve of an open `W` gives, for every point of `W`, a member of the sieve
containing it; the restrictions of the restriction to `W` to the preimages of the members of the
sieve then form a Zariski covering family each of whose members lies in the pushforward. -/
theorem coverPreserving_restrictOpenFunctor (A : Thickening S) :
    CoverPreserving (Opens.grothendieckTopology ↥A.thickening.target.scheme) (topology S)
      A.restrictOpenFunctor := by
  constructor
  intro W Sv hSv
  set ι : Type (u + 1) :=
    ULift.{u + 1} {f : Σ V : A.thickening.target.scheme.Opens, (V ⟶ W) // Sv.arrows f.2}
  set V : ι → (A.restrictOpen W).thickening.target.scheme.Opens :=
    fun i ↦ (A.restrictOpenHom W).targetHom.hom ⁻¹ᵁ i.down.1.1
  have hcov : ∀ y : (A.restrictOpen W).thickening.target.scheme, ∃ i, y ∈ V i := by
    intro y
    obtain ⟨V', g, hg, hmem⟩ := hSv _ (restrictOpenHom_targetHom_base_mem A W y)
    exact ⟨ULift.up ⟨⟨V', g⟩, hg⟩, hmem⟩
  refine (topology S).superset_covering ?_ (zariskiCovering_mem_topology S
    ((A.restrictOpen W).restrictOpenCover V)
    (isZariskiCovering_restrictOpenCover _ V hcov))
  rintro Z m ⟨W', q, f, ⟨i⟩, rfl⟩
  exact ⟨i.down.1.1, i.down.1.2, q ≫ restrictOpenMap (A.restrictOpenHom W) i.down.1.1,
    i.down.2, ((Category.assoc q _ _).trans
      (q ≫= restrictOpenMap_restrictOpenLE A (leOfHom i.down.1.2))).symm⟩

/-- **Two morphisms into the restrictions to two opens which agree after composing into the object
both factor through the restriction to the intersection of the two opens.** -/
theorem exists_lift_restrictOpen_inf {Y A : Thickening S}
    {V₁ V₂ : A.thickening.target.scheme.Opens}
    (f₁ : Y ⟶ A.restrictOpen V₁) (f₂ : Y ⟶ A.restrictOpen V₂)
    (hr : f₁ ≫ A.restrictOpenHom V₁ = f₂ ≫ A.restrictOpenHom V₂) :
    ∃ L : Y ⟶ A.restrictOpen (V₁ ⊓ V₂),
      L ≫ A.restrictOpenLE inf_le_left = f₁ ∧ L ≫ A.restrictOpenLE inf_le_right = f₂ := by
  have hinf : ∀ y : Y.thickening.target.scheme,
      (f₁ ≫ A.restrictOpenHom V₁).targetHom.hom.base y ∈ V₁ ⊓ V₂ := fun y ↦
    ⟨targetHom_base_mem_of_comp_restrictOpenHom V₁ f₁ _ rfl y,
      targetHom_base_mem_of_comp_restrictOpenHom V₂ f₂ _ hr.symm y⟩
  have hlift := liftRestrictOpen_comp (f₁ ≫ A.restrictOpenHom V₁) (V₁ ⊓ V₂) hinf
  exact ⟨_, restrictOpenLE_comp_eq _ _ _ hlift f₁ rfl,
    restrictOpenLE_comp_eq _ _ _ (hlift.trans hr) f₂ rfl⟩

/-- **The restrictions to the opens of the ambient scheme preserve compatible families of
sections.**  Two morphisms out of one object into the restrictions to two opens which agree over
a larger open both factor through the restriction to the intersection of the two opens, and the
comparison is then compatibility of the family over the two inclusions of that intersection. -/
theorem compatiblePreserving_restrictOpenFunctor (A : Thickening S) :
    CompatiblePreserving.{u + 1} (topology S) A.restrictOpenFunctor := by
  constructor
  intro ℱ Z T x hx V₁ V₂ Y f₁ f₂ g₁ g₂ hg₁ hg₂ e
  have key : ∀ (V : A.thickening.target.scheme.Opens) (f : Y ⟶ A.restrictOpen V) (g : V ⟶ Z),
      f ≫ A.restrictOpenHom V = (f ≫ A.restrictOpenFunctor.map g) ≫ A.restrictOpenHom Z :=
    fun _ f g ↦ ((Category.assoc f _ _).trans
      (f ≫= restrictOpenLE_restrictOpenHom A (leOfHom g))).symm
  have hr : f₁ ≫ A.restrictOpenHom V₁ = f₂ ≫ A.restrictOpenHom V₂ :=
    (key V₁ f₁ g₁).trans ((e =≫ A.restrictOpenHom Z).trans (key V₂ f₂ g₂).symm)
  obtain ⟨L, rfl, rfl⟩ := exists_lift_restrictOpen_inf f₁ f₂ hr
  exact (ℱ.obj.map_comp_apply (A.restrictOpenLE inf_le_left).op L.op _).trans
    ((congrArg (ℱ.obj.map L.op)
      (hx (homOfLE inf_le_left) (homOfLE inf_le_right) hg₁ hg₂ rfl)).trans
      (ℱ.obj.map_comp_apply (A.restrictOpenLE inf_le_right).op L.op _).symm)

/-- **The restrictions to the opens of the ambient scheme form a continuous functor.** -/
instance restrictOpenFunctor_isContinuous (A : Thickening S) :
    A.restrictOpenFunctor.IsContinuous
      (Opens.grothendieckTopology ↥A.thickening.target.scheme) (topology S) :=
  Functor.isContinuous_of_coverPreserving (compatiblePreserving_restrictOpenFunctor A)
    (coverPreserving_restrictOpenFunctor A)

/-- **Stacks Project, Tag 07IQ.**  The restriction of a sheaf on the big crystalline site to the
ambient scheme of an object is a sheaf on that scheme. -/
theorem isSheaf_restriction {𝒜 : Type*} [Category 𝒜] (P : (Thickening S)ᵒᵖ ⥤ 𝒜)
    (hP : Presheaf.IsSheaf (topology S) P) (A : Thickening S) :
    Presheaf.IsSheaf (Opens.grothendieckTopology ↥A.thickening.target.scheme)
      (restriction P A) :=
  A.restrictOpenFunctor.op_comp_isSheaf_of_isSheaf _ _ P hP

/-- **Cover lifting for the restrictions to the opens of the ambient scheme, for a sieve refined by
a family of restrictions.**  If every point of an open `W` lies in some open `V ≤ W` for which the
transition morphism from the restriction to `V` belongs to a sieve on the restriction to `W`, then
the pullback of that sieve along the restriction functor is a Zariski covering sieve of `W`. -/
theorem restrictOpenFunctor_functorPullback_mem_grothendieckTopology (A : Thickening S)
    {W : A.thickening.target.scheme.Opens} {T : Sieve (A.restrictOpen W)}
    (hT : ∀ x ∈ W, ∃ V : A.thickening.target.scheme.Opens, ∃ h : V ≤ W,
      x ∈ V ∧ T.arrows (A.restrictOpenLE h)) :
    Sieve.functorPullback A.restrictOpenFunctor T ∈
      Opens.grothendieckTopology ↥A.thickening.target.scheme W := by
  intro x hx
  obtain ⟨V, h, hxV, hVT⟩ := hT x hx
  exact ⟨V, homOfLE h, hVT, hxV⟩

/-- **Cover lifting for the restrictions to the opens of the ambient scheme.**  Let `{Xᵢ ⟶ X}` be
a Zariski covering family of `CRIS(X/S)` and let `p` be a morphism from the restriction of `A` to
an open `W` of its ambient scheme.  Every point of `W` has an open neighbourhood `V ≤ W` inside
the image of the open over which `p` factors through some member of the family — namely the image
of `Crystalline.GlobalCrystallineSituation.Thickening.pullbackOpen` — and over such a `V` the
restriction of `A` factors through that member, because the open over which the factorization
exists has become everything.  So the pullback along `p` of the sieve generated by the family
pulls back along the restriction functor to a Zariski covering sieve of `W`. -/
theorem restrictOpenFunctor_functorPullback_pullback_mem_grothendieckTopology (A : Thickening S)
    {W : A.thickening.target.scheme.Opens} {X : Thickening S} (p : A.restrictOpen W ⟶ X)
    (E : PreZeroHypercover.{u + 1} X) (hE : IsZariskiCovering E) :
    Sieve.functorPullback A.restrictOpenFunctor ((Sieve.generate E.presieve₀).pullback p) ∈
      Opens.grothendieckTopology ↥A.thickening.target.scheme W := by
  have hE' : (∀ x, ∃ i, x ∈ Set.range ((E.f i).targetHom.hom).base) ∧
      ∀ i, IsOpenImmersion (E.f i).targetHom.hom := by
    simpa only [targetPresieve, Scheme.ofArrows_mem_precoverage_iff] using hE.2
  refine restrictOpenFunctor_functorPullback_mem_grothendieckTopology A fun x hx ↦ ?_
  obtain ⟨y, hy⟩ : x ∈ (A.restrictOpenHom W).targetHom.hom.opensRange := by
    rwa [restrictOpenHom_targetHom_opensRange]
  obtain ⟨i, z, hz⟩ := hE'.1 (p.targetHom.hom.base y)
  have hoi := hE'.2 i
  set O : (A.restrictOpen W).thickening.target.scheme.Opens := pullbackOpen (E.f i) p
  set V : A.thickening.target.scheme.Opens := (A.restrictOpenHom W).targetHom.hom ''ᵁ O
  have hVW : V ≤ W :=
    (Scheme.Hom.image_le_opensRange _ O).trans (restrictOpenHom_targetHom_opensRange A W).le
  have hpre : (A.restrictOpenHom W).targetHom.hom ⁻¹ᵁ V = O :=
    Scheme.Hom.preimage_image_eq _ O
  have hLE : (A.restrictOpenLE hVW).targetHom.hom ≫ (A.restrictOpenHom W).targetHom.hom
      = (A.restrictOpenHom V).targetHom.hom :=
    congrArg (fun k : A.restrictOpen V ⟶ A ↦ k.targetHom.hom)
      (restrictOpenLE_restrictOpenHom A hVW)
  have hOtop : (A.restrictOpenLE hVW).targetHom.hom ⁻¹ᵁ O = ⊤ := by
    rw [← hpre, ← Scheme.Hom.comp_preimage, hLE]
    exact eq_top_iff.2 fun t _ ↦ restrictOpenHom_targetHom_base_mem A V t
  have htop : pullbackOpen (E.f i) (A.restrictOpenLE hVW ≫ p) = ⊤ := by
    change ((A.restrictOpenLE hVW).targetHom.hom ≫ p.targetHom.hom) ⁻¹ᵁ
      (E.f i).targetHom.hom.opensRange = ⊤
    rw [Scheme.Hom.comp_preimage]
    exact hOtop
  have := (A.restrictOpen V).isIso_restrictOpenHom_of_eq_top htop
  obtain ⟨l, hl⟩ : ∃ l : A.restrictOpen V ⟶ E.X i, l ≫ E.f i = A.restrictOpenLE hVW ≫ p := by
    refine ⟨inv ((A.restrictOpen V).restrictOpenHom
      (pullbackOpen (E.f i) (A.restrictOpenLE hVW ≫ p))) ≫
        pullbackLiftHom (E.f i) (A.restrictOpenLE hVW ≫ p) (hE.1 i), ?_⟩
    rw [Category.assoc, pullbackLiftHom_comp, IsIso.inv_hom_id_assoc]
  exact ⟨V, hVW, ⟨y, ⟨z, hz⟩, hy⟩, E.X i, l, E.f i, ⟨i⟩, hl⟩

/-- **The restrictions to the opens of the ambient scheme form a cocontinuous functor.** -/
instance restrictOpenFunctor_isCocontinuous (A : Thickening S) :
    A.restrictOpenFunctor.IsCocontinuous
      (Opens.grothendieckTopology ↥A.thickening.target.scheme) (topology S) :=
  Functor.isCocontinuous_toGrothendieck _ _ _ fun _ _ p R hR ↦ by
    obtain ⟨E, rfl, hE⟩ := hR
    exact restrictOpenFunctor_functorPullback_pullback_mem_grothendieckTopology A p E hE

end Thickening

end Crystalline.GlobalCrystallineSituation

end
