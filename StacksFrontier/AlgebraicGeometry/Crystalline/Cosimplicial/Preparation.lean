module

public import Mathlib.Algebra.Category.ModuleCat.Presheaf.Free
public import Mathlib.AlgebraicTopology.SimplicialSet.StdSimplexOne
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Crystalline.Cosimplicial

/-!
# The cosimplicial module on the vertices of the simplex

For a cosimplicial ring `A`, in degree `n` we form the free `A_n`-module on the vertices
`0, …, n` of `[n]`.  A morphism of finite ordinals acts by sending the basis vector at a vertex
to the basis vector at its image.  The identity of this cosimplicial module is homotopic to
zero, and the contracting homotopy is written down explicitly on the free generators.

This is the preparatory computation behind the vanishing statements of the crystalline site:
the complex computed from this cosimplicial module is contractible, so every construction which
is functorial in cosimplicial modules and preserves homotopy kills it.

## Main definitions

* `Crystalline.simplexVertexModule` — the cosimplicial module freely generated in degree `n` by
  the vertices of `[n]`.

## Main results

* `Crystalline.simplexVertexModuleContractingHomotopy` — the explicitly specified contracting
  homotopy from the identity to zero.
* `Crystalline.simplexVertexModuleContractingHomotopy_apply_freeMk_objMk₁` — its value on each
  free generator and each simplex `αʲ` of `Δ[1]`.

## Implementation notes

The module is Mathlib's free presheaf of modules on the functor which sends `[n]` to its
underlying finite ordered set; its functorial action therefore sends each distinguished free
generator `eᵢ` to `e_{f(i)}`.  The homotopy is stated in the componentwise form of
`Crystalline.Homotopy`.  Under Mathlib's convention, `objMk₁ j` is the map which takes the value
zero exactly before `j`; consequently the displayed formula has the identity as its zero
endpoint and zero as its one endpoint.

## References

* [Stacks Project, Tag 07L7](https://stacks.math.columbia.edu/tag/07L7)
-/

@[expose] public section

namespace Crystalline

open CategoryTheory Opposite
open scoped Simplicial

universe u

/-- The cosimplicial set of vertices: in degree `n` its elements are the vertices of `[n]`, and a
map of finite ordinals acts on vertices by its underlying function. -/
public abbrev simplexVertexFunctor : ((SimplexCategoryᵒᵖ)ᵒᵖ) ⥤ Type u :=
  unopUnop SimplexCategory ⋙ SimplexCategory.toPartOrd.{u} ⋙ forget PartOrd

/-- **Stacks 07L7, the module.** For a cosimplicial ring `A`, the cosimplicial `A`-module which
in degree `n` is free on the vertices `0, ..., n`; a map `f : [n] ⟶ [m]` sends the free generator
at `i` to the free generator at `f(i)`. -/
@[stacks 07L7 "the cosimplicial module"]
public noncomputable def simplexVertexModule (A : CosimplicialObject CommRingCat.{u}) :
    CosimplicialModule A :=
  PresheafOfModules.freeObj (R := cosimplicialRingPresheaf A) simplexVertexFunctor

private lemma simplexVertexModule_map_freeMk (A : CosimplicialObject CommRingCat.{u})
    {n m : SimplexCategory} (f : n ⟶ m)
    (i : simplexVertexFunctor.obj (op (op n))) :
    (simplexVertexModule A).map f.op.op (ModuleCat.freeMk i) =
      ModuleCat.freeMk (simplexVertexFunctor.map f.op.op i) := by
  simp only [simplexVertexModule, PresheafOfModules.freeObj]
  exact ModuleCat.freeDesc_apply _ i

/-- The degreewise component of the contracting homotopy of `simplexVertexModule`: at a simplex
`α` of `Δ[1]` it sends the free generator `eᵢ` to itself when `α` vanishes at `i`, and to zero
otherwise. -/
public noncomputable def contractingComponent (A : CosimplicialObject CommRingCat.{u})
    (n : SimplexCategory) (α : (Δ[1] : SSet.{0}).obj (op n)) :
    (simplexVertexModule A).obj (op (op n)) ⟶ (simplexVertexModule A).obj (op (op n)) :=
  ModuleCat.freeDesc (↾fun (i : simplexVertexFunctor.obj (op (op n))) ↦
    if (SSet.stdSimplex.objEquiv.{0} α).toOrderHom i.down = 0 then ModuleCat.freeMk i else 0)

/-- The component of the contracting homotopy on a free generator. -/
public lemma contractingComponent_freeMk (A : CosimplicialObject CommRingCat.{u})
    (n : SimplexCategory) (α : (Δ[1] : SSet.{0}).obj (op n))
    (i : simplexVertexFunctor.obj (op (op n))) :
    contractingComponent A n α (ModuleCat.freeMk i) =
      if (SSet.stdSimplex.objEquiv.{0} α).toOrderHom i.down = 0 then
        ModuleCat.freeMk i else 0 :=
  ModuleCat.freeDesc_apply _ i

/-- **Stacks 07L7, the contraction.** The specified homotopy from the identity endomorphism of the
cosimplicial module freely generated by the vertices to its zero endomorphism. -/
@[stacks 07L7 "the contracting homotopy"]
public noncomputable def simplexVertexModuleContractingHomotopy
    (A : CosimplicialObject CommRingCat.{u}) :
    Homotopy (𝟙 (simplexVertexModule A))
      (0 : simplexVertexModule A ⟶ simplexVertexModule A) where
  app n α := contractingComponent A n α
  naturality {n m} f α := by
    apply ModuleCat.free_hom_ext (R := (cosimplicialRingPresheaf A).obj (op (op n)))
      (X := simplexVertexFunctor.obj (op (op n)))
    intro i
    have hcomp :
        (SSet.stdSimplex.objEquiv.{0} ((Δ[1] : SSet.{0}).map f.op α)).toOrderHom i.down =
          (SSet.stdSimplex.objEquiv.{0} α).toOrderHom
            (simplexVertexFunctor.map f.op.op i).down := rfl
    have hleft :
        ((ModuleCat.restrictScalars ((cosimplicialRingPresheaf A).map f.op.op).hom).map
            (contractingComponent A m α))
            ((simplexVertexModule A).map f.op.op (ModuleCat.freeMk i)) =
          if (SSet.stdSimplex.objEquiv.{0} α).toOrderHom
              (simplexVertexFunctor.map f.op.op i).down = 0 then
            ModuleCat.freeMk (simplexVertexFunctor.map f.op.op i) else 0 := by
      rw [simplexVertexModule_map_freeMk]
      exact contractingComponent_freeMk A m α (simplexVertexFunctor.map f.op.op i)
    have hright :
        (simplexVertexModule A).map f.op.op
            (contractingComponent A n ((Δ[1] : SSet.{0}).map f.op α) (ModuleCat.freeMk i)) =
          (simplexVertexModule A).map f.op.op
            (if (SSet.stdSimplex.objEquiv.{0} ((Δ[1] : SSet.{0}).map f.op α)).toOrderHom
                i.down = 0 then ModuleCat.freeMk i else 0) :=
      congrArg _ (contractingComponent_freeMk A n ((Δ[1] : SSet.{0}).map f.op α) i)
    have hmid :
        (if (SSet.stdSimplex.objEquiv.{0} α).toOrderHom
              (simplexVertexFunctor.map f.op.op i).down = 0 then
            ModuleCat.freeMk (simplexVertexFunctor.map f.op.op i) else 0) =
          (simplexVertexModule A).map f.op.op
            (if (SSet.stdSimplex.objEquiv.{0} ((Δ[1] : SSet.{0}).map f.op α)).toOrderHom
                i.down = 0 then ModuleCat.freeMk i else 0) := by
      by_cases h : (SSet.stdSimplex.objEquiv.{0} ((Δ[1] : SSet.{0}).map f.op α)).toOrderHom
          i.down = 0
      · exact (ite_eq_left h).trans
          ((simplexVertexModule_map_freeMk A f i).symm.trans
            (congrArg (fun y ↦ (simplexVertexModule A).map f.op.op y)
              (ite_eq_left h).symm))
      · exact (ite_eq_right h).trans
          ((map_zero ((simplexVertexModule A).map f.op.op).hom).symm.trans
            (congrArg (fun y ↦ (simplexVertexModule A).map f.op.op y)
              (ite_eq_right h).symm))
    exact hleft.trans (hmid.trans hright.symm)
  app_zero n := by
    apply ModuleCat.free_hom_ext (R := (cosimplicialRingPresheaf A).obj (op (op n)))
      (X := simplexVertexFunctor.obj (op (op n)))
    intro i
    have hi : (SSet.stdSimplex.objEquiv.{0}
        (SSet.stdSimplex.const.{0} 1 0 (op n))).toOrderHom i.down = 0 := rfl
    exact (contractingComponent_freeMk A n (SSet.stdSimplex.const.{0} 1 0 (op n)) i).trans
      (ite_eq_left hi)
  app_one n := by
    apply ModuleCat.free_hom_ext (R := (cosimplicialRingPresheaf A).obj (op (op n)))
      (X := simplexVertexFunctor.obj (op (op n)))
    intro i
    have hi : (SSet.stdSimplex.objEquiv.{0} (SSet.stdSimplex.const.{0} 1 1 (op n))).toOrderHom
        i.down ≠ 0 := by
      change (OrderHom.const _ (1 : Fin 2)) i.down ≠ 0
      simp
    exact (contractingComponent_freeMk A n (SSet.stdSimplex.const.{0} 1 1 (op n)) i).trans
      (ite_eq_right hi)

/-- **Stacks 07L7, the formula for the contraction.** On the generator `e_i`, at the simplex
`αʲ : [n] → [1]` which is zero precisely before `j`, the contraction is `e_i` if `i < j`
and zero otherwise. -/
@[stacks 07L7 "the formula on generators"]
public theorem simplexVertexModuleContractingHomotopy_apply_freeMk_objMk₁
    (A : CosimplicialObject CommRingCat.{u}) (n : SimplexCategory)
    (i : Fin (n.len + 1)) (j : Fin (n.len + 2)) :
    (simplexVertexModuleContractingHomotopy A).app n (SSet.stdSimplex.objMk₁ j)
        (ModuleCat.freeMk (ULift.up i)) =
      if i.castSucc < j then ModuleCat.freeMk (ULift.up i) else 0 := by
  by_cases h : i.castSucc < j
  · exact (contractingComponent_freeMk A n (SSet.stdSimplex.objMk₁.{0} j) (ULift.up i)).trans
      ((ite_eq_left ((SSet.stdSimplex.objMk₁_apply_eq_zero_iff.{0} j i).2 h)).trans
        (ite_eq_left h).symm)
  · exact (contractingComponent_freeMk A n (SSet.stdSimplex.objMk₁.{0} j) (ULift.up i)).trans
      ((ite_eq_right ((SSet.stdSimplex.objMk₁_apply_eq_zero_iff.{0} j i).not.mpr h)).trans
        (ite_eq_right h).symm)

end Crystalline

end
