module

public import Mathlib.LinearAlgebra.SymmetricAlgebra.Basic
public import StacksFrontier.AlgebraicGeometry.Topologies.BigSites.StandardCoveringSieves
public import StacksFrontier.LinearAlgebra.SymmetricPower.Presentation

/-!
# Universal solution algebras belong to a big site

The proof of [Stacks, Tag 06V0] evaluates a morphism of module-valued functors at one specific
algebra: the symmetric algebra on the module of universal solutions of a map of finite free
modules. Carrying that proof over to the module-valued functors on the algebras *of a big site*
therefore needs that algebra to be an algebra of the site, i.e. its spectrum to have size below
the site's cutoff.

It does. The module of universal solutions is the cokernel of a map of finite free modules,
hence a finitely generated module; so the symmetric algebra on it is generated as an algebra by
the image of finitely many generators, hence of finite type over the base ring; so its spectrum
is of finite type over the base affine, and [Stacks, Tag 000R] (9)(b),
`AlgebraicGeometry.Scheme.size_Spec_lt_of_finiteType`, applies. No property of the cutoff beyond
the ones a big site already carries — uncountability and `Cardinal.IsStrongPrelimit`, which are
what that lemma consumes — is needed, and in particular a big site needs no further closure
field.

## Main results

* `SymmetricAlgebra.finiteType` — the symmetric algebra on a finitely generated module is of
  finite type over the base ring.
* `AlgebraicGeometry.size_lt_cutoff_spec_symmetricAlgebra` — the spectrum of the symmetric
  algebra on a finitely generated module over a ring whose spectrum belongs to a big site again
  belongs to that big site.

## Implementation notes

The statement is about an arbitrary finitely generated module rather than about the universal
solution module itself, because `AdequateFunctor.universalSolutionModule` is private to
`StacksFrontier.AlgebraicGeometry.Adequate.AdequateFunctors.FiniteFreeLift`. A quotient of a finite
free module is finitely generated, and a universe lift of a finitely generated module is
finitely generated, so the general statement covers both the universal solution algebra and its
universe lift.

## References

* [Stacks Project, Tag 06V0](https://stacks.math.columbia.edu/tag/06V0)
* [Stacks Project, Tag 06Z3](https://stacks.math.columbia.edu/tag/06Z3)
-/

@[expose] public section

open CategoryTheory

universe u

namespace SymmetricAlgebra

variable (R : Type u) [CommRing R] (M : Type u) [AddCommGroup M] [Module R M]

/-- The symmetric algebra on a finitely generated module is of finite type over the base ring:
it is generated by the images of finitely many generators of the module. -/
public theorem finiteType [Module.Finite R M] :
    Algebra.FiniteType R (SymmetricAlgebra R M) := by
  classical
  obtain ⟨s, hs⟩ := Module.finite_def.mp (inferInstance : Module.Finite R M)
  refine ⟨⟨s.image (SymmetricAlgebra.ι R M), ?_⟩⟩
  refine top_unique ?_
  rw [← SymPow.adjoin_range_ι (R := R) (M := M)]
  refine Algebra.adjoin_le ?_
  rintro _ ⟨m, rfl⟩
  rw [SetLike.mem_coe]
  have hm : m ∈ Submodule.span R (s : Set M) := hs ▸ Submodule.mem_top
  induction hm using Submodule.span_induction with
  | mem x hx =>
      exact Algebra.subset_adjoin (by simpa using Finset.mem_image_of_mem _ hx)
  | zero => simpa only [map_zero] using zero_mem _
  | add x y _ _ hx hy => simpa only [map_add] using add_mem hx hy
  | smul a x _ hx => simpa only [map_smul] using Subalgebra.smul_mem _ hx a

end SymmetricAlgebra

namespace AlgebraicGeometry

/-- The spectrum of the symmetric algebra on a finitely generated module over a ring whose
spectrum belongs to a big site again belongs to that big site. -/
public theorem size_lt_cutoff_spec_symmetricAlgebra (τ : CoveringTopology) (B : BigSite.{u} τ)
    (A : Type u) [CommRing A] (M : Type u) [AddCommGroup M] [Module A M] [Module.Finite A M]
    (hA : (Spec (CommRingCat.of A)).size < cutoff τ B) :
    (Spec (CommRingCat.of (SymmetricAlgebra A M))).size < cutoff τ B :=
  have : Algebra.FiniteType A (SymmetricAlgebra A M) := SymmetricAlgebra.finiteType A M
  Scheme.size_Spec_lt_of_finiteType (aleph0_lt_cutoff' τ B) (cutoff_isStrongPrelimit τ B)
    A (SymmetricAlgebra A M) hA

end AlgebraicGeometry

end
