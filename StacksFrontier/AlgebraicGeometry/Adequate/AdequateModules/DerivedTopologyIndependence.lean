* [Stacks Project, Tag 021N](https://stacks.math.columbia.edu/tag/021N)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits Opposite

universe d d' u m

namespace AlgebraicGeometry

/-- **A covering sieve of a localized big site contains a `τ`-covering family.** A covering
sieve of the localization at `S` of a big `τ`-site contains one of the site's chosen covering
families of the underlying scheme, read over `S`, and that family is a `τ`-covering of schemes. -/
theorem exists_ofArrows_le_of_mem_overTopology (τ : CoveringTopology) (C : BigSite.{u} τ)
    (S : Scheme.{u}) (hS : S.size < cutoff τ C) {U : Over (base C S hS)} {R : Sieve U}
    (hR : R ∈ overTopology τ C S hS U) :
    ∃ (I : Type (u + 1)) (X : I → Over (base C S hS)) (f : ∀ i, X i ⟶ U),
      Presieve.ofArrows (fun i => (overToSlice τ C S hS ⋙ Over.forget S).obj (X i))
          (fun i => (overToSlice τ C S hS ⋙ Over.forget S).map (f i)) ∈
        Scheme.precoverage (coveringMorphismProperty τ) U.left.obj ∧
      Sieve.generate (Presieve.ofArrows X f) ≤ R := by
  rw [mem_overTopology_iff] at hR
  obtain ⟨E, hE, hER⟩ := exists_isCovering_refining_sieve τ C hR
  refine ⟨E.I₀, fun i => Over.mk (E.f i ≫ U.hom), fun i => Over.homMk (E.f i),
    mem_precoverage_of_isCovering τ C E hE, ?_⟩
  rw [Sieve.generate_le_iff, Presieve.ofArrows_le_iff]
  intro i
  exact (Sieve.overEquiv_iff R (E.f i)).1 (hER _ _ (Presieve.ofArrows.mk i))

/-- **The topology of a localized big site is coarser than the one generated by its fpqc
covering families.** A covering sieve contains a `τ`-covering family
(`AlgebraicGeometry.exists_ofArrows_le_of_mem_overTopology`), and a `τ`-covering is an fpqc
covering, its members being flat and locally of finite presentation. -/
theorem overTopology_le_fpqc (τ : CoveringTopology) (C : BigSite.{u} τ) (S : Scheme.{u})
    (hS : S.size < cutoff τ C) :
    overTopology τ C S hS ≤
      (Scheme.fpqcPrecoverage.{u}.comap (overToSlice τ C S hS ⋙ Over.forget S)).toGrothendieck := by
  intro U R hR
  obtain ⟨I, X, f, hmem, hle⟩ := exists_ofArrows_le_of_mem_overTopology τ C S hS hR
  refine GrothendieckTopology.superset_covering _ hle
    (Precoverage.generate_mem_toGrothendieck ?_)
  rw [Precoverage.mem_comap_iff, Presieve.map_ofArrows]
  exact le_trans (Scheme.precoverage_mono
      (coveringMorphismProperty_le_flat_inf_locallyOfFinitePresentation τ))
    Scheme.fppfPrecoverage_le_fpqcPrecoverage _ hmem

end AlgebraicGeometry

namespace Stacks.Adequate

variable {τ τ' : CoveringTopology} {S : Scheme.{u}}

/-- **A covering sieve of a chosen big site contains a `τ`-covering family**: a family of
morphisms of the site whose underlying morphisms of schemes form a `τ`-covering. This is
`AlgebraicGeometry.exists_ofArrows_le_of_mem_overTopology` read through the five cases of the
field `Stacks.Adequate.BigSite.chosen`. -/
theorem BigSite.exists_ofArrows_le_of_mem_topology (B : BigSite τ S) :
    ∀ {U : B.category} {R : Sieve U}, R ∈ B.topology U →
      ∃ (I : Type (u + 1)) (X : I → B.category) (f : ∀ i, X i ⟶ U),
        Presieve.ofArrows (fun i => (B.toOver ⋙ Over.forget S).obj (X i))
            (fun i => (B.toOver ⋙ Over.forget S).map (f i)) ∈
          Scheme.precoverage (coveringMorphismProperty τ) U.left.obj ∧
        Sieve.generate (Presieve.ofArrows X f) ≤ R := by
  obtain ⟨C, hC, rfl⟩ := B.exists_eq_ofAmbient
  exact fun hR => exists_ofArrows_le_of_mem_overTopology τ C S hC hR

/-- **A `τ`-covering family of a chosen big site generates a covering sieve**, the family being
given by the membership of its underlying family of schemes in the `τ`-precoverage. -/
theorem BigSite.generate_mem_topology_of_ofArrows_mem (B : BigSite τ S) {U : B.category}
    {I : Type*} (X : I → B.category) (f : ∀ i, X i ⟶ U)
    (h : Presieve.ofArrows (fun i => (B.toOver ⋙ Over.forget S).obj (X i))
        (fun i => (B.toOver ⋙ Over.forget S).map (f i)) ∈
      Scheme.precoverage (coveringMorphismProperty τ) U.left.obj) :
    Sieve.generate (Presieve.ofArrows X f) ∈ B.topology U := by
  obtain ⟨hsurj, hprop⟩ := (Scheme.ofArrows_mem_precoverage_iff _).1 h
  exact sieve_generate_mem_topology_of_coveringMorphismProperty B X f hprop hsurj

/-- **A topology on the category of a chosen big `τ`-site whose covering sieves contain
`τ'`-covering families is coarser than the topology of the site, for `τ` finer than `τ'`**:
along the chain `Zar ≺ étale ≺ smooth ≺ syntomic ≺ fppf` a `τ'`-covering of schemes is a
`τ`-covering ([Stacks, Tag 021N], `AlgebraicGeometry.coveringPrecoverage_le_of_isFiner`). -/
theorem BigSite.le_topology_of_isFiner (B : BigSite τ S) (h : τ.IsFiner τ')
    (J' : GrothendieckTopology B.category)
    (hJ' : ∀ {U : B.category} {R : Sieve U}, R ∈ J' U →
      ∃ (I : Type (u + 1)) (X : I → B.category) (f : ∀ i, X i ⟶ U),
        Presieve.ofArrows (fun i => (B.toOver ⋙ Over.forget S).obj (X i))
            (fun i => (B.toOver ⋙ Over.forget S).map (f i)) ∈
          Scheme.precoverage (coveringMorphismProperty τ') U.left.obj ∧
        Sieve.generate (Presieve.ofArrows X f) ≤ R) :
    J' ≤ B.topology := by
  intro U R hR
  obtain ⟨I, X, f, hmem, hle⟩ := hJ' hR
  exact B.topology.superset_covering hle
    (B.generate_mem_topology_of_ofArrows_mem X f (coveringPrecoverage_le_of_isFiner h _ hmem))

/-- **The topology of a chosen big site is coarser than the one generated by its fpqc covering
families.** This is `AlgebraicGeometry.overTopology_le_fpqc` read through the five cases of the
field `Stacks.Adequate.BigSite.chosen`. -/
theorem BigSite.topology_le_fpqcPrecoverageOn (B : BigSite τ S) :
    B.topology ≤ (fpqcPrecoverageOn B).toGrothendieck := by
  obtain ⟨C, hC, rfl⟩ := B.exists_eq_ofAmbient
  exact overTopology_le_fpqc τ C S hC

namespace BigSite.Coarsening

variable {B : BigSite τ S} (c : B.Coarsening τ')

/-- Abelian presheaves on the category of a chosen big site admit sheafification for the
coarser topology of a coarsening, that topology being the one of a chosen big site. -/
instance hasSheafify_addCommGrpCat : HasSheafify c.topology AddCommGrpCat.{max u m} :=
  BigSite.hasSheafify_addCommGrpCat.{u, m} c.site

/-- Sheafification of abelian presheaves for the coarser topology of a coarsening inverts
exactly the locally bijective morphisms. -/
instance wEqualsLocallyBijective_addCommGrpCat :
    c.topology.WEqualsLocallyBijective AddCommGrpCat.{max u m} :=
  BigSite.wEqualsLocallyBijective_addCommGrpCat.{u, m} c.site

/-- **Assumption (1) of [Stacks, Tag 07A8] for the adequate modules.** An adequate `𝒪`-module
for the coarser topology is a sheaf for the finer one: it satisfies the sheaf condition for the
fpqc covering families of the site ([Stacks, Tag 06VL],
`Stacks.Adequate.isSheaf_fpqc_of_isAdequate`), and the finer topology is coarser than the
topology those families generate (`Stacks.Adequate.BigSite.topology_le_fpqcPrecoverageOn`). -/
theorem adequateIsFineSheaf : AdequateIsFineSheaf.{u, m} c := fun G hG =>
  (isSheaf_fpqc_of_isAdequate.{u, m} c.site G hG).of_le B.topology_le_fpqcPrecoverageOn

/-- **Assumption (3) of [Stacks, Tag 07A8] for the affine objects.** Every object of the site
has a covering for the coarser topology by affine objects of the site: the family of all
morphisms into it out of affine objects. Its sieve contains a covering sieve of the chosen big
`τ'`-site, all of whose morphisms factor through affine objects
(`Stacks.Adequate.exists_affineCovering_mem_topology`). -/
theorem affineCoarseCovering : AffineCoarseCovering.{u} c := by
  intro U
  obtain ⟨T, hT, hfac⟩ := exists_affineCovering_mem_topology c.site U
  let 𝒰 : PreZeroHypercover.{u + 1} U :=
    { I₀ := Σ W : B.category, {g : W ⟶ U // IsAffine W.left.obj}
      X := fun i => i.1
      f := fun i => i.2.1 }
  refine ⟨𝒰, c.topology.superset_covering ?_ hT, fun i => i.2.2⟩
  intro Y f hf
  obtain ⟨W, g, k, hW, rfl⟩ := hfac f hf
  exact ⟨W, g, k, Presieve.ofArrows.mk (⟨W, k, hW⟩ : 𝒰.I₀), rfl⟩

/-- The structure sheaf of a chosen big site as a sheaf of commutative rings. -/
abbrev commRingStructureSheaf : Sheaf B.topology CommRingCat.{u} :=
  ⟨(B.toOver ⋙ Over.forget S).op ⋙ Scheme.Γ,
    Presheaf.isSheaf_of_isSheaf_comp _ _ (forget₂ CommRingCat RingCat) B.isSheaf⟩

/-- **[Stacks, Tag 070V].** Let `S` be a scheme and let `τ` and `τ'` be two of the five
topologies `Zar`, `étale`, `smooth`, `syntomic`, `fppf`, with `τ` stronger than `τ'`, and denote
`𝒪_τ` and `𝒪_τ'` the structure sheaf `𝒪` viewed as a sheaf on the big `τ`-site, resp. the big
`τ'`-site, over `S`. Then `D_Adeq(𝒪_τ)` and `D_Adeq(𝒪_τ')` are canonically equivalent.

The equivalence is [Stacks, Tag 07A8] for the category of the site, the class of adequate
`𝒪_τ`-modules and the affine objects of the site
(`Stacks.Cohomology.CompareTopologies.derivedEquivalenceImageOfLEOfEssentiallySmall`). Its
assumption (1) is `Stacks.Adequate.BigSite.Coarsening.adequateIsFineSheaf`, (2) is
`Stacks.Adequate.adequate_isWeakSerreClass`, (3) is
`Stacks.Adequate.BigSite.Coarsening.affineCoarseCovering` and (4) is
`Stacks.Adequate.BigSite.isZero_rightDerived_sections_of_isAdequate`, [Stacks, Tag 06VM] (3).
Assumption (1) also identifies the image class of the adequate `𝒪_τ`-modules with the adequate
`𝒪_τ'`-modules (`Stacks.Adequate.BigSite.Coarsening.adequate_site_eq_imageOfLE`). -/
@[stacks 070V "the canonical equivalence of `D_Adeq(𝒪_τ)` and `D_Adeq(𝒪_τ')`, for a coarsening
of a chosen big site, at any models of the two derived categories"]
def derivedAdequateCoarseningEquivalence
    [HasDerivedCategory.{d} (SheafOfModules.{u} B.structureSheaf)]
    [HasDerivedCategory.{d'} (SheafOfModules.{u} c.site.structureSheaf)] :
    (BigSite.derivedAdequate.{u, u, d} B).FullSubcategory ≌
      (BigSite.derivedAdequate.{u, u, d'} c.site).FullSubcategory :=
  letI : EssentiallySmall.{u} B.category := B.essentiallySmall_category
  letI : HasDerivedCategory.{d} (SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf (commRingStructureSheaf (B := B)))) :=
    (inferInstance : HasDerivedCategory.{d} (SheafOfModules.{u} B.structureSheaf))
  letI : HasDerivedCategory.{d'} (SheafOfModules.{u}
      ((Stacks.SheafOfModules.Tensor.ringSheaf (commRingStructureSheaf (B := B))).ofLE c.le)) :=
    (inferInstance : HasDerivedCategory.{d'} (SheafOfModules.{u} c.site.structureSheaf))
  haveI : ObjectProperty.IsWeakSerreClass (C := SheafOfModules.{u}
      (Stacks.SheafOfModules.Tensor.ringSheaf (commRingStructureSheaf (B := B))))
      (adequate.{u, u} B) :=
    adequate_isWeakSerreClass B
  (Stacks.Cohomology.CompareTopologies.derivedEquivalenceImageOfLEOfEssentiallySmall c.le
      (commRingStructureSheaf (B := B)) (adequate.{u, u} B) B.affineObjects
      (affineCoarseCovering c)
      (fun U hU p hp F hF =>
        haveI : IsAffine U.left.obj := hU
        B.isZero_rightDerived_sections_of_isAdequate.{u, u} F hF U p hp)).trans
    (ObjectProperty.equivalenceOfEq
      (congrArg DerivedCategoryB.derivedCategoryB
        (c.adequate_site_eq_imageOfLE (adequateIsFineSheaf.{u, u} c))))

end BigSite.Coarsening

/-! ### Any two of the five topologies on one category of schemes -/

/-- **`D_Adeq(𝒪_τ) ≌ D_Adeq(𝒪_τ')` for `τ` finer than `τ'`**, for two chosen big sites over `S`
with the same cutoff, hence the same underlying category of schemes over `S`: the topology of
the `τ'`-site is coarser than that of the `τ`-site
(`Stacks.Adequate.BigSite.le_topology_of_isFiner`), so the `τ'`-site is a coarsening of the
`τ`-site and `Stacks.Adequate.BigSite.Coarsening.derivedAdequateCoarseningEquivalence`
applies. -/
def BigSite.derivedAdequateEquivalenceOfIsFiner (B : BigSite τ S) (B' : BigSite τ' S)
    (hcut : B'.cutoff = B.cutoff) (h : τ.IsFiner τ')
    [HasDerivedCategory.{d} (SheafOfModules.{u} B.structureSheaf)]
    [inst' : HasDerivedCategory.{d'} (SheafOfModules.{u} B'.structureSheaf)] :
    (BigSite.derivedAdequate.{u, u, d} B).FullSubcategory ≌
      (BigSite.derivedAdequate.{u, u, d'} B').FullSubcategory := by
  obtain ⟨cut', base_mem', J', isSheaf', chosen'⟩ := B'
  subst hcut
  let c : B.Coarsening τ' :=
    { topology := J'
      le := B.le_topology_of_isFiner h J'
        (BigSite.exists_ofArrows_le_of_mem_topology ⟨B.cutoff, base_mem', J', isSheaf', chosen'⟩)
      chosen := chosen' }
  exact @Coarsening.derivedAdequateCoarseningEquivalence _ _ _ _ c _ inst'

/-- **[Stacks, Tag 070V].** Let `S` be a scheme and let `τ, τ'` be two of the five topologies
`Zar`, `étale`, `smooth`, `syntomic`, `fppf`, and denote `𝒪_τ`, resp. `𝒪_τ'`, the structure sheaf
`𝒪` viewed as a sheaf on the big site `(Sch/S)_τ`, resp. `(Sch/S)_τ'`, the two big sites being
built on the same category of schemes over `S` (their cutoffs agree). Then `D_Adeq(𝒪_τ)` and
`D_Adeq(𝒪_τ')` are canonically equivalent.

The five topologies are linearly ordered, `Zar ≺ étale ≺ smooth ≺ syntomic ≺ fppf`; if `τ` is
finer than `τ'` this is `Stacks.Adequate.BigSite.derivedAdequateEquivalenceOfIsFiner`, and
otherwise `τ'` is finer than `τ` and it is the inverse of that equivalence with the roles of the
two sites exchanged. Both derived categories are taken at arbitrary models. -/
@[stacks 070V "`D_Adeq(𝒪_τ) ≌ D_Adeq(𝒪_τ')` for any two of the five topologies, for big sites
built on the same category of schemes over `S`, at any models of the two derived categories"]
def BigSite.derivedAdequateTopologyEquivalence (B : BigSite τ S) (B' : BigSite τ' S)
    (hcut : B'.cutoff = B.cutoff)
    [HasDerivedCategory.{d} (SheafOfModules.{u} B.structureSheaf)]
    [HasDerivedCategory.{d'} (SheafOfModules.{u} B'.structureSheaf)] :
    (BigSite.derivedAdequate.{u, u, d} B).FullSubcategory ≌
      (BigSite.derivedAdequate.{u, u, d'} B').FullSubcategory :=
  if h : τ.IsFiner τ' then B.derivedAdequateEquivalenceOfIsFiner B' hcut h
  else (B'.derivedAdequateEquivalenceOfIsFiner B hcut.symm (by
    simp only [CoveringTopology.IsFiner] at h ⊢; omega)).symm

end Stacks.Adequate

end
