open CategoryTheory CategoryTheory.Limits Opposite Simplicial TopologicalSpace
open AlgebraicGeometry AlgebraicGeometry.Scheme.Modules
open Stacks.AlgebraicGeometry.GenericPointSheaf
open Stacks.CategoryTheory.Hypercovering
open Stacks.CategoryTheory.FormalCoproductAugmentation

universe w v₂ v₁ v' u₂ u₁ u' u

namespace Stacks.CategoryTheory.FormalCoproductAugmentation

/-! ### `Over.post` and the terminal object of a slice -/

section Post

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]

/-- **`Over.post H` carries the terminal object of `Over Y` to a terminal object of
`Over (H Y)`.**  The image of `𝟙 Y` is `H (𝟙 Y)`, which is the identity of `H Y`, so the image is
isomorphic to `𝟙 (H Y)` as an object over `H Y`.  Only functoriality is used; `H` need neither
preserve limits nor be an equivalence. -/
@[ega "0 8.1.10" "more general"]
noncomputable def isTerminal_overPost_obj_mkId (H : C ⥤ D) (Y : C) :
    IsTerminal ((Over.post H (X := Y)).obj (Over.mk (𝟙 Y))) :=
  Over.mkIdTerminal.ofIso (Over.isoMk (Iso.refl _) (by simp [Over.post]))

end Post

/-! ### The augmentation and a product-preserving additive functor -/

section Functor

variable {C : Type u₁} [Category.{v₁} C] {A : Type u'} [Category.{v'} A]
  {B : Type*} [Category* B]
  [HasProducts.{w} A] [Preadditive A] [HasProducts.{w} B] [Preadditive B]
  (E : SimplicialObject (FormalCoproduct.{w} C))
  (G : A ⥤ B) [G.Additive] [∀ J : Type w, PreservesLimitsOfShape (Discrete J) G]

omit [Preadditive A] [Preadditive B] [G.Additive]
  [∀ J : Type w, PreservesLimitsOfShape (Discrete J) G] in
/-- **Applying a product-preserving functor to the canonical augmentation gives the canonical
augmentation of the composed presheaf**, after the product comparison map of that functor.  The
statement is in the product spelling; both sides are determined by their components, and on the
factor indexed by `i` each is `G` applied to the restriction map along the unique morphism
`Eₙ(i) ⟶ T`. -/
theorem map_terminalAug_comp_piComparison (P : Cᵒᵖ ⥤ A) {T : C} (hT : IsTerminal T) (n : ℕ) :
    G.map (terminalAug E hT P n) ≫
        piComparison G (fun i : (E.obj (op ⦋n⦌)).I ↦ P.obj (op ((E.obj (op ⦋n⦌)).obj i))) =
      terminalAug E hT (P ⋙ G) n := by
  refine Limits.Pi.hom_ext _ _ (fun i ↦ ?_)
  rw [Category.assoc, piComparison_comp_π, ← G.map_comp]
  exact Eq.trans (congrArg G.map (terminalAug_comp_π E hT P n i))
    (terminalAug_comp_π E hT (P ⋙ G) n i).symm

/-- `map_terminalAug_comp_piComparison` in degree zero, with the product comparison written as the
degree-zero component of
`Stacks.CechPushforward.cochainComplexFunctorCompMapHomologicalComplexIso`:  **the canonical
augmentation of a Čech-style complex commutes with applying a product-preserving additive functor
termwise.** -/
theorem map_terminalAugZero_comp (P : Cᵒᵖ ⥤ A) {T : C} (hT : IsTerminal T) :
    G.map (terminalAugZero E hT P) ≫
        ((Stacks.CechPushforward.cochainComplexFunctorCompMapHomologicalComplexIso.{w} G
          E).app P).hom.f 0 =
      terminalAugZero E hT (P ⋙ G) := by
  have h : (((Stacks.CechPushforward.cochainComplexFunctorCompMapHomologicalComplexIso.{w} G
        E).app P).hom.f 0) =
      piComparison G (fun i : (E.obj (op ⦋0⦌)).I ↦ P.obj (op ((E.obj (op ⦋0⦌)).obj i))) :=
    Category.id_comp _
  rw [h]
  exact map_terminalAug_comp_piComparison E G P hT 0

end Functor

/-! ### The augmentation and reindexing of the simplicial formal coproduct -/

section Reindex

variable {C : Type u₁} [Category.{v₁} C] {D : Type u₂} [Category.{v₂} D]
  {A : Type u'} [Category.{v'} A] [HasProducts.{w} A] [Preadditive A]
  (E : SimplicialObject (FormalCoproduct.{w} C)) (H : C ⥤ D)

omit [Preadditive A] in
/-- **The canonical augmentation is unchanged by reindexing along a functor.**  Pushing the
simplicial formal coproduct forward along `H` and evaluating a presheaf `Q` on `D` gives the same
complex as evaluating `H^*Q` on `E`, and the two augmentations agree:  on the factor indexed by `i`
both are the restriction map of `Q` along a morphism `H(Eₙ(i)) ⟶ H(T)`, and `H(T)` being terminal
there is only one such morphism. -/
theorem terminalAug_mapFormalCoproduct (Q : Dᵒᵖ ⥤ A) {T : C} (hT : IsTerminal T)
    (hT' : IsTerminal (H.obj T)) (n : ℕ) :
    terminalAug (E ⋙ mapFormalCoproduct.{w} H) hT' Q n = terminalAug E hT (H.op ⋙ Q) n := by
  refine Limits.Pi.hom_ext _ _ (fun i ↦ ?_)
  refine Eq.trans (terminalAug_comp_π (E ⋙ mapFormalCoproduct.{w} H) hT' Q n i)
    (Eq.trans ?_ (terminalAug_comp_π E hT (H.op ⋙ Q) n i).symm)
  exact congrArg (fun m ↦ Q.map (Quiver.Hom.op m))
    (hT'.hom_ext (hT'.from (H.obj ((E.obj (op ⦋n⦌)).obj i)))
      (H.map (hT.from ((E.obj (op ⦋n⦌)).obj i))))

/-- `terminalAug_mapFormalCoproduct` in degree zero, with the targets written as the degree-zero
terms of the two complexes. -/
theorem terminalAugZero_mapFormalCoproduct (Q : Dᵒᵖ ⥤ A) {T : C} (hT : IsTerminal T)
    (hT' : IsTerminal (H.obj T)) :
    terminalAugZero (E ⋙ mapFormalCoproduct.{w} H) hT' Q = terminalAugZero E hT (H.op ⋙ Q) :=
  terminalAug_mapFormalCoproduct E H Q hT hT' 0

end Reindex

end Stacks.CategoryTheory.FormalCoproductAugmentation

namespace Stacks.CategoryTheory.Hypercovering

open Stacks.CategoryTheory.FormalCoproductAugmentation

variable {C : Type u₁} [Category.{v₁} C] [HasPullbacks C]

/-- **[Stacks, Tag 01GV] in degree zero, in kernel-lift form, at a Grothendieck topology presented
as the one generated by a pretopology.**  This is
`Stacks.CategoryTheory.Hypercovering.isIso_kernelLift_terminalAugZero` with the equality
`J.toGrothendieck = G` substituted;  it exists so that a consumer whose site carries a Grothendieck
topology *equal* to the generated one — the topology of the opens of a space, say — never has to
transport a sheaf, and with it a whole category of sheaves of modules, along that equality. -/
theorem isIso_kernelLift_terminalAugZeroOfEq (J : Pretopology C)
    (G : GrothendieckTopology C) (hG : J.toGrothendieck = G) {X : C}
    (K : SimplicialObject (Limits.FormalCoproduct.{w} (Over X)))
    (hK : IsHypercovering J K) {T : Over X} (hT : IsTerminal T)
    (F : Sheaf G AddCommGrpCat.{max u₁ v₁ w}) :
    IsIso (kernel.lift ((SectionsOver.sectionsComplex G K F).d 0 1)
      (terminalAugZero K hT
        (((Functor.whiskeringLeft (Over X)ᵒᵖ Cᵒᵖ AddCommGrpCat.{max u₁ v₁ w}).obj
          (Over.forget X).op).obj
          ((sheafToPresheaf G AddCommGrpCat.{max u₁ v₁ w}).obj F)))
      (terminalAugZero_comp_d K hT
        (((Functor.whiskeringLeft (Over X)ᵒᵖ Cᵒᵖ AddCommGrpCat.{max u₁ v₁ w}).obj
          (Over.forget X).op).obj
          ((sheafToPresheaf G AddCommGrpCat.{max u₁ v₁ w}).obj F)))) := by
  subst hG
  exact isIso_kernelLift_terminalAugZero.{w} J K hK hT F

end Stacks.CategoryTheory.Hypercovering

namespace Stacks.AlgebraicGeometry.UniversalPushforward

variable {X S : Scheme.{u}}

/-! ### The degree-zero compatibility of the two augmentations -/

/-- **The coefficients of the complex of sections of the restricted hypercovering `K ⊓ f ⁻¹ V`**:
the underlying abelian sheaf of the `𝒪_X`-module `M`, read on the slice of the lattice of opens
over `⊤ ⊓ f ⁻¹ V`.  This is the presheaf
`Stacks.CategoryTheory.Hypercovering.SectionsOver.sectionsComplex` evaluates. -/
noncomputable abbrev restrictedSectionsCoefficients (f : X ⟶ S) (M : X.Modules) (V : S.Opens) :
    (Over ((opensInf (f ⁻¹ᵁ V)).obj (⊤ : Opens X)))ᵒᵖ ⥤ AddCommGrpCat.{u} :=
  ((Functor.whiskeringLeft (Over ((opensInf (f ⁻¹ᵁ V)).obj (⊤ : Opens X)))ᵒᵖ (X.Opens)ᵒᵖ
      AddCommGrpCat.{u}).obj
    (Over.forget ((opensInf (f ⁻¹ᵁ V)).obj (⊤ : Opens X))).op).obj
    ((sheafToPresheaf (Opens.grothendieckTopology ↥X) AddCommGrpCat.{u}).obj
      ((SheafOfModules.toSheaf X.ringCatSheaf).obj M))

/-- The degree-zero component of `hypercoveringSectionsComplexIso` is the degree-zero component of
the termwise comparison with a product-preserving additive functor, followed by the degree-zero
component of the map induced by the identification of the sections of the coefficient presheaf. -/
theorem hypercoveringSectionsComplexIso_hom_f_zero (f : X ⟶ S)
    (K : SimplicialObject (FormalCoproduct.{u} (Over (⊤ : Opens X))))
    (M : X.Modules) (V : S.Opens) :
    (hypercoveringSectionsComplexIso f K M V).hom.f 0 =
      ((Stacks.CechPushforward.cochainComplexFunctorCompMapHomologicalComplexIso.{u}
          (sectionsAG S V) K).app ((pushforwardPresheafAll f).obj M)).hom.f 0 ≫
        ((FormalCoproduct.cochainComplexFunctor.{u} K).map
          (pushforwardPresheafAllSectionsIso f M V).hom).f 0 :=
  rfl

/-- **The degree-zero compatibility of the two augmentations.**  The sections over an open `V` of
`S` of the canonical augmentation of `𝓚⁼(K, f, M)` are, read through the identification
`hypercoveringSectionsComplexIso` of [Stacks, Tag 01GV]'s sections complexes and through the
identification `pushforwardPresheafAllSectionsIso` of the sections of the coefficient presheaf, the
canonical augmentation of the complex of sections of the restricted hypercovering `K ⊓ f ⁻¹ V`.

This is what turns the degree-zero half of [Stacks, Tag 01GV] for a hypercovering of an open of
`X` into a statement about the complex of `𝒪_S`-modules `𝓚⁼(K, f, M)`. -/
theorem terminalAugZero_comp_hypercoveringSectionsComplexIso_zero (f : X ⟶ S)
    (K : SimplicialObject (FormalCoproduct.{u} (Over (⊤ : Opens X))))
    (M : X.Modules) (V : S.Opens) :
    (sectionsAG S V).map
          (terminalAugZero K (Over.mkIdTerminal (X := (⊤ : Opens X)))
            ((pushforwardPresheafAll f).obj M)) ≫
        (HomologicalComplex.Hom.isoApp (hypercoveringSectionsComplexIso f K M V) 0).hom =
      ((pushforwardPresheafAllSectionsIso f M V).app
          (op (Over.mk (𝟙 (⊤ : Opens X))))).hom ≫
        terminalAugZero
          (K ⋙ mapFormalCoproduct.{u}
            (Over.post (opensInf (f ⁻¹ᵁ V)) (X := (⊤ : Opens X))))
          (isTerminal_overPost_obj_mkId (opensInf (f ⁻¹ᵁ V)) (⊤ : Opens X))
          (restrictedSectionsCoefficients f M V) := by
  refine Eq.trans ?_ (congrArg
    (fun z ↦ ((pushforwardPresheafAllSectionsIso f M V).app
      (op (Over.mk (𝟙 (⊤ : Opens X))))).hom ≫ z)
    (terminalAugZero_mapFormalCoproduct.{u} K
      (Over.post (opensInf (f ⁻¹ᵁ V)) (X := (⊤ : Opens X)))
      (restrictedSectionsCoefficients f M V) (Over.mkIdTerminal (X := (⊤ : Opens X)))
      (isTerminal_overPost_obj_mkId (opensInf (f ⁻¹ᵁ V)) (⊤ : Opens X))).symm)
  refine Eq.trans ?_ (terminalAugZero_naturality.{u} K
    (Over.mkIdTerminal (X := (⊤ : Opens X)))
    (pushforwardPresheafAllSectionsIso f M V).hom).symm
  refine Eq.trans (congrArg
    (fun z ↦ (sectionsAG S V).map
      (terminalAugZero K (Over.mkIdTerminal (X := (⊤ : Opens X)))
        ((pushforwardPresheafAll f).obj M)) ≫ z)
    (hypercoveringSectionsComplexIso_hom_f_zero f K M V)) ?_
  refine Eq.trans (Category.assoc _ _ _).symm ?_
  exact congrArg (fun z ↦ z ≫ ((FormalCoproduct.cochainComplexFunctor.{u} K).map
      (pushforwardPresheafAllSectionsIso f M V).hom).f 0)
    (map_terminalAugZero_comp.{u} K (sectionsAG S V) ((pushforwardPresheafAll f).obj M)
      (Over.mkIdTerminal (X := (⊤ : Opens X))))

/-! ### The degree-zero half of the relative form of Tag 01GV -/

/-- **Over every open `V` of `S` the sections of the canonical augmentation of the relative
hypercovering complex exhibit the sections of `f_*M` as the kernel of the sections of the first
differential**, at an arbitrary `𝒪_X`-module `M`.

The complex of sections is the complex of sections of the hypercovering `K ⊓ f ⁻¹ V` of
[Stacks, Tag 0DAZ] and the augmentation is its canonical augmentation, by
`terminalAugZero_comp_hypercoveringSectionsComplexIso_zero`;  that augmentation is a kernel of the
first differential by the degree-zero half of [Stacks, Tag 01GV], which needs no hypothesis on the
sheaf. -/
theorem isIso_kernelLift_sectionsAG_terminalAugZero (f : X ⟶ S)
    (K : SimplicialObject (FormalCoproduct.{u} (Over (⊤ : Opens X))))
    (hK : IsHypercovering (Opens.pretopology ↥X) K) (M : X.Modules) (V : S.Opens) :
    IsIso (kernel.lift
      ((sectionsAG S V).map
        (((FormalCoproduct.cochainComplexFunctor.{u} K).obj
          ((pushforwardPresheafAll f).obj M)).d 0 1))
      ((sectionsAG S V).map
        (terminalAugZero K (Over.mkIdTerminal (X := (⊤ : Opens X)))
          ((pushforwardPresheafAll f).obj M)))
      (by rw [← Functor.map_comp, terminalAugZero_comp_d, Functor.map_zero])) :=
  Stacks.KernelLift.isIso_kernelLift_of_iso _ _ _
    (terminalAugZero
      (K ⋙ mapFormalCoproduct.{u} (Over.post (opensInf (f ⁻¹ᵁ V)) (X := (⊤ : Opens X))))
      (isTerminal_overPost_obj_mkId (opensInf (f ⁻¹ᵁ V)) (⊤ : Opens X))
      (restrictedSectionsCoefficients f M V))
    ((SectionsOver.sectionsComplex (Opens.grothendieckTopology ↥X)
      (K ⋙ mapFormalCoproduct.{u} (Over.post (opensInf (f ⁻¹ᵁ V)) (X := (⊤ : Opens X))))
      ((SheafOfModules.toSheaf X.ringCatSheaf).obj M)).d 0 1)
    (terminalAugZero_comp_d _ _ _)
    ((pushforwardPresheafAllSectionsIso f M V).app (op (Over.mk (𝟙 (⊤ : Opens X)))))
    (HomologicalComplex.Hom.isoApp (hypercoveringSectionsComplexIso f K M V) 0)
    (HomologicalComplex.Hom.isoApp (hypercoveringSectionsComplexIso f K M V) 1)
    (terminalAugZero_comp_hypercoveringSectionsComplexIso_zero f K M V)
    ((hypercoveringSectionsComplexIso f K M V).hom.comm 0 1).symm
    (isIso_kernelLift_terminalAugZeroOfEq.{u} (Opens.pretopology ↥X)
      (Opens.grothendieckTopology ↥X) (Opens.pretopology_toGrothendieck ↥X) _
      (IsHypercovering.opensInf (f ⁻¹ᵁ V) K hK)
      (isTerminal_overPost_obj_mkId (opensInf (f ⁻¹ᵁ V)) (⊤ : Opens X))
      ((SheafOfModules.toSheaf X.ringCatSheaf).obj M))

/-- **The canonical augmentation of the relative hypercovering complex is a kernel of the first
differential.**  This is the clause `hker` of `quasiIso_hypercoveringAugNat_app`, the degree-zero
half of the relative form of [Stacks, Tag 01GV].

The `𝒪_X`-module is arbitrary:  no injectivity and no quasi-coherence.  The members of `K` are not
assumed affine and `f` is not assumed affine or separated.  That is what makes the statement usable
at the unqualified hypotheses of [Stacks, Tag 01XN]. -/
theorem isIso_kernelLift_terminalAugZero_pushforwardPresheafAll (f : X ⟶ S)
    (K : SimplicialObject (FormalCoproduct.{u} (Over (⊤ : Opens X))))
    (hK : IsHypercovering (Opens.pretopology ↥X) K) (M : X.Modules) :
    IsIso (kernel.lift
      (((FormalCoproduct.cochainComplexFunctor.{u} K).obj
        ((pushforwardPresheafAll f).obj M)).d 0 1)
      (terminalAugZero K (Over.mkIdTerminal (X := (⊤ : Opens X)))
        ((pushforwardPresheafAll f).obj M))
      (terminalAugZero_comp_d K (Over.mkIdTerminal (X := (⊤ : Opens X)))
        ((pushforwardPresheafAll f).obj M))) :=
  isIso_kernelLift_of_forall_sections _ _ _
    (fun V ↦ isIso_kernelLift_sectionsAG_terminalAugZero f K hK M V)

/-! ### The hypothesis `hεinj` of Tag 09VX for the relative hypercovering complex -/

/-- **The `ℕ`-indexed augmentation of the relative hypercovering complex is a quasi-isomorphism at
an injective sheaf of `𝒪_X`-modules.**  The two clauses of the relative form of
[Stacks, Tag 01GV] are now both available:  the degree-zero one at an arbitrary module, and the
positive-degree one at an injective module. -/
theorem quasiIso_hypercoveringAugNat_app_of_injective (f : X ⟶ S)
    (K : SimplicialObject (FormalCoproduct.{u} (Over (⊤ : Opens X))))
    (hK : IsHypercovering (Opens.pretopology ↥X) K)
    (I : SheafOfModules.{u} X.ringCatSheaf) [Injective I] :
    QuasiIso ((hypercoveringAugNat f K).app I) :=
