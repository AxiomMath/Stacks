@[expose] public section

open CategoryTheory TopologicalSpace
open Stacks.Topology.Simplicial

namespace Stacks.CategoryTheory

universe v₁ u₁ v₂ u₂

/-- **The image of a family covering the top covers the top.** Let `u : D ⥤ C` be a continuous
functor of sites whose family of images covers the top of `C`. Then the image of a family
covering the top of `D` covers the top of `C`.

Equivalently, `CategoryTheory.GrothendieckTopology.CoversTop` is transitive along a continuous
functor: the hypothesis is that the family of *all* images `u.obj` covers the top of `C`, and
the conclusion is that so does the subfamily of the images of a family covering the top of `D`.

Neither site is asked for a terminal object, and no object of `C` is asked to admit an arrow
into the image of `u`. The proof is local: at an object `A` of `C` the hypothesis gives a
covering sieve of `A` whose members admit a map into some `u(T)`, and at such a member the image
under `u` of the covering sieve of `T` generated by the family is a covering sieve of `u(T)`,
whose pullback is covering and is contained in the sieve generated by the image family, since
`CategoryTheory.Sieve.ofObjects` depends only on the source of an arrow. Transitivity of `J`
assembles the two steps.

This is the form that the functor from the small étale site of an algebraic space `F` to a
category fibred in groupoids representable by it satisfies, and for which the stronger
hypothesis of `Stacks.CategoryTheory.coversTop_map_of_forall_exists_hom` fails: a scheme chart
of `F` admits no map to an étale chart of `F` in general, it is only *covered* by schemes that
do. -/
theorem coversTop_map_of_coversTop_obj {C : Type u₁} [Category.{v₁} C] {D : Type u₂}
    [Category.{v₂} D] {J : GrothendieckTopology C} {K : GrothendieckTopology D} (u : D ⥤ C)
    [u.IsContinuous K J] (hu : J.CoversTop u.obj)
    {I : Type*} {Y : I → D} (hY : K.CoversTop Y) :
    J.CoversTop fun i ↦ u.obj (Y i) := by
  intro A
  refine J.transitive (hu A) _ ?_
  rintro A' g ⟨T, ⟨h⟩⟩
  refine J.superset_covering ?_ (J.pullback_stable h
    ((CoverPreserving.of_isContinuous u K J).cover_preserve (hY T)))
  rintro B k ⟨Z, p, q, ⟨i, ⟨b⟩⟩, -⟩
  exact ⟨i, ⟨q ≫ u.map b⟩⟩

/-- **If every object admits an arrow into the image of a functor, then the family of images
covers the top.** The sieve of objects generated by the image family is the maximal sieve. -/
theorem coversTop_obj_of_forall_exists_hom {C : Type u₁} [Category.{v₁} C] {D : Type u₂}
    [Category.{v₂} D] {J : GrothendieckTopology C} (u : D ⥤ C)
    (hu : ∀ A : C, ∃ T : D, Nonempty (A ⟶ u.obj T)) :
    J.CoversTop u.obj := fun A =>
  J.superset_covering (fun Z _ _ => hu Z) (J.top_mem A)

/-- **The image of a family covering the top covers the top.** Let `u : D ⥤ C` be a continuous
functor of sites such that every object of `C` admits an arrow into the image of `u`. Then the
image of a family covering the top of `D` covers the top of `C`.

This is `Stacks.Sheaves.LocalizedPullback.coversTop_map` with the hypothesis that `u` carry a
terminal object to a terminal object replaced by the weaker one, which is what a site with no
terminal object — such as the total Zariski site of a simplicial scheme — can satisfy. It is in
turn the case of `Stacks.CategoryTheory.coversTop_map_of_coversTop_obj` in which the sieve of
objects generated by the image family is the maximal sieve. -/
theorem coversTop_map_of_forall_exists_hom {C : Type u₁} [Category.{v₁} C] {D : Type u₂}
    [Category.{v₂} D] {J : GrothendieckTopology C} {K : GrothendieckTopology D} (u : D ⥤ C)
    [u.IsContinuous K J] (hu : ∀ A : C, ∃ T : D, Nonempty (A ⟶ u.obj T))
    {I : Type*} {Y : I → D} (hY : K.CoversTop Y) :
    J.CoversTop fun i ↦ u.obj (Y i) :=
  coversTop_map_of_coversTop_obj u (coversTop_obj_of_forall_exists_hom u hu) hY

end Stacks.CategoryTheory

namespace AlgebraicGeometry.SimplicialScheme

universe u

variable {V U : SimplicialObject Scheme.{u}}

/-- Every object of the total Zariski site admits an arrow into the image of the degreewise
inverse-image functor of a morphism of simplicial schemes: the object `(m, V')` maps to
`(m, ⊤)`, which is the inverse image of `(m, ⊤)`. -/
public theorem exists_hom_zariskiPullback (f : V ⟶ U) (A : ZariskiOpen V) :
    ∃ T : ZariskiOpen U, Nonempty (A ⟶ (zariskiPullback f).obj T) :=
  ⟨⟨A.degree, ⊤⟩, ⟨{ base := 𝟙 _, le := fun _ _ => trivial }⟩⟩

/-- **A family covering the top of the total Zariski site pulls back to one.** If `{W_i}` covers
the top of the total Zariski site of `U`, then the degreewise inverse images `{f⁻¹W_i}` cover
the top of the total Zariski site of `V`. -/
public theorem coversTop_zariskiPullback (f : V ⟶ U) {I : Type*} {W : I → ZariskiOpen U}
    (hW : (zariskiTopology U).CoversTop W) :
    (zariskiTopology V).CoversTop fun i ↦ (zariskiPullback f).obj (W i) :=
  Stacks.CategoryTheory.coversTop_map_of_forall_exists_hom (zariskiPullback f)
    (exists_hom_zariskiPullback f) hW

end AlgebraicGeometry.SimplicialScheme

end
