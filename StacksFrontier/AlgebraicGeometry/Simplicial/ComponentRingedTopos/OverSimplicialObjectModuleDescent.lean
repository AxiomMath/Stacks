module

public import StacksFrontier.AlgebraicGeometry.Simplicial.ComponentRingedTopos.AugmentationModuleDescentHypercovering
public import StacksFrontier.CategoryTheory.Sites.Simplicial.HypercoveringBySimplicialObjectAugmented
public import StacksFrontier.CategoryTheory.Sites.Simplicial.OverSimplicialObjectComparison

/-!
# Descent of modules along a hypercovering, in the model `n ↦ C/U_n` of the total site

Let `C` be a site with fibre products, `a : U ⟶ X` a hypercovering of `X` in `C`, and
`f : (Sh((C/U)_total), O) ⟶ (Sh(C/X), O_X)` a morphism of ringed topoi whose inverse image on
sheaves of sets is restriction along `V/U_n ↦ V/X` and whose structure map is the
identification `O = f⁻¹O_X`. Then `f^*` is fully faithful on sheaves of modules with essential
image the cartesian `O`-modules, and `f_*` is a quasi-inverse. This is Stacks 0DAB read in the
model `n ↦ C/U_n` of the total site of Stacks 09X8, as used by Stacks 0DHD.

## Main results

* `CategoryTheory.SimplicialOver.descent_modules_augmented_overSimplicialObjectModuleDescent`.

## References

* [Stacks Project, Tag 0DAB](https://stacks.math.columbia.edu/tag/0DAB)
* [Stacks Project, Tag 0DA8](https://stacks.math.columbia.edu/tag/0DA8)
* [Stacks Project, Tag 09X8](https://stacks.math.columbia.edu/tag/09X8)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry Stacks.CategoryTheory.Hypercovering

universe u

namespace CategoryTheory.SimplicialOver

variable {C : Type u} [SmallCategory C] [HasPullbacks C] (P : Pretopology C)
  {U : SimplicialObject C} {X : C} {a : U ⟶ (SimplicialObject.const C).obj X}
  {J : GrothendieckTopology C} (hJ : P.toGrothendieck = J) (h : IsHypercoveringAugmentation P U a)

include hJ h in
/-- **Descent of modules along a hypercovering, in the model `n ↦ C/U_n`.** Let `a : U ⟶ X` be a
hypercovering of `X` in `C` and `f : (Sh((C/U)_total), O) ⟶ (Sh(C/X), O_X)` a morphism of ringed
topoi whose inverse image is restriction along `V/U_n ↦ V/X` and whose structure map is the
identification `O = f⁻¹O_X`, the topology `J` of `C` being generated by `P`. Then `f^*` is fully
faithful with essential image the cartesian `O`-modules, the unit of `f^* ⊣ f_*` is invertible, and
its counit is invertible at every cartesian module. -/
theorem descent_modules_augmented_overSimplicialObjectModuleDescent
    {O : Sheaf (situation J U).totalTopology CommRingCat.{u}}
    {OX : Sheaf (J.over X) CommRingCat.{u}}
    (f : RingedToposHom ((situation J U).totalRingedTopos O)
      { C := Over X, J := J.over X, O := OX })
    [hf : IsIso f.fSharpInverseImage]
    (e : f.toToposHom.inverseImage ≅ (augmentationFunctor U a).sheafPushforwardContinuous (Type u)
      (totalTopology J U) (J.over X)) :
    Nonempty f.toModulesHom.pullbackModules.FullyFaithful ∧
      (∀ F : SheafOfModules.{u} ((situation J U).totalRingSheaf O),
        f.toModulesHom.pullbackModules.essImage F ↔ (situation J U).IsCartesianModule O F) ∧
      IsIso f.pullbackAdjPushforwardModules.unit ∧
      ∀ F : SheafOfModules.{u} ((situation J U).totalRingSheaf O),
        (situation J U).IsCartesianModule O F →
          IsIso (f.pullbackAdjPushforwardModules.counit.app F) := by
  have hd := descent_sheaves_augmented_hypercoveringBySimplicialObjectAugmented a P hJ h
  refine
    SimplicialSiteSituation.descent_modules_of_ringedToposHom_augmentationModuleDescentHypercovering
      f ⟨hd.1.some.ofIso e.symm⟩ fun F => ?_
  rw [Functor.essImage_eq_of_natIso e]
  exact hd.2 F

end CategoryTheory.SimplicialOver
