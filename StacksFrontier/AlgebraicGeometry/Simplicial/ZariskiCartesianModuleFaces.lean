module

public import Mathlib.AlgebraicTopology.SimplexCategory.MorphismProperty
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicGeometry.Simplicial.ZariskiCartesianModule

/-!
# Cartesian modules on the total Zariski site are detected by the face maps

Let `X` be a simplicial scheme and `F` a sheaf of `𝒪_X`-modules on its total Zariski site. For
a map of simplicial degrees `φ : n ⟶ m` the transition `(X φ)^* F_m ⟶ F_n` of Stacks 09WF is
`AlgebraicGeometry.SimplicialScheme.componentModuleTransition`, and `F` is cartesian when all of
them are isomorphisms (Stacks 07TF (2)). This file proves the criterion of Stacks 07TG (3) for
that notion: it suffices that the transitions along the *face* maps be isomorphisms.

The two ingredients are the pseudofunctoriality of the transition — a cocycle law for a
composite of simplex maps and an identity law — and the fact that the simplex category is
generated by faces and degeneracies.

## Main definitions

* `AlgebraicGeometry.SimplicialScheme.componentPushforwardCompIso`: the comparison
  `(X φ)_* ∘ (X ψ)_* ≅ (X (φ ≫ ψ))_*` of composite direct images of modules.
* `AlgebraicGeometry.SimplicialScheme.componentPushforwardIdIso`: the comparison
  `𝟭 ≅ (X (𝟙 n))_*`.
* `AlgebraicGeometry.SimplicialScheme.componentPullbackCompIso`: the pullback compositor
  `(X (φ ≫ ψ))^* ≅ (X ψ)^* ⋙ (X φ)^*`, obtained from the comparison of direct images by
  uniqueness of a left adjoint.

## Main results

* `AlgebraicGeometry.SimplicialScheme.componentModuleDirectTransition_comp` and
  `componentModuleDirectTransition_id`: the cocycle and identity laws for the direct form of the
  transition, proved on sections.
* `AlgebraicGeometry.SimplicialScheme.componentModuleTransition_comp` and
  `isIso_componentModuleTransition_id`: the same laws for the transition itself.
* `AlgebraicGeometry.SimplicialScheme.isCartesianModule_iff_faces`: **Stacks 07TG (3) for the
  total Zariski site of a simplicial scheme.**

## Implementation notes

*The laws for the direct transition are proved on sections.* Over an open `W` of `X_l` all the
maps involved are restriction maps of `F` along arrows of the total Zariski site: the two
transitions along the arrows lying over `ψ` and over `φ`, the comparison of composite direct
images (the identity on sections), and the comparison of the two readings of the inverse image
of `W`, which is a restriction inside degree `n`. Two arrows of the total site with the same
source, the same target and the same underlying map of simplicial degrees are equal, so the
composite agrees with the transition along the arrows lying over `φ ≫ ψ`.

*The laws for the transition are then formal.* The transition is the mate of the direct
transition under the adjunction `(X φ)^* ⊣ (X φ)_*`, and the mate of a composite of comparisons
of right adjoints is the composite of the mates, compared by the isomorphism that uniqueness of
a left adjoint produces (`Stacks.CategoryTheory.homEquiv_symm_comp`); the mate of a comparison
`𝟭 ≅ R` is the comparison of left adjoints itself, hence invertible
(`Stacks.CategoryTheory.isIso_homEquiv_symm_natIso`). Neither step identifies the comparison
with `AlgebraicGeometry.Scheme.Modules.pullbackComp`, which is not needed: only invertibility
is used downstream.

*Why `Stacks.CategoryTheory.presheafMapThreefold` is stated at free variables.* The arrows of
the total Zariski site are built in the category `Stacks.Topology.Simplicial.SimplicialOpen`,
while the presheaf underlying a sheaf of modules on that site has domain
`(zariskiRingedTopos X).C`. The two are definitionally equal but not syntactically, so a `rw`
of `Functor.map_comp` whose motive is formed over the goal does not typecheck; composing the
three restriction maps is therefore done by a lemma which takes the equation of arrows as an
argument.

*Why no hypothesis on the degeneracies is needed.* The simplex maps whose transition is
invertible are closed under composition and contain the identities, and
`SimplexCategory.δ_comp_σ_self` exhibits each degeneracy as the second factor of a composite
which is an identity, so the cocycle law lets the two leading invertible factors be cancelled.

## References

* [Stacks Project, Tag 07TG](https://stacks.math.columbia.edu/tag/07TG)
* [Stacks Project, Tag 07TF](https://stacks.math.columbia.edu/tag/07TF)
* [Stacks Project, Tag 09WE](https://stacks.math.columbia.edu/tag/09WE)
* [Stacks Project, Tag 09WF](https://stacks.math.columbia.edu/tag/09WF)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace
open Stacks.Topology.Simplicial

universe u

namespace Stacks.CategoryTheory

/-- Transposing a composite whose first factor compares two left adjoints of one functor. -/
theorem leftAdjointUniq_homEquiv_comp {A : Type*} [Category* A] {B : Type*} [Category* B]
    {P P' : A ⥤ B} {Q : B ⥤ A} (adj : P ⊣ Q) (adj' : P' ⊣ Q) {Y : A} {Z : B}
    (g : P'.obj Y ⟶ Z) :
    adj.homEquiv Y Z ((Adjunction.leftAdjointUniq adj adj').hom.app Y ≫ g) =
      adj'.homEquiv Y Z g := by
  rw [Adjunction.homEquiv_unit, Functor.map_comp, ← Category.assoc,
    Adjunction.unit_leftAdjointUniq_hom_app, ← Adjunction.homEquiv_unit]

/-- **The mates of a composite of comparisons of right adjoints compose.** A cocycle of
comparisons of right adjoints transposes to a cocycle of the left adjoints, compared by the
isomorphism that uniqueness of a left adjoint produces. -/
theorem homEquiv_symm_comp {A : Type*} [Category* A] {B : Type*} [Category* B]
    {C : Type*} [Category* C] {L₁ : A ⥤ B} {R₁ : B ⥤ A} (adjψ : L₁ ⊣ R₁)
    {L₂ : B ⥤ C} {R₂ : C ⥤ B} (adjφ : L₂ ⊣ R₂) {L : A ⥤ C} {R : C ⥤ A} (adjχ : L ⊣ R)
    (τ : R₂ ⋙ R₁ ≅ R) {Y : A} {Z : B} {W : C} (uψ : Y ⟶ R₁.obj Z) (uφ : Z ⟶ R₂.obj W)
    (uχ : Y ⟶ R.obj W) (hu : (uψ ≫ R₁.map uφ) ≫ τ.hom.app W = uχ) :
    (adjχ.homEquiv Y W).symm uχ =
      (Adjunction.leftAdjointUniq (adjχ.ofNatIsoRight τ.symm) (adjψ.comp adjφ)).hom.app Y ≫
        L₂.map ((adjψ.homEquiv Y Z).symm uψ) ≫ (adjφ.homEquiv Z W).symm uφ := by
  refine ((adjχ.ofNatIsoRight τ.symm).homEquiv Y W).injective ?_
  rw [leftAdjointUniq_homEquiv_comp, Adjunction.homEquiv_ofNatIsoRight_apply,
    Adjunction.comp_homEquiv]
  simp only [Equiv.trans_apply]
  rw [Adjunction.homEquiv_naturality_left, Adjunction.homEquiv_naturality_right,
    Equiv.apply_symm_apply, Equiv.apply_symm_apply, Equiv.apply_symm_apply, Iso.symm_hom, ← hu,
    Category.assoc, Iso.hom_inv_id_app]
  exact Category.comp_id _

/-- **The mate of a unit is the comparison of left adjoints, hence invertible.** -/
theorem isIso_homEquiv_symm_unit {A : Type*} [Category* A] {B : Type*} [Category* B]
    {L L' : A ⥤ B} {R : B ⥤ A} (adj : L ⊣ R) (adj' : L' ⊣ R) {Y : A}
    (u : Y ⟶ R.obj (L'.obj Y)) (hu : adj'.unit.app Y = u) :
    IsIso ((adj.homEquiv Y (L'.obj Y)).symm u) := by
  subst hu
  rw [← Adjunction.homEquiv_leftAdjointUniq_hom_app adj adj', Equiv.symm_apply_apply]
  infer_instance

/-- **The mate of a comparison `𝟭 ≅ R` is invertible.** -/
theorem isIso_homEquiv_symm_natIso {A : Type*} [Category* A] {L R : A ⥤ A} (adj : L ⊣ R)
    (τ : 𝟭 A ≅ R) {Y : A} (u : Y ⟶ R.obj Y) (hu : τ.hom.app Y = u) :
    IsIso ((adj.homEquiv Y Y).symm u) :=
  isIso_homEquiv_symm_unit adj (Adjunction.id.ofNatIsoRight τ) u (by simpa using hu)

/-- A threefold restriction map of a presheaf, with the equation of arrows passed as an
argument. Stated at free variables so that no identification of the ambient category has to be
recovered by unification. -/
theorem presheafMapThreefold {C : Type*} [Category* C] {A : Type*} [Category* A]
    (P : Cᵒᵖ ⥤ A) {U V Z T : C} (a : T ⟶ Z) (b : Z ⟶ V) (c : V ⟶ U) (d : T ⟶ U)
    (h : d = a ≫ b ≫ c) :
    (P.map c.op ≫ P.map b.op) ≫ P.map a.op = P.map d.op := by
  subst h
  rw [← P.map_comp, ← P.map_comp]
  rfl

end Stacks.CategoryTheory

namespace AlgebraicGeometry.SimplicialScheme

variable {n m l : SimplexCategoryᵒᵖ}

/-- The comparison of the two composite direct images of modules attached to a composite of
maps of simplicial degrees: `(X φ)_* ∘ (X ψ)_* ≅ (X (φ ≫ ψ))_*`. -/
public noncomputable def componentPushforwardCompIso (X : SimplicialObject Scheme.{u})
    (φ : n ⟶ m) (ψ : m ⟶ l) :
    Scheme.Modules.pushforward (X.map φ) ⋙ Scheme.Modules.pushforward (X.map ψ) ≅
      Scheme.Modules.pushforward (X.map (φ ≫ ψ)) :=
  Scheme.Modules.pushforwardComp (X.map φ) (X.map ψ) ≪≫
    Scheme.Modules.pushforwardCongr (X.map_comp φ ψ).symm

/-- The identification of the direct image of modules along the identity map of simplicial
degrees with the identity functor. -/
public noncomputable def componentPushforwardIdIso (X : SimplicialObject Scheme.{u})
    (n : SimplexCategoryᵒᵖ) :
    𝟭 (X.obj n).Modules ≅ Scheme.Modules.pushforward (X.map (𝟙 n)) :=
  (Scheme.Modules.pushforwardCongr (X.map_id n) ≪≫
    Scheme.Modules.pushforwardId (X.obj n)).symm

/-- **The pullback compositor of Stacks 09WE for a simplicial scheme.** The isomorphism
`(X (φ ≫ ψ))^* ≅ (X ψ)^* ⋙ (X φ)^*` of left adjoints attached to the comparison
`componentPushforwardCompIso` of direct images. -/
public noncomputable def componentPullbackCompIso (X : SimplicialObject Scheme.{u})
    (φ : n ⟶ m) (ψ : m ⟶ l) :
    Scheme.Modules.pullback (X.map (φ ≫ ψ)) ≅
      Scheme.Modules.pullback (X.map ψ) ⋙ Scheme.Modules.pullback (X.map φ) :=
  Adjunction.leftAdjointUniq
    ((Scheme.Modules.pullbackPushforwardAdjunction (X.map (φ ≫ ψ))).ofNatIsoRight
      (componentPushforwardCompIso X φ ψ).symm)
    ((Scheme.Modules.pullbackPushforwardAdjunction (X.map ψ)).comp
      (Scheme.Modules.pullbackPushforwardAdjunction (X.map φ)))

/-- **The cocycle law for the direct transition, for the total Zariski site.** The direct
transition attached to a composite of maps of simplicial degrees is the composite of the two
direct transitions, compared by the comparison of composite direct images. -/
public theorem componentModuleDirectTransition_comp (X : SimplicialObject Scheme.{u})
    (φ : n ⟶ m) (ψ : m ⟶ l) (F : Modules X) :
    ((componentModuleDirectTransition X ψ).app F ≫
        (Scheme.Modules.pushforward (X.map ψ)).map
          ((componentModuleDirectTransition X φ).app F)) ≫
      (componentPushforwardCompIso X φ ψ).hom.app ((componentModule X n).obj F) =
      (componentModuleDirectTransition X (φ ≫ ψ)).app F := by
  ext W x
  simp only [Scheme.Modules.Hom.comp_app, Scheme.Modules.pushforward_map_app,
    componentPushforwardCompIso, Iso.trans_hom, NatTrans.comp_app,
    Scheme.Modules.pushforwardComp_hom_app_app, Scheme.Modules.pushforwardCongr_hom_app_app]
  have e : X.map (φ ≫ ψ) ⁻¹ᵁ W = (X.map φ ≫ X.map ψ) ⁻¹ᵁ W :=
    congrArg (fun k : X.obj n ⟶ X.obj l => k ⁻¹ᵁ W) (X.map_comp φ ψ)
  change (F.val.presheaf.map ((levelFunctor (zariskiSpace X) n).map (eqToHom e)).op)
      ((F.val.presheaf.map (SimplicialSheafSystem.transitionHom (X := zariskiSpace X) φ
          ((Opens.map ((zariskiSpace X).map ψ)).obj W)).op)
        ((F.val.presheaf.map
          (SimplicialSheafSystem.transitionHom (X := zariskiSpace X) ψ W).op) x)) =
    (F.val.presheaf.map
      (SimplicialSheafSystem.transitionHom (X := zariskiSpace X) (φ ≫ ψ) W).op) x
  have key : SimplicialSheafSystem.transitionHom (X := zariskiSpace X) (φ ≫ ψ) W =
      (levelFunctor (zariskiSpace X) n).map (eqToHom e) ≫
        SimplicialSheafSystem.transitionHom (X := zariskiSpace X) φ
            ((Opens.map ((zariskiSpace X).map ψ)).obj W) ≫
          SimplicialSheafSystem.transitionHom (X := zariskiSpace X) ψ W := by
    apply SimplicialOpen.Hom.ext
    change φ ≫ ψ = (𝟙 n) ≫ φ ≫ ψ
    simp
  exact congr($(Stacks.CategoryTheory.presheafMapThreefold F.val.presheaf _ _ _ _ key) x)

/-- **The identity law for the direct transition, for the total Zariski site.** The direct
transition attached to the identity map of simplicial degrees is the comparison of the direct
image along `X (𝟙 n)` with the identity functor. -/
public theorem componentModuleDirectTransition_id (X : SimplicialObject Scheme.{u})
    (n : SimplexCategoryᵒᵖ) (F : Modules X) :
    (componentPushforwardIdIso X n).hom.app ((componentModule X n).obj F) =
      (componentModuleDirectTransition X (𝟙 n)).app F := by
  ext W x
  simp only [componentPushforwardIdIso, Iso.symm_hom, Iso.trans_inv, NatTrans.comp_app,
    Scheme.Modules.Hom.comp_app, Scheme.Modules.pushforwardId_inv_app_app,
    Scheme.Modules.pushforwardCongr_inv_app_app]
  have e : X.map (𝟙 n) ⁻¹ᵁ W = 𝟙 (X.obj n) ⁻¹ᵁ W :=
    congrArg (fun k : X.obj n ⟶ X.obj n => k ⁻¹ᵁ W) (X.map_id n)
  change (F.val.presheaf.map ((levelFunctor (zariskiSpace X) n).map (eqToHom e)).op) x =
    (F.val.presheaf.map
      (SimplicialSheafSystem.transitionHom (X := zariskiSpace X) (𝟙 n) W).op) x
  have key : SimplicialSheafSystem.transitionHom (X := zariskiSpace X) (𝟙 n) W =
      (levelFunctor (zariskiSpace X) n).map (eqToHom e) := by
    apply SimplicialOpen.Hom.ext
    rfl
  rw [key]
  rfl

/-- **The cocycle law for the transition of Stacks 09WF, for the total Zariski site.** The
transition attached to a composite of maps of simplicial degrees is the composite of the two
transitions, preceded by the pullback compositor. -/
public theorem componentModuleTransition_comp (X : SimplicialObject Scheme.{u})
    (φ : n ⟶ m) (ψ : m ⟶ l) (F : Modules X) :
    componentModuleTransition X (φ ≫ ψ) F =
      (componentPullbackCompIso X φ ψ).hom.app ((componentModule X l).obj F) ≫
        (Scheme.Modules.pullback (X.map φ)).map (componentModuleTransition X ψ F) ≫
          componentModuleTransition X φ F :=
  Stacks.CategoryTheory.homEquiv_symm_comp
    (Scheme.Modules.pullbackPushforwardAdjunction (X.map ψ))
    (Scheme.Modules.pullbackPushforwardAdjunction (X.map φ))
    (Scheme.Modules.pullbackPushforwardAdjunction (X.map (φ ≫ ψ)))
    (componentPushforwardCompIso X φ ψ) ((componentModuleDirectTransition X ψ).app F)
    ((componentModuleDirectTransition X φ).app F)
    ((componentModuleDirectTransition X (φ ≫ ψ)).app F)
    (componentModuleDirectTransition_comp X φ ψ F)

/-- **Invertibility of the transition is stable under composition.** -/
public theorem isIso_componentModuleTransition_comp (X : SimplicialObject Scheme.{u})
    (φ : n ⟶ m) (ψ : m ⟶ l) (F : Modules X)
    (hφ : IsIso (componentModuleTransition X φ F))
    (hψ : IsIso (componentModuleTransition X ψ F)) :
    IsIso (componentModuleTransition X (φ ≫ ψ) F) := by
  have := hφ
  have := hψ
  rw [componentModuleTransition_comp]
  infer_instance

/-- **The transition along the identity map of simplicial degrees is an isomorphism.** -/
public theorem isIso_componentModuleTransition_id (X : SimplicialObject Scheme.{u})
    (n : SimplexCategoryᵒᵖ) (F : Modules X) :
    IsIso (componentModuleTransition X (𝟙 n) F) :=
  Stacks.CategoryTheory.isIso_homEquiv_symm_natIso
    (Scheme.Modules.pullbackPushforwardAdjunction (X.map (𝟙 n)))
    (componentPushforwardIdIso X n) ((componentModuleDirectTransition X (𝟙 n)).app F)
    (componentModuleDirectTransition_id X n F)

/-- **Stacks 07TG (3) for the total Zariski site of a simplicial scheme.** A sheaf of
`𝒪_X`-modules on the total Zariski site of a simplicial scheme is cartesian if and only if the
transition `(d^{k+1}_i)^* F_k ⟶ F_{k+1}` along every face map is an isomorphism. -/
@[stacks 07TG "part (3), the criterion for sheaves of MODULES, for the total Zariski site of a \
simplicial scheme (the site of 09VL, which this development does not carry as a term of \
Situation 09WE) with the cartesian condition of `ZariskiCartesianModule`. Parts (1) and (2) of \
the source, for sheaves of sets and for objects of the derived category of the total site, and \
part (4), for the derived pullbacks, are not covered here; parts (1) and (2) for a \
simplicial-site situation are \
`CategoryTheory.SimplicialSiteSituation.isCartesianSheaf_iff_faces` and \
`isCartesianAbSheaf_iff_faces`"]
public theorem isCartesianModule_iff_faces (X : SimplicialObject Scheme.{u}) (F : Modules X) :
    IsCartesianModule X F ↔
      ∀ (k : ℕ) (i : Fin (k + 2)),
        IsIso (componentModuleTransition X (SimplexCategory.δ i).op F) := by
  refine ⟨fun h k i => h _, fun h => ?_⟩
  let W : MorphismProperty SimplexCategory :=
    fun _ _ χ => IsIso (componentModuleTransition X χ.op F)
  have hid : ∀ k : SimplexCategory, W (𝟙 k) :=
    fun k => isIso_componentModuleTransition_id X (op k) F
  have hcomp : ∀ {a b c : SimplexCategory} (χ : a ⟶ b) (ξ : b ⟶ c), W χ → W ξ → W (χ ≫ ξ) :=
    fun χ ξ hχ hξ => isIso_componentModuleTransition_comp X ξ.op χ.op F hξ hχ
  have : W.ContainsIdentities := ⟨hid⟩
  have : W.IsStableUnderComposition := ⟨fun χ ξ hχ hξ => hcomp χ ξ hχ hξ⟩
  have : W.IsMultiplicative := ⟨⟩
  have hδ : ∀ {k : ℕ} (i : Fin (k + 2)), W (SimplexCategory.δ i) := fun i => h _ i
  have hσ : ∀ {k : ℕ} (i : Fin (k + 1)), W (SimplexCategory.σ i) := by
    intro k i
    have hface : IsIso (componentModuleTransition X (SimplexCategory.δ i.castSucc).op F) :=
      hδ i.castSucc
    have hop : (SimplexCategory.σ i).op ≫ (SimplexCategory.δ i.castSucc).op =
        𝟙 (op (SimplexCategory.mk k)) :=
      congrArg Quiver.Hom.op SimplexCategory.δ_comp_σ_self
    have hc : IsIso (componentModuleTransition X
        ((SimplexCategory.σ i).op ≫ (SimplexCategory.δ i.castSucc).op) F) := by
      rw [hop]
      exact isIso_componentModuleTransition_id X _ F
    rw [componentModuleTransition_comp X (SimplexCategory.σ i).op
      (SimplexCategory.δ i.castSucc).op F] at hc
    have := hface
    exact (isIso_comp_left_iff _ _).mp ((isIso_comp_left_iff _ _).mp hc)
  have hW := SimplexCategory.morphismProperty_eq_top W hδ hσ
  intro a b χ
  exact show W χ.unop by rw [hW]; trivial

end AlgebraicGeometry.SimplicialScheme

end
