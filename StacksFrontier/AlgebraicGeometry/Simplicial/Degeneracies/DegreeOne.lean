module

public import StacksFrontier.Cotangent.PolynomialPresentation
public import StacksFrontier.AlgebraicGeometry.Simplicial.Degeneracies.OneTruncated
public import StacksFrontier.AlgebraicTopology.SimplicialSet.TrivialKanFibration
public import StacksFrontier.AlgebraicTopology.SimplicialObject.Coskeletal
public import StacksFrontier.AlgebraicTopology.CechNerve
public import Mathlib.Algebra.Category.AlgCat.Limits
public import Mathlib.Algebra.Algebra.Equiv
public import StacksCore.Tactic.StacksAttribute
public import StacksFrontier.AlgebraicTopology.SimplicialSet.TrivialKanFibration.CechNerve

/-!
# The first degree of a polynomial simplicial resolution

For a polynomial presentation `P₀ = A[uᵢ]` of `B` with kernel generated by relations `fₜ`,
adjoin variables `xₜ` in degree one. The two face maps send `xₜ` to zero and `fₜ`,
respectively, and the degeneracy fixes `uᵢ`.

## Main definitions

* `Algebra.PolynomialPresentationWithKernelGenerators.DegreeOne.P1` is `A[uᵢ,xₜ]`.
* `Algebra.PolynomialPresentationWithKernelGenerators.DegreeOne.faceZero`, `faceOne` and
  `degeneracyZero` are the degree-one structure maps.
* `Algebra.PolynomialPresentationWithKernelGenerators.DegreeOne.truncatedData` is the
  reflexive graph of bundled algebras these three maps form, and `degreeOneTruncated` is the
  one-truncated simplicial algebra it determines.
* `Algebra.PolynomialPresentationWithKernelGenerators.DegreeOne.DegreeOneCoskeleton` records
  the truncated simplicial algebra, its algebraic coskeleton and augmentation, and the
  identifications in degrees zero and one.

## Main results

* `Algebra.PolynomialPresentationWithKernelGenerators.DegreeOne.range_faceZero_sub_faceOne`
  identifies the image of the alternating face map with the kernel of `P₀ → B`.
* `Algebra.PolynomialPresentationWithKernelGenerators.DegreeOne.facePair_surjective` gives the
  matching-object surjectivity in degree one.
* `Algebra.PolynomialPresentationWithKernelGenerators.DegreeOne.coskeleton_trivialKanFibration`
  states the trivial Kan fibration assertion for the associated coskeleton.

## Implementation notes

The variables of `P₁` are indexed by the disjoint sum of the degree-zero variables and the
relation indices. The tagged lemmas state, respectively, the exactness, the matching-object
surjectivity, and the coskeleton assertion. The three algebras are canonically universe-lifted
into a common category of `A`-algebras. The recorded simplicial algebra is identified with the
`1`-coskeleton of its truncated algebra; the trivial Kan assertion is made after forgetting the
algebra structure.

The one-truncated simplicial algebra is assembled through
`CategoryTheory.SimplicialObject.OneTruncatedData`, which turns the reflexive graph
`P₁ ⇉ P₀` into a functor on `(SimplexCategory.Truncated 1)ᵒᵖ` once and for all; the two faces
and the degeneracy are then read off by `toTruncated_map_δ` and `toTruncated_map_σ`. Building
the functor here instead, by case analysis on the morphisms of `(SimplexCategory.Truncated 1)ᵒᵖ`
with a transport along `Δ.len = 0` in the object assignment, makes the elaboration cost of the
definition unbounded.

## References

* [Stacks Project, Tag 09D4](https://stacks.math.columbia.edu/tag/09D4)
-/

@[expose] public section

open Algebra MvPolynomial CategoryTheory Opposite
open scoped Simplicial

universe u v w x

namespace Algebra.PolynomialPresentationWithKernelGenerators.DegreeOne

variable (p : PolynomialPresentationWithKernelGenerators.{u, v, w, x})

/-- The polynomial algebra in the degree-zero and relation variables. -/
abbrev P1 := MvPolynomial (p.variableIndex ⊕ p.relationIndex) p.A

/-- The first face map sends each new variable to zero. -/
noncomputable def faceZero : P1 p →ₐ[p.A] p.P0 :=
  MvPolynomial.aeval (Sum.elim (fun i => MvPolynomial.X i) (fun _ => 0))

/-- The second face map sends each new variable to its defining relation. -/
noncomputable def faceOne : P1 p →ₐ[p.A] p.P0 := by
  letI : Algebra p.A p.B := p.algebraMap.toAlgebra
  exact MvPolynomial.aeval (Sum.elim (fun i => MvPolynomial.X i) p.presentation.relation)

/-- The degree-zero degeneracy fixes the original variables. -/
noncomputable def degeneracyZero : p.P0 →ₐ[p.A] P1 p :=
  MvPolynomial.aeval (fun i => MvPolynomial.X (Sum.inl i))

/-- The augmentation of the degree-zero polynomial algebra. -/
noncomputable def augmentationZeroAlg :
    (letI : Algebra p.A p.B := p.algebraMap.toAlgebra
     p.P0 →ₐ[p.A] p.B) := by
  letI : Algebra p.A p.B := p.algebraMap.toAlgebra
  exact MvPolynomial.aeval p.presentation.val

/-- The underlying ring homomorphism of the degree-zero augmentation. -/
noncomputable def augmentationZero : p.P0 →+* p.B := by
  letI : Algebra p.A p.B := p.algebraMap.toAlgebra
  exact (augmentationZeroAlg p).toRingHom

/-- The degree-zero algebra as a bundled algebra. -/
noncomputable abbrev algP0 : AlgCat.{max u v w x} p.A :=
  AlgCat.of p.A (ULift.{max u v w x, max u w} p.P0)

/-- The degree-one algebra as a bundled algebra. -/
noncomputable abbrev algP1 : AlgCat.{max u v w x} p.A :=
  AlgCat.of p.A (ULift.{max u v w x, max u w x} (P1 p))

/-- The target algebra as a bundled algebra. -/
@[implicit_reducible]
noncomputable def algB : AlgCat.{max u v w x} p.A := by
  letI : Algebra p.A p.B := p.algebraMap.toAlgebra
  exact AlgCat.of p.A (ULift.{max u v w x, v} p.B)

/-- The first face map, with the common category universe. -/
noncomputable def faceZeroLift :
    ULift.{max u v w x, max u w x} (P1 p) →ₐ[p.A]
      ULift.{max u v w x, max u w} p.P0 :=
  (ULift.algEquiv (R := p.A)).symm.toAlgHom.comp
    ((faceZero p).comp (ULift.algEquiv (R := p.A)).toAlgHom)

/-- The second face map, with the common category universe. -/
noncomputable def faceOneLift :
    ULift.{max u v w x, max u w x} (P1 p) →ₐ[p.A]
      ULift.{max u v w x, max u w} p.P0 :=
  (ULift.algEquiv (R := p.A)).symm.toAlgHom.comp
    ((faceOne p).comp (ULift.algEquiv (R := p.A)).toAlgHom)

/-- The degeneracy map, with the common category universe. -/
noncomputable def degeneracyZeroLift :
    ULift.{max u v w x, max u w} p.P0 →ₐ[p.A]
      ULift.{max u v w x, max u w x} (P1 p) :=
  (ULift.algEquiv (R := p.A)).symm.toAlgHom.comp
    ((degeneracyZero p).comp (ULift.algEquiv (R := p.A)).toAlgHom)

/-- The augmentation, with the common category universe. -/
noncomputable def augmentationZeroLift :
    (letI : Algebra p.A p.B := p.algebraMap.toAlgebra
     ULift.{max u v w x, max u w} p.P0 →ₐ[p.A]
       ULift.{max u v w x, v} p.B) := by
  letI : Algebra p.A p.B := p.algebraMap.toAlgebra
  exact (ULift.algEquiv (R := p.A)).symm.toAlgHom.comp
    ((augmentationZeroAlg p).comp (ULift.algEquiv (R := p.A)).toAlgHom)

/-- The explicitly presented one-truncated simplicial algebra, its actual algebraic
one-coskeleton, and the augmented simplicial algebra. The isomorphisms identify
its low-degree terms and structure maps with the polynomial presentation. -/
structure DegreeOneCoskeleton where
  truncated : SimplicialObject.Truncated (AlgCat.{max u v w x} p.A) 1
  simplicial : SimplicialObject (AlgCat.{max u v w x} p.A)
  isCoskeleton : simplicial = (SimplicialObject.Truncated.cosk 1).obj truncated
  augmentation : simplicial ⟶
    (SimplicialObject.const (AlgCat.{max u v w x} p.A)).obj (algB p)
  zeroIso : simplicial _⦋0⦌ ≅ algP0 p
  oneIso : simplicial _⦋1⦌ ≅ algP1 p
  faceZero_eq : oneIso.inv ≫ simplicial.δ (0 : Fin 2) ≫ zeroIso.hom =
    AlgCat.ofHom (faceZeroLift p)
  faceOne_eq : oneIso.inv ≫ simplicial.δ (1 : Fin 2) ≫ zeroIso.hom =
    AlgCat.ofHom (faceOneLift p)
  degeneracyZero_eq : zeroIso.inv ≫ simplicial.σ (0 : Fin 1) ≫ oneIso.hom =
    AlgCat.ofHom (degeneracyZeroLift p)
  augmentation_eq :
    (letI : Algebra p.A p.B := p.algebraMap.toAlgebra
     zeroIso.inv ≫ augmentation.app (op ⦋0⦌) =
       AlgCat.ofHom (augmentationZeroLift p))

/-- The augmentation `P₀ → B` equalizes the two face maps `P₁ ⇉ P₀`. -/
lemma augmentation_comp_faces :
    (letI : Algebra p.A p.B := p.algebraMap.toAlgebra
     (augmentationZeroAlg p).comp (faceZero p) =
       (augmentationZeroAlg p).comp (faceOne p)) := by
  let : Algebra p.A p.B := p.algebraMap.toAlgebra
  apply MvPolynomial.algHom_ext
  intro i
  rcases i with i | t
  · simp [faceZero, faceOne, augmentationZeroAlg]
  · simp [faceZero, faceOne, augmentationZeroAlg, p.presentation.aeval_val_relation]

private lemma faceZero_comp_degeneracyZero (a : p.P0) :
    faceZero p (degeneracyZero p a) = a := by
  have h : (faceZero p).comp (degeneracyZero p) = AlgHom.id p.A p.P0 := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [faceZero, degeneracyZero]
  exact AlgHom.congr_fun h a

private lemma faceOne_comp_degeneracyZero (a : p.P0) :
    faceOne p (degeneracyZero p a) = a := by
  have h : (faceOne p).comp (degeneracyZero p) = AlgHom.id p.A p.P0 := by
    apply MvPolynomial.algHom_ext
    intro i
    simp [faceOne, degeneracyZero]
  exact AlgHom.congr_fun h a

/-- A retraction `F` of the degeneracy gives a retraction of the lifted degeneracy. -/
private lemma ofHom_degeneracyZeroLift_comp_lift (F : P1 p →ₐ[p.A] p.P0)
    (hF : ∀ a, F (degeneracyZero p a) = a) :
    AlgCat.ofHom (degeneracyZeroLift p) ≫
      AlgCat.ofHom ((ULift.algEquiv (R := p.A)).symm.toAlgHom.comp
        (F.comp (ULift.algEquiv (R := p.A)).toAlgHom)) = 𝟙 (algP0 p) := by
  apply AlgCat.hom_ext
  apply AlgHom.ext
  intro z
  cases z with
  | up z =>
      change ULift.up (F (degeneracyZero p z)) = ULift.up z
      rw [hF]

private lemma faceZeroLift_comp_degeneracyZeroLift :
    AlgCat.ofHom (degeneracyZeroLift p) ≫ AlgCat.ofHom (faceZeroLift p) = 𝟙 (algP0 p) :=
  ofHom_degeneracyZeroLift_comp_lift p _ (faceZero_comp_degeneracyZero p)

private lemma faceOneLift_comp_degeneracyZeroLift :
    AlgCat.ofHom (degeneracyZeroLift p) ≫ AlgCat.ofHom (faceOneLift p) = 𝟙 (algP0 p) :=
  ofHom_degeneracyZeroLift_comp_lift p _ (faceOne_comp_degeneracyZero p)

/-- The reflexive graph of bundled `A`-algebras formed by `P₁ ⇉ P₀` with the two face maps and
the common degeneracy. The restriction of an edge to its vertex `i` is the face map that keeps
the vertex `i`: `restrict 0` is the second face map and `restrict 1` the first. -/
@[implicit_reducible]
noncomputable def truncatedData :
    SimplicialObject.OneTruncatedData (AlgCat.{max u v w x} p.A) where
  vertex := algP0 p
  edge := algP1 p
  restrict i := if i = 0 then AlgCat.ofHom (faceOneLift p) else AlgCat.ofHom (faceZeroLift p)
  degeneracy := AlgCat.ofHom (degeneracyZeroLift p)
  degeneracy_comp_restrict i := by
    by_cases h : i = 0
    · rw [ite_eq_left h]
      exact faceOneLift_comp_degeneracyZeroLift p
    · rw [ite_eq_right h]
      exact faceZeroLift_comp_degeneracyZeroLift p

/-- The vertex object of `truncatedData p` is `P₀`. -/
@[simp] lemma truncatedData_vertex : (truncatedData p).vertex = algP0 p := rfl

/-- The edge object of `truncatedData p` is `P₁`. -/
@[simp] lemma truncatedData_edge : (truncatedData p).edge = algP1 p := rfl

/-- The degeneracy of `truncatedData p` is the degeneracy map `P₀ → P₁`. -/
@[simp] lemma truncatedData_degeneracy :
    (truncatedData p).degeneracy = AlgCat.ofHom (degeneracyZeroLift p) := rfl

/-- The one-truncated simplicial algebra `P₁ ⇉ P₀`. -/
noncomputable abbrev degreeOneTruncated :
    SimplicialObject.Truncated (AlgCat.{max u v w x} p.A) 1 :=
  (truncatedData p).toTruncated

/-- The first face of the one-truncated simplicial algebra sends each new variable to zero. -/
@[simp] lemma degreeOneTruncated_map_δ_zero (h₀ : (⦋0⦌ : SimplexCategory).len ≤ 1)
    (h₁ : (⦋1⦌ : SimplexCategory).len ≤ 1) :
    (degreeOneTruncated p).map
        (SimplexCategory.Truncated.Hom.tr (n := 1) (SimplexCategory.δ (0 : Fin 2)) h₀ h₁).op =
      AlgCat.ofHom (faceZeroLift p) := by
  rw [(truncatedData p).toTruncated_map_δ 0 h₀ h₁]
  rfl

/-- The second face of the one-truncated simplicial algebra sends each new variable to its
defining relation. -/
@[simp] lemma degreeOneTruncated_map_δ_one (h₀ : (⦋0⦌ : SimplexCategory).len ≤ 1)
    (h₁ : (⦋1⦌ : SimplexCategory).len ≤ 1) :
    (degreeOneTruncated p).map
        (SimplexCategory.Truncated.Hom.tr (n := 1) (SimplexCategory.δ (1 : Fin 2)) h₀ h₁).op =
      AlgCat.ofHom (faceOneLift p) := by
  rw [(truncatedData p).toTruncated_map_δ 1 h₀ h₁]
  rfl

/-- The degeneracy of the one-truncated simplicial algebra fixes the original variables. -/
@[simp] lemma degreeOneTruncated_map_σ_zero (h₁ : (⦋1⦌ : SimplexCategory).len ≤ 1)
    (h₀ : (⦋0⦌ : SimplexCategory).len ≤ 1) :
    (degreeOneTruncated p).map
        (SimplexCategory.Truncated.Hom.tr (n := 1)
          (SimplexCategory.σ (0 : Fin 1)) h₁ h₀).op =
      AlgCat.ofHom (degeneracyZeroLift p) :=
  (truncatedData p).toTruncated_map_σ h₁ h₀

section Coskeleton

/-- The degree-zero object of the one-truncated simplex category. -/
abbrev degreeOneTruncatedZero : (SimplexCategory.Truncated 1)ᵒᵖ :=
  Opposite.op (⟨SimplexCategory.mk 0, by decide⟩ : SimplexCategory.Truncated 1)

/-- The degree-one object of the one-truncated simplex category. -/
abbrev degreeOneTruncatedOne : (SimplexCategory.Truncated 1)ᵒᵖ :=
  Opposite.op (⟨SimplexCategory.mk 1, by decide⟩ : SimplexCategory.Truncated 1)

/-- The algebraic one-coskeleton of the one-truncated simplicial algebra `P₁ ⇉ P₀`. -/
noncomputable abbrev degreeOneCosk : SimplicialObject (AlgCat.{max u v w x} p.A) :=
  (SimplicialObject.Truncated.cosk 1).obj (degreeOneTruncated p)

/-- The counit of the coskeleton adjunction at the one-truncated simplicial algebra. It is an
isomorphism, which is what identifies the two low degrees of the coskeleton with `P₀` and
`P₁`. -/
noncomputable abbrev degreeOneCounit :
    (SimplicialObject.truncation 1).obj (degreeOneCosk p) ⟶ degreeOneTruncated p :=
  (SimplicialObject.coskAdj (C := AlgCat.{max u v w x} p.A) 1).counit.app
    (degreeOneTruncated p)

/-- The degree-zero term of the coskeleton is `P₀`. The ascribed type is what pins the
spelling of `hom` and `inv`: the counit component's own type is phrased through
`SimplicialObject.truncation`, which does not reduce at `implicit` transparency. -/
noncomputable def degreeOneCoskZeroIso : (degreeOneCosk p).obj (op ⦋0⦌) ≅ algP0 p :=
  (asIso (degreeOneCounit p)).app degreeOneTruncatedZero

/-- The degree-one term of the coskeleton is `P₁`. -/
noncomputable def degreeOneCoskOneIso : (degreeOneCosk p).obj (op ⦋1⦌) ≅ algP1 p :=
  (asIso (degreeOneCounit p)).app degreeOneTruncatedOne

/-- Naturality of the coskeleton counit at a face map of the one-truncated simplex category,
stated through the two identifications. -/
lemma cosk_counit_naturality_δ (i : Fin 2) :
    (degreeOneCosk p).δ i ≫ (degreeOneCoskZeroIso p).hom =
      (degreeOneCoskOneIso p).hom ≫ (degreeOneTruncated p).map
        (SimplexCategory.Truncated.Hom.tr (n := 1) (SimplexCategory.δ i)).op :=
  NatTrans.naturality (degreeOneCounit p)
    (SimplexCategory.Truncated.Hom.tr (n := 1) (SimplexCategory.δ i)).op

/-- Naturality of the coskeleton counit at the degeneracy of the one-truncated simplex
category, stated through the two identifications. -/
lemma cosk_counit_naturality_σ :
    (degreeOneCosk p).σ (0 : Fin 1) ≫ (degreeOneCoskOneIso p).hom =
      (degreeOneCoskZeroIso p).hom ≫ (degreeOneTruncated p).map
        (SimplexCategory.Truncated.Hom.tr (n := 1) (SimplexCategory.σ (0 : Fin 1))).op :=
  NatTrans.naturality (degreeOneCounit p)
    (SimplexCategory.Truncated.Hom.tr (n := 1) (SimplexCategory.σ (0 : Fin 1))).op

/-- The first face of the coskeleton, read through the two identifications. -/
lemma cosk_δ_zero_comp_zeroIso :
    (degreeOneCosk p).δ (0 : Fin 2) ≫ (degreeOneCoskZeroIso p).hom =
      (degreeOneCoskOneIso p).hom ≫ AlgCat.ofHom (faceZeroLift p) := by
  rw [cosk_counit_naturality_δ, degreeOneTruncated_map_δ_zero]

/-- The second face of the coskeleton, read through the two identifications. -/
lemma cosk_δ_one_comp_zeroIso :
    (degreeOneCosk p).δ (1 : Fin 2) ≫ (degreeOneCoskZeroIso p).hom =
      (degreeOneCoskOneIso p).hom ≫ AlgCat.ofHom (faceOneLift p) := by
  rw [cosk_counit_naturality_δ, degreeOneTruncated_map_δ_one]

/-- The degeneracy of the coskeleton, read through the two identifications. -/
lemma cosk_σ_zero_comp_oneIso :
    (degreeOneCosk p).σ (0 : Fin 1) ≫ (degreeOneCoskOneIso p).hom =
      (degreeOneCoskZeroIso p).hom ≫ AlgCat.ofHom (degeneracyZeroLift p) := by
  rw [cosk_counit_naturality_σ, degreeOneTruncated_map_σ_zero]

/-- The two face maps become equal after composing with the augmentation. -/
lemma faceLift_comp_augmentationZeroLift :
    (letI : Algebra p.A p.B := p.algebraMap.toAlgebra
     AlgCat.ofHom (faceZeroLift p) ≫ AlgCat.ofHom (augmentationZeroLift p) =
       AlgCat.ofHom (faceOneLift p) ≫ AlgCat.ofHom (augmentationZeroLift p)) := by
  let : Algebra p.A p.B := p.algebraMap.toAlgebra
  apply AlgCat.hom_ext
  apply AlgHom.ext
  intro z
  cases z with
  | up z =>
      change (ULift.up
          (augmentationZeroAlg p (faceZero p z)) : ULift.{max u v w x, v} p.B) =
        ULift.up (augmentationZeroAlg p (faceOne p z))
      exact congrArg (fun b : p.B => (ULift.up b : ULift.{max u v w x, v} p.B))
        (congrArg (fun f : P1 p →ₐ[p.A] p.B => f z) (augmentation_comp_faces p))

/-- The two faces of the coskeleton agree after composing with the degree-zero
augmentation. -/
lemma cosk_δ_comp_augmentation :
    (letI : Algebra p.A p.B := p.algebraMap.toAlgebra
     (degreeOneCosk p).δ (0 : Fin 2) ≫
         (degreeOneCoskZeroIso p).hom ≫ AlgCat.ofHom (augmentationZeroLift p) =
       (degreeOneCosk p).δ (1 : Fin 2) ≫
         (degreeOneCoskZeroIso p).hom ≫ AlgCat.ofHom (augmentationZeroLift p)) := by
  let : Algebra p.A p.B := p.algebraMap.toAlgebra
  rw [← Category.assoc, ← Category.assoc, cosk_δ_zero_comp_zeroIso, cosk_δ_one_comp_zeroIso,
    Category.assoc, Category.assoc, faceLift_comp_augmentationZeroLift]

/-- The coskeleton of the explicit one-truncated polynomial simplicial algebra. -/
@[stacks 09D4 "degree_one"]
noncomputable def degreeOneCoskeleton : DegreeOneCoskeleton p := by
  classical
  letI : Algebra p.A p.B := p.algebraMap.toAlgebra
  have hε :=
    (SimplicialObject.existsUnique_hom_const_app_zero_eq_iff (degreeOneCosk p) (algB p)
      ((degreeOneCoskZeroIso p).hom ≫
        AlgCat.ofHom (augmentationZeroLift p))).2 (cosk_δ_comp_augmentation p)
  refine
    { truncated := degreeOneTruncated p
      simplicial := degreeOneCosk p
      isCoskeleton := rfl
      augmentation := Classical.choose hε.exists
      zeroIso := degreeOneCoskZeroIso p
      oneIso := degreeOneCoskOneIso p
      faceZero_eq := ?_
      faceOne_eq := ?_
      degeneracyZero_eq := ?_
      augmentation_eq := ?_ }
  · rw [cosk_δ_zero_comp_zeroIso, Iso.inv_hom_id_assoc]
  · rw [cosk_δ_one_comp_zeroIso, Iso.inv_hom_id_assoc]
  · rw [cosk_σ_zero_comp_oneIso, Iso.inv_hom_id_assoc]
  · rw [Classical.choose_spec hε.exists, Iso.inv_hom_id_assoc]

end Coskeleton

private lemma degreeOneUnderlying_isCoskeletal :
    SimplicialObject.IsCoskeletal
      ((degreeOneCoskeleton p).simplicial ⋙ forget (AlgCat.{max u v w x} p.A)) 1 := by
  classical
  let S := (degreeOneCoskeleton p).simplicial
  let L := (SimplexCategory.Truncated.inclusion 1).op
  have hIso : IsIso ((SimplicialObject.coskAdj (C := AlgCat.{max u v w x} p.A) 1).unit.app S) := by
    change IsIso ((SimplicialObject.coskAdj
      (C := AlgCat.{max u v w x} p.A) 1).unit.app
        ((degreeOneCoskeleton p).simplicial))
    rw [(degreeOneCoskeleton p).isCoskeleton]
    exact (SimplicialObject.nonempty_truncCoskAdj_and_isIso_coskAdj_unit_app
      (C := AlgCat.{max u v w x} p.A) (n := 1) (m := 1) (by omega)).2.1
      ((degreeOneCoskeleton p).truncated)
  have hS : S.IsCoskeletal 1 := (SimplicialObject.isCoskeletal_iff_isIso S 1).2 hIso
  let := hS.isRightKanExtension
  let E : Functor.RightExtension L (L ⋙ S) :=
    Functor.RightExtension.mk S (𝟙 (L ⋙ S))
  have hp : E.IsPointwiseRightKanExtension :=
    Functor.isPointwiseRightKanExtensionOfIsRightKanExtension S (𝟙 (L ⋙ S))
  have hp' := hp.postcompose (forget (AlgCat.{max u v w x} p.A))
  exact ⟨(Functor.RightExtension.isPointwiseRightKanExtensionEquivOfIso
    (Functor.RightExtension.postcompose₂ObjMkIso
      (forget (AlgCat.{max u v w x} p.A)) (𝟙 (L ⋙ S))) hp').isRightKanExtension⟩

private noncomputable def extendBoundaryMap (X : SSet)
    [SimplicialObject.IsCoskeletal X 1]
    (n : ℕ) (hn : 1 < n) (α : (∂Δ[n] : SSet) ⟶ X) :
    (Δ[n] : SSet) ⟶ X := by
  haveI : IsIso ((SSet.truncation 1).map (∂Δ[n]).ι) :=
    SSet.isIso_truncation_boundary_ι (by omega)
  let L : (SimplexCategory.Truncated 1)ᵒᵖ ⥤ SimplexCategoryᵒᵖ :=
    (SimplexCategory.Truncated.inclusion 1).op
  let iotaL : L ⋙ (∂Δ[n] : SSet) ⟶ L ⋙ (Δ[n] : SSet) :=
    Functor.whiskerLeft L (∂Δ[n]).ι
  haveI : IsIso iotaL := by
    change IsIso ((SSet.truncation 1).map (∂Δ[n]).ι)
    infer_instance
  letI : X.IsRightKanExtension (𝟙 (L ⋙ X)) := by infer_instance
  let e := asIso iotaL
  let β : L ⋙ (Δ[n] : SSet) ⟶ L ⋙ X := e.inv ≫ Functor.whiskerLeft L α
  exact Functor.liftOfIsRightKanExtension X (𝟙 (L ⋙ X))
    (Δ[n] : SSet) β

private theorem extendBoundaryMap_fac (X : SSet)
    [SimplicialObject.IsCoskeletal X 1]
    (n : ℕ) (hn : 1 < n) (α : (∂Δ[n] : SSet) ⟶ X) :
    (∂Δ[n]).ι ≫ extendBoundaryMap X n hn α = α := by
  let L : (SimplexCategory.Truncated 1)ᵒᵖ ⥤ SimplexCategoryᵒᵖ :=
    (SimplexCategory.Truncated.inclusion 1).op
  let iotaL : L ⋙ (∂Δ[n] : SSet) ⟶ L ⋙ (Δ[n] : SSet) :=
    Functor.whiskerLeft L (∂Δ[n]).ι
  have : IsIso iotaL := by
    change IsIso ((SSet.truncation 1).map (∂Δ[n]).ι)
    exact SSet.isIso_truncation_boundary_ι (by omega)
  apply Functor.hom_ext_of_isRightKanExtension
    (L := L) (F' := X) (α := 𝟙 (L ⋙ X))
  change Functor.whiskerLeft L ((∂Δ[n]).ι ≫ extendBoundaryMap X n hn α) ≫
      𝟙 (L ⋙ X) = Functor.whiskerLeft L α ≫ 𝟙 (L ⋙ X)
  rw [extendBoundaryMap]
  simp only [Functor.whiskerLeft_comp, Category.comp_id]
  have hfac := Functor.liftOfIsRightKanExtension_fac X (𝟙 (L ⋙ X)) (Δ[n])
    ((asIso iotaL).inv ≫ Functor.whiskerLeft L α)
  change iotaL ≫ Functor.whiskerLeft L
      (Functor.liftOfIsRightKanExtension X (𝟙 (L ⋙ X)) (Δ[n])
        ((asIso iotaL).inv ≫ Functor.whiskerLeft L α)) = Functor.whiskerLeft L α
  calc
    iotaL ≫ Functor.whiskerLeft L
        (Functor.liftOfIsRightKanExtension X (𝟙 (L ⋙ X)) (Δ[n])
          ((asIso iotaL).inv ≫ Functor.whiskerLeft L α)) =
        iotaL ≫ ((asIso iotaL).inv ≫ Functor.whiskerLeft L α) := by
          rw [← Functor.whiskerLeft_comp]
          exact congrArg (fun q => iotaL ≫ q) hfac
    _ = Functor.whiskerLeft L α := by
        simp [iotaL]

private theorem degreeOne_liftingProperty_ge_two (n : ℕ) (hn : 2 ≤ n) :
    HasLiftingProperty (∂Δ[n]).ι
      (Functor.whiskerRight (degreeOneCoskeleton p).augmentation
        (forget (AlgCat.{max u v w x} p.A))) := by
  let K := degreeOneCoskeleton p
  let X : SSet := K.simplicial ⋙ forget (AlgCat.{max u v w x} p.A)
  let Y : SSet :=
    ((SimplicialObject.const (AlgCat.{max u v w x} p.A)).obj (algB p)) ⋙
      forget (AlgCat.{max u v w x} p.A)
  let f := Functor.whiskerRight K.augmentation (forget (AlgCat.{max u v w x} p.A))
  let : X.IsCoskeletal 1 := degreeOneUnderlying_isCoskeletal p
  constructor
  intro α β sq
  let γ := extendBoundaryMap X n (by omega) α
  have hleft : (∂Δ[n]).ι ≫ γ = α := extendBoundaryMap_fac X n (by omega) α
  refine ⟨⟨⟨γ, hleft, ?_⟩⟩⟩
  apply SSet.yonedaEquiv.injective
  let v : ⦋0⦌ ⟶ ⦋n⦌ := SimplexCategory.const _ _ 0
  have hvtop : (∂Δ[n]).obj (Opposite.op ⦋0⦌) = ⊤ :=
    SSet.boundary_obj_eq_top (by simp; omega)
  let vb : (∂Δ[n]).obj (Opposite.op ⦋0⦌) := by
    rw [hvtop]
    exact ⟨SSet.stdSimplex.objEquiv.symm v, trivial⟩
  have hv : (∂Δ[n]).ι.app (Opposite.op ⦋0⦌) vb =
      SSet.yonedaEquiv.{max u v w x} (SSet.stdSimplex.{max u v w x}.map v) := by
    apply SSet.stdSimplex.objEquiv.injective
    calc
      SSet.stdSimplex.objEquiv ((∂Δ[n]).ι.app (Opposite.op ⦋0⦌) vb) = v := by
        simp [vb, hvtop]
      _ = SSet.stdSimplex.objEquiv
        (SSet.yonedaEquiv.{max u v w x} (SSet.stdSimplex.{max u v w x}.map v)) := rfl
  have hval := congrArg (fun q => q.app (Opposite.op ⦋0⦌) vb) sq.w
  have hval' : Y.map v.op (SSet.yonedaEquiv (γ ≫ f)) =
      Y.map v.op (SSet.yonedaEquiv β) := by
    have hv' : f.app (Opposite.op ⦋0⦌)
          (γ.app (Opposite.op ⦋0⦌)
            (SSet.yonedaEquiv.{max u v w x} (SSet.stdSimplex.{max u v w x}.map v))) =
        β.app (Opposite.op ⦋0⦌)
          (SSet.yonedaEquiv.{max u v w x} (SSet.stdSimplex.{max u v w x}.map v)) := by
      rw [← hleft] at hval
      change f.app (Opposite.op ⦋0⦌)
          (γ.app (Opposite.op ⦋0⦌)
            ((∂Δ[n]).ι.app (Opposite.op ⦋0⦌) vb)) =
        β.app (Opposite.op ⦋0⦌)
          ((∂Δ[n]).ι.app (Opposite.op ⦋0⦌) vb) at hval
      rw [hv] at hval
      exact hval
    calc
      Y.map v.op (SSet.yonedaEquiv (γ ≫ f)) =
          f.app (Opposite.op ⦋0⦌)
            (γ.app (Opposite.op ⦋0⦌)
              (SSet.yonedaEquiv.{max u v w x}
                (SSet.stdSimplex.{max u v w x}.map v))) := by
          rw [SSet.yonedaEquiv_naturality, SSet.yonedaEquiv_comp]
          rfl
      _ = β.app (Opposite.op ⦋0⦌)
          (SSet.yonedaEquiv.{max u v w x}
            (SSet.stdSimplex.{max u v w x}.map v)) := hv'
      _ = Y.map v.op (SSet.yonedaEquiv β) := by
          rw [SSet.yonedaEquiv_naturality, SSet.yonedaEquiv_comp]
  simpa [Y] using hval'

private lemma degreeOneAugmentation_app_zero (x :
    ((degreeOneCoskeleton p).simplicial ⋙ forget (AlgCat.{max u v w x} p.A)) _⦋0⦌) :
    (Functor.whiskerRight (degreeOneCoskeleton p).augmentation
      (forget (AlgCat.{max u v w x} p.A))).app (Opposite.op ⦋0⦌) x =
        ULift.up (augmentationZero p
          (ULift.down ((degreeOneCoskeleton p).zeroIso.hom.hom x))) := by
  let K := degreeOneCoskeleton p
  let : Algebra p.A p.B := p.algebraMap.toAlgebra
  change (K.augmentation.app (Opposite.op ⦋0⦌)).hom x =
    ULift.up (augmentationZero p (ULift.down (K.zeroIso.hom.hom x)))
  have hcomp : K.augmentation.app (Opposite.op ⦋0⦌) =
      K.zeroIso.hom ≫ AlgCat.ofHom (augmentationZeroLift p) :=
    (Iso.inv_comp_eq _).1 K.augmentation_eq
  have h : (K.augmentation.app (Opposite.op ⦋0⦌)).hom x =
      (augmentationZeroLift p) (K.zeroIso.hom.hom x) :=
    congrArg (fun f => f.hom x) hcomp
  rw [h]
  change (ULift.algEquiv (R := p.A)).symm
      ((augmentationZeroAlg p) (ULift.down (K.zeroIso.hom.hom x))) = _
  rfl

/-- Exactness at `P₀` of `P₁ → P₀ → B`. -/
@[stacks 09D4 "degree_one"]
theorem range_faceZero_sub_faceOne :
    Set.range (fun z : P1 p => faceZero p z - faceOne p z) =
      {z : p.P0 | augmentationZero p z = 0} := by
  let : Algebra p.A p.B := p.algebraMap.toAlgebra
  refine Set.ext fun z => ⟨?_, fun hz => ?_⟩
  · rintro ⟨q, rfl⟩
    change (augmentationZeroAlg p).toRingHom (faceZero p q - faceOne p q) = 0
    rw [map_sub]
    exact sub_eq_zero.mpr (AlgHom.congr_fun (augmentation_comp_faces p) q)
  have hker : RingHom.ker (augmentationZero p) =
      Ideal.span (Set.range p.presentation.relation) := by
    change RingHom.ker (MvPolynomial.aeval p.presentation.val) = _
    exact p.presentation.ker_eq_ker_aeval_val.symm.trans
      p.presentation.span_range_relation_eq_ker.symm
  have hz' : z ∈ Ideal.span (Set.range p.presentation.relation) := by
    rwa [← hker, RingHom.mem_ker]
  obtain ⟨c, hc⟩ := Finsupp.mem_ideal_span_range_iff_exists_finsupp.mp hz'
  refine ⟨c.sum (fun t a => -(degeneracyZero p a * MvPolynomial.X (Sum.inr t))), ?_⟩
  dsimp only
  rw [show faceZero p (c.sum fun t a => -(degeneracyZero p a *
      MvPolynomial.X (Sum.inr t))) = 0 by
        simp only [Finsupp.sum, map_sum, map_neg, map_mul]
        simp [faceZero, degeneracyZero]]
  rw [show faceOne p (c.sum fun t a => -(degeneracyZero p a *
      MvPolynomial.X (Sum.inr t))) = -z by
    have hterm (t : p.relationIndex) (a : p.P0) :
        faceOne p (-(degeneracyZero p a * MvPolynomial.X (Sum.inr t))) =
          -(a * p.presentation.relation t) := by
      rw [map_neg, map_mul, faceOne_comp_degeneracyZero, faceOne, MvPolynomial.aeval_X]
      rfl
    simp only [Finsupp.sum, map_sum]
    calc
      (∑ t ∈ c.support, faceOne p
          (-(degeneracyZero p (c t) * MvPolynomial.X (Sum.inr t)))) =
          ∑ t ∈ c.support, -(c t * p.presentation.relation t) :=
        Finset.sum_congr rfl fun t _ => hterm t (c t)
      _ = -(c.sum fun t a => a * p.presentation.relation t) := by
        simp only [Finsupp.sum, Finset.sum_neg_distrib]
      _ = -z := by rw [hc]]
  simp

/-- Every compatible pair of degree-zero simplices lifts to degree one. -/
@[stacks 09D4 "degree_one"]
theorem facePair_surjective :
    ∀ a b : p.P0,
      augmentationZero p a = augmentationZero p b →
        ∃ z : P1 p, faceZero p z = a ∧ faceOne p z = b := by
  let : Algebra p.A p.B := p.algebraMap.toAlgebra
  intro a b hab
  have hmem : a - b ∈ {z : p.P0 | augmentationZero p z = 0} := by
    change augmentationZero p (a - b) = 0
    rw [map_sub, hab, sub_self]
  obtain ⟨q, hq⟩ := (range_faceZero_sub_faceOne p).symm ▸ hmem
  refine ⟨degeneracyZero p (a - faceZero p q) + q, ?_, ?_⟩
  · simp [faceZero_comp_degeneracyZero]
  · have hq' : faceZero p q - faceOne p q = a - b := hq
    rw [map_add, faceOne_comp_degeneracyZero]
    calc
      a - faceZero p q + faceOne p q = a - (faceZero p q - faceOne p q) := by abel
      _ = a - (a - b) := by rw [hq']
      _ = b := by abel

private theorem degreeOne_liftingProperty_one :
    HasLiftingProperty (∂Δ[1]).ι
      (Functor.whiskerRight (degreeOneCoskeleton p).augmentation
        (forget (AlgCat.{max u v w x} p.A))) := by
  let K := degreeOneCoskeleton p
  let X : SSet := K.simplicial ⋙ forget (AlgCat.{max u v w x} p.A)
  let Y : SSet :=
    ((SimplicialObject.const (AlgCat.{max u v w x} p.A)).obj (algB p)) ⋙
      forget (AlgCat.{max u v w x} p.A)
  let f := Functor.whiskerRight K.augmentation (forget (AlgCat.{max u v w x} p.A))
  constructor
  intro α β sq
  let x0 := SSet.yonedaEquiv ((SSet.boundary.ι (1 : Fin 2)) ≫ α)
  let x1 := SSet.yonedaEquiv ((SSet.boundary.ι (0 : Fin 2)) ≫ α)
  let a := ULift.down (K.zeroIso.hom.hom x1)
  let b := ULift.down (K.zeroIso.hom.hom x0)
  let : Algebra p.A p.B := p.algebraMap.toAlgebra
  have hface (i : Fin 2) :
      f.app (Opposite.op ⦋0⦌) (SSet.yonedaEquiv (SSet.boundary.ι i ≫ α)) =
        SSet.yonedaEquiv β := by
    have hm : SSet.boundary.ι i ≫ α ≫ f = SSet.boundary.ι i ≫ (∂Δ[1]).ι ≫ β := by
      simpa only [Category.assoc] using congrArg (fun g => SSet.boundary.ι i ≫ g) sq.w
    calc
      f.app (Opposite.op ⦋0⦌) (SSet.yonedaEquiv (SSet.boundary.ι i ≫ α)) =
          SSet.yonedaEquiv (SSet.boundary.ι i ≫ α ≫ f) := rfl
      _ = SSet.yonedaEquiv (SSet.boundary.ι i ≫ (∂Δ[1]).ι ≫ β) := congrArg _ hm
      _ = SSet.yonedaEquiv β := by
        change SSet.yonedaEquiv (SSet.stdSimplex.map (SimplexCategory.δ i) ≫ β) = _
        rw [← SSet.yonedaEquiv_naturality]
        change Y.map (SimplexCategory.δ i).op (SSet.yonedaEquiv β) = _
        rfl
  have hab : augmentationZero p a = augmentationZero p b :=
    congrArg ULift.down (((hface 0).symm.trans (degreeOneAugmentation_app_zero p x1)).symm.trans
      ((hface 1).symm.trans (degreeOneAugmentation_app_zero p x0)))
  obtain ⟨q, hq0, hq1⟩ := facePair_surjective p a b hab
  let z := K.oneIso.inv.hom (ULift.up q)
  let γ : (Δ[1] : SSet) ⟶ X := SSet.yonedaEquiv.symm z
  have hδ (i : Fin 2) (F : P1 p →ₐ[p.A] p.P0) (y : X _⦋0⦌)
      (hF : K.oneIso.inv ≫ K.simplicial.δ i ≫ K.zeroIso.hom =
        AlgCat.ofHom ((ULift.algEquiv (R := p.A)).symm.toAlgHom.comp
          (F.comp (ULift.algEquiv (R := p.A)).toAlgHom)))
      (hq : F q = ULift.down (K.zeroIso.hom.hom y)) : X.δ i z = y := by
    apply (ConcreteCategory.bijective_of_isIso K.zeroIso.hom).injective
    have hh : K.zeroIso.hom.hom (X.δ i z) = (ULift.algEquiv (R := p.A)).symm (F q) := by
      simpa [z, X] using congrArg (fun g => g (ULift.up q)) hF
    exact hh.trans (by rw [hq]; rfl)
  have hδ0 : X.δ (0 : Fin 2) z = x1 := hδ 0 _ x1 K.faceZero_eq hq0
  have hδ1 : X.δ (1 : Fin 2) z = x0 := hδ 1 _ x0 K.faceOne_eq hq1
  refine ⟨⟨⟨γ, ?_, ?_⟩⟩⟩
  · apply SSet.boundary.hom_ext
    intro i
    apply SSet.yonedaEquiv.injective
    fin_cases i
    · change SSet.yonedaEquiv (SSet.stdSimplex.δ 0 ≫ γ) =
        SSet.yonedaEquiv (SSet.boundary.ι (0 : Fin 2) ≫ α)
      rw [SSet.stdSimplex.yonedaEquiv_δ_comp γ 0]
      simpa [x1, γ] using hδ0
    · change SSet.yonedaEquiv (SSet.stdSimplex.δ 1 ≫ γ) =
        SSet.yonedaEquiv (SSet.boundary.ι (1 : Fin 2) ≫ α)
      rw [SSet.stdSimplex.yonedaEquiv_δ_comp γ 1]
      simpa [x0, γ] using hδ1
  · apply SSet.yonedaEquiv.injective
    rw [SSet.yonedaEquiv_comp]
    change f.app (Opposite.op ⦋1⦌)
      (SSet.yonedaEquiv (SSet.yonedaEquiv.symm z)) = SSet.yonedaEquiv β
    rw [Equiv.apply_symm_apply]
    have hn := congrArg (fun g => g z)
      (NatTrans.naturality f ((SimplexCategory.δ (0 : Fin 2)).op))
    have hx : K.simplicial.map ((SimplexCategory.δ (0 : Fin 2)).op) z = x1 := hδ0
    have hstep : f.app (Opposite.op ⦋1⦌) z = f.app (Opposite.op ⦋0⦌) x1 := by
      simpa [X, Y, hx] using hn.symm
    exact hstep.trans (hface 0)

/-- The augmentation of this degree-one coskeleton is a trivial Kan fibration. -/
@[stacks 09D4 "degree_one"]
theorem coskeleton_trivialKanFibration :
    SSet.trivialKanFibrations
      (Functor.whiskerRight (degreeOneCoskeleton p).augmentation
        (forget (AlgCat.{max u v w x} p.A))) := by
  let : Algebra p.A p.B := p.algebraMap.toAlgebra
  rw [SSet.trivialKanFibrations_iff_surjective_and_hasLiftingProperty]
  refine ⟨?_, ?_⟩
  · let K := degreeOneCoskeleton p
    let f := Functor.whiskerRight K.augmentation (forget (AlgCat.{max u v w x} p.A))
    intro y
    obtain ⟨q, hq⟩ := p.presentation.toGenerators.aeval_val_surjective y.down
    let z := K.zeroIso.inv.hom (ULift.up q)
    refine ⟨z, ?_⟩
    have hz := degreeOneAugmentation_app_zero p z
    apply ULift.ext
    simpa [z, K, f, hq, augmentationZero, augmentationZeroAlg] using
      congrArg ULift.down hz
  · intro n hn
    obtain rfl | h := eq_or_ne n 1
    · exact degreeOne_liftingProperty_one p
    · exact degreeOne_liftingProperty_ge_two p n (by omega)

end Algebra.PolynomialPresentationWithKernelGenerators.DegreeOne

