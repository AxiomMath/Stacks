module

public import StacksFrontier.AlgebraicGeometry.Spaces.Topologies.BigPhSite
public import StacksFrontier.CategoryTheory.Sites.Hypercovering.MorphismProperty
public import
  StacksFrontier.CategoryTheory.Sites.Simplicial.HypercoveringBySimplicialObjectSpectralSequence

/-!
# The ph cohomology spectral sequence of a ph hypercovering of algebraic spaces

Let `S` be a scheme, let `(Spaces/S)_ph` be a big ph site of algebraic spaces over `S`, and let
`a : U ⟶ X` be an augmented simplicial algebraic space over `S` which is a *ph hypercovering*:
the augmentation `U₀ ⟶ X`, the canonical morphism `U₁ ⟶ U₀ ×_X U₀` and the matching morphisms
`U_{n+1} ⟶ (cosk_n sk_n U)_{n+1}` are ph coverings. Then `a` is a hypercovering of `X` in the
site `(Spaces/S)_ph` in the sense of Stacks 09X8, and for every abelian sheaf `𝒢` on
`(Spaces/X)_ph` the spectral sequence of the hypercovering

`E₁^{p,q} = H^q((Spaces/U_p)_ph, a_p⁻¹𝒢) ⇒ H^{p+q}((Spaces/X)_ph, 𝒢)`

exists. This is the ph descent half of the proof of Stacks 0DHP: combined with the comparison
of étale and ph cohomology of torsion sheaves (Stacks 0DGV) on `X` and on every `U_p`, it gives
the étale cohomology spectral sequence of a ph hypercovering.

## Main definitions

* `AlgebraicGeometry.BigPHSpaceSite.IsPHCoveringMorphism`: the morphisms `f : X ⟶ Y` of
  algebraic spaces for which `{f}` is a ph covering (Stacks 0DFG).
* `AlgebraicGeometry.BigPHSpaceSite.phHypercoveringSpectralSequence`: the spectral sequence, as
  a functor of the abelian sheaf `𝒢`.

## Main results

* `AlgebraicGeometry.BigPHSpaceSite.singleton_mem_toPretopology`: a ph covering `{f}` is a
  covering of the big ph site.
* `AlgebraicGeometry.BigPHSpaceSite.isHypercoveringAugmentation_of_isHypercovering`: a ph
  hypercovering is a hypercovering of `X` in `(Spaces/S)_ph` in the sense of Stacks 09X8.
* `AlgebraicGeometry.BigPHSpaceSite.phHypercoveringSpectralSequence_pageOneIso`: the first page.
* `AlgebraicGeometry.BigPHSpaceSite.phHypercoveringSpectralSequence_abutsTo`: the abutment
  `H^{p+q}((Spaces/X)_ph, 𝒢)`.

## Implementation notes

The site in which the descent is carried out is the one generated by the pretopology
`T.topology.toPretopology` of presieves generating a covering sieve of the big ph topology. It
is the big ph topology itself, `toGrothendieck_toPretopology`; the pretopology is what the
hypercovering conditions of Stacks 09X8 are stated with.

## References

* [Stacks Project, Tag 0DHP](https://stacks.math.columbia.edu/tag/0DHP)
* [Stacks Project, Tag 0DFG](https://stacks.math.columbia.edu/tag/0DFG)
* [Stacks Project, Tag 0DFK](https://stacks.math.columbia.edu/tag/0DFK)
* [Stacks Project, Tag 09X8](https://stacks.math.columbia.edu/tag/09X8)
* [Stacks Project, Tag 09WJ](https://stacks.math.columbia.edu/tag/09WJ)
* [Stacks Project, Tag 09X9](https://stacks.math.columbia.edu/tag/09X9)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite Stacks.CategoryTheory.Hypercovering

universe u v w

namespace AlgebraicGeometry

namespace Space

variable (B : BigFppfSite.{u}) (S : Scheme.{u}) (hS : B.Contains S)

/-- Whether a single morphism `f`, regarded as a one-member family, is a ph covering does not
depend on the universe of the one-point index type. -/
theorem IsPHCovering.punit {X Y : (BigFppfOver B S hS)ᵒᵖ ⥤ Type u} {f : X ⟶ Y}
    (hf : IsPHCovering.{u, v} B S hS (fun _ : PUnit.{v + 1} ↦ X) (fun _ ↦ f)) :
    IsPHCovering.{u, w} B S hS (fun _ : PUnit.{w + 1} ↦ X) (fun _ ↦ f) := by
  refine ⟨hf.target_isAlgebraicSpace, fun _ ↦ hf.source_isAlgebraicSpace PUnit.unit,
    fun _ ↦ hf.locallyOfFiniteType PUnit.unit, fun U _ a ↦ ?_⟩
  obtain ⟨E, hE, ⟨φ⟩⟩ := hf.affine_refinement U a
  exact ⟨E, hE, ⟨⟨fun _ ↦ PUnit.unit, φ.h₀, φ.w₀⟩⟩⟩

end Space

namespace BigPHSpaceSite

variable {S : Scheme.{u}} (T : BigPHSpaceSite S)

/-- A morphism `f : X ⟶ Y` of algebraic spaces over `S` is a *ph covering morphism* when the
one-member family `{f : X ⟶ Y}` is a ph covering in the sense of Stacks 0DFG. -/
def IsPHCoveringMorphism : MorphismProperty T.Spaces := fun X _ f ↦
  Space.IsPHCovering T.fppfSite S T.fppf_mem (fun _ : PUnit.{u + 1} ↦ X.1) (fun _ ↦ f.hom)

/-- The big ph topology is the topology generated by its own pretopology of presieves which
generate covering sieves. -/
theorem toGrothendieck_toPretopology :
    T.topology.toPretopology.toGrothendieck = T.topology :=
  (Pretopology.gi T.Spaces).l_u_eq T.topology

variable {T} in
/-- **A ph covering `{f}` is a covering of the big ph site.** The one-member family `{f}` is a
ph covering family, so by the choice of the big ph site it is combinatorially equivalent to one
of the chosen bounded coverings; the two generate the same presieve, which therefore lies in the
precoverage generating the big ph topology. -/
theorem singleton_mem_toPretopology {X Y : T.Spaces} {f : X ⟶ Y}
    (hf : T.IsPHCoveringMorphism f) :
    Presieve.singleton f ∈ T.topology.toPretopology Y := by
  let E : Covering T.Spaces := ⟨Y, PreZeroHypercover.singleton f⟩
  obtain ⟨⟨Y', E'⟩, hE', h, hc⟩ :=
    T.covering_representative E (Space.IsPHCovering.punit _ _ _ hf)
  change Y = Y' at h
  subst h
  exact (GrothendieckTopology.mem_toPretopology _ T.topology (Presieve.singleton f)).2
    (Precoverage.generate_mem_toGrothendieck (T.mem_precoverage_iff.2 ⟨E', by
      rw [← PreZeroHypercover.presieve₀_singleton,
        PreZeroHypercover.presieve₀_eq_of_combinatoriallyEquivalent hc], hE'⟩))

variable {T} in
/-- **A ph hypercovering is a hypercovering in the big ph site.** An augmented simplicial
algebraic space whose degree-zero augmentation, canonical morphism `U₁ ⟶ U₀ ×_X U₀` and higher
matching morphisms are ph covering morphisms is a hypercovering of `X` in `(Spaces/S)_ph` in the
sense of Stacks 09X8. -/
theorem isHypercoveringAugmentation_of_isHypercovering
    {A : SimplicialObject.Augmented T.Spaces}
    (hA : MorphismProperty.IsHypercovering T.IsPHCoveringMorphism A) :
    IsHypercoveringAugmentation T.topology.toPretopology A.left A.hom :=
  ⟨singleton_mem_toPretopology hA.map_zero, singleton_mem_toPretopology hA.map_one,
    fun n hn ↦ singleton_mem_toPretopology (hA.matching n hn)⟩

/-- The site `(Spaces/X)_ph` in which ph descent along an augmented simplicial algebraic space
`U ⟶ X` is carried out: the big ph topology localized at `X`, presented through its pretopology
(see `toGrothendieck_toPretopology`). -/
abbrev phTopologyOver (X : T.Spaces) : GrothendieckTopology (Over X) :=
  T.topology.toPretopology.toGrothendieck.over X

/-- **The ph cohomology spectral sequence of an augmented simplicial algebraic space**, as a
functor of the abelian sheaf `𝒢` on `(Spaces/X)_ph`: the spectral sequence of Stacks 09WJ of
the total ph site `(Spaces/U)_{ph,total}` at `a⁻¹𝒢`. -/
abbrev phHypercoveringSpectralSequence (A : SimplicialObject.Augmented T.Spaces) :
    Sheaf (T.phTopologyOver A.right) AddCommGrpCat.{u + 1} ⥤
      CohomologicalSpectralSequence AddCommGrpCat.{u + 1} 1 :=
  SimplicialSemiRepresentable.hypercoveringSpectralSequence T.topology.toPretopology A.left A.hom

/-- **`E₁^{p,q} = H^q((Spaces/U_p)_ph, a_p⁻¹𝒢)`**, naturally in `𝒢`. -/
def phHypercoveringSpectralSequence_pageOneIso (A : SimplicialObject.Augmented T.Spaces)
    (p q : ℕ) :
    T.phHypercoveringSpectralSequence A ⋙
        CategoryTheory.SpectralSequence.pageFunctor AddCommGrpCat.{u + 1} _ 1 1 le_rfl ⋙
          HomologicalComplex.eval AddCommGrpCat.{u + 1} _ ((p : ℤ), (q : ℤ)) ≅
      SimplicialSemiRepresentable.hypercoveringComponentInverseImage
          T.topology.toPretopology A.left A.hom p ⋙
        (Sheaf.Γ ((SimplicialSemiRepresentable.totalSituation T.topology.toPretopology A.left
          A.hom).componentTopology (SimplexCategory.mk p)) AddCommGrpCat.{u + 1}).rightDerived q :=
  SimplicialSemiRepresentable.hypercoveringSpectralSequence_pageOneIso _ _ _ p q

/-- **The ph cohomology spectral sequence of a ph hypercovering abuts to
`H^{p+q}((Spaces/X)_ph, 𝒢)`.** This is ph descent for the hypercovering: Stacks 09X9 in the big
ph site, applied through `isHypercoveringAugmentation_of_isHypercovering`. -/
theorem phHypercoveringSpectralSequence_abutsTo {A : SimplicialObject.Augmented T.Spaces}
    (hA : MorphismProperty.IsHypercovering T.IsPHCoveringMorphism A)
    (G : Sheaf (T.phTopologyOver A.right) AddCommGrpCat.{u + 1}) :
    CategoryTheory.SpectralSequence.AbutsTo ((T.phHypercoveringSpectralSequence A).obj G)
      (SimplicialSemiRepresentable.baseCohomology T.topology.toPretopology G) :=
  SimplicialSemiRepresentable.hypercoveringSpectralSequence_abutsTo _ _ _
    (isHypercoveringAugmentation_of_isHypercovering hA) G

end BigPHSpaceSite

end AlgebraicGeometry

end
