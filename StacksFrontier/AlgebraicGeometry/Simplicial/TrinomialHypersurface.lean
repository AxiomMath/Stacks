/-!
# Factorial trinomial hypersurfaces

For pairwise coprime positive exponents `r`, `s`, `t`, the hypersurface in affine three-space
over a field defined by `x ^ r + y ^ s + z ^ t` is factorial: its coordinate ring is a unique
factorization domain. When `t = 1 + e * r * s` the localization at the coordinate `z` has an
explicit presentation as a localization of a polynomial ring in two variables.

The defining trinomial is irreducible because, after swapping `x` and `z`, it becomes a monic
polynomial in one variable over the two-variable polynomial ring whose constant term generates
a prime ideal, so the Eisenstein criterion applies; this also shows that each of the three
coordinates generates a prime ideal of the quotient. For factoriality one inverts all three
coordinates. Choosing integers `a`, `b`, `c` with `a * s * t + b * r * t + c * r * s = 1`, the
Laurent monomials `u = x ^ r / z ^ t`, `v = y ^ s / z ^ t` and `w = x ^ a * y ^ b * z ^ c` form
a coordinate system in which the defining equation reads `u + v + 1 = 0`, so that total
localization is a polynomial ring in `u` and `w` localized at `u * (-1 - u) * w`, which is a
unique factorization domain. Nagata's criterion for the submonoid generated by the three prime
coordinates then gives factoriality of the hypersurface itself.

## Main definitions

* `Stacks.Resolution.trinomialRing`: the coordinate ring of the trinomial hypersurface.

## Main results

* `Stacks.Resolution.trinomial_irreducible`: the defining trinomial is irreducible.
* `Stacks.Resolution.trinomialRing_isDomain`: the hypersurface is integral.
* `Stacks.Resolution.trinomialRing_z_isPrime`: the coordinate `z` generates a prime ideal.
* `Stacks.Resolution.trinomialRing_localization_equiv`: the explicit presentation of the
  localization at `z` when `t = 1 + e * r * s`.
* `Stacks.Resolution.trinomialRing_localization_uniqueFactorizationMonoid`: that localization is
  factorial.
* `Stacks.Resolution.trinomialRing_uniqueFactorizationMonoid`: the hypersurface is factorial.

## Implementation notes

The variables are indexed by `Fin 3`, with `x`, `y` and `z` at indices `0`, `1` and `2`. The
localized presentation uses `Fin 2` for `x'` and `y'`; its three coordinate equations specify
the canonical isomorphism and imply the formulas `x' = x / z ^ (e * s)` and
`y' = y / z ^ (e * r)`.

Factoriality of a polynomial ring over a field is Mathlib's
`MvPolynomial.uniqueFactorizationMonoid`, and Nagata's criterion is `nagata_criterion` with the
hypothesis `GenByPrimes`.

## References

* [Stacks Project, Tag 0AE9](https://stacks.math.columbia.edu/tag/0AE9)
-/

@[expose] public section

namespace Stacks.Resolution

universe u

/-- The coordinate ring of the trinomial hypersurface `x ^ r + y ^ s + z ^ t = 0` in affine
three-space over `k`. -/
abbrev trinomialRing (k : Type u) [CommRing k] (r s t : ℕ) :=
  MvPolynomial (Fin 3) k ⧸
    Ideal.span ({MvPolynomial.X (0 : Fin 3) ^ r +
      MvPolynomial.X (1 : Fin 3) ^ s +
      MvPolynomial.X (2 : Fin 3) ^ t} : Set (MvPolynomial (Fin 3) k))

private lemma polynomial_binomial_irreducible_of_odd (k : Type*) [Field k]
    (r s : ℕ) (hr : Odd r) (hrs : r.Coprime s) :
    Irreducible (Polynomial.X ^ r + Polynomial.C (Polynomial.X ^ s) :
      Polynomial (Polynomial k)) := by
  have hm : (Polynomial.X ^ r + Polynomial.C (Polynomial.X ^ s) :
      Polynomial (Polynomial k)).Monic := by
    simpa only [sub_neg_eq_add, map_neg, neg_neg] using
      Polynomial.monic_X_pow_sub_C (-(Polynomial.X ^ s : Polynomial k)) hr.pos.ne'
  apply hm.isPrimitive.irreducible_of_irreducible_map_of_injective
    (IsFractionRing.injective (Polynomial k) (RatFunc k))
  rw [Polynomial.map_add, Polynomial.map_pow, Polynomial.map_X, Polynomial.map_C,
    map_pow, RatFunc.algebraMap_X, ← sub_neg_eq_add, ← map_neg]
  apply X_pow_sub_C_irreducible_of_odd hr
  intro p hp hpr b hb
  have hd := congrArg RatFunc.intDegree hb
  rw [ratFunc_intDegree_pow b p, RatFunc.intDegree_neg,
    ratFunc_intDegree_pow RatFunc.X s, RatFunc.intDegree_X, mul_one] at hd
  have hps : p ∣ s := Int.natCast_dvd_natCast.mp ⟨b.intDegree, hd.symm⟩
  exact hp.not_dvd_one ((hrs.of_dvd_left hpr).dvd_of_dvd_mul_right (by simpa using hps))

private lemma mvPolynomial_binomial_irreducible_of_odd (k : Type*) [Field k]
    (r s : ℕ) (hr : Odd r) (hrs : r.Coprime s) :
    Irreducible (MvPolynomial.X (0 : Fin 2) ^ r + MvPolynomial.X (1 : Fin 2) ^ s :
      MvPolynomial (Fin 2) k) := by
  let E := (MvPolynomial.finSuccEquiv k 1).toRingEquiv.trans
    (Polynomial.mapEquiv (MvPolynomial.uniqueAlgEquiv k (Fin 1)).toRingEquiv)
  have h1 : MvPolynomial.finSuccEquiv k 1 (MvPolynomial.X (1 : Fin 2)) =
      Polynomial.C (MvPolynomial.X (0 : Fin 1)) :=
    MvPolynomial.finSuccEquiv_X_succ (j := 0)
  have hE0 : E (MvPolynomial.X 0) = Polynomial.X := by
    simp [E, MvPolynomial.finSuccEquiv_X_zero]
  have hE1 : E (MvPolynomial.X 1) = Polynomial.C Polynomial.X := by
    simp [E, h1, MvPolynomial.uniqueAlgEquiv_apply]
  apply (MulEquiv.irreducible_iff E).mp
  simpa only [map_add, map_pow, hE0, hE1] using
    polynomial_binomial_irreducible_of_odd k r s hr hrs

private lemma mvPolynomial_binomial_irreducible (k : Type*) [Field k]
    (r s : ℕ) (hrs : r.Coprime s) :
    Irreducible (MvPolynomial.X (0 : Fin 2) ^ r + MvPolynomial.X (1 : Fin 2) ^ s :
      MvPolynomial (Fin 2) k) := by
  rcases Nat.even_or_odd r with hr | hr
  · have hs : Odd s := Nat.not_even_iff_odd.mp fun hs => by
      simpa [hrs.gcd_eq_one] using Nat.dvd_gcd hr.two_dvd hs.two_dvd
    simpa [MvPolynomial.renameEquiv, add_comm] using
      (mvPolynomial_binomial_irreducible_of_odd k s r hs hrs.symm).map
        (MvPolynomial.renameEquiv k (Equiv.swap (0 : Fin 2) 1))
  · exact mvPolynomial_binomial_irreducible_of_odd k r s hr hrs

private lemma polynomial_X_pow_add_C_irreducible {R : Type*} [CommRing R]
    [IsDomain R] {a : R} (ha : Prime a) (n : ℕ) (hn : 0 < n) :
    Irreducible (Polynomial.X ^ n + Polynomial.C a : Polynomial R) := by
  have hm : (Polynomial.X ^ n + Polynomial.C a : Polynomial R).Monic := by
    simpa using Polynomial.monic_X_pow_sub_C (-a) (Nat.ne_of_gt hn)
  have hd : (Polynomial.X ^ n + Polynomial.C a : Polynomial R).degree = n := by
    simpa using Polynomial.degree_X_pow_sub_C hn (-a)
  apply Polynomial.irreducible_of_eisenstein_criterion
    ((Ideal.span_singleton_prime ha.ne_zero).mpr ha)
  · rw [hm.leadingCoeff]
    simpa only [Ideal.mem_span_singleton, ← isUnit_iff_dvd_one] using ha.not_isUnit
  · intro j hj
    rw [hd] at hj
    have hjn : j ≠ n := by exact_mod_cast ne_of_lt hj
    simp only [Polynomial.coeff_add, Polynomial.coeff_X_pow, ite_eq_right hjn,
      zero_add, Polynomial.coeff_C]
    split_ifs <;> simp
  · rw [hd]
    exact_mod_cast hn
  · simp only [Polynomial.coeff_add, Polynomial.coeff_X_pow, ite_eq_right (Nat.ne_of_gt hn).symm,
      zero_add, Polynomial.coeff_C_zero, Ideal.span_singleton_pow, Ideal.mem_span_singleton]
    intro h
    have h' : a ^ 2 ∣ a ^ 1 := by simpa using h
    have := (pow_dvd_pow_iff ha.ne_zero ha.not_isUnit).mp h'
    omega
  · exact hm.isPrimitive

private lemma finSuccEquiv_X_one (k : Type*) [CommRing k] :
    MvPolynomial.finSuccEquiv k 2 (MvPolynomial.X (1 : Fin 3)) =
      Polynomial.C (MvPolynomial.X (0 : Fin 2)) :=
  MvPolynomial.finSuccEquiv_X_succ (j := 0)

private lemma finSuccEquiv_X_two (k : Type*) [CommRing k] :
    MvPolynomial.finSuccEquiv k 2 (MvPolynomial.X (2 : Fin 3)) =
      Polynomial.C (MvPolynomial.X (1 : Fin 2)) :=
  MvPolynomial.finSuccEquiv_X_succ (j := 1)

private lemma finSuccEquiv_rename_swap_trinomial (k : Type*) [CommRing k] (r s t : ℕ) :
    MvPolynomial.finSuccEquiv k 2 (MvPolynomial.rename (Equiv.swap (0 : Fin 3) 2)
      (MvPolynomial.X 0 ^ r + MvPolynomial.X 1 ^ s + MvPolynomial.X 2 ^ t)) =
      Polynomial.X ^ t +
        Polynomial.C (MvPolynomial.X (0 : Fin 2) ^ s + MvPolynomial.X (1 : Fin 2) ^ r) := by
  simp only [map_add, map_pow, MvPolynomial.rename_X,
    Equiv.swap_apply_left, Equiv.swap_apply_right,
    show Equiv.swap (0 : Fin 3) 2 1 = 1 by decide, finSuccEquiv_X_one, finSuccEquiv_X_two,
    MvPolynomial.finSuccEquiv_X_zero]
  ring

/-- The defining trinomial is irreducible for positive pairwise coprime exponents. -/
@[stacks 0AE9 "irreducibility"]
theorem trinomial_irreducible (k : Type u) [Field k]
    (r s t : ℕ) (_hr : 0 < r) (_hs : 0 < s) (ht : 0 < t)
    (hrs : r.Coprime s) (_hrt : r.Coprime t) (_hst : s.Coprime t) :
    Irreducible (MvPolynomial.X (0 : Fin 3) ^ r +
      MvPolynomial.X (1 : Fin 3) ^ s +
      MvPolynomial.X (2 : Fin 3) ^ t : MvPolynomial (Fin 3) k) := by
  let E := (MvPolynomial.renameEquiv k (Equiv.swap (0 : Fin 3) 2)).trans
    (MvPolynomial.finSuccEquiv k 2)
  apply (MulEquiv.irreducible_iff E).mp
  change Irreducible (MvPolynomial.finSuccEquiv k 2
    (MvPolynomial.rename (Equiv.swap (0 : Fin 3) 2)
      (MvPolynomial.X 0 ^ r + MvPolynomial.X 1 ^ s + MvPolynomial.X 2 ^ t)))
  rw [finSuccEquiv_rename_swap_trinomial]
  exact polynomial_X_pow_add_C_irreducible
    (mvPolynomial_binomial_irreducible k s r hrs.symm).prime t ht

/-- The trinomial hypersurface is integral. -/
@[stacks 0AE9 "integrality"]
theorem trinomialRing_isDomain (k : Type u) [Field k]
    (r s t : ℕ) (hr : 0 < r) (hs : 0 < s) (ht : 0 < t)
    (hrs : r.Coprime s) (hrt : r.Coprime t) (hst : s.Coprime t) :
    IsDomain (trinomialRing k r s t) := by
  have hf := trinomial_irreducible k r s t hr hs ht hrs hrt hst
  exact (Ideal.Quotient.isDomain_iff_prime _).2 (Ideal.isPrime_span_singleton_of_prime hf.prime)

private lemma polynomial_span_X_sup_span_X_pow_add_C_isPrime {R : Type*}
    [CommRing R] {a : R} (ha : (Ideal.span {a}).IsPrime) (n : ℕ) (hn : 0 < n) :
    (Ideal.span {Polynomial.X} ⊔
      Ideal.span {Polynomial.X ^ n + Polynomial.C a} : Ideal (Polynomial R)).IsPrime := by
  have hm : Ideal.map (Polynomial.constantCoeff (R := R))
      (Ideal.span {Polynomial.X ^ n + Polynomial.C a}) = Ideal.span {a} := by
    simp [Ideal.map_span, hn.ne]
  have h := Ideal.comap_map_of_surjective' (Polynomial.constantCoeff (R := R))
    Polynomial.constantCoeff_surjective
    (Ideal.span {Polynomial.X ^ n + Polynomial.C a})
  rw [Polynomial.ker_constantCoeff, hm] at h
  rw [sup_comm, ← h]
  exact ha.comap _

private lemma quotient_span_singleton_isPrime {R : Type*} [CommRing R] (f z : R)
    (h : (Ideal.span {z} ⊔ Ideal.span {f}).IsPrime) :
    (Ideal.span {Ideal.Quotient.mk (Ideal.span {f}) z}).IsPrime := by
  have hmap := Ideal.map_isPrime_of_surjective
    (Ideal.Quotient.mk_surjective (I := Ideal.span {f}))
    (I := Ideal.span {z} ⊔ Ideal.span {f}) (Ideal.mk_ker.trans_le le_sup_right)
  simpa [Ideal.map_sup, Ideal.map_span, Ideal.map_quotient_self] using hmap

private lemma quotient_span_singleton_isPrime_of_polynomial_equiv
    {R K : Type*} [CommRing R] [CommRing K] (f z : R)
    (E : R ≃+* Polynomial K) (n : ℕ) (a : K) (hn : 0 < n)
    (ha : (Ideal.span {a}).IsPrime)
    (hf : E f = Polynomial.X ^ n + Polynomial.C a) (hz : E z = Polynomial.X) :
    (Ideal.span {Ideal.Quotient.mk (Ideal.span {f}) z}).IsPrime := by
  apply quotient_span_singleton_isPrime f z
  have hmap : (Ideal.map E.toRingHom (Ideal.span {z} ⊔ Ideal.span {f})).IsPrime := by
    rw [Ideal.map_sup, Ideal.map_span, Ideal.map_span, Set.image_singleton, Set.image_singleton]
    change (Ideal.span {E z} ⊔ Ideal.span {E f}).IsPrime
    rw [hz, hf]
    exact polynomial_span_X_sup_span_X_pow_add_C_isPrime ha n hn
  simpa only [Ideal.comap_map_of_bijective E.toRingHom E.bijective] using hmap.comap E.toRingHom

/-- Swapping `x i` to the front makes the trinomial `X ^ n + C a` with `a` prime, which makes the
coordinate `x i` generate a prime ideal. -/
private lemma trinomialRing_coordinate_isPrime_of_swap (k : Type*) [Field k] (r s t : ℕ)
    (i : Fin 3) (n : ℕ) (a : MvPolynomial (Fin 2) k) (hn : 0 < n) (ha : Prime a)
    (hf : MvPolynomial.finSuccEquiv k 2 (MvPolynomial.rename (Equiv.swap (0 : Fin 3) i)
      (MvPolynomial.X 0 ^ r + MvPolynomial.X 1 ^ s + MvPolynomial.X 2 ^ t)) =
        Polynomial.X ^ n + Polynomial.C a) :
    (Ideal.span ({Ideal.Quotient.mk _ (MvPolynomial.X i)} :
      Set (trinomialRing k r s t))).IsPrime := by
  refine quotient_span_singleton_isPrime_of_polynomial_equiv _ _
    ((MvPolynomial.renameEquiv k (Equiv.swap (0 : Fin 3) i)).trans
      (MvPolynomial.finSuccEquiv k 2)).toRingEquiv n a hn
    (Ideal.isPrime_span_singleton_of_prime ha) hf ?_
  change MvPolynomial.finSuccEquiv k 2
    (MvPolynomial.rename (Equiv.swap (0 : Fin 3) i) (MvPolynomial.X i)) = _
  simp only [MvPolynomial.rename_X, Equiv.swap_apply_right, MvPolynomial.finSuccEquiv_X_zero]

/-- The image of `z` generates a prime ideal in the hypersurface ring. -/
@[stacks 0AE9 "the prime element z"]
theorem trinomialRing_z_isPrime (k : Type u) [Field k]
    (r s t : ℕ) (_hr : 0 < r) (_hs : 0 < s) (ht : 0 < t)
    (hrs : r.Coprime s) :
    (Ideal.span ({Ideal.Quotient.mk _ (MvPolynomial.X (2 : Fin 3))} :
      Set (trinomialRing k r s t))).IsPrime :=
  trinomialRing_coordinate_isPrime_of_swap k r s t 2 t _ ht
    (mvPolynomial_binomial_irreducible k s r hrs.symm).prime
    (finSuccEquiv_rename_swap_trinomial k r s t)

private noncomputable def trinomialLift (k : Type*) [CommRing k]
    (r s t : ℕ) {B : Type*} [CommRing B] [Algebra k B]
    (a : Fin 3 → B) (ha : a 0 ^ r + a 1 ^ s + a 2 ^ t = 0) :
    trinomialRing k r s t →ₐ[k] B :=
  Ideal.Quotient.liftₐ _ (MvPolynomial.aeval a) (by
    intro p hp
    have hle : Ideal.span {MvPolynomial.X (0 : Fin 3) ^ r +
        MvPolynomial.X (1 : Fin 3) ^ s + MvPolynomial.X (2 : Fin 3) ^ t} ≤
        RingHom.ker (MvPolynomial.aeval (R := k) a).toRingHom := by
      rw [Ideal.span_singleton_le_iff_mem]
      simpa using ha
    exact hle hp)

private lemma trinomialLift_X (k : Type*) [CommRing k]
    (r s t : ℕ) {B : Type*} [CommRing B] [Algebra k B]
    (a : Fin 3 → B) (ha : a 0 ^ r + a 1 ^ s + a 2 ^ t = 0) (i : Fin 3) :
    trinomialLift k r s t a ha (Ideal.Quotient.mk _ (MvPolynomial.X i)) = a i :=
  MvPolynomial.aeval_X a i

private lemma trinomial_quotient_relation (k : Type*) [CommRing k] (r s t : ℕ)
    {B : Type*} [CommRing B] (f : trinomialRing k r s t →+* B) :
    f (Ideal.Quotient.mk _ (MvPolynomial.X (0 : Fin 3))) ^ r +
      f (Ideal.Quotient.mk _ (MvPolynomial.X (1 : Fin 3))) ^ s +
      f (Ideal.Quotient.mk _ (MvPolynomial.X (2 : Fin 3))) ^ t = 0 := by
  have h := Ideal.Quotient.eq_zero_iff_mem.mpr
    (Ideal.mem_span_singleton_self (MvPolynomial.X (0 : Fin 3) ^ r +
      MvPolynomial.X (1 : Fin 3) ^ s + MvPolynomial.X (2 : Fin 3) ^ t :
        MvPolynomial (Fin 3) k))
  simpa only [map_add, map_pow, map_zero] using congrArg f h

private lemma scaled_trinomial {B : Type*} [CommRing B] (x y z : B) (r s e : ℕ) :
    (x * z ^ (e * s)) ^ r + (y * z ^ (e * r)) ^ s + z ^ (1 + e * r * s) =
      (x ^ r + y ^ s + z) * z ^ (e * r * s) := by
  simp only [mul_pow, ← pow_mul, pow_add, pow_one]
  rw [show e * s * r = e * r * s by ring]
  ring

private lemma unscaled_trinomial {B : Type*} [CommRing B] (x y z w : B)
    (r s e : ℕ) (hw : z * w = 1)
    (h : x ^ r + y ^ s + z ^ (1 + e * r * s) = 0) :
    -((x * w ^ (e * s)) ^ r + (y * w ^ (e * r)) ^ s) = z := by
  have hp : z ^ (e * r * s) * w ^ (e * r * s) = 1 := by
    rw [← mul_pow, hw, one_pow]
  have hxy : x ^ r + y ^ s = -z ^ (1 + e * r * s) := eq_neg_of_add_eq_zero_left h
  simp only [mul_pow, ← pow_mul]
  rw [show e * s * r = e * r * s by ring, ← add_mul, hxy,
    neg_mul, neg_neg, pow_add, pow_one, mul_assoc, hp, mul_one]

private lemma trinomial_localization_hom_ext (k : Type*) [CommRing k] (r s t : ℕ)
    {B : Type*} [CommRing B] [Algebra k B]
    {f g : Localization.Away
        (Ideal.Quotient.mk _ (MvPolynomial.X (2 : Fin 3)) : trinomialRing k r s t)
          →ₐ[k] B}
    (h : ∀ i : Fin 3, f (algebraMap (trinomialRing k r s t) _
        (Ideal.Quotient.mk _ (MvPolynomial.X i))) =
      g (algebraMap (trinomialRing k r s t) _
        (Ideal.Quotient.mk _ (MvPolynomial.X i)))) : f = g := by
  apply IsLocalization.algHom_ext (Submonoid.powers
    (Ideal.Quotient.mk _ (MvPolynomial.X (2 : Fin 3)) : trinomialRing k r s t))
  apply Ideal.Quotient.algHom_ext
  apply MvPolynomial.algHom_ext
  exact h

private lemma mul_pow_mul_pow_of_mul_eq_one {M : Type*} [CommMonoid M] {a b : M}
    (h : b * a = 1) (x : M) (n : ℕ) : x * a ^ n * b ^ n = x := by
  rw [mul_assoc, ← mul_pow, mul_comm a b, h, one_pow, mul_one]

/-- An algebra map sending `M` to units extends along the localization at `M`. -/
private lemma exists_algHom_comp_algebraMap {k A L B : Type*} [CommRing k] [CommRing A]
    [CommRing L] [CommRing B] [Algebra k A] [Algebra k L] [Algebra k B] [Algebra A L]
    [IsScalarTower k A L] (M : Submonoid A) [IsLocalization M L] (f : A →ₐ[k] B)
    (hf : ∀ y : M, IsUnit (f y)) : ∃ g : L →ₐ[k] B, ∀ p, g (algebraMap A L p) = f p :=
  ⟨IsLocalization.liftAlgHom hf, IsLocalization.lift_eq hf⟩

/-- An algebra map sending `x` to a unit extends along the localization away from `x`. -/
private lemma exists_algHom_comp_algebraMap_away {k A L B : Type*} [CommRing k] [CommRing A]
    [CommRing L] [CommRing B] [Algebra k A] [Algebra k L] [Algebra k B] [Algebra A L]
    [IsScalarTower k A L] (x : A) [IsLocalization.Away x L] (f : A →ₐ[k] B)
    (hf : IsUnit (f x)) : ∃ g : L →ₐ[k] B, ∀ p, g (algebraMap A L p) = f p :=
  ⟨IsLocalization.Away.liftAlgHom x hf, IsLocalization.Away.lift_eq x hf⟩

private lemma exists_trinomial_localization_forward (k : Type u) [Field k] (r s e : ℕ) :
    ∃ f : Localization.Away
        (Ideal.Quotient.mk _ (MvPolynomial.X (2 : Fin 3)) :
          trinomialRing k r s (1 + e * r * s)) →ₐ[k]
        Localization.Away (-(MvPolynomial.X (0 : Fin 2) ^ r +
          MvPolynomial.X (1 : Fin 2) ^ s) : MvPolynomial (Fin 2) k),
      f (algebraMap (trinomialRing k r s (1 + e * r * s)) _
          (Ideal.Quotient.mk _ (MvPolynomial.X (0 : Fin 3)))) =
        algebraMap (MvPolynomial (Fin 2) k) _
          (MvPolynomial.X (0 : Fin 2) *
            (-(MvPolynomial.X (0 : Fin 2) ^ r +
              MvPolynomial.X (1 : Fin 2) ^ s)) ^ (e * s)) ∧
      f (algebraMap (trinomialRing k r s (1 + e * r * s)) _
          (Ideal.Quotient.mk _ (MvPolynomial.X (1 : Fin 3)))) =
        algebraMap (MvPolynomial (Fin 2) k) _
          (MvPolynomial.X (1 : Fin 2) *
            (-(MvPolynomial.X (0 : Fin 2) ^ r +
              MvPolynomial.X (1 : Fin 2) ^ s)) ^ (e * r)) ∧
      f (algebraMap (trinomialRing k r s (1 + e * r * s)) _
          (Ideal.Quotient.mk _ (MvPolynomial.X (2 : Fin 3)))) =
        algebraMap (MvPolynomial (Fin 2) k) _
          (-(MvPolynomial.X (0 : Fin 2) ^ r +
            MvPolynomial.X (1 : Fin 2) ^ s)) := by
  let P := MvPolynomial (Fin 2) k
  let q : P := -(MvPolynomial.X 0 ^ r + MvPolynomial.X 1 ^ s)
  let B := Localization.Away q
  let z₀ : trinomialRing k r s (1 + e * r * s) := Ideal.Quotient.mk _ (MvPolynomial.X 2)
  let x : Fin 3 → P := ![MvPolynomial.X 0 * q ^ (e * s), MvPolynomial.X 1 * q ^ (e * r), q]
  have hx : x 0 ^ r + x 1 ^ s + x 2 ^ (1 + e * r * s) = 0 := by
    change (MvPolynomial.X 0 * q ^ (e * s)) ^ r + (MvPolynomial.X 1 * q ^ (e * r)) ^ s +
      q ^ (1 + e * r * s) = 0
    rw [scaled_trinomial]
    simp only [q, add_neg_cancel, zero_mul]
  have hB := congrArg (algebraMap P B) hx
  rw [map_add, map_add, map_pow, map_pow, map_pow, map_zero] at hB
  let f₀ := trinomialLift k r s (1 + e * r * s) (fun i => algebraMap P B (x i)) hB
  have hf₀ (i : Fin 3) : f₀ (Ideal.Quotient.mk _ (MvPolynomial.X i)) = algebraMap P B (x i) :=
    trinomialLift_X _ _ _ _ _ _ _
  have hfz : IsUnit (f₀ z₀) := by
    rw [show f₀ z₀ = algebraMap P B q from hf₀ 2]
    exact IsLocalization.Away.algebraMap_isUnit q
  obtain ⟨f, hf⟩ := exists_algHom_comp_algebraMap_away (L := Localization.Away z₀) z₀ f₀ hfz
  exact ⟨f, (hf _).trans (hf₀ 0), (hf _).trans (hf₀ 1), (hf _).trans (hf₀ 2)⟩

private lemma exists_binomial_localization_lift (k : Type u) [Field k] (r s e : ℕ)
    {L : Type*} [CommRing L] [Algebra k L] (x y z w : L) (hzw : z * w = 1)
    (h : x ^ r + y ^ s + z ^ (1 + e * r * s) = 0) :
    ∃ g : Localization.Away (-(MvPolynomial.X (0 : Fin 2) ^ r +
          MvPolynomial.X (1 : Fin 2) ^ s) : MvPolynomial (Fin 2) k) →ₐ[k] L,
      g (algebraMap (MvPolynomial (Fin 2) k) _ (MvPolynomial.X 0)) = x * w ^ (e * s) ∧
      g (algebraMap (MvPolynomial (Fin 2) k) _ (MvPolynomial.X 1)) = y * w ^ (e * r) ∧
      g (algebraMap (MvPolynomial (Fin 2) k) _
        (-(MvPolynomial.X 0 ^ r + MvPolynomial.X 1 ^ s))) = z := by
  let q : MvPolynomial (Fin 2) k := -(MvPolynomial.X 0 ^ r + MvPolynomial.X 1 ^ s)
  let g₀ : MvPolynomial (Fin 2) k →ₐ[k] L :=
    MvPolynomial.aeval ![x * w ^ (e * s), y * w ^ (e * r)]
  have hg₀ (i : Fin 2) : g₀ (MvPolynomial.X i) = ![x * w ^ (e * s), y * w ^ (e * r)] i :=
    MvPolynomial.aeval_X _ _
  have hgq : g₀ q = z := by
    simp only [q, map_neg, map_add, map_pow, hg₀]
    exact unscaled_trinomial x y z w r s e hzw h
  have hgqu : IsUnit (g₀ q) := hgq ▸ IsUnit.of_mul_eq_one w hzw
  obtain ⟨g, hg⟩ := exists_algHom_comp_algebraMap_away (L := Localization.Away q) q g₀ hgqu
  exact ⟨g, (hg _).trans (hg₀ 0), (hg _).trans (hg₀ 1), (hg q).trans hgq⟩

/-- When `t = 1 + e r s`, localization at `z` is the localization of a polynomial
ring in `x'`, `y'` at `-((x') ^ r + (y') ^ s)`, with the stated coordinate formulas. -/
@[stacks 0AE9 "localized polynomial presentation"]
theorem trinomialRing_localization_equiv (k : Type u) [Field k]
    (r s e : ℕ) :
    ∃ φ : Localization.Away
        (Ideal.Quotient.mk _ (MvPolynomial.X (2 : Fin 3)) :
          trinomialRing k r s (1 + e * r * s)) ≃ₐ[k]
        Localization.Away (-(MvPolynomial.X (0 : Fin 2) ^ r +
          MvPolynomial.X (1 : Fin 2) ^ s) : MvPolynomial (Fin 2) k),
      φ (algebraMap (trinomialRing k r s (1 + e * r * s)) _
          (Ideal.Quotient.mk _ (MvPolynomial.X (0 : Fin 3)))) =
        algebraMap (MvPolynomial (Fin 2) k) _
          (MvPolynomial.X (0 : Fin 2) *
            (-(MvPolynomial.X (0 : Fin 2) ^ r +
              MvPolynomial.X (1 : Fin 2) ^ s)) ^ (e * s)) ∧
      φ (algebraMap (trinomialRing k r s (1 + e * r * s)) _
          (Ideal.Quotient.mk _ (MvPolynomial.X (1 : Fin 3)))) =
        algebraMap (MvPolynomial (Fin 2) k) _
          (MvPolynomial.X (1 : Fin 2) *
            (-(MvPolynomial.X (0 : Fin 2) ^ r +
              MvPolynomial.X (1 : Fin 2) ^ s)) ^ (e * r)) ∧
      φ (algebraMap (trinomialRing k r s (1 + e * r * s)) _
          (Ideal.Quotient.mk _ (MvPolynomial.X (2 : Fin 3)))) =
        algebraMap (MvPolynomial (Fin 2) k) _
          (-(MvPolynomial.X (0 : Fin 2) ^ r +
            MvPolynomial.X (1 : Fin 2) ^ s)) := by
  let A := trinomialRing k r s (1 + e * r * s)
  let P := MvPolynomial (Fin 2) k
  let q : P := -(MvPolynomial.X (0 : Fin 2) ^ r + MvPolynomial.X (1 : Fin 2) ^ s)
  let z₀ : A := Ideal.Quotient.mk _ (MvPolynomial.X (2 : Fin 3))
  let L := Localization.Away z₀
  let B := Localization.Away q
  let a : Fin 3 → L := fun i => algebraMap A L (Ideal.Quotient.mk _ (MvPolynomial.X i))
  let b : Fin 2 → B := fun i => algebraMap P B (MvPolynomial.X i)
  let w : L := IsLocalization.Away.invSelf z₀
  let v : B := IsLocalization.Away.invSelf q
  have hzw : a 2 * w = 1 := IsLocalization.Away.mul_invSelf z₀
  have hcv : algebraMap P B q * v = 1 := IsLocalization.Away.mul_invSelf q
  obtain ⟨f, hf0, hf1, hf2⟩ := exists_trinomial_localization_forward k r s e
  obtain ⟨g, hg0, hg1, hgc⟩ := exists_binomial_localization_lift k r s e (a 0) (a 1) (a 2) w
    hzw (trinomial_quotient_relation k r s (1 + e * r * s) (algebraMap A L))
  have hfw : f w = v := by
    apply (IsLocalization.Away.algebraMap_isUnit q (S := B)).mul_left_cancel
    change algebraMap P B q * f w = algebraMap P B q * v
    rw [hcv, ← hf2, ← map_mul, hzw, map_one]
  have hgf : g.comp f = AlgHom.id k L := by
    apply trinomial_localization_hom_ext k r s (1 + e * r * s)
    intro i
    fin_cases i
    · change g (f (a 0)) = a 0
      rw [hf0, map_mul, map_pow, map_mul, map_pow, hg0, hgc]
      exact mul_pow_mul_pow_of_mul_eq_one hzw _ _
    · change g (f (a 1)) = a 1
      rw [hf1, map_mul, map_pow, map_mul, map_pow, hg1, hgc]
      exact mul_pow_mul_pow_of_mul_eq_one hzw _ _
    · change g (f (a 2)) = a 2
      rw [hf2, hgc]
  have hfg : f.comp g = AlgHom.id k B := by
    apply IsLocalization.algHom_ext (Submonoid.powers q)
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i
    · change f (g (b 0)) = b 0
      rw [hg0, map_mul, map_pow, hf0, hfw, map_mul, map_pow]
      exact mul_pow_mul_pow_of_mul_eq_one ((mul_comm _ _).trans hcv) _ _
    · change f (g (b 1)) = b 1
      rw [hg1, map_mul, map_pow, hf1, hfw, map_mul, map_pow]
      exact mul_pow_mul_pow_of_mul_eq_one ((mul_comm _ _).trans hcv) _ _
  exact ⟨AlgEquiv.ofAlgHom f g hfg hgf, hf0, hf1, hf2⟩

/-- In the explicit presentation, inverting `z` gives a unique factorization monoid. -/
@[stacks 0AE9 "factorial localization"]
theorem trinomialRing_localization_uniqueFactorizationMonoid (k : Type u) [Field k]
    (r s e : ℕ) :
    UniqueFactorizationMonoid
      (Localization.Away
        (Ideal.Quotient.mk _ (MvPolynomial.X (2 : Fin 3)) :
          trinomialRing k r s (1 + e * r * s))) := by
  obtain ⟨φ, -⟩ := trinomialRing_localization_equiv k r s e
  exact φ.toRingEquiv.toMulEquiv.symm.uniqueFactorizationMonoid inferInstance

private def monomial3 {G : Type*} [CommGroup G] (x y z : G) (a b c : ℤ) : G :=
  x ^ a * y ^ b * z ^ c

private lemma monomial3_comp {G : Type*} [CommGroup G] (x y z : G)
    (a₁ b₁ c₁ a₂ b₂ c₂ a₃ b₃ c₃ i j k : ℤ) :
    monomial3 (monomial3 x y z a₁ b₁ c₁) (monomial3 x y z a₂ b₂ c₂)
      (monomial3 x y z a₃ b₃ c₃) i j k =
    monomial3 x y z (a₁ * i + a₂ * j + a₃ * k)
      (b₁ * i + b₂ * j + b₃ * k) (c₁ * i + c₂ * j + c₃ * k) := by
  simp only [monomial3, mul_zpow, ← zpow_mul, zpow_add]
  ac_rfl

private def toricForward {G : Type*} [CommGroup G] (a b c r s t : ℤ)
    (v : Fin 3 → G) : Fin 3 → G :=
  ![monomial3 (v 0) (v 1) (v 2) (s * c + t * b) (-t * b) (s * t),
    monomial3 (v 0) (v 1) (v 2) (-t * a) (r * c + t * a) (r * t),
    monomial3 (v 0) (v 1) (v 2) (-s * a) (-r * b) (r * s)]

private def toricBackward {G : Type*} [CommGroup G] (a b c r s t : ℤ)
    (v : Fin 3 → G) : Fin 3 → G :=
  ![monomial3 (v 0) (v 1) (v 2) r 0 (-t),
    monomial3 (v 0) (v 1) (v 2) 0 s (-t),
    monomial3 (v 0) (v 1) (v 2) a b c]

private lemma toric_inverses {G : Type*} [CommGroup G]
    (a b c r s t : ℤ) (h : a * s * t + b * r * t + c * r * s = 1) (v : Fin 3 → G) :
    toricBackward a b c r s t (toricForward a b c r s t v) = v ∧
      toricForward a b c r s t (toricBackward a b c r s t v) = v := by
  refine ⟨?_, ?_⟩ <;> funext i <;> fin_cases i <;>
  · dsimp [toricForward, toricBackward]
    rw [monomial3_comp]
    first
    | (convert (show monomial3 (v 0) (v 1) (v 2) 1 0 0 = v 0 by simp [monomial3]) using 1
       congr 1 <;> first | ring1 | linear_combination h)
    | (convert (show monomial3 (v 0) (v 1) (v 2) 0 1 0 = v 1 by simp [monomial3]) using 1
       congr 1 <;> first | ring1 | linear_combination h)
    | (convert (show monomial3 (v 0) (v 1) (v 2) 0 0 1 = v 2 by simp [monomial3]) using 1
       congr 1 <;> first | ring1 | linear_combination h)

private lemma toricForward_map {G H : Type*} [CommGroup G] [CommGroup H]
    (f : G →* H) (a b c r s t : ℤ) (v : Fin 3 → G) :
    toricForward a b c r s t (f ∘ v) = f ∘ toricForward a b c r s t v := by
  funext i
  fin_cases i <;> simp [toricForward, monomial3, map_mul, map_zpow]

private lemma toricBackward_map {G H : Type*} [CommGroup G] [CommGroup H]
    (f : G →* H) (a b c r s t : ℤ) (v : Fin 3 → G) :
    toricBackward a b c r s t (f ∘ v) = f ∘ toricBackward a b c r s t v := by
  funext i
  fin_cases i <;> simp [toricBackward, monomial3, map_mul, map_zpow]

private lemma toric_relation_iff {R : Type*} [CommRing R]
    (a b c : ℤ) (r s t : ℕ) (v : Fin 3 → Rˣ) :
    (↑(v 0) ^ r + ↑(v 1) ^ s + ↑(v 2) ^ t = (0 : R)) ↔
      (↑(toricBackward a b c r s t v 0) +
        ↑(toricBackward a b c r s t v 1) + 1 = (0 : R)) := by
  have hz : (↑(v 2) ^ t : R) * ↑((v 2) ^ (-(t : ℤ))) = 1 := by
    rw [← Units.val_pow_eq_pow_val, ← Units.val_mul]
    change ↑((v 2) ^ (t : ℤ) * (v 2) ^ (-(t : ℤ))) = (1 : R)
    simp
  have he : (↑(v 0) ^ r + ↑(v 1) ^ s + ↑(v 2) ^ t : R) *
      ↑((v 2) ^ (-(t : ℤ))) =
      ↑(toricBackward a b c r s t v 0) + ↑(toricBackward a b c r s t v 1) + 1 := by
    simp only [toricBackward, Matrix.cons_val_zero, Matrix.cons_val_one, monomial3,
      zpow_natCast, zpow_zero, mul_one, one_mul, Units.val_mul, Units.val_pow_eq_pow_val]
    linear_combination hz
  rw [← he, ((v 2) ^ (-(t : ℤ))).isUnit.mul_left_eq_zero]

private lemma exists_toric_exponents (r s t : ℕ)
    (hrs : r.Coprime s) (hrt : r.Coprime t) (hst : s.Coprime t) :
    ∃ a b c : ℤ, a * s * t + b * r * t + c * r * s = 1 := by
  obtain ⟨u, v, hu⟩ := hrs.isCoprime
  obtain ⟨p, q, hq⟩ := (hrt.mul_left hst).isCoprime
  refine ⟨q * v, q * u, p, ?_⟩
  push_cast at hq
  linear_combination q * (t : ℤ) * hu + hq

private lemma toric_comp_eq {G H : Type*} [CommGroup G] [CommGroup H] (a b c r s t : ℤ)
    (h : a * s * t + b * r * t + c * r * s = 1) (φ : G →* H) (ψ : H →* G)
    (u : Fin 3 → G) (w : Fin 3 → H) (hφ : φ ∘ u = toricForward a b c r s t w)
    (hψ : ψ ∘ w = toricBackward a b c r s t u) :
    ψ ∘ φ ∘ u = u ∧ φ ∘ ψ ∘ w = w :=
  ⟨by rw [hφ, ← toricForward_map, hψ, (toric_inverses a b c r s t h _).2],
    by rw [hψ, ← toricBackward_map, hφ, (toric_inverses a b c r s t h _).1]⟩

private lemma exists_trinomial_closure_lift (k : Type*) [Field k] (r s t : ℕ)
    {B : Type*} [CommRing B] [Algebra k B] (x : Fin 3 → Bˣ)
    (hx : (↑(x 0) ^ r + ↑(x 1) ^ s + ↑(x 2) ^ t : B) = 0) :
    ∃ f : Localization (Submonoid.closure (Set.range (fun i : Fin 3 =>
        (Ideal.Quotient.mk _ (MvPolynomial.X i) : trinomialRing k r s t)))) →ₐ[k] B,
      ∀ i, f (algebraMap (trinomialRing k r s t) _
        (Ideal.Quotient.mk _ (MvPolynomial.X i))) = x i := by
  let A := trinomialRing k r s t
  let v : Fin 3 → A := fun i => Ideal.Quotient.mk _ (MvPolynomial.X i)
  let S := Submonoid.closure (Set.range v)
  let L := Localization S
  let : CommRing L := OreLocalization.instCommRing
  let f₀ : A →ₐ[k] B := trinomialLift k r s t (fun i => ↑(x i)) hx
  have hf₀ (i : Fin 3) : f₀ (v i) = ↑(x i) := trinomialLift_X _ _ _ _ _ _ _
  have hfs (y : S) : IsUnit (f₀ y) := by
    rcases y with ⟨y, hy⟩
    change IsUnit (f₀ y)
    induction hy using Submonoid.closure_induction with
    | mem p hp =>
      obtain ⟨i, rfl⟩ := hp
      rw [hf₀]
      exact (x i).isUnit
    | one => simp
    | mul p q _ _ hp hq => simpa only [map_mul] using hp.mul hq
  obtain ⟨f, hf⟩ := exists_algHom_comp_algebraMap (L := L) S f₀ hfs
  exact ⟨f, fun i => (hf _).trans (hf₀ i)⟩

private lemma exists_torus_lift (k : Type*) [Field k] {L : Type*} [CommRing L] [Algebra k L]
    (y : Fin 3 → Lˣ) (hy : (↑(y 0) + ↑(y 1) + 1 : L) = 0) :
    ∃ g : Localization.Away (MvPolynomial.X (0 : Fin 2) * (-1 - MvPolynomial.X (0 : Fin 2)) *
        MvPolynomial.X (1 : Fin 2) : MvPolynomial (Fin 2) k) →ₐ[k] L,
      ∀ i, g (algebraMap (MvPolynomial (Fin 2) k) _
        (![MvPolynomial.X 0, -1 - MvPolynomial.X 0, MvPolynomial.X 1] i)) = y i := by
  let P := MvPolynomial (Fin 2) k
  let qv : Fin 3 → P := ![MvPolynomial.X 0, -1 - MvPolynomial.X 0, MvPolynomial.X 1]
  let Q := qv 0 * qv 1 * qv 2
  let g₀ : P →ₐ[k] L := MvPolynomial.aeval ![↑(y 0), ↑(y 2)]
  have hg₀ (i : Fin 3) : g₀ (qv i) = ↑(y i) := by
    fin_cases i
    · exact MvPolynomial.aeval_X _ _
    · change g₀ (-1 - MvPolynomial.X 0) = ↑(y 1)
      simp only [map_sub, map_neg, map_one]
      rw [show g₀ (MvPolynomial.X 0) = ↑(y 0) from MvPolynomial.aeval_X _ _]
      linear_combination -hy
    · exact MvPolynomial.aeval_X _ _
  have hgQ : IsUnit (g₀ Q) := by
    change IsUnit (g₀ (qv 0 * qv 1 * qv 2))
    rw [map_mul, map_mul, hg₀, hg₀, hg₀]
    exact ((y 0).isUnit.mul (y 1).isUnit).mul (y 2).isUnit
  obtain ⟨g, hg⟩ := exists_algHom_comp_algebraMap_away (L := Localization.Away Q) Q g₀ hgQ
  exact ⟨g, fun i => (hg _).trans (hg₀ i)⟩

private lemma trinomial_torus_equiv (k : Type*) [Field k] (r s t : ℕ)
    (a b c : ℤ) (habc : a * s * t + b * r * t + c * r * s = 1) :
    Nonempty (Localization (Submonoid.closure (Set.range (fun i : Fin 3 =>
        (Ideal.Quotient.mk _ (MvPolynomial.X i) : trinomialRing k r s t)))) ≃ₐ[k]
      Localization.Away (MvPolynomial.X (0 : Fin 2) * (-1 - MvPolynomial.X (0 : Fin 2)) *
        MvPolynomial.X (1 : Fin 2) : MvPolynomial (Fin 2) k)) := by
  let A := trinomialRing k r s t
  let v : Fin 3 → A := fun i => Ideal.Quotient.mk _ (MvPolynomial.X i)
  let S := Submonoid.closure (Set.range v)
  let L := Localization S
  let : CommRing L := OreLocalization.instCommRing
  let P := MvPolynomial (Fin 2) k
  let qv : Fin 3 → P := ![MvPolynomial.X 0, -1 - MvPolynomial.X 0, MvPolynomial.X 1]
  let Q := qv 0 * qv 1 * qv 2
  let B := Localization.Away Q
  let u : Fin 3 → Lˣ := fun i =>
    (IsLocalization.map_units L (⟨v i, Submonoid.subset_closure ⟨i, rfl⟩⟩ : S)).unit
  have hv (i : Fin 3) : IsUnit (algebraMap P B (qv i)) := by
    have h := IsLocalization.Away.algebraMap_isUnit Q (S := B)
    simp only [Q, map_mul, IsUnit.mul_iff] at h
    fin_cases i
    exacts [h.1.1, h.1.2, h.2]
  let w : Fin 3 → Bˣ := fun i => (hv i).unit
  have hwr : (↑(w 0) + ↑(w 1) + 1 : B) = 0 := by
    change algebraMap P B (MvPolynomial.X 0) + algebraMap P B (-1 - MvPolynomial.X 0) + 1 = 0
    rw [map_sub, map_neg, map_one]
    ring
  have hur : (↑(u 0) ^ r + ↑(u 1) ^ s + ↑(u 2) ^ t : L) = 0 :=
    trinomial_quotient_relation k r s t (algebraMap A L)
  have hfw := (toric_relation_iff a b c r s t (toricForward a b c r s t w)).mpr
    (by rwa [(toric_inverses a b c r s t habc _).1])
  obtain ⟨f, hfu⟩ := exists_trinomial_closure_lift k r s t _ hfw
  obtain ⟨g, hgw⟩ := exists_torus_lift k _ ((toric_relation_iff a b c r s t u).mp hur)
  have hfu' : Units.map f.toMonoidHom ∘ u = toricForward a b c r s t w :=
    funext fun i => Units.ext (hfu i)
  have hgw' : Units.map g.toMonoidHom ∘ w = toricBackward a b c r s t u :=
    funext fun i => Units.ext (hgw i)
  obtain ⟨hgf', hfg'⟩ := toric_comp_eq a b c r s t habc _ _ u w hfu' hgw'
  have hgf : g.comp f = AlgHom.id k L := by
    apply IsLocalization.algHom_ext S
    apply Ideal.Quotient.algHom_ext
    apply MvPolynomial.algHom_ext
    exact fun i => congrArg Units.val (congrFun hgf' i)
  have hfg : f.comp g = AlgHom.id k B := by
    apply IsLocalization.algHom_ext (Submonoid.powers
      (MvPolynomial.X 0 * (-1 - MvPolynomial.X 0) * MvPolynomial.X 1 : P))
    apply MvPolynomial.algHom_ext
    intro i
    fin_cases i
    exacts [congrArg Units.val (congrFun hfg' 0), congrArg Units.val (congrFun hfg' 2)]
  exact ⟨AlgEquiv.ofAlgHom f g hfg hgf⟩

private lemma trinomialRing_coordinate_isPrime (k : Type*) [Field k]
    (r s t : ℕ) (hr : 0 < r) (hs : 0 < s) (ht : 0 < t)
    (hrs : r.Coprime s) (hrt : r.Coprime t) (hst : s.Coprime t) (i : Fin 3) :
    (Ideal.span ({Ideal.Quotient.mk _ (MvPolynomial.X i)} :
      Set (trinomialRing k r s t))).IsPrime := by
  fin_cases i
  · refine trinomialRing_coordinate_isPrime_of_swap k r s t 0 r _ hr
      (mvPolynomial_binomial_irreducible k s t hst).prime ?_
    simp only [Equiv.swap_self, Equiv.refl_apply, MvPolynomial.rename_X, map_add, map_pow,
      MvPolynomial.finSuccEquiv_X_zero, finSuccEquiv_X_one, finSuccEquiv_X_two]
    ring
  · refine trinomialRing_coordinate_isPrime_of_swap k r s t 1 s _ hs
      (mvPolynomial_binomial_irreducible k r t hrt).prime ?_
    simp only [map_add, map_pow, MvPolynomial.rename_X, Equiv.swap_apply_left,
      Equiv.swap_apply_right, show Equiv.swap (0 : Fin 3) 1 2 = 2 by decide,
      MvPolynomial.finSuccEquiv_X_zero, finSuccEquiv_X_one, finSuccEquiv_X_two]
    ring
  · exact trinomialRing_z_isPrime k r s t hr hs ht hrs

/-- The trinomial hypersurface is a unique factorization domain. -/
@[stacks 0AE9 "unique factorization"]
theorem trinomialRing_uniqueFactorizationMonoid (k : Type u) [Field k]
    (r s t : ℕ) (hr : 0 < r) (hs : 0 < s) (ht : 0 < t)
    (hrs : r.Coprime s) (hrt : r.Coprime t) (hst : s.Coprime t) :
    UniqueFactorizationMonoid (trinomialRing k r s t) := by
  let A := trinomialRing k r s t
  let v : Fin 3 → A := fun i => Ideal.Quotient.mk _ (MvPolynomial.X i)
  let S := Submonoid.closure (Set.range v)
  let L := Localization S
  let : CommRing L := OreLocalization.instCommRing
  let P := MvPolynomial (Fin 2) k
  let Q : P := MvPolynomial.X 0 * (-1 - MvPolynomial.X 0) * MvPolynomial.X 1
  let B := Localization.Away Q
  obtain ⟨a, b, c, habc⟩ := exists_toric_exponents r s t hrs hrt hst
  obtain ⟨E⟩ := trinomial_torus_equiv k r s t a b c habc
  have hQ : Q ≠ 0 := by
    apply mul_ne_zero (mul_ne_zero (MvPolynomial.X_ne_zero (0 : Fin 2)) ?_)
      (MvPolynomial.X_ne_zero (1 : Fin 2))
    intro h
    simpa using congrArg MvPolynomial.constantCoeff h
  have : IsDomain B := IsLocalization.Away.isDomain B hQ
  have : IsDomain A := trinomialRing_isDomain k r s t hr hs ht hrs hrt hst
  have hv0 (i : Fin 3) : v i ≠ 0 := by
    have hu : IsUnit (algebraMap A L (v i)) :=
      IsLocalization.map_units L (⟨v i, Submonoid.subset_closure ⟨i, rfl⟩⟩ : S)
    have he : IsUnit (E (algebraMap A L (v i))) := hu.map E.toRingEquiv.toMonoidHom
    intro h
    rw [h, map_zero, map_zero] at he
    exact not_isUnit_zero he
  have hp (i : Fin 3) : Prime (v i) :=
    (Ideal.span_singleton_prime (hv0 i)).mp
      (trinomialRing_coordinate_isPrime k r s t hr hs ht hrs hrt hst i)
  have hS : GenByPrimes S := ⟨Set.range v, Set.forall_mem_range.2 hp, rfl⟩
  refine (nagata_criterion S hS).mpr ⟨fun x hx hnu => ?_,
    E.toRingEquiv.toMulEquiv.symm.uniqueFactorizationMonoid inferInstance⟩
  obtain ⟨l, hl, he, -⟩ := (WfDvdMonoid.not_isUnit_iff_exists_factors_eq x hx).mp hnu
  exact ⟨l, hl, he⟩

end Stacks.Resolution

