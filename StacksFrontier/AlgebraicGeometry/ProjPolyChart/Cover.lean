module

public import Mathlib.AlgebraicGeometry.ProjectiveSpectrum.Basic
public import Mathlib.AlgebraicGeometry.Properties
public import StacksFrontier.AlgebraicGeometry.ProjPolyChart.Away
public import StacksFrontier.AlgebraicGeometry.ProjPolyChart.MapDomain
public import StacksFrontier.AlgebraicGeometry.Properties.Irreducible
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The standard affine cover of `Proj` of a polynomial ring

Grade `R[T₀, …, Tₙ]` by total degree. The standard opens `D₊(Tᵢ)` cover `Proj R[T]`, because a
homogeneous polynomial of positive degree lies in the ideal generated by the variables, so the
irrelevant ideal is contained in the span of the variables. There are `n + 1` of them and each
is affine, so `Proj R[T]` is quasi-compact.

When `R` is a domain the zero ideal is a point of `Proj R[T]` lying on every standard open, and
each standard open is the spectrum of a polynomial ring over `R`, hence irreducible and reduced.
So `Proj R[T]` is integral.

## Main definitions

* `Stacks.AlgebraicGeometry.ProjPolyChart.affineChartCover`: the affine open cover of
  `Proj R[T₀, …, Tₙ]` by the `n + 1` standard opens `D₊(Tᵢ)`.
* `Stacks.AlgebraicGeometry.ProjPolyChart.genericPoint`: over a domain, the point of
  `Proj R[T₀, …, Tₙ]` given by the zero ideal.

## Main results

* `Stacks.AlgebraicGeometry.ProjPolyChart.iSup_basicOpen_X_eq_top`: the standard opens cover.
* `Stacks.AlgebraicGeometry.ProjPolyChart.genericPoint_mem_basicOpen_X`: the zero ideal lies on
  every standard open, so the standard opens meet pairwise.
* `Stacks.AlgebraicGeometry.ProjPolyChart.isDomain_away`: a standard chart is the spectrum of a
  domain.
* `Stacks.AlgebraicGeometry.ProjPolyChart.eq_zero_of_mem_bot`: the zero homogeneous ideal
  contains only zero.
* `Stacks.AlgebraicGeometry.ProjPolyChart.compactSpace_proj`,
  `Stacks.AlgebraicGeometry.ProjPolyChart.isReduced_proj`,
  `Stacks.AlgebraicGeometry.ProjPolyChart.irreducibleSpace_proj` and
  `Stacks.AlgebraicGeometry.ProjPolyChart.isIntegral_proj`: `Proj R[T₀, …, Tₙ]` is quasi-compact,
  and over a domain it is integral.

## Implementation notes

The cover is Mathlib's `AlgebraicGeometry.Proj.affineOpenCoverOfIrrelevantLESpan` for the family
of variables, which is indexed by `Fin (n + 1)`; the finiteness of that index is what gives
quasi-compactness, through `AlgebraicGeometry.Scheme.OpenCover.compactSpace`.

Irreducibility is read off the criterion of Tag 01OM,
`AlgebraicGeometry.Scheme.irreducibleSpace_tfae`, whose index type must live in the same universe
as the scheme; the cover is therefore reindexed by `ULift (Fin (n + 1))` for that one application.

## References

* [Stacks Project, Tag 01OM](https://stacks.math.columbia.edu/tag/01OM)
* [Stacks Project, Tag 01MY](https://stacks.math.columbia.edu/tag/01MY)
-/

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits
open HomogeneousIdeal HomogeneousLocalization

namespace Stacks.AlgebraicGeometry.ProjPolyChart

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

variable (R : Type u) [CommRing R] (n : ℕ)

/-! ### The standard affine cover -/

/-- **The irrelevant ideal of `R[T₀, …, Tₙ]` is contained in the span of the variables.** A
homogeneous polynomial of positive degree has every monomial divisible by some variable. -/
public theorem irrelevant_le_span_X :
    (HomogeneousIdeal.irrelevant (polyGrading R n)).toIdeal ≤
      Ideal.span
        (Set.range (MvPolynomial.X : Fin (n + 1) → MvPolynomial (Fin (n + 1)) R)) :=
  (HomogeneousIdeal.toIdeal_irrelevant_le _).mpr fun _ hd _ hf => by
    simpa using homogeneous_mem_span_X R n hd hf

/-- **The standard opens `D₊(Tᵢ)` cover `Proj R[T₀, …, Tₙ]`.** -/
public theorem iSup_basicOpen_X_eq_top :
    (⨆ i : Fin (n + 1),
      AlgebraicGeometry.Proj.basicOpen (polyGrading R n) (MvPolynomial.X i)) = ⊤ :=
  AlgebraicGeometry.Proj.iSup_basicOpen_eq_top _ (fun i : Fin (n + 1) => MvPolynomial.X i)
    (irrelevant_le_span_X R n)

/-- **The standard affine cover of `Proj R[T₀, …, Tₙ]`**, by the `n + 1` standard opens
`D₊(Tᵢ)`, each the spectrum of the degree-zero localization `R[T]_{(Tᵢ)}`. -/
public def affineChartCover : (AlgebraicGeometry.Proj (polyGrading R n)).AffineOpenCover :=
  AlgebraicGeometry.Proj.affineOpenCoverOfIrrelevantLESpan (polyGrading R n)
    (fun i : Fin (n + 1) => MvPolynomial.X i) (fun i => X_mem_one R n i)
    (fun _ => Nat.one_pos) (irrelevant_le_span_X R n)

/-- The standard affine cover of `Proj R[T₀, …, Tₙ]` has finitely many members. -/
public instance finite_affineChartCover_I₀ : Finite (affineChartCover R n).I₀ := by
  change Finite (Fin (n + 1))
  infer_instance

/-- The open cover underlying the standard affine cover of `Proj R[T₀, …, Tₙ]` has finitely many
members. -/
public instance finite_affineChartCover_openCover_I₀ :
    Finite (affineChartCover R n).openCover.I₀ := by
  change Finite (Fin (n + 1))
  infer_instance

/-- The member of the standard affine cover indexed by `i` is `Spec R[T]_{(Tᵢ)}`. -/
public theorem affineChartCover_openCover_X (i : Fin (n + 1)) :
    (affineChartCover R n).openCover.X i =
      Spec (CommRingCat.of (Away (polyGrading R n) (MvPolynomial.X i))) :=
  rfl

/-- **`Proj R[T₀, …, Tₙ]` is quasi-compact**: it has a finite affine open cover. -/
public instance compactSpace_proj :
    CompactSpace (AlgebraicGeometry.Proj (polyGrading R n)) := by
  have h : ∀ i : Fin (n + 1),
      CompactSpace ((affineChartCover R n).openCover.X i) := fun i => by
    rw [affineChartCover_openCover_X]
    infer_instance
  exact @AlgebraicGeometry.Scheme.OpenCover.compactSpace _ (affineChartCover R n).openCover
    (finite_affineChartCover_openCover_I₀ R n) h

/-! ### The charts are spectra of polynomial rings -/

/-- **A standard chart of `Proj R[T₀, …, Tₙ]` over a domain is the spectrum of a domain.** The
chart ring is a polynomial ring in `n` variables over `R`. -/
public instance isDomain_away [IsDomain R] (i : Fin (n + 1)) :
    IsDomain (Away (polyGrading R n) (MvPolynomial.X i)) :=
  MulEquiv.isDomain (MvPolynomial {j : Fin (n + 1) // j ≠ i} R)
    (chartEquiv R n i).symm.toMulEquiv

/-- **`Proj R[T₀, …, Tₙ]` is reduced when `R` is a domain**: each standard chart is the spectrum
of a polynomial ring over `R`. -/
@[ega "II 3.1.13" "special case"]
public instance isReduced_proj [IsDomain R] :
    IsReduced (AlgebraicGeometry.Proj (polyGrading R n)) := by
  have h : ∀ i : Fin (n + 1),
      IsReduced ((affineChartCover R n).openCover.X i) := fun i => by
    rw [affineChartCover_openCover_X]
    infer_instance
  exact @AlgebraicGeometry.IsReduced.of_openCover _ (affineChartCover R n).openCover h

/-! ### The generic point -/

/-- The zero homogeneous ideal contains only zero. -/
public theorem eq_zero_of_mem_bot {x : MvPolynomial (Fin (n + 1)) R}
    (hx : x ∈ (⊥ : HomogeneousIdeal (polyGrading R n))) : x = 0 := by
  have hx' : x ∈ (⊥ : HomogeneousIdeal (polyGrading R n)).toIdeal :=
    HomogeneousIdeal.mem_iff.mpr hx
  rwa [HomogeneousIdeal.toIdeal_bot, Ideal.mem_bot] at hx'

/-- **The generic point of `Proj R[T₀, …, Tₙ]` over a domain**: the zero ideal, which is a
relevant homogeneous prime because the variables are homogeneous of positive degree and
nonzero. -/
public def genericPoint [IsDomain R] : AlgebraicGeometry.Proj (polyGrading R n) where
  asHomogeneousIdeal := ⊥
  isPrime := by
    rw [HomogeneousIdeal.toIdeal_bot]
    exact Ideal.isPrime_bot
  not_irrelevant_le := by
    intro h
    have hX : (MvPolynomial.X (0 : Fin (n + 1)) : MvPolynomial (Fin (n + 1)) R) ∈
        HomogeneousIdeal.irrelevant (polyGrading R n) :=
      HomogeneousIdeal.mem_irrelevant_of_mem _ Nat.one_pos (X_mem_one R n 0)
    exact MvPolynomial.X_ne_zero (0 : Fin (n + 1)) (eq_zero_of_mem_bot R n (h hX))

/-- **The generic point lies on every standard open.** The zero ideal contains no variable. -/
public theorem genericPoint_mem_basicOpen_X [IsDomain R] (i : Fin (n + 1)) :
    genericPoint R n ∈
      AlgebraicGeometry.Proj.basicOpen (polyGrading R n) (MvPolynomial.X i) := by
  rw [AlgebraicGeometry.Proj.mem_basicOpen]
  intro hmem
  rw [show (genericPoint R n).asHomogeneousIdeal = ⊥ from rfl] at hmem
  exact MvPolynomial.X_ne_zero i (eq_zero_of_mem_bot R n hmem)

/-! ### Integrality -/

/-- **`Proj R[T₀, …, Tₙ]` is irreducible when `R` is a domain.** The standard opens are affine,
irreducible, and all contain the zero ideal, so the criterion of Tag 01OM applies. -/
public instance irreducibleSpace_proj [IsDomain R] :
    IrreducibleSpace (AlgebraicGeometry.Proj (polyGrading R n)) := by
  refine ((AlgebraicGeometry.Scheme.irreducibleSpace_tfae
    (AlgebraicGeometry.Proj (polyGrading R n))).out 2 1).mp ?_
  refine ⟨ULift.{u} (Fin (n + 1)),
    fun i => AlgebraicGeometry.Proj.basicOpen (polyGrading R n) (MvPolynomial.X i.down),
    ⟨⟨0⟩⟩, ?_, ?_, ?_, ?_⟩
  · change (⨆ i : ULift.{u} (Fin (n + 1)),
      AlgebraicGeometry.Proj.basicOpen (polyGrading R n) (MvPolynomial.X i.down)) = ⊤
    rw [iSup_ulift
      (fun i : ULift.{u} (Fin (n + 1)) =>
        AlgebraicGeometry.Proj.basicOpen (polyGrading R n) (MvPolynomial.X i.down))]
    exact iSup_basicOpen_X_eq_top R n
  · intro i
    change IsAffineOpen
      (AlgebraicGeometry.Proj.basicOpen (polyGrading R n) (MvPolynomial.X i.down))
    rw [← AlgebraicGeometry.Proj.opensRange_awayι (polyGrading R n) (MvPolynomial.X i.down)
      (X_mem_one R n i.down) Nat.one_pos]
    exact isAffineOpen_opensRange _
  · intro i
    have hSpec : IrreducibleSpace
        (Spec (CommRingCat.of (Away (polyGrading R n) (MvPolynomial.X i.down)))) := by
      change IrreducibleSpace
        (PrimeSpectrum (Away (polyGrading R n) (MvPolynomial.X i.down)))
      infer_instance
    exact ((AlgebraicGeometry.Proj.basicOpenIsoSpec (polyGrading R n)
      (MvPolynomial.X i.down) (X_mem_one R n i.down)
      Nat.one_pos).hom.homeomorph.irreducibleSpace_iff).mpr hSpec
  · intro i j
    exact ⟨genericPoint R n, genericPoint_mem_basicOpen_X R n i.down,
      genericPoint_mem_basicOpen_X R n j.down⟩

/-- **`Proj R[T₀, …, Tₙ]` is integral when `R` is a domain.** -/
public instance isIntegral_proj [IsDomain R] :
    IsIntegral (AlgebraicGeometry.Proj (polyGrading R n)) :=
  (AlgebraicGeometry.isIntegral_iff_irreducibleSpace_and_isReduced _).2
    ⟨inferInstance, inferInstance⟩

end Stacks.AlgebraicGeometry.ProjPolyChart

end
