module

public import StacksFrontier.AlgebraicGeometry.ProjPolyChart.Away
public import StacksFrontier.AlgebraicGeometry.ProjShared.MapDomain
public import Mathlib.RingTheory.MvPolynomial.Ideal

/-!
# Changing the coefficients of a graded polynomial ring

A ring homomorphism `c : R → R'` induces, by acting on coefficients, a homomorphism of the
total-degree gradings of `R[T₀, …, Tₙ]` and `R'[T₀, …, Tₙ]`. This file records that the induced
homomorphism satisfies the hypothesis of `AlgebraicGeometry.Proj.map`, so that it induces a
morphism `Proj R'[T] ⟶ Proj R[T]` defined on all of `Proj R'[T]`.

## Main definitions

* `Stacks.AlgebraicGeometry.ProjPolyChart.coeffGradedHom`: coefficient change as a homomorphism
  of graded rings.
* `Stacks.AlgebraicGeometry.ProjPolyChart.integralCoeffHom`: the coefficient homomorphism
  `ULift ℤ → R` out of the canonical universe copy of the integers, which is the one the
  comparison of the base-change and polynomial models of projective space is pinned by.

## Main results

* `Stacks.AlgebraicGeometry.ProjPolyChart.mem_span_X_of_mem_homogeneousSubmodule`: a homogeneous
  polynomial of positive degree lies in the ideal generated by the variables, for an arbitrary
  index type, and `Stacks.AlgebraicGeometry.ProjPolyChart.homogeneous_mem_span_X` its
  `Fin (n + 1)` case.
* `Stacks.AlgebraicGeometry.ProjPolyChart.irrelevant_le_map_coeffGradedHom`: Mathlib's
  hypothesis for `AlgebraicGeometry.Proj.map` holds for coefficient change.
* `Stacks.AlgebraicGeometry.ProjPolyChart.mapDomain_coeffGradedHom_eq_top`: consequently the
  open of Tag 01MY on which the homomorphism is defined is all of `Proj R'[T]`.

## Implementation notes

The irrelevant ideal of `R'[T]` is generated by the homogeneous elements of positive degree, and
the image of the irrelevant ideal of `R[T]` contains every variable, because coefficient change
fixes the variables. So the containment reduces to the statement that a homogeneous polynomial
of positive degree lies in the ideal generated by the variables, which is
`homogeneous_mem_span_X`: every monomial of such a polynomial has some exponent nonzero, and
Mathlib's `MvPolynomial.mem_ideal_span_X_image` turns that into membership. The reduction itself
is this repository's `Stacks.AlgebraicGeometry.ProjShared.irrelevant_le_map_of_mem_span`, which
quantifies only over homogeneous elements.

## References

* [Stacks Project, Tag 01MY](https://stacks.math.columbia.edu/tag/01MY)
* [Stacks Project, Tag 01NF](https://stacks.math.columbia.edu/tag/01NF)
-/

@[expose] public noncomputable section

open MvPolynomial HomogeneousLocalization AlgebraicGeometry

namespace Stacks.AlgebraicGeometry.ProjPolyChart

universe u

attribute [local instance] MvPolynomial.gradedAlgebra

/-- **A homogeneous polynomial of positive degree lies in the ideal generated by the
variables**: each of its monomials has a nonzero exponent. The index type is arbitrary. -/
public theorem mem_span_X_of_mem_homogeneousSubmodule {σ : Type*} {A : Type*} [CommRing A]
    {d : ℕ} (hd : 0 < d) {p : MvPolynomial σ A}
    (hp : p ∈ MvPolynomial.homogeneousSubmodule σ A d) :
    p ∈ Ideal.span (Set.range (MvPolynomial.X : σ → MvPolynomial σ A)) := by
  rw [← Set.image_univ, MvPolynomial.mem_ideal_span_X_image]
  intro m hm
  have hsum := (MvPolynomial.mem_homogeneousSubmodule _ _).1 hp (MvPolynomial.mem_support_iff.1 hm)
  have hmne : m ≠ 0 := by
    intro h
    rw [h] at hsum
    exact absurd hsum (by simp; omega)
  obtain ⟨j, hj⟩ := Finsupp.ne_iff.mp hmne
  exact ⟨j, Set.mem_univ j, by simpa using hj⟩

variable (R : Type u) [CommRing R] (n : ℕ)

/-- A homogeneous polynomial of positive degree lies in the ideal generated by the variables,
for the variables of projective `n`-space. This is the `Fin (n + 1)` case of
`Stacks.AlgebraicGeometry.ProjPolyChart.mem_span_X_of_mem_homogeneousSubmodule`. -/
public theorem homogeneous_mem_span_X {d : ℕ} (hd : 0 < d) {p : MvPolynomial (Fin (n + 1)) R}
    (hp : p ∈ polyGrading R n d) :
    p ∈ Ideal.span (Set.range
      (MvPolynomial.X : Fin (n + 1) → MvPolynomial (Fin (n + 1)) R)) :=
  mem_span_X_of_mem_homogeneousSubmodule hd hp

variable {R' : Type u} [CommRing R']

/-- Coefficient change as a homomorphism of graded rings: acting on coefficients does not change
the total degree of a monomial. -/
public def coeffGradedHom (c : R →+* R') : polyGrading R n →+*ᵍ polyGrading R' n where
  toRingHom := MvPolynomial.map c
  map_mem hx := MvPolynomial.IsHomogeneous.map hx c

/-- The graded coefficient change `coeffGradedHom R n c` acts on a polynomial as
`MvPolynomial.map c`. -/
@[simp] public theorem coeffGradedHom_apply (c : R →+* R')
    (p : MvPolynomial (Fin (n + 1)) R) :
    coeffGradedHom R n c p = MvPolynomial.map c p :=
  rfl

/-- **Mathlib's hypothesis for `AlgebraicGeometry.Proj.map`, for coefficient change.** The
irrelevant ideal of the target lies in the image of the irrelevant ideal of the source, because
the image contains every variable. -/
public theorem irrelevant_le_map_coeffGradedHom (c : R →+* R') :
    HomogeneousIdeal.irrelevant (polyGrading R' n) ≤
      (HomogeneousIdeal.irrelevant (polyGrading R n)).map (coeffGradedHom R n c) := by
  refine Stacks.AlgebraicGeometry.ProjShared.irrelevant_le_map_of_mem_span _ _ _
    (fun d hd g hg => ?_)
  refine Ideal.span_mono ?_ (homogeneous_mem_span_X R' n hd hg)
  rintro _ ⟨j, rfl⟩
  exact ⟨MvPolynomial.X j, Set.mem_biUnion (Set.mem_Ioi.mpr Nat.zero_lt_one)
    ((MvPolynomial.mem_homogeneousSubmodule _ _).2 (MvPolynomial.isHomogeneous_X _ _)),
    by simp⟩

/-- **The open of Tag 01MY for coefficient change is everything.** Coefficient change induces a
morphism `Proj R'[T] ⟶ Proj R[T]` defined on all of `Proj R'[T]`. -/
public theorem mapDomain_coeffGradedHom_eq_top (c : R →+* R') :
    Stacks.AlgebraicGeometry.ProjShared.mapDomain (polyGrading R n) (polyGrading R' n)
      (coeffGradedHom R n c) = ⊤ :=
  Stacks.AlgebraicGeometry.ProjShared.mapDomain_eq_top_of_irrelevant_le_map _ _ _
    (irrelevant_le_map_coeffGradedHom R n c)

/-- The canonical coefficient homomorphism out of the universe copy of the integers. This is the
map that pins the comparison between the base-change and polynomial models of projective
space: it preserves each named homogeneous coordinate. -/
public def integralCoeffHom (S : Type u) [CommRing S] : ULift.{u} ℤ →+* S :=
  (Int.castRingHom S).comp ULift.ringEquiv.toRingHom

/-- The graded coefficient homomorphism of the comparison of the two models of projective
`n`-space, acting on polynomials by `MvPolynomial.map` of the canonical coefficient map. -/
public def integralGradedHom (S : Type u) [CommRing S] (m : ℕ) :
    polyGrading (ULift.{u} ℤ) m →+*ᵍ polyGrading S m :=
  coeffGradedHom (ULift.{u} ℤ) m (integralCoeffHom S)

/-- The graded homomorphism `integralGradedHom S m` acts on a polynomial as `MvPolynomial.map` of
the cast `ULift ℤ → S`. -/
@[simp] public theorem integralGradedHom_apply (S : Type u) [CommRing S] (m : ℕ)
    (F : MvPolynomial (Fin (m + 1)) (ULift.{u} ℤ)) :
    integralGradedHom S m F =
      MvPolynomial.map ((Int.castRingHom S).comp ULift.ringEquiv.toRingHom) F :=
  rfl

/-- The open of Tag 01MY for the comparison's coefficient homomorphism is everything: this is the
`domain_eq_top` clause of the comparison of the two models of projective `n`-space. -/
public theorem mapDomain_integralGradedHom_eq_top (S : Type u) [CommRing S] (m : ℕ) :
    Stacks.AlgebraicGeometry.ProjShared.mapDomain (polyGrading (ULift.{u} ℤ) m)
      (polyGrading S m) (integralGradedHom S m) = ⊤ :=
  mapDomain_coeffGradedHom_eq_top _ _ _

/-! ### Base change of the standard affine chart -/

/-- Coefficient change on the standard affine chart `R[T]_{(Tᵢ)} → R'[T]_{(Tᵢ)}`. The powers of
`Tᵢ` are preserved by coefficient change, so the homogeneous localization at them maps across
without changing the denominator's name. -/
public def chartBaseChange (c : R →+* R') (i : Fin (n + 1)) :
    Away (polyGrading R n) (MvPolynomial.X i) →+*
      Away (polyGrading R' n) (MvPolynomial.X i) :=
  HomogeneousLocalization.map (coeffGradedHom R n c) (by
    rintro x ⟨k, rfl⟩
    exact ⟨k, by simp⟩)

/-- On a fraction, chart base change acts on the numerator's coefficients. -/
public theorem chartBaseChange_mk (c : R →+* R') (i : Fin (n + 1)) (k : ℕ)
    (a : MvPolynomial (Fin (n + 1)) R) (ha : a ∈ polyGrading R n (k • 1))
    (ha' : MvPolynomial.map c a ∈ polyGrading R' n (k • 1)) :
    chartBaseChange R n c i (Away.mk (polyGrading R n) (X_mem_one R n i) k a ha) =
      Away.mk (polyGrading R' n) (X_mem_one R' n i) k (MvPolynomial.map c a) ha' := by
  have hmem : MvPolynomial.map c (MvPolynomial.X i ^ k) ∈
      Submonoid.powers (MvPolynomial.X i : MvPolynomial (Fin (n + 1)) R') := ⟨k, by simp⟩
  have hLHS : (chartBaseChange R n c i
      (Away.mk (polyGrading R n) (X_mem_one R n i) k a ha)).val
      = Localization.mk (MvPolynomial.map c a)
          ⟨MvPolynomial.map c (MvPolynomial.X i ^ k), hmem⟩ := rfl
  rw [HomogeneousLocalization.ext_iff_val, Away.val_mk, hLHS]
  congr 1
  exact Subtype.ext (by simp)

/-- Chart base change sends a fraction to the fraction of any numerator equal to the image of the
original one. -/
private theorem chartBaseChange_mk_of_map_eq (c : R →+* R') (i : Fin (n + 1)) {k : ℕ}
    {a : MvPolynomial (Fin (n + 1)) R} {b : MvPolynomial (Fin (n + 1)) R'}
    {ha : a ∈ polyGrading R n (k • 1)} {hb : b ∈ polyGrading R' n (k • 1)}
    (h : MvPolynomial.map c a = b) :
    chartBaseChange R n c i (Away.mk (polyGrading R n) (X_mem_one R n i) k a ha) =
      Away.mk (polyGrading R' n) (X_mem_one R' n i) k b hb := by
  subst h
  exact chartBaseChange_mk R n c i k a ha hb

/-- Chart base change is compatible with the two coefficient inclusions. -/
public theorem chartBaseChange_coeffToAway (c : R →+* R') (i : Fin (n + 1)) (r : R) :
    chartBaseChange R n c i (coeffToAway R n i r) = coeffToAway R' n i (c r) := by
  rw [coeffToAway_eq_mk, coeffToAway_eq_mk]
  exact chartBaseChange_mk_of_map_eq R n c i (MvPolynomial.map_C c r)

/-- Chart base change fixes the affine coordinates. -/
public theorem chartBaseChange_chartCoord (c : R →+* R') (i : Fin (n + 1))
    (j : {j : Fin (n + 1) // j ≠ i}) :
    chartBaseChange R n c i (chartCoord R n i j) = chartCoord R' n i j :=
  chartBaseChange_mk_of_map_eq R n c i (MvPolynomial.map_X c j.1)

/-- **The chart identification is natural in the coefficient ring.** Under the identification of
the standard affine chart with a polynomial ring on the affine coordinates, coefficient change
on the chart is coefficient change on that polynomial ring. -/
public theorem chartBaseChange_chartHom (c : R →+* R') (i : Fin (n + 1))
    (p : MvPolynomial {j : Fin (n + 1) // j ≠ i} R) :
    chartBaseChange R n c i (chartHom R n i p) =
      chartHom R' n i (MvPolynomial.map c p) := by
  have h : (chartBaseChange R n c i).comp (chartHom R n i)
      = (chartHom R' n i).comp (MvPolynomial.map c) := by
    refine MvPolynomial.ringHom_ext (fun r => ?_) (fun j => ?_)
    · rw [RingHom.comp_apply, RingHom.comp_apply, chartHom_C, chartBaseChange_coeffToAway,
        MvPolynomial.map_C, chartHom_C]
    · rw [RingHom.comp_apply, RingHom.comp_apply, chartHom_X, chartBaseChange_chartCoord,
        MvPolynomial.map_X, chartHom_X]
  exact congrArg (fun f => f p) h

end Stacks.AlgebraicGeometry.ProjPolyChart

end
