attribute [local implicit_reducible] TopCat.Sheaf sheafCompose

variable {S : Type u} {σ : Type w} [CommRing S] [SetLike σ S] [AddSubgroupClass σ S]
  (𝒮 : ℕ → σ) [GradedRing 𝒮]

/-! ### Naturality of the pullback on global sections

`pullbackGlobalSections` is natural in the module. Proving it needs care about transparency, and
the shape used here is forced; the facts below are elaboration facts, not matters of style.

The sections `Γ(M, U)` of a module sheaf on a scheme are an object of `AddCommGrpCat`, reached
through the semireducible `Scheme.Modules.presheaf`, whereas `M.val.obj (op U)` is an object of
`ModuleCat` with the same carrier. The two therefore have equal elements but are not
interchangeable as objects, and a goal mixing them is not type-correct at `implicit`
transparency. The consequences, on the unfolded goal:

* plain `simp` makes *no progress whatsoever*, so no amount of simp-lemma hunting helps;
* `rw` fails even with `Category.assoc`, reporting "did not find an occurrence of the pattern"
  against a target in which the pattern is plainly visible;
* marking `Scheme.Modules`, `Scheme.Modules.presheaf` or `AlgebraicGeometry.Proj`
  `implicit_reducible` does not help, and adding `Proj` actively breaks the proof.

The remedy avoids a transparency option. `pullbackGlobalSections_paste` is the whole rewriting
half of the argument, stated
over *variable* morphisms whose types are written out; its goal is type-correct at `implicit`
transparency, so `rw` works normally inside it. Everything above it is assembled in term mode —
`congrArg`, `Eq.trans` — which elaborates at default transparency and so sees through
`Scheme.Modules.presheaf` without being asked to. -/

/-- Pasting the two naturality squares that make up `pullbackGlobalSections`: the unit of the
pullback-pushforward adjunction over the whole space, and the restriction along
`f ⁻¹ᵁ ⊤ = ⊤`.

This is pure category theory and says nothing about `Proj`; it exists so that the associativity
rewriting happens over variables whose types are already the written ones. -/
private theorem pullbackGlobalSections_paste {X Y : Scheme.{u}} (f : X ⟶ Y)
    {F G : Y.Modules} (φ : F ⟶ G) {A : X.Opens}
    (uF : Γ(F, ⊤) ⟶ Γ((Scheme.Modules.pullback f).obj F, A))
    (uG : Γ(G, ⊤) ⟶ Γ((Scheme.Modules.pullback f).obj G, A))
    (rF : Γ((Scheme.Modules.pullback f).obj F, A) ⟶ Γ((Scheme.Modules.pullback f).obj F, ⊤))
    (rG : Γ((Scheme.Modules.pullback f).obj G, A) ⟶ Γ((Scheme.Modules.pullback f).obj G, ⊤))
    (hA : uF ≫ ((Scheme.Modules.pullback f).map φ).app A = φ.app ⊤ ≫ uG)
    (hB : rF ≫ ((Scheme.Modules.pullback f).map φ).app ⊤ =
      ((Scheme.Modules.pullback f).map φ).app A ≫ rG) :
    (uF ≫ rF) ≫ ((Scheme.Modules.pullback f).map φ).app ⊤ = φ.app ⊤ ≫ (uG ≫ rG) := by
  rw [Category.assoc, hB, ← Category.assoc, hA, Category.assoc]

/-- Pulling back global sections is natural in the module, as a square of maps on sections. -/
public theorem pullbackGlobalSections_naturality_app {X Y : Scheme.{u}} (f : X ⟶ Y)
    {F G : Y.Modules} (φ : F ⟶ G) :
    pullbackGlobalSections f F ≫ ((Scheme.Modules.pullback f).map φ).app ⊤ =
      φ.app ⊤ ≫ pullbackGlobalSections f G :=
  pullbackGlobalSections_paste f φ _ _ _ _
    (congrArg (fun q => Scheme.Modules.Hom.app q (⊤ : Y.Opens))
      ((Scheme.Modules.pullbackPushforwardAdjunction f).unit_naturality φ))
    ((((Scheme.Modules.pullback f).map φ).mapPresheaf).naturality _)

/-- Pulling back global sections commutes with a morphism of modules on the target. -/
public theorem pullbackGlobalSections_naturality {X Y : Scheme.{u}} (f : X ⟶ Y)
    {F G : Y.Modules} (φ : F ⟶ G) (s : Γ(F, ⊤)) :
    pullbackGlobalSections f G (φ.app ⊤ s) =
      ((Scheme.Modules.pullback f).map φ).app ⊤ (pullbackGlobalSections f F s) :=
  (ConcreteCategory.comp_apply (φ.app ⊤) (pullbackGlobalSections f G) s).symm.trans
    ((ConcreteCategory.congr_hom (pullbackGlobalSections_naturality_app f φ) s).symm.trans
      (ConcreteCategory.comp_apply (pullbackGlobalSections f F)
        (((Scheme.Modules.pullback f).map φ).app ⊤) s))

/-! ### The degreewise vanishing predicate

The equation map of a single degree is packaged as an additive homomorphism `equationHom`.
This is not cosmetic. The sections `Γ(i^* 𝒪(n), ⊤)` are reached from `(Proj 𝒮).Modules` only by
unfolding `Proj`, so a goal mentioning them is not type-correct at `implicit` transparency, and
neither `rw` nor `simp` can instantiate a lemma such as `map_add` against it. Recording the type
once, in the type of `equationHom`, puts the whole degreewise argument inside an ordinary
`AddMonoidHom` where the usual `map_zero`/`map_add` rewriting works. -/

/-- The equation map in degree `n`: a homogeneous element of degree `n` is sent to the
pullback to `Z` of the global section of `𝒪(n)` it determines. -/
private def equationHom {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) (n : ℕ) :
    𝒮 n →+ Γ((Scheme.Modules.pullback i).obj (twistingSheaf 𝒮 (n : ℤ)), ⊤) :=
  AddMonoidHom.comp
    (AddMonoidHom.mk' (fun s => pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ)) s)
      (fun s t => map_add (ConcreteCategory.hom
        (pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ)))) s t))
    (degreeSectionHom 𝒮 n)

private theorem equationHom_apply {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) (n : ℕ) (a : 𝒮 n) :
    equationHom 𝒮 i n a =
      pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ)) (degreeSection 𝒮 n a) := rfl

/-- An element of `S` all of whose homogeneous components are equations for `Z`. -/
private def ComponentsVanish {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) (a : S) : Prop :=
  ∀ n : ℕ, equationHom 𝒮 i n ((DirectSum.decompose 𝒮 a) n) = 0

private theorem componentsVanish_zero {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) :
    ComponentsVanish 𝒮 i (0 : S) := by
  intro n
  rw [decompose_zero, DFinsupp.zero_apply]
  exact map_zero _

private theorem componentsVanish_add {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) {a b : S}
    (ha : ComponentsVanish 𝒮 i a) (hb : ComponentsVanish 𝒮 i b) :
    ComponentsVanish 𝒮 i (a + b) := by
  intro n
  rw [decompose_add, DFinsupp.add_apply, map_add, ha n, hb n, add_zero]

/-- Multiplying an equation for `Z` of degree `p` by a homogeneous element of degree `m` gives
an equation for `Z` of degree `p + m`.

This is the naturality of `degreeZeroToGlobalSections` (Tag 01M7) along multiplication by the
homogeneous element, which is a degree-preserving map from the `p`-th shift of the regular
graded module to its `k`-th shift, followed by `pullbackGlobalSections_naturality`. -/
private theorem equationHom_mul_left {Z : Scheme.{u}}
    (i : Z ⟶ Proj 𝒮) (b : S) (m p k : ℕ) (hb : b ∈ 𝒮 m) (hpk : p + m = k) (x : 𝒮 p)
    (y : 𝒮 k) (hy : (y : S) = b * x) (hx : equationHom 𝒮 i p x = 0) :
    equationHom 𝒮 i k y = 0 := by
  obtain ⟨y, hyk⟩ := y
  obtain rfl : y = b * x := hy
  have hx' : pullbackGlobalSections i (twistingSheaf 𝒮 (p : ℤ)) (degreeSection 𝒮 p x) = 0 := hx
  set M : ℤ → Submodule ℤ S := twistGrading (S := S) 𝒮 (p : ℤ) with hM
  set N : ℤ → Submodule ℤ S := twistGrading (S := S) 𝒮 (k : ℤ) with hN
  -- multiplication by `b`, as a degree-preserving map from the `p`-th to the `k`-th shift
  have hφ : ∀ (j : ℤ) (y : S), y ∈ M j → LinearMap.mulLeft S b y ∈ N j := by
    intro j y hy
    have h := SetLike.GradedSMul.smul_mem (A := 𝒮) (B := M) hb hy
    have hidx : M ((m : ℕ) +ᵥ j) = N j := by
      show integerGrading (S := S) 𝒮 ((m : ℤ) + j + (p : ℤ)) =
        integerGrading (S := S) 𝒮 (j + (k : ℤ))
      congr 1
      omega
    rw [← hidx]
    simpa [smul_eq_mul, LinearMap.mulLeft_apply] using h
  have hnat := degreeZeroToGlobalSections_naturality (𝒮 := 𝒮) (𝒨 := M) (𝒩 := N)
    (LinearMap.mulLeft S b) hφ ⟨(x : S), by simp [hM]⟩
  have hmap : (associatedModuleSheafMap 𝒮 M N (LinearMap.mulLeft S b) hφ).val.app (op ⊤)
      (degreeSection 𝒮 p x) =
      degreeSection 𝒮 k ⟨b * x, hyk⟩ := by
    simpa [degreeSection, hM, hN, LinearMap.mulLeft_apply] using hnat
  have hpull := pullbackGlobalSections_naturality i
    (associatedModuleSheafMap 𝒮 M N (LinearMap.mulLeft S b) hφ) (degreeSection 𝒮 p x)
  rw [equationHom_apply, ← hmap, show pullbackGlobalSections i (twistingSheaf 𝒮 (k : ℤ))
      ((associatedModuleSheafMap 𝒮 M N (LinearMap.mulLeft S b) hφ).val.app (op ⊤)
        (degreeSection 𝒮 p x)) = _ from hpull, hx']
  exact map_zero _

/-! ### Homogeneous components of a product -/

private theorem proj_mul_of_le (a b : S) (j n : ℕ) (hb : b ∈ 𝒮 j) (hle : j ≤ n) :
    GradedRing.proj 𝒮 n (a * b) = GradedRing.proj 𝒮 (n - j) a * b := by
  have hnj : n - j + j = n := by omega
  rw [GradedRing.proj_apply, GradedRing.proj_apply]
  conv_lhs => rw [← hnj]
  rw [DirectSum.coe_decompose_mul_add_of_right_mem 𝒮 hb]

private theorem proj_mul_of_lt (a b : S) (j n : ℕ) (hb : b ∈ 𝒮 j) (hlt : n < j) :
    GradedRing.proj 𝒮 n (a * b) = 0 := by
  classical
  conv_lhs => rw [← DirectSum.sum_support_decompose 𝒮 a, Finset.sum_mul]
  rw [map_sum]
  refine Finset.sum_eq_zero fun p _ => ?_
  rw [GradedRing.proj_apply]
  exact DirectSum.decompose_of_mem_ne 𝒮
    (SetLike.mul_mem_graded (SetLike.coe_mem ((DirectSum.decompose 𝒮 a) p)) hb)
    (j := n) (by omega)

private theorem componentsVanish_mul_homogeneous {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) {a b : S}
    (ha : ComponentsVanish 𝒮 i a) (m : ℕ) (hb : b ∈ 𝒮 m) :
    ComponentsVanish 𝒮 i (b * a) := by
  classical
  intro n
  by_cases hle : m ≤ n
  · refine equationHom_mul_left 𝒮 i b m (n - m) n hb (Nat.sub_add_cancel hle)
      ((DirectSum.decompose 𝒮 a) (n - m)) _ ?_ (ha (n - m))
    show GradedRing.proj 𝒮 n (b * a) = b * GradedRing.proj 𝒮 (n - m) a
    rw [mul_comm b a, proj_mul_of_le 𝒮 a b m n hb hle, mul_comm]
  · have hcomp : (DirectSum.decompose 𝒮 (b * a)) n = 0 := by
      apply Subtype.ext
      show GradedRing.proj 𝒮 n (b * a) = 0
      rw [mul_comm b a]
      exact proj_mul_of_lt 𝒮 a b m n hb (by omega)
    rw [hcomp]
    exact map_zero _

private theorem componentsVanish_mul_left {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) {a c : S}
    (ha : ComponentsVanish 𝒮 i a) : ComponentsVanish 𝒮 i (c * a) := by
  induction c using DirectSum.Decomposition.inductionOn 𝒮 with
  | zero => simpa [zero_mul] using componentsVanish_zero 𝒮 i
  | @homogeneous m b => exact componentsVanish_mul_homogeneous 𝒮 i ha m b.2
  | add b c hb hc =>
    rw [add_mul]
    exact componentsVanish_add 𝒮 i hb hc

/-! ### The ideal of a closed subscheme -/

/-- **Stacks 0BXK.** The homogeneous ideal of a closed subscheme of `Proj 𝒮`, generated by the
homogeneous elements whose canonical twisted global section pulls back to zero on the
subscheme. -/
@[stacks 0BXK "ideal_of_a_closed_subscheme"]
public def idealOfClosedSubscheme {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮) [IsClosedImmersion i] :
    Ideal S :=
  Ideal.span {a : S | ∃ (n : ℕ) (b : 𝒮 n), (b : S) = a ∧
    pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ)) (degreeSection 𝒮 n b) = 0}

/-- **Stacks 0BXK.** An element lies in the ideal of `Z` exactly when the section attached to
each of its homogeneous components pulls back to zero on `Z`.

In particular the span of the homogeneous equations is the kernel of the canonical graded map
to the twisted global sections, in every degree and also on inhomogeneous elements. -/
@[stacks 0BXK "ideal_of_a_closed_subscheme"]
public theorem mem_idealOfClosedSubscheme_iff {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮)
    [IsClosedImmersion i] (a : S) :
    a ∈ idealOfClosedSubscheme 𝒮 i ↔
      ∀ n : ℕ, pullbackGlobalSections i (twistingSheaf 𝒮 (n : ℤ))
        (degreeSection 𝒮 n ((DirectSum.decompose 𝒮 a) n)) = 0 := by
  classical
  constructor
  · intro ha
    refine Submodule.span_induction (p := fun x _ => ComponentsVanish 𝒮 i x) ?_ ?_ ?_ ?_ ha
    · rintro x ⟨n, b, rfl, hb⟩ k
      by_cases hk : k = n
      · subst k
        rw [show (DirectSum.decompose 𝒮 (b : S)) n = b from
          Subtype.ext (DirectSum.decompose_of_mem_same 𝒮 b.2)]
        exact hb
      · rw [show (DirectSum.decompose 𝒮 (b : S)) k = 0 from
          Subtype.ext (DirectSum.decompose_of_mem_ne 𝒮 b.2 (Ne.symm hk))]
        exact map_zero _
    · exact componentsVanish_zero 𝒮 i
    · exact fun x y _ _ hx hy => componentsVanish_add 𝒮 i hx hy
    · exact fun c x _ hx => componentsVanish_mul_left 𝒮 i hx
  · intro hvan
    rw [idealOfClosedSubscheme, ← DirectSum.sum_support_decompose 𝒮 a]
    exact Ideal.sum_mem _ fun n _ =>
      Ideal.subset_span ⟨n, (DirectSum.decompose 𝒮 a) n, rfl, hvan n⟩

/-- **Stacks 0BXK.** The ideal of a closed subscheme is homogeneous. -/
@[stacks 0BXK "ideal_of_a_closed_subscheme"]
public theorem idealOfClosedSubscheme_isHomogeneous {Z : Scheme.{u}} (i : Z ⟶ Proj 𝒮)
    [IsClosedImmersion i] : (idealOfClosedSubscheme 𝒮 i).IsHomogeneous 𝒮 := by
  rw [idealOfClosedSubscheme]
  refine Ideal.homogeneous_span 𝒮 _ ?_
  rintro a ⟨n, b, rfl, -⟩
  exact ⟨n, b.2⟩

end Stacks.AlgebraicGeometry.IdealOfClosedSubscheme

end
