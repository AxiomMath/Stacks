module

public import StacksFrontier.AlgebraicGeometry.Chow.VectorBundleKZeroPullbackComp
public import StacksFrontier.AlgebraicGeometry.Recovery27.GrassmannianScheme

/-!
# The class of the universal quotient of the Grassmannian in `K₀(Vect(-))`

A point of the Grassmannian functor `G(k, n)` with values in a scheme `S` is an isomorphism class
of finite locally free rank-`n - k` quotients `𝒪_S^{⊕n} ⟶ 𝒬`. Isomorphic quotients have the
same class `[𝒬]` in the Grothendieck ring `K₀(Vect(S))`, so a point has a class, and taking classes
commutes with pullback.

The Grassmannian `G(k, n)` over the integers represents the functor; the point corresponding to
its identity morphism is the *universal quotient*. Every quotient `𝒪_S^{⊕n} ⟶ 𝒬` on a scheme `S`
is the pullback of the universal quotient along the morphism `g : S ⟶ G(k, n)` it classifies, so
`[𝒬] = g^*[𝒬_univ]` in `K₀(Vect(S))`. This is the form in which the proof of
[Stacks, Tag 0FIR] uses the Grassmannian: a finite locally free module generated by `n` global
sections has its class pulled back from a Grassmannian.

## Main definitions

* `AlgebraicGeometry.Grassmannian.Points.classOf`: the class in `K₀(Vect(S))` of a point of
  `G(k, n)` with values in `S`.
* `AlgebraicGeometry.Grassmannian.pointsEquiv`: the values of the Grassmannian functor are the
  isomorphism classes of quotient presentations.
* `AlgebraicGeometry.Grassmannian.universalPoint`: the universal point, with values in the
  Grassmannian itself.
* `AlgebraicGeometry.Grassmannian.universalClass`: the class of the universal quotient.
* `AlgebraicGeometry.Grassmannian.classifyingMap`: the morphism to the Grassmannian classifying a
  quotient presentation.

## Main results

* `AlgebraicGeometry.Grassmannian.Points.classOf_pullbackPointsMap`: taking classes commutes with
  pullback.
* `AlgebraicGeometry.Grassmannian.pullbackRingHom_classifyingMap_universalClass`:
  `g^*[𝒬_univ] = [𝒬]` for the classifying morphism `g` of a quotient `𝒪^{⊕n} ⟶ 𝒬`.
* `AlgebraicGeometry.Grassmannian.exists_pullbackRingHom_universalClass_eq_classOf`: every
  finite locally free module of rank `n - k` that is a quotient of `𝒪^{⊕n}` has its class
  pulled back from `G(k, n)`.

## References

* [Stacks Project, Tag 089S](https://stacks.math.columbia.edu/tag/089S)
* [Stacks Project, Tag 089T](https://stacks.math.columbia.edu/tag/089T)
* [Stacks Project, Tag 0FIR](https://stacks.math.columbia.edu/tag/0FIR)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite AlgebraicGeometry.VectorBundleKZero

universe u

namespace AlgebraicGeometry.Grassmannian

variable {S T : Scheme.{u}} {k n : ℕ}

/-- The target of a quotient presentation is finite locally free, at the spelling of finite
local freeness `K₀(Vect(S))` is built over. -/
theorem QuotientPresentation.isFiniteLocallyFree_target (q : QuotientPresentation S k n) :
    Stacks.FiniteLocallyFree.IsFiniteLocallyFree.{u, u, u} (R := S.ringCatSheaf) q.target :=
  have := q.finiteLocallyFree
  have := AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.isFiniteLocallyFree
    q.target (n - k)
  Stacks.StalkFreeBridge.finiteLocallyFree_isFiniteLocallyFree _

/-- Quotient presentations that are related by the equivalence relation generated by
isomorphisms have targets with the same class. -/
theorem classOf_target_eq_of_eqvGen {q q' : QuotientPresentation S k n}
    (h : Relation.EqvGen QuotientPresentation.Isomorphic q q') :
    classOf S q.target = classOf S q'.target := by
  induction h with
  | rel a b hab =>
    obtain ⟨e, -⟩ := hab
    exact classOf_eq_of_iso e a.isFiniteLocallyFree_target
  | refl => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- **The class of a point of the Grassmannian functor**: the class in `K₀(Vect(S))` of the
target of any quotient presentation representing it. -/
def Points.classOf (x : Points S k n) : VectorBundleKZero S :=
  Quotient.lift (fun q : QuotientPresentation S k n => VectorBundleKZero.classOf S q.target)
    (fun _ _ h => classOf_target_eq_of_eqvGen h) x

/-- The class of the point represented by a quotient presentation `q` is the class of the
target of `q`. -/
@[simp] theorem Points.classOf_mk (q : QuotientPresentation S k n) :
    Points.classOf (⟦q⟧ : Points S k n) = VectorBundleKZero.classOf S q.target :=
  rfl

/-- If `q'` is obtained from `q` by pullback along `f`, the class of `q'` is the pullback of the
class of `q`. -/
theorem QuotientPresentation.IsPullback.classOf_target {f : T ⟶ S}
    {q : QuotientPresentation S k n} {q' : QuotientPresentation T k n} (h : q.IsPullback f q') :
    VectorBundleKZero.classOf T q'.target =
      pullbackRingHom f (VectorBundleKZero.classOf S q.target) := by
  obtain ⟨e, -⟩ := h
  rw [pullbackRingHom_classOf f _ q.isFiniteLocallyFree_target]
  exact (classOf_eq_of_iso e (isFiniteLocallyFree_pullback f _ q.isFiniteLocallyFree_target)).symm

/-- **Taking classes commutes with pullback**: the class of the pullback of a point along
`f : T ⟶ S` is `f^*` of its class. -/
theorem Points.classOf_pullbackPointsMap (f : T ⟶ S) (x : Points S k n) :
    Points.classOf (pullbackPointsMap f k n x) = pullbackRingHom f (Points.classOf x) := by
  induction x using Quotient.inductionOn with
  | h q =>
    change VectorBundleKZero.classOf T (pullbackPresentation f q).target = _
    exact (pullbackPresentation_isPullback f q).classOf_target

/-- The identification of the values of the Grassmannian functor with isomorphism classes of
quotient presentations, at the spelling `functor k n` of the functor that
`schemeRepresentableBy` represents. -/
def pointsEquiv (S : Scheme.{u}) (k n : ℕ) : (functor.{u} k n).obj (op S) ≃ Points S k n :=
  (functorData k n).objEquiv S

/-- **Classes along the Grassmannian functor commute with pullback.** For a point `y` of the
Grassmannian functor with values in `S` and a morphism `f : T ⟶ S`, the class of `f^*y` is `f^*`
of the class of `y`. -/
theorem classOf_pointsEquiv_map (f : T ⟶ S) (y : (functor.{u} k n).obj (op S)) :
    Points.classOf (pointsEquiv T k n ((functor.{u} k n).map f.op y)) =
      pullbackRingHom f (Points.classOf (pointsEquiv S k n y)) := by
  obtain ⟨q, hq⟩ := Quotient.exists_rep (pointsEquiv S k n y)
  have hy : y = (pointsEquiv S k n).symm ⟦q⟧ := by
    rw [hq, Equiv.symm_apply_apply]
  obtain ⟨q', hq', hpb⟩ := (functorData k n).map_isPullback f q
  subst hy
  rw [Equiv.apply_symm_apply]
  exact (congrArg Points.classOf hq').trans hpb.classOf_target

/-- **The universal point** of the Grassmannian functor: the point with values in the
Grassmannian corresponding to its identity morphism. -/
def universalPoint (k n : ℕ) : Points (scheme.{u} k n) k n :=
  pointsEquiv _ k n ((schemeRepresentableBy.{u} k n).homEquiv (𝟙 _))

/-- **The class of the universal quotient** in `K₀(Vect(G(k, n)))`. -/
def universalClass (k n : ℕ) : VectorBundleKZero (scheme.{u} k n) :=
  Points.classOf (universalPoint.{u} k n)

/-- **The pullback of the universal class along a morphism to the Grassmannian** is the class of
the point that morphism corresponds to. -/
theorem pullbackRingHom_universalClass (g : S ⟶ scheme.{u} k n) :
    pullbackRingHom g (universalClass.{u} k n) =
      Points.classOf (pointsEquiv S k n ((schemeRepresentableBy.{u} k n).homEquiv g)) := by
  have h := (schemeRepresentableBy.{u} k n).homEquiv_comp g (𝟙 _)
  rw [Category.comp_id] at h
  rw [h, classOf_pointsEquiv_map]
  rfl

/-- **The morphism to the Grassmannian classifying a quotient presentation** `𝒪^{⊕n} ⟶ 𝒬`. -/
def classifyingMap (q : QuotientPresentation S k n) : S ⟶ scheme.{u} k n :=
  (schemeRepresentableBy.{u} k n).homEquiv.symm ((pointsEquiv S k n).symm ⟦q⟧)

/-- **The classifying morphism pulls the universal quotient back to the given one**, in
`K₀(Vect(S))`: `g^*[𝒬_univ] = [𝒬]`. -/
theorem pullbackRingHom_classifyingMap_universalClass (q : QuotientPresentation S k n) :
    pullbackRingHom (classifyingMap q) (universalClass.{u} k n) =
      VectorBundleKZero.classOf S q.target := by
  rw [pullbackRingHom_universalClass, classifyingMap, Equiv.apply_symm_apply,
    Equiv.apply_symm_apply, Points.classOf_mk]

/-- **The class of a quotient of `𝒪^{⊕n}` comes from the Grassmannian.** If `𝒬` is finite locally
free of rank `n - k` and `φ : 𝒪_S^{⊕n} ⟶ 𝒬` is an epimorphism, there is a morphism
`g : S ⟶ G(k, n)` with `g^*[𝒬_univ] = [𝒬]` in `K₀(Vect(S))`. -/
theorem exists_pullbackRingHom_universalClass_eq_classOf (Q : S.Modules)
    (φ : SheafOfModules.free (R := S.ringCatSheaf) (ULift.{u} (Fin n)) ⟶ Q) [Epi φ]
    [AlgebraicGeometry.SheafOfModules.IsFiniteLocallyFreeOfRank.{u, u, u} Q (n - k)] :
    ∃ g : S ⟶ scheme.{u} k n,
      pullbackRingHom g (universalClass.{u} k n) = VectorBundleKZero.classOf S Q :=
  ⟨classifyingMap ⟨Q, φ, inferInstance, inferInstance⟩,
    pullbackRingHom_classifyingMap_universalClass _⟩

end AlgebraicGeometry.Grassmannian

end
