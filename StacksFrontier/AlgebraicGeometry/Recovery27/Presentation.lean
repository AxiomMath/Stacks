module

public import Mathlib.Algebra.Category.ModuleCat.Sheaf.PullbackFree
public import Mathlib.AlgebraicGeometry.Modules.Sheaf
public import StacksFrontier.AlgebraicGeometry.Recovery27.PullbackLocallyFree
public import StacksFrontier.AlgebraicGeometry.Recovery27.PullbackFreeIso

/-!
# Quotient presentations and their pullbacks

A quotient presentation on a scheme is a surjection from the free module of rank `n` onto
a module that is finite locally free of rank `n - k`. Pullback along a morphism of schemes
acts on presentations, and the induced action on isomorphism classes is functorial.

## Main definitions

* `AlgebraicGeometry.Grassmannian.QuotientPresentation`: a surjection from the free module
  of rank `n` onto a finite locally free module of rank `n - k`.
* `AlgebraicGeometry.Grassmannian.Points`: the type of isomorphism classes of such
  presentations.
* `AlgebraicGeometry.Grassmannian.pullbackPresentation`: the pullback of a presentation.
* `AlgebraicGeometry.Grassmannian.pullbackPointsMap`: the induced map on isomorphism
  classes.
* `AlgebraicGeometry.Grassmannian.QuotientPresentation.IsPullback`: the relation of being
  obtained by pullback.

## Main results

* `AlgebraicGeometry.Grassmannian.pullbackPresentation_isPullback`: the pullback of a
  presentation is obtained from it by pullback.
* `AlgebraicGeometry.Grassmannian.pullbackPointsMap_id` and
  `AlgebraicGeometry.Grassmannian.pullbackPointsMap_comp`: the action on isomorphism
  classes is functorial.

## Implementation notes

Isomorphism classes are formed as a quotient by the equivalence relation generated by
isomorphisms of targets commuting with the quotient maps. Functoriality of the action is
proved by exhibiting, for an identity and for a composite, the comparison isomorphism of
targets; the compatibility with the maps out of the free module is exactly the content of
`pullbackFreeIso_id` and `pullbackFreeIso_comp_inv`.

## References

* [Stacks Project, Tag 089S](https://stacks.math.columbia.edu/tag/089S)
-/

@[expose] public noncomputable section

open CategoryTheory Opposite

attribute [local implicit_reducible] AlgebraicGeometry.Scheme.Modules

universe u

namespace AlgebraicGeometry.Grassmannian

open Limits TopologicalSpace


/-- A quotient of the free module of rank `n` whose target is finite locally free
of rank `n - k`. -/
public structure QuotientPresentation (X : Scheme.{u}) (k n : ℕ) where
  /-- The quotient module. -/
  target : X.Modules
  /-- The quotient map. -/
  map : SheafOfModules.free (R := X.ringCatSheaf) (ULift.{u} (Fin n)) ⟶ target
  /-- The quotient map is surjective. -/
  map_epi : Epi map
  /-- The quotient is finite locally free of the required rank. -/
  finiteLocallyFree :
    @SheafOfModules.IsFiniteLocallyFreeOfRank _ _ _ X.ringCatSheaf _ _ target (n - k)

/-- Two quotient presentations are isomorphic if an isomorphism of their targets
commutes with the maps out of the free module. -/
public def QuotientPresentation.Isomorphic {X : Scheme.{u}} {k n : ℕ}
    (q q' : QuotientPresentation X k n) : Prop :=
  ∃ e : q.target ≅ q'.target, q.map ≫ e.hom = q'.map

/-- The equivalence relation generated by isomorphisms of quotient presentations. -/
public def quotientPresentationSetoid (X : Scheme.{u}) (k n : ℕ) :
    Setoid (QuotientPresentation X k n) :=
  Relation.EqvGen.setoid QuotientPresentation.Isomorphic

/-- The isomorphism classes of finite locally free rank-`n - k` quotients of the
free module of rank `n` on `X`. -/
public abbrev Points (X : Scheme.{u}) (k n : ℕ) :=
  Quotient (quotientPresentationSetoid X k n)


/-- The pullback of a quotient presentation along a morphism of schemes. -/
public noncomputable def pullbackPresentation {S T : Scheme.{u}} {k n : ℕ}
    (f : T ⟶ S) (q : QuotientPresentation S k n) : QuotientPresentation T k n := by
  have hpb : Epi ((Scheme.Modules.pullback f).map q.map) :=
    @Functor.map_epi _ _ _ _ (Scheme.Modules.pullback f) inferInstance _ _ q.map q.map_epi
  letI : Epi ((Scheme.Modules.pullback f).map q.map) := hpb
  exact
    { target := (Scheme.Modules.pullback f).obj q.target
      map := (pullbackFreeIso f n).inv ≫ (Scheme.Modules.pullback f).map q.map
      map_epi := by
        have hinv : Epi (pullbackFreeIso f n).inv := by
          refine ⟨?_⟩
          intro Z a b hab
          have h' := congrArg (fun g ↦ (pullbackFreeIso f n).hom ≫ g) hab
          simpa [Category.assoc] using h'
        exact @epi_comp _ _ _ _ _ (pullbackFreeIso f n).inv hinv
          ((Scheme.Modules.pullback f).map q.map) hpb
      finiteLocallyFree := isFiniteLocallyFreeOfRank_pullback f.base f.toRingCatSheafHom q.target
        (n - k) q.finiteLocallyFree }

/-- Pullback sends isomorphic presentations to isomorphic presentations. -/
public theorem pullbackPresentation_respects_isomorphic {S T : Scheme.{u}} {k n : ℕ}
    (f : T ⟶ S) {q q' : QuotientPresentation S k n}
    (h : q.Isomorphic q') :
    (pullbackPresentation f q).Isomorphic (pullbackPresentation f q') := by
  rcases h with ⟨e, he⟩
  refine ⟨(Scheme.Modules.pullback f).mapIso e, ?_⟩
  show (pullbackFreeIso f n).inv ≫ (Scheme.Modules.pullback f).map q.map ≫
    (Scheme.Modules.pullback f).map e.hom =
      (pullbackFreeIso f n).inv ≫ (Scheme.Modules.pullback f).map q'.map
  have hm : (Scheme.Modules.pullback f).map q.map ≫
      (Scheme.Modules.pullback f).map e.hom = (Scheme.Modules.pullback f).map q'.map := by
    rw [← (Scheme.Modules.pullback f).map_comp q.map e.hom]
    exact congrArg (Scheme.Modules.pullback f).map he
  exact congrArg (fun m ↦ (pullbackFreeIso f n).inv ≫ m) hm

/-- The map on isomorphism classes of presentations induced by pullback. -/
public noncomputable def pullbackPointsMap {S T : Scheme.{u}} (f : T ⟶ S)
    (k n : ℕ) : Points S k n → Points T k n :=
  Quotient.lift (fun q ↦ (⟦pullbackPresentation f q⟧ : Points T k n))
    (by
      intro q q' h
      induction h with
      | rel _ _ h =>
        exact Quotient.sound
          (.rel _ _ (pullbackPresentation_respects_isomorphic f h))
      | refl _ => rfl
      | symm _ _ _ ih => exact ih.symm
      | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂)

/-- A presentation on `T` is obtained from one on `S` by pullback along `f`. -/
public def QuotientPresentation.IsPullback {S T : Scheme.{u}} {k n : ℕ}
    (f : T ⟶ S) (q : QuotientPresentation S k n)
    (q' : QuotientPresentation T k n) : Prop :=
  ∃ e : (Scheme.Modules.pullback f).obj q.target ≅ q'.target,
    (Scheme.Modules.pullback f).map q.map ≫ e.hom =
      (pullbackFreeIso f n).hom ≫ q'.map

/-- The pullback of a presentation is obtained from it by pullback. -/
public theorem pullbackPresentation_isPullback {S T : Scheme.{u}} {k n : ℕ}
    (f : T ⟶ S) (q : QuotientPresentation S k n) :
    q.IsPullback f (pullbackPresentation f q) := by
  refine ⟨Iso.refl _, ?_⟩
  show (Scheme.Modules.pullback f).map q.map =
    (pullbackFreeIso f n).hom ≫
      ((pullbackFreeIso f n).inv ≫ (Scheme.Modules.pullback f).map q.map)
  exact (Iso.hom_inv_id_assoc (pullbackFreeIso f n) _).symm

/-- The pullback of a presentation along an identity is isomorphic to it. -/
private theorem pullbackPresentation_id {S : Scheme.{u}} {k n : ℕ}
    (q : QuotientPresentation S k n) :
    (pullbackPresentation (𝟙 S) q).Isomorphic q := by
  refine ⟨(Scheme.Modules.pullbackId S).app q.target, ?_⟩
  show (pullbackFreeIso (𝟙 S) n).inv ≫ (Scheme.Modules.pullback (𝟙 S)).map q.map ≫
      ((Scheme.Modules.pullbackId S).app q.target).hom = q.map
  rw [Iso.app_hom, (Scheme.Modules.pullbackId S).hom.naturality q.map, pullbackFreeIso_id]
  exact Iso.inv_hom_id_app_assoc (Scheme.Modules.pullbackId S) _ ((𝟭 _).map q.map)

/-- Pullback along a composite agrees with the two successive pullbacks. -/
private theorem pullbackPresentation_comp {S T U : Scheme.{u}} {k n : ℕ}
    (f : T ⟶ S) (g : U ⟶ T) (q : QuotientPresentation S k n) :
    (pullbackPresentation g (pullbackPresentation f q)).Isomorphic
      (pullbackPresentation (g ≫ f) q) := by
  let e := asIso ((Scheme.Modules.pullbackComp g f).hom.app q.target)
  refine ⟨e, ?_⟩
  show (pullbackFreeIso g n).inv ≫
      (Scheme.Modules.pullback g).map
        ((pullbackFreeIso f n).inv ≫ (Scheme.Modules.pullback f).map q.map) ≫ e.hom =
    (pullbackFreeIso (g ≫ f) n).inv ≫
      (Scheme.Modules.pullback (g ≫ f)).map q.map
  have hnat' :
      (Scheme.Modules.pullback g).map ((Scheme.Modules.pullback f).map q.map) ≫ e.hom =
        (Scheme.Modules.pullbackComp g f).hom.app
          (SheafOfModules.free (R := S.ringCatSheaf) (ULift.{u} (Fin n))) ≫
          (Scheme.Modules.pullback (g ≫ f)).map q.map :=
    (Scheme.Modules.pullbackComp g f).hom.naturality q.map
  have hmap :
      (Scheme.Modules.pullback g).map
          ((pullbackFreeIso f n).inv ≫ (Scheme.Modules.pullback f).map q.map) =
        (Scheme.Modules.pullback g).map (pullbackFreeIso f n).inv ≫
          (Scheme.Modules.pullback g).map ((Scheme.Modules.pullback f).map q.map) :=
    (Scheme.Modules.pullback g).map_comp _ _
  calc
    (pullbackFreeIso g n).inv ≫
        (Scheme.Modules.pullback g).map
          ((pullbackFreeIso f n).inv ≫ (Scheme.Modules.pullback f).map q.map) ≫ e.hom =
      ((pullbackFreeIso g n).inv ≫
        (Scheme.Modules.pullback g).map (pullbackFreeIso f n).inv) ≫
          ((Scheme.Modules.pullback g).map ((Scheme.Modules.pullback f).map q.map) ≫ e.hom) := by
            rw [hmap]
            cat_disch
    _ = ((pullbackFreeIso g n).inv ≫
        (Scheme.Modules.pullback g).map (pullbackFreeIso f n).inv) ≫
          ((Scheme.Modules.pullbackComp g f).hom.app
            (SheafOfModules.free (R := S.ringCatSheaf) (ULift.{u} (Fin n))) ≫
            (Scheme.Modules.pullback (g ≫ f)).map q.map) :=
          congrArg _ hnat'
    _ = ((pullbackFreeIso g n).inv ≫
        (Scheme.Modules.pullback g).map (pullbackFreeIso f n).inv ≫
          (Scheme.Modules.pullbackComp g f).hom.app
            (SheafOfModules.free (R := S.ringCatSheaf) (ULift.{u} (Fin n)))) ≫
          (Scheme.Modules.pullback (g ≫ f)).map q.map := by cat_disch
    _ = (pullbackFreeIso (g ≫ f) n).inv ≫
          (Scheme.Modules.pullback (g ≫ f)).map q.map :=
          congrArg (fun m ↦ m ≫ (Scheme.Modules.pullback (g ≫ f)).map q.map)
            (pullbackFreeIso_comp_inv f g n)

/-- Pullback along an identity acts as the identity on isomorphism classes. -/
public theorem pullbackPointsMap_id {S : Scheme.{u}} (k n : ℕ) :
    pullbackPointsMap (𝟙 S) k n = id := by
  funext x
  refine Quotient.inductionOn x ?_
  intro q
  show (⟦pullbackPresentation (𝟙 S) q⟧ : Points S k n) = ⟦q⟧
  exact Quotient.sound (.rel _ _ (pullbackPresentation_id q))

/-- Pullback along a composite is the composite of the pullbacks. -/
public theorem pullbackPointsMap_comp {S T U : Scheme.{u}}
    (f : T ⟶ S) (g : U ⟶ T) (k n : ℕ) :
    pullbackPointsMap (g ≫ f) k n =
      pullbackPointsMap g k n ∘ pullbackPointsMap f k n := by
  funext x
  refine Quotient.inductionOn x ?_
  intro q
  show (⟦pullbackPresentation (g ≫ f) q⟧ : Points U k n) =
    ⟦pullbackPresentation g (pullbackPresentation f q)⟧
  exact Quotient.sound
    (Relation.EqvGen.symm _ _ (.rel _ _ (pullbackPresentation_comp f g q)))

end AlgebraicGeometry.Grassmannian

end
