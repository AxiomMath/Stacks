module

public import Mathlib.RingTheory.Localization.Ideal
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Algebra
public import StacksFrontier.AlgebraicGeometry.RegularIdealSheaf.Basic

/-!
# Sections of a generated ideal sheaf over an affine open

Let `X` be a scheme, `U ⊆ X` an affine open and `f₁, …, f_r` sections of `O_X` over `U`.  The
ideal subsheaf `generatedIdealOn X U f` of `O_X` generated by those sections has, over `U`
itself, exactly the ideal `(f₁, …, f_r) ⊆ O_X(U)` as its sections — no more.  The inclusion that
needs proof is the hard one: the generated ideal subsheaf is cut out by a *germwise* condition,
so a section of it over `U` is only known to lie in the ideal generated by the germs of the `fᵢ`
in each local ring, and affineness is what turns that family of local conditions back into
membership in the ideal of `O_X(U)`.

This is the step of [Stacks, Tag 063G] which identifies the ideal `I ⊆ A` appearing in the
affine-local description `J|_U = Ĩ`, `U = Spec A`, with the ideal generated by the sequence that
generates `J` over `U`.  It is shared by all four parts of that lemma — regular, Koszul-regular,
`H₁`-regular and quasi-regular — and is independent of the sheaf Koszul complex, so it is proved
here once, separately from them.

## Main results

* `Stacks.AlgebraicGeometry.RegularIdealSheaf.generatedIdealOn_obj_self_eq_span`: over an affine
  open the sections of the generated ideal subsheaf are the ideal generated by the generating
  sections.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.obj_self_eq_span_of_isGeneratedByOn`: the same for
  an ideal sheaf generated by those sections over the affine open.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.obj_eq_span_res_of_isGeneratedByOn`: the version on
  an affine subopen, where the generating sections are restricted.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.exists_affineOpen_isGeneratedByOn`: the
  affine-shrinking step, which packages the two together at an affine open neighbourhood of a
  point of the generating open.

## Implementation notes

The local-global principle used is `Stacks.RingTheory.RegularIdealSheaf.mem_of_forall_maximal`:
an element of a commutative ring lies in an ideal as soon as, for every maximal ideal `m`, some
element outside `m` multiplies it into that ideal.  The witness outside `m` is produced from the
germ condition at the point of `U` corresponding to `m` under `hU.isoSpec`, where the stalk is
the localization of `O_X(U)` at `m` and the ideal generated by the germs is the extension of the
ideal generated by the sections; `IsLocalization.algebraMap_mem_map_algebraMap_iff` is exactly
the clearing of denominators this needs.

The germ map `O_X(U) ⟶ O_{X,y}` and the structure map of the algebra instance
`TopCat.Presheaf.algebra_section_stalk` are the same ring homomorphism by definition, so the
germ conditions are read directly as conditions about `algebraMap`.

## References

* [Stacks Project, Lemma 31.20.2 (Tag 063G)](https://stacks.math.columbia.edu/tag/063G)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.RingTheory.RegularIdealSheaf
open Stacks.AlgebraicGeometry.QuasiRegular
open Stacks.RingedSpace

universe u

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

variable {X : Scheme.{u}} {U : X.Opens} {r : ℕ}

/-- **The sections of a generated ideal sheaf over an affine open.**  Over an affine open `U` the
ideal subsheaf of `O_X` generated by sections `f₁, …, f_r` of `O_X(U)` has as its sections over
`U` precisely the ideal of `O_X(U)` generated by `f₁, …, f_r`. -/
theorem generatedIdealOn_obj_self_eq_span (hU : IsAffineOpen U) (f : Fin r → Γ(X, U)) :
    (generatedIdealOn X.toRingedSpace U f).obj (op U) = Ideal.span (Set.range f) := by
  refine le_antisymm (fun s hs => ?_) ?_
  · refine mem_of_forall_maximal (Ideal.span (Set.range f)) s fun m hm => ?_
    obtain ⟨z, hz⟩ := (ConcreteCategory.bijective_of_isIso
      (Scheme.forgetToTop.map hU.isoSpec.hom)).2 (⟨m, hm.isPrime⟩ : PrimeSpectrum Γ(X, U))
    let _ := X.presheaf.algebra_section_stalk z
    have _ := hU.isLocalization_stalk z
    have hmz : (hU.primeIdealOf z).asIdeal = m := congrArg PrimeSpectrum.asIdeal hz
    have hmem : algebraMap Γ(X, U) (X.presheaf.stalk z.1) s ∈
        (Ideal.span (Set.range f)).map (algebraMap Γ(X, U) (X.presheaf.stalk z.1)) := by
      refine (Ideal.span_le.mpr ?_ : Jid (germFamily X.toRingedSpace U f z.1 z.2) ≤ _)
        ((mem_generatedIdealOn_iff U f U le_rfl s).mp hs z.1 z.2)
      rintro _ ⟨i, rfl⟩
      exact Ideal.mem_map_of_mem _ (Ideal.subset_span ⟨i, rfl⟩)
    obtain ⟨t, htm, hts⟩ := (IsLocalization.algebraMap_mem_map_algebraMap_iff
      (hU.primeIdealOf z).asIdeal.primeCompl (X.presheaf.stalk z.1)
      (Ideal.span (Set.range f)) s).mp hmem
    exact ⟨t, hmz ▸ htm, hts⟩
  · exact Ideal.span_le.mpr (Set.range_subset_iff.mpr (mem_generatedIdealOn X.toRingedSpace U f))

/-- An ideal sheaf generated over an affine open `U` by sections `f₁, …, f_r` has as its sections
over `U` the ideal of `O_X(U)` generated by `f₁, …, f_r`. -/
theorem obj_self_eq_span_of_isGeneratedByOn (hU : IsAffineOpen U)
    {J : (structureSheafModule X.toRingedSpace).Submodule} (f : Fin r → Γ(X, U))
    (h : IsGeneratedByOn X.toRingedSpace J U f) :
    J.obj (op U) = Ideal.span (Set.range f) :=
  (h U le_rfl).trans (generatedIdealOn_obj_self_eq_span hU f)

/-- On an affine subopen `V` of `U` the sections of an ideal sheaf generated over `U` by
`f₁, …, f_r` are the ideal generated by the restrictions of the `fᵢ` to `V`. -/
theorem obj_eq_span_res_of_isGeneratedByOn
    {J : (structureSheafModule X.toRingedSpace).Submodule} (f : Fin r → Γ(X, U))
    (h : IsGeneratedByOn X.toRingedSpace J U f) {V : X.Opens} (hV : IsAffineOpen V)
    (hVU : V ≤ U) :
    J.obj (op V)
      = Ideal.span (Set.range fun i => X.presheaf.map (homOfLE hVU).op (f i)) :=
  obj_self_eq_span_of_isGeneratedByOn hV _ (isGeneratedByOn_of_le U f h V hVU)

/-- **The affine-shrinking step of [Stacks, Tag 063G].**  An ideal sheaf generated over an open
`U` by sections `f₁, …, f_r` is generated, over any affine open neighbourhood `V ⊆ U` of a point
of `U`, by the restrictions of those sections, and its sections over `V` are exactly the ideal
they span.  This is the passage from an arbitrary generating open to an affine one with which the
proof of the lemma begins. -/
theorem exists_affineOpen_isGeneratedByOn
    {J : (structureSheafModule X.toRingedSpace).Submodule} (f : Fin r → Γ(X, U))
    (h : IsGeneratedByOn X.toRingedSpace J U f) {x : X} (hx : x ∈ U) :
    ∃ (V : X.affineOpens) (_hx : x ∈ V.1) (hVU : V.1 ≤ U),
      IsGeneratedByOn X.toRingedSpace J V.1 (fun i => X.presheaf.map (homOfLE hVU).op (f i)) ∧
        J.obj (op V.1)
          = Ideal.span (Set.range fun i => X.presheaf.map (homOfLE hVU).op (f i)) := by
  obtain ⟨V, hV, hxV, hVU⟩ := Opens.isBasis_iff_nbhd.mp X.isBasis_affineOpens hx
  exact ⟨⟨V, hV⟩, hxV, hVU, isGeneratedByOn_of_le U f h V hVU,
    obj_eq_span_res_of_isGeneratedByOn f h hV hVU⟩

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
