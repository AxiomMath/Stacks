module

public import Mathlib.Algebra.Module.LocalizedModule.Submodule
public import StacksFrontier.AlgebraicGeometry.GeneratedIdealSheafAffine.AffineSections

/-!
# An ideal sheaf generated on an affine open localizes

Let `X` be a scheme, `U ⊆ X` an affine open and `f₁, …, f_r` sections of `O_X` over `U` which
generate an ideal sheaf `J ⊆ O_X` over `U`.  For every section `g` of `O_X` over `U` the sections
of `J` over the basic open `D(g) ⊆ U` are the localization away from `g` of its sections over
`U`, and the restriction map is the localization map.

This is the computation behind the step `J|_U = Ĩ` of [Stacks, Tag 063G].  Over an affine open
the ideal `I` is the ideal of sections `J(U)`, which `obj_self_eq_span_of_isGeneratedByOn`
identifies with the ideal generated by the `fᵢ`; what remains for the identification of `J|_U`
with `Ĩ` is that `J|_U` has the sections of a quasi-coherent sheaf, and by Mathlib's
`IsLocalizing` criterion (`AlgebraicGeometry.isIso_fromTildeΓ_iff_isLocalizing`) that is exactly
the statement proved here, for every `g`.

## Main definitions

* `Stacks.AlgebraicGeometry.RegularIdealSheaf.sectionsIdeal`: the sections of an ideal subsheaf
  of `O_X` over an open set, as an ideal of the ring of sections there.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.resBasicOpen`: the restriction map on sections of
  an ideal subsheaf from `U` to the basic open of a section over `U`, as a map of `O_X(U)`-modules.

## Main results

* `Stacks.AlgebraicGeometry.RegularIdealSheaf.sectionsIdeal_basicOpen_eq_localized₀`: the
  sections of `J` over `D(g)` are the localization of `J(U)` away from `g`.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf.isLocalizedModule_resBasicOpen`: the restriction
  map `J(U) → J(D(g))` is a localization away from `g`.
* `Stacks.AlgebraicGeometry.RegularIdealSheaf`
  `.map_sectionsIdeal_eq_sectionsIdeal_basicOpen_of_isGeneratedByOn`: the same statement in the
  `Ideal.map` form that the `map_ideal_basicOpen` field of Mathlib's
  `AlgebraicGeometry.Scheme.IdealSheafData` asks for.

## Implementation notes

The ambient ring of `J.obj (op V)` is the value at `V` of the `RingCat`-valued sheaf underlying
`O_X`, which is not syntactically `Γ(X, V)`, so instance search for `Γ(X, V)`-module structures
on it fails.  `sectionsIdeal` is that same ideal with its type *declared* as `Ideal Γ(X, V)`;
it is equal to `J.obj (op V)` by `rfl`, and `mem_sectionsIdeal` is the unfolding.

The `O_X(U)`-algebra structure on `O_X(D(g))` is Mathlib's
`AlgebraicGeometry.Scheme.algebra_section_section_basicOpen`, whose structure map is by
definition the restriction map of the presheaf; so the restriction map on sections of `J` is
literally `Algebra.linearMap` restricted to the two ideals, and no comparison between a
restriction map and an algebra map is needed anywhere.

`Submodule.localized₀` is used rather than `Submodule.localized'` because the restriction map is
only `O_X(U)`-linear: its source is an ideal of `O_X(U)` and its target an ideal of `O_X(D(g))`.
`Submodule.restrictScalars_localized'` identifies the two descriptions.

## References

* [Stacks Project, Lemma 31.20.2 (Tag 063G)](https://stacks.math.columbia.edu/tag/063G)
-/

@[expose] public section

open CategoryTheory Opposite TopologicalSpace
open AlgebraicGeometry
open Stacks.AlgebraicGeometry.QuasiRegular
open Stacks.RingedSpace

universe u

namespace Stacks.AlgebraicGeometry.RegularIdealSheaf

variable {X : Scheme.{u}} {U : X.Opens} {r : ℕ}

/-- The sections over an open set of an ideal subsheaf of `O_X`, as an ideal of the ring of
sections there. -/
noncomputable def sectionsIdeal (J : (structureSheafModule X.toRingedSpace).Submodule)
    (V : X.Opens) : Ideal Γ(X, V) :=
  J.obj (op V)

/-- A section lies in `sectionsIdeal J V` if and only if it lies in the sections of `J` over
`V`. -/
theorem mem_sectionsIdeal {J : (structureSheafModule X.toRingedSpace).Submodule} {V : X.Opens}
    {s : Γ(X, V)} : s ∈ sectionsIdeal J V ↔ s ∈ J.obj (op V) :=
  Iff.rfl

/-- Over an affine open the sections of an ideal sheaf generated by `f₁, …, f_r` are the ideal
they span. -/
theorem sectionsIdeal_eq_span_of_isGeneratedByOn (hU : IsAffineOpen U)
    {J : (structureSheafModule X.toRingedSpace).Submodule} (f : Fin r → Γ(X, U))
    (h : IsGeneratedByOn X.toRingedSpace J U f) :
    sectionsIdeal J U = Ideal.span (Set.range f) :=
  obj_self_eq_span_of_isGeneratedByOn hU f h

/-- The sections of a generated ideal sheaf over `D(g)` are generated by the restrictions of its
sections over `U`. -/
private theorem map_sectionsIdeal_basicOpen_of_isGeneratedByOn (hU : IsAffineOpen U)
    {J : (structureSheafModule X.toRingedSpace).Submodule} (f : Fin r → Γ(X, U))
    (h : IsGeneratedByOn X.toRingedSpace J U f) (g : Γ(X, U)) :
    (sectionsIdeal J U).map (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom
      = sectionsIdeal J (X.basicOpen g) := by
  show _ = (J.obj (op (X.basicOpen g)) : Ideal Γ(X, X.basicOpen g))
  rw [obj_eq_span_res_of_isGeneratedByOn f h (hU.basicOpen g) (X.basicOpen_le g),
    sectionsIdeal_eq_span_of_isGeneratedByOn hU f h, Ideal.map_span, ← Set.range_comp]
  rfl

/-- **The sections of a generated ideal sheaf over a basic open.**  If `f₁, …, f_r` generate the
ideal sheaf `J` over an affine open `U`, then for every section `g` over `U` the sections of `J`
over `D(g)` are the localization of its sections over `U` away from `g`. -/
theorem sectionsIdeal_basicOpen_eq_localized₀ (hU : IsAffineOpen U)
    {J : (structureSheafModule X.toRingedSpace).Submodule} (f : Fin r → Γ(X, U))
    (h : IsGeneratedByOn X.toRingedSpace J U f) (g : Γ(X, U)) :
    haveI := hU.isLocalization_basicOpen g
    (sectionsIdeal J (X.basicOpen g)).restrictScalars Γ(X, U)
      = Submodule.localized₀ (Submonoid.powers g)
          (Algebra.linearMap Γ(X, U) Γ(X, X.basicOpen g)) (sectionsIdeal J U) := by
  have := hU.isLocalization_basicOpen g
  rw [← Submodule.restrictScalars_localized' Γ(X, X.basicOpen g), Submodule.localized'_eq_span]
  congr 1
  rw [← map_sectionsIdeal_basicOpen_of_isGeneratedByOn hU f h g]
  rfl

/-- **The `IdealSheafData` compatibility condition for a generated ideal sheaf.**  If `f₁, …, f_r`
generate the ideal sheaf `J` over an affine open `U`, then the ideal of sections of `J` over
`D(g)` is generated by the image of its ideal of sections over `U`.  This is the shape of the
`map_ideal_basicOpen` field of Mathlib's `AlgebraicGeometry.Scheme.IdealSheafData`. -/
theorem map_sectionsIdeal_eq_sectionsIdeal_basicOpen_of_isGeneratedByOn (hU : IsAffineOpen U)
    {J : (structureSheafModule X.toRingedSpace).Submodule} (f : Fin r → Γ(X, U))
    (h : IsGeneratedByOn X.toRingedSpace J U f) (g : Γ(X, U)) :
    (sectionsIdeal J U).map (X.presheaf.map (homOfLE (X.basicOpen_le g)).op).hom
      = sectionsIdeal J (X.basicOpen g) :=
  map_sectionsIdeal_basicOpen_of_isGeneratedByOn hU f h g

/-- The restriction map on sections of an ideal subsheaf `J` from an open `U` to the basic open of
a section `g` over `U`, as a map of `O_X(U)`-modules. -/
noncomputable def resBasicOpen (X : Scheme.{u}) (U : X.Opens)
    (J : (structureSheafModule X.toRingedSpace).Submodule) (g : Γ(X, U)) :
    ↥(sectionsIdeal J U) →ₗ[Γ(X, U)]
      ↥((sectionsIdeal J (X.basicOpen g)).restrictScalars Γ(X, U)) :=
  (Algebra.linearMap Γ(X, U) Γ(X, X.basicOpen g)).restrict
    fun _ hx => J.toSubmodule.map_mem (homOfLE (X.basicOpen_le g)).op hx

/-- The underlying section of `resBasicOpen X U J g s` is the restriction of `s` to `D(g)`. -/
@[simp]
theorem resBasicOpen_coe (X : Scheme.{u}) (U : X.Opens)
    (J : (structureSheafModule X.toRingedSpace).Submodule) (g : Γ(X, U))
    (s : ↥(sectionsIdeal J U)) :
    (resBasicOpen X U J g s : Γ(X, X.basicOpen g))
      = X.presheaf.map (homOfLE (X.basicOpen_le g)).op (s : Γ(X, U)) :=
  rfl

/-- **The sections of a generated ideal sheaf localize.**  If `f₁, …, f_r` generate the ideal
sheaf `J` over an affine open `U`, then for every section `g` over `U` the restriction map
`J(U) → J(D(g))` exhibits `J(D(g))` as the localization of `J(U)` away from `g`.  This is the
`IsLocalizing` condition of `J|_U`, hence the affine-local identification `J|_U = Ĩ` of
[Stacks, Tag 063G]. -/
theorem isLocalizedModule_resBasicOpen (hU : IsAffineOpen U)
    {J : (structureSheafModule X.toRingedSpace).Submodule} (f : Fin r → Γ(X, U))
    (h : IsGeneratedByOn X.toRingedSpace J U f) (g : Γ(X, U)) :
    IsLocalizedModule (Submonoid.powers g) (resBasicOpen X U J g) := by
  have := hU.isLocalization_basicOpen g
  let e := LinearEquiv.ofEq _ _ (sectionsIdeal_basicOpen_eq_localized₀ hU f h g)
  have hcomp : e.toLinearMap ∘ₗ resBasicOpen X U J g
      = Submodule.toLocalized₀ (Submonoid.powers g)
          (Algebra.linearMap Γ(X, U) Γ(X, X.basicOpen g)) (sectionsIdeal J U) := by
    ext s
    rfl
  refine (IsLocalizedModule.comp_iff_of_bijective_left _ e.toLinearMap e.bijective).mp ?_
  rw [hcomp]
  infer_instance

end Stacks.AlgebraicGeometry.RegularIdealSheaf

end
