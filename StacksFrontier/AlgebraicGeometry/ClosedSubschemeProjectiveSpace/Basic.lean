module

public import StacksFrontier.AlgebraicGeometry.ProjQuotientFiniteCover.Basic
public import StacksFrontier.AlgebraicGeometry.ProjBaseChange.IsIso
import StacksCore.Tactic.EgaSgaAttribute

/-!
# A closed subscheme of `ℙⁿ_R` is the `Proj` of the quotient by its homogeneous ideal

Let `R` be a ring and let `i : Z ⟶ ℙⁿ_R` be a closed subscheme of projective `n`-space over `R`,
where `ℙⁿ_R` is the base change `Spec R ×_{Spec ℤ} Proj (ULift ℤ)[T₀, …, Tₙ]`. Let

    I_d = Ker(R[T₀, …, Tₙ]_d ⟶ Γ(Z, 𝒪(d)|_Z)),   I = ⨁_d I_d.

Stacks Tag 03GL asserts three things: that `I_d` is that kernel, that `I` is a graded ideal, and
that `Z = Proj(R[T₀, …, Tₙ]/I)`. The first two are registered on the Tag 0BXK declarations that
prove them, `Stacks.AlgebraicGeometry.IdealOfClosedSubscheme.mem_idealOfClosedSubscheme_iff` and
`Stacks.AlgebraicGeometry.IdealOfClosedSubscheme.idealOfClosedSubscheme_isHomogeneous`. This file
proves the third, over an **arbitrary** commutative ring `R`.

The identification is stated in the coordinate-pinned form, over the comparison
`Stacks.AlgebraicGeometry.ProjBaseChange.polynomialComparison` between the base-change model of
projective space and `Proj R[T₀, …, Tₙ]`: the isomorphism `Z ≅ Proj(R[T]/I)` is required to
commute with the two morphisms into `ℙⁿ_R`, so it is an equality of closed subschemes of
projective space and not merely an abstract isomorphism of schemes.

## Main results

* `Stacks.ClosedSubschemeProjectiveSpace.closedSubscheme_iso_projQuotient`: **Tag 03GL's third
  assertion.** Over an arbitrary ring, a closed subscheme of `ℙⁿ_R` is, over `ℙⁿ_R`, the `Proj`
  of the quotient of `R[T₀, …, Tₙ]` by its homogeneous ideal of equations.
* `Stacks.ClosedSubschemeProjectiveSpace.nonempty_projQuotientPresentation`: the same with every
  clause of the presentation — degreewise surjectivity of the quotient map, its kernel, and that
  `Proj` of the quotient is a closed subscheme of `ℙⁿ_R` — bundled alongside.

## Implementation notes

`Stacks.ClosedSubschemeProjQuotient.projQuotientIso` already gives the identification at an
absolute `Proj`, but only for a Noetherian graded ring generated in degree one, which over a
polynomial ring means a Noetherian coefficient ring. Tag 03GL has no Noetherian hypothesis, and
needs none: the Noetherian hypothesis is used only to produce a *finite* family of degree-one
elements whose standard opens cover `Proj`, and for a polynomial ring the variables are such a
family. `Stacks.ProjQuotientFiniteCover.projQuotientIso_of_cover` restates the chain with that
family as a hypothesis, and `Stacks.ProjQuotientFiniteCover.projectiveSpace_projQuotientIso`
instantiates it at the variables.

The two `example`s at the end pin the two abbreviations the statement is written over — the ideal
of equations and the morphism from `Proj` of the quotient — to the constructions they unfold to,
by `rfl`.

## References

* [Stacks Project, Tag 03GL](https://stacks.math.columbia.edu/tag/03GL)
* [Stacks Project, Tag 0BXK](https://stacks.math.columbia.edu/tag/0BXK)
* [Stacks Project, Tag 01N1](https://stacks.math.columbia.edu/tag/01N1)
* [Stacks Project, Tag 0801](https://stacks.math.columbia.edu/tag/0801)
-/

@[expose] public noncomputable section

open CategoryTheory DirectSum
open AlgebraicGeometry
open AlgebraicGeometry.ProjectiveSpectrum.Proj
open Stacks.ClosedSubschemeProjQuotient
open Stacks.AlgebraicGeometry.ProjPolyChart

universe u

namespace Stacks.ClosedSubschemeProjectiveSpace

attribute [local instance] MvPolynomial.gradedAlgebra

variable (R : Type u) [CommRing R] (n : ℕ)

/-- **The coordinate-pinned comparison** between the base-change model of projective `n`-space
over `R` and the polynomial model `Proj R[T₀, …, Tₙ]`. It is the isomorphism of
`Stacks.AlgebraicGeometry.ProjBaseChange.polynomialComparison`, whose coefficient homomorphism is
the canonical one, so that each named homogeneous coordinate is preserved. -/
abbrev comparisonIso :
    AlgebraicGeometry.projectiveSpaceOverRing n (CommRingCat.of R) ≅
      AlgebraicGeometry.Proj (polyGrading R n) :=
  (Stacks.AlgebraicGeometry.ProjBaseChange.polynomialComparison R n).iso

variable {R n}

/-- A closed subscheme of the base-change model of projective space is a closed subscheme of the
polynomial model, through the comparison. -/
instance isClosedImmersion_comp_comparisonIso {Z : Scheme.{u}}
    (i : Z ⟶ AlgebraicGeometry.projectiveSpaceOverRing n (CommRingCat.of R))
    [IsClosedImmersion i] : IsClosedImmersion (i ≫ (comparisonIso R n).hom) :=
  inferInstance

/-- **Stacks Tag 03GL, third assertion: `Z = Proj(R[T₀, …, Tₙ]/I)`.** Let `R` be an arbitrary
commutative ring and let `i : Z ⟶ ℙⁿ_R` be a closed subscheme of projective `n`-space over `R`.
Let `I ⊆ R[T₀, …, Tₙ]` be the homogeneous ideal generated by the homogeneous polynomials whose
twisted global section pulls back to zero on `Z` — the ideal whose degree-`d` part is
`Ker(R[T₀, …, Tₙ]_d ⟶ Γ(Z, 𝒪(d)|_Z))`, by the two assertions of the tag registered on
`Stacks.AlgebraicGeometry.IdealOfClosedSubscheme.mem_idealOfClosedSubscheme_iff` and
`Stacks.AlgebraicGeometry.IdealOfClosedSubscheme.idealOfClosedSubscheme_isHomogeneous`.

Then `Z` is isomorphic to `Proj(R[T₀, …, Tₙ]/I)`, compatibly with the two morphisms into `ℙⁿ_R`:
the closed immersion `i` itself, and the canonical morphism
`Stacks.ClosedSubschemeProjQuotient.ambientHom` read through the comparison. So the two are equal
as closed subschemes of projective space.

No hypothesis is placed on `R`; in particular it need not be Noetherian. -/
@[stacks 03GL "the closed subscheme is the Proj of the quotient",
  ega "II 2.9.2" "(ii), special case"]
theorem closedSubscheme_iso_projQuotient {Z : Scheme.{u}}
    (i : Z ⟶ AlgebraicGeometry.projectiveSpaceOverRing n (CommRingCat.of R))
    [IsClosedImmersion i] :
    ∃ e : Z ≅ projQuotient (polyGrading R n) (i ≫ (comparisonIso R n).hom),
      e.hom ≫ ambientHom (polyGrading R n) (i ≫ (comparisonIso R n).hom) ≫
        (comparisonIso R n).inv = i := by
  refine ⟨Stacks.ProjQuotientFiniteCover.projectiveSpace_projQuotientIso R (n + 1)
    (i ≫ (comparisonIso R n).hom), ?_⟩
  rw [← Category.assoc,
    Stacks.ProjQuotientFiniteCover.projectiveSpace_projQuotientIso_hom_comp_ambientHom R (n + 1)
      (i ≫ (comparisonIso R n).hom),
    Category.assoc, Iso.hom_inv_id, Category.comp_id]

/-- **Tag 03GL's third assertion with every clause of the presentation.** Alongside the
isomorphism and its compatibility, the quotient map `R[T₀, …, Tₙ] ⟶ R[T₀, …, Tₙ]/I` is surjective
in every degree with the expected kernel, and `Proj` of the quotient is a closed subscheme of the
polynomial model — Stacks Tag 01N1 part (2) at the graded quotient map. -/
@[ega "II 3.6.2" "(ii)"]
theorem nonempty_projQuotientPresentation {Z : Scheme.{u}}
    (i : Z ⟶ AlgebraicGeometry.projectiveSpaceOverRing n (CommRingCat.of R))
    [IsClosedImmersion i] :
    Nonempty (ProjQuotientPresentation (polyGrading R n) (i ≫ (comparisonIso R n).hom)) :=
  ⟨Stacks.ProjQuotientFiniteCover.projectiveSpace_projQuotientPresentation R (n + 1)
    (i ≫ (comparisonIso R n).hom)⟩

/-! ### The two abbreviations of the statement, pinned to their constructions -/

/-- The ideal the quotient is taken by is the span of the homogeneous polynomials whose twisted
global section pulls back to zero on `Z`. -/
example {Z : Scheme.{u}} (i : Z ⟶ AlgebraicGeometry.Proj (polyGrading R n))
    [IsClosedImmersion i] :
    (homogeneousIdealOfClosedSubscheme (polyGrading R n) i).toIdeal =
      Ideal.span {a : MvPolynomial (Fin (n + 1)) R | ∃ (d : ℕ) (b : polyGrading R n d),
        (b : MvPolynomial (Fin (n + 1)) R) = a ∧
        AlgebraicGeometry.pullbackGlobalSections i
          (AlgebraicGeometry.ProjectiveSpectrum.Proj.twistingSheaf (polyGrading R n) (d : ℤ))
          (AlgebraicGeometry.ProjectiveSpectrum.Proj.degreeSection (polyGrading R n) d b) = 0} :=
  rfl

/-- `Proj` of the quotient is `Proj` of the degreewise image grading on `R[T₀, …, Tₙ]/I`, and the
morphism to the polynomial model is the one the graded quotient map induces, defined on all of
`Proj` of the quotient. -/
example {Z : Scheme.{u}} (i : Z ⟶ AlgebraicGeometry.Proj (polyGrading R n))
    [IsClosedImmersion i] :
    (projQuotient (polyGrading R n) i = AlgebraicGeometry.Proj
        (Stacks.RingTheory.HomogeneousQuotient.quotientGrading (polyGrading R n)
          (homogeneousIdealOfClosedSubscheme (polyGrading R n) i))) ∧
      ambientHom (polyGrading R n) i = Stacks.AlgebraicGeometry.RelativeProj.mapHomOfTop
        (polyGrading R n)
        (Stacks.RingTheory.HomogeneousQuotient.quotientGrading (polyGrading R n)
          (homogeneousIdealOfClosedSubscheme (polyGrading R n) i))
        (Stacks.RingTheory.HomogeneousQuotient.quotientMk (polyGrading R n)
          (homogeneousIdealOfClosedSubscheme (polyGrading R n) i))
        (mapDomain_eq_top (polyGrading R n) i) :=
  ⟨rfl, rfl⟩

end Stacks.ClosedSubschemeProjectiveSpace

end
