/-!
# A `u`-small cofinal subsystem of an affine dominant inverse system of schemes

Let `I` be a directed preorder at a universe `v` *independent* of the scheme universe `u`, let
`D : Iᵒᵖ ⥤ Over S` be an inverse system of schemes affine over a fixed base `S`, and let
`c` be a limit cone whose projections `c.pt ⟶ D.obj i` are quasi-compact and
scheme-theoretically dominant. Then there is a `u`-small directed preorder `J` and a monotone
map `e : J →o I` such that the cone restricted along `e` is *still* a limit cone.

This is a universe-freeing device. Mathlib's theory of cofiltered limits of schemes with affine
transition morphisms is stated for an index category at the scheme universe, and
`StacksFrontier/AlgebraicGeometry/LimitUniverse/AffineTransitionLimit.lean` frees it only up to
`CategoryTheory.InitiallySmall`, which is a genuine cofinality restriction on `I`. The results
here free it with *no* hypothesis relating the two universes, at the cost of hypotheses on the
system: affineness over a fixed base, and quasi-compact dominant projections. The point is that
such a system is determined by a filtered colimit of rings chart by chart, and a filtered
colimit of rings is generated by `u`-many elements, so `u`-many indices already suffice.

## Main results

* `AlgebraicGeometry.exists_small_colimit_of_injective`: a `u`-small family of filtered colimits
  of rings indexed by `I`, all of whose legs are injective, becomes a colimit after restriction
  along a single `e : J →o I` with `J` a `u`-small directed preorder.
* `AlgebraicGeometry.exists_small_limit_of_affine_of_dominant`: the statement described above.

## Route

The affine cover `S.affineCover` of the base turns the system into a `u`-small family of
inverse systems of *affine* schemes, one for each member of the cover. Global sections turn each
of those into a filtered colimit of rings whose legs are injective — injectivity is exactly
`AlgebraicGeometry.Scheme.Hom.app_injective` for the base change of a quasi-compact dominant
projection. A filtered colimit of rings is the union of the images of its legs, so `u`-many
indices suffice to hit every element of every one of those `u`-many colimits; the free-magma
construction turns that set of indices into a `u`-small directed preorder `J` with a monotone
map to `I`. Restricted along `e`, each chartwise cocone of rings is still a colimit, hence each
chartwise cone of affine schemes is still a limit, and a cone of schemes that is a limit after
pullback along every member of an open cover of the base is a limit.

## Universe situation

`I` lives at `v` and the schemes at `u`, with no relation between them. `J` is at `u` by
construction: it is the free magma on a `u`-small type.

## References

* [Stacks Project, Tag 01YX](https://stacks.math.columbia.edu/tag/01YX), limits of systems with
  affine transition morphisms.
* [Stacks Project, Tag 0CNT](https://stacks.math.columbia.edu/tag/0CNT), where this device is
  used.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits Opposite

universe v u

namespace AlgebraicGeometry

/-- A `u`-small family of filtered colimits of commutative rings, indexed by a directed preorder
`I` at an arbitrary universe and with injective legs, becomes a colimit after restriction along a
single monotone map from a `u`-small directed preorder — and that map can be made to hit a
prescribed `u`-small family of indices.

Injectivity of the legs is what makes the restricted cocone a colimit rather than merely
jointly surjective: the second condition of
`CategoryTheory.Types.FilteredColimit.isColimitOf'` becomes trivial. -/
public theorem exists_small_colimit_of_injective {I : Type v} [Preorder I] [Nonempty I]
    [IsDirected I (· ≤ ·)] {K : Type u} {A : K → I ⥤ CommRingCat.{u}}
    {α : Type u} [Nonempty α] (σ : α → I)
    (c : ∀ k, Cocone (A k)) (hc : ∀ k, IsColimit (c k))
    (hi : ∀ k i, Function.Injective ((c k).ι.app i).hom) :
    ∃ (J : Type u) (_ : Preorder J) (_ : Nonempty J) (_ : IsDirected J (· ≤ ·))
      (e : J →o I) (a : α → J), e ∘ a = σ ∧
        ∀ k, Nonempty (IsColimit ((c k).whisker e.monotone.functor)) := by
  classical
  choose s x hx using fun k y => exists_eq_ι_app_of_isColimit (c k) (hc k) y
  obtain ⟨J, hJ, hne, hd, e, a, ha⟩ :=
    exists_small_directed_factor (α := α ⊕ Σ k, (c k).pt)
      (Sum.elim σ fun t => s t.1 t.2)
  let := hJ
  let := hne
  let := hd
  refine ⟨J, inferInstance, inferInstance, inferInstance, e, a ∘ Sum.inl,
    funext fun t => congrFun ha (Sum.inl t), fun k => ?_⟩
  have ht : IsColimit ((forget CommRingCat).mapCocone ((c k).whisker e.monotone.functor)) := by
    apply Types.FilteredColimit.isColimitOf'
    · intro y
      refine ⟨a (Sum.inr ⟨k, y⟩), ?_⟩
      change ∃ z : (A k).obj (e (a (Sum.inr ⟨k, y⟩))),
        y = ((c k).ι.app (e (a (Sum.inr ⟨k, y⟩)))).hom z
      rw [show e (a (Sum.inr ⟨k, y⟩)) = s k y from congrFun ha (Sum.inr ⟨k, y⟩)]
      exact ⟨x k y, (hx k y).symm⟩
    · intro j y z hyz
      have h : y = z := hi k (e j) hyz
      subst h
      exact ⟨j, 𝟙 _, rfl⟩
  have : ReflectsColimit (e.monotone.functor ⋙ A k) (forget CommRingCat) :=
    reflectsColimit_of_reflectsIsomorphisms _ _
  exact ⟨isColimitOfReflects (forget CommRingCat) ht⟩

/-! ### The universe-freeing lemma -/

/-- The pullback of an affine morphism along a morphism from an affine scheme is affine. -/
private theorem isAffine_pullback_hom {S U : Scheme.{u}} (X : Over S) [IsAffineHom X.hom]
    [IsAffine U] (f : U ⟶ S) : IsAffine (pullback X.hom f) := inferInstance

attribute [local instance] IsCofiltered.isConnected in
/-- **A `u`-small cofinal-for-limits subsystem.** An inverse system of schemes over a directed
preorder `I` at an arbitrary universe, affine over a fixed base and with quasi-compact
scheme-theoretically dominant limit projections, restricts along a monotone map `e : J →o I`
from a `u`-small directed preorder to a system with the *same* limit — and `e` can be made to
hit a prescribed `u`-small family of indices.

No hypothesis relates the universe of `I` to the scheme universe `u`. -/
public theorem exists_small_limit_of_affine_of_dominant
    {I : Type v} [Preorder I] [Nonempty I] [IsDirected I (· ≤ ·)]
    {α : Type u} [Nonempty α] (σ : α → I)
    {S : Scheme.{u}} (D : Iᵒᵖ ⥤ Over S) (c : Cone D) (hc : IsLimit c)
    [∀ i, IsAffineHom (D.obj i).hom] [IsAffineHom c.pt.hom]
    [∀ i, QuasiCompact (c.π.app i).left]
    [∀ i, IsSchemeTheoreticallyDominant (c.π.app i).left] :
    ∃ (J : Type u) (_ : Preorder J) (_ : Nonempty J) (_ : IsDirected J (· ≤ ·))
      (e : J →o I) (a : α → J), e ∘ a = σ ∧
        Nonempty (IsLimit (c.whisker e.monotone.functor.op)) := by
  classical
  let U := S.affineCover
  let B (k : U.I₀) := Over.pullback (U.f k) ⋙ Over.forget _
  let cU (k : U.I₀) := (B k).mapCone c
  have hU (k : U.I₀) : IsLimit (cU k) := isLimitOfPreserves (B k) hc
  let (k : U.I₀) (i : Iᵒᵖ) : IsAffine ((D ⋙ B k).obj i) := isAffine_pullback_hom (D.obj i) (U.f k)
  let (k : U.I₀) : IsAffine (cU k).pt := isAffine_pullback_hom c.pt (U.f k)
  let A (k : U.I₀) := (opOpEquivalence I).inverse ⋙
    ((D ⋙ B k) ⋙ Scheme.Γ.rightOp).leftOp
  let r (k : U.I₀) : Cocone (A k) :=
    (coconeLeftOpOfCone (Scheme.Γ.rightOp.mapCone (cU k))).whisker
      (opOpEquivalence I).inverse
  have hr (k : U.I₀) : IsColimit (r k) :=
    (Functor.Final.isColimitWhiskerEquiv _ _).symm
      (isColimitCoconeLeftOpOfCone _ (isLimitOfPreserves Scheme.Γ.rightOp (hU k)))
  have hi (k : U.I₀) (i : I) : Function.Injective ((r k).ι.app i).hom := by
    let q := ((Over.pullback (U.f k)).map (c.π.app (op i))).left
    have : IsSchemeTheoreticallyDominant q :=
      IsSchemeTheoreticallyDominant.of_isPullback
        (overPullback_map_isPullback (U.f k) (c.π.app (op i)))
    let : QuasiCompact q := MorphismProperty.overPullbackMap
      (P := @QuasiCompact) (U.f k) (c.π.app (op i)) inferInstance
    exact q.app_injective ⊤
  obtain ⟨J, hJ, hne, hd, e, a, ha, he⟩ := exists_small_colimit_of_injective σ r hr hi
  let := hJ
  let := hne
  let := hd
  let E := e.monotone.functor.op
  let (i : Jᵒᵖ) (j : Jᵒᵖ) (b : i ⟶ j) :
      IsAffineHom (((E ⋙ D) ⋙ Over.forget S).map b) := by
    change IsAffineHom ((D.map (E.map b)).left)
    have : IsAffineHom ((D.map (E.map b)).left ≫ (D.obj (E.obj j)).hom) := by
      rw [(D.map (E.map b)).w]
      infer_instance
    exact IsAffineHom.of_comp _ (D.obj (E.obj j)).hom
  let : HasLimit (E ⋙ D) := hasLimit_of_created _ (Over.forget S)
  refine ⟨J, inferInstance, inferInstance, inferInstance, e, a, ha, ⟨?_⟩⟩
  apply isLimit_of_isLimit_overPullback (E ⋙ D) (c.whisker E) U
  intro k
  apply isLimitOfReflects (Over.forget _)
  let : IsAffine ((Over.forget (U.X k)).mapCone
      ((Over.pullback (U.f k)).mapCone (c.whisker E))).pt := isAffine_pullback_hom c.pt (U.f k)
  let (j : Jᵒᵖ) :
      IsAffine ((((E ⋙ D) ⋙ Over.pullback (U.f k)) ⋙ Over.forget (U.X k)).obj j) :=
    isAffine_pullback_hom (D.obj (E.obj j)) (U.f k)
  exact isLimit_of_isLimit_globalSections _ _ <| isLimitOfCoconeLeftOpOfCone _ <|
    (Functor.Final.isColimitWhiskerEquiv (opOpEquivalence J).inverse _).toFun (he k).some

end AlgebraicGeometry

end
