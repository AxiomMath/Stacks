module

public import StacksFrontier.AlgebraicGeometry.Rouquier.SupportedGeneratorTwoOpens
import StacksCore.Tactic.StacksAttribute

/-!
# A perfect generator for the supported quasi-coherent derived category

[Stacks, Tag 0A9A], the theorem of Rouquier: let `X` be a quasi-compact quasi-separated scheme and
let `T ⊆ X` be closed with quasi-compact complement. Then `D_{QCoh,T}(𝒪_X)` -- the complexes with
quasi-coherent cohomology supported on `T` -- is weakly generated by a single object which is
perfect as an object of `D(𝒪_X)`.

## Main definitions

* `Stacks.Rouquier.HasPerfectGeneratorSupported`: the property of a scheme `Y` and a subset
  `T ⊆ Y` that `D_{QCoh,T}(𝒪_Y)` is weakly generated by a single perfect object.
* `Stacks.Rouquier.HasPerfectGeneratorSupportedOn`: the property of an open `W` of `X` that every
  open subscheme of `X` whose image is `W` has a perfect generator for the preimage of `T`.

## Main results

* `Stacks.Rouquier.hasPerfectGeneratorSupportedOn_of_isAffineOpen`: the property holds on affine
  opens.
* `Stacks.Rouquier.hasPerfectGeneratorSupportedOn_sup`: the property passes from a quasi-compact
  open `U` and an affine open `V` to `U ⊔ V`.
* `Stacks.Rouquier.exists_isPerfect_isWeakTriangulatedGenerator_supported`: `D_{QCoh,T}(𝒪_X)` has
  a weak triangulated generator which is perfect as an object of `D(𝒪_X)`.
* `Stacks.Rouquier.exists_isPerfect_isZero_iff_forall_hom_eq_zero_supported`: there is a perfect
  object `P` of `D(𝒪_X)` such that an object `E` of `D_{QCoh,T}(𝒪_X)` is zero if and only if
  every morphism `P⟦n⟧ ⟶ E` is zero.

## References

* [Stacks Project, Tag 0A9A](https://stacks.math.columbia.edu/tag/0A9A)
* [Stacks Project, Tag 09IS](https://stacks.math.columbia.edu/tag/09IS)
* [Stacks Project, Tag 08DR](https://stacks.math.columbia.edu/tag/08DR)
* [Rouquier, Theorem 6.8, *Dimensions of triangulated categories*]
-/

-- This file uses the locally small derived-category models below, which are not
-- global instances (see `StacksFrontier.Homology.DerivedCategory.LocallySmall`):
-- `D(R)` for sheaves of modules on a small site.
-- `D(𝒪_X)` for a scheme.
attribute [local instance] SheafOfModules.hasDerivedCategory
attribute [local instance] AlgebraicGeometry.Scheme.Modules.hasDerivedCategory

@[expose] public noncomputable section

open AlgebraicGeometry CategoryTheory CategoryTheory.Limits CategoryTheory.ObjectProperty
open TopologicalSpace
open Stacks.Cohomology.PerfectComplexes (IsPerfect)
open Stacks.DerivedQCoh.AnyModel (compactSpace_of_range_isCompact
  isCompact_preimage_of_subset_range range_preimage_ι_comp)

universe u

namespace Stacks.Rouquier

/-! ### Perfect generators of the supported derived category -/

/-- **`D_{QCoh,T}(𝒪_Y)` has a perfect weak generator**: there is an object of `D_{QCoh,T}(𝒪_Y)`
which is perfect as an object of `D(𝒪_Y)` and whose singleton weakly generates
`D_{QCoh,T}(𝒪_Y)`. -/
def HasPerfectGeneratorSupported (Y : Scheme.{u}) (T : Set Y) : Prop :=
  ∃ G : Stacks.Duality.QuasiCoherentSupportedDerivedCategory Y T,
    IsPerfect (X := Y.toRingedSpace) G.obj ∧
      (ObjectProperty.singleton G).IsWeakTriangulatedGenerator

/-- **Perfect generators over the open subschemes with image `W`**: for every open immersion
`h : Y ⟶ X` with image `W`, `D_{QCoh,h⁻¹T}(𝒪_Y)` has a perfect weak generator. -/
def HasPerfectGeneratorSupportedOn {X : Scheme.{u}} (T : Set X) (W : X.Opens) : Prop :=
  ∀ (Y : Scheme.{u}) (h : Y ⟶ X), IsOpenImmersion h → Set.range h.base = (W : Set X) →
    HasPerfectGeneratorSupported Y (⇑h.base ⁻¹' T)

/-! ### Affine opens and unions -/

/-- **The property holds on affine opens.** If `X` is quasi-separated and `T ⊆ X` is closed with
quasi-compact complement, then `Stacks.Rouquier.HasPerfectGeneratorSupportedOn T W` holds for
every affine open `W` of `X`. -/
theorem hasPerfectGeneratorSupportedOn_of_isAffineOpen {X : Scheme.{u}} [QuasiSeparatedSpace X]
    (T : Set X) (hT : IsClosed T) (hTc : IsCompact Tᶜ) (W : X.Opens) (hW : IsAffineOpen W) :
    HasPerfectGeneratorSupportedOn T W := by
  intro Y h _ hrange
  have : IsAffine W.toScheme := hW
  exact exists_isPerfect_isWeakTriangulatedGenerator_supported_of_iso_spec
    (A := (Γ(X, W) : Type u))
    (IsOpenImmersion.isoOfRangeEq h W.ι (by rw [hrange, Scheme.Opens.range_ι]) ≪≫ hW.isoSpec)
    _ (hT.preimage h.continuous)
    (isCompact_compl_preimage_of_isOpenEmbedding h.isOpenEmbedding
      (by rw [hrange]; exact hW.isCompact) T hT hTc)

/-- **The property passes to unions with an affine open.** If `X` is quasi-separated and `T ⊆ X`
is closed with quasi-compact complement, the property
`Stacks.Rouquier.HasPerfectGeneratorSupportedOn T` passes from a quasi-compact open `U` and an
affine open `V` of `X` to `U ⊔ V`. -/
theorem hasPerfectGeneratorSupportedOn_sup {X : Scheme.{u}} [QuasiSeparatedSpace X] (T : Set X)
    (hT : IsClosed T) (hTc : IsCompact Tᶜ) (U V : X.Opens) (hU : IsCompact (U : Set X))
    (hV : IsAffineOpen V) (hPU : HasPerfectGeneratorSupportedOn T U) :
    HasPerfectGeneratorSupportedOn T (U ⊔ V) := by
  intro Y h _ hrange
  have : QuasiSeparatedSpace Y := QuasiSeparatedSpace.of_isOpenEmbedding h.isOpenEmbedding
  have : IsAffine V.toScheme := hV
  have hr : Set.range h.base = (U : Set X) ∪ V := by rw [hrange, Opens.coe_sup]
  have hUle : (U : Set X) ⊆ Set.range h.base := hr ▸ Set.subset_union_left
  have hVle : (V : Set X) ⊆ Set.range h.base := hr ▸ Set.subset_union_right
  have hYc : IsCompact (Set.range h.base) := hr ▸ hU.union hV.isCompact
  have : CompactSpace Y := compactSpace_of_range_isCompact h hYc
  have hiso : (h ⁻¹ᵁ V).toScheme ≅ V.toScheme :=
    IsOpenImmersion.isoOfRangeEq ((h ⁻¹ᵁ V).ι ≫ h) V.ι (by
      rw [range_preimage_ι_comp h V hVle, Scheme.Opens.range_ι])
  have hcover : (h ⁻¹ᵁ U) ⊔ (h ⁻¹ᵁ V) = (⊤ : Y.Opens) := by
    ext y
    have hy : h.base y ∈ (U : Set X) ∪ V := hr ▸ ⟨y, rfl⟩
    simpa using hy
  have hgen := hPU _ ((h ⁻¹ᵁ U).ι ≫ h) inferInstance (range_preimage_ι_comp h U hUle)
  exact exists_isPerfect_isWeakTriangulatedGenerator_supported_of_two_opens (h ⁻¹ᵁ U) (h ⁻¹ᵁ V)
    (isCompact_preimage_of_subset_range h U hU hUle) (A := (Γ(X, V) : Type u))
    (hiso ≪≫ hV.isoSpec) hcover (⇑h.base ⁻¹' T) (hT.preimage h.continuous)
    (isCompact_compl_preimage_of_isOpenEmbedding h.isOpenEmbedding hYc T hT hTc) hgen

/-! ### The theorem of Rouquier -/

/-- **The theorem of Rouquier.** Let `X` be a quasi-compact quasi-separated
scheme and let `T ⊆ X` be closed with quasi-compact complement. Then `D_{QCoh,T}(𝒪_X)` has a weak
triangulated generator which is perfect as an object of `D(𝒪_X)`. -/
@[stacks 0A9A "the generator, in the ObjectProperty.IsWeakTriangulatedGenerator spelling"]
theorem exists_isPerfect_isWeakTriangulatedGenerator_supported (X : Scheme.{u}) [CompactSpace X]
    [QuasiSeparatedSpace X] (T : Set X) (hT : IsClosed T) (hTc : IsCompact Tᶜ) :
    ∃ G : Stacks.Duality.QuasiCoherentSupportedDerivedCategory X T,
      IsPerfect (X := X.toRingedSpace) G.obj ∧
        (ObjectProperty.singleton G).IsWeakTriangulatedGenerator := by
  have hgen := Stacks.AlgebraicGeometry.InductionPrinciple.induction_top (X := X)
    (HasPerfectGeneratorSupportedOn T)
    (fun W hW => hasPerfectGeneratorSupportedOn_of_isAffineOpen T hT hTc W hW)
    (fun U V hU hV hPU _ _ => hasPerfectGeneratorSupportedOn_sup T hT hTc U V hU hV hPU)
    X (𝟙 X) inferInstance (by simp)
  rwa [show ⇑(𝟙 X : X ⟶ X).base ⁻¹' T = T from by simp] at hgen

/-- **The theorem of Rouquier, with the generator condition spelled out.** Let `X` be a
quasi-compact quasi-separated scheme and let `T ⊆ X` be closed with quasi-compact complement.
There is a perfect object `P` of `D(𝒪_X)` such that for every object `E` of `D_{QCoh,T}(𝒪_X)` the
following are equivalent: `E = 0`, and `Hom_{D(𝒪_X)}(P⟦n⟧, E) = 0` for all `n : ℤ`. -/
@[stacks 0A9A]
theorem exists_isPerfect_isZero_iff_forall_hom_eq_zero_supported (X : Scheme.{u}) [CompactSpace X]
    [QuasiSeparatedSpace X] (T : Set X) (hT : IsClosed T) (hTc : IsCompact Tᶜ) :
    ∃ P : DerivedCategory X.Modules, IsPerfect (X := X.toRingedSpace) P ∧
      ∀ E : DerivedCategory X.Modules, Stacks.Duality.quasiCoherentSupported X T E →
        (IsZero E ↔ ∀ (n : ℤ) (g : P⟦n⟧ ⟶ E), g = 0) := by
  obtain ⟨G, hGperf, hGgen⟩ :=
    exists_isPerfect_isWeakTriangulatedGenerator_supported X T hT hTc
  exact ⟨G.obj, hGperf, fun E hE => ⟨fun hz n g => hz.eq_of_tgt _ _, fun hzero =>
    (@ObjectProperty.isWeakTriangulatedGenerator_singleton_iff _ _ _ _
      (Stacks.Duality.quasiCoherentSupported X T)
      (Stacks.Duality.Supported.quasiCoherentSupported_isTriangulated X T).toIsStableUnderShift
      G).1 hGgen E hE hzero⟩⟩

end Stacks.Rouquier

end
