module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.TorsionSheavesCurves.TorsionSheavesReduction
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.SmallEtaleCoefficientLift
public import StacksFrontier.CategoryTheory.Abelian.ExtMapFunctorialSquare
public import StacksFrontier.CategoryTheory.Sites.Cohomology.CoefficientUniverseLiftEssImage

/-!
# Theorem 03SC at every coefficient universe

The reduction theorem `Stacks.EtaleCohomology.curveStatements_of_torsionSheafProperty` is proved
at the coefficients `AddCommGrpCat.{u + 1}`, while the statements of Situation 0A52 are posed at
`AddCommGrpCat.{max (u + 1) v}` for every `v`. This file transports the theorem along the universe
lift of the coefficients.

* An abelian sheaf at `AddCommGrpCat.{max (u + 1) v}` is the filtered colimit of its subsheaves
  generated by finitely many sections (`Stacks.EtaleCohomology.isColimitGeneratedCocone`), and
  each of them is the universe lift of a sheaf at `AddCommGrpCat.{u + 1}`
  (`Stacks.EtaleCohomology.exists_isColimit_etaleUlift_mono`): the generating subpresheaf has
  `u`-small values, and the essential image of the lift is closed under quotients.
* The lift does not change cohomology, and it commutes with inverse image
  (`Stacks.EtaleCohomology.etaleAbelianInverseImageUliftIso`), hence with the restriction maps of
  statements (6), (7), (8) (`Stacks.EtaleCohomology.etaleCohomologyRestrictionMap_ulift_iff`).
* Torsion conditions descend along the lift; Tag 03Q5 at the coefficients
  `AddCommGrpCat.{max (u + 1) v}` passes statements (1), (2), (3), (6), (7), (8) to the colimit.

## Main results

* `Stacks.EtaleCohomology.curveStatements_partial_of_torsionSheafProperty`: statements (1), (2),
  (3), (6), (7), (8) of Situation 0A52 for every torsion sheaf at every coefficient universe,
  granted the base case of Lemma 0A5B.

**No `@[stacks]` attribute**: the base case of Lemma 0A5B enters as the hypothesis `hbase`; the
tagged statements are in `TorsionSheavesCurves/CurveCohomologyTheorem.lean`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open Stacks.Cohomology.CoefficientLift

universe w w' v u

namespace Stacks.EtaleCohomology

/-- The universe lift of coefficients from `AddCommGrpCat.{u + 1}` to
`AddCommGrpCat.{max (u + 1) v}` on the small étale site of `X`. -/
abbrev etaleUlift (X : Scheme.{u}) :
    Sheaf X.smallEtaleTopology AddCommGrpCat.{u + 1} ⥤
      Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v} :=
  sheafCompose X.smallEtaleTopology AddCommGrpCat.uliftFunctor.{v, u + 1}

section Instances

variable (X : Scheme.{u})

/-- The universe lift of abelian groups is compatible with sheafification on the small étale
site. -/
instance preservesSheafification_etaleUlift :
    X.smallEtaleTopology.PreservesSheafification AddCommGrpCat.uliftFunctor.{v, u + 1} :=
  (etaleUlift_properties.{u, u + 1, v} X).1

/-- The universe lift of abelian sheaves on the small étale site preserves injective objects. -/
instance preservesInjectiveObjects_etaleUlift :
    (etaleUlift.{v} X).PreservesInjectiveObjects :=
  (etaleUlift_properties.{u, u + 1, v} X).2

/-- The universe lift of abelian sheaves preserves finite limits. -/
instance preservesFiniteLimits_etaleUlift : PreservesFiniteLimits (etaleUlift.{v} X) :=
  uliftSheafCompose_preservesFiniteLimits.{u + 1, v} X.smallEtaleTopology

/-- The universe lift of abelian sheaves preserves finite colimits. -/
instance preservesFiniteColimits_etaleUlift : PreservesFiniteColimits (etaleUlift.{v} X) :=
  uliftSheafCompose_preservesFiniteColimits.{u + 1, v} X.smallEtaleTopology

/-- The universe lift of abelian sheaves is additive. -/
instance additive_etaleUlift : (etaleUlift.{v} X).Additive := ⟨by intros; rfl⟩

end Instances

attribute [local instance] hasExt_sheaf_smallEtale_succ

/-- Étale inverse image commutes with the universe lift of the coefficients. -/
def etaleAbelianInverseImageUliftIso {X Y : Scheme.{u}} (i : Y ⟶ X) :
    etaleUlift.{v} X ⋙ etaleAbelianInverseImage.{u, v} i ≅
      etaleAbelianInverseImage.{u, 0} i ⋙ etaleUlift.{v} Y := by
  let G := smallEtaleBaseChange i
  let eLan := AddCommGrpCat.uliftFunctor.{v, u + 1}.lanCompIsoOfPreserves G.op
  let eSheaf := sheafComposeNatIso Y.smallEtaleTopology AddCommGrpCat.uliftFunctor.{v, u + 1}
    (sheafificationAdjunction Y.smallEtaleTopology AddCommGrpCat.{u + 1})
    (sheafificationAdjunction Y.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})
  exact Functor.isoWhiskerLeft (sheafToPresheaf X.smallEtaleTopology AddCommGrpCat.{u + 1})
    (Functor.isoWhiskerRight eLan.symm (presheafToSheaf _ _) ≪≫
      Functor.isoWhiskerLeft G.op.lan eSheaf)

/-- Restriction on étale cohomology is the map induced by inverse image on `Ext`, followed by a
bijection; so it is bijective, or surjective, exactly when that map is. -/
theorem etaleCohomologyRestrictionMap_bijective_and_surjective_iff {X Y : Scheme.{u}} (i : Y ⟶ X)
    [HasExt.{w} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
    [HasExt.{w} (Sheaf Y.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
    (F : Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v}) (q : ℕ) :
    (Function.Bijective (etaleCohomologyRestrictionMap.{u, v, w} i F q) ↔
      Function.Bijective ((etaleAbelianInverseImage.{u, v} i).mapExtAddHom
        ((constantSheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v}).obj
          (AddCommGrpCat.of (ULift ℤ))) F q)) ∧
    (Function.Surjective (etaleCohomologyRestrictionMap.{u, v, w} i F q) ↔
      Function.Surjective ((etaleAbelianInverseImage.{u, v} i).mapExtAddHom
        ((constantSheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v}).obj
          (AddCommGrpCat.of (ULift ℤ))) F q)) := by
  have hb := ExtFunctorial.bijective_mk₀_comp
    (Y := (etaleAbelianInverseImage.{u, v} i).obj F)
    ((etaleAbelianInverseImageConstantIso.{u, v} i).app (AddCommGrpCat.of (ULift ℤ))).symm q
  have h := ExtFunctorial.bijective_iff_and_surjective_iff_of_comp_eq Function.bijective_id hb
    (f := (etaleAbelianInverseImage.{u, v} i).mapExtAddHom _ F q)
    (g := etaleCohomologyRestrictionMap.{u, v, w} i F q) (fun x ↦ rfl)
  exact ⟨h.1.symm, h.2.symm⟩

/-- **Restriction maps are compatible with the universe lift of the coefficients.** For an abelian
sheaf `G` at the coefficients `AddCommGrpCat.{u + 1}` and any morphism `i : Y ⟶ X`, restriction
along `i` on the cohomology of the universe lift of `G` is bijective (surjective) exactly when
restriction on the cohomology of `G` is. -/
theorem etaleCohomologyRestrictionMap_ulift_iff {X Y : Scheme.{u}} (i : Y ⟶ X)
    [HasExt.{w} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
    [HasExt.{w} (Sheaf Y.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
    (G : Sheaf X.smallEtaleTopology AddCommGrpCat.{u + 1}) (q : ℕ) :
    (Function.Bijective (etaleCohomologyRestrictionMap.{u, v, w} i
        ((etaleUlift.{v} X).obj G) q) ↔
      Function.Bijective (etaleCohomologyRestrictionMap.{u, 0, u + 1} i G q)) ∧
    (Function.Surjective (etaleCohomologyRestrictionMap.{u, v, w} i
        ((etaleUlift.{v} X).obj G) q) ↔
      Function.Surjective (etaleCohomologyRestrictionMap.{u, 0, u + 1} i G q)) := by
  have h₁ := etaleCohomologyRestrictionMap_bijective_and_surjective_iff.{w, v, u} i
    ((etaleUlift.{v} X).obj G) q
  have h₀ := etaleCohomologyRestrictionMap_bijective_and_surjective_iff.{u + 1, 0, u} i G q
  have hs := ExtFunctorial.mapExt_square_bijective (etaleUlift.{v} X) (etaleUlift.{v} Y)
    (etaleAbelianInverseImage.{u, 0} i) (etaleAbelianInverseImage.{u, v} i)
    (etaleAbelianInverseImageUliftIso.{v} i)
    (constantSheafUliftIso.{u + 1, v} X.smallEtaleTopology).symm G q
  exact ⟨h₁.1.trans (hs.1.symm.trans h₀.1.symm), h₁.2.trans (hs.2.symm.trans h₀.2.symm)⟩

/-- The cohomology of an abelian sheaf at the coefficients `AddCommGrpCat.{u + 1}` and that of its
universe lift vanish together. -/
theorem subsingleton_sheafH_etaleUlift_iff {X : Scheme.{u}}
    [HasExt.{w} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
    (G : Sheaf X.smallEtaleTopology AddCommGrpCat.{u + 1}) (q : ℕ) :
    Subsingleton (Sheaf.H.{w} ((etaleUlift.{v} X).obj G) q) ↔
      Subsingleton (Sheaf.H.{u + 1} G q) :=
  subsingleton_sheafH_ulift_iff.{u + 1, u + 1, v, w} X.smallEtaleTopology G q

/-- The cohomology of an abelian sheaf at the coefficients `AddCommGrpCat.{u + 1}` and that of its
universe lift are finite together. -/
theorem finite_sheafH_etaleUlift_iff {X : Scheme.{u}}
    [HasExt.{w} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
    (G : Sheaf X.smallEtaleTopology AddCommGrpCat.{u + 1}) (q : ℕ) :
    Finite (Sheaf.H.{w} ((etaleUlift.{v} X).obj G) q) ↔ Finite (Sheaf.H.{u + 1} G q) :=
  (sheafHUliftAddEquiv.{u + 1, u + 1, v, w} X.smallEtaleTopology G q).toEquiv.finite_iff.symm

/-- Restriction maps on the cohomology of isomorphic sheaves are bijective (surjective)
together. -/
theorem etaleCohomologyRestrictionMap_iso_iff {X Y : Scheme.{u}} (i : Y ⟶ X)
    [HasExt.{w} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
    [HasExt.{w} (Sheaf Y.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
    {F₁ F₂ : Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v}} (e : F₁ ≅ F₂) (q : ℕ) :
    (Function.Bijective (etaleCohomologyRestrictionMap.{u, v, w} i F₁ q) ↔
      Function.Bijective (etaleCohomologyRestrictionMap.{u, v, w} i F₂ q)) ∧
    (Function.Surjective (etaleCohomologyRestrictionMap.{u, v, w} i F₁ q) ↔
      Function.Surjective (etaleCohomologyRestrictionMap.{u, v, w} i F₂ q)) :=
  ExtFunctorial.bijective_iff_and_surjective_iff_of_comp_eq
    (ExtFunctorial.bijective_comp_mk₀ e q)
    (ExtFunctorial.bijective_comp_mk₀ ((etaleAbelianInverseImage.{u, v} i).mapIso e) q)
    (fun x ↦ etaleCohomologyRestrictionMap_comp_mk₀.{u, v, w} i e.hom q x)

section Torsion

variable {X : Scheme.{u}} {G : Sheaf X.smallEtaleTopology AddCommGrpCat.{u + 1}}

/-- Torsion descends along the universe lift of the coefficients. -/
theorem torsionSheafProperty_of_etaleUlift
    (h : Stacks.Torsion.torsionSheafProperty X.smallEtaleTopology ((etaleUlift.{v} X).obj G)) :
    Stacks.Torsion.torsionSheafProperty X.smallEtaleTopology G := by
  intro U x
  obtain ⟨R, hR, hx⟩ := h U (ULift.up x)
  exact ⟨R, hR, fun V f hf ↦ (hx V f hf).imp fun n hn ↦ ⟨hn.1, congrArg ULift.down hn.2⟩⟩

/-- Prime-power torsion descends along the universe lift of the coefficients. -/
theorem isPrimePowerTorsion_of_etaleUlift {l : ℕ}
    (h : Stacks.Torsion.IsPrimePowerTorsion X.smallEtaleTopology l ((etaleUlift.{v} X).obj G)) :
    Stacks.Torsion.IsPrimePowerTorsion X.smallEtaleTopology l G := by
  intro U x
  obtain ⟨R, hR, hx⟩ := h U (ULift.up x)
  exact ⟨R, hR, fun V f hf ↦ (hx V f hf).imp fun n hn ↦ ⟨hn.1, congrArg ULift.down hn.2⟩⟩

/-- Torsion prime to `p` descends along the universe lift of the coefficients. -/
theorem isPrimeToCharacteristicTorsion_of_etaleUlift {p : ℕ}
    (h : Stacks.Torsion.IsPrimeToCharacteristicTorsion X.smallEtaleTopology p
      ((etaleUlift.{v} X).obj G)) :
    Stacks.Torsion.IsPrimeToCharacteristicTorsion X.smallEtaleTopology p G := by
  intro U x
  obtain ⟨R, hR, hx⟩ := h U (ULift.up x)
  exact ⟨R, hR, fun V f hf ↦
    (hx V f hf).imp fun n hn ↦ ⟨hn.1, hn.2.1, congrArg ULift.down hn.2.2⟩⟩

end Torsion

section Generated

variable {X : Scheme.{u}} (F : Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})

/-- The subgroup of sections of `F` over `V` generated by the restrictions of the sections in a
finite set `s` of sections of `F`. -/
def generatedSubgroup (s : Finset (Σ U : X.Etale, F.obj.obj (Opposite.op U))) (V : X.Etaleᵒᵖ) :
    AddSubgroup (F.obj.obj V) :=
  AddSubgroup.closure {y | ∃ x ∈ s, ∃ f : V.unop ⟶ x.1, F.obj.map f.op x.2 = y}

/-- The generated subgroup grows with the set of generators. -/
theorem generatedSubgroup_mono {s t : Finset (Σ U : X.Etale, F.obj.obj (Opposite.op U))}
    (h : s ⊆ t) (V : X.Etaleᵒᵖ) : generatedSubgroup F s V ≤ generatedSubgroup F t V :=
  AddSubgroup.closure_mono fun _ ⟨x, hx, f, hf⟩ ↦ ⟨x, h hx, f, hf⟩

/-- Restriction maps the generated subgroup into the generated subgroup. -/
theorem map_generatedSubgroup_le (s : Finset (Σ U : X.Etale, F.obj.obj (Opposite.op U)))
    {V W : X.Etaleᵒᵖ} (g : V ⟶ W) :
    (generatedSubgroup F s V).map (F.obj.map g).hom ≤ generatedSubgroup F s W := by
  rw [AddSubgroup.map_le_iff_le_comap, generatedSubgroup, AddSubgroup.closure_le]
  rintro _ ⟨x, hx, f, rfl⟩
  refine AddSubgroup.subset_closure ⟨x, hx, g.unop ≫ f, ?_⟩
  change F.obj.map (f.op ≫ g) x.2 = F.obj.map g (F.obj.map f.op x.2)
  rw [Functor.map_comp]
  rfl

/-- The sections of a generated subgroup are small. -/
theorem small_generatedSubgroup (s : Finset (Σ U : X.Etale, F.obj.obj (Opposite.op U)))
    (V : X.Etaleᵒᵖ) : Small.{u} (generatedSubgroup F s V) := by
  let ι := Σ x : s, (V.unop ⟶ x.1.1)
  let φ : ι → F.obj.obj V := fun p ↦ F.obj.map p.2.op p.1.1.2
  have : Small.{u} ι := by
    have : Small.{u} s := small_of_injective (f := fun p ↦ (s.equivFin p : Fin s.card))
      (Equiv.injective _)
    infer_instance
  let ψ := FreeAbelianGroup.lift (φ ∘ (equivShrink.{u} ι).symm)
  have hle : generatedSubgroup F s V ≤ ψ.range := by
    rw [generatedSubgroup, AddSubgroup.closure_le]
    rintro _ ⟨x, hx, f, rfl⟩
    refine ⟨FreeAbelianGroup.of (equivShrink ι ⟨⟨x, hx⟩, f⟩), ?_⟩
    change FreeAbelianGroup.lift _ (FreeAbelianGroup.of _) = φ ⟨⟨x, hx⟩, f⟩
    rw [FreeAbelianGroup.lift_apply_of]
    exact congrArg φ (Equiv.symm_apply_apply _ _)
  exact small_of_injective (f := fun y : generatedSubgroup F s V ↦
    (⟨y.1, hle y.2⟩ : Set.range ψ))
    (fun a b h ↦ Subtype.ext (by have := congrArg Subtype.val h; exact this))

/-- The subpresheaf of `F` generated by a finite set of sections. -/
def generatedPresheaf (s : Finset (Σ U : X.Etale, F.obj.obj (Opposite.op U))) :
    X.Etaleᵒᵖ ⥤ AddCommGrpCat.{max (u + 1) v} where
  obj V := AddCommGrpCat.of (generatedSubgroup F s V)
  map g := AddCommGrpCat.ofHom
    (((F.obj.map g).hom.comp (generatedSubgroup F s _).subtype).codRestrict _
      (fun y ↦ map_generatedSubgroup_le F s g ⟨y.1, y.2, rfl⟩))
  map_id V := AddCommGrpCat.ext fun y ↦ by apply Subtype.ext; simp
  map_comp f g := AddCommGrpCat.ext fun y ↦ by apply Subtype.ext; simp

/-- The values of a finitely generated subpresheaf are small. -/
theorem small_generatedPresheaf_obj (s : Finset (Σ U : X.Etale, F.obj.obj (Opposite.op U)))
    (V : X.Etaleᵒᵖ) : Small.{u + 1} ((generatedPresheaf F s).obj V) := by
  have := small_generatedSubgroup F s V
  exact small_of_injective (β := ULift.{u + 1} (Shrink.{u} (generatedSubgroup F s V)))
    (f := fun y ↦ ULift.up (equivShrink (generatedSubgroup F s V) y))
    (fun a b h ↦ (equivShrink (generatedSubgroup F s V)).injective (congrArg ULift.down h))

/-- The diagram of finitely generated subpresheaves of `F`. -/
def generatedDiagram :
    Finset (Σ U : X.Etale, F.obj.obj (Opposite.op U)) ⥤ (X.Etaleᵒᵖ ⥤ AddCommGrpCat.{max (u + 1) v})
    where
  obj s := generatedPresheaf F s
  map {_s _t} h :=
    { app V := AddCommGrpCat.ofHom (AddSubgroup.inclusion (generatedSubgroup_mono F (leOfHom h) V))
      naturality _ _ _ := rfl }
  map_id _ := rfl
  map_comp _ _ := rfl

/-- The inclusions of the finitely generated subpresheaves of `F`. -/
def generatedCocone : Cocone (generatedDiagram F) where
  pt := F.obj
  ι :=
    { app s :=
        { app V := AddCommGrpCat.ofHom (generatedSubgroup F s V).subtype
          naturality _ _ _ := rfl }
      naturality _ _ _ := rfl }

/-- **The underlying presheaf of `F` is the filtered colimit of its finitely generated
subpresheaves.** -/
def isColimitGeneratedCocone : IsColimit (generatedCocone F) := by
  classical
  have : IsFiltered (Finset (Σ U : X.Etale, F.obj.obj (Opposite.op U))) :=
    isFiltered_of_semilatticeSup_nonempty _
  have : ReflectsColimitsOfShape (Finset (Σ U : X.Etale, F.obj.obj (Opposite.op U)))
      (forget AddCommGrpCat.{max (u + 1) v}) := reflectsColimitsOfShape_of_reflectsIsomorphisms
  refine evaluationJointlyReflectsColimits _ fun V ↦ ?_
  refine isColimitOfReflects (forget AddCommGrpCat.{max (u + 1) v}) ?_
  refine Types.FilteredColimit.isColimitOf' _ _ ?_ ?_
  · intro x
    exact ⟨{⟨V.unop, x⟩},
      ⟨x, AddSubgroup.subset_closure ⟨⟨V.unop, x⟩, by simp, 𝟙 _, by simp; rfl⟩⟩, rfl⟩
  · intro s x y h
    exact ⟨s, 𝟙 s, Subtype.ext h⟩

/-- **Every abelian sheaf at the coefficients `AddCommGrpCat.{max (u + 1) v}` is a filtered colimit
of subsheaves which are universe lifts of sheaves at the coefficients `AddCommGrpCat.{u + 1}`.**
The terms are the subsheaves generated by finitely many sections. -/
theorem exists_isColimit_etaleUlift_mono :
    ∃ (I : Type (max (u + 1) v)) (_ : SmallCategory I) (_ : IsFiltered I)
      (D : I ⥤ Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})
      (ι : D ⟶ (Functor.const I).obj F), Nonempty (IsColimit (Cocone.mk F ι)) ∧
        ∀ j, Mono (ι.app j) ∧ ∃ G : Sheaf X.smallEtaleTopology AddCommGrpCat.{u + 1},
          Nonempty ((etaleUlift.{v} X).obj G ≅ D.obj j) := by
  classical
  let I := Finset (Σ U : X.Etale, F.obj.obj (Opposite.op U))
  have : IsFiltered I := isFiltered_of_semilatticeSup_nonempty _
  let P := presheafToSheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v}
  have : PreservesColimitsOfSize.{max (u + 1) v, max (u + 1) v} P :=
    (sheafificationAdjunction X.smallEtaleTopology _).leftAdjoint_preservesColimits
  let c₁ := P.mapCocone (generatedCocone F)
  have hc₁ : IsColimit c₁ := isColimitOfPreserves P (isColimitGeneratedCocone F)
  let e : c₁.pt ≅ F := (sheafificationIso F).symm
  let c₂ : Cocone (generatedDiagram F ⋙ P) :=
    { pt := F
      ι := c₁.ι ≫ (Functor.const I).map e.hom }
  have hc₂ : IsColimit c₂ := hc₁.ofIsoColimit (Cocone.ext e (fun _ ↦ rfl))
  obtain ⟨D, ι, ⟨hc⟩, hD⟩ := exists_isColimit_mono_of_isColimit hc₂
  refine ⟨I, inferInstance, inferInstance, D, ι, ⟨hc⟩, fun s ↦ ⟨(hD s).1, ?_⟩⟩
  obtain ⟨p, hp⟩ := (hD s).2
  have := small_generatedPresheaf_obj F s
  obtain ⟨G, ⟨eG⟩⟩ := exists_sheafCompose_iso_presheafToSheaf.{u + 1, v} X.smallEtaleTopology
    (generatedPresheaf F s)
  have : Epi (eG.hom ≫ p) := @epi_comp _ _ _ _ _ _ _ _ hp
  exact exists_sheafCompose_iso_of_epi.{u + 1, v} X.smallEtaleTopology (eG.hom ≫ p)

end Generated

section Colimit

attribute [local instance] Stacks.Cohomology.ColimitsOfCohomology.additive_sheafΓ

/-- Étale cohomology in degree `q`, as a functor on abelian sheaves at the coefficients
`AddCommGrpCat.{max (u + 1) v}` with `Ext` in the universe `max (u + 1) v`. -/
abbrev smallEtaleFunctorHMax (X : Scheme.{u})
    [HasExt.{max (u + 1) v} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})] (q : ℕ) :
    Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v} ⥤ AddCommGrpCat.{max (u + 1) v} :=
  Sheaf.functorH.{max (u + 1) v, max (u + 1) v, u, u + 1} X.smallEtaleTopology q

/-- **Tag 03Q5 for `Sheaf.H` at the coefficients `AddCommGrpCat.{max (u + 1) v}`.** -/
theorem preservesColimitsOfShape_functorH_smallEtale_max (X : Scheme.{u}) [CompactSpace X]
    [QuasiSeparatedSpace X]
    [HasExt.{max (u + 1) v} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
    (q : ℕ) (I : Type (max (u + 1) v)) [SmallCategory I] [IsFiltered I] :
    PreservesColimitsOfShape I (smallEtaleFunctorHMax.{v} X q) :=
  have := preservesColimitsOfShape_rightDerived_Γ_smallEtale.{v} X q I
  preservesColimitsOfShape_of_natIso
    (Cohomology.GlobalSections.rightDerivedΓIsoFunctorH.{v} X.smallEtaleTopology q)

/-- Restriction on étale cohomology along `i : Y ⟶ X`, as a natural transformation, at the
coefficients `AddCommGrpCat.{max (u + 1) v}`. -/
def etaleCohomologyRestrictionNatTransMax {X Y : Scheme.{u}} (i : Y ⟶ X)
    [HasExt.{max (u + 1) v} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
    [HasExt.{max (u + 1) v} (Sheaf Y.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})] (q : ℕ) :
    smallEtaleFunctorHMax.{v} X q ⟶
      etaleAbelianInverseImage.{u, v} i ⋙ smallEtaleFunctorHMax.{v} Y q where
  app F := AddCommGrpCat.ofHom (etaleCohomologyRestrictionMap.{u, v, max (u + 1) v} i F q)
  naturality F G φ := by
    ext x
    exact etaleCohomologyRestrictionMap_comp_mk₀.{u, v, max (u + 1) v} i φ q x

/-- Étale inverse image preserves colimits, being a left adjoint. -/
private instance preservesColimitsOfShape_etaleAbelianInverseImage {X Y : Scheme.{u}} (i : Y ⟶ X)
    (J : Type*) [Category* J] : PreservesColimitsOfShape J (etaleAbelianInverseImage.{u, v} i) :=
  (etaleAbelianInverseImageDirectImageAdj.{u, v} i).leftAdjoint_preservesColimits
    |>.preservesColimitsOfShape

variable {X : Scheme.{u}} [CompactSpace X] [QuasiSeparatedSpace X]
  [HasExt.{max (u + 1) v} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
  {I : Type (max (u + 1) v)} [SmallCategory I] [IsFiltered I]
  {D : I ⥤ Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v}} {c : Cocone D}
  (hc : IsColimit c)

include hc

/-- **Vanishing passes to filtered colimits**, at the coefficients
`AddCommGrpCat.{max (u + 1) v}`. -/
theorem subsingleton_sheafH_of_isColimit_max (q : ℕ)
    (h : ∀ j, Subsingleton (Sheaf.H.{max (u + 1) v} (D.obj j) q)) :
    Subsingleton (Sheaf.H.{max (u + 1) v} c.pt q) := by
  have := preservesColimitsOfShape_functorH_smallEtale_max X q I
  have hF := isColimitOfPreserves (smallEtaleFunctorHMax.{v} X q) hc
  change Subsingleton ((smallEtaleFunctorHMax.{v} X q).obj c.pt)
  refine AddCommGrpCat.isZero_iff_subsingleton.1 ((IsZero.iff_id_eq_zero _).2 ?_)
  refine hF.hom_ext fun j ↦ ?_
  exact (AddCommGrpCat.isZero_iff_subsingleton.2 (h j)).eq_of_src _ _

/-- **Bijectivity of restriction passes to filtered colimits**, at the coefficients
`AddCommGrpCat.{max (u + 1) v}`. -/
theorem bijective_etaleCohomologyRestrictionMap_of_isColimit_max {Y : Scheme.{u}}
    [CompactSpace Y] [QuasiSeparatedSpace Y]
    [HasExt.{max (u + 1) v} (Sheaf Y.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
    (i : Y ⟶ X) (q : ℕ)
    (h : ∀ j, Function.Bijective
      (etaleCohomologyRestrictionMap.{u, v, max (u + 1) v} i (D.obj j) q)) :
    Function.Bijective (etaleCohomologyRestrictionMap.{u, v, max (u + 1) v} i c.pt q) := by
  have := preservesColimitsOfShape_functorH_smallEtale_max X q I
  have := preservesColimitsOfShape_functorH_smallEtale_max Y q I
  have : IsIso (Functor.whiskerLeft D (etaleCohomologyRestrictionNatTransMax i q)) := by
    rw [NatTrans.isIso_iff_isIso_app]
    exact fun j ↦ (ConcreteCategory.isIso_iff_bijective _).2 (h j)
  exact (ConcreteCategory.isIso_iff_bijective _).1
    (isIso_app_coconePt_of_preservesColimit D (etaleCohomologyRestrictionNatTransMax i q) c hc)

omit [CompactSpace X] [QuasiSeparatedSpace X] in
/-- **Surjectivity of restriction passes to filtered colimits**, at the coefficients
`AddCommGrpCat.{max (u + 1) v}`. -/
theorem surjective_etaleCohomologyRestrictionMap_of_isColimit_max {Y : Scheme.{u}}
    [CompactSpace Y] [QuasiSeparatedSpace Y]
    [HasExt.{max (u + 1) v} (Sheaf Y.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
    (i : Y ⟶ X) (q : ℕ)
    (h : ∀ j, Function.Surjective
      (etaleCohomologyRestrictionMap.{u, v, max (u + 1) v} i (D.obj j) q)) :
    Function.Surjective (etaleCohomologyRestrictionMap.{u, v, max (u + 1) v} i c.pt q) := by
  have := preservesColimitsOfShape_functorH_smallEtale_max Y q I
  let α := etaleCohomologyRestrictionNatTransMax i q
  let G := etaleAbelianInverseImage.{u, v} i ⋙ smallEtaleFunctorHMax.{v} Y q
  have hG := isColimitOfPreserves G hc
  have hepi : ∀ j, Epi (α.app (D.obj j)) := fun j ↦ (AddCommGrpCat.epi_iff_surjective _).2 (h j)
  refine (AddCommGrpCat.epi_iff_surjective (α.app c.pt)).1 ⟨fun {Z} u v huv ↦ ?_⟩
  refine hG.hom_ext fun j ↦ ?_
  rw [← cancel_epi (α.app (D.obj j))]
  change α.app (D.obj j) ≫ G.map (c.ι.app j) ≫ u = α.app (D.obj j) ≫ G.map (c.ι.app j) ≫ v
  rw [← Category.assoc, ← α.naturality, Category.assoc,
    show α.app (((Functor.const I).obj c.pt).obj j) = α.app c.pt from rfl, huv,
    ← Category.assoc]
  exact congrArg (· ≫ v) (α.naturality (c.ι.app j))

end Colimit

/-- Vanishing of sheaf cohomology does not depend on the `Ext` universe; the two `Ext` instances
are explicit arguments. -/
theorem subsingleton_sheafH_chgUniv {X : Scheme.{u}}
    {F : Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v}}
    (h₁ : HasExt.{w} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v}))
    (h₂ : HasExt.{w'} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})) (q : ℕ)
    (h : Subsingleton (Sheaf.H.{w} F q)) : Subsingleton (Sheaf.H.{w'} F q) :=
  (Abelian.Ext.chgUniv.{w} : Sheaf.H.{w'} F q ≃ Sheaf.H.{w} F q).subsingleton

section Pieces

variable {X : Scheme.{u}} {F' : Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v}}
  {G : Sheaf X.smallEtaleTopology AddCommGrpCat.{u + 1}} (e : (etaleUlift.{v} X).obj G ≅ F')
  [HasExt.{w} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]

include e

/-- Vanishing passes from `G` to a sheaf isomorphic to its universe lift. -/
theorem subsingleton_sheafH_of_etaleUlift_iso (q : ℕ) (h : Subsingleton (Sheaf.H.{u + 1} G q)) :
    Subsingleton (Sheaf.H.{w} F' q) :=
  (subsingleton_sheafH_congr e q).1 ((subsingleton_sheafH_etaleUlift_iff G q).2 h)

/-- Finiteness passes from `G` to a sheaf isomorphic to its universe lift. -/
theorem finite_sheafH_of_etaleUlift_iso (q : ℕ) (h : Finite (Sheaf.H.{u + 1} G q)) :
    Finite (Sheaf.H.{w} F' q) :=
  have := (finite_sheafH_etaleUlift_iff.{w} G q).2 h
  Finite.of_equiv _ (sheafHIsoCongr e q).toEquiv

/-- Bijectivity of restriction passes from `G` to a sheaf isomorphic to its universe lift. -/
theorem bijective_etaleCohomologyRestrictionMap_of_etaleUlift_iso {Y : Scheme.{u}} (i : Y ⟶ X)
    [HasExt.{w} (Sheaf Y.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})] (q : ℕ)
    (h : Function.Bijective (etaleCohomologyRestrictionMap.{u, 0, u + 1} i G q)) :
    Function.Bijective (etaleCohomologyRestrictionMap.{u, v, w} i F' q) :=
  (etaleCohomologyRestrictionMap_iso_iff i e q).1.1
    ((etaleCohomologyRestrictionMap_ulift_iff i G q).1.2 h)

/-- Surjectivity of restriction passes from `G` to a sheaf isomorphic to its universe lift. -/
theorem surjective_etaleCohomologyRestrictionMap_of_etaleUlift_iso {Y : Scheme.{u}} (i : Y ⟶ X)
    [HasExt.{w} (Sheaf Y.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})] (q : ℕ)
    (h : Function.Surjective (etaleCohomologyRestrictionMap.{u, 0, u + 1} i G q)) :
    Function.Surjective (etaleCohomologyRestrictionMap.{u, v, w} i F' q) :=
  (etaleCohomologyRestrictionMap_iso_iff i e q).2.1
    ((etaleCohomologyRestrictionMap_ulift_iff i G q).2.2 h)

end Pieces

/-- **The reduction theorem for Theorem 03SC at every coefficient universe, statements (1), (2),
(3), (6), (7), (8).** In Situation 0A52, granted Lemma 0A5B for `Z/ℓ` on smooth curves for every
prime `ℓ` (at the coefficients `AddCommGrpCat.{u + 1}`), the six statements of the list which do
not assume constructibility hold for every torsion abelian sheaf at the coefficients
`AddCommGrpCat.{max (u + 1) v}`, with `Ext` in any universe. -/
theorem curveStatements_partial_of_torsionSheafProperty {k : Type u} [Field k] [IsAlgClosed k]
    {X : Scheme.{u}} (π : X ⟶ Spec (.of k)) [IsSeparated π] [LocallyOfFiniteType π]
    [QuasiCompact π] (hdim : topologicalKrullDim X ≤ 1)
    (hbase : ∀ ℓ : ℕ, ℓ.Prime →
      CurveStatementsConstantOnSmoothCurves k (AddCommGrpCat.of (ULift.{u + 1} (ZMod ℓ))))
    (F : Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})
    (hF : Stacks.Torsion.torsionSheafProperty X.smallEtaleTopology F)
    [HasExt.{w} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})] :
    IsVanishingAboveDegreeTwo.{u, v, w} F ∧ IsAffineVanishingAboveDegreeOne.{u, v, w} F ∧
      (∀ (p : ℕ) [CharP k p], IsPrimePowerTorsionVanishing.{u, v, w} k p F) ∧
      (Stacks.Torsion.IsPrimeToCharacteristicTorsion X.smallEtaleTopology (ringExpChar k) F →
        ∀ (k' : Type u) [Field k'] [Algebra k k'] [IsAlgClosed k']
          [HasExt.{w} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
          [HasExt.{w} (Sheaf (scalarExtension k k' π).smallEtaleTopology
            AddCommGrpCat.{max (u + 1) v})] (q : ℕ),
          Function.Bijective (etaleCohomologyRestrictionMap.{u, v, w}
            (scalarExtensionFst k k' π) F q)) ∧
      (IsProper π →
        ∀ (k' : Type u) [Field k'] [Algebra k k'] [IsAlgClosed k']
          [HasExt.{w} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})]
          [HasExt.{w} (Sheaf (scalarExtension k k' π).smallEtaleTopology
            AddCommGrpCat.{max (u + 1) v})] (q : ℕ),
          Function.Bijective (etaleCohomologyRestrictionMap.{u, v, w}
            (scalarExtensionFst k k' π) F q)) ∧
      IsDegreeTwoOpenRestrictionSurjective.{u, v, w} F := by
  have hw := ‹HasExt.{w} (Sheaf X.smallEtaleTopology AddCommGrpCat.{max (u + 1) v})›
  let hmax : ∀ S : Scheme.{u},
      HasExt.{max (u + 1) v} (Sheaf S.smallEtaleTopology AddCommGrpCat.{max (u + 1) v}) :=
    fun _ ↦ IsGrothendieckAbelian.hasExt _
  have : IsLocallyNoetherian X := LocallyOfFiniteType.isLocallyNoetherian π
  have : CompactSpace X := QuasiCompact.compactSpace_of_compactSpace π
  have : IsNoetherian X := ⟨⟩
  obtain ⟨I, _, _, D, ι, ⟨hc⟩, hD⟩ := exists_isColimit_etaleUlift_mono F
  choose G hG using fun j ↦ (hD j).2
  have he : ∀ j, (etaleUlift.{v} X).obj (G j) ≅ D.obj j := fun j ↦ (hG j).some
  have hmono : ∀ j, Mono (ι.app j) := fun j ↦ (hD j).1
  have hGs : ∀ j, CurveStatements.{u, 0, u + 1} π (G j) := fun j ↦
    curveStatements_of_torsionSheafProperty π hdim hbase (G j) (torsionSheafProperty_of_etaleUlift
      ((Stacks.Torsion.torsionSheafProperty _).prop_of_mono ((he j).hom ≫ ι.app j) hF))
  have hscalar : ∀ (k' : Type u) [Field k'] [Algebra k k'],
      CompactSpace (scalarExtension k k' π) ∧ QuasiSeparatedSpace (scalarExtension k k' π) :=
    fun k' _ _ ↦ ⟨QuasiCompact.compactSpace_of_compactSpace
      (pullback.snd π (Spec.map (CommRingCat.ofHom (algebraMap k k')))),
      quasiSeparatedSpace_of_quasiSeparated
        (pullback.snd π (Spec.map (CommRingCat.ofHom (algebraMap k k'))))⟩
  have hbij : ∀ (k' : Type u) [Field k'] [Algebra k k'] (q : ℕ),
      (∀ j, Function.Bijective (etaleCohomologyRestrictionMap.{u, 0, u + 1}
        (scalarExtensionFst k k' π) (G j) q)) →
      Function.Bijective (etaleCohomologyRestrictionMap.{u, v, max (u + 1) v}
        (scalarExtensionFst k k' π) F q) := fun k' _ _ q h ↦ by
    obtain ⟨_, _⟩ := hscalar k'
    exact bijective_etaleCohomologyRestrictionMap_of_isColimit_max hc _ q
      fun j ↦ bijective_etaleCohomologyRestrictionMap_of_etaleUlift_iso (he j) _ q (h j)
  have h8 : ∀ U : X.Opens, Function.Surjective
      (etaleCohomologyRestrictionMap.{u, v, max (u + 1) v} U.ι F 2) := fun U ↦ by
    have : CompactSpace U := isCompact_iff_compactSpace.1
      (TopologicalSpace.NoetherianSpace.isCompact (U : Set X))
    have : QuasiSeparatedSpace U := quasiSeparatedSpace_of_quasiSeparated U.ι
    exact surjective_etaleCohomologyRestrictionMap_of_isColimit_max hc U.ι 2
      (fun j ↦ surjective_etaleCohomologyRestrictionMap_of_etaleUlift_iso (he j) U.ι 2
        ((hGs j).surjective U))
  have hvan : ∀ q, (∀ j, Subsingleton (Sheaf.H.{u + 1} (G j) q)) →
      Subsingleton (Sheaf.H.{w} F q) := fun q h ↦
    subsingleton_sheafH_chgUniv.{max (u + 1) v, w, v, u} (hmax X) hw q
      (subsingleton_sheafH_of_isColimit_max hc q
        fun j ↦ subsingleton_sheafH_of_etaleUlift_iso (he j) q (h j))
  refine ⟨fun q hq ↦ hvan q fun j ↦ (hGs j).vanishing q hq,
    fun hX q hq ↦ hvan q fun j ↦ (hGs j).affineVanishing hX q hq,
    fun p _ hp htors q hq ↦ hvan q fun j ↦ (hGs j).primePowerVanishing p hp
      (isPrimePowerTorsion_of_etaleUlift
        (isPrimePowerTorsion_of_mono ((he j).hom ≫ ι.app j) htors)) q hq,
    fun htors k' _ _ _ _ _ q ↦ ?_, fun hπ k' _ _ _ _ _ q ↦ ?_, fun U _ ↦ ?_⟩
  · exact @bijective_etaleCohomologyRestrictionMap_chgUniv.{max (u + 1) v, w, u, v} _ _ _
      (hmax _) (hmax _) _ _ F q (hbij k' q fun j ↦
        (hGs j).bijective_of_isPrimeToCharacteristicTorsion
          (isPrimeToCharacteristicTorsion_of_etaleUlift
            (isPrimeToCharacteristicTorsion_of_mono ((he j).hom ≫ ι.app j) htors)) k' q)
  · exact @bijective_etaleCohomologyRestrictionMap_chgUniv.{max (u + 1) v, w, u, v} _ _ _
      (hmax _) (hmax _) _ _ F q (hbij k' q fun j ↦ (hGs j).bijective_of_isProper hπ k' q)
  · exact @surjective_etaleCohomologyRestrictionMap_chgUniv.{max (u + 1) v, w, u, v} _ _ _
      (hmax _) (hmax _) _ _ F 2 (h8 U)

