module

public import StacksFrontier.AlgebraicGeometry.Chow.RationalFunctions.Etale
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.TorsionSheavesCurves.ScalarExtensionClosedPoints
public import StacksFrontier.AlgebraicGeometry.Perfect.BaseChangeStalk
public import StacksFrontier.RingTheory.LocalRing.MaximalIdealTensorLocalization

/-!
# Orders of vanishing under extension of an algebraically closed base field

Let `X` be a scheme locally of finite type over an algebraically closed field `k`, `k'/k` a field
extension and `p : X_{k'} ⟶ X` the projection. At the point `x'` of `X_{k'}` over a closed point
`x` of `X`, the maximal ideal of `𝒪_{X,x}` generates the maximal ideal of `𝒪_{X_{k'},x'}`: the
residue field of `x` is `k`, so this is the general statement on local rings of fibre products
(`AlgebraicGeometry.maximalIdeal_stalk_pullback_eq_sup`) with the second factor a field. The same
holds over every point of `U ×_X X_{k'}` lying over a closed point of an étale `X`-scheme `U`.

Along a flat morphism whose stalk map at a point carries the maximal ideal onto the maximal ideal,
the order of vanishing of a rational function is unchanged
(`Stacks.Chow.ord_dominantFunctionFieldMap_of_flat`); at a point lying over the generic point it
is zero (`Stacks.Chow.ord_dominantFunctionFieldMap_eq_zero_of_maximalIdeal_eq_bot`). These are the
two pointwise inputs to the compatibility of the divisor sequence of a smooth curve with extension
of the base field.

## Main results

* `AlgebraicGeometry.maximalIdeal_stalk_pullback_eq_sup`: `𝔪_{x'} = 𝔪_x 𝒪_{x'} + 𝔪_y 𝒪_{x'}` at a
  point of `X ×_S Y` over a point of `X` whose residue field comes from `S`.
* `Stacks.EtaleCohomology.map_maximalIdeal_stalk_scalarExtension`: `𝔪_x 𝒪_{X_{k'},x'} = 𝔪_{x'}`.
* `Stacks.EtaleCohomology.map_maximalIdeal_stalk_pullback_scalarExtension`: the same at the points
  of `U ×_X X_{k'}` over closed points of `U`, for `U` étale over `X`.
* `Stacks.Chow.ord_dominantFunctionFieldMap_of_flat`: invariance of the order of vanishing.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Order IsLocalRing AlgebraicGeometry

universe u

namespace AlgebraicGeometry

/-- **The maximal ideal of a local ring of a fibre product is generated by those of the
factors**, at a point `z` of `X ×_S Y` whose image in `X` has every residue class coming from the
local ring of `S`. -/
theorem maximalIdeal_stalk_pullback_eq_sup {X S Y : Scheme.{u}} (f : X ⟶ S) (g : Y ⟶ S)
    (z : ↥(pullback f g))
    (hres : Function.Surjective ((residue (X.presheaf.stalk ((pullback.fst f g).base z))).comp
      (f.stalkMap ((pullback.fst f g).base z)).hom)) :
    maximalIdeal ((pullback f g).presheaf.stalk z) =
      (maximalIdeal (X.presheaf.stalk ((pullback.fst f g).base z))).map
          ((pullback.fst f g).stalkMap z).hom ⊔
        (maximalIdeal (Y.presheaf.stalk ((pullback.snd f g).base z))).map
          ((pullback.snd f g).stalkMap z).hom := by
  let hxy : (pullback.fst f g ≫ f).base z = (pullback.snd f g ≫ g).base z :=
    congrArg (fun k : pullback f g ⟶ S => k.base z) pullback.condition
  let R := S.presheaf.stalk ((pullback.fst f g ≫ f).base z)
  let A := X.presheaf.stalk ((pullback.fst f g).base z)
  let B := Y.presheaf.stalk ((pullback.snd f g).base z)
  let C := (pullback f g).presheaf.stalk z
  let _ : Algebra R A := (f.stalkMap ((pullback.fst f g).base z)).hom.toAlgebra
  let _ : Algebra R B :=
    ((eqToHom (congrArg S.presheaf.stalk hxy)) ≫ g.stalkMap _).hom.toAlgebra
  obtain ⟨φ, h1, h2, M, hM⟩ := BaseChangeStalk.pullback_stalk_isLocalization f g z
  let _ : Algebra (TensorProduct R A B) C := φ.toAlgebra
  have _ : IsLocalization M C := hM
  have hL : IsLocalHom ((algebraMap (TensorProduct R A B) C).comp
      Algebra.TensorProduct.includeLeftRingHom) := by
    show IsLocalHom (φ.comp _)
    rw [h1]
    infer_instance
  have hR : IsLocalHom ((algebraMap (TensorProduct R A B) C).comp
      (Algebra.TensorProduct.includeRight (R := R) (A := A) (B := B)).toRingHom) := by
    show IsLocalHom (φ.comp _)
    rw [h2]
    infer_instance
  have key := Stacks.maximalIdeal_eq_map_sup_map_of_isLocalization_tensorProduct
    (C := C) hres M
  change _ = Ideal.map (φ.comp _) _ ⊔ Ideal.map (φ.comp _) _ at key
  rw [h1, h2] at key
  exact key

end AlgebraicGeometry

namespace Stacks.Chow

/-- **The order of vanishing is unchanged along a flat morphism which carries the maximal ideal
onto the maximal ideal**, at a point `z` of codimension equal to that of its image. The colength
of a principal ideal multiplies under the flat local stalk map by the colength of the extended
maximal ideal, which is one. -/
theorem ord_dominantFunctionFieldMap_of_flat {U V : Scheme.{u}} (f : U ⟶ V) [Flat f]
    [IsIntegral U] [IsIntegral V] [IsLocallyNoetherian U] [IsLocallyNoetherian V]
    [IsDominant f] (z : U)
    (hmax : (maximalIdeal (V.presheaf.stalk (f.base z))).map (f.stalkMap z).hom =
      maximalIdeal (U.presheaf.stalk z))
    (hcoh : coheight (f.base z) = coheight z) (g : V.functionField) :
    U.ord (dominantFunctionFieldMap f g) z = V.ord g (f.base z) := by
  have hlen : ∀ a : V.presheaf.stalk (f.base z),
      Module.length (U.presheaf.stalk z)
          (U.presheaf.stalk z ⧸ Ideal.span {(f.stalkMap z).hom a}) =
        Module.length (V.presheaf.stalk (f.base z))
          (V.presheaf.stalk (f.base z) ⧸ Ideal.span {a}) := by
    intro a
    algebraize [(f.stalkMap z).hom]
    have hloc : IsLocalHom
        (algebraMap (V.presheaf.stalk (f.base z)) (U.presheaf.stalk z)) :=
      inferInstanceAs (IsLocalHom (f.stalkMap z).hom)
    have hflat : Module.Flat (V.presheaf.stalk (f.base z)) (U.presheaf.stalk z) :=
      RingHom.flat_algebraMap_iff.mp (Flat.stalkMap f z)
    have hone : Module.length (U.presheaf.stalk z)
        (U.presheaf.stalk z ⧸
          extendedMaximalIdeal (V.presheaf.stalk (f.base z)) (U.presheaf.stalk z)) = 1 := by
      rw [show extendedMaximalIdeal (V.presheaf.stalk (f.base z)) (U.presheaf.stalk z) =
        maximalIdeal (U.presheaf.stalk z) from hmax]
      exact Module.length_eq_one_iff.mpr (isSimpleModule_iff_quot_maximal.mpr
        ⟨maximalIdeal (U.presheaf.stalk z), maximalIdeal.isMaximal (U.presheaf.stalk z),
          ⟨LinearEquiv.refl _ _⟩⟩)
    have hcoe : (f.stalkMap z).hom a =
        algebraMap (V.presheaf.stalk (f.base z)) (U.presheaf.stalk z) a := rfl
    rw [hcoe, AlgebraicGeometry.length_quotient_span_algebraMap a, hone, mul_one]
  by_cases hz : coheight z = 1
  · by_cases hg : g = 0
    · subst hg
      rw [map_zero]
      simp
    have hzV : coheight (f.base z) = 1 := hcoh.trans hz
    obtain ⟨a, b, ha, hb, hrep⟩ := exists_div_algebraMap_stalk_eq (f.base z) hg
    rw [← hrep, ord_dominantFunctionFieldMap_eq_length_sub f hz ha hb,
      ord_div_algebraMap_eq_length_sub hzV ha hb, hlen a, hlen b]
  · rw [Scheme.ord_eq_zero_of_coheight_neq_one hz,
      Scheme.ord_eq_zero_of_coheight_neq_one (fun h ↦ hz (hcoh.symm.trans h))]

/-- **A rational function pulled back along a dominant morphism has order zero at every point
whose image has a field as local ring** (the generic point): the function is a quotient of two
nonzero elements of that field, whose images are units. -/
theorem ord_dominantFunctionFieldMap_eq_zero_of_maximalIdeal_eq_bot {U V : Scheme.{u}}
    (f : U ⟶ V) [IsIntegral U] [IsIntegral V] [IsLocallyNoetherian U] [IsDominant f] (z : U)
    (hz : maximalIdeal (V.presheaf.stalk (f.base z)) = ⊥) (g : V.functionField) :
    U.ord (dominantFunctionFieldMap f g) z = 0 := by
  by_cases hz1 : coheight z = 1
  · by_cases hg : g = 0
    · subst hg
      rw [map_zero]
      simp
    obtain ⟨a, b, ha, hb, hrep⟩ := exists_div_algebraMap_stalk_eq (f.base z) hg
    have hunit : ∀ c : V.presheaf.stalk (f.base z), c ≠ 0 → IsUnit c := fun c hc =>
      IsLocalRing.notMem_maximalIdeal.mp (by rw [hz]; exact hc)
    have hzero : ∀ c : V.presheaf.stalk (f.base z), c ≠ 0 →
        Module.length (U.presheaf.stalk z)
          (U.presheaf.stalk z ⧸ Ideal.span {(f.stalkMap z).hom c}) = 0 := by
      intro c hc
      rw [Ideal.span_singleton_eq_top.mpr ((hunit c hc).map (f.stalkMap z).hom)]
      exact Module.length_eq_zero
    rw [← hrep, ord_dominantFunctionFieldMap_eq_length_sub f hz1 ha hb, hzero a ha, hzero b hb]
    rfl
  · exact Scheme.ord_eq_zero_of_coheight_neq_one hz1 _

end Stacks.Chow

namespace Stacks.EtaleCohomology

variable {k : Type u} [Field k] [IsAlgClosed k] {X : Scheme.{u}} (g : X ⟶ Spec (.of k))
  [LocallyOfFiniteType g] (k' : Type u) [Field k'] [Algebra k k']

/-- The local ring of the spectrum of a field has zero maximal ideal. -/
theorem maximalIdeal_stalk_spec_field_eq_bot (K : Type u) [Field K] (y : Spec (.of K)) :
    maximalIdeal ((Spec (.of K)).presheaf.stalk y) = ⊥ := by
  have _ : y.asIdeal.IsPrime := y.2
  let _ : Algebra K ((Spec (.of K)).presheaf.stalk y) := StructureSheaf.stalkAlgebra K y
  have _ : IsLocalization.AtPrime ((Spec (.of K)).presheaf.stalk y) y.asIdeal :=
    StructureSheaf.IsLocalization.to_stalk K y
  have hy : y.asIdeal = ⊥ := Ideal.eq_bot_of_prime y.asIdeal
  rw [← IsLocalization.AtPrime.map_eq_maximalIdeal y.asIdeal, hy, Ideal.map_bot]

/-- Surjectivity on residue fields gives surjectivity of the stalk map followed by the residue. -/
private theorem surjective_residue_comp_stalkMap {X Y : Scheme.{u}} (g : X ⟶ Y) (x : X)
    (h : Function.Surjective (g.residueFieldMap x)) :
    Function.Surjective ((residue (X.presheaf.stalk x)).comp (g.stalkMap x).hom) := by
  have hsq := congrArg CommRingCat.Hom.hom (Scheme.residue_residueFieldMap g x)
  show Function.Surjective ((Scheme.Hom.stalkMap g _ ≫ X.residue _).hom)
  rw [← hsq, CommRingCat.hom_comp, RingHom.coe_comp]
  exact h.comp residue_surjective

/-- **At the point of `X_{k'}` over a closed point `x` of `X`, the maximal ideal of `𝒪_{X,x}`
generates the maximal ideal**: the residue field of `x` is `k` and the second factor `k'` is a
field. -/
theorem map_maximalIdeal_stalk_scalarExtension (z : scalarExtension k k' g)
    (hz : IsClosed ({(scalarExtensionFst k k' g).base z} : Set X)) :
    (maximalIdeal (X.presheaf.stalk ((scalarExtensionFst k k' g).base z))).map
        ((scalarExtensionFst k k' g).stalkMap z).hom =
      maximalIdeal ((scalarExtension k k' g).presheaf.stalk z) := by
  have hiso := isIso_residueFieldMap_of_isClosed g hz
  have hres := surjective_residue_comp_stalkMap g _
    (ConcreteCategory.bijective_of_isIso
      (g.residueFieldMap ((scalarExtensionFst k k' g).base z))).2
  rw [maximalIdeal_stalk_pullback_eq_sup g _ z hres, maximalIdeal_stalk_spec_field_eq_bot,
    Ideal.map_bot, sup_bot_eq]

/-- An isomorphism of local rings carries the maximal ideal onto the maximal ideal. -/
theorem map_maximalIdeal_of_isIso {A B : CommRingCat.{u}} [IsLocalRing A] [IsLocalRing B]
    (e : A ⟶ B) [IsIso e] : (maximalIdeal A).map e.hom = maximalIdeal B := by
  refine le_antisymm (map_maximalIdeal_le e.hom) fun b hb => ?_
  have hb' : e.hom ((inv e).hom b) = b := by
    rw [← CommRingCat.comp_apply, IsIso.inv_hom_id, CommRingCat.id_apply]
  have h : (inv e).hom b ∈ maximalIdeal A := fun hu => hb (hb' ▸ hu.map e.hom)
  exact hb' ▸ Ideal.mem_map_of_mem e.hom h

/-- The maximal ideal of a stalk, carried along a morphism, depends only on the morphism. -/
theorem map_maximalIdeal_stalkMap_congr {U V : Scheme.{u}} {f f' : U ⟶ V} (hff' : f = f')
    (z : U) :
    (maximalIdeal (V.presheaf.stalk (f.base z))).map (f.stalkMap z).hom =
      (maximalIdeal (V.presheaf.stalk (f'.base z))).map (f'.stalkMap z).hom := by
  subst hff'
  rfl

/-- **At the points of `U ×_X X_{k'}` over a point `w` of `U` with closed image in `X` and
residue field that of its image, the maximal ideal of `𝒪_{U,w}` generates the maximal ideal**:
the two maximal ideals generating it are those of `𝒪_{U,w}` and of `𝒪_{X_{k'},x'}`, and the
second is generated by that of `𝒪_{X,x}` (`map_maximalIdeal_stalk_scalarExtension`), which lands
in the first. -/
theorem map_maximalIdeal_stalk_pullback_scalarExtensionFst {U : Scheme.{u}} (q : U ⟶ X)
    (w : ↥(pullback q (scalarExtensionFst k k' g)))
    (hx : IsClosed ({q.base ((pullback.fst q (scalarExtensionFst k k' g)).base w)} : Set X))
    (hres : Function.Surjective
      (q.residueFieldMap ((pullback.fst q (scalarExtensionFst k k' g)).base w))) :
    (maximalIdeal (U.presheaf.stalk ((pullback.fst q (scalarExtensionFst k k' g)).base w))).map
        ((pullback.fst q (scalarExtensionFst k k' g)).stalkMap w).hom =
      maximalIdeal ((pullback q (scalarExtensionFst k k' g)).presheaf.stalk w) := by
  have hres' := surjective_residue_comp_stalkMap q _ hres
  have hxb : IsClosed ({(scalarExtensionFst k k' g).base
                          ((pullback.snd q (scalarExtensionFst k k' g)).base w)} : Set X) := by
    have : (scalarExtensionFst k k' g).base ((pullback.snd q (scalarExtensionFst k k' g)).base w) =
        q.base ((pullback.fst q (scalarExtensionFst k k' g)).base w) :=
      congrArg (fun φ : pullback q (scalarExtensionFst k k' g) ⟶ X => φ.base w)
        pullback.condition.symm
    rw [this]
    exact hx
  have h1 := map_maximalIdeal_stalk_scalarExtension g k'
    ((pullback.snd q (scalarExtensionFst k k' g)).base w) hxb
  have h2 : (maximalIdeal ((scalarExtension k k' g).presheaf.stalk
      ((pullback.snd q (scalarExtensionFst k k' g)).base w))).map
      ((pullback.snd q (scalarExtensionFst k k' g)).stalkMap w).hom ≤
      (maximalIdeal (U.presheaf.stalk ((pullback.fst q (scalarExtensionFst k k' g)).base w))).map
        ((pullback.fst q (scalarExtensionFst k k' g)).stalkMap w).hom := by
    have e1 : (maximalIdeal ((scalarExtension k k' g).presheaf.stalk
          ((pullback.snd q (scalarExtensionFst k k' g)).base w))).map
          ((pullback.snd q (scalarExtensionFst k k' g)).stalkMap w).hom =
        (maximalIdeal (X.presheaf.stalk
          ((pullback.snd q (scalarExtensionFst k k' g) ≫ (scalarExtensionFst k k' g)).base w))).map
          ((pullback.snd q (scalarExtensionFst k k' g) ≫ (scalarExtensionFst k k' g)).stalkMap
            w).hom := by
      rw [← h1, Ideal.map_map, ← CommRingCat.hom_comp, ← Scheme.Hom.stalkMap_comp]
      rfl
    have e2 := map_maximalIdeal_stalkMap_congr
      (pullback.condition (f := q) (g := (scalarExtensionFst k k' g))).symm w
    have e3 : (maximalIdeal (X.presheaf.stalk
          ((pullback.fst q (scalarExtensionFst k k' g) ≫ q).base w))).map
          ((pullback.fst q (scalarExtensionFst k k' g) ≫ q).stalkMap w).hom ≤
        (maximalIdeal (U.presheaf.stalk ((pullback.fst q (scalarExtensionFst k k' g)).base w))).map
          ((pullback.fst q (scalarExtensionFst k k' g)).stalkMap w).hom := by
      rw [Scheme.Hom.stalkMap_comp]
      exact (Ideal.map_map (q.stalkMap _).hom _).symm.trans_le
        (Ideal.map_mono (map_maximalIdeal_le _))
    exact (e1.trans e2).trans_le e3
  rw [maximalIdeal_stalk_pullback_eq_sup q (scalarExtensionFst k k' g) w hres']
  exact (sup_eq_left.mpr h2).symm
