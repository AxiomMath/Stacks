module

public import StacksFrontier.AlgebraicGeometry.AmpleCurve.Basic
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Curves.ClosedPointClassGroupRestriction
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.TorsionSheavesCurves.KummerFiniteness
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.TorsionSheavesCurves.SmoothReduction
public import StacksFrontier.AlgebraicGeometry.Variety.Curve.RegularCompactification
public import StacksFrontier.AlgebraicGeometry.Variety.Smooth.Regular
public import StacksFrontier.GroupTheory.FiniteAbelian.QuotientDivisibility

/-!
# Case I of Stacks 0A5B: `H¹(X, 𝐆_m)` from the class group of the compactification

Let `X` be a smooth curve over an algebraically closed field `k`, `ℓ` invertible in `k`, and
`X ⊂ X̄` its smooth projective compactification (Tag 0H1F). Then
`H¹(X, 𝐆_m) = Cl(X) = Cl(X̄)/⟨points at infinity⟩`
(`Stacks.EtaleCohomology.sheafHOneMultiplicativeAddEquivClosedPointClassGroup`,
`Stacks.EtaleCohomology.ker_closedPointClassGroupRestriction`). Two properties of the class group
of a smooth projective curve `Y` over `k` — which are the divisibility and the finiteness of the
`ℓ`-torsion of `Pic⁰(Y)`, read on divisor classes — then give the three inputs on `H¹(X, 𝐆_m)` of
`Stacks.EtaleCohomology.curveStatements_constantSheaf_of_smoothCurve_of_multiplicative`:

* (A) the difference `[x] - [y]` of the classes of two closed points of `Y` is divisible by `ℓ`;
* (B) the `ℓ`-torsion of the class group of `Y` is finite.

From (A), `Cl(X̄)` is generated by point classes congruent modulo `ℓ`, so `Cl(X)` is `ℓ`-divisible
when a point at infinity exists, which is the case for affine `X` (a proper affine curve does not
exist), and `Cl(X)/ℓ` is always finite; from (B) and the finite generation of the kernel,
`Cl(X)[ℓ]` is finite.

## Main results

* `Stacks.EtaleCohomology.curveStatements_constantSheaf_of_smoothCurve_of_classGroup`: the bundle
  of Situation 0A52 for `𝐙/ℓ` on `X` from (A), (B) on the compactification of `X` and the
  scalar extension input for (6), (7). It is a reduction; nothing is registered.
* `Stacks.EtaleCohomology.curveStatementsConstantOnSmoothCurves_of_classGroup`: the same, in the
  form of the base case `CurveStatementsConstantOnSmoothCurves k E` of the dévissage of 03SC.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite TopologicalSpace AlgebraicGeometry

universe u

namespace Stacks.EtaleCohomology

attribute [local instance] isGrothendieckAbelian_sheaf_smallEtale_objectUniverse

/-! ### Point classes generate the class group -/

section Generation

variable (Y : Scheme.{u}) [IsIntegral Y] [IsLocallyNoetherian Y] [NoetherianSpace Y]

/-- **The classes of the closed points generate the class group.** -/
theorem closure_range_closedPointClassGroup_single :
    AddSubgroup.closure (Set.range fun y : closedPoints Y =>
      (QuotientAddGroup.mk (Finsupp.single y (1 : ℤ)) : closedPointClassGroup Y)) = ⊤ := by
  classical
  rw [eq_top_iff]
  rintro c -
  induction c using QuotientAddGroup.induction_on with
  | H d =>
    rw [← Finsupp.sum_single d, Finsupp.sum, QuotientAddGroup.mk_sum]
    refine AddSubgroup.sum_mem _ fun y _ => ?_
    rw [show Finsupp.single y (d y) = d y • Finsupp.single y (1 : ℤ) by
      rw [Finsupp.smul_single, smul_eq_mul, mul_one], QuotientAddGroup.mk_zsmul]
    exact AddSubgroup.zsmul_mem _ (AddSubgroup.subset_closure (Set.mem_range_self y)) _

end Generation

/-! ### The reduction -/

section Curve

variable {k : Type u} [Field k] [IsAlgClosed k] {X : Scheme.{u}} (g : X ⟶ Spec (.of k))
  [IsCurve k g] [Smooth g]

/-- Transport of `ℓ`-divisibility along an isomorphism. -/
theorem exists_nsmul_eq_of_addEquiv {M N : Type*} [AddCommGroup M] [AddCommGroup N]
    (e : M ≃+ N) {ℓ : ℕ} (h : ∀ c : N, ∃ d, ℓ • d = c) (c : M) : ∃ d, ℓ • d = c := by
  obtain ⟨d, hd⟩ := h (e c)
  exact ⟨e.symm d, by rw [← map_nsmul, hd, AddEquiv.symm_apply_apply]⟩

/-- Transport of finiteness of the `ℓ`-torsion along an isomorphism. -/
theorem finite_nsmul_torsion_of_addEquiv {M N : Type*} [AddCommGroup M] [AddCommGroup N]
    (e : M ≃+ N) {ℓ : ℕ} (h : Finite {c : N // ℓ • c = 0}) : Finite {c : M // ℓ • c = 0} :=
  Finite.of_injective (fun c =>
      (⟨e c.1, by rw [← map_nsmul, c.2, map_zero]⟩ : {c : N // ℓ • c = 0}))
    fun c c' hc => Subtype.ext (e.injective (congrArg Subtype.val hc))

/-- Transport of finiteness of the quotient by `ℓ` along an isomorphism. -/
theorem finite_quotient_nsmul_of_addEquiv {M N : Type*} [AddCommGroup M] [AddCommGroup N]
    (e : M ≃+ N) {ℓ : ℕ} (h : Finite (N ⧸ (nsmulAddMonoidHom ℓ : N →+ N).range)) :
    Finite (M ⧸ (nsmulAddMonoidHom ℓ : M →+ M).range) := by
  refine Finite.of_surjective (QuotientAddGroup.map (nsmulAddMonoidHom ℓ : N →+ N).range
    (nsmulAddMonoidHom ℓ : M →+ M).range e.symm.toAddMonoidHom ?_) ?_
  · rintro _ ⟨a, rfl⟩
    exact ⟨e.symm a, by simp⟩
  · intro x
    induction x using QuotientAddGroup.induction_on with
    | H m => exact ⟨QuotientAddGroup.mk (e m), by simp⟩

include g in
/-- **The class group of a smooth curve from that of its compactification.** For `ℓ ≠ 0`, if the
point classes of every smooth projective curve over `k` are congruent modulo `ℓ` and its class
group has finite `ℓ`-torsion, then `H¹(X, 𝐆_m)` is `ℓ`-divisible when `X` is affine, has finite
`ℓ`-torsion, and has finite quotient by `ℓ`. -/
theorem sheafH_one_multiplicativeSheaf_of_classGroup {ℓ : ℕ} (hℓ : ℓ ≠ 0)
    (hA : ∀ (Y : Scheme.{u}) (q : Y ⟶ Spec (.of k)) [IsCurve k q] [Smooth q] [IsProper q]
      (x y : closedPoints Y), ∃ b : curveClassGroup q,
        (QuotientAddGroup.mk (Finsupp.single x (1 : ℤ)) : curveClassGroup q) -
          QuotientAddGroup.mk (Finsupp.single y (1 : ℤ)) = ℓ • b)
    (hB : ∀ (Y : Scheme.{u}) (q : Y ⟶ Spec (.of k)) [IsCurve k q] [Smooth q] [IsProper q],
        Finite {c : curveClassGroup q // ℓ • c = 0}) :
    (IsAffine X → ∀ c : Sheaf.H.{u + 1} (Stacks.Kummer.multiplicativeSheaf.{u, u + 1} X) 1,
      ∃ d, ℓ • d = c) ∧
    Finite {c : Sheaf.H.{u + 1} (Stacks.Kummer.multiplicativeSheaf.{u, u + 1} X) 1 //
      ℓ • c = 0} ∧
    Finite (Sheaf.H.{u + 1} (Stacks.Kummer.multiplicativeSheaf.{u, u + 1} X) 1 ⧸
      (nsmulAddMonoidHom ℓ : Sheaf.H.{u + 1} (Stacks.Kummer.multiplicativeSheaf.{u, u + 1} X) 1 →+
        Sheaf.H.{u + 1} (Stacks.Kummer.multiplicativeSheaf.{u, u + 1} X) 1).range) := by
  obtain ⟨-, Y, q, j, hj, hjq, hcq, hproj, -, hsq, hfin, -⟩ :=
    exists_smooth_isProjectiveMorphism_compactification_of_perfectField k g
      (isRegular_of_smooth_over_field g)
  have _ : IsOpenImmersion j := hj
  have _ : IsCurve k q := hcq
  have _ : Smooth q := hsq
  have _ : IsProper q := isProper_of_isProjectiveMorphism q hproj
  obtain ⟨_, _, _, _⟩ :=
    isNormal_isLocallyNoetherian_noetherianSpace_quasiSeparatedSpace_of_isCurve g
  obtain ⟨_, _, _, _⟩ :=
    isNormal_isLocallyNoetherian_noetherianSpace_quasiSeparatedSpace_of_isCurve q
  let e := sheafHOneMultiplicativeAddEquivClosedPointClassGroup g
  let φ := closedPointClassGroupRestriction g q j
  have hφ : Function.Surjective φ := surjective_closedPointClassGroupRestriction g q j
  have hker := ker_closedPointClassGroupRestriction g q j
  have hK : φ.ker.FG := by
    rw [hker]
    have : Finite {y : closedPoints Y | y.1 ∉ Set.range j.base} :=
      (hfin.preimage Subtype.val_injective.injOn).to_subtype
    exact ⟨(Set.toFinite _).toFinset, by rw [Set.Finite.coe_toFinset]⟩
  let pt := fun y : closedPoints Y =>
    (QuotientAddGroup.mk (Finsupp.single y (1 : ℤ)) : closedPointClassGroup Y)
  have hgen := closure_range_closedPointClassGroup_single Y
  refine ⟨fun hX => exists_nsmul_eq_of_addEquiv e ?_,
    finite_nsmul_torsion_of_addEquiv e ?_, finite_quotient_nsmul_of_addEquiv e ?_⟩
  · obtain ⟨y, hy⟩ : ∃ y : closedPoints Y, y.1 ∉ Set.range j.base := by
      by_contra hne
      push Not at hne
      have hsurj : Function.Surjective j.base := by
        intro z
        by_cases hz : z = genericPoint Y
        · exact ⟨genericPoint X, by
            rw [hz]
            exact ((tfae_isDominant_of_isIntegral j).out 1 2).mp
              (isDominant_of_isOpenImmersion_of_isCurve g q j)⟩
        · exact hne ⟨z,
            Stacks.AlgebraicGeometry.AmpleDimensionOne.isClosed_singleton_of_ne_genericPoint
              Y (IsCurve.topologicalKrullDim_eq_one q) hz⟩
      have : IsIso j := (isIso_iff_isOpenImmersion_and_surjective j).2 ⟨hj, ⟨hsurj⟩⟩
      have : IsProper g := by
        rw [← hjq]
        infer_instance
      exact not_isAffine_of_isCurve k g hX
    exact AddMonoidHom.exists_nsmul_eq_of_surjective_of_forall_sub_mem φ hφ pt hgen
      (hA Y q) y (by
        rw [← AddMonoidHom.mem_ker, hker]
        exact AddSubgroup.subset_closure ⟨y, hy, rfl⟩)
  · exact AddMonoidHom.finite_nsmul_torsion_of_surjective_of_fg_ker φ hφ hK (hB Y q)
  · exact AddMonoidHom.finite_quotient_nsmul_range_of_surjective_of_forall_sub_mem φ hφ hℓ pt
      hgen (hA Y q)

include g in
/-- **The bundle of Situation 0A52 for `𝐙/ℓ𝐙` on a smooth curve, `ℓ ∈ k^*`, from the class groups
of smooth projective curves.** If the point classes of every smooth projective curve `Y` over `k`
are congruent modulo `ℓ` in its class group `(Y_0 →₀ 𝐙)/div(K^*)` and that class group has finite
`ℓ`-torsion — the `ℓ`-divisibility and the finiteness of the `ℓ`-torsion of `Pic⁰(Y)`, read on
divisor classes — then statements (1) – (5) and (8) hold for `𝐙/ℓ𝐙` on `X`, and (6), (7) hold
given the scalar extension input `h6`. It is a reduction; nothing is registered. -/
theorem curveStatements_constantSheaf_of_smoothCurve_of_classGroup
    {ℓ : ℕ} (hℓk : IsUnit (ℓ : k)) (E : AddCommGrpCat.{u + 1})
    (hE : Nonempty (E ≃+ ZMod ℓ))
    (hA : ∀ (Y : Scheme.{u}) (q : Y ⟶ Spec (.of k)) [IsCurve k q] [Smooth q] [IsProper q]
      (x y : closedPoints Y), ∃ b : curveClassGroup q,
        (QuotientAddGroup.mk (Finsupp.single x (1 : ℤ)) : curveClassGroup q) -
          QuotientAddGroup.mk (Finsupp.single y (1 : ℤ)) = ℓ • b)
    (hB : ∀ (Y : Scheme.{u}) (q : Y ⟶ Spec (.of k)) [IsCurve k q] [Smooth q] [IsProper q],
        Finite {c : curveClassGroup q // ℓ • c = 0})
    (h6 : ∀ (k' : Type u) [Field k'] [Algebra k k'] [IsAlgClosed k']
        [HasExt.{u + 1} (Sheaf X.smallEtaleTopology AddCommGrpCat.{u + 1})]
        [HasExt.{u + 1} (Sheaf (scalarExtension k k' g).smallEtaleTopology
          AddCommGrpCat.{u + 1})] (q : ℕ), 1 ≤ q →
        Function.Bijective (etaleCohomologyRestrictionMap.{u, 0, u + 1} (scalarExtensionFst k k' g)
          ((constantSheaf X.smallEtaleTopology AddCommGrpCat.{u + 1}).obj E) q)) :
    CurveStatements.{u, 0, u + 1} g
      ((constantSheaf X.smallEtaleTopology AddCommGrpCat.{u + 1}).obj E) := by
  have hℓ : ℓ ≠ 0 := ne_zero_of_isUnit_natCast g hℓk
  obtain ⟨hdiv, hfin1, hfin2⟩ := sheafH_one_multiplicativeSheaf_of_classGroup g hℓ hA hB
  exact curveStatements_constantSheaf_of_smoothCurve_of_multiplicative.{u, 0, u + 1} g hℓk E hE
    hdiv hfin1 hfin2 h6

variable (k) in
/-- **The base case of the dévissage of Theorem 03SC for `E ≅ 𝐙/ℓ𝐙`, `ℓ ∈ k^*`, from the class
groups of smooth projective curves**: `CurveStatementsConstantOnSmoothCurves k E` follows from
(A) congruence of point classes modulo `ℓ` and (B) finiteness of the `ℓ`-torsion in the class
group of every smooth projective curve over `k`, together with the scalar extension input for
statements (6), (7). It is a reduction; nothing is registered. -/
theorem curveStatementsConstantOnSmoothCurves_of_classGroup
    {ℓ : ℕ} (hℓk : IsUnit (ℓ : k)) (E : AddCommGrpCat.{u + 1})
    (hE : Nonempty (E ≃+ ZMod ℓ))
    (hA : ∀ (Y : Scheme.{u}) (q : Y ⟶ Spec (.of k)) [IsCurve k q] [Smooth q] [IsProper q]
      (x y : closedPoints Y), ∃ b : curveClassGroup q,
        (QuotientAddGroup.mk (Finsupp.single x (1 : ℤ)) : curveClassGroup q) -
          QuotientAddGroup.mk (Finsupp.single y (1 : ℤ)) = ℓ • b)
    (hB : ∀ (Y : Scheme.{u}) (q : Y ⟶ Spec (.of k)) [IsCurve k q] [Smooth q] [IsProper q],
        Finite {c : curveClassGroup q // ℓ • c = 0})
    (h6 : ∀ (C : Scheme.{u}) (g : C ⟶ Spec (.of k)) [IsCurve k g] [Smooth g]
        (k' : Type u) [Field k'] [Algebra k k'] [IsAlgClosed k']
        [HasExt.{u + 1} (Sheaf C.smallEtaleTopology AddCommGrpCat.{u + 1})]
        [HasExt.{u + 1} (Sheaf (scalarExtension k k' g).smallEtaleTopology
          AddCommGrpCat.{u + 1})] (q : ℕ), 1 ≤ q →
        Function.Bijective (etaleCohomologyRestrictionMap.{u, 0, u + 1} (scalarExtensionFst k k' g)
          ((constantSheaf C.smallEtaleTopology AddCommGrpCat.{u + 1}).obj E) q)) :
    CurveStatementsConstantOnSmoothCurves k E := fun C g _ _ =>
  curveStatements_constantSheaf_of_smoothCurve_of_classGroup g hℓk E hE hA hB (h6 C g)

end Curve

end Stacks.EtaleCohomology

end
