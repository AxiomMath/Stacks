module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.ConstantModuleSheafIrreducibleSections
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.ConstantModuleSheafSliceSections
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.ExamplesSheaves.ConstantSheafSections

/-!
# Sections of a constant sheaf of modules over a ring that need not be commutative

The site-level argument of
`StacksFrontier.AlgebraicGeometry.EtaleCohomology.ConstantModuleSheafIrreducibleSections` works for an
arbitrary coefficient ring `Λ`; it is carried out here for a ring that need not be commutative,
in one statement, and applied on Mathlib's small étale site: over an irreducible étale scheme
the sections of the constant sheaf of `Λ`-modules generated by `M` are `M`.

These declarations are obtained by generalizing the variable lines of the files named above;
they are new declarations, the base statements being left unchanged.

## Main results

* `Stacks.ConstantSheaf.existsUnique_toSheafify_const_app_of_forall_exists_refinement`.
* `AlgebraicGeometry.Scheme.bijective_toSheafify_const_app_of_irreducibleSpace`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe v u w r

namespace Stacks.ConstantSheaf

variable {C : Type u} [Category.{v} C] (J : GrothendieckTopology C) {Λ : Type w} [Ring Λ]

/-- **Every section of a constant sheaf of modules over a final object is a unique constant**,
for a coefficient ring that need not be commutative, provided the final object is not sheaf
theoretically empty and any two objects which are not sheaf theoretically empty have a common
refinement which is not either.

Two constants with the same image agree on a covering family, by local injectivity of
sheafification, so the canonical map is injective over any object which is not sheaf
theoretically empty.  Sheafification is locally surjective, so a section over the final object is
a constant on a covering family; two members of that family which are not sheaf theoretically
empty exhibit the same constant, by injectivity over a common refinement, and the sheaf condition
identifies the section with that constant.  This is the argument of
`Stacks.ConstantSheaf.bijective_toSheafify_const_app_of_forall_exists_refinement`. -/
theorem existsUnique_toSheafify_const_app_of_forall_exists_refinement
    (M : ModuleCat.{max u v w} Λ) {T : C} (hT : IsTerminal T) (hbot : (⊥ : Sieve T) ∉ J T)
    (href : ∀ Y Z : C, (⊥ : Sieve Y) ∉ J Y → (⊥ : Sieve Z) ∉ J Z →
      ∃ (Q : C) (_ : Q ⟶ Y) (_ : Q ⟶ Z), (⊥ : Sieve Q) ∉ J Q)
    (s : (sheafify J ((Functor.const Cᵒᵖ).obj M)).obj (op T)) :
    ∃! a : M, (toSheafify J ((Functor.const Cᵒᵖ).obj M)).app (op T) a = s := by
  classical
  have hinj : ∀ (X : C), (⊥ : Sieve X) ∉ J X →
      Function.Injective ((toSheafify J ((Functor.const Cᵒᵖ).obj M)).app (op X)) := by
    intro X hX x y hxy
    have hS := Presheaf.equalizerSieve_mem J (toSheafify J ((Functor.const Cᵒᵖ).obj M)) x y hxy
    by_contra hne
    exact hX (J.superset_covering (fun _ _ hg =>
      (hne (by simpa [Presheaf.equalizerSieve_apply] using hg)).elim) hS)
  have hsheaf : Presieve.IsSheaf J
      (sheafify J ((Functor.const Cᵒᵖ).obj M) ⋙ forget (ModuleCat.{max u v w} Λ)) := by
    have := preservesSheafification_forget_moduleCat.{v, u, w} J Λ
    exact (isSheaf_iff_isSheaf_of_type _ _).1
      (GrothendieckTopology.HasSheafCompose.isSheaf _
        ((presheafToSheaf J (ModuleCat.{max u v w} Λ)).obj
          ((Functor.const Cᵒᵖ).obj M)).property)
  have hall : ∀ {X : C} {S : Sieve X}, S ∈ J X →
      (∀ (Y : C) (g : Y ⟶ X), S g → (⊥ : Sieve Y) ∈ J Y) → (⊥ : Sieve X) ∈ J X := by
    intro X S hS h
    refine J.transitive hS ⊥ fun {Y} g hg => ?_
    have h0 : (⊥ : Sieve X).pullback g = ⊥ := le_antisymm (fun _ k hk => hk) bot_le
    rw [h0]
    exact h Y g hg
  refine existsUnique_of_exists_of_unique ?_ fun a b ha hb => hinj T hbot (ha.trans hb.symm)
  have hls := isLocallySurjective_toSheafify_moduleCat.{v, u, w} J Λ ((Functor.const Cᵒᵖ).obj M)
  have hS : Presheaf.imageSieve (toSheafify J ((Functor.const Cᵒᵖ).obj M)) s ∈ J T :=
    Presheaf.imageSieve_mem J _ s
  have hex : ∃ (Y : C) (g : Y ⟶ T),
      Presheaf.imageSieve (toSheafify J ((Functor.const Cᵒᵖ).obj M)) s g ∧
        (⊥ : Sieve Y) ∉ J Y := by
    by_contra hcon
    exact hbot (hall hS fun Y g hg =>
      Classical.byContradiction fun hY => hcon ⟨Y, g, hg, hY⟩)
  obtain ⟨Y₀, g₀, ⟨a₀, ha₀⟩, hY₀⟩ := hex
  refine ⟨a₀, (hsheaf _ hS).isSeparatedFor.ext fun {Y} g hg => ?_⟩
  have hres : ∀ {Z Y' : C} (k : Z ⟶ Y') (v : M),
      (sheafify J ((Functor.const Cᵒᵖ).obj M)).map k.op
          ((toSheafify J ((Functor.const Cᵒᵖ).obj M)).app (op Y') v) =
        (toSheafify J ((Functor.const Cᵒᵖ).obj M)).app (op Z) v :=
    fun k v => (NatTrans.naturality_apply (toSheafify J ((Functor.const Cᵒᵖ).obj M)) k.op v).symm
  change (sheafify J ((Functor.const Cᵒᵖ).obj M)).map g.op
      ((toSheafify J ((Functor.const Cᵒᵖ).obj M)).app (op T) a₀) = _
  rw [hres g a₀]
  obtain ⟨a, ha⟩ := hg
  by_cases hY : (⊥ : Sieve Y) ∈ J Y
  · exact (hsheaf ⊥ hY).isSeparatedFor.ext fun _ _ h => h.elim
  obtain ⟨Q, q, r, hQ⟩ := href Y Y₀ hY hY₀
  have h1 : (toSheafify J ((Functor.const Cᵒᵖ).obj M)).app (op Q) a =
      (sheafify J ((Functor.const Cᵒᵖ).obj M)).map (q ≫ g).op s := by
    rw [← hres q a, ha, ← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp]
  have h2 : (toSheafify J ((Functor.const Cᵒᵖ).obj M)).app (op Q) a₀ =
      (sheafify J ((Functor.const Cᵒᵖ).obj M)).map (r ≫ g₀).op s := by
    rw [← hres r a₀, ha₀, ← ConcreteCategory.comp_apply, ← Functor.map_comp, ← op_comp]
  obtain rfl : a = a₀ := hinj Q hQ (by rw [h1, h2, hT.hom_ext (q ≫ g) (r ≫ g₀)])
  exact ha

end Stacks.ConstantSheaf

namespace AlgebraicGeometry.Scheme

open Stacks.ConstantSheaf

variable {X : Scheme.{u}}

/-- An object of Mathlib's small étale site with a point is not sheaf theoretically empty: a
covering family is jointly surjective, and the empty family is not. -/
theorem bot_not_mem_smallEtaleTopology {T : X.Etale} (t : T.left) :
    (⊥ : Sieve T) ∉ X.smallEtaleTopology T := by
  intro h
  have hbot : Sieve.ofArrows (fun i : PEmpty.{u + 2} ↦ (PEmpty.elim i : X.Etale))
      (fun i ↦ (PEmpty.elim i : PEmpty.elim i ⟶ T)) = ⊥ := by
    refine le_antisymm ?_ bot_le
    intro Y f hf
    obtain ⟨i, -, -⟩ := (Sieve.mem_ofArrows_iff _ _ _).1 hf
    exact i.elim
  rw [← hbot] at h
  have hcov := (Scheme.ofArrows_mem_smallEtaleTopology_iff _).1 h
  have ht : t ∈ (Set.univ : Set T.left) := trivial
  rw [← hcov] at ht
  obtain ⟨i, -⟩ := Set.mem_iUnion.1 ht
  exact i.elim

/-- On Mathlib's small étale site, two objects over an irreducible object which are not sheaf
theoretically empty are refined, over it, by one which is not either: their fibre product, which
is nonempty because their images are nonempty opens of the irreducible object. -/
theorem exists_refinement_over_bot_not_mem_of_irreducibleSpace (U : X.Etale)
    [IrreducibleSpace U.left] (P Q : Over U)
    (hP : (⊥ : Sieve P) ∉ (X.smallEtaleTopology.over U) P)
    (hQ : (⊥ : Sieve Q) ∉ (X.smallEtaleTopology.over U) Q) :
    ∃ (R : Over U) (_ : R ⟶ P) (_ : R ⟶ Q),
      (⊥ : Sieve R) ∉ (X.smallEtaleTopology.over U) R := by
  rw [GrothendieckTopology.mem_over_iff, OrderIso.map_bot] at hP hQ
  obtain ⟨p⟩ : Nonempty P.left.left :=
    not_isEmpty_iff.1 fun h => hP (AlgebraicGeometry.smallEtale_bot_mem X h)
  obtain ⟨q⟩ : Nonempty Q.left.left :=
    not_isEmpty_iff.1 fun h => hQ (AlgebraicGeometry.smallEtale_bot_mem X h)
  obtain ⟨t, ht⟩ := nonempty_preirreducible_inter P.hom.left.isOpenMap.isOpen_range
    Q.hom.left.isOpenMap.isOpen_range ⟨_, p, rfl⟩ ⟨_, q, rfl⟩
  have hne : Nonempty ↑(Limits.pullback P.hom.left Q.hom.left) := by
    rw [← not_isEmpty_iff, AlgebraicGeometry.Scheme.isEmpty_pullback_iff, Set.not_disjoint_iff]
    exact ⟨t, ht.1, ht.2⟩
  have hiso : (Scheme.Etale.forget X ⋙ CategoryTheory.Over.forget X).obj
      (Limits.pullback P.hom Q.hom) ≅ Limits.pullback P.hom.left Q.hom.left :=
    PreservesPullback.iso _ P.hom Q.hom
  refine ⟨Over.mk (Limits.pullback.fst P.hom Q.hom ≫ P.hom),
    Over.homMk (Limits.pullback.fst P.hom Q.hom) rfl,
    Over.homMk (Limits.pullback.snd P.hom Q.hom) (Limits.pullback.condition).symm, ?_⟩
  rw [GrothendieckTopology.mem_over_iff, OrderIso.map_bot]
  exact bot_not_mem_smallEtaleTopology (hiso.inv.base hne.some)

variable (Λ : Type r) [Ring Λ]

/-- **The constants are exactly the sections of the constant sheaf of modules over an
irreducible object of Mathlib's small étale site.** -/
theorem bijective_toSheafify_const_app_of_irreducibleSpace
    (M : ModuleCat.{max (u + 1) r} Λ) (U : X.Etale) [IrreducibleSpace U.left] :
    Function.Bijective ((toSheafify X.smallEtaleTopology
      ((Functor.const (X.Etale)ᵒᵖ).obj M)).app (op U)) := by
  have hbot : (⊥ : Sieve (Over.mk (𝟙 U))) ∉ (X.smallEtaleTopology.over U) (Over.mk (𝟙 U)) := by
    rw [GrothendieckTopology.mem_over_iff, OrderIso.map_bot]
    exact bot_not_mem_smallEtaleTopology
      (‹IrreducibleSpace U.left›.toNonempty.some)
  have hbij : Function.Bijective ((toSheafify (X.smallEtaleTopology.over U)
      ((Functor.const (Over U)ᵒᵖ).obj M)).app (op (Over.mk (𝟙 U)))) :=
    Function.bijective_iff_existsUnique _ |>.2 fun s =>
      Stacks.ConstantSheaf.existsUnique_toSheafify_const_app_of_forall_exists_refinement
        (X.smallEtaleTopology.over U) M (Over.mkIdTerminal (X := U)) hbot
        (exists_refinement_over_bot_not_mem_of_irreducibleSpace U) s
  have hcomp : (toSheafify (X.smallEtaleTopology.over U)
        ((Functor.const (Over U)ᵒᵖ).obj M)).app (op (Over.mk (𝟙 U))) ≫
        ((overPullbackConstantSheafIso X.smallEtaleTopology
          (ModuleCat.{max (u + 1) r} Λ) U).hom.app M).hom.app (op (Over.mk (𝟙 U))) =
      (toSheafify X.smallEtaleTopology ((Functor.const (X.Etale)ᵒᵖ).obj M)).app (op U) :=
    Stacks.ConstantSheaf.toSheafify_overPullbackConstantSheafIso_app
      X.smallEtaleTopology (ModuleCat.{max (u + 1) r} Λ) U M (op (Over.mk (𝟙 U)))
  have hiso : IsIso (((overPullbackConstantSheafIso X.smallEtaleTopology
      (ModuleCat.{max (u + 1) r} Λ) U).hom.app M).hom.app (op (Over.mk (𝟙 U)))) :=
    inferInstance
  have hfun : ⇑(ConcreteCategory.hom ((toSheafify X.smallEtaleTopology
        ((Functor.const (X.Etale)ᵒᵖ).obj M)).app (op U))) =
      (⇑(ConcreteCategory.hom (((overPullbackConstantSheafIso X.smallEtaleTopology
          (ModuleCat.{max (u + 1) r} Λ) U).hom.app M).hom.app (op (Over.mk (𝟙 U)))))) ∘
        (⇑(ConcreteCategory.hom ((toSheafify (X.smallEtaleTopology.over U)
          ((Functor.const (Over U)ᵒᵖ).obj M)).app (op (Over.mk (𝟙 U)))))) := by
    rw [← hcomp]
    rfl
  rw [hfun]
  exact ((ConcreteCategory.isIso_iff_bijective _).1 hiso).comp hbij

end AlgebraicGeometry.Scheme

end
