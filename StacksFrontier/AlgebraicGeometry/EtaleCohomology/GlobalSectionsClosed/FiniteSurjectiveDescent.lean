private theorem toPlus_locally_surjective_general
    {C : Type u₁} [Category.{u₂} C] (J : GrothendieckTopology C)
    [∀ (P : Cᵒᵖ ⥤ Type w) (X : C) (S : J.Cover X), HasMultiequalizer (S.index P)]
    [∀ X : C, HasColimitsOfShape (J.Cover X)ᵒᵖ (Type w)]
    [∀ X : C, PreservesColimitsOfShape (J.Cover X)ᵒᵖ (forget (Type w))]
    (P : Cᵒᵖ ⥤ Type w) :
    Presheaf.IsLocallySurjective J (J.toPlus P) := by
  refine ⟨?_⟩
  intro X x
  obtain ⟨S, y, rfl⟩ := exists_rep x
  refine J.superset_covering (fun Y f hf => ⟨y.1 ⟨Y, f, hf⟩, ?_⟩) S.2
  rw [toPlus_eq_mk, res_mk_eq_mk_pullback, eq_mk_iff_exists]
  refine ⟨S.pullback f, homOfLE le_top, 𝟙 _, ?_⟩
  ext ⟨Z, g, hg⟩
  simpa using! y.2 { fst.hf := hf, snd.hf := S.1.downward_closed hf g, r.g₁ := g, r.g₂ := 𝟙 Z, .. }

private theorem toSheafify_locally_surjective_general
    {C : Type u₁} [Category.{u₂} C] (J : GrothendieckTopology C)
    [HasWeakSheafify J (Type w)]
    [∀ (P : Cᵒᵖ ⥤ Type w) (X : C) (S : J.Cover X), HasMultiequalizer (S.index P)]
    [∀ X : C, HasColimitsOfShape (J.Cover X)ᵒᵖ (Type w)]
    [∀ X : C, PreservesColimitsOfShape (J.Cover X)ᵒᵖ (forget (Type w))]
    (P : Cᵒᵖ ⥤ Type w) :
    Presheaf.IsLocallySurjective J (J.toSheafify P) := by
  have := toPlus_locally_surjective_general J P
  have : Presheaf.IsLocallySurjective J (J.plusMap (J.toPlus P)) := by
    rw [GrothendieckTopology.plusMap_toPlus]
    exact toPlus_locally_surjective_general J (J.plusObj P)
  change Presheaf.IsLocallySurjective J (J.toPlus P ≫ J.plusMap (J.toPlus P))
  exact Presheaf.isLocallySurjective_comp J (J.toPlus P) (J.plusMap (J.toPlus P))

private theorem sheafification_sections_locally_lift
    {C : Type u₁} [Category.{u₂} C] (J : GrothendieckTopology C)
    [HasWeakSheafify J (Type w)]
    [∀ (P : Cᵒᵖ ⥤ Type w) (X : C) (S : J.Cover X), HasMultiequalizer (S.index P)]
    [∀ X : C, HasColimitsOfShape (J.Cover X)ᵒᵖ (Type w)]
    [∀ X : C, PreservesColimitsOfShape (J.Cover X)ᵒᵖ (forget (Type w))]
    (P : Cᵒᵖ ⥤ Type w) (U : C)
    (s : ((presheafToSheaf J (Type w)).obj P).obj.obj (Opposite.op U)) :
    ∃ S : Sieve U, S ∈ J U ∧
      ∀ ⦃V : C⦄ (f : V ⟶ U), S f →
        ∃ p : P.obj (Opposite.op V),
          (toSheafify J P).app (Opposite.op V) p =
            ((presheafToSheaf J (Type w)).obj P).obj.map f.op s := by
  have := toSheafify_locally_surjective_general J P
  have : Presheaf.IsLocallySurjective J (toSheafify J P) := by
    rw [← toSheafify_plusPlusIsoSheafify_hom]
    infer_instance
  exact ⟨Presheaf.imageSieve (toSheafify J P) s, Presheaf.imageSieve_mem J (toSheafify J P) s,
    fun _ _ hf => hf⟩

private theorem toSheafify_locally_injective_general
    {C : Type u₁} [Category.{u₂} C] (J : GrothendieckTopology C)
    [HasWeakSheafify J (Type w)]
    [∀ (P : Cᵒᵖ ⥤ Type w) (X : C) (S : J.Cover X), HasMultiequalizer (S.index P)]
    [∀ X : C, HasColimitsOfShape (J.Cover X)ᵒᵖ (Type w)]
    [∀ X : C, PreservesColimitsOfShape (J.Cover X)ᵒᵖ (forget (Type w))]
    (P : Cᵒᵖ ⥤ Type w) :
    Presheaf.IsLocallyInjective J (toSheafify J P) := by
  have hplus (Q : Cᵒᵖ ⥤ Type w) : Presheaf.IsLocallyInjective J (J.toPlus Q) := by
    constructor
    intro X x y h
    rw [toPlus_eq_mk, toPlus_eq_mk, eq_mk_iff_exists] at h
    obtain ⟨W, h₁, h₂, e⟩ := h
    exact J.superset_covering
      (fun Y f hf => congr_fun (congr_arg Subtype.val e) ⟨Y, f, hf⟩) W.2
  have := hplus P
  have := hplus (J.plusObj P)
  have : Presheaf.IsLocallyInjective J (J.toSheafify P) := by
    dsimp [GrothendieckTopology.toSheafify]
    rw [GrothendieckTopology.plusMap_toPlus]
    exact Presheaf.isLocallyInjective_comp J (J.toPlus P) (J.toPlus (J.plusObj P))
  rw [← toSheafify_plusPlusIsoSheafify_hom]
  infer_instance

private theorem smallEtaleInverseImage_section_locally_lift
    {X Z : Scheme.{u}} (i : Z ⟶ X)
    (F : Sheaf (Scheme.smallEtaleTopology X) (Type (max (u + 1) v)))
    (t : ((smallEtaleInverseImage i).obj F).obj.obj
      (Opposite.op (terminal Z.Etale))) :
    ∃ S : Sieve (terminal Z.Etale), S ∈ Scheme.smallEtaleTopology Z
        (terminal Z.Etale) ∧
      ∀ ⦃V : Z.Etale⦄ (f : V ⟶ terminal Z.Etale), S f →
        ∃ p : ((smallEtaleBaseChange i).op.lan.obj F.obj).obj
          (Opposite.op V),
          (toSheafify (Scheme.smallEtaleTopology Z)
            ((smallEtaleBaseChange i).op.lan.obj F.obj)).app
              (Opposite.op V) p =
            ((smallEtaleInverseImage i).obj F).obj.map f.op t :=
  sheafification_sections_locally_lift (Scheme.smallEtaleTopology Z)
    ((smallEtaleBaseChange i).op.lan.obj F.obj) (terminal Z.Etale) t

/-- Every section of a left Kan extension along `B.op` over `V` is, locally on `V`, the image of a
section of `F` over some `U` along a map `V ⟶ B.obj U`. -/
private theorem lan_section_has_representative {C D : Type*} [Category C] [Category D]
    (B : C ⥤ D) (F : Cᵒᵖ ⥤ Type w) [∀ G : Cᵒᵖ ⥤ Type w, B.op.HasPointwiseLeftKanExtension G]
    (V : D) (p : (B.op.lan.obj F).obj (Opposite.op V)) :
    ∃ (U : C) (s : F.obj (Opposite.op U)) (g : V ⟶ B.obj U),
      (B.op.lan.obj F).map g.op ((B.op.lanUnit.app F).app (Opposite.op U) s) = p := by
  let e := B.op.leftKanExtensionObjIsoColimit F (Opposite.op V)
  obtain ⟨j, s, hs⟩ := Concrete.colimit_exists_rep
    (CostructuredArrow.proj B.op (Opposite.op V) ⋙ F) (e.hom p)
  refine ⟨j.left.unop, s, j.hom.unop, ?_⟩
  have hι := B.op.ι_leftKanExtensionObjIsoColimit_inv F (Opposite.op V) j
  have hp : e.inv (colimit.ι (CostructuredArrow.proj B.op (Opposite.op V) ⋙ F) j s) = p := by
    rw [hs]
    exact ConcreteCategory.congr_hom e.hom_inv_id p
  exact (congrArg (fun q => q s) hι.symm).trans hp

private theorem smallEtaleBaseChange_terminal_hom_exists
    {X Z : Scheme.{u}} (i : Z ⟶ X) :
    Nonempty (terminal Z.Etale ⟶
      (smallEtaleBaseChange i).obj (terminal X.Etale)) :=
  ⟨(PreservesTerminal.iso (smallEtaleBaseChange i)).inv⟩

private theorem etale_terminal_hom_bijective (X : Scheme.{u}) :
    Function.Bijective (terminal X.Etale).hom := by
  let : MorphismProperty.ContainsIdentities (@Etale : MorphismProperty Scheme.{u}) :=
    ⟨fun _ => inferInstance⟩
  let e : terminal X.Etale ≅ Scheme.Etale.mk (𝟙 X) :=
    terminalIsTerminal.uniqueUpToIso (MorphismProperty.Over.mkIdTerminal @Etale X)
  have he : e.hom.left = (terminal X.Etale).hom :=
    (Category.comp_id _).symm.trans (MorphismProperty.Over.w e.hom)
  have hleft : (terminal X.Etale).hom ≫ e.inv.left = 𝟙 _ := by
    rw [← he]
    exact congrArg (fun f => f.left) e.hom_inv_id
  have hright : e.inv.left ≫ (terminal X.Etale).hom = 𝟙 X := e.inv.w
  have hl : Function.LeftInverse e.inv.left (terminal X.Etale).hom := fun x =>
    congrArg (fun f : (terminal X.Etale).left ⟶ (terminal X.Etale).left => f x) hleft
  have hr : Function.RightInverse e.inv.left (terminal X.Etale).hom := fun x =>
    congrArg (fun f : X ⟶ X => f x) hright
  exact ⟨hl.injective, hr.surjective⟩

private theorem smallEtale_sieve_mem_iff
    {X : Scheme.{u}} {U : X.Etale} (S : Sieve U) :
    S ∈ X.smallEtaleTopology U ↔
      ∀ x : U.left, ∃ (V : X.Etale) (f : V ⟶ U) (y : V.left),
        S f ∧ f.left y = x := by
  let : MorphismProperty.RespectsIso (@Etale : MorphismProperty Scheme.{u}) :=
    MorphismProperty.IsStableUnderBaseChange.respectsIso
  let : MorphismProperty.IsStableUnderComposition (@Etale : MorphismProperty Scheme.{u}) :=
    MorphismProperty.IsMultiplicative.toIsStableUnderComposition
  let : MorphismProperty.ContainsIdentities (@Etale : MorphismProperty Scheme.{u}) :=
    ⟨fun _ => inferInstance⟩
  change S ∈ X.smallGrothendieckTopology (P := @Etale) U ↔ _
  rw [Scheme.smallGrothendieckTopology_eq_toGrothendieck_smallPretopology
    X (le_refl (@Etale : MorphismProperty Scheme.{u}))]
  refine (Scheme.mem_toGrothendieck_smallPretopology U S).trans (forall_congr' fun x => ?_)
  exact ⟨fun ⟨V, f, y, hf, _, hy⟩ => ⟨V, f, y, hf, hy⟩,
    fun ⟨V, f, y, hf, hy⟩ => ⟨V, f, y, hf, inferInstance, hy⟩⟩

/-- Sections of a sheaf on the small étale site that agree after restriction along étale maps
whose images cover are equal. -/
private theorem smallEtale_sheaf_eq_of_locally_eq {X : Scheme.{u}}
    (F : Sheaf X.smallEtaleTopology (Type w)) {U : X.Etale} (a b : F.obj.obj (Opposite.op U))
    (h : ∀ x : U.left, ∃ (V : X.Etale) (f : V ⟶ U) (y : V.left),
      F.obj.map f.op a = F.obj.map f.op b ∧ f.left y = x) : a = b := by
  have hS : Presheaf.equalizerSieve (F := F.obj) a b ∈ X.smallEtaleTopology U :=
    (smallEtale_sieve_mem_iff _).2 h
  exact (((isSheaf_iff_isSheaf_of_type _ _).1 F.property).isSeparated _ hS).ext
    (fun _ _ hf => hf)

/-- Two sections of `F` over `U` have the same image in the left Kan extension along `B.op`, after
restriction along `g : V ⟶ B.obj U`, iff they agree on some factorization of `g` through a
`B.obj W`. -/
private theorem lan_eq_iff {C D : Type*} [Category C] [Category D]
    (B : C ⥤ D) [RepresentablyFlat B] (F : Cᵒᵖ ⥤ Type w)
    [∀ G : Cᵒᵖ ⥤ Type w, B.op.HasPointwiseLeftKanExtension G]
    {U : C} {V : D} (g : V ⟶ B.obj U) (a b : F.obj (Opposite.op U)) :
    (B.op.lan.obj F).map g.op ((B.op.lanUnit.app F).app (Opposite.op U) a) =
        (B.op.lan.obj F).map g.op ((B.op.lanUnit.app F).app (Opposite.op U) b) ↔
      ∃ (W : C) (f : W ⟶ U) (k : V ⟶ B.obj W),
        k ≫ B.map f = g ∧ F.map f.op a = F.map f.op b := by
  let j : CostructuredArrow B.op (Opposite.op V) := CostructuredArrow.mk g.op
  let D := CostructuredArrow.proj B.op (Opposite.op V) ⋙ F
  let e := B.op.leftKanExtensionObjIsoColimit F (Opposite.op V)
  have hι := B.op.ι_leftKanExtensionObjIsoColimit_inv F (Opposite.op V) j
  constructor
  · intro h
    have heq : colimit.ι D j a = colimit.ι D j b := by
      apply (ConcreteCategory.bijective_of_isIso e.inv).1
      simpa only [types_comp_apply] using
        (ConcreteCategory.congr_hom hι a).trans
          (h.trans (ConcreteCategory.congr_hom hι b).symm)
    obtain ⟨k, f, hf⟩ :=
      (Types.FilteredColimit.isColimit_eq_iff' (colimit.isColimit D) (i := j) a b).mp heq
    refine ⟨k.left.unop, f.left.unop, k.hom.unop, ?_, hf⟩
    exact congrArg Quiver.Hom.unop (CostructuredArrow.w f)
  · rintro ⟨W, f, k, hkg, hf⟩
    have hn := ConcreteCategory.congr_hom
      (((B.op.lanUnit.app F).naturality f.op))
    have hfac (s : F.obj (Opposite.op U)) :
        (B.op.lan.obj F).map g.op ((B.op.lanUnit.app F).app (Opposite.op U) s) =
          (B.op.lan.obj F).map k.op
            ((B.op.lanUnit.app F).app (Opposite.op W) (F.map f.op s)) := by
      rw [← hkg, op_comp, Functor.map_comp]
      exact congrArg ((B.op.lan.obj F).map k.op) (hn s).symm
    exact (hfac a).trans ((congrArg
      (fun s => (B.op.lan.obj F).map k.op
        ((B.op.lanUnit.app F).app (Opposite.op W) s)) hf).trans (hfac b).symm)


private theorem smallEtale_pullback_eq_near_point
    {X Z : Scheme.{u}} (i : Z ⟶ X)
    (F : X.Etaleᵒᵖ ⥤ Type (max (u + 1) v))
    {U : X.Etale} {V : Z.Etale}
    (g : V ⟶ (smallEtaleBaseChange i).obj U)
    (a b : F.obj (Opposite.op U))
    (h : (toSheafify Z.smallEtaleTopology
        ((smallEtaleBaseChange i).op.lan.obj F)).app (Opposite.op V)
          (((smallEtaleBaseChange i).op.lan.obj F).map g.op
            (((smallEtaleBaseChange i).op.lanUnit.app F).app
              (Opposite.op U) a)) =
      (toSheafify Z.smallEtaleTopology
        ((smallEtaleBaseChange i).op.lan.obj F)).app (Opposite.op V)
          (((smallEtaleBaseChange i).op.lan.obj F).map g.op
            (((smallEtaleBaseChange i).op.lanUnit.app F).app
              (Opposite.op U) b))) (x : V.left) :
    ∃ (W : X.Etale) (f : W ⟶ U) (w : W.left),
      f.left w = pullback.fst U.hom i (g.left x) ∧
        F.map f.op a = F.map f.op b := by
  let B := smallEtaleBaseChange i
  let P := B.op.lan.obj F
  let η := toSheafify Z.smallEtaleTopology P
  let a' := P.map g.op ((B.op.lanUnit.app F).app (Opposite.op U) a)
  let b' := P.map g.op ((B.op.lanUnit.app F).app (Opposite.op U) b)
  let : Presheaf.IsLocallyInjective Z.smallEtaleTopology η :=
    toSheafify_locally_injective_general _ P
  have hR : Presheaf.equalizerSieve (F := P) a' b' ∈ Z.smallEtaleTopology V :=
    Presheaf.equalizerSieve_mem Z.smallEtaleTopology η a' b' h
  obtain ⟨V', r, y, hr, hy⟩ := (smallEtale_sieve_mem_iff _).mp hR x
  have hr' : P.map (r ≫ g).op ((B.op.lanUnit.app F).app (Opposite.op U) a) =
      P.map (r ≫ g).op ((B.op.lanUnit.app F).app (Opposite.op U) b) := by
    change P.map r.op a' = P.map r.op b' at hr
    change P.map r.op (P.map g.op ((B.op.lanUnit.app F).app (Opposite.op U) a)) =
      P.map r.op (P.map g.op ((B.op.lanUnit.app F).app (Opposite.op U) b)) at hr
    simpa only [op_comp, Functor.map_comp, types_comp_apply] using hr
  obtain ⟨W, f, k, hkg, hf⟩ := (lan_eq_iff (smallEtaleBaseChange i) F (r ≫ g) a b).mp hr'
  refine ⟨W, f, pullback.fst W.hom i (k.left y), ?_, hf⟩
  have hproj : k.left ≫ pullback.fst W.hom i ≫ f.left =
      r.left ≫ g.left ≫ pullback.fst U.hom i := by
    have hh := congrArg (fun q : V' ⟶ B.obj U => q.left ≫ pullback.fst U.hom i) hkg
    change (k.left ≫ (B.map f).left) ≫ pullback.fst U.hom i =
      (r.left ≫ g.left) ≫ pullback.fst U.hom i at hh
    have hm : (B.map f).left ≫ pullback.fst U.hom i =
        pullback.fst W.hom i ≫ f.left := pullback.lift_fst _ _ _
    calc k.left ≫ pullback.fst W.hom i ≫ f.left
        = k.left ≫ (B.map f).left ≫ pullback.fst U.hom i :=
          congrArg (fun q : ((smallEtaleBaseChange i).obj W).left ⟶ U.left =>
            k.left ≫ q) hm.symm
      _ = (k.left ≫ (B.map f).left) ≫ pullback.fst U.hom i := (Category.assoc _ _ _).symm
      _ = (r.left ≫ g.left) ≫ pullback.fst U.hom i := hh
      _ = r.left ≫ g.left ≫ pullback.fst U.hom i := Category.assoc _ _ _
  have hp := congrArg (fun q : V'.left ⟶ U.left => q y) hproj
  change f.left (pullback.fst W.hom i (k.left y)) =
    pullback.fst U.hom i (g.left (r.left y)) at hp
  rw [hy] at hp
  exact hp

private theorem smallEtaleGlobalSection_locally_comes_from_etale
    {X Z : Scheme.{u}} (i : Z ⟶ X)
    (F : Sheaf (Scheme.smallEtaleTopology X) (Type (max (u + 1) v)))
    (t : ((smallEtaleInverseImage i).obj F).obj.obj
      (Opposite.op (terminal Z.Etale))) :
    ∃ S : Sieve (terminal Z.Etale), S ∈ Scheme.smallEtaleTopology Z
        (terminal Z.Etale) ∧
      ∀ ⦃V : Z.Etale⦄ (f : V ⟶ terminal Z.Etale), S f →
        ∃ (U : X.Etale) (s : F.obj.obj (Opposite.op U))
          (g : V ⟶ (smallEtaleBaseChange i).obj U),
          (toSheafify (Scheme.smallEtaleTopology Z)
            ((smallEtaleBaseChange i).op.lan.obj F.obj)).app
              (Opposite.op V)
              (((smallEtaleBaseChange i).op.lan.obj F.obj).map g.op
                (((smallEtaleBaseChange i).op.lanUnit.app F.obj).app
                  (Opposite.op U) s)) =
            ((smallEtaleInverseImage i).obj F).obj.map f.op t := by
  obtain ⟨S, hS, hlift⟩ := smallEtaleInverseImage_section_locally_lift i F t
  refine ⟨S, hS, fun V f hf => ?_⟩
  obtain ⟨p, hp⟩ := hlift f hf
  obtain ⟨U, s, g, hg⟩ := lan_section_has_representative (smallEtaleBaseChange i) F.obj V p
  exact ⟨U, s, g, (congrArg ((toSheafify (Scheme.smallEtaleTopology Z)
    ((smallEtaleBaseChange i).op.lan.obj F.obj)).app (Opposite.op V)) hg).trans hp⟩

private theorem smallEtaleGlobalSection_has_lifting_family
    {X Z : Scheme.{u}} (i : Z ⟶ X)
    (F : Sheaf (Scheme.smallEtaleTopology X) (Type (max (u + 1) v)))
    (t : ((smallEtaleInverseImage i).obj F).obj.obj
      (Opposite.op (terminal Z.Etale))) :
    ∃ (I : Type u) (V : I → Z.Etale) (U : I → X.Etale)
      (s : ∀ j, F.obj.obj (Opposite.op (U j)))
      (g : ∀ j, V j ⟶ (smallEtaleBaseChange i).obj (U j)),
      (∀ j, (toSheafify (Scheme.smallEtaleTopology Z)
          ((smallEtaleBaseChange i).op.lan.obj F.obj)).app
            (Opposite.op (V j))
            (((smallEtaleBaseChange i).op.lan.obj F.obj).map (g j).op
              (((smallEtaleBaseChange i).op.lanUnit.app F.obj).app
                (Opposite.op (U j)) (s j))) =
          ((smallEtaleInverseImage i).obj F).obj.map
            (terminal.from (V j)).op t) ∧
      ∀ z : Z.carrier, ∃ j, ∃ y : (V j).left, (V j).hom y = z := by
  classical
  obtain ⟨S, hS, hlift⟩ := smallEtaleGlobalSection_locally_comes_from_etale i F t
  let : MorphismProperty.RespectsIso (@Etale : MorphismProperty Scheme.{u}) :=
    MorphismProperty.IsStableUnderBaseChange.respectsIso
  obtain ⟨𝒰, hOver, hle⟩ :=
    (Scheme.mem_smallGrothendieckTopology (P := @Etale) (S := Z)
      (terminal Z.Etale) S).mp hS
  obtain ⟨hEtale, hle⟩ := hle
  let : Category (MorphismProperty.Over @Etale ⊤ Z) :=
    inferInstanceAs (Category Z.Etale)
  let (j : 𝒰.I₀) : (𝒰.X j).Over Z := hOver.over j
  let (j : 𝒰.I₀) : (𝒰.f j).IsOver Z := hOver.isOver_map j
  let V : 𝒰.I₀ → Z.Etale := fun j =>
    (𝒰.X j).asOverProp Z (hEtale j)
  let f : ∀ j, V j ⟶ terminal Z.Etale := fun j => (𝒰.f j).asOverProp Z
  have hdata : ∀ j, ∃ (U : X.Etale) (s : F.obj.obj (Opposite.op U))
      (g : V j ⟶ (smallEtaleBaseChange i).obj U),
      (toSheafify (Scheme.smallEtaleTopology Z)
        ((smallEtaleBaseChange i).op.lan.obj F.obj)).app
          (Opposite.op (V j))
          (((smallEtaleBaseChange i).op.lan.obj F.obj).map g.op
            (((smallEtaleBaseChange i).op.lanUnit.app F.obj).app
              (Opposite.op U) s)) =
        ((smallEtaleInverseImage i).obj F).obj.map
          (terminal.from (V j)).op t := by
    intro j
    have hf : S (f j) := hle _ _ ⟨j⟩
    obtain ⟨U, s, g, hg⟩ := hlift (f j) hf
    refine ⟨U, s, g, ?_⟩
    simpa only [terminal.hom_ext (f j) (terminal.from (V j))] using hg
  choose U s g hg using hdata
  refine ⟨𝒰.I₀, V, U, s, g, hg, fun z => ?_⟩
  obtain ⟨x, rfl⟩ := (etale_terminal_hom_bijective Z).2 z
  obtain ⟨j, y, rfl⟩ :=
    ((Scheme.presieve₀_mem_precoverage_iff 𝒰.toPreZeroHypercover).mp 𝒰.mem₀).1 x
  exact ⟨j, y, (congrArg (fun q => q y) (MorphismProperty.Over.w (f j))).symm.trans
    (Scheme.Hom.comp_apply _ _ _)⟩

private abbrev pullbackSection {X Z : Scheme.{u}} (i : Z ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    {U : X.Etale} {V : Z.Etale}
    (g : V ⟶ (smallEtaleBaseChange i).obj U)
    (s : F.obj.obj (Opposite.op U)) :=
  (toSheafify Z.smallEtaleTopology
    ((smallEtaleBaseChange i).op.lan.obj F.obj)).app (Opposite.op V)
    (((smallEtaleBaseChange i).op.lan.obj F.obj).map g.op
      (((smallEtaleBaseChange i).op.lanUnit.app F.obj).app
        (Opposite.op U) s))

private theorem pullbackSection_map {X Z : Scheme.{u}} (i : Z ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    {U : X.Etale} {V W : Z.Etale}
    (g : V ⟶ (smallEtaleBaseChange i).obj U) (f : W ⟶ V)
    (s : F.obj.obj (Opposite.op U)) :
    ((smallEtaleInverseImage i).obj F).obj.map f.op
      (pullbackSection i F g s) = pullbackSection i F (f ≫ g) s := by
  have h := NatTrans.naturality_apply
    (toSheafify Z.smallEtaleTopology
      ((smallEtaleBaseChange i).op.lan.obj F.obj)) f.op
    (((smallEtaleBaseChange i).op.lan.obj F.obj).map g.op
      (((smallEtaleBaseChange i).op.lanUnit.app F.obj).app
        (Opposite.op U) s))
  dsimp only [pullbackSection, smallEtaleInverseImage]
  rw [op_comp, Functor.map_comp]
  exact h.symm

private theorem pullbackSection_restrict {X Z : Scheme.{u}} (i : Z ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    {U W : X.Etale} {V : Z.Etale} (f : W ⟶ U)
    (g : V ⟶ (smallEtaleBaseChange i).obj W)
    (s : F.obj.obj (Opposite.op U)) :
    pullbackSection i F g (F.obj.map f.op s) =
      pullbackSection i F (g ≫ (smallEtaleBaseChange i).map f) s := by
  have h := NatTrans.naturality_apply
    ((smallEtaleBaseChange i).op.lanUnit.app F.obj) f.op s
  change ((smallEtaleBaseChange i).op.lanUnit.app F.obj).app
      (Opposite.op W) (F.obj.map f.op s) =
    ((smallEtaleBaseChange i).op.lan.obj F.obj).map
      ((smallEtaleBaseChange i).map f).op
      (((smallEtaleBaseChange i).op.lanUnit.app F.obj).app
        (Opposite.op U) s) at h
  simpa only [pullbackSection, op_comp, Functor.map_comp, types_comp_apply] using
    congrArg (fun q => (toSheafify Z.smallEtaleTopology
      ((smallEtaleBaseChange i).op.lan.obj F.obj)).app (Opposite.op V)
        (((smallEtaleBaseChange i).op.lan.obj F.obj).map g.op q)) h

private theorem sheaf_section_lifts_of_imageSieve_mem
    {C : Type u₁} [Category.{u₂} C] {J : GrothendieckTopology C}
    {F G : Sheaf J (Type w)} (f : F ⟶ G)
    (hf : ∀ U : Cᵒᵖ, Function.Injective (f.hom.app U))
    {U : C} (t : G.obj.obj (Opposite.op U))
    (ht : Presheaf.imageSieve f.hom t ∈ J U) :
    ∃ s : F.obj.obj (Opposite.op U), f.hom.app (Opposite.op U) s = t := by
  classical
  let S := Presheaf.imageSieve f.hom t
  let s : Presieve.FamilyOfElements F.obj S.arrows := fun _ g hg => Classical.choose hg
  have hs {V : C} (g : V ⟶ U) (hg : S g) :
      f.hom.app (Opposite.op V) (s g hg) = G.obj.map g.op t := Classical.choose_spec hg
  have hc : s.Compatible := by
    intro V₁ V₂ W a b g₁ g₂ hg₁ hg₂ hab
    apply hf (Opposite.op W)
    calc
      _ = G.obj.map a.op (f.hom.app (Opposite.op V₁) (s g₁ hg₁)) :=
        NatTrans.naturality_apply f.hom a.op _
      _ = G.obj.map a.op (G.obj.map g₁.op t) := congrArg _ (hs g₁ hg₁)
      _ = G.obj.map b.op (G.obj.map g₂.op t) := by
        simp only [← Functor.map_comp_apply, ← op_comp, hab]
      _ = G.obj.map b.op (f.hom.app (Opposite.op V₂) (s g₂ hg₂)) := congrArg _ (hs g₂ hg₂).symm
      _ = _ := (NatTrans.naturality_apply f.hom b.op _).symm
  have hF := (isSheaf_iff_isSheaf_of_type _ _).mp F.property S ht
  obtain ⟨a, ha, _⟩ := hF s hc
  refine ⟨a, ?_⟩
  apply (((isSheaf_iff_isSheaf_of_type _ _).mp G.property).isSeparated S ht).ext
  intro V g hg
  calc
    _ = f.hom.app (Opposite.op V) (F.obj.map g.op a) :=
      (NatTrans.naturality_apply f.hom g.op a).symm
    _ = f.hom.app (Opposite.op V) (s g hg) := congrArg _ (ha g hg)
    _ = _ := hs g hg


private theorem pullbackSection_eq_unit {X Z : Scheme.{u}} (i : Z ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    {U : X.Etale} {V : Z.Etale}
    (g : V ⟶ (smallEtaleBaseChange i).obj U)
    (s : F.obj.obj (Opposite.op U)) :
    pullbackSection i F g s =
      ((smallEtaleInverseImage i).obj F).obj.map g.op
        (((smallEtaleInverseImageAdjunction.{u, v} i).unit.app F).hom.app (Opposite.op U) s) :=
  NatTrans.naturality_apply
    (toSheafify Z.smallEtaleTopology ((smallEtaleBaseChange i).op.lan.obj F.obj))
    g.op (((smallEtaleBaseChange i).op.lanUnit.app F.obj).app (Opposite.op U) s)

/-- Étale base change along a composite is the composite of the base changes, in the reverse
order: for `p = g ≫ f` the functor `p^*` on small étale sites is `f^* ⋙ g^*`.  This is
`Stacks.EtaleCohomology.smallEtaleBaseChangeComp` with the composite presented by an equation
`hp : p = g ≫ f` rather than literally. -/
public def etaleBaseChangeCompIso {X Y Z : Scheme.{u}}
    (f : Y ⟶ X) (g : Z ⟶ Y) (p : Z ⟶ X) (hp : p = g ≫ f) :
    smallEtaleBaseChange p ≅
      smallEtaleBaseChange f ⋙ smallEtaleBaseChange g := by
  let : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) f :=
    ⟨fun _ _ ↦ inferInstance⟩
  let : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) g :=
    ⟨fun _ _ ↦ inferInstance⟩
  let : MorphismProperty.IsStableUnderBaseChangeAlong
      (@Etale : MorphismProperty Scheme.{u}) f :=
    ⟨fun pb hg ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb hg⟩
  let : MorphismProperty.IsStableUnderBaseChangeAlong
      (@Etale : MorphismProperty Scheme.{u}) g :=
    ⟨fun pb hg ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb hg⟩
  exact MorphismProperty.Over.pullbackComp (P := @Etale) (Q := ⊤) g f p hp

/-- The direct-image composition isomorphism `g_* ⋙ f_* ≅ p_*` for `p = g ≫ f`, obtained from
`Stacks.EtaleCohomology.etaleBaseChangeCompIso` by transport.  This is
`Stacks.EtaleCohomology.smallEtalePushforwardCompIso` with the composite presented by an
equation. -/
public def etalePushforwardCompIso {X Y Z : Scheme.{u}}
    (f : Y ⟶ X) (g : Z ⟶ Y) (p : Z ⟶ X) (hp : p = g ≫ f) :
    (smallEtaleBaseChange g).sheafPushforwardContinuous
        (Type (max (u + 1) v)) Y.smallEtaleTopology Z.smallEtaleTopology ⋙
      (smallEtaleBaseChange f).sheafPushforwardContinuous
        (Type (max (u + 1) v)) X.smallEtaleTopology Y.smallEtaleTopology ≅
      (smallEtaleBaseChange p).sheafPushforwardContinuous
        (Type (max (u + 1) v)) X.smallEtaleTopology Z.smallEtaleTopology :=
  Functor.sheafPushforwardContinuousComp' (etaleBaseChangeCompIso f g p hp).symm
    (Type (max (u + 1) v)) X.smallEtaleTopology Y.smallEtaleTopology Z.smallEtaleTopology

/-- The inverse-image composition isomorphism `f^{-1} ⋙ g^{-1} ≅ p^{-1}` for `p = g ≫ f`, as the
mate of `Stacks.EtaleCohomology.etalePushforwardCompIso`. -/
public def etalePullbackCompIso {X Y Z : Scheme.{u}}
    (f : Y ⟶ X) (g : Z ⟶ Y) (p : Z ⟶ X) (hp : p = g ≫ f) :
    smallEtaleInverseImage f ⋙ smallEtaleInverseImage g ≅
      smallEtaleInverseImage.{u, v} p :=
  Adjunction.leftAdjointCompIso (smallEtaleInverseImageAdjunction.{u, v} f)
    (smallEtaleInverseImageAdjunction.{u, v} g) (smallEtaleInverseImageAdjunction.{u, v} p)
    (etalePushforwardCompIso f g p hp)

private theorem etalePullbackCompIso_unit {X Y Z : Scheme.{u}}
    (f : Y ⟶ X) (g : Z ⟶ Y) (p : Z ⟶ X) (hp : p = g ≫ f)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))) (U : X.Etale) :
    ((smallEtaleInverseImageAdjunction.{u, v} f).unit.app F).hom.app (Opposite.op U) ≫
      ((smallEtaleInverseImageAdjunction.{u, v} g).unit.app
          ((smallEtaleInverseImage f).obj F)).hom.app
        (Opposite.op ((smallEtaleBaseChange f).obj U)) ≫
      ((etalePullbackCompIso f g p hp).hom.app F).hom.app
        (Opposite.op ((smallEtaleBaseChange g).obj
          ((smallEtaleBaseChange f).obj U))) =
    ((smallEtaleInverseImageAdjunction.{u, v} p).unit.app F).hom.app (Opposite.op U) ≫
      ((smallEtaleInverseImage p).obj F).obj.map
        ((etaleBaseChangeCompIso f g p hp).inv.app U).op := by
  have h := unit_conjugateEquiv_symm (smallEtaleInverseImageAdjunction.{u, v} p)
    ((smallEtaleInverseImageAdjunction.{u, v} f).comp
      (smallEtaleInverseImageAdjunction.{u, v} g)) (etalePushforwardCompIso f g p hp).inv F
  exact (congrArg (fun q => q.hom.app (Opposite.op U)) h).symm

private theorem etalePullbackCompIso_section {X Y Z : Scheme.{u}}
    (f : Y ⟶ X) (g : Z ⟶ Y) (p : Z ⟶ X) (hp : p = g ≫ f)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    {U : X.Etale} {V : Y.Etale} {W : Z.Etale}
    (a : V ⟶ (smallEtaleBaseChange f).obj U)
    (b : W ⟶ (smallEtaleBaseChange g).obj V)
    (s : F.obj.obj (Opposite.op U)) :
    ((etalePullbackCompIso f g p hp).hom.app F).hom.app (Opposite.op W)
      (pullbackSection g ((smallEtaleInverseImage f).obj F) b
        (pullbackSection f F a s)) =
    pullbackSection p F
      (b ≫ (smallEtaleBaseChange g).map a ≫
        (etaleBaseChangeCompIso f g p hp).inv.app U) s := by
  let Ff := (smallEtaleInverseImage f).obj F
  let Ffg := (smallEtaleInverseImage g).obj Ff
  let Fp := (smallEtaleInverseImage p).obj F
  let ηf := ((smallEtaleInverseImageAdjunction.{u, v} f).unit.app F).hom
  let ηg := ((smallEtaleInverseImageAdjunction.{u, v} g).unit.app Ff).hom
  let ηp := ((smallEtaleInverseImageAdjunction.{u, v} p).unit.app F).hom
  let e := ((etalePullbackCompIso f g p hp).hom.app F).hom
  let k := (smallEtaleBaseChange g).map a
  let c := (etaleBaseChangeCompIso f g p hp).inv.app U
  have hn := NatTrans.naturality_apply ηg a.op (ηf.app (Opposite.op U) s)
  change ηg.app (Opposite.op V) (Ff.obj.map a.op (ηf.app (Opposite.op U) s)) =
    Ffg.obj.map k.op
      (ηg.app (Opposite.op ((smallEtaleBaseChange f).obj U))
        (ηf.app (Opposite.op U) s)) at hn
  have hu := ConcreteCategory.congr_hom (etalePullbackCompIso_unit f g p hp F U) s
  simp only [pullbackSection_eq_unit]
  change e.app (Opposite.op W)
      (Ffg.obj.map b.op (ηg.app (Opposite.op V)
        (Ff.obj.map a.op (ηf.app (Opposite.op U) s)))) =
    Fp.obj.map (b ≫ k ≫ c).op (ηp.app (Opposite.op U) s)
  calc
    _ = e.app (Opposite.op W) (Ffg.obj.map b.op (Ffg.obj.map k.op
        (ηg.app (Opposite.op ((smallEtaleBaseChange f).obj U))
          (ηf.app (Opposite.op U) s)))) :=
      congrArg (fun q => e.app (Opposite.op W) (Ffg.obj.map b.op q)) hn
    _ = e.app (Opposite.op W) (Ffg.obj.map (b ≫ k).op
        (ηg.app (Opposite.op ((smallEtaleBaseChange f).obj U))
          (ηf.app (Opposite.op U) s))) := by
      rw [op_comp, Functor.map_comp]
      rfl
    _ = Fp.obj.map (b ≫ k).op (e.app (Opposite.op ((smallEtaleBaseChange g).obj
        ((smallEtaleBaseChange f).obj U)))
        (ηg.app (Opposite.op ((smallEtaleBaseChange f).obj U))
          (ηf.app (Opposite.op U) s))) := NatTrans.naturality_apply e (b ≫ k).op _
    _ = Fp.obj.map (b ≫ k).op (Fp.obj.map c.op (ηp.app (Opposite.op U) s)) := congrArg _ hu
    _ = _ := by
      simp only [op_comp, Functor.map_comp, types_comp_apply]
      rfl

private theorem smallEtaleBaseChange_terminal_hom_ext {X Z : Scheme.{u}}
    (i : Z ⟶ X) {U : Z.Etale}
    (a b : U ⟶ (smallEtaleBaseChange i).obj (terminal X.Etale)) :
    a = b := by
  exact (cancel_mono (PreservesTerminal.iso (smallEtaleBaseChange i)).hom).1
    (terminal.hom_ext _ _)

/-- Global sections of sheaves of sets on the small étale site of a scheme. -/
public abbrev etaleGlobalSections (X : Scheme.{u}) :=
  Sheaf.Γ X.smallEtaleTopology (Type (max (u + 1) v))

private abbrev etaleGlobalEvaluation {X : Scheme.{u}}
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))) :=
  (Sheaf.ΓNatIsoSheafSections X.smallEtaleTopology
    (Type (max (u + 1) v)) terminalIsTerminal).app F

/-- Pullback of a global section of a sheaf of sets on the small étale site along a morphism of
schemes:  the component at `F` of the canonical comparison
`Stacks.EtaleCohomology.globalSectionsSmallEtaleInverseImageComparison`. -/
@[sga "4 XII 6.1.1" "partial"]
public def etaleGlobalPullback {X Y : Scheme.{u}} (f : Y ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))) :
    (etaleGlobalSections X).obj F ⟶
      (etaleGlobalSections Y).obj ((smallEtaleInverseImage f).obj F) :=
  (globalSectionsSmallEtaleInverseImageComparison f).val.app F

private theorem etaleGlobalPullback_evaluation {X Y : Scheme.{u}} (f : Y ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (g : terminal Y.Etale ⟶ (smallEtaleBaseChange f).obj (terminal X.Etale))
    (s : (etaleGlobalSections X).obj F) :
    (etaleGlobalEvaluation _).hom (etaleGlobalPullback f F s) =
      pullbackSection f F g ((etaleGlobalEvaluation F).hom s) := by
  unfold etaleGlobalPullback
  rw [(globalSectionsSmallEtaleInverseImageComparison f).property F g]
  change (etaleGlobalEvaluation _).hom
    ((etaleGlobalEvaluation _).inv
      (pullbackSection f F g ((etaleGlobalEvaluation F).hom s))) = _
  rw [← types_comp_apply, Iso.inv_hom_id]
  rfl

private theorem etaleGlobalEvaluation_map {X : Scheme.{u}}
    {F G : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))}
    (φ : F ⟶ G) (s : (etaleGlobalSections X).obj F) :
    (etaleGlobalEvaluation G).hom ((etaleGlobalSections X).map φ s) =
      φ.hom.app (Opposite.op (terminal X.Etale)) ((etaleGlobalEvaluation F).hom s) := by
  let η := (Sheaf.ΓNatIsoSheafSections X.smallEtaleTopology
    (Type (max (u + 1) v)) terminalIsTerminal).hom
  have h := η.naturality φ
  exact congrArg (fun (a : (etaleGlobalSections X).obj F ⟶
    G.obj.obj (Opposite.op (terminal X.Etale))) => a s) h

private theorem etaleGlobalPullback_comp {X Y Z : Scheme.{u}}
    (f : Y ⟶ X) (g : Z ⟶ Y) (p : Z ⟶ X) (hp : p = g ≫ f)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (s : (etaleGlobalSections X).obj F) :
    (etaleGlobalSections Z).map ((etalePullbackCompIso f g p hp).hom.app F)
      (etaleGlobalPullback g _ (etaleGlobalPullback f F s)) =
      etaleGlobalPullback p F s := by
  obtain ⟨a⟩ := smallEtaleBaseChange_terminal_hom_exists f
  obtain ⟨b⟩ := smallEtaleBaseChange_terminal_hom_exists g
  obtain ⟨c⟩ := smallEtaleBaseChange_terminal_hom_exists p
  apply (ConcreteCategory.bijective_of_isIso (etaleGlobalEvaluation _).hom).1
  rw [etaleGlobalEvaluation_map]
  dsimp only [Functor.comp_obj]
  rw [etaleGlobalPullback_evaluation g _ b, etaleGlobalPullback_evaluation f _ a,
    etaleGlobalPullback_evaluation p _ c]
  refine Eq.trans (etalePullbackCompIso_section f g p hp F a b
    ((etaleGlobalEvaluation F).hom s)) ?_
  congr 1
  exact smallEtaleBaseChange_terminal_hom_ext _ _ _

/-- For `p = g ≫ f`, the canonical map `Γ(Y, f^{-1}F) ⟶ Γ(Z, p^{-1}F)`:  pullback of global
sections along `g`, followed by the composition isomorphism
`Stacks.EtaleCohomology.etalePullbackCompIso`. -/
public def relativeGlobalSectionsMap {X Y Z : Scheme.{u}}
    (f : Y ⟶ X) (g : Z ⟶ Y) (p : Z ⟶ X) (hp : p = g ≫ f)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))) :
    (etaleGlobalSections Y).obj ((smallEtaleInverseImage f).obj F) ⟶
      (etaleGlobalSections Z).obj ((smallEtaleInverseImage p).obj F) :=
  etaleGlobalPullback g _ ≫
    (etaleGlobalSections Z).map ((etalePullbackCompIso f g p hp).hom.app F)

private theorem relativeGlobalSectionsMap_pullback {X Y Z : Scheme.{u}}
    (f : Y ⟶ X) (g : Z ⟶ Y) (p : Z ⟶ X) (hp : p = g ≫ f)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (s : (etaleGlobalSections X).obj F) :
    relativeGlobalSectionsMap f g p hp F (etaleGlobalPullback f F s) =
      etaleGlobalPullback p F s :=
  etaleGlobalPullback_comp f g p hp F s

private theorem etaleGlobalPullback_injective_of_finite_surjective
    {X Y : Scheme.{u}} (f : Y ⟶ X) [IsFinite f] [Surjective f]
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))) :
    Function.Injective (etaleGlobalPullback f F) := by
  obtain ⟨g⟩ := smallEtaleBaseChange_terminal_hom_exists f
  have hi : Function.Injective (fun a => pullbackSection f F g a) := by
    intro a b hab
    refine smallEtale_sheaf_eq_of_locally_eq F a b fun x => ?_
    obtain ⟨y, hy⟩ := f.surjective ((terminal X.Etale).hom x)
    obtain ⟨z, hz⟩ := (etale_terminal_hom_bijective Y).2 y
    obtain ⟨W, k, w, hw, hk⟩ := smallEtale_pullback_eq_near_point f F.obj g a b hab z
    refine ⟨W, k, w, hk, ?_⟩
    apply (etale_terminal_hom_bijective X).1
    rw [hw]
    calc
      (terminal X.Etale).hom (pullback.fst (terminal X.Etale).hom f (g.left z)) =
          f (pullback.snd (terminal X.Etale).hom f (g.left z)) :=
        congrArg (fun q : pullback (terminal X.Etale).hom f ⟶ X => q (g.left z))
          pullback.condition
      _ = f ((terminal Y.Etale).hom z) := congrArg f
        (congrArg (fun q : (terminal Y.Etale).left ⟶ Y => q z) g.w)
      _ = (terminal X.Etale).hom x := by rw [hz, hy]
  intro a b hab
  apply (ConcreteCategory.bijective_of_isIso (etaleGlobalEvaluation F).hom).1
  exact hi (((etaleGlobalPullback_evaluation f F g a).symm.trans
    (congrArg (fun q => (etaleGlobalEvaluation ((smallEtaleInverseImage f).obj F)).hom q)
      hab)).trans (etaleGlobalPullback_evaluation f F g b))

/-! ### Descent of global sections along a finite surjection

The locus on which two sections agree is open, and a finite morphism carries its closed
complement to a closed set. -/

private def sectionEqualityLocus {X : Scheme.{u}}
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (U : X.Etale) (a b : F.obj.obj (Opposite.op U)) : Set U.left :=
  {x | ∃ (V : X.Etale) (k : V ⟶ U) (y : V.left),
    k.left y = x ∧ F.obj.map k.op a = F.obj.map k.op b}

private lemma sectionEqualityLocus_isOpen {X : Scheme.{u}}
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (U : X.Etale) (a b : F.obj.obj (Opposite.op U)) :
    IsOpen (sectionEqualityLocus F U a b) := by
  apply isOpen_iff_forall_mem_open.mpr
  rintro x ⟨V, k, y, hy, hk⟩
  refine ⟨Set.range k.left, ?_, k.left.isOpenMap.isOpen_range, ⟨y, hy⟩⟩
  rintro _ ⟨z, rfl⟩
  exact ⟨V, k, z, rfl, hk⟩

private lemma section_eq_of_range_in_locus {X : Scheme.{u}}
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    {U V : X.Etale} (a b : F.obj.obj (Opposite.op U)) (k : V ⟶ U)
    (h : ∀ y : V.left, k.left y ∈ sectionEqualityLocus F U a b) :
    F.obj.map k.op a = F.obj.map k.op b := by
  refine smallEtale_sheaf_eq_of_locally_eq F _ _ fun y => ?_
  obtain ⟨W, l, z, hz, hl⟩ := h y
  let E := Scheme.Etale.mk (pullback.snd l.left k.left ≫ V.hom)
  let q : E ⟶ V := MorphismProperty.Over.homMk (pullback.snd l.left k.left) rfl
  let r : E ⟶ W := MorphismProperty.Over.homMk (pullback.fst l.left k.left) (by
    change pullback.fst l.left k.left ≫ W.hom = pullback.snd l.left k.left ≫ V.hom
    have hlw : l.left ≫ U.hom = W.hom := l.w
    have hkw : k.left ≫ U.hom = V.hom := k.w
    rw [← hlw, ← hkw, ← Category.assoc, pullback.condition, Category.assoc])
  have he : r ≫ l = q ≫ k := MorphismProperty.Over.Hom.ext pullback.condition
  obtain ⟨w, _, hw⟩ := Scheme.Pullback.exists_preimage_pullback z y hz
  refine ⟨E, q, w, ?_, hw⟩
  change F.obj.map q.op (F.obj.map k.op a) = F.obj.map q.op (F.obj.map k.op b)
  simpa only [← Functor.map_comp_apply, ← op_comp, he] using congrArg (F.obj.map r.op) hl

private lemma pullbackSection_id {X Y : Scheme.{u}} (f : Y ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (U : X.Etale) (a : F.obj.obj (Opposite.op U)) :
    pullbackSection f F (𝟙 ((smallEtaleBaseChange f).obj U)) a =
      ((smallEtaleInverseImageAdjunction.{u, v} f).unit.app F).hom.app (Opposite.op U) a := by
  rw [pullbackSection_eq_unit]
  exact ConcreteCategory.congr_hom
    (((smallEtaleInverseImage f).obj F).obj.map_id
      (Opposite.op ((smallEtaleBaseChange f).obj U))) _

private lemma etaleUnit_injective_of_surjective {X Y : Scheme.{u}}
    (f : Y ⟶ X) [Surjective f]
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))) (U : X.Etale) :
    Function.Injective
      (((smallEtaleInverseImageAdjunction.{u, v} f).unit.app F).hom.app (Opposite.op U)) := by
  intro a b hab
  have h : pullbackSection f F (𝟙 ((smallEtaleBaseChange f).obj U)) a =
      pullbackSection f F (𝟙 ((smallEtaleBaseChange f).obj U)) b :=
    (pullbackSection_id f F U a).trans
      (hab.trans (pullbackSection_id f F U b).symm)
  refine smallEtale_sheaf_eq_of_locally_eq F a b fun x => ?_
  obtain ⟨y, hy⟩ := (pullback.fst U.hom f).surjective x
  obtain ⟨V, k, z, hz, hk⟩ := smallEtale_pullback_eq_near_point f F.obj (𝟙 _) a b h y
  exact ⟨V, k, z, hk, hz.trans hy⟩

/-- Two morphisms of the small étale site of `T` into a base change along `p : T ⟶ S` agree as
soon as their first components agree. -/
private lemma smallEtale_hom_ext_baseChange {T S : Scheme.{u}} (p : T ⟶ S) {A : T.Etale}
    {U : S.Etale} (m m' : A ⟶ (smallEtaleBaseChange p).obj U)
    (h : m.left ≫ pullback.fst U.hom p = m'.left ≫ pullback.fst U.hom p) : m = m' := by
  apply MorphismProperty.Over.Hom.ext
  refine pullback.hom_ext h ?_
  exact (MorphismProperty.Over.w m).trans (MorphismProperty.Over.w m').symm

/-- The structure morphism of a base change, read off along the first projection. -/
private lemma smallEtale_baseChange_fst_comp {W Z : Scheme.{u}} (p : W ⟶ Z)
    {B : Z.Etale} {T : W.Etale} (n : T ⟶ (smallEtaleBaseChange p).obj B) :
    n.left ≫ pullback.fst B.hom p ≫ B.hom = T.hom ≫ p := by
  have c : pullback.fst B.hom p ≫ B.hom = pullback.snd B.hom p ≫ p := pullback.condition
  have e1 : n.left ≫ pullback.fst B.hom p ≫ B.hom =
      n.left ≫ pullback.snd B.hom p ≫ p :=
    congrArg (fun t : Limits.pullback B.hom p ⟶ Z => n.left ≫ t) c
  have e2 : n.left ≫ pullback.fst B.hom p ≫ B.hom =
      (n.left ≫ pullback.snd B.hom p) ≫ p := e1.trans (Category.assoc _ _ _).symm
  exact e2.trans (congrArg (fun t : T.left ⟶ W => t ≫ p) n.w)

/-- The base-change composition isomorphism, followed by the iterated first projection, is the
first projection. -/
private lemma etaleBaseChangeCompIso_hom_app_left_fst_fst {X Y Z : Scheme.{u}}
    (f : Y ⟶ X) (g : Z ⟶ Y) (p : Z ⟶ X) (hp : p = g ≫ f) (U : X.Etale) :
    ((etaleBaseChangeCompIso f g p hp).hom.app U).left ≫
        pullback.fst ((smallEtaleBaseChange f).obj U).hom g ≫
        pullback.fst U.hom f = pullback.fst U.hom p := by
  subst hp
  let : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) f :=
    ⟨fun _ _ ↦ inferInstance⟩
  let : MorphismProperty.HasPullbacksAlong (@Etale : MorphismProperty Scheme.{u}) g :=
    ⟨fun _ _ ↦ inferInstance⟩
  let : MorphismProperty.IsStableUnderBaseChangeAlong
      (@Etale : MorphismProperty Scheme.{u}) f :=
    ⟨fun pb hg ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb hg⟩
  let : MorphismProperty.IsStableUnderBaseChangeAlong
      (@Etale : MorphismProperty Scheme.{u}) g :=
    ⟨fun pb hg ↦ MorphismProperty.IsStableUnderBaseChange.of_isPullback pb hg⟩
  exact MorphismProperty.Over.pullbackComp_left_fst_fst
    (P := (@Etale : MorphismProperty Scheme.{u})) (Q := ⊤) g f U

/-- The first component of the inverse of the base-change composition isomorphism is the iterated
first projection. -/
private lemma etaleBaseChangeCompIso_inv_app_left_fst {X Y Z : Scheme.{u}}
    (f : Y ⟶ X) (g : Z ⟶ Y) (p : Z ⟶ X) (hp : p = g ≫ f) (U : X.Etale) :
    ((etaleBaseChangeCompIso f g p hp).inv.app U).left ≫ pullback.fst U.hom p =
      pullback.fst ((smallEtaleBaseChange f).obj U).hom g ≫ pullback.fst U.hom f := by
  have hiso : ((etaleBaseChangeCompIso f g p hp).inv.app U).left ≫
      ((etaleBaseChangeCompIso f g p hp).hom.app U).left =
      𝟙 ((smallEtaleBaseChange g).obj ((smallEtaleBaseChange f).obj U)).left :=
    congrArg (fun m => m.left) ((etaleBaseChangeCompIso f g p hp).inv_hom_id_app U)
  rw [← etaleBaseChangeCompIso_hom_app_left_fst_fst f g p hp U, reassoc_of% hiso]
  rfl

/-- The two morphisms `V ×_Y (Y ×_X Y) ⟶ X`, through `k` and the first projection of `U ×_X Y`,
and through the first projection of `Y ×_X Y`, agree. -/
private lemma descentComparisonMap_w {X Y : Scheme.{u}} (f : Y ⟶ X)
    (U : X.Etale) (V : Y.Etale) (k : V ⟶ (smallEtaleBaseChange f).obj U) :
    (pullback.fst V.hom (pullback.snd f f) ≫ k.left ≫ pullback.fst U.hom f) ≫
        (U.hom : U.left ⟶ X) =
      (pullback.snd V.hom (pullback.snd f f) ≫ pullback.fst f f) ≫ f := by
  have hc2 : pullback.fst V.hom (pullback.snd f f) ≫ (V.hom : V.left ⟶ Y) =
      pullback.snd V.hom (pullback.snd f f) ≫ pullback.snd f f := pullback.condition
  have hc3 : pullback.fst f f ≫ f = pullback.snd f f ≫ f := pullback.condition
  exact
    calc _ = pullback.fst V.hom (pullback.snd f f) ≫ (k.left ≫ pullback.fst U.hom f) ≫ U.hom :=
          Category.assoc _ _ _
      _ = pullback.fst V.hom (pullback.snd f f) ≫ V.hom ≫ f :=
          congrArg (fun t => pullback.fst V.hom (pullback.snd f f) ≫ t)
            ((Category.assoc _ _ _).trans (smallEtale_baseChange_fst_comp f k))
      _ = (pullback.snd V.hom (pullback.snd f f) ≫ pullback.snd f f) ≫ f :=
          (Category.assoc _ _ _).symm.trans (congrArg (· ≫ f) hc2)
      _ = _ := (Category.assoc _ _ _).trans
          ((congrArg (pullback.snd V.hom (pullback.snd f f) ≫ ·) hc3.symm).trans
            (Category.assoc _ _ _).symm)

/-- **The descent comparison morphism.**  For `k : V ⟶ U ×_X Y` in the small étale site of `Y`,
the morphism of the small étale site of `Y ×_X Y` from the base change of `V` along the second
projection to the base change along the first projection of `U ×_X Y`, built from the universal
property of the two fibre products. -/
private def descentComparisonMap {X Y : Scheme.{u}} (f : Y ⟶ X)
    (U : X.Etale) (V : Y.Etale)
    (k : V ⟶ (smallEtaleBaseChange f).obj U) :
    (smallEtaleBaseChange (pullback.snd f f)).obj V ⟶
      (smallEtaleBaseChange (pullback.fst f f)).obj
        ((smallEtaleBaseChange f).obj U) :=
  MorphismProperty.Over.homMk
    (pullback.lift
      (pullback.lift
        (pullback.fst V.hom (pullback.snd f f) ≫ k.left ≫ pullback.fst U.hom f)
        (pullback.snd V.hom (pullback.snd f f) ≫ pullback.fst f f)
        (descentComparisonMap_w f U V k))
      (pullback.snd V.hom (pullback.snd f f)) (pullback.lift_snd _ _ _))
    (pullback.lift_snd _ _ _)

/-- The first component of the descent comparison morphism. -/
private lemma descentComparisonMap_left_fst {X Y : Scheme.{u}} (f : Y ⟶ X)
    (U : X.Etale) (V : Y.Etale) (k : V ⟶ (smallEtaleBaseChange f).obj U) :
    (descentComparisonMap f U V k).left ≫
        pullback.fst ((smallEtaleBaseChange f).obj U).hom (pullback.fst f f) =
      pullback.lift
        (pullback.fst V.hom (pullback.snd f f) ≫ k.left ≫ pullback.fst U.hom f)
        (pullback.snd V.hom (pullback.snd f f) ≫ pullback.fst f f)
        (descentComparisonMap_w f U V k) :=
  pullback.lift_fst _ _ _

private lemma descentComparisonMap_square {X Y : Scheme.{u}} (f : Y ⟶ X)
    (U : X.Etale) (V : Y.Etale)
    (k : V ⟶ (smallEtaleBaseChange f).obj U) :
    (𝟙 _) ≫ (smallEtaleBaseChange (pullback.snd f f)).map k ≫
        (etaleBaseChangeCompIso f (pullback.snd f f)
          (pullback.fst f f ≫ f) pullback.condition).inv.app U =
      descentComparisonMap f U V k ≫
        (smallEtaleBaseChange (pullback.fst f f)).map (𝟙 _) ≫
        (etaleBaseChangeCompIso f (pullback.fst f f)
          (pullback.fst f f ≫ f) rfl).inv.app U := by
  have hmap : (smallEtaleBaseChange (pullback.fst f f)).map
      (𝟙 ((smallEtaleBaseChange f).obj U)) = 𝟙 _ :=
    (smallEtaleBaseChange (pullback.fst f f)).map_id _
  rw [hmap]
  simp only [Category.id_comp]
  have hk : ((smallEtaleBaseChange (pullback.snd f f)).map k).left ≫
      pullback.fst ((smallEtaleBaseChange f).obj U).hom (pullback.snd f f) =
      pullback.fst V.hom (pullback.snd f f) ≫ k.left := pullback.lift_fst _ _ _
  have hL := etaleBaseChangeCompIso_inv_app_left_fst f (pullback.snd f f)
    (pullback.fst f f ≫ f) pullback.condition U
  have hR := etaleBaseChangeCompIso_inv_app_left_fst f (pullback.fst f f)
    (pullback.fst f f ≫ f) rfl U
  have hk2 : (((smallEtaleBaseChange (pullback.snd f f)).map k).left ≫
        pullback.fst ((smallEtaleBaseChange f).obj U).hom (pullback.snd f f)) ≫
          pullback.fst U.hom f =
      (pullback.fst V.hom (pullback.snd f f) ≫ k.left) ≫ pullback.fst U.hom f :=
    congrArg (fun t => t ≫ pullback.fst U.hom f) hk
  have hd2 : pullback.lift
        (pullback.fst V.hom (pullback.snd f f) ≫ k.left ≫ pullback.fst U.hom f)
        (pullback.snd V.hom (pullback.snd f f) ≫ pullback.fst f f)
        (descentComparisonMap_w f U V k) ≫ pullback.fst U.hom f =
      ((descentComparisonMap f U V k).left ≫
        pullback.fst ((smallEtaleBaseChange f).obj U).hom (pullback.fst f f)) ≫
          pullback.fst U.hom f :=
    congrArg (fun t => t ≫ pullback.fst U.hom f)
      (descentComparisonMap_left_fst f U V k).symm
  have e1 : ((smallEtaleBaseChange (pullback.snd f f)).map k ≫
      (etaleBaseChangeCompIso f (pullback.snd f f)
        (pullback.fst f f ≫ f) pullback.condition).inv.app U).left ≫
          pullback.fst U.hom (pullback.fst f f ≫ f) =
      ((smallEtaleBaseChange (pullback.snd f f)).map k).left ≫
        ((etaleBaseChangeCompIso f (pullback.snd f f)
          (pullback.fst f f ≫ f) pullback.condition).inv.app U).left ≫
          pullback.fst U.hom (pullback.fst f f ≫ f) :=
    Category.assoc _ _ _
  have e2 : ((smallEtaleBaseChange (pullback.snd f f)).map k ≫
      (etaleBaseChangeCompIso f (pullback.snd f f)
        (pullback.fst f f ≫ f) pullback.condition).inv.app U).left ≫
          pullback.fst U.hom (pullback.fst f f ≫ f) =
      ((smallEtaleBaseChange (pullback.snd f f)).map k).left ≫
        pullback.fst ((smallEtaleBaseChange f).obj U).hom (pullback.snd f f) ≫
          pullback.fst U.hom f :=
    e1.trans (congrArg (fun t => ((smallEtaleBaseChange (pullback.snd f f)).map k).left ≫ t) hL)
  have e3 : ((smallEtaleBaseChange (pullback.snd f f)).map k ≫
      (etaleBaseChangeCompIso f (pullback.snd f f)
        (pullback.fst f f ≫ f) pullback.condition).inv.app U).left ≫
          pullback.fst U.hom (pullback.fst f f ≫ f) =
      (((smallEtaleBaseChange (pullback.snd f f)).map k).left ≫
        pullback.fst ((smallEtaleBaseChange f).obj U).hom (pullback.snd f f)) ≫
          pullback.fst U.hom f :=
    e2.trans (Category.assoc _ _ _).symm
  have e4 : ((smallEtaleBaseChange (pullback.snd f f)).map k ≫
      (etaleBaseChangeCompIso f (pullback.snd f f)
        (pullback.fst f f ≫ f) pullback.condition).inv.app U).left ≫
          pullback.fst U.hom (pullback.fst f f ≫ f) =
      (pullback.fst V.hom (pullback.snd f f) ≫ k.left) ≫ pullback.fst U.hom f :=
    e3.trans hk2
  have e5 : ((smallEtaleBaseChange (pullback.snd f f)).map k ≫
      (etaleBaseChangeCompIso f (pullback.snd f f)
        (pullback.fst f f ≫ f) pullback.condition).inv.app U).left ≫
          pullback.fst U.hom (pullback.fst f f ≫ f) =
      pullback.fst V.hom (pullback.snd f f) ≫ k.left ≫ pullback.fst U.hom f :=
    e4.trans (Category.assoc _ _ _)
  have e6 : ((smallEtaleBaseChange (pullback.snd f f)).map k ≫
      (etaleBaseChangeCompIso f (pullback.snd f f)
        (pullback.fst f f ≫ f) pullback.condition).inv.app U).left ≫
          pullback.fst U.hom (pullback.fst f f ≫ f) =
      pullback.lift
      (pullback.fst V.hom (pullback.snd f f) ≫ k.left ≫ pullback.fst U.hom f)
      (pullback.snd V.hom (pullback.snd f f) ≫ pullback.fst f f)
      (descentComparisonMap_w f U V k) ≫ pullback.fst U.hom f :=
    e5.trans (pullback.lift_fst _ _ _).symm
  have e7 : ((smallEtaleBaseChange (pullback.snd f f)).map k ≫
      (etaleBaseChangeCompIso f (pullback.snd f f)
        (pullback.fst f f ≫ f) pullback.condition).inv.app U).left ≫
          pullback.fst U.hom (pullback.fst f f ≫ f) =
      ((descentComparisonMap f U V k).left ≫
        pullback.fst ((smallEtaleBaseChange f).obj U).hom (pullback.fst f f)) ≫
          pullback.fst U.hom f :=
    e6.trans hd2
  have e8 : ((smallEtaleBaseChange (pullback.snd f f)).map k ≫
      (etaleBaseChangeCompIso f (pullback.snd f f)
        (pullback.fst f f ≫ f) pullback.condition).inv.app U).left ≫
          pullback.fst U.hom (pullback.fst f f ≫ f) =
      (descentComparisonMap f U V k).left ≫
        pullback.fst ((smallEtaleBaseChange f).obj U).hom (pullback.fst f f) ≫
          pullback.fst U.hom f :=
    e7.trans (Category.assoc _ _ _)
  have e9 : ((smallEtaleBaseChange (pullback.snd f f)).map k ≫
      (etaleBaseChangeCompIso f (pullback.snd f f)
        (pullback.fst f f ≫ f) pullback.condition).inv.app U).left ≫
          pullback.fst U.hom (pullback.fst f f ≫ f) =
      (descentComparisonMap f U V k).left ≫ ((etaleBaseChangeCompIso f (pullback.fst f f)
      (pullback.fst f f ≫ f) rfl).inv.app U).left ≫
        pullback.fst U.hom (pullback.fst f f ≫ f) :=
    e8.trans (congrArg (fun t => (descentComparisonMap f U V k).left ≫ t) hR.symm)
  have e10 : ((smallEtaleBaseChange (pullback.snd f f)).map k ≫
      (etaleBaseChangeCompIso f (pullback.snd f f)
        (pullback.fst f f ≫ f) pullback.condition).inv.app U).left ≫
          pullback.fst U.hom (pullback.fst f f ≫ f) =
      (descentComparisonMap f U V k ≫
      (etaleBaseChangeCompIso f (pullback.fst f f)
        (pullback.fst f f ≫ f) rfl).inv.app U).left ≫
          pullback.fst U.hom (pullback.fst f f ≫ f) :=
    e9.trans (Category.assoc _ _ _).symm
  exact smallEtale_hom_ext_baseChange (pullback.fst f f ≫ f) _ _ e10

private lemma descentComparisonMap_covers_fiber {X Y : Scheme.{u}} (f : Y ⟶ X)
    (U : X.Etale) (V : Y.Etale)
    (k : V ⟶ (smallEtaleBaseChange f).obj U)
    (v : V.left) (z : ((smallEtaleBaseChange f).obj U).left)
    (hz : pullback.fst U.hom f z = pullback.fst U.hom f (k.left v)) :
    ∃ w : ((smallEtaleBaseChange (pullback.snd f f)).obj V).left,
      pullback.fst ((smallEtaleBaseChange f).obj U).hom (pullback.fst f f)
        ((descentComparisonMap f U V k).left w) = z := by
  let q := pullback.fst U.hom f
  let P := pullback q (k.left ≫ q)
  let a : P ⟶ pullback U.hom f := pullback.fst q (k.left ≫ q)
  let b : P ⟶ V.left := pullback.snd q (k.left ≫ q)
  have hc1 : pullback.fst U.hom f ≫ (U.hom : U.left ⟶ X) = pullback.snd U.hom f ≫ f :=
    pullback.condition
  have hc2 : a ≫ q = b ≫ k.left ≫ q := pullback.condition
  have hab : (a ≫ pullback.snd U.hom f) ≫ f = (b ≫ V.hom) ≫ f :=
    calc (a ≫ pullback.snd U.hom f) ≫ f = a ≫ pullback.fst U.hom f ≫ U.hom :=
          (Category.assoc _ _ _).trans (congrArg (a ≫ ·) hc1.symm)
      _ = (b ≫ k.left ≫ pullback.fst U.hom f) ≫ U.hom :=
          (Category.assoc _ _ _).symm.trans (congrArg (· ≫ (U.hom : U.left ⟶ X)) hc2)
      _ = b ≫ V.hom ≫ f := (Category.assoc _ _ _).trans
          (congrArg (b ≫ ·) ((Category.assoc _ _ _).trans (smallEtale_baseChange_fst_comp f k)))
      _ = (b ≫ V.hom) ≫ f := (Category.assoc _ _ _).symm
  let r : P ⟶ pullback f f := pullback.lift (a ≫ pullback.snd U.hom f) (b ≫ V.hom) hab
  let l : P ⟶ pullback V.hom (pullback.snd f f) :=
    pullback.lift b r (pullback.lift_snd _ _ _).symm
  have hl : l ≫ (descentComparisonMap f U V k).left ≫
      pullback.fst ((smallEtaleBaseChange f).obj U).hom (pullback.fst f f) = a := by
    refine (congrArg (fun t => l ≫ t)
      (descentComparisonMap_left_fst f U V k)).trans (pullback.hom_ext ?_ ?_)
    · calc (l ≫ pullback.lift
              (pullback.fst V.hom (pullback.snd f f) ≫ k.left ≫ pullback.fst U.hom f)
              (pullback.snd V.hom (pullback.snd f f) ≫ pullback.fst f f)
              (descentComparisonMap_w f U V k)) ≫ pullback.fst U.hom f
          = l ≫ pullback.lift
              (pullback.fst V.hom (pullback.snd f f) ≫ k.left ≫ pullback.fst U.hom f)
              (pullback.snd V.hom (pullback.snd f f) ≫ pullback.fst f f)
              (descentComparisonMap_w f U V k) ≫ pullback.fst U.hom f :=
            Category.assoc _ _ _
        _ = l ≫ pullback.fst V.hom (pullback.snd f f) ≫ k.left ≫ pullback.fst U.hom f :=
            congrArg (fun t => l ≫ t) (pullback.lift_fst _ _ _)
        _ = (l ≫ pullback.fst V.hom (pullback.snd f f)) ≫ k.left ≫ pullback.fst U.hom f :=
            (Category.assoc _ _ _).symm
        _ = b ≫ k.left ≫ pullback.fst U.hom f :=
            congrArg (fun t => t ≫ k.left ≫ pullback.fst U.hom f)
              (pullback.lift_fst b r (pullback.lift_snd _ _ _).symm)
        _ = a ≫ pullback.fst U.hom f := hc2.symm
    · calc (l ≫ pullback.lift
              (pullback.fst V.hom (pullback.snd f f) ≫ k.left ≫ pullback.fst U.hom f)
              (pullback.snd V.hom (pullback.snd f f) ≫ pullback.fst f f)
              (descentComparisonMap_w f U V k)) ≫ pullback.snd U.hom f
          = l ≫ pullback.lift
              (pullback.fst V.hom (pullback.snd f f) ≫ k.left ≫ pullback.fst U.hom f)
              (pullback.snd V.hom (pullback.snd f f) ≫ pullback.fst f f)
              (descentComparisonMap_w f U V k) ≫ pullback.snd U.hom f :=
            Category.assoc _ _ _
        _ = l ≫ pullback.snd V.hom (pullback.snd f f) ≫ pullback.fst f f :=
            congrArg (fun t => l ≫ t) (pullback.lift_snd _ _ _)
        _ = (l ≫ pullback.snd V.hom (pullback.snd f f)) ≫ pullback.fst f f :=
            (Category.assoc _ _ _).symm
        _ = r ≫ pullback.fst f f :=
            congrArg (fun t => t ≫ pullback.fst f f)
              (pullback.lift_snd b r (pullback.lift_snd _ _ _).symm)
        _ = a ≫ pullback.snd U.hom f := pullback.lift_fst _ _ _
  obtain ⟨w, hw, _⟩ := Scheme.Pullback.exists_preimage_pullback (f := q) (g := k.left ≫ q) z v hz
  exact ⟨l w, (congrArg (fun h : P ⟶ pullback U.hom f => h w) hl).trans hw⟩

private abbrev globalSectionAt {X : Scheme.{u}}
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (U : X.Etale) (s : (etaleGlobalSections X).obj F) :=
  F.obj.map (terminal.from U).op ((etaleGlobalEvaluation F).hom s)

private lemma globalSectionAt_restrict {X : Scheme.{u}}
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    {U V : X.Etale} (k : V ⟶ U) (s : (etaleGlobalSections X).obj F) :
    F.obj.map k.op (globalSectionAt F U s) = globalSectionAt F V s := by
  simp only [globalSectionAt, ← Functor.map_comp_apply, ← op_comp, terminal.comp_from]

private lemma globalSectionAt_map {X : Scheme.{u}}
    {F G : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))}
    (φ : F ⟶ G) (U : X.Etale) (s : (etaleGlobalSections X).obj F) :
    globalSectionAt G U ((etaleGlobalSections X).map φ s) =
      φ.hom.app (Opposite.op U) (globalSectionAt F U s) := by
  dsimp only [globalSectionAt]
  rw [etaleGlobalEvaluation_map]
  exact (NatTrans.naturality_apply φ.hom (terminal.from U).op _).symm

private lemma globalSectionAt_pullback {X Y : Scheme.{u}} (f : Y ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    {U : X.Etale} {V : Y.Etale}
    (k : V ⟶ (smallEtaleBaseChange f).obj U)
    (s : (etaleGlobalSections X).obj F) :
    globalSectionAt _ V (etaleGlobalPullback f F s) =
      pullbackSection f F k (globalSectionAt F U s) := by
  obtain ⟨g⟩ := smallEtaleBaseChange_terminal_hom_exists f
  dsimp only [globalSectionAt]
  rw [etaleGlobalPullback_evaluation f F g, pullbackSection_map, pullbackSection_restrict]
  congr 1
  exact smallEtaleBaseChange_terminal_hom_ext _ _ _

private lemma descent_eq_near_fiber {X Y : Scheme.{u}} (f : Y ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (s : (etaleGlobalSections Y).obj ((smallEtaleInverseImage f).obj F))
    (hs : relativeGlobalSectionsMap f (pullback.fst f f) (pullback.fst f f ≫ f) rfl F s =
      relativeGlobalSectionsMap f (pullback.snd f f) (pullback.fst f f ≫ f)
        pullback.condition F s)
    (U : X.Etale) (V : Y.Etale)
    (k : V ⟶ (smallEtaleBaseChange f).obj U)
    (a : F.obj.obj (Opposite.op U))
    (ha : pullbackSection f F k a = globalSectionAt _ V s)
    (v : V.left) (z : ((smallEtaleBaseChange f).obj U).left)
    (hz : pullback.fst U.hom f z = pullback.fst U.hom f (k.left v)) :
    z ∈ sectionEqualityLocus ((smallEtaleInverseImage f).obj F)
      ((smallEtaleBaseChange f).obj U)
      (pullbackSection f F (𝟙 _) a) (globalSectionAt _ _ s) := by
  let G := (smallEtaleInverseImage f).obj F
  let W := (smallEtaleBaseChange (pullback.snd f f)).obj V
  let d := descentComparisonMap f U V k
  let e₀ := etalePullbackCompIso.{u, v} f (pullback.fst f f) (pullback.fst f f ≫ f) rfl
  have h := congrArg (globalSectionAt _ W) hs
  dsimp only [relativeGlobalSectionsMap, types_comp_apply] at h
  rw [globalSectionAt_map, globalSectionAt_map,
    globalSectionAt_pullback _ _ d, globalSectionAt_pullback _ _ (𝟙 W), ← ha] at h
  have hsec₀ := etalePullbackCompIso_section f (pullback.fst f f)
    (pullback.fst f f ≫ f) rfl F (𝟙 _) d a
  have hsec₁ := etalePullbackCompIso_section f (pullback.snd f f)
    (pullback.fst f f ≫ f) pullback.condition F k (𝟙 W) a
  have he : pullbackSection (pullback.fst f f) G d
      (pullbackSection f F (𝟙 _) a) =
      pullbackSection (pullback.fst f f) G d (globalSectionAt G _ s) := by
    apply (ConcreteCategory.bijective_of_isIso
      ((e₀.hom.app F).hom.app (Opposite.op W))).1
    exact hsec₀.trans ((congrArg (fun q => pullbackSection (pullback.fst f f ≫ f) F q a)
      (descentComparisonMap_square f U V k).symm).trans (hsec₁.symm.trans h.symm))
  obtain ⟨w, hw⟩ := descentComparisonMap_covers_fiber f U V k v z hz
  obtain ⟨T, l, t, ht, hl⟩ := smallEtale_pullback_eq_near_point (pullback.fst f f)
    G.obj d (pullbackSection f F (𝟙 _) a) (globalSectionAt G _ s) he w
  exact ⟨T, l, t, ht.trans hw, hl⟩

private lemma finiteDescent_local_lift {X Y : Scheme.{u}} (f : Y ⟶ X) [IsFinite f]
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (s : (etaleGlobalSections Y).obj ((smallEtaleInverseImage f).obj F))
    (hs : relativeGlobalSectionsMap f (pullback.fst f f) (pullback.fst f f ≫ f) rfl F s =
      relativeGlobalSectionsMap f (pullback.snd f f) (pullback.fst f f ≫ f)
        pullback.condition F s)
    (U : X.Etale) (V : Y.Etale)
    (k : V ⟶ (smallEtaleBaseChange f).obj U)
    (a : F.obj.obj (Opposite.op U))
    (ha : pullbackSection f F k a = globalSectionAt _ V s) (v : V.left) :
    ∃ (U' : X.Etale) (a' : F.obj.obj (Opposite.op U')) (x : U'.left),
      U'.hom x = f (V.hom v) ∧
        ((smallEtaleInverseImageAdjunction.{u, v} f).unit.app F).hom.app (Opposite.op U') a' =
          globalSectionAt _ ((smallEtaleBaseChange f).obj U') s := by
  let B := smallEtaleBaseChange f
  let G := (smallEtaleInverseImage f).obj F
  let q := pullback.fst U.hom f
  let L := sectionEqualityLocus G (B.obj U)
    (pullbackSection f F (𝟙 _) a) (globalSectionAt G (B.obj U) s)
  have hL : IsOpen L := sectionEqualityLocus_isOpen _ _ _ _
  let O : U.left.Opens := ⟨(q '' Lᶜ)ᶜ, (q.isClosedMap _ hL.isClosed_compl).isOpen_compl⟩
  have hu : q (k.left v) ∈ O := by
    rintro ⟨z, hz, he⟩
    exact hz (descent_eq_near_fiber f F s hs U V k a ha v z he)
  let U' : X.Etale := Scheme.Etale.mk (O.ι ≫ U.hom)
  let j : U' ⟶ U := MorphismProperty.Over.homMk O.ι rfl
  have hj : ∀ z : (B.obj U').left, (B.map j).left z ∈ L := by
    intro z
    by_contra hn
    have he : q ((B.map j).left z) = O.ι (pullback.fst U'.hom f z) :=
      congrArg (fun h : (B.obj U').left ⟶ U.left => h z)
        (show (B.map j).left ≫ q = pullback.fst U'.hom f ≫ O.ι from pullback.lift_fst _ _ _)
    exact (pullback.fst U'.hom f z).property ⟨(B.map j).left z, hn, he⟩
  have he := section_eq_of_range_in_locus G
    (pullbackSection f F (𝟙 _) a) (globalSectionAt G (B.obj U) s) (B.map j) hj
  refine ⟨U', F.obj.map j.op a, ⟨q (k.left v), hu⟩, ?_, ?_⟩
  · change U.hom (q (k.left v)) = f (V.hom v)
    have hk : k.left ≫ pullback.snd U.hom f = V.hom := k.w
    exact (congrArg (fun h : (B.obj U).left ⟶ X => h (k.left v))
      pullback.condition).trans (congrArg f
        (congrArg (fun h : V.left ⟶ Y => h v) hk))
  · have hl : pullbackSection f F (𝟙 (B.obj U')) (F.obj.map j.op a) =
        G.obj.map (B.map j).op (pullbackSection f F (𝟙 (B.obj U)) a) := by
      rw [pullbackSection_restrict, pullbackSection_map]
      simp only [Category.id_comp, Category.comp_id]
      rfl
    rw [globalSectionAt_restrict] at he
    exact (pullbackSection_id f F U' (F.obj.map j.op a)).symm.trans (hl.trans he)

private theorem finiteDescent_globalSection
    {X Y : Scheme.{u}} (f : Y ⟶ X) [IsFinite f] [Surjective f]
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (s : (etaleGlobalSections Y).obj ((smallEtaleInverseImage f).obj F))
    (hs : relativeGlobalSectionsMap f (pullback.fst f f) (pullback.fst f f ≫ f) rfl F s =
      relativeGlobalSectionsMap f (pullback.snd f f) (pullback.fst f f ≫ f)
        pullback.condition F s) :
    ∃ t : (etaleGlobalSections X).obj F, etaleGlobalPullback f F t = s := by
  let B := smallEtaleBaseChange f
  let G := (smallEtaleInverseImage f).obj F
  let η := (smallEtaleInverseImageAdjunction.{u, v} f).unit.app F
  let t := globalSectionAt G (B.obj (terminal X.Etale)) s
  have ht : Presheaf.imageSieve η.hom t ∈ X.smallEtaleTopology (terminal X.Etale) := by
    apply (smallEtale_sieve_mem_iff _).2
    intro x
    obtain ⟨y, hy⟩ := f.surjective ((terminal X.Etale).hom x)
    obtain ⟨I, V, U, a, k, ha, hc⟩ := smallEtaleGlobalSection_has_lifting_family f F
      ((etaleGlobalEvaluation G).hom s)
    obtain ⟨j, v, hv⟩ := hc y
    obtain ⟨U', a', z, hz, he⟩ := finiteDescent_local_lift f F s hs
      (U j) (V j) (k j) (a j) (ha j) v
    refine ⟨U', terminal.from U', z, ⟨a', ?_⟩, ?_⟩
    · change η.hom.app (Opposite.op U') a' =
        G.obj.map (B.map (terminal.from U')).op t
      exact he.trans (globalSectionAt_restrict G _ s).symm
    · apply (etale_terminal_hom_bijective X).1
      have hw : (terminal.from U').left ≫ (terminal X.Etale).hom = U'.hom :=
        (terminal.from U').w
      exact (congrArg (fun h : U'.left ⟶ X => h z) hw).trans
        (hz.trans ((congrArg f hv).trans hy))
  obtain ⟨a, ha⟩ := sheaf_section_lifts_of_imageSieve_mem η
    (fun U => etaleUnit_injective_of_surjective f F U.unop) t ht
  obtain ⟨a₀, ha₀⟩ := (ConcreteCategory.bijective_of_isIso (etaleGlobalEvaluation F).hom).2 a
  refine ⟨a₀, ?_⟩
  apply (ConcreteCategory.bijective_of_isIso (etaleGlobalEvaluation G).hom).1
  obtain ⟨g⟩ := smallEtaleBaseChange_terminal_hom_exists f
  rw [etaleGlobalPullback_evaluation f F g, ha₀, pullbackSection_eq_unit]
  change G.obj.map g.op (η.hom.app (Opposite.op (terminal X.Etale)) a) = _
  have ha' : η.hom.app (Opposite.op (terminal X.Etale)) a = t := ha
  have he := globalSectionAt_restrict G g s
  have he' := (congrArg (G.obj.map g.op) ha').trans he
  have hterm : terminal.from (terminal Y.Etale) = 𝟙 _ := terminal.hom_ext _ _
  dsimp only [globalSectionAt] at he'
  rw [hterm] at he'
  exact he'.trans (ConcreteCategory.congr_hom (G.obj.map_id _) _)

/-! ### The equalizer presentation of global sections -/

/-- **[Stacks, Tag 09Z3].**  Let `f : X ⟶ Y` be a finite surjective morphism of schemes and let
`𝒢` be a sheaf of sets on the small étale site of `Y`.  The first two levels of the Čech nerve of
`f` are `X₀ = X` with `f₀ = f`, and `X₁ = X ×_Y X` with `f₁ = pr₀ ≫ f = pr₁ ≫ f`.  Then

`Γ(Y, 𝒢) = Equalizer (Γ(X₀, f₀⁻¹𝒢) ⇉ Γ(X₁, f₁⁻¹𝒢))`:

the canonical comparison `Γ(Y, 𝒢) ⟶ Γ(X₀, f₀⁻¹𝒢)` on global sections is injective, and a
section of `f₀⁻¹𝒢` over `X₀` is in its image exactly when its two pullbacks to `X₁` agree.

The comparison is `Stacks.EtaleCohomology.etaleGlobalPullback`, which is by definition the
component at `𝒢` of
`Stacks.EtaleCohomology.globalSectionsSmallEtaleInverseImageComparison`;  the two parallel
arrows are the two instances of `Stacks.EtaleCohomology.relativeGlobalSectionsMap` attached to
the two factorizations `f₁ = pr₀ ≫ f` and `f₁ = pr₁ ≫ f` of the structure morphism of `X₁`. -/
@[stacks 09Z3 "the displayed equality `Γ(Y, 𝒢) = Equalizer (Γ(X₀, f₀⁻¹𝒢) ⇉ Γ(X₁, f₁⁻¹𝒢))`, for a
finite surjective `f : X ⟶ Y` and a sheaf of sets `𝒢` on the small étale site of `Y`, with
`X₀ = X`, `f₀ = f`, `X₁ = X ×_Y X` and `f₁` the structure morphism of `X₁`:  the canonical
comparison on global sections is injective with image exactly the equalizer",
  sga "1 XIII 1.11" "partial"]
public theorem globalSectionsPullback_isEqualizer_of_isFinite_surjective
    {X Y : Scheme.{u}} (f : X ⟶ Y) [IsFinite f] [Surjective f]
    (G : Sheaf (Scheme.smallEtaleTopology Y) (Type (max (u + 1) v))) :
    Function.Injective (etaleGlobalPullback f G) ∧
      ∀ t : (etaleGlobalSections X).obj ((smallEtaleInverseImage.{u, v} f).obj G),
        relativeGlobalSectionsMap f (pullback.fst f f) (pullback.fst f f ≫ f) rfl G t =
            relativeGlobalSectionsMap f (pullback.snd f f) (pullback.fst f f ≫ f)
              pullback.condition G t ↔
          ∃ s : (etaleGlobalSections Y).obj G, etaleGlobalPullback f G s = t := by
  refine ⟨etaleGlobalPullback_injective_of_finite_surjective.{u, v} f G, fun t ↦ ⟨?_, ?_⟩⟩
  · exact finiteDescent_globalSection.{u, v} f G t
  · rintro ⟨s, rfl⟩
    have h₀ := relativeGlobalSectionsMap_pullback.{u, v} f (pullback.fst f f)
      (pullback.fst f f ≫ f) rfl G s
    have h₁ := relativeGlobalSectionsMap_pullback.{u, v} f (pullback.snd f f)
      (pullback.fst f f ≫ f) pullback.condition G s
    exact h₀.trans h₁.symm

/-- **[Stacks, Tag 09Z3], the canonical comparison named.**  The fork map of the equalizer
presentation is the component at `𝒢` of
`Stacks.EtaleCohomology.globalSectionsSmallEtaleInverseImageComparison`. -/
public theorem etaleGlobalPullback_eq_globalSectionsComparison_app {X Y : Scheme.{u}}
    (f : X ⟶ Y) (G : Sheaf (Scheme.smallEtaleTopology Y) (Type (max (u + 1) v))) :
    etaleGlobalPullback f G =
      (globalSectionsSmallEtaleInverseImageComparison.{u, v} f).val.app G := rfl

/-! ### Gabber's comparison of global sections along a closed immersion -/

private theorem opensToEtale_representablyFlat (X : Scheme.{u}) :
    RepresentablyFlat (AlgebraicGeometry.opensToEtale X) := by
  refine ⟨fun V => ?_⟩
  let O : X.Opens := ⟨Set.range V.hom, V.hom.isOpenMap.isOpen_range⟩
  have hOi : IsOpenImmersion O.ι := O.instIsOpenImmersionι
  let k : V ⟶ (AlgebraicGeometry.opensToEtale X).obj O :=
    MorphismProperty.Over.homMk
      (IsOpenImmersion.lift (H := hOi) O.ι V.hom (by
        rintro x ⟨y, rfl⟩
        exact ⟨⟨V.hom y, ⟨y, rfl⟩⟩, rfl⟩))
      (IsOpenImmersion.lift_fac (H := hOi) _ _ _)
  let c : StructuredArrow V (AlgebraicGeometry.opensToEtale X) := StructuredArrow.mk k
  have hc : IsInitial c := by
    refine IsInitial.ofUniqueHom (fun d => ?_) (fun d f => ?_)
    · have hO : O ≤ d.right := by
        rintro x ⟨y, rfl⟩
        have hy := congrArg (fun f : V.left ⟶ X => f y) d.hom.w
        change d.right.ι (d.hom.left y) = V.hom y at hy
        rw [← hy]
        exact (d.hom.left y).property
      refine StructuredArrow.homMk (f := c) (f' := d) (homOfLE hO) ?_
      apply MorphismProperty.Over.Hom.ext
      apply (cancel_mono d.right.ι).1
      change (k.left ≫ X.homOfLE hO) ≫ d.right.ι = d.hom.left ≫ d.right.ι
      have e1 : (k.left ≫ X.homOfLE hO) ≫ d.right.ι =
          k.left ≫ X.homOfLE hO ≫ d.right.ι := Category.assoc _ _ _
      have e2 : (k.left ≫ X.homOfLE hO) ≫ d.right.ι = k.left ≫ O.ι :=
        e1.trans (congrArg (fun t : O.toScheme ⟶ X => k.left ≫ t) (X.homOfLE_ι hO))
      exact (e2.trans k.w).trans d.hom.w.symm
    · apply StructuredArrow.hom_ext
      apply Subsingleton.elim
  exact IsCofiltered.of_isInitial _ hc

private theorem opensToEtale_coverPreserving (X : Scheme.{u}) :
    CoverPreserving (Opens.grothendieckTopology X.carrier) X.smallEtaleTopology
      (AlgebraicGeometry.opensToEtale X) := by
  constructor
  intro U S hS
  apply (smallEtale_sieve_mem_iff _).2
  intro x
  obtain ⟨V, f, hf, hx⟩ := hS x.val x.property
  refine ⟨(AlgebraicGeometry.opensToEtale X).obj V,
    (AlgebraicGeometry.opensToEtale X).map f, ⟨x.val, hx⟩, ?_, ?_⟩
  · exact ⟨V, f, 𝟙 _, hf, by simp⟩
  · exact Subtype.ext (Scheme.homOfLE_apply f.le ⟨x.val, hx⟩)

private theorem opensToEtale_isContinuous (X : Scheme.{u}) :
    (AlgebraicGeometry.opensToEtale X).IsContinuous
      (Opens.grothendieckTopology X.carrier) X.smallEtaleTopology := by
  let := opensToEtale_representablyFlat X
  exact (Functor.isContinuous_iff_coverPreserving).2 (opensToEtale_coverPreserving X)

private def etaleZariskiRestriction {X : Scheme.{u}}
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))) :
    Sheaf (Opens.grothendieckTopology X.carrier) (Type (max (u + 1) v)) := by
  let := opensToEtale_isContinuous X
  exact ((AlgebraicGeometry.opensToEtale X).sheafPushforwardContinuous
    (Type (max (u + 1) v)) (Opens.grothendieckTopology X.carrier)
      X.smallEtaleTopology).obj F

private theorem zarSections_force_meeting_closed_set
    {X Z : Scheme.{u}} (i : Z ⟶ X)
    (hZar : ∀ F : Sheaf (Opens.grothendieckTopology X.carrier)
      (Type u),
      Function.Bijective (zariskiGlobalSectionsMapAt i F))
    (T : Set X.carrier) (hT : IsClosed T) (hne : T.Nonempty)
    (hdisj : ∀ z : Z.carrier, i.base z ∉ T) : False := by
  let U : Opens X.carrier := ⟨Tᶜ, hT.isOpen_compl⟩
  let JX := Opens.grothendieckTopology X.carrier
  let JZ := Opens.grothendieckTopology Z.carrier
  let P0 := uliftYoneda.{u}.obj U
  let F : Sheaf JX (Type u) :=
    (presheafToSheaf JX (Type u)).obj P0
  have hempty : ∀ s : F.obj.obj (Opposite.op (⊤ : Opens X.carrier)), False := by
    intro s
    obtain ⟨x, hx⟩ := hne
    obtain ⟨S, hS, hl⟩ := sheafification_sections_locally_lift JX P0 ⊤ s
    obtain ⟨V, f, hf, hxV⟩ := hS x (Set.mem_univ x)
    obtain ⟨p, -⟩ := hl f hf
    change ULift (V ⟶ U) at p
    have hxU : x ∈ (U : Set X.carrier) := (p.down ⟨x, hxV⟩).property
    exact (Set.mem_compl_iff T x).mp hxU hx
  let B := Opens.map i.base
  have hpre : (⊤ : Opens Z.carrier) ≤ B.obj U := fun z _ =>
    (Set.mem_compl_iff T (i.base z)).mpr (hdisj z)
  let g : (⊤ : Opens Z.carrier) ⟶ B.obj U := homOfLE hpre
  let P := B.op.lan.obj F.obj
  let sU := (toSheafify JX P0).app (Opposite.op U) (ULift.up (𝟙 U))
  let a := P.map g.op
    ((B.op.lanUnit.app F.obj).app (Opposite.op U) sU)
  let r := (toSheafify JZ P).app (Opposite.op (⊤ : Opens Z.carrier)) a
  let e := Functor.sheafPullbackConstruction.sheafPullbackIso
    B (Type u) JX JZ
  have r' := (e.app F).inv.hom.app (Opposite.op (⊤ : Opens Z.carrier)) r
  obtain ⟨s, _⟩ := (hZar F).2 r'
  exact hempty s

private theorem zarSections_closed_point_lies_in_image
    {X Z : Scheme.{u}} (i : Z ⟶ X)
    (hZar : ∀ F : Sheaf (Opens.grothendieckTopology X.carrier)
      (Type u),
      Function.Bijective (zariskiGlobalSectionsMapAt i F))
    (x : X.carrier) (hx : IsClosed ({x} : Set X.carrier)) :
    x ∈ Set.range i.base := by
  by_contra hnot
  exact zarSections_force_meeting_closed_set i hZar {x} hx ⟨x, rfl⟩ fun z hz => hnot ⟨z, hz⟩

private theorem zarSections_open_eq_top_of_contains_image
    {X Z : Scheme.{u}} (i : Z ⟶ X)
    (hZar : ∀ F : Sheaf (Opens.grothendieckTopology X.carrier)
      (Type u),
      Function.Bijective (zariskiGlobalSectionsMapAt i F))
    (O : Opens X.carrier) (hO : ∀ z : Z.carrier, i.base z ∈ O) :
    O = ⊤ := by
  by_contra hne
  have hnonempty : (Oᶜ : Set X.carrier).Nonempty := by
    by_contra hempty
    apply hne
    ext x
    exact ⟨fun _ => trivial, fun _ => by_contra fun hx => hempty ⟨x, hx⟩⟩
  exact zarSections_force_meeting_closed_set i hZar (Oᶜ : Set X.carrier)
    O.isOpen.isClosed_compl hnonempty fun z hz => hz (hO z)

private theorem smallEtale_unit_terminal_injective
    {X Z : Scheme.{u}} (i : Z ⟶ X)
    (hZar : ∀ F : Sheaf (Opens.grothendieckTopology X.carrier)
      (Type u),
      Function.Bijective (zariskiGlobalSectionsMapAt i F))
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) w)))
    (g : terminal Z.Etale ⟶
      (smallEtaleBaseChange i).obj (terminal X.Etale)) :
    Function.Injective (fun a =>
      (toSheafify Z.smallEtaleTopology
        ((smallEtaleBaseChange i).op.lan.obj F.obj)).app
          (Opposite.op (terminal Z.Etale))
          (((smallEtaleBaseChange i).op.lan.obj F.obj).map g.op
            (((smallEtaleBaseChange i).op.lanUnit.app F.obj).app
              (Opposite.op (terminal X.Etale)) a))) := by
  intro a b hab
  let U := terminal X.Etale
  let L : Set X.carrier := {x | ∃ (W : X.Etale) (f : W ⟶ U) (w : W.left),
    W.hom w = x ∧ F.obj.map f.op a = F.obj.map f.op b}
  have hL : IsOpen L := by
    apply isOpen_iff_forall_mem_open.mpr
    rintro x ⟨W, f, w, hw, hf⟩
    refine ⟨Set.range W.hom, ?_, W.hom.isOpenMap.isOpen_range, ⟨w, hw⟩⟩
    rintro x ⟨w, hw⟩
    exact ⟨W, f, w, hw, hf⟩
  let O : Opens X.carrier := ⟨L, hL⟩
  have hO : O = ⊤ := zarSections_open_eq_top_of_contains_image i hZar O (by
    intro z
    obtain ⟨x, hx⟩ := (etale_terminal_hom_bijective Z).2 z
    obtain ⟨W, f, w, hw, hf⟩ := smallEtale_pullback_eq_near_point i F.obj g a b hab x
    refine ⟨W, f, w, ?_, hf⟩
    calc
      W.hom w = U.hom (f.left w) :=
        (congrArg (fun q : W.left ⟶ X => q w) f.w).symm
      _ = U.hom (pullback.fst U.hom i (g.left x)) := congrArg U.hom hw
      _ = i (pullback.snd U.hom i (g.left x)) :=
        congrArg (fun q : pullback U.hom i ⟶ X => q (g.left x)) pullback.condition
      _ = i ((terminal Z.Etale).hom x) :=
        congrArg i (congrArg (fun q : (terminal Z.Etale).left ⟶ Z => q x) g.w)
      _ = i z := congrArg i hx)
  refine smallEtale_sheaf_eq_of_locally_eq F a b fun x => ?_
  have hx : U.hom x ∈ O := by rw [hO]; trivial
  obtain ⟨W, f, w, hw, hf⟩ := hx
  refine ⟨W, f, w, hf, ?_⟩
  apply (etale_terminal_hom_bijective X).1
  exact (congrArg (fun q : W.left ⟶ X => q w) f.w).trans hw

private theorem smallEtaleGlobalSectionsMapAt_injective
    {X Z : Scheme.{u}} (i : Z ⟶ X)
    (hZar : ∀ F : Sheaf (Opens.grothendieckTopology X.carrier)
      (Type u),
      Function.Bijective (zariskiGlobalSectionsMapAt i F))
    (g : terminal Z.Etale ⟶
      (smallEtaleBaseChange i).obj (terminal X.Etale))
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) w))) :
    Function.Injective (smallEtaleGlobalSectionsMapAt i g F) := by
  let eX := (Sheaf.ΓNatIsoSheafSections X.smallEtaleTopology
    (Type (max (u + 1) w)) terminalIsTerminal).app F
  let eZ := (Sheaf.ΓNatIsoSheafSections Z.smallEtaleTopology
    (Type (max (u + 1) w)) terminalIsTerminal).app
      ((smallEtaleInverseImage i).obj F)
  exact (ConcreteCategory.bijective_of_isIso eZ.inv).1.comp
    ((smallEtale_unit_terminal_injective i hZar F g).comp
      (ConcreteCategory.bijective_of_isIso eX.hom).1)

private theorem smallEtaleLiftFamily_surjective
    {X Z : Scheme.{u}} (i : Z ⟶ X)
    (hZar : ∀ F : Sheaf (Opens.grothendieckTopology X.carrier)
      (Type u),
      Function.Bijective (zariskiGlobalSectionsMapAt i F))
    {I : Type u} (U : I → X.Etale) (V : I → Z.Etale)
    (g : ∀ j, V j ⟶ (smallEtaleBaseChange i).obj (U j))
    (hcover : ∀ z : Z.carrier, ∃ j, ∃ y : (V j).left, (V j).hom y = z) :
    Surjective (Sigma.desc (fun j => (U j).hom)) := by
  classical
  let p : (∐ fun j => (U j).left) ⟶ X := Sigma.desc fun j => (U j).hom
  let : HasRingHomProperty @Etale RingHom.Etale := inferInstance
  let : IsZariskiLocalAtSource @Etale :=
    HasRingHomProperty.instIsZariskiLocalAtSource (P := @Etale) (Q := RingHom.Etale)
  let : Etale p := IsZariskiLocalAtSource.sigmaDesc (P := @Etale)
    (fun j => inferInstance)
  let O : Opens X.carrier := ⟨Set.range p, p.isOpenMap.isOpen_range⟩
  have hO : O = ⊤ := zarSections_open_eq_top_of_contains_image i hZar O (by
    intro z
    obtain ⟨j, y, hy⟩ := hcover z
    let a : (V j).left ⟶ (U j).left :=
      (g j).left ≫ pullback.fst (U j).hom i
    have ha : a ≫ (U j).hom = (V j).hom ≫ i :=
      (Category.assoc _ _ _).trans (smallEtale_baseChange_fst_comp i (g j))
    refine ⟨Sigma.ι (fun j => (U j).left) j (a y), ?_⟩
    calc
      _ = (U j).hom (a y) := by
        change (Sigma.ι (fun j => (U j).left) j ≫ p) (a y) = (U j).hom (a y)
        exact congrArg (fun k : (U j).left ⟶ X => k (a y))
          (Sigma.ι_desc (fun j => (U j).hom) j)
      _ = i ((V j).hom y) := by
        simpa [Scheme.Hom.comp_apply] using congrArg (fun k => k y) ha
      _ = i z := congrArg i hy)
  refine ⟨fun x => ?_⟩
  change x ∈ O
  rw [hO]
  trivial

private theorem etale_factor_through_open_over_closed
    {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    {U : X.Etale} {V : Z.Etale}
    (g : V ⟶ (smallEtaleBaseChange i).obj U) :
    ∃ (W : X.Etale) (f : W ⟶ U)
      (k : V ⟶ (smallEtaleBaseChange i).obj W),
      k ≫ (smallEtaleBaseChange i).map f = g ∧ Surjective k.left := by
  let B := smallEtaleBaseChange i
  have he : Etale g.left := inferInstance
  obtain ⟨O, hO, hpre⟩ :=
    (pullback.fst U.hom i).isClosedEmbedding.isInducing.isOpen_iff.mp
      g.left.isOpenMap.isOpen_range
  let A : U.left.Opens := ⟨O, hO⟩
  let W : X.Etale := Scheme.Etale.mk (A.ι ≫ U.hom)
  let f : W ⟶ U := MorphismProperty.Over.homMk A.ι
  have hmem (y : V.left) : pullback.fst U.hom i (g.left y) ∈ A := by
    change g.left y ∈ (pullback.fst U.hom i) ⁻¹' O
    rw [hpre]
    exact ⟨y, rfl⟩
  let a : V.left ⟶ A.toScheme := IsOpenImmersion.lift A.ι
    (g.left ≫ pullback.fst U.hom i) (by
      rintro _ ⟨y, rfl⟩
      exact ⟨⟨_, hmem y⟩, rfl⟩)
  have ha : a ≫ A.ι = g.left ≫ pullback.fst U.hom i :=
    IsOpenImmersion.lift_fac _ _ _
  have hw : a ≫ W.hom = V.hom ≫ i := by
    change a ≫ A.ι ≫ U.hom = V.hom ≫ i
    rw [← Category.assoc, ha]
    exact (Category.assoc _ _ _).trans (smallEtale_baseChange_fst_comp i g)
  let k : V ⟶ B.obj W := MorphismProperty.Over.homMk
    (pullback.lift a V.hom hw) (pullback.lift_snd _ _ _)
  have hbf : (B.map f).left ≫ pullback.fst U.hom i =
      pullback.fst W.hom i ≫ A.ι := pullback.lift_fst _ _ _
  have hbs : (B.map f).left ≫ pullback.snd U.hom i =
      pullback.snd W.hom i := pullback.lift_snd _ _ _
  have hkg : k ≫ B.map f = g := by
    apply MorphismProperty.Over.Hom.ext
    apply pullback.hom_ext
    · change pullback.lift a V.hom hw ≫ (B.map f).left ≫ pullback.fst U.hom i =
        g.left ≫ pullback.fst U.hom i
      have e1 : pullback.lift a V.hom hw ≫ (B.map f).left ≫ pullback.fst U.hom i =
          pullback.lift a V.hom hw ≫ pullback.fst W.hom i ≫ A.ι :=
        congrArg (fun t : (B.obj W).left ⟶ U.left => pullback.lift a V.hom hw ≫ t) hbf
      have e2 : pullback.lift a V.hom hw ≫ (B.map f).left ≫ pullback.fst U.hom i =
          (pullback.lift a V.hom hw ≫ pullback.fst W.hom i) ≫ A.ι :=
        e1.trans (Category.assoc _ _ _).symm
      have e3 : pullback.lift a V.hom hw ≫ (B.map f).left ≫ pullback.fst U.hom i =
          a ≫ A.ι :=
        e2.trans (congrArg (fun t : V.left ⟶ A.toScheme => t ≫ A.ι)
          (pullback.lift_fst a V.hom hw))
      exact e3.trans ha
    · change pullback.lift a V.hom hw ≫ (B.map f).left ≫ pullback.snd U.hom i =
        g.left ≫ pullback.snd U.hom i
      have e1 : pullback.lift a V.hom hw ≫ (B.map f).left ≫ pullback.snd U.hom i =
          pullback.lift a V.hom hw ≫ pullback.snd W.hom i :=
        congrArg (fun t : (B.obj W).left ⟶ Z => pullback.lift a V.hom hw ≫ t) hbs
      exact (e1.trans (pullback.lift_snd a V.hom hw)).trans g.w.symm
  refine ⟨W, f, k, hkg, ⟨fun x => ?_⟩⟩
  have hm (z : (B.obj W).left) : A.ι (pullback.fst W.hom i z) =
      pullback.fst U.hom i ((B.map f).left z) :=
    (congrArg (fun q : (B.obj W).left ⟶ U.left => q z) hbf).symm
  have hpx : (B.map f).left x ∈ (pullback.fst U.hom i) ⁻¹' O := by
    change pullback.fst U.hom i ((B.map f).left x) ∈ O
    rw [← hm]
    exact (pullback.fst W.hom i x).property
  rw [hpre] at hpx
  obtain ⟨y, hy⟩ := hpx
  refine ⟨y, ?_⟩
  apply (pullback.fst W.hom i).isClosedEmbedding.injective
  apply A.ι.isOpenEmbedding.injective
  exact (hm _).trans ((congrArg (pullback.fst U.hom i)
    ((congrArg (fun q : V ⟶ B.obj U => q.left y) hkg).trans hy)).trans (hm _).symm)

private theorem etaleSheaf_map_injective_of_surjective
    {X : Scheme.{u}} (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    {U V : X.Etale} (f : V ⟶ U) [Surjective f.left] :
    Function.Injective (F.obj.map f.op) := by
  intro a b h
  refine smallEtale_sheaf_eq_of_locally_eq F a b fun x => ?_
  obtain ⟨y, hy⟩ := f.left.surjective x
  exact ⟨V, f, y, h, hy⟩

private theorem smallEtaleGlobalSection_has_strict_lifting_family
    {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (t : ((smallEtaleInverseImage i).obj F).obj.obj
      (Opposite.op (terminal Z.Etale))) :
    ∃ (I : Type u) (U : I → X.Etale)
      (s : ∀ j, F.obj.obj (Opposite.op (U j))),
      (∀ j, pullbackSection i F (𝟙 _) (s j) =
        ((smallEtaleInverseImage i).obj F).obj.map
          (terminal.from ((smallEtaleBaseChange i).obj (U j))).op t) ∧
      ∀ z : Z.carrier, ∃ j, ∃ y : ((smallEtaleBaseChange i).obj (U j)).left,
        ((smallEtaleBaseChange i).obj (U j)).hom y = z := by
  classical
  obtain ⟨I, V, U, s, g, h, hc⟩ := smallEtaleGlobalSection_has_lifting_family i F t
  choose W f k hk hs using fun j => etale_factor_through_open_over_closed i (g j)
  refine ⟨I, W, fun j => F.obj.map (f j).op (s j), ?_, ?_⟩
  · intro j
    let := hs j
    apply etaleSheaf_map_injective_of_surjective
      ((smallEtaleInverseImage i).obj F) (k j)
    rw [pullbackSection_map, Category.comp_id, pullbackSection_restrict, hk]
    refine (h j).trans ?_
    rw [← Functor.map_comp_apply, ← op_comp, terminal.comp_from]
  · intro z
    obtain ⟨j, y, hy⟩ := hc z
    refine ⟨j, (k j).left y, ?_⟩
    exact (congrArg (fun q : (V j).left ⟶ Z => q y) (k j).w).trans hy

private theorem locally_factors_through_sigma_summand
    {I : Type u} (U : I → Scheme.{u}) {Y : Scheme.{u}}
    (f : Y ⟶ ∐ U) (y : Y) :
    ∃ (j : I) (W : Y.Opens) (_ : y ∈ W) (g : W.toScheme ⟶ U j),
      W.ι ≫ f = g ≫ Sigma.ι U j := by
  obtain ⟨j, x, hx⟩ := Scheme.IsLocallyDirected.ι_jointly_surjective
    (Discrete.functor U) (f y)
  let W : Y.Opens := (Opens.map f.base).obj (Sigma.ι U j.as).opensRange
  have hy : y ∈ W := ⟨x, hx⟩
  let g : W.toScheme ⟶ U j.as := IsOpenImmersion.lift (Sigma.ι U j.as)
    (W.ι ≫ f) (by
      rintro _ ⟨z, rfl⟩
      exact z.property)
  exact ⟨j.as, W, hy, g, (IsOpenImmersion.lift_fac _ _ _).symm⟩

private theorem exists_finite_refinement_of_etale_family
    {X : Scheme.{u}} [CompactSpace X] [QuasiSeparatedSpace X]
    {I : Type u} (U : I → X.Etale)
    [Surjective (Sigma.desc fun j => (U j).hom)] :
    ∃ (Y : Scheme.{u}) (f : Y ⟶ X), IsFinite f ∧ Surjective f ∧
      ∀ y : Y, ∃ (j : I) (W : Y.Opens) (_ : y ∈ W) (g : W.toScheme ⟶ (U j).left),
        W.ι ≫ f = g ≫ (U j).hom := by
  let p : (∐ fun j => (U j).left) ⟶ X := Sigma.desc fun j => (U j).hom
  let : IsZariskiLocalAtSource @Etale :=
    HasRingHomProperty.instIsZariskiLocalAtSource (P := @Etale) (Q := RingHom.Etale)
  let : Etale p := IsZariskiLocalAtSource.sigmaDesc (P := @Etale)
    (fun j => inferInstance)
  let : Surjective p := ‹Surjective (Sigma.desc fun j => (U j).hom)›
  obtain ⟨Y, f, _, hs, hf, _, _, _, hl⟩ :=
    Stacks.MoreMorphisms.exists_isFinite_finitePresentation_surjective_zariskiLocallyFactors p
  refine ⟨Y, f, hf, hs, ?_⟩
  intro y
  obtain ⟨W, hy, a, ha⟩ := hl y
  obtain ⟨j, V, hv, b, hb⟩ :=
    locally_factors_through_sigma_summand (fun j => (U j).left) a ⟨y, hy⟩
  let T : Y.Opens := W.ι.opensFunctor.obj V
  let e : V.toScheme ≅ T.toScheme := W.ι.isoImage V
  refine ⟨j, T, ?_, e.inv ≫ b, ?_⟩
  · exact ⟨⟨y, hy⟩, hv, rfl⟩
  · have he : e.inv ≫ V.ι ≫ W.ι = T.ι := by
      simp [e, T]
    calc
      T.ι ≫ f = e.inv ≫ V.ι ≫ W.ι ≫ f := by rw [← he]; simp only [Category.assoc]
      _ = e.inv ≫ V.ι ≫ a ≫ p := by rw [ha]
      _ = e.inv ≫ b ≫ Sigma.ι (fun j => (U j).left) j ≫ p := by
        rw [← Category.assoc V.ι a, hb]; simp only [Category.assoc]
      _ = (e.inv ≫ b) ≫ (U j).hom := by simp [p]

private def etaleLocalFactorToBaseChange {X Y : Scheme.{u}} (f : Y ⟶ X)
    (U : X.Etale) (W : Y.Opens) (g : W.toScheme ⟶ U.left)
    (hg : W.ι ≫ f = g ≫ U.hom) :
    (AlgebraicGeometry.opensToEtale Y).obj W ⟶
      (smallEtaleBaseChange f).obj U :=
  MorphismProperty.Over.homMk (pullback.lift g W.ι hg.symm)
    (pullback.lift_snd _ _ _)

private theorem etaleLocalFactorToBaseChange_fst {X Y : Scheme.{u}} (f : Y ⟶ X)
    (U : X.Etale) (W : Y.Opens) (g : W.toScheme ⟶ U.left)
    (hg : W.ι ≫ f = g ≫ U.hom) :
    (etaleLocalFactorToBaseChange f U W g hg).left ≫
      pullback.fst U.hom f = g := pullback.lift_fst _ _ _

private def opensEtaleBaseChangeMap {X Z : Scheme.{u}} (i : Z ⟶ X) (U : X.Opens) :
    (AlgebraicGeometry.opensToEtale Z).obj ((Opens.map i.base).obj U) ⟶
      (smallEtaleBaseChange i).obj ((AlgebraicGeometry.opensToEtale X).obj U) :=
  MorphismProperty.Over.homMk
    (pullback.lift (i.resLE U ((Opens.map i.base).obj U) le_rfl)
      (Scheme.Opens.ι ((Opens.map i.base).obj U))
      (i.resLE_comp_ι le_rfl)) (pullback.lift_snd _ _ _)

private theorem etale_hom_ext_of_mono {X : Scheme.{u}} {U V : X.Etale}
    [Mono V.hom] (f g : U ⟶ V) : f = g := by
  apply MorphismProperty.Over.Hom.ext
  apply (cancel_mono V.hom).1
  exact f.w.trans g.w.symm

private theorem etale_section_eq_on_open_neighbourhood
    {X Z : Scheme.{u}} (i : Z ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    {U : X.Opens} {V : Z.Etale}
    (g : V ⟶ (smallEtaleBaseChange i).obj ((AlgebraicGeometry.opensToEtale X).obj U))
    (a b : F.obj.obj (Opposite.op ((AlgebraicGeometry.opensToEtale X).obj U)))
    (h : pullbackSection i F g a = pullbackSection i F g b) (x : V.left) :
    ∃ (O : X.Opens) (f : O ⟶ U), i (V.hom x) ∈ O ∧
      F.obj.map ((AlgebraicGeometry.opensToEtale X).map f).op a =
        F.obj.map ((AlgebraicGeometry.opensToEtale X).map f).op b := by
  obtain ⟨W, f, w, hw, hf⟩ := smallEtale_pullback_eq_near_point i F.obj g a b h x
  let O : X.Opens := ⟨Set.range W.hom, W.hom.isOpenMap.isOpen_range⟩
  have hOU : O ≤ U := by
    rintro _ ⟨y, rfl⟩
    have hy := congrArg (fun q : W.left ⟶ X => q y) f.w
    change U.ι (f.left y) = W.hom y at hy
    rw [← hy]
    exact (f.left y).property
  let q : W ⟶ (AlgebraicGeometry.opensToEtale X).obj O :=
    MorphismProperty.Over.homMk
      (IsOpenImmersion.lift (H := O.instIsOpenImmersionι) O.ι W.hom (by
        rintro _ ⟨y, rfl⟩
        exact ⟨⟨W.hom y, ⟨y, rfl⟩⟩, rfl⟩))
      (IsOpenImmersion.lift_fac (H := O.instIsOpenImmersionι) _ _ _)
  let : Surjective q.left := ⟨fun y => by
    obtain ⟨z, hz⟩ := y.property
    refine ⟨z, ?_⟩
    apply O.ι.isOpenEmbedding.injective
    exact (congrArg (fun k : W.left ⟶ X => k z) q.w).trans hz⟩
  refine ⟨O, homOfLE hOU, ⟨w, ?_⟩, ?_⟩
  · calc
      W.hom w = U.ι (f.left w) := (congrArg (fun q : W.left ⟶ X => q w) f.w).symm
      _ = U.ι (pullback.fst U.ι i (g.left x)) := congrArg U.ι hw
      _ = i (pullback.snd U.ι i (g.left x)) :=
        congrArg (fun q : pullback U.ι i ⟶ X => q (g.left x)) pullback.condition
      _ = i (V.hom x) := congrArg i (congrArg (fun q : V.left ⟶ Z => q x) g.w)
  · apply etaleSheaf_map_injective_of_surjective F q
    let : Mono ((AlgebraicGeometry.opensToEtale X).obj U).hom := inferInstanceAs (Mono U.ι)
    have hq : q ≫ (AlgebraicGeometry.opensToEtale X).map (homOfLE hOU) = f :=
      etale_hom_ext_of_mono _ _
    simpa only [← Functor.map_comp_apply, ← op_comp, hq] using hf

private theorem opensEtaleBaseChangeMap_naturality {X Z : Scheme.{u}} (i : Z ⟶ X)
    {U V : X.Opens} (f : U ⟶ V) :
    (AlgebraicGeometry.opensToEtale Z).map ((Opens.map i.base).map f) ≫
        opensEtaleBaseChangeMap i V =
      opensEtaleBaseChangeMap i U ≫
        (smallEtaleBaseChange i).map ((AlgebraicGeometry.opensToEtale X).map f) := by
  let : Mono ((smallEtaleBaseChange i).obj
      ((AlgebraicGeometry.opensToEtale X).obj V)).hom :=
    inferInstanceAs (Mono (pullback.snd V.ι i))
  apply etale_hom_ext_of_mono

private def etaleZariskiUnit {X Z : Scheme.{u}} (i : Z ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))) :
    etaleZariskiRestriction F ⟶
      ((Opens.map i.base).sheafPushforwardContinuous (Type (max (u + 1) v))
        (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).obj
          (etaleZariskiRestriction ((smallEtaleInverseImage i).obj F)) := by
  refine ObjectProperty.homMk { app := fun U => ?_, naturality := ?_ }
  · exact TypeCat.ofHom fun s => pullbackSection i F (opensEtaleBaseChangeMap i U.unop) s
  · intro U V f
    ext s
    change pullbackSection i F (opensEtaleBaseChangeMap i V.unop)
        (F.obj.map ((AlgebraicGeometry.opensToEtale X).map f.unop).op s) =
      ((smallEtaleInverseImage i).obj F).obj.map
        ((AlgebraicGeometry.opensToEtale Z).map ((Opens.map i.base).map f.unop)).op
        (pullbackSection i F (opensEtaleBaseChangeMap i U.unop) s)
    refine (pullbackSection_restrict i F
      ((AlgebraicGeometry.opensToEtale X).map f.unop)
      (opensEtaleBaseChangeMap i V.unop) s).trans ?_
    refine Eq.trans ?_ (pullbackSection_map i F
      (opensEtaleBaseChangeMap i U.unop)
      ((AlgebraicGeometry.opensToEtale Z).map ((Opens.map i.base).map f.unop)) s).symm
    exact (congrArg (fun q : (AlgebraicGeometry.opensToEtale Z).obj
        ((Opens.map i.base).obj V.unop) ⟶
        (smallEtaleBaseChange i).obj
          ((AlgebraicGeometry.opensToEtale X).obj U.unop) =>
      pullbackSection i F q s) (opensEtaleBaseChangeMap_naturality i f.unop)).symm

private def etaleZariskiComparison {X Z : Scheme.{u}} (i : Z ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))) :
    ((Opens.map i.base).sheafPullback (Type (max (u + 1) v))
      (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).obj
        (etaleZariskiRestriction F) ⟶
      etaleZariskiRestriction ((smallEtaleInverseImage i).obj F) :=
  (((Opens.map i.base).sheafAdjunctionContinuous (Type (max (u + 1) v))
    (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).homEquiv
      _ _).symm (etaleZariskiUnit i F)

private theorem etaleZariskiComparison_unit {X Z : Scheme.{u}} (i : Z ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))) (U : X.Opens)
    (s : F.obj.obj (Opposite.op ((AlgebraicGeometry.opensToEtale X).obj U))) :
    (etaleZariskiComparison i F).hom.app (Opposite.op ((Opens.map i.base).obj U))
      (((((Opens.map i.base).sheafAdjunctionContinuous (Type (max (u + 1) v))
        (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).unit.app
          (etaleZariskiRestriction F)).hom.app (Opposite.op U)) s) =
      pullbackSection i F (opensEtaleBaseChangeMap i U) s := by
  have h := (((Opens.map i.base).sheafAdjunctionContinuous (Type (max (u + 1) v))
    (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).homEquiv
      _ _).apply_symm_apply (etaleZariskiUnit i F)
  rw [Adjunction.homEquiv_unit] at h
  exact congrArg (fun q => q.hom.app (Opposite.op U) s) h

private theorem zariski_unit_pullbackIso
    {X Z : Scheme.{u}} (i : Z ⟶ X) [UnivLE.{u, t}]
    (F : Sheaf (Opens.grothendieckTopology X.carrier) (Type t))
    (U : X.Opens) :
    ((((Opens.map i.base).sheafAdjunctionContinuous (Type t)
      (Opens.grothendieckTopology X.carrier)
        (Opens.grothendieckTopology Z.carrier)).unit.app F).hom.app
        (Opposite.op U)) ≫
      ((Functor.sheafPullbackConstruction.sheafPullbackIso (Opens.map i.base)
        (Type t) (Opens.grothendieckTopology X.carrier)
          (Opens.grothendieckTopology Z.carrier)).hom.app F).hom.app
            (Opposite.op ((Opens.map i.base).obj U)) =
    (((Opens.map i.base).op.lanUnit.app F.obj).app (Opposite.op U)) ≫
      (toSheafify (Opens.grothendieckTopology Z.carrier)
        ((Opens.map i.base).op.lan.obj F.obj)).app
          (Opposite.op ((Opens.map i.base).obj U)) := by
  have h := Adjunction.unit_leftAdjointUniq_hom_app
    ((Opens.map i.base).sheafAdjunctionContinuous (Type t)
      (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier))
    (Functor.sheafPullbackConstruction.sheafAdjunctionContinuous (Opens.map i.base)
      (Type t) (Opens.grothendieckTopology X.carrier)
        (Opens.grothendieckTopology Z.carrier)) F
  exact congrArg (fun q => q.hom.app (Opposite.op U)) h

private abbrev zariskiPullbackSection {X Z : Scheme.{u}} (i : Z ⟶ X) [UnivLE.{u, t}]
    (F : Sheaf (Opens.grothendieckTopology X.carrier) (Type t))
    {U : X.Opens} {V : Z.Opens} (g : V ⟶ (Opens.map i.base).obj U)
    (a : F.obj.obj (Opposite.op U)) :=
  (((Opens.map i.base).sheafPullback (Type t)
    (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).obj F).obj.map
      g.op
      (((((Opens.map i.base).sheafAdjunctionContinuous (Type t)
        (Opens.grothendieckTopology X.carrier)
          (Opens.grothendieckTopology Z.carrier)).unit.app F).hom.app
          (Opposite.op U)) a)

private theorem zariskiPullbackSection_map {X Z : Scheme.{u}} (i : Z ⟶ X) [UnivLE.{u, t}]
    (F : Sheaf (Opens.grothendieckTopology X.carrier) (Type t))
    {U : X.Opens} {V W : Z.Opens} (g : V ⟶ (Opens.map i.base).obj U) (f : W ⟶ V)
    (a : F.obj.obj (Opposite.op U)) :
    (((Opens.map i.base).sheafPullback (Type t)
      (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).obj F).obj.map
      f.op (zariskiPullbackSection i F g a) = zariskiPullbackSection i F (f ≫ g) a :=
  (Functor.map_comp_apply
    ((((Opens.map i.base).sheafPullback (Type t)
      (Opens.grothendieckTopology X.carrier)
        (Opens.grothendieckTopology Z.carrier)).obj F).obj) g.op f.op
    (((((Opens.map i.base).sheafAdjunctionContinuous (Type t)
      (Opens.grothendieckTopology X.carrier)
        (Opens.grothendieckTopology Z.carrier)).unit.app F).hom.app
          (Opposite.op U)) a)).symm

private theorem zariskiPullbackSection_restrict {X Z : Scheme.{u}} (i : Z ⟶ X) [UnivLE.{u, t}]
    (F : Sheaf (Opens.grothendieckTopology X.carrier) (Type t))
    {U W : X.Opens} {V : Z.Opens} (f : W ⟶ U)
    (g : V ⟶ (Opens.map i.base).obj W) (a : F.obj.obj (Opposite.op U)) :
    zariskiPullbackSection i F g (F.obj.map f.op a) =
      zariskiPullbackSection i F (g ≫ (Opens.map i.base).map f) a := by
  let H := ((Opens.map i.base).sheafPullback (Type t)
    (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).obj F
  let η := (((Opens.map i.base).sheafAdjunctionContinuous (Type t)
    (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).unit.app F).hom
  have h := η.naturality f.op
  change F.obj.map f.op ≫ η.app (Opposite.op W) =
    η.app (Opposite.op U) ≫ H.obj.map ((Opens.map i.base).map f).op at h
  have hh := ConcreteCategory.congr_hom h a
  change η.app (Opposite.op W) (F.obj.map f.op a) =
    H.obj.map ((Opens.map i.base).map f).op (η.app (Opposite.op U) a) at hh
  change H.obj.map g.op (η.app (Opposite.op W) (F.obj.map f.op a)) =
    H.obj.map (g ≫ (Opens.map i.base).map f).op (η.app (Opposite.op U) a)
  exact (congrArg (fun q => H.obj.map g.op q) hh).trans
    (Functor.map_comp_apply H.obj ((Opens.map i.base).map f).op g.op
      (η.app (Opposite.op U) a)).symm

private theorem etaleZariskiComparison_section {X Z : Scheme.{u}} (i : Z ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    {U : X.Opens} {V : Z.Opens} (g : V ⟶ (Opens.map i.base).obj U)
    (a : F.obj.obj (Opposite.op ((AlgebraicGeometry.opensToEtale X).obj U))) :
    (etaleZariskiComparison i F).hom.app (Opposite.op V)
      (zariskiPullbackSection i (etaleZariskiRestriction F) g a) =
      pullbackSection i F
        ((AlgebraicGeometry.opensToEtale Z).map g ≫ opensEtaleBaseChangeMap i U) a := by
  have h := NatTrans.naturality_apply (etaleZariskiComparison i F).hom g.op
    (((((Opens.map i.base).sheafAdjunctionContinuous (Type (max (u + 1) v))
      (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).unit.app
        (etaleZariskiRestriction F)).hom.app (Opposite.op U)) a)
  exact h.trans ((congrArg (fun q => ((smallEtaleInverseImage i).obj F).obj.map
    ((AlgebraicGeometry.opensToEtale Z).map g).op q) (etaleZariskiComparison_unit i F U a)).trans
      (pullbackSection_map i F _ _ a))

private theorem etaleZariskiComparison_sections_eq_near_point
    {X Z : Scheme.{u}} (i : Z ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    {U : X.Opens} {V : Z.Opens} (g : V ⟶ (Opens.map i.base).obj U)
    (a b : F.obj.obj (Opposite.op ((AlgebraicGeometry.opensToEtale X).obj U)))
    (h : (etaleZariskiComparison i F).hom.app (Opposite.op V)
        (zariskiPullbackSection i (etaleZariskiRestriction F) g a) =
      (etaleZariskiComparison i F).hom.app (Opposite.op V)
        (zariskiPullbackSection i (etaleZariskiRestriction F) g b))
    (z : Z.carrier) (hz : z ∈ V) :
    ∃ (W : Z.Opens) (_ : z ∈ W) (f : W ⟶ V),
      (((Opens.map i.base).sheafPullback (Type (max (u + 1) v))
        (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).obj
          (etaleZariskiRestriction F)).obj.map f.op
        (zariskiPullbackSection i (etaleZariskiRestriction F) g a) =
      (((Opens.map i.base).sheafPullback (Type (max (u + 1) v))
        (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).obj
          (etaleZariskiRestriction F)).obj.map f.op
        (zariskiPullbackSection i (etaleZariskiRestriction F) g b) := by
  rw [etaleZariskiComparison_section, etaleZariskiComparison_section] at h
  obtain ⟨O, f, hzO, heq⟩ := etale_section_eq_on_open_neighbourhood i F
    ((AlgebraicGeometry.opensToEtale Z).map g ≫ opensEtaleBaseChangeMap i U) a b h ⟨z, hz⟩
  let W : Z.Opens := V ⊓ (Opens.map i.base).obj O
  let q : W ⟶ V := homOfLE inf_le_left
  let k : W ⟶ (Opens.map i.base).obj O := homOfLE inf_le_right
  have hk : q ≫ g = k ≫ (Opens.map i.base).map f := Subsingleton.elim _ _
  refine ⟨W, ⟨hz, hzO⟩, q, ?_⟩
  have hstep : ∀ c : F.obj.obj
      (Opposite.op ((AlgebraicGeometry.opensToEtale X).obj U)),
      (((Opens.map i.base).sheafPullback (Type (max (u + 1) v))
        (Opens.grothendieckTopology X.carrier)
          (Opens.grothendieckTopology Z.carrier)).obj
            (etaleZariskiRestriction F)).obj.map q.op
          (zariskiPullbackSection i (etaleZariskiRestriction F) g c) =
        zariskiPullbackSection i (etaleZariskiRestriction F) k
          (F.obj.map ((AlgebraicGeometry.opensToEtale X).map f).op c) := by
    intro c
    refine (zariskiPullbackSection_map i (etaleZariskiRestriction F) g q c).trans ?_
    refine (congrArg (fun m : W ⟶ (Opens.map i.base).obj U =>
      zariskiPullbackSection i (etaleZariskiRestriction F) m c) hk).trans ?_
    exact (zariskiPullbackSection_restrict i (etaleZariskiRestriction F) f k c).symm
  exact (hstep a).trans
    ((congrArg (zariskiPullbackSection i (etaleZariskiRestriction F) k) heq).trans
      (hstep b).symm)

private theorem zariskiInverseImage_section_near_point
    {X Z : Scheme.{u}} (i : Z ⟶ X) [UnivLE.{u, t}]
    (F : Sheaf (Opens.grothendieckTopology X.carrier) (Type t))
    (V : Z.Opens)
    (s : (((Opens.map i.base).sheafPullback (Type t)
      (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).obj F).obj.obj
        (Opposite.op V)) (z : Z.carrier) (hz : z ∈ V) :
    ∃ (W : Z.Opens) (_ : z ∈ W) (f : W ⟶ V)
      (U : X.Opens) (g : W ⟶ (Opens.map i.base).obj U)
      (a : F.obj.obj (Opposite.op U)),
      (((Opens.map i.base).sheafPullback (Type t)
        (Opens.grothendieckTopology X.carrier)
          (Opens.grothendieckTopology Z.carrier)).obj F).obj.map
          f.op s =
      (((Opens.map i.base).sheafPullback (Type t)
        (Opens.grothendieckTopology X.carrier)
          (Opens.grothendieckTopology Z.carrier)).obj F).obj.map
          g.op
          (((((Opens.map i.base).sheafAdjunctionContinuous (Type t)
            (Opens.grothendieckTopology X.carrier)
              (Opens.grothendieckTopology Z.carrier)).unit.app F).hom.app
              (Opposite.op U)) a) := by
  let B := Opens.map i.base
  let J := Opens.grothendieckTopology Z.carrier
  let H := (B.sheafPullback (Type t)
    (Opens.grothendieckTopology X.carrier) J).obj F
  let P := B.op.lan.obj F.obj
  let e := (Functor.sheafPullbackConstruction.sheafPullbackIso B
    (Type t) (Opens.grothendieckTopology X.carrier) J).app F
  obtain ⟨S, hS, hl⟩ := sheafification_sections_locally_lift J P V
    (e.hom.hom.app (Opposite.op V) s)
  obtain ⟨W, f, hf, hzW⟩ := hS z hz
  obtain ⟨p, hp⟩ := hl f hf
  obtain ⟨U, a, g, ha⟩ := lan_section_has_representative (Opens.map i.base) F.obj W p
  refine ⟨W, hzW, f, U, g, a, ?_⟩
  apply (ConcreteCategory.bijective_of_isIso (e.hom.hom.app (Opposite.op W))).1
  have hn := NatTrans.naturality_apply e.hom.hom f.op s
  have hg := NatTrans.naturality_apply e.hom.hom g.op
    (((((Opens.map i.base).sheafAdjunctionContinuous (Type t)
      (Opens.grothendieckTopology X.carrier) J).unit.app F).hom.app (Opposite.op U)) a)
  have hu := ConcreteCategory.congr_hom (zariski_unit_pullbackIso i F U) a
  have hs := NatTrans.naturality_apply (toSheafify J P) g.op
    ((B.op.lanUnit.app F.obj).app (Opposite.op U) a)
  exact hn.trans (hp.symm.trans
    ((congrArg ((toSheafify J P).app (Opposite.op W)) ha.symm).trans
      (hs.trans ((congrArg (fun q => ((presheafToSheaf J (Type t)).obj P).obj.map
        g.op q) hu.symm).trans hg.symm))))

private theorem etaleZariskiComparison_injective
    {X Z : Scheme.{u}} (i : Z ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))) (V : Z.Opens) :
    Function.Injective ((etaleZariskiComparison i F).hom.app (Opposite.op V)) := by
  let R := etaleZariskiRestriction F
  let H := ((Opens.map i.base).sheafPullback (Type (max (u + 1) v))
    (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).obj R
  let G := etaleZariskiRestriction ((smallEtaleInverseImage i).obj F)
  let α := (etaleZariskiComparison i F).hom
  intro a b hab
  have hS : Presheaf.equalizerSieve (F := H.obj) a b ∈
      Opens.grothendieckTopology Z.carrier V := by
    intro z hz
    obtain ⟨Va, hza, fa, Ua, ga, sa, ea⟩ := zariskiInverseImage_section_near_point i R V a z hz
    obtain ⟨Vb, hzb, fb, Ub, gb, sb, eb⟩ := zariskiInverseImage_section_near_point i R V b z hz
    let W : Z.Opens := Va ⊓ Vb
    let wa : W ⟶ Va := homOfLE inf_le_left
    let wb : W ⟶ Vb := homOfLE inf_le_right
    let U : X.Opens := Ua ⊓ Ub
    let ua : U ⟶ Ua := homOfLE inf_le_left
    let ub : U ⟶ Ub := homOfLE inf_le_right
    let g : W ⟶ (Opens.map i.base).obj U := homOfLE (by
      intro x hx
      exact ⟨ga.le hx.1, gb.le hx.2⟩)
    let sa' := R.obj.map ua.op sa
    let sb' := R.obj.map ub.op sb
    have ea' : H.obj.map (wa ≫ fa).op a = zariskiPullbackSection i R g sa' := by
      calc
        _ = H.obj.map wa.op (H.obj.map fa.op a) := by
          simp only [op_comp, Functor.map_comp, types_comp_apply]
        _ = H.obj.map wa.op (zariskiPullbackSection i R ga sa) := congrArg _ ea
        _ = zariskiPullbackSection i R (wa ≫ ga) sa := zariskiPullbackSection_map i R ga wa sa
        _ = zariskiPullbackSection i R g sa' :=
          (congrArg (fun k => zariskiPullbackSection i R k sa)
            (Subsingleton.elim _ _)).trans (zariskiPullbackSection_restrict i R ua g sa).symm
    have eb' : H.obj.map (wb ≫ fb).op b = zariskiPullbackSection i R g sb' := by
      calc
        _ = H.obj.map wb.op (H.obj.map fb.op b) := by
          simp only [op_comp, Functor.map_comp, types_comp_apply]
        _ = H.obj.map wb.op (zariskiPullbackSection i R gb sb) := congrArg _ eb
        _ = zariskiPullbackSection i R (wb ≫ gb) sb := zariskiPullbackSection_map i R gb wb sb
        _ = zariskiPullbackSection i R g sb' :=
          (congrArg (fun k => zariskiPullbackSection i R k sb)
            (Subsingleton.elim _ _)).trans (zariskiPullbackSection_restrict i R ub g sb).symm
    have hw : wa ≫ fa = wb ≫ fb := Subsingleton.elim _ _
    have hh : α.app (Opposite.op W) (zariskiPullbackSection i R g sa') =
        α.app (Opposite.op W) (zariskiPullbackSection i R g sb') := by
      calc
        _ = α.app (Opposite.op W) (H.obj.map (wa ≫ fa).op a) := congrArg _ ea'.symm
        _ = G.obj.map (wa ≫ fa).op (α.app (Opposite.op V) a) :=
          NatTrans.naturality_apply α (wa ≫ fa).op a
        _ = G.obj.map (wb ≫ fb).op (α.app (Opposite.op V) b) := by rw [hab, hw]
        _ = α.app (Opposite.op W) (H.obj.map (wb ≫ fb).op b) :=
          (NatTrans.naturality_apply α (wb ≫ fb).op b).symm
        _ = α.app (Opposite.op W) (zariskiPullbackSection i R g sb') := congrArg _ eb'
    obtain ⟨Q, hzQ, q, hq⟩ :=
      etaleZariskiComparison_sections_eq_near_point i F g sa' sb' hh z ⟨hza, hzb⟩
    refine ⟨Q, q ≫ wa ≫ fa, ?_, hzQ⟩
    change H.obj.map (q ≫ wa ≫ fa).op a = H.obj.map (q ≫ wa ≫ fa).op b
    calc
      _ = H.obj.map q.op (H.obj.map (wa ≫ fa).op a) := by
        simp only [op_comp, Functor.map_comp, types_comp_apply]
      _ = H.obj.map q.op (zariskiPullbackSection i R g sa') := congrArg _ ea'
      _ = H.obj.map q.op (zariskiPullbackSection i R g sb') := hq
      _ = H.obj.map q.op (H.obj.map (wb ≫ fb).op b) := congrArg _ eb'.symm
      _ = H.obj.map (q ≫ wa ≫ fa).op b := by
        rw [← hw]
        simp only [op_comp, Functor.map_comp, types_comp_apply]
  exact (((isSheaf_iff_isSheaf_of_type _ _).1 H.property).isSeparated _ hS).ext
    (fun _ _ hf => hf)

/-- The two orders of pulling back an étale sheaf around a cartesian square agree. -/
private def etalePullbackSquareIso {X Y Z : Scheme.{u}}
    (f : Y ⟶ X) (i : Z ⟶ X) :
    smallEtaleInverseImage i ⋙
        smallEtaleInverseImage (pullback.snd f i) ≅
      smallEtaleInverseImage f ⋙
        smallEtaleInverseImage (pullback.fst f i) :=
  etalePullbackCompIso i (pullback.snd f i)
      (pullback.fst f i ≫ f) pullback.condition ≪≫
    (etalePullbackCompIso f (pullback.fst f i)
      (pullback.fst f i ≫ f) rfl).symm

private theorem etalePullbackSquareIso_section {X Y Z : Scheme.{u}}
    (f : Y ⟶ X) (i : Z ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    {U : X.Etale} {V : Z.Etale} {V' : Y.Etale}
    {W : (pullback f i).Etale}
    (a : V ⟶ (smallEtaleBaseChange i).obj U)
    (b : W ⟶ (smallEtaleBaseChange (pullback.snd f i)).obj V)
    (a' : V' ⟶ (smallEtaleBaseChange f).obj U)
    (b' : W ⟶ (smallEtaleBaseChange (pullback.fst f i)).obj V')
    (h : b ≫ (smallEtaleBaseChange (pullback.snd f i)).map a ≫
        (etaleBaseChangeCompIso i (pullback.snd f i)
          (pullback.fst f i ≫ f) pullback.condition).inv.app U =
      b' ≫ (smallEtaleBaseChange (pullback.fst f i)).map a' ≫
        (etaleBaseChangeCompIso f (pullback.fst f i)
          (pullback.fst f i ≫ f) rfl).inv.app U)
    (s : F.obj.obj (Opposite.op U)) :
    ((etalePullbackSquareIso f i).hom.app F).hom.app (Opposite.op W)
      (pullbackSection (pullback.snd f i) ((smallEtaleInverseImage i).obj F)
        b (pullbackSection i F a s)) =
      pullbackSection (pullback.fst f i)
        ((smallEtaleInverseImage f).obj F) b'
        (pullbackSection f F a' s) := by
  let p := pullback.fst f i ≫ f
  let L := etalePullbackCompIso i (pullback.snd f i) p pullback.condition
  let R := etalePullbackCompIso f (pullback.fst f i) p rfl
  let lhs := pullbackSection (pullback.snd f i)
    ((smallEtaleInverseImage i).obj F) b (pullbackSection i F a s)
  let rhs := pullbackSection (pullback.fst f i)
    ((smallEtaleInverseImage f).obj F) b' (pullbackSection f F a' s)
  have hL := etalePullbackCompIso_section i (pullback.snd f i) p
    pullback.condition F a b s
  have hR := etalePullbackCompIso_section f (pullback.fst f i) p rfl F a' b' s
  apply (ConcreteCategory.bijective_of_isIso
    ((R.hom.app F).hom.app (Opposite.op W))).1
  have e0 : (R.hom.app F).hom.app (Opposite.op W)
        (((etalePullbackSquareIso f i).hom.app F).hom.app (Opposite.op W) lhs) =
      (L.hom.app F).hom.app (Opposite.op W) lhs := by
    have heq : (etalePullbackSquareIso f i).hom.app F ≫ R.hom.app F = L.hom.app F := by
      change L.hom.app F ≫ R.inv.app F ≫ R.hom.app F = L.hom.app F
      simp only [R.inv_hom_id_app, Category.comp_id]
    change (((etalePullbackSquareIso f i).hom.app F ≫ R.hom.app F).hom.app
        (Opposite.op W)) lhs = ((L.hom.app F).hom.app (Opposite.op W)) lhs
    rw [heq]
  exact e0.trans
    (hL.trans ((congrArg (fun q => pullbackSection p F q s) h).trans hR.symm))

private def baseChangedEtaleLocalFactor {X Y Z : Scheme.{u}}
    (f : Y ⟶ X) (i : Z ⟶ X) (U : X.Etale)
    (W : Y.Opens) (g : W.toScheme ⟶ U.left)
    (hg : W.ι ≫ f = g ≫ U.hom) :
    (smallEtaleBaseChange (pullback.fst f i)).obj
        ((AlgebraicGeometry.opensToEtale Y).obj W) ⟶
      (smallEtaleBaseChange (pullback.snd f i)).obj
        ((smallEtaleBaseChange i).obj U) :=
  (smallEtaleBaseChange (pullback.fst f i)).map
      (etaleLocalFactorToBaseChange f U W g hg) ≫
    (etaleBaseChangeCompIso f (pullback.fst f i)
      (pullback.fst f i ≫ f) rfl).inv.app U ≫
    (etaleBaseChangeCompIso i (pullback.snd f i)
      (pullback.fst f i ≫ f) pullback.condition).hom.app U

private theorem baseChangedEtaleLocalFactor_square {X Y Z : Scheme.{u}}
    (f : Y ⟶ X) (i : Z ⟶ X) (U : X.Etale)
    (W : Y.Opens) (g : W.toScheme ⟶ U.left)
    (hg : W.ι ≫ f = g ≫ U.hom) :
    baseChangedEtaleLocalFactor f i U W g hg ≫
        (smallEtaleBaseChange (pullback.snd f i)).map (𝟙 _) ≫
        (etaleBaseChangeCompIso i (pullback.snd f i)
          (pullback.fst f i ≫ f) pullback.condition).inv.app U =
      (𝟙 _) ≫
        (smallEtaleBaseChange (pullback.fst f i)).map
          (etaleLocalFactorToBaseChange f U W g hg) ≫
        (etaleBaseChangeCompIso f (pullback.fst f i)
          (pullback.fst f i ≫ f) rfl).inv.app U := by
  simp [baseChangedEtaleLocalFactor, Category.assoc]

private theorem baseChangedEtaleLocalFactor_section {X Y Z : Scheme.{u}}
    (f : Y ⟶ X) (i : Z ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (U : X.Etale) (W : Y.Opens) (g : W.toScheme ⟶ U.left)
    (hg : W.ι ≫ f = g ≫ U.hom)
    (s : F.obj.obj (Opposite.op U)) :
    ((etalePullbackSquareIso f i).hom.app F).hom.app
        (Opposite.op ((smallEtaleBaseChange (pullback.fst f i)).obj
          ((AlgebraicGeometry.opensToEtale Y).obj W)))
      (pullbackSection (pullback.snd f i)
        ((smallEtaleInverseImage i).obj F)
        (baseChangedEtaleLocalFactor f i U W g hg)
        (pullbackSection i F (𝟙 _) s)) =
      pullbackSection (pullback.fst f i)
        ((smallEtaleInverseImage f).obj F) (𝟙 _)
        (pullbackSection f F (etaleLocalFactorToBaseChange f U W g hg) s) :=
  etalePullbackSquareIso_section f i F (𝟙 _)
    (baseChangedEtaleLocalFactor f i U W g hg)
    (etaleLocalFactorToBaseChange f U W g hg) (𝟙 _)
    (baseChangedEtaleLocalFactor_square f i U W g hg) s

private theorem finiteRefinement_local_section_agrees
    {X Y Z : Scheme.{u}} (f : Y ⟶ X) (i : Z ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (t : ((smallEtaleInverseImage i).obj F).obj.obj
      (Opposite.op (terminal Z.Etale)))
    (h : terminal (pullback f i).Etale ⟶
      (smallEtaleBaseChange (pullback.snd f i)).obj (terminal Z.Etale))
    {U : X.Etale} (s : F.obj.obj (Opposite.op U))
    (hs : pullbackSection i F (𝟙 _) s =
      ((smallEtaleInverseImage i).obj F).obj.map
        (terminal.from ((smallEtaleBaseChange i).obj U)).op t)
    (W : Y.Opens) (g : W.toScheme ⟶ U.left)
    (hg : W.ι ≫ f = g ≫ U.hom) :
    (((etalePullbackSquareIso f i).hom.app F).hom.app
      (Opposite.op ((smallEtaleBaseChange (pullback.fst f i)).obj
        ((AlgebraicGeometry.opensToEtale Y).obj W))))
      (((smallEtaleInverseImage (pullback.snd f i)).obj
        ((smallEtaleInverseImage i).obj F)).obj.map
          (terminal.from _).op
          (pullbackSection (pullback.snd f i)
            ((smallEtaleInverseImage i).obj F) h t)) =
      pullbackSection (pullback.fst f i)
        ((smallEtaleInverseImage f).obj F) (𝟙 _)
        (pullbackSection f F (etaleLocalFactorToBaseChange f U W g hg) s) := by
  let T := (smallEtaleInverseImage i).obj F
  let D := (smallEtaleBaseChange (pullback.fst f i)).obj
    ((AlgebraicGeometry.opensToEtale Y).obj W)
  let k := baseChangedEtaleLocalFactor f i U W g hg
  have hnat := NatTrans.naturality_apply
    ((etalePullbackSquareIso f i).hom.app F).hom (terminal.from D).op
      (pullbackSection (pullback.snd f i) T h t)
  have hpull : ((smallEtaleInverseImage (pullback.snd f i)).obj T).obj.map
      (terminal.from D).op (pullbackSection (pullback.snd f i) T h t) =
      pullbackSection (pullback.snd f i) T ((terminal.from D) ≫ h) t :=
    pullbackSection_map _ _ _ _ _
  have hk : (terminal.from D) ≫ h =
      k ≫ (smallEtaleBaseChange (pullback.snd f i)).map
        (terminal.from ((smallEtaleBaseChange i).obj U)) :=
    smallEtaleBaseChange_terminal_hom_ext _ _ _
  calc
    _ = ((etalePullbackSquareIso f i).hom.app F).hom.app (Opposite.op D)
        (pullbackSection (pullback.snd f i) T ((terminal.from D) ≫ h) t) := by
          rw [hpull]
    _ = ((etalePullbackSquareIso f i).hom.app F).hom.app (Opposite.op D)
        (pullbackSection (pullback.snd f i) T k
          (T.obj.map (terminal.from ((smallEtaleBaseChange i).obj U)).op t)) := by
          rw [hk, ← pullbackSection_restrict]
    _ = _ := by
      rw [← hs]
      exact baseChangedEtaleLocalFactor_section f i F U W g hg s

private theorem finiteRefinement_local_section_agrees_on
    {X Y Z : Scheme.{u}} (f : Y ⟶ X) (i : Z ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (t : ((smallEtaleInverseImage i).obj F).obj.obj
      (Opposite.op (terminal Z.Etale)))
    (h : terminal (pullback f i).Etale ⟶
      (smallEtaleBaseChange (pullback.snd f i)).obj (terminal Z.Etale))
    {U : X.Etale} (s : F.obj.obj (Opposite.op U))
    (hs : pullbackSection i F (𝟙 _) s =
      ((smallEtaleInverseImage i).obj F).obj.map
        (terminal.from ((smallEtaleBaseChange i).obj U)).op t)
    (W : Y.Opens) (g : W.toScheme ⟶ U.left)
    (hg : W.ι ≫ f = g ≫ U.hom)
    {V : (pullback f i).Etale}
    (q : V ⟶ (smallEtaleBaseChange (pullback.fst f i)).obj
      ((AlgebraicGeometry.opensToEtale Y).obj W))
    (hV : V ⟶
      (smallEtaleBaseChange (pullback.snd f i)).obj (terminal Z.Etale)) :
    ((etalePullbackSquareIso f i).hom.app F).hom.app (Opposite.op V)
      (pullbackSection (pullback.snd f i)
        ((smallEtaleInverseImage i).obj F) hV t) =
      pullbackSection (pullback.fst f i)
        ((smallEtaleInverseImage f).obj F) q
        (pullbackSection f F (etaleLocalFactorToBaseChange f U W g hg) s) := by
  let D := (smallEtaleBaseChange (pullback.fst f i)).obj
    ((AlgebraicGeometry.opensToEtale Y).obj W)
  let T := (smallEtaleInverseImage i).obj F
  have hh : hV = q ≫ terminal.from D ≫ h :=
    smallEtaleBaseChange_terminal_hom_ext _ _ _
  rw [hh, ← pullbackSection_map]
  have hn := NatTrans.naturality_apply
    ((etalePullbackSquareIso f i).hom.app F).hom q.op
      (pullbackSection (pullback.snd f i) T ((terminal.from D) ≫ h) t)
  change ((etalePullbackSquareIso f i).hom.app F).hom.app (Opposite.op V)
      (((smallEtaleInverseImage (pullback.snd f i)).obj T).obj.map q.op
        (pullbackSection (pullback.snd f i) T ((terminal.from D) ≫ h) t)) = _
  calc
    _ = (((smallEtaleInverseImage (pullback.fst f i)).obj
      ((smallEtaleInverseImage f).obj F)).obj.map q.op)
      (((etalePullbackSquareIso f i).hom.app F).hom.app (Opposite.op D)
        (pullbackSection (pullback.snd f i) T ((terminal.from D) ≫ h) t)) := by
          simpa only [Functor.comp_obj] using hn
    _ = (((smallEtaleInverseImage (pullback.fst f i)).obj
      ((smallEtaleInverseImage f).obj F)).obj.map q.op)
      (pullbackSection (pullback.fst f i)
        ((smallEtaleInverseImage f).obj F) (𝟙 _)
        (pullbackSection f F (etaleLocalFactorToBaseChange f U W g hg) s)) := by
          have h0 := finiteRefinement_local_section_agrees f i F t h s hs W g hg
          have hpull :
              (((smallEtaleInverseImage (pullback.snd f i)).obj T).obj.map
                (terminal.from D).op (pullbackSection (pullback.snd f i) T h t)) =
                pullbackSection (pullback.snd f i) T ((terminal.from D) ≫ h) t :=
            pullbackSection_map _ _ _ _ _
          rw [hpull] at h0
          exact congrArg _ h0
    _ = _ := by
      simpa only [pullbackSection_map, Category.comp_id] using
        (pullbackSection_map (pullback.fst f i)
          ((smallEtaleInverseImage f).obj F) (𝟙 D) q
          (pullbackSection f F (etaleLocalFactorToBaseChange f U W g hg) s))

private theorem exists_small_subsheaf_containing
    {C : Type u₁} [Category.{u₂} C] (J : GrothendieckTopology C)
    (F : Sheaf J (Type w))
    (𝒮 : ∀ U : C, Set (F.obj.obj (Opposite.op U)))
    (h𝒮 : ∀ U : C, Small.{max u₁ u₂} (𝒮 U)) :
    ∃ Q : Subfunctor F.obj,
      (∀ (U : C) (s : F.obj.obj (Opposite.op U)), s ∈ 𝒮 U →
        s ∈ Q.obj (Opposite.op U)) ∧
      FunctorToTypes.Small.{max u₁ u₂} Q.toFunctor ∧
      Presieve.IsSheaf J Q.toFunctor := by
  let K := J.toPrecoverage
  let Q := K.subsheafify 𝒮
  have hF : ∀ ⦃U : C⦄ (R : Presieve U), R ∈ K U →
      Presieve.IsSheafFor F.obj R := by
    intro U R hR
    exact (Presieve.isSheafFor_iff_generate R).2
      ((isSheaf_iff_isSheaf_of_type J F.obj).1 F.property (Sieve.generate R) hR)
  refine ⟨Q, ?_, Precoverage.small_subsheafify_of_small hF 𝒮 h𝒮, ?_⟩
  · intro U s hs
    exact Precoverage.SubsheafClosure.base hs
  · intro U R hR
    have hc : R.arrows ∈ K U := (J.arrows_mem_toPrecoverage_iff R).2 hR
    simpa [Presieve.isSheafFor_iff_generate] using
      Precoverage.isSheafFor_subsheafify 𝒮 hc (hF R.arrows hc)

private theorem exists_small_subsheaf_containing_sections
    {C : Type u₁} [Category.{u₂} C] (J : GrothendieckTopology C)
    (F : Sheaf J (Type w)) {I : Type u₁}
    (U : I → C) (a : ∀ i, F.obj.obj (Opposite.op (U i))) :
    ∃ Q : Subfunctor F.obj,
      (∀ i, a i ∈ Q.obj (Opposite.op (U i))) ∧
      FunctorToTypes.Small.{max u₁ u₂} Q.toFunctor ∧
      Presieve.IsSheaf J Q.toFunctor := by
  let 𝒮 (V : C) : Set (F.obj.obj (Opposite.op V)) :=
    Set.range (fun p : Σ i : I, V ⟶ U i => F.obj.map p.2.op (a p.1))
  have h𝒮 : ∀ V : C, Small.{max u₁ u₂} (𝒮 V) := by
    intro V
    infer_instance
  obtain ⟨Q, hQ, hsmall, hsheaf⟩ :=
    exists_small_subsheaf_containing J F 𝒮 h𝒮
  refine ⟨Q, ?_, hsmall, hsheaf⟩
  intro i
  apply hQ
  exact ⟨⟨i, 𝟙 (U i)⟩, by simp⟩

private noncomputable def smallSheafModel
    {C : Type u₁} [Category.{u₂} C] (J : GrothendieckTopology C)
    (F : Sheaf J (Type w))
    [FunctorToTypes.Small.{max u₁ u₂} F.obj] :
    Sheaf J (Type (max u₁ u₂)) := by
  let G := FunctorToTypes.shrink.{max u₁ u₂} F.obj
  have hG : Presieve.IsSheaf J G := by
    let e (U : C) : F.obj.obj (Opposite.op U) ≃ G.obj (Opposite.op U) := equivShrink _
    have he (U V : C) (f : U ⟶ V) (s : F.obj.obj (Opposite.op V)) :
        e U (F.obj.map f.op s) = G.map f.op (e V s) := by
      simp [e, G]
    intro U S hS
    rw [← Presieve.isSheafFor_iff_of_nat_equiv e he]
    exact (isSheaf_iff_isSheaf_of_type J F.obj).1 F.property S hS
  exact ⟨G, (isSheaf_iff_isSheaf_of_type J G).2 hG⟩

private def smallSheafModel_section
    {C : Type u₁} [Category.{u₂} C] (J : GrothendieckTopology C)
    (F : Sheaf J (Type w)) (Q : Subfunctor F.obj)
    (hQ : Presieve.IsSheaf J Q.toFunctor)
    [FunctorToTypes.Small.{max u₁ u₂} Q.toFunctor] (X : Cᵒᵖ) :
    (smallSheafModel.{w, u₁, u₂} J
      ⟨Q.toFunctor, (isSheaf_iff_isSheaf_of_type J Q.toFunctor).2 hQ⟩).obj.obj X →
      F.obj.obj X := by
  let : Small.{max u₁ u₂, w} (Q.toFunctor.obj X) :=
    small_lift.{w, max u₁ u₂, max u₁ u₂} (Q.toFunctor.obj X)
  exact fun s => ((equivShrink.{max u₁ u₂, w}
    (Q.toFunctor.obj X)).symm s).1

private theorem smallSheafModel_section_map
    {C : Type u₁} [Category.{u₂} C] (J : GrothendieckTopology C)
    (F : Sheaf J (Type w)) (Q : Subfunctor F.obj)
    (hQ : Presieve.IsSheaf J Q.toFunctor)
    [FunctorToTypes.Small.{max u₁ u₂} Q.toFunctor]
    {X Y : Cᵒᵖ} (f : X ⟶ Y)
    (s : (smallSheafModel.{w, u₁, u₂} J
      ⟨Q.toFunctor, (isSheaf_iff_isSheaf_of_type J Q.toFunctor).2 hQ⟩).obj.obj X) :
    smallSheafModel_section J F Q hQ Y
      ((smallSheafModel.{w, u₁, u₂} J
        ⟨Q.toFunctor, (isSheaf_iff_isSheaf_of_type J Q.toFunctor).2 hQ⟩).obj.map f s) =
      F.obj.map f (smallSheafModel_section J F Q hQ X s) := by
  simp only [smallSheafModel_section, smallSheafModel, FunctorToTypes.shrink,
    Subfunctor.toFunctor_map, TypeCat.hom_ofHom]
  exact congrArg Subtype.val (Equiv.symm_apply_apply _ _)

private theorem smallSheafModel_section_injective
    {C : Type u₁} [Category.{u₂} C] (J : GrothendieckTopology C)
    (F : Sheaf J (Type w)) (Q : Subfunctor F.obj)
    (hQ : Presieve.IsSheaf J Q.toFunctor)
    [FunctorToTypes.Small.{max u₁ u₂} Q.toFunctor] (X : Cᵒᵖ) :
    Function.Injective (smallSheafModel_section.{w, u₁, u₂} J F Q hQ X) := by
  let : Small.{max u₁ u₂, w} (Q.toFunctor.obj X) :=
    small_lift.{w, max u₁ u₂, max u₁ u₂} (Q.toFunctor.obj X)
  intro a b hab
  apply (equivShrink.{max u₁ u₂, w}
    (Q.toFunctor.obj X)).symm.injective
  apply Subtype.ext
  exact hab

private theorem smallSheafModel_section_surjective_on_subsheaf
    {C : Type u₁} [Category.{u₂} C] (J : GrothendieckTopology C)
    (F : Sheaf J (Type w)) (Q : Subfunctor F.obj)
    (hQ : Presieve.IsSheaf J Q.toFunctor)
    [FunctorToTypes.Small.{max u₁ u₂} Q.toFunctor] (X : Cᵒᵖ)
    (s : F.obj.obj X) (hs : s ∈ Q.obj X) :
    ∃ t, smallSheafModel_section.{w, u₁, u₂} J F Q hQ X t = s := by
  let : Small.{max u₁ u₂, w} (Q.toFunctor.obj X) :=
    small_lift.{w, max u₁ u₂, max u₁ u₂} (Q.toFunctor.obj X)
  refine ⟨equivShrink (Q.toFunctor.obj X) ⟨s, hs⟩, ?_⟩
  change ((equivShrink (Q.toFunctor.obj X)).symm
    ((equivShrink (Q.toFunctor.obj X)) ⟨s, hs⟩)).1 = s
  exact congrArg Subtype.val
    ((equivShrink (Q.toFunctor.obj X)).symm_apply_apply ⟨s, hs⟩)

private theorem zariskiSheaf_glue_open_cover
    {X : Type u₁} [TopologicalSpace X] [UnivLE.{u₁, t}]
    (F : Sheaf (Opens.grothendieckTopology X) (Type t))
    {I : Type u₂} (U : I → Opens X)
    (hU : ∀ x : X, ∃ i : I, x ∈ U i)
    (s : ∀ i, F.obj.obj (Opposite.op (U i)))
    (hs : ∀ i j, F.obj.map (homOfLE inf_le_left : U i ⊓ U j ⟶ U i).op (s i) =
      F.obj.map (homOfLE inf_le_right : U i ⊓ U j ⟶ U j).op (s j)) :
    ∃ t : F.obj.obj (Opposite.op (⊤ : Opens X)),
      ∀ i, F.obj.map (homOfLE le_top : U i ⟶ ⊤).op t = s i := by
  have hcover : (⊤ : Opens X) ≤ iSup U := by
    intro x _
    obtain ⟨i, hi⟩ := hU x
    exact (le_iSup U i) hi
  have hs' : TopCat.Presheaf.IsCompatible (X := TopCat.of X) F.obj U s := by
    intro i j
    convert hs i j using 1 <;> congr 1
  obtain ⟨t, ht, _⟩ :=
    (show (TopCat.of X).Sheaf (Type t) from F).existsUnique_gluing'
      U ⊤ (fun _ => homOfLE le_top) hcover s hs'
  exact ⟨t, ht⟩

private theorem zariskiSheaf_eq_of_locally_eq
    {X : Type u₁} [TopologicalSpace X] [UnivLE.{u₁, t}]
    (F : Sheaf (Opens.grothendieckTopology X) (Type t))
    (U : Opens X) (a b : F.obj.obj (Opposite.op U))
    (h : ∀ (x : X) (_hx : x ∈ U), ∃ (V : Opens X) (i : V ⟶ U),
      x ∈ V ∧ F.obj.map i.op a = F.obj.map i.op b) : a = b := by
  classical
  choose V i hV heq using fun x : U => h x.1 x.2
  have hc : U ≤ iSup V := by
    intro x hx
    exact (le_iSup V ⟨x, hx⟩) (hV ⟨x, hx⟩)
  exact (show (TopCat.of X).Sheaf (Type t) from F).eq_of_locally_eq'
    V U i hc a b heq

/-- The first projection of a base-changed morphism is the base change of the first projection. -/
private lemma smallEtale_baseChange_map_left_fst {W Z : Scheme.{u}} (p : W ⟶ Z)
    {A B : Z.Etale} (ψ : A ⟶ B) :
    ((smallEtaleBaseChange p).map ψ).left ≫ pullback.fst B.hom p =
      pullback.fst A.hom p ≫ ψ.left := pullback.lift_fst _ _ _

/-- Two morphisms into a threefold base change agree as soon as their iterated first projections
do:  every other component is forced by the structure morphisms. -/
private lemma smallEtale_hom_ext_triple_baseChange {X Y Z W : Scheme.{u}}
    (f : Y ⟶ X) (g : Z ⟶ Y) (h : W ⟶ Z) {A : X.Etale} {T : W.Etale}
    (m m' : T ⟶ (smallEtaleBaseChange h).obj
      ((smallEtaleBaseChange g).obj ((smallEtaleBaseChange f).obj A)))
    (hfst : m.left ≫
        pullback.fst ((smallEtaleBaseChange g).obj
          ((smallEtaleBaseChange f).obj A)).hom h ≫
        pullback.fst ((smallEtaleBaseChange f).obj A).hom g ≫
        pullback.fst A.hom f =
      m'.left ≫
        pullback.fst ((smallEtaleBaseChange g).obj
          ((smallEtaleBaseChange f).obj A)).hom h ≫
        pullback.fst ((smallEtaleBaseChange f).obj A).hom g ≫
        pullback.fst A.hom f) :
    m = m' := by
  have hlow : ∀ n : T ⟶ (smallEtaleBaseChange h).obj
      ((smallEtaleBaseChange g).obj ((smallEtaleBaseChange f).obj A)),
      (n.left ≫ pullback.fst ((smallEtaleBaseChange g).obj
          ((smallEtaleBaseChange f).obj A)).hom h) ≫
        pullback.snd ((smallEtaleBaseChange f).obj A).hom g = T.hom ≫ h := fun n =>
    (Category.assoc _ _ _).trans (smallEtale_baseChange_fst_comp h n)
  have hmid : ∀ n : T ⟶ (smallEtaleBaseChange h).obj
      ((smallEtaleBaseChange g).obj ((smallEtaleBaseChange f).obj A)),
      ((n.left ≫ pullback.fst ((smallEtaleBaseChange g).obj
            ((smallEtaleBaseChange f).obj A)).hom h) ≫
          pullback.fst ((smallEtaleBaseChange f).obj A).hom g) ≫
        pullback.snd A.hom f = (T.hom ≫ h) ≫ g := by
    intro n
    have c : pullback.fst ((smallEtaleBaseChange f).obj A).hom g ≫ pullback.snd A.hom f =
        pullback.snd ((smallEtaleBaseChange f).obj A).hom g ≫ g := pullback.condition
    have e1 : ((n.left ≫ pullback.fst ((smallEtaleBaseChange g).obj
            ((smallEtaleBaseChange f).obj A)).hom h) ≫
          pullback.fst ((smallEtaleBaseChange f).obj A).hom g) ≫
          pullback.snd A.hom f =
        (n.left ≫ pullback.fst ((smallEtaleBaseChange g).obj
            ((smallEtaleBaseChange f).obj A)).hom h) ≫
          pullback.fst ((smallEtaleBaseChange f).obj A).hom g ≫
          pullback.snd A.hom f := Category.assoc _ _ _
    have e2 : ((n.left ≫ pullback.fst ((smallEtaleBaseChange g).obj
            ((smallEtaleBaseChange f).obj A)).hom h) ≫
          pullback.fst ((smallEtaleBaseChange f).obj A).hom g) ≫
          pullback.snd A.hom f =
        (n.left ≫ pullback.fst ((smallEtaleBaseChange g).obj
            ((smallEtaleBaseChange f).obj A)).hom h) ≫
          pullback.snd ((smallEtaleBaseChange f).obj A).hom g ≫ g :=
      e1.trans (congrArg (fun t : ((smallEtaleBaseChange g).obj
        ((smallEtaleBaseChange f).obj A)).left ⟶ Y =>
          (n.left ≫ pullback.fst ((smallEtaleBaseChange g).obj
            ((smallEtaleBaseChange f).obj A)).hom h) ≫ t) c)
    have e3 : ((n.left ≫ pullback.fst ((smallEtaleBaseChange g).obj
            ((smallEtaleBaseChange f).obj A)).hom h) ≫
          pullback.fst ((smallEtaleBaseChange f).obj A).hom g) ≫
          pullback.snd A.hom f =
        ((n.left ≫ pullback.fst ((smallEtaleBaseChange g).obj
            ((smallEtaleBaseChange f).obj A)).hom h) ≫
          pullback.snd ((smallEtaleBaseChange f).obj A).hom g) ≫ g :=
      e2.trans (Category.assoc _ _ _).symm
    exact e3.trans (congrArg (fun t : T.left ⟶ Z => t ≫ g) (hlow n))
  refine smallEtale_hom_ext_baseChange h m m' ?_
  refine pullback.hom_ext ?_ ?_
  · refine pullback.hom_ext ?_ ?_
    · refine ((Category.assoc _ _ _).trans (Category.assoc _ _ _)).trans ?_
      exact hfst.trans ((Category.assoc _ _ _).trans (Category.assoc _ _ _)).symm
    · exact (hmid m).trans (hmid m').symm
  · exact (hlow m).trans (hlow m').symm

private theorem etalePullbackCompIso_assoc
    {X Y Z W : Scheme.{u}} (f : Y ⟶ X) (g : Z ⟶ Y) (h : W ⟶ Z)
    (p : Z ⟶ X) (hp : p = g ≫ f) (q : W ⟶ Y) (hq : q = h ≫ g)
    (r : W ⟶ X) (hr : r = q ≫ f) (hr' : r = h ≫ p) :
    Functor.isoWhiskerLeft (smallEtaleInverseImage f)
        (etalePullbackCompIso g h q hq) ≪≫ etalePullbackCompIso f q r hr =
      (Functor.associator _ _ _).symm ≪≫
        Functor.isoWhiskerRight (etalePullbackCompIso f g p hp)
          (smallEtaleInverseImage h) ≪≫
        etalePullbackCompIso p h r hr' := by
  apply Adjunction.leftAdjointCompIso_assoc
  apply Iso.ext
  apply NatTrans.ext
  funext F
  apply Sheaf.hom_ext
  apply NatTrans.ext
  funext U
  dsimp [etalePushforwardCompIso, Functor.sheafPushforwardContinuousComp',
    Functor.sheafPushforwardContinuousComp, Functor.sheafPushforwardContinuousIso,
    Functor.sheafPushforwardContinuousNatTrans]
  change F.obj.map _ ≫ F.obj.map _ = F.obj.map _ ≫ F.obj.map _
  simp only [← Functor.map_comp]
  congr 1
  apply Quiver.Hom.unop_inj
  simp only [unop_comp]
  apply MorphismProperty.Over.Hom.ext
  change ((etaleBaseChangeCompIso p h r hr').hom.app U.unop).left ≫
      ((smallEtaleBaseChange h).map
        ((etaleBaseChangeCompIso f g p hp).hom.app U.unop)).left =
    ((etaleBaseChangeCompIso f q r hr).hom.app U.unop).left ≫
      ((etaleBaseChangeCompIso g h q hq).hom.app
        ((smallEtaleBaseChange f).obj U.unop)).left
  have key : (etaleBaseChangeCompIso p h r hr').hom.app U.unop ≫
        (smallEtaleBaseChange h).map
          ((etaleBaseChangeCompIso f g p hp).hom.app U.unop) =
      (etaleBaseChangeCompIso f q r hr).hom.app U.unop ≫
        (etaleBaseChangeCompIso g h q hq).hom.app
          ((smallEtaleBaseChange f).obj U.unop) := by
    refine smallEtale_hom_ext_triple_baseChange f g h _ _ ?_
    let B2 := (smallEtaleBaseChange f).obj U.unop
    let B3 := (smallEtaleBaseChange g).obj B2
    let Bp := (smallEtaleBaseChange p).obj U.unop
    let cp := (etaleBaseChangeCompIso p h r hr').hom.app U.unop
    let ψ := (etaleBaseChangeCompIso f g p hp).hom.app U.unop
    let cq := (etaleBaseChangeCompIso f q r hr).hom.app U.unop
    let d := (etaleBaseChangeCompIso g h q hq).hom.app B2
    have hψ : ψ.left ≫ pullback.fst B2.hom g ≫ pullback.fst U.unop.hom f =
        pullback.fst U.unop.hom p :=
      etaleBaseChangeCompIso_hom_app_left_fst_fst f g p hp U.unop
    have hcp : cp.left ≫ pullback.fst Bp.hom h ≫ pullback.fst U.unop.hom p =
        pullback.fst U.unop.hom r :=
      etaleBaseChangeCompIso_hom_app_left_fst_fst p h r hr' U.unop
    have hcq : cq.left ≫ pullback.fst B2.hom q ≫ pullback.fst U.unop.hom f =
        pullback.fst U.unop.hom r :=
      etaleBaseChangeCompIso_hom_app_left_fst_fst f q r hr U.unop
    have hd : d.left ≫ pullback.fst B3.hom h ≫ pullback.fst B2.hom g =
        pullback.fst B2.hom q :=
      etaleBaseChangeCompIso_hom_app_left_fst_fst g h q hq B2
    have hmap : ((smallEtaleBaseChange h).map ψ).left ≫ pullback.fst B3.hom h =
        pullback.fst Bp.hom h ≫ ψ.left :=
      smallEtale_baseChange_map_left_fst h ψ
    have l1 : ((smallEtaleBaseChange h).map ψ).left ≫
          pullback.fst B3.hom h ≫ pullback.fst B2.hom g ≫ pullback.fst U.unop.hom f =
        (((smallEtaleBaseChange h).map ψ).left ≫ pullback.fst B3.hom h) ≫
          pullback.fst B2.hom g ≫ pullback.fst U.unop.hom f :=
      (Category.assoc _ _ _).symm
    have l2 : ((smallEtaleBaseChange h).map ψ).left ≫
          pullback.fst B3.hom h ≫ pullback.fst B2.hom g ≫ pullback.fst U.unop.hom f =
        (pullback.fst Bp.hom h ≫ ψ.left) ≫
          pullback.fst B2.hom g ≫ pullback.fst U.unop.hom f :=
      l1.trans (congrArg
        (fun t => t ≫ pullback.fst B2.hom g ≫ pullback.fst U.unop.hom f) hmap)
    have l3 : ((smallEtaleBaseChange h).map ψ).left ≫
          pullback.fst B3.hom h ≫ pullback.fst B2.hom g ≫ pullback.fst U.unop.hom f =
        pullback.fst Bp.hom h ≫ ψ.left ≫
          pullback.fst B2.hom g ≫ pullback.fst U.unop.hom f :=
      l2.trans (Category.assoc _ _ _)
    have l4 : ((smallEtaleBaseChange h).map ψ).left ≫
          pullback.fst B3.hom h ≫ pullback.fst B2.hom g ≫ pullback.fst U.unop.hom f =
        pullback.fst Bp.hom h ≫ pullback.fst U.unop.hom p :=
      l3.trans (congrArg (fun t => pullback.fst Bp.hom h ≫ t) hψ)
    have hLtot : (cp.left ≫ ((smallEtaleBaseChange h).map ψ).left) ≫
          (pullback.fst B3.hom h ≫ pullback.fst B2.hom g ≫
            pullback.fst U.unop.hom f) = pullback.fst U.unop.hom r :=
      (Category.assoc _ _ _).trans ((congrArg (fun t => cp.left ≫ t) l4).trans hcp)
    have d1 : d.left ≫
          pullback.fst B3.hom h ≫ pullback.fst B2.hom g ≫ pullback.fst U.unop.hom f =
        d.left ≫ (pullback.fst B3.hom h ≫ pullback.fst B2.hom g) ≫
          pullback.fst U.unop.hom f :=
      congrArg (fun t => d.left ≫ t) (Category.assoc _ _ _).symm
    have d2 : d.left ≫
          pullback.fst B3.hom h ≫ pullback.fst B2.hom g ≫ pullback.fst U.unop.hom f =
        (d.left ≫ pullback.fst B3.hom h ≫ pullback.fst B2.hom g) ≫
          pullback.fst U.unop.hom f :=
      d1.trans (Category.assoc _ _ _).symm
    have d3 : d.left ≫
          pullback.fst B3.hom h ≫ pullback.fst B2.hom g ≫ pullback.fst U.unop.hom f =
        pullback.fst B2.hom q ≫ pullback.fst U.unop.hom f :=
      d2.trans (congrArg (fun t => t ≫ pullback.fst U.unop.hom f) hd)
    have hRtot : (cq.left ≫ d.left) ≫
          (pullback.fst B3.hom h ≫ pullback.fst B2.hom g ≫
            pullback.fst U.unop.hom f) = pullback.fst U.unop.hom r :=
      (Category.assoc _ _ _).trans ((congrArg (fun t => cq.left ≫ t) d3).trans hcq)
    exact hLtot.trans hRtot.symm
  exact congrArg (fun m => m.left) key

private theorem etaleGlobalPullback_naturality {X Y : Scheme.{u}} (f : Y ⟶ X)
    {F G : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))}
    (φ : F ⟶ G) (s : (etaleGlobalSections X).obj F) :
    etaleGlobalPullback f G ((etaleGlobalSections X).map φ s) =
      (etaleGlobalSections Y).map ((smallEtaleInverseImage f).map φ)
        (etaleGlobalPullback f F s) := by
  have h := (globalSectionsSmallEtaleInverseImageComparison f).val.naturality φ
  exact congrArg (fun (a : (etaleGlobalSections X).obj F ⟶
    (etaleGlobalSections Y).obj ((smallEtaleInverseImage f).obj G)) => a s) h

private theorem relativeGlobalSectionsMap_comp
    {X Y Z W : Scheme.{u}} (f : Y ⟶ X) (g : Z ⟶ Y) (h : W ⟶ Z)
    (p : Z ⟶ X) (hp : p = g ≫ f) (q : W ⟶ Y) (hq : q = h ≫ g)
    (r : W ⟶ X) (hr : r = q ≫ f) (hr' : r = h ≫ p)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (s : (etaleGlobalSections Y).obj ((smallEtaleInverseImage f).obj F)) :
    relativeGlobalSectionsMap p h r hr' F (relativeGlobalSectionsMap f g p hp F s) =
      relativeGlobalSectionsMap f q r hr F s := by
  dsimp only [relativeGlobalSectionsMap, types_comp_apply]
  rw [etaleGlobalPullback_naturality]
  have hassoc := congrArg
    (fun e => (etaleGlobalSections W).map (e.hom.app F))
    (etalePullbackCompIso_assoc f g h p hp q hq r hr hr')
  have heq := ConcreteCategory.congr_hom hassoc
    (etaleGlobalPullback h _ (etaleGlobalPullback g _ s))
  simp only [Iso.trans_hom, NatTrans.comp_app, Iso.symm_hom, Functor.associator_inv_app,
    Functor.isoWhiskerRight_hom, Functor.isoWhiskerLeft_hom,
    Functor.whiskerLeft_app, Functor.whiskerRight_app,
    Category.id_comp, Functor.map_comp, types_comp_apply] at heq
  exact heq.symm.trans (congrArg
    (fun c => (etaleGlobalSections W).map ((etalePullbackCompIso f q r hr).hom.app F) c)
    (etaleGlobalPullback_comp g h q hq ((smallEtaleInverseImage f).obj F) s))

private theorem zariskiPullbackSection_map_restrict
    {X Z : Scheme.{u}} (i : Z ⟶ X) [UnivLE.{u, t}]
    (F : Sheaf (Opens.grothendieckTopology X.carrier) (Type t))
    {U U' : X.Opens} {V V' : Z.Opens} (a : U' ⟶ U) (b : V' ⟶ V)
    (g : V ⟶ (Opens.map i.base).obj U) (g' : V' ⟶ (Opens.map i.base).obj U')
    (s : F.obj.obj (Opposite.op U)) :
    (((Opens.map i.base).sheafPullback (Type t)
      (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).obj F).obj.map
      b.op (zariskiPullbackSection i F g s) =
      zariskiPullbackSection i F g' (F.obj.map a.op s) := by
  rw [zariskiPullbackSection_map, zariskiPullbackSection_restrict]
  congr 1

private theorem zariskiPullbackSection_eq_near_point
    {X Z : Scheme.{u}} (i : Z ⟶ X) [UnivLE.{u, t}]
    (F : Sheaf (Opens.grothendieckTopology X.carrier) (Type t))
    {U : X.Opens} {V : Z.Opens} (g : V ⟶ (Opens.map i.base).obj U)
    (a b : F.obj.obj (Opposite.op U))
    (h : zariskiPullbackSection i F g a = zariskiPullbackSection i F g b)
    (z : Z.carrier) (hz : z ∈ V) :
    ∃ (O : X.Opens) (f : O ⟶ U), i z ∈ O ∧ F.obj.map f.op a = F.obj.map f.op b := by
  let B := Opens.map i.base
  let J := Opens.grothendieckTopology Z.carrier
  let P := B.op.lan.obj F.obj
  let e := (Functor.sheafPullbackConstruction.sheafPullbackIso B
    (Type t) (Opens.grothendieckTopology X.carrier) J).app F
  have he (s : F.obj.obj (Opposite.op U)) :
      e.hom.hom.app (Opposite.op V) (zariskiPullbackSection i F g s) =
        (toSheafify J P).app (Opposite.op V)
          (P.map g.op ((B.op.lanUnit.app F.obj).app (Opposite.op U) s)) := by
    have hn := NatTrans.naturality_apply e.hom.hom g.op
      (((((Opens.map i.base).sheafAdjunctionContinuous (Type t)
        (Opens.grothendieckTopology X.carrier) J).unit.app F).hom.app (Opposite.op U)) s)
    have hu := ConcreteCategory.congr_hom (zariski_unit_pullbackIso i F U) s
    have ht := NatTrans.naturality_apply (toSheafify J P) g.op
      ((B.op.lanUnit.app F.obj).app (Opposite.op U) s)
    exact hn.trans ((congrArg (fun q => ((presheafToSheaf J (Type t)).obj P).obj.map
      g.op q) hu).trans ht.symm)
  have hh := (he a).symm.trans ((congrArg (e.hom.hom.app (Opposite.op V)) h).trans (he b))
  let := toSheafify_locally_injective_general J P
  have hcover := Presheaf.equalizerSieve_mem J (toSheafify J P) _ _ hh
  obtain ⟨W, k, hk, hzW⟩ := hcover z hz
  change P.map k.op _ = P.map k.op _ at hk
  have hk' : P.map (k ≫ g).op ((B.op.lanUnit.app F.obj).app (Opposite.op U) a) =
      P.map (k ≫ g).op ((B.op.lanUnit.app F.obj).app (Opposite.op U) b) := by
    simpa only [Presheaf.equalizerSieve, op_comp, Functor.map_comp, types_comp_apply] using hk
  obtain ⟨O, f, l, _, hab⟩ := (lan_eq_iff (Opens.map i.base) F.obj (k ≫ g) a b).1 hk'
  exact ⟨O, f, l.le hzW, hab⟩

private theorem zariskiPullbackSection_eq_iff_locally
    {X Z : Scheme.{u}} (i : Z ⟶ X) [UnivLE.{u, t}]
    (F : Sheaf (Opens.grothendieckTopology X.carrier) (Type t))
    {U : X.Opens} {V : Z.Opens} (g : V ⟶ (Opens.map i.base).obj U)
    (a b : F.obj.obj (Opposite.op U)) :
    zariskiPullbackSection i F g a = zariskiPullbackSection i F g b ↔
      ∀ z : Z.carrier, z ∈ V → ∃ (O : X.Opens) (f : O ⟶ U),
        i z ∈ O ∧ F.obj.map f.op a = F.obj.map f.op b := by
  constructor
  · exact fun h z hz => zariskiPullbackSection_eq_near_point i F g a b h z hz
  · intro h
    apply zariskiSheaf_eq_of_locally_eq
      (((Opens.map i.base).sheafPullback (Type t)
        (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).obj F) V
    intro z hz
    obtain ⟨O, f, hzO, hab⟩ := h z hz
    let W : Z.Opens := V ⊓ (Opens.map i.base).obj O
    let k : W ⟶ V := homOfLE inf_le_left
    let l : W ⟶ (Opens.map i.base).obj O := homOfLE inf_le_right
    refine ⟨W, k, ⟨hz, hzO⟩, ?_⟩
    rw [zariskiPullbackSection_map_restrict i F f k g l,
      zariskiPullbackSection_map_restrict i F f k g l, hab]

private theorem zariskiPullbackSection_eq_iff_of_injective_family
    {X Z : Scheme.{u}} (i : Z ⟶ X) [UnivLE.{u, t}]
    (S : Sheaf (Opens.grothendieckTopology X.carrier) (Type t))
    (R : Sheaf (Opens.grothendieckTopology X.carrier) (Type (max (u + 1) w)))
    (e : ∀ U : X.Opens, S.obj.obj (Opposite.op U) → R.obj.obj (Opposite.op U))
    (he : ∀ {U V : X.Opens} (f : U ⟶ V) (s : S.obj.obj (Opposite.op V)),
      e U (S.obj.map f.op s) = R.obj.map f.op (e V s))
    (hinj : ∀ U, Function.Injective (e U))
    {U : X.Opens} {V : Z.Opens} (g : V ⟶ (Opens.map i.base).obj U)
    (a b : S.obj.obj (Opposite.op U)) :
    zariskiPullbackSection i S g a = zariskiPullbackSection i S g b ↔
      zariskiPullbackSection i R g (e U a) = zariskiPullbackSection i R g (e U b) := by
  rw [zariskiPullbackSection_eq_iff_locally, zariskiPullbackSection_eq_iff_locally]
  constructor
  · intro h z hz
    obtain ⟨O, f, hzO, hab⟩ := h z hz
    exact ⟨O, f, hzO, (he f a).symm.trans ((congrArg (e O) hab).trans (he f b))⟩
  · intro h z hz
    obtain ⟨O, f, hzO, hab⟩ := h z hz
    exact ⟨O, f, hzO, hinj O ((he f a).trans (hab.trans (he f b).symm))⟩

private theorem zariskiPullbackSection_top
    {X Z : Scheme.{u}} (i : Z ⟶ X) [UnivLE.{u, t}]
    (F : Sheaf (Opens.grothendieckTopology X.carrier) (Type t))
    (s : F.obj.obj (Opposite.op (⊤ : X.Opens))) :
    zariskiPullbackSection i F (U := ⊤) (𝟙 _) s = zariskiGlobalSectionsMapAt i F s := by
  let H := ((Opens.map i.base).sheafPullback (Type t)
    (Opens.grothendieckTopology X.carrier) (Opens.grothendieckTopology Z.carrier)).obj F
  change H.obj.map (𝟙 (Opposite.op (⊤ : Z.Opens))) (zariskiGlobalSectionsMapAt i F s) = _
  exact ConcreteCategory.congr_hom (H.obj.map_id _) (zariskiGlobalSectionsMapAt i F s)

private theorem etale_global_section_lifts_of_zariski_local_lifts_small
    {X Z : Scheme.{u}} (i : Z ⟶ X)
    (hZar : ∀ S : Sheaf (Opens.grothendieckTopology X.carrier)
      (Type u), Function.Bijective (zariskiGlobalSectionsMapAt i S))
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) w)))
    (t : (etaleZariskiRestriction ((smallEtaleInverseImage i).obj F)).obj.obj
      (Opposite.op (⊤ : Z.Opens)))
    (hl : ∀ z : Z.carrier, ∃ (V : Z.Opens) (_ : z ∈ V) (U : X.Opens)
      (g : V ⟶ (Opens.map i.base).obj U)
      (a : F.obj.obj (Opposite.op ((AlgebraicGeometry.opensToEtale X).obj U))),
      pullbackSection i F
          ((AlgebraicGeometry.opensToEtale Z).map g ≫ opensEtaleBaseChangeMap i U) a =
        (etaleZariskiRestriction ((smallEtaleInverseImage i).obj F)).obj.map
          (homOfLE (show V ≤ ⊤ from le_top)).op t) :
    ∃ s : F.obj.obj (Opposite.op ((AlgebraicGeometry.opensToEtale X).obj ⊤)),
      pullbackSection i F (opensEtaleBaseChangeMap i ⊤) s = t := by
  classical
  choose V hzV U g a ha using hl
  let R := etaleZariskiRestriction F
  let G := etaleZariskiRestriction ((smallEtaleInverseImage i).obj F)
  let α := (etaleZariskiComparison i F).hom
  have hα (z : Z.carrier) : α.app (Opposite.op (V z))
      (zariskiPullbackSection i R (g z) (a z)) =
      G.obj.map (homOfLE le_top : V z ⟶ ⊤).op t :=
    (etaleZariskiComparison_section i F (g z) (a z)).trans (ha z)
  let J := Opens.grothendieckTopology X.carrier
  obtain ⟨Q, hQa, hQsmall, hQsheaf⟩ := exists_small_subsheaf_containing_sections J R U a
  let := hQsmall
  let S : Sheaf J (Type u) :=
    smallSheafModel J ⟨Q.toFunctor, (isSheaf_iff_isSheaf_of_type _ _).2 hQsheaf⟩
  let e (W : X.Opens) : S.obj.obj (Opposite.op W) → R.obj.obj (Opposite.op W) :=
    smallSheafModel_section J R Q hQsheaf (Opposite.op W)
  have he {W W' : X.Opens} (f : W ⟶ W') (s : S.obj.obj (Opposite.op W')) :
      e W (S.obj.map f.op s) = R.obj.map f.op (e W' s) :=
    smallSheafModel_section_map J R Q hQsheaf f.op s
  have hinj (W : X.Opens) : Function.Injective (e W) :=
    smallSheafModel_section_injective J R Q hQsheaf (Opposite.op W)
  have hex (z : Z.carrier) : ∃ s : S.obj.obj (Opposite.op (U z)), e (U z) s = a z :=
    smallSheafModel_section_surjective_on_subsheaf J R Q hQsheaf _ (a z) (hQa z)
  choose aS haS using hex
  let B := ((Opens.map i.base).sheafPullback (Type u) J
    (Opens.grothendieckTopology Z.carrier)).obj S
  let b (z : Z.carrier) : B.obj.obj (Opposite.op (V z)) := zariskiPullbackSection i S (g z) (aS z)
  have hb : ∀ z z', B.obj.map (homOfLE inf_le_left : V z ⊓ V z' ⟶ V z).op (b z) =
      B.obj.map (homOfLE inf_le_right : V z ⊓ V z' ⟶ V z').op (b z') := by
    intro z z'
    let V₀ := V z ⊓ V z'
    let U₀ := U z ⊓ U z'
    let v₁ : V₀ ⟶ V z := homOfLE inf_le_left
    let v₂ : V₀ ⟶ V z' := homOfLE inf_le_right
    let u₁ : U₀ ⟶ U z := homOfLE inf_le_left
    let u₂ : U₀ ⟶ U z' := homOfLE inf_le_right
    let k : V₀ ⟶ (Opens.map i.base).obj U₀ := homOfLE (by
      intro x hx
      exact ⟨(g z).le hx.1, (g z').le hx.2⟩)
    change B.obj.map v₁.op (zariskiPullbackSection i S (g z) (aS z)) =
      B.obj.map v₂.op (zariskiPullbackSection i S (g z') (aS z'))
    rw [zariskiPullbackSection_map_restrict i S u₁ v₁ (g z) k,
      zariskiPullbackSection_map_restrict i S u₂ v₂ (g z') k]
    apply (zariskiPullbackSection_eq_iff_of_injective_family i S R e he hinj k _ _).2
    rw [he, he, haS, haS]
    apply etaleZariskiComparison_injective i F V₀
    have hside : ∀ (z₀ : Z.carrier) (v : V₀ ⟶ V z₀) (u : U₀ ⟶ U z₀),
        α.app (Opposite.op V₀)
            (zariskiPullbackSection i R k (R.obj.map u.op (a z₀))) =
          G.obj.map (v ≫ (homOfLE le_top : V z₀ ⟶ ⊤)).op t := by
      intro z₀ v u
      have hr := zariskiPullbackSection_map_restrict i R u v (g z₀) k (a z₀)
      have hn := NatTrans.naturality_apply α v.op
        (zariskiPullbackSection i R (g z₀) (a z₀))
      refine (congrArg (α.app (Opposite.op V₀)) hr.symm).trans ?_
      refine hn.trans ?_
      refine (congrArg (fun c => G.obj.map v.op c) (hα z₀)).trans ?_
      exact (Functor.map_comp_apply G.obj
        (homOfLE (le_top : V z₀ ≤ ⊤)).op v.op t).symm
    exact (hside z v₁ u₁).trans
      ((congrArg (fun m : V₀ ⟶ (⊤ : Z.Opens) => G.obj.map m.op t)
        (Subsingleton.elim (v₁ ≫ (homOfLE le_top : V z ⟶ ⊤))
          (v₂ ≫ (homOfLE le_top : V z' ⟶ ⊤)))).trans (hside z' v₂ u₂).symm)
  obtain ⟨b₀, hb₀⟩ := zariskiSheaf_glue_open_cover B V (fun z => ⟨z, hzV z⟩) b hb
  obtain ⟨s, hs⟩ := (hZar S).2 b₀
  have hsV (z : Z.carrier) :
      zariskiPullbackSection i S (g z)
          (S.obj.map (homOfLE le_top : U z ⟶ ⊤).op s) =
        zariskiPullbackSection i S (g z) (aS z) := by
    refine (zariskiPullbackSection_map_restrict i S
      (homOfLE le_top : U z ⟶ ⊤) (homOfLE le_top : V z ⟶ ⊤) (𝟙 _) (g z) s).symm.trans ?_
    refine (congrArg (fun c => B.obj.map (homOfLE le_top : V z ⟶ ⊤).op c)
      ((zariskiPullbackSection_top i S s).trans hs)).trans ?_
    exact hb₀ z
  have hsR (z : Z.carrier) :
      zariskiPullbackSection i R (g z)
          (R.obj.map (homOfLE le_top : U z ⟶ ⊤).op (e ⊤ s)) =
        zariskiPullbackSection i R (g z) (a z) := by
    have h := (zariskiPullbackSection_eq_iff_of_injective_family i S R e he hinj
      (g z) _ _).1 (hsV z)
    simpa only [he, haS] using h
  refine ⟨e ⊤ s, ?_⟩
  have hglobal : α.app (Opposite.op ⊤) (zariskiGlobalSectionsMapAt i R (e ⊤ s)) = t := by
    apply zariskiSheaf_eq_of_locally_eq G ⊤
    intro z _
    let v : V z ⟶ ⊤ := homOfLE le_top
    let HR := ((Opens.map i.base).sheafPullback (Type (max (u + 1) w))
      (Opens.grothendieckTopology X.carrier)
      (Opens.grothendieckTopology Z.carrier)).obj R
    refine ⟨V z, v, hzV z, ?_⟩
    have h1 : HR.obj.map v.op (zariskiGlobalSectionsMapAt i R (e ⊤ s)) =
        zariskiPullbackSection i R (g z) (a z) :=
      (congrArg (fun c => HR.obj.map v.op c)
          (zariskiPullbackSection_top i R (e ⊤ s)).symm).trans
        ((zariskiPullbackSection_map_restrict i R
          (homOfLE le_top : U z ⟶ ⊤) v (𝟙 _) (g z) (e ⊤ s)).trans (hsR z))
    exact (NatTrans.naturality_apply α v.op
        (zariskiGlobalSectionsMapAt i R (e ⊤ s))).symm.trans
      ((congrArg (α.app (Opposite.op (V z))) h1).trans
        ((etaleZariskiComparison_section i F (g z) (a z)).trans (ha z)))
  exact (etaleZariskiComparison_unit i F ⊤ (e ⊤ s)).symm.trans hglobal

private theorem exists_finite_lift_of_global_section
    {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    [CompactSpace X] [QuasiSeparatedSpace X]
    (hZar : ∀ R : Sheaf (Opens.grothendieckTopology X.carrier)
      (Type u), Function.Bijective (zariskiGlobalSectionsMapAt i R))
    (hFinite : ∀ {Y : Scheme.{u}} (f : Y ⟶ X) [IsFinite f],
      ∀ R : Sheaf (Opens.grothendieckTopology Y.carrier)
        (Type u),
        Function.Bijective (zariskiGlobalSectionsMapAt (pullback.fst f i) R))
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) w)))
    (t₀ : ((smallEtaleInverseImage i).obj F).obj.obj
      (Opposite.op (terminal Z.Etale))) :
    ∃ (Y : Scheme.{u}) (f : Y ⟶ X), IsFinite f ∧ Surjective f ∧
      ∃ (h : terminal (pullback f i).Etale ⟶
          (smallEtaleBaseChange (pullback.snd f i)).obj (terminal Z.Etale))
        (sY : ((smallEtaleInverseImage f).obj F).obj.obj
          (Opposite.op ((AlgebraicGeometry.opensToEtale Y).obj ⊤))),
        pullbackSection (pullback.fst f i)
          ((smallEtaleInverseImage f).obj F)
          (opensEtaleBaseChangeMap (pullback.fst f i) ⊤) sY =
        ((etalePullbackSquareIso f i).hom.app F).hom.app
          (Opposite.op ((AlgebraicGeometry.opensToEtale (pullback f i)).obj ⊤))
          (pullbackSection (pullback.snd f i)
            ((smallEtaleInverseImage i).obj F)
            (terminal.from _ ≫ h) t₀) := by
  obtain ⟨I, U, s, hs, hc⟩ := smallEtaleGlobalSection_has_strict_lifting_family i F t₀
  let : Surjective (Sigma.desc fun j => (U j).hom) :=
    smallEtaleLiftFamily_surjective i hZar U
      (fun j => (smallEtaleBaseChange i).obj (U j)) (fun _ => 𝟙 _) hc
  obtain ⟨Y, f, hf, hsur, hlocal⟩ := exists_finite_refinement_of_etale_family U
  let := hf
  let := hsur
  have hZar' := hFinite f
  let P := pullback f i
  let i' : P ⟶ Y := pullback.fst f i
  let p : P ⟶ Z := pullback.snd f i
  let F' := (smallEtaleInverseImage f).obj F
  let T := (smallEtaleInverseImage i).obj F
  let T' := (smallEtaleInverseImage i').obj F'
  obtain ⟨h⟩ := smallEtaleBaseChange_terminal_hom_exists p
  let A := (AlgebraicGeometry.opensToEtale P).obj (⊤ : P.Opens)
  let tP : T'.obj.obj (Opposite.op A) :=
    ((etalePullbackSquareIso f i).hom.app F).hom.app (Opposite.op A)
      (pullbackSection p T ((terminal.from A) ≫ h) t₀)
  have hl : ∀ z : P.carrier, ∃ (V : P.Opens) (_ : z ∈ V) (W : Y.Opens)
      (g : V ⟶ (Opens.map i'.base).obj W)
      (a : F'.obj.obj (Opposite.op ((AlgebraicGeometry.opensToEtale Y).obj W))),
      pullbackSection i' F'
        ((AlgebraicGeometry.opensToEtale P).map g ≫ opensEtaleBaseChangeMap i' W) a =
        T'.obj.map ((AlgebraicGeometry.opensToEtale P).map
          (homOfLE (show V ≤ ⊤ from le_top))).op tP := by
    intro z
    obtain ⟨j, W, hzW, g, hg⟩ := hlocal (i' z)
    let V : P.Opens := (Opens.map i'.base).obj W
    let q := opensEtaleBaseChangeMap i' W
    let a : F'.obj.obj (Opposite.op ((AlgebraicGeometry.opensToEtale Y).obj W)) :=
      pullbackSection f F (etaleLocalFactorToBaseChange f (U j) W g hg) (s j)
    refine ⟨V, hzW, W, 𝟙 _, a, ?_⟩
    let r := (AlgebraicGeometry.opensToEtale P).map (homOfLE (show V ≤ ⊤ from le_top))
    have hr : r ≫ terminal.from A ≫ h =
        q ≫ terminal.from ((smallEtaleBaseChange i').obj
          ((AlgebraicGeometry.opensToEtale Y).obj W)) ≫ h :=
      smallEtaleBaseChange_terminal_hom_ext _ _ _
    have heq := finiteRefinement_local_section_agrees_on f i F t₀ h
      (s j) (hs j) W g hg q (r ≫ terminal.from A ≫ h)
    have hn := NatTrans.naturality_apply
      ((etalePullbackSquareIso f i).hom.app F).hom r.op
        (pullbackSection p T (terminal.from A ≫ h) t₀)
    change pullbackSection i' F' ((AlgebraicGeometry.opensToEtale P).map (𝟙 V) ≫ q) a =
      T'.obj.map r.op tP
    rw [(AlgebraicGeometry.opensToEtale P).map_id V, Category.id_comp, ← heq,
      ← pullbackSection_map p T (terminal.from A ≫ h) r t₀]
    simpa only [Functor.comp_obj, smallEtaleInverseImage,
      p, i', T, T', F', A, V, tP] using hn
  obtain ⟨sY, hsY⟩ :=
    etale_global_section_lifts_of_zariski_local_lifts_small i' hZar' F' tP hl
  exact ⟨Y, f, hf, hsur, h, sY, hsY⟩

/-- The identity, viewed in the small étale site, is a terminal object. -/
private def etaleIdIsTerminal (X : Scheme.{u}) :
    IsTerminal (Scheme.Etale.mk (𝟙 X)) :=
  let : MorphismProperty.ContainsIdentities (@Etale : MorphismProperty Scheme.{u}) :=
    ⟨fun _ => inferInstance⟩
  MorphismProperty.Over.mkIdTerminal @Etale X

private def etaleTopIso (X : Scheme.{u}) :
    (AlgebraicGeometry.opensToEtale X).obj ⊤ ≅ terminal X.Etale :=
  (MorphismProperty.Over.isoMk (A := (AlgebraicGeometry.opensToEtale X).obj ⊤)
      (B := Scheme.Etale.mk (𝟙 X)) X.topIso
      (by change X.topIso.hom ≫ 𝟙 X = (⊤ : X.Opens).ι; simp)) ≪≫
    (etaleIdIsTerminal X).uniqueUpToIso terminalIsTerminal

private abbrev etaleGlobalEvaluationTop {X : Scheme.{u}}
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))) :=
  (etaleGlobalEvaluation F).hom ≫ F.obj.map (etaleTopIso X).hom.op

private theorem etaleGlobalEvaluationTop_bijective {X : Scheme.{u}}
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))) :
    Function.Bijective (etaleGlobalEvaluationTop F) :=
  ConcreteCategory.bijective_of_isIso _

private theorem etaleGlobalEvaluationTop_map {X : Scheme.{u}}
    {F G : Sheaf X.smallEtaleTopology (Type (max (u + 1) v))}
    (φ : F ⟶ G) (s : (etaleGlobalSections X).obj F) :
    etaleGlobalEvaluationTop G ((etaleGlobalSections X).map φ s) =
      φ.hom.app (Opposite.op ((AlgebraicGeometry.opensToEtale X).obj ⊤))
        (etaleGlobalEvaluationTop F s) := by
  dsimp only [etaleGlobalEvaluationTop, types_comp_apply]
  rw [etaleGlobalEvaluation_map]
  exact (NatTrans.naturality_apply φ.hom (etaleTopIso X).hom.op _).symm

private theorem etaleGlobalEvaluationTop_pullback {X Y : Scheme.{u}} (f : Y ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (s : (etaleGlobalSections X).obj F) :
    etaleGlobalEvaluationTop _ (etaleGlobalPullback f F s) =
      pullbackSection f F (opensEtaleBaseChangeMap f ⊤) (etaleGlobalEvaluationTop F s) := by
  obtain ⟨g⟩ := smallEtaleBaseChange_terminal_hom_exists f
  dsimp only [etaleGlobalEvaluationTop, types_comp_apply]
  rw [etaleGlobalPullback_evaluation f F g]
  refine (pullbackSection_map f F g (etaleTopIso Y).hom
    ((etaleGlobalEvaluation F).hom s)).trans ?_
  refine Eq.trans ?_ (pullbackSection_restrict f F (etaleTopIso X).hom
    (opensEtaleBaseChangeMap f ⊤) ((etaleGlobalEvaluation F).hom s)).symm
  congr 1
  exact smallEtaleBaseChange_terminal_hom_ext _ _ _

/-- The square identification, followed by the composition isomorphism for the factorization
through `f`, is the composition isomorphism for the factorization through `i`. -/
private lemma etalePullbackSquareIso_hom_comp {X Y Z : Scheme.{u}} (f : Y ⟶ X) (i : Z ⟶ X)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) w))) :
    (etalePullbackSquareIso.{u, w} f i).hom.app F ≫
        (etalePullbackCompIso.{u, w} f (pullback.fst f i)
          (pullback.fst f i ≫ f) rfl).hom.app F =
      (etalePullbackCompIso.{u, w} i (pullback.snd f i) (pullback.fst f i ≫ f)
        pullback.condition).hom.app F := by
  dsimp only [etalePullbackSquareIso, Iso.trans_hom, Iso.symm_hom, NatTrans.comp_app]
  simp only [Category.assoc, Iso.inv_hom_id_app, Category.comp_id]

private theorem exists_relative_finite_lift
    {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    [CompactSpace X] [QuasiSeparatedSpace X]
    (hZar : ∀ R : Sheaf (Opens.grothendieckTopology X.carrier)
      (Type u), Function.Bijective (zariskiGlobalSectionsMapAt i R))
    (hFinite : ∀ {Y : Scheme.{u}} (f : Y ⟶ X) [IsFinite f],
      ∀ R : Sheaf (Opens.grothendieckTopology Y.carrier)
        (Type u),
        Function.Bijective (zariskiGlobalSectionsMapAt (pullback.fst f i) R))
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) w)))
    (t : (etaleGlobalSections Z).obj ((smallEtaleInverseImage i).obj F)) :
    ∃ (Y : Scheme.{u}) (f : Y ⟶ X), IsFinite f ∧ Surjective f ∧
      ∃ s : (etaleGlobalSections Y).obj ((smallEtaleInverseImage f).obj F),
        relativeGlobalSectionsMap f (pullback.fst f i) (pullback.fst f i ≫ f) rfl F s =
          relativeGlobalSectionsMap i (pullback.snd f i) (pullback.fst f i ≫ f)
            pullback.condition F t := by
  obtain ⟨Y, f, hf, hsur, h, sY, hsY⟩ :=
    exists_finite_lift_of_global_section i hZar hFinite F ((etaleGlobalEvaluation _).hom t)
  obtain ⟨s, hs⟩ := (etaleGlobalEvaluationTop_bijective _).2 sY
  refine ⟨Y, f, hf, hsur, s, ?_⟩
  have he : etaleGlobalPullback (pullback.fst f i) _ s =
      (etaleGlobalSections (pullback f i)).map ((etalePullbackSquareIso f i).hom.app F)
        (etaleGlobalPullback (pullback.snd f i) _ t) := by
    apply (etaleGlobalEvaluationTop_bijective _).1
    rw [etaleGlobalEvaluationTop_pullback, hs]
    refine Eq.trans ?_ (etaleGlobalEvaluationTop_map _ _).symm
    dsimp only [etaleGlobalEvaluationTop, types_comp_apply]
    dsimp only [Functor.comp_obj]
    have heval := etaleGlobalPullback_evaluation (pullback.snd f i)
      ((smallEtaleInverseImage i).obj F) h t
    rw [heval]
    have hmap := pullbackSection_map (pullback.snd f i)
      ((smallEtaleInverseImage i).obj F) h
      (etaleTopIso (pullback f i)).hom ((etaleGlobalEvaluation _).hom t)
    rw [hmap]
    have htop : (etaleTopIso (pullback f i)).hom = terminal.from _ :=
      terminal.hom_ext _ _
    rw [htop]
    exact hsY
  dsimp only [relativeGlobalSectionsMap, types_comp_apply]
  rw [he]
  refine (Functor.map_comp_apply (etaleGlobalSections.{u, w} (pullback f i))
    ((etalePullbackSquareIso.{u, w} f i).hom.app F)
    ((etalePullbackCompIso.{u, w} f (pullback.fst f i)
      (pullback.fst f i ≫ f) rfl).hom.app F)
    (etaleGlobalPullback.{u, w} (pullback.snd f i)
      ((smallEtaleInverseImage i).obj F) t)).symm.trans ?_
  exact congrArg
    (fun φ => (etaleGlobalSections.{u, w} (pullback f i)).map φ
      (etaleGlobalPullback.{u, w} (pullback.snd f i)
        ((smallEtaleInverseImage i).obj F) t))
    (etalePullbackSquareIso_hom_comp.{u, w} f i F)

private theorem relative_finite_lift_base_change
    {X Y Z N : Scheme.{u}} (f : Y ⟶ X) (i : Z ⟶ X)
    (k : N ⟶ Y) (p : N ⟶ X) (hp : p = k ≫ f)
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (s : (etaleGlobalSections Y).obj ((smallEtaleInverseImage f).obj F))
    (t : (etaleGlobalSections Z).obj ((smallEtaleInverseImage i).obj F))
    (hs : relativeGlobalSectionsMap f (pullback.fst f i) (pullback.fst f i ≫ f) rfl F s =
      relativeGlobalSectionsMap i (pullback.snd f i) (pullback.fst f i ≫ f)
        pullback.condition F t) :
    relativeGlobalSectionsMap p (pullback.fst p i) (pullback.fst p i ≫ p) rfl F
        (relativeGlobalSectionsMap f k p hp F s) =
      relativeGlobalSectionsMap i (pullback.snd p i) (pullback.fst p i ≫ p)
        pullback.condition F t := by
  let l : pullback p i ⟶ pullback f i :=
    pullback.lift (pullback.fst p i ≫ k) (pullback.snd p i)
      (by rw [Category.assoc, ← hp, pullback.condition])
  have hlf : l ≫ pullback.fst f i = pullback.fst p i ≫ k := pullback.lift_fst _ _ _
  have hls : l ≫ pullback.snd f i = pullback.snd p i := pullback.lift_snd _ _ _
  have hpk : pullback.fst p i ≫ p = (pullback.fst p i ≫ k) ≫ f :=
    (congrArg (fun t : N ⟶ X => pullback.fst p i ≫ t) hp).trans
      (Category.assoc _ _ _).symm
  have hl : pullback.fst p i ≫ p = l ≫ (pullback.fst f i ≫ f) := by
    rw [reassoc_of% hlf, hpk, Category.assoc]
  have ha := relativeGlobalSectionsMap_comp f k (pullback.fst p i) p hp
    (pullback.fst p i ≫ k) rfl (pullback.fst p i ≫ p) hpk rfl F s
  have hb := relativeGlobalSectionsMap_comp f (pullback.fst f i) l
    (pullback.fst f i ≫ f) rfl (pullback.fst p i ≫ k) hlf.symm
    (pullback.fst p i ≫ p) hpk hl F s
  have hc := relativeGlobalSectionsMap_comp i (pullback.snd f i) l
    (pullback.fst f i ≫ f) pullback.condition (pullback.snd p i) hls.symm
    (pullback.fst p i ≫ p) pullback.condition hl F t
  exact ha.trans (hb.symm.trans ((congrArg
    (relativeGlobalSectionsMap (pullback.fst f i ≫ f) l
      (pullback.fst p i ≫ p) hl F) hs).trans hc))

private theorem relativeGlobalSectionsMap_injective_of_zariski
    {X Y Z : Scheme.{u}} (f : Y ⟶ X) (g : Z ⟶ Y)
    (p : Z ⟶ X) (hp : p = g ≫ f)
    (hZar : ∀ R : Sheaf (Opens.grothendieckTopology Y.carrier)
      (Type u), Function.Bijective (zariskiGlobalSectionsMapAt g R))
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) w))) :
    Function.Injective (relativeGlobalSectionsMap f g p hp F) := by
  obtain ⟨k⟩ := smallEtaleBaseChange_terminal_hom_exists g
  have hi := smallEtaleGlobalSectionsMapAt_injective g hZar k
    ((smallEtaleInverseImage f).obj F)
  rw [← (globalSectionsSmallEtaleInverseImageComparison g).property _ k] at hi
  exact (ConcreteCategory.bijective_of_isIso
    ((etaleGlobalSections Z).map ((etalePullbackCompIso f g p hp).hom.app F))).1.comp hi

private theorem relative_finite_lift_compatible
    {X Y Z : Scheme.{u}} (f : Y ⟶ X) (i : Z ⟶ X) [IsFinite f]
    (hFinite : ∀ {Y : Scheme.{u}} (f : Y ⟶ X) [IsFinite f],
      ∀ R : Sheaf (Opens.grothendieckTopology Y.carrier)
        (Type u),
        Function.Bijective (zariskiGlobalSectionsMapAt (pullback.fst f i) R))
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) w)))
    (s : (etaleGlobalSections Y).obj ((smallEtaleInverseImage f).obj F))
    (t : (etaleGlobalSections Z).obj ((smallEtaleInverseImage i).obj F))
    (hs : relativeGlobalSectionsMap f (pullback.fst f i) (pullback.fst f i ≫ f) rfl F s =
      relativeGlobalSectionsMap i (pullback.snd f i) (pullback.fst f i ≫ f)
        pullback.condition F t) :
    relativeGlobalSectionsMap f (pullback.fst f f) (pullback.fst f f ≫ f) rfl F s =
      relativeGlobalSectionsMap f (pullback.snd f f) (pullback.fst f f ≫ f)
        pullback.condition F s := by
  let p := pullback.fst f f ≫ f
  let : IsFinite p := inferInstance
  have hc₀ := relative_finite_lift_base_change f i (pullback.fst f f) p rfl F s t hs
  have hc₁ := relative_finite_lift_base_change f i (pullback.snd f f) p
    pullback.condition F s t hs
  have heq : relativeGlobalSectionsMap f (pullback.fst f f) p rfl F s =
      relativeGlobalSectionsMap f (pullback.snd f f) p pullback.condition F s := by
    apply relativeGlobalSectionsMap_injective_of_zariski p (pullback.fst p i)
      (pullback.fst p i ≫ p) rfl (hFinite p) F
    exact hc₀.trans hc₁.symm
  exact heq

private theorem finite_lift_section_eq
    {X Y Z : Scheme.{u}} (f : Y ⟶ X) (i : Z ⟶ X) [IsFinite f] [Surjective f]
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) v)))
    (s : (etaleGlobalSections Y).obj ((smallEtaleInverseImage f).obj F))
    (t : (etaleGlobalSections Z).obj ((smallEtaleInverseImage i).obj F))
    (hs : relativeGlobalSectionsMap f (pullback.fst f i) (pullback.fst f i ≫ f) rfl F s =
      relativeGlobalSectionsMap i (pullback.snd f i) (pullback.fst f i ≫ f)
        pullback.condition F t)
    (sX : (etaleGlobalSections X).obj F) (hsX : etaleGlobalPullback f F sX = s) :
    etaleGlobalPullback i F sX = t := by
  apply etaleGlobalPullback_injective_of_finite_surjective (pullback.snd f i) _
  apply (ConcreteCategory.bijective_of_isIso
    ((etaleGlobalSections (pullback f i)).map
      ((etalePullbackCompIso i (pullback.snd f i) (pullback.fst f i ≫ f)
        pullback.condition).hom.app F))).1
  change relativeGlobalSectionsMap i (pullback.snd f i)
      (pullback.fst f i ≫ f) pullback.condition F (etaleGlobalPullback i F sX) = _
  rw [relativeGlobalSectionsMap_pullback,
    ← relativeGlobalSectionsMap_pullback f (pullback.fst f i)
      (pullback.fst f i ≫ f) rfl F sX]
  exact (congrArg (fun c => relativeGlobalSectionsMap f (pullback.fst f i)
    (pullback.fst f i ≫ f) rfl F c) hsX).trans hs

private theorem relative_finite_lift_descends
    {X Y Z : Scheme.{u}} (f : Y ⟶ X) (i : Z ⟶ X) [IsFinite f] [Surjective f]
    (hFinite : ∀ {Y : Scheme.{u}} (f : Y ⟶ X) [IsFinite f],
      ∀ R : Sheaf (Opens.grothendieckTopology Y.carrier)
        (Type u),
        Function.Bijective (zariskiGlobalSectionsMapAt (pullback.fst f i) R))
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) w)))
    (s : (etaleGlobalSections Y).obj ((smallEtaleInverseImage f).obj F))
    (t : (etaleGlobalSections Z).obj ((smallEtaleInverseImage i).obj F))
    (hs : relativeGlobalSectionsMap f (pullback.fst f i) (pullback.fst f i ≫ f) rfl F s =
      relativeGlobalSectionsMap i (pullback.snd f i) (pullback.fst f i ≫ f)
        pullback.condition F t) :
    ∃ sX : (etaleGlobalSections X).obj F, etaleGlobalPullback i F sX = t := by
  have heq : relativeGlobalSectionsMap f (pullback.fst f f) (pullback.fst f f ≫ f) rfl F s =
      relativeGlobalSectionsMap f (pullback.snd f f) (pullback.fst f f ≫ f)
        pullback.condition F s :=
    relative_finite_lift_compatible.{u, w} f i hFinite F s t hs
  obtain ⟨sX, hsX⟩ := finiteDescent_globalSection.{u, w} f F s heq
  exact ⟨sX, finite_lift_section_eq.{u, w} f i F s t hs sX hsX⟩

private theorem etaleGlobalPullback_surjective
    {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    [CompactSpace X] [QuasiSeparatedSpace X]
    (hZar : ∀ R : Sheaf (Opens.grothendieckTopology X.carrier)
      (Type u), Function.Bijective (zariskiGlobalSectionsMapAt i R))
    (hFinite : ∀ {Y : Scheme.{u}} (f : Y ⟶ X) [IsFinite f],
      ∀ R : Sheaf (Opens.grothendieckTopology Y.carrier)
        (Type u),
        Function.Bijective (zariskiGlobalSectionsMapAt (pullback.fst f i) R))
    (F : Sheaf X.smallEtaleTopology (Type (max (u + 1) w))) :
    Function.Surjective (etaleGlobalPullback i F) := by
  intro t
  obtain ⟨Y, f, hf, hsur, s, hs⟩ := exists_relative_finite_lift i hZar hFinite F t
  let := hf
  let := hsur
  exact relative_finite_lift_descends f i hFinite F s t hs


/-- **[Stacks, Tag 09ZF]** (Gabber).  Let `X` be a quasi-compact quasi-separated scheme and
`i : Z ⟶ X` a closed immersion such that

1. for every sheaf of sets `ℱ` on the Zariski site of `X` the restriction
   `Γ(X, ℱ) ⟶ Γ(Z, i⁻¹ℱ)` is bijective, and
2. the same holds for the base change `Z ×_X X' ⟶ X'` along every finite morphism `X' ⟶ X`.

Then `Γ(X, ℱ) = Γ(Z, i⁻¹_{small}ℱ)` for every sheaf of sets `ℱ` on the small étale site of `X`:
the canonical comparison
`Stacks.EtaleCohomology.globalSectionsSmallEtaleInverseImageComparison` is an isomorphism.

Injectivity uses only hypothesis (1):  a global section of `i⁻¹ℱ` is, near each point of `Z`,
pulled back from a section of `ℱ` over an object of the small étale site of `X` whose open image
is forced by (1) to be all of `X`.  Surjectivity is where (2) enters.  A global section `t` of
`i⁻¹ℱ` is, on a covering family, pulled back from sections of `ℱ` over objects `W j` of the small
étale site whose images cover `X`;  each `W j` is shrunk so that `V j ⟶ W j ×_X Z` is surjective;
[Stacks, Tag 09Z0] produces a finite surjective `X' ⟶ X` factoring Zariski-locally through the
family, so that over `X'` the pulled-back section lies in the Zariski subsheaf and (2) produces a
section over `X'`;  and that section descends to `X` by the equalizer presentation of
[Stacks, Tag 09Z3],
`Stacks.EtaleCohomology.globalSectionsPullback_isEqualizer_of_isFinite_surjective`.

Hypotheses (1) and (2) are asked only of those Zariski sheaves of sets whose values lie in the
universe of the schemes themselves — `Stacks.EtaleCohomology.zariskiGlobalSectionsMapAt` at
`Type u` — while the conclusion stays universe-polymorphic in the coefficients of the étale
sheaf.  That is all the proof uses:  (1) is applied to the sheafification of a representable, and
both (1) and (2) to the small model `Stacks.EtaleCohomology.smallSheafModel` of the subsheaf
generated by a `u`-small family of local sections.  Both have `u`-small values, so the
hypotheses are weaker than the source's, which quantifies over every sheaf of sets. -/
@[stacks 09ZF "the conclusion `Γ(X, ℱ) = Γ(Z, i⁻¹_{small}ℱ)` for every sheaf of sets on the small
étale site of `X`, under the source's own hypotheses: `X` quasi-compact and quasi-separated, `i` a
closed immersion, and the two Zariski hypotheses (1) and (2) of the tag"]
public theorem isIso_globalSectionsSmallEtaleInverseImageComparison_of_zariskiBijective
    {X Z : Scheme.{u}} (i : Z ⟶ X) [IsClosedImmersion i]
    [CompactSpace X] [QuasiSeparatedSpace X]
    (hZar : ∀ F : Sheaf (Opens.grothendieckTopology X.carrier)
      (Type u),
      Function.Bijective (zariskiGlobalSectionsMapAt i F))
    (hFinite : ∀ {Y : Scheme.{u}} (f : Y ⟶ X) [IsFinite f],
      ∀ F : Sheaf (Opens.grothendieckTopology Y.carrier)
        (Type u),
        Function.Bijective
          (zariskiGlobalSectionsMapAt (pullback.fst f i) F)) :
    IsIso (globalSectionsSmallEtaleInverseImageComparison.{u, v} i).val := by
  apply (NatTrans.isIso_iff_isIso_app _).2
  intro F
  apply (isIso_iff_bijective _).2
  obtain ⟨g⟩ := smallEtaleBaseChange_terminal_hom_exists i
  rw [(globalSectionsSmallEtaleInverseImageComparison i).property F g]
  refine ⟨smallEtaleGlobalSectionsMapAt_injective i hZar g F, ?_⟩
  have hs := etaleGlobalPullback_surjective i hZar hFinite F
  unfold etaleGlobalPullback at hs
  rwa [(globalSectionsSmallEtaleInverseImageComparison i).property F g] at hs

end Stacks.EtaleCohomology

