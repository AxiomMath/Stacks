module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Trace.RepresentationCommutantCohomology
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Trace.LFunctionRationalSheaf

/-!
# The `E`-linear Frobenius on the rational stalk of a sheaf with coefficients

Let `F` be an ℓ-adic sheaf with coefficients in a `ℤ_ℓ`-algebra `O`
(`Stacks.EtaleCohomology.LAdicSheaf.CoefficientSheaf`) and `E = O[1/ℓ]`. The action of `O` on `F`
induces one on the rational stalk `ℚ_ℓ ⊗ F_s̄` at every geometric point; it extends to an action of
`E` (through the commutative `ℚ_ℓ`-subalgebra it generates, in which `ℓ` is invertible), making the
rational stalk an `E`-vector space compatibly with its `ℚ_ℓ`-structure. At a point `x` with finite
residue field the geometric Frobenius commutes with the action, hence is `E`-linear
(`Stacks.EtaleCohomology.LAdicSheaf.CoefficientSheaf.rationalStalkFrobenius`). This is the stalk
counterpart of the `E`-structure on compactly supported cohomology of
`Stacks.EtaleCohomology.LAdicSheaf.CoefficientSheaf.rationalCohomologyModule`; the `E`-linear
characteristic polynomials of Frobenius at closed points are what `ι`-purity of a sheaf with
coefficients in `E` refers to.

## Main definitions

* `Stacks.EtaleCohomology.LAdicSheaf.CoefficientSheaf.rationalStalkIntegralRingHom`,
  `Stacks.EtaleCohomology.LAdicSheaf.CoefficientSheaf.rationalStalkRingHom`: the actions of `O` and
  `E` on the rational stalk.
* `Stacks.EtaleCohomology.LAdicSheaf.CoefficientSheaf.rationalStalkModule`.
* `Stacks.EtaleCohomology.LAdicSheaf.CoefficientSheaf.rationalStalkFrobenius`.
-/

@[expose] public noncomputable section

open CategoryTheory AlgebraicGeometry AlgebraicGeometry.SmallEtale Stacks.Frobenius
open scoped IsMulCommutative

universe u

namespace Stacks.EtaleCohomology

namespace LAdicSheaf.CoefficientSheaf

variable {B : BigEtaleSite.{u}} {X : B.Scheme} {ℓ : ℕ}
  [∀ (n : ℕ) (S T : B.Scheme) (f : T ⟶ S),
    ((AlgebraicGeometry.smallEtaleBaseChange B f).sheafPushforwardContinuous
      (ModuleCat.{u + 1} (ZMod (ℓ ^ (n + 1))))
      (SmallEtale.topology B S.1 S.property)
      (SmallEtale.topology B T.1 T.property)).IsRightAdjoint]
  [∀ (n : ℕ) (T : B.Scheme) (V : SmallEtale B T.1 T.property),
    HasWeakSheafify ((SmallEtale.topology B T.1 T.property).over V)
      (ModuleCat.{u + 1} (ZMod (ℓ ^ (n + 1))))]
  [∀ n : ℕ, HasWeakSheafify (SmallEtale.topology B X.1 X.property)
    (ModuleCat.{u + 1} (ZMod (ℓ ^ (n + 1))))]
  [IsNoetherian X.1] [Fact ℓ.Prime]
  {O : Type} [CommRing O] [Algebra ℤ_[ℓ] O] (F : LAdicSheaf.CoefficientSheaf B X ℓ O)
  (s : GeometricPoint X.1)

/-- The action of `O` on the rational stalk `ℚ_ℓ ⊗ F_s̄`. -/
public def rationalStalkIntegralRingHom :
    O →+* Module.End ℚ_[ℓ] (LAdicSheaf.rationalStalkLeft B X ℓ F.toLAdicSheaf s) :=
  (LAdicSheaf.rationalStalkEndRingHom F.toLAdicSheaf s).comp F.act

/-- The action of `ℤ_ℓ` through `O` on the rational stalk is the canonical one. -/
public theorem rationalStalkIntegralRingHom_algebraMap (c : ℤ_[ℓ]) :
    F.rationalStalkIntegralRingHom s (algebraMap ℤ_[ℓ] O c) =
      algebraMap ℚ_[ℓ] _ (c : ℚ_[ℓ]) := by
  show LinearMap.baseChange ℚ_[ℓ] (LAdicSheaf.stalkMap (F.act (algebraMap ℤ_[ℓ] O c)) s) = _
  rw [act_algebraMap]
  have h : LAdicSheaf.stalkMap (LAdicSheaf.scalarEnd F.toLAdicSheaf c) s = c • LinearMap.id :=
    LinearMap.ext fun v => LAdicSheaf.stalkMap_scalarEnd F.toLAdicSheaf s c v
  rw [h, LinearMap.baseChange_smul, LinearMap.baseChange_id]
  refine LinearMap.ext fun v => ?_
  rw [LinearMap.smul_apply, LinearMap.id_apply, Module.algebraMap_end_apply]
  exact (algebraMap_smul ℚ_[ℓ] c v).symm

/-- **The geometric Frobenius at `x` commutes with the action of `O`.** -/
public theorem commute_rationalStalkIntegralRingHom (x : X.1) (hx : Finite (X.1.residueField x))
    (o : O) :
    Commute (LAdicSheaf.rationalStalkFrobenius B X ℓ F.toLAdicSheaf x hx)
      (F.rationalStalkIntegralRingHom (geometricPointAt X.1 x) o) := by
  have := hx
  exact LAdicSheaf.rationalStalkEnd_comp_rationalStalkMap (F.act o) (frobeniusPointHom X.1 x)

/-- The commutative subalgebra of `End_{ℚ_ℓ}(ℚ_ℓ ⊗ F_s̄)` generated by the action of `O`. -/
public def rationalStalkAlgebra :
    Subalgebra ℚ_[ℓ] (Module.End ℚ_[ℓ] (LAdicSheaf.rationalStalkLeft B X ℓ F.toLAdicSheaf s)) :=
  Algebra.adjoin ℚ_[ℓ] (Set.range (F.rationalStalkIntegralRingHom s))

/-- The subalgebra generated by the action of `O` on the rational stalk is commutative. -/
public instance rationalStalkAlgebra.isMulCommutative :
    IsMulCommutative (F.rationalStalkAlgebra s) :=
  Algebra.isMulCommutative_adjoin ℚ_[ℓ] (by
    rintro _ ⟨a, rfl⟩ _ ⟨b, rfl⟩
    rw [← map_mul, mul_comm, map_mul])

/-- The action of `O` with values in the commutative subalgebra it generates. -/
public def rationalStalkIntegralRingHom' : O →+* F.rationalStalkAlgebra s :=
  (F.rationalStalkIntegralRingHom s).codRestrict _ fun o => Algebra.subset_adjoin ⟨o, rfl⟩

/-- The powers of `ℓ` act invertibly on the rational stalk. -/
public theorem isUnit_rationalStalkIntegralRingHom' (y : Submonoid.powers (ℓ : O)) :
    IsUnit (F.rationalStalkIntegralRingHom' s y) := by
  obtain ⟨_, k, rfl⟩ := y
  rw [map_pow, map_natCast, ← map_natCast (algebraMap ℚ_[ℓ] _)]
  exact ((isUnit_iff_ne_zero.2 (Nat.cast_ne_zero.2 (Fact.out : ℓ.Prime).ne_zero)).map _).pow k

variable (E : Type) [CommRing E] [Algebra ℚ_[ℓ] E] [Algebra O E]
  [IsLocalization (Submonoid.powers (ℓ : O)) E]

/-- **The action of `E = O[1/ℓ]` on the rational stalk `ℚ_ℓ ⊗ F_s̄`**, extending that of `O`. -/
public def rationalStalkRingHom :
    E →+* Module.End ℚ_[ℓ] (LAdicSheaf.rationalStalkLeft B X ℓ F.toLAdicSheaf s) :=
  (F.rationalStalkAlgebra s).val.toRingHom.comp
    (IsLocalization.lift (M := Submonoid.powers (ℓ : O)) (S := E)
      (g := F.rationalStalkIntegralRingHom' s) (F.isUnit_rationalStalkIntegralRingHom' s))

/-- The action of every element of `E` lies in the subalgebra generated by the action of `O`. -/
public theorem rationalStalkRingHom_mem (e : E) :
    F.rationalStalkRingHom s E e ∈ F.rationalStalkAlgebra s :=
  (IsLocalization.lift (M := Submonoid.powers (ℓ : O)) (S := E)
    (g := F.rationalStalkIntegralRingHom' s) (F.isUnit_rationalStalkIntegralRingHom' s) e).2

/-- The action of `E` extends that of `O`. -/
public theorem rationalStalkRingHom_algebraMap_apply (o : O) :
    F.rationalStalkRingHom s E (algebraMap O E o) = F.rationalStalkIntegralRingHom s o := by
  show (IsLocalization.lift (M := Submonoid.powers (ℓ : O)) (S := E)
    (g := F.rationalStalkIntegralRingHom' s) (F.isUnit_rationalStalkIntegralRingHom' s)
    (algebraMap O E o)).1 = _
  rw [IsLocalization.lift_eq]
  rfl

/-- The action of `E` restricts to the `ℚ_ℓ`-structure, when `ℤ_ℓ → O → E` and `ℤ_ℓ → ℚ_ℓ → E`
agree. -/
public theorem rationalStalkRingHom_algebraMap
    (hOE : ∀ c : ℤ_[ℓ], algebraMap O E (algebraMap ℤ_[ℓ] O c) = algebraMap ℚ_[ℓ] E c)
    (c : ℚ_[ℓ]) :
    F.rationalStalkRingHom s E (algebraMap ℚ_[ℓ] E c) = algebraMap ℚ_[ℓ] _ c := by
  have h : ((F.rationalStalkRingHom s E).comp (algebraMap ℚ_[ℓ] E)).comp
      (algebraMap ℤ_[ℓ] ℚ_[ℓ]) = (algebraMap ℚ_[ℓ] _).comp (algebraMap ℤ_[ℓ] ℚ_[ℓ]) := by
    refine RingHom.ext fun c => ?_
    show F.rationalStalkRingHom s E (algebraMap ℚ_[ℓ] E (c : ℚ_[ℓ])) =
      algebraMap ℚ_[ℓ] _ (c : ℚ_[ℓ])
    rw [← hOE, rationalStalkRingHom_algebraMap_apply, rationalStalkIntegralRingHom_algebraMap]
  exact RingHom.congr_fun (IsLocalization.ringHom_ext (nonZeroDivisors ℤ_[ℓ]) h) c

/-- **The geometric Frobenius at `x` commutes with the action of `E`.** -/
public theorem commute_rationalStalkRingHom (x : X.1) (hx : Finite (X.1.residueField x)) (e : E) :
    Commute (LAdicSheaf.rationalStalkFrobenius B X ℓ F.toLAdicSheaf x hx)
      (F.rationalStalkRingHom (geometricPointAt X.1 x) E e) :=
  Algebra.commute_of_mem_adjoin_of_forall_mem_commute
    (F.rationalStalkRingHom_mem (geometricPointAt X.1 x) E e) (by
      rintro _ ⟨o, rfl⟩
      exact F.commute_rationalStalkIntegralRingHom x hx o)

/-- **The `E`-module structure on the rational stalk `ℚ_ℓ ⊗ F_s̄`.** -/
public abbrev rationalStalkModule :
    Module E (LAdicSheaf.rationalStalkLeft B X ℓ F.toLAdicSheaf s) :=
  Module.compHom _ (F.rationalStalkRingHom s E)

/-- The `E`-module structure on the rational stalk is compatible with its `ℚ_ℓ`-structure, when
`ℤ_ℓ → O → E` and `ℤ_ℓ → ℚ_ℓ → E` agree. -/
public theorem rationalStalkModule_isScalarTower
    (hOE : ∀ c : ℤ_[ℓ], algebraMap O E (algebraMap ℤ_[ℓ] O c) = algebraMap ℚ_[ℓ] E c) :
    letI := F.rationalStalkModule s E
    IsScalarTower ℚ_[ℓ] E (LAdicSheaf.rationalStalkLeft B X ℓ F.toLAdicSheaf s) := by
  let := F.rationalStalkModule s E
  refine ⟨fun c e v => ?_⟩
  show F.rationalStalkRingHom s E (c • e) v = c • F.rationalStalkRingHom s E e v
  rw [Algebra.smul_def, map_mul, F.rationalStalkRingHom_algebraMap s E hOE,
    Module.End.mul_apply, Module.algebraMap_end_apply]

/-- **The geometric Frobenius at `x` on the rational stalk, `E`-linearly.** -/
public def rationalStalkFrobenius (x : X.1) (hx : Finite (X.1.residueField x)) :
    letI := F.rationalStalkModule (geometricPointAt X.1 x) E
    LAdicSheaf.rationalStalkLeft B X ℓ F.toLAdicSheaf (geometricPointAt X.1 x) →ₗ[E]
      LAdicSheaf.rationalStalkLeft B X ℓ F.toLAdicSheaf (geometricPointAt X.1 x) :=
  letI := F.rationalStalkModule (geometricPointAt X.1 x) E
  { toFun := LAdicSheaf.rationalStalkFrobenius B X ℓ F.toLAdicSheaf x hx
    map_add' := map_add _
    map_smul' := fun e v => LinearMap.congr_fun (F.commute_rationalStalkRingHom E x hx e).eq v }

/-- The `E`-linear geometric Frobenius at `x`, viewed `ℚ_ℓ`-linearly, is the geometric Frobenius
on the rational stalk. -/
public theorem rationalStalkFrobenius_restrictScalars
    (hOE : ∀ c : ℤ_[ℓ], algebraMap O E (algebraMap ℤ_[ℓ] O c) = algebraMap ℚ_[ℓ] E c)
    (x : X.1) (hx : Finite (X.1.residueField x)) :
    letI := F.rationalStalkModule (geometricPointAt X.1 x) E
    letI := F.rationalStalkModule_isScalarTower (geometricPointAt X.1 x) E hOE
    (F.rationalStalkFrobenius E x hx).restrictScalars ℚ_[ℓ] =
      LAdicSheaf.rationalStalkFrobenius B X ℓ F.toLAdicSheaf x hx :=
  rfl

end LAdicSheaf.CoefficientSheaf

end Stacks.EtaleCohomology

end
