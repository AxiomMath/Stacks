module

public import Mathlib.Algebra.Category.ModuleCat.Basic
public import Mathlib.Algebra.Module.ZMod
public import Mathlib.CategoryTheory.Preadditive.AdditiveFunctor
public import Mathlib.RepresentationTheory.Coinvariants
public import Mathlib.Data.ZMod.Basic

/-!
# Bounding the values of an additive functor by coinvariants

Let `T : C ⥤ ModuleCat (ℤ/m)` be an additive functor, `M` and `P` objects of `C`, and `A` a
`ℤ/m`-module with an action `σ` of a group `G`. Suppose given an additive family of morphisms
`ψ_a : P ⟶ M` (`a ∈ A`) and endomorphisms `R_g` of `P` (`g ∈ G`) with `R_g ≫ ψ_a = ψ_{g⁻¹ a}`,
such that `T(R_g)` is the identity, `T(P)` is generated by one element `u`, and `T(M)` is spanned
by the images of the `T(ψ_a)`. Then `a ↦ T(ψ_a)(u)` is a surjection `A → T(M)` constant on
`G`-orbits, hence `#T(M) ≤ #A_G`.

## Main results

* `Stacks.EtaleCohomology.finite_and_natCard_obj_le_natCard_coinvariants`: under these
  hypotheses `T(M)` is finite and `#T(M) ≤ #A_G`.
* `Stacks.EtaleCohomology.natCard_obj_le_natCard_coinvariants`: the bound `#T(M) ≤ #A_G` alone.

## References

* [Stacks Project, Tag 03VK](https://stacks.math.columbia.edu/tag/03VK)
-/

@[expose] public section

open CategoryTheory

universe w

namespace Stacks.EtaleCohomology

variable {C : Type*} [Category* C] [Preadditive C] {m : ℕ}
  (T : C ⥤ ModuleCat.{w} (ZMod m)) [T.Additive]
  {G : Type*} [Group G] {A : Type*} [AddCommGroup A] [Module (ZMod m) A]
  (σ : Representation (ZMod m) G A) {P M : C} (ψ : A →+ (P ⟶ M)) (R : G → (P ⟶ P))

/-- The map `a ↦ T(ψ_a)(u)`, additively in `a`. -/
def cyclicImageAddHom (u : T.obj P) : A →+ T.obj M where
  toFun a := (T.map (ψ a)).hom u
  map_zero' := by rw [map_zero, T.map_zero]; rfl
  map_add' a b := by rw [map_add, T.map_add]; rfl

omit [Module (ZMod m) A] in
/-- `cyclicImageAddHom T ψ u` sends `a` to `T(ψ_a)(u)`. -/
theorem cyclicImageAddHom_apply (u : T.obj P) (a : A) :
    cyclicImageAddHom T ψ u a = (T.map (ψ a)).hom u :=
  rfl

/-- **`#T(M) ≤ #A_G`**: if `T(P)` is cyclic, the `T(R_g)` are trivial, `R_g ≫ ψ_a = ψ_{g⁻¹ a}` and
`T(M)` is spanned by the images of the `T(ψ_a)`, then `T(M)` is a quotient of the coinvariants
`A_G`; in particular it is finite. -/
theorem finite_and_natCard_obj_le_natCard_coinvariants [Finite A]
    (hR : ∀ (g : G) (a : A), R g ≫ ψ a = ψ (σ g⁻¹ a))
    (hRT : ∀ g : G, T.map (R g) = 𝟙 _)
    (u : T.obj P) (hu : ∀ s : T.obj P, ∃ c : ZMod m, s = c • u)
    (hspan : ∀ t : T.obj M, ∃ (n : ℕ) (a : Fin n → A) (s : Fin n → T.obj P),
      t = ∑ i, (T.map (ψ (a i))).hom (s i)) :
    Finite (T.obj M) ∧ Nat.card (T.obj M) ≤ Nat.card (Representation.Coinvariants σ) := by
  let Φ := (cyclicImageAddHom T ψ u).toZModLinearMap m
  have hΦ : ∀ a, Φ a = (T.map (ψ a)).hom u := fun _ => rfl
  have hinv : ∀ g : G, Φ ∘ₗ σ g = Φ := fun g => by
    ext a
    simp only [LinearMap.coe_comp, Function.comp_apply, hΦ]
    rw [← inv_inv g, ← hR, T.map_comp, hRT, Category.id_comp]
  let Ψ := Representation.Coinvariants.lift σ Φ hinv
  have hsurj : Function.Surjective Ψ := by
    intro t
    obtain ⟨n, a, s, rfl⟩ := hspan t
    choose c hc using fun i => hu (s i)
    refine ⟨Representation.Coinvariants.mk σ (∑ i, c i • a i), ?_⟩
    rw [Representation.Coinvariants.lift_mk, map_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_smul, hΦ, hc i, map_smul]
  have : Finite (Representation.Coinvariants σ) :=
    Finite.of_surjective _ (Representation.Coinvariants.mk_surjective σ)
  exact ⟨Finite.of_surjective _ hsurj, Nat.card_le_card_of_surjective _ hsurj⟩

/-- **`#T(M) ≤ #A_G`**, under the hypotheses of
`Stacks.EtaleCohomology.finite_and_natCard_obj_le_natCard_coinvariants`. -/
theorem natCard_obj_le_natCard_coinvariants [Finite A]
    (hR : ∀ (g : G) (a : A), R g ≫ ψ a = ψ (σ g⁻¹ a))
    (hRT : ∀ g : G, T.map (R g) = 𝟙 _)
    (u : T.obj P) (hu : ∀ s : T.obj P, ∃ c : ZMod m, s = c • u)
    (hspan : ∀ t : T.obj M, ∃ (n : ℕ) (a : Fin n → A) (s : Fin n → T.obj P),
      t = ∑ i, (T.map (ψ (a i))).hom (s i)) :
    Nat.card (T.obj M) ≤ Nat.card (Representation.Coinvariants σ) :=
  (finite_and_natCard_obj_le_natCard_coinvariants T σ ψ R hR hRT u hu hspan).2

end Stacks.EtaleCohomology
