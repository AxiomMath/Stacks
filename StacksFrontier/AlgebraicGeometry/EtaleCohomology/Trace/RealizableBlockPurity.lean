module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Trace.IotaRealPurity
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Trace.AlgebraicBlockForm
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Trace.StableFlagBasis
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Trace.DirectSumBlockForm
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Trace.RestrictScalarsFiltrationWeights
public import StacksFrontier.NumberTheory.Padics.ComplexEmbeddingExtension

/-!
# Purity of the constituents of an `ι`-realizable representation, along every embedding

Let `ρ : Γ → GL_r(ℚ_ℓ)` be `ι`-realizable: `ρ ⊕ ρ'` has `ι`-real Frobenius characteristic
polynomials. Write `P⁻¹ (ρ ⊗ E) P` in graded upper-triangular form with absolutely irreducible
diagonal blocks over a finite extension `E ⊆ ℂ_ℓ` of `ℚ_ℓ`
(`Stacks.EtaleCohomology.exists_finiteDimensional_isGradedUpper_absolutelyIrreducible`). Then for
every embedding `ι' : E →+* ℂ` over `ι`, every diagonal block is `ι'`-pure (Weil II 1.5.1; Kedlaya,
*Fourier transforms and p-adic Weil II*, Theorem 6.5.2).

## Main definitions

* `Stacks.EtaleCohomology.sumRep`: the direct sum `ρ ⊕ ρ'` of two matrix representations.

## Main results

* `Stacks.EtaleCohomology.exists_padicComplex_ringHom_eq_on_intermediateField`: an embedding of a
  subfield of `ℂ_ℓ` into `ℂ` extends to `ℂ_ℓ` on the subring generated by a countable set.
* `Stacks.EtaleCohomology.exists_norm_eq_pow_toSquareBlock_of_isIotaRealizable`: the diagonal
  blocks are pure along every embedding `ι'` over `ι`.
* `Stacks.EtaleCohomology.exists_int_weight_of_norm_eq_pow`: a pure constituent of a pointwise
  mixed representation has an integer weight.
-/

@[expose] public noncomputable section

open Matrix Cardinal

namespace Stacks.EtaleCohomology

variable {ℓ : ℕ} [Fact ℓ.Prime]

/-- **An embedding of a subfield of `ℂ_ℓ` extends to `ℂ_ℓ` on the ring generated by any countable
subset**: for `ι' : E →+* ℂ` and a countable `s ⊆ E` there is `φ : ℂ_ℓ →+* ℂ` agreeing with `ι'` on
`Algebra.adjoin ℤ s`. -/
public theorem exists_padicComplex_ringHom_eq_on_intermediateField
    (E : IntermediateField ℚ_[ℓ] ℂ_[ℓ]) (ι' : E →+* ℂ) {s : Set E} (hs : s.Countable) :
    ∃ φK : ℂ_[ℓ] →+* ℂ, ∀ x ∈ Algebra.adjoin ℤ s, φK (x : ℂ_[ℓ]) = ι' x := by
  classical
  set R := Algebra.adjoin ℤ s with hR_def
  have : Countable s := hs.to_subtype
  have hRc : ((R : Subalgebra ℤ E) : Set E).Countable := by
    rw [hR_def, Algebra.adjoin_eq_range, AlgHom.coe_range]
    exact Set.countable_range _
  have : Countable R := hRc.to_subtype
  let : Algebra R ℂ_[ℓ] := ((algebraMap E ℂ_[ℓ]).comp R.val.toRingHom).toAlgebra
  let : Algebra R ℂ := (ι'.comp R.val.toRingHom).toAlgebra
  have hK : Function.Injective (algebraMap R ℂ_[ℓ]) :=
    (algebraMap E ℂ_[ℓ]).injective.comp Subtype.val_injective
  have hL : Function.Injective (algebraMap R ℂ) := ι'.injective.comp Subtype.val_injective
  have hcard : #ℂ_[ℓ] ≤ #ℂ := by
    rw [Cardinal.mk_complex]
    exact Stacks.LAdic.cardinal_mk_padicComplex_le ℓ
  have hL0 : ℵ₀ < #ℂ := by
    rw [Cardinal.mk_complex]
    exact Cardinal.aleph0_lt_continuum
  obtain ⟨φK, hφ⟩ := Stacks.LAdic.exists_ringHom_comp_algebraMap_eq_of_countable hK hL hcard hL0
  exact ⟨φK, fun x hx => congrArg (fun g => g ⟨x, hx⟩) hφ⟩

/-- The coefficients of the characteristic polynomial of a matrix lie in any subring containing its
entries. -/
public theorem charpoly_coeff_mem_of_forall_mem {E : Type*} [CommRing E] {n : Type*} [Fintype n]
    [DecidableEq n] (R : Subring E) (M : Matrix n n E) (hM : ∀ i j, M i j ∈ R) (m : ℕ) :
    M.charpoly.coeff m ∈ R := by
  set M' : Matrix n n R := Matrix.of fun i j => ⟨M i j, hM i j⟩
  have hM' : M'.map R.subtype = M := by
    ext i j
    rfl
  rw [← hM', Matrix.charpoly_map, Polynomial.coeff_map]
  exact (M'.charpoly.coeff m).2

section Purity

variable {Γ : Type*} [Group Γ] [TopologicalSpace Γ] [IsTopologicalGroup Γ] [CompactSpace Γ]

/-- The direct sum `ρ ⊕ ρ'` of two representations. -/
public def sumRep {R : Type*} [CommRing R] {r r' : ℕ} (ρ : Γ →* GL (Fin r) R)
    (ρ' : Γ →* GL (Fin r') R) : Γ →* GL (Fin (r + r')) R where
  toFun g := (sumSplitting (R := R) r r').blockDiagUnit (ρ g) (ρ' g)
  map_one' := Units.ext (by
    change (sumSplitting (R := R) r r').blockDiag (ρ 1).val (ρ' 1).val = 1
    rw [map_one, map_one, Units.val_one, Units.val_one, IsSplitting.blockDiag_one])
  map_mul' g h := Units.ext (by
    change (sumSplitting (R := R) r r').blockDiag (ρ (g * h)).val (ρ' (g * h)).val =
      (sumSplitting (R := R) r r').blockDiag (ρ g).val (ρ' g).val *
        (sumSplitting (R := R) r r').blockDiag (ρ h).val (ρ' h).val
    rw [IsSplitting.blockDiag_mul, map_mul, map_mul, Units.val_mul, Units.val_mul])

omit [TopologicalSpace Γ] [IsTopologicalGroup Γ] [CompactSpace Γ] in
/-- The matrix of `(ρ ⊕ ρ') g` is the block diagonal matrix of `ρ g` and `ρ' g`. -/
public theorem sumRep_val {R : Type*} [CommRing R] {r r' : ℕ} (ρ : Γ →* GL (Fin r) R)
    (ρ' : Γ →* GL (Fin r') R) (g : Γ) :
    (sumRep ρ ρ' g).val = (sumSplitting (R := R) r r').blockDiag (ρ g).val (ρ' g).val :=
  rfl

omit [IsTopologicalGroup Γ] [CompactSpace Γ] in
/-- The direct sum of two continuous representations is continuous. -/
public theorem continuous_sumRep {R : Type*} [CommRing R] [TopologicalSpace R]
    [IsTopologicalRing R] {r r' : ℕ} {ρ : Γ →* GL (Fin r) R} {ρ' : Γ →* GL (Fin r') R}
    (hρ : Continuous ρ) (hρ' : Continuous ρ') : Continuous (sumRep ρ ρ') := by
  refine Units.continuous_iff.2 ⟨?_, ?_⟩
  · change Continuous fun g => (sumSplitting (R := R) r r').blockDiag (ρ g).val (ρ' g).val
    simp only [IsSplitting.blockDiag]
    exact ((continuous_const.matrix_mul (Units.continuous_val.comp hρ)).matrix_mul
      continuous_const).add ((continuous_const.matrix_mul
        (Units.continuous_val.comp hρ')).matrix_mul continuous_const)
  · change Continuous fun g => (sumSplitting (R := R) r r').blockDiag (ρ g)⁻¹.val (ρ' g)⁻¹.val
    simp only [IsSplitting.blockDiag]
    exact ((continuous_const.matrix_mul (Units.continuous_coe_inv.comp hρ)).matrix_mul
      continuous_const).add ((continuous_const.matrix_mul
        (Units.continuous_coe_inv.comp hρ')).matrix_mul continuous_const)

/-- The even part of the grading `sumGrading δ d'` of a direct sum comes from the first summand. -/
private theorem sumGrading_eq_two_mul_iff {r r' : ℕ} (δ : Fin r → ℤ) (d' : Fin r' → ℤ) (s : ℤ)
    (i : Fin (r + r')) :
    sumGrading δ d' i = 2 * s ↔ ∃ j, Fin.castAdd r' j = i ∧ δ j = s := by
  induction i using Fin.addCases with
  | left j =>
    simp only [sumGrading_castAdd]
    exact ⟨fun h => ⟨j, rfl, by omega⟩, fun ⟨j', hj', h⟩ => by
      rw [Fin.castAdd_injective r r' hj'] at h
      omega⟩
  | right j =>
    simp only [sumGrading_natAdd]
    refine ⟨fun h => by omega, fun ⟨j', hj', _⟩ => ?_⟩
    have := congrArg Fin.val hj'
    simp only [Fin.val_castAdd, Fin.val_natAdd] at this
    omega

/-- **The diagonal blocks of an `ι`-realizable representation are pure along every embedding of the
coefficient field** (Weil II 1.5.1; Kedlaya, Theorem 6.5.2). Let `ρ` be such that `ρ ⊕ ρ'` has
`ι`-real Frobenius characteristic polynomials, and `P⁻¹ (ρ ⊗ E) P` graded upper triangular with
`ℂ_ℓ`-irreducible diagonal blocks, `E ⊆ ℂ_ℓ`. Then for every `ι' : E →+* ℂ` over `ι` and every
grade `t` there is `β > 0` with all roots along `ι'` of the characteristic polynomial of the block
`t` of `P⁻¹ ρ(F_y) P` of absolute value `β ^ deg y`. -/
public theorem exists_norm_eq_pow_toSquareBlock_of_isIotaRealizable (ι : ℚ_[ℓ] →+* ℂ)
    (H : Subgroup Γ) [H.Normal] (φ : Γ) (hcomm : ∀ a b : Γ, a * b * a⁻¹ * b⁻¹ ∈ H)
    (hD1 : ∀ U : Subgroup Γ, U.Normal → IsOpen (U : Set Γ) →
      ∀ ψ : ↥(H ⊓ U) → ℂ_[ℓ], (∀ a b, ψ (a * b) = ψ a + ψ b) → Continuous ψ →
        (∀ a b : ↥(H ⊓ U), (b : Γ) = φ ^ U.index * a * (φ ^ U.index)⁻¹ → ψ b = ψ a) → ψ = 0)
    {Y : Type*} [Countable Y] (Fr : Y → Γ) (deg : Y → ℕ) (hFr : ∀ y, (φ ^ deg y)⁻¹ * Fr y ∈ H)
    (hdeg : ∀ y, 0 < deg y) (hfin : ∀ m : ℕ, 0 < m → {y : Y | deg y ∣ m}.Finite)
    {q : ℝ} (hq : 1 < q)
    (htf : ∀ (ι₁ : ℚ_[ℓ] →+* ℂ) (m : ℕ) (τ : Γ →* GL (Fin m) ℚ_[ℓ]), Continuous τ →
      SatisfiesFrobeniusTraceFormula q ι₁ H φ Fr deg τ)
    {r r' : ℕ} (ρ : Γ →* GL (Fin r) ℚ_[ℓ]) (hρ : Continuous ρ) (ρ' : Γ →* GL (Fin r') ℚ_[ℓ])
    (hρ' : Continuous ρ')
    (hreal : ∀ (y : Y) (m : ℕ), ι (((ρ (Fr y)).val.charpoly * (ρ' (Fr y)).val.charpoly).coeff m) ∈
      Set.range ((↑) : ℝ → ℂ))
    (E : IntermediateField ℚ_[ℓ] ℂ_[ℓ]) (P : (Matrix (Fin r) (Fin r) E)ˣ) (δ : Fin r → ℤ)
    (hup : ∀ g, IsGradedUpper δ (P⁻¹.val * (ρ g).val.map (algebraMap ℚ_[ℓ] E) * P.val))
    (hirr : ∀ (t : ℤ) (W' : Submodule ℂ_[ℓ] (Fin r → ℂ_[ℓ])),
      W' ≤ coordSubspace (K := ℂ_[ℓ]) (fun i => δ i = t) → W' ≠ ⊥ →
      (∀ g, ∀ v ∈ W', (gradedDiag δ (P⁻¹.val * (ρ g).val.map (algebraMap ℚ_[ℓ] E) *
        P.val)).map (algebraMap E ℂ_[ℓ]) *ᵥ v ∈ W') →
      W' = coordSubspace (K := ℂ_[ℓ]) (fun i => δ i = t))
    (ι' : E →+* ℂ) (hι' : ∀ c, ι' (algebraMap ℚ_[ℓ] E c) = ι c) (t : ℤ) :
    ∃ β : ℝ, 0 < β ∧ ∀ (y : Y) (z : ℂ),
      (((P⁻¹.val * (ρ (Fr y)).val.map (algebraMap ℚ_[ℓ] E) * P.val).toSquareBlock δ t).charpoly.map
        ι').IsRoot z → ‖z‖ = β ^ deg y := by
  classical
  obtain ⟨P', d', hup', hirr'⟩ := exists_isGradedUpper_irreducible_blocks
    (fun g : Γ => (ρ' g).val.map (algebraMap ℚ_[ℓ] ℂ_[ℓ]))
  set hsK := sumSplitting (R := ℂ_[ℓ]) r r'
  set Q : (Matrix (Fin r) (Fin r) ℂ_[ℓ])ˣ :=
    Units.map (RingHom.mapMatrix (algebraMap E ℂ_[ℓ])).toMonoidHom P
  set P₀ := hsK.blockDiagUnit Q P'
  set X : Γ → Matrix (Fin r) (Fin r) E := fun g =>
    P⁻¹.val * (ρ g).val.map (algebraMap ℚ_[ℓ] E) * P.val
  have hmapK : ∀ g, (ρ g).val.map (algebraMap ℚ_[ℓ] ℂ_[ℓ]) =
      ((ρ g).val.map (algebraMap ℚ_[ℓ] E)).map (algebraMap E ℂ_[ℓ]) := fun g => by
    rw [Matrix.map_map, IsScalarTower.algebraMap_eq ℚ_[ℓ] E ℂ_[ℓ]]
    rfl
  have hX : ∀ g, P₀⁻¹.val * (sumRep ρ ρ' g).val.map (algebraMap ℚ_[ℓ] ℂ_[ℓ]) * P₀.val =
      hsK.blockDiag ((X g).map (algebraMap E ℂ_[ℓ]))
        (P'⁻¹.val * (ρ' g).val.map (algebraMap ℚ_[ℓ] ℂ_[ℓ]) * P'.val) := fun g => by
    rw [sumRep_val, sumSplitting_blockDiag_map]
    change hsK.blockDiag Q⁻¹.val P'⁻¹.val * hsK.blockDiag _ _ * hsK.blockDiag Q.val P'.val = _
    rw [IsSplitting.blockDiag_mul, IsSplitting.blockDiag_mul, hmapK]
    congr 1
    simp only [X, Matrix.map_mul]
    rfl
  have hup₀ : ∀ g, IsGradedUpper (sumGrading δ d')
      (P₀⁻¹.val * (sumRep ρ ρ' g).val.map (algebraMap ℚ_[ℓ] ℂ_[ℓ]) * P₀.val) := fun g => by
    rw [hX]
    refine IsGradedUpper.sumSplitting_blockDiag (fun i j h => ?_) (hup' g)
    exact (congrArg (algebraMap E ℂ_[ℓ]) (hup g i j h)).trans (map_zero _)
  have hirr₀ : ∀ (t : ℤ) (W' : Submodule ℂ_[ℓ] (Fin (r + r') → ℂ_[ℓ])),
      W' ≤ coordSubspace (K := ℂ_[ℓ]) (fun i => sumGrading δ d' i = t) → W' ≠ ⊥ →
      (∀ g, ∀ v ∈ W', gradedDiag (sumGrading δ d')
        (P₀⁻¹.val * (sumRep ρ ρ' g).val.map (algebraMap ℚ_[ℓ] ℂ_[ℓ]) * P₀.val) *ᵥ v ∈ W') →
      W' = coordSubspace (K := ℂ_[ℓ]) (fun i => sumGrading δ d' i = t) := by
    intro t W' hW hW0 hst
    obtain ⟨s, rfl | rfl⟩ := Int.even_or_odd' t
    · refine eq_coordSubspace_of_coordMatrix (Fin.castAdd_injective r r') (sumGrading δ d') (2 * s)
        δ s (fun i => ?_) (fun g => gradedDiag (sumGrading δ d')
          (P₀⁻¹.val * (sumRep ρ ρ' g).val.map (algebraMap ℚ_[ℓ] ℂ_[ℓ]) * P₀.val))
        (fun g => (gradedDiag δ (X g)).map (algebraMap E ℂ_[ℓ]))
        (fun g => ?_) (fun W'' => hirr s W'') W' hW hW0 hst
      · exact sumGrading_eq_two_mul_iff δ d' s i
      · rw [hX, gradedDiag_sumSplitting_blockDiag, ← gradedDiag_map]
        exact IsSplitting.blockDiag_mul_J _ _ _
    · refine eq_coordSubspace_of_coordMatrix (Fin.natAdd_injective r' r) (sumGrading δ d')
        (2 * s + 1) d' s (fun i => ?_) (fun g => gradedDiag (sumGrading δ d')
          (P₀⁻¹.val * (sumRep ρ ρ' g).val.map (algebraMap ℚ_[ℓ] ℂ_[ℓ]) * P₀.val))
        (fun g => gradedDiag d' (P'⁻¹.val * (ρ' g).val.map (algebraMap ℚ_[ℓ] ℂ_[ℓ]) * P'.val))
        (fun g => ?_) (fun W'' => hirr' s W'') W' hW hW0 hst
      · induction i using Fin.addCases with
        | left j =>
          simp only [sumGrading_castAdd]
          refine ⟨fun h => by omega, fun ⟨j', hj', _⟩ => ?_⟩
          have := congrArg Fin.val hj'
          simp only [Fin.val_castAdd, Fin.val_natAdd] at this
          omega
        | right j =>
          simp only [sumGrading_natAdd]
          exact ⟨fun h => ⟨j, rfl, by omega⟩, fun ⟨j', hj', h⟩ => by
            rw [Fin.natAdd_injective r' r hj'] at h
            omega⟩
      · rw [hX, gradedDiag_sumSplitting_blockDiag]
        exact IsSplitting.blockDiag_mul_K' _ _ _
  set S : Set E := Set.range (fun p : Y × Fin r × Fin r => X (Fr p.1) p.2.1 p.2.2) ∪
    Set.range (fun p : Y × ℕ => algebraMap ℚ_[ℓ] E
      (((ρ (Fr p.1)).val.charpoly * (ρ' (Fr p.1)).val.charpoly).coeff p.2))
  have hS : S.Countable := (Set.countable_range _).union (Set.countable_range _)
  obtain ⟨φK, hφK⟩ := exists_padicComplex_ringHom_eq_on_intermediateField E ι' hS
  have hreal₀ : ∀ (y : Y) (m : ℕ), (φK.comp (algebraMap ℚ_[ℓ] ℂ_[ℓ]))
      ((sumRep ρ ρ' (Fr y)).val.charpoly.coeff m) ∈ Set.range ((↑) : ℝ → ℂ) := by
    intro y m
    rw [sumRep_val, charpoly_sumSplitting_blockDiag, RingHom.comp_apply,
      IsScalarTower.algebraMap_apply ℚ_[ℓ] E ℂ_[ℓ]]
    change φK ((algebraMap ℚ_[ℓ] E _ : E) : ℂ_[ℓ]) ∈ _
    rw [hφK _ (Algebra.subset_adjoin (Or.inr ⟨(y, m), rfl⟩)), hι']
    exact hreal y m
  obtain ⟨β, hβ, hβy⟩ := exists_norm_eq_pow_of_isGradedUpper φK H φ hcomm hD1 Fr deg hFr hdeg hfin
    hq (fun m τ hτ => htf _ m τ hτ) (sumRep ρ ρ') (continuous_sumRep hρ hρ') hreal₀ P₀
    (sumGrading δ d') hup₀ hirr₀ (2 * t)
  refine ⟨β, hβ, fun y z hz => hβy y z ?_⟩
  obtain ⟨n', e, he, hre⟩ := exists_injective_forall_iff_exists fun i => δ i = t
  have he' : Function.Injective (Fin.castAdd r' ∘ e) := (Fin.castAdd_injective r r').comp he
  have hre' : ∀ i, sumGrading δ d' i = 2 * t ↔ ∃ j, (Fin.castAdd r' ∘ e) j = i := fun i => by
    rw [sumGrading_eq_two_mul_iff]
    constructor
    · rintro ⟨j, rfl, hj⟩
      obtain ⟨k, rfl⟩ := (hre j).1 hj
      exact ⟨k, rfl⟩
    · rintro ⟨k, rfl⟩
      exact ⟨e k, rfl, (hre _).2 ⟨k, rfl⟩⟩
  have hchar : ((P₀⁻¹.val * (sumRep ρ ρ' (Fr y)).val.map (algebraMap ℚ_[ℓ] ℂ_[ℓ]) *
      P₀.val).toSquareBlock (sumGrading δ d') (2 * t)).charpoly =
      ((X (Fr y)).toSquareBlock δ t).charpoly.map (algebraMap E ℂ_[ℓ]) := by
    have hsub : (hsK.blockDiag ((X (Fr y)).map (algebraMap E ℂ_[ℓ]))
        (P'⁻¹.val * (ρ' (Fr y)).val.map (algebraMap ℚ_[ℓ] ℂ_[ℓ]) * P'.val)).submatrix
          (Fin.castAdd r' ∘ e) (Fin.castAdd r' ∘ e) =
        ((X (Fr y)).submatrix e e).map (algebraMap E ℂ_[ℓ]) := by
      ext j j'
      exact sumSplitting_blockDiag_castAdd_castAdd _ _ (e j) (e j')
    rw [hX, ← charpoly_submatrix_eq_charpoly_toSquareBlock _ _ _ he' hre', hsub,
      Matrix.charpoly_map, charpoly_submatrix_eq_charpoly_toSquareBlock _ _ _ he hre]
  have hcoeff : ∀ m, ((X (Fr y)).toSquareBlock δ t).charpoly.coeff m ∈ Algebra.adjoin ℤ S :=
    fun m => charpoly_coeff_mem_of_forall_mem (Algebra.adjoin ℤ S).toSubring _ (fun i j => by
      have hmem : X (Fr y) i.1 j.1 ∈ S := Set.mem_union_left _ ⟨(y, i.1, j.1), rfl⟩
      exact Algebra.subset_adjoin hmem) m
  have hpoly : (((X (Fr y)).toSquareBlock δ t).charpoly.map (algebraMap E ℂ_[ℓ])).map φK =
      ((X (Fr y)).toSquareBlock δ t).charpoly.map ι' := by
    rw [Polynomial.map_map]
    ext m
    rw [Polynomial.coeff_map, Polynomial.coeff_map, RingHom.comp_apply]
    exact hφK _ (hcoeff m)
  rwa [hchar, hpoly]

end Purity

section IntegerWeight

/-- **A pure constituent of a pointwise mixed representation has an integer weight.** If the roots
along `ι'` of `C y` (dividing the characteristic polynomial `Cfull y` over `ℚ_ℓ`) all have absolute
value `β ^ deg y`, and the roots of `Cfull y` along `ι` have absolute values `q ^ (deg y · w' / 2)`
with integers `w' ≤ w`, then `β = q ^ (w₀ / 2)` for an integer `w₀ ≤ w`. -/
public theorem exists_int_weight_of_norm_eq_pow {E : Type*} [Field E] [Algebra ℚ_[ℓ] E]
    (ι : ℚ_[ℓ] →+* ℂ) (ι' : E →+* ℂ) (hι' : ∀ c, ι' (algebraMap ℚ_[ℓ] E c) = ι c) {Y : Type*}
    (deg : Y → ℕ) (hdeg : ∀ y, 0 < deg y) {q : ℕ} (_hq : 1 < q) {w : ℤ} (C : Y → Polynomial E)
    (Cfull : Y → Polynomial ℚ_[ℓ]) (hdvd : ∀ y, C y ∣ (Cfull y).map (algebraMap ℚ_[ℓ] E))
    (hmix : ∀ y z, ((Cfull y).map ι).IsRoot z →
      ∃ w' : ℤ, w' ≤ w ∧ ‖z‖ = (q : ℝ) ^ (((deg y : ℤ) * w' : ℝ) / 2))
    {β : ℝ} (hβ : 0 < β) (hpure : ∀ y z, ((C y).map ι').IsRoot z → ‖z‖ = β ^ deg y) :
    ∃ w₀ : ℤ, w₀ ≤ w ∧ ∀ y z, ((C y).map ι').IsRoot z →
      ‖z‖ = (q : ℝ) ^ (((deg y : ℤ) * w₀ : ℝ) / 2) := by
  have hq0 : (0 : ℝ) ≤ q := Nat.cast_nonneg q
  have hrpow : ∀ (d : ℕ) (w' : ℤ), (q : ℝ) ^ (((d : ℤ) * w' : ℝ) / 2) =
      ((q : ℝ) ^ ((w' : ℝ) / 2)) ^ d := fun d w' => by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hq0]
    congr 1
    push_cast
    ring
  by_cases h : ∃ y z, ((C y).map ι').IsRoot z
  · obtain ⟨y₀, z₀, hz₀⟩ := h
    have hfull : ((Cfull y₀).map ι).IsRoot z₀ := by
      have hd := Polynomial.map_dvd ι' (hdvd y₀)
      rw [Polynomial.map_map] at hd
      have hcomp : ι'.comp (algebraMap ℚ_[ℓ] E) = ι := RingHom.ext hι'
      rw [hcomp] at hd
      obtain ⟨g, hg⟩ := hd
      rw [Polynomial.IsRoot, hg, Polynomial.eval_mul, hz₀.eq_zero, zero_mul]
    obtain ⟨w₀, hw₀, hn₀⟩ := hmix y₀ z₀ hfull
    have hβeq : β = (q : ℝ) ^ ((w₀ : ℝ) / 2) := by
      have h1 := (hpure y₀ z₀ hz₀).symm.trans hn₀
      rw [hrpow] at h1
      exact (pow_left_inj₀ hβ.le (Real.rpow_nonneg hq0 _) (hdeg y₀).ne').1 h1
    refine ⟨w₀, hw₀, fun y z hz => ?_⟩
    rw [hpure y z hz, hβeq, hrpow]
  · simp only [not_exists] at h
    exact ⟨w, le_rfl, fun y z hz => absurd hz (h y z)⟩

end IntegerWeight

end Stacks.EtaleCohomology

