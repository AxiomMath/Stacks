module

public import Mathlib.RingTheory.SimpleModule.Basic
public import Mathlib.RepresentationTheory.AlgebraRepresentation.Basic
public import Mathlib.RingTheory.Jacobson.Ring
public import Mathlib.LinearAlgebra.Matrix.ToLin
public import Mathlib.FieldTheory.IsAlgClosed.Basic

/-!
# Irreducibility over an algebraically closed field is absolute

Burnside's theorem: if `V` is a finite-dimensional vector space over an algebraically closed
field `F` and a subalgebra `S ⊆ End_F(V)` stabilizes no subspace other than `0` and `V`, then
`S = End_F(V)`.  (By Schur's lemma the `S`-endomorphisms of the simple `S`-module `V` are the
scalars, and the Jacobson density theorem gives every `F`-linear map on a basis.)

Consequently a family of matrices over `F` with no stable subspaces in `Fⁿ` other than `0` and
`Fⁿ` has none in `Kⁿ` either, for every extension `K` of `F`: the matrix units lie in the algebra
the family generates.  This is how the constituents of an `ℓ`-adic representation over `ℚ̄_ℓ` stay
irreducible over `ℂ_ℓ` in the proof of Weil II 3.2.3.

## Main results

* `Stacks.EtaleCohomology.subalgebra_eq_top_of_forall_stable`: Burnside's theorem.
* `Stacks.EtaleCohomology.eq_bot_or_eq_top_of_forall_mulVec_map_mem`: absolute irreducibility.
-/

@[expose] public noncomputable section

open Matrix Module

namespace Stacks.EtaleCohomology

section Burnside

variable {F V : Type*} [Field F] [IsAlgClosed F] [AddCommGroup V] [Module F V]
  [FiniteDimensional F V]

/-- **Burnside's theorem.**  A subalgebra of `End_F(V)`, `F` algebraically closed and `V`
finite-dimensional and nonzero, which stabilizes no subspace other than `0` and `V` is all of
`End_F(V)`. -/
public theorem subalgebra_eq_top_of_forall_stable [Nontrivial V]
    (S : Subalgebra F (Module.End F V))
    (hirr : ∀ W : Submodule F V, (∀ s ∈ S, ∀ v ∈ W, s v ∈ W) → W = ⊥ ∨ W = ⊤) : S = ⊤ := by
  classical
  have : IsSimpleOrder (Submodule S V) :=
    { eq_bot_or_eq_top := fun N => by
        simpa only [Submodule.restrictScalars_eq_bot_iff, Submodule.restrictScalars_eq_top_iff]
          using hirr (N.restrictScalars F) fun s hs v hv => N.smul_mem ⟨s, hs⟩ hv }
  have : IsSimpleModule S V := (isSimpleModule_iff S V).mpr inferInstance
  have hschur := IsSimpleModule.algebraMap_end_bijective_of_isAlgClosed F (A := S) (V := V)
  refine eq_top_iff.mpr fun f _ => ?_
  let f' : Module.End (Module.End S V) V :=
    { toFun := f
      map_add' := f.map_add
      map_smul' := fun g v => by
        obtain ⟨c, rfl⟩ := hschur.2 g
        change f ((algebraMap F (Module.End S V) c) v) = (algebraMap F (Module.End S V) c) (f v)
        rw [Module.algebraMap_end_apply, Module.algebraMap_end_apply, map_smul] }
  set b := Module.finBasis F V
  obtain ⟨a, ha⟩ := jacobson_density f' (Finset.univ.image b)
  have hfa : f = (a : Module.End F V) := by
    refine b.ext fun i => ?_
    have := ha (b i) (Finset.mem_image_of_mem _ (Finset.mem_univ i))
    exact this
  rw [hfa]
  exact a.2

end Burnside

section Absolute

variable {F K ι A : Type*} [Field F] [IsAlgClosed F] [Field K] [Algebra F K] [Fintype ι]
  [DecidableEq ι]

omit [DecidableEq ι] in
/-- **Irreducibility over an algebraically closed field is absolute.**  If the matrices `M a`
over an algebraically closed field `F` stabilize no subspace of `F^ι` other than `0` and `F^ι`,
then for every extension `K` of `F` they stabilize no subspace of `K^ι` other than `0` and
`K^ι`. -/
public theorem eq_bot_or_eq_top_of_forall_mulVec_map_mem (M : A → Matrix ι ι F)
    (hirr : ∀ W : Submodule F (ι → F), (∀ a, ∀ v ∈ W, M a *ᵥ v ∈ W) → W = ⊥ ∨ W = ⊤)
    (W : Submodule K (ι → K)) (hW : ∀ a, ∀ v ∈ W, (M a).map (algebraMap F K) *ᵥ v ∈ W) :
    W = ⊥ ∨ W = ⊤ := by
  classical
  by_cases hι : IsEmpty ι
  · right
    exact Subsingleton.elim _ _
  rw [not_isEmpty_iff] at hι
  -- the algebra generated by the family is everything
  set S := Algebra.adjoin F (Set.range fun a => Matrix.toLin' (M a)) with hS_def
  have hS : S = ⊤ := by
    refine subalgebra_eq_top_of_forall_stable S fun W' hW' => hirr W' fun a v hv => ?_
    have := hW' _ (Algebra.subset_adjoin ⟨a, rfl⟩) v hv
    rwa [Matrix.toLin'_apply] at this
  -- the matrices whose image over `K` stabilizes `W`
  let T : Subalgebra F (Module.End F (ι → F)) :=
    { carrier := {X | ∀ v ∈ W, (LinearMap.toMatrix' X).map (algebraMap F K) *ᵥ v ∈ W}
      mul_mem' := fun {X Y} hX hY v hv => by
        rw [LinearMap.toMatrix'_mul, Matrix.map_mul, ← Matrix.mulVec_mulVec]
        exact hX _ (hY v hv)
      add_mem' := fun {X Y} hX hY v hv => by
        rw [map_add, Matrix.map_add _ (map_add (algebraMap F K)), Matrix.add_mulVec]
        exact W.add_mem (hX v hv) (hY v hv)
      algebraMap_mem' := fun c v hv => by
        have hc : (LinearMap.toMatrix' (algebraMap F (Module.End F (ι → F)) c)).map
            (algebraMap F K) = algebraMap F K c • (1 : Matrix ι ι K) := by
          rw [Algebra.algebraMap_eq_smul_one, map_smul, LinearMap.toMatrix'_one]
          ext i j
          by_cases h : i = j <;> simp [h]
        change (LinearMap.toMatrix' (algebraMap F (Module.End F (ι → F)) c)).map
          (algebraMap F K) *ᵥ v ∈ W
        rw [hc, Matrix.smul_mulVec, Matrix.one_mulVec]
        exact W.smul_mem _ hv }
  have hST : S ≤ T := by
    rw [hS_def, Algebra.adjoin_le_iff]
    rintro _ ⟨a, rfl⟩ v hv
    change ((LinearMap.toMatrix' (Matrix.toLin' (M a))).map (algebraMap F K)) *ᵥ v ∈ W
    rw [LinearMap.toMatrix'_toLin']
    exact hW a v hv
  -- the matrix units stabilize `W`
  have hunit : ∀ i j, ∀ v ∈ W, (Pi.single i (v j) : ι → K) ∈ W := by
    intro i j v hv
    have hmem : Matrix.toLin' (Matrix.single i j (1 : F)) ∈ T := hST (hS ▸ Algebra.mem_top)
    have := hmem v hv
    rw [LinearMap.toMatrix'_toLin'] at this
    convert this using 1
    ext k
    by_cases h : i = k <;> simp [Matrix.mulVec, dotProduct, Matrix.single_apply, eq_comm, h]
  by_cases hbot : W = ⊥
  · exact Or.inl hbot
  right
  obtain ⟨w, hw, hw0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hbot
  obtain ⟨j, hj⟩ := Function.ne_iff.mp hw0
  refine eq_top_iff.mpr fun v _ => ?_
  rw [pi_eq_sum_univ v]
  refine Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ ?_
  have h1 := W.smul_mem (w j)⁻¹ (hunit i j w hw)
  convert h1 using 1
  ext k
  by_cases hk : i = k
  · subst hk
    simp [inv_mul_cancel₀ hj]
  · simp [hk, Ne.symm hk]

end Absolute

end Stacks.EtaleCohomology

end
