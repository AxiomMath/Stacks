module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Purity.ClassMapStalkGerms
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.KummerTheory.RootsOfUnityPowMap
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.KummerTheory.TwistNegOneTransition
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.KummerTheory.RootsOfUnityModuleSliceConstant
import StacksCore.Tactic.EgaSgaAttribute

/-!
# The class map on stalks with coefficients `μ_n`, `n ∣ N`

Keep the setting of `Stacks.EtaleCohomology.Purity.classMapGermMap`: a class `s` in
`R^q g_*(g⁻¹ μ_N)`, a point `Φ` of `U_étale` and a neighbourhood `V` of it carrying a primitive
`N`-th root of unity `ζ`. Let `N = ℓ n` and regard `μ_n` as a sheaf of `ℤ/N`-modules
(`Stacks.EtaleCohomology.Purity.restrictRootsOfUnityModule`). The local morphism
`μ_N ⟶ μ_n` with `ζ ↦ ζ^ℓ` is the `ℓ`-th power map, so the class map sends the germ of `ζ^ℓ` to
the germ of `s_n = p_* s`, `p` the power map
(`Stacks.EtaleCohomology.Purity.classMapGermMap_rootSection`). The germ of `ζ^ℓ` generates the
stalk of `μ_n` (`Stacks.EtaleCohomology.Purity.exists_nsmul_eq_germ_rootSection`), so the class
map on stalks with coefficients `μ_n` is bijective as soon as `a ↦ a • s_n` is bijective from
`ℤ/n` onto the stalk of `R^q g_*(g⁻¹ μ_n)`
(`Stacks.EtaleCohomology.Purity.bijective_classMapGermMap_restrictRootsOfUnityModule`): this is the
statement that the class of a divisor generates `R¹ j_* μ_n` along it.

## Main definitions

* `Stacks.EtaleCohomology.Purity.restrictRootsOfUnityModule`.
* `Stacks.EtaleCohomology.Purity.powClass`.

## Main results

* `Stacks.EtaleCohomology.Purity.exists_nsmul_eq_germ_rootSection`.
* `Stacks.EtaleCohomology.Purity.classMapGermMap_rootSection`.
* `Stacks.EtaleCohomology.Purity.bijective_classMapGermMap_restrictRootsOfUnityModule`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry AlgebraicGeometry.Scheme Opposite
  GrothendieckTopology

universe u

namespace Stacks.EtaleCohomology.Purity

open Stacks.Kummer

attribute [local instance] AlgebraicGeometry.preservesFilteredColimitsOfSize_forget_addCommGrpCat

variable {X U : Scheme.{u}} (g : X ⟶ U) (q : ℕ) (N : ℕ) [NeZero N]
  (s : ToType ((((smallEtalePushforwardAb g).rightDerived q).obj
    ((smallEtalePullbackAb g).obj (smallEtaleModuleSheafForgetAb (ZMod N)
      (rootsOfUnityModule.{u, 0} U N)))).obj.obj (op ((opensToEtale U).obj ⊤))))
  (Φ : Point.{u} U.smallEtaleTopology) {V : U.Etale} (v : Φ.fiber.obj V) {K : Type u} [Field K]
  (κ : K →+* Γ(V.left, ⊤)) {ζ : K} (hζ : IsPrimitiveRoot ζ N)
  (ℓ n : ℕ) (hn : ℓ * n = N) [NeZero n]

variable (U) in
/-- `μ_n` as a sheaf of `ℤ/N`-modules, for `N = ℓ n`. -/
@[sga "4 IX 3.0"]
abbrev restrictRootsOfUnityModule : Sheaf U.smallEtaleTopology (ModuleCat.{u + 1} (ZMod N)) :=
  (sheafCompose U.smallEtaleTopology (zmodRestrict.{u, 0} ℓ n N hn)).obj
    (rootsOfUnityModule.{u, 0} U n)

/-- The image of the class under the `ℓ`-th power map `μ_N ⟶ μ_n`. -/
def powClass :
    ToType ((((smallEtalePushforwardAb g).rightDerived q).obj
      ((smallEtalePullbackAb g).obj (smallEtaleModuleSheafForgetAb (ZMod N)
        (restrictRootsOfUnityModule U N ℓ n hn)))).obj.obj (op ((opensToEtale U).obj ⊤))) :=
  (((smallEtalePushforwardAb g).rightDerived q).map ((smallEtalePullbackAb g).map
    ((sheafCompose U.smallEtaleTopology (forget₂ (ModuleCat.{u + 1} (ZMod N))
      AddCommGrpCat.{u + 1})).map (rootsOfUnityModulePowMap.{u, 0} U ℓ n N hn)))).hom.app
    (op ((opensToEtale U).obj ⊤)) s

variable {ℓ n} in
/-- The primitive root `ζ^ℓ` as a section of `μ_n` over `V`. -/
abbrev powRootSection (hζ' : IsPrimitiveRoot (ζ ^ ℓ) n) :
    ToType ((smallEtaleModuleSheafForgetAb (ZMod N) (restrictRootsOfUnityModule U N ℓ n hn)).obj.obj
      (op V)) :=
  sliceRootSection.{u, 0} V κ hζ' (Over.mk (𝟙 V)) 1

variable {ℓ n} (hζ' : IsPrimitiveRoot (ζ ^ ℓ) n)

omit [NeZero N] in
/-- **The stalk of `μ_n` is generated by the germ of `ζ^ℓ`.** -/
theorem exists_nsmul_eq_germ_rootSection
    (m : ToType (Φ.presheafFiber.obj
      (smallEtaleModuleSheafForgetAb (ZMod N) (restrictRootsOfUnityModule U N ℓ n hn)).obj)) :
    ∃ i : ℕ, m = i • Φ.toPresheafFiber V v
      (smallEtaleModuleSheafForgetAb (ZMod N) (restrictRootsOfUnityModule U N ℓ n hn)).obj
        (powRootSection N κ hn hζ') := by
  let M := rootsOfUnityModule.{u, 0} U n
  let P := (smallEtaleModuleSheafForgetAb (ZMod N) (restrictRootsOfUnityModule U N ℓ n hn)).obj
  obtain ⟨Y₀, y₀, z, rfl⟩ := Φ.toPresheafFiber_jointly_surjective (P := P) m
  obtain ⟨W, w, a, h, rfl, rfl⟩ := exists_fiber_cone_of_point Φ y₀ v
  let κW := h.left.appTop.hom.comp κ
  have hS := imageSieve_sliceRootPresheafHom_mem.{u, 0} W κW hζ' (Over.mk (𝟙 W))
    (M.obj.map a.op z)
  rw [GrothendieckTopology.mem_over_iff] at hS
  obtain ⟨Y, f, hf, y, rfl⟩ := Φ.jointly_surjective _ hS w
  rw [Sieve.overEquiv_iff] at hf
  obtain ⟨t, ht⟩ := hf
  let f' : Y ⟶ W := f
  let rV : ToType (P.obj (op V)) := powRootSection N κ hn hζ'
  let rW : ToType (P.obj (op W)) := sliceRootSection.{u, 0} W κW hζ' (Over.mk (𝟙 W)) 1
  have ht' : (sliceRootSection.{u, 0} W κW hζ' (Over.mk (f ≫ 𝟙 W)) t.down :
      ToType (P.obj (op Y))) = P.map f'.op (P.map a.op z) := ht
  have hnat : P.map f'.op rW =
      (sliceRootSection.{u, 0} W κW hζ' (Over.mk (f ≫ 𝟙 W)) 1 : ToType (P.obj (op Y))) :=
    sliceRootSection_naturality.{u, 0} W κW hζ'
      (Over.homMk f : Over.mk (f ≫ 𝟙 W) ⟶ Over.mk (𝟙 W)) 1
  have hres : P.map h.op rV = rW := rootsOfUnitySheaf_map_sliceRootSection n h κ hζ' 1
  have h1 : t.down = t.down.val • (1 : ZMod n) := by
    rw [nsmul_eq_mul, mul_one, ZMod.natCast_zmod_val]
  have hsec : P.map f'.op (P.map a.op z) = t.down.val • P.map f'.op rW := by
    rw [← ht', hnat]
    conv_lhs => rw [h1]
    exact sliceRootSection_nsmul.{u, 0} W κW hζ' _ t.down.val 1
  refine ⟨t.down.val, ?_⟩
  rw [← Φ.toPresheafFiber_w_apply, ← Φ.toPresheafFiber_w_apply,
    ← Φ.toPresheafFiber_w_apply (f := h), ← Φ.toPresheafFiber_w_apply (f := f'), hres, hsec,
    map_nsmul]

/-- Evaluation at `ζ` of the restriction of the power map is `ζ^ℓ`. -/
theorem rootEvalHom_powMap {W : U.Etale} (a : W ⟶ V) :
    rootEvalHom N κ hζ (restrictRootsOfUnityModule U N ℓ n hn) a
        (show ToType ((smallEtaleModuleSheafForgetAb (ZMod N) (twistNegOneModule.{u, 0} U N
          (restrictRootsOfUnityModule U N ℓ n hn))).obj.obj (op W)) from
          (U.smallEtaleTopology.overPullback (ModuleCat.{u + 1} (ZMod N)) W).map
            (rootsOfUnityModulePowMap.{u, 0} U ℓ n N hn)) =
      (smallEtaleModuleSheafForgetAb (ZMod N) (restrictRootsOfUnityModule U N ℓ n hn)).obj.map a.op
        (powRootSection N κ hn hζ') := by
  have h1 := rootsOfUnitySheaf_map_sliceRootSection N a κ hζ 1
  have h2 := rootsOfUnitySheaf_map_sliceRootSection n a κ hζ' 1
  have h3 := rootsOfUnityPowMap_sliceRootSection.{u, 0} ℓ n N hn W (a.left.appTop.hom.comp κ)
    hζ hζ' (Over.mk (𝟙 W)) 1
  rw [Nat.cast_one, Nat.cast_one] at h3
  show (rootsOfUnityPowMap.{u, 0} U ℓ n N hn).hom.app (op W)
      ((rootsOfUnitySheaf.{u, 0} U N).obj.map a.op (rootSectionOver N κ hζ)) =
    (rootsOfUnitySheaf.{u, 0} U n).obj.map a.op (sliceRootSection.{u, 0} V κ hζ' (Over.mk (𝟙 V)) 1)
  rw [h1, h2]
  exact h3

/-- **The class map sends `ζ^ℓ` to the power class.** -/
theorem classMapLocalHom_powRootSection {W : U.Etale} (a : W ⟶ V) :
    classMapLocalHom g q N s κ hζ (restrictRootsOfUnityModule U N ℓ n hn) a
        ((smallEtaleModuleSheafForgetAb (ZMod N) (restrictRootsOfUnityModule U N ℓ n hn)).obj.map
          a.op (powRootSection N κ hn hζ')) =
      (((smallEtalePushforwardAb g).rightDerived q).obj ((smallEtalePullbackAb g).obj
        (smallEtaleModuleSheafForgetAb (ZMod N) (restrictRootsOfUnityModule U N ℓ n hn)))).obj.map
          ((isTerminal_opensToEtale_top U).from W).op (powClass g q N s ℓ n hn) := by
  rw [classMapLocalHom_apply]
  have key : (rootEvalEquiv N κ hζ (restrictRootsOfUnityModule U N ℓ n hn) a).symm
      ((smallEtaleModuleSheafForgetAb (ZMod N) (restrictRootsOfUnityModule U N ℓ n hn)).obj.map
        a.op (powRootSection N κ hn hζ')) =
      (show ToType ((smallEtaleModuleSheafForgetAb (ZMod N) (twistNegOneModule.{u, 0} U N
          (restrictRootsOfUnityModule U N ℓ n hn))).obj.obj (op W)) from
          (U.smallEtaleTopology.overPullback (ModuleCat.{u + 1} (ZMod N)) W).map
            (rootsOfUnityModulePowMap.{u, 0} U ℓ n N hn)) := by
    apply (rootEvalEquiv N κ hζ (restrictRootsOfUnityModule U N ℓ n hn) a).injective
    rw [AddEquiv.apply_symm_apply, rootEvalEquiv_apply, rootEvalHom_powMap N κ hζ hn hζ' a]
  rw [key, classMap_hom_app_apply]
  have e2 := higherDirectImageInverseImageSectionMap_comp_map g q W
    (𝟙 ((U.smallEtaleTopology.overPullback Ab.{u + 1} W).obj
      (smallEtaleModuleSheafForgetAb (ZMod N) (rootsOfUnityModule.{u, 0} U N))))
    ((sheafCompose U.smallEtaleTopology (forget₂ (ModuleCat.{u + 1} (ZMod N))
      AddCommGrpCat.{u + 1})).map (rootsOfUnityModulePowMap.{u, 0} U ℓ n N hn))
  rw [Category.id_comp, higherDirectImageInverseImageSectionMap_id, Category.id_comp] at e2
  have e3 := ConcreteCategory.congr_hom e2
    ((((smallEtalePushforwardAb g).rightDerived q).obj ((smallEtalePullbackAb g).obj
      (smallEtaleModuleSheafForgetAb (ZMod N) (rootsOfUnityModule.{u, 0} U N)))).obj.map
        ((isTerminal_opensToEtale_top U).from W).op s)
  exact e3.trans (NatTrans.naturality_apply (((smallEtalePushforwardAb g).rightDerived q).map
    ((smallEtalePullbackAb g).map ((sheafCompose U.smallEtaleTopology (forget₂
      (ModuleCat.{u + 1} (ZMod N)) AddCommGrpCat.{u + 1})).map
        (rootsOfUnityModulePowMap.{u, 0} U ℓ n N hn)))).hom
    ((isTerminal_opensToEtale_top U).from W).op s)

omit [NeZero N] in
/-- `n` kills the sections of `R^q g_*(g⁻¹ μ_n)`. -/
theorem nsmul_restrictRootsOfUnityModule_target {T : U.Etale}
    (x : ToType ((((smallEtalePushforwardAb g).rightDerived q).obj ((smallEtalePullbackAb g).obj
      (smallEtaleModuleSheafForgetAb (ZMod N) (restrictRootsOfUnityModule U N ℓ n hn)))).obj.obj
        (op T))) : n • x = 0 := by
  have h0 : n • 𝟙 (smallEtaleModuleSheafForgetAb (ZMod N)
      (restrictRootsOfUnityModule U N ℓ n hn)) = 0 := nsmul_id_rootsOfUnitySheaf_univ U n
  have hm : (smallEtalePullbackAb g ⋙ (smallEtalePushforwardAb g).rightDerived q).map
      (n • 𝟙 (smallEtaleModuleSheafForgetAb (ZMod N) (restrictRootsOfUnityModule U N ℓ n hn))) =
      n • (smallEtalePullbackAb g ⋙ (smallEtalePushforwardAb g).rightDerived q).map
        (𝟙 (smallEtaleModuleSheafForgetAb (ZMod N) (restrictRootsOfUnityModule U N ℓ n hn))) :=
    Functor.map_nsmul _
  rw [CategoryTheory.Functor.map_id, h0, Functor.map_zero] at hm
  have h := sheaf_nsmul_hom_app_apply.{u, 0} U (𝟙 (((smallEtalePushforwardAb g).rightDerived q).obj
    ((smallEtalePullbackAb g).obj (smallEtaleModuleSheafForgetAb (ZMod N)
      (restrictRootsOfUnityModule U N ℓ n hn))))) n (op T) x
  have h1 : n • 𝟙 (((smallEtalePushforwardAb g).rightDerived q).obj
      ((smallEtalePullbackAb g).obj (smallEtaleModuleSheafForgetAb (ZMod N)
        (restrictRootsOfUnityModule U N ℓ n hn)))) = 0 := hm.symm
  rw [h1] at h
  exact h.symm.trans rfl

/-- If `n • x = 0`, then `i • x` only depends on `i` in `ZMod n`. -/
private theorem nsmul_eq_val_nsmul {A : Type*} [AddCommGroup A] {n : ℕ} {x : A} (hx : n • x = 0)
    (i : ℕ) : i • x = (i : ZMod n).val • x := by
  rw [ZMod.val_natCast]
  exact nsmul_eq_mod_nsmul_of_nsmul_eq_zero n hx i

include hζ' in
/-- **The class map on stalks with coefficients `μ_n` is bijective** as soon as the power class
generates the stalk of `R^q g_*(g⁻¹ μ_n)` freely over `ℤ/n`. -/
theorem bijective_classMapGermMap_restrictRootsOfUnityModule
    (y : Φ.fiber.obj ((opensToEtale U).obj ⊤))
    (hgen : Function.Bijective (fun a : ZMod n => a.val • Φ.toPresheafFiber ((opensToEtale U).obj ⊤)
      y (((smallEtalePushforwardAb g).rightDerived q).obj ((smallEtalePullbackAb g).obj
        (smallEtaleModuleSheafForgetAb (ZMod N) (restrictRootsOfUnityModule U N ℓ n hn)))).obj
          (powClass g q N s ℓ n hn))) :
    Function.Bijective
      (classMapGermMap g q N s Φ v κ hζ (restrictRootsOfUnityModule U N ℓ n hn)) := by
  set B := (((smallEtalePushforwardAb g).rightDerived q).obj ((smallEtalePullbackAb g).obj
    (smallEtaleModuleSheafForgetAb (ZMod N) (restrictRootsOfUnityModule U N ℓ n hn)))).obj
  set P := (smallEtaleModuleSheafForgetAb (ZMod N) (restrictRootsOfUnityModule U N ℓ n hn)).obj
  set e := Φ.toPresheafFiber V v P (powRootSection N κ hn hζ') with he
  set Gm := Φ.toPresheafFiber ((opensToEtale U).obj ⊤) y B (powClass g q N s ℓ n hn) with hGm
  have hval : classMapGermMap g q N s Φ v κ hζ (restrictRootsOfUnityModule U N ℓ n hn) e = Gm := by
    have h1 := classMapLocalHom_powRootSection g q N s κ hζ hn hζ' (𝟙 V)
    rw [op_id, CategoryTheory.Functor.map_id, CategoryTheory.id_apply] at h1
    rw [he, classMapGermMap_germ g q N s Φ v κ hζ _ v (𝟙 V) (by simp), h1,
      Φ.toPresheafFiber_w_apply, hGm]
    have hy : Φ.fiber.map ((isTerminal_opensToEtale_top U).from V) v = y := by
      have := Φ.uniqueFiberObj _ (isTerminal_opensToEtale_top U)
      exact Subsingleton.elim _ _
    rw [hy]
  have hvaln : ∀ i : ℕ, classMapGermMap g q N s Φ v κ hζ
      (restrictRootsOfUnityModule U N ℓ n hn) (i • e) = i • Gm := fun i => by
    rw [map_nsmul, hval]
  have hne : n • e = 0 := by
    have h0 : n • powRootSection N κ hn hζ' = 0 := nsmul_rootsOfUnitySheaf_apply.{u, 0} U n _ _
    rw [he, ← map_nsmul, h0, map_zero]
  have hnG : n • Gm = 0 := by
    rw [hGm, ← map_nsmul, nsmul_restrictRootsOfUnityModule_target g q N hn, map_zero]
  constructor
  · intro p₁ p₂ h
    obtain ⟨i₁, rfl⟩ := exists_nsmul_eq_germ_rootSection N Φ v κ hn hζ' p₁
    obtain ⟨i₂, rfl⟩ := exists_nsmul_eq_germ_rootSection N Φ v κ hn hζ' p₂
    rw [← he, hvaln, hvaln, nsmul_eq_val_nsmul hnG i₁,
      nsmul_eq_val_nsmul hnG i₂] at h
    rw [← he, nsmul_eq_val_nsmul hne i₁, nsmul_eq_val_nsmul hne i₂,
      hgen.1 h]
  · intro b
    obtain ⟨a, ha⟩ := hgen.2 b
    exact ⟨a.val • e, (hvaln _).trans ha⟩

end Stacks.EtaleCohomology.Purity

end
