module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Purity.AffineLineOrigin
public import StacksFrontier.AlgebraicGeometry.Spaces.Chow.KeyFormulaChart.EtaleStalkOrder
public import StacksFrontier.AlgebraicGeometry.Chow.KeyLemma.TameSymbolReciprocityNonzero
public import StacksFrontier.AlgebraicGeometry.AffinePushforwardStalk.Basic

/-!
# The coordinate of `𝐀¹_k` is not an `N`-th power near the origin, étale locally

Let `k` be a field, `f : W ⟶ 𝐀¹_k` étale and `w ∈ W` a point over the origin. If a function `b`
on `f⁻¹(𝐆_m)` satisfies `b^N = t^n` for the coordinate `t`, then `N ∣ n`. Indeed the local ring
`𝒪_{𝐀¹, 0}` is the localization of `k[t]` at `(t)`, whose maximal ideal is generated by `t`; the
stalk map at `w` of the étale `f` is flat and carries the maximal ideal onto the maximal ideal,
so the image `τ` of `t` in `𝒪_{W, w}` is a nonzerodivisor generating the maximal ideal, of order
of vanishing one. Clearing the denominators of `b` on an affine neighbourhood of `w` gives
`c^N = τ^{n + mN}` in `𝒪_{W, w}`, and comparing orders of vanishing gives `N ∣ n`.

This is the valuation input of the generator property of the Kummer class of the coordinate
(`Stacks.EtaleCohomology.Purity.AffineLineKummerGenerator`): `∂ t` has order exactly `N` in every
stalk of `R¹ j_* μ_N` over the origin.

## Main results

* `Stacks.EtaleCohomology.Purity.dvd_of_pow_eq_pow_of_ord_eq_one`.
* `Stacks.EtaleCohomology.Purity.maximalIdeal_stalk_affineLine`.
* `Stacks.EtaleCohomology.Purity.dvd_of_pow_eq_coordinate_pow`.
* `Stacks.EtaleCohomology.Purity.dvd_of_pow_eq_coordinate_pow_pullback`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry AlgebraicGeometry.Scheme
  TopologicalSpace IsLocalRing
open scoped nonZeroDivisors

universe u

namespace Stacks.EtaleCohomology.Purity

attribute [-instance] CategoryTheory.catToReflQuiver

/-- **Orders of vanishing divide**: if `τ` is a nonzerodivisor of order of vanishing one and
`c^N = τ^M` with `N ≠ 0`, then `N ∣ M`. -/
theorem dvd_of_pow_eq_pow_of_ord_eq_one {R : Type*} [CommRing R] {τ c : R} (hτ : τ ∈ R⁰)
    (hord : Ring.ord R τ = 1) {N M : ℕ} (hN : N ≠ 0) (h : c ^ N = τ ^ M) : N ∣ M := by
  have hc : c ∈ R⁰ := by
    have h1 : c ^ N ∈ R⁰ := h ▸ pow_mem hτ M
    obtain ⟨N', rfl⟩ := Nat.exists_eq_succ_of_ne_zero hN
    rw [pow_succ] at h1
    exact (mul_mem_nonZeroDivisors.1 h1).2
  have h1 := congrArg (Ring.ord R) h
  rw [Ring.ord_pow hc, Ring.ord_pow hτ, hord] at h1
  cases hc' : Ring.ord R c with
  | top =>
    rw [hc', nsmul_eq_mul, ENat.mul_top (by exact_mod_cast hN)] at h1
    simp at h1
  | coe r =>
    rw [hc', nsmul_eq_mul, nsmul_eq_mul, mul_one] at h1
    exact ⟨r, by exact_mod_cast h1.symm⟩

variable (k : Type u) [Field k]

/-- The ideal `(t)` of `k[t] = Γ(𝐀¹_k, 𝒪)` is maximal. (This is the coordinate of
`Stacks.EtaleCohomology.Purity.affineLine`; the base's
`AlgebraicGeometry.AffineLineInvolution.isMaximal_span_coordinate` is the same fact for the
coordinate of a different model of the affine line.) -/
theorem isMaximal_span_coordinate :
    (Ideal.span {coordinate k} : Ideal Γ(affineLine k, ⊤)).IsMaximal := by
  let e := globalSectionsEquiv k
  have hX : (Ideal.span {(MvPolynomial.X ⟨0⟩ : MvPolynomial (ULift.{u} (Fin 1)) k)}).IsMaximal := by
    have h : Ideal.span {(MvPolynomial.X ⟨0⟩ : MvPolynomial (ULift.{u} (Fin 1)) k)} =
        RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (ULift.{u} (Fin 1)) k →+* k) :=
      le_antisymm (Ideal.span_le.2 (by simp))
        ((ker_constantCoeff_le_iff k _).2 (Ideal.mem_span_singleton_self _))
    rw [h]
    exact RingHom.ker_isMaximal_of_surjective _ (fun c => ⟨MvPolynomial.C c, by simp⟩)
  have h : Ideal.span {coordinate k} = Ideal.comap (e : Γ(affineLine k, ⊤) →+*
      MvPolynomial (ULift.{u} (Fin 1)) k)
      (Ideal.span {(MvPolynomial.X ⟨0⟩ : MvPolynomial (ULift.{u} (Fin 1)) k)}) := by
    ext f
    rw [Ideal.mem_comap, Ideal.mem_span_singleton, Ideal.mem_span_singleton,
      ← globalSectionsEquiv_coordinate]
    exact (map_dvd_iff e).symm
  rw [h]
  exact Ideal.comap_isMaximal_of_surjective _ e.surjective

variable {k}

/-- **The maximal ideal of the local ring of `𝐀¹_k` at a point off `𝐆_m` is generated by the
coordinate**, and the coordinate is a nonzerodivisor there. -/
theorem maximalIdeal_stalk_affineLine {p : affineLine k} (hp : p ∉ (punctured k : Set _)) :
    maximalIdeal ((affineLine k).presheaf.stalk p) =
        Ideal.span {(affineLine k).presheaf.germ ⊤ p trivial (coordinate k)} ∧
      (affineLine k).presheaf.germ ⊤ p trivial (coordinate k) ∈
        ((affineLine k).presheaf.stalk p)⁰ := by
  let : Algebra Γ(affineLine k, ⊤) ((affineLine k).presheaf.stalk p) :=
    (affineLine k).presheaf.algebra_section_stalk (⟨p, trivial⟩ : (⊤ : (affineLine k).Opens))
  have hU := isAffineOpen_top (affineLine k)
  have hloc := hU.isLocalization_stalk (⟨p, trivial⟩ : (⊤ : (affineLine k).Opens))
  set P := (hU.primeIdealOf ⟨p, trivial⟩).asIdeal
  have htP : coordinate k ∈ P := by
    by_contra h
    exact hp ((hU.mem_primeCompl_iff_mem_basicOpen (x := p) trivial (coordinate k)).1 h)
  have hP : P = Ideal.span {coordinate k} :=
    ((isMaximal_span_coordinate k).eq_of_le (hU.primeIdealOf ⟨p, trivial⟩).isPrime.ne_top
      (Ideal.span_le.2 (Set.singleton_subset_iff.2 htP))).symm
  have halg : algebraMap Γ(affineLine k, ⊤) ((affineLine k).presheaf.stalk p) (coordinate k) =
      (affineLine k).presheaf.germ ⊤ p trivial (coordinate k) := rfl
  refine ⟨?_, ?_⟩
  · rw [← IsLocalization.AtPrime.map_eq_maximalIdeal P ((affineLine k).presheaf.stalk p), hP,
      Ideal.map_span, Set.image_singleton, halg]
  · have : IsLocalization.AtPrime ((affineLine k).presheaf.stalk p) P := hloc
    have : IsDomain ((affineLine k).presheaf.stalk p) :=
      IsLocalization.isDomain_of_le_nonZeroDivisors (S := (affineLine k).presheaf.stalk p)
        (M := P.primeCompl) (Ideal.primeCompl_le_nonZeroDivisors P)
    refine mem_nonZeroDivisors_of_ne_zero ?_
    intro h0
    rw [← halg, IsLocalization.to_map_eq_zero_iff _ (Ideal.primeCompl_le_nonZeroDivisors P)] at h0
    exact (prime_coordinate k).ne_zero h0

/-- **The image of the coordinate in the local ring at a point of an étale `W` over the origin
is a nonzerodivisor of order of vanishing one.** -/
theorem ord_germ_coordinate {W : Scheme.{u}} (f : W ⟶ affineLine k) [Etale f] (w : W)
    (hw : f.base w ∉ (punctured k : Set _)) :
    (W.presheaf.germ ⊤ w trivial (f.appTop (coordinate k))) ∈ (W.presheaf.stalk w)⁰ ∧
      Ring.ord (W.presheaf.stalk w)
        (W.presheaf.germ ⊤ w trivial (f.appTop (coordinate k))) = 1 := by
  obtain ⟨hm, hnz⟩ := maximalIdeal_stalk_affineLine hw
  have hg : W.presheaf.germ ⊤ w trivial (f.appTop (coordinate k)) =
      (f.stalkMap w).hom ((affineLine k).presheaf.germ ⊤ (f.base w) trivial (coordinate k)) :=
    (Scheme.Hom.germ_stalkMap_apply f ⊤ w trivial (coordinate k)).symm
  rw [hg]
  refine ⟨stalkMap_mem_nonZeroDivisors_of_flat f w hnz, Stacks.Chow.ord_eq_one_of_isMaximal ?_⟩
  have h := map_maximalIdeal_stalkMap_of_etale f w
  rw [hm, Ideal.map_span, Set.image_singleton] at h
  rw [h]
  exact maximalIdeal.isMaximal _

/-- **Clearing denominators in a localization**: if `B` is the localization of `A` away from
`g`, `γ : A ⟶ O` carries `g` to a nonzerodivisor of order of vanishing one and `b^N = g^n` in
`B`, then `N ∣ n`. -/
theorem dvd_of_pow_eq_algebraMap_pow {A B O : Type*} [CommRing A] [CommRing B] [CommRing O]
    [Algebra A B] (g : A) [IsLocalization.Away g B] (γ : A →+* O) (hτ0 : γ g ∈ O⁰)
    (hτ1 : Ring.ord O (γ g) = 1) (b : B) {N n : ℕ} (hN : N ≠ 0)
    (h : b ^ N = algebraMap A B (g ^ n)) : N ∣ n := by
  obtain ⟨⟨c, ⟨_, m, rfl⟩⟩, hc⟩ := IsLocalization.surj (Submonoid.powers g) b
  have hc' : b * algebraMap A B (g ^ m) = algebraMap A B c := hc
  have hcN : algebraMap A B (c ^ N) = algebraMap A B (g ^ (n + m * N)) := by
    rw [map_pow, ← hc', mul_pow, h, ← map_pow, ← map_mul, ← pow_mul, ← pow_add, mul_comm m N]
  obtain ⟨⟨_, l, rfl⟩, hl⟩ := (IsLocalization.eq_iff_exists (Submonoid.powers g) B).1 hcN
  have hl' : g ^ l * c ^ N = g ^ l * g ^ (n + m * N) := hl
  have hl'' := congrArg γ hl'
  simp only [map_mul, map_pow] at hl''
  have hcN' : (γ c) ^ N = (γ g) ^ (n + m * N) := by
    have hz : (γ g) ^ l * ((γ c) ^ N - (γ g) ^ (n + m * N)) = 0 := by
      rw [mul_sub, hl'', sub_self]
    exact sub_eq_zero.1 ((mul_left_mem_nonZeroDivisors_eq_zero_iff (pow_mem hτ0 l)).1 hz)
  exact (Nat.dvd_add_left (dvd_mul_left N m)).1 (dvd_of_pow_eq_pow_of_ord_eq_one hτ0 hτ1 hN hcN')

/-- **The coordinate is not an `N`-th power near a point over the origin, étale locally**: for an
étale `f : W ⟶ 𝐀¹_k`, a point `w` over the origin and a function `b` on `f⁻¹(𝐆_m)` with
`b^N = t^n`, `N ∣ n`. -/
theorem dvd_of_pow_eq_coordinate_pow {W : Scheme.{u}} (f : W ⟶ affineLine k) [Etale f] (w : W)
    (hw : f.base w ∉ (punctured k : Set _)) (b : Γ(W, f ⁻¹ᵁ punctured k)) {N n : ℕ} (hN : N ≠ 0)
    (h : b ^ N = (W.presheaf.map (homOfLE le_top).op (f.appTop (coordinate k))) ^ n) : N ∣ n := by
  obtain ⟨V, hV, hwV, -⟩ := (Opens.isBasis_iff_nbhd.mp (isBasis_affineOpens W))
    (show w ∈ (⊤ : W.Opens) from trivial)
  have hVa : IsAffineOpen V := hV
  set g := W.presheaf.map (homOfLE (le_top : V ≤ ⊤)).op (f.appTop (coordinate k)) with hg
  have hUb : V ⊓ f ⁻¹ᵁ punctured k = W.basicOpen g := by
    rw [hg, Scheme.basicOpen_res, ← Scheme.preimage_basicOpen_top]
  let : Algebra Γ(W, V) Γ(W, V ⊓ f ⁻¹ᵁ punctured k) :=
    (W.presheaf.map (homOfLE (inf_le_left : V ⊓ f ⁻¹ᵁ punctured k ≤ V)).op).hom.toAlgebra
  have := hVa.isLocalization_of_eq_basicOpen g (homOfLE inf_le_left) hUb
  have hgU : W.presheaf.map (homOfLE (inf_le_right : V ⊓ f ⁻¹ᵁ punctured k ≤ f ⁻¹ᵁ punctured k)).op
      (W.presheaf.map (homOfLE le_top).op (f.appTop (coordinate k))) =
      W.presheaf.map (homOfLE (inf_le_left : V ⊓ f ⁻¹ᵁ punctured k ≤ V)).op g := by
    rw [hg]
    generalize f.appTop (coordinate k) = c
    rw [← CommRingCat.comp_apply, ← CommRingCat.comp_apply, ← Functor.map_comp,
      ← Functor.map_comp]
    rfl
  have hγ : W.presheaf.germ V w hwV g = W.presheaf.germ ⊤ w trivial (f.appTop (coordinate k)) :=
    TopCat.Presheaf.germ_res_apply _ _ _ _ _
  obtain ⟨hτ0, hτ1⟩ := ord_germ_coordinate f w hw
  rw [← hγ] at hτ0 hτ1
  refine dvd_of_pow_eq_algebraMap_pow (B := Γ(W, V ⊓ f ⁻¹ᵁ punctured k)) g
    (W.presheaf.germ V w hwV).hom hτ0 hτ1
    (W.presheaf.map (homOfLE (inf_le_right : V ⊓ f ⁻¹ᵁ punctured k ≤ f ⁻¹ᵁ punctured k)).op b)
    hN ?_
  rw [← map_pow, h, map_pow, map_pow (algebraMap _ _), RingHom.algebraMap_toAlgebra, hgU]

/-- The sections of `W ×_X U` along an open `U ⊆ X` are sections of `W` over `f⁻¹ U`,
compatibly with restriction from `W`. -/
def pullbackOpensSectionsHom {W X : Scheme.{u}} (f : W ⟶ X) (U : X.Opens) :
    Γ(pullback f U.ι, ⊤) ⟶ Γ(W, f ⁻¹ᵁ U) :=
  (pullbackRestrictIsoRestrict f U).inv.appTop ≫ (f ⁻¹ᵁ U).topIso.hom

/-- `Stacks.EtaleCohomology.Purity.pullbackOpensSectionsHom` carries the pullback of a global
function of `W` to its restriction to `f⁻¹ U`. -/
theorem pullbackOpensSectionsHom_appTop {W X : Scheme.{u}} (f : W ⟶ X) (U : X.Opens)
    (c : Γ(W, ⊤)) :
    pullbackOpensSectionsHom f U ((pullback.fst f U.ι).appTop c) =
      W.presheaf.map (homOfLE le_top).op c := by
  have h : (pullbackRestrictIsoRestrict f U).inv ≫ pullback.fst f U.ι = (f ⁻¹ᵁ U).ι :=
    pullbackRestrictIsoRestrict_inv_fst f U
  have h2 : W.presheaf.map (homOfLE le_top).op ≫ (f ⁻¹ᵁ U).topIso.inv = (f ⁻¹ᵁ U).ι.appTop := by
    rw [Scheme.Opens.ι_appTop, Scheme.Opens.topIso_inv]
    exact (W.presheaf.map_comp _ _).symm
  have h3 : (pullback.fst f U.ι).appTop ≫ pullbackOpensSectionsHom f U =
      W.presheaf.map (homOfLE le_top).op := by
    rw [pullbackOpensSectionsHom, ← Category.assoc, ← Scheme.Hom.comp_appTop, h, ← h2,
      Category.assoc, Iso.inv_hom_id, Category.comp_id]
  exact congrArg (fun φ => φ.hom c) h3

/-- **The coordinate is not an `N`-th power on `W ×_{𝐀¹} 𝐆_m` near a point over the origin**, for
an étale `f : W ⟶ 𝐀¹_k`. -/
theorem dvd_of_pow_eq_coordinate_pow_pullback {W : Scheme.{u}} (f : W ⟶ affineLine k) [Etale f]
    (w : W) (hw : f.base w ∉ (punctured k : Set _)) (a : Γ(pullback f (punctured k).ι, ⊤))
    {N n : ℕ} (hN : N ≠ 0)
    (h : a ^ N = ((pullback.fst f (punctured k).ι ≫ f).appTop (coordinate k)) ^ n) : N ∣ n := by
  refine dvd_of_pow_eq_coordinate_pow f w hw (pullbackOpensSectionsHom f (punctured k) a) hN ?_
  rw [← map_pow, h, map_pow, Scheme.Hom.comp_appTop, CommRingCat.comp_apply,
    pullbackOpensSectionsHom_appTop]

end Stacks.EtaleCohomology.Purity

