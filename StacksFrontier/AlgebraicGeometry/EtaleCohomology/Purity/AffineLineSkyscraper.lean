module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Purity.AffineLineHigherDirectImage
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.SmoothBaseChange.LocalAcyclicity.ConstantRestriction

/-!
# `R¹j_* μ_ℓ` is the skyscraper `ℤ/ℓ` at the origin

Let `k` be an algebraically closed field, `ℓ ≥ 1` an integer invertible in `k` and
`j : 𝐆_m ⟶ 𝐀¹_k`. The sheaf `R = R¹j_*(j⁻¹ μ_ℓ)` vanishes on `𝐆_m`, so `R ≅ 0_* M` for
`M = 0⁻¹ R` on `(Spec k)_étale`. Sheaves on `(Spec k)_étale` are their global sections, and
`Γ(Spec k, M) = Γ(𝐀¹, R) = H¹(𝐆_m, μ_ℓ) ≅ ℤ/ℓ`, generated by the Kummer class of the coordinate,
like the constant sheaf `ℤ/ℓ`. So `R ≅ 0_* (ℤ/ℓ)`.

## Main results

* `Stacks.EtaleCohomology.Purity.nonempty_rightDerived_one_iso_origin`.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite AlgebraicGeometry

universe u

namespace Stacks.EtaleCohomology.Purity

variable (k : Type u) [Field k] [IsAlgClosed k] {ℓ : ℕ} (hℓ : IsUnit (ℓ : k))

omit [IsAlgClosed k] in
/-- `j⁻¹ μ_ℓ` is killed by `ℓ`, on every stalk. -/
theorem nsmul_eq_zero_stalk_rootsOfUnityPunctured (t : GeometricPoint (punctured k).toScheme)
    (a : (smallEtaleStalkAb t.hom).obj (rootsOfUnityPunctured k (ℓ := ℓ))) : ℓ • a = 0 := by
  have hμ : ℓ • 𝟙 (Stacks.Kummer.rootsOfUnitySheaf.{u, 0} (affineLine k) ℓ) = 0 := by
    rw [← cancel_mono (Stacks.Kummer.rootsOfUnityι.{u, 0} (affineLine k) ℓ), Preadditive.nsmul_comp,
      Category.id_comp, zero_comp]
    have := Stacks.Kummer.rootsOfUnityι_comp_powMap.{u, 0} (affineLine k) ℓ
    simpa [Stacks.Kummer.powMap, Preadditive.comp_nsmul] using this
  have hF : ℓ • 𝟙 (rootsOfUnityPunctured k (ℓ := ℓ)) = 0 := by
    rw [← CategoryTheory.Functor.map_id, ← Functor.map_nsmul, hμ, Functor.map_zero]
  have := congrArg (fun f => ((smallEtaleStalkAb t.hom).map f) a) hF
  simpa [Functor.map_nsmul] using this

include hℓ in
/-- **`R¹j_*(j⁻¹ μ_ℓ) ≅ 0_* (ℤ/ℓ)`** for the inclusion `j : 𝐆_m ⟶ 𝐀¹`. -/
theorem nonempty_rightDerived_one_iso_origin :
    Nonempty (((smallEtalePushforwardAb (punctured k).ι).rightDerived 1).obj
        (rootsOfUnityPunctured k (ℓ := ℓ)) ≅
      (etaleAbelianDirectImage.{u, 0} (origin k)).obj
        (etaleConstantSheaf (Spec (.of k)) (ZMod ℓ))) := by
  set R := ((smallEtalePushforwardAb (punctured k).ι).rightDerived 1).obj
    (rootsOfUnityPunctured k (ℓ := ℓ))
  have hℓ0 : 0 < ℓ := Nat.pos_of_ne_zero (by rintro rfl; simp at hℓ)
  have hres : IsZero ((etaleRestriction.{u, 0} (punctured k).ι).obj R) :=
    isZero_restriction_rightDerived_of_isOpenImmersion (punctured k).ι _
      (fun t a => ⟨ℓ, hℓ0, by
        have := isUnit_natCast_globalSections_of_over (affineLine k ↘ Spec (.of k)) hℓ
        exact_mod_cast this, nsmul_eq_zero_stalk_rootsOfUnityPunctured k t a⟩) 1 one_pos
  have hunit := isIso_unit_origin_of_isZero_restriction k R hres
  let M := (etaleAbelianInverseImage.{u, 0} (origin k)).obj R
  let C := etaleConstantSheaf (Spec (.of k)) (ZMod ℓ)
  let : MorphismProperty.ContainsIdentities (@Etale.{u}) := ⟨fun _ => inferInstance⟩
  have hT : IsTerminal (Scheme.Etale.mk (𝟙 (Spec (.of k)))) :=
    MorphismProperty.Over.mkIdTerminal _ _
  let Γk := (sheafSections (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{u + 1}).obj
    (op (Scheme.Etale.mk (𝟙 (Spec (.of k)))))
  let eM : Γk.obj M ≅ (Sheaf.Γ (affineLine k).smallEtaleTopology AddCommGrpCat.{u + 1}).obj R :=
    ((Sheaf.ΓNatIsoSheafSections _ _ hT).app M).symm ≪≫
      ((etaleAbelianDirectImageGammaIso.{u, 0} (origin k)).app M).symm ≪≫
      (Sheaf.Γ _ _).mapIso (asIso ((etaleAbelianInverseImageDirectImageAdj.{u, 0}
        (origin k)).unit.app R)).symm
  have :=
    isIso_constantSheafAdj_unit_app_of_isSepClosed k (AddCommGrpCat.of (ULift.{u + 1} (ZMod ℓ)))
  let eC : Γk.obj C ≅ AddCommGrpCat.of (ULift.{u + 1} (ZMod ℓ)) :=
    (asIso ((constantSheafAdj (Spec (.of k)).smallEtaleTopology AddCommGrpCat.{u + 1}
      (isTerminalEtaleMkId _)).unit.app (AddCommGrpCat.of (ULift.{u + 1} (ZMod ℓ))))).symm
  let eΓ : Γk.obj M ≅ Γk.obj C :=
    ((eM.addCommGroupIsoToAddEquiv.trans
      (sectionsRightDerivedOneRootsOfUnityEquiv k hℓ0 hℓ)).trans
      (eC.addCommGroupIsoToAddEquiv.trans AddEquiv.ulift).symm).toAddCommGrpIso
  have := isEquivalence_sheafSections_final_of_isSepClosed k AddCommGrpCat.{u + 1}
  exact ⟨asIso ((etaleAbelianInverseImageDirectImageAdj.{u, 0} (origin k)).unit.app R) ≪≫
    (etaleAbelianDirectImage.{u, 0} (origin k)).mapIso (Γk.preimageIso eΓ)⟩

end Stacks.EtaleCohomology.Purity

end
