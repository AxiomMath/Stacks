module

public import Mathlib.AlgebraicGeometry.IdealSheaf.Functorial
public import StacksFrontier.AlgebraicGeometry.DivisorFlatPullback.Basic
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Purity.RelativeCurveChart

/-!
# Local equations of a closed subscheme

Let `i : Z ⟶ U` be a closed immersion. A section `t` of `𝒪_U` over an open `V` is a *local
equation* of `Z` on `V` (`Stacks.EtaleCohomology.Purity.IsLocalEquation`) if on every affine open
`W ⊆ V` the ideal of `Z` is generated by `t|_W`.

Two local equations on the same open agree up to a unit near each point, or vanish there
(`Stacks.EtaleCohomology.Purity.IsLocalEquation.exists_eq_unit_mul_or_eq_zero`). No regularity
is needed: if `t₁ = c t₂` and `t₂ = d t₁` on an affine `W`, then either `c` is a unit at the point,
or `1 - c d` is, and then `t₁ (1 - c d) = 0` kills `t₁` near the point. A local equation is
invertible off `Z` (`Stacks.EtaleCohomology.Purity.IsLocalEquation.diff_range_subset_basicOpen`),
and `1` is a local equation on every open missing `Z`
(`Stacks.EtaleCohomology.Purity.isLocalEquation_one_of_disjoint`).

The pullback of the coordinate of `𝔸¹_k` along a morphism `φ : V ⟶ 𝔸¹_k` whose fibre over the
origin is `Z ∩ V` is a local equation of `Z` on `V`
(`Stacks.EtaleCohomology.Purity.isLocalEquation_of_isPullback_origin`). Through the étale charts
of a smooth relative curve (`Stacks.EtaleCohomology.Purity.exists_smooth_affineLine_chart`), every
point of `U` has a local equation of an étale divisor `Z` around it
(`Stacks.EtaleCohomology.Purity.exists_isLocalEquation`). These are the local data from which the
fundamental class of `Z` in `R¹ j_* μ_N` is glued.

## Main definitions

* `Stacks.EtaleCohomology.Purity.IsLocalEquation`.

## Main results

* `Stacks.EtaleCohomology.Purity.IsLocalEquation.exists_eq_unit_mul_or_eq_zero`.
* `Stacks.EtaleCohomology.Purity.IsLocalEquation.diff_range_subset_basicOpen`.
* `Stacks.EtaleCohomology.Purity.isLocalEquation_of_isPullback_origin`.
* `Stacks.EtaleCohomology.Purity.exists_isLocalEquation`.
-/

@[expose] public section

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry TopologicalSpace Opposite

universe u

namespace Stacks.EtaleCohomology.Purity

section LocalEquation

variable {U Z : Scheme.{u}} (i : Z ⟶ U) [IsClosedImmersion i]

/-- **A local equation of the closed subscheme `Z` on the open `V`**: a section `t` of `𝒪_U`
over `V` such that on every affine open `W ⊆ V` the ideal of `Z` is generated by `t|_W`. -/
def IsLocalEquation (V : U.Opens) (t : Γ(U, V)) : Prop :=
  ∀ (W : U.Opens) (hW : IsAffineOpen W) (h : W ≤ V),
    i.ker.ideal ⟨W, hW⟩ = Ideal.span {U.presheaf.map (homOfLE h).op t}

/-- Restricting twice is restricting once. -/
theorem presheaf_map_homOfLE_homOfLE {O W V : U.Opens} (h₁ : O ≤ W) (h₂ : W ≤ V)
    (t : Γ(U, V)) :
    U.presheaf.map (homOfLE h₁).op (U.presheaf.map (homOfLE h₂).op t) =
      U.presheaf.map (homOfLE (h₁.trans h₂)).op t := by
  rw [← CommRingCat.comp_apply, ← Functor.map_comp]
  rfl

/-- Three restrictions of `𝒪_U` compose to the restriction along the composite inclusion. -/
theorem presheaf_map_comp_comp {A B C D : U.Opensᵒᵖ} (a : A ⟶ B) (b : B ⟶ C) (c : C ⟶ D)
    (d : A ⟶ D) : U.presheaf.map a ≫ U.presheaf.map b ≫ U.presheaf.map c = U.presheaf.map d := by
  rw [← Functor.map_comp, ← Functor.map_comp]
  exact congrArg _ (Subsingleton.elim _ _)

variable {i}

omit [IsClosedImmersion i] in
/-- A local equation restricts to a local equation on a smaller open. -/
theorem IsLocalEquation.restrict {V V' : U.Opens} {t : Γ(U, V)} (ht : IsLocalEquation i V t)
    (h : V' ≤ V) : IsLocalEquation i V' (U.presheaf.map (homOfLE h).op t) := by
  intro W hW hWV'
  rw [ht W hW (hWV'.trans h), presheaf_map_homOfLE_homOfLE]

/-- On an affine open missing `Z`, the ideal of `Z` is the unit ideal. -/
theorem ker_ideal_eq_top_of_disjoint (W : U.affineOpens)
    (hW : Disjoint (W : Set U) (Set.range i.base)) : i.ker.ideal W = ⊤ := by
  rw [Scheme.Hom.ker_apply]
  have hbot : i ⁻¹ᵁ (W : U.Opens) = ⊥ := by
    ext z
    simp only [Scheme.Hom.mem_preimage, SetLike.mem_coe, Opens.mem_bot, iff_false]
    intro hz
    exact Set.disjoint_left.1 hW hz ⟨z, rfl⟩
  have : Subsingleton Γ(Z, i ⁻¹ᵁ (W : U.Opens)) := by
    rw [hbot]
    infer_instance
  exact (Ideal.eq_top_iff_one _).2 (by rw [RingHom.mem_ker]; exact Subsingleton.elim _ _)

/-- **`1` is a local equation of `Z` on an open missing `Z`.** -/
theorem isLocalEquation_one_of_disjoint {V : U.Opens}
    (hV : Disjoint (V : Set U) (Set.range i.base)) : IsLocalEquation i V 1 := by
  intro W hW hWV
  rw [map_one, Ideal.span_singleton_one]
  exact ker_ideal_eq_top_of_disjoint ⟨W, hW⟩ (hV.mono_left hWV)

/-- **A local equation is invertible off `Z`.** -/
theorem IsLocalEquation.diff_range_subset_basicOpen {V : U.Opens} {t : Γ(U, V)}
    (ht : IsLocalEquation i V t) : (V : Set U) \ Set.range i.base ⊆ U.basicOpen t := by
  rintro x ⟨hxV, hxi⟩
  let O : U.Opens := V ⊓ ⟨(Set.range i.base)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩
  obtain ⟨_, ⟨W, hW, rfl⟩, hxW, hWO⟩ :=
    U.isBasis_affineOpens.exists_subset_of_mem_open (show x ∈ (O : Set U) from ⟨hxV, hxi⟩) O.2
  have hWV : W ≤ V := fun y hy => (hWO hy).1
  have hdisj : Disjoint (W : Set U) (Set.range i.base) :=
    Set.disjoint_left.2 fun y hy => (hWO hy).2
  have htop := (ht W hW hWV).symm.trans (ker_ideal_eq_top_of_disjoint ⟨W, hW⟩ hdisj)
  rw [Ideal.span_singleton_eq_top] at htop
  have hx : x ∈ U.basicOpen (U.presheaf.map (homOfLE hWV).op t) := by
    rwa [U.basicOpen_of_isUnit htop]
  rw [Scheme.basicOpen_res] at hx
  exact hx.2

omit [IsClosedImmersion i] in
/-- **Two local equations on the same open agree up to a unit near each point, or vanish
there.** If `t₁` and `t₂` are local equations of `Z` on `V` and `x ∈ V`, there is an open
`x ∈ O ⊆ V` on which either `t₁ = c t₂` for a unit `c`, or `t₁ = 0`. -/
theorem IsLocalEquation.exists_eq_unit_mul_or_eq_zero {V : U.Opens} {t₁ t₂ : Γ(U, V)}
    (h₁ : IsLocalEquation i V t₁) (h₂ : IsLocalEquation i V t₂) {x : U} (hx : x ∈ V) :
    ∃ (O : U.Opens) (hO : O ≤ V), x ∈ O ∧
      ((∃ c : Γ(U, O), IsUnit c ∧
          U.presheaf.map (homOfLE hO).op t₁ = c * U.presheaf.map (homOfLE hO).op t₂) ∨
        U.presheaf.map (homOfLE hO).op t₁ = 0) := by
  obtain ⟨_, ⟨W, hW, rfl⟩, hxW, hWV⟩ := U.isBasis_affineOpens.exists_subset_of_mem_open hx V.2
  have hWV' : W ≤ V := hWV
  set a := U.presheaf.map (homOfLE hWV').op t₁ with ha
  set b := U.presheaf.map (homOfLE hWV').op t₂ with hb
  have hab : Ideal.span {a} = Ideal.span {b} := (h₁ W hW hWV').symm.trans (h₂ W hW hWV')
  obtain ⟨c, hc⟩ : ∃ c, c * b = a :=
    Ideal.mem_span_singleton'.1 (hab ▸ Ideal.mem_span_singleton_self a)
  obtain ⟨d, hd⟩ : ∃ d, d * a = b :=
    Ideal.mem_span_singleton'.1 (hab ▸ Ideal.mem_span_singleton_self b)
  by_cases hxc : x ∈ U.basicOpen c
  · refine ⟨U.basicOpen c, (U.basicOpen_le c).trans hWV', hxc, Or.inl
      ⟨U.presheaf.map (homOfLE (U.basicOpen_le c)).op c,
        U.toRingedSpace.isUnit_res_basicOpen c, ?_⟩⟩
    rw [← presheaf_map_homOfLE_homOfLE (U.basicOpen_le c) hWV' t₁,
      ← presheaf_map_homOfLE_homOfLE (U.basicOpen_le c) hWV' t₂, ← ha, ← hb, ← hc, map_mul]
  · have hx' : x ∈ U.basicOpen (1 - c * d) := by
      rw [Scheme.mem_basicOpen _ _ _ hxW] at hxc ⊢
      rw [map_sub, map_one, map_mul]
      refine IsLocalRing.isUnit_one_sub_self_of_mem_nonunits _ ?_
      rw [← IsLocalRing.mem_maximalIdeal]
      exact Ideal.mul_mem_right _ _ ((IsLocalRing.mem_maximalIdeal _).2 hxc)
    refine ⟨U.basicOpen (1 - c * d), (U.basicOpen_le _).trans hWV', hx', Or.inr ?_⟩
    have h0 : (1 - c * d) * a = 0 := by
      rw [sub_mul, one_mul, mul_assoc, hd, hc, sub_self]
    rw [← presheaf_map_homOfLE_homOfLE (U.basicOpen_le _) hWV' t₁, ← ha]
    have h0' := congrArg (U.presheaf.map (homOfLE (U.basicOpen_le (1 - c * d))).op) h0
    rw [map_mul, map_zero] at h0'
    exact (U.toRingedSpace.isUnit_res_basicOpen (1 - c * d)).mul_right_eq_zero.1 h0'

end LocalEquation

section Chart

variable (k : Type u) [Field k]

/-- A function on `𝔸¹_k` vanishes at the origin exactly when its constant coefficient vanishes. -/
theorem origin_appTop_eq_zero_iff (a : Γ(affineLine k, ⊤)) :
    (origin k).appTop a = 0 ↔ MvPolynomial.constantCoeff (globalSectionsEquiv k a) = 0 := by
  have key : (Scheme.ΓSpecIso (.of k)).hom ((origin k).appTop a) =
      MvPolynomial.constantCoeff (globalSectionsEquiv k a) := by
    change ((Spec.map (CommRingCat.ofHom (MvPolynomial.constantCoeff :
        MvPolynomial (ULift.{u} (Fin 1)) k →+* k))).appTop ≫ (Scheme.ΓSpecIso (.of k)).hom)
        ((AffineSpace.SpecIso (ULift.{u} (Fin 1)) (.of k)).inv.appTop a) = _
    rw [Scheme.ΓSpecIso_naturality]
    rfl
  rw [← key]
  exact (map_eq_zero_iff _ (ConcreteCategory.bijective_of_isIso
    (Scheme.ΓSpecIso (.of k)).hom).1).symm

/-- The kernel of the constant coefficient of `k[t]` is generated by `t`. -/
theorem ker_constantCoeff_eq_span :
    RingHom.ker (MvPolynomial.constantCoeff : MvPolynomial (ULift.{u} (Fin 1)) k →+* k) =
      Ideal.span {MvPolynomial.X ⟨0⟩} :=
  le_antisymm ((ker_constantCoeff_le_iff k _).2 (Ideal.mem_span_singleton_self _))
    (Ideal.span_le.2 (by simp))

/-- **The ideal of the origin of `𝔸¹_k` is generated by the coordinate.** -/
theorem ker_origin_ideal_top :
    (origin k).ker.ideal ⟨⊤, isAffineOpen_top _⟩ = Ideal.span {coordinate k} := by
  have := isClosedImmersion_origin k
  rw [Scheme.Hom.ker_apply]
  ext a
  change (origin k).appTop a = 0 ↔ _
  rw [origin_appTop_eq_zero_iff, ← RingHom.mem_ker, ker_constantCoeff_eq_span,
    ← globalSectionsEquiv_coordinate, Ideal.mem_span_singleton', Ideal.mem_span_singleton']
  constructor
  · rintro ⟨p, hp⟩
    refine ⟨(globalSectionsEquiv k).symm p, (globalSectionsEquiv k).injective ?_⟩
    rw [map_mul, RingEquiv.apply_symm_apply, hp]
  · rintro ⟨c, rfl⟩
    exact ⟨globalSectionsEquiv k c, by rw [map_mul]⟩

/-- The kernel of the first projection of a pullback along a closed immersion `g` is the
pullback of the kernel of `g`. -/
private theorem ker_eq_comap_of_isPullback {P X Y S : Scheme.{u}} {fst : P ⟶ X} {snd : P ⟶ Y}
    {f : X ⟶ S} {g : Y ⟶ S} [IsClosedImmersion g] (h : IsPullback fst snd f g) :
    fst.ker = g.ker.comap f := by
  rw [← h.isoPullback_hom_fst, Scheme.Hom.ker_comp_of_isIso,
    Scheme.IdealSheafData.ker_fst_of_isClosedImmersion]

/-- **The pulled back coordinate is a local equation of the fibre over the origin.** If the
closed subscheme `Z ∩ V` of the open `V ⊆ U` is the fibre over the origin of `φ : V ⟶ 𝔸¹_k`,
then `φ^* t` is a local equation of `Z` on `V`. -/
theorem isLocalEquation_of_isPullback_origin {U Z : Scheme.{u}} (i : Z ⟶ U) [IsClosedImmersion i]
    (V : U.Opens) (φ : V.toScheme ⟶ affineLine k) (ψ : (i ⁻¹ᵁ V).toScheme ⟶ Spec (.of k))
    (h : IsPullback (i ∣_ V) ψ φ (origin k)) :
    IsLocalEquation i V (V.topIso.hom (φ.appTop (coordinate k))) := by
  have := isClosedImmersion_origin k
  have h₁ := ker_eq_comap_of_isPullback h
  have h₂ := ker_eq_comap_of_isPullback (isPullback_morphismRestrict i V)
  intro W hW hWV
  have hWr : W ≤ V.ι.opensRange := by rwa [Scheme.Opens.opensRange_ι]
  have hW' : IsAffineOpen (V.ι ⁻¹ᵁ W) := hW.preimage_of_isOpenImmersion V.ι hWr
  have e₁ := Stacks.IdealSheaf.ideal_comap_appLE i.ker V.ι ⟨W, hW⟩ ⟨_, hW'⟩ le_rfl
  have e₂ := Stacks.IdealSheaf.ideal_comap_appLE (origin k).ker φ ⟨⊤, isAffineOpen_top _⟩
    ⟨_, hW'⟩ le_top
  rw [← h₂, h₁, e₂, ker_origin_ideal_top, Ideal.map_span, Set.image_singleton] at e₁
  set ρ := V.ι.appLE W (V.ι ⁻¹ᵁ W) le_rfl with hρ
  have himg : V.ι ''ᵁ (V.ι ⁻¹ᵁ W) = W := by
    rw [Scheme.Hom.image_preimage_eq_opensRange_inf, Scheme.Opens.opensRange_ι,
      inf_eq_right.2 hWV]
  have hρb : Function.Bijective ρ.hom := by
    have : ρ = (U.presheaf.mapIso (eqToIso himg).op).hom := by
      rw [hρ, Scheme.Opens.ι_appLE]
      rfl
    rw [this]
    exact ConcreteCategory.bijective_of_isIso (U.presheaf.mapIso (eqToIso himg).op).hom
  set y := U.presheaf.map (homOfLE hWV).op (V.topIso.hom (φ.appTop (coordinate k)))
  have hmor : V.topIso.hom ≫ U.presheaf.map (homOfLE hWV).op ≫ ρ =
      V.toScheme.presheaf.map (homOfLE (le_top : V.ι ⁻¹ᵁ W ≤ ⊤)).op := by
    rw [hρ, Scheme.Opens.ι_appLE, Scheme.Opens.topIso_hom]
    exact presheaf_map_comp_comp _ _ _ _
  have hρy : ρ.hom y = (φ.appLE ⊤ (V.ι ⁻¹ᵁ W) le_top).hom (coordinate k) :=
    congrArg (fun f => f.hom (φ.appTop (coordinate k))) hmor
  change Ideal.span {(φ.appLE ⊤ (V.ι ⁻¹ᵁ W) le_top).hom (coordinate k)} =
    (i.ker.ideal ⟨W, hW⟩).map ρ.hom at e₁
  rw [← hρy, ← Set.image_singleton, ← Ideal.map_span] at e₁
  rw [← Ideal.comap_map_of_bijective _ hρb (I := i.ker.ideal ⟨W, hW⟩), ← e₁,
    Ideal.comap_map_of_bijective _ hρb]

/-- **Every point of a smooth relative curve has a local equation of an étale divisor around
it.** Let `W` be smooth over a field `k`, `g : U ⟶ W` smooth of relative dimension one and
`i : Z ⟶ U` a closed immersion with `Z ⟶ W` étale. Near a point of `Z` the pulled back
coordinate of an étale chart is a local equation; off `Z`, `1` is one. -/
theorem exists_isLocalEquation {U W Z : Scheme.{u}} (pW : W ⟶ Spec (.of k)) [Smooth pW]
    (g : U ⟶ W) [SmoothOfRelativeDimension 1 g] (i : Z ⟶ U) [IsClosedImmersion i]
    [Etale (i ≫ g)] (x : U) : ∃ (V : U.Opens) (t : Γ(U, V)), x ∈ V ∧ IsLocalEquation i V t := by
  by_cases hx : x ∈ Set.range i.base
  · obtain ⟨z, rfl⟩ := hx
    obtain ⟨V, hzV, π, ψ, -, -, -, hpb⟩ := exists_smooth_affineLine_chart k pW g i z
    exact ⟨V, _, hzV, isLocalEquation_of_isPullback_origin k i V _ ψ hpb⟩
  · exact ⟨⟨(Set.range i.base)ᶜ, i.isClosedEmbedding.isClosed_range.isOpen_compl⟩, 1, hx,
      isLocalEquation_one_of_disjoint disjoint_compl_left⟩

end Chart

end Stacks.EtaleCohomology.Purity

