module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Duality.PointClassNonzeroFibrationStepProof
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Duality.PointClassNonzeroDimZeroProof
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Duality.ElementaryFibrationNeighbourhoodExists
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Duality.TopCohomologyElementaryFibration

/-!
# Top cohomology with compact support is generated by the class of a point

Let `k` be algebraically closed, `ℓ` a prime invertible in `k` and `Λ = ℤ/ℓ`. For `W` smooth
irreducible of relative dimension `e` over `k`, noetherian, with a compactification, the top
cohomology with compact support `H^{2e}_c(W, Λ)` is isomorphic to `Λ`, and for every `k`-point of
`W` and every purity class of it, the point-class map `Λ → H^{2e}_c(W)` is bijective
(`Stacks.EtaleCohomology.topCohomologyPointClass`).

This assembles the count (through elementary fibration neighbourhoods, SGA 4, Exposé XI,
Proposition 3.3, `Stacks.EtaleCohomology.existsElementaryFibrationNeighbourhood`, and
`R²f_! Λ ≅ Λ`, `Stacks.EtaleCohomology.higherDirectImageTwoOfElementaryFibration`) and the
nonvanishing of the class of a point (relative dimension zero,
`Stacks.EtaleCohomology.pointClassNonzeroDimZero`, and the step through an elementary fibration,
`Stacks.EtaleCohomology.pointClassNonzeroFibrationStep`). It is the input on the class of a
point for the trace in the proof of [Tag 03VH](https://stacks.math.columbia.edu/tag/03VH).

## Main results

* `Stacks.EtaleCohomology.topCohomologyPointClass`.
-/

@[expose] public noncomputable section

universe u

namespace Stacks.EtaleCohomology

/-- **`H^{2e}_c(W, ℤ/ℓ) ≅ ℤ/ℓ`, generated by the class of any point**
(`Stacks.EtaleCohomology.TopCohomologyPointClass`), over an algebraically closed field `k` in
which `ℓ` is invertible. -/
theorem topCohomologyPointClass (ℓ : ℕ) [Fact ℓ.Prime] (k : Type u) [Field k] [IsAlgClosed k]
    (hℓ : IsUnit (ℓ : k)) : TopCohomologyPointClass ℓ k :=
  have : NeZero ℓ := ⟨(Fact.out : ℓ.Prime).ne_zero⟩
  topCohomologyPointClass_of_fibrationStep ℓ hℓ (existsElementaryFibrationNeighbourhood k)
    (higherDirectImageTwoOfElementaryFibration k ℓ) (pointClassNonzeroDimZero ℓ k)
    (pointClassNonzeroFibrationStep ℓ k hℓ)

end Stacks.EtaleCohomology

end
