module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Duality.ElementaryFibrationNeighbourhood
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Duality.PointClassNonzero

/-!
# Nonvanishing of every point class through elementary fibration neighbourhoods

Let `k` be a field, `ℓ` a prime and `Λ = ℤ/ℓ`. The class of a `k`-point `P` of a smooth
irreducible `W` of relative dimension `e` over `k` in `H^{2e}_c(W)` is nonzero
(`Stacks.EtaleCohomology.PointClassNonzeroAt`) at every point of every such `W` once two
statements hold:

* in relative dimension zero (`Stacks.EtaleCohomology.PointClassNonzeroDimZero`);
* the step through an elementary fibration
  (`Stacks.EtaleCohomology.PointClassNonzeroFibrationStep`): if `U ⊆ W` is an elementary
  fibration `U → S` over `S` affine, irreducible and smooth of relative dimension `e`, and every
  point class of `S` is nonzero, then every point class of `W` at a point of `U` is nonzero.

Every closed point of `W` has an elementary fibration neighbourhood
(`Stacks.EtaleCohomology.ExistsElementaryFibrationNeighbourhood`, SGA 4, Exposé XI,
Proposition 3.3), so induction on `e` reaches every point. No moving lemma
(`Stacks.EtaleCohomology.PointClassNonzeroMoving`) is needed. The point `P`, irreducible and étale
over `k`, has exactly one point, and its image in `W` is a closed point: it is closed in the open
`N` of the Jacobson space `W`.

## Main definitions

* `Stacks.EtaleCohomology.PointClassNonzeroDimZero`.
* `Stacks.EtaleCohomology.PointClassNonzeroFibrationStep`.

## Main results

* `Stacks.EtaleCohomology.pointClassNonzeroAt_of_fibrationStep`: every point class is nonzero.
* `Stacks.EtaleCohomology.topCohomologyPointClassNonzero_of_fibrationStep`.
* `Stacks.EtaleCohomology.topCohomologyPointClass_of_fibrationStep`: with the count, `H^{2e}_c(W)`
  is freely generated by the class of any point.
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits CategoryTheory.Abelian AlgebraicGeometry

universe u

namespace Stacks.EtaleCohomology

attribute [local instance] HasDerivedCategory.standard

variable (ℓ : ℕ) [Fact ℓ.Prime] (k : Type u) [Field k]

/-- **The class of a point is nonzero in relative dimension zero**: for every smooth irreducible
`W` of relative dimension `0` over `k`, noetherian, with a compactification, and every `k`-point
`i : P → N` closed in an open `N ⊆ W`, `Stacks.EtaleCohomology.PointClassNonzeroAt` holds in
degree `0`. -/
def PointClassNonzeroDimZero : Prop :=
  ∀ (W : Scheme.{u}) (f : W ⟶ Spec (.of k)) [SmoothOfRelativeDimension 0 f]
    [TopologicalSpace.NoetherianSpace W] [IrreducibleSpace W]
    (jc : CompactificationOf (Over.mk f))
    (N P : Scheme.{u}) (n : N ⟶ W) [IsOpenImmersion n] (i : P ⟶ N) [IsClosedImmersion i]
    [IrreducibleSpace P] [SmoothOfRelativeDimension 0 (i ≫ n ≫ f)],
    PointClassNonzeroAt ℓ 0 f jc n i

/-- **The step of the point class through an elementary fibration**: let `W` be smooth irreducible
of relative dimension `e + 1` over `k`, noetherian, with a compactification, and let `g : U → S`
be an elementary fibration on an open `U ⊆ W` over `S` affine, irreducible and smooth of relative
dimension `e`, compatibly with the structure morphisms. If the class of every `k`-point of `S` is
nonzero in `H^{2e}_c(S)`, for every compactification of `S`, then the class of every `k`-point
`i : P → N` of `W` lying in `U` is nonzero in `H^{2e+2}_c(W)`. -/
def PointClassNonzeroFibrationStep : Prop :=
  ∀ (e : ℕ) (W : Scheme.{u}) (f : W ⟶ Spec (.of k)) [SmoothOfRelativeDimension (e + 1) f]
    [TopologicalSpace.NoetherianSpace W] [IrreducibleSpace W]
    (jc : CompactificationOf (Over.mk f))
    (U : W.Opens) (S : Scheme.{u}) (q : S ⟶ Spec (.of k)) (g : U.toScheme ⟶ S)
    [SmoothOfRelativeDimension e q] [IsAffine S] [IrreducibleSpace S],
    IsElementaryFibration g → g ≫ q = U.ι ≫ f →
    (∀ (jS : CompactificationOf (Over.mk q)) (N' P' : Scheme.{u}) (n' : N' ⟶ S)
      [IsOpenImmersion n'] (i' : P' ⟶ N') [IsClosedImmersion i'] [IrreducibleSpace P']
      [SmoothOfRelativeDimension 0 (i' ≫ n' ≫ q)], PointClassNonzeroAt ℓ e q jS n' i') →
    ∀ (N P : Scheme.{u}) (n : N ⟶ W) [IsOpenImmersion n] (i : P ⟶ N) [IsClosedImmersion i]
      [IrreducibleSpace P] [SmoothOfRelativeDimension 0 (i ≫ n ≫ f)],
      Set.range (i ≫ n).base ⊆ U → PointClassNonzeroAt ℓ (e + 1) f jc n i

variable {k}

/-- **A point étale over a field is a single point**: an irreducible scheme smooth of relative
dimension zero over `k` has at most one point, its fibre over the point of `Spec k` being
discrete. -/
theorem subsingleton_of_smoothOfRelativeDimension_zero {P : Scheme.{u}}
    (g : P ⟶ Spec (.of k)) [SmoothOfRelativeDimension 0 g] [IrreducibleSpace P] :
    Subsingleton P := by
  have : Etale g := (Etale.iff_smoothOfRelativeDimension_zero g).mpr inferInstance
  let y : Spec (.of k) := IsLocalRing.closedPoint k
  have hd := g.isDiscrete_preimage_singleton y
  have hu : g.base ⁻¹' {y} = Set.univ :=
    Set.eq_univ_of_forall fun x => @Subsingleton.elim (PrimeSpectrum k) _ (g.base x) y
  rw [hu] at hd
  exact Set.subsingleton_univ_iff.mp
    (hd.subsingleton_of_isPreirreducible (IrreducibleSpace.isIrreducible_univ P).isPreirreducible)

/-- **Every point class is nonzero**, by induction on the relative dimension through elementary
fibration neighbourhoods: dimension zero is `Stacks.EtaleCohomology.PointClassNonzeroDimZero`, and
in relative dimension `e + 1` the image of the point is a closed point of `W`, whose elementary
fibration neighbourhood `U → S` (`Stacks.EtaleCohomology.ExistsElementaryFibrationNeighbourhood`)
has `S` noetherian of relative dimension `e`, where the induction hypothesis holds;
`Stacks.EtaleCohomology.PointClassNonzeroFibrationStep` concludes. -/
theorem pointClassNonzeroAt_of_fibrationStep (hnbhd : ExistsElementaryFibrationNeighbourhood k)
    (h0 : PointClassNonzeroDimZero ℓ k) (hstep : PointClassNonzeroFibrationStep ℓ k) :
    ∀ (e : ℕ) (W : Scheme.{u}) (f : W ⟶ Spec (.of k)) [SmoothOfRelativeDimension e f]
      [TopologicalSpace.NoetherianSpace W] [IrreducibleSpace W]
      (jc : CompactificationOf (Over.mk f))
      (N P : Scheme.{u}) (n : N ⟶ W) [IsOpenImmersion n] (i : P ⟶ N) [IsClosedImmersion i]
      [IrreducibleSpace P] [SmoothOfRelativeDimension 0 (i ≫ n ≫ f)],
      PointClassNonzeroAt ℓ e f jc n i := by
  intro e
  induction e with
  | zero =>
    intro W f _ _ _ jc N P n _ i _ _ _
    exact h0 W f jc N P n i
  | succ e ih =>
    intro W f _ _ _ jc N P n _ i _ _ _
    have := subsingleton_of_smoothOfRelativeDimension_zero (i ≫ n ≫ f)
    obtain ⟨p⟩ := IrreducibleSpace.toNonempty (X := P)
    have : Smooth f := SmoothOfRelativeDimension.smooth (e + 1) f
    have : JacobsonSpace W := LocallyOfFiniteType.jacobsonSpace f
    have hpN : i.base p ∈ closedPoints N := by
      rw [mem_closedPoints_iff, ← Set.image_singleton]
      refine i.isClosedEmbedding.isClosedMap _ ?_
      rw [show ({p} : Set P) = Set.univ from Set.eq_univ_of_forall fun x => Subsingleton.elim x p]
      exact isClosed_univ
    rw [← n.isOpenEmbedding.preimage_closedPoints] at hpN
    obtain ⟨U, S, q, g, hxU, hg, hq, hS, hSi, hgq⟩ :=
      hnbhd W f (e + 1) (by omega) ((i ≫ n).base p) hpN
    rw [show e + 1 - 1 = e by omega] at hq
    have : Smooth q := SmoothOfRelativeDimension.smooth e q
    have : IsLocallyNoetherian S := LocallyOfFiniteType.isLocallyNoetherian q
    have : IsNoetherian S := {}
    refine hstep e W f jc U S q g hg hgq
      (fun jS N' P' n' _ i' _ _ _ => ih S q jS N' P' n' i') N P n i ?_
    rintro _ ⟨p', rfl⟩
    rwa [Subsingleton.elim p' p]

/-- **Point classes are nonzero for every purity class**
(`Stacks.EtaleCohomology.TopCohomologyPointClassNonzero`), through elementary fibration
neighbourhoods (`Stacks.EtaleCohomology.pointClassNonzeroAt_of_fibrationStep`). -/
theorem topCohomologyPointClassNonzero_of_fibrationStep
    (hnbhd : ExistsElementaryFibrationNeighbourhood k) (h0 : PointClassNonzeroDimZero ℓ k)
    (hstep : PointClassNonzeroFibrationStep ℓ k) : TopCohomologyPointClassNonzero ℓ k :=
  topCohomologyPointClassNonzero_of_pointClassNonzeroAt ℓ
    (pointClassNonzeroAt_of_fibrationStep ℓ hnbhd h0 hstep)

/-- **`H^{2e}_c(W) ≅ Λ`, freely generated by the class of a point**
(`Stacks.EtaleCohomology.TopCohomologyPointClass`), from elementary fibration neighbourhoods,
`R²f_! Λ ≅ Λ` for elementary fibrations, and the two statements on point classes: the count
(`Stacks.EtaleCohomology.topCohomologyPointClass_of_nonzero`) takes the dense elementary
fibrations the neighbourhoods provide. -/
theorem topCohomologyPointClass_of_fibrationStep [IsAlgClosed k] (hℓ : IsUnit (ℓ : k))
    (hnbhd : ExistsElementaryFibrationNeighbourhood k)
    (hR2 : HigherDirectImageTwoOfElementaryFibration k ℓ) (h0 : PointClassNonzeroDimZero ℓ k)
    (hstep : PointClassNonzeroFibrationStep ℓ k) : TopCohomologyPointClass ℓ k :=
  topCohomologyPointClass_of_nonzero ℓ hℓ (existsDenseElementaryFibration_of_neighbourhood hnbhd)
    hR2 (topCohomologyPointClassNonzero_of_fibrationStep ℓ hnbhd h0 hstep)

end Stacks.EtaleCohomology

end
