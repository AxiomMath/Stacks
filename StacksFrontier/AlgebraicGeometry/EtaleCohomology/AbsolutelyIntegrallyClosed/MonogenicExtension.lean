module

public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.RingTheory.Coprime.Basic
public import Mathlib.RingTheory.IsAdjoinRoot
public import StacksCore.Tactic.StacksAttribute

/-!
# A monogenic extension making a prescribed element invertible

If two elements of a ring generate the unit ideal and the first is a root of unity modulo the
second, one can adjoin a single integral element so that the first minus the second times the new
element becomes a unit.

## Main results

* `exists_monic_adjoinRoot_isUnit_sub_mul_root` constructs the monogenic extension as the
  quotient by a monic polynomial.

## Implementation notes

The monogenic extension is represented by `AdjoinRoot P` for a monic polynomial `P`, with
injectivity of the canonical map stated explicitly. The adjoined element is
`AdjoinRoot.root P`. The root-of-unity hypothesis is `IsOfFinOrder` in the quotient by the
principal ideal generated by `b`. Nothing geometric enters, so the result is stated in the root
namespace rather than in `AlgebraicGeometry`.

## References

* [Stacks Project, Tag 0GY2](https://stacks.math.columbia.edu/tag/0GY2)
-/

@[expose] public section

open Polynomial

private lemma exists_coefficients_for_root_of_unity
    {A : Type*} [CommRing A] (a b : A) (hab : IsCoprime a b)
    (n : ℕ) (hn : 0 < n) (hmem : 1 - a ^ n ∈ Ideal.span ({b} : Set A)) :
    ∃ c : ℕ → A,
      1 = a ^ n + ∑ i ∈ Finset.range n, c i * a ^ (n - (i + 1)) * b ^ (i + 1) := by
  classical
  obtain ⟨d₀, hd₀⟩ := (Ideal.mem_span_singleton.mp hmem)
  have hstart : 1 = a ^ n + b * d₀ := by
    linear_combination hd₀
  have haux : ∀ k ≤ n, ∃ c : ℕ → A, ∃ d : A,
      1 = a ^ n + (∑ i ∈ Finset.range k,
        c i * a ^ (n - (i + 1)) * b ^ (i + 1)) + b ^ (k + 1) * d ∧
      (k = n → d = 0) := by
    intro k
    induction k with
    | zero => exact fun _ => ⟨fun _ => 0, d₀, by simpa using hstart, fun h => absurd h hn.ne⟩
    | succ k ih =>
        intro hkn
        obtain ⟨c, d, hd, hterminal⟩ := ih (by omega)
        have hsum (v : A) : ∑ i ∈ Finset.range k,
            Function.update c k v i * a ^ (n - (i + 1)) * b ^ (i + 1) =
            ∑ i ∈ Finset.range k, c i * a ^ (n - (i + 1)) * b ^ (i + 1) :=
          Finset.sum_congr rfl fun i hi => by
            rw [Function.update_of_ne (Finset.mem_range.mp hi).ne]
        by_cases hlast : k + 1 = n
        · refine ⟨Function.update c k d, 0, ?_, fun _ => rfl⟩
          rw [Finset.sum_range_succ, hsum]
          have hexp : n - (k + 1) = 0 := by omega
          simp only [Function.update_self, hexp, pow_zero, mul_one, mul_zero, add_zero]
          linear_combination hd
        · obtain ⟨x, y, hxy⟩ := hab.pow_left (m := n - (k + 1))
          refine ⟨Function.update c k (d * x), d * y, ?_, fun h => absurd h hlast⟩
          rw [Finset.sum_range_succ, hsum]
          simp only [Function.update_self]
          linear_combination hd - b ^ (k + 1) * d * hxy
  obtain ⟨c, d, hfinal, hfinalzero⟩ := haux n le_rfl
  exact ⟨c, by simpa [hfinalzero rfl] using hfinal⟩

/-- A monogenic extension in which `a - b y` is a unit, when `a` and `b`
are coprime and `a` is a root of unity modulo `b`. -/
@[stacks 0GY2]
public theorem exists_monic_adjoinRoot_isUnit_sub_mul_root
    {A : Type*} [CommRing A] (a b : A)
    (hab : IsCoprime a b)
    (ha : IsOfFinOrder (Ideal.Quotient.mk (Ideal.span {b}) a)) :
    ∃ P : A[X], P.Monic ∧ Function.Injective (algebraMap A (AdjoinRoot P)) ∧
      IsUnit (algebraMap A (AdjoinRoot P) a -
        algebraMap A (AdjoinRoot P) b * AdjoinRoot.root P) := by
  classical
  let q := Ideal.Quotient.mk (Ideal.span ({b} : Set A)) a
  let n := orderOf q
  have hn : 0 < n := ha.orderOf_pos
  have hmem : 1 - a ^ n ∈ Ideal.span ({b} : Set A) := Ideal.Quotient.eq_zero_iff_mem.mp <| by
    rw [map_sub, map_one, map_pow]
    exact sub_eq_zero_of_eq (pow_orderOf_eq_one q).symm
  obtain ⟨c, hcoeff⟩ := exists_coefficients_for_root_of_unity a b hab n hn hmem
  let low : A[X] := ∑ i ∈ Finset.range n,
    C (c i) * X ^ (n - (i + 1))
  let P : A[X] := X ^ n + low
  have hlowdeg : degree low < n := by
    dsimp [low]
    refine (degree_sum_le _ _).trans_lt ((Finset.sup_lt_iff
      (WithBot.bot_lt_coe n)).2 ?_)
    intro i hi
    have hin : i < n := Finset.mem_range.mp hi
    have hiexp : n - (i + 1) < n := by omega
    exact (degree_C_mul_X_pow_le _ _).trans_lt (WithBot.coe_lt_coe.mpr hiexp)
  have hP : P.Monic := by
    dsimp [P]
    exact monic_X_pow_add hlowdeg
  have hdegP (hA : Nontrivial A) : degree P = n := by
    let := hA
    dsimp [P]
    rw [degree_add_eq_left_of_degree_lt (by simpa [degree_X_pow] using hlowdeg), degree_X_pow]
  have hinj : Function.Injective (algebraMap A (AdjoinRoot P)) := by
    show Function.Injective (AdjoinRoot.of P)
    by_cases hA : Nontrivial A
    · let := hA
      apply AdjoinRoot.of.injective_of_monic_of_degree_pos hP
      rw [hdegP hA]
      exact_mod_cast hn
    · let : Subsingleton A := (not_nontrivial_iff_subsingleton.mp hA)
      exact fun _ _ _ => Subsingleton.elim _ _
  refine ⟨P, hP, hinj, ?_⟩
  let R := AdjoinRoot P
  let ar : R := algebraMap A R a
  let br : R := algebraMap A R b
  let y : R := AdjoinRoot.root P
  let z : R := br * y
  let F : R → R := fun x => x ^ n + ∑ i ∈ Finset.range n,
    algebraMap A R (c i) * x ^ (n - (i + 1)) * br ^ (i + 1)
  have hFa : F ar = 1 := by
    dsimp [F, ar, br]
    have h := congrArg (algebraMap A (AdjoinRoot P)) hcoeff
    simpa only [map_one, map_pow, map_add, map_sum, map_mul] using h.symm
  have hroot : y ^ n + ∑ i ∈ Finset.range n,
      algebraMap A R (c i) * y ^ (n - (i + 1)) = 0 := by
    have hh := AdjoinRoot.isRoot_root P
    change (P.map (AdjoinRoot.of P)).eval (AdjoinRoot.root P) = 0 at hh
    rw [eval_map] at hh
    dsimp [P, low] at hh
    simpa [eval₂_finsetSum, eval₂_mul, eval₂_pow, AdjoinRoot.algebraMap_eq,
      R, y] using hh
  have hscale : br ^ n * (y ^ n + ∑ i ∈ Finset.range n,
      algebraMap A R (c i) * y ^ (n - (i + 1))) =
      z ^ n + ∑ i ∈ Finset.range n,
        algebraMap A R (c i) * z ^ (n - (i + 1)) * br ^ (i + 1) := by
    rw [mul_add, Finset.mul_sum]
    congr 1
    · simp [z, mul_pow]
    · apply Finset.sum_congr rfl
      intro i hi
      have hin : i < n := Finset.mem_range.mp hi
      have hie : n - (i + 1) + (i + 1) = n := by omega
      dsimp [z]
      rw [mul_pow]
      have hbr : br ^ (n - (i + 1)) * br ^ (i + 1) = br ^ n := by
        rw [← pow_add, hie]
      calc
        br ^ n * (algebraMap A R (c i) * y ^ (n - (i + 1))) =
            algebraMap A R (c i) * y ^ (n - (i + 1)) * br ^ n := by ring
        _ = algebraMap A R (c i) * y ^ (n - (i + 1)) *
              (br ^ (n - (i + 1)) * br ^ (i + 1)) := by rw [hbr]
        _ = algebraMap A R (c i) * (br ^ (n - (i + 1)) *
              y ^ (n - (i + 1))) * br ^ (i + 1) := by ring
  have hFz : F z = 0 := by
    dsimp [F]
    rw [← hscale, hroot]
    simp
  let u : R := ar - z
  have hpowdiv (m : ℕ) : u ∣ ar ^ m - z ^ m := sub_dvd_pow_sub_pow ar z m
  have htermdiv (i : ℕ) : u ∣
      algebraMap A R (c i) * ar ^ (n - (i + 1)) * br ^ (i + 1) -
        algebraMap A R (c i) * z ^ (n - (i + 1)) * br ^ (i + 1) := by
    convert dvd_mul_of_dvd_right (hpowdiv (n - (i + 1)))
      (algebraMap A R (c i) * br ^ (i + 1)) using 1 ; ring
  have hsumdiv : u ∣ (∑ i ∈ Finset.range n,
      algebraMap A R (c i) * ar ^ (n - (i + 1)) * br ^ (i + 1)) -
        ∑ i ∈ Finset.range n,
      algebraMap A R (c i) * z ^ (n - (i + 1)) * br ^ (i + 1) := by
    rw [← Finset.sum_sub_distrib]
    exact Finset.dvd_sum (fun i hi => htermdiv i)
  have hdiv : u ∣ F ar - F z := by
    dsimp [F]
    convert dvd_add (hpowdiv n) hsumdiv using 1 ; ring
  have hdivone : u ∣ (1 : R) := by
    simpa [hFa, hFz] using hdiv
  have hu : IsUnit u := isUnit_iff_dvd_one.mpr hdivone
  simpa [u, ar, br, z, R] using hu
