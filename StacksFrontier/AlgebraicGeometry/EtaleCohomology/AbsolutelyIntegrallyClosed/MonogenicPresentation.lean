module

public import Mathlib.RingTheory.IsAdjoinRoot
public import Mathlib.RingTheory.Localization.Away.Basic
public import StacksCore.Tactic.StacksAttribute

/-!
# A monogenic presentation between two localized polynomial rings

Suppose that a monic polynomial `Φ` of positive degree satisfies `(πX + 1)^ℓ = π^ℓ Φ + 1`. The
map which substitutes `Φ` for the variable presents the localization at `πX + 1` as an algebra
obtained by adjoining one root to the localization at `π^ℓX + 1`.

## Main definitions

* `localizationMap` is the canonical substitution map. The two rings are represented by
  Mathlib's `Localization.Away` construction.

## Main results

* `localizationMap_X` identifies the value of the substitution map on the source variable.
* `localization_isAdjoinRootMonic_of_power_eq` gives the monic presentation of the target
  localization over the source.

## Implementation notes

The notation `A[x, 1/f]` in the source is represented by `Localization.Away f`. Rather than
choosing an isomorphism with a particular polynomial quotient, the displayed equality in the
source is expressed by `IsAdjoinRootMonic`; this records surjectivity of evaluation, that its
kernel is generated by `Φ(X) - t`, and monicity. The source constructs a monic polynomial of
degree `ℓ`, where `ℓ` is prime, so its degree is positive. This positivity is explicit in the
monic presentation: over an arbitrary base ring the polynomial identity and monicity alone also
allow `π = 0`, `ℓ = 1`, and `Φ = 1`. The canonical substitution map and its value on the
generator require only the polynomial identity.

## References

* [Stacks Project, Tag 0GY3](https://stacks.math.columbia.edu/tag/0GY3)
-/

@[expose] public section

open Polynomial

/-- The `A`-algebra map from the localization of `A[X]` at `π^ℓX + 1` to the localization of
`A[X]` at `πX + 1` which sends `X` to `Φ(X)`. -/
noncomputable def localizationMap
    (A : Type*) [CommRing A] (π : A) (ℓ : ℕ) (Φ : A[X])
    (hΦ : (C π * X + 1) ^ ℓ = C (π ^ ℓ) * Φ + 1) :
    Localization.Away (C (π ^ ℓ) * X + 1) →ₐ[A]
      Localization.Away (C π * X + 1) := by
  let B := Localization.Away (C π * X + 1)
  let s : B := algebraMap A[X] B X
  let t : B := aeval s Φ
  let g : A[X] →ₐ[A] B := aeval t
  have hg : IsUnit (g (C (π ^ ℓ) * X + 1)) := by
    have haeval (p : A[X]) : aeval s p = algebraMap A[X] B p := by
      simpa [s] using
        (Polynomial.aeval_algHom_apply (IsScalarTower.toAlgHom A A[X] B) X p)
    have he : g (C (π ^ ℓ) * X + 1) =
        (algebraMap A[X] B (C π * X + 1)) ^ ℓ := by
      calc
        _ = aeval s (C (π ^ ℓ) * Φ + 1) := by
          simp [g, t, map_add, map_mul]
        _ = aeval s ((C π * X + 1) ^ ℓ) := congrArg (aeval s) hΦ.symm
        _ = _ := by rw [map_pow, haeval]
    rw [he]
    exact (IsLocalization.Away.algebraMap_isUnit (C π * X + 1)).pow ℓ
  exact IsLocalization.Away.liftAlgHom (C (π ^ ℓ) * X + 1) hg (f := g)

/-- The canonical map sends `t` to `Φ(s)`. -/
@[stacks 0GY3 "the canonical substitution map on the generator"]
theorem localizationMap_X
    (A : Type*) [CommRing A] (π : A) (ℓ : ℕ) (Φ : A[X])
    (hΦ : (C π * X + 1) ^ ℓ = C (π ^ ℓ) * Φ + 1) :
    localizationMap A π ℓ Φ hΦ
      (algebraMap A[X] (Localization.Away (C (π ^ ℓ) * X + 1)) X) =
      aeval (algebraMap A[X] (Localization.Away (C π * X + 1)) X) Φ := by
  simp [localizationMap, IsLocalization.Away.liftAlgHom, IsLocalization.Away.lift]

/-- The structure map from `A[X]` to an `A[X]`-algebra `B` sends `C a` to the image of `a`. -/
private theorem algebraMap_C_eq {A B : Type*} [CommRing A] [CommRing B] [Algebra A B]
    [Algebra A[X] B] [IsScalarTower A A[X] B] (a : A) :
    algebraMap A[X] B (C a) = algebraMap A B a :=
  (IsScalarTower.algebraMap_apply A A[X] B a).symm

/-- For `Φ` monic of positive degree, the target localization is obtained from
the source localization by adjoining the target variable as a root of the
monic equation `Φ(s) - t`. -/
@[stacks 0GY3 "the monic presentation"]
theorem localization_isAdjoinRootMonic_of_power_eq
    (A : Type*) [CommRing A] (π : A) (ℓ : ℕ) (Φ : A[X])
    (hΦ : (C π * X + 1) ^ ℓ = C (π ^ ℓ) * Φ + 1)
    (hMonic : Φ.Monic) (hDegree : 0 < Φ.natDegree) :
    ∃ h : @IsAdjoinRootMonic (Localization.Away (C (π ^ ℓ) * X + 1))
        (Localization.Away (C π * X + 1)) _ _
        (localizationMap A π ℓ Φ hΦ).toRingHom.toAlgebra
        (Φ.map (algebraMap A (Localization.Away (C (π ^ ℓ) * X + 1))) -
          C (algebraMap A[X] (Localization.Away (C (π ^ ℓ) * X + 1)) X)),
      @IsAdjoinRoot.map (Localization.Away (C (π ^ ℓ) * X + 1))
        (Localization.Away (C π * X + 1)) _ _
        (localizationMap A π ℓ Φ hΦ).toRingHom.toAlgebra _
        (@IsAdjoinRootMonic.toIsAdjoinRoot
          (Localization.Away (C (π ^ ℓ) * X + 1))
          (Localization.Away (C π * X + 1)) _ _
          (localizationMap A π ℓ Φ hΦ).toRingHom.toAlgebra _ h) X =
        algebraMap A[X] (Localization.Away (C π * X + 1)) X := by
  classical
  let R := Localization.Away (C (π ^ ℓ) * X + 1)
  let S := Localization.Away (C π * X + 1)
  let ψ : R →ₐ[A] S := localizationMap A π ℓ Φ hΦ
  let : Algebra R S := ψ.toRingHom.toAlgebra
  let t : R := algebraMap A[X] R X
  let s : S := algebraMap A[X] S X
  let P : R[X] := Φ.map (algebraMap A R) - C t
  have hPmonic : P.Monic := by
    by_cases hR : Subsingleton R
    · let : Subsingleton R := hR
      change leadingCoeff P = 1
      exact Subsingleton.elim _ _
    · let : Nontrivial R := not_subsingleton_iff_nontrivial.mp hR
      dsimp [P]
      rw [Monic, leadingCoeff_sub_of_degree_lt]
      · exact hMonic.map (algebraMap A R)
      · rw [degree_eq_natDegree (hMonic.map (algebraMap A R)).ne_zero]
        exact (degree_C_le).trans_lt
          (WithBot.coe_lt_coe.mpr (by simpa [hMonic.natDegree_map] using hDegree))
  let Q := AdjoinRoot P
  let q : Q := AdjoinRoot.root P
  have hrel : aeval q P = 0 := by
    change eval₂ (algebraMap R Q) q P = 0
    exact AdjoinRoot.eval₂_root P
  have hPhiq : aeval q (Φ.map (algebraMap A R)) = algebraMap R Q t := by
    change aeval q (Φ.map (algebraMap A R) - C t) = 0 at hrel
    rw [aeval_sub, aeval_C] at hrel
    exact sub_eq_zero.mp hrel
  have hℓ : ℓ ≠ 0 := by
    rintro rfl
    have hΦ0 : Φ = 0 := by
      apply add_right_cancel (b := (1 : A[X]))
      simpa using hΦ.symm
    simp [hΦ0] at hDegree
  let fA : A[X] →ₐ[A] Q := aeval q
  have hfAΦ : fA Φ = algebraMap R Q t := by
    simpa only [fA, aeval_map_algebraMap] using hPhiq
  have hdenpow : (fA (C π * X + 1)) ^ ℓ =
      algebraMap R Q (algebraMap A[X] R (C (π ^ ℓ) * X + 1)) := by
    calc
      _ = fA ((C π * X + 1) ^ ℓ) := by simp
      _ = fA (C (π ^ ℓ) * Φ + 1) := congrArg fA hΦ
      _ = algebraMap R Q t * algebraMap A Q (π ^ ℓ) + 1 := by
        simp [fA, hfAΦ, map_add, map_mul]
        ring
      _ = _ := by
        have hsource : algebraMap A[X] R (C (π ^ ℓ) * X + 1) =
          algebraMap A R (π ^ ℓ) * t + 1 := by
          simp only [map_add, map_mul, map_one, algebraMap_C_eq, t]
        rw [hsource]
        simp only [map_add, map_mul, map_one, map_pow,
          IsScalarTower.algebraMap_apply A R Q]
        ring
  have hden : IsUnit (fA (C π * X + 1)) := by
    apply (isUnit_pow_iff hℓ).mp
    rw [hdenpow]
    exact IsUnit.map (algebraMap R Q)
      (IsLocalization.Away.algebraMap_isUnit (C (π ^ ℓ) * X + 1))
  let fSQ : S →ₐ[A] Q :=
    IsLocalization.Away.liftAlgHom (C π * X + 1) hden (f := fA)
  have hfSQs : fSQ s = q := by simp [fSQ, s, fA]
  have hψ : ψ t = aeval s Φ := by
    simpa [ψ, t, s] using localizationMap_X A π ℓ Φ hΦ
  have hroot : aeval s P = 0 := by
    change aeval s (Φ.map (algebraMap A R) - C t) = 0
    rw [aeval_sub, aeval_C, aeval_map_algebraMap R s Φ]
    change aeval s Φ - ψ t = 0
    rw [hψ, sub_self]
  let qToS : Q →ₐ[R] S := AdjoinRoot.liftAlgHom P (Algebra.ofId R S) s hroot
  have hcompat : fSQ.toRingHom.comp ψ.toRingHom = (algebraMap R Q) := by
    apply IsLocalization.ringHom_ext (Submonoid.powers (C (π ^ ℓ) * X + 1))
    apply Polynomial.ringHom_ext
    · intro a
      change fSQ (ψ (algebraMap A[X] R (C a))) =
        algebraMap R Q (algebraMap A[X] R (C a))
      rw [algebraMap_C_eq, ψ.commutes, fSQ.commutes]
      exact IsScalarTower.algebraMap_apply A R Q a
    · change fSQ (ψ t) = algebraMap R Q t
      calc
        fSQ (ψ t) = fSQ (aeval s Φ) := by rw [hψ]
        _ = aeval (fSQ s) Φ := (Polynomial.aeval_algHom_apply fSQ s Φ).symm
        _ = algebraMap R Q t := by rw [hfSQs, hfAΦ]
  let fSR : S →ₐ[R] Q := {
    toRingHom := fSQ.toRingHom
    commutes' r := by
      change fSQ (ψ r) = algebraMap R Q r
      simpa [RingHom.comp_apply] using RingHom.congr_fun hcompat r
  }
  have hrootToS : qToS q = s :=
    AdjoinRoot.liftAlgHom_root P (Algebra.ofId R S) s hroot
  have hright : fSR.comp qToS = AlgHom.id R Q := by
    apply AdjoinRoot.algHom_ext
    change fSQ (qToS q) = q
    rw [hrootToS, hfSQs]
  have hleft : qToS.toRingHom.comp fSR.toRingHom = RingHom.id S := by
    apply IsLocalization.ringHom_ext (Submonoid.powers (C π * X + 1))
    apply Polynomial.ringHom_ext
    · intro a
      change qToS (fSR (algebraMap A[X] S (C a))) = algebraMap A[X] S (C a)
      rw [algebraMap_C_eq]
      simp [qToS, fSR]
    · change qToS (fSR s) = s
      rw [show fSR s = q from hfSQs, hrootToS]
  have hbije : Function.Bijective qToS :=
    ⟨Function.LeftInverse.injective (g := fSR) fun x => AlgHom.congr_fun hright x,
      Function.RightInverse.surjective (g := fSR) fun y => RingHom.congr_fun hleft y⟩
  let e : Q ≃ₐ[R] S := AlgEquiv.ofBijective qToS hbije
  refine ⟨⟨(AdjoinRoot.isAdjoinRoot P).ofAlgEquiv e, hPmonic⟩, ?_⟩
  change e (AdjoinRoot.mkₐ P X) = s
  simpa [e, qToS] using hrootToS

