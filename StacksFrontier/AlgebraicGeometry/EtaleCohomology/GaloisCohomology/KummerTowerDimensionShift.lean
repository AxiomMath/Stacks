module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.CohomologicalDimension.TorsionVanishingBound
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GaloisCohomology.KummerProcyclicAbsoluteGalois
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GaloisCohomology.MaximalProEllVanishing
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GroupCohomology.ProcyclicQuotientDimensionShift
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GroupCohomology.ProEllUniqueIndexPrimeBase
import StacksFrontier.AlgebraicGeometry.ContinuousCohomology.ExtComparison

/-!
# Adjoining all `ℓ`-power roots of an element raises `cd_ℓ` by at most one

Let `F` be a field with separable closure `Ω`, `ℓ` a prime such that `Gal(Ω/F)` is pro-`ℓ` and
`F` contains a primitive `ℓ ^ e`-th root of unity for every `e`, and let `π ∈ F` be an element
which is not an `ℓ`-th power. Choose compatible roots `α_k ∈ Ω`, `α_0 = π`,
`α_{k+1} ^ ℓ = α_k`, and let `F' = F(α_k : k ∈ ℕ)`. Then

`cd_ℓ(F) ≤ cd_ℓ(F') + 1`,

in the form: if `H^q_ét(Spec F', 𝓖) = 0` for every `q > t` and every sheaf `𝓖` killed by `ℓ`,
then `H^q_ét(Spec F, 𝓕) = 0` for every `q > t + 1` and every sheaf `𝓕` killed by `ℓ`.

The Galois group `G = Gal(Ω/F)` is filtered by the open normal subgroups `U_k = Gal(Ω/F(α_k))`,
with intersection `N = Gal(Ω/F')`. By Kummer theory each `g ∈ G` sends `α_k` to `ξ α_k` with
`ξ ^ (ℓ ^ k) = 1`; an element `σ` moving `α_1` acts on `α_k` through a primitive `ℓ ^ k`-th root
of unity, so `G / U_k` is cyclic of order `ℓ ^ k` generated by `σ`. This is the input of
`Stacks.GroupCohomology.subsingleton_ext_of_procyclic_filtration`; the cohomology of `N` with
`ℓ`-power torsion coefficients is controlled by `H^{t+1}_ét(Spec F', ℤ/ℓℤ)`
(`AlgebraicGeometry.subsingleton_sheafH_constant_fixedField_iff` and the dévissage for the pro-`ℓ`
group `N`, `Stacks.GroupCohomology.subsingleton_ext_of_isProPGroup`).

The base of the induction this step feeds is also here: a field `F` with pro-`ℓ` absolute Galois
group, a primitive `ℓ`-th root of unity, and every element an `ℓ`-th power, is separably closed
(a nontrivial pro-`ℓ` group has an open subgroup of index `ℓ`, whose fixed field would be a
cyclic Kummer extension of degree `ℓ`).

## Main results

* `IsProPGroup.subgroup`: a subgroup of a profinite pro-`ℓ` group is pro-`ℓ`.
* `AlgebraicGeometry.KummerTower.isSepClosed_of_forall_exists_pow_eq`: the base case.
* `AlgebraicGeometry.KummerTower.isTorsionVanishingBound_succ`: the step.

## References

* J.-P. Serre, *Cohomologie galoisienne*, I §3.3 Proposition 15, I §4.1, II §3.3.
-/

@[expose] public noncomputable section

open CategoryTheory IntermediateField

universe u

namespace IsProPGroup

variable {p : ℕ} {G : Type*} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [CompactSpace G] [TotallyDisconnectedSpace G]

/-- **A subgroup of a profinite pro-`p` group is pro-`p`** for the subspace topology. -/
theorem subgroup (hG : IsProPGroup p G) (H : Subgroup G) : IsProPGroup p H := by
  intro V
  obtain ⟨O, hO, hOV⟩ := isOpen_induced_iff.mp V.isOpen'
  have h1 : (1 : G) ∈ O := by
    have : (1 : H) ∈ (Subtype.val ⁻¹' O : Set H) := by
      rw [hOV]
      exact V.toSubgroup.one_mem
    exact this
  obtain ⟨U, hU⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hO h1
  let f : H →* G ⧸ U.toSubgroup := (QuotientGroup.mk' U.toSubgroup).comp H.subtype
  have hker : f.ker ≤ V.toSubgroup := by
    intro x hx
    have : x ∈ (Subtype.val ⁻¹' O : Set H) :=
      hU ((QuotientGroup.eq_one_iff _).mp (MonoidHom.mem_ker.mp hx))
    rwa [hOV] at this
  have hq : IsPGroup p (H ⧸ f.ker) :=
    ((hG U).to_subgroup f.range).of_equiv (QuotientGroup.quotientKerEquivRange f).symm
  exact hq.of_surjective (QuotientGroup.map f.ker V.toSubgroup (MonoidHom.id H) hker)
    (QuotientGroup.map_surjective_of_surjective _ _ _
      (QuotientGroup.mk_surjective.comp Function.surjective_id) hker)

end IsProPGroup

namespace AlgebraicGeometry.KummerTower

attribute [local instance high]
  Stacks.EtaleCohomology.ConstantTransport.hasExt_sheaf_smallEtaleTopology

section Galois

variable {F Ω : Type*} [Field F] [Field Ω] [Algebra F Ω] [IsGalois F Ω]

omit [IsGalois F Ω] in
/-- An automorphism fixes `F(x)` exactly when it fixes `x`. -/
theorem mem_fixingSubgroup_adjoin_simple_iff (g : Gal(Ω/F)) (x : Ω) :
    g ∈ (F⟮x⟯).fixingSubgroup ↔ g x = x := by
  rw [← Subgroup.zpowers_le, ← IntermediateField.le_iff_le, adjoin_simple_le_iff,
    IntermediateField.mem_fixedField_iff]
  refine ⟨fun h ↦ h g (Subgroup.mem_zpowers g), fun h f hf ↦ ?_⟩
  have hs : g ∈ MulAction.stabilizer Gal(Ω/F) x := h
  exact (Subgroup.zpowers_le.mpr hs) hf

omit [IsGalois F Ω] in
/-- An automorphism fixes `F(S)` exactly when it fixes every element of `S`. -/
theorem mem_fixingSubgroup_adjoin_iff (g : Gal(Ω/F)) (S : Set Ω) :
    g ∈ (adjoin F S).fixingSubgroup ↔ ∀ x ∈ S, g x = x := by
  rw [← Subgroup.zpowers_le, ← IntermediateField.le_iff_le, adjoin_le_iff]
  refine ⟨fun h x hx ↦ (IntermediateField.mem_fixedField_iff _ _).mp (h hx) g
    (Subgroup.mem_zpowers g), fun h x hx ↦ ?_⟩
  rw [SetLike.mem_coe, IntermediateField.mem_fixedField_iff]
  intro f hf
  have hs : g ∈ MulAction.stabilizer Gal(Ω/F) x := h x hx
  exact (Subgroup.zpowers_le.mpr hs) hf

end Galois

section Base

variable (F Ω : Type*) [Field F] [Field Ω] [Algebra F Ω] [IsSepClosure F Ω]

/-- **The base case.** A field with pro-`ℓ` absolute Galois group, a primitive `ℓ`-th root of
unity, and in which every element is an `ℓ`-th power, is separably closed. -/
theorem isSepClosed_of_forall_exists_pow_eq {ℓ : ℕ} (hℓ : ℓ.Prime)
    (hpro : IsProPGroup ℓ Gal(Ω/F)) {ζ : F} (hζ : IsPrimitiveRoot ζ ℓ)
    (hpow : ∀ a : F, ∃ b : F, b ^ ℓ = a) : IsSepClosed F := by
  have : Fact ℓ.Prime := ⟨hℓ⟩
  have : NeZero ℓ := ⟨hℓ.ne_zero⟩
  have htriv : ∀ σ : Gal(Ω/F), σ = 1 := by
    by_contra hne
    push Not at hne
    obtain ⟨σ, hσ⟩ := hne
    obtain ⟨U, hU⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one
      (isOpen_compl_singleton (x := σ)) (Ne.symm hσ)
    have hσU : σ ∉ U.toSubgroup := fun h ↦ hU h rfl
    have : Finite (Gal(Ω/F) ⧸ U.toSubgroup) := Subgroup.quotient_finite_of_isOpen _ U.isOpen'
    have hbot : (⊥ : Subgroup (Gal(Ω/F) ⧸ U.toSubgroup)) ≠ ⊤ := by
      intro h
      apply hσU
      have : (σ : Gal(Ω/F) ⧸ U.toSubgroup) ∈ (⊥ : Subgroup _) := h ▸ Subgroup.mem_top _
      exact (QuotientGroup.eq_one_iff σ).mp (Subgroup.mem_bot.mp this)
    obtain ⟨M, -, hM⟩ := Stacks.GroupCohomology.exists_le_index_eq_of_isPGroup (hpro U) hbot
    let f := QuotientGroup.mk' U.toSubgroup
    let U' : OpenSubgroup Gal(Ω/F) :=
      { toSubgroup := M.comap f
        isOpen' := Subgroup.isOpen_mono (fun x hx ↦ by
          change f x ∈ M
          rw [show f x = 1 from (QuotientGroup.eq_one_iff x).mpr hx]
          exact M.one_mem) U.isOpen' }
    have hU'idx : (U' : Subgroup Gal(Ω/F)).index = ℓ := by
      change (M.comap f).index = ℓ
      rw [Subgroup.index_comap_of_surjective _ (QuotientGroup.mk'_surjective _), hM]
    set E := fixedField (U' : Subgroup Gal(Ω/F))
    obtain ⟨hfd, hidx⟩ := Stacks.GaloisCohomology.finiteDimensional_fixedField_and_index_eq U'
    have hEℓ : Module.finrank F E = ℓ := hidx.symm.trans hU'idx
    have hUn : (U' : Subgroup Gal(Ω/F)).Normal := by
      obtain ⟨k, hk⟩ := IsPGroup.iff_card.1 (hpro U)
      have hk0 : k ≠ 0 := by
        rintro rfl
        rw [pow_zero] at hk
        have := Subgroup.index_dvd_card M
        rw [hM, hk] at this
        exact hℓ.one_lt.ne' (Nat.dvd_one.1 this)
      have hn : M.Normal :=
        Subgroup.normal_of_index_eq_minFac_card (by rw [hM, hk, Nat.Prime.pow_minFac hℓ hk0])
      exact hn.comap f
    have hEfix : E.fixingSubgroup = U' :=
      InfiniteGalois.fixingSubgroup_fixedField
        ({ toSubgroup := U', isClosed' := U'.isClosed } : ClosedSubgroup Gal(Ω/F))
    have : IsGalois F E := by
      rw [← InfiniteGalois.normal_iff_isGalois, hEfix]
      exact hUn
    have : IsCyclic Gal(E/F) :=
      isCyclic_of_prime_card (by rw [IsGalois.card_aut_eq_finrank, hEℓ])
    obtain ⟨α, ⟨a, ha⟩, htop⟩ := exists_root_adjoin_eq_top_of_isCyclic F E
      (by rw [hEℓ]; exact ⟨ζ, (mem_primitiveRoots hℓ.pos).2 hζ⟩)
    rw [hEℓ] at ha
    obtain ⟨b, hb⟩ := hpow a
    have hbot' : (⊥ : IntermediateField F E) ≠ ⊤ := by
      rw [ne_eq, IntermediateField.bot_eq_top_iff_finrank_eq_one, hEℓ]
      exact hℓ.one_lt.ne'
    apply hbot'
    rw [← htop, eq_comm, IntermediateField.adjoin_simple_eq_bot_iff]
    by_cases hb0 : b = 0
    · have ha0 : a = 0 := by rw [← hb, hb0, zero_pow hℓ.ne_zero]
      have hα0 : α = 0 := by
        rw [ha0, map_zero] at ha
        exact (pow_eq_zero_iff hℓ.ne_zero).1 ha.symm
      rw [hα0]
      exact zero_mem _
    have hζE := hζ.map_of_injective (algebraMap F E).injective
    obtain ⟨i, -, hi⟩ := Stacks.GaloisCohomology.exists_eq_pow_mul_of_pow_eq_pow hζE
      (α := algebraMap F E b) (by rwa [ne_eq, map_eq_zero]) (β := α)
      (by rw [← ha, ← hb, map_pow])
    rw [hi, ← map_pow, ← map_mul]
    exact IntermediateField.algebraMap_mem _ _
  have hsep : separableClosure F Ω = ⊥ := by
    rw [eq_bot_iff]
    intro x _
    rw [InfiniteGalois.mem_bot_iff_fixed]
    intro f
    rw [htriv f]
    rfl
  have : IsSepClosed Ω := IsSepClosure.sep_closed F
  exact (IsSepClosed.separableClosure_eq_bot_iff F Ω).mp hsep

end Base

section Step

variable {F Ω : Type u} [Field F] [Field Ω] [Algebra F Ω] [IsSepClosure F Ω]

omit [IsSepClosure F Ω] in
/-- Compatible `ℓ`-power roots: `α_0 = π` and `α_{k+1} ^ ℓ = α_k` give `α_k ^ (ℓ ^ k) = π`. -/
theorem pow_eq_of_compatible {ℓ : ℕ} {π : F} {α : ℕ → Ω} (hα0 : α 0 = algebraMap F Ω π)
    (hαs : ∀ k, α (k + 1) ^ ℓ = α k) (k : ℕ) : α k ^ (ℓ ^ k) = algebraMap F Ω π := by
  induction k with
  | zero => rw [pow_zero, pow_one, hα0]
  | succ k ih => rw [pow_succ', pow_mul, hαs, ih]

/-- Compatible `ℓ`-power roots: `α_k = α_{k+j} ^ (ℓ ^ j)`. -/
theorem eq_pow_of_compatible {ℓ : ℕ} {α : ℕ → Ω} (hαs : ∀ k, α (k + 1) ^ ℓ = α k) (k j : ℕ) :
    α k = α (k + j) ^ (ℓ ^ j) := by
  induction j with
  | zero => rw [pow_zero, pow_one, add_zero]
  | succ j ih => rw [ih, ← add_assoc, ← hαs (k + j), ← pow_mul, ← pow_succ']

variable {ℓ : ℕ} (hℓ : ℓ.Prime) {ζ : ℕ → F} (hζ : ∀ e, IsPrimitiveRoot (ζ e) (ℓ ^ e)) {π : F}
  (hπ : ∀ y : F, y ^ ℓ ≠ π) {α : ℕ → Ω} (hα0 : α 0 = algebraMap F Ω π)
  (hαs : ∀ k, α (k + 1) ^ ℓ = α k)

omit [IsSepClosure F Ω] in
include hℓ hπ hα0 hαs in
/-- Compatible `ℓ`-power roots of a nonzero element are nonzero. -/
theorem compatible_ne_zero (k : ℕ) : α k ≠ 0 := by
  intro h0
  have := pow_eq_of_compatible hα0 hαs k
  rw [h0, zero_pow (pow_ne_zero _ hℓ.ne_zero), eq_comm, map_eq_zero] at this
  exact hπ 0 (by rw [this, zero_pow hℓ.ne_zero])

omit [IsSepClosure F Ω] in
include hℓ hζ hπ hα0 hαs in
/-- **Kummer character.** Every `g ∈ Gal(Ω/F)` sends `α_k` to `ζ_k ^ i α_k`. -/
theorem exists_apply_eq_pow_mul (g : Gal(Ω/F)) (k : ℕ) :
    ∃ i < ℓ ^ k, g (α k) = algebraMap F Ω (ζ k) ^ i * α k := by
  have : Fact ℓ.Prime := ⟨hℓ⟩
  have hζΩ := (hζ k).map_of_injective (algebraMap F Ω).injective
  refine Stacks.GaloisCohomology.exists_eq_pow_mul_of_pow_eq_pow hζΩ
    (compatible_ne_zero hℓ hπ hα0 hαs k) ?_
  rw [← map_pow, pow_eq_of_compatible hα0 hαs k, AlgEquiv.commutes]

/-- The open normal subgroup `Gal(Ω/F(α_k))`. -/
def stage (hℓ : ℓ.Prime) (hζ : ∀ e, IsPrimitiveRoot (ζ e) (ℓ ^ e)) (hπ : ∀ y : F, y ^ ℓ ≠ π)
    (hα0 : α 0 = algebraMap F Ω π) (hαs : ∀ k, α (k + 1) ^ ℓ = α k) (k : ℕ) :
    OpenNormalSubgroup Gal(Ω/F) where
  toSubgroup := (F⟮α k⟯).fixingSubgroup
  isOpen' := (InfiniteGalois.isOpen_iff_finite _).2
    (adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral (R := F) (α k)))
  isNormal' := by
    have : NeZero (ℓ ^ k) := ⟨pow_ne_zero _ hℓ.ne_zero⟩
    have hπ0 : π ≠ 0 := fun h ↦ hπ 0 (by rw [h, zero_pow hℓ.ne_zero])
    have := Stacks.GaloisCohomology.isGalois_adjoin_of_pow_eq (hζ k)
      (pow_eq_of_compatible hα0 hαs k) hπ0
    exact (InfiniteGalois.normal_iff_isGalois _).2 inferInstance

/-- An automorphism lies in `stage k` if and only if it fixes `α k`. -/
theorem mem_stage_iff (g : Gal(Ω/F)) (k : ℕ) :
    g ∈ (stage hℓ hζ hπ hα0 hαs k).toSubgroup ↔ g (α k) = α k :=
  mem_fixingSubgroup_adjoin_simple_iff g (α k)

/-- The stages are decreasing: `stage (k + 1) ≤ stage k`. -/
theorem stage_succ_le (k : ℕ) :
    (stage hℓ hζ hπ hα0 hαs (k + 1)).toSubgroup ≤ (stage hℓ hζ hπ hα0 hαs k).toSubgroup := by
  intro g hg
  rw [mem_stage_iff] at hg ⊢
  rw [← hαs k, map_pow, hg]

/-- An automorphism fixes `F(α_0, α_1, …)` if and only if it lies in every `stage k`. -/
theorem mem_fixingSubgroup_iff_forall_mem_stage (g : Gal(Ω/F)) :
    g ∈ (adjoin F (Set.range α)).fixingSubgroup ↔
      ∀ k, g ∈ (stage hℓ hζ hπ hα0 hαs k).toSubgroup := by
  rw [mem_fixingSubgroup_adjoin_iff]
  simp only [Set.mem_range, forall_exists_index, forall_apply_eq_imp_iff, mem_stage_iff]

include hπ hα0 hαs in
/-- **An automorphism moving `α_1`** exists, as `α_1` is not in `F`. -/
theorem exists_apply_ne : ∃ σ : Gal(Ω/F), σ (α 1) ≠ α 1 := by
  by_contra h
  push Not at h
  have hmem : α 1 ∈ (⊥ : IntermediateField F Ω) := (InfiniteGalois.mem_bot_iff_fixed _).mpr h
  obtain ⟨y, hy⟩ := IntermediateField.mem_bot.mp hmem
  apply hπ y
  apply (algebraMap F Ω).injective
  rw [map_pow, hy, ← hα0, ← hαs 0]

include hℓ hζ hπ hα0 hαs in
/-- **`cd_ℓ(F) ≤ cd_ℓ(F(π^{1/ℓ^∞})) + 1`.** Let `Gal(Ω/F)` be pro-`ℓ`, `F` contain primitive
`ℓ ^ e`-th roots of unity for all `e`, `π ∈ F` not an `ℓ`-th power and `α` a compatible system
of `ℓ`-power roots of `π`. If `H^q_ét(Spec F(α_k : k), 𝓖) = 0` for every `q > t` and every sheaf
`𝓖` killed by `ℓ`, then `H^q_ét(Spec F, 𝓕) = 0` for every `q > t + 1` and every sheaf `𝓕`
killed by `ℓ`. -/
theorem isTorsionVanishingBound_succ (hpro : IsProPGroup ℓ Gal(Ω/F)) {t : ℕ}
    (h' : Scheme.IsTorsionVanishingBound (Spec (.of (adjoin F (Set.range α)))) ℓ (t : ℕ)) :
    Scheme.IsTorsionVanishingBound (Spec (.of F)) ℓ ((t + 1 : ℕ) : WithBot ℕ∞) := by
  have : Fact ℓ.Prime := ⟨hℓ⟩
  set F' := adjoin F (Set.range α) with hF'
  set N := F'.fixingSubgroup with hN
  set U := stage hℓ hζ hπ hα0 hαs with hU
  have hNU : ∀ g, g ∈ N ↔ ∀ k, g ∈ (U k).toSubgroup :=
    mem_fixingSubgroup_iff_forall_mem_stage hℓ hζ hπ hα0 hαs
  have hNn : N.Normal := ⟨fun n hn g ↦ (hNU _).mpr fun k ↦
    (U k).isNormal'.conj_mem n ((hNU n).mp hn k) g⟩
  have hNc : IsClosed (N : Set Gal(Ω/F)) := InfiniteGalois.fixingSubgroup_isClosed F'
  have : CompactSpace N := Stacks.GroupCohomology.compactSpace_of_isClosed hNc
  have hfix : fixedField N = F' := InfiniteGalois.fixedField_fixingSubgroup F'
  let : HasExt.{u + 1} (ContinuousGModule.{u, u + 1} Gal(Ω/F)) :=
    Stacks.ContinuousCohomology.hasExt_continuousModule.{0, u, u + 1} ℤ _
  let : HasExt.{u + 1} (ContinuousGModule.{u, u + 1} N) :=
    Stacks.ContinuousCohomology.hasExt_continuousModule.{0, u, u + 1} ℤ _
  let : HasExt.{u + 1} (ContinuousGModule.{u, u + 1} (⊥ : Subgroup N)) :=
    Stacks.ContinuousCohomology.hasExt_continuousModule.{0, u, u + 1} ℤ _
  have h'' : Scheme.IsTorsionVanishingBound (Spec (.of (fixedField N))) ℓ (t : ℕ) := by
    rw [hfix]
    exact h'
  set Z : Sheaf (Spec (.of (fixedField N))).smallEtaleTopology AddCommGrpCat.{u + 1} :=
    (constantSheaf (Spec (.of (fixedField N))).smallEtaleTopology AddCommGrpCat.{u + 1}).obj
      (AddCommGrpCat.of (ULift.{u + 1} (ZMod ℓ))) with hZ
  have hZℓ : ℓ • 𝟙 Z = 0 := by
    have : (constantSheaf (Spec (.of (fixedField N))).smallEtaleTopology
        AddCommGrpCat.{u + 1}).Additive :=
      Functor.additive_of_preserves_binary_products _
    refine Scheme.nsmul_id_obj_eq_zero _ ?_
    ext x
    simp
  have hZt : Subsingleton (Sheaf.H.{u + 1} Z (t + 1)) :=
    h'' Z ((Scheme.forall_nsmul_eq_zero_iff_nsmul_id_eq_zero Z).2 hZℓ) (t + 1)
      (by exact_mod_cast Nat.lt_succ_self t)
  have hN1 : Subsingleton (Abelian.Ext
      (Stacks.GroupCohomology.trivialGModule.{u, u + 1} N (ULift.{u + 1} ℤ))
      (Stacks.GroupCohomology.trivialGModule N (ULift.{u + 1} (ZMod ℓ))) (t + 1)) :=
    (subsingleton_sheafH_constant_fixedField_iff.{0} F Ω hNc (t + 1)).mp hZt
  have hNpro : IsProPGroup ℓ N := hpro.subgroup N
  have hQ : ∀ M' : ContinuousGModule.{u, u + 1} N,
      (∀ x : M'.obj.obj.V, ∃ k : ℕ, ℓ ^ k • x = 0) → ∀ q : ℕ, t < q →
        Subsingleton (Abelian.Ext
          (Stacks.GroupCohomology.trivialGModule.{u, u + 1} N (ULift.{u + 1} ℤ)) M' q) :=
    fun M' hM' q hq ↦ Stacks.GroupCohomology.subsingleton_ext_of_le.{u, u + 1} (n := t + 1)
      (fun M hM ↦ Stacks.GroupCohomology.subsingleton_ext_of_isProPGroup.{u, u + 1} hNpro
        (t + 1) M hM) hq M' hM'
  obtain ⟨σ, hσ⟩ := exists_apply_ne hπ hα0 hαs
  choose i hi hσi using fun k ↦ exists_apply_eq_pow_mul hℓ hζ hπ hα0 hαs σ k
  set ξ : ℕ → Ω := fun k ↦ algebraMap F Ω (ζ k) ^ i k with hξ
  have hσξ : ∀ k, σ (α k) = ξ k * α k := hσi
  have hfixF : ∀ (g : Gal(Ω/F)) (c : F), g (algebraMap F Ω c) = algebraMap F Ω c :=
    fun g c ↦ g.commutes c
  have hσfixξ : ∀ k, σ (ξ k) = ξ k := fun k ↦ by
    simp only [hξ, map_pow, hfixF]
  have hσpow : ∀ k j, (σ ^ j) (α k) = ξ k ^ j * α k := by
    intro k j
    induction j with
    | zero => simp
    | succ j ih =>
      rw [pow_succ', AlgEquiv.mul_apply, ih, map_mul, map_pow, hσfixξ, hσξ]
      ring
  have hζpow : ∀ k i, (algebraMap F Ω (ζ k) ^ i) ^ (ℓ ^ k) = 1 := fun k i ↦ by
    rw [← pow_mul, mul_comm, pow_mul, ← map_pow, (hζ k).pow_eq_one]
    simp
  have hξprim : ∀ k, IsPrimitiveRoot (ξ k) (ℓ ^ k) := by
    intro k
    have hξk : ξ k ^ (ℓ ^ k) = 1 := hζpow k (i k)
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · rw [pow_zero] at hξk ⊢
      rw [pow_one] at hξk
      rw [hξk]
      exact IsPrimitiveRoot.one
    obtain ⟨s, hs, hos⟩ := (Nat.dvd_prime_pow hℓ).mp (orderOf_dvd_of_pow_eq_one hξk)
    have hsk : s = k := by
      by_contra hne
      have hle : s ≤ k - 1 := by omega
      apply hσ
      have hdiv : orderOf (ξ k) ∣ ℓ ^ (k - 1) := by
        rw [hos]
        exact pow_dvd_pow ℓ hle
      have h1 : ξ k ^ (ℓ ^ (k - 1)) = 1 := orderOf_dvd_iff_pow_eq_one.mp hdiv
      have hα1 : α 1 = α (1 + (k - 1)) ^ (ℓ ^ (k - 1)) := eq_pow_of_compatible hαs 1 (k - 1)
      rw [show 1 + (k - 1) = k by omega] at hα1
      rw [hα1, map_pow, hσξ, mul_pow, h1, one_mul]
    rw [show ℓ ^ k = orderOf (ξ k) by rw [hos, hsk]]
    exact IsPrimitiveRoot.orderOf (ξ k)
  have hstage : ∀ (g : Gal(Ω/F)) k, g ∈ (U k).toSubgroup ↔ g (α k) = α k :=
    fun g k ↦ mem_stage_iff hℓ hζ hπ hα0 hαs g k
  have hαne : ∀ k, α k ≠ 0 := compatible_ne_zero hℓ hπ hα0 hαs
  have hord : ∀ k, orderOf (σ : Gal(Ω/F) ⧸ (U k).toSubgroup) = ℓ ^ k := by
    intro k
    rw [(hξprim k).eq_orderOf, orderOf_eq_orderOf_iff]
    intro j
    rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff, hstage, hσpow]
    exact mul_eq_right₀ (hαne k)
  have hcyc : ∀ k (x : Gal(Ω/F)), ∃ j : ℕ, σ ^ j * x ∈ (U k).toSubgroup := by
    intro k x
    obtain ⟨i', -, hi'⟩ := exists_apply_eq_pow_mul hℓ hζ hπ hα0 hαs x k
    set η := algebraMap F Ω (ζ k ^ i') with hη
    have hxη : x (α k) = η * α k := by rw [hi', hη, map_pow]
    have hη0 : η ≠ 0 := by
      rw [hη, ne_eq, map_eq_zero]
      exact pow_ne_zero _ ((hζ k).ne_zero (pow_ne_zero _ hℓ.ne_zero))
    have hηpow : η⁻¹ ^ (ℓ ^ k) = 1 := by
      rw [inv_pow, hη, map_pow, hζpow, inv_one]
    obtain ⟨j, -, hj⟩ := (hξprim k).eq_pow_of_pow_eq_one hηpow
    have hση : (σ ^ j) η = η := by rw [hη]; exact hfixF _ _
    refine ⟨j, (hstage _ k).mpr ?_⟩
    rw [AlgEquiv.mul_apply, hxη, map_mul, hσpow, hση, hj, ← mul_assoc, mul_inv_cancel₀ hη0,
      one_mul]
  intro G hG p hp
  have hp' : t + 1 < p := by
    have : ((t + 1 : ℕ) : WithBot ℕ∞) < (p : WithBot ℕ∞) := hp
    exact_mod_cast this
  have hG' : ℓ • 𝟙 G = 0 := (Scheme.forall_nsmul_eq_zero_iff_nsmul_id_eq_zero G).1 hG
  rw [subsingleton_sheafH_iff.{0} F Ω G p]
  exact Stacks.GroupCohomology.subsingleton_ext_of_procyclic_filtration.{u, u + 1} (N := N)
    (ℓ := ℓ) (d := t) σ U (stage_succ_le hℓ hζ hπ hα0 hαs) hNU hord hcyc hQ _
    (exists_pow_smul_fieldEtaleSheafEquiv_eq_zero.{0} F Ω G
      (Stacks.Torsion.isPrimePowerTorsion_of_nsmul_id_eq_zero _ hG')) p hp'

end Step

end AlgebraicGeometry.KummerTower

