module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GaloisCohomology.KummerTowerDimensionShift
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GaloisCohomology.StrictlyHenselianMaximalProEllFixedField
public import StacksFrontier.RingTheory.Valuation.Extension.KummerValueGroup

/-!
# Fields whose Kummer group has `t` generators have `cd_ℓ ≤ t`

Let `Ω` be a separably closed field with a valuation `v`, `ℓ` a prime, and `S₀ ⊆ Ω` a subfield
such that every `v`-unit `x ∈ Ω` has an `ℓ`-th root in the field generated by `S₀` and `x` (for
`Ω` a separable closure of the fraction field of a strictly henselian valuation ring `V` with
`ℓ ∈ Vˣ`, `S₀ = Frac V` and `v` the unique extension of the valuation; this is Hensel's lemma).
Let `F ⊆ Ω` be a subfield containing `S₀`, with `Ω` a separable closure of `F`, `Gal(Ω/F)`
pro-`ℓ` and primitive `ℓ ^ e`-th roots of unity in `F` for every `e`. If `Fˣ / Fˣ^ℓ` is generated
by `t` elements, then `H^q_ét(Spec F, 𝓕) = 0` for `q > t` and every sheaf `𝓕` killed by `ℓ`.

The proof is by induction on `t`. For `t = 0` every element of `F` is an `ℓ`-th power, so `F` is
separably closed (`AlgebraicGeometry.KummerTower.isSepClosed_of_forall_exists_pow_eq`). For
`t + 1` generators `π_0, …, π_t`, either `π_t` is an `ℓ`-th power and `t` generators suffice, or
adjoining a compatible system of `ℓ`-power roots `α_k` of `π_t` gives a field
`F' = F(α_k : k)` whose Kummer group is generated by `π_0, …, π_{t-1}`: an element of `F'` lies
in some `F(α_k)`, where it is a `v`-unit times an element of `F` times a power of `α_k`
(`Stacks.KummerValuation.exists_eq_unit_mul_mul_pow`); units are `ℓ`-th powers, `π_t` is an
`ℓ ^ (k+1)`-th power and `α_k` an `ℓ`-th power in `F'`. Then
`AlgebraicGeometry.KummerTower.isTorsionVanishingBound_succ` gives `cd_ℓ(F) ≤ cd_ℓ(F') + 1`.

## Main definitions

* `AlgebraicGeometry.KummerTower.KummerGenerated`: `Fˣ / Fˣ^ℓ` is generated by `t` elements.

## Main results

* `AlgebraicGeometry.KummerTower.kummerGenerated_adjoin`: the Kummer group of `F'`.
* `AlgebraicGeometry.KummerTower.isTorsionVanishingBound_of_kummerGenerated`: `cd_ℓ(F) ≤ t`.

## References

* J.-P. Serre, *Cohomologie galoisienne*, II §3.3.
* L. Illusie, *Cohomological dimension: first results*, in Travaux de Gabber, Exposé XVIII-A,
  closing Remark (Gabber's alternate proof via Zariski–Riemann spaces).
-/

@[expose] public noncomputable section

open CategoryTheory IntermediateField

universe u

namespace AlgebraicGeometry.KummerTower

/-- `Fˣ / Fˣ^ℓ` is generated by `t` elements: there are `π_0, …, π_{t-1} ∈ F` such that every
nonzero `a ∈ F` is `∏ πᵢ ^ mᵢ * b ^ ℓ`. -/
def KummerGenerated (F : Type*) [Field F] (ℓ t : ℕ) : Prop :=
  ∃ π : Fin t → F, ∀ a : F, a ≠ 0 → ∃ (m : Fin t → ℕ) (b : F), a = (∏ i, π i ^ m i) * b ^ ℓ

variable {Ω : Type u} [Field Ω] {Γ₀ : Type*} [LinearOrderedCommGroupWithZero Γ₀]
  (v : Valuation Ω Γ₀) {ℓ : ℕ} (S₀ : Subfield Ω)

/-- A `v`-unit of `Ω` has an `ℓ`-th root in every subfield containing it and `S₀`. -/
theorem exists_pow_eq_of_valuation_eq_one
    (hU : ∀ x : Ω, v x = 1 → ∃ y ∈ Subfield.closure ((S₀ : Set Ω) ∪ {x}), y ^ ℓ = x)
    {E : Subfield Ω} (hE : S₀ ≤ E) {x : Ω} (hx : x ∈ E) (hvx : v x = 1) :
    ∃ y ∈ E, y ^ ℓ = x := by
  obtain ⟨y, hy, hyx⟩ := hU x hvx
  refine ⟨y, (Subfield.closure_le.mpr ?_) hy, hyx⟩
  rintro z (hz | rfl)
  · exact hE hz
  · exact hx

variable (hℓ : ℓ.Prime)
  (hU : ∀ x : Ω, v x = 1 → ∃ y ∈ Subfield.closure ((S₀ : Set Ω) ∪ {x}), y ^ ℓ = x)

include hℓ hU in
/-- **An element which is not an `ℓ`-th power has valuation which is not an `ℓ`-th power** in
the value group of a subfield containing `S₀`. -/
theorem valuation_pow_ne {F : Type*} [Field F] [Algebra F Ω]
    (hS₀ : S₀ ≤ (algebraMap F Ω).fieldRange) {π : F} (hπ : ∀ y : F, y ^ ℓ ≠ π) (c : F) :
    v (algebraMap F Ω c) ^ ℓ ≠ v (algebraMap F Ω π) := by
  intro h
  have hπ0 : π ≠ 0 := fun h0 ↦ hπ 0 (by rw [h0, zero_pow hℓ.ne_zero])
  by_cases hc : c = 0
  · rw [hc, map_zero, v.map_zero, zero_pow hℓ.ne_zero, eq_comm, Valuation.zero_iff,
      map_eq_zero] at h
    exact hπ0 h
  have hcΩ : algebraMap F Ω c ≠ 0 := (map_ne_zero _).mpr hc
  have hvx : v (algebraMap F Ω (π / c ^ ℓ)) = 1 := by
    rw [map_div₀, map_pow, map_div₀, map_pow, ← h, div_self]
    rw [ne_eq, pow_eq_zero_iff hℓ.ne_zero, Valuation.zero_iff]
    exact hcΩ
  obtain ⟨y, hy, hyx⟩ := exists_pow_eq_of_valuation_eq_one v S₀ hU hS₀
    (RingHom.mem_fieldRange.mpr ⟨_, rfl⟩) hvx
  obtain ⟨y', rfl⟩ := RingHom.mem_fieldRange.mp hy
  apply hπ (y' * c)
  apply (algebraMap F Ω).injective
  rw [map_pow, map_mul, mul_pow, hyx, map_div₀, map_pow, div_mul_cancel₀ _ (pow_ne_zero _ hcΩ)]

section Adjoin

variable {F : Type u} [Field F] [Algebra F Ω] [IsSepClosure F Ω]
  {ζ : ℕ → F} (hζ : ∀ e, IsPrimitiveRoot (ζ e) (ℓ ^ e)) {t : ℕ} {π : Fin (t + 1) → F}
  (hπ : ∀ y : F, y ^ ℓ ≠ π (Fin.last t)) {α : ℕ → Ω}
  (hα0 : α 0 = algebraMap F Ω (π (Fin.last t))) (hαs : ∀ k, α (k + 1) ^ ℓ = α k)

/-- A subfield of `Ω` inside the image of `F` lies in every intermediate field `F'`. -/
private theorem le_toSubfield_of_le_fieldRange {F : Type*} [Field F] [Algebra F Ω]
    (F' : IntermediateField F Ω) (hS₀ : S₀ ≤ (algebraMap F Ω).fieldRange) :
    S₀ ≤ F'.toSubfield := fun z hz ↦ by
  obtain ⟨c, rfl⟩ := RingHom.mem_fieldRange.mp (hS₀ hz)
  exact F'.algebraMap_mem c

include hℓ hU hζ hπ hα0 hαs in
/-- **The Kummer group of `F(π_t^{1/ℓ^∞})` is generated by `π_0, …, π_{t-1}`.** -/
theorem kummerGenerated_adjoin (hS₀ : S₀ ≤ (algebraMap F Ω).fieldRange)
    (hgen : ∀ a : F, a ≠ 0 → ∃ (m : Fin (t + 1) → ℕ) (b : F), a = (∏ i, π i ^ m i) * b ^ ℓ) :
    KummerGenerated (adjoin F (Set.range α)) ℓ t := by
  set F' := adjoin F (Set.range α) with hF'
  have hαk : ∀ k, α k ^ (ℓ ^ k) = algebraMap F Ω (π (Fin.last t)) :=
    pow_eq_of_compatible hα0 hαs
  have hαmem : ∀ k, α k ∈ F' := fun k ↦ subset_adjoin F _ ⟨k, rfl⟩
  have hmono : Monotone fun k ↦ F⟮α k⟯ := by
    refine monotone_nat_of_le_succ fun k ↦ ?_
    rw [adjoin_simple_le_iff, ← hαs k]
    exact pow_mem (mem_adjoin_simple_self F _) ℓ
  refine ⟨fun i ↦ algebraMap F F' (π (Fin.castSucc i)), fun a ha ↦ ?_⟩
  -- `a` lies in some `F(α_K)`
  have ha0 : (a : Ω) ≠ 0 := fun h ↦ ha (Subtype.ext h)
  obtain ⟨K, haK⟩ : ∃ K, (a : Ω) ∈ F⟮α K⟯ := by
    have hle : F' ≤ ⨆ k, F⟮α k⟯ := by
      rw [hF', adjoin_le_iff]
      rintro _ ⟨k, rfl⟩
      exact (le_iSup (fun k ↦ F⟮α k⟯) k) (mem_adjoin_simple_self F (α k))
    have hmem : (a : Ω) ∈ ((⨆ k, F⟮α k⟯ : IntermediateField F Ω) : Set Ω) := hle a.2
    rw [IntermediateField.coe_iSup_of_directed hmono.directed_le, Set.mem_iUnion] at hmem
    exact hmem
  -- `a = u * c * α_K ^ j`
  obtain ⟨u, c, j, huK, hvu, hc0, hauc⟩ := Stacks.KummerValuation.exists_eq_unit_mul_mul_pow v
    hℓ (hζ K) (valuation_pow_ne v S₀ hℓ hU hS₀ hπ) (hαk K) haK ha0
  have huF' : u ∈ F' := (adjoin_simple_le_iff.mpr (hαmem K)) huK
  obtain ⟨w, hwF', hwu⟩ := exists_pow_eq_of_valuation_eq_one v S₀ hU
    (le_toSubfield_of_le_fieldRange S₀ F' hS₀) huF' hvu
  obtain ⟨m, b, hcb⟩ := hgen c hc0
  set n := j + ℓ ^ K * m (Fin.last t) with hn
  have hb'mem : w * algebraMap F Ω b * α (K + 1) ^ n ∈ F' :=
    mul_mem (mul_mem hwF' (F'.algebraMap_mem b)) (pow_mem (hαmem (K + 1)) n)
  refine ⟨fun i ↦ m (Fin.castSucc i), ⟨_, hb'mem⟩, Subtype.ext ?_⟩
  change (a : Ω) = F'.val (_ * _)
  simp only [map_mul, map_prod, map_pow, AlgHom.commutes, IntermediateField.coe_val]
  rw [hauc, hcb, Fin.prod_univ_castSucc]
  simp only [map_mul, map_prod, map_pow]
  rw [← hαk K, ← hαs K, ← hwu, hn]
  ring

end Adjoin

include hℓ hU in
/-- **A field whose Kummer group has `t` generators has `cd_ℓ ≤ t`.** Let `F ⊆ Ω` contain `S₀`,
with `Ω` a separable closure of `F`, `Gal(Ω/F)` pro-`ℓ` and primitive `ℓ ^ e`-th roots of unity
in `F` for all `e`. If `Fˣ / Fˣ^ℓ` is generated by `t` elements, then `H^q_ét(Spec F, 𝓕) = 0`
for every `q > t` and every sheaf `𝓕` killed by `ℓ`. -/
theorem isTorsionVanishingBound_of_kummerGenerated (t : ℕ) :
    ∀ (F : Type u) [Field F] [Algebra F Ω] [IsSepClosure F Ω], IsProPGroup ℓ Gal(Ω/F) →
      (∀ e, ∃ ζ : F, IsPrimitiveRoot ζ (ℓ ^ e)) → S₀ ≤ (algebraMap F Ω).fieldRange →
        KummerGenerated F ℓ t → Scheme.IsTorsionVanishingBound (Spec (.of F)) ℓ (t : ℕ) := by
  induction t with
  | zero =>
    intro F _ _ _ hpro hζ _ hK
    obtain ⟨π, hπ⟩ := hK
    obtain ⟨ζ₁, hζ₁⟩ := hζ 1
    rw [pow_one] at hζ₁
    have hpow : ∀ a : F, ∃ b : F, b ^ ℓ = a := by
      intro a
      by_cases ha : a = 0
      · exact ⟨0, by rw [ha, zero_pow hℓ.ne_zero]⟩
      · obtain ⟨m, b, hab⟩ := hπ a ha
        exact ⟨b, by rw [hab, Finset.univ_eq_empty, Finset.prod_empty, one_mul]⟩
    have := isSepClosed_of_forall_exists_pow_eq F Ω hℓ hpro hζ₁ hpow
    exact (Scheme.isTorsionVanishingBound_spec_of_isSepClosed F hℓ.pos).mono (by simp)
  | succ t ih =>
    intro F _ _ _ hpro hζ hS₀ hK
    obtain ⟨π, hgen⟩ := hK
    by_cases hlast : ∃ y : F, y ^ ℓ = π (Fin.last t)
    · obtain ⟨y, hy⟩ := hlast
      refine (ih F hpro hζ hS₀ ⟨fun i ↦ π (Fin.castSucc i), fun a ha ↦ ?_⟩).mono
        (by exact_mod_cast Nat.le_succ t)
      obtain ⟨m, b, hab⟩ := hgen a ha
      refine ⟨fun i ↦ m (Fin.castSucc i), y ^ m (Fin.last t) * b, ?_⟩
      rw [hab, Fin.prod_univ_castSucc, ← hy]
      ring
    · push Not at hlast
      choose ζ hζ' using hζ
      have : IsSepClosed Ω := IsSepClosure.sep_closed F
      have hℓF : ((ℓ : ℕ) : F) ≠ 0 := by
        have : NeZero (ℓ ^ 1) := ⟨pow_ne_zero _ hℓ.ne_zero⟩
        have := (hζ' 1).neZero'
        rw [pow_one] at this
        exact this.out
      have : NeZero ((ℓ : ℕ) : Ω) := ⟨by rwa [← map_natCast (algebraMap F Ω), ne_eq, map_eq_zero]⟩
      let α : ℕ → Ω := fun k ↦ Nat.rec (motive := fun _ ↦ Ω) (algebraMap F Ω (π (Fin.last t)))
        (fun _ a ↦ Classical.choose (IsSepClosed.exists_pow_nat_eq a ℓ)) k
      have hα0 : α 0 = algebraMap F Ω (π (Fin.last t)) := rfl
      have hαs : ∀ k, α (k + 1) ^ ℓ = α k := fun k ↦
        Classical.choose_spec (IsSepClosed.exists_pow_nat_eq (α k) ℓ)
      set F' := adjoin F (Set.range α) with hF'
      have : IsSepClosure F' Ω :=
        ⟨IsSepClosure.sep_closed F, Algebra.isSeparable_tower_top_of_isSeparable F F' Ω⟩
      have hpro' : IsProPGroup ℓ Gal(Ω/F') := by
        let NC : ClosedSubgroup Gal(Ω/F) :=
          ⟨F'.fixingSubgroup, InfiniteGalois.fixingSubgroup_isClosed F'⟩
        have h1 := StrictlyHenselianKummer.isProPGroup_of_continuousMulEquiv
          (InfiniteGalois.fixedFieldGalContinuousMulEquiv NC) (hpro.subgroup _)
        have hfix : fixedField NC.toSubgroup = F' := InfiniteGalois.fixedField_fixingSubgroup F'
        rwa [hfix] at h1
      have hζF' : ∀ e, ∃ ζ : F', IsPrimitiveRoot ζ (ℓ ^ e) := fun e ↦
        ⟨_, (hζ' e).map_of_injective (algebraMap F F').injective⟩
      have hS₀' : S₀ ≤ (algebraMap F' Ω).fieldRange :=
        (le_toSubfield_of_le_fieldRange S₀ F' hS₀).trans (fieldRange_val F').ge
      have hK' := kummerGenerated_adjoin v S₀ hℓ hU hζ' hlast hα0 hαs hS₀ hgen
      exact isTorsionVanishingBound_succ hℓ hζ' hlast hα0 hαs hpro (ih F' hpro' hζF' hS₀' hK')

end AlgebraicGeometry.KummerTower

end
