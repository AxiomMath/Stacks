/-!
# Common zeros of homogeneous polynomials over an algebraically closed field

Over an algebraically closed field, fewer homogeneous equations of positive degree than
variables always have a common nonzero solution. Equivalently, an algebraically closed field
is a \(C_r\) field for every `r`.

## Main results

* `exists_nonzero_common_zero_of_isHomogeneous`: a family of fewer homogeneous
  polynomials than variables, each of positive degree, has a common nonzero zero.

## Implementation notes

The polynomials and their degrees are indexed by `Fin s`, while their variables are indexed by
`Fin n`. A nontrivial solution is a function `Fin n → k` which is not the zero function. The
proof is by Krull's height theorem: were the origin the only common zero, the vanishing ideal
of the origin would be a minimal prime over the ideal generated by the family, hence of height
at most `s`, contradicting that it has height `n`.

## References

* [Stacks Project, Tag 03RB](https://stacks.math.columbia.edu/tag/03RB)
-/

@[expose] public section

/-- **Stacks Project, Tag 03RB.** Over an algebraically closed field, a family of `s < n`
homogeneous polynomials of positive degree in `n` variables has a common nonzero zero. -/
@[stacks 03RB,
  stacks 03RA "an algebraically closed field is `C_r`: the one-polynomial case `s = 1`"]
lemma exists_nonzero_common_zero_of_isHomogeneous
    (k : Type*) [Field k] [IsAlgClosed k] {s n : ℕ}
    (d : Fin s → ℕ) (f : (i : Fin s) → MvPolynomial (Fin n) k)
    (hd : ∀ i, 0 < d i) (hf : ∀ i, (f i).IsHomogeneous (d i)) (hsn : s < n) :
    ∃ α : Fin n → k, α ≠ 0 ∧ ∀ i, MvPolynomial.eval α (f i) = 0 := by
  classical
  by_contra hnot
  let I : Ideal (MvPolynomial (Fin n) k) := Ideal.span (Set.range f)
  let q : Ideal (MvPolynomial (Fin n) k) :=
    MvPolynomial.vanishingIdeal k ({(0 : Fin n → k)} : Set (Fin n → k))
  have hIker : I ≤ RingHom.ker (MvPolynomial.aeval (0 : Fin n → k)) := by
    show Ideal.span (Set.range f) ≤ _
    rw [Ideal.span_le]
    rintro _ ⟨i, rfl⟩
    show (MvPolynomial.aeval (0 : Fin n → k)) (f i) = 0
    rw [MvPolynomial.aeval_zero]
    show (f i).coeff 0 = 0
    exact MvPolynomial.IsHomogeneous.coeff_eq_zero (hf i)
      (by simpa using (Nat.ne_of_gt (hd i)).symm)
  have hzeroLocus : MvPolynomial.zeroLocus k I = {0} := by
    refine Set.eq_singleton_iff_unique_mem.2
      ⟨MvPolynomial.mem_zeroLocus_iff.2 fun p hp => hIker hp, fun α hα => ?_⟩
    by_contra hα0
    exact hnot ⟨α, hα0, fun i => by
      simpa [MvPolynomial.aeval_eq_eval₂Hom] using
        MvPolynomial.mem_zeroLocus_iff.1 hα (f i) (Ideal.subset_span ⟨i, rfl⟩)⟩
  have hrad : I.radical = q := by
    simpa only [hzeroLocus] using
      (MvPolynomial.vanishingIdeal_zeroLocus_eq_radical (k := k) (K := k) I).symm
  have hqmax : q.IsMaximal := inferInstance
  have hqmin : q ∈ I.minimalPrimes := by
    show I.IsMinimalPrime q
    exact ⟨⟨hqmax.isPrime, Ideal.le_radical.trans hrad.le⟩,
      fun r hr _ => hrad.ge.trans ((Ideal.radical_mono hr.2).trans hr.1.radical.le)⟩
  have hqheight : q.height = n := by exact_mod_cast height_maximal_ideal_eq n q hqmax
  have hcard : (Set.range f).ncard ≤ s := by
    rw [← Set.image_univ]
    exact (Set.ncard_image_le (Set.finite_univ)).trans (by simp)
  have hns : (n : ℕ∞) ≤ s := by
    rw [← hqheight]
    exact (Ideal.height_le_card_of_mem_minimalPrimes_span (Set.finite_range f) hqmin).trans
      (by exact_mod_cast hcard)
  exact hsn.not_ge (by exact_mod_cast hns)
