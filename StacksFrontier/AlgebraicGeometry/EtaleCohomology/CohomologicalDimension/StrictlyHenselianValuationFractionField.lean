module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.CohomologicalDimension.StrictlyHenselianDVRFractionField
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GaloisCohomology.KummerGeneratedVanishing
public import StacksFrontier.LinearAlgebra.TorsionFreeRankModPrimeGenerators
public import StacksFrontier.RingTheory.DiscreteValuationRing.StrictlyHenselianIntegralClosure
public import StacksFrontier.RingTheory.DiscreteValuationRing.StrictlyHenselianKummerUnits
public import StacksFrontier.RingTheory.Valuation.Extension.FundamentalInequality
public import StacksFrontier.RingTheory.Valuation.Extension.HenselianIntegralClosure

/-!
# The fraction field of a strictly henselian valuation ring has `cd_n ≤` the rational rank

Let `V` be a strictly henselian valuation ring with fraction field `K` and value group `Γ`, let
`n` be invertible in `V`, and let `r` bound the rational rank of `Γ`, here
`Module.rank ℤ (Additive Γ) ≤ r` (for the torsion-free group `Γ` this is
`dim_ℚ (Γ ⊗ ℚ) ≤ r`). Then `H^q_ét(Spec K, 𝓕) = 0` for every `q > r` and every sheaf `𝓕` killed
by `n`: `cd_n(K) ≤ r`. This is the statement used in Gabber's proof of Travaux de Gabber
XVIII-A, Corollary 1.2, via Zariski–Riemann spaces: the absolute Galois group of `K` is an
extension of `∏_{ℓ ≠ p} Hom(Γ, ℤ_ℓ(1))` by a pro-`p` group, so `cd_ℓ(K) = dim_{𝔽_ℓ}(Γ / ℓΓ)`.

The proof does not identify the Galois group. Fix a prime `ℓ ∣ n` and a separable closure `Ω`
of `K`; the integral closure `𝒪` of `V` in `Ω` is a valuation ring
(`ValuationRing.mem_or_inv_mem_integralClosure_of_henselian`), and Hensel's lemma makes every
`𝒪`-unit an `ℓ`-th power in every subextension containing it. Let `L` be the fixed field of a
maximal pro-`ℓ` subgroup `H ⊆ Gal(Ω/K)`.

* `Kˣ / Kˣ^ℓ ≅ Γ / ℓΓ` is generated by `d ≤ r` elements
  (`AddCommGroup.exists_generators_mod_nsmul`), units of `V` being `ℓ`-th powers.
* `Lˣ = Kˣ · Lˣ^ℓ`: an element `a ∈ L` lies in `K' = K(a)`, of degree prime to `ℓ`; the order
  `m` of `v(a)` modulo `v(Kˣ)` is finite (two terms of the minimal polynomial of `a` have the same
  valuation) and prime to `ℓ` (otherwise `K'` would contain a Kummer extension of degree `ℓ`), so
  `v(a) ∈ v(Kˣ) · v(K'ˣ)^ℓ`.
* Hence `Lˣ / Lˣ^ℓ` is generated by `d` elements, and
  `AlgebraicGeometry.KummerTower.isTorsionVanishingBound_of_kummerGenerated` gives
  `cd_ℓ(L) ≤ d`; Stacks 0DV9 (`cd_ℓ(K) = cd_ℓ(L)` on `ℓ`-torsion) and dévissage in `n` finish.

## Main results

* `AlgebraicGeometry.ValuationRingFractionField.exists_pow_eq_of_valuation_eq_one`: Hensel's
  lemma for the units of `𝒪`.
* `AlgebraicGeometry.ValuationRingFractionField.kummerGenerated_fractionRing`: `Kˣ / Kˣ^ℓ` is
  generated by `d ≤ r` elements.
* `AlgebraicGeometry.ValuationRingFractionField.kummerGenerated_fixedField`: the same for `L`.
* `AlgebraicGeometry.Scheme.isTorsionVanishingBound_spec_fractionRing_of_valuationRing`:
  `cd_n(K) ≤ r`.

## References

* L. Illusie, *Cohomological dimension: first results*, in Travaux de Gabber, Exposé XVIII-A,
  closing Remark (Gabber's alternate proof via Zariski–Riemann spaces).
* J.-P. Serre, *Cohomologie galoisienne*, II §3.3.
* [Stacks Project, Tag 0DV9](https://stacks.math.columbia.edu/tag/0DV9)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IntermediateField

universe u

namespace AlgebraicGeometry.ValuationRingFractionField

section Hensel

variable (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [StrictlyHenselianLocalRing V]
  (K : Type u) [Field K] [Algebra V K] [IsFractionRing V K]
  (Ω : Type u) [Field Ω] [Algebra K Ω] [Algebra V Ω] [IsScalarTower V K Ω]
  [FaithfulSMul V Ω] [Algebra.IsAlgebraic V Ω]

omit [IsFractionRing V K] in
/-- **Hensel's lemma for the units of the integral closure.** A unit `x` of the valuation ring
`𝒪 ⊆ Ω` (the integral closure of `V`) has an `ℓ`-th root in `K(x)`, for `ℓ` invertible in
`V`. -/
theorem exists_pow_eq_of_valuation_eq_one {ℓ : ℕ} (hℓ : IsUnit (ℓ : V)) {x : Ω}
    (hx : (ValuationRing.integralClosureValuationSubring V Ω).valuation x = 1) :
    ∃ y ∈ Subfield.closure (((algebraMap K Ω).fieldRange : Set Ω) ∪ {x}), y ^ ℓ = x := by
  set 𝒪 := ValuationRing.integralClosureValuationSubring V Ω
  have hxO : x ∈ integralClosure V Ω := (𝒪.valuation_le_one_iff x).mp hx.le
  have hx0 : x ≠ 0 := by
    rintro rfl
    rw [map_zero] at hx
    exact zero_ne_one hx
  have hxiO : x⁻¹ ∈ integralClosure V Ω :=
    (𝒪.valuation_le_one_iff x⁻¹).mp (by rw [map_inv₀, hx, inv_one])
  set E := K⟮x⟯
  let : Algebra V E := ((algebraMap K E).comp (algebraMap V K)).toAlgebra
  have : IsScalarTower V E Ω := IsScalarTower.of_algebraMap_eq fun c ↦ by
    rw [IsScalarTower.algebraMap_apply V K Ω c]
    rfl
  have : StrictlyHenselianLocalRing (integralClosure V E) :=
    Stacks.Henselian.strictlyHenselianLocalRing_integralClosure V E
  have hint : ∀ z : E, _root_.IsIntegral V (z : Ω) → _root_.IsIntegral V z := fun z hz ↦
    (isIntegral_algHom_iff (IsScalarTower.toAlgHom V E Ω) (algebraMap E Ω).injective).mp hz
  let x' : E := ⟨x, mem_adjoin_simple_self K x⟩
  have hx'0 : x' ≠ 0 := fun h ↦ hx0 (congrArg Subtype.val h)
  let X : integralClosure V E := ⟨x', hint x' hxO⟩
  let Xi : integralClosure V E := ⟨x'⁻¹, hint x'⁻¹ hxiO⟩
  have hXu : IsUnit X := (Units.mkOfMulEqOne X Xi (Subtype.ext (mul_inv_cancel₀ hx'0))).isUnit
  have hℓR : IsUnit ((ℓ : ℕ) : integralClosure V E) := by
    have := hℓ.map (algebraMap V (integralClosure V E))
    rwa [map_natCast] at this
  obtain ⟨b, hb⟩ :=
    Stacks.StrictlyHenselianKummer.exists_pow_eq_of_isUnit (integralClosure V E) hℓR hXu
  refine ⟨((b : E) : Ω), ?_, ?_⟩
  · rw [RingHom.coe_fieldRange]
    exact (b : E).2
  · exact congrArg (fun z : integralClosure V E ↦ ((z : E) : Ω)) hb

end Hensel

section ValueGroup

variable {Γ₀ : Type*} [LinearOrderedCommGroupWithZero Γ₀]

/-- In a linearly ordered group with zero, a nonzero element with `γ ^ ℓ = 1`, `ℓ ≠ 0`, is
`1`. -/
theorem eq_one_of_pow_eq_one {γ : Γ₀} {ℓ : ℕ} (hℓ : ℓ ≠ 0) (h : γ ^ ℓ = 1) : γ = 1 := by
  obtain ⟨k, rfl⟩ : ∃ k, ℓ = k + 1 := ⟨ℓ - 1, by omega⟩
  rcases lt_trichotomy γ 1 with hlt | heq | hgt
  · exfalso
    have : γ ^ (k + 1) < 1 := by
      rw [pow_succ]
      calc γ ^ k * γ ≤ 1 * γ := mul_le_mul_left (pow_le_one' hlt.le k) γ
        _ = γ := one_mul γ
        _ < 1 := hlt
    exact this.ne h
  · exact heq
  · exfalso
    have : 1 < γ ^ (k + 1) := by
      rw [pow_succ]
      calc 1 < γ := hgt
        _ = 1 * γ := (one_mul γ).symm
        _ ≤ γ ^ k * γ := mul_le_mul_left (one_le_pow_of_one_le' hgt.le k) γ
    exact this.ne' h

end ValueGroup

section KummerK

variable (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [StrictlyHenselianLocalRing V]
  (K : Type u) [Field K] [Algebra V K] [IsFractionRing V K]

omit [IsDomain V] [ValuationRing V] in
/-- `K` contains a primitive `ℓ ^ e`-th root of unity for every `e`, `ℓ` being invertible
in `V`. -/
theorem exists_isPrimitiveRoot {ℓ : ℕ} (hℓ : IsUnit (ℓ : V)) (e : ℕ) :
    ∃ ζ : K, IsPrimitiveRoot ζ (ℓ ^ e) := by
  obtain ⟨ζ, hζ⟩ := Stacks.StrictlyHenselianKummer.exists_isPrimitiveRoot V (m := ℓ ^ e)
    (by rw [Nat.cast_pow]; exact hℓ.pow e)
  exact ⟨_, hζ.map_of_injective (IsFractionRing.injective V K)⟩

/-- **`Kˣ / Kˣ^ℓ` is generated by at most `r` elements** when the value group has rank at most
`r`: the valuations of the generators span `Γ / ℓΓ`, and units of `V` are `ℓ`-th powers. -/
theorem kummerGenerated_fractionRing {ℓ : ℕ} (hℓ : ℓ.Prime) (hℓV : IsUnit (ℓ : V)) {r : ℕ}
    (hrank : Module.rank ℤ (Additive (ValuationRing.ValueGroup V K)ˣ) ≤ r) :
    ∃ d ≤ r, KummerTower.KummerGenerated K ℓ d := by
  have htf : ∀ x : Additive (ValuationRing.ValueGroup V K)ˣ, ℓ • x = 0 → x = 0 := by
    intro x hx
    have h1 : ((x.toMul : (ValuationRing.ValueGroup V K)ˣ) : ValuationRing.ValueGroup V K) ^ ℓ =
        1 := by
      rw [← Units.val_pow_eq_pow_val, ← toMul_nsmul, hx, toMul_zero, Units.val_one]
    have h2 := eq_one_of_pow_eq_one hℓ.ne_zero h1
    apply_fun Additive.toMul
    exact Units.ext h2
  obtain ⟨d, hd, β, hβ⟩ := AddCommGroup.exists_generators_mod_nsmul hℓ htf hrank
  set v := ValuationRing.valuation V K
  choose π hπ using fun i ↦ ValuationRing.valuation_surjective V K
    ((Additive.toMul (β i) : (ValuationRing.ValueGroup V K)ˣ) : ValuationRing.ValueGroup V K)
  refine ⟨d, hd, π, fun a ha ↦ ?_⟩
  have hva : v a ≠ 0 := by rwa [ne_eq, Valuation.zero_iff]
  obtain ⟨m, δ, hγ⟩ := hβ (Additive.ofMul (Units.mk0 (v a) hva))
  obtain ⟨c, hc⟩ := ValuationRing.valuation_surjective V K
    ((Additive.toMul δ : (ValuationRing.ValueGroup V K)ˣ) : ValuationRing.ValueGroup V K)
  have hγ' : v a = (∏ i, v (π i) ^ m i) * v c ^ ℓ := by
    have := congrArg (fun z ↦ ((Additive.toMul z : (ValuationRing.ValueGroup V K)ˣ) :
      ValuationRing.ValueGroup V K)) hγ
    simp only [toMul_ofMul, Units.val_mk0, toMul_add, toMul_sum, toMul_nsmul, Units.val_mul,
      Units.coe_prod, Units.val_pow_eq_pow_val] at this
    rw [this, hc]
    congr 1
    exact Finset.prod_congr rfl fun i _ ↦ by rw [hπ i]
  have hc0 : c ≠ 0 := by
    rintro rfl
    rw [map_zero, zero_pow hℓ.ne_zero, mul_zero] at hγ'
    exact hva hγ'
  have hπ0 : ∀ i, π i ≠ 0 := fun i h0 ↦ by
    have := hπ i
    rw [h0, map_zero] at this
    exact Units.ne_zero _ this.symm
  set D := (∏ i, π i ^ m i) * c ^ ℓ with hD
  have hD0 : D ≠ 0 := mul_ne_zero (Finset.prod_ne_zero_iff.mpr fun i _ ↦ pow_ne_zero _ (hπ0 i))
    (pow_ne_zero _ hc0)
  have hvu : v (a / D) = 1 := by
    rw [map_div₀, hγ', hD, map_mul, map_prod, map_pow]
    simp only [map_pow]
    rw [div_self]
    rw [← hγ']
    exact hva
  -- `a / D` is the image of a unit of `V`
  obtain ⟨u, hu⟩ := (ValuationRing.mem_integer_iff V K (a / D)).mp
    (show v (a / D) ≤ 1 from hvu.le)
  obtain ⟨u', hu'⟩ := (ValuationRing.mem_integer_iff V K (a / D)⁻¹).mp
    (show v (a / D)⁻¹ ≤ 1 by rw [map_inv₀, hvu, inv_one])
  have huu : u * u' = 1 := by
    apply IsFractionRing.injective V K
    rw [map_mul, hu, hu', map_one, mul_inv_cancel₀]
    exact div_ne_zero ha hD0
  obtain ⟨b, hb⟩ := Stacks.StrictlyHenselianKummer.exists_pow_eq_of_isUnit V hℓV
    (Units.mkOfMulEqOne u u' huu).isUnit
  refine ⟨m, c * algebraMap V K b, ?_⟩
  have hb' : b ^ ℓ = u := hb
  have haD : a = algebraMap V K u * D := by rw [hu, div_mul_cancel₀ a hD0]
  rw [haD, ← hb', map_pow, hD]
  ring

end KummerK

section FixedField

variable (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [StrictlyHenselianLocalRing V]
  (K : Type u) [Field K] [Algebra V K] [IsFractionRing V K]
  (Ω : Type u) [Field Ω] [Algebra K Ω] [IsSepClosure K Ω] [Algebra V Ω] [IsScalarTower V K Ω]
  [FaithfulSMul V Ω] [Algebra.IsAlgebraic V Ω]

/-- A nonzero element of `K` has nonzero valuation in `Ω`. -/
private theorem valuation_algebraMap_ne_zero {F E Γ₀ : Type*} [Field F] [Field E] [Algebra F E]
    [LinearOrderedCommGroupWithZero Γ₀] (v : Valuation E Γ₀) {c : F} (hc : c ≠ 0) :
    v (algebraMap F E c) ≠ 0 :=
  v.ne_zero_iff.mpr ((map_ne_zero _).mpr hc)

/-- If `n = ℓ * m` with `ℓ` prime and `n > 0`, then `0 < m < n`. -/
private theorem pos_and_lt_of_eq_mul_prime {ℓ n m : ℕ} (hℓ : ℓ.Prime) (hn : 0 < n)
    (h : n = ℓ * m) : 0 < m ∧ m < n := by
  have hm : 0 < m := Nat.pos_of_ne_zero (by rintro rfl; omega)
  exact ⟨hm, by rw [h]; exact lt_mul_left hm hℓ.one_lt⟩

/-- Cancelling a common power in an equality of valuations. -/
theorem pow_eq_div_of_mul_pow_eq {Γ₀ : Type*} [LinearOrderedCommGroupWithZero Γ₀]
    {α β γ : Γ₀} (hα : α ≠ 0) (hγ : γ ≠ 0) {j e : ℕ} (h : α * γ ^ (j + e) = β * γ ^ j) :
    γ ^ e = β / α := by
  rw [eq_div_iff hα]
  apply mul_right_cancel₀ (pow_ne_zero j hγ)
  rw [← h, pow_add]
  rw [mul_comm (γ ^ e) α, mul_assoc, mul_comm (γ ^ e)]

/-- **Some power of the valuation of an algebraic element lies in the value group of the base**:
two terms of its minimal polynomial have the same valuation. -/
theorem exists_valuation_pow_eq {Γ₀ : Type*} [LinearOrderedCommGroupWithZero Γ₀]
    (v : Valuation Ω Γ₀) {a : Ω} (ha : a ≠ 0) :
    ∃ m : ℕ, 1 ≤ m ∧ ∃ c : K, c ≠ 0 ∧ v a ^ m = v (algebraMap K Ω c) := by
  classical
  have hint : _root_.IsIntegral K a := Algebra.IsIntegral.isIntegral a
  set p := minpoly K a
  set n := p.natDegree
  have hn : 0 < n := minpoly.natDegree_pos hint
  set f : ℕ → Ω := fun i ↦ algebraMap K Ω (p.coeff i) * a ^ i with hf
  have hsum : ∑ i ∈ Finset.range (n + 1), f i = 0 := by
    have := minpoly.aeval K a
    rw [Polynomial.aeval_eq_sum_range] at this
    rw [← this]
    refine Finset.sum_congr rfl fun i _ ↦ ?_
    rw [hf, Algebra.smul_def]
  have hva : v a ≠ 0 := by rwa [ne_eq, Valuation.zero_iff]
  have hfn : v (f n) ≠ 0 := by
    rw [hf]
    simp only
    rw [show p.coeff n = 1 from minpoly.monic hint, map_one, one_mul, map_pow]
    exact pow_ne_zero _ hva
  obtain ⟨j, hj, hjmax⟩ := Finset.exists_max_image (Finset.range (n + 1)) (fun i ↦ v (f i))
    ⟨n, Finset.self_mem_range_succ n⟩
  have hfj : v (f j) ≠ 0 := fun h0 ↦ hfn (le_antisymm
    ((hjmax n (Finset.self_mem_range_succ n)).trans h0.le) zero_le')
  obtain ⟨i, hi, hij, hvij⟩ : ∃ i ∈ Finset.range (n + 1), i ≠ j ∧ v (f i) = v (f j) := by
    by_contra hcon
    push Not at hcon
    have hlt : ∀ i ∈ Finset.range (n + 1) \ {j}, v (f i) < v (f j) := fun i hi ↦ by
      rw [Finset.mem_sdiff, Finset.mem_singleton] at hi
      exact lt_of_le_of_ne (hjmax i hi.1) (hcon i hi.1 hi.2)
    have := v.map_sum_eq_of_lt hj hlt
    rw [hsum, v.map_zero] at this
    exact hfj this.symm
  have hcne : ∀ k, v (f k) = v (f j) → p.coeff k ≠ 0 := fun k hk h0 ↦ hfj (by
    rw [← hk, hf]
    simp [h0])
  have hci := hcne i hvij
  have hcj := hcne j rfl
  simp only [hf, map_mul, map_pow] at hvij
  rcases lt_or_gt_of_ne hij with hlt | hgt
  · obtain ⟨e, rfl⟩ : ∃ e, j = i + e := ⟨j - i, by omega⟩
    refine ⟨e, by omega, p.coeff i / p.coeff (i + e), div_ne_zero hci hcj, ?_⟩
    rw [map_div₀, map_div₀]
    exact pow_eq_div_of_mul_pow_eq (valuation_algebraMap_ne_zero v hcj) hva hvij.symm
  · obtain ⟨e, rfl⟩ : ∃ e, i = j + e := ⟨i - j, by omega⟩
    refine ⟨e, by omega, p.coeff j / p.coeff (j + e), div_ne_zero hcj hci, ?_⟩
    rw [map_div₀, map_div₀]
    exact pow_eq_div_of_mul_pow_eq (valuation_algebraMap_ne_zero v hci) hva hvij

/-- **An element of a subextension of degree prime to `ℓ` is an element of `K` times an `ℓ`-th
power**, for the fraction field `K` of a strictly henselian valuation ring with `ℓ ∈ Vˣ`. -/
theorem exists_eq_mul_pow_of_le_fixedField {ℓ : ℕ} (hℓ : ℓ.Prime) (hℓV : IsUnit (ℓ : V))
    {H : Subgroup Gal(Ω/K)} (hH : IsMaximalProPSubgroup ℓ H) {a : Ω} (ha : a ≠ 0)
    (hle : K⟮a⟯ ≤ fixedField H) :
    ∃ c : K, c ≠ 0 ∧ ∃ b ∈ K⟮a⟯, a = algebraMap K Ω c * b ^ ℓ := by
  classical
  have : Fact ℓ.Prime := ⟨hℓ⟩
  set v := (ValuationRing.integralClosureValuationSubring V Ω).valuation
  set E := K⟮a⟯
  have hU : ∀ x ∈ E, v x = 1 → ∃ y ∈ E, y ^ ℓ = x := fun x hx hvx ↦
    KummerTower.exists_pow_eq_of_valuation_eq_one v (algebraMap K Ω).fieldRange
      (fun x hx ↦ exists_pow_eq_of_valuation_eq_one V K Ω hℓV hx)
      (E := E.toSubfield) (fun z hz ↦ by
        obtain ⟨c, rfl⟩ := RingHom.mem_fieldRange.mp hz
        exact E.algebraMap_mem c) hx hvx
  have hfd : FiniteDimensional K E := adjoin.finiteDimensional (Algebra.IsIntegral.isIntegral a)
  have hndvd : ¬ ℓ ∣ Module.finrank K E := by
    rw [IntermediateField.finrank_eq_fixingSubgroup_index]
    exact hH.not_dvd_index ((InfiniteGalois.isOpen_iff_finite E).2 inferInstance)
      ((IntermediateField.le_iff_le H E).1 hle)
  have haE : a ∈ E := mem_adjoin_simple_self K a
  have hva : v a ≠ 0 := by rwa [ne_eq, Valuation.zero_iff]
  have hex := exists_valuation_pow_eq K Ω v ha
  set m₀ := Nat.find hex with hm₀
  obtain ⟨hm₀1, c₀, hc₀, hvc₀⟩ := Nat.find_spec hex
  -- `ℓ ∤ m₀`
  have hm₀ℓ : ¬ ℓ ∣ m₀ := by
    rintro ⟨m', hm'⟩
    obtain ⟨hm'1, hm'lt⟩ := pos_and_lt_of_eq_mul_prime hℓ hm₀1 hm'
    set x := a ^ m' with hx
    have hx0 : x ≠ 0 := pow_ne_zero _ ha
    have hxE : x ∈ E := pow_mem haE m'
    have hvx : v x ^ ℓ = v (algebraMap K Ω c₀) := by
      rw [hx, map_pow, ← pow_mul, mul_comm, ← hm', hvc₀]
    have hc₀Ω : algebraMap K Ω c₀ ≠ 0 := (map_ne_zero _).mpr hc₀
    have hvq : v (x ^ ℓ / algebraMap K Ω c₀) = 1 := by
      rw [map_div₀, map_pow, hvx, div_self (valuation_algebraMap_ne_zero v hc₀)]
    obtain ⟨w, hwE, hw⟩ := hU (x ^ ℓ / algebraMap K Ω c₀)
      (div_mem (pow_mem hxE ℓ) (E.algebraMap_mem c₀)) hvq
    have hw0 : w ≠ 0 := by
      rintro rfl
      rw [zero_pow hℓ.ne_zero, eq_comm, div_eq_zero_iff] at hw
      rcases hw with h | h
      · exact hx0 (pow_eq_zero_iff hℓ.ne_zero |>.mp h)
      · exact hc₀Ω h
    have hvw : v w = 1 := eq_one_of_pow_eq_one hℓ.ne_zero (by rw [← map_pow, hw, hvq])
    set z := x / w with hz
    have hzc : z ^ ℓ = algebraMap K Ω c₀ := by
      rw [hz, div_pow, hw, div_div_cancel₀ (pow_ne_zero _ hx0)]
    have hzE : z ∈ E := div_mem hxE hwE
    by_cases hpow : ∃ d : K, d ^ ℓ = c₀
    · obtain ⟨d, rfl⟩ := hpow
      have hd0 : d ≠ 0 := fun h0 ↦ hc₀ (by rw [h0, zero_pow hℓ.ne_zero])
      have hvz : v z = v (algebraMap K Ω d) := by
        have h1 : (z / algebraMap K Ω d) ^ ℓ = 1 := by
          rw [div_pow, hzc, map_pow, div_self (pow_ne_zero _ ((map_ne_zero _).mpr hd0))]
        have h2 := eq_one_of_pow_eq_one hℓ.ne_zero (by rw [← map_pow, h1, map_one] :
          v (z / algebraMap K Ω d) ^ ℓ = 1)
        rw [map_div₀, div_eq_one_iff_eq (valuation_algebraMap_ne_zero v hd0)] at h2
        exact h2
      have : m₀ ≤ m' := Nat.find_min' hex ⟨hm'1, d, hd0, by
        rw [← map_pow, ← hx, show x = z * w by rw [hz, div_mul_cancel₀ x hw0], map_mul, hvw,
          mul_one, hvz]⟩
      omega
    · push Not at hpow
      obtain ⟨ζ, hζ⟩ := exists_isPrimitiveRoot V K hℓV 1
      have hdeg : Module.finrank K K⟮z⟯ = ℓ ^ 1 :=
        Stacks.GaloisCohomology.finrank_adjoin_of_pow_eq hℓ hζ hpow (by rwa [pow_one])
      have hle' : K⟮z⟯ ≤ E := adjoin_simple_le_iff.mpr hzE
      apply hndvd
      rw [← pow_one ℓ, ← hdeg]
      exact IntermediateField.finrank_dvd_of_le_right hle'
  -- Bézout
  obtain ⟨s, t, hst⟩ : ∃ s t : ℕ, s * m₀ = ℓ * t + 1 := by
    have hcop : Nat.Coprime m₀ ℓ :=
      Nat.coprime_comm.1 ((Nat.Prime.coprime_iff_not_dvd hℓ).2 hm₀ℓ)
    obtain ⟨s, -, hs⟩ := Nat.exists_mul_mod_eq_one_of_coprime hcop hℓ.one_lt
    refine ⟨s, s * m₀ / ℓ, ?_⟩
    have := Nat.div_add_mod (s * m₀) ℓ
    rw [mul_comm m₀ s] at hs
    omega
  have hc₀s : c₀ ^ s ≠ 0 := pow_ne_zero _ hc₀
  have hvu : v (a ^ (ℓ * t + 1) / algebraMap K Ω (c₀ ^ s)) = 1 := by
    rw [map_div₀, map_pow, ← hst, mul_comm, pow_mul, hvc₀, map_pow, map_pow, div_self]
    exact pow_ne_zero _ (valuation_algebraMap_ne_zero v hc₀)
  obtain ⟨w, hwE, hw⟩ := hU _ (div_mem (pow_mem haE _) (E.algebraMap_mem _)) hvu
  refine ⟨c₀ ^ s, hc₀s, w / a ^ t, div_mem hwE (pow_mem haE t), ?_⟩
  have hcΩ : algebraMap K Ω (c₀ ^ s) ≠ 0 := (map_ne_zero _).mpr hc₀s
  rw [div_pow, hw, ← pow_mul, mul_comm t ℓ]
  field_simp
  ring

/-- **`Lˣ / Lˣ^ℓ` is generated by the generators of `Kˣ / Kˣ^ℓ`**, for `L` the fixed field of a
maximal pro-`ℓ` subgroup of `Gal(Ω/K)`. -/
theorem kummerGenerated_fixedField {ℓ : ℕ} (hℓ : ℓ.Prime) (hℓV : IsUnit (ℓ : V))
    {H : Subgroup Gal(Ω/K)} (hH : IsMaximalProPSubgroup ℓ H) {d : ℕ}
    (hK : KummerTower.KummerGenerated K ℓ d) :
    KummerTower.KummerGenerated (fixedField H) ℓ d := by
  obtain ⟨π, hπ⟩ := hK
  refine ⟨fun i ↦ algebraMap K (fixedField H) (π i), fun a ha ↦ ?_⟩
  have ha0 : (a : Ω) ≠ 0 := fun h ↦ ha (Subtype.ext h)
  have hle : K⟮(a : Ω)⟯ ≤ fixedField H := adjoin_simple_le_iff.mpr a.2
  obtain ⟨c, hc, b, hb, hab⟩ :=
    exists_eq_mul_pow_of_le_fixedField V K Ω hℓ hℓV hH ha0 hle
  obtain ⟨m, b', hcb⟩ := hπ c hc
  refine ⟨m, ⟨algebraMap K Ω b' * b, mul_mem (IntermediateField.algebraMap_mem _ b')
    (hle hb)⟩, Subtype.ext ?_⟩
  change (a : Ω) = (fixedField H).val (_ * _)
  simp only [map_mul, map_prod, map_pow, AlgHom.commutes, IntermediateField.coe_val]
  rw [hab, hcb]
  simp only [map_mul, map_prod, map_pow]
  ring

end FixedField

end AlgebraicGeometry.ValuationRingFractionField

namespace AlgebraicGeometry.Scheme

attribute [local instance high]
  Stacks.EtaleCohomology.ConstantTransport.hasExt_sheaf_smallEtaleTopology

variable (V : Type u) [CommRing V] [IsDomain V] [ValuationRing V] [StrictlyHenselianLocalRing V]

/-- **Vanishing above the rational rank for sheaves killed by a prime `ℓ` invertible in `V`**, on
the spectrum of the fraction field of a strictly henselian valuation ring `V`. -/
theorem subsingleton_sheafH_fractionRing_of_valuationRing_of_prime {ℓ : ℕ} (hℓ : ℓ.Prime)
    (hℓV : IsUnit (ℓ : V)) {r : ℕ}
    (hrank : Module.rank ℤ (Additive (ValuationRing.ValueGroup V (FractionRing V))ˣ) ≤ r)
    (q : ℕ) (hq : r + 1 ≤ q)
    (G : Sheaf (Spec (.of (FractionRing V))).smallEtaleTopology AddCommGrpCat.{u + 1})
    (hG : ℓ • 𝟙 G = 0) : Subsingleton (Sheaf.H.{u + 1} G q) := by
  set K := FractionRing V
  set Ω := SeparableClosure K
  let : Algebra V Ω := ((algebraMap K Ω).comp (algebraMap V K)).toAlgebra
  have : IsScalarTower V K Ω := IsScalarTower.of_algebraMap_eq' rfl
  have : FaithfulSMul V Ω := (faithfulSMul_iff_algebraMap_injective V Ω).mpr
    ((algebraMap K Ω).injective.comp (IsFractionRing.injective V K))
  have : Algebra.IsAlgebraic V K := IsLocalization.isAlgebraic K (nonZeroDivisors V)
  have : Algebra.IsAlgebraic V Ω := Algebra.IsAlgebraic.trans V K Ω
  have : Fact ℓ.Prime := ⟨hℓ⟩
  obtain ⟨H, hH⟩ := exists_isMaximalProPSubgroup ℓ Gal(Ω/K)
  set L := fixedField H
  obtain ⟨d, hdr, hKd⟩ := ValuationRingFractionField.kummerGenerated_fractionRing V K hℓ hℓV hrank
  have hLd := ValuationRingFractionField.kummerGenerated_fixedField V K Ω hℓ hℓV hH hKd
  have : IsSepClosure L Ω :=
    ⟨IsSepClosure.sep_closed K, Algebra.isSeparable_tower_top_of_isSeparable K L Ω⟩
  have hpro : IsProPGroup ℓ Gal(Ω/L) :=
    StrictlyHenselianKummer.isProPGroup_of_continuousMulEquiv
      (InfiniteGalois.fixedFieldGalContinuousMulEquiv ⟨H, hH.prop.1⟩) hH.prop.2
  have hζL : ∀ e, ∃ ζ : L, IsPrimitiveRoot ζ (ℓ ^ e) := fun e ↦ by
    obtain ⟨ζ, hζ⟩ := ValuationRingFractionField.exists_isPrimitiveRoot V K hℓV e
    exact ⟨_, hζ.map_of_injective (algebraMap K L).injective⟩
  have hS₀ : (algebraMap K Ω).fieldRange ≤ (algebraMap L Ω).fieldRange := fun z hz ↦ by
    obtain ⟨c, rfl⟩ := RingHom.mem_fieldRange.mp hz
    exact RingHom.mem_fieldRange.mpr
      ⟨algebraMap K L c, (IsScalarTower.algebraMap_apply K L Ω c).symm⟩
  have hbound := KummerTower.isTorsionVanishingBound_of_kummerGenerated
    (ValuationRing.integralClosureValuationSubring V Ω).valuation (algebraMap K Ω).fieldRange hℓ
    (fun x hx ↦ ValuationRingFractionField.exists_pow_eq_of_valuation_eq_one V K Ω hℓV hx) d L
    hpro hζL hS₀ hLd
  -- `H^{r+1}_ét(Spec L, ℤ/ℓℤ) = 0`
  set Z : Sheaf (Spec (.of L)).smallEtaleTopology AddCommGrpCat.{u + 1} :=
    (constantSheaf (Spec (.of L)).smallEtaleTopology AddCommGrpCat.{u + 1}).obj
      (AddCommGrpCat.of (ULift.{u + 1} (ZMod ℓ))) with hZ
  have hZℓ : ℓ • 𝟙 Z = 0 := by
    have : (constantSheaf (Spec (.of L)).smallEtaleTopology AddCommGrpCat.{u + 1}).Additive :=
      Functor.additive_of_preserves_binary_products _
    refine nsmul_id_obj_eq_zero _ ?_
    ext x
    simp
  have h3 : Subsingleton (Sheaf.H.{u + 1} Z (r + 1)) :=
    hbound Z ((forall_nsmul_eq_zero_iff_nsmul_id_eq_zero Z).2 hZℓ) (r + 1)
      (by exact_mod_cast Nat.lt_succ_of_le hdr)
  -- Stacks 0DV9
  have h2 := (forall_le_subsingleton_sheafH_iff_of_isMaximalProPSubgroup.{0} K Ω hℓ (r + 1)
    hH).2 h3
  exact h2 q hq G (Stacks.Torsion.isPrimePowerTorsion_of_nsmul_id_eq_zero _ hG)

/-- **Vanishing above the rational rank for sheaves killed by an integer `n` invertible in
`V`**: by induction on `n`, along `0 → 𝓖[ℓ] → 𝓖 → 𝓖/𝓖[ℓ] → 0` for a prime `ℓ ∣ n`. -/
theorem subsingleton_sheafH_fractionRing_of_valuationRing (n : ℕ) (hn : IsUnit (n : V)) {r : ℕ}
    (hrank : Module.rank ℤ (Additive (ValuationRing.ValueGroup V (FractionRing V))ˣ) ≤ r)
    (q : ℕ) (hq : r + 1 ≤ q)
    (G : Sheaf (Spec (.of (FractionRing V))).smallEtaleTopology AddCommGrpCat.{u + 1})
    (hG : n • 𝟙 G = 0) : Subsingleton (Sheaf.H.{u + 1} G q) := by
  induction n using Nat.strong_induction_on generalizing G with
  | _ n ih =>
  rcases Nat.lt_or_ge n 2 with hn2 | hn2
  · interval_cases n
    · exact absurd hn (by simp)
    · rw [one_smul] at hG
      refine ⟨fun a b => ?_⟩
      have hz : ∀ e : Sheaf.H.{u + 1} G q, e = 0 := by
        intro e
        rw [← Abelian.Ext.comp_mk₀_id e, hG, Abelian.Ext.mk₀_zero, Abelian.Ext.comp_zero]
      rw [hz a, hz b]
  · set ℓ := n.minFac
    have hℓ : ℓ.Prime := Nat.minFac_prime (by omega)
    obtain ⟨m, hm⟩ := Nat.minFac_dvd n
    obtain ⟨-, hmn⟩ := ValuationRingFractionField.pos_and_lt_of_eq_mul_prime hℓ (by omega) hm
    have hnV : IsUnit ((ℓ : V) * (m : V)) := by rw [← Nat.cast_mul, ← hm]; exact hn
    have hℓV : IsUnit (ℓ : V) := isUnit_of_mul_isUnit_left hnV
    have hmV : IsUnit (m : V) := isUnit_of_mul_isUnit_right hnV
    set φ : G ⟶ G := ℓ • 𝟙 G with hφ
    let S : ShortComplex (Sheaf (Spec (.of (FractionRing V))).smallEtaleTopology
        AddCommGrpCat.{u + 1}) :=
      ShortComplex.mk (kernel.ι φ) (cokernel.π (kernel.ι φ)) (cokernel.condition _)
    have hS : S.ShortExact := ShortComplex.ShortExact.mk'
      (ShortComplex.exact_of_g_is_cokernel S (cokernelIsCokernel _)) inferInstance
      inferInstance
    have h₁ : ℓ • 𝟙 S.X₁ = 0 := by
      refine (cancel_mono (kernel.ι φ)).1 ?_
      rw [Preadditive.nsmul_comp, Category.id_comp, zero_comp]
      have : kernel.ι φ ≫ φ = 0 := kernel.condition φ
      rw [hφ, Preadditive.comp_nsmul, Category.comp_id] at this
      exact this
    have h₃ : m • 𝟙 S.X₃ = 0 := by
      refine (cancel_epi (cokernel.π (kernel.ι φ))).1 ?_
      rw [Preadditive.comp_nsmul, Category.comp_id, comp_zero]
      have hfac : (m • 𝟙 G) ≫ φ = 0 := by
        rw [Preadditive.nsmul_comp, Category.id_comp, hφ, smul_smul, mul_comm, ← hm, hG]
      have h1 : m • cokernel.π (kernel.ι φ) = (m • 𝟙 G) ≫ cokernel.π (kernel.ι φ) := by
        rw [Preadditive.nsmul_comp, Category.id_comp]
      rw [h1, ← kernel.lift_ι φ (m • 𝟙 G) hfac, Category.assoc, cokernel.condition, comp_zero]
    have := subsingleton_sheafH_fractionRing_of_valuationRing_of_prime V hℓ hℓV hrank q hq
      S.X₁ h₁
    have := ih m hmn hmV S.X₃ h₃
    exact subsingleton_ext_X₂_of_shortExact_of_subsingleton _ hS q inferInstance inferInstance

/-- **The fraction field of a strictly henselian valuation ring has `n`-cohomological dimension
at most the rational rank of its value group**, for every `n` invertible in the ring (Travaux de
Gabber XVIII-A, closing Remark: Gabber's Zariski–Riemann proof of Corollary 1.2). The rank is
`Module.rank ℤ` of the (torsion-free) value group, which is its rational rank
`dim_ℚ (Γ ⊗ ℚ)`. -/
theorem isTorsionVanishingBound_spec_fractionRing_of_valuationRing {n r : ℕ}
    (hn : IsUnit (n : V))
    (hrank : Module.rank ℤ (Additive (ValuationRing.ValueGroup V (FractionRing V))ˣ) ≤ r) :
    IsTorsionVanishingBound (Spec (.of (FractionRing V))) n r := by
  intro G hG p hp
  have hp' : r + 1 ≤ p := by
    have : ((r : ℕ) : WithBot ℕ∞) < (p : WithBot ℕ∞) := hp
    have : r < p := by exact_mod_cast this
    omega
  exact subsingleton_sheafH_fractionRing_of_valuationRing V n hn hrank p hp' G
    ((forall_nsmul_eq_zero_iff_nsmul_id_eq_zero G).1 hG)

end AlgebraicGeometry.Scheme

