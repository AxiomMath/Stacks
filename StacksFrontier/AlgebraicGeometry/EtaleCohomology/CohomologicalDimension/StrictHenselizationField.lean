/-!
# A separably closed field of the right transcendence degree in a strict henselization

Let `Y` be a scheme locally of finite type over a field `K`, `s` a geometric point of `Y` with
image `y`, and `b = trdeg_K κ(y)`. The strict henselization `𝒪^{sh}_{Y,s}` contains a separably
closed field `L ⊇ K` of transcendence degree at least `b` over `K`, namely a separable closure of
`K(t_1, …, t_b)`, where the `t_i` lift a transcendence basis of `κ(y)` ([Stacks, Tag 0F0U]). The
elements of `L` are moreover algebraic, with a nonzero leading coefficient from `L`, over the
subring generated by `K` and the finitely many `t_i`. This is the field the proof of
[Stacks, Tag 0F0X] applies [Stacks, Tag 0F0W] over.

The strict henselization maps to every affine open `V` around `y`, by a morphism which is
ind-étale on global sections.

## Main results

* `AlgebraicGeometry.strictHenselizationToBase_appTop_ΓSpecIso_hom`: global sections of the
  strict henselization, read in the étale local ring.
* `AlgebraicGeometry.exists_lift_ind_etale_appTop_strictHenselizationToBase`: the strict
  henselization factors through every affine open around the point, ind-étale on global
  sections.
* `AlgebraicGeometry.exists_sepClosed_field_strictHenselization`: the field `L` above.

## References

* [Stacks Project, Tag 0F0U](https://stacks.math.columbia.edu/tag/0F0U)
* [Stacks Project, Tag 0F0X](https://stacks.math.columbia.edu/tag/0F0X)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing Polynomial

universe u

/-- An algebraic element `ℓ` of a field `L` over a domain `A` embedded in `L`, mapped along
`ψ : L →+* O`, is a root of a polynomial over `A` with leading coefficient in `ψ(L ∖ 0)`. -/
private theorem IsAlgebraic.exists_map_comp_leadingCoeff_eq_eval_eq_zero {A L O : Type*}
    [CommRing A] [IsDomain A] [Field L] [CommRing O] [Nontrivial O] [Algebra A L]
    (ψ : L →+* O) (hinj : Function.Injective (algebraMap A L)) {ℓ : L} (hℓ : IsAlgebraic A ℓ) :
    ∃ r : A[X], (∃ c : L, c ≠ 0 ∧ (r.map (ψ.comp (algebraMap A L))).leadingCoeff = ψ c) ∧
      (r.map (ψ.comp (algebraMap A L))).eval (ψ ℓ) = 0 := by
  obtain ⟨a, ha0, q, hqmon, hq⟩ := hℓ.exists_integral_multiple
  have hdeg : (Polynomial.C a * Polynomial.X : A[X]).natDegree ≠ 0 := by
    rw [natDegree_C_mul_X a ha0]
    exact one_ne_zero
  refine ⟨q.comp (Polynomial.C a * Polynomial.X), ⟨algebraMap A L (a ^ q.natDegree),
    (map_ne_zero_iff _ hinj).2 (pow_ne_zero _ ha0), ?_⟩, ?_⟩
  · rw [leadingCoeff_map_of_injective (f := ψ.comp (algebraMap A L)) (ψ.injective.comp hinj),
      leadingCoeff_comp hdeg, hqmon.leadingCoeff, one_mul, leadingCoeff_C_mul_X]
    rfl
  · rw [eval_map, ← hom_eval₂, eval₂_comp, eval₂_mul, eval₂_C, eval₂_X, ← Algebra.smul_def, hq,
      map_zero]

/-- The image of a ring map out of `MvPolynomial ι R` lies in the subring generated by the images
of the variables and of the constants. -/
private theorem MvPolynomial.map_mem_closure_range_X_union_range_C {ι R S : Type*}
    [CommSemiring R] [CommRing S] (f : MvPolynomial ι R →+* S) (p : MvPolynomial ι R) :
    f p ∈ Subring.closure
      (Set.range (f ∘ MvPolynomial.X) ∪ Set.range (f.comp MvPolynomial.C)) := by
  induction p using MvPolynomial.induction_on with
  | C r => exact Subring.subset_closure (Or.inr ⟨r, rfl⟩)
  | add p q hp hq => simpa only [map_add] using Subring.add_mem _ hp hq
  | mul_X p i hp =>
    rw [map_mul]
    exact Subring.mul_mem _ hp (Subring.subset_closure (Or.inl ⟨i, rfl⟩))

namespace AlgebraicGeometry

variable (B : BigEtaleSite.{u})

/-- **The strict henselization maps into every affine open around the point, ind-étale on global
sections.** Let `s` be a geometric point of `Y` and `V` an affine open of `Y` containing its image
`y`. Then `Spec 𝒪^{sh}_{Y,s} ⟶ Y` factors through `V` by a morphism `l` whose ring map
`Γ(V) ⟶ Γ(Spec 𝒪^{sh}_{Y,s})` is a filtered colimit of étale ring maps: up to the identification
`V ≅ Spec Γ(Y, V)`, `l` is the spectrum of the germ map `Γ(Y, V) ⟶ 𝒪_{Y,y}`, a localization at a
prime, followed by the ind-étale map `𝒪_{Y,y} ⟶ 𝒪^{sh}_{Y,s}`. -/
public theorem exists_lift_ind_etale_appTop_strictHenselizationToBase {Y : Scheme.{u}}
    (hS : B.Contains Y) (s : GeometricPoint Y) (V : Y.Opens) (hV : IsAffineOpen V)
    (hy : s.hom (closedPoint s.residueField) ∈ V) :
    ∃ l : strictHenselization B Y hS s ⟶ V.toScheme,
      l ≫ V.ι = strictHenselizationToBase B Y hS s ∧
        MorphismProperty.ind.{u} CommRingCat.etale.{u} l.appTop := by
  set y := s.hom (closedPoint s.residueField)
  let φ := CommRingCat.ofHom (structureSheafStalkFromLocalRing B Y hS s)
  let P := MorphismProperty.ind.{u} CommRingCat.etale.{u}
  refine ⟨Spec.map φ ≫ V.fromSpecStalkOfMem y hy, ?_, ?_⟩
  · rw [Category.assoc, Scheme.Opens.fromSpecStalkOfMem_ι]
    rfl
  -- the germ map `Γ(Y, V) ⟶ 𝒪_{Y,y}` is a localization at a prime
  have hgerm : P (Y.presheaf.germ V y hy) := by
    let : Algebra Γ(Y, V) (Y.presheaf.stalk y) := Y.presheaf.algebra_section_stalk ⟨y, hy⟩
    let : IsLocalization.AtPrime (Y.presheaf.stalk y) (hV.primeIdealOf ⟨y, hy⟩).asIdeal :=
      hV.isLocalization_stalk ⟨y, hy⟩
    exact CommAlgCat.ind_etale_iff_ind_algebraMap.mp (CommAlgCat.ind_etale_atPrime Γ(Y, V)
      (Y.presheaf.stalk y) (hV.primeIdealOf ⟨y, hy⟩).asIdeal)
  -- the map `𝒪_{Y,y} ⟶ 𝒪^{sh}_{Y,s}` is ind-étale
  have hsh : P φ := by
    exact CommAlgCat.ind_etale_iff_ind_algebraMap.mp
      (StacksDraft.indEtale_iff.mp (indEtale_etaleLocalRing B Y hS s))
  have hnat : (Spec.map (Y.presheaf.germ V y hy ≫ φ)).appTop =
      (Scheme.ΓSpecIso _).hom ≫ (Y.presheaf.germ V y hy ≫ φ) ≫ (Scheme.ΓSpecIso _).inv := by
    rw [← Category.assoc, ← Scheme.ΓSpecIso_naturality, Category.assoc, Iso.hom_inv_id,
      Category.comp_id]
  have h₁ : P (Spec.map (Y.presheaf.germ V y hy ≫ φ)).appTop := by
    rw [hnat]
    refine (MorphismProperty.cancel_left_of_respectsIso P _ _).mpr ?_
    refine (MorphismProperty.cancel_right_of_respectsIso P _ _).mpr ?_
    exact CommRingCat.ind_etale_comp _ _ hgerm hsh
  -- `l` followed by the isomorphism `V ≅ Spec Γ(Y, V)` is the spectrum of `germ ≫ φ`
  have hcomp : (Spec.map φ ≫ V.fromSpecStalkOfMem y hy) ≫ V.toSpecΓ =
      Spec.map (Y.presheaf.germ V y hy ≫ φ) := by
    rw [Category.assoc, Scheme.Opens.fromSpecStalkOfMem_toSpecΓ, ← Spec.map_comp]
  rw [← hcomp, Scheme.Hom.comp_appTop] at h₁
  have : IsIso V.toSpecΓ := by
    rw [← hV.isoSpec_hom]
    infer_instance
  have : IsIso V.toSpecΓ.appTop := inferInstanceAs (IsIso (V.toSpecΓ.app ⊤))
  exact (MorphismProperty.cancel_left_of_respectsIso P _ _).mp h₁

/-- **Global sections of the strict henselization, read in the étale local ring.** For a geometric
point `s` of `Y` with image `y`, the ring map `Γ(Y) ⟶ Γ(Spec 𝒪^{sh}_{Y,s}) ≅ 𝒪^{sh}_{Y,s}` is the
germ at `y` followed by the canonical map `𝒪_{Y,y} ⟶ 𝒪^{sh}_{Y,s}`. -/
public theorem strictHenselizationToBase_appTop_ΓSpecIso_hom {Y : Scheme.{u}} (hS : B.Contains Y)
    (s : GeometricPoint Y) :
    (strictHenselizationToBase B Y hS s).appTop ≫ (Scheme.ΓSpecIso _).hom =
      Y.presheaf.germ ⊤ (s.hom (closedPoint s.residueField)) trivial ≫
        CommRingCat.ofHom (structureSheafStalkFromLocalRing B Y hS s) := by
  rw [strictHenselizationToBase, Scheme.Hom.comp_appTop, Category.assoc,
    Scheme.ΓSpecIso_naturality, Scheme.fromSpecStalk_appTop]
  simp only [homOfLE_refl, op_id, CategoryTheory.Functor.map_id, Category.comp_id,
    Category.assoc]
  congr 1
  exact Iso.inv_hom_id_assoc (Scheme.ΓSpecIso _) _

/-- If the residues of `z : ι → O` in a local `K`-algebra `O` are the images of algebraically
independent elements of a field, then `X_i ↦ z_i` extends to `K(X_i : i ∈ ι) →+* O`. -/
private theorem exists_ringHom_fractionRing_mvPolynomial_of_residue {ι K F O : Type*} [Field K]
    [Field F] [CommRing O] [IsLocalRing O] [Algebra K F] [Algebra K O] (z : ι → O) (x : ι → F)
    (hx : AlgebraicIndependent K x) (ρ : F →+* ResidueField O)
    (hρ : ∀ k, ρ (algebraMap K F k) = residue O (algebraMap K O k))
    (hz : ∀ i, residue O (z i) = ρ (x i)) :
    ∃ ψ : FractionRing (MvPolynomial ι K) →+* O,
      ∀ a : MvPolynomial ι K, ψ (algebraMap _ _ a) = MvPolynomial.aeval z a := by
  have hcomp : (residue O).comp (MvPolynomial.aeval z).toRingHom =
      ρ.comp (MvPolynomial.aeval x).toRingHom :=
    MvPolynomial.ringHom_ext (fun k : K => by simp [hρ]) fun i => by simp [hz]
  have hunit (a : nonZeroDivisors (MvPolynomial ι K)) :
      IsUnit ((MvPolynomial.aeval z).toRingHom a.1) := by
    refine (residue_ne_zero_iff_isUnit _).1 fun h₀ => nonZeroDivisors.ne_zero a.2 ?_
    refine algebraicIndependent_iff_injective_aeval.mp hx (ρ.injective ?_)
    rw [map_zero, map_zero, ← h₀]
    exact (DFunLike.congr_fun hcomp a.1).symm
  exact ⟨IsLocalization.lift hunit, fun a => IsLocalization.lift_eq hunit a⟩

/-- The rational function field `K(X_i : i ∈ ι)` has transcendence degree at least `#ι` over `K`,
and so has every field extension of it. -/
private theorem cardinalMk_le_trdeg_of_fractionRing_mvPolynomial {ι K L : Type u} [Field K]
    [Field L] [Algebra K L] [Algebra (FractionRing (MvPolynomial ι K)) L]
    [IsScalarTower K (FractionRing (MvPolynomial ι K)) L] :
    Cardinal.mk ι ≤ Algebra.trdeg K L := by
  let A := MvPolynomial ι K
  let E := FractionRing A
  have heq : (MvPolynomial.aeval (fun i => algebraMap E L (algebraMap A E (MvPolynomial.X i))) :
      A →ₐ[K] L) = (IsScalarTower.toAlgHom K E L).comp (IsScalarTower.toAlgHom K A E) :=
    MvPolynomial.algHom_ext fun i => by rw [MvPolynomial.aeval_X]; rfl
  refine AlgebraicIndependent.cardinalMk_le_trdeg
    (x := fun i => algebraMap E L (algebraMap A E (MvPolynomial.X i))) ?_
  rw [algebraicIndependent_iff_injective_aeval, heq]
  exact (algebraMap E L).injective.comp (IsFractionRing.injective A E)

/-- **A separably closed field over `K(X_i : i ∈ ι)` in a strictly henselian local ring.** Given
`ψE : K(X_i : i ∈ ι) →+* O` extending `X_i ↦ z_i`, a separable closure `L` of `K(X_i : i ∈ ι)`
maps to `O` over `K`, has transcendence degree at least `#ι` over `K`, and every element of `L`
maps to a root of a polynomial with coefficients in the subring generated by the `z_i` and `K`,
and leading coefficient in the image of `L ∖ 0`. -/
private theorem exists_sepClosed_field_of_fractionRing_mvPolynomial {ι K O : Type u} [Field K]
    [CommRing O] [_root_.StrictlyHenselianLocalRing O] [Algebra K O] (z : ι → O)
    (ψE : FractionRing (MvPolynomial ι K) →+* O)
    (hψE : ∀ a : MvPolynomial ι K, ψE (algebraMap _ _ a) = MvPolynomial.aeval z a) :
    ∃ (L : Type u) (_ : Field L) (_ : IsSepClosed L) (_ : Algebra K L) (ψ : L →+* O),
      ψ.comp (algebraMap K L) = algebraMap K O ∧ Cardinal.mk ι ≤ Algebra.trdeg K L ∧
      ∀ ℓ : L, ∃ p : O[X],
        (∀ n, p.coeff n ∈ Subring.closure (Set.range z ∪ Set.range (ψ.comp (algebraMap K L)))) ∧
        (∃ c : L, c ≠ 0 ∧ p.leadingCoeff = ψ c) ∧ p.eval (ψ ℓ) = 0 := by
  let A := MvPolynomial ι K
  let E := FractionRing A
  let : Algebra E O := ψE.toAlgebra
  obtain ⟨e⟩ := exists_algHom_separableClosure_of_henselianLocalRing E O
  let L := SeparableClosure E
  let : Algebra K L := ((algebraMap E L).comp (algebraMap K E)).toAlgebra
  let : Algebra A L := ((algebraMap E L).comp (algebraMap A E)).toAlgebra
  have : IsScalarTower A E L := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsScalarTower K E L := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : Algebra.IsAlgebraic A E :=
    IsLocalization.isAlgebraic (R := A) (S := E) (nonZeroDivisors A)
  have hAE : ∀ a : A, e (algebraMap A L a) = MvPolynomial.aeval z a := by
    intro a
    change e (algebraMap E L (algebraMap A E a)) = _
    rw [e.commutes]
    exact hψE a
  have hKA : ∀ k : K, algebraMap K L k = algebraMap A L (MvPolynomial.C k) := by
    intro k
    change algebraMap E L (algebraMap K E k) = algebraMap E L (algebraMap A E (MvPolynomial.C k))
    rw [IsScalarTower.algebraMap_apply K A E]
    rfl
  refine ⟨L, inferInstance, inferInstance, inferInstance, e.toRingHom, ?_,
    cardinalMk_le_trdeg_of_fractionRing_mvPolynomial, fun ℓ => ?_⟩
  · ext k
    simp only [RingHom.coe_comp, Function.comp_apply, AlgHom.toRingHom_eq_coe,
      RingHom.coe_coe]
    rw [hKA, hAE, MvPolynomial.aeval_C]
  have hℓ : IsAlgebraic A ℓ := (Algebra.IsAlgebraic.isAlgebraic (R := E) ℓ).restrictScalars A
  have hinjA : Function.Injective (algebraMap A L) :=
    (algebraMap E L).injective.comp (IsFractionRing.injective A E)
  obtain ⟨r, hc, hr⟩ :=
    hℓ.exists_map_comp_leadingCoeff_eq_eval_eq_zero (e.toRingHom : L →+* O) hinjA
  let ψA : A →+* O := (e.toRingHom : L →+* O).comp (algebraMap A L)
  refine ⟨r.map ψA, fun n => ?_, hc, hr⟩
  -- the coefficients come from `K[X_1, …, X_b]`
  rw [Polynomial.coeff_map]
  refine Subring.closure_mono (Set.union_subset_union ?_ ?_)
    (MvPolynomial.map_mem_closure_range_X_union_range_C ψA _)
  · rintro _ ⟨i, rfl⟩
    exact ⟨i, ((hAE _).trans (MvPolynomial.aeval_X z i)).symm⟩
  · rintro _ ⟨k, rfl⟩
    exact ⟨k, congrArg e (hKA k)⟩

/-- **A separably closed field of transcendence degree at least `trdeg_K κ(y)` in the strict
henselization** ([Stacks, Tag 0F0U]). Let `Y` be a scheme locally of finite type over a field `K`,
`s` a geometric point of `Y` with image `y`. There are a separably closed field `L` over `K`, a
map `ψ : L → 𝒪^{sh}_{Y,s}` of `K`-algebras and a finite set `T₀ ⊆ 𝒪^{sh}_{Y,s}` such that
`trdeg_K κ(y) ≤ trdeg_K L` and every element of `L` is mapped to a root of a polynomial whose
coefficients lie in the subring generated by `T₀` and `K`, and whose leading coefficient lies in
`ψ(L ∖ 0)`.

Lift a transcendence basis `x_1, …, x_b` of `κ(y)` over `K` to elements `t_i` of `𝒪^{sh}_{Y,s}`;
a nonzero polynomial in the `t_i` has nonzero residue, hence is a unit, so
`K(X_1, …, X_b) → 𝒪^{sh}_{Y,s}`, `X_i ↦ t_i`, exists, and a separable closure `L` of
`K(X_1, …, X_b)` maps to `𝒪^{sh}_{Y,s}` over it, the latter being strictly henselian. Take
`T₀ = {t_1, …, t_b}`; an element of `L` is algebraic over `K(X_1, …, X_b)`, hence a root of a
polynomial over `K[X_1, …, X_b]` with leading coefficient a nonzero power. -/
public theorem exists_sepClosed_field_strictHenselization {K : Type u} [Field K] {Y : Scheme.{u}}
    (hS : B.Contains Y) (s : GeometricPoint Y) (gY : Y ⟶ Spec (.of K)) [LocallyOfFiniteType gY] :
    letI : Algebra K (Y.residueField (s.hom (closedPoint s.residueField))) :=
      ((Scheme.ΓSpecIso (.of K)).inv ≫ gY.appTop ≫
        Y.Γevaluation (s.hom (closedPoint s.residueField))).hom.toAlgebra
    ∃ (L : Type u) (_ : Field L) (_ : IsSepClosed L) (_ : Algebra K L)
      (ψ : L →+* ↥(etaleLocalRing B Y hS s)) (T₀ : Set ↥(etaleLocalRing B Y hS s)),
      T₀.Finite ∧
      ψ.comp (algebraMap K L) = ((Scheme.ΓSpecIso (.of K)).inv ≫ gY.appTop ≫
        (strictHenselizationToBase B Y hS s).appTop ≫ (Scheme.ΓSpecIso _).hom).hom ∧
      Algebra.trdeg K (Y.residueField (s.hom (closedPoint s.residueField))) ≤
        Algebra.trdeg K L ∧
      ∀ ℓ : L, ∃ p : (↥(etaleLocalRing B Y hS s))[X],
        (∀ n, p.coeff n ∈ Subring.closure (T₀ ∪ Set.range (ψ.comp (algebraMap K L)))) ∧
        (∃ c : L, c ≠ 0 ∧ p.leadingCoeff = ψ c) ∧ p.eval (ψ ℓ) = 0 := by
  classical
  set y := s.hom (closedPoint s.residueField)
  let O := ↥(etaleLocalRing B Y hS s)
  let φ := structureSheafStalkFromLocalRing B Y hS s
  let σ : K →+* O := ((Scheme.ΓSpecIso (.of K)).inv ≫ gY.appTop ≫
    (strictHenselizationToBase B Y hS s).appTop ≫ (Scheme.ΓSpecIso _).hom).hom
  let : Algebra K (Y.residueField y) :=
    ((Scheme.ΓSpecIso (.of K)).inv ≫ gY.appTop ≫ Y.Γevaluation y).hom.toAlgebra
  let : Algebra K O := σ.toAlgebra
  let : Algebra K (ResidueField O) := ((residue O).comp (algebraMap K O)).toAlgebra
  have : FinTrdeg K (Y.residueField y) := residueField_finTrdeg K gY y
  obtain ⟨ι, x, hx⟩ := exists_isTranscendenceBasis' K (Y.residueField y)
  have : Finite ι := finite_of_isTranscendenceBasis hx
  -- `κ(y)` embeds into the residue field of `O`
  have : IsLocalHom φ := isLocalHom_algebraMap_etaleLocalRing B Y hS s
  let ρ : Y.residueField y →ₐ[K] ResidueField O :=
    { toRingHom := ResidueField.map φ
      commutes' := fun k => by
        change ResidueField.map φ (residue _ (Y.presheaf.germ ⊤ y trivial
            (gY.appTop ((Scheme.ΓSpecIso (.of K)).inv k)))) =
          residue O (((strictHenselizationToBase B Y hS s).appTop ≫
            (Scheme.ΓSpecIso _).hom) (gY.appTop ((Scheme.ΓSpecIso (.of K)).inv k)))
        rw [ResidueField.map_residue, strictHenselizationToBase_appTop_ΓSpecIso_hom B hS s]
        rfl }
  -- lift the transcendence basis
  let z : ι → O := fun i => (residue_surjective (ρ (x i))).choose
  have hz : ∀ i, residue O (z i) = ρ (x i) := fun i => (residue_surjective (ρ (x i))).choose_spec
  -- the rational function field and its separable closure
  obtain ⟨ψE, hψE⟩ :=
    exists_ringHom_fractionRing_mvPolynomial_of_residue z x hx.1 ρ.toRingHom ρ.commutes hz
  have := etaleLocalRing_strictHenselian B Y hS s
  obtain ⟨L, iF, iS, iA, ψ, hσ, hL, hp⟩ :=
    exists_sepClosed_field_of_fractionRing_mvPolynomial z ψE hψE
  -- `trdeg_K κ(y) = #ι ≤ trdeg_K L`
  exact ⟨L, iF, iS, iA, ψ, Set.range z, Set.finite_range z, hσ,
    hx.cardinalMk_eq_trdeg.symm.le.trans hL, hp⟩

end AlgebraicGeometry

end
