attribute [local instance high]
  Stacks.EtaleCohomology.ConstantTransport.hasExt_sheaf_smallEtaleTopology

section LocalRing

variable (B : BigEtaleSite.{u}) {X : Scheme.{u}} (hS : B.Contains X) (s : GeometricPoint X)

/-- **The strict henselization of a Noetherian local ring is Noetherian** (Stacks 06LJ), for the
étale local ring at a geometric point. -/
theorem isNoetherianRing_etaleLocalRing_of_stalk
    [IsNoetherianRing ↥(X.presheaf.stalk (s.hom (closedPoint s.residueField)))] :
    IsNoetherianRing ↥(etaleLocalRing B X hS s) :=
  IsLocalRing.isNoetherianRing_of_isHenselization
    (A := ↥(X.presheaf.stalk (s.hom (closedPoint s.residueField))))
    (ResidueField ↥(etaleLocalRing B X hS s))

/-- **Strict henselization does not raise the Krull dimension** (half of Stacks 06LK): the étale
local ring is ind-étale over the local ring at the image of the geometric point. -/
theorem ringKrullDim_etaleLocalRing_le_stalk :
    ringKrullDim ↥(etaleLocalRing B X hS s) ≤
      ringKrullDim ↥(X.presheaf.stalk (s.hom (closedPoint s.residueField))) :=
  ringKrullDim_le_of_ind_etale _ _ (StacksDraft.indEtale_iff.mp (indEtale_etaleLocalRing B X hS s))

/-- **The maximal ideal of the étale local ring is generated by that of the local ring**
(Stacks 07QM). -/
theorem map_maximalIdeal_stalk_eq_maximalIdeal_etaleLocalRing :
    (maximalIdeal ↥(X.presheaf.stalk (s.hom (closedPoint s.residueField)))).map
        (algebraMap _ ↥(etaleLocalRing B X hS s)) =
      maximalIdeal ↥(etaleLocalRing B X hS s) :=
  (faithfullyFlat_and_map_maximalIdeal_of_isHenselization
    (L := ResidueField ↥(etaleLocalRing B X hS s))).2

/-- **Only the closed point of the strict henselization lies over the image of the geometric
point**: a prime of the étale local ring contracting to the maximal ideal of the local ring
contains the ideal that maximal ideal generates, which is the maximal ideal (Stacks 07QM). -/
theorem eq_closedPoint_of_strictHenselizationToBase_eq (p : strictHenselization B X hS s)
    (hp : strictHenselizationToBase B X hS s p = s.hom (closedPoint s.residueField)) :
    p = closedPoint ↥(etaleLocalRing B X hS s) := by
  set x := s.hom (closedPoint s.residueField)
  let φ := structureSheafStalkFromLocalRing B X hS s
  have h1 : Spec.map (CommRingCat.ofHom φ) p = closedPoint ↥(X.presheaf.stalk x) := by
    apply (X.fromSpecStalk x).isEmbedding.injective
    rw [Scheme.fromSpecStalk_closedPoint]
    exact hp
  have h2 : (p.asIdeal).comap φ = maximalIdeal ↥(X.presheaf.stalk x) :=
    congrArg PrimeSpectrum.asIdeal h1
  have hle : maximalIdeal ↥(etaleLocalRing B X hS s) ≤ p.asIdeal := by
    rw [← map_maximalIdeal_stalk_eq_maximalIdeal_etaleLocalRing B hS s, Ideal.map_le_iff_le_comap]
    exact h2.ge
  apply PrimeSpectrum.ext
  exact ((maximalIdeal.isMaximal _).eq_of_le p.isPrime.ne_top hle).symm

end LocalRing

section BaseChange

variable (B : BigEtaleSite.{u}) {X : Scheme.{u}} (hS : B.Contains X) (s : GeometricPoint X)
  (U : X.Opens)

/-- **The base change of an open immersion to the strict henselization at a maximal point of the
complement is the punctured spectrum.** If the image `η` of `s` is not in `U` and is maximal in
`X ∖ U`, the points of `Spec(𝒪^{sh}_{X,s})` lying over `U` are exactly those other than the
closed point. -/
theorem range_strictHenselizationBaseChangeToStrictHenselization_opensι
    (hηU : s.hom (closedPoint s.residueField) ∉ U)
    (hmax : ∀ x : X, s.hom (closedPoint s.residueField) ∈ closure ({x} : Set X) → x ∉ U →
      x = s.hom (closedPoint s.residueField)) :
    Set.range (strictHenselizationBaseChangeToStrictHenselization B hS U.ι s) =
      Set.range (Stacks.puncturedSpectrum ↥(etaleLocalRing B X hS s)).ι := by
  change Set.range (pullback.snd U.ι (strictHenselizationToBase B X hS s)) = _
  rw [Scheme.Pullback.range_snd, Scheme.Opens.range_ι, Scheme.Opens.range_ι]
  ext p
  simp only [Set.mem_preimage, SetLike.mem_coe]
  constructor
  · rintro hp rfl
    exact hηU (strictHenselizationToBase_closedPoint B X hS s ▸ hp)
  · intro hp
    by_contra hpU
    have hsp : strictHenselizationToBase B X hS s p ⤳ s.hom (closedPoint s.residueField) := by
      rw [← strictHenselizationToBase_closedPoint B X hS s]
      exact (IsLocalRing.specializes_closedPoint p).map
        (strictHenselizationToBase B X hS s).continuous
    exact hp (eq_closedPoint_of_strictHenselizationToBase_eq B hS s p
      (hmax _ (specializes_iff_mem_closure.1 hsp) hpU))

/-- **The isomorphism `U ×_X Spec(𝒪^{sh}_{X,s}) ≅ Spec(𝒪^{sh}_{X,s}) ∖ {𝔪}`** at a maximal point
of the complement of `U`. -/
def strictHenselizationBaseChangeOpensιIsoPuncturedSpectrum
    (hηU : s.hom (closedPoint s.residueField) ∉ U)
    (hmax : ∀ x : X, s.hom (closedPoint s.residueField) ∈ closure ({x} : Set X) → x ∉ U →
      x = s.hom (closedPoint s.residueField)) :
    strictHenselizationBaseChange B hS U.ι s ≅
      (Stacks.puncturedSpectrum ↥(etaleLocalRing B X hS s)).toScheme :=
  IsOpenImmersion.isoOfRangeEq _ _
    (range_strictHenselizationBaseChangeToStrictHenselization_opensι B hS s U hηU hmax)

end BaseChange

namespace Scheme

variable {n : ℕ}

/-- **The punctured spectrum of a local ring of dimension zero has no cohomology**: it is empty,
every prime being maximal. -/
theorem isTorsionVanishingBound_puncturedSpectrum_of_ringKrullDim_eq_zero (A : Type u)
    [CommRing A] [IsLocalRing A] (hA : ringKrullDim A = 0) :
    IsTorsionVanishingBound (Stacks.puncturedSpectrum A).toScheme n ⊥ := by
  have : Ring.KrullDimLE 0 A := Ring.krullDimLE_iff.2 (by rw [hA]; rfl)
  refine @isTorsionVanishingBound_of_disjoint_cover (Stacks.puncturedSpectrum A).toScheme Empty _
    (fun k => k.elim) (fun k => k.elim) (fun k => k.elim) (fun k => k.elim) ?_ n ⊥
    (fun k => k.elim)
  rw [Set.iUnion_of_empty, eq_comm, Set.univ_eq_empty_iff]
  refine ⟨fun x => x.2 ?_⟩
  exact PrimeSpectrum.ext (IsLocalRing.eq_maximalIdeal (x.1.isPrime.isMaximal'))

/-- **The punctured bound at the strict henselization.** Under
`PuncturedSpectrumVanishingBound n`, if the local ring at the image of `s` is Noetherian and
`n` is invertible in the étale local ring, the cohomology of the punctured spectrum of the étale
local ring with coefficients killed by `n` vanishes in degrees `m ≥ 2 dim 𝒪_{X,η}`. -/
theorem exists_isTorsionVanishingBound_puncturedSpectrum_etaleLocalRing
    (h : PuncturedSpectrumVanishingBound.{u} n) (B : BigEtaleSite.{u}) {X : Scheme.{u}}
    (hS : B.Contains X) (s : GeometricPoint X)
    [IsNoetherianRing ↥(X.presheaf.stalk (s.hom (closedPoint s.residueField)))]
    (hn : IsUnit (n : ↥(etaleLocalRing B X hS s))) (m : ℕ)
    (hm : 2 * ringKrullDim ↥(X.presheaf.stalk (s.hom (closedPoint s.residueField))) ≤ m) :
    ∃ d : WithBot ℕ∞, d < m ∧
      IsTorsionVanishingBound (Stacks.puncturedSpectrum ↥(etaleLocalRing B X hS s)).toScheme n
        d := by
  have := isNoetherianRing_etaleLocalRing_of_stalk B hS s
  have := etaleLocalRing_strictHenselian B X hS s
  have hdim := ringKrullDim_etaleLocalRing_le_stalk B hS s
  have h2 : 2 * ringKrullDim ↥(etaleLocalRing B X hS s) ≤ m :=
    (mul_le_mul_of_nonneg_left hdim (by norm_num)).trans hm
  have hnn : 0 ≤ ringKrullDim ↥(etaleLocalRing B X hS s) := ringKrullDim_nonneg_of_nontrivial
  obtain ⟨d, hd⟩ : ∃ d : ℕ, ringKrullDim ↥(etaleLocalRing B X hS s) = d := by
    revert h2 hnn
    generalize ringKrullDim ↥(etaleLocalRing B X hS s) = δ
    intro h2 hnn
    induction δ using WithBot.recBotCoe with
    | bot => exact absurd hnn (not_le.2 (WithBot.bot_lt_coe _))
    | coe y =>
      induction y using ENat.recTopCoe with
      | top =>
        exfalso
        have : (2 : WithBot ℕ∞) * ((⊤ : ℕ∞) : WithBot ℕ∞) = ((⊤ : ℕ∞) : WithBot ℕ∞) := by
          rw [show (2 : WithBot ℕ∞) = ((2 : ℕ∞) : WithBot ℕ∞) from rfl, ← WithBot.coe_mul,
            ENat.mul_top (by norm_num)]
        rw [this] at h2
        exact (not_le.2 (by exact_mod_cast ENat.coe_lt_top m)) h2
      | coe d => exact ⟨d, rfl⟩
  rw [hd] at h2
  have h2' : 2 * d ≤ m := by exact_mod_cast h2
  rcases Nat.eq_zero_or_pos d with hd0 | hdpos
  · subst hd0
    exact ⟨⊥, WithBot.bot_lt_coe _,
      isTorsionVanishingBound_puncturedSpectrum_of_ringKrullDim_eq_zero _ (by exact_mod_cast hd)⟩
  · refine ⟨((2 * d - 1 : ℕ) : WithBot ℕ∞), by exact_mod_cast (by omega : 2 * d - 1 < m), ?_⟩
    exact h _ d hd hdpos hn

/-- **The punctured input of Exposé XVIII-A, Lemma 2.2, from the punctured spectrum bound of
Theorem 1.1.** By the stalk formula for higher direct images (Stacks 03Q9) the stalk of
`R^m j_* 𝓖` at a geometric point `s` over a maximal point `η` of `X ∖ U` is
`H^m(U ×_X Spec(𝒪^{sh}_{X,s}), p⁻¹𝓖)`, and that base change is the punctured spectrum of
`𝒪^{sh}_{X,s}`. -/
theorem puncturedStalkVanishing_of_puncturedSpectrumVanishingBound
    (h : PuncturedSpectrumVanishingBound.{u} n) : PuncturedStalkVanishing.{u} n := by
  intro X _ hn U η hηU hmax G hG m hm s hs
  rw [← hs] at hηU hmax hm
  let B := BigEtaleSite.containing X
  have hS : B.Contains X := BigEtaleSite.contains_containing _
  -- instance search for these goals wanders off in the present import closure
  have : QuasiCompact U.ι := @instQuasiCompactOfIsLocallyNoetherianOfIsOpenImmersion X U.toScheme
    IsNoetherian.toIsLocallyNoetherian U.ι (Scheme.Opens.instIsOpenImmersionι U)
  have : QuasiSeparated U.ι := @IsSeparated.instQuasiSeparated _ _ U.ι
    (@IsSeparated.isSeparated_of_mono _ _ U.ι
      (@IsOpenImmersion.mono _ _ U.ι (Scheme.Opens.instIsOpenImmersionι U)))
  have : IsNoetherianRing ↥(X.presheaf.stalk (s.hom (closedPoint s.residueField))) :=
    @instIsNoetherianRingCarrierStalkCommRingCatPresheafOfIsLocallyNoetherian X
      IsNoetherian.toIsLocallyNoetherian _
  refine (isZero_stalk_rightDerived_iff_subsingleton_sheafH B hS U.ι s G m).2 ?_
  have hnO : IsUnit (n : ↥(etaleLocalRing B X hS s)) := by
    have := hn.map ((structureSheafStalkFromLocalRing B X hS s).comp
      (X.presheaf.germ ⊤ (s.hom (closedPoint s.residueField)) trivial).hom)
    rwa [map_natCast] at this
  obtain ⟨d, hdm, hb⟩ :=
    exists_isTorsionVanishingBound_puncturedSpectrum_etaleLocalRing h B hS s hnO m hm
  have hb' : IsTorsionVanishingBound (strictHenselizationBaseChange B hS U.ι s) n d :=
    IsTorsionVanishingBound.of_iso
      (strictHenselizationBaseChangeOpensιIsoPuncturedSpectrum B hS s U hηU hmax) hb
  have hG' : ∀ (T : (strictHenselizationBaseChange B hS U.ι s).Etale)
      (x : ((etaleAbelianInverseImage.{u, 0} (strictHenselizationBaseChangeToSource B hS U.ι s)).obj
        G).obj.obj (op T)), n • x = 0 :=
    forall_nsmul_eq_zero_etaleAbelianInverseImage _ hG
  have hH : Subsingleton (Sheaf.H.{u + 1}
      ((etaleAbelianInverseImage.{u, 0} (strictHenselizationBaseChangeToSource B hS U.ι s)).obj G)
      m) := hb' _ hG' m hdm
  exact (subsingleton_H_iff_of_iso
    ((smallEtalePullbackAbIsoEtaleAbelianInverseImage
      (strictHenselizationBaseChangeToSource B hS U.ι s)).app G) m).2 hH

end Scheme

end AlgebraicGeometry

