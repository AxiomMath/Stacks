/-!
# Abhyankar's inequality at the center of a valuation ring on a proper model

Let `B` be a Noetherian local domain of dimension `e` with fraction field `K`, `V` a valuation
ring of `K` dominating `B`, and `Y ⟶ Spec B` a proper model of `Spec K` on which `V` has center
`y`. Since `𝒪_{Y,y} ⟶ V` is a local homomorphism over `B`, the residue field `κ(y)` embeds in
`κ(V)` over `κ(B)`, and Abhyankar's inequality
(`Stacks.Abhyankar.rank_valueGroup_add_trdeg_le`) gives

  `rat.rank Γ_V + trdeg_{κ(B)} κ(y) ≤ e`.

For a geometric point `x : Spec Ω ⟶ Spec B` and a point `z` of `Y_Ω = Y ×_{Spec B} Spec Ω`
over `y`, the residue field `κ(z)` is generated by the images of `κ(y)` and `Ω`
(`AlgebraicGeometry.Scheme.closure_range_residueFieldMap_pullback_eq_top`), so
`trdeg_Ω κ(z) ≤ trdeg_{κ(B)} κ(y)`, and the inequality holds with `trdeg_Ω κ(z)`. As the value
group of a valuation ring dominating `B ≠ Frac B` is nontrivial, its rational rank is at least
`1`. Consequently, if `z` lies in no `E_a = {trdeg_Ω κ(z) ≤ a}` with `a + q ≤ e` and
`a + 1 ≤ e`, then every valuation ring of `K` centered at the image of `z` has rational rank
`< q`. This is the transcendence-degree bookkeeping of Gabber's Zariski–Riemann proof of
Exposé XVIII-A, Corollary 1.2: such valuation rings have `cd(Frac V^{sh}) < q`.

## Main results

* `AlgebraicGeometry.Scheme.closure_range_residueFieldMap_pullback_eq_top` — the residue field of
  a point of `X ×_{Spec R} Y` is generated by the images of the residue fields of its
  projections.
* `AlgebraicGeometry.Scheme.ZariskiRiemann.trdeg_le_of_adjoin_range_eq_top` — a field generated
  over `Ω` by the image of a field `K₁ ⊇ k` has transcendence degree over `Ω` at most
  `trdeg_k K₁`.
* `AlgebraicGeometry.Scheme.ZariskiRiemann.ProperModel.rank_valueGroup_add_trdeg_le` —
  `rat.rank Γ_V + trdeg_{κ(B)} κ(y) ≤ e` at the center `y`.
* `AlgebraicGeometry.Scheme.ZariskiRiemann.ProperModel.rank_valueGroup_add_trdeg_pullback_le` —
  `rat.rank Γ_V + trdeg_Ω κ(z) ≤ e` for `z ∈ Y_Ω` over the center.
* `AlgebraicGeometry.Scheme.ZariskiRiemann.one_le_rank_valueGroup` — the rational rank of a
  valuation ring dominating a local domain that is not a field is at least `1`.
* `AlgebraicGeometry.Scheme.ZariskiRiemann.ProperModel.rank_valueGroup_lt_of_not_mem_trdegLESet`
  — off the locus `⋃ {E_a : a + q ≤ e, a + 1 ≤ e}`, centered valuation rings have rational
  rank `< q`.

## References

* Travaux de Gabber sur l'uniformisation locale et la cohomologie étale des schémas
  quasi-excellents, Exposé XVIII-A (L. Illusie), last remark of §2, Astérisque 363–364 (2014)
* S. Abhyankar, *On the valuations centered in a local domain*, Amer. J. Math. 78 (1956)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits IsLocalRing Opposite

universe u

namespace AlgebraicGeometry.Scheme

/-- **The residue field of a point of a fibre product over an affine scheme is generated by the
images of the residue fields of its projections.** For `f : X ⟶ Spec R`, `g : Y ⟶ Spec R` and
`t ∈ X ×_{Spec R} Y`, the subfield of `κ(t)` generated by the images of `κ(pr₁ t)` and
`κ(pr₂ t)` is all of `κ(t)`: the subfield `L` gives a point `Spec L ⟶ X ×_{Spec R} Y` through
which `Spec κ(t) ⟶ X ×_{Spec R} Y` factors, and `Spec κ(t) ⟶ X ×_{Spec R} Y` is a
monomorphism. -/
theorem closure_range_residueFieldMap_pullback_eq_top {X Y : Scheme.{u}} {R : CommRingCat.{u}}
    (f : X ⟶ Spec R) (g : Y ⟶ Spec R) (t : ↥(pullback f g)) :
    Subfield.closure (Set.range ((pullback.fst f g).residueFieldMap t).hom ∪
      Set.range ((pullback.snd f g).residueFieldMap t).hom) = ⊤ := by
  set L := Subfield.closure (Set.range ((pullback.fst f g).residueFieldMap t).hom ∪
      Set.range ((pullback.snd f g).residueFieldMap t).hom) with hL
  let ι : CommRingCat.of L ⟶ (pullback f g).residueField t := CommRingCat.ofHom L.subtype
  let mk : ∀ {W : Scheme.{u}} (p : pullback f g ⟶ W),
      Set.range (p.residueFieldMap t).hom ⊆ L → (Spec (.of L) ⟶ W) := fun p h =>
    Spec.map (CommRingCat.ofHom ((p.residueFieldMap t).hom.codRestrict L fun c => h ⟨c, rfl⟩)) ≫
      Scheme.fromSpecResidueField _ _
  have hmk : ∀ {W : Scheme.{u}} (p : pullback f g ⟶ W) h,
      Spec.map ι ≫ mk p h = (pullback f g).fromSpecResidueField t ≫ p := by
    intro W p h
    have : CommRingCat.ofHom ((p.residueFieldMap t).hom.codRestrict L fun c => h ⟨c, rfl⟩) ≫ ι =
        p.residueFieldMap t := by ext; rfl
    simp only [mk, ← Category.assoc, ← Spec.map_comp, this,
      Hom.SpecMap_residueFieldMap_fromSpecResidueField]
  have h₁ : Set.range ((pullback.fst f g).residueFieldMap t).hom ⊆ L :=
    fun _ hc => Subfield.subset_closure (Or.inl hc)
  have h₂ : Set.range ((pullback.snd f g).residueFieldMap t).hom ⊆ L :=
    fun _ hc => Subfield.subset_closure (Or.inr hc)
  let u := mk _ h₁
  let v := mk _ h₂
  have hu := hmk _ h₁
  have hv := hmk _ h₂
  have huv : u ≫ f = v ≫ g := by
    have h : Spec.map ι ≫ (u ≫ f) = Spec.map ι ≫ (v ≫ g) := by
      rw [← Category.assoc, hu, ← Category.assoc, hv, Category.assoc, Category.assoc,
        pullback.condition]
    rw [← Spec.map_preimage (u ≫ f), ← Spec.map_preimage (v ≫ g), ← Spec.map_comp,
      ← Spec.map_comp] at h
    have h' := Spec.map_injective h
    rw [← Spec.map_preimage (u ≫ f), ← Spec.map_preimage (v ≫ g)]
    congr 1
    ext c
    exact congrArg (fun φ => φ.hom c) h'
  let w : Spec (.of L) ⟶ pullback f g := pullback.lift u v huv
  have hw : Spec.map ι ≫ w = (pullback f g).fromSpecResidueField t := by
    apply pullback.hom_ext
    · rw [Category.assoc, pullback.lift_fst, hu]
    · rw [Category.assoc, pullback.lift_snd, hv]
  have : Subsingleton ↥(Spec (CommRingCat.of L)) :=
    inferInstanceAs (Subsingleton (PrimeSpectrum L))
  have hpt : w (closedPoint L) = t := by
    let p : ↥(Spec ((pullback f g).residueField t)) :=
      (inferInstance : Nonempty (PrimeSpectrum ↑((pullback f g).residueField t))).some
    have h1 : (Spec.map ι ≫ w) p = t := by
      rw [hw]
      exact fromSpecResidueField_apply _ _
    rw [Scheme.Hom.comp_apply] at h1
    rwa [Subsingleton.elim ((Spec.map ι) p) (closedPoint L)] at h1
  let r := descResidueField (stalkClosedPointTo w)
  have hr : Spec.map r ≫ (pullback f g).fromSpecResidueField (w (closedPoint L)) = w :=
    descResidueField_stalkClosedPointTo_fromSpecResidueField L _ w
  let ρ : (pullback f g).residueField t ⟶ (pullback f g).residueField t :=
    (residueFieldCongr hpt.symm).hom ≫ r ≫ ι
  have hρ : Spec.map ρ ≫ (pullback f g).fromSpecResidueField t =
      𝟙 _ ≫ (pullback f g).fromSpecResidueField t := by
    rw [Category.id_comp]
    simp only [ρ, Spec.map_comp, Category.assoc, residueFieldCongr_fromSpecResidueField, hr, hw]
  have hρ1 : ρ = 𝟙 _ := by
    have := (cancel_mono ((pullback f g).fromSpecResidueField t)).1 hρ
    rw [← Spec.map_id] at this
    exact Spec.map_injective this
  rw [eq_top_iff]
  intro c _
  have hc : ρ.hom c = c := by rw [hρ1]; rfl
  rw [← hc]
  exact (r.hom ((residueFieldCongr hpt.symm).hom.hom c)).2

/-- **Over a field, the map `Ω ⟶ κ(p)` to the residue field of the point of `Spec Ω` is
surjective.** -/
theorem surjective_ΓSpecIso_inv_comp_Γevaluation (Ω : Type u) [Field Ω]
    (p : ↥(Spec (CommRingCat.of Ω))) :
    Function.Surjective ((ΓSpecIso (CommRingCat.of Ω)).inv ≫
      (Spec (CommRingCat.of Ω)).Γevaluation p).hom := by
  have : Subsingleton ↥(Spec (CommRingCat.of Ω)) :=
    inferInstanceAs (Subsingleton (PrimeSpectrum Ω))
  intro c
  obtain ⟨s, rfl⟩ := IsLocalRing.residue_surjective c
  obtain ⟨U, hpU, s', rfl⟩ := TopCat.Presheaf.germ_exist _ s
  have hU : U = ⊤ := by
    rw [eq_top_iff]
    intro q _
    rwa [Subsingleton.elim q p]
  subst hU
  refine ⟨(ΓSpecIso (CommRingCat.of Ω)).hom s', ?_⟩
  rw [CommRingCat.comp_apply, Iso.hom_inv_id_apply]
  rfl

end AlgebraicGeometry.Scheme

namespace AlgebraicGeometry.Scheme.ZariskiRiemann

/-- **A field generated over `Ω` by the image of `K₁` has transcendence degree at most
`trdeg_k K₁`.** Let `k ⊆ K₁` be fields, `ι : K₁ → E` a field embedding into an `Ω`-algebra `E`
mapping `k` into the image of `Ω`, and suppose `E` is generated by `ι(K₁)` over `Ω`. Then
`trdeg_Ω E ≤ trdeg_k K₁`: the image of a transcendence basis of `K₁ / k` generates a subfield
over which `ι(K₁)`, hence `E`, is algebraic. -/
theorem trdeg_le_of_adjoin_range_eq_top {k K₁ Ω E : Type u} [Field k] [Field K₁] [Field Ω]
    [Field E] [Algebra k K₁] [Algebra Ω E] (ι : K₁ →+* E)
    (hk : ∀ r : k, ∃ ω : Ω, ι (algebraMap k K₁ r) = algebraMap Ω E ω)
    (htop : IntermediateField.adjoin Ω (Set.range ι) = ⊤) :
    Algebra.trdeg Ω E ≤ Algebra.trdeg k K₁ := by
  obtain ⟨s, hs⟩ := exists_isTranscendenceBasis k K₁
  set T : Set E := ι '' s with hT
  set F : IntermediateField Ω E := IntermediateField.adjoin Ω T with hF
  set A₁ : Subalgebra k K₁ := Algebra.adjoin k (Set.range ((↑) : s → K₁)) with hA₁
  -- the subalgebra generated by the basis maps into `F`
  let S : Subalgebra k K₁ :=
    { carrier := ι ⁻¹' (F : Set E)
      mul_mem' := fun ha hb => by
        simp only [Set.mem_preimage, map_mul] at *
        exact F.mul_mem ha hb
      add_mem' := fun ha hb => by
        simp only [Set.mem_preimage, map_add] at *
        exact F.add_mem ha hb
      algebraMap_mem' := fun r => by
        obtain ⟨ω, hω⟩ := hk r
        simp only [Set.mem_preimage, SetLike.mem_coe]
        rw [hω]
        exact F.algebraMap_mem ω }
  have hA : ∀ c : A₁, ι c ∈ F := by
    have hle : A₁ ≤ S := by
      rw [hA₁, Algebra.adjoin_le_iff]
      rintro _ ⟨i, rfl⟩
      exact IntermediateField.subset_adjoin Ω T ⟨i, i.2, rfl⟩
    exact fun c => hle c.2
  let φ : A₁ →+* F := (ι.comp A₁.val.toRingHom).codRestrict F fun c => hA c
  have hφ : Function.Injective φ := by
    intro c d hcd
    exact Subtype.ext (ι.injective (congrArg Subtype.val hcd))
  have hφι : (algebraMap F E).comp φ = ι.comp (algebraMap A₁ K₁) := by
    ext c
    rfl
  -- every `ι a` is algebraic over `F`
  have halg : ∀ a : K₁, IsAlgebraic F (ι a) := by
    intro a
    obtain ⟨p, hp0, hpa⟩ := hs.isAlgebraic.isAlgebraic a
    refine ⟨p.map φ, (Polynomial.map_ne_zero_iff hφ).2 hp0, ?_⟩
    rw [Polynomial.aeval_def, Polynomial.eval₂_map, hφι, ← Polynomial.hom_eval₂,
      ← Polynomial.aeval_def, hpa, map_zero]
  -- hence `E` is algebraic over `F`
  have hEalg : Algebra.IsAlgebraic F E := by
    let G : IntermediateField F E := IntermediateField.adjoin F (Set.range ι)
    have hGalg : Algebra.IsAlgebraic F G :=
      (IntermediateField.isAlgebraic_adjoin_iff_isAlgebraic F E).2 (by
        rintro _ ⟨a, rfl⟩
        exact halg a)
    have hGtop : ∀ x : E, x ∈ G := by
      intro x
      have hle : IntermediateField.adjoin Ω (Set.range ι) ≤ G.restrictScalars Ω := by
        rw [IntermediateField.adjoin_le_iff]
        intro y hy
        exact IntermediateField.subset_adjoin F (Set.range ι) hy
      have hx : x ∈ IntermediateField.adjoin Ω (Set.range ι) := by
        rw [htop]
        exact IntermediateField.mem_top
      exact hle hx
    refine ⟨fun x => ?_⟩
    have := hGalg.isAlgebraic ⟨x, hGtop x⟩
    exact (IntermediateField.isAlgebraic_iff (x := (⟨x, hGtop x⟩ : G))).1 this
  have hEalg' : Algebra.IsAlgebraic (Algebra.adjoin Ω T) E :=
    IntermediateField.isAlgebraic_adjoin_iff_top.1 hEalg
  calc Algebra.trdeg Ω E ≤ Cardinal.mk T := Algebra.IsAlgebraic.trdeg_le_cardinalMk Ω T
    _ ≤ Cardinal.mk s := Cardinal.mk_image_le
    _ = Algebra.trdeg k K₁ := hs.cardinalMk_eq_trdeg

/-- **The value group of a valuation ring dominating a local domain that is not a field has
rational rank at least `1`**: the value of a nonzero element of the maximal ideal is a
non-torsion element. -/
theorem one_le_rank_valueGroup {B : Type u} [CommRing B] [IsDomain B] [IsLocalRing B]
    (hB : ¬ IsField B) (V : ValuationSubring (FractionRing B))
    (hV : ∀ b : B, algebraMap B (FractionRing B) b ∈ V)
    [IsLocalHom (valuationSubringBaseMap V hV)] :
    1 ≤ Module.rank ℤ (Additive (ValuationRing.ValueGroup V (FractionRing B))ˣ) := by
  have hm : maximalIdeal B ≠ ⊥ := fun h => hB ((isField_iff_maximalIdeal_eq).2 h)
  obtain ⟨b, hbm, hb0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hm
  set a : V := valuationSubringBaseMap V hV b with ha
  have ha0 : a ≠ 0 := by
    intro h
    apply hb0
    apply IsFractionRing.injective B (FractionRing B)
    have : (a : FractionRing B) = 0 := by rw [h]; rfl
    simpa [ha, valuationSubringBaseMap] using this
  have hau : ¬ IsUnit a := by
    intro h
    exact (mem_maximalIdeal _).1 hbm ((isUnit_map_iff (valuationSubringBaseMap V hV) b).1 h)
  set v := ValuationRing.valuation V (FractionRing B)
  have hlt : v (algebraMap V (FractionRing B) a) < 1 := by
    have h := (Valuation.Integer.not_isUnit_iff_valuation_lt_one
      (x := ValuationRing.equivInteger V (FractionRing B) a)).1 (by
        intro hu
        apply hau
        have := hu.map (ValuationRing.equivInteger V (FractionRing B)).symm
        simpa using this)
    simpa [ValuationRing.coe_equivInteger_apply] using h
  let γ : (ValuationRing.ValueGroup V (FractionRing B))ˣ :=
    Units.mk0 (v (algebraMap V (FractionRing B) a))
      (Stacks.Abhyankar.valuation_algebraMap_ne_zero ha0)
  have hγ : Additive.ofMul γ ≠ 0 := by
    intro h
    have h1 : γ = 1 := Additive.ofMul.injective h
    have h2 : v (algebraMap V (FractionRing B) a) = 1 := by
      have := congrArg Units.val h1
      simpa [γ] using this
    exact hlt.ne h2
  rw [Cardinal.one_le_iff_pos]
  exact rank_pos_iff_exists_ne_zero.2 ⟨_, hγ⟩

namespace ProperModel

variable {B : Type u} [CommRing B] [IsDomain B] (M : ProperModel B)

/-- **The structure map `B ⟶ 𝒪_{Y,y}`** of the local ring of a model at a point:
`B = Γ(Spec B) ⟶ Γ(Y) ⟶ 𝒪_{Y,y}`. -/
def stalkBaseMap (y : M.Y) : B →+* M.Y.presheaf.stalk y :=
  ((ΓSpecIso (CommRingCat.of B)).inv ≫ M.f.appTop ≫ M.Y.presheaf.Γgerm y).hom

variable (V : ValuationSubring (FractionRing B))
  (hV : ∀ b : B, algebraMap B (FractionRing B) b ∈ V)

/-- **The center map is a map over `B`**: `B ⟶ 𝒪_{Y, y_Y(V)} ⟶ V` is the inclusion `B ⊆ V`. -/
theorem centerStalkMap_comp_stalkBaseMap :
    (M.centerStalkMap V hV).hom.comp (M.stalkBaseMap (M.centerPoint V hV)) =
      valuationSubringBaseMap V hV := by
  have h2 : ∀ h : Spec (CommRingCat.of V) ⟶ Spec (CommRingCat.of B),
      h = Spec.map (CommRingCat.ofHom (valuationSubringBaseMap V hV)) →
      (Spec (CommRingCat.of B)).presheaf.germ ⊤ (h (closedPoint V)) trivial ≫
        stalkClosedPointTo h =
        (ΓSpecIso (CommRingCat.of B)).hom ≫ CommRingCat.ofHom (valuationSubringBaseMap V hV) := by
    rintro h rfl
    exact germ_stalkClosedPointTo_Spec _
  have h3 := h2 _ (M.center_comp_f V hV)
  rw [stalkClosedPointTo_comp] at h3
  have h4 := Hom.germ_stalkMap M.f ⊤ (M.centerPoint V hV) trivial
  have key : (ΓSpecIso (CommRingCat.of B)).inv ≫ M.f.appTop ≫
      M.Y.presheaf.Γgerm (M.centerPoint V hV) ≫ M.centerStalkMap V hV =
      CommRingCat.ofHom (valuationSubringBaseMap V hV) := by
    calc (ΓSpecIso (CommRingCat.of B)).inv ≫ M.f.appTop ≫
          M.Y.presheaf.Γgerm (M.centerPoint V hV) ≫ M.centerStalkMap V hV
        = (ΓSpecIso (CommRingCat.of B)).inv ≫
          ((Spec (CommRingCat.of B)).presheaf.germ ⊤ (M.f (M.centerPoint V hV)) trivial ≫
            M.f.stalkMap (M.centerPoint V hV)) ≫ stalkClosedPointTo (M.center V hV) := by
          rw [h4]
          rfl
      _ = (ΓSpecIso (CommRingCat.of B)).inv ≫ (ΓSpecIso (CommRingCat.of B)).hom ≫
          CommRingCat.ofHom (valuationSubringBaseMap V hV) := by
          exact congrArg ((ΓSpecIso (CommRingCat.of B)).inv ≫ ·) ((Category.assoc _ _ _).trans h3)
      _ = _ := Iso.inv_hom_id_assoc _ _
  exact congrArg CommRingCat.Hom.hom key

/-- If `y` is the center of a valuation ring dominating `B`, the map `B ⟶ 𝒪_{Y,y}` is local. -/
theorem isLocalHom_stalkBaseMap [IsLocalRing B] [IsLocalHom (valuationSubringBaseMap V hV)]
    {y : M.Y} (hy : M.centerPoint V hV = y) : IsLocalHom (M.stalkBaseMap y) := by
  subst hy
  have : IsLocalHom ((M.centerStalkMap V hV).hom.comp (M.stalkBaseMap (M.centerPoint V hV))) := by
    rw [centerStalkMap_comp_stalkBaseMap]
    infer_instance
  exact isLocalHom_of_comp _ (M.centerStalkMap V hV).hom

/-- **Abhyankar's inequality at the center.** For `B` a Noetherian local domain of dimension `e`,
`V` a valuation ring of `Frac B` dominating `B` and `y` its center on a proper model:
`rat.rank Γ_V + trdeg_{κ(B)} κ(y) ≤ e`, the residue field `κ(y)` being a `κ(B)`-algebra through
the local map `B ⟶ 𝒪_{Y,y}`. -/
theorem rank_valueGroup_add_trdeg_le [IsLocalRing B] [IsNoetherianRing B]
    [IsLocalHom (valuationSubringBaseMap V hV)] {y : M.Y} (hy : M.centerPoint V hV = y)
    (e : ℕ) (he : ringKrullDim B = e) :
    haveI := M.isLocalHom_stalkBaseMap V hV hy
    letI : Algebra (ResidueField B) (M.Y.residueField y) :=
      (ResidueField.map (M.stalkBaseMap y)).toAlgebra
    Module.rank ℤ (Additive (ValuationRing.ValueGroup V (FractionRing B))ˣ) +
      Algebra.trdeg (ResidueField B) (M.Y.residueField y) ≤ e := by
  subst hy
  have := M.isLocalHom_stalkBaseMap V hV rfl
  let : Algebra (ResidueField B) (M.Y.residueField (M.centerPoint V hV)) :=
    (ResidueField.map (M.stalkBaseMap (M.centerPoint V hV))).toAlgebra
  let : Algebra B V := (valuationSubringBaseMap V hV).toAlgebra
  have : IsScalarTower B V (FractionRing B) := IsScalarTower.of_algebraMap_eq fun _ => rfl
  have : IsLocalHom (algebraMap B V) :=
    inferInstanceAs (IsLocalHom (valuationSubringBaseMap V hV))
  have hab := Stacks.Abhyankar.rank_valueGroup_add_trdeg_le (R := B) (K := FractionRing B)
    (V := V) e he
  let ρ : M.Y.residueField (M.centerPoint V hV) →ₐ[ResidueField B] ResidueField V :=
    { ResidueField.map (M.centerStalkMap V hV).hom with
      commutes' := fun r => by
        obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective r
        change (ResidueField.map (M.centerStalkMap V hV).hom)
            (ResidueField.map (M.stalkBaseMap (M.centerPoint V hV)) (IsLocalRing.residue B b)) =
          ResidueField.map (valuationSubringBaseMap V hV) (IsLocalRing.residue B b)
        have hb := RingHom.congr_fun (M.centerStalkMap_comp_stalkBaseMap V hV) b
        rw [ResidueField.map_residue, ResidueField.map_residue, ResidueField.map_residue]
        exact congrArg (IsLocalRing.residue _) hb }
  have hρ : Function.Injective ρ := ρ.toRingHom.injective
  have htr := trdeg_le_of_injective ρ hρ
  exact (add_le_add le_rfl htr).trans hab

/-- **Abhyankar's inequality on the geometric closed fibre.** For a geometric point
`x : Spec Ω ⟶ Spec B` and a point `z` of `Y_Ω = Y ×_{Spec B} Spec Ω` whose image in `Y` is the
center of `V`: `rat.rank Γ_V + trdeg_Ω κ(z) ≤ e`, the residue field `κ(z)` being an
`Ω`-algebra as in `AlgebraicGeometry.Scheme.trdegLESet`. -/
theorem rank_valueGroup_add_trdeg_pullback_le [IsLocalRing B] [IsNoetherianRing B]
    [IsLocalHom (valuationSubringBaseMap V hV)] (Ω : Type u) [Field Ω]
    (x : Spec (CommRingCat.of Ω) ⟶ Spec (CommRingCat.of B)) (z : ↥(pullback M.f x))
    (hz : M.centerPoint V hV = pullback.fst M.f x z) (e : ℕ) (he : ringKrullDim B = e) :
    letI : Algebra Ω ((pullback M.f x).residueField z) :=
      ((ΓSpecIso (CommRingCat.of Ω)).inv ≫ (pullback.snd M.f x).appTop ≫
        (pullback M.f x).Γevaluation z).hom.toAlgebra
    Module.rank ℤ (Additive (ValuationRing.ValueGroup V (FractionRing B))ˣ) +
      Algebra.trdeg Ω ((pullback M.f x).residueField z) ≤ e := by
  let : Algebra Ω ((pullback M.f x).residueField z) :=
    ((ΓSpecIso (CommRingCat.of Ω)).inv ≫ (pullback.snd M.f x).appTop ≫
      (pullback M.f x).Γevaluation z).hom.toAlgebra
  have hab := M.rank_valueGroup_add_trdeg_le V hV hz e he
  have := M.isLocalHom_stalkBaseMap V hV hz
  let : Algebra (ResidueField B) (M.Y.residueField (pullback.fst M.f x z)) :=
    (ResidueField.map (M.stalkBaseMap (pullback.fst M.f x z))).toAlgebra
  set ι := ((pullback.fst M.f x).residueFieldMap z).hom with hι
  have hΩ : ∀ ω : Ω, algebraMap Ω ((pullback M.f x).residueField z) ω =
      (pullback M.f x).Γevaluation z ((pullback.snd M.f x).appTop
        ((ΓSpecIso (CommRingCat.of Ω)).inv ω)) := fun _ => rfl
  -- `κ(B) ⟶ κ(y) ⟶ κ(z)` lands in the image of `Ω`
  have hk : ∀ r : ResidueField B, ∃ ω : Ω,
      ι (algebraMap (ResidueField B) (M.Y.residueField (pullback.fst M.f x z)) r) =
        algebraMap Ω ((pullback M.f x).residueField z) ω := by
    intro r
    obtain ⟨b, rfl⟩ := IsLocalRing.residue_surjective r
    refine ⟨(ΓSpecIso (CommRingCat.of Ω)).hom (x.appTop ((ΓSpecIso (CommRingCat.of B)).inv b)),
      ?_⟩
    have e1 : algebraMap (ResidueField B) (M.Y.residueField (pullback.fst M.f x z))
        (IsLocalRing.residue B b) = (M.Y.Γevaluation (pullback.fst M.f x z))
          (M.f.appTop ((ΓSpecIso (CommRingCat.of B)).inv b)) := rfl
    have e2 := Γevaluation_naturality_apply (pullback.fst M.f x) z
      (M.f.appTop ((ΓSpecIso (CommRingCat.of B)).inv b))
    rw [e1, hι, e2, hΩ, Iso.hom_inv_id_apply]
    congr 1
    have hc := congrArg (fun φ => φ.hom ((ΓSpecIso (CommRingCat.of B)).inv b))
      (congrArg Hom.appTop (pullback.condition (f := M.f) (g := x)))
    simp only [Hom.comp_appTop] at hc
    exact hc
  -- `κ(z)` is generated over `Ω` by the image of `κ(y)`
  have htop : IntermediateField.adjoin Ω (Set.range ι) = ⊤ := by
    have hcl := closure_range_residueFieldMap_pullback_eq_top M.f x z
    have hsnd : Set.range ((pullback.snd M.f x).residueFieldMap z).hom ⊆
        Set.range (algebraMap Ω ((pullback M.f x).residueField z)) := by
      rintro _ ⟨d, rfl⟩
      obtain ⟨ω, rfl⟩ := surjective_ΓSpecIso_inv_comp_Γevaluation Ω (pullback.snd M.f x z) d
      exact ⟨ω, by rw [hΩ, ← Γevaluation_naturality_apply]; rfl⟩
    rw [eq_top_iff]
    intro c _
    have hc : c ∈ Subfield.closure (Set.range ι ∪
        Set.range ((pullback.snd M.f x).residueFieldMap z).hom) := by
      rw [hι, hcl]
      exact Subfield.mem_top c
    have hle : Subfield.closure (Set.range ι ∪
        Set.range ((pullback.snd M.f x).residueFieldMap z).hom) ≤
        (IntermediateField.adjoin Ω (Set.range ι)).toSubfield := by
      rw [IntermediateField.adjoin_toSubfield]
      refine Subfield.closure_mono ?_
      rintro _ (h | h)
      · exact Or.inr h
      · exact Or.inl (hsnd h)
    exact hle hc
  have htr := trdeg_le_of_adjoin_range_eq_top ι hk htop
  exact (add_le_add le_rfl htr).trans hab

/-- **Off the small transcendence degree locus, centered valuation rings have rational rank
`< q`.** Let `B` be a Noetherian local domain of dimension `e ≥ 1`, `x : Spec Ω ⟶ Spec B` a
geometric point, `z ∈ Y_Ω` a point lying in no `E_a = {trdeg_Ω κ(z) ≤ a}` with `a + q ≤ e`
and `a + 1 ≤ e`, and `V` a valuation ring of `Frac B` dominating `B` whose center on `Y` is the
image of `z`. Then `rat.rank Γ_V < q`. -/
theorem rank_valueGroup_lt_of_not_mem_trdegLESet [IsLocalRing B] [IsNoetherianRing B]
    [IsLocalHom (valuationSubringBaseMap V hV)] (Ω : Type u) [Field Ω]
    (x : Spec (CommRingCat.of Ω) ⟶ Spec (CommRingCat.of B)) (z : ↥(pullback M.f x))
    (hz : M.centerPoint V hV = pullback.fst M.f x z) (e : ℕ) (he : ringKrullDim B = e)
    (he0 : 0 < e) (q : ℕ)
    (hq : ¬ ∃ a : ℕ, a + q ≤ e ∧ a + 1 ≤ e ∧
      z ∈ Scheme.trdegLESet Ω (pullback.snd M.f x) a) :
    Module.rank ℤ (Additive (ValuationRing.ValueGroup V (FractionRing B))ˣ) < q := by
  let : Algebra Ω ((pullback M.f x).residueField z) :=
    ((ΓSpecIso (CommRingCat.of Ω)).inv ≫ (pullback.snd M.f x).appTop ≫
      (pullback M.f x).Γevaluation z).hom.toAlgebra
  have h := M.rank_valueGroup_add_trdeg_pullback_le V hV Ω x z hz e he
  have hB : ¬ IsField B := by
    intro hf
    have := ringKrullDim_eq_zero_of_isField hf
    rw [he] at this
    have : (e : WithBot ℕ∞) = 0 := this
    exact_mod_cast he0.ne' (by exact_mod_cast this)
  have h1 := one_le_rank_valueGroup hB V hV
  set ρ := Module.rank ℤ (Additive (ValuationRing.ValueGroup V (FractionRing B))ˣ)
  set τ := Algebra.trdeg Ω ((pullback M.f x).residueField z)
  have hρfin : ρ < Cardinal.aleph0 :=
    (le_self_add.trans h).trans_lt (Cardinal.natCast_lt_aleph0)
  have hτfin : τ < Cardinal.aleph0 :=
    (le_add_self.trans h).trans_lt (Cardinal.natCast_lt_aleph0)
  obtain ⟨r, hr⟩ := Cardinal.lt_aleph0.1 hρfin
  obtain ⟨t, ht⟩ := Cardinal.lt_aleph0.1 hτfin
  rw [hr, ht] at h
  rw [hr] at h1
  have h' : r + t ≤ e := by exact_mod_cast h
  have h1' : 1 ≤ r := by exact_mod_cast h1
  rw [hr]
  by_contra hlt
  have hqr : q ≤ r := by
    have : ¬ (r : Cardinal) < q := hlt
    exact_mod_cast not_lt.1 this
  refine hq ⟨t, by omega, by omega, ?_⟩
  change τ ≤ t
  rw [ht]

end ProperModel

