module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.CohomologicalDimension.Gabber.ZariskiRiemann.CenteredGermDeathOfValuation

/-!
# Killing is checked on germs

This file proves `AlgebraicGeometry.Scheme.ZariskiRiemann.KillsOfForallDeadAt`, one of the inputs
of the Zariski–Riemann step of Gabber's germ-killing argument (Travaux de Gabber, Exposé XVIII-A,
last remark of §2): a refinement `π : Y' ⟶ Y` of proper models kills the morphism
`ℤ_W ⟶ R^q j_* F` of a section `h` as soon as every germ of `h` dies at every geometric point
of `Y'`.

By `AlgebraicGeometry.Scheme.ZariskiRiemann.ProperModel.Refinement.kills_iff_forall_stalk` it
suffices to check the stalks at the geometric points `s` of `Y'`. The stalk at `s` of an inverse
image `π⁻¹ K` is the stalk of `K` at `s ≫ π`
(`Stacks.EtaleCohomology.smallEtaleStalkPullbackAbIso`), so the stalk at `s` of the composite
`π⁻¹ ℤ_W ⟶ π⁻¹ R^q j_* F ⟶ R^q j'_* F` is the stalk of `ℤ_W ⟶ R^q j_* F` at `s ≫ π` followed by
the transition map of stalks
(`AlgebraicGeometry.Scheme.ZariskiRiemann.ProperModel.Refinement.stalkTransition`). The stalk of
the free sheaf `ℤ_W` at a geometric point `t` is the stalk of the presheaf
`V ↦ ℤ[Hom(V, W)]`, which is generated by the germs of the generators `f : V ⟶ W`; the stalk of
`ℤ_W ⟶ G` sends such a germ to the germ of `h` at the lift of `t` to `W` through `f`. So a map out
of the stalk of `G` vanishing on every germ of `h` vanishes after the stalk of `ℤ_W ⟶ G`.

## Main results

* `Stacks.Sites.FreeRepresentable.toSheafify_comp_hom_app_of` — the morphism of presheaves
  underlying `ℤ_U^♯ ⟶ M` sends the generator `f : V ⟶ U` to the restriction along `f` of the
  section that the morphism corresponds to.
* `AlgebraicGeometry.Scheme.ZariskiRiemann.presheafFiber_map_freeRepULift_comp_eq_zero` — the same
  for any morphism `ℤ_W ⟶ G`, at the level of fibres of presheaves.
* `AlgebraicGeometry.Scheme.ZariskiRiemann.smallEtaleStalkAb_map_germHom_comp_eq_zero` — a map out
  of the stalk of `G` at `t` killing every germ of `h ∈ G(W)` at a lift of `t` to `W` kills the
  stalk of `ℤ_W ⟶ G`.
* `AlgebraicGeometry.Scheme.ZariskiRiemann.smallEtaleStalkAb_map_etaleAbelianInverseImage_map_comp`
  — the stalk at `s` of `π⁻¹ ι` followed by a morphism, through the stalk of `ι` at `s ≫ π`.
* `AlgebraicGeometry.Scheme.ZariskiRiemann.ProperModel.Refinement.smallEtaleStalkAb_map_kills_eq`
  — for a refinement, the stalk of the killing composite through the transition map of stalks.
* `AlgebraicGeometry.Scheme.ZariskiRiemann.ProperModel.Refinement.deadAt_rfl_iff`
* `AlgebraicGeometry.Scheme.ZariskiRiemann.killsOfForallDeadAt`

## Source

The transport of killing along refinements in Gabber's argument (Exposé XVIII-A, last remark
of §2), in its stalk form.

## References

* Travaux de Gabber sur l'uniformisation locale et la cohomologie étale des schémas
  quasi-excellents, Exposé XVIII-A (L. Illusie), last remark of §2, Astérisque 363–364 (2014)
* [Stacks Project, Tag 03A4](https://stacks.math.columbia.edu/tag/03A4)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open AlgebraicGeometry AlgebraicGeometry.Scheme

universe w v u₁ u

namespace Stacks.Sites.FreeRepresentable

variable {C : Type u₁} [Category.{v} C] (J : GrothendieckTopology C)
  [HasSheafify J AddCommGrpCat.{max w v}]

/-- **The presheaf map underlying `ℤ_U^♯ ⟶ M`, on generators.** The composite of the unit of
sheafification with a morphism `φ : ℤ_U^♯ ⟶ M` sends the generator `f : V ⟶ U` of
`ℤ[Hom(V, U)]` to the restriction along `f` of the section of `M` over `U` that `φ` is. -/
theorem toSheafify_comp_hom_app_of (U : C) {M : Sheaf J AddCommGrpCat.{max w v}}
    (φ : freeRepULift.{w} J U ⟶ M) {V : C} (x : (uliftYoneda.{w}.obj U).obj (op V)) :
    (toSheafify J (uliftYoneda.{w}.obj U ⋙ AddCommGrpCat.free.{max w v}) ≫ φ.hom).app (op V)
        (FreeAbelianGroup.of x) =
      M.obj.map x.down.op (freeRepULiftEquiv J U M φ) := by
  let α := toSheafify J (uliftYoneda.{w}.obj U ⋙ AddCommGrpCat.free.{max w v}) ≫ φ.hom
  refine Eq.trans ?_ (NatTrans.naturality_apply α x.down.op
    (FreeAbelianGroup.of (⟨𝟙 U⟩ : (uliftYoneda.{w}.obj U).obj (op U))))
  congr 1
  change _ = FreeAbelianGroup.map _ _
  refine Eq.trans ?_ (FreeAbelianGroup.map_of_apply _).symm
  exact congrArg FreeAbelianGroup.of (ULift.ext _ _ (Category.comp_id _).symm)

end Stacks.Sites.FreeRepresentable

namespace AlgebraicGeometry.Scheme.ZariskiRiemann

attribute [local instance high]
  Stacks.EtaleCohomology.ConstantTransport.hasExt_sheaf_smallEtaleTopology

open Stacks.EtaleCohomology Stacks.Sites.FreeRepresentable

/-- **The fibre of `ℤ_W ⟶ G` is determined by the germs of its section.** For a geometric point
`t` of `Y`, a morphism `ψ : ℤ_W ⟶ G` of abelian sheaves on `Y_étale` and a map `T` out of the
fibre of `G` at `t` killing the germ of the section of `ψ` at every lift of `t` to `W`, the fibre
of `ψ` followed by `T` vanishes. The fibre of `ℤ_W` is the fibre of the presheaf
`V ↦ ℤ[Hom(V, W)]`, generated by the germs of the generators `f : V ⟶ W`, and the generator `f`
at a lift `ℓ` of `t` to `V` goes to the germ of the section at the lift of `t` to `W` through
`f`. -/
theorem presheafFiber_map_freeRepULift_comp_eq_zero {Y : Scheme.{u}} {Ω : Type u} [Field Ω]
    [IsSepClosed Ω] (t : Spec (.of Ω) ⟶ Y) {G : Sheaf Y.smallEtaleTopology AddCommGrpCat.{u + 1}}
    (W : Y.Etale) (ψ : freeRepULift.{u + 1} Y.smallEtaleTopology W ⟶ G)
    {A : AddCommGrpCat.{u + 1}}
    (T : (Scheme.pointSmallEtale t).presheafFiber.obj G.obj ⟶ A)
    (hT : ∀ ℓ : (Scheme.pointSmallEtale t).fiber.obj W,
      T ((Scheme.pointSmallEtale t).toPresheafFiber W ℓ G.obj
        (freeRepULiftEquiv Y.smallEtaleTopology W G ψ)) = 0) :
    (Scheme.pointSmallEtale t).presheafFiber.map ψ.hom ≫ T = 0 := by
  let Φ := Scheme.pointSmallEtale t
  let P := uliftYoneda.{u + 1}.obj W ⋙ AddCommGrpCat.free.{u + 1}
  refine (cancel_epi (Φ.presheafFiber.map (toSheafify Y.smallEtaleTopology P))).1 ?_
  rw [← Functor.map_comp_assoc, comp_zero]
  refine Φ.presheafFiber_hom_ext fun V ℓ => ?_
  rw [Φ.toPresheafFiber_naturality_assoc, comp_zero]
  ext x
  refine FreeAbelianGroup.induction_on x ?_ ?_ ?_ ?_
  · exact (map_zero _).trans (map_zero _).symm
  · intro y
    change T (Φ.toPresheafFiber V ℓ G.obj ((toSheafify Y.smallEtaleTopology P ≫ ψ.hom).app (op V)
      (FreeAbelianGroup.of y))) = 0
    exact (congrArg (fun z => T (Φ.toPresheafFiber V ℓ G.obj z))
      (toSheafify_comp_hom_app_of Y.smallEtaleTopology W ψ y)).trans
      ((congrArg T (Φ.toPresheafFiber_w_apply y.down ℓ G.obj _)).trans
        (hT (Φ.fiber.map y.down ℓ)))
  · intro y hy
    exact (map_neg _ _).trans ((congrArg Neg.neg hy).trans (map_neg _ _).symm)
  · intro y z hy hz
    exact (map_add _ _ _).trans ((congrArg₂ (· + ·) hy hz).trans (map_add _ _ _).symm)

/-- **The stalk of `ℤ_W ⟶ G` is determined by the germs of the section.** For an abelian sheaf
`G` on `Y_étale`, `h ∈ G(W)` and a geometric point `t` of `Y`, a map `T` out of the stalk of `G`
at `t` that kills the germ of `h` at every lift of `t` to `W` kills the image of the stalk of
`ℤ_W ⟶ G`. -/
theorem smallEtaleStalkAb_map_germHom_comp_eq_zero {Y : Scheme.{u}} {Ω : Type u} [Field Ω]
    [IsSepClosed Ω] (t : Spec (.of Ω) ⟶ Y) {G : Sheaf Y.smallEtaleTopology AddCommGrpCat.{u + 1}}
    (W : Y.Etale) (h : G.obj.obj (op W)) {A : AddCommGrpCat.{u + 1}}
    (T : (smallEtaleStalkAb t).obj G ⟶ A)
    (hT : ∀ ℓ : (Scheme.pointSmallEtale t).fiber.obj W,
      T ((Scheme.pointSmallEtale t).toPresheafFiber W ℓ G.obj h) = 0) :
    (smallEtaleStalkAb t).map (ProperModel.germHom W h) ≫ T = 0 :=
  presheafFiber_map_freeRepULift_comp_eq_zero t W (ProperModel.germHom W h) T fun ℓ => by
    rw [Equiv.apply_symm_apply]
    exact hT ℓ

/-- **The stalk of an inverse image of a morphism, through the stalk at the image point.** For
`π : X' ⟶ X`, a geometric point `s` of `X'`, `ι : K ⟶ G` on `X_étale` and `c : π⁻¹ G ⟶ H`, the
stalk at `s` of `π⁻¹ ι ≫ c` is the stalk of `ι` at `s ≫ π`, between the identifications of the
stalks of the inverse images at `s` with the stalks at `s ≫ π`. -/
theorem smallEtaleStalkAb_map_etaleAbelianInverseImage_map_comp {X X' : Scheme.{u}}
    (π : X' ⟶ X) {Ω : Type u} [Field Ω] [IsSepClosed Ω] (s : Spec (.of Ω) ⟶ X')
    {K G : Sheaf X.smallEtaleTopology AddCommGrpCat.{u + 1}}
    {H : Sheaf X'.smallEtaleTopology AddCommGrpCat.{u + 1}} (ι : K ⟶ G)
    (c : (etaleAbelianInverseImage.{u, 0} π).obj G ⟶ H) :
    (smallEtaleStalkAb s).map ((etaleAbelianInverseImage.{u, 0} π).map ι ≫ c) =
      ((smallEtaleStalkAb s).map ((smallEtalePullbackAbIsoEtaleAbelianInverseImage π).inv.app K) ≫
          (smallEtaleStalkPullbackAbIso π s).hom.app K) ≫
        (smallEtaleStalkAb (s ≫ π)).map ι ≫
          ((smallEtaleStalkPullbackAbIso π s).inv.app G ≫
            (smallEtaleStalkAb s).map
              ((smallEtalePullbackAbIsoEtaleAbelianInverseImage π).hom.app G ≫ c)) := by
  have h1 : (etaleAbelianInverseImage.{u, 0} π).map ι =
      (smallEtalePullbackAbIsoEtaleAbelianInverseImage π).inv.app K ≫
        (smallEtalePullbackAb π).map ι ≫
          (smallEtalePullbackAbIsoEtaleAbelianInverseImage π).hom.app G := by
    rw [(smallEtalePullbackAbIsoEtaleAbelianInverseImage π).hom.naturality,
      Iso.inv_hom_id_app_assoc]
  have h2 := (smallEtaleStalkPullbackAbIso π s).hom.naturality ι
  simp only [Functor.comp_map] at h2
  rw [Category.assoc, ← reassoc_of% h2, Iso.hom_inv_id_app_assoc, h1]
  simp only [Category.assoc, Functor.map_comp]

namespace ProperModel

variable {B : Type u} [CommRing B] [IsDomain B]

omit [IsDomain B] in
/-- **The stalk of a killing composite through the transition map.** For a refinement
`π : Y' ⟶ Y`, `ι : K ⟶ R^q j_* F` and a geometric point `s` of `Y'`, the stalk at `s` of
`π⁻¹ ι` followed by the base change map is the stalk of `ι` at `s ≫ π` followed by the
transition map of stalks, after the identification of the stalk of `π⁻¹ K` at `s` with the stalk
of `K` at `s ≫ π`. -/
theorem Refinement.smallEtaleStalkAb_map_kills_eq {M' M : ProperModel B} (φ : Refinement M' M)
    (F : Sheaf (Spec (.of (FractionRing B))).smallEtaleTopology AddCommGrpCat.{u + 1}) (q : ℕ)
    {K : Sheaf M.Y.smallEtaleTopology AddCommGrpCat.{u + 1}}
    (ι : K ⟶ ((etaleAbelianDirectImage.{u, 0} M.j).rightDerived q).obj F)
    {Ω : Type u} [Field Ω] [IsSepClosed Ω] (s : Spec (.of Ω) ⟶ M'.Y) :
    (smallEtaleStalkAb s).map ((etaleAbelianInverseImage.{u, 0} φ.π).map ι ≫
        etaleAbelianInverseImageRightDerivedDirectImageBaseChange M.j φ.π (𝟙 _) M'.j
          (by rw [Category.id_comp, φ.fac]) F q) =
      ((smallEtaleStalkAb s).map
          ((smallEtalePullbackAbIsoEtaleAbelianInverseImage φ.π).inv.app K) ≫
          (smallEtaleStalkPullbackAbIso φ.π s).hom.app K) ≫
        (smallEtaleStalkAb (s ≫ φ.π)).map ι ≫ φ.stalkTransition F q s :=
  smallEtaleStalkAb_map_etaleAbelianInverseImage_map_comp φ.π s ι _

omit [IsDomain B] in
/-- Death at a geometric point `s` of a germ at a lift of `s ≫ π` is the vanishing of its image
under the transition map of stalks at `s`. -/
theorem Refinement.deadAt_rfl_iff {M' M : ProperModel B} (φ : Refinement M' M)
    (F : Sheaf (Spec (.of (FractionRing B))).smallEtaleTopology AddCommGrpCat.{u + 1}) (q : ℕ)
    (U : M.Y.Etale)
    (g : (((etaleAbelianDirectImage.{u, 0} M.j).rightDerived q).obj F).obj.obj (op U))
    {Ω : Type u} [Field Ω] [IsSepClosed Ω] (s : Spec (.of Ω) ⟶ M'.Y)
    (ℓ : (Scheme.pointSmallEtale (s ≫ φ.π)).fiber.obj U) :
    φ.DeadAt F q U g s rfl ℓ ↔
      φ.stalkTransition F q s ((Scheme.pointSmallEtale (s ≫ φ.π)).toPresheafFiber U ℓ
        (((etaleAbelianDirectImage.{u, 0} M.j).rightDerived q).obj F).obj g) = 0 := by
  unfold Refinement.DeadAt
  rw [eqToHom_refl, Category.id_comp]

end ProperModel

/-- **Killing is checked on germs**
(`AlgebraicGeometry.Scheme.ZariskiRiemann.KillsOfForallDeadAt`): a refinement `π : Y' ⟶ Y` kills
the morphism `ℤ_W ⟶ R^q j_* F` of a section `h` as soon as every germ of `h` dies at every
geometric point of `Y'`. On the stalk at a geometric point `s` of `Y'` the composite
`π⁻¹ ℤ_W ⟶ R^q j'_* F` is the stalk of `ℤ_W ⟶ R^q j_* F` at `s ≫ π` followed by the transition
map of stalks, which kills every germ of `h`. -/
theorem killsOfForallDeadAt : KillsOfForallDeadAt.{u} := by
  intro B _ _ M' M φ F q W h hdead
  rw [ProperModel.Refinement.kills_iff_forall_stalk]
  intro s
  rw [ProperModel.Refinement.smallEtaleStalkAb_map_kills_eq,
    smallEtaleStalkAb_map_germHom_comp_eq_zero (s.hom ≫ φ.π) W h _ fun ℓ =>
      (ProperModel.Refinement.deadAt_rfl_iff φ F q W h s.hom ℓ).1 (hdead _ s.hom ℓ),
    comp_zero]

end AlgebraicGeometry.Scheme.ZariskiRiemann
