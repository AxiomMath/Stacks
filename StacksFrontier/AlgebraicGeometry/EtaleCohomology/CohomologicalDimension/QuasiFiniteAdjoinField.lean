module

public import Mathlib.Algebra.Category.Ring.FilteredColimits
public import Mathlib.FieldTheory.AlgebraicClosure
public import Mathlib.RingTheory.Etale.Basic
public import Mathlib.RingTheory.QuasiFinite.Basic
public import Mathlib.RingTheory.Unramified.LocalStructure
public import Mathlib.RingTheory.LocalRing.ResidueField.Instances
public import StacksFrontier.RingTheory.Etale.FilteredColimit.Basic

/-!
# Residue fields of an algebra generated by a field over a quasi-finite subalgebra

Let `R → B` be a ring map and let `D ⊆ B` be an `R`-subalgebra which is quasi-finite over `R`.
Let `L` be a field mapping to `B` such that `B` is generated as an `L`-algebra by `D`, and such
that every element of `L` is a root of a polynomial with coefficients in `D` whose leading
coefficient is a unit of `B`. Then for every prime `P` of `B`, the residue field `κ(P)` is
algebraic (equivalently integral) over the residue field `κ(P ∩ R)`.

This is the "details omitted" step of the proof of [Stacks, Tag 0F0X]: there `R` is the ring of
an affine open of a scheme `Y` of finite type over a field `K`, `B` is a finite type subalgebra of
the strict henselization `𝒪^{sh}_{Y,y}` generated over a separable closure `L` of a purely
transcendental extension `K(t_1, …, t_b) ⊆ 𝒪^{sh}_{Y,y}` by a quasi-finite `R`-subalgebra `D`
containing the `t_i`, and the conclusion says that the points of `Spec B` have residue fields
algebraic over those of their images in `Spec R`.

## Main results

* `AlgebraicGeometry.isIntegral_of_aeval_eq_zero_of_isIntegral_coeff`: over a field, a root of a
  nonzero polynomial with integral coefficients is integral.
* `AlgebraicGeometry.isIntegral_residueFieldMap_of_quasiFinite`: the residue field extensions of
  a quasi-finite algebra are integral.
* `AlgebraicGeometry.isIntegral_residueFieldMap_of_closure_eq_top`: the statement above.
* `AlgebraicGeometry.quasiFinite_sup`: the supremum of two quasi-finite subalgebras is
  quasi-finite.

## References

* [Stacks Project, Tag 0F0X](https://stacks.math.columbia.edu/tag/0F0X)
* [Stacks Project, Tag 00PL](https://stacks.math.columbia.edu/tag/00PL)
-/

@[expose] public noncomputable section

open Polynomial TensorProduct

universe u v w

namespace AlgebraicGeometry

/-- **Over a field, a root of a nonzero polynomial with integral coefficients is integral.** The
coefficients lie in the algebraic closure `M` of `k` in `F`, so `x` is algebraic over `M`, and
`M` is algebraic over `k`. -/
theorem isIntegral_of_aeval_eq_zero_of_isIntegral_coeff {k : Type u} {F : Type v} [Field k]
    [Field F] [Algebra k F] {q : F[X]} (hq : q ≠ 0) (hc : ∀ n, IsIntegral k (q.coeff n)) {x : F}
    (hx : q.eval x = 0) : IsIntegral k x := by
  let M := algebraicClosure k F
  obtain ⟨q', hq'⟩ : q ∈ Polynomial.lifts (algebraMap M F) := by
    rw [Polynomial.lifts_iff_coeff_lifts]
    exact fun n => ⟨⟨q.coeff n, mem_algebraicClosure_iff.2 (hc n).isAlgebraic⟩, rfl⟩
  have hq'0 : q' ≠ 0 := by
    rintro rfl
    exact hq (by simpa using hq'.symm)
  have halg : IsAlgebraic M x := by
    refine ⟨q', hq'0, ?_⟩
    rwa [Polynomial.aeval_def, Polynomial.eval₂_eq_eval_map, ← Polynomial.coe_mapRingHom, hq']
  exact (halg.restrictScalars k).isIntegral

/-- **The residue field extensions of a quasi-finite algebra are integral.** For a quasi-finite
`R`-algebra `S` and a prime `P` of `S`, the map `κ(P ∩ R) → κ(P)` is integral: `κ(P)` is even
finite over `κ(P ∩ R)` ([Stacks, Tag 00PL]). -/
theorem isIntegral_residueFieldMap_of_quasiFinite {R : Type u} {S : Type v} [CommRing R]
    [CommRing S] [Algebra R S] [Algebra.QuasiFinite R S] (P : Ideal S) [P.IsPrime]
    (I : Ideal R) [I.IsPrime] (hI : I = P.comap (algebraMap R S)) :
    (Ideal.ResidueField.map I P (algebraMap R S) hI).IsIntegral := by
  subst hI
  let := Localization.AtPrime.algebraOfLiesOver (P.under R) P
  have : Module.Finite (P.under R).ResidueField P.ResidueField := inferInstance
  have : Algebra.IsIntegral (P.under R).ResidueField P.ResidueField := inferInstance
  exact this.isIntegral

/-- **A residue field is integral as soon as a generating set of the ring is.** If the images in
`κ(P)` of a set generating `B` as a ring are integral over a field `k`, then `κ(P)`, the fraction
field of `B ⧸ P`, is integral over `k`. -/
theorem isIntegral_residueField_of_closure_eq_top {B : Type*} [CommRing B] (P : Ideal B)
    [P.IsPrime] {k : Type*} [Field k] [Algebra k P.ResidueField] {S : Set B}
    (hS : Subring.closure S = ⊤) (h : ∀ b ∈ S, IsIntegral k (algebraMap B P.ResidueField b)) :
    Algebra.IsIntegral k P.ResidueField := by
  have hB : ∀ b : B, IsIntegral k (algebraMap B P.ResidueField b) := by
    intro b
    have hb : b ∈ Subring.closure S := hS ▸ Subring.mem_top b
    induction hb using Subring.closure_induction with
    | mem x hx => exact h x hx
    | zero => simpa using isIntegral_zero
    | one => simpa using isIntegral_one
    | add x y _ _ hx hy => simpa using hx.add hy
    | neg x _ hx => simpa using hx.neg
    | mul x y _ _ hx hy => simpa using hx.mul hy
  refine ⟨fun z => ?_⟩
  obtain ⟨a, s, -, rfl⟩ := IsFractionRing.div_surjective (A := B ⧸ P) z
  obtain ⟨a, rfl⟩ := Ideal.Quotient.mk_surjective a
  obtain ⟨s, rfl⟩ := Ideal.Quotient.mk_surjective s
  have hB' (b : B) :
      IsIntegral k (algebraMap (B ⧸ P) P.ResidueField (Ideal.Quotient.mk P b)) := by
    simpa [← IsScalarTower.algebraMap_apply] using hB b
  rw [div_eq_mul_inv]
  exact (hB' a).mul (hB' s).inv

/-- **The residue field extensions of a ring generated by a field and a quasi-finite algebra are
integral.** Let `j : D → B` be a map of `R`-algebras with `D` quasi-finite over `R`, and
`lam : L → B` a ring map from a field, such that `B` is generated as a ring by the images of `j`
and `lam`, and every element of `L` is mapped to a root of the image under `j` of a polynomial
over `D` whose leading coefficient becomes a unit of `B`. Then for every prime `P` of `B`,
`κ(P ∩ R) → κ(P)` is integral.

The images in `κ(P)` of the elements of `D` are integral over `κ(P ∩ R)`, since `κ(P ∩ D)` is
(`isIntegral_residueFieldMap_of_quasiFinite`); the image of an element of `L` is then a root of a
nonzero polynomial with integral coefficients, its leading coefficient being a unit; so the image
of `B` is integral, and so is its fraction field `κ(P)`. -/
theorem isIntegral_residueFieldMap_of_closure_eq_top {R : Type u} {B : Type v} {D : Type v}
    [CommRing R] [CommRing B] [CommRing D] [Algebra R B] [Algebra R D] [Algebra.QuasiFinite R D]
    (j : D →ₐ[R] B) {L : Type w} [Field L] (lam : L →+* B)
    (hgen : Subring.closure (Set.range j ∪ Set.range lam) = ⊤)
    (hL : ∀ ℓ : L, ∃ p : D[X], IsUnit (j p.leadingCoeff) ∧ p.eval₂ j.toRingHom (lam ℓ) = 0)
    (P : Ideal B) [P.IsPrime] :
    (Ideal.ResidueField.map (P.comap (algebraMap R B)) P (algebraMap R B) rfl).IsIntegral := by
  set ι := Ideal.ResidueField.map (P.comap (algebraMap R B)) P (algebraMap R B) rfl
  let : Algebra (P.comap (algebraMap R B)).ResidueField P.ResidueField := ι.toAlgebra
  let k := (P.comap (algebraMap R B)).ResidueField
  let π : B →+* P.ResidueField := algebraMap B P.ResidueField
  -- the prime of `D` below `P`, and the integrality of the images of `D`
  let PD : Ideal D := P.comap j.toRingHom
  have hPD : PD.comap (algebraMap R D) = P.comap (algebraMap R B) := by
    rw [Ideal.comap_comap]
    congr 1
    exact j.comp_algebraMap
  let ι₁ := Ideal.ResidueField.map PD P j.toRingHom rfl
  have hcomp : ι₁.comp (Ideal.ResidueField.map (P.comap (algebraMap R B)) PD
      (algebraMap R D) hPD.symm) = ι := by
    apply Ideal.ResidueField.ringHom_ext
    ext r
    simp [ι, ι₁, Ideal.ResidueField.map_algebraMap]
  have hD : ∀ d : D, IsIntegral k (π (j d)) := by
    intro d
    obtain ⟨p, hmon, hp⟩ := isIntegral_residueFieldMap_of_quasiFinite (R := R) PD
      (P.comap (algebraMap R B)) hPD.symm (algebraMap D PD.ResidueField d)
    have hπ : ι₁ (algebraMap D PD.ResidueField d) = π (j d) := by
      simp [ι₁, π]
    refine ⟨p, hmon, ?_⟩
    change p.eval₂ ι (π (j d)) = 0
    rw [← hπ, ← hcomp, ← Polynomial.hom_eval₂, hp, map_zero]
  -- the images of `L`
  have hLint : ∀ ℓ : L, IsIntegral k (π (lam ℓ)) := by
    intro ℓ
    obtain ⟨p, hunit, hp⟩ := hL ℓ
    let q : P.ResidueField[X] := p.map (π.comp j.toRingHom)
    have hq0 : q ≠ 0 := by
      intro h0
      have hlead : (π.comp j.toRingHom) p.leadingCoeff = 0 := by
        simpa [q, Polynomial.coeff_map] using congrArg (fun r => r.coeff p.natDegree) h0
      exact (hunit.map π).ne_zero hlead
    refine isIntegral_of_aeval_eq_zero_of_isIntegral_coeff hq0 (fun n => ?_) ?_
    · simpa [q, Polynomial.coeff_map] using hD (p.coeff n)
    · have := congrArg π hp
      rw [map_zero, Polynomial.hom_eval₂] at this
      simpa [q, Polynomial.eval_map] using this
  exact fun z => (isIntegral_residueField_of_closure_eq_top P hgen (by
    rintro _ (⟨d, rfl⟩ | ⟨ℓ, rfl⟩)
    exacts [hD d, hLint ℓ])).isIntegral z

/-- **The supremum of two quasi-finite subalgebras is quasi-finite.** It is the image of their
tensor product, which is quasi-finite by base change and composition ([Stacks, Tag 00PP]). -/
theorem quasiFinite_sup {R : Type u} {O : Type v} [CommRing R] [CommRing O] [Algebra R O]
    (D₁ D₂ : Subalgebra R O) [Algebra.QuasiFinite R D₁] [Algebra.QuasiFinite R D₂] :
    Algebra.QuasiFinite R ↥(D₁ ⊔ D₂) := by
  let φ := Algebra.TensorProduct.productMap D₁.val D₂.val
  have : Algebra.QuasiFinite D₁ (D₁ ⊗[R] D₂) := inferInstance
  have : Algebra.QuasiFinite R (D₁ ⊗[R] D₂) := Algebra.QuasiFinite.trans R D₁ _
  have he : φ.range = D₁ ⊔ D₂ := by
    rw [Algebra.TensorProduct.productMap_range, Subalgebra.range_val, Subalgebra.range_val]
  exact (Algebra.QuasiFinite.iff_of_algEquiv (Subalgebra.equivOfEq _ _ he)).1
    (.of_surjective_algHom φ.rangeRestrict φ.rangeRestrict_surjective)

/-- **An ind-étale algebra is covered by finitely generated quasi-finite subalgebras.** If
`R ⟶ O` is a filtered colimit of étale ring maps, every element of `O` lies in a finitely
generated `R`-subalgebra which is quasi-finite over `R`: the element comes from one of the étale
algebras of the system, and the image of an étale algebra is finitely generated and, being a
quotient of a quasi-finite algebra ([Stacks, Tag 00PL]), quasi-finite. -/
theorem exists_fg_quasiFinite_mem_of_ind_etale {R O : CommRingCat.{u}} (f : R ⟶ O)
    (hf : CategoryTheory.MorphismProperty.ind.{u} CommRingCat.etale.{u} f) (o : O) :
    letI := f.hom.toAlgebra
    ∃ D : Subalgebra R O, D.FG ∧ Algebra.QuasiFinite R D ∧ o ∈ D := by
  let := f.hom.toAlgebra
  obtain ⟨J, _, _, Dg, t, s, hc, hts⟩ := hf
  obtain ⟨j, y, hy⟩ := CategoryTheory.Limits.Concrete.isColimit_exists_rep _ hc o
  let : Algebra R (Dg.obj j) := (t.app j).hom.toAlgebra
  have het : Algebra.Etale R (Dg.obj j) := (hts j).1
  let g : Dg.obj j →ₐ[R] O :=
    { (s.app j).hom with
      commutes' := fun r => by
        simpa [RingHom.algebraMap_toAlgebra] using congrArg (fun φ => φ.hom r) (hts j).2 }
  refine ⟨g.range, ?_, ?_, ⟨y, hy⟩⟩
  · rw [← Algebra.map_top]
    exact (Algebra.FiniteType.out).map g
  · exact Algebra.QuasiFinite.of_surjective_algHom g.rangeRestrict g.rangeRestrict_surjective

end AlgebraicGeometry

end
