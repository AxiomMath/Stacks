module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GroupCohomology.TorsionCochainVanishing
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GroupHomology.ProcyclicGroupAlgebra

/-!
# Degree-two cochains of a procyclic group with coefficients in `ℤ/p`

Let `G` be a compact, totally disconnected, commutative topological group and `σ ∈ G` an element
generating every finite quotient of `G`. Suppose that for every prime `p` either `G` has the
quotients `ℤ/p^e` (with `σ ↦ 1`) for all `e`, or `σ` is a `p`-th power. Then every locally
constant `2`-cocycle of an open subgroup of `G` with values in `ℤ/p` (trivial action) is the
coboundary of a locally constant `1`-cochain; that is, `G` satisfies
`Stacks.GroupCohomology.HasPrimeBase` and hence has cohomological dimension at most one on
torsion modules. This applies to `Ẑ^{(q)} = ∏_{ℓ ∤ q} ℤ_ℓ` with `σ = 1`.

## Main results

* `Stacks.GroupCohomology.cocycle_pow_eq`: for a normalized `2`-cocycle `f` with trivial
  coefficients, `f(τ^i, τ^j) = S(i + j) - S(i) - S(j)`, `S(i) = Σ_{k < i} f(τ^k, τ)`.
* `Stacks.GroupCohomology.vanishesTwo_trivialMod_of_generator`: the coboundary, for a group
  topologically generated by `τ` with suitable finite levels.
* `Stacks.GroupCohomology.hasPrimeBase_of_procyclic`: **the prime base** for `G` as above.

## Implementation notes

Write `T(i) = S(i) - i b`. If `τ^r` lies in an open subgroup `N'` under which `f` is invariant
and `S(r) = r b`, then `T` is `r`-periodic, so `x(u) = -T(j)` for `u ∈ τ^j N'` is a well-defined
locally constant cochain, and `dOne x = f`. Such an `N'` and `b` exist: if `r` is prime to `p`,
divide by `r`; otherwise pass to a level at which the order of `τ` is multiplied by a multiple of
`p`, which kills `S(r)`.

## References

* [Stacks Project, Tag 03VQ](https://stacks.math.columbia.edu/tag/03VQ)
-/

@[expose] public section

universe u

namespace Stacks.GroupCohomology

open groupCohomology Stacks.GroupHomology.Procyclic

/-! ### Cocycles on the powers of an element -/

section Powers

variable {U : Type*} [Group U] {p : ℕ} (τ : U) (f : U × U → TrivialMod p)

/-- `S(i) = Σ_{k < i} f(τ^k, τ)`. -/
def cocycleSum (i : ℕ) : TrivialMod p := ∑ k ∈ Finset.range i, f (τ ^ k, τ)

/-- **A normalized cocycle on the powers of `τ`**: `f(τ^i, τ^j) = S(i + j) - S(i) - S(j)`. -/
theorem cocycle_pow_eq (hf : IsCocycle₂ f) (h1 : ∀ g, f (g, 1) = 0) (i j : ℕ) :
    f (τ ^ i, τ ^ j) = cocycleSum τ f (i + j) - cocycleSum τ f i - cocycleSum τ f j := by
  induction j with
  | zero => simp [h1, cocycleSum]
  | succ j ih =>
    have h := hf (τ ^ i) (τ ^ j) τ
    rw [TrivialMod.smul_eq, ← pow_add, ← pow_succ] at h
    have key : f (τ ^ i, τ ^ (j + 1)) = f (τ ^ (i + j), τ) + f (τ ^ i, τ ^ j) - f (τ ^ j, τ) := by
      rw [h]
      abel
    rw [key, ih, ← add_assoc]
    simp only [cocycleSum, Finset.sum_range_succ]
    abel

/-- If `f(τ^k, τ)` is `r`-periodic in `k`, then `S(i + c r) = S(i) + c S(r)`. -/
theorem cocycleSum_add_mul {r : ℕ} (hper : ∀ k, f (τ ^ (k + r), τ) = f (τ ^ k, τ)) (i c : ℕ) :
    cocycleSum τ f (i + c * r) = cocycleSum τ f i + c • cocycleSum τ f r := by
  have hstep : ∀ i, cocycleSum τ f (i + r) = cocycleSum τ f i + cocycleSum τ f r := by
    intro i
    rw [cocycleSum, add_comm i r, Finset.sum_range_add, cocycleSum, cocycleSum, add_comm]
    congr 1
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [add_comm r k, hper]
  induction c with
  | zero => simp
  | succ c ih => rw [add_mul, one_mul, ← add_assoc, hstep, ih, succ_nsmul, add_assoc]

end Powers

/-! ### The coboundary -/

section Generator

variable {U : Type u} [Group U] [TopologicalSpace U] [IsTopologicalGroup U] [CompactSpace U]
  [TotallyDisconnectedSpace U]

/-- If `a⁻¹ * u` and `b⁻¹ * u` lie in a subgroup `H`, then so does `a⁻¹ * b`. -/
private theorem inv_mul_mem_of_inv_mul_mem {G : Type*} [Group G] (H : Subgroup G) {a b u : G}
    (ha : a⁻¹ * u ∈ H) (hb : b⁻¹ * u ∈ H) : a⁻¹ * b ∈ H := by
  simpa [mul_assoc] using H.mul_mem ha (H.inv_mem hb)

/-- A function invariant under right multiplication by an open subgroup is locally constant. -/
theorem isLocallyConstant_of_mul_right_eq {B : Type*} {x : U → B} (N : OpenSubgroup U)
    (hx : ∀ u n, n ∈ N → x (u * n) = x u) : IsLocallyConstant x := by
  rw [IsLocallyConstant.iff_exists_open]
  intro u
  refine ⟨(fun y => u⁻¹ * y) ⁻¹' (N : Set U), N.isOpen.preimage (by fun_prop), by simp, ?_⟩
  intro y hy
  simpa using hx u _ hy

/-- **Locally constant `2`-cocycles with values in `ℤ/p` are coboundaries**, for a commutative
group topologically generated by `τ`, as soon as every open subgroup `N` contains an open subgroup
`N'` in which `τ` has an exact order `r'` with either `p ∤ r'`, or `r' = c r` with `p ∣ c` and
`τ^r ∈ N`. -/
theorem vanishesTwo_trivialMod_of_generator (hcomm : ∀ a b : U, a * b = b * a) {p : ℕ}
    (hp : p.Prime) (τ : U) (hgen : ∀ (N : OpenSubgroup U) (u : U), ∃ j : ℕ, (τ ^ j)⁻¹ * u ∈ N)
    (hdeep : ∀ N : OpenSubgroup U, ∃ N' : OpenSubgroup U, N' ≤ N ∧ ∃ r' : ℕ,
      τ ^ r' ∈ N' ∧ (∀ j : ℕ, τ ^ j ∈ N' → r' ∣ j) ∧
        (¬ p ∣ r' ∨ ∃ r c : ℕ, r' = c * r ∧ p ∣ c ∧ τ ^ r ∈ N)) :
    VanishesTwo U (TrivialMod p) := by
  have : Fact p.Prime := ⟨hp⟩
  intro f hf hcoc
  set c₀ := f (1, 1)
  set f₀ : U × U → TrivialMod p := fun x => f x - c₀ with hf₀
  have hcoc₀ : IsCocycle₂ f₀ := by
    intro g h j
    have := hcoc g h j
    simp only [hf₀, TrivialMod.smul_eq] at this ⊢
    rw [sub_add_sub_comm, this, sub_add_sub_comm]
  have hf₀1 : ∀ g, f₀ (g, 1) = 0 := by
    intro g
    have h := hcoc g 1 1
    simp only [TrivialMod.smul_eq, mul_one] at h
    exact sub_eq_zero.2 (add_right_cancel h)
  obtain ⟨N, hN⟩ := exists_openSubgroup_forall_mul_right_eq₂ hf
  have hN₀ : ∀ x y n m : U, n ∈ N → m ∈ N → f₀ (x * n, y * m) = f₀ (x, y) := by
    intro x y n m hn hm
    simp only [hf₀, hN x y n m hn hm]
  obtain ⟨N', hN'N, r', hτr', hdvd, hcase⟩ := hdeep N
  have hperN : ∀ {r : ℕ}, τ ^ r ∈ N → ∀ k, f₀ (τ ^ (k + r), τ) = f₀ (τ ^ k, τ) := by
    intro r hr k
    rw [pow_add, ← hN₀ (τ ^ k) τ (τ ^ r) 1 hr (one_mem N), mul_one]
  obtain ⟨b, hb⟩ : ∃ b : TrivialMod p, cocycleSum τ f₀ r' = r' • b := by
    rcases hcase with hpr | ⟨r, c, rfl, hpc, hτr⟩
    · refine ⟨(TrivialMod.addEquivZMod p).symm
        (((r' : ZMod p))⁻¹ * TrivialMod.addEquivZMod p (cocycleSum τ f₀ r')), ?_⟩
      apply (TrivialMod.addEquivZMod p).injective
      rw [map_nsmul, AddEquiv.apply_symm_apply, nsmul_eq_mul, ← mul_assoc,
        ZMod.coe_mul_inv_eq_one r' (Nat.coprime_comm.1 ((Nat.Prime.coprime_iff_not_dvd hp).2 hpr)),
        one_mul]
    · refine ⟨0, ?_⟩
      have h := cocycleSum_add_mul τ f₀ (hperN hτr) 0 c
      rw [zero_add, show cocycleSum τ f₀ 0 = 0 by simp [cocycleSum], zero_add] at h
      obtain ⟨d, rfl⟩ := hpc
      rw [h, nsmul_zero, mul_nsmul', TrivialMod.nsmul_self_eq_zero]
  set T : ℕ → TrivialMod p := fun i => cocycleSum τ f₀ i - i • b with hT
  have hTper : ∀ i k, T (i + k * r') = T i := by
    intro i k
    simp only [hT]
    rw [cocycleSum_add_mul τ f₀ (hperN (hN'N hτr')) i k, hb, add_nsmul, ← mul_nsmul']
    abel
  have hTwd : ∀ {u : U} {j j' : ℕ}, (τ ^ j)⁻¹ * u ∈ N' → (τ ^ j')⁻¹ * u ∈ N' → T j = T j' := by
    intro u j j' hj hj'
    have key : ∀ {a b : ℕ}, a ≤ b → (τ ^ a)⁻¹ * u ∈ N' → (τ ^ b)⁻¹ * u ∈ N' → T a = T b := by
      intro a b hab ha hb'
      obtain ⟨d, rfl⟩ := Nat.exists_eq_add_of_le hab
      have hmem : τ ^ d ∈ N' := by
        simpa [pow_add] using inv_mul_mem_of_inv_mul_mem N'.toSubgroup ha hb'
      obtain ⟨k, hk⟩ := hdvd _ hmem
      rw [hk, mul_comm, hTper]
    rcases le_total j j' with h | h
    · exact key h hj hj'
    · exact (key h hj' hj).symm
  choose jj hjj using hgen N'
  set x : U → TrivialMod p := fun u => -T (jj u) + c₀ with hx
  refine ⟨x, ?_, ?_⟩
  · refine isLocallyConstant_of_mul_right_eq N' fun u n hn => ?_
    simp only [hx]
    congr 2
    refine hTwd (hjj (u * n)) ?_
    rw [← mul_assoc]
    exact N'.mul_mem (hjj u) hn
  · funext ⟨g, h⟩
    rw [dOne_apply, TrivialMod.smul_eq]
    have hgh : (τ ^ (jj g + jj h))⁻¹ * (g * h) ∈ N' := by
      let : CommGroup U := { (inferInstance : Group U) with mul_comm := hcomm }
      rw [pow_add, mul_inv, mul_mul_mul_comm]
      exact N'.mul_mem (hjj g) (hjj h)
    have hT1 : T (jj (g * h)) = T (jj g + jj h) := hTwd (hjj (g * h)) hgh
    have hfeq : f (g, h) = f₀ (τ ^ jj g, τ ^ jj h) + c₀ := by
      have hg : g = τ ^ jj g * ((τ ^ jj g)⁻¹ * g) := by group
      have hh : h = τ ^ jj h * ((τ ^ jj h)⁻¹ * h) := by group
      rw [← hN₀ (τ ^ jj g) (τ ^ jj h) _ _ (hN'N (hjj g)) (hN'N (hjj h)), ← hg, ← hh]
      simp [hf₀]
    rw [hfeq, cocycle_pow_eq τ f₀ hcoc₀ hf₀1]
    simp only [hx]
    rw [hT1]
    simp only [hT, add_nsmul]
    abel

end Generator

/-! ### Procyclic groups -/

section Procyclic

variable {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [TotallyDisconnectedSpace G]

/-- A subgroup of a commutative group is normal. -/
theorem normal_of_forall_mul_comm (hcomm : ∀ a b : G, a * b = b * a) (H : Subgroup G) :
    H.Normal :=
  ⟨fun n hn g => by rw [hcomm g n, mul_inv_cancel_right]; exact hn⟩

/-- An open subgroup of `G`, as an open normal subgroup, `G` being commutative. -/
def openNormalOfComm (hcomm : ∀ a b : G, a * b = b * a) (H : OpenSubgroup G) :
    OpenNormalSubgroup G :=
  { toOpenSubgroup := H
    isNormal' := normal_of_forall_mul_comm hcomm H.toSubgroup }

/-- The order of the class of `x` in `G / H`, for an open subgroup `H` of the commutative `G`. -/
noncomputable def levelOrder (hcomm : ∀ a b : G, a * b = b * a) (H : OpenSubgroup G) (x : G) : ℕ :=
  letI := normal_of_forall_mul_comm hcomm H.toSubgroup
  orderOf (x : G ⧸ H.toSubgroup)

/-- `x ^ j ∈ H` if and only if `levelOrder hcomm H x` divides `j`. -/
theorem pow_mem_iff_levelOrder_dvd (hcomm : ∀ a b : G, a * b = b * a) (H : OpenSubgroup G)
    (x : G) (j : ℕ) : x ^ j ∈ H ↔ levelOrder hcomm H x ∣ j := by
  let := normal_of_forall_mul_comm hcomm H.toSubgroup
  rw [levelOrder, orderOf_dvd_iff_pow_eq_one, ← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
  rfl

/-- The order of the class of `x` in `G / H` is positive. -/
theorem levelOrder_pos (hcomm : ∀ a b : G, a * b = b * a) (H : OpenSubgroup G) (x : G) :
    0 < levelOrder hcomm H x := by
  let := normal_of_forall_mul_comm hcomm H.toSubgroup
  exact orderOf_pos _

variable (hcomm : ∀ a b : G, a * b = b * a) {σ : G} (hgen : GeneratesQuotients σ)
include hcomm hgen

/-- Every element is a power of `σ` modulo every open subgroup. -/
theorem exists_pow_inv_mul_mem (N : OpenSubgroup G) (g : G) : ∃ j : ℕ, (σ ^ j)⁻¹ * g ∈ N := by
  obtain ⟨j, hj⟩ := hgen (openNormalOfComm hcomm N) g
  refine ⟨j, ?_⟩
  rw [← QuotientGroup.mk_pow, QuotientGroup.eq] at hj
  have := (openNormalOfComm hcomm N).toSubgroup.inv_mem hj
  rwa [mul_inv_rev, inv_inv] at this

/-- **Locally constant `2`-cocycles of an open subgroup with values in `ℤ/p` are coboundaries**,
for `G` commutative, topologically generated by `σ`, with either the `p`-power quotients or all
finite quotients of order prime to `p`. -/
theorem vanishesTwo_trivialMod_openSubgroup {p : ℕ} (hp : p.Prime)
    (hpow : HasPrimePowerQuotients σ p ∨
      ∀ N : OpenNormalSubgroup G, ¬ p ∣ orderOf (σ : G ⧸ (N : Subgroup G)))
    (U : OpenSubgroup G) : VanishesTwo U (TrivialMod p) := by
  have : CompactSpace U := isCompact_iff_compactSpace.1 U.isClosed.isCompact
  have : IsTopologicalGroup U := inferInstanceAs (IsTopologicalGroup (U : Subgroup G))
  set k := levelOrder hcomm U σ
  have hk : ∀ j : ℕ, σ ^ j ∈ U ↔ k ∣ j := pow_mem_iff_levelOrder_dvd hcomm U σ
  have hσk : σ ^ k ∈ U := (hk k).2 dvd_rfl
  set τ : U := ⟨σ ^ k, hσk⟩
  have hτpow : ∀ j : ℕ, ((τ ^ j : U) : G) = σ ^ (k * j) := fun j => by
    rw [SubgroupClass.coe_pow, pow_mul]
  have hopenG :
      ∀ N : OpenSubgroup U, IsOpen ((N.toSubgroup.map U.subtype : Subgroup G) : Set G) := by
    intro N
    rw [Subgroup.coe_map]
    exact U.isOpen.isOpenMap_subtype_val _ N.isOpen
  let NG : OpenSubgroup U → OpenSubgroup G := fun N => ⟨N.toSubgroup.map U.subtype, hopenG N⟩
  have hNG : ∀ (N : OpenSubgroup U) (u : U), (u : G) ∈ NG N ↔ u ∈ N := fun _ _ =>
    Subgroup.mem_map_iff_mem (Subgroup.subtype_injective _)
  have hNGU : ∀ N : OpenSubgroup U, (NG N : Subgroup G) ≤ U := by
    intro N g hg
    obtain ⟨v, -, rfl⟩ := Subgroup.mem_map.1 hg
    exact v.2
  let NU : OpenSubgroup G → OpenSubgroup U := fun N =>
    ⟨N.toSubgroup.comap U.subtype, N.isOpen.preimage continuous_subtype_val⟩
  have hNU : ∀ (N : OpenSubgroup G) (u : U), u ∈ NU N ↔ (u : G) ∈ N := fun _ _ => Iff.rfl
  have hlev : ∀ N : OpenSubgroup G, (N : Subgroup G) ≤ U → ∀ j : ℕ,
      τ ^ j ∈ NU N ↔ levelOrder hcomm N σ ∣ k * j := by
    intro N _ j
    rw [hNU, hτpow, pow_mem_iff_levelOrder_dvd]
  have hkdvd : ∀ N : OpenSubgroup G, (N : Subgroup G) ≤ U → k ∣ levelOrder hcomm N σ := by
    intro N hN
    rw [← hk]
    exact hN ((pow_mem_iff_levelOrder_dvd hcomm N σ _).2 dvd_rfl)
  refine vanishesTwo_trivialMod_of_generator (fun a b => Subtype.ext (hcomm a b)) hp τ ?_ ?_
  · intro N u
    obtain ⟨j, hj⟩ := exists_pow_inv_mul_mem hcomm hgen (NG N) u
    have hσj : σ ^ j ∈ U := by
      simpa using inv_mul_mem_of_inv_mul_mem (a := (1 : G)) U (by simp) (hNGU N hj)
    obtain ⟨j', rfl⟩ := (hk j).1 hσj
    refine ⟨j', (hNG N _).1 ?_⟩
    rw [Subgroup.coe_mul, Subgroup.coe_inv, hτpow]
    exact hj
  · intro N
    have hN₀ := hNGU N
    obtain ⟨r₀, hr₀⟩ := hkdvd (NG N) hN₀
    obtain ⟨N₁, hN₁₀, t, ht, hcase⟩ : ∃ N₁ : OpenSubgroup G, N₁ ≤ NG N ∧ ∃ t : ℕ,
        levelOrder hcomm N₁ σ = t * levelOrder hcomm (NG N) σ ∧
          (¬ p ∣ levelOrder hcomm N₁ σ ∨ p ∣ t) := by
      rcases hpow with hpow | hprime
      · obtain ⟨V, hV, t, ht, hpt⟩ :=
          exists_deep_prime hp hpow (openNormalOfComm hcomm (NG N))
        exact ⟨V.toOpenSubgroup, hV, t, ht, Or.inr hpt⟩
      · exact ⟨NG N, le_rfl, 1, (one_mul _).symm, Or.inl (hprime (openNormalOfComm hcomm _))⟩
    have hN₁ : (N₁ : Subgroup G) ≤ U := fun g hg => hN₀ (hN₁₀ hg)
    obtain ⟨r', hr'⟩ := hkdvd N₁ hN₁
    have hkpos : 0 < k := levelOrder_pos hcomm U σ
    refine ⟨NU N₁, fun u hu => (hNG N u).1 (hN₁₀ hu), r', ?_, ?_, ?_⟩
    · rw [hlev N₁ hN₁, hr']
    · intro j hj
      rw [hlev N₁ hN₁, hr'] at hj
      exact Nat.dvd_of_mul_dvd_mul_left hkpos hj
    · rcases hcase with hpr | hpt
      · exact Or.inl fun hpr' => hpr (hr' ▸ dvd_mul_of_dvd_right hpr' k)
      · right
        refine ⟨r₀, t, ?_, hpt, ?_⟩
        · rw [hr', hr₀, ← mul_assoc, mul_comm t k, mul_assoc] at ht
          exact Nat.eq_of_mul_eq_mul_left hkpos ht
        · rw [← hNG, hτpow, ← hr₀]
          exact (pow_mem_iff_levelOrder_dvd hcomm _ σ _).2 dvd_rfl

/-- **The prime base of a procyclic group**: `G` commutative and topologically generated by `σ`,
with, for every prime `p`, either the `p`-power quotients or all finite quotients of order prime
to `p`. -/
theorem hasPrimeBase_of_procyclic
    (hpow : ∀ p : ℕ, p.Prime → HasPrimePowerQuotients σ p ∨
      ∀ N : OpenNormalSubgroup G, ¬ p ∣ orderOf (σ : G ⧸ (N : Subgroup G))) :
    HasPrimeBase G := fun p hp =>
  ⟨⊤, inferInstance, isOpen_univ, by rw [Subgroup.index_top]; exact hp.not_dvd_one,
    fun U _ => vanishesTwo_trivialMod_openSubgroup hcomm hgen hp (hpow p hp) U⟩

end Procyclic

end Stacks.GroupCohomology

end
