module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GroupCohomology.Coinduction
import Mathlib.GroupTheory.FiniteAbelian.Basic

/-!
# Submodules, quotients and products of discrete modules

Let `G` be a topological group and `M` a discrete `G`-module. A subgroup of `M` stable under `G`
is again a discrete `G`-module, and so is the quotient of `M` by it; the product of two discrete
`G`-modules with the diagonal action is a discrete `G`-module. This file builds these objects of
`Stacks.GroupCohomology.ContinuousGModule G` concretely, on the underlying abelian groups, together
with their structure morphisms, and gives a criterion for a short complex of discrete modules to be
short exact in terms of underlying groups.

When `G` is compact, the `G`-submodule generated by finitely many torsion elements is finite: the
orbits are finite, since stabilizers are open.

## Main definitions

* `Stacks.GroupCohomology.representation`: the representation of `G` on the underlying group of a
  discrete `G`-module.
* `Stacks.GroupCohomology.subObj`, `Stacks.GroupCohomology.subObjι`: a `G`-stable subgroup and
  its inclusion.
* `Stacks.GroupCohomology.quotObj`, `Stacks.GroupCohomology.quotObjπ`: the quotient by a
  `G`-stable subgroup and the projection.
* `Stacks.GroupCohomology.prodObj`: the product with the diagonal action, with projections
  `Stacks.GroupCohomology.prodObjFst` and `Stacks.GroupCohomology.prodObjSnd`.
* `Stacks.GroupCohomology.generatedSubmodule`: the `G`-stable subgroup generated by a set.

## Main results

* `Stacks.GroupCohomology.shortExact_of_function_exact`: short exactness on underlying groups.
* `Stacks.GroupCohomology.finite_generatedSubmodule`: over a compact group, the submodule
  generated by finitely many torsion elements is finite.

## Implementation notes

Submodules and quotients are taken as subgroups and quotient groups of the underlying abelian
group, with the `ℤ`-module structure they carry as abelian groups.
-/

@[expose] public noncomputable section

open CategoryTheory Limits

universe v w

namespace Stacks.GroupCohomology

variable {G : Type v} [Group G] [TopologicalSpace G]

/-- The representation of `G` on the underlying group of a discrete `G`-module. -/
def representation (M : ContinuousGModule.{v, w} G) : Representation ℤ G M.obj.obj.V where
  toFun g := (M.obj.obj.ρ g).hom
  map_one' := LinearMap.ext (ρ_one_apply M)
  map_mul' a b := LinearMap.ext (ρ_mul_apply M a b)

@[simp]
lemma representation_apply (M : ContinuousGModule.{v, w} G) (g : G) (x : M.obj.obj.V) :
    representation M g x = (M.obj.obj.ρ g).hom x := rfl

/-- A short complex of discrete `G`-modules which is short exact on underlying groups is short
exact. -/
theorem shortExact_of_function_exact (S : ShortComplex (ContinuousGModule.{v, w} G))
    (hf : Function.Injective S.f.hom.hom.hom.hom) (hg : Function.Surjective S.g.hom.hom.hom.hom)
    (hfg : Function.Exact S.f.hom.hom.hom.hom S.g.hom.hom.hom.hom) : S.ShortExact := by
  refine shortExact_of_underlying (ShortComplex.ShortExact.mk' ?_ ?_ ?_)
  · rwa [ShortComplex.ShortExact.moduleCat_exact_iff_function_exact]
  · rwa [ModuleCat.mono_iff_injective]
  · rwa [ModuleCat.epi_iff_surjective]

section Constructions

variable [IsTopologicalGroup G]

section

open scoped Stacks.DiscreteModuleTopology

/-- An action of `G` on an abelian group is continuous for the discrete topology as soon as every
element is fixed by an open subgroup. -/
lemma isContinuous_of_stabilizer {A : Type w} [AddCommGroup A] (ρ : Representation ℤ G A)
    (h : ∀ a, ∃ U : Subgroup G, IsOpen (U : Set G) ∧ ∀ g ∈ U, ρ g a = a) :
    (actionOfRepresentation ℤ G A ρ).IsContinuous := by
  rw [isContinuous_actionOfRepresentation_iff]
  intro a
  obtain ⟨U, hU, hUa⟩ := h a
  exact Subgroup.isOpen_mono (H₂ :=
    { carrier := {g | ρ g a = a}
      one_mem' := by simp
      mul_mem' := fun {x y} hx hy ↦ by
        show ρ (x * y) a = a
        rw [map_mul, Module.End.mul_apply, show ρ y a = a from hy, show ρ x a = a from hx]
      inv_mem' := fun {x} hx ↦ by
        show ρ x⁻¹ a = a
        conv_lhs => rw [← show ρ x a = a from hx]
        rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one, Module.End.one_apply] })
    (fun g hg ↦ hUa g hg) hU

end

variable (M : ContinuousGModule.{v, w} G) (A : AddSubgroup M.obj.obj.V)
  (hA : ∀ g, ∀ a ∈ A, (M.obj.obj.ρ g).hom a ∈ A)

/-- The `ℤ`-module structure of a subgroup as an abelian group. -/
local instance (A : AddSubgroup M.obj.obj.V) : Module ℤ A := AddCommGroup.toIntModule A

/-- The representation of `G` on a `G`-stable subgroup. -/
def subRepresentation : Representation ℤ G A where
  toFun g :=
    { toFun a := ⟨(M.obj.obj.ρ g).hom a, hA g a a.2⟩
      map_add' _ _ := Subtype.ext (map_add _ _ _)
      map_smul' c a :=
        Subtype.ext (map_zsmul (M.obj.obj.ρ g).hom.toAddMonoidHom c (a : M.obj.obj.V)) }
  map_one' := LinearMap.ext fun a ↦ Subtype.ext (ρ_one_apply M a)
  map_mul' a b := LinearMap.ext fun x ↦ Subtype.ext (ρ_mul_apply M a b x)

/-- A `G`-stable subgroup of a discrete `G`-module, as a discrete `G`-module. -/
def subObj : ContinuousGModule.{v, w} G :=
  ofRepresentation (subRepresentation M A hA) (isContinuous_of_stabilizer _ fun a ↦
    ⟨elementStabilizer G M a, isOpen_stabilizer ℤ G M a, fun _ hg ↦ Subtype.ext hg⟩)

@[simp]
lemma subObj_ρ (g : G) (a : A) :
    (((subObj M A hA).obj.obj.ρ g).hom a : A) = ⟨(M.obj.obj.ρ g).hom a, hA g a a.2⟩ := rfl

/-- The inclusion of a `G`-stable subgroup. -/
def subObjι : subObj M A hA ⟶ M :=
  (gModuleHomEquiv G _ _).symm ⟨A.subtype, fun _ _ ↦ rfl⟩

@[simp]
lemma subObjι_apply (a : A) : (subObjι M A hA).hom.hom.hom.hom a = (a : M.obj.obj.V) := rfl

lemma subObjι_injective : Function.Injective (subObjι M A hA).hom.hom.hom.hom :=
  Subtype.val_injective

/-- An element of a `G`-stable subgroup, as an element of the corresponding discrete module. -/
def subObjMk (a : M.obj.obj.V) (ha : a ∈ A) : (subObj M A hA).obj.obj.V := ⟨a, ha⟩

@[simp]
lemma subObjι_subObjMk (a : M.obj.obj.V) (ha : a ∈ A) :
    (subObjι M A hA).hom.hom.hom.hom (subObjMk M A hA a ha) = a := rfl

lemma subObjι_mem (p : (subObj M A hA).obj.obj.V) : (subObjι M A hA).hom.hom.hom.hom p ∈ A :=
  (p : A).2

/-- The representation of `G` on the quotient by a `G`-stable subgroup. -/
def quotRepresentation : Representation ℤ G (M.obj.obj.V ⧸ A) where
  toFun g := (QuotientAddGroup.map A A (M.obj.obj.ρ g).hom.toAddMonoidHom
    (fun a ha ↦ hA g a ha)).toIntLinearMap
  map_one' := LinearMap.ext fun x ↦ by
    induction x using QuotientAddGroup.induction_on with
    | H m => exact congrArg (QuotientAddGroup.mk (s := A)) (ρ_one_apply M m)
  map_mul' a b := LinearMap.ext fun x ↦ by
    induction x using QuotientAddGroup.induction_on with
    | H m => exact congrArg (QuotientAddGroup.mk (s := A)) (ρ_mul_apply M a b m)

/-- The quotient of a discrete `G`-module by a `G`-stable subgroup. -/
def quotObj : ContinuousGModule.{v, w} G :=
  ofRepresentation (quotRepresentation M A hA) (isContinuous_of_stabilizer _ fun a ↦ by
    induction a using QuotientAddGroup.induction_on with
    | H m =>
      exact ⟨elementStabilizer G M m, isOpen_stabilizer ℤ G M m, fun g hg ↦ by
        change (QuotientAddGroup.mk ((M.obj.obj.ρ g).hom m) : M.obj.obj.V ⧸ A) =
          QuotientAddGroup.mk m
        rw [show (M.obj.obj.ρ g).hom m = m from hg]⟩)

/-- The projection onto the quotient by a `G`-stable subgroup. -/
def quotObjπ : M ⟶ quotObj M A hA :=
  (gModuleHomEquiv G _ _).symm ⟨QuotientAddGroup.mk' A, fun _ _ ↦ rfl⟩

@[simp]
lemma quotObjπ_apply (m : M.obj.obj.V) :
    (quotObjπ M A hA).hom.hom.hom.hom m = (QuotientAddGroup.mk m : M.obj.obj.V ⧸ A) := rfl

lemma quotObjπ_surjective : Function.Surjective (quotObjπ M A hA).hom.hom.hom.hom :=
  QuotientAddGroup.mk_surjective

/-- A quotient of a module all of whose elements are killed by a power of `ℓ` has the same
property. -/
lemma quotObj_exists_pow_smul_eq_zero {ℓ : ℕ} (hM : ∀ x : M.obj.obj.V, ∃ k : ℕ, ℓ ^ k • x = 0)
    (q : (quotObj M A hA).obj.obj.V) : ∃ k : ℕ, ℓ ^ k • q = 0 := by
  change M.obj.obj.V ⧸ A at q
  induction q using QuotientAddGroup.induction_on with
  | H m =>
    obtain ⟨k, hk⟩ := hM m
    refine ⟨k, ?_⟩
    show ℓ ^ k • (QuotientAddGroup.mk m : M.obj.obj.V ⧸ A) = 0
    rw [← QuotientAddGroup.mk_nsmul, hk, QuotientAddGroup.mk_zero]

/-- The cardinality of a quotient. -/
lemma card_quotObj_mul [Finite M.obj.obj.V] :
    Nat.card (quotObj M A hA).obj.obj.V * Nat.card A = Nat.card M.obj.obj.V := by
  rw [← A.card_mul_index, mul_comm, AddSubgroup.index]
  rfl

/-- The short complex `0 → A → M → M ⧸ A → 0` of a `G`-stable subgroup. -/
def subQuotShortComplex : ShortComplex (ContinuousGModule.{v, w} G) :=
  ShortComplex.mk (subObjι M A hA) (quotObjπ M A hA)
    (hom_ext fun a ↦ (QuotientAddGroup.eq_zero_iff _).mpr a.2)

/-- The short complex `0 → A → M → M ⧸ A → 0` is short exact. -/
theorem subQuotShortComplex_shortExact : (subQuotShortComplex M A hA).ShortExact :=
  shortExact_of_function_exact _ (subObjι_injective M A hA) (quotObjπ_surjective M A hA)
    fun m ↦ by
      show (QuotientAddGroup.mk m : M.obj.obj.V ⧸ A) = 0 ↔
        m ∈ Set.range (Subtype.val : A → M.obj.obj.V)
      exact (QuotientAddGroup.eq_zero_iff (N := A) m).trans
        ⟨fun h ↦ ⟨⟨m, h⟩, rfl⟩, fun ⟨a, ha⟩ ↦ ha ▸ a.2⟩

variable (N : ContinuousGModule.{v, w} G)

/-- The diagonal representation on a product. -/
def prodRepresentation : Representation ℤ G (M.obj.obj.V × N.obj.obj.V) where
  toFun g := (representation M g).prodMap (representation N g)
  map_one' := by
    ext x
    · exact ρ_one_apply M _
    · exact ρ_one_apply N _
  map_mul' a b := by
    ext x
    · exact ρ_mul_apply M a b _
    · exact ρ_mul_apply N a b _

/-- The product of two discrete `G`-modules with the diagonal action. -/
def prodObj : ContinuousGModule.{v, w} G :=
  ofRepresentation (prodRepresentation M N) (isContinuous_of_stabilizer _ fun a ↦
    ⟨elementStabilizer G M a.1 ⊓ elementStabilizer G N a.2,
      (isOpen_stabilizer ℤ G M a.1).inter (isOpen_stabilizer ℤ G N a.2),
      fun _ hg ↦ Prod.ext hg.1 hg.2⟩)

@[simp]
lemma prodObj_ρ (g : G) (a : M.obj.obj.V × N.obj.obj.V) :
    (((prodObj M N).obj.obj.ρ g).hom a : M.obj.obj.V × N.obj.obj.V) =
      ((M.obj.obj.ρ g).hom a.1, (N.obj.obj.ρ g).hom a.2) := rfl

/-- The first projection of a product. -/
def prodObjFst : prodObj M N ⟶ M :=
  (gModuleHomEquiv G _ _).symm ⟨AddMonoidHom.fst _ _, fun _ _ ↦ rfl⟩

/-- The second projection of a product. -/
def prodObjSnd : prodObj M N ⟶ N :=
  (gModuleHomEquiv G _ _).symm ⟨AddMonoidHom.snd _ _, fun _ _ ↦ rfl⟩

@[simp]
lemma prodObjFst_apply (a : M.obj.obj.V × N.obj.obj.V) :
    (prodObjFst M N).hom.hom.hom.hom a = a.1 := rfl

@[simp]
lemma prodObjSnd_apply (a : M.obj.obj.V × N.obj.obj.V) :
    (prodObjSnd M N).hom.hom.hom.hom a = a.2 := rfl

/-- The `G`-stable subgroup generated by a set: the subgroup generated by its orbits. -/
def generatedSubmodule (T : Set M.obj.obj.V) : AddSubgroup M.obj.obj.V :=
  AddSubgroup.closure {x | ∃ g, ∃ t ∈ T, x = (M.obj.obj.ρ g).hom t}

omit [IsTopologicalGroup G] in
/-- A set is contained in the `G`-stable subgroup it generates. -/
lemma subset_generatedSubmodule (T : Set M.obj.obj.V) :
    T ⊆ generatedSubmodule M T := fun t ht ↦
  AddSubgroup.subset_closure ⟨1, t, ht, (ρ_one_apply M t).symm⟩

omit [IsTopologicalGroup G] in
/-- The subgroup generated by a set is `G`-stable. -/
lemma generatedSubmodule_stable (T : Set M.obj.obj.V) :
    ∀ g, ∀ a ∈ generatedSubmodule M T, (M.obj.obj.ρ g).hom a ∈ generatedSubmodule M T := by
  intro g a ha
  induction ha using AddSubgroup.closure_induction with
  | mem x hx =>
    obtain ⟨g', t, ht, rfl⟩ := hx
    exact AddSubgroup.subset_closure ⟨g * g', t, ht, (ρ_mul_apply M g g' t).symm⟩
  | zero => simp
  | add x y _ _ hx hy =>
    rw [map_add]
    exact add_mem hx hy
  | neg x _ hx =>
    rw [map_neg]
    exact neg_mem hx

omit [IsTopologicalGroup G] in
/-- The subgroup generated by a set is contained in every `G`-stable subgroup containing it. -/
lemma generatedSubmodule_le {T : Set M.obj.obj.V} {A : AddSubgroup M.obj.obj.V}
    (hA : ∀ g, ∀ a ∈ A, (M.obj.obj.ρ g).hom a ∈ A) (hT : T ⊆ A) :
    generatedSubmodule M T ≤ A :=
  (AddSubgroup.closure_le _).mpr fun _ ⟨g, t, ht, hx⟩ ↦ hx ▸ hA g t (hT ht)

/-- **Over a compact group, the subgroup generated by finitely many torsion elements and their
translates is finite.** -/
theorem finite_generatedSubmodule [CompactSpace G] {T : Set M.obj.obj.V} (hT : T.Finite)
    (htors : ∀ t ∈ T, ∃ n : ℕ, 0 < n ∧ n • t = 0) : Finite (generatedSubmodule M T) := by
  set S : Set M.obj.obj.V := {x | ∃ g, ∃ t ∈ T, x = (M.obj.obj.ρ g).hom t}
  have horbit : ∀ t, (Set.range fun g : G ↦ (M.obj.obj.ρ g).hom t).Finite := by
    intro t
    have := Subgroup.quotient_finite_of_isOpen (elementStabilizer G M t)
      (isOpen_stabilizer ℤ G M t)
    refine (Set.finite_range (fun q : G ⧸ elementStabilizer G M t ↦
      (M.obj.obj.ρ q.out).hom t)).subset ?_
    rintro _ ⟨g, rfl⟩
    refine ⟨(g : G ⧸ elementStabilizer G M t), ?_⟩
    obtain ⟨s, hs, hgs⟩ : ∃ s ∈ elementStabilizer G M t,
        (g : G ⧸ elementStabilizer G M t).out = g * s :=
      ⟨g⁻¹ * (g : G ⧸ elementStabilizer G M t).out,
        QuotientGroup.eq.mp (QuotientGroup.out_eq' _).symm, by group⟩
    simp only
    rw [hgs, ρ_mul_apply, show (M.obj.obj.ρ s).hom t = t from hs]
  have hS : S.Finite := by
    refine (hT.biUnion fun t _ ↦ horbit t).subset ?_
    rintro _ ⟨g, t, ht, rfl⟩
    exact Set.mem_biUnion ht ⟨g, rfl⟩
  have hStors : ∀ s ∈ S, ∃ n : ℕ, 0 < n ∧ n • s = 0 := by
    rintro _ ⟨g, t, ht, rfl⟩
    obtain ⟨n, hn, hnt⟩ := htors t ht
    exact ⟨n, hn, by rw [← map_nsmul, hnt, map_zero]⟩
  have : AddGroup.FG (generatedSubmodule M T) :=
    (AddGroup.fg_iff_addSubgroup_fg _).mpr ⟨hS.toFinset, by simp [generatedSubmodule, S]⟩
  have key : ∀ y ∈ AddSubgroup.closure S, ∃ n : ℕ, 0 < n ∧ n • y = 0 := by
    intro y hy
    induction hy using AddSubgroup.closure_induction with
    | mem y hy => exact hStors y hy
    | zero => exact ⟨1, one_pos, smul_zero _⟩
    | add y z _ _ hy hz =>
      obtain ⟨n, hn, hny⟩ := hy
      obtain ⟨m, hm, hmz⟩ := hz
      exact ⟨n * m, Nat.mul_pos hn hm, by
        rw [smul_add, mul_comm n m, mul_smul, hny, smul_zero, mul_comm, mul_smul, hmz,
          smul_zero, add_zero]⟩
    | neg y _ hy =>
      obtain ⟨n, hn, hny⟩ := hy
      exact ⟨n, hn, by rw [smul_neg, hny, neg_zero]⟩
  refine AddCommGroup.finite_of_fg_torsion _ fun x ↦ ?_
  obtain ⟨n, hn, hnx⟩ := key x x.2
  exact isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨n, hn, Subtype.ext hnx⟩

end Constructions

end Stacks.GroupCohomology

end
