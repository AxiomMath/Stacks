module

public import Mathlib.LinearAlgebra.Dimension.Constructions
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
public import Mathlib.Topology.Algebra.OpenSubgroup
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GroupCohomology.PrimeToIndexTransfer

/-!
# Degree two cohomology of an extension by a procyclic group, at the level of cochains

Let `G` be a profinite group, `N` a closed normal subgroup and `M` a discrete `G`-module which is
a vector space over a field `F`, the action being `F`-linear. Assume

* `M ^ N = 0`;
* every locally constant `2`-cocycle of `N` with values in `M` is a coboundary (`H ²(N, M) = 0`);
* `G / N` is topologically generated by the image of one element `σ`: an open subgroup of `G`
  containing `N` and `σ` is all of `G`.

Then any family of locally constant `2`-cocycles of `G` which is linearly independent modulo
coboundaries has at most `dim H ¹(G, M)` members, `H ¹` being the locally constant `1`-cocycles
modulo coboundaries. This is the inequality `h ² ≤ h ¹` coming out of the Hochschild–Serre
spectral sequence for `1 → N → G → G/N → 1` in low degrees: with `M ^ N = 0` and
`H ²(N, M) = 0` one has `H ¹(G, M) = H ¹(N, M) ^ σ` and `H ²(G, M) ↪ H ¹(N, M) / (σ - 1)`, and on
a vector space on which `σ` acts locally finitely the cokernel of `σ - 1` is no larger than its
kernel.

## Main results

* `Stacks.GroupCohomology.exists_isLocallyConstant_extend_of_isClosed`: a locally constant function
  on a closed subgroup extends to a locally constant function on the group.
* `Stacks.GroupCohomology.exists_dOne_eq_of_conjDiff_eq`: the cochain-level injectivity of
  `H ²(G, M) → H ¹(N, M) / (σ - 1)`.
* `Stacks.GroupCohomology.exists_extend_isCocycle₁`: a `σ`-invariant class of `H ¹(N, M)` comes
  from `H ¹(G, M)`.
* `Stacks.GroupCohomology.card_le_finrank_of_linearIndependent_cocycles₂`: the inequality.

## Implementation notes

Everything is done with explicit locally constant cochains, as in
`StacksFrontier.AlgebraicGeometry.EtaleCohomology.GroupCohomology.DiscreteCochains`. A `2`-cocycle
`c` of `G` vanishing on `N × N` gives the `1`-cocycles `ψ_g(n) = c(g, g⁻¹ n g) - c(n, g)` of `N`;
in terms of the extension of `G` by `M` defined by `c` this is the defect of conjugation by the
section over `g` on the splitting over `N`. They satisfy `ψ_{gh} = ψ_g + g · ψ_h + d(c(g, h))`,
and the set of `g` with `ψ_g` a coboundary is an open subgroup containing `N`; if it contains `σ`
it is everything, and because `M ^ N = 0` the trivializations of the `ψ_g` are unique and
assemble into a trivialization of `c`.
-/

@[expose] public noncomputable section

open groupCohomology

universe u v w

namespace Stacks.GroupCohomology

/-! ### Extending locally constant functions from a closed subgroup -/

section Extend

variable {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [TotallyDisconnectedSpace G]

/-- A compact totally disconnected topological group is zero-dimensional. -/
private instance : ZeroDimensionalSpace G :=
  haveI : T2Space G := IsTopologicalGroup.t2Space_iff_one_closed.mpr
    (connectedComponent_eq_singleton (1 : G) ▸ isClosed_connectedComponent)
  inferInstance

/-- An open subgroup of a closed subgroup `N` of a profinite group contains the trace on `N` of an
open normal subgroup of the group. -/
theorem exists_openNormalSubgroup_inf_le {N : Subgroup G} (V : OpenSubgroup N) :
    ∃ W : OpenNormalSubgroup G, ∀ n : N, (n : G) ∈ W → n ∈ V := by
  obtain ⟨U, hU, hUV⟩ := isOpen_induced_iff.mp V.isOpen
  have h1 : (1 : G) ∈ U := by
    have : (1 : N) ∈ Subtype.val ⁻¹' U := hUV ▸ V.one_mem
    simpa using this
  obtain ⟨W, hW⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hU h1
  refine ⟨W, fun n hn => ?_⟩
  have : n ∈ Subtype.val ⁻¹' U := hW hn
  rwa [hUV] at this

/-- **Locally constant functions extend from a closed subgroup.** A locally constant function on
a closed subgroup `N` of a profinite group `G` is the restriction of a locally constant function
on `G`. -/
theorem exists_isLocallyConstant_extend_of_isClosed {N : Subgroup G} (hN : IsClosed (N : Set G))
    {B : Type v} [Zero B] {b : N → B} (hb : IsLocallyConstant b) :
    ∃ b' : G → B, IsLocallyConstant b' ∧ ∀ n : N, b' n = b n := by
  classical
  have : CompactSpace N := isCompact_iff_compactSpace.mp hN.isCompact
  obtain ⟨V, hV⟩ := exists_openSubgroup_forall_mul_right_eq hb
  obtain ⟨W₀, hW₀⟩ := exists_openNormalSubgroup_inf_le V
  set W : Subgroup G := W₀.toSubgroup
  have hWo : IsOpen (W : Set G) := W₀.isOpen'
  have key : ∀ n n' : N, (n : G)⁻¹ * n' ∈ W → b n' = b n := by
    intro n n' h
    have hv : n⁻¹ * n' ∈ V := hW₀ _ (by push_cast; exact h)
    simpa using hV n (n⁻¹ * n') hv
  let b' : G → B := fun g => if h : ∃ n : N, (n : G)⁻¹ * g ∈ W then b h.choose else 0
  refine ⟨b', ?_, fun n => ?_⟩
  · rw [IsLocallyConstant.iff_exists_open]
    intro g₀
    refine ⟨(fun g : G => g₀⁻¹ * g) ⁻¹' (W : Set G), hWo.preimage (by fun_prop),
      by simp [W.one_mem], fun g hg => ?_⟩
    simp only [Set.mem_preimage, SetLike.mem_coe] at hg
    have hiff : (∃ n : N, (n : G)⁻¹ * g ∈ W) ↔ ∃ n : N, (n : G)⁻¹ * g₀ ∈ W := by
      constructor
      · rintro ⟨n, hn⟩
        refine ⟨n, ?_⟩
        have := W.mul_mem hn (W.inv_mem hg)
        rwa [show (n : G)⁻¹ * g * (g₀⁻¹ * g)⁻¹ = (n : G)⁻¹ * g₀ by group] at this
      · rintro ⟨n, hn⟩
        refine ⟨n, ?_⟩
        have := W.mul_mem hn hg
        rwa [show (n : G)⁻¹ * g₀ * (g₀⁻¹ * g) = (n : G)⁻¹ * g by group] at this
    by_cases h : ∃ n : N, (n : G)⁻¹ * g₀ ∈ W
    · have h' := hiff.mpr h
      simp only [b', dif_pos h, dif_pos h']
      refine key _ _ ?_
      have := W.mul_mem (W.mul_mem h.choose_spec hg) (W.inv_mem h'.choose_spec)
      rwa [show (h.choose : G)⁻¹ * g₀ * (g₀⁻¹ * g) * ((h'.choose : G)⁻¹ * g)⁻¹ =
        (h.choose : G)⁻¹ * h'.choose by group] at this
    · have h' : ¬ ∃ n : N, (n : G)⁻¹ * g ∈ W := fun h' => h (hiff.mp h')
      simp only [b', dif_neg h, dif_neg h']
  · have h : ∃ n' : N, (n' : G)⁻¹ * n ∈ W := ⟨n, by simp [W.one_mem]⟩
    simp only [b', dif_pos h]
    exact (key _ _ h.choose_spec).symm

end Extend

/-! ### The conjugation action on cochains of a normal subgroup -/

section Conj

variable {G : Type u} [Group G] {M : Type v} [AddCommGroup M] [DistribMulAction G M]
  (N : Subgroup G) [hN : N.Normal]

/-- Conjugation `n ↦ g⁻¹ n g` on a normal subgroup. -/
def conjInv (g : G) (n : N) : N := ⟨g⁻¹ * n * g, by simpa using hN.conj_mem n n.2 g⁻¹⟩

@[simp] lemma coe_conjInv (g : G) (n : N) : (conjInv N g n : G) = g⁻¹ * n * g := rfl

/-- The action of `G` on `1`-cochains of the normal subgroup `N`:
`(g · z)(n) = g • z(g⁻¹ n g)`. -/
def conjAct (g : G) (z : N → M) : N → M := fun n => g • z (conjInv N g n)

@[simp] lemma conjAct_apply (g : G) (z : N → M) (n : N) :
    conjAct N g z n = g • z (conjInv N g n) := rfl

/-- `conjAct` is an action: `(g h) · z = g · (h · z)`. -/
lemma conjAct_mul (g h : G) (z : N → M) : conjAct N (g * h) z = conjAct N g (conjAct N h z) := by
  funext n
  simp only [conjAct_apply, mul_smul]
  rw [show conjInv N (g * h) n = conjInv N h (conjInv N g n) from Subtype.ext (by simp [mul_assoc])]

/-- `1 · z = z` for the conjugation action. -/
lemma conjAct_one (z : N → M) : conjAct N 1 z = z := by
  funext n
  simp only [conjAct_apply, one_smul]
  rw [show conjInv N 1 n = n from Subtype.ext (by simp)]

/-- `conjAct N g` is additive. -/
lemma conjAct_add (g : G) (z z' : N → M) :
    conjAct N g (z + z') = conjAct N g z + conjAct N g z' := by
  funext n
  simp [smul_add]

/-- `conjAct N g` commutes with subtraction. -/
lemma conjAct_sub (g : G) (z z' : N → M) :
    conjAct N g (z - z') = conjAct N g z - conjAct N g z' := by
  funext n
  simp [smul_sub]

/-- Conjugation by `g` takes the coboundary of `m` on `N` to the coboundary of `g • m`. -/
lemma conjAct_dZero (g : G) (m : M) :
    conjAct N g (dZero (G := N) m) = dZero (G := N) (g • m) := by
  funext n
  simp only [conjAct_apply, dZero_apply, Subgroup.smul_def, coe_conjInv, smul_sub, ← mul_smul]
  simp [mul_assoc]

/-- The conjugate of a `1`-cocycle of `N` is a `1`-cocycle. -/
lemma isCocycle₁_conjAct (g : G) {z : N → M} (hz : IsCocycle₁ z) :
    IsCocycle₁ (conjAct N g z) := by
  intro n n'
  have : conjInv N g (n * n') = conjInv N g n * conjInv N g n' := by
    ext; simp [mul_assoc]
  simp only [conjAct_apply, this]
  rw [hz (conjInv N g n) (conjInv N g n'), smul_add, Subgroup.smul_def, Subgroup.smul_def,
    ← mul_smul, ← mul_smul, coe_conjInv, show g * (g⁻¹ * (n : G) * g) = n * g by group]

/-- Conjugating a `1`-cocycle of `N` by an element of `N` changes it by a coboundary. -/
lemma conjAct_sub_eq_dZero {z : N → M} (hz : IsCocycle₁ z) (n₀ : N) :
    conjAct N n₀ z - z = dZero (G := N) (z n₀) := by
  funext n
  have e : (n₀ : G) * (conjInv N n₀ n : G) = n * n₀ := by simp [mul_assoc]
  have e' : n₀ * conjInv N n₀ n = n * n₀ := Subtype.ext e
  have h1 := hz n₀ (conjInv N n₀ n)
  have h2 := hz n n₀
  rw [e'] at h1
  simp only [Pi.sub_apply, conjAct_apply, dZero_apply]
  rw [Subgroup.smul_def] at h1
  have : (n₀ : G) • z (conjInv N n₀ n) = n • z n₀ + z n - z n₀ := by
    rw [eq_sub_iff_add_eq, ← h1, h2]
  rw [this]
  abel

/-- The commutator `n⁻¹ w⁻¹ n w` of `w` in a normal subgroup lies in it. -/
private lemma inv_mul_inv_mul_mem {W : Subgroup G} (hW : W.Normal) {w : G} (hw : w ∈ W) (n : G) :
    n⁻¹ * w⁻¹ * n * w ∈ W :=
  W.mul_mem (by simpa using hW.conj_mem _ (W.inv_mem hw) n⁻¹) hw

end Conj

/-! ### The cocycles `ψ_g` attached to a `2`-cocycle -/

section Psi

variable {G : Type u} [Group G] {M : Type v} [AddCommGroup M] [DistribMulAction G M]
  (N : Subgroup G) [N.Normal]

/-- For a `2`-cochain `c` of `G` and `g ∈ G`, the `1`-cochain `ψ_g(n) = c(g, g⁻¹ n g) - c(n, g)`
of `N`. When `c` is a cocycle vanishing on `N × N`, it is the defect of conjugation by the
section over `g` on the splitting over `N` of the extension defined by `c`. -/
def conjDiff (c : G × G → M) (g : G) : N → M := fun n => c (g, conjInv N g n) - c (n, g)

@[simp] lemma conjDiff_apply (c : G × G → M) (g : G) (n : N) :
    conjDiff N c g n = c (g, g⁻¹ * n * g) - c (n, g) := rfl

/-- `ψ_g` is additive in the `2`-cochain `c`. -/
lemma conjDiff_add (c c' : G × G → M) (g : G) :
    conjDiff N (c + c') g = conjDiff N c g + conjDiff N c' g := by
  funext n; simp only [conjDiff_apply, Pi.add_apply]; abel

/-- `ψ_g` commutes with subtraction of `2`-cochains. -/
lemma conjDiff_sub (c c' : G × G → M) (g : G) :
    conjDiff N (c - c') g = conjDiff N c g - conjDiff N c' g := by
  funext n; simp only [conjDiff_apply, Pi.sub_apply]; abel

variable {N}

/-- `ψ_g` is a `1`-cocycle of `N` when `c` is a `2`-cocycle vanishing on `N × N`. -/
lemma isCocycle₁_conjDiff {c : G × G → M} (hc : IsCocycle₂ c)
    (hcN : ∀ n n' : G, n ∈ N → n' ∈ N → c (n, n') = 0) (g : G) :
    IsCocycle₁ (conjDiff N c g) := by
  intro n n'
  set a : G := g⁻¹ * n * g
  set a' : G := g⁻¹ * n' * g
  have ha : a ∈ N := (conjInv N g n).2
  have ha' : a' ∈ N := (conjInv N g n').2
  have e1 : g⁻¹ * ((n : G) * n') * g = a * a' := by simp [a, a', mul_assoc]
  have e2 : g * a = n * g := by simp [a, mul_assoc]
  have e3 : g * a' = n' * g := by simp [a', mul_assoc]
  have h1 := hc g a a'
  have h2 := hc n g a'
  have h3 := hc n n' g
  rw [hcN a a' ha ha', smul_zero, zero_add, e2] at h1
  rw [e3] at h2
  rw [hcN n n' n.2 n'.2, add_zero] at h3
  simp only [conjDiff_apply, Subgroup.coe_mul, e1, Subgroup.smul_def, smul_sub]
  show c (g, a * a') - c ((n : G) * n', g) = (n : G) • c (g, a') - (n : G) • c (n', g) +
    (c (g, a) - c (n, g))
  rw [← h1] at *
  have : c ((n : G) * g, a') = (n : G) • c (g, a') + c (n, n' * g) - c (n, g) := by
    rw [← h2]; abel
  rw [this, show c (n, (n' : G) * g) = c ((n : G) * n', g) - (n : G) • c (n', g) by
    rw [h3]; abel]
  abel

/-- `ψ_n = 0` for `n ∈ N` when `c` vanishes on `N × N`. -/
lemma conjDiff_of_mem {c : G × G → M} (hcN : ∀ n n' : G, n ∈ N → n' ∈ N → c (n, n') = 0)
    {g : G} (hg : g ∈ N) : conjDiff N c g = 0 := by
  funext n
  simp only [conjDiff_apply, Pi.zero_apply]
  rw [hcN _ _ hg (by simpa using (conjInv N g n).2), hcN _ _ n.2 hg, sub_zero]

/-- **The cocycle relation of the `ψ_g`.** `ψ_{gh} = ψ_g + g · ψ_h + d(c(g, h))`. -/
lemma conjDiff_mul {c : G × G → M} (hc : IsCocycle₂ c) (g h : G) :
    conjDiff N c (g * h) =
      conjDiff N c g + conjAct N g (conjDiff N c h) + dZero (G := N) (c (g, h)) := by
  funext n
  set b : G := g⁻¹ * n * g
  set a : G := h⁻¹ * b * h
  have ea : (g * h)⁻¹ * n * (g * h) = a := by simp [a, b, mul_assoc]
  have e1 : h * a = b * h := by simp [a, mul_assoc]
  have e2 : g * b = n * g := by simp [b, mul_assoc]
  have h1 := hc g h a
  have h2 := hc g b h
  have h3 := hc n g h
  rw [e1] at h1
  rw [e2] at h2
  simp only [conjDiff_apply, Pi.add_apply, conjAct_apply, dZero_apply, coe_conjInv,
    Subgroup.smul_def, smul_sub, ea]
  show c (g * h, a) - c (n, g * h) = c (g, b) - c (n, g) + (g • c (h, a) - g • c (b, h)) +
    ((n : G) • c (g, h) - c (g, h))
  have k1 : c (g * h, a) = g • c (h, a) + c (g, b * h) - c (g, h) := by rw [← h1]; abel
  have k2 : c (g, b * h) = c ((n : G) * g, h) + c (g, b) - g • c (b, h) := by rw [h2]; abel
  have k3 : c ((n : G) * g, h) = (n : G) • c (g, h) + c (n, g * h) - c (n, g) := by
    rw [← h3]; abel
  rw [k1, k2, k3]
  abel

/-- **Changing `c` by the coboundary of an extension of a cochain of `N`.** If `z' : G → M`
restricts to `z` on `N`, then `ψ` changes by `-(g · z - z)` up to the coboundary of `z'(g)`. -/
lemma conjDiff_sub_dOne (c : G × G → M) (z' : G → M) (g : G) :
    conjDiff N (c - dOne z') g = conjDiff N c g -
      (conjAct N g (fun n : N => z' n) - fun n : N => z' n) + dZero (G := N) (z' g) := by
  funext n
  have e : g * (g⁻¹ * n * g) = n * g := by simp [mul_assoc]
  simp only [conjDiff_apply, Pi.sub_apply, Pi.add_apply, dOne_apply, conjAct_apply, coe_conjInv,
    dZero_apply, Subgroup.smul_def, e]
  abel

end Psi


/-! ### Linear structure -/

section Linear

variable (F : Type w) [Field F] {K : Type u} [Group K] {M : Type v} [AddCommGroup M]
  [DistribMulAction K M] [Module F M] [SMulCommClass K F M]

/-- `dZero` as an `F`-linear map. -/
def dZeroₗ : M →ₗ[F] (K → M) where
  toFun := dZero
  map_add' x y := by funext g; simp only [dZero_apply, smul_add, Pi.add_apply]; abel
  map_smul' a x := by funext g; simp [dZero_apply, smul_comm g a x, smul_sub]

/-- `dOne` as an `F`-linear map. -/
def dOneₗ : (K → M) →ₗ[F] (K × K → M) where
  toFun := dOne
  map_add' x y := by
    funext ⟨g, h⟩; simp only [dOne_apply, Pi.add_apply, smul_add]; abel
  map_smul' a x := by
    funext ⟨g, h⟩; simp [dOne_apply, smul_comm g a, smul_sub, smul_add]

@[simp] lemma dZeroₗ_apply (x : M) : dZeroₗ F (K := K) x = dZero x := rfl
@[simp] lemma dOneₗ_apply (x : K → M) : dOneₗ F x = dOne x := rfl

variable [TopologicalSpace K] (K M)

/-- The locally constant `1`-cocycles. -/
def lcCocycles₁ : Submodule F (K → M) where
  carrier := {z | IsLocallyConstant z ∧ IsCocycle₁ z}
  add_mem' {z z'} hz hz' := ⟨hz.1.comp₂ hz'.1 (· + ·), fun g h => by
    simp only [Pi.add_apply, hz.2 g h, hz'.2 g h, smul_add]; abel⟩
  zero_mem' := ⟨IsLocallyConstant.const 0, fun g h => by simp⟩
  smul_mem' a z hz := ⟨hz.1.comp (a • ·), fun g h => by
    simp only [Pi.smul_apply, hz.2 g h, smul_add, smul_comm g a]⟩

/-- The `1`-coboundaries. -/
def coboundaries₁ : Submodule F (K → M) := LinearMap.range (dZeroₗ F (K := K) (M := M))

/-- The locally constant `2`-cocycles. -/
def lcCocycles₂ : Submodule F (K × K → M) where
  carrier := {c | IsLocallyConstant c ∧ IsCocycle₂ c}
  add_mem' {c c'} hc hc' := ⟨hc.1.comp₂ hc'.1 (· + ·), fun g h j => by
    have h1 := hc.2 g h j
    have h2 := hc'.2 g h j
    simp only [Pi.add_apply, smul_add]
    rw [add_add_add_comm, h1, h2]; abel⟩
  zero_mem' := ⟨IsLocallyConstant.const 0, fun g h j => by simp⟩
  smul_mem' a c hc := ⟨hc.1.comp (a • ·), fun g h j => by
    have h1 := hc.2 g h j
    simp only [Pi.smul_apply, smul_comm g a]
    rw [← smul_add, ← smul_add, h1]⟩

/-- **Degree one cohomology built from locally constant cochains**: locally constant
`1`-cocycles modulo coboundaries. -/
abbrev LcH1 : Type _ :=
  lcCocycles₁ F K M ⧸ (coboundaries₁ F K M).comap (lcCocycles₁ F K M).subtype

variable {K M}

/-- The class of a locally constant `1`-cocycle. -/
def LcH1.mk : lcCocycles₁ F K M →ₗ[F] LcH1 F K M := Submodule.mkQ _

/-- Every class in `LcH1` is the class of a locally constant `1`-cocycle. -/
lemma LcH1.mk_surjective : Function.Surjective (LcH1.mk F (K := K) (M := M)) :=
  Submodule.mkQ_surjective _

/-- The class of a locally constant `1`-cocycle vanishes if and only if it is a coboundary. -/
lemma LcH1.mk_eq_zero_iff (z : lcCocycles₁ F K M) :
    LcH1.mk F (K := K) (M := M) z = 0 ↔ ∃ m : M, dZero m = (z : K → M) := by
  show Submodule.Quotient.mk z = 0 ↔ _
  rw [Submodule.Quotient.mk_eq_zero]
  exact LinearMap.mem_range

end Linear

/-! ### Linear algebra: cokernel versus kernel of a locally finite endomorphism -/

/-- **For a locally finite endomorphism the cokernel is no larger than the kernel.** If every
vector of `V` lies in a finite dimensional `T`-stable subspace and the kernel of `T` is finite
dimensional, a family linearly independent modulo the range of `T` has at most
`dim ker T` members. -/
theorem card_le_finrank_ker_of_locallyFinite {F V : Type*} [Field F] [AddCommGroup V]
    [Module F V] (T : V →ₗ[F] V) [FiniteDimensional F (LinearMap.ker T)]
    (hT : ∀ x : V, ∃ W : Submodule F V, FiniteDimensional F W ∧ x ∈ W ∧ ∀ y ∈ W, T y ∈ W)
    {r : ℕ} (v : Fin r → V)
    (hv : ∀ a : Fin r → F, ∑ i, a i • v i ∈ LinearMap.range T → a = 0) :
    r ≤ Module.finrank F (LinearMap.ker T) := by
  classical
  choose W hWfd hvW hWT using fun i => hT (v i)
  set W' : Submodule F V := ⨆ i, W i
  have : FiniteDimensional F W' := Submodule.finiteDimensional_iSup _
  have hW'T : ∀ y ∈ W', T y ∈ W' := by
    intro y hy
    refine Submodule.iSup_induction W (motive := fun y => T y ∈ W') hy
      (fun i y hy => Submodule.mem_iSup_of_mem i (hWT i y hy)) (by simp) ?_
    intro y y' h h'
    rw [map_add]; exact W'.add_mem h h'
  let TW : W' →ₗ[F] W' := T.restrict hW'T
  let vW : Fin r → W' := fun i => ⟨v i, Submodule.mem_iSup_of_mem i (hvW i)⟩
  have hli : LinearIndependent F ((LinearMap.range TW).mkQ ∘ vW) := by
    rw [Fintype.linearIndependent_iff]
    intro a ha
    have h1 : ∑ i, a i • vW i ∈ LinearMap.range TW := by
      rw [← Submodule.Quotient.mk_eq_zero, ← Submodule.mkQ_apply, map_sum]
      simpa [map_smul] using ha
    obtain ⟨w, hw⟩ := h1
    have h2 : ∑ i, a i • v i ∈ LinearMap.range T := by
      refine ⟨w, ?_⟩
      have := congrArg Subtype.val hw
      simpa [TW, vW, LinearMap.restrict_apply] using this
    exact congrFun (hv a h2)
  have h3 := hli.fintype_card_le_finrank
  rw [Fintype.card_fin] at h3
  have h4 := Submodule.finrank_quotient_add_finrank (LinearMap.range TW)
  have h5 := LinearMap.finrank_range_add_finrank_ker TW
  let ι : LinearMap.ker TW →ₗ[F] LinearMap.ker T :=
    { toFun := fun w => ⟨w.1.1, LinearMap.mem_ker.mpr
        (congrArg Subtype.val (LinearMap.mem_ker.mp w.2))⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  have hι : Function.Injective ι := fun w w' h =>
    Subtype.ext (Subtype.ext (congrArg (fun x : LinearMap.ker T => (x : V)) h))
  have h6 := LinearMap.finrank_le_finrank_of_injective hι
  omega

/-! ### The main argument -/

section Main

variable {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  [TotallyDisconnectedSpace G] {M : Type v} [AddCommGroup M] [DistribMulAction G M]
  {N : Subgroup G} [hN : N.Normal]

/-- A function on `G` which is right invariant under an open normal subgroup is locally constant. -/
private lemma isLocallyConstant_of_mul_right_eq {P B : Type*} [Group P] [TopologicalSpace P]
    [IsTopologicalGroup P] (W : OpenNormalSubgroup P) {f : P → B}
    (h : ∀ g w, w ∈ W → f (g * w) = f g) : IsLocallyConstant f := by
  rw [IsLocallyConstant.iff_exists_open]
  intro g₀
  refine ⟨(fun g : P => g₀⁻¹ * g) ⁻¹' (W : Set P), W.isOpen'.preimage (by fun_prop),
    by simp, fun g hg => ?_⟩
  rw [show g = g₀ * (g₀⁻¹ * g) by group, h _ _ hg]

/-- If an open normal subgroup, `N` and `σ` lie in a subgroup `S`, then `S` is all of `G`. -/
private lemma mem_of_openNormalSubgroup_le {P : Type*} [Group P] [TopologicalSpace P]
    [IsTopologicalGroup P] {Q : Subgroup P} {σ : P}
    (hσ : ∀ H : OpenSubgroup P, Q ≤ H → σ ∈ H → H = ⊤)
    {S : Subgroup P} (W : OpenNormalSubgroup P) (hWS : W.toSubgroup ≤ S) (hQS : Q ≤ S)
    (hσS : σ ∈ S) (g : P) : g ∈ S := by
  have hSopen : IsOpen (S : Set P) := Subgroup.isOpen_mono hWS W.isOpen'
  have hStop := hσ ⟨S, hSopen⟩ hQS hσS
  exact show g ∈ (⟨S, hSopen⟩ : OpenSubgroup P) by rw [hStop]; trivial

/-- A `1`-cochain of `G` restricting to `z` on `N` has the same coboundary on `N` as `z`. -/
private lemma dOne_apply_of_forall_eq {P A : Type*} [Group P] [AddCommGroup A]
    [DistribMulAction P A] {Q : Subgroup P} {z : Q → A} {z' : P → A} (hz' : ∀ n : Q, z' n = z n)
    (n n' : Q) : dOne z' (n, n') = dOne z (n, n') := by
  simp only [dOne_apply, Subgroup.smul_def, hz']
  rw [← hz' (n * n')]
  rfl

/-- The coboundary map `dZero` on `N` is additive. -/
lemma dZero_add' (m m' : M) : dZero (G := N) (m + m') = dZero m + dZero m' := by
  funext g; simp only [dZero_apply, smul_add, Pi.add_apply]; abel

/-- The coboundary of `0` on `N` is `0`. -/
lemma dZero_zero' : dZero (G := N) (0 : M) = 0 := by funext g; simp

/-- The coboundary map `dZero` on `N` commutes with negation. -/
lemma dZero_neg' (m : M) : dZero (G := N) (-m) = -dZero m := by
  funext g; simp only [dZero_apply, smul_neg, Pi.neg_apply]; abel

/-- With `M ^ N = 0`, a `0`-cochain is determined by its coboundary on `N`. -/
lemma eq_of_dZero_eq (hfix : ∀ m : M, (∀ n ∈ N, n • m = m) → m = 0) {m m' : M}
    (h : dZero (G := N) m = dZero m') : m = m' := by
  refine sub_eq_zero.mp (hfix _ fun n hn => ?_)
  have := congrFun h ⟨n, hn⟩
  simp only [dZero_apply, Subgroup.smul_def] at this
  rw [smul_sub]
  exact sub_eq_sub_iff_sub_eq_sub.mp this

omit [IsTopologicalGroup G] [CompactSpace G] [TotallyDisconnectedSpace G] in
/-- A `2`-cocycle minus the coboundary of a `1`-cochain is a `2`-cocycle. -/
lemma isCocycle₂_sub_dOne {c : G × G → M} (hc : IsCocycle₂ c) (x : G → M) :
    IsCocycle₂ (c - dOne x) := by
  intro g h j
  have h1 := hc g h j
  have h2 := isCocycle₂_dOne x g h j
  simp only [Pi.sub_apply, smul_sub]
  rw [sub_add_sub_comm, h1, h2]; abel

/-- An open normal subgroup under which a locally constant `2`-cochain is right invariant in both
variables. -/
lemma exists_openNormalSubgroup_forall_mul_right_eq₂ {B : Type*} {c : G × G → B}
    (hc : IsLocallyConstant c) :
    ∃ W : OpenNormalSubgroup G, ∀ x y w w' : G, w ∈ W → w' ∈ W → c (x * w, y * w') = c (x, y) := by
  obtain ⟨V, hV⟩ := exists_openSubgroup_forall_mul_right_eq₂ hc
  obtain ⟨W, hW⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one V.isOpen V.one_mem
  exact ⟨W, fun x y w w' hw hw' => hV x y w w' (hW hw) (hW hw')⟩

/-- An open normal subgroup acting trivially, by conjugation, on a locally constant cochain of a
closed normal subgroup. -/
lemma exists_openNormalSubgroup_conjAct_eq (hNc : IsClosed (N : Set G))
    (hM : HasOpenStabilizers G M) {z : N → M} (hz : IsLocallyConstant z) :
    ∃ W : OpenNormalSubgroup G, ∀ w ∈ W, conjAct N w z = z := by
  have : CompactSpace N := isCompact_iff_compactSpace.mp hNc.isCompact
  obtain ⟨V, hV⟩ := exists_openSubgroup_forall_mul_right_eq hz
  obtain ⟨W₁, hW₁⟩ := exists_openNormalSubgroup_inf_le V
  set U : Set G := (W₁ : Set G) ∩ ⋂ m ∈ Set.range z, {g : G | g • m = m}
  have hU : IsOpen U :=
    W₁.isOpen'.inter (hz.range_finite.isOpen_biInter fun m _ => hM m)
  have h1 : (1 : G) ∈ U := ⟨W₁.one_mem', by simp⟩
  obtain ⟨W, hW⟩ := ProfiniteGrp.exist_openNormalSubgroup_sub_open_nhds_of_one hU h1
  refine ⟨W, fun w hw => funext fun n => ?_⟩
  have hwU := hW hw
  simp only [conjAct_apply]
  have e : conjInv N w n = n * ⟨(n : G)⁻¹ * w⁻¹ * n * w, by
      have := (conjInv N w n).2; simpa [mul_assoc] using N.mul_mem (N.inv_mem n.2) this⟩ := by
    ext; simp [mul_assoc]
  have hmem : (⟨(n : G)⁻¹ * w⁻¹ * n * w, by
      have := (conjInv N w n).2
      simpa [mul_assoc] using N.mul_mem (N.inv_mem n.2) this⟩ : N) ∈ V :=
    hW₁ _ (hW (inv_mul_inv_mul_mem W.isNormal' hw n)).1
  rw [e, hV n _ hmem]
  have := hwU.2
  simp only [Set.mem_iInter, Set.mem_range, Set.mem_setOf_eq, forall_exists_index,
    forall_apply_eq_imp_iff] at this
  exact this n


/-- **Cochain-level injectivity of `H ²(G, M) → H ¹(N, M) / (σ - 1)`.** Let `c` be a locally
constant `2`-cocycle of `G` vanishing on `N × N`, and suppose that `ψ_σ = σ · z - z + d m₀` for a
locally constant `1`-cocycle `z` of `N`. If `M ^ N = 0` and an open subgroup containing `N` and
`σ` is all of `G`, then `c` is the coboundary of a locally constant `1`-cochain. -/
theorem exists_dOne_eq_of_conjDiff_eq (hNc : IsClosed (N : Set G)) (hM : HasOpenStabilizers G M)
    (hfix : ∀ m : M, (∀ n ∈ N, n • m = m) → m = 0) {σ : G}
    (hσ : ∀ H : OpenSubgroup G, N ≤ H → σ ∈ H → H = ⊤)
    {c : G × G → M} (hcl : IsLocallyConstant c) (hc : IsCocycle₂ c)
    (hcN : ∀ n n' : G, n ∈ N → n' ∈ N → c (n, n') = 0) {z : N → M} (hzl : IsLocallyConstant z)
    (hz : IsCocycle₁ z) (m₀ : M) (h : conjDiff N c σ = conjAct N σ z - z + dZero m₀) :
    ∃ x : G → M, IsLocallyConstant x ∧ dOne x = c := by
  classical
  obtain ⟨z', hz'l, hz'⟩ := exists_isLocallyConstant_extend_of_isClosed hNc hzl
  have hz'N : (fun n : N => z' n) = z := funext hz'
  set c₁ := c - dOne z' with hc₁def
  have hc₁l : IsLocallyConstant c₁ := hcl.comp₂ (isLocallyConstant_dOne hM hz'l) (· - ·)
  have hc₁ : IsCocycle₂ c₁ := isCocycle₂_sub_dOne hc z'
  have hc₁N : ∀ n n' : G, n ∈ N → n' ∈ N → c₁ (n, n') = 0 := by
    intro n n' hn hn'
    have h1 : dOne z' (n, n') = dOne z (⟨n, hn⟩, ⟨n', hn'⟩) :=
      dOne_apply_of_forall_eq hz' ⟨n, hn⟩ ⟨n', hn'⟩
    simp only [c₁, Pi.sub_apply, hcN n n' hn hn', h1, dOne_apply, hz ⟨n, hn⟩ ⟨n', hn'⟩]
    abel
  have hσ₁ : conjDiff N c₁ σ = dZero (m₀ + z' σ) := by
    rw [hc₁def, conjDiff_sub_dOne, hz'N, h, dZero_add']
    abel
  have hc₁11 : c₁ (1, 1) = 0 := hc₁N 1 1 N.one_mem N.one_mem
  obtain ⟨W, hW⟩ := exists_openNormalSubgroup_forall_mul_right_eq₂ hc₁l
  have hWψ : ∀ w ∈ W, conjDiff N c₁ w = 0 := by
    intro w hw
    funext n
    have hmem : (n : G)⁻¹ * w⁻¹ * n * w ∈ W := inv_mul_inv_mul_mem W.isNormal' hw n
    simp only [conjDiff_apply, Pi.zero_apply]
    have e1 : c₁ (w, w⁻¹ * n * w) = c₁ (1, n) := by
      simpa [mul_assoc] using hW 1 n w ((n : G)⁻¹ * w⁻¹ * n * w) hw hmem
    have e2 : c₁ (n, w) = c₁ (n, 1) := by simpa using hW n 1 1 w W.one_mem hw
    rw [e1, e2, hc₁N _ _ N.one_mem n.2, hc₁N _ _ n.2 N.one_mem, sub_zero]
  let S : Subgroup G :=
    { carrier := {g | ∃ m : M, conjDiff N c₁ g = dZero m}
      one_mem' := ⟨0, by rw [conjDiff_of_mem hc₁N N.one_mem, dZero_zero']⟩
      mul_mem' := by
        rintro g h ⟨m, hm⟩ ⟨m', hm'⟩
        refine ⟨m + g • m' + c₁ (g, h), ?_⟩
        rw [conjDiff_mul hc₁, hm, hm', conjAct_dZero, dZero_add', dZero_add']
      inv_mem' := by
        rintro g ⟨m, hm⟩
        have h1 := conjDiff_mul (N := N) hc₁ g g⁻¹
        rw [mul_inv_cancel, conjDiff_of_mem hc₁N N.one_mem, hm] at h1
        have h2 : conjAct N g (conjDiff N c₁ g⁻¹) = dZero (-(m + c₁ (g, g⁻¹))) := by
          rw [dZero_neg', dZero_add', eq_neg_iff_add_eq_zero]
          calc _ = dZero m + conjAct N g (conjDiff N c₁ g⁻¹) + dZero (c₁ (g, g⁻¹)) := by abel
            _ = 0 := h1.symm
        refine ⟨g⁻¹ • -(m + c₁ (g, g⁻¹)), ?_⟩
        have := congrArg (conjAct N g⁻¹) h2
        rwa [← conjAct_mul, inv_mul_cancel, conjAct_one, conjAct_dZero] at this }
  have hWS : W.toSubgroup ≤ S := fun w hw => ⟨0, by rw [hWψ w hw, dZero_zero']⟩
  have hNS : N ≤ S := fun g hg => ⟨0, by rw [conjDiff_of_mem hc₁N hg, dZero_zero']⟩
  have hall : ∀ g : G, ∃ m : M, conjDiff N c₁ g = dZero m :=
    mem_of_openNormalSubgroup_le (S := S) hσ W hWS hNS ⟨m₀ + z' σ, hσ₁⟩
  choose m hm using hall
  have hrel : ∀ g h : G, m (g * h) = m g + g • m h + c₁ (g, h) := by
    intro g h
    refine eq_of_dZero_eq hfix ?_
    rw [← hm, conjDiff_mul hc₁, hm, hm, conjAct_dZero, dZero_add', dZero_add']
  have hmW : ∀ w ∈ W, m w = 0 := fun w hw =>
    eq_of_dZero_eq hfix (by rw [← hm, hWψ w hw, dZero_zero'])
  have hml : IsLocallyConstant m := by
    refine isLocallyConstant_of_mul_right_eq W fun g w hw => ?_
    rw [hrel, hmW _ hw, smul_zero, add_zero]
    have := hW g 1 1 w W.one_mem hw
    simp only [mul_one, one_mul] at this
    rw [this, isCocycle₂_apply_one hc₁, hc₁11, smul_zero, add_zero]
  refine ⟨z' - m, hz'l.comp₂ hml (· - ·), ?_⟩
  funext ⟨g, h⟩
  have := hrel g h
  simp only [c₁, dOne_apply, Pi.sub_apply, smul_sub] at this ⊢
  rw [this]
  abel

/-- **`σ`-invariant classes of `H ¹(N, M)` come from `H ¹(G, M)`.** If `z` is a locally constant
`1`-cocycle of `N` with `σ · z - z` a coboundary, `M ^ N = 0`, and an open subgroup containing
`N` and `σ` is all of `G`, then `z` is the restriction of a locally constant `1`-cocycle of
`G`. -/
theorem exists_extend_isCocycle₁ (hNc : IsClosed (N : Set G)) (hM : HasOpenStabilizers G M)
    (hfix : ∀ m : M, (∀ n ∈ N, n • m = m) → m = 0) {σ : G}
    (hσ : ∀ H : OpenSubgroup G, N ≤ H → σ ∈ H → H = ⊤)
    {z : N → M} (hzl : IsLocallyConstant z) (hz : IsCocycle₁ z) (m₀ : M)
    (h : conjAct N σ z - z = dZero m₀) :
    ∃ y : G → M, IsLocallyConstant y ∧ IsCocycle₁ y ∧ ∀ n : N, y n = z n := by
  classical
  obtain ⟨W, hW⟩ := exists_openNormalSubgroup_conjAct_eq hNc hM hzl
  have hmul : ∀ g h : G,
      conjAct N (g * h) z - z = conjAct N g (conjAct N h z - z) + (conjAct N g z - z) := by
    intro g h
    rw [conjAct_sub, conjAct_mul]; abel
  let S : Subgroup G :=
    { carrier := {g | ∃ m : M, conjAct N g z - z = dZero m}
      one_mem' := ⟨0, by rw [conjAct_one, sub_self, dZero_zero']⟩
      mul_mem' := by
        rintro g h ⟨m, hm⟩ ⟨m', hm'⟩
        refine ⟨g • m' + m, ?_⟩
        rw [hmul, hm, hm', conjAct_dZero, dZero_add']
      inv_mem' := by
        rintro g ⟨m, hm⟩
        refine ⟨-(g⁻¹ • m), ?_⟩
        have : conjAct N g⁻¹ z - z = -conjAct N g⁻¹ (conjAct N g z - z) := by
          rw [conjAct_sub, ← conjAct_mul, inv_mul_cancel, conjAct_one]; abel
        rw [this, hm, conjAct_dZero, dZero_neg'] }
  have hWS : W.toSubgroup ≤ S := fun w hw => ⟨0, by rw [hW w hw, sub_self, dZero_zero']⟩
  have hNS : N ≤ S := fun g hg => ⟨z ⟨g, hg⟩, conjAct_sub_eq_dZero N hz ⟨g, hg⟩⟩
  have hall : ∀ g : G, ∃ m : M, conjAct N g z - z = dZero m :=
    mem_of_openNormalSubgroup_le (S := S) hσ W hWS hNS ⟨m₀, h⟩
  choose m hm using hall
  have hrel : ∀ g h : G, m (g * h) = g • m h + m g := by
    intro g h
    refine eq_of_dZero_eq hfix ?_
    rw [← hm, hmul, hm, hm, conjAct_dZero, dZero_add']
  have hmW : ∀ w ∈ W, m w = 0 := fun w hw =>
    eq_of_dZero_eq hfix (by rw [← hm, hW w hw, sub_self, dZero_zero'])
  refine ⟨m, ?_, hrel, fun n => eq_of_dZero_eq hfix (by rw [← hm, conjAct_sub_eq_dZero N hz n])⟩
  exact isLocallyConstant_of_mul_right_eq W fun g w hw => by
    rw [hrel, hmW _ hw, smul_zero, zero_add]

/-- **The action of `σ` on `H ¹(N, M)` is locally finite**: some positive power of `σ` fixes a
given locally constant cochain of `N` on the nose. -/
theorem exists_pow_conjAct_eq (hNc : IsClosed (N : Set G)) (hM : HasOpenStabilizers G M)
    (σ : G) {z : N → M} (hzl : IsLocallyConstant z) :
    ∃ k : ℕ, 0 < k ∧ conjAct N (σ ^ k) z = z := by
  obtain ⟨W, hW⟩ := exists_openNormalSubgroup_conjAct_eq hNc hM hzl
  have : W.toSubgroup.Normal := W.isNormal'
  have : Finite (G ⧸ W.toSubgroup) := Subgroup.quotient_finite_of_isOpen _ W.isOpen'
  refine ⟨W.toSubgroup.index, Nat.pos_of_ne_zero Subgroup.index_ne_zero_of_finite,
    hW _ (Subgroup.pow_index_mem _ σ)⟩

end Main

/-! ### The inequality `h ² ≤ h ¹` -/

section Inequality

variable (F : Type w) [Field F] {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G]
  [CompactSpace G] [TotallyDisconnectedSpace G] {M : Type v} [AddCommGroup M]
  [DistribMulAction G M] [Module F M] [SMulCommClass G F M] {N : Subgroup G} [hN : N.Normal]

omit [IsTopologicalGroup G] [CompactSpace G] [TotallyDisconnectedSpace G] in
/-- `conjAct N g` commutes with scalar multiplication by `F`. -/
lemma conjAct_smul (g : G) (a : F) (z : N → M) : conjAct N g (a • z) = a • conjAct N g z := by
  funext n; simp [smul_comm g a]

omit [IsTopologicalGroup G] [CompactSpace G] [TotallyDisconnectedSpace G] in
/-- `ψ_g` of an `F`-linear combination of `2`-cochains is the same combination of the `ψ_g`. -/
lemma conjDiff_sum {r : ℕ} (a : Fin r → F) (c : Fin r → G × G → M) (g : G) :
    conjDiff N (∑ i, a i • c i) g = ∑ i, a i • conjDiff N (c i) g := by
  funext n
  simp only [conjDiff_apply, Finset.sum_apply, Pi.smul_apply, smul_sub, Finset.sum_sub_distrib]

/-- The conjugate of a locally constant cochain of `N` is locally constant. -/
lemma isLocallyConstant_conjAct {z : N → M} (hz : IsLocallyConstant z) (g : G) :
    IsLocallyConstant (conjAct N g z) :=
  (hz.comp_continuous (show Continuous (conjInv N g) by
    unfold conjInv; fun_prop)).comp (g • ·)

variable (N M) in
/-- Conjugation by `σ` on the locally constant `1`-cocycles of `N`. -/
def conjActCocycles (σ : G) : lcCocycles₁ F N M →ₗ[F] lcCocycles₁ F N M where
  toFun z := ⟨conjAct N σ z, isLocallyConstant_conjAct z.2.1 σ, isCocycle₁_conjAct N σ z.2.2⟩
  map_add' z z' := Subtype.ext (conjAct_add N σ z.1 z'.1)
  map_smul' a z := Subtype.ext (conjAct_smul F (N := N) σ a z.1)

@[simp] lemma coe_conjActCocycles (σ : G) (z : lcCocycles₁ F N M) :
    (conjActCocycles F M N σ z : N → M) = conjAct N σ z := rfl

variable (N M) in
/-- `σ - 1` on `H ¹(N, M)`. -/
def conjActSubOne (σ : G) : LcH1 F N M →ₗ[F] LcH1 F N M :=
  Submodule.mapQ _ _ (conjActCocycles F M N σ - LinearMap.id) (by
    rintro z ⟨m, hm⟩
    refine ⟨σ • m - m, ?_⟩
    change dZero (σ • m - m) = conjAct N σ z.1 - z.1
    have hm' : dZero m = z.1 := hm
    rw [← hm', conjAct_dZero, sub_eq_add_neg, dZero_add', dZero_neg', ← sub_eq_add_neg])

/-- `σ - 1` sends the class of `z` to the class of `σ · z - z`. -/
lemma conjActSubOne_mk (σ : G) (z : lcCocycles₁ F N M) :
    conjActSubOne F M N σ (LcH1.mk F (K := N) (M := M) z) =
      LcH1.mk F (K := N) (M := M) (conjActCocycles F M N σ z - z) := rfl

/-- The `k`-th power of conjugation by `σ` on cocycles is conjugation by `σ ^ k`. -/
lemma coe_pow_conjActCocycles (σ : G) (k : ℕ) (z : lcCocycles₁ F N M) :
    (((conjActCocycles F M N σ) ^ k) z : N → M) = conjAct N (σ ^ k) z := by
  induction k with
  | zero => simp [conjAct_one]
  | succ k ih =>
    rw [pow_succ', Module.End.mul_apply, pow_succ', conjAct_mul, coe_conjActCocycles, ih]

variable (N M) in
/-- Restriction of locally constant `1`-cocycles from `G` to `N`. -/
def restrictCocycles : lcCocycles₁ F G M →ₗ[F] lcCocycles₁ F N M where
  toFun z := ⟨fun n => z.1 n, z.2.1.comp_continuous continuous_subtype_val,
    fun n n' => z.2.2 n n'⟩
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

variable (N M) in
/-- Restriction `H ¹(G, M) → H ¹(N, M)`. -/
def restrictH1 : LcH1 F G M →ₗ[F] LcH1 F N M :=
  Submodule.mapQ _ _ (restrictCocycles F M N) (by
    rintro z ⟨m, hm⟩
    refine ⟨m, ?_⟩
    funext n
    simpa [restrictCocycles, Subgroup.smul_def] using congrFun hm n)

/-- **`h ² ≤ h ¹` for an extension by a procyclic group.** Let `N` be a closed normal subgroup
of the profinite group `G` with `M ^ N = 0` and `H ²(N, M) = 0` (cochain level), and let `σ`
generate `G` modulo `N` topologically. Then a family of locally constant `2`-cocycles of `G`
which is linearly independent modulo locally constant coboundaries has at most
`dim H ¹(G, M)` members. -/
theorem card_le_finrank_of_linearIndependent_cocycles₂ (hNc : IsClosed (N : Set G))
    (hM : HasOpenStabilizers G M) (hfix : ∀ m : M, (∀ n ∈ N, n • m = m) → m = 0)
    (hvan : VanishesTwo N M) {σ : G} (hσ : ∀ H : OpenSubgroup G, N ≤ H → σ ∈ H → H = ⊤)
    [FiniteDimensional F (LcH1 F G M)] {r : ℕ} (c : Fin r → G × G → M)
    (hcl : ∀ i, IsLocallyConstant (c i)) (hc : ∀ i, IsCocycle₂ (c i))
    (hind : ∀ a : Fin r → F,
      (∃ x : G → M, IsLocallyConstant x ∧ dOne x = ∑ i, a i • c i) → a = 0) :
    r ≤ Module.finrank F (LcH1 F G M) := by
  classical
  have hnorm : ∀ i, ∃ b : G → M, IsLocallyConstant b ∧
      ∀ n n' : G, n ∈ N → n' ∈ N → c i (n, n') = dOne b (n, n') := by
    intro i
    obtain ⟨x, hxl, hx⟩ := hvan (fun p : N × N => c i (p.1, p.2))
      ((hcl i).comp_continuous (by fun_prop)) (fun g h j => hc i g h j)
    obtain ⟨b, hbl, hb⟩ := exists_isLocallyConstant_extend_of_isClosed hNc hxl
    refine ⟨b, hbl, fun n n' hn hn' => ?_⟩
    have h1 : dOne b (n, n') = dOne x (⟨n, hn⟩, ⟨n', hn'⟩) :=
      dOne_apply_of_forall_eq hb ⟨n, hn⟩ ⟨n', hn'⟩
    rw [h1, hx]
  choose b hbl hb using hnorm
  set c' : Fin r → G × G → M := fun i => c i - dOne (b i)
  have hc'l : ∀ i, IsLocallyConstant (c' i) := fun i =>
    (hcl i).comp₂ (isLocallyConstant_dOne hM (hbl i)) (· - ·)
  have hc' : ∀ i, IsCocycle₂ (c' i) := fun i => isCocycle₂_sub_dOne (hc i) (b i)
  have hc'N : ∀ i, ∀ n n' : G, n ∈ N → n' ∈ N → c' i (n, n') = 0 := fun i n n' hn hn' => by
    simp only [c', Pi.sub_apply, hb i n n' hn hn', sub_self]
  let ψ : Fin r → lcCocycles₁ F N M := fun i =>
    ⟨conjDiff N (c' i) σ, ((hc'l i).comp_continuous (show Continuous fun n : N =>
        ((σ, conjInv N σ n) : G × G) by unfold conjInv; fun_prop)).comp₂
        ((hc'l i).comp_continuous (show Continuous fun n : N => ((n : G), σ) by fun_prop))
        (· - ·), isCocycle₁_conjDiff (hc' i) (hc'N i) σ⟩
  set T := conjActSubOne F M N σ
  have hker : LinearMap.ker T ≤ LinearMap.range (restrictH1 F M N) := by
    intro v hv
    obtain ⟨z, rfl⟩ := LcH1.mk_surjective F (K := N) (M := M) v
    rw [LinearMap.mem_ker, conjActSubOne_mk, LcH1.mk_eq_zero_iff] at hv
    obtain ⟨m₀, hm₀⟩ := hv
    obtain ⟨y, hyl, hy, hyz⟩ := exists_extend_isCocycle₁ hNc hM hfix hσ z.2.1 z.2.2 m₀
      (show conjAct N σ z.1 - z.1 = dZero m₀ from hm₀.symm)
    refine ⟨LcH1.mk F (K := G) (M := M) ⟨y, hyl, hy⟩, ?_⟩
    show LcH1.mk F (K := N) (M := M) (restrictCocycles F M N ⟨y, hyl, hy⟩) = _
    congr 1
    exact Subtype.ext (funext hyz)
  have : FiniteDimensional F (LinearMap.ker T) :=
    Submodule.finiteDimensional_of_le hker
  have hle : Module.finrank F (LinearMap.ker T) ≤ Module.finrank F (LcH1 F G M) :=
    (Submodule.finrank_mono hker).trans (LinearMap.finrank_range_le _)
  refine le_trans ?_ hle
  refine card_le_finrank_ker_of_locallyFinite T ?_ (fun i => LcH1.mk F (K := N) (M := M) (ψ i)) ?_
  · intro v
    obtain ⟨z, rfl⟩ := LcH1.mk_surjective F (K := N) (M := M) v
    obtain ⟨k, hk, hkz⟩ := exists_pow_conjAct_eq hNc hM σ z.2.1
    let C := conjActCocycles F M N σ
    refine ⟨Submodule.span F
        (Set.range fun i : Fin k => LcH1.mk F (K := N) (M := M) ((C ^ (i : ℕ)) z)),
      FiniteDimensional.span_of_finite F (Set.finite_range _),
      Submodule.subset_span ⟨⟨0, hk⟩, by simp⟩, fun y hy => ?_⟩
    have hgen : ∀ i : Fin k, T (LcH1.mk F (K := N) (M := M) ((C ^ (i : ℕ)) z)) ∈ Submodule.span F
        (Set.range fun i : Fin k => LcH1.mk F (K := N) (M := M) ((C ^ (i : ℕ)) z)) := by
      intro i
      rw [conjActSubOne_mk, map_sub]
      refine Submodule.sub_mem _ ?_ (Submodule.subset_span ⟨i, rfl⟩)
      have e : C ((C ^ (i : ℕ)) z) = (C ^ ((i : ℕ) + 1)) z := by
        rw [pow_succ', Module.End.mul_apply]
      show LcH1.mk F (K := N) (M := M) (C ((C ^ (i : ℕ)) z)) ∈ _
      rw [e]
      by_cases hi : (i : ℕ) + 1 < k
      · exact Submodule.subset_span ⟨⟨(i : ℕ) + 1, hi⟩, rfl⟩
      · have hik : (i : ℕ) + 1 = k := by omega
        have : (C ^ ((i : ℕ) + 1)) z = (C ^ (0 : ℕ)) z := by
          rw [hik]
          refine Subtype.ext ?_
          rw [coe_pow_conjActCocycles, coe_pow_conjActCocycles, hkz, pow_zero, conjAct_one]
        rw [this]
        exact Submodule.subset_span ⟨⟨0, hk⟩, rfl⟩
    have hspan := Submodule.span_le.mpr (show Set.range (fun i : Fin k =>
        LcH1.mk F (K := N) (M := M) ((C ^ (i : ℕ)) z)) ⊆ (Submodule.span F
          (Set.range fun i : Fin k => LcH1.mk F (K := N) (M := M) ((C ^ (i : ℕ)) z))).comap T by
      rintro _ ⟨i, rfl⟩; exact hgen i)
    exact hspan hy
  · intro a ha
    obtain ⟨u, hu⟩ := ha
    obtain ⟨z, rfl⟩ := LcH1.mk_surjective F u
    have hsum' : ∑ i, a i • LcH1.mk F (K := N) (M := M) (ψ i) =
        LcH1.mk F (K := N) (M := M) (∑ i, a i • ψ i) := by
      simp only [map_sum, map_smul]
    rw [conjActSubOne_mk, hsum', ← sub_eq_zero, ← map_sub, LcH1.mk_eq_zero_iff] at hu
    obtain ⟨m₀, hm₀⟩ := hu
    have hsum : conjDiff N (∑ i, a i • c' i) σ = conjAct N σ z.1 - z.1 + dZero (-m₀) := by
      rw [conjDiff_sum, dZero_neg']
      have := hm₀
      simp only [Submodule.coe_sub, Submodule.coe_sum, Submodule.coe_smul] at this
      change dZero m₀ = conjAct N σ z.1 - z.1 - ∑ i, a i • conjDiff N (c' i) σ at this
      rw [this]; abel
    have hs : ∑ i, a i • c' i ∈ lcCocycles₂ F G M :=
      (lcCocycles₂ F G M).sum_mem fun i _ => (lcCocycles₂ F G M).smul_mem (a i)
        (⟨hc'l i, hc' i⟩ : c' i ∈ lcCocycles₂ F G M)
    have hsN : ∀ n n' : G, n ∈ N → n' ∈ N → (∑ i, a i • c' i) (n, n') = 0 := by
      intro n n' hn hn'
      simp [Finset.sum_apply, hc'N _ n n' hn hn']
    obtain ⟨x, hxl, hx⟩ := exists_dOne_eq_of_conjDiff_eq hNc hM hfix hσ hs.1 hs.2 hsN z.2.1 z.2.2
      (-m₀) hsum
    refine hind a ⟨x + ∑ i, a i • b i, ?_, ?_⟩
    · have hs : ∀ t : Finset (Fin r), IsLocallyConstant (∑ i ∈ t, a i • b i) := by
        intro t
        induction t using Finset.induction_on with
        | empty => simpa using IsLocallyConstant.const (0 : M)
        | insert j t hj ih =>
          rw [Finset.sum_insert hj]
          exact ((hbl j).comp (a j • ·)).comp₂ ih (· + ·)
      exact hxl.comp₂ (hs Finset.univ) (· + ·)
    · have e : dOne (x + ∑ i, a i • b i) = dOne x + ∑ i, a i • dOne (b i) := by
        rw [← dOneₗ_apply F, map_add, map_sum]
        simp only [map_smul, dOneₗ_apply]
      rw [e, hx]
      simp only [c', smul_sub, Finset.sum_sub_distrib]
      abel

end Inequality

end Stacks.GroupCohomology
