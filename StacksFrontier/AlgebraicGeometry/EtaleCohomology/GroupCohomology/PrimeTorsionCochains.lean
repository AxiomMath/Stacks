module

public import Mathlib.GroupTheory.Sylow
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GroupCohomology.CochainDevissage
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GroupCohomology.TorsionModuleAlgebra

/-!
# The degree-two cochain statement for a finite module killed by a prime

Let `G` be a profinite group and `A` a finite discrete `G`-module killed by a prime `p`. Then
every locally constant `2`-cocycle of `G` with values in `A` is a coboundary, as soon as the
same holds with values in `ℤ/p` with the trivial action over the open subgroups of `G` whose
index is prime to `p`.

## Main results

* `Stacks.GroupCohomology.vanishesTwo_of_isPGroup`: the statement for a finite module killed by
  `p` over a group acting through a `p`-group, by dévissage along the filtration by fixed
  vectors.
* `Stacks.GroupCohomology.vanishesTwo_of_killed_by_prime`: **the Sylow step.** The statement for
  a finite module killed by `p` over a profinite group, reduced to an open subgroup of index
  prime to `p` which may be taken inside any prescribed open normal subgroup of index prime to
  `p`.

## Implementation notes

Over a group acting through a `p`-group, a nonzero finite module killed by `p` has a nonzero
fixed vector (`Stacks.GroupCohomology.exists_ne_zero_smul_eq_of_isPGroup`), and the cyclic
subgroup it generates is a copy of `ℤ/p` with the trivial action
(`Stacks.GroupCohomology.addEquiv_trivialMod_of_prime`). Dévissage along it
(`Stacks.GroupCohomology.vanishesTwo_of_shortExact`) and induction on the cardinality give the
first result.

For the Sylow step, let `K` be the kernel of the action intersected with the prescribed subgroup
`V`; it is open because the module is finite and each stabiliser is open, and normal. Let `P` be
a `p`-Sylow subgroup of the finite group `G ⧸ K` and `U` its preimage, an open subgroup whose
index is the index of `P` and hence prime to `p`. The action of `U` on the module factors through
`P`, a `p`-group, so the first result applies over `U`; and the transfer
`Stacks.GroupCohomology.exists_dOne_eq_of_openSubgroup` carries the trivialization from `U` back
to `G`, the index being invertible on the module because it is prime to `p` and the module is
killed by `p`. The inclusion `U ≤ V` holds because the image of any element of `U` in `G ⧸ V` has
order a power of `p` dividing the index of `V`, which is prime to `p`.

## References

* [Stacks Project, Tag 03R8](https://stacks.math.columbia.edu/tag/03R8): part (2), whose
  dévissage this is.
-/

@[expose] public section

open groupCohomology

universe u v

namespace Stacks.GroupCohomology

/-! ### A cyclic subgroup of prime order -/

/-- The action of a group element commutes with multiplication by a natural number. -/
private lemma smul_nsmul' {H M : Type*} [Monoid H] [AddCommGroup M] [DistribMulAction H M]
    (h : H) (k : ℕ) (a : M) : h • (k • a) = k • (h • a) :=
  (AddMonoidHom.mk' (fun a : M ↦ h • a) (smul_add h)).map_nsmul k a

section Cyclic

variable {A : Type v} [AddCommGroup A]

/-- In a group in which `p • a₀ = 0`, the subgroup generated by `a₀` consists of the natural
multiples of `a₀`. -/
theorem exists_nsmul_eq_of_mem_closure_singleton {p : ℕ} (hp : 0 < p) {a₀ : A}
    (hpa : p • a₀ = 0) {a : A} (ha : a ∈ AddSubgroup.closure ({a₀} : Set A)) :
    ∃ k : ℕ, a = k • a₀ := by
  obtain ⟨n, rfl⟩ := AddSubgroup.mem_closure_singleton.1 ha
  refine ⟨(n % (p : ℤ)).toNat, ?_⟩
  have hnn : 0 ≤ n % (p : ℤ) := Int.emod_nonneg n (by exact_mod_cast hp.ne')
  have h1 : ((n % (p : ℤ)).toNat : ℤ) = n % (p : ℤ) := Int.toNat_of_nonneg hnn
  rw [← natCast_zsmul, h1]
  have h3 : n - n % (p : ℤ) = (p : ℤ) * (n / (p : ℤ)) := by
    have h := Int.mul_ediv_add_emod n (p : ℤ)
    omega
  have h5 : n • a₀ - (n % (p : ℤ)) • a₀ = 0 := by
    rw [← sub_smul, h3, mul_comm, mul_smul, natCast_zsmul, hpa, smul_zero]
  exact sub_eq_zero.1 h5

end Cyclic

/-! ### Dévissage over a group acting through a `p`-group -/

section PGroup

variable {H : Type u} [Group H] [TopologicalSpace H] [IsTopologicalGroup H]

/-- Let `H` act through the `p`-group `H ⧸ K` on a finite module `A` killed by `p`, with open
stabilizers. If `VanishesTwo H (TrivialMod p)` holds, then `VanishesTwo H A` holds. -/
theorem vanishesTwo_of_isPGroup (K : Subgroup H) [K.Normal] {p : ℕ} (hp : p.Prime)
    (hP : IsPGroup p (H ⧸ K)) (hbase : VanishesTwo H (TrivialMod p)) :
    ∀ (n : ℕ) {A : Type v} [AddCommGroup A] [DistribMulAction H A] [Finite A],
      HasOpenStabilizers H A → (∀ k ∈ K, ∀ a : A, k • a = a) → (∀ a : A, p • a = 0) →
      Nat.card A ≤ n → VanishesTwo H A := by
  intro n
  induction n with
  | zero =>
      intro A _ _ _ _ _ _ hcard
      exact absurd hcard (by simpa using Nat.card_pos.ne')
  | succ n ih =>
      intro A _ _ _ hA hK hkill hcard
      have : NeZero p := ⟨hp.ne_zero⟩
      by_cases htriv : ∀ a : A, a = 0
      · intro F _ hF
        refine ⟨fun _ ↦ 0, IsLocallyConstant.const 0, ?_⟩
        funext q
        rw [htriv (F q)]
        simp [dOne]
      · obtain ⟨a₀, ha₀, hfix⟩ := exists_ne_zero_smul_eq_of_isPGroup K hp hP hK hkill
          (by simpa using htriv)
        set N : AddSubgroup A := AddSubgroup.closure ({a₀} : Set A) with hNdef
        have ha₀N : a₀ ∈ N := AddSubgroup.subset_closure rfl
        have hNfix : ∀ (h : H) (a : A), a ∈ N → h • a = a := by
          intro h a ha
          obtain ⟨k, rfl⟩ := exists_nsmul_eq_of_mem_closure_singleton hp.pos (hkill a₀) ha
          rw [smul_nsmul', hfix h]
        have hNstable : ∀ (h : H), ∀ a ∈ N, h • a ∈ N := by
          intro h a ha
          rw [hNfix h a ha]
          exact ha
        let := subDistribMulAction N hNstable
        let := quotDistribMulAction N hNstable
        have hsubfix : ∀ (h : H) (x : N), h • x = x := by
          intro h x
          refine Subtype.ext ?_
          rw [subDistribMulAction_smul_coe N hNstable]
          exact hNfix h x x.2
        have hsubzero : (⟨a₀, ha₀N⟩ : N) ≠ 0 :=
          fun hc ↦ ha₀ (by simpa using congrArg Subtype.val hc)
        have hsubkill : p • (⟨a₀, ha₀N⟩ : N) = 0 := by
          refine Subtype.ext ?_
          simpa using hkill a₀
        have hsubgen : ∀ x : N, ∃ k : ℕ, x = k • (⟨a₀, ha₀N⟩ : N) := by
          intro x
          obtain ⟨k, hk⟩ := exists_nsmul_eq_of_mem_closure_singleton hp.pos (hkill a₀) x.2
          refine ⟨k, Subtype.ext ?_⟩
          simpa using hk
        have hNvan : VanishesTwo H N := by
          refine vanishesTwo_of_addEquiv
            (addEquiv_trivialMod_of_prime hp (⟨a₀, ha₀N⟩ : N) hsubzero hsubkill hsubgen).symm
            (fun h x ↦ ?_) hbase
          rw [hsubfix, TrivialMod.smul_eq]
        have hcardN : Nat.card N = p :=
          (Nat.card_congr (addEquiv_trivialMod_of_prime hp (⟨a₀, ha₀N⟩ : N) hsubzero hsubkill
            hsubgen).toEquiv).trans (TrivialMod.card p)
        have hmul : Nat.card N * N.index = Nat.card A := AddSubgroup.card_mul_index N
        have hindexpos : 0 < N.index := Nat.card_pos
        have hlt : N.index < Nat.card A := by
          rw [← hmul, hcardN]
          exact lt_mul_left hindexpos hp.one_lt
        have hcardq : Nat.card (A ⧸ N) ≤ n := by
          have h2 : Nat.card (A ⧸ N) = N.index := rfl
          omega
        have hQvan : VanishesTwo H (A ⧸ N) := by
          refine ih (A := A ⧸ N) (hasOpenStabilizers_quot N hNstable hA) ?_ ?_ hcardq
          · intro k hk a
            induction a using QuotientAddGroup.induction_on with
            | H m => rw [quotDistribMulAction_smul_mk N hNstable, hK k hk m]
          · intro a
            induction a using QuotientAddGroup.induction_on with
            | H m =>
                have : p • (QuotientAddGroup.mk m : A ⧸ N) = QuotientAddGroup.mk (p • m) := by
                  simp
                rw [this, hkill m]
                simp
        refine vanishesTwo_of_shortExact hA (AddSubgroup.subtype N) Subtype.val_injective
          (fun h x ↦ (subDistribMulAction_smul_coe N hNstable h x)) (QuotientAddGroup.mk' N)
          (QuotientAddGroup.mk'_surjective N) (fun h m ↦ ?_) (fun z hz ↦ ?_) hNvan hQvan
        · exact (quotDistribMulAction_smul_mk N hNstable h m).symm
        · exact ⟨⟨z, (QuotientAddGroup.eq_zero_iff z).1 hz⟩, rfl⟩

end PGroup

/-! ### The Sylow step -/

section Sylow

variable {G : Type u} [Group G] [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G]
  {A : Type v} [AddCommGroup A] [DistribMulAction G A]

omit [TopologicalSpace G] [IsTopologicalGroup G] [CompactSpace G] in
/-- Membership in the kernel of the action on a module. -/
theorem mem_actionKer_iff [Finite A] (g : G) :
    g ∈ (MulAction.toPermHom G A).ker ↔ ∀ a : A, g • a = a := by
  rw [MonoidHom.mem_ker]
  exact ⟨fun h a ↦ congrFun (congrArg Equiv.toFun h) a, fun h ↦ Equiv.ext h⟩

omit [IsTopologicalGroup G] [CompactSpace G] in
/-- The kernel of the action of `G` on a finite module with open stabilizers is open. -/
theorem isOpen_actionKer [Finite A] (hA : HasOpenStabilizers G A) :
    IsOpen (((MulAction.toPermHom G A).ker : Subgroup G) : Set G) := by
  have hset : (((MulAction.toPermHom G A).ker : Subgroup G) : Set G) =
      ⋂ a : A, {g : G | g • a = a} := by
    ext g
    simp only [SetLike.mem_coe, mem_actionKer_iff, Set.mem_iInter, Set.mem_ofPred_eq]
  rw [hset]
  exact isOpen_iInter_of_finite fun a ↦ hA a

/-- **The Sylow step.** For a finite discrete module killed by a prime `p` over a profinite
group, the degree-two cochain statement follows from the same statement with values in `ℤ/p`
over the open subgroups of index prime to `p` contained in a prescribed open normal subgroup `V`
of index prime to `p`. -/
theorem vanishesTwo_of_killed_by_prime {p : ℕ} (hp : p.Prime)
    (V : Subgroup G) [V.Normal] (hVopen : IsOpen (V : Set G)) (hVp : ¬ p ∣ V.index)
    (hbase : ∀ U : OpenSubgroup G, (U : Subgroup G) ≤ V → VanishesTwo ↥U (TrivialMod p))
    [Finite A] (hA : HasOpenStabilizers G A) (hkill : ∀ a : A, p • a = 0) :
    VanishesTwo G A := by
  classical
  have : Fact p.Prime := ⟨hp⟩
  have : Finite (G ⧸ V) := Subgroup.quotient_finite_of_isOpen V hVopen
  set K : Subgroup G := (MulAction.toPermHom G A).ker ⊓ V with hKdef
  have hKopen : IsOpen ((K : Subgroup G) : Set G) := by
    rw [hKdef]
    exact (isOpen_actionKer hA).inter hVopen
  have hKtriv : ∀ k ∈ K, ∀ a : A, k • a = a := fun k hk ↦ (mem_actionKer_iff k).1 hk.1
  have hKV : K ≤ V := fun _ hk ↦ hk.2
  have : K.Normal := Subgroup.normal_inf_normal _ _
  have : Finite (G ⧸ K) := Subgroup.quotient_finite_of_isOpen K hKopen
  obtain ⟨P⟩ : Nonempty (Sylow p (G ⧸ K)) := Sylow.nonempty
  set U : Subgroup G := Subgroup.comap (QuotientGroup.mk' K) (P : Subgroup (G ⧸ K)) with hUdef
  have hKU : K ≤ U := by
    intro g hg
    refine Subgroup.mem_comap.2 ?_
    rw [show (QuotientGroup.mk' K) g = 1 from (QuotientGroup.eq_one_iff g).2 hg]
    exact one_mem _
  have hUopen : IsOpen ((U : Subgroup G) : Set G) := Subgroup.isOpen_mono hKU hKopen
  set U₀ : OpenSubgroup G := ⟨U, hUopen⟩ with hU₀def
  have hpowK : ∀ u ∈ U, ∃ n : ℕ, u ^ (p ^ n) ∈ K := by
    intro u hu
    obtain ⟨n, hn⟩ := P.isPGroup' ⟨QuotientGroup.mk' K u, Subgroup.mem_comap.1 hu⟩
    exact ⟨n, (QuotientGroup.eq_one_iff _).1 (by simpa using congrArg Subtype.val hn)⟩
  have hUV : (U₀ : Subgroup G) ≤ V := by
    intro u hu
    obtain ⟨n, h2⟩ := hpowK u hu
    have h3 : ((QuotientGroup.mk' V) u) ^ (p ^ n) = 1 := by
      rw [← map_pow]
      exact (QuotientGroup.eq_one_iff _).2 (hKV h2)
    have h4 : orderOf ((QuotientGroup.mk' V) u) ∣ p ^ n := orderOf_dvd_of_pow_eq_one h3
    have hcard : Nat.card (G ⧸ V) = V.index := (Subgroup.index_eq_card V).symm
    have h5 : orderOf ((QuotientGroup.mk' V) u) ∣ V.index :=
      hcard ▸ orderOf_dvd_natCard ((QuotientGroup.mk' V) u)
    have hcop : Nat.Coprime (p ^ n) V.index :=
      Nat.Coprime.pow_left _ ((Nat.Prime.coprime_iff_not_dvd hp).2 hVp)
    exact (QuotientGroup.eq_one_iff u).1
      (orderOf_eq_one_iff.1 (Nat.eq_one_of_dvd_coprimes hcop h4 h5))
  have : (P : Subgroup (G ⧸ K)).FiniteIndex := Subgroup.finiteIndex_of_finite
  have hUindex : (U₀ : Subgroup G).index = (P : Subgroup (G ⧸ K)).index :=
    Subgroup.index_comap_of_surjective _ (QuotientGroup.mk'_surjective K)
  have hUp : ¬ p ∣ (U₀ : Subgroup G).index := by
    rw [hUindex]
    exact P.not_dvd_index
  obtain ⟨k, hk1⟩ : ∃ k : ℤ, (p : ℤ) ∣ k * ((U₀ : Subgroup G).index : ℤ) - 1 := by
    have hcop : Nat.Coprime p (U₀ : Subgroup G).index :=
      (Nat.Prime.coprime_iff_not_dvd hp).2 hUp
    have hb := Nat.gcd_eq_gcd_ab p (U₀ : Subgroup G).index
    rw [hcop] at hb
    refine ⟨Nat.gcdB p (U₀ : Subgroup G).index, -Nat.gcdA p (U₀ : Subgroup G).index, ?_⟩
    push_cast at hb ⊢
    linarith [hb]
  have hk : ∀ a : A, (k * ((U₀ : Subgroup G).index : ℤ)) • a = a := by
    intro a
    obtain ⟨t, ht⟩ := hk1
    have h1 : k * ((U₀ : Subgroup G).index : ℤ) = 1 + (p : ℤ) * t := by linarith [ht]
    rw [h1, add_smul, one_smul, mul_comm (p : ℤ) t, mul_smul, natCast_zsmul, hkill a,
      smul_zero, add_zero]
  have hK' : (K.comap (U₀ : Subgroup G).subtype).Normal := Subgroup.normal_comap _
  have hUvan : VanishesTwo ↥U₀ A := by
    refine vanishesTwo_of_isPGroup (K.comap (U₀ : Subgroup G).subtype) hp ?_
      (hbase U₀ hUV) (Nat.card A) ?_ ?_ hkill le_rfl
    · intro q
      induction q using QuotientGroup.induction_on with
      | H u =>
          obtain ⟨n, h2⟩ := hpowK (u : G) u.2
          refine ⟨n, (QuotientGroup.eq_one_iff _).2 (Subgroup.mem_comap.2 ?_)⟩
          simpa using h2
    · exact fun a ↦ (hA a).preimage continuous_subtype_val
    · exact fun u hu a ↦ hKtriv (u : G) (Subgroup.mem_comap.1 hu) a
  intro F hFlc hF
  have hFres : IsLocallyConstant fun q : ↥U₀ × ↥U₀ ↦ F ((q.1 : G), (q.2 : G)) :=
    hFlc.comp_continuous ((continuous_subtype_val.comp continuous_fst).prodMk
      (continuous_subtype_val.comp continuous_snd))
  have hFrescoc : IsCocycle₂ fun q : ↥U₀ × ↥U₀ ↦ F ((q.1 : G), (q.2 : G)) :=
    fun g h j ↦ hF (g : G) (h : G) (j : G)
  obtain ⟨y, hylc, hy⟩ := hUvan _ hFres hFrescoc
  exact exists_dOne_eq_of_openSubgroup hA U₀ k hk F hFlc hF y hylc fun w v ↦ congrFun hy (w, v)

end Sylow

end Stacks.GroupCohomology

end
