/-!
# Algebra of torsion coefficient modules

Purely algebraic facts about torsion coefficient modules of a group: the module `ZMod p` with
the trivial action, the transport of the vanishing statements along an isomorphism of modules,
the recognition of a cyclic group of prime order, the actions induced on a stable subgroup and
on its quotient, the finiteness of the subgroup generated by finitely many torsion elements, and
the existence of a nonzero fixed vector for the action of a `p`-group on a module killed by `p`.

Nothing here mentions cohomology beyond transporting `Stacks.GroupCohomology.VanishesOne` and
`Stacks.GroupCohomology.VanishesTwo`.

## Main definitions

* `Stacks.GroupCohomology.TrivialMod`: `ZMod p` carrying the trivial action of an arbitrary
  monoid.
* `Stacks.GroupCohomology.subDistribMulAction`,
  `Stacks.GroupCohomology.quotDistribMulAction`: the actions induced on a stable additive
  subgroup and on the quotient by it.

## Main results

* `Stacks.GroupCohomology.vanishesOne_of_addEquiv`,
  `Stacks.GroupCohomology.vanishesTwo_of_addEquiv`: **the vanishing statements transport along
  an equivariant isomorphism of modules.**
* `Stacks.GroupCohomology.addEquiv_trivialMod_of_prime`: **a group generated by one element of
  order `p` is `TrivialMod p`.**
* `Stacks.GroupCohomology.hasOpenStabilizers_sub`,
  `Stacks.GroupCohomology.hasOpenStabilizers_quot`: discreteness passes to a stable subgroup and
  to the quotient by it.
* `Stacks.GroupCohomology.Finite.addSubgroup_closure`: the subgroup generated by finitely many
  torsion elements is finite.
* `Stacks.GroupCohomology.exists_finite_stable_addSubgroup`: **in a discrete torsion module over
  a compact group, every finite set is contained in a finite stable subgroup.**
* `Stacks.GroupCohomology.exists_ne_zero_smul_eq_of_isPGroup`: **a `p`-group acting on a nonzero
  finite module killed by `p` fixes a nonzero vector.**

## Implementation notes

`TrivialMod p` is a type synonym for `ZMod p` rather than `ZMod p` itself, so that the trivial
action of an arbitrary monoid can be declared as an instance without clashing with the actions
`ZMod p` already carries. The `ZMod` facts used — the order, the fact that `p` kills every
element, and that `1` is nonzero for `p` prime — are therefore restated as lemmas about
`TrivialMod`.

The two induced actions depend on the stability hypothesis `hN`, so they are not instances; one
is installed with `letI := subDistribMulAction N hN`. Their characterising equations hold by
`rfl`, and are stated in that same `letI` form so that they can be rewritten with once the
instance is installed.

`exists_finite_stable_addSubgroup` is the place where compactness of the group enters: the
orbit map of an element is locally constant because stabilizers are open, hence has finite range
on a compact group, so the subgroup generated by the orbits of finitely many points is generated
by a finite set of torsion elements.

## References

* [Stacks Project, Tag 04JR](https://stacks.math.columbia.edu/tag/04JR): the continuous
  cohomology whose vanishing the dévissage establishes.
-/

@[expose] public noncomputable section

open groupCohomology

universe u v w

namespace Stacks.GroupCohomology

/-! ### The cyclic coefficient module with trivial action -/

/-- `ZMod p`, carrying the trivial action of any monoid. -/
def TrivialMod (p : ℕ) : Type := ZMod p

namespace TrivialMod

/-- The additive group structure of `ZMod p`. -/
instance instAddCommGroup (p : ℕ) : AddCommGroup (TrivialMod p) :=
  inferInstanceAs (AddCommGroup (ZMod p))

/-- `TrivialMod p` is finite for `p ≠ 0`. -/
instance instFinite (p : ℕ) [NeZero p] : Finite (TrivialMod p) :=
  inferInstanceAs (Finite (ZMod p))

/-- Any monoid acts trivially on `TrivialMod p`. -/
@[sga "5 IIIB 6.18" "special case"]
instance instDistribMulAction {G : Type*} [Monoid G] (p : ℕ) :
    DistribMulAction G (TrivialMod p) where
  smul _ a := a
  one_smul _ := rfl
  mul_smul _ _ _ := rfl
  smul_zero _ := rfl
  smul_add _ _ _ := rfl

/-- Every element of `G` acts on `TrivialMod p` as the identity. -/
@[simp]
lemma smul_eq {G : Type*} [Monoid G] {p : ℕ} (g : G) (a : TrivialMod p) : g • a = a := rfl

/-- `TrivialMod p` is `ZMod p`, as additive groups. -/
def addEquivZMod (p : ℕ) : TrivialMod p ≃+ ZMod p where
  toFun a := a
  invFun a := a
  left_inv _ := rfl
  right_inv _ := rfl
  map_add' _ _ := rfl

/-- Multiplication by `p` kills `TrivialMod p`. -/
theorem nsmul_self_eq_zero {p : ℕ} : ∀ a : TrivialMod p, p • a = 0 :=
  fun a ↦ (addEquivZMod p).injective (by simp)

/-- `TrivialMod p` has `p` elements for `p ≠ 0`. -/
theorem card (p : ℕ) [NeZero p] : Nat.card (TrivialMod p) = p :=
  Nat.card_zmod p

/-- The unit of `TrivialMod p`, a generator. -/
def one (p : ℕ) : TrivialMod p := (1 : ZMod p)

/-- The generator `one p` of `TrivialMod p` is nonzero for `p` prime. -/
theorem one_ne_zero {p : ℕ} (hp : p.Prime) : one p ≠ 0 := by
  have : Fact (1 < p) := ⟨hp.one_lt⟩
  exact _root_.one_ne_zero (α := ZMod p)

end TrivialMod

/-- Every stabilizer of the trivial action on `TrivialMod p` is the whole group. -/
theorem hasOpenStabilizers_trivialMod (G : Type u) [Group G] [TopologicalSpace G] (p : ℕ) :
    HasOpenStabilizers G (TrivialMod p) := by
  intro a
  simp

/-! ### Transport of the vanishing statements along an isomorphism -/

section Transport

variable {G : Type u} [Group G] {M : Type v} {N : Type w} [AddCommGroup M]
  [AddCommGroup N] [DistribMulAction G M] [DistribMulAction G N]

/-- The inverse of an equivariant additive isomorphism is equivariant. -/
lemma addEquiv_symm_smul (e : M ≃+ N) (he : ∀ (g : G) (m : M), e (g • m) = g • e m) (g : G)
    (n : N) : e.symm (g • n) = g • e.symm n := by
  apply e.injective
  rw [e.apply_symm_apply, he, e.apply_symm_apply]

variable [TopologicalSpace G]

/-- **`H ¹` vanishing transports along an equivariant isomorphism of modules.** -/
theorem vanishesOne_of_addEquiv (e : M ≃+ N) (he : ∀ (g : G) (m : M), e (g • m) = g • e m)
    (h : VanishesOne G M) : VanishesOne G N := by
  intro c hc hcoc
  obtain ⟨x, hx⟩ := h (⇑e.symm.toAddMonoidHom ∘ c) (hc.comp _)
    (isCocycle₁_comp e.symm.toAddMonoidHom (by simpa using addEquiv_symm_smul e he) hcoc)
  refine ⟨e x, ?_⟩
  have h2 := dZero_map (G := G) e.toAddMonoidHom (by simpa using he) x
  rw [show e x = e.toAddMonoidHom x from rfl, ← h2, hx]
  funext g
  simp

/-- **`H ²` vanishing transports along an equivariant isomorphism of modules.** -/
theorem vanishesTwo_of_addEquiv (e : M ≃+ N) (he : ∀ (g : G) (m : M), e (g • m) = g • e m)
    (h : VanishesTwo G M) : VanishesTwo G N := by
  intro f hf hfoc
  obtain ⟨x, hxlc, hx⟩ := h (⇑e.symm.toAddMonoidHom ∘ f) (hf.comp _)
    (isCocycle₂_comp e.symm.toAddMonoidHom (by simpa using addEquiv_symm_smul e he) hfoc)
  refine ⟨fun g ↦ e (x g), hxlc.comp _, ?_⟩
  have h2 := dOne_map (G := G) e.toAddMonoidHom (by simpa using he) x
  rw [show (fun g ↦ e (x g)) = fun g ↦ e.toAddMonoidHom (x g) from rfl, ← h2, hx]
  funext p
  simp

end Transport

/-! ### A group generated by an element of prime order -/

/-- **A group generated by a single element of order `p` is `ZMod p`**, with its trivial
action. -/
def addEquiv_trivialMod_of_prime {A : Type v} [AddCommGroup A] {p : ℕ} (hp : p.Prime)
    (a₀ : A) (ha₀ : a₀ ≠ 0) (hpa : p • a₀ = 0) (hgen : ∀ a : A, ∃ k : ℕ, a = k • a₀) :
    A ≃+ TrivialMod p := by
  haveI := Fact.mk hp
  have hord : addOrderOf a₀ = p := addOrderOf_eq_prime hpa ha₀
  have hker : (zmultiplesHom A a₀) (p : ℤ) = 0 := by
    simpa using (natCast_zsmul a₀ p).trans hpa
  set f : ZMod p →+ A := ZMod.lift p ⟨zmultiplesHom A a₀, hker⟩ with hf
  have hsurj : Function.Surjective f := by
    intro a
    obtain ⟨k, hk⟩ := hgen a
    refine ⟨(k : ZMod p), ?_⟩
    have : ((k : ℤ) : ZMod p) = (k : ZMod p) := by push_cast; rfl
    rw [← this, hf, ZMod.lift_coe]
    simp [hk]
  have hinj : Function.Injective f := by
    rw [hf, ZMod.lift_injective]
    intro m hm
    have hdvd : ((addOrderOf a₀ : ℕ) : ℤ) ∣ m :=
      addOrderOf_dvd_iff_zsmul_eq_zero.mpr (by simpa using hm)
    rw [hord] at hdvd
    exact (ZMod.intCast_zmod_eq_zero_iff_dvd m p).mpr hdvd
  exact (AddEquiv.ofBijective f ⟨hinj, hsurj⟩).symm.trans (TrivialMod.addEquivZMod p).symm

/-! ### The actions induced on a stable subgroup and on its quotient -/

section Induced

variable {G : Type u} [Group G] {M : Type v} [AddCommGroup M] [DistribMulAction G M]

/-- The action of `G` on a stable additive subgroup `N` of `M`. Characterised by
`Stacks.GroupCohomology.subDistribMulAction_smul_coe`. -/
@[instance_reducible]
def subDistribMulAction (N : AddSubgroup M) (hN : ∀ (g : G) (m : M), m ∈ N → g • m ∈ N) :
    DistribMulAction G ↥N where
  smul g x := ⟨g • (x : M), hN g x x.2⟩
  one_smul x := Subtype.ext (one_smul G (x : M))
  mul_smul g h x := Subtype.ext (mul_smul g h (x : M))
  smul_zero g := Subtype.ext (smul_zero (A := M) g)
  smul_add g x y := Subtype.ext (smul_add g (x : M) (y : M))

/-- The action of `g` on `x : N` is the action of `g` on `x` in `M`. -/
@[simp]
lemma subDistribMulAction_smul_coe (N : AddSubgroup M)
    (hN : ∀ (g : G) (m : M), m ∈ N → g • m ∈ N) (g : G) (x : ↥N) :
    ((letI := subDistribMulAction N hN; g • x : ↥N) : M) = g • (x : M) := rfl

/-- The action of `G` on the quotient of `M` by a stable additive subgroup `N`. Characterised by
`Stacks.GroupCohomology.quotDistribMulAction_smul_mk`. -/
@[instance_reducible]
def quotDistribMulAction (N : AddSubgroup M) (hN : ∀ (g : G) (m : M), m ∈ N → g • m ∈ N) :
    DistribMulAction G (M ⧸ N) where
  smul g := QuotientAddGroup.lift N
    ((QuotientAddGroup.mk' N).comp (DistribSMul.toAddMonoidHom M g))
    (fun m hm ↦ by simpa using hN g m hm)
  one_smul x := by
    induction x using QuotientAddGroup.induction_on with
    | H m => exact congrArg (QuotientAddGroup.mk (s := N)) (one_smul G m)
  mul_smul g h x := by
    induction x using QuotientAddGroup.induction_on with
    | H m => exact congrArg (QuotientAddGroup.mk (s := N)) (mul_smul g h m)
  smul_zero g := map_zero _
  smul_add g x y := map_add _ x y

/-- The action of `g` on the class of `m` in `M ⧸ N` is the class of `g • m`. -/
@[simp]
lemma quotDistribMulAction_smul_mk (N : AddSubgroup M)
    (hN : ∀ (g : G) (m : M), m ∈ N → g • m ∈ N) (g : G) (m : M) :
    (letI := quotDistribMulAction N hN; g • (QuotientAddGroup.mk m : M ⧸ N)) =
      QuotientAddGroup.mk (g • m) := rfl

variable [TopologicalSpace G]

/-- Discreteness passes to a stable subgroup: the stabilizer of `x` is the stabilizer of its
image in `M`. -/
theorem hasOpenStabilizers_sub (N : AddSubgroup M)
    (hN : ∀ (g : G) (m : M), m ∈ N → g • m ∈ N) (h : HasOpenStabilizers G M) :
    letI := subDistribMulAction N hN; HasOpenStabilizers G ↥N := by
  let := subDistribMulAction N hN
  intro x
  have hset : {g : G | g • x = x} = {g : G | g • (x : M) = (x : M)} := by
    ext g
    rw [Set.mem_ofPred_eq, Set.mem_ofPred_eq, Subtype.ext_iff,
      subDistribMulAction_smul_coe N hN]
  rw [hset]
  exact h _

/-- Discreteness passes to the quotient by a stable subgroup: the stabilizer of the class of `m`
is a subgroup containing the open stabilizer of `m`. -/
theorem hasOpenStabilizers_quot [IsTopologicalGroup G] (N : AddSubgroup M)
    (hN : ∀ (g : G) (m : M), m ∈ N → g • m ∈ N) (h : HasOpenStabilizers G M) :
    letI := quotDistribMulAction N hN; HasOpenStabilizers G (M ⧸ N) := by
  let := quotDistribMulAction N hN
  intro x
  induction x using QuotientAddGroup.induction_on with
  | H m =>
    have hle : MulAction.stabilizer G m ≤ MulAction.stabilizer G (QuotientAddGroup.mk m : M ⧸ N) :=
      fun g hg ↦ by
        simp only [MulAction.mem_stabilizer_iff] at hg ⊢
        rw [quotDistribMulAction_smul_mk N hN, hg]
    have hopen : IsOpen ((MulAction.stabilizer G m : Subgroup G) : Set G) := h m
    exact Subgroup.isOpen_mono hle hopen

end Induced

/-! ### Finiteness of subgroups generated by torsion elements -/

/-- **The subgroup generated by a finite set of torsion elements is finite.** -/
theorem Finite.addSubgroup_closure {M : Type v} [AddCommGroup M] {S : Set M} (hS : S.Finite)
    (htor : ∀ m ∈ S, ∃ n : ℕ, 0 < n ∧ n • m = 0) :
    (AddSubgroup.closure S : Set M).Finite := by
  revert htor
  induction S, hS using Set.Finite.induction_on with
  | empty => intro _; simp
  | @insert a t _ _ ih =>
    intro htor
    have hone : (AddSubgroup.closure ({a} : Set M) : Set M).Finite := by
      obtain ⟨n, hn, hna⟩ := htor a (Set.mem_insert a t)
      rw [← AddSubgroup.zmultiples_eq_closure]
      exact (isOfFinAddOrder_iff_nsmul_eq_zero.mpr ⟨n, hn, hna⟩).finite_zmultiples
    rw [Set.insert_eq, AddSubgroup.closure_union, AddSubgroup.add_normal]
    exact hone.add (ih fun m hm ↦ htor m (Set.mem_insert_of_mem a hm))

/-- **In a discrete torsion module over a compact group, every finite set is contained in a
finite stable subgroup.** -/
theorem exists_finite_stable_addSubgroup {G : Type u} [Group G] [TopologicalSpace G]
    [IsTopologicalGroup G] [CompactSpace G] {M : Type v} [AddCommGroup M]
    [DistribMulAction G M] (hM : HasOpenStabilizers G M)
    (htor : ∀ m : M, ∃ n : ℕ, 0 < n ∧ n • m = 0) {S : Set M} (hS : S.Finite) :
    ∃ N : AddSubgroup M, (N : Set M).Finite ∧ (∀ (g : G) (m : M), m ∈ N → g • m ∈ N) ∧ S ⊆ N := by
  set T : Set M := ⋃ m ∈ S, Set.range fun g : G ↦ g • m with hT
  have hTfin : T.Finite :=
    hS.biUnion fun m _ ↦ (hM.isLocallyConstant_smul m).range_finite
  have hTstable : ∀ (g : G) (m : M), m ∈ T → g • m ∈ T := by
    intro g m hm
    simp only [hT, Set.mem_iUnion, Set.mem_range] at hm ⊢
    obtain ⟨m₀, hm₀, g₀, rfl⟩ := hm
    exact ⟨m₀, hm₀, g * g₀, mul_smul g g₀ m₀⟩
  refine ⟨AddSubgroup.closure T, Finite.addSubgroup_closure hTfin fun m _ ↦ htor m, ?_, ?_⟩
  · intro g m hm
    have hcl : AddSubgroup.closure T ≤
        (AddSubgroup.closure T).comap (DistribSMul.toAddMonoidHom M g) :=
      AddSubgroup.closure_le _ |>.mpr fun x hx ↦ AddSubgroup.subset_closure (hTstable g x hx)
    exact hcl hm
  · intro m hm
    refine AddSubgroup.subset_closure ?_
    simp only [hT, Set.mem_iUnion, Set.mem_range]
    exact ⟨m, hm, 1, one_smul G m⟩

/-! ### A nonzero fixed vector for a `p`-group -/

/-- **A `p`-group acting on a nonzero finite module killed by `p` fixes a nonzero vector.**
Here `H` acts on `A` through the `p`-group `H ⧸ K`. -/
theorem exists_ne_zero_smul_eq_of_isPGroup {H : Type u} [Group H] (K : Subgroup H) [K.Normal]
    {p : ℕ} (hp : p.Prime) (hP : IsPGroup p (H ⧸ K))
    {A : Type v} [AddCommGroup A] [DistribMulAction H A] [Finite A]
    (hK : ∀ k ∈ K, ∀ a : A, k • a = a) (hkill : ∀ a : A, p • a = 0) (hne : ∃ a : A, a ≠ 0) :
    ∃ a : A, a ≠ 0 ∧ ∀ h : H, h • a = a := by
  have := Fact.mk hp
  let : MulAction (H ⧸ K) A := MulAction.ofEndHom
    (QuotientGroup.lift K (MulAction.toEndHom (M := H) (α := A))
      fun k hk ↦ funext fun a ↦ hK k hk a)
  have hsmul : ∀ (h : H) (a : A), (QuotientGroup.mk h : H ⧸ K) • a = h • a := fun _ _ ↦ rfl
  obtain ⟨a₀, ha₀⟩ := hne
  have hdvd : p ∣ Nat.card A := by
    have := addOrderOf_dvd_natCard a₀
    rwa [addOrderOf_eq_prime (hkill a₀) ha₀] at this
  have hfix : p ∣ Nat.card (MulAction.fixedPoints (H ⧸ K) A) :=
    (Nat.modEq_zero_iff_dvd.mp
      ((hP.card_modEq_card_fixedPoints A).symm.trans hdvd.modEq_zero_nat))
  have hzero : (0 : A) ∈ MulAction.fixedPoints (H ⧸ K) A := by
    intro q
    induction q using QuotientGroup.induction_on with
    | H h => rw [hsmul]; exact smul_zero h
  have hpos : 0 < Nat.card (MulAction.fixedPoints (H ⧸ K) A) :=
    Nat.card_pos_iff.mpr ⟨⟨⟨0, hzero⟩⟩, Subtype.finite⟩
  have hlt : 1 < Nat.card (MulAction.fixedPoints (H ⧸ K) A) :=
    hp.one_lt.trans_le (Nat.le_of_dvd hpos hfix)
  rw [Finite.one_lt_card_iff_nontrivial] at hlt
  obtain ⟨⟨a, haf⟩, hane⟩ := exists_ne (⟨0, hzero⟩ : MulAction.fixedPoints (H ⧸ K) A)
  refine ⟨a, fun hcon ↦ hane (Subtype.ext hcon), fun h ↦ ?_⟩
  rw [← hsmul h a]
  exact haf (QuotientGroup.mk h)

end Stacks.GroupCohomology

end
