-- `Stacks.EtaleCohomology.OpenImmersionProductSquare.baseChangeMap`
-- (Kunneth/OpenImmersionProductSquare.lean:105) is built under the standard model.
attribute [local instance] HasDerivedCategory.standard

open LimitBaseChange LimitHigherDirectImage SmallEtaleLimitCohomology

variable {k B L : Type u} [Field k] [CommRing B] [IsDomain B] [Algebra k B]
  [Field L] [Algebra B L] [IsFractionRing B L] [Algebra k L] [IsScalarTower k B L]

variable {Z : Scheme.{u}} (sZ : Z ⟶ Spec (.of k)) [LocallyOfFiniteType sZ] [QuasiCompact sZ]

/-- **The levels: [Stacks, Tag 0F1H].** For an abelian sheaf on `U_j` annihilated by an integer
`d` invertible in `k`, the base change map of the square `S_j ×_k Z ⟵ U_j ×_k Z` over
`S_j ⟵ U_j` is an isomorphism in every degree: `U_j ⟶ S_j` is an open immersion of schemes of
finite type over `k` and `Z` is of finite type over `k`. -/
theorem isIso_higherBaseChangeMapAb_level (i : (Index k B L)ᵒᵖ) (d : ℕ)
    (hd : IsUnit ((d : ℤ) : k))
    (G : Sheaf (smallEtaleTopology ((locSchemes k B L).obj i)) Ab.{u + 1})
    (hG : ∀ (V : ((locSchemes k B L).obj i).Etale) (x : G.obj.obj (op V)), (d : ℤ) • x = 0)
    (q : ℕ) :
    IsIso ((higherBaseChangeMapAb
      ((baseChangeHorizontal (baseSchemes k B L) (baseToField k B L) sZ).app i)
      ((locToBase k B L).app i)
      ((baseChangeDiagramMapOfHom (locToBase k B L) (baseToField k B L) sZ).app i)
      ((baseChangeHorizontal (locSchemes k B L) (locToBase k B L ≫ baseToField k B L) sZ).app i)
      (isPullback_baseChangeDiagramMapOfHom (locToBase k B L) (baseToField k B L) sZ i).w
      q).app G) := by
  let sT := (locToBase k B L).app i ≫ (baseToField k B L).app i
  have hG' : ∀ (t : GeometricPoint ((locSchemes k B L).obj i))
      (a : (smallEtaleStalkAb t.hom).obj G), ∃ n : ℕ, 0 < n ∧ IsUnit ((n : ℤ) : k) ∧ n • a = 0 :=
    fun t a => by
      obtain ⟨n, hn, hu, ha⟩ := (hasTorsionOrdersInvertibleOn_of_zsmul_eq_zero
        (𝟙 (Spec (.of k))) hd G hG).exists_nsmul_eq_zero_smallEtaleStalkAb t a
      exact ⟨n, hn, isUnit_intCast_Γ_Spec_iff.1 hu, ha⟩
  have H := OpenImmersionProductSquare.isIso_baseChangeMap ((baseToField k B L).app i) sT sZ
    ((locToBase k B L).app i) rfl G hG'
  exact OpenImmersionProductSquare.isIso_higherBaseChangeMapAb_of_isPullback_of_productSquare
    ((baseToField k B L).app i) sT sZ ((locToBase k B L).app i) rfl
    (pullback.fst _ _) (pullback.snd _ _) (IsPullback.of_hasPullback _ _)
    (pullback.fst _ _) (pullback.snd _ _) (IsPullback.of_hasPullback _ _)
    _ (isPullback_baseChangeDiagramMapOfHom (locToBase k B L) (baseToField k B L) sZ i).w
    (baseChangeDiagramMapOfHom_app_snd _ _ _ i) q G
    ((isIso_smallEtaleDerivedBaseChangeAb_app_single_iff _ _ _ _ _ G).1 H q)

/-- **Base change over the fraction field, by [Stacks, Tag 0EZT] and [Stacks, Tag 0F1H].** Let
`B` be a domain over a field `k` with fraction field `L`, `S' ≅ Spec(B)` over `k`,
`Spec(L) ⟶ S'` the canonical morphism, and `Z` of finite type and quasi-compact over `k`. For
`X' = Z ×_k S'` and `Y = X' ×_{S'} Spec(L)` the base change map
`(f')⁻¹R^q(Spec L ⟶ S')_*ℤ/dℤ ⟶ R^q h_*ℤ/dℤ` is an isomorphism for every `d` invertible in `k`.

The square is the limit of the squares `Z ×_k S_j ⟵ Z ×_k U_j` over `S_j ⟵ U_j`, with
`S_j = Spec(A_j)` for the finite type `k`-subalgebras `A_j ⊆ B` and `U_j = Spec(A_j[1/g_j])`,
`g_j ∈ A_j` nonzero; base change holds for these by [Stacks, Tag 0F1H], and passes to the limit
by [Stacks, Tag 0EZT]. -/
theorem isIso_higherBaseChangeMapAb_of_fractionField
    {S' : Scheme.{u}} (σ : S' ⟶ Spec (.of B)) [IsIso σ] (s : S' ⟶ Spec (.of k))
    (hs : σ ≫ Spec.map (CommRingCat.ofHom (algebraMap k B)) = s)
    (gL : Spec (.of L) ⟶ S') (hgL : gL ≫ σ = Spec.map (CommRingCat.ofHom (algebraMap B L)))
    {X' Y : Scheme.{u}} (p : X' ⟶ Z) (f' : X' ⟶ S') (hp : IsPullback p f' sZ s)
    (h : Y ⟶ X') (e : Y ⟶ Spec (.of L)) (sq : IsPullback h e f' gL)
    (d : ℕ) (hd : IsUnit ((d : ℤ) : k)) (q : ℕ) :
    IsIso ((higherBaseChangeMapAb f' gL h e sq.w q).app
      ((etaleAbelianInverseImage.{u, u + 1} (gL ≫ s)).obj
        (FirstFailureDiagram.constantZMod (Spec (.of k)) d))) := by
  have hG : ∀ (V : (Spec (.of k)).Etale)
      (x : (FirstFailureDiagram.constantZMod (Spec (.of k)) d).obj.obj (op V)), (d : ℤ) • x = 0 :=
    FirstFailureDiagram.zsmul_constantZMod_eq_zero _ d dvd_rfl
  generalize FirstFailureDiagram.constantZMod (Spec (.of k)) d = G at hG ⊢
  have : IsConnected (Index k B L)ᵒᵖ := IsCofiltered.isConnected _
  -- the limit cones of the bases
  let cS : Cone (baseSchemes k B L) :=
    Cone.mk S' ((Functor.const (Index k B L)ᵒᵖ).map σ ≫ (baseCone k B L).π)
  have : IsIso (show S' ⟶ (baseCone k B L).pt from σ) := inferInstanceAs (IsIso σ)
  have hcS : IsLimit cS := IsLimit.extendIso _ isLimitBaseCone
  let cT : Cone (locSchemes k B L) := Cone.mk (Spec (.of L)) (locCone k B L).π
  have hcT : IsLimit cT := isLimitLocCone
  have hπS : ∀ j, cS.π.app j ≫ (baseToField k B L).app j = s := fun j =>
    (Category.assoc _ _ _).trans
      ((congrArg (σ ≫ ·) (baseCone_π_app_comp_baseToField j)).trans hs)
  have hgS : ∀ j, gL ≫ cS.π.app j = cT.π.app j ≫ (locToBase k B L).app j := fun j =>
    (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ (baseCone k B L).π.app j) hgL).trans (locCone_π_app_comp_locToBase j).symm)
  have hπT : ∀ j, cT.π.app j ≫ (locToBase k B L ≫ baseToField k B L).app j = gL ≫ s :=
    fun j => (Category.assoc _ _ _).symm.trans
      ((congrArg (· ≫ (baseToField k B L).app j) (hgS j).symm).trans
        ((Category.assoc _ _ _).trans (congrArg (gL ≫ ·) (hπS j))))
  -- the inverse system of squares
  let DX := baseChangeDiagram (baseSchemes k B L) (baseToField k B L) sZ
  let DY := baseChangeDiagram (locSchemes k B L) (locToBase k B L ≫ baseToField k B L) sZ
  let fN : DX ⟶ baseSchemes k B L := baseChangeHorizontal _ _ sZ
  let eN : DY ⟶ locSchemes k B L := baseChangeHorizontal _ _ sZ
  let hN : DY ⟶ DX := baseChangeDiagramMapOfHom (locToBase k B L) (baseToField k B L) sZ
  have hsqN : ∀ i, IsPullback (hN.app i) (eN.app i) (fN.app i) ((locToBase k B L).app i) :=
    isPullback_baseChangeDiagramMapOfHom (locToBase k B L) (baseToField k B L) sZ
  have : ∀ {i j : (Index k B L)ᵒᵖ} (a : i ⟶ j), IsAffineHom ((baseSchemes k B L).map a) :=
    fun a => isAffineHom_of_isAffine (X := Spec _) (Y := Spec _) _
  have : ∀ {i j : (Index k B L)ᵒᵖ} (a : i ⟶ j), IsAffineHom ((locSchemes k B L).map a) :=
    fun a => isAffineHom_of_isAffine (X := Spec _) (Y := Spec _) _
  have : ∀ {i j : (Index k B L)ᵒᵖ} (a : i ⟶ j), IsAffineHom (DX.map a) :=
    fun a => isAffineHom_baseChangeDiagram_map _ _ sZ a
  have : ∀ {i j : (Index k B L)ᵒᵖ} (a : i ⟶ j), IsAffineHom (DY.map a) :=
    fun a => isAffineHom_baseChangeDiagram_map _ _ sZ a
  -- the limits of the upper corners
  have hwX : ∀ j, (f' ≫ cS.π.app j) ≫ (baseToField k B L).app j = p ≫ sZ := fun j =>
    (Category.assoc _ _ _).trans ((congrArg (f' ≫ ·) (hπS j)).trans hp.w.symm)
  let pX := baseChangeProjection (baseSchemes k B L) (baseToField k B L) sZ cS.π f' p hwX
  have hcX : IsLimit (Cone.mk X' pX) :=
    isLimit_of_isPullback_stages (isPullback_baseChangeStage _ _ sZ) hp.flip hπS
      (baseChangeProjection_comp_structureMap _ _ sZ cS.π f' p hwX)
      (baseChangeProjection_comp_horizontal _ _ sZ cS.π f' p hwX) hcS
  have hY : IsPullback e (h ≫ p) (gL ≫ s) sZ := (sq.paste_horiz hp).flip
  have hwY : ∀ j, (e ≫ cT.π.app j) ≫ (locToBase k B L ≫ baseToField k B L).app j =
      (h ≫ p) ≫ sZ := fun j =>
    (Category.assoc _ _ _).trans ((congrArg (e ≫ ·) (hπT j)).trans hY.w)
  let pY := baseChangeProjection (locSchemes k B L) (locToBase k B L ≫ baseToField k B L) sZ
    cT.π e (h ≫ p) hwY
  have hcY : IsLimit (Cone.mk Y pY) :=
    isLimit_of_isPullback_stages (isPullback_baseChangeStage _ _ sZ) hY hπT
      (baseChangeProjection_comp_structureMap _ _ sZ cT.π e (h ≫ p) hwY)
      (baseChangeProjection_comp_horizontal _ _ sZ cT.π e (h ≫ p) hwY) hcT
  have hfL : ∀ i, f' ≫ cS.π.app i = pX.app i ≫ fN.app i :=
    fun i => (baseChangeProjection_comp_horizontal _ _ sZ cS.π f' p hwX i).symm
  have heL : ∀ i, e ≫ cT.π.app i = pY.app i ≫ eN.app i :=
    fun i => (baseChangeProjection_comp_horizontal _ _ sZ cT.π e (h ≫ p) hwY i).symm
  have hhL : ∀ i, h ≫ pX.app i = pY.app i ≫ hN.app i := fun i => by
    refine pullback.hom_ext ?_ ?_
    · have e₁ : (h ≫ pX.app i) ≫ fN.app i = (e ≫ cT.π.app i) ≫ (locToBase k B L).app i :=
        calc (h ≫ pX.app i) ≫ fN.app i = h ≫ (f' ≫ cS.π.app i) :=
              (Category.assoc _ _ _).trans (congrArg (h ≫ ·) (hfL i).symm)
          _ = (e ≫ gL) ≫ cS.π.app i :=
              (Category.assoc _ _ _).symm.trans (congrArg (· ≫ cS.π.app i) sq.w)
          _ = (e ≫ cT.π.app i) ≫ (locToBase k B L).app i :=
              (Category.assoc _ _ _).trans
                ((congrArg (e ≫ ·) (hgS i)).trans (Category.assoc _ _ _).symm)
      have e₂ : (pY.app i ≫ hN.app i) ≫ fN.app i =
          (pY.app i ≫ eN.app i) ≫ (locToBase k B L).app i :=
        (Category.assoc _ _ _).trans ((congrArg (pY.app i ≫ ·)
          (baseChangeDiagramMapOfHom_app_fst (locToBase k B L) (baseToField k B L) sZ i)).trans
          (Category.assoc _ _ _).symm)
      exact e₁.trans ((congrArg (· ≫ (locToBase k B L).app i) (heL i)).trans e₂.symm)
    · have e₁ : (h ≫ pX.app i) ≫ pullback.snd _ _ = h ≫ p :=
        (Category.assoc _ _ _).trans
          (congrArg (h ≫ ·) (baseChangeProjection_comp_structureMap _ _ sZ cS.π f' p hwX i))
      have e₂ : (pY.app i ≫ hN.app i) ≫ pullback.snd _ _ = h ≫ p :=
        (Category.assoc _ _ _).trans <| (congrArg (pY.app i ≫ ·)
          (baseChangeDiagramMapOfHom_app_snd (locToBase k B L) (baseToField k B L) sZ i)).trans
          (baseChangeProjection_comp_structureMap _ _ sZ cT.π e (h ≫ p) hwY i)
      exact e₁.trans e₂.symm
  -- the system of the inverse images of `ℤ/dℤ` on `Spec k`
  let sT : ∀ i, (locSchemes k B L).obj i ⟶ Spec (.of k) :=
    fun i => (locToBase k B L ≫ baseToField k B L).app i
  have hsT : ∀ {i j : (Index k B L)ᵒᵖ} (a : i ⟶ j), sT i = (locSchemes k B L).map a ≫ sT j :=
    fun a => ((locToBase k B L ≫ baseToField k B L).naturality a).trans (Category.comp_id _) |>.symm
  have hsc : ∀ i, gL ≫ s = conePi cT i ≫ sT i := fun i => (hπT i).symm
  obtain ⟨hcompat, hpres⟩ := (isColimitPresentation_iff _ _ _).mp
    (isColimitPresentation_pullbackSystem (c := cT) G sT hsT (gL ≫ s) hsc)
  have hstage : ∀ i, IsIso ((higherBaseChangeMapAb (fN.app i) ((locToBase k B L).app i)
      (hN.app i) (eN.app i) (hsqN i).w q).app ((pullbackSystem G sT hsT).obj i)) := fun i =>
    isIso_higherBaseChangeMapAb_level sZ i d hd _
      (OpenImmersionProductSquare.zsmul_etaleAbelianInverseImage_eq_zero (sT i) G d hG) q
  -- [Stacks, Tag 0EZT] (2)
  exact isIso_higherBaseChangeMapAb_of_isLimit_mk (X := X') (S := S') (T := Spec (.of L)) (Y := Y)
    (pX := pX) (pS := cS.π) (pT := (locCone k B L).π) (pY := pY)
    fN (locToBase k B L) hN eN hsqN
    hcX hcS hcT hcY f' gL h e sq.w hfL hgS hhL heL q
    ((etaleAbelianInverseImage.{u, u + 1} (gL ≫ s)).obj G) (pullbackSystem G sT hsT) _
    (fun a => (isCompatibleFamily_iff _ _ _).mp hcompat a) hpres hstage

end Main

/-! ### The last paragraph of the proof of Stacks 0F1I -/

section FunctionField

/-- **The last paragraph of the proof of [Stacks, Tag 0F1I].** Let `k` be a field, `Z` a
quasi-compact scheme locally of finite type over `k` and `n` an integer invertible in `k`. Then
base change holds in the diagrams of [Stacks, Tag 0F1D] over `Z ⟶ Spec k`: for every affine
integral normal `S'` over `k` with algebraically closed function field `L`, every `d ∣ n` and
every `q`, the base change map `(f')⁻¹R^q(Spec L ⟶ S')_*ℤ/dℤ ⟶ R^q h_*ℤ/dℤ` is an isomorphism.

This is `isIso_higherBaseChangeMapAb_of_fractionField` for `B = Γ(S', 𝒪)`, whose fraction field
is the function field of `S'`. -/
theorem functionFieldBaseChange_of_quasiCompact (k : Type u) [Field k] {Z : Scheme.{u}}
    (sZ : Z ⟶ Spec (.of k)) [LocallyOfFiniteType sZ] [QuasiCompact sZ] (n : ℤ)
    (hn : IsUnit (n : k)) : FunctionFieldBaseChange sZ n := by
  intro S' X' Y _ _ _ _ s p f' hp h e sq d hd q _
  let : Algebra k Γ(S', ⊤) := ((Scheme.ΓSpecIso (.of k)).inv ≫ s.appTop).hom.toAlgebra
  let : Algebra k S'.functionField :=
    ((algebraMap Γ(S', ⊤) S'.functionField).comp (algebraMap k Γ(S', ⊤))).toAlgebra
  have : IsScalarTower k Γ(S', ⊤) S'.functionField :=
