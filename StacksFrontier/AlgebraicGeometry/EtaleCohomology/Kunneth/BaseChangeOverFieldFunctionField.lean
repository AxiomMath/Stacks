/-- The inverse image of the constant sheaf `ℤ/dℤ` is the constant sheaf `ℤ/dℤ`. -/
def constantZModInverseImageIso {X Y : Scheme.{u}} (f : X ⟶ Y) (d : ℕ) :
    (etaleAbelianInverseImage.{u, u + 1} f).obj (FirstFailureDiagram.constantZMod Y d) ≅
      FirstFailureDiagram.constantZMod X d :=
  (smallEtalePullbackAbIsoEtaleAbelianInverseImage f).symm.app _ ≪≫
    (FirstFailureFunctionField.smallEtalePullbackAbConstantIso f).app
      (AddCommGrpCat.of (ULift.{u + 1} (ZMod d)))

