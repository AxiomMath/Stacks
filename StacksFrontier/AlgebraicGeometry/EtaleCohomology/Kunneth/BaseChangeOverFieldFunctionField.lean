module

public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Kunneth.BaseChangeOverFieldFirstFailure
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Kunneth.OpenImmersionProductSquareBaseChange
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Kunneth.OpenImmersionProductSquareLowerDimension
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Kunneth.OpenProductLimitBaseChange
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Kunneth.OpenImmersionProductSquareStrictHenselization
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.SmoothBaseChange.SmoothLimitBaseChangeHolds

/-!
# Base change over the function field (the last paragraph of the proof of Stacks 0F1I)

The last paragraph of the proof of [Stacks, Tag 0F1I] reads: *"Write `S' = Spec(B)` so that `L`
is the fraction field of `B`. Write `B = ⋃_{i ∈ I} B_i` as the union of its finite type
`K`-subalgebras `B_i`. Let `J` be the set of pairs `(i, g)` where `i ∈ I` and `g ∈ B_i` nonzero
[...]. Then `L = colim_{(i, g) ∈ J} (B_i)_g`. For `j = (i, g) ∈ J` set `S_j = Spec(B_i)` and
`U_j = Spec((B_i)_g)`. Then the square `X' ⟵ Y` over `S' ⟵ Spec(L)` is the colimit of the
squares `X ×_K S_j ⟵ X ×_K U_j` over `S_j ⟵ U_j`. Thus we may apply Lemma 0EZT to see that it
suffices to prove base change holds in the diagrams on the right which is what we proved in
Lemma 0F1H."*

This file carries that out. The index `J` is realised inside `L`: an index is a pair
`(A, A[1/g])` of a finite type `k`-subalgebra `A ⊆ B` and the subalgebra `A[1/g] ⊆ L` it
generates with `1/g`, for some nonzero `g ∈ A`, ordered by inclusion in both entries; then the
transition maps of both systems of rings are inclusions, and `A[1/g]` is the localization of `A`
away from `g` (`isLocalization_away_localized`), so `U_j ⟶ S_j` is an open immersion.

## Main definitions

All names are in the namespace `Stacks.EtaleCohomology.BaseChangeOverField.FunctionFieldLimit`.

* `Index` — the index set `J`.
* `baseSchemes`, `locSchemes`, `locToBase` — the systems `S_j = Spec(A_j)`,
  `U_j = Spec(A_j[1/g_j])` and the open immersions `U_j ⟶ S_j`.

## Main results

* `isLocalization_away_localized` — `A[1/g]` is the localization of `A` away from `g`.
* `isColimitSubalgebraCocone` — a directed union of subalgebras is their colimit in `CommRingCat`.
* `isIso_higherBaseChangeMapAb_level` — base change for the squares over `S_j ⟵ U_j`, by [Stacks,
  Tag 0F1H].
* `isIso_higherBaseChangeMapAb_of_fractionField` — base change for the square over
  `Spec(B) ⟵ Spec(L)`, by [Stacks, Tag 0EZT].
* `functionFieldBaseChange_of_quasiCompact` — the assertion
  `Stacks.EtaleCohomology.BaseChangeOverField.FunctionFieldBaseChange` of the last paragraph, for
  `Z` quasi-compact and locally of finite type over a field.

## Implementation notes

[Stacks, Tag 0F1H] needs `X` (here `Z`) quasi-compact, which is why the last result asks for it;
the assembly of the proof of Tag 0F1I first reduces to `X` quasi-compact and quasi-separated.
The source's statement is about `R^q`, `q > 0`; the argument gives every `q`.

## References

* [Stacks Project, Tag 0F1I](https://stacks.math.columbia.edu/tag/0F1I)
* [Stacks Project, Tag 0F1H](https://stacks.math.columbia.edu/tag/0F1H)
* [Stacks Project, Tag 0EZT](https://stacks.math.columbia.edu/tag/0EZT)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open AlgebraicGeometry AlgebraicGeometry.Scheme

universe u

namespace Stacks.EtaleCohomology.BaseChangeOverField.FunctionFieldLimit

/-! ### The finite type subalgebras and their principal localizations -/

section Algebra

variable {k B : Type u} [Field k] [CommRing B] [IsDomain B] [Algebra k B]
  (L : Type u) [Field L] [Algebra B L] [IsFractionRing B L] [Algebra k L] [IsScalarTower k B L]

/-- The `k`-subalgebra `A[1/g]` of the fraction field `L` of `B`, for a `k`-subalgebra `A` of
`B` and `g ∈ B`: the subalgebra generated by the image of `A` and by `1/g`. -/
def localized (A : Subalgebra k B) (g : B) : Subalgebra k L :=
  Algebra.adjoin k (insert (algebraMap B L g)⁻¹ (algebraMap B L '' (A : Set B)))

variable {L}

/-- The image of an element of `A` lies in `A[1/g]`. -/
theorem algebraMap_mem_localized {A : Subalgebra k B} (g : B) {a : B} (ha : a ∈ A) :
    algebraMap B L a ∈ localized L A g :=
  Algebra.subset_adjoin (Set.mem_insert_of_mem _ ⟨a, ha, rfl⟩)

/-- `1/g` lies in `A[1/g]`. -/
theorem inv_mem_localized (A : Subalgebra k B) (g : B) :
    (algebraMap B L g)⁻¹ ∈ localized L A g :=
  Algebra.subset_adjoin (Set.mem_insert _ _)

variable (L) in
/-- The map `A ⟶ A[1/g]`, `a ↦ a/1`. -/
def toLocalized (A : Subalgebra k B) (g : B) : A →ₐ[k] localized L A g :=
  ((IsScalarTower.toAlgHom k B L).comp A.val).codRestrict _
    fun a => algebraMap_mem_localized g a.2

/-- **`A[1/g]` is the localization of `A` away from `g`**, for `g ∈ A` nonzero. -/
theorem isLocalization_away_localized (A : Subalgebra k B) {g : B} (hg : g ∈ A) (hg0 : g ≠ 0) :
    letI : Algebra A (localized L A g) := (toLocalized L A g).toRingHom.toAlgebra
    IsLocalization.Away (⟨g, hg⟩ : A) (localized L A g) := by
  let : Algebra A (localized L A g) := (toLocalized L A g).toRingHom.toAlgebra
  have hinj : Function.Injective (algebraMap B L) := IsFractionRing.injective B L
  have hgL : algebraMap B L g ≠ 0 := (FaithfulSMul.algebraMap_eq_zero_iff B L).not.2 hg0
  have hmap : ∀ a : A, ((algebraMap A (localized L A g) a : localized L A g) : L) =
      algebraMap B L a := fun _ => rfl
  -- every element of `A[1/g]` is `a/g^n`
  have hsurj : ∀ z ∈ localized L A g, ∃ (a : B) (_ : a ∈ A) (n : ℕ),
      z * algebraMap B L g ^ n = algebraMap B L a := by
    intro z hz
    induction hz using Algebra.adjoin_induction with
    | mem x hx =>
      rcases hx with rfl | ⟨a, ha, rfl⟩
      · exact ⟨1, A.one_mem, 1, by rw [pow_one, inv_mul_cancel₀ hgL, map_one]⟩
      · exact ⟨a, ha, 0, by rw [pow_zero, mul_one]⟩
    | algebraMap c =>
      exact ⟨algebraMap k B c, A.algebraMap_mem c, 0, by
        rw [pow_zero, mul_one, IsScalarTower.algebraMap_apply k B L]⟩
    | add x y _ _ hx hy =>
      obtain ⟨a, ha, n, hn⟩ := hx
      obtain ⟨b, hb, m, hm⟩ := hy
      refine ⟨a * g ^ m + b * g ^ n, A.add_mem (A.mul_mem ha (A.pow_mem hg m))
        (A.mul_mem hb (A.pow_mem hg n)), n + m, ?_⟩
      rw [map_add, map_mul, map_mul, map_pow, map_pow, ← hn, ← hm, pow_add]
      ring
    | mul x y _ _ hx hy =>
      obtain ⟨a, ha, n, hn⟩ := hx
      obtain ⟨b, hb, m, hm⟩ := hy
      refine ⟨a * b, A.mul_mem ha hb, n + m, ?_⟩
      rw [map_mul, ← hn, ← hm, pow_add]
      ring
  refine ⟨?_, ?_, ?_⟩
  · rintro ⟨_, n, rfl⟩
    rw [map_pow]
    refine IsUnit.pow n ⟨⟨algebraMap A (localized L A g) ⟨g, hg⟩,
      ⟨_, inv_mem_localized A g⟩, ?_, ?_⟩, rfl⟩
    · exact Subtype.ext (mul_inv_cancel₀ hgL)
    · exact Subtype.ext (inv_mul_cancel₀ hgL)
  · intro z
    obtain ⟨a, ha, n, hn⟩ := hsurj z z.2
    refine ⟨(⟨a, ha⟩, ⟨(⟨g, hg⟩ : A) ^ n, n, rfl⟩), Subtype.ext ?_⟩
    simpa [hmap] using hn
  · intro a b hab
    refine ⟨1, ?_⟩
    have := congrArg (fun z : localized L A g => (z : L)) hab
    simp only [hmap] at this
    simp [Subtype.ext (hinj this)]

variable (k B L) in
/-- **The index of the source's colimit.** The pairs `(A, A[1/g])` with `A` a finite type
`k`-subalgebra of `B` and `g ∈ A` nonzero, ordered by inclusion in both entries. For `j = (A, g)`
the source writes `S_j = Spec(A)` and `U_j = Spec(A_g)`. -/
def Index : Type u :=
  {p : Subalgebra k B × Subalgebra k L // p.1.FG ∧ ∃ g ∈ p.1, g ≠ 0 ∧ p.2 = localized L p.1 g}

/-- Indices are ordered by inclusion of both subalgebras. -/
instance Index.instPartialOrder : PartialOrder (Index k B L) :=
  inferInstanceAs (PartialOrder {p : Subalgebra k B × Subalgebra k L // _})

/-- The finite type subalgebra `A` of an index. -/
abbrev Index.base (j : Index k B L) : Subalgebra k B := j.1.1

/-- The localization `A[1/g]` of an index. -/
abbrev Index.loc (j : Index k B L) : Subalgebra k L := j.1.2

/-- The subalgebra `A_j` grows with `j`. -/
theorem Index.base_mono : Monotone (Index.base (k := k) (B := B) (L := L)) :=
  fun _ _ h => h.1

/-- The localization `A_j[1/g_j]` grows with `j`. -/
theorem Index.loc_mono : Monotone (Index.loc (k := k) (B := B) (L := L)) :=
  fun _ _ h => h.2

/-- `A[1/g] ⊆ A'[1/g']` when `A ⊆ A'` and `g' = g c` with `c ∈ A'` and `g' ≠ 0`: then
`1/g = c/g'`. -/
theorem localized_le {A A' : Subalgebra k B} (hA : A ≤ A') {g g' c : B} (hc : c ∈ A')
    (hgc : g' = g * c) (hg'0 : g' ≠ 0) :
    localized L A g ≤ localized L A' g' := by
  have hg'L : algebraMap B L g' ≠ 0 := (FaithfulSMul.algebraMap_eq_zero_iff B L).not.2 hg'0
  refine Algebra.adjoin_le ?_
  rintro x (rfl | ⟨a, ha, rfl⟩)
  · have hcL : algebraMap B L c ≠ 0 := fun h => hg'L (by rw [hgc, map_mul, h, mul_zero])
    have : (algebraMap B L g)⁻¹ = algebraMap B L c * (algebraMap B L g')⁻¹ := by
      rw [hgc, map_mul, mul_inv, mul_comm, mul_assoc, inv_mul_cancel₀ hcL, mul_one]
    rw [SetLike.mem_coe, this]
    exact Subalgebra.mul_mem _ (algebraMap_mem_localized g' hc) (inv_mem_localized A' g')
  · exact algebraMap_mem_localized g' (hA ha)

/-- The index set is nonempty: it contains `(k, k)`, with `g = 1`. -/
instance Index.instNonempty : Nonempty (Index k B L) :=
  ⟨⟨(⊥, localized L ⊥ 1), Subalgebra.fg_bot, 1, Subalgebra.one_mem _, one_ne_zero, rfl⟩⟩

/-- **The index set is directed**: `(A₁, g₁)` and `(A₂, g₂)` are below `(A₁ ⊔ A₂, g₁g₂)`. -/
instance Index.isDirected_le : IsDirected (Index k B L) (· ≤ ·) := by
  refine ⟨fun i j => ?_⟩
  obtain ⟨hA₁, g₁, hg₁, hg₁0, h₁⟩ := i.2
  obtain ⟨hA₂, g₂, hg₂, hg₂0, h₂⟩ := j.2
  have hg0 : g₁ * g₂ ≠ 0 := mul_ne_zero hg₁0 hg₂0
  have hmem : g₁ * g₂ ∈ i.base ⊔ j.base :=
    Subalgebra.mul_mem _ (le_sup_left (a := i.base) hg₁) (le_sup_right (a := i.base) hg₂)
  refine ⟨⟨(i.base ⊔ j.base, localized L (i.base ⊔ j.base) (g₁ * g₂)), hA₁.sup hA₂, g₁ * g₂,
    hmem, hg0, rfl⟩, ⟨le_sup_left, ?_⟩, ⟨le_sup_right, ?_⟩⟩
  · change i.1.2 ≤ _
    rw [h₁]
    exact localized_le le_sup_left (le_sup_right (a := i.base) hg₂) rfl hg0
  · change j.1.2 ≤ _
    rw [h₂]
    exact localized_le le_sup_right (le_sup_left (a := i.base) hg₁) (mul_comm _ _) hg0

/-- Every element of `B` lies in the subalgebra of some index. -/
theorem Index.exists_mem_base (b : B) : ∃ j : Index k B L, b ∈ j.base :=
  ⟨⟨(Algebra.adjoin k {b}, localized L (Algebra.adjoin k {b}) 1),
    by simpa using Subalgebra.fg_adjoin_finset (R := k) ({b} : Finset B),
    1, Subalgebra.one_mem _, one_ne_zero, rfl⟩,
    Algebra.subset_adjoin rfl⟩

/-- Every element of the fraction field `L` lies in the localization of some index: `x = a/c`
lies in `k[a, c][1/c]`. -/
theorem Index.exists_mem_loc (x : L) : ∃ j : Index k B L, x ∈ j.loc := by
  classical
  obtain ⟨a, c, hc, rfl⟩ := IsFractionRing.div_surjective (A := B) x
  let A : Subalgebra k B := Algebra.adjoin k {a, c}
  refine ⟨⟨(A, localized L A c), ?_, c, Algebra.subset_adjoin (Set.mem_insert_of_mem _ rfl),
    nonZeroDivisors.ne_zero hc, rfl⟩, ?_⟩
  · simpa [A] using Subalgebra.fg_adjoin_finset (R := k) ({a, c} : Finset B)
  · rw [div_eq_mul_inv]
    exact Subalgebra.mul_mem _
      (algebraMap_mem_localized c (Algebra.subset_adjoin (Set.mem_insert _ _)))
      (inv_mem_localized A c)

end Algebra

/-! ### A directed union of subalgebras is a colimit of rings -/

section Colimit

variable {R T : Type u} [CommRing R] [CommRing T] [Algebra R T] {J : Type u} [Preorder J]
  (K : J → Subalgebra R T) (hK : Monotone K)

/-- The diagram of rings `j ↦ K j` of a monotone family of subalgebras. -/
@[simps]
def subalgebraDiagram : J ⥤ CommRingCat.{u} where
  obj j := CommRingCat.of (K j)
  map a := CommRingCat.ofHom (Subalgebra.inclusion (hK a.le)).toRingHom

/-- The cocone of the inclusions `K j ⟶ T`. -/
@[simps]
def subalgebraCocone : Cocone (subalgebraDiagram K hK) where
  pt := CommRingCat.of T
  ι := { app j := CommRingCat.ofHom (K j).val.toRingHom }

/-- **A directed union of subalgebras is their colimit.** If the `K j` are monotone over a
nonempty directed index and cover `T`, the inclusions exhibit `T` as their colimit in
`CommRingCat`. -/
def isColimitSubalgebraCocone [IsDirected J (· ≤ ·)] [Nonempty J] (hsup : ∀ x, ∃ j, x ∈ K j) :
    IsColimit (subalgebraCocone K hK) := by
  haveI : ReflectsColimitsOfShape J (forget CommRingCat.{u}) :=
    reflectsColimitsOfShape_of_reflectsIsomorphisms
  refine isColimitOfReflects (forget CommRingCat.{u}) ?_
  refine Types.FilteredColimit.isColimitOf _ _ (fun x => ?_) (fun i j xi xj h => ?_)
  · obtain ⟨j, hj⟩ := hsup x
    exact ⟨j, ⟨x, hj⟩, rfl⟩
  · obtain ⟨m, hi, hj⟩ := directed_of (· ≤ ·) i j
    exact ⟨m, homOfLE hi, homOfLE hj, Subtype.ext h⟩

end Colimit

/-! ### The inverse system of squares -/

section Geometry

variable {k B L : Type u} [Field k] [CommRing B] [IsDomain B] [Algebra k B]
  [Field L] [Algebra B L] [IsFractionRing B L] [Algebra k L] [IsScalarTower k B L]

variable (k B L) in
/-- The rings `A_j`. -/
abbrev baseRings : Index k B L ⥤ CommRingCat.{u} := subalgebraDiagram Index.base Index.base_mono

variable (k B L) in
/-- The rings `A_j[1/g_j]`. -/
abbrev locRings : Index k B L ⥤ CommRingCat.{u} := subalgebraDiagram Index.loc Index.loc_mono

/-- The map `A_j ⟶ A_j[1/g_j]`, `a ↦ a/1`. -/
def toLoc (j : Index k B L) : j.base →ₐ[k] j.loc :=
  ((IsScalarTower.toAlgHom k B L).comp j.base.val).codRestrict _ fun a => by
    obtain ⟨-, g, -, -, hj⟩ := j.2
    change _ ∈ j.1.2
    rw [hj]
    exact algebraMap_mem_localized g a.2

variable (k B L) in
/-- The maps `A_j ⟶ A_j[1/g_j]` form a morphism of diagrams. -/
def baseToLoc : baseRings k B L ⟶ locRings k B L where
  app j := CommRingCat.ofHom (toLoc j).toRingHom
  naturality _ _ _ := by ext; rfl

variable (k B L) in
/-- The schemes `S_j = Spec(A_j)`. -/
abbrev baseSchemes : (Index k B L)ᵒᵖ ⥤ Scheme.{u} := (baseRings k B L).op ⋙ Scheme.Spec

variable (k B L) in
/-- The schemes `U_j = Spec(A_j[1/g_j])`. -/
abbrev locSchemes : (Index k B L)ᵒᵖ ⥤ Scheme.{u} := (locRings k B L).op ⋙ Scheme.Spec

variable (k B L) in
/-- The open immersions `U_j ⟶ S_j`. -/
def locToBase : locSchemes k B L ⟶ baseSchemes k B L :=
  Functor.whiskerRight (NatTrans.op (baseToLoc k B L)) Scheme.Spec

/-- **`U_j ⟶ S_j` is an open immersion**: `A_j[1/g_j]` is the localization of `A_j` away from
`g_j` (`isLocalization_away_localized`). -/
theorem isOpenImmersion_spec_toLoc (j : Index k B L) :
    IsOpenImmersion (Spec.map (CommRingCat.ofHom (toLoc j).toRingHom)) := by
  obtain ⟨-, g, hg, hg0, hR⟩ := j.2
  let : Algebra j.base (localized L j.base g) := (toLocalized L j.base g).toRingHom.toAlgebra
  have := isLocalization_away_localized (L := L) j.base hg hg0
  have hO : IsOpenImmersion (Spec.map (CommRingCat.ofHom
      (algebraMap j.base (localized L j.base g)))) :=
    IsOpenImmersion.of_isLocalization (⟨g, hg⟩ : j.base)
  let e : localized L j.base g ≃ₐ[k] j.loc := Subalgebra.equivOfEq _ _ hR.symm
  have he : (toLoc j).toRingHom =
      e.toAlgHom.toRingHom.comp (algebraMap j.base (localized L j.base g)) := by
    ext; rfl
  rw [he, CommRingCat.ofHom_comp, Spec.map_comp]
  have : IsIso (CommRingCat.ofHom e.toAlgHom.toRingHom) :=
    (RingEquiv.toCommRingCatIso e.toRingEquiv).isIso_hom
  infer_instance

/-- The morphisms `U_j ⟶ S_j` are open immersions. -/
instance isOpenImmersion_locToBase_app (j : (Index k B L)ᵒᵖ) :
    IsOpenImmersion ((locToBase k B L).app j) :=
  isOpenImmersion_spec_toLoc j.unop

variable (k B L) in
/-- The structure morphisms `S_j ⟶ Spec k`. -/
def baseToField : baseSchemes k B L ⟶ (Functor.const (Index k B L)ᵒᵖ).obj (Spec (.of k)) where
  app j := Spec.map (CommRingCat.ofHom (algebraMap k j.unop.base))
  naturality i j a := by
    change Spec.map _ ≫ Spec.map _ = Spec.map _ ≫ 𝟙 _
    rw [Category.comp_id]
    refine (Spec.map_comp _ _).symm.trans (congrArg Spec.map ?_)
    ext x
    rfl

/-- The morphisms `U_j ⟶ S_j` are affine. -/
instance isAffineHom_locToBase_app (j : (Index k B L)ᵒᵖ) :
    IsAffineHom ((locToBase k B L).app j) :=
  isAffineHom_of_isAffine (X := Spec (.of j.unop.loc)) (Y := Spec (.of j.unop.base)) _

/-- The morphisms `U_j ⟶ S_j` are quasi-separated. -/
instance quasiSeparated_locToBase_app (j : (Index k B L)ᵒᵖ) :
    QuasiSeparated ((locToBase k B L).app j) :=
  QuasiSeparated.of_quasiSeparatedSpace (X := Spec (.of j.unop.loc)) _

/-- The morphisms `S_j ⟶ Spec k` are affine. -/
instance isAffineHom_baseToField_app (j : (Index k B L)ᵒᵖ) :
    IsAffineHom ((baseToField k B L).app j) :=
  isAffineHom_of_isAffine (X := Spec (.of j.unop.base)) (Y := Spec (.of k)) _

/-- `S_j ⟶ Spec k` is locally of finite type: `A_j` is a finite type `k`-algebra. -/
instance locallyOfFiniteType_baseToField_app (j : (Index k B L)ᵒᵖ) :
    LocallyOfFiniteType ((baseToField k B L).app j) := by
  change LocallyOfFiniteType (Spec.map (CommRingCat.ofHom (algebraMap k j.unop.base)))
  rw [HasRingHomProperty.Spec_iff (P := @LocallyOfFiniteType), CommRingCat.hom_ofHom,
    RingHom.finiteType_algebraMap]
  exact (Subalgebra.fg_iff_finiteType _).1 j.unop.2.1

variable (k B L) in
/-- The cone `Spec(B) ⟶ S_j`. -/
def baseCone : Cone (baseSchemes k B L) where
  pt := Spec (.of B)
  π :=
    { app j := Spec.map (CommRingCat.ofHom j.unop.base.val.toRingHom)
      naturality i j a := by
        change 𝟙 _ ≫ Spec.map _ = Spec.map _ ≫ Spec.map _
        rw [Category.id_comp]
        exact (congrArg Spec.map (by ext; rfl)).trans (Spec.map_comp _ _) }

variable (k B L) in
/-- The cone `Spec(L) ⟶ U_j`. -/
def locCone : Cone (locSchemes k B L) where
  pt := Spec (.of L)
  π :=
    { app j := Spec.map (CommRingCat.ofHom j.unop.loc.val.toRingHom)
      naturality i j a := by
        change 𝟙 _ ≫ Spec.map _ = Spec.map _ ≫ Spec.map _
        rw [Category.id_comp]
        exact (congrArg Spec.map (by ext; rfl)).trans (Spec.map_comp _ _) }

/-- **`Spec(B) = lim S_j`**: `B` is the directed union of the `A_j`. -/
def isLimitBaseCone : IsLimit (baseCone k B L) :=
  IsLimit.ofIsoLimit (isLimitOfPreserves Scheme.Spec
    (isColimitSubalgebraCocone _ Index.base_mono Index.exists_mem_base).op)
    (Cone.ext (Iso.refl _) fun _ => (Category.id_comp _).symm)

/-- **`Spec(L) = lim U_j`**: `L` is the directed union of the `A_j[1/g_j]`. -/
def isLimitLocCone : IsLimit (locCone k B L) :=
  IsLimit.ofIsoLimit (isLimitOfPreserves Scheme.Spec
    (isColimitSubalgebraCocone _ Index.loc_mono Index.exists_mem_loc).op)
    (Cone.ext (Iso.refl _) fun _ => (Category.id_comp _).symm)

/-- `Spec(B) ⟶ S_j ⟶ Spec k` is the structure morphism of `Spec(B)`. -/
theorem baseCone_π_app_comp_baseToField (j : (Index k B L)ᵒᵖ) :
    (baseCone k B L).π.app j ≫ (baseToField k B L).app j =
      Spec.map (CommRingCat.ofHom (algebraMap k B)) :=
  (Spec.map_comp _ _).symm.trans (congrArg Spec.map (by ext; rfl))

/-- `Spec(L) ⟶ U_j ⟶ S_j` is `Spec(L) ⟶ Spec(B) ⟶ S_j`. -/
theorem locCone_π_app_comp_locToBase (j : (Index k B L)ᵒᵖ) :
    (locCone k B L).π.app j ≫ (locToBase k B L).app j =
      Spec.map (CommRingCat.ofHom (algebraMap B L)) ≫ (baseCone k B L).π.app j :=
  (Spec.map_comp _ _).symm.trans ((congrArg Spec.map (by ext; rfl)).trans (Spec.map_comp _ _))

end Geometry

/-! ### Base change of an inverse system along a morphism of systems -/

section LevelsMap

variable {J : Type*} [Category J] {W Y : Scheme.{u}} {D D' : J ⥤ Scheme.{u}} (γ : D' ⟶ D)
  (st : D ⟶ (Functor.const J).obj W) (y : Y ⟶ W)

/-- The maps `D'_j ×_W Y ⟶ D_j ×_W Y` induced by a morphism `γ : D' ⟶ D` of systems over `W`. -/
def baseChangeDiagramMapOfHom : baseChangeDiagram D' (γ ≫ st) y ⟶ baseChangeDiagram D st y where
  app j := pullback.lift (pullback.fst _ _ ≫ γ.app j) (pullback.snd _ _)
    ((Category.assoc _ _ _).trans pullback.condition)
  naturality i j a := by
    refine pullback.hom_ext ?_ ?_
    · simp only [Category.assoc, baseChangeDiagram_map_fst, pullback.lift_fst,
        pullback.lift_fst_assoc, baseChangeDiagram_map_fst_assoc]
      congr 1
      exact γ.naturality a
    · simp only [Category.assoc, baseChangeDiagram_map_snd, pullback.lift_snd]

/-- The first component of `D'_j ×_W Y ⟶ D_j ×_W Y`. -/
@[reassoc (attr := simp)]
theorem baseChangeDiagramMapOfHom_app_fst (j : J) :
    (baseChangeDiagramMapOfHom γ st y).app j ≫ pullback.fst (st.app j) y =
      pullback.fst ((γ ≫ st).app j) y ≫ γ.app j :=
  pullback.lift_fst _ _ _

/-- The second component of `D'_j ×_W Y ⟶ D_j ×_W Y`. -/
@[reassoc (attr := simp)]
theorem baseChangeDiagramMapOfHom_app_snd (j : J) :
    (baseChangeDiagramMapOfHom γ st y).app j ≫ pullback.snd (st.app j) y =
      pullback.snd ((γ ≫ st).app j) y :=
  pullback.lift_snd _ _ _

/-- The square of `D'_j ×_W Y ⟶ D_j ×_W Y` over `γ_j` is cartesian: it is the left half of the
pasting of the two product squares over `W`. -/
theorem isPullback_baseChangeDiagramMapOfHom (j : J) :
    IsPullback ((baseChangeDiagramMapOfHom γ st y).app j)
      ((baseChangeHorizontal D' (γ ≫ st) y).app j) ((baseChangeHorizontal D st y).app j)
      (γ.app j) := by
  refine IsPullback.of_right (h₁₂ := pullback.snd _ y) (h₂₂ := st.app j) (v₁₃ := y) ?_
    (baseChangeDiagramMapOfHom_app_fst γ st y j) (IsPullback.of_hasPullback _ y).flip
  rw [baseChangeDiagramMapOfHom_app_snd]
  exact (IsPullback.of_hasPullback ((γ ≫ st).app j) y).flip

end LevelsMap

section LimitMk

open LimitBaseChange LimitHigherDirectImage

variable {I : Type u} [Preorder I] [IsDirected I (· ≤ ·)] [Nonempty I]
  {DX DS DT DY : Iᵒᵖ ⥤ Scheme.{u}} (f : DX ⟶ DS) (g : DT ⟶ DS) (h : DY ⟶ DX)
  (e : DY ⟶ DT)
  [∀ {i j : Iᵒᵖ} (a : i ⟶ j), IsAffineHom (DX.map a)]
  [∀ {i j : Iᵒᵖ} (a : i ⟶ j), IsAffineHom (DS.map a)]
  [∀ {i j : Iᵒᵖ} (a : i ⟶ j), IsAffineHom (DT.map a)]
  [∀ {i j : Iᵒᵖ} (a : i ⟶ j), IsAffineHom (DY.map a)]
  [∀ i : Iᵒᵖ, QuasiCompact (g.app i)] [∀ i : Iᵒᵖ, QuasiSeparated (g.app i)]

/-- [Stacks, Tag 0EZT] (2), `isIso_higherBaseChangeMapAb_of_isLimit`, for limit cones given by
their apexes and legs, with the commutativity of the limit square an arbitrary proof. -/
theorem isIso_higherBaseChangeMapAb_of_isLimit_mk
    (hsq : ∀ i : Iᵒᵖ, IsPullback (h.app i) (e.app i) (f.app i) (g.app i))
    {X S T Y : Scheme.{u}} {pX : (Functor.const Iᵒᵖ).obj X ⟶ DX}
    {pS : (Functor.const Iᵒᵖ).obj S ⟶ DS} {pT : (Functor.const Iᵒᵖ).obj T ⟶ DT}
    {pY : (Functor.const Iᵒᵖ).obj Y ⟶ DY}
    (hcX : IsLimit (Cone.mk X pX)) (hcS : IsLimit (Cone.mk S pS)) (hcT : IsLimit (Cone.mk T pT))
    (hcY : IsLimit (Cone.mk Y pY)) (fL : X ⟶ S) (gL : T ⟶ S) (hL : Y ⟶ X) (eL : Y ⟶ T)
    (w : hL ≫ fL = eL ≫ gL)
    (hfL : ∀ i : Iᵒᵖ, fL ≫ pS.app i = pX.app i ≫ f.app i)
    (hgL : ∀ i : Iᵒᵖ, gL ≫ pS.app i = pT.app i ≫ g.app i)
    (hhL : ∀ i : Iᵒᵖ, hL ≫ pX.app i = pY.app i ≫ h.app i)
    (heL : ∀ i : Iᵒᵖ, eL ≫ pT.app i = pY.app i ≫ e.app i) (q : ℕ)
    (𝓕 : Sheaf (smallEtaleTopology T) Ab.{u + 1})
    (F : EtaleSheafSystem DT Ab.{u + 1})
    (ι : ∀ i : Iᵒᵖ, (smallEtalePullbackAb (pT.app i)).obj (F.obj i) ⟶ 𝓕)
    (hι : ∀ {i j : Iᵒᵖ} (a : i ⟶ j),
      (conePullbackComp (Cone.mk T pT) a).inv.app (F.obj j) ≫
        (smallEtalePullbackAb (pT.app i)).map (F.map a) ≫ ι i = ι j)
    (hpres : IsPullbackColimitPresentation (Cone.mk T pT) 𝓕 F ι)
    (hstage : ∀ i : Iᵒᵖ,
      IsIso ((higherBaseChangeMapAb (f.app i) (g.app i) (h.app i) (e.app i) (hsq i).w q).app
        (F.obj i))) :
    IsIso ((higherBaseChangeMapAb fL gL hL eL w q).app 𝓕) :=
  isIso_higherBaseChangeMapAb_of_isLimit (cX := Cone.mk X pX) (cS := Cone.mk S pS)
    (cT := Cone.mk T pT) (cY := Cone.mk Y pY) f g h e fL gL hL eL hsq hcX hcS hcT hcY hfL
    hgL hhL heL q 𝓕 F ι hι hpres hstage

end LimitMk

