module

public import Mathlib.CategoryTheory.Sites.PrecoverageToGrothendieck
public import StacksFrontier.CategoryTheory.Sites.Sheafification.CechH0
public import StacksFrontier.CategoryTheory.Sites.Sheafification.SeparatedPlusIsSheaf
public import StacksCore.Tactic.StacksAttribute

/-!
# The plus construction over covering families

For a presheaf of sets on a site, the covering-family plus construction is the directed colimit,
over the covering families of an object, of the sets of matching families on them. Two matching
families represent the same element exactly when they agree after pullback to a common covering
refinement. This module builds that colimit and identifies it with Mathlib's covering-sieve plus
construction.

## Main definitions

* `CategoryTheory.FamilyPlusRepresentative` is a covering family together with a matching family
  on it, and `CategoryTheory.FamilyPlusRelated` is the relation of agreeing on a common
  refinement.
* `CategoryTheory.FamilyPlusValue` is the resulting quotient, the covering-family colimit of
  zeroth Čech cohomology.
* `CategoryTheory.familyCover` and `CategoryTheory.familyMatchingFamily` send a covering family
  and a matching family to the covering sieve it generates and the induced matching family on
  that sieve, and `CategoryTheory.coverFamily` goes back.
* `CategoryTheory.toFamilyPlus` is the canonical map from sections.

## Main results

* `CategoryTheory.familyPlusEquiv` identifies the covering-family colimit with the value of
  Mathlib's `GrothendieckTopology.plusObj`.
* `CategoryTheory.familyPlusValueSmall` says the colimit is universe-small.

## Implementation notes

Mathlib defines `GrothendieckTopology.plusObj` using covering sieves. Here a representative of
the source's covering-family colimit is a covering family together with an element of its zeroth
Čech cohomology, and representatives are identified when their matching families agree on a
common refinement. The comparison map sends a representative to the class of the matching
family induced on the generated sieve; injectivity and surjectivity of that map are the two
halves of `familyPlusEquiv`.

## References

* [Stacks Project, Tag 03NS](https://stacks.math.columbia.edu/tag/03NS)
-/

@[expose] public section

open CategoryTheory Opposite

namespace CategoryTheory

universe u

variable {C : Type u} [SmallCategory C] (J : GrothendieckTopology C)
variable (F : Cᵒᵖ ⥤ Type u) (U : C)

/-- A representative of a section of the covering-family plus construction: a covering
family of `U` and a matching family of sections on it. -/
abbrev FamilyPlusRepresentative :=
  Σ E : J.toPrecoverage.ZeroHypercover.{u} U,
    PreZeroHypercover.H0 F E.toPreZeroHypercover

/-- Two representatives are related when they agree after pullback to a common covering
refinement. -/
def FamilyPlusRelated (x y : FamilyPlusRepresentative J F U) : Prop :=
  ∃ (E : J.toPrecoverage.ZeroHypercover.{u} U)
      (f : E.toPreZeroHypercover.Hom x.1.toPreZeroHypercover)
      (g : E.toPreZeroHypercover.Hom y.1.toPreZeroHypercover),
    PreZeroHypercover.H0.mapOver F
        ((PreZeroHypercover.homOverIdEquivHom _ _).symm f) x.2 =
      PreZeroHypercover.H0.mapOver F
        ((PreZeroHypercover.homOverIdEquivHom _ _).symm g) y.2

/-- The colimit of zeroth Čech cohomology over covering families of `U`. -/
@[stacks 03NS "part (1), the covering-family colimit"]
abbrev FamilyPlusValue :=
  Quotient (Relation.EqvGen.setoid (FamilyPlusRelated J F U))

/-- The one-member covering family of `U` consisting of its identity. -/
def identityCover : J.toPrecoverage.ZeroHypercover.{u} U :=
  Precoverage.ZeroHypercover.singleton (J := J.toPrecoverage) (𝟙 U)
    (Precoverage.mem_coverings_of_isIso (J := J.toPrecoverage) (𝟙 U))

/-- A section over `U` as a matching family on the identity covering. -/
def identityH0 (x : F.obj (op U)) :
    PreZeroHypercover.H0 F (identityCover J U).toPreZeroHypercover :=
  ⟨fun i ↦ F.map ((identityCover J U).f i).op x, by
    intro _ _ T f g hfg
    simp only [← Functor.map_comp_apply, ← op_comp]
    rw [hfg]⟩

/-- The canonical map from sections to the covering-family plus construction. -/
noncomputable def toFamilyPlus (x : F.obj (op U)) : FamilyPlusValue J F U :=
  Quotient.mk (Relation.EqvGen.setoid (FamilyPlusRelated J F U))
    ⟨identityCover J U, identityH0 J F U x⟩

/-- The covering sieve generated by a covering family. -/
def familyCover (E : J.toPrecoverage.ZeroHypercover.{u} U) : J.Cover U :=
  ⟨E.toPreZeroHypercover.sieve₀, E.mem₀⟩

/-- A matching family on a covering family, extended canonically to the sieve that the
family generates. -/
noncomputable def familyMatchingFamily
    (E : J.toPrecoverage.ZeroHypercover.{u} U)
    (s : PreZeroHypercover.H0 F E.toPreZeroHypercover) :
    Meq F (familyCover J U E) :=
  let hs : Presieve.Arrows.Compatible F E.f s.1 := s.2
  ⟨fun I ↦ hs.familyOfElements.sieveExtend I.f I.hf,
    fun I ↦ hs.familyOfElements_compatible.sieveExtend
      I.r.g₁ I.r.g₂ I.fst.hf I.snd.hf I.r.w⟩

lemma family_matching_agrees_on_generator
    (E : J.toPrecoverage.ZeroHypercover.{u} U)
    (s : PreZeroHypercover.H0 F E.toPreZeroHypercover) (i : E.I₀) :
    familyMatchingFamily (J := J) (F := F) (U := U) E s
      ⟨E.toPreZeroHypercover.X i, E.toPreZeroHypercover.f i,
        PreZeroHypercover.sieve₀_f E.toPreZeroHypercover i⟩ = s.1 i := by
  let hs : Presieve.Arrows.Compatible F E.toPreZeroHypercover.f s.1 := s.2
  dsimp only [familyMatchingFamily]
  rw [Presieve.extend_agrees hs.familyOfElements_compatible (Presieve.ofArrows.mk i)]
  exact hs.familyOfElements_ofArrows_mk i

noncomputable def coverFamily (S : J.Cover U) :
    J.toPrecoverage.ZeroHypercover.{u} U :=
  ⟨{ I₀ := (S : Sieve U).arrows.category
      , X := fun i => i.obj.left
      , f := fun i => i.obj.hom }, by
    change Sieve.generate (Presieve.ofArrows _ _) ∈ J U
    simpa only [Sieve.ofArrows_category] using S.2⟩

lemma familyCover_coverFamily (S : J.Cover U) :
    familyCover J U (coverFamily (J := J) (U := U) S) = S :=
  Subtype.ext (Sieve.ofArrows_category (S : Sieve U))

private lemma familyMatchingFamily_ext
    (E : J.toPrecoverage.ZeroHypercover.{u} U)
    (x y : Meq F (familyCover J U E))
    (h : ∀ i : E.toPreZeroHypercover.I₀,
      x ⟨E.toPreZeroHypercover.X i, E.toPreZeroHypercover.f i,
        PreZeroHypercover.sieve₀_f E.toPreZeroHypercover i⟩ =
      y ⟨E.toPreZeroHypercover.X i, E.toPreZeroHypercover.f i,
        PreZeroHypercover.sieve₀_f E.toPreZeroHypercover i⟩) : x = y := by
  apply Meq.ext
  intro I
  obtain ⟨i, a, hi⟩ :=
    (Sieve.mem_ofArrows_iff E.toPreZeroHypercover.X E.toPreZeroHypercover.f I.f).1 I.hf
  let I₀ : (familyCover J U E).Arrow :=
    ⟨_, E.toPreZeroHypercover.f i,
      PreZeroHypercover.sieve₀_f E.toPreZeroHypercover i⟩
  let hr : I.Relation I₀ :=
    { Z := I.Y, g₁ := 𝟙 I.Y, g₂ := a, w := by simpa [I₀] using hi }
  have hx : F.map (𝟙 (op I.Y)) (x I) = F.map a.op (x I₀) :=
    x.condition (GrothendieckTopology.Cover.Relation.mk' hr)
  have hy : F.map (𝟙 (op I.Y)) (y I) = F.map a.op (y I₀) :=
    y.condition (GrothendieckTopology.Cover.Relation.mk' hr)
  rw [F.map_id_apply] at hx hy
  rw [hx, hy, h i]

public lemma familyMatchingFamily_factor
    (E : J.toPrecoverage.ZeroHypercover.{u} U)
    (s : PreZeroHypercover.H0 F E.toPreZeroHypercover)
    (i : E.toPreZeroHypercover.I₀) {V : C} (a : V ⟶ E.toPreZeroHypercover.X i) :
    familyMatchingFamily J F U E s
      ⟨V, a ≫ E.toPreZeroHypercover.f i,
        E.toPreZeroHypercover.sieve₀.downward_closed
          (PreZeroHypercover.sieve₀_f E.toPreZeroHypercover i) a⟩ =
      F.map a.op (s.1 i) := by
  let I : (familyCover J U E).Arrow :=
    ⟨V, a ≫ E.toPreZeroHypercover.f i,
      E.toPreZeroHypercover.sieve₀.downward_closed
        (PreZeroHypercover.sieve₀_f E.toPreZeroHypercover i) a⟩
  let I₀ : (familyCover J U E).Arrow :=
    ⟨E.toPreZeroHypercover.X i, E.toPreZeroHypercover.f i,
      PreZeroHypercover.sieve₀_f E.toPreZeroHypercover i⟩
  let hr : I.Relation I₀ :=
    { Z := V, g₁ := 𝟙 V, g₂ := a, w := by simp [I, I₀] }
  have hcond : F.map (𝟙 (op V)) (familyMatchingFamily J F U E s I) =
      F.map a.op (familyMatchingFamily J F U E s I₀) :=
    (familyMatchingFamily J F U E s).condition (GrothendieckTopology.Cover.Relation.mk' hr)
  rw [F.map_id_apply] at hcond
  exact hcond.trans (congrArg (fun z => F.map a.op z)
    (family_matching_agrees_on_generator (J := J) (F := F) (U := U) E s i))

/-- The extended matching family at an arrow factoring through a member of the family. -/
private lemma familyMatchingFamily_apply_of_eq
    (E : J.toPrecoverage.ZeroHypercover.{u} U)
    (s : PreZeroHypercover.H0 F E.toPreZeroHypercover)
    (i : E.toPreZeroHypercover.I₀) {V : C} (a : V ⟶ E.toPreZeroHypercover.X i) (g : V ⟶ U)
    (hg : familyCover J U E g) (h : g = a ≫ E.toPreZeroHypercover.f i) :
    familyMatchingFamily J F U E s ⟨V, g, hg⟩ = F.map a.op (s.1 i) := by
  subst h
  exact familyMatchingFamily_factor J F U E s i a

def coverHomOfHomOver {E G : J.toPrecoverage.ZeroHypercover.{u} U}
    (φ : E.toPreZeroHypercover.HomOver G.toPreZeroHypercover (𝟙 U)) :
    familyCover J U E ⟶ familyCover J U G :=
  homOfLE (fun V f hf ↦ by
    obtain ⟨i, a, rfl⟩ :=
      (Sieve.mem_ofArrows_iff E.toPreZeroHypercover.X E.toPreZeroHypercover.f f).1 hf
    change G.toPreZeroHypercover.sieve₀ (a ≫ E.toPreZeroHypercover.f i)
    have hw : φ.h₀ i ≫ G.toPreZeroHypercover.f (φ.s₀ i) =
        E.toPreZeroHypercover.f i := by simpa using φ.w₀ i
    rw [← hw]
    simpa [Category.assoc] using G.toPreZeroHypercover.sieve₀.downward_closed
      (PreZeroHypercover.sieve₀_f G.toPreZeroHypercover (φ.s₀ i)) (a ≫ φ.h₀ i))

lemma familyMatchingFamily_refine
    {E G : J.toPrecoverage.ZeroHypercover.{u} U}
    (φ : E.toPreZeroHypercover.HomOver G.toPreZeroHypercover (𝟙 U))
    (s : PreZeroHypercover.H0 F G.toPreZeroHypercover) :
    (familyMatchingFamily (J := J) (F := F) (U := U) G s).refine
        (coverHomOfHomOver J U φ) =
      familyMatchingFamily (J := J) (F := F) (U := U) E
        (PreZeroHypercover.H0.mapOver F φ s) := by
  apply familyMatchingFamily_ext (J := J) (U := U) (F := F) E
  intro i
  rw [Meq.refine_apply]
  rw [familyMatchingFamily_apply_of_eq J F U G s (φ.s₀ i) (φ.h₀ i) _ _
      (by simpa using (φ.w₀ i).symm),
    family_matching_agrees_on_generator (J := J) (F := F) (U := U) E
      (PreZeroHypercover.H0.mapOver F φ s) i, PreZeroHypercover.H0.mapOver_apply]

def familyMeqToH0
    (E : J.toPrecoverage.ZeroHypercover.{u} U)
    (s : Meq F (familyCover J U E)) : PreZeroHypercover.H0 F E.toPreZeroHypercover :=
  ⟨fun i => s ⟨E.toPreZeroHypercover.X i, E.toPreZeroHypercover.f i,
      PreZeroHypercover.sieve₀_f E.toPreZeroHypercover i⟩,
    by
      intro i j T a b hab
      let I : (familyCover J U E).Arrow :=
        ⟨E.toPreZeroHypercover.X i, E.toPreZeroHypercover.f i,
          PreZeroHypercover.sieve₀_f E.toPreZeroHypercover i⟩
      let I' : (familyCover J U E).Arrow :=
        ⟨E.toPreZeroHypercover.X j, E.toPreZeroHypercover.f j,
          PreZeroHypercover.sieve₀_f E.toPreZeroHypercover j⟩
      let r : I.Relation I' := { Z := T, g₁ := a, g₂ := b, w := hab }
      exact Meq.condition s (GrothendieckTopology.Cover.Relation.mk' r)⟩

lemma familyMatchingFamily_meqToH0
    (E : J.toPrecoverage.ZeroHypercover.{u} U)
    (s : Meq F (familyCover J U E)) :
    familyMatchingFamily J F U E (familyMeqToH0 J F U E s) = s := by
  apply familyMatchingFamily_ext (J := J) (U := U) (F := F) E
  intro i
  rw [family_matching_agrees_on_generator]
  rfl

noncomputable def homOverOfCoverHom {E G : J.toPrecoverage.ZeroHypercover.{u} U}
    (e : familyCover J U E ⟶ familyCover J U G) :
    E.toPreZeroHypercover.HomOver G.toPreZeroHypercover (𝟙 U) := by
  let witnesses (i : E.toPreZeroHypercover.I₀) :=
    (Sieve.mem_ofArrows_iff G.toPreZeroHypercover.X G.toPreZeroHypercover.f _).1
      ((leOfHom e) _ (PreZeroHypercover.sieve₀_f E.toPreZeroHypercover i))
  choose j a ha using witnesses
  exact ⟨j, a, fun i => by simpa using (ha i).symm⟩

private lemma familyPlusRelated_toPlusEq
    (x y : FamilyPlusRepresentative J F U)
    (h : FamilyPlusRelated J F U x y) :
    GrothendieckTopology.Plus.mk (familyMatchingFamily J F U x.1 x.2) =
      GrothendieckTopology.Plus.mk (familyMatchingFamily J F U y.1 y.2) := by
  obtain ⟨H, f, g, hfg⟩ := h
  let φ := (PreZeroHypercover.homOverIdEquivHom _ _).symm f
  let ψ := (PreZeroHypercover.homOverIdEquivHom _ _).symm g
  rw [GrothendieckTopology.Plus.eq_mk_iff_exists]
  refine ⟨familyCover J U H, coverHomOfHomOver J U φ,
    coverHomOfHomOver J U ψ, ?_⟩
  calc
    (familyMatchingFamily J F U x.1 x.2).refine (coverHomOfHomOver J U φ) =
        familyMatchingFamily J F U H (PreZeroHypercover.H0.mapOver F φ x.2) :=
      familyMatchingFamily_refine (J := J) (U := U) (F := F) φ x.2
    _ = familyMatchingFamily J F U H (PreZeroHypercover.H0.mapOver F ψ y.2) :=
      congrArg (familyMatchingFamily J F U H) hfg
    _ = (familyMatchingFamily J F U y.1 y.2).refine (coverHomOfHomOver J U ψ) :=
      (familyMatchingFamily_refine (J := J) (U := U) (F := F) ψ y.2).symm

def coverHomOfHomOverBase {V : C} (f : V ⟶ U)
    {E : J.toPrecoverage.ZeroHypercover.{u} U}
    {G : J.toPrecoverage.ZeroHypercover.{u} V}
    (φ : G.toPreZeroHypercover.HomOver E.toPreZeroHypercover f) :
    familyCover J V G ⟶ (J.pullback f).obj (familyCover J U E) :=
  homOfLE (fun T g hg => by
    obtain ⟨i, a, hgf⟩ :=
      (Sieve.mem_ofArrows_iff G.toPreZeroHypercover.X G.toPreZeroHypercover.f g).1 hg
    change (familyCover J U E) (g ≫ f)
    rw [hgf]
    apply (Sieve.mem_ofArrows_iff E.toPreZeroHypercover.X E.toPreZeroHypercover.f _).2
    exact ⟨φ.s₀ i, a ≫ φ.h₀ i, by simp [φ.w₀ i]⟩)

lemma familyMatchingFamily_pullback_refine {V : C} (f : V ⟶ U)
    {E : J.toPrecoverage.ZeroHypercover.{u} U}
    {G : J.toPrecoverage.ZeroHypercover.{u} V}
    (φ : G.toPreZeroHypercover.HomOver E.toPreZeroHypercover f)
    (s : PreZeroHypercover.H0 F E.toPreZeroHypercover) :
    ((familyMatchingFamily J F U E s).pullback f).refine
        (coverHomOfHomOverBase (J := J) (U := U) f φ) =
      familyMatchingFamily J F V G (PreZeroHypercover.H0.mapOver F φ s) := by
  apply familyMatchingFamily_ext (J := J) (U := V) (F := F) G
  intro i
  rw [Meq.refine_apply]
  rw [Meq.pullback_apply]
  refine (familyMatchingFamily_apply_of_eq J F U E s (φ.s₀ i) (φ.h₀ i) _ _
    (by simpa using (φ.w₀ i).symm)).trans ?_
  rw [family_matching_agrees_on_generator (J := J) (F := F) (U := V) G
      (PreZeroHypercover.H0.mapOver F φ s) i, PreZeroHypercover.H0.mapOver_apply]

lemma familyPlusEqvGen_toPlusEq
    (x y : FamilyPlusRepresentative J F U)
    (h : Relation.EqvGen (FamilyPlusRelated J F U) x y) :
    GrothendieckTopology.Plus.mk (familyMatchingFamily J F U x.1 x.2) =
      GrothendieckTopology.Plus.mk (familyMatchingFamily J F U y.1 y.2) := by
  induction h with
  | rel a b h => exact familyPlusRelated_toPlusEq (J := J) (F := F) (U := U) a b h
  | refl _ => rfl
  | symm _ _ _ ih => exact ih.symm
  | trans _ _ _ _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Two representatives whose induced matching families agree on a common refinement of
their sieves are related. -/
private lemma familyPlusRelated_of_refine_eq (a b : FamilyPlusRepresentative J F U) {W : J.Cover U}
    (h₁ : W ⟶ familyCover J U a.1) (h₂ : W ⟶ familyCover J U b.1)
    (hw : (familyMatchingFamily J F U a.1 a.2).refine h₁ =
      (familyMatchingFamily J F U b.1 b.2).refine h₂) :
    FamilyPlusRelated J F U a b := by
  let H := coverFamily (J := J) (U := U) W
  have hW : familyCover J U H = W := familyCover_coverFamily (J := J) (U := U) W
  let h₁' : familyCover J U H ⟶ familyCover J U a.1 := homOfLE (hW.le.trans (leOfHom h₁))
  let h₂' : familyCover J U H ⟶ familyCover J U b.1 := homOfLE (hW.le.trans (leOfHom h₂))
  let φ := homOverOfCoverHom (J := J) (U := U) h₁'
  let ψ := homOverOfCoverHom (J := J) (U := U) h₂'
  have key : ∀ (c : FamilyPlusRepresentative J F U) (h : W ⟶ familyCover J U c.1)
      (χ : H.toPreZeroHypercover.HomOver c.1.toPreZeroHypercover (𝟙 U)) (i : H.I₀),
      (familyMatchingFamily J F U c.1 c.2).refine h
        ⟨_, H.toPreZeroHypercover.f i, hW ▸ PreZeroHypercover.sieve₀_f H.toPreZeroHypercover i⟩ =
      familyMatchingFamily J F U H (PreZeroHypercover.H0.mapOver F χ c.2)
        ⟨_, H.toPreZeroHypercover.f i, PreZeroHypercover.sieve₀_f H.toPreZeroHypercover i⟩ := by
    intro c h χ i
    rw [← familyMatchingFamily_refine (J := J) (U := U) (F := F) χ c.2, Meq.refine_apply]
    rfl
  have hm : PreZeroHypercover.H0.mapOver F φ a.2 =
      PreZeroHypercover.H0.mapOver F ψ b.2 := by
    apply PreZeroHypercover.H0.ext
    intro i
    rw [← family_matching_agrees_on_generator (J := J) (F := F) (U := U) H
      (PreZeroHypercover.H0.mapOver F φ a.2) i,
      ← family_matching_agrees_on_generator (J := J) (F := F) (U := U) H
        (PreZeroHypercover.H0.mapOver F ψ b.2) i,
      ← key a h₁ φ i, ← key b h₂ ψ i, hw]
  exact ⟨H, PreZeroHypercover.homOverIdEquivHom H.toPreZeroHypercover a.1.toPreZeroHypercover φ,
    PreZeroHypercover.homOverIdEquivHom H.toPreZeroHypercover b.1.toPreZeroHypercover ψ,
    by simpa using hm⟩

lemma familyPlusToPlus_injective
    (toPlus : FamilyPlusValue J F U → (J.plusObj F).obj (op U))
    (hrep : ∀ (E : J.toPrecoverage.ZeroHypercover.{u} U)
      (s : PreZeroHypercover.H0 F E.toPreZeroHypercover),
      toPlus (Quotient.mk (Relation.EqvGen.setoid (FamilyPlusRelated J F U)) ⟨E, s⟩) =
        GrothendieckTopology.Plus.mk (familyMatchingFamily J F U E s)) :
    Function.Injective toPlus := by
  intro x y hxy
  refine Quotient.inductionOn₂ (motive := fun x y =>
    toPlus x = toPlus y → x = y) x y ?_ hxy
  intro a b hab
  rw [hrep a.1 a.2, hrep b.1 b.2] at hab
  obtain ⟨W, h₁, h₂, hw⟩ :=
    (GrothendieckTopology.Plus.eq_mk_iff_exists
      (familyMatchingFamily J F U a.1 a.2)
      (familyMatchingFamily J F U b.1 b.2)).1 hab
  exact Quotient.sound (Relation.EqvGen.rel a b
    (familyPlusRelated_of_refine_eq J F U a b h₁ h₂ hw))

lemma familyPlusToPlus_surjective
    (toPlus : FamilyPlusValue J F U → (J.plusObj F).obj (op U))
    (hrep : ∀ (E : J.toPrecoverage.ZeroHypercover.{u} U)
      (s : PreZeroHypercover.H0 F E.toPreZeroHypercover),
      toPlus (Quotient.mk (Relation.EqvGen.setoid (FamilyPlusRelated J F U)) ⟨E, s⟩) =
        GrothendieckTopology.Plus.mk (familyMatchingFamily J F U E s)) :
    Function.Surjective toPlus := by
  intro z
  obtain ⟨S, s, rfl⟩ :=
    GrothendieckTopology.Plus.exists_rep (J := J) (P := F) (X := U) z
  let E := coverFamily (J := J) (U := U) S
  let e : familyCover J U E ⟶ S :=
    homOfLE (by rw [familyCover_coverFamily (J := J) (U := U) S])
  let m : Meq F (familyCover J U E) := s.refine e
  refine ⟨Quotient.mk _ ⟨E, familyMeqToH0 J F U E m⟩, ?_⟩
  rw [hrep E (familyMeqToH0 J F U E m),
    familyMatchingFamily_meqToH0 (J := J) (U := U) (F := F) E m]
  exact (GrothendieckTopology.Plus.eq_mk_iff_exists m s).2 ⟨familyCover J U E, 𝟙 _, e, rfl⟩

/-- The covering-family colimit is canonically equivalent to the value of Mathlib's
covering-sieve plus construction. -/
@[stacks 03NS "part (1), comparison with covering sieves"]
noncomputable def familyPlusEquiv :
    FamilyPlusValue J F U ≃ (J.plusObj F).obj (op U) := by
  let toPlus : FamilyPlusValue J F U → (J.plusObj F).obj (op U) :=
    Quotient.lift
      (fun x : FamilyPlusRepresentative J F U =>
        GrothendieckTopology.Plus.mk (familyMatchingFamily J F U x.1 x.2))
      (fun x y h => familyPlusEqvGen_toPlusEq (J := J) (F := F) (U := U) x y h)
  exact Equiv.ofBijective toPlus
    ⟨familyPlusToPlus_injective J F U toPlus fun _ _ ↦ rfl,
      familyPlusToPlus_surjective J F U toPlus fun _ _ ↦ rfl⟩

/-- The covering-family colimit is universe-small. -/
noncomputable instance familyPlusValueSmall : Small.{u} (FamilyPlusValue J F U) :=
  Small.mk' (familyPlusEquiv J F U)

end CategoryTheory
