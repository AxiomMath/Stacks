module

public import StacksFrontier.AlgebraicGeometry.Etale.SupportSheaf
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.Constructible.ColimitOfConstructibles
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.EnoughGeometricPoints
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.GeometricPointDomination
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.PullbackStalk.ModuleCoefficients
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.PullbackStalk.SpecializationFiniteTypeLocallyConstantModule

/-!
# The geometric stalks of a constructible sheaf of modules are finite modules

Let `X` be a scheme of a big étale site and `Λ` a Noetherian ring. The stalk at a geometric point
of a constructible sheaf of `Λ`-modules on `X_étale` is a finitely generated `Λ`-module.

The strata of a constructible stratification are locally closed subschemes, not étale coverings,
so the finite type local constancy which constructibility provides on a stratum cannot be applied
to `X` directly. What transports it is the stalk: the image of the geometric point lies in some
affine open, and in exactly one stratum of the constructible stratification of that affine open
which the sheaf admits; the restriction of the sheaf to that stratum has finitely generated stalks
by Tag 0GKC; and the stalk of the sheaf at the given geometric point agrees with the stalk of that
restriction at a geometric point of the stratum above the same point of `X`, by Tag 03Q1 and
Tag 04FN.

## Main results

* `AlgebraicGeometry.isFG_etaleStalk_of_isConstructibleModuleSheaf` — the stalk at a geometric
  point of a constructible sheaf of `Λ`-modules is a finitely generated `Λ`-module.

## Implementation notes

The coefficient universe is `ModuleCat.{max (u + 1) r} Λ` for `Λ : Type (u + 1)` and
`B : AlgebraicGeometry.BigEtaleSite.{u}`, which is the universe at which Tag 0GKC is available
and the universe of the rest of the constructibility development. The two sheafification side
conditions of `AlgebraicGeometry.IsConstructibleModuleSheaf` are there the instances
`AlgebraicGeometry.SmallEtale.isRightAdjointPushforward_moduleCatSelf` and
`AlgebraicGeometry.SmallEtale.hasWeakSheafifyOver_moduleCatSelf`.

Nothing is assumed about `X`: a constructible stratification of every affine open is all that is
used, and a geometric point meets one affine open.

## References

* [Stacks Project, Tag 03RW](https://stacks.math.columbia.edu/tag/03RW)
* [Stacks Project, Tag 0GKC](https://stacks.math.columbia.edu/tag/0GKC)
* [Stacks Project, Tag 03Q1](https://stacks.math.columbia.edu/tag/03Q1)
* [Stacks Project, Tag 04FN](https://stacks.math.columbia.edu/tag/04FN)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite

universe u r

namespace AlgebraicGeometry

variable (B : BigEtaleSite.{u}) (Λ : Type r) [CommRing Λ]

/-- Finite generation of a module object transports along an isomorphism. -/
private theorem isFG_of_iso {E E' : ModuleCat.{max (u + 1) r} Λ} (e : E ≅ E')
    (h : ModuleCat.isFG Λ E) : ModuleCat.isFG Λ E' := by
  rw [ModuleCat.isFG_iff] at h ⊢
  have := h
  exact Module.Finite.equiv e.toLinearEquiv

variable (X : B.Scheme) [IsNoetherianRing Λ]

attribute [local instance] SmallEtale.isRightAdjointPushforward_moduleCat
  SmallEtale.hasWeakSheafifyOver_moduleCat

omit [IsNoetherianRing Λ] in
/-- **The geometric stalks of a constructible sheaf of `Λ`-modules are finitely generated.** Let
`Λ` be a Noetherian ring and `F` a constructible sheaf of `Λ`-modules on the small étale site of a
scheme `X` of a big étale site. Then the stalk of `F` at every geometric point of `X` is a
finitely generated `Λ`-module.

The image of the geometric point lies in an affine open of `X`, one stratum of whose constructible
stratification contains it; the restriction of `F` to that stratum is locally constant of finite
type, so its stalks are finitely generated by Tag 0GKC, and the stalk of `F` at the given point
agrees with the stalk of that restriction at a geometric point of the stratum above the same point
of `X`. -/
public theorem isFG_etaleStalk_of_isConstructibleModuleSheaf
    (F : Sheaf (SmallEtale.topology B X.obj X.property) (ModuleCat.{max (u + 1) r} Λ))
    (hF : IsConstructibleModuleSheaf B X Λ F) (t : GeometricPoint X.obj) :
    ModuleCat.isFG Λ (etaleStalk B X.obj X.property t F.obj) := by
  obtain ⟨U, hU⟩ : ∃ U : X.obj.affineOpens, t.hom default ∈ (U.1 : Set X.obj) := by
    have h : t.hom default ∈ (⊤ : X.obj.Opens) := trivial
    rw [← iSup_affineOpens_eq_top X.obj] at h
    obtain ⟨U, hU⟩ := TopologicalSpace.Opens.mem_iSup.mp h
    exact ⟨U, hU⟩
  obtain ⟨s, hs⟩ := hF U
  obtain ⟨i, z, hz⟩ : ∃ (i : Fin s.n) (z : (s.piece i).obj),
      (B.inclusion.map (s.inclusion i)).base z = t.hom default := by
    have hx : t.hom default ∈ ⋃ i, Set.range (B.inclusion.map (s.inclusion i)).base := by
      rw [← s.covers]; exact hU
    obtain ⟨i, z, hz⟩ := Set.mem_iUnion.mp hx
    exact ⟨i, z, hz⟩
  set t' := GeometricPoint.ofPoint (s.piece i).obj z with ht'
  have hbase : (t'.map (B.inclusion.map (s.inclusion i))).hom default = t.hom default := by
    show (B.inclusion.map (s.inclusion i)).base (t'.hom default) = t.hom default
    rw [show t'.hom default = z from GeometricPoint.ofPoint_liesOver (s.piece i).obj z]
    exact hz
  have hfg := isFG_etaleStalk_of_isFiniteTypeLocallyConstantModuleSheaf B (s.piece i).obj
    (s.piece i).property Λ _ (hs i) t'
  refine isFG_of_iso.{u, r} Λ ?_ hfg
  let : HasProducts.{u} (ModuleCat.{max (u + 1) r} Λ) := fun _ => ModuleCat.hasLimitsOfShape
  exact (smallEtalePullbackSheafFiberIso B (s.inclusion i) t'
      (ModuleCat.{max (u + 1) r} Λ)).app F ≪≫
    (etaleStalkPresheafFunctorIsoOfEqBase B X.obj X.property hbase
      (ModuleCat.{max (u + 1) r} Λ)).app F.obj

end AlgebraicGeometry

end
