module

public import
  StacksFrontier.AlgebraicGeometry.EtaleCohomology.Constructible.StageEssentialSurjectivityModules
public import StacksFrontier.AlgebraicGeometry.EtaleCohomology.SmallEtaleModuleInverseImageExact
public import StacksFrontier.AlgebraicGeometry.AffineStageDescent.Basic

/-!
# Essential surjectivity of the stage inverse images for the affine line over an affine scheme

Let `Y` be an affine scheme and `Λ` a Noetherian ring. Writing `Y` as the limit of the spectra of
the finitely generated subrings of `Γ(Y, ⊤)`, the affine line `𝔸¹_Y` is the limit of the affine
lines over them, so the essential-surjectivity assertion of [Stacks, Tag 09YU] (clause (3),
`Stacks.EtaleCohomology.exists_isConstructibleEtaleModule_etaleModuleInverseImage_iso`) applies
to `𝔸¹_Y`.

## Main results

* `Stacks.EtaleCohomology.isLimitMapConeAffineSpace` — affine space commutes with limits of
  connected diagrams.
* `Stacks.EtaleCohomology.exists_isConstructibleEtaleModule_etaleModuleInverseImage_affineLine_iso`
  — Tag 09YU, clause (3), for `𝔸¹_Y = lim 𝔸¹_{Y₀}`, `Y` affine, consumed by Tag 0GKZ.

## References

* [Stacks Project, Tag 09YU](https://stacks.math.columbia.edu/tag/09YU)
-/

@[expose] public noncomputable section

open CategoryTheory CategoryTheory.Limits Opposite
open AlgebraicGeometry AlgebraicGeometry.Scheme

universe u

namespace Stacks.EtaleCohomology

attribute [local instance] moduleCat_hasLimitsOfSize
attribute [local instance 2000] Sheaf.instHasColimitsOfShape Sheaf.instHasFiniteCoproducts
attribute [local instance] Abelian.hasFiniteBiproducts

variable (Λ : Type (u + 1)) [CommRing Λ]

/-! ### The affine line over an affine scheme -/

section AffineLine

/-- **Affine space commutes with limits of connected diagrams.** If `c` is a limit cone over a
diagram `D` of schemes indexed by a connected category, then `𝔸ⁿ` applied to `c` is a limit cone
over `𝔸ⁿ ∘ D`: each square formed by `𝔸ⁿ_{c.pt} ⟶ 𝔸ⁿ_{D j}` and the structure morphisms is
cartesian (`AlgebraicGeometry.AffineSpace.isPullback_map`). -/
def isLimitMapConeAffineSpace (n : Type u) {J : Type*} [Category* J] [IsConnected J]
    {D : J ⥤ Scheme.{u}} {c : Cone D} (hc : IsLimit c) :
    IsLimit ((AffineSpace.functor.obj (op n)).mapCone c) := by
  let α : D ⋙ AffineSpace.functor.obj (op n) ⟶ D :=
    { app := fun j ↦ 𝔸(n; D.obj j) ↘ D.obj j
      naturality := fun _ _ g ↦ AffineSpace.map_over (n := n) (D.map g) }
  let f : (Cone.postcompose α).obj ((AffineSpace.functor.obj (op n)).mapCone c) ⟶ c :=
    { hom := 𝔸(n; c.pt) ↘ c.pt
      w := fun j ↦ (AffineSpace.map_over (n := n) (c.π.app j)).symm }
  exact isLimitOfIsPullbackOfIsConnected α _ c f
    (fun j ↦ AffineSpace.isPullback_map (n := n) (c.π.app j)) hc

variable [IsNoetherianRing Λ]

/-- **Tag 09YU, clause (3), essential surjectivity, for the affine line over an affine scheme.**
Let `Y` be an affine scheme and `Λ` a Noetherian ring. A constructible sheaf of `Λ`-modules on
`𝔸¹_Y` is, up to isomorphism, the inverse image of a constructible sheaf of `Λ`-modules on
`𝔸¹_{Y₀}` along `𝔸¹_Y ⟶ 𝔸¹_{Y₀}`, for some affine Noetherian `Y₀` under `Y`.

Writing `Y` as the limit of the spectra `Y₀` of the subrings of `Γ(Y, ⊤)` generated by finite
subsets (`AlgebraicGeometry.affineStageCone`), `𝔸¹_Y` is the limit of the `𝔸¹_{Y₀}`
(`Stacks.EtaleCohomology.isLimitMapConeAffineSpace`), and
`Stacks.EtaleCohomology.exists_isConstructibleEtaleModule_etaleModuleInverseImage_iso` applies. -/
theorem exists_isConstructibleEtaleModule_etaleModuleInverseImage_affineLine_iso
    (Y : Scheme.{u}) [IsAffine Y] (F : EtaleModules.{u, u + 1} Λ 𝔸(ULift.{u} (Fin 1); Y))
    (hF : IsConstructibleEtaleModule Λ F) :
    ∃ (Y₀ : Scheme.{u}) (_ : IsAffine Y₀) (_ : IsNoetherian Y₀) (g : Y ⟶ Y₀)
      (F₀ : EtaleModules.{u, u + 1} Λ 𝔸(ULift.{u} (Fin 1); Y₀)), IsConstructibleEtaleModule Λ F₀ ∧
        Nonempty ((etaleModuleInverseImage.{u, u + 1} Λ
          (AffineSpace.map (ULift.{u} (Fin 1)) g)).obj F₀ ≅ F) := by
  let A := AffineSpace.functor.obj (op (ULift.{u} (Fin 1)))
  let D₀ := specAdjoinFinsetDiagram Γ(Y, ⊤)
  have : IsConnected (Finset Γ(Y, ⊤))ᵒᵖ := IsCofiltered.isConnected _
  have : ∀ i, CompactSpace ((D₀ ⋙ A).obj i) := fun i ↦
    inferInstanceAs (CompactSpace 𝔸(ULift.{u} (Fin 1); D₀.obj i))
  have : ∀ i, QuasiSeparatedSpace ((D₀ ⋙ A).obj i) := fun i ↦
    inferInstanceAs (QuasiSeparatedSpace 𝔸(ULift.{u} (Fin 1); D₀.obj i))
  have : ∀ {i j} (g : i ⟶ j), IsAffineHom ((D₀ ⋙ A).map g) := fun g ↦
    inferInstanceAs (IsAffineHom (AffineSpace.map (ULift.{u} (Fin 1)) (D₀.map g)))
  obtain ⟨i, F₀, hF₀, ⟨e⟩⟩ :=
    exists_isConstructibleEtaleModule_etaleModuleInverseImage_iso Λ (D₀ ⋙ A)
      (A.mapCone (affineStageCone Y))
      (isLimitMapConeAffineSpace (ULift.{u} (Fin 1)) (isLimit_affineStageCone Y)) F hF
  exact ⟨D₀.obj i, inferInstance, inferInstance, (affineStageCone Y).π.app i, F₀, hF₀, ⟨e⟩⟩

end AffineLine

end Stacks.EtaleCohomology

end
